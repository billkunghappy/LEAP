      · intro r hr g _
        obtain ⟨w, hw⟩ := (hFalg.2.2 e V hV).1 g
        exact ⟨r • w, Submodule.smul_mem_smul hr Submodule.mem_top, by rw [smapp, hw]⟩
      · rintro y1 y2 ⟨w1, hw1, rfl⟩ ⟨w2, hw2, rfl⟩
        exact ⟨w1 + w2, Submodule.add_mem _ hw1 hw2, map_add _ w1 w2⟩
    have key := wc_cn_compare_affine Γ(Z, V) (𝒥.ideal ⟨V, hV⟩)
      (Ideal.map (wcCnSigma h V) (IsLocalRing.maximalIdeal B ^ (n + 1))) c' t
      Γ(F, V) Γ(H, V) Γ(Hs n, V) Γ(Fs n, V) (fun e => Γ(Q.Fq e n, V))
      (wcCnSecLin (φ n) V) (wcCnSecLin a V) (wcCnSecLin (φH n) V) (wcCnSecLin (α n) V)
      (fun e => wcCnSecLin (Q.pF e n) V)
      (ha V hV).1 (ha V hV).2 (hHalg.2.2 n V hV).1 (hHalg.2.2 n V hV).2
      (hF.2.2 n V hV) (hαi n V hV).1
      (fun x => (capp (φ n) (α n) V x).symm.trans
        ((happ (hφ1 n) V x).trans (capp a (φH n) V x)))
      (fun e m hm => (((Q.pF_jalg n).2.2 e V hV).2 m).1 hm)
      (fun e m => by
        obtain ⟨g', hg'⟩ := ((L.G_alg e).2.2 n V hV).1 (Scheme.Modules.Hom.app (Q.pF e n) V m)
        obtain ⟨x, hx⟩ := (hFalg.2.2 e V hV).1 g'
        refine ⟨x, ?_⟩
        show Scheme.Modules.Hom.app (Q.pF e n) V (Scheme.Modules.Hom.app (φ n) V x) =
          Scheme.Modules.Hom.app (Q.pF e n) V m
        rw [← capp, hφ2 n e, capp, hx, hg'])
      (fun e x hx => by
        have hx' : Scheme.Modules.Hom.app (L.χ e n) V
            (Scheme.Modules.Hom.app (φF e) V x) = 0 := by
          rw [← capp, ← hφ2 n e, capp]
          exact hx
        have hmem := (((L.G_alg e).2.2 n V hV).2 _).1 hx'
        obtain ⟨w, hw, hwx⟩ := himg e _ hmem
        have hdiff : x - w ∈ (𝒥.ideal ⟨V, hV⟩ ^ (e + 1) : Ideal Γ(Z, V)) •
            (⊤ : Submodule Γ(Z, V) Γ(F, V)) :=
          ((hFalg.2.2 e V hV).2 (x - w)).1 (by rw [map_sub, hwx, sub_self])
        rw [Submodule.mem_sup]
        exact ⟨w, hw, x - w, hdiff, by abel⟩)
    exact key

theorem wc_cn_two_of_three_088A : wcCnFormalFns.{u} →
    ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B]
    [IsAdicComplete (IsLocalRing.maximalIdeal B) B] (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B))
    [IsProper h] (𝒦 𝒥 : Z.IdealSheafData),
    (∀ 𝒦' : Z.IdealSheafData, 𝒦 ≤ 𝒦' →
      (∃ e : ℕ, 1 ≤ e ∧ ∀ (V : Z.Opens) (hV : IsAffineOpen V),
        𝒥.ideal ⟨V, hV⟩ ^ e ≤ 𝒦'.ideal ⟨V, hV⟩) →
      wcCnXi h (IsLocalRing.maximalIdeal B) 𝒦') →
    ∀ (Fs : ℕ → Z.Modules) (ψ : ∀ n, Fs (n + 1) ⟶ Fs n),
    wcCnAdicSys h (IsLocalRing.maximalIdeal B) Fs ψ → (∀ n, wcCnKilled 𝒦 (Fs n)) →
    ∀ (H : Z.Modules) (Hs : ℕ → Z.Modules) (ψH : ∀ n, Hs (n + 1) ⟶ Hs n)
      (φH : ∀ n, H ⟶ Hs n) (α : ∀ n, Fs n ⟶ Hs n) (t : ℕ),
    wcCnKilled 𝒦 H → wcCnAdicSys h (IsLocalRing.maximalIdeal B) Hs ψH →
    wcCnAlg h (IsLocalRing.maximalIdeal B) Hs ψH H φH →
    (∀ n, α (n + 1) ≫ ψH n = ψ n ≫ α n) → (∀ n, wcCnAlmostIso 𝒥 t (α n)) →
    ∃ (M : Z.Modules) (φ : ∀ n, M ⟶ Fs n), wcCnAlg h (IsLocalRing.maximalIdeal B) Fs ψ M φ :=
by
  intro hFF B _ _ _ _ Z h _ 𝒦 𝒥 hXi Fs ψ hF hK H Hs ψH φH α t _hHK hHs hHalg hα hαi
  haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian h
  haveI : CompactSpace Z :=
    ⟨by simpa using QuasiCompact.isCompact_preimage (f := h) Set.univ isOpen_univ isCompact_univ⟩
  haveI : IsNoetherian Z := {}
  obtain ⟨Q⟩ := wc_cn_088A_quot_layers B Z h 𝒦 𝒥 Fs ψ hF hK Hs ψH α t hHs hα hαi
  obtain ⟨L⟩ := wc_cn_088A_layers hFF B Z h 𝒦 𝒥 hXi Fs ψ hF H Hs ψH φH α hHs hHalg Q
  obtain ⟨F, a, φF, c', hFalg, hFβ, ha⟩ := wc_cn_jadic_algebraise Z 𝒥 L.G L.τ H L.H' L.τH' L.q
    L.β L.cβ L.G_jadic L.H'_jadic L.q_jalg L.β_τ L.β_almost
  exact wc_cn_088A_compare B Z h 𝒦 𝒥 Fs ψ H Hs ψH φH α t Q L F a φF c' hF hHs hHalg hα hαi
    hFalg hFβ ha

theorem wc_cn_existence_chow_reduction : wcCnProjExist.{u} → wcCnFormalFns.{u} →
    ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B]
    [IsAdicComplete (IsLocalRing.maximalIdeal B) B] (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B))
    [IsProper h] (Ms : ℕ → Z.Modules) (ψ : ∀ n, Ms (n + 1) ⟶ Ms n),
    wcCnAdicSys h (IsLocalRing.maximalIdeal B) Ms ψ →
    ∃ (M : Z.Modules) (φ : ∀ n, M ⟶ Ms n), wcCnAlg h (IsLocalRing.maximalIdeal B) Ms ψ M φ :=
by
  intro hPE hFF B _ _ _ _ Z h _ Ms ψ hsys

  haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian h
  haveI : CompactSpace Z :=
    ⟨by simpa using QuasiCompact.isCompact_preimage (f := h) Set.univ isOpen_univ isCompact_univ⟩
  haveI : IsNoetherian Z := {}

  haveI := wc_cn_idealSheaf_wellFoundedGT Z

  have key : ∀ 𝒦 : Z.IdealSheafData, wcCnXi h (IsLocalRing.maximalIdeal B) 𝒦 := by
    intro 𝒦
    refine WellFoundedGT.induction 𝒦 ?_
    intro 𝒦 IH Fs ψF hF hK
    by_cases htop : 𝒦 = ⊤
    ·
      subst htop
      have hz : ∀ n (V : Z.Opens) (hV : IsAffineOpen V) (s : Γ(Fs n, V)), s = 0 := by
        intro n V hV s
        have h1 := hK n V hV 1 (by simp) s
        rwa [one_smul] at h1
      refine ⟨Fs 0, fun _ => 0, hF.1 0, fun n => Limits.zero_comp, fun n V hV => ⟨?_, ?_⟩⟩
      · intro y
        exact ⟨0, (hz n V hV _).trans (hz n V hV y).symm⟩
      · intro s
        constructor
        · intro _
          rw [hz 0 V hV s]
          exact Submodule.zero_mem _
        · intro _
          exact hz n V hV _
    ·
      obtain ⟨P, p, m, g, U, V₀, hV₀, hp, hcl, hV₀U, hK₀, hkill, hiso⟩ :=
        wc_cn_chow_rel_ideal B Z h 𝒦 htop
      obtain ⟨𝒥, H, Hs, ψH, φH, α, t, h𝒥, hHK, hHs, hHalg, hα, hαi⟩ :=
        wc_cn_chow_comparison hPE hFF B Z h 𝒦 P p m g U hp hcl hkill hiso Fs ψF hF hK
      refine wc_cn_two_of_three_088A hFF B Z h 𝒦 𝒥 ?_ Fs ψF hF hK H Hs ψH φH α t hHK hHs
        hHalg hα hαi
      rintro 𝒦' hle ⟨e, _, hJ⟩
      apply IH
      refine lt_of_le_of_ne hle ?_
      intro heq
      apply hK₀
      have h1 : 𝒥.ideal ⟨V₀, hV₀⟩ ^ e ≤ 𝒦'.ideal ⟨V₀, hV₀⟩ := hJ V₀ hV₀
      rw [h𝒥 V₀ hV₀ hV₀U, Ideal.top_pow, ← heq] at h1
      exact top_le_iff.mp h1
  refine key ⊥ Ms ψ hsys ?_
  intro n V hV a ha s
  have ha0 : a = 0 := by simpa using ha
  rw [ha0, zero_smul]

theorem wc_cn_ring_structure_coequifibered : ∀ (Z : Scheme.{u}) (M : Z.Modules), wcCoherentMod M →
    ∀ (one : ∀ U : Z.Opens, IsAffineOpen U → Γ(M, U))
      (μ : ∀ U : Z.Opens, IsAffineOpen U → MultilinearMap Γ(Z, U) (fun _ : Fin 2 => Γ(M, U)) Γ(M, U)),
    (∀ (U U' : Z.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (hle : U' ≤ U),
      M.presheaf.map (homOfLE hle).op (one U hU) = one U' hU') →
    (∀ (U U' : Z.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (hle : U' ≤ U)
      (x : Fin 2 → Γ(M, U)),
      M.presheaf.map (homOfLE hle).op (μ U hU x) =
        μ U' hU' (fun i => M.presheaf.map (homOfLE hle).op (x i))) →
    (∀ (U : Z.Opens) (hU : IsAffineOpen U) (x y : Γ(M, U)), μ U hU ![x, y] = μ U hU ![y, x]) →
    (∀ (U : Z.Opens) (hU : IsAffineOpen U) (x y z : Γ(M, U)),
      μ U hU ![μ U hU ![x, y], z] = μ U hU ![x, μ U hU ![y, z]]) →
    (∀ (U : Z.Opens) (hU : IsAffineOpen U) (x : Γ(M, U)), μ U hU ![one U hU, x] = x) →
    ∃ (F : Z.AffineZariskiSiteᵒᵖ ⥤ CommRingCat.{u})
      (α : (Scheme.AffineZariskiSite.toOpensFunctor Z).op ⋙ Z.presheaf ⟶ F)
      (E : ∀ U : Z.AffineZariskiSite, Γ(M, U.toOpens) ≃+ F.obj (Opposite.op U)),
      NatTrans.Coequifibered α ∧ (∀ U : Z.AffineZariskiSite, (α.app (Opposite.op U)).hom.Finite) ∧
      (∀ (U : Z.AffineZariskiSite) (x y : Γ(M, U.toOpens)),
        E U (μ U.toOpens U.2 ![x, y]) = E U x * E U y) ∧
      (∀ U : Z.AffineZariskiSite, E U (one U.toOpens U.2) = 1) ∧
      (∀ (U : Z.AffineZariskiSite) (r : Γ(Z, U.toOpens)) (x : Γ(M, U.toOpens)),
        E U (r • x) = α.app (Opposite.op U) r * E U x) ∧
      (∀ (U U' : Z.AffineZariskiSite) (hle : U' ≤ U) (x : Γ(M, U.toOpens)),
        E U' (M.presheaf.map (homOfLE (Scheme.AffineZariskiSite.toOpens_mono hle)).op x) =
          F.map (homOfLE hle).op (E U x)) :=
by
  intro Z M hM one μ hone hμ hc ha hu

  have keyLoc : ∀ (R R' : Type u) [CommRing R] [CommRing R'] (ρ : R →+* R')
      (N N' : Type u) [AddCommGroup N] [Module R N] [AddCommGroup N'] [Module R' N']
      (res : N →+ N') (A A' : Type u) [CommRing A] [CommRing A'] [Algebra A A']
      (α : R →+* A) (α' : R' →+* A') (E : N ≃+ A) (E' : N' ≃+ A') (f : R),
      IsUnit (ρ f) →
      (∀ (r : R) (x : N), E (r • x) = α r * E x) →
      (∀ (r : R') (x : N'), E' (r • x) = α' r * E' x) →
      (∀ r : R, algebraMap A A' (α r) = α' (ρ r)) →
      (∀ x : N, algebraMap A A' (E x) = E' (res x)) →
      (∀ s : N', ∃ (n : ℕ) (t : N), (ρ f) ^ n • s = res t) →
      (∀ t : N, res t = 0 → ∃ n : ℕ, f ^ n • t = 0) →
      IsLocalization.Away (α f) A' := by
    intro R R' _ _ ρ N N' _ _ _ _ res A A' _ _ _ α α' E E' f hf hE hE' hA hN hs hz
    refine IsLocalization.Away.mk _ ?_ ?_ ?_
    · rw [hA]
      exact hf.map α'
    · intro s
      obtain ⟨n, t, ht⟩ := hs (E'.symm s)
      refine ⟨n, E t, ?_⟩
      have h1 := congrArg E' ht
      rw [hE', AddEquiv.apply_symm_apply, ← hN, map_pow, ← hA] at h1
      rw [mul_comm]
      exact h1
    · intro a b hab
      have h0 : res (E.symm (a - b)) = 0 := by
        apply E'.injective
        rw [← hN, AddEquiv.apply_symm_apply, map_sub, hab, sub_self, map_zero]
      obtain ⟨n, hn⟩ := hz _ h0
      refine ⟨n, ?_⟩
      have h1 := congrArg E hn
      rw [hE, AddEquiv.apply_symm_apply, map_zero, map_pow] at h1
      rw [← sub_eq_zero, ← mul_sub]
      exact h1

  have keyFin : ∀ (R N : Type u) [CommRing R] [AddCommGroup N] [Module R N] [Module.Finite R N]
      (A : Type u) [CommRing A] (α : R →+* A) (E : N ≃+ A),
      (∀ (r : R) (x : N), E (r • x) = α r * E x) → α.Finite := by
    intro R N _ _ _ _ A _ α E hE
    letI := α.toAlgebra
    exact Module.Finite.equiv (R := R) (M := N) (N := A)
      { toFun := E
        invFun := E.symm
        left_inv := E.left_inv
        right_inv := E.right_inv
        map_add' := E.map_add
        map_smul' := fun r x => by
          rw [hE, RingHom.id_apply, Algebra.smul_def]
          rfl }

  have c3 : ∀ (F : Z.AffineZariskiSiteᵒᵖ ⥤ CommRingCat.{u})
      (α : (Scheme.AffineZariskiSite.toOpensFunctor Z).op ⋙ Z.presheaf ⟶ F)
      (E : ∀ U : Z.AffineZariskiSite, Γ(M, U.toOpens) ≃+ F.obj (Opposite.op U)),
      (∀ (U : Z.AffineZariskiSite) (r : Γ(Z, U.toOpens)) (x : Γ(M, U.toOpens)),
        E U (r • x) = α.app (Opposite.op U) r * E U x) →
      (∀ (U U' : Z.AffineZariskiSite) (hle : U' ≤ U) (x : Γ(M, U.toOpens)),
        E U' (M.presheaf.map (homOfLE (Scheme.AffineZariskiSite.toOpens_mono hle)).op x) =
          F.map (homOfLE hle).op (E U x)) →
      NatTrans.Coequifibered α := by
    intro F α E hsm hnt
    rw [Scheme.AffineZariskiSite.coequifibered_iff_forall_isLocalizationAway]
    intro U f
    have hle : U.basicOpen f ≤ U := U.basicOpen_le f
    letI : Algebra (F.obj (Opposite.op U)) (F.obj (Opposite.op (U.basicOpen f))) :=
      (F.map (homOfLE hle).op).hom.toAlgebra
    exact keyLoc Γ(Z, U.toOpens) Γ(Z, (U.basicOpen f).toOpens)
      (Z.presheaf.map (homOfLE (Scheme.AffineZariskiSite.toOpens_mono hle)).op).hom
      Γ(M, U.toOpens) Γ(M, (U.basicOpen f).toOpens)
      (M.presheaf.map (homOfLE (Scheme.AffineZariskiSite.toOpens_mono hle)).op).hom
      (F.obj (Opposite.op U)) (F.obj (Opposite.op (U.basicOpen f)))
      (α.app (Opposite.op U)).hom (α.app (Opposite.op (U.basicOpen f))).hom
      (E U) (E (U.basicOpen f)) f
      (Z.toRingedSpace.isUnit_res_basicOpen f) (hsm U) (hsm (U.basicOpen f))
      (fun r => (NatTrans.naturality_apply α (homOfLE hle).op r).symm)
      (fun x => (hnt U _ hle x).symm)
      (hM.1 U.toOpens U.2 f).1 (hM.1 U.toOpens U.2 f).2

  have raw : ∀ (V : Z.Opens) (hV : IsAffineOpen V) (r : Γ(Z, V)) (x : Γ(M, V)),
      r • x = μ V hV ![r • one V hV, x] := by
    intro V hV r x
    have h := (μ V hV).map_update_smul ![one V hV, x] 0 r (one V hV)
    have e1 : Function.update ![one V hV, x] 0 (r • one V hV) = ![r • one V hV, x] := by
      funext i; fin_cases i <;> rfl
    have e2 : Function.update ![one V hV, x] 0 (one V hV) = ![one V hV, x] := by
      funext i; fin_cases i <;> rfl
    rw [e1, e2, hu] at h
    exact h.symm
  have hsm : ∀ (U : Z.AffineZariskiSite) (r : Γ(Z, U.toOpens)) (x : Γ(M, U.toOpens)),
      wcCnAlgEquiv M one μ hone hμ hc ha hu U (r • x) =
        (wcCnAlgUnit M one μ hone hμ hc ha hu).app (Opposite.op U) r *
          wcCnAlgEquiv M one μ hone hμ hc ha hu U x :=
    fun U r x => raw U.toOpens U.2 r x
  have hnt : ∀ (U U' : Z.AffineZariskiSite) (hle : U' ≤ U) (x : Γ(M, U.toOpens)),
      wcCnAlgEquiv M one μ hone hμ hc ha hu U'
        (M.presheaf.map (homOfLE (Scheme.AffineZariskiSite.toOpens_mono hle)).op x) =
        (wcCnAlgFun M one μ hone hμ hc ha hu).map (homOfLE hle).op
          (wcCnAlgEquiv M one μ hone hμ hc ha hu U x) := by
    intro U U' hle x
    rfl
  have hfin : ∀ U : Z.AffineZariskiSite,
      ((wcCnAlgUnit M one μ hone hμ hc ha hu).app (Opposite.op U)).hom.Finite := by
    intro U
    haveI := hM.2 U.toOpens U.2
    exact keyFin Γ(Z, U.toOpens) Γ(M, U.toOpens)
      ((wcCnAlgFun M one μ hone hμ hc ha hu).obj (Opposite.op U))
      ((wcCnAlgUnit M one μ hone hμ hc ha hu).app (Opposite.op U)).hom
      (wcCnAlgEquiv M one μ hone hμ hc ha hu U) (hsm U)
  exact ⟨wcCnAlgFun M one μ hone hμ hc ha hu, wcCnAlgUnit M one μ hone hμ hc ha hu,
    wcCnAlgEquiv M one μ hone hμ hc ha hu,
    c3 _ _ _ hsm hnt, hfin, fun _ _ _ => rfl, fun _ => rfl, hsm, hnt⟩

theorem wc_cn_finite_relative_spec : ∀ (Z : Scheme.{u}) (F : Z.AffineZariskiSiteᵒᵖ ⥤ CommRingCat.{u})
    (α : (Scheme.AffineZariskiSite.toOpensFunctor Z).op ⋙ Z.presheaf ⟶ F),
    NatTrans.Coequifibered α → (∀ U : Z.AffineZariskiSite, (α.app (Opposite.op U)).hom.Finite) →
    ∃ (V : Scheme.{u}) (p : V ⟶ Z)
      (e : ∀ U : Z.AffineZariskiSite, Γ(V, p ⁻¹ᵁ U.toOpens) ≅ F.obj (Opposite.op U)),
      IsFinite p ∧ (∀ U : Z.AffineZariskiSite, p.app U.toOpens ≫ (e U).hom = α.app (Opposite.op U)) ∧
      ∀ (U U' : Z.AffineZariskiSite) (hle : U' ≤ U),
        V.presheaf.map (homOfLE (p.preimage_mono (Scheme.AffineZariskiSite.toOpens_mono hle))).op ≫
            (e U').hom =
          (e U).hom ≫ F.map (homOfLE hle).op :=
by
  intro Z F α hα hfin

  have s1 : ∃ (V : Scheme.{u}) (p : V ⟶ Z)
      (j : ∀ U : Z.AffineZariskiSite, Spec (F.obj (Opposite.op U)) ⟶ V),
      (∀ U : Z.AffineZariskiSite, IsOpenImmersion (j U)) ∧
      (∀ U : Z.AffineZariskiSite, Set.range (j U) = ((p ⁻¹ᵁ U.toOpens : V.Opens) : Set V)) ∧
      (∀ U : Z.AffineZariskiSite, j U ≫ p = Spec.map (α.app (Opposite.op U)) ≫ U.2.fromSpec) ∧
      (∀ (U U' : Z.AffineZariskiSite) (hle : U' ≤ U),
        Spec.map (F.map (homOfLE hle).op) ≫ j U = j U') := by
    let d := Scheme.AffineZariskiSite.relativeGluingData hα
    haveI : (d.functor ⋙ Scheme.forget).IsLocallyDirected :=
      Scheme.Cover.RelativeGluingData.instIsLocallyDirectedI₀CompFunctorForgetOfIsThin ..
    refine ⟨d.glued, d.toBase, fun U => Limits.colimit.ι d.functor U, ?_, ?_, ?_, ?_⟩
    · intro U
      have h := d.isPullback_natTrans_ι_toBase U
      have hU' : IsOpenImmersion ((Scheme.AffineZariskiSite.directedCover Z).f U) := by
        show IsOpenImmersion U.1.ι
        infer_instance
      show IsOpenImmersion (Limits.colimit.ι d.functor U)
      exact MorphismProperty.of_isPullback (P := @IsOpenImmersion) h hU'
    · intro U
      have h := d.toBase_preimage_eq_opensRange_ι U
      have h' : Scheme.Hom.opensRange ((Scheme.AffineZariskiSite.directedCover Z).f U) = U.1 :=
        Scheme.Opens.opensRange_ι U.1
      rw [h'] at h
      show Set.range (Limits.colimit.ι d.functor U) = _
      rw [h, Scheme.Hom.coe_opensRange]
    · intro U
      have h := d.ι_toBase U
      refine h.trans ?_
      have e : d.natTrans.app U = Spec.map (α.app (Opposite.op U)) ≫ U.2.isoSpec.inv := rfl
      rw [e]
      exact (Category.assoc _ _ _).trans
        (congrArg (Spec.map (α.app (Opposite.op U)) ≫ ·) (IsAffineOpen.isoSpec_inv_ι U.2))
    · intro U U' hle
      exact Limits.colimit.w d.functor (homOfLE hle)
  obtain ⟨V, p, j, hj1, hj2, hj3, hj4⟩ := s1

  have hTop : ∀ {R S : CommRingCat.{u}} (φ : R ⟶ S) (e : (⊤ : (Spec S).Opens) ≤ (Spec.map φ) ⁻¹ᵁ ⊤),
      (Spec.map φ).appLE ⊤ ⊤ e = (Spec.map φ).appTop := fun φ e => (Spec.map φ).appLE_eq_app
  have htop' : ∀ {R S : CommRingCat.{u}} (φ : R ⟶ S),
      (⊤ : (Spec S).Opens) ≤ (Spec.map φ) ⁻¹ᵁ ⊤ := fun φ x _ => trivial
  have hle : ∀ U : Z.AffineZariskiSite,
      (⊤ : (Spec (F.obj (Opposite.op U))).Opens) ≤ (j U) ⁻¹ᵁ (p ⁻¹ᵁ U.toOpens) := by
    intro U x _
    show (j U) x ∈ ((p ⁻¹ᵁ U.toOpens : V.Opens) : Set V)
    rw [← hj2 U]
    exact Set.mem_range_self x
  have hO : ∀ U : Z.AffineZariskiSite,
      p ⁻¹ᵁ U.toOpens = @Scheme.Hom.opensRange _ _ (j U) (hj1 U) := by
    intro U
    apply TopologicalSpace.Opens.ext
    rw [Scheme.Hom.coe_opensRange, hj2]
  have hiso : ∀ U : Z.AffineZariskiSite, IsIso ((j U).appLE (p ⁻¹ᵁ U.toOpens) ⊤ (hle U)) := by
    intro U
    haveI := hj1 U
    have hO' : (j U) ''ᵁ ⊤ = p ⁻¹ᵁ U.toOpens := by
      rw [Scheme.Hom.image_top_eq_opensRange, hO U]
    have h0 := (inferInstance : IsIso ((j U).appIso ⊤).hom)
    rw [Scheme.Hom.appIso_hom'] at h0
    exact (Scheme.Hom.appLE_congr (j U) _ hO' rfl (fun f => IsIso f)).mp h0
  let e : ∀ U : Z.AffineZariskiSite, Γ(V, p ⁻¹ᵁ U.toOpens) ≅ F.obj (Opposite.op U) :=
    fun U => (haveI := hiso U
      asIso ((j U).appLE (p ⁻¹ᵁ U.toOpens) ⊤ (hle U) ≫ (Scheme.ΓSpecIso (F.obj (Opposite.op U))).hom))
  have heU : ∀ U : Z.AffineZariskiSite, (e U).hom =
      (j U).appLE (p ⁻¹ᵁ U.toOpens) ⊤ (hle U) ≫ (Scheme.ΓSpecIso (F.obj (Opposite.op U))).hom :=
    fun _ => rfl
  have hAff : ∀ U : Z.AffineZariskiSite, IsAffineOpen (p ⁻¹ᵁ U.toOpens) := by
    intro U
    haveI := hj1 U
    rw [hO U]
    exact isAffineOpen_opensRange _
  have keyA : ∀ (W : Z.Opens) (hW : IsAffineOpen W) (R : CommRingCat.{u}) (φ : Γ(Z, W) ⟶ R)
      (g : Spec R ⟶ Z) (hg : g = Spec.map φ ≫ hW.fromSpec) (e : ⊤ ≤ g ⁻¹ᵁ W),
      g.appLE W ⊤ e ≫ (Scheme.ΓSpecIso R).hom = φ := by
    rintro W hW R φ _ rfl e
    rw [← Scheme.Hom.appLE_comp_appLE (Spec.map φ) hW.fromSpec W
      ⊤ ⊤ (le_of_eq hW.fromSpec_preimage_self.symm) (htop' _)]
    have h3 : hW.fromSpec.appLE W ⊤ (le_of_eq hW.fromSpec_preimage_self.symm) =
        (Scheme.ΓSpecIso Γ(Z, W)).inv := by
      rw [Scheme.Hom.appLE, IsAffineOpen.fromSpec_app_self, Category.assoc,
        ← Functor.map_comp]
      have hid : ∀ (k : (Opposite.op (⊤ : (Spec Γ(Z, W)).Opens)) ⟶ Opposite.op ⊤),
          k = 𝟙 _ := fun k => Subsingleton.elim _ _
      rw [hid (_ ≫ _), CategoryTheory.Functor.map_id, Category.comp_id]
    rw [h3, Category.assoc, hTop, Scheme.ΓSpecIso_naturality, Iso.inv_hom_id_assoc]
  have hαe : ∀ U : Z.AffineZariskiSite, p.app U.toOpens ≫ (e U).hom = α.app (Opposite.op U) := by
    intro U
    rw [heU]
    rw [← Category.assoc, Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE]
    exact keyA U.1 U.2 (F.obj (Opposite.op U)) (α.app (Opposite.op U)) _ (hj3 U) _
  have hnat : ∀ (U U' : Z.AffineZariskiSite) (hle' : U' ≤ U),
      V.presheaf.map (homOfLE (p.preimage_mono (Scheme.AffineZariskiSite.toOpens_mono hle'))).op ≫
          (e U').hom =
        (e U).hom ≫ F.map (homOfLE hle').op := by
    intro U U' hle'
    rw [heU, heU]
    have key : ∀ (g : Spec (F.obj (Opposite.op U')) ⟶ V)
        (hg : Spec.map (F.map (homOfLE hle').op) ≫ j U = g) (e : ⊤ ≤ g ⁻¹ᵁ (p ⁻¹ᵁ U.toOpens)),
        g.appLE (p ⁻¹ᵁ U.toOpens) ⊤ e ≫ (Scheme.ΓSpecIso _).hom =
          (j U).appLE (p ⁻¹ᵁ U.toOpens) ⊤ (hle U) ≫ (Scheme.ΓSpecIso _).hom ≫
            F.map (homOfLE hle').op := by
      rintro _ rfl e
      rw [← Scheme.Hom.appLE_comp_appLE (Spec.map _) (j U) (p ⁻¹ᵁ U.toOpens) ⊤ ⊤ (hle U)
        (htop' _), Category.assoc, hTop, Scheme.ΓSpecIso_naturality]
    rw [← Category.assoc, Scheme.Hom.map_appLE]
    exact key _ (hj4 U U' hle') _

  refine ⟨V, p, e, ?_, hαe, hnat⟩
  haveI : IsAffineHom p := ⟨fun W hW => hAff ⟨W, hW⟩⟩
  refine { finite_app := fun W hW => ?_ }
  let U : Z.AffineZariskiSite := ⟨W, hW⟩
  have hpa : p.app U.toOpens = α.app (Opposite.op U) ≫ (e U).inv :=
    (Iso.eq_comp_inv (e U)).mpr (hαe U)
  have hc : (p.app W).hom = (e U).inv.hom.comp (α.app (Opposite.op U)).hom := by
    change (p.app U.toOpens).hom = _
    rw [hpa]
    rfl
  have hsurj : Function.Surjective (e U).inv.hom := fun y =>
    ⟨(e U).hom y, by
      change ((e U).hom ≫ (e U).inv) y = y
      rw [Iso.hom_inv_id]
      rfl⟩
  rw [hc]
  exact RingHom.Finite.comp (RingHom.Finite.of_surjective _ hsurj) (hfin U)

theorem wc_cn_quot_data_transport : ∀ (B : Type u) [CommRing B] (Z V Wn : Scheme.{u})
    (h : Z ⟶ Spec (.of B)) (J : Ideal B) (p : V ⟶ Z) (g : Wn ⟶ Z) (M : Z.Modules)
    (φ : M ⟶ wcCnPush g) (Θ : ∀ U : Z.Opens, IsAffineOpen U → (Γ(V, p ⁻¹ᵁ U) ≃+ Γ(M, U))),
    (∀ (U : Z.Opens) (hU : IsAffineOpen U) (r : Γ(Z, U)) (a : Γ(V, p ⁻¹ᵁ U)),
      Θ U hU (p.app U r * a) = r • Θ U hU a) →
    (∀ (U : Z.Opens) (hU : IsAffineOpen U) (a b : Γ(V, p ⁻¹ᵁ U)),
      (show Γ(Wn, g ⁻¹ᵁ U) from Scheme.Modules.Hom.app φ U (Θ U hU (a * b))) =
        (show Γ(Wn, g ⁻¹ᵁ U) from Scheme.Modules.Hom.app φ U (Θ U hU a)) *
          (show Γ(Wn, g ⁻¹ᵁ U) from Scheme.Modules.Hom.app φ U (Θ U hU b))) →
    (∀ (U : Z.Opens) (hU : IsAffineOpen U),
      (show Γ(Wn, g ⁻¹ᵁ U) from Scheme.Modules.Hom.app φ U (Θ U hU 1)) = 1) →
    (∀ (U U' : Z.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (hle : U' ≤ U)
      (a : Γ(V, p ⁻¹ᵁ U)),
      Θ U' hU' (V.presheaf.map (homOfLE (p.preimage_mono hle)).op a) =
        M.presheaf.map (homOfLE hle).op (Θ U hU a)) →
    (∀ (U : Z.Opens), IsAffineOpen U → Function.Surjective (Scheme.Modules.Hom.app φ U) ∧
      ∀ s : Γ(M, U), Scheme.Modules.Hom.app φ U s = 0 ↔
        s ∈ Ideal.map (wcCnSigma h U) J • (⊤ : Submodule Γ(Z, U) Γ(M, U))) →
    ∃ ρ : ∀ U : Z.Opens, IsAffineOpen U → (Γ(V, p ⁻¹ᵁ U) →+* Γ(Wn, g ⁻¹ᵁ U)),
      wcCnQuotData h J p g ρ :=
by
  intro B _ Z V Wn h J p g M φ Θ hsmul hmul hone hnat hφ

  have alg : ∀ (R A N : Type u) [CommRing R] [CommRing A] [AddCommGroup N] [Module R N]
      (π : R →+* A) (T : A ≃+ N), (∀ (r : R) (a : A), T (π r * a) = r • T a) →
      ∀ (I : Ideal R) (a : A), T a ∈ I • (⊤ : Submodule R N) ↔ a ∈ Ideal.map π I := by
    intro R A N _ _ _ _ π T hT I a
    constructor
    · intro ha
      have key : ∀ m : N, m ∈ I • (⊤ : Submodule R N) → T.symm m ∈ Ideal.map π I := by
        intro m hm
        refine Submodule.smul_induction_on (p := fun m => T.symm m ∈ Ideal.map π I) hm ?_ ?_
        · intro r hr n _
          have e : T.symm (r • n) = π r * T.symm n := by
            rw [AddEquiv.symm_apply_eq, hT, AddEquiv.apply_symm_apply]
          show T.symm (r • n) ∈ Ideal.map π I
          rw [e]
          exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem π hr)
        · intro x y hx hy
          show T.symm (x + y) ∈ Ideal.map π I
          rw [map_add]
          exact add_mem hx hy
      have := key (T a) ha
      rwa [AddEquiv.symm_apply_apply] at this
    · intro ha
      have key : ∀ b : A, T (b * a) ∈ I • (⊤ : Submodule R N) := by
        induction ha using Submodule.span_induction with
        | mem x hx =>
          obtain ⟨j, hj, rfl⟩ := hx
          intro b
          rw [mul_comm, hT]
          exact Submodule.smul_mem_smul hj Submodule.mem_top
        | zero => intro b; rw [mul_zero, map_zero]; exact Submodule.zero_mem _
        | add x y _ _ hx hy => intro b; rw [mul_add, map_add]; exact add_mem (hx b) (hy b)
        | smul c x _ hx => intro b; rw [smul_eq_mul, ← mul_assoc]; exact hx (b * c)
      have := key 1
      rwa [one_mul] at this

  let ρ : ∀ U : Z.Opens, IsAffineOpen U → (Γ(V, p ⁻¹ᵁ U) →+* Γ(Wn, g ⁻¹ᵁ U)) := fun U hU =>
    { toFun := fun a => (show Γ(Wn, g ⁻¹ᵁ U) from Scheme.Modules.Hom.app φ U (Θ U hU a))
      map_one' := hone U hU
      map_mul' := hmul U hU
      map_zero' := by
        show (Scheme.Modules.Hom.app φ U (Θ U hU 0) : Γ(wcCnPush g, U)) = (0 : Γ(wcCnPush g, U))
        rw [map_zero, map_zero]
      map_add' := fun a b => by
        show (Scheme.Modules.Hom.app φ U (Θ U hU (a + b)) : Γ(wcCnPush g, U)) =
          Scheme.Modules.Hom.app φ U (Θ U hU a) + Scheme.Modules.Hom.app φ U (Θ U hU b)
        rw [map_add, map_add] }
  have hρ : ∀ (U : Z.Opens) (hU : IsAffineOpen U) (a : Γ(V, p ⁻¹ᵁ U)),
      ρ U hU a = (show Γ(Wn, g ⁻¹ᵁ U) from Scheme.Modules.Hom.app φ U (Θ U hU a)) :=
    fun _ _ _ => rfl
  refine ⟨ρ, ?_, ?_, ?_, ?_⟩
  ·
    intro U U' hU hU' hle x
    rw [hρ, hρ, hnat U U' hU hU' hle x]
    exact NatTrans.naturality_apply (Scheme.Modules.Hom.mapPresheaf φ) (homOfLE hle).op (Θ U hU x)
  ·
    intro U hU r
    have e1 : Θ U hU (p.app U r) = r • Θ U hU 1 := by rw [← hsmul, mul_one]
    rw [hρ, e1, Scheme.Modules.Hom.app_smul]
    show (g.app U).hom r * (show Γ(Wn, g ⁻¹ᵁ U) from Scheme.Modules.Hom.app φ U (Θ U hU 1)) =
      g.app U r
    rw [hone U hU, mul_one]
  ·
    intro U hU y
    obtain ⟨s, hs⟩ := (hφ U hU).1 y
    refine ⟨(Θ U hU).symm s, ?_⟩
    rw [hρ, AddEquiv.apply_symm_apply]
    exact hs
  ·
    intro U hU
    ext a
    rw [RingHom.mem_ker, ← alg Γ(Z, U) Γ(V, p ⁻¹ᵁ U) Γ(M, U) (p.app U).hom (Θ U hU) (hsmul U hU),
      ← (hφ U hU).2, hρ]
    rfl

theorem wc_cn_algebra_lift_relative_spec : wcCnFormalFns.{u} →
    ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B]
    [IsAdicComplete (IsLocalRing.maximalIdeal B) B] (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B))
    [IsProper h] (W : ℕ → Scheme.{u}) (g : ∀ n, W n ⟶ Z)
    (ψ : ∀ n, wcCnPush (g (n + 1)) ⟶ wcCnPush (g n)),
    wcCnAdicSys h (IsLocalRing.maximalIdeal B) (fun n => wcCnPush (g n)) ψ →
    wcCnRingTower g ψ →
    ∀ (M : Z.Modules) (φ : ∀ n, M ⟶ wcCnPush (g n)),
    wcCnAlg h (IsLocalRing.maximalIdeal B) (fun n => wcCnPush (g n)) ψ M φ →
    ∃ (V : Scheme.{u}) (p : V ⟶ Z)
      (ρ : ∀ n (U : Z.Opens), IsAffineOpen U → (Γ(V, p ⁻¹ᵁ U) →+* Γ(W n, g n ⁻¹ᵁ U))),
      IsFinite p ∧ ∀ n, wcCnQuotData h (IsLocalRing.maximalIdeal B ^ (n + 1)) p (g n) (ρ n) :=
by
  intro hff B _ _ _ _ Z h _ W g ψ hsys hring M φ halg
  haveI hZn : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian h

  have hadd : ∀ (k : ℕ) (R : Type u) [CommRing R] (m : Fin k → R) (i : Fin k) (x y : R),
      ∏ j, Function.update m i (x + y) j =
        ∏ j, Function.update m i x j + ∏ j, Function.update m i y j := by
    intro k R _ m i x y
    simp only [Finset.prod_update_of_mem (Finset.mem_univ i), add_mul]
  have hmulc : ∀ (k : ℕ) (R : Type u) [CommRing R] (m : Fin k → R) (i : Fin k) (c x : R),
      ∏ j, Function.update m i (c * x) j = c * ∏ j, Function.update m i x j := by
    intro k R _ m i c x
    simp only [Finset.prod_update_of_mem (Finset.mem_univ i), mul_assoc]

  let lam : ∀ (k n : ℕ) (U : Z.Opens), IsAffineOpen U →
      MultilinearMap Γ(Z, U) (fun _ : Fin k => Γ(wcCnPush (g n), U)) Γ(wcCnPush (g n), U) :=
    fun k n U _ => MultilinearMap.mk'
      (fun x => (show Γ(W n, g n ⁻¹ᵁ U) from ∏ i, (show Γ(W n, g n ⁻¹ᵁ U) from x i)))
      (fun m i x y => hadd k Γ(W n, g n ⁻¹ᵁ U) m i x y)
      (fun m i c x => hmulc k Γ(W n, g n ⁻¹ᵁ U) m i (((g n).app U).hom c) x)
  have hlam_nat : ∀ (k n : ℕ) (U U' : Z.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen U')
      (hle : U' ≤ U) (x : Fin k → Γ(wcCnPush (g n), U)),
      (wcCnPush (g n)).presheaf.map (homOfLE hle).op (lam k n U hU x) =
        lam k n U' hU' (fun i => (wcCnPush (g n)).presheaf.map (homOfLE hle).op (x i)) := by
    intro k n U U' hU hU' hle x
    exact map_prod ((W n).presheaf.map (homOfLE ((g n).preimage_mono hle)).op).hom
      (fun i => (show Γ(W n, g n ⁻¹ᵁ U) from x i)) Finset.univ
  have hlam_psi : ∀ (k n : ℕ) (U : Z.Opens) (hU : IsAffineOpen U)
      (x : Fin k → Γ(wcCnPush (g (n + 1)), U)),
      Scheme.Modules.Hom.app (ψ n) U (lam k (n + 1) U hU x) =
        lam k n U hU (fun i => Scheme.Modules.Hom.app (ψ n) U (x i)) := by
    intro k n U hU x
    let f : Γ(W (n + 1), g (n + 1) ⁻¹ᵁ U) →* Γ(W n, g n ⁻¹ᵁ U) :=
      { toFun := fun s => Scheme.Modules.Hom.app (ψ n) U s
        map_one' := (hring n U 1 1).2
        map_mul' := fun a b => (hring n U a b).1 }
    exact map_prod f (fun i => (show Γ(W (n + 1), g (n + 1) ⁻¹ᵁ U) from x i)) Finset.univ

  have key : ∀ k : ℕ,
      (∃ β : ∀ U : Z.Opens, IsAffineOpen U →
          MultilinearMap Γ(Z, U) (fun _ : Fin k => Γ(M, U)) Γ(M, U),
        (∀ (U U' : Z.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (hle : U' ≤ U)
          (x : Fin k → Γ(M, U)),
          M.presheaf.map (homOfLE hle).op (β U hU x) =
            β U' hU' (fun i => M.presheaf.map (homOfLE hle).op (x i))) ∧
        ∀ n (U : Z.Opens) (hU : IsAffineOpen U) (x : Fin k → Γ(M, U)),
          Scheme.Modules.Hom.app (φ n) U (β U hU x) =
            lam k n U hU (fun i => Scheme.Modules.Hom.app (φ n) U (x i))) ∧
      (∀ β β' : ∀ U : Z.Opens, IsAffineOpen U →
          MultilinearMap Γ(Z, U) (fun _ : Fin k => Γ(M, U)) Γ(M, U),
        (∀ (U U' : Z.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (hle : U' ≤ U)
          (x : Fin k → Γ(M, U)),
          M.presheaf.map (homOfLE hle).op (β U hU x) =
            β U' hU' (fun i => M.presheaf.map (homOfLE hle).op (x i))) →
        (∀ (U U' : Z.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (hle : U' ≤ U)
          (x : Fin k → Γ(M, U)),
          M.presheaf.map (homOfLE hle).op (β' U hU x) =
            β' U' hU' (fun i => M.presheaf.map (homOfLE hle).op (x i))) →
        (∀ n (U : Z.Opens) (hU : IsAffineOpen U) (x : Fin k → Γ(M, U)),
          Scheme.Modules.Hom.app (φ n) U (β U hU x) =
            lam k n U hU (fun i => Scheme.Modules.Hom.app (φ n) U (x i))) →
        (∀ n (U : Z.Opens) (hU : IsAffineOpen U) (x : Fin k → Γ(M, U)),
          Scheme.Modules.Hom.app (φ n) U (β' U hU x) =
            lam k n U hU (fun i => Scheme.Modules.Hom.app (φ n) U (x i))) →
        ∀ (U : Z.Opens) (hU : IsAffineOpen U), β U hU = β' U hU) := by
    intro k
    obtain ⟨E, ev, hEcoh, hev, hevnat⟩ := wc_cn_multilin_hom_sheaf Z M halg.1 k
    obtain ⟨Q, ψQ, Φ, hQ1, hQ2⟩ :=
      wc_cn_coherent_adic_quotients B (IsLocalRing.maximalIdeal B) Z h E hEcoh
    exact wc_cn_formal_multilin_lift wc_cn_multilin_artin_rees_sep wc_cn_multilin_artin_rees_lift
      hff B Z h (fun n => wcCnPush (g n)) ψ M φ hsys halg k E ev hEcoh hev hevnat Q ψQ Φ hQ1 hQ2
      (lam k) (hlam_nat k) (hlam_psi k)
  obtain ⟨⟨β0, hβ0nat, hβ0lift⟩, -⟩ := key 0
  obtain ⟨⟨μ, hμnat, hμlift⟩, huniq2⟩ := key 2
  obtain ⟨-, huniq1⟩ := key 1
  obtain ⟨-, huniq3⟩ := key 3

  let one : ∀ U : Z.Opens, IsAffineOpen U → Γ(M, U) := fun U hU => β0 U hU (fun i => Fin.elim0 i)
  have hone_nat : ∀ (U U' : Z.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (hle : U' ≤ U),
      M.presheaf.map (homOfLE hle).op (one U hU) = one U' hU' := fun U U' hU hU' hle =>
    (hβ0nat U U' hU hU' hle _).trans (congrArg (β0 U' hU') (Subsingleton.elim _ _))
  have hone_lift : ∀ n (U : Z.Opens) (hU : IsAffineOpen U),
      (show Γ(W n, g n ⁻¹ᵁ U) from Scheme.Modules.Hom.app (φ n) U (one U hU)) = 1 :=
    fun n U hU => (hβ0lift n U hU _).trans (Fin.prod_univ_zero (M := Γ(W n, g n ⁻¹ᵁ U))
      (fun i => (show Γ(W n, g n ⁻¹ᵁ U) from
        Scheme.Modules.Hom.app (φ n) U ((fun i => Fin.elim0 i : Fin 0 → Γ(M, U)) i))))

  have hμnat2 : ∀ (U U' : Z.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (hle : U' ≤ U)
      (a b : Γ(M, U)), M.presheaf.map (homOfLE hle).op (μ U hU ![a, b]) =
        μ U' hU' ![M.presheaf.map (homOfLE hle).op a, M.presheaf.map (homOfLE hle).op b] := by
    intro U U' hU hU' hle a b
    rw [hμnat U U' hU hU' hle ![a, b]]
    congr 1
    funext i
    fin_cases i <;> rfl
  have hμlift2 : ∀ n (U : Z.Opens) (hU : IsAffineOpen U) (a b : Γ(M, U)),
      (show Γ(W n, g n ⁻¹ᵁ U) from Scheme.Modules.Hom.app (φ n) U (μ U hU ![a, b])) =
        (show Γ(W n, g n ⁻¹ᵁ U) from Scheme.Modules.Hom.app (φ n) U a) *
          (show Γ(W n, g n ⁻¹ᵁ U) from Scheme.Modules.Hom.app (φ n) U b) :=
    fun n U hU a b => (hμlift n U hU ![a, b]).trans
      (Fin.prod_univ_two (M := Γ(W n, g n ⁻¹ᵁ U))
        (fun i => (show Γ(W n, g n ⁻¹ᵁ U) from Scheme.Modules.Hom.app (φ n) U (![a, b] i))))

  have hv0 : ∀ (X : Type u) (a b c : X), Function.update ![a, b] 0 c = ![c, b] := by
    intro X a b c; funext j; fin_cases j <;> rfl
  have hv1 : ∀ (X : Type u) (a b c : X), Function.update ![a, b] 1 c = ![a, c] := by
    intro X a b c; funext j; fin_cases j <;> rfl
  let L : ∀ U : Z.Opens, IsAffineOpen U → Γ(M, U) →ₗ[Γ(Z, U)] Γ(M, U) →ₗ[Γ(Z, U)] Γ(M, U) :=
    fun U hU => LinearMap.mk₂ Γ(Z, U) (fun x y => μ U hU ![x, y])
      (fun x1 x2 y => by
        rw [← hv0 _ x1 y (x1 + x2), (μ U hU).map_update_add, hv0, hv0])
      (fun c x y => by
        rw [← hv0 _ x y (c • x), (μ U hU).map_update_smul, hv0])
      (fun x y1 y2 => by
        rw [← hv1 _ x y1 (y1 + y2), (μ U hU).map_update_add, hv1, hv1])
      (fun c x y => by
        rw [← hv1 _ x y (c • y), (μ U hU).map_update_smul, hv1])

  let βs : ∀ U : Z.Opens, IsAffineOpen U →
      MultilinearMap Γ(Z, U) (fun _ : Fin 2 => Γ(M, U)) Γ(M, U) :=
    fun U hU => (μ U hU).domDomCongr (Equiv.swap (0 : Fin 2) 1)
  have hcomm : ∀ (U : Z.Opens) (hU : IsAffineOpen U) (x y : Γ(M, U)),
      μ U hU ![x, y] = μ U hU ![y, x] := by
    have hu := huniq2 μ βs hμnat
      (fun U U' hU hU' hle x => hμnat U U' hU hU' hle _) hμlift
      (fun n U hU x => (hμlift n U hU _).trans
        (Equiv.prod_comp (Equiv.swap (0 : Fin 2) 1)
          (fun i => (show Γ(W n, g n ⁻¹ᵁ U) from Scheme.Modules.Hom.app (φ n) U (x i)))))
    intro U hU x y
    refine (MultilinearMap.congr_fun (hu U hU) ![x, y]).trans ?_
    show μ U hU (fun i => ![x, y] (Equiv.swap (0 : Fin 2) 1 i)) = _
    congr 1
    funext i
    fin_cases i <;> simp

  let β3 : ∀ U : Z.Opens, IsAffineOpen U →
      MultilinearMap Γ(Z, U) (fun _ : Fin 3 => Γ(M, U)) Γ(M, U) :=
    fun U hU => MultilinearMap.mk' (fun x => L U hU (L U hU (x 0) (x 1)) (x 2))
      (fun m i a b => by fin_cases i <;> simp)
      (fun m i c a => by fin_cases i <;> simp)
  let β3' : ∀ U : Z.Opens, IsAffineOpen U →
      MultilinearMap Γ(Z, U) (fun _ : Fin 3 => Γ(M, U)) Γ(M, U) :=
    fun U hU => MultilinearMap.mk' (fun x => L U hU (x 0) (L U hU (x 1) (x 2)))
      (fun m i a b => by fin_cases i <;> simp)
      (fun m i c a => by fin_cases i <;> simp)
  have hassoc : ∀ (U : Z.Opens) (hU : IsAffineOpen U) (x y z : Γ(M, U)),
      μ U hU ![μ U hU ![x, y], z] = μ U hU ![x, μ U hU ![y, z]] := by
    have hu := huniq3 β3 β3'
      (fun U U' hU hU' hle x => by
        show M.presheaf.map (homOfLE hle).op (μ U hU ![μ U hU ![x 0, x 1], x 2]) =
          μ U' hU' ![μ U' hU' ![M.presheaf.map (homOfLE hle).op (x 0),
            M.presheaf.map (homOfLE hle).op (x 1)], M.presheaf.map (homOfLE hle).op (x 2)]
        rw [hμnat2, hμnat2])
      (fun U U' hU hU' hle x => by
        show M.presheaf.map (homOfLE hle).op (μ U hU ![x 0, μ U hU ![x 1, x 2]]) =
          μ U' hU' ![M.presheaf.map (homOfLE hle).op (x 0),
            μ U' hU' ![M.presheaf.map (homOfLE hle).op (x 1), M.presheaf.map (homOfLE hle).op (x 2)]]
        rw [hμnat2, hμnat2])
      (fun n U hU x => by
        show (show Γ(W n, g n ⁻¹ᵁ U) from
            Scheme.Modules.Hom.app (φ n) U (μ U hU ![μ U hU ![x 0, x 1], x 2])) =
          ∏ i, (show Γ(W n, g n ⁻¹ᵁ U) from Scheme.Modules.Hom.app (φ n) U (x i))
        rw [hμlift2, hμlift2, Fin.prod_univ_three])
      (fun n U hU x => by
        show (show Γ(W n, g n ⁻¹ᵁ U) from
            Scheme.Modules.Hom.app (φ n) U (μ U hU ![x 0, μ U hU ![x 1, x 2]])) =
          ∏ i, (show Γ(W n, g n ⁻¹ᵁ U) from Scheme.Modules.Hom.app (φ n) U (x i))
        rw [hμlift2, hμlift2, Fin.prod_univ_three, mul_assoc])
    intro U hU x y z
    exact MultilinearMap.congr_fun (hu U hU) ![x, y, z]

  let β1 : ∀ U : Z.Opens, IsAffineOpen U →
      MultilinearMap Γ(Z, U) (fun _ : Fin 1 => Γ(M, U)) Γ(M, U) :=
    fun U hU => MultilinearMap.ofSubsingleton Γ(Z, U) Γ(M, U) Γ(M, U) (0 : Fin 1) (L U hU (one U hU))
  let β1' : ∀ U : Z.Opens, IsAffineOpen U →
      MultilinearMap Γ(Z, U) (fun _ : Fin 1 => Γ(M, U)) Γ(M, U) :=
    fun U hU => MultilinearMap.ofSubsingleton Γ(Z, U) Γ(M, U) Γ(M, U) (0 : Fin 1) LinearMap.id
  have hunit : ∀ (U : Z.Opens) (hU : IsAffineOpen U) (x : Γ(M, U)), μ U hU ![one U hU, x] = x := by
    have hu := huniq1 β1 β1'
      (fun U U' hU hU' hle x => by
        show M.presheaf.map (homOfLE hle).op (μ U hU ![one U hU, x 0]) =
          μ U' hU' ![one U' hU', M.presheaf.map (homOfLE hle).op (x 0)]
        rw [hμnat2, hone_nat])
      (fun U U' hU hU' hle x => rfl)
      (fun n U hU x => by
        show (show Γ(W n, g n ⁻¹ᵁ U) from
            Scheme.Modules.Hom.app (φ n) U (μ U hU ![one U hU, x 0])) =
          ∏ i, (show Γ(W n, g n ⁻¹ᵁ U) from Scheme.Modules.Hom.app (φ n) U (x i))
        rw [hμlift2, hone_lift, one_mul, Fin.prod_univ_one])
      (fun n U hU x => (Fin.prod_univ_one (M := Γ(W n, g n ⁻¹ᵁ U))
        (fun i => (show Γ(W n, g n ⁻¹ᵁ U) from Scheme.Modules.Hom.app (φ n) U (x i)))).symm)
    intro U hU x
    exact MultilinearMap.congr_fun (hu U hU) (fun _ => x)

  obtain ⟨F, α, E, hcoeq, hfin, hEmul, hEone, hEsmul, hEnat⟩ :=
    wc_cn_ring_structure_coequifibered Z M halg.1 one μ hone_nat hμnat hcomm hassoc hunit
  obtain ⟨V, p, e, hp, he_α, he_nat⟩ := wc_cn_finite_relative_spec Z F α hcoeq hfin
  let toA : ∀ U : Z.Opens, IsAffineOpen U → Z.AffineZariskiSite := fun U hU => ⟨U, hU⟩
  let Θ : ∀ U : Z.Opens, IsAffineOpen U → (Γ(V, p ⁻¹ᵁ U) ≃+ Γ(M, U)) := fun U hU =>
    ((e (toA U hU)).commRingCatIsoToRingEquiv.toAddEquiv).trans (E (toA U hU)).symm
  have hΘapp : ∀ (U : Z.Opens) (hU : IsAffineOpen U) (a : Γ(V, p ⁻¹ᵁ U)),
      Θ U hU a = (E (toA U hU)).symm ((e (toA U hU)).hom a) := fun _ _ _ => rfl
  have hEΘ : ∀ (U : Z.Opens) (hU : IsAffineOpen U) (a : Γ(V, p ⁻¹ᵁ U)),
      E (toA U hU) (Θ U hU a) = (e (toA U hU)).hom a := fun U hU a =>
    AddEquiv.apply_symm_apply _ _

  have hΘsmul : ∀ (U : Z.Opens) (hU : IsAffineOpen U) (r : Γ(Z, U)) (a : Γ(V, p ⁻¹ᵁ U)),
      Θ U hU (p.app U r * a) = r • Θ U hU a := by
    intro U hU r a
    rw [hΘapp, AddEquiv.symm_apply_eq]
    refine ((map_mul _ _ _).trans ?_).trans (hEsmul (toA U hU) r (Θ U hU a)).symm
    rw [hEΘ]
    congr 1
    have := ConcreteCategory.congr_hom (he_α (toA U hU)) r
    rw [CategoryTheory.comp_apply] at this
    exact this
  have hΘmul : ∀ (U : Z.Opens) (hU : IsAffineOpen U) (a b : Γ(V, p ⁻¹ᵁ U)),
      Θ U hU (a * b) = μ U hU ![Θ U hU a, Θ U hU b] := by
    intro U hU a b
    rw [hΘapp, AddEquiv.symm_apply_eq]
    refine (map_mul _ _ _).trans ?_
    refine Eq.trans ?_ (hEmul (toA U hU) (Θ U hU a) (Θ U hU b)).symm
    rw [hEΘ, hEΘ]
  have hΘone : ∀ (U : Z.Opens) (hU : IsAffineOpen U), Θ U hU 1 = one U hU := by
    intro U hU
    rw [hΘapp, AddEquiv.symm_apply_eq]
    exact (map_one _).trans (hEone (toA U hU)).symm

  have hres_M : ∀ (A₁ A₂ A₃ : Z.Opens) (h1 : A₂ ≤ A₁) (h2 : A₃ ≤ A₂) (s : Γ(M, A₁)),
      M.presheaf.map (homOfLE h2).op (M.presheaf.map (homOfLE h1).op s) =
        M.presheaf.map (homOfLE (h2.trans h1)).op s := by
    intro A₁ A₂ A₃ h1 h2 s
    rw [← CategoryTheory.comp_apply, ← Functor.map_comp]
    rfl
  have hres_V : ∀ (A₁ A₂ A₃ : V.Opens) (h1 : A₂ ≤ A₁) (h2 : A₃ ≤ A₂) (s : Γ(V, A₁)),
      V.presheaf.map (homOfLE h2).op (V.presheaf.map (homOfLE h1).op s) =
        V.presheaf.map (homOfLE (h2.trans h1)).op s := by
    intro A₁ A₂ A₃ h1 h2 s
    rw [← CategoryTheory.comp_apply, ← Functor.map_comp]
    rfl
  have hbasic : ∀ (U : Z.Opens) (hU : IsAffineOpen U) (f : Γ(Z, U)) (D : Z.Opens)
      (hD : IsAffineOpen D) (hDf : Z.basicOpen f = D) (hDU : D ≤ U) (a : Γ(V, p ⁻¹ᵁ U)),
      Θ D hD (V.presheaf.map (homOfLE (p.preimage_mono hDU)).op a) =
        M.presheaf.map (homOfLE hDU).op (Θ U hU a) := by
    intro U hU f D hD hDf hDU a
    have hle : toA D hD ≤ toA U hU := ⟨f, hDf⟩
    rw [hΘapp, hΘapp, AddEquiv.symm_apply_eq]
    have h1 := ConcreteCategory.congr_hom (he_nat (toA U hU) (toA D hD) hle) a
    rw [CategoryTheory.comp_apply, CategoryTheory.comp_apply] at h1
    refine h1.trans ?_
    refine Eq.trans ?_ (hEnat (toA U hU) (toA D hD) hle _).symm
    rw [AddEquiv.apply_symm_apply]

  have hΘnat : ∀ (U U' : Z.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (hle : U' ≤ U)
      (a : Γ(V, p ⁻¹ᵁ U)),
      Θ U' hU' (V.presheaf.map (homOfLE (p.preimage_mono hle)).op a) =
        M.presheaf.map (homOfLE hle).op (Θ U hU a) := by
    intro U U' hU hU' hle a
    have hcov : ∀ x : U', ∃ (f : Γ(Z, U)) (f' : Γ(Z, U')),
        Z.basicOpen f = Z.basicOpen f' ∧ (x : Z) ∈ Z.basicOpen f :=
      fun x => exists_basicOpen_le_affine_inter hU hU' (x : Z) ⟨hle x.2, x.2⟩
    choose f f' hff' hxf using hcov
    refine TopCat.Sheaf.eq_of_locally_eq' ⟨M.presheaf, M.isSheaf⟩
      (fun x => Z.basicOpen (f' x)) U' (fun x => homOfLE (Z.basicOpen_le (f' x))) ?_ _ _ ?_
    · intro y hy
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨y, hy⟩, (hff' ⟨y, hy⟩) ▸ hxf ⟨y, hy⟩⟩
    · intro x
      have hDU' : Z.basicOpen (f' x) ≤ U' := Z.basicOpen_le (f' x)
      have hDU : Z.basicOpen (f' x) ≤ U := hDU'.trans hle
      have hD : IsAffineOpen (Z.basicOpen (f' x)) := hU'.basicOpen (f' x)
      have e1 := hbasic U' hU' (f' x) _ hD rfl hDU'
        (V.presheaf.map (homOfLE (p.preimage_mono hle)).op a)
      have e2 := hbasic U hU (f x) _ hD (hff' x) hDU a
      rw [hres_V] at e1
      change M.presheaf.map (homOfLE hDU').op _ = M.presheaf.map (homOfLE hDU').op _
      rw [← e1, hres_M, ← e2]

  have hρ : ∀ n, ∃ ρ : ∀ U : Z.Opens, IsAffineOpen U → (Γ(V, p ⁻¹ᵁ U) →+* Γ(W n, g n ⁻¹ᵁ U)),
      wcCnQuotData h (IsLocalRing.maximalIdeal B ^ (n + 1)) p (g n) ρ := fun n =>
    wc_cn_quot_data_transport B Z V (W n) h (IsLocalRing.maximalIdeal B ^ (n + 1)) p (g n) M (φ n)
      Θ hΘsmul
      (fun U hU a b => by rw [hΘmul]; exact hμlift2 n U hU _ _)
      (fun U hU => by rw [hΘone]; exact hone_lift n U hU)
      hΘnat (halg.2.2 n)
  choose ρ hρ using hρ
  exact ⟨V, p, ρ, hp, hρ⟩

theorem wc_cn_pullback_of_affine_quotients : ∀ (Z V W Z' : Scheme.{u}) (p : V ⟶ Z) [IsAffineHom p]
    (ι : Z' ⟶ Z) [IsClosedImmersion ι] (q : W ⟶ Z') [IsAffineHom q]
    (ρ : ∀ U : Z.Opens, IsAffineOpen U → (Γ(V, p ⁻¹ᵁ U) →+* Γ(W, (q ≫ ι) ⁻¹ᵁ U))),
    (∀ (U U' : Z.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (h : U' ≤ U)
        (x : Γ(V, p ⁻¹ᵁ U)),
      ρ U' hU' (V.presheaf.map (homOfLE (p.preimage_mono h)).op x) =
        W.presheaf.map (homOfLE ((q ≫ ι).preimage_mono h)).op (ρ U hU x)) →
    (∀ (U : Z.Opens) (hU : IsAffineOpen U) (r : Γ(Z, U)), ρ U hU (p.app U r) = (q ≫ ι).app U r) →
    (∀ (U : Z.Opens) (hU : IsAffineOpen U), Function.Surjective (ρ U hU)) →
    (∀ (U : Z.Opens) (hU : IsAffineOpen U),
      RingHom.ker (ρ U hU) = Ideal.map (p.app U).hom (RingHom.ker (ι.app U).hom)) →
    ∃ j : W ⟶ V, IsPullback j q p ι :=
by

  have wc_tinv_isPullback_of_local : ∀ (V₀ V T T' : Scheme.{u}) (j : V₀ ⟶ V) (p₀ : V₀ ⟶ T) (p : V ⟶ T') (k : T ⟶ T') (ι : Type u) (S : ι → Scheme.{u}) (s : ∀ i, S i ⟶ T'), (∀ i, IsOpenImmersion (s i)) → (∀ x : T', ∃ i, x ∈ Set.range (s i)) → j ≫ p = p₀ ≫ k → (∀ i, ∃ (A B C : Scheme.{u}) (a : A ⟶ V₀) (b : B ⟶ V) (c : C ⟶ T) (jA : A ⟶ B) (pA : A ⟶ C) (pB : B ⟶ S i) (kC : C ⟶ S i), IsPullback b pB p (s i) ∧ IsPullback c kC k (s i) ∧ IsPullback a pA p₀ c ∧ jA ≫ b = a ≫ j ∧ IsPullback jA pA pB kC) → IsPullback j p₀ p k := by
    intro V₀ V T T' j p₀ p k ι S s hs hcov hw hloc
    choose A B C a b c jA pA pB kC H1 H2 H3 H4 H5 using hloc
    have hb : ∀ i, IsOpenImmersion (b i) := fun i =>
      MorphismProperty.of_isPullback (P := @IsOpenImmersion) (H1 i).flip (hs i)
    have hc : ∀ x : V, ∃ i y, b i y = x := by
      intro x
      obtain ⟨i, hi⟩ := hcov (p x)
      have hx : x ∈ Set.range (Limits.pullback.fst p (s i)) := by
        rw [Scheme.Pullback.range_fst]; exact hi
      obtain ⟨w, hw'⟩ := hx
      refine ⟨i, (H1 i).isoPullback.inv w, ?_⟩
      rw [← Scheme.Hom.comp_apply, IsPullback.isoPullback_inv_fst, hw']
    let 𝒰 : V.OpenCover := Scheme.Cover.mkOfCovers (P := @IsOpenImmersion) ι B b hc hb
    apply Scheme.isPullback_of_openCover (𝒰 := 𝒰)
    intro i
    have Q1 : IsPullback (a i) (jA i) j (b i) := by
      refine IsPullback.of_bot ?_ (H4 i).symm (H1 i)
      have := (H3 i).paste_vert (H2 i)
      rw [← (H5 i).w, ← hw] at this
      exact this
    have P2 : IsPullback (jA i) (pA i ≫ c i) (b i ≫ p) k := by
      have := (H5 i).paste_vert (H2 i).flip
      rw [← (H1 i).w] at this
      exact this
    have L : IsPullback (Limits.pullback.snd j (b i)) (Limits.pullback.fst j (b i) ≫ p₀)
        (b i ≫ p) k := by
      refine IsPullback.of_iso P2 Q1.isoPullback (Iso.refl _) (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
      · simp [IsPullback.isoPullback_hom_snd]
      · rw [Iso.refl_hom, Category.comp_id, ← Category.assoc, IsPullback.isoPullback_hom_fst,
          (H3 i).w]
      · simp
      · simp
    exact L
  intro Z V W Z' p _ ι _ q _ ρ hN hL hS hK

  have s1 : ∀ (U : Z.Opens), IsAffineOpen U → Function.Surjective (ι.app U).hom := by
    intro U hU
    haveI : IsAffine U := hU
    have h := (IsClosedImmersion.isAffine_surjective_of_isAffine (ι ∣_ U)).2
    rw [morphismRestrict_appTop] at h
    have aux : ∀ {A B C : CommRingCat.{u}} (f : A ⟶ B) (e : B = C),
        Function.Surjective (f ≫ eqToHom e).hom → Function.Surjective f.hom := by
      intro A B C f e hfg
      subst e
      simpa using hfg
    rw [eqToHom_op, eqToHom_map] at h
    have h2 := aux _ _ h
    have key : ∀ (U₁ U₂ : Z.Opens), U₁ = U₂ → Function.Surjective (ι.app U₁).hom →
        Function.Surjective (ι.app U₂).hom := by
      rintro _ _ rfl hh; exact hh
    exact key _ _ (Scheme.Opens.ι_image_top U) h2

  have s2 : ∀ (R R' A S : CommRingCat.{u}) (f : R ⟶ R') (i : R ⟶ A) (r : R' ⟶ S) (s : A ⟶ S),
      f ≫ r = i ≫ s → Function.Surjective i.hom → Function.Surjective r.hom →
      RingHom.ker r.hom = Ideal.map f.hom (RingHom.ker i.hom) → IsPushout f i r s := by
    intro R R' A S f i r s hc hi hr hk
    have hc' : ∀ x, r.hom (f.hom x) = s.hom (i.hom x) := fun x => by
      have := congrArg (fun φ => φ.hom x) hc
      simpa using this
    have kill : ∀ (c : Limits.PushoutCocone f i), ∀ a ∈ RingHom.ker r.hom, c.inl.hom a = 0 := by
      intro c a ha
      rw [hk] at ha
      have hle : Ideal.map f.hom (RingHom.ker i.hom) ≤ RingHom.ker c.inl.hom := by
        rw [Ideal.map_le_iff_le_comap]
        intro x hx
        rw [Ideal.mem_comap, RingHom.mem_ker]
        have := congrArg (fun φ => φ.hom x) c.condition
        simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
        rw [this, RingHom.mem_ker.mp hx, map_zero]
      exact hle ha
    let e := RingHom.quotientKerEquivOfSurjective hr
    have he : ∀ y, e.symm (r.hom y) = Ideal.Quotient.mk (RingHom.ker r.hom) y := fun y => by
      rw [RingEquiv.symm_apply_eq]
      rfl
    let desc : ∀ c : Limits.PushoutCocone f i, S ⟶ c.pt := fun c =>
      CommRingCat.ofHom ((Ideal.Quotient.lift (RingHom.ker r.hom) c.inl.hom (kill c)).comp
        (e.symm : S →+* R' ⧸ RingHom.ker r.hom))
    have hdesc : ∀ (c : Limits.PushoutCocone f i) y, (desc c).hom (r.hom y) = c.inl.hom y := by
      intro c y
      change Ideal.Quotient.lift (RingHom.ker r.hom) c.inl.hom (kill c) (e.symm (r.hom y)) = _
      rw [he, Ideal.Quotient.lift_mk]
    refine IsPushout.of_isColimit (c := Limits.PushoutCocone.mk r s hc)
      (Limits.PushoutCocone.IsColimit.mk hc desc ?_ ?_ ?_)
    · intro c
      ext y
      exact hdesc c y
    · intro c
      ext a
      obtain ⟨x, rfl⟩ := hi a
      have h1 := congrArg (fun φ => φ.hom x) c.condition
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h1
      change (desc c).hom (s.hom (i.hom x)) = c.inr.hom (i.hom x)
      rw [← hc', hdesc, h1]
    · intro c m hm _
      ext z
      obtain ⟨y, rfl⟩ := hr z
      have h1 := congrArg (fun φ => φ.hom y) hm
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h1
      rw [hdesc, ← h1]

  have s3 : ∀ (U : Z.Opens) (hU : IsAffineOpen U) (hV : IsAffineOpen (p ⁻¹ᵁ U))
      (hZ' : IsAffineOpen (ι ⁻¹ᵁ U)) (hW : IsAffineOpen (q ⁻¹ᵁ ι ⁻¹ᵁ U))
      (r : Γ(V, p ⁻¹ᵁ U) ⟶ Γ(W, q ⁻¹ᵁ ι ⁻¹ᵁ U)),
      IsPushout (p.app U) (ι.app U) r (q.app (ι ⁻¹ᵁ U)) →
      IsPullback ((q ⁻¹ᵁ ι ⁻¹ᵁ U).toSpecΓ ≫ Spec.map r ≫ hV.isoSpec.inv)
        (q ∣_ (ι ⁻¹ᵁ U)) (p ∣_ U) (ι ∣_ U) := by
    intro U hU hV hZ' hW r hpo
    have H := isPullback_SpecMap_of_isPushout _ _ _ _ hpo
    refine IsPullback.of_iso H hW.isoSpec.symm hV.isoSpec.symm hZ'.isoSpec.symm
      hU.isoSpec.symm ?_ ?_ ?_ ?_
    · simp only [Iso.symm_hom]
      rw [← Category.assoc hW.isoSpec.inv, hW.isoSpec_inv_toSpecΓ, Category.id_comp]
    · simp only [Iso.symm_hom]
      rw [Iso.comp_inv_eq, Category.assoc, IsAffineOpen.isoSpec_hom,
        ← Scheme.Opens.toSpecΓ_naturality, ← Category.assoc, hW.isoSpec_inv_toSpecΓ,
        Category.id_comp]
    · simp only [Iso.symm_hom]
      rw [Iso.comp_inv_eq, Category.assoc, IsAffineOpen.isoSpec_hom,
        ← Scheme.Opens.toSpecΓ_naturality, ← Category.assoc, hV.isoSpec_inv_toSpecΓ,
        Category.id_comp]
    · simp only [Iso.symm_hom]
      rw [Iso.comp_inv_eq, Category.assoc, IsAffineOpen.isoSpec_hom,
        ← Scheme.Opens.toSpecΓ_naturality, ← Category.assoc, hZ'.isoSpec_inv_toSpecΓ,
        Category.id_comp]

  let f : ∀ U : Z.Opens, IsAffineOpen U → (((q ≫ ι) ⁻¹ᵁ U : Scheme.{u}) ⟶ V) := fun U hU =>
    ((q ≫ ι) ⁻¹ᵁ U).toSpecΓ ≫ Spec.map (CommRingCat.ofHom (ρ U hU)) ≫ (hU.preimage p).fromSpec

  have s5a : ∀ (U U' : Z.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (h : U' ≤ U),
      W.homOfLE ((q ≫ ι).preimage_mono h) ≫ f U hU = f U' hU' := by
    intro U U' hU hU' h
    have hc : CommRingCat.ofHom (ρ U hU) ≫ W.presheaf.map (homOfLE ((q ≫ ι).preimage_mono h)).op =
        V.presheaf.map (homOfLE (p.preimage_mono h)).op ≫ CommRingCat.ofHom (ρ U' hU') := by
      ext x
      exact (hN U U' hU hU' h x).symm
    simp only [f]
    rw [← Category.assoc, ← Scheme.Opens.toSpecΓ_SpecMap_presheaf_map, Category.assoc,
      ← Spec.map_comp_assoc, hc, Spec.map_comp_assoc, IsAffineOpen.map_fromSpec]

  have s5b : ∀ (U : Z.Opens) (hU : IsAffineOpen U), f U hU ≫ p = ((q ≫ ι) ⁻¹ᵁ U).ι ≫ q ≫ ι := by
    intro U hU
    have hc : p.app U ≫ CommRingCat.ofHom (ρ U hU) = (q ≫ ι).app U := by
      ext x
      exact hL U hU x
    simp only [f]
    rw [Category.assoc, Category.assoc,
      ← IsAffineOpen.SpecMap_appLE_fromSpec p hU (hU.preimage p) le_rfl,
      Scheme.Hom.appLE_eq_app, ← Spec.map_comp_assoc, hc, ← Category.assoc,
      Scheme.Opens.toSpecΓ_naturality, Category.assoc, IsAffineOpen.toSpecΓ_fromSpec,
      morphismRestrict_ι]

  have hcov : TopologicalSpace.IsOpenCover (fun U : Z.affineOpens => (q ≫ ι) ⁻¹ᵁ U.1) := by
    refine TopologicalSpace.IsOpenCover.mk ?_
    rw [eq_top_iff]
    rintro w -
    obtain ⟨U, hU, hwU, -⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp Z.isBasis_affineOpens
      (show (q ≫ ι) w ∈ (⊤ : Z.Opens) from trivial)
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨U, hU⟩, hwU⟩
  let 𝒰 := W.openCoverOfIsOpenCover _ hcov

  have hcoc : ∀ (x y : Z.affineOpens),
      Limits.pullback.fst ((q ≫ ι) ⁻¹ᵁ x.1).ι ((q ≫ ι) ⁻¹ᵁ y.1).ι ≫ f x.1 x.2 =
        Limits.pullback.snd ((q ≫ ι) ⁻¹ᵁ x.1).ι ((q ≫ ι) ⁻¹ᵁ y.1).ι ≫ f y.1 y.2 := by
    intro x y
    obtain ⟨π, hπ⟩ : ∃ π, π = Limits.pullback.fst ((q ≫ ι) ⁻¹ᵁ x.1).ι ((q ≫ ι) ⁻¹ᵁ y.1).ι ≫
        ((q ≫ ι) ⁻¹ᵁ x.1).ι := ⟨_, rfl⟩
    have hπ' : Limits.pullback.snd ((q ≫ ι) ⁻¹ᵁ x.1).ι ((q ≫ ι) ⁻¹ᵁ y.1).ι ≫
        ((q ≫ ι) ⁻¹ᵁ y.1).ι = π := by
      rw [hπ]; exact Limits.pullback.condition.symm
    have hcovP : TopologicalSpace.IsOpenCover
        (fun U₃ : {U₃ : Z.affineOpens // U₃.1 ≤ x.1 ⊓ y.1} => π ⁻¹ᵁ (q ≫ ι) ⁻¹ᵁ U₃.1.1) := by
      refine TopologicalSpace.IsOpenCover.mk ?_
      rw [eq_top_iff]
      rintro z -
      have h1 : π z ∈ (q ≫ ι) ⁻¹ᵁ x.1 := by
        rw [← SetLike.mem_coe, ← Scheme.Opens.range_ι]
        exact ⟨(Limits.pullback.fst ((q ≫ ι) ⁻¹ᵁ x.1).ι ((q ≫ ι) ⁻¹ᵁ y.1).ι) z,
          by rw [hπ, Scheme.Hom.comp_apply]⟩
      have h2 : π z ∈ (q ≫ ι) ⁻¹ᵁ y.1 := by
        rw [← SetLike.mem_coe, ← Scheme.Opens.range_ι]
        exact ⟨(Limits.pullback.snd ((q ≫ ι) ⁻¹ᵁ x.1).ι ((q ≫ ι) ⁻¹ᵁ y.1).ι) z,
          by rw [← hπ', Scheme.Hom.comp_apply]⟩
      obtain ⟨U₃, hU₃, hmem, hle⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp
        Z.isBasis_affineOpens (show (q ≫ ι) (π z) ∈ x.1 ⊓ y.1 from ⟨h1, h2⟩)
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨⟨U₃, hU₃⟩, hle⟩, hmem⟩
    have key : ∀ U₃ : {U₃ : Z.affineOpens // U₃.1 ≤ x.1 ⊓ y.1},
        (π ⁻¹ᵁ (q ≫ ι) ⁻¹ᵁ U₃.1.1).ι ≫
          Limits.pullback.fst ((q ≫ ι) ⁻¹ᵁ x.1).ι ((q ≫ ι) ⁻¹ᵁ y.1).ι ≫ f x.1 x.2 =
        (π ⁻¹ᵁ (q ≫ ι) ⁻¹ᵁ U₃.1.1).ι ≫
          Limits.pullback.snd ((q ≫ ι) ⁻¹ᵁ x.1).ι ((q ≫ ι) ⁻¹ᵁ y.1).ι ≫ f y.1 y.2 := by
      rintro ⟨⟨U₃, hU₃⟩, hle⟩
      have e1 : (π ⁻¹ᵁ (q ≫ ι) ⁻¹ᵁ U₃).ι ≫
          Limits.pullback.fst ((q ≫ ι) ⁻¹ᵁ x.1).ι ((q ≫ ι) ⁻¹ᵁ y.1).ι =
          π ∣_ ((q ≫ ι) ⁻¹ᵁ U₃) ≫ W.homOfLE ((q ≫ ι).preimage_mono (hle.trans inf_le_left)) := by
        rw [← cancel_mono ((q ≫ ι) ⁻¹ᵁ x.1).ι, Category.assoc, Category.assoc, Scheme.homOfLE_ι,
          morphismRestrict_ι, ← hπ]
      have e2 : (π ⁻¹ᵁ (q ≫ ι) ⁻¹ᵁ U₃).ι ≫
          Limits.pullback.snd ((q ≫ ι) ⁻¹ᵁ x.1).ι ((q ≫ ι) ⁻¹ᵁ y.1).ι =
          π ∣_ ((q ≫ ι) ⁻¹ᵁ U₃) ≫ W.homOfLE ((q ≫ ι).preimage_mono (hle.trans inf_le_right)) := by
        rw [← cancel_mono ((q ≫ ι) ⁻¹ᵁ y.1).ι, Category.assoc, Category.assoc, Scheme.homOfLE_ι,
          morphismRestrict_ι, hπ']
      rw [reassoc_of% e1, reassoc_of% e2]
      congr 1
      exact (s5a x.1 U₃ x.2 hU₃ (hle.trans inf_le_left)).trans
        (s5a y.1 U₃ y.2 hU₃ (hle.trans inf_le_right)).symm
    refine Scheme.Cover.hom_ext (Scheme.openCoverOfIsOpenCover
      (Limits.pullback ((q ≫ ι) ⁻¹ᵁ x.1).ι ((q ≫ ι) ⁻¹ᵁ y.1).ι) _ hcovP) _ _ (fun i => ?_)
    exact key i

  let j : W ⟶ V := 𝒰.glueMorphisms (fun U => f U.1 U.2) (fun x y => hcoc x y)
  have hj : ∀ (U : Z.Opens) (hU : IsAffineOpen U), ((q ≫ ι) ⁻¹ᵁ U).ι ≫ j = f U hU :=
    fun U hU => 𝒰.ι_glueMorphisms (fun U => f U.1 U.2) (fun x y => hcoc x y) ⟨U, hU⟩

  have hjp : j ≫ p = q ≫ ι := by
    refine Scheme.Cover.hom_ext 𝒰 _ _ ?_
    intro U
    exact (Category.assoc _ _ _).symm.trans
      ((congrArg (· ≫ p) (hj U.1 U.2)).trans (s5b U.1 U.2))

  refine ⟨j, wc_tinv_isPullback_of_local W V Z' Z j q p ι Z.affineOpens
    (fun U => (U.1 : Scheme.{u})) (fun U => U.1.ι) (fun U => inferInstance) ?_ hjp ?_⟩
  · intro x
    obtain ⟨U, hU, hxU, -⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp Z.isBasis_affineOpens
      (show x ∈ (⊤ : Z.Opens) from trivial)
    exact ⟨⟨U, hU⟩, by rw [Scheme.Opens.range_ι]; exact hxU⟩
  · rintro ⟨U, hU⟩
    have hV : IsAffineOpen (p ⁻¹ᵁ U) := hU.preimage p
    have hZ' : IsAffineOpen (ι ⁻¹ᵁ U) := hU.preimage ι
    have hW : IsAffineOpen (q ⁻¹ᵁ ι ⁻¹ᵁ U) := hZ'.preimage q
    have hcomm : p.app U ≫ CommRingCat.ofHom (ρ U hU) = ι.app U ≫ q.app (ι ⁻¹ᵁ U) := by
      rw [← Scheme.Hom.comp_app]
      ext x
      exact hL U hU x
    refine ⟨(q ⁻¹ᵁ ι ⁻¹ᵁ U : Scheme.{u}), (p ⁻¹ᵁ U : Scheme.{u}), (ι ⁻¹ᵁ U : Scheme.{u}),
      (q ⁻¹ᵁ ι ⁻¹ᵁ U).ι, (p ⁻¹ᵁ U).ι, (ι ⁻¹ᵁ U).ι,
      (q ⁻¹ᵁ ι ⁻¹ᵁ U).toSpecΓ ≫ Spec.map (CommRingCat.ofHom (ρ U hU)) ≫ hV.isoSpec.inv,
      q ∣_ (ι ⁻¹ᵁ U), p ∣_ U, ι ∣_ U,
      (isPullback_morphismRestrict p U).flip, (isPullback_morphismRestrict ι U).flip,
      (isPullback_morphismRestrict q (ι ⁻¹ᵁ U)).flip, ?_, ?_⟩
    · rw [Category.assoc, Category.assoc, IsAffineOpen.isoSpec_inv_ι]
      exact (hj U hU).symm
    · exact s3 U hU hV hZ' hW (CommRingCat.ofHom (ρ U hU))
        (s2 _ _ _ _ (p.app U) (ι.app U) (CommRingCat.ofHom (ρ U hU)) (q.app (ι ⁻¹ᵁ U))
          hcomm (s1 U hU) (hS U hU) (hK U hU))

theorem wc_cn_finite_algebraization : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [IsAdicComplete (IsLocalRing.maximalIdeal B) B] (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B)) [IsProper h] (W : ℕ → Scheme.{u}) (q : ∀ n, W n ⟶ Limits.pullback h (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ (n + 1)))))) (τ : ∀ n, Limits.pullback h (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ (n + 1))))) ⟶ Limits.pullback h (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ (n + 1 + 1)))))) (t : ∀ n, W n ⟶ W (n + 1)), (∀ n, τ n ≫ Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ (n + 1 + 1))))) = Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ (n + 1)))))) → (∀ n, IsFinite (q n)) → (∀ n, IsPullback (t n) (q n) (q (n + 1)) (τ n)) → ∃ (V : Scheme.{u}) (p : V ⟶ Z) (j : ∀ n, W n ⟶ V), IsFinite p ∧ ∀ n, IsPullback (j n) (q n) p (Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ (n + 1)))))) :=
by
  intro B _ _ _ _ Z h _ W q τ t hτ hqf hW

  obtain ⟨ψ, hsys, hring⟩ := wc_cn_tower_pushforward_system B Z h W q τ t hτ hqf hW

  obtain ⟨M, φ, hM⟩ := wc_cn_existence_chow_reduction wc_cn_existence_projective
    wc_cn_coherent_formal_functions B Z h (fun n => wcCnPush (q n ≫ wcCnThickι h n)) ψ hsys

  obtain ⟨V, p, ρ, hp, hρ⟩ := wc_cn_algebra_lift_relative_spec wc_cn_coherent_formal_functions
    B Z h W (fun n => q n ≫ wcCnThickι h n) ψ hsys hring M φ hM
  haveI := hp

  have key : ∀ n, ∃ j : W n ⟶ V, IsPullback j (q n) p (wcCnThickι h n) := by
    intro n
    haveI : IsClosedImmersion (Spec.map (CommRingCat.ofHom
        (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ (n + 1))))) :=
      IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
    haveI : IsClosedImmersion (wcCnThickι h n) :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion)
        (IsPullback.of_hasPullback h (Spec.map (CommRingCat.ofHom
          (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ (n + 1)))))).flip inferInstance
    haveI := hqf n
    obtain ⟨hnat, hcomp, hsurj, hker⟩ := hρ n
    refine wc_cn_pullback_of_affine_quotients Z V (W n) (wcCnThick h n) p (wcCnThickι h n) (q n)
      (ρ n) hnat hcomp hsurj ?_
    intro U hU
    rw [hker U hU]
    congr 1
    ext x
    rw [RingHom.mem_ker]
    exact ((wc_pullback_quot_affine_sections B Z h _ U hU).2 x).symm
  choose j hj using key
  exact ⟨V, p, j, hp, hj⟩

theorem wc_cn_free_of_flat_mod_powers : ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (I : Ideal R), I ≤ IsLocalRing.maximalIdeal R → ∀ (M : Type u) [AddCommGroup M] [Module R M] [Module.Finite R M], (∀ n : ℕ, Module.Flat (R ⧸ I ^ (n + 1)) (TensorProduct R (R ⧸ I ^ (n + 1)) M)) → Module.Free R M :=
by
  intro R _ _ _ I hI M _ _ _ hflat

  have s1 : ∀ (S : Type u) [CommRing S] [IsLocalRing S] (P : Type u) [AddCommGroup P] [Module S P]
      [Module.Projective S P] (r : ℕ) (ψ : (Fin r → S) →ₗ[S] P), Function.Surjective ψ →
      (∀ c : Fin r → S, ψ c = 0 → ∀ i, c i ∈ IsLocalRing.maximalIdeal S) → Function.Injective ψ := by
    intro S _ _ P _ _ _ r ψ hs hk
    obtain ⟨σ, hσ⟩ := Module.projective_lifting_property ψ LinearMap.id hs
    have hσ' : ∀ p, ψ (σ p) = p := fun p => LinearMap.congr_fun hσ p
    let π : (Fin r → S) →ₗ[S] (Fin r → S) := LinearMap.id - σ ∘ₗ ψ
    have hπapp : ∀ x, π x = x - σ (ψ x) := fun x => rfl
    have hψπ : ∀ x, ψ (π x) = 0 := by
      intro x; rw [hπapp, map_sub, hσ', sub_self]
    have hπ : ∀ c, ψ c = 0 → π c = c := by
      intro c hc; rw [hπapp, hc, map_zero, sub_zero]
    have hK : LinearMap.ker ψ = LinearMap.range π := by
      ext c; constructor
      · intro hc; exact ⟨c, hπ c hc⟩
      · rintro ⟨x, rfl⟩; exact hψπ x
    have hFG : (LinearMap.ker ψ).FG := by
      rw [hK, LinearMap.range_eq_map]; exact (Module.Finite.fg_top).map π
    have hle : LinearMap.ker ψ ≤ IsLocalRing.maximalIdeal S • LinearMap.ker ψ := by
      intro c hc
      have hc' : ψ c = 0 := hc
      have h1 : c = ∑ i, c i • (Pi.single i (1:S) : Fin r → S) := by
        ext j; simp [Finset.sum_apply, Pi.single_apply]
      have e : c = ∑ i, c i • π (Pi.single i 1) := by
        calc c = π c := (hπ c hc').symm
          _ = π (∑ i, c i • (Pi.single i (1:S) : Fin r → S)) := congrArg π h1
          _ = _ := by rw [map_sum]; simp only [map_smul]
      rw [e]
      exact Submodule.sum_mem _ (fun i _ =>
        Submodule.smul_mem_smul (hk c hc' i) (LinearMap.mem_ker.mpr (hψπ _)))
    have hjac : IsLocalRing.maximalIdeal S ≤ (⊥ : Ideal S).jacobson :=
      (IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top).ge
    exact LinearMap.ker_eq_bot.mp (Submodule.eq_bot_of_le_smul_of_le_jacobson_bot _ _ hFG hle hjac)

  obtain ⟨r, f, hspan, hmin⟩ : ∃ (r : ℕ) (f : Fin r → M), Submodule.span R (Set.range f) = ⊤ ∧
      ∀ c : Fin r → R, ∑ i, c i • f i ∈ (IsLocalRing.maximalIdeal R) • (⊤ : Submodule R M) →
        ∀ i, c i ∈ IsLocalRing.maximalIdeal R := by
    have : Module.Finite (IsLocalRing.ResidueField R)
        (TensorProduct R (IsLocalRing.ResidueField R) M) := Module.Finite.base_change R _ M
    let b := Module.finBasis (IsLocalRing.ResidueField R)
      (TensorProduct R (IsLocalRing.ResidueField R) M)
    have hsurj : ∀ v : TensorProduct R (IsLocalRing.ResidueField R) M, ∃ x : M,
        (1 : IsLocalRing.ResidueField R) ⊗ₜ[R] x = v := by
      intro v
      obtain ⟨x, hx⟩ := TensorProduct.mk_surjective R M (IsLocalRing.ResidueField R)
        (by rw [IsLocalRing.ResidueField.algebraMap_eq]; exact IsLocalRing.residue_surjective) v
      exact ⟨x, hx⟩
    choose g hg using hsurj
    refine ⟨_, fun i => g (b i),
      IsLocalRing.span_eq_top_of_tmul_eq_basis _ b (fun i => hg (b i)), ?_⟩
    intro c hc
    have h0 : ∀ y ∈ (IsLocalRing.maximalIdeal R) • (⊤ : Submodule R M),
        (1 : IsLocalRing.ResidueField R) ⊗ₜ[R] y = 0 := by
      intro y hy
      refine Submodule.smul_induction_on hy (fun a ha y _ => ?_) (fun x y hx hy => ?_)
      · rw [TensorProduct.tmul_smul, ← algebraMap_smul (IsLocalRing.ResidueField R),
          IsLocalRing.ResidueField.algebraMap_eq, (IsLocalRing.residue_eq_zero_iff a).mpr ha,
          zero_smul]
      · rw [TensorProduct.tmul_add, hx, hy, add_zero]
    have h1 : (1 : IsLocalRing.ResidueField R) ⊗ₜ[R] (∑ i, c i • g (b i)) =
        ∑ i, IsLocalRing.residue R (c i) • b i := by
      rw [TensorProduct.tmul_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [TensorProduct.tmul_smul, hg, ← IsLocalRing.ResidueField.algebraMap_eq, algebraMap_smul]
    have h2 := h0 _ hc
    rw [h1] at h2
    intro i
    exact (IsLocalRing.residue_eq_zero_iff _).mp
      (Fintype.linearIndependent_iff.mp b.linearIndependent _ h2 i)

  have hlevel : ∀ n : ℕ, ∀ c : Fin r → R, ∑ i, c i • f i = 0 → ∀ i, c i ∈ I ^ (n + 1) := by
    intro n c hc
    have hJm : I ^ (n + 1) ≤ IsLocalRing.maximalIdeal R :=
      (Ideal.pow_le_self n.succ_ne_zero).trans hI
    have hJt : I ^ (n + 1) ≠ ⊤ := fun h =>
      (IsLocalRing.maximalIdeal.isMaximal R).ne_top (top_le_iff.mp (h ▸ hJm))
    have : Nontrivial (R ⧸ I ^ (n + 1)) := Ideal.Quotient.nontrivial_iff.mpr hJt
    have : IsLocalRing (R ⧸ I ^ (n + 1)) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
    have : Module.Finite (R ⧸ I ^ (n + 1)) (TensorProduct R (R ⧸ I ^ (n + 1)) M) :=
      Module.Finite.base_change R _ M
    have : Module.Flat (R ⧸ I ^ (n + 1)) (TensorProduct R (R ⧸ I ^ (n + 1)) M) := hflat n
    have : Module.Free (R ⧸ I ^ (n + 1)) (TensorProduct R (R ⧸ I ^ (n + 1)) M) :=
      Module.free_of_flat_of_isLocalRing
    have : Module.Projective (R ⧸ I ^ (n + 1)) (TensorProduct R (R ⧸ I ^ (n + 1)) M) :=
      Module.Projective.of_free
    let ψ := Fintype.linearCombination (R ⧸ I ^ (n + 1))
      (fun i => (1 : R ⧸ I ^ (n + 1)) ⊗ₜ[R] f i)
    have star : ∀ (a : Fin r → R), ψ (fun i => Ideal.Quotient.mk (I ^ (n + 1)) (a i)) =
        (1 : R ⧸ I ^ (n + 1)) ⊗ₜ[R] (∑ i, a i • f i) := by
      intro a
      rw [Fintype.linearCombination_apply, TensorProduct.tmul_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [TensorProduct.tmul_smul, ← Ideal.Quotient.algebraMap_eq, algebraMap_smul]
    have hT : ∀ x : M, (1 : R ⧸ I ^ (n + 1)) ⊗ₜ[R] x = 0 →
        x ∈ (I ^ (n + 1)) • (⊤ : Submodule R M) := by
      intro x hx
      have h := TensorProduct.quotTensorEquivQuotSMul_symm_mk (I ^ (n + 1)) x
      rw [hx, LinearEquiv.map_eq_zero_iff] at h
      exact (Submodule.Quotient.mk_eq_zero _).mp h
    have hψs : Function.Surjective ψ := by
      intro p
      obtain ⟨x, rfl⟩ := TensorProduct.mk_surjective R M (R ⧸ I ^ (n + 1))
        (by rw [Ideal.Quotient.algebraMap_eq]; exact Ideal.Quotient.mk_surjective) p
      have hx : x ∈ LinearMap.range (Fintype.linearCombination R f) := by
        rw [Fintype.range_linearCombination, hspan]; exact Submodule.mem_top
      obtain ⟨a, rfl⟩ := hx
      exact ⟨_, (star a).trans (by rw [Fintype.linearCombination_apply]; rfl)⟩
    have hψk : ∀ d : Fin r → R ⧸ I ^ (n + 1), ψ d = 0 →
        ∀ i, d i ∈ IsLocalRing.maximalIdeal (R ⧸ I ^ (n + 1)) := by
      intro d hd i
      choose e he using fun i => Ideal.Quotient.mk_surjective (d i)
      have hd' : ψ (fun i => Ideal.Quotient.mk (I ^ (n + 1)) (e i)) = 0 := by
        rw [show (fun i => Ideal.Quotient.mk (I ^ (n + 1)) (e i)) = d from funext he]; exact hd
      rw [star] at hd'
      have hm := hmin e (Submodule.smul_mono_left hJm (hT _ hd')) i
      rw [← he i]
      refine (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr fun hu => ?_)
      obtain ⟨v, hv⟩ := hu.exists_right_inv
      obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective v
      have h1 : e i * w - 1 ∈ I ^ (n + 1) := by
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, hv, map_one, sub_self]
      have h2 : (1 : R) ∈ IsLocalRing.maximalIdeal R := by
        have := Ideal.sub_mem _ (Ideal.mul_mem_right w _ hm) (hJm h1)
        rwa [sub_sub_cancel] at this
      exact (Ideal.ne_top_iff_one _).mp (IsLocalRing.maximalIdeal.isMaximal R).ne_top h2
    have hinj := s1 (R ⧸ I ^ (n + 1)) _ r ψ hψs hψk
    have h0 : ψ (fun i => Ideal.Quotient.mk (I ^ (n + 1)) (c i)) = ψ 0 := by
      rw [star, hc, TensorProduct.tmul_zero, map_zero]
    intro i
    exact Ideal.Quotient.eq_zero_iff_mem.mp (congrFun (hinj h0) i)

  have hinj : Function.Injective (Fintype.linearCombination R f) := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro c hc
    rw [Fintype.linearCombination_apply] at hc
    funext i
    have hmem : c i ∈ ⨅ k : ℕ, I ^ k := by
      rw [Ideal.mem_iInf]
      intro k
      cases k with
      | zero => simp
      | succ n => exact hlevel n c hc i
    rw [Ideal.iInf_pow_eq_bot_of_isLocalRing I
      (ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal R).ne_top hI)] at hmem
    exact (Submodule.mem_bot R).mp hmem
  have hsurj : Function.Surjective (Fintype.linearCombination R f) := by
    rw [← LinearMap.range_eq_top, Fintype.range_linearCombination, hspan]
  exact Module.Free.of_equiv (LinearEquiv.ofBijective _ ⟨hinj, hsurj⟩)

theorem wc_cn_etale_near_of_etale_mod_powers : (∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (I : Ideal R), I ≤ IsLocalRing.maximalIdeal R → ∀ (M : Type u) [AddCommGroup M] [Module R M] [Module.Finite R M], (∀ n : ℕ, Module.Flat (R ⧸ I ^ (n + 1)) (TensorProduct R (R ⧸ I ^ (n + 1)) M)) → Module.Free R M) → ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (I : Ideal R) (S : Type u) [CommRing S] [Algebra R S] [Module.Finite R S] (P : Ideal R) [P.IsPrime], I ≤ P → (∀ n : ℕ, Algebra.Etale (R ⧸ I ^ (n + 1)) (TensorProduct R (R ⧸ I ^ (n + 1)) S)) → ∃ r : R, r ∉ P ∧ (Localization.awayMap (algebraMap R S) r).Etale :=
by

  have c1 : ∀ (R : Type u) [CommRing R] (I : Ideal R) (P : Ideal R) [P.IsPrime] (S : Type u)
      [AddCommGroup S] [Module R S] (n : ℕ),
      Module.Flat (R ⧸ I ^ (n + 1)) (TensorProduct R (R ⧸ I ^ (n + 1)) S) →
      Module.Flat (Localization.AtPrime P ⧸ (I.map (algebraMap R (Localization.AtPrime P))) ^ (n + 1))
        (TensorProduct (Localization.AtPrime P)
          (Localization.AtPrime P ⧸ (I.map (algebraMap R (Localization.AtPrime P))) ^ (n + 1))
          (LocalizedModule P.primeCompl S)) := by
    intro R _ I P _ S _ _ n hfl
    set R' := Localization.AtPrime P
    set A := R ⧸ I ^ (n + 1)
    set A' := R' ⧸ (I.map (algebraMap R R')) ^ (n + 1)
    have hle : I ^ (n + 1) ≤ (I.map (algebraMap R R') ^ (n + 1)).comap (algebraMap R R') := by
      rw [← Ideal.map_pow]; exact Ideal.le_comap_map
    letI : Algebra A A' := Ideal.Quotient.algebraQuotientOfLEComap hle
    haveI : IsScalarTower R A A' := IsScalarTower.of_algebraMap_eq (fun x => rfl)
    haveI : Module.Flat A' (TensorProduct A A' (TensorProduct R A S)) :=
      Module.Flat.baseChange A A' _
    let e1 := (IsLocalizedModule.isBaseChange P.primeCompl R'
      (LocalizedModule.mkLinearMap P.primeCompl S)).equiv
    let e1' : TensorProduct R' A' (LocalizedModule P.primeCompl S) ≃ₗ[A']
        TensorProduct R' A' (TensorProduct R R' S) :=
      TensorProduct.AlgebraTensorModule.congr (LinearEquiv.refl A' A') e1.symm
    let e2 : TensorProduct R' A' (TensorProduct R R' S) ≃ₗ[A'] TensorProduct R A' S :=
      TensorProduct.AlgebraTensorModule.cancelBaseChange R R' A' A' S
    let e3 : TensorProduct A A' (TensorProduct R A S) ≃ₗ[A'] TensorProduct R A' S :=
      TensorProduct.AlgebraTensorModule.cancelBaseChange R A A' A' S
    exact Module.Flat.of_linearEquiv (e1'.trans (e2.trans e3.symm))

  have c2 : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (S : Type u) [AddCommGroup S]
      [Module R S] [Module.Finite R S] (P : Ideal R) [P.IsPrime],
      Module.Free (Localization.AtPrime P) (LocalizedModule P.primeCompl S) →
      ∃ r₁ : R, r₁ ∉ P ∧ ∀ s : R,
        Module.Projective (Localization.Away (r₁ * s)) (LocalizedModule.Away (r₁ * s) S) := by
    intro R _ _ S _ _ _ P _ h
    haveI : Module.FinitePresentation R S := Module.finitePresentation_of_finite R S
    have hopen := Module.isOpen_freeLocus (R := R) (M := S)
    have hp : (⟨P, inferInstance⟩ : PrimeSpectrum R) ∈ Module.freeLocus R S :=
      Module.mem_freeLocus.mpr h
    obtain ⟨v, ⟨r₁, rfl⟩, hpv, hv⟩ :=
      PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hp hopen
    refine ⟨r₁, hpv, fun s => ?_⟩
    apply Module.basicOpen_subset_freeLocus_iff.mp
    exact fun x hx => hv (PrimeSpectrum.basicOpen_mul_le_left r₁ s hx)

  have c3 : ∀ (R : Type u) [CommRing R] (J : Ideal R) (S : Type u) [CommRing S] [Algebra R S]
      [Module.Finite R S], Algebra.FormallyUnramified (R ⧸ J) (TensorProduct R (R ⧸ J) S) →
      ∃ a : R, a - 1 ∈ J ∧ ∀ ω : KaehlerDifferential R S, a • ω = 0 := by
    intro R _ J S _ _ _ hU
    haveI : Module.Finite R (KaehlerDifferential R S) := Module.Finite.trans S _
    letI : Algebra S (TensorProduct R (R ⧸ J) S) := Algebra.TensorProduct.rightAlgebra
    have hbc := KaehlerDifferential.isBaseChange R (R ⧸ J) S (TensorProduct R (R ⧸ J) S)
    haveI : Subsingleton (KaehlerDifferential (R ⧸ J) (TensorProduct R (R ⧸ J) S)) :=
      Algebra.FormallyUnramified.subsingleton_kaehlerDifferential
    haveI : Subsingleton (TensorProduct R (R ⧸ J) (KaehlerDifferential R S)) :=
      hbc.equiv.toEquiv.subsingleton
    haveI : Subsingleton (KaehlerDifferential R S ⧸ J • (⊤ : Submodule R (KaehlerDifferential R S))) :=
      (TensorProduct.quotTensorEquivQuotSMul (KaehlerDifferential R S) J).symm.toEquiv.subsingleton
    have hle : (⊤ : Submodule R (KaehlerDifferential R S)) ≤ J • ⊤ := by
      intro ω _
      rw [← Submodule.Quotient.mk_eq_zero]
      exact Subsingleton.elim _ _
    obtain ⟨a, ha, h⟩ :=
      Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul J ⊤ (Module.Finite.fg_top) hle
    exact ⟨a, ha, fun ω => h ω trivial⟩

  have c4 : ∀ (R : Type u) [CommRing R] (S : Type u) [CommRing S] [Algebra R S] (r : R),
      Module.Projective (Localization.Away r) (LocalizedModule.Away r S) →
      (Localization.awayMap (algebraMap R S) r).Flat := by
    intro R _ S _ _ r hP
    letI : Algebra (Localization.Away r) (Localization.Away (algebraMap R S r)) :=
      (Localization.awayMap (algebraMap R S) r).toAlgebra
    haveI : IsScalarTower R (Localization.Away r) (Localization.Away (algebraMap R S r)) := by
      apply IsScalarTower.of_algebraMap_eq'
      rw [IsScalarTower.algebraMap_eq R S (Localization.Away (algebraMap R S r)),
        RingHom.algebraMap_toAlgebra]
      exact (IsLocalization.map_comp _).symm
    haveI : IsLocalization (Algebra.algebraMapSubmonoid S (Submonoid.powers r))
        (Localization.Away (algebraMap R S r)) := by
      have : Algebra.algebraMapSubmonoid S (Submonoid.powers r) =
          Submonoid.powers (algebraMap R S r) := Submonoid.map_powers _ _
      rw [this]; infer_instance
    haveI : IsLocalizedModule (Submonoid.powers r)
        (IsScalarTower.toAlgHom R S (Localization.Away (algebraMap R S r))).toLinearMap :=
      (isLocalizedModule_iff_isLocalization).mpr inferInstance
    let e₀ := IsLocalizedModule.iso (Submonoid.powers r)
      (IsScalarTower.toAlgHom R S (Localization.Away (algebraMap R S r))).toLinearMap
    let e := LinearEquiv.extendScalarsOfIsLocalization (Submonoid.powers r)
      (Localization.Away r) e₀
    haveI := Module.Projective.of_equiv e
    exact Module.Flat.of_projective

  have c5 : ∀ (R : Type u) [CommRing R] (S : Type u) [CommRing S] [Algebra R S] (r : R),
      (∀ ω : KaehlerDifferential R S, r • ω = 0) →
      (Localization.awayMap (algebraMap R S) r).FormallyUnramified := by
    intro R _ S _ _ r hr
    letI : Algebra (Localization.Away r) (Localization.Away (algebraMap R S r)) :=
      (Localization.awayMap (algebraMap R S) r).toAlgebra
    haveI : IsScalarTower R (Localization.Away r) (Localization.Away (algebraMap R S r)) := by
      apply IsScalarTower.of_algebraMap_eq'
      rw [IsScalarTower.algebraMap_eq R S (Localization.Away (algebraMap R S r)),
        RingHom.algebraMap_toAlgebra]
      exact (IsLocalization.map_comp _).symm
    haveI : IsLocalization (Algebra.algebraMapSubmonoid S (Submonoid.powers r))
        (Localization.Away (algebraMap R S r)) := by
      have : Algebra.algebraMapSubmonoid S (Submonoid.powers r) =
          Submonoid.powers (algebraMap R S r) := Submonoid.map_powers _ _
      rw [this]; infer_instance
    haveI hloc := KaehlerDifferential.isLocalizedModule R (Localization.Away r) S
      (Localization.Away (algebraMap R S r)) (Submonoid.powers r)
    have hall : ∀ y : KaehlerDifferential (Localization.Away r) (Localization.Away (algebraMap R S r)),
        y = 0 := by
      intro y
      obtain ⟨⟨ω, s⟩, hs⟩ := IsLocalizedModule.surj (Submonoid.powers r)
        ((KaehlerDifferential.map R (Localization.Away r) S
          (Localization.Away (algebraMap R S r))).restrictScalars R) y
      have h0 : (KaehlerDifferential.map R (Localization.Away r) S
          (Localization.Away (algebraMap R S r))).restrictScalars R ω = 0 :=
        (IsLocalizedModule.eq_zero_iff (Submonoid.powers r) _).mpr
          ⟨⟨r, Submonoid.mem_powers r⟩, hr ω⟩
      simp only at hs
      rw [h0, ← smul_zero s] at hs
      exact IsLocalizedModule.smul_injective
        ((KaehlerDifferential.map R (Localization.Away r) S
          (Localization.Away (algebraMap R S r))).restrictScalars R) s hs
    show Algebra.FormallyUnramified _ _
    exact ⟨⟨fun y z => (hall y).trans (hall z).symm⟩⟩

  have c6 : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (S : Type u) [CommRing S]
      [Algebra R S] [Module.Finite R S] (r : R),
      (Localization.awayMap (algebraMap R S) r).FinitePresentation := by
    intro R _ _ S _ _ _ r
    have h1 : (algebraMap R (Localization.Away r)).FinitePresentation :=
      RingHom.finitePresentation_algebraMap.mpr (IsLocalization.Away.finitePresentation r)
    have h2 : (algebraMap R S).FinitePresentation :=
      RingHom.FinitePresentation.of_finiteType.mp
        (RingHom.finite_algebraMap.mpr inferInstance).to_finiteType
    have h3 : (algebraMap S (Localization.Away (algebraMap R S r))).FinitePresentation :=
      RingHom.finitePresentation_algebraMap.mpr
        (IsLocalization.Away.finitePresentation (algebraMap R S r))
    have hc : (Localization.awayMap (algebraMap R S) r).comp (algebraMap R (Localization.Away r)) =
        (algebraMap S _).comp (algebraMap R S) := IsLocalization.map_comp _
    refine RingHom.FinitePresentation.of_comp_finiteType (algebraMap R (Localization.Away r))
      (g := Localization.awayMap (algebraMap R S) r) ?_
      (RingHom.FiniteType.of_finitePresentation h1)
    rw [hc]
    exact h3.comp h2

  intro LF R _ _ I S _ _ _ P _ hIP hEt
  have hflat : ∀ n : ℕ, Module.Flat (R ⧸ I ^ (n + 1)) (TensorProduct R (R ⧸ I ^ (n + 1)) S) :=
    fun n => by haveI := hEt n; infer_instance
  have hlocflat := fun n => c1 R I P S n (hflat n)
  have hIm : I.map (algebraMap R (Localization.AtPrime P)) ≤
      IsLocalRing.maximalIdeal (Localization.AtPrime P) := by
    rw [← Localization.AtPrime.map_eq_maximalIdeal]
    exact Ideal.map_mono hIP
  have hfree : Module.Free (Localization.AtPrime P) (LocalizedModule P.primeCompl S) :=
    LF (Localization.AtPrime P) _ hIm (LocalizedModule P.primeCompl S) hlocflat
  obtain ⟨r₁, hr₁, hproj⟩ := c2 R S P hfree
  obtain ⟨a, ha, hkill⟩ := c3 R (I ^ (0 + 1)) S (by haveI := hEt 0; infer_instance)
  have haP : a ∉ P := by
    intro haP
    have h1 : a - 1 ∈ P := hIP (Ideal.pow_le_self (by norm_num) ha)
    have h2 : a - (a - 1) ∈ P := P.sub_mem haP h1
    rw [sub_sub_cancel] at h2
    exact (Ideal.IsPrime.ne_top inferInstance) ((Ideal.eq_top_iff_one P).mpr h2)
  have hr : r₁ * a ∉ P := fun h => (Ideal.IsPrime.mem_or_mem inferInstance h).elim hr₁ haP
  refine ⟨r₁ * a, hr, RingHom.Etale.iff_flat_and_formallyUnramified.mpr
    ⟨c4 R S _ (hproj a), c5 R S _ (fun ω => by rw [mul_smul, hkill, smul_zero]), c6 R S _⟩⟩

theorem wc_cn_etale_nbhd_of_thickenings : (∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (I : Ideal R) (S : Type u) [CommRing S] [Algebra R S] [Module.Finite R S] (P : Ideal R) [P.IsPrime], I ≤ P → (∀ n : ℕ, Algebra.Etale (R ⧸ I ^ (n + 1)) (TensorProduct R (R ⧸ I ^ (n + 1)) S)) → ∃ r : R, r ∉ P ∧ (Localization.awayMap (algebraMap R S) r).Etale) → ∀ (B : Type u) [CommRing B] [IsNoetherianRing B] (I : Ideal B) (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B)) [LocallyOfFiniteType h] (V : Scheme.{u}) (p : V ⟶ Z), IsFinite p → (∀ n : ℕ, ∃ (W : Scheme.{u}) (q : W ⟶ Limits.pullback h (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I ^ (n + 1)))))) (j : W ⟶ V), Etale q ∧ IsPullback j q p (Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I ^ (n + 1))))))) → ∀ z : Z, I ≤ (h z).asIdeal → ∃ U : Z.Opens, z ∈ U ∧ Etale (p ∣_ U) :=
by

  have s1 : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B] (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B)) [LocallyOfFiniteType h] (z : Z), ∃ (R : Type u) (_ : CommRing R) (_ : Algebra B R) (_ : IsNoetherianRing R) (a : Spec (.of R) ⟶ Z) (x : Spec (.of R)), IsOpenImmersion a ∧ a x = z ∧ a ≫ h = Spec.map (CommRingCat.ofHom (algebraMap B R)) ∧ ∀ J : Ideal B, J ≤ (h z).asIdeal → J.map (algebraMap B R) ≤ x.asIdeal := by
    intro B _ _ Z h _ z
    obtain ⟨U, hU, hzU, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp Z.isBasis_affineOpens)
      (show z ∈ (⊤ : Z.Opens) from trivial)
    have hU' : IsAffineOpen U := hU
    have hz : z ∈ Set.range hU'.fromSpec := by rw [hU'.range_fromSpec]; exact hzU
    obtain ⟨x, hx⟩ := hz
    let φ₀ : CommRingCat.of B ⟶ Γ(Z, U) := Spec.preimage (hU'.fromSpec ≫ h)
    letI : Algebra B Γ(Z, U) := φ₀.hom.toAlgebra
    have hspec : hU'.fromSpec ≫ h = Spec.map (CommRingCat.ofHom (algebraMap B Γ(Z, U))) :=
      (Spec.map_preimage _).symm
    have hlft : LocallyOfFiniteType (Spec.map (CommRingCat.ofHom (algebraMap B Γ(Z, U)))) := by
      rw [← hspec]; infer_instance
    have hft : (algebraMap B Γ(Z, U)).FiniteType :=
      (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp hlft
    haveI : Algebra.FiniteType B Γ(Z, U) := hft
    haveI : IsNoetherianRing Γ(Z, U) := Algebra.FiniteType.isNoetherianRing B _
    refine ⟨Γ(Z, U), inferInstance, inferInstance, inferInstance, hU'.fromSpec, x, inferInstance,
      hx, hspec, ?_⟩
    intro J hJ
    rw [Ideal.map_le_iff_le_comap]
    rw [← hx, ← Scheme.Hom.comp_apply, hspec] at hJ
    exact hJ

  have s2 : ∀ (R : Type u) [CommRing R] (Z V : Scheme.{u}) (p : V ⟶ Z) (a : Spec (.of R) ⟶ Z), IsFinite p → ∃ (S : Type u) (_ : CommRing S) (_ : Algebra R S) (b : Spec (.of S) ⟶ V), Module.Finite R S ∧ IsPullback b (Spec.map (CommRingCat.ofHom (algebraMap R S))) p a := by
    intro R _ Z V p a hp
    haveI hsnd : IsFinite (Limits.pullback.snd p a) :=
      MorphismProperty.of_isPullback (P := @IsFinite) (IsPullback.of_hasPullback p a) hp
    haveI : IsAffine (Limits.pullback p a) := isAffine_of_isAffineHom (Limits.pullback.snd p a)
    let ψ₀ : CommRingCat.of R ⟶ Γ(Limits.pullback p a, ⊤) :=
      Spec.preimage ((Limits.pullback p a).isoSpec.inv ≫ Limits.pullback.snd p a)
    letI : Algebra R Γ(Limits.pullback p a, ⊤) := ψ₀.hom.toAlgebra
    have hψ : Spec.map (CommRingCat.ofHom (algebraMap R Γ(Limits.pullback p a, ⊤))) =
        (Limits.pullback p a).isoSpec.inv ≫ Limits.pullback.snd p a := Spec.map_preimage _
    have hfin : IsFinite (Spec.map (CommRingCat.ofHom
        (algebraMap R Γ(Limits.pullback p a, ⊤)))) := by
      rw [hψ]; infer_instance
    rw [IsFinite.SpecMap_iff] at hfin
    refine ⟨Γ(Limits.pullback p a, ⊤), inferInstance, inferInstance,
      (Limits.pullback p a).isoSpec.inv ≫ Limits.pullback.fst p a, hfin, ?_⟩
    rw [hψ]
    exact IsPullback.of_iso (IsPullback.of_hasPullback p a) (Limits.pullback p a).isoSpec
      (Iso.refl _) (Iso.refl _) (Iso.refl _) (by simp) (by simp) (by simp) (by simp)

  have s3 : ∀ (B R S : Type u) [CommRing B] [CommRing R] [CommRing S] [Algebra B R] [Algebra R S] (K : Ideal B) (J : Ideal R), K.map (algebraMap B R) = J → ∀ (Z V : Scheme.{u}) (h : Z ⟶ Spec (.of B)) (p : V ⟶ Z) (a : Spec (.of R) ⟶ Z) (b : Spec (.of S) ⟶ V), a ≫ h = Spec.map (CommRingCat.ofHom (algebraMap B R)) → IsPullback b (Spec.map (CommRingCat.ofHom (algebraMap R S))) p a → ∀ (W : Scheme.{u}) (q : W ⟶ Limits.pullback h (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk K)))) (j : W ⟶ V), Etale q → IsPullback j q p (Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk K)))) → Algebra.Etale (R ⧸ J) (TensorProduct R (R ⧸ J) S) := by
    intro B R S _ _ _ _ _ K J hKJ Z V h p a b hah hb W q j hq hj
    have hle : K ≤ J.comap (algebraMap B R) := Ideal.map_le_iff_le_comap.mp hKJ.le
    let ρ : B ⧸ K →+* R ⧸ J := Ideal.quotientMap J (algebraMap B R) hle
    have hρ : ρ.comp (Ideal.Quotient.mk K) = (algebraMap R (R ⧸ J)).comp (algebraMap B R) := by
      ext y
      simp [ρ, Ideal.quotientMap_mk, Ideal.Quotient.algebraMap_eq]
    have hw : (Spec.map (CommRingCat.ofHom (algebraMap R (R ⧸ J))) ≫ a) ≫ h =
        Spec.map (CommRingCat.ofHom ρ) ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk K)) := by
      rw [Category.assoc, hah, ← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← CommRingCat.ofHom_comp, hρ]
    let c := Limits.pullback.lift _ _ hw
    have hc : c ≫ Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk K))) =
        Spec.map (CommRingCat.ofHom (algebraMap R (R ⧸ J))) ≫ a := Limits.pullback.lift_fst _ _ _
    have hT := (isPullback_SpecMap_of_isPushout _ _ _ _
      (CommRingCat.isPushout_tensorProduct R (R ⧸ J) S)).flip
    have hbig := hT.paste_horiz hb
    rw [← hc] at hbig
    let l := hj.lift _ _ (hbig.w.trans (Category.assoc _ _ _).symm)
    have t : IsPullback (l ≫ j) (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeLeftRingHom : R ⧸ J →+* TensorProduct R (R ⧸ J) S))) p
        (c ≫ Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk K)))) := by
      rw [IsPullback.lift_fst]; exact hbig
    have hsq := IsPullback.of_right t (IsPullback.lift_snd _ _ _ _) hj
    have het : Etale (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeLeftRingHom : R ⧸ J →+* TensorProduct R (R ⧸ J) S))) :=
      MorphismProperty.of_isPullback (P := @Etale) hsq hq
    have hE : RingHom.Etale
        (Algebra.TensorProduct.includeLeftRingHom : R ⧸ J →+* TensorProduct R (R ⧸ J) S) :=
      (HasRingHomProperty.Spec_iff (P := @Etale)).mp het
    rw [← RingHom.etale_algebraMap]
    convert hE using 1

  have s4 : ∀ (Z V : Scheme.{u}) (p : V ⟶ Z) (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] (a : Spec (.of R) ⟶ Z) [IsOpenImmersion a] (b : Spec (.of S) ⟶ V), IsPullback b (Spec.map (CommRingCat.ofHom (algebraMap R S))) p a → ∀ r : R, (Localization.awayMap (algebraMap R S) r).Etale → ∀ x : Spec (.of R), r ∉ x.asIdeal → ∃ U : Z.Opens, a x ∈ U ∧ Etale (p ∣_ U) := by
    intro Z V p R S _ _ _ a _ b hb r hr x hx
    let ι := Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away r)))
    refine ⟨(ι ≫ a).opensRange, ?_, ?_⟩
    · have hxr : x ∈ Set.range (PrimeSpectrum.comap (algebraMap R (Localization.Away r))) := by
        rw [PrimeSpectrum.localization_away_comap_range (Localization.Away r) r]
        exact hx
      obtain ⟨y, hy⟩ := hxr
      let y' : Spec (.of (Localization.Away r)) := y
      refine ⟨y', ?_⟩
      rw [Scheme.Hom.comp_apply]
      exact congrArg _ hy
    · have e := morphismRestrictOpensRange p (ι ≫ a)
      rw [Arrow.iso_w' e.symm]
      have hT := (isPullback_SpecMap_of_isPushout _ _ _ _
        (CommRingCat.isPushout_tensorProduct R (Localization.Away r) S)).flip
      have hbig := hT.paste_horiz hb
      have hsnd : Limits.pullback.snd p (ι ≫ a) = hbig.isoPullback.inv ≫
          Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
            Localization.Away r →+* TensorProduct R (Localization.Away r) S)) := by
        rw [eq_comm, Iso.inv_comp_eq]
        exact hbig.isoPullback_hom_snd.symm
      have hring : RingHom.Etale (Algebra.TensorProduct.includeLeftRingHom :
            Localization.Away r →+* TensorProduct R (Localization.Away r) S) := by
        letI : Algebra S (TensorProduct R (Localization.Away r) S) :=
          Algebra.TensorProduct.rightAlgebra
        haveI := IsLocalization.Away.tensorRight (S := S) r (Localization.Away r)
        have h1 := (RingHom.RespectsIso.isLocalization_away_iff RingHom.Etale.respectsIso
          (Localization.Away r) (TensorProduct R (Localization.Away r) S) (algebraMap R S) r).mp hr
        convert h1 using 1
        apply IsLocalization.ringHom_ext (Submonoid.powers r)
        rw [IsLocalization.Away.map, IsLocalization.map_comp]
        ext t
        simp [Algebra.TensorProduct.right_algebraMap_apply]
        rw [Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul]
      have hSp : Etale (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeLeftRingHom :
            Localization.Away r →+* TensorProduct R (Localization.Away r) S))) :=
        (HasRingHomProperty.Spec_iff (P := @Etale)).mpr hring
      haveI : Etale (Limits.pullback.snd p (ι ≫ a)) := by rw [hsnd]; infer_instance
      infer_instance

  intro LE B _ _ I Z h _ V p hp H z hz
  obtain ⟨R, _, _, _, a, x, ha, hax, hah, hid⟩ := s1 B Z h z
  haveI := ha
  obtain ⟨S, _, _, b, hfin, hb⟩ := s2 R Z V p a hp
  haveI := hfin
  have hn : ∀ n : ℕ, Algebra.Etale (R ⧸ (I.map (algebraMap B R)) ^ (n + 1))
      (TensorProduct R (R ⧸ (I.map (algebraMap B R)) ^ (n + 1)) S) := by
    intro n
    obtain ⟨W, q, j, hq, hj⟩ := H n
    exact s3 B R S (I ^ (n + 1)) _ (Ideal.map_pow _ I (n + 1)) Z V h p a b hah hb W q j hq hj
  haveI hxP : x.asIdeal.IsPrime := x.isPrime
  obtain ⟨r, hr, hEt⟩ := LE R (I.map (algebraMap B R)) S x.asIdeal (hid I hz) hn
  obtain ⟨U, hU, hUe⟩ := s4 Z V p R S a b hb r hEt x hr
  rw [hax] at hU
  exact ⟨U, hU, hUe⟩

theorem wc_fet_ext_complete_noetherian : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B]
    [IsAdicComplete (IsLocalRing.maximalIdeal B) B] (Z Z₀ : Scheme.{u}) (h : Z ⟶ Spec (.of B))
    [IsProper h] (i : Z₀ ⟶ Z) (h₀ : Z₀ ⟶ Spec (.of (IsLocalRing.ResidueField B))),
    IsPullback i h₀ h (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) →
    ∀ (V₀ : Scheme.{u}) (p₀ : V₀ ⟶ Z₀), IsFinite p₀ → Etale p₀ →
    ∃ (V : Scheme.{u}) (p : V ⟶ Z) (j : V₀ ⟶ V), IsFinite p ∧ Etale p ∧ IsPullback j p₀ p i :=
by
  intro B _ _ _ _ Z Z₀ h _ i h₀ hsq V₀ p₀ hf he

  have s1 : ∀ (J : Ideal B) (C : Type u) [CommRing C] (φ : B →+* C),
      Function.Surjective φ → J ≤ RingHom.ker φ → RingHom.ker φ ≤ J.radical →
      ∀ (T : Scheme.{u}) (a : T ⟶ Z) (b : T ⟶ Spec (.of C)),
      IsPullback a b h (Spec.map (CommRingCat.ofHom φ)) →
      ∃ k : T ⟶ Limits.pullback h (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))),
        k ≫ Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))) = a ∧
        IsClosedImmersion k ∧ Function.Surjective k := by
    intro J C _ φ hφ hJ hrad T a b hab
    let ψ : B ⧸ J →+* C := Ideal.Quotient.lift J φ (fun x hx => hJ hx)
    have hψφ : ψ.comp (Ideal.Quotient.mk J) = φ := Ideal.Quotient.lift_comp_mk _ _ _
    have hfac : Spec.map (CommRingCat.ofHom φ) = Spec.map (CommRingCat.ofHom ψ) ≫
        Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)) := by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hψφ]
    have hψs : Function.Surjective ψ := by
      intro c
      obtain ⟨x, rfl⟩ := hφ c
      exact ⟨Ideal.Quotient.mk J x, rfl⟩
    have hw : a ≫ h = (b ≫ Spec.map (CommRingCat.ofHom ψ)) ≫
        Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)) := by
      rw [Category.assoc, ← hfac]; exact hab.w
    refine ⟨Limits.pullback.lift a _ hw, Limits.pullback.lift_fst _ _ _, ?_⟩
    have hbig : IsPullback (Limits.pullback.lift a _ hw ≫
        Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)))) b h
        (Spec.map (CommRingCat.ofHom ψ) ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))) := by
      rw [Limits.pullback.lift_fst, ← hfac]; exact hab
    have hleft : IsPullback (Limits.pullback.lift a _ hw) b
        (Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))))
        (Spec.map (CommRingCat.ofHom ψ)) :=
      IsPullback.of_right hbig (Limits.pullback.lift_snd _ _ _) (IsPullback.of_hasPullback _ _)
    haveI hψc : IsClosedImmersion (Spec.map (CommRingCat.ofHom ψ)) :=
      IsClosedImmersion.spec_of_surjective _ hψs
    have hker : ∀ P : Ideal (B ⧸ J), P.IsPrime → RingHom.ker ψ ≤ P := by
      intro P hP x hx
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
      have hy : y ∈ RingHom.ker φ := by
        rw [RingHom.mem_ker] at hx ⊢
        exact hx
      obtain ⟨n, hn⟩ := hrad hy
      apply hP.mem_of_pow_mem n
      rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem.mpr hn]
      exact P.zero_mem
    haveI hψsurj : Surjective (Spec.map (CommRingCat.ofHom ψ)) := by
      constructor
      intro P
      haveI hP2 : P.asIdeal.IsPrime := P.2
      haveI : (P.asIdeal.map ψ).IsPrime := Ideal.map_isPrime_of_surjective hψs (hker _ P.2)
      refine ⟨⟨P.asIdeal.map ψ, this⟩, ?_⟩
      show PrimeSpectrum.comap ψ ⟨P.asIdeal.map ψ, this⟩ = P
      ext1
      rw [PrimeSpectrum.comap_asIdeal]
      change Ideal.comap ψ (Ideal.map ψ P.asIdeal) = P.asIdeal
      rw [Ideal.comap_map_of_surjective' ψ hψs, sup_eq_left]
      exact hker _ P.2
    refine ⟨MorphismProperty.of_isPullback (P := @IsClosedImmersion) hleft.flip hψc, ?_⟩
    exact (MorphismProperty.of_isPullback (P := @Surjective) hleft.flip hψsurj).surj

  have s3 : ∀ (T₀ : Scheme.{u}) (T : ℕ → Scheme.{u}) (k : T₀ ⟶ T 0) (τ : ∀ n, T n ⟶ T (n + 1)),
      IsClosedImmersion k → Function.Surjective k → (∀ n, IsClosedImmersion (τ n)) →
      (∀ n, Function.Surjective (τ n)) →
      ∀ (V₀ : Scheme.{u}) (p₀ : V₀ ⟶ T₀), IsFinite p₀ → Etale p₀ →
      ∃ (W : ℕ → Scheme.{u}) (q : ∀ n, W n ⟶ T n) (t : ∀ n, W n ⟶ W (n + 1)) (jV : V₀ ⟶ W 0),
        (∀ n, IsFinite (q n)) ∧ (∀ n, Etale (q n)) ∧ IsPullback jV p₀ (q 0) k ∧
        ∀ n, IsPullback (t n) (q n) (q (n + 1)) (τ n) := by
    intro T₀ T k τ hk hks hτ hτs V₀ p₀ hf he
    let Cov : ℕ → Type (u + 1) := fun n => Σ W : Scheme.{u}, {q : W ⟶ T n // IsFinite q ∧ Etale q}
    have E : ∀ n (c : Cov n), ∃ (V : Scheme.{u}) (p : V ⟶ T (n + 1)) (j : c.1 ⟶ V),
        IsFinite p ∧ Etale p ∧ IsPullback j c.2.1 p (τ n) := fun n c =>
      @wc_fet_ext_surj_closed_immersion (T n) (T (n + 1)) (τ n) (hτ n) (hτs n) c.1 c.2.1
        c.2.2.1 c.2.2.2
    choose stepW stepq stepj hstepf hstepe hstepPB using E
    obtain ⟨V, p, j, hpf, hpe, hpb⟩ :=
      @wc_fet_ext_surj_closed_immersion T₀ (T 0) k hk hks V₀ p₀ hf he
    let step : ∀ n, Cov n → Cov (n + 1) := fun n c => ⟨stepW n c, stepq n c, hstepf n c, hstepe n c⟩
    let cov : ∀ n, Cov n := fun n => Nat.rec (motive := fun n => Cov n) ⟨V, p, hpf, hpe⟩ step n
    exact ⟨fun n => (cov n).1, fun n => (cov n).2.1, fun n => stepj n (cov n), j,
      fun n => (cov n).2.2.1, fun n => (cov n).2.2.2, hpb, fun n => hstepPB n (cov n)⟩

  have s8 : ∀ (V : Scheme.{u}) (p : V ⟶ Z),
      (∀ z : Z, h z = IsLocalRing.closedPoint B → ∃ U : Z.Opens, z ∈ U ∧ Etale (p ∣_ U)) →
      Etale p := by
    intro V p H
    haveI := HasRingHomProperty.instIsZariskiLocalAtTarget (@Etale : MorphismProperty Scheme.{u})
    let 𝒰 : {U : Z.Opens // Etale (p ∣_ U)} → Z.Opens := Subtype.val
    have hE : iSup 𝒰 = ⊤ := by
      by_contra hne
      have hF : ∃ z₁ : Z, z₁ ∉ iSup 𝒰 := by
        by_contra hall
        push_neg at hall
        exact hne (eq_top_iff.mpr (fun z _ => hall z))
      obtain ⟨z₁, hz₁⟩ := hF
      have hFc : IsClosed (((iSup 𝒰 : Z.Opens) : Set Z)ᶜ) := (iSup 𝒰).isOpen.isClosed_compl
      have hhF : IsClosed (h '' (((iSup 𝒰 : Z.Opens) : Set Z)ᶜ)) := Scheme.Hom.isClosedMap h _ hFc
      have hspec : h z₁ ⤳ IsLocalRing.closedPoint B :=
        (PrimeSpectrum.le_iff_specializes _ _).mp (IsLocalRing.le_maximalIdeal (h z₁).2.ne_top)
      obtain ⟨z, hzF, hz⟩ := hspec.mem_closed hhF ⟨z₁, hz₁, rfl⟩
      obtain ⟨U, hzU, hU⟩ := H z hz
      exact hzF ((le_iSup 𝒰 ⟨U, hU⟩) hzU)
    exact IsZariskiLocalAtTarget.of_iSup_eq_top (P := @Etale) 𝒰 hE (fun i => i.2)

  obtain ⟨k₀, hk₀, hk₀c, hk₀s⟩ := s1 (IsLocalRing.maximalIdeal B ^ (0 + 1))
    (IsLocalRing.ResidueField B) (IsLocalRing.residue B) IsLocalRing.residue_surjective
    (by rw [zero_add, pow_one, IsLocalRing.ker_residue])
    (by rw [IsLocalRing.ker_residue, zero_add, pow_one]; exact Ideal.le_radical) Z₀ i h₀ hsq

  have hτex : ∀ n : ℕ, ∃ τ : Limits.pullback h (Spec.map (CommRingCat.ofHom
        (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ (n + 1))))) ⟶
        Limits.pullback h (Spec.map (CommRingCat.ofHom
          (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ (n + 1 + 1))))),
      τ ≫ Limits.pullback.fst h (Spec.map (CommRingCat.ofHom
          (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ (n + 1 + 1))))) =
        Limits.pullback.fst h (Spec.map (CommRingCat.ofHom
          (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ (n + 1))))) ∧
      IsClosedImmersion τ ∧ Function.Surjective τ := by
    intro n
    refine s1 (IsLocalRing.maximalIdeal B ^ (n + 1 + 1)) (B ⧸ IsLocalRing.maximalIdeal B ^ (n + 1))
      (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective ?_ ?_ _ (Limits.pullback.fst _ _)
      (Limits.pullback.snd _ _) (IsPullback.of_hasPullback _ _)
    · rw [Ideal.mk_ker]; exact Ideal.pow_le_pow_right (by omega)
    · rw [Ideal.mk_ker]
      intro x hx
      exact ⟨n + 1 + 1, Ideal.pow_mem_pow (Ideal.pow_le_self (by omega) hx) _⟩
  choose τ hτ hτc hτs using hτex

  obtain ⟨W, q, t, jV, hqf, hqe, hV₀, hW⟩ := s3 Z₀
    (fun n => Limits.pullback h (Spec.map (CommRingCat.ofHom
      (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ (n + 1)))))) k₀ τ hk₀c hk₀s hτc hτs
    V₀ p₀ hf he

  obtain ⟨V, p, j, hpf, hj⟩ := wc_cn_finite_algebraization B Z h W q τ t hτ hqf hW

  have hpe : Etale p := s8 V p (fun z hz =>
    wc_cn_etale_nbhd_of_thickenings
      (wc_cn_etale_near_of_etale_mod_powers wc_cn_free_of_flat_mod_powers)
      B (IsLocalRing.maximalIdeal B) Z h V p hpf (fun n => ⟨W n, q n, j n, hqe n, hj n⟩) z
      (by rw [hz]; exact le_rfl))

  have hbig := hV₀.paste_horiz (hj 0)
  rw [hk₀] at hbig
  exact ⟨V, p, jV ≫ j 0, hpf, hpe, hbig⟩

theorem wc_fp_subalgebra_limit_presentation : ∀ (A B : Type u) [CommRing A] [IsNoetherianRing A] [CommRing B] (φ : A →+* B)
    (Z : Scheme.{u}) (h : Z ⟶ Spec (.of A)) [IsProper h],
    ∃ (D : (Finset B)ᵒᵖ ⥤ Scheme.{u})
      (ρ : (Functor.const (Finset B)ᵒᵖ).obj (Limits.pullback h (Spec.map (CommRingCat.ofHom φ))) ⟶ D)
      (C : (Finset B)ᵒᵖ → Type u) (_ : ∀ T, CommRing (C T)) (ψ : ∀ T, A →+* C T) (β : ∀ T, C T →+* B)
      (sE : ∀ T, D.obj T ⟶ Z) (hE : ∀ T, D.obj T ⟶ Spec (.of (C T))),
      Nonempty (Limits.IsLimit (Limits.Cone.mk _ ρ)) ∧
      (∀ {T T' : (Finset B)ᵒᵖ} (f : T ⟶ T'), IsAffineHom (D.map f)) ∧
      (∀ T, CompactSpace (D.obj T)) ∧ (∀ T, QuasiSeparatedSpace (D.obj T)) ∧
      (∀ T, (ψ T).FinitePresentation) ∧ (∀ T, (β T).comp (ψ T) = φ) ∧
      (∀ T, IsPullback (sE T) (hE T) h (Spec.map (CommRingCat.ofHom (ψ T)))) ∧
      (∀ T, ρ.app T ≫ sE T = Limits.pullback.fst h (Spec.map (CommRingCat.ofHom φ))) ∧
      (∀ T, ρ.app T ≫ hE T =
        Limits.pullback.snd h (Spec.map (CommRingCat.ofHom φ)) ≫ Spec.map (CommRingCat.ofHom (β T))) :=
by
  intro A B _ _ _ φ Z h _
  letI : Algebra A B := φ.toAlgebra

  have s1 : ∀ (J : Type u) [SmallCategory J] [IsFiltered J] (G : J ⥤ CommRingCat.{u}) (κ : Limits.Cocone G), (∀ j, Function.Injective (κ.ι.app j)) → (∀ x : κ.pt, ∃ (j : J) (y : G.obj j), κ.ι.app j y = x) → Nonempty (Limits.IsColimit κ) := by
    intro J _ _ G κ hinj hsurj
    have ht : Limits.IsColimit ((forget CommRingCat).mapCocone κ) := by
      apply Limits.Types.FilteredColimit.isColimitOf
      · intro x
        obtain ⟨j, y, hy⟩ := hsurj x
        exact ⟨j, y, hy.symm⟩
      · intro i j xi xj h
        refine ⟨IsFiltered.max i j, IsFiltered.leftToMax i j, IsFiltered.rightToMax i j, ?_⟩
        apply hinj (IsFiltered.max i j)
        have e1 := congrArg (fun f => (ConcreteCategory.hom f) xi) (κ.w (IsFiltered.leftToMax i j))
        have e2 := congrArg (fun f => (ConcreteCategory.hom f) xj) (κ.w (IsFiltered.rightToMax i j))
        simp only [CommRingCat.comp_apply] at e1 e2
        change (κ.ι.app (IsFiltered.max i j)) ((G.map (IsFiltered.leftToMax i j)) xi) =
          (κ.ι.app (IsFiltered.max i j)) ((G.map (IsFiltered.rightToMax i j)) xj)
        rw [e1, e2]
        exact h
    have : Limits.ReflectsColimitsOfShape J (forget CommRingCat) :=
      Limits.reflectsColimitsOfShape_of_reflectsIsomorphisms
    exact ⟨Limits.isColimitOfReflects (forget CommRingCat) ht⟩

  have s2 : ∀ (J : Type u) [SmallCategory J] [IsFiltered J] (G : J ⥤ CommRingCat.{u}) (κ : Limits.Cocone G), Limits.IsColimit κ → ∀ (X Y₀ : Scheme.{u}) (h₀ : Y₀ ⟶ X) (q : ∀ j, Spec (G.obj j) ⟶ X), (∀ {i j : J} (f : i ⟶ j), Spec.map (G.map f) ≫ q i = q j) → ∀ (q₀ : Spec κ.pt ⟶ X), (∀ j, Spec.map (κ.ι.app j) ≫ q j = q₀) → ∃ (E : Jᵒᵖ ⥤ Scheme.{u}) (c : Limits.Cone E) (_ : Limits.IsLimit c) (fE : ∀ j, E.obj (Opposite.op j) ⟶ Spec (G.obj j)) (sE : ∀ j, E.obj (Opposite.op j) ⟶ Y₀) (fc : c.pt ⟶ Spec κ.pt) (sc : c.pt ⟶ Y₀), (∀ j, IsPullback (fE j) (sE j) (q j) h₀) ∧ IsPullback fc sc q₀ h₀ ∧ (∀ j, c.π.app (Opposite.op j) ≫ fE j = fc ≫ Spec.map (κ.ι.app j)) ∧ (∀ j, c.π.app (Opposite.op j) ≫ sE j = sc) ∧ (∀ {i j : Jᵒᵖ} (f : i ⟶ j), IsAffineHom (E.map f)) := by
    intro J _ _ G κ hκ X Y₀ h₀ q hq q₀ hq₀
    have hSpec : Limits.IsLimit (Scheme.Spec.mapCone κ.op) :=
      Limits.isLimitOfPreserves Scheme.Spec hκ.op
    let D₀ : Jᵒᵖ ⥤ Over X := (G.op ⋙ Scheme.Spec).toOver X (fun j => q j.unop)
      (fun g => hq g.unop)
    let c₀ : Limits.Cone D₀ :=
      { pt := Over.mk q₀
        π :=
          { app := fun j => Over.homMk (Spec.map (κ.ι.app j.unop)) (hq₀ j.unop)
            naturality := by
              intro j j' g
              apply Over.OverMorphism.ext
              change Spec.map (κ.ι.app j'.unop) =
                Spec.map (κ.ι.app j.unop) ≫ Spec.map (G.map g.unop)
              rw [← Spec.map_comp, κ.w] } }
    let α : G.op ⋙ Scheme.Spec ≅ D₀ ⋙ Over.forget X :=
      NatIso.ofComponents (fun _ => Iso.refl _) (by intros; rfl)
    have h1 : Limits.IsLimit ((Over.forget X).mapCone c₀) :=
      (Limits.IsLimit.equivOfNatIsoOfIso α _ _
        (Limits.Cone.ext (Iso.refl _) (fun j => by
          change Spec.map (κ.ι.app j.unop) ≫ 𝟙 _ = 𝟙 _ ≫ Spec.map (κ.ι.app j.unop)
          simp))) hSpec
    have := IsCofiltered.isConnected Jᵒᵖ
    have hc₀ : Limits.IsLimit c₀ := Limits.isLimitOfReflects (Over.forget X) h1
    let Φ : Over X ⥤ Scheme.{u} := Over.pullback h₀ ⋙ Over.forget Y₀
    have hc : Limits.IsLimit (Φ.mapCone c₀) := Limits.isLimitOfPreserves Φ hc₀
    refine ⟨D₀ ⋙ Φ, Φ.mapCone c₀, hc, fun j => Limits.pullback.fst (q j) h₀,
      fun j => Limits.pullback.snd (q j) h₀, Limits.pullback.fst q₀ h₀, Limits.pullback.snd q₀ h₀,
      fun j => IsPullback.of_hasPullback (q j) h₀, IsPullback.of_hasPullback q₀ h₀,
      fun j => Limits.pullback.lift_fst _ _ _, fun j => Limits.pullback.lift_snd _ _ _, ?_⟩
    intro i j g
    let m : Limits.pullback (q i.unop) h₀ ⟶ Limits.pullback (q j.unop) h₀ := (D₀ ⋙ Φ).map g
    have e1 : m ≫ Limits.pullback.snd (q j.unop) h₀ =
        Limits.pullback.snd (q i.unop) h₀ := Limits.pullback.lift_snd _ _ _
    have e2 : m ≫ Limits.pullback.fst (q j.unop) h₀ =
        Limits.pullback.fst (q i.unop) h₀ ≫ Spec.map (G.map g.unop) :=
      Limits.pullback.lift_fst _ _ _
    have hL : IsPullback m (Limits.pullback.fst (q i.unop) h₀)
        (Limits.pullback.fst (q j.unop) h₀) (Spec.map (G.map g.unop)) := by
      refine IsPullback.of_right (h₁₂ := Limits.pullback.snd (q j.unop) h₀) (v₁₃ := h₀)
        (h₂₂ := q j.unop) ?_ e2 (IsPullback.of_hasPullback (q j.unop) h₀).flip
      rw [e1, hq g.unop]
      exact (IsPullback.of_hasPullback (q i.unop) h₀).flip
    have : IsAffineHom (Spec.map (G.map g.unop)) := isAffineHom_of_isAffine _
    have : IsAffineHom m :=
      MorphismProperty.of_isPullback (P := @IsAffineHom) hL.flip inferInstance
    exact this

  let Csub : Finset B → Subalgebra A B := fun T => Algebra.adjoin A (T : Set B)
  have hmonoC : ∀ {T T' : Finset B}, T ≤ T' → Csub T ≤ Csub T' := fun hT =>
    Algebra.adjoin_mono (Finset.coe_subset.mpr hT)
  let G : Finset B ⥤ CommRingCat.{u} :=
    { obj := fun T => CommRingCat.of ↥(Csub T)
      map := fun {T T'} f => CommRingCat.ofHom (Subalgebra.inclusion (hmonoC (leOfHom f))).toRingHom
      map_id := fun T => by ext x; rfl
      map_comp := fun f g => by ext x; rfl }
  let κ : Limits.Cocone G :=
    { pt := CommRingCat.of B
      ι :=
        { app := fun T => CommRingCat.ofHom (Csub T).val.toRingHom
          naturality := fun {T T'} f => by ext x; rfl } }
  obtain ⟨hκ⟩ := s1 (Finset B) G κ (fun T x y hxy => Subtype.ext hxy)
    (fun b => ⟨{b}, (⟨b, Algebra.subset_adjoin (by simp)⟩ : ↥(Csub {b})), rfl⟩)
  have hq : ∀ {T T' : Finset B} (f : T ⟶ T'), Spec.map (G.map f) ≫
      Spec.map (CommRingCat.ofHom (algebraMap A ↥(Csub T))) =
      Spec.map (CommRingCat.ofHom (algebraMap A ↥(Csub T'))) := by
    intro T T' f
    have e : CommRingCat.ofHom (algebraMap A ↥(Csub T)) ≫ G.map f =
        CommRingCat.ofHom (algebraMap A ↥(Csub T')) := by
      ext a; rfl
    rw [← Spec.map_comp, e]
  have hq₀ : ∀ T, Spec.map (κ.ι.app T) ≫ Spec.map (CommRingCat.ofHom (algebraMap A ↥(Csub T))) =
      Spec.map (CommRingCat.ofHom φ) := by
    intro T
    have e : CommRingCat.ofHom (algebraMap A ↥(Csub T)) ≫ κ.ι.app T = CommRingCat.ofHom φ := by
      ext a; rfl
    rw [← Spec.map_comp, e]
  obtain ⟨E, c, hc, fE, sE', fc, sc, hpb, hpb₀, hcf, hcs, haff⟩ :=
    s2 (Finset B) G κ hκ (Spec (.of A)) Z h
      (fun T => Spec.map (CommRingCat.ofHom (algebraMap A ↥(Csub T)))) hq
      (Spec.map (CommRingCat.ofHom φ)) hq₀
  have hprop : ∀ S, IsProper (fE S) := fun S =>
    MorphismProperty.of_isPullback (P := @IsProper) (hpb S).flip inferInstance

  obtain ⟨e, he1, he2⟩ : ∃ e : c.pt ≅ Limits.pullback h (Spec.map (CommRingCat.ofHom φ)),
      e.hom ≫ Limits.pullback.fst h (Spec.map (CommRingCat.ofHom φ)) = sc ∧
      e.hom ≫ Limits.pullback.snd h (Spec.map (CommRingCat.ofHom φ)) = fc :=
    ⟨_, IsPullback.isoIsPullback_hom_fst _ _ hpb₀.flip
        (IsPullback.of_hasPullback h (Spec.map (CommRingCat.ofHom φ))),
      IsPullback.isoIsPullback_hom_snd _ _ hpb₀.flip
        (IsPullback.of_hasPullback h (Spec.map (CommRingCat.ofHom φ)))⟩
  let ρ : (Functor.const (Finset B)ᵒᵖ).obj (Limits.pullback h (Spec.map (CommRingCat.ofHom φ))) ⟶ E :=
    (Functor.const (Finset B)ᵒᵖ).map e.inv ≫ c.π
  refine ⟨E, ρ, fun T => ↥(Csub T.unop), fun T => inferInstance,
    fun T => algebraMap A ↥(Csub T.unop), fun T => (Csub T.unop).val.toRingHom,
    fun T => sE' T.unop, fun T => fE T.unop, ?_, haff, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · refine ⟨Limits.IsLimit.ofIsoLimit hc (Limits.Cone.ext e (fun j => ?_))⟩
    change c.π.app j = e.hom ≫ (e.inv ≫ c.π.app j)
    rw [Iso.hom_inv_id_assoc]
  · intro T
    obtain ⟨S⟩ := T
    have := hprop S
    exact QuasiCompact.compactSpace_of_compactSpace (fE S)
  · intro T
    obtain ⟨S⟩ := T
    have := hprop S
    exact quasiSeparatedSpace_of_quasiSeparated (fE S)
  · intro T
    exact RingHom.finitePresentation_algebraMap.mpr
      (Algebra.FinitePresentation.of_finiteType.mp
        ((Subalgebra.fg_iff_finiteType _).mp (Subalgebra.fg_adjoin_finset _)))
  · intro T
    ext a
    rfl
  · intro T
    exact (hpb T.unop).flip
  · intro T
    obtain ⟨S⟩ := T
    change (e.inv ≫ c.π.app (Opposite.op S)) ≫ sE' S = _
    rw [Category.assoc, hcs S, ← he1, Iso.inv_hom_id_assoc]
  · intro T
    obtain ⟨S⟩ := T
    change (e.inv ≫ c.π.app (Opposite.op S)) ≫ fE S =
      Limits.pullback.snd h (Spec.map (CommRingCat.ofHom φ)) ≫ Spec.map (κ.ι.app S)
    rw [Category.assoc, hcf S, ← he2, Category.assoc, Iso.inv_hom_id_assoc]

theorem wc_lim_affine_open_model : ∀ (I : Type u) [SmallCategory I] [IsCofiltered I] (D : I ⥤ Scheme.{u}) (c : Limits.Cone D), Limits.IsLimit c → (∀ {i j : I} (f : i ⟶ j), IsAffineHom (D.map f)) → ∀ (V₀ : Scheme.{u}) (p₀ : V₀ ⟶ c.pt), IsAffineHom p₀ → LocallyOfFinitePresentation p₀ → ∀ (i₀ : I) (U : (D.obj i₀).Opens), IsAffineOpen U → ∃ (k : I) (f : k ⟶ i₀) (A : (D.obj k).Opens) (O : V₀.Opens) (M : Scheme.{u}) (hM : M ⟶ (A : Scheme.{u})) (πO : (O : Scheme.{u}) ⟶ M), A = D.map f ⁻¹ᵁ U ∧ O = p₀ ⁻¹ᵁ (c.π.app i₀ ⁻¹ᵁ U) ∧ IsAffineHom hM ∧ LocallyOfFinitePresentation hM ∧ IsPullback πO (O.ι ≫ p₀) (hM ≫ A.ι) (c.π.app k) :=
by
  intro I _ _ D c hc haff V₀ p₀ hp₀a hp₀l i₀ U hU
  classical
  haveI : ∀ {i j : I} (f : i ⟶ j), IsAffineHom (D.map f) := haff

  have s4 : ∀ (X Y : Scheme.{u}) (g : X ⟶ Y) (U : Y.Opens) (V : X.Opens) (h : V ≤ g ⁻¹ᵁ U),
      V = g ⁻¹ᵁ U → IsPullback (g.resLE U V h) V.ι U.ι g := by
    intro X Y g U V h hV
    subst hV
    rw [Scheme.Hom.resLE_eq_morphismRestrict]
    exact isPullback_morphismRestrict g U

  have s1 : ∀ (J : Type u) [SmallCategory J] [IsCofiltered J] (E : J ⥤ Scheme.{u})
      (d : Limits.Cone E), Limits.IsLimit d → (∀ j, IsAffine (E.obj j)) →
      ∀ (F : Finset ↑Γ(d.pt, ⊤)), ∃ j : J, ∀ a ∈ F, ∃ t : ↑Γ(E.obj j, ⊤),
        a = (d.π.app j).appTop.hom t := by
    intro J _ _ E d hd hE F
    haveI := hE
    haveI : ∀ {i j : J} (f : i ⟶ j), IsAffineHom (E.map f) := fun f => isAffineHom_of_isAffine _
    induction F using Finset.induction_on with
    | empty =>
      obtain ⟨j⟩ := IsCofiltered.nonempty (C := J)
      exact ⟨j, by simp⟩
    | insert a F' haF ih =>
      obtain ⟨j₁, h₁⟩ := ih
      obtain ⟨j₂, t₂, ht₂⟩ := exists_appTop_π_eq_of_isLimit E d hd a
      have star : ∀ (i : J) (g : IsCofiltered.min j₁ j₂ ⟶ i) (t : ↑Γ(E.obj i, ⊤)),
          (d.π.app i).appTop.hom t =
            (d.π.app (IsCofiltered.min j₁ j₂)).appTop.hom ((E.map g).appTop.hom t) := by
        intro i g t
        rw [← d.w g, Scheme.Hom.comp_appTop, CommRingCat.comp_apply]
      refine ⟨IsCofiltered.min j₁ j₂, fun b hb => ?_⟩
      rcases Finset.mem_insert.mp hb with rfl | hb
      · exact ⟨(E.map (IsCofiltered.minToRight j₁ j₂)).appTop.hom t₂, ht₂.trans (star _ _ _)⟩
      · obtain ⟨t₁, ht₁⟩ := h₁ b hb
        exact ⟨(E.map (IsCofiltered.minToLeft j₁ j₂)).appTop.hom t₁, ht₁.trans (star _ _ _)⟩

  have s2 : ∀ (Y X : Scheme.{u}) [IsAffine Y] [IsAffine X] (p : X ⟶ Y)
      [LocallyOfFinitePresentation p], ∃ F : Finset ↑Γ(Y, ⊤), ∀ (T : Scheme.{u}) [IsAffine T]
      (π : Y ⟶ T), (∀ a ∈ F, ∃ t : ↑Γ(T, ⊤), a = π.appTop.hom t) →
      ∃ (M : Scheme.{u}) (hM : M ⟶ T) (πX : X ⟶ M), IsAffineHom hM ∧
        LocallyOfFinitePresentation hM ∧ IsPullback πX p hM π := by
    intro Y X _ _ p _
    let φ : Γ(Y, ⊤) →+* Γ(X, ⊤) := p.appTop.hom
    have hφ : φ.FinitePresentation :=
      (HasRingHomProperty.iff_of_isAffine (P := @LocallyOfFinitePresentation)).mp inferInstance
    letI : Algebra Γ(Y, ⊤) Γ(X, ⊤) := φ.toAlgebra
    haveI : Algebra.FinitePresentation Γ(Y, ⊤) Γ(X, ⊤) := hφ
    let P := Algebra.Presentation.ofFinitePresentation Γ(Y, ⊤) Γ(X, ⊤)
    refine ⟨P.finite_coeffs.toFinset, ?_⟩
    intro T _ π hF
    letI : Algebra Γ(T, ⊤) Γ(Y, ⊤) := π.appTop.hom.toAlgebra
    letI : Algebra Γ(T, ⊤) Γ(X, ⊤) := (φ.comp π.appTop.hom).toAlgebra
    haveI : IsScalarTower Γ(T, ⊤) Γ(Y, ⊤) Γ(X, ⊤) := IsScalarTower.of_algebraMap_eq' rfl
    haveI : P.HasCoeffs Γ(T, ⊤) := ⟨by
      intro x hx
      obtain ⟨t, ht⟩ := hF x (by simpa using hx)
      exact ⟨t, ht.symm⟩⟩
    let C₀ := P.ModelOfHasCoeffs Γ(T, ⊤)
    have hfp : Algebra.FinitePresentation Γ(T, ⊤) C₀ :=
      Algebra.FinitePresentation.quotient (Submodule.fg_span (Set.finite_range _))
    let Tn := TensorProduct Γ(T, ⊤) Γ(Y, ⊤) C₀
    let e' : Tn ≃ₐ[Γ(Y, ⊤)] Γ(X, ⊤) := P.tensorModelOfHasCoeffsEquiv Γ(T, ⊤)
    have Q₀ := (isPullback_SpecMap_of_isPushout _ _ _ _
      (CommRingCat.isPushout_tensorProduct Γ(T, ⊤) Γ(Y, ⊤) C₀)).flip
    let E : CommRingCat.of Tn ≅ Γ(X, ⊤) := e'.toRingEquiv.toCommRingCatIso
    let incL : CommRingCat.of Γ(Y, ⊤) ⟶ CommRingCat.of Tn :=
      CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom
    let incR : CommRingCat.of C₀ ⟶ CommRingCat.of Tn :=
      CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom
    let ψ : X ⟶ Spec (.of Tn) := X.isoSpec.hom ≫ Spec.map E.hom
    haveI : IsIso ψ := inferInstance
    let πX : X ⟶ Spec (.of C₀) := ψ ≫ Spec.map incR
    have hring : incL ≫ E.hom = p.appTop := by
      ext a
      change e' (a ⊗ₜ 1) = φ a
      have := e'.commutes a
      rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply] at this
      exact this
    have hkey : ψ ≫ Spec.map incL = p ≫ Y.isoSpec.hom := by
      calc ψ ≫ Spec.map incL
          = X.isoSpec.hom ≫ Spec.map (incL ≫ E.hom) := by
            simp only [ψ, Category.assoc, Spec.map_comp]
        _ = X.isoSpec.hom ≫ Spec.map p.appTop := by rw [hring]
        _ = p ≫ Y.isoSpec.hom := Scheme.isoSpec_hom_naturality p
    have hbase : Spec.map (CommRingCat.ofHom (algebraMap Γ(T, ⊤) Γ(Y, ⊤))) ≫ T.isoSpec.inv =
        Y.isoSpec.inv ≫ π := by
      change Spec.map π.appTop ≫ T.isoSpec.inv = Y.isoSpec.inv ≫ π
      rw [Iso.eq_inv_comp, ← Category.assoc, Iso.comp_inv_eq]
      exact Scheme.isoSpec_hom_naturality π
    let hM : Spec (.of C₀) ⟶ T :=
      Spec.map (CommRingCat.ofHom (algebraMap Γ(T, ⊤) C₀)) ≫ T.isoSpec.inv
    have hpb : IsPullback πX p hM π := by
      refine IsPullback.of_iso Q₀ (asIso ψ).symm (Iso.refl _) Y.isoSpec.symm T.isoSpec.symm
        ?_ ?_ ?_ ?_
      · simp [πX, incR]
      · simp only [Iso.symm_hom, asIso_inv]
        rw [IsIso.eq_inv_comp]
        change ψ ≫ Spec.map incL ≫ Y.isoSpec.inv = p
        rw [← Category.assoc, hkey, Category.assoc, Iso.hom_inv_id, Category.comp_id]
      · rw [Iso.refl_hom, Category.id_comp]
        rfl
      · exact hbase
    haveI : LocallyOfFinitePresentation (Spec.map (CommRingCat.ofHom (algebraMap Γ(T, ⊤) C₀))) :=
      (HasRingHomProperty.Spec_iff (P := @LocallyOfFinitePresentation)).mpr
        (RingHom.finitePresentation_algebraMap.mpr hfp)
    exact ⟨Spec (.of C₀), hM, πX, isAffineHom_of_isAffine hM, inferInstance, hpb⟩

  haveI := hp₀a
  haveI := hp₀l
  haveI := isAffineHom_π_app D c hc i₀
  have hY : IsAffineOpen (c.π.app i₀ ⁻¹ᵁ U) := hU.preimage (c.π.app i₀)
  haveI : IsAffine (c.π.app i₀ ⁻¹ᵁ U : Scheme.{u}) := hY
  have hO : IsAffineOpen (p₀ ⁻¹ᵁ (c.π.app i₀ ⁻¹ᵁ U)) := hY.preimage p₀
  haveI : IsAffine (p₀ ⁻¹ᵁ (c.π.app i₀ ⁻¹ᵁ U) : Scheme.{u}) := hO
  haveI : LocallyOfFinitePresentation (p₀ ∣_ (c.π.app i₀ ⁻¹ᵁ U)) := inferInstance
  obtain ⟨F, hF⟩ := s2 (c.π.app i₀ ⁻¹ᵁ U : Scheme.{u}) (p₀ ⁻¹ᵁ (c.π.app i₀ ⁻¹ᵁ U) : Scheme.{u})
    (p₀ ∣_ (c.π.app i₀ ⁻¹ᵁ U))
  have hE : ∀ n, IsAffine ((opensDiagram D i₀ U).obj n) := fun n => hU.preimage (D.map n.hom)
  obtain ⟨n, hn⟩ := s1 (Over i₀) (opensDiagram D i₀ U) (opensCone D c i₀ U)
    (isLimitOpensCone D c hc i₀ U) hE F
  haveI : IsAffine ((opensDiagram D i₀ U).obj n) := hE n
  obtain ⟨M, hM, πX, hMa, hMl, sq⟩ :=
    hF ((opensDiagram D i₀ U).obj n) ((opensCone D c i₀ U).π.app n) hn
  have hcone : c.π.app i₀ ⁻¹ᵁ U = c.π.app n.left ⁻¹ᵁ (D.map n.hom ⁻¹ᵁ U) := by
    rw [← Scheme.Hom.comp_preimage, c.w n.hom]
  have sq₂ : IsPullback ((opensCone D c i₀ U).π.app n) (c.π.app i₀ ⁻¹ᵁ U).ι
      (D.map n.hom ⁻¹ᵁ U).ι (c.π.app n.left) := by
    rw [opensCone_π_app]
    exact s4 _ _ (c.π.app n.left) (D.map n.hom ⁻¹ᵁ U) (c.π.app i₀ ⁻¹ᵁ U) _ hcone
  have sq₃ := IsPullback.paste_vert sq sq₂
  rw [morphismRestrict_ι] at sq₃
  exact ⟨n.left, n.hom, D.map n.hom ⁻¹ᵁ U, p₀ ⁻¹ᵁ (c.π.app i₀ ⁻¹ᵁ U), M, hM, πX, rfl, rfl,
    hMa, hMl, sq₃⟩

theorem wc_lim_two_chart_compatible_models : ∀ (I : Type u) [SmallCategory I] [IsCofiltered I] (D : I ⥤ Scheme.{u}) (c : Limits.Cone D), Limits.IsLimit c → (∀ {i j : I} (f : i ⟶ j), IsAffineHom (D.map f)) → (∀ i, CompactSpace (D.obj i)) → (∀ i, QuasiSeparatedSpace (D.obj i)) → ∀ (V₀ : Scheme.{u}) (p₀ : V₀ ⟶ c.pt) (k : I) (A B : (D.obj k).Opens), IsCompact ((A ⊓ B : (D.obj k).Opens) : Set (D.obj k)) → ∀ (OA OB : V₀.Opens), OA = p₀ ⁻¹ᵁ (c.π.app k ⁻¹ᵁ A) → OB = p₀ ⁻¹ᵁ (c.π.app k ⁻¹ᵁ B) → ∀ (MA MB : Scheme.{u}) (hA : MA ⟶ (A : Scheme.{u})) (hB : MB ⟶ (B : Scheme.{u})) (πA : (OA : Scheme.{u}) ⟶ MA) (πB : (OB : Scheme.{u}) ⟶ MB), IsAffineHom hA → LocallyOfFinitePresentation hA → IsAffineHom hB → LocallyOfFinitePresentation hB → IsPullback πA (OA.ι ≫ p₀) (hA ≫ A.ι) (c.π.app k) → IsPullback πB (OB.ι ≫ p₀) (hB ≫ B.ι) (c.π.app k) → ∃ (k' : I) (g : k' ⟶ k) (A' B' : (D.obj k').Opens) (MA' MB' G₀ : Scheme.{u}) (hA' : MA' ⟶ (A' : Scheme.{u})) (hB' : MB' ⟶ (B' : Scheme.{u})) (p : G₀ ⟶ MA') (q : G₀ ⟶ MB') (πA' : (OA : Scheme.{u}) ⟶ MA') (πB' : (OB : Scheme.{u}) ⟶ MB') (πG : ((OA ⊓ OB : V₀.Opens) : Scheme.{u}) ⟶ G₀), A' = D.map g ⁻¹ᵁ A ∧ B' = D.map g ⁻¹ᵁ B ∧ IsOpenImmersion p ∧ IsOpenImmersion q ∧ IsAffineHom hA' ∧ LocallyOfFinitePresentation hA' ∧ IsAffineHom hB' ∧ LocallyOfFinitePresentation hB' ∧ p ≫ hA' ≫ A'.ι = q ≫ hB' ≫ B'.ι ∧ (∀ x, (hA' ≫ A'.ι) x ∈ B' → x ∈ Set.range p) ∧ (∀ y, (hB' ≫ B'.ι) y ∈ A' → y ∈ Set.range q) ∧ IsPullback πA' (OA.ι ≫ p₀) (hA' ≫ A'.ι) (c.π.app k') ∧ IsPullback πB' (OB.ι ≫ p₀) (hB' ≫ B'.ι) (c.π.app k') ∧ IsPullback πG ((OA ⊓ OB).ι ≫ p₀) (p ≫ hA' ≫ A'.ι) (c.π.app k') ∧ πG ≫ p = V₀.homOfLE inf_le_left ≫ πA' ∧ πG ≫ q = V₀.homOfLE inf_le_right ≫ πB' :=
by
  intro I _ _ D c hc haff hcpt hqs V₀ p₀ k A B hcAB OA OB hOA hOB MA MB hA hB πA πB haA hlA haB hlB
    sqA sqB

  have L2 : ∀ (P M T S : Scheme.{u}) (r : P ⟶ M) (v : P ⟶ T) (m : M ⟶ S) (f : T ⟶ S)
      (C : S.Opens), IsPullback r v m f →
      ∃ ρ : ((v ⁻¹ᵁ (f ⁻¹ᵁ C) : P.Opens) : Scheme.{u}) ⟶ ((m ⁻¹ᵁ C : M.Opens) : Scheme.{u}),
        IsPullback ρ ((v ⁻¹ᵁ (f ⁻¹ᵁ C)).ι ≫ v) ((m ⁻¹ᵁ C).ι ≫ m) f ∧
        ρ ≫ (m ⁻¹ᵁ C).ι = (v ⁻¹ᵁ (f ⁻¹ᵁ C)).ι ≫ r := by
    intro P M T S r v m f C H
    have e : v ⁻¹ᵁ (f ⁻¹ᵁ C) = r ⁻¹ᵁ (m ⁻¹ᵁ C) := by
      rw [← Scheme.Hom.comp_preimage, ← Scheme.Hom.comp_preimage, H.w]
    have K : IsPullback (r ∣_ (m ⁻¹ᵁ C)) ((r ⁻¹ᵁ (m ⁻¹ᵁ C)).ι ≫ v) ((m ⁻¹ᵁ C).ι ≫ m) f :=
      (isPullback_morphismRestrict r (m ⁻¹ᵁ C)).paste_vert H
    refine ⟨(Scheme.isoOfEq P e).hom ≫ (r ∣_ (m ⁻¹ᵁ C)), ?_, ?_⟩
    · refine IsPullback.of_iso K (Scheme.isoOfEq P e).symm (Iso.refl _) (Iso.refl _) (Iso.refl _)
        ?_ ?_ ?_ ?_
      · simp
      · rw [Iso.refl_hom, Category.comp_id, Iso.symm_hom, ← Category.assoc, Scheme.isoOfEq_inv_ι]
      · simp
      · simp
    · rw [Category.assoc, morphismRestrict_ι, ← Category.assoc, Scheme.isoOfEq_hom_ι]

  have L1 : ∀ (T S : Scheme.{u}) (g : T ⟶ S) (Y : Scheme.{u}) (y : Y ⟶ T) (M : Scheme.{u})
      (m : M ⟶ S) (O O' : Y.Opens) (hOO : O' ≤ O) (πO : (O : Scheme.{u}) ⟶ M) (C : S.Opens),
      O' = O ⊓ y ⁻¹ᵁ (g ⁻¹ᵁ C) → IsPullback πO (O.ι ≫ y) m g →
      ∃ π' : (O' : Scheme.{u}) ⟶ ((m ⁻¹ᵁ C : M.Opens) : Scheme.{u}),
        IsPullback π' (O'.ι ≫ y) ((m ⁻¹ᵁ C).ι ≫ m) g ∧
        π' ≫ (m ⁻¹ᵁ C).ι = Y.homOfLE hOO ≫ πO := by
    intro T S g Y y M m O O' hOO πO C hO' H
    obtain ⟨ρ, K, hρ⟩ := L2 _ _ _ _ πO (O.ι ≫ y) m g C H
    have e : O.ι ⁻¹ᵁ O' = (O.ι ≫ y) ⁻¹ᵁ (g ⁻¹ᵁ C) := by
      rw [hO', Scheme.Hom.preimage_inf, Scheme.Opens.ι_preimage_self, top_inf_eq,
        Scheme.Hom.comp_preimage]
    let φ : (O' : Scheme.{u}) ≅ (((O.ι ≫ y) ⁻¹ᵁ (g ⁻¹ᵁ C) : (O : Scheme.{u}).Opens) : Scheme.{u}) :=
      (Scheme.Opens.isoOfLE hOO).symm ≪≫ Scheme.isoOfEq (O : Scheme.{u}) e
    have hstar : φ.hom ≫ ((O.ι ≫ y) ⁻¹ᵁ (g ⁻¹ᵁ C)).ι ≫ O.ι = O'.ι := by
      simp only [φ, Iso.trans_hom, Iso.symm_hom, Category.assoc]
      rw [← Category.assoc (Scheme.isoOfEq (O : Scheme.{u}) e).hom, Scheme.isoOfEq_hom_ι,
        Scheme.Opens.isoOfLE_inv_ι]
    have hstar' : φ.inv ≫ O'.ι = ((O.ι ≫ y) ⁻¹ᵁ (g ⁻¹ᵁ C)).ι ≫ O.ι := by
      rw [← hstar, Iso.inv_hom_id_assoc]
    refine ⟨φ.hom ≫ ρ, ?_, ?_⟩
    · refine IsPullback.of_iso K φ.symm (Iso.refl _) (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
      · rw [Iso.refl_hom, Category.comp_id, Iso.symm_hom, Iso.inv_hom_id_assoc]
      · rw [Iso.refl_hom, Category.comp_id, Iso.symm_hom, ← Category.assoc φ.inv, hstar',
          Category.assoc]
      · simp
      · simp
    · rw [Category.assoc, hρ, ← Category.assoc]
      congr 1
      rw [← cancel_mono O.ι, Category.assoc, hstar, Scheme.homOfLE_ι]

  have L3 : ∀ (k₁ k' : I) (g : k' ⟶ k₁) (A : (D.obj k₁).Opens) (O : V₀.Opens) (M : Scheme.{u})
      (hM : M ⟶ (A : Scheme.{u})) (πO : (O : Scheme.{u}) ⟶ M), IsAffineHom hM →
      LocallyOfFinitePresentation hM → IsPullback πO (O.ι ≫ p₀) (hM ≫ A.ι) (c.π.app k₁) →
      ∃ (M' : Scheme.{u}) (hM' : M' ⟶ ((D.map g ⁻¹ᵁ A : (D.obj k').Opens) : Scheme.{u}))
        (r : M' ⟶ M) (πO' : (O : Scheme.{u}) ⟶ M'), IsAffineHom hM' ∧
        LocallyOfFinitePresentation hM' ∧
        IsPullback r (hM' ≫ (D.map g ⁻¹ᵁ A).ι) (hM ≫ A.ι) (D.map g) ∧
        IsPullback πO' (O.ι ≫ p₀) (hM' ≫ (D.map g ⁻¹ᵁ A).ι) (c.π.app k') ∧ πO' ≫ r = πO := by
    intro k₁ k' g A O M hM πO ha hl sq
    have Q : IsPullback (Limits.pullback.fst hM (D.map g ∣_ A))
        (Limits.pullback.snd hM (D.map g ∣_ A) ≫ (D.map g ⁻¹ᵁ A).ι) (hM ≫ A.ι) (D.map g) :=
      (IsPullback.of_hasPullback hM (D.map g ∣_ A)).paste_vert
        (isPullback_morphismRestrict (D.map g) A)
    have hw : c.π.app k' ≫ D.map g = c.π.app k₁ := c.w g
    have w : πO ≫ hM ≫ A.ι = ((O.ι ≫ p₀) ≫ c.π.app k') ≫ D.map g := by
      rw [sq.w, Category.assoc (O.ι ≫ p₀), hw]
    refine ⟨_, _, _, Q.lift πO ((O.ι ≫ p₀) ≫ c.π.app k') w,
      MorphismProperty.of_isPullback (P := @IsAffineHom)
        (IsPullback.of_hasPullback hM (D.map g ∣_ A)) ha,
      MorphismProperty.of_isPullback (P := @LocallyOfFinitePresentation)
        (IsPullback.of_hasPullback hM (D.map g ∣_ A)) hl, Q, ?_, Q.lift_fst _ _ _⟩
    refine IsPullback.of_right ?_ (Q.lift_snd _ _ _) Q
    rw [Q.lift_fst, hw]
    exact sq

  have L4 : ∀ (S : Scheme.{u}) (A B : S.Opens), QuasiSeparatedSpace S →
      IsCompact ((A ⊓ B : S.Opens) : Set S) → ∀ (M : Scheme.{u}) (hA : M ⟶ (A : Scheme.{u})),
      IsAffineHom hA → CompactSpace (((hA ≫ A.ι) ⁻¹ᵁ B : M.Opens) : Scheme.{u}) ∧
        QuasiSeparatedSpace (((hA ≫ A.ι) ⁻¹ᵁ B : M.Opens) : Scheme.{u}) := by
    intro S A B hS hc M hA haff'
    have h1 : IsCompact ((A.ι ⁻¹ᵁ B : (A : Scheme.{u}).Opens) : Set (A : Scheme.{u})) := by
      rw [A.ι.isOpenEmbedding.isInducing.isCompact_iff]
      change IsCompact (A.ι '' (A.ι ⁻¹' (B : Set S)))
      rw [Set.image_preimage_eq_inter_range, Scheme.Opens.range_ι, Set.inter_comm]
      rw [← TopologicalSpace.Opens.coe_inf]
      exact hc
    have h2 : IsCompact (((hA ≫ A.ι) ⁻¹ᵁ B : M.Opens) : Set M) := by
      rw [Scheme.Hom.comp_preimage]
      exact QuasiCompact.isCompact_preimage (f := hA) _ (A.ι ⁻¹ᵁ B).2 h1
    refine ⟨isCompact_iff_compactSpace.mp h2, ?_⟩
    haveI : QuasiSeparatedSpace (A : Scheme.{u}) := A.ι.isOpenEmbedding.quasiSeparatedSpace
    haveI : QuasiSeparatedSpace M := quasiSeparatedSpace_of_quasiSeparated hA
    exact ((hA ≫ A.ι) ⁻¹ᵁ B).ι.isOpenEmbedding.quasiSeparatedSpace
  have hcw : ∀ n : Over k, c.π.app n.left ≫ D.map n.hom = c.π.app k := fun n => c.w n.hom

  have U1 : ∀ (X N : Scheme.{u}) (x : X ⟶ c.pt) (u : N ⟶ D.obj k) (π : X ⟶ N),
      IsPullback π x u (c.π.app k) →
      ∃ (E : Over k ⥤ Scheme.{u}) (ρ : (Functor.const (Over k)).obj X ⟶ E)
        (r : ∀ n : Over k, E.obj n ⟶ N) (v : ∀ n : Over k, E.obj n ⟶ D.obj n.left),
        Nonempty (Limits.IsLimit (Limits.Cone.mk X ρ)) ∧
        (∀ {n n' : Over k} (f : n ⟶ n'), IsAffineHom (E.map f)) ∧
        (∀ n : Over k, IsPullback (r n) (v n) u (D.map n.hom)) ∧
        (∀ n : Over k, ρ.app n ≫ r n = π) ∧
        (∀ n : Over k, ρ.app n ≫ v n = x ≫ c.π.app n.left) ∧
        (∀ {n n' : Over k} (f : n ⟶ n'), E.map f ≫ r n' = r n) ∧
        (∀ {n n' : Over k} (f : n ⟶ n'), E.map f ≫ v n' = v n ≫ D.map f.left) := by
    intro X N x u π H
    have wf : ∀ {n n' : Over k} (f : n ⟶ n'), Limits.pullback.fst u (D.map n.hom) ≫ u =
        (Limits.pullback.snd u (D.map n.hom) ≫ D.map f.left) ≫ D.map n'.hom := by
      intro n n' f
      rw [Category.assoc, ← D.map_comp, Over.w f, Limits.pullback.condition]
    have lfst : ∀ (n : Over k) {W : Scheme.{u}} (a : W ⟶ N) (b : W ⟶ D.obj n.left)
        (w : a ≫ u = b ≫ D.map n.hom),
        Limits.pullback.lift a b w ≫ Limits.pullback.fst u (D.map n.hom) = a :=
      fun n W a b w => Limits.pullback.lift_fst a b w
    have lsnd : ∀ (n : Over k) {W : Scheme.{u}} (a : W ⟶ N) (b : W ⟶ D.obj n.left)
        (w : a ≫ u = b ≫ D.map n.hom),
        Limits.pullback.lift a b w ≫ Limits.pullback.snd u (D.map n.hom) = b :=
      fun n W a b w => Limits.pullback.lift_snd a b w
    let E : Over k ⥤ Scheme.{u} :=
      { obj := fun n => Limits.pullback u (D.map n.hom)
        map := fun {n n'} f => Limits.pullback.lift (Limits.pullback.fst _ _)
          (Limits.pullback.snd _ _ ≫ D.map f.left) (wf f)
        map_id := by
          intro n
          apply Limits.pullback.hom_ext
          · simp
          · simp
        map_comp := by
          intro n n' n'' f f'
          apply Limits.pullback.hom_ext
          · rw [lfst, Category.assoc, lfst, lfst]
          · rw [lsnd, Category.assoc, lsnd, ← Category.assoc, lsnd]
            simp only [Over.comp_left, Functor.map_comp, Category.assoc] }
    have Efst : ∀ {n n' : Over k} (f : n ⟶ n'),
        E.map f ≫ Limits.pullback.fst u (D.map n'.hom) = Limits.pullback.fst u (D.map n.hom) :=
      fun f => Limits.pullback.lift_fst _ _ _
    have Esnd : ∀ {n n' : Over k} (f : n ⟶ n'),
        E.map f ≫ Limits.pullback.snd u (D.map n'.hom) =
          Limits.pullback.snd u (D.map n.hom) ≫ D.map f.left :=
      fun f => Limits.pullback.lift_snd _ _ _
    have wρ : ∀ n : Over k, π ≫ u = (x ≫ c.π.app n.left) ≫ D.map n.hom := by
      intro n
      rw [H.w, Category.assoc, hcw n]
    let ρ : (Functor.const (Over k)).obj X ⟶ E :=
      { app := fun n => Limits.pullback.lift π (x ≫ c.π.app n.left) (wρ n)
        naturality := by
          intro n n' f
          apply Limits.pullback.hom_ext
          · rw [Category.assoc, Category.assoc, Efst f, lfst, lfst]
            exact Category.id_comp π
          · rw [Category.assoc, Category.assoc, Esnd f]
            simp only [Functor.const_obj_map, Functor.const_obj_obj, Category.id_comp,
              Limits.pullback.lift_snd, Limits.pullback.lift_snd_assoc, Category.assoc,
              Limits.Cone.w] }
    have ρfst : ∀ n : Over k, ρ.app n ≫ Limits.pullback.fst u (D.map n.hom) = π :=
      fun n => Limits.pullback.lift_fst _ _ _
    have ρsnd : ∀ n : Over k, ρ.app n ≫ Limits.pullback.snd u (D.map n.hom) =
        x ≫ c.π.app n.left := fun n => Limits.pullback.lift_snd _ _ _
    haveI := Over.initial_forget k
    have hc' : Limits.IsLimit (c.whisker (Over.forget k)) :=
      (Functor.Initial.isLimitWhiskerEquiv (Over.forget k) c).symm hc
    let n₀ : Over k := Over.mk (𝟙 k)
    refine ⟨E, ρ, fun n => Limits.pullback.fst _ _, fun n => Limits.pullback.snd _ _, ⟨?_⟩, ?_,
      fun n => IsPullback.of_hasPullback _ _, ρfst, ρsnd, fun f => Efst f, fun f => Esnd f⟩
    · let L : Limits.Cone E → Limits.Cone (Over.forget k ⋙ D) := fun s =>
        { pt := s.pt
          π :=
            { app := fun n => s.π.app n ≫ Limits.pullback.snd u (D.map n.hom)
              naturality := by
                intro n n' f
                have := s.w f
                simp only [Functor.const_obj_obj, Functor.const_obj_map, Category.id_comp,
                  Functor.comp_map, Over.forget_map, Functor.comp_obj, Over.forget_obj]
                rw [← s.w f, Category.assoc, Esnd f, Category.assoc] } }
      have hℓ : ∀ (s : Limits.Cone E) (n : Over k),
          hc'.lift (L s) ≫ c.π.app n.left = s.π.app n ≫ Limits.pullback.snd u (D.map n.hom) :=
        fun s n => hc'.fac (L s) n
      have w : ∀ s : Limits.Cone E, (s.π.app n₀ ≫ Limits.pullback.fst u (D.map n₀.hom)) ≫ u =
          hc'.lift (L s) ≫ c.π.app k := by
        intro s
        rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, ← hℓ s n₀,
          Category.assoc, hcw n₀]
      have hfst : ∀ (s : Limits.Cone E) (n : Over k),
          s.π.app n₀ ≫ Limits.pullback.fst u (D.map n₀.hom) =
            s.π.app n ≫ Limits.pullback.fst u (D.map n.hom) := by
        intro s n
        rw [← s.w (Over.homMk n.hom : n ⟶ n₀), Category.assoc, Efst]
      refine
        { lift := fun s => H.lift (s.π.app n₀ ≫ Limits.pullback.fst u (D.map n₀.hom))
            (hc'.lift (L s)) (w s)
          fac := ?_
          uniq := ?_ }
      · intro s n
        apply Limits.pullback.hom_ext
        · change _ ≫ ρ.app n ≫ _ = _
          rw [ρfst, H.lift_fst, hfst s n]
        · change _ ≫ ρ.app n ≫ _ = _
          rw [ρsnd, ← Category.assoc, H.lift_snd, hℓ s n]
      · intro s m hm
        apply H.hom_ext
        · rw [H.lift_fst, ← ρfst n₀, ← Category.assoc]
          exact congrArg (· ≫ Limits.pullback.fst u (D.map n₀.hom)) (hm n₀)
        · rw [H.lift_snd]
          apply hc'.hom_ext
          intro n
          change (m ≫ x) ≫ c.π.app n.left = hc'.lift (L s) ≫ c.π.app n.left
          rw [hℓ s n, Category.assoc, ← ρsnd n, ← Category.assoc]
          exact congrArg (· ≫ Limits.pullback.snd u (D.map n.hom)) (hm n)
    · intro n n' f
      have big : IsPullback (E.map f ≫ Limits.pullback.fst u (D.map n'.hom))
          (Limits.pullback.snd u (D.map n.hom)) u (D.map f.left ≫ D.map n'.hom) := by
        rw [Efst f, ← D.map_comp, Over.w f]
        exact IsPullback.of_hasPullback _ _
      have sq' : IsPullback (E.map f) (Limits.pullback.snd u (D.map n.hom))
          (Limits.pullback.snd u (D.map n'.hom)) (D.map f.left) :=
        IsPullback.of_right big (Esnd f) (IsPullback.of_hasPullback _ _)
      exact MorphismProperty.of_isPullback (P := @IsAffineHom) sq'.flip (haff f.left)

  have UNIQ : ∀ (X N₁ N₂ : Scheme.{u}) (x : X ⟶ c.pt) (u₁ : N₁ ⟶ D.obj k) (u₂ : N₂ ⟶ D.obj k)
      (π₁ : X ⟶ N₁) (π₂ : X ⟶ N₂), CompactSpace N₁ → QuasiSeparatedSpace N₁ → CompactSpace N₂ →
      QuasiSeparatedSpace N₂ → LocallyOfFinitePresentation u₁ → LocallyOfFinitePresentation u₂ →
      IsPullback π₁ x u₁ (c.π.app k) → IsPullback π₂ x u₂ (c.π.app k) →
      ∃ (k' : I) (g : k' ⟶ k), ∀ (P₁ P₂ : Scheme.{u}) (r₁ : P₁ ⟶ N₁) (v₁ : P₁ ⟶ D.obj k')
        (r₂ : P₂ ⟶ N₂) (v₂ : P₂ ⟶ D.obj k') (σ₁ : X ⟶ P₁) (σ₂ : X ⟶ P₂),
        IsPullback r₁ v₁ u₁ (D.map g) → IsPullback r₂ v₂ u₂ (D.map g) → σ₁ ≫ r₁ = π₁ →
        σ₁ ≫ v₁ = x ≫ c.π.app k' → σ₂ ≫ r₂ = π₂ → σ₂ ≫ v₂ = x ≫ c.π.app k' →
        ∃ e : P₁ ≅ P₂, e.hom ≫ v₂ = v₁ ∧ σ₁ ≫ e.hom = σ₂ := by
    intro X N₁ N₂ x u₁ u₂ π₁ π₂ hN1c hN1q hN2c hN2q hl1 hl2 H₁ H₂
    obtain ⟨E₁, ρ₁, r₁, v₁, ⟨hlim₁⟩, haff₁, sq₁, ρr₁, ρv₁, Er₁, Ev₁⟩ := U1 X N₁ x u₁ π₁ H₁
    obtain ⟨E₂, ρ₂, r₂, v₂, ⟨hlim₂⟩, haff₂, sq₂, ρr₂, ρv₂, Er₂, Ev₂⟩ := U1 X N₂ x u₂ π₂ H₂
    have i1 : ∀ {i j : Over k} (f : i ⟶ j), IsAffineHom (E₁.map f) := fun f => haff₁ f
    have i2 : ∀ {i j : Over k} (f : i ⟶ j), IsAffineHom (E₂.map f) := fun f => haff₂ f
    have hra1 : ∀ n : Over k, IsAffineHom (r₁ n) := fun n =>
      MorphismProperty.of_isPullback (P := @IsAffineHom) (sq₁ n).flip (haff n.hom)
    have hra2 : ∀ n : Over k, IsAffineHom (r₂ n) := fun n =>
      MorphismProperty.of_isPullback (P := @IsAffineHom) (sq₂ n).flip (haff n.hom)
    have i3 : ∀ n : Over k, CompactSpace (E₁.obj n) := fun n => by
      haveI := hra1 n; exact QuasiCompact.compactSpace_of_compactSpace (r₁ n)
    have i4 : ∀ n : Over k, QuasiSeparatedSpace (E₁.obj n) := fun n => by
      haveI := hra1 n; exact quasiSeparatedSpace_of_quasiSeparated (r₁ n)
    have i5 : ∀ n : Over k, CompactSpace (E₂.obj n) := fun n => by
      haveI := hra2 n; exact QuasiCompact.compactSpace_of_compactSpace (r₂ n)
    have i6 : ∀ n : Over k, QuasiSeparatedSpace (E₂.obj n) := fun n => by
