  let L : Finset Γ(T, ⊤) ⥤ ((Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) :=
    { obj := fun F => wcLCPb (wcStageQ t F ≫ p) (ULift.{u+1} (ZMod m))
