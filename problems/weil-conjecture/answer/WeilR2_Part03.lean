  have hcoh : ∀ M : P.Modules, wcCoherentMod M → wcCoherentMod (M.restrict (p ⁻¹ᵁ V).ι) := by
    intro M hM
    refine ⟨fun W hW g => ?_, fun W hW => ?_⟩
    · have hW' : IsAffineOpen ((p ⁻¹ᵁ V).ι ''ᵁ W) := hW.image_of_isOpenImmersion _
      have hD := Scheme.image_basicOpen (p ⁻¹ᵁ V).ι g
      obtain ⟨hq1, hq2⟩ := hM.1 _ hW' (((p ⁻¹ᵁ V).ι.appIso W).inv g)
      have hle : (p ⁻¹ᵁ V).ι ''ᵁ (p ⁻¹ᵁ V).toScheme.basicOpen g ≤ (p ⁻¹ᵁ V).ι ''ᵁ W :=
        (p ⁻¹ᵁ V).ι.image_mono ((p ⁻¹ᵁ V).toScheme.basicOpen_le g)
      refine ⟨fun s => ?_, fun t ht => ?_⟩
      · obtain ⟨n, t0, hnt⟩ := hq1 (M.presheaf.map (homOfLE hD.ge).op
          ((Scheme.Modules.restrictAppIso (p ⁻¹ᵁ V).ι M _).hom s))
        refine ⟨n, (Scheme.Modules.restrictAppIso (p ⁻¹ᵁ V).ι M W).inv t0, ?_⟩
        have e1 := congrArg (M.presheaf.map (homOfLE hD.le).op) hnt
        rw [Scheme.Modules.map_smul, map_pow, resP', resM', resM', idM'] at e1
        have hgg : ((p ⁻¹ᵁ V).ι.appIso ((p ⁻¹ᵁ V).toScheme.basicOpen g)).inv
            ((p ⁻¹ᵁ V).toScheme.presheaf.map
              (homOfLE ((p ⁻¹ᵁ V).toScheme.basicOpen_le g)).op g) =
            P.presheaf.map (homOfLE hle).op (((p ⁻¹ᵁ V).ι.appIso W).inv g) := by
          rw [hinvC, hinvP]; rfl
        apply injE
        rw [Scheme.Modules.smul_restrictAppIso_hom_apply, map_pow, hgg]
        exact e1
      · have ht' : M.presheaf.map (homOfLE hle).op
            ((Scheme.Modules.restrictAppIso (p ⁻¹ᵁ V).ι M W).hom t) = 0 := ht
        have e0 := resM' M hle hD.ge ((Scheme.Modules.restrictAppIso (p ⁻¹ᵁ V).ι M W).hom t)
        rw [ht', map_zero] at e0
        obtain ⟨n, hn⟩ := hq2 _ e0.symm
        refine ⟨n, ?_⟩
        apply injE
        rw [Scheme.Modules.smul_restrictAppIso_hom_apply, map_pow, map_zero]
        exact hn
    · have hW' := hW.image_of_isOpenImmersion (p ⁻¹ᵁ V).ι
      have hfin := hM.2 _ hW'
      obtain ⟨S, hS⟩ := hfin.fg_top
      have hinvE : ∀ (a : Γ(P, (p ⁻¹ᵁ V).ι ''ᵁ W)) (z : Γ(M, (p ⁻¹ᵁ V).ι ''ᵁ W)),
          (Scheme.Modules.restrictAppIso (p ⁻¹ᵁ V).ι M W).inv (a • z) =
            ((p ⁻¹ᵁ V).ι.appIso W).hom a •
              (Scheme.Modules.restrictAppIso (p ⁻¹ᵁ V).ι M W).inv z := by
        intro a z
        apply injE
        rw [Scheme.Modules.smul_restrictAppIso_hom_apply, Iso.inv_hom_id_apply,
          Iso.inv_hom_id_apply, Iso.hom_inv_id_apply]
      refine ⟨⟨S.image (fun z => (Scheme.Modules.restrictAppIso (p ⁻¹ᵁ V).ι M W).inv z), ?_⟩⟩
      rw [eq_top_iff]
      intro y _
      have key : ∀ z ∈ Submodule.span Γ(P, (p ⁻¹ᵁ V).ι ''ᵁ W) (S : Set Γ(M, (p ⁻¹ᵁ V).ι ''ᵁ W)),
          (Scheme.Modules.restrictAppIso (p ⁻¹ᵁ V).ι M W).inv z ∈
            Submodule.span Γ((p ⁻¹ᵁ V).toScheme, W)
              ((S.image (fun z => (Scheme.Modules.restrictAppIso (p ⁻¹ᵁ V).ι M W).inv z) :
                Finset _) : Set Γ(M.restrict (p ⁻¹ᵁ V).ι, W)) := by
        intro z hz
        induction hz using Submodule.span_induction with
        | mem x hx => exact Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hx))
        | zero => rw [map_zero]; exact Submodule.zero_mem _
        | add x z _ _ hx hz => rw [map_add]; exact Submodule.add_mem _ hx hz
        | smul a x _ hx => rw [hinvE]; exact Submodule.smul_mem _ _ hx
      have := key ((Scheme.Modules.restrictAppIso (p ⁻¹ᵁ V).ι M W).hom y) (by rw [hS]; trivial)
      rwa [Iso.hom_inv_id_apply] at this


  have hAlg : wcCnAlg ((p ∣_ V) ≫ hV.isoSpec.hom) (Ideal.map (wcCnSigma h V) I)
      (fun n => (Gs n).restrict (p ⁻¹ᵁ V).ι)
      (fun n => (Scheme.Modules.restrictFunctor (p ⁻¹ᵁ V).ι).map (ψG n))
      (G.restrict (p ⁻¹ᵁ V).ι)
      (fun n => (Scheme.Modules.restrictFunctor (p ⁻¹ᵁ V).ι).map (φG n)) := by
    refine ⟨hcoh G halg.1, fun n => ?_, fun n W hW => ⟨?_, fun s => ?_⟩⟩
    · beta_reduce
      rw [← Functor.map_comp, halg.2.1 n]
    · exact (halg.2.2 n _ (hW.image_of_isOpenImmersion _)).1
    · have hW' : IsAffineOpen ((p ⁻¹ᵁ V).ι ''ᵁ W) := hW.image_of_isOpenImmersion _
      have compat : ∀ (b : B) (x : Γ(G.restrict (p ⁻¹ᵁ V).ι, W)),
          ConcreteCategory.hom (Scheme.Modules.restrictAppIso (p ⁻¹ᵁ V).ι G W).hom
            (((wcCnSigma ((p ∣_ V) ≫ hV.isoSpec.hom) W).comp (wcCnSigma h V)) b • x) =
          wcCnSigma (p ≫ h) ((p ⁻¹ᵁ V).ι ''ᵁ W) b •
            ConcreteCategory.hom (Scheme.Modules.restrictAppIso (p ⁻¹ᵁ V).ι G W).hom x := by
        intro b x
        rw [Scheme.Modules.smul_restrictAppIso_hom_apply, RingHom.comp_apply]
        congr 1
        exact s1b W b
      rw [← Ideal.map_pow, Ideal.map_map]
      show Scheme.Modules.Hom.app (φG n) ((p ⁻¹ᵁ V).ι ''ᵁ W) s = 0 ↔ _
      refine ((halg.2.2 n _ hW').2 s).trans ⟨fun hs => ?_, fun hs => ?_⟩
      · have compat' : ∀ (b : B) (y : Γ(G, (p ⁻¹ᵁ V).ι ''ᵁ W)),
            ConcreteCategory.hom (Scheme.Modules.restrictAppIso (p ⁻¹ᵁ V).ι G W).inv
              (wcCnSigma (p ≫ h) ((p ⁻¹ᵁ V).ι ''ᵁ W) b • y) =
            ((wcCnSigma ((p ∣_ V) ≫ hV.isoSpec.hom) W).comp (wcCnSigma h V)) b •
              ConcreteCategory.hom (Scheme.Modules.restrictAppIso (p ⁻¹ᵁ V).ι G W).inv y := by
          intro b y
          conv_lhs => rw [← Iso.inv_hom_id_apply (Scheme.Modules.restrictAppIso (p ⁻¹ᵁ V).ι G W) y,
            ← compat]
          exact Iso.hom_inv_id_apply _ _
        rw [← Iso.hom_inv_id_apply (Scheme.Modules.restrictAppIso (p ⁻¹ᵁ V).ι G W) s]
        exact transfer _ _ _ _ _ _ _ compat' _ _ hs
      · exact transfer _ _ _ _ _ _ _ compat _ s hs


  haveI : IsProper (p ∣_ V) := IsZariskiLocalAtTarget.restrict hp V
  have hO : p ⁻¹ᵁ V ≤ (p ⁻¹ᵁ V).ι ''ᵁ ⊤ := (Scheme.Opens.ι_image_top _).ge
  refine ⟨(p ⁻¹ᵁ V).toScheme, (p ∣_ V) ≫ hV.isoSpec.hom,
    fun n => (Gs n).restrict (p ⁻¹ᵁ V).ι,
    fun n => (Scheme.Modules.restrictFunctor (p ⁻¹ᵁ V).ι).map (ψG n),
    G.restrict (p ⁻¹ᵁ V).ι,
    fun n => (Scheme.Modules.restrictFunctor (p ⁻¹ᵁ V).ι).map (φG n),
    (G.presheaf.mapIso (eqToIso (Scheme.Opens.ι_image_top (p ⁻¹ᵁ V)).symm).op).addCommGroupIsoToAddEquiv,
    fun n => ((Gs n).presheaf.mapIso
      (eqToIso (Scheme.Opens.ι_image_top (p ⁻¹ᵁ V)).symm).op).addCommGroupIsoToAddEquiv,
    inferInstance, hAlg, ?_, ?_, ?_⟩
  · intro n x
    exact (natApp (φG n) hO x).symm
  · intro n x
    exact (natApp (ψG n) hO x).symm
  · intro r x
    have e2 := Scheme.Modules.smul_restrictAppIso_hom_apply (p ⁻¹ᵁ V).ι G ⊤
      (wcCnSigma ((p ∣_ V) ≫ hV.isoSpec.hom) ⊤ r) x
    rw [s1aC] at e2
    have e3 := congrArg (G.presheaf.map (homOfLE hO).op) e2
    rw [Scheme.Modules.map_smul, resP, idP] at e3
    exact e3

theorem wc_cn_rml_level_lift_single : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (𝔞 : Ideal A) (X : Scheme.{u}) (f : X ⟶ Spec (.of A)) [IsProper f] (Gs : ℕ → X.Modules) (ψ : ∀ n, Gs (n+1) ⟶ Gs n) (G : X.Modules) (φ : ∀ n, G ⟶ Gs n), wcCnAlg f 𝔞 Gs ψ G φ → ∀ (r : ℕ) (U : Fin r → X.Opens), (∀ i, IsAffineOpen (U i)) → (∀ x : X, ∃ i, x ∈ U i) → (∀ i j, IsAffineOpen (U i ⊓ U j)) → ∃ c : ℕ, ∀ c' : ℕ, c ≤ c' → ∀ (n : ℕ) (y : Γ(Gs (n + c'), ⊤)), ∃ s : Γ(G, ⊤), Scheme.Modules.Hom.app (φ n) ⊤ s = Scheme.Modules.Hom.app (wcCnTrans ψ n c') ⊤ y :=
by
  intro A _ _ 𝔞 X f _ Gs ψ G φ halg r U hUaff hcov hint
  classical
  obtain ⟨Z', pr, ι, π, hfin, h1, h2, h3, h4, h5⟩ := wc_cn_sqzero_relative_spec X G halg.1
  obtain ⟨q, deg, yv, hARM⟩ := wc_cn_cech_artin_rees_module A 𝔞 X f G Z' pr ι π hfin h1 h2 h3
    h4 h5 r U hUaff hcov hint
  obtain ⟨c, hdeg⟩ : ∃ c : ℕ, ∀ l, deg l ≤ c :=
    ⟨Finset.univ.sup deg, fun l => Finset.le_sup (Finset.mem_univ l)⟩
  refine ⟨c, fun c' hc' n yy => ?_⟩
  have hσres : ∀ (W W' : X.Opens) (hle : W' ≤ W) (b : A),
      X.presheaf.map (homOfLE hle).op (wcCnSigma f W b) = wcCnSigma f W' b := by
    intro W W' hle b
    show (X.presheaf.map (homOfLE hle).op) ((X.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op)
      ((f.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom) b)) =
      (X.presheaf.map (homOfLE (le_top : W' ≤ ⊤)).op)
      ((f.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom) b)
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
    rfl
  have hsmulres : ∀ (W W' : X.Opens) (hle : W' ≤ W) (b : A) (z : Γ(G, W)),
      G.presheaf.map (homOfLE hle).op (wcCnSigma f W b • z) =
        wcCnSigma f W' b • G.presheaf.map (homOfLE hle).op z := by
    intro W W' hle b z
    rw [Scheme.Modules.map_smul, hσres]
  have hnat : ∀ (N N' : X.Modules) (g : N ⟶ N') (W W' : X.Opens) (hle : W' ≤ W) (x : Γ(N, W)),
      Scheme.Modules.Hom.app g W' (N.presheaf.map (homOfLE hle).op x) =
        N'.presheaf.map (homOfLE hle).op (Scheme.Modules.Hom.app g W x) :=
    fun N N' g W W' hle x => PresheafOfModules.naturality_apply g.val (homOfLE hle).op x
  have hresres : ∀ (N : X.Modules) (W W' : X.Opens) (hle : W' ≤ W) (v : Γ(N, ⊤)),
      N.presheaf.map (homOfLE hle).op (N.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op v) =
        N.presheaf.map (homOfLE (le_top : W' ≤ ⊤)).op v := by
    intro N W W' hle v
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
    rfl
  have compA : ∀ {M N K : X.Modules} (g : M ⟶ N) (g' : N ⟶ K) (W : X.Opens)
      (x : Γ(M, W)), Scheme.Modules.Hom.app (g ≫ g') W x =
        Scheme.Modules.Hom.app g' W (Scheme.Modules.Hom.app g W x) := by
    intro M N K g g' W x
    rw [Scheme.Modules.Hom.comp_app]
    rfl
  have idA : ∀ (M : X.Modules) (W : X.Opens) (x : Γ(M, W)),
      Scheme.Modules.Hom.app (𝟙 M) W x = x := by
    intro M W x
    rw [Scheme.Modules.Hom.id_app]
    rfl
  have hstep : ∀ (k : ℕ) (W : X.Opens) (x : Γ(G, W)),
      Scheme.Modules.Hom.app (ψ k) W (Scheme.Modules.Hom.app (φ (k + 1)) W x) =
        Scheme.Modules.Hom.app (φ k) W x := by
    intro k W x
    rw [← compA, halg.2.1 k]
  have hTφ : ∀ (W : X.Opens) (k : ℕ) (x : Γ(G, W)),
      Scheme.Modules.Hom.app (wcCnTrans ψ n k) W (Scheme.Modules.Hom.app (φ (n + k)) W x) =
        Scheme.Modules.Hom.app (φ n) W x := by
    intro W k
    induction k with
    | zero =>
      intro x
      show Scheme.Modules.Hom.app (𝟙 (Gs n)) W (Scheme.Modules.Hom.app (φ n) W x) = _
      rw [idA]
    | succ k ih =>
      intro x
      show Scheme.Modules.Hom.app (ψ (n + k) ≫ wcCnTrans ψ n k) W
          (Scheme.Modules.Hom.app (φ (n + k + 1)) W x) = _
      rw [compA, hstep, ih]

  choose x hx using fun i => (halg.2.2 (n + c') (U i) (hUaff i)).1
    ((Gs (n + c')).presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op yy)
  have hloc : ∀ (k : ℕ) (v : Γ(Gs k, ⊤)) (W W' : X.Opens) (hle : W' ≤ W) (u : Γ(G, W)),
      Scheme.Modules.Hom.app (φ k) W u =
        (Gs k).presheaf.map (homOfLE (le_top : W ≤ ⊤)).op v →
      Scheme.Modules.Hom.app (φ k) W' (G.presheaf.map (homOfLE hle).op u) =
        (Gs k).presheaf.map (homOfLE (le_top : W' ≤ ⊤)).op v := by
    intro k v W W' hle u hu
    rw [hnat, hu, hresres]

  have hdx : ∀ p : Fin r × Fin r,
      G.presheaf.map (homOfLE (inf_le_right : U p.1 ⊓ U p.2 ≤ U p.2)).op (x p.2) -
        G.presheaf.map (homOfLE (inf_le_left : U p.1 ⊓ U p.2 ≤ U p.1)).op (x p.1) ∈
      Ideal.map (wcCnSigma f (U p.1 ⊓ U p.2)) (𝔞 ^ (n + c' + 1)) •
        (⊤ : Submodule Γ(X, U p.1 ⊓ U p.2) Γ(G, U p.1 ⊓ U p.2)) := by
    intro p
    refine ((halg.2.2 (n + c') _ (hint p.1 p.2)).2 _).mp ?_
    rw [map_sub, hloc _ _ _ _ _ _ (hx p.2), hloc _ _ _ _ _ _ (hx p.1), sub_self]

  obtain ⟨a, w, ha, hw, hdxeq⟩ := hARM (n + c' + 1) x hdx
  let b : ∀ i : Fin r, Γ(G, U i) := fun i => x i - ∑ l, wcCnSigma f (U i) (a l) • yv l i - w i
  have hcoc : ∀ p : Fin r × Fin r,
      G.presheaf.map (homOfLE (inf_le_right : U p.1 ⊓ U p.2 ≤ U p.2)).op (b p.2) -
        G.presheaf.map (homOfLE (inf_le_left : U p.1 ⊓ U p.2 ≤ U p.1)).op (b p.1) = 0 := by
    intro p
    have key : ∀ (X1 X2 S1 S2 W1 W2 : Γ(G, U p.1 ⊓ U p.2)),
        X2 - X1 = (S2 - S1) + (W2 - W1) → (X2 - S2 - W2) - (X1 - S1 - W1) = 0 := by
      intro X1 X2 S1 S2 W1 W2 he
      have e2 : X2 = X1 + ((S2 - S1) + (W2 - W1)) := by rw [← he]; abel
      rw [e2]; abel
    have e := hdxeq p
    simp only [smul_sub, Finset.sum_sub_distrib] at e
    simp only [b, map_sub, map_sum, hsmulres]
    exact key _ _ _ _ _ _ e
  have hcompat : TopCat.Presheaf.IsCompatible
      (⟨G.presheaf, G.isSheaf⟩ : TopCat.Sheaf Ab X).obj U b := by
    intro i j
    exact (sub_eq_zero.mp (hcoc (i, j))).symm
  have hcov' : (⊤ : X.Opens) ≤ iSup U := by
    intro z _
    rw [TopologicalSpace.Opens.mem_iSup]
    exact hcov z
  obtain ⟨t, ht, -⟩ := TopCat.Sheaf.existsUnique_gluing'
    (⟨G.presheaf, G.isSheaf⟩ : TopCat.Sheaf Ab X) U ⊤ (fun i => homOfLE le_top) hcov' b hcompat
  have ht' : ∀ i, G.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op t = b i := ht

  have hb : ∀ i, Scheme.Modules.Hom.app (φ n) (U i) (b i) =
      (Gs n).presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op
        (Scheme.Modules.Hom.app (wcCnTrans ψ n c') ⊤ yy) := by
    intro i
    have e1 : x i - b i ∈ Ideal.map (wcCnSigma f (U i)) (𝔞 ^ (n + 1)) •
        (⊤ : Submodule Γ(X, U i) Γ(G, U i)) := by
      have e : x i - b i = ∑ l, wcCnSigma f (U i) (a l) • yv l i + w i := by
        simp only [b]; abel
      rw [e]
      refine Submodule.add_mem _ (Submodule.sum_mem _ (fun l _ => ?_)) ?_
      · refine Submodule.smul_mem_smul (Ideal.mem_map_of_mem _ ?_) Submodule.mem_top
        exact Ideal.pow_le_pow_right (by have := hdeg l; omega) (ha l)
      · exact Submodule.smul_mono_left (Ideal.map_mono (Ideal.pow_le_pow_right (by omega))) (hw i)
    have e2 := ((halg.2.2 n (U i) (hUaff i)).2 _).mpr e1
    rw [map_sub, sub_eq_zero] at e2
    rw [← e2, ← hTφ (U i) c' (x i), hx i, hnat]
  refine ⟨t, ?_⟩
  apply TopCat.Sheaf.eq_of_locally_eq' (⟨(Gs n).presheaf, (Gs n).isSheaf⟩ : TopCat.Sheaf Ab X) U ⊤
    (fun i => homOfLE le_top) hcov'
  intro i
  change (Gs n).presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op (Scheme.Modules.Hom.app (φ n) ⊤ t) =
    (Gs n).presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op
      (Scheme.Modules.Hom.app (wcCnTrans ψ n c') ⊤ yy)
  rw [← hnat, ht', hb]

theorem wc_cn_h0ar_rees_glue : ∀ (A : Type u) [CommRing A] (𝔞 : Ideal A) (Y : Scheme.{u}) (g : Y ⟶ Spec (.of A)) (X : Scheme.{u}) (h : X ⟶ Spec (.of (reesAlgebra 𝔞))) (pr : X ⟶ Y) (θ : ∀ W : Y.Opens, IsAffineOpen W → (Γ(X, pr ⁻¹ᵁ W) →+* Polynomial Γ(Y, W))), (∀ (W : Y.Opens) (hW : IsAffineOpen W), Function.Injective (θ W hW)) → (∀ (W : Y.Opens) (hW : IsAffineOpen W) (s : Γ(Y, W)), θ W hW (pr.app W s) = Polynomial.C s) → (∀ (W : Y.Opens) (hW : IsAffineOpen W) (b : reesAlgebra 𝔞), θ W hW (wcCnSigma h (pr ⁻¹ᵁ W) b) = Polynomial.map (wcCnSigma g W) (b : Polynomial A)) → (∀ (W W' : Y.Opens) (hW : IsAffineOpen W) (hW' : IsAffineOpen W') (hle : W' ≤ W) (z : Γ(X, pr ⁻¹ᵁ W)), θ W' hW' (X.presheaf.map (homOfLE (pr.preimage_mono hle)).op z) = Polynomial.map (Y.presheaf.map (homOfLE hle).op).hom (θ W hW z)) → ∀ (r : ℕ) (V : Fin r → Y.Opens) (hV : ∀ i, IsAffineOpen (V i)), (∀ x : Y, ∃ i, x ∈ V i) → (∀ i j, IsAffineOpen (V i ⊓ V j)) → (∀ i (b : reesAlgebra 𝔞), θ (V i) (hV i) (X.presheaf.map (homOfLE (le_top : pr ⁻¹ᵁ V i ≤ ⊤)).op (wcCnSigma h ⊤ b)) = Polynomial.map (wcCnSigma g (V i)) (b : Polynomial A)) ∧ (∀ (N : ℕ) (S : Γ(Y, ⊤)), (∀ i, (Y.presheaf.map (homOfLE (le_top : V i ≤ ⊤)).op).hom S ∈ Ideal.map (wcCnSigma g (V i)) (𝔞 ^ N)) → ∃ S' : Γ(X, ⊤), ∀ i, θ (V i) (hV i) (X.presheaf.map (homOfLE (le_top : pr ⁻¹ᵁ V i ≤ ⊤)).op S') = Polynomial.C ((Y.presheaf.map (homOfLE (le_top : V i ≤ ⊤)).op).hom S) * Polynomial.X ^ N) ∧ (∀ (z : Γ(X, ⊤)) (j : ℕ), ∃ E : Γ(Y, ⊤), ∀ i, (Y.presheaf.map (homOfLE (le_top : V i ≤ ⊤)).op).hom E = (θ (V i) (hV i) (X.presheaf.map (homOfLE (le_top : pr ⁻¹ᵁ V i ≤ ⊤)).op z)).coeff j) :=
by
  intro A _ 𝔞 Y g X h pr θ hinj hC hmap hnat r V hV hcov hVV
  classical

  have resR : ∀ (Z : Scheme.{u}) (W W' W'' : Z.Opens) (h1 : W' ≤ W) (h2 : W'' ≤ W')
      (x : Γ(Z, W)), (Z.presheaf.map (homOfLE h2).op).hom ((Z.presheaf.map (homOfLE h1).op).hom x) =
        (Z.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro Z W W' W'' h1 h2 x
    change (Z.presheaf.map (homOfLE h1).op ≫ Z.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    rfl
  have resR' : ∀ (Z : Scheme.{u}) (W W' W'' : Z.Opens) (h1 : W' ≤ W) (h2 : W'' ≤ W')
      (x : Γ(Z, W)), Z.presheaf.map (homOfLE h2).op (Z.presheaf.map (homOfLE h1).op x) =
        Z.presheaf.map (homOfLE (h2.trans h1)).op x := by
    intro Z W W' W'' h1 h2 x
    change (Z.presheaf.map (homOfLE h1).op ≫ Z.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    rfl

  have glue : ∀ (Z : Scheme.{u}) (U : Fin r → Z.Opens), (∀ x : Z, ∃ i, x ∈ U i) →
      ∀ (s : ∀ i, Γ(Z, U i)), (∀ i j,
        (Z.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op).hom (s i) =
        (Z.presheaf.map (homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).op).hom (s j)) →
      ∃ S : Γ(Z, ⊤), ∀ i, (Z.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op).hom S = s i := by
    intro Z U hU s hs
    have hcov' : (⊤ : Z.Opens) ≤ iSup U := fun x _ =>
      TopologicalSpace.Opens.mem_iSup.mpr (hU x)
    obtain ⟨S, hS, -⟩ := TopCat.Sheaf.existsUnique_gluing' Z.sheaf U ⊤
      (fun i => homOfLE le_top) hcov' s (by
        intro i j
        exact hs i j)
    exact ⟨S, hS⟩

  have lift : ∀ i (N : ℕ) (e : Γ(Y, V i)), e ∈ Ideal.map (wcCnSigma g (V i)) (𝔞 ^ N) →
      ∃ z : Γ(X, pr ⁻¹ᵁ V i), θ (V i) (hV i) z = Polynomial.C e * Polynomial.X ^ N := by
    intro i N e he
    have he' : e ∈ Submodule.span Γ(Y, V i) (⇑(wcCnSigma g (V i)) '' ↑(𝔞 ^ N)) := he
    clear he
    induction he' using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨a, ha, rfl⟩ := hx
      refine ⟨wcCnSigma h (pr ⁻¹ᵁ V i)
        ⟨Polynomial.monomial N a, reesAlgebra.monomial_mem.mpr ha⟩, ?_⟩
      rw [hmap]
      simp [Polynomial.map_monomial, Polynomial.C_mul_X_pow_eq_monomial]
    | zero => exact ⟨0, by simp⟩
    | add x y _ _ hx hy =>
      obtain ⟨z1, hz1⟩ := hx
      obtain ⟨z2, hz2⟩ := hy
      exact ⟨z1 + z2, by rw [map_add, hz1, hz2, Polynomial.C_add, add_mul]⟩
    | smul c x _ hx =>
      obtain ⟨z, hz⟩ := hx
      refine ⟨pr.app (V i) c * z, ?_⟩
      rw [map_mul, hC, hz, smul_eq_mul, Polynomial.C_mul, mul_assoc]

  have sigR : ∀ i (b : reesAlgebra 𝔞),
      X.presheaf.map (homOfLE (le_top : pr ⁻¹ᵁ V i ≤ ⊤)).op (wcCnSigma h ⊤ b) =
        wcCnSigma h (pr ⁻¹ᵁ V i) b := by
    intro i b
    change (X.presheaf.map (homOfLE (le_top : (⊤ : X.Opens) ≤ ⊤)).op ≫
      X.presheaf.map (homOfLE (le_top : pr ⁻¹ᵁ V i ≤ ⊤)).op).hom _ = _
    rw [← Functor.map_comp]
    rfl
  refine ⟨fun i b => by rw [sigR]; exact hmap (V i) (hV i) b, ?_, ?_⟩
  · intro N S hS
    choose z hz using fun i => lift i N _ (hS i)
    have hcompat : ∀ i j,
        (X.presheaf.map (homOfLE (inf_le_left : pr ⁻¹ᵁ V i ⊓ pr ⁻¹ᵁ V j ≤ pr ⁻¹ᵁ V i)).op).hom
          (z i) =
        (X.presheaf.map (homOfLE (inf_le_right : pr ⁻¹ᵁ V i ⊓ pr ⁻¹ᵁ V j ≤ pr ⁻¹ᵁ V j)).op).hom
          (z j) := by
      intro i j
      apply hinj (V i ⊓ V j) (hVV i j)
      have e1 := hnat (V i) (V i ⊓ V j) (hV i) (hVV i j) inf_le_left (z i)
      have e2 := hnat (V j) (V i ⊓ V j) (hV j) (hVV i j) inf_le_right (z j)
      refine e1.trans (Eq.trans ?_ e2.symm)
      rw [hz i, hz j]
      simp only [Polynomial.map_mul, Polynomial.map_C, Polynomial.map_pow, Polynomial.map_X]
      rw [resR, resR]
    obtain ⟨S', hS'⟩ := glue X (fun i => pr ⁻¹ᵁ V i) (fun x => hcov (pr x)) z hcompat
    refine ⟨S', fun i => ?_⟩
    rw [show X.presheaf.map (homOfLE (le_top : pr ⁻¹ᵁ V i ≤ ⊤)).op S' = z i from hS' i]
    exact hz i
  · intro z j
    have hcompat : ∀ i k,
        (Y.presheaf.map (homOfLE (inf_le_left : V i ⊓ V k ≤ V i)).op).hom
          ((θ (V i) (hV i) (X.presheaf.map (homOfLE (le_top : pr ⁻¹ᵁ V i ≤ ⊤)).op z)).coeff j) =
        (Y.presheaf.map (homOfLE (inf_le_right : V i ⊓ V k ≤ V k)).op).hom
          ((θ (V k) (hV k) (X.presheaf.map (homOfLE (le_top : pr ⁻¹ᵁ V k ≤ ⊤)).op z)).coeff j) := by
      intro i k
      rw [← Polynomial.coeff_map (Y.presheaf.map (homOfLE (inf_le_left : V i ⊓ V k ≤ V i)).op).hom,
        ← Polynomial.coeff_map (Y.presheaf.map (homOfLE (inf_le_right : V i ⊓ V k ≤ V k)).op).hom,
        ← hnat (V i) (V i ⊓ V k) (hV i) (hVV i k) inf_le_left,
        ← hnat (V k) (V i ⊓ V k) (hV k) (hVV i k) inf_le_right, resR', resR']
    obtain ⟨E, hE⟩ := glue Y V hcov _ hcompat
    exact ⟨E, hE⟩

theorem wc_cn_h0ar_coeff_bound : ∀ (A : Type u) [CommRing A] (𝔞 : Ideal A) (Y : Scheme.{u}) (g : Y ⟶ Spec (.of A)) (r : ℕ) (V : Fin r → Y.Opens) (T : Type u) [CommRing T] (ρ : reesAlgebra 𝔞 →+* T) (θ : ∀ i, T →+* Polynomial Γ(Y, V i)), (∀ x : Y, ∃ i, x ∈ V i) → (∀ i (b : reesAlgebra 𝔞), θ i (ρ b) = Polynomial.map (wcCnSigma g (V i)) (b : Polynomial A)) → (∀ (N : ℕ) (S : Γ(Y, ⊤)), (∀ i, (Y.presheaf.map (homOfLE (le_top : V i ≤ ⊤)).op).hom S ∈ Ideal.map (wcCnSigma g (V i)) (𝔞 ^ N)) → ∃ S' : T, ∀ i, θ i S' = Polynomial.C ((Y.presheaf.map (homOfLE (le_top : V i ≤ ⊤)).op).hom S) * Polynomial.X ^ N) → (∀ (z : T) (j : ℕ), ∃ E : Γ(Y, ⊤), ∀ i, (Y.presheaf.map (homOfLE (le_top : V i ≤ ⊤)).op).hom E = (θ i z).coeff j) → (∃ (k : ℕ) (z : Fin k → T), ∀ s : T, ∃ b : Fin k → reesAlgebra 𝔞, s = ∑ l, ρ (b l) * z l) → ∃ c : ℕ, ∀ (n : ℕ) (S : Γ(Y, ⊤)), (∀ i, (Y.presheaf.map (homOfLE (le_top : V i ≤ ⊤)).op).hom S ∈ Ideal.map (wcCnSigma g (V i)) (𝔞 ^ (n + c))) → ∃ (k : ℕ) (a : Fin k → A) (x : Fin k → Γ(Y, ⊤)), (∀ l, a l ∈ 𝔞 ^ n) ∧ S = ∑ l, wcCnSigma g ⊤ (a l) * x l :=
by
  intro A _ 𝔞 Y g r V T _ ρ θ hcov hρ hlift hcoef hgen
  classical

  have s1 : ∀ (R : Type u) [CommRing R] (σ : A →+* R) (k c N : ℕ) (b : Fin k → Polynomial A)
      (P : Fin k → Polynomial R) (s : R), c ≤ N → (∀ l, (P l).natDegree ≤ c) →
      Polynomial.C s * Polynomial.X ^ N = ∑ l, Polynomial.map σ (b l) * P l →
      s = ∑ l, ∑ j ∈ Finset.range (c + 1), σ ((b l).coeff (N - j)) * (P l).coeff j := by
    intro R _ σ k c N b P s hcN hP h
    have h2 : (Polynomial.C s * Polynomial.X ^ N).coeff N =
        (∑ l, Polynomial.map σ (b l) * P l).coeff N := by rw [h]
    rw [Polynomial.coeff_C_mul_X_pow, if_pos rfl, Polynomial.finset_sum_coeff] at h2
    rw [h2]
    refine Finset.sum_congr rfl (fun l _ => ?_)
    rw [mul_comm (Polynomial.map σ (b l)), Polynomial.coeff_mul,
      Finset.Nat.sum_antidiagonal_eq_sum_range_succ
        (fun i j => (P l).coeff i * (Polynomial.map σ (b l)).coeff j) N]
    have hzero : ∀ x ∈ Finset.range N.succ, x ∉ Finset.range (c + 1) →
        (P l).coeff x * (Polynomial.map σ (b l)).coeff (N - x) = 0 := by
      intro j _ hj
      have hlt : (P l).natDegree < j := by
        rw [Finset.mem_range] at hj
        have := hP l
        omega
      rw [Polynomial.coeff_eq_zero_of_natDegree_lt hlt, zero_mul]
    rw [← Finset.sum_subset (fun x hx => by
      rw [Finset.mem_range] at hx ⊢
      omega) hzero]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [Polynomial.coeff_map, mul_comm]

  have s2 : ∀ (W : Y.Opens) (a : A),
      (Y.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom (wcCnSigma g ⊤ a) = wcCnSigma g W a := by
    intro W a
    change (Y.presheaf.map (homOfLE (le_top : (⊤ : Y.Opens) ≤ ⊤)).op ≫
      Y.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom _ = _
    rw [← Functor.map_comp]
    rfl

  have s3 : ∀ (s t : Γ(Y, ⊤)), (∀ i, (Y.presheaf.map (homOfLE (le_top : V i ≤ ⊤)).op).hom s =
      (Y.presheaf.map (homOfLE (le_top : V i ≤ ⊤)).op).hom t) → s = t := by
    intro s t h
    refine TopCat.Sheaf.eq_of_locally_eq' Y.sheaf V ⊤ (fun i => homOfLE le_top) ?_ s t h
    intro x _
    obtain ⟨i, hi⟩ := hcov x
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨i, hi⟩
  obtain ⟨k, z, hz⟩ := hgen
  choose E hE using hcoef
  have hdeg : ∀ i l, (θ i (z l)).natDegree ≤
      Finset.univ.sup (fun p : Fin r × Fin k => (θ p.1 (z p.2)).natDegree) := fun i l =>
    Finset.le_sup (f := fun p : Fin r × Fin k => (θ p.1 (z p.2)).natDegree)
      (Finset.mem_univ (i, l))
  generalize Finset.univ.sup (fun p : Fin r × Fin k => (θ p.1 (z p.2)).natDegree) = c at hdeg
  refine ⟨c, fun n S hS => ?_⟩
  obtain ⟨S', hS'⟩ := hlift (n + c) S hS
  obtain ⟨b, hb⟩ := hz S'
  have hstar : ∀ i, (Y.presheaf.map (homOfLE (le_top : V i ≤ ⊤)).op).hom S =
      ∑ l, ∑ j ∈ Finset.range (c + 1),
        wcCnSigma g (V i) (((b l : Polynomial A)).coeff (n + c - j)) * (θ i (z l)).coeff j := by
    intro i
    apply s1 Γ(Y, V i) (wcCnSigma g (V i)) k c (n + c) (fun l => ((b l : Polynomial A)))
      (fun l => θ i (z l)) _ (Nat.le_add_left c n) (hdeg i)
    rw [← hS' i, hb, map_sum]
    refine Finset.sum_congr rfl (fun l _ => ?_)
    rw [map_mul, hρ]
  have hSeq : S = ∑ l, ∑ j ∈ Finset.range (c + 1),
      wcCnSigma g ⊤ (((b l : Polynomial A)).coeff (n + c - j)) * E (z l) j := by
    apply s3
    intro i
    rw [hstar i, map_sum]
    refine Finset.sum_congr rfl (fun l _ => ?_)
    rw [map_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [map_mul, s2, hE]
  refine ⟨k * (c + 1),
    fun m => ((b (finProdFinEquiv.symm m).1 : Polynomial A)).coeff
      (n + c - ((finProdFinEquiv.symm m).2 : ℕ)),
    fun m => E (z (finProdFinEquiv.symm m).1) ((finProdFinEquiv.symm m).2 : ℕ), ?_, ?_⟩
  · intro m
    have hj := (finProdFinEquiv.symm m).2.isLt
    exact Ideal.pow_le_pow_right (by omega : n ≤ n + c - ((finProdFinEquiv.symm m).2 : ℕ))
      ((mem_reesAlgebra_iff 𝔞 _).mp (b (finProdFinEquiv.symm m).1).2 _)
  · rw [hSeq]
    calc _ = ∑ l, ∑ j : Fin (c + 1),
          wcCnSigma g ⊤ (((b l : Polynomial A)).coeff (n + c - (j : ℕ))) * E (z l) (j : ℕ) :=
          Finset.sum_congr rfl (fun l _ => (Fin.sum_univ_eq_sum_range
            (fun j => wcCnSigma g ⊤ (((b l : Polynomial A)).coeff (n + c - j)) * E (z l) j)
            (c + 1)).symm)
      _ = ∑ p : Fin k × Fin (c + 1),
          wcCnSigma g ⊤ (((b p.1 : Polynomial A)).coeff (n + c - (p.2 : ℕ))) * E (z p.1) (p.2 : ℕ) :=
          (Fintype.sum_prod_type' (fun l (j : Fin (c + 1)) =>
            wcCnSigma g ⊤ (((b l : Polynomial A)).coeff (n + c - (j : ℕ))) * E (z l) (j : ℕ))).symm
      _ = _ := (Equiv.sum_comp finProdFinEquiv.symm (fun p : Fin k × Fin (c + 1) =>
            wcCnSigma g ⊤ (((b p.1 : Polynomial A)).coeff (n + c - (p.2 : ℕ))) *
              E (z p.1) (p.2 : ℕ))).symm

theorem wc_cn_h0ar_sqzero_transfer : ∀ (A : Type u) [CommRing A] (𝔞 : Ideal A) (X : Scheme.{u}) (f : X ⟶ Spec (.of A)) (M : X.Modules) (Z' : Scheme.{u}) (pr : Z' ⟶ X) (ι : ∀ U : X.Opens, IsAffineOpen U → (Γ(M, U) →+ Γ(Z', pr ⁻¹ᵁ U))) (π : ∀ U : X.Opens, IsAffineOpen U → (Γ(Z', pr ⁻¹ᵁ U) →+ Γ(M, U))), (∀ (U : X.Opens) (hU : IsAffineOpen U) (m : Γ(M, U)), π U hU (ι U hU m) = m) → (∀ (U : X.Opens) (hU : IsAffineOpen U) (c : Γ(X, U)) (m : Γ(M, U)), ι U hU (c • m) = pr.app U c * ι U hU m) → (∀ (U : X.Opens) (hU : IsAffineOpen U) (c : Γ(X, U)) (y : Γ(Z', pr ⁻¹ᵁ U)), π U hU (pr.app U c * y) = c • π U hU y) → (∀ (U U' : X.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (hle : U' ≤ U) (m : Γ(M, U)), ι U' hU' (M.presheaf.map (homOfLE hle).op m) = Z'.presheaf.map (homOfLE (pr.preimage_mono hle)).op (ι U hU m)) → (∀ (U U' : X.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (hle : U' ≤ U) (y : Γ(Z', pr ⁻¹ᵁ U)), π U' hU' (Z'.presheaf.map (homOfLE (pr.preimage_mono hle)).op y) = M.presheaf.map (homOfLE hle).op (π U hU y)) → ∀ (r : ℕ) (U : Fin r → X.Opens), (∀ i, IsAffineOpen (U i)) → (∀ x : X, ∃ i, x ∈ U i) → (∀ i j, IsAffineOpen (U i ⊓ U j)) → ∀ c : ℕ, (∀ (n : ℕ) (S : Γ(Z', ⊤)), (∀ i, (Z'.presheaf.map (homOfLE (le_top : pr ⁻¹ᵁ U i ≤ ⊤)).op).hom S ∈ Ideal.map (wcCnSigma (pr ≫ f) (pr ⁻¹ᵁ U i)) (𝔞 ^ (n + c))) → ∃ (k : ℕ) (a : Fin k → A) (x : Fin k → Γ(Z', ⊤)), (∀ l, a l ∈ 𝔞 ^ n) ∧ S = ∑ l, wcCnSigma (pr ≫ f) ⊤ (a l) * x l) → ∀ (n : ℕ) (s : Γ(M, ⊤)), (∀ i, (M.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op).hom s ∈ Ideal.map (wcCnSigma f (U i)) (𝔞 ^ (n + c)) • (⊤ : Submodule Γ(X, U i) Γ(M, U i))) → ∃ (k : ℕ) (a : Fin k → A) (x : Fin k → Γ(M, ⊤)), (∀ l, a l ∈ 𝔞 ^ n) ∧ s = ∑ l, wcCnSigma f ⊤ (a l) • x l :=
by
  intro A _ 𝔞 X f M Z' pr ι π h1 h2 h3 h4 h5 r U hU hcov hUU c hring n s hs

  have s4 : ∀ (V : X.Opens) (b : A),
      wcCnSigma (pr ≫ f) (pr ⁻¹ᵁ V) b = pr.app V (wcCnSigma f V b) := by
    intro V b
    have e : X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op ≫ pr.app V =
        pr.appTop ≫ Z'.presheaf.map (homOfLE (le_top : pr ⁻¹ᵁ V ≤ ⊤)).op := by
      rw [Scheme.Hom.naturality]; rfl
    have e2 := congrArg (fun φ => φ.hom (f.appTop.hom ((Scheme.ΓSpecIso (.of A)).inv.hom b))) e
    show (Z'.presheaf.map (homOfLE (le_top : pr ⁻¹ᵁ V ≤ ⊤)).op).hom
        ((pr ≫ f).appTop.hom ((Scheme.ΓSpecIso (.of A)).inv.hom b)) =
      (pr.app V).hom ((X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom
        (f.appTop.hom ((Scheme.ΓSpecIso (.of A)).inv.hom b)))
    rw [Scheme.Hom.comp_appTop]
    exact e2.symm
  have hσ : ∀ V : X.Opens, wcCnSigma (pr ≫ f) (pr ⁻¹ᵁ V) = (pr.app V).hom.comp (wcCnSigma f V) :=
    fun V => RingHom.ext (fun b => s4 V b)

  have sres : ∀ (Y : Scheme.{u}) (g : Y ⟶ Spec (.of A)) (W : Y.Opens) (a : A),
      (Y.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom (wcCnSigma g ⊤ a) = wcCnSigma g W a := by
    intro Y g W a
    change (Y.presheaf.map (homOfLE (le_top : (⊤ : Y.Opens) ≤ ⊤)).op ≫
      Y.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom _ = _
    rw [← Functor.map_comp]
    rfl

  have s2 : ∀ (R R' : Type u) [CommRing R] [CommRing R'] (φ : R →+* R') (σ : A →+* R)
      (J : Ideal A) (N : Type u) [AddCommGroup N] [Module R N] (ι₀ : N →+ R'),
      (∀ (c : R) (m : N), ι₀ (c • m) = φ c * ι₀ m) → ∀ m : N,
      m ∈ Ideal.map σ J • (⊤ : Submodule R N) → ι₀ m ∈ Ideal.map (φ.comp σ) J := by
    intro R R' _ _ φ σ J N _ _ ι₀ hι m hm
    refine Submodule.smul_induction_on (p := fun m => ι₀ m ∈ Ideal.map (φ.comp σ) J) hm ?_ ?_
    · intro c hc n _
      show ι₀ (c • n) ∈ Ideal.map (φ.comp σ) J
      rw [hι]
      refine Ideal.mul_mem_right _ _ ?_
      have := Ideal.mem_map_of_mem φ hc
      rwa [Ideal.map_map] at this
    · intro a b ha hb
      show ι₀ (a + b) ∈ Ideal.map (φ.comp σ) J
      rw [map_add]
      exact Ideal.add_mem _ ha hb

  have resM : ∀ {V W W' : X.Opens} (ha : W ≤ V) (hb : W' ≤ W) (m : Γ(M, V)),
      (M.presheaf.map (homOfLE hb).op).hom ((M.presheaf.map (homOfLE ha).op).hom m) =
        (M.presheaf.map (homOfLE (hb.trans ha)).op).hom m := by
    intro V W W' ha hb m
    change (M.presheaf.map (homOfLE ha).op ≫ M.presheaf.map (homOfLE hb).op).hom m = _
    rw [← Functor.map_comp]
    rfl
  have resZ : ∀ {V W W' : Z'.Opens} (ha : W ≤ V) (hb : W' ≤ W) (m : Γ(Z', V)),
      (Z'.presheaf.map (homOfLE hb).op).hom ((Z'.presheaf.map (homOfLE ha).op).hom m) =
        (Z'.presheaf.map (homOfLE (hb.trans ha)).op).hom m := by
    intro V W W' ha hb m
    change (Z'.presheaf.map (homOfLE ha).op ≫ Z'.presheaf.map (homOfLE hb).op).hom m = _
    rw [← Functor.map_comp]
    rfl

  have hcovX : (⊤ : X.Opens) ≤ iSup U := by
    intro x _
    exact TopologicalSpace.Opens.mem_iSup.mpr (hcov x)
  have hcovZ : (⊤ : Z'.Opens) ≤ iSup (fun i => pr ⁻¹ᵁ U i) := by
    intro z _
    obtain ⟨i, hi⟩ := hcov (pr z)
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨i, hi⟩

  have hcompS : TopCat.Presheaf.IsCompatible Z'.sheaf.obj (fun i => pr ⁻¹ᵁ U i)
      (fun i => ι (U i) (hU i) ((M.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op).hom s)) := by
    intro i j
    have ei := h4 (U i) (U i ⊓ U j) (hU i) (hUU i j) inf_le_left
      ((M.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op).hom s)
    have ej := h4 (U j) (U i ⊓ U j) (hU j) (hUU i j) inf_le_right
      ((M.presheaf.map (homOfLE (le_top : U j ≤ ⊤)).op).hom s)
    have mi := resM (le_top : U i ≤ ⊤) (inf_le_left : U i ⊓ U j ≤ U i) s
    have mj := resM (le_top : U j ≤ ⊤) (inf_le_right : U i ⊓ U j ≤ U j) s
    exact (ei.symm.trans (congrArg (ι (U i ⊓ U j) (hUU i j)) mi)).trans
      ((congrArg (ι (U i ⊓ U j) (hUU i j)) mj).symm.trans ej)
  obtain ⟨S, hS, -⟩ := TopCat.Sheaf.existsUnique_gluing' Z'.sheaf (fun i => pr ⁻¹ᵁ U i) ⊤
    (fun i => homOfLE le_top) hcovZ _ hcompS

  have hhyp : ∀ i, (Z'.presheaf.map (homOfLE (le_top : pr ⁻¹ᵁ U i ≤ ⊤)).op).hom S ∈
      Ideal.map (wcCnSigma (pr ≫ f) (pr ⁻¹ᵁ U i)) (𝔞 ^ (n + c)) := by
    intro i
    have := s2 _ _ (pr.app (U i)).hom (wcCnSigma f (U i)) (𝔞 ^ (n + c)) _ (ι (U i) (hU i))
      (fun c m => h2 _ _ c m) _ (hs i)
    rw [← hσ] at this
    have e : (Z'.presheaf.map (homOfLE (le_top : pr ⁻¹ᵁ U i ≤ ⊤)).op).hom S =
        ι (U i) (hU i) ((M.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op).hom s) := hS i
    rw [e]
    exact this

  obtain ⟨k, a, x, ha, hSx⟩ := hring n S hhyp

  have glueπ : ∀ y : Γ(Z', ⊤), ∃ x' : Γ(M, ⊤), ∀ i,
      (M.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op).hom x' =
        π (U i) (hU i) ((Z'.presheaf.map (homOfLE (le_top : pr ⁻¹ᵁ U i ≤ ⊤)).op).hom y) := by
    intro y
    have hcomp : TopCat.Presheaf.IsCompatible (⟨M.presheaf, M.isSheaf⟩ : TopCat.Sheaf Ab X).obj U
        (fun i => π (U i) (hU i) ((Z'.presheaf.map (homOfLE (le_top : pr ⁻¹ᵁ U i ≤ ⊤)).op).hom y)) := by
      intro i j
      have ei := h5 (U i) (U i ⊓ U j) (hU i) (hUU i j) inf_le_left
        ((Z'.presheaf.map (homOfLE (le_top : pr ⁻¹ᵁ U i ≤ ⊤)).op).hom y)
      have ej := h5 (U j) (U i ⊓ U j) (hU j) (hUU i j) inf_le_right
        ((Z'.presheaf.map (homOfLE (le_top : pr ⁻¹ᵁ U j ≤ ⊤)).op).hom y)
      have zi := resZ (le_top : pr ⁻¹ᵁ U i ≤ ⊤)
        (pr.preimage_mono (inf_le_left : U i ⊓ U j ≤ U i)) y
      have zj := resZ (le_top : pr ⁻¹ᵁ U j ≤ ⊤)
        (pr.preimage_mono (inf_le_right : U i ⊓ U j ≤ U j)) y
      exact (ei.symm.trans (congrArg (π (U i ⊓ U j) (hUU i j)) zi)).trans
        ((congrArg (π (U i ⊓ U j) (hUU i j)) zj).symm.trans ej)
    obtain ⟨x', hx', -⟩ := TopCat.Sheaf.existsUnique_gluing'
      (⟨M.presheaf, M.isSheaf⟩ : TopCat.Sheaf Ab X) U ⊤ (fun i => homOfLE le_top) hcovX _ hcomp
    exact ⟨x', hx'⟩
  choose x' hx' using fun l => glueπ (x l)

  refine ⟨k, a, x', ha, ?_⟩
  refine TopCat.Sheaf.eq_of_locally_eq' (⟨M.presheaf, M.isSheaf⟩ : TopCat.Sheaf Ab X) U ⊤
    (fun i => homOfLE le_top) hcovX _ _ (fun i => ?_)
  change (M.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op).hom s =
    (M.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op).hom (∑ l, wcCnSigma f ⊤ (a l) • x' l)
  have hL : (M.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op).hom s =
      ∑ l, wcCnSigma f (U i) (a l) •
        π (U i) (hU i) ((Z'.presheaf.map (homOfLE (le_top : pr ⁻¹ᵁ U i ≤ ⊤)).op).hom (x l)) := by
    have e1 : (Z'.presheaf.map (homOfLE (le_top : pr ⁻¹ᵁ U i ≤ ⊤)).op).hom S =
        ι (U i) (hU i) ((M.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op).hom s) := hS i
    rw [← h1 (U i) (hU i) ((M.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op).hom s), ← e1, hSx,
      map_sum, map_sum]
    refine Finset.sum_congr rfl (fun l _ => ?_)
    rw [map_mul, sres Z' (pr ≫ f) (pr ⁻¹ᵁ U i) (a l), s4]
    exact h3 (U i) (hU i) _ _
  have hR : ∀ l, (M.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op).hom (wcCnSigma f ⊤ (a l) • x' l) =
      wcCnSigma f (U i) (a l) •
        π (U i) (hU i) ((Z'.presheaf.map (homOfLE (le_top : pr ⁻¹ᵁ U i ≤ ⊤)).op).hom (x l)) := by
    intro l
    rw [show (M.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op).hom (wcCnSigma f ⊤ (a l) • x' l) =
        (X.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op).hom (wcCnSigma f ⊤ (a l)) •
          (M.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op).hom (x' l) from
        Scheme.Modules.map_smul M _ _ _]
    rw [sres X f (U i) (a l), hx' l i]
  rw [hL, map_sum]
  exact Finset.sum_congr rfl (fun l _ => (hR l).symm)

theorem wc_cn_rml_h0_artin_rees : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (𝔞 : Ideal A) (X : Scheme.{u}) (f : X ⟶ Spec (.of A)) [IsProper f] (M : X.Modules), wcCoherentMod M → ∀ (r : ℕ) (U : Fin r → X.Opens), (∀ i, IsAffineOpen (U i)) → (∀ x : X, ∃ i, x ∈ U i) → (∀ i j, IsAffineOpen (U i ⊓ U j)) → ∃ c : ℕ, ∀ (n : ℕ) (s : Γ(M, ⊤)), (∀ i, (M.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op).hom s ∈ Ideal.map (wcCnSigma f (U i)) (𝔞 ^ (n + c)) • (⊤ : Submodule Γ(X, U i) Γ(M, U i))) → ∃ (k : ℕ) (a : Fin k → A) (x : Fin k → Γ(M, ⊤)), (∀ l, a l ∈ 𝔞 ^ n) ∧ s = ∑ l, wcCnSigma f ⊤ (a l) • x l :=
by
  intro A _ _ 𝔞 X f _ M hM r U hU hcov hUU

  obtain ⟨Z', pr, ι, π, hfin, h1, h2, h3, h4, h5⟩ := wc_cn_sqzero_relative_spec X M hM
  haveI := hfin
  haveI : IsProper (pr ≫ f) := inferInstance

  have hV : ∀ i, IsAffineOpen (pr ⁻¹ᵁ U i) := fun i => (hU i).preimage pr
  have hVcov : ∀ z : Z', ∃ i, z ∈ pr ⁻¹ᵁ U i := fun z => hcov (pr z)
  have hVV : ∀ i j, IsAffineOpen (pr ⁻¹ᵁ U i ⊓ pr ⁻¹ᵁ U j) := fun i j => (hUU i j).preimage pr

  obtain ⟨XR, h, prR, hhp, hpaff, hchart⟩ := wc_rees_chart_model A 𝔞 Z' (pr ≫ f)
  haveI := hhp
  choose θ hinj hC hmap hgen using hchart

  have hC' : ∀ (W : Z'.Opens) (hW : IsAffineOpen W) (s : Γ(Z', W)),
      θ W hW ((prR.app W).hom s) = Polynomial.C s := hC
  have hmap' : ∀ (W : Z'.Opens) (hW : IsAffineOpen W) (b : reesAlgebra 𝔞),
      θ W hW (wcCnSigma h (prR ⁻¹ᵁ W) b) = Polynomial.map (wcCnSigma (pr ≫ f) W) (b : Polynomial A) :=
    hmap
  have hnat : ∀ (W W' : Z'.Opens) (hW : IsAffineOpen W) (hW' : IsAffineOpen W') (hle : W' ≤ W)
      (z : Γ(XR, prR ⁻¹ᵁ W)), θ W' hW' (XR.presheaf.map (homOfLE (prR.preimage_mono hle)).op z) =
        Polynomial.map (Z'.presheaf.map (homOfLE hle).op).hom (θ W hW z) := by
    intro W W' hW hW' hle z
    have key : Set.EqOn
        ((θ W' hW').comp (XR.presheaf.map (homOfLE (prR.preimage_mono hle)).op).hom)
        ((Polynomial.mapRingHom (Z'.presheaf.map (homOfLE hle).op).hom).comp (θ W hW))
        (Subring.closure (Set.range (prR.app W).hom ∪ Set.range (wcCnSigma h (prR ⁻¹ᵁ W)))) := by
      apply RingHom.eqOn_set_closure
      rintro _ (⟨s, rfl⟩ | ⟨b, rfl⟩)
      · have e : (XR.presheaf.map (homOfLE (prR.preimage_mono hle)).op).hom ((prR.app W).hom s) =
            (prR.app W').hom ((Z'.presheaf.map (homOfLE hle).op).hom s) :=
          (congrArg (fun φ => φ.hom s) (Scheme.Hom.naturality prR (homOfLE hle).op)).symm
        show θ W' hW' ((XR.presheaf.map (homOfLE (prR.preimage_mono hle)).op).hom
            ((prR.app W).hom s)) =
          Polynomial.map (Z'.presheaf.map (homOfLE hle).op).hom (θ W hW ((prR.app W).hom s))
        rw [e, hC', hC', Polynomial.map_C]
      · have e : (XR.presheaf.map (homOfLE (prR.preimage_mono hle)).op).hom
            (wcCnSigma h (prR ⁻¹ᵁ W) b) = wcCnSigma h (prR ⁻¹ᵁ W') b := by
          change (XR.presheaf.map (homOfLE (le_top : prR ⁻¹ᵁ W ≤ ⊤)).op ≫
            XR.presheaf.map (homOfLE (prR.preimage_mono hle)).op).hom _ = _
          rw [← Functor.map_comp]
          rfl
        have e2 : (Z'.presheaf.map (homOfLE hle).op).hom.comp (wcCnSigma (pr ≫ f) W) =
            wcCnSigma (pr ≫ f) W' := by
          ext a
          change (Z'.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op ≫
            Z'.presheaf.map (homOfLE hle).op).hom _ = _
          rw [← Functor.map_comp]
          rfl
        show θ W' hW' ((XR.presheaf.map (homOfLE (prR.preimage_mono hle)).op).hom
            (wcCnSigma h (prR ⁻¹ᵁ W) b)) =
          Polynomial.map (Z'.presheaf.map (homOfLE hle).op).hom (θ W hW (wcCnSigma h (prR ⁻¹ᵁ W) b))
        rw [e, hmap', hmap', Polynomial.map_map, e2]
    exact key (hgen W hW z)

  obtain ⟨ha, hb, hc⟩ := wc_cn_h0ar_rees_glue A 𝔞 Z' (pr ≫ f) XR h prR θ hinj hC hmap hnat r
    (fun i => pr ⁻¹ᵁ U i) hV hVcov hVV

  obtain ⟨k, z, hz⟩ := wc_cn_coherent_global_sections_fg (reesAlgebra 𝔞) XR h (wcStructMod XR)
    (wc_struct_mod_coh XR)
  have hz' : ∀ s : Γ(XR, ⊤), ∃ b : Fin k → reesAlgebra 𝔞,
      s = ∑ l, wcCnSigma h ⊤ (b l) * (show Γ(XR, ⊤) from z l) := hz

  obtain ⟨c, hring⟩ := wc_cn_h0ar_coeff_bound A 𝔞 Z' (pr ≫ f) r (fun i => pr ⁻¹ᵁ U i) Γ(XR, ⊤)
    (wcCnSigma h ⊤)
    (fun i => (θ (pr ⁻¹ᵁ U i) (hV i)).comp
      (XR.presheaf.map (homOfLE (le_top : prR ⁻¹ᵁ (pr ⁻¹ᵁ U i) ≤ ⊤)).op).hom)
    hVcov ha hb hc ⟨k, fun l => (show Γ(XR, ⊤) from z l), hz'⟩

  exact ⟨c, fun n s hs => wc_cn_h0ar_sqzero_transfer A 𝔞 X f M Z' pr ι π h1 h2 h3 h4 h5 r U hU
    hcov hUU c hring n s hs⟩

theorem wc_cn_rml_proper_affine_cover : ∀ (A : Type u) [CommRing A] (X : Scheme.{u}) (f : X ⟶ Spec (.of A)) [IsProper f], ∃ (r : ℕ) (U : Fin r → X.Opens), (∀ i, IsAffineOpen (U i)) ∧ (∀ x : X, ∃ i, x ∈ U i) ∧ (∀ i j, IsAffineOpen (U i ⊓ U j)) :=
by
  intro A _ X f _
  classical
  have hc : IsCompact ((⊤ : X.Opens) : Set X) := by
    simpa using QuasiCompact.isCompact_preimage (f := f) Set.univ isOpen_univ isCompact_univ
  obtain ⟨s, hs, hU⟩ := isCompact_iff_finite_and_eq_biUnion_affineOpens.mp hc
  let T := hs.toFinset
  let e := T.equivFin
  have key : ∀ V W : X.Opens, IsAffineOpen V → IsAffineOpen W → IsAffineOpen (V ⊓ W) := by
    intro V W hV hW
    haveI : IsAffine V := hV
    haveI : IsAffineHom (V.ι ≫ f) := inferInstance
    haveI : IsAffineHom V.ι := IsAffineHom.of_comp V.ι f
    have h1 := (hW.preimage V.ι).image_of_isOpenImmersion V.ι
    rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι] at h1
    exact h1
  refine ⟨T.card, fun k => ((e.symm k : T) : X.affineOpens).1,
    fun k => ((e.symm k : T) : X.affineOpens).2, fun x => ?_,
    fun i j => key _ _ ((e.symm i : T) : X.affineOpens).2 ((e.symm j : T) : X.affineOpens).2⟩
  have hx : x ∈ ((⊤ : X.Opens) : Set X) := trivial
  rw [hU] at hx
  simp only [TopologicalSpace.Opens.coe_iSup, Set.mem_iUnion] at hx
  obtain ⟨i, hi, hxi⟩ := hx
  refine ⟨e ⟨i, hs.mem_toFinset.mpr hi⟩, ?_⟩
  simp only [Equiv.symm_apply_apply]
  exact hxi

theorem wc_cn_relative_ml : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B] (I : Ideal B) (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B)) [IsProper h] (P : Scheme.{u}) (p : P ⟶ Z) (m : ℕ) (g : P ⟶ wcPm.{u} m), IsProper p → IsClosedImmersion (Limits.prod.lift (p ≫ h) g) → ∀ (Gs : ℕ → P.Modules) (ψG : ∀ n, Gs (n+1) ⟶ Gs n) (G : P.Modules) (φG : ∀ n, G ⟶ Gs n), wcCnAdicSys (p ≫ h) I Gs ψG → wcCnAlg (p ≫ h) I Gs ψG G φG → ∃ c : ℕ, ∀ (V : Z.Opens), IsAffineOpen V → ∀ n : ℕ, (∀ s : Γ(G, p ⁻¹ᵁ V), Scheme.Modules.Hom.app (φG (n + c)) (p ⁻¹ᵁ V) s = 0 → s ∈ Ideal.map (wcCnSigma h V) (I ^ (n+1)) • (⊤ : Submodule Γ(Z, V) Γ((Scheme.Modules.pushforward p).obj G, V))) ∧ (∀ y : Γ(Gs (n + c), p ⁻¹ᵁ V), ∃ s : Γ(G, p ⁻¹ᵁ V), Scheme.Modules.Hom.app (φG n) (p ⁻¹ᵁ V) s = Scheme.Modules.Hom.app (wcCnTrans ψG n c) (p ⁻¹ᵁ V) y) :=
by
  intro B _ _ I Z h _ P p m g hp hcl Gs ψG G φG hsys halg
  classical
  haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian h
  haveI : CompactSpace Z :=
    ⟨by simpa using QuasiCompact.isCompact_preimage (f := h) Set.univ isOpen_univ isCompact_univ⟩
  have compA : ∀ {X : Scheme.{u}} {M N K : X.Modules} (f : M ⟶ N) (g : N ⟶ K) (U : X.Opens)
      (x : Γ(M, U)), Scheme.Modules.Hom.app (f ≫ g) U x =
        Scheme.Modules.Hom.app g U (Scheme.Modules.Hom.app f U x) := by
    intro X M N K f g U x
    rw [Scheme.Modules.Hom.comp_app]
    rfl
  have idA : ∀ {X : Scheme.{u}} (M : X.Modules) (U : X.Opens) (x : Γ(M, U)),
      Scheme.Modules.Hom.app (𝟙 M) U x = x := by
    intro X M U x
    rw [Scheme.Modules.Hom.id_app]
    rfl
  have natApp : ∀ {X : Scheme.{u}} {M N : X.Modules} (f : M ⟶ N) {A B : X.Opens} (hle : B ≤ A)
      (x : Γ(M, A)), Scheme.Modules.Hom.app f B ((M.presheaf.map (homOfLE hle).op).hom x) =
      (N.presheaf.map (homOfLE hle).op).hom (Scheme.Modules.Hom.app f A x) :=
    fun f _ _ hle x => congrArg (fun k => k.hom x)
      ((Scheme.Modules.Hom.mapPresheaf f).naturality (homOfLE hle).op)

  have htrans : ∀ (X Y : Scheme.{u}) (Gs' : ℕ → X.Modules) (ψ' : ∀ n, Gs' (n+1) ⟶ Gs' n)
      (Gs'' : ℕ → Y.Modules) (ψ'' : ∀ n, Gs'' (n+1) ⟶ Gs'' n) (U' : X.Opens) (U : Y.Opens)
      (es : ∀ n, Γ(Gs' n, U') ≃+ Γ(Gs'' n, U)),
      (∀ (n : ℕ) (x : Γ(Gs' (n+1), U')), es n (Scheme.Modules.Hom.app (ψ' n) U' x) =
        Scheme.Modules.Hom.app (ψ'' n) U (es (n+1) x)) →
      ∀ (n c : ℕ) (y : Γ(Gs' (n + c), U')),
        es n (Scheme.Modules.Hom.app (wcCnTrans ψ' n c) U' y) =
          Scheme.Modules.Hom.app (wcCnTrans ψ'' n c) U (es (n + c) y) := by
    intro X Y Gs' ψ' Gs'' ψ'' U' U es hes n c
    induction c with
    | zero =>
      intro y
      show es n (Scheme.Modules.Hom.app (𝟙 (Gs' n)) U' y) =
        Scheme.Modules.Hom.app (𝟙 (Gs'' n)) U (es n y)
      rw [idA, idA]
    | succ c ih =>
      intro y
      show es n (Scheme.Modules.Hom.app (ψ' (n + c) ≫ wcCnTrans ψ' n c) U' y) =
        Scheme.Modules.Hom.app (ψ'' (n + c) ≫ wcCnTrans ψ'' n c) U (es (n + c + 1) y)
      rw [compA, compA, ih, hes]

  let pf := Scheme.Modules.pushforward p
  let M : Z.Modules := pf.obj G
  let Ms : ℕ → Z.Modules := fun k => pf.obj (Gs k)
  let ψ : ∀ k, Ms (k + 1) ⟶ Ms k := fun k => pf.map (ψG k)
  let φ : ∀ k, M ⟶ Ms k := fun k => pf.map (φG k)
  have hM : wcQcoh M := (wc_cn_pushforward_coherent B Z h P p m g hp hcl G halg.1).1
  have hMs : ∀ k, wcQcoh (Ms k) := fun k =>
    (wc_cn_pushforward_coherent B Z h P p m g hp hcl (Gs k) (hsys.1 k)).1
  have htransPf : ∀ n c, wcCnTrans (Gs := Ms) ψ n c = pf.map (wcCnTrans ψG n c) := by
    intro n c
    induction c with
    | zero =>
      show 𝟙 (Ms n) = pf.map (𝟙 (Gs n))
      exact (pf.map_id (Gs n)).symm
    | succ c ih =>
      show ψ (n + c) ≫ wcCnTrans (Gs := Ms) ψ n c = pf.map (ψG (n + c) ≫ wcCnTrans ψG n c)
      rw [ih, Functor.map_comp]

  let Q : Z.Opens → ℕ → Prop := fun W c => ∀ n : ℕ,
    (∀ s : Γ(M, W), Scheme.Modules.Hom.app (φ (n + c)) W s = 0 →
      s ∈ Ideal.map (wcCnSigma h W) (I ^ (n + 1)) • (⊤ : Submodule Γ(Z, W) Γ(M, W))) ∧
    (∀ y : Γ(Ms (n + c), W), ∃ s : Γ(M, W),
      Scheme.Modules.Hom.app (φ n) W s = Scheme.Modules.Hom.app (wcCnTrans (Gs := Ms) ψ n c) W y)

  have hres : ∀ (W : Z.Opens), IsAffineOpen W → ∀ (f : Γ(Z, W)) (c : ℕ), Q W c →
      Q (Z.basicOpen f) c := fun W hW f c hQ =>
    wc_cn_rml_basic_restrict B I Z h M Ms ψ φ hM hMs W hW f c hQ
  have hglue : ∀ (W : Z.Opens), IsAffineOpen W → ∀ (k : ℕ) (g : Fin k → Γ(Z, W)),
      Ideal.span (Set.range g) = ⊤ → ∀ c : ℕ, (∀ j, Q (Z.basicOpen (g j)) c) → Q W c :=
    fun W hW k g' hg c hQ =>
      wc_cn_rml_basic_glue B I Z h M Ms ψ φ hM hMs W hW k g' hg c (fun j n => hQ j n)

  have hloc : ∀ (U : Z.Opens), IsAffineOpen U → ∃ c : ℕ, ∀ c' : ℕ, c ≤ c' → Q U c' := by
    intro U hU
    haveI : IsNoetherianRing Γ(Z, U) := IsLocallyNoetherian.component_noetherian ⟨U, hU⟩
    obtain ⟨X, f, Gs', ψ', G', φ', e, es, hfp, halg', hφ, hψ, hsm⟩ :=
      wc_cn_rml_preimage_model B I Z P h p hp U hU Gs ψG G φG halg
    haveI := hfp
    obtain ⟨r, Ui, hUa, hUc, hUi⟩ := wc_cn_rml_proper_affine_cover Γ(Z, U) X f
    obtain ⟨c5, h5⟩ := wc_cn_rml_level_lift_single Γ(Z, U) (Ideal.map (wcCnSigma h U) I) X f
      Gs' ψ' G' φ' halg' r Ui hUa hUc hUi
    obtain ⟨c6, h6⟩ := wc_cn_rml_h0_artin_rees Γ(Z, U) (Ideal.map (wcCnSigma h U) I) X f G'
      halg'.1 r Ui hUa hUc hUi
    refine ⟨c5 + c6, fun c' hc' n => ⟨?_, ?_⟩⟩
    ·
      intro s hs
      obtain ⟨x, rfl⟩ : ∃ x, e x = s := ⟨e.symm s, e.apply_symm_apply s⟩
      have h0 : Scheme.Modules.Hom.app (φ' (n + c')) ⊤ x = 0 := by
        apply (es (n + c')).injective
        rw [hφ, map_zero]
        exact hs
      have hchart : ∀ i, (G'.presheaf.map (homOfLE (le_top : Ui i ≤ ⊤)).op).hom x ∈
          Ideal.map (wcCnSigma f (Ui i)) ((Ideal.map (wcCnSigma h U) I) ^ ((n + 1) + c6)) •
            (⊤ : Submodule Γ(X, Ui i) Γ(G', Ui i)) := by
        intro i
        have hz : Scheme.Modules.Hom.app (φ' (n + c')) (Ui i)
            ((G'.presheaf.map (homOfLE (le_top : Ui i ≤ ⊤)).op).hom x) = 0 := by
          rw [natApp, h0, map_zero]
        have hmem := ((halg'.2.2 (n + c') (Ui i) (hUa i)).2 _).mp hz
        exact Submodule.smul_mono_left
          (Ideal.map_mono (Ideal.pow_le_pow_right (by omega))) hmem
      obtain ⟨k, a, xs, ha, hxsum⟩ := h6 (n + 1) x hchart
      rw [hxsum, map_sum]
      refine Submodule.sum_mem _ (fun l _ => ?_)
      rw [hsm]
      have hal : a l ∈ Ideal.map (wcCnSigma h U) (I ^ (n + 1)) := by
        rw [Ideal.map_pow]
        exact ha l
      have hmem : (a l) • (show Γ(M, U) from e (xs l)) ∈
          Ideal.map (wcCnSigma h U) (I ^ (n + 1)) • (⊤ : Submodule Γ(Z, U) Γ(M, U)) :=
        Submodule.smul_mem_smul hal Submodule.mem_top
      exact hmem
    ·
      intro y
      obtain ⟨s', hs'⟩ := h5 c' (by omega) n ((es (n + c')).symm y)
      refine ⟨e s', ?_⟩
      have e1 := hφ n s'
      rw [hs'] at e1
      have e2 := htrans X P Gs' ψ' Gs ψG ⊤ (p ⁻¹ᵁ U) es hψ n c' ((es (n + c')).symm y)
      rw [htransPf]
      show Scheme.Modules.Hom.app (φG n) (p ⁻¹ᵁ U) (e s') =
        Scheme.Modules.Hom.app (wcCnTrans ψG n c') (p ⁻¹ᵁ U) y
      rw [← e1, e2]
      exact congrArg (fun z => Scheme.Modules.Hom.app (wcCnTrans ψG n c') (p ⁻¹ᵁ U) z)
        ((es (n + c')).apply_symm_apply y)

  obtain ⟨c, hc⟩ := wc_cn_rml_uniformize Z Q hres hglue hloc

  refine ⟨c, fun V hV n => ⟨fun s hs => (hc V hV n).1 s hs, fun y => ?_⟩⟩
  obtain ⟨s, hs⟩ := (hc V hV n).2 y
  refine ⟨s, ?_⟩
  rw [htransPf] at hs
  exact hs

theorem wc_cn_unit_lift_core : ∀ (R : Type u) [CommRing R] (𝔍 : ℕ → Ideal R) (N Q Hm : ℕ → Type u) [∀ k, AddCommGroup (N k)] [∀ k, Module R (N k)] [∀ k, AddCommGroup (Q k)] [∀ k, Module R (Q k)] [∀ k, AddCommGroup (Hm k)] [∀ k, Module R (Hm k)] (M : Type u) [AddCommGroup M] [Module R M] (ψ : ∀ k, N (k + 1) →ₗ[R] N k) (ρ : ∀ k, Q (k + 1) →ₗ[R] Q k) (ψH : ∀ k, Hm (k + 1) →ₗ[R] Hm k) (η : ∀ k, N k →ₗ[R] Q k) (θ : ∀ k, M →ₗ[R] Q k) (φ : ∀ k, M →ₗ[R] Hm k) (c : ℕ), (∀ n k, n ≤ k → 𝔍 k ≤ 𝔍 n) → (∀ k, Function.Surjective (ψ k)) → (∀ (n : ℕ) (x : N n), ∃ X : ∀ k, N k, (∀ k, ψ k (X (k + 1)) = X k) ∧ X n = x) → (∀ k (x : N (k + 1)), ψ k x = 0 → x ∈ 𝔍 k • (⊤ : Submodule R (N (k + 1)))) → (∀ k (x : N (k + 1)), ρ k (η (k + 1) x) = η k (ψ k x)) → (∀ k (y : M), ρ k (θ (k + 1) y) = θ k y) → (∀ k (y : M), ψH k (φ (k + 1) y) = φ k y) → (∀ k (y : M), φ k y = 0 ↔ y ∈ 𝔍 k • (⊤ : Submodule R M)) → (∀ k (y : M), y ∈ 𝔍 k • (⊤ : Submodule R M) → θ k y = 0) → (∀ (n : ℕ) (y : M), θ (n + c) y = 0 → y ∈ 𝔍 n • (⊤ : Submodule R M)) → (∀ q : ∀ k, Q k, (∀ k, ρ k (q (k + 1)) = q k) → ∀ k, ∃ y : M, θ k y = q k) → ∃ α : ∀ k, N k →ₗ[R] Hm k, (∀ k (x : N (k + 1)), ψH k (α (k + 1) x) = α k (ψ k x)) ∧ (∀ k (x : N k) (y : M), φ k y = α k x → θ k y = η k x) ∧ ∀ (X : ∀ k, N k), (∀ k, ψ k (X (k + 1)) = X k) → ∀ (n k : ℕ) (y : M), n + c ≤ k → θ k y = η k (X k) → α n (X n) = φ n y :=
by
  intro R _ 𝔍 N Q Hm _ _ _ _ _ _ M _ _ ψ ρ ψH η θ φ c h𝔍 hsurj hext hkerN hρη hρθ hψφ hφker
    hθkill hK hI
  classical

  have desc : ∀ (X : ∀ k, N k), (∀ k, ψ k (X (k + 1)) = X k) → ∀ (y : M) (m K : ℕ), m ≤ K →
      θ K y = η K (X K) → θ m y = η m (X m) := by
    intro X hX y m K hmK
    induction K, hmK using Nat.le_induction with
    | base => exact id
    | succ K _ ih =>
      intro h
      apply ih
      rw [← hρθ K y, h, hρη K (X (K + 1)), hX K]

  have kdesc : ∀ (D : ∀ k, N k), (∀ k, ψ k (D (k + 1)) = D k) → ∀ n, D n = 0 →
      ∀ j, D (n + j) ∈ 𝔍 n • (⊤ : Submodule R (N (n + j))) := by
    intro D hD n hn j
    induction j with
    | zero =>
      show D n ∈ 𝔍 n • (⊤ : Submodule R (N n))
      rw [hn]
      exact Submodule.zero_mem _
    | succ j ih =>
      have hmap : Submodule.map (ψ (n + j)) (𝔍 n • (⊤ : Submodule R (N (n + j + 1)))) =
          𝔍 n • (⊤ : Submodule R (N (n + j))) := by
        rw [Submodule.map_smul'', Submodule.map_top, LinearMap.range_eq_top.mpr (hsurj (n + j))]
      have ih' : D (n + j) ∈ Submodule.map (ψ (n + j)) (𝔍 n • (⊤ : Submodule R (N (n + j + 1)))) := by
        rw [hmap]
        exact ih
      obtain ⟨w, hw, hψw⟩ := Submodule.mem_map.mp ih'
      have h0 : ψ (n + j) (D (n + j + 1) - w) = 0 := by
        rw [map_sub, hψw, hD, sub_self]
      have h1 := hkerN (n + j) _ h0
      have h2 : 𝔍 (n + j) • (⊤ : Submodule R (N (n + j + 1))) ≤ 𝔍 n • ⊤ :=
        Submodule.smul_mono_left (h𝔍 n (n + j) (Nat.le_add_right n j))
      have h3 := Submodule.add_mem _ (h2 h1) hw
      rw [sub_add_cancel] at h3
      exact h3

  have slift : ∀ (I : Ideal R) (K : ℕ) (d : N K), d ∈ I • (⊤ : Submodule R (N K)) →
      ∃ w ∈ I • (⊤ : Submodule R M), θ K w = η K d := by
    intro I K d hd
    refine Submodule.smul_induction_on
      (p := fun d => ∃ w ∈ I • (⊤ : Submodule R M), θ K w = η K d) hd ?_ ?_
    · intro r hr z _
      obtain ⟨Xz, hXz, hXzK⟩ := hext K z
      obtain ⟨y, hy⟩ : ∃ y : M, θ K y = η K (Xz K) :=
        hI (fun k => η k (Xz k)) (fun k => by rw [hρη, hXz]) K
      refine ⟨r • y, Submodule.smul_mem_smul hr Submodule.mem_top, ?_⟩
      rw [map_smul, map_smul, hy, hXzK]
    · rintro x x' ⟨w, hw, hwx⟩ ⟨w', hw', hwx'⟩
      exact ⟨w + w', Submodule.add_mem _ hw hw', by rw [map_add, map_add, hwx, hwx']⟩

  let W : ∀ n, N n → Hm n → Prop := fun n x v => ∃ (X : ∀ k, N k) (K : ℕ) (y : M),
    (∀ k, ψ k (X (k + 1)) = X k) ∧ X n = x ∧ n + c ≤ K ∧ θ K y = η K (X K) ∧ φ n y = v
  have G1 : ∀ n (x : N n), ∃ v, W n x v := by
    intro n x
    obtain ⟨X, hX, hXn⟩ := hext n x
    obtain ⟨y, hy⟩ : ∃ y : M, θ (n + c) y = η (n + c) (X (n + c)) :=
      hI (fun k => η k (X k)) (fun k => by rw [hρη, hX]) (n + c)
    exact ⟨φ n y, X, n + c, y, hX, hXn, le_refl _, hy, rfl⟩
  have G2 : ∀ n (x : N n) v v', W n x v → W n x v' → v = v' := by
    rintro n x v v' ⟨X, K, y, hX, hXn, hK1, hy, rfl⟩ ⟨X', K', y', hX', hX'n, hK2, hy', rfl⟩
    have e1 := desc X hX y (n + c) K hK1 hy
    have e2 := desc X' hX' y' (n + c) K' hK2 hy'
    have hD : ∀ k, ψ k (X (k + 1) - X' (k + 1)) = X k - X' k := fun k => by
      rw [map_sub, hX, hX']
    have hDn : X n - X' n = 0 := by rw [hXn, hX'n, sub_self]
    have hmem := kdesc (fun k => X k - X' k) hD n hDn c
    obtain ⟨w, hw, hθw⟩ : ∃ w ∈ 𝔍 n • (⊤ : Submodule R M),
        θ (n + c) w = η (n + c) (X (n + c) - X' (n + c)) := slift (𝔍 n) (n + c) _ hmem
    have h0 : θ (n + c) (y - y' - w) = 0 := by
      rw [map_sub, map_sub, hθw, e1, e2, map_sub, sub_self]
    have h1 := hK n _ h0
    have h2 : y - y' ∈ 𝔍 n • (⊤ : Submodule R M) := by
      have h4 := Submodule.add_mem _ h1 hw
      rwa [sub_add_cancel] at h4
    have h3 := (hφker n _).mpr h2
    rw [map_sub, sub_eq_zero] at h3
    exact h3
  have G3 : ∀ n (a a' : N n) v v', W n a v → W n a' v' → W n (a + a') (v + v') := by
    rintro n a a' v v' ⟨X, K, y, hX, hXn, hK1, hy, rfl⟩ ⟨X', K', y', hX', hX'n, hK2, hy', rfl⟩
    have e1 := desc X hX y (n + c) K hK1 hy
    have e2 := desc X' hX' y' (n + c) K' hK2 hy'
    refine ⟨fun k => X k + X' k, n + c, y + y', fun k => ?_, ?_, le_refl _, ?_, ?_⟩
    · show ψ k (X (k + 1) + X' (k + 1)) = X k + X' k
      rw [map_add, hX, hX']
    · show X n + X' n = a + a'
      rw [hXn, hX'n]
    · show θ (n + c) (y + y') = η (n + c) (X (n + c) + X' (n + c))
      rw [map_add, map_add, e1, e2]
    · exact map_add _ _ _
  have G4 : ∀ n (r : R) (a : N n) v, W n a v → W n (r • a) (r • v) := by
    rintro n r a v ⟨X, K, y, hX, hXn, hK1, hy, rfl⟩
    refine ⟨fun k => r • X k, K, r • y, fun k => ?_, ?_, hK1, ?_, ?_⟩
    · show ψ k (r • X (k + 1)) = r • X k
      rw [map_smul, hX]
    · show r • X n = r • a
      rw [hXn]
    · show θ K (r • y) = η K (r • X K)
      rw [map_smul, map_smul, hy]
    · exact map_smul _ _ _

  have G5 : ∀ n, ∃ f : N n →ₗ[R] Hm n, ∀ x, W n x (f x) := by
    intro n
    choose f hf using G1 n
    exact ⟨{ toFun := f
             map_add' := fun a a' => G2 n _ _ _ (hf (a + a')) (G3 n a a' _ _ (hf a) (hf a'))
             map_smul' := fun r a => G2 n _ _ _ (hf (r • a)) (G4 n r a _ (hf a)) }, hf⟩
  choose α hα using G5
  have P : ∀ n (x : N n) v, W n x v → α n x = v := fun n x v hW => G2 n x _ _ (hα n x) hW
  refine ⟨α, ?_, ?_, ?_⟩
  · intro k x
    obtain ⟨X, K, y, hX, hXn, hK1, hy, hφy⟩ := hα (k + 1) x
    have hW : W k (ψ k x) (φ k y) := ⟨X, K, y, hX, by rw [← hXn, hX], by omega, hy, rfl⟩
    rw [← hφy, hψφ, P k _ _ hW]
  · intro k x y hyx
    obtain ⟨X, K, y₀, hX, hXn, hK1, hy₀, hφy₀⟩ := hα k x
    have h1 : φ k (y - y₀) = 0 := by rw [map_sub, hyx, hφy₀, sub_self]
    have h2 := hθkill k _ ((hφker k _).mp h1)
    rw [map_sub, sub_eq_zero] at h2
    rw [h2, desc X hX y₀ k K (by omega) hy₀, hXn]
  · intro X hX n k y hk hy
    exact P n (X n) (φ n y) ⟨X, k, y, hX, rfl, hk, hy, rfl⟩

theorem wc_cn_seq_extend : ∀ (N : ℕ → Type u) (ψ : ∀ k, N (k + 1) → N k), (∀ k, Function.Surjective (ψ k)) → ∀ (n : ℕ) (x : N n), ∃ X : ∀ k, N k, (∀ k, ψ k (X (k + 1)) = X k) ∧ X n = x :=
by
  intro N ψ hψ n
  induction n generalizing N ψ hψ with
  | zero =>
    intro x
    choose s hs using hψ
    exact ⟨fun k => Nat.rec (motive := fun k => N k) x (fun k y => s k y) k,
      fun k => hs k _, rfl⟩
  | succ n ih =>
    intro x
    obtain ⟨X', hX', hX'n⟩ :=
      ih (fun k => N (k + 1)) (fun k => ψ (k + 1)) (fun k => hψ (k + 1)) x
    refine ⟨fun k => Nat.casesOn (motive := fun k => N k) k (ψ 0 (X' 0)) (fun k => X' k),
      ?_, hX'n⟩
    intro k
    cases k with
    | zero => rfl
    | succ j => exact hX' j

theorem wc_cn_pushforward_killed : ∀ (B : Type u) [CommRing B] (J : Ideal B) (Z P : Scheme.{u}) (h : Z ⟶ Spec (.of B)) (p : P ⟶ Z) (G : P.Modules), (∀ (W : P.Opens), IsAffineOpen W → Ideal.map (wcCnSigma (p ≫ h) W) J • (⊤ : Submodule Γ(P, W) Γ(G, W)) = ⊥) → ∀ (V : Z.Opens), ∀ a ∈ Ideal.map (wcCnSigma h V) J, ∀ q : Γ((Scheme.Modules.pushforward p).obj G, V), a • q = 0 :=
by
  intro B _ J Z P h p G hkill V a ha q
  have key : ∀ b ∈ J, ∀ q : Γ((Scheme.Modules.pushforward p).obj G, V),
      wcCnSigma h V b • q = 0 := by
    intro b hb q
    have F1 : (p.app V).hom (wcCnSigma h V b) = wcCnSigma (p ≫ h) (p ⁻¹ᵁ V) b := by
      have e := congrArg (fun φ => φ.hom (h.appTop.hom ((Scheme.ΓSpecIso (.of B)).inv.hom b)))
        (Scheme.Hom.naturality p (homOfLE (le_top : V ≤ ⊤)).op)
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e
      unfold wcCnSigma
      simp only [RingHom.comp_apply, Scheme.Hom.comp_appTop, CommRingCat.hom_comp]
      exact e
    change ((p.app V).hom (wcCnSigma h V b) • (show Γ(G, p ⁻¹ᵁ V) from q) : Γ(G, p ⁻¹ᵁ V)) = 0
    rw [F1]
    let NS : TopCat.Sheaf Ab P := ⟨G.presheaf, G.isSheaf⟩
    refine TopCat.Sheaf.eq_of_locally_eq' NS
      (fun W : {W : P.affineOpens // W.1 ≤ p ⁻¹ᵁ V} => W.1.1) (p ⁻¹ᵁ V)
      (fun W => homOfLE W.2) ?_ _ _ ?_
    · intro z hz
      obtain ⟨W, hW, hzW, hWU⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp P.isBasis_affineOpens) hz
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨⟨W, hW⟩, hWU⟩, hzW⟩
    · intro W
      change (G.presheaf.map (homOfLE W.2).op).hom
          (wcCnSigma (p ≫ h) (p ⁻¹ᵁ V) b • (show Γ(G, p ⁻¹ᵁ V) from q)) =
        (G.presheaf.map (homOfLE W.2).op).hom 0
      rw [map_zero, Scheme.Modules.map_smul]
      have F2 : (P.presheaf.map (homOfLE W.2).op).hom (wcCnSigma (p ≫ h) (p ⁻¹ᵁ V) b) =
          wcCnSigma (p ≫ h) W.1.1 b := by
        unfold wcCnSigma
        simp only [RingHom.comp_apply]
        rw [← CommRingCat.comp_apply, ← Functor.map_comp]
        rfl
      rw [F2]
      have hmem := Submodule.smul_mem_smul
        (Ideal.mem_map_of_mem (wcCnSigma (p ≫ h) W.1.1) hb)
        (Submodule.mem_top (R := Γ(P, W.1.1))
          (x := (G.presheaf.map (homOfLE W.2).op).hom (show Γ(G, p ⁻¹ᵁ V) from q)))
      rw [hkill W.1.1 W.1.2] at hmem
      exact (Submodule.mem_bot _).mp hmem
  have hle : Ideal.map (wcCnSigma h V) J ≤
      Module.annihilator Γ(Z, V) Γ((Scheme.Modules.pushforward p).obj G, V) := by
    rw [Ideal.map_le_iff_le_comap]
    intro b hb
    rw [Ideal.mem_comap, Module.mem_annihilator]
    exact key b hb
  exact Module.mem_annihilator.mp (hle ha) q

theorem wc_cn_modules_hom_of_affine : ∀ (Z : Scheme.{u}) (F G : Z.Modules) (f : ∀ V : Z.Opens, IsAffineOpen V → (Γ(F, V) →ₗ[Γ(Z, V)] Γ(G, V))), (∀ (V V' : Z.Opens) (hV : IsAffineOpen V) (hV' : IsAffineOpen V') (hle : V' ≤ V) (x : Γ(F, V)), f V' hV' ((F.presheaf.map (homOfLE hle).op).hom x) = (G.presheaf.map (homOfLE hle).op).hom (f V hV x)) → ∃ α : F ⟶ G, ∀ (V : Z.Opens) (hV : IsAffineOpen V) (x : Γ(F, V)), Scheme.Modules.Hom.app α V x = f V hV x :=
by
  intro Z F G f hf
  classical
  have resG : ∀ (M : Z.Modules) {A B C : Z.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (x : Γ(M, A)),
      (M.presheaf.map (homOfLE h2).op).hom ((M.presheaf.map (homOfLE h1).op).hom x) =
      (M.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro M A B C h1 h2 x
    change (M.presheaf.map (homOfLE h1).op ≫ M.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    all_goals rfl
  have resId : ∀ (M : Z.Modules) (A : Z.Opens) (h : A ≤ A) (x : Γ(M, A)),
      (M.presheaf.map (homOfLE h).op).hom x = x := by
    intro M A h x
    have h' : (homOfLE h).op = 𝟙 (Opposite.op A) := rfl
    rw [h', CategoryTheory.Functor.map_id]
    all_goals rfl
  have smulG : ∀ (M : Z.Modules) {A B : Z.Opens} (h : B ≤ A) (r : Γ(Z, A)) (x : Γ(M, A)),
      (M.presheaf.map (homOfLE h).op).hom (r • x) =
      (Z.presheaf.map (homOfLE h).op).hom r • (M.presheaf.map (homOfLE h).op).hom x :=
    fun M _ _ h r x => Scheme.Modules.map_smul M (homOfLE h) r x

  have cov : ∀ V : Z.Opens, V ≤ ⨆ (i : {W : Z.affineOpens // W.1 ≤ V}), i.1.1 := by
    intro V z hz
    obtain ⟨W, hW, hzW, hWV⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp Z.isBasis_affineOpens) hz
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨⟨W, hW⟩, hWV⟩, hzW⟩

  have sep : ∀ (M : Z.Modules) (V : Z.Opens) (y y' : Γ(M, V)),
      (∀ (W : Z.Opens) (hW : IsAffineOpen W) (hWV : W ≤ V),
        (M.presheaf.map (homOfLE hWV).op).hom y = (M.presheaf.map (homOfLE hWV).op).hom y') →
      y = y' := by
    intro M V y y' h
    let MS : TopCat.Sheaf Ab Z := ⟨M.presheaf, M.isSheaf⟩
    exact TopCat.Sheaf.eq_of_locally_eq' MS (fun i : {W : Z.affineOpens // W.1 ≤ V} => i.1.1) V
      (fun i => homOfLE i.2) (cov V) y y' (fun i => h i.1.1 i.1.2 i.2)

  have glue : ∀ (M : Z.Modules) (V : Z.Opens)
      (s : ∀ W : Z.Opens, IsAffineOpen W → W ≤ V → Γ(M, W)),
      (∀ (W W' : Z.Opens) (hW : IsAffineOpen W) (hW' : IsAffineOpen W') (hWV : W ≤ V)
        (hW'V : W' ≤ V) (hle : W' ≤ W),
        (M.presheaf.map (homOfLE hle).op).hom (s W hW hWV) = s W' hW' hW'V) →
      ∃ y : Γ(M, V), ∀ (W : Z.Opens) (hW : IsAffineOpen W) (hWV : W ≤ V),
        (M.presheaf.map (homOfLE hWV).op).hom y = s W hW hWV := by
    intro M V s hs
    let MS : TopCat.Sheaf Ab Z := ⟨M.presheaf, M.isSheaf⟩
    have hcomp : TopCat.Presheaf.IsCompatible MS.obj
        (fun i : {W : Z.affineOpens // W.1 ≤ V} => i.1.1) (fun i => s i.1.1 i.1.2 i.2) := by
      intro i j
      change (M.presheaf.map (homOfLE (inf_le_left : i.1.1 ⊓ j.1.1 ≤ i.1.1)).op).hom
          (s i.1.1 i.1.2 i.2) =
        (M.presheaf.map (homOfLE (inf_le_right : i.1.1 ⊓ j.1.1 ≤ j.1.1)).op).hom
          (s j.1.1 j.1.2 j.2)
      apply sep M
      intro W hW hWD
      have h1 : W ≤ V := hWD.trans (inf_le_left.trans i.2)
      rw [resG, resG, hs i.1.1 W i.1.2 hW i.2 h1, hs j.1.1 W j.1.2 hW j.2 h1]
    obtain ⟨y, hy, -⟩ := TopCat.Sheaf.existsUnique_gluing' MS
      (fun i : {W : Z.affineOpens // W.1 ≤ V} => i.1.1) V (fun i => homOfLE i.2) (cov V) _ hcomp
    exact ⟨y, fun W hW hWV => hy ⟨⟨W, hW⟩, hWV⟩⟩

  have hglue : ∀ (V : Z.Opens) (x : Γ(F, V)), ∃ y : Γ(G, V),
      ∀ (W : Z.Opens) (hW : IsAffineOpen W) (hWV : W ≤ V),
        (G.presheaf.map (homOfLE hWV).op).hom y =
          f W hW ((F.presheaf.map (homOfLE hWV).op).hom x) := by
    intro V x
    refine glue G V (fun W hW hWV => f W hW ((F.presheaf.map (homOfLE hWV).op).hom x)) ?_
    intro W W' hW hW' hWV hW'V hle
    show (G.presheaf.map (homOfLE hle).op).hom (f W hW ((F.presheaf.map (homOfLE hWV).op).hom x)) =
      f W' hW' ((F.presheaf.map (homOfLE hW'V).op).hom x)
    rw [← hf W W' hW hW' hle, resG]
  choose Fv hFv using hglue
  have Fv_add : ∀ (V : Z.Opens) (x y : Γ(F, V)), Fv V (x + y) = Fv V x + Fv V y := by
    intro V x y
    apply sep G V
    intro W hW hWV
    rw [map_add, hFv V (x + y) W hW hWV, hFv V x W hW hWV, hFv V y W hW hWV, map_add, map_add]
  have Fv_smul : ∀ (V : Z.Opens) (r : Γ(Z, V)) (x : Γ(F, V)), Fv V (r • x) = r • Fv V x := by
    intro V r x
    apply sep G V
    intro W hW hWV
    rw [hFv V (r • x) W hW hWV, smulG, smulG, hFv V x W hW hWV, LinearMap.map_smul]
  have Fv_nat : ∀ (V V₂ : Z.Opens) (h : V₂ ≤ V) (x : Γ(F, V)),
      Fv V₂ ((F.presheaf.map (homOfLE h).op).hom x) =
        (G.presheaf.map (homOfLE h).op).hom (Fv V x) := by
    intro V V₂ h x
    apply sep G V₂
    intro W hW hWV
    rw [hFv V₂ _ W hW hWV, resG, resG, hFv V x W hW (hWV.trans h)]
  have Fv_val : ∀ (V : Z.Opens) (hV : IsAffineOpen V) (x : Γ(F, V)), Fv V x = f V hV x := by
    intro V hV x
    have key := hFv V x V hV le_rfl
    rwa [resId, resId] at key
  let η : F.presheaf ⟶ G.presheaf :=
    { app := fun V => AddCommGrpCat.ofHom (AddMonoidHom.mk' (Fv V.unop) (Fv_add V.unop))
      naturality := fun V W i => by
        ext x
        exact Fv_nat V.unop W.unop (leOfHom i.unop) x }
  let fhom : F ⟶ G := { val := PresheafOfModules.homMk η (fun V r x => Fv_smul V.unop r x) }
  refine ⟨fhom, fun V hV x => ?_⟩
  change Fv V x = f V hV x
  exact Fv_val V hV x

theorem wc_cn_comparison_map_exists : wcCnFormalFns.{u} →
    ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B]
    [IsAdicComplete (IsLocalRing.maximalIdeal B) B] (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B))
    [IsProper h] (P : Scheme.{u}) (p : P ⟶ Z) (m : ℕ) (g : P ⟶ wcPm.{u} m),
    IsProper p → IsClosedImmersion (Limits.prod.lift (p ≫ h) g) →
    ∀ (Fs : ℕ → Z.Modules) (ψ : ∀ n, Fs (n + 1) ⟶ Fs n),
    wcCnAdicSys h (IsLocalRing.maximalIdeal B) Fs ψ →
    ∀ (F'' : P.Modules) (φ'' : ∀ n, F'' ⟶ (Scheme.Modules.pullback p).obj (Fs n)),
    wcCnAdicSys (p ≫ h) (IsLocalRing.maximalIdeal B) (fun n => (Scheme.Modules.pullback p).obj (Fs n))
      (fun n => (Scheme.Modules.pullback p).map (ψ n)) →
    wcCnAlg (p ≫ h) (IsLocalRing.maximalIdeal B) (fun n => (Scheme.Modules.pullback p).obj (Fs n))
      (fun n => (Scheme.Modules.pullback p).map (ψ n)) F'' φ'' →
    ∀ (Hs : ℕ → Z.Modules) (ψH : ∀ n, Hs (n + 1) ⟶ Hs n)
      (φH : ∀ n, (Scheme.Modules.pushforward p).obj F'' ⟶ Hs n),
    wcCnAdicSys h (IsLocalRing.maximalIdeal B) Hs ψH →
    wcCnAlg h (IsLocalRing.maximalIdeal B) Hs ψH ((Scheme.Modules.pushforward p).obj F'') φH →
    ∃ α : ∀ n, Fs n ⟶ Hs n, (∀ n, α (n + 1) ≫ ψH n = ψ n ≫ α n) ∧
      wcCnUnitRel p Fs F'' φ'' Hs φH α :=
by
  intro hFF B _ _ _ _ Z h _ P p m g hp hcl Fs ψ hF F'' φ'' hF' hF'' Hs ψH φH hHs hHalg
  classical
  let pf := Scheme.Modules.pushforward p
  let pb := Scheme.Modules.pullback p
  let adj := Scheme.Modules.pullbackPushforwardAdjunction p
  have compA : ∀ {X : Scheme.{u}} {M N K : X.Modules} (f : M ⟶ N) (g : N ⟶ K) (U : X.Opens)
      (x : Γ(M, U)), Scheme.Modules.Hom.app (f ≫ g) U x =
        Scheme.Modules.Hom.app g U (Scheme.Modules.Hom.app f U x) := by
    intro X M N K f g U x
    rw [Scheme.Modules.Hom.comp_app]
    rfl
  have idA : ∀ {X : Scheme.{u}} (M : X.Modules) (U : X.Opens) (x : Γ(M, U)),
      Scheme.Modules.Hom.app (𝟙 M) U x = x := by
    intro X M U x
    rw [Scheme.Modules.Hom.id_app]
    rfl
  have natApp : ∀ {M N : Z.Modules} (f : M ⟶ N) {A B : Z.Opens} (hle : B ≤ A) (x : Γ(M, A)),
      Scheme.Modules.Hom.app f B ((M.presheaf.map (homOfLE hle).op).hom x) =
      (N.presheaf.map (homOfLE hle).op).hom (Scheme.Modules.Hom.app f A x) :=
    fun f _ _ hle x => congrArg (fun k => k.hom x)
      ((Scheme.Modules.Hom.mapPresheaf f).naturality (homOfLE hle).op)
  let lin : ∀ {M N : Z.Modules} (f : M ⟶ N) (V : Z.Opens), Γ(M, V) →ₗ[Γ(Z, V)] Γ(N, V) :=
    fun f V =>
      { toFun := fun x => Scheme.Modules.Hom.app f V x
        map_add' := fun x y => map_add _ x y
        map_smul' := fun r x => Scheme.Modules.Hom.app_smul f r x }

  obtain ⟨c, hc⟩ := wc_cn_relative_ml B (IsLocalRing.maximalIdeal B) Z h P p m g hp hcl
    (fun n => pb.obj (Fs n)) (fun n => pb.map (ψ n)) F'' φ'' hF' hF''

  have hρη : ∀ (V : Z.Opens) k (x : Γ(Fs (k + 1), V)),
      Scheme.Modules.Hom.app (pf.map (pb.map (ψ k))) V
          (Scheme.Modules.Hom.app (adj.unit.app (Fs (k + 1))) V x) =
        Scheme.Modules.Hom.app (adj.unit.app (Fs k)) V (Scheme.Modules.Hom.app (ψ k) V x) := by
    intro V k x
    rw [← compA, ← compA]
    exact congrArg (fun f => Scheme.Modules.Hom.app f V x) (adj.unit_naturality (ψ k))
  have hρθ : ∀ (V : Z.Opens) k (y : Γ(pf.obj F'', V)),
      Scheme.Modules.Hom.app (pf.map (pb.map (ψ k))) V
          (Scheme.Modules.Hom.app (pf.map (φ'' (k + 1))) V y) =
        Scheme.Modules.Hom.app (pf.map (φ'' k)) V y := by
    intro V k y
    rw [← compA]
    have e : pf.map (φ'' (k + 1)) ≫ pf.map (pb.map (ψ k)) = pf.map (φ'' k) :=
      (Functor.map_comp _ _ _).symm.trans (congrArg pf.map (hF''.2.1 k))
    rw [e]
  have hI : ∀ (V : Z.Opens), IsAffineOpen V → ∀ q : ∀ k, Γ(pf.obj (pb.obj (Fs k)), V),
      (∀ k, Scheme.Modules.Hom.app (pf.map (pb.map (ψ k))) V (q (k + 1)) = q k) →
      ∀ k, ∃ y : Γ(pf.obj F'', V), Scheme.Modules.Hom.app (pf.map (φ'' k)) V y = q k := by
    intro V hV q hq k
    obtain ⟨s, hs⟩ := (hc V hV k).2 (q (k + c))
    refine ⟨s, ?_⟩
    have htr : ∀ j, Scheme.Modules.Hom.app
        (wcCnTrans (Gs := fun n => pb.obj (Fs n)) (fun n => pb.map (ψ n)) k j) (p ⁻¹ᵁ V)
          (q (k + j)) = q k := by
      intro j
      induction j with
      | zero => exact idA (pb.obj (Fs k)) (p ⁻¹ᵁ V) (q k)
      | succ j ih =>
        have e1 : Scheme.Modules.Hom.app (pb.map (ψ (k + j))) (p ⁻¹ᵁ V) (q (k + j + 1)) =
            q (k + j) := hq (k + j)
        have e2 := compA (pb.map (ψ (k + j)))
          (wcCnTrans (Gs := fun n => pb.obj (Fs n)) (fun n => pb.map (ψ n)) k j)
          (p ⁻¹ᵁ V) (q (k + j + 1))
        rw [e1] at e2
        exact e2.trans ih
    exact hs.trans (htr c)

  have core : ∀ (V : Z.Opens) (hV : IsAffineOpen V),
      ∃ α : ∀ k, Γ(Fs k, V) →ₗ[Γ(Z, V)] Γ(Hs k, V),
        (∀ k (x : Γ(Fs (k + 1), V)), Scheme.Modules.Hom.app (ψH k) V (α (k + 1) x) =
          α k (Scheme.Modules.Hom.app (ψ k) V x)) ∧
        (∀ k (x : Γ(Fs k, V)) (y : Γ(pf.obj F'', V)), Scheme.Modules.Hom.app (φH k) V y = α k x →
          Scheme.Modules.Hom.app (pf.map (φ'' k)) V y =
            Scheme.Modules.Hom.app (adj.unit.app (Fs k)) V x) ∧
        ∀ (X : ∀ k, Γ(Fs k, V)), (∀ k, Scheme.Modules.Hom.app (ψ k) V (X (k + 1)) = X k) →
          ∀ (n k : ℕ) (y : Γ(pf.obj F'', V)), n + c ≤ k →
          Scheme.Modules.Hom.app (pf.map (φ'' k)) V y =
            Scheme.Modules.Hom.app (adj.unit.app (Fs k)) V (X k) →
          α n (X n) = Scheme.Modules.Hom.app (φH n) V y := by
    intro V hV
    refine wc_cn_unit_lift_core Γ(Z, V)
      (fun k => Ideal.map (wcCnSigma h V) (IsLocalRing.maximalIdeal B ^ (k + 1)))
      (fun k => Γ(Fs k, V)) (fun k => Γ(pf.obj (pb.obj (Fs k)), V)) (fun k => Γ(Hs k, V))
      Γ(pf.obj F'', V) (fun k => lin (ψ k) V) (fun k => lin (pf.map (pb.map (ψ k))) V)
      (fun k => lin (ψH k) V) (fun k => lin (adj.unit.app (Fs k)) V)
      (fun k => lin (pf.map (φ'' k)) V) (fun k => lin (φH k) V) c ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_
    · intro n k hnk
      exact Ideal.map_mono (Ideal.pow_le_pow_right (by omega))
    · intro k
      exact (hF.2.1 k V hV).1
    · intro n x
      exact wc_cn_seq_extend (fun k => Γ(Fs k, V)) (fun k x => lin (ψ k) V x)
        (fun k => (hF.2.1 k V hV).1) n x
    · intro k x hx
      exact ((hF.2.1 k V hV).2 x).mp hx
    · intro k x
      exact hρη V k x
    · intro k y
      exact hρθ V k y
    · intro k y
      have e := congrArg (fun f => Scheme.Modules.Hom.app f V y) (hHalg.2.1 k)
      simp only at e
      rw [compA] at e
      exact e
    · intro k y
      exact (hHalg.2.2 k V hV).2 y
    · intro k y hy
      refine Submodule.smul_induction_on (p := fun y => lin (pf.map (φ'' k)) V y = 0) hy ?_ ?_
      · intro a ha z _
        show lin (pf.map (φ'' k)) V (a • z) = 0
        rw [map_smul]
        exact wc_cn_pushforward_killed B (IsLocalRing.maximalIdeal B ^ (k + 1)) Z P h p
          (pb.obj (Fs k)) (fun W hW => hF'.2.2 k W hW) V a ha _
      · intro x y hx hy
        show lin (pf.map (φ'' k)) V (x + y) = 0
        rw [map_add, hx, hy, add_zero]
    · intro n y hy
      exact (hc V hV n).1 y hy
    · intro q hq k
      exact hI V hV q hq k
  choose α₀ hα₀ using core

  have hnat : ∀ n (V V' : Z.Opens) (hV : IsAffineOpen V) (hV' : IsAffineOpen V') (hle : V' ≤ V)
      (x : Γ(Fs n, V)), α₀ V' hV' n (((Fs n).presheaf.map (homOfLE hle).op).hom x) =
        ((Hs n).presheaf.map (homOfLE hle).op).hom (α₀ V hV n x) := by
    intro n V V' hV hV' hle x
    obtain ⟨X, hX, hXn⟩ := wc_cn_seq_extend (fun k => Γ(Fs k, V))
      (fun k x => Scheme.Modules.Hom.app (ψ k) V x) (fun k => (hF.2.1 k V hV).1) n x
    have hqc : ∀ k, Scheme.Modules.Hom.app (pf.map (pb.map (ψ k))) V
        (Scheme.Modules.Hom.app (adj.unit.app (Fs (k + 1))) V (X (k + 1))) =
        Scheme.Modules.Hom.app (adj.unit.app (Fs k)) V (X k) := by
      intro k
      rw [hρη V k, hX k]
    obtain ⟨y, hy⟩ := hI V hV
      (fun k => Scheme.Modules.Hom.app (adj.unit.app (Fs k)) V (X k)) hqc (n + c)
    have h1 := (hα₀ V hV).2.2 X hX n (n + c) y le_rfl hy
    rw [hXn] at h1
    let X' : ∀ k, Γ(Fs k, V') := fun k => ((Fs k).presheaf.map (homOfLE hle).op).hom (X k)
    have hX' : ∀ k, Scheme.Modules.Hom.app (ψ k) V' (X' (k + 1)) = X' k := by
      intro k
      show Scheme.Modules.Hom.app (ψ k) V' (((Fs (k + 1)).presheaf.map (homOfLE hle).op).hom
        (X (k + 1))) = ((Fs k).presheaf.map (homOfLE hle).op).hom (X k)
      rw [natApp, hX k]
    let y' : Γ(pf.obj F'', V') := ((pf.obj F'').presheaf.map (homOfLE hle).op).hom y
    have hy' : Scheme.Modules.Hom.app (pf.map (φ'' (n + c))) V' y' =
        Scheme.Modules.Hom.app (adj.unit.app (Fs (n + c))) V' (X' (n + c)) := by
      show Scheme.Modules.Hom.app (pf.map (φ'' (n + c))) V'
          (((pf.obj F'').presheaf.map (homOfLE hle).op).hom y) =
        Scheme.Modules.Hom.app (adj.unit.app (Fs (n + c))) V'
          (((Fs (n + c)).presheaf.map (homOfLE hle).op).hom (X (n + c)))
      rw [natApp (pf.map (φ'' (n + c))) hle y, hy]
      exact (natApp (adj.unit.app (Fs (n + c))) hle (X (n + c))).symm
    have h2 := (hα₀ V' hV').2.2 X' hX' n (n + c) y' le_rfl hy'
    have hX'n : X' n = ((Fs n).presheaf.map (homOfLE hle).op).hom x := by
      show ((Fs n).presheaf.map (homOfLE hle).op).hom (X n) = _
      rw [hXn]
    rw [hX'n] at h2
    rw [h2, h1]
    exact natApp (φH n) hle y

  choose α hα using fun n => wc_cn_modules_hom_of_affine Z (Fs n) (Hs n)
    (fun V hV => α₀ V hV n) (fun V V' hV hV' hle x => hnat n V V' hV hV' hle x)
  have extA : ∀ (M N : Z.Modules) (f g : M ⟶ N), (∀ (U : Z.Opens), IsAffineOpen U →
      ∀ x : Γ(M, U), Scheme.Modules.Hom.app f U x = Scheme.Modules.Hom.app g U x) → f = g := by
    intro M N f g H
    apply Scheme.Modules.hom_ext
    intro U
    refine ConcreteCategory.hom_ext _ _ (fun y => ?_)
    let NS : TopCat.Sheaf Ab Z := ⟨N.presheaf, N.isSheaf⟩
    refine TopCat.Sheaf.eq_of_locally_eq' NS (fun W : {W : Z.affineOpens // W.1 ≤ U} => W.1.1) U
      (fun W => homOfLE W.2) ?_ _ _ ?_
    · intro z hz
      obtain ⟨W, hW, hzW, hWU⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp Z.isBasis_affineOpens) hz
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨⟨W, hW⟩, hWU⟩, hzW⟩
    · intro W
      change (N.presheaf.map (homOfLE W.2).op).hom (Scheme.Modules.Hom.app f U y) =
        (N.presheaf.map (homOfLE W.2).op).hom (Scheme.Modules.Hom.app g U y)
      rw [← natApp, ← natApp]
      exact H _ W.1.2 _
  refine ⟨α, fun n => ?_, ?_⟩
  ·
    apply extA
    intro V hV x
    rw [compA, compA, hα (n + 1) V hV x, hα n V hV]
    exact (hα₀ V hV).1 n x
  ·
    intro V hV n x y hyx
    rw [hα n V hV x] at hyx
    exact (hα₀ V hV).2.1 n x y hyx

theorem wc_adic_limit_submodule_fg : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (𝔞 : Ideal R)
    (N : ℕ → Type u) [∀ n, AddCommGroup (N n)] [∀ n, Module R (N n)]
    (ψ : ∀ n, N (n + 1) →ₗ[R] N n),
    (∀ n, Module.Finite R (N n)) →
    (∀ n, ∀ a ∈ 𝔞 ^ (n + 1), ∀ x : N n, a • x = 0) →
    (∀ n, Function.Surjective (ψ n)) →
    (∀ n (x : N (n + 1)), ψ n x = 0 ↔ x ∈ 𝔞 ^ (n + 1) • (⊤ : Submodule R (N (n + 1)))) →
    ∀ K : Set (∀ n, N n), (∀ x ∈ K, ∀ n, ψ n (x (n + 1)) = x n) → (0 : ∀ n, N n) ∈ K →
    (∀ x ∈ K, ∀ y ∈ K, x + y ∈ K) →
    (∀ x ∈ K, ∀ d : ℕ → R, (∀ n, d (n + 1) - d n ∈ 𝔞 ^ (n + 1)) → (fun n => d n • x n) ∈ K) →
    ∃ (k : ℕ) (gen : Fin k → ∀ n, N n), (∀ i, gen i ∈ K) ∧
      ∀ x ∈ K, ∃ d : Fin k → ℕ → R, (∀ i n, d i (n + 1) - d i n ∈ 𝔞 ^ (n + 1)) ∧
        ∀ n, x n = ∑ i, d i n • gen i n :=
by
  intro R _ _ 𝔞 N _ _ ψ hfin hkill hsurj hker K hKc hK0 hKadd hKsmul
  classical

  obtain ⟨r, f, hf⟩ := Submodule.fg_iff_exists_fin_generating_family.mp
    (IsNoetherian.noetherian 𝔞)
  have hfI : ∀ i, f i ∈ 𝔞 := fun i => hf ▸ Ideal.subset_span ⟨i, rfl⟩

  have H2 : ∀ (m : ℕ) (q : MvPolynomial (Fin r) R),
      (∀ d : Fin r →₀ ℕ, d.degree < m → q.coeff d = 0) → MvPolynomial.eval f q ∈ 𝔞 ^ m := by
    intro m q hq
    rw [MvPolynomial.eval_eq']
    refine Ideal.sum_mem _ (fun d hd => ?_)
    have hdeg : m ≤ d.degree := by
      by_contra h
      exact (MvPolynomial.mem_support_iff.mp hd) (hq d (not_le.mp h))
    apply Ideal.mul_mem_left
    have h1 : ∏ i, f i ^ d i ∈ ∏ i, 𝔞 ^ d i :=
      Ideal.prod_mem_prod (fun i _ => Ideal.pow_mem_pow (hfI i) _)
    rw [Finset.prod_pow_eq_pow_sum, ← Finsupp.degree_eq_sum] at h1
    exact Ideal.pow_le_pow_right hdeg h1

  have H3' : ∀ (m : ℕ) (y : R), y ∈ Ideal.span (Set.range f) ^ m →
      ∃ h : MvPolynomial (Fin r) R, h.IsHomogeneous m ∧ MvPolynomial.eval f h = y := by
    intro m
    induction m with
    | zero =>
      intro y _
      exact ⟨MvPolynomial.C y, MvPolynomial.isHomogeneous_C _ _, MvPolynomial.eval_C _⟩
    | succ m ih =>
      intro y hy
      rw [pow_succ] at hy
      refine Submodule.mul_induction_on hy ?_ ?_
      · intro a ha b hb
        obtain ⟨ha', hah, hae⟩ := ih a ha
        obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hb
        refine ⟨ha' * ∑ i, MvPolynomial.C (c i) * MvPolynomial.X i, ?_, ?_⟩
        · apply hah.mul
          apply MvPolynomial.IsHomogeneous.sum
          intro i _
          have := (MvPolynomial.isHomogeneous_C (Fin r) (c i)).mul
            (MvPolynomial.isHomogeneous_X R i)
          rwa [zero_add] at this
        · simp only [map_mul, map_sum, MvPolynomial.eval_C, MvPolynomial.eval_X, hae, hc]
      · rintro _ _ ⟨h1, hh1, he1⟩ ⟨h2, hh2, he2⟩
        exact ⟨h1 + h2, hh1.add hh2, by rw [map_add, he1, he2]⟩
  have H3 : ∀ (m : ℕ) (y : R), y ∈ 𝔞 ^ m →
      ∃ h : MvPolynomial (Fin r) R, h.IsHomogeneous m ∧ MvPolynomial.eval f h = y := by
    intro m y hy
    rw [← hf] at hy
    exact H3' m y hy

  obtain ⟨τ, hτ⟩ : ∃ τ : ℕ → MvPowerSeries (Fin r) R → R, ∀ n F,
      τ n F = MvPolynomial.eval f (MvPowerSeries.truncTotal (n + 1) F) := ⟨_, fun _ _ => rfl⟩
  have τadd : ∀ n F G, τ n (F + G) = τ n F + τ n G := by
    intro n F G
    rw [hτ, hτ, hτ, map_add, map_add]
  have τzero : ∀ n, τ n 0 = 0 := by
    intro n
    rw [hτ, map_zero, map_zero]
  have τcauchy : ∀ F n, τ (n + 1) F - τ n F ∈ 𝔞 ^ (n + 1) := by
    intro F n
    rw [hτ, hτ, ← map_sub]
    apply H2
    intro d hd
    rw [MvPolynomial.coeff_sub, MvPowerSeries.coeff_truncTotal _ (by omega),
      MvPowerSeries.coeff_truncTotal _ hd, sub_self]
  have τmul : ∀ n F G, τ n (F * G) - τ n F * τ n G ∈ 𝔞 ^ (n + 1) := by
    intro n F G
    rw [hτ, hτ, hτ, ← map_mul, ← map_sub]
    apply H2
    intro d hd
    rw [MvPolynomial.coeff_sub, sub_eq_zero, MvPowerSeries.coeff_truncTotal _ hd,
      MvPowerSeries.coeff_mul, MvPolynomial.coeff_mul]
    refine Finset.sum_congr rfl (fun p hp => ?_)
    have hp' := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
    have h1 : p.1.degree + p.2.degree = d.degree := by
      rw [← hp', Finsupp.degree_eq_sum, Finsupp.degree_eq_sum, Finsupp.degree_eq_sum,
        ← Finset.sum_add_distrib]
      rfl
    rw [MvPowerSeries.coeff_truncTotal _ (by omega), MvPowerSeries.coeff_truncTotal _ (by omega)]
  have τsurj : ∀ β : ℕ → R, (∀ n, β (n + 1) - β n ∈ 𝔞 ^ (n + 1)) →
      ∃ F : MvPowerSeries (Fin r) R, ∀ n, τ n F - β n ∈ 𝔞 ^ (n + 1) := by
    intro β hβ
    obtain ⟨c, hc0, hcs⟩ : ∃ c : ℕ → R, c 0 = β 0 ∧ ∀ j, c (j + 1) = β (j + 1) - β j :=
      ⟨fun k => Nat.rec (β 0) (fun j _ => β (j + 1) - β j) k, rfl, fun _ => rfl⟩
    have hcm : ∀ j, c j ∈ 𝔞 ^ j := by
      intro j
      cases j with
      | zero => rw [pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top
      | succ j => rw [hcs]; exact hβ j
    have hsum : ∀ n, ∑ j ∈ Finset.range (n + 1), c j = β n := by
      intro n
      induction n with
      | zero => rw [Finset.sum_range_one, hc0]
      | succ n ih => rw [Finset.sum_range_succ, ih, hcs]; ring
    choose h hh he using fun j => H3 j (c j) (hcm j)
    let F : MvPowerSeries (Fin r) R := fun e => (h e.degree).coeff e
    refine ⟨F, fun n => ?_⟩
    have hev : ∑ j ∈ Finset.range (n + 1), c j =
        MvPolynomial.eval f (∑ j ∈ Finset.range (n + 1), h j) := by
      rw [map_sum]
      exact Finset.sum_congr rfl (fun j _ => (he j).symm)
    rw [← hsum n, hτ, hev, ← map_sub]
    apply H2
    intro d hd
    rw [MvPolynomial.coeff_sub, MvPowerSeries.coeff_truncTotal _ hd, MvPolynomial.coeff_sum,
      Finset.sum_eq_single_of_mem d.degree (Finset.mem_range.mpr hd)]
    · rw [sub_eq_zero]; rfl
    · intro j _ hj
      exact (hh j).coeff_eq_zero (Ne.symm hj)

  have hkl : ∀ n (a b : R) (y : N n), a - b ∈ 𝔞 ^ (n + 1) → a • y = b • y := by
    intro n a b y hab
    rw [← sub_eq_zero, ← sub_smul]
    exact hkill n _ hab y

  obtain ⟨k, g, hg⟩ := @Module.Finite.exists_fin R (N 0) _ _ _ (hfin 0)
  choose s hs using hsurj
  obtain ⟨e, he0, hes⟩ : ∃ e : Fin k → ∀ n, N n, (∀ l, e l 0 = g l) ∧
      ∀ l n, e l (n + 1) = s n (e l n) :=
    ⟨fun l n => Nat.rec (motive := fun n => N n) (g l) (fun n y => s n y) n,
      fun _ => rfl, fun _ _ => rfl⟩
  have hec : ∀ l n, ψ n (e l (n + 1)) = e l n := fun l n => by rw [hes]; exact hs n _

  have hA : ∀ n, Submodule.span R (Set.range fun l => e l n) = ⊤ := by
    intro n
    induction n with
    | zero =>
      have : (fun l => e l 0) = g := funext he0
      rw [this]; exact hg
    | succ n ih =>
      set E := Submodule.span R (Set.range fun l => e l (n + 1)) with hE
      have h1 : (⊤ : Submodule R (N (n + 1))) ≤ E ⊔ 𝔞 ^ (n + 1) • ⊤ := by
        intro y _
        have hy : ψ n y ∈ Submodule.span R (Set.range fun l => e l n) := by rw [ih]; trivial
        obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun R).mp hy
        have hz : y - ∑ l, c l • e l (n + 1) ∈ 𝔞 ^ (n + 1) • (⊤ : Submodule R (N (n + 1))) := by
          apply (hker n _).mp
          rw [map_sub, map_sum, ← hc, sub_eq_zero]
          refine Finset.sum_congr rfl (fun l _ => ?_)
          rw [LinearMap.map_smul, hec]
        have hEm : ∑ l, c l • e l (n + 1) ∈ E :=
          (Submodule.mem_span_range_iff_exists_fun R).mpr ⟨c, rfl⟩
        have hyy : y = ∑ l, c l • e l (n + 1) + (y - ∑ l, c l • e l (n + 1)) := by abel
        rw [hyy]
        exact Submodule.add_mem_sup hEm hz
      have hJJ : 𝔞 ^ (n + 1) * 𝔞 ^ (n + 1) ≤ 𝔞 ^ (n + 1 + 1) := by
        rw [← pow_add]; exact Ideal.pow_le_pow_right (by omega)
      have h2 : 𝔞 ^ (n + 1) • (⊤ : Submodule R (N (n + 1))) ≤ E := by
        have h3 : 𝔞 ^ (n + 1) • (⊤ : Submodule R (N (n + 1))) ≤
            𝔞 ^ (n + 1) • (E ⊔ 𝔞 ^ (n + 1) • ⊤) :=
          Submodule.smul_le.mpr fun a ha y hy => Submodule.smul_mem_smul ha (h1 hy)
        rw [Submodule.smul_sup, ← Submodule.mul_smul] at h3
        refine h3.trans (sup_le Submodule.smul_le_right ?_)
        rw [Submodule.smul_le]
        intro a ha y _
        rw [hkill (n + 1) a (hJJ ha) y]
        exact Submodule.zero_mem _
      exact eq_top_iff.mpr (h1.trans (sup_le le_rfl h2))

  have hB : ∀ n (z : N (n + 1)), ψ n z = 0 →
      ∃ a : Fin k → R, (∀ l, a l ∈ 𝔞 ^ (n + 1)) ∧ z = ∑ l, a l • e l (n + 1) := by
    intro n z hz
    have h1 := (hker n z).mp hz
    rw [← hA (n + 1)] at h1
    obtain ⟨a, ha, hsum⟩ := (Submodule.mem_ideal_smul_span_iff_exists_sum _ _ _).mp h1
    refine ⟨a, ha, ?_⟩
    rw [← hsum]
    exact Finsupp.sum_fintype _ _ (fun i => zero_smul _ _)

  have hrep : ∀ x : ∀ n, N n, (∀ n, ψ n (x (n + 1)) = x n) →
      ∃ β : Fin k → ℕ → R, (∀ l n, β l (n + 1) - β l n ∈ 𝔞 ^ (n + 1)) ∧
        ∀ n, x n = ∑ l, β l n • e l n := by
    intro x hx
    have hstep : ∀ n (b : Fin k → R), x n = ∑ l, b l • e l n →
        ∃ b' : Fin k → R, (∀ l, b' l - b l ∈ 𝔞 ^ (n + 1)) ∧
          x (n + 1) = ∑ l, b' l • e l (n + 1) := by
      intro n b hb
      obtain ⟨a, ha, hza⟩ := hB n (x (n + 1) - ∑ l, b l • e l (n + 1)) (by
        rw [map_sub, map_sum, hx, hb, sub_eq_zero]
        refine Finset.sum_congr rfl (fun l _ => ?_)
        rw [LinearMap.map_smul, hec])
      refine ⟨b + a, fun l => by simpa using ha l, ?_⟩
      rw [sub_eq_iff_eq_add] at hza
      rw [hza, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun l _ => ?_)
      rw [Pi.add_apply, add_smul]
      exact add_comm _ _
    obtain ⟨b0, hb0⟩ := (Submodule.mem_span_range_iff_exists_fun R).mp
      (show x 0 ∈ Submodule.span R (Set.range fun l => e l 0) by rw [hA 0]; trivial)
    have hstep' : ∀ n, ∀ b : {b : Fin k → R // x n = ∑ l, b l • e l n},
        ∃ b' : {b' : Fin k → R // x (n + 1) = ∑ l, b' l • e l (n + 1)},
          ∀ l, b'.1 l - b.1 l ∈ 𝔞 ^ (n + 1) := by
      intro n b
      obtain ⟨b', h1, h2⟩ := hstep n b.1 b.2
      exact ⟨⟨b', h2⟩, h1⟩
    choose step hstep2 using hstep'
    obtain ⟨B, -, hBs⟩ : ∃ B : ∀ n, {b : Fin k → R // x n = ∑ l, b l • e l n},
        B 0 = ⟨b0, hb0.symm⟩ ∧ ∀ n, B (n + 1) = step n (B n) :=
      ⟨fun n => Nat.rec (motive := fun n => {b : Fin k → R // x n = ∑ l, b l • e l n})
        ⟨b0, hb0.symm⟩ (fun n b => step n b) n, rfl, fun _ => rfl⟩
    refine ⟨fun l n => (B n).1 l, fun l n => ?_, fun n => (B n).2⟩
    show (B (n + 1)).1 l - (B n).1 l ∈ 𝔞 ^ (n + 1)
    rw [hBs]
    exact hstep2 n (B n) l

  haveI : IsNoetherianRing (MvPowerSeries (Fin r) R) := MvPowerSeries.isNoetherianRing R
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : (Fin k → MvPowerSeries (Fin r) R) →+ (∀ n, N n),
      ∀ G n, Φ G n = ∑ l, τ n (G l) • e l n :=
    ⟨{ toFun := fun G n => ∑ l, τ n (G l) • e l n
       map_zero' := by
         funext n
         simp [τzero]
       map_add' := by
         intro G H
         funext n
         simp [τadd, add_smul, Finset.sum_add_distrib] }, fun _ _ => rfl⟩
  have hΦs : ∀ (c : MvPowerSeries (Fin r) R) G n, Φ (c • G) n = τ n c • Φ G n := by
    intro c G n
    rw [hΦ, hΦ, Finset.smul_sum]
    refine Finset.sum_congr rfl (fun l _ => ?_)
    rw [Pi.smul_apply, smul_eq_mul, smul_smul]
    exact hkl n _ _ _ (τmul n c (G l))
  have hΦon : ∀ x : ∀ n, N n, (∀ n, ψ n (x (n + 1)) = x n) → ∃ F, Φ F = x := by
    intro x hx
    obtain ⟨β, hβ, hxβ⟩ := hrep x hx
    choose F hF using fun l => τsurj (β l) (hβ l)
    refine ⟨F, funext fun n => ?_⟩
    rw [hΦ, hxβ n]
    refine Finset.sum_congr rfl (fun l _ => ?_)
    exact hkl n _ _ _ (hF l n)
  obtain ⟨L, hL⟩ : ∃ L : Submodule (MvPowerSeries (Fin r) R) (Fin k → MvPowerSeries (Fin r) R),
      ∀ G, G ∈ L ↔ Φ G ∈ K :=
    ⟨{ carrier := {G | Φ G ∈ K}
       add_mem' := by
         intro G H hG hH
         show Φ (G + H) ∈ K
         rw [map_add]
         exact hKadd _ hG _ hH
       zero_mem' := by
         show Φ 0 ∈ K
         rw [map_zero]
         exact hK0
       smul_mem' := by
         intro c G hG
         show Φ (c • G) ∈ K
         have : Φ (c • G) = fun n => τ n c • Φ G n := funext (hΦs c G)
         rw [this]
         exact hKsmul _ hG _ (fun n => τcauchy c n) }, fun _ => Iff.rfl⟩
  obtain ⟨m, G, hG⟩ := Submodule.fg_iff_exists_fin_generating_family.mp
    (IsNoetherian.noetherian L)
  refine ⟨m, fun j => Φ (G j), fun j => (hL _).mp (by rw [← hG]; exact Submodule.subset_span ⟨j, rfl⟩), ?_⟩
  intro x hx
  obtain ⟨F, hF⟩ := hΦon x (hKc x hx)
  have hFL : F ∈ Submodule.span (MvPowerSeries (Fin r) R) (Set.range G) := by
    rw [hG]
    exact (hL F).mpr (by rw [hF]; exact hx)
  obtain ⟨H, hH⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hFL
  refine ⟨fun j n => τ n (H j), fun j n => τcauchy (H j) n, fun n => ?_⟩
  rw [← hF, ← hH, map_sum, Finset.sum_apply]
  refine Finset.sum_congr rfl (fun j _ => ?_)
  exact hΦs (H j) (G j) n

theorem wc_cn_chart_cech_cover : ∀ (B : Type u) [CommRing B] (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B))
    [IsProper h] (P : Scheme.{u}) (p : P ⟶ Z) (m : ℕ) (g : P ⟶ wcPm.{u} m),
    IsClosedImmersion (Limits.prod.lift (p ≫ h) g) → ∀ (V : Z.Opens), IsAffineOpen V →
    ∃ (r : ℕ) (W : Fin r → P.Opens), (∀ i, W i ≤ p ⁻¹ᵁ V) ∧ (∀ i, IsAffineOpen (W i)) ∧
      (∀ x ∈ p ⁻¹ᵁ V, ∃ i, x ∈ W i) ∧ (∀ i j, IsAffineOpen (W i ⊓ W j)) :=
by
  intro B _ Z h _ P p m g hι V hV
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) :=
    MvPolynomial.gradedAlgebra

  have s1 : ∀ q : MvPolynomial (Fin (m + 1)) (ULift.{u} ℤ),
      MvPolynomial.homogeneousComponent 0 q = 0 →
      q ∈ Ideal.span (Set.range (MvPolynomial.X : Fin (m + 1) →
        MvPolynomial (Fin (m + 1)) (ULift.{u} ℤ))) := by
    intro q hq
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m' hm
    rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at hq
    have hm0 : m' ≠ 0 := by
      rintro rfl
      exact (MvPolynomial.mem_support_iff.mp hm) hq
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hm0
    exact ⟨i, Set.mem_univ i, hi⟩
  have hsup := Proj.iSup_basicOpen_eq_top
    (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ))
    (MvPolynomial.X : Fin (m + 1) → MvPolynomial (Fin (m + 1)) (ULift.{u} ℤ))
    (fun q hq => s1 q (((MvPolynomial.decomposition.decompose'_apply q 0).symm.trans
      ((HomogeneousIdeal.mem_irrelevant_iff _ q).mp hq))))
  have hcov : ∀ y : P, ∃ k, y ∈ g ⁻¹ᵁ wcPmChart.{u} m k := by
    intro y
    have hy : g y ∈ (⨆ k, wcPmChart.{u} m k) := by
      have e : (⨆ k, wcPmChart.{u} m k) = ⊤ := hsup
      rw [e]
      trivial
    obtain ⟨k, hk⟩ := TopologicalSpace.Opens.mem_iSup.mp hy
    exact ⟨k, hk⟩

  haveI hsnd : IsAffineHom (Limits.prod.snd : Spec (.of B) ⨯ wcPm.{u} m ⟶ wcPm.{u} m) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom)
      (IsPullback.of_hasBinaryProduct' (Spec (.of B)) (wcPm.{u} m))
      (inferInstance : IsAffineHom (Limits.terminal.from (Spec (.of B))))
  haveI hcomp : IsAffineHom (Limits.prod.lift (p ≫ h) g ≫ Limits.prod.snd) := inferInstance
  haveI hg : IsAffineHom g := by
    rw [Limits.prod.lift_snd] at hcomp
    exact hcomp

  have hD : ∀ k : Fin (m + 1), IsAffineOpen (g ⁻¹ᵁ wcPmChart.{u} m k) := fun k =>
    (Proj.isAffineOpen_basicOpen (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ))
      (MvPolynomial.X k) (m := 1)
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k))
      Nat.one_pos).preimage g
  have hD2 : ∀ k l : Fin (m + 1),
      IsAffineOpen (g ⁻¹ᵁ wcPmChart.{u} m k ⊓ g ⁻¹ᵁ wcPmChart.{u} m l) := by
    intro k l
    have hA := (Proj.isAffineOpen_basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ))
      (MvPolynomial.X k * MvPolynomial.X l) (m := 1 + 1)
      ((MvPolynomial.mem_homogeneousSubmodule (1 + 1) _).mpr
        ((MvPolynomial.isHomogeneous_X _ k).mul (MvPolynomial.isHomogeneous_X _ l)))
      (by norm_num)).preimage g
    rw [Proj.basicOpen_mul, Scheme.Hom.preimage_inf] at hA
    exact hA

  have key : ∀ O : P.Opens, IsAffineOpen O → IsAffineOpen (O ⊓ p ⁻¹ᵁ V) := by
    intro O hO
    haveI : IsAffine O := hO
    haveI : IsAffineHom ((O.ι ≫ p) ≫ h) := inferInstance
    haveI : IsAffineHom (O.ι ≫ p) := IsAffineHom.of_comp (O.ι ≫ p) h
    have h1 := (hV.preimage (O.ι ≫ p)).image_of_isOpenImmersion O.ι
    have e : O.ι ''ᵁ ((O.ι ≫ p) ⁻¹ᵁ V) = O ⊓ p ⁻¹ᵁ V := by
      rw [Scheme.Hom.comp_preimage]
      exact (Scheme.Hom.image_preimage_eq_opensRange_inf O.ι (p ⁻¹ᵁ V)).trans
        (congrArg (· ⊓ p ⁻¹ᵁ V) (Scheme.Opens.opensRange_ι O))
    rw [e] at h1
    exact h1
  refine ⟨m + 1, fun k => g ⁻¹ᵁ wcPmChart.{u} m k ⊓ p ⁻¹ᵁ V, fun k => inf_le_right,
    fun k => key _ (hD k), fun x hx => ?_, fun k l => ?_⟩
  · obtain ⟨k, hk⟩ := hcov x
    exact ⟨k, ⟨hk, hx⟩⟩
  · have e : (g ⁻¹ᵁ wcPmChart.{u} m k ⊓ p ⁻¹ᵁ V) ⊓ (g ⁻¹ᵁ wcPmChart.{u} m l ⊓ p ⁻¹ᵁ V) =
        (g ⁻¹ᵁ wcPmChart.{u} m k ⊓ g ⁻¹ᵁ wcPmChart.{u} m l) ⊓ p ⁻¹ᵁ V := by
      rw [inf_inf_inf_comm, inf_idem]
    show IsAffineOpen ((g ⁻¹ᵁ wcPmChart.{u} m k ⊓ p ⁻¹ᵁ V) ⊓ (g ⁻¹ᵁ wcPmChart.{u} m l ⊓ p ⁻¹ᵁ V))
    rw [e]
    exact key _ (hD2 k l)

theorem wc_cn_cech_gluing_iso : ∀ (Z P : Scheme.{u}) (p : P ⟶ Z) (V : Z.Opens) (r : ℕ)
    (W : Fin r → P.Opens) (hW : ∀ i, W i ≤ p ⁻¹ᵁ V) [∀ i, Algebra Γ(Z, V) Γ(P, W i)]
    [∀ i j, Algebra Γ(Z, V) Γ(P, W i ⊓ W j)]
    (ρl : ∀ i j, Γ(P, W i) →ₐ[Γ(Z, V)] Γ(P, W i ⊓ W j))
    (ρr : ∀ i j, Γ(P, W j) →ₐ[Γ(Z, V)] Γ(P, W i ⊓ W j)),
    wcCnChartCompat p V W hW ρl ρr →
    ∀ (Fs : ℕ → Z.Modules) (ψ : ∀ n, Fs (n + 1) ⟶ Fs n),
    (∀ n i, ∃ e : TensorProduct Γ(Z, V) Γ(P, W i) Γ(Fs n, V) ≃ₗ[Γ(P, W i)]
        Γ((Scheme.Modules.pullback p).obj (Fs n), W i),
      ∀ (a : Γ(P, W i)) (x : Γ(Fs n, V)), e (a ⊗ₜ[Γ(Z, V)] x) =
        a • (((Scheme.Modules.pullback p).obj (Fs n)).presheaf.map (homOfLE (hW i)).op).hom
          (Scheme.Modules.Hom.app ((Scheme.Modules.pullbackPushforwardAdjunction p).unit.app (Fs n))
            V x)) →
    (∀ n i j, ∃ e : TensorProduct Γ(Z, V) Γ(P, W i ⊓ W j) Γ(Fs n, V) ≃ₗ[Γ(P, W i ⊓ W j)]
        Γ((Scheme.Modules.pullback p).obj (Fs n), W i ⊓ W j),
      ∀ (a : Γ(P, W i ⊓ W j)) (x : Γ(Fs n, V)), e (a ⊗ₜ[Γ(Z, V)] x) =
        a • (((Scheme.Modules.pullback p).obj (Fs n)).presheaf.map
            (homOfLE (le_trans inf_le_left (hW i) : W i ⊓ W j ≤ p ⁻¹ᵁ V)).op).hom
          (Scheme.Modules.Hom.app ((Scheme.Modules.pullbackPushforwardAdjunction p).unit.app (Fs n))
            V x)) →
    ∃ Φ : ∀ n, Γ((Scheme.Modules.pushforward p).obj ((Scheme.Modules.pullback p).obj (Fs n)), V) →ₗ[Γ(Z, V)]
        (∀ i, TensorProduct Γ(Z, V) Γ(P, W i) Γ(Fs n, V)),
      (∀ n, Function.Injective (Φ n)) ∧
      (∀ n s, Φ n s ∈ wcCnCechT (fun i => Γ(P, W i)) (fun i j => Γ(P, W i ⊓ W j)) ρl ρr Γ(Fs n, V)) ∧
      (∀ n, ∀ τ ∈ wcCnCechT (fun i => Γ(P, W i)) (fun i j => Γ(P, W i ⊓ W j)) ρl ρr Γ(Fs n, V),
        ∃ s, Φ n s = τ) ∧
      (∀ n (x : Γ(Fs n, V)), Φ n (Scheme.Modules.Hom.app
          ((Scheme.Modules.pullbackPushforwardAdjunction p).unit.app (Fs n)) V x) =
        fun i => (1 : Γ(P, W i)) ⊗ₜ[Γ(Z, V)] x) ∧
      (∀ n s, Φ n (Scheme.Modules.Hom.app ((Scheme.Modules.pushforward p).map
          ((Scheme.Modules.pullback p).map (ψ n))) V s) =
        fun i => LinearMap.lTensor Γ(P, W i) (wcCnSecLin (ψ n) V) (Φ (n + 1) s i)) :=
by
  intro Z P p V r W hW _ _ ρl ρr hc Fs ψ hκ1 hκ2
  obtain ⟨_, hC2, _, hC4, _, hC6, hC7⟩ := hc
  choose e he using hκ1
  choose e2 he2 using hκ2

  have resG : ∀ (M : P.Modules) {A B C : P.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (x : Γ(M, A)),
      (M.presheaf.map (homOfLE h2).op).hom ((M.presheaf.map (homOfLE h1).op).hom x) =
      (M.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro M A B C h1 h2 x
    change (M.presheaf.map (homOfLE h1).op ≫ M.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    all_goals rfl

  have natr : ∀ {A' B' : P.Modules} (g : A' ⟶ B') {O O' : P.Opens} (hOO : O' ≤ O)
      (x : Γ(A', O)),
      Scheme.Modules.Hom.app g O' ((A'.presheaf.map (homOfLE hOO).op).hom x) =
        (B'.presheaf.map (homOfLE hOO).op).hom (Scheme.Modules.Hom.app g O x) := by
    intro A' B' g O O' hOO x
    exact NatTrans.naturality_apply (Scheme.Modules.Hom.mapPresheaf g) (homOfLE hOO).op x
  have hcompZ : ∀ {A A' A'' : Z.Modules} (f : A ⟶ A') (g' : A' ⟶ A'') (U : Z.Opens)
      (x : Γ(A, U)), Scheme.Modules.Hom.app (f ≫ g') U x =
        Scheme.Modules.Hom.app g' U (Scheme.Modules.Hom.app f U x) := by
    intro A A' A'' f g' U x
    rw [Scheme.Modules.Hom.comp_app]; rfl

  have bridge : ∀ (F : Z.Modules) (O O' : P.Opens) (hO : O ≤ p ⁻¹ᵁ V) (hO' : O' ≤ p ⁻¹ᵁ V)
      (hOO : O' ≤ O) [Algebra Γ(Z, V) Γ(P, O)] [Algebra Γ(Z, V) Γ(P, O')]
      (ρ : Γ(P, O) →ₐ[Γ(Z, V)] Γ(P, O')),
      (∀ a : Γ(P, O), ρ a = (P.presheaf.map (homOfLE hOO).op).hom a) →
      ∀ (eO : TensorProduct Γ(Z, V) Γ(P, O) Γ(F, V) ≃ₗ[Γ(P, O)]
          Γ((Scheme.Modules.pullback p).obj F, O))
        (eO' : TensorProduct Γ(Z, V) Γ(P, O') Γ(F, V) ≃ₗ[Γ(P, O')]
          Γ((Scheme.Modules.pullback p).obj F, O')),
      (∀ (a : Γ(P, O)) (x : Γ(F, V)), eO (a ⊗ₜ[Γ(Z, V)] x) =
        a • (((Scheme.Modules.pullback p).obj F).presheaf.map (homOfLE hO).op).hom
          (Scheme.Modules.Hom.app ((Scheme.Modules.pullbackPushforwardAdjunction p).unit.app F)
            V x)) →
      (∀ (a : Γ(P, O')) (x : Γ(F, V)), eO' (a ⊗ₜ[Γ(Z, V)] x) =
        a • (((Scheme.Modules.pullback p).obj F).presheaf.map (homOfLE hO').op).hom
          (Scheme.Modules.Hom.app ((Scheme.Modules.pullbackPushforwardAdjunction p).unit.app F)
            V x)) →
      ∀ w : TensorProduct Γ(Z, V) Γ(P, O) Γ(F, V),
        (((Scheme.Modules.pullback p).obj F).presheaf.map (homOfLE hOO).op).hom (eO w) =
          eO' (LinearMap.rTensor Γ(F, V) ρ.toLinearMap w) := by
    intro F O O' hO hO' hOO _ _ ρ hρ eO eO' heO heO' w
    induction w using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul a x =>
      rw [heO, Scheme.Modules.map_smul, LinearMap.rTensor_tmul, AlgHom.toLinearMap_apply, heO',
        hρ]
      refine congrArg₂ (· • ·) rfl ?_
      exact resG _ hO hOO _
    | add w₁ w₂ h₁ h₂ => rw [map_add, map_add, map_add, map_add, h₁, h₂]

  have unitNat : ∀ (F G : Z.Modules) (u : F ⟶ G) (x : Γ(F, V)),
      Scheme.Modules.Hom.app ((Scheme.Modules.pullback p).map u) (p ⁻¹ᵁ V)
        (Scheme.Modules.Hom.app ((Scheme.Modules.pullbackPushforwardAdjunction p).unit.app F)
          V x) =
      Scheme.Modules.Hom.app ((Scheme.Modules.pullbackPushforwardAdjunction p).unit.app G) V
        (Scheme.Modules.Hom.app u V x) := by
    intro F G u x
    have h := congrArg (fun k => Scheme.Modules.Hom.app k V x)
      ((Scheme.Modules.pullbackPushforwardAdjunction p).unit_naturality u)
    simp only [hcompZ] at h
    exact h

  have tensNat : ∀ (F G : Z.Modules) (u : F ⟶ G) (O : P.Opens) (hO : O ≤ p ⁻¹ᵁ V)
      [Algebra Γ(Z, V) Γ(P, O)]
      (eF : TensorProduct Γ(Z, V) Γ(P, O) Γ(F, V) ≃ₗ[Γ(P, O)]
        Γ((Scheme.Modules.pullback p).obj F, O))
      (eG : TensorProduct Γ(Z, V) Γ(P, O) Γ(G, V) ≃ₗ[Γ(P, O)]
        Γ((Scheme.Modules.pullback p).obj G, O)),
      (∀ (a : Γ(P, O)) (x : Γ(F, V)), eF (a ⊗ₜ[Γ(Z, V)] x) =
        a • (((Scheme.Modules.pullback p).obj F).presheaf.map (homOfLE hO).op).hom
          (Scheme.Modules.Hom.app ((Scheme.Modules.pullbackPushforwardAdjunction p).unit.app F)
            V x)) →
      (∀ (a : Γ(P, O)) (x : Γ(G, V)), eG (a ⊗ₜ[Γ(Z, V)] x) =
        a • (((Scheme.Modules.pullback p).obj G).presheaf.map (homOfLE hO).op).hom
          (Scheme.Modules.Hom.app ((Scheme.Modules.pullbackPushforwardAdjunction p).unit.app G)
            V x)) →
      ∀ w : TensorProduct Γ(Z, V) Γ(P, O) Γ(F, V),
        Scheme.Modules.Hom.app ((Scheme.Modules.pullback p).map u) O (eF w) =
          eG (LinearMap.lTensor Γ(P, O) (wcCnSecLin u V) w) := by
    intro F G u O hO _ eF eG heF heG w
    induction w using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul a x =>
      rw [heF, Scheme.Modules.Hom.app_smul, LinearMap.lTensor_tmul, heG]
      refine congrArg₂ (· • ·) rfl ?_
      exact (natr ((Scheme.Modules.pullback p).map u) hO _).trans
        (congrArg (((Scheme.Modules.pullback p).obj G).presheaf.map (homOfLE hO).op).hom
          (unitNat F G u x))
    | add w₁ w₂ h₁ h₂ => rw [map_add, map_add, map_add, map_add, h₁, h₂]

  have linMap : ∀ n, ∃ Φ : Γ((Scheme.Modules.pushforward p).obj
        ((Scheme.Modules.pullback p).obj (Fs n)), V) →ₗ[Γ(Z, V)]
        (∀ i, TensorProduct Γ(Z, V) Γ(P, W i) Γ(Fs n, V)),
      ∀ s i, Φ s i = (e n i).symm
        ((((Scheme.Modules.pullback p).obj (Fs n)).presheaf.map (homOfLE (hW i)).op).hom s) := by
    intro n
    refine ⟨{ toFun := fun s i => (e n i).symm
                ((((Scheme.Modules.pullback p).obj (Fs n)).presheaf.map (homOfLE (hW i)).op).hom s)
              map_add' := ?_
              map_smul' := ?_ }, fun s i => rfl⟩
    · intro s t
      funext i
      simp only [Pi.add_apply]
      exact (congrArg (e n i).symm (map_add (((Scheme.Modules.pullback p).obj (Fs n)).presheaf.map
        (homOfLE (hW i)).op).hom s t)).trans (map_add (e n i).symm _ _)
    · intro a s
      funext i
      simp only [RingHom.id_apply, Pi.smul_apply]
      change (e n i).symm ((((Scheme.Modules.pullback p).obj (Fs n)).presheaf.map
          (homOfLE (hW i)).op).hom ((p.app V).hom a •
            (show Γ((Scheme.Modules.pullback p).obj (Fs n), p ⁻¹ᵁ V) from s))) =
        a • (e n i).symm ((((Scheme.Modules.pullback p).obj (Fs n)).presheaf.map
          (homOfLE (hW i)).op).hom s)
      have hA : (P.presheaf.map (homOfLE (hW i)).op).hom ((p.app V).hom a) =
          algebraMap Γ(Z, V) Γ(P, W i) a := by
        rw [hC4]; rfl
      rw [Scheme.Modules.map_smul, hA, LinearEquiv.map_smul, algebraMap_smul]

  have hcov : p ⁻¹ᵁ V ≤ ⨆ i, W i := by
    intro x hx
    obtain ⟨i, hi⟩ := hC2 x hx
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨i, hi⟩
  have sep : ∀ n (s : Γ((Scheme.Modules.pullback p).obj (Fs n), p ⁻¹ᵁ V)),
      (∀ i, (((Scheme.Modules.pullback p).obj (Fs n)).presheaf.map
        (homOfLE (hW i)).op).hom s = 0) → s = 0 := by
    intro n s hs
    let MS : TopCat.Sheaf Ab P := ⟨((Scheme.Modules.pullback p).obj (Fs n)).presheaf,
      ((Scheme.Modules.pullback p).obj (Fs n)).isSheaf⟩
    refine TopCat.Sheaf.eq_of_locally_eq' MS W (p ⁻¹ᵁ V) (fun i => homOfLE (hW i)) hcov s 0 ?_
    intro i
    change (((Scheme.Modules.pullback p).obj (Fs n)).presheaf.map (homOfLE (hW i)).op).hom s =
      (((Scheme.Modules.pullback p).obj (Fs n)).presheaf.map (homOfLE (hW i)).op).hom 0
    rw [map_zero]
    exact hs i
  have glue : ∀ n (t : ∀ i, Γ((Scheme.Modules.pullback p).obj (Fs n), W i)),
      (∀ i j, (((Scheme.Modules.pullback p).obj (Fs n)).presheaf.map
          (homOfLE (inf_le_left : W i ⊓ W j ≤ W i)).op).hom (t i) =
        (((Scheme.Modules.pullback p).obj (Fs n)).presheaf.map
          (homOfLE (inf_le_right : W i ⊓ W j ≤ W j)).op).hom (t j)) →
      ∃ s : Γ((Scheme.Modules.pullback p).obj (Fs n), p ⁻¹ᵁ V), ∀ i,
        (((Scheme.Modules.pullback p).obj (Fs n)).presheaf.map (homOfLE (hW i)).op).hom s =
          t i := by
    intro n t ht
    let MS : TopCat.Sheaf Ab P := ⟨((Scheme.Modules.pullback p).obj (Fs n)).presheaf,
      ((Scheme.Modules.pullback p).obj (Fs n)).isSheaf⟩
    have hcomp : TopCat.Presheaf.IsCompatible MS.obj W t := by
      intro i j
      exact ht i j
    obtain ⟨s, hs, -⟩ := TopCat.Sheaf.existsUnique_gluing' MS W (p ⁻¹ᵁ V)
      (fun i => homOfLE (hW i)) hcov t hcomp
    exact ⟨s, hs⟩
  choose Φ hΦ using linMap
  have Bl : ∀ n i j (w : TensorProduct Γ(Z, V) Γ(P, W i) Γ(Fs n, V)),
      (((Scheme.Modules.pullback p).obj (Fs n)).presheaf.map
        (homOfLE (inf_le_left : W i ⊓ W j ≤ W i)).op).hom (e n i w) =
      e2 n i j (LinearMap.rTensor Γ(Fs n, V) (ρl i j).toLinearMap w) :=
    fun n i j w => bridge (Fs n) (W i) (W i ⊓ W j) (hW i) (le_trans inf_le_left (hW i))
      inf_le_left (ρl i j) (hC6 i j) (e n i) (e2 n i j) (he n i) (he2 n i j) w
  have Br : ∀ n i j (w : TensorProduct Γ(Z, V) Γ(P, W j) Γ(Fs n, V)),
      (((Scheme.Modules.pullback p).obj (Fs n)).presheaf.map
        (homOfLE (inf_le_right : W i ⊓ W j ≤ W j)).op).hom (e n j w) =
      e2 n i j (LinearMap.rTensor Γ(Fs n, V) (ρr i j).toLinearMap w) :=
    fun n i j w => bridge (Fs n) (W j) (W i ⊓ W j) (hW j) (le_trans inf_le_left (hW i))
      inf_le_right (ρr i j) (hC7 i j) (e n j) (e2 n i j) (he n j) (he2 n i j) w
  refine ⟨Φ, ?_, ?_, ?_, ?_, ?_⟩
  ·
    intro n
    rw [injective_iff_map_eq_zero]
    intro s hs
    apply sep n s
    intro i
    have h1 := congrFun hs i
    rw [hΦ, Pi.zero_apply, LinearEquiv.symm_apply_eq, map_zero] at h1
    exact h1
  ·
    intro n s i j
    apply (e2 n i j).injective
    rw [← Bl, ← Br, hΦ, hΦ, LinearEquiv.apply_symm_apply, LinearEquiv.apply_symm_apply]
    exact (resG ((Scheme.Modules.pullback p).obj (Fs n)) (hW i) inf_le_left s).trans
      (resG ((Scheme.Modules.pullback p).obj (Fs n)) (hW j) inf_le_right s).symm
  ·
    intro n τ hτ
    obtain ⟨s, hs⟩ := glue n (fun i => e n i (τ i)) (fun i j => by
      show (((Scheme.Modules.pullback p).obj (Fs n)).presheaf.map
          (homOfLE (inf_le_left : W i ⊓ W j ≤ W i)).op).hom (e n i (τ i)) =
        (((Scheme.Modules.pullback p).obj (Fs n)).presheaf.map
          (homOfLE (inf_le_right : W i ⊓ W j ≤ W j)).op).hom (e n j (τ j))
      rw [Bl, Br]
      exact congrArg (e2 n i j) (hτ i j))
    refine ⟨s, ?_⟩
    funext i
    exact (hΦ n s i).trans ((LinearEquiv.symm_apply_eq _).mpr (hs i))
  ·
    intro n x
    funext i
    show Φ n _ i = (1 : Γ(P, W i)) ⊗ₜ[Γ(Z, V)] x
    rw [hΦ, LinearEquiv.symm_apply_eq, he n i, one_smul]
  ·
    intro n s
    funext i
    show Φ n _ i = LinearMap.lTensor Γ(P, W i) (wcCnSecLin (ψ n) V) (Φ (n + 1) s i)
    rw [hΦ, hΦ, LinearEquiv.symm_apply_eq, ← tensNat (Fs (n + 1)) (Fs n) (ψ n) (W i) (hW i)
      (e (n + 1) i) (e n i) (he (n + 1) i) (he n i), LinearEquiv.apply_symm_apply]
    exact (natr ((Scheme.Modules.pullback p).map (ψ n)) (hW i) s).symm

theorem wc_cech_tensor_localization : ∀ (R : Type u) [CommRing R] (r : ℕ) (A : Fin r → Type u)
    [∀ i, CommRing (A i)] [∀ i, Algebra R (A i)] (A2 : Fin r → Fin r → Type u)
    [∀ i j, CommRing (A2 i j)] [∀ i j, Algebra R (A2 i j)]
    (ρl : ∀ i j, A i →ₐ[R] A2 i j) (ρr : ∀ i j, A j →ₐ[R] A2 i j) (f : R)
    (L : Type u) [AddCommGroup L] [Module R L],
    (∀ y : LocalizedModule (Submonoid.powers f) L, (fun i => (1 : A i) ⊗ₜ[R] y) = 0 → y = 0) →
    (∀ τ ∈ wcCnCechT A A2 ρl ρr (LocalizedModule (Submonoid.powers f) L),
      ∃ y, (fun i => (1 : A i) ⊗ₜ[R] y) = τ) →
    (∀ x : L, (fun i => (1 : A i) ⊗ₜ[R] x) = 0 → ∃ e : ℕ, f ^ e • x = 0) ∧
    (∀ τ ∈ wcCnCechT A A2 ρl ρr L, ∃ (e : ℕ) (x : L), (fun i => (1 : A i) ⊗ₜ[R] x) = f ^ e • τ) :=
by
  intro R _ r A _ _ A2 _ _ ρl ρr f L _ _ Hinj Hsurj
  set S := Submonoid.powers f with hS
  set φ := LocalizedModule.mkLinearMap S L with hφ

  have key : ∀ (B : Type u) [CommRing B] [Algebra R B] (ω : TensorProduct R B L),
      LinearMap.lTensor B φ ω = 0 → ∃ e : ℕ, f ^ e • ω = 0 := by
    intro B _ _ ω hω
    have := IsLocalizedModule.rTensor (R := R) R S (N := B) φ
    obtain ⟨x, rfl⟩ : ∃ x, TensorProduct.comm R L B x = ω := (TensorProduct.comm R L B).surjective ω
    rw [LinearMap.lTensor_comm] at hω
    have h1 : LinearMap.rTensor B φ x = 0 := (LinearEquiv.map_eq_zero_iff _).mp hω
    obtain ⟨⟨c, hc⟩, hcx⟩ :=
      (IsLocalizedModule.eq_zero_iff S (TensorProduct.AlgebraTensorModule.rTensor R B φ)).mp h1
    obtain ⟨e, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hc
    refine ⟨e, ?_⟩
    rw [Submonoid.smul_def] at hcx
    rw [← LinearEquiv.map_smul, hcx, map_zero]
  refine ⟨fun x hx => ?_, fun τ hτ => ?_⟩
  · have h1 : φ x = 0 := by
      apply Hinj
      funext i
      have h3 := congrFun hx i
      have h2 : LinearMap.lTensor (A i) φ ((1 : A i) ⊗ₜ[R] x) = (1 : A i) ⊗ₜ[R] φ x :=
        LinearMap.lTensor_tmul (A i) φ 1 x
      simp only [Pi.zero_apply] at h3 ⊢
      rw [← h2, h3, map_zero]
    obtain ⟨⟨c, hc⟩, hcx⟩ := (IsLocalizedModule.eq_zero_iff S φ).mp h1
    obtain ⟨e, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hc
    refine ⟨e, ?_⟩
    rw [Submonoid.smul_def] at hcx
    exact hcx
  · have e1 : ∀ (P Q : Type u) [AddCommGroup P] [Module R P] [AddCommGroup Q] [Module R Q]
        (g : P →ₗ[R] Q) (t : TensorProduct R P L),
        LinearMap.rTensor (LocalizedModule S L) g (LinearMap.lTensor P φ t) =
          LinearMap.lTensor Q φ (LinearMap.rTensor L g t) := by
      intro P Q _ _ _ _ g t
      rw [← LinearMap.comp_apply, ← LinearMap.comp_apply, LinearMap.rTensor_comp_lTensor,
        LinearMap.lTensor_comp_rTensor]
    have hτ' : (fun i => LinearMap.lTensor (A i) φ (τ i)) ∈
        wcCnCechT A A2 ρl ρr (LocalizedModule S L) := by
      intro i j
      change LinearMap.rTensor _ (ρl i j).toLinearMap (LinearMap.lTensor (A i) φ (τ i)) =
        LinearMap.rTensor _ (ρr i j).toLinearMap (LinearMap.lTensor (A j) φ (τ j))
      rw [e1, e1, hτ i j]
    obtain ⟨y, hy⟩ := Hsurj _ hτ'
    obtain ⟨⟨x₀, s⟩, hsy⟩ := IsLocalizedModule.surj S φ y
    obtain ⟨k, hk⟩ := (Submonoid.mem_powers_iff _ _).mp s.2
    simp only at hsy
    rw [Submonoid.smul_def, ← hk] at hsy
    have hω : ∀ i, ∃ e : ℕ, f ^ e • ((1 : A i) ⊗ₜ[R] x₀ - f ^ k • τ i) = 0 := by
      intro i
      apply key
      have h3 : (1 : A i) ⊗ₜ[R] y = LinearMap.lTensor (A i) φ (τ i) := congrFun hy i
      rw [map_sub, map_smul, LinearMap.lTensor_tmul, ← hsy, TensorProduct.tmul_smul, h3, sub_self]
    choose e he using hω
    refine ⟨∑ i, e i + k, (f ^ (∑ i, e i)) • x₀, ?_⟩
    funext i
    have hle : e i ≤ ∑ j, e j :=
      Finset.single_le_sum (fun j _ => Nat.zero_le (e j)) (Finset.mem_univ i)
    obtain ⟨d, hd⟩ := Nat.exists_eq_add_of_le hle
    have h0 : f ^ (∑ j, e j) • ((1 : A i) ⊗ₜ[R] x₀ - f ^ k • τ i) = 0 := by
      rw [hd, add_comm, pow_add, mul_smul, he i, smul_zero]
    rw [smul_sub, sub_eq_zero] at h0
    simp only [Pi.smul_apply]
    rw [TensorProduct.tmul_smul, h0, smul_smul, ← pow_add]

theorem wc_cn_basicOpen_chart_refine : ∀ (Z P : Scheme.{u}) (p : P ⟶ Z) (V : Z.Opens), IsAffineOpen V → ∀ (r : ℕ) (W : Fin r → P.Opens), (∀ x ∈ p ⁻¹ᵁ V, ∃ i, x ∈ W i) → ∀ (f : Γ(Z, V)) (𝔨 : Ideal Γ(Z, V)), IsAffineOpen (p ⁻¹ᵁ Z.basicOpen f) → Function.Surjective (p.app (Z.basicOpen f)).hom → RingHom.ker (p.app (Z.basicOpen f)).hom = Ideal.map (Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom 𝔨 → ∃ (q : ℕ) (a : Fin q → Γ(Z, V)) (ι : Fin q → Fin r) (E : ℕ), f ^ E ∈ Ideal.span (Set.range (fun k => f * a k)) ⊔ 𝔨 ∧ ∀ k, p ⁻¹ᵁ Z.basicOpen (f * a k) ≤ W (ι k) :=
by
  intro Z P p V hV r W hcov f 𝔨 H1 H2 H3
  classical
  haveI := hV.isLocalization_basicOpen f

  have hstar : ∀ b : Γ(Z, V), P.basicOpen ((p.app (Z.basicOpen f)).hom
      (algebraMap Γ(Z, V) Γ(Z, Z.basicOpen f) (f * b))) = p ⁻¹ᵁ Z.basicOpen (f * b) := by
    intro b
    refine (Scheme.preimage_basicOpen p (algebraMap Γ(Z, V) Γ(Z, Z.basicOpen f) (f * b))).symm.trans ?_
    congr 1
    have := Z.basicOpen_res (f * b) (homOfLE (Z.basicOpen_le f)).op
    refine this.trans ?_
    rw [Scheme.basicOpen_mul]
    exact inf_eq_right.mpr inf_le_left

  have hpt : ∀ x ∈ p ⁻¹ᵁ Z.basicOpen f, ∃ t : Γ(P, p ⁻¹ᵁ Z.basicOpen f),
      (∃ (b : Γ(Z, V)) (i : Fin r), t = (p.app (Z.basicOpen f)).hom
        (algebraMap Γ(Z, V) Γ(Z, Z.basicOpen f) (f * b)) ∧ p ⁻¹ᵁ Z.basicOpen (f * b) ≤ W i) ∧
      x ∈ P.basicOpen t := by
    intro x hx
    have hxV : x ∈ p ⁻¹ᵁ V := Scheme.Hom.preimage_mono p (Z.basicOpen_le f) hx
    obtain ⟨i, hi⟩ := hcov x hxV
    obtain ⟨s0, hs0le, hxs0⟩ := H1.exists_basicOpen_le (V := W i) ⟨x, hi⟩ hx
    obtain ⟨u, rfl⟩ := H2 s0
    obtain ⟨m, b, hb⟩ := IsLocalization.Away.surj f u
    have e1 : Z.basicOpen (algebraMap Γ(Z, V) Γ(Z, Z.basicOpen f) b) = Z.basicOpen u := by
      rw [← hb, Scheme.basicOpen_mul,
        Scheme.basicOpen_of_isUnit _ ((IsLocalization.Away.algebraMap_isUnit f).pow m)]
      exact inf_eq_left.mpr (Z.basicOpen_le u)
    have e2 : Z.basicOpen (algebraMap Γ(Z, V) Γ(Z, Z.basicOpen f) (f * b)) = Z.basicOpen u := by
      rw [map_mul, Scheme.basicOpen_mul, e1,
        Scheme.basicOpen_of_isUnit _ (IsLocalization.Away.algebraMap_isUnit f)]
      exact inf_eq_right.mpr (Z.basicOpen_le u)
    have e3 : P.basicOpen ((p.app (Z.basicOpen f)).hom
        (algebraMap Γ(Z, V) Γ(Z, Z.basicOpen f) (f * b))) =
        P.basicOpen ((p.app (Z.basicOpen f)).hom u) :=
      (Scheme.preimage_basicOpen p _).symm.trans
        ((congrArg (fun U => p ⁻¹ᵁ U) e2).trans (Scheme.preimage_basicOpen p u))
    refine ⟨_, ⟨b, i, rfl, ?_⟩, ?_⟩
    · rw [← hstar b, e3]; exact hs0le
    · rw [e3]; exact hxs0

  let 𝒮 : Set Γ(P, p ⁻¹ᵁ Z.basicOpen f) := {t | ∃ (b : Γ(Z, V)) (i : Fin r),
    t = (p.app (Z.basicOpen f)).hom (algebraMap Γ(Z, V) Γ(Z, Z.basicOpen f) (f * b)) ∧
      p ⁻¹ᵁ Z.basicOpen (f * b) ≤ W i}
  have hsup : ⨆ t : 𝒮, P.basicOpen (t : Γ(P, p ⁻¹ᵁ Z.basicOpen f)) = p ⁻¹ᵁ Z.basicOpen f := by
    apply le_antisymm
    · exact iSup_le fun t => P.basicOpen_le _
    · intro x hx
      obtain ⟨t, ht, hxt⟩ := hpt x hx
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨t, ht⟩, hxt⟩
  have hspan : Ideal.span 𝒮 = ⊤ := (H1.iSup_basicOpen_eq_self_iff).mp hsup
  have h1 : (1 : Γ(P, p ⁻¹ᵁ Z.basicOpen f)) ∈ Ideal.span 𝒮 := by rw [hspan]; trivial
  obtain ⟨n, c, g, hcg⟩ := Submodule.mem_span_set'.mp h1
  have hg : ∀ k, ∃ (b : Γ(Z, V)) (i : Fin r),
      (g k : Γ(P, p ⁻¹ᵁ Z.basicOpen f)) = (p.app (Z.basicOpen f)).hom
        (algebraMap Γ(Z, V) Γ(Z, Z.basicOpen f) (f * b)) ∧ p ⁻¹ᵁ Z.basicOpen (f * b) ≤ W i :=
    fun k => (g k).2
  choose a ι hta hle using hg

  choose v hv using fun k => H2 (c k)
  let J : Ideal Γ(Z, V) := Ideal.span (Set.range (fun k => f * a k)) ⊔ 𝔨
  have hx1 : (p.app (Z.basicOpen f)).hom
      (∑ k, v k * algebraMap Γ(Z, V) Γ(Z, Z.basicOpen f) (f * a k)) = 1 := by
    rw [← hcg, map_sum]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [map_mul, hv k, smul_eq_mul, hta k]
  have hxJ : (∑ k, v k * algebraMap Γ(Z, V) Γ(Z, Z.basicOpen f) (f * a k)) ∈
      Ideal.map (algebraMap Γ(Z, V) Γ(Z, Z.basicOpen f)) J :=
    Ideal.sum_mem _ fun k _ => Ideal.mul_mem_left _ _
      (Ideal.mem_map_of_mem _ (Ideal.mem_sup_left (Ideal.subset_span ⟨k, rfl⟩)))
  have hker : (1 - ∑ k, v k * algebraMap Γ(Z, V) Γ(Z, Z.basicOpen f) (f * a k)) ∈
      Ideal.map (algebraMap Γ(Z, V) Γ(Z, Z.basicOpen f)) J := by
    have hmem : (1 - ∑ k, v k * algebraMap Γ(Z, V) Γ(Z, Z.basicOpen f) (f * a k)) ∈
        RingHom.ker (p.app (Z.basicOpen f)).hom := by
      rw [RingHom.mem_ker, map_sub, map_one, hx1, sub_self]
    rw [H3] at hmem
    have hk : Ideal.map (Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom 𝔨 =
        Ideal.map (algebraMap Γ(Z, V) Γ(Z, Z.basicOpen f)) 𝔨 := rfl
    rw [hk] at hmem
    exact Ideal.map_mono le_sup_right hmem
  have hone : (1 : Γ(Z, Z.basicOpen f)) ∈ Ideal.map (algebraMap Γ(Z, V) Γ(Z, Z.basicOpen f)) J := by
    have := Ideal.add_mem _ hker hxJ
    rwa [sub_add_cancel] at this
  obtain ⟨⟨⟨κ, hκ⟩, ⟨w, hw⟩⟩, hy⟩ :=
    (IsLocalization.mem_map_algebraMap_iff (Submonoid.powers f) Γ(Z, Z.basicOpen f)).mp hone
  obtain ⟨j, rfl⟩ := hw
  simp only [one_mul] at hy
  obtain ⟨⟨_, l, rfl⟩, hc⟩ :=
    (IsLocalization.eq_iff_exists (Submonoid.powers f) Γ(Z, Z.basicOpen f)).mp hy
  refine ⟨n, a, ι, l + j, ?_, hle⟩
  have hc' : f ^ l * f ^ j = f ^ l * κ := hc
  rw [pow_add, hc']
  exact Ideal.mul_mem_left _ _ hκ

theorem wc_cn_chart_restrict_away : ∀ (Z P : Scheme.{u}) (p : P ⟶ Z) (V : Z.Opens) (r : ℕ) (W : Fin r → P.Opens) (hW : ∀ i, W i ≤ p ⁻¹ᵁ V) [∀ i, Algebra Γ(Z, V) Γ(P, W i)] [∀ i j, Algebra Γ(Z, V) Γ(P, W i ⊓ W j)] (ρl : ∀ i j, Γ(P, W i) →ₐ[Γ(Z, V)] Γ(P, W i ⊓ W j)) (ρr : ∀ i j, Γ(P, W j) →ₐ[Γ(Z, V)] Γ(P, W i ⊓ W j)), wcCnChartCompat p V W hW ρl ρr → ∀ (h : Γ(Z, V)) (i₀ : Fin r), p ⁻¹ᵁ Z.basicOpen h ≤ W i₀ → ∀ j : Fin r, (∀ b : Γ(P, W i₀ ⊓ W j), ∃ (n : ℕ) (a : Γ(P, W j)), ρr i₀ j a = h ^ n • b) ∧ (∀ a : Γ(P, W j), ρr i₀ j a = 0 → ∃ n : ℕ, h ^ n • a = 0) :=
by
  intro Z P p V r W hW _ _ ρl ρr hc h i₀ hsub j
  obtain ⟨hWa, -, hWi, hA1, hA2, -, hρr⟩ := hc

  have hF : ∀ (O O' O'' : P.Opens) (h1 : O' ≤ O) (h2 : O'' ≤ O') (x : Γ(P, O)),
      (P.presheaf.map (homOfLE h2).op).hom ((P.presheaf.map (homOfLE h1).op).hom x) =
      (P.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro O O' O'' h1 h2 x
    change (P.presheaf.map (homOfLE h1).op ≫ P.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    rfl
  have hle : W i₀ ⊓ W j ≤ W j := inf_le_right
  set g : Γ(P, W j) := (p.appLE V (W j) (hW j)).hom h with hgdef

  have hD : P.basicOpen g ≤ W i₀ ⊓ W j := by
    intro x hx
    have hx' : x ∈ W j ⊓ p ⁻¹ᵁ Z.basicOpen h := by
      rw [← Scheme.basicOpen_appLE p (W j) V (hW j) h]
      exact hx
    rw [TopologicalSpace.Opens.mem_inf] at hx' ⊢
    exact ⟨hsub hx'.2, hx'.1⟩

  have K1 : ∀ (n : ℕ) (a : Γ(P, W j)), h ^ n • a = g ^ n * a := by
    intro n a
    rw [Algebra.smul_def, map_pow, hA1]

  have hg2 : (P.presheaf.map (homOfLE hle).op).hom g =
      (p.appLE V (W i₀ ⊓ W j) (le_trans inf_le_left (hW i₀))).hom h := by
    have e := congrArg (fun φ => φ.hom h) (p.appLE_map (hW j) (homOfLE hle).op)
    exact e
  have K2 : ∀ (n : ℕ) (b : Γ(P, W i₀ ⊓ W j)),
      h ^ n • b = ((P.presheaf.map (homOfLE hle).op).hom g) ^ n * b := by
    intro n b
    rw [Algebra.smul_def, map_pow, hA2, hg2]
  refine ⟨fun b => ?_, fun a ha => ?_⟩
  ·
    obtain ⟨n, y, hy⟩ := exists_eq_pow_mul_of_isAffineOpen P (W j) (hWa j) g
      ((P.presheaf.map (homOfLE hD).op).hom b)
    have hz1 : (P.presheaf.map (homOfLE hD).op).hom
        ((P.presheaf.map (homOfLE hle).op).hom y -
          ((P.presheaf.map (homOfLE hle).op).hom g) ^ n * b) = 0 := by
      rw [map_sub, map_mul, map_pow, hF _ _ _ hle hD, hF _ _ _ hle hD, sub_eq_zero]
      exact hy
    have hD' : P.basicOpen ((P.presheaf.map (homOfLE hle).op).hom g) ≤ P.basicOpen g :=
      (Scheme.basicOpen_res P g (homOfLE hle).op).le.trans inf_le_right
    have hz2 : (P.presheaf.map (homOfLE (P.basicOpen_le
          ((P.presheaf.map (homOfLE hle).op).hom g))).op).hom
          ((P.presheaf.map (homOfLE hle).op).hom y -
          ((P.presheaf.map (homOfLE hle).op).hom g) ^ n * b) = 0 := by
      have := hF _ _ _ hD hD' ((P.presheaf.map (homOfLE hle).op).hom y -
          ((P.presheaf.map (homOfLE hle).op).hom g) ^ n * b)
      rw [hz1, map_zero] at this
      exact this.symm
    obtain ⟨m, hm⟩ := exists_pow_mul_eq_zero_of_res_basicOpen_eq_zero_of_isAffineOpen P
      (hWi i₀ j) _ _ hz2
    refine ⟨m + n, g ^ m * y, ?_⟩
    rw [hρr, K2]
    change (P.presheaf.map (homOfLE hle).op).hom (g ^ m * y) = _
    rw [map_mul, map_pow]
    rw [mul_sub, sub_eq_zero] at hm
    rw [hm, pow_add, mul_assoc]
  ·
    rw [hρr] at ha
    have h0 : (P.presheaf.map (homOfLE (P.basicOpen_le g)).op).hom a = 0 := by
      have := hF _ _ _ hle hD a
      rw [ha, map_zero] at this
      exact this.symm
    obtain ⟨n, hn⟩ := exists_pow_mul_eq_zero_of_res_basicOpen_eq_zero_of_isAffineOpen P
      (hWa j) a g h0
    exact ⟨n, by rw [K1]; exact hn⟩

theorem wc_cn_chart_unit_away : ∀ (Z P : Scheme.{u}) (p : P ⟶ Z) (V : Z.Opens), IsAffineOpen V → ∀ (r : ℕ) (W : Fin r → P.Opens) (hW : ∀ i, W i ≤ p ⁻¹ᵁ V) [∀ i, Algebra Γ(Z, V) Γ(P, W i)] [∀ i j, Algebra Γ(Z, V) Γ(P, W i ⊓ W j)] (ρl : ∀ i j, Γ(P, W i) →ₐ[Γ(Z, V)] Γ(P, W i ⊓ W j)) (ρr : ∀ i j, Γ(P, W j) →ₐ[Γ(Z, V)] Γ(P, W i ⊓ W j)), wcCnChartCompat p V W hW ρl ρr → ∀ (f : Γ(Z, V)) (𝔨 : Ideal Γ(Z, V)), IsAffineOpen (p ⁻¹ᵁ Z.basicOpen f) → Function.Surjective (p.app (Z.basicOpen f)).hom → RingHom.ker (p.app (Z.basicOpen f)).hom = Ideal.map (Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom 𝔨 → ∀ (a : Γ(Z, V)) (i₀ : Fin r), p ⁻¹ᵁ Z.basicOpen (f * a) ≤ W i₀ → (∀ x : Γ(P, W i₀), ∃ (n : ℕ) (c : Γ(Z, V)), (f * a) ^ n • x = algebraMap Γ(Z, V) Γ(P, W i₀) c) ∧ (∀ c : Γ(Z, V), algebraMap Γ(Z, V) Γ(P, W i₀) c = 0 → ∃ n : ℕ, (f * a) ^ n * c ∈ 𝔨) :=
by
  intro Z P p V hV r W hW _ _ ρl ρr hc f 𝔨 H1 H2 H3 a i₀ hsub
  obtain ⟨hWa, -, -, hA1, -, -, -⟩ := hc

  have hF : ∀ (O O' O'' : P.Opens) (h1 : O' ≤ O) (h2 : O'' ≤ O') (x : Γ(P, O)),
      (P.presheaf.map (homOfLE h2).op).hom ((P.presheaf.map (homOfLE h1).op).hom x) =
      (P.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro O O' O'' h1 h2 x
    change (P.presheaf.map (homOfLE h1).op ≫ P.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    rfl
  have hloc : IsLocalization.Away f Γ(Z, Z.basicOpen f) := hV.isLocalization_basicOpen f
  obtain ⟨t, ht⟩ : ∃ t : Γ(P, p ⁻¹ᵁ Z.basicOpen f), t = (p.app (Z.basicOpen f)).hom
      ((Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom (f * a)) := ⟨_, rfl⟩

  have hOt : P.basicOpen t = p ⁻¹ᵁ Z.basicOpen (f * a) := by
    rw [ht, ← Scheme.preimage_basicOpen, Scheme.basicOpen_res, Scheme.basicOpen_mul,
      ← inf_assoc, inf_idem]
  have hle1 : P.basicOpen t ≤ p ⁻¹ᵁ Z.basicOpen f := P.basicOpen_le t
  have hle2 : P.basicOpen t ≤ W i₀ := hOt.le.trans hsub

  have hstar : ∀ c : Γ(Z, V),
      (P.presheaf.map (homOfLE hle1).op).hom ((p.app (Z.basicOpen f)).hom
        ((Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom c)) =
      (P.presheaf.map (homOfLE hle2).op).hom (algebraMap Γ(Z, V) Γ(P, W i₀) c) := by
    intro c
    rw [hA1]
    have e1 : (P.presheaf.map (homOfLE hle1).op).hom ((p.app (Z.basicOpen f)).hom
        ((Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom c)) =
        (p.appLE V (P.basicOpen t) (hle2.trans (hW i₀))).hom c := by
      change (Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op ≫
        p.appLE (Z.basicOpen f) (P.basicOpen t) hle1).hom c = _
      rw [Scheme.Hom.map_appLE]
    have e2 : (P.presheaf.map (homOfLE hle2).op).hom ((p.appLE V (W i₀) (hW i₀)).hom c) =
        (p.appLE V (P.basicOpen t) (hle2.trans (hW i₀))).hom c := by
      change (p.appLE V (W i₀) (hW i₀) ≫ P.presheaf.map (homOfLE hle2).op).hom c = _
      rw [Scheme.Hom.appLE_map]
    rw [e1, e2]

  have hOh : P.basicOpen (algebraMap Γ(Z, V) Γ(P, W i₀) (f * a)) ≤ P.basicOpen t := by
    rw [hA1, Scheme.basicOpen_appLE, hOt]
    exact inf_le_right
  refine ⟨fun x => ?_, fun c hc0 => ?_⟩
  ·
    obtain ⟨n, w, hw⟩ := exists_eq_pow_mul_of_isAffineOpen P (p ⁻¹ᵁ Z.basicOpen f) H1 t
      ((P.presheaf.map (homOfLE hle2).op).hom x)
    have hw' : (P.presheaf.map (homOfLE hle1).op).hom w =
        ((P.presheaf.map (homOfLE hle1).op).hom t) ^ n *
          (P.presheaf.map (homOfLE hle2).op).hom x := hw
    obtain ⟨u, hu⟩ := H2 w
    obtain ⟨m, b, hb⟩ := IsLocalization.Away.surj f u
    have hb' : (p.app (Z.basicOpen f)).hom
        ((Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom b) =
        w * ((p.app (Z.basicOpen f)).hom
          ((Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom f)) ^ m := by
      have := congrArg (p.app (Z.basicOpen f)).hom hb
      rw [map_mul, map_pow, hu] at this
      exact this.symm
    have hz1 : (P.presheaf.map (homOfLE hle2).op).hom
        (algebraMap Γ(Z, V) Γ(P, W i₀) ((f * a) ^ n * f ^ m) * x -
          algebraMap Γ(Z, V) Γ(P, W i₀) b) = 0 := by
      have htt : (P.presheaf.map (homOfLE hle1).op).hom t =
          (P.presheaf.map (homOfLE hle1).op).hom ((p.app (Z.basicOpen f)).hom
            ((Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom (f * a))) :=
        congrArg (P.presheaf.map (homOfLE hle1).op).hom ht
      rw [map_sub, map_mul ((P.presheaf.map (homOfLE hle2).op).hom), ← hstar, ← hstar, hb',
        map_mul ((P.presheaf.map (homOfLE hle1).op).hom) w, hw', htt]
      simp only [map_mul, map_pow]
      ring
    have hz2 : (P.presheaf.map (homOfLE (P.basicOpen_le
        (algebraMap Γ(Z, V) Γ(P, W i₀) (f * a)))).op).hom
        (algebraMap Γ(Z, V) Γ(P, W i₀) ((f * a) ^ n * f ^ m) * x -
          algebraMap Γ(Z, V) Γ(P, W i₀) b) = 0 := by
      have := hF _ _ _ hle2 hOh (algebraMap Γ(Z, V) Γ(P, W i₀) ((f * a) ^ n * f ^ m) * x -
          algebraMap Γ(Z, V) Γ(P, W i₀) b)
      rw [hz1, map_zero] at this
      exact this.symm
    obtain ⟨k, hk⟩ := exists_pow_mul_eq_zero_of_res_basicOpen_eq_zero_of_isAffineOpen P
      (hWa i₀) _ _ hz2
    refine ⟨k + n + m, a ^ m * (f * a) ^ k * b, ?_⟩
    rw [Algebra.smul_def]
    simp only [map_mul, map_pow] at hk ⊢
    linear_combination (algebraMap Γ(Z, V) Γ(P, W i₀) a) ^ m * hk
  ·
    have hs0 : (P.presheaf.map (homOfLE (P.basicOpen_le t)).op).hom
        ((p.app (Z.basicOpen f)).hom ((Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom c))
        = 0 := by
      rw [hstar, hc0, map_zero]
    obtain ⟨n, hn⟩ := exists_pow_mul_eq_zero_of_res_basicOpen_eq_zero_of_isAffineOpen P H1 _ _ hs0
    have hd : (p.app (Z.basicOpen f)).hom
        ((Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom ((f * a) ^ n * c)) = 0 := by
      rw [map_mul, map_pow, map_mul, map_pow, ← ht]
      exact hn
    have hmem : (Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom ((f * a) ^ n * c) ∈
        Ideal.map (algebraMap Γ(Z, V) Γ(Z, Z.basicOpen f)) 𝔨 := by
      have h1 : (Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom ((f * a) ^ n * c) ∈
          RingHom.ker (p.app (Z.basicOpen f)).hom := RingHom.mem_ker.mpr hd
      rw [H3] at h1
      exact h1
    obtain ⟨⟨⟨κ, hκ⟩, ⟨s, hs⟩⟩, heq⟩ :=
      (IsLocalization.mem_map_algebraMap_iff (Submonoid.powers f) Γ(Z, Z.basicOpen f)).mp hmem
    simp only at heq
    obtain ⟨l2, rfl⟩ := hs
    have heq' : algebraMap Γ(Z, V) Γ(Z, Z.basicOpen f) ((f * a) ^ n * c * f ^ l2) =
        algebraMap Γ(Z, V) Γ(Z, Z.basicOpen f) κ := by
      rw [map_mul]
      exact heq
    obtain ⟨⟨_, l1, rfl⟩, hcm⟩ :=
      (IsLocalization.eq_iff_exists (Submonoid.powers f) Γ(Z, Z.basicOpen f)).mp heq'
    simp only at hcm
    refine ⟨n + (l1 + l2), ?_⟩
    have e : (f * a) ^ (n + (l1 + l2)) * c =
        a ^ (l1 + l2) * (f ^ l1 * ((f * a) ^ n * c * f ^ l2)) := by
      ring
    rw [e, hcm]
    exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ hκ)

theorem wc_rTensor_ker_pow_torsion : ∀ (R : Type u) [CommRing R] (h : R) (A B : Type u) [AddCommGroup A] [Module R A] [AddCommGroup B] [Module R B] (g : A →ₗ[R] B), (∀ b : B, ∃ (n : ℕ) (a : A), g a = h ^ n • b) → (∀ a : A, g a = 0 → ∃ n : ℕ, h ^ n • a = 0) → ∀ (M : Type u) [AddCommGroup M] [Module R M] (ω : TensorProduct R A M), LinearMap.rTensor M g ω = 0 → ∃ n : ℕ, h ^ n • ω = 0 :=
by
  intro R _ h A B _ _ _ _ g a1 a2 M _ _ ω hω
  classical
  choose nB aB hW using a1
  let pw : ℕ → Submonoid.powers h := fun n => ⟨h ^ n, n, rfl⟩
  have pw_add : ∀ n n', pw n * pw n' = pw (n + n') := fun n n' =>
    Subtype.ext (by simp [pw, pow_add])
  have pw_zero : pw 0 = 1 := Subtype.ext (by simp [pw])

  have hI : ∀ (b : B) (a : A) (n : ℕ) (m : M), g a = h ^ n • b →
      (LocalizedModule.mk (aB b ⊗ₜ[R] m) (pw (nB b)) :
        LocalizedModule (Submonoid.powers h) (TensorProduct R A M)) =
        LocalizedModule.mk (a ⊗ₜ[R] m) (pw n) := by
    intro b a n m hab
    have hz : g (h ^ n • aB b - h ^ (nB b) • a) = 0 := by
      rw [map_sub, map_smul, map_smul, hW, hab, smul_smul, smul_smul, mul_comm, sub_self]
    obtain ⟨k, hk⟩ := a2 _ hz
    rw [LocalizedModule.mk_eq]
    refine ⟨pw k, ?_⟩
    change h ^ k • h ^ n • (aB b ⊗ₜ[R] m) = h ^ k • h ^ (nB b) • (a ⊗ₜ[R] m)
    rw [← sub_eq_zero]
    simp only [TensorProduct.smul_tmul']
    rw [← TensorProduct.sub_tmul, ← smul_sub, hk, TensorProduct.zero_tmul]
  have mk_add : ∀ (x y : TensorProduct R A M) (s : Submonoid.powers h),
      (LocalizedModule.mk (x + y) s :
        LocalizedModule (Submonoid.powers h) (TensorProduct R A M)) =
        LocalizedModule.mk x s + LocalizedModule.mk y s := by
    intro x y s
    rw [LocalizedModule.mk_add_mk, ← smul_add, LocalizedModule.mk_cancel_common_left]
  let Θ₀ : B → M → LocalizedModule (Submonoid.powers h) (TensorProduct R A M) :=
    fun b m => LocalizedModule.mk (aB b ⊗ₜ[R] m) (pw (nB b))
  have H1 : ∀ b b' m, Θ₀ (b + b') m = Θ₀ b m + Θ₀ b' m := by
    intro b b' m
    have hg : g (h ^ (nB b') • aB b + h ^ (nB b) • aB b') = h ^ (nB b + nB b') • (b + b') := by
      rw [map_add, map_smul, map_smul, hW, hW, smul_smul, smul_smul, smul_add, pow_add,
        mul_comm (h ^ nB b') (h ^ nB b)]
    show LocalizedModule.mk _ _ = LocalizedModule.mk _ _ + LocalizedModule.mk _ _
    rw [hI _ _ _ m hg, LocalizedModule.mk_add_mk, pw_add]
    congr 1
    change _ = h ^ nB b' • (aB b ⊗ₜ[R] m) + h ^ nB b • (aB b' ⊗ₜ[R] m)
    rw [TensorProduct.add_tmul, TensorProduct.smul_tmul', TensorProduct.smul_tmul']
  have H2 : ∀ (c : R) b m, Θ₀ (c • b) m = c • Θ₀ b m := by
    intro c b m
    have hg : g (c • aB b) = h ^ (nB b) • (c • b) := by
      rw [map_smul, hW, smul_comm]
    show LocalizedModule.mk _ _ = c • LocalizedModule.mk _ _
    rw [hI _ _ _ m hg, LocalizedModule.smul'_mk, TensorProduct.smul_tmul']
  have H3 : ∀ b m m', Θ₀ b (m + m') = Θ₀ b m + Θ₀ b m' := by
    intro b m m'
    show LocalizedModule.mk _ _ = LocalizedModule.mk _ _ + LocalizedModule.mk _ _
    rw [TensorProduct.tmul_add, mk_add]
  have H4 : ∀ (c : R) b m, Θ₀ b (c • m) = c • Θ₀ b m := by
    intro c b m
    show LocalizedModule.mk _ _ = c • LocalizedModule.mk _ _
    rw [TensorProduct.tmul_smul, LocalizedModule.smul'_mk]
  let Θ := TensorProduct.lift (LinearMap.mk₂ R Θ₀ H1 H2 H3 H4)
  have hcomp : Θ ∘ₗ LinearMap.rTensor M g =
      LocalizedModule.mkLinearMap (Submonoid.powers h) (TensorProduct R A M) := by
    apply TensorProduct.ext'
    intro a m
    rw [LinearMap.comp_apply, LinearMap.rTensor_tmul, TensorProduct.lift.tmul,
      LinearMap.mk₂_apply, LocalizedModule.mkLinearMap_apply]
    show LocalizedModule.mk _ _ = _
    rw [hI (g a) a 0 m (by rw [pow_zero, one_smul]), pw_zero]
  have h1 : (LocalizedModule.mk ω 1 :
      LocalizedModule (Submonoid.powers h) (TensorProduct R A M)) = LocalizedModule.mk 0 1 := by
    have := LinearMap.congr_fun hcomp ω
    rw [LinearMap.comp_apply, hω, map_zero, LocalizedModule.mkLinearMap_apply] at this
    rw [LocalizedModule.zero_mk, ← this]
  obtain ⟨u, hu⟩ := LocalizedModule.mk_eq.mp h1
  rw [one_smul, one_smul, smul_zero] at hu
  obtain ⟨n, hn⟩ := (Submonoid.mem_powers_iff _ _).mp u.2
  refine ⟨n, ?_⟩
  rw [hn]
  exact hu

theorem wc_unit_tensor_pow_torsion : ∀ (R : Type u) [CommRing R] (h : R) (𝔨 : Ideal R) (A : Type u) [CommRing A] [Algebra R A] (M : Type u) [AddCommGroup M] [Module R M], (∀ a ∈ 𝔨, ∀ y : M, a • y = 0) → (∀ a : A, ∃ (n : ℕ) (c : R), h ^ n • a = algebraMap R A c) → (∀ c : R, algebraMap R A c = 0 → ∃ n : ℕ, h ^ n * c ∈ 𝔨) → (∀ y : M, (1 : A) ⊗ₜ[R] y = 0 → ∃ n : ℕ, h ^ n • y = 0) ∧ (∀ ω : TensorProduct R A M, ∃ (n : ℕ) (y : M), h ^ n • ω = (1 : A) ⊗ₜ[R] y) :=
by
  intro R _ h 𝔨 A _ _ M _ _ hK hb1 hb2
  refine ⟨?_, ?_⟩
  · choose nA cA hC using hb1
    let pw : ℕ → Submonoid.powers h := fun n => ⟨h ^ n, Submonoid.pow_mem _ (Submonoid.mem_powers h) n⟩
    have indep : ∀ (a : A) (n : ℕ) (c : R), h ^ n • a = algebraMap R A c → ∀ m : M,
        (LocalizedModule.mk (cA a • m) (pw (nA a)) : LocalizedModule (Submonoid.powers h) M) =
          LocalizedModule.mk (c • m) (pw n) := by
      intro a n c hac m
      have hδ : algebraMap R A (h ^ nA a * c - h ^ n * cA a) = 0 := by
        rw [map_sub, map_mul, map_mul, ← hac, ← hC a, ← Algebra.smul_def, ← Algebra.smul_def,
          smul_smul, smul_smul, mul_comm, sub_self]
      obtain ⟨k, hk⟩ := hb2 _ hδ
      have h0 := hK _ hk m
      have e : (h ^ k * h ^ n * cA a) • m - (h ^ k * h ^ nA a * c) • m =
          -((h ^ k * (h ^ nA a * c - h ^ n * cA a)) • m) := by
        rw [← sub_smul, ← neg_smul]
        congr 1
        ring
      rw [h0, neg_zero, sub_eq_zero] at e
      rw [LocalizedModule.mk_eq]
      refine ⟨pw k, ?_⟩
      show h ^ k • h ^ n • cA a • m = h ^ k • h ^ nA a • c • m
      simp only [smul_smul]
      rw [← mul_assoc, ← mul_assoc]
      exact e
    have H1 : ∀ (a a' : A) (m : M),
        (LocalizedModule.mk (cA (a + a') • m) (pw (nA (a + a'))) : LocalizedModule (Submonoid.powers h) M) =
          LocalizedModule.mk (cA a • m) (pw (nA a)) + LocalizedModule.mk (cA a' • m) (pw (nA a')) := by
      intro a a' m
      have hyp : h ^ (nA a + nA a') • (a + a') =
          algebraMap R A (h ^ nA a' * cA a + h ^ nA a * cA a') := by
        rw [map_add, map_mul, map_mul, ← hC a, ← hC a', ← Algebra.smul_def, ← Algebra.smul_def,
          smul_smul, smul_smul, smul_add, pow_add, mul_comm (h ^ nA a') (h ^ nA a)]
      rw [indep (a + a') (nA a + nA a') _ hyp m, LocalizedModule.mk_add_mk]
      have hpw : pw (nA a) * pw (nA a') = pw (nA a + nA a') := Subtype.ext (pow_add h _ _).symm
      rw [hpw]
      congr 1
      show _ = h ^ nA a' • cA a • m + h ^ nA a • cA a' • m
      rw [add_smul, mul_smul, mul_smul]
    have H2 : ∀ (r : R) (a : A) (m : M),
        (LocalizedModule.mk (cA (r • a) • m) (pw (nA (r • a))) : LocalizedModule (Submonoid.powers h) M) =
          r • LocalizedModule.mk (cA a • m) (pw (nA a)) := by
      intro r a m
      have hyp : h ^ nA a • (r • a) = algebraMap R A (r * cA a) := by
        rw [smul_comm, hC a, map_mul, Algebra.smul_def]
      rw [indep (r • a) (nA a) _ hyp m, LocalizedModule.smul'_mk, mul_smul]
    have H3 : ∀ (a : A) (m m' : M),
        (LocalizedModule.mk (cA a • (m + m')) (pw (nA a)) : LocalizedModule (Submonoid.powers h) M) =
          LocalizedModule.mk (cA a • m) (pw (nA a)) + LocalizedModule.mk (cA a • m') (pw (nA a)) := by
      intro a m m'
      rw [LocalizedModule.mk_add_mk, ← smul_add, LocalizedModule.mk_cancel_common_left, smul_add]
    have H4 : ∀ (r : R) (a : A) (m : M),
        (LocalizedModule.mk (cA a • (r • m)) (pw (nA a)) : LocalizedModule (Submonoid.powers h) M) =
          r • LocalizedModule.mk (cA a • m) (pw (nA a)) := by
      intro r a m
      rw [LocalizedModule.smul'_mk, smul_comm]
    let f : A →ₗ[R] M →ₗ[R] LocalizedModule (Submonoid.powers h) M :=
      LinearMap.mk₂ R (fun a m => LocalizedModule.mk (cA a • m) (pw (nA a))) H1 H2 H3 H4
    have hΛ1 : ∀ y : M, TensorProduct.lift f ((1 : A) ⊗ₜ[R] y) = LocalizedModule.mk y 1 := by
      intro y
      rw [TensorProduct.lift.tmul]
      show LocalizedModule.mk (cA 1 • y) (pw (nA 1)) = _
      have hyp : h ^ 0 • (1 : A) = algebraMap R A 1 := by simp
      rw [indep 1 0 1 hyp y, one_smul]
      have hpw : pw 0 = 1 := Subtype.ext (pow_zero h)
      rw [hpw]
    intro y hy
    have e : (LocalizedModule.mk y 1 : LocalizedModule (Submonoid.powers h) M) =
        LocalizedModule.mk 0 1 := by
      rw [← hΛ1, hy, map_zero, LocalizedModule.zero_mk]
    rw [LocalizedModule.mk_eq] at e
    obtain ⟨u, hu⟩ := e
    obtain ⟨n, hn⟩ := (Submonoid.mem_powers_iff _ _).mp u.2
    refine ⟨n, ?_⟩
    rw [hn]
    simpa [Submonoid.smul_def] using hu
  · intro ω
    induction ω using TensorProduct.induction_on with
    | zero => exact ⟨0, 0, by simp⟩
    | tmul a m =>
      obtain ⟨n, c, hc⟩ := hb1 a
      refine ⟨n, c • m, ?_⟩
      rw [TensorProduct.smul_tmul', hc, Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul]
    | add x z hx hz =>
      obtain ⟨n, y1, h1⟩ := hx
      obtain ⟨n', y2, h2⟩ := hz
      refine ⟨n + n', h ^ n' • y1 + h ^ n • y2, ?_⟩
      rw [smul_add, TensorProduct.tmul_add, TensorProduct.tmul_smul, TensorProduct.tmul_smul,
        ← h1, ← h2, smul_smul, smul_smul, pow_add, mul_comm (h ^ n') (h ^ n)]

theorem wc_cech_exact_of_local_pow : ∀ (R : Type u) [CommRing R] (r : ℕ) (A : Fin r → Type u) [∀ i, CommRing (A i)] [∀ i, Algebra R (A i)] (A2 : Fin r → Fin r → Type u) [∀ i j, CommRing (A2 i j)] [∀ i j, Algebra R (A2 i j)] (ρl : ∀ i j, A i →ₐ[R] A2 i j) (ρr : ∀ i j, A j →ₐ[R] A2 i j) (f : R) (𝔨 : Ideal R) (M : Type u) [AddCommGroup M] [Module R M], Function.Bijective (fun y : M => f • y) → (∀ a ∈ 𝔨, ∀ y : M, a • y = 0) → ∀ (q : ℕ) (h : Fin q → R) (ι : Fin q → Fin r) (E : ℕ), f ^ E ∈ Ideal.span (Set.range h) ⊔ 𝔨 → (∀ k (y : M), (1 : A (ι k)) ⊗ₜ[R] y = 0 → ∃ n : ℕ, h k ^ n • y = 0) → (∀ k (ω : TensorProduct R (A (ι k)) M), ∃ (n : ℕ) (y : M), h k ^ n • ω = (1 : A (ι k)) ⊗ₜ[R] y) → (∀ k j (ω : TensorProduct R (A j) M), LinearMap.rTensor M (ρr (ι k) j).toLinearMap ω = 0 → ∃ n : ℕ, h k ^ n • ω = 0) → (∀ y : M, (fun i => (1 : A i) ⊗ₜ[R] y) = 0 → y = 0) ∧ (∀ τ ∈ wcCnCechT A A2 ρl ρr M, ∃ y, (fun i => (1 : A i) ⊗ₜ[R] y) = τ) :=
by
  intro R _ r A _ _ A2 _ _ ρl ρr f 𝔨 M _ _ hB hK q h ι E hE L1 L2 L3
  classical

  have s1 : ∀ n : ℕ, ∃ d : Fin q → R,
      f ^ (E * (q * n + 1)) - ∑ k, d k * h k ^ (n + 1) ∈ 𝔨 := by
    intro n
    obtain ⟨g, hg, κ, hκ, hgκ⟩ := Submodule.mem_sup.mp hE
    obtain ⟨e, he⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hg
    have h1 : (f ^ E) ^ (q * n + 1) - g ^ (q * n + 1) ∈ 𝔨 := by
      have hfg : f ^ E - g = κ := by rw [← hgκ]; ring
      exact Ideal.mem_of_dvd _ (sub_dvd_pow_sub_pow _ _ _) (hfg ▸ hκ)
    have h2 : g ^ (q * n + 1) ∈ Ideal.span (Set.range fun k => (e k * h k) ^ (n + 1)) := by
      have := Ideal.sum_pow_mem_span_pow (Finset.univ : Finset (Fin q)) (fun k => e k * h k) n
      rw [Finset.card_univ, Fintype.card_fin, Finset.coe_univ, Set.image_univ] at this
      rw [← he]
      exact this
    obtain ⟨c, hc⟩ := (Ideal.mem_span_range_iff_exists_fun).mp h2
    refine ⟨fun k => c k * e k ^ (n + 1), ?_⟩
    have h3 : ∑ k, (c k * e k ^ (n + 1)) * h k ^ (n + 1) = g ^ (q * n + 1) := by
      rw [← hc]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      ring
    rw [h3, pow_mul]
    exact h1

  have hit : ∀ N : ℕ, (fun y : M => f ^ N • y) = (fun y : M => f • y)^[N] := by
    intro N
    induction N with
    | zero => funext y; simp
    | succ N ih =>
      funext y
      rw [Function.iterate_succ_apply', ← ih, pow_succ', mul_smul]
  have s2a : ∀ N, Function.Bijective (fun y : M => f ^ N • y) := fun N => by
    rw [hit N]; exact hB.iterate N
  have s2b : ∀ (N : ℕ) (i : Fin r),
      Function.Injective (fun ω : TensorProduct R (A i) M => f ^ N • ω) := by
    intro N i
    let μ : M →ₗ[R] M := f ^ N • LinearMap.id
    have hμ : Function.Bijective μ := s2a N
    let φ := LinearEquiv.ofBijective μ hμ
    have heq : ∀ ω : TensorProduct R (A i) M, LinearEquiv.lTensor (A i) φ ω = f ^ N • ω := by
      intro ω
      induction ω using TensorProduct.induction_on with
      | zero => simp
      | tmul x y =>
        rw [LinearEquiv.lTensor_tmul, LinearEquiv.ofBijective_apply, ← TensorProduct.tmul_smul]
        rfl
      | add x y hx hy => rw [map_add, hx, hy, smul_add]
    intro a b hab
    apply (LinearEquiv.lTensor (A i) φ).injective
    rw [heq, heq]
    exact hab

  have s5 : ∀ a ∈ 𝔨, ∀ i (ω : TensorProduct R (A i) M), a • ω = 0 := by
    intro a ha i ω
    induction ω using TensorProduct.induction_on with
    | zero => exact smul_zero a
    | tmul x y => rw [← TensorProduct.tmul_smul, hK a ha y, TensorProduct.tmul_zero]
    | add x y hx hy => rw [smul_add, hx, hy, add_zero]

  have s4 : ∀ k, ∀ τ ∈ wcCnCechT A A2 ρl ρr M,
      ∃ (p : ℕ) (y : M), (fun i => (1 : A i) ⊗ₜ[R] y) = h k ^ p • τ := by
    intro k τ hτ
    have hτ' : ∀ i j, LinearMap.rTensor M (ρl i j).toLinearMap (τ i) =
        LinearMap.rTensor M (ρr i j).toLinearMap (τ j) := hτ
    obtain ⟨n₀, y₀, hy₀⟩ := L2 k (τ (ι k))
    have hω : ∀ j, ∃ m : ℕ, h k ^ m • ((1 : A j) ⊗ₜ[R] y₀ - h k ^ n₀ • τ j) = 0 := by
      intro j
      apply L3 k j
      have hc := hτ' (ι k) j
      have hl : LinearMap.rTensor M (ρl (ι k) j).toLinearMap (h k ^ n₀ • τ (ι k)) =
          LinearMap.rTensor M (ρl (ι k) j).toLinearMap ((1 : A (ι k)) ⊗ₜ[R] y₀) := by
        rw [hy₀]
      rw [map_smul, hc] at hl
      rw [map_sub, map_smul, hl]
      simp
    choose m hm using hω
    refine ⟨(∑ j, m j) + n₀, (h k) ^ (∑ j, m j) • y₀, ?_⟩
    funext j
    have hle : m j ≤ ∑ j, m j :=
      Finset.single_le_sum (fun j _ => Nat.zero_le (m j)) (Finset.mem_univ j)
    have e1 : h k ^ (∑ j, m j) • ((1 : A j) ⊗ₜ[R] y₀ - h k ^ n₀ • τ j) = 0 := by
      rw [← Nat.sub_add_cancel hle, pow_add, mul_smul, hm j, smul_zero]
    rw [smul_sub, sub_eq_zero, smul_smul, ← pow_add] at e1
    simp only [Pi.smul_apply]
    rw [TensorProduct.tmul_smul, e1]
  refine ⟨fun y hy => ?_, fun τ hτ => ?_⟩
  ·
    have hn : ∀ k, ∃ n, h k ^ n • y = 0 := fun k => L1 k y (congrFun hy (ι k))
    choose n hn using hn
    obtain ⟨d, hd⟩ := s1 (∑ k, n k)
    have hk : ∀ k, h k ^ (∑ k, n k + 1) • y = 0 := by
      intro k
      have hle : n k ≤ ∑ k, n k + 1 :=
        le_trans (Finset.single_le_sum (fun j _ => Nat.zero_le (n j)) (Finset.mem_univ k))
          (Nat.le_succ _)
      rw [← Nat.sub_add_cancel hle, pow_add, mul_smul, hn k, smul_zero]
    have hfy : f ^ (E * (q * (∑ k, n k) + 1)) • y = 0 := by
      rw [← sub_add_cancel (f ^ (E * (q * (∑ k, n k) + 1))) (∑ k, d k * h k ^ (∑ k, n k + 1)),
        add_smul, hK _ hd y, zero_add, Finset.sum_smul]
      exact Finset.sum_eq_zero (fun k _ => by rw [mul_smul, hk k, smul_zero])
    apply (s2a (E * (q * (∑ k, n k) + 1))).1
    show f ^ (E * (q * (∑ k, n k) + 1)) • y = f ^ (E * (q * (∑ k, n k) + 1)) • (0 : M)
    rw [smul_zero]
    exact hfy
  ·
    choose p Y hY using fun k => s4 k τ hτ
    obtain ⟨P, hP⟩ : ∃ P, P = ∑ k, p k := ⟨_, rfl⟩
    obtain ⟨d, hd⟩ := s1 P
    have hle : ∀ k, p k ≤ P + 1 := fun k => by
      rw [hP]
      exact le_trans (Finset.single_le_sum (fun j _ => Nat.zero_le (p j)) (Finset.mem_univ k))
        (Nat.le_succ _)
    obtain ⟨Yt, hYt⟩ : ∃ Yt : M, Yt = ∑ k, (d k * h k ^ (P + 1 - p k)) • Y k := ⟨_, rfl⟩
    have hcY : ∀ i, (1 : A i) ⊗ₜ[R] Yt = (∑ k, d k * h k ^ (P + 1)) • τ i := by
      intro i
      rw [hYt, TensorProduct.tmul_sum, Finset.sum_smul]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      have := congrFun (hY k) i
      simp only [Pi.smul_apply] at this
      rw [TensorProduct.tmul_smul, this, smul_smul, mul_assoc, ← pow_add,
        Nat.sub_add_cancel (hle k)]
    obtain ⟨y, hy⟩ := (s2a (E * (q * P + 1))).2 Yt
    have hy' : f ^ (E * (q * P + 1)) • y = Yt := hy
    refine ⟨y, funext fun i => ?_⟩
    apply s2b (E * (q * P + 1)) i
    show f ^ (E * (q * P + 1)) • ((1 : A i) ⊗ₜ[R] y) = f ^ (E * (q * P + 1)) • τ i
    rw [← TensorProduct.tmul_smul, hy', hcY i]
    have h0 := s5 _ hd i (τ i)
    have hsplit : f ^ (E * (q * P + 1)) = (f ^ (E * (q * P + 1)) - ∑ k, d k * h k ^ (P + 1)) +
        ∑ k, d k * h k ^ (P + 1) := (sub_add_cancel _ _).symm
    conv_rhs => rw [hsplit]
    rw [add_smul, h0, zero_add]

theorem wc_cn_cech_exact_over_basicOpen : ∀ (Z P : Scheme.{u}) (p : P ⟶ Z) (V : Z.Opens),
    IsAffineOpen V → ∀ (r : ℕ) (W : Fin r → P.Opens) (hW : ∀ i, W i ≤ p ⁻¹ᵁ V)
    [∀ i, Algebra Γ(Z, V) Γ(P, W i)] [∀ i j, Algebra Γ(Z, V) Γ(P, W i ⊓ W j)]
    (ρl : ∀ i j, Γ(P, W i) →ₐ[Γ(Z, V)] Γ(P, W i ⊓ W j))
    (ρr : ∀ i j, Γ(P, W j) →ₐ[Γ(Z, V)] Γ(P, W i ⊓ W j)),
    wcCnChartCompat p V W hW ρl ρr →
    ∀ (f : Γ(Z, V)) (𝔨 : Ideal Γ(Z, V)),
    IsAffineOpen (p ⁻¹ᵁ Z.basicOpen f) → Function.Surjective (p.app (Z.basicOpen f)).hom →
    RingHom.ker (p.app (Z.basicOpen f)).hom =
      Ideal.map (Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom 𝔨 →
    (∀ a ∈ 𝔨, (p.app V).hom a = 0) →
    ∀ (M : Type u) [AddCommGroup M] [Module Γ(Z, V) M],
    Function.Bijective (fun y : M => f • y) → (∀ a ∈ 𝔨, ∀ y : M, a • y = 0) →
    (∀ y : M, (fun i => (1 : Γ(P, W i)) ⊗ₜ[Γ(Z, V)] y) = 0 → y = 0) ∧
    (∀ τ ∈ wcCnCechT (fun i => Γ(P, W i)) (fun i j => Γ(P, W i ⊓ W j)) ρl ρr M,
      ∃ y, (fun i => (1 : Γ(P, W i)) ⊗ₜ[Γ(Z, V)] y) = τ) :=
by
  intro Z P p V hV r W hW _ _ ρl ρr hc f 𝔨 H1 H2 H3 _H4 M _ _ hbij hk
  obtain ⟨q, a, ι, E, hE, hsub⟩ :=
    wc_cn_basicOpen_chart_refine Z P p V hV r W hc.2.1 f 𝔨 H1 H2 H3
  have L3 : ∀ k j (ω : TensorProduct Γ(Z, V) Γ(P, W j) M),
      LinearMap.rTensor M (ρr (ι k) j).toLinearMap ω = 0 → ∃ n : ℕ, (f * a k) ^ n • ω = 0 := by
    intro k j ω hω
    obtain ⟨a1, a2⟩ :=
      wc_cn_chart_restrict_away Z P p V r W hW ρl ρr hc (f * a k) (ι k) (hsub k) j
    exact wc_rTensor_ker_pow_torsion Γ(Z, V) (f * a k) _ _ (ρr (ι k) j).toLinearMap
      (fun b => by
        obtain ⟨n, x, hx⟩ := a1 b
        exact ⟨n, x, hx⟩)
      (fun x hx => a2 x hx) M ω hω
  have L12 := fun k =>
    wc_unit_tensor_pow_torsion Γ(Z, V) (f * a k) 𝔨 Γ(P, W (ι k)) M hk
      (wc_cn_chart_unit_away Z P p V hV r W hW ρl ρr hc f 𝔨 H1 H2 H3 (a k) (ι k) (hsub k)).1
      (wc_cn_chart_unit_away Z P p V hV r W hW ρl ρr hc f 𝔨 H1 H2 H3 (a k) (ι k) (hsub k)).2
  exact wc_cech_exact_of_local_pow Γ(Z, V) r (fun i => Γ(P, W i)) (fun i j => Γ(P, W i ⊓ W j))
    ρl ρr f 𝔨 M hbij hk q (fun k => f * a k) ι E hE (fun k => (L12 k).1) (fun k => (L12 k).2) L3

theorem wc_adic_completion_noetherian : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (𝔞 : Ideal R), IsNoetherianRing (AdicCompletion 𝔞 R) :=
by
  intro R _ _ 𝔞
  classical
  obtain ⟨r, x, hx⟩ := Submodule.fg_iff_exists_fin_generating_family.mp
    (IsNoetherian.noetherian 𝔞)
  have hxI : ∀ i, x i ∈ 𝔞 := fun i => hx ▸ Ideal.subset_span ⟨i, rfl⟩

  have H2 : ∀ (n : ℕ) (q : MvPolynomial (Fin r) R),
      (∀ d : Fin r →₀ ℕ, d.degree < n → q.coeff d = 0) → MvPolynomial.eval x q ∈ 𝔞 ^ n := by
    intro n q hq
    rw [MvPolynomial.eval_eq']
    refine Ideal.sum_mem _ (fun d hd => ?_)
    have hdeg : n ≤ d.degree := by
      by_contra h
      exact (MvPolynomial.mem_support_iff.mp hd) (hq d (not_le.mp h))
    apply Ideal.mul_mem_left
    have h1 : ∏ i, x i ^ d i ∈ ∏ i, 𝔞 ^ d i :=
      Ideal.prod_mem_prod (fun i _ => Ideal.pow_mem_pow (hxI i) _)
    rw [Finset.prod_pow_eq_pow_sum, ← Finsupp.degree_eq_sum] at h1
    exact Ideal.pow_le_pow_right hdeg h1

  have HC : ∀ (n : ℕ) (p q : MvPolynomial (Fin r) R),
      (∀ d : Fin r →₀ ℕ, d.degree < n → p.coeff d = q.coeff d) →
      Ideal.Quotient.mk (𝔞 ^ n) (MvPolynomial.eval x p) =
        Ideal.Quotient.mk (𝔞 ^ n) (MvPolynomial.eval x q) := by
    intro n p q h
    rw [Ideal.Quotient.eq, ← map_sub]
    exact H2 n (p - q) (fun d hd => by rw [MvPolynomial.coeff_sub, h d hd, sub_self])

  have H3' : ∀ (n : ℕ) (y : R), y ∈ Ideal.span (Set.range x) ^ n →
      ∃ h : MvPolynomial (Fin r) R, h.IsHomogeneous n ∧ MvPolynomial.eval x h = y := by
    intro n
    induction n with
    | zero =>
      intro y _
      exact ⟨MvPolynomial.C y, MvPolynomial.isHomogeneous_C _ _, MvPolynomial.eval_C _⟩
    | succ n ih =>
      intro y hy
      rw [pow_succ] at hy
      refine Submodule.mul_induction_on hy ?_ ?_
      · intro a ha b hb
        obtain ⟨ha', hah, hae⟩ := ih a ha
        obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hb
        refine ⟨ha' * ∑ i, MvPolynomial.C (c i) * MvPolynomial.X i, ?_, ?_⟩
        · apply hah.mul
          apply MvPolynomial.IsHomogeneous.sum
          intro i _
          have := (MvPolynomial.isHomogeneous_C (Fin r) (c i)).mul
            (MvPolynomial.isHomogeneous_X R i)
          rwa [zero_add] at this
        · simp only [map_mul, map_sum, MvPolynomial.eval_C, MvPolynomial.eval_X, hae, hc]
      · rintro _ _ ⟨h1, hh1, he1⟩ ⟨h2, hh2, he2⟩
        exact ⟨h1 + h2, hh1.add hh2, by rw [map_add, he1, he2]⟩
  have H3 : ∀ (n : ℕ) (y : R), y ∈ 𝔞 ^ n →
      ∃ h : MvPolynomial (Fin r) R, h.IsHomogeneous n ∧ MvPolynomial.eval x h = y := by
    intro n y hy
    rw [← hx] at hy
    exact H3' n y hy

  let f : (n : ℕ) → MvPowerSeries (Fin r) R →+* R ⧸ 𝔞 ^ n := fun n =>
    { toFun := fun F => Ideal.Quotient.mk (𝔞 ^ n) (MvPolynomial.eval x (MvPowerSeries.truncTotal n F))
      map_one' := by
        rw [← map_one (Ideal.Quotient.mk (𝔞 ^ n)), ← map_one (MvPolynomial.eval x)]
        apply HC
        intro d hd
        rw [MvPowerSeries.coeff_truncTotal _ hd, MvPowerSeries.coeff_one, MvPolynomial.coeff_one]
        by_cases h : d = 0
        · subst h; simp
        · simp [h, Ne.symm h]
      map_mul' := by
        intro F G
        rw [← map_mul, ← map_mul]
        apply HC
        intro d hd
        rw [MvPowerSeries.coeff_truncTotal _ hd, MvPowerSeries.coeff_mul, MvPolynomial.coeff_mul]
        refine Finset.sum_congr rfl (fun p hp => ?_)
        have hp' := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
        have h1 : p.1.degree + p.2.degree = d.degree := by
          rw [← hp', Finsupp.degree_eq_sum, Finsupp.degree_eq_sum, Finsupp.degree_eq_sum,
            ← Finset.sum_add_distrib]
          rfl
        rw [MvPowerSeries.coeff_truncTotal _ (by omega), MvPowerSeries.coeff_truncTotal _ (by omega)]
      map_zero' := by simp
      map_add' := by intro F G; simp }
  have hf : ∀ {m n : ℕ} (hle : m ≤ n), (Ideal.Quotient.factorPow 𝔞 hle).comp (f n) = f m := by
    intro m n hle
    refine RingHom.ext (fun F => ?_)
    have hfp : ∀ y : R, Ideal.Quotient.factorPow 𝔞 hle (Ideal.Quotient.mk (𝔞 ^ n) y) =
        Ideal.Quotient.mk (𝔞 ^ m) y := fun y => rfl
    show Ideal.Quotient.factorPow 𝔞 hle (Ideal.Quotient.mk (𝔞 ^ n)
        (MvPolynomial.eval x (MvPowerSeries.truncTotal n F))) =
      Ideal.Quotient.mk (𝔞 ^ m) (MvPolynomial.eval x (MvPowerSeries.truncTotal m F))
    rw [hfp]
    apply HC
    intro d hd
    rw [MvPowerSeries.coeff_truncTotal _ hd,
      MvPowerSeries.coeff_truncTotal _ (lt_of_lt_of_le hd hle)]

  set Ψ := AdicCompletion.liftRingHom 𝔞 f hf with hΨdef
  have hΨ : ∀ (n : ℕ) (F : MvPowerSeries (Fin r) R), AdicCompletion.evalₐ 𝔞 n (Ψ F) =
      Ideal.Quotient.mk (𝔞 ^ n) (MvPolynomial.eval x (MvPowerSeries.truncTotal n F)) := by
    intro n F
    rw [hΨdef, AdicCompletion.evalₐ_liftRingHom]
    rfl

  have hsurj : Function.Surjective Ψ := by
    intro b
    obtain ⟨a, rfl⟩ := AdicCompletion.mk_surjective 𝔞 R b
    have ha : ∀ m n, m ≤ n → (a : ℕ → R) n - (a : ℕ → R) m ∈ 𝔞 ^ m := by
      intro m n hmn
      have := AdicCompletion.AdicCauchySequence.mk_eq_mk hmn a
      rw [Submodule.Quotient.eq] at this
      simpa [Ideal.smul_eq_mul, Ideal.mul_top] using this
    let c : ℕ → R := fun k => if k = 0 then 0 else (a : ℕ → R) k
    have hc : ∀ k, c (k + 1) - c k ∈ 𝔞 ^ k := by
      intro k
      rcases Nat.eq_zero_or_pos k with rfl | hk
      · simp
      · simp only [c, if_neg (Nat.succ_ne_zero k), if_neg hk.ne']
        exact ha k (k + 1) (Nat.le_succ k)
    choose h hh he using fun k => H3 k _ (hc k)
    let F : MvPowerSeries (Fin r) R := fun e => (h e.degree).coeff e
    refine ⟨F, ?_⟩
    apply AdicCompletion.ext_evalₐ
    intro n
    rw [hΨ, AdicCompletion.evalₐ_mk]
    have e1 : Ideal.Quotient.mk (𝔞 ^ n) (MvPolynomial.eval x (MvPowerSeries.truncTotal n F)) =
        Ideal.Quotient.mk (𝔞 ^ n) (MvPolynomial.eval x (∑ k ∈ Finset.range n, h k)) := by
      apply HC
      intro d hd
      rw [MvPowerSeries.coeff_truncTotal _ hd, MvPolynomial.coeff_sum,
        Finset.sum_eq_single_of_mem d.degree (Finset.mem_range.mpr hd)]
      · rfl
      · intro k _ hk
        exact (hh k).coeff_eq_zero (Ne.symm hk)
    rw [e1, map_sum]
    simp only [he]
    rw [Finset.sum_range_sub]
    have hc0 : c 0 = 0 := by simp [c]
    rw [hc0, sub_zero]
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · rw [Ideal.Quotient.eq]; simp
    · simp only [c, if_neg hn.ne']

  have : IsNoetherianRing (MvPowerSeries (Fin r) R) := MvPowerSeries.isNoetherianRing R
  exact isNoetherianRing_of_surjective (MvPowerSeries (Fin r) R) _ Ψ hsurj

theorem wc_adic_completion_mod_separated : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (𝔞 : Ideal R), IsNoetherianRing (AdicCompletion 𝔞 R) → ∀ (M : Type u) [AddCommGroup M] [Module (AdicCompletion 𝔞 R) M] [Module R M] [IsScalarTower R (AdicCompletion 𝔞 R) M], Module.Finite (AdicCompletion 𝔞 R) M → ∀ x : M, (∀ n : ℕ, x ∈ 𝔞 ^ n • (⊤ : Submodule R M)) → x = 0 :=
by
  intro R _ _ 𝔞 hT M _ _ _ _ hM x hx
  haveI : IsNoetherianRing (AdicCompletion 𝔞 R) := hT
  haveI : Module.Finite (AdicCompletion 𝔞 R) M := hM
  have hfg : 𝔞.FG := IsNoetherian.noetherian 𝔞
  haveI hR : IsAdicComplete 𝔞 (AdicCompletion 𝔞 R) := AdicCompletion.isAdicComplete hfg
  let J : Ideal (AdicCompletion 𝔞 R) := Ideal.map (algebraMap R (AdicCompletion 𝔞 R)) 𝔞
  have key : ∀ (n : ℕ) (y : AdicCompletion 𝔞 R),
      y ∈ J ^ n • (⊤ : Submodule (AdicCompletion 𝔞 R) (AdicCompletion 𝔞 R)) ↔
        y ∈ 𝔞 ^ n • (⊤ : Submodule R (AdicCompletion 𝔞 R)) := by
    intro n y
    rw [Ideal.smul_eq_mul, Ideal.mul_top, Ideal.smul_top_eq_map, Submodule.restrictScalars_mem,
      Ideal.map_pow]
  haveI hH : IsHausdorff J (AdicCompletion 𝔞 R) := ⟨fun y hy => by
    apply IsHausdorff.haus hR.toIsHausdorff y
    intro n
    have h1 := hy n
    rw [SModEq.sub_mem] at h1 ⊢
    exact (key n _).mp h1⟩
  haveI hP : IsPrecomplete J (AdicCompletion 𝔞 R) := ⟨fun f hf => by
    obtain ⟨L, hL⟩ := IsPrecomplete.prec hR.toIsPrecomplete (f := f) (fun {m n} hmn => by
      have h1 := hf hmn
      rw [SModEq.sub_mem] at h1 ⊢
      exact (key m _).mp h1)
    refine ⟨L, fun n => ?_⟩
    have h1 := hL n
    rw [SModEq.sub_mem] at h1 ⊢
    exact (key n _).mpr h1⟩
  haveI : IsAdicComplete J (AdicCompletion 𝔞 R) := {}
  have hJ : J ≤ (⊥ : Ideal (AdicCompletion 𝔞 R)).jacobson := IsAdicComplete.le_jacobson_bot J
  have hK := Ideal.iInf_pow_smul_eq_bot_of_le_jacobson (M := M) J hJ
  have hsub : ∀ n : ℕ, x ∈ J ^ n • (⊤ : Submodule (AdicCompletion 𝔞 R) M) := by
    intro n
    have hle : 𝔞 ^ n • (⊤ : Submodule R M) ≤
        (J ^ n • (⊤ : Submodule (AdicCompletion 𝔞 R) M)).restrictScalars R := by
      apply Submodule.smul_le.mpr
      intro r hr m _
      rw [Submodule.restrictScalars_mem, ← algebraMap_smul (AdicCompletion 𝔞 R) r m]
      apply Submodule.smul_mem_smul _ Submodule.mem_top
      rw [← Ideal.map_pow]
      exact Ideal.mem_map_of_mem _ hr
    exact hle (hx n)
  have hmem : x ∈ ⨅ i, J ^ i • (⊤ : Submodule (AdicCompletion 𝔞 R) M) :=
    (Submodule.mem_iInf _).mpr hsub
  rw [hK] at hmem
  exact (Submodule.mem_bot _).mp hmem

theorem wc_adic_completion_mod_complete : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (𝔞 : Ideal R) (M : Type u) [AddCommGroup M] [Module (AdicCompletion 𝔞 R) M] [Module R M] [IsScalarTower R (AdicCompletion 𝔞 R) M], Module.Finite (AdicCompletion 𝔞 R) M → ∀ u : ℕ → M, (∀ n : ℕ, u (n + 1) - u n ∈ 𝔞 ^ n • (⊤ : Submodule R M)) → ∃ t : M, ∀ n : ℕ, t - u n ∈ 𝔞 ^ n • (⊤ : Submodule R M) :=
by
  intro R _ _ 𝔞 M _ _ _ _ hfin u hu
  classical
  have h𝔞 : 𝔞.FG := IsNoetherian.noetherian 𝔞
  set J : Ideal (AdicCompletion 𝔞 R) := Ideal.map (algebraMap R (AdicCompletion 𝔞 R)) 𝔞 with hJ
  have htr : ∀ (k : ℕ) (x : M), x ∈ 𝔞 ^ k • (⊤ : Submodule R M) ↔
      x ∈ J ^ k • (⊤ : Submodule (AdicCompletion 𝔞 R) M) := by
    intro k x
    have h := Ideal.smul_restrictScalars (𝔞 ^ k) (⊤ : Submodule (AdicCompletion 𝔞 R) M)
    rw [Submodule.restrictScalars_top, Ideal.map_pow] at h
    rw [← h, Submodule.restrictScalars_mem]
  have htrR : ∀ (k : ℕ) (y : AdicCompletion 𝔞 R),
      y ∈ 𝔞 ^ k • (⊤ : Submodule R (AdicCompletion 𝔞 R)) ↔ y ∈ J ^ k := by
    intro k y
    rw [Ideal.smul_top_eq_map, Submodule.restrictScalars_mem, Ideal.map_pow]
  have hprec : IsPrecomplete 𝔞 (AdicCompletion 𝔞 R) :=
    (AdicCompletion.isAdicComplete (M := R) h𝔞).toIsPrecomplete
  have hser : ∀ c : ℕ → AdicCompletion 𝔞 R, (∀ n, c n ∈ J ^ n) →
      ∃ T, ∀ N, T - ∑ n ∈ Finset.range N, c n ∈ J ^ N := by
    intro c hc
    obtain ⟨L, hL⟩ := IsPrecomplete.prec hprec (f := fun N => ∑ n ∈ Finset.range N, c n)
      (fun {m n} hmn => by
        rw [SModEq.sub_mem, htrR, ← neg_sub, ← Finset.sum_Ico_eq_sub _ hmn]
        exact neg_mem (Ideal.sum_mem _ fun k hk =>
          Ideal.pow_le_pow_right (Finset.mem_Ico.mp hk).1 (hc k)))
    refine ⟨L, fun N => ?_⟩
    have h := hL N
    rw [SModEq.sub_mem, htrR] at h
    rw [← neg_sub]
    exact neg_mem h
  obtain ⟨q, g, hg⟩ := Module.Finite.exists_fin (R := AdicCompletion 𝔞 R) (M := M)
  have hdec : ∀ n, ∃ c : Fin q → AdicCompletion 𝔞 R, (∀ i, c i ∈ J ^ n) ∧
      ∑ i, c i • g i = u (n + 1) - u n := by
    intro n
    have h := (htr n _).mp (hu n)
    rw [← hg, Submodule.mem_ideal_smul_span_iff_exists_sum] at h
    obtain ⟨a, ha, hsum⟩ := h
    refine ⟨a, ha, ?_⟩
    rw [← hsum, Finsupp.sum_fintype]
    intro i
    exact zero_smul _ _
  choose c hcJ hcsum using hdec
  choose T hT using fun i => hser (fun n => c n i) (fun n => hcJ n i)
  refine ⟨u 0 + ∑ i, T i • g i, fun N => ?_⟩
  have htel : u N = u 0 + ∑ i, (∑ n ∈ Finset.range N, c n i) • g i := by
    have h1 := Finset.sum_range_sub u N
    simp_rw [← hcsum] at h1
    rw [Finset.sum_comm] at h1
    simp_rw [Finset.sum_smul]
    rw [h1]
    abel
  rw [htr, htel]
  have hrw : u 0 + ∑ i, T i • g i - (u 0 + ∑ i, (∑ n ∈ Finset.range N, c n i) • g i) =
      ∑ i, (T i - ∑ n ∈ Finset.range N, c n i) • g i := by
    simp only [sub_smul, Finset.sum_sub_distrib]
    abel
  rw [hrw]
  exact Submodule.sum_mem _ fun i _ => Submodule.smul_mem_smul (hT i N) Submodule.mem_top

theorem wc_adic_limit_completion_module : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (𝔞 : Ideal R) (N : ℕ → Type u) [∀ n, AddCommGroup (N n)] [∀ n, Module R (N n)] (ψ : ∀ n, N (n + 1) →ₗ[R] N n), (∀ n, Module.Finite R (N n)) → (∀ n, ∀ a ∈ 𝔞 ^ (n + 1), ∀ x : N n, a • x = 0) → (∀ n, Function.Surjective (ψ n)) → (∀ n (x : N (n + 1)), ψ n x = 0 ↔ x ∈ 𝔞 ^ (n + 1) • (⊤ : Submodule R (N (n + 1)))) → ∃ (_ : Module (AdicCompletion 𝔞 R) (wcCnLimMod N ψ)), IsScalarTower R (AdicCompletion 𝔞 R) (wcCnLimMod N ψ) ∧ Module.Finite (AdicCompletion 𝔞 R) (wcCnLimMod N ψ) :=
by
  intro R _ _ 𝔞 N _ _ ψ hfin hkill hsurj hker
  classical

  have hK : ∀ n (a a' : R), a - a' ∈ 𝔞 ^ (n + 1) → ∀ y : N n, a • y = a' • y := by
    intro n a a' h y
    have h0 := hkill n _ h y
    rw [sub_smul] at h0
    exact sub_eq_zero.mp h0

  have hxc : ∀ (x : wcCnLimMod N ψ) n, ψ n ((x : ∀ n, N n) (n + 1)) = (x : ∀ n, N n) n :=
    fun x => x.2

  obtain ⟨σ, hσ⟩ : ∃ σ : AdicCompletion 𝔞 R → AdicCompletion.AdicCauchySequence 𝔞 R,
      ∀ b, AdicCompletion.mk 𝔞 R (σ b) = b :=
    ⟨_, Function.surjInv_eq (AdicCompletion.mk_surjective 𝔞 R)⟩
  have L0 : ∀ k b, AdicCompletion.evalₐ 𝔞 k b = Ideal.Quotient.mk (𝔞 ^ k) ((σ b).1 k) := by
    intro k b
    conv_lhs => rw [← hσ b]
    rw [AdicCompletion.evalₐ_mk]
  have L1 : ∀ n b, (σ b).1 (n + 1 + 1) - (σ b).1 (n + 1) ∈ 𝔞 ^ (n + 1) := by
    intro n b
    have h := AdicCompletion.AdicCauchySequence.mk_eq_mk (I := 𝔞) (M := R) (m := n + 1)
      (n := n + 1 + 1) (Nat.le_succ _) (σ b)
    rw [Submodule.Quotient.eq] at h
    simpa [Ideal.mul_top] using h

  have hmem : ∀ (b : AdicCompletion 𝔞 R) (x : wcCnLimMod N ψ),
      (fun n => (σ b).1 (n + 1) • (x : ∀ n, N n) n) ∈ wcCnLimMod N ψ := by
    intro b x
    show ∀ n, ψ n ((σ b).1 (n + 1 + 1) • (x : ∀ n, N n) (n + 1)) =
      (σ b).1 (n + 1) • (x : ∀ n, N n) n
    intro n
    rw [map_smul, hxc x n]
    exact hK n _ _ (L1 n b) _
  letI sm : SMul (AdicCompletion 𝔞 R) (wcCnLimMod N ψ) :=
    ⟨fun b x => ⟨fun n => (σ b).1 (n + 1) • (x : ∀ n, N n) n, hmem b x⟩⟩
  have hsm : ∀ (b : AdicCompletion 𝔞 R) (x : wcCnLimMod N ψ) n,
      ((b • x : wcCnLimMod N ψ) : ∀ n, N n) n = (σ b).1 (n + 1) • (x : ∀ n, N n) n :=
    fun _ _ _ => rfl

  have hP : ∀ (b : AdicCompletion 𝔞 R) (x : wcCnLimMod N ψ) (n : ℕ) (r : R),
      Ideal.Quotient.mk (𝔞 ^ (n + 1)) r = AdicCompletion.evalₐ 𝔞 (n + 1) b →
      ((b • x : wcCnLimMod N ψ) : ∀ n, N n) n = r • (x : ∀ n, N n) n := by
    intro b x n r h
    rw [hsm]
    rw [L0, Ideal.Quotient.eq] at h
    exact (hK n _ _ h _).symm
  letI inst : Module (AdicCompletion 𝔞 R) (wcCnLimMod N ψ) := Module.ofMinimalAxioms
    (fun b x y => by
      apply Subtype.ext
      funext n
      simp only [Submodule.coe_add, Pi.add_apply, hsm, smul_add])
    (fun b c x => by
      apply Subtype.ext
      funext n
      rw [Submodule.coe_add, Pi.add_apply,
        hP (b + c) x n ((σ b).1 (n + 1) + (σ c).1 (n + 1))
          (by rw [map_add, map_add, L0 (n + 1) b, L0 (n + 1) c]),
        hsm, hsm, add_smul])
    (fun b c x => by
      apply Subtype.ext
      funext n
      rw [hP (b * c) x n ((σ b).1 (n + 1) * (σ c).1 (n + 1))
          (by rw [map_mul, map_mul, L0 (n + 1) b, L0 (n + 1) c]),
        hsm, hsm, mul_smul])
    (fun x => by
      apply Subtype.ext
      funext n
      rw [hP 1 x n 1 (by rw [map_one, map_one]), one_smul])
  have htow : IsScalarTower R (AdicCompletion 𝔞 R) (wcCnLimMod N ψ) := ⟨fun a b x => by
    apply Subtype.ext
    funext n
    rw [hP (a • b) x n (a * (σ b).1 (n + 1)) ?_]
    · rw [Submodule.coe_smul, Pi.smul_apply, hsm, mul_smul]
    · rw [map_smul, map_mul, L0 (n + 1) b, ← Ideal.Quotient.algebraMap_eq, Algebra.smul_def]⟩

  obtain ⟨k, gen, hgen, hrep⟩ := wc_adic_limit_submodule_fg R 𝔞 N ψ hfin hkill hsurj hker
    (wcCnLimMod N ψ : Set (∀ n, N n))
    (fun x hx => hx) (Submodule.zero_mem _) (fun x hx y hy => Submodule.add_mem _ hx hy)
    (fun x hx d hd => by
      have hx' : ∀ n, ψ n (x (n + 1)) = x n := hx
      show ∀ n, ψ n (d (n + 1) • x (n + 1)) = d n • x n
      intro n
      rw [map_smul, hx' n]
      exact hK n _ _ (hd n) _)
  let g : Fin k → wcCnLimMod N ψ := fun i => ⟨gen i, hgen i⟩
  have hspan : Submodule.span (AdicCompletion 𝔞 R) (Set.range g) = ⊤ := by
    rw [Submodule.eq_top_iff']
    intro x
    obtain ⟨d, hd, hx⟩ := hrep (x : ∀ n, N n) x.2
    rw [Submodule.mem_span_range_iff_exists_fun]
    let c : Fin k → ℕ → R := fun i m => match m with
      | 0 => 0
      | j + 1 => d i j
    have hc : ∀ i m, c i m ≡ c i (m + 1) [SMOD 𝔞 ^ m • (⊤ : Submodule R R)] := by
      intro i m
      rw [SModEq.sub_mem]
      cases m with
      | zero => simp
      | succ j =>
        show d i j - d i (j + 1) ∈ 𝔞 ^ (j + 1) • (⊤ : Submodule R R)
        rw [Ideal.smul_eq_mul, Ideal.mul_top, ← neg_sub]
        exact neg_mem (hd i j)
    let bb : Fin k → AdicCompletion 𝔞 R := fun i =>
      AdicCompletion.mk 𝔞 R (AdicCompletion.AdicCauchySequence.mk 𝔞 R (c i) (hc i))
    refine ⟨bb, ?_⟩
    apply Subtype.ext
    funext n
    rw [Submodule.coe_sum, Finset.sum_apply, hx n]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    have e := AdicCompletion.evalₐ_mk 𝔞 (n + 1)
      (AdicCompletion.AdicCauchySequence.mk 𝔞 R (c i) (hc i))
    exact hP (bb i) (g i) n (d i n) e.symm
  exact ⟨inst, htow, ⟨⟨Finset.univ.image g, by
    rw [Finset.coe_image, Finset.coe_univ, Set.image_univ]
    exact hspan⟩⟩⟩

theorem wc_adic_limit_proj_surjective : ∀ (R : Type u) [CommRing R] (N : ℕ → Type u) [∀ n, AddCommGroup (N n)] [∀ n, Module R (N n)] (ψ : ∀ n, N (n + 1) →ₗ[R] N n), (∀ n, Function.Surjective (ψ n)) → ∀ n, Function.Surjective ((LinearMap.proj (R := R) (φ := N) n).comp (wcCnLimMod N ψ).subtype) :=
by
  intro R _ N _ _ ψ hψ n y
  let s : ∀ k, N k → N (k + 1) := fun k => Function.surjInv (hψ k)
  have hs : ∀ k z, ψ k (s k z) = z := fun k z => Function.surjInv_eq (hψ k) z
  let UP : ∀ m, n ≤ m → N m := fun m h => Nat.leRecOn (C := N) h (fun {k} z => s k z) y
  let DN : ∀ m, m ≤ n → N m := fun m h =>
    Nat.decreasingInduction (motive := fun k _ => N k) (fun k _ z => ψ k z) y h
  let x : ∀ m, N m := fun m => if h : n ≤ m then UP m h else DN m (by omega)
  have hUPself : UP n le_rfl = y := Nat.leRecOn_self _
  have hUPsucc : ∀ m (h : n ≤ m), UP (m + 1) (Nat.le_succ_of_le h) = s m (UP m h) :=
    fun m h => Nat.leRecOn_succ h _
  have hDNself : DN n le_rfl = y := Nat.decreasingInduction_self _ _
  have hDNsucc : ∀ m (h : m + 1 ≤ n), DN m (by omega) = ψ m (DN (m + 1) h) :=
    fun m h => Nat.decreasingInduction_succ_left _ _ h _
  have hx : ∀ m, ψ m (x (m + 1)) = x m := by
    intro m
    by_cases hA : n ≤ m
    · have hA' : n ≤ m + 1 := by omega
      have e1 : x (m + 1) = UP (m + 1) hA' := dif_pos hA'
      have e2 : x m = UP m hA := dif_pos hA
      rw [e1, e2, hUPsucc m hA, hs]
    · have hB : m + 1 ≤ n := by omega
      have e1 : x m = ψ m (DN (m + 1) hB) := by
        have : x m = DN m (by omega) := dif_neg hA
        rw [this, hDNsucc m hB]
      have e2 : x (m + 1) = DN (m + 1) hB := by
        by_cases hC : n ≤ m + 1
        · have e3 : x (m + 1) = UP (m + 1) hC := dif_pos hC
          rw [e3]
          obtain rfl : n = m + 1 := by omega
          rw [hUPself, hDNself]
        · exact dif_neg hC
      rw [e1, e2]
  refine ⟨⟨x, hx⟩, ?_⟩
  show x n = y
  have e : x n = UP n le_rfl := dif_pos le_rfl
  rw [e, hUPself]

theorem wc_adic_limit_proj_ker : ∀ (R : Type u) [CommRing R] (𝔞 : Ideal R) (N : ℕ → Type u) [∀ n, AddCommGroup (N n)] [∀ n, Module R (N n)] (ψ : ∀ n, N (n + 1) →ₗ[R] N n), (∀ n, ∀ a ∈ 𝔞 ^ (n + 1), ∀ x : N n, a • x = 0) → (∀ n (x : N (n + 1)), ψ n x = 0 ↔ x ∈ 𝔞 ^ (n + 1) • (⊤ : Submodule R (N (n + 1)))) → (∀ n, Function.Surjective ((LinearMap.proj (R := R) (φ := N) n).comp (wcCnLimMod N ψ).subtype)) → (∀ u : ℕ → wcCnLimMod N ψ, (∀ n : ℕ, u (n + 1) - u n ∈ 𝔞 ^ n • (⊤ : Submodule R (wcCnLimMod N ψ))) → ∃ t : wcCnLimMod N ψ, ∀ n : ℕ, t - u n ∈ 𝔞 ^ n • (⊤ : Submodule R (wcCnLimMod N ψ))) → ∀ n (x : wcCnLimMod N ψ), (x : ∀ n, N n) n = 0 ↔ x ∈ 𝔞 ^ (n + 1) • (⊤ : Submodule R (wcCnLimMod N ψ)) :=
by
  intro R _ 𝔞 N _ _ ψ hkill hker hpr hcompl

  have s1 : ∀ (k j : ℕ), j + 1 ≤ k → ∀ w : wcCnLimMod N ψ,
      w ∈ 𝔞 ^ k • (⊤ : Submodule R (wcCnLimMod N ψ)) → (w : ∀ n, N n) j = 0 := by
    intro k j hjk w hw
    refine Submodule.smul_induction_on
      (p := fun w : wcCnLimMod N ψ => (w : ∀ n, N n) j = 0) hw ?_ ?_
    · intro r hr v _
      have hr' : r ∈ 𝔞 ^ (j + 1) := Ideal.pow_le_pow_right hjk hr
      change r • (v : ∀ n, N n) j = 0
      exact hkill j r hr' _
    · intro a b ha hb
      change (a : ∀ n, N n) j + (b : ∀ n, N n) j = 0
      rw [ha, hb, add_zero]

  have s2 : ∀ (z : wcCnLimMod N ψ) (j d : ℕ), (z : ∀ n, N n) (j + d) = 0 →
      (z : ∀ n, N n) j = 0 := by
    intro z j d
    have hz : ∀ m, ψ m ((z : ∀ n, N n) (m + 1)) = (z : ∀ n, N n) m := z.2
    induction d with
    | zero => exact id
    | succ d ih =>
      intro h
      apply ih
      have h' : (z : ∀ n, N n) (j + d + 1) = 0 := h
      rw [← hz (j + d), h', map_zero]

  have s3 : ∀ (m : ℕ) (y : wcCnLimMod N ψ),
      ∃ w ∈ 𝔞 ^ (m + 1) • (⊤ : Submodule R (wcCnLimMod N ψ)),
        ((y : ∀ n, N n) m = 0 → ((y - w : wcCnLimMod N ψ) : ∀ n, N n) (m + 1) = 0) := by
    intro m y
    by_cases hy : (y : ∀ n, N n) m = 0
    · have hy' : ψ m ((y : ∀ n, N n) (m + 1)) = 0 := by
        have hz : ∀ m, ψ m ((y : ∀ n, N n) (m + 1)) = (y : ∀ n, N n) m := y.2
        rw [hz m, hy]
      have hmem := (hker m _).mp hy'
      have lift : ∀ v ∈ 𝔞 ^ (m + 1) • (⊤ : Submodule R (N (m + 1))),
          ∃ w ∈ 𝔞 ^ (m + 1) • (⊤ : Submodule R (wcCnLimMod N ψ)),
            (w : ∀ n, N n) (m + 1) = v := by
        intro v hv
        refine Submodule.smul_induction_on
          (p := fun v => ∃ w ∈ 𝔞 ^ (m + 1) • (⊤ : Submodule R (wcCnLimMod N ψ)),
            (w : ∀ n, N n) (m + 1) = v) hv ?_ ?_
        · intro r hr z _
          obtain ⟨zh, hzh⟩ := hpr (m + 1) z
          refine ⟨r • zh, Submodule.smul_mem_smul hr Submodule.mem_top, ?_⟩
          change r • (zh : ∀ n, N n) (m + 1) = r • z
          rw [← hzh]
          rfl
        · rintro a b ⟨wa, hwa, ha⟩ ⟨wb, hwb, hb⟩
          refine ⟨wa + wb, Submodule.add_mem _ hwa hwb, ?_⟩
          change (wa : ∀ n, N n) (m + 1) + (wb : ∀ n, N n) (m + 1) = a + b
          rw [ha, hb]
      obtain ⟨w, hw, hwv⟩ := lift _ hmem
      refine ⟨w, hw, fun _ => ?_⟩
      change (y : ∀ n, N n) (m + 1) - (w : ∀ n, N n) (m + 1) = 0
      rw [hwv, sub_self]
    · exact ⟨0, Submodule.zero_mem _, fun h => absurd h hy⟩
  choose W hW1 hW2 using s3
  have hmono : ∀ a b : ℕ, a ≤ b →
      𝔞 ^ b • (⊤ : Submodule R (wcCnLimMod N ψ)) ≤ 𝔞 ^ a • (⊤ : Submodule R (wcCnLimMod N ψ)) :=
    fun a b hab => Submodule.smul_mono_left (Ideal.pow_le_pow_right hab)
  intro n x
  constructor
  · intro hx

    obtain ⟨u, hu0, hus⟩ : ∃ u : ℕ → wcCnLimMod N ψ, u 0 = x ∧
        ∀ k, u (k + 1) = u k - W (n + k) (u k) :=
      ⟨fun k => Nat.rec x (fun k uk => uk - W (n + k) uk) k, rfl, fun k => rfl⟩
    have hucoord : ∀ k, (u k : ∀ n, N n) (n + k) = 0 := by
      intro k
      induction k with
      | zero => rw [hu0]; exact hx
      | succ k ih => rw [hus k]; exact hW2 (n + k) (u k) ih
    obtain ⟨t, ht⟩ := hcompl u (fun k => by
      rw [hus k, sub_sub_cancel_left]
      exact Submodule.neg_mem _ (hmono k (n + k + 1) (by omega) (hW1 _ _)))
    have ht0 : t = 0 := by
      apply Subtype.ext
      funext j
      show (t : ∀ n, N n) j = 0
      have e1 := s1 (j + 1) j le_rfl _ (ht (j + 1))
      have e2 : (u (j + 1) : ∀ n, N n) j = 0 := by
        apply s2 (u (j + 1)) j (n + 1)
        have := hucoord (j + 1)
        rw [show n + (j + 1) = j + (n + 1) by omega] at this
        exact this
      have e3 : (t : ∀ n, N n) j = ((t - u (j + 1) : wcCnLimMod N ψ) : ∀ n, N n) j +
          (u (j + 1) : ∀ n, N n) j := by
        change (t : ∀ n, N n) j = ((t : ∀ n, N n) j - (u (j + 1) : ∀ n, N n) j) +
          (u (j + 1) : ∀ n, N n) j
        rw [sub_add_cancel]
      rw [e3, e1, e2, add_zero]
    have hxu : ∀ k, x - u k ∈ 𝔞 ^ (n + 1) • (⊤ : Submodule R (wcCnLimMod N ψ)) := by
      intro k
      induction k with
      | zero => rw [hu0, sub_self]; exact Submodule.zero_mem _
      | succ k ih =>
        have e : x - u (k + 1) = (x - u k) + W (n + k) (u k) := by rw [hus k]; abel
        rw [e]
        exact Submodule.add_mem _ ih (hmono (n + 1) (n + k + 1) (by omega) (hW1 _ _))
    have h1 := ht (n + 1)
    rw [ht0, zero_sub] at h1
    have h2 := Submodule.neg_mem _ h1
    rw [neg_neg] at h2
    have h3 := Submodule.add_mem _ (hxu (n + 1)) h2
    rwa [sub_add_cancel] at h3
  · intro hx
    exact s1 (n + 1) n le_rfl x hx

theorem wc_adic_limit_sqzero_ring : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (𝔞 : Ideal R)
    (N : ℕ → Type u) [∀ n, AddCommGroup (N n)] [∀ n, Module R (N n)]
    (ψ : ∀ n, N (n + 1) →ₗ[R] N n),
    (∀ n, Module.Finite R (N n)) →
    (∀ n, ∀ a ∈ 𝔞 ^ (n + 1), ∀ x : N n, a • x = 0) →
    (∀ n, Function.Surjective (ψ n)) →
    (∀ n (x : N (n + 1)), ψ n x = 0 ↔ x ∈ 𝔞 ^ (n + 1) • (⊤ : Submodule R (N (n + 1)))) →
    ∃ (S : Type u) (_ : CommRing S) (_ : Algebra R S) (ι : wcCnLimMod N ψ →ₗ[R] S)
      (π : S →ₗ[R] wcCnLimMod N ψ), IsNoetherianRing S ∧ (∀ x, π (ι x) = x) ∧
      (∀ n, Function.Surjective ((LinearMap.proj (R := R) (φ := N) n).comp
        (wcCnLimMod N ψ).subtype)) ∧
      (∀ n (x : wcCnLimMod N ψ), (x : ∀ n, N n) n = 0 ↔
        x ∈ 𝔞 ^ (n + 1) • (⊤ : Submodule R (wcCnLimMod N ψ))) ∧
      wcCnFfHC 𝔞 S :=
by
  intro R _ _ 𝔞 N _ _ ψ hfin hkill hsurj hker

  have s6 : ∀ (T S : Type u) [CommRing T] [CommRing S] [Algebra R T] [Algebra T S] [Algebra R S]
      [IsScalarTower R T S] [Module.Finite T S], wcCnFfHC 𝔞 T → wcCnFfHC 𝔞 S := by
    intro T S _ _ _ _ _ _ _ hT M _ _ _ _ hM
    letI : Module T M := Module.compHom M (algebraMap T S)
    haveI : IsScalarTower T S M := ⟨fun t s m => by
      change (t • s) • m = (algebraMap T S t) • (s • m)
      rw [Algebra.smul_def, mul_smul]⟩
    haveI : IsScalarTower R T M := ⟨fun r t m => by
      change (algebraMap T S (r • t)) • m = r • ((algebraMap T S t) • m)
      rw [Algebra.smul_def r t, map_mul, ← IsScalarTower.algebraMap_apply R T S r, mul_smul,
        algebraMap_smul S r]⟩
    haveI : Module.Finite T M := Module.Finite.trans S M
    exact hT M inferInstance

  have s7 : ∀ (T L : Type u) [CommRing T] [Algebra R T] [IsNoetherianRing T] [AddCommGroup L]
      [Module T L] [Module R L] [IsScalarTower R T L] [Module.Finite T L],
      ∃ (S : Type u) (_ : CommRing S) (_ : Algebra R S) (_ : Algebra T S) (ι : L →ₗ[R] S)
        (π : S →ₗ[R] L), IsScalarTower R T S ∧ Module.Finite T S ∧ IsNoetherianRing S ∧
        ∀ x, π (ι x) = x := by
    intro T L _ _ _ _ _ _ _ _
    letI : Module Tᵐᵒᵖ L := Module.compHom L ((RingEquiv.toOpposite T).symm : Tᵐᵒᵖ →+* T)
    haveI : IsCentralScalar T L := ⟨fun t l => rfl⟩
    haveI : SMulCommClass T Tᵐᵒᵖ L := ⟨fun t t' l => by
      change t • (t'.unop • l) = t'.unop • (t • l)
      rw [smul_comm]⟩
    haveI : IsScalarTower R Tᵐᵒᵖ L := ⟨fun r t l => by
      change (r • t).unop • l = r • (t.unop • l)
      rw [MulOpposite.unop_smul, smul_assoc]⟩
    haveI : IsScalarTower T Tᵐᵒᵖ L := ⟨fun t t' l => by
      change (t • t').unop • l = t • (t'.unop • l)
      rw [MulOpposite.unop_smul, smul_eq_mul, mul_smul]⟩
    letI iS : CommRing (TrivSqZeroExt T L) := TrivSqZeroExt.commRing
    letI aR : Algebra R (TrivSqZeroExt T L) := TrivSqZeroExt.algebra' R T L
    letI aT : Algebra T (TrivSqZeroExt T L) := TrivSqZeroExt.algebra' T T L
    haveI htow : IsScalarTower R T (TrivSqZeroExt T L) := TrivSqZeroExt.isScalarTower
    haveI hfS : Module.Finite T (TrivSqZeroExt T L) := by
      let f : (T × L) →ₗ[T] TrivSqZeroExt T L :=
        { toFun := fun p => TrivSqZeroExt.inl p.1 + TrivSqZeroExt.inr p.2
          map_add' := fun p q => by
            simp only [Prod.fst_add, Prod.snd_add, TrivSqZeroExt.inl_add, TrivSqZeroExt.inr_add]
            abel
          map_smul' := fun c p => by
            simp only [Prod.smul_fst, Prod.smul_snd, RingHom.id_apply, smul_add,
              TrivSqZeroExt.inl_smul, TrivSqZeroExt.inr_smul] }
      refine Module.Finite.of_surjective f (fun x => ⟨(x.fst, x.snd), ?_⟩)
      exact TrivSqZeroExt.inl_fst_add_inr_snd_eq x
    haveI : IsNoetherianRing (TrivSqZeroExt T L) := IsNoetherianRing.of_finite T _
    refine ⟨TrivSqZeroExt T L, iS, aR, aT,
      { toFun := TrivSqZeroExt.inr
        map_add' := TrivSqZeroExt.inr_add T
        map_smul' := fun r x => TrivSqZeroExt.inr_smul T r x },
      { toFun := TrivSqZeroExt.snd
        map_add' := TrivSqZeroExt.snd_add
        map_smul' := fun r x => TrivSqZeroExt.snd_smul r x },
      htow, hfS, inferInstance, fun x => TrivSqZeroExt.snd_inr T x⟩

  haveI hRc : IsNoetherianRing (AdicCompletion 𝔞 R) := wc_adic_completion_noetherian R 𝔞
  obtain ⟨instM, htow, hfinL⟩ := wc_adic_limit_completion_module R 𝔞 N ψ hfin hkill hsurj hker
  letI := instM
  have hHCT : wcCnFfHC 𝔞 (AdicCompletion 𝔞 R) := fun M _ _ _ _ hM =>
    ⟨wc_adic_completion_mod_separated R 𝔞 hRc M hM, wc_adic_completion_mod_complete R 𝔞 M hM⟩
  have hcompl := (hHCT (wcCnLimMod N ψ) hfinL).2
  have hpr := wc_adic_limit_proj_surjective R N ψ hsurj
  have hker' := wc_adic_limit_proj_ker R 𝔞 N ψ hkill hker hpr hcompl
  obtain ⟨S, iS, aS, aTS, ι, π, htowS, hfinS, hSn, hπι⟩ :=
    s7 (AdicCompletion 𝔞 R) (wcCnLimMod N ψ)
  letI := iS
  letI := aS
  letI := aTS
  exact ⟨S, iS, aS, ι, π, hSn, hπι, hpr, hker', s6 (AdicCompletion 𝔞 R) S hHCT⟩

theorem wc_ccr_pullback_chart_pushout : ∀ (T0 X0 Y0 : Scheme.{u}) (g0 : X0 ⟶ T0) (t0 : Y0 ⟶ T0) (V0 : T0.Opens), IsAffineOpen V0 → ∀ (T : Y0.Opens), IsAffineOpen T → ∀ (hT : T ≤ t0 ⁻¹ᵁ V0) (U : X0.Opens), IsAffineOpen U → ∀ (hU : U ≤ g0 ⁻¹ᵁ V0) (UY : (Limits.pullback g0 t0).Opens) (h1 : UY ≤ Limits.pullback.fst g0 t0 ⁻¹ᵁ U) (h2 : UY ≤ Limits.pullback.snd g0 t0 ⁻¹ᵁ T), UY = Limits.pullback.fst g0 t0 ⁻¹ᵁ U ⊓ Limits.pullback.snd g0 t0 ⁻¹ᵁ T → IsAffineOpen UY ∧ IsPushout (g0.appLE V0 U hU) (t0.appLE V0 T hT) ((Limits.pullback.fst g0 t0).appLE U UY h1) ((Limits.pullback.snd g0 t0).appLE T UY h2) :=
by
  intro T0 X0 Y0 g0 t0 V0 hV0 T hTa hT U hUa hU UY h1 h2 heq
  have hPB := Scheme.Hom.isPullback_resLE (IsPullback.of_hasPullback g0 t0) hT hU heq
  haveI : IsAffine V0 := hV0
  haveI : IsAffine T := hTa
  haveI : IsAffine U := hUa
  have hUY : IsAffineOpen UY := by
    haveI : IsAffine (Limits.pullback (g0.resLE V0 U hU) (t0.resLE V0 T hT)) := inferInstance
    exact IsAffine.of_isIso hPB.isoPullback.hom
  refine ⟨hUY, ?_⟩
  haveI : IsAffine UY := hUY
  have hPO := isPushout_appTop_of_isPullback hPB
  have s1 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (U : Y.Opens) (V : X.Opens) (e : V ≤ f ⁻¹ᵁ U),
      (f.resLE U V e).appTop ≫ V.topIso.hom = U.topIso.hom ≫ f.appLE U V e := by
    intro X Y f U V e
    simp only [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE, Scheme.Opens.topIso_hom]
    erw [Scheme.Hom.resLE_appLE, Scheme.Hom.appLE_map, Scheme.Hom.map_appLE]
  exact IsPushout.of_iso hPO V0.topIso U.topIso T.topIso UY.topIso (s1 _ _ _ _) (s1 _ _ _ _)
    (s1 _ _ _ _) (s1 _ _ _ _)

theorem wc_ccr_basechange_chart_iso : (∀ (T0 X0 Y0 : Scheme.{u}) (g0 : X0 ⟶ T0) (t0 : Y0 ⟶ T0) (V0 : T0.Opens), IsAffineOpen V0 → ∀ (T : Y0.Opens), IsAffineOpen T → ∀ (hT : T ≤ t0 ⁻¹ᵁ V0) (U : X0.Opens), IsAffineOpen U → ∀ (hU : U ≤ g0 ⁻¹ᵁ V0) (UY : (Limits.pullback g0 t0).Opens) (h1 : UY ≤ Limits.pullback.fst g0 t0 ⁻¹ᵁ U) (h2 : UY ≤ Limits.pullback.snd g0 t0 ⁻¹ᵁ T), UY = Limits.pullback.fst g0 t0 ⁻¹ᵁ U ⊓ Limits.pullback.snd g0 t0 ⁻¹ᵁ T → IsAffineOpen UY ∧ IsPushout (g0.appLE V0 U hU) (t0.appLE V0 T hT) ((Limits.pullback.fst g0 t0).appLE U UY h1) ((Limits.pullback.snd g0 t0).appLE T UY h2)) → ∀ (Z P : Scheme.{u}) (p : P ⟶ Z) (V : Z.Opens) (hV : IsAffineOpen V) (S : Type u) [CommRing S] [Algebra Γ(Z, V) S] (W : P.Opens) [Algebra Γ(Z, V) Γ(P, W)], IsAffineOpen W → ∀ (hWV : W ≤ p ⁻¹ᵁ V), (∀ a : Γ(Z, V), algebraMap Γ(Z, V) Γ(P, W) a = (p.appLE V W hWV).hom a) → ∀ (UY : (Limits.pullback p (Spec.map (CommRingCat.ofHom (algebraMap Γ(Z, V) S)) ≫ hV.fromSpec)).Opens) (hUY : UY ≤ Limits.pullback.fst p (Spec.map (CommRingCat.ofHom (algebraMap Γ(Z, V) S)) ≫ hV.fromSpec) ⁻¹ᵁ W), UY = Limits.pullback.fst p (Spec.map (CommRingCat.ofHom (algebraMap Γ(Z, V) S)) ≫ hV.fromSpec) ⁻¹ᵁ W ⊓ Limits.pullback.snd p (Spec.map (CommRingCat.ofHom (algebraMap Γ(Z, V) S)) ≫ hV.fromSpec) ⁻¹ᵁ ⊤ → IsAffineOpen UY ∧ ∃ θ : TensorProduct Γ(Z, V) Γ(P, W) S ≃+* Γ(Limits.pullback p (Spec.map (CommRingCat.ofHom (algebraMap Γ(Z, V) S)) ≫ hV.fromSpec), UY), (∀ a : Γ(P, W), θ (a ⊗ₜ[Γ(Z, V)] (1 : S)) = ((Limits.pullback.fst p (Spec.map (CommRingCat.ofHom (algebraMap Γ(Z, V) S)) ≫ hV.fromSpec)).appLE W UY hUY).hom a) ∧ (∀ s : S, θ ((1 : Γ(P, W)) ⊗ₜ[Γ(Z, V)] s) = wcCnSigma (Limits.pullback.snd p (Spec.map (CommRingCat.ofHom (algebraMap Γ(Z, V) S)) ≫ hV.fromSpec)) UY s) :=
by
  intro hpo Z P p V hV S _ _ W _ hWaff hWV hA UY hUY heq
  have hT : (⊤ : (Spec (.of S)).Opens) ≤
      (Spec.map (CommRingCat.ofHom (algebraMap Γ(Z, V) S)) ≫ hV.fromSpec) ⁻¹ᵁ V := by
    rw [Scheme.Hom.comp_preimage, hV.fromSpec_preimage_self, Scheme.Hom.preimage_top]
  have h2 : UY ≤ Limits.pullback.snd p (Spec.map (CommRingCat.ofHom (algebraMap Γ(Z, V) S)) ≫
      hV.fromSpec) ⁻¹ᵁ ⊤ := by
    rw [Scheme.Hom.preimage_top]; exact le_top
  obtain ⟨hUYaff, hpush⟩ := hpo Z P (Spec (.of S)) p _ V hV ⊤ (isAffineOpen_top _) hT W hWaff hWV
    UY hUY h2 heq
  have key : (Spec.map (CommRingCat.ofHom (algebraMap Γ(Z, V) S)) ≫ hV.fromSpec).appLE V ⊤ hT =
      CommRingCat.ofHom (algebraMap Γ(Z, V) S) ≫ (Scheme.ΓSpecIso (.of S)).inv := by
    apply Spec.map_injective
    haveI := hV.isOpenImmersion_fromSpec
    rw [← cancel_mono hV.fromSpec, IsAffineOpen.SpecMap_appLE_fromSpec _ hV (isAffineOpen_top _),
      IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv, Spec.map_comp, Category.assoc]
  have hf : p.appLE V W hWV = CommRingCat.ofHom (algebraMap Γ(Z, V) Γ(P, W)) := by
    ext a; exact (hA a).symm
  have hg : (Spec.map (CommRingCat.ofHom (algebraMap Γ(Z, V) S)) ≫ hV.fromSpec).appLE V ⊤ hT ≫
      (Scheme.ΓSpecIso (.of S)).hom = CommRingCat.ofHom (algebraMap Γ(Z, V) S) := by
    rw [key, Category.assoc, Iso.inv_hom_id, Category.comp_id]
  have h' : IsPushout (CommRingCat.ofHom (algebraMap Γ(Z, V) Γ(P, W)))
      (CommRingCat.ofHom (algebraMap Γ(Z, V) S))
      ((Limits.pullback.fst p (Spec.map (CommRingCat.ofHom (algebraMap Γ(Z, V) S)) ≫
        hV.fromSpec)).appLE W UY hUY)
      ((Scheme.ΓSpecIso (.of S)).inv ≫ (Limits.pullback.snd p
        (Spec.map (CommRingCat.ofHom (algebraMap Γ(Z, V) S)) ≫ hV.fromSpec)).appLE ⊤ UY h2) := by
    refine IsPushout.of_iso hpush (Iso.refl _) (Iso.refl _) (Scheme.ΓSpecIso (.of S)) (Iso.refl _)
      ?_ ?_ ?_ ?_
    · rw [hf]; rfl
    · rw [hg]; rfl
    · rfl
    · simp
  have std := CommRingCat.isPushout_tensorProduct Γ(Z, V) Γ(P, W) S
  let e := IsPushout.isoIsPushout _ _ std h'
  refine ⟨hUYaff, e.commRingCatIsoToRingEquiv, fun a => ?_, fun s => ?_⟩
  · have := congrArg (fun φ => φ.hom a) (IsPushout.inl_isoIsPushout_hom _ _ std h')
    exact this
  · have := congrArg (fun φ => φ.hom s) (IsPushout.inr_isoIsPushout_hom _ _ std h')
    exact this

theorem wc_ccr_basechange_model : ∀ (Z P : Scheme.{u}) (p : P ⟶ Z), IsProper p → ∀ (V : Z.Opens) (hV : IsAffineOpen V) (r : ℕ) (W : Fin r → P.Opens) (hW : ∀ i, W i ≤ p ⁻¹ᵁ V) [∀ i, Algebra Γ(Z, V) Γ(P, W i)] [∀ i j, Algebra Γ(Z, V) Γ(P, W i ⊓ W j)] (ρl : ∀ i j, Γ(P, W i) →ₐ[Γ(Z, V)] Γ(P, W i ⊓ W j)) (ρr : ∀ i j, Γ(P, W j) →ₐ[Γ(Z, V)] Γ(P, W i ⊓ W j)), wcCnChartCompat p V W hW ρl ρr → ∀ (S : Type u) [CommRing S] [Algebra Γ(Z, V) S], (∀ i (UY : (Limits.pullback p (Spec.map (CommRingCat.ofHom (algebraMap Γ(Z, V) S)) ≫ hV.fromSpec)).Opens) (hUY : UY ≤ Limits.pullback.fst p (Spec.map (CommRingCat.ofHom (algebraMap Γ(Z, V) S)) ≫ hV.fromSpec) ⁻¹ᵁ W i), UY = Limits.pullback.fst p (Spec.map (CommRingCat.ofHom (algebraMap Γ(Z, V) S)) ≫ hV.fromSpec) ⁻¹ᵁ W i ⊓ Limits.pullback.snd p (Spec.map (CommRingCat.ofHom (algebraMap Γ(Z, V) S)) ≫ hV.fromSpec) ⁻¹ᵁ ⊤ → IsAffineOpen UY ∧ ∃ θ : TensorProduct Γ(Z, V) Γ(P, W i) S ≃+* Γ(Limits.pullback p (Spec.map (CommRingCat.ofHom (algebraMap Γ(Z, V) S)) ≫ hV.fromSpec), UY), (∀ a : Γ(P, W i), θ (a ⊗ₜ[Γ(Z, V)] (1 : S)) = ((Limits.pullback.fst p (Spec.map (CommRingCat.ofHom (algebraMap Γ(Z, V) S)) ≫ hV.fromSpec)).appLE (W i) UY hUY).hom a) ∧ (∀ s : S, θ ((1 : Γ(P, W i)) ⊗ₜ[Γ(Z, V)] s) = wcCnSigma (Limits.pullback.snd p (Spec.map (CommRingCat.ofHom (algebraMap Γ(Z, V) S)) ≫ hV.fromSpec)) UY s)) → (∀ i j (UY : (Limits.pullback p (Spec.map (CommRingCat.ofHom (algebraMap Γ(Z, V) S)) ≫ hV.fromSpec)).Opens) (hUY : UY ≤ Limits.pullback.fst p (Spec.map (CommRingCat.ofHom (algebraMap Γ(Z, V) S)) ≫ hV.fromSpec) ⁻¹ᵁ (W i ⊓ W j)), UY = Limits.pullback.fst p (Spec.map (CommRingCat.ofHom (algebraMap Γ(Z, V) S)) ≫ hV.fromSpec) ⁻¹ᵁ (W i ⊓ W j) ⊓ Limits.pullback.snd p (Spec.map (CommRingCat.ofHom (algebraMap Γ(Z, V) S)) ≫ hV.fromSpec) ⁻¹ᵁ ⊤ → IsAffineOpen UY ∧ ∃ θ : TensorProduct Γ(Z, V) Γ(P, W i ⊓ W j) S ≃+* Γ(Limits.pullback p (Spec.map (CommRingCat.ofHom (algebraMap Γ(Z, V) S)) ≫ hV.fromSpec), UY), (∀ a : Γ(P, W i ⊓ W j), θ (a ⊗ₜ[Γ(Z, V)] (1 : S)) = ((Limits.pullback.fst p (Spec.map (CommRingCat.ofHom (algebraMap Γ(Z, V) S)) ≫ hV.fromSpec)).appLE (W i ⊓ W j) UY hUY).hom a) ∧ (∀ s : S, θ ((1 : Γ(P, W i ⊓ W j)) ⊗ₜ[Γ(Z, V)] s) = wcCnSigma (Limits.pullback.snd p (Spec.map (CommRingCat.ofHom (algebraMap Γ(Z, V) S)) ≫ hV.fromSpec)) UY s)) → ∃ (X : Scheme.{u}) (g : X ⟶ Spec (.of S)) (U : Fin r → X.Opens) (θ1 : ∀ i, TensorProduct Γ(Z, V) Γ(P, W i) S ≃+* Γ(X, U i)) (θ2 : ∀ i j, TensorProduct Γ(Z, V) Γ(P, W i ⊓ W j) S ≃+* Γ(X, U i ⊓ U j)), IsProper g ∧ (∀ i, IsAffineOpen (U i)) ∧ (∀ x : X, ∃ i, x ∈ U i) ∧ (∀ i j, IsAffineOpen (U i ⊓ U j)) ∧ (∀ i j (x : TensorProduct Γ(Z, V) Γ(P, W i) S), θ2 i j (LinearMap.rTensor S (ρl i j).toLinearMap x) = X.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op (θ1 i x)) ∧ (∀ i j (x : TensorProduct Γ(Z, V) Γ(P, W j) S), θ2 i j (LinearMap.rTensor S (ρr i j).toLinearMap x) = X.presheaf.map (homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).op (θ1 j x)) ∧ (∀ i (s : S), θ1 i ((1 : Γ(P, W i)) ⊗ₜ[Γ(Z, V)] s) = wcCnSigma g (U i) s) ∧ (∀ i j (s : S), θ2 i j ((1 : Γ(P, W i ⊓ W j)) ⊗ₜ[Γ(Z, V)] s) = wcCnSigma g (U i ⊓ U j) s) :=
by
  intro Z P p hp V hV r W hW _ _ ρl ρr hc S _ _ H1 H2
  haveI := hp
  obtain ⟨-, hcov, -, -, -, hρl, hρr⟩ := hc

  have htV : ∀ y : ↥(Spec (CommRingCat.of S)),
      (Spec.map (CommRingCat.ofHom (algebraMap Γ(Z, V) S)) ≫ hV.fromSpec) y ∈ V := by
    intro y
    rw [Scheme.Hom.comp_apply]
    have hy := Set.mem_range_self (f := ⇑hV.fromSpec)
      (Spec.map (CommRingCat.ofHom (algebraMap Γ(Z, V) S)) y)
    rw [hV.range_fromSpec] at hy
    exact hy
  revert H1 H2 htV
  generalize Spec.map (CommRingCat.ofHom (algebraMap Γ(Z, V) S)) ≫ hV.fromSpec = t
  intro H1 H2 htV

  have ext : ∀ (A A2 B1 B2 : Type u) [CommRing A] [CommRing A2] [CommRing B1] [CommRing B2]
      [Algebra Γ(Z, V) A] [Algebra Γ(Z, V) A2] (ρ : A →ₐ[Γ(Z, V)] A2)
      (θa : TensorProduct Γ(Z, V) A S ≃+* B1) (θb : TensorProduct Γ(Z, V) A2 S ≃+* B2)
      (res : B1 →+* B2),
      (∀ a : A, θb (ρ a ⊗ₜ[Γ(Z, V)] (1 : S)) = res (θa (a ⊗ₜ[Γ(Z, V)] (1 : S)))) →
      (∀ s : S, θb ((1 : A2) ⊗ₜ[Γ(Z, V)] s) = res (θa ((1 : A) ⊗ₜ[Γ(Z, V)] s))) →
      ∀ x : TensorProduct Γ(Z, V) A S,
        θb (LinearMap.rTensor S ρ.toLinearMap x) = res (θa x) := by
    intro A A2 B1 B2 _ _ _ _ _ _ ρ θa θb res ha hs x
    induction x using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul a s =>
      have e1 : a ⊗ₜ[Γ(Z, V)] s = (a ⊗ₜ[Γ(Z, V)] (1 : S)) * ((1 : A) ⊗ₜ[Γ(Z, V)] s) := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      have e2 : ρ a ⊗ₜ[Γ(Z, V)] s =
          (ρ a ⊗ₜ[Γ(Z, V)] (1 : S)) * ((1 : A2) ⊗ₜ[Γ(Z, V)] s) := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [LinearMap.rTensor_tmul, AlgHom.toLinearMap_apply, e2, e1]
      simp only [map_mul]
      rw [ha, hs]
    | add x y hx hy => rw [map_add, map_add, map_add, map_add, hx, hy]

  have nat : ∀ (W1 W2 : P.Opens) (U1 U2 : (Limits.pullback p t).Opens) (hW' : W2 ≤ W1)
      (hU' : U2 ≤ U1) (h1 : U1 ≤ Limits.pullback.fst p t ⁻¹ᵁ W1)
      (h2 : U2 ≤ Limits.pullback.fst p t ⁻¹ᵁ W2) (a : Γ(P, W1)),
      ((Limits.pullback.fst p t).appLE W2 U2 h2).hom ((P.presheaf.map (homOfLE hW').op).hom a) =
        ((Limits.pullback p t).presheaf.map (homOfLE hU').op).hom
          (((Limits.pullback.fst p t).appLE W1 U1 h1).hom a) := by
    intro W1 W2 U1 U2 hW' hU' h1 h2 a
    have e1 := congrArg (fun φ => φ.hom a)
      (Scheme.Hom.map_appLE (Limits.pullback.fst p t) h2 (homOfLE hW').op)
    have e2 := congrArg (fun φ => φ.hom a)
      (Scheme.Hom.appLE_map (Limits.pullback.fst p t) h1 (homOfLE hU').op)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e1 e2
    rw [e1, e2]

  have sig : ∀ (U1 U2 : (Limits.pullback p t).Opens) (h : U2 ≤ U1) (s : S),
      ((Limits.pullback p t).presheaf.map (homOfLE h).op).hom
        (wcCnSigma (Limits.pullback.snd p t) U1 s) = wcCnSigma (Limits.pullback.snd p t) U2 s := by
    intro U1 U2 h s
    have key : ∀ y : Γ(Limits.pullback p t, ⊤),
        ((Limits.pullback p t).presheaf.map (homOfLE h).op).hom
          (((Limits.pullback p t).presheaf.map (homOfLE (le_top : U1 ≤ ⊤)).op).hom y) =
        ((Limits.pullback p t).presheaf.map (homOfLE (le_top : U2 ≤ ⊤)).op).hom y := by
      intro y
      rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, ← Functor.map_comp]
      rfl
    unfold wcCnSigma
    simp only [RingHom.comp_apply]
    exact key _

  have hE : ∀ i j, (Limits.pullback.fst p t ⁻¹ᵁ W i ⊓ Limits.pullback.snd p t ⁻¹ᵁ ⊤) ⊓
      (Limits.pullback.fst p t ⁻¹ᵁ W j ⊓ Limits.pullback.snd p t ⁻¹ᵁ ⊤) =
      Limits.pullback.fst p t ⁻¹ᵁ (W i ⊓ W j) ⊓ Limits.pullback.snd p t ⁻¹ᵁ ⊤ := by
    intro i j
    simp only [Scheme.Hom.preimage_top, inf_top_eq, Scheme.Hom.preimage_inf]
  have I1 : ∀ i, Limits.pullback.fst p t ⁻¹ᵁ W i ⊓ Limits.pullback.snd p t ⁻¹ᵁ ⊤ ≤
      Limits.pullback.fst p t ⁻¹ᵁ W i := fun i => inf_le_left
  have I2 : ∀ i j, (Limits.pullback.fst p t ⁻¹ᵁ W i ⊓ Limits.pullback.snd p t ⁻¹ᵁ ⊤) ⊓
      (Limits.pullback.fst p t ⁻¹ᵁ W j ⊓ Limits.pullback.snd p t ⁻¹ᵁ ⊤) ≤
      Limits.pullback.fst p t ⁻¹ᵁ (W i ⊓ W j) := fun i j => (hE i j).le.trans inf_le_left
  choose hA1 θ1 hθ1 using fun i => H1 i _ (I1 i) rfl
  choose hA2 θ2 hθ2 using fun i j => H2 i j _ (I2 i j) (hE i j)
  refine ⟨Limits.pullback p t, Limits.pullback.snd p t,
    fun i => Limits.pullback.fst p t ⁻¹ᵁ W i ⊓ Limits.pullback.snd p t ⁻¹ᵁ ⊤, θ1, θ2,
    inferInstance, hA1, ?_, hA2, ?_, ?_, fun i => (hθ1 i).2, fun i j => (hθ2 i j).2⟩
  ·
    intro x
    have h1 := congrArg (fun f : Limits.pullback p t ⟶ Z => f x)
      (Limits.pullback.condition (f := p) (g := t))
    simp only [Scheme.Hom.comp_apply] at h1
    have h2 : Limits.pullback.fst p t x ∈ p ⁻¹ᵁ V := by
      rw [Scheme.Hom.mem_preimage, h1]
      exact htV _
    obtain ⟨i, hi⟩ := hcov _ h2
    refine ⟨i, ?_⟩
    show x ∈ Limits.pullback.fst p t ⁻¹ᵁ W i ⊓ Limits.pullback.snd p t ⁻¹ᵁ ⊤
    rw [TopologicalSpace.Opens.mem_inf, Scheme.Hom.mem_preimage, Scheme.Hom.mem_preimage]
    exact ⟨hi, TopologicalSpace.Opens.mem_top _⟩
  ·
    intro i j x
    exact ext _ _ _ _ (ρl i j) (θ1 i) (θ2 i j)
      ((Limits.pullback p t).presheaf.map (homOfLE (inf_le_left :
        (Limits.pullback.fst p t ⁻¹ᵁ W i ⊓ Limits.pullback.snd p t ⁻¹ᵁ ⊤) ⊓
        (Limits.pullback.fst p t ⁻¹ᵁ W j ⊓ Limits.pullback.snd p t ⁻¹ᵁ ⊤) ≤
        Limits.pullback.fst p t ⁻¹ᵁ W i ⊓ Limits.pullback.snd p t ⁻¹ᵁ ⊤)).op).hom
      (fun a => by
        rw [(hθ2 i j).1, hρl, (hθ1 i).1]
        exact nat _ _ _ _ inf_le_left inf_le_left _ _ a)
      (fun s => by
        rw [(hθ2 i j).2, (hθ1 i).2]
        exact (sig _ _ _ s).symm) x
  ·
    intro i j x
    exact ext _ _ _ _ (ρr i j) (θ1 j) (θ2 i j)
      ((Limits.pullback p t).presheaf.map (homOfLE (inf_le_right :
        (Limits.pullback.fst p t ⁻¹ᵁ W i ⊓ Limits.pullback.snd p t ⁻¹ᵁ ⊤) ⊓
        (Limits.pullback.fst p t ⁻¹ᵁ W j ⊓ Limits.pullback.snd p t ⁻¹ᵁ ⊤) ≤
        Limits.pullback.fst p t ⁻¹ᵁ W j ⊓ Limits.pullback.snd p t ⁻¹ᵁ ⊤)).op).hom
      (fun a => by
        rw [(hθ2 i j).1, hρr, (hθ1 j).1]
        exact nat _ _ _ _ inf_le_right inf_le_right _ _ a)
      (fun s => by
        rw [(hθ2 i j).2, (hθ1 j).2]
        exact (sig _ _ _ s).symm) x

theorem wc_ccr_tensor_ideal_transport : ∀ (R : Type u) [CommRing R] (𝔞 : Ideal R) (A : Type u) [CommRing A] [Algebra R A] (S : Type u) [CommRing S] [Algebra R S] (C : Type u) [CommRing C] (σ : S →+* C) (θ : TensorProduct R A S ≃+* C), (∀ s : S, θ ((1 : A) ⊗ₜ[R] s) = σ s) → (∀ (m : ℕ) (x : TensorProduct R A S), x ∈ 𝔞 ^ m • (⊤ : Submodule R (TensorProduct R A S)) ↔ θ x ∈ Ideal.map σ (Ideal.map (algebraMap R S) 𝔞 ^ m)) ∧ (∀ (s : S) (x : TensorProduct R A S), θ (LinearMap.lTensor A (LinearMap.mulLeft R s) x) = σ s * θ x) :=
by
  intro R _ 𝔞 A _ _ S _ _ C _ σ θ hσ
  have hcomp : σ = (θ : TensorProduct R A S →+* C).comp
      ((Algebra.TensorProduct.includeRight : S →ₐ[R] TensorProduct R A S) :
        S →+* TensorProduct R A S) := by
    ext s
    rw [← hσ s]
    rfl
  have hmul : ∀ (s : S) (x : TensorProduct R A S),
      LinearMap.lTensor A (LinearMap.mulLeft R s) x = ((1 : A) ⊗ₜ[R] s) * x := by
    intro s x
    induction x using TensorProduct.induction_on with
    | zero => rw [map_zero, mul_zero]
    | tmul a t =>
      rw [LinearMap.lTensor_tmul, LinearMap.mulLeft_apply, Algebra.TensorProduct.tmul_mul_tmul,
        one_mul]
    | add y z hy hz => rw [map_add, hy, hz, mul_add]
  refine ⟨fun m x => ?_, fun s x => ?_⟩
  · have h3 : Ideal.map (algebraMap R (TensorProduct R A S)) (𝔞 ^ m) =
        Ideal.map ((Algebra.TensorProduct.includeRight : S →ₐ[R] TensorProduct R A S) :
          S →+* TensorProduct R A S) (Ideal.map (algebraMap R S) 𝔞 ^ m) := by
      rw [← Ideal.map_pow, Ideal.map_map, AlgHom.comp_algebraMap]
    have h4 : Ideal.map σ (Ideal.map (algebraMap R S) 𝔞 ^ m) =
        Ideal.map (θ : TensorProduct R A S →+* C)
          (Ideal.map ((Algebra.TensorProduct.includeRight : S →ₐ[R] TensorProduct R A S) :
            S →+* TensorProduct R A S) (Ideal.map (algebraMap R S) 𝔞 ^ m)) := by
      rw [hcomp, Ideal.map_map]
    rw [Ideal.smul_top_eq_map, Submodule.restrictScalars_mem, h3, h4]
    constructor
    · intro hx
      exact Ideal.mem_map_of_mem _ hx
    · intro hx
      have hc : x ∈ Ideal.comap (θ : TensorProduct R A S →+* C)
          (Ideal.map (θ : TensorProduct R A S →+* C)
            (Ideal.map ((Algebra.TensorProduct.includeRight : S →ₐ[R] TensorProduct R A S) :
              S →+* TensorProduct R A S) (Ideal.map (algebraMap R S) 𝔞 ^ m))) :=
        Ideal.mem_comap.mpr hx
      rwa [Ideal.comap_map_of_bijective _ (by exact θ.bijective)] at hc
  · rw [hmul, map_mul, hσ]

theorem wc_ccr_cech_glue : ∀ (R : Type u) [CommRing R] (r : ℕ) (A : Fin r → Type u) [∀ i, CommRing (A i)] [∀ i, Algebra R (A i)] (A2 : Fin r → Fin r → Type u) [∀ i j, CommRing (A2 i j)] [∀ i j, Algebra R (A2 i j)] (ρl : ∀ i j, A i →ₐ[R] A2 i j) (ρr : ∀ i j, A j →ₐ[R] A2 i j) (S : Type u) [CommRing S] [Algebra R S] (X : Scheme.{u}) (U : Fin r → X.Opens) (θ1 : ∀ i, TensorProduct R (A i) S ≃+* Γ(X, U i)) (θ2 : ∀ i j, TensorProduct R (A2 i j) S ≃+* Γ(X, U i ⊓ U j)), (∀ x : X, ∃ i, x ∈ U i) → (∀ i j (x : TensorProduct R (A i) S), θ2 i j (LinearMap.rTensor S (ρl i j).toLinearMap x) = X.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op (θ1 i x)) → (∀ i j (x : TensorProduct R (A j) S), θ2 i j (LinearMap.rTensor S (ρr i j).toLinearMap x) = X.presheaf.map (homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).op (θ1 j x)) → (∀ τ ∈ wcCnCechT A A2 ρl ρr S, ∃ s : Γ(X, ⊤), ∀ i, X.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op s = θ1 i (τ i)) ∧ (∀ s : Γ(X, ⊤), (fun i => (θ1 i).symm (X.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op s)) ∈ wcCnCechT A A2 ρl ρr S) :=
by
  intro R _ r A _ _ A2 _ _ ρl ρr S _ _ X U θ1 θ2 hcov hl hr
  have res : ∀ {V W W' : X.Opens} (h1 : V ≤ W) (h2 : W ≤ W') (t : Γ(X, W')),
      X.presheaf.map (homOfLE h1).op (X.presheaf.map (homOfLE h2).op t) =
      X.presheaf.map (homOfLE (h1.trans h2)).op t := by
    intro V W W' h1 h2 t
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  refine ⟨fun τ hτ => ?_, fun s => ?_⟩
  · have hcomp : TopCat.Presheaf.IsCompatible X.sheaf.obj U (fun i => θ1 i (τ i)) := by
      intro i j
      have e : LinearMap.rTensor S (ρl i j).toLinearMap (τ i) =
          LinearMap.rTensor S (ρr i j).toLinearMap (τ j) := hτ i j
      have h1 := hl i j (τ i)
      have h2 := hr i j (τ j)
      rw [e] at h1
      exact h1.symm.trans h2
    obtain ⟨s, hs, -⟩ := TopCat.Sheaf.existsUnique_gluing' X.sheaf U ⊤
      (fun i => homOfLE le_top)
      (by
        intro x _
        rw [TopologicalSpace.Opens.mem_iSup]
        exact hcov x) _ hcomp
    exact ⟨s, hs⟩
  · intro i j
    apply (θ2 i j).injective
    rw [hl, hr, RingEquiv.apply_symm_apply, RingEquiv.apply_symm_apply, res, res]

theorem wc_ccr_ar1_transport : ∀ (R : Type u) [CommRing R] (𝔞 : Ideal R) (r : ℕ) (A : Fin r → Type u) [∀ i, CommRing (A i)] [∀ i, Algebra R (A i)] (A2 : Fin r → Fin r → Type u) [∀ i j, CommRing (A2 i j)] [∀ i j, Algebra R (A2 i j)] (ρl : ∀ i j, A i →ₐ[R] A2 i j) (ρr : ∀ i j, A j →ₐ[R] A2 i j) (S : Type u) [CommRing S] [Algebra R S] (X : Scheme.{u}) (g : X ⟶ Spec (.of S)) (U : Fin r → X.Opens) (θ1 : ∀ i, TensorProduct R (A i) S ≃+* Γ(X, U i)) (θ2 : ∀ i j, TensorProduct R (A2 i j) S ≃+* Γ(X, U i ⊓ U j)), (∀ i j (x : TensorProduct R (A i) S), θ2 i j (LinearMap.rTensor S (ρl i j).toLinearMap x) = X.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op (θ1 i x)) → (∀ i j (x : TensorProduct R (A j) S), θ2 i j (LinearMap.rTensor S (ρr i j).toLinearMap x) = X.presheaf.map (homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).op (θ1 j x)) → (∀ i (m : ℕ) (x : TensorProduct R (A i) S), x ∈ 𝔞 ^ m • (⊤ : Submodule R (TensorProduct R (A i) S)) ↔ θ1 i x ∈ Ideal.map (wcCnSigma g (U i)) (Ideal.map (algebraMap R S) 𝔞 ^ m)) → (∀ i j (m : ℕ) (x : TensorProduct R (A2 i j) S), x ∈ 𝔞 ^ m • (⊤ : Submodule R (TensorProduct R (A2 i j) S)) ↔ θ2 i j x ∈ Ideal.map (wcCnSigma g (U i ⊓ U j)) (Ideal.map (algebraMap R S) 𝔞 ^ m)) → (∃ (q : ℕ) (deg : Fin q → ℕ) (y : Fin q → ∀ i : Fin r, Γ(X, U i)), ∀ (n : ℕ) (x : ∀ i : Fin r, Γ(X, U i)), (fun p : Fin r × Fin r => X.presheaf.map (homOfLE (inf_le_right : U p.1 ⊓ U p.2 ≤ U p.2)).op (x p.2) - X.presheaf.map (homOfLE (inf_le_left : U p.1 ⊓ U p.2 ≤ U p.1)).op (x p.1)) ∈ Ideal.map (RingHom.pi (fun p : Fin r × Fin r => (X.presheaf.map (homOfLE (le_top : U p.1 ⊓ U p.2 ≤ ⊤)).op).hom.comp (g.appTop.hom.comp (Scheme.ΓSpecIso (.of S)).inv.hom))) (Ideal.map (algebraMap R S) 𝔞 ^ n) → ∃ (a : Fin q → S) (w : ∀ i : Fin r, Γ(X, U i)), (∀ l, a l ∈ Ideal.map (algebraMap R S) 𝔞 ^ (n - deg l)) ∧ (∀ l, n < deg l → a l = 0) ∧ w ∈ Ideal.map (RingHom.pi (fun i : Fin r => (X.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op).hom.comp (g.appTop.hom.comp (Scheme.ΓSpecIso (.of S)).inv.hom))) (Ideal.map (algebraMap R S) 𝔞 ^ n) ∧ (fun p : Fin r × Fin r => X.presheaf.map (homOfLE (inf_le_right : U p.1 ⊓ U p.2 ≤ U p.2)).op (x p.2) - X.presheaf.map (homOfLE (inf_le_left : U p.1 ⊓ U p.2 ≤ U p.1)).op (x p.1)) = ∑ l, RingHom.pi (fun p : Fin r × Fin r => (X.presheaf.map (homOfLE (le_top : U p.1 ⊓ U p.2 ≤ ⊤)).op).hom.comp (g.appTop.hom.comp (Scheme.ΓSpecIso (.of S)).inv.hom)) (a l) * (fun p : Fin r × Fin r => X.presheaf.map (homOfLE (inf_le_right : U p.1 ⊓ U p.2 ≤ U p.2)).op (y l p.2) - X.presheaf.map (homOfLE (inf_le_left : U p.1 ⊓ U p.2 ≤ U p.1)).op (y l p.1)) + (fun p : Fin r × Fin r => X.presheaf.map (homOfLE (inf_le_right : U p.1 ⊓ U p.2 ≤ U p.2)).op (w p.2) - X.presheaf.map (homOfLE (inf_le_left : U p.1 ⊓ U p.2 ≤ U p.1)).op (w p.1))) → ∃ c : ℕ, wcCnFfAR1 𝔞 A A2 ρl ρr S c :=
by
  intro R _ 𝔞 r A _ _ A2 _ _ ρl ρr S _ _ X g U θ1 θ2 HL HR I1 I2 hAR
  obtain ⟨q, deg, y, hAR⟩ := hAR

  have piIff : ∀ (ι : Type) [Fintype ι] [DecidableEq ι] (T : ι → Type u) [∀ k, CommRing (T k)]
      (σ : ∀ k, S →+* T k) (K : Ideal S) (z : ∀ k, T k),
      z ∈ Ideal.map (RingHom.pi σ) K ↔ ∀ k, z k ∈ Ideal.map (σ k) K := by
    intro ι _ _ T _ σ K z
    constructor
    · intro hz k
      have h1 := Ideal.mem_map_of_mem (Pi.evalRingHom T k) hz
      rw [Ideal.map_map] at h1
      have e : (Pi.evalRingHom T k).comp (RingHom.pi σ) = σ k := RingHom.ext fun _ => rfl
      rw [e] at h1
      exact h1
    · intro hz
      rw [← Finset.univ_sum_single z]
      refine Ideal.sum_mem _ (fun k _ => ?_)
      have key : ∀ t ∈ Ideal.map (σ k) K, Pi.single k t ∈ Ideal.map (RingHom.pi σ) K := by
        intro t ht
        induction ht using Submodule.span_induction with
        | mem x hx =>
          obtain ⟨b, hb, rfl⟩ := hx
          have hsplit : (Pi.single k (σ k b) : ∀ k, T k) = Pi.single k 1 * RingHom.pi σ b := by
            funext k'
            by_cases hk : k' = k
            · subst hk
              simp
            · simp [hk]
          rw [hsplit]
          exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ hb)
        | zero => rw [Pi.single_zero]; exact zero_mem _
        | add x y' _ _ hx hy => rw [Pi.single_add]; exact add_mem hx hy
        | smul a x _ hx => rw [smul_eq_mul, Pi.single_mul]; exact Ideal.mul_mem_left _ _ hx
      exact key _ (hz k)

  have sres : ∀ (V V' : X.Opens) (h : V' ≤ V) (s : S),
      X.presheaf.map (homOfLE h).op (wcCnSigma g V s) = wcCnSigma g V' s := by
    intro V V' h s
    unfold wcCnSigma
    show (X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op ≫ X.presheaf.map (homOfLE h).op).hom
        ((g.appTop.hom.comp (Scheme.ΓSpecIso (.of S)).inv.hom) s) =
      (X.presheaf.map (homOfLE (le_top : V' ≤ ⊤)).op).hom
        ((g.appTop.hom.comp (Scheme.ΓSpecIso (.of S)).inv.hom) s)
    rw [← Functor.map_comp]
    rfl
  have hdeg : ∀ l, deg l ≤ ∑ l, deg l := fun l =>
    Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ l)
  refine ⟨∑ l, deg l, ?_⟩
  unfold wcCnFfAR1
  intro n ω hω

  have hdx : (fun p : Fin r × Fin r => X.presheaf.map (homOfLE (inf_le_right : U p.1 ⊓ U p.2 ≤ U p.2)).op (θ1 p.2 (ω p.2)) - X.presheaf.map (homOfLE (inf_le_left : U p.1 ⊓ U p.2 ≤ U p.1)).op (θ1 p.1 (ω p.1))) ∈ Ideal.map (RingHom.pi (fun p : Fin r × Fin r => (X.presheaf.map (homOfLE (le_top : U p.1 ⊓ U p.2 ≤ ⊤)).op).hom.comp (g.appTop.hom.comp (Scheme.ΓSpecIso (.of S)).inv.hom))) (Ideal.map (algebraMap R S) 𝔞 ^ (n + ∑ l, deg l)) := by
    refine (piIff (Fin r × Fin r) (fun p => Γ(X, U p.1 ⊓ U p.2)) _ _ _).mpr ?_
    rintro ⟨i, j⟩
    have h1 := (I2 i j (n + ∑ l, deg l) _).mp (Submodule.neg_mem _ (hω i j))
    rw [map_neg, map_sub, HL, HR, neg_sub] at h1
    exact h1

  obtain ⟨a, w, ha, -, hw, heq⟩ := hAR (n + ∑ l, deg l) (fun i => θ1 i (ω i)) hdx
  have ha' : ∀ l, a l ∈ Ideal.map (algebraMap R S) 𝔞 ^ n := fun l =>
    Ideal.pow_le_pow_right (by have := hdeg l; omega) (ha l)
  have hw' : ∀ i, w i ∈ Ideal.map (wcCnSigma g (U i)) (Ideal.map (algebraMap R S) 𝔞 ^ n) := by
    intro i
    have h1 := (piIff (Fin r) (fun i => Γ(X, U i)) _ _ w).mp hw i
    exact Ideal.map_mono (Ideal.pow_le_pow_right (Nat.le_add_right n _)) h1

  obtain ⟨v, hv⟩ : ∃ v : ∀ i, Γ(X, U i), ∀ i, v i = ∑ l, wcCnSigma g (U i) (a l) * y l i + w i :=
    ⟨_, fun i => rfl⟩
  refine ⟨fun i => (θ1 i).symm (v i), fun i => ?_, ?_⟩
  · show (θ1 i).symm (v i) ∈ 𝔞 ^ n • (⊤ : Submodule R (TensorProduct R (A i) S))
    rw [I1, RingEquiv.apply_symm_apply, hv i]
    exact Ideal.add_mem _ (Ideal.sum_mem _ fun l _ =>
      Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (ha' l))) (hw' i)

  · intro i j
    apply (θ2 i j).injective
    simp only [Pi.sub_apply, map_sub, HL, HR, RingEquiv.apply_symm_apply]
    have E1 : X.presheaf.map (homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).op (θ1 j (ω j)) -
        X.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op (θ1 i (ω i)) =
        ∑ l, wcCnSigma g (U i ⊓ U j) (a l) *
          (X.presheaf.map (homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).op (y l j) -
            X.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op (y l i)) +
        (X.presheaf.map (homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).op (w j) -
          X.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op (w i)) := by
      have h := congrFun heq (i, j)
      rw [Pi.add_apply, Finset.sum_apply] at h
      exact h
    simp only [mul_sub, Finset.sum_sub_distrib] at E1
    have Er : X.presheaf.map (homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).op (v j) =
        ∑ l, wcCnSigma g (U i ⊓ U j) (a l) *
          X.presheaf.map (homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).op (y l j) +
        X.presheaf.map (homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).op (w j) := by
      rw [hv j, map_add, map_sum]
      simp only [map_mul, sres]
    have El : X.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op (v i) =
        ∑ l, wcCnSigma g (U i ⊓ U j) (a l) *
          X.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op (y l i) +
        X.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op (w i) := by
      rw [hv i, map_add, map_sum]
      simp only [map_mul, sres]
    linear_combination -E1 + Er - El

theorem wc_ccr_ar0_transport : ∀ (R : Type u) [CommRing R] (𝔞 : Ideal R) (r : ℕ) (A : Fin r → Type u) [∀ i, CommRing (A i)] [∀ i, Algebra R (A i)] (A2 : Fin r → Fin r → Type u) [∀ i j, CommRing (A2 i j)] [∀ i j, Algebra R (A2 i j)] (ρl : ∀ i j, A i →ₐ[R] A2 i j) (ρr : ∀ i j, A j →ₐ[R] A2 i j) (S : Type u) [CommRing S] [Algebra R S] (X : Scheme.{u}) (g : X ⟶ Spec (.of S)) (U : Fin r → X.Opens) (θ1 : ∀ i, TensorProduct R (A i) S ≃+* Γ(X, U i)), (∀ i (m : ℕ) (x : TensorProduct R (A i) S), x ∈ 𝔞 ^ m • (⊤ : Submodule R (TensorProduct R (A i) S)) ↔ θ1 i x ∈ Ideal.map (wcCnSigma g (U i)) (Ideal.map (algebraMap R S) 𝔞 ^ m)) → (∀ i (s : S) (x : TensorProduct R (A i) S), θ1 i (LinearMap.lTensor (A i) (LinearMap.mulLeft R s) x) = wcCnSigma g (U i) s * θ1 i x) → (∀ τ ∈ wcCnCechT A A2 ρl ρr S, ∃ s : Γ(X, ⊤), ∀ i, X.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op s = θ1 i (τ i)) → (∀ s : Γ(X, ⊤), (fun i => (θ1 i).symm (X.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op s)) ∈ wcCnCechT A A2 ρl ρr S) → (∃ c : ℕ, ∀ (n : ℕ) (s : Γ(wcStructMod X, ⊤)), (∀ i, ((wcStructMod X).presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op).hom s ∈ Ideal.map (wcCnSigma g (U i)) (Ideal.map (algebraMap R S) 𝔞 ^ (n + c)) • (⊤ : Submodule Γ(X, U i) Γ(wcStructMod X, U i))) → ∃ (k : ℕ) (a : Fin k → S) (x : Fin k → Γ(wcStructMod X, ⊤)), (∀ l, a l ∈ Ideal.map (algebraMap R S) 𝔞 ^ n) ∧ s = ∑ l, wcCnSigma g ⊤ (a l) • x l) → ∃ c : ℕ, wcCnFfAR0 𝔞 A A2 ρl ρr S c :=
by
  intro R _ 𝔞 r A _ _ A2 _ _ ρl ρr S _ _ X g U θ1 Hiff Hmul Gl1 Gl2 H0
  classical

  have hstab : ∀ (s : S) (Y : ∀ i, TensorProduct R (A i) S), Y ∈ wcCnCechT A A2 ρl ρr S →
      (fun i => LinearMap.lTensor (A i) (LinearMap.mulLeft R s) (Y i) :
        ∀ i, TensorProduct R (A i) S) ∈ wcCnCechT A A2 ρl ρr S := by
    intro s Y hY
    show ∀ i j, LinearMap.rTensor S (ρl i j).toLinearMap
        (LinearMap.lTensor (A i) (LinearMap.mulLeft R s) (Y i)) =
      LinearMap.rTensor S (ρr i j).toLinearMap
        (LinearMap.lTensor (A j) (LinearMap.mulLeft R s) (Y j))
    intro i j
    have hij : LinearMap.rTensor S (ρl i j).toLinearMap (Y i) =
        LinearMap.rTensor S (ρr i j).toLinearMap (Y j) := hY i j
    have e1 : LinearMap.rTensor S (ρl i j).toLinearMap
        (LinearMap.lTensor (A i) (LinearMap.mulLeft R s) (Y i)) =
        LinearMap.lTensor (A2 i j) (LinearMap.mulLeft R s)
          (LinearMap.rTensor S (ρl i j).toLinearMap (Y i)) :=
      LinearMap.congr_fun ((LinearMap.rTensor_comp_lTensor (A i) (ρl i j).toLinearMap
        (LinearMap.mulLeft R s)).trans (LinearMap.lTensor_comp_rTensor (A i)
          (ρl i j).toLinearMap (LinearMap.mulLeft R s)).symm) (Y i)
    have e2 : LinearMap.rTensor S (ρr i j).toLinearMap
        (LinearMap.lTensor (A j) (LinearMap.mulLeft R s) (Y j)) =
        LinearMap.lTensor (A2 i j) (LinearMap.mulLeft R s)
          (LinearMap.rTensor S (ρr i j).toLinearMap (Y j)) :=
      LinearMap.congr_fun ((LinearMap.rTensor_comp_lTensor (A j) (ρr i j).toLinearMap
        (LinearMap.mulLeft R s)).trans (LinearMap.lTensor_comp_rTensor (A j)
          (ρr i j).toLinearMap (LinearMap.mulLeft R s)).symm) (Y j)
    rw [e1, e2, hij]

  have hkey : ∀ (n : ℕ) (a : S), a ∈ Ideal.map (algebraMap R S) 𝔞 ^ n →
      ∀ Y ∈ wcCnCechT A A2 ρl ρr S,
      (fun i => LinearMap.lTensor (A i) (LinearMap.mulLeft R a) (Y i) :
        ∀ i, TensorProduct R (A i) S) ∈ 𝔞 ^ n • wcCnCechT A A2 ρl ρr S := by
    intro n a ha
    let I' : Ideal S :=
      { carrier := {b | ∀ Y ∈ wcCnCechT A A2 ρl ρr S,
          (fun i => LinearMap.lTensor (A i) (LinearMap.mulLeft R b) (Y i) :
            ∀ i, TensorProduct R (A i) S) ∈ 𝔞 ^ n • wcCnCechT A A2 ρl ρr S}
        add_mem' := by
          intro b b' hb hb' Y hY
          have hm : LinearMap.mulLeft R (b + b') = LinearMap.mulLeft R b + LinearMap.mulLeft R b' :=
            LinearMap.ext fun z => add_mul b b' z
          have e : (fun i => LinearMap.lTensor (A i) (LinearMap.mulLeft R (b + b')) (Y i) :
              ∀ i, TensorProduct R (A i) S) =
              (fun i => LinearMap.lTensor (A i) (LinearMap.mulLeft R b) (Y i) :
                ∀ i, TensorProduct R (A i) S) +
              (fun i => LinearMap.lTensor (A i) (LinearMap.mulLeft R b') (Y i) :
                ∀ i, TensorProduct R (A i) S) := by
            funext i
            rw [hm, LinearMap.lTensor_add, LinearMap.add_apply]
            rfl
          rw [e]
          exact Submodule.add_mem _ (hb Y hY) (hb' Y hY)
        zero_mem' := by
          intro Y hY
          have e : (fun i => LinearMap.lTensor (A i) (LinearMap.mulLeft R (0 : S)) (Y i) :
              ∀ i, TensorProduct R (A i) S) = 0 := by
            funext i
            rw [LinearMap.mulLeft_zero_eq_zero, LinearMap.lTensor_zero]
            rfl
          rw [e]
          exact Submodule.zero_mem _
        smul_mem' := by
          intro c b hb Y hY
          have e : (fun i => LinearMap.lTensor (A i) (LinearMap.mulLeft R (c • b)) (Y i) :
              ∀ i, TensorProduct R (A i) S) =
              (fun i => LinearMap.lTensor (A i) (LinearMap.mulLeft R b)
                (LinearMap.lTensor (A i) (LinearMap.mulLeft R c) (Y i)) :
                ∀ i, TensorProduct R (A i) S) := by
            funext i
            rw [smul_eq_mul, mul_comm, LinearMap.mulLeft_mul, LinearMap.lTensor_comp_apply]
          rw [e]
          exact hb _ (hstab c Y hY) }
    have hI' : ∀ b, b ∈ I' ↔ ∀ Y ∈ wcCnCechT A A2 ρl ρr S,
        (fun i => LinearMap.lTensor (A i) (LinearMap.mulLeft R b) (Y i) :
          ∀ i, TensorProduct R (A i) S) ∈ 𝔞 ^ n • wcCnCechT A A2 ρl ρr S := fun b => Iff.rfl
    have hle : Ideal.map (algebraMap R S) 𝔞 ^ n ≤ I' := by
      rw [← Ideal.map_pow, Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap, hI']
      intro Y hY
      have hm : LinearMap.mulLeft R (algebraMap R S x) = x • (LinearMap.id : S →ₗ[R] S) :=
        LinearMap.ext fun y => (Algebra.smul_def x y).symm
      have e : (fun i => LinearMap.lTensor (A i) (LinearMap.mulLeft R (algebraMap R S x)) (Y i) :
          ∀ i, TensorProduct R (A i) S) = x • Y := by
        funext i
        rw [hm, LinearMap.lTensor_smul, LinearMap.lTensor_id]
        rfl
      rw [e]
      exact Submodule.smul_mem_smul hx hY
    exact (hI' a).mp (hle ha)

  have hres : ∀ i (b : S), X.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op (wcCnSigma g ⊤ b) =
      wcCnSigma g (U i) b := by
    intro i b
    have hm : X.presheaf.map (homOfLE (le_top : (⊤ : X.Opens) ≤ ⊤)).op ≫
        X.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op =
        X.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op := by
      rw [← Functor.map_comp]
      rfl
    exact congrArg (fun φ => φ.hom ((g.appTop.hom.comp (Scheme.ΓSpecIso (.of S)).inv.hom) b)) hm

  obtain ⟨c, hc⟩ := H0
  refine ⟨c, ?_⟩
  unfold wcCnFfAR0
  intro n τ hτ hτi
  obtain ⟨s, hs⟩ := Gl1 τ hτ
  have hmem : ∀ i, X.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op s ∈
      Ideal.map (wcCnSigma g (U i)) (Ideal.map (algebraMap R S) 𝔞 ^ (n + c)) := by
    intro i
    rw [hs i]
    exact (Hiff i (n + c) (τ i)).mp (hτi i)
  have hyp : ∀ i, ((wcStructMod X).presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op).hom s ∈
      Ideal.map (wcCnSigma g (U i)) (Ideal.map (algebraMap R S) 𝔞 ^ (n + c)) •
        (⊤ : Submodule Γ(X, U i) Γ(wcStructMod X, U i)) := by
    intro i
    have h2 := Submodule.smul_mem_smul (M := Γ(wcStructMod X, U i))
      (N := (⊤ : Submodule Γ(X, U i) Γ(wcStructMod X, U i))) (hmem i)
      (Submodule.mem_top (x := ((1 : Γ(X, U i)) : Γ(wcStructMod X, U i))))
    have e : ((wcStructMod X).presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op).hom s =
        (X.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op s) •
          ((1 : Γ(X, U i)) : Γ(wcStructMod X, U i)) := by
      show X.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op s =
        X.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op s * 1
      rw [mul_one]
    rw [e]
    exact h2
  obtain ⟨k, a, x, ha, hsum⟩ : ∃ (k : ℕ) (a : Fin k → S) (x : Fin k → Γ(X, ⊤)),
      (∀ l, a l ∈ Ideal.map (algebraMap R S) 𝔞 ^ n) ∧ s = ∑ l, wcCnSigma g ⊤ (a l) * x l :=
    hc n s hyp
  have hτeq : τ = ∑ l, (fun i => LinearMap.lTensor (A i) (LinearMap.mulLeft R (a l))
      ((θ1 i).symm (X.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op (x l))) :
        ∀ i, TensorProduct R (A i) S) := by
    funext i
    apply (θ1 i).injective
    rw [Finset.sum_apply, map_sum]
    simp only [Hmul, RingEquiv.apply_symm_apply]
    rw [← hs i, hsum, map_sum]
    simp only [map_mul, hres]
  rw [hτeq]
  exact Submodule.sum_mem _ (fun l _ => hkey n (a l) (ha l) _ (Gl2 (x l)))

theorem wc_ccr_gen_transport : ∀ (R : Type u) [CommRing R] (r : ℕ) (A : Fin r → Type u) [∀ i, CommRing (A i)] [∀ i, Algebra R (A i)] (A2 : Fin r → Fin r → Type u) [∀ i j, CommRing (A2 i j)] [∀ i j, Algebra R (A2 i j)] (ρl : ∀ i j, A i →ₐ[R] A2 i j) (ρr : ∀ i j, A j →ₐ[R] A2 i j) (S : Type u) [CommRing S] [Algebra R S] (X : Scheme.{u}) (g : X ⟶ Spec (.of S)) (U : Fin r → X.Opens) (θ1 : ∀ i, TensorProduct R (A i) S ≃+* Γ(X, U i)), (∀ i (s : S) (x : TensorProduct R (A i) S), θ1 i (LinearMap.lTensor (A i) (LinearMap.mulLeft R s) x) = wcCnSigma g (U i) s * θ1 i x) → (∀ τ ∈ wcCnCechT A A2 ρl ρr S, ∃ s : Γ(X, ⊤), ∀ i, X.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op s = θ1 i (τ i)) → (∀ s : Γ(X, ⊤), (fun i => (θ1 i).symm (X.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op s)) ∈ wcCnCechT A A2 ρl ρr S) → (∃ (k : ℕ) (c : Fin k → Γ(wcStructMod X, ⊤)), ∀ s : Γ(wcStructMod X, ⊤), ∃ b : Fin k → S, s = ∑ l, wcCnSigma g ⊤ (b l) • c l) → wcCnFfGen A A2 ρl ρr S :=
by
  intro R _ r A _ _ A2 _ _ ρl ρr S _ _ X g U θ1 H1 H2 H3 H4
  replace H4 : ∃ (k : ℕ) (c : Fin k → Γ(X, ⊤)), ∀ s : Γ(X, ⊤), ∃ b : Fin k → S,
      s = ∑ l, wcCnSigma g ⊤ (b l) * c l := H4
  obtain ⟨k, c, hc⟩ := H4
  refine ⟨k, fun l i => (θ1 i).symm (X.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op (c l)),
    fun l => H3 (c l), ?_⟩
  intro τ hτ
  obtain ⟨s, hs⟩ := H2 τ hτ
  obtain ⟨b, hb'⟩ := hc s
  have hσ : ∀ i t, X.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op (wcCnSigma g ⊤ t) =
      wcCnSigma g (U i) t := by
    intro i t
    unfold wcCnSigma
    simp only [RingHom.comp_apply]
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  refine ⟨b, ?_⟩
  funext i
  rw [Finset.sum_apply]
  apply (θ1 i).injective
  rw [map_sum, ← hs i, hb', map_sum]
  refine Finset.sum_congr rfl (fun l _ => ?_)
  rw [H1, RingEquiv.apply_symm_apply, map_mul, hσ]

theorem wc_cn_cech_ring_coeff_ar : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B] (Z : Scheme.{u})
    (h : Z ⟶ Spec (.of B)) [IsProper h] (P : Scheme.{u}) (p : P ⟶ Z) (m : ℕ)
    (g : P ⟶ wcPm.{u} m), IsProper p → IsClosedImmersion (Limits.prod.lift (p ≫ h) g) →
    ∀ (V : Z.Opens), IsAffineOpen V → ∀ (r : ℕ) (W : Fin r → P.Opens) (hW : ∀ i, W i ≤ p ⁻¹ᵁ V)
    [∀ i, Algebra Γ(Z, V) Γ(P, W i)] [∀ i j, Algebra Γ(Z, V) Γ(P, W i ⊓ W j)]
    (ρl : ∀ i j, Γ(P, W i) →ₐ[Γ(Z, V)] Γ(P, W i ⊓ W j))
    (ρr : ∀ i j, Γ(P, W j) →ₐ[Γ(Z, V)] Γ(P, W i ⊓ W j)),
    wcCnChartCompat p V W hW ρl ρr →
    ∀ (S : Type u) [CommRing S] [Algebra Γ(Z, V) S] [IsNoetherianRing S] (𝔞 : Ideal Γ(Z, V)),
    ∃ c : ℕ,
      wcCnFfAR0 𝔞 (fun i => Γ(P, W i)) (fun i j => Γ(P, W i ⊓ W j)) ρl ρr S c ∧
      wcCnFfAR1 𝔞 (fun i => Γ(P, W i)) (fun i j => Γ(P, W i ⊓ W j)) ρl ρr S c ∧
      wcCnFfGen (fun i => Γ(P, W i)) (fun i j => Γ(P, W i ⊓ W j)) ρl ρr S :=
by
  intro B _ _ Z h _ P p m g hp hcl V hV r W hW _ _ ρl ρr hc S _ _ _ 𝔞
  have hc' := hc
  obtain ⟨hWa, -, hWi, hA1, hA2, -, -⟩ := hc'
  have hpo := wc_ccr_pullback_chart_pushout
  obtain ⟨X, gX, U, θ1, θ2, hprop, haff, hcov, haff2, hcl1, hcr1, hσ1, hσ2⟩ :=
    wc_ccr_basechange_model Z P p hp V hV r W hW ρl ρr hc S
      (fun i UY hUY heq => wc_ccr_basechange_chart_iso hpo Z P p V hV S (W i) (hWa i) (hW i)
        (hA1 i) UY hUY heq)
      (fun i j UY hUY heq => wc_ccr_basechange_chart_iso hpo Z P p V hV S (W i ⊓ W j) (hWi i j)
        (le_trans inf_le_left (hW i)) (hA2 i j) UY hUY heq)
  haveI := hprop
  have T1 := fun i : Fin r => wc_ccr_tensor_ideal_transport Γ(Z, V) 𝔞 Γ(P, W i) S Γ(X, U i)
    (wcCnSigma gX (U i)) (θ1 i) (hσ1 i)
  have T2 := fun i j : Fin r => wc_ccr_tensor_ideal_transport Γ(Z, V) 𝔞 Γ(P, W i ⊓ W j) S
    Γ(X, U i ⊓ U j) (wcCnSigma gX (U i ⊓ U j)) (θ2 i j) (hσ2 i j)
  obtain ⟨Gl1, Gl2⟩ := wc_ccr_cech_glue Γ(Z, V) r (fun i => Γ(P, W i))
    (fun i j => Γ(P, W i ⊓ W j)) ρl ρr S X U θ1 θ2 hcov hcl1 hcr1
  obtain ⟨c1, hAR1⟩ := wc_ccr_ar1_transport Γ(Z, V) 𝔞 r (fun i => Γ(P, W i))
    (fun i j => Γ(P, W i ⊓ W j)) ρl ρr S X gX U θ1 θ2 hcl1 hcr1 (fun i => (T1 i).1)
    (fun i j => (T2 i j).1)
    (wc_proper_cech_artin_rees S (Ideal.map (algebraMap Γ(Z, V) S) 𝔞) X gX r U haff hcov haff2)
  obtain ⟨c0, hAR0⟩ := wc_ccr_ar0_transport Γ(Z, V) 𝔞 r (fun i => Γ(P, W i))
    (fun i j => Γ(P, W i ⊓ W j)) ρl ρr S X gX U θ1 (fun i => (T1 i).1) (fun i => (T1 i).2)
    Gl1 Gl2
    (wc_cn_rml_h0_artin_rees S (Ideal.map (algebraMap Γ(Z, V) S) 𝔞) X gX (wcStructMod X)
      (wc_struct_mod_coh X) r U haff hcov haff2)
  have hGen := wc_ccr_gen_transport Γ(Z, V) r (fun i => Γ(P, W i))
    (fun i j => Γ(P, W i ⊓ W j)) ρl ρr S X gX U θ1 (fun i => (T1 i).2) Gl1 Gl2
    (wc_cn_coherent_global_sections_fg S X gX (wcStructMod X) (wc_struct_mod_coh X))
  refine ⟨max c0 c1, ?_, ?_, hGen⟩
  · unfold wcCnFfAR0 at hAR0 ⊢
    intro n τ hτ hτi
    exact hAR0 n τ hτ (fun i => Submodule.smul_mono_left
      (Ideal.pow_le_pow_right (Nat.add_le_add_left (le_max_left c0 c1) n)) (hτi i))
  · unfold wcCnFfAR1 at hAR1 ⊢
    intro n ω hω
    exact hAR1 n ω (fun i j => Submodule.smul_mono_left
      (Ideal.pow_le_pow_right (Nat.add_le_add_left (le_max_right c0 c1) n)) (hω i j))

theorem wc_cech_ar_retract_transfer : ∀ (R : Type u) [CommRing R] (𝔞 : Ideal R) (r : ℕ)
    (A : Fin r → Type u) [∀ i, CommRing (A i)] [∀ i, Algebra R (A i)]
    (A2 : Fin r → Fin r → Type u) [∀ i j, CommRing (A2 i j)] [∀ i j, Algebra R (A2 i j)]
    (ρl : ∀ i j, A i →ₐ[R] A2 i j) (ρr : ∀ i j, A j →ₐ[R] A2 i j)
    (S : Type u) [CommRing S] [Algebra R S] (L : Type u) [AddCommGroup L] [Module R L]
    (ι : L →ₗ[R] S) (π : S →ₗ[R] L) (c : ℕ),
    (∀ x, π (ι x) = x) →
    wcCnFfAR0 𝔞 A A2 ρl ρr S c → wcCnFfAR1 𝔞 A A2 ρl ρr S c → wcCnFfGen A A2 ρl ρr S →
    wcCnFfHC 𝔞 S →
    wcCnFfAR0 𝔞 A A2 ρl ρr L c ∧ wcCnFfAR1 𝔞 A A2 ρl ρr L c ∧ wcCnFfHaus 𝔞 A A2 ρl ρr L ∧
      wcCnFfCompl 𝔞 A A2 ρl ρr L :=
by
  intro R _ 𝔞 r A _ _ A2 _ _ ρl ρr S _ _ L _ _ ι π c hπι h0 h1 hgen hHC
  classical

  have comm : ∀ (E E' : Type u) [AddCommGroup E] [Module R E] [AddCommGroup E'] [Module R E']
      (X Y : Type u) [AddCommGroup X] [Module R X] [AddCommGroup Y] [Module R Y]
      (f : E →ₗ[R] E') (g : X →ₗ[R] Y) (z : TensorProduct R E X),
      LinearMap.rTensor Y f (LinearMap.lTensor E g z) =
        LinearMap.lTensor E' g (LinearMap.rTensor X f z) := by
    intro E E' _ _ _ _ X Y _ _ _ _ f g z
    rw [← LinearMap.comp_apply, ← LinearMap.comp_apply, LinearMap.rTensor_comp_lTensor,
      LinearMap.lTensor_comp_rTensor]

  have pushT : ∀ (X Y : Type u) [AddCommGroup X] [Module R X] [AddCommGroup Y] [Module R Y]
      (g : X →ₗ[R] Y) (τ : ∀ i, TensorProduct R (A i) X), τ ∈ wcCnCechT A A2 ρl ρr X →
      (fun i => LinearMap.lTensor (A i) g (τ i)) ∈ wcCnCechT A A2 ρl ρr Y := by
    intro X Y _ _ _ _ g τ hτ i j
    show LinearMap.rTensor Y (ρl i j).toLinearMap (LinearMap.lTensor (A i) g (τ i)) =
      LinearMap.rTensor Y (ρr i j).toLinearMap (LinearMap.lTensor (A j) g (τ j))
    rw [comm, comm]
    exact congrArg (LinearMap.lTensor (A2 i j) g) (hτ i j)

  have smulmap : ∀ (P Q : Type u) [AddCommGroup P] [Module R P] [AddCommGroup Q] [Module R Q]
      (F : P →ₗ[R] Q) (X : Submodule R P) (Y : Submodule R Q), X.map F ≤ Y →
      ∀ (I : Ideal R) (x : P), x ∈ I • X → F x ∈ I • Y := by
    intro P Q _ _ _ _ F X Y hXY I x hx
    have h1 : F x ∈ (I • X).map F := Submodule.mem_map_of_mem hx
    rw [Submodule.map_smul''] at h1
    exact Submodule.smul_mono le_rfl hXY h1

  let PI : (∀ i, TensorProduct R (A i) L) →ₗ[R] (∀ i, TensorProduct R (A i) S) :=
    LinearMap.pi (fun i => (LinearMap.lTensor (A i) ι).comp (LinearMap.proj i))
  let PP : (∀ i, TensorProduct R (A i) S) →ₗ[R] (∀ i, TensorProduct R (A i) L) :=
    LinearMap.pi (fun i => (LinearMap.lTensor (A i) π).comp (LinearMap.proj i))
  have PI_apply : ∀ ω i, PI ω i = LinearMap.lTensor (A i) ι (ω i) := fun _ _ => rfl
  have PP_apply : ∀ ω i, PP ω i = LinearMap.lTensor (A i) π (ω i) := fun _ _ => rfl
  have hπι' : π ∘ₗ ι = LinearMap.id := LinearMap.ext hπι
  have PPI : ∀ ω, PP (PI ω) = ω := by
    intro ω
    funext i
    rw [PP_apply, PI_apply, ← LinearMap.comp_apply, ← LinearMap.lTensor_comp, hπι',
      LinearMap.lTensor_id, LinearMap.id_apply]
  have PI_T : ∀ τ ∈ wcCnCechT A A2 ρl ρr L, PI τ ∈ wcCnCechT A A2 ρl ρr S :=
    fun τ hτ => pushT L S ι τ hτ
  have PP_T : ∀ τ ∈ wcCnCechT A A2 ρl ρr S, PP τ ∈ wcCnCechT A A2 ρl ρr L :=
    fun τ hτ => pushT S L π τ hτ
  have mapI : (wcCnCechT A A2 ρl ρr L).map PI ≤ wcCnCechT A A2 ρl ρr S := by
    rintro _ ⟨τ, hτ, rfl⟩
    exact PI_T τ hτ
  have mapP : (wcCnCechT A A2 ρl ρr S).map PP ≤ wcCnCechT A A2 ρl ρr L := by
    rintro _ ⟨τ, hτ, rfl⟩
    exact PP_T τ hτ

  have hAR0 : wcCnFfAR0 𝔞 A A2 ρl ρr L c := by
    intro n τ hτ hτi
    have h := h0 n (PI τ) (PI_T τ hτ) (fun i =>
      smulmap _ _ (LinearMap.lTensor (A i) ι) ⊤ ⊤ le_top _ _ (hτi i))
    have h2 := smulmap _ _ PP _ _ mapP _ _ h
    rwa [PPI] at h2

  have hAR1 : wcCnFfAR1 𝔞 A A2 ρl ρr L c := by
    intro n ω hω
    obtain ⟨w', hw', hdiff⟩ := h1 n (PI ω) (fun i j => by
      rw [PI_apply, PI_apply, comm, comm, ← map_sub]
      exact smulmap _ _ (LinearMap.lTensor (A2 i j) ι) ⊤ ⊤ le_top _ _ (hω i j))
    refine ⟨PP w', fun i => ?_, ?_⟩
    · rw [PP_apply]
      exact smulmap _ _ (LinearMap.lTensor (A i) π) ⊤ ⊤ le_top _ _ (hw' i)
    · have := PP_T _ hdiff
      rwa [map_sub, PPI] at this

  have m_T : ∀ (s : S), ∀ τ ∈ wcCnCechT A A2 ρl ρr S,
      (fun i => LinearMap.lTensor (A i) (LinearMap.mulLeft R s) (τ i)) ∈
        wcCnCechT A A2 ρl ρr S :=
    fun s τ hτ => pushT S S (LinearMap.mulLeft R s) τ hτ
  letI smulT : SMul S (wcCnCechT A A2 ρl ρr S) :=
    ⟨fun s x => ⟨fun i => LinearMap.lTensor (A i) (LinearMap.mulLeft R s) (x.1 i), m_T s x.1 x.2⟩⟩
  have lt_add : ∀ (s t : S) (i : Fin r) (z : TensorProduct R (A i) S),
      LinearMap.lTensor (A i) (LinearMap.mulLeft R (s + t)) z =
        LinearMap.lTensor (A i) (LinearMap.mulLeft R s) z +
          LinearMap.lTensor (A i) (LinearMap.mulLeft R t) z := by
    intro s t i z
    have e : LinearMap.mulLeft R (s + t) = LinearMap.mulLeft R s + LinearMap.mulLeft R t := by
      ext x
      simp [add_mul]
    rw [e, LinearMap.lTensor_add, LinearMap.add_apply]
  have lt_mul : ∀ (s t : S) (i : Fin r) (z : TensorProduct R (A i) S),
      LinearMap.lTensor (A i) (LinearMap.mulLeft R (s * t)) z =
        LinearMap.lTensor (A i) (LinearMap.mulLeft R s)
          (LinearMap.lTensor (A i) (LinearMap.mulLeft R t) z) := by
    intro s t i z
    rw [LinearMap.mulLeft_mul, LinearMap.lTensor_comp, LinearMap.comp_apply]
  have lt_one : ∀ (i : Fin r) (z : TensorProduct R (A i) S),
      LinearMap.lTensor (A i) (LinearMap.mulLeft R (1 : S)) z = z := by
    intro i z
    rw [LinearMap.mulLeft_one, LinearMap.lTensor_id, LinearMap.id_apply]
  have lt_smul : ∀ (a : R) (s : S) (i : Fin r) (z : TensorProduct R (A i) S),
      LinearMap.lTensor (A i) (LinearMap.mulLeft R (a • s)) z =
        a • LinearMap.lTensor (A i) (LinearMap.mulLeft R s) z := by
    intro a s i z
    have e : LinearMap.mulLeft R (a • s) = a • LinearMap.mulLeft R s := by
      ext x
      simp
    rw [e, LinearMap.lTensor_smul, LinearMap.smul_apply]
  letI modT : Module S (wcCnCechT A A2 ρl ρr S) := Module.ofMinimalAxioms
    (fun s x y => Subtype.ext (funext fun i => by
      show LinearMap.lTensor (A i) (LinearMap.mulLeft R s) (x.1 i + y.1 i) =
        LinearMap.lTensor (A i) (LinearMap.mulLeft R s) (x.1 i) +
          LinearMap.lTensor (A i) (LinearMap.mulLeft R s) (y.1 i)
      exact map_add _ _ _))
    (fun s t x => Subtype.ext (funext fun i => by
      show LinearMap.lTensor (A i) (LinearMap.mulLeft R (s + t)) (x.1 i) =
        LinearMap.lTensor (A i) (LinearMap.mulLeft R s) (x.1 i) +
          LinearMap.lTensor (A i) (LinearMap.mulLeft R t) (x.1 i)
      exact lt_add s t i _))
    (fun s t x => Subtype.ext (funext fun i => by
      show LinearMap.lTensor (A i) (LinearMap.mulLeft R (s * t)) (x.1 i) =
        LinearMap.lTensor (A i) (LinearMap.mulLeft R s)
          (LinearMap.lTensor (A i) (LinearMap.mulLeft R t) (x.1 i))
      exact lt_mul s t i _))
    (fun x => Subtype.ext (funext fun i => by
      show LinearMap.lTensor (A i) (LinearMap.mulLeft R (1 : S)) (x.1 i) = x.1 i
      exact lt_one i _))
  haveI towT : IsScalarTower R S (wcCnCechT A A2 ρl ρr S) :=
    ⟨fun a s x => Subtype.ext (funext fun i => by
      show LinearMap.lTensor (A i) (LinearMap.mulLeft R (a • s)) (x.1 i) =
        a • LinearMap.lTensor (A i) (LinearMap.mulLeft R s) (x.1 i)
      exact lt_smul a s i _)⟩
  obtain ⟨k, y, hy, hspan⟩ := hgen
  haveI finT : Module.Finite S (wcCnCechT A A2 ρl ρr S) := by
    refine ⟨⟨Finset.univ.image (fun l => (⟨y l, hy l⟩ : wcCnCechT A A2 ρl ρr S)), ?_⟩⟩
    rw [eq_top_iff]
    rintro x -
    obtain ⟨s, hs⟩ := hspan x.1 x.2
    have hx : x = ∑ l, s l • (⟨y l, hy l⟩ : wcCnCechT A A2 ρl ρr S) := by
      apply Subtype.ext
      rw [hs, Submodule.coe_sum]
      rfl
    rw [hx]
    refine Submodule.sum_mem _ (fun l _ => Submodule.smul_mem _ _ (Submodule.subset_span ?_))
    simp
  obtain ⟨hK, hC⟩ := hHC (wcCnCechT A A2 ρl ρr S) finT
  have hHausS : wcCnFfHaus 𝔞 A A2 ρl ρr S := by
    intro τ hτ hall
    have h := hK ⟨τ, hτ⟩ (fun n => (Submodule.mem_smul_top_iff _ _ _).mpr (hall n))
    exact congrArg Subtype.val h
  have hComplS : wcCnFfCompl 𝔞 A A2 ρl ρr S := by
    intro u hu hdu
    obtain ⟨t, ht⟩ := hC (fun n => ⟨u n, hu n⟩)
      (fun n => (Submodule.mem_smul_top_iff _ _ _).mpr (hdu n))
    exact ⟨t.1, t.2, fun n => (Submodule.mem_smul_top_iff _ _ _).mp (ht n)⟩

  have hHaus : wcCnFfHaus 𝔞 A A2 ρl ρr L := by
    intro τ hτ hall
    have h := hHausS (PI τ) (PI_T τ hτ) (fun n => smulmap _ _ PI _ _ mapI _ _ (hall n))
    rw [← PPI τ, h, map_zero]
  have hCompl : wcCnFfCompl 𝔞 A A2 ρl ρr L := by
    intro u hu hdu
    obtain ⟨t', ht'T, ht'⟩ := hComplS (fun n => PI (u n)) (fun n => PI_T _ (hu n))
      (fun n => by
        show PI (u (n + 1)) - PI (u n) ∈ _
        rw [← map_sub]
        exact smulmap _ _ PI _ _ mapI _ _ (hdu n))
    refine ⟨PP t', PP_T _ ht'T, fun n => ?_⟩
    have h := smulmap _ _ PP _ _ mapP _ _ (ht' n)
    rwa [map_sub, PPI] at h
  exact ⟨hAR0, hAR1, hHaus, hCompl⟩

theorem wc_cech_formal_functions_of_ar : ∀ (R : Type u) [CommRing R] (𝔞 : Ideal R) (r : ℕ)
    (A : Fin r → Type u) [∀ i, CommRing (A i)] [∀ i, Algebra R (A i)]
    (A2 : Fin r → Fin r → Type u) [∀ i j, CommRing (A2 i j)] [∀ i j, Algebra R (A2 i j)]
    (ρl : ∀ i j, A i →ₐ[R] A2 i j) (ρr : ∀ i j, A j →ₐ[R] A2 i j)
    (N : ℕ → Type u) [∀ n, AddCommGroup (N n)] [∀ n, Module R (N n)]
    (ψ : ∀ n, N (n + 1) →ₗ[R] N n) (c : ℕ),
    (∀ n, Function.Surjective ((LinearMap.proj (R := R) (φ := N) n).comp
      (wcCnLimMod N ψ).subtype)) →
    (∀ n (x : wcCnLimMod N ψ), (x : ∀ n, N n) n = 0 ↔
      x ∈ 𝔞 ^ (n + 1) • (⊤ : Submodule R (wcCnLimMod N ψ))) →
    wcCnFfAR0 𝔞 A A2 ρl ρr (wcCnLimMod N ψ) c → wcCnFfAR1 𝔞 A A2 ρl ρr (wcCnLimMod N ψ) c →
    wcCnFfHaus 𝔞 A A2 ρl ρr (wcCnLimMod N ψ) → wcCnFfCompl 𝔞 A A2 ρl ρr (wcCnLimMod N ψ) →
    (∀ τ ∈ wcCnCechT A A2 ρl ρr (wcCnLimMod N ψ),
      (∀ n, (fun i => LinearMap.lTensor (A i)
        ((LinearMap.proj (R := R) (φ := N) n).comp (wcCnLimMod N ψ).subtype) (τ i)) = 0) →
      τ = 0) ∧
    (∀ τs : ∀ n, ∀ i, TensorProduct R (A i) (N n),
      (∀ n, τs n ∈ wcCnCechT A A2 ρl ρr (N n)) →
      (∀ n, (fun i => LinearMap.lTensor (A i) (ψ n) (τs (n + 1) i)) = τs n) →
      ∃ τ ∈ wcCnCechT A A2 ρl ρr (wcCnLimMod N ψ),
        ∀ n, (fun i => LinearMap.lTensor (A i)
          ((LinearMap.proj (R := R) (φ := N) n).comp (wcCnLimMod N ψ).subtype) (τ i)) =
          τs n) :=
by
  intro R _ 𝔞 r A _ _ A2 _ _ ρl ρr N _ _ ψ c hS hKer AR0 AR1 Haus Compl

  obtain ⟨pr, hpr⟩ : ∃ pr : ∀ n, wcCnLimMod N ψ →ₗ[R] N n, ∀ n,
      (LinearMap.proj (R := R) (φ := N) n).comp (wcCnLimMod N ψ).subtype = pr n :=
    ⟨fun n => (LinearMap.proj (R := R) (φ := N) n).comp (wcCnLimMod N ψ).subtype, fun n => rfl⟩
  simp only [hpr] at hS ⊢

  have kerlemma : ∀ (I : Ideal R) (E L P : Type u) [AddCommGroup E] [Module R E]
      [AddCommGroup L] [Module R L] [AddCommGroup P] [Module R P] (g : L →ₗ[R] P),
      Function.Surjective g → (∀ x : L, g x = 0 ↔ x ∈ I • (⊤ : Submodule R L)) →
      ∀ ω : TensorProduct R E L, LinearMap.lTensor E g ω = 0 ↔
        ω ∈ I • (⊤ : Submodule R (TensorProduct R E L)) := by
    intro I E L P _ _ _ _ _ _ g hg hker ω
    have hex : Function.Exact (I • (⊤ : Submodule R L)).subtype g := by
      intro y
      constructor
      · intro hy
        exact ⟨⟨y, (hker y).mp hy⟩, rfl⟩
      · rintro ⟨k, rfl⟩
        exact (hker _).mpr k.2
    have hex2 := lTensor_exact E hex hg
    rw [hex2 ω]
    constructor
    · rintro ⟨z, rfl⟩
      induction z using TensorProduct.induction_on with
      | zero => rw [map_zero]; exact Submodule.zero_mem _
      | tmul e k =>
        rw [LinearMap.lTensor_tmul, Submodule.subtype_apply]
        refine Submodule.smul_induction_on
          (p := fun y => e ⊗ₜ[R] y ∈ I • (⊤ : Submodule R (TensorProduct R E L))) k.2 ?_ ?_
        · intro a ha y _
          rw [TensorProduct.tmul_smul]
          exact Submodule.smul_mem_smul ha Submodule.mem_top
        · intro y1 y2 h1 h2
          rw [TensorProduct.tmul_add]
          exact Submodule.add_mem _ h1 h2
      | add z1 z2 h1 h2 => rw [map_add]; exact Submodule.add_mem _ h1 h2
    · intro hω
      refine Submodule.smul_induction_on
        (p := fun ω => ω ∈ Set.range (LinearMap.lTensor E (I • (⊤ : Submodule R L)).subtype))
        hω ?_ ?_
      · intro a ha t ht
        clear ht
        induction t using TensorProduct.induction_on with
        | zero => exact ⟨0, by rw [map_zero, smul_zero]⟩
        | tmul e y =>
          refine ⟨e ⊗ₜ[R] (⟨a • y, Submodule.smul_mem_smul ha Submodule.mem_top⟩ :
            ↥(I • (⊤ : Submodule R L))), ?_⟩
          rw [LinearMap.lTensor_tmul, Submodule.subtype_apply, ← TensorProduct.tmul_smul]
        | add t1 t2 h1 h2 =>
          obtain ⟨z1, hz1⟩ := h1
          obtain ⟨z2, hz2⟩ := h2
          exact ⟨z1 + z2, by rw [map_add, hz1, hz2, smul_add]⟩
      · rintro x y ⟨z1, hz1⟩ ⟨z2, hz2⟩
        exact ⟨z1 + z2, by rw [map_add, hz1, hz2]⟩
  have hK : ∀ n i (ω : TensorProduct R (A i) (wcCnLimMod N ψ)),
      LinearMap.lTensor (A i) (pr n) ω = 0 ↔
        ω ∈ 𝔞 ^ (n + 1) • (⊤ : Submodule R (TensorProduct R (A i) (wcCnLimMod N ψ))) :=
    fun n i ω => kerlemma (𝔞 ^ (n + 1)) (A i) (wcCnLimMod N ψ) (N n) (pr n) (hS n)
      (fun x => by rw [← hpr]; exact hKer n x) ω
  have hK2 : ∀ n i j (ω : TensorProduct R (A2 i j) (wcCnLimMod N ψ)),
      LinearMap.lTensor (A2 i j) (pr n) ω = 0 ↔
        ω ∈ 𝔞 ^ (n + 1) • (⊤ : Submodule R (TensorProduct R (A2 i j) (wcCnLimMod N ψ))) :=
    fun n i j ω => kerlemma (𝔞 ^ (n + 1)) (A2 i j) (wcCnLimMod N ψ) (N n) (pr n) (hS n)
      (fun x => by rw [← hpr]; exact hKer n x) ω
  have hsmul_mono : ∀ (M : Type u) [AddCommGroup M] [Module R M] (k : ℕ),
      𝔞 ^ (k + 1) • (⊤ : Submodule R M) ≤ 𝔞 ^ k • (⊤ : Submodule R M) :=
    fun M _ _ k => Submodule.smul_mono_left (Ideal.pow_le_pow_right (Nat.le_succ k))
  refine ⟨fun τ hτ h0 => ?_, fun τs hT hC => ?_⟩
  ·
    apply Haus τ hτ
    intro n
    apply AR0 n τ hτ
    intro i
    exact hsmul_mono (TensorProduct R (A i) (wcCnLimMod N ψ)) (n + c)
      ((hK (n + c) i (τ i)).mp (congrFun (h0 (n + c)) i))
  ·

    have nat : ∀ (n : ℕ) (i j k : Fin r) (ρ : A k →ₐ[R] A2 i j)
        (x : TensorProduct R (A k) (wcCnLimMod N ψ)),
        LinearMap.rTensor (N n) ρ.toLinearMap (LinearMap.lTensor (A k) (pr n) x) =
          LinearMap.lTensor (A2 i j) (pr n) (LinearMap.rTensor _ ρ.toLinearMap x) := by
      intro n i j k ρ x
      induction x using TensorProduct.induction_on with
      | zero => simp only [map_zero]
      | tmul a y =>
        simp only [LinearMap.lTensor_tmul, LinearMap.rTensor_tmul]
      | add x y hx hy => simp only [map_add, hx, hy]

    have step : ∀ (j : ℕ) (k : Fin r) (y : TensorProduct R (A k) (wcCnLimMod N ψ)),
        LinearMap.lTensor (A k) (pr j) y =
          LinearMap.lTensor (A k) (ψ j) (LinearMap.lTensor (A k) (pr (j + 1)) y) := by
      intro j k y
      have e : pr j = (ψ j).comp (pr (j + 1)) := by
        rw [← hpr, ← hpr]
        exact LinearMap.ext fun x => ((show ∀ n, ψ n ((x : ∀ n, N n) (n + 1)) =
          (x : ∀ n, N n) n from x.2) j).symm
      rw [e, LinearMap.lTensor_comp_apply]

    have descent : ∀ (k : Fin r) (y : TensorProduct R (A k) (wcCnLimMod N ψ)) (m : ℕ),
        LinearMap.lTensor (A k) (pr m) y = τs m k →
        ∀ j ≤ m, LinearMap.lTensor (A k) (pr j) y = τs j k := by
      intro k y m hm
      have key : ∀ d j, j + d = m → LinearMap.lTensor (A k) (pr j) y = τs j k := by
        intro d
        induction d with
        | zero =>
          intro j hj
          rw [Nat.add_zero] at hj
          subst hj
          exact hm
        | succ d ih =>
          intro j hj
          rw [step j k y, ih (j + 1) (by omega)]
          exact congrFun (hC j) k
      intro j hj
      exact key (m - j) j (by omega)

    have F5 : ∀ (k : ℕ) (v : ∀ i, TensorProduct R (A i) (wcCnLimMod N ψ)),
        v ∈ 𝔞 ^ k • wcCnCechT A A2 ρl ρr (wcCnLimMod N ψ) →
        ∀ i, v i ∈ 𝔞 ^ k • (⊤ : Submodule R (TensorProduct R (A i) (wcCnLimMod N ψ))) := by
      intro k v hv i
      refine Submodule.smul_induction_on
        (p := fun v : (∀ i, TensorProduct R (A i) (wcCnLimMod N ψ)) =>
          v i ∈ 𝔞 ^ k • (⊤ : Submodule R (TensorProduct R (A i) (wcCnLimMod N ψ)))) hv ?_ ?_
      · intro a ha τ _
        exact Submodule.smul_mem_smul ha Submodule.mem_top
      · intro x y hx hy
        exact Submodule.add_mem _ hx hy

    have hlift : ∀ n i, ∃ y : TensorProduct R (A i) (wcCnLimMod N ψ),
        LinearMap.lTensor (A i) (pr n) y = τs n i :=
      fun n i => LinearMap.lTensor_surjective (A i) (hS n) (τs n i)
    choose ω hω using hlift

    have hdiff : ∀ k i j, LinearMap.rTensor (wcCnLimMod N ψ) (ρl i j).toLinearMap (ω k i) -
        LinearMap.rTensor (wcCnLimMod N ψ) (ρr i j).toLinearMap (ω k j) ∈
        𝔞 ^ (k + 1) • (⊤ : Submodule R (TensorProduct R (A2 i j) (wcCnLimMod N ψ))) := by
      intro k i j
      rw [← hK2 k i j, map_sub, ← nat, ← nat, hω, hω, sub_eq_zero]
      exact hT k i j

    have hcor : ∀ n, ∃ w : ∀ i, TensorProduct R (A i) (wcCnLimMod N ψ),
        (∀ i, w i ∈ 𝔞 ^ n • (⊤ : Submodule R (TensorProduct R (A i) (wcCnLimMod N ψ)))) ∧
        ω (n + c) - w ∈ wcCnCechT A A2 ρl ρr (wcCnLimMod N ψ) := by
      intro n
      apply AR1 n (ω (n + c))
      intro i j
      exact hsmul_mono _ (n + c) (hdiff (n + c) i j)
    choose w hw hσ using hcor
    have star : ∀ n i j, j + 1 ≤ n →
        LinearMap.lTensor (A i) (pr j) (ω (n + c) i) -
          LinearMap.lTensor (A i) (pr j) (w n i) = τs j i := by
      intro n i j hj
      rw [descent i _ (n + c) (hω _ _) j (by omega),
        (hK j i _).mpr (Submodule.smul_mono_left (Ideal.pow_le_pow_right hj) (hw n i)), sub_zero]

    have hcauchy : ∀ n, (ω (n + 1 + c + 1 + c) - w (n + 1 + c + 1)) -
        (ω (n + c + 1 + c) - w (n + c + 1)) ∈ 𝔞 ^ n • wcCnCechT A A2 ρl ρr (wcCnLimMod N ψ) := by
      intro n
      apply AR0 n _ (Submodule.sub_mem _ (hσ _) (hσ _))
      intro i
      refine hsmul_mono (TensorProduct R (A i) (wcCnLimMod N ψ)) (n + c)
        ((hK (n + c) i _).mp ?_)
      simp only [Pi.sub_apply, map_sub]
      rw [star (n + 1 + c + 1) i (n + c) (by omega), star (n + c + 1) i (n + c) (by omega),
        sub_self]

    obtain ⟨t, ht, hlim⟩ := Compl (fun n => ω (n + c + 1 + c) - w (n + c + 1)) (fun n => hσ _)
      hcauchy
    refine ⟨t, ht, fun j => funext fun i => ?_⟩
    have h1 := (hK j i _).mpr (F5 (j + 1) _ (hlim (j + 1)) i)
    simp only [Pi.sub_apply, map_sub, sub_eq_zero] at h1
    show LinearMap.lTensor (A i) (pr j) (t i) = τs j i
    rw [h1]
    exact star (j + 1 + c + 1) i j (by omega)

theorem wc_cn_cech_formal_functions : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B] (I : Ideal B)
    (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B)) [IsProper h] (P : Scheme.{u}) (p : P ⟶ Z) (m : ℕ)
    (g : P ⟶ wcPm.{u} m), IsProper p → IsClosedImmersion (Limits.prod.lift (p ≫ h) g) →
    ∀ (V : Z.Opens), IsAffineOpen V → ∀ (r : ℕ) (W : Fin r → P.Opens) (hW : ∀ i, W i ≤ p ⁻¹ᵁ V)
    [∀ i, Algebra Γ(Z, V) Γ(P, W i)] [∀ i j, Algebra Γ(Z, V) Γ(P, W i ⊓ W j)]
    (ρl : ∀ i j, Γ(P, W i) →ₐ[Γ(Z, V)] Γ(P, W i ⊓ W j))
    (ρr : ∀ i j, Γ(P, W j) →ₐ[Γ(Z, V)] Γ(P, W i ⊓ W j)),
    wcCnChartCompat p V W hW ρl ρr →
    ∀ (N : ℕ → Type u) [∀ n, AddCommGroup (N n)] [∀ n, Module Γ(Z, V) (N n)]
      (ψ : ∀ n, N (n + 1) →ₗ[Γ(Z, V)] N n),
    (∀ n, Module.Finite Γ(Z, V) (N n)) →
    (∀ n, ∀ a ∈ Ideal.map (wcCnSigma h V) (I ^ (n + 1)), ∀ x : N n, a • x = 0) →
    (∀ n, Function.Surjective (ψ n)) →
    (∀ n (x : N (n + 1)), ψ n x = 0 ↔
      x ∈ Ideal.map (wcCnSigma h V) (I ^ (n + 1)) • (⊤ : Submodule Γ(Z, V) (N (n + 1)))) →
    (∀ τ ∈ wcCnCechT (fun i => Γ(P, W i)) (fun i j => Γ(P, W i ⊓ W j)) ρl ρr (wcCnLimMod N ψ),
      (∀ n, (fun i => LinearMap.lTensor Γ(P, W i)
        ((LinearMap.proj (R := Γ(Z, V)) (φ := N) n).comp (wcCnLimMod N ψ).subtype) (τ i)) = 0) →
      τ = 0) ∧
    (∀ τs : ∀ n, ∀ i, TensorProduct Γ(Z, V) Γ(P, W i) (N n),
      (∀ n, τs n ∈ wcCnCechT (fun i => Γ(P, W i)) (fun i j => Γ(P, W i ⊓ W j)) ρl ρr (N n)) →
      (∀ n, (fun i => LinearMap.lTensor Γ(P, W i) (ψ n) (τs (n + 1) i)) = τs n) →
      ∃ τ ∈ wcCnCechT (fun i => Γ(P, W i)) (fun i j => Γ(P, W i ⊓ W j)) ρl ρr (wcCnLimMod N ψ),
        ∀ n, (fun i => LinearMap.lTensor Γ(P, W i)
          ((LinearMap.proj (R := Γ(Z, V)) (φ := N) n).comp (wcCnLimMod N ψ).subtype) (τ i)) =
          τs n) :=
by
  intro B _ _ I Z h _ P p m g hp hcl V hV r W hW _ _ ρl ρr hc N _ _ ψ hfin hkill hsurj hker
  haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian h
  haveI : IsNoetherianRing Γ(Z, V) := IsLocallyNoetherian.component_noetherian ⟨V, hV⟩
  obtain ⟨𝔞, h𝔞⟩ : ∃ 𝔞 : Ideal Γ(Z, V), 𝔞 = Ideal.map (wcCnSigma h V) I := ⟨_, rfl⟩
  have hmp : ∀ n, Ideal.map (wcCnSigma h V) (I ^ (n + 1)) = 𝔞 ^ (n + 1) := by
    intro n; rw [h𝔞]; exact Ideal.map_pow _ _ _
  have hkill' : ∀ n, ∀ a ∈ 𝔞 ^ (n + 1), ∀ x : N n, a • x = 0 := by
    intro n a ha x
    rw [← hmp] at ha
    exact hkill n a ha x
  have hker' : ∀ n (x : N (n + 1)), ψ n x = 0 ↔
      x ∈ 𝔞 ^ (n + 1) • (⊤ : Submodule Γ(Z, V) (N (n + 1))) := by
    intro n x
    rw [← hmp]
    exact hker n x
  obtain ⟨S, iS, aS, ι, π, hSn, hπι, hpr, hpker, hHC⟩ :=
    wc_adic_limit_sqzero_ring Γ(Z, V) 𝔞 N ψ hfin hkill' hsurj hker'
  letI := iS
  letI := aS
  haveI := hSn
  obtain ⟨c, h0, h1, hgen⟩ :=
    wc_cn_cech_ring_coeff_ar B Z h P p m g hp hcl V hV r W hW ρl ρr hc S 𝔞
  obtain ⟨a0, a1, ha, hco⟩ := wc_cech_ar_retract_transfer Γ(Z, V) 𝔞 r (fun i => Γ(P, W i))
    (fun i j => Γ(P, W i ⊓ W j)) ρl ρr S (wcCnLimMod N ψ) ι π c hπι h0 h1 hgen hHC
  exact wc_cech_formal_functions_of_ar Γ(Z, V) 𝔞 r (fun i => Γ(P, W i))
    (fun i j => Γ(P, W i ⊓ W j)) ρl ρr N ψ c hpr hpker a0 a1 ha hco

theorem wc_cn_unit_limit_local_iso : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B]
    [IsAdicComplete (IsLocalRing.maximalIdeal B) B] (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B))
    [IsProper h] (𝒦 : Z.IdealSheafData) (P : Scheme.{u}) (p : P ⟶ Z) (m : ℕ)
    (g : P ⟶ wcPm.{u} m) (U : Z.Opens),
    IsProper p → IsClosedImmersion (Limits.prod.lift (p ≫ h) g) →
    (∀ (V : Z.Opens) (hV : IsAffineOpen V), ∀ a ∈ 𝒦.ideal ⟨V, hV⟩, (p.app V).hom a = 0) →
    (∀ (V : Z.Opens) (hV : IsAffineOpen V), V ≤ U →
        IsAffineOpen (p ⁻¹ᵁ V) ∧ Function.Surjective (p.app V).hom ∧
        RingHom.ker (p.app V).hom = 𝒦.ideal ⟨V, hV⟩) →
    ∀ (Fs : ℕ → Z.Modules) (ψ : ∀ n, Fs (n + 1) ⟶ Fs n),
    wcCnAdicSys h (IsLocalRing.maximalIdeal B) Fs ψ → (∀ n, wcCnKilled 𝒦 (Fs n)) →
    wcCnAdicSys (p ≫ h) (IsLocalRing.maximalIdeal B) (fun n => (Scheme.Modules.pullback p).obj (Fs n))
      (fun n => (Scheme.Modules.pullback p).map (ψ n)) →
    ∀ (V : Z.Opens) (hV : IsAffineOpen V), ∀ f ∈ (wcCnComplIdeal U).ideal ⟨V, hV⟩,
    (∀ x : ∀ n, Γ(Fs n, V), (∀ n, Scheme.Modules.Hom.app (ψ n) V (x (n + 1)) = x n) →
      (∀ n, Scheme.Modules.Hom.app
        ((Scheme.Modules.pullbackPushforwardAdjunction p).unit.app (Fs n)) V (x n) = 0) →
      ∃ e : ℕ, ∀ n, f ^ e • x n = 0) ∧
    (∀ z : ∀ n, Γ((Scheme.Modules.pushforward p).obj ((Scheme.Modules.pullback p).obj (Fs n)), V),
      (∀ n, Scheme.Modules.Hom.app ((Scheme.Modules.pushforward p).map
        ((Scheme.Modules.pullback p).map (ψ n))) V (z (n + 1)) = z n) →
      ∃ (e : ℕ) (x : ∀ n, Γ(Fs n, V)), (∀ n, Scheme.Modules.Hom.app (ψ n) V (x (n + 1)) = x n) ∧
        ∀ n, Scheme.Modules.Hom.app
          ((Scheme.Modules.pullbackPushforwardAdjunction p).unit.app (Fs n)) V (x n) = f ^ e • z n) :=
by
  intro B _ _ _ _ Z h _ 𝒦 P p m g U hp hcl hkill hiso Fs ψ hF hK hF' V hV f hf

  obtain ⟨r, W, hW, hWa, hWc, hWi⟩ := wc_cn_chart_cech_cover B Z h P p m g hcl V hV
  letI iA : ∀ i, Algebra Γ(Z, V) Γ(P, W i) := fun i => (p.appLE V (W i) (hW i)).hom.toAlgebra
  letI iA2 : ∀ i j, Algebra Γ(Z, V) Γ(P, W i ⊓ W j) := fun i j =>
    (p.appLE V (W i ⊓ W j) (le_trans inf_le_left (hW i))).hom.toAlgebra
  let ρl : ∀ i j, Γ(P, W i) →ₐ[Γ(Z, V)] Γ(P, W i ⊓ W j) := fun i j =>
    { toRingHom := (P.presheaf.map (homOfLE (inf_le_left : W i ⊓ W j ≤ W i)).op).hom
      commutes' := fun a => by
        have := congrArg (fun φ => φ.hom a)
          (p.appLE_map (hW i) (homOfLE (inf_le_left : W i ⊓ W j ≤ W i)).op)
        exact this }
  let ρr : ∀ i j, Γ(P, W j) →ₐ[Γ(Z, V)] Γ(P, W i ⊓ W j) := fun i j =>
    { toRingHom := (P.presheaf.map (homOfLE (inf_le_right : W i ⊓ W j ≤ W j)).op).hom
      commutes' := fun a => by
        have := congrArg (fun φ => φ.hom a)
          (p.appLE_map (hW j) (homOfLE (inf_le_right : W i ⊓ W j ≤ W j)).op)
        exact this }
  have hc : wcCnChartCompat p V W hW ρl ρr :=
    ⟨hWa, hWc, hWi, fun i a => rfl, fun i j a => rfl, fun i j a => rfl, fun i j a => rfl⟩

  have hcT : ∀ (L : Type u) [AddCommGroup L] [Module Γ(Z, V) L] (x : L),
      (fun i => (1 : Γ(P, W i)) ⊗ₜ[Γ(Z, V)] x) ∈
        wcCnCechT (fun i => Γ(P, W i)) (fun i j => Γ(P, W i ⊓ W j)) ρl ρr L := by
    intro L _ _ x i j
    simp only [LinearMap.rTensor_tmul, AlgHom.toLinearMap_apply, map_one]

  have hκ1 := fun n i => wc_cn_pb_affine_tensor_sections Z P p (Fs n) (hF.1 n).1 V (W i) hV
    (hWa i) (hW i)
  have hκ2 := fun n i j => wc_cn_pb_affine_tensor_sections Z P p (Fs n) (hF.1 n).1 V (W i ⊓ W j)
    hV (hWi i j) (le_trans inf_le_left (hW i))
  obtain ⟨Φ, hΦinj, hΦT, -, hΦη, hΦψ⟩ :=
    wc_cn_cech_gluing_iso Z P p V r W hW ρl ρr hc Fs ψ hκ1 hκ2

  have hkF : ∀ n, ∀ a ∈ Ideal.map (wcCnSigma h V) (IsLocalRing.maximalIdeal B ^ (n + 1)),
      ∀ x : Γ(Fs n, V), a • x = 0 := by
    intro n a ha x
    have h1 := hF.2.2 n V hV
    have h2 : a • x ∈ Ideal.map (wcCnSigma h V) (IsLocalRing.maximalIdeal B ^ (n + 1)) •
        (⊤ : Submodule Γ(Z, V) Γ(Fs n, V)) :=
      Submodule.smul_mem_smul ha Submodule.mem_top
    rw [h1] at h2
    exact (Submodule.mem_bot _).mp h2
  obtain ⟨hFFinj, hFFsurj⟩ := wc_cn_cech_formal_functions B (IsLocalRing.maximalIdeal B) Z h P p m g
    hp hcl V hV r W hW ρl ρr hc (fun n => Γ(Fs n, V)) (fun n => wcCnSecLin (ψ n) V)
    (fun n => (hF.1 n).2 V hV) hkF (fun n => (hF.2.1 n V hV).1) (fun n x => (hF.2.1 n V hV).2 x)

  have hDU : Z.basicOpen f ≤ U := by
    intro y hy
    by_contra hyU
    have hyV : y ∈ Set.range hV.fromSpec := by
      rw [hV.range_fromSpec]
      exact Z.basicOpen_le f hy
    obtain ⟨q, rfl⟩ := hyV
    have h1 : q ∈ hV.fromSpec ⁻¹ᵁ Z.basicOpen f := hy
    rw [hV.fromSpec_preimage_basicOpen] at h1
    have h2 := hf
    change f ∈ (Scheme.IdealSheafData.vanishingIdeal _).ideal ⟨V, hV⟩ at h2
    rw [Scheme.IdealSheafData.vanishingIdeal_ideal] at h2
    exact (PrimeSpectrum.mem_basicOpen _ _).mp h1
      ((PrimeSpectrum.mem_vanishingIdeal _ _).mp h2 q hyU)
  obtain ⟨H1, H2, Hker⟩ := hiso (Z.basicOpen f) (hV.basicOpen f) hDU
  have H3 : RingHom.ker (p.app (Z.basicOpen f)).hom =
      Ideal.map (Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom (𝒦.ideal ⟨V, hV⟩) := by
    rw [Hker]
    exact (𝒦.map_ideal_basicOpen ⟨V, hV⟩ f).symm

  have hbij : Function.Bijective (fun y : LocalizedModule (Submonoid.powers f)
      (wcCnLimMod (fun n => Γ(Fs n, V)) (fun n => wcCnSecLin (ψ n) V)) => f • y) := by
    have h1 := IsLocalizedModule.map_units (LocalizedModule.mkLinearMap (Submonoid.powers f)
      (wcCnLimMod (fun n => Γ(Fs n, V)) (fun n => wcCnSecLin (ψ n) V))) ⟨f, Submonoid.mem_powers f⟩
    have h2 := (Module.End.isUnit_iff _).mp h1
    convert h2 using 1
  have hkM : ∀ a ∈ 𝒦.ideal ⟨V, hV⟩, ∀ y : LocalizedModule (Submonoid.powers f)
      (wcCnLimMod (fun n => Γ(Fs n, V)) (fun n => wcCnSecLin (ψ n) V)), a • y = 0 := by
    intro a ha y
    refine LocalizedModule.induction_on (fun x s => ?_) y
    have hx : a • x = 0 := by
      apply Subtype.ext
      funext n
      exact hK n V hV a ha (x.1 n)
    rw [LocalizedModule.smul'_mk, hx, LocalizedModule.zero_mk]

  obtain ⟨hcMinj, hcMsurj⟩ := wc_cn_cech_exact_over_basicOpen Z P p V hV r W hW ρl ρr hc f
    (𝒦.ideal ⟨V, hV⟩) H1 H2 H3 (hkill V hV) (LocalizedModule (Submonoid.powers f)
      (wcCnLimMod (fun n => Γ(Fs n, V)) (fun n => wcCnSecLin (ψ n) V))) hbij
    (fun a ha y => by exact hkM a ha y)
  obtain ⟨hLi, hLii⟩ := wc_cech_tensor_localization Γ(Z, V) r (fun i => Γ(P, W i))
    (fun i j => Γ(P, W i ⊓ W j)) ρl ρr f _ hcMinj hcMsurj
  refine ⟨fun x hx hx0 => ?_, fun z hz => ?_⟩
  ·
    let xL : wcCnLimMod (fun n => Γ(Fs n, V)) (fun n => wcCnSecLin (ψ n) V) := ⟨x, fun n => hx n⟩
    have hcx : (fun i => (1 : Γ(P, W i)) ⊗ₜ[Γ(Z, V)] xL) = 0 := by
      refine hFFinj _ (hcT _ xL) (fun n => ?_)
      have e1 : (fun i => LinearMap.lTensor Γ(P, W i)
          ((LinearMap.proj (R := Γ(Z, V)) (φ := fun n => Γ(Fs n, V)) n).comp
            (wcCnLimMod (fun n => Γ(Fs n, V)) (fun n => wcCnSecLin (ψ n) V)).subtype)
          ((1 : Γ(P, W i)) ⊗ₜ[Γ(Z, V)] xL)) = fun i => (1 : Γ(P, W i)) ⊗ₜ[Γ(Z, V)] x n := by
        funext i
        simp only [LinearMap.lTensor_tmul]
        rfl
      rw [e1, ← hΦη n (x n), hx0 n, map_zero]
    obtain ⟨e, he⟩ := hLi xL hcx
    refine ⟨e, fun n => ?_⟩
    have := congrArg (fun y : wcCnLimMod (fun n => Γ(Fs n, V)) (fun n => wcCnSecLin (ψ n) V) =>
      (y : ∀ n, Γ(Fs n, V)) n) he
    exact this
  ·
    have hτsc : ∀ n, (fun i => LinearMap.lTensor Γ(P, W i) (wcCnSecLin (ψ n) V)
        (Φ (n + 1) (z (n + 1)) i)) = Φ n (z n) := by
      intro n
      rw [← hΦψ n (z (n + 1)), hz n]
    obtain ⟨τ, hτT, hτ⟩ := hFFsurj (fun n => Φ n (z n)) (fun n => hΦT n (z n)) hτsc
    obtain ⟨e, xL, hxL⟩ := hLii τ hτT
    refine ⟨e, fun n => xL.1 n, fun n => xL.2 n, fun n => ?_⟩
    apply hΦinj n
    rw [hΦη n, map_smul]
    have hτn : (fun i => LinearMap.lTensor Γ(P, W i)
        ((LinearMap.proj (R := Γ(Z, V)) (φ := fun n => Γ(Fs n, V)) n).comp
          (wcCnLimMod (fun n => Γ(Fs n, V)) (fun n => wcCnSecLin (ψ n) V)).subtype) (τ i)) =
        Φ n (z n) := hτ n
    calc (fun i => (1 : Γ(P, W i)) ⊗ₜ[Γ(Z, V)] xL.1 n)
        = fun i => LinearMap.lTensor Γ(P, W i)
            ((LinearMap.proj (R := Γ(Z, V)) (φ := fun n => Γ(Fs n, V)) n).comp
              (wcCnLimMod (fun n => Γ(Fs n, V)) (fun n => wcCnSecLin (ψ n) V)).subtype)
            ((fun i => (1 : Γ(P, W i)) ⊗ₜ[Γ(Z, V)] xL) i) := by
          funext i
          simp only [LinearMap.lTensor_tmul]
          rfl
      _ = fun i => LinearMap.lTensor Γ(P, W i)
            ((LinearMap.proj (R := Γ(Z, V)) (φ := fun n => Γ(Fs n, V)) n).comp
              (wcCnLimMod (fun n => Γ(Fs n, V)) (fun n => wcCnSecLin (ψ n) V)).subtype)
            ((f ^ e • τ) i) := by rw [hxL]
      _ = f ^ e • fun i => LinearMap.lTensor Γ(P, W i)
            ((LinearMap.proj (R := Γ(Z, V)) (φ := fun n => Γ(Fs n, V)) n).comp
              (wcCnLimMod (fun n => Γ(Fs n, V)) (fun n => wcCnSecLin (ψ n) V)).subtype) (τ i) := by
          funext i
          simp only [Pi.smul_apply, map_smul]
      _ = f ^ e • Φ n (z n) := by rw [hτn]

theorem wc_cn_comparison_limit_bound : wcCnFormalFns.{u} →
    ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B]
    [IsAdicComplete (IsLocalRing.maximalIdeal B) B] (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B))
    [IsProper h] (𝒦 : Z.IdealSheafData) (P : Scheme.{u}) (p : P ⟶ Z) (m : ℕ)
    (g : P ⟶ wcPm.{u} m) (U : Z.Opens),
    IsProper p → IsClosedImmersion (Limits.prod.lift (p ≫ h) g) →
    (∀ (V : Z.Opens) (hV : IsAffineOpen V), ∀ a ∈ 𝒦.ideal ⟨V, hV⟩, (p.app V).hom a = 0) →
    (∀ (V : Z.Opens) (hV : IsAffineOpen V), V ≤ U →
        IsAffineOpen (p ⁻¹ᵁ V) ∧ Function.Surjective (p.app V).hom ∧
        RingHom.ker (p.app V).hom = 𝒦.ideal ⟨V, hV⟩) →
    ∀ (Fs : ℕ → Z.Modules) (ψ : ∀ n, Fs (n + 1) ⟶ Fs n),
    wcCnAdicSys h (IsLocalRing.maximalIdeal B) Fs ψ → (∀ n, wcCnKilled 𝒦 (Fs n)) →
    ∀ (F'' : P.Modules) (φ'' : ∀ n, F'' ⟶ (Scheme.Modules.pullback p).obj (Fs n)),
    wcCnAdicSys (p ≫ h) (IsLocalRing.maximalIdeal B) (fun n => (Scheme.Modules.pullback p).obj (Fs n))
      (fun n => (Scheme.Modules.pullback p).map (ψ n)) →
    wcCnAlg (p ≫ h) (IsLocalRing.maximalIdeal B) (fun n => (Scheme.Modules.pullback p).obj (Fs n))
      (fun n => (Scheme.Modules.pullback p).map (ψ n)) F'' φ'' →
    ∀ (Hs : ℕ → Z.Modules) (ψH : ∀ n, Hs (n + 1) ⟶ Hs n)
      (φH : ∀ n, (Scheme.Modules.pushforward p).obj F'' ⟶ Hs n),
    wcCnAdicSys h (IsLocalRing.maximalIdeal B) Hs ψH →
    wcCnAlg h (IsLocalRing.maximalIdeal B) Hs ψH ((Scheme.Modules.pushforward p).obj F'') φH →
    ∀ α : ∀ n, Fs n ⟶ Hs n, (∀ n, α (n + 1) ≫ ψH n = ψ n ≫ α n) →
    wcCnUnitRel p Fs F'' φ'' Hs φH α →
    ∀ (V : Z.Opens) (hV : IsAffineOpen V), ∃ t : ℕ,
      wcCnLimBound Fs Hs ψ ψH α V ((wcCnComplIdeal U).ideal ⟨V, hV⟩) t :=
by
  intro hFF B _ _ _ _ Z h _ 𝒦 P p m g U hp hcl hkill hiso Fs ψ hF hK F'' φ'' hF' hF'' Hs ψH φH
    hHs hHalg α hα hR V hV
  haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian h
  haveI : IsNoetherianRing Γ(Z, V) := IsLocallyNoetherian.component_noetherian ⟨V, hV⟩
  have hcomp : ∀ {A A' A'' : Z.Modules} (f : A ⟶ A') (g' : A' ⟶ A'') (x : Γ(A, V)),
      Scheme.Modules.Hom.app (f ≫ g') V x =
        Scheme.Modules.Hom.app g' V (Scheme.Modules.Hom.app f V x) := by
    intro A A' A'' f g' x
    rw [Scheme.Modules.Hom.comp_app]; rfl
  obtain ⟨𝔞, h𝔞⟩ : ∃ 𝔞 : Ideal Γ(Z, V),
      𝔞 = Ideal.map (wcCnSigma h V) (IsLocalRing.maximalIdeal B) := ⟨_, rfl⟩
  have hmp : ∀ n, Ideal.map (wcCnSigma h V) (IsLocalRing.maximalIdeal B ^ (n + 1)) =
      𝔞 ^ (n + 1) := by
    intro n; rw [h𝔞]; exact Ideal.map_pow _ _ _
  have hkF : ∀ n, ∀ a ∈ 𝔞 ^ (n + 1), ∀ x : Γ(Fs n, V), a • x = 0 := by
    intro n a ha x
    have h1 := hF.2.2 n V hV
    rw [hmp] at h1
    have h2 : a • x ∈ 𝔞 ^ (n + 1) • (⊤ : Submodule Γ(Z, V) Γ(Fs n, V)) :=
      Submodule.smul_mem_smul ha Submodule.mem_top
    rw [h1] at h2
    exact (Submodule.mem_bot _).mp h2
  have hkH : ∀ n, ∀ a ∈ 𝔞 ^ (n + 1), ∀ x : Γ(Hs n, V), a • x = 0 := by
    intro n a ha x
    have h1 := hHs.2.2 n V hV
    rw [hmp] at h1
    have h2 : a • x ∈ 𝔞 ^ (n + 1) • (⊤ : Submodule Γ(Z, V) Γ(Hs n, V)) :=
      Submodule.smul_mem_smul ha Submodule.mem_top
    rw [h1] at h2
    exact (Submodule.mem_bot _).mp h2
  let L : ∀ {A A' : Z.Modules}, (A ⟶ A') → (Γ(A, V) →ₗ[Γ(Z, V)] Γ(A', V)) := fun f =>
    { toFun := fun x => Scheme.Modules.Hom.app f V x
      map_add' := fun x y => map_add _ x y
      map_smul' := fun r x => Scheme.Modules.Hom.app_smul f r x }

  have hA1 : ∀ k (s : Γ((Scheme.Modules.pushforward p).obj F'', V)),
      Scheme.Modules.Hom.app (φH k) V s = 0 →
      Scheme.Modules.Hom.app ((Scheme.Modules.pushforward p).map (φ'' k)) V s = 0 := by
    intro k s hs
    have h1 := hR V hV k 0 s (by rw [hs, map_zero])
    rw [h1, map_zero]

  have hA2 : ∀ n (s : Γ((Scheme.Modules.pushforward p).obj F'', V)),
      Scheme.Modules.Hom.app ((Scheme.Modules.pushforward p).map
          ((Scheme.Modules.pullback p).map (ψ n))) V
        (Scheme.Modules.Hom.app ((Scheme.Modules.pushforward p).map (φ'' (n + 1))) V s) =
      Scheme.Modules.Hom.app ((Scheme.Modules.pushforward p).map (φ'' n)) V s := by
    intro n s
    rw [← hcomp, ← Functor.map_comp]
    exact congrArg (fun f => Scheme.Modules.Hom.app ((Scheme.Modules.pushforward p).map f) V s)
      (hF''.2.1 n)

  have hA3 : ∀ n (x : Γ(Fs n, V)), Scheme.Modules.Hom.app (α n) V x = 0 →
      Scheme.Modules.Hom.app ((Scheme.Modules.pullbackPushforwardAdjunction p).unit.app (Fs n))
        V x = 0 := by
    intro n x hx
    rw [← hR V hV n x 0 (by rw [hx, map_zero]), map_zero]

  obtain ⟨c, hc⟩ := wc_cn_relative_ml B (IsLocalRing.maximalIdeal B) Z h P p m g hp hcl _ _ F''
    φ'' hF' hF''

  have hzc : ∀ (y : ∀ n, Γ(Hs n, V)) (s : ∀ _ : ℕ, Γ((Scheme.Modules.pushforward p).obj F'', V)),
      (∀ n, Scheme.Modules.Hom.app (ψH n) V (y (n + 1)) = y n) →
      (∀ n, Scheme.Modules.Hom.app (φH n) V (s n) = y n) →
      ∀ n, Scheme.Modules.Hom.app ((Scheme.Modules.pushforward p).map
          ((Scheme.Modules.pullback p).map (ψ n))) V
        (Scheme.Modules.Hom.app ((Scheme.Modules.pushforward p).map (φ'' (n + 1))) V (s (n + 1))) =
      Scheme.Modules.Hom.app ((Scheme.Modules.pushforward p).map (φ'' n)) V (s n) := by
    intro y s hy hs n
    rw [hA2]
    have e : Scheme.Modules.Hom.app (φH n) V (s (n + 1)) = y n := by
      rw [← hHalg.2.1 n, hcomp, hs, hy]
    have h1 : Scheme.Modules.Hom.app (φH n) V (s (n + 1) - s n) = 0 := by
      rw [map_sub, e, hs, sub_self]
    have h2 := hA1 n _ h1
    rw [map_sub, sub_eq_zero] at h2
    exact h2

  have keyC : ∀ (y : ∀ n, Γ(Hs n, V)) (s : ∀ _ : ℕ, Γ((Scheme.Modules.pushforward p).obj F'', V)),
      (∀ n, Scheme.Modules.Hom.app (ψH n) V (y (n + 1)) = y n) →
      (∀ n, Scheme.Modules.Hom.app (φH n) V (s n) = y n) →
      ∀ (x : ∀ n, Γ(Fs n, V)) (a : Γ(Z, V)),
      (∀ n, Scheme.Modules.Hom.app (ψ n) V (x (n + 1)) = x n) →
      (∀ n, Scheme.Modules.Hom.app ((Scheme.Modules.pullbackPushforwardAdjunction p).unit.app (Fs n))
          V (x n) = a • Scheme.Modules.Hom.app ((Scheme.Modules.pushforward p).map (φ'' n)) V (s n)) →
      ∀ n, Scheme.Modules.Hom.app (α n) V (x n) = a • y n := by
    intro y s hy hs x a hx hxz n
    obtain ⟨w, hw⟩ : ∃ w : ∀ k, Γ(Hs k, V),
        ∀ k, w k = Scheme.Modules.Hom.app (α k) V (x k) - a • y k := ⟨_, fun _ => rfl⟩
    have hwc : ∀ k, Scheme.Modules.Hom.app (ψH k) V (w (k + 1)) = w k := by
      intro k
      rw [hw, hw, map_sub, Scheme.Modules.Hom.app_smul, hy, ← hcomp, hα k, hcomp, hx]
    have hwlift : ∀ k, ∃ s' : Γ((Scheme.Modules.pushforward p).obj F'', V),
        Scheme.Modules.Hom.app (φH k) V s' = w k ∧
        Scheme.Modules.Hom.app ((Scheme.Modules.pushforward p).map (φ'' k)) V s' = 0 := by
      intro k
      obtain ⟨s1, hs1⟩ := (hHalg.2.2 k V hV).1 (Scheme.Modules.Hom.app (α k) V (x k))
      refine ⟨s1 - a • s k, ?_, ?_⟩
      · rw [hw, map_sub, Scheme.Modules.Hom.app_smul, hs1, hs]
      · rw [map_sub, Scheme.Modules.Hom.app_smul, hR V hV k (x k) s1 hs1, hxz k, sub_self]
    obtain ⟨s', hs'1, hs'2⟩ := hwlift (n + c)
    have hmem := (hc V hV n).1 s' hs'2
    have h0 : Scheme.Modules.Hom.app (φH n) V s' = 0 := ((hHalg.2.2 n V hV).2 s').mpr hmem
    have hdesc : ∀ j, Scheme.Modules.Hom.app (φH (n + j)) V s' = w (n + j) →
        Scheme.Modules.Hom.app (φH n) V s' = w n := by
      intro j
      induction j with
      | zero => exact id
      | succ j ih =>
        intro hj
        have hj' : Scheme.Modules.Hom.app (φH (n + j + 1)) V s' = w (n + j + 1) := hj
        apply ih
        rw [← hwc (n + j), ← hj', ← hcomp, hHalg.2.1 (n + j)]
    have hwn : w n = 0 := (hdesc c hs'1).symm.trans h0
    rw [hw] at hwn
    exact sub_eq_zero.mp hwn

  obtain ⟨AnnK, hAnnK⟩ : ∃ I : Ideal Γ(Z, V), ∀ a, a ∈ I ↔ ∀ x : ∀ n, Γ(Fs n, V),
      (∀ n, Scheme.Modules.Hom.app (ψ n) V (x (n + 1)) = x n) →
      (∀ n, Scheme.Modules.Hom.app (α n) V (x n) = 0) → ∀ n, a • x n = 0 :=
    ⟨{ carrier := {a | ∀ x : ∀ n, Γ(Fs n, V),
          (∀ n, Scheme.Modules.Hom.app (ψ n) V (x (n + 1)) = x n) →
          (∀ n, Scheme.Modules.Hom.app (α n) V (x n) = 0) → ∀ n, a • x n = 0},
       add_mem' := by
          intro a b ha hb x hx hx0 n
          rw [add_smul, ha x hx hx0 n, hb x hx hx0 n, add_zero],
       zero_mem' := by
          intro x _ _ n
          exact zero_smul _ _,
       smul_mem' := by
          intro c' a ha x hx hx0 n
          rw [smul_eq_mul, mul_smul, ha x hx hx0 n, smul_zero] }, fun a => Iff.rfl⟩
  obtain ⟨ColC, hColC⟩ : ∃ I : Ideal Γ(Z, V), ∀ a, a ∈ I ↔ ∀ y : ∀ n, Γ(Hs n, V),
      (∀ n, Scheme.Modules.Hom.app (ψH n) V (y (n + 1)) = y n) →
      ∃ x : ∀ n, Γ(Fs n, V), (∀ n, Scheme.Modules.Hom.app (ψ n) V (x (n + 1)) = x n) ∧
        ∀ n, Scheme.Modules.Hom.app (α n) V (x n) = a • y n :=
    ⟨{ carrier := {a | ∀ y : ∀ n, Γ(Hs n, V),
          (∀ n, Scheme.Modules.Hom.app (ψH n) V (y (n + 1)) = y n) →
          ∃ x : ∀ n, Γ(Fs n, V), (∀ n, Scheme.Modules.Hom.app (ψ n) V (x (n + 1)) = x n) ∧
            ∀ n, Scheme.Modules.Hom.app (α n) V (x n) = a • y n},
       add_mem' := by
          intro a b ha hb y hy
          obtain ⟨x, hx, hxa⟩ := ha y hy
          obtain ⟨x', hx', hxb⟩ := hb y hy
          refine ⟨fun n => x n + x' n, fun n => ?_, fun n => ?_⟩
          · beta_reduce; rw [map_add, hx, hx']
          · beta_reduce; rw [map_add, hxa, hxb, add_smul],
       zero_mem' := by
          intro y hy
          refine ⟨fun n => 0, fun n => ?_, fun n => ?_⟩
          · beta_reduce; rw [map_zero]
          · beta_reduce; rw [map_zero, zero_smul],
       smul_mem' := by
          intro c' a ha y hy
          obtain ⟨x, hx, hxa⟩ := ha y hy
          refine ⟨fun n => c' • x n, fun n => ?_, fun n => ?_⟩
          · beta_reduce; rw [Scheme.Modules.Hom.app_smul, hx]
          · beta_reduce; rw [Scheme.Modules.Hom.app_smul, hxa, smul_eq_mul, mul_smul] },
      fun a => Iff.rfl⟩

  have hKer : ∀ f ∈ (wcCnComplIdeal U).ideal ⟨V, hV⟩, ∃ e : ℕ, f ^ e ∈ AnnK := by
    intro f hf
    have hloc := (wc_cn_unit_limit_local_iso B Z h 𝒦 P p m g U hp hcl hkill hiso Fs ψ hF hK hF'
      V hV f hf).1
    obtain ⟨k, gen, hgen, hdec⟩ := wc_adic_limit_submodule_fg Γ(Z, V) 𝔞 (fun n => Γ(Fs n, V))
      (fun n => L (ψ n)) (fun n => (hF.1 n).2 V hV) hkF (fun n => (hF.2.1 n V hV).1)
      (fun n x => by rw [← hmp]; exact (hF.2.1 n V hV).2 x)
      {x | (∀ n, Scheme.Modules.Hom.app (ψ n) V (x (n + 1)) = x n) ∧
        ∀ n, Scheme.Modules.Hom.app
          ((Scheme.Modules.pullbackPushforwardAdjunction p).unit.app (Fs n)) V (x n) = 0}
      (fun x hx => hx.1)
      (by
        simp only [Set.mem_setOf_eq]
        exact ⟨fun n => by simp only [Pi.zero_apply, map_zero],
          fun n => by simp only [Pi.zero_apply, map_zero]⟩)
      (by
        intro x hx y hy
        simp only [Set.mem_setOf_eq] at hx hy ⊢
        exact ⟨fun n => by simp only [Pi.add_apply, map_add, hx.1, hy.1],
          fun n => by simp only [Pi.add_apply, map_add, hx.2, hy.2, add_zero]⟩)
      (by
        intro x hx d hd
        simp only [Set.mem_setOf_eq] at hx ⊢
        refine ⟨fun n => ?_, fun n => ?_⟩
        · rw [Scheme.Modules.Hom.app_smul, hx.1 n, ← sub_eq_zero, ← sub_smul]
          exact hkF n _ (hd n) _
        · rw [Scheme.Modules.Hom.app_smul, hx.2 n, smul_zero])
    choose e he using fun i => hloc (gen i) (hgen i).1 (hgen i).2
    have hle : ∀ i, e i ≤ ∑ j, e j := fun i =>
      Finset.single_le_sum (fun j _ => Nat.zero_le (e j)) (Finset.mem_univ i)
    have hfe : ∀ i, f ^ (∑ j, e j - e i) * f ^ e i = f ^ (∑ j, e j) := fun i => by
      rw [← pow_add, Nat.sub_add_cancel (hle i)]
    refine ⟨∑ i, e i, (hAnnK _).mpr ?_⟩
    intro x hx hx0 n
    have hxK : x ∈ {x : ∀ n, Γ(Fs n, V) | (∀ n, Scheme.Modules.Hom.app (ψ n) V (x (n + 1)) = x n) ∧
        ∀ n, Scheme.Modules.Hom.app
          ((Scheme.Modules.pullbackPushforwardAdjunction p).unit.app (Fs n)) V (x n) = 0} := by
      simp only [Set.mem_setOf_eq]
      exact ⟨hx, fun n => hA3 n (x n) (hx0 n)⟩
    obtain ⟨d, -, hxd⟩ := hdec x hxK
    rw [hxd n, Finset.smul_sum]
    refine Finset.sum_eq_zero (fun i _ => ?_)
    rw [smul_comm, ← hfe i, mul_smul, he i n]
    simp only [smul_zero]

  have hCok : ∀ f ∈ (wcCnComplIdeal U).ideal ⟨V, hV⟩, ∃ e : ℕ, f ^ e ∈ ColC := by
    intro f hf
    have hloc := (wc_cn_unit_limit_local_iso B Z h 𝒦 P p m g U hp hcl hkill hiso Fs ψ hF hK hF'
      V hV f hf).2
    obtain ⟨k, yg, hyg, hdec⟩ := wc_adic_limit_submodule_fg Γ(Z, V) 𝔞 (fun n => Γ(Hs n, V))
      (fun n => L (ψH n)) (fun n => (hHs.1 n).2 V hV) hkH (fun n => (hHs.2.1 n V hV).1)
      (fun n x => by rw [← hmp]; exact (hHs.2.1 n V hV).2 x)
      {y | ∀ n, Scheme.Modules.Hom.app (ψH n) V (y (n + 1)) = y n}
      (fun y hy => hy)
      (by
        simp only [Set.mem_setOf_eq]
        exact fun n => by simp only [Pi.zero_apply, map_zero])
      (by
        intro x hx y hy
        simp only [Set.mem_setOf_eq] at hx hy ⊢
        exact fun n => by simp only [Pi.add_apply, map_add, hx, hy])
      (by
        intro x hx d hd
        simp only [Set.mem_setOf_eq] at hx ⊢
        intro n
