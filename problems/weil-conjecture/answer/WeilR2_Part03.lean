      have hR' : wcSmeGen U T' R =
          (((presheafToSheaf J AddCommGrpCat.{u+1}).obj PU).obj.map d.op).hom γ := hR
      rw [← hR']
      have h0 := hK T' d R hR'
      have hnat := congrArg (fun φ => (φ.app (Opposite.op T')).hom R) (toSheafify_naturality J τ₀)
      simp only [NatTrans.comp_app, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at hnat
      change (τ.hom.app (Opposite.op T')).hom ((toSheafify J PU).app (Opposite.op T') |>.hom R) = 0
