      (E.obj.map γ.op).hom
        ((f.hom.app (Opposite.op (wcTorsorEt (Limits.pullback.fst p p ≫ p) hp2))).hom
          ((ρ.hom.app (Opposite.op (wcTorsorEt (Limits.pullback.fst p p ≫ p) hp2))).hom d))
    rw [map_sub, e1, e2, hs c, add_sub_cancel_left, ← n1, ← n2, hd c γ hγ]

  have hcov : S ∈ Scheme.smallEtaleTopology X (wcTorsorEt (Limits.pullback.fst p p ≫ p) hp2) := by
    change S ∈ Scheme.smallGrothendieckTopology @Etale X _
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro v
    have hv : v ∈ ⋃ c, Set.range (Limits.pullback.lift (a c) (𝟙 V)
        ((ht.act_p c).trans (Category.id_comp p).symm)) := by
      rw [ht.graph_cover]; exact Set.mem_univ _
    obtain ⟨c, w, hw⟩ := Set.mem_iUnion.mp hv
    let Γ : wcTorsorEt p ht.etale ⟶ wcTorsorEt (Limits.pullback.fst p p ≫ p) hp2 :=
      MorphismProperty.Over.homMk
        (Limits.pullback.lift (a c) (𝟙 V) ((ht.act_p c).trans (Category.id_comp p).symm))
        ((Limits.pullback.lift_fst_assoc _ _ _ p).trans (ht.act_p c)) trivial
    have hEt : Etale Γ.left := by
      change Etale (Limits.pullback.lift (a c) (𝟙 V) ((ht.act_p c).trans (Category.id_comp p).symm))
      haveI := ht.graph_open c
      infer_instance
    exact ⟨_, Γ, w, hgraph c Γ rfl, hEt, hw⟩
  exact Sheaf.isSeparated E _ S hcov _ _ (fun _ _ hh => hh)

theorem wc_et_fet_torsor_class : ∀ (X V : Scheme.{u}) (p : V ⟶ X) (m : ℕ) (a : ZMod m → (V ⟶ V))
    (ht : wcFetTorsor p m a), m ≠ 0 →
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
    ∃ η : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)))
        ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) 1,
      ∀ (G E : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
        (ρ : (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ⟶ G) (f : G ⟶ E)
        (g : E ⟶ (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} ℤ))) (w : f ≫ g = 0)
        (hS : (ShortComplex.mk f g w).ShortExact)
        (s : E.obj.obj (Opposite.op (wcTorsorEt p ht.etale))),
        wcSplitRel ht ρ f g s → hS.extClass = η.comp (Abelian.Ext.mk₀ ρ) (add_zero 1) :=
by
  intro X V p m a ht _hm
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _

  have yon : ∀ (Y : X.Etale) (F : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
      (e : F.obj.obj (Opposite.op Y)),
      ∃ φ : wcFtcFS X Y ⟶ F, (φ.hom.app (Opposite.op Y)).hom (wcFtcGen X Y) = e := by
    intro Y F e
    let σ0 : yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ F.obj :=
      { app := fun W => AddCommGrpCat.ofHom (FreeAbelianGroup.lift
          (fun t : ULift.{u+1} (W.unop ⟶ Y) => (F.obj.map t.down.op).hom e))
        naturality := by
          intro W W' h
          apply AddCommGrpCat.hom_ext
          refine FreeAbelianGroup.lift_ext _ _ (fun t => ?_)
          have key : ((yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map h).hom
              (FreeAbelianGroup.of t) = FreeAbelianGroup.of (ULift.up (h.unop ≫ t.down)) := rfl
          have e1 : (FreeAbelianGroup.lift (fun t : ULift.{u+1} (W'.unop ⟶ Y) => (F.obj.map t.down.op).hom e))
              (FreeAbelianGroup.of (ULift.up (h.unop ≫ t.down))) =
              (F.obj.map (h.unop ≫ t.down).op).hom e := FreeAbelianGroup.lift_apply_of _ _
          have e2 : (FreeAbelianGroup.lift (fun t : ULift.{u+1} (W.unop ⟶ Y) => (F.obj.map t.down.op).hom e))
              (FreeAbelianGroup.of t) = (F.obj.map t.down.op).hom e := FreeAbelianGroup.lift_apply_of _ _
          change (FreeAbelianGroup.lift (fun t : ULift.{u+1} (W'.unop ⟶ Y) => (F.obj.map t.down.op).hom e))
              (((yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map h).hom
                (FreeAbelianGroup.of t)) =
            (F.obj.map h).hom ((FreeAbelianGroup.lift
              (fun t : ULift.{u+1} (W.unop ⟶ Y) => (F.obj.map t.down.op).hom e)) (FreeAbelianGroup.of t))
          rw [key]
          refine e1.trans (Eq.trans ?_ (congrArg (fun z => (F.obj.map h).hom z) e2).symm)
          rw [op_comp, CategoryTheory.Functor.map_comp]
          rfl }
    refine ⟨ObjectProperty.homMk (sheafifyLift (Scheme.smallEtaleTopology X) σ0 F.property), ?_⟩
    have h1 := congrArg (fun k => (k.app (Opposite.op Y)).hom (FreeAbelianGroup.of (ULift.up (𝟙 Y))))
      (toSheafify_sheafifyLift (Scheme.smallEtaleTopology X) σ0 F.property)
    refine h1.trans ?_
    change (FreeAbelianGroup.lift (fun t : ULift.{u+1} (Y ⟶ Y) => (F.obj.map t.down.op).hom e))
      (FreeAbelianGroup.of (ULift.up (𝟙 Y))) = e
    rw [FreeAbelianGroup.lift_apply_of]
    change (F.obj.map (𝟙 Y).op).hom e = e
    rw [op_id, CategoryTheory.Functor.map_id]
    rfl

  have yonU : ∀ (Y : X.Etale) (F : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
      (φ ψ : wcFtcFS X Y ⟶ F),
      (φ.hom.app (Opposite.op Y)).hom (wcFtcGen X Y) = (ψ.hom.app (Opposite.op Y)).hom (wcFtcGen X Y) →
      φ = ψ := by
    intro Y F φ ψ h
    apply Sheaf.hom_ext
    apply sheafify_hom_ext _ φ.hom ψ.hom F.property
    apply NatTrans.ext
    funext W
    apply AddCommGrpCat.hom_ext
    refine FreeAbelianGroup.lift_ext _ _ (fun t => ?_)
    have e : (FreeAbelianGroup.of t : FreeAbelianGroup (ULift.{u+1} (W.unop ⟶ Y))) =
        ((yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map t.down.op).hom
          (FreeAbelianGroup.of (ULift.up (𝟙 Y))) := by
      change _ = FreeAbelianGroup.of (ULift.up (t.down ≫ 𝟙 Y))
      rw [Category.comp_id]
      rfl
    have nφ := NatTrans.naturality_apply
      (toSheafify (Scheme.smallEtaleTopology X) (yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫ φ.hom)
      t.down.op (FreeAbelianGroup.of (ULift.up (𝟙 Y)))
    have nψ := NatTrans.naturality_apply
      (toSheafify (Scheme.smallEtaleTopology X) (yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫ ψ.hom)
      t.down.op (FreeAbelianGroup.of (ULift.up (𝟙 Y)))
    exact (congrArg (fun z => ((toSheafify (Scheme.smallEtaleTopology X)
        (yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫ φ.hom).app W).hom z) e).trans
      (nφ.trans ((congrArg (fun z => (F.obj.map t.down.op).hom z) h).trans (nψ.symm.trans
        (congrArg (fun z => ((toSheafify (Scheme.smallEtaleTopology X)
          (yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫ ψ.hom).app W).hom z) e).symm)))

  have rc : ∀ (A : Type (u+1)) [AddCommGroup A] (W W' : X.Etale) (h : W' ⟶ W) (x : A),
      (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of A)).obj.map h.op).hom (wcConstSec X A W x) = wcConstSec X A W' x := by
    intro A _ W W' h x
    exact (NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology X)
      ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of A))) h.op x).symm

  have hp2 : Etale (Limits.pullback.fst p p ≫ p) := by haveI := ht.etale; infer_instance
  let pr₁ : wcTorsorEt (Limits.pullback.fst p p ≫ p) hp2 ⟶ wcTorsorEt p ht.etale :=
    MorphismProperty.Over.homMk (Limits.pullback.fst p p) rfl trivial
  let pr₂ : wcTorsorEt (Limits.pullback.fst p p ≫ p) hp2 ⟶ wcTorsorEt p ht.etale :=
    MorphismProperty.Over.homMk (Limits.pullback.snd p p) Limits.pullback.condition.symm trivial
  have hpr₁ : pr₁.left = Limits.pullback.fst p p := rfl
  have hpr₂ : pr₂.left = Limits.pullback.snd p p := rfl

  obtain ⟨ε, hε⟩ := yon (wcTorsorEt p ht.etale)
    ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ)))
    (wcConstSec X (ULift.{u+1} ℤ) (wcTorsorEt p ht.etale) (ULift.up 1))
  obtain ⟨βs, hβ⟩ := yon (wcTorsorEt (Limits.pullback.fst p p ≫ p) hp2)
    (wcFtcFS X (wcTorsorEt p ht.etale))
    (((wcFtcFS X (wcTorsorEt p ht.etale)).obj.map pr₁.op).hom (wcFtcGen X (wcTorsorEt p ht.etale)) -
      ((wcFtcFS X (wcTorsorEt p ht.etale)).obj.map pr₂.op).hom (wcFtcGen X (wcTorsorEt p ht.etale)))
  obtain ⟨d, hd⟩ := wc_et_ftc_diff_section X V p m a ht hp2
  obtain ⟨Δ, hΔ⟩ := yon (wcTorsorEt (Limits.pullback.fst p p ≫ p) hp2)
    ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) d
  haveI hεepi : Epi ε := wc_et_ftc_aug_epi X V p ht.etale ht.surj ε hε
  have w₀ : βs ≫ ε = 0 := by
    apply yonU
    have n1 := NatTrans.naturality_apply ε.hom pr₁.op (wcFtcGen X (wcTorsorEt p ht.etale))
    have n2 := NatTrans.naturality_apply ε.hom pr₂.op (wcFtcGen X (wcTorsorEt p ht.etale))
    change (ε.hom.app _).hom ((βs.hom.app _).hom _) = _
    rw [hβ, map_sub]
    erw [n1, n2]
    rw [hε, rc, rc, sub_self]
    rfl
  have hex := wc_et_ftc_pair_exact X V p ht.etale hp2 pr₁ pr₂ hpr₁ hpr₂ βs ε hβ hε w₀
  have hkill := wc_et_ftc_kernel_kill X V p m a ht hp2 pr₁ pr₂ hpr₁ hpr₂ d hd βs hβ Δ hΔ

  have hP : (ShortComplex.mk (Limits.kernel.ι ε) ε (Limits.kernel.condition ε)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel ε) inferInstance inferInstance
  haveI hbepi : Epi (Limits.kernel.lift ε βs w₀) :=
    (ShortComplex.exact_iff_epi_kernel_lift _).mp hex
  have hbι : Limits.kernel.lift ε βs w₀ ≫ Limits.kernel.ι ε = βs := Limits.kernel.lift_ι _ _ _
  have hb : Limits.kernel.ι (Limits.kernel.lift ε βs w₀) ≫ Δ = 0 := by
    have h1 : Limits.kernel.ι (Limits.kernel.lift ε βs w₀) ≫ βs = 0 := by
      have e1 : Limits.kernel.ι (Limits.kernel.lift ε βs w₀) ≫ βs =
          (Limits.kernel.ι (Limits.kernel.lift ε βs w₀) ≫ Limits.kernel.lift ε βs w₀) ≫
            Limits.kernel.ι ε := by
        rw [Category.assoc, hbι]
      rw [e1, Limits.kernel.condition, Limits.zero_comp]
    rw [← Limits.kernel.lift_ι βs _ h1, Category.assoc, hkill, Limits.comp_zero]
  have hk : Limits.kernel.lift ε βs w₀ ≫ Abelian.epiDesc (Limits.kernel.lift ε βs w₀) Δ hb = Δ :=
    Abelian.comp_epiDesc _ Δ hb
  refine ⟨hP.extClass.comp (Abelian.Ext.mk₀ (Abelian.epiDesc (Limits.kernel.lift ε βs w₀) Δ hb))
    (add_zero 1), ?_⟩
  intro G E ρ f g w hS s hs
  obtain ⟨σ, hσ⟩ := yon (wcTorsorEt p ht.etale) E s
  have h1 : σ ≫ g = ε := by
    apply yonU
    change (g.hom.app _).hom ((σ.hom.app _).hom _) = _
    rw [hσ, hε]
    exact hs.1
  have h2 : βs ≫ σ = Δ ≫ ρ ≫ f := by
    apply yonU
    have n1 := NatTrans.naturality_apply σ.hom pr₁.op (wcFtcGen X (wcTorsorEt p ht.etale))
    have n2 := NatTrans.naturality_apply σ.hom pr₂.op (wcFtcGen X (wcTorsorEt p ht.etale))
    change (σ.hom.app _).hom ((βs.hom.app _).hom _) =
      (f.hom.app _).hom ((ρ.hom.app _).hom ((Δ.hom.app _).hom _))
    rw [hβ, hΔ, map_sub]
    erw [n1, n2]
    rw [hσ]
    exact wc_et_ftc_split_diff X V p m a ht hp2 pr₁ pr₂ hpr₁ hpr₂ d hd G E ρ f s hs.2
  haveI := hS.mono_f
  have hk0 : (Limits.kernel.ι ε ≫ σ) ≫ g = 0 := by
    rw [Category.assoc, h1, Limits.kernel.condition]
  have hk' : hS.exact.lift (Limits.kernel.ι ε ≫ σ) hk0 ≫ f = Limits.kernel.ι ε ≫ σ :=
    hS.exact.lift_f _ hk0
  let φ : ShortComplex.mk (Limits.kernel.ι ε) ε (Limits.kernel.condition ε) ⟶ ShortComplex.mk f g w :=
    { τ₁ := hS.exact.lift (Limits.kernel.ι ε ≫ σ) hk0
      τ₂ := σ
      τ₃ := 𝟙 _
      comm₁₂ := hk'
      comm₂₃ := by
        change σ ≫ g = ε ≫ 𝟙 _
        rw [Category.comp_id, h1] }
  have hnat := hP.extClass_naturality hS φ
  change hP.extClass.comp (Abelian.Ext.mk₀ (hS.exact.lift (Limits.kernel.ι ε ≫ σ) hk0)) _ =
    (Abelian.Ext.mk₀ (𝟙 _)).comp hS.extClass _ at hnat
  rw [Abelian.Ext.mk₀_id_comp] at hnat
  have hkk : hS.exact.lift (Limits.kernel.ι ε ≫ σ) hk0 =
      Abelian.epiDesc (Limits.kernel.lift ε βs w₀) Δ hb ≫ ρ := by
    rw [← cancel_mono f, ← cancel_epi (Limits.kernel.lift ε βs w₀)]
    rw [hk', ← Category.assoc, hbι, h2, Category.assoc, reassoc_of% hk]
  rw [← hnat, hkk, ← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_third_deg_zero]

theorem wc_et_const_unit_iso : ∀ {Y Z : Scheme.{u}} (i : Z ⟶ Y) [(wcEtBaseChange i).IsContinuous (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology Z)], Limits.IsTerminal ((wcEtBaseChange i).obj (Scheme.Etale.mk (𝟙 Y))) → ∀ (A : AddCommGrpCat.{u+1}) (ν : (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj A ⟶ ((wcEtBaseChange i).sheafPushforwardContinuous AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology Z)).obj ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj A)), toSheafify (Scheme.smallEtaleTopology Y) ((Functor.const (Y.Etale)ᵒᵖ).obj A) ≫ ν.hom = Functor.whiskerLeft (wcEtBaseChange i).op (toSheafify (Scheme.smallEtaleTopology Z) ((Functor.const (Z.Etale)ᵒᵖ).obj A)) → IsIso ((((wcEtBaseChange i).sheafAdjunctionContinuous AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology Z)).homEquiv ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj A) ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj A)).symm ν) :=
by
  intro Y Z i _ hT A ν hν
  let F := (wcEtBaseChange i).sheafPushforwardContinuous AddCommGrpCat.{u+1}
    (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology Z)
  let adj := (wcEtBaseChange i).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
    (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology Z)

  have hTY : Limits.IsTerminal (Scheme.Etale.mk (𝟙 Y)) :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))

  have s2 : ∀ (X : Scheme.{u}) (P : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1})
      (M : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}),
      Function.Bijective (fun ψ : (presheafToSheaf (Scheme.smallEtaleTopology X)
        AddCommGrpCat.{u+1}).obj P ⟶ M => toSheafify (Scheme.smallEtaleTopology X) P ≫ ψ.hom) := by
    intro X P M
    refine ⟨fun ψ₁ ψ₂ h => ?_, fun η => ⟨ObjectProperty.homMk
      (sheafifyLift (Scheme.smallEtaleTopology X) η M.property),
      toSheafify_sheafifyLift (Scheme.smallEtaleTopology X) η M.property⟩⟩
    exact Sheaf.hom_ext (sheafify_hom_ext (Scheme.smallEtaleTopology X) _ _ M.property h)

  have s3 : ∀ (P : (Z.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}),
      Function.Bijective (fun β : (Functor.const (Z.Etale)ᵒᵖ).obj A ⟶ P =>
        Functor.whiskerLeft (wcEtBaseChange i).op β) := by
    intro P
    have star : ∀ (β : (Functor.const (Z.Etale)ᵒᵖ).obj A ⟶ P) (V : Z.Etale),
        β.app (Opposite.op V) =
          β.app (Opposite.op ((wcEtBaseChange i).obj (Scheme.Etale.mk (𝟙 Y)))) ≫
            P.map (hT.from V).op := by
      intro β V
      have h := β.naturality (hT.from V).op
      simp only [Functor.const_obj_map, Category.id_comp] at h
      exact h
    refine ⟨fun β₁ β₂ h => ?_, fun γ => ?_⟩
    · have h0 : β₁.app (Opposite.op ((wcEtBaseChange i).obj (Scheme.Etale.mk (𝟙 Y)))) =
          β₂.app (Opposite.op ((wcEtBaseChange i).obj (Scheme.Etale.mk (𝟙 Y)))) :=
        NatTrans.congr_app h (Opposite.op (Scheme.Etale.mk (𝟙 Y)))
      apply NatTrans.ext
      funext V
      rcases V with ⟨V⟩
      rw [star β₁ V, star β₂ V, h0]
    · refine ⟨{ app := fun V => γ.app (Opposite.op (Scheme.Etale.mk (𝟙 Y))) ≫
                  P.map (hT.from V.unop).op
                naturality := ?_ }, ?_⟩
      · intro V V' g
        have e : (hT.from V.unop).op ≫ g = (hT.from V'.unop).op :=
          Quiver.Hom.unop_inj (hT.hom_ext _ _)
        show 𝟙 A ≫ (γ.app (Opposite.op (Scheme.Etale.mk (𝟙 Y))) ≫ P.map (hT.from V'.unop).op) =
          (γ.app (Opposite.op (Scheme.Etale.mk (𝟙 Y))) ≫ P.map (hT.from V.unop).op) ≫ P.map g
        rw [Category.id_comp, Category.assoc, ← P.map_comp, e]
      · apply NatTrans.ext
        funext U
        rcases U with ⟨U⟩
        have hG : (wcEtBaseChange i).map (hTY.from U) = hT.from ((wcEtBaseChange i).obj U) :=
          hT.hom_ext _ _
        have hn := γ.naturality (hTY.from U).op
        simp only [Functor.comp_map, Functor.const_obj_map, Category.id_comp, Functor.op_map,
          Quiver.Hom.unop_op] at hn
        rw [hG] at hn
        exact hn.symm

  have s4 : ∀ (H : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
      (ψ : (constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj A ⟶ H),
      toSheafify (Scheme.smallEtaleTopology Y) ((Functor.const (Y.Etale)ᵒᵖ).obj A) ≫
          (ν ≫ F.map ψ).hom =
        Functor.whiskerLeft (wcEtBaseChange i).op
          (toSheafify (Scheme.smallEtaleTopology Z) ((Functor.const (Z.Etale)ᵒᵖ).obj A) ≫
            ψ.hom) := by
    intro H ψ
    refine ((Category.assoc _ _ _).symm.trans (congrArg (fun f => f ≫ (F.map ψ).hom) hν)).trans ?_
    exact (Functor.whiskerLeft_comp (wcEtBaseChange i).op
      (toSheafify (Scheme.smallEtaleTopology Z) ((Functor.const (Z.Etale)ᵒᵖ).obj A))
      ψ.hom).symm

  have s5 : ∀ H : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1},
      Function.Bijective (fun ψ : (constantSheaf (Scheme.smallEtaleTopology Z)
        AddCommGrpCat.{u+1}).obj A ⟶ H => ν ≫ F.map ψ) := by
    intro H
    have eY := s2 Y ((Functor.const (Y.Etale)ᵒᵖ).obj A) (F.obj H)
    have eZ := s2 Z ((Functor.const (Z.Etale)ᵒᵖ).obj A) H
    have W := s3 H.obj
    refine ⟨fun ψ₁ ψ₂ h => ?_, fun χ => ?_⟩
    · apply eZ.1
      apply W.1
      have h' := congrArg (fun χ : (constantSheaf (Scheme.smallEtaleTopology Y)
          AddCommGrpCat.{u+1}).obj A ⟶ F.obj H =>
        toSheafify (Scheme.smallEtaleTopology Y) ((Functor.const (Y.Etale)ᵒᵖ).obj A) ≫ χ.hom) h
      exact (s4 H ψ₁).symm.trans (h'.trans (s4 H ψ₂))
    · obtain ⟨β, hβ⟩ := W.2
        (toSheafify (Scheme.smallEtaleTopology Y) ((Functor.const (Y.Etale)ᵒᵖ).obj A) ≫ χ.hom)
      obtain ⟨ψ, hψ⟩ := eZ.2 β
      refine ⟨ψ, eY.1 ?_⟩
      refine (s4 H ψ).trans ?_
      refine Eq.trans ?_ hβ
      exact congrArg (fun f => Functor.whiskerLeft (wcEtBaseChange i).op f) hψ

  apply isIso_of_coyoneda_map_bijective
  intro H
  have key : ∀ ψ, adj.homEquiv _ H
      ((adj.homEquiv ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj A)
        ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj A)).symm ν ≫ ψ) =
      ν ≫ F.map ψ := fun ψ => by
    rw [Adjunction.homEquiv_naturality_right, Equiv.apply_symm_apply]
  have hfun : (fun ψ => (adj.homEquiv
      ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj A)
      ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj A)).symm ν ≫ ψ) =
