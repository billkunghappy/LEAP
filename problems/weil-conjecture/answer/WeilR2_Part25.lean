  have hsq := wc_even_quadric_zmod_frob_sq F'' ℓ hℓ (n - 2) hd E₀ jE hjE hjEY a ha hEG hE k
  have hq : Nat.card F'' ^ n = Nat.card F'' * (Nat.card F'' * Nat.card F'' ^ (n - 2)) := by
    rw [← pow_succ', ← pow_succ']
    congr 1
    omega
  apply hinj
  rw [hιφ, hιφ, map_nsmul, hsq, map_nsmul ι, hq, mul_smul, mul_smul]

theorem wc_odp_punct_germ_frob_sq (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
