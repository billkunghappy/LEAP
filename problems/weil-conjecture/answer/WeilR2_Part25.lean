by
  classical

  obtain ⟨hc1, hq1, -, -⟩ := wc_pencil_nbhd_qcqs F' F'' Y n D V A e
  obtain ⟨hc2, hq2, -, -⟩ := wc_pencil_nbhd_qcqs F' F'' Y n D Vt L eL
  haveI := hc1
  haveI := hq1
  haveI := hc2
  haveI := hq2
  have hpos : 0 < ℓ ^ k := pow_pos (Fact.out : ℓ.Prime).pos k

  obtain ⟨E⟩ := wc_et_zmod_pull_data_exists ((wcProEtPullback D.f).map u').left (ℓ ^ k)
  refine wc_zmod_proet_pull_bij_of_et_pull_bij _ (ℓ ^ k) hpos Dk hDk E j ?_


  have core : ∀ {X T : Scheme.{u}} (fA : X ⟶ Spec (.of A)) [IsProper fA]
      (σ : IsLocalRing.ResidueField A →+* L) (p : T ⟶ X) (p' : T ⟶ Spec (.of L)),
      IsPullback p p' fA (Spec.map (CommRingCat.ofHom σ) ≫
          Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))) →
      ∀ (m : ℕ), (m : L) ≠ 0 → ∀ (E : wcEtPullData p m) (j : ℕ),
