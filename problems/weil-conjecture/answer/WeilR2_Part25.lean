      (Category.assoc _ _ _).symm)
  have hlam : Limits.pullback.lift _ _ hw ≫
      (Limits.pullback.snd (wcPunctOpen F'' u0).ι (Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) ≫
        Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) =
      Limits.pullback.snd (wcPunctOpen F'' u0).ι V.hom ≫ V.hom :=
    (Category.assoc _ _ _).symm.trans ((eq_whisker (Limits.pullback.lift_snd _ _ _) _).trans
      ((Category.assoc _ _ _).trans (whisker_eq _ (MorphismProperty.Over.w g))))
  let gV : wcPunctOf F'' u0 V ⟶ wcPunctGeom F'' u0 hP :=
    MorphismProperty.Over.homMk (Limits.pullback.lift _ _ hw) hlam trivial
  have hgV : gV ≫ wcPunctIncl F'' u0 hP = wcPunctOfIncl F'' u0 V ≫ g := by
    apply MorphismProperty.Over.Hom.ext
    exact Limits.pullback.lift_snd _ _ _

  exact hs1 (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP) (wcPunctGeom F'' u0 hP) V
    (wcPunctOf F'' u0 V) (wcPunctIncl F'' u0 hP) hι xb hr g (wcPunctOfIncl F'' u0 V) hj hrj gV hgV
    hfib hln

theorem wc_strict_nbhd_punct_connected (F'' : Type u) [Field F'']
    (u0 : Spec (.of F'') ⟶ (wcP1Over F'').left) (hu0 : u0 ≫ (wcP1Over F'').hom = 𝟙 _)
    (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = u0 (IsLocalRing.closedPoint F'')) :
    ConnectedSpace (wcPunctOf F'' u0 V₀).left :=
by
  classical
  set y : (wcP1Over F'').left := u0 (IsLocalRing.closedPoint F'') with hy

  haveI hsep : IsSeparated (wcP1Over F'').hom := by
    show IsSeparated (wcProjKStr F'' 1); infer_instance
  haveI : IsClosedImmersion (u0 ≫ (wcP1Over F'').hom) := by rw [hu0]; infer_instance
  haveI : IsClosedImmersion u0 := IsClosedImmersion.of_comp u0 (wcP1Over F'').hom
  have hyc : IsClosed ({y} : Set (wcP1Over F'').left) := by
    have h1 := u0.isClosedEmbedding.isClosed_range
    have h2 : Set.range u0 = {y} := by
      ext z
      constructor
      · rintro ⟨w, rfl⟩
        rw [Set.mem_singleton_iff, hy]
        congr 1
        have hbot : ∀ w' : PrimeSpectrum F'', w'.asIdeal = ⊥ :=
          fun w' => @Ideal.eq_bot_of_prime F'' _ w'.asIdeal w'.isPrime
        exact PrimeSpectrum.ext ((hbot w).trans (hbot _).symm)
      · intro hz
        rw [Set.mem_singleton_iff] at hz
        exact ⟨_, hz.symm⟩
    rwa [h2] at h1

  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') :=
    MvPolynomial.gradedAlgebra
  have hX : ∀ i : Fin (1 + 1), (MvPolynomial.X i : MvPolynomial (Fin (1 + 1)) F'') ∈
      MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'' 1 :=
    fun i => (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X F'' i)
  have hirrel : ∀ i : Fin (1 + 1), (MvPolynomial.X i : MvPolynomial (Fin (1 + 1)) F'') ∈
      HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') := by
    intro i
    rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
    exact DirectSum.decompose_of_mem_ne _ (hX i) one_ne_zero
  let ηP : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') :=
    ⟨⊥, by rw [HomogeneousIdeal.toIdeal_bot]; infer_instance, fun h => by
      have h2 : (MvPolynomial.X 0 : MvPolynomial (Fin (1 + 1)) F'') ∈
          (⊥ : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'')).toIdeal :=
        h (hirrel 0)
      rw [HomogeneousIdeal.toIdeal_bot, Ideal.mem_bot] at h2
      exact MvPolynomial.X_ne_zero _ h2⟩
  let ξP : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') :=
    ⟨⟨Ideal.span {MvPolynomial.X 0}, Ideal.homogeneous_span _ _ (fun x hx =>
        ⟨1, by rw [Set.mem_singleton_iff.mp hx]; exact hX 0⟩)⟩,
      (Ideal.span_singleton_prime (MvPolynomial.X_ne_zero _)).mpr MvPolynomial.X_prime,
      fun h => by
        have h2 : (MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) F'') ∈
            Ideal.span {MvPolynomial.X 0} := h (hirrel 1)
        rw [Ideal.mem_span_singleton] at h2
        exact absurd (MvPolynomial.X_dvd_X.mp h2) (by decide)⟩
  have hgenP : ∀ z : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F''),
      ηP ⤳ z := fun z =>
    specializes_iff_mem_closure.mpr ((ProjectiveSpectrum.le_iff_mem_closure _ ηP z).mp
      ((ProjectiveSpectrum.as_ideal_le_as_ideal _ ηP z).mp bot_le))
  let yP : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') := y
  have hycP : IsClosed ({yP} : Set (ProjectiveSpectrum
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F''))) := hyc
  have hneP : ηP ≠ yP := by
    intro h
    have h1 : ξP ∈ closure ({yP} : Set _) := by
      rw [← h]; exact specializes_iff_mem_closure.mp (hgenP ξP)
    rw [hycP.closure_eq, Set.mem_singleton_iff, ← h] at h1
    have h3 : (MvPolynomial.X 0 : MvPolynomial (Fin (1 + 1)) F'') ∈
        ξP.asHomogeneousIdeal.toIdeal := Ideal.subset_span rfl
    rw [h1] at h3
    change (MvPolynomial.X 0 : MvPolynomial (Fin (1 + 1)) F'') ∈
      (⊥ : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'')).toIdeal at h3
    rw [HomogeneousIdeal.toIdeal_bot, Ideal.mem_bot] at h3
    exact MvPolynomial.X_ne_zero _ h3
  obtain ⟨η, hη, hne⟩ : ∃ η : (wcP1Over F'').left, η ⤳ y ∧ η ≠ y := ⟨ηP, hgenP yP, hneP⟩

  haveI := wc_p1_smooth_reldim_one F''
  haveI : HenselianLocalRing (CommRingCat.of A) := inferInstanceAs (HenselianLocalRing A)
  haveI : IsSepClosed (IsLocalRing.ResidueField (CommRingCat.of A)) :=
    inferInstanceAs (IsSepClosed (IsLocalRing.ResidueField A))
  have hk : WeaklyEtale (e.inv ≫ V₀.hom) :=
    @MorphismProperty.comp_mem _ _ @WeaklyEtale
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      _ _ _ e.inv V₀.hom (etale_le_weaklyEtale _ _ _ inferInstance) V₀.prop
  haveI hdom : IsDomain (CommRingCat.of A) :=
    wc_strictHensel_weaklyEtale_smooth_isDomain F'' (wcP1Over F'').hom 1 (CommRingCat.of A)
      (e.inv ≫ V₀.hom) hk
  haveI : IrreducibleSpace (PrimeSpectrum (CommRingCat.of A)) := PrimeSpectrum.irreducibleSpace
  have hirrA : IsIrreducible (Set.univ : Set (Spec (.of A))) :=
    IrreducibleSpace.isIrreducible_univ (PrimeSpectrum (CommRingCat.of A))
  have himg := hirrA.image e.inv e.inv.continuous.continuousOn
  have hsurj : e.inv '' Set.univ = Set.univ := by
    rw [Set.image_univ, Set.range_eq_univ]
    intro x
    exact ⟨e.hom x, by
      show e.inv (e.hom x) = x
      exact congrArg (fun f : V₀.left ⟶ V₀.left => f x) e.hom_inv_id⟩
  rw [hsurj] at himg
  have hirr : IsPreirreducible (Set.univ : Set V₀.left) := himg.isPreirreducible

  haveI : WeaklyEtale V₀.hom := V₀.prop
  haveI : Flat V₀.hom := WeaklyEtale.flat
  have hgen : GeneralizingMap V₀.hom := Flat.generalizingMap V₀.hom
  obtain ⟨x, -, hxη⟩ := hgen (show η ⤳ V₀.hom (e.inv (IsLocalRing.closedPoint A)) by
    rw [hv]; exact hη)

  have hOopen : IsOpen (V₀.hom ⁻¹' (closure {y})ᶜ) :=
    isClosed_closure.isOpen_compl.preimage V₀.hom.continuous
  have hxO : x ∈ V₀.hom ⁻¹' (closure {y})ᶜ := by
    show V₀.hom x ∉ closure {y}
    rw [hxη]
    intro h
    have h1 : y ⤳ η := specializes_iff_mem_closure.mpr h
    exact hne (h1.antisymm hη).eq.symm
  have hO : _root_.IsConnected (V₀.hom ⁻¹' (closure {y})ᶜ) :=
    IsIrreducible.isConnected ⟨⟨x, hxO⟩, hirr.open_subset hOopen (Set.subset_univ _)⟩

  have hrange : Set.range (Limits.pullback.snd (wcPunctOpen F'' u0).ι V₀.hom) =
      V₀.hom ⁻¹' (closure {y})ᶜ := by
    rw [IsOpenImmersion.range_pullbackSnd, Scheme.Opens.opensRange_ι]
    rfl
  have hemb := (Limits.pullback.snd (wcPunctOpen F'' u0).ι V₀.hom).isOpenEmbedding
  change ConnectedSpace ↥(Limits.pullback (wcPunctOpen F'' u0).ι V₀.hom)
  rw [connectedSpace_iff_univ]
  refine ⟨?_, ?_⟩
  · obtain ⟨z, hz⟩ := hO.nonempty
    rw [← hrange] at hz
    obtain ⟨w, -⟩ := hz
    exact ⟨w, Set.mem_univ _⟩
  · rw [← hemb.isInducing.isPreconnected_image, Set.image_univ, hrange]
    exact hO.isPreconnected

theorem wc_strict_punct_Rq_restrict_bij (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (k : ℕ) (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom D.u0 ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.u0 (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom D.u0) :
    Function.Bijective (fun y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V₀) (wcRq D.f ℓ k) 0 =>
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left (wcPunctOfIncl F'' D.u0 V₀))).comp y
        (zero_add 0)) :=
by
  classical

  haveI hsep : IsSeparated (wcP1Over F'').hom := by
    show IsSeparated (wcProjKStr F'' 1); infer_instance
  haveI := D.proper
  haveI hcomp : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; infer_instance
  haveI hfp : IsProper D.f := IsProper.of_comp D.f (wcP1Over F'').hom

  let hV : V₀.left ≃ₜ Spec (.of A) := Scheme.homeoOfIso e
  haveI : IsAffine V₀.left := IsAffine.of_isIso e.hom
  have hk : CompactSpace V₀.left := inferInstance
  have hq : QuasiSeparatedSpace V₀.left := inferInstance
  have hspec : ∀ x : V₀.left, x ⤳ e.inv (IsLocalRing.closedPoint A) := by
    intro x
    have h1 : hV x ⤳ IsLocalRing.closedPoint A :=
      (PrimeSpectrum.le_iff_specializes _ _).mp
        (IsLocalRing.le_maximalIdeal (PrimeSpectrum.isPrime _).ne_top)
    have h2 : hV.symm (hV x) ⤳ hV.symm (IsLocalRing.closedPoint A) :=
      h1.map hV.symm.continuous
    rw [hV.symm_apply_apply] at h2
    have h3 : e.inv (IsLocalRing.closedPoint A) = hV.symm (IsLocalRing.closedPoint A) := by
      apply hV.injective
      refine Eq.trans ?_ (hV.apply_symm_apply (IsLocalRing.closedPoint A)).symm
      show e.hom (e.inv (IsLocalRing.closedPoint A)) = IsLocalRing.closedPoint A
      exact congrArg (fun f : Spec (.of A) ⟶ Spec (.of A) => f (IsLocalRing.closedPoint A))
        e.inv_hom_id
    rw [h3]
    exact h2
  have hc : ConnectedSpace V₀.left := by
    refine connectedSpace_iff_clopen.mpr ⟨⟨e.inv (IsLocalRing.closedPoint A)⟩, fun s hs => ?_⟩
    by_cases hm : e.inv (IsLocalRing.closedPoint A) ∈ s
    · right
      ext x
      simp only [Set.mem_univ, iff_true]
      exact (hspec x).mem_open hs.isOpen hm
    · left
      ext x
      simp only [Set.mem_empty_iff_false, iff_false]
      intro hx
      exact hm ((hspec x).mem_closed hs.isClosed hx)

  have hW := wc_strict_nbhd_punct_connected F'' D.u0 D.hu0 V₀ A e hv

  have htor := wc_strict_nbhd_Rq_torsion_const F' F'' Y n D ℓ hℓ V₀ A e ε hv hε
  obtain ⟨a, b, ex, hZ⟩ := wc_proet_Rq_int_const_of_torsion_const D.f ℓ V₀ hc hk hq htor k
  obtain ⟨θ⟩ := wc_proet_Rq_rat_const_of_int_const D.f ℓ V₀ hk hq k a b ex hZ

  let X₀ : Over V₀ := Over.mk (𝟙 V₀)
  let X₁ : Over V₀ := Over.mk (wcPunctOfIncl F'' D.u0 V₀)
  let h : X₁ ⟶ X₀ := Over.homMk (wcPunctOfIncl F'' D.u0 V₀) (Category.comp_id _)
  let ι₀ := ((sheafToPresheaf _ _).mapIso θ).app (Opposite.op X₀)
  let ι₁ := ((sheafToPresheaf _ _).mapIso θ).app (Opposite.op X₁)
  have b₀ : Function.Bijective (ConcreteCategory.hom ι₀.hom) :=
    ConcreteCategory.bijective_of_isIso ι₀.hom
  have b₁ : Function.Bijective (ConcreteCategory.hom ι₁.hom) :=
    ConcreteCategory.bijective_of_isIso ι₁.hom
  have hn : ∀ x : (wcRq D.f ℓ k).obj.obj (Opposite.op V₀),
      ι₁.hom ((wcRq D.f ℓ k).obj.map (wcPunctOfIncl F'' D.u0 V₀).op x) =
        (wcContSheaf (wcP1Over F'').left (Fin a → ℚ_[ℓ])).obj.map
          (wcPunctOfIncl F'' D.u0 V₀).op (ι₀.hom x) := by
    intro x
    have := congrArg (fun φ => (ConcreteCategory.hom φ) x) (θ.hom.hom.naturality h.op)
    exact this
  have hconst : ∀ (Q : Type u) [TopologicalSpace Q] [PreconnectedSpace Q]
      (g : C(Q, Fin a → ℚ_[ℓ])) (p q : Q), g p = g q := by
    intro Q _ _ g p q
    exact (isPreconnected_range g.continuous).subsingleton (Set.mem_range_self p)
      (Set.mem_range_self q)
  have hρC : Function.Bijective (fun z : (wcContSheaf (wcP1Over F'').left (Fin a → ℚ_[ℓ])).obj.obj
      (Opposite.op V₀) =>
      (wcContSheaf (wcP1Over F'').left (Fin a → ℚ_[ℓ])).obj.map
        (wcPunctOfIncl F'' D.u0 V₀).op z) := by
    obtain ⟨q₀⟩ := hW.toNonempty
    let jb : C(↥(wcPunctOf F'' D.u0 V₀).left, ↥V₀.left) :=
      (wcPunctOfIncl F'' D.u0 V₀).left.base.hom
    change Function.Bijective (fun z : ULift.{u+1} C(↥V₀.left, Fin a → ℚ_[ℓ]) =>
      (ULift.up (z.down.comp jb) : ULift.{u+1} C(↥(wcPunctOf F'' D.u0 V₀).left, Fin a → ℚ_[ℓ])))
    constructor
    · intro z z' hzz
      have h1 : z.down (jb q₀) = z'.down (jb q₀) := congrArg (fun w => w.down q₀) hzz
      apply ULift.ext
      refine ContinuousMap.ext fun p => ?_
      rw [hconst _ z.down p (jb q₀), hconst _ z'.down p (jb q₀)]
      exact h1
    · intro w
      refine ⟨ULift.up (ContinuousMap.const _ (w.down q₀)), ?_⟩
      apply ULift.ext
      refine ContinuousMap.ext fun q => ?_
      show w.down q₀ = w.down q
      exact hconst _ w.down q₀ q
  have hρ : Function.Bijective (fun x : (wcRq D.f ℓ k).obj.obj (Opposite.op V₀) =>
      (wcRq D.f ℓ k).obj.map (wcPunctOfIncl F'' D.u0 V₀).op x) := by
    constructor
    · intro x x' hxx
      have hxx' : (wcRq D.f ℓ k).obj.map (wcPunctOfIncl F'' D.u0 V₀).op x =
          (wcRq D.f ℓ k).obj.map (wcPunctOfIncl F'' D.u0 V₀).op x' := hxx
      apply b₀.1
      apply hρC.1
      show (wcContSheaf (wcP1Over F'').left (Fin a → ℚ_[ℓ])).obj.map
          (wcPunctOfIncl F'' D.u0 V₀).op (ι₀.hom x) =
        (wcContSheaf (wcP1Over F'').left (Fin a → ℚ_[ℓ])).obj.map
          (wcPunctOfIncl F'' D.u0 V₀).op (ι₀.hom x')
      rw [← hn x, ← hn x', hxx']
    · intro y
      obtain ⟨z, hz⟩ := hρC.2 (ι₁.hom y)
      obtain ⟨x, rfl⟩ := b₀.2 z
      refine ⟨x, b₁.1 ?_⟩
      show ι₁.hom ((wcRq D.f ℓ k).obj.map (wcPunctOfIncl F'' D.u0 V₀).op x) = ι₁.hom y
      rw [hn x]
      exact hz

  obtain ⟨es, -, hnat⟩ := wc_free_ext0_sections (wcP1Over F'').left (wcRq D.f ℓ k)
  have key := (es (wcPunctOf F'' D.u0 V₀)).symm.bijective.comp (hρ.comp (es V₀).bijective)
  convert key using 1
  funext y
  apply (es (wcPunctOf F'' D.u0 V₀)).injective
  simp only [Function.comp_apply, Equiv.apply_symm_apply]
  exact hnat V₀ (wcPunctOf F'' D.u0 V₀) (wcPunctOfIncl F'' D.u0 V₀) y

theorem wc_proet_over_contSheaf_end_linear : ∀ (S : Scheme.{u}) (W : S.ProEt), ConnectedSpace W.left →
    ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r : ℕ)
      (E : (wcContSheaf S (Fin r → ℚ_[ℓ])).over W ⟶ (wcContSheaf S (Fin r → ℚ_[ℓ])).over W),
      (∀ c : ℚ_[ℓ],
        ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map
            (wcContSheafMap S (DistribSMul.toAddMonoidHom (Fin r → ℚ_[ℓ]) c) (continuous_const_smul c)) ≫ E =
          E ≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map
            (wcContSheafMap S (DistribSMul.toAddMonoidHom (Fin r → ℚ_[ℓ]) c) (continuous_const_smul c))) →
      ∃ T : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]),
        E = ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map
          (wcContSheafMap S T.toAddMonoidHom (LinearMap.continuous_of_finiteDimensional T)) :=
by
  intro S W hW ℓ _ r E hE
  classical
  let one : Over W := Over.mk (𝟙 W)
  let incl : C(Fin r → ℤ_[ℓ], Fin r → ℚ_[ℓ]) :=
    ⟨fun z i => ((z i : ℤ_[ℓ]) : ℚ_[ℓ]),
      continuous_pi (fun i => continuous_subtype_val.comp (continuous_apply i))⟩

  let G : (Fin r → ℚ_[ℓ]) → C(W.left, Fin r → ℚ_[ℓ]) := fun v =>
    (show ULift.{u+1} C(W.left, Fin r → ℚ_[ℓ]) from
      (E.hom.app (Opposite.op one)).hom
        (show ((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.obj (Opposite.op one) from
          ULift.up (ContinuousMap.const W.left v))).down
  obtain ⟨w₀⟩ := hW.toNonempty

  have hconst : ∀ (v : Fin r → ℚ_[ℓ]) (w : W.left), G v w = G v w₀ := fun v w =>
    (isPreconnected_range (G v).continuous).subsingleton ⟨w, rfl⟩ ⟨w₀, rfl⟩
  have hadd : ∀ v v' : Fin r → ℚ_[ℓ], G (v + v') w₀ = G v w₀ + G v' w₀ := by
    intro v v'
    let A : ((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.obj (Opposite.op one) :=
      ULift.up (ContinuousMap.const W.left v)
    let B : ((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.obj (Opposite.op one) :=
      ULift.up (ContinuousMap.const W.left v')
    have hsum : (show ((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.obj (Opposite.op one) from
          ULift.up (ContinuousMap.const W.left (v + v'))) = A + B := rfl
    have h3 : (E.hom.app (Opposite.op one)).hom (A + B) =
        (E.hom.app (Opposite.op one)).hom A + (E.hom.app (Opposite.op one)).hom B :=
      map_add _ A B
    have h4 := congrArg (fun z : ((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.obj (Opposite.op one) =>
      (show ULift.{u+1} C(W.left, Fin r → ℚ_[ℓ]) from z).down w₀) h3
    have h5 := congrArg (fun z => (show ULift.{u+1} C(W.left, Fin r → ℚ_[ℓ]) from
      (E.hom.app (Opposite.op one)).hom z).down w₀) hsum
    exact h5.trans h4
  have hsmul : ∀ (c : ℚ_[ℓ]) (v : Fin r → ℚ_[ℓ]), G (c • v) w₀ = c • G v w₀ := by
    intro c v
    have h := congrArg (fun φ => (show ULift.{u+1} C(W.left, Fin r → ℚ_[ℓ]) from
      (φ.hom.app (Opposite.op one)).hom
        (show ((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.obj (Opposite.op one) from
          ULift.up (ContinuousMap.const W.left v))).down w₀) (hE c)
    exact h
  let T : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]) :=
    { toFun := fun v => G v w₀
      map_add' := hadd
      map_smul' := fun c v => by
        rw [RingHom.id_apply]
        exact hsmul c v }
  have hT : ∀ (v : Fin r → ℚ_[ℓ]) (w : W.left), G v w = T v := fun v w => hconst v w

  obtain ⟨P, p, hp, π, H1, H2⟩ := wc_profinite_universal_weaklyEtale W.left (Fin r → ℤ_[ℓ])

  have hcrux : ∀ (X : Over W) (g : C(X.left.left, Fin r → ℤ_[ℓ])) (t : X.left.left),
      (show ULift.{u+1} C(X.left.left, Fin r → ℚ_[ℓ]) from
        (E.hom.app (Opposite.op X)).hom
          (show ((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.obj (Opposite.op X) from
            ULift.up (incl.comp g))).down t = T (incl (g t)) := by
    intro X g t
    have hPw : WeaklyEtale (p ≫ W.hom) := by
      have := W.prop
      infer_instance
    let Pe : S.ProEt := Scheme.ProEt.mk (p ≫ W.hom)
    let pe : Pe ⟶ W := MorphismProperty.Over.homMk p rfl trivial
    let Pw : Over W := Over.mk pe
    let s : ((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.obj (Opposite.op Pw) :=
      ULift.up (incl.comp π)

    obtain ⟨hX, hXp, hXπ⟩ := H1 X.left.left X.hom.left g
    have wX : hX ≫ (p ≫ W.hom) = X.left.hom := by
      rw [← Category.assoc, hXp]
      exact MorphismProperty.Over.w X.hom
    let hXe : X.left ⟶ Pe := MorphismProperty.Over.homMk hX wX trivial
    let aX : X ⟶ Pw := Over.homMk hXe (by
      apply MorphismProperty.Over.Hom.ext
      exact hXp)
    have e1 : (E.hom.app (Opposite.op X)).hom
          ((((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.map aX.op).hom s) =
        (((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.map aX.op).hom
          ((E.hom.app (Opposite.op Pw)).hom s) :=
      congrArg (fun h => AddCommGrpCat.Hom.hom h s) (E.hom.naturality aX.op)
    have hresX : (((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.map aX.op).hom s =
        (show ((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.obj (Opposite.op X) from
          ULift.up (incl.comp g)) := by
      change (ULift.up ((incl.comp π).comp aX.left.left.base.hom) :
          ULift.{u+1} C(X.left.left, Fin r → ℚ_[ℓ])) = ULift.up (incl.comp g)
      congr 1
      refine ContinuousMap.ext fun y => ?_
      exact congrArg (fun z => incl z) (DFunLike.congr_fun hXπ y)
    have e1' : (E.hom.app (Opposite.op X)).hom
          (show ((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.obj (Opposite.op X) from
            ULift.up (incl.comp g)) =
        (((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.map aX.op).hom
          ((E.hom.app (Opposite.op Pw)).hom s) := by
      rw [← e1, hresX]
    have star : (show ULift.{u+1} C(X.left.left, Fin r → ℚ_[ℓ]) from
          (E.hom.app (Opposite.op X)).hom
            (show ((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.obj (Opposite.op X) from
              ULift.up (incl.comp g))).down t =
        (show ULift.{u+1} C(P, Fin r → ℚ_[ℓ]) from
          (E.hom.app (Opposite.op Pw)).hom s).down (hX.base t) :=
      congrArg (fun z : ULift.{u+1} C(X.left.left, Fin r → ℚ_[ℓ]) => z.down t) e1'

    have hπx : π (hX.base t) = g t := DFunLike.congr_fun hXπ t
    obtain ⟨σ, -, hσp, hσπ, hσfac⟩ := H2 (g t)
    have hxσ : σ.base (p.base (hX.base t)) = hX.base t := by
      have h0 := hσfac (Spec (P.residueField (hX.base t))) (P.fromSpecResidueField (hX.base t))
        (fun y => by rw [Scheme.fromSpecResidueField_apply]; exact hπx)
      have h1 : (P.fromSpecResidueField (hX.base t)).base
            (IsLocalRing.closedPoint (P.residueField (hX.base t))) =
          ((P.fromSpecResidueField (hX.base t) ≫ p) ≫ σ).base
            (IsLocalRing.closedPoint (P.residueField (hX.base t))) :=
        congrArg (fun h : Spec (P.residueField (hX.base t)) ⟶ P =>
          h.base (IsLocalRing.closedPoint (P.residueField (hX.base t)))) h0
      have h2 : ((P.fromSpecResidueField (hX.base t) ≫ p) ≫ σ).base
            (IsLocalRing.closedPoint (P.residueField (hX.base t))) =
          σ.base (p.base ((P.fromSpecResidueField (hX.base t)).base
            (IsLocalRing.closedPoint (P.residueField (hX.base t))))) := rfl
      have h3 := h1.trans h2
      have h4 : (P.fromSpecResidueField (hX.base t)).base
          (IsLocalRing.closedPoint (P.residueField (hX.base t))) = hX.base t :=
        Scheme.fromSpecResidueField_apply ..
      exact (congrArg (fun y => σ.base (p.base y)) h4).symm.trans (h3.symm.trans h4)
    have wσ : σ ≫ (p ≫ W.hom) = W.hom := by
      rw [← Category.assoc, hσp, Category.id_comp]
    let σe : W ⟶ Pe := MorphismProperty.Over.homMk σ wσ trivial
    let bσ : one ⟶ Pw := Over.homMk σe (by
      apply MorphismProperty.Over.Hom.ext
      exact hσp)
    have e2 : (E.hom.app (Opposite.op one)).hom
          ((((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.map bσ.op).hom s) =
        (((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.map bσ.op).hom
          ((E.hom.app (Opposite.op Pw)).hom s) :=
      congrArg (fun h => AddCommGrpCat.Hom.hom h s) (E.hom.naturality bσ.op)
    have hresσ : (((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.map bσ.op).hom s =
        (show ((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.obj (Opposite.op one) from
          ULift.up (ContinuousMap.const W.left (incl (g t)))) := by
      change (ULift.up ((incl.comp π).comp bσ.left.left.base.hom) :
          ULift.{u+1} C(W.left, Fin r → ℚ_[ℓ])) = ULift.up (ContinuousMap.const W.left (incl (g t)))
      congr 1
      refine ContinuousMap.ext fun y => ?_
      exact congrArg (fun z => incl z) (hσπ y)
    have e2' : (E.hom.app (Opposite.op one)).hom
          (show ((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.obj (Opposite.op one) from
            ULift.up (ContinuousMap.const W.left (incl (g t)))) =
        (((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.map bσ.op).hom
          ((E.hom.app (Opposite.op Pw)).hom s) := by
      rw [← e2, hresσ]
    have star2 : G (incl (g t)) (p.base (hX.base t)) =
        (show ULift.{u+1} C(P, Fin r → ℚ_[ℓ]) from
          (E.hom.app (Opposite.op Pw)).hom s).down (σ.base (p.base (hX.base t))) :=
      congrArg (fun z : ULift.{u+1} C(W.left, Fin r → ℚ_[ℓ]) => z.down (p.base (hX.base t))) e2'
    exact star.trans ((congrArg (fun y => (show ULift.{u+1} C(P, Fin r → ℚ_[ℓ]) from
      (E.hom.app (Opposite.op Pw)).hom s).down y) hxσ.symm).trans (star2.symm.trans (hT _ _)))

  refine ⟨T, ?_⟩
  apply Sheaf.hom_ext
  apply NatTrans.ext
  funext Xop
  obtain ⟨X⟩ := Xop
  apply AddCommGrpCat.ext
  intro x
  change ULift.{u+1} C(X.left.left, Fin r → ℚ_[ℓ]) at x
  obtain ⟨f⟩ := x
  refine ULift.ext _ _ (ContinuousMap.ext fun t => ?_)

  let U0 : Set X.left.left :=
    ⋂ j : Fin r, (fun y => f y j - f t j) ⁻¹' Metric.closedBall (0 : ℚ_[ℓ]) 1
  have hU : IsOpen U0 :=
    isOpen_iInter_of_finite fun j =>
      (IsUltrametricDist.isOpen_closedBall (0 : ℚ_[ℓ]) one_ne_zero).preimage
        (((continuous_apply j).comp f.continuous).sub continuous_const)
  have htU : t ∈ U0 := by
    refine Set.mem_iInter.mpr fun j => ?_
    show f t j - f t j ∈ Metric.closedBall (0 : ℚ_[ℓ]) 1
    rw [sub_self]
    exact Metric.mem_closedBall_self zero_le_one
  let U : X.left.left.Opens := ⟨U0, hU⟩
  have hYw : WeaklyEtale (U.ι ≫ X.left.hom) := by
    have := X.left.prop
    infer_instance
  let Ye : S.ProEt := Scheme.ProEt.mk (U.ι ≫ X.left.hom)
  let i : Ye ⟶ X.left := MorphismProperty.Over.homMk U.ι rfl trivial
  let Y' : Over W := Over.mk (i ≫ X.hom)
  let a : Y' ⟶ X := Over.homMk i rfl
  let b : Y' ⟶ one := Over.homMk (i ≫ X.hom) (Category.comp_id _)
  have hmem : ∀ (y : U) (j : Fin r), ‖f (U.ι y) j - f t j‖ ≤ 1 := by
    intro y j
    have hy : (y : X.left.left) ∈ U0 := y.2
    rw [Scheme.Opens.ι_apply]
    exact mem_closedBall_zero_iff.mp (Set.mem_iInter.mp hy j)
  have hcont : ∀ j : Fin r, Continuous (fun y : U => f (U.ι y) j - f t j) := fun j =>
    ((continuous_apply j).comp (f.continuous.comp U.ι.base.hom.continuous)).sub continuous_const
  let gI : C(Y'.left.left, Fin r → ℤ_[ℓ]) :=
    ⟨fun y j => ⟨f (U.ι y) j - f t j, hmem y j⟩,
      continuous_pi fun j => (hcont j).subtype_mk (fun y => hmem y j)⟩
  let x : ((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.obj (Opposite.op X) := ULift.up f
  let c : ((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.obj (Opposite.op one) :=
    ULift.up (ContinuousMap.const W.left (f t))
  let z : ((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.obj (Opposite.op Y') :=
    ULift.up (incl.comp gI)
  have hres : (((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.map a.op).hom x =
      (((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.map b.op).hom c + z := by
    change (ULift.up (f.comp a.left.left.base.hom) : ULift.{u+1} C(Y'.left.left, Fin r → ℚ_[ℓ])) =
      ULift.up ((ContinuousMap.const W.left (f t)).comp b.left.left.base.hom + incl.comp gI)
    congr 1
    refine ContinuousMap.ext fun y => ?_
    funext j
    show f (U.ι y) j = f t j + (f (U.ι y) j - f t j)
    ring
  have e1 : (E.hom.app (Opposite.op Y')).hom
        ((((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.map a.op).hom x) =
      (((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.map a.op).hom
        ((E.hom.app (Opposite.op X)).hom x) :=
    congrArg (fun h => AddCommGrpCat.Hom.hom h x) (E.hom.naturality a.op)
  have e2 : (E.hom.app (Opposite.op Y')).hom
        ((((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.map b.op).hom c) =
      (((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.map b.op).hom
        ((E.hom.app (Opposite.op one)).hom c) :=
    congrArg (fun h => AddCommGrpCat.Hom.hom h c) (E.hom.naturality b.op)
  have key : (((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.map a.op).hom
        ((E.hom.app (Opposite.op X)).hom x) =
      (((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.map b.op).hom
        ((E.hom.app (Opposite.op one)).hom c) + (E.hom.app (Opposite.op Y')).hom z := by
    rw [← e1, ← e2, hres, map_add]
  let t' : U := ⟨t, htU⟩
  have h5 : (show ULift.{u+1} C(X.left.left, Fin r → ℚ_[ℓ]) from
        (E.hom.app (Opposite.op X)).hom x).down (U.ι t') =
      (show ULift.{u+1} C(W.left, Fin r → ℚ_[ℓ]) from
        (E.hom.app (Opposite.op one)).hom c).down (b.left.left.base t') +
      (show ULift.{u+1} C(Y'.left.left, Fin r → ℚ_[ℓ]) from
        (E.hom.app (Opposite.op Y')).hom z).down t' :=
    congrArg (fun w : ULift.{u+1} C(Y'.left.left, Fin r → ℚ_[ℓ]) => w.down t') key
  have hι : U.ι t' = t := Scheme.Opens.ι_apply U t'
  have hg0 : incl (gI t') = 0 := by
    funext j
    show f (U.ι t') j - f t j = 0
    rw [hι, sub_self]
  have hA : (show ULift.{u+1} C(W.left, Fin r → ℚ_[ℓ]) from
        (E.hom.app (Opposite.op one)).hom c).down (b.left.left.base t') = T (f t) :=
    hT (f t) _
  have hB : (show ULift.{u+1} C(Y'.left.left, Fin r → ℚ_[ℓ]) from
        (E.hom.app (Opposite.op Y')).hom z).down t' = 0 := by
    have h6 := hcrux Y' gI t'
    rw [hg0, map_zero] at h6
    exact h6
  rw [hι] at h5
  have hfin : (show ULift.{u+1} C(X.left.left, Fin r → ℚ_[ℓ]) from
        (E.hom.app (Opposite.op X)).hom x).down t = T (f t) := by
    rw [h5, hA, hB, add_zero]
  exact hfin

theorem wc_strict_punct_Rq_twisted_triv (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (k : ℕ) (V₀ : (wcP1Over F'').left.ProEt) (φ₀ : V₀ ⟶ V₀)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom D.u0 ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.u0 (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom D.u0) :
    ∃ (r : ℕ) (T : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]))
      (τ : (wcRq D.f ℓ k).over (wcPunctOf F'' D.u0 V₀) ≅
        (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over (wcPunctOf F'' D.u0 V₀)),
      (∀ c : ℚ_[ℓ],
        ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1}
            (wcPunctOf F'' D.u0 V₀)).map (wcRqScalar D.f ℓ k c) ≫ τ.hom =
          τ.hom ≫ ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1}
            (wcPunctOf F'' D.u0 V₀)).map
            (wcContSheafMap (wcP1Over F'').left (DistribSMul.toAddMonoidHom (Fin r → ℚ_[ℓ]) c)
              (continuous_const_smul c))) ∧
      ∀ (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcPunctOf F'' D.u0 V₀),
        τ.hom.hom.app (Opposite.op (Over.mk (w ≫ wcPunctOfMap F'' D.u0 φ₀))) =
          τ.hom.hom.app (Opposite.op (Over.mk w)) ≫
            (wcContSheafMap (wcP1Over F'').left T.toAddMonoidHom
              (LinearMap.continuous_of_finiteDimensional T)).hom.app (Opposite.op W) :=
by
  classical

  obtain ⟨a, τ₀, hτ₀⟩ :=
    wc_strict_nbhd_Rq_const_equivariant F' F'' Y n hn2 D ℓ hℓ V₀ A e ε hv hε k

  have hconn : ConnectedSpace V₀.left := by
    have hS : ConnectedSpace (PrimeSpectrum A) :=
      { isPreconnected_univ := isPreconnected_of_forall (IsLocalRing.closedPoint A)
          (fun y _ => ⟨closure {y}, Set.subset_univ _,
            specializes_iff_mem_closure.mp (IsLocalRing.specializes_closedPoint y),
            subset_closure (Set.mem_singleton y), isPreconnected_singleton.closure⟩)
        toNonempty := ⟨IsLocalRing.closedPoint A⟩ }
    have hS' : ConnectedSpace (Spec (.of A)) := hS
    exact Function.Surjective.connectedSpace (Scheme.homeoOfIso e).symm.surjective
      (Scheme.homeoOfIso e).symm.continuous

  let τ₀' : (wcRq D.f ℓ k).over V₀ ≅ (wcContSheaf (wcP1Over F'').left (Fin a → ℚ_[ℓ])).over V₀ :=
    ((Scheme.ProEt.topology (wcP1Over F'').left).overMapPullback AddCommGrpCat.{u+1} φ₀).mapIso τ₀
  have hτ₀' : ∀ c : ℚ_[ℓ],
      ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} V₀).map
          (wcRqScalar D.f ℓ k c) ≫ τ₀'.hom =
        τ₀'.hom ≫ ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} V₀).map
          (wcContSheafMap (wcP1Over F'').left (DistribSMul.toAddMonoidHom (Fin a → ℚ_[ℓ]) c)
            (continuous_const_smul c)) := by
    intro c
    have h := ((Scheme.ProEt.topology (wcP1Over F'').left).overMapPullback AddCommGrpCat.{u+1}
      φ₀).congr_map (hτ₀ c)
    rw [Functor.map_comp, Functor.map_comp] at h
    exact h
  have hEc : ∀ c : ℚ_[ℓ],
      ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} V₀).map
          (wcContSheafMap (wcP1Over F'').left (DistribSMul.toAddMonoidHom (Fin a → ℚ_[ℓ]) c)
            (continuous_const_smul c)) ≫ (τ₀.inv ≫ τ₀'.hom) =
        (τ₀.inv ≫ τ₀'.hom) ≫
          ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} V₀).map
            (wcContSheafMap (wcP1Over F'').left (DistribSMul.toAddMonoidHom (Fin a → ℚ_[ℓ]) c)
              (continuous_const_smul c)) := by
    intro c
    have h1 : ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} V₀).map
          (wcContSheafMap (wcP1Over F'').left (DistribSMul.toAddMonoidHom (Fin a → ℚ_[ℓ]) c)
            (continuous_const_smul c)) ≫ τ₀.inv =
        τ₀.inv ≫ ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} V₀).map
          (wcRqScalar D.f ℓ k c) := by
      rw [Iso.comp_inv_eq, Category.assoc, hτ₀ c, Iso.inv_hom_id_assoc]
    rw [reassoc_of% h1, hτ₀' c, Category.assoc]
  obtain ⟨T, hT⟩ := wc_proet_over_contSheaf_end_linear (wcP1Over F'').left V₀ hconn ℓ a
    (τ₀.inv ≫ τ₀'.hom) hEc
  have hTT₀ : ∀ (W : (wcP1Over F'').left.ProEt) (g : W ⟶ V₀),
      τ₀.hom.hom.app (Opposite.op (Over.mk (g ≫ φ₀))) =
        τ₀.hom.hom.app (Opposite.op (Over.mk g)) ≫
          (wcContSheafMap (wcP1Over F'').left T.toAddMonoidHom
            (LinearMap.continuous_of_finiteDimensional T)).hom.app (Opposite.op W) := by
    intro W g
    have h1 : τ₀'.hom = τ₀.hom ≫
        ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} V₀).map
          (wcContSheafMap (wcP1Over F'').left T.toAddMonoidHom
            (LinearMap.continuous_of_finiteDimensional T)) := by
      rw [← hT, Iso.hom_inv_id_assoc]
    exact congrArg (fun φ => φ.hom.app (Opposite.op (Over.mk g))) h1

  have hD1 : wcPunctOfMap F'' D.u0 φ₀ ≫ wcPunctOfIncl F'' D.u0 V₀ =
      wcPunctOfIncl F'' D.u0 V₀ ≫ φ₀ := by
    apply MorphismProperty.Over.Hom.ext
    exact Limits.pullback.lift_snd _ _ _
  refine ⟨a, T, ((Scheme.ProEt.topology (wcP1Over F'').left).overMapPullback AddCommGrpCat.{u+1}
      (wcPunctOfIncl F'' D.u0 V₀)).mapIso τ₀, ?_, ?_⟩
  · intro c
    have h := ((Scheme.ProEt.topology (wcP1Over F'').left).overMapPullback AddCommGrpCat.{u+1}
      (wcPunctOfIncl F'' D.u0 V₀)).congr_map (hτ₀ c)
    rw [Functor.map_comp, Functor.map_comp] at h
    exact h
  · intro W w
    have e1 : (w ≫ wcPunctOfMap F'' D.u0 φ₀) ≫ wcPunctOfIncl F'' D.u0 V₀ =
        (w ≫ wcPunctOfIncl F'' D.u0 V₀) ≫ φ₀ := by
      rw [Category.assoc, hD1, Category.assoc]
    have h := hTT₀ W (w ≫ wcPunctOfIncl F'' D.u0 V₀)
    rw [← e1] at h
    exact h

theorem wc_skc_punct_iso (F'' : Type u) [Field F'']
    (u0 : Spec (.of F'') ⟶ (wcP1Over F'').left) (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] (e : V₀.left ≅ Spec (.of A)) (ϖ : A)
    (K : Type u) [CommRing K] [Algebra A K] [IsLocalization.Away ϖ K]
    (hcl : ∀ v : V₀.left, V₀.hom v ∈ closure {u0 (IsLocalRing.closedPoint F'')} ↔
      ϖ ∈ (e.hom v).asIdeal) :
    ∃ iK : (wcPunctOf F'' u0 V₀).left ≅ Spec (.of K),
      iK.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap A K)) =
        Limits.pullback.snd (wcPunctOpen F'' u0).ι V₀.hom ≫ e.hom :=
by
  classical
  have hei : ∀ p : Spec (.of A), e.hom.base (e.inv.base p) = p := by
    intro p
    first
    | (change (e.inv ≫ e.hom).base p = p; rw [Iso.inv_hom_id]; rfl)
    | (change (e.inv ≫ e.hom).base p = p; rw [Iso.inv_hom_id]; simp)
    | simp
  have hie : ∀ v : V₀.left, e.inv.base (e.hom.base v) = v := by
    intro v
    first
    | (change (e.hom ≫ e.inv).base v = v; rw [Iso.hom_inv_id]; rfl)
    | (change (e.hom ≫ e.inv).base v = v; rw [Iso.hom_inv_id]; simp)
    | simp
  have hO : ∀ x : (wcP1Over F'').left, x ∈ Set.range (wcPunctOpen F'' u0).ι.base ↔
      x ∉ closure {u0 (IsLocalRing.closedPoint F'')} := by
    intro x
    first
    | (rw [Scheme.Opens.range_ι]; exact Iff.rfl)
    | (constructor
       · rintro ⟨w, rfl⟩; exact w.2
       · intro hx; exact ⟨⟨x, hx⟩, rfl⟩)
  have hsnd : ∀ v : V₀.left,
      v ∈ Set.range (Limits.pullback.snd (wcPunctOpen F'' u0).ι V₀.hom).base ↔
        V₀.hom.base v ∈ Set.range (wcPunctOpen F'' u0).ι.base := by
    intro v
    first
    | (rw [IsOpenImmersion.range_pullback_snd_of_left]; exact Iff.rfl)
    | (constructor
       · rintro ⟨z, rfl⟩
         refine ⟨(Limits.pullback.fst (wcPunctOpen F'' u0).ι V₀.hom).base z, ?_⟩
         change (Limits.pullback.fst (wcPunctOpen F'' u0).ι V₀.hom ≫
             (wcPunctOpen F'' u0).ι).base z =
           (Limits.pullback.snd (wcPunctOpen F'' u0).ι V₀.hom ≫ V₀.hom).base z
         rw [Limits.pullback.condition]
       · rintro ⟨w, hw⟩
         obtain ⟨z, _, hz⟩ := Scheme.Pullback.exists_preimage_pullback w v hw
         exact ⟨z, hz⟩)
  have hrange1 : ∀ p : Spec (.of A),
      p ∈ Set.range (Limits.pullback.snd (wcPunctOpen F'' u0).ι V₀.hom ≫ e.hom).base ↔
        ϖ ∉ p.asIdeal := by
    intro p
    have step : p ∈ Set.range (Limits.pullback.snd (wcPunctOpen F'' u0).ι V₀.hom ≫ e.hom).base ↔
        e.inv.base p ∈ Set.range (Limits.pullback.snd (wcPunctOpen F'' u0).ι V₀.hom).base := by
      constructor
      · rintro ⟨z, hz⟩
        refine ⟨z, ?_⟩
        rw [← hz]
        exact (hie _).symm
      · rintro ⟨z, hz⟩
        refine ⟨z, ?_⟩
        change e.hom.base ((Limits.pullback.snd (wcPunctOpen F'' u0).ι V₀.hom).base z) = p
        rw [hz, hei]
    have hc : V₀.hom.base (e.inv.base p) ∈ closure {u0 (IsLocalRing.closedPoint F'')} ↔
        ϖ ∈ p.asIdeal := by
      refine (hcl (e.inv.base p)).trans ?_
      first
      | rw [hei]
      | erw [hei]
      | simp [hei]
    rw [step, hsnd, hO]
    exact not_congr hc
  have hrange2 : ∀ p : Spec (.of A),
      p ∈ Set.range (Spec.map (CommRingCat.ofHom (algebraMap A K))).base ↔ ϖ ∉ p.asIdeal := by
    intro p
    have hr := PrimeSpectrum.localization_away_comap_range K ϖ
    have e2 : Set.range (Spec.map (CommRingCat.ofHom (algebraMap A K))).base =
        Set.range (PrimeSpectrum.comap (algebraMap A K)) := by
      first
      | rfl
      | (ext x; simp [Spec.map_base_apply])
      | (congr 1; ext x; exact Spec.map_base_apply _ _)
    rw [e2, hr]
    first
    | exact Iff.rfl
    | exact PrimeSpectrum.mem_basicOpen _ _
    | simp
  haveI : IsOpenImmersion (Spec.map (CommRingCat.ofHom (algebraMap A K))) :=
    IsOpenImmersion.of_isLocalization ϖ
  haveI : IsOpenImmersion (Limits.pullback.snd (wcPunctOpen F'' u0).ι V₀.hom ≫ e.hom) :=
    inferInstance
  have h : Set.range (Limits.pullback.snd (wcPunctOpen F'' u0).ι V₀.hom ≫ e.hom).base =
      Set.range (Spec.map (CommRingCat.ofHom (algebraMap A K))).base :=
    Set.ext fun p => (hrange1 p).trans (hrange2 p).symm
  have hfac := IsOpenImmersion.isoOfRangeEq_hom_fac
    (Limits.pullback.snd (wcPunctOpen F'' u0).ι V₀.hom ≫ e.hom)
    (Spec.map (CommRingCat.ofHom (algebraMap A K))) h
  first
  | exact ⟨_, hfac⟩
  | exact Exists.intro _ hfac
  | exact (show ∃ iK : Limits.pullback (wcPunctOpen F'' u0).ι V₀.hom ≅ Spec (.of K),
        iK.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap A K)) =
          Limits.pullback.snd (wcPunctOpen F'' u0).ι V₀.hom ≫ e.hom from ⟨_, hfac⟩)

theorem wc_skc_punct_field_data (F'' : Type u) [Field F''] [Finite F'']
    (u0 : Spec (.of F'') ⟶ (wcP1Over F'').left) (hu0 : u0 ≫ (wcP1Over F'').hom = 𝟙 _)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (V₀ : (wcP1Over F'').left.ProEt) (φ₀ : V₀ ⟶ V₀)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom u0 ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = u0 (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom u0)
    (hεφ : ε.inv ≫ Limits.pullback.fst V₀.hom u0 ≫ φ₀.left =
      Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
        (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
          AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫
        ε.inv ≫ Limits.pullback.fst V₀.hom u0) :
    ∃ (K : Type u) (_ : Field K) (iK : (wcPunctOf F'' u0 V₀).left ≅ Spec (CommRingCat.of K))
      (ρK : K ≃+* K) (ϖ : K),
      iK.inv ≫ (wcPunctOfMap F'' u0 φ₀).left ≫ iK.hom =
        Spec.map (CommRingCat.ofHom (ρK : K →+* K)) ∧
      ((ℓ : ℕ) : K) ≠ 0 ∧ ϖ ≠ 0 ∧ ρK ϖ = ϖ ∧
      (∀ m : ℕ, Nat.card {ζ : K // ζ ^ (ℓ ^ m) = 1} = ℓ ^ m) ∧
      (∀ m : ℕ, ∀ x : K, x ≠ 0 → ∃ (k : ℤ) (y : K), y ≠ 0 ∧ x = ϖ ^ k * y ^ (ℓ ^ m)) ∧
      (∀ m : ℕ, ∀ k : ℤ, (∃ y : K, ϖ ^ k = y ^ (ℓ ^ m)) → ((ℓ ^ m : ℕ) : ℤ) ∣ k) ∧
      (∀ m : ℕ, ∀ ζ : K, ζ ^ (ℓ ^ m) = 1 → (ρK ζ) ^ Nat.card F'' = ζ) :=
by
  classical

  obtain ⟨c, ψ, j, hj, hfac, hW, hcl⟩ := wc_skc_chart_factor F'' u0 hu0 V₀ A e hv
  have hei : ∀ p, e.hom (e.inv p) = p := by
    intro p
    first
    | simp
    | (rw [← Scheme.Hom.comp_apply, Iso.inv_hom_id]; rfl)
  have heh : ∀ x, e.inv (e.hom x) = x := by
    intro x
    first
    | simp
    | (rw [← Scheme.Hom.comp_apply, Iso.hom_inv_id]; rfl)
  have hϖm : ψ (Polynomial.X - Polynomial.C c) ∈ IsLocalRing.maximalIdeal A := by
    have h1 := (hcl (e.inv (IsLocalRing.closedPoint A))).mp
      (by rw [hv]; exact subset_closure (Set.mem_singleton _))
    have h2 : e.hom (e.inv (IsLocalRing.closedPoint A)) = IsLocalRing.closedPoint A := hei _
    have h3 := congrArg PrimeSpectrum.asIdeal h2
    first
    | (erw [hei] at h1; exact h1)
    | (rw [h3] at h1; exact h1)
    | (simp only [h3] at h1; exact h1)
    | (convert h1 using 1; exact h3.symm)
  obtain ⟨hdom, hϖ0, hval⟩ := wc_skc_dvr F'' A c ψ hW hϖm
  haveI := hdom
  have hmax_sub : ∀ P : Ideal A, ψ (Polynomial.X - Polynomial.C c) ∈ P →
      IsLocalRing.maximalIdeal A ≤ P := by
    intro P hP a ha
    by_cases h0 : a = 0
    · rw [h0]; exact P.zero_mem
    obtain ⟨u, n, hun⟩ := hval a h0
    cases n with
    | zero =>
      exfalso
      rw [pow_zero, mul_one] at hun
      exact (IsLocalRing.mem_maximalIdeal _).mp ha (by rw [hun]; exact u.isUnit)
    | succ n =>
      rw [hun]
      exact P.mul_mem_left _ (P.pow_mem_of_mem hP _ (Nat.succ_pos n))
  have hfib : ∀ v : V₀.left, V₀.hom v = u0 (IsLocalRing.closedPoint F'') →
      v = e.inv (IsLocalRing.closedPoint A) := by
    intro v hv'
    have h1 := (hcl v).mp (by rw [hv']; exact subset_closure (Set.mem_singleton _))
    have h2 : e.hom v = IsLocalRing.closedPoint A := by
      apply PrimeSpectrum.ext
      exact le_antisymm (IsLocalRing.le_maximalIdeal (e.hom v).isPrime.ne_top) (hmax_sub _ h1)
    have h4 := heh v
    first
    | (rw [h2] at h4; exact h4.symm)
    | (erw [h2] at h4; exact h4.symm)
    | (rw [← h2]; erw [heh])

  obtain ⟨ρ, hρ⟩ : ∃ ρ : A →+* A, e.inv ≫ φ₀.left ≫ e.hom = Spec.map (CommRingCat.ofHom ρ) :=
    ⟨(Spec.preimage (R := CommRingCat.of A) (S := CommRingCat.of A)
      (e.inv ≫ φ₀.left ≫ e.hom)).hom, by
        rw [CommRingCat.ofHom_hom]; exact (Spec.map_preimage _).symm⟩
  have hφw : φ₀.left ≫ V₀.hom = V₀.hom := MorphismProperty.Over.w φ₀
  have hρψ : ρ.comp ψ = ψ := by
    have h1 : Spec.map (CommRingCat.ofHom ρ) ≫ Spec.map (CommRingCat.ofHom ψ) ≫ j =
        Spec.map (CommRingCat.ofHom ψ) ≫ j := by
      rw [← hfac, ← hρ]
      simp only [Category.assoc, Iso.hom_inv_id_assoc, hφw]
    haveI := hj
    have h2 : Spec.map (CommRingCat.ofHom ρ) ≫ Spec.map (CommRingCat.ofHom ψ) =
        Spec.map (CommRingCat.ofHom ψ) := by
      rw [← cancel_mono j, Category.assoc, h1]
    rw [← Spec.map_comp] at h2
    have h3 := Spec.map_injective h2
    have h4 := congrArg CommRingCat.Hom.hom h3
    first
    | exact h4
    | simpa using h4
  have hρϖ : ρ (ψ (Polynomial.X - Polynomial.C c)) = ψ (Polynomial.X - Polynomial.C c) :=
    RingHom.congr_fun hρψ _
  have hρloc : IsLocalHom ρ := by
    constructor
    intro a ha
    by_cases h0 : a = 0
    · rw [h0, map_zero] at ha
      exact absurd ha not_isUnit_zero
    obtain ⟨u, n, hun⟩ := hval a h0
    cases n with
    | zero => rw [hun, pow_zero, mul_one]; exact u.isUnit
    | succ n =>
      exfalso
      rw [hun, map_mul, map_pow, hρϖ] at ha
      exact (IsLocalRing.mem_maximalIdeal _).mp
        (Ideal.mul_mem_left _ _ (Ideal.pow_mem_of_mem _ hϖm _ (Nat.succ_pos n))) ha
  have hbij := wc_skc_rho_bijective (Polynomial F'') A ψ ρ hW hρψ hρloc
  let ρe : A ≃+* A := RingEquiv.ofBijective ρ hbij

  obtain ⟨r, hrker, hrfrob⟩ := wc_skc_frob_residue F'' u0 V₀ φ₀ A e ε hεφ ρ hρ hfib
  have hℓF : ((ℓ : ℕ) : F'') ≠ 0 := by
    haveI := Fintype.ofFinite F''
    have hq0 : ((Nat.card F'' : ℕ) : F'') = 0 := by
      rw [Nat.card_eq_fintype_card]
      first
      | exact FiniteField.cast_card_eq_zero F''
      | exact CharP.cast_card_eq_zero F''
    have hcop : Nat.Coprime ℓ (Nat.card F'') :=
      (Nat.Prime.coprime_iff_not_dvd (Fact.out : ℓ.Prime)).mpr hℓ
    have hbez := Nat.gcd_eq_gcd_ab ℓ (Nat.card F'')
    rw [hcop.gcd_eq_one] at hbez
    intro h
    have h5 := congrArg (Int.cast : ℤ → F'') hbez
    push_cast at h5
    rw [h, hq0] at h5
    simp at h5
  have hℓA : IsUnit ((ℓ : ℕ) : A) := by
    have h1 : IsUnit (Polynomial.C ((ℓ : ℕ) : F'')) := Polynomial.isUnit_C.mpr (Ne.isUnit hℓF)
    have h2 := h1.map ψ
    simpa using h2
  have hhens : ∀ m : ℕ, (∀ u : Aˣ, ∃ v : A, v ^ (ℓ ^ m) = u) ∧
      Nat.card {ζ : A // ζ ^ (ℓ ^ m) = 1} = ℓ ^ m ∧
      ∀ ζ₁ ζ₂ : A, ζ₁ ^ (ℓ ^ m) = 1 → ζ₂ ^ (ℓ ^ m) = 1 →
        ζ₁ - ζ₂ ∈ IsLocalRing.maximalIdeal A → ζ₁ = ζ₂ := by
    intro m
    apply wc_skc_hensel_roots A (ℓ ^ m)
    rw [Nat.cast_pow]
    exact hℓA.pow m

  obtain ⟨ρK, hcompat, hAway, hℓK, hϖK, hρϖK, hK1, hK2, hK3, hFr⟩ :=
    wc_skc_kummer_from_dvr A (ψ (Polynomial.X - Polynomial.C c)) ρe ℓ (Nat.card F'')
      (AlgebraicClosure F'') r hϖm hϖ0 hval hρϖ hℓA (fun m => (hhens m).1)
      (fun m => (hhens m).2.1) (fun m => (hhens m).2.2) hrker hrfrob
  haveI := hAway
  obtain ⟨iK, hiK⟩ := wc_skc_punct_iso F'' u0 V₀ A e (ψ (Polynomial.X - Polynomial.C c))
    (FractionRing A) hcl
  refine ⟨FractionRing A, inferInstance, iK, ρK,
    algebraMap A (FractionRing A) (ψ (Polynomial.X - Polynomial.C c)), ?_, hℓK, hϖK, hρϖK,
    hK1, hK2, hK3, hFr⟩
  haveI : IsOpenImmersion (Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A)))) :=
    IsOpenImmersion.of_isLocalization (ψ (Polynomial.X - Polynomial.C c))
  rw [← cancel_mono (Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A))))]
  have hPS : (wcPunctOfMap F'' u0 φ₀).left ≫ Limits.pullback.snd (wcPunctOpen F'' u0).ι V₀.hom =
      Limits.pullback.snd (wcPunctOpen F'' u0).ι V₀.hom ≫ φ₀.left :=
    Limits.pullback.lift_snd _ _ _
  have hρ' : φ₀.left ≫ e.hom = e.hom ≫ Spec.map (CommRingCat.ofHom ρ) := by
    rw [← hρ]; simp
  have hPS' : ∀ {Z : Scheme.{u}} (h : V₀.left ⟶ Z),
      (wcPunctOfMap F'' u0 φ₀).left ≫ Limits.pullback.snd (wcPunctOpen F'' u0).ι V₀.hom ≫ h =
        Limits.pullback.snd (wcPunctOpen F'' u0).ι V₀.hom ≫ φ₀.left ≫ h := fun h =>
    (Category.assoc _ _ _).symm.trans ((eq_whisker hPS h).trans (Category.assoc _ _ _))
  have hiK' : ∀ {Z : Scheme.{u}} (h : Spec (CommRingCat.of A) ⟶ Z),
      Limits.pullback.snd (wcPunctOpen F'' u0).ι V₀.hom ≫ e.hom ≫ h =
        iK.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A))) ≫ h := fun h =>
    (Category.assoc _ _ _).symm.trans ((eq_whisker hiK.symm h).trans (Category.assoc _ _ _))
  have hring : CommRingCat.ofHom ρ ≫ CommRingCat.ofHom (algebraMap A (FractionRing A)) =
      CommRingCat.ofHom (algebraMap A (FractionRing A)) ≫
        CommRingCat.ofHom (ρK : FractionRing A →+* FractionRing A) := by
    first
    | exact CommRingCat.hom_ext (RingHom.ext fun a => (hcompat a).symm)
    | (ext a; exact (hcompat a).symm)
    | (ext a; simp [hcompat, ρe])
  simp only [Category.assoc, hiK]
  refine (whisker_eq iK.inv (hPS' e.hom)).trans ?_
  refine (whisker_eq iK.inv (whisker_eq (Limits.pullback.snd (wcPunctOpen F'' u0).ι V₀.hom)
    hρ')).trans ?_
  refine (whisker_eq iK.inv (hiK' (Spec.map (CommRingCat.ofHom ρ)))).trans ?_
  refine (Iso.inv_hom_id_assoc iK _).trans ?_
  exact (Spec.map_comp _ _).symm.trans ((congrArg Spec.map hring).trans (Spec.map_comp _ _))

theorem wc_strict_punct_kummer_core (F'' : Type u) [Field F''] [Finite F'']
    (u0 : Spec (.of F'') ⟶ (wcP1Over F'').left) (hu0 : u0 ≫ (wcP1Over F'').hom = 𝟙 _)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (V₀ : (wcP1Over F'').left.ProEt) (φ₀ : V₀ ⟶ V₀)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom u0 ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = u0 (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom u0)
    (hεφ : ε.inv ≫ Limits.pullback.fst V₀.hom u0 ≫ φ₀.left =
      Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
        (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
          AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫
        ε.inv ≫ Limits.pullback.fst V₀.hom u0)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1})
    (s : ℚ_[ℓ] → (G ⟶ G)) (r : ℕ) (T : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]))
    (τ : G.over (wcPunctOf F'' u0 V₀) ≅
      (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over (wcPunctOf F'' u0 V₀))
    (hτs : ∀ c : ℚ_[ℓ],
      ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1}
          (wcPunctOf F'' u0 V₀)).map (s c) ≫ τ.hom =
        τ.hom ≫ ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1}
          (wcPunctOf F'' u0 V₀)).map
          (wcContSheafMap (wcP1Over F'').left (DistribSMul.toAddMonoidHom (Fin r → ℚ_[ℓ]) c)
            (continuous_const_smul c)))
    (hτT : ∀ (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcPunctOf F'' u0 V₀),
      τ.hom.hom.app (Opposite.op (Over.mk (w ≫ wcPunctOfMap F'' u0 φ₀))) =
        τ.hom.hom.app (Opposite.op (Over.mk w)) ≫
          (wcContSheafMap (wcP1Over F'').left T.toAddMonoidHom
            (LinearMap.continuous_of_finiteDimensional T)).hom.app (Opposite.op W)) :
    ∃ Θ : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left (wcPunctOf F'' u0 V₀)) G 1 →+
        Abelian.Ext (wcFreeSheaf (wcP1Over F'').left (wcPunctOf F'' u0 V₀)) G 0,
      Function.Bijective Θ ∧
      (∀ (c : ℚ_[ℓ]) (x : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left (wcPunctOf F'' u0 V₀)) G 1),
        Θ (x.comp (Abelian.Ext.mk₀ (s c)) (add_zero 1)) =
          (Θ x).comp (Abelian.Ext.mk₀ (s c)) (add_zero 0)) ∧
      ∀ x : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left (wcPunctOf F'' u0 V₀)) G 1,
        Θ ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left (wcPunctOfMap F'' u0 φ₀))).comp x
            (zero_add 1)) =
          ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left (wcPunctOfMap F'' u0 φ₀))).comp
              (Θ x) (zero_add 0)).comp (Abelian.Ext.mk₀ (s (Nat.card F'' : ℚ_[ℓ]))) (add_zero 0) :=
by
  classical
  obtain ⟨K, hK, iK, ρK, ϖ, hρ, hℓK, hϖ, hρϖ, hK1, hK2, hK3, hρζ⟩ :=
    wc_skc_punct_field_data F'' u0 hu0 ℓ hℓ V₀ φ₀ A e ε hv hε hεφ
  obtain ⟨γ, hγinj, hγsurj, hγF⟩ :=
    wc_kummer_ladic_galois K ℓ (Nat.card F'') ϖ ρK hℓK hϖ hρϖ hK1 hK2 hK3 hρζ r
  obtain ⟨ρL, Φ1, Φ0, hρL, hΦ1inj, hΦ1hom, hΦ1surj, hΦ1s, hΦ0s, hΦ1F, hΦ0F⟩ :=
    wc_field_point_ext_galois ℓ (wcP1Over F'').left (wcPunctOf F'' u0 V₀)
      (wcPunctOfMap F'' u0 φ₀) K iK ρK hρ G s r T τ hτs hτT

  let γ' : SeparableClosure K ≃ₐ[K] SeparableClosure K :=
    AlgEquiv.ofRingEquiv (f := ρL.trans (γ.toRingEquiv.trans ρL.symm)) (fun x => by
      show ρL.symm (γ (ρL (algebraMap K (SeparableClosure K) x))) = algebraMap K _ x
      rw [hρL, AlgEquiv.commutes, RingEquiv.symm_apply_eq]
      exact (hρL x).symm)
  have hγ' : ∀ z, ρL (γ' z) = γ (ρL z) := by
    intro z
    show ρL (ρL.symm (γ (ρL z))) = _
    exact ρL.apply_symm_apply _

  have hTsurj : Function.Surjective T := by
    intro v
    refine ⟨Φ0 ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left
      (wcPunctOfMap F'' u0 φ₀))).comp (Φ0.symm v) (zero_add 0)), ?_⟩
    rw [hΦ0F, Φ0.apply_symm_apply]
  have hTinj : Function.Injective T := LinearMap.injective_iff_surjective.mpr hTsurj
  let Θ : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left (wcPunctOf F'' u0 V₀)) G 1 →+
      Abelian.Ext (wcFreeSheaf (wcP1Over F'').left (wcPunctOf F'' u0 V₀)) G 0 :=
    Φ0.symm.toAddMonoidHom.comp ((Pi.evalAddMonoidHom (fun _ => Fin r → ℚ_[ℓ]) γ).comp Φ1)
  have hΘ : ∀ x, Φ0 (Θ x) = Φ1 x γ := by
    intro x
    show Φ0 (Φ0.symm (Φ1 x γ)) = _
    exact Φ0.apply_symm_apply _
  refine ⟨Θ, ⟨?_, ?_⟩, ?_, ?_⟩
  · rw [injective_iff_map_eq_zero]
    intro x hx
    have h0 : Φ1 x γ = 0 := by rw [← hΘ, hx, map_zero]
    have hf := hγinj (Φ1 x) (hΦ1hom x).1 (hΦ1hom x).2 h0
    exact hΦ1inj (by rw [hf, map_zero])
  · intro y
    obtain ⟨f, hfc, hfh, hfγ⟩ := hγsurj (Φ0 y)
    obtain ⟨x, hx⟩ := hΦ1surj f hfc hfh
    refine ⟨x, Φ0.injective ?_⟩
    rw [hΘ, hx, hfγ]
  · intro c x
    apply Φ0.injective
    rw [hΘ, hΦ0s, hΘ, hΦ1s, Pi.smul_apply]
  · intro x
    apply Φ0.injective
    rw [hΘ, hΦ0s]
    apply hTinj
    rw [map_smul, hΦ0F, hΦ1F x γ γ' hγ', hΘ]
    exact hγF ρL hρL γ' hγ' (Φ1 x) (hΦ1hom x).1 (hΦ1hom x).2

theorem wc_pencil_strict_punct_kummer (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (k : ℕ) (V₀ : (wcP1Over F'').left.ProEt) (φ₀ : V₀ ⟶ V₀)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom D.u0 ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.u0 (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom D.u0)
    (hεφ : ε.inv ≫ Limits.pullback.fst V₀.hom D.u0 ≫ φ₀.left =
      Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
        (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
          AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫
        ε.inv ≫ Limits.pullback.fst V₀.hom D.u0) :
    ∃ κ : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V₀) (wcRq D.f ℓ k) 0 →+
        Abelian.Ext (wcFreeSheaf (wcP1Over F'').left (wcPunctOf F'' D.u0 V₀)) (wcRq D.f ℓ k) 1,
      Function.Bijective κ ∧
      (∀ (c : ℚ_[ℓ]) (y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V₀) (wcRq D.f ℓ k) 0),
        κ (y.comp (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ k c)) (add_zero 0)) =
          (κ y).comp (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ k c)) (add_zero 1)) ∧
      ∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V₀) (wcRq D.f ℓ k) 0,
        (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left (wcPunctOfMap F'' D.u0 φ₀))).comp
            (κ y) (zero_add 1) =
          (κ ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left φ₀)).comp y (zero_add 0))).comp
            (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ k (Nat.card F'' : ℚ_[ℓ]))) (add_zero 1) :=
by
  classical
  have hres := wc_strict_punct_Rq_restrict_bij F' F'' Y n hn2 D ℓ hℓ k V₀ A e ε hv hε
  obtain ⟨r, T, τ, hτs, hτT⟩ :=
    wc_strict_punct_Rq_twisted_triv F' F'' Y n hn2 D ℓ hℓ k V₀ φ₀ A e ε hv hε
  obtain ⟨Θ, hΘbij, hΘs, hΘF⟩ := wc_strict_punct_kummer_core F'' D.u0 D.hu0 ℓ hℓ V₀ φ₀ A e ε
    hv hε hεφ (wcRq D.f ℓ k) (wcRqScalar D.f ℓ k) r T τ hτs hτT
  have hfun : ∀ {U V W : (wcP1Over F'').left.ProEt} (a : U ⟶ V) (b : V ⟶ W),
      wcFreeSheafMap (wcP1Over F'').left (a ≫ b) =
        wcFreeSheafMap (wcP1Over F'').left a ≫ wcFreeSheafMap (wcP1Over F'').left b := by
    intro U V W a b
    unfold wcFreeSheafMap
    rw [Functor.map_comp, Functor.whiskerRight_comp, Functor.map_comp]
    rfl
  have hD1 : wcPunctOfMap F'' D.u0 φ₀ ≫ wcPunctOfIncl F'' D.u0 V₀ =
      wcPunctOfIncl F'' D.u0 V₀ ≫ φ₀ := by
    apply MorphismProperty.Over.Hom.ext
    exact Limits.pullback.lift_snd _ _ _
  let res : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V₀) (wcRq D.f ℓ k) 0 →+
      Abelian.Ext (wcFreeSheaf (wcP1Over F'').left (wcPunctOf F'' D.u0 V₀)) (wcRq D.f ℓ k) 0 :=
    (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left (wcPunctOfIncl F'' D.u0 V₀))).precomp
      (wcRq D.f ℓ k) (zero_add 0)
  have hra : ∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V₀) (wcRq D.f ℓ k) 0,
      res y = (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left
        (wcPunctOfIncl F'' D.u0 V₀))).comp y (zero_add 0) := fun y => rfl
  let Θe := AddEquiv.ofBijective Θ hΘbij
  have hΘ2 : ∀ z, Θ (Θe.symm z) = z := fun z => Θe.apply_symm_apply z
  refine ⟨Θe.symm.toAddMonoidHom.comp res, ?_, ?_, ?_⟩
  · exact Θe.symm.bijective.comp hres
  · intro c y
    apply hΘbij.1
    show Θ (Θe.symm (res (y.comp (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ k c)) (add_zero 0)))) =
      Θ ((Θe.symm (res y)).comp (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ k c)) (add_zero 1))
    rw [hΘ2, hΘs, hΘ2, hra, hra, Abelian.Ext.comp_assoc_of_third_deg_zero]
  · intro y
    apply hΘbij.1
    show Θ ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left (wcPunctOfMap F'' D.u0 φ₀))).comp
        (Θe.symm (res y)) (zero_add 1)) =
      Θ ((Θe.symm (res ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left φ₀)).comp y
        (zero_add 0)))).comp (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ k (Nat.card F'' : ℚ_[ℓ])))
          (add_zero 1))
    rw [hΘF, hΘ2, hΘs, hΘ2, hra, hra, Abelian.Ext.mk₀_comp_mk₀_assoc,
      Abelian.Ext.mk₀_comp_mk₀_assoc, ← hfun, ← hfun, hD1]

theorem wc_pencil_local_purity_Q (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hX : WeaklyEtale (Limits.pullback.fst (Over.mk (Limits.pullback.snd D.f D.u0)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    ∃ θ : wcCoh F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2) →+
        Abelian.Ext (Limits.cokernel
          (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' D.u0 hP))) (wcRq D.f ℓ (n - 2)) 2,
      Function.Surjective θ ∧
      (∀ (c : ℚ_[ℓ]) (z : wcCoh F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2)),
        θ (wcCohScalar F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2) c z) =
          (θ z).comp (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ (n - 2) c)) (add_zero 2)) ∧
      ∀ (σ : Limits.cokernel (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' D.u0 hP)) ⟶
          Limits.cokernel (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' D.u0 hP))),
        Limits.cokernel.π (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' D.u0 hP)) ≫ σ =
          wcFreeSheafMap (wcP1Over F'').left (wcGeomFrob F'' (wcP1Over F'') hP) ≫
            Limits.cokernel.π (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' D.u0 hP)) →
        ∀ z : wcCoh F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2),
          (Abelian.Ext.mk₀ σ).comp (θ z) (zero_add 2) =
            (θ (wcCohFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2) z)).comp
              (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ (n - 2) (Nat.card F'' : ℚ_[ℓ]))) (add_zero 2) :=
by
  classical

  obtain ⟨V₀, g₀, φ₀, A, iA, hA, sA, e, ε, hv, hφ, hε, hεφ⟩ :=
    wc_P1bar_strict_local_nbhd F'' D.u0 D.hu0 hP
  have hproj : Projective (wcFreeSheaf (wcP1Over F'').left V₀) :=
    wc_proet_free_projective_strict_local _ V₀ A e
  obtain ⟨κx, hκiso, hκπ⟩ := wc_punct_excision F'' D.u0 D.hu0 hP V₀ g₀ ε hε
  haveI := hκiso
  obtain ⟨κK, hKbij, hKs, hKF⟩ :=
    wc_pencil_strict_punct_kummer F' F'' Y n hn2 D ℓ hℓ (n - 2) V₀ φ₀ A e ε hv hε hεφ
  obtain ⟨Ψ, hΨbij, hΨs, hΨF⟩ :=
    wc_pencil_strict_nbhd_sections_pbc F' F'' Y n hn2 D ℓ hℓ hX (n - 2) V₀ φ₀ A e ε hv hε hεφ

  have hfun : ∀ {U V W : (wcP1Over F'').left.ProEt} (a : U ⟶ V) (b : V ⟶ W),
      wcFreeSheafMap (wcP1Over F'').left (a ≫ b) =
        wcFreeSheafMap (wcP1Over F'').left a ≫ wcFreeSheafMap (wcP1Over F'').left b := by
    intro U V W a b
    unfold wcFreeSheafMap
    rw [Functor.map_comp, Functor.whiskerRight_comp, Functor.map_comp]
    rfl

  have hD1 : wcPunctOfMap F'' D.u0 φ₀ ≫ wcPunctOfIncl F'' D.u0 V₀ =
      wcPunctOfIncl F'' D.u0 V₀ ≫ φ₀ := by
    apply MorphismProperty.Over.Hom.ext
    exact Limits.pullback.lift_snd _ _ _

  have hmono : Mono (wcFreeSheafMap (wcP1Over F'').left (wcPunctOfIncl F'' D.u0 V₀)) := by
    have h1 : Mono (wcPunctOfIncl F'' D.u0 V₀) := by
      have : Mono ((Scheme.ProEt.forget _ ⋙ Over.forget _).map (wcPunctOfIncl F'' D.u0 V₀)) := by
        have hoi : IsOpenImmersion (Limits.pullback.snd (wcPunctOpen F'' D.u0).ι V₀.hom) := by
          infer_instance
        exact @IsOpenImmersion.mono _ _ _ hoi
      exact Functor.mono_of_mono_map _ this
    have h2 : Mono (Functor.whiskerRight (yoneda.map (wcPunctOfIncl F'' D.u0 V₀))
        (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) := by
      have : ∀ W, Mono ((Functor.whiskerRight (yoneda.map (wcPunctOfIncl F'' D.u0 V₀))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app W) := by
        intro W
        rw [Functor.whiskerRight_app]
        have : Mono ((yoneda.map (wcPunctOfIncl F'' D.u0 V₀)).app W) :=
          (NatTrans.mono_iff_mono_app _).mp inferInstance W
        exact Functor.map_mono _ _
      exact NatTrans.mono_of_mono_app _
    unfold wcFreeSheafMap
    exact Functor.map_mono _ _
  have hS : (ShortComplex.mk (wcFreeSheafMap (wcP1Over F'').left (wcPunctOfIncl F'' D.u0 V₀))
      (Limits.cokernel.π (wcFreeSheafMap (wcP1Over F'').left (wcPunctOfIncl F'' D.u0 V₀)))
      (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) hmono inferInstance

  have hιT : wcFreeSheafMap (wcP1Over F'').left (wcPunctOfIncl F'' D.u0 V₀) ≫
      wcFreeSheafMap (wcP1Over F'').left φ₀ ≫
        Limits.cokernel.π (wcFreeSheafMap (wcP1Over F'').left (wcPunctOfIncl F'' D.u0 V₀)) = 0 := by
    rw [← Category.assoc, ← hfun, ← hD1, hfun, Category.assoc, Limits.cokernel.condition,
      Limits.comp_zero]
  obtain ⟨σT, hσT⟩ : ∃ σT : Limits.cokernel (wcFreeSheafMap (wcP1Over F'').left
        (wcPunctOfIncl F'' D.u0 V₀)) ⟶ Limits.cokernel (wcFreeSheafMap (wcP1Over F'').left
        (wcPunctOfIncl F'' D.u0 V₀)),
      Limits.cokernel.π (wcFreeSheafMap (wcP1Over F'').left (wcPunctOfIncl F'' D.u0 V₀)) ≫ σT =
        wcFreeSheafMap (wcP1Over F'').left φ₀ ≫
          Limits.cokernel.π (wcFreeSheafMap (wcP1Over F'').left (wcPunctOfIncl F'' D.u0 V₀)) :=
    ⟨_, Limits.cokernel.π_desc _ _ hιT⟩
  have hnat : hS.extClass.comp (Abelian.Ext.mk₀
        (wcFreeSheafMap (wcP1Over F'').left (wcPunctOfMap F'' D.u0 φ₀))) (add_zero 1) =
      (Abelian.Ext.mk₀ σT).comp hS.extClass (zero_add 1) :=
    hS.extClass_naturality hS
      { τ₁ := wcFreeSheafMap (wcP1Over F'').left (wcPunctOfMap F'' D.u0 φ₀)
        τ₂ := wcFreeSheafMap (wcP1Over F'').left φ₀
        τ₃ := σT
        comm₁₂ := (hfun _ _).symm.trans ((congrArg _ hD1).trans (hfun _ _))
        comm₂₃ := hσT.symm }

  have hδinj : ∀ x : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left (wcPunctOf F'' D.u0 V₀))
      (wcRq D.f ℓ (n - 2)) 1, hS.extClass.comp x (show 1 + 1 = 2 from rfl) = 0 → x = 0 := by
    intro x hx
    obtain ⟨x₂, hx₂⟩ :=
      Abelian.Ext.contravariant_sequence_exact₁ hS _ x (show 1 + 1 = 2 from rfl) hx
    have h0 : x₂ = 0 := @Abelian.Ext.eq_zero_of_projective _ _ _ _ _ _ 0 hproj x₂
    rw [← hx₂, h0, Abelian.Ext.comp_zero]
  have hδsurj : ∀ x₃ : Abelian.Ext (Limits.cokernel (wcFreeSheafMap (wcP1Over F'').left
      (wcPunctOfIncl F'' D.u0 V₀))) (wcRq D.f ℓ (n - 2)) 2,
      ∃ x₁, hS.extClass.comp x₁ (show 1 + 1 = 2 from rfl) = x₃ := by
    intro x₃
    exact Abelian.Ext.contravariant_sequence_exact₃ hS _ x₃
      (@Abelian.Ext.eq_zero_of_projective _ _ _ _ _ _ 1 hproj _) (show 1 + 1 = 2 from rfl)
  have hδF : ∀ w : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left (wcPunctOf F'' D.u0 V₀))
      (wcRq D.f ℓ (n - 2)) 1,
      (Abelian.Ext.mk₀ σT).comp (hS.extClass.comp w (show 1 + 1 = 2 from rfl)) (zero_add 2) =
        hS.extClass.comp ((Abelian.Ext.mk₀
          (wcFreeSheafMap (wcP1Over F'').left (wcPunctOfMap F'' D.u0 φ₀))).comp w (zero_add 1))
          (show 1 + 1 = 2 from rfl) := by
    intro w
    rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 1) (show 1 + 1 = 2 from rfl)
        (show 0 + 1 + 1 = 2 from rfl), ← hnat,
      Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (zero_add 1) (show 1 + 0 + 1 = 2 from rfl)]

  have hinv : ∀ (σ : Limits.cokernel (wcFreeSheafMap (wcP1Over F'').left
        (wcPunctIncl F'' D.u0 hP)) ⟶
        Limits.cokernel (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' D.u0 hP))),
      Limits.cokernel.π (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' D.u0 hP)) ≫ σ =
        wcFreeSheafMap (wcP1Over F'').left (wcGeomFrob F'' (wcP1Over F'') hP) ≫
          Limits.cokernel.π (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' D.u0 hP)) →
      inv κx ≫ σT = σ ≫ inv κx := by
    intro σ hσ
    have e1 : Limits.cokernel.π (wcFreeSheafMap (wcP1Over F'').left
          (wcPunctOfIncl F'' D.u0 V₀)) ≫ κx ≫ σ =
        wcFreeSheafMap (wcP1Over F'').left (g₀ ≫ wcGeomFrob F'' (wcP1Over F'') hP) ≫
          Limits.cokernel.π (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' D.u0 hP)) := by
      rw [reassoc_of% hκπ, hσ, hfun, Category.assoc]
    have e2 : Limits.cokernel.π (wcFreeSheafMap (wcP1Over F'').left
          (wcPunctOfIncl F'' D.u0 V₀)) ≫ σT ≫ κx =
        wcFreeSheafMap (wcP1Over F'').left (φ₀ ≫ g₀) ≫
          Limits.cokernel.π (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' D.u0 hP)) := by
      rw [reassoc_of% hσT, hκπ, hfun, Category.assoc]
    have hkey : κx ≫ σ = σT ≫ κx :=
      (cancel_epi (Limits.cokernel.π (wcFreeSheafMap (wcP1Over F'').left
        (wcPunctOfIncl F'' D.u0 V₀)))).mp (by rw [e1, e2, hφ])
    rw [IsIso.inv_comp_eq, ← Category.assoc, hkey, Category.assoc, IsIso.hom_inv_id,
      Category.comp_id]

  let Ψe := AddEquiv.ofBijective Ψ hΨbij
  have hΨ1 : ∀ y, Ψe.symm (Ψ y) = y := fun y => Ψe.symm_apply_apply y
  have hΨ2 : ∀ z, Ψ (Ψe.symm z) = z := fun z => Ψe.apply_symm_apply z
  have hs1 : ∀ (c : ℚ_[ℓ]) (z : wcCoh F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2)),
      Ψe.symm (wcCohScalar F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2) c z) =
        (Ψe.symm z).comp (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ (n - 2) c)) (add_zero 0) := by
    intro c z
    apply hΨbij.1
    rw [hΨ2, hΨs, hΨ2]
  have hsF : ∀ z : wcCoh F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2),
      Ψe.symm (wcCohFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2) z) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left φ₀)).comp (Ψe.symm z)
          (zero_add 0) := by
    intro z
    apply hΨbij.1
    rw [hΨ2, hΨF, hΨ2]
  let δ : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left (wcPunctOf F'' D.u0 V₀))
      (wcRq D.f ℓ (n - 2)) 1 →+ Abelian.Ext (Limits.cokernel (wcFreeSheafMap (wcP1Over F'').left
      (wcPunctOfIncl F'' D.u0 V₀))) (wcRq D.f ℓ (n - 2)) 2 :=
    hS.extClass.precomp (wcRq D.f ℓ (n - 2)) (show 1 + 1 = 2 from rfl)
  refine ⟨((Abelian.Ext.mk₀ (inv κx)).precomp (wcRq D.f ℓ (n - 2)) (zero_add 2)).comp
    (δ.comp (κK.comp Ψe.symm.toAddMonoidHom)), ?_, ?_, ?_⟩
  ·
    intro t
    obtain ⟨x₁, hx₁⟩ := hδsurj ((Abelian.Ext.mk₀ κx).comp t (zero_add 2))
    obtain ⟨y, hy⟩ := hKbij.2 x₁
    refine ⟨Ψ y, ?_⟩
    show (Abelian.Ext.mk₀ (inv κx)).comp (hS.extClass.comp (κK (Ψe.symm (Ψ y)))
      (show 1 + 1 = 2 from rfl)) (zero_add 2) = t
    rw [hΨ1, hy, hx₁, Abelian.Ext.mk₀_comp_mk₀_assoc, IsIso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
  ·
    intro c z
    show (Abelian.Ext.mk₀ (inv κx)).comp (hS.extClass.comp (κK (Ψe.symm
        (wcCohScalar F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2) c z)))
          (show 1 + 1 = 2 from rfl)) (zero_add 2) =
      ((Abelian.Ext.mk₀ (inv κx)).comp (hS.extClass.comp (κK (Ψe.symm z))
          (show 1 + 1 = 2 from rfl)) (zero_add 2)).comp
        (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ (n - 2) c)) (add_zero 2)
    rw [hs1, hKs, Abelian.Ext.comp_assoc_of_third_deg_zero,
      Abelian.Ext.comp_assoc_of_third_deg_zero]
  ·
    intro σ hσ z
    show (Abelian.Ext.mk₀ σ).comp ((Abelian.Ext.mk₀ (inv κx)).comp
        (hS.extClass.comp (κK (Ψe.symm z)) (show 1 + 1 = 2 from rfl)) (zero_add 2)) (zero_add 2) =
