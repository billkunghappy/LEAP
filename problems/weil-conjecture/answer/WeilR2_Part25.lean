  haveI := hpr
  haveI := hsm
  have hd : Even (n - 2) := (Nat.even_sub hn2).mpr (iff_of_true hn even_two)
  have hodd := wc_even_quadric_zmod_odd_vanish F'' ℓ hℓ (n - 2) hd E₀ jE hjE hjEY a ha hEG hE k
