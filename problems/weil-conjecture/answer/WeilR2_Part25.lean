        (wcCohFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2) z)))
          (show 1 + 1 = 2 from rfl)) (zero_add 2)).comp
        (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ (n - 2) (Nat.card F'' : ℚ_[ℓ]))) (add_zero 2)
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc, ← hinv σ hσ, ← Abelian.Ext.mk₀_comp_mk₀_assoc, hδF, hKF,
      ← hsF z, Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.comp_assoc_of_third_deg_zero]

theorem wc_pencil_local_purity (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hX : WeaklyEtale (Limits.pullback.fst (Over.mk (Limits.pullback.snd D.f D.u0)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    ∃ θ : wcCoh F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2) →+
        Abelian.Ext (Limits.cokernel
          (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' D.u0 hP))) (wcRq D.f ℓ (n - 2)) 2,
      Function.Surjective θ ∧
      (∀ (c : ℚ_[ℓ]) (z : wcCoh F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2)),
        θ (wcCohScalar F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2) c z) =
          (θ z).comp (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ (n - 2) c)) (add_zero 2)) ∧
      ∀ z : wcCoh F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2),
        wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - 2)) 2
            ((Abelian.Ext.mk₀ (Limits.cokernel.π
              (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' D.u0 hP)))).comp
              (θ z) (zero_add 2)) =
          wcCohGEnd F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - 2)) 2
            (wcRqScalar D.f ℓ (n - 2) (Nat.card F'' : ℚ_[ℓ]))
            ((Abelian.Ext.mk₀ (Limits.cokernel.π
              (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' D.u0 hP)))).comp
              (θ (wcCohFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2) z))
              (zero_add 2)) :=
by
  classical

  have ha : (wcGeomFrob F'' (wcP1Over F'') hP).left ≫ Limits.pullback.fst (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
      Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) :=
    MorphismProperty.Over.w (wcGeomFrob F'' (wcP1Over F'') hP)
  have hw : Limits.pullback.fst (wcPunctOpen F'' D.u0).ι (Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) ≫
        (wcPunctOpen F'' D.u0).ι =
      (Limits.pullback.snd (wcPunctOpen F'' D.u0).ι (Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) ≫
        (wcGeomFrob F'' (wcP1Over F'') hP).left) ≫ Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) :=
    Limits.pullback.condition.trans ((whisker_eq _ ha).symm.trans (Category.assoc _ _ _).symm)
  have hlam : Limits.pullback.lift _ _ hw ≫
      (Limits.pullback.snd (wcPunctOpen F'' D.u0).ι (Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) ≫
        Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) =
      Limits.pullback.snd (wcPunctOpen F'' D.u0).ι (Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) ≫
        Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) :=
    (Category.assoc _ _ _).symm.trans ((eq_whisker (Limits.pullback.lift_snd _ _ _) _).trans
      ((Category.assoc _ _ _).trans (whisker_eq _ ha)))
  let σO : wcPunctGeom F'' D.u0 hP ⟶ wcPunctGeom F'' D.u0 hP :=
    MorphismProperty.Over.homMk (Limits.pullback.lift _ _ hw) hlam trivial
  have hd : σO ≫ wcPunctIncl F'' D.u0 hP =
      wcPunctIncl F'' D.u0 hP ≫ wcGeomFrob F'' (wcP1Over F'') hP := by
    apply MorphismProperty.Over.Hom.ext
    exact Limits.pullback.lift_snd _ _ _
  have hfun : ∀ {U V W : (wcP1Over F'').left.ProEt} (a : U ⟶ V) (b : V ⟶ W),
      wcFreeSheafMap (wcP1Over F'').left (a ≫ b) =
        wcFreeSheafMap (wcP1Over F'').left a ≫ wcFreeSheafMap (wcP1Over F'').left b := by
    intro U V W a b
    unfold wcFreeSheafMap
    rw [Functor.map_comp, Functor.whiskerRight_comp, Functor.map_comp]
    rfl
  have hι : wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' D.u0 hP) ≫
      wcFreeSheafMap (wcP1Over F'').left (wcGeomFrob F'' (wcP1Over F'') hP) ≫
        Limits.cokernel.π (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' D.u0 hP)) = 0 := by
    rw [← Category.assoc, ← hfun, ← hd, hfun, Category.assoc, Limits.cokernel.condition,
      Limits.comp_zero]
  let σQ := Limits.cokernel.desc
    (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' D.u0 hP)) _ hι
  have hσQ : Limits.cokernel.π (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' D.u0 hP)) ≫ σQ =
      wcFreeSheafMap (wcP1Over F'').left (wcGeomFrob F'' (wcP1Over F'') hP) ≫
        Limits.cokernel.π (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' D.u0 hP)) :=
    Limits.cokernel.π_desc _ _ _

  obtain ⟨θ, hs, hc, hF⟩ := wc_pencil_local_purity_Q F' F'' Y n hn hn2 D ℓ hℓ hP hX
  refine ⟨θ, hs, hc, fun z => ?_⟩
  have hFz := hF σQ hσQ z

  show (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left (wcGeomFrob F'' (wcP1Over F'') hP))).comp
      ((Abelian.Ext.mk₀ (Limits.cokernel.π
        (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' D.u0 hP)))).comp (θ z) (zero_add 2))
      (zero_add 2) =
    ((Abelian.Ext.mk₀ (Limits.cokernel.π
        (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' D.u0 hP)))).comp
      (θ (wcCohFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2) z))
      (zero_add 2)).comp (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ (n - 2) (Nat.card F'' : ℚ_[ℓ])))
      (add_zero 2)
  rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add 2) (by omega),
    Abelian.Ext.mk₀_comp_mk₀, ← hσQ, ← Abelian.Ext.mk₀_comp_mk₀,
    Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add 2) (by omega), hFz,
    ← Abelian.Ext.comp_assoc _ _ _ (zero_add 2) (add_zero 2) (by omega)]

theorem wc_pencil_E2_two_gysin (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hX : WeaklyEtale (Limits.pullback.fst (Over.mk (Limits.pullback.snd D.f D.u0)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    ∃ γ : wcCoh F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2) →+
        wcCohG F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - 2)) 2,
      Function.Surjective γ ∧
      (∀ (c : ℚ_[ℓ]) (z : wcCoh F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2)),
