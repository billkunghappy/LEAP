      B V' (((wcRq D.f ℓ (n - 1)).obj.map a.op).hom y)
          (((wcRq D.f ℓ (n - 1)).obj.map a.op).hom y') =
        ((wcRq D.f ℓ (2 * (n - 1))).obj.map a.op).hom (B V y y'))
    (hBsc : ∀ (V : (wcP1Over F'').left.ProEt) (c : ℚ_[ℓ])
        (y y' : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)),
      B V (((wcRqScalar D.f ℓ (n - 1) c).hom.app (Opposite.op V)).hom y) y' =
        ((wcRqScalar D.f ℓ (2 * (n - 1)) c).hom.app (Opposite.op V)).hom (B V y y'))
    (hBalt : ∀ (V : (wcP1Over F'').left.ProEt)
        (y y' : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)), B V y y' = -(B V y' y))
    (hBperf : ∀ (V : (wcP1Over F'').left.ProEt) (A : Type u) [CommRing A] [HenselianLocalRing A]
        [IsSepClosed (IsLocalRing.ResidueField A)] (e : V.left ≅ Spec (.of A)),
      IsClosed ({V.hom (e.inv (IsLocalRing.closedPoint A))} : Set (wcP1Over F'').left) →
      (∀ i, V.hom (e.inv (IsLocalRing.closedPoint A)) ≠ D.S i (IsLocalRing.closedPoint F'')) →
      (∀ y, (∀ y', B V y y' = 0) → y = 0) ∧ (∀ y', (∀ y, B V y y' = 0) → y' = 0))
    (hO : ∀ (T : (wcP1Over F'').left.ProEt),
      (∀ (t : T.left) (i : Fin D.m), T.hom t ≠ D.S i (IsLocalRing.closedPoint F'')) →
      ∀ (z : (Subobject.underlying.obj (wcPencilE D ℓ hP)).obj.obj (Opposite.op T))
        (c : (Subobject.underlying.obj (wcPencilC D ℓ hP)).obj.obj (Opposite.op T)),
        B T (((wcPencilE D ℓ hP).arrow.hom.app (Opposite.op T)).hom z)
          (((wcPencilC D ℓ hP).arrow.hom.app (Opposite.op T)).hom c) = 0)
    (hcount : ∀ (V : (wcP1Over F'').left.ProEt) (A : Type u) [CommRing A] [HenselianLocalRing A]
      [IsSepClosed (IsLocalRing.ResidueField A)] (e : V.left ≅ Spec (.of A)),
      IsClosed ({V.hom (e.inv (IsLocalRing.closedPoint A))} : Set (wcP1Over F'').left) →
      (∀ i, V.hom (e.inv (IsLocalRing.closedPoint A)) ≠ D.S i (IsLocalRing.closedPoint F'')) →
      ∃ (a : ℕ) (eR : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V) ≃+ (Fin a → ℚ_[ℓ])),
        (∀ (c : ℚ_[ℓ]) (y : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)),
          eR (((wcRqScalar D.f ℓ (n - 1) c).hom.app (Opposite.op V)).hom y) = c • eR y) ∧
        ∃ UE UC : Submodule ℚ_[ℓ] (Fin a → ℚ_[ℓ]),
          (∀ v, v ∈ UE ↔ ∃ z : (Subobject.underlying.obj (wcPencilE D ℓ hP)).obj.obj (Opposite.op V),
            eR (((wcPencilE D ℓ hP).arrow.hom.app (Opposite.op V)).hom z) = v) ∧
          (∀ v, v ∈ UC ↔ ∃ c : (Subobject.underlying.obj (wcPencilC D ℓ hP)).obj.obj (Opposite.op V),
            eR (((wcPencilC D ℓ hP).arrow.hom.app (Opposite.op V)).hom c) = v) ∧
          a ≤ Module.finrank ℚ_[ℓ] UE + Module.finrank ℚ_[ℓ] UC) :
    ∃ B' : ∀ V : (wcP1Over F'').left.ProEt,
        (∀ (v : V.left) (i : Fin D.m), V.hom v ≠ D.S i (IsLocalRing.closedPoint F'')) →
        (wcPencilVQ D ℓ hP).obj.obj (Opposite.op V) →+ (wcPencilVQ D ℓ hP).obj.obj (Opposite.op V) →+
          (wcRq D.f ℓ (2 * (n - 1))).obj.obj (Opposite.op V),
      (∀ (V V' : (wcP1Over F'').left.ProEt) hV hV' (a : V' ⟶ V)
          (y y' : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op V)),
        B' V' hV' (((wcPencilVQ D ℓ hP).obj.map a.op).hom y) (((wcPencilVQ D ℓ hP).obj.map a.op).hom y') =
          ((wcRq D.f ℓ (2 * (n - 1))).obj.map a.op).hom (B' V hV y y')) ∧
      (∀ (V : (wcP1Over F'').left.ProEt) hV (c : ℚ_[ℓ]) (y y' : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op V)),
        B' V hV (((wcPencilVQScalar D ℓ hP c).hom.app (Opposite.op V)).hom y) y' =
          ((wcRqScalar D.f ℓ (2 * (n - 1)) c).hom.app (Opposite.op V)).hom (B' V hV y y')) ∧
      (∀ (V : (wcP1Over F'').left.ProEt) hV (y y' : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op V)),
        B' V hV y y' = -(B' V hV y' y)) ∧
      (∀ (V : (wcP1Over F'').left.ProEt) hV (A : Type u) [CommRing A] [HenselianLocalRing A]
          [IsSepClosed (IsLocalRing.ResidueField A)] (e : V.left ≅ Spec (.of A)),
        IsClosed ({V.hom (e.inv (IsLocalRing.closedPoint A))} : Set (wcP1Over F'').left) →
        ∀ y, (∀ y', B' V hV y y' = 0) → y = 0) :=
by
  classical
  have hF : ∀ (K : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1})
      {V W Z : (wcP1Over F'').left.ProEt}
      (k : Z ⟶ W) (g : W ⟶ V) (x : K.obj.obj (Opposite.op V)),
      (K.obj.map (k ≫ g).op).hom x = (K.obj.map k.op).hom ((K.obj.map g.op).hom x) := by
    intro K V W Z k g x
    rw [op_comp, Functor.map_comp]
    rfl
  have hN : ∀ {G1 G2 : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      (f : G1 ⟶ G2) {V W : (wcP1Over F'').left.ProEt} (g : W ⟶ V) (y : G1.obj.obj (Opposite.op V)),
