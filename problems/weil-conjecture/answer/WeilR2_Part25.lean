      first
        | rfl
        | (ext x; simp [Scheme.Hom.mem_preimage])
    exact h2.trans (hrange.symm.trans hxb)
  have hcl : IsClosed ({xb} : Set T.left) := by
    have h := (T.hom ⁻¹ᵁ wcCritPunctOpen D i).isOpen
    rw [hOset] at h
