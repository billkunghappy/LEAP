  have hβ2 : β.inv.left ≫ β.hom.left = 𝟙 _ := by
    have h := congrArg (fun k => k.left) β.inv_hom_id
    first
      | exact h
      | simpa using h
      | simpa [MorphismProperty.Comma.comp_left, Comma.comp_left, Over.comp_left] using h
  have φ := (⟨β.hom.left, β.inv.left, hβ1, hβ2⟩ :
      ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
        (wcOpenRestr D.Yt.left ⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ,
          isOpen_compl_iff.mpr isClosed_closure⟩ ((wcProEtPullback D.f).obj V₀))).left ≅
      Limits.pullback (wcCritPunctOpen D i).ι T.hom) ≪≫
    Limits.pullbackSymmetry (wcCritPunctOpen D i).ι T.hom ≪≫
    pullbackRestrictIsoRestrict T.hom (wcCritPunctOpen D i)

  haveI hTc : CompactSpace T.left := QuasiCompact.compactSpace_of_compactSpace (r ≫ ε.hom)
  have hgen : ∀ (Z : Scheme.{u}) (ψ : Z ≅ ((T.hom ⁻¹ᵁ wcCritPunctOpen D i : T.left.Opens) :
      Scheme.{u})), CompactSpace Z ∧ IsSeparated (Limits.terminal.from Z) := by
    intro Z ψ
    haveI hqcι : QuasiCompact (T.hom ⁻¹ᵁ wcCritPunctOpen D i).ι := by
      first
        | exact @AlgebraicGeometry.instQuasiCompactOfIsLocallyNoetherianOfIsOpenImmersion _ _
            hln _ inferInstance
        | infer_instance
    haveI : CompactSpace ↥((𝟭 Scheme.{u}).obj T.left) := hTc
    haveI : CompactSpace ((T.hom ⁻¹ᵁ wcCritPunctOpen D i : T.left.Opens) : Scheme.{u}) := by
      first
        | exact QuasiCompact.compactSpace_of_compactSpace (T.hom ⁻¹ᵁ wcCritPunctOpen D i).ι
        | exact @QuasiCompact.compactSpace_of_compactSpace _ _
            (T.hom ⁻¹ᵁ wcCritPunctOpen D i).ι hTc hqcι
        | exact @QuasiCompact.compactSpace_of_compactSpace _ _
