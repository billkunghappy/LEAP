    rw [show ((ℓ : ℚ_[ℓ]) ^ a) = ((ℓ ^ a : ℕ) : ℚ_[ℓ]) from (Nat.cast_pow ℓ a).symm, ← Q1, hD,
      Abelian.Ext.zero_comp] at h5
    exact h5.symm
  exact sub_eq_zero.mp hz

theorem wc_odp_fibre_local_frob_sq (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V₀ : (wcP1Over F'').left.ProEt) (φ₀ : V₀ ⟶ V₀)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom (D.S i) ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom (D.S i))
    (hεφ : ε.inv ≫ Limits.pullback.fst V₀.hom (D.S i) ≫ φ₀.left =
      Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
        (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
          AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫
        ε.inv ≫ Limits.pullback.fst V₀.hom (D.S i))
    (Φ : Limits.cokernel (wcFreeSheafMap (Limits.pullback D.f (D.S i))
          (wcOpenRestrIncl (Limits.pullback D.f (D.S i)) (wcCritPunctOpen D i)
            ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
              ((wcProEtPullback D.f).obj V₀)))) ⟶
        Limits.cokernel (wcFreeSheafMap (Limits.pullback D.f (D.S i))
          (wcOpenRestrIncl (Limits.pullback D.f (D.S i)) (wcCritPunctOpen D i)
            ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
              ((wcProEtPullback D.f).obj V₀)))))
    (hΦ : Limits.cokernel.π (wcFreeSheafMap (Limits.pullback D.f (D.S i))
          (wcOpenRestrIncl (Limits.pullback D.f (D.S i)) (wcCritPunctOpen D i)
            ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
              ((wcProEtPullback D.f).obj V₀)))) ≫ Φ =
      wcFreeSheafMap (Limits.pullback D.f (D.S i))
          ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).map
            ((wcProEtPullback D.f).map φ₀)) ≫
        Limits.cokernel.π (wcFreeSheafMap (Limits.pullback D.f (D.S i))
          (wcOpenRestrIncl (Limits.pullback D.f (D.S i)) (wcCritPunctOpen D i)
            ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
              ((wcProEtPullback D.f).obj V₀))))) :
    ∀ y : Abelian.Ext (Limits.cokernel (wcFreeSheafMap (Limits.pullback D.f (D.S i))
          (wcOpenRestrIncl (Limits.pullback D.f (D.S i)) (wcCritPunctOpen D i)
            ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
              ((wcProEtPullback D.f).obj V₀)))))
        (wcLadicSheaf (Limits.pullback D.f (D.S i)) ℓ) n,
      (Abelian.Ext.mk₀ Φ).comp ((Abelian.Ext.mk₀ Φ).comp y (zero_add n)) (zero_add n) =
        y.comp (Abelian.Ext.mk₀ (wcLadicScalar (Limits.pullback D.f (D.S i)) ℓ
          ((Nat.card F'' : ℚ_[ℓ]) ^ n))) (add_zero n) :=
by
  classical

  have F0 : ∀ {S : Scheme.{u}} {U V W : S.ProEt} (a : U ⟶ V) (b : V ⟶ W),
      wcFreeSheafMap S (a ≫ b) = wcFreeSheafMap S a ≫ wcFreeSheafMap S b := by
    intro S U V W a b
    have h := (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_comp
      (Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
      (Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    first
      | rw [← Functor.whiskerRight_comp, ← yoneda.map_comp] at h
      | rw [← Functor.comp_whiskerRight, ← yoneda.map_comp] at h
    exact h

  have liftV : ∀ {S : Scheme.{u}} {T To Th VT : S.ProEt} (incl : To ⟶ T)
      (hι : IsOpenImmersion incl.left) (xb : T.left) (hxb : Set.range incl.left = {xb}ᶜ)
      (g : Th ⟶ T) (j : VT ⟶ Th) (c : Th.left) (hpre : g.left ⁻¹' {xb} = {c})
      (hrange : Set.range j.left = {c}ᶜ), ∃ gV : VT ⟶ To, gV ≫ incl = j ≫ g := by
    intro S T To Th VT incl hι xb hxb g j c hpre hrange
    haveI := hι
    have hsub : Set.range (j ≫ g).left ⊆ Set.range incl.left := by
      rintro _ ⟨v, rfl⟩
      rw [hxb]
      intro hv
      have hv1 : (j ≫ g).left v = xb := hv
      have hv2 : g.left (j.left v) = xb := by
        rw [show (j ≫ g).left = j.left ≫ g.left from rfl, Scheme.Hom.comp_apply] at hv1
        exact hv1
      have h2 : j.left v ∈ g.left ⁻¹' {xb} := hv2
      rw [hpre] at h2
      have h3 : j.left v ∈ Set.range j.left := ⟨v, rfl⟩
      rw [hrange] at h3
      exact h3 h2
    let Lg : VT.left ⟶ To.left := IsOpenImmersion.lift incl.left (j ≫ g).left hsub
    have hLg : Lg ≫ incl.left = (j ≫ g).left := IsOpenImmersion.lift_fac _ _ hsub
    have hLgw : Lg ≫ To.hom = VT.hom := by
      rw [← MorphismProperty.Over.w incl, ← Category.assoc, hLg]
      show (j.left ≫ g.left) ≫ T.hom = VT.hom
      rw [Category.assoc, MorphismProperty.Over.w g, MorphismProperty.Over.w j]
    exact ⟨MorphismProperty.Over.homMk Lg hLgw trivial, MorphismProperty.Over.Hom.ext hLg⟩

  have glue : ∀ {S : Scheme.{u}} {T To Th VT : S.ProEt} (incl : To ⟶ T) (φT : T ⟶ T)
      (g : Th ⟶ T) (φh : Th ⟶ Th) (j : VT ⟶ Th) (φV : VT ⟶ VT)
      (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (σ : G ⟶ G) (m : ℕ)
      (hm1 : 1 ≤ m),
      Projective (wcFreeSheaf S Th) → Mono (wcFreeSheafMap S j) →
      ∀ (κ : Limits.cokernel (wcFreeSheafMap S j) ⟶ Limits.cokernel (wcFreeSheafMap S incl)),
      IsIso κ →
      Limits.cokernel.π (wcFreeSheafMap S j) ≫ κ =
        wcFreeSheafMap S g ≫ Limits.cokernel.π (wcFreeSheafMap S incl) →
      φh ≫ g = g ≫ φT → φV ≫ j = j ≫ φh →
      ∀ (Φ : Limits.cokernel (wcFreeSheafMap S incl) ⟶ Limits.cokernel (wcFreeSheafMap S incl)),
      Limits.cokernel.π (wcFreeSheafMap S incl) ≫ Φ =
        wcFreeSheafMap S φT ≫ Limits.cokernel.π (wcFreeSheafMap S incl) →
      (∀ w : Abelian.Ext (wcFreeSheaf S VT) G (m - 1),
        (Abelian.Ext.mk₀ (wcFreeSheafMap S φV)).comp
            ((Abelian.Ext.mk₀ (wcFreeSheafMap S φV)).comp w (zero_add (m - 1)))
            (zero_add (m - 1)) =
          w.comp (Abelian.Ext.mk₀ σ) (add_zero (m - 1))) →
      ∀ y : Abelian.Ext (Limits.cokernel (wcFreeSheafMap S incl)) G m,
        (Abelian.Ext.mk₀ Φ).comp ((Abelian.Ext.mk₀ Φ).comp y (zero_add m)) (zero_add m) =
          y.comp (Abelian.Ext.mk₀ σ) (add_zero m) := by
    intro S T To Th VT incl φT g φh j φV G σ m hm1 hproj hmono κ hκiso hκπ hφg hφV Φ hΦ
      hcrux y
    haveI := hproj
    haveI := hκiso
    have hS : (ShortComplex.mk (wcFreeSheafMap S j)
        (Limits.cokernel.π (wcFreeSheafMap S j)) (Limits.cokernel.condition _)).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) hmono inferInstance
    have hιT : wcFreeSheafMap S j ≫ wcFreeSheafMap S φh ≫
        Limits.cokernel.π (wcFreeSheafMap S j) = 0 := by
      rw [← Category.assoc, ← F0, ← hφV, F0, Category.assoc, Limits.cokernel.condition,
        Limits.comp_zero]
    obtain ⟨σT, hσT⟩ : ∃ σT : Limits.cokernel (wcFreeSheafMap S j) ⟶
        Limits.cokernel (wcFreeSheafMap S j),
        Limits.cokernel.π (wcFreeSheafMap S j) ≫ σT =
          wcFreeSheafMap S φh ≫ Limits.cokernel.π (wcFreeSheafMap S j) :=
      ⟨_, Limits.cokernel.π_desc _ _ hιT⟩
    have hnat : hS.extClass.comp (Abelian.Ext.mk₀ (wcFreeSheafMap S φV)) (add_zero 1) =
        (Abelian.Ext.mk₀ σT).comp hS.extClass (zero_add 1) :=
      hS.extClass_naturality hS
        { τ₁ := wcFreeSheafMap S φV
          τ₂ := wcFreeSheafMap S φh
          τ₃ := σT
          comm₁₂ := (F0 φV j).symm.trans ((congrArg (wcFreeSheafMap S) hφV).trans (F0 j φh))
          comm₂₃ := hσT.symm }
    have hvan : ∀ (p : ℕ) (w : Abelian.Ext (wcFreeSheaf S Th) G p), 1 ≤ p → w = 0 := by
      intro p w hp
      cases p with
      | zero => omega
      | succ k => exact Abelian.Ext.eq_zero_of_projective w
    have hm : 1 + (m - 1) = m := by omega
    have hδsurj : ∀ x₃ : Abelian.Ext (Limits.cokernel (wcFreeSheafMap S j)) G m,
        ∃ w, hS.extClass.comp w hm = x₃ := by
      intro x₃
      exact Abelian.Ext.contravariant_sequence_exact₃ hS _ x₃ (hvan _ _ (by omega)) hm
    have hδF : ∀ w : Abelian.Ext (wcFreeSheaf S VT) G (m - 1),
        (Abelian.Ext.mk₀ σT).comp (hS.extClass.comp w hm) (zero_add m) =
          hS.extClass.comp ((Abelian.Ext.mk₀ (wcFreeSheafMap S φV)).comp w
            (zero_add (m - 1))) hm := by
      intro w
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 1) hm (by omega), ← hnat,
        Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (zero_add (m - 1)) (by omega)]
    have hkey : κ ≫ Φ = σT ≫ κ := by
      apply (cancel_epi (Limits.cokernel.π (wcFreeSheafMap S j))).mp
      rw [reassoc_of% hκπ, hΦ, reassoc_of% hσT, hκπ, ← Category.assoc, ← Category.assoc,
        ← F0, ← F0, hφg]
    have hkey2 : κ ≫ Φ ≫ Φ = σT ≫ σT ≫ κ := by
      rw [reassoc_of% hkey, hkey]
    have hinjκ : ∀ a b : Abelian.Ext (Limits.cokernel (wcFreeSheafMap S incl)) G m,
        (Abelian.Ext.mk₀ κ).comp a (zero_add m) = (Abelian.Ext.mk₀ κ).comp b (zero_add m) →
          a = b := by
      intro a b hab
      have hab' := congrArg (fun w => (Abelian.Ext.mk₀ (inv κ)).comp w (zero_add m)) hab
      simp only [Abelian.Ext.mk₀_comp_mk₀_assoc, IsIso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
        at hab'
      exact hab'
    apply hinjκ
    obtain ⟨w, hw⟩ := hδsurj ((Abelian.Ext.mk₀ κ).comp y (zero_add m))
    have hδs : (hS.extClass.comp w hm).comp (Abelian.Ext.mk₀ σ) (add_zero m) =
        hS.extClass.comp (w.comp (Abelian.Ext.mk₀ σ) (add_zero (m - 1))) hm := by
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero]
    have hκy : ((Abelian.Ext.mk₀ κ).comp y (zero_add m)).comp (Abelian.Ext.mk₀ σ) (add_zero m) =
        (Abelian.Ext.mk₀ κ).comp (y.comp (Abelian.Ext.mk₀ σ) (add_zero m)) (zero_add m) := by
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero]
    have h1 : (Abelian.Ext.mk₀ κ).comp ((Abelian.Ext.mk₀ Φ).comp ((Abelian.Ext.mk₀ Φ).comp y
          (zero_add m)) (zero_add m)) (zero_add m) =
        (Abelian.Ext.mk₀ σT).comp ((Abelian.Ext.mk₀ σT).comp ((Abelian.Ext.mk₀ κ).comp y
          (zero_add m)) (zero_add m)) (zero_add m) := by
      simp only [Abelian.Ext.mk₀_comp_mk₀_assoc, Category.assoc, hkey2]
    rw [h1, ← hw, hδF, hδF, hcrux w, ← hδs, hw, hκy]

  intro y
  obtain ⟨xb, hxb, hfixall, hln, hqs, hsep⟩ :=
    wc_odp_fibre_sing_point F' F'' Y n D i V₀ A e ε hv hε
  haveI := hln
  obtain ⟨Th, g, φh, B, iB, iBn, iBh, iBs, eB, VT, j, φV, hφg, hpre, hfib, hj, hrange, hφV,
      hTc⟩ :=
    wc_proet_strict_nbhd_of_fixed_point (Limits.pullback D.f (D.S i))
      ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj ((wcProEtPullback D.f).obj V₀)) xb
      ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).map ((wcProEtPullback D.f).map φ₀))
      (hfixall _) hsep
  have hι : IsOpenImmersion (wcOpenRestrIncl (Limits.pullback D.f (D.S i)) (wcCritPunctOpen D i)
      ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
        ((wcProEtPullback D.f).obj V₀))).left := by
    show IsOpenImmersion (Limits.pullback.snd (wcCritPunctOpen D i).ι _)
    infer_instance
  obtain ⟨gV, hgV⟩ := liftV _ hι xb hxb g j _ hpre hrange
  have hrj : Set.range j.left = g.left ⁻¹' {xb}ᶜ := by
    rw [hrange, Set.preimage_compl, hpre]
  obtain ⟨κ, hκiso, hκπ⟩ := wc_lfi_point_excision _ _ _ _ _ _ hι xb hxb g j hj hrj gV hgV
    hfib hTc hqs hln
  have hmono := wc_free_sheaf_map_mono _ _ _ j (@IsOpenImmersion.mono _ _ _ hj)
  exact glue _ _ g φh j φV (wcLadicSheaf (Limits.pullback D.f (D.S i)) ℓ)
    (wcLadicScalar (Limits.pullback D.f (D.S i)) ℓ ((Nat.card F'' : ℚ_[ℓ]) ^ n)) n (by omega)
    (wc_proet_free_projective_strict_local _ Th B eB) hmono κ hκiso hκπ hφg hφV Φ hΦ
    (wc_odp_punct_germ_frob_sq F' F'' Y n hn hn2 D ℓ hℓ i V₀ φ₀ A e ε hv hε hεφ xb hxb Th VT g
      φh hφg B eB hpre hfib j hj hrange φV hφV) y

theorem wc_pencil_strict_nbhd_vanishing_frob_sq (F' F'' : Type u) [Field F'] [Field F'']
    [Finite F''] [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m)
    (V₀ : (wcP1Over F'').left.ProEt) (φ₀ : V₀ ⟶ V₀)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom (D.S i) ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom (D.S i))
    (hεφ : ε.inv ≫ Limits.pullback.fst V₀.hom (D.S i) ≫ φ₀.left =
      Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
        (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
          AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫
        ε.inv ≫ Limits.pullback.fst V₀.hom (D.S i))
    (z : Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀))
        (wcLadicSheaf D.Yt.left ℓ) n)
    (hz : ∀ (Vη : (wcP1Over F'').left.ProEt) (a : Vη ⟶ V₀) (B : Type u) [CommRing B]
        [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
        (eB : Vη.left ≅ Spec (.of B)),
        (∀ (v : Vη.left) (j : Fin D.m), Vη.hom v ≠ D.S j (IsLocalRing.closedPoint F'')) →
        (Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left ((wcProEtPullback D.f).map a))).comp z
          (zero_add n) = 0) :
    (Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left ((wcProEtPullback D.f).map φ₀))).comp
        ((Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left ((wcProEtPullback D.f).map φ₀))).comp z
          (zero_add n)) (zero_add n) =
      z.comp (Abelian.Ext.mk₀ (wcLadicScalar D.Yt.left ℓ ((Nat.card F'' : ℚ_[ℓ]) ^ n)))
        (add_zero n) :=
by
  classical

  have F0 : ∀ {S : Scheme.{u}} {U V W : S.ProEt} (a : U ⟶ V) (b : V ⟶ W),
      wcFreeSheafMap S (a ≫ b) = wcFreeSheafMap S a ≫ wcFreeSheafMap S b := by
    intro S U V W a b
    have h := (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_comp
      (Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
      (Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    first
      | rw [← Functor.whiskerRight_comp, ← yoneda.map_comp] at h
      | rw [← Functor.comp_whiskerRight, ← yoneda.map_comp] at h
    exact h

  have Hres : ∀ {S : Scheme.{u}} (O : S.Opens) (Tc : S.ProEt) (φ : Tc ⟶ Tc),
      ∃ φo : wcOpenRestr S O Tc ⟶ wcOpenRestr S O Tc,
        φo ≫ wcOpenRestrIncl S O Tc = wcOpenRestrIncl S O Tc ≫ φ := by
    intro S O Tc φ
    have w : φ.left ≫ Tc.hom = Tc.hom := MorphismProperty.Over.w φ
    have hc : Limits.pullback.fst O.ι Tc.hom ≫ O.ι =
        (Limits.pullback.snd O.ι Tc.hom ≫ φ.left) ≫ Tc.hom :=
      Limits.pullback.condition.trans
        ((congrArg (fun k => Limits.pullback.snd O.ι Tc.hom ≫ k) w).symm.trans
          (Category.assoc _ _ _).symm)
    have hl : Limits.pullback.lift (Limits.pullback.fst O.ι Tc.hom)
        (Limits.pullback.snd O.ι Tc.hom ≫ φ.left) hc ≫ (Limits.pullback.snd O.ι Tc.hom ≫ Tc.hom) =
        Limits.pullback.snd O.ι Tc.hom ≫ Tc.hom :=
      (Category.assoc _ _ _).symm.trans
        ((congrArg (fun k => k ≫ Tc.hom) (Limits.pullback.lift_snd _ _ hc)).trans
          ((Category.assoc _ _ _).trans
            (congrArg (fun k => Limits.pullback.snd O.ι Tc.hom ≫ k) w)))
    refine ⟨MorphismProperty.Over.homMk (Limits.pullback.lift (Limits.pullback.fst O.ι Tc.hom)
        (Limits.pullback.snd O.ι Tc.hom ≫ φ.left) hc) (by exact hl) trivial, ?_⟩
    apply MorphismProperty.Over.Hom.ext
    exact Limits.pullback.lift_snd _ _ _

  have R5 : ∀ {S : Scheme.{u}} (O : S.Opens) (Tc : S.ProEt) (φ : Tc ⟶ Tc)
      (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (σ : G ⟶ G),
      (∀ (Φ : Limits.cokernel (wcFreeSheafMap S (wcOpenRestrIncl S O Tc)) ⟶
          Limits.cokernel (wcFreeSheafMap S (wcOpenRestrIncl S O Tc))),
        Limits.cokernel.π (wcFreeSheafMap S (wcOpenRestrIncl S O Tc)) ≫ Φ =
          wcFreeSheafMap S φ ≫ Limits.cokernel.π (wcFreeSheafMap S (wcOpenRestrIncl S O Tc)) →
        ∀ yt : Abelian.Ext (Limits.cokernel (wcFreeSheafMap S (wcOpenRestrIncl S O Tc))) G n,
          (Abelian.Ext.mk₀ Φ).comp ((Abelian.Ext.mk₀ Φ).comp yt (zero_add n)) (zero_add n) =
            yt.comp (Abelian.Ext.mk₀ σ) (add_zero n)) →
      ∀ y : Abelian.Ext (wcFreeSheaf S Tc) G n,
        (Abelian.Ext.mk₀ (wcFreeSheafMap S (wcOpenRestrIncl S O Tc))).comp y (zero_add n) = 0 →
        (Abelian.Ext.mk₀ (wcFreeSheafMap S φ)).comp ((Abelian.Ext.mk₀ (wcFreeSheafMap S φ)).comp y
          (zero_add n)) (zero_add n) = y.comp (Abelian.Ext.mk₀ σ) (add_zero n) := by
    intro S O Tc φ G σ hloc y hy
    obtain ⟨φo, hcomm⟩ := Hres O Tc φ
    have hm : Mono (wcFreeSheafMap S (wcOpenRestrIncl S O Tc)) := by
      haveI : Mono (wcOpenRestrIncl S O Tc).left := by
        show Mono (Limits.pullback.snd O.ι Tc.hom)
        infer_instance
      haveI : Mono (wcOpenRestrIncl S O Tc) := ⟨fun g h e' => MorphismProperty.Over.Hom.ext
        ((cancel_mono (wcOpenRestrIncl S O Tc).left).mp (by
          have e'' := congrArg (fun t => t.left) e'
          first
            | exact e''
            | simpa [MorphismProperty.Comma.comp_left, Comma.comp_left, Over.comp_left] using e''))⟩
      unfold wcFreeSheafMap
      exact Functor.map_mono (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
        (Functor.whiskerRight (yoneda.map (wcOpenRestrIncl S O Tc))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    have hdesc : wcFreeSheafMap S (wcOpenRestrIncl S O Tc) ≫ wcFreeSheafMap S φ ≫
        Limits.cokernel.π (wcFreeSheafMap S (wcOpenRestrIncl S O Tc)) = 0 := by
      rw [← Category.assoc, ← F0, ← hcomm, F0, Category.assoc, Limits.cokernel.condition,
        Limits.comp_zero]
    have hΦ := Limits.cokernel.π_desc (wcFreeSheafMap S (wcOpenRestrIncl S O Tc))
      (wcFreeSheafMap S φ ≫ Limits.cokernel.π (wcFreeSheafMap S (wcOpenRestrIncl S O Tc))) hdesc
    have hS : (ShortComplex.mk (wcFreeSheafMap S (wcOpenRestrIncl S O Tc))
        (Limits.cokernel.π (wcFreeSheafMap S (wcOpenRestrIncl S O Tc)))
        (Limits.cokernel.condition _)).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) hm inferInstance
    obtain ⟨yt, hyt⟩ := Abelian.Ext.contravariant_sequence_exact₂ hS G y hy
    have hyt' : (Abelian.Ext.mk₀ (Limits.cokernel.π
        (wcFreeSheafMap S (wcOpenRestrIncl S O Tc)))).comp yt (zero_add n) = y := hyt
    have step : ∀ x : Abelian.Ext (Limits.cokernel (wcFreeSheafMap S (wcOpenRestrIncl S O Tc))) G n,
        (Abelian.Ext.mk₀ (wcFreeSheafMap S φ)).comp
          ((Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap S (wcOpenRestrIncl S O Tc)))).comp
            x (zero_add n)) (zero_add n) =
        (Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap S (wcOpenRestrIncl S O Tc)))).comp
          ((Abelian.Ext.mk₀ (Limits.cokernel.desc _ _ hdesc)).comp x (zero_add n)) (zero_add n) := by
      intro x
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Abelian.Ext.mk₀_comp_mk₀_assoc, hΦ]
    rw [← hyt', step, step, hloc _ hΦ, Abelian.Ext.comp_assoc_of_third_deg_zero]

  obtain ⟨L, adj, hLlim, θ, hθ⟩ :=
    wc_proet_push_left_adjoint_free_nat (Limits.pullback.fst D.f (D.S i))
  haveI := hLlim
  haveI : L.IsLeftAdjoint := ⟨_, ⟨adj⟩⟩
  haveI : Limits.PreservesColimitsOfSize.{0, 0} L := adj.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits L :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits L
  haveI : L.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint L
  haveI : L.Additive := Functor.additive_of_preserves_binary_products L

  obtain ⟨R, hR⟩ : ∃ R : Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀))
        (wcLadicSheaf D.Yt.left ℓ) n →+
      Abelian.Ext (wcFreeSheaf (Limits.pullback D.f (D.S i))
        ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj ((wcProEtPullback D.f).obj V₀)))
        (wcLadicSheaf (Limits.pullback D.f (D.S i)) ℓ) n,
      R = wcProEtRes (Limits.pullback.fst D.f (D.S i)) L adj θ ℚ_[ℓ]
        ((wcProEtPullback D.f).obj V₀) n := ⟨_, rfl⟩

  have hRinj : Function.Injective R := by
    rw [hR]
    exact wc_rat_pt_nbhd_res_injective F' F'' Y n D ℓ hℓ (D.S i) (D.hS i) V₀ A e ε hv hε
      L adj θ hθ n
  obtain ⟨π, hπ⟩ : ∃ π : L.obj (wcLadicSheaf D.Yt.left ℓ) ⟶
      wcLadicSheaf (Limits.pullback D.f (D.S i)) ℓ, π = (adj.homEquiv (wcContSheaf D.Yt.left ℚ_[ℓ])
      (wcContSheaf (Limits.pullback D.f (D.S i)) ℚ_[ℓ])).symm
        (wcContPull (Limits.pullback.fst D.f (D.S i)) ℚ_[ℓ]) := ⟨_, rfl⟩
  have hRz : ∀ z, R z = (Abelian.Ext.mk₀ (θ ((wcProEtPullback D.f).obj V₀)).inv).comp
      ((Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ π) (add_zero n)) (zero_add n) := by
    intro z
    rw [hR, hπ]
    rfl

  have hR1 : ∀ y : Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀))
      (wcLadicSheaf D.Yt.left ℓ) n,
      R ((Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left ((wcProEtPullback D.f).map φ₀))).comp y
        (zero_add n)) =
      (Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f (D.S i))
        ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).map
          ((wcProEtPullback D.f).map φ₀)))).comp (R y) (zero_add n) := by
    intro y
    have hθφ : (θ ((wcProEtPullback D.f).obj V₀)).inv ≫
        L.map (wcFreeSheafMap D.Yt.left ((wcProEtPullback D.f).map φ₀)) =
        wcFreeSheafMap (Limits.pullback D.f (D.S i))
          ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).map ((wcProEtPullback D.f).map φ₀)) ≫
          (θ ((wcProEtPullback D.f).obj V₀)).inv := by
      rw [Iso.inv_comp_eq, ← Category.assoc, ← hθ ((wcProEtPullback D.f).map φ₀), Category.assoc,
        Iso.hom_inv_id, Category.comp_id]
    rw [hRz, hRz, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
    simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.mk₀_comp_mk₀_assoc, hθφ]

  have hR2 : ∀ (c : ℚ_[ℓ]) (y : Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀))
      (wcLadicSheaf D.Yt.left ℓ) n),
      R (y.comp (Abelian.Ext.mk₀ (wcLadicScalar D.Yt.left ℓ c)) (add_zero n)) =
        (R y).comp (Abelian.Ext.mk₀ (wcLadicScalar (Limits.pullback D.f (D.S i)) ℓ c))
          (add_zero n) := by
    intro c y
    have hkey : L.map (wcLadicScalar D.Yt.left ℓ c) ≫ π =
        π ≫ wcLadicScalar (Limits.pullback D.f (D.S i)) ℓ c := by
      have e1 := adj.homEquiv_naturality_left_symm (X' := wcContSheaf D.Yt.left ℚ_[ℓ])
        (X := wcContSheaf D.Yt.left ℚ_[ℓ]) (Y := wcContSheaf (Limits.pullback D.f (D.S i)) ℚ_[ℓ])
        (wcLadicScalar D.Yt.left ℓ c) (wcContPull (Limits.pullback.fst D.f (D.S i)) ℚ_[ℓ])
      have e2 := adj.homEquiv_naturality_right_symm (X := wcContSheaf D.Yt.left ℚ_[ℓ])
        (Y := wcContSheaf (Limits.pullback D.f (D.S i)) ℚ_[ℓ])
        (Y' := wcContSheaf (Limits.pullback D.f (D.S i)) ℚ_[ℓ])
        (wcContPull (Limits.pullback.fst D.f (D.S i)) ℚ_[ℓ])
        (wcLadicScalar (Limits.pullback D.f (D.S i)) ℓ c)
      have e3 := wc_contPull_ladicScalar (Limits.pullback.fst D.f (D.S i)) ℓ c
      rw [hπ]
      exact e1.symm.trans ((congrArg _ e3).trans e2)
    rw [hRz, hRz, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
    simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.mk₀_comp_mk₀_assoc, hkey]

  have hy0 : (Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f (D.S i))
      (wcOpenRestrIncl (Limits.pullback D.f (D.S i)) (wcCritPunctOpen D i)
        ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
          ((wcProEtPullback D.f).obj V₀))))).comp (R z) (zero_add n) = 0 := by
    rw [hR]
    exact wc_crit_nbhd_res_punct_vanish F' F'' Y n D ℓ hℓ i V₀ A e ε hv hε L adj θ hθ z hz

  have hfrob := R5 (wcCritPunctOpen D i)
    ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj ((wcProEtPullback D.f).obj V₀))
    ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).map ((wcProEtPullback D.f).map φ₀))
    (wcLadicSheaf (Limits.pullback D.f (D.S i)) ℓ)
    (wcLadicScalar (Limits.pullback D.f (D.S i)) ℓ ((Nat.card F'' : ℚ_[ℓ]) ^ n))
    (fun Φ hΦ => wc_odp_fibre_local_frob_sq F' F'' Y n hn hn2 D ℓ hℓ i V₀ φ₀ A e ε hv hε hεφ Φ hΦ)
    (R z) hy0

  apply sub_eq_zero.mp
  apply (injective_iff_map_eq_zero R).mp hRinj
  rw [map_sub, hR1, hR1, hR2, hfrob, sub_self]

theorem wc_pencil_H0_punctual_germ_frob_sq (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (x : wcCohG F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0)
    (hx : ∀ (V : (wcP1Over F'').left.ProEt) (g : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP),
      (∀ (v : V.left) (i : Fin D.m), V.hom v ≠ D.S i (IsLocalRing.closedPoint F'')) →
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g)).comp x (zero_add 0) = 0)
    (i : Fin D.m) :
    ∃ (V : (wcP1Over F'').left.ProEt) (g : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (v : V.left),
      V.hom v = D.S i (IsLocalRing.closedPoint F'') ∧
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g)).comp
        (wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0
            (wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0 x) -
          wcCohGEnd F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0
            (wcRqScalar D.f ℓ n ((Nat.card F'' : ℚ_[ℓ]) ^ n)) x) (zero_add 0) = 0 :=
by
  obtain ⟨V₀, g₀, φ₀, A, _, _, _, e, ε, hv, hφ, hε, hεφ⟩ :=
    wc_P1bar_strict_local_nbhd F'' (D.S i) (D.hS i) hP
  haveI hproj : Projective (wcFreeSheaf (wcP1Over F'').left V₀) :=
    wc_proet_free_projective_strict_local (wcP1Over F'').left V₀ A e
  obtain ⟨L, adj, _, θ, hθ⟩ := wc_proet_push_left_adjoint_free_nat D.f
  obtain ⟨ed, hbij, hτ, hσ⟩ := ext_rightDerived_adj_edge L (wcProEtPush D.f) adj
    (wcLadicSheaf D.Yt.left ℓ) n

  have F0 : ∀ {U V W : (wcP1Over F'').left.ProEt} (a : U ⟶ V) (b : V ⟶ W),
      wcFreeSheafMap (wcP1Over F'').left (a ≫ b) =
        wcFreeSheafMap (wcP1Over F'').left a ≫ wcFreeSheafMap (wcP1Over F'').left b := by
    intro U V W a b
    have h := (presheafToSheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}).map_comp
      (Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
      (Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    first
      | rw [← Functor.whiskerRight_comp, ← yoneda.map_comp] at h
      | rw [← Functor.comp_whiskerRight, ← yoneda.map_comp] at h
    exact h
  let ed₀ : Abelian.Ext (L.obj (wcFreeSheaf (wcP1Over F'').left V₀)) (wcLadicSheaf D.Yt.left ℓ) n ≃+
      Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V₀) (wcRq D.f ℓ n) 0 :=
    AddEquiv.ofBijective (ed (wcFreeSheaf (wcP1Over F'').left V₀))
      (hbij (wcFreeSheaf (wcP1Over F'').left V₀))
  have hed₀ : ∀ w : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V₀) (wcRq D.f ℓ n) 0,
      ed (wcFreeSheaf (wcP1Over F'').left V₀) (ed₀.symm w) = w :=
    fun w => ed₀.apply_symm_apply w

  have hΛτ : ∀ (τ : wcFreeSheaf (wcP1Over F'').left V₀ ⟶ wcFreeSheaf (wcP1Over F'').left V₀)
      (w : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V₀) (wcRq D.f ℓ n) 0),
      ed₀.symm ((Abelian.Ext.mk₀ τ).comp w (zero_add 0)) =
        (Abelian.Ext.mk₀ (L.map τ)).comp (ed₀.symm w) (zero_add n) := by
    intro τ w
    apply ed₀.injective
    rw [AddEquiv.apply_symm_apply]
    exact ((hτ τ (ed₀.symm w)).trans
      (congrArg (fun t => (Abelian.Ext.mk₀ τ).comp t (zero_add 0)) (hed₀ w))).symm
  have hΛσ : ∀ (c : ℚ_[ℓ])
      (w : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V₀) (wcRq D.f ℓ n) 0),
      ed₀.symm (w.comp (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ n c)) (add_zero 0)) =
        (ed₀.symm w).comp (Abelian.Ext.mk₀ (wcLadicScalar D.Yt.left ℓ c)) (add_zero n) := by
    intro c w
    apply ed₀.injective
    rw [AddEquiv.apply_symm_apply]
    exact ((hσ _ (wcLadicScalar D.Yt.left ℓ c) (ed₀.symm w)).trans
      (congrArg (fun t => t.comp (Abelian.Ext.mk₀
        (((wcProEtPush D.f).rightDerived n).map (wcLadicScalar D.Yt.left ℓ c))) (add_zero 0))
        (hed₀ w))).symm
  let Θ : wcCohG F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0 →+
      Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀))
        (wcLadicSheaf D.Yt.left ℓ) n :=
    ((Abelian.Ext.mk₀ (θ V₀).inv).precomp (wcLadicSheaf D.Yt.left ℓ) (zero_add n)).comp
      (ed₀.symm.toAddMonoidHom.comp
        ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g₀)).precomp
          (wcRq D.f ℓ n) (zero_add 0)))
  have hΘ : ∀ y : wcCohG F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0, Θ y =
      (Abelian.Ext.mk₀ (θ V₀).inv).comp
        (ed₀.symm ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g₀)).comp y (zero_add 0)))
        (zero_add n) := fun y => rfl

  have hΘF : ∀ y : wcCohG F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0,
      Θ (wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0 y) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left ((wcProEtPullback D.f).map φ₀))).comp
          (Θ y) (zero_add n) := by
    intro y
    rw [hΘ, hΘ]
    have h1 : (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g₀)).comp
        (wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0 y) (zero_add 0) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left φ₀)).comp
          ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g₀)).comp y (zero_add 0))
          (zero_add 0) := by
      show (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g₀)).comp
          ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left
            (wcGeomFrob F'' (wcP1Over F'') hP))).comp y (zero_add 0)) (zero_add 0) = _
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Abelian.Ext.mk₀_comp_mk₀_assoc, ← F0, ← F0, hφ]
    have hθφ : (θ V₀).inv ≫ L.map (wcFreeSheafMap (wcP1Over F'').left φ₀) =
        wcFreeSheafMap D.Yt.left ((wcProEtPullback D.f).map φ₀) ≫ (θ V₀).inv := by
      rw [Iso.inv_comp_eq, ← Category.assoc, ← hθ φ₀, Category.assoc, Iso.hom_inv_id,
        Category.comp_id]
    rw [h1, hΛτ, Abelian.Ext.mk₀_comp_mk₀_assoc, Abelian.Ext.mk₀_comp_mk₀_assoc, hθφ]

  have hΘs : ∀ (c : ℚ_[ℓ]) (y : wcCohG F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0),
      Θ (wcCohGEnd F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0 (wcRqScalar D.f ℓ n c) y) =
        (Θ y).comp (Abelian.Ext.mk₀ (wcLadicScalar D.Yt.left ℓ c)) (add_zero n) := by
    intro c y
    rw [hΘ, hΘ]
    have h1 : (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g₀)).comp
        (wcCohGEnd F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0 (wcRqScalar D.f ℓ n c) y) (zero_add 0) =
        ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g₀)).comp y (zero_add 0)).comp
          (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ n c)) (add_zero 0) :=
      (Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (add_zero 0) (by omega)).symm
    rw [h1, hΛσ]
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add n) (add_zero n) (by omega)).symm

  have hz : ∀ (Vη : (wcP1Over F'').left.ProEt) (a : Vη ⟶ V₀) (B : Type u) [CommRing B]
      [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
      (eB : Vη.left ≅ Spec (.of B)),
      (∀ (v : Vη.left) (j : Fin D.m), Vη.hom v ≠ D.S j (IsLocalRing.closedPoint F'')) →
      (Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left ((wcProEtPullback D.f).map a))).comp (Θ x)
        (zero_add n) = 0 := by
    intro Vη a B _ _ _ eB hη
    haveI : Projective (wcFreeSheaf (wcP1Over F'').left Vη) :=
      wc_proet_free_projective_strict_local (wcP1Over F'').left Vη B eB
    have hθa : wcFreeSheafMap D.Yt.left ((wcProEtPullback D.f).map a) ≫ (θ V₀).inv =
        (θ Vη).inv ≫ L.map (wcFreeSheafMap (wcP1Over F'').left a) := by
      rw [Iso.eq_inv_comp, ← Category.assoc, ← hθ a, Category.assoc, Iso.hom_inv_id,
        Category.comp_id]
    have hr : (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left a)).comp
        ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g₀)).comp x (zero_add 0))
        (zero_add 0) = 0 := by
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, ← F0]
      exact hx Vη (a ≫ g₀) hη
    have ht : ed (wcFreeSheaf (wcP1Over F'').left Vη)
        ((Abelian.Ext.mk₀ (L.map (wcFreeSheafMap (wcP1Over F'').left a))).comp
          (ed₀.symm ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g₀)).comp x
            (zero_add 0))) (zero_add n)) = 0 :=
      ((hτ (wcFreeSheafMap (wcP1Over F'').left a) _).trans
        (congrArg (fun t => (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left a)).comp t
          (zero_add 0)) (hed₀ _))).trans hr
    have ht0 := (hbij (wcFreeSheaf (wcP1Over F'').left Vη)).1
      (ht.trans (map_zero _).symm)
    rw [hΘ, Abelian.Ext.mk₀_comp_mk₀_assoc, hθa, ← Abelian.Ext.mk₀_comp_mk₀_assoc, ht0,
      Abelian.Ext.comp_zero]
  have hL5 := wc_pencil_strict_nbhd_vanishing_frob_sq F' F'' Y n hn hn2 D ℓ hℓ i V₀ φ₀ A e ε
    hv hε hεφ (Θ x) hz

  have hw : Θ (wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0
            (wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0 x) -
          wcCohGEnd F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0
            (wcRqScalar D.f ℓ n ((Nat.card F'' : ℚ_[ℓ]) ^ n)) x) = 0 := by
    rw [map_sub, hΘF, hΘF, hΘs, hL5, sub_self]

  set w := wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0
            (wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0 x) -
          wcCohGEnd F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0
            (wcRqScalar D.f ℓ n ((Nat.card F'' : ℚ_[ℓ]) ^ n)) x with hwdef
  have h2 : ed₀.symm ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g₀)).comp w
      (zero_add 0)) = 0 := by
    have h4 : (Abelian.Ext.mk₀ (θ V₀).hom).comp (Θ w) (zero_add n) =
        ed₀.symm ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g₀)).comp w
          (zero_add 0)) := by
      rw [hΘ, Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    rw [← h4, hw, Abelian.Ext.comp_zero]
  have h3 : (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g₀)).comp w (zero_add 0) = 0 :=
    ed₀.symm.injective (h2.trans (map_zero ed₀.symm).symm)
  exact ⟨V₀, g₀, e.inv (IsLocalRing.closedPoint A), hv, h3⟩

theorem wc_pencil_H0_punctual_frob_sq (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (x : wcCohG F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0)
    (hx : ∀ (V : (wcP1Over F'').left.ProEt) (g : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP),
      (∀ (v : V.left) (i : Fin D.m), V.hom v ≠ D.S i (IsLocalRing.closedPoint F'')) →
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g)).comp x (zero_add 0) = 0) :
    wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0
        (wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0 x) =
      wcCohGEnd F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0
        (wcRqScalar D.f ℓ n ((Nat.card F'' : ℚ_[ℓ]) ^ n)) x :=
by
  classical

  have hfun : ∀ {A B C : (wcP1Over F'').left.ProEt} (a : A ⟶ B) (b : B ⟶ C),
      wcFreeSheafMap (wcP1Over F'').left (a ≫ b) =
        wcFreeSheafMap (wcP1Over F'').left a ≫ wcFreeSheafMap (wcP1Over F'').left b := by
    intro A B C a b
    have h := (presheafToSheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}).map_comp
      (Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
      (Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    first
      | rw [← Functor.whiskerRight_comp, ← yoneda.map_comp] at h
      | rw [← Functor.comp_whiskerRight, ← yoneda.map_comp] at h
    exact h

  let Supp : wcCohG F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0 → Prop := fun z =>
    ∀ (V : (wcP1Over F'').left.ProEt) (g : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP),
      (∀ (v : V.left) (i : Fin D.m), V.hom v ≠ D.S i (IsLocalRing.closedPoint F'')) →
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g)).comp z (zero_add 0) = 0
  have hFrob : ∀ z, Supp z → Supp (wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0 z) := by
    intro z hz V g hV
    show (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g)).comp
      ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left
        (wcGeomFrob F'' (wcP1Over F'') hP))).comp z (zero_add 0)) (zero_add 0) = 0
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc, ← hfun]
    exact hz V _ hV
  have hEnd : ∀ (σ : wcRq D.f ℓ n ⟶ wcRq D.f ℓ n) z, Supp z →
      Supp (wcCohGEnd F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0 σ z) := by
    intro σ z hz V g hV
    show (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g)).comp
      (z.comp (Abelian.Ext.mk₀ σ) (add_zero 0)) (zero_add 0) = 0
    rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (add_zero 0) (by omega), hz V g hV,
      Abelian.Ext.zero_comp]
  have hSub : ∀ a b, Supp a → Supp b → Supp (a - b) := by
    intro a b ha hb V g hV
    rw [sub_eq_add_neg, Abelian.Ext.comp_add, Abelian.Ext.comp_neg, ha V g hV, hb V g hV,
      neg_zero, add_zero]

  have huniq : ∀ (i : Fin D.m) (p p' : (wcGeomPoint F'' (wcP1Over F'') hP).left),
      (wcGeomPoint F'' (wcP1Over F'') hP).hom p = D.S i (IsLocalRing.closedPoint F'') →
      (wcGeomPoint F'' (wcP1Over F'') hP).hom p' = D.S i (IsLocalRing.closedPoint F'') →
      p = p' := by
    intro i p p' hp hp'
    obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))
      (g := D.S i) p (IsLocalRing.closedPoint F'') hp
    obtain ⟨z', hz1', -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))
      (g := D.S i) p' (IsLocalRing.closedPoint F'') hp'
    haveI : IsIso (D.S i ≫ (wcP1Over F'').hom) := by rw [D.hS i]; infer_instance
    let e := Limits.pullbackSymmetry (Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) (D.S i) ≪≫
      Limits.pullbackRightPullbackFstIso (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) (D.S i) ≪≫
      asIso (Limits.pullback.snd (D.S i ≫ (wcP1Over F'').hom)
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))
    have hsub : Subsingleton (Spec (.of (AlgebraicClosure F''))) := by
      show Subsingleton (PrimeSpectrum (AlgebraicClosure F''))
      infer_instance
    have hzz : z = z' := e.hom.isOpenEmbedding.injective (Subsingleton.elim _ _)
    rw [← hz1, ← hz1', hzz]
  have hx1 := hFrob x hx
  have hx2 := hFrob _ hx1
  have hx3 := hEnd (wcRqScalar D.f ℓ n ((Nat.card F'' : ℚ_[ℓ]) ^ n)) x hx
  have hy := hSub _ _ hx2 hx3
  have hloc := fun i => wc_pencil_H0_punctual_germ_frob_sq F' F'' Y n hn hn2 D ℓ hℓ hP x hx i
  exact sub_eq_zero.mp
    (wc_P1_geom_section_zero_of_local F'' hP (wcRq D.f ℓ n) D.m D.S D.hS huniq _ hy hloc)

theorem wc_pencil_H0_fibre_restrict (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hX : WeaklyEtale (Limits.pullback.fst (Over.mk (Limits.pullback.snd D.f D.u0)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    ∃ ρ : wcCohG F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0 →+
        wcCoh F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ n,
      (∀ (c : ℚ_[ℓ]) (x : wcCohG F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0),
        ρ (wcCohGEnd F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0 (wcRqScalar D.f ℓ n c) x) =
          wcCohScalar F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ n c (ρ x)) ∧
      (∀ x : wcCohG F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0,
        ρ (wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0 x) =
          wcCohFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ n (ρ x)) ∧
      ∀ x : wcCohG F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0, ρ x = 0 →
        wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0
            (wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0 x) =
          wcCohGEnd F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0
            (wcRqScalar D.f ℓ n ((Nat.card F'' : ℚ_[ℓ]) ^ n)) x :=
by
  obtain ⟨ρ, h1, h2, h4⟩ := wc_pencil_H0_stalk_pbc F' F'' Y n hn hn2 D ℓ hℓ hP hX
  refine ⟨ρ, h1, h2, fun x hx0 => ?_⟩
  exact wc_pencil_H0_punctual_frob_sq F' F'' Y n hn hn2 D ℓ hℓ hP x
    (wc_pencil_H0_lisse_spread F' F'' Y n hn hn2 D ℓ hℓ hP x (h4 x hx0))

theorem wc_pencil_fibre_restrict_injective (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (h4 : 4 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hX : WeaklyEtale (Limits.pullback.fst (Over.mk (Limits.pullback.snd D.f D.u0)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hZ : WeaklyEtale (Limits.pullback.fst D.Z.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    ∃ ψ : wcCoh F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2) →+
        wcCoh F'' D.Z hZ ℓ (n - 2),
      Function.Injective ψ ∧
      (∀ (c : ℚ_[ℓ]) (x : wcCoh F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2)),
        ψ (wcCohScalar F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2) c x) =
          wcCohScalar F'' D.Z hZ ℓ (n - 2) c (ψ x)) ∧
      ∀ x : wcCoh F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2),
        ψ (wcCohFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2) x) =
          wcCohFrob F'' D.Z hZ ℓ (n - 2) (ψ x) :=
by
  classical
  obtain ⟨-, hXp, hXs⟩ := wc_pencil_fibre_props F' F'' Y n (by omega) D
  haveI : IsProper (Over.mk (Limits.pullback.snd D.f D.u0)).hom := hXp
  haveI : SmoothOfRelativeDimension (n - 1) (Over.mk (Limits.pullback.snd D.f D.u0)).hom := hXs

  have hscal : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcHMPullData f ℓ)
      (hD : wcHMPullCanonical D) (n : ℕ) (c : ℚ_[ℓ]) (x : wcHM S ℓ n),
      wcHMPull D n (wcHMScalar S ℓ n c x) = wcHMScalar S' ℓ n c (wcHMPull D n x) := by
    intro S S' f D hD n c x
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    have hc := wc_hm_pull_const D hD c
    show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ
        (x.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero n))).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero n)) (zero_add n) =
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ x).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero n)) (zero_add n)).comp
        (Abelian.Ext.mk₀ (wcHMConst S' ℓ c)) (add_zero n)
    rw [← hc, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mapExactFunctor D.Φ x),
      Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mk₀ D.μ.inv),
      Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mapExactFunctor D.Φ x),
      Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id_assoc]

  obtain ⟨ιb, hιb₁, hιb₂⟩ : ∃ ιb : wcXbar F'' D.Z ⟶
        wcXbar F'' (Over.mk (Limits.pullback.snd D.f D.u0)),
      ιb ≫ Limits.pullback.fst (Over.mk (Limits.pullback.snd D.f D.u0)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
        Limits.pullback.fst D.Z.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ≫ D.ιZ ∧
      ιb ≫ Limits.pullback.snd (Over.mk (Limits.pullback.snd D.f D.u0)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
        Limits.pullback.snd D.Z.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) :=
    ⟨Limits.pullback.lift (Limits.pullback.fst D.Z.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ≫ D.ιZ)
      (Limits.pullback.snd D.Z.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))
      (by
        rw [Category.assoc]
        erw [D.hιZY]
        exact Limits.pullback.condition),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩

  have hgf₁ : ∀ (W : Over (Spec (.of F'')))
      (hW : WeaklyEtale (Limits.pullback.fst W.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))),
      wcGeomFrobX F'' W hW ≫ Limits.pullback.fst W.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
        Limits.pullback.fst W.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) := by
    intro W hW
    unfold wcGeomFrobX wcGeomFrob
    exact (Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _)
  have hgs : ∀ (W : Over (Spec (.of F'')))
      (hW : WeaklyEtale (Limits.pullback.fst W.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))),
      wcGeomFrobX F'' W hW ≫ Limits.pullback.snd W.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
        Limits.pullback.snd W.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ≫
          Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
            (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
              AlgebraicClosure F'' →+* AlgebraicClosure F'')) := by
    intro W hW
    unfold wcGeomFrobX wcGeomFrob
    exact Limits.pullback.lift_snd _ _ _
  have hcomm : wcGeomFrobX F'' D.Z hZ ≫ ιb =
      ιb ≫ wcGeomFrobX F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX := by
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc]
      rw [hgf₁ _ hX, hιb₁, ← Category.assoc, hgf₁ D.Z hZ]
    · simp only [Category.assoc]
      rw [hιb₂, hgs _ hX, ← Category.assoc, hιb₂, hgs D.Z hZ]

  obtain ⟨Dι, hDι⟩ := wc_hm_pull_data_exists ιb ℓ
  obtain ⟨DX, hDX⟩ := wc_hm_pull_data_exists
    (wcGeomFrobX F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX) ℓ
  obtain ⟨DZ, hDZ⟩ := wc_hm_pull_data_exists (wcGeomFrobX F'' D.Z hZ) ℓ
  obtain ⟨Dk, hDk⟩ := wc_hm_pull_data_exists
    (ιb ≫ wcGeomFrobX F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX) ℓ
  obtain ⟨TX, hTXs, hTXF⟩ := wc_hm_comparison F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ
  obtain ⟨TZ, hTZs, hTZF⟩ := wc_hm_comparison F'' D.Z hZ ℓ

  have hP : Function.Injective (wcHMPull Dι (n - 2)) :=
    wc_hm_weak_lefschetz_injective_of_smooth_divisor F'' (Over.mk (Limits.pullback.snd D.f D.u0)) (n - 1) ℓ hℓ
      D.Z D.ιZ D.hιZ D.hιZY
      (by rw [show n - 1 - 1 = n - 2 by omega]; exact D.Zsmooth)
      D.Zaff ιb hιb₁ hιb₂ Dι hDι (n - 2) (by omega)
  refine ⟨(TZ (n - 2)).symm.toAddMonoidHom.comp
    ((wcHMPull Dι (n - 2)).comp (TX (n - 2)).toAddMonoidHom), ?_, ?_, ?_⟩
  · exact (TZ (n - 2)).symm.injective.comp (hP.comp (TX (n - 2)).injective)
  · intro c x
    have h1 : ∀ w : wcHM (wcXbar F'' D.Z) ℓ (n - 2),
        (TZ (n - 2)).symm (wcHMScalar (wcXbar F'' D.Z) ℓ (n - 2) c w) =
          wcCohScalar F'' D.Z hZ ℓ (n - 2) c ((TZ (n - 2)).symm w) := by
      intro w
      apply (TZ (n - 2)).injective
      rw [hTZs, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply]
    show (TZ (n - 2)).symm (wcHMPull Dι (n - 2) (TX (n - 2)
        (wcCohScalar F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2) c x))) =
      wcCohScalar F'' D.Z hZ ℓ (n - 2) c ((TZ (n - 2)).symm (wcHMPull Dι (n - 2) (TX (n - 2) x)))
    rw [hTXs, hscal Dι hDι, h1]
  · intro x
    have h2 : ∀ w : wcHM (wcXbar F'' D.Z) ℓ (n - 2),
        (TZ (n - 2)).symm (wcHMPull DZ (n - 2) w) =
          wcCohFrob F'' D.Z hZ ℓ (n - 2) ((TZ (n - 2)).symm w) := by
      intro w
      apply (TZ (n - 2)).injective
      rw [hTZF DZ hDZ, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply]
    show (TZ (n - 2)).symm (wcHMPull Dι (n - 2) (TX (n - 2)
        (wcCohFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2) x))) =
      wcCohFrob F'' D.Z hZ ℓ (n - 2) ((TZ (n - 2)).symm (wcHMPull Dι (n - 2) (TX (n - 2) x)))
    rw [hTXF DX hDX,
      ← wc_hm_pull_comp (wcGeomFrobX F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX) ιb _ rfl
        DX hDX Dι hDι Dk hDk,
      wc_hm_pull_comp ιb (wcGeomFrobX F'' D.Z hZ) _ hcomm Dι hDι DZ hDZ Dk hDk, h2]

theorem wc_pencil_fibre_gysin (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (h4 : 4 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hX : WeaklyEtale (Limits.pullback.fst (Over.mk (Limits.pullback.snd D.f D.u0)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hZ : WeaklyEtale (Limits.pullback.fst D.Z.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    ∃ γ : wcCoh F'' D.Z hZ ℓ (n - 2) →+ wcCoh F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ n,
      Function.Surjective γ ∧
      (∀ (c : ℚ_[ℓ]) (z : wcCoh F'' D.Z hZ ℓ (n - 2)),
        γ (wcCohScalar F'' D.Z hZ ℓ (n - 2) c z) =
          wcCohScalar F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ n c (γ z)) ∧
      ∀ z : wcCoh F'' D.Z hZ ℓ (n - 2),
        wcCohFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ n (γ z) =
          wcCohScalar F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ n (Nat.card F'' : ℚ_[ℓ])
            (γ (wcCohFrob F'' D.Z hZ ℓ (n - 2) z)) :=
by
  classical
  have hext : ∀ {m k : ℕ} (M N : Matrix (Fin m) (Fin k) ℚ_[ℓ]),
      (∀ v, M.mulVec v = N.mulVec v) → M = N := by
    intro m k M N h
    apply Matrix.toLin'.injective
    apply LinearMap.ext
    intro v
    rw [Matrix.toLin'_apply, Matrix.toLin'_apply, h v]
  have inj_of : ∀ {m k : ℕ} (M : Matrix (Fin m) (Fin k) ℚ_[ℓ]), (∀ v, M.mulVec v = 0 → v = 0) →
      Function.Injective M.mulVec := by
    intro m k M h v w hvw
    exact sub_eq_zero.mp (h (v - w) (by rw [Matrix.mulVec_sub, hvw, sub_self]))

  have core : ∀ {a b c : ℕ} (A : Matrix (Fin a) (Fin a) ℚ_[ℓ])
      (B : Matrix (Fin b) (Fin b) ℚ_[ℓ]) (C : Matrix (Fin c) (Fin c) ℚ_[ℓ])
      (R : Matrix (Fin c) (Fin a) ℚ_[ℓ]) (P : Matrix (Fin a) (Fin b) ℚ_[ℓ])
      (Q : Matrix (Fin c) (Fin c) ℚ_[ℓ]) (t s : ℚ_[ℓ]), t ≠ 0 → s ≠ 0 →
      R * A = C * R → (∀ v, R.mulVec v = 0 → v = 0) →
      A.transpose * P * B = (t * s) • P →
      (∀ v, Matrix.vecMul v P = 0 → v = 0) → (∀ w, P.mulVec w = 0 → w = 0) →
      C.transpose * Q * C = s • Q → (∀ w, Q.mulVec w = 0 → w = 0) →
      ∃ G : Matrix (Fin b) (Fin c) ℚ_[ℓ], B * G = t • (G * C) ∧
        Function.Surjective G.mulVec := by
    intro a b c A B C R P Q t s ht hs hRA hR hP hPl hPr hQ hQr
    have hkerR : LinearMap.ker (Matrix.toLin' R) = ⊥ := by
      rw [LinearMap.ker_eq_bot']
      intro v hv
      exact hR v (by rwa [Matrix.toLin'_apply] at hv)
    obtain ⟨gR, hgR⟩ := LinearMap.exists_leftInverse_of_injective _ hkerR
    obtain ⟨Lm, hLmR⟩ : ∃ Lm : Matrix (Fin a) (Fin c) ℚ_[ℓ], Lm * R = 1 := by
      refine ⟨LinearMap.toMatrix' gR, ?_⟩
      have := congrArg LinearMap.toMatrix' hgR
      rwa [LinearMap.toMatrix'_comp, LinearMap.toMatrix'_toLin', LinearMap.toMatrix'_id] at this
    have hRLm : R.transpose * Lm.transpose = 1 := by
      rw [← Matrix.transpose_mul, hLmR, Matrix.transpose_one]
    have hts : t * s ≠ 0 := mul_ne_zero ht hs
    have hPt : B.transpose * P.transpose * A = (t * s) • P.transpose := by
      have := congrArg Matrix.transpose hP
      rw [Matrix.transpose_mul, Matrix.transpose_mul, Matrix.transpose_transpose,
        Matrix.transpose_smul] at this
      rw [Matrix.mul_assoc]
      exact this
    have hAinj : Function.Injective A.mulVec := inj_of A (fun v hv => by
      have h1 : (B.transpose * P.transpose * A).mulVec v = 0 := by
        rw [← Matrix.mulVec_mulVec, hv, Matrix.mulVec_zero]
      rw [hPt, Matrix.smul_mulVec] at h1
      have h2 := (smul_eq_zero.mp h1).resolve_left hts
      rw [Matrix.mulVec_transpose] at h2
      exact hPl v h2)
    have hAu : IsUnit A := Matrix.mulVec_injective_iff_isUnit.mp hAinj
    have hAtinj : Function.Injective A.transpose.mulVec :=
      Matrix.mulVec_injective_iff_isUnit.mpr ((Matrix.isUnit_transpose A).mpr hAu)
    have hPinj : Function.Injective P.mulVec := inj_of P hPr
    have hPtinj : Function.Injective P.transpose.mulVec :=
      inj_of P.transpose (fun v hv => hPl v (by rwa [Matrix.mulVec_transpose] at hv))
    have hPlin : Function.Injective (Matrix.toLin' P) := by
      intro v w h
      rw [Matrix.toLin'_apply, Matrix.toLin'_apply] at h
      exact hPinj h
    have hPtlin : Function.Injective (Matrix.toLin' P.transpose) := by
      intro v w h
      rw [Matrix.toLin'_apply, Matrix.toLin'_apply] at h
      exact hPtinj h
    have hba : b ≤ a := by
      have := LinearMap.finrank_le_finrank_of_injective hPlin
      simpa only [Module.finrank_fin_fun] using this
    have hab : a ≤ b := by
      have := LinearMap.finrank_le_finrank_of_injective hPtlin
      simpa only [Module.finrank_fin_fun] using this
    have hfr : Module.finrank ℚ_[ℓ] (Fin b → ℚ_[ℓ]) = Module.finrank ℚ_[ℓ] (Fin a → ℚ_[ℓ]) := by
      rw [Module.finrank_fin_fun, Module.finrank_fin_fun]
      omega
    have hPsurj : Function.Surjective (Matrix.toLin' P) :=
      (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hfr).mp hPlin
    obtain ⟨gP, hgP⟩ :=
      LinearMap.exists_rightInverse_of_surjective _ (LinearMap.range_eq_top.mpr hPsurj)
    obtain ⟨Pg, hPPg⟩ : ∃ Pg : Matrix (Fin b) (Fin a) ℚ_[ℓ], P * Pg = 1 := by
      refine ⟨LinearMap.toMatrix' gP, ?_⟩
      have := congrArg LinearMap.toMatrix' hgP
      rwa [LinearMap.toMatrix'_comp, LinearMap.toMatrix'_toLin', LinearMap.toMatrix'_id] at this
    obtain ⟨G, hG⟩ : ∃ G : Matrix (Fin b) (Fin c) ℚ_[ℓ], G = Pg * (R.transpose * Q) := ⟨_, rfl⟩
    have hPG : P * G = R.transpose * Q := by
      rw [hG, ← Matrix.mul_assoc, hPPg, Matrix.one_mul]
    have h1 : A.transpose * (P * (B * G)) = (t * s) • (R.transpose * Q) := by
      calc A.transpose * (P * (B * G)) = A.transpose * P * B * G := by
            simp only [Matrix.mul_assoc]
        _ = (t * s) • (P * G) := by rw [hP, Matrix.smul_mul]
        _ = (t * s) • (R.transpose * Q) := by rw [hPG]
    have h2 : A.transpose * (P * (t • (G * C))) = (t * s) • (R.transpose * Q) := by
      calc A.transpose * (P * (t • (G * C))) = t • (A.transpose * (P * G * C)) := by
            rw [Matrix.mul_smul, Matrix.mul_smul, Matrix.mul_assoc P]
        _ = t • (A.transpose * (R.transpose * Q * C)) := by rw [hPG]
        _ = t • ((R * A).transpose * Q * C) := by
            rw [Matrix.transpose_mul]; simp only [Matrix.mul_assoc]
        _ = t • ((C * R).transpose * Q * C) := by rw [hRA]
        _ = t • (R.transpose * (C.transpose * Q * C)) := by
            rw [Matrix.transpose_mul]; simp only [Matrix.mul_assoc]
        _ = t • (R.transpose * (s • Q)) := by rw [hQ]
        _ = (t * s) • (R.transpose * Q) := by rw [Matrix.mul_smul, smul_smul]
    have h3 : P * (B * G) = P * (t • (G * C)) := hext _ _ (fun v => by
      apply hAtinj
      rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, h1, h2])
    have hBG : B * G = t • (G * C) := hext _ _ (fun v => by
      apply hPinj
      rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, h3])
    refine ⟨G, hBG, ?_⟩
    have hQs : Function.Surjective Q.mulVec :=
      Matrix.mulVec_surjective_iff_isUnit.mpr
        (Matrix.mulVec_injective_iff_isUnit.mp (inj_of Q hQr))
    intro w
    obtain ⟨z0, hz0⟩ := hQs (Lm.transpose.mulVec (P.mulVec w))
    refine ⟨z0, hPinj ?_⟩
    rw [Matrix.mulVec_mulVec, hPG, ← Matrix.mulVec_mulVec, hz0, Matrix.mulVec_mulVec, hRLm,
      Matrix.one_mulVec]

  have mk : ∀ {V W : Type (u+1)} [AddCommGroup V] [AddCommGroup W] {r r' : ℕ}
      (eV : V ≃+ (Fin r → ℚ_[ℓ])) (eW : W ≃+ (Fin r' → ℚ_[ℓ]))
      (sV : ℚ_[ℓ] → V →+ V) (sW : ℚ_[ℓ] → W →+ W),
      (∀ c x, eV (sV c x) = c • eV x) → (∀ c y, eW (sW c y) = c • eW y) →
      ∀ (ψ : V →+ W), (∀ c x, ψ (sV c x) = sW c (ψ x)) →
      ∃ M : Matrix (Fin r') (Fin r) ℚ_[ℓ], (∀ v, M.mulVec v = eW (ψ (eV.symm v))) ∧
        ∀ a b, M a b = eW (ψ (eV.symm (Pi.single b 1))) a := by
    intro V W _ _ r r' eV eW sV sW heV heW ψ hψ
    have hes : ∀ (c : ℚ_[ℓ]) (v : Fin r → ℚ_[ℓ]), eV.symm (c • v) = sV c (eV.symm v) :=
      fun c v => eV.injective (by rw [heV, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
    let L : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r' → ℚ_[ℓ]) :=
      { toFun := fun v => eW (ψ (eV.symm v))
        map_add' := fun v w => by simp only [map_add]
        map_smul' := fun c v => by simp only [hes, hψ, heW, RingHom.id_apply] }
    refine ⟨LinearMap.toMatrix' L, fun v => LinearMap.toMatrix'_mulVec L v, fun a b => ?_⟩
    rw [LinearMap.toMatrix'_apply]
    rfl

  have s7 : ∀ {V W U : Type (u+1)} [AddCommGroup V] [AddCommGroup W] [AddCommGroup U]
      {a b c : ℕ} (eV : V ≃+ (Fin a → ℚ_[ℓ])) (eW : W ≃+ (Fin b → ℚ_[ℓ]))
      (eU : U ≃+ (Fin c → ℚ_[ℓ]))
      (sV : ℚ_[ℓ] → V →+ V) (sW : ℚ_[ℓ] → W →+ W) (sU : ℚ_[ℓ] → U →+ U)
      (ΦV : V →+ V) (ΦW : W →+ W) (ΦU : U →+ U),
      (∀ k x, eV (sV k x) = k • eV x) → (∀ k y, eW (sW k y) = k • eW y) →
      (∀ k z, eU (sU k z) = k • eU z) →
      (∀ k x, ΦV (sV k x) = sV k (ΦV x)) → (∀ k y, ΦW (sW k y) = sW k (ΦW y)) →
      (∀ k z, ΦU (sU k z) = sU k (ΦU z)) →
      ∀ (ψ : V →+ U), Function.Injective ψ → (∀ k x, ψ (sV k x) = sU k (ψ x)) →
      (∀ x, ψ (ΦV x) = ΦU (ψ x)) →
      ∀ (t s : ℚ_[ℓ]), t ≠ 0 → s ≠ 0 →
      ∀ (P : Matrix (Fin a) (Fin b) ℚ_[ℓ]),
      (wcAddEquivMatrix eV ΦV).transpose * P * wcAddEquivMatrix eW ΦW = (t * s) • P →
      (∀ v : Fin a → ℚ_[ℓ], Matrix.vecMul v P = 0 → v = 0) →
      (∀ w : Fin b → ℚ_[ℓ], P.mulVec w = 0 → w = 0) →
      ∀ (Q : Matrix (Fin c) (Fin c) ℚ_[ℓ]),
      (wcAddEquivMatrix eU ΦU).transpose * Q * wcAddEquivMatrix eU ΦU = s • Q →
      (∀ w : Fin c → ℚ_[ℓ], Q.mulVec w = 0 → w = 0) →
      ∃ γ : U →+ W, Function.Surjective γ ∧ (∀ k z, γ (sU k z) = sW k (γ z)) ∧
        ∀ z, ΦW (γ z) = sW t (γ (ΦU z)) := by
    intro V W U _ _ _ a b c eV eW eU sV sW sU ΦV ΦW ΦU heV heW heU hΦV hΦW hΦU ψ hψ hψs hψΦ
      t s ht hs P hP hPl hPr Q hQ hQr
    obtain ⟨A, hAv, hAe⟩ := mk eV eV sV sV heV heV ΦV hΦV
    obtain ⟨B, hBv, hBe⟩ := mk eW eW sW sW heW heW ΦW hΦW
    obtain ⟨C, hCv, hCe⟩ := mk eU eU sU sU heU heU ΦU hΦU
    obtain ⟨R, hRv, -⟩ := mk eV eU sV sU heV heU ψ hψs
    have hA : wcAddEquivMatrix eV ΦV = A := by
      ext i j
      rw [hAe]
      rfl
    have hB : wcAddEquivMatrix eW ΦW = B := by
      ext i j
      rw [hBe]
      rfl
    have hC : wcAddEquivMatrix eU ΦU = C := by
      ext i j
      rw [hCe]
      rfl
    rw [hA, hB] at hP
    rw [hC] at hQ
    have hRA : R * A = C * R := hext _ _ (fun v => by
      rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, hAv, hRv, hRv, hCv,
        AddEquiv.symm_apply_apply, AddEquiv.symm_apply_apply, hψΦ])
    have hR : ∀ v, R.mulVec v = 0 → v = 0 := by
      intro v hv
      rw [hRv] at hv
      have h1 : ψ (eV.symm v) = 0 := eU.injective (hv.trans (map_zero eU).symm)
      have h2 : eV.symm v = 0 := hψ (h1.trans (map_zero ψ).symm)
      rw [← AddEquiv.apply_symm_apply eV v, h2, map_zero]
    obtain ⟨G, hBG, hGs⟩ := core A B C R P Q t s ht hs hRA hR hP hPl hPr hQ hQr
    refine ⟨AddMonoidHom.mk' (fun z => eW.symm (G.mulVec (eU z))) (fun x y => by
      rw [map_add, Matrix.mulVec_add, map_add]), ?_, ?_, ?_⟩
    · intro y
      obtain ⟨z0, hz0⟩ := hGs (eW y)
      refine ⟨eU.symm z0, ?_⟩
      show eW.symm (G.mulVec (eU (eU.symm z0))) = y
      rw [AddEquiv.apply_symm_apply, hz0, AddEquiv.symm_apply_apply]
    · intro k z
      apply eW.injective
      show eW (eW.symm (G.mulVec (eU (sU k z)))) = eW (sW k (eW.symm (G.mulVec (eU z))))
      rw [heU, Matrix.mulVec_smul, heW, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply]
    · intro z
      apply eW.injective
      show eW (ΦW (eW.symm (G.mulVec (eU z)))) = eW (sW t (eW.symm (G.mulVec (eU (ΦU z)))))
      rw [← hBv, heW, AddEquiv.apply_symm_apply, Matrix.mulVec_mulVec, hBG, Matrix.smul_mulVec,
        ← Matrix.mulVec_mulVec, hCv, AddEquiv.symm_apply_apply]

  have s9 : ∀ (F₀ : Type u) [Field F₀] [Finite F₀] (X₀ : Over (Spec (.of F₀)))
      (h₀ : WeaklyEtale (Limits.pullback.fst X₀.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F₀ (AlgebraicClosure F₀))))))
      (i : ℕ) (c : ℚ_[ℓ]) (x : wcCoh F₀ X₀ h₀ ℓ i),
      wcCohFrob F₀ X₀ h₀ ℓ i (wcCohScalar F₀ X₀ h₀ ℓ i c x) =
        wcCohScalar F₀ X₀ h₀ ℓ i c (wcCohFrob F₀ X₀ h₀ ℓ i x) := by
    intro F₀ _ _ X₀ h₀ i c x
    show (Abelian.Ext.mk₀ (wcFreeSheafMap X₀.left (wcGeomFrob F₀ X₀ h₀))).comp
        (x.comp (Abelian.Ext.mk₀ (wcLadicScalar X₀.left ℓ c)) (add_zero i)) (zero_add i) =
      ((Abelian.Ext.mk₀ (wcFreeSheafMap X₀.left (wcGeomFrob F₀ X₀ h₀))).comp x (zero_add i)).comp
        (Abelian.Ext.mk₀ (wcLadicScalar X₀.left ℓ c)) (add_zero i)
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add i) (add_zero i) (by omega)).symm

  have hq0 : 0 < Nat.card F'' := Finite.card_pos
  have hqne : (Nat.card F'' : ℚ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr hq0.ne'
  have hsne : (Nat.card F'' : ℚ_[ℓ]) ^ (n - 2) ≠ 0 := pow_ne_zero _ hqne
  obtain ⟨hgi, hpr, hsm⟩ := wc_pencil_fibre_props F' F'' Y n (by omega) D
  haveI : GeometricallyIrreducible (Over.mk (Limits.pullback.snd D.f D.u0)).hom := hgi
  haveI : IsProper (Over.mk (Limits.pullback.snd D.f D.u0)).hom := hpr
  haveI : SmoothOfRelativeDimension (n - 1) (Over.mk (Limits.pullback.snd D.f D.u0)).hom := hsm
  haveI := D.Zgi h4
  haveI := D.Zproper
  haveI := D.Zsmooth
  obtain ⟨a, eV, heV⟩ :=
    wc_coh_finite F'' (Over.mk (Limits.pullback.snd D.f D.u0)) (n - 1) ℓ hℓ hX (n - 2)
  obtain ⟨b, eW, heW⟩ :=
    wc_coh_finite F'' (Over.mk (Limits.pullback.snd D.f D.u0)) (n - 1) ℓ hℓ hX n
  obtain ⟨c, eU, heU⟩ := wc_coh_finite F'' D.Z (n - 2) ℓ hℓ hZ (n - 2)
  obtain ⟨honeX, htopX⟩ :=
    wc_top_coh_frobenius F'' (Over.mk (Limits.pullback.snd D.f D.u0)) (n - 1) ℓ hℓ hX
  obtain ⟨honeZ, htopZ⟩ := wc_top_coh_frobenius F'' D.Z (n - 2) ℓ hℓ hZ
  have hPDX := wc_poincare_duality F'' (Over.mk (Limits.pullback.snd D.f D.u0)) (n - 1) ℓ hℓ hX
    honeX htopX (n - 2) (by omega)
  have hkX : 2 * (n - 1) - (n - 2) = n := by omega
  rw [hkX] at hPDX
  obtain ⟨P, hP, hPl, hPr⟩ := hPDX a b eV eW heV heW
  have hPDZ := wc_poincare_duality F'' D.Z (n - 2) ℓ hℓ hZ honeZ htopZ (n - 2) (by omega)
  have hkZ : 2 * (n - 2) - (n - 2) = n - 2 := by omega
  rw [hkZ] at hPDZ
  obtain ⟨Q, hQ, -, hQr⟩ := hPDZ c c eU eU heU heU
  have hpow : (Nat.card F'' : ℚ_[ℓ]) ^ (n - 1) =
      (Nat.card F'' : ℚ_[ℓ]) * (Nat.card F'' : ℚ_[ℓ]) ^ (n - 2) := by
    rw [← pow_succ']
    congr 1
    omega
  rw [hpow] at hP
  obtain ⟨ψ, hψ, hψs, hψΦ⟩ := wc_pencil_fibre_restrict_injective F' F'' Y n h4 D ℓ hℓ hX hZ
  exact s7 eV eW eU (wcCohScalar F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2))
    (wcCohScalar F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ n)
    (wcCohScalar F'' D.Z hZ ℓ (n - 2))
    (wcCohFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2))
    (wcCohFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ n)
    (wcCohFrob F'' D.Z hZ ℓ (n - 2))
    heV heW heU (s9 F'' _ hX (n - 2)) (s9 F'' _ hX n) (s9 F'' D.Z hZ (n - 2))
    ψ hψ hψs hψΦ _ _ hqne hsne P hP hPl hPr Q hQ hQr

theorem wc_pencil_edge_zero (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (α : AlgebraicClosure ℚ_[ℓ])
    (hα : wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0 (wcRqScalar D.f ℓ n c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0) α) :
    (4 ≤ n ∧ ∀ (hZ : WeaklyEtale (Limits.pullback.fst D.Z.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))),
        ∃ (rZ : ℕ) (eZ : wcCoh F'' D.Z hZ ℓ (n - 2) ≃+ (Fin rZ → ℚ_[ℓ])),
          (∀ (c : ℚ_[ℓ]) (x : wcCoh F'' D.Z hZ ℓ (n - 2)),
            eZ (wcCohScalar F'' D.Z hZ ℓ (n - 2) c x) = c • eZ x) ∧
          ∃ β ∈ (wcAddEquivMatrix eZ (wcCohFrob F'' D.Z hZ ℓ (n - 2))).charpoly.aroots
              (AlgebraicClosure ℚ_[ℓ]),
            α = algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) (Nat.card F'' : ℚ_[ℓ]) * β) ∨
    ∀ ι : AlgebraicClosure ℚ_[ℓ] ≃+* ℂ,
      ‖ι α‖ ^ 2 ≤ (Nat.card F'' : ℝ) * (Nat.card F'' : ℝ) ^ n :=
by
  classical
  set f : ℚ_[ℓ] →+* AlgebraicClosure ℚ_[ℓ] := algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) with hf
  have hext : ∀ {m k : ℕ} (M N : Matrix (Fin m) (Fin k) ℚ_[ℓ]),
      (∀ v, M.mulVec v = N.mulVec v) → M = N := by
    intro m k M N h
    apply Matrix.toLin'.injective
    apply LinearMap.ext
    intro v
    rw [Matrix.toLin'_apply, Matrix.toLin'_apply, h v]
  have hdiag : ∀ {m : ℕ} (K : Type) [CommRing K] (c : K) (v : Fin m → K),
      (Matrix.diagonal fun _ => c).mulVec v = c • v := by
    intro m K _ c v
    ext i
    rw [Matrix.mulVec_diagonal]
    rfl

  have mk : ∀ {V W : Type (u+1)} [AddCommGroup V] [AddCommGroup W] {r r' : ℕ}
      (eV : V ≃+ (Fin r → ℚ_[ℓ])) (eW : W ≃+ (Fin r' → ℚ_[ℓ]))
      (sV : ℚ_[ℓ] → V →+ V) (sW : ℚ_[ℓ] → W →+ W),
      (∀ c x, eV (sV c x) = c • eV x) → (∀ c y, eW (sW c y) = c • eW y) →
      ∀ (ψ : V →+ W), (∀ c x, ψ (sV c x) = sW c (ψ x)) →
      ∃ M : Matrix (Fin r') (Fin r) ℚ_[ℓ], (∀ v, M.mulVec v = eW (ψ (eV.symm v))) ∧
        ∀ a b, M a b = eW (ψ (eV.symm (Pi.single b 1))) a := by
    intro V W _ _ r r' eV eW sV sW heV heW ψ hψ
    have hes : ∀ (c : ℚ_[ℓ]) (v : Fin r → ℚ_[ℓ]), eV.symm (c • v) = sV c (eV.symm v) :=
      fun c v => eV.injective (by rw [heV, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
    let L : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r' → ℚ_[ℓ]) :=
      { toFun := fun v => eW (ψ (eV.symm v))
        map_add' := fun v w => by simp only [map_add]
        map_smul' := fun c v => by simp only [hes, hψ, heW, RingHom.id_apply] }
    refine ⟨LinearMap.toMatrix' L, fun v => LinearMap.toMatrix'_mulVec L v, fun a b => ?_⟩
    rw [LinearMap.toMatrix'_apply]
    rfl

  have eig : ∀ {r : ℕ} (M : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (α : AlgebraicClosure ℚ_[ℓ]),
      α ∈ M.charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) →
      ∃ v : Fin r → AlgebraicClosure ℚ_[ℓ], v ≠ 0 ∧ (M.map f).mulVec v = α • v := by
    intro r M α hα
    rw [Polynomial.mem_aroots] at hα
    obtain ⟨_, hα⟩ := hα
    have hdet : (Matrix.scalar (Fin r) α - M.map f).det = 0 := by
      rw [← Matrix.eval_charpoly, Matrix.charpoly_map, Polynomial.eval_map, ← Polynomial.aeval_def]
      exact hα
    obtain ⟨v, hv0, hv⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
    refine ⟨v, hv0, ?_⟩
    rw [Matrix.sub_mulVec, sub_eq_zero] at hv
    rw [← hv, Matrix.scalar_apply, hdiag]
  have root : ∀ {r : ℕ} (M : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (α : AlgebraicClosure ℚ_[ℓ])
      (v : Fin r → AlgebraicClosure ℚ_[ℓ]), v ≠ 0 → (M.map f).mulVec v = α • v →
      α ∈ M.charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) := by
    intro r M α v hv0 hMv
    have hdet : (Matrix.scalar (Fin r) α - M.map f).det = 0 := by
      apply Matrix.exists_mulVec_eq_zero_iff.mp
      refine ⟨v, hv0, ?_⟩
      rw [Matrix.sub_mulVec, hMv, Matrix.scalar_apply, hdiag, sub_self]
    rw [Polynomial.mem_aroots]
    refine ⟨(Matrix.charpoly_monic M).ne_zero, ?_⟩
    rw [Polynomial.aeval_def, ← Polynomial.eval_map, ← Matrix.charpoly_map, Matrix.eval_charpoly]
    exact hdet

  have s5 : ∀ {V W : Type (u+1)} [AddCommGroup V] [AddCommGroup W] {r r' : ℕ}
      (eV : V ≃+ (Fin r → ℚ_[ℓ])) (eW : W ≃+ (Fin r' → ℚ_[ℓ]))
      (sV : ℚ_[ℓ] → V →+ V) (sW : ℚ_[ℓ] → W →+ W) (ΦV : V →+ V) (ΦW : W →+ W),
      (∀ c x, eV (sV c x) = c • eV x) → (∀ c y, eW (sW c y) = c • eW y) →
      (∀ c x, ΦV (sV c x) = sV c (ΦV x)) → (∀ c y, ΦW (sW c y) = sW c (ΦW y)) →
      ∀ (ρ : V →+ W), (∀ c x, ρ (sV c x) = sW c (ρ x)) → (∀ x, ρ (ΦV x) = ΦW (ρ x)) →
      ∀ (c : ℚ_[ℓ]), (∀ x, ρ x = 0 → ΦV (ΦV x) = sV c x) →
      ∀ α ∈ (wcAddEquivMatrix eV ΦV).charpoly.aroots (AlgebraicClosure ℚ_[ℓ]),
      α ^ 2 = f c ∨ α ∈ (wcAddEquivMatrix eW ΦW).charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) := by
    intro V W _ _ r r' eV eW sV sW ΦV ΦW heV heW hΦV hΦW ρ hρs hρΦ c hker α hα
    obtain ⟨A, hAv, hAe⟩ := mk eV eV sV sV heV heV ΦV hΦV
    obtain ⟨B, hBv, hBe⟩ := mk eW eW sW sW heW heW ΦW hΦW
    obtain ⟨P, hPv, -⟩ := mk eV eW sV sW heV heW ρ hρs
    have hA : wcAddEquivMatrix eV ΦV = A := by
      ext a b
      rw [hAe]
      rfl
    have hB : wcAddEquivMatrix eW ΦW = B := by
      ext a b
      rw [hBe]
      rfl
    rw [hA] at hα
    rw [hB]
    have hPA : P * A = B * P := hext _ _ (fun v => by
      rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, hAv, hPv, hPv, hBv,
        AddEquiv.symm_apply_apply, AddEquiv.symm_apply_apply, hρΦ])
    set T : Matrix (Fin r) (Fin r) ℚ_[ℓ] := A * A - Matrix.diagonal (fun _ => c) with hT
    have hkerT : ∀ v, P.mulVec v = 0 → T.mulVec v = 0 := by
      intro v hv
      rw [hPv] at hv
      have h0 : ρ (eV.symm v) = 0 := eW.injective (hv.trans (map_zero eW).symm)
      have h1 := hker _ h0
      rw [hT, Matrix.sub_mulVec, ← Matrix.mulVec_mulVec, hAv, hAv, AddEquiv.symm_apply_apply, h1,
        heV, AddEquiv.apply_symm_apply, hdiag, sub_self]
    have hker' : LinearMap.ker (Matrix.toLin' P) ≤ LinearMap.ker (Matrix.toLin' T) := by
      intro v hv
      rw [LinearMap.mem_ker, Matrix.toLin'_apply] at hv ⊢
      exact hkerT v hv
    let g₁ := (LinearMap.ker (Matrix.toLin' P)).liftQ (Matrix.toLin' T) hker'
    let g₂ := g₁ ∘ₗ (Matrix.toLin' P).quotKerEquivRange.symm.toLinearMap
    obtain ⟨G, hG⟩ := LinearMap.exists_extend g₂
    have hGP : ∀ v, G (P.mulVec v) = T.mulVec v := by
      intro v
      have hmem : P.mulVec v ∈ LinearMap.range (Matrix.toLin' P) :=
        LinearMap.mem_range.mpr ⟨v, Matrix.toLin'_apply P v⟩
      have h1 : G (P.mulVec v) = g₂ ⟨P.mulVec v, hmem⟩ := by
        rw [← hG]
        rfl
      have h2 : (Matrix.toLin' P).quotKerEquivRange.symm ⟨P.mulVec v, hmem⟩ =
          Submodule.Quotient.mk v := by
        rw [LinearEquiv.symm_apply_eq]
        apply Subtype.ext
        rw [LinearMap.quotKerEquivRange_apply_mk, Matrix.toLin'_apply]
      rw [h1]
      show g₁ ((Matrix.toLin' P).quotKerEquivRange.symm ⟨P.mulVec v, hmem⟩) = _
      rw [h2, Submodule.liftQ_apply, Matrix.toLin'_apply]
    set Q := LinearMap.toMatrix' G with hQ
    have hQP : Q * P = T := hext _ _ (fun v => by
      rw [← Matrix.mulVec_mulVec, hQ, LinearMap.toMatrix'_mulVec, hGP])
    obtain ⟨v, hv0, hv⟩ := eig A α hα
    by_cases hPv0 : (P.map f).mulVec v = 0
    · left
      have hTm : T.map f = A.map f * A.map f - Matrix.diagonal (fun _ => f c) := by
        rw [hT, ← RingHom.mapMatrix_apply, map_sub, map_mul, RingHom.mapMatrix_apply,
          RingHom.mapMatrix_apply, Matrix.diagonal_map (map_zero _)]
      have h1 : (T.map f).mulVec v = 0 := by
        rw [← hQP, Matrix.map_mul, ← Matrix.mulVec_mulVec, hPv0, Matrix.mulVec_zero]
      rw [hTm, Matrix.sub_mulVec, ← Matrix.mulVec_mulVec, hv, Matrix.mulVec_smul, hv, hdiag,
        smul_smul, ← sub_smul] at h1
      have h2 := (smul_eq_zero.mp h1).resolve_right hv0
      rw [sq]
      exact sub_eq_zero.mp h2
    · right
      apply root B α ((P.map f).mulVec v) hPv0
      rw [Matrix.mulVec_mulVec, ← Matrix.map_mul, ← hPA, Matrix.map_mul, ← Matrix.mulVec_mulVec,
        hv, Matrix.mulVec_smul]

  have s7 : ∀ {W' W : Type (u+1)} [AddCommGroup W'] [AddCommGroup W] {r' r : ℕ}
      (eW' : W' ≃+ (Fin r' → ℚ_[ℓ])) (eW : W ≃+ (Fin r → ℚ_[ℓ]))
      (sW' : ℚ_[ℓ] → W' →+ W') (sW : ℚ_[ℓ] → W →+ W) (ΦW' : W' →+ W') (ΦW : W →+ W),
      (∀ c z, eW' (sW' c z) = c • eW' z) → (∀ c y, eW (sW c y) = c • eW y) →
      (∀ c z, ΦW' (sW' c z) = sW' c (ΦW' z)) → (∀ c y, ΦW (sW c y) = sW c (ΦW y)) →
      ∀ (γ : W' →+ W), Function.Surjective γ → (∀ c z, γ (sW' c z) = sW c (γ z)) →
      ∀ (c : ℚ_[ℓ]), c ≠ 0 → (∀ z, ΦW (γ z) = sW c (γ (ΦW' z))) →
      ∀ α ∈ (wcAddEquivMatrix eW ΦW).charpoly.aroots (AlgebraicClosure ℚ_[ℓ]),
      ∃ β ∈ (wcAddEquivMatrix eW' ΦW').charpoly.aroots (AlgebraicClosure ℚ_[ℓ]), α = f c * β := by
    intro W' W _ _ r' r eW' eW sW' sW ΦW' ΦW heW' heW hΦW' hΦW γ hγ hγs c hc hγΦ α hα
    obtain ⟨C, hCv, hCe⟩ := mk eW' eW' sW' sW' heW' heW' ΦW' hΦW'
    obtain ⟨B, hBv, hBe⟩ := mk eW eW sW sW heW heW ΦW hΦW
    obtain ⟨G, hGv, -⟩ := mk eW' eW sW' sW heW' heW γ hγs
    have hC : wcAddEquivMatrix eW' ΦW' = C := by
      ext a b
      rw [hCe]
      rfl
    have hB : wcAddEquivMatrix eW ΦW = B := by
      ext a b
      rw [hBe]
      rfl
    rw [hB] at hα
    rw [hC]
    have hBG : B * G = c • (G * C) := hext _ _ (fun z => by
      rw [Matrix.smul_mulVec, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, hGv, hBv, hCv, hGv,
        AddEquiv.symm_apply_apply, AddEquiv.symm_apply_apply, hγΦ, heW])
    have hGinj : ∀ w : Fin r → ℚ_[ℓ], Matrix.vecMul w G = 0 → w = 0 := by
      intro w hw
      funext i
      obtain ⟨z', hz'⟩ := hγ (eW.symm (Pi.single i 1))
      have h1 : G.mulVec (eW' z') = Pi.single i 1 := by
        rw [hGv, AddEquiv.symm_apply_apply, hz', AddEquiv.apply_symm_apply]
      have h2 := Matrix.dotProduct_mulVec w G (eW' z')
      rw [h1, hw, zero_dotProduct, dotProduct_single, mul_one] at h2
      exact h2
    set Gt := G.transpose with hGt
    have hker : LinearMap.ker (Matrix.toLin' Gt) = ⊥ := by
      rw [LinearMap.ker_eq_bot']
      intro w hw
      rw [Matrix.toLin'_apply, hGt, Matrix.mulVec_transpose] at hw
      exact hGinj w hw
    obtain ⟨g, hg⟩ := LinearMap.exists_leftInverse_of_injective _ hker
    have hHG : LinearMap.toMatrix' g * Gt = 1 := by
      have := congrArg LinearMap.toMatrix' hg
      rwa [LinearMap.toMatrix'_comp, LinearMap.toMatrix'_toLin', LinearMap.toMatrix'_id] at this
    have hHGL : (LinearMap.toMatrix' g).map f * Gt.map f = 1 := by
      rw [← Matrix.map_mul, hHG, Matrix.map_one _ (map_zero f) (map_one f)]
    have hrel : Gt * B.transpose = c • (C.transpose * Gt) := by
      rw [hGt, ← Matrix.transpose_mul, hBG, Matrix.transpose_smul, Matrix.transpose_mul]
    have hsm : ∀ M : Matrix (Fin r') (Fin r) ℚ_[ℓ], (c • M).map f = f c • M.map f := by
      intro M
      ext x y
      rw [Matrix.map_apply, Matrix.smul_apply, Matrix.smul_apply, Matrix.map_apply, smul_eq_mul,
        smul_eq_mul, map_mul]
    have hrelL : Gt.map f * B.transpose.map f = f c • (C.transpose.map f * Gt.map f) := by
      rw [← Matrix.map_mul, hrel, hsm, Matrix.map_mul]
    rw [← Matrix.charpoly_transpose] at hα
    obtain ⟨w, hw0, hw⟩ := eig B.transpose α hα
    have hy0 : (Gt.map f).mulVec w ≠ 0 := by
      intro h0
      apply hw0
      have e1 : ((LinearMap.toMatrix' g).map f).mulVec ((Gt.map f).mulVec w) = w := by
        rw [Matrix.mulVec_mulVec, hHGL, Matrix.one_mulVec]
      rw [← e1, h0, Matrix.mulVec_zero]
    have hfc : f c ≠ 0 := (map_ne_zero f).mpr hc
    have hCy : f c • (C.transpose.map f).mulVec ((Gt.map f).mulVec w) =
        α • (Gt.map f).mulVec w := by
      have h5 : (Gt.map f * B.transpose.map f).mulVec w =
          (f c • (C.transpose.map f * Gt.map f)).mulVec w := by rw [hrelL]
      rw [← Matrix.mulVec_mulVec, hw, Matrix.mulVec_smul, Matrix.smul_mulVec,
        ← Matrix.mulVec_mulVec] at h5
      exact h5.symm
    have hCy' : (C.transpose.map f).mulVec ((Gt.map f).mulVec w) =
        (α / f c) • (Gt.map f).mulVec w := by
      rw [div_eq_inv_mul, mul_smul, ← hCy, smul_smul, inv_mul_cancel₀ hfc, one_smul]
    have hβ := root C.transpose (α / f c) _ hy0 hCy'
    rw [Matrix.charpoly_transpose] at hβ
    refine ⟨α / f c, hβ, ?_⟩
    field_simp

  have s9 : ∀ (F₀ : Type u) [Field F₀] [Finite F₀] (X₀ : Over (Spec (.of F₀)))
      (h₀ : WeaklyEtale (Limits.pullback.fst X₀.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F₀ (AlgebraicClosure F₀))))))
      (i : ℕ) (c : ℚ_[ℓ]) (x : wcCoh F₀ X₀ h₀ ℓ i),
      wcCohFrob F₀ X₀ h₀ ℓ i (wcCohScalar F₀ X₀ h₀ ℓ i c x) =
        wcCohScalar F₀ X₀ h₀ ℓ i c (wcCohFrob F₀ X₀ h₀ ℓ i x) := by
    intro F₀ _ _ X₀ h₀ i c x
    show (Abelian.Ext.mk₀ (wcFreeSheafMap X₀.left (wcGeomFrob F₀ X₀ h₀))).comp
        (x.comp (Abelian.Ext.mk₀ (wcLadicScalar X₀.left ℓ c)) (add_zero i)) (zero_add i) =
      ((Abelian.Ext.mk₀ (wcFreeSheafMap X₀.left (wcGeomFrob F₀ X₀ h₀))).comp x (zero_add i)).comp
        (Abelian.Ext.mk₀ (wcLadicScalar X₀.left ℓ c)) (add_zero i)
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add i) (add_zero i) (by omega)).symm
  have hΦE : ∀ (c : ℚ_[ℓ]) (x : wcCohG F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0),
      wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0
          (wcCohGEnd F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0 (wcRqScalar D.f ℓ n c) x) =
        wcCohGEnd F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0 (wcRqScalar D.f ℓ n c)
          (wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0 x) := by
    intro c x
    show (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left (wcGeomFrob F'' (wcP1Over F'') hP))).comp
        (x.comp (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ n c)) (add_zero 0)) (zero_add 0) =
      ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left
          (wcGeomFrob F'' (wcP1Over F'') hP))).comp x (zero_add 0)).comp
        (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ n c)) (add_zero 0)
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (add_zero 0) (by omega)).symm

  obtain ⟨r, e, he, hαr⟩ := hα
  have hq0 : 0 < Nat.card F'' := Finite.card_pos
  have hq1 : (1 : ℝ) ≤ (Nat.card F'' : ℝ) := by exact_mod_cast hq0
  have hqne : (Nat.card F'' : ℚ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr hq0.ne'
  obtain ⟨hgi, hpr, hsm⟩ := wc_pencil_fibre_props F' F'' Y n hn2 D
  haveI : GeometricallyIrreducible (Over.mk (Limits.pullback.snd D.f D.u0)).hom := hgi
  haveI : IsProper (Over.mk (Limits.pullback.snd D.f D.u0)).hom := hpr
  haveI : SmoothOfRelativeDimension (n - 1) (Over.mk (Limits.pullback.snd D.f D.u0)).hom := hsm
  have hX : WeaklyEtale (Limits.pullback.fst (Over.mk (Limits.pullback.snd D.f D.u0)).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F'')
  obtain ⟨rW, eW, heW⟩ :=
    wc_coh_finite F'' (Over.mk (Limits.pullback.snd D.f D.u0)) (n - 1) ℓ hℓ hX n
  obtain ⟨ρ, hρs, hρΦ, hker⟩ := wc_pencil_H0_fibre_restrict F' F'' Y n hn hn2 D ℓ hℓ hP hX
  have hsplit := s5 e eW
    (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0 (wcRqScalar D.f ℓ n c))
    (wcCohScalar F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ n)
    (wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0)
    (wcCohFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ n)
    he heW hΦE (s9 F'' _ hX n) ρ hρs hρΦ ((Nat.card F'' : ℚ_[ℓ]) ^ n) hker α hαr
  rcases hsplit with hsq | hB
  ·
    right
    intro ι
    have h1 : ι α ^ 2 = (Nat.card F'' : ℂ) ^ n := by
      rw [← map_pow, hsq]
      simp only [map_pow, map_natCast]
    have h2 : ‖ι α‖ ^ 2 = (Nat.card F'' : ℝ) ^ n := by
      rw [← norm_pow, h1, norm_pow, Complex.norm_natCast]
    rw [h2]
    exact le_mul_of_one_le_left (by positivity) hq1
  · rcases (show n = 2 ∨ 4 ≤ n by obtain ⟨t, ht⟩ := hn; omega) with h2 | h4
    ·
      right
      subst h2
      haveI hsm1 : SmoothOfRelativeDimension 1 (Over.mk (Limits.pullback.snd D.f D.u0)).hom := hsm
      obtain ⟨-, htop⟩ := wc_top_coh_frobenius F'' (Over.mk (Limits.pullback.snd D.f D.u0)) 1 ℓ hℓ hX
      have htop' : ∀ x : wcCoh F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ 2,
          wcCohFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ 2 x =
            wcCohScalar F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ 2
              (Nat.card F'' : ℚ_[ℓ]) x := by
        intro x
        have h3 := htop x
        rw [pow_one] at h3
        exact h3
      have hBd : wcAddEquivMatrix eW (wcCohFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ 2) =
          Matrix.diagonal (fun _ => (Nat.card F'' : ℚ_[ℓ])) := by
        ext a b
        show eW (wcCohFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ 2
          (eW.symm (Pi.single b 1))) a = _
        rw [htop', heW, AddEquiv.apply_symm_apply, Matrix.diagonal_apply, Pi.smul_apply,
          Pi.single_apply, smul_eq_mul]
        split_ifs <;> simp
      rw [hBd] at hB
      obtain ⟨v, hv0, hv⟩ := eig _ α hB
      rw [Matrix.diagonal_map (map_zero f), hdiag] at hv
      have hαq : α = f (Nat.card F'' : ℚ_[ℓ]) := by
        have h3 : (f (Nat.card F'' : ℚ_[ℓ]) - α) • v = 0 := by rw [sub_smul, hv, sub_self]
        exact (sub_eq_zero.mp ((smul_eq_zero.mp h3).resolve_right hv0)).symm
      intro ι
      have h5 : ‖ι α‖ = (Nat.card F'' : ℝ) := by
        rw [hαq]
        simp only [map_natCast, Complex.norm_natCast]
      rw [h5]
      exact le_mul_of_one_le_left (by positivity) hq1
    ·
      left
      refine ⟨h4, fun hZ => ?_⟩
      haveI := D.Zgi h4
      haveI := D.Zproper
      haveI := D.Zsmooth
      obtain ⟨rZ, eZ, heZ⟩ := wc_coh_finite F'' D.Z (n - 2) ℓ hℓ hZ (n - 2)
      obtain ⟨γ, hγ, hγs, hγΦ⟩ := wc_pencil_fibre_gysin F' F'' Y n hn h4 D ℓ hℓ hX hZ
      obtain ⟨β, hβ, hαβ⟩ := s7 eZ eW (wcCohScalar F'' D.Z hZ ℓ (n - 2))
        (wcCohScalar F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ n)
        (wcCohFrob F'' D.Z hZ ℓ (n - 2))
        (wcCohFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ n)
        heZ heW (s9 F'' D.Z hZ (n - 2)) (s9 F'' _ hX n) γ hγ hγs _ hqne hγΦ α hB
      exact ⟨rZ, eZ, heZ, β, hβ, hαβ⟩

theorem wc_powersum_root_bound (H : Multiset ℂ) (R C : ℝ) (hR : 0 < R)
    (hH : ∀ e : ℕ, 1 ≤ e → ‖(H.map (· ^ e)).sum‖ ≤ C * R ^ e) :
    ∀ z ∈ H, ‖z‖ ≤ R :=
by
  classical

  have s1 : ∀ u : ℂ, ‖u‖ ≤ 1 → ∀ N : ℕ,
      -(if u = 1 then (0 : ℝ) else 2 / ‖1 - u‖) ≤ (∑ e ∈ Finset.range N, u ^ (e + 1)).re := by
    intro u hu N
    split_ifs with h
    · subst h
      simp
    · have hu1 : u - 1 ≠ 0 := sub_ne_zero.mpr h
      have hpos : 0 < ‖u - 1‖ := norm_pos_iff.mpr hu1
      set S := ∑ e ∈ Finset.range N, u ^ (e + 1) with hSdef
      have hmul : S * (u - 1) = u * (u ^ N - 1) := by
        calc S * (u - 1) = u * ((u - 1) * ∑ e ∈ Finset.range N, u ^ e) := by
              rw [hSdef, Finset.sum_mul, Finset.mul_sum, Finset.mul_sum]
              refine Finset.sum_congr rfl fun e _ => by ring
          _ = u * (u ^ N - 1) := by rw [mul_geom_sum]
      have hn : ‖S‖ * ‖u - 1‖ ≤ 2 := by
        rw [← norm_mul, hmul, norm_mul]
        have h2 : ‖u ^ N - 1‖ ≤ 2 := by
          calc ‖u ^ N - 1‖ ≤ ‖u ^ N‖ + ‖(1 : ℂ)‖ := norm_sub_le _ _
            _ ≤ 1 + 1 := by
              rw [norm_pow, norm_one]
              gcongr
              exact pow_le_one₀ (norm_nonneg u) hu
            _ = 2 := by norm_num
        calc ‖u‖ * ‖u ^ N - 1‖ ≤ 1 * 2 :=
              mul_le_mul hu h2 (norm_nonneg _) zero_le_one
          _ = 2 := by norm_num
      have hS : ‖S‖ ≤ 2 / ‖1 - u‖ := by
        rw [norm_sub_rev, le_div_iff₀ hpos]
        exact hn
      have h3 := Complex.abs_re_le_norm S
      have h4 := neg_abs_le S.re
      linarith

  have s1one : ∀ N : ℕ, (∑ e ∈ Finset.range N, (1 : ℂ) ^ (e + 1)).re = N := by
    intro N; simp

  have s2 : ∀ (W : Multiset ℂ) (e : ℕ), ‖(W.map (· ^ e)).sum‖ ^ 2 =
      (((W.bind fun a => W.map fun b => a * (starRingEnd ℂ) b).map (· ^ e)).sum).re := by
    intro W e
    have h1 : ((‖(W.map (· ^ e)).sum‖ ^ 2 : ℝ) : ℂ) =
        (W.map (· ^ e)).sum * (starRingEnd ℂ) (W.map (· ^ e)).sum := by
      rw [Complex.mul_conj']
      push_cast
      rfl
    have h2 : ((W.bind fun a => W.map fun b => a * (starRingEnd ℂ) b).map (· ^ e)).sum =
        (W.map (· ^ e)).sum * (starRingEnd ℂ) (W.map (· ^ e)).sum := by
      have e1 : ((W.bind fun a => W.map fun b => a * (starRingEnd ℂ) b).map (· ^ e)).sum =
          (W.map fun a => (W.map fun b => a ^ e * (starRingEnd ℂ) b ^ e).sum).sum := by
        rw [Multiset.map_bind, Multiset.sum_bind]
        apply congrArg Multiset.sum
        apply Multiset.map_congr rfl
        intro a _
        rw [Multiset.map_map]
        apply congrArg Multiset.sum
        apply Multiset.map_congr rfl
        intro b _
        simp [mul_pow]
      have e2 : (starRingEnd ℂ) (W.map (· ^ e)).sum =
          (W.map fun b => (starRingEnd ℂ) b ^ e).sum := by
        rw [map_multiset_sum, Multiset.map_map]
        apply congrArg Multiset.sum
        apply Multiset.map_congr rfl
        intro b _
        simp
      rw [e1, e2, ← Multiset.sum_map_mul_right]
      apply congrArg Multiset.sum
      apply Multiset.map_congr rfl
      intro a _
      exact Multiset.sum_map_mul_left
    rw [h2, ← h1, Complex.ofReal_re]

  have s3 : ∀ (N : ℕ) (Q : Multiset ℂ), ∑ e ∈ Finset.range N, ((Q.map (· ^ (e + 1))).sum).re =
      (Q.map fun u => (∑ e ∈ Finset.range N, u ^ (e + 1)).re).sum := by
    intro N Q
    induction Q using Multiset.induction_on with
    | empty => simp
    | cons a Q ih =>
      rw [Multiset.map_cons, Multiset.sum_cons, ← ih]
      simp only [Multiset.map_cons, Multiset.sum_cons, Complex.add_re, Finset.sum_add_distrib,
        Complex.re_sum]

  intro z hz
  by_contra hcon
  rw [not_le] at hcon
  have hH0 : H ≠ 0 := by
    intro h
    rw [h] at hz
    simp at hz
  obtain ⟨z₀, hz₀, hmax⟩ := Multiset.exists_max_image (fun x : ℂ => ‖x‖) hH0
  set M : ℝ := ‖z₀‖ with hMdef
  have hRM : R < M := lt_of_lt_of_le hcon (hmax z hz)
  have hM : 0 < M := hR.trans hRM
  have hnormM : ∀ x : ℂ, ‖x / (M : ℂ)‖ = ‖x‖ / M := by
    intro x
    rw [norm_div, Complex.norm_real, Real.norm_of_nonneg hM.le]
  set W := H.map (fun x => x / (M : ℂ)) with hWdef
  have hW : ∀ w ∈ W, ‖w‖ ≤ 1 := by
    intro w hw
    obtain ⟨x, hx, rfl⟩ := Multiset.mem_map.mp hw
    rw [hnormM, div_le_one hM]
    exact hmax x hx
  have hpW : ∀ e : ℕ, (W.map (· ^ e)).sum = (H.map (· ^ e)).sum / (M : ℂ) ^ e := by
    intro e
    rw [hWdef, Multiset.map_map, ← Multiset.sum_map_div]
    apply congrArg Multiset.sum
    apply Multiset.map_congr rfl
    intro x _
    simp [div_pow]
  set P := W.bind fun a => W.map fun b => a * (starRingEnd ℂ) b with hPdef
  have hP : ∀ u ∈ P, ‖u‖ ≤ 1 := by
    intro u hu
    obtain ⟨a, ha, hu'⟩ := Multiset.mem_bind.mp hu
    obtain ⟨b, hb, rfl⟩ := Multiset.mem_map.mp hu'
    rw [norm_mul, Complex.norm_conj]
    calc ‖a‖ * ‖b‖ ≤ 1 * 1 := mul_le_mul (hW a ha) (hW b hb) (norm_nonneg _) zero_le_one
      _ = 1 := one_mul 1
  have h1P : (1 : ℂ) ∈ P := by
    have hw0 : z₀ / (M : ℂ) ∈ W := Multiset.mem_map_of_mem _ hz₀
    refine Multiset.mem_bind.mpr ⟨z₀ / (M : ℂ), hw0, Multiset.mem_map.mpr ⟨z₀ / (M : ℂ), hw0, ?_⟩⟩
    rw [Complex.mul_conj', hnormM, ← hMdef, div_self hM.ne']
    simp
  set hfun : ℂ → ℝ := fun u => if u = 1 then (0 : ℝ) else 2 / ‖1 - u‖ with hfundef
  set K : ℝ := (P.map hfun).sum with hKdef

  have hlow : ∀ N : ℕ, (N : ℝ) - K ≤
      ∑ e ∈ Finset.range N, ‖(W.map (· ^ (e + 1))).sum‖ ^ 2 := by
    intro N
    have e1 : ∑ e ∈ Finset.range N, ‖(W.map (· ^ (e + 1))).sum‖ ^ 2 =
        (P.map fun u => (∑ e ∈ Finset.range N, u ^ (e + 1)).re).sum := by
      rw [← s3 N P]
      refine Finset.sum_congr rfl fun e _ => ?_
      rw [s2 W (e + 1)]
    rw [e1]
    obtain ⟨P', hP'⟩ := Multiset.exists_cons_of_mem h1P
    have hP'b : ∀ u ∈ P', ‖u‖ ≤ 1 := fun u hu =>
      hP u (by rw [hP']; exact Multiset.mem_cons_of_mem hu)
    rw [hKdef, hP', Multiset.map_cons, Multiset.sum_cons, Multiset.map_cons, Multiset.sum_cons,
      s1one]
    have hh1 : hfun 1 = 0 := by simp [hfundef]
    rw [hh1]
    have h2 : (P'.map fun u => -hfun u).sum ≤
        (P'.map fun u => (∑ e ∈ Finset.range N, u ^ (e + 1)).re).sum :=
      Multiset.sum_map_le_sum_map _ _ (fun u hu => s1 u (hP'b u hu) N)
    rw [Multiset.sum_map_neg] at h2
    linarith

  set ρ : ℝ := (R / M) ^ 2 with hρdef
  have hρ0 : 0 ≤ ρ := by positivity
  have hρ1 : ρ < 1 := by
    rw [hρdef]
    have h0 : 0 ≤ R / M := by positivity
    have h1 : R / M < 1 := by rw [div_lt_one hM]; exact hRM
    nlinarith
  have hterm : ∀ e : ℕ, ‖(W.map (· ^ (e + 1))).sum‖ ^ 2 ≤ C ^ 2 * ρ ^ e := by
    intro e
    have hb : ‖(W.map (· ^ (e + 1))).sum‖ ≤ C * (R / M) ^ (e + 1) := by
      rw [hpW, norm_div, norm_pow, Complex.norm_real, Real.norm_of_nonneg hM.le,
        div_le_iff₀ (pow_pos hM _), div_pow, mul_assoc, div_mul_cancel₀ _ (pow_pos hM _).ne']
      exact hH (e + 1) (by omega)
    have hb2 := pow_le_pow_left₀ (norm_nonneg _) hb 2
    calc ‖(W.map (· ^ (e + 1))).sum‖ ^ 2 ≤ (C * (R / M) ^ (e + 1)) ^ 2 := hb2
      _ = C ^ 2 * ρ ^ (e + 1) := by
        rw [hρdef, mul_pow, ← pow_mul, ← pow_mul, mul_comm 2 (e + 1)]
      _ ≤ C ^ 2 * ρ ^ e := by
        apply mul_le_mul_of_nonneg_left _ (sq_nonneg C)
        exact pow_le_pow_of_le_one hρ0 hρ1.le (by omega)
  have hup : ∀ N : ℕ, ∑ e ∈ Finset.range N, ‖(W.map (· ^ (e + 1))).sum‖ ^ 2 ≤
      C ^ 2 / (1 - ρ) := by
    intro N
    calc ∑ e ∈ Finset.range N, ‖(W.map (· ^ (e + 1))).sum‖ ^ 2
        ≤ ∑ e ∈ Finset.range N, C ^ 2 * ρ ^ e := Finset.sum_le_sum fun e _ => hterm e
      _ = C ^ 2 * ∑ e ∈ Finset.range N, ρ ^ e := by rw [Finset.mul_sum]
      _ ≤ C ^ 2 * (1 / (1 - ρ)) := by
        apply mul_le_mul_of_nonneg_left _ (sq_nonneg C)
        have := geom_sum_Ico_le_of_lt_one (m := 0) (n := N) hρ0 hρ1
        rw [Finset.range_eq_Ico]
        simpa using this
      _ = C ^ 2 / (1 - ρ) := by ring
  obtain ⟨N, hN⟩ := exists_nat_gt (K + C ^ 2 / (1 - ρ))
  have := hlow N
  have := hup N
  linarith

theorem wc_trace_data_local_purity (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (q β r : ℕ) (hq : 1 ≤ q)
    (T : wcPureTraceData ℓ q β r) :
    ∀ d : ℕ, 1 ≤ d → ∀ x : Fin (T.np d), ∀ γ ∈ T.loc d x,
      ∀ ι : AlgebraicClosure ℚ_[ℓ] ≃+* ℂ, ‖ι γ‖ ^ 2 = (q : ℝ) ^ (β * d) :=
by
  classical

  have s5 : ∀ X Y Q : ℝ, 0 < Y → (∀ k : ℕ, 1 ≤ k → X ^ k ≤ Y ^ k * Q) → X ≤ Y := by
    intro X Y Q hY H
    by_contra hXY
    push_neg at hXY
    set z := X / Y - 1 with hz
    have hz0 : 0 < z := by rw [hz, sub_pos, lt_div_iff₀ hY]; linarith
    obtain ⟨T0, hT0⟩ := exists_nat_gt (Q / z)
    have h1 := H (T0 + 1) (by omega)
    have hb := one_add_mul_le_pow (show (-2 : ℝ) ≤ z by linarith) (T0 + 1)
    have h1z : 1 + z = X / Y := by rw [hz]; ring
    have hYp : 0 < Y ^ (T0 + 1) := pow_pos hY _
    rw [h1z, div_pow, le_div_iff₀ hYp] at hb
    have h2 : 1 + ((T0 + 1 : ℕ) : ℝ) * z ≤ Q := by
      have h3 := hb.trans h1
      rw [mul_comm] at h3
      exact le_of_mul_le_mul_left h3 hYp
    have hT' : Q < z * T0 := by rw [div_lt_iff₀ hz0] at hT0; linarith
    push_cast at h2
    nlinarith

  have s3 : ∀ (L : Multiset ℂ) (j : ℕ), ∃ P : Multiset ℂ,
      (∀ m : ℕ, (P.map (· ^ m)).sum = ((L.map (· ^ m)).sum) ^ j) ∧ ∀ z ∈ L, z ^ j ∈ P := by
    intro L j
    induction j with
    | zero => exact ⟨{1}, fun m => by simp, fun z _ => by simp⟩
    | succ j ih =>
      obtain ⟨P, hPs, hPm⟩ := ih
      refine ⟨L.bind (fun a => P.map (a * ·)), fun m => ?_, fun z hz => ?_⟩
      · rw [Multiset.map_bind, Multiset.sum_bind, pow_succ', ← hPs m,
          ← Multiset.sum_map_mul_right]
        congr 1
        apply Multiset.map_congr rfl
        intro a _
        rw [Multiset.map_map]
        simp only [Function.comp_def, mul_pow]
        rw [Multiset.sum_map_mul_left]
      · rw [Multiset.mem_bind]
        exact ⟨z, hz, by rw [pow_succ']; exact Multiset.mem_map_of_mem _ (hPm z hz)⟩

  have s1 : ∀ (U : Multiset ℂ), (∀ u ∈ U, ‖u‖ = 1) → ∀ m₀ : ℕ, ∃ m : ℕ, m₀ ≤ m ∧ 1 ≤ m ∧
      ∀ u ∈ U, (1 : ℝ) / 2 ≤ (u ^ m).re := by
    intro U hU m₀
    let v : ℕ → (U.toFinset → ℂ) := fun n i => (i : ℂ) ^ n
    have hv : ∀ n, v n ∈ Metric.closedBall (0 : U.toFinset → ℂ) 1 := by
      intro n
      rw [mem_closedBall_zero_iff]
      refine (pi_norm_le_iff_of_nonneg zero_le_one).mpr ?_
      intro i
      simp only [v, norm_pow, hU i (Multiset.mem_toFinset.mp i.2), one_pow, le_refl]
    obtain ⟨a, -, φ, hφ, hlim⟩ := tendsto_subseq_of_bounded Metric.isBounded_closedBall hv
    have hc := hlim.cauchySeq
    rw [Metric.cauchySeq_iff] at hc
    obtain ⟨N, hN⟩ := hc (1 / 2) (by norm_num)
    have hab : max m₀ 1 + φ N ≤ φ (max m₀ 1 + N) := hφ.add_le_nat (max m₀ 1) N
    obtain ⟨m, hm⟩ : ∃ m, φ (max m₀ 1 + N) = φ N + m :=
      ⟨φ (max m₀ 1 + N) - φ N, by omega⟩
    refine ⟨m, by omega, by omega, ?_⟩
    intro u hu
    have hd := hN (max m₀ 1 + N) (by omega) N le_rfl
    have hi : dist (v (φ (max m₀ 1 + N)) ⟨u, Multiset.mem_toFinset.mpr hu⟩)
        (v (φ N) ⟨u, Multiset.mem_toFinset.mpr hu⟩) < 1 / 2 :=
      lt_of_le_of_lt (dist_le_pi_dist _ _ _) hd
    simp only [v] at hi
    rw [hm, pow_add, dist_eq_norm] at hi
    have hn1 : ‖u ^ φ N‖ = 1 := by rw [norm_pow, hU u hu, one_pow]
    have e1 : u ^ φ N * u ^ m - u ^ φ N = u ^ φ N * (u ^ m - 1) := by ring
    rw [e1, norm_mul, hn1, one_mul] at hi
    have h1 := Complex.abs_re_le_norm (u ^ m - 1)
    rw [Complex.sub_re, Complex.one_re] at h1
    have h2 := neg_abs_le ((u ^ m).re - 1)
    linarith

  have s2 : ∀ (W : Multiset ℂ) (A C : ℝ), 0 < A →
      (∀ m : ℕ, 1 ≤ m → ((W.map (· ^ m)).sum).re ≤ C * A ^ m) →
      ∀ z ∈ W, ‖z‖ ≤ A := by
    intro W A C hA hW
    have re_ms : ∀ s : Multiset ℂ, s.sum.re = (s.map Complex.re).sum := by
      intro s
      induction s using Multiset.induction_on with
      | empty => simp
      | cons a s ih => simp [ih]
    intro z hz
    by_contra hzA
    push_neg at hzA
    obtain ⟨zs, hzs, hmax⟩ := Multiset.exists_max_image (s := W) (fun w : ℂ => ‖w‖)
      (fun h => by simp [h] at hz)
    have hMA : A < ‖zs‖ := lt_of_lt_of_le hzA (hmax z hz)
    set M := ‖zs‖ with hM
    have hM0 : 0 < M := hA.trans hMA
    set Wt := W.filter (fun w => ‖w‖ = M) with hWt
    set Wl := W.filter (fun w => ¬ ‖w‖ = M) with hWl
    have hWsplit : Wt + Wl = W := Multiset.filter_add_not _ W
    obtain ⟨B, hAB, hBM, hBl⟩ : ∃ B : ℝ, A ≤ B ∧ B < M ∧ ∀ w ∈ Wl, ‖w‖ ≤ B := by
      rcases Multiset.empty_or_exists_mem Wl with h | ⟨w0, hw0⟩
      · exact ⟨A, le_rfl, hMA, by simp [h]⟩
      · obtain ⟨wb, hwb, hwbmax⟩ := Multiset.exists_max_image (s := Wl) (fun w : ℂ => ‖w‖)
          (fun h => by simp [h] at hw0)
        have hwbW := Multiset.mem_filter.mp hwb
        exact ⟨max A ‖wb‖, le_max_left _ _,
          max_lt hMA (lt_of_le_of_ne (hmax wb hwbW.1) hwbW.2),
          fun w hw => le_max_of_le_right (hwbmax w hw)⟩
    have hB0 : 0 < B := hA.trans_le hAB
    set ρ := B / M with hρdef
    have hρ0 : 0 ≤ ρ := by positivity
    have hρ1 : ρ < 1 := (div_lt_one hM0).mpr hBM
    set K : ℝ := (Multiset.card Wl : ℝ) + |C| with hKdef
    have hK : 0 ≤ K := by positivity
    obtain ⟨m₀, hm₀⟩ : ∃ m₀ : ℕ, ρ ^ m₀ * (2 * K + 1) < 1 := by
      have ht := tendsto_pow_atTop_nhds_zero_of_lt_one hρ0 hρ1
      have ht2 := ht.mul_const (2 * K + 1)
      rw [zero_mul] at ht2
      exact (ht2.eventually (gt_mem_nhds one_pos)).exists
    obtain ⟨m, hmm₀, hm1, hU⟩ := s1 (Wt.map (fun w => w / (M : ℂ))) (by
      intro u hu
      obtain ⟨w, hw, rfl⟩ := Multiset.mem_map.mp hu
      rw [norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hM0,
        (Multiset.mem_filter.mp hw).2, div_self hM0.ne']) m₀
    have hbound := hW m hm1
    rw [← hWsplit, Multiset.map_add, Multiset.sum_add, Complex.add_re] at hbound
    have hMm : 0 < M ^ m := pow_pos hM0 m
    have hTop : M ^ m / 2 ≤ ((Wt.map (· ^ m)).sum).re := by
      have hterm : ∀ x ∈ Wt.map (fun w => (w ^ m).re), M ^ m / 2 ≤ x := by
        intro x hx
        obtain ⟨w, hw, rfl⟩ := Multiset.mem_map.mp hx
        have hu := hU (w / (M : ℂ)) (Multiset.mem_map_of_mem _ hw)
        have hMc : (M : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hM0.ne'
        have e2 : w ^ m = ((M ^ m : ℝ) : ℂ) * (w / (M : ℂ)) ^ m := by
          rw [div_pow, Complex.ofReal_pow]
          field_simp
        rw [e2, Complex.re_ofReal_mul]
        nlinarith
      have hcard := Multiset.card_nsmul_le_sum hterm
      rw [Multiset.card_map, nsmul_eq_mul] at hcard
      have hc1 : 0 < Multiset.card Wt :=
        Multiset.card_pos_iff_exists_mem.mpr ⟨zs, Multiset.mem_filter.mpr ⟨hzs, rfl⟩⟩
      have hc1' : (1 : ℝ) ≤ (Multiset.card Wt : ℝ) := by exact_mod_cast hc1
      rw [re_ms, Multiset.map_map]
      have hp : 0 ≤ M ^ m / 2 := by positivity
      calc M ^ m / 2 ≤ (Multiset.card Wt : ℝ) * (M ^ m / 2) := le_mul_of_one_le_left hp hc1'
        _ ≤ _ := hcard
    have hLow : -((Multiset.card Wl : ℝ) * B ^ m) ≤ ((Wl.map (· ^ m)).sum).re := by
      have hterm : ∀ x ∈ Wl.map (fun w => (w ^ m).re), -(B ^ m) ≤ x := by
        intro x hx
        obtain ⟨w, hw, rfl⟩ := Multiset.mem_map.mp hx
        have h1 := Complex.abs_re_le_norm (w ^ m)
        rw [norm_pow] at h1
        have h2 : ‖w‖ ^ m ≤ B ^ m := pow_le_pow_left₀ (norm_nonneg _) (hBl w hw) m
        have h3 := neg_abs_le (w ^ m).re
        linarith
      have hcard := Multiset.card_nsmul_le_sum hterm
      rw [Multiset.card_map, nsmul_eq_mul] at hcard
      rw [re_ms, Multiset.map_map, neg_mul_eq_mul_neg]
      exact hcard
    have hCA : C * A ^ m ≤ |C| * B ^ m := by
      have h1 : C * A ^ m ≤ |C| * A ^ m :=
        mul_le_mul_of_nonneg_right (le_abs_self C) (by positivity)
      have h2 : |C| * A ^ m ≤ |C| * B ^ m :=
        mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hA.le hAB m) (abs_nonneg C)
      linarith
    have hBρ : B ^ m = ρ ^ m * M ^ m := by
      rw [← mul_pow, hρdef, div_mul_cancel₀ B hM0.ne']
    have hρm : ρ ^ m ≤ ρ ^ m₀ := pow_le_pow_of_le_one hρ0 hρ1.le hmm₀
    have key : M ^ m ≤ 2 * K * B ^ m := by
      rw [hKdef]; nlinarith
    rw [hBρ] at key
    have h4 : 2 * K * (ρ ^ m * M ^ m) ≤ 2 * K * (ρ ^ m₀ * M ^ m) := by
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      exact mul_le_mul_of_nonneg_right hρm hMm.le
    have hρm0 : 0 ≤ ρ ^ m₀ := pow_nonneg hρ0 _
    nlinarith [mul_pos hMm (sub_pos.mpr hm₀), mul_nonneg hρm0 hMm.le]

  have s4 : ∀ (d₀ : ℕ), 1 ≤ d₀ → ∀ (x₀ : Fin (T.np d₀)) (ι : AlgebraicClosure ℚ_[ℓ] ≃+* ℂ)
      (k : ℕ), 1 ≤ k → ∃ (N : ℕ) (W : Multiset ℂ),
        (∀ m : ℕ, 1 ≤ m → ((W.map (· ^ m)).sum).re ≤
           (N : ℝ) * ((q : ℝ) ^ ((k * β + 1) * d₀)) ^ m) ∧
        ∀ γ ∈ T.loc d₀ x₀, ι γ ^ (2 * k) ∈ W := by
    intro d₀ hd₀ x₀ ι k hk
    obtain ⟨N, Hk, hT⟩ := T.tensor k hk
    obtain ⟨P, hPs, hPm⟩ := s3 ((T.loc d₀ x₀).map ι) (2 * k)
    refine ⟨N, d₀ • P + Hk.map (fun ρ => ι ρ ^ d₀), ?_, ?_⟩
    swap
    · intro γ hγ
      apply Multiset.mem_add.mpr
      left
      exact Multiset.mem_nsmul.mpr ⟨by omega, hPm _ (Multiset.mem_map_of_mem _ hγ)⟩
    intro m hm
    have hι_tr : ∀ d (x : Fin (T.np d)) (n : ℕ),
        ι (((T.loc d x).map (· ^ n)).sum) = (((T.loc d x).map ι).map (· ^ n)).sum := by
      intro d x n
      rw [map_multiset_sum, Multiset.map_map, Multiset.map_map]
      congr 1
      apply Multiset.map_congr rfl
      intro y _
      simp
    have hreal : ∀ d (x : Fin (T.np d)) (n : ℕ), ∃ t : ℝ, 0 ≤ t ∧
        ι ((d : AlgebraicClosure ℚ_[ℓ]) * ((T.loc d x).map (· ^ n)).sum ^ (2 * k)) =
          (t : ℂ) := by
      intro d x n
      obtain ⟨c, hc⟩ := T.hrat d x n
      refine ⟨d * (c : ℝ) ^ (2 * k),
        mul_nonneg (Nat.cast_nonneg _) (by rw [pow_mul]; exact pow_nonneg (sq_nonneg _) _), ?_⟩
      rw [hc, map_mul, map_pow, map_natCast, eq_ratCast (algebraMap ℚ (AlgebraicClosure ℚ_[ℓ])),
        map_ratCast]
      push_cast
      ring
    set e := d₀ * m with he
    have he1 : 1 ≤ e := by rw [he]; exact Nat.one_le_iff_ne_zero.mpr (by positivity)
    let term : (d : ℕ) → Fin (T.np d) → AlgebraicClosure ℚ_[ℓ] := fun d x =>
      (d : AlgebraicClosure ℚ_[ℓ]) * ((T.loc d x).map (· ^ (e / d))).sum ^ (2 * k)
    have hTe : (Hk.map (· ^ e)).sum = (N : AlgebraicClosure ℚ_[ℓ]) *
        (q : AlgebraicClosure ℚ_[ℓ]) ^ (e * (k * β + 1)) -
        ∑ d ∈ e.divisors, ∑ x : Fin (T.np d), term d x := by
      rw [hT e he1]; ring
    have hed : e / d₀ = m := by rw [he]; exact Nat.mul_div_cancel_left m (by omega)
    have hSW : ((d₀ • P + Hk.map (fun ρ => ι ρ ^ d₀)).map (· ^ m)).sum =
        ι (term d₀ x₀) + ι ((Hk.map (· ^ e)).sum) := by
      rw [Multiset.map_add, Multiset.sum_add, Multiset.map_nsmul, Multiset.sum_nsmul,
        nsmul_eq_mul, hPs m]
      congr 1
      · simp only [term, map_mul, map_pow, map_natCast, hed, hι_tr]
      · rw [map_multiset_sum, Multiset.map_map, Multiset.map_map]
        congr 1
        apply Multiset.map_congr rfl
        intro y _
        simp only [Function.comp_apply, map_pow, he, ← pow_mul]
    have hnn : ∀ d (x : Fin (T.np d)), 0 ≤ (ι (term d x)).re := by
      intro d x
      obtain ⟨t, ht, hte⟩ := hreal d x (e / d)
      show 0 ≤ (ι ((d : AlgebraicClosure ℚ_[ℓ]) *
        ((T.loc d x).map (· ^ (e / d))).sum ^ (2 * k))).re
      rw [hte, Complex.ofReal_re]
      exact ht
    have hsingle : (ι (term d₀ x₀)).re ≤
        ∑ d ∈ e.divisors, ∑ x : Fin (T.np d), (ι (term d x)).re := by
      have h1 : (ι (term d₀ x₀)).re ≤ ∑ x : Fin (T.np d₀), (ι (term d₀ x)).re :=
        Finset.single_le_sum (f := fun x => (ι (term d₀ x)).re) (fun x _ => hnn d₀ x)
          (Finset.mem_univ x₀)
      have h2 : ∑ x : Fin (T.np d₀), (ι (term d₀ x)).re ≤
          ∑ d ∈ e.divisors, ∑ x : Fin (T.np d), (ι (term d x)).re :=
        Finset.single_le_sum (f := fun d => ∑ x : Fin (T.np d), (ι (term d x)).re)
          (fun d _ => Finset.sum_nonneg (fun x _ => hnn d x))
          (Nat.mem_divisors.mpr ⟨Dvd.intro m he.symm, by omega⟩)
      linarith
    have hNq : (ι ((N : AlgebraicClosure ℚ_[ℓ]) *
        (q : AlgebraicClosure ℚ_[ℓ]) ^ (e * (k * β + 1)))).re =
        (N : ℝ) * ((q : ℝ) ^ ((k * β + 1) * d₀)) ^ m := by
      rw [map_mul, map_pow, map_natCast, map_natCast, ← pow_mul]
      have e3 : e * (k * β + 1) = (k * β + 1) * d₀ * m := by rw [he]; ring
      rw [e3]
      have h : ((N : ℂ) * (q : ℂ) ^ ((k * β + 1) * d₀ * m)) =
          (((N : ℝ) * (q : ℝ) ^ ((k * β + 1) * d₀ * m) : ℝ) : ℂ) := by push_cast; ring
      rw [h, Complex.ofReal_re]
    rw [hSW, hTe, map_sub, Complex.add_re, Complex.sub_re, map_sum, Complex.re_sum]
    simp only [map_sum, Complex.re_sum]
    linarith

  intro d₀ hd₀ x₀ γ hγ ι
  have hq0 : (0 : ℝ) < q := by exact_mod_cast hq
  have hY0 : (0 : ℝ) < (q : ℝ) ^ (β * d₀) := pow_pos hq0 _
  have hUp : ∀ γ' ∈ T.loc d₀ x₀, ‖ι γ'‖ ^ 2 ≤ (q : ℝ) ^ (β * d₀) := by
    intro γ' hγ'
    apply s5 (‖ι γ'‖ ^ 2) ((q : ℝ) ^ (β * d₀)) ((q : ℝ) ^ d₀) hY0
    intro k hk
    obtain ⟨N, W, hW, hmem⟩ := s4 d₀ hd₀ x₀ ι k hk
    have hA : 0 < (q : ℝ) ^ ((k * β + 1) * d₀) := pow_pos hq0 _
    have hb := s2 W _ _ hA hW _ (hmem γ' hγ')
    rw [norm_pow] at hb
    calc (‖ι γ'‖ ^ 2) ^ k = ‖ι γ'‖ ^ (2 * k) := by rw [← pow_mul]
      _ ≤ _ := hb
      _ = ((q : ℝ) ^ (β * d₀)) ^ k * (q : ℝ) ^ d₀ := by
        rw [← pow_mul, ← pow_add]; congr 1; ring
  have hup := hUp γ hγ
  have hγ0 : γ ≠ 0 := fun h => T.hzero d₀ x₀ (h ▸ hγ)
  have hmem' : (q : AlgebraicClosure ℚ_[ℓ]) ^ (β * d₀) / γ ∈ T.loc d₀ x₀ := by
    have h := Multiset.mem_map_of_mem (fun γ => (q : AlgebraicClosure ℚ_[ℓ]) ^ (β * d₀) / γ) hγ
    rwa [T.hsymp d₀ x₀] at h
  have hlow := hUp _ hmem'
  have hιγ : ι γ ≠ 0 := (map_ne_zero ι).mpr hγ0
  have hX0 : 0 < ‖ι γ‖ ^ 2 := by positivity
  rw [map_div₀, map_pow, map_natCast, norm_div, norm_pow, Complex.norm_natCast, div_pow,
    div_le_iff₀ hX0] at hlow
  apply le_antisymm hup
  have h5 : (q : ℝ) ^ (β * d₀) * (q : ℝ) ^ (β * d₀) ≤ (q : ℝ) ^ (β * d₀) * ‖ι γ‖ ^ 2 := by
    rw [← sq]; linarith
  exact le_of_mul_le_mul_left h5 hY0

theorem wc_trace_data_H1c_sum_bound (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (q β r : ℕ) (hq : 1 ≤ q)
    (T : wcPureTraceData ℓ q β r) (ι : AlgebraicClosure ℚ_[ℓ] ≃+* ℂ)
    (hpure : ∀ d : ℕ, 1 ≤ d → ∀ x : Fin (T.np d), ∀ γ ∈ T.loc d x,
      ‖ι γ‖ ^ 2 = (q : ℝ) ^ (β * d)) :
    ∀ e : ℕ, 1 ≤ e →
      ‖((T.H.map (fun z => ι z)).map (· ^ e)).sum‖ ≤ (2 * r : ℝ) * (√((q : ℝ) ^ (β + 2))) ^ e :=
by
  intro e he
  obtain ⟨s, hs⟩ : ∃ s : ℝ, s = √((q : ℝ) ^ β) := ⟨_, rfl⟩
  have hs0 : 0 ≤ s := hs ▸ Real.sqrt_nonneg _
  have hq0 : (0 : ℝ) ≤ (q : ℝ) := Nat.cast_nonneg q
  have hq1 : (1 : ℝ) ≤ (q : ℝ) := by exact_mod_cast hq

  have h1 : ((T.H.map (fun z => ι z)).map (· ^ e)).sum = ι ((T.H.map (· ^ e)).sum) := by
    rw [map_multiset_sum, Multiset.map_map, Multiset.map_map]
    congr 1
    apply Multiset.map_congr rfl
    intro z _
    simp only [Function.comp_apply, map_pow]

  have h2 : (T.H.map (· ^ e)).sum = -(∑ d ∈ e.divisors, ∑ x : Fin (T.np d),
      (d : AlgebraicClosure ℚ_[ℓ]) * ((T.loc d x).map (· ^ (e / d))).sum) := by
    rw [T.hH e he, neg_neg]

  have hterm : ∀ d ∈ e.divisors, ‖ι (∑ x : Fin (T.np d),
      (d : AlgebraicClosure ℚ_[ℓ]) * ((T.loc d x).map (· ^ (e / d))).sum)‖ ≤
      ((d * T.np d : ℕ) : ℝ) * ((r : ℝ) * s ^ e) := by
    intro d hd
    have hd1 : 1 ≤ d := Nat.pos_of_mem_divisors hd
    have hde : d * (e / d) = e := Nat.mul_div_cancel' (Nat.dvd_of_mem_divisors hd)
    have hγ : ∀ x : Fin (T.np d), ∀ γ ∈ T.loc d x, ‖ι γ‖ ^ (e / d) = s ^ e := by
      intro x γ hγ
      have hp := hpure d hd1 x γ hγ
      have e1 : (‖ι γ‖ ^ (e / d)) ^ 2 = (q : ℝ) ^ (β * e) := by
        rw [← pow_mul, mul_comm (e / d) 2, pow_mul ‖ι γ‖ 2 (e / d), hp, ← pow_mul, mul_assoc,
          hde]
      have e2 : (s ^ e) ^ 2 = (q : ℝ) ^ (β * e) := by
        rw [← pow_mul, mul_comm e 2, pow_mul s 2 e, hs, Real.sq_sqrt (by positivity), ← pow_mul]
      exact (pow_left_inj₀ (by positivity) (pow_nonneg hs0 _) two_ne_zero).mp (e1.trans e2.symm)
    have hx : ∀ x : Fin (T.np d), ‖ι ((d : AlgebraicClosure ℚ_[ℓ]) *
        ((T.loc d x).map (· ^ (e / d))).sum)‖ ≤ (d : ℝ) * ((r : ℝ) * s ^ e) := by
      intro x
      rw [map_mul, map_natCast, map_multiset_sum, Multiset.map_map, norm_mul,
        Complex.norm_natCast]
      apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg d)
      refine (norm_multiset_sum_le _).trans (le_of_eq ?_)
      rw [Multiset.map_map, Multiset.map_congr rfl (g := fun _ => s ^ e), Multiset.map_const',
        Multiset.sum_replicate, T.hcard d x, nsmul_eq_mul]
      intro γ hγ'
      simp only [Function.comp_apply, map_pow, norm_pow]
      exact hγ x γ hγ'
    rw [map_sum]
    refine (norm_sum_le _ _).trans ?_
    refine (Finset.sum_le_sum (fun x _ => hx x)).trans (le_of_eq ?_)
    rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
    push_cast
    ring
  rw [h1, h2, map_neg, norm_neg, map_sum]
  refine (norm_sum_le _ _).trans ?_
  refine (Finset.sum_le_sum hterm).trans ?_
  rw [← Finset.sum_mul]

  have hnp : (∑ d ∈ e.divisors, ((d * T.np d : ℕ) : ℝ)) ≤ (q : ℝ) ^ e + 1 := by
    have := T.hnp e he
    exact_mod_cast this
  have hqe : (1 : ℝ) ≤ (q : ℝ) ^ e := one_le_pow₀ hq1

  have hsq : √((q : ℝ) ^ (β + 2)) = s * q := by
    rw [hs, pow_add, Real.sqrt_mul (by positivity), Real.sqrt_sq hq0]
  rw [hsq, mul_pow]
  have hrs : 0 ≤ (r : ℝ) * s ^ e := mul_nonneg (Nat.cast_nonneg _) (pow_nonneg hs0 _)
  calc (∑ d ∈ e.divisors, ((d * T.np d : ℕ) : ℝ)) * ((r : ℝ) * s ^ e)
      ≤ ((q : ℝ) ^ e + 1) * ((r : ℝ) * s ^ e) := mul_le_mul_of_nonneg_right hnp hrs
    _ ≤ (2 * (q : ℝ) ^ e) * ((r : ℝ) * s ^ e) := mul_le_mul_of_nonneg_right (by linarith) hrs
    _ = (2 * r : ℝ) * (s ^ e * (q : ℝ) ^ e) := by ring

theorem wc_ext_ses_findim {C : Type*} [Category C] [Abelian C] [HasExt C]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (X : C) (S : ShortComplex C) (hS : S.ShortExact)
    (α : ℚ_[ℓ] → (S.X₁ ⟶ S.X₁)) (β : ℚ_[ℓ] → (S.X₂ ⟶ S.X₂)) (γ : ℚ_[ℓ] → (S.X₃ ⟶ S.X₃))
    (hα1 : α 1 = 𝟙 _) (hαm : ∀ a b, α (a * b) = α b ≫ α a) (hαa : ∀ a b, α (a + b) = α a + α b)
    (hβ1 : β 1 = 𝟙 _) (hβm : ∀ a b, β (a * b) = β b ≫ β a) (hβa : ∀ a b, β (a + b) = β a + β b)
    (hγ1 : γ 1 = 𝟙 _) (hγm : ∀ a b, γ (a * b) = γ b ≫ γ a) (hγa : ∀ a b, γ (a + b) = γ a + γ b)
    (hf : ∀ c, α c ≫ S.f = S.f ≫ β c) (hg : ∀ c, β c ≫ S.g = S.g ≫ γ c)
    (n₀ n₁ : ℕ) (hn : n₀ + 1 = n₁) :
    ((∃ (r : ℕ) (e : Abelian.Ext X S.X₃ n₀ ≃+ (Fin r → ℚ_[ℓ])),
        ∀ (c : ℚ_[ℓ]) (x : Abelian.Ext X S.X₃ n₀),
          e (x.comp (Abelian.Ext.mk₀ (γ c)) (add_zero n₀)) = c • e x) →
      (∃ (r : ℕ) (e : Abelian.Ext X S.X₂ n₁ ≃+ (Fin r → ℚ_[ℓ])),
        ∀ (c : ℚ_[ℓ]) (x : Abelian.Ext X S.X₂ n₁),
          e (x.comp (Abelian.Ext.mk₀ (β c)) (add_zero n₁)) = c • e x) →
      ∃ (r : ℕ) (e : Abelian.Ext X S.X₁ n₁ ≃+ (Fin r → ℚ_[ℓ])),
        ∀ (c : ℚ_[ℓ]) (x : Abelian.Ext X S.X₁ n₁),
          e (x.comp (Abelian.Ext.mk₀ (α c)) (add_zero n₁)) = c • e x) ∧
    ((∃ (r : ℕ) (e : Abelian.Ext X S.X₂ n₀ ≃+ (Fin r → ℚ_[ℓ])),
        ∀ (c : ℚ_[ℓ]) (x : Abelian.Ext X S.X₂ n₀),
          e (x.comp (Abelian.Ext.mk₀ (β c)) (add_zero n₀)) = c • e x) →
      (∃ (r : ℕ) (e : Abelian.Ext X S.X₁ n₁ ≃+ (Fin r → ℚ_[ℓ])),
        ∀ (c : ℚ_[ℓ]) (x : Abelian.Ext X S.X₁ n₁),
          e (x.comp (Abelian.Ext.mk₀ (α c)) (add_zero n₁)) = c • e x) →
      ∃ (r : ℕ) (e : Abelian.Ext X S.X₃ n₀ ≃+ (Fin r → ℚ_[ℓ])),
        ∀ (c : ℚ_[ℓ]) (x : Abelian.Ext X S.X₃ n₀),
          e (x.comp (Abelian.Ext.mk₀ (γ c)) (add_zero n₀)) = c • e x) :=
by

  have coord : ∀ {A B D : Type _} [AddCommGroup A] [AddCommGroup B] [AddCommGroup D]
      (sA : ℚ_[ℓ] → A →+ A) (sB : ℚ_[ℓ] → B →+ B) (sC : ℚ_[ℓ] → D →+ D)
      (hB1 : ∀ x : B, sB 1 x = x)
      (hBm : ∀ (a b : ℚ_[ℓ]) (x : B), sB (a * b) x = sB a (sB b x))
      (hBa : ∀ (a b : ℚ_[ℓ]) (x : B), sB (a + b) x = sB a x + sB b x)
      (f : A →+ B) (g : B →+ D)
      (hf : ∀ (c : ℚ_[ℓ]) (x : A), f (sA c x) = sB c (f x))
      (hg : ∀ (c : ℚ_[ℓ]) (y : B), g (sB c y) = sC c (g y))
      (hex : ∀ y : B, g y = 0 → ∃ x : A, f x = y)
      (rA : ℕ) (eA : A ≃+ (Fin rA → ℚ_[ℓ])) (heA : ∀ (c : ℚ_[ℓ]) (x : A), eA (sA c x) = c • eA x)
      (rC : ℕ) (eC : D ≃+ (Fin rC → ℚ_[ℓ])) (heC : ∀ (c : ℚ_[ℓ]) (z : D), eC (sC c z) = c • eC z),
      ∃ (r : ℕ) (e : B ≃+ (Fin r → ℚ_[ℓ])), ∀ (c : ℚ_[ℓ]) (y : B), e (sB c y) = c • e y := by
    intro A B D _ _ _ sA sB sC hB1 hBm hBa f g hf hg hex rA eA heA rC eC heC
    letI : SMul ℚ_[ℓ] B := ⟨fun c y => sB c y⟩
    letI : Module ℚ_[ℓ] B := Module.ofMinimalAxioms (fun r x y => map_add (sB r) x y)
      (fun r s x => hBa r s x) (fun r s x => hBm r s x) (fun x => hB1 x)
    have hes : ∀ (c : ℚ_[ℓ]) (v : Fin rA → ℚ_[ℓ]), eA.symm (c • v) = sA c (eA.symm v) :=
      fun c v => eA.injective (by rw [heA, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
    let ψ : (Fin rA → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] B :=
      { toFun := fun v => f (eA.symm v)
        map_add' := fun v w => by simp only [map_add]
        map_smul' := fun c v => by
          simp only [RingHom.id_apply]
          rw [hes, hf]
          rfl }
    let φ : B →ₗ[ℚ_[ℓ]] (Fin rC → ℚ_[ℓ]) :=
      { toFun := fun y => eC (g y)
        map_add' := fun v w => by simp only [map_add]
        map_smul' := fun c y => by
          simp only [RingHom.id_apply]
          show eC (g (sB c y)) = _
          rw [hg, heC] }
    have hker : ⊤ ⊓ LinearMap.ker φ ≤ LinearMap.range ψ := by
      intro y hy
      have hy' : eC (g y) = 0 := (Submodule.mem_inf.mp hy).2
      have hgy : g y = 0 := eC.injective (hy'.trans (map_zero eC).symm)
      obtain ⟨x, hx⟩ := hex y hgy
      exact ⟨eA x, by show f (eA.symm (eA x)) = y; rw [AddEquiv.symm_apply_apply, hx]⟩
    have h1 : (Submodule.map φ ⊤).FG := IsNoetherian.noetherian _
    have h2 : (⊤ ⊓ LinearMap.ker φ).FG := by
      haveI := Submodule.finiteDimensional_of_le hker
      exact (Submodule.fg_iff_finiteDimensional _).mpr this
    have htop : (⊤ : Submodule ℚ_[ℓ] B).FG := Submodule.fg_of_fg_map_of_fg_inf_ker φ h1 h2
    haveI : Module.Finite ℚ_[ℓ] B := ⟨htop⟩
    let b := Module.finBasis ℚ_[ℓ] B
    refine ⟨Module.finrank ℚ_[ℓ] B, b.equivFun.toAddEquiv, fun c y => ?_⟩
    show b.equivFun (c • y) = c • b.equivFun y
    exact b.equivFun.map_smul c y

  have cc : ∀ {Y Z W : C} (k : ℕ) (x : Abelian.Ext X Y k) (u : Y ⟶ Z) (v : Z ⟶ W),
      (x.comp (Abelian.Ext.mk₀ u) (add_zero k)).comp (Abelian.Ext.mk₀ v) (add_zero k) =
        x.comp (Abelian.Ext.mk₀ (u ≫ v)) (add_zero k) := by
    intro Y Z W k x u v
    rw [← Abelian.Ext.mk₀_comp_mk₀]
    exact Abelian.Ext.comp_assoc _ _ _ (add_zero k) (add_zero 0) (by omega)
  have act1 : ∀ {Y : C} (l : ℚ_[ℓ] → (Y ⟶ Y)), l 1 = 𝟙 _ → ∀ (k : ℕ) (x : Abelian.Ext X Y k),
      (Abelian.Ext.mk₀ (l 1)).postcomp X (add_zero k) x = x := by
    intro Y l hl k x
    show x.comp (Abelian.Ext.mk₀ (l 1)) (add_zero k) = x
    rw [hl]
    exact Abelian.Ext.comp_mk₀_id x
  have actm : ∀ {Y : C} (l : ℚ_[ℓ] → (Y ⟶ Y)), (∀ a b, l (a * b) = l b ≫ l a) →
      ∀ (k : ℕ) (a b : ℚ_[ℓ]) (x : Abelian.Ext X Y k),
      (Abelian.Ext.mk₀ (l (a * b))).postcomp X (add_zero k) x =
        (Abelian.Ext.mk₀ (l a)).postcomp X (add_zero k)
          ((Abelian.Ext.mk₀ (l b)).postcomp X (add_zero k) x) := by
    intro Y l hl k a b x
    show x.comp (Abelian.Ext.mk₀ (l (a * b))) (add_zero k) =
      (x.comp (Abelian.Ext.mk₀ (l b)) (add_zero k)).comp (Abelian.Ext.mk₀ (l a)) (add_zero k)
    rw [hl, cc]
  have acta : ∀ {Y : C} (l : ℚ_[ℓ] → (Y ⟶ Y)), (∀ a b, l (a + b) = l a + l b) →
      ∀ (k : ℕ) (a b : ℚ_[ℓ]) (x : Abelian.Ext X Y k),
      (Abelian.Ext.mk₀ (l (a + b))).postcomp X (add_zero k) x =
        (Abelian.Ext.mk₀ (l a)).postcomp X (add_zero k) x +
          (Abelian.Ext.mk₀ (l b)).postcomp X (add_zero k) x := by
    intro Y l hl k a b x
    show x.comp (Abelian.Ext.mk₀ (l (a + b))) (add_zero k) =
      x.comp (Abelian.Ext.mk₀ (l a)) (add_zero k) + x.comp (Abelian.Ext.mk₀ (l b)) (add_zero k)
    rw [hl, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add]

  have delta : ∀ (c : ℚ_[ℓ]) (x : Abelian.Ext X S.X₃ n₀),
      (x.comp (Abelian.Ext.mk₀ (γ c)) (add_zero n₀)).comp hS.extClass hn =
        (x.comp hS.extClass hn).comp (Abelian.Ext.mk₀ (α c)) (add_zero n₁) := by
    intro c x
    have hnat : hS.extClass.comp (Abelian.Ext.mk₀ (α c)) (add_zero 1) =
        (Abelian.Ext.mk₀ (γ c)).comp hS.extClass (zero_add 1) :=
      ShortComplex.ShortExact.extClass_naturality hS hS (ShortComplex.homMk (α c) (β c) (γ c) (hf c) (hg c))
    rw [Abelian.Ext.comp_assoc x (Abelian.Ext.mk₀ (γ c)) hS.extClass (add_zero n₀) (zero_add 1)
        (by omega),
      Abelian.Ext.comp_assoc x hS.extClass (Abelian.Ext.mk₀ (α c)) hn (add_zero 1) (by omega), hnat]
  refine ⟨?_, ?_⟩
  · rintro ⟨r₃, e₃, he₃⟩ ⟨r₂, e₂, he₂⟩
    obtain ⟨r, e, he⟩ := coord
      (fun c => (Abelian.Ext.mk₀ (γ c)).postcomp X (add_zero n₀))
      (fun c => (Abelian.Ext.mk₀ (α c)).postcomp X (add_zero n₁))
      (fun c => (Abelian.Ext.mk₀ (β c)).postcomp X (add_zero n₁))
      (act1 α hα1 n₁) (actm α hαm n₁) (acta α hαa n₁)
      (hS.extClass.postcomp X hn) ((Abelian.Ext.mk₀ S.f).postcomp X (add_zero n₁))
      (fun c x => delta c x)
      (fun c y => by
        show (y.comp (Abelian.Ext.mk₀ (α c)) (add_zero n₁)).comp (Abelian.Ext.mk₀ S.f) (add_zero n₁) =
          (y.comp (Abelian.Ext.mk₀ S.f) (add_zero n₁)).comp (Abelian.Ext.mk₀ (β c)) (add_zero n₁)
        rw [cc, cc, hf])
      (fun y hy => Abelian.Ext.covariant_sequence_exact₁ X hS y hy hn)
      r₃ e₃ (fun c x => he₃ c x) r₂ e₂ (fun c x => he₂ c x)
    exact ⟨r, e, fun c x => he c x⟩
  · rintro ⟨r₂, e₂, he₂⟩ ⟨r₁, e₁, he₁⟩
    obtain ⟨r, e, he⟩ := coord
      (fun c => (Abelian.Ext.mk₀ (β c)).postcomp X (add_zero n₀))
      (fun c => (Abelian.Ext.mk₀ (γ c)).postcomp X (add_zero n₀))
      (fun c => (Abelian.Ext.mk₀ (α c)).postcomp X (add_zero n₁))
      (act1 γ hγ1 n₀) (actm γ hγm n₀) (acta γ hγa n₀)
      ((Abelian.Ext.mk₀ S.g).postcomp X (add_zero n₀)) (hS.extClass.postcomp X hn)
      (fun c y => by
        show (y.comp (Abelian.Ext.mk₀ (β c)) (add_zero n₀)).comp (Abelian.Ext.mk₀ S.g) (add_zero n₀) =
          (y.comp (Abelian.Ext.mk₀ S.g) (add_zero n₀)).comp (Abelian.Ext.mk₀ (γ c)) (add_zero n₀)
        rw [cc, cc, hg])
      (fun c x => delta c x)
      (fun y hy => Abelian.Ext.covariant_sequence_exact₃ X hS y hn hy)
      r₂ e₂ (fun c x => he₂ c x) r₁ e₁ (fun c x => he₁ c x)
    exact ⟨r, e, fun c x => he c x⟩

theorem wc_proet_free_slice_ext_natural : ∀ (S : Scheme.{u}) (U : S.ProEt) (n : ℕ),
    letI : HasExt (Sheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}) := HasExt.standard _
    ∃ T : ∀ Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
        Abelian.Ext (wcFreeSheaf S U) Y n ≃+
          Abelian.Ext ((presheafToSheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}).obj
              (yoneda.obj (Over.mk (𝟙 U)) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
            (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj Y) n,
      ∀ (Y Y' : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (f : Y ⟶ Y')
        (x : Abelian.Ext (wcFreeSheaf S U) Y n),
        T Y' (x.comp (Abelian.Ext.mk₀ f) (add_zero n)) =
          (T Y x).comp (Abelian.Ext.mk₀
            (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).map f)) (add_zero n) :=
by

  have wc_over_costructuredArrow_final : ∀ (S : Scheme.{u}) (U W : S.ProEt),
      ∃ (I : Type u)
        (D : Discrete I ⥤ CostructuredArrow (Over.forget U).op (Opposite.op W)),
        D.Final := by
    intro S U W
    obtain ⟨D, hD⟩ : ∃ D : Discrete (W ⟶ U) ⥤
        CostructuredArrow (Over.forget U).op (Opposite.op W),
        ∀ f, D.obj ⟨f⟩ = CostructuredArrow.mk (Y := Opposite.op (Over.mk f)) (𝟙 W).op :=
      ⟨Discrete.functor (fun f => CostructuredArrow.mk (Y := Opposite.op (Over.mk f)) (𝟙 W).op),
        fun f => rfl⟩
    have key : ∀ (c : CostructuredArrow (Over.forget U).op (Opposite.op W)) (f : W ⟶ U)
        (k : c.left ⟶ Opposite.op (Over.mk f))
        (hk : (Over.forget U).op.map k ≫ (𝟙 W).op = c.hom),
        (Quiver.Hom.unop k).left = Quiver.Hom.unop c.hom ∧
          f = Quiver.Hom.unop c.hom ≫ c.left.unop.hom := by
      intro c f k hk
      have h0 : 𝟙 W ≫ (Quiver.Hom.unop k).left = Quiver.Hom.unop c.hom :=
        congrArg Quiver.Hom.unop hk
      have h1 : (Quiver.Hom.unop k).left = Quiver.Hom.unop c.hom :=
        (Category.id_comp _).symm.trans h0
      refine ⟨h1, ?_⟩
      have hw : (Quiver.Hom.unop k).left ≫ c.left.unop.hom = (Over.mk f).hom :=
        Over.w (Quiver.Hom.unop k)
      exact hw.symm.trans (congrArg (· ≫ c.left.unop.hom) h1)
    refine ⟨W ⟶ U, D, Functor.Final.mk (fun c => ?_)⟩
    have hext : ∀ (f : W ⟶ U) (h h' : c ⟶ D.obj ⟨f⟩), h = h' := by
      intro f h h'
      refine (cancel_mono (eqToHom (hD f))).1 ?_
      apply CostructuredArrow.hom_ext
      apply Quiver.Hom.unop_inj
      apply Over.OverMorphism.ext
      exact (key c f (h ≫ eqToHom (hD f)).left (CostructuredArrow.w _)).1.trans
        (key c f (h' ≫ eqToHom (hD f)).left (CostructuredArrow.w _)).1.symm
    obtain ⟨fc, hfc⟩ : ∃ fc : W ⟶ U, fc = Quiver.Hom.unop c.hom ≫ c.left.unop.hom :=
      ⟨_, rfl⟩
    obtain ⟨κc, hκc⟩ : ∃ κc : Over.mk fc ⟶ c.left.unop,
        κc.left = Quiver.Hom.unop c.hom :=
      ⟨Over.homMk (Quiver.Hom.unop c.hom) hfc.symm, rfl⟩
    have hw : (Over.forget U).op.map κc.op ≫ (𝟙 W).op = c.hom := by
      apply Quiver.Hom.unop_inj
      exact (Category.id_comp _).trans hκc
    let φc : c ⟶ D.obj ⟨fc⟩ :=
      CostructuredArrow.homMk (f := c)
        (f' := CostructuredArrow.mk (Y := Opposite.op (Over.mk fc)) (𝟙 W).op)
        κc.op hw ≫ eqToHom (hD fc).symm
    have hto : ∀ s : StructuredArrow c D, s.right.as = fc := fun s =>
      (key c s.right.as (s.hom ≫ eqToHom (hD s.right.as)).left
        (CostructuredArrow.w _)).2.trans hfc.symm
    let tc : StructuredArrow c D := StructuredArrow.mk (Y := ⟨fc⟩) φc
    exact isConnected_of_isTerminal _ (Limits.IsTerminal.ofUniqueHom (X := tc)
      (fun s => StructuredArrow.homMk (Discrete.eqToHom (hto s)) (hext _ _ _))
      (fun s m => StructuredArrow.ext _ _ (Subsingleton.elim _ _)))

  have wc_lan_eval_iso : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (L : C ⥤ D)
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F] (Y : D),
      Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
          (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim) := by
    intro C D _ _ L _ _ Y
    refine ⟨NatIso.ofComponents (fun F => L.leftKanExtensionObjIsoColimit F Y) ?_⟩
    intro F₁ F₂ φ
    have hnat : ∀ j : CostructuredArrow L Y,
        (L.leftKanExtension F₁).map j.hom ≫ (L.lan.map φ).app Y =
        (L.lan.map φ).app (L.obj j.left) ≫ (L.leftKanExtension F₂).map j.hom :=
      fun j => (L.lan.map φ).naturality j.hom
    have hfac : ∀ j : CostructuredArrow L Y,
        (L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left) =
        φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left := fun j =>
      Functor.descOfIsLeftKanExtension_fac_app (L.leftKanExtension F₁)
        (L.leftKanExtensionUnit F₁) (L.leftKanExtension F₂) (φ ≫ L.leftKanExtensionUnit F₂) j.left
    refine (Iso.inv_comp_eq _).1 ?_
    apply Limits.colimit.hom_ext
    intro j
    have key : (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
        (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom =
        φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
      calc (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
            (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom
          = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.leftKanExtension F₁).map j.hom ≫
            (L.lan.map φ).app Y) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _).symm
        _ = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.lan.map φ).app (L.obj j.left) ≫
            (L.leftKanExtension F₂).map j.hom) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg (fun k => (L.leftKanExtensionUnit F₁).app j.left ≫ k ≫
              (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hnat j)
        _ = ((L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left)) ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            (congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _)).trans
              (Category.assoc _ _ _).symm
        _ = (φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left) ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg (· ≫ (L.leftKanExtension F₂).map j.hom ≫
              (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hfac j)
        _ = φ.app j.left ≫ ((L.leftKanExtensionUnit F₂).app j.left ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom) :=
            Category.assoc _ _ _
        _ = φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
            congrArg (φ.app j.left ≫ ·) (Functor.ι_leftKanExtensionObjIsoColimit_hom L F₂ Y j)
    erw [Functor.ι_leftKanExtensionObjIsoColimit_inv_assoc, Limits.ι_colimMap]
    exact key

  have wc_lan_preservesFiniteLimits_of_discrete_final : ∀ {C D : Type (u+1)} [Category.{u} C]
      [Category.{u} D] (L : C ⥤ D)
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F],
      (∀ Y : D, Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
          (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim)) →
      (∀ Y : D, ∃ (I : Type u) (G : Discrete I ⥤ CostructuredArrow L Y), G.Final) →
      Limits.PreservesFiniteLimits
        (L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) := by
    intro C D _ _ L _ _ hiso hfin
    constructor
    intro J _ _
    apply Limits.preservesLimitsOfShape_of_evaluation
    intro Y
    obtain ⟨θ⟩ := hiso Y
    obtain ⟨I, G, hG⟩ := hfin Y
    haveI : HasExactColimitsOfShape (Discrete I) AddCommGrpCat.{u+1} :=
      HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1}
        (Discrete.equivalence (Equiv.ulift : ULift.{u+1} I ≃ I))
    let e2 : (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
        ((Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj G ⋙ Limits.colim) ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim :=
      Functor.isoWhiskerLeft _ (Functor.Final.colimIso G)
    exact Limits.preservesLimitsOfShape_of_natIso (e2 ≪≫ θ.symm)

  have wc_leftAdjoint_freeYoneda_iso : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D]
      (J : GrothendieckTopology C) (K : GrothendieckTopology D)
      [HasWeakSheafify J AddCommGrpCat.{u+1}] [HasWeakSheafify K AddCommGrpCat.{u+1}]
      (Φ : C ⥤ D) [Φ.IsContinuous J K]
      (L : Sheaf J AddCommGrpCat.{u+1} ⥤ Sheaf K AddCommGrpCat.{u+1})
      (adj : L ⊣ Φ.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K) (X : C),
      Nonempty (L.obj ((presheafToSheaf J AddCommGrpCat.{u+1}).obj
          (yoneda.obj X ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≅
        (presheafToSheaf K AddCommGrpCat.{u+1}).obj
          (yoneda.obj (Φ.obj X) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) := by
    intro C D _ _ J K _ _ Φ _ L adj X
    have rep : ∀ {E : Type (u+1)} [Category.{u} E] (J' : GrothendieckTopology E)
        [HasWeakSheafify J' AddCommGrpCat.{u+1}] (Y : E),
        (sheafToPresheaf J' AddCommGrpCat.{u+1} ⋙ (evaluation Eᵒᵖ AddCommGrpCat.{u+1}).obj
          (Opposite.op Y) ⋙ forget AddCommGrpCat.{u+1}).CorepresentableBy
          ((presheafToSheaf J' AddCommGrpCat.{u+1}).obj
            (yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) := by
      intro E _ J' _ Y
      exact
        { homEquiv := fun {G} =>
            ((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv _ G).trans
              (((Adjunction.whiskerRight Eᵒᵖ AddCommGrpCat.adj).homEquiv
                (yoneda.obj Y ⋙ uliftFunctor.{u+1, u}) _).trans uliftYonedaEquiv)
          homEquiv_comp := fun {G G'} f g => by
            simp only [Equiv.trans_apply, Adjunction.homEquiv_naturality_right]
            rfl }
    have r1 := rep J X
    have r2 := rep K (Φ.obj X)
    let r3 : (sheafToPresheaf K AddCommGrpCat.{u+1} ⋙ (evaluation Dᵒᵖ AddCommGrpCat.{u+1}).obj
          (Opposite.op (Φ.obj X)) ⋙ forget AddCommGrpCat.{u+1}).CorepresentableBy
          (L.obj ((presheafToSheaf J AddCommGrpCat.{u+1}).obj
            (yoneda.obj X ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) :=
      { homEquiv := fun {G} => (adj.homEquiv _ G).trans r1.homEquiv
        homEquiv_comp := fun {G G'} f g => by
          show r1.homEquiv (adj.homEquiv _ G' (g ≫ f)) = _
          rw [Adjunction.homEquiv_naturality_right, r1.homEquiv_comp]
          rfl }
    exact ⟨r3.uniqueUpToIso r2⟩
  intro S U n
  letI : HasExt (Sheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}) := HasExt.standard _

  haveI hlan : Limits.PreservesFiniteLimits ((Over.forget U).op.lan :
      ((Over U)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) ⥤ ((S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})) :=
    wc_lan_preservesFiniteLimits_of_discrete_final (Over.forget U).op
      (fun V => wc_lan_eval_iso (Over.forget U).op V)
      (fun V => wc_over_costructuredArrow_final S U V.unop)

  let G := (Over.forget U).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        ((Scheme.ProEt.topology S).over U) (Scheme.ProEt.topology S)
  let F := (Over.forget U).sheafPullback AddCommGrpCat.{u+1}
        ((Scheme.ProEt.topology S).over U) (Scheme.ProEt.topology S)
  let adj : F ⊣ G := (Over.forget U).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
        ((Scheme.ProEt.topology S).over U) (Scheme.ProEt.topology S)
  let adj2 := (Over.forget U).sheafAdjunctionCocontinuous AddCommGrpCat.{u+1}
        ((Scheme.ProEt.topology S).over U) (Scheme.ProEt.topology S)
  haveI : Limits.PreservesColimitsOfSize.{0, 0} F := adj.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits F :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits F
  haveI : Limits.PreservesColimitsOfSize.{0, 0} G := adj2.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits G :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits G
  haveI : G.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isRightAdjoint G
  haveI : G.Additive := Functor.additive_of_preserves_binary_products G
  haveI : F.Additive := adj.left_adjoint_additive
  let Z := (presheafToSheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}).obj
    (yoneda.obj (Over.mk (𝟙 U)) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)

  obtain ⟨e⟩ := wc_leftAdjoint_freeYoneda_iso ((Scheme.ProEt.topology S).over U)
    (Scheme.ProEt.topology S) (Over.forget U) F adj (Over.mk (𝟙 U))
  let e' : F.obj Z ≅ wcFreeSheaf S U := e

  let E₀ : ∀ Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
      Abelian.Ext (wcFreeSheaf S U) Y n ≃+ Abelian.Ext (F.obj Z) Y n := fun Y =>
    { toFun := fun x => (Abelian.Ext.mk₀ e'.hom).comp x (zero_add n)
      invFun := fun y => (Abelian.Ext.mk₀ e'.inv).comp y (zero_add n)
      left_inv := fun x => by
        simp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add n) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
      right_inv := fun y => by
        simp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add n) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
      map_add' := fun x y => Abelian.Ext.comp_add _ x y (zero_add n) }

  have hnat2 : ∀ {A : Sheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}}
      {B B' : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (k : B ⟶ B')
      (x : Abelian.Ext (F.obj A) B n),
      adj.extEquiv (x.comp (Abelian.Ext.mk₀ k) (add_zero n)) =
        (adj.extEquiv x).comp (Abelian.Ext.mk₀ (G.map k)) (add_zero n) := by
    intro A B B' k x
    rw [Adjunction.extEquiv_apply, Adjunction.extEquiv_apply, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc _ _ _ (zero_add n) (add_zero n) (by omega)]

  refine ⟨fun Y => (E₀ Y).trans (adj.extEquiv (X := Z) (Y := Y) (n := n)), ?_⟩
  intro Y Y' f x
  show adj.extEquiv ((Abelian.Ext.mk₀ e'.hom).comp (x.comp (Abelian.Ext.mk₀ f) (add_zero n))
      (zero_add n)) =
    (adj.extEquiv ((Abelian.Ext.mk₀ e'.hom).comp x (zero_add n))).comp
      (Abelian.Ext.mk₀ (G.map f)) (add_zero n)
  have e1 := Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ e'.hom) x (Abelian.Ext.mk₀ f)
    (zero_add n) (add_zero n) (show 0 + n + 0 = n by omega)
  exact (congrArg adj.extEquiv e1.symm).trans
    (hnat2 f ((Abelian.Ext.mk₀ e'.hom).comp x (zero_add n)))

theorem wc_P1_geometricallyIrreducible : ∀ (K : Type u) [Field K],
    GeometricallyIrreducible (wcP1Over K).hom :=
by
  intro K _
  have hAffGI : ∀ (F : Type u) [Field F] (σ : Type u),
      GeometricallyIrreducible (AffineSpace σ (Spec (.of F)) ↘ Spec (.of F)) := by
    intro F _ σ
    constructor
    intro K' _ y Z fst snd h
    let e2 : Z ≅ Spec (.of (MvPolynomial σ (CommRingCat.of K'))) :=
      h.isoIsPullback _ _ (AffineSpace.isPullback_map (n := σ) y) ≪≫
        AffineSpace.SpecIso σ (.of K')
    exact Function.Surjective.irreducibleSpace (Scheme.homeoOfIso e2.symm).continuous
      (Scheme.homeoOfIso e2.symm).surjective
  show GeometricallyIrreducible (wcProjKStr K 1)
  obtain ⟨pt, -, hpt⟩ := wc_pp_rational_point K 1
  refine wc_pp_geomIrred_of_charts (wcProjKStr K 1)
    (fun a : Fin (1 + 1) => @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) MvPolynomial.gradedAlgebra
      (MvPolynomial.X a)) 0 (wc_pp_basicOpen_cover K 1) ?_ ?_
  · intro a
    obtain ⟨e, he⟩ := wc_pp_dehomogenize_ringEquiv K 1 a
    obtain ⟨φ, hφ⟩ := wc_pp_chart_iso K 1 a e he
    exact ⟨_, _, hAffGI K (ULift.{u} (Fin 1)), φ, hφ⟩
  · have hmem : ∀ a : Fin (1 + 1), pt (IsLocalRing.closedPoint K) ∈
        @Proj.basicOpen _ _ _ _ _
          (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) MvPolynomial.gradedAlgebra
          (MvPolynomial.X a) := by
      intro a
      have h1 : IsLocalRing.closedPoint K ∈ pt ⁻¹ᵁ (@Proj.basicOpen _ _ _ _ _
          (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) MvPolynomial.gradedAlgebra
          (MvPolynomial.X a)) := by
        rw [hpt a]; trivial
      exact h1
    intro a
    exact ⟨pt (IsLocalRing.closedPoint K), hmem a, hmem 0⟩

theorem wc_contSheaf_finpi_ext_findim : ∀ (S : Scheme.{u})
    (P : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (n : ℕ),
    (∃ (r : ℕ) (e : Abelian.Ext P (wcLadicSheaf S ℓ) n ≃+ (Fin r → ℚ_[ℓ])),
      ∀ (c : ℚ_[ℓ]) (x : Abelian.Ext P (wcLadicSheaf S ℓ) n),
        e (x.comp (Abelian.Ext.mk₀ (wcLadicScalar S ℓ c)) (add_zero n)) = c • e x) →
    ∀ b : ℕ, ∃ (r : ℕ) (e : Abelian.Ext P (wcContSheaf S (Fin b → ℚ_[ℓ])) n ≃+ (Fin r → ℚ_[ℓ])),
      ∀ (c : ℚ_[ℓ]) (x : Abelian.Ext P (wcContSheaf S (Fin b → ℚ_[ℓ])) n),
        e (x.comp (Abelian.Ext.mk₀ (wcConstScalar S ℓ b c)) (add_zero n)) = c • e x :=
by
  intro S P ℓ _ n h b
  obtain ⟨r, e, he⟩ := h

  have key : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]
      (φ : A →+ B) (hφ : Continuous φ) (U : (S.ProEt)ᵒᵖ)
      (x : ((wcContSheaf S A).obj.obj U : Type (u+1))),
      (wcContSheafMap S φ hφ).hom.app U x =
        (ULift.up (AddMonoidHom.compLeftContinuous
          (↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U))) φ hφ
          (ULift.down x : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), A))) : _) := by
    intro A B _ _ _ _ _ _ φ hφ U x
    rfl
  have hcongr : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]
      (f g : A →+ B) (hf : Continuous ⇑f) (hg : Continuous ⇑g), f = g →
      wcContSheafMap S f hf = wcContSheafMap S g hg := by
    intro A B _ _ _ _ _ _ f g hf hg h
    subst h
    rfl
  have hcomp : ∀ {A B C : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]
      [AddCommGroup C] [TopologicalSpace C] [IsTopologicalAddGroup C]
      (φ : A →+ B) (hφ : Continuous ⇑φ) (ψ : B →+ C) (hψ : Continuous ⇑ψ)
      (h : Continuous ⇑(ψ.comp φ)),
      wcContSheafMap S (ψ.comp φ) h = wcContSheafMap S φ hφ ≫ wcContSheafMap S ψ hψ := by
    intro A B C _ _ _ _ _ _ _ _ _ φ hφ ψ hψ h
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext V
    apply AddCommGrpCat.ext
    intro x
    rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply,
      key, key, key]
    rfl
  have hid : ∀ {A : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      (h : Continuous ⇑(AddMonoidHom.id A)),
      wcContSheafMap S (AddMonoidHom.id A) h = 𝟙 (wcContSheaf S A) := by
    intro A _ _ _ h
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext V
    apply AddCommGrpCat.ext
    intro x
    rw [key]
    rfl
  have hadd : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]
      (φ ψ : A →+ B) (hφ : Continuous ⇑φ) (hψ : Continuous ⇑ψ) (h : Continuous ⇑(φ + ψ)),
      wcContSheafMap S (φ + ψ) h = wcContSheafMap S φ hφ + wcContSheafMap S ψ hψ := by
    intro A B _ _ _ _ _ _ φ ψ hφ hψ h
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext V
    apply AddCommGrpCat.ext
    intro x
    rw [Sheaf.Hom.add_app, AddCommGrpCat.hom_add_apply, key, key, key]
    apply ULift.ext
    apply ContinuousMap.ext
    intro a
    rfl
  have hzero : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]
      (h : Continuous ⇑(0 : A →+ B)), wcContSheafMap S (0 : A →+ B) h = 0 := by
    intro A B _ _ _ _ _ _ h
    have h2 : Continuous ⇑((0 : A →+ B) + 0) := by rw [add_zero]; exact h
    have e := hadd 0 0 h h h2
    rw [hcongr _ _ h2 h (add_zero 0)] at e
    exact add_left_cancel (e.symm.trans (add_zero _).symm)
  have hsum : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]
      {ι : Type} (f : ι → (A →+ B)) (hf : ∀ k, Continuous ⇑(f k)) (s : Finset ι)
      (h : Continuous ⇑(∑ k ∈ s, f k)),
      wcContSheafMap S (∑ k ∈ s, f k) h = ∑ k ∈ s, wcContSheafMap S (f k) (hf k) := by
    intro A B _ _ _ _ _ _ ι f hf s
    classical
    induction s using Finset.induction_on with
    | empty =>
      intro h
      have h0 : Continuous ⇑(0 : A →+ B) := continuous_const
      rw [hcongr _ _ h h0 Finset.sum_empty, Finset.sum_empty]
      exact hzero h0
    | insert a s ha ih =>
      intro h
      have hs : Continuous ⇑(∑ k ∈ s, f k) :=
        (continuous_finset_sum s (fun k _ => hf k)).congr
          (fun x => (AddMonoidHom.finset_sum_apply f s x).symm)
      have h1 : Continuous ⇑(f a + ∑ k ∈ s, f k) := (hf a).add hs
      rw [hcongr _ _ h h1 (Finset.sum_insert ha), Finset.sum_insert ha, hadd _ _ (hf a) hs h1, ih hs]

  obtain ⟨ev, hev_def⟩ : ∃ ev : Fin b → ((Fin b → ℚ_[ℓ]) →+ ℚ_[ℓ]), ∀ j v, ev j v = v j :=
    ⟨fun j => Pi.evalAddMonoidHom (fun _ : Fin b => ℚ_[ℓ]) j, fun _ _ => rfl⟩
  obtain ⟨σ, hσ_def⟩ : ∃ σ : Fin b → (ℚ_[ℓ] →+ (Fin b → ℚ_[ℓ])), ∀ j a, σ j a = Pi.single j a :=
    ⟨fun j => AddMonoidHom.single (fun _ : Fin b => ℚ_[ℓ]) j,
      fun j a => by first | rfl | simp⟩
  have hev : ∀ j, Continuous ⇑(ev j) := fun j =>
    (continuous_apply j : Continuous fun v : Fin b → ℚ_[ℓ] => v j).congr
      (fun v => (hev_def j v).symm)
  have hσ : ∀ j, Continuous ⇑(σ j) := by
    intro j
    refine continuous_pi fun k => ?_
    simp only [hσ_def]
    by_cases hk : k = j
    · subst hk
      simp only [Pi.single_eq_same]
      exact continuous_id
    · simp only [Pi.single_eq_of_ne hk]
      exact continuous_const
  have I1 : ∑ j, (σ j).comp (ev j) = AddMonoidHom.id (Fin b → ℚ_[ℓ]) := by
    refine AddMonoidHom.ext fun v => ?_
    rw [AddMonoidHom.finset_sum_apply]
    simp only [AddMonoidHom.comp_apply, hev_def, hσ_def, AddMonoidHom.id_apply]
    exact Finset.univ_sum_single v
  have I2 : ∀ j, (ev j).comp (σ j) = AddMonoidHom.id ℚ_[ℓ] := by
    intro j
    refine AddMonoidHom.ext fun a => ?_
    rw [AddMonoidHom.comp_apply, hσ_def, hev_def, Pi.single_eq_same, AddMonoidHom.id_apply]
  have I3 : ∀ j k, j ≠ k → (ev k).comp (σ j) = 0 := by
    intro j k hjk
    refine AddMonoidHom.ext fun a => ?_
    rw [AddMonoidHom.comp_apply, hσ_def, hev_def, AddMonoidHom.zero_apply]
    exact Pi.single_eq_of_ne (M := fun _ : Fin b => ℚ_[ℓ]) (Ne.symm hjk) a
  have I4 : ∀ (j : Fin b) (c : ℚ_[ℓ]),
      (ev j).comp (DistribSMul.toAddMonoidHom (Fin b → ℚ_[ℓ]) c) =
        (DistribSMul.toAddMonoidHom ℚ_[ℓ] c).comp (ev j) := by
    intro j c
    refine AddMonoidHom.ext fun v => ?_
    rw [AddMonoidHom.comp_apply, AddMonoidHom.comp_apply, hev_def, hev_def,
      DistribSMul.toAddMonoidHom_apply, DistribSMul.toAddMonoidHom_apply, Pi.smul_apply]
  obtain ⟨Pj, hPj⟩ : ∃ Pj : Fin b → (wcContSheaf S (Fin b → ℚ_[ℓ]) ⟶ wcContSheaf S ℚ_[ℓ]),
      ∀ j, Pj j = wcContSheafMap S (ev j) (hev j) := ⟨_, fun _ => rfl⟩
  obtain ⟨Qj, hQj⟩ : ∃ Qj : Fin b → (wcContSheaf S ℚ_[ℓ] ⟶ wcContSheaf S (Fin b → ℚ_[ℓ])),
      ∀ j, Qj j = wcContSheafMap S (σ j) (hσ j) := ⟨_, fun _ => rfl⟩
  have J1 : ∑ j, Pj j ≫ Qj j = 𝟙 (wcContSheaf S (Fin b → ℚ_[ℓ])) := by
    have hSig : Continuous ⇑(∑ j, (σ j).comp (ev j)) := by rw [I1]; exact continuous_id
    calc ∑ j, Pj j ≫ Qj j
        = ∑ j, wcContSheafMap S ((σ j).comp (ev j)) ((hσ j).comp (hev j)) := by
          refine Finset.sum_congr rfl (fun j _ => ?_)
          rw [hPj, hQj]
          exact (hcomp (ev j) (hev j) (σ j) (hσ j) ((hσ j).comp (hev j))).symm
      _ = wcContSheafMap S (∑ j, (σ j).comp (ev j)) hSig :=
          (hsum (fun j => (σ j).comp (ev j)) (fun j => (hσ j).comp (hev j)) Finset.univ hSig).symm
      _ = wcContSheafMap S (AddMonoidHom.id _) continuous_id := hcongr _ _ _ _ I1
      _ = 𝟙 _ := hid _
  have J2 : ∀ j, Qj j ≫ Pj j = 𝟙 (wcContSheaf S ℚ_[ℓ]) := by
    intro j
    rw [hPj, hQj, ← hcomp (σ j) (hσ j) (ev j) (hev j) ((hev j).comp (hσ j)),
      hcongr _ _ _ continuous_id (I2 j), hid]
  have J3 : ∀ j k, j ≠ k → Qj j ≫ Pj k = 0 := by
    intro j k hjk
    have h0 : Continuous ⇑(0 : ℚ_[ℓ] →+ ℚ_[ℓ]) := continuous_const
    rw [hPj, hQj, ← hcomp (σ j) (hσ j) (ev k) (hev k) ((hev k).comp (hσ j)),
      hcongr _ _ _ h0 (I3 j k hjk), hzero]
  have J4 : ∀ (j : Fin b) (c : ℚ_[ℓ]),
      wcContSheafMap S (DistribSMul.toAddMonoidHom (Fin b → ℚ_[ℓ]) c) (continuous_const_smul c) ≫ Pj j =
        Pj j ≫ wcContSheafMap S (DistribSMul.toAddMonoidHom ℚ_[ℓ] c) (continuous_const_smul c) := by
    intro j c
    rw [hPj, ← hcomp (DistribSMul.toAddMonoidHom (Fin b → ℚ_[ℓ]) c) (continuous_const_smul c)
        (ev j) (hev j) ((hev j).comp (continuous_const_smul c)),
      ← hcomp (ev j) (hev j) (DistribSMul.toAddMonoidHom ℚ_[ℓ] c) (continuous_const_smul c)
        ((continuous_const_smul c).comp (hev j))]
    exact hcongr _ _ _ _ (I4 j c)

  let Pr : Abelian.Ext P (wcContSheaf S (Fin b → ℚ_[ℓ])) n ≃+
      (Fin b → Abelian.Ext P (wcContSheaf S ℚ_[ℓ]) n) :=
    { toFun := fun y j => y.comp (Abelian.Ext.mk₀ (Pj j)) (add_zero n)
      invFun := fun z => ∑ j, (z j).comp (Abelian.Ext.mk₀ (Qj j)) (add_zero n)
      left_inv := by
        intro y
        change ∑ j, (y.comp (Abelian.Ext.mk₀ (Pj j)) (add_zero n)).comp (Abelian.Ext.mk₀ (Qj j))
          (add_zero n) = y
        calc ∑ j, (y.comp (Abelian.Ext.mk₀ (Pj j)) (add_zero n)).comp (Abelian.Ext.mk₀ (Qj j))
              (add_zero n)
            = ∑ j, y.comp (Abelian.Ext.mk₀ (Pj j ≫ Qj j)) (add_zero n) := by
              refine Finset.sum_congr rfl (fun j _ => ?_)
              rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
          _ = y.comp (∑ j, Abelian.Ext.mk₀ (Pj j ≫ Qj j)) (add_zero n) := by
              rw [Abelian.Ext.comp_sum]
          _ = y.comp (Abelian.Ext.mk₀ (∑ j, Pj j ≫ Qj j)) (add_zero n) := by
              rw [Abelian.Ext.mk₀_sum]
          _ = y := by rw [J1, Abelian.Ext.comp_mk₀_id]
      right_inv := by
        intro z
        funext k
        change (∑ j, (z j).comp (Abelian.Ext.mk₀ (Qj j)) (add_zero n)).comp (Abelian.Ext.mk₀ (Pj k))
          (add_zero n) = z k
        rw [Abelian.Ext.sum_comp, Finset.sum_eq_single k]
        · rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, J2,
            Abelian.Ext.comp_mk₀_id]
        · intro j _ hjk
          rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, J3 j k hjk,
            Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
        · intro h
          exact absurd (Finset.mem_univ k) h
      map_add' := by
        intro y y'
        funext j
        exact Abelian.Ext.add_comp y y' _ _ }
  have hPr : ∀ (c : ℚ_[ℓ]) (y : Abelian.Ext P (wcContSheaf S (Fin b → ℚ_[ℓ])) n) (j : Fin b),
      Pr (y.comp (Abelian.Ext.mk₀ (wcConstScalar S ℓ b c)) (add_zero n)) j =
        (Pr y j).comp (Abelian.Ext.mk₀ (wcContSheafMap S (DistribSMul.toAddMonoidHom ℚ_[ℓ] c)
          (continuous_const_smul c))) (add_zero n) := by
    intro c y j
    change (y.comp (Abelian.Ext.mk₀ (wcContSheafMap S
        (DistribSMul.toAddMonoidHom (Fin b → ℚ_[ℓ]) c) (continuous_const_smul c))) (add_zero n)).comp
        (Abelian.Ext.mk₀ (Pj j)) (add_zero n) =
      (y.comp (Abelian.Ext.mk₀ (Pj j)) (add_zero n)).comp (Abelian.Ext.mk₀ (wcContSheafMap S
        (DistribSMul.toAddMonoidHom ℚ_[ℓ] c) (continuous_const_smul c))) (add_zero n)
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.comp_assoc_of_third_deg_zero,
      Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, J4]

  have keyL : ∀ (c : ℚ_[ℓ]) (U : (S.ProEt)ᵒᵖ)
      (x : ((wcLadicSheaf S ℓ).obj.obj U : Type (u+1))),
      (wcLadicScalar S ℓ c).hom.app U x =
        (ULift.up (c • (ULift.down x : C(↥((Scheme.ProEt.forget S ⋙
          Over.forget S).obj (Opposite.unop U)), ℚ_[ℓ]))) : _) := by
    intro c U x
    rfl
  have hL : ∀ c : ℚ_[ℓ], wcLadicScalar S ℓ c =
      (wcContSheafMap S (DistribSMul.toAddMonoidHom ℚ_[ℓ] c) (continuous_const_smul c) :
        wcLadicSheaf S ℓ ⟶ wcLadicSheaf S ℓ) := by
    intro c
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [keyL]
    exact (key (DistribSMul.toAddMonoidHom ℚ_[ℓ] c) (continuous_const_smul c) U x).symm

  let Λ := (Module.finBasis ℚ_[ℓ] (Fin b → Fin r → ℚ_[ℓ])).equivFun
  let E : Abelian.Ext P (wcContSheaf S (Fin b → ℚ_[ℓ])) n ≃+
      (Fin (Module.finrank ℚ_[ℓ] (Fin b → Fin r → ℚ_[ℓ])) → ℚ_[ℓ]) :=
    Pr.trans ((AddEquiv.piCongrRight (fun _ : Fin b =>
      (e : Abelian.Ext P (wcContSheaf S ℚ_[ℓ]) n ≃+ (Fin r → ℚ_[ℓ])))).trans Λ.toAddEquiv)
  refine ⟨Module.finrank ℚ_[ℓ] (Fin b → Fin r → ℚ_[ℓ]), E, ?_⟩
  intro c x
  have h2 : (fun j => e (Pr (x.comp (Abelian.Ext.mk₀ (wcConstScalar S ℓ b c)) (add_zero n)) j)) =
      c • (fun j => e (Pr x j)) := by
    funext j
    rw [Pi.smul_apply, hPr c x j]
    have h3 := he c (Pr x j)
    rw [hL c] at h3
    exact h3
  change Λ (fun j => e (Pr (x.comp (Abelian.Ext.mk₀ (wcConstScalar S ℓ b c)) (add_zero n)) j)) =
    c • Λ (fun j => e (Pr x j))
  rw [h2, map_smul]

theorem wc_padicInt_additive_bounded_linear : ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (b : ℕ)
    (f : ℤ_[ℓ] →+ (Fin b → ℚ_[ℓ])), (∃ B : ℝ, ∀ d, ‖f d‖ ≤ B) →
    ∀ d : ℤ_[ℓ], f d = (d : ℚ_[ℓ]) • f 1 :=
by
  intro ℓ _ b f hBex d
  obtain ⟨B, hB⟩ := hBex
  let g : ℤ_[ℓ] →+ (Fin b → ℚ_[ℓ]) :=
    { toFun := fun x => f x - (x : ℚ_[ℓ]) • f 1
      map_zero' := by simp
      map_add' := fun x y => by
        simp only [map_add, PadicInt.coe_add, add_smul]; abel }
  have hg : ∀ x, g x = f x - (x : ℚ_[ℓ]) • f 1 := fun x => rfl
  have hgB : ∀ x, ‖g x‖ ≤ 2 * B := by
    intro x
    rw [hg]
    calc ‖f x - (x : ℚ_[ℓ]) • f 1‖ ≤ ‖f x‖ + ‖(x : ℚ_[ℓ]) • f 1‖ := norm_sub_le _ _
      _ = ‖f x‖ + ‖(x : ℚ_[ℓ])‖ * ‖f 1‖ := by rw [norm_smul]
      _ ≤ B + 1 * B := by
        gcongr
        · exact hB x
        · rw [PadicInt.padic_norm_e_of_padicInt]; exact PadicInt.norm_le_one x
        · exact hB 1
      _ = 2 * B := by ring
  have hgn : ∀ n : ℕ, g (n : ℤ_[ℓ]) = 0 := by
    intro n
    have h1 : f (n : ℤ_[ℓ]) = n • f 1 := by simpa using map_nsmul f n 1
    rw [hg, PadicInt.coe_natCast, Nat.cast_smul_eq_nsmul, h1, sub_self]
  have hkey : ∀ k : ℕ, (ℓ : ℝ) ^ k * ‖g d‖ ≤ 2 * B := by
    intro k
    obtain ⟨e, he⟩ := (Ideal.mem_span_singleton').mp (PadicInt.appr_spec k d)
    have hd : d = (d.appr k : ℤ_[ℓ]) + (ℓ ^ k : ℕ) • e := by
      have h3 : (ℓ ^ k : ℕ) • e = d - d.appr k := by
        rw [nsmul_eq_mul, Nat.cast_pow, ← he]; ring
      rw [h3]; ring
    have h1 : g d = ((ℓ : ℚ_[ℓ]) ^ k) • g e := by
      rw [hd, map_add, hgn, zero_add, map_nsmul, ← Nat.cast_smul_eq_nsmul ℚ_[ℓ], Nat.cast_pow]
    have h2 : ‖g d‖ = ((ℓ : ℝ) ^ k)⁻¹ * ‖g e‖ := by
      rw [h1, norm_smul, norm_pow, Padic.norm_p, inv_pow]
    have hpos : (0 : ℝ) < (ℓ : ℝ) ^ k := by
      have := (Fact.out : ℓ.Prime).pos
      positivity
    rw [h2, ← mul_assoc, mul_inv_cancel₀ hpos.ne', one_mul]
    exact hgB e
  have hgd : g d = 0 := by
    by_contra hne
    have hpos : 0 < ‖g d‖ := norm_pos_iff.mpr hne
    have hℓ1 : (1 : ℝ) < ℓ := by exact_mod_cast (Fact.out : ℓ.Prime).one_lt
    obtain ⟨k, hk⟩ := pow_unbounded_of_one_lt (2 * B / ‖g d‖) hℓ1
    rw [div_lt_iff₀ hpos] at hk
    linarith [hkey k]
  rw [hg, sub_eq_zero] at hgd
  exact hgd

theorem wc_proet_padic_test_object : ∀ (S : Scheme.{u}) (V : S.ProEt) (ℓ : ℕ) [Fact (Nat.Prime ℓ)],
    ∃ (V' : S.ProEt) (p : V' ⟶ V) (π : C(V'.left, ℤ_[ℓ])) (σ : ℤ_[ℓ] → (V ⟶ V')),
      (∀ d, σ d ≫ p = 𝟙 V) ∧ (∀ d (v : V.left), π ((σ d).left v) = d) ∧
      ∀ v : V.left, ∃ C : Set V'.left, IsCompact C ∧ ∀ d, (σ d).left v ∈ C :=
by
  intro S V ℓ _
  classical

  have c1 : ∀ (K : Type) [TopologicalSpace K] [CompactSpace K],
      WeaklyEtale (Spec.map (CommRingCat.ofHom
        (algebraMap (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ))))) := by
    intro K _ _
    have hsep : ∀ φ : LocallyConstant K (ULift.{u} ℤ),
        ∃ c : TensorProduct (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ))
          (LocallyConstant K (ULift.{u} ℤ)),
        Algebra.TensorProduct.lmul' (ULift.{u} ℤ) c = 1 ∧
          c * (TensorProduct.tmul (ULift.{u} ℤ) (1 : LocallyConstant K (ULift.{u} ℤ)) φ -
            TensorProduct.tmul (ULift.{u} ℤ) φ 1) = 0 := by
      intro φ
      let s : Finset (ULift.{u} ℤ) := (LocallyConstant.range_finite φ).toFinset
      let ε : ULift.{u} ℤ → LocallyConstant K (ULift.{u} ℤ) :=
        fun v => φ.map (fun w => if w = v then (1 : ULift.{u} ℤ) else 0)
      have hε : ∀ v y, ε v y = if φ y = v then 1 else 0 := fun v y => rfl
      have F1 : ∀ v, ε v * ε v = ε v := by
        intro v
        ext y
        rw [LocallyConstant.mul_apply, hε]
        split_ifs <;> simp
      have F2 : ∀ v, ε v * φ = v • ε v := by
        intro v
        ext y
        rw [LocallyConstant.mul_apply, LocallyConstant.smul_apply, hε]
        split_ifs with h
        · rw [h, one_mul, smul_eq_mul, mul_one]
        · rw [zero_mul, smul_eq_mul, mul_zero]
      have F3 : ∑ v ∈ s, ε v = 1 := by
        ext y
        have := map_sum (LocallyConstant.evalRingHom y :
          LocallyConstant K (ULift.{u} ℤ) →+* ULift.{u} ℤ) ε s
        simp only [LocallyConstant.evalRingHom_apply] at this
        rw [this]
        simp [hε, s, Finset.sum_ite_eq]
      refine ⟨∑ v ∈ s, TensorProduct.tmul (ULift.{u} ℤ) (ε v) (ε v), ?_, ?_⟩
      · rw [map_sum]
        simp only [Algebra.TensorProduct.lmul'_apply_tmul, F1]
        exact F3
      · rw [Finset.sum_mul]
        apply Finset.sum_eq_zero
        intro v _
        rw [mul_sub, Algebra.TensorProduct.tmul_mul_tmul, Algebra.TensorProduct.tmul_mul_tmul,
          mul_one, F2, TensorProduct.smul_tmul, sub_self]
    have heq : algebraMap (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ)) =
        (algebraMap ℤ (LocallyConstant K (ULift.{u} ℤ))).comp
          (ULift.ringEquiv : ULift.{u} ℤ ≃+* ℤ).toRingHom := by
      refine RingHom.ext fun x => LocallyConstant.ext fun y => ?_
      apply ULift.ext
      have e1 : (algebraMap (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ)) x) y = x := rfl
      have e2 : ((algebraMap ℤ (LocallyConstant K (ULift.{u} ℤ))).comp
          (ULift.ringEquiv : ULift.{u} ℤ ≃+* ℤ).toRingHom x) y = ((x.down : ℤ) : ULift.{u} ℤ) := by
        rw [RingHom.comp_apply, eq_intCast]
        exact map_intCast (LocallyConstant.evalRingHom y :
          LocallyConstant K (ULift.{u} ℤ) →+* ULift.{u} ℤ) _
      rw [e1, e2, ULift.down_intCast, Int.cast_id]
    have hfring : (algebraMap (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ))).Flat := by
      rw [heq]
      refine RingHom.Flat.comp ?_ ?_
      · exact RingHom.Flat.of_bijective (ULift.ringEquiv : ULift.{u} ℤ ≃+* ℤ).bijective
      · refine RingHom.flat_algebraMap_iff.mpr ?_
        rw [IsDedekindDomain.flat_iff_torsion_eq_bot, Submodule.eq_bot_iff]
        intro x hx
        obtain ⟨a, ha⟩ := (Submodule.mem_torsion_iff x).mp hx
        have hn : (a : ℤ) ≠ 0 := nonZeroDivisors.coe_ne_zero a
        rw [Submonoid.smul_def, Algebra.smul_def] at ha
        ext y
        have h1 := congrArg (LocallyConstant.evalRingHom y :
          LocallyConstant K (ULift.{u} ℤ) →+* ULift.{u} ℤ) ha
        rw [map_mul, map_zero, eq_intCast, map_intCast, LocallyConstant.evalRingHom_apply] at h1
        have h2 := congrArg ULift.down h1
        rw [ULift.mul_down, ULift.down_intCast, ULift.zero_down, Int.cast_id] at h2
        show (x y).down = (0 : ULift.{u} ℤ).down
        rw [ULift.zero_down]
        exact (mul_eq_zero.mp h2).resolve_left hn
    have hflatμ : RingHom.Flat
        (Algebra.TensorProduct.lmul' (ULift.{u} ℤ) :
          TensorProduct (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ))
            (LocallyConstant K (ULift.{u} ℤ)) →ₐ[ULift.{u} ℤ]
              LocallyConstant K (ULift.{u} ℤ)).toRingHom := by
      let μ := (Algebra.TensorProduct.lmul' (ULift.{u} ℤ) :
          TensorProduct (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ))
            (LocallyConstant K (ULift.{u} ℤ)) →ₐ[ULift.{u} ℤ] LocallyConstant K (ULift.{u} ℤ))
      letI : Algebra (TensorProduct (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ))
          (LocallyConstant K (ULift.{u} ℤ))) (LocallyConstant K (ULift.{u} ℤ)) :=
        μ.toRingHom.toAlgebra
      let M : Submonoid (TensorProduct (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ))
          (LocallyConstant K (ULift.{u} ℤ))) :=
        Submonoid.comap μ.toRingHom (IsUnit.submonoid (LocallyConstant K (ULift.{u} ℤ)))
      have hM : ∀ y, y ∈ M ↔ IsUnit (μ y) := fun y => by
        rw [Submonoid.mem_comap, IsUnit.mem_submonoid_iff]; rfl
      haveI : IsLocalization M (LocallyConstant K (ULift.{u} ℤ)) := by
        refine ⟨?_, ?_, ?_⟩
        · intro y
          exact (hM y.1).mp y.2
        · intro z
          refine ⟨⟨TensorProduct.tmul (ULift.{u} ℤ) z 1, 1⟩, ?_⟩
          show z * μ 1 = μ (TensorProduct.tmul (ULift.{u} ℤ) z 1)
          rw [map_one, Algebra.TensorProduct.lmul'_apply_tmul, mul_one]
        · intro x y hxy
          change μ x = μ y at hxy
          have hker : x - y ∈ Ideal.span (Set.range fun s : LocallyConstant K (ULift.{u} ℤ) =>
              TensorProduct.tmul (ULift.{u} ℤ) (1 : LocallyConstant K (ULift.{u} ℤ)) s -
                TensorProduct.tmul (ULift.{u} ℤ) s 1) := by
            rw [KaehlerDifferential.span_range_eq_ideal, KaehlerDifferential.ideal, RingHom.mem_ker,
              map_sub]
            exact sub_eq_zero.mpr hxy
          have key : ∀ a ∈ Ideal.span (Set.range fun s : LocallyConstant K (ULift.{u} ℤ) =>
              TensorProduct.tmul (ULift.{u} ℤ) (1 : LocallyConstant K (ULift.{u} ℤ)) s -
                TensorProduct.tmul (ULift.{u} ℤ) s 1),
              ∃ c ∈ M, c * a = 0 := by
            intro a ha
            induction ha using Submodule.span_induction with
            | mem a ha =>
              obtain ⟨s, rfl⟩ := ha
              obtain ⟨c, hc1, hc2⟩ := hsep s
              refine ⟨c, (hM c).mpr ?_, hc2⟩
              show IsUnit (Algebra.TensorProduct.lmul' (ULift.{u} ℤ) c)
              rw [hc1]; exact isUnit_one
            | zero => exact ⟨1, M.one_mem, mul_zero 1⟩
            | add a b _ _ ha hb =>
              obtain ⟨c1, h1, e1⟩ := ha
              obtain ⟨c2, h2, e2⟩ := hb
              exact ⟨c1 * c2, M.mul_mem h1 h2, by linear_combination c2 * e1 + c1 * e2⟩
            | smul r a _ ha =>
              obtain ⟨c, h, e⟩ := ha
              exact ⟨c, h, by rw [smul_eq_mul, mul_left_comm, e, mul_zero]⟩
          obtain ⟨c, hc, e⟩ := key _ hker
          exact ⟨⟨c, hc⟩, by rw [mul_sub] at e; exact sub_eq_zero.mp e⟩
      exact IsLocalization.flat (LocallyConstant K (ULift.{u} ℤ)) M
    have hf : Flat (Spec.map (CommRingCat.ofHom
        (algebraMap (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ))))) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat)]
      exact hfring
    have hd : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom
        (algebraMap (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ)))))) := by
      rw [diagonal_SpecMap]
      haveI : Flat (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' (ULift.{u} ℤ) :
          TensorProduct (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ))
            (LocallyConstant K (ULift.{u} ℤ)) →ₐ[ULift.{u} ℤ]
              LocallyConstant K (ULift.{u} ℤ)).toRingHom)) :=
        HasRingHomProperty.Spec_iff.mpr hflatμ
      infer_instance
    exact ⟨hf, hd⟩

  have c2 : ∀ (K : Type) [TopologicalSpace K] [CompactSpace K] [T2Space K]
      [TotallyDisconnectedSpace K],
      ∃ π0 : C(PrimeSpectrum (LocallyConstant K (ULift.{u} ℤ)), K),
        ∀ (U : Set K) (hU : IsClopen U) (q : PrimeSpectrum (LocallyConstant K (ULift.{u} ℤ))),
          π0 q ∈ U ↔ q ∈ PrimeSpectrum.basicOpen (LocallyConstant.charFn (ULift.{u} ℤ) hU) := by
    intro K _ _ _ _
    have I1 : LocallyConstant.charFn (ULift.{u} ℤ) (isClopen_univ (X := K)) = 1 := by
      ext y
      simp [LocallyConstant.coe_charFn]
    have I2 : LocallyConstant.charFn (ULift.{u} ℤ) (isClopen_empty (X := K)) = 0 := by
      ext y
      simp [LocallyConstant.coe_charFn]
    have I3 : ∀ (U V : Set K) (hU : IsClopen U) (hV : IsClopen V),
        LocallyConstant.charFn (ULift.{u} ℤ) (hU.inter hV) =
          LocallyConstant.charFn (ULift.{u} ℤ) hU * LocallyConstant.charFn (ULift.{u} ℤ) hV := by
      intro U V hU hV
      ext y
      simp only [LocallyConstant.coe_charFn, LocallyConstant.coe_mul, Pi.mul_apply,
        Set.indicator_apply, Pi.one_apply, Set.mem_inter_iff]
      split_ifs <;> simp_all
    have I5 : ∀ (U : Set K) (hU : IsClopen U),
        LocallyConstant.charFn (ULift.{u} ℤ) hU + LocallyConstant.charFn (ULift.{u} ℤ) hU.compl = 1 := by
      intro U hU
      ext y
      simp only [LocallyConstant.coe_charFn, LocallyConstant.coe_add, LocallyConstant.coe_one,
        Pi.add_apply, Pi.one_apply, Set.indicator_apply, Set.mem_compl_iff]
      split_ifs <;> simp_all
    have key : ∀ q : PrimeSpectrum (LocallyConstant K (ULift.{u} ℤ)), ∃ x : K,
        ∀ (U : Set K) (hU : IsClopen U),
          x ∈ U ↔ LocallyConstant.charFn (ULift.{u} ℤ) hU ∉ q.asIdeal := by
      intro q
      have hP := q.isPrime
      have h1 : (1 : LocallyConstant K (ULift.{u} ℤ)) ∉ q.asIdeal :=
        (Ideal.ne_top_iff_one _).mp hP.ne_top
      let 𝒰 : Set (Set K) :=
        {U | ∃ hU : IsClopen U, LocallyConstant.charFn (ULift.{u} ℤ) hU ∉ q.asIdeal}
      have hne : (⋂₀ 𝒰).Nonempty := by
        have : Nonempty 𝒰 := ⟨⟨Set.univ, isClopen_univ, by rw [I1]; exact h1⟩⟩
        apply IsCompact.nonempty_sInter_of_directed_nonempty_isCompact_isClosed
        · intro U hU V hV
          obtain ⟨hU', hu⟩ := hU
          obtain ⟨hV', hv⟩ := hV
          refine ⟨U ∩ V, ⟨hU'.inter hV', ?_⟩, Set.inter_subset_left, Set.inter_subset_right⟩
          rw [I3 U V hU' hV']
          intro hm
          rcases hP.mem_or_mem hm with h | h
          · exact hu h
          · exact hv h
        · rintro U ⟨hU', hu⟩
          rw [Set.nonempty_iff_ne_empty]
          rintro rfl
          apply hu
          have e : LocallyConstant.charFn (ULift.{u} ℤ) hU' = 0 := I2
          rw [e]
          exact Ideal.zero_mem _
        · rintro U ⟨hU', -⟩
          exact hU'.isClosed.isCompact
        · rintro U ⟨hU', -⟩
          exact hU'.isClosed
      obtain ⟨x, hx⟩ := hne
      rw [Set.mem_sInter] at hx
      refine ⟨x, fun U hU => ⟨fun hxU hm => ?_, fun hn => hx U ⟨hU, hn⟩⟩⟩
      have hc : LocallyConstant.charFn (ULift.{u} ℤ) hU.compl ∉ q.asIdeal := by
        intro hc
        apply h1
        rw [← I5 U hU]
        exact Ideal.add_mem _ hm hc
      exact hx Uᶜ ⟨hU.compl, hc⟩ hxU
    choose f hf using key
    have hcont : Continuous f := by
      rw [isTopologicalBasis_isClopen.continuous_iff]
      intro s hs
      have e : f ⁻¹' s =
          (PrimeSpectrum.basicOpen (LocallyConstant.charFn (ULift.{u} ℤ) hs) : Set _) := by
        ext q
        rw [Set.mem_preimage, hf q s hs, SetLike.mem_coe, PrimeSpectrum.mem_basicOpen]
      rw [e]
      exact PrimeSpectrum.isOpen_basicOpen
    refine ⟨⟨f, hcont⟩, fun U hU q => ?_⟩
    rw [PrimeSpectrum.mem_basicOpen]
    exact hf q U hU
  obtain ⟨π0, hπ0⟩ := c2 ℤ_[ℓ]

  have c3 : ∀ (d : ℤ_[ℓ]) (y : PrimeSpectrum (ULift.{u} ℤ)),
      π0 (PrimeSpectrum.comap (LocallyConstant.evalRingHom d) y) = d := by
    intro d y
    by_contra hne
    obtain ⟨W, hW, hxW, hWsub⟩ := compact_exists_isClopen_in_isOpen
      (isOpen_compl_singleton (x := d))
      (show π0 (PrimeSpectrum.comap (LocallyConstant.evalRingHom d) y) ∈ ({d}ᶜ : Set ℤ_[ℓ])
        from hne)
    have h1 := (hπ0 W hW _).mp hxW
    rw [PrimeSpectrum.mem_basicOpen, PrimeSpectrum.comap_asIdeal, Ideal.mem_comap,
      LocallyConstant.evalRingHom_apply] at h1
    have hdW : d ∉ W := fun h => hWsub h (Set.mem_singleton d)
    rw [(LocallyConstant.charFn_eq_zero (ULift.{u} ℤ) d hW).mpr hdW] at h1
    exact h1 (Ideal.zero_mem _)

  let q : Spec (CommRingCat.of (LocallyConstant ℤ_[ℓ] (ULift.{u} ℤ))) ⟶
      Spec (CommRingCat.of (ULift.{u} ℤ)) :=
    Spec.map (CommRingCat.ofHom (algebraMap (ULift.{u} ℤ) (LocallyConstant ℤ_[ℓ] (ULift.{u} ℤ))))
  let t : V.left ⟶ Spec (CommRingCat.of (ULift.{u} ℤ)) := specULiftZIsTerminal.from V.left
  have hq : WeaklyEtale q := c1 ℤ_[ℓ]
  have hfst : WeaklyEtale (Limits.pullback.fst t q) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback t q).flip hq
  have : WeaklyEtale (Limits.pullback.fst t q ≫ V.hom) := by
    have := V.prop
    infer_instance
  let V' : S.ProEt := Scheme.ProEt.mk (Limits.pullback.fst t q ≫ V.hom)
  let p : V' ⟶ V := MorphismProperty.Over.homMk (Limits.pullback.fst t q) rfl trivial
  let e : ℤ_[ℓ] → (Spec (CommRingCat.of (ULift.{u} ℤ)) ⟶
      Spec (CommRingCat.of (LocallyConstant ℤ_[ℓ] (ULift.{u} ℤ)))) := fun d =>
    Spec.map (CommRingCat.ofHom (LocallyConstant.evalRingHom d))
  have hd : ∀ d, 𝟙 V.left ≫ t = (t ≫ e d) ≫ q := fun d => specULiftZIsTerminal.hom_ext _ _
  let L : ℤ_[ℓ] → (V.left ⟶ Limits.pullback t q) := fun d =>
    Limits.pullback.lift (𝟙 V.left) (t ≫ e d) (hd d)
  have hLf : ∀ d, L d ≫ Limits.pullback.fst t q = 𝟙 V.left := fun d =>
    Limits.pullback.lift_fst _ _ _
  have hLs : ∀ d, L d ≫ Limits.pullback.snd t q = t ≫ e d := fun d =>
    Limits.pullback.lift_snd _ _ _
  let σ : ℤ_[ℓ] → (V ⟶ V') := fun d => MorphismProperty.Over.homMk (L d) (by
      show L d ≫ Limits.pullback.fst t q ≫ V.hom = V.hom
      rw [← Category.assoc, hLf d, Category.id_comp]) trivial
  let π : C(V'.left, ℤ_[ℓ]) := π0.comp (Limits.pullback.snd t q).base.hom
  refine ⟨V', p, π, σ, ?_, ?_, ?_⟩
  · intro d
    apply MorphismProperty.Over.Hom.ext
    change L d ≫ Limits.pullback.fst t q = 𝟙 V.left
    exact hLf d
  · intro d v
    change π0 ((Limits.pullback.snd t q) (L d v)) = d
    have h1 : (Limits.pullback.snd t q) (L d v) = (L d ≫ Limits.pullback.snd t q) v := rfl
    rw [h1, hLs d]
    exact c3 d (t v)
  · intro v
    obtain ⟨W, hWa, hvW, -⟩ :=
      exists_isAffineOpen_mem_and_subset (show v ∈ (⊤ : V.left.Opens) from trivial)
    haveI : QuasiCompact q := inferInstance
    haveI : QuasiCompact (Limits.pullback.fst t q) := inferInstance
    refine ⟨(Limits.pullback.fst t q) ⁻¹' (W : Set V.left),
      QuasiCompact.isCompact_preimage (f := Limits.pullback.fst t q) (W : Set V.left) W.isOpen
        hWa.isCompact, fun d => ?_⟩
    show (Limits.pullback.fst t q) (L d v) ∈ (W : Set V.left)
    have h1 : (Limits.pullback.fst t q) (L d v) = (L d ≫ Limits.pullback.fst t q) v := rfl
    rw [h1, hLf d]
    exact hvW

theorem wc_contSheaf_over_endo_commutes_smul : ∀ (S : Scheme.{u}) (U : S.ProEt) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (b : ℕ)
    (θ : ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj
          (wcContSheaf S (Fin b → ℚ_[ℓ])) ⟶
        ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj
          (wcContSheaf S (Fin b → ℚ_[ℓ]))) (c : ℚ_[ℓ]),
    θ ≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).map
        (wcConstScalar S ℓ b c) =
      ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).map
        (wcConstScalar S ℓ b c) ≫ θ :=
by
  intro S U ℓ _ b θ c
  classical

  let Θ : ∀ V : Over U, C(V.left.left, Fin b → ℚ_[ℓ]) → C(V.left.left, Fin b → ℚ_[ℓ]) :=
    fun V s => ULift.down ((θ.hom.app (Opposite.op V)).hom
      (ULift.up s : ULift.{u+1} C(V.left.left, Fin b → ℚ_[ℓ])))
  have hadd : ∀ (V : Over U) (s t : C(V.left.left, Fin b → ℚ_[ℓ])),
      Θ V (s + t) = Θ V s + Θ V t := by
    intro V s t
    have h := map_add (θ.hom.app (Opposite.op V)).hom
      (ULift.up s : ULift.{u+1} C(V.left.left, Fin b → ℚ_[ℓ]))
      (ULift.up t : ULift.{u+1} C(V.left.left, Fin b → ℚ_[ℓ]))
    exact congrArg (fun z : ULift.{u+1} C(V.left.left, Fin b → ℚ_[ℓ]) => z.down) h
  have h0 : ∀ V : Over U, Θ V 0 = 0 := by
    intro V
    have h := hadd V 0 0
    rw [add_zero] at h
    exact add_left_cancel (h.symm.trans (add_zero _).symm)
  have hnsmul : ∀ (V : Over U) (n : ℕ) (t : C(V.left.left, Fin b → ℚ_[ℓ])),
      Θ V (n • t) = n • Θ V t := by
    intro V n t
    induction n with
    | zero => rw [zero_smul, zero_smul, h0]
    | succ n ih => rw [succ_nsmul, hadd, ih, succ_nsmul]
  have hnat : ∀ {V₁ V₂ : Over U} (h : V₁ ⟶ V₂) (s : C(V₂.left.left, Fin b → ℚ_[ℓ])),
      Θ V₁ (s.comp h.left.left.base.hom) = (Θ V₂ s).comp h.left.left.base.hom := by
    intro V₁ V₂ h s
    have h2 := congrArg (fun f => AddCommGrpCat.Hom.hom f
      (ULift.up s : ULift.{u+1} C(V₂.left.left, Fin b → ℚ_[ℓ]))) (θ.hom.naturality h.op)
    exact congrArg (fun z : ULift.{u+1} C(V₁.left.left, Fin b → ℚ_[ℓ]) => z.down) h2

  have hZ : ∀ (V : Over U) (s : C(V.left.left, Fin b → ℚ_[ℓ])) (d : ℤ_[ℓ]),
      Θ V ((d : ℚ_[ℓ]) • s) = (d : ℚ_[ℓ]) • Θ V s := by
    intro V s
    obtain ⟨V', p, π, σ, hσp, hπ, hC⟩ := wc_proet_padic_test_object S V.left ℓ
    let V'' : Over U := Over.mk (p ≫ V.hom)
    let Sg : ℤ_[ℓ] → (V ⟶ V'') := fun d => Over.homMk (σ d) (by
      show σ d ≫ p ≫ V.hom = V.hom
      rw [← Category.assoc, hσp d, Category.id_comp])
    have hpσ : ∀ d, (σ d).left ≫ p.left = 𝟙 V.left.left := fun d =>
      congrArg (fun f => f.left) (hσp d)
    have hpt : ∀ d (v : V.left.left), p.left ((σ d).left v) = v := by
      intro d v
      have h := congrArg (fun g : V.left.left ⟶ V.left.left => g v) (hpσ d)
      exact h
    let s' : C(V'.left, Fin b → ℚ_[ℓ]) :=
      ⟨fun y => ((π y : ℤ_[ℓ]) : ℚ_[ℓ]) • s (p.left.base.hom y),
        (continuous_subtype_val.comp π.continuous).smul
          (s.continuous.comp p.left.base.hom.continuous)⟩
    have hres : ∀ d : ℤ_[ℓ], s'.comp (σ d).left.base.hom = (d : ℚ_[ℓ]) • s := by
      intro d
      refine ContinuousMap.ext fun v => ?_
      change ((π ((σ d).left v) : ℤ_[ℓ]) : ℚ_[ℓ]) • s (p.left ((σ d).left v)) =
        (d : ℚ_[ℓ]) • s v
      rw [hπ d v, hpt d v]
    have hF : ∀ d : ℤ_[ℓ], Θ V ((d : ℚ_[ℓ]) • s) = (Θ V'' s').comp (σ d).left.base.hom := by
      intro d
      rw [← hres d]
      exact hnat (Sg d) s'
    intro d
    refine ContinuousMap.ext fun v => ?_
    obtain ⟨C, hCc, hCd⟩ := hC v
    have hFc : ContinuousOn (fun y : V'.left => (Θ V'' s') y) C :=
      (Θ V'' s').continuous.continuousOn
    obtain ⟨B, hB⟩ := hCc.exists_bound_of_continuousOn hFc
    let f : ℤ_[ℓ] →+ (Fin b → ℚ_[ℓ]) :=
      AddMonoidHom.mk' (fun e : ℤ_[ℓ] => Θ V ((e : ℚ_[ℓ]) • s) v) (fun e₁ e₂ => by
        show Θ V (((e₁ + e₂ : ℤ_[ℓ]) : ℚ_[ℓ]) • s) v =
          Θ V ((e₁ : ℚ_[ℓ]) • s) v + Θ V ((e₂ : ℚ_[ℓ]) • s) v
        rw [PadicInt.coe_add, add_smul, hadd]
        rfl)
    have hfb : ∀ e, ‖f e‖ ≤ B := by
      intro e
      have e1 : f e = (Θ V'' s') ((σ e).left v) := by
        show Θ V ((e : ℚ_[ℓ]) • s) v = _
        rw [hF e]
        rfl
      rw [e1]
      exact hB _ (hCd e)
    have h1 := wc_padicInt_additive_bounded_linear ℓ b f ⟨B, hfb⟩ d
    have h2 : f 1 = Θ V s v := by
      show Θ V (((1 : ℤ_[ℓ]) : ℚ_[ℓ]) • s) v = _
      rw [PadicInt.coe_one, one_smul]
    rw [ContinuousMap.smul_apply, ← h2]
    exact h1

  have hQ : ∀ (V : Over U) (s : C(V.left.left, Fin b → ℚ_[ℓ])), Θ V (c • s) = c • Θ V s := by
    intro V s
    have hℓ1 : (1 : ℝ) < (ℓ : ℝ) := by exact_mod_cast (Fact.out : ℓ.Prime).one_lt
    obtain ⟨k, hk⟩ := pow_unbounded_of_one_lt ‖c‖ hℓ1
    have hpos : (0 : ℝ) < (ℓ : ℝ) ^ k := by positivity
    have hnorm : ‖(ℓ : ℚ_[ℓ]) ^ k * c‖ ≤ 1 := by
      rw [norm_mul, norm_pow, Padic.norm_p, inv_pow, inv_mul_le_iff₀ hpos, mul_one]
      exact hk.le
    let a : ℤ_[ℓ] := ⟨(ℓ : ℚ_[ℓ]) ^ k * c, hnorm⟩
    have hac : ((ℓ ^ k : ℕ) : ℚ_[ℓ]) * c = (a : ℚ_[ℓ]) := by
      show ((ℓ ^ k : ℕ) : ℚ_[ℓ]) * c = (ℓ : ℚ_[ℓ]) ^ k * c
      rw [Nat.cast_pow]
    have hn0 : ((ℓ ^ k : ℕ) : ℚ_[ℓ]) ≠ 0 := by
      have : (ℓ ^ k : ℕ) ≠ 0 := pow_ne_zero _ (Fact.out : ℓ.Prime).ne_zero
      exact_mod_cast this
    have key : ((ℓ ^ k : ℕ) : ℚ_[ℓ]) • Θ V (c • s) =
        ((ℓ ^ k : ℕ) : ℚ_[ℓ]) • (c • Θ V s) := by
      calc ((ℓ ^ k : ℕ) : ℚ_[ℓ]) • Θ V (c • s) = (ℓ ^ k) • Θ V (c • s) :=
            Nat.cast_smul_eq_nsmul ℚ_[ℓ] _ _
        _ = Θ V ((ℓ ^ k) • (c • s)) := (hnsmul V _ _).symm
        _ = Θ V (((ℓ ^ k : ℕ) : ℚ_[ℓ]) • (c • s)) := by rw [Nat.cast_smul_eq_nsmul]
        _ = Θ V ((a : ℚ_[ℓ]) • s) := by rw [smul_smul, hac]
        _ = (a : ℚ_[ℓ]) • Θ V s := hZ V s a
        _ = ((ℓ ^ k : ℕ) : ℚ_[ℓ]) • (c • Θ V s) := by rw [smul_smul, hac]
    have key2 := congrArg (fun t => ((ℓ ^ k : ℕ) : ℚ_[ℓ])⁻¹ • t) key
    simpa only [inv_smul_smul₀ hn0] using key2

  apply Sheaf.hom_ext
  apply NatTrans.ext
  funext V
  apply AddCommGrpCat.ext
  intro x
  obtain ⟨s, rfl⟩ : ∃ s : C(V.unop.left.left, Fin b → ℚ_[ℓ]),
      x = (ULift.up s : ULift.{u+1} C(V.unop.left.left, Fin b → ℚ_[ℓ])) :=
    ⟨ULift.down (x : ULift.{u+1} C(V.unop.left.left, Fin b → ℚ_[ℓ])), rfl⟩
  exact (congrArg (fun t => (ULift.up t : ULift.{u+1} C(V.unop.left.left, Fin b → ℚ_[ℓ])))
    (hQ V.unop s)).symm

theorem wc_ring_action_findim_of_commuting : ∀ {V : Type*} [AddCommGroup V] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (σ ρ : ℚ_[ℓ] → V →+ V) (r : ℕ) (e : V ≃+ (Fin r → ℚ_[ℓ])),
    (∀ (c : ℚ_[ℓ]) (x : V), e (σ c x) = c • e x) →
    (∀ x, ρ 1 x = x) → (∀ a b x, ρ (a * b) x = ρ a (ρ b x)) →
    (∀ a b x, ρ (a + b) x = ρ a x + ρ b x) →
    (∀ c d x, ρ c (σ d x) = σ d (ρ c x)) →
    ∃ (r' : ℕ) (e' : V ≃+ (Fin r' → ℚ_[ℓ])), ∀ (c : ℚ_[ℓ]) (x : V), e' (ρ c x) = c • e' x :=
by
  intro V _ ℓ _ σ ρ r e he hρ1 hρm hρa hcomm
  classical
  have hℓ : Nat.Prime ℓ := Fact.out
  have hℓR : (1 : ℝ) < ℓ := by exact_mod_cast hℓ.one_lt
  have hℓpos : (0 : ℝ) < ℓ := by linarith

  have hes : ∀ (d : ℚ_[ℓ]) (v : Fin r → ℚ_[ℓ]), e.symm (d • v) = σ d (e.symm v) := fun d v =>
    e.injective (by rw [he, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
  let L : ℚ_[ℓ] → (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]) := fun c =>
    { toFun := fun v => e (ρ c (e.symm v))
      map_add' := fun v w => by simp only [map_add]
      map_smul' := fun d v => by simp only [hes, hcomm, he, RingHom.id_apply] }
  have hL : ∀ c v, L c v = e (ρ c (e.symm v)) := fun _ _ => rfl
  have hL1 : L 1 = LinearMap.id := by
    apply LinearMap.ext; intro v
    rw [hL, hρ1, AddEquiv.apply_symm_apply]; rfl
  have hLm : ∀ a b, L (a * b) = (L a).comp (L b) := by
    intro a b; apply LinearMap.ext; intro v
    rw [LinearMap.comp_apply, hL, hL, hL, AddEquiv.symm_apply_apply, hρm]
  have hLa : ∀ a b, L (a + b) = L a + L b := by
    intro a b; apply LinearMap.ext; intro v
    rw [LinearMap.add_apply, hL, hL, hL, hρa, map_add]
  let M : ℚ_[ℓ] → Matrix (Fin r) (Fin r) ℚ_[ℓ] := fun c => LinearMap.toMatrix' (L c)
  have hM1 : M 1 = 1 := by
    show LinearMap.toMatrix' (L 1) = 1
    rw [hL1, LinearMap.toMatrix'_id]
  have hMm : ∀ a b, M (a * b) = M a * M b := by
    intro a b
    show LinearMap.toMatrix' (L (a * b)) = LinearMap.toMatrix' (L a) * LinearMap.toMatrix' (L b)
    rw [hLm, LinearMap.toMatrix'_comp]
  have hMa : ∀ a b, M (a + b) = M a + M b := by
    intro a b
    show LinearMap.toMatrix' (L (a + b)) = LinearMap.toMatrix' (L a) + LinearMap.toMatrix' (L b)
    rw [hLa, map_add]
  have hM0 : M 0 = 0 := by
    have h := hMa 0 0
    rw [add_zero] at h
    have h2 : M 0 - M 0 = M 0 + M 0 - M 0 := congrArg (· - M 0) h
    rw [sub_self, add_sub_cancel_right] at h2
    exact h2.symm
  let φ : ℚ_[ℓ] →+* Matrix (Fin r) (Fin r) ℚ_[ℓ] :=
    { toFun := M, map_one' := hM1, map_mul' := hMm, map_zero' := hM0, map_add' := hMa }
  have heφ : ∀ (c : ℚ_[ℓ]) (x : V), e (ρ c x) = (φ c).mulVec (e x) := by
    intro c x
    show e (ρ c x) = (LinearMap.toMatrix' (L c)).mulVec (e x)
    rw [LinearMap.toMatrix'_mulVec, hL, AddEquiv.symm_apply_apply]

  let N : ℚ_[ℓ] → Matrix (Fin r) (Fin r) ℚ_[ℓ] := fun c => φ c - Matrix.scalar (Fin r) c
  have hscal : ∀ (c : ℚ_[ℓ]) (A : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      Commute (Matrix.scalar (Fin r) c) A :=
    fun c A => Matrix.scalar_commute c (fun _ => Commute.all _ _) A
  have hNc : ∀ a b, N a * N b = N b * N a := by
    intro a b
    have h1 : Commute (φ a) (φ b) := by
      show φ a * φ b = φ b * φ a
      rw [← map_mul, ← map_mul, mul_comm]
    exact ((h1.sub_right (hscal b (φ a)).symm).sub_left
      ((hscal a (φ b)).sub_right (hscal a _))).eq
  have hratφ : ∀ q : ℚ, φ (q : ℚ_[ℓ]) = Matrix.scalar (Fin r) (q : ℚ_[ℓ]) := by
    intro q
    have h := RingHom.ext_rat (φ.comp (Rat.castHom ℚ_[ℓ]))
      ((Matrix.scalar (Fin r)).comp (Rat.castHom ℚ_[ℓ]))
    exact RingHom.congr_fun h q

  let D : ℚ_[ℓ] →* ℚ_[ℓ] := Matrix.detMonoidHom.comp φ.toMonoidHom
  have hDapp : ∀ y, D y = (φ y).det := fun _ => rfl
  have hDrat : ∀ q : ℚ, D (q : ℚ_[ℓ]) = (q : ℚ_[ℓ]) ^ r := by
    intro q
    rw [hDapp, hratφ, Matrix.scalar_apply, Matrix.det_diagonal, Finset.prod_const,
      Finset.card_univ, Fintype.card_fin]
  have hDne : ∀ y : ℚ_[ℓ], y ≠ 0 → D y ≠ 0 := by
    intro y hy h
    have h1 := map_mul D y y⁻¹
    rw [mul_inv_cancel₀ hy, map_one, h, zero_mul] at h1
    exact one_ne_zero h1
  have hkey : ∀ u : ℚ_[ℓ], ‖u - 1‖ < 1 → ‖D u‖ = 1 := by
    intro u hu
    have hu0 : u ≠ 0 := by
      intro h; rw [h, zero_sub, norm_neg, norm_one] at hu; exact lt_irrefl _ hu
    obtain ⟨m, hmge, hm⟩ := Nat.exists_infinite_primes (ℓ + (D u).valuation.natAbs + 1)
    have hcop : ℓ.Coprime m := (Nat.coprime_primes hℓ hm).mpr (by omega)
    have hmnorm : ‖((m : ℕ) : ℤ_[ℓ])‖ = 1 := PadicInt.norm_natCast_eq_one_iff.mpr hcop
    let T : ℤ_[ℓ] := ⟨u - 1, hu.le⟩
    have hT : ‖T‖ < 1 := hu
    have hUu : ((1 + T : ℤ_[ℓ]) : ℚ_[ℓ]) = u := by
      rw [PadicInt.coe_add, PadicInt.coe_one]
      show 1 + (u - 1) = u
      ring
    have h1 : Polynomial.aeval (1 : ℤ_[ℓ]) (Polynomial.X ^ m - Polynomial.C (1 + T)) = -T := by
      simp
    have h2 : Polynomial.aeval (1 : ℤ_[ℓ])
        (Polynomial.derivative (Polynomial.X ^ m - Polynomial.C (1 + T))) = (m : ℤ_[ℓ]) := by
      simp [Polynomial.derivative_X_pow]
    obtain ⟨z, hz, -⟩ := hensels_lemma (p := ℓ) (R := ℤ_[ℓ])
      (F := Polynomial.X ^ m - Polynomial.C (1 + T)) (a := 1)
      (by rw [h1, h2, hmnorm, norm_neg, one_pow]; exact hT)
    have hz' : z ^ m = 1 + T := by
      simp only [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C,
        Algebra.algebraMap_self, RingHom.id_apply, sub_eq_zero] at hz
      exact hz
    have hzq : ((z : ℚ_[ℓ])) ^ m = u := by
      rw [← hUu, ← hz', PadicInt.coe_pow]
    have hz0 : (z : ℚ_[ℓ]) ≠ 0 := by
      intro h; rw [h, zero_pow hm.ne_zero] at hzq; exact hu0 hzq.symm
    have hDu : D u = D (z : ℚ_[ℓ]) ^ m := by rw [← hzq, map_pow]
    have e1 := Padic.norm_eq_zpow_neg_valuation (hDne u hu0)
    have e2 := Padic.norm_eq_zpow_neg_valuation (hDne _ hz0)
    have e3 : ‖D u‖ = ‖D (z : ℚ_[ℓ])‖ ^ m := by rw [hDu, norm_pow]
    rw [e1, e2, ← zpow_natCast, ← zpow_mul] at e3
    have e4 : -(D u).valuation = -(D (z : ℚ_[ℓ])).valuation * (m : ℤ) :=
      zpow_right_injective₀ hℓpos (ne_of_gt hℓR) e3
    have hval : (D u).valuation = 0 := by
      by_contra hne
      have hdvd : (m : ℤ) ∣ (D u).valuation := ⟨(D (z : ℚ_[ℓ])).valuation, by linarith⟩
      have h5 := Int.natAbs_le_of_dvd_ne_zero hdvd hne
      have h6 : (m : ℤ).natAbs = m := Int.natAbs_natCast m
      omega
    rw [e1, hval, neg_zero, zpow_zero]
  have hunit : ∀ w : ℚ_[ℓ], ‖w‖ = 1 → ‖D w‖ = 1 := by
    intro w hw
    let W : ℤ_[ℓ] := ⟨w, hw.le⟩
    have hWn : ‖W‖ = 1 := hw
    have hW0 : PadicInt.toZMod W ≠ 0 := by
      intro h
      have hmem : W ∈ IsLocalRing.maximalIdeal ℤ_[ℓ] := by
        rw [← PadicInt.ker_toZMod]; exact RingHom.mem_ker.mpr h
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hmem
      exact hmem (PadicInt.isUnit_iff.mpr hWn)
    have hF : PadicInt.toZMod (W ^ (ℓ - 1) - 1) = 0 := by
      rw [map_sub, map_pow, map_one, ZMod.pow_card_sub_one_eq_one hW0, sub_self]
    have hlt : ‖W ^ (ℓ - 1) - 1‖ < 1 := by
      have hmem : W ^ (ℓ - 1) - 1 ∈ IsLocalRing.maximalIdeal ℤ_[ℓ] := by
        rw [← PadicInt.ker_toZMod]; exact RingHom.mem_ker.mpr hF
      rw [IsLocalRing.mem_maximalIdeal] at hmem
      exact PadicInt.mem_nonunits.mp hmem
    have heq : ‖W ^ (ℓ - 1) - 1‖ = ‖(W : ℚ_[ℓ]) ^ (ℓ - 1) - 1‖ := by
      rw [PadicInt.norm_def, PadicInt.coe_sub, PadicInt.coe_pow, PadicInt.coe_one]
    have hlt' : ‖w ^ (ℓ - 1) - 1‖ < 1 := heq ▸ hlt
    have h3 := hkey _ hlt'
    rw [map_pow, norm_pow] at h3
    exact (pow_eq_one_iff_of_nonneg (norm_nonneg _) (by have := hℓ.two_le; omega)).mp h3
  have hdet : ∀ y : ℚ_[ℓ], ‖(φ y).det‖ = ‖y‖ ^ r := by
    intro y
    rw [← hDapp]
    by_cases hy : y = 0
    · have h0 := hDrat 0
      rw [Rat.cast_zero] at h0
      rw [hy, h0, norm_pow]
    · have hc : ‖((((ℓ : ℚ) ^ (-y.valuation) : ℚ)) : ℚ_[ℓ])‖ = (ℓ : ℝ) ^ y.valuation := by
        rw [Rat.cast_zpow, Rat.cast_natCast, Padic.norm_p_zpow, neg_neg]
      have hyn : ‖y‖ = (ℓ : ℝ) ^ (-y.valuation) := Padic.norm_eq_zpow_neg_valuation hy
      have hk0 : (ℓ : ℝ) ^ y.valuation ≠ 0 := ne_of_gt (zpow_pos hℓpos _)
      have hw : ‖y * ((((ℓ : ℚ) ^ (-y.valuation) : ℚ)) : ℚ_[ℓ])‖ = 1 := by
        rw [norm_mul, hc, hyn, zpow_neg, inv_mul_cancel₀ hk0]
      have h1 := hunit _ hw
      rw [map_mul, hDrat, norm_mul, norm_pow, hc] at h1
      have h2 : ‖y‖ ^ r * ((ℓ : ℝ) ^ y.valuation) ^ r = 1 := by
        rw [← mul_pow, hyn, zpow_neg, inv_mul_cancel₀ hk0, one_pow]
      exact mul_right_cancel₀ (pow_ne_zero r hk0) (h1.trans h2.symm)

  have hrig : ∀ (Q : Polynomial ℚ_[ℓ]) (x : ℚ_[ℓ]), Q.Monic → Q.natDegree = r →
      (∀ q : ℚ, ‖Q.eval ((q : ℚ_[ℓ]) - x)‖ = ‖(q : ℚ_[ℓ]) - x‖ ^ r) →
      Q = Polynomial.X ^ r := by
    intro Q x hQ hd h
    have aux : ∀ (k : ℕ) (P : Polynomial ℚ_[ℓ]), (∀ t, ‖P.eval t‖ = ‖t‖ ^ k) →
        Polynomial.X ^ k ∣ P := by
      intro k
      induction k with
      | zero => intro P _; simp
      | succ k ih =>
        intro P hP
        have h0 : P.coeff 0 = 0 := by
          rw [Polynomial.coeff_zero_eq_eval_zero]
          have := hP 0
          rw [norm_zero, zero_pow (Nat.succ_ne_zero k)] at this
          exact norm_eq_zero.mp this
        obtain ⟨P1, rfl⟩ := Polynomial.X_dvd_iff.mpr h0
        have hP1 : ∀ t, ‖P1.eval t‖ = ‖t‖ ^ k := by
          have hfun := Continuous.ext_on (dense_compl_singleton (0 : ℚ_[ℓ]))
            (f := fun t => ‖P1.eval t‖) (g := fun t => ‖t‖ ^ k)
            (P1.continuous.norm) (continuous_norm.pow k) (by
              intro t ht
              have ht' : t ≠ 0 := ht
              have := hP t
              rw [Polynomial.eval_mul, Polynomial.eval_X, norm_mul, pow_succ'] at this
              exact mul_left_cancel₀ (norm_ne_zero_iff.mpr ht') this)
          intro t
          exact congrFun hfun t
        rw [pow_succ']
        exact mul_dvd_mul_left _ (ih P1 hP1)
    have hall : ∀ t, ‖Q.eval t‖ = ‖t‖ ^ r := by
      have hfun := Continuous.ext_on (Padic.denseRange_ratCast ℓ)
        (f := fun t => ‖Q.eval (t - x)‖) (g := fun t => ‖t - x‖ ^ r)
        ((Q.continuous.comp (continuous_id.sub continuous_const)).norm)
        ((continuous_id.sub continuous_const).norm.pow r) (by
          rintro _ ⟨q, rfl⟩
          exact h q)
      intro t
      have := congrFun hfun (t + x)
      simpa using this
    obtain ⟨S, hS⟩ := aux r Q hall
    have hXm : (Polynomial.X ^ r : Polynomial ℚ_[ℓ]).Monic := Polynomial.monic_X_pow r
    have hSm : S.Monic := hXm.of_mul_monic_left (hS ▸ hQ)
    have hdeg := hXm.natDegree_mul hSm
    rw [← hS, hd, Polynomial.natDegree_X_pow] at hdeg
    have hS0 : S.natDegree = 0 := by omega
    rw [hS, Polynomial.eq_one_of_monic_natDegree_zero hSm hS0, mul_one]

  have hnil : ∀ x, N x ^ r = 0 := by
    intro x
    have hcp : (N x).charpoly = Polynomial.X ^ r := by
      refine hrig (N x).charpoly x (Matrix.charpoly_monic _) ?_ ?_
      · rw [Matrix.charpoly_natDegree_eq_dim, Fintype.card_fin]
      · intro q
        rw [Matrix.eval_charpoly]
        have hq : Matrix.scalar (Fin r) ((q : ℚ_[ℓ]) - x) - N x = φ ((q : ℚ_[ℓ]) - x) := by
          rw [map_sub, map_sub, hratφ]
          show Matrix.scalar (Fin r) (q : ℚ_[ℓ]) - Matrix.scalar (Fin r) x -
            (φ x - Matrix.scalar (Fin r) x) = Matrix.scalar (Fin r) (q : ℚ_[ℓ]) - φ x
          abel
        rw [hq, hdet]
    have h := Matrix.aeval_self_charpoly (N x)
    rw [hcp, map_pow, Polynomial.aeval_X] at h
    exact h

  have hcommR : (Set.range N).Pairwise Commute := by
    rintro _ ⟨a, rfl⟩ _ ⟨b, rfl⟩ _
    exact hNc a b
  let A : Subalgebra ℚ_[ℓ] (Matrix (Fin r) (Fin r) ℚ_[ℓ]) := Algebra.adjoin ℚ_[ℓ] (Set.range N)
  letI : CommRing A := Algebra.adjoinCommRingOfComm ℚ_[ℓ] hcommR
  haveI : IsArtinianRing A := IsArtinianRing.of_finite ℚ_[ℓ] A
  obtain ⟨K, hK⟩ := IsArtinianRing.isNilpotent_nilradical (R := A)
  have hgen : ∀ a, N a ∈ A := fun a =>
    Algebra.subset_adjoin (R := ℚ_[ℓ]) (s := Set.range N) (Set.mem_range_self (f := N) a)
  have hcoe : ∀ x y : A, ((x * y : A) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) =
      (x : Matrix (Fin r) (Fin r) ℚ_[ℓ]) * (y : Matrix (Fin r) (Fin r) ℚ_[ℓ]) := fun _ _ => rfl
  have hmem : ∀ a, (⟨N a, hgen a⟩ : A) ∈ nilradical A := by
    intro a
    refine mem_nilradical.mpr ⟨r, Subtype.ext ?_⟩
    exact hnil a

  let Sub : ℕ → Submodule ℚ_[ℓ] (Fin r → ℚ_[ℓ]) := fun j =>
    Submodule.span ℚ_[ℓ] {w | ∃ x : A, x ∈ nilradical A ^ j ∧
      ∃ v, w = (x : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec v}
  have hSub0 : Sub 0 = ⊤ := by
    rw [eq_top_iff]
    intro v _
    apply Submodule.subset_span
    refine ⟨1, by simp, v, ?_⟩
    show v = (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec v
    rw [Matrix.one_mulVec]
  have hSubK : Sub K = ⊥ := by
    show Submodule.span _ _ = ⊥
    apply Submodule.span_eq_bot.mpr
    rintro w ⟨x, hx, v, rfl⟩
    rw [hK, Ideal.zero_eq_bot, Ideal.mem_bot] at hx
    rw [hx]
    show (0 : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec v = 0
    exact Matrix.zero_mulVec v
  have hstep : ∀ j a, ∀ t ∈ Sub j, (N a).mulVec t ∈ Sub (j + 1) := by
    intro j a t ht
    have hle : Sub j ≤ (Sub (j + 1)).comap (Matrix.toLin' (N a)) := by
      show Submodule.span _ _ ≤ _
      apply Submodule.span_le.mpr
      rintro w ⟨x, hx, v, rfl⟩
      rw [SetLike.mem_coe, Submodule.mem_comap, Matrix.toLin'_apply, Matrix.mulVec_mulVec]
      apply Submodule.subset_span
      refine ⟨⟨N a, hgen a⟩ * x, ?_, v, ?_⟩
      · rw [pow_succ']
        exact Ideal.mul_mem_mul (hmem a) hx
      · rw [hcoe]
    have h1 := hle ht
    rwa [Submodule.mem_comap, Matrix.toLin'_apply] at h1
  have hfg : ∀ j, ∃ S : Finset (Fin r → ℚ_[ℓ]),
      Submodule.span ℚ_[ℓ] (S : Set (Fin r → ℚ_[ℓ])) = Sub j :=
    fun j => IsNoetherian.noetherian (Sub j)
  choose S hS using hfg
  let T : Finset (Fin r → ℚ_[ℓ]) := (Finset.range (K + 1)).biUnion S
  let G : AddSubgroup (Fin r → ℚ_[ℓ]) :=
    AddSubgroup.closure {w | ∃ a, ∃ t ∈ T, w = (φ a).mulVec t}
  have hsc : ∀ (c : ℚ_[ℓ]) (v : Fin r → ℚ_[ℓ]), (Matrix.scalar (Fin r) c).mulVec v = c • v := by
    intro c v
    rw [Matrix.scalar_apply]
    ext i
    simp [Matrix.mulVec_diagonal]
  have hdesc : ∀ i, i ≤ K → ∀ x ∈ Sub (K - i), x ∈ G := by
    intro i
    induction i with
    | zero =>
      intro _ x hx
      rw [Nat.sub_zero, hSubK, Submodule.mem_bot] at hx
      rw [hx]; exact G.zero_mem
    | succ i ih =>
      intro hi x hx
      have hj : K - (i + 1) + 1 = K - i := by omega
      rw [← hS] at hx
      obtain ⟨f, hf⟩ := (Submodule.mem_span_finset).mp hx
      have hf' : ∑ t ∈ S (K - (i + 1)), f t • t = x := by
        first | exact hf | exact hf.2
      rw [← hf']
      apply AddSubgroup.sum_mem
      intro t ht
      have htS : t ∈ Sub (K - (i + 1)) := by
        rw [← hS]; exact Submodule.subset_span ht
      have hdecomp : f t • t = (φ (f t)).mulVec t - (N (f t)).mulVec t := by
        rw [← Matrix.sub_mulVec]
        show _ = (φ (f t) - (φ (f t) - Matrix.scalar (Fin r) (f t))).mulVec t
        rw [sub_sub_cancel, hsc]
      rw [hdecomp]
      apply G.sub_mem
      · apply AddSubgroup.subset_closure
        refine ⟨f t, t, ?_, rfl⟩
        exact Finset.mem_biUnion.mpr ⟨K - (i + 1), Finset.mem_range.mpr (by omega), ht⟩
      · have h1 := hstep (K - (i + 1)) (f t) t htS
        rw [hj] at h1
        exact ih (by omega) _ h1
  have hall : ∀ v : Fin r → ℚ_[ℓ], v ∈ G := by
    intro v
    have h1 := hdesc K le_rfl v
    rw [Nat.sub_self, hSub0] at h1
    exact h1 Submodule.mem_top

  letI : SMul ℚ_[ℓ] V := ⟨fun c x => ρ c x⟩
  letI : Module ℚ_[ℓ] V := Module.ofMinimalAxioms
    (fun c x y => map_add (ρ c) x y) (fun a b x => hρa a b x) (fun a b x => hρm a b x)
    (fun x => hρ1 x)
  have hsmul : ∀ (c : ℚ_[ℓ]) (x : V), c • x = ρ c x := fun _ _ => rfl
  haveI : Module.Finite ℚ_[ℓ] V := by
    rw [Module.finite_def]
    refine ⟨T.image e.symm, ?_⟩
    rw [eq_top_iff]
    intro x _
    have hG : G ≤ (Submodule.span ℚ_[ℓ] ((T.image e.symm : Finset V) : Set V)).toAddSubgroup.comap
        e.symm.toAddMonoidHom := by
      apply (AddSubgroup.closure_le _).mpr
      rintro w ⟨a, t, ht, rfl⟩
      show e.symm ((φ a).mulVec t) ∈ Submodule.span ℚ_[ℓ] _
      have h1 : e.symm ((φ a).mulVec t) = a • e.symm t := by
        apply e.injective
        rw [AddEquiv.apply_symm_apply, hsmul, heφ, AddEquiv.apply_symm_apply]
      rw [h1]
      apply Submodule.smul_mem
      apply Submodule.subset_span
      rw [Finset.coe_image]
      exact Set.mem_image_of_mem _ ht
    have h2 := hG (hall (e x))
    rw [AddSubgroup.mem_comap] at h2
    simpa using h2
  let b := Module.finBasis ℚ_[ℓ] V
  refine ⟨Module.finrank ℚ_[ℓ] V, b.equivFun.toAddEquiv, fun c x => ?_⟩
  show b.equivFun (c • x) = c • b.equivFun x
  exact map_smul b.equivFun c x

theorem wc_ext_gc_findim (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (hG : wcPencilGC K hP ℓ G)
    (τ : ℚ_[ℓ] → (G ⟶ G)) (hτ1 : τ 1 = 𝟙 G) (hτm : ∀ a b, τ (a * b) = τ b ≫ τ a)
    (hτa : ∀ a b, τ (a + b) = τ a + τ b) (j : ℕ) :
    ∃ (r : ℕ) (e : wcCohG K (wcP1Over K) hP G j ≃+ (Fin r → ℚ_[ℓ])),
      ∀ (c : ℚ_[ℓ]) (x : wcCohG K (wcP1Over K) hP G j),
        e (wcCohGEnd K (wcP1Over K) hP G j (τ c) x) = c • e x :=
by
  classical

  haveI : IsProper (wcP1Over K).hom := wc_proj_space_isProper K 1
  haveI : SmoothOfRelativeDimension 1 (wcP1Over K).hom := wc_proj_space_smooth K 1
  haveI : GeometricallyIrreducible (wcP1Over K).hom := wc_P1_geometricallyIrreducible K

  obtain ⟨r₀, e₀, he₀⟩ := wc_coh_finite K (wcP1Over K) 1 ℓ hℓ hP j
  obtain ⟨b, ⟨g⟩⟩ := id hG
  obtain ⟨rW, eW, heW⟩ := wc_contSheaf_finpi_ext_findim (wcP1Over K).left
    (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)) ℓ j
    ⟨r₀, e₀, fun c x => he₀ c x⟩ b

  letI : HasExt (Sheaf ((Scheme.ProEt.topology (wcP1Over K).left).over
      (wcGeomPoint K (wcP1Over K) hP)) AddCommGrpCat.{u+1}) := HasExt.standard _
  obtain ⟨T, hT⟩ := wc_proet_free_slice_ext_natural (wcP1Over K).left
    (wcGeomPoint K (wcP1Over K) hP) j

  have compCompG : ∀ {P A B C' : Sheaf (Scheme.ProEt.topology (wcP1Over K).left)
      AddCommGrpCat.{u+1}} (f : A ⟶ B) (f' : B ⟶ C') (y : Abelian.Ext P A j),
      (y.comp (Abelian.Ext.mk₀ f) (add_zero j)).comp (Abelian.Ext.mk₀ f') (add_zero j) =
        y.comp (Abelian.Ext.mk₀ (f ≫ f')) (add_zero j) := by
    intro P A B C' f f' y
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero j) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀]
  have compCompS : ∀ {P A B C' : Sheaf ((Scheme.ProEt.topology (wcP1Over K).left).over
      (wcGeomPoint K (wcP1Over K) hP)) AddCommGrpCat.{u+1}} (f : A ⟶ B) (f' : B ⟶ C')
      (y : Abelian.Ext P A j),
      (y.comp (Abelian.Ext.mk₀ f) (add_zero j)).comp (Abelian.Ext.mk₀ f') (add_zero j) =
        y.comp (Abelian.Ext.mk₀ (f ≫ f')) (add_zero j) := by
    intro P A B C' f f' y
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero j) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀]

  let Φ := (Scheme.ProEt.topology (wcP1Over K).left).overPullback
      AddCommGrpCat.{u+1} (wcGeomPoint K (wcP1Over K) hP)
  let θ := fun c : ℚ_[ℓ] => g.inv ≫ Φ.map (τ c) ≫ g.hom
  have hθ : ∀ c, g.hom ≫ θ c = Φ.map (τ c) ≫ g.hom :=
    fun c => Iso.hom_inv_id_assoc g _

  let Ψ₁ : Abelian.Ext ((presheafToSheaf ((Scheme.ProEt.topology (wcP1Over K).left).over
          (wcGeomPoint K (wcP1Over K) hP)) AddCommGrpCat.{u+1}).obj
          (yoneda.obj (Over.mk (𝟙 (wcGeomPoint K (wcP1Over K) hP))) ⋙ uliftFunctor.{u+1, u} ⋙
            AddCommGrpCat.free)) (Φ.obj G) j ≃+
      Abelian.Ext ((presheafToSheaf ((Scheme.ProEt.topology (wcP1Over K).left).over
          (wcGeomPoint K (wcP1Over K) hP)) AddCommGrpCat.{u+1}).obj
          (yoneda.obj (Over.mk (𝟙 (wcGeomPoint K (wcP1Over K) hP))) ⋙ uliftFunctor.{u+1, u} ⋙
            AddCommGrpCat.free)) (Φ.obj (wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ]))) j :=
    { toFun := fun y => y.comp (Abelian.Ext.mk₀ g.hom) (add_zero j)
      invFun := fun y => y.comp (Abelian.Ext.mk₀ g.inv) (add_zero j)
      left_inv := fun y => by
        change (y.comp (Abelian.Ext.mk₀ g.hom) (add_zero j)).comp (Abelian.Ext.mk₀ g.inv)
          (add_zero j) = y
        rw [compCompS, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
      right_inv := fun y => by
        change (y.comp (Abelian.Ext.mk₀ g.inv) (add_zero j)).comp (Abelian.Ext.mk₀ g.hom)
          (add_zero j) = y
        rw [compCompS, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
      map_add' := fun a b => by
        change (a + b).comp (Abelian.Ext.mk₀ g.hom) (add_zero j) =
          a.comp (Abelian.Ext.mk₀ g.hom) (add_zero j) + b.comp (Abelian.Ext.mk₀ g.hom) (add_zero j)
        rw [Abelian.Ext.add_comp] }
  have hΨ₁ : ∀ y, Ψ₁ y = y.comp (Abelian.Ext.mk₀ g.hom) (add_zero j) := fun _ => rfl
  let Ψ := (T G).trans Ψ₁
  have hΨ : ∀ (c : ℚ_[ℓ]) (x : wcCohG K (wcP1Over K) hP G j),
      Ψ (wcCohGEnd K (wcP1Over K) hP G j (τ c) x) =
        (Ψ x).comp (Abelian.Ext.mk₀ (θ c)) (add_zero j) := by
    intro c x
    change Ψ₁ (T G (x.comp (Abelian.Ext.mk₀ (τ c)) (add_zero j))) =
      (Ψ₁ (T G x)).comp (Abelian.Ext.mk₀ (θ c)) (add_zero j)
    rw [hΨ₁, hΨ₁, hT G G (τ c) x, compCompS, compCompS, hθ c]

  let σW : ℚ_[ℓ] → (wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ]) ⟶
      wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])) := fun d =>
    wcConstScalar (wcP1Over K).left ℓ b d
  let σN := fun d : ℚ_[ℓ] =>
    (Abelian.Ext.mk₀ (Φ.map (σW d))).postcomp
      ((presheafToSheaf ((Scheme.ProEt.topology (wcP1Over K).left).over
          (wcGeomPoint K (wcP1Over K) hP)) AddCommGrpCat.{u+1}).obj
          (yoneda.obj (Over.mk (𝟙 (wcGeomPoint K (wcP1Over K) hP))) ⋙ uliftFunctor.{u+1, u} ⋙
            AddCommGrpCat.free)) (add_zero j)
  have hσN : ∀ d y, σN d y = y.comp (Abelian.Ext.mk₀ (Φ.map (σW d))) (add_zero j) :=
    fun _ _ => rfl
  let σG : ℚ_[ℓ] → (wcCohG K (wcP1Over K) hP G j →+ wcCohG K (wcP1Over K) hP G j) := fun d =>
    Ψ.symm.toAddMonoidHom.comp ((σN d).comp Ψ.toAddMonoidHom)
  have hσG : ∀ (d : ℚ_[ℓ]) (x : wcCohG K (wcP1Over K) hP G j), σG d x = Ψ.symm (σN d (Ψ x)) :=
    fun _ _ => rfl

  have hσ : ∀ (d : ℚ_[ℓ]) (x : wcCohG K (wcP1Over K) hP G j),
      (Ψ.trans ((T (wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ]))).symm.trans eW)) (σG d x) =
        d • (Ψ.trans ((T (wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ]))).symm.trans eW)) x := by
    intro d x
    simp only [AddEquiv.trans_apply]
    rw [hσG, AddEquiv.apply_symm_apply, hσN]
    have h := hT (wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ]))
      (wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])) (σW d)
      ((T (wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ]))).symm (Ψ x))
    rw [AddEquiv.apply_symm_apply] at h
    rw [← h, AddEquiv.symm_apply_apply]
    exact heW d _

  have h1 : ∀ x : wcCohG K (wcP1Over K) hP G j, wcCohGEnd K (wcP1Over K) hP G j (τ 1) x = x := by
    intro x
    change x.comp (Abelian.Ext.mk₀ (τ 1)) (add_zero j) = x
    rw [hτ1]
    exact Abelian.Ext.comp_mk₀_id x
  have hm : ∀ (a b' : ℚ_[ℓ]) (x : wcCohG K (wcP1Over K) hP G j),
      wcCohGEnd K (wcP1Over K) hP G j (τ (a * b')) x =
        wcCohGEnd K (wcP1Over K) hP G j (τ a) (wcCohGEnd K (wcP1Over K) hP G j (τ b') x) := by
    intro a b' x
    change x.comp (Abelian.Ext.mk₀ (τ (a * b'))) (add_zero j) =
      (x.comp (Abelian.Ext.mk₀ (τ b')) (add_zero j)).comp (Abelian.Ext.mk₀ (τ a)) (add_zero j)
    rw [compCompG, hτm]
  have ha : ∀ (a b' : ℚ_[ℓ]) (x : wcCohG K (wcP1Over K) hP G j),
      wcCohGEnd K (wcP1Over K) hP G j (τ (a + b')) x =
        wcCohGEnd K (wcP1Over K) hP G j (τ a) x + wcCohGEnd K (wcP1Over K) hP G j (τ b') x := by
    intro a b' x
    change x.comp (Abelian.Ext.mk₀ (τ (a + b'))) (add_zero j) =
      x.comp (Abelian.Ext.mk₀ (τ a)) (add_zero j) + x.comp (Abelian.Ext.mk₀ (τ b')) (add_zero j)
    rw [hτa, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add]

  have hcommθ : ∀ c d : ℚ_[ℓ], θ c ≫ Φ.map (σW d) = Φ.map (σW d) ≫ θ c := fun c d =>
    wc_contSheaf_over_endo_commutes_smul (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP) ℓ b
      (θ c) d
  have hcomm : ∀ (c d : ℚ_[ℓ]) (x : wcCohG K (wcP1Over K) hP G j),
      wcCohGEnd K (wcP1Over K) hP G j (τ c) (σG d x) =
        σG d (wcCohGEnd K (wcP1Over K) hP G j (τ c) x) := by
    intro c d x
    apply Ψ.injective
    rw [hΨ, hσG, hσG, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply, hσN, hσN, hΨ,
      compCompS, compCompS, hcommθ c d]

  obtain ⟨r', e', he'⟩ := wc_ring_action_findim_of_commuting ℓ σG
    (fun c => wcCohGEnd K (wcP1Over K) hP G j (τ c)) rW
    (Ψ.trans ((T (wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ]))).symm.trans eW))
    hσ h1 hm ha hcomm
  exact ⟨r', e', he'⟩

theorem wc_pencil_VQ_H1_finite_of_gc (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hEC : wcPencilGC F'' hP ℓ (Subobject.underlying.obj (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP)))
    (hcok : wcPencilGC F'' hP ℓ (Limits.cokernel (wcPencilE D ℓ hP).arrow) ∨
      Limits.IsZero (Limits.cokernel (wcPencilE D ℓ hP).arrow))
    (hVQs : ∀ c : ℚ_[ℓ], ∃ ψ : Subobject.underlying.obj (wcPencilE D ℓ hP) ⟶
        Subobject.underlying.obj (wcPencilE D ℓ hP),
      ψ ≫ (wcPencilE D ℓ hP).arrow = (wcPencilE D ℓ hP).arrow ≫ wcRqScalar D.f ℓ (n - 1) c ∧
      Limits.cokernel.π (Subobject.ofLE (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP) (wcPencilE D ℓ hP)
          inf_le_left) ≫ wcPencilVQScalar D ℓ hP c =
        ψ ≫ Limits.cokernel.π (Subobject.ofLE (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP)
          (wcPencilE D ℓ hP) inf_le_left))
    (r : ℕ) (e : wcCohG F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - 1)) 1 ≃+ (Fin r → ℚ_[ℓ]))
    (he : ∀ (c : ℚ_[ℓ]) (x : wcCohG F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - 1)) 1),
      e (wcCohGEnd F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - 1)) 1 (wcRqScalar D.f ℓ (n - 1) c) x) =
        c • e x) :
    ∃ (r' : ℕ) (e' : wcCohG F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 ≃+ (Fin r' → ℚ_[ℓ])),
      ∀ (c : ℚ_[ℓ]) (x : wcCohG F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1),
        e' (wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c) x) =
          c • e' x :=
by
  classical
  set E := wcPencilE D ℓ hP with hEdef
  set C := wcPencilC D ℓ hP with hCdef
  set ι := Subobject.ofLE (E ⊓ C) E inf_le_left with hιdef
  choose ψ hψ1 hψ2 using hVQs

  have radd : ∀ {X Y : Sheaf (Scheme.ProEt.topology D.Yt.left) AddCommGrpCat.{u+1}}
      (f g : X ⟶ Y),
      ((wcProEtPush D.f).rightDerived (n - 1)).map (f + g) =
        ((wcProEtPush D.f).rightDerived (n - 1)).map f +
          ((wcProEtPush D.f).rightDerived (n - 1)).map g := by
    intro X Y f g
    have ha := InjectiveResolution.desc_commutes f (injectiveResolution Y) (injectiveResolution X)
    have hb := InjectiveResolution.desc_commutes g (injectiveResolution Y) (injectiveResolution X)
    have hab : (injectiveResolution X).ι ≫
        (InjectiveResolution.desc f (injectiveResolution Y) (injectiveResolution X) +
          InjectiveResolution.desc g (injectiveResolution Y) (injectiveResolution X)) =
        (CochainComplex.single₀ _).map (f + g) ≫ (injectiveResolution Y).ι := by
      rw [Preadditive.comp_add, ha, hb, Functor.map_add, Preadditive.add_comp]
    rw [(wcProEtPush D.f).rightDerived_map_eq (n - 1) (f + g) _ hab,
      (wcProEtPush D.f).rightDerived_map_eq (n - 1) f _ ha,
      (wcProEtPush D.f).rightDerived_map_eq (n - 1) g _ hb, Functor.map_add,
      Preadditive.add_comp, Preadditive.comp_add]

  have keyL : ∀ (c : ℚ_[ℓ]) (U : (D.Yt.left.ProEt)ᵒᵖ)
      (x : ((wcLadicSheaf D.Yt.left ℓ).obj.obj U : Type (u+1))),
      (wcLadicScalar D.Yt.left ℓ c).hom.app U x =
        (ULift.up (c • (ULift.down x : C(↥((Scheme.ProEt.forget D.Yt.left ⋙
          Over.forget D.Yt.left).obj (Opposite.unop U)), ℚ_[ℓ]))) : _) := by
    intro c U x
    rfl
  have hL1 : wcLadicScalar D.Yt.left ℓ 1 = 𝟙 _ := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [keyL]
    apply ULift.ext
    exact one_smul _ _
  have hLm : ∀ a b : ℚ_[ℓ], wcLadicScalar D.Yt.left ℓ (a * b) =
      wcLadicScalar D.Yt.left ℓ b ≫ wcLadicScalar D.Yt.left ℓ a := by
    intro a b
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply,
      keyL, keyL, keyL]
    apply ULift.ext
    exact mul_smul _ _ _
  have hLa : ∀ a b : ℚ_[ℓ], wcLadicScalar D.Yt.left ℓ (a + b) =
      wcLadicScalar D.Yt.left ℓ a + wcLadicScalar D.Yt.left ℓ b := by
    intro a b
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [Sheaf.Hom.add_app, AddCommGrpCat.hom_add_apply, keyL, keyL, keyL]
    apply ULift.ext
    exact add_smul _ _ _
  have hsR1 : wcRqScalar D.f ℓ (n - 1) 1 = 𝟙 _ := by
    have h : ((wcProEtPush D.f).rightDerived (n - 1)).map (wcLadicScalar D.Yt.left ℓ 1) =
        ((wcProEtPush D.f).rightDerived (n - 1)).map (𝟙 (wcLadicSheaf D.Yt.left ℓ)) := by
      rw [hL1]
    rw [CategoryTheory.Functor.map_id] at h
    exact h
  have hsRm : ∀ a b : ℚ_[ℓ], wcRqScalar D.f ℓ (n - 1) (a * b) =
      wcRqScalar D.f ℓ (n - 1) b ≫ wcRqScalar D.f ℓ (n - 1) a := by
    intro a b
    have h : ((wcProEtPush D.f).rightDerived (n - 1)).map (wcLadicScalar D.Yt.left ℓ (a * b)) =
        ((wcProEtPush D.f).rightDerived (n - 1)).map
          (wcLadicScalar D.Yt.left ℓ b ≫ wcLadicScalar D.Yt.left ℓ a) := by
      rw [hLm]
    rw [CategoryTheory.Functor.map_comp] at h
    exact h
  have hsRa : ∀ a b : ℚ_[ℓ], wcRqScalar D.f ℓ (n - 1) (a + b) =
      wcRqScalar D.f ℓ (n - 1) a + wcRqScalar D.f ℓ (n - 1) b := by
    intro a b
    have h : ((wcProEtPush D.f).rightDerived (n - 1)).map (wcLadicScalar D.Yt.left ℓ (a + b)) =
        ((wcProEtPush D.f).rightDerived (n - 1)).map
          (wcLadicScalar D.Yt.left ℓ a + wcLadicScalar D.Yt.left ℓ b) := by
      rw [hLa]
    rw [radd] at h
    exact h

  have monoRing : ∀ {A B : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      (m : A ⟶ B) [Mono m] (s : ℚ_[ℓ] → (A ⟶ A)) (t : ℚ_[ℓ] → (B ⟶ B)),
      (∀ c, s c ≫ m = m ≫ t c) → t 1 = 𝟙 B → (∀ a b, t (a * b) = t b ≫ t a) →
      (∀ a b, t (a + b) = t a + t b) →
      s 1 = 𝟙 A ∧ (∀ a b, s (a * b) = s b ≫ s a) ∧ (∀ a b, s (a + b) = s a + s b) := by
    intro A B m _ s t hst ht1 htm hta
    refine ⟨?_, ?_, ?_⟩
    · rw [← cancel_mono m, hst, ht1, Category.comp_id, Category.id_comp]
    · intro a b
      rw [← cancel_mono m]
      calc s (a * b) ≫ m = m ≫ t (a * b) := hst _
        _ = (m ≫ t b) ≫ t a := by rw [htm, Category.assoc]
        _ = (s b ≫ m) ≫ t a := by rw [hst]
        _ = s b ≫ (m ≫ t a) := Category.assoc _ _ _
        _ = s b ≫ (s a ≫ m) := by rw [hst]
        _ = (s b ≫ s a) ≫ m := (Category.assoc _ _ _).symm
    · intro a b
      rw [← cancel_mono m]
      simp only [Preadditive.add_comp, Preadditive.comp_add, hst, hta]
  have epiRing : ∀ {A B : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      (p : A ⟶ B) [Epi p] (s : ℚ_[ℓ] → (A ⟶ A)) (t : ℚ_[ℓ] → (B ⟶ B)),
      (∀ c, p ≫ t c = s c ≫ p) → s 1 = 𝟙 A → (∀ a b, s (a * b) = s b ≫ s a) →
      (∀ a b, s (a + b) = s a + s b) →
      t 1 = 𝟙 B ∧ (∀ a b, t (a * b) = t b ≫ t a) ∧ (∀ a b, t (a + b) = t a + t b) := by
    intro A B p _ s t hst hs1 hsm hsa
    refine ⟨?_, ?_, ?_⟩
    · rw [← cancel_epi p, hst, hs1, Category.comp_id, Category.id_comp]
    · intro a b
      rw [← cancel_epi p]
      calc p ≫ t (a * b) = s (a * b) ≫ p := hst _
        _ = (s b ≫ s a) ≫ p := by rw [hsm]
        _ = s b ≫ (s a ≫ p) := Category.assoc _ _ _
        _ = s b ≫ (p ≫ t a) := by rw [hst]
        _ = (s b ≫ p) ≫ t a := (Category.assoc _ _ _).symm
        _ = (p ≫ t b) ≫ t a := by rw [hst]
        _ = p ≫ (t b ≫ t a) := Category.assoc _ _ _
    · intro a b
      rw [← cancel_epi p]
      simp only [Preadditive.add_comp, Preadditive.comp_add, hst, hsa]

  obtain ⟨hψ1', hψm, hψa⟩ := monoRing E.arrow ψ (wcRqScalar D.f ℓ (n - 1)) hψ1 hsR1 hsRm hsRa

  obtain ⟨φ, hφdef⟩ : ∃ φ : ℚ_[ℓ] → (Limits.cokernel ι ⟶ Limits.cokernel ι),
      φ = fun c => wcPencilVQScalar D ℓ hP c := ⟨_, rfl⟩
  have hψ2' : ∀ c, Limits.cokernel.π ι ≫ φ c = ψ c ≫ Limits.cokernel.π ι := by
    intro c
    rw [hφdef]
    exact hψ2 c
  obtain ⟨hφ1, hφm, hφa⟩ := epiRing (Limits.cokernel.π ι) ψ φ hψ2' hψ1' hψm hψa

  have hκz : ∀ c, E.arrow ≫ wcRqScalar D.f ℓ (n - 1) c ≫ Limits.cokernel.π E.arrow = 0 := by
    intro c
    rw [← Category.assoc, ← hψ1 c, Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
  let κ : ℚ_[ℓ] → (Limits.cokernel E.arrow ⟶ Limits.cokernel E.arrow) := fun c =>
    Limits.cokernel.desc E.arrow (wcRqScalar D.f ℓ (n - 1) c ≫ Limits.cokernel.π E.arrow) (hκz c)
  have hκ : ∀ c, Limits.cokernel.π E.arrow ≫ κ c =
      wcRqScalar D.f ℓ (n - 1) c ≫ Limits.cokernel.π E.arrow := fun c =>
    Limits.cokernel.π_desc _ _ _
  obtain ⟨hκ1, hκm, hκa⟩ :=
    epiRing (Limits.cokernel.π E.arrow) (wcRqScalar D.f ℓ (n - 1)) κ hκ hsR1 hsRm hsRa

  haveI hιm : Mono ι := mono_of_mono_fac (Subobject.ofLE_arrow (X := E ⊓ C) (Y := E) inf_le_left)
  have hS₂ : (ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) hιm
      (show Epi (Limits.cokernel.π ι) from inferInstance)
  haveI : Mono (ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)).f := hιm
  have hχz : ∀ c, (ι ≫ ψ c) ≫ Limits.cokernel.π ι = 0 := by
    intro c
    rw [Category.assoc, ← hψ2' c, ← Category.assoc, Limits.cokernel.condition, Limits.zero_comp]
  let χ : ℚ_[ℓ] → (Subobject.underlying.obj (E ⊓ C) ⟶ Subobject.underlying.obj (E ⊓ C)) :=
    fun c => hS₂.exact.lift (ι ≫ ψ c) (hχz c)
  have hχ : ∀ c, χ c ≫ ι = ι ≫ ψ c := fun c => hS₂.exact.lift_f _ _
  obtain ⟨hχ1, hχm, hχa⟩ := monoRing ι χ ψ hχ hψ1' hψm hψa

  have h0 : ∃ (r0 : ℕ) (e0 : wcCohG F'' (wcP1Over F'') hP (Limits.cokernel E.arrow) 0 ≃+
      (Fin r0 → ℚ_[ℓ])),
      ∀ (c : ℚ_[ℓ]) (x : wcCohG F'' (wcP1Over F'') hP (Limits.cokernel E.arrow) 0),
        e0 (wcCohGEnd F'' (wcP1Over F'') hP (Limits.cokernel E.arrow) 0 (κ c) x) = c • e0 x := by
    rcases hcok with hgc | hz
    · exact wc_ext_gc_findim F'' hP ℓ hℓ _ hgc κ hκ1 hκm hκa 0
    · have hall : ∀ x : wcCohG F'' (wcP1Over F'') hP (Limits.cokernel E.arrow) 0, x = 0 := by
        intro x
        calc x = Abelian.Ext.comp x (Abelian.Ext.mk₀ (𝟙 _)) (add_zero 0) :=
              (Abelian.Ext.comp_mk₀_id x).symm
          _ = Abelian.Ext.comp x (Abelian.Ext.mk₀ 0) (add_zero 0) := by
              rw [hz.eq_of_src (𝟙 _) 0]
          _ = 0 := by rw [Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
      refine ⟨0, AddEquiv.ofBijective
        (0 : wcCohG F'' (wcP1Over F'') hP (Limits.cokernel E.arrow) 0 →+ (Fin 0 → ℚ_[ℓ]))
        ⟨fun a b _ => (hall a).trans (hall b).symm, fun y => ⟨0, Subsingleton.elim _ _⟩⟩, ?_⟩
      intro c x
      exact Subsingleton.elim _ _
  obtain ⟨r0, e0, he0⟩ := h0

  obtain ⟨r2, e2, he2⟩ := wc_ext_gc_findim F'' hP ℓ hℓ _ hEC χ hχ1 hχm hχa 2

  have hS₁ : (ShortComplex.mk E.arrow (Limits.cokernel.π E.arrow)
      (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _)
      (show Mono E.arrow from inferInstance)
      (show Epi (Limits.cokernel.π E.arrow) from inferInstance)
  obtain ⟨r1, e1, he1⟩ := (wc_ext_ses_findim ℓ
      (wcFreeSheaf (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP)) _ hS₁
      ψ (wcRqScalar D.f ℓ (n - 1)) κ hψ1' hψm hψa hsR1 hsRm hsRa hκ1 hκm hκa
      hψ1 (fun c => (hκ c).symm) 0 1 rfl).1
    ⟨r0, e0, fun c x => he0 c x⟩ ⟨r, e, fun c x => he c x⟩

  obtain ⟨r', e', he'⟩ := (wc_ext_ses_findim ℓ
      (wcFreeSheaf (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP)) _ hS₂
      χ ψ φ hχ1 hχm hχa hψ1' hψm hψa hφ1 hφm hφa hχ (fun c => (hψ2' c).symm) 1 2 rfl).2
    ⟨r1, e1, he1⟩ ⟨r2, e2, fun c x => he2 c x⟩
  subst hφdef
  exact ⟨r', e', fun c x => he' c x⟩

theorem wc_pencil_H1_devissage (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (α : AlgebraicClosure ℚ_[ℓ])
    (hα : wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - 1)) 1 (wcRqScalar D.f ℓ (n - 1) c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - 1)) 1) α) :
    (∃ k : ℕ, 1 ≤ k ∧ α ^ (2 * k) =
      algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ (n * k))) ∨
    wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) α :=
by
  classical


  have transfer : ∀ {V W V' : Type (u+1)} [AddCommGroup V] [AddCommGroup W] [AddCommGroup V']
      (sV : ℚ_[ℓ] → V →+ V) (sW : ℚ_[ℓ] → W →+ W) (sV' : ℚ_[ℓ] → V' →+ V')
      (ΦV : V →+ V) (ΦW : W →+ W) (ΦV' : V' →+ V')
      (hV : ∀ (c : ℚ_[ℓ]) (x : V), ΦV (sV c x) = sV c (ΦV x))
      (hV' : ∀ (c : ℚ_[ℓ]) (x : V'), ΦV' (sV' c x) = sV' c (ΦV' x))
      (p : W →+ V) (hp : Function.Surjective p)
      (hps : ∀ (c : ℚ_[ℓ]) (x : W), p (sW c x) = sV c (p x))
      (hpΦ : ∀ x : W, p (ΦW x) = ΦV (p x))
      (i : W →+ V') (hi : Function.Injective i)
      (his : ∀ (c : ℚ_[ℓ]) (x : W), i (sW c x) = sV' c (i x))
      (hiΦ : ∀ x : W, i (ΦW x) = ΦV' (i x))
      (α : AlgebraicClosure ℚ_[ℓ]) (hα : wcIsEigen ℓ sV ΦV α)
      (r' : ℕ) (e' : V' ≃+ (Fin r' → ℚ_[ℓ]))
      (he' : ∀ (c : ℚ_[ℓ]) (x : V'), e' (sV' c x) = c • e' x),
      α ∈ (wcAddEquivMatrix e' ΦV').charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) := by
    intro V W V' _ _ _ sV sW sV' ΦV ΦW ΦV' hV hV' p hp hps hpΦ i hi his hiΦ α hα r' e' he'
    obtain ⟨r, e, he, hroot⟩ := hα
    obtain ⟨x, hx0, hGx⟩ := (wc_minpoly_eval_criterion ℓ sV ΦV hV r e he α).1 hroot
    by_contra hnot
    obtain ⟨hinj, hsurj⟩ := (wc_minpoly_eval_criterion ℓ sV' ΦV' hV' r' e' he' α).2 hnot
    have hpit : ∀ (j : ℕ) (w : W), p ((⇑ΦW)^[j] w) = (⇑ΦV)^[j] (p w) := by
      intro j
      induction j with
      | zero => intro w; rfl
      | succ j ih =>
        intro w
        rw [Function.iterate_succ_apply', Function.iterate_succ_apply', hpΦ, ih]
    have hiit : ∀ (j : ℕ) (w : W), i ((⇑ΦW)^[j] w) = (⇑ΦV')^[j] (i w) := by
      intro j
      induction j with
      | zero => intro w; rfl
      | succ j ih =>
        intro w
        rw [Function.iterate_succ_apply', Function.iterate_succ_apply', hiΦ, ih]
    have itsub : ∀ (j : ℕ) (a b : V'), (⇑ΦV')^[j] (a - b) = (⇑ΦV')^[j] a - (⇑ΦV')^[j] b := by
      intro j
      induction j with
      | zero => intro a b; rfl
      | succ j ih =>
        intro a b
        rw [Function.iterate_succ_apply', Function.iterate_succ_apply',
          Function.iterate_succ_apply', ih, map_sub]
    obtain ⟨w, hw⟩ := hp x
    have hGw : p (∑ j ∈ Finset.range ((minpoly ℚ_[ℓ] α).natDegree + 1),
        sW ((minpoly ℚ_[ℓ] α).coeff j) ((⇑ΦW)^[j] w)) = 0 := by
      rw [map_sum, ← hGx, ← hw]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [hps, hpit]
    have hiG : i (∑ j ∈ Finset.range ((minpoly ℚ_[ℓ] α).natDegree + 1),
        sW ((minpoly ℚ_[ℓ] α).coeff j) ((⇑ΦW)^[j] w)) =
        ∑ j ∈ Finset.range ((minpoly ℚ_[ℓ] α).natDegree + 1),
          sV' ((minpoly ℚ_[ℓ] α).coeff j) ((⇑ΦV')^[j] (i w)) := by
      rw [map_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [his, hiit]
    have hMs : ∀ (c : ℚ_[ℓ]), ∀ y ∈ (p.ker).map i, sV' c y ∈ (p.ker).map i := by
      intro c y hy
      obtain ⟨k, hk, rfl⟩ := AddSubgroup.mem_map.mp hy
      refine AddSubgroup.mem_map.mpr ⟨sW c k, ?_, his c k⟩
      rw [AddMonoidHom.mem_ker] at hk ⊢
      rw [hps, hk, map_zero]
    have hMΦ : ∀ y ∈ (p.ker).map i, ΦV' y ∈ (p.ker).map i := by
      intro y hy
      obtain ⟨k, hk, rfl⟩ := AddSubgroup.mem_map.mp hy
      refine AddSubgroup.mem_map.mpr ⟨ΦW k, ?_, hiΦ k⟩
      rw [AddMonoidHom.mem_ker] at hk ⊢
      rw [hpΦ, hk, map_zero]
    obtain ⟨z, hzM, hz⟩ := hsurj ((p.ker).map i) hMs hMΦ _
      (AddSubgroup.mem_map.mpr ⟨_, (AddMonoidHom.mem_ker).mpr hGw, rfl⟩)
    obtain ⟨k, hk, rfl⟩ := AddSubgroup.mem_map.mp hzM
    have hdiff : ∑ j ∈ Finset.range ((minpoly ℚ_[ℓ] α).natDegree + 1),
        sV' ((minpoly ℚ_[ℓ] α).coeff j) ((⇑ΦV')^[j] (i k - i w)) = 0 := by
      simp only [itsub, map_sub, Finset.sum_sub_distrib]
      rw [hz, hiG, sub_self]
    have hkw : k = w := hi (sub_eq_zero.mp (hinj _ hdiff))
    rw [AddMonoidHom.mem_ker, hkw, hw] at hk
    exact hx0 hk

  have topStable : wcPencilStable D ℓ (⊤ : Subobject (wcRq D.f ℓ (n - 1))) := by
    intro c
    haveI := Subobject.isIso_top_arrow (Y := wcRq D.f ℓ (n - 1))
    exact ⟨(⊤ : Subobject (wcRq D.f ℓ (n - 1))).arrow ≫ wcRqScalar D.f ℓ (n - 1) c ≫
      inv (⊤ : Subobject (wcRq D.f ℓ (n - 1))).arrow, by simp⟩
  have hEprop : wcPencilStable D ℓ (wcPencilE D ℓ hP) ∧
      (wcPencilGC F'' hP ℓ (Limits.cokernel (wcPencilE D ℓ hP).arrow) ∨
        Limits.IsZero (Limits.cokernel (wcPencilE D ℓ hP).arrow)) := by
    by_cases h : ∃ M : Subobject (wcRq D.f ℓ (n - 1)), wcPencilStable D ℓ M ∧
        wcPencilGC F'' hP ℓ (Limits.cokernel M.arrow) ∧
        ∀ M' : Subobject (wcRq D.f ℓ (n - 1)), wcPencilStable D ℓ M' →
          wcPencilGC F'' hP ℓ (Limits.cokernel M'.arrow) → M ≤ M'
    · have hE : wcPencilE D ℓ hP = Classical.choose h := dif_pos h
      rw [hE]
      exact ⟨(Classical.choose_spec h).1, Or.inl (Classical.choose_spec h).2.1⟩
    · have hE : wcPencilE D ℓ hP = ⊤ := dif_neg h
      rw [hE]
      haveI := Subobject.isIso_top_arrow (Y := wcRq D.f ℓ (n - 1))
      exact ⟨topStable, Or.inr (Limits.isZero_cokernel_of_epi _)⟩

  have hcokH1 : ∀ x : wcCohG F'' (wcP1Over F'') hP (Limits.cokernel (wcPencilE D ℓ hP).arrow) 1,
      x = 0 := by
    intro x
    rcases hEprop.2 with hgc | hz
    · exact wc_P1_H1_geomConst_vanish F'' hP ℓ hℓ _ hgc x
    · calc x = Abelian.Ext.comp x (Abelian.Ext.mk₀ (𝟙 _)) (add_zero 1) :=
            (Abelian.Ext.comp_mk₀_id x).symm
        _ = Abelian.Ext.comp x (Abelian.Ext.mk₀ 0) (add_zero 1) := by
            rw [hz.eq_of_src (𝟙 _) 0]
        _ = 0 := by rw [Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]

  have hEC := wc_pencil_EC_geomConst F' F'' Y n hn hn2 D ℓ hℓ hP
  have hI1 : ∀ x : wcCohG F'' (wcP1Over F'') hP
      (Subobject.underlying.obj (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP)) 1, x = 0 :=
    wc_P1_H1_geomConst_vanish F'' hP ℓ hℓ _ hEC
  have hCstab : wcPencilStable D ℓ (wcPencilC D ℓ hP) := by
    by_cases h : ∃ M : Subobject (wcRq D.f ℓ (n - 1)), wcPencilStable D ℓ M ∧
        wcPencilGC F'' hP ℓ (Subobject.underlying.obj M) ∧
        ∀ M' : Subobject (wcRq D.f ℓ (n - 1)), wcPencilStable D ℓ M' →
          wcPencilGC F'' hP ℓ (Subobject.underlying.obj M') → M' ≤ M
    · have hC : wcPencilC D ℓ hP = Classical.choose h := dif_pos h
      rw [hC]
      exact (Classical.choose_spec h).1
    · have hC : wcPencilC D ℓ hP = ⊤ := dif_neg h
      rw [hC]
      exact topStable

  have frobComm : ∀ (G G' : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1})
      (f : G ⟶ G') (x : wcCohG F'' (wcP1Over F'') hP G 1),
      wcCohGFrob F'' (wcP1Over F'') hP G' 1 (Abelian.Ext.comp x (Abelian.Ext.mk₀ f) (add_zero 1)) =
        Abelian.Ext.comp (wcCohGFrob F'' (wcP1Over F'') hP G 1 x) (Abelian.Ext.mk₀ f)
          (add_zero 1) := by
    intro G G' f x
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add 1) (add_zero 1) (by omega)).symm
  have compComp : ∀ {G G' G'' : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left)
      AddCommGrpCat.{u+1}} (f : G ⟶ G') (g : G' ⟶ G'') (x : wcCohG F'' (wcP1Over F'') hP G 1),
      Abelian.Ext.comp (Abelian.Ext.comp x (Abelian.Ext.mk₀ f) (add_zero 1))
          (Abelian.Ext.mk₀ g) (add_zero 1) =
        Abelian.Ext.comp x (Abelian.Ext.mk₀ (f ≫ g)) (add_zero 1) := by
    intro G G' G'' f g x
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀]

  have hVQ : ∀ c : ℚ_[ℓ], ∃ ψ : Subobject.underlying.obj (wcPencilE D ℓ hP) ⟶
        Subobject.underlying.obj (wcPencilE D ℓ hP),
      ψ ≫ (wcPencilE D ℓ hP).arrow = (wcPencilE D ℓ hP).arrow ≫ wcRqScalar D.f ℓ (n - 1) c ∧
      Limits.cokernel.π (Subobject.ofLE (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP) (wcPencilE D ℓ hP)
          inf_le_left) ≫ wcPencilVQScalar D ℓ hP c =
        ψ ≫ Limits.cokernel.π (Subobject.ofLE (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP)
          (wcPencilE D ℓ hP) inf_le_left) := by
    intro c
    set E := wcPencilE D ℓ hP with hEdef
    set C := wcPencilC D ℓ hP with hCdef
    have hc : ∃ (ψ : Subobject.underlying.obj E ⟶ Subobject.underlying.obj E)
        (φ : wcPencilVQ D ℓ hP ⟶ wcPencilVQ D ℓ hP),
        ψ ≫ E.arrow = E.arrow ≫ wcRqScalar D.f ℓ (n - 1) c ∧
        Limits.cokernel.π (Subobject.ofLE (E ⊓ C) E inf_le_left) ≫ φ =
          ψ ≫ Limits.cokernel.π (Subobject.ofLE (E ⊓ C) E inf_le_left) := by
      obtain ⟨ψ, hψ⟩ := hEprop.1 c
      obtain ⟨ψC, hψC⟩ := hCstab c
      have e1 : (E ⊓ C).arrow ≫ wcRqScalar D.f ℓ (n - 1) c =
          (Subobject.ofLE (E ⊓ C) E inf_le_left ≫ ψ) ≫ E.arrow := by
        rw [Category.assoc, hψ, ← Category.assoc, Subobject.ofLE_arrow]
      have e2 : (E ⊓ C).arrow ≫ wcRqScalar D.f ℓ (n - 1) c =
          (Subobject.ofLE (E ⊓ C) C inf_le_right ≫ ψC) ≫ C.arrow := by
        rw [Category.assoc, hψC, ← Category.assoc, Subobject.ofLE_arrow]
      have hfac : (E ⊓ C).Factors ((E ⊓ C).arrow ≫ wcRqScalar D.f ℓ (n - 1) c) := by
        refine (Subobject.inf_factors _).mpr ⟨?_, ?_⟩
        · rw [e1]; exact Subobject.factors_comp_arrow _
        · rw [e2]; exact Subobject.factors_comp_arrow _
      have hκ : (E ⊓ C).factorThru ((E ⊓ C).arrow ≫ wcRqScalar D.f ℓ (n - 1) c) hfac ≫
          Subobject.ofLE (E ⊓ C) E inf_le_left = Subobject.ofLE (E ⊓ C) E inf_le_left ≫ ψ := by
        rw [← cancel_mono E.arrow, Category.assoc, Subobject.ofLE_arrow,
          Subobject.factorThru_arrow, e1]
      have hz : Subobject.ofLE (E ⊓ C) E inf_le_left ≫ ψ ≫
          Limits.cokernel.π (Subobject.ofLE (E ⊓ C) E inf_le_left) = 0 := by
        rw [← Category.assoc, ← hκ, Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
      exact ⟨ψ, Limits.cokernel.desc (Subobject.ofLE (E ⊓ C) E inf_le_left)
        (ψ ≫ Limits.cokernel.π (Subobject.ofLE (E ⊓ C) E inf_le_left)) hz, hψ,
        Limits.cokernel.π_desc _ _ _⟩
    refine ⟨Classical.choose hc, (Classical.choose_spec (Classical.choose_spec hc)).1, ?_⟩
    have hdef : wcPencilVQScalar D ℓ hP c = Classical.choose (Classical.choose_spec hc) :=
      dif_pos hc
    rw [hdef]
    exact (Classical.choose_spec (Classical.choose_spec hc)).2

  obtain ⟨r, e, he, _⟩ := id hα
  obtain ⟨r', e', he'⟩ := wc_pencil_VQ_H1_finite_of_gc F' F'' Y n hn hn2 D ℓ hℓ hP hEC hEprop.2
    hVQ r e he
  set E := wcPencilE D ℓ hP with hEdef
  set C := wcPencilC D ℓ hP with hCdef
  set πq : Subobject.underlying.obj E ⟶ wcPencilVQ D ℓ hP :=
    Limits.cokernel.π (Subobject.ofLE (E ⊓ C) E inf_le_left) with hπq
  choose ψ₀ hψ₀ using hVQ
  right
  refine ⟨r', e', he', transfer
    (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - 1)) 1 (wcRqScalar D.f ℓ (n - 1) c))
    (fun c => wcCohGEnd F'' (wcP1Over F'') hP (Subobject.underlying.obj E) 1 (ψ₀ c))
    (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
    (wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - 1)) 1)
    (wcCohGFrob F'' (wcP1Over F'') hP (Subobject.underlying.obj E) 1)
    (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1)
    ?hV ?hV'
    ((Abelian.Ext.mk₀ E.arrow).postcomp _ (add_zero 1)) ?hp ?hps ?hpΦ
    ((Abelian.Ext.mk₀ πq).postcomp _ (add_zero 1)) ?hi ?his ?hiΦ
    α hα r' e' he'⟩
  case hV =>
    intro c x
    exact frobComm _ _ (wcRqScalar D.f ℓ (n - 1) c) x
  case hV' =>
    intro c x
    exact frobComm _ _ (wcPencilVQScalar D ℓ hP c) x
  case hp =>
    intro v
    have hS : (ShortComplex.mk E.arrow (Limits.cokernel.π E.arrow)
        (Limits.cokernel.condition _)).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _)
        (show Mono E.arrow from inferInstance)
        (show Epi (Limits.cokernel.π E.arrow) from inferInstance)
    exact Abelian.Ext.covariant_sequence_exact₂ _ hS v (hcokH1 _)
  case hps =>
    intro c x
    show Abelian.Ext.comp (Abelian.Ext.comp x (Abelian.Ext.mk₀ (ψ₀ c)) (add_zero 1))
        (Abelian.Ext.mk₀ E.arrow) (add_zero 1) =
      Abelian.Ext.comp (Abelian.Ext.comp x (Abelian.Ext.mk₀ E.arrow) (add_zero 1))
        (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ (n - 1) c)) (add_zero 1)
    rw [compComp, compComp, (hψ₀ c).1]
  case hpΦ =>
    intro x
    exact (frobComm _ _ E.arrow x).symm
  case hi =>
    rw [injective_iff_map_eq_zero]
    intro w hw
    haveI : Mono (Subobject.ofLE (E ⊓ C) E inf_le_left) :=
      mono_of_mono_fac (Subobject.ofLE_arrow (X := E ⊓ C) (Y := E) inf_le_left)
    have hS : (ShortComplex.mk (Subobject.ofLE (E ⊓ C) E inf_le_left)
        (Limits.cokernel.π (Subobject.ofLE (E ⊓ C) E inf_le_left))
        (Limits.cokernel.condition _)).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _)
        (show Mono (Subobject.ofLE (E ⊓ C) E inf_le_left) from inferInstance)
        (show Epi (Limits.cokernel.π (Subobject.ofLE (E ⊓ C) E inf_le_left)) from inferInstance)
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hS w hw
    rw [← hx₁, show x₁ = 0 from hI1 x₁, Abelian.Ext.zero_comp]
  case his =>
    intro c x
    show Abelian.Ext.comp (Abelian.Ext.comp x (Abelian.Ext.mk₀ (ψ₀ c)) (add_zero 1))
        (Abelian.Ext.mk₀ πq) (add_zero 1) =
      Abelian.Ext.comp (Abelian.Ext.comp x (Abelian.Ext.mk₀ πq) (add_zero 1))
        (Abelian.Ext.mk₀ (wcPencilVQScalar D ℓ hP c)) (add_zero 1)
    rw [compComp, compComp]
    exact congrArg (fun f => Abelian.Ext.comp x (Abelian.Ext.mk₀ f) (add_zero 1)) (hψ₀ c).2.symm
  case hiΦ =>
    intro x
    exact (frobComm _ _ πq x).symm

theorem wc_P1_field_points_equiv_option (K L : Type u) [Field K] [Field L] [Algebra K L] :
    Nonempty (Option L ≃ {f : Spec (.of L) ⟶ (wcP1Over K).left //
      f ≫ (wcP1Over K).hom = Spec.map (CommRingCat.ofHom (algebraMap K L))}) :=
by
  classical
  have fin2 : ∀ J : Fin (1 + 1), J = 0 ∨ J = 1 := by
    intro J
    fin_cases J
    · exact Or.inl rfl
    · exact Or.inr rfl

  have uniq : ∀ (T : Scheme.{u}) (g g' : T ⟶ wcProjK K 1) (t : Fin (1 + 1) → Γ(T, ⊤)),
      g ≫ wcProjKStr K 1 = g' ≫ wcProjKStr K 1 → (∃ i, T.basicOpen (t i) = ⊤) →
      (∀ (J L' : Fin (1 + 1)) (O : T.Opens) (hO : O ≤ g ⁻¹ᵁ wcSgD K 1 J),
        g.appLE (wcSgD K 1 J) O hO (wcSgE K 1 J L') *
          T.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op (t J) =
        T.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op (t L')) →
      (∀ (J L' : Fin (1 + 1)) (O : T.Opens) (hO : O ≤ g' ⁻¹ᵁ wcSgD K 1 J),
        g'.appLE (wcSgD K 1 J) O hO (wcSgE K 1 J L') *
          T.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op (t J) =
        T.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op (t L')) →
      g = g' := by
    intro T g g' t hs hcov hr hr'
    have hcov' : (⨆ J, T.basicOpen (t J)) = ⊤ := by
      obtain ⟨i, hi⟩ := hcov
      apply top_unique
      calc (⊤ : T.Opens) = T.basicOpen (t i) := hi.symm
        _ ≤ ⨆ J, T.basicOpen (t J) := le_iSup (fun J => T.basicOpen (t J)) i
    have h := wc_csd_proj_uniq_of_relations K 1 T ⊤ g g' t hs hcov'
      (fun J L' O hO _ => hr J L' O hO) (fun J L' O hO _ => hr' J L' O hO)
    haveI : IsIso (⊤ : T.Opens).ι := by rw [← Scheme.topIso_hom]; infer_instance
    exact (cancel_epi (⊤ : T.Opens).ι).mp h

  have s3 : ∀ (T : Scheme.{u}) (f φ : T ⟶ wcProjK K 1) (c : Γ(T, ⊤))
      (hstr : f ≫ wcProjKStr K 1 = φ ≫ wcProjKStr K 1)
      (hf : ⊤ ≤ f ⁻¹ᵁ wcSgD K 1 0)
      (hc : f.appLE (wcSgD K 1 0) ⊤ hf (wcSgE K 1 0 1) = c)
      (hφ : ∀ (J L' : Fin (1 + 1)) (O : T.Opens) (hO : O ≤ φ ⁻¹ᵁ wcSgD K 1 J),
        φ.appLE (wcSgD K 1 J) O hO (wcSgE K 1 J L') *
          T.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op ((![1, c] : Fin (1 + 1) → Γ(T, ⊤)) J) =
        T.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op ((![1, c] : Fin (1 + 1) → Γ(T, ⊤)) L')),
      f = φ := by
    intro T f φ c hstr hf hc hφ
    have t0 : (![1, c] : Fin (1 + 1) → Γ(T, ⊤)) 0 = 1 := rfl
    have t1 : (![1, c] : Fin (1 + 1) → Γ(T, ⊤)) 1 = c := rfl
    have happ : ∀ (O : T.Opens) (hO : O ≤ f ⁻¹ᵁ wcSgD K 1 0) (x : Γ(wcProjK K 1, wcSgD K 1 0)),
        f.appLE (wcSgD K 1 0) O hO x =
          T.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op (f.appLE (wcSgD K 1 0) ⊤ hf x) := by
      intro O hO x
      rw [← CategoryTheory.comp_apply, Scheme.Hom.appLE_map]
    have hmap : ∀ (U U' : (wcProjK K 1).Opens) (hUU : U ≤ U') (O : T.Opens)
        (e : O ≤ f ⁻¹ᵁ U) (e' : O ≤ f ⁻¹ᵁ U') (a : Γ(wcProjK K 1, U')),
        f.appLE U O e ((wcProjK K 1).presheaf.map (homOfLE hUU).op a) = f.appLE U' O e' a := by
      intro U U' hUU O e e' a
      rw [← CategoryTheory.comp_apply, Scheme.Hom.map_appLE]
    refine uniq T f φ ![1, c] hstr ⟨0, ?_⟩ ?_ hφ
    · rw [t0]
      first
        | exact Scheme.basicOpen_one ..
        | simp
    · intro J L' O hO
      have h0O : O ≤ f ⁻¹ᵁ wcSgD K 1 0 := le_top.trans hf
      rcases fin2 J with rfl | rfl <;> rcases fin2 L' with rfl | rfl
      · rw [(wc_ldpi_oai_sgE_facts K 1 0 0).1, map_one, one_mul]
      · rw [happ O hO, hc, t0, t1, map_one, mul_one]
      · have h01 : O ≤ f ⁻¹ᵁ (wcSgD K 1 0 ⊓ wcSgD K 1 1) :=
          (le_inf h0O hO).trans (Scheme.Hom.preimage_inf f).ge
        calc f.appLE (wcSgD K 1 1) O hO (wcSgE K 1 1 0) *
              T.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op ((![1, c] : Fin (1 + 1) → Γ(T, ⊤)) 1)
            = f.appLE (wcSgD K 1 0) O h0O (wcSgE K 1 0 1) *
                f.appLE (wcSgD K 1 1) O hO (wcSgE K 1 1 0) := by
              rw [t1, happ O h0O, hc, mul_comm]
          _ = f.appLE (wcSgD K 1 0 ⊓ wcSgD K 1 1) O h01
                ((wcProjK K 1).presheaf.map (homOfLE (inf_le_left :
                  wcSgD K 1 0 ⊓ wcSgD K 1 1 ≤ wcSgD K 1 0)).op (wcSgE K 1 0 1)) *
              f.appLE (wcSgD K 1 0 ⊓ wcSgD K 1 1) O h01
                ((wcProjK K 1).presheaf.map (homOfLE (inf_le_right :
                  wcSgD K 1 0 ⊓ wcSgD K 1 1 ≤ wcSgD K 1 1)).op (wcSgE K 1 1 0)) := by
              rw [hmap _ _ inf_le_left O h01 h0O, hmap _ _ inf_le_right O h01 hO]
          _ = f.appLE (wcSgD K 1 0 ⊓ wcSgD K 1 1) O h01
                ((wcProjK K 1).presheaf.map (homOfLE (inf_le_left :
                  wcSgD K 1 0 ⊓ wcSgD K 1 1 ≤ wcSgD K 1 0)).op (wcSgE K 1 0 1) *
                (wcProjK K 1).presheaf.map (homOfLE (inf_le_right :
                  wcSgD K 1 0 ⊓ wcSgD K 1 1 ≤ wcSgD K 1 1)).op (wcSgE K 1 1 0)) :=
              (map_mul _ _ _).symm
          _ = 1 := by rw [wc_ldpi_sgE_inv K 1 0 1, map_one]
          _ = T.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op
                ((![1, c] : Fin (1 + 1) → Γ(T, ⊤)) 0) := by
              rw [t0, map_one]
      · rw [(wc_ldpi_oai_sgE_facts K 1 1 1).1, map_one, one_mul]

  have s4 : ∀ (T : Scheme.{u}) [IsReduced T] (f φ : T ⟶ wcProjK K 1)
      (hstr : f ≫ wcProjKStr K 1 = φ ≫ wcProjKStr K 1)
      (hf : f ⁻¹ᵁ wcSgD K 1 0 = ⊥)
      (hφ : ∀ (J L' : Fin (1 + 1)) (O : T.Opens) (hO : O ≤ φ ⁻¹ᵁ wcSgD K 1 J),
        φ.appLE (wcSgD K 1 J) O hO (wcSgE K 1 J L') *
          T.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op ((![0, 1] : Fin (1 + 1) → Γ(T, ⊤)) J) =
        T.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op ((![0, 1] : Fin (1 + 1) → Γ(T, ⊤)) L')),
      f = φ := by
    intro T _ f φ hstr hf hφ
    have u0 : (![0, 1] : Fin (1 + 1) → Γ(T, ⊤)) 0 = 0 := rfl
    have u1 : (![0, 1] : Fin (1 + 1) → Γ(T, ⊤)) 1 = 1 := rfl
    refine uniq T f φ ![0, 1] hstr ⟨1, ?_⟩ ?_ hφ
    · rw [u1]
      first
        | exact Scheme.basicOpen_one ..
        | simp
    · intro J L' O hO
      rcases fin2 J with rfl | rfl
      · have hO' : O = ⊥ := le_bot_iff.mp (hO.trans hf.le)
        subst hO'
        exact Subsingleton.elim _ _
      · rcases fin2 L' with rfl | rfl
        · have hs : T.basicOpen (f.appLE (wcSgD K 1 1) O hO (wcSgE K 1 1 0)) = ⊥ := by
            rw [Scheme.basicOpen_appLE, (wc_ldpi_oai_sgE_facts K 1 1 0).2,
              Scheme.Hom.preimage_inf, hf]
            simp
          rw [(basicOpen_eq_bot_iff _).mp hs, zero_mul, u0, map_zero]
        · rw [(wc_ldpi_oai_sgE_facts K 1 1 1).1, map_one, one_mul]

  let ι : L →+* Γ(Spec (CommRingCat.of L), ⊤) := (Scheme.ΓSpecIso (CommRingCat.of L)).inv.hom
  let t : Option L → Fin (1 + 1) → Γ(Spec (CommRingCat.of L), ⊤) :=
    fun a => Option.elim a ![0, 1] (fun c => ![1, ι c])
  have hspan : ∀ a, Ideal.span (Set.range (t a)) = ⊤ := by
    intro a
    rcases a with _ | c
    · exact Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span (Set.mem_range_self 1)) isUnit_one
    · exact Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span (Set.mem_range_self 0)) isUnit_one
  choose φ hφstr hφpre hφrel using fun a => wc_ldpi_oai_proj_lift K 1 (Spec (CommRingCat.of L))
    (Spec.map (CommRingCat.ofHom (algebraMap K L))) (t a) (hspan a)
  let Φ : Option L → {f : Spec (CommRingCat.of L) ⟶ (wcP1Over K).left //
      f ≫ (wcP1Over K).hom = Spec.map (CommRingCat.ofHom (algebraMap K L))} :=
    fun a => ⟨φ a, hφstr a⟩
  obtain ⟨pt, hpt⟩ : ∃ pt : Spec (CommRingCat.of L), ∀ x : Spec (CommRingCat.of L), x = pt :=
    ⟨default, fun x => Subsingleton.elim x default⟩
  have htopbot : (⊤ : (Spec (CommRingCat.of L)).Opens) ≠ ⊥ := by
    intro h
    have hx : pt ∈ (⊤ : (Spec (CommRingCat.of L)).Opens) := by simp
    rw [h] at hx
    simp at hx
  have hnone : φ none ⁻¹ᵁ wcSgD K 1 0 = ⊥ := by
    rw [hφpre none 0]
    first
      | exact Scheme.basicOpen_zero ..
      | simp [t]
  have hsome : ∀ c, φ (some c) ⁻¹ᵁ wcSgD K 1 0 = ⊤ := by
    intro c
    rw [hφpre (some c) 0]
    first
      | exact Scheme.basicOpen_one ..
      | simp [t]
  have hid : ∀ x : Γ(Spec (CommRingCat.of L), ⊤),
      (Spec (CommRingCat.of L)).presheaf.map
        (homOfLE (le_top : (⊤ : (Spec (CommRingCat.of L)).Opens) ≤ ⊤)).op x = x := by
    intro x
    have e : (homOfLE (le_top : (⊤ : (Spec (CommRingCat.of L)).Opens) ≤ ⊤)).op =
        𝟙 (Opposite.op (⊤ : (Spec (CommRingCat.of L)).Opens)) := rfl
    rw [e, CategoryTheory.Functor.map_id] <;> rfl
  have hcoord : ∀ (c : L) (h : ⊤ ≤ φ (some c) ⁻¹ᵁ wcSgD K 1 0),
      (φ (some c)).appLE (wcSgD K 1 0) ⊤ h (wcSgE K 1 0 1) = ι c := by
    intro c h
    have e := hφrel (some c) 0 1 ⊤ h
    rw [hid, hid] at e
    have e' : (φ (some c)).appLE (wcSgD K 1 0) ⊤ h (wcSgE K 1 0 1) * 1 = ι c := e
    rwa [mul_one] at e'
  have happeq : ∀ (ψ ψ' : Spec (CommRingCat.of L) ⟶ wcProjK K 1), ψ = ψ' →
      ∀ (h : ⊤ ≤ ψ ⁻¹ᵁ wcSgD K 1 0) (h' : ⊤ ≤ ψ' ⁻¹ᵁ wcSgD K 1 0),
      ψ.appLE (wcSgD K 1 0) ⊤ h (wcSgE K 1 0 1) =
        ψ'.appLE (wcSgD K 1 0) ⊤ h' (wcSgE K 1 0 1) := by
    rintro ψ _ rfl h h'
    rfl
  have hΓ : ∀ x : L, (Scheme.ΓSpecIso (CommRingCat.of L)).hom.hom (ι x) = x := fun x =>
    Iso.inv_hom_id_apply (Scheme.ΓSpecIso (CommRingCat.of L)) x
  have hinj : Function.Injective Φ := by
    intro a b hab
    have hφab : φ a = φ b := congrArg Subtype.val hab
    rcases a with _ | c <;> rcases b with _ | c'
    · rfl
    · exfalso
      have h1 := hnone
      rw [hφab, hsome c'] at h1
      exact htopbot h1
    · exfalso
      have h1 := hsome c
      rw [hφab, hnone] at h1
      exact htopbot h1.symm
    · have h4 : ι c = ι c' :=
        (hcoord c (hsome c).ge).symm.trans
          ((happeq _ _ hφab (hsome c).ge (hsome c').ge).trans (hcoord c' (hsome c').ge))
      have h5 : c = c' := by
        rw [← hΓ c, h4, hΓ c']
      rw [h5]
  have hsurj : Function.Surjective Φ := by
    rintro ⟨f, hf⟩
    have hfstr : ∀ a, f ≫ wcProjKStr K 1 = φ a ≫ wcProjKStr K 1 :=
      fun a => hf.trans (hφstr a).symm
    by_cases hp : pt ∈ f ⁻¹ᵁ wcSgD K 1 0
    · have hf0 : ⊤ ≤ f ⁻¹ᵁ wcSgD K 1 0 := by
        intro x _
        rw [hpt x]
        exact hp
      obtain ⟨c0, hc0⟩ : ∃ c0 : L, ι c0 = f.appLE (wcSgD K 1 0) ⊤ hf0 (wcSgE K 1 0 1) :=
        ⟨(Scheme.ΓSpecIso (CommRingCat.of L)).hom.hom
            (f.appLE (wcSgD K 1 0) ⊤ hf0 (wcSgE K 1 0 1)),
          Iso.hom_inv_id_apply (Scheme.ΓSpecIso (CommRingCat.of L)) _⟩
      refine ⟨some c0, ?_⟩
      apply Subtype.ext
      symm
      exact s3 _ f (φ (some c0)) (ι c0) (hfstr _) hf0 hc0.symm (hφrel (some c0))
    · have hf0 : f ⁻¹ᵁ wcSgD K 1 0 = ⊥ := by
        apply le_bot_iff.mp
        intro x hx
        rw [hpt x] at hx
        exact absurd hx hp
      refine ⟨none, ?_⟩
      apply Subtype.ext
      symm
      exact s4 _ f (φ none) (hfstr none) hf0 (hφrel none)
  exact ⟨Equiv.ofBijective Φ ⟨hinj, hsurj⟩⟩

theorem wc_spec_field_points_sigma_equiv (K L : Type u) [Field K] [Field L] [Algebra K L]
    (X : Scheme.{u}) (s : X ⟶ Spec (.of K)) :
    Nonempty ({f : Spec (.of L) ⟶ X // f ≫ s = Spec.map (CommRingCat.ofHom (algebraMap K L))} ≃
      Σ x : X, @AlgHom K (X.residueField x) L _ _ _
        ((X.residue x).hom.comp (wcLdpConst K s x)).toAlgebra _) :=
by
  classical
  have hcompat : ∀ x : X, X.fromSpecResidueField x ≫ s =
      Spec.map (CommRingCat.ofHom (wcLdpConst K s x) ≫ X.residue x) := by
    intro x
    have hconst : CommRingCat.ofHom (wcLdpConst K s x) =
        (Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ s.appTop ≫ X.presheaf.germ ⊤ x trivial := by
      rfl
    have hstalk : X.fromSpecStalk x ≫ s = Spec.map (CommRingCat.ofHom (wcLdpConst K s x)) := by
      calc X.fromSpecStalk x ≫ s
          = X.fromSpecStalk x ≫ s ≫ (Spec (CommRingCat.of K)).toSpecΓ ≫
              Spec.map (Scheme.ΓSpecIso (CommRingCat.of K)).inv := by
            rw [toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]
        _ = X.fromSpecStalk x ≫ X.toSpecΓ ≫ Spec.map s.appTop ≫
              Spec.map (Scheme.ΓSpecIso (CommRingCat.of K)).inv := by
            rw [← Category.assoc s, Scheme.toSpecΓ_naturality, Category.assoc]
        _ = Spec.map (X.presheaf.germ ⊤ x trivial) ≫ Spec.map s.appTop ≫
              Spec.map (Scheme.ΓSpecIso (CommRingCat.of K)).inv := by
            rw [← Category.assoc, Scheme.fromSpecStalk_toSpecΓ]
        _ = Spec.map (CommRingCat.ofHom (wcLdpConst K s x)) := by
            rw [hconst, Spec.map_comp, Spec.map_comp, Category.assoc]
    rw [Spec.map_comp, Scheme.fromSpecResidueField, Category.assoc, hstalk]
  have hfib : ∀ (x : X) (φ : X.residueField x ⟶ CommRingCat.of L),
      (Spec.map φ ≫ X.fromSpecResidueField x) ≫ s =
          Spec.map (CommRingCat.ofHom (algebraMap K L)) ↔
        ∀ c : K, φ.hom ((X.residue x).hom (wcLdpConst K s x c)) = algebraMap K L c := by
    intro x φ
    rw [Category.assoc, hcompat x, ← Spec.map_comp, Spec.map_inj]
    constructor
    · intro h c
      exact congrArg (fun g => g.hom c) h
    · intro h
      ext c
      exact h c
  let E := Scheme.SpecToEquivOfField L X
  let e1 : {f : Spec (.of L) ⟶ X // f ≫ s = Spec.map (CommRingCat.ofHom (algebraMap K L))} ≃
      {p : Σ x : X, (X.residueField x ⟶ CommRingCat.of L) //
        E.symm p ≫ s = Spec.map (CommRingCat.ofHom (algebraMap K L))} :=
    E.subtypeEquiv (fun f => by rw [Equiv.symm_apply_apply])
  let e2 : {p : Σ x : X, (X.residueField x ⟶ CommRingCat.of L) //
        E.symm p ≫ s = Spec.map (CommRingCat.ofHom (algebraMap K L))} ≃
      Σ x : X, {φ : X.residueField x ⟶ CommRingCat.of L //
        E.symm ⟨x, φ⟩ ≫ s = Spec.map (CommRingCat.ofHom (algebraMap K L))} :=
    { toFun := fun p => ⟨p.1.1, p.1.2, p.2⟩
      invFun := fun q => ⟨⟨q.1, q.2.1⟩, q.2.2⟩
      left_inv := fun ⟨⟨_, _⟩, _⟩ => rfl
      right_inv := fun ⟨_, _, _⟩ => rfl }
  let e3 : (Σ x : X, {φ : X.residueField x ⟶ CommRingCat.of L //
        E.symm ⟨x, φ⟩ ≫ s = Spec.map (CommRingCat.ofHom (algebraMap K L))}) ≃
      Σ x : X, {φ : X.residueField x ⟶ CommRingCat.of L //
        ∀ c : K, φ.hom ((X.residue x).hom (wcLdpConst K s x c)) = algebraMap K L c} :=
    Equiv.sigmaCongrRight (fun x => Equiv.subtypeEquivRight (fun φ => hfib x φ))
  let e4 : ∀ x : X, {φ : X.residueField x ⟶ CommRingCat.of L //
        ∀ c : K, φ.hom ((X.residue x).hom (wcLdpConst K s x c)) = algebraMap K L c} ≃
      @AlgHom K (X.residueField x) L _ _ _
        ((X.residue x).hom.comp (wcLdpConst K s x)).toAlgebra _ := fun x =>
    letI := ((X.residue x).hom.comp (wcLdpConst K s x)).toAlgebra
    { toFun := fun φ => { toRingHom := φ.1.hom, commutes' := φ.2 }
      invFun := fun σ => ⟨CommRingCat.ofHom σ.toRingHom, fun c => σ.commutes c⟩
      left_inv := fun φ => rfl
      right_inv := fun σ => rfl }
  exact ⟨e1.trans (e2.trans (e3.trans (Equiv.sigmaCongrRight e4)))⟩

theorem wc_P1_residue_algHom_facts (K L : Type u) [Field K] [Finite K] [Field L] [Algebra K L]
    [Finite L] (x : (wcP1Over K).left) :
    (Nonempty (@AlgHom K ((wcP1Over K).left.residueField x) L _ _ _
        (((wcP1Over K).left.residue x).hom.comp (wcLdpConst K (wcP1Over K).hom x)).toAlgebra _) ↔
      ∃ d ∈ (Module.finrank K L).divisors, x ∈ wcP1ClosedPt K d) ∧
    (Nonempty (@AlgHom K ((wcP1Over K).left.residueField x) L _ _ _
        (((wcP1Over K).left.residue x).hom.comp (wcLdpConst K (wcP1Over K).hom x)).toAlgebra _) →
      x ∈ wcP1ClosedPt K (Nat.card (@AlgHom K ((wcP1Over K).left.residueField x) L _ _ _
        (((wcP1Over K).left.residue x).hom.comp (wcLdpConst K (wcP1Over K).hom x)).toAlgebra _))) :=
by
  classical

  have hProper : IsProper (wcProjKStr K 1) := by
    letI := @MvPolynomial.gradedAlgebra (Fin (1+1)) K _
    letI : IsScalarTower K ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) K) 0)
        (MvPolynomial (Fin (1+1)) K) :=
      IsScalarTower.of_algebraMap_eq (R := K)
        (S := (MvPolynomial.homogeneousSubmodule (Fin (1+1)) K) 0)
        (A := MvPolynomial (Fin (1+1)) K) (fun r => rfl)
    haveI : Algebra.FiniteType ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) K) 0)
        (MvPolynomial (Fin (1+1)) K) :=
      Algebra.FiniteType.of_restrictScalars_finiteType K _ _
    haveI : IsProper (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (1+1)) K)) :=
      inferInstance
    have hbij : Function.Bijective
        (algebraMap K ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) K) 0)) := by
      constructor
      · intro a b hab
        have h := congrArg (fun x : (MvPolynomial.homogeneousSubmodule (Fin (1+1)) K) 0 =>
          (x : MvPolynomial (Fin (1+1)) K)) hab
        simp only [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq] at h
        exact MvPolynomial.C_injective _ _ h
      · intro x
        have hx : (x : MvPolynomial (Fin (1+1)) K).IsHomogeneous 0 :=
          (MvPolynomial.mem_homogeneousSubmodule 0 _).mp x.2
        have ht : (x : MvPolynomial (Fin (1+1)) K).totalDegree = 0 :=
          Nat.le_zero.mp hx.totalDegree_le
        refine ⟨(x : MvPolynomial (Fin (1+1)) K).coeff 0, Subtype.ext ?_⟩
        simp only [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
        exact ((MvPolynomial.totalDegree_eq_zero_iff_eq_C).mp ht).symm
    haveI : IsIso (CommRingCat.ofHom
        (algebraMap K ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) K) 0))) := by
      rw [ConcreteCategory.isIso_iff_bijective]
      exact hbij
    show IsProper (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (1+1)) K) ≫
      Spec.map (CommRingCat.ofHom
        (algebraMap K ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) K) 0))))
    infer_instance
  haveI hLOFT : LocallyOfFiniteType (wcP1Over K).hom := by
    show LocallyOfFiniteType (wcProjKStr K 1)
    infer_instance

  have hclosed : ∀ (Z : Scheme.{u}) (s : Z ⟶ Spec (.of K)) [LocallyOfFiniteType s] (x : Z),
      ((Z.residue x).hom.comp (wcLdpConst K s x)).Finite → IsClosed ({x} : Set Z) := by
    intro Z s _ x hfin
    set φ : CommRingCat.of K ⟶ Z.residueField x :=
      CommRingCat.ofHom (wcLdpConst K s x) ≫ Z.residue x with hφdef
    have hconst : CommRingCat.ofHom (wcLdpConst K s x) =
        (Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ s.appTop ≫ Z.presheaf.germ ⊤ x trivial := by
      rfl
    have hstalk : Z.fromSpecStalk x ≫ s = Spec.map (CommRingCat.ofHom (wcLdpConst K s x)) := by
      calc Z.fromSpecStalk x ≫ s
          = Z.fromSpecStalk x ≫ s ≫ (Spec (CommRingCat.of K)).toSpecΓ ≫
              Spec.map (Scheme.ΓSpecIso (CommRingCat.of K)).inv := by
            rw [toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]
        _ = Z.fromSpecStalk x ≫ Z.toSpecΓ ≫ Spec.map s.appTop ≫
              Spec.map (Scheme.ΓSpecIso (CommRingCat.of K)).inv := by
            rw [← Category.assoc s, Scheme.toSpecΓ_naturality, Category.assoc]
        _ = Spec.map (Z.presheaf.germ ⊤ x trivial) ≫ Spec.map s.appTop ≫
              Spec.map (Scheme.ΓSpecIso (CommRingCat.of K)).inv := by
            rw [← Category.assoc, Scheme.fromSpecStalk_toSpecΓ]
        _ = Spec.map (CommRingCat.ofHom (wcLdpConst K s x)) := by
            rw [hconst, Spec.map_comp, Spec.map_comp, Category.assoc]
    have hcompat : Z.fromSpecResidueField x ≫ s = Spec.map φ := by
      rw [hφdef, Spec.map_comp, Scheme.fromSpecResidueField, Category.assoc, hstalk]
    haveI : JacobsonSpace Z := LocallyOfFiniteType.jacobsonSpace s
    have hft : φ.hom.FiniteType := RingHom.Finite.finiteType hfin
    have h1 : LocallyOfFiniteType (Spec.map φ) :=
      (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mpr hft
    haveI : LocallyOfFiniteType (Z.fromSpecResidueField x ≫ s) := by
      rw [hcompat]; exact h1
    haveI : LocallyOfFiniteType (Z.fromSpecResidueField x) :=
      locallyOfFiniteType_of_comp (Z.fromSpecResidueField x) s
    exact isClosed_singleton_iff_locallyOfFiniteType.mpr inferInstance

  haveI : Module.Finite K L := Module.Finite.of_finite
  have hn : 0 < Module.finrank K L := Module.finrank_pos
  have generic : ∀ (κ : Type u) [Field κ] [Algebra K κ] (C : Prop), (Module.Finite K κ → C) →
      (Nonempty (κ →ₐ[K] L) ↔ ∃ d ∈ (Module.finrank K L).divisors, C ∧ Module.finrank K κ = d) ∧
      (Nonempty (κ →ₐ[K] L) → C ∧ Module.finrank K κ = Nat.card (κ →ₐ[K] L)) := by
    intro κ _ _ C hC
    have core : Nonempty (κ →ₐ[K] L) → Module.finrank K κ ∣ Module.finrank K L ∧ C := by
      intro hσ
      have hd : Module.finrank K κ ∣ Module.finrank K L :=
        FiniteField.nonempty_algHom_iff_finrank_dvd.mp hσ
      have hd0 : Module.finrank K κ ≠ 0 := by
        intro h
        rw [h, zero_dvd_iff] at hd
        omega
      exact ⟨hd, hC (Module.finite_of_finrank_pos (Nat.pos_of_ne_zero hd0))⟩
    refine ⟨⟨fun hσ => ?_, ?_⟩, fun hσ => ?_⟩
    · obtain ⟨hd, hc⟩ := core hσ
      exact ⟨_, Nat.mem_divisors.mpr ⟨hd, by omega⟩, hc, rfl⟩
    · rintro ⟨d, hd, -, hκ⟩
      exact FiniteField.nonempty_algHom_of_finrank_dvd (hκ ▸ (Nat.mem_divisors.mp hd).1)
    · obtain ⟨hd, hc⟩ := core hσ
      exact ⟨hc, (FiniteField.natCard_algHom_of_finrank_dvd hd).symm⟩
  exact @generic ((wcP1Over K).left.residueField x) _
    (((wcP1Over K).left.residue x).hom.comp (wcLdpConst K (wcP1Over K).hom x)).toAlgebra
    (IsClosed ({x} : Set (wcP1Over K).left)) (fun h => hclosed _ (wcP1Over K).hom x h)

theorem wc_P1_closed_point_count (K : Type u) [Field K] [Finite K] :
    (∀ d : ℕ, 1 ≤ d → (wcP1ClosedPt K d).Finite) ∧
    ∀ e : ℕ, 1 ≤ e → ∑ d ∈ e.divisors, d * Nat.card (wcP1ClosedPt K d) = Nat.card K ^ e + 1 :=
by
  classical

  have regroup : ∀ (α : Type u) (H : α → Type u) (C : ℕ → Set α) (e : ℕ),
      Finite (Σ a, H a) →
      (∀ a, Nonempty (H a) ↔ ∃ d ∈ e.divisors, a ∈ C d) →
      (∀ a, Nonempty (H a) → a ∈ C (Nat.card (H a))) →
      (∀ a d d', a ∈ C d → a ∈ C d' → d = d') →
      (∀ d ∈ e.divisors, (C d).Finite) ∧
        Nat.card (Σ a, H a) = ∑ d ∈ e.divisors, d * Nat.card (C d) := by
    intro α H C e hfin hC hcard hdisj
    have hS : (Set.range (Sigma.fst : (Σ a, H a) → α)).Finite := Set.finite_range _
    have hmemS : ∀ a, a ∈ Set.range (Sigma.fst : (Σ a, H a) → α) ↔ Nonempty (H a) := by
      intro a
      constructor
      · rintro ⟨⟨b, h⟩, rfl⟩
        exact ⟨h⟩
      · rintro ⟨h⟩
        exact ⟨⟨a, h⟩, rfl⟩
    have hCS : ∀ d ∈ e.divisors, C d ⊆ Set.range (Sigma.fst : (Σ a, H a) → α) := by
      intro d hd a ha
      exact (hmemS a).mpr ((hC a).mpr ⟨d, hd, ha⟩)
    have hCfin : ∀ d ∈ e.divisors, (C d).Finite := fun d hd => hS.subset (hCS d hd)
    refine ⟨hCfin, ?_⟩
    set T := hS.toFinset with hT
    have hmemT : ∀ a, a ∈ T ↔ Nonempty (H a) := by
      intro a
      rw [hT, Set.Finite.mem_toFinset]
      exact hmemS a
    haveI hHfin : ∀ a, Finite (H a) := fun a =>
      Finite.of_injective (Sigma.mk a : H a → Σ a, H a) sigma_mk_injective
    have hsub : ∀ (x : α) (_ : H x), x ∈ T := fun x h => (hmemT x).mpr ⟨h⟩
    have h1 : Nat.card (Σ a, H a) = ∑ a ∈ T, Nat.card (H a) := by
      rw [← Nat.card_congr (Equiv.sigmaSubtypeEquivOfSubset H (· ∈ T) hsub), Nat.card_sigma]
      exact Finset.sum_coe_sort T (fun a => Nat.card (H a))
    have hmaps : ∀ a ∈ T, Nat.card (H a) ∈ e.divisors := by
      intro a ha
      obtain ⟨d, hd, had⟩ := (hC a).mp ((hmemT a).mp ha)
      have := hdisj a _ _ (hcard a ((hmemT a).mp ha)) had
      rw [this]
      exact hd
    rw [h1, ← Finset.sum_fiberwise_of_maps_to hmaps]
    apply Finset.sum_congr rfl
    intro d hd
    have hfil : T.filter (fun a => Nat.card (H a) = d) = (hCfin d hd).toFinset := by
      ext a
      rw [Finset.mem_filter, hmemT a, Set.Finite.mem_toFinset]
      constructor
      · rintro ⟨hne, hc⟩
        have := hcard a hne
        rw [hc] at this
        exact this
      · intro ha
        have hne : Nonempty (H a) := (hC a).mpr ⟨d, hd, ha⟩
        exact ⟨hne, hdisj a _ _ (hcard a hne) ha⟩
    rw [Finset.sum_congr rfl (fun a ha => (Finset.mem_filter.mp ha).2), Finset.sum_const,
      smul_eq_mul, hfil, Nat.card_eq_card_finite_toFinset (hCfin d hd), mul_comm]

  have hext : ∀ n : ℕ, 1 ≤ n → ∃ (E : Type u) (_ : Field E) (_ : Algebra K E),
      FiniteDimensional K E ∧ Module.finrank K E = n := by
    intro n hn
    haveI : Fact (Nat.Prime (ringChar K)) := ⟨CharP.char_is_prime K (ringChar K)⟩
    haveI : NeZero n := ⟨by omega⟩
    refine ⟨ULift.{u} (FiniteField.Extension K (ringChar K) n), inferInstance, inferInstance,
      ?_, ?_⟩
    · exact Module.Finite.equiv (ULift.moduleEquiv (R := K)).symm
    · rw [LinearEquiv.finrank_eq (ULift.moduleEquiv (R := K))]
      exact FiniteField.finrank_extension K (ringChar K) n

  have key : ∀ e : ℕ, 1 ≤ e → (∀ d ∈ e.divisors, (wcP1ClosedPt K d).Finite) ∧
      ∑ d ∈ e.divisors, d * Nat.card (wcP1ClosedPt K d) = Nat.card K ^ e + 1 := by
    intro e he
    obtain ⟨L, _, _, _, hL⟩ := hext e he
    haveI : Finite L := Module.finite_of_finite K
    have hcardL : Nat.card L = Nat.card K ^ e := by
      rw [← hL]
      exact Module.natCard_eq_pow_finrank
    obtain ⟨e₁⟩ := wc_P1_field_points_equiv_option K L
    obtain ⟨e₂⟩ := wc_spec_field_points_sigma_equiv K L (wcP1Over K).left (wcP1Over K).hom
    have hfin : Finite (Σ x : (wcP1Over K).left, @AlgHom K ((wcP1Over K).left.residueField x) L
        _ _ _ (((wcP1Over K).left.residue x).hom.comp
          (wcLdpConst K (wcP1Over K).hom x)).toAlgebra _) :=
      Finite.of_equiv _ (e₁.trans e₂)
    have hcard : Nat.card (Σ x : (wcP1Over K).left, @AlgHom K ((wcP1Over K).left.residueField x) L
        _ _ _ (((wcP1Over K).left.residue x).hom.comp
          (wcLdpConst K (wcP1Over K).hom x)).toAlgebra _) = Nat.card K ^ e + 1 := by
      rw [← Nat.card_congr (e₁.trans e₂), Finite.card_option, hcardL]
    obtain ⟨h1, h2⟩ := regroup (wcP1Over K).left
      (fun x => @AlgHom K ((wcP1Over K).left.residueField x) L _ _ _
        (((wcP1Over K).left.residue x).hom.comp (wcLdpConst K (wcP1Over K).hom x)).toAlgebra _)
      (wcP1ClosedPt K) e hfin
      (fun x => by
        have := (wc_P1_residue_algHom_facts K L x).1
        rw [hL] at this
        exact this)
      (fun x => (wc_P1_residue_algHom_facts K L x).2)
      (fun x d d' h h' => h.2.symm.trans h'.2)
    exact ⟨h1, h2.symm.trans hcard⟩
  exact ⟨fun d hd => (key d hd).1 d (Nat.mem_divisors_self d (by omega)),
    fun e he => (key e he).2⟩

theorem wc_pencil_Rq_scalar_triv_cover (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) (q : ℕ) :
    ∃ (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (r : ℕ),
      ConnectedSpace W.left ∧
      (∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left,
        (∀ i : Fin D.m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠ D.S i (IsLocalRing.closedPoint F'')) →
        ∃ z : W.left, w.left z = p) ∧
      wcScalarTriv (wcP1Over F'').left ℓ (wcRq D.f ℓ q) (wcRqScalar D.f ℓ q) W r :=
by
  classical

  haveI := D.proper
  haveI hsep : IsSeparated (wcP1Over F'').hom := (inferInstance : IsSeparated (wcProjKStr F'' 1))
  haveI hcomp : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; exact D.proper
  haveI hfp : IsProper D.f := IsProper.of_comp D.f (wcP1Over F'').hom
  haveI hPw : WeaklyEtale (wcGeomPoint F'' (wcP1Over F'') hP).hom := hP

  obtain ⟨Ub, hUb, hconn, hcpt, hqs, hqcι⟩ := wc_P1bar_smooth_locus F'' hP D.m D.S D.hS
  haveI := hqcι
  have hu : WeaklyEtale (Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) := inferInstance

  have htors : ∀ j : ℕ, ∃ (E : Scheme.{u}) (πE : E ⟶ Ub.toScheme),
      IsFinite πE ∧ Etale πE ∧ Surjective πE ∧
      ∃ hE : WeaklyEtale (πE ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom),
      ∃ (b' : ℕ) (e' : Fin b' → ℕ),
        Nonempty ((((wcProEtPush D.f).rightDerived (Nat.unpair j).1).obj
            (wcContSheaf D.Yt.left (ZMod (ℓ ^ (Nat.unpair j).2)))).over
            (MorphismProperty.Over.mk ⊤ (πE ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) hE) ≅
          (wcContSheaf (wcP1Over F'').left ((i : Fin b') → ZMod (ℓ ^ e' i))).over
            (MorphismProperty.Over.mk ⊤ (πE ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) hE)) := by
    intro j
    obtain ⟨N, V, v, het, hcov, hV, b, e, hiso⟩ :=
      wc_pencil_Rq_torsion_etale_locally_const F' F'' Y n D ℓ hℓ hP Ub hUb
        (Nat.unpair j).1 (Nat.unpair j).2
    exact wc_proet_loc_const_finite_fet_trivial (wcP1Over F'').left _ ℓ Ub.toScheme
      (Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) hu hconn hcpt hqs N V v het hcov hV b e hiso
  choose E πE hfin het hsurj hE b' e' hθ using htors

  obtain ⟨W₀, p, hpWE, hpqc, hpsurj, hW₀conn, hW₀cpt, hW₀qs, ht⟩ :=
    wc_fet_tower_connected_limit Ub.toScheme hconn hcpt hqs E πE hfin het hsurj
  choose t ht using ht
  haveI := hpWE
  haveI := hpqc
  have hWE : WeaklyEtale (p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) := inferInstance

  let W : (wcP1Over F'').left.ProEt :=
    MorphismProperty.Over.mk ⊤ (p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) hWE
  let w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP :=
    MorphismProperty.Over.homMk (p ≫ Ub.ι) (Category.assoc _ _ _) trivial
  let Ej : ℕ → (wcP1Over F'').left.ProEt := fun j =>
    MorphismProperty.Over.mk ⊤ (πE j ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) (hE j)
  let c : ∀ j, W ⟶ Ej j := fun j =>
    MorphismProperty.Over.homMk (t j)
      (show t j ≫ πE j ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom =
          p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom by
        rw [← Category.assoc, ht j]) trivial

  have hres : ∀ q' k : ℕ, ∃ (b : ℕ) (e : Fin b → ℕ),
      Nonempty ((((wcProEtPush D.f).rightDerived q').obj (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))).over W ≅
        (wcContSheaf (wcP1Over F'').left ((j : Fin b) → ZMod (ℓ ^ e j))).over W) := by
    intro q' k
    have h := hθ (Nat.pair q' k)
    rw [Nat.unpair_pair] at h
    obtain ⟨θ⟩ := h
    exact ⟨b' (Nat.pair q' k), e' (Nat.pair q' k),
      ⟨((Scheme.ProEt.topology (wcP1Over F'').left).overMapPullback AddCommGrpCat.{u+1}
        (c (Nat.pair q' k))).mapIso θ⟩⟩

  obtain ⟨a, b, e, hZ⟩ :=
    wc_proet_Rq_int_const_of_torsion_const D.f ℓ W hW₀conn hW₀cpt hW₀qs hres q
  obtain ⟨τ, hτ⟩ := wc_proet_Rq_rat_linear_triv D.f ℓ W hW₀conn hW₀cpt hW₀qs q a b e hZ

  refine ⟨W, w, a, hW₀conn, ?_, ⟨τ, fun c' => ?_⟩⟩
  · intro x hx
    have hxU : x ∈ Ub := (hUb x).2 hx
    obtain ⟨y, hy⟩ : x ∈ Set.range Ub.ι := by rw [Scheme.Opens.range_ι]; exact hxU
    obtain ⟨z, hz⟩ := hpsurj.surj y
    refine ⟨z, ?_⟩
    show (p ≫ Ub.ι) z = x
    rw [Scheme.Hom.comp_apply, hz, hy]
  · exact hτ c'

theorem wc_scalarTriv_sub_of_coker_const (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (W : S.ProEt) (hW : ConnectedSpace W.left)
    (G X : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (σG : ℚ_[ℓ] → (G ⟶ G)) (σX : ℚ_[ℓ] → (X ⟶ X)) (a : ℕ)
    (hG : wcScalarTriv S ℓ G σG W a) (m : X ⟶ G) [Mono m]
    (hm : ∀ c : ℚ_[ℓ], σX c ≫ m = m ≫ σG c)
    (hcok : IsIso m ∨ ∃ b : ℕ,
      Nonempty ((Limits.cokernel m).over W ≅ (wcContSheaf S (Fin b → ℚ_[ℓ])).over W)) :
    ∃ e : ℕ, wcScalarTriv S ℓ X σX W e :=
by
  classical
  obtain ⟨tG, htG⟩ := hG
  set ρ := (Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W with hρ
  rcases hcok with hiso | ⟨b, ⟨θ⟩⟩
  ·
    haveI := hiso
    refine ⟨a, ρ.mapIso (asIso m) ≪≫ tG, fun c => ?_⟩
    show ρ.map (σX c) ≫ (ρ.map m ≫ tG.hom) =
      (ρ.map m ≫ tG.hom) ≫ ρ.map (wcConstScalar S ℓ a c)
    rw [← Functor.map_comp_assoc, hm c, Functor.map_comp_assoc, htG c, Category.assoc]
  ·
    have congrMap : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
        [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]
        (f g : A →+ B) (hf : Continuous f) (hg : Continuous g), f = g →
        wcContSheafMap S f hf = wcContSheafMap S g hg := by
      intro A B _ _ _ _ _ _ f g hf hg hfg
      subst hfg
      rfl

    obtain ⟨L, hL⟩ : ∃ L : (Fin a → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin b → ℚ_[ℓ]),
        tG.inv ≫ ρ.map (Limits.cokernel.π m) ≫ θ.hom =
          ρ.map (wcContSheafMap S L.toAddMonoidHom (LinearMap.continuous_of_finiteDimensional L)) :=
      wc_contSheaf_over_hom_linear S ℓ W hW a b _
    have hsq : ρ.map (Limits.cokernel.π m) ≫ θ.hom = tG.hom ≫
        ρ.map (wcContSheafMap S L.toAddMonoidHom (LinearMap.continuous_of_finiteDimensional L)) := by
      rw [← hL, Iso.hom_inv_id_assoc]
    have hsq' : tG.inv ≫ ρ.map (Limits.cokernel.π m) =
        ρ.map (wcContSheafMap S L.toAddMonoidHom (LinearMap.continuous_of_finiteDimensional L)) ≫
          θ.inv := by
      rw [← hL]
      simp only [Category.assoc, Iso.hom_inv_id, Category.comp_id]

    let N := LinearMap.ker L
    let R := LinearMap.range L
    let e0 := Module.finrank ℚ_[ℓ] N
    let d := Module.finrank ℚ_[ℓ] R
    let eN : (Fin e0 → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] N :=
      LinearEquiv.ofFinrankEq _ _ (Module.finrank_fin_fun ℚ_[ℓ])
    let eR : (Fin d → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] R :=
      LinearEquiv.ofFinrankEq _ _ (Module.finrank_fin_fun ℚ_[ℓ])
    let incl : (Fin e0 → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin a → ℚ_[ℓ]) := N.subtype ∘ₗ eN.toLinearMap
    let L' : (Fin a → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin d → ℚ_[ℓ]) := eR.symm.toLinearMap ∘ₗ L.rangeRestrict
    let j : (Fin d → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin b → ℚ_[ℓ]) := R.subtype ∘ₗ eR.toLinearMap
    have hincl_inj : Function.Injective incl := Subtype.val_injective.comp eN.injective
    have hj_inj : Function.Injective j := Subtype.val_injective.comp eR.injective
    have hL'surj : Function.Surjective L' := eR.symm.surjective.comp L.surjective_rangeRestrict
    have hjL : ∀ v, j (L' v) = L v := by
      intro v
      show ((eR (eR.symm (L.rangeRestrict v)) : R) : Fin b → ℚ_[ℓ]) = L v
      rw [LinearEquiv.apply_symm_apply]
      rfl
    have hinclc : Continuous (incl.toAddMonoidHom : _ →+ _) :=
      LinearMap.continuous_of_finiteDimensional incl
    have hL'c : Continuous (L'.toAddMonoidHom : _ →+ _) :=
      LinearMap.continuous_of_finiteDimensional L'
    have hjc : Continuous (j.toAddMonoidHom : _ →+ _) :=
      LinearMap.continuous_of_finiteDimensional j
    have hemb : Topology.IsEmbedding incl :=
      (LinearMap.isClosedEmbedding_of_injective (LinearMap.ker_eq_bot.mpr hincl_inj)).isEmbedding
    have hexact : ∀ w, L' w = 0 ↔ ∃ u, incl u = w := by
      intro w
      have h1 : L' w = 0 ↔ L w = 0 := by
        rw [← hjL w]
        constructor
        · intro h; rw [h, map_zero]
        · intro h; exact hj_inj (h.trans (map_zero j).symm)
      rw [h1]
      constructor
      · intro h
        refine ⟨eN.symm ⟨w, LinearMap.mem_ker.mpr h⟩, ?_⟩
        show ((eN (eN.symm ⟨w, LinearMap.mem_ker.mpr h⟩) : N) : Fin a → ℚ_[ℓ]) = w
        rw [LinearEquiv.apply_symm_apply]
      · rintro ⟨u, rfl⟩
        exact LinearMap.mem_ker.mp (eN u).2
    obtain ⟨σ, hσ⟩ := LinearMap.exists_rightInverse_of_surjective L'
      (LinearMap.range_eq_top.mpr hL'surj)
    have hsec : ∃ s : (Fin d → ℚ_[ℓ]) → (Fin a → ℚ_[ℓ]), Continuous s ∧
        ∀ y, L'.toAddMonoidHom (s y) = y :=
      ⟨σ, LinearMap.continuous_of_finiteDimensional σ, fun y => LinearMap.congr_fun hσ y⟩
    obtain ⟨hzero, hSE⟩ := wc_contSheaf_shortExact S incl.toAddMonoidHom hinclc
      L'.toAddMonoidHom hL'c hemb hexact hsec
    obtain ⟨r, hr⟩ := LinearMap.exists_leftInverse_of_injective j (LinearMap.ker_eq_bot.mpr hj_inj)
    have hrc : Continuous (r.toAddMonoidHom : _ →+ _) := LinearMap.continuous_of_finiteDimensional r
    have key : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
        [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]
        (f : A →+ B) (hf : Continuous f) (U : (S.ProEt)ᵒᵖ)
        (x : ((wcContSheaf S A).obj.obj U : Type (u+1))),
        (wcContSheafMap S f hf).hom.app U x =
          (ULift.up (AddMonoidHom.compLeftContinuous
            (↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj
              (Opposite.unop U))) f hf
            (ULift.down x : C(↥((Scheme.ProEt.forget S ⋙
              Over.forget S).obj (Opposite.unop U)), A))) : _) := by
      intro A B _ _ _ _ _ _ f hf U x
      rfl
    have hjr : wcContSheafMap S j.toAddMonoidHom hjc ≫
        wcContSheafMap S r.toAddMonoidHom hrc = 𝟙 _ := by
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext U
      apply AddCommGrpCat.ext
      intro x
      rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply,
        key, key]
      apply ULift.ext
      apply ContinuousMap.ext
      intro z
      exact LinearMap.congr_fun hr _
    haveI : IsSplitMono (wcContSheafMap S j.toAddMonoidHom hjc) :=
      IsSplitMono.mk' ⟨_, hjr⟩
    have hcomp : wcContSheafMap S L.toAddMonoidHom
        (LinearMap.continuous_of_finiteDimensional L) =
        wcContSheafMap S L'.toAddMonoidHom hL'c ≫
          wcContSheafMap S j.toAddMonoidHom hjc := by
      rw [← (wc_contSheafMap_comp_sub S L'.toAddMonoidHom L'.toAddMonoidHom
        hL'c hL'c j.toAddMonoidHom hjc).1]
      apply congrMap
      exact AddMonoidHom.ext fun v => (hjL v).symm
    have hw : wcContSheafMap S incl.toAddMonoidHom hinclc ≫ wcContSheafMap S L.toAddMonoidHom
        (LinearMap.continuous_of_finiteDimensional L) = 0 := by
      rw [hcomp, ← Category.assoc, hzero, Limits.zero_comp]
    have hJl := Limits.isKernelCompMono hSE.fIsKernel (wcContSheafMap S j.toAddMonoidHom hjc) hcomp
    have hJρ := Limits.KernelFork.mapIsLimit _ hJl ρ

    have hm0 := Abelian.monoIsKernelOfCokernel _ (Limits.cokernelIsCokernel m)
    have hmρ := Limits.KernelFork.mapIsLimit _ hm0 ρ

    have hk : (ρ.map m ≫ tG.hom) ≫ ρ.map (wcContSheafMap S L.toAddMonoidHom
        (LinearMap.continuous_of_finiteDimensional L)) = 0 := by
      rw [Category.assoc, ← hsq, ← Functor.map_comp_assoc, Limits.cokernel.condition,
        Functor.map_zero, Limits.zero_comp]
    have hv0 : (ρ.map (wcContSheafMap S incl.toAddMonoidHom hinclc) ≫ tG.inv) ≫
        ρ.map (Limits.cokernel.π m) = 0 := by
      rw [Category.assoc, hsq', ← Functor.map_comp_assoc, hw, Functor.map_zero, Limits.zero_comp]
    obtain ⟨u, hu⟩ := Limits.KernelFork.IsLimit.lift' hJρ (ρ.map m ≫ tG.hom) hk
    obtain ⟨v, hv⟩ := Limits.KernelFork.IsLimit.lift' hmρ
      (ρ.map (wcContSheafMap S incl.toAddMonoidHom hinclc) ≫ tG.inv) hv0
    have hu' : u ≫ ρ.map (wcContSheafMap S incl.toAddMonoidHom hinclc) = ρ.map m ≫ tG.hom := hu
    have hv' : v ≫ ρ.map m = ρ.map (wcContSheafMap S incl.toAddMonoidHom hinclc) ≫ tG.inv := hv
    haveI : Mono (ρ.map m) := Limits.Fork.IsLimit.mono hmρ
    haveI : Mono (ρ.map (wcContSheafMap S incl.toAddMonoidHom hinclc)) :=
      Limits.Fork.IsLimit.mono hJρ
    have huv : u ≫ v = 𝟙 _ := by
      apply (cancel_mono (ρ.map m)).1
      rw [Category.assoc, hv', ← Category.assoc, hu', Category.assoc, Iso.hom_inv_id,
        Category.comp_id, Category.id_comp]
    have hvu : v ≫ u = 𝟙 _ := by
      apply (cancel_mono (ρ.map (wcContSheafMap S incl.toAddMonoidHom hinclc))).1
      rw [Category.assoc, hu', ← Category.assoc, hv', Category.assoc, Iso.inv_hom_id,
        Category.comp_id, Category.id_comp]

    have hscal : ∀ c : ℚ_[ℓ], wcContSheafMap S incl.toAddMonoidHom hinclc ≫
        wcConstScalar S ℓ a c = wcConstScalar S ℓ e0 c ≫
          wcContSheafMap S incl.toAddMonoidHom hinclc := by
      intro c
      unfold wcConstScalar
      rw [← (wc_contSheafMap_comp_sub S incl.toAddMonoidHom incl.toAddMonoidHom hinclc hinclc
          (DistribSMul.toAddMonoidHom (Fin a → ℚ_[ℓ]) c) (continuous_const_smul c)).1,
        ← (wc_contSheafMap_comp_sub S (DistribSMul.toAddMonoidHom (Fin e0 → ℚ_[ℓ]) c)
          (DistribSMul.toAddMonoidHom (Fin e0 → ℚ_[ℓ]) c) (continuous_const_smul c)
          (continuous_const_smul c) incl.toAddMonoidHom hinclc).1]
      apply congrMap
      exact AddMonoidHom.ext fun v => (incl.map_smul c v).symm
    refine ⟨e0, ⟨u, v, huv, hvu⟩, fun c => ?_⟩
    show ρ.map (σX c) ≫ u = u ≫ ρ.map (wcConstScalar S ℓ e0 c)
    apply (cancel_mono (ρ.map (wcContSheafMap S incl.toAddMonoidHom hinclc))).1
    have hLHS : (ρ.map (σX c) ≫ u) ≫ ρ.map (wcContSheafMap S incl.toAddMonoidHom hinclc) =
        ρ.map m ≫ tG.hom ≫ ρ.map (wcConstScalar S ℓ a c) := by
      rw [Category.assoc, hu', ← Functor.map_comp_assoc, hm c, Functor.map_comp_assoc, htG c]
    have hRHS : (u ≫ ρ.map (wcConstScalar S ℓ e0 c)) ≫
        ρ.map (wcContSheafMap S incl.toAddMonoidHom hinclc) =
        ρ.map m ≫ tG.hom ≫ ρ.map (wcConstScalar S ℓ a c) := by
      rw [Category.assoc, ← Functor.map_comp, ← hscal c, Functor.map_comp, ← Category.assoc, hu',
        Category.assoc]
    exact hLHS.trans hRHS.symm

theorem wc_scalarTriv_coker_of_const (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (W : S.ProEt) (hW : ConnectedSpace W.left)
    (X Z : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (σX : ℚ_[ℓ] → (X ⟶ X)) (e : ℕ) (hX : wcScalarTriv S ℓ X σX W e) (k : ℕ)
    (hZ : Nonempty (Z.over W ≅ (wcContSheaf S (Fin k → ℚ_[ℓ])).over W)) (i : Z ⟶ X)
    (σY : ℚ_[ℓ] → (Limits.cokernel i ⟶ Limits.cokernel i))
    (hσ : ∀ c : ℚ_[ℓ], Limits.cokernel.π i ≫ σY c = σX c ≫ Limits.cokernel.π i) :
    ∃ r : ℕ, wcScalarTriv S ℓ (Limits.cokernel i) σY W r :=
by
  classical
  have congrMap : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]
      (f g : A →+ B) (hf : Continuous f) (hg : Continuous g), f = g →
      wcContSheafMap S f hf = wcContSheafMap S g hg := by
    intro A B _ _ _ _ _ _ f g hf hg hfg
    subst hfg
    rfl
  have key : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]
      (f : A →+ B) (hf : Continuous f) (U : (S.ProEt)ᵒᵖ)
      (x : ((wcContSheaf S A).obj.obj U : Type (u+1))),
      (wcContSheafMap S f hf).hom.app U x =
        (ULift.up (AddMonoidHom.compLeftContinuous
          (↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U))) f hf
          (ULift.down x : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), A))) :
          _) := by
    intro A B _ _ _ _ _ _ f hf U x
    rfl

  have wc_contSheafMap_comp_sub : ∀ (S : Scheme.{u}) {A B C : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A] [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B] [AddCommGroup C] [TopologicalSpace C] [IsTopologicalAddGroup C] (φ φ' : A →+ B) (hφ : Continuous φ) (hφ' : Continuous φ') (ψ : B →+ C) (hψ : Continuous ψ), wcContSheafMap S (ψ.comp φ) (hψ.comp hφ) = wcContSheafMap S φ hφ ≫ wcContSheafMap S ψ hψ ∧ wcContSheafMap S (φ - φ') (hφ.sub hφ') = wcContSheafMap S φ hφ - wcContSheafMap S φ' hφ' := by
    intro S A B C _ _ _ _ _ _ _ _ _ φ φ' hφ hφ' ψ hψ
    have key : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
        [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]
        (φ : A →+ B) (hφ : Continuous φ) (U : (S.ProEt)ᵒᵖ)
        (x : ((wcContSheaf S A).obj.obj U : Type (u+1))),
        (wcContSheafMap S φ hφ).hom.app U x =
          (ULift.up (AddMonoidHom.compLeftContinuous
            (↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U))) φ hφ
            (ULift.down x : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), A))) : _) := by
      intro A B _ _ _ _ _ _ φ hφ U x
      rfl
    refine ⟨?_, ?_⟩
    · apply Sheaf.hom_ext
      apply NatTrans.ext
      funext U
      apply AddCommGrpCat.ext
      intro x
      rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply,
        key, key, key]
      rfl
    · apply eq_sub_of_add_eq
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext U
      apply AddCommGrpCat.ext
      intro x
      rw [Sheaf.Hom.add_app, AddCommGrpCat.hom_add_apply, key, key]
      apply ULift.ext
      apply ContinuousMap.ext
      intro a
      exact sub_add_cancel _ _
  have wc_contSheaf_shortExact : ∀ (S : Scheme.{u}) {A B C : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A] [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B] [AddCommGroup C] [TopologicalSpace C] [IsTopologicalAddGroup C] (φ : A →+ B) (hφ : Continuous φ) (ψ : B →+ C) (hψ : Continuous ψ), Topology.IsEmbedding φ → (∀ b : B, ψ b = 0 ↔ ∃ a : A, φ a = b) → (∃ σ : C → B, Continuous σ ∧ ∀ c, ψ (σ c) = c) → ∃ hzero : wcContSheafMap S φ hφ ≫ wcContSheafMap S ψ hψ = 0, (ShortComplex.mk (wcContSheafMap S φ hφ) (wcContSheafMap S ψ hψ) hzero).ShortExact := by
    intro S A B C _ _ _ _ _ _ _ _ _ φ hφ ψ hψ hemb hker hsec
    obtain ⟨σ, hσc, hσ⟩ := hsec
    have crit : ∀ {F G H : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (f : F ⟶ G)
        (g : G ⟶ H),
        (∀ U (x : F.obj.obj U), g.hom.app U (f.hom.app U x) = 0) →
        (∀ U, Function.Injective (f.hom.app U)) →
        (∀ U, Function.Surjective (g.hom.app U)) →
        (∀ U (x : G.obj.obj U), g.hom.app U x = 0 → ∃ y, f.hom.app U y = x) →
        ∃ hzero : f ≫ g = 0, (ShortComplex.mk f g hzero).ShortExact := by
      intro F G H f g h1 h0 h2 h3
      have hzero : ∀ {X Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (U : S.ProEtᵒᵖ)
          (y : X.obj.obj U), (0 : X ⟶ Y).hom.app U y = 0 := by
        intro X Y U y
        rfl
      have hcomp : ∀ {X Y Z : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (p : X ⟶ Y)
          (q : Y ⟶ Z) (U : S.ProEtᵒᵖ) (y : X.obj.obj U),
          (p ≫ q).hom.app U y = q.hom.app U (p.hom.app U y) := by
        intro X Y Z p q U y
        rfl
      have w : f ≫ g = 0 := by
        apply Sheaf.hom_ext
        ext U x
        rw [hcomp, hzero, h1]
      haveI : Epi g := by
        haveI : ∀ U, Epi (g.hom.app U) := fun U => (AddCommGrpCat.epi_iff_surjective _).mpr (h2 U)
        haveI : Epi g.hom := NatTrans.epi_of_epi_app _
        exact Sheaf.Hom.epi_of_presheaf_epi _ _ _
      haveI : Mono f := by
        haveI : ∀ U, Mono (f.hom.app U) := fun U => (AddCommGrpCat.mono_iff_injective _).mpr (h0 U)
        haveI : Mono f.hom := NatTrans.mono_of_mono_app _
        exact Sheaf.Hom.mono_of_presheaf_mono _ _ _
      have fac : ∀ {A : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (k : G ⟶ A),
          f ≫ k = 0 → {l : H ⟶ A // g ≫ l = k} := by
        intro A k hk
        have hk' : ∀ U (y : F.obj.obj U), k.hom.app U (f.hom.app U y) = 0 := by
          intro U y
          have := congrArg (fun φ => φ.hom.app U y) hk
          simp only at this
          rw [hcomp, hzero] at this
          exact this
        have hd : ∀ U (x x' : G.obj.obj U), g.hom.app U x = g.hom.app U x' →
            k.hom.app U x = k.hom.app U x' := by
          intro U x x' hxx
          obtain ⟨y, hy⟩ := h3 U (x - x') (by rw [map_sub, hxx, sub_self])
          have := hk' U y
          rw [hy, map_sub, sub_eq_zero] at this
          exact this
        let σ : ∀ U, H.obj.obj U → G.obj.obj U := fun U => Function.surjInv (h2 U)
        have hσ : ∀ U φ, g.hom.app U (σ U φ) = φ := fun U φ => Function.surjInv_eq (h2 U) φ
        let lU : ∀ U, H.obj.obj U ⟶ A.obj.obj U := fun U => AddCommGrpCat.ofHom
          (AddMonoidHom.mk' (fun φ => k.hom.app U (σ U φ)) (by
            intro φ ψ
            rw [← map_add]
            apply hd
            rw [map_add, hσ, hσ, hσ]))
        have hlU : ∀ U φ, lU U φ = k.hom.app U (σ U φ) := fun U φ => rfl
        let l : H ⟶ A := ObjectProperty.homMk
          { app := lU
            naturality := by
              intro U V r
              ext φ
              rw [CategoryTheory.comp_apply, CategoryTheory.comp_apply, hlU, hlU,
                ← NatTrans.naturality_apply]
              apply hd
              rw [hσ, NatTrans.naturality_apply, hσ] }
        refine ⟨l, ?_⟩
        apply Sheaf.hom_ext
        ext U x
        rw [hcomp]
        change lU U (g.hom.app U x) = k.hom.app U x
        rw [hlU]
        apply hd
        rw [hσ]
      refine ⟨w, ShortComplex.ShortExact.mk' ?_ inferInstance inferInstance⟩
      exact ShortComplex.exact_of_g_is_cokernel _ (Limits.CokernelCofork.IsColimit.ofπ' g w fac)
    refine crit (wcContSheafMap S φ hφ) (wcContSheafMap S ψ hψ) ?_ ?_ ?_ ?_
    · intro U x
      let x0 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), A) := x.down
      apply ULift.ext
      apply ContinuousMap.ext
      intro t
      change ψ (φ (x0 t)) = 0
      exact (hker _).mpr ⟨_, rfl⟩
    · intro U x x' hxx
      let x0 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), A) := x.down
      let x1 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), A) := x'.down
      apply ULift.ext
      apply ContinuousMap.ext
      intro t
      have h := congrArg (fun z => (ULift.down z :
        C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), B)) t) hxx
      have h' : φ (x0 t) = φ (x1 t) := h
      exact hemb.injective h'
    · intro U z
      let z0 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), C) := z.down
      refine ⟨ULift.up (⟨fun t => σ (z0 t), hσc.comp z0.continuous⟩ :
        C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), B)), ?_⟩
      apply ULift.ext
      apply ContinuousMap.ext
      intro t
      change ψ (σ (z0 t)) = z0 t
      exact hσ _
    · intro U x hx
      let y0 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), B) := x.down
      have hx' : ∀ t, ψ (y0 t) = 0 := by
        intro t
        have := congrArg (fun z => (ULift.down z :
          C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), C)) t) hx
        exact this
      choose k hk using fun t => (hker (y0 t)).mp (hx' t)
      have hkc : Continuous k := by
        rw [hemb.continuous_iff]
        have e : (⇑φ ∘ k) = ⇑y0 := funext hk
        rw [e]
        exact y0.continuous
      refine ⟨ULift.up (⟨k, hkc⟩ :
        C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), A)), ?_⟩
      apply ULift.ext
      apply ContinuousMap.ext
      intro t
      change φ (k t) = y0 t
      exact hk t

  have s2 : ∀ (I : (Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin e → ℚ_[ℓ])),
      ∃ (r : ℕ) (Q : (Fin e → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]))
        (w : wcContSheafMap S I.toAddMonoidHom (LinearMap.continuous_of_finiteDimensional I) ≫
          wcContSheafMap S Q.toAddMonoidHom (LinearMap.continuous_of_finiteDimensional Q) = 0),
        Nonempty (Limits.IsColimit (Limits.CokernelCofork.ofπ _ w)) := by
    intro I
    let R := LinearMap.range I
    let d := Module.finrank ℚ_[ℓ] R
    let eR : (Fin d → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] R :=
      LinearEquiv.ofFinrankEq _ _ (Module.finrank_fin_fun ℚ_[ℓ])
    let I' : (Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin d → ℚ_[ℓ]) := eR.symm.toLinearMap ∘ₗ I.rangeRestrict
    let j : (Fin d → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin e → ℚ_[ℓ]) := R.subtype ∘ₗ eR.toLinearMap
    have hj_inj : Function.Injective j := Subtype.val_injective.comp eR.injective
    have hI'surj : Function.Surjective I' := eR.symm.surjective.comp I.surjective_rangeRestrict
    have hjI : ∀ v, j (I' v) = I v := by
      intro v
      show ((eR (eR.symm (I.rangeRestrict v)) : R) : Fin e → ℚ_[ℓ]) = I v
      rw [LinearEquiv.apply_symm_apply]
      rfl
    let r := Module.finrank ℚ_[ℓ] ((Fin e → ℚ_[ℓ]) ⧸ R)
    let eQ : ((Fin e → ℚ_[ℓ]) ⧸ R) ≃ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]) :=
      LinearEquiv.ofFinrankEq _ _ (Module.finrank_fin_fun ℚ_[ℓ]).symm
    let Q : (Fin e → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]) := eQ.toLinearMap ∘ₗ R.mkQ
    have hQsurj : Function.Surjective Q := eQ.surjective.comp R.mkQ_surjective
    have hI'c : Continuous (I'.toAddMonoidHom : _ →+ _) :=
      LinearMap.continuous_of_finiteDimensional I'
    have hjc : Continuous (j.toAddMonoidHom : _ →+ _) :=
      LinearMap.continuous_of_finiteDimensional j
    have hQc : Continuous (Q.toAddMonoidHom : _ →+ _) :=
      LinearMap.continuous_of_finiteDimensional Q
    have hemb : Topology.IsEmbedding j :=
      (LinearMap.isClosedEmbedding_of_injective (LinearMap.ker_eq_bot.mpr hj_inj)).isEmbedding
    have hexact : ∀ w, Q w = 0 ↔ ∃ u, j u = w := by
      intro w
      have h1 : Q w = 0 ↔ w ∈ R := by
        show eQ (R.mkQ w) = 0 ↔ w ∈ R
        rw [LinearEquiv.map_eq_zero_iff, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
      rw [h1]
      constructor
      · intro h
        refine ⟨eR.symm ⟨w, h⟩, ?_⟩
        show ((eR (eR.symm ⟨w, h⟩) : R) : Fin e → ℚ_[ℓ]) = w
        rw [LinearEquiv.apply_symm_apply]
      · rintro ⟨u, rfl⟩
        exact (eR u).2
    obtain ⟨σQ, hσQ⟩ := LinearMap.exists_rightInverse_of_surjective Q
      (LinearMap.range_eq_top.mpr hQsurj)
    have hsec : ∃ s : (Fin r → ℚ_[ℓ]) → (Fin e → ℚ_[ℓ]), Continuous s ∧
        ∀ y, Q.toAddMonoidHom (s y) = y :=
      ⟨σQ, LinearMap.continuous_of_finiteDimensional σQ, fun y => LinearMap.congr_fun hσQ y⟩
    obtain ⟨hzero, hSE⟩ := wc_contSheaf_shortExact S j.toAddMonoidHom hjc
      Q.toAddMonoidHom hQc hemb hexact hsec

    obtain ⟨s, hs⟩ := LinearMap.exists_rightInverse_of_surjective I'
      (LinearMap.range_eq_top.mpr hI'surj)
    have hsc : Continuous (s.toAddMonoidHom : _ →+ _) := LinearMap.continuous_of_finiteDimensional s
    have hsI : wcContSheafMap S s.toAddMonoidHom hsc ≫
        wcContSheafMap S I'.toAddMonoidHom hI'c = 𝟙 _ := by
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext U
      apply AddCommGrpCat.ext
      intro x
      rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply,
        key, key]
      apply ULift.ext
      apply ContinuousMap.ext
      intro z
      exact LinearMap.congr_fun hs _
    haveI : IsSplitEpi (wcContSheafMap S I'.toAddMonoidHom hI'c) := IsSplitEpi.mk' ⟨_, hsI⟩
    have hcomp : wcContSheafMap S I.toAddMonoidHom (LinearMap.continuous_of_finiteDimensional I) =
        wcContSheafMap S I'.toAddMonoidHom hI'c ≫ wcContSheafMap S j.toAddMonoidHom hjc := by
      rw [← (wc_contSheafMap_comp_sub S I'.toAddMonoidHom I'.toAddMonoidHom
        hI'c hI'c j.toAddMonoidHom hjc).1]
      apply congrMap
      exact AddMonoidHom.ext fun v => (hjI v).symm
    have w : wcContSheafMap S I.toAddMonoidHom (LinearMap.continuous_of_finiteDimensional I) ≫
        wcContSheafMap S Q.toAddMonoidHom hQc = 0 := by
      rw [hcomp, Category.assoc, hzero, Limits.comp_zero]
    exact ⟨r, Q, w, ⟨Limits.isCokernelEpiComp hSE.gIsCokernel _ hcomp⟩⟩

  obtain ⟨tX, hXc⟩ := hX
  obtain ⟨tZ⟩ := hZ
  set ρ := (Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W with hρ
  have adj := (Over.forget W).sheafAdjunctionCocontinuous AddCommGrpCat.{u+1}
    ((Scheme.ProEt.topology S).over W) (Scheme.ProEt.topology S)
  haveI : ρ.IsLeftAdjoint := ⟨_, ⟨adj⟩⟩
  obtain ⟨φ, hφ⟩ : ∃ φ : (wcContSheaf S (Fin k → ℚ_[ℓ])).over W ⟶
      (wcContSheaf S (Fin e → ℚ_[ℓ])).over W, φ = tZ.inv ≫ ρ.map i ≫ tX.hom := ⟨_, rfl⟩
  obtain ⟨I, hI⟩ := wc_contSheaf_over_hom_linear S ℓ W hW k e φ
  obtain ⟨r, Q, wQ, ⟨hQ⟩⟩ := s2 I
  set cI := wcContSheafMap S I.toAddMonoidHom (LinearMap.continuous_of_finiteDimensional I)
    with hcI
  set cQ := wcContSheafMap S Q.toAddMonoidHom (LinearMap.continuous_of_finiteDimensional Q)
    with hcQ
  set π := Limits.cokernel.π i with hπdef
  have hρi : ρ.map i ≫ tX.hom = tZ.hom ≫ ρ.map cI := by
    rw [← hI, hφ, Iso.hom_inv_id_assoc]
  have hρi' : ρ.map cI ≫ tX.inv = tZ.inv ≫ ρ.map i := by
    rw [← hI, hφ]
    simp only [Category.assoc, Iso.hom_inv_id, Category.comp_id]
  have w1 : ρ.map i ≫ ρ.map π = 0 := by
    rw [← ρ.map_comp, hπdef, Limits.cokernel.condition, ρ.map_zero]
  have hπ : Limits.IsColimit (Limits.CokernelCofork.ofπ (ρ.map π) w1) :=
    Limits.CokernelCofork.mapIsColimit _ (Limits.cokernelIsCokernel i) ρ
  have w2 : ρ.map cI ≫ ρ.map cQ = 0 := by
    rw [← ρ.map_comp, wQ, ρ.map_zero]
  have hQρ : Limits.IsColimit (Limits.CokernelCofork.ofπ (ρ.map cQ) w2) :=
    Limits.CokernelCofork.mapIsColimit _ hQ ρ
  have h1 : ρ.map i ≫ (tX.hom ≫ ρ.map cQ) = 0 := by
    rw [← Category.assoc, hρi, Category.assoc, w2, Limits.comp_zero]
  have h2 : ρ.map cI ≫ (tX.inv ≫ ρ.map π) = 0 := by
    rw [← Category.assoc, hρi', Category.assoc, w1, Limits.comp_zero]
  obtain ⟨Th, hTh⟩ := Limits.CokernelCofork.IsColimit.desc' hπ _ h1
  obtain ⟨Ti, hTi⟩ := Limits.CokernelCofork.IsColimit.desc' hQρ _ h2
  have hTh' : ρ.map π ≫ Th = tX.hom ≫ ρ.map cQ := hTh
  have hTi' : ρ.map cQ ≫ Ti = tX.inv ≫ ρ.map π := hTi
  have hhi : Th ≫ Ti = 𝟙 _ := by
    apply Limits.Cofork.IsColimit.hom_ext hπ
    show ρ.map π ≫ Th ≫ Ti = ρ.map π ≫ 𝟙 _
    rw [← Category.assoc, hTh', Category.assoc, hTi', Iso.hom_inv_id_assoc, Category.comp_id]
  have hih : Ti ≫ Th = 𝟙 _ := by
    apply Limits.Cofork.IsColimit.hom_ext hQρ
    show ρ.map cQ ≫ Ti ≫ Th = ρ.map cQ ≫ 𝟙 _
    rw [← Category.assoc, hTi', Category.assoc, hTh', Iso.inv_hom_id_assoc, Category.comp_id]
  let T : (Limits.cokernel i).over W ≅ (wcContSheaf S (Fin r → ℚ_[ℓ])).over W :=
    ⟨Th, Ti, hhi, hih⟩

  have hQs : ∀ c : ℚ_[ℓ], wcConstScalar S ℓ e c ≫ cQ = cQ ≫ wcConstScalar S ℓ r c := by
    intro c
    have e1 := (wc_contSheafMap_comp_sub S (DistribSMul.toAddMonoidHom (Fin e → ℚ_[ℓ]) c)
      (DistribSMul.toAddMonoidHom (Fin e → ℚ_[ℓ]) c) (continuous_const_smul c)
      (continuous_const_smul c) Q.toAddMonoidHom (LinearMap.continuous_of_finiteDimensional Q)).1
    have e2 := (wc_contSheafMap_comp_sub S Q.toAddMonoidHom Q.toAddMonoidHom
      (LinearMap.continuous_of_finiteDimensional Q) (LinearMap.continuous_of_finiteDimensional Q)
      (DistribSMul.toAddMonoidHom (Fin r → ℚ_[ℓ]) c) (continuous_const_smul c)).1
    show wcContSheafMap S (DistribSMul.toAddMonoidHom (Fin e → ℚ_[ℓ]) c) (continuous_const_smul c) ≫
        wcContSheafMap S Q.toAddMonoidHom (LinearMap.continuous_of_finiteDimensional Q) =
      wcContSheafMap S Q.toAddMonoidHom (LinearMap.continuous_of_finiteDimensional Q) ≫
        wcContSheafMap S (DistribSMul.toAddMonoidHom (Fin r → ℚ_[ℓ]) c) (continuous_const_smul c)
    rw [← e1, ← e2]
    apply congrMap
    exact AddMonoidHom.ext fun v => map_smul Q c v

  have hscal : ∀ c : ℚ_[ℓ], ρ.map (σY c) ≫ T.hom = T.hom ≫ ρ.map (wcConstScalar S ℓ r c) := by
    intro c
    show ρ.map (σY c) ≫ Th = Th ≫ ρ.map (wcConstScalar S ℓ r c)
    apply Limits.Cofork.IsColimit.hom_ext hπ
    show ρ.map π ≫ ρ.map (σY c) ≫ Th = ρ.map π ≫ Th ≫ ρ.map (wcConstScalar S ℓ r c)
    calc ρ.map π ≫ ρ.map (σY c) ≫ Th
        = ρ.map (π ≫ σY c) ≫ Th := by rw [ρ.map_comp, Category.assoc]
      _ = ρ.map (σX c ≫ π) ≫ Th := by rw [hπdef, hσ c]
      _ = ρ.map (σX c) ≫ (ρ.map π ≫ Th) := by rw [ρ.map_comp, Category.assoc]
      _ = ρ.map (σX c) ≫ (tX.hom ≫ ρ.map cQ) := by rw [hTh']
      _ = (ρ.map (σX c) ≫ tX.hom) ≫ ρ.map cQ := by rw [Category.assoc]
      _ = (tX.hom ≫ ρ.map (wcConstScalar S ℓ e c)) ≫ ρ.map cQ := by rw [hXc c]
      _ = tX.hom ≫ ρ.map (wcConstScalar S ℓ e c ≫ cQ) := by rw [ρ.map_comp, Category.assoc]
      _ = tX.hom ≫ ρ.map (cQ ≫ wcConstScalar S ℓ r c) := by rw [hQs c]
      _ = (tX.hom ≫ ρ.map cQ) ≫ ρ.map (wcConstScalar S ℓ r c) := by
          rw [ρ.map_comp, Category.assoc]
      _ = (ρ.map π ≫ Th) ≫ ρ.map (wcConstScalar S ℓ r c) := by rw [hTh']
      _ = ρ.map π ≫ Th ≫ ρ.map (wcConstScalar S ℓ r c) := by rw [Category.assoc]
  exact ⟨r, T, hscal⟩

theorem wc_pencil_VQScalar_spec (F' F'' : Type u) [Field F'] [Field F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (c : ℚ_[ℓ]) :
    ∃ ψ : Subobject.underlying.obj (wcPencilE D ℓ hP) ⟶
        Subobject.underlying.obj (wcPencilE D ℓ hP),
      ψ ≫ (wcPencilE D ℓ hP).arrow = (wcPencilE D ℓ hP).arrow ≫ wcRqScalar D.f ℓ (n - 1) c ∧
      Limits.cokernel.π ((wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP).ofLE (wcPencilE D ℓ hP)
          inf_le_left) ≫ wcPencilVQScalar D ℓ hP c =
        ψ ≫ Limits.cokernel.π ((wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP).ofLE (wcPencilE D ℓ hP)
          inf_le_left) :=
by
  classical

  have htop : ∀ M : Subobject (wcRq D.f ℓ (n - 1)), M = ⊤ → wcPencilStable D ℓ M := by
    rintro M rfl c'
    exact ⟨(⊤ : Subobject (wcRq D.f ℓ (n - 1))).factorThru
      ((⊤ : Subobject (wcRq D.f ℓ (n - 1))).arrow ≫ wcRqScalar D.f ℓ (n - 1) c')
      (Subobject.top_factors _), Subobject.factorThru_arrow _ _ _⟩
  have hE : wcPencilStable D ℓ (wcPencilE D ℓ hP) := by
    unfold wcPencilE
    split
    · next h => exact (Classical.choose_spec h).1
    · exact htop _ rfl
  have hC : wcPencilStable D ℓ (wcPencilC D ℓ hP) := by
    unfold wcPencilC
    split
    · next h => exact (Classical.choose_spec h).1
    · exact htop _ rfl

  have key : ∀ (E C : Subobject (wcRq D.f ℓ (n - 1)))
      (ρ : wcRq D.f ℓ (n - 1) ⟶ wcRq D.f ℓ (n - 1))
      (ψE : Subobject.underlying.obj E ⟶ Subobject.underlying.obj E),
      ψE ≫ E.arrow = E.arrow ≫ ρ →
      (∃ ψC : Subobject.underlying.obj C ⟶ Subobject.underlying.obj C,
        ψC ≫ C.arrow = C.arrow ≫ ρ) →
      ∃ φ : Limits.cokernel ((E ⊓ C).ofLE E inf_le_left) ⟶
          Limits.cokernel ((E ⊓ C).ofLE E inf_le_left),
        Limits.cokernel.π ((E ⊓ C).ofLE E inf_le_left) ≫ φ =
          ψE ≫ Limits.cokernel.π ((E ⊓ C).ofLE E inf_le_left) := by
    intro E C ρ ψE hψE ⟨ψC, hψC⟩
    have hfE : E.Factors ((E ⊓ C).arrow ≫ ρ) := by
      have h1 : (E ⊓ C).arrow ≫ ρ = ((E ⊓ C).ofLE E inf_le_left ≫ ψE) ≫ E.arrow := by
        rw [Category.assoc, hψE, ← Category.assoc, Subobject.ofLE_arrow]
      rw [h1]
      exact Subobject.factors_comp_arrow _
    have hfC : C.Factors ((E ⊓ C).arrow ≫ ρ) := by
      have h1 : (E ⊓ C).arrow ≫ ρ = ((E ⊓ C).ofLE C inf_le_right ≫ ψC) ≫ C.arrow := by
        rw [Category.assoc, hψC, ← Category.assoc, Subobject.ofLE_arrow]
      rw [h1]
      exact Subobject.factors_comp_arrow _
    have hfEC : (E ⊓ C).Factors ((E ⊓ C).arrow ≫ ρ) :=
      (Subobject.inf_factors _).mpr ⟨hfE, hfC⟩
    have hcomm : (E ⊓ C).ofLE E inf_le_left ≫ ψE =
        (E ⊓ C).factorThru _ hfEC ≫ (E ⊓ C).ofLE E inf_le_left := by
      rw [← cancel_mono E.arrow, Category.assoc, hψE, ← Category.assoc, Subobject.ofLE_arrow,
        Category.assoc, Subobject.ofLE_arrow, Subobject.factorThru_arrow]
    have hzero : (E ⊓ C).ofLE E inf_le_left ≫ ψE ≫
        Limits.cokernel.π ((E ⊓ C).ofLE E inf_le_left) = 0 := by
      rw [← Category.assoc, hcomm, Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
    exact ⟨Limits.cokernel.desc _ _ hzero, Limits.cokernel.π_desc _ _ _⟩
  obtain ⟨ψE, hψE⟩ := hE c
  obtain ⟨φ, hφ⟩ := key _ _ _ ψE hψE (hC c)
  have hc : ∃ (ψ : Subobject.underlying.obj (wcPencilE D ℓ hP) ⟶
        Subobject.underlying.obj (wcPencilE D ℓ hP))
      (φ : wcPencilVQ D ℓ hP ⟶ wcPencilVQ D ℓ hP),
      ψ ≫ (wcPencilE D ℓ hP).arrow = (wcPencilE D ℓ hP).arrow ≫ wcRqScalar D.f ℓ (n - 1) c ∧
      Limits.cokernel.π (Subobject.ofLE (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP) (wcPencilE D ℓ hP)
        inf_le_left) ≫ φ =
        ψ ≫ Limits.cokernel.π (Subobject.ofLE (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP)
          (wcPencilE D ℓ hP) inf_le_left) :=
    ⟨ψE, φ, hψE, hφ⟩
  unfold wcPencilVQScalar
  split
  · next h => exact ⟨_, Classical.choose_spec (Classical.choose_spec h)⟩
  · next h => exact absurd hc h

theorem wc_pencil_VQ_cover_triv (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hNI : ∃ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β ∧
      β ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n)) :
    ∃ (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (r : ℕ),
      (∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left,
        (∀ i, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠ D.S i (IsLocalRing.closedPoint F'')) →
        ∃ z : W.left, w.left z = p) ∧
      wcScalarTriv (wcP1Over F'').left ℓ (wcPencilVQ D ℓ hP) (wcPencilVQScalar D ℓ hP) W r :=
by
  classical

  obtain ⟨W, w, a, hconn, hcov, hR⟩ :=
    wc_pencil_Rq_scalar_triv_cover F' F'' Y n D ℓ hℓ hP (n - 1)

  choose ψ hψE hψπ using wc_pencil_VQScalar_spec F' F'' Y n D ℓ hP

  have restr : ∀ (G : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}),
      wcPencilGC F'' hP ℓ G → ∃ b : ℕ,
        Nonempty (G.over W ≅ (wcContSheaf (wcP1Over F'').left (Fin b → ℚ_[ℓ])).over W) := by
    intro G hG
    obtain ⟨b, ⟨θ⟩⟩ := hG
    exact ⟨b, ⟨((Scheme.ProEt.topology (wcP1Over F'').left).overMapPullback
      AddCommGrpCat.{u+1} w).mapIso θ⟩⟩

  have hcok : IsIso (wcPencilE D ℓ hP).arrow ∨ ∃ b : ℕ,
      Nonempty ((Limits.cokernel (wcPencilE D ℓ hP).arrow).over W ≅
        (wcContSheaf (wcP1Over F'').left (Fin b → ℚ_[ℓ])).over W) := by
    by_cases h : ∃ M : Subobject (wcRq D.f ℓ (n - 1)), wcPencilStable D ℓ M ∧
        wcPencilGC F'' hP ℓ (Limits.cokernel M.arrow) ∧
        ∀ M' : Subobject (wcRq D.f ℓ (n - 1)), wcPencilStable D ℓ M' →
          wcPencilGC F'' hP ℓ (Limits.cokernel M'.arrow) → M ≤ M'
    · have hE : wcPencilE D ℓ hP = Classical.choose h := dif_pos h
      have hgc : wcPencilGC F'' hP ℓ (Limits.cokernel (wcPencilE D ℓ hP).arrow) := by
        rw [hE]; exact (Classical.choose_spec h).2.1
      exact Or.inr (restr _ hgc)
    · have hE : wcPencilE D ℓ hP = ⊤ := dif_neg h
      left
      rw [hE]
      infer_instance

  obtain ⟨e, hEW⟩ := wc_scalarTriv_sub_of_coker_const (wcP1Over F'').left ℓ W hconn
    (wcRq D.f ℓ (n - 1)) (Subobject.underlying.obj (wcPencilE D ℓ hP))
    (wcRqScalar D.f ℓ (n - 1)) ψ a hR (wcPencilE D ℓ hP).arrow hψE hcok

  obtain ⟨k, hZ⟩ := restr _ (wc_pencil_EC_geomConst F' F'' Y n hn hn2 D ℓ hℓ hP)

  obtain ⟨r, hVQ⟩ := wc_scalarTriv_coker_of_const (wcP1Over F'').left ℓ W hconn
    (Subobject.underlying.obj (wcPencilE D ℓ hP))
    (Subobject.underlying.obj (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP)) ψ e hEW k hZ
    ((wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP).ofLE (wcPencilE D ℓ hP) inf_le_left)
    (wcPencilVQScalar D ℓ hP) hψπ

  exact ⟨W, w, r, hcov, hVQ⟩

theorem wc_proet_scalarTriv_strict_local (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (r m : ℕ)
    (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left)) (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP)
    (hcov : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left,
      (∀ i, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ z : W.left, w.left z = p)
    (hW : wcScalarTriv (wcP1Over K).left ℓ G σ W r)
    (V : (wcP1Over K).left.ProEt) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (e : V.left ≅ Spec (.of A))
    (hx : ∀ i, V.hom (e.inv (IsLocalRing.closedPoint A)) ≠ S i (IsLocalRing.closedPoint K)) :
    wcScalarTriv (wcP1Over K).left ℓ G σ V r :=
by
  classical

  have transfer : ∀ (V' W' : (wcP1Over K).left.ProEt) (h : V' ⟶ W'),
      wcScalarTriv (wcP1Over K).left ℓ G σ W' r → wcScalarTriv (wcP1Over K).left ℓ G σ V' r := by
    intro V' W' h hW'
    obtain ⟨t, ht⟩ := hW'
    let ε : (Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W' ⋙
        (Scheme.ProEt.topology (wcP1Over K).left).overMapPullback AddCommGrpCat.{u+1} h ≅
        (Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} V' :=
      Functor.sheafPushforwardContinuousComp' (Over.mapForget h) AddCommGrpCat.{u+1}
        ((Scheme.ProEt.topology (wcP1Over K).left).over V')
        ((Scheme.ProEt.topology (wcP1Over K).left).over W')
        (Scheme.ProEt.topology (wcP1Over K).left)
    refine ⟨(ε.app G).symm ≪≫
      ((Scheme.ProEt.topology (wcP1Over K).left).overMapPullback AddCommGrpCat.{u+1} h).mapIso t ≪≫
      ε.app _, ?_⟩
    intro c
    have n1 := ε.inv.naturality (σ c)
    have n2 := ε.hom.naturality (wcConstScalar (wcP1Over K).left ℓ r c)
    simp only [Functor.comp_map] at n1 n2
    simp only [Iso.trans_hom, Iso.symm_hom, Iso.app_inv, Iso.app_hom, Functor.mapIso_hom,
      Category.assoc]
    rw [← Category.assoc, n1, Category.assoc, ← Functor.map_comp_assoc, ht c,
      Functor.map_comp_assoc, n2]

  haveI hsub : Subsingleton ↥(Spec (CommRingCat.of K)) :=
    inferInstanceAs (Subsingleton (PrimeSpectrum K))
  have hπ : (wcP1Over K).hom (V.hom (e.inv (IsLocalRing.closedPoint A))) =
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))
        (IsLocalRing.closedPoint (AlgebraicClosure K)) := Subsingleton.elim _ _
  obtain ⟨p, hp1, -⟩ := Scheme.Pullback.exists_preimage_pullback _ _ hπ
  have hp : (wcGeomPoint K (wcP1Over K) hP).hom p = V.hom (e.inv (IsLocalRing.closedPoint A)) :=
    hp1

  obtain ⟨z, hz⟩ := hcov p (fun i => by rw [hp]; exact hx i)
  have hWz : W.hom z = V.hom (e.inv (IsLocalRing.closedPoint A)) := by
    rw [← MorphismProperty.Over.w w, Scheme.Hom.comp_apply, hz, hp]

  obtain ⟨t, ht1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := V.hom) (g := W.hom)
    (e.inv (IsLocalRing.closedPoint A)) z hWz.symm
  have hq : WeaklyEtale (Limits.pullback.fst V.hom W.hom) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback V.hom W.hom).flip
      W.prop

  haveI : WeaklyEtale (Limits.pullback.fst V.hom W.hom) := hq
  haveI : WeaklyEtale ((Limits.pullback V.hom W.hom).fromSpecStalk t) :=
    wc_fromSpecStalk_weaklyEtale _ t
  obtain ⟨k, hkdef⟩ : ∃ k, k = (Limits.pullback V.hom W.hom).fromSpecStalk t ≫
      Limits.pullback.fst V.hom W.hom ≫ e.hom := ⟨_, rfl⟩
  have hk : WeaklyEtale k := by rw [hkdef]; infer_instance
  have hφ : Spec.map (Spec.preimage k) = k := Spec.map_preimage k
  have hk' : WeaklyEtale (Spec.map (CommRingCat.ofHom (Spec.preimage k).hom)) := by
    change WeaklyEtale (Spec.map (Spec.preimage k))
    rw [hφ]; exact hk
  letI := (Spec.preimage k).hom.toAlgebra
  have hWE := wc_lpkt_specMap_weaklyEtale_ring _ _ (Spec.preimage k).hom hk'
  have hk_pt : k (IsLocalRing.closedPoint ((Limits.pullback V.hom W.hom).presheaf.stalk t)) =
      IsLocalRing.closedPoint A := by
    have h1 : k (IsLocalRing.closedPoint ((Limits.pullback V.hom W.hom).presheaf.stalk t)) =
        e.hom ((Limits.pullback.fst V.hom W.hom) ((Limits.pullback V.hom W.hom).fromSpecStalk t
          (IsLocalRing.closedPoint ((Limits.pullback V.hom W.hom).presheaf.stalk t)))) := by
      subst hkdef
      first | rfl | simp [Scheme.Hom.comp_apply]
    have h2 : ∀ y : Spec (CommRingCat.of A), e.hom (e.inv y) = y := by
      intro y
      first
        | simp
        | (rw [← Scheme.Hom.comp_apply, e.inv_hom_id]; rfl)
        | exact congrArg (fun f : Spec (CommRingCat.of A) ⟶ Spec (CommRingCat.of A) => f y) e.inv_hom_id
    rw [h1, Scheme.fromSpecStalk_closedPoint, ht1]
    first
      | exact h2 _
      | simp
      | exact congrArg (fun f : Spec (CommRingCat.of A) ⟶ Spec (CommRingCat.of A) => f _) e.inv_hom_id
  have hcomap : PrimeSpectrum.comap (Spec.preimage k).hom
      (IsLocalRing.closedPoint ((Limits.pullback V.hom W.hom).presheaf.stalk t)) =
      IsLocalRing.closedPoint A := by
    have h5 : (Spec.map (Spec.preimage k))
        (IsLocalRing.closedPoint ((Limits.pullback V.hom W.hom).presheaf.stalk t)) =
        PrimeSpectrum.comap (Spec.preimage k).hom
          (IsLocalRing.closedPoint ((Limits.pullback V.hom W.hom).presheaf.stalk t)) := by
      first | rfl | simp [Spec.map_base]
    rw [← h5, hφ]
    exact hk_pt
  have hloc : IsLocalHom (Spec.preimage k).hom :=
    (IsLocalRing.isLocalHom_iff_comap_closedPoint (Spec.preimage k).hom).mpr hcomap
  have hbij : Function.Bijective (Spec.preimage k).hom :=
    wc_olivier _ _ inferInstance inferInstance hloc hWE
  haveI : IsIso (Spec.preimage k) := (ConcreteCategory.isIso_iff_bijective _).mpr hbij
  haveI hkiso : IsIso k := by
    rw [← hφ]; infer_instance
  have hcq : (Limits.pullback V.hom W.hom).fromSpecStalk t ≫ Limits.pullback.fst V.hom W.hom =
      k ≫ e.inv := by
    rw [hkdef]; simp
  obtain ⟨s, hs⟩ : ∃ s : V.left ⟶ Limits.pullback V.hom W.hom,
      s ≫ Limits.pullback.fst V.hom W.hom = 𝟙 _ :=
    ⟨e.hom ≫ inv k ≫ (Limits.pullback V.hom W.hom).fromSpecStalk t, by
      rw [Category.assoc, Category.assoc, hcq, IsIso.inv_hom_id_assoc, Iso.hom_inv_id]⟩

  have hh : (s ≫ Limits.pullback.snd V.hom W.hom) ≫ W.hom = V.hom := by
    rw [Category.assoc, ← Limits.pullback.condition, ← Category.assoc, hs, Category.id_comp]
  exact transfer V W (MorphismProperty.Over.homMk (s ≫ Limits.pullback.snd V.hom W.hom) hh trivial) hW

theorem wc_proet_scalarTriv_stalk_basis (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (σ : ℚ_[ℓ] → (G ⟶ G)) (r : ℕ)
    (V : S.ProEt) (A : Type u) [CommRing A] [IsLocalRing A] (e : V.left ≅ Spec (.of A))
    (φ : V ⟶ V) (hV : wcScalarTriv S ℓ G σ V r) :
    ∃ b : Abelian.Ext (wcFreeSheaf S V) G 0 ≃+ (Fin r → ℚ_[ℓ]),
      (∀ (c : ℚ_[ℓ]) (y : Abelian.Ext (wcFreeSheaf S V) G 0),
        b ((Abelian.Ext.mk₀ (σ c)).postcomp (wcFreeSheaf S V) (add_zero 0) y) = c • b y) ∧
      Function.Injective ((Abelian.Ext.mk₀ (wcFreeSheafMap S φ)).precomp G (zero_add 0)) :=
by
  classical
  unfold wcScalarTriv at hV
  obtain ⟨t, ht⟩ := hV

  let v₀ : V.left := e.inv (IsLocalRing.closedPoint A)
  have hconst : ∀ (f : C(V.left, Fin r → ℚ_[ℓ])) (x : V.left), f x = f v₀ := by
    intro f x
    have h1 : e.hom x ⤳ (IsLocalRing.closedPoint A : Spec (.of A)) :=
      IsLocalRing.specializes_closedPoint (R := A) (e.hom x)
    have h2 : e.inv (e.hom x) ⤳ v₀ := h1.map (Scheme.Hom.continuous e.inv)
    rw [Scheme.hom_inv_apply] at h2
    exact (h2.map f.continuous).eq

  let J := Scheme.ProEt.topology S
  let P := yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
  let η : (wcFreeSheaf S V).obj.obj (Opposite.op V) :=
    ((toSheafify J P).app (Opposite.op V)).hom (FreeAbelianGroup.of (ULift.up (𝟙 V)))
  let eqv : (wcFreeSheaf S V ⟶ G) ≃ G.obj.obj (Opposite.op V) :=
    ((sheafificationAdjunction J AddCommGrpCat.{u+1}).homEquiv P G).trans
      (((Adjunction.whiskerRight (S.ProEt)ᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
          (yoneda.obj V ⋙ uliftFunctor.{u+1, u}) G.obj).trans
        (uliftYonedaEquiv.{u+1} (X := V) (F := G.obj ⋙ forget AddCommGrpCat.{u+1})))
  have heqv : ∀ g : wcFreeSheaf S V ⟶ G, eqv g = (g.hom.app (Opposite.op V)).hom η :=
    fun _ => rfl
  have hadd : ∀ g g' : wcFreeSheaf S V ⟶ G, eqv (g + g') = eqv g + eqv g' := by
    intro g g'
    rw [heqv, heqv, heqv]
    first
      | rfl
      | simp [Sheaf.Hom.add_app]
      | simp
  let eqvA : (wcFreeSheaf S V ⟶ G) ≃+ G.obj.obj (Opposite.op V) := AddEquiv.mk' eqv hadd
  have hnat : ((wcFreeSheafMap S φ).hom.app (Opposite.op V)).hom η =
      ((wcFreeSheaf S V).obj.map φ.op).hom η := by
    let w : P ⟶ P :=
      Functor.whiskerRight (yoneda.map φ) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
    let x : P.obj (Opposite.op V) := FreeAbelianGroup.of (ULift.up (𝟙 V))
    have h1 : ((sheafifyMap J w).app (Opposite.op V)).hom (((toSheafify J P).app
        (Opposite.op V)).hom x) = ((toSheafify J P).app (Opposite.op V)).hom
          ((w.app (Opposite.op V)).hom x) :=
      (ConcreteCategory.congr_hom
        (congrArg (fun ψ => ψ.app (Opposite.op V)) (toSheafify_naturality J w)) x).symm
    have h2 : (w.app (Opposite.op V)).hom x = (P.map φ.op).hom x := by
      change FreeAbelianGroup.map _ (FreeAbelianGroup.of _) =
        FreeAbelianGroup.map _ (FreeAbelianGroup.of _)
      refine (FreeAbelianGroup.map_of_apply _).trans
        (Eq.trans ?_ (FreeAbelianGroup.map_of_apply _).symm)
      congr 1
    have hn : ((toSheafify J P).app (Opposite.op V)).hom ((P.map φ.op).hom x) =
        ((sheafify J P).map φ.op).hom (((toSheafify J P).app (Opposite.op V)).hom x) :=
      NatTrans.naturality_apply (toSheafify J P) φ.op x
    change ((sheafifyMap J w).app (Opposite.op V)).hom (((toSheafify J P).app
        (Opposite.op V)).hom x) =
      ((sheafify J P).map φ.op).hom (((toSheafify J P).app (Opposite.op V)).hom x)
    rw [h1, h2, hn]
  have hnatG : ∀ g : wcFreeSheaf S V ⟶ G,
      eqv (wcFreeSheafMap S φ ≫ g) = (G.obj.map φ.op).hom (eqv g) := by
    intro g
    rw [heqv, heqv]
    change (g.hom.app (Opposite.op V)).hom
      (((wcFreeSheafMap S φ).hom.app (Opposite.op V)).hom η) = _
    rw [hnat]
    exact NatTrans.naturality_apply g.hom φ.op η
  have hpostG : ∀ (ψ : G ⟶ G) (g : wcFreeSheaf S V ⟶ G),
      eqv (g ≫ ψ) = (ψ.hom.app (Opposite.op V)).hom (eqv g) := by
    intro ψ g
    rw [heqv, heqv]
    rfl

  let X₀ : Over V := Over.mk (𝟙 V)
  let X₁ : Over V := Over.mk φ
  let hX : X₁ ⟶ X₀ := Over.homMk φ (Category.comp_id φ)
  let τ₀ : G.obj.obj (Opposite.op V) → C(V.left, Fin r → ℚ_[ℓ]) :=
    fun s => (show ULift.{u+1} C(V.left, Fin r → ℚ_[ℓ]) from
      (t.hom.hom.app (Opposite.op X₀)).hom s).down
  let τ₁ : G.obj.obj (Opposite.op V) → C(V.left, Fin r → ℚ_[ℓ]) :=
    fun s => (show ULift.{u+1} C(V.left, Fin r → ℚ_[ℓ]) from
      (t.hom.hom.app (Opposite.op X₁)).hom s).down
  let τe : G.obj.obj (Opposite.op V) ≃+ ULift.{u+1} C(V.left, Fin r → ℚ_[ℓ]) :=
    (((sheafToPresheaf _ _).mapIso t).app (Opposite.op X₀)).addCommGroupIsoToAddEquiv
  let ev : ULift.{u+1} C(V.left, Fin r → ℚ_[ℓ]) ≃+ (Fin r → ℚ_[ℓ]) :=
    { toFun := fun F => F.down v₀
      invFun := fun m => ULift.up (ContinuousMap.const _ m)
      left_inv := fun F => ULift.ext _ _ (ContinuousMap.ext fun x => (hconst F.down x).symm)
      right_inv := fun m => rfl
      map_add' := fun F F' => rfl }
  let β : G.obj.obj (Opposite.op V) ≃+ (Fin r → ℚ_[ℓ]) := τe.trans ev
  have hβ : ∀ s, β s = τ₀ s v₀ := fun _ => rfl
  have hscal : ∀ (c : ℚ_[ℓ]) (s : G.obj.obj (Opposite.op V)),
      β (((σ c).hom.app (Opposite.op V)).hom s) = c • β s := by
    intro c s
    have h1 := NatTrans.congr_app (congrArg (fun f => f.hom) (ht c)) (Opposite.op X₀)
    have h2 := congrArg ULift.down (ConcreteCategory.congr_hom h1 s)
    have h3 := congrArg (fun f : C(V.left, Fin r → ℚ_[ℓ]) => f v₀) h2
    exact h3
  have key : ∀ s : G.obj.obj (Opposite.op V),
      τ₁ ((G.obj.map φ.op).hom s) = (τ₀ s).comp φ.left.base.hom := by
    intro s
    exact congrArg ULift.down
      (congrArg (fun f => AddCommGrpCat.Hom.hom f s) (t.hom.hom.naturality hX.op))
  have hinjφ : Function.Injective (G.obj.map φ.op).hom := by
    intro s s' hss
    have e0 : τ₁ ((G.obj.map φ.op).hom s) = τ₁ ((G.obj.map φ.op).hom s') := by rw [hss]
    rw [key, key] at e0
    have e3 := congrArg (fun f : C(V.left, Fin r → ℚ_[ℓ]) => f v₀) e0
    apply β.injective
    rw [hβ, hβ]
    calc τ₀ s v₀ = τ₀ s (φ.left.base.hom v₀) := (hconst _ _).symm
      _ = τ₀ s' (φ.left.base.hom v₀) := e3
      _ = τ₀ s' v₀ := hconst _ _

  let E0 : Abelian.Ext (wcFreeSheaf S V) G 0 ≃+ (wcFreeSheaf S V ⟶ G) := Abelian.Ext.addEquiv₀
  have hE0 : ∀ h : wcFreeSheaf S V ⟶ G, E0 (Abelian.Ext.mk₀ h) = h := by
    intro h
    apply (Abelian.Ext.mk₀_bijective _ _).1
    exact Abelian.Ext.mk₀_addEquiv₀_apply _
  let b : Abelian.Ext (wcFreeSheaf S V) G 0 ≃+ (Fin r → ℚ_[ℓ]) := E0.trans (eqvA.trans β)
  have hb : ∀ h : wcFreeSheaf S V ⟶ G, b (Abelian.Ext.mk₀ h) = β (eqv h) := by
    intro h
    show β (eqvA (E0 (Abelian.Ext.mk₀ h))) = β (eqv h)
    rw [hE0]
    rfl
  refine ⟨b, ?_, ?_⟩
  · intro c y
    obtain ⟨g, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 y
    have hp : (Abelian.Ext.mk₀ (σ c)).postcomp (wcFreeSheaf S V) (add_zero 0)
        (Abelian.Ext.mk₀ g) = Abelian.Ext.mk₀ (g ≫ σ c) :=
      Abelian.Ext.mk₀_comp_mk₀ _ _
    rw [hp, hb, hb, hpostG]
    exact hscal c (eqv g)
  · intro y y' hyy
    obtain ⟨g, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 y
    obtain ⟨g', rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 y'
    have hp : ∀ g₁ : wcFreeSheaf S V ⟶ G,
        (Abelian.Ext.mk₀ (wcFreeSheafMap S φ)).precomp G (zero_add 0) (Abelian.Ext.mk₀ g₁) =
          Abelian.Ext.mk₀ (wcFreeSheafMap S φ ≫ g₁) :=
      fun g₁ => Abelian.Ext.mk₀_comp_mk₀ _ _
    rw [hp, hp] at hyy
    have h1 := (Abelian.Ext.mk₀_bijective _ _).1 hyy
    have h2 := congrArg eqv h1
    rw [hnatG, hnatG] at h2
    rw [eqv.injective (hinjφ h2)]

theorem wc_P1_frob_nbhd_exists (K : Type u) [Field K] [Finite K] (d : ℕ) (hd : 1 ≤ d)
    (x : (wcP1Over K).left) (hx : x ∈ wcP1ClosedPt K d) : Nonempty (wcFrobNbhd K x d) :=
by
  classical
  haveI hprop : IsProper (wcP1Over K).hom := wc_proj_space_isProper K 1
  haveI hWEc : MorphismProperty.IsStableUnderComposition @WeaklyEtale :=
    MorphismProperty.IsMultiplicative.toIsStableUnderComposition

  have main : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (J : Spec (.of Ω) ⟶ Spec (.of K))
      (hJ : WeaklyEtale J) (τ : Ω →+* Ω) (hτJ : Spec.map (CommRingCat.ofHom τ) ≫ J = J)
      (hτ : ∀ c, τ c ^ (Nat.card K ^ d) = c) (u : Spec (.of Ω) ⟶ (wcP1Over K).left)
      (hu : u ≫ (wcP1Over K).hom = J) (hut : Spec.map (CommRingCat.ofHom τ) ≫ u = u),
      Nonempty (wcFrobNbhd K (u (IsLocalRing.closedPoint Ω)) d) := by
    intro Ω _ _ J hJ τ hτJ hτ u hu hut
    haveI hlft : LocallyOfFiniteType (Limits.pullback.snd (wcP1Over K).hom J) :=
      MorphismProperty.of_isPullback (P := @LocallyOfFiniteType) (IsPullback.of_hasPullback _ _)
        inferInstance
    haveI hsep : IsSeparated (Limits.pullback.snd (wcP1Over K).hom J) :=
      MorphismProperty.of_isPullback (P := @IsSeparated) (IsPullback.of_hasPullback _ _)
        inferInstance
    haveI hln : IsLocallyNoetherian (Limits.pullback (wcP1Over K).hom J) :=
      @LocallyOfFiniteType.isLocallyNoetherian _ _ (Limits.pullback.snd (wcP1Over K).hom J)
        hlft inferInstance
    have hpr1 : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom J) :=
      MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip hJ
    obtain ⟨Φ, hΦ1, hΦ2⟩ : ∃ Φ : Limits.pullback (wcP1Over K).hom J ⟶
        Limits.pullback (wcP1Over K).hom J,
        Φ ≫ Limits.pullback.fst (wcP1Over K).hom J = Limits.pullback.fst (wcP1Over K).hom J ∧
        Φ ≫ Limits.pullback.snd (wcP1Over K).hom J =
          Limits.pullback.snd (wcP1Over K).hom J ≫ Spec.map (CommRingCat.ofHom τ) :=
      ⟨Limits.pullback.lift (Limits.pullback.fst (wcP1Over K).hom J)
        (Limits.pullback.snd (wcP1Over K).hom J ≫ Spec.map (CommRingCat.ofHom τ))
        (by rw [Category.assoc, hτJ, Limits.pullback.condition]),
       Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    obtain ⟨ub, hub1, hub2⟩ : ∃ ub : Spec (.of Ω) ⟶ Limits.pullback (wcP1Over K).hom J,
        ub ≫ Limits.pullback.fst (wcP1Over K).hom J = u ∧
        ub ≫ Limits.pullback.snd (wcP1Over K).hom J = 𝟙 _ :=
      ⟨Limits.pullback.lift u (𝟙 _) (by rw [hu, Category.id_comp]),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have hfr : ub ≫ Φ = Spec.map (CommRingCat.ofHom τ) ≫ ub := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hΦ1, hub1, Category.assoc, hub1, hut]
      · rw [Category.assoc, hΦ2, ← Category.assoc, hub2, Category.id_comp, Category.assoc, hub2,
          Category.comp_id]
    obtain ⟨xb, hxb⟩ : ∃ xb : ↥(Limits.pullback (wcP1Over K).hom J),
        xb = ub (IsLocalRing.closedPoint Ω) := ⟨_, rfl⟩
    haveI hci1 : IsClosedImmersion (ub ≫ Limits.pullback.snd (wcP1Over K).hom J) := by
      rw [hub2]; infer_instance
    haveI : IsClosedImmersion ub := @IsClosedImmersion.of_comp _ _ _ ub
      (Limits.pullback.snd (wcP1Over K).hom J) hci1 hsep
    have hptK : ∀ z : Spec (.of Ω), z = IsLocalRing.closedPoint Ω := fun z =>
      @Subsingleton.elim (PrimeSpectrum Ω) _ _ _
    have hxbc : IsClosed ({xb} : Set ↥(Limits.pullback (wcP1Over K).hom J)) := by
      have hr : Set.range ub = {xb} := by
        ext y
        constructor
        · rintro ⟨z, rfl⟩
          exact (congrArg ub (hptK z)).trans hxb.symm
        · intro hy
          exact ⟨_, (hxb.symm.trans hy.symm)⟩
      rw [← hr]
      exact ub.isClosedEmbedding.isClosed_range
    have hφx : Φ xb = xb := by
      have h1 : (ub ≫ Φ) (IsLocalRing.closedPoint Ω) =
          (Spec.map (CommRingCat.ofHom τ) ≫ ub) (IsLocalRing.closedPoint Ω) := by
        first | rw [hfr] | exact congrArg (fun k => k (IsLocalRing.closedPoint _)) hfr
      have h2 : (ub ≫ Φ) (IsLocalRing.closedPoint Ω) = Φ (ub (IsLocalRing.closedPoint _)) := by
        first | rfl | exact Scheme.Hom.comp_apply _ _ _ | simp
      have h3 : (Spec.map (CommRingCat.ofHom τ) ≫ ub) (IsLocalRing.closedPoint Ω) =
          ub (Spec.map (CommRingCat.ofHom τ) (IsLocalRing.closedPoint Ω)) := by
        first | rfl | exact Scheme.Hom.comp_apply _ _ _ | simp
      have h4 := h2.symm.trans (h1.trans (h3.trans (congrArg ub (hptK _))))
      rw [← hxb] at h4
      exact h4
    have hfx : Limits.pullback.fst (wcP1Over K).hom J xb = u (IsLocalRing.closedPoint Ω) := by
      have h1 : (ub ≫ Limits.pullback.fst (wcP1Over K).hom J) (IsLocalRing.closedPoint Ω) =
          u (IsLocalRing.closedPoint Ω) := by
        first | rw [hub1] | exact congrArg (fun k => k (IsLocalRing.closedPoint _)) hub1
      have h2 : (ub ≫ Limits.pullback.fst (wcP1Over K).hom J) (IsLocalRing.closedPoint Ω) =
          Limits.pullback.fst (wcP1Over K).hom J (ub (IsLocalRing.closedPoint _)) := by
        first | rfl | exact Scheme.Hom.comp_apply _ _ _ | simp
      rw [hxb]
      exact h2.symm.trans h1

    obtain ⟨A, iA, iAh, iAn, ι, hιloc, hres, hmax, huniv, hwe⟩ :=
      wc_lfi_henselization_weaklyEtale ((Limits.pullback (wcP1Over K).hom J).presheaf.stalk xb)
    have hacP : IsAlgClosed (IsLocalRing.ResidueField
        ((Limits.pullback (wcP1Over K).hom J).presheaf.stalk xb)) :=
      @wc_lfi_closed_point_residue_algClosed Ω _ _ (Limits.pullback (wcP1Over K).hom J)
        (Limits.pullback.snd (wcP1Over K).hom J) hlft xb hxbc
    have hsurjR : Function.Surjective (IsLocalRing.ResidueField.map ι) := by
      intro y
      obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective y
      obtain ⟨b, hb⟩ := hres a
      refine ⟨IsLocalRing.residue _ b, ?_⟩
      rw [IsLocalRing.ResidueField.map_residue, eq_comm, ← sub_eq_zero, ← map_sub,
        IsLocalRing.residue_eq_zero_iff]
      exact hb
    haveI hacA : IsAlgClosed (IsLocalRing.ResidueField A) :=
      IsAlgClosed.of_ringEquiv _ _
        (RingEquiv.ofBijective _ ⟨(IsLocalRing.ResidueField.map ι).injective, hsurjR⟩)
    have hsepA : IsSepClosed (IsLocalRing.ResidueField A) := inferInstance
    obtain ⟨ι', hι'⟩ : ∃ ι' : (Limits.pullback (wcP1Over K).hom J).presheaf.stalk xb ⟶
        CommRingCat.of A, ι'.hom = ι := ⟨CommRingCat.ofHom ι, rfl⟩
    haveI hι'loc : IsLocalHom ι'.hom := by rw [hι']; exact hιloc
    obtain ⟨γ, hγ⟩ : ∃ γ : Spec (CommRingCat.of A) ⟶ Limits.pullback (wcP1Over K).hom J,
        γ = Spec.map ι' ≫ (Limits.pullback (wcP1Over K).hom J).fromSpecStalk xb := ⟨_, rfl⟩
    have hSW : WeaklyEtale (Spec.map ι') := by
      letI : Algebra ((Limits.pullback (wcP1Over K).hom J).presheaf.stalk xb) A := ι.toAlgebra
      have hι'eq : ι' = CommRingCat.ofHom ι := CommRingCat.hom_ext hι'
      rw [hι'eq]
      exact wc_lfi_specMap_weaklyEtale _ _ hwe
    have hγwe : WeaklyEtale γ := by
      rw [hγ]
      exact MorphismProperty.comp_mem @WeaklyEtale _ _ hSW
        (wc_lfi_fromSpecStalk_weaklyEtale (Limits.pullback (wcP1Over K).hom J) xb)
    have hT : WeaklyEtale (γ ≫ Limits.pullback.fst (wcP1Over K).hom J) :=
      MorphismProperty.comp_mem @WeaklyEtale γ (Limits.pullback.fst (wcP1Over K).hom J) hγwe hpr1
    let V₀ : (wcP1Over K).left.ProEt :=
      MorphismProperty.Over.mk ⊤ (γ ≫ Limits.pullback.fst (wcP1Over K).hom J) hT
    obtain ⟨θ, hθloc, hθ1⟩ : ∃ θ : (Limits.pullback (wcP1Over K).hom J).presheaf.stalk xb ⟶
        (Limits.pullback (wcP1Over K).hom J).presheaf.stalk xb,
        IsLocalHom θ.hom ∧ Spec.map θ ≫ (Limits.pullback (wcP1Over K).hom J).fromSpecStalk xb =
          (Limits.pullback (wcP1Over K).hom J).fromSpecStalk xb ≫ Φ := by
      refine ⟨((Limits.pullback (wcP1Over K).hom J).presheaf.stalkCongr
        (Inseparable.of_eq hφx)).inv ≫ Φ.stalkMap xb, ?_, ?_⟩
      · rw [CommRingCat.hom_comp]; infer_instance
      · have key : ∀ (y z : ↥(Limits.pullback (wcP1Over K).hom J)) (hy : y = z),
            Spec.map ((Limits.pullback (wcP1Over K).hom J).presheaf.stalkCongr
              (Inseparable.of_eq hy)).inv ≫
              (Limits.pullback (wcP1Over K).hom J).fromSpecStalk z =
              (Limits.pullback (wcP1Over K).hom J).fromSpecStalk y := by
          intro y z hy; subst hy; simp
        rw [Spec.map_comp, Category.assoc, key _ _ hφx, Scheme.SpecMap_stalkMap_fromSpecStalk]
    haveI := hθloc
    obtain ⟨ρ, ⟨hρloc, hρι⟩, -⟩ := huniv A (ι.comp θ.hom) (RingHom.isLocalHom_comp ι θ.hom)
    haveI := hρloc
    have hcomp : ι' ≫ CommRingCat.ofHom ρ = θ ≫ ι' := by
      apply CommRingCat.hom_ext
      rw [CommRingCat.hom_comp, CommRingCat.hom_comp, CommRingCat.hom_ofHom, hι']
      exact hρι
    have hI2 : Spec.map (CommRingCat.ofHom ρ) ≫ γ = γ ≫ Φ := by
      rw [hγ, ← Category.assoc, ← Spec.map_comp, hcomp, Spec.map_comp]
      simp only [Category.assoc]
      rw [hθ1]
    have hw : Spec.map (CommRingCat.ofHom ρ) ≫ γ ≫ Limits.pullback.fst (wcP1Over K).hom J =
        γ ≫ Limits.pullback.fst (wcP1Over K).hom J := by
      rw [← Category.assoc, hI2, Category.assoc, hΦ1]
    let φ₀ : V₀ ⟶ V₀ := MorphismProperty.Over.homMk (Spec.map (CommRingCat.ofHom ρ)) hw trivial
    have hmax' : Ideal.map ι'.hom (IsLocalRing.maximalIdeal
        ((Limits.pullback (wcP1Over K).hom J).presheaf.stalk xb)) =
        IsLocalRing.maximalIdeal A := by rw [hι']; exact hmax
    have hres' : ∀ a : A, ∃ b, a - ι'.hom b ∈ IsLocalRing.maximalIdeal A := by
      rw [hι']; exact hres
    have hLF := wc_lfi_local_spec_fibre (Limits.pullback (wcP1Over K).hom J) xb A ι' hmax' hres'
    rw [← hγ] at hLF
    have hγpt : γ (IsLocalRing.closedPoint A) = xb := by
      have h1 : IsLocalRing.closedPoint A ∈ γ ⁻¹' {xb} := by
        rw [hLF.1]; exact Set.mem_singleton _
      exact h1
    have hv : (γ ≫ Limits.pullback.fst (wcP1Over K).hom J) (IsLocalRing.closedPoint A) =
        u (IsLocalRing.closedPoint Ω) := by
      have h2 : (γ ≫ Limits.pullback.fst (wcP1Over K).hom J) (IsLocalRing.closedPoint A) =
          Limits.pullback.fst (wcP1Over K).hom J (γ (IsLocalRing.closedPoint A)) := by
        first | rfl | exact Scheme.Hom.comp_apply _ _ _ | simp
      exact h2.trans ((congrArg _ hγpt).trans hfx)

    obtain ⟨s, hsl, hs⟩ : ∃ s : (Limits.pullback (wcP1Over K).hom J).presheaf.stalk xb ⟶
        CommRingCat.of Ω, IsLocalHom s.hom ∧
        Spec.map s ≫ (Limits.pullback (wcP1Over K).hom J).fromSpecStalk xb = ub := by
      subst hxb
      exact ⟨_, Scheme.isLocalHom_stalkClosedPointTo ub, Scheme.Spec_stalkClosedPointTo_fromSpecStalk ub⟩
    haveI := hsl
    haveI hτl : IsLocalHom τ := ⟨fun a ha => by
      rcases eq_or_ne a 0 with h | h
      · rw [h, map_zero] at ha; exact absurd ha not_isUnit_zero
      · exact h.isUnit⟩
    have hl1 : IsLocalHom (θ ≫ s).hom := by rw [CommRingCat.hom_comp]; infer_instance
    have hl2 : IsLocalHom (s ≫ CommRingCat.ofHom τ).hom := by
      rw [CommRingCat.hom_comp]; infer_instance
    have e1 : Spec.map (θ ≫ s) ≫ (Limits.pullback (wcP1Over K).hom J).fromSpecStalk xb =
        ub ≫ Φ := by
      rw [Spec.map_comp, Category.assoc, hθ1, ← Category.assoc, hs]
    have e2 : Spec.map (s ≫ CommRingCat.ofHom τ) ≫
        (Limits.pullback (wcP1Over K).hom J).fromSpecStalk xb =
        Spec.map (CommRingCat.ofHom τ) ≫ ub := by
      rw [Spec.map_comp, Category.assoc, hs]
    have hEq : (SpecToEquivOfLocalRing (Limits.pullback (wcP1Over K).hom J)
          (CommRingCat.of Ω)).symm ⟨xb, ⟨θ ≫ s, hl1⟩⟩ =
        (SpecToEquivOfLocalRing (Limits.pullback (wcP1Over K).hom J)
          (CommRingCat.of Ω)).symm ⟨xb, ⟨s ≫ CommRingCat.ofHom τ, hl2⟩⟩ := by
      rw [SpecToEquivOfLocalRing_symm_apply, SpecToEquivOfLocalRing_symm_apply]
      exact e1.trans (hfr.trans e2.symm)
    have hEq2 := (SpecToEquivOfLocalRing (Limits.pullback (wcP1Over K).hom J)
          (CommRingCat.of Ω)).symm.injective hEq
    have hst : θ ≫ s = s ≫ CommRingCat.ofHom τ :=
      congrArg Subtype.val (eq_of_heq (Sigma.mk.inj_iff.mp hEq2).2)
    have hsθ : s.hom.comp θ.hom = τ.comp s.hom := by
      have h := congrArg CommRingCat.Hom.hom hst
      rwa [CommRingCat.hom_comp, CommRingCat.hom_comp, CommRingCat.hom_ofHom] at h

    haveI : HenselianLocalRing Ω := Field.henselian Ω
    obtain ⟨sh, ⟨hshl, hshι⟩, -⟩ := huniv Ω s.hom hsl
    haveI := hshl
    obtain ⟨g', -, hg'u⟩ := huniv Ω (τ.comp s.hom) (RingHom.isLocalHom_comp τ s.hom)
    have f1 := hg'u (sh.comp ρ) ⟨RingHom.isLocalHom_comp sh ρ, by
      rw [RingHom.comp_assoc, hρι, ← RingHom.comp_assoc, hshι, hsθ]⟩
    have f2 := hg'u (τ.comp sh) ⟨RingHom.isLocalHom_comp τ sh, by
      rw [RingHom.comp_assoc, hshι]⟩
    have hshρ : sh.comp ρ = τ.comp sh := f1.trans f2.symm
    have hfrob : ∀ a : A, ρ a ^ (Nat.card K ^ d) - a ∈ IsLocalRing.maximalIdeal A := by
      intro a
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hun
      have h1 := hun.map sh
      have h3 : sh (ρ a) = τ (sh a) := RingHom.congr_fun hshρ a
      have h2 : sh (ρ a ^ (Nat.card K ^ d) - a) = 0 := by
        rw [map_sub, map_pow, h3, hτ, sub_self]
      rw [h2] at h1
      exact not_isUnit_zero h1

    refine ⟨@wcFrobNbhd.mk K _ _ d V₀ φ₀ A iA iAh hsepA (Iso.refl _) ?_ ρ ?_ hfrob⟩
    · first
        | exact hv
        | simpa using hv
    · first
        | exact (Category.id_comp _).trans (Category.comp_id _)
        | simp [φ₀]
        | rfl

  letI : Fintype K := Fintype.ofFinite K
  obtain ⟨σ, hσd⟩ : ∃ σ : AlgebraicClosure K ≃ₐ[K] AlgebraicClosure K,
      ∀ c, (σ ^ d) c = c ^ (Nat.card K ^ d) := by
    refine ⟨FiniteField.frobeniusAlgEquivOfAlgebraic K (AlgebraicClosure K), fun c => ?_⟩
    have h := congrFun (FiniteField.coe_frobeniusAlgEquivOfAlgebraic_iterate K
      (AlgebraicClosure K) d) c
    have hc : Fintype.card K = Nat.card K := Fintype.card_eq_nat_card
    rw [AlgEquiv.coe_pow, h]
    first
      | exact congrArg (fun n => c ^ n ^ d) hc
      | (simp only []; rw [hc])
      | rw [hc]
  obtain ⟨τ, hτ1, hτ2, hτ3⟩ : ∃ τ : AlgebraicClosure K →+* AlgebraicClosure K,
      (∀ c, τ c ^ (Nat.card K ^ d) = c) ∧ (∀ c, τ (c ^ (Nat.card K ^ d)) = c) ∧
      τ.comp (algebraMap K (AlgebraicClosure K)) = algebraMap K (AlgebraicClosure K) := by
    refine ⟨((σ ^ d).symm : AlgebraicClosure K →+* AlgebraicClosure K), fun c => ?_,
      fun c => ?_, ?_⟩
    · rw [← hσd]; exact (σ ^ d).apply_symm_apply c
    · rw [← hσd]; exact (σ ^ d).symm_apply_apply c
    · ext c; exact (σ ^ d).symm.commutes c
  have hτJ : Spec.map (CommRingCat.ofHom τ) ≫
      Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) =
      Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) := by
    rw [← Spec.map_comp]
    congr 1
    ext c
    exact RingHom.congr_fun hτ3 c

  obtain ⟨hxc, hxd⟩ := hx
  letI alg : Algebra K ((wcP1Over K).left.residueField x) :=
    (((wcP1Over K).left.residue x).hom.comp (wcLdpConst K (wcP1Over K).hom x)).toAlgebra
  have hfin : Module.finrank K ((wcP1Over K).left.residueField x) = d := by
    first | exact hxd | convert hxd using 2
  haveI hmf : Module.Finite K ((wcP1Over K).left.residueField x) :=
    Module.finite_of_finrank_pos (by omega)
  haveI hfk : Finite ((wcP1Over K).left.residueField x) := Module.finite_of_finite K
  have hcard : Nat.card ((wcP1Over K).left.residueField x) = Nat.card K ^ d := by
    rw [Module.natCard_eq_pow_finrank (K := K), hfin]
  have hpow : ∀ c : (wcP1Over K).left.residueField x, c ^ (Nat.card K ^ d) = c := by
    intro c
    letI := Fintype.ofFinite ((wcP1Over K).left.residueField x)
    rw [← hcard, ← Fintype.card_eq_nat_card]
    exact FiniteField.pow_card c
  haveI : Algebra.IsAlgebraic K ((wcP1Over K).left.residueField x) :=
    Algebra.IsAlgebraic.of_finite K _
  obtain ⟨lam, hlam⟩ : ∃ lam : (wcP1Over K).left.residueField x →+* AlgebraicClosure K,
      lam.comp (((wcP1Over K).left.residue x).hom.comp (wcLdpConst K (wcP1Over K).hom x)) =
        algebraMap K (AlgebraicClosure K) :=
    ⟨(IsAlgClosed.lift (M := AlgebraicClosure K) (R := K)
        (S := (wcP1Over K).left.residueField x)).toRingHom,
      by
        ext c
        first
          | exact (IsAlgClosed.lift (M := AlgebraicClosure K) (R := K)
              (S := (wcP1Over K).left.residueField x)).commutes c
          | exact RingHom.congr_fun (AlgHom.comp_algebraMap (IsAlgClosed.lift
              (M := AlgebraicClosure K) (R := K) (S := (wcP1Over K).left.residueField x))) c⟩
  have h2 : (wcP1Over K).left.fromSpecStalk x ≫ (wcP1Over K).hom =
      Spec.map (CommRingCat.ofHom (wcLdpConst K (wcP1Over K).hom x)) := by
    calc _ = (wcP1Over K).left.fromSpecStalk x ≫ (wcP1Over K).hom ≫ (Spec (.of K)).toSpecΓ ≫
          Spec.map (Scheme.ΓSpecIso (.of K)).inv := by
          rw [toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]
      _ = ((wcP1Over K).left.fromSpecStalk x ≫ (wcP1Over K).left.toSpecΓ) ≫
          Spec.map ((wcP1Over K).hom.appTop) ≫ Spec.map (Scheme.ΓSpecIso (.of K)).inv := by
          simp only [Category.assoc]
          rw [← Category.assoc (wcP1Over K).hom, Scheme.toSpecΓ_naturality, Category.assoc]
      _ = _ := by
          rw [Scheme.fromSpecStalk_toSpecΓ, ← Spec.map_comp, ← Spec.map_comp]
          rfl
  have hiii : (wcP1Over K).left.fromSpecResidueField x ≫ (wcP1Over K).hom =
      Spec.map (CommRingCat.ofHom
        (((wcP1Over K).left.residue x).hom.comp (wcLdpConst K (wcP1Over K).hom x))) := by
    rw [Scheme.fromSpecResidueField.eq_1, Category.assoc, h2, ← Spec.map_comp]
    rfl
  obtain ⟨u, hudef⟩ : ∃ u : Spec (.of (AlgebraicClosure K)) ⟶ (wcP1Over K).left,
      u = Spec.map (CommRingCat.ofHom lam) ≫ (wcP1Over K).left.fromSpecResidueField x :=
    ⟨_, rfl⟩
  have hu : u ≫ (wcP1Over K).hom =
      Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) := by
    rw [hudef, Category.assoc, hiii, ← Spec.map_comp, ← hlam]
    rfl
  have hux : u (IsLocalRing.closedPoint (AlgebraicClosure K)) = x := by
    rw [hudef]
    first
      | exact Scheme.fromSpecResidueField_apply x _
      | (rw [Scheme.Hom.comp_apply]; exact Scheme.fromSpecResidueField_apply x _)
      | simp
  have hl : CommRingCat.ofHom lam ≫ CommRingCat.ofHom τ = CommRingCat.ofHom lam := by
    ext c
    show τ (lam c) = lam c
    calc τ (lam c) = τ (lam (c ^ (Nat.card K ^ d))) := by rw [hpow c]
      _ = τ ((lam c) ^ (Nat.card K ^ d)) := by rw [map_pow]
      _ = lam c := hτ2 _
  have hut : Spec.map (CommRingCat.ofHom τ) ≫ u = u := by
    rw [hudef, ← Category.assoc, ← Spec.map_comp, hl]
  have hres := main (AlgebraicClosure K)
    (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))
    (wc_weaklyEtale_algebraicClosure K) τ hτJ hτ1 u hu hut
  rw [hux] at hres
  exact hres

theorem wc_proet_theta_frame (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP) (N : ℕ)
    (hW : ConnectedSpace W.left)
    (θ : G.over W ≅ (wcContSheaf (wcP1Over K).left (Fin N → ℚ_[ℓ])).over W)
    (V₀ : (wcP1Over K).left.ProEt) (hV₀ : ConnectedSpace V₀.left) (h₁ h₂ : V₀ ⟶ W)
    (x : G.obj.obj (Opposite.op V₀))
    (hx : ∀ z : V₀.left, wcContEval (wcP1Over K).left V₀
      ((θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x) z ∈ wcH0Span K hP ℓ G W N θ) :
    (∀ z : V₀.left, wcContEval (wcP1Over K).left V₀
      ((θ.hom.hom.app (Opposite.op (Over.mk h₂))).hom x) z ∈ wcH0Span K hP ℓ G W N θ) ∧
    (h₁ ≫ w = h₂ ≫ w → ∀ z : V₀.left,
      wcContEval (wcP1Over K).left V₀ ((θ.hom.hom.app (Opposite.op (Over.mk h₂))).hom x) z =
        wcContEval (wcP1Over K).left V₀ ((θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x) z) :=
by
  classical

  have hnat : ∀ (T V : (wcP1Over K).left.ProEt) (k : T ⟶ V) (h' : V ⟶ W) (h'' : T ⟶ W)
      (hk : k ≫ h' = h'') (y : G.obj.obj (Opposite.op V)) (z : T.left),
      wcContEval (wcP1Over K).left T
          ((θ.hom.hom.app (Opposite.op (Over.mk h''))).hom ((G.obj.map k.op).hom y)) z =
        wcContEval (wcP1Over K).left V ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom y)
          (k.left z) := by
    intro T V k h' h'' hk y z
    subst hk
    have e := θ.hom.hom.naturality
      (Over.homMk (U := Over.mk (k ≫ h')) (V := Over.mk h') k rfl).op
    have e2 := congrArg (fun φ => φ.hom y) e
    exact congrArg (fun f => wcContEval (wcP1Over K).left T f z) e2

  have hFun : ∀ {A B C : (wcP1Over K).left.ProEt} (k : A ⟶ B) (m : B ⟶ C)
      (y : G.obj.obj (Opposite.op C)),
      (G.obj.map k.op).hom ((G.obj.map m.op).hom y) = (G.obj.map (k ≫ m).op).hom y := by
    intro A B C k m y
    rw [op_comp, Functor.map_comp]
    rfl

  have hconst : ∀ (T : (wcP1Over K).left.ProEt) (_ : ConnectedSpace T.left)
      (f : (wcContSheaf (wcP1Over K).left (Fin N → ℚ_[ℓ])).obj.obj (Opposite.op T))
      (p q : T.left), wcContEval (wcP1Over K).left T f p = wcContEval (wcP1Over K).left T f q := by
    intro T hT f p q
    have hs : (Set.range (show ULift.{u+1} C(↥T.left, Fin N → ℚ_[ℓ]) from f).down).Subsingleton :=
      (isPreconnected_range
        (show ULift.{u+1} C(↥T.left, Fin N → ℚ_[ℓ]) from f).down.continuous).subsingleton
    exact hs (Set.mem_range_self p) (Set.mem_range_self q)

  obtain ⟨A, hAm⟩ : ∃ A : (Fin N → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin N → ℚ_[ℓ]),
      ∀ (y : G.obj.obj (Opposite.op V₀)) (z : V₀.left),
        wcContEval (wcP1Over K).left V₀ ((θ.hom.hom.app (Opposite.op (Over.mk h₂))).hom y) z =
          A (wcContEval (wcP1Over K).left V₀
            ((θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom y) z) := by
    let Φ' : ((wcContSheaf (wcP1Over K).left (Fin N → ℚ_[ℓ])).over V₀).obj ⟶
        ((wcContSheaf (wcP1Over K).left (Fin N → ℚ_[ℓ])).over V₀).obj :=
      Functor.whiskerLeft (Over.map h₁).op θ.inv.hom ≫
        Functor.whiskerLeft (Over.map h₂).op θ.hom.hom
    let Φ : (wcContSheaf (wcP1Over K).left (Fin N → ℚ_[ℓ])).over V₀ ⟶
        (wcContSheaf (wcP1Over K).left (Fin N → ℚ_[ℓ])).over V₀ := ObjectProperty.homMk Φ'
    obtain ⟨A, hA⟩ := wc_contSheaf_over_hom_linear (wcP1Over K).left ℓ V₀ hV₀ N N Φ
    refine ⟨A, ?_⟩
    have key : ∀ (y : G.obj.obj (Opposite.op V₀)) (z : V₀.left),
        wcContEval (wcP1Over K).left V₀
            ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 V₀ ≫ h₂)))).hom y) z =
          A (wcContEval (wcP1Over K).left V₀
            ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 V₀ ≫ h₁)))).hom y) z) := by
      intro y z
      have h2 : (θ.inv.hom.app (Opposite.op (Over.mk (𝟙 V₀ ≫ h₁)))).hom
          ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 V₀ ≫ h₁)))).hom y) = y :=
        congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk (𝟙 V₀ ≫ h₁)))).hom y) θ.hom_inv_id
      have h1 := congrArg (fun ψ => wcContEval (wcP1Over K).left V₀
        ((ψ.hom.app (Opposite.op (Over.mk (𝟙 V₀)))).hom
          ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 V₀ ≫ h₁)))).hom y)) z) hA
      refine (congrArg (fun y' => wcContEval (wcP1Over K).left V₀
        ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 V₀ ≫ h₂)))).hom y') z) h2).symm.trans
          (h1.trans ?_)
      rfl
    intro y z
    have k2 := key y z
    rw [Category.id_comp, Category.id_comp] at k2
    exact k2

  obtain ⟨c, hc⟩ : ∃ c : G.obj.obj (Opposite.op (wcGeomPoint K (wcP1Over K) hP)) → W.left →
      (Fin N → ℚ_[ℓ]), ∀ t q, c t q = wcContEval (wcP1Over K).left W
        ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom ((G.obj.map w.op).hom t)) q :=
    ⟨fun t q => wcContEval (wcP1Over K).left W
        ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom ((G.obj.map w.op).hom t)) q,
      fun _ _ => rfl⟩
  have hGen : ∀ t q, c t q ∈ wcH0Span K hP ℓ G W N θ := by
    intro t q
    rw [hc]
    exact Submodule.subset_span ⟨t, W, w, 𝟙 W, q, rfl⟩

  have hstep1 : ∀ (t : G.obj.obj (Opposite.op (wcGeomPoint K (wcP1Over K) hP)))
      (V : (wcP1Over K).left.ProEt) (h : V ⟶ wcGeomPoint K (wcP1Over K) hP) (h' : V ⟶ W)
      (z' : V.left), ∃ t' q, wcContEval (wcP1Over K).left V
        ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom ((G.obj.map h.op).hom t)) z' = c t' q := by
    intro t V h h' z'
    obtain ⟨V₁, k, z₁, hV₁, hkz⟩ := wc_proet_connected_nbhd (wcP1Over K).left V z'
    obtain ⟨e, he⟩ := wc_geomPoint_hom_twist K (wcP1Over K) hP V₁ hV₁ ((k ≫ h') ≫ w) (k ≫ h)
    refine ⟨(G.obj.map e.hom.op).hom t, (k ≫ h').left z₁, ?_⟩
    have hG : (G.obj.map k.op).hom ((G.obj.map h.op).hom t) =
        (G.obj.map (k ≫ h').op).hom ((G.obj.map w.op).hom ((G.obj.map e.hom.op).hom t)) := by
      rw [hFun k h, hFun w e.hom, hFun (k ≫ h') (w ≫ e.hom), he]
      simp only [Category.assoc]
    subst hkz
    rw [hc, ← hnat V₁ V k h' (k ≫ h') rfl _ z₁, hG]
    exact hnat V₁ W (k ≫ h') (𝟙 W) (k ≫ h') (Category.comp_id _) _ z₁

  obtain ⟨z₀⟩ := hV₀.toNonempty
  have hc1 : ∀ t q, c t q = wcContEval (wcP1Over K).left V₀
      ((θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom
        ((G.obj.map h₁.op).hom ((G.obj.map w.op).hom t))) z₀ := by
    intro t q
    rw [hc]
    exact (hconst W hW _ q (h₁.left z₀)).trans
      (hnat V₀ W h₁ (𝟙 W) h₁ (Category.comp_id _) _ z₀).symm
  have hc2 : ∀ t q, c t q = wcContEval (wcP1Over K).left V₀
      ((θ.hom.hom.app (Opposite.op (Over.mk h₂))).hom
        ((G.obj.map h₂.op).hom ((G.obj.map w.op).hom t))) z₀ := by
    intro t q
    rw [hc]
    exact (hconst W hW _ q (h₂.left z₀)).trans
      (hnat V₀ W h₂ (𝟙 W) h₂ (Category.comp_id _) _ z₀).symm
  have hstab : ∀ t q, A (c t q) ∈ wcH0Span K hP ℓ G W N θ := by
    intro t q
    obtain ⟨e₀, he₀⟩ := wc_geomPoint_hom_twist K (wcP1Over K) hP V₀ hV₀ (h₂ ≫ w) (h₁ ≫ w)
    rw [hc1, ← hAm, hFun h₁ w, he₀, Category.assoc, ← hFun h₂ (w ≫ e₀.hom), ← hFun w e₀.hom,
      ← hc2 ((G.obj.map e₀.hom.op).hom t) q]
    exact hGen _ _
  have hfix : h₁ ≫ w = h₂ ≫ w → ∀ t q, A (c t q) = c t q := by
    intro hw t q
    conv_lhs => rw [hc1 t q]
    rw [← hAm, hFun h₁ w, hw, ← hFun h₂ w, ← hc2 t q]

  have hspan : wcH0Span K hP ℓ G W N θ ≤ (wcH0Span K hP ℓ G W N θ).comap A := by
    apply Submodule.span_le.mpr
    rintro v ⟨t, V, h, h', z', rfl⟩
    obtain ⟨t', q, hv⟩ := hstep1 t V h h' z'
    rw [SetLike.mem_coe, Submodule.mem_comap, hv]
    exact hstab t' q
  refine ⟨fun z => ?_, fun hw z => ?_⟩
  · rw [hAm]
    exact hspan (hx z)
  · have hker : wcH0Span K hP ℓ G W N θ ≤ LinearMap.ker (A - LinearMap.id) := by
      apply Submodule.span_le.mpr
      rintro v ⟨t, V, h, h', z', rfl⟩
      obtain ⟨t', q, hv⟩ := hstep1 t V h h' z'
      rw [SetLike.mem_coe, LinearMap.mem_ker, hv, LinearMap.sub_apply, LinearMap.id_apply,
        hfix hw t' q, sub_self]
    have h0 := hker (hx z)
    rw [LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.id_apply, sub_eq_zero] at h0
    rw [hAm, h0]

theorem wc_pencil_kernelSubsheaf_geomConst (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (N : ℕ)
    (hqc : QuasiCompact w.left) (hW : ConnectedSpace W.left)
    (hsurj : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left,
      (∀ i : Fin D.m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠ D.S i (IsLocalRing.closedPoint F'')) →
      ∃ z : W.left, w.left z = p)
    (θ : (wcRq D.f ℓ (n - 1)).over W ≅ (wcContSheaf (wcP1Over F'').left (Fin N → ℚ_[ℓ])).over W)
    (U : Submodule ℚ_[ℓ] (Fin N → ℚ_[ℓ]))
    (hU : ∀ (V₀ : (wcP1Over F'').left.ProEt) (hV₀ : ConnectedSpace V₀.left) (h₁ h₂ : V₀ ⟶ W)
      (x : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V₀)),
      (∀ z : V₀.left, wcContEval (wcP1Over F'').left V₀
        ((θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x) z ∈ U) →
      ∀ z : V₀.left, wcContEval (wcP1Over F'').left V₀
        ((θ.hom.hom.app (Opposite.op (Over.mk h₂))).hom x) z ∈ U)
    (hfix : ∀ (V₀ : (wcP1Over F'').left.ProEt) (hV₀ : ConnectedSpace V₀.left) (h₁ h₂ : V₀ ⟶ W)
      (x : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V₀)),
      (∀ z : V₀.left, wcContEval (wcP1Over F'').left V₀
        ((θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x) z ∈ U) →
      h₁ ≫ w = h₂ ≫ w → ∀ z : V₀.left,
        wcContEval (wcP1Over F'').left V₀ ((θ.hom.hom.app (Opposite.op (Over.mk h₂))).hom x) z =
          wcContEval (wcP1Over F'').left V₀ ((θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x) z)
    (M : Subobject (wcRq D.f ℓ (n - 1)))
    (hM : ∀ (T : (wcP1Over F'').left.ProEt) (x : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op T)),
      (∃ x' : (Subobject.underlying.obj M).obj.obj (Opposite.op T),
        (M.arrow.hom.app (Opposite.op T)).hom x' = x) ↔
        wcThetaCond (wcP1Over F'').left ℓ (wcRq D.f ℓ (n - 1)) W N θ U T x) :
    wcPencilGC F'' hP ℓ (Subobject.underlying.obj M) :=
by
  exact wc_kss_geomConst_of_extension F'' hP ℓ D.m D.S D.hS (wcRq D.f ℓ (n - 1)) W w N hqc
    hsurj θ U hU hfix M hM
    (wc_pencil_Rq_no_punctual_sections F' F'' Y n hn hn2 D ℓ hℓ hP)
    (wc_pencil_Rq_extend_off_crit F' F'' Y n hn hn2 D ℓ hℓ hP)

theorem wc_pencil_Rq_H0_GC_span (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (y : wcCohG F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - 1)) 0) :
    ∃ M : Subobject (wcRq D.f ℓ (n - 1)), wcPencilStable D ℓ M ∧
      wcPencilGC F'' hP ℓ (Subobject.underlying.obj M) ∧
      ∃ y' : wcCohG F'' (wcP1Over F'') hP (Subobject.underlying.obj M) 0,
        y = y'.comp (Abelian.Ext.mk₀ M.arrow) (add_zero 0) :=
by
  classical

  obtain ⟨W, w, N, hqc, hconn, hsurj, ⟨θ⟩⟩ :=
    wc_pencil_Rq_connected_trivialization_all_q F' F'' Y n D ℓ hℓ hP (n - 1)

  obtain ⟨M, hMiff, hMfac⟩ :=
    wc_proet_theta_subsheaf (wcP1Over F'').left ℓ (wcRq D.f ℓ (n - 1)) W N θ
      (wcH0Span F'' hP ℓ (wcRq D.f ℓ (n - 1)) W N θ)

  have hGC : wcPencilGC F'' hP ℓ (Subobject.underlying.obj M) :=
    wc_pencil_kernelSubsheaf_geomConst F' F'' Y n hn hn2 D ℓ hℓ hP W w N hqc hconn hsurj θ
      (wcH0Span F'' hP ℓ (wcRq D.f ℓ (n - 1)) W N θ)
      (fun V₀ hV₀ h₁ h₂ x hx =>
        (wc_proet_theta_frame F'' hP ℓ (wcRq D.f ℓ (n - 1)) W w N hconn θ V₀ hV₀ h₁ h₂ x hx).1)
      (fun V₀ hV₀ h₁ h₂ x hx hw =>
        (wc_proet_theta_frame F'' hP ℓ (wcRq D.f ℓ (n - 1)) W w N hconn θ V₀ hV₀ h₁ h₂ x hx).2 hw)
      M hMiff

  have hstab : wcPencilStable D ℓ M := by
    intro c
    obtain ⟨A, hA⟩ := wc_contSheaf_over_hom_linear (wcP1Over F'').left ℓ W hconn N N
      (θ.inv ≫ ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} W).map
        (wcRqScalar D.f ℓ (n - 1) c) ≫ θ.hom)
    have hcomm : ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} W).map
        (wcRqScalar D.f ℓ (n - 1) c) ≫ θ.hom =
        θ.hom ≫ ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} W).map
          (wcContSheafMap (wcP1Over F'').left A.toAddMonoidHom
            (LinearMap.continuous_of_finiteDimensional A)) := by
      rw [← hA, Iso.hom_inv_id_assoc]
    have hval : ∀ (V : (wcP1Over F'').left.ProEt) (h' : V ⟶ W)
        (x : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)) (z : V.left),
        wcContEval (wcP1Over F'').left V ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom
          (((wcRqScalar D.f ℓ (n - 1) c).hom.app (Opposite.op V)).hom x)) z =
        A (wcContEval (wcP1Over F'').left V
          ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom x) z) := by
      intro V h' x z
      have e1 := congrArg (fun ψ => (ψ.hom.app (Opposite.op (Over.mk h'))).hom x) hcomm
      exact congrArg (fun f => wcContEval (wcP1Over F'').left V f z) e1
    have hnat : ∀ (T V : (wcP1Over F'').left.ProEt) (h : V ⟶ T)
        (x : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op T)),
        ((wcRq D.f ℓ (n - 1)).obj.map h.op).hom
            (((wcRqScalar D.f ℓ (n - 1) c).hom.app (Opposite.op T)).hom x) =
          ((wcRqScalar D.f ℓ (n - 1) c).hom.app (Opposite.op V)).hom
            (((wcRq D.f ℓ (n - 1)).obj.map h.op).hom x) := by
      intro T V h x
      have e2 := (wcRqScalar D.f ℓ (n - 1) c).hom.naturality h.op
      exact (congrArg (fun φ => φ.hom x) e2).symm
    have hle : wcH0Span F'' hP ℓ (wcRq D.f ℓ (n - 1)) W N θ ≤
        (wcH0Span F'' hP ℓ (wcRq D.f ℓ (n - 1)) W N θ).comap A := by
      apply Submodule.span_le.mpr
      rintro v ⟨t, V, h, h', z, rfl⟩
      rw [SetLike.mem_coe, Submodule.mem_comap, ← hval V h' _ z, ← hnat _ V h t]
      exact Submodule.subset_span ⟨_, V, h, h', z, rfl⟩
    have hcond : ∀ (T : (wcP1Over F'').left.ProEt)
        (x : (Subobject.underlying.obj M).obj.obj (Opposite.op T)),
        wcThetaCond (wcP1Over F'').left ℓ (wcRq D.f ℓ (n - 1)) W N θ
          (wcH0Span F'' hP ℓ (wcRq D.f ℓ (n - 1)) W N θ) T
          (((M.arrow ≫ wcRqScalar D.f ℓ (n - 1) c).hom.app (Opposite.op T)).hom x) := by
      intro T x V h h' z
      have hx0 := (hMiff T ((M.arrow.hom.app (Opposite.op T)).hom x)).1 ⟨x, rfl⟩
      show wcContEval (wcP1Over F'').left V ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom
        (((wcRq D.f ℓ (n - 1)).obj.map h.op).hom
          (((wcRqScalar D.f ℓ (n - 1) c).hom.app (Opposite.op T)).hom
            ((M.arrow.hom.app (Opposite.op T)).hom x)))) z ∈ _
      rw [hnat, hval]
      exact hle (hx0 V h h' z)
    obtain ⟨ψ, hψ⟩ := hMfac _ _ hcond
    exact ⟨ψ, hψ⟩

  obtain ⟨e, he, -⟩ :=
    proet_free_sheaf_hom_equiv (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP)
  obtain ⟨f, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 y
  have hs : wcThetaCond (wcP1Over F'').left ℓ (wcRq D.f ℓ (n - 1)) W N θ
      (wcH0Span F'' hP ℓ (wcRq D.f ℓ (n - 1)) W N θ) _ (e _ f) := by
    intro V h h' z
    exact Submodule.subset_span ⟨e _ f, V, h, h', z, rfl⟩
  obtain ⟨s', hs'⟩ := (hMiff _ (e _ f)).2 hs
  refine ⟨M, hstab, hGC, Abelian.Ext.mk₀ ((e _).symm s'), ?_⟩
  have hg : (e _).symm s' ≫ M.arrow = f := by
    apply (e (wcRq D.f ℓ (n - 1))).injective
    rw [he, Equiv.apply_symm_apply]
    exact hs'
  rw [Abelian.Ext.mk₀_comp_mk₀, hg]

theorem wc_P1_H3_geomConst_vanish (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (hG : wcPencilGC K hP ℓ G) :
    ∀ x : wcCohG K (wcP1Over K) hP G 3, x = 0 :=
by
  classical

  have hAffGI : ∀ (F : Type u) [Field F] (σ : Type u),
      GeometricallyIrreducible (AffineSpace σ (Spec (.of F)) ↘ Spec (.of F)) := by
    intro F _ σ
    constructor
    intro K' _ y Z fst snd h
    let e2 : Z ≅ Spec (.of (MvPolynomial σ (CommRingCat.of K'))) :=
      h.isoIsPullback _ _ (AffineSpace.isPullback_map (n := σ) y) ≪≫
        AffineSpace.SpecIso σ (.of K')
    exact Function.Surjective.irreducibleSpace (Scheme.homeoOfIso e2.symm).continuous
      (Scheme.homeoOfIso e2.symm).surjective

  have hGI : GeometricallyIrreducible (wcProjKStr K 1) := by
    obtain ⟨pt, -, hpt⟩ := wc_pp_rational_point K 1
    refine wc_pp_geomIrred_of_charts (wcProjKStr K 1)
      (fun a : Fin (1 + 1) => @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) MvPolynomial.gradedAlgebra
        (MvPolynomial.X a)) 0 (wc_pp_basicOpen_cover K 1) ?_ ?_
    · intro a
      obtain ⟨e, he⟩ := wc_pp_dehomogenize_ringEquiv K 1 a
      obtain ⟨φ, hφ⟩ := wc_pp_chart_iso K 1 a e he
      exact ⟨_, _, hAffGI K (ULift.{u} (Fin 1)), φ, hφ⟩
    · have hmem : ∀ a : Fin (1 + 1), pt (IsLocalRing.closedPoint K) ∈
          @Proj.basicOpen _ _ _ _ _
            (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) MvPolynomial.gradedAlgebra
            (MvPolynomial.X a) := by
        intro a
        have h1 : IsLocalRing.closedPoint K ∈ pt ⁻¹ᵁ (@Proj.basicOpen _ _ _ _ _
            (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) MvPolynomial.gradedAlgebra
            (MvPolynomial.X a)) := by
          rw [hpt a]; trivial
        exact h1
      intro a
      exact ⟨pt (IsLocalRing.closedPoint K), hmem a, hmem 0⟩

  haveI : IsProper (wcP1Over K).hom := wc_proj_space_isProper K 1
  haveI : SmoothOfRelativeDimension 1 (wcP1Over K).hom := wc_proj_space_smooth K 1
  haveI : GeometricallyIrreducible (wcP1Over K).hom := hGI

  have hLad : ∀ x : wcCoh K (wcP1Over K) hP ℓ 3, x = 0 :=
    wc_coh_vanishing K (wcP1Over K) 1 ℓ hℓ hP 3 (by norm_num)
  have hLad' : ∀ x : Abelian.Ext (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP))
      (wcContSheaf (wcP1Over K).left ℚ_[ℓ]) 3, x = 0 := fun x => hLad x

  have g9 : ∀ (r : ℕ) (x : Abelian.Ext (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP))
      (wcContSheaf (wcP1Over K).left (Fin r → ℚ_[ℓ])) 3), x = 0 := by
    intro r
    induction r with
    | zero =>
      intro x
      have hz : 𝟙 (wcContSheaf (wcP1Over K).left (Fin 0 → ℚ_[ℓ])) = 0 := by
        apply Sheaf.hom_ext
        apply NatTrans.ext
        funext W
        apply AddCommGrpCat.ext
        intro t
        apply ULift.ext
        apply ContinuousMap.ext
        intro p
        exact Subsingleton.elim _ _
      calc x = x.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero 3) := (Abelian.Ext.comp_mk₀_id x).symm
        _ = x.comp (Abelian.Ext.mk₀ 0) (add_zero 3) := by rw [hz]
        _ = 0 := by rw [Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    | succ r ih =>
      intro y
      let φ : ℚ_[ℓ] →+ (Fin (r + 1) → ℚ_[ℓ]) := AddMonoidHom.single (fun _ : Fin (r + 1) => ℚ_[ℓ]) 0
      let ψ : (Fin (r + 1) → ℚ_[ℓ]) →+ (Fin r → ℚ_[ℓ]) :=
        { toFun := fun b j => b j.succ
          map_zero' := rfl
          map_add' := fun _ _ => rfl }
      have hφapp : ∀ a : ℚ_[ℓ], φ a = Pi.single 0 a := fun a => rfl
      have hψapp : ∀ (b : Fin (r + 1) → ℚ_[ℓ]) (j : Fin r), ψ b j = b j.succ := fun b j => rfl
      have hφ : Continuous φ := by
        have : (⇑φ) = fun a : ℚ_[ℓ] => (Pi.single 0 a : Fin (r + 1) → ℚ_[ℓ]) := funext hφapp
        rw [this]
        exact continuous_single (A := fun _ : Fin (r + 1) => ℚ_[ℓ]) 0
      have hψ : Continuous ψ := by
        have : (⇑ψ) = fun (b : Fin (r + 1) → ℚ_[ℓ]) (j : Fin r) => b j.succ := rfl
        rw [this]
        exact continuous_pi fun j => continuous_apply _
      have hemb : Topology.IsEmbedding φ := by
        refine Function.LeftInverse.isEmbedding (f := fun b : Fin (r + 1) → ℚ_[ℓ] => b 0)
          (fun a => ?_) (continuous_apply 0) hφ
        show φ a 0 = a
        rw [hφapp, Pi.single_eq_same]
      have hker : ∀ b : Fin (r + 1) → ℚ_[ℓ], ψ b = 0 ↔ ∃ a : ℚ_[ℓ], φ a = b := by
        intro b
        constructor
        · intro hb
          refine ⟨b 0, ?_⟩
          funext i
          refine Fin.cases ?_ (fun j => ?_) i
          · rw [hφapp, Pi.single_eq_same]
          · rw [hφapp, Pi.single_eq_of_ne (Fin.succ_ne_zero j)]
            have := congrFun hb j
            rw [hψapp] at this
            exact this.symm
        · rintro ⟨a, rfl⟩
          funext j
          rw [hψapp, hφapp, Pi.single_eq_of_ne (Fin.succ_ne_zero j)]
          rfl
      have hsec : ∃ σ : (Fin r → ℚ_[ℓ]) → (Fin (r + 1) → ℚ_[ℓ]), Continuous σ ∧ ∀ c, ψ (σ c) = c := by
        refine ⟨fun c => Fin.cons (0 : ℚ_[ℓ]) c, Continuous.finCons continuous_const continuous_id, ?_⟩
        intro c
        funext j
        rw [hψapp]
        exact Fin.cons_succ _ _ _
      obtain ⟨hzero, hS⟩ := wc_contSheaf_shortExact (wcP1Over K).left φ hφ ψ hψ hemb hker hsec
      obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hS y (ih _)
      rw [← hx₁, show x₁ = 0 from hLad' x₁, Abelian.Ext.zero_comp]

  obtain ⟨r, ⟨eG⟩⟩ := hG
  intro x
  letI : HasExt (Sheaf ((Scheme.ProEt.topology (wcP1Over K).left).over
      (wcGeomPoint K (wcP1Over K) hP)) AddCommGrpCat.{u+1}) := HasExt.standard _
  obtain ⟨φG⟩ := wc_proet_free_slice_ext_equiv (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP) G 3
  obtain ⟨φH⟩ := wc_proet_free_slice_ext_equiv (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)
    (wcContSheaf (wcP1Over K).left (Fin r → ℚ_[ℓ])) 3
  have h1 : (φG x).comp (Abelian.Ext.mk₀ eG.hom) (add_zero 3) = 0 := by
    have h0 := g9 r (φH.symm ((φG x).comp (Abelian.Ext.mk₀ eG.hom) (add_zero 3)))
    have h0' := congrArg φH h0
    rw [AddEquiv.apply_symm_apply, map_zero] at h0'
    exact h0'
  have h2 : φG x = 0 := by
    calc φG x = ((φG x).comp (Abelian.Ext.mk₀ eG.hom) (add_zero 3)).comp
          (Abelian.Ext.mk₀ eG.inv) (add_zero 3) := by
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero 3) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
      _ = 0 := by rw [h1, Abelian.Ext.zero_comp]
  exact φG.injective (h2.trans (map_zero φG).symm)

theorem wc_pencil_Rq_sub_deck_span_top (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (q : ℕ) (M : Subobject (wcRq D.f ℓ q))
    (hM : wcPencilGC F'' hP ℓ (Limits.cokernel M.arrow) ∨ Limits.IsZero (Limits.cokernel M.arrow))
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (k : ℕ)
    (θ : (Subobject.underlying.obj M).over W ≅
      (wcContSheaf (wcP1Over F'').left (Fin k → ℚ_[ℓ])).over W)
    (hqc : QuasiCompact w.left) (hconn : ConnectedSpace W.left)
    (hsurj : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left,
      (∀ i : Fin D.m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠
        D.S i (IsLocalRing.closedPoint F'')) →
      ∃ z : W.left, w.left z = p)
    (hgal : ∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ W), ConnectedSpace V.left →
      a ≫ w = b ≫ w → ∃ γ : W ⟶ W, γ ≫ w = w ∧ b = a ≫ γ)
    (hhom : ∀ φ : (Subobject.underlying.obj M).over (wcGeomPoint F'' (wcP1Over F'') hP) ⟶
        (wcContSheaf (wcP1Over F'').left ℚ_[ℓ]).over (wcGeomPoint F'' (wcP1Over F'') hP), φ = 0) :
    Submodule.span ℚ_[ℓ] (⋃ p : {p : (W ⟶ W) × ((Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ])) //
        p.1 ≫ w = w ∧
        ∀ (s : (Subobject.underlying.obj M).obj.obj (Opposite.op W)) (z : W.left),
          (show C(↥W.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk p.1))).hom s).down) z =
          p.2 ((show C(↥W.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z)},
      Set.range ⇑((p.1.2 - LinearMap.id :
        (Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ])))) = ⊤ :=
by
  classical

  by_contra hne
  obtain ⟨μ, hμ0, hNμ⟩ := Submodule.exists_le_ker_of_lt_top _ (lt_top_iff_ne_top.mpr hne)
  obtain ⟨v₀, hv₀⟩ : ∃ v₀, μ v₀ ≠ 0 := by
    by_contra h
    push_neg at h
    exact hμ0 (LinearMap.ext h)

  have hinv : ∀ γ : W ⟶ W, γ ≫ w = w → ∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ W),
      b = a ≫ γ → ∀ (x : (Subobject.underlying.obj M).obj.obj (Opposite.op V)) (z : V.left),
        μ ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z) =
        μ ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z) := by
    intro γ hγ V a b hab x z
    obtain ⟨A, hA⟩ := wc_proet_deck_frame_linear (wcP1Over F'').left ℓ
      (Subobject.underlying.obj M) W hconn k θ γ
    have hAμ : ∀ u, μ (A u) = μ u := by
      intro u
      have hm := hNμ (Submodule.subset_span (Set.mem_iUnion.mpr
        ⟨⟨(γ, A), hγ, fun s z => hA W (𝟙 W) γ (Category.id_comp γ).symm s z⟩, u, rfl⟩))
      rw [LinearMap.mem_ker] at hm
      have h2 : μ (A u - u) = 0 := hm
      rw [map_sub, sub_eq_zero] at h2
      exact h2
    exact (congrArg μ (hA V a b hab x z)).trans (hAμ _)

  obtain ⟨fv, hCP⟩ : ∃ fv : ∀ T : Over (wcGeomPoint F'' (wcP1Over F'') hP),
      (Subobject.underlying.obj M).obj.obj (Opposite.op T.left) → T.left.left → ℚ_[ℓ],
      ∀ (T : Over (wcGeomPoint F'' (wcP1Over F'') hP))
        (s : (Subobject.underlying.obj M).obj.obj (Opposite.op T.left))
        (V : (wcP1Over F'').left.ProEt) (h : V ⟶ T.left) (h' : V ⟶ W),
        h' ≫ w = h ≫ T.hom → ∀ v : V.left, fv T s (h.left v) =
          μ ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom
              (((Subobject.underlying.obj M).obj.map h.op).hom s)).down) v) := by
    refine ⟨fun T s τ => if hne : ({r : ℚ_[ℓ] | ∃ (V : (wcP1Over F'').left.ProEt)
        (h : V ⟶ T.left) (h' : V ⟶ W) (v : V.left), h' ≫ w = h ≫ T.hom ∧ h.left v = τ ∧
          r = μ ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom
              (((Subobject.underlying.obj M).obj.map h.op).hom s)).down) v)} : Set ℚ_[ℓ]).Nonempty
      then hne.some else 0, ?_⟩
    intro T s V h h' e v
    dsimp only
    split_ifs with hne
    · obtain ⟨V₁, h₁, h₁', v₁, e₁, hv₁, hr⟩ := hne.some_mem
      rw [hr]
      exact wc_proet_deck_value_unique (wcP1Over F'').left ℓ (Subobject.underlying.obj M)
        (wcGeomPoint F'' (wcP1Over F'') hP) W w hgal k θ μ hinv T.left T.hom s V₁ V h₁ h₁' h h'
        e₁ e v₁ v hv₁
    · exact (hne ⟨_, V, h, h', v, e, rfl, rfl⟩).elim

  have hext : ∀ (T : Over (wcGeomPoint F'' (wcP1Over F'') hP))
      (s : (Subobject.underlying.obj M).obj.obj (Opposite.op T.left)),
      ∃ g : C(↥T.left.left, ℚ_[ℓ]), ∀ x : T.left.left,
        ∀ y ∈ {τ : T.left.left | ∀ i, T.left.hom τ ≠ D.S i (IsLocalRing.closedPoint F'')},
          y ⤳ x → g x = fv T s y := by
    intro T s
    obtain ⟨_, hcont⟩ := wc_proet_deck_chart_continuousOn F'' hP D.m D.S D.hS ℓ
      (Subobject.underlying.obj M) W w hqc hsurj k θ μ T.left T.hom s
    obtain ⟨hgen, hlcl⟩ := wc_P1_proet_offS_local_clopen F'' D.m D.S D.hS T.left
    exact wc_top_ultrametric_extend_of_local_clopen ℓ _ (fv T s)
      (hcont (fv T s) (fun V h h' e v => hCP T s V h h' e v)) hgen hlcl
  choose Fm hFm using hext

  have hgood : ∀ (T : Over (wcGeomPoint F'' (wcP1Over F'') hP)) (x : T.left.left),
      ∃ (V : (wcP1Over F'').left.ProEt) (h : V ⟶ T.left) (h' : V ⟶ W) (v : V.left),
        h' ≫ w = h ≫ T.hom ∧ (∀ i, T.left.hom (h.left v) ≠ D.S i (IsLocalRing.closedPoint F'')) ∧
        h.left v ⤳ x := by
    intro T x
    obtain ⟨y, hy, hyx⟩ := (wc_P1_proet_offS_local_clopen F'' D.m D.S D.hS T.left).1 x
    obtain ⟨V, h, h', v, e, hv⟩ := (wc_proet_deck_chart_continuousOn F'' hP D.m D.S D.hS ℓ
      (Subobject.underlying.obj M) W w hqc hsurj k θ μ T.left T.hom 0).1 y hy
    refine ⟨V, h, h', v, e, ?_, ?_⟩
    · rw [hv]; exact hy
    · rw [hv]; exact hyx

  have hval : ∀ (T : Over (wcGeomPoint F'' (wcP1Over F'') hP))
      (s : (Subobject.underlying.obj M).obj.obj (Opposite.op T.left)) (x : T.left.left)
      (V : (wcP1Over F'').left.ProEt) (h : V ⟶ T.left) (h' : V ⟶ W) (v : V.left),
      h' ≫ w = h ≫ T.hom → (∀ i, T.left.hom (h.left v) ≠ D.S i (IsLocalRing.closedPoint F'')) →
      h.left v ⤳ x →
      Fm T s x = μ ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom
          (((Subobject.underlying.obj M).obj.map h.op).hom s)).down) v) := by
    intro T s x V h h' v e hY hsp
    rw [hFm T s x (h.left v) hY hsp, hCP T s V h h' e v]

  have hlin : ∀ (V : (wcP1Over F'').left.ProEt) (a : V ⟶ W)
      (x y : (Subobject.underlying.obj M).obj.obj (Opposite.op V)) (z : V.left),
      μ ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom (x + y)).down) z) =
      μ ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z) +
      μ ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom y).down) z) := by
    intro V a x y z
    have e : (show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom (x + y)).down) z =
      (show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z +
      (show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom y).down) z := by
      have hm := map_add ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom) x y
      exact (congrArg (fun c : ((wcContSheaf (wcP1Over F'').left (Fin k → ℚ_[ℓ])).over W).obj.obj
          (Opposite.op (Over.mk a)) => (show C(↥V.left, Fin k → ℚ_[ℓ]) from c.down) z) hm).trans rfl
    rw [e, map_add]

  have hadd : ∀ (T : Over (wcGeomPoint F'' (wcP1Over F'') hP))
      (s s' : (Subobject.underlying.obj M).obj.obj (Opposite.op T.left)),
      Fm T (s + s') = Fm T s + Fm T s' := by
    intro T s s'
    ext x
    obtain ⟨V, h, h', v, e, hY, hsp⟩ := hgood T x
    rw [ContinuousMap.add_apply, hval T (s + s') x V h h' v e hY hsp,
      hval T s x V h h' v e hY hsp, hval T s' x V h h' v e hY hsp,
      map_add ((Subobject.underlying.obj M).obj.map h.op).hom s s']
    exact hlin V h' _ _ v

  have hnat : ∀ (T T' : Over (wcGeomPoint F'' (wcP1Over F'') hP)) (c : T' ⟶ T)
      (s : (Subobject.underlying.obj M).obj.obj (Opposite.op T.left)) (z : T'.left.left),
      Fm T' (((Subobject.underlying.obj M).obj.map c.left.op).hom s) z =
        Fm T s (c.left.left z) := by
    intro T T' c s z
    obtain ⟨V, h, h', v, e, hY, hsp⟩ := hgood T' z
    have hcomp : (h ≫ c.left).left v = c.left.left (h.left v) := by
      first
        | rfl
        | simp [Scheme.Hom.comp_apply]
    have e' : h' ≫ w = (h ≫ c.left) ≫ T.hom := by
      rw [Category.assoc, Over.w c]
      exact e
    have hTT : T.left.hom (c.left.left (h.left v)) = T'.left.hom (h.left v) := by
      rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w c.left]
    have hY' : ∀ i, T.left.hom ((h ≫ c.left).left v) ≠ D.S i (IsLocalRing.closedPoint F'') := by
      intro i
      rw [hcomp, hTT]
      exact hY i
    have hsp' : (h ≫ c.left).left v ⤳ c.left.left z := by
      rw [hcomp]
      exact hsp.map (c.left.left).continuous
    rw [hval T' _ z V h h' v e hY hsp, hval T s (c.left.left z) V (h ≫ c.left) h' v e' hY' hsp',
      op_comp, Functor.map_comp]
    try rfl

  obtain ⟨φ, hφ⟩ := wc_proet_over_hom_of_continuous_family (wcP1Over F'').left ℓ
    (Subobject.underlying.obj M) (wcGeomPoint F'' (wcP1Over F'') hP) Fm hadd hnat
  have h0 := hhom φ
  subst h0
  haveI := hconn
  obtain ⟨z₀⟩ : Nonempty W.left := inferInstance
  obtain ⟨y, hy, -⟩ := (wc_P1_proet_offS_local_clopen F'' D.m D.S D.hS W).1 z₀
  obtain ⟨c₀, hc₀⟩ : ∃ c₀ : ((wcContSheaf (wcP1Over F'').left (Fin k → ℚ_[ℓ])).over W).obj.obj
      (Opposite.op (Over.mk (𝟙 W))),
      ∀ z, (show C(↥W.left, Fin k → ℚ_[ℓ]) from c₀.down) z = v₀ :=
    ⟨ULift.up (ContinuousMap.const _ v₀), fun z => rfl⟩
  obtain ⟨s₀, hs₀⟩ : ∃ s₀ : (Subobject.underlying.obj M).obj.obj (Opposite.op W),
      s₀ = (θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom c₀ := ⟨_, rfl⟩
  have hθ : (θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom
      ((θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom c₀) = c₀ := by
    have h1 := congrArg (fun f : ((wcContSheaf (wcP1Over F'').left (Fin k → ℚ_[ℓ])).over W ⟶
        (wcContSheaf (wcP1Over F'').left (Fin k → ℚ_[ℓ])).over W) =>
          (f.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom c₀) θ.inv_hom_id
    exact h1
  have hid : ((Subobject.underlying.obj M).obj.map (𝟙 W).op).hom s₀ = s₀ := by
    rw [op_id, CategoryTheory.Functor.map_id]
    first
      | rfl
      | simp
  have hz : Fm (Over.mk w) s₀ y = 0 := by
    rw [← hφ (Over.mk w) s₀ y]
    first
      | rfl
      | simp
  have hval0 := hval (Over.mk w) s₀ y W (𝟙 W) (𝟙 W) y rfl hy (specializes_refl y)
  have hcalc : μ ((show C(↥W.left, Fin k → ℚ_[ℓ]) from
      ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom
        (((Subobject.underlying.obj M).obj.map (𝟙 W).op).hom s₀)).down) y) = μ v₀ := by
    rw [hid, hs₀]
    exact (congrArg (fun c : ((wcContSheaf (wcP1Over F'').left (Fin k → ℚ_[ℓ])).over W).obj.obj
        (Opposite.op (Over.mk (𝟙 W))) =>
          μ ((show C(↥W.left, Fin k → ℚ_[ℓ]) from c.down) y)) hθ).trans (congrArg μ (hc₀ y))
  exact hv₀ (hcalc.symm.trans (hval0.symm.trans hz))

theorem wc_pencil_Rq_sub_H2_vanish_of_hom_zero (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (q : ℕ) (M : Subobject (wcRq D.f ℓ q))
    (hM : wcPencilGC F'' hP ℓ (Limits.cokernel M.arrow) ∨ Limits.IsZero (Limits.cokernel M.arrow))
    (hhom : ∀ φ : (Subobject.underlying.obj M).over (wcGeomPoint F'' (wcP1Over F'') hP) ⟶
        (wcContSheaf (wcP1Over F'').left ℚ_[ℓ]).over (wcGeomPoint F'' (wcP1Over F'') hP), φ = 0) :
    ∀ y : wcCohG F'' (wcP1Over F'') hP (Subobject.underlying.obj M) 2, y = 0 :=
by
  intro y
  obtain ⟨W, w, k, θ, hqc, hconn, hsurj, hgal⟩ :=
    wc_pencil_Rq_sub_galois_trivialization F' F'' Y n hn2 D ℓ hℓ hP q M hM
  obtain ⟨Γ, hΓs, hΓinv⟩ :=
    wc_pencil_Rq_sub_H2_coinvariant_bound F' F'' Y n hn2 D ℓ hℓ hP q M hM W w k θ hqc hconn hsurj
  have hspan := wc_pencil_Rq_sub_deck_span_top F' F'' Y n hn2 D ℓ hℓ hP q M hM W w k θ hqc hconn
    hsurj hgal hhom
  have hall : ∀ v : Fin k → ℚ_[ℓ], Γ v = 0 := by
    intro v
    have hv : v ∈ Submodule.span ℚ_[ℓ] (⋃ p : {p : (W ⟶ W) ×
        ((Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ])) //
        p.1 ≫ w = w ∧
        ∀ (s : (Subobject.underlying.obj M).obj.obj (Opposite.op W)) (z : W.left),
          (show C(↥W.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk p.1))).hom s).down) z =
          p.2 ((show C(↥W.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z)},
      Set.range ⇑((p.1.2 - LinearMap.id :
        (Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ])))) := by
      rw [hspan]; exact Submodule.mem_top
    have key : ∀ a : ℚ_[ℓ], Γ (a • v) = 0 := by
      induction hv using Submodule.span_induction with
      | mem x hx =>
        intro a
        obtain ⟨p, hp⟩ := Set.mem_iUnion.mp hx
        obtain ⟨u, rfl⟩ := hp
        have e : a • ((p.1.2 - LinearMap.id :
            (Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ])) u) = p.1.2 (a • u) - a • u := by
          rw [LinearMap.sub_apply, LinearMap.id_apply, smul_sub, LinearMap.map_smul]
        rw [e, map_sub, hΓinv p.1.1 p.1.2 p.2.1 p.2.2 (a • u), sub_self]
      | zero =>
        intro a
        rw [smul_zero, map_zero]
      | add x x' _ _ hx hx' =>
        intro a
        rw [smul_add, map_add, hx a, hx' a, add_zero]
      | smul b x _ hx =>
        intro a
        rw [smul_smul]
        exact hx (a * b)
    simpa using key 1
  obtain ⟨v, rfl⟩ := hΓs y
  exact hall v

theorem wc_pencil_E_H2_vanish (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n) (hNM : wcPencilNoMixed D)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hNI : ∃ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β ∧
      β ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n)) :
    ∀ y : wcCohG F'' (wcP1Over F'') hP (Subobject.underlying.obj (wcPencilE D ℓ hP)) 2, y = 0 :=
by
  classical

  have hM : wcPencilGC F'' hP ℓ (Limits.cokernel (wcPencilE D ℓ hP).arrow) ∨
      Limits.IsZero (Limits.cokernel (wcPencilE D ℓ hP).arrow) := by
    by_cases h : ∃ M : Subobject (wcRq D.f ℓ (n - 1)), wcPencilStable D ℓ M ∧
        wcPencilGC F'' hP ℓ (Limits.cokernel M.arrow) ∧
        ∀ M' : Subobject (wcRq D.f ℓ (n - 1)), wcPencilStable D ℓ M' →
          wcPencilGC F'' hP ℓ (Limits.cokernel M'.arrow) → M ≤ M'
    · have hE : wcPencilE D ℓ hP = Classical.choose h := dif_pos h
      rw [hE]
      exact Or.inl (Classical.choose_spec h).2.1
    · have hE : wcPencilE D ℓ hP = ⊤ := dif_neg h
      rw [hE]
      exact Or.inr (Limits.isZero_cokernel_of_epi _)

  have hhom := hNM ℓ hℓ hP hNI

  exact wc_pencil_Rq_sub_H2_vanish_of_hom_zero F' F'' Y n hn2 D ℓ hℓ hP (n - 1)
    (wcPencilE D ℓ hP) hM hhom

theorem wc_pencil_VQ_nonisotropic_local (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n) (hNM : wcPencilNoMixed D)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hNI : ∃ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β ∧
