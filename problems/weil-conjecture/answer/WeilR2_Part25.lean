theorem wc_pencil_VQ_fibre_zeta_split (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hNI : ∃ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β ∧
      β ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n)) :
    ∃ A B : Multiset (AlgebraicClosure ℚ_[ℓ]),
      (0 : AlgebraicClosure ℚ_[ℓ]) ∉ A ∧ (0 : AlgebraicClosure ℚ_[ℓ]) ∉ B ∧
      ∀ d : ℕ, 1 ≤ d → ∀ x ∈ wcP1ClosedPt F'' d, (∀ i, x ≠ D.S i (IsLocalRing.closedPoint F'')) →
        ∀ j : ℕ, 1 ≤ j → ∃ c : ℚ, ((wcPencilLoc D ℓ hP x d).map (· ^ j)).sum +
          (A.map (· ^ (d * j))).sum - (B.map (· ^ (d * j))).sum =
            algebraMap ℚ (AlgebraicClosure ℚ_[ℓ]) c :=
by
  classical

  have hring : ∀ q : ℕ, wcRqScalar D.f ℓ q 1 = 𝟙 _ ∧
      (∀ a b : ℚ_[ℓ], wcRqScalar D.f ℓ q (a * b) = wcRqScalar D.f ℓ q b ≫ wcRqScalar D.f ℓ q a) ∧
      (∀ a b : ℚ_[ℓ], wcRqScalar D.f ℓ q (a + b) = wcRqScalar D.f ℓ q a + wcRqScalar D.f ℓ q b) := by
    intro q
    have hLg : ∀ (S : Scheme.{u}),
        wcLadicScalar S ℓ 1 = 𝟙 _ ∧
        (∀ a b : ℚ_[ℓ], wcLadicScalar S ℓ (a * b) = wcLadicScalar S ℓ b ≫ wcLadicScalar S ℓ a) ∧
        (∀ a b : ℚ_[ℓ], wcLadicScalar S ℓ (a + b) = wcLadicScalar S ℓ a + wcLadicScalar S ℓ b) := by
      intro S
      have key : ∀ (c : ℚ_[ℓ]) (U : (S.ProEt)ᵒᵖ) (x : ((wcLadicSheaf S ℓ).obj.obj U : Type (u+1))),
          (wcLadicScalar S ℓ c).hom.app U x =
            (ULift.up (c • (ULift.down x : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj
              (Opposite.unop U)), ℚ_[ℓ]))) : _) := by
        intro c U x
        rfl
      refine ⟨?_, fun a b => ?_, fun a b => ?_⟩
      · apply Sheaf.hom_ext
        apply NatTrans.ext
        funext U
        apply AddCommGrpCat.ext
        intro x
        rw [key]
        apply ULift.ext
        exact one_smul _ _
      · apply Sheaf.hom_ext
        apply NatTrans.ext
        funext U
        apply AddCommGrpCat.ext
        intro x
        rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply,
          key, key, key]
        apply ULift.ext
        exact mul_smul _ _ _
      · apply Sheaf.hom_ext
        apply NatTrans.ext
        funext U
        apply AddCommGrpCat.ext
        intro x
        rw [Sheaf.Hom.add_app, AddCommGrpCat.hom_add_apply, key, key, key]
        apply ULift.ext
        exact add_smul _ _ _
    have hL1 : ∀ S : Scheme.{u}, wcLadicScalar S ℓ 1 = 𝟙 _ := fun S => (hLg S).1
    have hL2 : ∀ (S : Scheme.{u}) (a b : ℚ_[ℓ]),
        wcLadicScalar S ℓ (a * b) = wcLadicScalar S ℓ b ≫ wcLadicScalar S ℓ a :=
      fun S => (hLg S).2.1
    have hL3 : ∀ (S : Scheme.{u}) (a b : ℚ_[ℓ]),
        wcLadicScalar S ℓ (a + b) = wcLadicScalar S ℓ a + wcLadicScalar S ℓ b :=
      fun S => (hLg S).2.2
    have radd : ∀ {X Y : Sheaf (Scheme.ProEt.topology D.Yt.left) AddCommGrpCat.{u+1}}
        (f g : X ⟶ Y),
        ((wcProEtPush D.f).rightDerived q).map (f + g) =
          ((wcProEtPush D.f).rightDerived q).map f +
            ((wcProEtPush D.f).rightDerived q).map g := by
      intro X Y f g
      have ha := InjectiveResolution.desc_commutes f (injectiveResolution Y) (injectiveResolution X)
      have hb := InjectiveResolution.desc_commutes g (injectiveResolution Y) (injectiveResolution X)
      have hab : (injectiveResolution X).ι ≫
          (InjectiveResolution.desc f (injectiveResolution Y) (injectiveResolution X) +
            InjectiveResolution.desc g (injectiveResolution Y) (injectiveResolution X)) =
          (CochainComplex.single₀ _).map (f + g) ≫ (injectiveResolution Y).ι := by
        rw [Preadditive.comp_add, ha, hb, Functor.map_add, Preadditive.add_comp]
      rw [(wcProEtPush D.f).rightDerived_map_eq q (f + g) _ hab,
        (wcProEtPush D.f).rightDerived_map_eq q f _ ha,
        (wcProEtPush D.f).rightDerived_map_eq q g _ hb, Functor.map_add,
        Preadditive.add_comp, Preadditive.comp_add]
    refine ⟨?_, fun a b => ?_, fun a b => ?_⟩
    · show ((wcProEtPush D.f).rightDerived q).map (wcLadicScalar D.Yt.left ℓ 1) = 𝟙 _
      rw [hL1, CategoryTheory.Functor.map_id]
      all_goals rfl
    · show ((wcProEtPush D.f).rightDerived q).map (wcLadicScalar D.Yt.left ℓ (a * b)) =
        ((wcProEtPush D.f).rightDerived q).map (wcLadicScalar D.Yt.left ℓ b) ≫
          ((wcProEtPush D.f).rightDerived q).map (wcLadicScalar D.Yt.left ℓ a)
      rw [hL2, CategoryTheory.Functor.map_comp]
      all_goals rfl
    · show ((wcProEtPush D.f).rightDerived q).map (wcLadicScalar D.Yt.left ℓ (a + b)) =
        ((wcProEtPush D.f).rightDerived q).map (wcLadicScalar D.Yt.left ℓ a) +
          ((wcProEtPush D.f).rightDerived q).map (wcLadicScalar D.Yt.left ℓ b)
      rw [hL3, radd]
      all_goals rfl

  have hGC := wc_pencil_Rq_offmid_GC_offS F' F'' Y n hn hn2 D ℓ hℓ hP
  have hS2 := fun (q : ℕ) (hq : q ≠ n - 1) =>
    wc_GC_offS_stalk_frob_powersum F' F'' Y n D ℓ hℓ hP (wcRq D.f ℓ q) (Or.inl (hGC q hq))
      (wcRqScalar D.f ℓ q) (hring q).1 (hring q).2.1 (hring q).2.2
  choose! Γ hΓ0 hΓ using hS2

  obtain ⟨Gm, hGm0, hGm⟩ := wc_pencil_mid_stalk_split F' F'' Y n hn hn2 D ℓ hℓ hP hNI
  obtain ⟨Γ', hΓ'n, hΓ'o⟩ : ∃ Γ' : ℕ → Multiset (AlgebraicClosure ℚ_[ℓ]),
      Γ' (n - 1) = Gm ∧ ∀ q, q ≠ n - 1 → Γ' q = Γ q :=
    ⟨fun q => if q = n - 1 then Gm else Γ q, by simp, fun q hq => by simp [hq]⟩
  have hΓ'0 : ∀ q, (0 : AlgebraicClosure ℚ_[ℓ]) ∉ Γ' q := by
    intro q
    by_cases h : q = n - 1
    · rw [h, hΓ'n]; exact hGm0
    · rw [hΓ'o q h]; exact hΓ0 q h

  have hps : ∀ (s : Finset ℕ) (m : ℕ),
      ((∑ q ∈ s, Γ' q).map (· ^ m)).sum = ∑ q ∈ s, ((Γ' q).map (· ^ m)).sum := fun s m =>
    map_sum ((Multiset.sumAddMonoidHom).comp
      (Multiset.mapAddMonoidHom (fun z : AlgebraicClosure ℚ_[ℓ] => z ^ m))) Γ' s
  have hodd : Odd (n - 1) := by
    obtain ⟨m, hm⟩ := hn
    exact ⟨m - 1, by omega⟩
  refine ⟨∑ q ∈ (Finset.Iic (2 * (n - 1))).filter (fun q => Odd q), Γ' q,
    ∑ q ∈ (Finset.Iic (2 * (n - 1))).filter (fun q => ¬ Odd q), Γ' q, ?_, ?_, ?_⟩
  · rw [Multiset.mem_sum]
    rintro ⟨q, _, hq⟩
    exact hΓ'0 q hq
  · rw [Multiset.mem_sum]
    rintro ⟨q, _, hq⟩
    exact hΓ'0 q hq
  intro d hd x hx hxS j hj
  have hne := wc_pencil_VQ_stalk_basis_nonempty F' F'' Y n hn hn2 D ℓ hℓ hP hNI d hd x hx hxS
  have hloc : wcPencilLoc D ℓ hP x d =
      (wcAddEquivMatrix hne.some.e ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left
        hne.some.N.φ)).precomp (wcPencilVQ D ℓ hP) (zero_add 0))).charpoly.aroots
          (AlgebraicClosure ℚ_[ℓ]) := by
    unfold wcPencilLoc
    rw [dif_pos hne]

  have hq : ∀ q : ℕ, ∃ (r : ℕ) (e : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left hne.some.N.V)
      (wcRq D.f ℓ q) 0 ≃+ (Fin r → ℚ_[ℓ])),
      (∀ (c : ℚ_[ℓ])
          (y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left hne.some.N.V) (wcRq D.f ℓ q) 0),
        e ((Abelian.Ext.mk₀ (wcRqScalar D.f ℓ q c)).postcomp
          (wcFreeSheaf (wcP1Over F'').left hne.some.N.V) (add_zero 0) y) = c • e y) ∧
      ∀ j : ℕ, 1 ≤ j → algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])
        ((wcAddEquivMatrix e ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left
          hne.some.N.φ)).precomp (wcRq D.f ℓ q) (zero_add 0)) ^ j).trace) =
        ((Γ' q).map (· ^ (d * j))).sum +
          (if q = n - 1 then ((wcPencilLoc D ℓ hP x d).map (· ^ j)).sum else 0) := by
    intro q
    by_cases h : q = n - 1
    · subst h
      obtain ⟨r, e, he, htr⟩ := hGm d hd x hx hxS hne.some
      refine ⟨r, e, he, fun j hj => ?_⟩
      rw [htr j hj, hΓ'n, if_pos rfl, hloc, add_comm]
    · obtain ⟨⟨r, e, he⟩, htr⟩ := hΓ q h d hd x hx hxS hne.some.N
      refine ⟨r, e, he, fun j hj => ?_⟩
      rw [htr r e he j hj, hΓ'o q h, if_neg h, add_zero]
  choose r e he htr using hq
  obtain ⟨c, hc⟩ := wc_pencil_fibre_stalk_trace_integral F' F'' Y n hn2 D ℓ hℓ d hd x hx hxS
    hne.some.N r e he j hj
  have h1 := congrArg (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])) hc
  rw [map_sum, map_intCast] at h1
  have h2 : ∑ q ∈ Finset.Iic (2 * (n - 1)), algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])
      ((-1 : ℚ_[ℓ]) ^ q * ((wcAddEquivMatrix (e q) ((Abelian.Ext.mk₀ (wcFreeSheafMap
        (wcP1Over F'').left hne.some.N.φ)).precomp (wcRq D.f ℓ q) (zero_add 0))) ^ j).trace) =
      ∑ q ∈ Finset.Iic (2 * (n - 1)), ((-1 : AlgebraicClosure ℚ_[ℓ]) ^ q *
        ((Γ' q).map (· ^ (d * j))).sum +
        (if q = n - 1 then (-1 : AlgebraicClosure ℚ_[ℓ]) ^ q *
          ((wcPencilLoc D ℓ hP x d).map (· ^ j)).sum else 0)) := by
    apply Finset.sum_congr rfl
    intro q _
    rw [map_mul, map_pow, map_neg, map_one, htr q j hj, mul_add, mul_ite, mul_zero]
  rw [h2, Finset.sum_add_distrib, Finset.sum_ite_eq',
    if_pos (Finset.mem_Iic.mpr (by omega)), hodd.neg_one_pow,
    ← Finset.sum_filter_add_sum_filter_not (Finset.Iic (2 * (n - 1))) (fun q => Odd q)] at h1
  have hA : ∑ q ∈ (Finset.Iic (2 * (n - 1))).filter (fun q => Odd q),
      (-1 : AlgebraicClosure ℚ_[ℓ]) ^ q * ((Γ' q).map (· ^ (d * j))).sum =
      -∑ q ∈ (Finset.Iic (2 * (n - 1))).filter (fun q => Odd q), ((Γ' q).map (· ^ (d * j))).sum := by
    rw [← Finset.sum_neg_distrib]
    apply Finset.sum_congr rfl
    intro q hq
    rw [(Finset.mem_filter.mp hq).2.neg_one_pow, neg_one_mul]
  have hB : ∑ q ∈ (Finset.Iic (2 * (n - 1))).filter (fun q => ¬ Odd q),
      (-1 : AlgebraicClosure ℚ_[ℓ]) ^ q * ((Γ' q).map (· ^ (d * j))).sum =
      ∑ q ∈ (Finset.Iic (2 * (n - 1))).filter (fun q => ¬ Odd q), ((Γ' q).map (· ^ (d * j))).sum := by
    apply Finset.sum_congr rfl
    intro q hq
    rw [(Nat.not_odd_iff_even.mp (Finset.mem_filter.mp hq).2).neg_one_pow, one_mul]
  rw [hA, hB] at h1
  refine ⟨-(c : ℚ), ?_⟩
  rw [hps, hps, map_neg, map_intCast]
  linear_combination -h1

theorem wc_pencil_E_hom_const_zero_nm (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n) (hNM : wcPencilNoMixed D)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hNI : ∃ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β ∧
      β ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n)) :
    ∀ φ : (Subobject.underlying.obj (wcPencilE D ℓ hP)).over (wcGeomPoint F'' (wcP1Over F'') hP) ⟶
        (wcContSheaf (wcP1Over F'').left ℚ_[ℓ]).over (wcGeomPoint F'' (wcP1Over F'') hP),
      φ = 0 :=
by
  exact hNM ℓ hℓ hP hNI

theorem wc_fet_galois_limit_frobenius : ∀ (U : Scheme.{u}), ConnectedSpace U → CompactSpace U →
    QuasiSeparatedSpace U → ∀ (σ σ' : U ⟶ U), σ ≫ σ' = 𝟙 U → σ' ≫ σ = 𝟙 U →
    ∀ (E : ℕ → Scheme.{u}) (πE : ∀ j, E j ⟶ U), (∀ j, IsFinite (πE j)) → (∀ j, Etale (πE j)) →
    (∀ j, Surjective (πE j)) →
    ∃ (W₀ : Scheme.{u}) (p : W₀ ⟶ U), WeaklyEtale p ∧ QuasiCompact p ∧ Surjective p ∧
      ConnectedSpace W₀ ∧ CompactSpace W₀ ∧ QuasiSeparatedSpace W₀ ∧
      (∀ j, ∃ t : W₀ ⟶ E j, t ≫ πE j = p) ∧
      (∀ (V : Scheme.{u}) (a b : V ⟶ W₀), ConnectedSpace V → a ≫ p = b ≫ p →
        ∃ γ : W₀ ⟶ W₀, γ ≫ p = p ∧ b = a ≫ γ) ∧
      ∃ (φ₀ φ₀' : W₀ ⟶ W₀), φ₀ ≫ p = p ≫ σ ∧ φ₀ ≫ φ₀' = 𝟙 W₀ ∧ φ₀' ≫ φ₀ = 𝟙 W₀ :=
by
  intro U hconn hcpt hqs σ σ' hσσ' hσ'σ E πE hfin het hsurj

  have L1 : ∀ (U E T : Scheme.{u}) (e : E ⟶ U), Etale e → IsSeparated e →
      ∀ (f f' : T ⟶ E) (h : f ≫ e = f' ≫ e), ConnectedSpace T →
      (∃ x : T, (Limits.pullback.lift f f' h) x ∈ Set.range (Limits.pullback.diagonal e)) →
      f = f' := by
    intro U E T e he hs f f' h hT hx
    obtain ⟨x, hx⟩ := hx
    haveI := he
    haveI := hs
    haveI : IsClosedImmersion (Limits.pullback.diagonal e) := IsSeparated.isClosedImmersion_diagonal
    have hopen : IsOpen (Set.range (Limits.pullback.diagonal e)) :=
      IsOpenImmersion.isOpen_range _
    have hclosed : IsClosed (Set.range (Limits.pullback.diagonal e)) :=
      (Limits.pullback.diagonal e).isClosedEmbedding.isClosed_range
    have hclo : IsClopen ((Limits.pullback.lift f f' h) ⁻¹' Set.range (Limits.pullback.diagonal e)) :=
      ⟨hclosed.preimage (Limits.pullback.lift f f' h).continuous,
        hopen.preimage (Limits.pullback.lift f f' h).continuous⟩
    have huniv := hclo.eq_univ ⟨x, hx⟩
    have hsub : Set.range (Limits.pullback.lift f f' h) ⊆ Set.range (Limits.pullback.diagonal e) := by
      rintro _ ⟨y, rfl⟩
      have hy : y ∈ (Limits.pullback.lift f f' h) ⁻¹' Set.range (Limits.pullback.diagonal e) := by
        rw [huniv]; trivial
      exact hy
    have hl := IsOpenImmersion.lift_fac (Limits.pullback.diagonal e) (Limits.pullback.lift f f' h) hsub
    have e1 : f = IsOpenImmersion.lift (Limits.pullback.diagonal e) (Limits.pullback.lift f f' h) hsub := by
      have h1 := congrArg (· ≫ Limits.pullback.fst e e) hl
      simp only [Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id,
        Limits.pullback.lift_fst] at h1
      exact h1.symm
    have e2 : f' = IsOpenImmersion.lift (Limits.pullback.diagonal e) (Limits.pullback.lift f f' h) hsub := by
      have h1 := congrArg (· ≫ Limits.pullback.snd e e) hl
      simp only [Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id,
        Limits.pullback.lift_snd] at h1
      exact h1.symm
    exact e1.trans e2.symm

  have L3 : ∀ {B Z : Scheme.{u}} (p : Z ⟶ B) [Etale p] (N : ℕ),
      Etale (Limits.WidePullback.base (fun _ : Fin N => p)) := by
    intro B Z p _ N
    induction N with
    | zero =>
      have hiso : IsIso (Limits.WidePullback.base (fun _ : Fin 0 => p)) := by
        refine ⟨⟨Limits.WidePullback.lift (𝟙 B) (fun j => j.elim0) (fun j => j.elim0), ?_, ?_⟩⟩
        · apply Limits.WidePullback.hom_ext (fun _ : Fin 0 => p)
          · intro j
            exact j.elim0
          · rw [Category.assoc, Limits.WidePullback.lift_base, Category.comp_id, Category.id_comp]
        · exact Limits.WidePullback.lift_base _ _ _ _
      infer_instance
    | succ N ih =>
      obtain ⟨g, hgπ, hgb⟩ : ∃ g : Limits.widePullback B (fun _ : Fin (N + 1) => Z) (fun _ => p) ⟶
          Limits.widePullback B (fun _ : Fin N => Z) (fun _ => p),
          (∀ i : Fin N, g ≫ Limits.WidePullback.π (fun _ : Fin N => p) i =
            Limits.WidePullback.π (fun _ : Fin (N + 1) => p) i.castSucc) ∧
          g ≫ Limits.WidePullback.base (fun _ : Fin N => p) =
            Limits.WidePullback.base (fun _ : Fin (N + 1) => p) :=
        ⟨Limits.WidePullback.lift (Limits.WidePullback.base (fun _ : Fin (N + 1) => p))
          (fun i : Fin N => Limits.WidePullback.π (fun _ : Fin (N + 1) => p) i.castSucc)
          (fun i => Limits.WidePullback.π_arrow (fun _ : Fin (N + 1) => p) i.castSucc),
          fun i => Limits.WidePullback.lift_π _ _ _ _ _, Limits.WidePullback.lift_base _ _ _ _⟩
      have comm : g ≫ Limits.WidePullback.base (fun _ : Fin N => p) =
          Limits.WidePullback.π (fun _ : Fin (N + 1) => p) (Fin.last N) ≫ p := by
        rw [hgb, Limits.WidePullback.π_arrow]
      have hw : ∀ (s : Limits.PullbackCone (Limits.WidePullback.base (fun _ : Fin N => p)) p)
          (j : Fin (N + 1)),
          Fin.lastCases (motive := fun _ => s.pt ⟶ Z) s.snd
            (fun i => s.fst ≫ Limits.WidePullback.π (fun _ : Fin N => p) i) j ≫ p = s.snd ≫ p := by
        intro s j
        refine Fin.lastCases ?_ (fun i => ?_) j
        · rw [Fin.lastCases_last]
        · rw [Fin.lastCases_castSucc, Category.assoc, Limits.WidePullback.π_arrow, s.condition]
      have hpb : IsPullback g (Limits.WidePullback.π (fun _ : Fin (N + 1) => p) (Fin.last N))
          (Limits.WidePullback.base (fun _ : Fin N => p)) p := by
        refine IsPullback.of_isLimit' ⟨comm⟩ ?_
        refine Limits.PullbackCone.IsLimit.mk comm
          (fun s => Limits.WidePullback.lift (s.snd ≫ p)
            (Fin.lastCases (motive := fun _ => s.pt ⟶ Z) s.snd
              (fun i => s.fst ≫ Limits.WidePullback.π (fun _ : Fin N => p) i)) (hw s)) ?_ ?_ ?_
        · intro s
          apply Limits.WidePullback.hom_ext (fun _ : Fin N => p)
          · intro i
            rw [Category.assoc, hgπ, Limits.WidePullback.lift_π, Fin.lastCases_castSucc]
          · rw [Category.assoc, hgb, Limits.WidePullback.lift_base, s.condition]
        · intro s
          rw [Limits.WidePullback.lift_π, Fin.lastCases_last]
        · intro s m h1 h2
          apply Limits.WidePullback.hom_ext (fun _ : Fin (N + 1) => p)
          · intro j
            refine Fin.lastCases ?_ (fun i => ?_) j
            · rw [Limits.WidePullback.lift_π, Fin.lastCases_last, h2]
            · rw [Limits.WidePullback.lift_π, Fin.lastCases_castSucc, ← hgπ, ← Category.assoc, h1]
          · rw [Limits.WidePullback.lift_base,
              ← Limits.WidePullback.π_arrow (fun _ : Fin (N + 1) => p) (Fin.last N),
              ← Category.assoc, h2]
