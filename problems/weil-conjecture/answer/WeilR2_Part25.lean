theorem wc_pencil_Rq_sp_torsion_surj_offmid (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (q : ℕ) (hq : q ≠ n - 1) (i : Fin D.m)
    (V : (wcP1Over F'').left.ProEt) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (L : Type u) [Field L] [IsSepClosed L] (Vt : (wcP1Over F'').left.ProEt)
    (eL : Vt.left ≅ Spec (.of L)) (u' : Vt ⟶ V)
    (hu : u'.left (eL.inv (IsLocalRing.closedPoint L)) ≠ e.inv (IsLocalRing.closedPoint A))
    (k : ℕ) (hk : 1 ≤ k) (Dk : wcZModPullData ((wcProEtPullback D.f).map u').left (ℓ ^ k))
    (hDk : wcZModPullCanonical Dk) :
    Function.Surjective (wcZModPull Dk q) :=
by
  classical

  have s6 : ∀ {X₁ Pb T₁ T₂ E₁ : Scheme.{u}} (ff : X₁ ⟶ Pb) [IsProper ff] (uu : T₁ ⟶ Pb)
      (aa : T₂ ⟶ Pb) (γh : T₂ ⟶ T₁) (γi : T₁ ⟶ T₂), γi ≫ γh = 𝟙 T₁ → γh ≫ uu = aa →
      ∀ (ee : E₁ ⟶ Pb) (αα : E₁ ⟶ T₁), αα ≫ uu = ee →
      ∀ (L₁ Ω₁ : Type u) [Field L₁] [IsSepClosed L₁] [Field Ω₁] [IsSepClosed Ω₁] (ι : L₁ →+* Ω₁)
        (eL₁ : E₁ ≅ Spec (.of L₁)) (ξ : Spec (.of Ω₁) ⟶ T₂),
        Spec.map (CommRingCat.ofHom ι) ≫ eL₁.inv ≫ αα ≫ γi = ξ →
      ∀ (m j : ℕ), (m : L₁) ≠ 0 →
        (∀ D' : wcEtPullData (Limits.pullback.fst (Limits.pullback.snd ff aa) ξ) m,
          Function.Surjective (wcEtPull D' j)) →
      ∀ (qq : Limits.pullback ee ff ⟶ Limits.pullback uu ff),
        qq ≫ Limits.pullback.fst uu ff = Limits.pullback.fst ee ff ≫ αα →
        qq ≫ Limits.pullback.snd uu ff = Limits.pullback.snd ee ff →
      ∀ Dq : wcEtPullData qq m, Function.Surjective (wcEtPull Dq j) := by
    intro X₁ Pb T₁ T₂ E₁ ff _ uu aa γh γi hγ1 hγ ee αα hα L₁ Ω₁ _ _ _ _ ι eL₁ ξ hξ m j hm
      hsurj qq hq1 hq2 Dq
    obtain ⟨ττ, hττ⟩ : ∃ t : Spec (.of Ω₁) ⟶ E₁, t = Spec.map (CommRingCat.ofHom ι) ≫ eL₁.inv :=
      ⟨_, rfl⟩
    have hξ' : ττ ≫ αα ≫ γi = ξ := by rw [hττ, Category.assoc]; exact hξ
    have hγi : γi ≫ aa = uu := by rw [← hγ, ← Category.assoc, hγ1, Category.id_comp]
    have hξa : ξ ≫ aa = ττ ≫ ee := by
      rw [← hξ', Category.assoc, Category.assoc, hγi, hα]
    obtain ⟨κ, hκ1, hκ2⟩ : ∃ κ : Limits.pullback uu ff ⟶ Limits.pullback ff aa,
        κ ≫ Limits.pullback.fst ff aa = Limits.pullback.snd uu ff ∧
        κ ≫ Limits.pullback.snd ff aa = Limits.pullback.fst uu ff ≫ γi :=
      ⟨Limits.pullback.lift (Limits.pullback.snd uu ff) (Limits.pullback.fst uu ff ≫ γi)
