    (hU : ∃ U : X.left.Opens, (U : Set ↥X.left) = (Set.range ι)ᶜ ∧ IsAffineOpen U)
    (ιb : wcXbar F Z ⟶ wcXbar F X)
    (hιb₁ : ιb ≫ Limits.pullback.fst X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
      Limits.pullback.fst Z.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫ ι)
    (hιb₂ : ιb ≫ Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
      Limits.pullback.snd Z.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
    (D : wcHMPullData ιb ℓ) (hD : wcHMPullCanonical D) (k : ℕ) (hk : k < N) :
    Function.Injective (wcHMPull D k) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcXbar F X) ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcXbar F Z) ℓ)) := HasExt.standard _
  haveI := D.additive
  haveI := D.presLim
  haveI := D.presColim
  haveI := D.cont

  have Q : IsPullback ιb
      (Limits.pullback.fst Z.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
      (Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
      ι := by
    refine IsPullback.of_right ?_ hιb₁
      (IsPullback.of_hasPullback X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))).flip
    rw [hιb₂, hιZ]
    exact (IsPullback.of_hasPullback Z.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))).flip
  have hιbC : IsClosedImmersion ιb :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) Q.flip hι
  have hsep : IsSeparated (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) :=
    MorphismProperty.of_isPullback (P := @IsSeparated)
      (IsPullback.of_hasPullback X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
      (inferInstance : IsSeparated X.hom)
  have hQS : QuasiSeparatedSpace ↥(wcXbar F X) :=
    quasiSeparatedSpace_of_quasiSeparated (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
  have hfstA : IsAffineHom (Limits.pullback.fst X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom)
      (IsPullback.of_hasPullback X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))).flip
      (inferInstance : IsAffineHom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
  have hrange : Set.range ιb = (Limits.pullback.fst X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) ⁻¹' Set.range ι := by
    rw [← Scheme.Pullback.range_snd]
    have key : Q.flip.isoPullback.inv ≫ ιb = Limits.pullback.snd ι (Limits.pullback.fst X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) := by
      rw [Iso.inv_comp_eq]
      exact Q.flip.isoPullback_hom_snd.symm
    ext z
    constructor
    · rintro ⟨w, rfl⟩
      exact ⟨Q.flip.isoPullback.hom w, by
        rw [← Scheme.Hom.comp_apply, Q.flip.isoPullback_hom_snd]⟩
    · rintro ⟨w, rfl⟩
      exact ⟨Q.flip.isoPullback.inv w, by rw [← Scheme.Hom.comp_apply, key]⟩
  have hŪ : ∃ U : (wcXbar F X).Opens, (U : Set ↥(wcXbar F X)) = (Set.range ιb)ᶜ ∧
      IsAffineOpen U := by
    obtain ⟨U, hUset, hUaff⟩ := hU
    refine ⟨Limits.pullback.fst X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ⁻¹ᵁ U, ?_,
      hUaff.preimage _⟩
    rw [hrange, ← Set.preimage_compl, ← hUset]
    rfl
  haveI := hιbC
  haveI := hQS

  obtain ⟨hL, hC⟩ := wc_proet_closed_push_exact ιb hŪ D.cont
  haveI := hL
  haveI := hC
  haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.ProEt.topology (wcXbar F X))
    (wcRingSheaf (wcXbar F X) ℓ)
  haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.ProEt.topology (wcXbar F Z))
    (wcRingSheaf (wcXbar F Z) ℓ)
  obtain ⟨hPA, hPL, hPC⟩ := sheafOfModules_pushforward_exact (wcProEtBC ιb)
    (wcRingSheaf (wcXbar F X) ℓ) (wcRingSheaf (wcXbar F Z) ℓ) D.φ
  haveI := hPA
  haveI := hPL
  haveI := hPC

  rw [injective_iff_map_eq_zero]
  intro x hx
  have hx' : (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ x).comp
      (Abelian.Ext.mk₀ D.μ.hom) (add_zero k)) (zero_add k) = 0 := hx

  have hz : Abelian.Ext.mapExactFunctor D.Φ x = 0 := by
    have e1 : Abelian.Ext.mapExactFunctor D.Φ x =
        ((Abelian.Ext.mk₀ D.μ.hom).comp ((Abelian.Ext.mk₀ D.μ.inv).comp
          ((Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero k))
          (zero_add k)) (zero_add k)).comp (Abelian.Ext.mk₀ D.μ.inv) (add_zero k) := by
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp,
        Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
        Abelian.Ext.comp_mk₀_id]
    rw [e1, hx', Abelian.Ext.comp_zero, Abelian.Ext.zero_comp]

  have hunit : x.comp (Abelian.Ext.mk₀
      (D.adj.unit.app (SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ)))) (add_zero k) = 0 := by
    have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp x D.adj.unit
    rw [Abelian.Ext.id_mapExactFunctor, Abelian.Ext.comp_mapExactFunctor, hz,
      Abelian.Ext.mapExactFunctor_zero, Abelian.Ext.comp_zero] at h
    exact h

  have hfac : @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC ιb) _ _ D.cont D.φ =
      D.adj.unit.app (SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ)) ≫
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC ιb) _ _ D.cont D.φ).map
          ((D.adj.homEquiv _ _).symm
            (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC ιb) _ _ D.cont D.φ)) := by
    have e := D.adj.homEquiv_unit _ _ ((D.adj.homEquiv _ _).symm
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC ιb) _ _ D.cont D.φ))
    rw [Equiv.apply_symm_apply] at e
    exact e
  have h0 : x.comp (Abelian.Ext.mk₀
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC ιb) _ _ D.cont D.φ))
      (add_zero k) = 0 := by
    rw [hfac, ← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.comp_assoc_of_third_deg_zero, hunit,
      Abelian.Ext.zero_comp]

  haveI hepi : Epi (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC ιb) _ _
      D.cont D.φ) := wc_proet_closed_unit_restriction_epi ιb hŪ ℓ D hD
  have hS : (ShortComplex.mk
      (Limits.kernel.ι (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC ιb) _ _
        D.cont D.φ))
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC ιb) _ _ D.cont D.φ)
      (Limits.kernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel _) inferInstance hepi
  obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hS x h0

  rw [← hy, wc_hm_smooth_divisor_complement_vanishing F X N ℓ hℓ Z ι hι hιZ hZs hU ιb hιb₁ hιb₂ D hD k hk y,
    Abelian.Ext.zero_comp]

theorem wc_pencil_weak_lefschetz (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn4 : 4 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hX : WeaklyEtale (Limits.pullback.fst (Over.mk (Limits.pullback.snd D.f D.u0)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (γ : AlgebraicClosure ℚ_[ℓ])
    (hγ : wcIsEigen ℓ (wcCohScalar F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2))
      (wcCohFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2)) γ) :
    ∀ (hZ : WeaklyEtale (Limits.pullback.fst D.Z.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))),
      ∃ (rZ : ℕ) (eZ : wcCoh F'' D.Z hZ ℓ (n - 2) ≃+ (Fin rZ → ℚ_[ℓ])),
        (∀ (c : ℚ_[ℓ]) (x : wcCoh F'' D.Z hZ ℓ (n - 2)),
          eZ (wcCohScalar F'' D.Z hZ ℓ (n - 2) c x) = c • eZ x) ∧
        γ ∈ (wcAddEquivMatrix eZ (wcCohFrob F'' D.Z hZ ℓ (n - 2))).charpoly.aroots
            (AlgebraicClosure ℚ_[ℓ]) :=
by
  classical
  intro hZ
  obtain ⟨r, e, he, hroot⟩ := hγ
  haveI : GeometricallyIrreducible D.Z.hom := D.Zgi hn4
  haveI : IsProper D.Z.hom := D.Zproper
  haveI : SmoothOfRelativeDimension (n - 2) D.Z.hom := D.Zsmooth
  obtain ⟨-, hXp, hXs⟩ := wc_pencil_fibre_props F' F'' Y n (by omega) D
  haveI : IsProper (Over.mk (Limits.pullback.snd D.f D.u0)).hom := hXp
  haveI : SmoothOfRelativeDimension (n - 1) (Over.mk (Limits.pullback.snd D.f D.u0)).hom := hXs
  obtain ⟨rZ, eZ, heZ⟩ := wc_coh_finite F'' D.Z (n - 2) ℓ hℓ hZ (n - 2)

  have s6 : ∀ (F₀ : Type u) [Field F₀] [Finite F₀] (X₀ : Over (Spec (.of F₀)))
      (h₀ : WeaklyEtale (Limits.pullback.fst X₀.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F₀ (AlgebraicClosure F₀))))))
      (i : ℕ) (c : ℚ_[ℓ]) (x : wcCoh F₀ X₀ h₀ ℓ i),
      wcCohFrob F₀ X₀ h₀ ℓ i (wcCohScalar F₀ X₀ h₀ ℓ i c x) =
        wcCohScalar F₀ X₀ h₀ ℓ i c (wcCohFrob F₀ X₀ h₀ ℓ i x) := by
    intro F₀ _ _ X₀ h₀ i c x
    show (Abelian.Ext.mk₀ (wcFreeSheafMap X₀.left (wcGeomFrob F₀ X₀ h₀))).comp
        (x.comp (Abelian.Ext.mk₀ (wcLadicScalar X₀.left ℓ c)) (add_zero i)) (zero_add i) =
      ((Abelian.Ext.mk₀ (wcFreeSheafMap X₀.left (wcGeomFrob F₀ X₀ h₀))).comp x (zero_add i)).comp
        (Abelian.Ext.mk₀ (wcLadicScalar X₀.left ℓ c)) (add_zero i)
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add i) (add_zero i) (by omega)).symm

  have s4 : ∀ {r r' : ℕ} (m : ℕ) (A : Matrix (Fin r) (Fin r) ℚ_[ℓ])
      (B : Matrix (Fin r') (Fin r') ℚ_[ℓ]) (P : Matrix (Fin r') (Fin r) ℚ_[ℓ]),
      (∀ v : Fin r → ℚ_[ℓ], P.mulVec v = 0 → v = 0) → P * A ^ m = B * P →
      ∀ μ ∈ A.charpoly.aroots (AlgebraicClosure ℚ_[ℓ]),
        μ ^ m ∈ B.charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) := by
    intro r r' m A B P hP hPA μ hμ
    set f : ℚ_[ℓ] →+* AlgebraicClosure ℚ_[ℓ] := algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) with hf
    have hker : LinearMap.ker (Matrix.toLin' P) = ⊥ := by
      rw [LinearMap.ker_eq_bot']
      intro v hv
      exact hP v (by rwa [Matrix.toLin'_apply] at hv)
    obtain ⟨g, hg⟩ := LinearMap.exists_leftInverse_of_injective _ hker
    have hQP : LinearMap.toMatrix' g * P = 1 := by
      have := congrArg LinearMap.toMatrix' hg
      rwa [LinearMap.toMatrix'_comp, LinearMap.toMatrix'_toLin', LinearMap.toMatrix'_id] at this
    have hQPL : (LinearMap.toMatrix' g).map f * P.map f = 1 := by
      rw [← Matrix.map_mul, hQP, Matrix.map_one _ (map_zero f) (map_one f)]
    have hPAL : P.map f * A.map f ^ m = B.map f * P.map f := by
      rw [← Matrix.map_pow, ← Matrix.map_mul, ← Matrix.map_mul, hPA]
    rw [Polynomial.mem_aroots] at hμ
    obtain ⟨_, hμ⟩ := hμ
    have hdet : (Matrix.scalar (Fin r) μ - A.map f).det = 0 := by
      rw [← Matrix.eval_charpoly, Matrix.charpoly_map, Polynomial.eval_map, ← Polynomial.aeval_def]
      exact hμ
    obtain ⟨v, hv0, hv⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
    have hAv : (A.map f).mulVec v = μ • v := by
      rw [Matrix.sub_mulVec, sub_eq_zero] at hv
      rw [← hv, Matrix.scalar_apply]
      ext x
      simp [Matrix.mulVec_diagonal]
    have hAkv : ∀ k : ℕ, (A.map f ^ k).mulVec v = μ ^ k • v := by
      intro k
      induction k with
      | zero => simp
      | succ k ih =>
        rw [pow_succ (A.map f), ← Matrix.mulVec_mulVec, hAv, Matrix.mulVec_smul, ih, smul_smul,
          ← pow_succ']
    have hw0 : (P.map f).mulVec v ≠ 0 := by
      intro hw
      apply hv0
      have e1 : ((LinearMap.toMatrix' g).map f).mulVec ((P.map f).mulVec v) = v := by
        rw [Matrix.mulVec_mulVec, hQPL, Matrix.one_mulVec]
      rw [← e1, hw, Matrix.mulVec_zero]
    have hBw : (B.map f).mulVec ((P.map f).mulVec v) = μ ^ m • (P.map f).mulVec v := by
      rw [Matrix.mulVec_mulVec, ← hPAL, ← Matrix.mulVec_mulVec, hAkv, Matrix.mulVec_smul]
    have hdet' : (Matrix.scalar (Fin r') (μ ^ m) - B.map f).det = 0 := by
      apply Matrix.exists_mulVec_eq_zero_iff.mp
      refine ⟨(P.map f).mulVec v, hw0, ?_⟩
      rw [Matrix.sub_mulVec, hBw, Matrix.scalar_apply, sub_eq_zero]
      ext x
      simp [Matrix.mulVec_diagonal]
    rw [Polynomial.mem_aroots]
    refine ⟨(Matrix.charpoly_monic B).ne_zero, ?_⟩
    rw [Polynomial.aeval_def, ← Polynomial.eval_map, ← Matrix.charpoly_map, Matrix.eval_charpoly]
    exact hdet'

  have s5 : ∀ {V V' : Type (u+1)} [AddCommGroup V] [AddCommGroup V'] {r r' : ℕ}
      (e : V ≃+ (Fin r → ℚ_[ℓ])) (e' : V' ≃+ (Fin r' → ℚ_[ℓ]))
      (s : ℚ_[ℓ] → V →+ V) (s' : ℚ_[ℓ] → V' →+ V')
      (he : ∀ (c : ℚ_[ℓ]) (x : V), e (s c x) = c • e x)
      (he' : ∀ (c : ℚ_[ℓ]) (x : V'), e' (s' c x) = c • e' x)
      (Φ : V →+ V) (Φ' : V' →+ V')
      (hΦ : ∀ (c : ℚ_[ℓ]) (x : V), Φ (s c x) = s c (Φ x))
      (hΦ' : ∀ (c : ℚ_[ℓ]) (x : V'), Φ' (s' c x) = s' c (Φ' x))
      (ψ : V →+ V') (hψ : Function.Injective ψ)
      (hψs : ∀ (c : ℚ_[ℓ]) (x : V), ψ (s c x) = s' c (ψ x))
      (m : ℕ) (hψΦ : ∀ x : V, ψ ((⇑Φ)^[m] x) = Φ' (ψ x)),
      ∃ P : Matrix (Fin r') (Fin r) ℚ_[ℓ], (∀ v : Fin r → ℚ_[ℓ], P.mulVec v = 0 → v = 0) ∧
        P * (wcAddEquivMatrix e Φ) ^ m = wcAddEquivMatrix e' Φ' * P := by
    intro V V' _ _ r r' e e' s s' he he' Φ Φ' hΦ hΦ' ψ hψ hψs m hψΦ
    have hes : ∀ (c : ℚ_[ℓ]) (v : Fin r → ℚ_[ℓ]), e.symm (c • v) = s c (e.symm v) := fun c v =>
      e.injective (by rw [he, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
    have hes' : ∀ (c : ℚ_[ℓ]) (v : Fin r' → ℚ_[ℓ]), e'.symm (c • v) = s' c (e'.symm v) :=
      fun c v => e'.injective (by rw [he', AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
    let LA : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]) :=
      { toFun := fun v => e (Φ (e.symm v))
        map_add' := fun v w => by simp only [map_add]
        map_smul' := fun c v => by simp only [hes, hΦ, he, RingHom.id_apply] }
    let LB : (Fin r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r' → ℚ_[ℓ]) :=
      { toFun := fun v => e' (Φ' (e'.symm v))
        map_add' := fun v w => by simp only [map_add]
        map_smul' := fun c v => by simp only [hes', hΦ', he', RingHom.id_apply] }
    let LP : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r' → ℚ_[ℓ]) :=
      { toFun := fun v => e' (ψ (e.symm v))
        map_add' := fun v w => by simp only [map_add]
        map_smul' := fun c v => by simp only [hes, hψs, he', RingHom.id_apply] }
    have hA : wcAddEquivMatrix e Φ = LinearMap.toMatrix' LA := by
      ext a b
      rw [LinearMap.toMatrix'_apply]
      rfl
    have hB : wcAddEquivMatrix e' Φ' = LinearMap.toMatrix' LB := by
      ext a b
      rw [LinearMap.toMatrix'_apply]
      rfl
    have hAk : ∀ (k : ℕ) (v : Fin r → ℚ_[ℓ]),
        ((wcAddEquivMatrix e Φ) ^ k).mulVec v = e ((⇑Φ)^[k] (e.symm v)) := by
      intro k
      induction k with
      | zero => intro v; simp
      | succ k ih =>
        intro v
        rw [pow_succ', ← Matrix.mulVec_mulVec, ih, hA, LinearMap.toMatrix'_mulVec]
        show e (Φ (e.symm (e ((⇑Φ)^[k] (e.symm v))))) = _
        rw [AddEquiv.symm_apply_apply, Function.iterate_succ_apply']
    refine ⟨LinearMap.toMatrix' LP, ?_, ?_⟩
    · intro v hv
      rw [LinearMap.toMatrix'_mulVec] at hv
      change e' (ψ (e.symm v)) = 0 at hv
      have h1 : ψ (e.symm v) = 0 := e'.injective (hv.trans (map_zero e').symm)
      have h2 : e.symm v = 0 := hψ (h1.trans (map_zero ψ).symm)
      rw [← AddEquiv.apply_symm_apply e v, h2, map_zero]
    · apply Matrix.toLin'.injective
      apply LinearMap.ext
      intro v
      rw [Matrix.toLin'_apply, Matrix.toLin'_apply, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec,
        hAk, hB, LinearMap.toMatrix'_mulVec, LinearMap.toMatrix'_mulVec, LinearMap.toMatrix'_mulVec]
      show e' (ψ (e.symm (e ((⇑Φ)^[m] (e.symm v))))) = e' (Φ' (e'.symm (e' (ψ (e.symm v)))))
      rw [AddEquiv.symm_apply_apply, AddEquiv.symm_apply_apply, hψΦ]

  have hscal : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcHMPullData f ℓ)
      (hD : wcHMPullCanonical D) (n : ℕ) (c : ℚ_[ℓ]) (x : wcHM S ℓ n),
      wcHMPull D n (wcHMScalar S ℓ n c x) = wcHMScalar S' ℓ n c (wcHMPull D n x) := by
    intro S S' f D hD n c x
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    have hc := wc_hm_pull_const D hD c
    show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ
        (x.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero n))).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero n)) (zero_add n) =
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ x).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero n)) (zero_add n)).comp
        (Abelian.Ext.mk₀ (wcHMConst S' ℓ c)) (add_zero n)
    rw [← hc, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mapExactFunctor D.Φ x),
      Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mk₀ D.μ.inv),
      Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mapExactFunctor D.Φ x),
      Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id_assoc]

  obtain ⟨ιb, hιb₁, hιb₂⟩ : ∃ ιb : wcXbar F'' D.Z ⟶
        wcXbar F'' (Over.mk (Limits.pullback.snd D.f D.u0)),
      ιb ≫ Limits.pullback.fst (Over.mk (Limits.pullback.snd D.f D.u0)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
        Limits.pullback.fst D.Z.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ≫ D.ιZ ∧
      ιb ≫ Limits.pullback.snd (Over.mk (Limits.pullback.snd D.f D.u0)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
        Limits.pullback.snd D.Z.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) :=
    ⟨Limits.pullback.lift (Limits.pullback.fst D.Z.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ≫ D.ιZ)
      (Limits.pullback.snd D.Z.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))
      (by
        rw [Category.assoc]
        erw [D.hιZY]
        exact Limits.pullback.condition),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩

  have hgf₁ : ∀ (W : Over (Spec (.of F'')))
      (hW : WeaklyEtale (Limits.pullback.fst W.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))),
      wcGeomFrobX F'' W hW ≫ Limits.pullback.fst W.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
        Limits.pullback.fst W.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) := by
    intro W hW
    unfold wcGeomFrobX wcGeomFrob
    exact (Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _)
  have hgs : ∀ (W : Over (Spec (.of F'')))
      (hW : WeaklyEtale (Limits.pullback.fst W.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))),
      wcGeomFrobX F'' W hW ≫ Limits.pullback.snd W.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
        Limits.pullback.snd W.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ≫
          Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
            (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
              AlgebraicClosure F'' →+* AlgebraicClosure F'')) := by
    intro W hW
    unfold wcGeomFrobX wcGeomFrob
    exact Limits.pullback.lift_snd _ _ _
  have hcomm : wcGeomFrobX F'' D.Z hZ ≫ ιb =
      ιb ≫ wcGeomFrobX F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX := by
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc]
      rw [hgf₁ _ hX, hιb₁, ← Category.assoc, hgf₁ D.Z hZ]
    · simp only [Category.assoc]
      rw [hιb₂, hgs _ hX, ← Category.assoc, hιb₂, hgs D.Z hZ]

  obtain ⟨Dι, hDι⟩ := wc_hm_pull_data_exists ιb ℓ
  obtain ⟨DX, hDX⟩ := wc_hm_pull_data_exists
    (wcGeomFrobX F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX) ℓ
  obtain ⟨DZ, hDZ⟩ := wc_hm_pull_data_exists (wcGeomFrobX F'' D.Z hZ) ℓ
  obtain ⟨Dk, hDk⟩ := wc_hm_pull_data_exists
    (ιb ≫ wcGeomFrobX F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX) ℓ
  obtain ⟨TX, hTXs, hTXF⟩ := wc_hm_comparison F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ
  obtain ⟨TZ, hTZs, hTZF⟩ := wc_hm_comparison F'' D.Z hZ ℓ

  have hP : Function.Injective (wcHMPull Dι (n - 2)) :=
    wc_hm_weak_lefschetz_injective_of_smooth_divisor F'' (Over.mk (Limits.pullback.snd D.f D.u0)) (n - 1) ℓ hℓ
      D.Z D.ιZ D.hιZ D.hιZY
      (by rw [show n - 1 - 1 = n - 2 by omega]; exact D.Zsmooth)
      D.Zaff ιb hιb₁ hιb₂ Dι hDι (n - 2) (by omega)
  obtain ⟨ψ, hψinj, hψs, hψΦ⟩ : ∃ ψ : wcCoh F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2)
        →+ wcCoh F'' D.Z hZ ℓ (n - 2),
      Function.Injective ψ ∧
      (∀ (c : ℚ_[ℓ]) (x : wcCoh F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2)),
        ψ (wcCohScalar F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2) c x) =
          wcCohScalar F'' D.Z hZ ℓ (n - 2) c (ψ x)) ∧
      ∀ x : wcCoh F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2),
        ψ (wcCohFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2) x) =
          wcCohFrob F'' D.Z hZ ℓ (n - 2) (ψ x) := by
    refine ⟨(TZ (n - 2)).symm.toAddMonoidHom.comp
      ((wcHMPull Dι (n - 2)).comp (TX (n - 2)).toAddMonoidHom), ?_, ?_, ?_⟩
    · exact (TZ (n - 2)).symm.injective.comp (hP.comp (TX (n - 2)).injective)
    · intro c x
      have h1 : ∀ w : wcHM (wcXbar F'' D.Z) ℓ (n - 2),
          (TZ (n - 2)).symm (wcHMScalar (wcXbar F'' D.Z) ℓ (n - 2) c w) =
            wcCohScalar F'' D.Z hZ ℓ (n - 2) c ((TZ (n - 2)).symm w) := by
        intro w
        apply (TZ (n - 2)).injective
        rw [hTZs, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply]
      show (TZ (n - 2)).symm (wcHMPull Dι (n - 2) (TX (n - 2)
          (wcCohScalar F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2) c x))) =
        wcCohScalar F'' D.Z hZ ℓ (n - 2) c ((TZ (n - 2)).symm (wcHMPull Dι (n - 2) (TX (n - 2) x)))
      rw [hTXs, hscal Dι hDι, h1]
    · intro x
      have h2 : ∀ w : wcHM (wcXbar F'' D.Z) ℓ (n - 2),
          (TZ (n - 2)).symm (wcHMPull DZ (n - 2) w) =
            wcCohFrob F'' D.Z hZ ℓ (n - 2) ((TZ (n - 2)).symm w) := by
        intro w
        apply (TZ (n - 2)).injective
        rw [hTZF DZ hDZ, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply]
      show (TZ (n - 2)).symm (wcHMPull Dι (n - 2) (TX (n - 2)
          (wcCohFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2) x))) =
        wcCohFrob F'' D.Z hZ ℓ (n - 2) ((TZ (n - 2)).symm (wcHMPull Dι (n - 2) (TX (n - 2) x)))
      rw [hTXF DX hDX,
        ← wc_hm_pull_comp (wcGeomFrobX F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX) ιb _ rfl
          DX hDX Dι hDι Dk hDk,
        wc_hm_pull_comp ιb (wcGeomFrobX F'' D.Z hZ) _ hcomm Dι hDι DZ hDZ Dk hDk, h2]

  obtain ⟨P, hPinj, hPA⟩ := s5 e eZ
    (wcCohScalar F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2))
    (wcCohScalar F'' D.Z hZ ℓ (n - 2)) he heZ
    (wcCohFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2))
    (wcCohFrob F'' D.Z hZ ℓ (n - 2))
    (s6 F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX (n - 2)) (s6 F'' D.Z hZ (n - 2))
    ψ hψinj hψs 1 (fun x => by rw [Function.iterate_one]; exact hψΦ x)
  have hγZ := s4 1 _ _ P hPinj hPA γ hroot
  rw [pow_one] at hγZ
  exact ⟨rZ, eZ, heZ, hγZ⟩

theorem wc_pencil_edge_two (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (α : AlgebraicClosure ℚ_[ℓ])
    (hα : wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - 2)) 2 (wcRqScalar D.f ℓ (n - 2) c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - 2)) 2) α) :
    (4 ≤ n ∧ ∀ (hZ : WeaklyEtale (Limits.pullback.fst D.Z.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))),
        ∃ (rZ : ℕ) (eZ : wcCoh F'' D.Z hZ ℓ (n - 2) ≃+ (Fin rZ → ℚ_[ℓ])),
          (∀ (c : ℚ_[ℓ]) (x : wcCoh F'' D.Z hZ ℓ (n - 2)),
            eZ (wcCohScalar F'' D.Z hZ ℓ (n - 2) c x) = c • eZ x) ∧
          ∃ β ∈ (wcAddEquivMatrix eZ (wcCohFrob F'' D.Z hZ ℓ (n - 2))).charpoly.aroots
              (AlgebraicClosure ℚ_[ℓ]),
            α = algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) (Nat.card F'' : ℚ_[ℓ]) * β) ∨
    ∀ ι : AlgebraicClosure ℚ_[ℓ] ≃+* ℂ,
      ‖ι α‖ ^ 2 ≤ (Nat.card F'' : ℝ) * (Nat.card F'' : ℝ) ^ n :=
by
  classical
  have hX : WeaklyEtale (Limits.pullback.fst (Over.mk (Limits.pullback.snd D.f D.u0)).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F'')
  obtain ⟨γ, hγ, hαγ⟩ := wc_pencil_E2_two_fibre F' F'' Y n hn hn2 D ℓ hℓ hP hX α hα
  have hcase : n = 2 ∨ 4 ≤ n := by
    obtain ⟨k, hk⟩ := hn
    omega
  rcases hcase with h2 | h4
  · right
    subst h2
    haveI := wc_pencil_fibre_gi F' F'' Y 2 D
    obtain ⟨r, e, he, hroot⟩ := hγ
    have h0 : ∀ x : wcCoh F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (2 - 2),
        wcCohFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (2 - 2) x = x :=
      fun x => wc_coh_zero_frob_id F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ x
    have hA : wcAddEquivMatrix e
        (wcCohFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (2 - 2)) = 1 := by
      ext a b
      rw [wcAddEquivMatrix, Matrix.of_apply, h0, AddEquiv.apply_symm_apply, Pi.single_apply,
        Matrix.one_apply]
    rw [hA, Matrix.charpoly_one, Polynomial.mem_aroots] at hroot
    obtain ⟨_, hev⟩ := hroot
    rw [map_pow, map_sub, Polynomial.aeval_X, map_one] at hev
    have hγ1 : γ = 1 := by
      generalize Fintype.card (Fin r) = t at hev
      rcases Nat.eq_zero_or_pos t with ht | ht
      · rw [ht, pow_zero] at hev
        exact absurd hev one_ne_zero
      · exact sub_eq_zero.mp ((pow_eq_zero_iff ht.ne').mp hev)
    intro ι
    have hq1 : (1 : ℝ) ≤ (Nat.card F'' : ℝ) := by
      exact_mod_cast (Finite.one_lt_card (α := F'')).le
    have hια : ι α = (Nat.card F'' : ℂ) := by
      rw [hαγ, hγ1, mul_one, map_natCast, map_natCast]
    rw [hια, Complex.norm_natCast]
    exact le_mul_of_one_le_left (by positivity) hq1
  · left
    refine ⟨h4, fun hZ => ?_⟩
    obtain ⟨rZ, eZ, heZ, hroot⟩ := wc_pencil_weak_lefschetz F' F'' Y n h4 D ℓ hℓ hX γ hγ hZ
    exact ⟨rZ, eZ, heZ, γ, hroot, hαγ⟩

theorem wc_pencil_strict_nbhd_pbc (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hX : WeaklyEtale (Limits.pullback.fst (Over.mk (Limits.pullback.snd D.f D.u0)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (V₀ : (wcP1Over F'').left.ProEt) (φ₀ : V₀ ⟶ V₀)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom D.u0 ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.u0 (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom D.u0)
    (hεφ : ε.inv ≫ Limits.pullback.fst V₀.hom D.u0 ≫ φ₀.left =
      Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
        (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
          AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫
        ε.inv ≫ Limits.pullback.fst V₀.hom D.u0) :
    ∃ Ψ : Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀))
        (wcLadicSheaf D.Yt.left ℓ) n →+ wcCoh F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ n,
      Function.Injective Ψ ∧
      (∀ (c : ℚ_[ℓ]) (z : Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀))
          (wcLadicSheaf D.Yt.left ℓ) n),
        Ψ (z.comp (Abelian.Ext.mk₀ (wcLadicScalar D.Yt.left ℓ c)) (add_zero n)) =
          wcCohScalar F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ n c (Ψ z)) ∧
      ∀ z : Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀))
          (wcLadicSheaf D.Yt.left ℓ) n,
        Ψ ((Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left ((wcProEtPullback D.f).map φ₀))).comp z
            (zero_add n)) =
          wcCohFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ n (Ψ z) :=
by
  classical

  have F0 : ∀ {S : Scheme.{u}} {U V W : S.ProEt} (a : U ⟶ V) (b : V ⟶ W),
      wcFreeSheafMap S (a ≫ b) = wcFreeSheafMap S a ≫ wcFreeSheafMap S b := by
    intro S U V W a b
    simp only [wcFreeSheafMap, Functor.map_comp, Functor.whiskerRight_comp] <;> rfl
  have Fid : ∀ {S : Scheme.{u}} (U : S.ProEt), wcFreeSheafMap S (𝟙 U) = 𝟙 _ := by
    intro S U
    simp only [wcFreeSheafMap, CategoryTheory.Functor.map_id, Functor.whiskerRight_id'] <;> rfl

  obtain ⟨L, adj, hLlim, θ, hθ⟩ := wc_proet_push_left_adjoint_free_nat (Limits.pullback.fst D.f D.u0)
  haveI := hLlim
  haveI : L.IsLeftAdjoint := ⟨_, ⟨adj⟩⟩
  haveI : Limits.PreservesColimitsOfSize.{0, 0} L := adj.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits L :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits L
  haveI : L.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint L
  haveI : L.Additive := Functor.additive_of_preserves_binary_products L

  obtain ⟨β, hβ⟩ := wc_pencil_closed_fibre_geom_iso F' F'' Y n D hX V₀ φ₀ ε hε hεφ

  obtain ⟨hW1, hW2, hW3, hW4⟩ := wc_pencil_nbhd_qcqs F' F'' Y n D V₀ A e

  obtain ⟨R, hR⟩ : ∃ R : Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀))
        (wcLadicSheaf D.Yt.left ℓ) n →+
      Abelian.Ext (wcFreeSheaf (Limits.pullback D.f D.u0)
        ((wcProEtPullback (Limits.pullback.fst D.f D.u0)).obj ((wcProEtPullback D.f).obj V₀)))
        (wcLadicSheaf (Limits.pullback D.f D.u0) ℓ) n,
      R = wcProEtRes (Limits.pullback.fst D.f D.u0) L adj θ ℚ_[ℓ]
      ((wcProEtPullback D.f).obj V₀) n := ⟨_, rfl⟩
  have hRinj : Function.Injective R := by
    rw [hR]
    exact wc_res_ladic_injective_of_torsion (Limits.pullback.fst D.f D.u0) L adj θ ℓ
      ((wcProEtPullback D.f).obj V₀)
      (fun j k => wc_pencil_nbhd_zmod_finite F' F'' Y n hn2 D ℓ hℓ hX V₀ A e ε hv hε j k)
      (fun j k => wc_pencil_nbhd_torsion_restriction_injective F' F'' Y n D ℓ hℓ V₀ A e ε hv hε
        L adj θ j k) n
  obtain ⟨π, hπ⟩ : ∃ π : L.obj (wcLadicSheaf D.Yt.left ℓ) ⟶
      wcLadicSheaf (Limits.pullback D.f D.u0) ℓ, π = (adj.homEquiv (wcContSheaf D.Yt.left ℚ_[ℓ])
      (wcContSheaf (Limits.pullback D.f D.u0) ℚ_[ℓ])).symm
        (wcContPull (Limits.pullback.fst D.f D.u0) ℚ_[ℓ]) := ⟨_, rfl⟩
  have hRz : ∀ z, R z = (Abelian.Ext.mk₀ (θ ((wcProEtPullback D.f).obj V₀)).inv).comp
      ((Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ π) (add_zero n)) (zero_add n) := by
    intro z
    rw [hR, hπ]
    rfl
  refine ⟨((Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f D.u0) β.inv)).precomp
      (wcLadicSheaf (Limits.pullback D.f D.u0) ℓ) (zero_add n)).comp R, ?_, ?_, ?_⟩
  ·
    rw [injective_iff_map_eq_zero]
    intro z hz
    change (Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f D.u0) β.inv)).comp (R z)
      (zero_add n) = 0 at hz
    apply (injective_iff_map_eq_zero R).mp hRinj z
    have h1 : (Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f D.u0) β.hom)).comp
        ((Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f D.u0) β.inv)).comp (R z)
          (zero_add n)) (zero_add n) = R z := by
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, ← F0, Iso.hom_inv_id, Fid, Abelian.Ext.mk₀_id_comp]
    rw [← h1, hz, Abelian.Ext.comp_zero]
  ·
    intro c z
    change (Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f D.u0) β.inv)).comp
        (R (z.comp (Abelian.Ext.mk₀ (wcLadicScalar D.Yt.left ℓ c)) (add_zero n))) (zero_add n) =
      ((Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f D.u0) β.inv)).comp (R z)
        (zero_add n)).comp (Abelian.Ext.mk₀ (wcLadicScalar (Limits.pullback D.f D.u0) ℓ c))
        (add_zero n)
    have hkey : L.map (wcLadicScalar D.Yt.left ℓ c) ≫ π =
        π ≫ wcLadicScalar (Limits.pullback D.f D.u0) ℓ c := by
      have e1 := adj.homEquiv_naturality_left_symm (X' := wcContSheaf D.Yt.left ℚ_[ℓ])
        (X := wcContSheaf D.Yt.left ℚ_[ℓ]) (Y := wcContSheaf (Limits.pullback D.f D.u0) ℚ_[ℓ])
        (wcLadicScalar D.Yt.left ℓ c) (wcContPull (Limits.pullback.fst D.f D.u0) ℚ_[ℓ])
      have e2 := adj.homEquiv_naturality_right_symm (X := wcContSheaf D.Yt.left ℚ_[ℓ])
        (Y := wcContSheaf (Limits.pullback D.f D.u0) ℚ_[ℓ])
        (Y' := wcContSheaf (Limits.pullback D.f D.u0) ℚ_[ℓ])
        (wcContPull (Limits.pullback.fst D.f D.u0) ℚ_[ℓ])
        (wcLadicScalar (Limits.pullback D.f D.u0) ℓ c)
      have e3 := wc_contPull_ladicScalar (Limits.pullback.fst D.f D.u0) ℓ c
      rw [hπ]
      exact e1.symm.trans ((congrArg _ e3).trans e2)
    rw [hRz, hRz, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
    simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.mk₀_comp_mk₀_assoc, hkey]
  ·
    intro z
    change (Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f D.u0) β.inv)).comp
        (R ((Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left ((wcProEtPullback D.f).map φ₀))).comp z
          (zero_add n))) (zero_add n) =
      (Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f D.u0)
          (wcGeomFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX))).comp
        ((Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f D.u0) β.inv)).comp (R z)
          (zero_add n)) (zero_add n)
    have hθφ : (θ ((wcProEtPullback D.f).obj V₀)).inv ≫
        L.map (wcFreeSheafMap D.Yt.left ((wcProEtPullback D.f).map φ₀)) =
        wcFreeSheafMap (Limits.pullback D.f D.u0)
          ((wcProEtPullback (Limits.pullback.fst D.f D.u0)).map ((wcProEtPullback D.f).map φ₀)) ≫
          (θ ((wcProEtPullback D.f).obj V₀)).inv := by
      rw [Iso.inv_comp_eq, ← Category.assoc, ← hθ ((wcProEtPullback D.f).map φ₀), Category.assoc,
        Iso.hom_inv_id, Category.comp_id]
    have hβinv : β.inv ≫ (wcProEtPullback (Limits.pullback.fst D.f D.u0)).map
        ((wcProEtPullback D.f).map φ₀) =
        wcGeomFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ≫ β.inv := by
      rw [Iso.inv_comp_eq, ← Category.assoc, ← hβ, Category.assoc, Iso.hom_inv_id,
        Category.comp_id]
    have hβF : wcFreeSheafMap (Limits.pullback D.f D.u0) β.inv ≫
        wcFreeSheafMap (Limits.pullback D.f D.u0)
          ((wcProEtPullback (Limits.pullback.fst D.f D.u0)).map ((wcProEtPullback D.f).map φ₀)) =
        wcFreeSheafMap (Limits.pullback D.f D.u0)
          (wcGeomFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX) ≫
          wcFreeSheafMap (Limits.pullback D.f D.u0) β.inv := by
      rw [← F0, ← F0, hβinv]
    have hc : wcFreeSheafMap (Limits.pullback D.f D.u0) β.inv ≫
        (θ ((wcProEtPullback D.f).obj V₀)).inv ≫
          L.map (wcFreeSheafMap D.Yt.left ((wcProEtPullback D.f).map φ₀)) =
        wcFreeSheafMap (Limits.pullback D.f D.u0)
            (wcGeomFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX) ≫
          wcFreeSheafMap (Limits.pullback D.f D.u0) β.inv ≫
            (θ ((wcProEtPullback D.f).obj V₀)).inv := by
      rw [hθφ, ← Category.assoc, hβF, Category.assoc]
    rw [hRz, hRz, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
    simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.mk₀_comp_mk₀_assoc, Category.assoc, hc]

theorem wc_pencil_H0_stalk_pbc (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hX : WeaklyEtale (Limits.pullback.fst (Over.mk (Limits.pullback.snd D.f D.u0)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    ∃ ρ : wcCohG F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0 →+
        wcCoh F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ n,
      (∀ (c : ℚ_[ℓ]) (x : wcCohG F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0),
        ρ (wcCohGEnd F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0 (wcRqScalar D.f ℓ n c) x) =
          wcCohScalar F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ n c (ρ x)) ∧
      (∀ x : wcCohG F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0,
        ρ (wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0 x) =
          wcCohFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ n (ρ x)) ∧
      ∀ x : wcCohG F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0, ρ x = 0 →
        ∃ (V : (wcP1Over F'').left.ProEt) (g : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
          (v : V.left), V.hom v = D.u0 (IsLocalRing.closedPoint F'') ∧
          (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g)).comp x (zero_add 0) = 0 :=
by
  obtain ⟨V₀, g₀, φ₀, A, _, _, _, e, ε, hv, hφ, hε, hεφ⟩ :=
    wc_P1bar_strict_local_nbhd F'' D.u0 D.hu0 hP
  haveI hproj : Projective (wcFreeSheaf (wcP1Over F'').left V₀) :=
    wc_proet_free_projective_strict_local (wcP1Over F'').left V₀ A e
  obtain ⟨L, adj, _, θ, hθ⟩ := wc_proet_push_left_adjoint_free_nat D.f
  obtain ⟨Λ, hΛσ, hΛτ⟩ := ext_rightDerived_adj_projective L (wcProEtPush D.f) adj
    (wcFreeSheaf (wcP1Over F'').left V₀) (wcLadicSheaf D.Yt.left ℓ) n
  obtain ⟨Ψ, hΨinj, hΨs, hΨF⟩ :=
    wc_pencil_strict_nbhd_pbc F' F'' Y n hn2 D ℓ hℓ hX V₀ φ₀ A e ε hv hε hεφ

  have F0 : ∀ {U V W : (wcP1Over F'').left.ProEt} (a : U ⟶ V) (b : V ⟶ W),
      wcFreeSheafMap (wcP1Over F'').left (a ≫ b) =
        wcFreeSheafMap (wcP1Over F'').left a ≫ wcFreeSheafMap (wcP1Over F'').left b := by
    intro U V W a b
    simp only [wcFreeSheafMap, Functor.map_comp, Functor.whiskerRight_comp] <;> rfl

  have hΛσ' : ∀ (c : ℚ_[ℓ]) (y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V₀) (wcRq D.f ℓ n) 0),
      Λ (y.comp (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ n c)) (add_zero 0)) =
        (Λ y).comp (Abelian.Ext.mk₀ (wcLadicScalar D.Yt.left ℓ c)) (add_zero n) :=
    fun c y => hΛσ (wcLadicScalar D.Yt.left ℓ c) y
  have hΛτ' : ∀ (τ : wcFreeSheaf (wcP1Over F'').left V₀ ⟶ wcFreeSheaf (wcP1Over F'').left V₀)
      (y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V₀) (wcRq D.f ℓ n) 0),
      Λ ((Abelian.Ext.mk₀ τ).comp y (zero_add 0)) =
        (Abelian.Ext.mk₀ (L.map τ)).comp (Λ y) (zero_add n) :=
    fun τ y => hΛτ τ y
  let ρ : wcCohG F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0 →+
      wcCoh F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ n :=
    Ψ.comp (((Abelian.Ext.mk₀ (θ V₀).inv).precomp (wcLadicSheaf D.Yt.left ℓ) (zero_add n)).comp
      (Λ.toAddMonoidHom.comp
        ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g₀)).precomp
          (wcRq D.f ℓ n) (zero_add 0))))
  have hρx : ∀ x : wcCohG F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0, ρ x =
      Ψ ((Abelian.Ext.mk₀ (θ V₀).inv).comp
        (Λ ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g₀)).comp x (zero_add 0)))
        (zero_add n)) := fun x => rfl
  refine ⟨ρ, ?_, ?_, ?_⟩
  ·
    intro c x
    rw [hρx, hρx]
    have h1 : (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g₀)).comp
        (wcCohGEnd F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0 (wcRqScalar D.f ℓ n c) x) (zero_add 0) =
        ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g₀)).comp x (zero_add 0)).comp
          (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ n c)) (add_zero 0) :=
      (Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (add_zero 0) (by omega)).symm
    have h3 : ∀ y : Abelian.Ext (L.obj (wcFreeSheaf (wcP1Over F'').left V₀))
        (wcLadicSheaf D.Yt.left ℓ) n,
        (Abelian.Ext.mk₀ (θ V₀).inv).comp
          (y.comp (Abelian.Ext.mk₀ (wcLadicScalar D.Yt.left ℓ c)) (add_zero n)) (zero_add n) =
        ((Abelian.Ext.mk₀ (θ V₀).inv).comp y (zero_add n)).comp
          (Abelian.Ext.mk₀ (wcLadicScalar D.Yt.left ℓ c)) (add_zero n) := fun y =>
      (Abelian.Ext.comp_assoc _ _ _ (zero_add n) (add_zero n) (by omega)).symm
    rw [h1, hΛσ', h3, hΨs]
  ·
    intro x
    rw [hρx, hρx]
    have h1 : (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g₀)).comp
        (wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0 x) (zero_add 0) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left φ₀)).comp
          ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g₀)).comp x (zero_add 0))
          (zero_add 0) := by
      show (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g₀)).comp
          ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left
            (wcGeomFrob F'' (wcP1Over F'') hP))).comp x (zero_add 0)) (zero_add 0) = _
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Abelian.Ext.mk₀_comp_mk₀_assoc, ← F0, ← F0, hφ]
    have hθφ : (θ V₀).inv ≫ L.map (wcFreeSheafMap (wcP1Over F'').left φ₀) =
        wcFreeSheafMap D.Yt.left ((wcProEtPullback D.f).map φ₀) ≫ (θ V₀).inv := by
      rw [Iso.inv_comp_eq, ← Category.assoc, ← hθ φ₀, Category.assoc, Iso.hom_inv_id,
        Category.comp_id]
    have h3 : ∀ y : Abelian.Ext (L.obj (wcFreeSheaf (wcP1Over F'').left V₀))
        (wcLadicSheaf D.Yt.left ℓ) n,
        (Abelian.Ext.mk₀ (θ V₀).inv).comp
          ((Abelian.Ext.mk₀ (L.map (wcFreeSheafMap (wcP1Over F'').left φ₀))).comp y (zero_add n))
          (zero_add n) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left ((wcProEtPullback D.f).map φ₀))).comp
          ((Abelian.Ext.mk₀ (θ V₀).inv).comp y (zero_add n)) (zero_add n) := by
      intro y
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Abelian.Ext.mk₀_comp_mk₀_assoc, hθφ]
    rw [h1, hΛτ', h3, hΨF]
  ·
    intro x hx
    rw [hρx] at hx
    have h1 := hΨinj (hx.trans (map_zero Ψ).symm)
    have h2 : Λ ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g₀)).comp x
        (zero_add 0)) = 0 := by
      have h4 : (Abelian.Ext.mk₀ (θ V₀).hom).comp ((Abelian.Ext.mk₀ (θ V₀).inv).comp
          (Λ ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g₀)).comp x (zero_add 0)))
          (zero_add n)) (zero_add n) =
          Λ ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g₀)).comp x (zero_add 0)) := by
        rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
      rw [← h4, h1, Abelian.Ext.comp_zero]
    have h3 : (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g₀)).comp x (zero_add 0) = 0 :=
      Λ.injective (h2.trans (map_zero Λ).symm)
    exact ⟨V₀, g₀, e.inv (IsLocalRing.closedPoint A), hv, h3⟩

theorem wc_pencil_Rq_connected_trivialization (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    ∃ (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (r : ℕ),
      QuasiCompact w.left ∧ ConnectedSpace W.left ∧
      (∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left,
        (∀ i : Fin D.m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠ D.S i (IsLocalRing.closedPoint F'')) →
        ∃ z : W.left, w.left z = p) ∧
      Nonempty ((wcRq D.f ℓ n).over W ≅ (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W) :=
by
  classical

  haveI := D.proper
  haveI hsep : IsSeparated (wcP1Over F'').hom := (inferInstance : IsSeparated (wcProjKStr F'' 1))
  haveI hcomp : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; exact D.proper
  haveI hfp : IsProper D.f := IsProper.of_comp D.f (wcP1Over F'').hom
  haveI hPw : WeaklyEtale (wcGeomPoint F'' (wcP1Over F'') hP).hom := hP

  obtain ⟨Ub, hUb, hconn, hcpt, hqs, hqcι⟩ := wc_P1bar_smooth_locus F'' hP D.m D.S D.hS
  haveI := hqcι
  have hu : WeaklyEtale (Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) := inferInstance

  have htors : ∀ j : ℕ, ∃ (E : Scheme.{u}) (πE : E ⟶ Ub.toScheme),
      IsFinite πE ∧ Etale πE ∧ Surjective πE ∧
      ∃ hE : WeaklyEtale (πE ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom),
      ∃ (b' : ℕ) (e' : Fin b' → ℕ),
        Nonempty ((((wcProEtPush D.f).rightDerived (Nat.unpair j).1).obj
            (wcContSheaf D.Yt.left (ZMod (ℓ ^ (Nat.unpair j).2)))).over
            (MorphismProperty.Over.mk ⊤ (πE ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) hE) ≅
          (wcContSheaf (wcP1Over F'').left ((i : Fin b') → ZMod (ℓ ^ e' i))).over
            (MorphismProperty.Over.mk ⊤ (πE ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) hE)) := by
    intro j
    obtain ⟨N, V, v, het, hcov, hV, b, e, hiso⟩ :=
      wc_pencil_Rq_torsion_etale_locally_const F' F'' Y n D ℓ hℓ hP Ub hUb
        (Nat.unpair j).1 (Nat.unpair j).2
    exact wc_proet_loc_const_finite_fet_trivial (wcP1Over F'').left _ ℓ Ub.toScheme
      (Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) hu hconn hcpt hqs N V v het hcov hV b e hiso
  choose E πE hfin het hsurj hE b' e' hθ using htors

  obtain ⟨W₀, p, hpWE, hpqc, hpsurj, hW₀conn, hW₀cpt, hW₀qs, ht⟩ :=
    wc_fet_tower_connected_limit Ub.toScheme hconn hcpt hqs E πE hfin het hsurj
  choose t ht using ht
  haveI := hpWE
  haveI := hpqc
  have hWE : WeaklyEtale (p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) := inferInstance

  let W : (wcP1Over F'').left.ProEt :=
    MorphismProperty.Over.mk ⊤ (p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) hWE
  let w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP :=
    MorphismProperty.Over.homMk (p ≫ Ub.ι) (Category.assoc _ _ _) trivial
  let Ej : ℕ → (wcP1Over F'').left.ProEt := fun j =>
    MorphismProperty.Over.mk ⊤ (πE j ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) (hE j)
  let c : ∀ j, W ⟶ Ej j := fun j =>
    MorphismProperty.Over.homMk (t j)
      (show t j ≫ πE j ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom =
          p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom by
        rw [← Category.assoc, ht j]) trivial

  have hres : ∀ q k : ℕ, ∃ (b : ℕ) (e : Fin b → ℕ),
      Nonempty ((((wcProEtPush D.f).rightDerived q).obj (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))).over W ≅
        (wcContSheaf (wcP1Over F'').left ((j : Fin b) → ZMod (ℓ ^ e j))).over W) := by
    intro q k
    have h := hθ (Nat.pair q k)
    rw [Nat.unpair_pair] at h
    obtain ⟨θ⟩ := h
    exact ⟨b' (Nat.pair q k), e' (Nat.pair q k),
      ⟨((Scheme.ProEt.topology (wcP1Over F'').left).overMapPullback AddCommGrpCat.{u+1}
        (c (Nat.pair q k))).mapIso θ⟩⟩

  obtain ⟨a, b, e, hZ⟩ :=
    wc_proet_Rq_int_const_of_torsion_const D.f ℓ W hW₀conn hW₀cpt hW₀qs hres n
  have hQ := wc_proet_Rq_rat_const_of_int_const D.f ℓ W hW₀cpt hW₀qs n a b e hZ

  refine ⟨W, w, a, ?_, hW₀conn, ?_, hQ⟩
  · show QuasiCompact (p ≫ Ub.ι)
    infer_instance
  · intro x hx
    have hxU : x ∈ Ub := (hUb x).2 hx
    obtain ⟨y, hy⟩ : x ∈ Set.range Ub.ι := by rw [Scheme.Opens.range_ι]; exact hxU
    obtain ⟨z, hz⟩ := hpsurj.surj y
    refine ⟨z, ?_⟩
    show (p ≫ Ub.ι) z = x
    rw [Scheme.Hom.comp_apply, hz, hy]

theorem wc_proet_rigid_on_connected_constant : ∀ (S : Scheme.{u}) (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r : ℕ) (B W : S.ProEt) (w : W ⟶ B),
    ConnectedSpace W.left →
    (G.over W ≅ (wcContSheaf S (Fin r → ℚ_[ℓ])).over W) →
    ∀ (s : G.obj.obj (Opposite.op B)) (V₀ : S.ProEt) (g₀ : V₀ ⟶ B) (v₀ : V₀.left) (z₀ : W.left),
    g₀.left v₀ = w.left z₀ → (G.obj.map g₀.op).hom s = 0 → (G.obj.map w.op).hom s = 0 :=
by
  intro S G ℓ _ r B W w hW θ s V₀ g₀ v₀ z₀ hpt h0

  have hw : WeaklyEtale w.left := by
    apply MorphismProperty.of_postcomp (W := @WeaklyEtale) (W' := @WeaklyEtale) w.left B.hom B.prop
    rw [MorphismProperty.Over.w w]
    exact W.prop
  have ha₀ : WeaklyEtale (Limits.pullback.fst g₀.left w.left) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip hw
  have : WeaklyEtale (Limits.pullback.fst g₀.left w.left ≫ V₀.hom) := by
    have := V₀.prop
    infer_instance
  let T : S.ProEt := Scheme.ProEt.mk (Limits.pullback.fst g₀.left w.left ≫ V₀.hom)
  let a : T ⟶ V₀ := MorphismProperty.Over.homMk (Limits.pullback.fst g₀.left w.left) rfl trivial
  have hbtri : Limits.pullback.snd g₀.left w.left ≫ W.hom = T.hom := by
    show _ = Limits.pullback.fst g₀.left w.left ≫ V₀.hom
    rw [← MorphismProperty.Over.w w, ← Category.assoc, ← Limits.pullback.condition,
      Category.assoc, MorphismProperty.Over.w g₀]
  let b : T ⟶ W := MorphismProperty.Over.homMk (Limits.pullback.snd g₀.left w.left) hbtri trivial
  have hab : a ≫ g₀ = b ≫ w := by
    apply MorphismProperty.Over.Hom.ext
    change Limits.pullback.fst g₀.left w.left ≫ g₀.left = Limits.pullback.snd g₀.left w.left ≫ w.left
    exact Limits.pullback.condition
  obtain ⟨τ, -, hτ⟩ :=
    Scheme.Pullback.exists_preimage_pullback (f := g₀.left) (g := w.left) v₀ z₀ hpt

  obtain ⟨t, ht⟩ : ∃ t, t = (G.obj.map w.op).hom s := ⟨_, rfl⟩
  rw [← ht]
  have hcomp : ∀ {X Y Z : S.ProEt} (f : X ⟶ Y) (g : Y ⟶ Z) (x : G.obj.obj (Opposite.op Z)),
      (G.obj.map f.op).hom ((G.obj.map g.op).hom x) = (G.obj.map (f ≫ g).op).hom x := by
    intro X Y Z f g x
    rw [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply]
  have hbt : (G.obj.map b.op).hom t = 0 := by
    rw [ht, hcomp, ← hab, ← hcomp, h0, map_zero]

  let X₀ : Over W := Over.mk (𝟙 W)
  let X₁ : Over W := Over.mk b
  let hX : X₁ ⟶ X₀ := Over.homMk b (Category.comp_id b)
  have key : (θ.hom.hom.app (Opposite.op X₁)).hom ((G.obj.map b.op).hom t) =
      ((wcContSheaf S (Fin r → ℚ_[ℓ])).obj.map b.op).hom
        ((θ.hom.hom.app (Opposite.op X₀)).hom t) := by
    have h2 := congrArg (fun f => AddCommGrpCat.Hom.hom f t) (θ.hom.hom.naturality hX.op)
    exact h2
  have hz : (θ.hom.hom.app (Opposite.op X₁)).hom ((G.obj.map b.op).hom t) = 0 :=
    (congrArg (θ.hom.hom.app (Opposite.op X₁)).hom hbt).trans (map_zero _)
  have key3 := hz.symm.trans key
  let φ : C(W.left, Fin r → ℚ_[ℓ]) :=
    (show ULift.{u+1} C(W.left, Fin r → ℚ_[ℓ]) from (θ.hom.hom.app (Opposite.op X₀)).hom t).down
  have key2 : (0 : ULift.{u+1} C(T.left, Fin r → ℚ_[ℓ])) =
      ULift.up (φ.comp b.left.base.hom) := key3
  have hφτ : φ (b.left τ) = 0 := by
    have h3 := congrArg (fun x : ULift.{u+1} C(T.left, Fin r → ℚ_[ℓ]) => x.down τ) key2
    exact h3.symm

  have hφ0 : φ = 0 := by
    have hsub := (isPreconnected_range φ.continuous).subsingleton
    exact ContinuousMap.ext fun z => (hsub ⟨z, rfl⟩ ⟨b.left τ, rfl⟩).trans hφτ
  have hy0 : (θ.hom.hom.app (Opposite.op X₀)).hom t = 0 := by
    have h4 : (show ULift.{u+1} C(W.left, Fin r → ℚ_[ℓ]) from
        (θ.hom.hom.app (Opposite.op X₀)).hom t) = 0 := ULift.ext _ _ hφ0
    exact h4

  have hinv : (θ.inv.hom.app (Opposite.op X₀)).hom ((θ.hom.hom.app (Opposite.op X₀)).hom t) = t := by
    have h1 := Iso.hom_inv_id_app ((sheafToPresheaf _ _).mapIso θ) (Opposite.op X₀)
    have h2 := congrArg (fun f => AddCommGrpCat.Hom.hom f t) h1
    exact h2
  rw [hy0, map_zero] at hinv
  exact hinv.symm

theorem wc_pencil_H0_lisse_spread (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (x : wcCohG F'' (wcP1Over F'') hP (wcRq D.f ℓ n) 0)
    (hx : ∃ (V : (wcP1Over F'').left.ProEt) (g : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
      (v : V.left), V.hom v = D.u0 (IsLocalRing.closedPoint F'') ∧
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g)).comp x (zero_add 0) = 0) :
    ∀ (V : (wcP1Over F'').left.ProEt) (g : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP),
      (∀ (v : V.left) (i : Fin D.m), V.hom v ≠ D.S i (IsLocalRing.closedPoint F'')) →
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g)).comp x (zero_add 0) = 0 :=
by
  classical
  obtain ⟨x₀, rfl⟩ : ∃ x₀, Abelian.Ext.mk₀ x₀ = x := ⟨_, Abelian.Ext.mk₀_addEquiv₀_apply x⟩
  obtain ⟨η, hη1, hη2⟩ := wc_proet_free_sheaf_yoneda (wcP1Over F'').left

  have hzero : ∀ (V : (wcP1Over F'').left.ProEt) (g : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP),
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g)).comp (Abelian.Ext.mk₀ x₀)
        (zero_add 0) = 0 ↔ wcFreeSheafMap (wcP1Over F'').left g ≫ x₀ = 0 := by
    intro V g
    rw [Abelian.Ext.mk₀_comp_mk₀]
    constructor
    · intro h
      apply (Abelian.Ext.mk₀_bijective _ _).1
      rw [h, Abelian.Ext.mk₀_zero]
    · intro h
      rw [h, Abelian.Ext.mk₀_zero]
  have hsec : ∀ (V : (wcP1Over F'').left.ProEt) (g : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP),
      ((wcFreeSheafMap (wcP1Over F'').left g ≫ x₀).hom.app (Opposite.op V)).hom (η V) =
        ((wcRq D.f ℓ n).obj.map g.op).hom
          ((x₀.hom.app (Opposite.op (wcGeomPoint F'' (wcP1Over F'') hP))).hom
            (η (wcGeomPoint F'' (wcP1Over F'') hP))) := by
    intro V g
    have h1 := congrArg (fun φ => AddCommGrpCat.Hom.hom φ (η (wcGeomPoint F'' (wcP1Over F'') hP)))
      (x₀.hom.naturality g.op)
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at h1
    change (x₀.hom.app (Opposite.op V)).hom
      (((wcFreeSheafMap (wcP1Over F'').left g).hom.app (Opposite.op V)).hom (η V)) = _
    rw [hη2 (wcGeomPoint F'' (wcP1Over F'') hP) V g]
    exact h1
  have star : ∀ (V : (wcP1Over F'').left.ProEt) (g : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP),
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g)).comp (Abelian.Ext.mk₀ x₀)
        (zero_add 0) = 0 ↔
      ((wcRq D.f ℓ n).obj.map g.op).hom
          ((x₀.hom.app (Opposite.op (wcGeomPoint F'' (wcP1Over F'') hP))).hom
            (η (wcGeomPoint F'' (wcP1Over F'') hP))) = 0 := by
    intro V g
    rw [hzero, ← hsec]
    constructor
    · intro h
      rw [h]
      simp
    · intro h
      obtain ⟨g', _, hg'⟩ := hη1 V (wcRq D.f ℓ n) 0
      have a1 := hg' (wcFreeSheafMap (wcP1Over F'').left g ≫ x₀) h
      have a2 := hg' 0 (by simp)
      rw [a1, a2]
  obtain ⟨W, w, r, hqc, hconn, hsurj, ⟨θ⟩⟩ :=
    wc_pencil_Rq_connected_trivialization F' F'' Y n D ℓ hℓ hP
  have lift : ∀ (V : (wcP1Over F'').left.ProEt) (g : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
      (p : V.left), (∀ i : Fin D.m, V.hom p ≠ D.S i (IsLocalRing.closedPoint F'')) →
      ∃ z : W.left, w.left z = g.left p := by
    intro V g p hp
    apply hsurj
    intro i
    have e : (wcGeomPoint F'' (wcP1Over F'') hP).hom (g.left p) = V.hom p := by
      rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w g]
    rw [e]
    exact hp i
  obtain ⟨V₁, g₁, v₁, hv₁, hx₁⟩ := hx
  have hs₁ := (star V₁ g₁).1 hx₁
  obtain ⟨z₀, hz₀⟩ := lift V₁ g₁ v₁ (fun i => by rw [hv₁]; exact D.hu0S i)
  have hW := wc_proet_rigid_on_connected_constant (wcP1Over F'').left (wcRq D.f ℓ n) ℓ r
    (wcGeomPoint F'' (wcP1Over F'') hP) W w hconn θ _ V₁ g₁ v₁ z₀ hz₀.symm hs₁
  intro V g hV
  exact (star V g).2 (wc_proet_section_zero_of_qc_image (wcP1Over F'').left (wcRq D.f ℓ n)
    (wcGeomPoint F'' (wcP1Over F'') hP) W w hqc _ hW V g (fun p => lift V g p (hV p)))

theorem wc_rat_pt_nbhd_torsion_res_injective (F' F'' : Type u) [Field F'] [Field F'']
    [Finite F''] [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (u : Spec (.of F'') ⟶ (wcP1Over F'').left) (hu : u ≫ (wcP1Over F'').hom = 𝟙 _)
    (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom u ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = u (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom u)
    (L : Sheaf (Scheme.ProEt.topology D.Yt.left) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology (Limits.pullback D.f u)) AddCommGrpCat.{u+1})
    [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L]
    (adj : L ⊣ wcProEtPush (Limits.pullback.fst D.f u))
    (θ : ∀ V : D.Yt.left.ProEt, L.obj (wcFreeSheaf D.Yt.left V) ≅
      wcFreeSheaf (Limits.pullback D.f u) ((wcProEtPullback (Limits.pullback.fst D.f u)).obj V))
    (hθ : ∀ {V V' : D.Yt.left.ProEt} (a : V ⟶ V'),
      L.map (wcFreeSheafMap D.Yt.left a) ≫ (θ V').hom =
        (θ V).hom ≫ wcFreeSheafMap (Limits.pullback D.f u)
          ((wcProEtPullback (Limits.pullback.fst D.f u)).map a))
    (j k : ℕ) :
    Function.Injective (wcProEtRes (Limits.pullback.fst D.f u) L adj θ (ZMod (ℓ ^ k))
      ((wcProEtPullback D.f).obj V₀) j) :=
by
  classical

  haveI hsubF : Subsingleton ↥(Spec (.of F'')) := by
    constructor
    intro a b
    apply PrimeSpectrum.ext
    have ha := (Ideal.eq_bot_or_top (PrimeSpectrum.asIdeal a)).resolve_right
      (PrimeSpectrum.isPrime a).ne_top
    have hb := (Ideal.eq_bot_or_top (PrimeSpectrum.asIdeal b)).resolve_right
      (PrimeSpectrum.isPrime b).ne_top
    rw [ha, hb]
  haveI hu0 : IsClosedImmersion u :=
    isClosedImmersion_of_comp_eq_id (Y := Spec (.of F'')) (wcP1Over F'').hom u hu
  haveI hcl : IsClosedImmersion (Limits.pullback.fst D.f u) := inferInstance
  haveI : IsProper D.Yt.hom := D.proper
  haveI : IsLocallyNoetherian D.Yt.left :=
    LocallyOfFiniteType.isLocallyNoetherian (Y := Spec (.of F'')) D.Yt.hom

  haveI : (wcProEtPush (Limits.pullback.fst D.f u)).IsRightAdjoint := ⟨_, ⟨adj⟩⟩
  haveI : Limits.PreservesLimitsOfSize.{0, 0} (wcProEtPush (Limits.pullback.fst D.f u)) :=
    adj.rightAdjoint_preservesLimits
  haveI : Limits.PreservesFiniteLimits (wcProEtPush (Limits.pullback.fst D.f u)) :=
    Limits.PreservesLimitsOfSize.preservesFiniteLimits _
  haveI : Limits.PreservesFiniteColimits (wcProEtPush (Limits.pullback.fst D.f u)) :=
    wc_proet_push_closed_preservesFiniteColimits (Limits.pullback.fst D.f u)
  haveI : (wcProEtPush (Limits.pullback.fst D.f u)).PreservesZeroMorphisms :=
    Functor.preservesZeroMorphisms_of_isRightAdjoint _
  haveI : (wcProEtPush (Limits.pullback.fst D.f u)).Additive :=
    Functor.additive_of_preserves_binary_products _

  haveI hpsep : IsSeparated (wcP1Over F'').hom := by
    show IsSeparated (Proj.toSpecZero _ ≫ Spec.map _)
    infer_instance
  haveI hfp : IsProper D.f := by
    haveI : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; infer_instance
    exact IsProper.of_comp D.f (wcP1Over F'').hom
  haveI hfst : IsProper (Limits.pullback.fst V₀.hom D.f) := inferInstance
  obtain ⟨q, hqdef⟩ : ∃ q : ((wcProEtPullback D.f).obj V₀).left ⟶ Spec (.of A),
      q = Limits.pullback.fst V₀.hom D.f ≫ e.hom := ⟨_, rfl⟩
  haveI hq : IsProper q := by
    rw [hqdef]
    exact (inferInstance : IsProper (Limits.pullback.fst V₀.hom D.f ≫ e.hom))
  haveI hcpt : CompactSpace ((wcProEtPullback D.f).obj V₀).left :=
    QuasiCompact.compactSpace_of_compactSpace q
  haveI hsep : IsSeparated (Limits.terminal.from ((wcProEtPullback D.f).obj V₀).left) := by
    rw [Limits.terminal.hom_ext (Limits.terminal.from _) (q ≫ Limits.terminal.from (Spec (.of A)))]
    infer_instance
  have hrng0 : Set.range u = {u (IsLocalRing.closedPoint F'')} := by
    ext x
    constructor
    · rintro ⟨s, rfl⟩
      rw [Subsingleton.elim s (IsLocalRing.closedPoint F'')]
      exact Set.mem_singleton _
    · rintro rfl
      exact ⟨_, rfl⟩
  have hsubv : ∀ v : V₀.left, V₀.hom v = u (IsLocalRing.closedPoint F'') ↔
      e.hom v = IsLocalRing.closedPoint A := by
    intro v
    constructor
    · intro h
      obtain ⟨w, hw1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := V₀.hom) (g := u)
        v (IsLocalRing.closedPoint F'') h
      obtain ⟨w₀, hw₀1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := V₀.hom) (g := u)
        (e.inv (IsLocalRing.closedPoint A)) (IsLocalRing.closedPoint F'') hv
      haveI hsubA : Subsingleton ↥(Spec (.of (AlgebraicClosure F''))) := by
        constructor
        intro a b
        apply PrimeSpectrum.ext
        have ha := (Ideal.eq_bot_or_top (PrimeSpectrum.asIdeal a)).resolve_right
          (PrimeSpectrum.isPrime a).ne_top
        have hb := (Ideal.eq_bot_or_top (PrimeSpectrum.asIdeal b)).resolve_right
          (PrimeSpectrum.isPrime b).ne_top
        rw [ha, hb]
      have hww : w = w₀ := by
        rw [← Scheme.hom_inv_apply ε w, ← Scheme.hom_inv_apply ε w₀,
          Subsingleton.elim (ε.hom w) (ε.hom w₀)]
      rw [← hw1, hww, hw₀1]
      first
        | exact Scheme.inv_hom_apply e _
        | exact congrArg (fun φ => φ (IsLocalRing.closedPoint A)) (congrArg Scheme.Hom.base e.inv_hom_id)
        | simp
    · intro h
      rw [← Scheme.hom_inv_apply e v, h]
      exact hv
  have hcond0 : ∀ z₀ : ↥(Limits.pullback V₀.hom D.f),
      V₀.hom (Limits.pullback.fst V₀.hom D.f z₀) = D.f (Limits.pullback.snd V₀.hom D.f z₀) := by
    intro z₀
    first
      | rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
      | exact (Scheme.Hom.comp_apply _ _ z₀).symm.trans
          ((congrArg (fun φ => φ z₀) (Limits.pullback.condition (f := V₀.hom) (g := D.f))).trans
            (Scheme.Hom.comp_apply _ _ z₀))
  have hfib0 : ∀ z₀ : ↥(Limits.pullback V₀.hom D.f),
      Limits.pullback.snd V₀.hom D.f z₀ ∈ Set.range (Limits.pullback.fst D.f u) ↔
        e.hom (Limits.pullback.fst V₀.hom D.f z₀) = IsLocalRing.closedPoint A := by
    intro z₀
    rw [Scheme.Pullback.range_fst, Set.mem_preimage, hrng0, Set.mem_singleton_iff,
      ← hcond0 z₀, hsubv]
  have hfib : ∀ z : ((wcProEtPullback D.f).obj V₀).left,
      ((wcProEtPullback D.f).obj V₀).hom z ∈ Set.range (Limits.pullback.fst D.f u) ↔
        q z = IsLocalRing.closedPoint A := by
    intro z
    subst hqdef
    exact hfib0 z
  have hn : 0 < ℓ ^ k := pow_pos (Fact.out : ℓ.Prime).pos k

  obtain ⟨ι, hιm, hchar⟩ := wc_contPull_kernel_vanSub (Limits.pullback.fst D.f u) (ℓ ^ k)

  have hvan : ∀ (m : ℕ) (y : Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀))
      (Limits.kernel (wcContPull (Limits.pullback.fst D.f u) (ZMod (ℓ ^ k)))) m), y = 0 := by
    intro m y
    cases m with
    | succ m' =>
      have hC : IsClosed (Set.range (Limits.pullback.fst D.f u)) :=
        (Scheme.Hom.isClosedEmbedding (Limits.pullback.fst D.f u)).isClosed_range
      have hopen : IsOpen ({IsLocalRing.closedPoint A}ᶜ : Set (Spec (.of A))) := by
        apply isOpen_compl_iff.mpr
        exact (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mpr
          (IsLocalRing.maximalIdeal.isMaximal A)
      have hne : ({IsLocalRing.closedPoint A}ᶜ : Set (Spec (.of A))) ≠ Set.univ := by
        intro h
        have h' : IsLocalRing.closedPoint A ∈ ({IsLocalRing.closedPoint A}ᶜ : Set (Spec (.of A))) :=
          h ▸ Set.mem_univ _
        exact h' (Set.mem_singleton _)
      have het : ∀ q' : ℕ, Subsingleton (wcEtExt ((wcProEtPullback D.f).obj V₀).left
          (wcEtExtZero ((wcProEtPullback D.f).obj V₀).left
            (((wcProEtPullback D.f).obj V₀).hom ⁻¹' Set.range (Limits.pullback.fst D.f u))ᶜ
            (ℓ ^ k)) (q' + 1)) := by
        intro q'
        have hset : (((wcProEtPullback D.f).obj V₀).hom ⁻¹'
            Set.range (Limits.pullback.fst D.f u))ᶜ =
            q ⁻¹' ({IsLocalRing.closedPoint A}ᶜ : Set (Spec (.of A))) := by
          ext z
          simp only [Set.mem_compl_iff, Set.mem_preimage, Set.mem_singleton_iff]
          exact not_congr (hfib z)
        rw [hset]
        exact wc_et_henselian_proper_vanishing A _ q (ℓ ^ k) hn.ne' _ hopen hne (q' + 1)
      exact wc_proet_vanishing_subsheaf_zmod_of_et D.Yt.left ((wcProEtPullback D.f).obj V₀)
        (Set.range (Limits.pullback.fst D.f u)) hC (ℓ ^ k) hn _ ι hιm hchar het m' y
    | zero =>
      obtain ⟨φ, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 y
      obtain ⟨ev, -, hev0⟩ := proet_free_sheaf_hom_equiv D.Yt.left ((wcProEtPullback D.f).obj V₀)
      have hvz := (hchar ((wcProEtPullback D.f).obj V₀)
        ((ι.hom.app (Opposite.op ((wcProEtPullback D.f).obj V₀))).hom (ev _ φ))).1 ⟨_, rfl⟩
      let r : C(↥((wcProEtPullback D.f).obj V₀).left, ULift.{u+1} (ZMod (ℓ ^ k))) :=
        (ι.hom.app (Opposite.op ((wcProEtPullback D.f).obj V₀))).hom (ev _ φ)
      have hrz : ∀ z, r z = 0 := by
        intro z
        have hT : IsClosed (r ⁻¹' {r z}) := (isClosed_discrete _).preimage r.continuous
        have h1 : IsClosed (q '' (r ⁻¹' {r z})) := Scheme.Hom.isClosedMap q _ hT
        have h2 : q z ∈ q '' (r ⁻¹' {r z}) := ⟨z, rfl, rfl⟩
        obtain ⟨z', hz'1, hz'2⟩ := (IsLocalRing.specializes_closedPoint (q z)).mem_closed h1 h2
        have h3 : r z' = r z := hz'1
        rw [← h3]
        exact hvz z' ((hfib z').2 hz'2)
      have hr0 : r = 0 := ContinuousMap.ext hrz
      have hmono : Mono (ι.hom.app (Opposite.op ((wcProEtPullback D.f).obj V₀))) := by
        have h1 : Mono ι.hom := (Sheaf.Hom.mono_iff_presheaf_mono _ _ ι).1 hιm
        exact (NatTrans.mono_iff_mono_app _).1 h1 _
      have hinj : Function.Injective
          (ι.hom.app (Opposite.op ((wcProEtPullback D.f).obj V₀))).hom :=
        (AddCommGrpCat.mono_iff_injective _).1 hmono
      have hs : ev _ φ = 0 := by
        apply hinj
        rw [map_zero]
        exact hr0
      have hφ : φ = 0 := (ev _).injective (hs.trans (hev0 _).symm)
      rw [hφ]
      simp

  rw [injective_iff_map_eq_zero]
  intro x hx
  change (Abelian.Ext.mk₀ (θ ((wcProEtPullback D.f).obj V₀)).inv).comp
    ((Abelian.Ext.mapExactFunctor L x).comp
      (Abelian.Ext.mk₀ ((adj.homEquiv (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))
        (wcContSheaf (Limits.pullback D.f u) (ZMod (ℓ ^ k)))).symm
          (wcContPull (Limits.pullback.fst D.f u) (ZMod (ℓ ^ k))))) (add_zero j))
    (zero_add j) = 0 at hx

  have h1 : (Abelian.Ext.mapExactFunctor L x).comp
      (Abelian.Ext.mk₀ ((adj.homEquiv (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))
        (wcContSheaf (Limits.pullback D.f u) (ZMod (ℓ ^ k)))).symm
          (wcContPull (Limits.pullback.fst D.f u) (ZMod (ℓ ^ k))))) (add_zero j) = 0 := by
    have h4 : (Abelian.Ext.mk₀ (θ ((wcProEtPullback D.f).obj V₀)).hom).comp
        ((Abelian.Ext.mk₀ (θ ((wcProEtPullback D.f).obj V₀)).inv).comp
          ((Abelian.Ext.mapExactFunctor L x).comp
            (Abelian.Ext.mk₀ ((adj.homEquiv (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))
              (wcContSheaf (Limits.pullback D.f u) (ZMod (ℓ ^ k)))).symm
                (wcContPull (Limits.pullback.fst D.f u) (ZMod (ℓ ^ k))))) (add_zero j))
          (zero_add j)) (zero_add j) =
        (Abelian.Ext.mapExactFunctor L x).comp
          (Abelian.Ext.mk₀ ((adj.homEquiv (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))
            (wcContSheaf (Limits.pullback D.f u) (ZMod (ℓ ^ k)))).symm
              (wcContPull (Limits.pullback.fst D.f u) (ZMod (ℓ ^ k))))) (add_zero j) := by
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    rw [← h4, hx, Abelian.Ext.comp_zero]

  have h2 : (Abelian.Ext.mapExactFunctor (wcProEtPush (Limits.pullback.fst D.f u))
      (Abelian.Ext.mapExactFunctor L x)).comp
      (Abelian.Ext.mk₀ ((wcProEtPush (Limits.pullback.fst D.f u)).map
        ((adj.homEquiv (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))
          (wcContSheaf (Limits.pullback D.f u) (ZMod (ℓ ^ k)))).symm
            (wcContPull (Limits.pullback.fst D.f u) (ZMod (ℓ ^ k)))))) (add_zero j) = 0 := by
    have e1 := congrArg (Abelian.Ext.mapExactFunctor (wcProEtPush (Limits.pullback.fst D.f u))) h1
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀] at e1
    rw [e1]
    exact map_zero ((wcProEtPush (Limits.pullback.fst D.f u)).mapExtAddHom _ _ j)

  have hη : x.comp (Abelian.Ext.mk₀ (adj.unit.app (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))))
      (add_zero j) =
      (Abelian.Ext.mk₀ (adj.unit.app (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀)))).comp
        (Abelian.Ext.mapExactFunctor (wcProEtPush (Limits.pullback.fst D.f u))
          (Abelian.Ext.mapExactFunctor L x)) (zero_add j) := by
    have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp x adj.unit
    rw [Abelian.Ext.comp_mapExactFunctor, Abelian.Ext.id_mapExactFunctor] at h
    exact h
  have hunit : adj.unit.app (wcContSheaf D.Yt.left (ZMod (ℓ ^ k))) ≫
      (wcProEtPush (Limits.pullback.fst D.f u)).map
        ((adj.homEquiv (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))
          (wcContSheaf (Limits.pullback D.f u) (ZMod (ℓ ^ k)))).symm
            (wcContPull (Limits.pullback.fst D.f u) (ZMod (ℓ ^ k)))) =
      wcContPull (Limits.pullback.fst D.f u) (ZMod (ℓ ^ k)) := by
    have hh := adj.homEquiv_unit (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))
      (wcContSheaf (Limits.pullback D.f u) (ZMod (ℓ ^ k)))
      ((adj.homEquiv (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))
        (wcContSheaf (Limits.pullback D.f u) (ZMod (ℓ ^ k)))).symm
          (wcContPull (Limits.pullback.fst D.f u) (ZMod (ℓ ^ k))))
    rw [Equiv.apply_symm_apply] at hh
    exact hh.symm
  have h3 : x.comp (Abelian.Ext.mk₀ (wcContPull (Limits.pullback.fst D.f u) (ZMod (ℓ ^ k))))
      (add_zero j) = 0 := by
    have e1 : (Abelian.Ext.mk₀ (adj.unit.app
        (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀)))).comp
        ((Abelian.Ext.mapExactFunctor (wcProEtPush (Limits.pullback.fst D.f u))
          (Abelian.Ext.mapExactFunctor L x)).comp
          (Abelian.Ext.mk₀ ((wcProEtPush (Limits.pullback.fst D.f u)).map
            ((adj.homEquiv (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))
              (wcContSheaf (Limits.pullback D.f u) (ZMod (ℓ ^ k)))).symm
                (wcContPull (Limits.pullback.fst D.f u) (ZMod (ℓ ^ k)))))) (add_zero j))
        (zero_add j) = 0 := by
      rw [h2, Abelian.Ext.comp_zero]
    rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add j) (add_zero j) (show 0 + j + 0 = j by omega),
      ← hη, Abelian.Ext.comp_assoc _ _ _ (add_zero j) (add_zero 0) (show j + 0 + 0 = j by omega),
      Abelian.Ext.mk₀_comp_mk₀, hunit] at e1
    exact e1

  have hepi : Epi (wcContPull (Limits.pullback.fst D.f u) (ZMod (ℓ ^ k))) :=
    wc_contPull_zmod_pow_epi (Limits.pullback.fst D.f u) ℓ k
  have hSE : (ShortComplex.mk (Limits.kernel.ι (wcContPull (Limits.pullback.fst D.f u)
      (ZMod (ℓ ^ k)))) (wcContPull (Limits.pullback.fst D.f u) (ZMod (ℓ ^ k)))
      (Limits.kernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel _) inferInstance hepi
  obtain ⟨x', hx'⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hSE x h3

  rw [← hx', hvan j x', Abelian.Ext.zero_comp]

theorem wc_rat_pt_nbhd_res_injective (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (u : Spec (.of F'') ⟶ (wcP1Over F'').left) (hu : u ≫ (wcP1Over F'').hom = 𝟙 _)
    (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom u ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = u (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom u)
    (L : Sheaf (Scheme.ProEt.topology D.Yt.left) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology (Limits.pullback D.f u)) AddCommGrpCat.{u+1})
    [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L]
    (adj : L ⊣ wcProEtPush (Limits.pullback.fst D.f u))
    (θ : ∀ V : D.Yt.left.ProEt, L.obj (wcFreeSheaf D.Yt.left V) ≅
      wcFreeSheaf (Limits.pullback D.f u) ((wcProEtPullback (Limits.pullback.fst D.f u)).obj V))
    (hθ : ∀ {V V' : D.Yt.left.ProEt} (a : V ⟶ V'),
      L.map (wcFreeSheafMap D.Yt.left a) ≫ (θ V').hom =
        (θ V).hom ≫ wcFreeSheafMap (Limits.pullback D.f u)
          ((wcProEtPullback (Limits.pullback.fst D.f u)).map a))
    (j : ℕ) :
    Function.Injective (wcProEtRes (Limits.pullback.fst D.f u) L adj θ ℚ_[ℓ]
      ((wcProEtPullback D.f).obj V₀) j) :=
by
  haveI := D.proper
  haveI hpsep : IsSeparated (wcP1Over F'').hom := by
    show IsSeparated (Proj.toSpecZero _ ≫ Spec.map _)
    infer_instance
  haveI : QuasiCompact (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; infer_instance
  haveI : QuasiSeparated (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; infer_instance
  haveI : QuasiCompact D.f := QuasiCompact.of_comp D.f (wcP1Over F'').hom
  haveI : QuasiSeparated D.f := QuasiSeparated.of_comp D.f (wcP1Over F'').hom
  haveI : QuasiCompact (u ≫ (wcP1Over F'').hom) := by rw [hu]; infer_instance
  haveI : QuasiSeparated (u ≫ (wcP1Over F'').hom) := by rw [hu]; infer_instance
  haveI : QuasiCompact u := QuasiCompact.of_comp u (wcP1Over F'').hom
  haveI : QuasiSeparated u := QuasiSeparated.of_comp u (wcP1Over F'').hom
  haveI hV1 : CompactSpace V₀.left := QuasiCompact.compactSpace_of_compactSpace e.hom
  haveI hV2 : QuasiSeparatedSpace V₀.left := quasiSeparatedSpace_of_quasiSeparated e.hom
  haveI hiqc : QuasiCompact (Limits.pullback.fst D.f u) := by
    first
    | exact MorphismProperty.of_isPullback (P := @QuasiCompact)
        (IsPullback.of_hasPullback D.f u).flip (inferInstanceAs (QuasiCompact u))
    | infer_instance
  haveI hiqs : QuasiSeparated (Limits.pullback.fst D.f u) := by
    first
    | exact MorphismProperty.of_isPullback (P := @QuasiSeparated)
        (IsPullback.of_hasPullback D.f u).flip (inferInstanceAs (QuasiSeparated u))
    | infer_instance
  have hfst1 : QuasiCompact (Limits.pullback.fst V₀.hom D.f) := by
    first
    | exact MorphismProperty.of_isPullback (P := @QuasiCompact)
        (IsPullback.of_hasPullback V₀.hom D.f).flip (inferInstanceAs (QuasiCompact D.f))
    | infer_instance
  have hfst2 : QuasiSeparated (Limits.pullback.fst V₀.hom D.f) := by
    first
    | exact MorphismProperty.of_isPullback (P := @QuasiSeparated)
        (IsPullback.of_hasPullback V₀.hom D.f).flip (inferInstanceAs (QuasiSeparated D.f))
    | infer_instance
  have key : ∀ {X Y : Scheme.{u}} (g : X ⟶ Y), QuasiCompact g → QuasiSeparated g →
      CompactSpace Y → QuasiSeparatedSpace Y → CompactSpace X ∧ QuasiSeparatedSpace X :=
    fun g _ _ _ _ => ⟨QuasiCompact.compactSpace_of_compactSpace g,
      quasiSeparatedSpace_of_quasiSeparated g⟩
  obtain ⟨h1, h2⟩ := key (Limits.pullback.fst V₀.hom D.f) hfst1 hfst2 hV1 hV2
  haveI h1' : CompactSpace ((wcProEtPullback D.f).obj V₀).left := h1
  haveI h2' : QuasiSeparatedSpace ((wcProEtPullback D.f).obj V₀).left := h2
  have hfst3 : QuasiCompact
      (Limits.pullback.fst ((wcProEtPullback D.f).obj V₀).hom (Limits.pullback.fst D.f u)) := by
    first
    | exact MorphismProperty.of_isPullback (P := @QuasiCompact)
        (IsPullback.of_hasPullback ((wcProEtPullback D.f).obj V₀).hom
          (Limits.pullback.fst D.f u)).flip hiqc
    | infer_instance
  have hfst4 : QuasiSeparated
      (Limits.pullback.fst ((wcProEtPullback D.f).obj V₀).hom (Limits.pullback.fst D.f u)) := by
    first
    | exact MorphismProperty.of_isPullback (P := @QuasiSeparated)
        (IsPullback.of_hasPullback ((wcProEtPullback D.f).obj V₀).hom
          (Limits.pullback.fst D.f u)).flip hiqs
    | infer_instance
  obtain ⟨h3, h4⟩ := key
    (Limits.pullback.fst ((wcProEtPullback D.f).obj V₀).hom (Limits.pullback.fst D.f u))
    hfst3 hfst4 h1' h2'
  haveI h3' : CompactSpace ((wcProEtPullback (Limits.pullback.fst D.f u)).obj
      ((wcProEtPullback D.f).obj V₀)).left := h3
  haveI h4' : QuasiSeparatedSpace ((wcProEtPullback (Limits.pullback.fst D.f u)).obj
      ((wcProEtPullback D.f).obj V₀)).left := h4
  have hfin : ∀ j k : ℕ, Finite (Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀))
      (wcContSheaf D.Yt.left (ZMod (ℓ ^ k))) j) :=
    fun j k => wc_rat_pt_nbhd_zmod_finite F' F'' Y n D ℓ hℓ u hu V₀ A e ε hv hε j k
  have htor : ∀ j k : ℕ, Function.Injective (wcProEtRes (Limits.pullback.fst D.f u) L adj θ
      (ZMod (ℓ ^ k)) ((wcProEtPullback D.f).obj V₀) j) :=
    fun j k => wc_rat_pt_nbhd_torsion_res_injective F' F'' Y n D ℓ hℓ u hu V₀ A e ε hv hε
      L adj θ hθ j k
  exact wc_res_ladic_injective_of_torsion (Limits.pullback.fst D.f u) L adj θ ℓ
    ((wcProEtPullback D.f).obj V₀) hfin htor j

theorem wc_proet_pullback_openRestr_iso {X Y : Scheme.{u}} (g : X ⟶ Y) (O : Y.Opens) (V : Y.ProEt) :
    ∃ β : (wcProEtPullback g).obj (wcOpenRestr Y O V) ≅
        wcOpenRestr X (g ⁻¹ᵁ O) ((wcProEtPullback g).obj V),
      β.hom ≫ wcOpenRestrIncl X (g ⁻¹ᵁ O) ((wcProEtPullback g).obj V) =
        (wcProEtPullback g).map (wcOpenRestrIncl Y O V) :=
by
  have H := isPullback_morphismRestrict g O
  let p1 := Limits.pullback.fst O.ι V.hom
  let p2 := Limits.pullback.snd O.ι V.hom
  let w := p2 ≫ V.hom
  let a1 := Limits.pullback.fst w g
  let a2 := Limits.pullback.snd w g
  let q1 := Limits.pullback.fst V.hom g
  let q2 := Limits.pullback.snd V.hom g
  let r1 := Limits.pullback.fst (g ⁻¹ᵁ O).ι q2
  let r2 := Limits.pullback.snd (g ⁻¹ᵁ O).ι q2
  have cP : p1 ≫ O.ι = p2 ≫ V.hom := Limits.pullback.condition
  have cL : a1 ≫ w = a2 ≫ g := Limits.pullback.condition
  have cQ : q1 ≫ V.hom = q2 ≫ g := Limits.pullback.condition
  have cR : r1 ≫ (g ⁻¹ᵁ O).ι = r2 ≫ q2 := Limits.pullback.condition
  have cH : g ∣_ O ≫ O.ι = (g ⁻¹ᵁ O).ι ≫ g := morphismRestrict_ι g O
  have wm : (a1 ≫ p2) ≫ V.hom = a2 ≫ g := by rw [Category.assoc]; exact cL
  have wk : (a1 ≫ p1) ≫ O.ι = a2 ≫ g := by rw [Category.assoc, cP]; exact cL
  let m : Limits.pullback w g ⟶ Limits.pullback V.hom g := Limits.pullback.lift (a1 ≫ p2) a2 wm
  let k : Limits.pullback w g ⟶ (g ⁻¹ᵁ O : Scheme) := H.lift (a1 ≫ p1) a2 wk
  have km1 : k ≫ g ∣_ O = a1 ≫ p1 := H.lift_fst _ _ _
  have km2 : k ≫ (g ⁻¹ᵁ O).ι = a2 := H.lift_snd _ _ _
  have mq1 : m ≫ q1 = a1 ≫ p2 := Limits.pullback.lift_fst _ _ _
  have mq2 : m ≫ q2 = a2 := Limits.pullback.lift_snd _ _ _
  have wφ : k ≫ (g ⁻¹ᵁ O).ι = m ≫ q2 := by rw [km2, mq2]
  let φ : Limits.pullback w g ⟶ Limits.pullback (g ⁻¹ᵁ O).ι q2 := Limits.pullback.lift k m wφ
  have φr1 : φ ≫ r1 = k := Limits.pullback.lift_fst _ _ _
  have φr2 : φ ≫ r2 = m := Limits.pullback.lift_snd _ _ _
  have wn : (r1 ≫ g ∣_ O) ≫ O.ι = (r2 ≫ q1) ≫ V.hom := by
    rw [Category.assoc, cH, ← Category.assoc, cR, Category.assoc, Category.assoc, cQ]
  let n : Limits.pullback (g ⁻¹ᵁ O).ι q2 ⟶ Limits.pullback O.ι V.hom :=
    Limits.pullback.lift (r1 ≫ g ∣_ O) (r2 ≫ q1) wn
  have np1 : n ≫ p1 = r1 ≫ g ∣_ O := Limits.pullback.lift_fst _ _ _
  have np2 : n ≫ p2 = r2 ≫ q1 := Limits.pullback.lift_snd _ _ _
  have wψ : n ≫ w = (r2 ≫ q2) ≫ g := by
    show n ≫ p2 ≫ V.hom = _
    rw [← Category.assoc, np2, Category.assoc, cQ, Category.assoc]
  let ψ : Limits.pullback (g ⁻¹ᵁ O).ι q2 ⟶ Limits.pullback w g :=
    Limits.pullback.lift n (r2 ≫ q2) wψ
  have ψa1 : ψ ≫ a1 = n := Limits.pullback.lift_fst _ _ _
  have ψa2 : ψ ≫ a2 = r2 ≫ q2 := Limits.pullback.lift_snd _ _ _
  have h1 : φ ≫ ψ = 𝟙 _ := by
    apply Limits.pullback.hom_ext
    · show (φ ≫ ψ) ≫ a1 = 𝟙 _ ≫ a1
      rw [Category.assoc, ψa1, Category.id_comp]
      apply Limits.pullback.hom_ext
      · show (φ ≫ n) ≫ p1 = a1 ≫ p1
        rw [Category.assoc, np1, ← Category.assoc, φr1, km1]
      · show (φ ≫ n) ≫ p2 = a1 ≫ p2
        rw [Category.assoc, np2, ← Category.assoc, φr2, mq1]
    · show (φ ≫ ψ) ≫ a2 = 𝟙 _ ≫ a2
      rw [Category.assoc, ψa2, ← Category.assoc, φr2, mq2, Category.id_comp]
  have h2 : ψ ≫ φ = 𝟙 _ := by
    apply Limits.pullback.hom_ext
    · show (ψ ≫ φ) ≫ r1 = 𝟙 _ ≫ r1
      rw [Category.assoc, φr1, Category.id_comp]
      apply H.hom_ext
      · rw [Category.assoc, km1, ← Category.assoc, ψa1, np1]
      · rw [Category.assoc, km2, ψa2, cR]
    · show (ψ ≫ φ) ≫ r2 = 𝟙 _ ≫ r2
      rw [Category.assoc, φr2, Category.id_comp]
      apply Limits.pullback.hom_ext
      · show (ψ ≫ m) ≫ q1 = r2 ≫ q1
        rw [Category.assoc, mq1, ← Category.assoc, ψa1, np2]
      · show (ψ ≫ m) ≫ q2 = r2 ≫ q2
        rw [Category.assoc, mq2, ψa2]
  let e : Limits.pullback w g ≅ Limits.pullback (g ⁻¹ᵁ O).ι q2 := ⟨φ, ψ, h1, h2⟩
  have we : e.hom ≫ (r2 ≫ q2) = a2 := by
    show φ ≫ r2 ≫ q2 = a2
    rw [← Category.assoc, φr2, mq2]
  refine ⟨MorphismProperty.Over.isoMk (A := (wcProEtPullback g).obj (wcOpenRestr Y O V))
    (B := wcOpenRestr X (g ⁻¹ᵁ O) ((wcProEtPullback g).obj V)) e we, ?_⟩
  apply MorphismProperty.Over.Hom.ext
  change φ ≫ r2 = _
  rw [φr2]
  first
    | rfl
    | (apply Limits.pullback.hom_ext
       · rw [mq1]
         first
           | exact (Limits.pullback.lift_fst _ _ _).symm
           | (erw [MorphismProperty.Over.pullback_map_left, Limits.pullback.lift_fst]; rfl)
       · rw [mq2]
         first
           | exact (Limits.pullback.lift_snd _ _ _).symm
           | (erw [MorphismProperty.Over.pullback_map_left, Limits.pullback.lift_snd]))

theorem wc_crit_nbhd_generic_geom_pt (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (i : Fin D.m) (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F'')) :
    ∃ (Vη : (wcP1Over F'').left.ProEt) (a : Vη ⟶ V₀) (Ω : Type u) (_ : Field Ω)
      (_ : IsSepClosed Ω) (_ : HenselianLocalRing Ω) (_ : IsSepClosed (IsLocalRing.ResidueField Ω))
      (eΩ : Vη.left ≅ Spec (.of Ω)) (c' : Spec (.of Ω) ⟶ Spec (.of A)),
      WeaklyEtale c' ∧ eΩ.inv ≫ a.left ≫ e.hom = c' ∧
      ∀ (v : Vη.left) (j : Fin D.m), Vη.hom v ≠ D.S j (IsLocalRing.closedPoint F'') :=
by
  classical

  have hsepWE : ∀ (K L : Type u) [Field K] [Field L] [Algebra K L] [Algebra.IsSeparable K L],
      WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap K L))) := by
    intro K L _ _ _ _
    have hsep : ∀ s : L, ∃ c : TensorProduct K L L,
        Algebra.TensorProduct.lmul' K c = 1 ∧
          c * (TensorProduct.tmul K (1 : L) s - TensorProduct.tmul K s 1) = 0 := by
      intro s
      haveI : FiniteDimensional K (IntermediateField.adjoin K {s}) :=
        IntermediateField.adjoin.finiteDimensional (Algebra.IsSeparable.isIntegral K s)
      haveI : Algebra.IsSeparable K (IntermediateField.adjoin K {s}) :=
        Algebra.isSeparable_tower_bot_of_isSeparable K _ L
      haveI : Algebra.FormallyUnramified K (IntermediateField.adjoin K {s}) :=
        Algebra.FormallyUnramified.of_isSeparable K _
      haveI : Algebra.FiniteType K (IntermediateField.adjoin K {s}) := Module.Finite.finiteType _
      haveI : Algebra.EssFiniteType K (IntermediateField.adjoin K {s}) :=
        Algebra.EssFiniteType.of_finiteType K _
      obtain ⟨t, ht1, ht2⟩ :=
        (Algebra.FormallyUnramified.iff_exists_tensorProduct (R := K)
          (S := IntermediateField.adjoin K {s})).mp inferInstance
      let φ := Algebra.TensorProduct.map (IntermediateField.adjoin K {s}).val
        (IntermediateField.adjoin K {s}).val
      have hμ : ∀ x : TensorProduct K (IntermediateField.adjoin K {s}) (IntermediateField.adjoin K {s}),
          Algebra.TensorProduct.lmul' K (φ x) =
            (IntermediateField.adjoin K {s}).val (Algebra.TensorProduct.lmul' K x) := by
        intro x
        induction x using TensorProduct.induction_on with
        | zero => simp
        | tmul a b => simp [φ]
        | add a b ha hb => simp only [map_add, ha, hb]
      let g : IntermediateField.adjoin K {s} := ⟨s, IntermediateField.mem_adjoin_simple_self K s⟩
      refine ⟨φ t, ?_, ?_⟩
      · rw [hμ, ht2, map_one]
      · have hg : φ (TensorProduct.tmul K 1 g - TensorProduct.tmul K g 1) =
            TensorProduct.tmul K (1 : L) s - TensorProduct.tmul K s 1 := by
          simp [φ, g]
        rw [← hg, ← map_mul, mul_comm, ht1 g, map_zero]
    have hflatμ : RingHom.Flat
        (Algebra.TensorProduct.lmul' K : TensorProduct K L L →ₐ[K] L).toRingHom := by
      let μ := (Algebra.TensorProduct.lmul' K : TensorProduct K L L →ₐ[K] L)
      letI : Algebra (TensorProduct K L L) L := μ.toRingHom.toAlgebra
      let M : Submonoid (TensorProduct K L L) :=
        Submonoid.comap μ.toRingHom (IsUnit.submonoid L)
      have hM : ∀ y, y ∈ M ↔ IsUnit (μ y) := fun y => by
        rw [Submonoid.mem_comap, IsUnit.mem_submonoid_iff]; rfl
      haveI : IsLocalization M L := by
        refine ⟨?_, ?_, ?_⟩
        · intro y
          exact (hM y.1).mp y.2
        · intro z
          refine ⟨⟨TensorProduct.tmul K z 1, 1⟩, ?_⟩
          show z * μ 1 = μ (TensorProduct.tmul K z 1)
          rw [map_one, Algebra.TensorProduct.lmul'_apply_tmul, mul_one]
        · intro x y hxy
          change μ x = μ y at hxy
          have hker : x - y ∈ Ideal.span (Set.range fun s : L =>
              TensorProduct.tmul K (1 : L) s - TensorProduct.tmul K s 1) := by
            rw [KaehlerDifferential.span_range_eq_ideal, KaehlerDifferential.ideal, RingHom.mem_ker,
              map_sub]
            exact sub_eq_zero.mpr hxy
          have key : ∀ a ∈ Ideal.span (Set.range fun s : L =>
              TensorProduct.tmul K (1 : L) s - TensorProduct.tmul K s 1),
              ∃ c ∈ M, c * a = 0 := by
            intro a ha
            induction ha using Submodule.span_induction with
            | mem a ha =>
              obtain ⟨s, rfl⟩ := ha
              obtain ⟨c, hc1, hc2⟩ := hsep s
              refine ⟨c, (hM c).mpr ?_, hc2⟩
              show IsUnit (Algebra.TensorProduct.lmul' K c)
              rw [hc1]; exact isUnit_one
            | zero => exact ⟨1, M.one_mem, mul_zero 1⟩
            | add a b _ _ ha hb =>
              obtain ⟨c1, h1, e1⟩ := ha
              obtain ⟨c2, h2, e2⟩ := hb
              exact ⟨c1 * c2, M.mul_mem h1 h2, by linear_combination c2 * e1 + c1 * e2⟩
            | smul r a _ ha =>
              obtain ⟨c, h, e⟩ := ha
              exact ⟨c, h, by rw [smul_eq_mul, mul_left_comm, e, mul_zero]⟩
          obtain ⟨c, hc, e⟩ := key _ hker
          exact ⟨⟨c, hc⟩, by rw [mul_sub] at e; exact sub_eq_zero.mp e⟩
      exact IsLocalization.flat L M
    have hf : Flat (Spec.map (CommRingCat.ofHom (algebraMap K L))) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat)]
      exact RingHom.flat_algebraMap_iff.mpr inferInstance
    have hd : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap K L)))) := by
      rw [diagonal_SpecMap]
      haveI : Flat (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' K :
          TensorProduct K L L →ₐ[K] L).toRingHom)) :=
        HasRingHomProperty.Spec_iff.mpr hflatμ
      infer_instance
    exact ⟨hf, hd⟩

  have hk : WeaklyEtale (e.inv ≫ V₀.hom) := by
    haveI : WeaklyEtale V₀.hom := V₀.prop
    infer_instance
  haveI : SmoothOfRelativeDimension 1 (wcProjKStr F'' 1) := wc_proj_space_smooth F'' 1
  haveI hAdom : IsDomain A := by
    first
      | exact wc_strictHensel_weaklyEtale_smooth_isDomain F'' (wcProjKStr F'' 1) 1
          (CommRingCat.of A) (e.inv ≫ V₀.hom) hk
      | exact @wc_strictHensel_weaklyEtale_smooth_isDomain F'' _ _ (wcProjKStr F'' 1) 1 _
          (CommRingCat.of A) ‹HenselianLocalRing A› ‹IsSepClosed (IsLocalRing.ResidueField A)›
          (e.inv ≫ V₀.hom) hk

  have hres : IsSepClosed (IsLocalRing.ResidueField (SeparableClosure (FractionRing A))) := by
    have hbij : Function.Bijective (IsLocalRing.residue (SeparableClosure (FractionRing A))) :=
      ⟨RingHom.injective _, IsLocalRing.residue_surjective⟩
    exact wc_henselian_sepClosed_transfer.2 _ _ (RingEquiv.ofBijective _ hbij)
      (SeparableClosure.isSepClosed _)

  haveI hKΩ : WeaklyEtale (Spec.map (CommRingCat.ofHom
      (algebraMap (FractionRing A) (SeparableClosure (FractionRing A))))) :=
    hsepWE (FractionRing A) (SeparableClosure (FractionRing A))
  haveI hAK : WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A)))) :=
    wc_lfi_specMap_weaklyEtale A (FractionRing A)
      (wc_localization_weaklyEtale A (FractionRing A) (nonZeroDivisors A))
  let c' : Spec (.of (SeparableClosure (FractionRing A))) ⟶ Spec (.of A) :=
    Spec.map (CommRingCat.ofHom (algebraMap (FractionRing A) (SeparableClosure (FractionRing A)))) ≫
      Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A)))
  haveI hc' : WeaklyEtale c' := by dsimp only [c']; infer_instance

  have hW : WeaklyEtale (c' ≫ e.inv ≫ V₀.hom) := by
    haveI : WeaklyEtale V₀.hom := V₀.prop
    infer_instance
  let Vη : (wcP1Over F'').left.ProEt := MorphismProperty.Over.mk ⊤ (c' ≫ e.inv ≫ V₀.hom) hW
  let a : Vη ⟶ V₀ := MorphismProperty.Over.homMk (c' ≫ e.inv) (Category.assoc _ _ _) trivial
  refine ⟨Vη, a, SeparableClosure (FractionRing A), inferInstance, SeparableClosure.isSepClosed _,
    Field.henselian _, hres, Iso.refl _, c', hc', ?_, ?_⟩
  · show 𝟙 _ ≫ (c' ≫ e.inv) ≫ e.hom = c'
    simp
  · intro v j

    let w : PrimeSpectrum (SeparableClosure (FractionRing A)) := v
    let ξ : PrimeSpectrum A := c' v
    have hw0 : w.asIdeal = ⊥ := Ideal.eq_bot_of_prime _
    have hξeq : ξ.asIdeal = Ideal.comap (algebraMap A (FractionRing A))
        (Ideal.comap (algebraMap (FractionRing A) (SeparableClosure (FractionRing A))) w.asIdeal) := by
      first
        | rfl
        | (simp only [ξ, c', w, Scheme.Hom.comp_apply, Spec.map_base]; rfl)
    have hbot : ξ.asIdeal = ⊥ := by
      rw [hξeq, hw0, Ideal.comap_bot_of_injective _
          (RingHom.injective (algebraMap (FractionRing A) (SeparableClosure (FractionRing A)))),
        Ideal.comap_bot_of_injective _ (IsFractionRing.injective A (FractionRing A))]
    have hξ : ∀ y : PrimeSpectrum A, ξ ⤳ y := fun y =>
      (PrimeSpectrum.le_iff_specializes ξ y).mp (by
        first
          | (show ξ.asIdeal ≤ y.asIdeal; rw [hbot]; exact bot_le)
          | (rw [← PrimeSpectrum.asIdeal_le_asIdeal, hbot]; exact bot_le))

    haveI : IrreducibleSpace (wcP1Over F'').left := wc_proj_space_irreducible F'' 1
    haveI : IrreducibleSpace ((Functor.fromPUnit (wcP1Over F'').left).obj V₀.right) :=
      wc_proj_space_irreducible F'' 1
    haveI : Flat (e.inv ≫ V₀.hom) := hk.flat
    have hgen : ∀ x : (wcP1Over F'').left, (e.inv ≫ V₀.hom) (c' v) ⤳ x := by
      intro x
      obtain ⟨y', hy', hky'⟩ := Flat.generalizingMap (e.inv ≫ V₀.hom)
        (genericPoint_specializes ((e.inv ≫ V₀.hom) (c' v)))
      have h1 : (e.inv ≫ V₀.hom) (c' v) ⤳ (e.inv ≫ V₀.hom) y' :=
        (hξ y').map (Scheme.Hom.continuous _)
      rw [hky'] at h1
      exact h1.trans (genericPoint_specializes x)
    intro hEq0
    have hEq : (e.inv ≫ V₀.hom) (c' v) = D.S j (IsLocalRing.closedPoint F'') := by
      first
        | exact hEq0
        | (rw [← Scheme.Hom.comp_apply]; exact hEq0)
        | (refine Eq.trans ?_ hEq0; rw [← Scheme.Hom.comp_apply]; rfl)
    rw [hEq] at hgen
    have hcl : IsClosedImmersion (D.S j) :=
      isClosedImmersion_of_comp_eq_id (wcP1Over F'').hom (D.S j) (D.hS j)
    have hrange : IsClosed (Set.range (D.S j)) := by
      first
        | exact (D.S j).isClosedEmbedding.isClosed_range
        | exact (IsClosedImmersion.isClosedEmbedding (D.S j)).isClosed_range
        | exact (D.S j).isClosedMap.isClosed_range
    have hrange' : Set.range (D.S j) = {D.S j (IsLocalRing.closedPoint F'')} := by
      ext x
      constructor
      · rintro ⟨y, rfl⟩
        rw [Set.mem_singleton_iff, Subsingleton.elim y (IsLocalRing.closedPoint F'')]
      · intro hx
        rw [Set.mem_singleton_iff] at hx
        exact ⟨_, hx.symm⟩
    rw [hrange'] at hrange
    have hall : ∀ x : (wcP1Over F'').left, x = D.S j (IsLocalRing.closedPoint F'') := by
      intro x
      have hx := specializes_iff_mem_closure.mp (hgen x)
      rw [hrange.closure_eq] at hx
      exact hx
    obtain ⟨jj, hjj⟩ := wc_polynomial_open_immersion_projK_one F''
    have hX0 : (Polynomial.X : Polynomial F'') ≠ 0 := Polynomial.X_ne_zero
    let q0 : PrimeSpectrum (Polynomial F'') := ⟨⊥, by
      first
        | exact Ideal.isPrime_bot
        | exact inferInstance
        | exact Ideal.bot_isPrime⟩
    let q1 : PrimeSpectrum (Polynomial F'') :=
      ⟨Ideal.span {Polynomial.X}, (Ideal.span_singleton_prime hX0).mpr Polynomial.prime_X⟩
    have hne : q0 ≠ q1 := by
      intro h
      have h2 := congrArg PrimeSpectrum.asIdeal h
      have hmem : (Polynomial.X : Polynomial F'') ∈ q0.asIdeal := by
        rw [h2]; exact Ideal.mem_span_singleton_self _
      exact hX0 ((Submodule.mem_bot _).mp hmem)
    have hinj : Function.Injective jj := by
      first
        | exact jj.isOpenEmbedding.injective
        | exact (IsOpenImmersion.isOpenEmbedding jj).injective
        | exact jj.injective
    apply hne
    apply hinj
    exact (hall (jj q0)).trans (hall (jj q1)).symm

theorem wc_crit_nbhd_generic_fibre_pullback (F' F'' : Type u) [Field F'] [Field F'']
    [Finite F''] [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ)
    (D : wcLefschetzDatum F' F'' Y n) (i : Fin D.m) (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] (e : V₀.left ≅ Spec (.of A))
    (Vη : (wcP1Over F'').left.ProEt) (a : Vη ⟶ V₀) (Ω : Type u) [Field Ω]
    (eΩ : Vη.left ≅ Spec (.of Ω)) (c' : Spec (.of Ω) ⟶ Spec (.of A))
    (hc' : eΩ.inv ≫ a.left ≫ e.hom = c')
    (havoid : ∀ v : Vη.left, Vη.hom v ≠ D.S i (IsLocalRing.closedPoint F'')) :
    ∃ ao : (wcProEtPullback D.f).obj Vη ⟶
        wcOpenRestr D.Yt.left ⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ,
          isOpen_compl_iff.mpr isClosed_closure⟩ ((wcProEtPullback D.f).obj V₀),
      ao ≫ wcOpenRestrIncl D.Yt.left ⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ,
          isOpen_compl_iff.mpr isClosed_closure⟩ ((wcProEtPullback D.f).obj V₀) =
        (wcProEtPullback D.f).map a ∧
      IsPullback ao.left (Limits.pullback.fst Vη.hom D.f ≫ eΩ.hom)
        (Limits.pullback.snd (Scheme.Opens.ι (⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ,
            isOpen_compl_iff.mpr isClosed_closure⟩ : D.Yt.left.Opens))
            ((wcProEtPullback D.f).obj V₀).hom ≫ Limits.pullback.fst V₀.hom D.f ≫ e.hom) c' ∧
      CompactSpace ((wcProEtPullback D.f).obj Vη).left ∧
      QuasiSeparatedSpace ((wcProEtPullback D.f).obj Vη).left :=
by
  classical
  haveI hpsep : IsSeparated (wcP1Over F'').hom := by
    show IsSeparated (Proj.toSpecZero _ ≫ Spec.map _)
    infer_instance

  have hSclosed : IsClosed ({D.S i (IsLocalRing.closedPoint F'')} : Set (wcP1Over F'').left) := by
    haveI : IsClosedImmersion (D.S i ≫ (wcP1Over F'').hom) := by rw [D.hS i]; infer_instance
    haveI : IsClosedImmersion (D.S i) := IsClosedImmersion.of_comp (D.S i) (wcP1Over F'').hom
    have h1 : IsClosed (Set.range (D.S i)) := (D.S i).isClosedEmbedding.isClosed_range
    have h2 : Set.range (D.S i) = {D.S i (IsLocalRing.closedPoint F'')} := by
      ext x
      constructor
      · rintro ⟨y, rfl⟩
        haveI : Subsingleton (Spec (.of F'')) := by
          show Subsingleton (PrimeSpectrum F''); infer_instance
        rw [Subsingleton.elim y (IsLocalRing.closedPoint F'')]
        rfl
      · rintro rfl
        exact ⟨_, rfl⟩
    rw [← h2]
    exact h1

  have hspec : ∀ y' : D.Yt.left, y' ∈ closure {D.xs i (IsLocalRing.closedPoint F'')} →
      D.f y' = D.S i (IsLocalRing.closedPoint F'') := by
    intro y' hy
    have h1 : D.xs i (IsLocalRing.closedPoint F'') ⤳ y' := specializes_iff_mem_closure.mpr hy
    have h2 := h1.map D.f.continuous
    have h3 : D.f (D.xs i (IsLocalRing.closedPoint F'')) = D.S i (IsLocalRing.closedPoint F'') :=
      (Scheme.Hom.comp_apply (D.xs i) D.f _).symm.trans
        (congrArg (fun g : Spec (.of F'') ⟶ (wcP1Over F'').left => g (IsLocalRing.closedPoint F''))
          (D.hxs i))
    rw [h3] at h2
    exact Set.mem_singleton_iff.mp (h2.mem_closed hSclosed (Set.mem_singleton _))

  have pbcond : ∀ {X Y P : Scheme.{u}} (f : X ⟶ P) (g : Y ⟶ P) (z : ↥(Limits.pullback f g)),
      f (Limits.pullback.fst f g z) = g (Limits.pullback.snd f g z) := fun f g z => by
    rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
  have oisnd : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Z) (g : Y ⟶ Z) [IsOpenImmersion f],
      IsOpenImmersion (Limits.pullback.snd f g) := fun f g _ => inferInstance
  haveI hj := oisnd (Scheme.Opens.ι (⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ,
      isOpen_compl_iff.mpr isClosed_closure⟩ : D.Yt.left.Opens)) ((wcProEtPullback D.f).obj V₀).hom

  have hmW : ((wcProEtPullback D.f).map a).left ≫ ((wcProEtPullback D.f).obj V₀).hom =
      Limits.pullback.snd Vη.hom D.f := MorphismProperty.Over.w ((wcProEtPullback D.f).map a)
  have hrange : Set.range ((wcProEtPullback D.f).map a).left ⊆
      Set.range (Limits.pullback.snd (Scheme.Opens.ι (⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ,
            isOpen_compl_iff.mpr isClosed_closure⟩ : D.Yt.left.Opens))
            ((wcProEtPullback D.f).obj V₀).hom) := by
    rw [IsOpenImmersion.range_pullbackSnd, Scheme.Opens.opensRange_ι]
    rintro _ ⟨y, rfl⟩
    show ((wcProEtPullback D.f).obj V₀).hom (((wcProEtPullback D.f).map a).left y) ∉
      closure {D.xs i (IsLocalRing.closedPoint F'')}
    rw [← Scheme.Hom.comp_apply, hmW]
    intro hy
    exact havoid (Limits.pullback.fst Vη.hom D.f y) ((pbcond Vη.hom D.f y).trans (hspec _ hy))

  have liftEx : ∀ {X U Y : Scheme.{u}} (f : X ⟶ Y) (g : U ⟶ Y) (_ : IsOpenImmersion g)
      (H : Set.range f ⊆ Set.range g),
      ∃ l : X ⟶ U, l ≫ g = f ∧ IsPullback l (𝟙 X) g f := fun f g _ H =>
    ⟨IsOpenImmersion.lift g f H, IsOpenImmersion.lift_fac g f H,
      IsOpenImmersion.isPullback_lift_id f g H⟩
  obtain ⟨l, hfac, hA⟩ := liftEx ((wcProEtPullback D.f).map a).left
    (Limits.pullback.snd (Scheme.Opens.ι
      (⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ,
        isOpen_compl_iff.mpr isClosed_closure⟩ : D.Yt.left.Opens))
      ((wcProEtPullback D.f).obj V₀).hom) hj hrange
  refine ⟨MorphismProperty.Over.homMk l (by
        show _ ≫ (Limits.pullback.snd _ _ ≫ ((wcProEtPullback D.f).obj V₀).hom) = _
        rw [← Category.assoc, hfac, hmW]
        rfl) trivial, ?_, ?_, ?_⟩
  · apply MorphismProperty.Over.Hom.ext
    exact hfac
  ·
    have hcomm : ((wcProEtPullback D.f).map a).left ≫ Limits.pullback.fst V₀.hom D.f =
        Limits.pullback.fst Vη.hom D.f ≫ a.left :=
      Limits.pullback.lift_fst _ _ _
    have hout : IsPullback (((wcProEtPullback D.f).map a).left ≫ ((wcProEtPullback D.f).obj V₀).hom)
        (Limits.pullback.fst Vη.hom D.f) D.f (a.left ≫ V₀.hom) := by
      rw [hmW, MorphismProperty.Over.w a]
      exact (IsPullback.of_hasPullback Vη.hom D.f).flip
    have hright : IsPullback ((wcProEtPullback D.f).obj V₀).hom (Limits.pullback.fst V₀.hom D.f)
        D.f V₀.hom := (IsPullback.of_hasPullback V₀.hom D.f).flip
    have hB := IsPullback.of_right hout hcomm hright
    have hC : IsPullback a.left eΩ.hom e.hom c' :=
      IsPullback.of_vert_isIso ⟨by rw [← hc', Iso.hom_inv_id_assoc]⟩
    have h := hA.paste_vert (hB.paste_vert hC)
    rw [Category.id_comp] at h
    exact h
  ·
    haveI := D.proper
    haveI : QuasiCompact (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; infer_instance
    haveI : QuasiSeparated (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; infer_instance
    haveI : QuasiCompact D.f := QuasiCompact.of_comp D.f (wcP1Over F'').hom
    haveI : QuasiSeparated D.f := QuasiSeparated.of_comp D.f (wcP1Over F'').hom
    haveI hV1 : CompactSpace Vη.left := QuasiCompact.compactSpace_of_compactSpace eΩ.hom
    haveI hV2 : QuasiSeparatedSpace Vη.left := quasiSeparatedSpace_of_quasiSeparated eΩ.hom
    have hfst1 : QuasiCompact (Limits.pullback.fst Vη.hom D.f) := by
      first
      | exact MorphismProperty.pullback_fst (P := @QuasiCompact) _ _ (inferInstanceAs (QuasiCompact D.f))
      | exact MorphismProperty.IsStableUnderBaseChange.fst _ _ (inferInstanceAs (QuasiCompact D.f))
      | infer_instance
    have hfst2 : QuasiSeparated (Limits.pullback.fst Vη.hom D.f) := by
      first
      | exact MorphismProperty.pullback_fst (P := @QuasiSeparated) _ _
          (inferInstanceAs (QuasiSeparated D.f))
      | exact MorphismProperty.IsStableUnderBaseChange.fst _ _ (inferInstanceAs (QuasiSeparated D.f))
      | infer_instance
    have key : ∀ {X Y : Scheme.{u}} (g : X ⟶ Y), QuasiCompact g → QuasiSeparated g →
        CompactSpace Y → QuasiSeparatedSpace Y → CompactSpace X ∧ QuasiSeparatedSpace X :=
      fun g _ _ _ _ => ⟨QuasiCompact.compactSpace_of_compactSpace g,
        quasiSeparatedSpace_of_quasiSeparated g⟩
    obtain ⟨h1, h2⟩ := key (Limits.pullback.fst Vη.hom D.f) hfst1 hfst2 hV1 hV2
    exact ⟨h1, h2⟩

theorem wc_crit_nbhd_punct_smooth_qcqs (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (i : Fin D.m) (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F'')) :
    Smooth (Limits.pullback.snd (Scheme.Opens.ι (⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ,
          isOpen_compl_iff.mpr isClosed_closure⟩ : D.Yt.left.Opens))
          ((wcProEtPullback D.f).obj V₀).hom ≫ Limits.pullback.fst V₀.hom D.f ≫ e.hom) ∧
    CompactSpace (wcOpenRestr D.Yt.left ⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ,
          isOpen_compl_iff.mpr isClosed_closure⟩ ((wcProEtPullback D.f).obj V₀)).left ∧
    QuasiSeparatedSpace (wcOpenRestr D.Yt.left ⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ,
          isOpen_compl_iff.mpr isClosed_closure⟩ ((wcProEtPullback D.f).obj V₀)).left :=
by
  classical

  have hqc : ∀ (O : D.Yt.left.Opens),
      CompactSpace (wcOpenRestr D.Yt.left O ((wcProEtPullback D.f).obj V₀)).left ∧
      QuasiSeparatedSpace (wcOpenRestr D.Yt.left O ((wcProEtPullback D.f).obj V₀)).left := by
    intro O
    haveI := D.proper
    haveI hpsep : IsSeparated (wcP1Over F'').hom := by
      show IsSeparated (Proj.toSpecZero _ ≫ Spec.map _)
      infer_instance
    haveI : QuasiCompact (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; infer_instance
    haveI : QuasiSeparated (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; infer_instance
    haveI : QuasiCompact D.f := QuasiCompact.of_comp D.f (wcP1Over F'').hom
    haveI : QuasiSeparated D.f := QuasiSeparated.of_comp D.f (wcP1Over F'').hom
    haveI hV1 : CompactSpace V₀.left := QuasiCompact.compactSpace_of_compactSpace e.hom
    haveI hV2 : QuasiSeparatedSpace V₀.left := quasiSeparatedSpace_of_quasiSeparated e.hom
    haveI : CompactSpace ((𝟭 Scheme).obj V₀.left) := hV1
    haveI : QuasiSeparatedSpace ((𝟭 Scheme).obj V₀.left) := hV2
    have hfst1 : QuasiCompact (Limits.pullback.fst V₀.hom D.f) := by
      first
      | exact MorphismProperty.pullback_fst (P := @QuasiCompact) _ _ (inferInstanceAs (QuasiCompact D.f))
      | exact MorphismProperty.IsStableUnderBaseChange.fst _ _ (inferInstanceAs (QuasiCompact D.f))
      | infer_instance
    have hfst2 : QuasiSeparated (Limits.pullback.fst V₀.hom D.f) := by
      first
      | exact MorphismProperty.pullback_fst (P := @QuasiSeparated) _ _
          (inferInstanceAs (QuasiSeparated D.f))
      | exact MorphismProperty.IsStableUnderBaseChange.fst _ _ (inferInstanceAs (QuasiSeparated D.f))
      | infer_instance
    have key : ∀ {X Y : Scheme.{u}} (g : X ⟶ Y), QuasiCompact g → QuasiSeparated g →
        CompactSpace Y → QuasiSeparatedSpace Y → CompactSpace X ∧ QuasiSeparatedSpace X :=
      fun g _ _ _ _ => ⟨QuasiCompact.compactSpace_of_compactSpace g,
        quasiSeparatedSpace_of_quasiSeparated g⟩
    obtain ⟨h1, h2⟩ := key (Limits.pullback.fst V₀.hom D.f) hfst1 hfst2 hV1 hV2
    have h1' : CompactSpace ((wcProEtPullback D.f).obj V₀).left := h1
    have h2' : QuasiSeparatedSpace ((wcProEtPullback D.f).obj V₀).left := h2
    haveI hln : IsLocallyNoetherian D.Yt.left := LocallyOfFiniteType.isLocallyNoetherian D.Yt.hom
    have hOqc : QuasiCompact O.ι := inferInstance
    have hj1 : QuasiCompact (Limits.pullback.snd O.ι ((wcProEtPullback D.f).obj V₀).hom) := by
      first
      | exact MorphismProperty.pullback_snd (P := @QuasiCompact) _ _ hOqc
      | infer_instance
    have hj2 : QuasiSeparated (Limits.pullback.snd O.ι ((wcProEtPullback D.f).obj V₀).hom) :=
      inferInstance
    exact key (Limits.pullback.snd O.ι ((wcProEtPullback D.f).obj V₀).hom) hj1 hj2 h1' h2'

  have hsm : ∀ (O : D.Yt.left.Opens),
      (∀ (w : ↥(Limits.pullback O.ι (Limits.pullback.snd V₀.hom D.f))) (k : Fin D.m),
        Limits.pullback.snd V₀.hom D.f (Limits.pullback.snd O.ι (Limits.pullback.snd V₀.hom D.f) w)
          ≠ D.xs k (IsLocalRing.closedPoint F'')) →
      Smooth (Limits.pullback.snd O.ι (Limits.pullback.snd V₀.hom D.f) ≫
        Limits.pullback.fst V₀.hom D.f ≫ e.hom) := by
    intro O hO
    haveI : IsZariskiLocalAtSource @Smooth :=
      HasRingHomProperty.instIsZariskiLocalAtSource (P := @Smooth)
    have s2 : ∀ (U : D.Yt.left.Opens), Smooth (U.ι ≫ D.f) →
        Smooth ((Limits.pullback.snd V₀.hom D.f ⁻¹ᵁ U).ι ≫ Limits.pullback.fst V₀.hom D.f) := by
      intro U hU
      have hsq := IsPullback.paste_vert
        (isPullback_morphismRestrict (Limits.pullback.snd V₀.hom D.f) U)
        (IsPullback.of_hasPullback V₀.hom D.f).flip
      exact MorphismProperty.of_isPullback (P := @Smooth) hsq hU
    choose U hyU hU using fun w => D.smooth_off _ (hO w)
    have hcov : ⨆ w, Limits.pullback.snd O.ι (Limits.pullback.snd V₀.hom D.f) ⁻¹ᵁ
        (Limits.pullback.snd V₀.hom D.f ⁻¹ᵁ U w) = ⊤ := by
      rw [eq_top_iff]
      intro z _
      rw [TopologicalSpace.Opens.mem_iSup]
      exact ⟨z, hyU z⟩
    refine IsZariskiLocalAtSource.of_iSup_eq_top (P := @Smooth) _ hcov (fun w => ?_)
    have e1 : (Limits.pullback.snd O.ι (Limits.pullback.snd V₀.hom D.f) ⁻¹ᵁ
        (Limits.pullback.snd V₀.hom D.f ⁻¹ᵁ U w)).ι ≫
          Limits.pullback.snd O.ι (Limits.pullback.snd V₀.hom D.f) ≫
          Limits.pullback.fst V₀.hom D.f ≫ e.hom =
        (Limits.pullback.snd O.ι (Limits.pullback.snd V₀.hom D.f) ∣_
          (Limits.pullback.snd V₀.hom D.f ⁻¹ᵁ U w)) ≫
          (((Limits.pullback.snd V₀.hom D.f ⁻¹ᵁ U w).ι ≫ Limits.pullback.fst V₀.hom D.f) ≫
            e.hom) := by
      rw [← Category.assoc, ← morphismRestrict_ι, Category.assoc, Category.assoc]
    rw [e1]
    have hA := s2 (U w) (hU w)
    have hB : Smooth (((Limits.pullback.snd V₀.hom D.f ⁻¹ᵁ U w).ι ≫
        Limits.pullback.fst V₀.hom D.f) ≫ e.hom) := by
      first
      | exact (MorphismProperty.cancel_right_of_respectsIso (@Smooth) _ e.hom).mpr hA
      | (haveI := hA; infer_instance)
    exact IsZariskiLocalAtSource.comp hB _

  have havoid : ∀ (w : ↥(Limits.pullback
        (Scheme.Opens.ι (⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ,
          isOpen_compl_iff.mpr isClosed_closure⟩ : D.Yt.left.Opens))
        (Limits.pullback.snd V₀.hom D.f))) (k : Fin D.m),
      Limits.pullback.snd V₀.hom D.f (Limits.pullback.snd
        (Scheme.Opens.ι (⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ,
          isOpen_compl_iff.mpr isClosed_closure⟩ : D.Yt.left.Opens))
        (Limits.pullback.snd V₀.hom D.f) w) ≠ D.xs k (IsLocalRing.closedPoint F'') := by
    intro w k hk
    have hmem : Limits.pullback.snd V₀.hom D.f (Limits.pullback.snd
        (Scheme.Opens.ι (⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ,
          isOpen_compl_iff.mpr isClosed_closure⟩ : D.Yt.left.Opens))
        (Limits.pullback.snd V₀.hom D.f) w) ∈
          (⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ,
          isOpen_compl_iff.mpr isClosed_closure⟩ : D.Yt.left.Opens) := by
      rw [← Scheme.Hom.comp_apply, ← Limits.pullback.condition, Scheme.Hom.comp_apply]
      have : Scheme.Opens.ι (⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ,
          isOpen_compl_iff.mpr isClosed_closure⟩ : D.Yt.left.Opens)
          (Limits.pullback.fst (Scheme.Opens.ι
            (⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ,
              isOpen_compl_iff.mpr isClosed_closure⟩ : D.Yt.left.Opens))
            (Limits.pullback.snd V₀.hom D.f) w) ∈ Set.range (Scheme.Opens.ι
            (⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ,
          isOpen_compl_iff.mpr isClosed_closure⟩ : D.Yt.left.Opens)) := ⟨_, rfl⟩
      rw [Scheme.Opens.range_ι] at this
      exact this
    generalize Limits.pullback.snd
        (Scheme.Opens.ι (⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ,
          isOpen_compl_iff.mpr isClosed_closure⟩ : D.Yt.left.Opens))
        (Limits.pullback.snd V₀.hom D.f) w = x at hk hmem
    have hvy : V₀.hom (Limits.pullback.fst V₀.hom D.f x) =
        D.f (Limits.pullback.snd V₀.hom D.f x) := by
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
    have hfy : D.f (Limits.pullback.snd V₀.hom D.f x) = D.S k (IsLocalRing.closedPoint F'') := by
      have e0 : (D.xs k ≫ D.f) (IsLocalRing.closedPoint F'') =
          D.S k (IsLocalRing.closedPoint F'') := by rw [D.hxs k]
      rw [hk]
      refine Eq.trans ?_ e0
      first
        | exact (Scheme.Hom.comp_apply _ _ _).symm
        | rfl
        | simp [Scheme.Hom.comp_apply]
    have hsp1 : e.hom (Limits.pullback.fst V₀.hom D.f x) ⤳ IsLocalRing.closedPoint A :=
      IsLocalRing.specializes_closedPoint _
    have hsp2 := hsp1.map e.inv.continuous
    have hinv : e.inv (e.hom (Limits.pullback.fst V₀.hom D.f x)) =
        Limits.pullback.fst V₀.hom D.f x := by
      rw [← Scheme.Hom.comp_apply, e.hom_inv_id]
      rfl
    rw [hinv] at hsp2
    have hsp3 := hsp2.map V₀.hom.continuous
    rw [hv, hvy, hfy] at hsp3
    haveI : IsClosedImmersion (D.S k) :=
      isClosedImmersion_of_comp_eq_id (wcP1Over F'').hom (D.S k) (D.hS k)
    have hcl : IsClosed (Set.range (D.S k)) := (D.S k).isClosedEmbedding.isClosed_range
    obtain ⟨w', hw'⟩ := hsp3.mem_closed hcl ⟨IsLocalRing.closedPoint F'', rfl⟩
    rw [Subsingleton.elim w' (IsLocalRing.closedPoint F'')] at hw'
    have hki : k = i := D.hSinj hw'
    subst hki
    exact hmem (by rw [hk]; exact subset_closure (Set.mem_singleton _))
  obtain ⟨hc, hq⟩ := hqc ⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ,
    isOpen_compl_iff.mpr isClosed_closure⟩
  exact ⟨hsm _ havoid, hc, hq⟩

theorem wc_crit_nbhd_punct_closed_fibre_pullback (F' F'' : Type u) [Field F'] [Field F'']
    [Finite F''] [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom (D.S i) ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom (D.S i)) :
    IsClosedImmersion (ε.inv ≫ Limits.pullback.fst V₀.hom (D.S i) ≫ e.hom) ∧
    IsUnit ((ℓ : ℕ) : A) ∧
    ∃ qs : Limits.pullback (wcOpenRestr D.Yt.left ⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ,
          isOpen_compl_iff.mpr isClosed_closure⟩ ((wcProEtPullback D.f).obj V₀)).hom
          (Limits.pullback.fst D.f (D.S i)) ⟶ Spec (.of (AlgebraicClosure F'')),
      IsPullback (Limits.pullback.fst (wcOpenRestr D.Yt.left ⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ,
          isOpen_compl_iff.mpr isClosed_closure⟩ ((wcProEtPullback D.f).obj V₀)).hom
          (Limits.pullback.fst D.f (D.S i))) qs
        (Limits.pullback.snd (Scheme.Opens.ι (⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ,
          isOpen_compl_iff.mpr isClosed_closure⟩ : D.Yt.left.Opens))
          ((wcProEtPullback D.f).obj V₀).hom ≫ Limits.pullback.fst V₀.hom D.f ≫ e.hom)
        (ε.inv ≫ Limits.pullback.fst V₀.hom (D.S i) ≫ e.hom) :=
by
  classical

  have hG1 : IsClosedImmersion (ε.inv ≫ Limits.pullback.fst V₀.hom (D.S i) ≫ e.hom) := by
    haveI : Subsingleton (Spec (.of F'')) := by
      show Subsingleton (PrimeSpectrum F''); infer_instance
    haveI : IsClosedImmersion (D.S i) :=
      isClosedImmersion_of_comp_eq_id (wcP1Over F'').hom (D.S i) (D.hS i)
    infer_instance

  have hG2 : IsUnit ((ℓ : ℕ) : A) := by
    let ψ : F'' →+* A := (Spec.preimage (e.inv ≫ V₀.hom ≫ (wcP1Over F'').hom)).hom
    letI := Fintype.ofFinite F''
    have hq0 : ((Nat.card F'' : ℕ) : A) = 0 := by
      rw [← map_natCast ψ, Nat.card_eq_fintype_card, FiniteField.cast_card_eq_zero, map_zero]
    have hcop : Nat.gcd ℓ (Nat.card F'') = 1 :=
      (Nat.Prime.coprime_iff_not_dvd (Fact.out : ℓ.Prime)).mpr hℓ
    have hb := Nat.gcd_eq_gcd_ab ℓ (Nat.card F'')
    rw [hcop] at hb
    have hA : (1 : A) = (ℓ : A) * ((ℓ.gcdA (Nat.card F'') : ℤ) : A) +
        ((Nat.card F'' : ℕ) : A) * ((ℓ.gcdB (Nat.card F'') : ℤ) : A) := by
      have h1 := congrArg (Int.cast : ℤ → A) hb
      push_cast at h1
      exact h1
    rw [hq0, zero_mul, add_zero] at hA
    exact ⟨⟨_, _, hA.symm, (mul_comm _ _).trans hA.symm⟩, rfl⟩

  have paste : ∀ {P Y S V Wo VA SA : Scheme.{u}} (f : Y ⟶ P) (s : S ⟶ P) (v : V ⟶ P)
      (h : Wo ⟶ Y) (g : Wo ⟶ V) (_ : g ≫ v = h ≫ f) (eV : V ≅ VA)
      (eS : Limits.pullback v s ≅ SA) (gA : Wo ⟶ VA) (_ : g ≫ eV.hom = gA),
      ∃ qs : Limits.pullback h (Limits.pullback.fst f s) ⟶ SA,
        IsPullback (Limits.pullback.fst h (Limits.pullback.fst f s)) qs gA
          (eS.inv ≫ Limits.pullback.fst v s ≫ eV.hom) := by
    intro P Y S V Wo VA SA f s v h g hg eV eS gA hgA
    subst hgA
    have w : (Limits.pullback.fst h (Limits.pullback.fst f s) ≫ g) ≫ v =
        (Limits.pullback.snd h (Limits.pullback.fst f s) ≫ Limits.pullback.snd f s) ≫ s := by
      rw [Category.assoc, Category.assoc, hg,
        Limits.pullback.condition_assoc (f := h) (g := Limits.pullback.fst f s),
        Limits.pullback.condition (f := f) (g := s)]
    obtain ⟨r, hr1, hr2⟩ : ∃ r : Limits.pullback h (Limits.pullback.fst f s) ⟶
        Limits.pullback v s,
        r ≫ Limits.pullback.fst v s = Limits.pullback.fst h (Limits.pullback.fst f s) ≫ g ∧
        r ≫ Limits.pullback.snd v s =
          Limits.pullback.snd h (Limits.pullback.fst f s) ≫ Limits.pullback.snd f s :=
      ⟨Limits.pullback.lift _ _ w, Limits.pullback.lift_fst _ _ w,
        Limits.pullback.lift_snd _ _ w⟩
    have hout := IsPullback.paste_vert (IsPullback.of_hasPullback h (Limits.pullback.fst f s))
      (IsPullback.of_hasPullback f s)
    have hout' : IsPullback (Limits.pullback.fst h (Limits.pullback.fst f s))
        (r ≫ Limits.pullback.snd v s) (g ≫ v) s := by
      rw [hr2, hg]; exact hout
    have hsq := IsPullback.of_bot hout' hr1.symm (IsPullback.of_hasPullback v s)
    refine ⟨r ≫ eS.hom, IsPullback.of_iso hsq (Iso.refl _) (Iso.refl _) eS eV ?_ ?_ ?_ ?_⟩
    · simp
    · simp
    · simp
    · simp
  have hc := Limits.pullback.condition (f := V₀.hom) (g := D.f)
  have hg : (Limits.pullback.snd (Scheme.Opens.ι (⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ,
          isOpen_compl_iff.mpr isClosed_closure⟩ : D.Yt.left.Opens))
          ((wcProEtPullback D.f).obj V₀).hom ≫ Limits.pullback.fst V₀.hom D.f) ≫ V₀.hom =
      (wcOpenRestr D.Yt.left ⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ,
          isOpen_compl_iff.mpr isClosed_closure⟩ ((wcProEtPullback D.f).obj V₀)).hom ≫ D.f :=
    (Category.assoc _ _ _).trans ((whisker_eq _ hc).trans (Category.assoc _ _ _).symm)
  obtain ⟨qs, hpb⟩ := paste D.f (D.S i) V₀.hom _ _ hg e ε _ (Category.assoc _ _ _)
  exact ⟨hG1, hG2, qs, hpb⟩

theorem wc_crit_punct_fibre_open_model (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (i : Fin D.m) (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom (D.S i) ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom (D.S i)) :
    CompactSpace ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
        (wcOpenRestr D.Yt.left ⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ,
          isOpen_compl_iff.mpr isClosed_closure⟩ ((wcProEtPullback D.f).obj V₀))).left ∧
    IsSeparated (Limits.terminal.from ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
        (wcOpenRestr D.Yt.left ⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ,
          isOpen_compl_iff.mpr isClosed_closure⟩ ((wcProEtPullback D.f).obj V₀))).left) ∧
    ∃ (P : Scheme.{u}) (fP : P ⟶ Spec (.of (AlgebraicClosure F''))) (_ : IsProper fP)
      (xb : P) (O : P.Opens),
      IsClosed ({xb} : Set P) ∧ (O : Set P) = {xb}ᶜ ∧
      SmoothOfRelativeDimension (n - 1) (O.ι ≫ fP) ∧
      Nonempty (((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
        (wcOpenRestr D.Yt.left ⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ,
          isOpen_compl_iff.mpr isClosed_closure⟩ ((wcProEtPullback D.f).obj V₀))).left ≅
        (O : Scheme.{u})) ∧
      ∃ (R : Type u) (_ : CommRing R) (_ : IsLocalRing R) (_ : IsNoetherianRing R)
        (t : Fin n → R) (h : R) (M : Matrix (Fin n) (Fin n) R),
        ringKrullDim R = n ∧ IsLocalRing.maximalIdeal R = Ideal.span (Set.range t) ∧
        h - ∑ a, ∑ c, M a c * t a * t c ∈ IsLocalRing.maximalIdeal R ^ 3 ∧
        IsUnit (M + M.transpose).det ∧ Nonempty (P.presheaf.stalk xb ≃+* R ⧸ Ideal.span {h}) :=
by
  classical
  set T := (wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
    ((wcProEtPullback D.f).obj V₀) with hT
  obtain ⟨xb, hxb, hln⟩ : ∃ xb : T.left,
      Set.range (wcOpenRestrIncl (Limits.pullback D.f (D.S i)) (wcCritPunctOpen D i) T).left =
        {xb}ᶜ ∧ IsLocallyNoetherian T.left := by
    obtain ⟨xb, h1, -, h2, -, -⟩ := wc_odp_fibre_sing_point F' F'' Y n D i V₀ A e ε hv hε
    exact ⟨xb, h1, h2⟩
  haveI := hln
  haveI hsub : Subsingleton (Spec (.of F'')) := by
    show Subsingleton (PrimeSpectrum F''); infer_instance

  haveI hSi : IsClosedImmersion (D.S i) :=
    isClosedImmersion_of_comp_eq_id (wcP1Over F'').hom (D.S i) (D.hS i)
  have hι : IsClosedImmersion (Limits.pullback.fst D.f (D.S i)) := by
    first
      | infer_instance
      | exact MorphismProperty.of_isPullback (P := @IsClosedImmersion)
          (IsPullback.of_hasPullback D.f (D.S i)).flip hSi
      | exact MorphismProperty.of_isPullback (P := @IsClosedImmersion)
          (IsPullback.of_hasPullback D.f (D.S i)) hSi
  have hxsCI : IsClosedImmersion (D.xs i) := by
    apply isClosedImmersion_of_comp_eq_id D.Yt.hom (D.xs i)
    rw [← D.hf, ← Category.assoc, D.hxs i, D.hS i]
  have hclos : closure ({D.xs i (IsLocalRing.closedPoint F'')} : Set D.Yt.left) =
      {D.xs i (IsLocalRing.closedPoint F'')} := by
    have hrange : Set.range ⇑(D.xs i) = {D.xs i (IsLocalRing.closedPoint F'')} := by
      ext y
      constructor
      · rintro ⟨a, rfl⟩
        rw [Subsingleton.elim a (IsLocalRing.closedPoint F'')]
        exact Set.mem_singleton _
      · intro hy
        rw [Set.mem_singleton_iff] at hy
        exact ⟨_, hy.symm⟩
    have hc : IsClosed (Set.range ⇑(D.xs i)) := by
      haveI := hxsCI
      first
        | exact (D.xs i).isClosedEmbedding.isClosed_range
        | exact (IsClosedImmersion.isClosedEmbedding (D.xs i)).isClosed_range
        | exact IsClosedImmersion.base_closed.isClosed_range
    rw [hrange] at hc
    exact hc.closure_eq
  have hmemO : ∀ y, y ∈ (wcCritPunctOpen D i : (Limits.pullback D.f (D.S i)).Opens) ↔
      ¬ Limits.pullback.fst D.f (D.S i) y = D.xs i (IsLocalRing.closedPoint F'') := by
    intro y
    have h1 : (¬ Limits.pullback.fst D.f (D.S i) y = D.xs i (IsLocalRing.closedPoint F'')) ↔
        Limits.pullback.fst D.f (D.S i) y ∈
          (closure ({D.xs i (IsLocalRing.closedPoint F'')} : Set D.Yt.left))ᶜ := by
      rw [hclos]; simp
    rw [h1]
    all_goals first
      | exact Iff.rfl
      | simp [wcCritPunctOpen, Scheme.Hom.mem_preimage]
  have hιY : Limits.pullback.fst D.f (D.S i) ≫ D.Yt.hom = Limits.pullback.snd D.f (D.S i) := by
    rw [← D.hf, ← Category.assoc, Limits.pullback.condition, Category.assoc, D.hS i,
      Category.comp_id]

  haveI hYp := D.proper
  haveI hpsep : IsSeparated (wcP1Over F'').hom := by
    show IsSeparated (Proj.toSpecZero _ ≫ Spec.map _)
    infer_instance
  haveI : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; infer_instance
  have hDfP : IsProper D.f := by
    first
      | exact IsProper.of_comp D.f (wcP1Over F'').hom
      | exact IsProper.of_comp_of_isSeparated D.f (wcP1Over F'').hom
      | exact MorphismProperty.of_postcomp (W := @IsProper) (W' := @IsSeparated) D.f
          (wcP1Over F'').hom inferInstance inferInstance
      | (constructor <;> first
          | exact IsSeparated.of_comp D.f (wcP1Over F'').hom
          | exact UniversallyClosed.of_comp_of_isSeparated D.f (wcP1Over F'').hom
          | exact locallyOfFiniteType_of_comp D.f (wcP1Over F'').hom
          | infer_instance)
  have hπP : IsProper (Limits.pullback.snd D.f (D.S i)) :=
    MorphismProperty.of_isPullback (P := @IsProper) (IsPullback.of_hasPullback D.f (D.S i)) hDfP

  have Sq1 : IsPullback
      (Limits.pullback.fst (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f (D.S i)))
      (Limits.pullback.snd (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f (D.S i)))
      (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f (D.S i)) :=
    IsPullback.of_hasPullback _ _
  have Sq2 : IsPullback (Limits.pullback.fst V₀.hom D.f) (Limits.pullback.snd V₀.hom D.f)
      V₀.hom D.f := IsPullback.of_hasPullback _ _
  have Big := Sq1.paste_horiz Sq2
  rw [Limits.pullback.condition (f := D.f) (g := D.S i)] at Big
  have Sq3 : IsPullback (Limits.pullback.fst V₀.hom (D.S i)) (Limits.pullback.snd V₀.hom (D.S i))
      V₀.hom (D.S i) := IsPullback.of_hasPullback _ _
  obtain ⟨r, hA0⟩ : ∃ r : T.left ⟶ Limits.pullback V₀.hom (D.S i),
      IsPullback r T.hom (Limits.pullback.snd V₀.hom (D.S i)) (Limits.pullback.snd D.f (D.S i)) :=
    ⟨_, IsPullback.of_right' Big Sq3⟩
  have hsqε : IsPullback ε.hom (Limits.pullback.snd V₀.hom (D.S i))
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) (𝟙 _) :=
    IsPullback.of_horiz_isIso ⟨by rw [Category.comp_id]; exact hε⟩
  have hA1 := hA0.paste_horiz hsqε
  rw [Category.comp_id] at hA1
  have hA : IsPullback T.hom (r ≫ ε.hom) (Limits.pullback.snd D.f (D.S i))
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) := hA1.flip
  have hfP : IsProper (r ≫ ε.hom) := MorphismProperty.of_isPullback (P := @IsProper) hA hπP
  haveI := hfP

  haveI hZLn : IsZariskiLocalAtSource (@SmoothOfRelativeDimension n) := by
    first
      | infer_instance
      | exact HasRingHomProperty.instIsZariskiLocalAtSource (P := @SmoothOfRelativeDimension n)
  haveI hZLn1 : IsZariskiLocalAtSource (@SmoothOfRelativeDimension (n - 1)) := by
    first
      | infer_instance
      | exact HasRingHomProperty.instIsZariskiLocalAtSource
          (P := @SmoothOfRelativeDimension (n - 1))
  have hsmU : SmoothOfRelativeDimension (n - 1)
      ((wcCritPunctOpen D i).ι ≫ Limits.pullback.snd D.f (D.S i)) := by
    haveI hP1 := wc_p1_smooth_reldim_one F''
    have s2 : ∀ (V' : D.Yt.left.Opens), Smooth (V'.ι ≫ D.f) →
        SmoothOfRelativeDimension (n - 1)
          ((Limits.pullback.fst D.f (D.S i) ⁻¹ᵁ V').ι ≫ Limits.pullback.snd D.f (D.S i)) := by
      intro V' hV'
      haveI := hV'
      haveI h1 : SmoothOfRelativeDimension n ((V'.ι ≫ D.f) ≫ (wcP1Over F'').hom) := by
        rw [Category.assoc, D.hf]
        exact IsZariskiLocalAtSource.comp (P := @SmoothOfRelativeDimension n) D.smooth V'.ι
      have h2 := wc_smooth_reldim_of_comp_reldim (V'.ι ≫ D.f) (wcP1Over F'').hom n 1
      have hsq := IsPullback.paste_vert
        (isPullback_morphismRestrict (Limits.pullback.fst D.f (D.S i)) V')
        (IsPullback.of_hasPullback D.f (D.S i))
      exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension (n - 1)) hsq h2
    have havoid : ∀ (z : (wcCritPunctOpen D i : Scheme.{u})) (k : Fin D.m),
        Limits.pullback.fst D.f (D.S i) ((wcCritPunctOpen D i).ι z) ≠
          D.xs k (IsLocalRing.closedPoint F'') := by
      intro z k hk
      have hz : (wcCritPunctOpen D i).ι z ∈ (wcCritPunctOpen D i) := by
        have : (wcCritPunctOpen D i).ι z ∈ Set.range (wcCritPunctOpen D i).ι := ⟨z, rfl⟩
        rw [Scheme.Opens.range_ι] at this
        exact this
      generalize (wcCritPunctOpen D i).ι z = x at hk hz
      have h1 : D.f (Limits.pullback.fst D.f (D.S i) x) =
          D.S i (Limits.pullback.snd D.f (D.S i) x) := by
        rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
      have h2 : D.f (D.xs k (IsLocalRing.closedPoint F'')) =
          D.S k (IsLocalRing.closedPoint F'') := by
        have e0 : (D.xs k ≫ D.f) (IsLocalRing.closedPoint F'') =
            D.S k (IsLocalRing.closedPoint F'') := by rw [D.hxs k]
        refine Eq.trans ?_ e0
        first
          | exact (Scheme.Hom.comp_apply _ _ _).symm
          | rfl
          | simp [Scheme.Hom.comp_apply]
      have h3 : D.S k (IsLocalRing.closedPoint F'') = D.S i (IsLocalRing.closedPoint F'') := by
        rw [← h2, ← hk, h1, Subsingleton.elim (Limits.pullback.snd D.f (D.S i) x)
          (IsLocalRing.closedPoint F'')]
      have hki : k = i := D.hSinj h3
      rw [hki] at hk
      exact (hmemO x).mp hz hk
    choose V hyV hV using fun z => D.smooth_off _ (havoid z)
    have hcov : ⨆ z, (wcCritPunctOpen D i).ι ⁻¹ᵁ
        (Limits.pullback.fst D.f (D.S i) ⁻¹ᵁ V z) = ⊤ := by
      rw [eq_top_iff]
      intro z _
      rw [TopologicalSpace.Opens.mem_iSup]
      exact ⟨z, hyV z⟩
    refine IsZariskiLocalAtSource.of_iSup_eq_top (P := @SmoothOfRelativeDimension (n - 1)) _
      hcov (fun z => ?_)
    rw [← Category.assoc, ← morphismRestrict_ι, Category.assoc]
    exact IsZariskiLocalAtSource.comp (s2 _ (hV z)) _
  have hsmO : SmoothOfRelativeDimension (n - 1)
      ((T.hom ⁻¹ᵁ wcCritPunctOpen D i).ι ≫ (r ≫ ε.hom)) := by
    have hsq := IsPullback.paste_vert (isPullback_morphismRestrict T.hom (wcCritPunctOpen D i)) hA
    exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension (n - 1)) hsq hsmU

  have hrange : Set.range ⇑(wcOpenRestrIncl (Limits.pullback D.f (D.S i))
      (wcCritPunctOpen D i) T).left = {x : T.left | T.hom x ∈ wcCritPunctOpen D i} := by
    show Set.range ⇑(Limits.pullback.snd (wcCritPunctOpen D i).ι T.hom) = _
