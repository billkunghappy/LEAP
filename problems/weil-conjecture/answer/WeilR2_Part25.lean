      (gV : Projective (wcFreeSheaf (wcP1Over F'').left V))
      (y y' : (Subobject.underlying.obj (wcPencilE D ℓ hP)).obj.obj (Opposite.op V)),
      β V hV gV (π V y) (π V y') =
      B V (((wcPencilE D ℓ hP).arrow.hom.app (Opposite.op V)).hom y)
        (((wcPencilE D ℓ hP).arrow.hom.app (Opposite.op V)).hom y') := by
    intro V hV gV y y'
    rw [hβdef, (hWD V hV gV _ y _ (hs V gV (π V y))).1,
      (hWD V hV gV _ y' y (hs V gV (π V y'))).2]
  obtain ⟨B', h1, h2, h3, h4⟩ := hglue
    (fun V => ∀ (v : V.left) (i : Fin D.m), V.hom v ≠ D.S i (IsLocalRing.closedPoint F''))
    (fun V => Projective (wcFreeSheaf (wcP1Over F'').left V)) hOff
    (fun U => wc_proet_projective_free_covering _ U)
    (wcPencilVQ D ℓ hP) (wcRq D.f ℓ (2 * (n - 1))) ℚ_[ℓ]
    (wcPencilVQScalar D ℓ hP) (wcRqScalar D.f ℓ (2 * (n - 1))) β
    (by
      intro V V' hV gV hV' gV' a x x'
      obtain ⟨y, rfl⟩ := hπsurj V gV x
      obtain ⟨y', rfl⟩ := hπsurj V gV x'
      rw [hπnat, hπnat, hlift, hlift, hEnat, hEnat, hBnat])
    (by
      intro V hV gV c x x'
      obtain ⟨y, rfl⟩ := hπsurj V gV x
      obtain ⟨y', rfl⟩ := hπsurj V gV x'
      obtain ⟨ψ, hψ1, hψ2⟩ := wc_pencil_VQScalar_spec F' F'' Y n D ℓ hP c
      have e2 : ((wcPencilVQScalar D ℓ hP c).hom.app (Opposite.op V)).hom (π V y) =
          π V ((ψ.hom.app (Opposite.op V)).hom y) := by
        rw [hπ, hπ]
        exact congrArg (fun m => (m.hom.app (Opposite.op V)).hom y) hψ2
      have e1 : ((wcPencilE D ℓ hP).arrow.hom.app (Opposite.op V)).hom
          ((ψ.hom.app (Opposite.op V)).hom y) =
          ((wcRqScalar D.f ℓ (n - 1) c).hom.app (Opposite.op V)).hom
            (((wcPencilE D ℓ hP).arrow.hom.app (Opposite.op V)).hom y) :=
        congrArg (fun m => (m.hom.app (Opposite.op V)).hom y) hψ1
      rw [e2, hlift, hlift, e1, hBsc])
    (by
      intro V hV gV x x'
      obtain ⟨y, rfl⟩ := hπsurj V gV x
      obtain ⟨y', rfl⟩ := hπsurj V gV x'
      rw [hlift, hlift, hBalt])
  refine ⟨B', h1, h2, h3, ?_⟩
  intro V hV A _ _ _ e hcl x hx
  have gV := wc_proet_free_projective_strict_local _ V A e
  have hp : ∀ i, V.hom (e.inv (IsLocalRing.closedPoint A)) ≠ D.S i (IsLocalRing.closedPoint F'') :=
    fun i => hV _ i
  obtain ⟨y, rfl⟩ := hπsurj V gV x
  have hy0 : ∀ y'', B V (((wcPencilE D ℓ hP).arrow.hom.app (Opposite.op V)).hom y)
      (((wcPencilE D ℓ hP).arrow.hom.app (Opposite.op V)).hom y'') = 0 := by
    intro y''
    rw [← hlift V hV gV y y'', ← h4 V hV gV]
    exact hx _

  obtain ⟨r₂, ⟨θ⟩⟩ := wc_pencil_R2_geomConst_offS F' F'' Y n hn hn2 D ℓ hℓ hP
  have hconn := wc_pencilGeomOffS_connected F' F'' Y n D hP
  obtain ⟨sV⟩ := wc_P1_strict_local_offS_map F' F'' Y n D hP V A e hp
  have hinj := wc_proet_geomConst_restrict_injective _ ℓ (wcRq D.f ℓ (2 * (n - 1))) _ V sV r₂ θ
    hconn ⟨e.inv (IsLocalRing.closedPoint A)⟩
  have hsur : Function.Surjective ((wcRq D.f ℓ (2 * (n - 1))).obj.map sV.op).hom :=
    fun w => wc_proet_geomConst_section_of_local _ ℓ _ _ V sV A e r₂ θ w
  obtain ⟨V₀, g₀, φ₀, A₀, i1, i2, i3, e₀, ε, hv, -, hε, hεφ⟩ :=
    wc_P1bar_strict_local_nbhd F'' D.u0 D.hu0 hP
  obtain ⟨L₀, hL₀inj, hL₀sc⟩ :=
    wc_pencil_R2_u0_strict_line F' F'' Y n hn2 D ℓ hℓ V₀ φ₀ A₀ e₀ ε hv hε hεφ
  obtain ⟨s₀⟩ := wc_P1_strict_local_offS_map F' F'' Y n D hP V₀ A₀ e₀
    (fun i => by rw [hv]; exact D.hu0S i)
  have hinj₀ := wc_proet_geomConst_restrict_injective _ ℓ (wcRq D.f ℓ (2 * (n - 1))) _ V₀ s₀ r₂ θ
    hconn ⟨e₀.inv (IsLocalRing.closedPoint A₀)⟩
  let σ := AddEquiv.ofBijective ((wcRq D.f ℓ (2 * (n - 1))).obj.map sV.op).hom ⟨hinj, hsur⟩
  have hσ : ∀ t, ((wcRq D.f ℓ (2 * (n - 1))).obj.map sV.op).hom (σ.symm t) = t :=
    fun t => σ.apply_symm_apply t
  let L : (wcRq D.f ℓ (2 * (n - 1))).obj.obj (Opposite.op V) →+ ℚ_[ℓ] :=
    L₀.comp (((wcRq D.f ℓ (2 * (n - 1))).obj.map s₀.op).hom.comp σ.symm.toAddMonoidHom)
  have hLdef : ∀ t, L t = L₀ (((wcRq D.f ℓ (2 * (n - 1))).obj.map s₀.op).hom (σ.symm t)) :=
    fun t => rfl
  have hLinj : Function.Injective L := by
    intro t t' htt
    rw [hLdef, hLdef] at htt
    exact σ.symm.injective (hinj₀ (hL₀inj htt))
  have hLsc : ∀ (c : ℚ_[ℓ]) (t : (wcRq D.f ℓ (2 * (n - 1))).obj.obj (Opposite.op V)),
      L (((wcRqScalar D.f ℓ (2 * (n - 1)) c).hom.app (Opposite.op V)).hom t) = c * L t := by
    intro c t
    have hσsc : σ.symm (((wcRqScalar D.f ℓ (2 * (n - 1)) c).hom.app (Opposite.op V)).hom t) =
        ((wcRqScalar D.f ℓ (2 * (n - 1)) c).hom.app (Opposite.op (wcPencilGeomOffS D hP))).hom
          (σ.symm t) := by
      apply hinj
      rw [hσ, ← hN, hσ]
    rw [hLdef, hLdef, hσsc, ← hN (wcRqScalar D.f ℓ (2 * (n - 1)) c) s₀, hL₀sc]

  obtain ⟨a, eR, heR, UE, UC, hUE, hUC, hdim⟩ := hcount V A e hcl hp
  have hes : ∀ (c : ℚ_[ℓ]) (v : Fin a → ℚ_[ℓ]), eR.symm (c • v) =
      ((wcRqScalar D.f ℓ (n - 1) c).hom.app (Opposite.op V)).hom (eR.symm v) := fun c v =>
    eR.injective (by rw [heR, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
  let Bil : (Fin a → ℚ_[ℓ]) → (Fin a → ℚ_[ℓ]) → ℚ_[ℓ] := fun v w => L (B V (eR.symm v) (eR.symm w))
  have halt' : ∀ v w, Bil v w = -Bil w v := by
    intro v w
    show L (B V (eR.symm v) (eR.symm w)) = -L (B V (eR.symm w) (eR.symm v))
    rw [hBalt V (eR.symm v) (eR.symm w), map_neg]
  have hadd1 : ∀ v v' w, Bil (v + v') w = Bil v w + Bil v' w := by
    intro v v' w
    show L (B V (eR.symm (v + v')) (eR.symm w)) =
      L (B V (eR.symm v) (eR.symm w)) + L (B V (eR.symm v') (eR.symm w))
    simp only [map_add, AddMonoidHom.add_apply]
  have hsmul1 : ∀ (c : ℚ_[ℓ]) v w, Bil (c • v) w = c • Bil v w := by
    intro c v w
    show L (B V (eR.symm (c • v)) (eR.symm w)) = c • L (B V (eR.symm v) (eR.symm w))
    rw [hes, hBsc, hLsc, smul_eq_mul]
  have hadd2 : ∀ v w w', Bil v (w + w') = Bil v w + Bil v w' := by
    intro v w w'
    linear_combination halt' v (w + w') - hadd1 w w' v - halt' v w - halt' v w'
  have hsmul2 : ∀ (c : ℚ_[ℓ]) v w, Bil v (c • w) = c • Bil v w := by
    intro c v w
    have h := hsmul1 c w v
    rw [smul_eq_mul] at h
    rw [smul_eq_mul]
    linear_combination halt' v (c • w) - h - c * halt' v w
  let b : LinearMap.BilinForm ℚ_[ℓ] (Fin a → ℚ_[ℓ]) :=
    LinearMap.mk₂ ℚ_[ℓ] Bil hadd1 hsmul1 hadd2 hsmul2
  have hb : ∀ v w, b v w = Bil v w := fun v w => rfl
  have hsep : ∀ v, (∀ w, b v w = 0) → v = 0 := by
    intro v hv
    have h1 : ∀ t, B V (eR.symm v) t = 0 := by
      intro t
      apply hLinj
      have h2 : L (B V (eR.symm v) (eR.symm (eR t))) = 0 := hv (eR t)
      rw [AddEquiv.symm_apply_apply] at h2
      rw [h2, map_zero]
    have h3 := (hBperf V A e hcl hp).1 _ h1
    rw [← AddEquiv.apply_symm_apply eR v, h3, map_zero]
  have hrefl : b.IsRefl := by
    intro v w h
    rw [hb] at h ⊢
    rw [halt', h, neg_zero]
  have hnd : b.Nondegenerate := (LinearMap.IsRefl.nondegenerate_iff_separatingLeft hrefl).2 hsep
  have horth : ∀ u ∈ UE, ∀ w ∈ UC, b u w = 0 := by
    intro u hu w hw
    obtain ⟨z, rfl⟩ := (hUE u).1 hu
    obtain ⟨c', rfl⟩ := (hUC w).1 hw
    rw [hb]
    show L (B V (eR.symm (eR _)) (eR.symm (eR _))) = 0
    rw [AddEquiv.symm_apply_apply, AddEquiv.symm_apply_apply, hO V hV z c', map_zero]
  have hle : UC ≤ b.orthogonal UE := fun w hw =>
    LinearMap.BilinForm.mem_orthogonal_iff.mpr (fun u hu => horth u hu w hw)
  have hfr : Module.finrank ℚ_[ℓ] (b.orthogonal UE) ≤ Module.finrank ℚ_[ℓ] UC := by
    rw [LinearMap.BilinForm.finrank_orthogonal hnd, Module.finrank_fin_fun]
    omega
  have hUCeq : UC = b.orthogonal UE := Submodule.eq_of_le_of_finrank_le hle hfr
  have hvC : eR (((wcPencilE D ℓ hP).arrow.hom.app (Opposite.op V)).hom y) ∈ UC := by
    rw [hUCeq, LinearMap.BilinForm.mem_orthogonal_iff]
    intro u hu
    obtain ⟨z, rfl⟩ := (hUE u).1 hu
    rw [hb, halt']
    show -L (B V (eR.symm (eR _)) (eR.symm (eR _))) = 0
    rw [AddEquiv.symm_apply_apply, AddEquiv.symm_apply_apply, hy0 z, map_zero, neg_zero]
  obtain ⟨c', hc'⟩ := (hUC _).1 hvC
  have hEC : ((wcPencilE D ℓ hP).arrow.hom.app (Opposite.op V)).hom y =
      ((wcPencilC D ℓ hP).arrow.hom.app (Opposite.op V)).hom c' := (eR.injective hc').symm

  obtain ⟨w, hw⟩ := hinf_gen _ (wcPencilE D ℓ hP) (wcPencilC D ℓ hP) V y c' hEC
  rw [← hw, hπ]
  have hz := congrArg (fun m => (m.hom.app (Opposite.op V)).hom w)
    (Limits.cokernel.condition (Subobject.ofLE (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP)
      (wcPencilE D ℓ hP) inf_le_left))
  refine hz.trans ?_
  first
    | rfl
    | simp

theorem wc_vqm_hz_R2_endo_scalar (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
    (hconn : ConnectedSpace W.left)
    (hoff : ∀ (z : W.left) (i : Fin D.m), W.hom z ≠ D.S i (IsLocalRing.closedPoint F''))
    (hcov : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left,
      (∀ i : Fin D.m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠ D.S i (IsLocalRing.closedPoint F'')) →
      ∃ z : W.left, w.left z = p)
    (φ : W ⟶ W) :
    ∃ μ : ℚ_[ℓ], ∀ τ : (wcRq D.f ℓ (2 * (n - 1))).obj.obj (Opposite.op W),
      ((wcRq D.f ℓ (2 * (n - 1))).obj.map φ.op).hom τ =
        ((wcRqScalar D.f ℓ (2 * (n - 1)) μ).hom.app (Opposite.op W)).hom τ :=
by
  classical
  obtain ⟨r, ⟨κ⟩⟩ := wc_pencil_R2_geomConst_offS F' F'' Y n hn hn2 D ℓ hℓ hP

  have hcl := (wc_P1_sections_closed_generize F'' D.m D.S D.hS).1
  have hrange : Set.range W.hom ⊆ Set.range (wcPencilSOpen D).ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨z, rfl⟩
    show W.hom z ∈ (⋃ i, closure {D.S i (IsLocalRing.closedPoint F'')})ᶜ
    intro hmem
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hmem
    have hsub : closure {D.S i (IsLocalRing.closedPoint F'')} ⊆
        {p : (wcP1Over F'').left | ∃ j : Fin D.m, p = D.S j (IsLocalRing.closedPoint F'')} :=
      closure_minimal (fun p hp => ⟨i, hp⟩) hcl
    obtain ⟨j, hj⟩ := hsub hi
    exact hoff z j hj
  let a := IsOpenImmersion.lift (wcPencilSOpen D).ι W.hom hrange
  have ha : a ≫ (wcPencilSOpen D).ι = W.hom := IsOpenImmersion.lift_fac _ _ _
  have hwp : w.left ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom = W.hom :=
    MorphismProperty.Over.w w
  have hsq : a ≫ (wcPencilSOpen D).ι = w.left ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom :=
    ha.trans hwp.symm
  let w'L : W.left ⟶ Limits.pullback (wcPencilSOpen D).ι (wcGeomPoint F'' (wcP1Over F'') hP).hom :=
    Limits.pullback.lift a w.left hsq
  have hw'L : w'L ≫ (Limits.pullback.snd (wcPencilSOpen D).ι
      (wcGeomPoint F'' (wcP1Over F'') hP).hom ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) =
      W.hom := by
    rw [← Category.assoc, Limits.pullback.lift_snd, hwp]
  let w' : W ⟶ wcPencilGeomOffS D hP := MorphismProperty.Over.homMk w'L hw'L trivial

  obtain ⟨V₀, g₀, φ₀, A, iR, iH, iS, e, ε, hv, -, hε, hεφ⟩ :=
    wc_P1bar_strict_local_nbhd F'' D.u0 D.hu0 hP
  have hx₀ : ∀ i, V₀.hom (e.inv (IsLocalRing.closedPoint A)) ≠ D.S i (IsLocalRing.closedPoint F'') :=
    fun i => by rw [hv]; exact D.hu0S i
  have hgp : ∀ x : V₀.left, (wcGeomPoint F'' (wcP1Over F'') hP).hom (g₀.left x) = V₀.hom x := by
    intro x
    rw [← MorphismProperty.Over.w g₀, Scheme.Hom.comp_apply]
  obtain ⟨ι, -⟩ := wc_P1bar_strict_local_lift F'' hP W w V₀ g₀ A e
    (hcov _ (fun i => by rw [hgp]; exact hx₀ i))
  obtain ⟨L, hLinj, hLsc⟩ :=
    wc_pencil_R2_u0_strict_line F' F'' Y n hn2 D ℓ hℓ V₀ φ₀ A e ε hv hε hεφ

  haveI := hconn
  obtain ⟨v0⟩ : Nonempty V₀.left := ⟨e.inv (IsLocalRing.closedPoint A)⟩
  have hcancel : ∀ t : (wcRq D.f ℓ (2 * (n - 1))).obj.obj (Opposite.op W),
      (κ.inv.hom.app (Opposite.op (Over.mk w'))).hom
        ((κ.hom.hom.app (Opposite.op (Over.mk w'))).hom t) = t := by
    intro t
    exact congrArg (fun m => (m.hom.app (Opposite.op (Over.mk w'))).hom t) κ.hom_inv_id
  have hinj : ∀ τ : (wcRq D.f ℓ (2 * (n - 1))).obj.obj (Opposite.op W),
      ((wcRq D.f ℓ (2 * (n - 1))).obj.map ι.op).hom τ = 0 → τ = 0 := by
    intro τ hτ
    have hN := κ.hom.hom.naturality (Over.homMk ι rfl : Over.mk (ι ≫ w') ⟶ Over.mk w').op
    have h1 : (show C(↥V₀.left, Fin r → ℚ_[ℓ]) from
        ((κ.hom.hom.app (Opposite.op (Over.mk (ι ≫ w')))).hom
          (((wcRq D.f ℓ (2 * (n - 1))).obj.map ι.op).hom τ)).down) v0 =
        (show C(↥W.left, Fin r → ℚ_[ℓ]) from
          ((κ.hom.hom.app (Opposite.op (Over.mk w'))).hom τ).down) (ι.left v0) :=
      congrArg (fun m => (show C(↥V₀.left, Fin r → ℚ_[ℓ]) from (m.hom τ).down) v0) hN
    have h0 : (show C(↥V₀.left, Fin r → ℚ_[ℓ]) from
        ((κ.hom.hom.app (Opposite.op (Over.mk (ι ≫ w')))).hom
          (((wcRq D.f ℓ (2 * (n - 1))).obj.map ι.op).hom τ)).down) v0 = 0 := by
      have h := map_zero (κ.hom.hom.app (Opposite.op (Over.mk (ι ≫ w')))).hom
      rw [hτ]
      exact congrArg (fun y : ULift.{u+1} C(↥V₀.left, Fin r → ℚ_[ℓ]) => y.down v0) h
    have hκ : (κ.hom.hom.app (Opposite.op (Over.mk w'))).hom τ =
        (κ.hom.hom.app (Opposite.op (Over.mk w'))).hom 0 := by
      apply ULift.ext
      apply ContinuousMap.ext
      intro z
      have h2 : (show C(↥W.left, Fin r → ℚ_[ℓ]) from
          ((κ.hom.hom.app (Opposite.op (Over.mk w'))).hom τ).down) z =
          (show C(↥W.left, Fin r → ℚ_[ℓ]) from
            ((κ.hom.hom.app (Opposite.op (Over.mk w'))).hom τ).down) (ι.left v0) :=
        (isPreconnected_range (show C(↥W.left, Fin r → ℚ_[ℓ]) from
            ((κ.hom.hom.app (Opposite.op (Over.mk w'))).hom τ).down).continuous).subsingleton
          ⟨z, rfl⟩ ⟨ι.left v0, rfl⟩
      have h3 : (show C(↥W.left, Fin r → ℚ_[ℓ]) from
          ((κ.hom.hom.app (Opposite.op (Over.mk w'))).hom 0).down) z = 0 :=
        congrArg (fun y : ULift.{u+1} C(↥W.left, Fin r → ℚ_[ℓ]) => y.down z)
          (map_zero (κ.hom.hom.app (Opposite.op (Over.mk w'))).hom)
      exact h2.trans (h1.symm.trans (h0.trans h3.symm))
    exact (hcancel τ).symm.trans
      ((congrArg (κ.inv.hom.app (Opposite.op (Over.mk w'))).hom hκ).trans (hcancel 0))

  have alg : ∀ {G : Type (u+1)} [AddCommGroup G] (s : ℚ_[ℓ] → G →+ G) (M : G →+ ℚ_[ℓ]),
      Function.Injective M → (∀ (c : ℚ_[ℓ]) (x : G), M (s c x) = c * M x) →
      ∀ (T : G →+ G), (∀ (c : ℚ_[ℓ]) (x : G), T (s c x) = s c (T x)) →
      ∃ μ : ℚ_[ℓ], ∀ x, T x = s μ x := by
    intro G _ s M hM hMs T hT
    by_cases h0 : ∀ x, M x = 0
    · refine ⟨0, fun x => ?_⟩
      have hx : x = 0 := hM (by rw [h0 x, map_zero])
      rw [hx, map_zero, map_zero]
    · push_neg at h0
      obtain ⟨t₀, ht₀⟩ := h0
      refine ⟨M (T t₀) / M t₀, fun x => ?_⟩
      apply hM
      have hxk : x = s (M x / M t₀) t₀ := hM (by rw [hMs, div_mul_cancel₀ _ ht₀])
      have e1 : M (T x) = (M x / M t₀) * M (T t₀) := by
        conv_lhs => rw [hxk]
        rw [hT, hMs]
      rw [hMs, e1]
      ring
  have hMinj : Function.Injective (L.comp ((wcRq D.f ℓ (2 * (n - 1))).obj.map ι.op).hom) := by
    rw [injective_iff_map_eq_zero]
    intro t ht
    apply hinj
    apply hLinj
    rw [map_zero]
    exact ht
  obtain ⟨μ, hμ⟩ := alg
    (fun c => ((wcRqScalar D.f ℓ (2 * (n - 1)) c).hom.app (Opposite.op W)).hom)
    (L.comp ((wcRq D.f ℓ (2 * (n - 1))).obj.map ι.op).hom) hMinj
    (fun c t => by
      have hsc : ((wcRq D.f ℓ (2 * (n - 1))).obj.map ι.op).hom
          (((wcRqScalar D.f ℓ (2 * (n - 1)) c).hom.app (Opposite.op W)).hom t) =
          ((wcRqScalar D.f ℓ (2 * (n - 1)) c).hom.app (Opposite.op V₀)).hom
            (((wcRq D.f ℓ (2 * (n - 1))).obj.map ι.op).hom t) := by
        have hN := (wcRqScalar D.f ℓ (2 * (n - 1)) c).hom.naturality ι.op
        exact congrArg (fun m => m.hom t) hN.symm
      show L (((wcRq D.f ℓ (2 * (n - 1))).obj.map ι.op).hom
          (((wcRqScalar D.f ℓ (2 * (n - 1)) c).hom.app (Opposite.op W)).hom t)) =
        c * L (((wcRq D.f ℓ (2 * (n - 1))).obj.map ι.op).hom t)
      rw [hsc, hLsc])
    ((wcRq D.f ℓ (2 * (n - 1))).obj.map φ.op).hom
    (fun c t => by
      have hN := (wcRqScalar D.f ℓ (2 * (n - 1)) c).hom.naturality φ.op
      exact congrArg (fun m => m.hom t) hN.symm)
  exact ⟨μ, fun τ => hμ τ⟩

theorem wc_vqm_cup_form_hz (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hNI : ∃ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β ∧
      β ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n))
    (hhom : ∀ φ : (Subobject.underlying.obj (wcPencilE D ℓ hP)).over (wcGeomPoint F'' (wcP1Over F'') hP) ⟶
        (wcContSheaf (wcP1Over F'').left ℚ_[ℓ]).over (wcGeomPoint F'' (wcP1Over F'') hP), φ = 0)
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (r : ℕ)
    (θ : (wcPencilVQ D ℓ hP).over W ≅ (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W)
    (φ : W ⟶ W) (hB : wcVQGalFrame D ℓ hP W w r θ φ)
    (Γ : Subgroup (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) (Φ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ)
    (hΦ : wcVQFrame D ℓ hP W r θ φ (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]))
    (hΓ : ∀ h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ, h ∈ Γ ↔
      ∃ γ : W ⟶ W, γ ≫ w = w ∧ wcVQFrame D ℓ hP W r θ γ (h : Matrix (Fin r) (Fin r) ℚ_[ℓ])) :
    ∃ (J : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (μ : ℚ_[ℓ]), J.transpose = -J ∧ IsUnit J.det ∧ μ ≠ 0 ∧
      (∀ h ∈ Γ, (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]).transpose * J *
        (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]) = J) ∧
      (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]).transpose * J * (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]) =
        μ • J :=
by
  classical
  obtain ⟨hθc, -, hconn, hoffW, hcov, -, -, -, -, -⟩ := hB
  haveI := hconn

  have hcancel1 : ∀ (T : Over W) (s : ((wcPencilVQ D ℓ hP).over W).obj.obj (Opposite.op T)),
      (θ.inv.hom.app (Opposite.op T)).hom ((θ.hom.hom.app (Opposite.op T)).hom s) = s := by
    intro T s
    exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom s) θ.hom_inv_id
  have hcancel2 : ∀ (T : Over W)
      (x : ((wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W).obj.obj (Opposite.op T)),
      (θ.hom.hom.app (Opposite.op T)).hom ((θ.inv.hom.app (Opposite.op T)).hom x) = x := by
    intro T x
    exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom x) θ.inv_hom_id
  have hinjθ : ∀ (T : Over W) (s s' : ((wcPencilVQ D ℓ hP).over W).obj.obj (Opposite.op T)),
      (θ.hom.hom.app (Opposite.op T)).hom s = (θ.hom.hom.app (Opposite.op T)).hom s' → s = s' := by
    intro T s s' h
    rw [← hcancel1 T s, ← hcancel1 T s', h]
  have hext : ∀ (V : (wcP1Over F'').left.ProEt) (h : V ⟶ W)
      (s s' : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op V)),
      (∀ v : V.left, (show C(↥V.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk h))).hom s).down) v =
        (show C(↥V.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk h))).hom s').down) v) → s = s' := by
    intro V h s s' hv
    apply hinjθ (Over.mk h) s s'
    apply ULift.ext
    apply ContinuousMap.ext
    exact hv
  have hnat : ∀ (V V' : (wcP1Over F'').left.ProEt) (h : V ⟶ W) (a : V' ⟶ V) (h' : V' ⟶ W),
      a ≫ h = h' → ∀ (s : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op V)) (v : V'.left),
      (show C(↥V'.left, Fin r → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom
        (((wcPencilVQ D ℓ hP).obj.map a.op).hom s)).down) v =
      (show C(↥V.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk h))).hom s).down) (a.left v) := by
    rintro V V' h a h' rfl s v
    have hN := θ.hom.hom.naturality (Over.homMk a rfl : Over.mk (a ≫ h) ⟶ Over.mk h).op
    exact congrArg (fun m => (show C(↥V'.left, Fin r → ℚ_[ℓ]) from (m.hom s).down) v) hN
  have hconst : ∀ x : Fin r → ℚ_[ℓ], ∃ s : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op W),
      ∀ z : W.left, (show C(↥W.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z = x := by
    intro v
    let cv : (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op W) :=
      (show (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op W) from
        ULift.up (ContinuousMap.const ↥W.left v))
    refine ⟨(θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom cv, fun z => ?_⟩
    have hs := hcancel2 (Over.mk (𝟙 W)) cv
    exact congrArg (fun y : ULift.{u+1} C(↥W.left, Fin r → ℚ_[ℓ]) => y.down z) hs
  choose c hc using hconst

  obtain ⟨V₀, g₀, φ₀, A, iR, iH, iS, e, ε, hv, -, hε, hεφ⟩ :=
    wc_P1bar_strict_local_nbhd F'' D.u0 D.hu0 hP
  have hx₀ : ∀ i, V₀.hom (e.inv (IsLocalRing.closedPoint A)) ≠ D.S i (IsLocalRing.closedPoint F'') :=
    fun i => by rw [hv]; exact D.hu0S i
  have hgp : ∀ x : V₀.left, (wcGeomPoint F'' (wcP1Over F'') hP).hom (g₀.left x) = V₀.hom x := by
    intro x
    rw [← MorphismProperty.Over.w g₀, Scheme.Hom.comp_apply]
  obtain ⟨ι, -⟩ := wc_P1bar_strict_local_lift F'' hP W w V₀ g₀ A e
    (hcov _ (fun i => by rw [hgp]; exact hx₀ i))
  have hV₀off : ∀ (v : V₀.left) (i : Fin D.m), V₀.hom v ≠ D.S i (IsLocalRing.closedPoint F'') := by
    intro v i
    rw [← MorphismProperty.Over.w ι, Scheme.Hom.comp_apply]
    exact hoffW _ i

  have hV₀ : ConnectedSpace V₀.left := by
    have hspec : ∀ y : V₀.left, y ⤳ e.inv (IsLocalRing.closedPoint A) := by
      intro y
      have h1 : e.hom y ⤳ IsLocalRing.closedPoint A := IsLocalRing.specializes_closedPoint _
      have h2 := h1.map e.inv.continuous
      have h3 : e.inv (e.hom y) = y := by
        first
          | simp
          | (rw [← Scheme.Hom.comp_apply, e.hom_inv_id]; rfl)
          | exact congrArg (fun f : V₀.left ⟶ V₀.left => f y) e.hom_inv_id
      rwa [h3] at h2
    rw [connectedSpace_iff_clopen]
    refine ⟨⟨e.inv (IsLocalRing.closedPoint A)⟩, fun U hU => ?_⟩
    by_cases h0 : e.inv (IsLocalRing.closedPoint A) ∈ U
    · right
      ext y
      simp only [Set.mem_univ, iff_true]
      exact (hspec y).mem_open hU.isOpen h0
    · left
      ext y
      simp only [Set.mem_empty_iff_false, iff_false]
      intro hy
      exact ((hspec y).mem_open hU.compl.isOpen h0) hy
  haveI := hV₀

  have hclosed : IsClosed ({V₀.hom (e.inv (IsLocalRing.closedPoint A))} :
      Set (wcP1Over F'').left) := by
    have hcl := (wc_P1_sections_closed_generize F'' 1 (fun _ => D.u0) (fun _ => D.hu0)).1
    have hset : {p : (wcP1Over F'').left | ∃ i : Fin 1, p = D.u0 (IsLocalRing.closedPoint F'')} =
        {V₀.hom (e.inv (IsLocalRing.closedPoint A))} := by
      ext p
      rw [Set.mem_setOf_eq, Set.mem_singleton_iff, hv]
      constructor
      · rintro ⟨_, h⟩; exact h
      · intro h; exact ⟨0, h⟩
    rw [← hset]
    exact hcl

  obtain ⟨B, hBnat, hBsc, hBalt, hBperf⟩ :=
    wc_pencil_Rq_cup_pairing_alt F' F'' Y n hn hn2 D ℓ hℓ hP
  have hE := wc_vqm_hz_E_hom_zero_offS F' F'' Y n D ℓ hP hhom
  have hO := wc_vqm_hz_EC_orth_offS F' F'' Y n hn hn2 D ℓ hℓ hP B hBnat hE
  have hcount := wc_vqm_hz_EC_rank_ge F' F'' Y n hn hn2 D ℓ hℓ hP
  obtain ⟨B', hB'nat, hB'sc, hB'alt, hB'perf⟩ :=
    wc_vqm_hz_VQ_pairing F' F'' Y n hn hn2 D ℓ hℓ hP B hBnat hBsc hBalt hBperf hO hcount
  have hperf := hB'perf V₀ hV₀off A e hclosed
  obtain ⟨L, hLinj, hLsc⟩ :=
    wc_pencil_R2_u0_strict_line F' F'' Y n hn2 D ℓ hℓ V₀ φ₀ A e ε hv hε hεφ

  obtain ⟨v0⟩ : Nonempty V₀.left := ⟨e.inv (IsLocalRing.closedPoint A)⟩
  have hlc : ∀ (f : C(↥V₀.left, Fin r → ℚ_[ℓ])) (v : V₀.left), f v = f v0 := by
    intro f v
    exact (isPreconnected_range f.continuous).subsingleton ⟨v, rfl⟩ ⟨v0, rfl⟩
  let τ : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op V₀) →+ (Fin r → ℚ_[ℓ]) :=
    AddMonoidHom.mk' (fun t => (show C(↥V₀.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk ι))).hom t).down) v0)
      (fun t t' => by
        have h := map_add (θ.hom.hom.app (Opposite.op (Over.mk ι))).hom t t'
        exact congrArg (fun y : ULift.{u+1} C(↥V₀.left, Fin r → ℚ_[ℓ]) => y.down v0) h)
  have hτsc : ∀ (a : ℚ_[ℓ]) (t : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op V₀)),
      τ (((wcPencilVQScalar D ℓ hP a).hom.app (Opposite.op V₀)).hom t) = a • τ t := by
    intro a t
    have h := congrArg (fun m => (m.hom.app (Opposite.op (Over.mk ι))).hom t) (hθc a)
    exact congrArg (fun y : ULift.{u+1} C(↥V₀.left, Fin r → ℚ_[ℓ]) => y.down v0) h
  have hτc : ∀ x, τ (((wcPencilVQ D ℓ hP).obj.map ι.op).hom (c x)) = x := by
    intro x
    show (show C(↥V₀.left, Fin r → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk ι))).hom
      (((wcPencilVQ D ℓ hP).obj.map ι.op).hom (c x))).down) v0 = x
    rw [hnat W V₀ (𝟙 W) ι ι (Category.comp_id ι) (c x) v0, hc]
  have hτinj : Function.Injective τ := by
    rw [injective_iff_map_eq_zero]
    intro t ht
    apply hext V₀ ι t 0
    intro v
    have h1 : (show C(↥V₀.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk ι))).hom t).down) v = τ t := hlc _ v
    have h2 : (show C(↥V₀.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk ι))).hom 0).down) v = 0 := by
      have h := map_zero (θ.hom.hom.app (Opposite.op (Over.mk ι))).hom
      exact congrArg (fun y : ULift.{u+1} C(↥V₀.left, Fin r → ℚ_[ℓ]) => y.down v) h
    rw [h1, ht]
    exact h2.symm
  have hτsurj : Function.Surjective τ := fun x =>
    ⟨((wcPencilVQ D ℓ hP).obj.map ι.op).hom (c x), hτc x⟩
  let eτ := AddEquiv.ofBijective τ ⟨hτinj, hτsurj⟩
  have heτ : ∀ t, eτ t = τ t := fun t => rfl
  have hσsc : ∀ (a : ℚ_[ℓ]) (x : Fin r → ℚ_[ℓ]), eτ.symm (a • x) =
      ((wcPencilVQScalar D ℓ hP a).hom.app (Opposite.op V₀)).hom (eτ.symm x) := by
    intro a x
    apply eτ.injective
    rw [AddEquiv.apply_symm_apply, heτ, hτsc, ← heτ, AddEquiv.apply_symm_apply]
  have hσc : ∀ x, eτ.symm x = ((wcPencilVQ D ℓ hP).obj.map ι.op).hom (c x) := by
    intro x
    apply eτ.injective
    rw [AddEquiv.apply_symm_apply, heτ, hτc]

  let Bil : (Fin r → ℚ_[ℓ]) → (Fin r → ℚ_[ℓ]) → ℚ_[ℓ] := fun x y =>
    L (B' V₀ hV₀off (eτ.symm x) (eτ.symm y))
  have hBalt' : ∀ x y, Bil x y = -Bil y x := by
    intro x y
    show L (B' V₀ hV₀off (eτ.symm x) (eτ.symm y)) = -L (B' V₀ hV₀off (eτ.symm y) (eτ.symm x))
    rw [hB'alt V₀ hV₀off (eτ.symm x) (eτ.symm y), map_neg]
  have hadd1 : ∀ x x' y, Bil (x + x') y = Bil x y + Bil x' y := by
    intro x x' y
    show L (B' V₀ hV₀off (eτ.symm (x + x')) (eτ.symm y)) =
      L (B' V₀ hV₀off (eτ.symm x) (eτ.symm y)) + L (B' V₀ hV₀off (eτ.symm x') (eτ.symm y))
    simp only [map_add, AddMonoidHom.add_apply]
  have hsmul1 : ∀ (a : ℚ_[ℓ]) x y, Bil (a • x) y = a • Bil x y := by
    intro a x y
    show L (B' V₀ hV₀off (eτ.symm (a • x)) (eτ.symm y)) =
      a • L (B' V₀ hV₀off (eτ.symm x) (eτ.symm y))
    rw [hσsc, hB'sc, hLsc, smul_eq_mul]
  have hadd2 : ∀ x y y', Bil x (y + y') = Bil x y + Bil x y' := by
    intro x y y'
    linear_combination hBalt' x (y + y') - hadd1 y y' x - hBalt' x y - hBalt' x y'
  have hsmul2 : ∀ (a : ℚ_[ℓ]) x y, Bil x (a • y) = a • Bil x y := by
    intro a x y
    have h := hsmul1 a y x
    rw [smul_eq_mul] at h
    rw [smul_eq_mul]
    linear_combination hBalt' x (a • y) - h - a * hBalt' x y
  let β : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] ℚ_[ℓ] :=
    LinearMap.mk₂ ℚ_[ℓ] Bil hadd1 hsmul1 hadd2 hsmul2
  have hβ : ∀ x y, β x y = Bil x y := fun x y => rfl
  have hnd : ∀ y, (∀ x, β x y = 0) → y = 0 := by
    intro y hy
    have h1 : ∀ t, B' V₀ hV₀off t (eτ.symm y) = 0 := by
      intro t
      apply hLinj
      have h2 : L (B' V₀ hV₀off (eτ.symm (eτ t)) (eτ.symm y)) = 0 := hy (eτ t)
      rw [AddEquiv.symm_apply_apply] at h2
      rw [h2, map_zero]
    have h1' : ∀ t, B' V₀ hV₀off (eτ.symm y) t = 0 := by
      intro t
      rw [hB'alt, h1, neg_zero]
    have h3 := hperf (eτ.symm y) h1'
    rw [← AddEquiv.apply_symm_apply eτ y, h3, map_zero]

  obtain ⟨J, hJdef⟩ : ∃ J : Matrix (Fin r) (Fin r) ℚ_[ℓ], J = LinearMap.toMatrix₂' ℚ_[ℓ] β :=
    ⟨_, rfl⟩
  have hgram : ∀ x y, dotProduct x (J.mulVec y) = β x y := by
    intro x y
    rw [← Matrix.toLinearMap₂'_apply', hJdef, Matrix.toLinearMap₂'_toMatrix']
  have hJt : J.transpose = -J := by
    ext a b
    rw [Matrix.transpose_apply, Matrix.neg_apply, hJdef, LinearMap.toMatrix₂'_apply,
      LinearMap.toMatrix₂'_apply, hβ, hβ]
    exact hBalt' _ _
  have hJdet : IsUnit J.det := by
    have hinjJ : Function.Injective J.mulVec := by
      intro y₁ y₂ hy
      have h0 : J.mulVec (y₁ - y₂) = 0 := by rw [Matrix.mulVec_sub, hy, sub_self]
      have h4 : y₁ - y₂ = 0 := hnd _ (fun x => by rw [← hgram, h0, dotProduct_zero])
      exact sub_eq_zero.mp h4
    exact (Matrix.isUnit_iff_isUnit_det J).mp (Matrix.mulVec_injective_iff_isUnit.mp hinjJ)

  have hpullgen : ∀ (γ : W ⟶ W) (M : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ),
      wcVQFrame D ℓ hP W r θ γ (M : Matrix (Fin r) (Fin r) ℚ_[ℓ]) →
      ∀ x, ((wcPencilVQ D ℓ hP).obj.map γ.op).hom
        (c ((M : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec x)) = c x := by
    intro γ M hfr x
    have hMinj : Function.Injective (M : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec := by
      intro a b hab
      have h := congrArg ((↑M⁻¹ : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec) hab
      rwa [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, ← Units.val_mul, inv_mul_cancel,
        Units.val_one, Matrix.one_mulVec, Matrix.one_mulVec] at h
    apply hext W (𝟙 W)
    intro z
    rw [hc x z]
    apply hMinj
    have h1 := hfr (((wcPencilVQ D ℓ hP).obj.map γ.op).hom
      (c ((M : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec x))) z
    refine h1.symm.trans ?_
    rw [hnat W W (𝟙 W) γ γ (Category.comp_id γ) _ z, hc]
  have hres : ∀ x y, β x y = L (((wcRq D.f ℓ (2 * (n - 1))).obj.map ι.op).hom
      (B' W hoffW (c x) (c y))) := by
    intro x y
    show L (B' V₀ hV₀off (eτ.symm x) (eτ.symm y)) = _
    rw [hσc x, hσc y, hB'nat W V₀ hoffW hV₀off ι]

  have hΓJ : ∀ h ∈ Γ, (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]).transpose * J *
      (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]) = J := by
    intro h hh
    obtain ⟨γ, hγ, hfr⟩ := (hΓ h).mp hh
    have hpull := hpullgen γ h hfr
    have hdeck := wc_pencil_R2_deck_trivial F' F'' Y n hn hn2 D ℓ hℓ hP W w hconn hoffW γ hγ
    have hWinv : ∀ x y, B' W hoffW (c ((h : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec x))
        (c ((h : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec y)) = B' W hoffW (c x) (c y) := by
      intro x y
      have e1 := hB'nat W W hoffW hoffW γ (c ((h : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec x))
        (c ((h : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec y))
      rw [hpull x, hpull y, hdeck] at e1
      exact e1.symm
    have hinv : ∀ x y, β ((h : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec x)
        ((h : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec y) = β x y := by
      intro x y
      rw [hres, hres, hWinv]
    have hcomp : β.compl₁₂ (Matrix.toLin' (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]))
        (Matrix.toLin' (h : Matrix (Fin r) (Fin r) ℚ_[ℓ])) = β :=
      LinearMap.ext₂ (fun x y => by
        rw [LinearMap.compl₁₂_apply, Matrix.toLin'_apply, Matrix.toLin'_apply, hinv])
    have key := LinearMap.toMatrix₂'_compl₁₂ β (Matrix.toLin' (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]))
      (Matrix.toLin' (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]))
    rw [hcomp, LinearMap.toMatrix'_toLin'] at key
    rw [hJdef]
    exact key.symm

  have hpullΦ := hpullgen φ Φ hΦ
  obtain ⟨μ₀, hμ₀⟩ := wc_vqm_hz_R2_endo_scalar F' F'' Y n hn hn2 D ℓ hℓ hP W w hconn hoffW hcov φ
  have hscnat : ∀ t : (wcRq D.f ℓ (2 * (n - 1))).obj.obj (Opposite.op W),
      ((wcRq D.f ℓ (2 * (n - 1))).obj.map ι.op).hom
        (((wcRqScalar D.f ℓ (2 * (n - 1)) μ₀).hom.app (Opposite.op W)).hom t) =
      ((wcRqScalar D.f ℓ (2 * (n - 1)) μ₀).hom.app (Opposite.op V₀)).hom
        (((wcRq D.f ℓ (2 * (n - 1))).obj.map ι.op).hom t) := by
    intro t
    have hN := (wcRqScalar D.f ℓ (2 * (n - 1)) μ₀).hom.naturality ι.op
    exact congrArg (fun m => m.hom t) hN.symm
  have hrelΦ : ∀ x y, β x y = μ₀ * β ((Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec x)
      ((Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec y) := by
    intro x y
    have e1 := hB'nat W W hoffW hoffW φ (c ((Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec x))
      (c ((Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec y))
    rw [hpullΦ x, hpullΦ y, hμ₀] at e1
    rw [hres, hres, e1, hscnat, hLsc]
  by_cases hμ0 : μ₀ = 0
  · have hβ0 : ∀ x y, β x y = 0 := fun x y => by rw [hrelΦ, hμ0, zero_mul]
    have hJ0 : J = 0 := by
      ext a b
      rw [hJdef, LinearMap.toMatrix₂'_apply, hβ0, Matrix.zero_apply]
    refine ⟨J, 1, hJt, hJdet, one_ne_zero, hΓJ, ?_⟩
    rw [hJ0, Matrix.mul_zero, Matrix.zero_mul, smul_zero]
  · refine ⟨J, μ₀⁻¹, hJt, hJdet, inv_ne_zero hμ0, hΓJ, ?_⟩
    have hrel : ∀ x y, β ((Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec x)
        ((Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec y) = μ₀⁻¹ * β x y := by
      intro x y
      rw [hrelΦ x y, ← mul_assoc, inv_mul_cancel₀ hμ0, one_mul]
    have hcomp : β.compl₁₂ (Matrix.toLin' (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]))
        (Matrix.toLin' (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ])) = μ₀⁻¹ • β :=
      LinearMap.ext₂ (fun x y => by
        rw [LinearMap.compl₁₂_apply, Matrix.toLin'_apply, Matrix.toLin'_apply, hrel,
          LinearMap.smul_apply, LinearMap.smul_apply, smul_eq_mul])
    have key := LinearMap.toMatrix₂'_compl₁₂ β (Matrix.toLin' (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]))
      (Matrix.toLin' (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]))
    rw [hcomp, LinearMap.toMatrix'_toLin', map_smul] at key
    rw [hJdef]
    exact key.symm

theorem wc_vqm_inertia_transport (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
    (hconn : ConnectedSpace W.left)
    (hoff : ∀ (z : W.left) (i : Fin D.m), W.hom z ≠ D.S i (IsLocalRing.closedPoint F''))
    (hgal : ∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ W), ConnectedSpace V.left →
      a ≫ w = b ≫ w → ∃ γ : W ⟶ W, γ ≫ w = w ∧ b = a ≫ γ)
    (i : Fin D.m) (V₁ : (wcP1Over F'').left.ProEt) (v₁ : V₁ ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
    (A₁ : Type u) [CommRing A₁] [HenselianLocalRing A₁]
    [IsSepClosed (IsLocalRing.ResidueField A₁)] (e₁ : V₁.left ≅ Spec (.of A₁))
    (hV₁ : V₁.hom (e₁.inv (IsLocalRing.closedPoint A₁)) = D.S i (IsLocalRing.closedPoint F''))
    (T₁ : (wcP1Over F'').left.ProEt) (u₁ : T₁ ⟶ V₁) (c₁ : T₁ ⟶ W)
    (L₁ : Type u) [Field L₁] [IsSepClosed L₁] (eL₁ : T₁.left ≅ Spec (.of L₁))
    (hc₁ : u₁ ≫ v₁ = c₁ ≫ w) (σ' : W ⟶ W) (hσ' : wcHonestIsInertia D hP W w i σ') :
    ∃ (γ γ' : W ⟶ W) (τ₁ : T₁ ⟶ T₁), γ ≫ w = w ∧ γ' ≫ w = w ∧ γ ≫ γ' = 𝟙 W ∧
      γ' ≫ γ = 𝟙 W ∧ τ₁ ≫ u₁ = u₁ ∧ τ₁ ≫ c₁ = c₁ ≫ (γ ≫ σ' ≫ γ') :=
by
  obtain ⟨_hσw, V', v', A', iA1, iA2, iA3, e', hV', L', iL1, iL2, Vt', eVt', u'', c', τ',
    hc', hτu, hτc⟩ := hσ'
  have hT₁ : ∀ z : T₁.left, T₁.hom z ≠ D.S i (IsLocalRing.closedPoint F'') := by
    intro z
    rw [← MorphismProperty.Over.w c₁, Scheme.Hom.comp_apply]
    exact hoff _ i
  have hVt' : ∀ z : Vt'.left, Vt'.hom z ≠ D.S i (IsLocalRing.closedPoint F'') := by
    intro z
    rw [← MorphismProperty.Over.w c', Scheme.Hom.comp_apply]
    exact hoff _ i
  obtain ⟨β, κ, hβ, hκ⟩ := wc_pencil_PL_sep_point_iso F'' hP (D.S i) (D.hS i)
    V₁ v₁ A₁ e₁ hV₁ T₁ u₁ L₁ eL₁ hT₁ V' v' A' e' hV' Vt' u'' L' eVt' hVt'
  have hconnT : ConnectedSpace T₁.left :=
    (Homeomorph.connectedSpace_iff (Scheme.homeoOfIso eL₁)).mpr inferInstance
  have hw : c₁ ≫ w = (κ.hom ≫ c') ≫ w := by
    rw [Category.assoc, ← hc', ← Category.assoc, hκ, Category.assoc, hβ, hc₁]
  obtain ⟨γ, hγ, hγc⟩ := hgal T₁ c₁ (κ.hom ≫ c') hconnT hw
  obtain ⟨γ', hγ', h1⟩ := hgal W γ (𝟙 W) hconn (by rw [hγ, Category.id_comp])
  obtain ⟨γ'', _hγ'', h2⟩ := hgal W γ' (𝟙 W) hconn (by rw [hγ', Category.id_comp])
  have hγγ'' : γ'' = γ := by
    calc γ'' = (γ ≫ γ') ≫ γ'' := by rw [← h1, Category.id_comp]
      _ = γ ≫ (γ' ≫ γ'') := Category.assoc _ _ _
      _ = γ := by rw [← h2, Category.comp_id]
  have hγ'γ : γ' ≫ γ = 𝟙 W := by rw [← hγγ'', ← h2]
  have ha : u₁ = κ.hom ≫ u'' ≫ β.inv := by
    rw [← Category.assoc, hκ, Category.assoc, Iso.hom_inv_id, Category.comp_id]
  have hc : c₁ = κ.hom ≫ c' ≫ γ' := by
    rw [← Category.assoc, hγc, Category.assoc, ← h1, Category.comp_id]
  refine ⟨γ, γ', κ.hom ≫ τ' ≫ κ.inv, hγ, hγ', h1.symm, hγ'γ, ?_, ?_⟩
  · calc (κ.hom ≫ τ' ≫ κ.inv) ≫ u₁ = (κ.hom ≫ τ' ≫ κ.inv) ≫ κ.hom ≫ u'' ≫ β.inv := by
          rw [← ha]
      _ = κ.hom ≫ (τ' ≫ u'') ≫ β.inv := by simp only [Category.assoc, Iso.inv_hom_id_assoc]
      _ = u₁ := by rw [hτu, ha]
  · calc (κ.hom ≫ τ' ≫ κ.inv) ≫ c₁ = (κ.hom ≫ τ' ≫ κ.inv) ≫ κ.hom ≫ c' ≫ γ' := by
          rw [← hc]
      _ = κ.hom ≫ (τ' ≫ c') ≫ γ' := by simp only [Category.assoc, Iso.inv_hom_id_assoc]
      _ = (κ.hom ≫ c') ≫ σ' ≫ γ' := by rw [hτc]; simp only [Category.assoc]
      _ = c₁ ≫ (γ ≫ σ' ≫ γ') := by rw [hγc, Category.assoc]

theorem wc_pencil_R_local_inertia_line (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt) (v : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (T : (wcP1Over F'').left.ProEt) (u : T ⟶ V) (L : Type u) [Field L] [IsSepClosed L]
    (eL : T.left ≅ Spec (.of L))
    (hT : ∀ (z : T.left) (j : Fin D.m), T.hom z ≠ D.S j (IsLocalRing.closedPoint F'')) :
    ∃ (φR : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op T) →+ ℚ_[ℓ])
      (δ : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op T)),
      (∀ (c : ℚ_[ℓ]) (t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op T)),
        φR (((wcRqScalar D.f ℓ (n - 1) c).hom.app (Opposite.op T)).hom t) = c * φR t) ∧
      ∀ τ : T ⟶ T, τ ≫ u = u → ∃ a : ℚ_[ℓ],
        ∀ t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op T),
          ((wcRq D.f ℓ (n - 1)).obj.map τ.op).hom t =
            t + ((wcRqScalar D.f ℓ (n - 1) (a * φR t)).hom.app (Opposite.op T)).hom δ :=
by
  classical

  obtain ⟨W, w, r, θ, hθc, hqc, hconn, hoff, hcov, hgal⟩ :=
    wc_pencil_PL_galois_cover F' F'' Y n hn hn2 D ℓ hℓ hP
  obtain ⟨J, -, hJ, hJinv⟩ :=
    wc_pencil_PL_cup_form F' F'' Y n hn hn2 D ℓ hℓ hP W w r θ hθc hqc hconn hoff hcov hgal

  obtain ⟨c₀, hc₀⟩ := wc_pencil_PL_lift_to_cover F'' hP D.m D.S W w hcov T L eL hT (u ≫ v)

  obtain ⟨-, hcodim⟩ :=
    wc_pencil_PL_specialization F' F'' Y n hn hn2 D ℓ hℓ i V A e hV T u L eL hT

  have hcancel1 : ∀ (X : Over W)
      (s : ((wcRq D.f ℓ (n - 1)).over W).obj.obj (Opposite.op X)),
      (θ.inv.hom.app (Opposite.op X)).hom ((θ.hom.hom.app (Opposite.op X)).hom s) = s := by
    intro X s
    exact congrArg (fun m => (m.hom.app (Opposite.op X)).hom s) θ.hom_inv_id
  have hcancel2 : ∀ (X : Over W)
      (c : ((wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W).obj.obj (Opposite.op X)),
      (θ.hom.hom.app (Opposite.op X)).hom ((θ.inv.hom.app (Opposite.op X)).hom c) = c := by
    intro X c
    exact congrArg (fun m => (m.hom.app (Opposite.op X)).hom c) θ.inv_hom_id

  have hRcomp : ∀ {X Y Z : (wcP1Over F'').left.ProEt} (f : X ⟶ Y) (g : Y ⟶ Z)
      (t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op Z)),
      ((wcRq D.f ℓ (n - 1)).obj.map (f ≫ g).op).hom t =
        ((wcRq D.f ℓ (n - 1)).obj.map f.op).hom (((wcRq D.f ℓ (n - 1)).obj.map g.op).hom t) := by
    intro X Y Z f g t
    rw [op_comp, Functor.map_comp]
    rfl
  have hRsc : ∀ {X Y : (wcP1Over F'').left.ProEt} (f : X ⟶ Y) (c : ℚ_[ℓ])
      (t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op Y)),
      ((wcRq D.f ℓ (n - 1)).obj.map f.op).hom
          (((wcRqScalar D.f ℓ (n - 1) c).hom.app (Opposite.op Y)).hom t) =
        ((wcRqScalar D.f ℓ (n - 1) c).hom.app (Opposite.op X)).hom
          (((wcRq D.f ℓ (n - 1)).obj.map f.op).hom t) := by
    intro X Y f c t
    exact (congrArg (fun m => m.hom t) ((wcRqScalar D.f ℓ (n - 1) c).hom.naturality f.op)).symm

  have hTsub : ∀ z z' : T.left, z = z' := by
    intro z z'
    have h : eL.hom z = eL.hom z' := Subsingleton.elim (α := PrimeSpectrum L) _ _
    have h2 := congrArg (fun p => eL.inv p) h
    simpa using h2
  set z₀ : T.left := eL.inv (IsLocalRing.closedPoint L) with hz₀
  haveI : Subsingleton T.left := ⟨hTsub⟩
  haveI : Nonempty T.left := ⟨z₀⟩
  have hTconn : ConnectedSpace T.left := inferInstance

  obtain ⟨Θ, hΘ⟩ : ∃ Θ : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op T) → (Fin r → ℚ_[ℓ]),
      ∀ t, Θ t = (show C(↥T.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk c₀))).hom t).down) z₀ := ⟨_, fun _ => rfl⟩
  have hΘadd : ∀ t₁ t₂, Θ (t₁ + t₂) = Θ t₁ + Θ t₂ := by
    intro t₁ t₂
    refine (hΘ _).trans ((congrArg (fun y : ULift.{u+1} C(↥T.left, Fin r → ℚ_[ℓ]) => y.down z₀)
      (map_add (θ.hom.hom.app (Opposite.op (Over.mk c₀))).hom t₁ t₂)).trans ?_)
    rw [hΘ t₁, hΘ t₂]
    rfl
  have hΘ0 : Θ 0 = 0 := by
    refine (hΘ _).trans ((congrArg (fun y : ULift.{u+1} C(↥T.left, Fin r → ℚ_[ℓ]) => y.down z₀)
      (map_zero (θ.hom.hom.app (Opposite.op (Over.mk c₀))).hom)).trans ?_)
    rfl
  have hΘsc : ∀ (c : ℚ_[ℓ]) t,
      Θ (((wcRqScalar D.f ℓ (n - 1) c).hom.app (Opposite.op T)).hom t) = c • Θ t := by
    intro c t
    rw [hΘ, hΘ]
    exact congrArg (fun m => (show C(↥T.left, Fin r → ℚ_[ℓ]) from
      ((m.hom.app (Opposite.op (Over.mk c₀))).hom t).down) z₀) (hθc c)
  have hΘinj : ∀ t₁ t₂, Θ t₁ = Θ t₂ → t₁ = t₂ := by
    intro t₁ t₂ h
    rw [hΘ, hΘ] at h
    have e' : (θ.hom.hom.app (Opposite.op (Over.mk c₀))).hom t₁ =
        (θ.hom.hom.app (Opposite.op (Over.mk c₀))).hom t₂ := by
      apply ULift.ext
      apply ContinuousMap.ext
      intro z
      rw [hTsub z z₀]
      exact h
    have := congrArg (θ.inv.hom.app (Opposite.op (Over.mk c₀))).hom e'
    exact (hcancel1 (Over.mk c₀) t₁).symm.trans (this.trans (hcancel1 (Over.mk c₀) t₂))
  have hΘsurj : ∀ x, ∃ t, Θ t = x := by
    intro x
    let c : ((wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W).obj.obj
        (Opposite.op (Over.mk c₀)) :=
      (show ((wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W).obj.obj
          (Opposite.op (Over.mk c₀)) from
        (ULift.up (ContinuousMap.const ↥T.left x) : ULift.{u+1} C(↥T.left, Fin r → ℚ_[ℓ])))
    refine ⟨(θ.inv.hom.app (Opposite.op (Over.mk c₀))).hom c, (hΘ _).trans ?_⟩
    have hs := hcancel2 (Over.mk c₀) c
    exact congrArg (fun y : ULift.{u+1} C(↥T.left, Fin r → ℚ_[ℓ]) => y.down z₀) hs

  obtain ⟨P, hP'⟩ : ∃ P : Submodule ℚ_[ℓ] (Fin r → ℚ_[ℓ]), ∀ x, x ∈ P ↔
      ∃ s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V),
        Θ (((wcRq D.f ℓ (n - 1)).obj.map u.op).hom s) = x :=
    ⟨{ carrier := {x | ∃ s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V),
          Θ (((wcRq D.f ℓ (n - 1)).obj.map u.op).hom s) = x}
       add_mem' := by
         rintro _ _ ⟨s₁, rfl⟩ ⟨s₂, rfl⟩
         exact ⟨s₁ + s₂, by rw [map_add, hΘadd]⟩
       zero_mem' := ⟨0, by rw [map_zero, hΘ0]⟩
       smul_mem' := by
         rintro c _ ⟨s, rfl⟩
         exact ⟨((wcRqScalar D.f ℓ (n - 1) c).hom.app (Opposite.op V)).hom s,
           by rw [hRsc, hΘsc]⟩ },
     fun x => Iff.rfl⟩

  have hcod : ∀ x y : Fin r → ℚ_[ℓ], ∃ c₁ c₂ : ℚ_[ℓ], (c₁ ≠ 0 ∨ c₂ ≠ 0) ∧
      c₁ • x + c₂ • y ∈ P := by
    intro x y
    obtain ⟨t₁, rfl⟩ := hΘsurj x
    obtain ⟨t₂, rfl⟩ := hΘsurj y
    obtain ⟨c₁, c₂, hne, s, hs⟩ := hcodim t₁ t₂
    refine ⟨c₁, c₂, hne, (hP' _).mpr ⟨s, ?_⟩⟩
    rw [hs, hΘadd, hΘsc, hΘsc]

  have hLA : ∃ lam δ : Fin r → ℚ_[ℓ], ∀ M : Matrix (Fin r) (Fin r) ℚ_[ℓ],
      (∀ p ∈ P, M.mulVec p = p) → M.transpose * J * M = J →
      ∃ a : ℚ_[ℓ], ∀ y : Fin r → ℚ_[ℓ], M.mulVec y = y + (a * (lam ⬝ᵥ y)) • δ := by
    classical
    by_cases hall : ∀ y, y ∈ P
    · refine ⟨0, 0, fun M hfix _ => ⟨0, fun y => ?_⟩⟩
      rw [hfix y (hall y), smul_zero, add_zero]
    push Not at hall
    obtain ⟨x₀, hx₀⟩ := hall
    have hB1 : ∀ y, ∃ β : ℚ_[ℓ], y - β • x₀ ∈ P := by
      intro y
      obtain ⟨c₁, c₂, hc, hmem⟩ := hcod x₀ y
      have hc2 : c₂ ≠ 0 := by
        intro h0
        rcases hc with h1 | h1
        · apply hx₀
          rw [h0, zero_smul, add_zero] at hmem
          have := P.smul_mem c₁⁻¹ hmem
          rwa [smul_smul, inv_mul_cancel₀ h1, one_smul] at this
        · exact h1 h0
      refine ⟨-(c₂⁻¹ * c₁), ?_⟩
      have := P.smul_mem c₂⁻¹ hmem
      rw [smul_add, smul_smul, smul_smul, inv_mul_cancel₀ hc2, one_smul] at this
      rw [neg_smul, sub_neg_eq_add, add_comm]
      exact this
    choose β hβ using hB1
    obtain ⟨lam, hlam⟩ : ∃ lam : Fin r → ℚ_[ℓ], ∀ j, lam j = β (Pi.single j 1) := ⟨_, fun _ => rfl⟩
    have hpy : ∀ y, y - (lam ⬝ᵥ y) • x₀ ∈ P := by
      intro y
      have e : y - (lam ⬝ᵥ y) • x₀ = ∑ j, y j • (Pi.single j 1 - β (Pi.single j 1) • x₀) := by
        ext i
        rw [Finset.sum_apply]
        simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul, dotProduct, hlam]
        simp only [mul_sub, Finset.sum_sub_distrib, Finset.sum_mul]
        congr 1
        · simp [Pi.single_apply]
        · exact Finset.sum_congr rfl (fun j _ => by ring)
      rw [e]
      exact P.sum_mem (fun j _ => P.smul_mem _ (hβ _))
    refine ⟨lam, J⁻¹.mulVec lam, fun M hfix hiso => ?_⟩
    have hB : ∀ x y, (M.mulVec x) ⬝ᵥ (J.mulVec (M.mulVec y)) = x ⬝ᵥ (J.mulVec y) := by
      intro x y
      rw [← Matrix.vecMul_transpose, ← Matrix.dotProduct_mulVec, Matrix.mulVec_mulVec,
        Matrix.mulVec_mulVec, hiso]
    obtain ⟨w, hw⟩ : ∃ w, w = M.mulVec x₀ - x₀ := ⟨_, rfl⟩
    have hMy : ∀ y, M.mulVec y = y + (lam ⬝ᵥ y) • w := by
      intro y
      have hp := hfix _ (hpy y)
      calc M.mulVec y = M.mulVec (y - (lam ⬝ᵥ y) • x₀) + (lam ⬝ᵥ y) • M.mulVec x₀ := by
            rw [← Matrix.mulVec_smul, ← Matrix.mulVec_add, sub_add_cancel]
        _ = (y - (lam ⬝ᵥ y) • x₀) + (lam ⬝ᵥ y) • M.mulVec x₀ := by rw [hp]
        _ = y + (lam ⬝ᵥ y) • w := by rw [hw, smul_sub]; abel
    have hperp : ∀ p ∈ P, p ⬝ᵥ (J.mulVec w) = 0 := by
      intro p hp
      have h := hB p x₀
      rw [hfix p hp] at h
      rw [hw, Matrix.mulVec_sub, dotProduct_sub, h, sub_self]
    obtain ⟨κ, hκ⟩ : ∃ κ, κ = (J.mulVec w) ⬝ᵥ x₀ := ⟨_, rfl⟩
    have hv : J.mulVec w = κ • lam := by
      ext j
      have h0 := hperp _ (hpy (Pi.single j 1))
      rw [dotProduct_comm, dotProduct_sub, dotProduct_smul, dotProduct_single_one,
        dotProduct_single_one, smul_eq_mul, sub_eq_zero, ← hκ] at h0
      rw [h0, Pi.smul_apply, smul_eq_mul, mul_comm]
    have hw' : w = κ • (J⁻¹.mulVec lam) := by
      have e1 : w = J⁻¹.mulVec (J.mulVec w) := by
        rw [Matrix.mulVec_mulVec, Matrix.nonsing_inv_mul J hJ, Matrix.one_mulVec]
      rw [e1, hv, Matrix.mulVec_smul]
    refine ⟨κ, fun y => ?_⟩
    rw [hMy, hw', smul_smul, mul_comm]
  obtain ⟨lam, δ, hline⟩ := hLA

  have hframe : ∀ τ : T ⟶ T, τ ≫ u = u → ∃ M : Matrix (Fin r) (Fin r) ℚ_[ℓ],
      (∀ t, Θ (((wcRq D.f ℓ (n - 1)).obj.map τ.op).hom t) = M.mulVec (Θ t)) ∧
      M.transpose * J * M = J := by
    intro τ hτ
    obtain ⟨σ, hσw, hσ⟩ := hgal T (τ ≫ c₀) c₀ hTconn
      (by rw [Category.assoc, hc₀, ← Category.assoc, hτ])
    obtain ⟨Afr, hAfr⟩ :=
      wc_proet_deck_frame_linear (wcP1Over F'').left ℓ (wcRq D.f ℓ (n - 1)) W hconn r θ σ
    refine ⟨LinearMap.toMatrix' Afr, fun t => ?_,
      hJinv σ hσw Afr (fun s z => hAfr W (𝟙 W) σ (Category.id_comp σ).symm s z)⟩
    rw [LinearMap.toMatrix'_mulVec, hΘ, hΘ]
    have h2 := hAfr T (τ ≫ c₀) c₀ hσ (((wcRq D.f ℓ (n - 1)).obj.map τ.op).hom t) z₀
    refine h2.trans ?_
    congr 1
    have hnat := θ.hom.hom.naturality
      (Over.homMk τ rfl : Over.mk (τ ≫ c₀) ⟶ Over.mk c₀).op
    have h1 := congrArg (fun m => (show C(↥T.left, Fin r → ℚ_[ℓ]) from
      (m.hom t).down) z₀) hnat
    refine h1.trans ?_
    show (show C(↥T.left, Fin r → ℚ_[ℓ]) from
      ((θ.hom.hom.app (Opposite.op (Over.mk c₀))).hom t).down) (τ.left z₀) = _
    rw [hTsub (τ.left z₀) z₀]

  obtain ⟨δR, hδR⟩ := hΘsurj δ
  refine ⟨AddMonoidHom.mk' (fun t => lam ⬝ᵥ Θ t) (fun t₁ t₂ => by
      simp only [hΘadd, dotProduct_add]), δR, ?_, ?_⟩
  · intro c t
    show lam ⬝ᵥ Θ _ = c * (lam ⬝ᵥ Θ t)
    rw [hΘsc, dotProduct_smul, smul_eq_mul]
  · intro τ hτ
    obtain ⟨M, hM, hMJ⟩ := hframe τ hτ
    have hfixP : ∀ p ∈ P, M.mulVec p = p := by
      intro p hp
      obtain ⟨s, rfl⟩ := (hP' p).mp hp
      rw [← hM, ← hRcomp, hτ]
    obtain ⟨a, ha⟩ := hline M hfixP hMJ
    refine ⟨a, fun t => hΘinj _ _ ?_⟩
    rw [hM, ha, hΘadd, hΘsc, hδR]
    rfl

theorem wc_vqm_local_line_of_R_line (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (r : ℕ)
    (θ : (wcPencilVQ D ℓ hP).over W ≅ (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W)
    (φ : W ⟶ W) (hB : wcVQGalFrame D ℓ hP W w r θ φ)
    (V T : (wcP1Over F'').left.ProEt) (u : T ⟶ V) (c : T ⟶ W)
    (L : Type u) [Field L] [IsSepClosed L] (eL : T.left ≅ Spec (.of L))
    (hR : ∃ (φR : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op T) →+ ℚ_[ℓ])
      (δ : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op T)),
      (∀ (c' : ℚ_[ℓ]) (t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op T)),
        φR (((wcRqScalar D.f ℓ (n - 1) c').hom.app (Opposite.op T)).hom t) = c' * φR t) ∧
      ∀ τ : T ⟶ T, τ ≫ u = u → ∃ a : ℚ_[ℓ],
        ∀ t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op T),
          ((wcRq D.f ℓ (n - 1)).obj.map τ.op).hom t =
            t + ((wcRqScalar D.f ℓ (n - 1) (a * φR t)).hom.app (Opposite.op T)).hom δ) :
    ∃ d lam : Fin r → ℚ_[ℓ], ∀ (τ : T ⟶ T) (σ : W ⟶ W) (g : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      τ ≫ u = u → σ ≫ w = w → τ ≫ c = c ≫ σ → wcVQFrame D ℓ hP W r θ σ g →
      ∃ a : ℚ_[ℓ], g = 1 + a • Matrix.vecMulVec d lam :=
by
  classical
  obtain ⟨hθc, -, hconn, -⟩ := hB
  obtain ⟨φR, δ, hφR, hτR⟩ := hR
  obtain ⟨hR1, hRmul, hRadd, -⟩ := wc_pfam_xwt_scalar_laws D.f ℓ (n - 1)

  have s3 : ∀ {R E : Type (u+1)} [AddCommGroup R] [AddCommGroup E]
      (sR : ℚ_[ℓ] → R →+ R) (sE : ℚ_[ℓ] → E →+ E)
      (_ : ∀ t, sR 1 t = t) (_ : ∀ a b t, sR (a * b) t = sR a (sR b t))
      (_ : ∀ a b t, sR (a + b) t = sR a t + sR b t)
      (arrow : E →+ R) (_ : Function.Injective arrow)
      (_ : ∀ c x, arrow (sE c x) = sR c (arrow x))
      (p : E →+ (Fin r → ℚ_[ℓ])) (_ : Function.Surjective p) (_ : ∀ c x, p (sE c x) = c • p x)
      (φR : R →+ ℚ_[ℓ]) (_ : ∀ c t, φR (sR c t) = c * φR t) (δ : R),
      ∃ d lam : Fin r → ℚ_[ℓ], ∀ (a : ℚ_[ℓ]) (ρE : E →+ E),
        (∀ x, arrow (ρE x) = arrow x + sR (a * φR (arrow x)) δ) →
        (∀ x, p x = 0 → p (ρE x) = 0) →
        ∃ a' : ℚ_[ℓ], ∀ x, p (ρE x) = (1 + a' • Matrix.vecMulVec d lam).mulVec (p x) := by
    intro R E _ _ sR sE hR1 hRmul hRadd arrow harrow harrowS p hp hpS φR hφR δ
    have hR0 : ∀ t, sR 0 t = 0 := by
      intro t
      have h := hRadd 0 0 t
      rw [add_zero] at h
      exact add_left_cancel (h.symm.trans (add_zero _).symm)
    have hform : ∀ (δE : E), arrow δE = δ → ∀ (a : ℚ_[ℓ]) (ρE : E →+ E),
        (∀ x, arrow (ρE x) = arrow x + sR (a * φR (arrow x)) δ) →
        ∀ x, p (ρE x) = p x + (a * φR (arrow x)) • p δE := by
      intro δE hδE a ρE h1 x
      have : ρE x = x + sE (a * φR (arrow x)) δE := by
        apply harrow
        rw [h1, map_add, harrowS, hδE]
      rw [this, map_add, hpS]
    by_cases hP : (∃ δE, arrow δE = δ) ∧ (∀ x, p x = 0 → φR (arrow x) = 0)
    · obtain ⟨⟨δE, hδE⟩, hker⟩ := hP
      have hpre : ∀ v, p (Function.surjInv hp v) = v := Function.surjInv_eq hp
      have hfp : ∀ x x', p x = p x' → φR (arrow x) = φR (arrow x') := by
        intro x x' h
        have : φR (arrow (x - x')) = 0 := hker _ (by rw [map_sub, h, sub_self])
        rw [map_sub, map_sub, sub_eq_zero] at this
        exact this
      let Ψ : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] ℚ_[ℓ] :=
        { toFun := fun v => φR (arrow (Function.surjInv hp v))
          map_add' := by
            intro v w
            rw [← map_add, ← map_add]
            apply hfp
            rw [map_add, hpre, hpre, hpre]
          map_smul' := by
            intro c v
            simp only [RingHom.id_apply, smul_eq_mul]
            rw [← hφR, ← harrowS]
            apply hfp
            rw [hpS, hpre, hpre] }
      have hΨ : ∀ x, φR (arrow x) = Ψ (p x) := fun x => hfp _ _ (hpre (p x)).symm
      have hdot : ∀ v, Ψ v = (fun j => Ψ (Pi.single j 1)) ⬝ᵥ v := by
        intro v
        conv_lhs => rw [← Finset.univ_sum_single v]
        rw [map_sum, dotProduct]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        have e : (Pi.single j (v j) : Fin r → ℚ_[ℓ]) =
            v j • (Pi.single j (1 : ℚ_[ℓ]) : Fin r → ℚ_[ℓ]) := by
          ext k
          simp [Pi.single_apply]
        rw [e, map_smul, smul_eq_mul, mul_comm]
      refine ⟨p δE, fun j => Ψ (Pi.single j 1), fun a ρE h1 _ => ⟨a, fun x => ?_⟩⟩
      rw [hform δE hδE a ρE h1 x, Matrix.add_mulVec, Matrix.one_mulVec, Matrix.smul_mulVec,
        Matrix.vecMulVec_mulVec, op_smul_eq_smul, smul_smul, hΨ x, hdot (p x)]
    · refine ⟨0, 0, fun a ρE h1 h2 => ⟨0, fun x => ?_⟩⟩
      rw [zero_smul, add_zero, Matrix.one_mulVec]
      by_cases hex : ∃ δE, arrow δE = δ
      · obtain ⟨δE, hδE⟩ := hex
        have hk : ∃ x₀, p x₀ = 0 ∧ φR (arrow x₀) ≠ 0 := by
          by_contra hcon
          push_neg at hcon
          exact hP ⟨⟨δE, hδE⟩, hcon⟩
        obtain ⟨x₀, hx₀, hfx₀⟩ := hk
        have e0 := hform δE hδE a ρE h1 x₀
        rw [h2 x₀ hx₀, hx₀, zero_add] at e0
        have hz : a = 0 ∨ p δE = 0 := by
          rcases smul_eq_zero.mp e0.symm with h | h
          · exact Or.inl ((mul_eq_zero.mp h).resolve_right hfx₀)
          · exact Or.inr h
        rw [hform δE hδE a ρE h1 x]
        rcases hz with h | h
        · rw [h, zero_mul, zero_smul, add_zero]
        · rw [h, smul_zero, add_zero]
      · have hk : a * φR (arrow x) = 0 := by
          by_contra hk
          apply hex
          refine ⟨sE (a * φR (arrow x))⁻¹ (ρE x - x), ?_⟩
          rw [harrowS, map_sub, h1, add_sub_cancel_left, ← hRmul, inv_mul_cancel₀ hk, hR1]
        have : ρE x = x := harrow (by rw [h1, hk, hR0, add_zero])
        rw [this]

  have s4 : ∀ (d lam : Fin r → ℚ_[ℓ]) (a : ℚ_[ℓ]) (g : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      g * (1 + a • Matrix.vecMulVec d lam) = 1 →
      ∃ b : ℚ_[ℓ], g = 1 + b • Matrix.vecMulVec d lam := by
    intro d lam a g hg
    set N := Matrix.vecMulVec d lam with hN
    have hNN : N * N = (lam ⬝ᵥ d) • N := by
      rw [hN, Matrix.vecMulVec_mul_vecMulVec, Matrix.vecMulVec_smul]
    by_cases hs : 1 + a * (lam ⬝ᵥ d) = 0
    · have h1 : (1 + a • N) * N = 0 := by
        rw [add_mul, one_mul, smul_mul_assoc, hNN, smul_smul,
          show N + (a * (lam ⬝ᵥ d)) • N = (1 + a * (lam ⬝ᵥ d)) • N by rw [add_smul, one_smul],
          hs, zero_smul]
      have hN0 : N = 0 := by
        calc N = (g * (1 + a • N)) * N := by rw [hg, one_mul]
          _ = g * ((1 + a • N) * N) := by rw [mul_assoc]
          _ = 0 := by rw [h1, mul_zero]
      refine ⟨0, ?_⟩
      rw [zero_smul, add_zero]
      rw [hN0, smul_zero, add_zero, mul_one] at hg
      exact hg
    · set b := -a / (1 + a * (lam ⬝ᵥ d)) with hb
      have hcoef : a + b + a * (b * (lam ⬝ᵥ d)) = 0 := by
        rw [hb]; field_simp; ring
      have hprod : (1 + a • N) * (1 + b • N) = 1 := by
        have : (1 + a • N) * (1 + b • N) = 1 + (a + b + a * (b * (lam ⬝ᵥ d))) • N := by
          simp only [add_mul, mul_add, one_mul, mul_one, smul_mul_assoc, mul_smul_comm, hNN,
            smul_smul, add_smul, smul_add]
          rw [show b * (a * (lam ⬝ᵥ d)) = a * (b * (lam ⬝ᵥ d)) by ring]
          abel
        rw [this, hcoef, zero_smul, add_zero]
      refine ⟨b, ?_⟩
      calc g = g * ((1 + a • N) * (1 + b • N)) := by rw [hprod, mul_one]
        _ = (g * (1 + a • N)) * (1 + b • N) := by rw [mul_assoc]
        _ = 1 + b • N := by rw [hg, one_mul]

  have hTsub : Subsingleton T.left := by
    refine ⟨fun x y => ?_⟩
    have h1 : eL.hom x = eL.hom y := Subsingleton.elim _ _
    have h2 := congrArg (fun p => eL.inv p) h1
    simp only [Scheme.hom_inv_apply] at h2
    exact h2
  have pt : T.left := eL.inv (IsLocalRing.closedPoint L)
  let ι : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op T) →+ (Fin r → ℚ_[ℓ]) :=
    { toFun := fun y => (show C(↥T.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk c))).hom y).down) pt
      map_zero' := (congrArg (fun z : ULift.{u+1} C(↥T.left, Fin r → ℚ_[ℓ]) => z.down pt)
        (map_zero (θ.hom.hom.app (Opposite.op (Over.mk c))).hom)).trans rfl
      map_add' := fun y y' =>
        (congrArg (fun z : ULift.{u+1} C(↥T.left, Fin r → ℚ_[ℓ]) => z.down pt)
          (map_add (θ.hom.hom.app (Opposite.op (Over.mk c))).hom y y')).trans rfl }
  have hιdef : ∀ y, ι y = (show C(↥T.left, Fin r → ℚ_[ℓ]) from
      ((θ.hom.hom.app (Opposite.op (Over.mk c))).hom y).down) pt := fun y => rfl
  have hcancel : ∀ s, (θ.inv.hom.app (Opposite.op (Over.mk c))).hom
      ((θ.hom.hom.app (Opposite.op (Over.mk c))).hom s) = s :=
    fun s => congrArg (fun m => (m.hom.app (Opposite.op (Over.mk c))).hom s) θ.hom_inv_id
  have hιinj : Function.Injective ι := by
    intro y y' h
    have e1 : (θ.hom.hom.app (Opposite.op (Over.mk c))).hom y =
        (θ.hom.hom.app (Opposite.op (Over.mk c))).hom y' := by
      apply ULift.ext
      apply ContinuousMap.ext
      intro z
      rw [hTsub.elim z pt]
      exact h
    have := congrArg (θ.inv.hom.app (Opposite.op (Over.mk c))).hom e1
    exact (hcancel y).symm.trans (this.trans (hcancel y'))
  have hιsurj : Function.Surjective ι := by
    intro v
    have key : ∀ y, (θ.hom.hom.app (Opposite.op (Over.mk c))).hom
        ((θ.inv.hom.app (Opposite.op (Over.mk c))).hom y) = y := by
      intro y
      change ((θ.inv ≫ θ.hom).hom.app (Opposite.op (Over.mk c))).hom y = y
      rw [θ.inv_hom_id]
      rfl
    refine ⟨(θ.inv.hom.app (Opposite.op (Over.mk c))).hom
      (ULift.up (ContinuousMap.const ↥T.left v)), ?_⟩
    exact congrArg (fun z : ULift.{u+1} C(↥T.left, Fin r → ℚ_[ℓ]) => z.down pt) (key _)
  have hιS : ∀ (k : ℚ_[ℓ]) (y : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op T)),
      ι (((wcPencilVQScalar D ℓ hP k).hom.app (Opposite.op T)).hom y) = k • ι y := by
    intro k y
    have h := congrArg (fun m => (show C(↥T.left, Fin r → ℚ_[ℓ]) from
      ((m.hom.app (Opposite.op (Over.mk c))).hom y).down) pt) (hθc k)
    exact h
  have hframe : ∀ (τ : T ⟶ T) (σ : W ⟶ W) (g : Matrix (Fin r) (Fin r) ℚ_[ℓ]), τ ≫ c = c ≫ σ →
      wcVQFrame D ℓ hP W r θ σ g →
      ∀ y, g.mulVec (ι (((wcPencilVQ D ℓ hP).obj.map τ.op).hom y)) = ι y := by
    intro τ σ g hτc hfr y
    obtain ⟨A, hA⟩ :=
      wc_proet_deck_frame_linear (wcP1Over F'').left ℓ (wcPencilVQ D ℓ hP) W hconn r θ σ
    obtain ⟨z₀⟩ := @ConnectedSpace.toNonempty _ _ hconn
    have hsurjW : ∀ v : Fin r → ℚ_[ℓ], ∃ x : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op W),
        ∀ z : W.left, (show C(↥W.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom x).down) z = v := by
      intro v
      have key : ∀ y, (θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom
          ((θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom y) = y := by
        intro y
        change ((θ.inv ≫ θ.hom).hom.app (Opposite.op (Over.mk (𝟙 W)))).hom y = y
        rw [θ.inv_hom_id]
        rfl
      refine ⟨(θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom
        (ULift.up (ContinuousMap.const ↥W.left v)), ?_⟩
      intro z
      erw [key]
      rfl
    have hgA : ∀ v, g.mulVec v = A v := by
      intro v
      obtain ⟨x, hx⟩ := hsurjW v
      have h1 := hfr x z₀
      have h2 := hA W (𝟙 W) σ (Category.id_comp σ).symm x z₀
      rw [hx] at h1 h2
      exact h1.symm.trans h2
    have hnat : ∀ (b' : T ⟶ W), b' = τ ≫ c →
        (show C(↥T.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk b'))).hom
            (((wcPencilVQ D ℓ hP).obj.map τ.op).hom y)).down) pt = ι y := by
      intro b' hb'
      subst hb'
      have h : (θ.hom.hom.app (Opposite.op (Over.mk (τ ≫ c)))).hom
          ((((wcPencilVQ D ℓ hP).over W).obj.map
            (Over.homMk τ rfl : Over.mk (τ ≫ c) ⟶ Over.mk c).op).hom y) =
          ((((wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W).obj.map
            (Over.homMk τ rfl : Over.mk (τ ≫ c) ⟶ Over.mk c).op).hom
            ((θ.hom.hom.app (Opposite.op (Over.mk c))).hom y)) :=
        congrArg (fun m => m.hom y)
          (θ.hom.hom.naturality (Over.homMk τ rfl : Over.mk (τ ≫ c) ⟶ Over.mk c).op)
      have h2 := congrArg (fun y : ULift.{u+1} C(↥T.left, Fin r → ℚ_[ℓ]) => y.down pt) h
      have h3 : (show C(↥T.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk c))).hom y).down) (τ.left pt) = ι y :=
        (congrArg (fun z => (show C(↥T.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk c))).hom y).down) z)
          (Subsingleton.elim (τ.left pt) pt)).trans (hιdef y).symm
      exact h2.trans h3
    have e1 := hA T c (c ≫ σ) rfl (((wcPencilVQ D ℓ hP).obj.map τ.op).hom y) pt
    rw [hgA]
    exact e1.symm.trans (hnat (c ≫ σ) hτc.symm)

  have harrow : Function.Injective ((wcPencilE D ℓ hP).arrow.hom.app (Opposite.op T)).hom := by
    have h1 : Mono ((sheafToPresheaf (Scheme.ProEt.topology (wcP1Over F'').left)
        AddCommGrpCat.{u+1}).map (wcPencilE D ℓ hP).arrow) :=
      Functor.map_mono (sheafToPresheaf (Scheme.ProEt.topology (wcP1Over F'').left)
        AddCommGrpCat.{u+1}) (wcPencilE D ℓ hP).arrow
    exact (AddCommGrpCat.mono_iff_injective _).mp ((NatTrans.mono_iff_mono_app _).mp h1 _)
  haveI hres : IsSepClosed (IsLocalRing.ResidueField L) := by
    let e : L ≃+* IsLocalRing.ResidueField L :=
      RingEquiv.ofBijective (IsLocalRing.residue L)
        ⟨(IsLocalRing.residue L).injective, IsLocalRing.residue_surjective⟩
    apply IsSepClosed.of_exists_root
    intro p _ hirr hsep
    obtain ⟨x, hx⟩ := IsSepClosed.exists_root (p.map (e.symm : IsLocalRing.ResidueField L →+* L))
      (by
        rw [Polynomial.degree_map_eq_of_injective e.symm.injective]
        exact hirr.degree_pos.ne')
      hsep.map
    refine ⟨e x, ?_⟩
    have h1 : Polynomial.eval x (p.map (e.symm : IsLocalRing.ResidueField L →+* L)) = 0 := hx
    rw [Polynomial.eval_map] at h1
    have h2 := congrArg (e : L →+* IsLocalRing.ResidueField L) h1
    rw [map_zero] at h2
    have h3 : (e : L →+* IsLocalRing.ResidueField L)
        (Polynomial.eval₂ (e.symm : IsLocalRing.ResidueField L →+* L) x p) =
        Polynomial.eval (e x) p := by
      rw [Polynomial.hom_eval₂, RingEquiv.comp_symm]
      rfl
    rw [← h3]
    exact h2
  haveI : Projective (wcFreeSheaf (wcP1Over F'').left T) :=
    wc_proet_free_projective_strict_local (wcP1Over F'').left T L eL
  obtain ⟨e, he, -⟩ := proet_free_sheaf_hom_equiv (wcP1Over F'').left T
  have hπ : Function.Surjective ((Limits.cokernel.π (Subobject.ofLE
      (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP) (wcPencilE D ℓ hP) inf_le_left)).hom.app
        (Opposite.op T)).hom := by
    intro y
    refine ⟨e _ (Projective.factorThru
      ((e (Limits.cokernel (Subobject.ofLE (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP)
        (wcPencilE D ℓ hP) inf_le_left))).symm y)
      (Limits.cokernel.π (Subobject.ofLE (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP)
        (wcPencilE D ℓ hP) inf_le_left))), ?_⟩
    have h1 := he _ _ (Limits.cokernel.π (Subobject.ofLE (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP)
        (wcPencilE D ℓ hP) inf_le_left))
      (Projective.factorThru
        ((e (Limits.cokernel (Subobject.ofLE (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP)
          (wcPencilE D ℓ hP) inf_le_left))).symm y)
        (Limits.cokernel.π (Subobject.ofLE (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP)
          (wcPencilE D ℓ hP) inf_le_left)))
    rw [Projective.factorThru_comp, Equiv.apply_symm_apply] at h1
    exact h1.symm

  choose ψ hψ using fun k : ℚ_[ℓ] => wc_pencil_VQScalar_spec F' F'' Y n D ℓ hP k

  obtain ⟨d, lam, hdesc⟩ := s3
    (fun k => ((wcRqScalar D.f ℓ (n - 1) k).hom.app (Opposite.op T)).hom)
    (fun k => ((ψ k).hom.app (Opposite.op T)).hom)
    (hR1 T) (hRmul T) (hRadd T)
    ((wcPencilE D ℓ hP).arrow.hom.app (Opposite.op T)).hom harrow
    (fun k x => congrArg (fun m => (m.hom.app (Opposite.op T)).hom x) (hψ k).1)
    (ι.comp ((Limits.cokernel.π (Subobject.ofLE (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP)
      (wcPencilE D ℓ hP) inf_le_left)).hom.app (Opposite.op T)).hom)
    (hιsurj.comp hπ)
    (fun k x => by
      have h := congrArg (fun m => (m.hom.app (Opposite.op T)).hom x) (hψ k).2
      exact (congrArg ι h.symm).trans (hιS k _))
    φR hφR δ

  refine ⟨d, lam, fun τ σ g hτu _ hτc hfr => ?_⟩
  obtain ⟨a, ha⟩ := hτR τ hτu
  have hnatE : ∀ x, ((wcPencilE D ℓ hP).arrow.hom.app (Opposite.op T)).hom
      (((Subobject.underlying.obj (wcPencilE D ℓ hP)).obj.map τ.op).hom x) =
      ((wcRq D.f ℓ (n - 1)).obj.map τ.op).hom
        (((wcPencilE D ℓ hP).arrow.hom.app (Opposite.op T)).hom x) := fun x =>
    congrArg (fun m => m.hom x) ((wcPencilE D ℓ hP).arrow.hom.naturality τ.op)
  have hnatπ : ∀ x, ((Limits.cokernel.π (Subobject.ofLE (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP)
      (wcPencilE D ℓ hP) inf_le_left)).hom.app (Opposite.op T)).hom
      (((Subobject.underlying.obj (wcPencilE D ℓ hP)).obj.map τ.op).hom x) =
      ((wcPencilVQ D ℓ hP).obj.map τ.op).hom
        (((Limits.cokernel.π (Subobject.ofLE (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP)
          (wcPencilE D ℓ hP) inf_le_left)).hom.app (Opposite.op T)).hom x) := fun x =>
    congrArg (fun m => m.hom x)
      ((Limits.cokernel.π (Subobject.ofLE (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP)
        (wcPencilE D ℓ hP) inf_le_left)).hom.naturality τ.op)
  obtain ⟨a', ha'⟩ := hdesc a ((Subobject.underlying.obj (wcPencilE D ℓ hP)).obj.map τ.op).hom
    (fun x => (hnatE x).trans (ha _))
    (fun x hx => by
      have hx' : ι (((Limits.cokernel.π (Subobject.ofLE (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP)
          (wcPencilE D ℓ hP) inf_le_left)).hom.app (Opposite.op T)).hom x) = 0 := hx
      have h0 : ((Limits.cokernel.π (Subobject.ofLE (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP)
          (wcPencilE D ℓ hP) inf_le_left)).hom.app (Opposite.op T)).hom x = 0 :=
        hιinj (hx'.trans (map_zero ι).symm)
      exact (congrArg ι ((hnatπ x).trans
        ((congrArg ((wcPencilVQ D ℓ hP).obj.map τ.op).hom h0).trans (map_zero _)))).trans
        (map_zero ι))

  have hM : ∀ y, ι (((wcPencilVQ D ℓ hP).obj.map τ.op).hom y) =
      (1 + a' • Matrix.vecMulVec d lam).mulVec (ι y) := by
    intro y
    obtain ⟨x, rfl⟩ := hπ y
    exact (congrArg ι (hnatπ x)).symm.trans (ha' x)
  have hgM : g * (1 + a' • Matrix.vecMulVec d lam) = 1 := by
    apply Matrix.ext_of_mulVec_single
    intro i
    obtain ⟨y, hy⟩ := hιsurj (Pi.single i 1)
    have h := hframe τ σ g hτc hfr y
    rw [hM y, hy] at h
    rw [← Matrix.mulVec_mulVec, h, Matrix.one_mulVec]

  exact s4 d lam a' g hgM

theorem wc_vqm_inertia_PL_frames (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (r : ℕ)
    (θ : (wcPencilVQ D ℓ hP).over W ≅ (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W)
    (φ : W ⟶ W) (hB : wcVQGalFrame D ℓ hP W w r θ φ)
    (Γ : Subgroup (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ)
    (hΓ : ∀ h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ, h ∈ Γ ↔
      ∃ γ : W ⟶ W, γ ≫ w = w ∧ wcVQFrame D ℓ hP W r θ γ (h : Matrix (Fin r) (Fin r) ℚ_[ℓ])) :
    ∀ i : Fin D.m, ∃ (σ : W ⟶ W) (g : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ),
      wcHonestIsInertia D hP W w i σ ∧ wcVQFrame D ℓ hP W r θ σ (g : Matrix (Fin r) (Fin r) ℚ_[ℓ]) ∧
      (∃ d lam : Fin r → ℚ_[ℓ], (g : Matrix (Fin r) (Fin r) ℚ_[ℓ]) = 1 + Matrix.vecMulVec d lam) ∧
      ∀ (σ' : W ⟶ W) (g' : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
        wcHonestIsInertia D hP W w i σ' → wcVQFrame D ℓ hP W r θ σ' g' →
        ∃ c ∈ Γ, ∃ a : ℚ_[ℓ], g' = (c : Matrix (Fin r) (Fin r) ℚ_[ℓ]) *
          (1 + a • ((g : Matrix (Fin r) (Fin r) ℚ_[ℓ]) - 1)) *
          ((c⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) :=
by
  classical
  intro i
  have hBc := hB
  obtain ⟨_, _, hconn, hoff, hcov, hgal, _, _, _, _⟩ := hBc
  obtain ⟨z₀⟩ := @ConnectedSpace.toNonempty _ _ hconn

  have hsurj : ∀ v : Fin r → ℚ_[ℓ], ∃ x : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op W),
      ∀ z : W.left, (show C(↥W.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom x).down) z = v := by
    intro v
    have key : ∀ y, (θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom
        ((θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom y) = y := by
      intro y
      change ((θ.inv ≫ θ.hom).hom.app (Opposite.op (Over.mk (𝟙 W)))).hom y = y
      rw [θ.inv_hom_id]
      rfl
    refine ⟨(θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom
      (ULift.up (ContinuousMap.const ↥W.left v)), ?_⟩
    intro z
    erw [key]
    rfl
  choose Afr hAfr using fun γ : W ⟶ W =>
    wc_proet_deck_frame_linear (wcP1Over F'').left ℓ (wcPencilVQ D ℓ hP) W hconn r θ γ
  have hex : ∀ γ : W ⟶ W, wcVQFrame D ℓ hP W r θ γ (LinearMap.toMatrix' (Afr γ)) := by
    intro γ s z
    rw [LinearMap.toMatrix'_mulVec]
    exact hAfr γ W (𝟙 W) γ (Category.id_comp γ).symm s z
  have hval : ∀ (γ : W ⟶ W) (g : Matrix (Fin r) (Fin r) ℚ_[ℓ]), wcVQFrame D ℓ hP W r θ γ g →
      ∀ v, g.mulVec v = Afr γ v := by
    intro γ g hg v
    obtain ⟨x, hx⟩ := hsurj v
    have h1 := hg x z₀
    have h2 := hAfr γ W (𝟙 W) γ (Category.id_comp γ).symm x z₀
    rw [hx] at h1 h2
    exact h1.symm.trans h2
  have huniq : ∀ (γ : W ⟶ W) (g g' : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      wcVQFrame D ℓ hP W r θ γ g → wcVQFrame D ℓ hP W r θ γ g' → g = g' := by
    intro γ g g' hg hg'
    apply Matrix.toLin'.injective
    refine LinearMap.ext fun v => ?_
    rw [Matrix.toLin'_apply, Matrix.toLin'_apply, hval γ g hg v, hval γ g' hg' v]
  have hcomp : ∀ (a b : W ⟶ W) (g g' : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      wcVQFrame D ℓ hP W r θ a g → wcVQFrame D ℓ hP W r θ b g' →
      wcVQFrame D ℓ hP W r θ (a ≫ b) (g' * g) := by
    intro a b g g' hg hg' s z
    refine (hAfr b W a (a ≫ b) rfl s z).trans ?_
    rw [← hval b g' hg', hg s z, Matrix.mulVec_mulVec]
  have h1 : wcVQFrame D ℓ hP W r θ (𝟙 W) 1 := fun s z => (Matrix.one_mulVec _).symm

  obtain ⟨V₀, g₀, _, A₀, iA₁, iA₂, iA₃, e₀, _, hV₀, _, _, _⟩ :=
    wc_P1bar_strict_local_nbhd F'' (D.S i) (D.hS i) hP
  obtain ⟨E, a₀, L, iL₁, iL₂, eE, hE⟩ :=
    wc_pencil_PL_generic_geom_point F'' D.m D.S D.hS V₀ A₀ e₀
  obtain ⟨c₁, hc₁⟩ := wc_pencil_PL_lift_to_cover F'' hP D.m D.S W w hcov E L eE hE (a₀ ≫ g₀)

  have hR := wc_pencil_R_local_inertia_line F' F'' Y n hn hn2 D ℓ hℓ hP i V₀ g₀ A₀ e₀ hV₀
    E a₀ L eE hE
  obtain ⟨d, lam, hline⟩ :=
    wc_vqm_local_line_of_R_line F' F'' Y n hn hn2 D ℓ hℓ hP W w r θ φ hB V₀ E a₀ c₁ L eE hR

  have hin : ∀ (σ : W ⟶ W) (τ : E ⟶ E), σ ≫ w = w → τ ≫ a₀ = a₀ → τ ≫ c₁ = c₁ ≫ σ →
      wcHonestIsInertia D hP W w i σ := fun σ τ hσ hτ hτc =>
    ⟨hσ, V₀, g₀, A₀, iA₁, iA₂, iA₃, e₀, hV₀, L, iL₁, iL₂, E, eE, a₀, c₁, τ, hc₁.symm, hτ, hτc⟩

  have hconjgen : ∀ (σ' : W ⟶ W) (g' : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      wcHonestIsInertia D hP W w i σ' → wcVQFrame D ℓ hP W r θ σ' g' →
      ∃ c ∈ Γ, ∃ (τ : E ⟶ E) (σ₁ : W ⟶ W) (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
        τ ≫ a₀ = a₀ ∧ σ₁ ≫ w = w ∧ τ ≫ c₁ = c₁ ≫ σ₁ ∧ wcVQFrame D ℓ hP W r θ σ₁ h ∧
        g' = (c : Matrix (Fin r) (Fin r) ℚ_[ℓ]) * h *
          ((c⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) := by
    intro σ' g' hσ' hg'
    have hσ'w : σ' ≫ w = w := by
      unfold wcHonestIsInertia at hσ'
      exact hσ'.1
    obtain ⟨γ, γ', τ₁, hγ, hγ', hγγ', hγ'γ, hτ₁u, hτ₁c⟩ :=
      wc_vqm_inertia_transport F' F'' Y n D hP W w hconn hoff hgal i V₀ g₀ A₀ e₀ hV₀
        E a₀ c₁ L eE hc₁.symm σ' hσ'
    have hGG' : LinearMap.toMatrix' (Afr γ) * LinearMap.toMatrix' (Afr γ') = 1 := by
      have hc := hcomp γ' γ _ _ (hex γ') (hex γ)
      rw [hγ'γ] at hc
      exact huniq _ _ _ hc h1
    have hG'G : LinearMap.toMatrix' (Afr γ') * LinearMap.toMatrix' (Afr γ) = 1 := by
      have hc := hcomp γ γ' _ _ (hex γ) (hex γ')
      rw [hγγ'] at hc
      exact huniq _ _ _ hc h1
    let cU : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ :=
      ⟨LinearMap.toMatrix' (Afr γ), LinearMap.toMatrix' (Afr γ'), hGG', hG'G⟩
    have hcU : cU ∈ Γ := (hΓ cU).2 ⟨γ, hγ, hex γ⟩
    have hfr := hcomp γ (σ' ≫ γ') _ _ (hex γ) (hcomp σ' γ' _ _ hg' (hex γ'))
    have hdeck : (γ ≫ σ' ≫ γ') ≫ w = w := by
      simp only [Category.assoc, hγ', hσ'w, hγ]
    have hrec : LinearMap.toMatrix' (Afr γ) *
        (LinearMap.toMatrix' (Afr γ') * g' * LinearMap.toMatrix' (Afr γ)) *
        LinearMap.toMatrix' (Afr γ') = g' := by
      rw [← Matrix.mul_assoc, ← Matrix.mul_assoc, hGG', Matrix.one_mul, Matrix.mul_assoc, hGG',
        Matrix.mul_one]
    refine ⟨cU, hcU, τ₁, γ ≫ σ' ≫ γ', _, hτ₁u, hdeck, hτ₁c, hfr, ?_⟩
    exact hrec.symm

  by_cases hPc : ∃ (τ : E ⟶ E) (σ : W ⟶ W) (gm : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      τ ≫ a₀ = a₀ ∧ σ ≫ w = w ∧ τ ≫ c₁ = c₁ ≫ σ ∧ wcVQFrame D ℓ hP W r θ σ gm ∧ gm ≠ 1
  · obtain ⟨τ₀, σ₀, gm, hτ₀, hσ₀, hτc₀, hfr₀, hne⟩ := hPc
    obtain ⟨b₀, hb₀⟩ := hline τ₀ σ₀ gm hτ₀ hσ₀ hτc₀ hfr₀
    obtain ⟨σi, _, hei⟩ := hgal W σ₀ (𝟙 W) hconn (by rw [hσ₀, Category.id_comp])
    have hl : LinearMap.toMatrix' (Afr σi) * gm = 1 := by
      have hc := hcomp σ₀ σi _ _ hfr₀ (hex σi)
      rw [← hei] at hc
      exact huniq _ _ _ hc h1
    have hr : gm * LinearMap.toMatrix' (Afr σi) = 1 := mul_eq_one_comm.mp hl
    let gU : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ := ⟨gm, LinearMap.toMatrix' (Afr σi), hr, hl⟩
    have hb0 : b₀ ≠ 0 := by
      intro h
      apply hne
      rw [hb₀, h, zero_smul, add_zero]
    refine ⟨σ₀, gU, hin σ₀ τ₀ hσ₀ hτ₀ hτc₀, hfr₀, ⟨b₀ • d, lam, ?_⟩, ?_⟩
    · show gm = _
      rw [hb₀]
      ext a b
      simp [Matrix.vecMulVec_apply, mul_assoc]
    · intro σ' g' hσ' hg'
      obtain ⟨c, hc, τ, σ₁, h, hτ, hσ₁, hτc, hfr, hg'eq⟩ := hconjgen σ' g' hσ' hg'
      obtain ⟨a₁, ha₁⟩ := hline τ σ₁ h hτ hσ₁ hτc hfr
      refine ⟨c, hc, a₁ / b₀, ?_⟩
      show g' = (c : Matrix (Fin r) (Fin r) ℚ_[ℓ]) * (1 + (a₁ / b₀) • (gm - 1)) *
        ((c⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ])
      rw [hg'eq, ha₁, hb₀, add_sub_cancel_left, smul_smul, div_mul_cancel₀ _ hb0]
  · refine ⟨𝟙 W, 1, hin (𝟙 W) (𝟙 E) (Category.id_comp w) (Category.id_comp a₀)
      (by rw [Category.id_comp, Category.comp_id]), ?_, ⟨0, 0, ?_⟩, ?_⟩
    · rw [Units.val_one]
      exact h1
    · rw [Units.val_one]
      ext a b
      simp [Matrix.vecMulVec_apply]
    · intro σ' g' hσ' hg'
      obtain ⟨c, hc, τ, σ₁, h, hτ, hσ₁, hτc, hfr, hg'eq⟩ := hconjgen σ' g' hσ' hg'
      have hh : h = 1 := by
        by_contra hne
        exact hPc ⟨τ, σ₁, h, hτ, hσ₁, hτc, hfr, hne⟩
      refine ⟨c, hc, 0, ?_⟩
      rw [hg'eq, hh, zero_smul, add_zero]

theorem wc_vqm_inertia_frobenius (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (r : ℕ)
    (θ : (wcPencilVQ D ℓ hP).over W ≅ (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W)
    (φ : W ⟶ W) (hB : wcVQGalFrame D ℓ hP W w r θ φ)
    (Γ : Subgroup (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ)
    (hΓ : ∀ h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ, h ∈ Γ ↔
      ∃ γ : W ⟶ W, γ ≫ w = w ∧ wcVQFrame D ℓ hP W r θ γ (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]))
    (Φ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ)
    (hΦ : wcVQFrame D ℓ hP W r θ φ (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ])) :
    ∀ (i : Fin D.m) (σ : W ⟶ W) (g : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      wcHonestIsInertia D hP W w i σ → wcVQFrame D ℓ hP W r θ σ g →
      ∃ h ∈ Γ, ∃ c : ℚ_[ℓ],
        ((Φ * h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) * g =
          (1 + c • (g - 1)) *
            ((Φ * h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) :=
by
  classical
  intro i σ g hσ hg

  obtain ⟨σi, gi, -, -, -, hall⟩ :=
    wc_vqm_inertia_PL_frames F' F'' Y n hn hn2 D ℓ hℓ hP W w r θ φ hB Γ hΓ i
  obtain ⟨_, _, hconn, _, _, hgal, hφw, hrev, _, _⟩ := hB

  obtain ⟨z₀⟩ := @ConnectedSpace.toNonempty _ _ hconn
  have hsurj : ∀ v : Fin r → ℚ_[ℓ], ∃ x : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op W),
      ∀ z : W.left, (show C(↥W.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom x).down) z = v := by
    intro v
    have key : ∀ y, (θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom
        ((θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom y) = y := by
      intro y
      change ((θ.inv ≫ θ.hom).hom.app (Opposite.op (Over.mk (𝟙 W)))).hom y = y
      rw [θ.inv_hom_id]
      rfl
    refine ⟨(θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom
      (ULift.up (ContinuousMap.const ↥W.left v)), ?_⟩
    intro z
    erw [key]
    rfl
  choose A hA using fun γ : W ⟶ W =>
    wc_proet_deck_frame_linear (wcP1Over F'').left ℓ (wcPencilVQ D ℓ hP) W hconn r θ γ
  have hex : ∀ γ : W ⟶ W, wcVQFrame D ℓ hP W r θ γ (LinearMap.toMatrix' (A γ)) := by
    intro γ s z
    rw [LinearMap.toMatrix'_mulVec]
    exact hA γ W (𝟙 W) γ (Category.id_comp γ).symm s z
  have hval : ∀ (γ : W ⟶ W) (g : Matrix (Fin r) (Fin r) ℚ_[ℓ]), wcVQFrame D ℓ hP W r θ γ g →
      ∀ v, g.mulVec v = A γ v := by
    intro γ g hg v
    obtain ⟨x, hx⟩ := hsurj v
    have h1 := hg x z₀
    have h2 := hA γ W (𝟙 W) γ (Category.id_comp γ).symm x z₀
    rw [hx] at h1 h2
    exact h1.symm.trans h2
  have huniq : ∀ (γ : W ⟶ W) (g g' : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      wcVQFrame D ℓ hP W r θ γ g → wcVQFrame D ℓ hP W r θ γ g' → g = g' := by
    intro γ g g' hg hg'
    apply Matrix.toLin'.injective
    refine LinearMap.ext fun v => ?_
    rw [Matrix.toLin'_apply, Matrix.toLin'_apply, hval γ g hg v, hval γ g' hg' v]
  have hcomp : ∀ (a b : W ⟶ W) (g g' : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      wcVQFrame D ℓ hP W r θ a g → wcVQFrame D ℓ hP W r θ b g' →
      wcVQFrame D ℓ hP W r θ (a ≫ b) (g' * g) := by
    intro a b g g' hg hg' s z
    refine (hA b W a (a ≫ b) rfl s z).trans ?_
    rw [← hval b g' hg', hg s z, Matrix.mulVec_mulVec]

  obtain ⟨hσw, V, v, A', iA, hA', sA, e, hV, L, iL, sL, Vt, eVt, u', c, τ, h1, h2, h3⟩ := hσ
  have hφσ : φ ≫ w = (σ ≫ φ) ≫ w := by
    rw [Category.assoc, hφw, ← Category.assoc, hσw]
  obtain ⟨σ'', hσ''w, hσ''⟩ := hgal W φ (σ ≫ φ) hconn hφσ
  have hσ''inert : wcHonestIsInertia D hP W w i σ'' := by
    unfold wcHonestIsInertia
    refine ⟨hσ''w, V, v ≫ wcGeomFrob F'' (wcP1Over F'') hP, A', iA, hA', sA, e, hV, L, iL, sL,
      Vt, eVt, u', c ≫ φ, τ, ?_, h2, ?_⟩
    · rw [← Category.assoc u' v, h1, Category.assoc, Category.assoc, hφw]
    · rw [← Category.assoc τ c, h3, Category.assoc c σ φ, hσ'', Category.assoc]
  have hσ_again : wcHonestIsInertia D hP W w i σ := by
    unfold wcHonestIsInertia
    exact ⟨hσw, V, v, A', iA, hA', sA, e, hV, L, iL, sL, Vt, eVt, u', c, τ, h1, h2, h3⟩

  obtain ⟨g'', hg''fr⟩ : ∃ g'' : Matrix (Fin r) (Fin r) ℚ_[ℓ],
      wcVQFrame D ℓ hP W r θ σ'' g'' := ⟨_, hex σ''⟩
  have c1 := hcomp σ φ g _ hg hΦ
  have c2 := hcomp φ σ'' _ g'' hΦ hg''fr
  rw [hσ''] at c1
  have hΦg := huniq _ _ _ c1 c2

  obtain ⟨c₁, hc₁, a₁, h₁⟩ := hall σ g hσ_again hg
  obtain ⟨c₂, hc₂, a₂, h₂⟩ := hall σ'' g'' hσ''inert hg''fr

  have hκ : c₁ * c₂⁻¹ ∈ Γ := Γ.mul_mem hc₁ (Γ.inv_mem hc₂)
  obtain ⟨δ, hδw, hδ⟩ := (hΓ _).1 hκ
  obtain ⟨γ', hγ'w, he'⟩ := hrev δ hδw
  have d1 := hcomp γ' φ _ _ (hex γ') hΦ
  have d2 := hcomp φ δ _ _ hΦ hδ
  rw [he'] at d1
  have key := huniq _ _ _ d1 d2
  obtain ⟨h, hhdef⟩ : ∃ h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ, h = Φ⁻¹ * (c₁ * c₂⁻¹) * Φ :=
    ⟨_, rfl⟩
  have hhval : (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]) = LinearMap.toMatrix' (A γ') := by
    have e0 : ((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) *
        ((Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]) * LinearMap.toMatrix' (A γ')) =
        LinearMap.toMatrix' (A γ') := by
      rw [← Matrix.mul_assoc, Units.inv_mul, Matrix.one_mul]
    rw [key] at e0
    rw [← e0, hhdef]
    simp only [Units.val_mul, Matrix.mul_assoc]
  have hh : h ∈ Γ := (hΓ h).2 ⟨γ', hγ'w, by rw [hhval]; exact hex γ'⟩
  have hΦh : Φ * h = c₁ * c₂⁻¹ * Φ := by
    rw [hhdef]
    simp only [mul_assoc, mul_inv_cancel_left]

  have alg : ∀ (C1 C1i C2 C2i P g g'' G : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (a₁ a₂ : ℚ_[ℓ]),
      C1 * C1i = 1 → C2i * C2 = 1 → C1i * C1 = 1 →
      g = C1 * (1 + a₁ • (G - 1)) * C1i → g'' = C2 * (1 + a₂ • (G - 1)) * C2i →
      P * g = g'' * P → ∃ c : ℚ_[ℓ], C1 * C2i * P * g = (1 + c • (g - 1)) * (C1 * C2i * P) := by
    intro C1 C1i C2 C2i P g g'' G a₁ a₂ hc1 hc2' hc1' h₁ h₂ hPg
    have hconjE : ∀ (b : ℚ_[ℓ]) (Z : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
        C1 * (1 + b • Z) * C1i = 1 + b • (C1 * Z * C1i) := by
      intro b Z
      rw [Matrix.mul_add, Matrix.add_mul, Matrix.mul_one, hc1, Matrix.mul_smul, Matrix.smul_mul]
    have hL : C1 * C2i * P * g = C1 * (1 + a₂ • (G - 1)) * C2i * P := by
      rw [Matrix.mul_assoc (C1 * C2i) P g, hPg, h₂]
      simp only [← Matrix.mul_assoc]
      rw [Matrix.mul_assoc C1 C2i C2, hc2', Matrix.mul_one]
    by_cases ha : a₁ = 0
    · refine ⟨0, ?_⟩
      have hg1 : g = 1 := by
        rw [h₁, ha, zero_smul, add_zero, Matrix.mul_one, hc1]
      rw [hg1, zero_smul, add_zero, Matrix.mul_one, Matrix.one_mul]
    · refine ⟨a₂ / a₁, ?_⟩
      have hg1 : g - 1 = a₁ • (C1 * (G - 1) * C1i) := by
        rw [h₁, hconjE, add_sub_cancel_left]
      rw [hL, hg1, smul_smul, div_mul_cancel₀ a₂ ha, ← hconjE]
      simp only [← Matrix.mul_assoc]
      rw [Matrix.mul_assoc (C1 * (1 + a₂ • (G - 1))) C1i C1, hc1', Matrix.mul_one]
  obtain ⟨cc, hcc⟩ := alg (c₁ : Matrix (Fin r) (Fin r) ℚ_[ℓ])
    ((c₁⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ])
    (c₂ : Matrix (Fin r) (Fin r) ℚ_[ℓ])
    ((c₂⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ])
    (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]) g g'' (gi : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a₁ a₂
    (Units.mul_inv c₁) (Units.inv_mul c₂) (Units.inv_mul c₁) h₁ h₂ hΦg
  refine ⟨h, hh, cc, ?_⟩
  rw [hΦh, Units.val_mul, Units.val_mul]
  exact hcc

theorem wc_vqm_closed_monoid_of_quotients (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r : ℕ)
    (Γ : Subgroup (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ)
    (hint : ∀ h ∈ Γ, ∀ a b, ‖(h : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ 1)
    (P : Set (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) (hPΓ : P ⊆ Γ)
    (hPconj : ∀ h ∈ Γ, ∀ p ∈ P, h * p * h⁻¹ ∈ P)
    (hQ : ∀ (Q : Type) [Group Q] [Finite Q] (χ : ↥Γ →* Q) (k : ℕ),
      (∀ h h' : ↥Γ, (∀ a b, ‖((h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
          Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b - ((h' : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
          Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ (ℓ : ℝ) ^ (-(k : ℤ))) → χ h = χ h') →
      (∀ p : ↥Γ, (p : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) ∈ P → χ p = 1) →
      ∀ h : ↥Γ, χ h = 1) :
    ∀ C : Set (Matrix (Fin r) (Fin r) ℚ_[ℓ]), IsClosed C →
      (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) ∈ C → (∀ a ∈ C, ∀ b ∈ C, a * b ∈ C) →
      (∀ p ∈ P, (p : Matrix (Fin r) (Fin r) ℚ_[ℓ]) ∈ C) →
      ∀ h ∈ Γ, (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]) ∈ C :=
by
  classical

  have s3 : ∀ (C : Set (Matrix (Fin r) (Fin r) ℚ_[ℓ])), IsClosed C →
      ∀ (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      (∀ k : ℕ, ∃ c ∈ C, ∀ a b, ‖c a b - h a b‖ ≤ (ℓ : ℝ) ^ (-(k : ℤ))) → h ∈ C := by
    intro C hC h happrox
    choose c hcC hc using happrox
    have hℓ : (2 : ℝ) ≤ ℓ := by exact_mod_cast (Fact.out : ℓ.Prime).two_le
    have hlim : Filter.Tendsto (fun k : ℕ => (ℓ : ℝ) ^ (-(k : ℤ))) Filter.atTop (nhds 0) := by
      have e : (fun k : ℕ => (ℓ : ℝ) ^ (-(k : ℤ))) = fun k : ℕ => ((ℓ : ℝ)⁻¹) ^ k := by
        funext k
        rw [zpow_neg, zpow_natCast, inv_pow]
      rw [e]
      apply tendsto_pow_atTop_nhds_zero_of_lt_one
      · positivity
      · apply inv_lt_one_of_one_lt₀
        linarith
    have hT : Filter.Tendsto c Filter.atTop (nhds h) :=
      tendsto_pi_nhds.mpr fun a => tendsto_pi_nhds.mpr fun b =>
        (tendsto_iff_norm_sub_tendsto_zero).mpr
          (squeeze_zero (fun _ => norm_nonneg _) (fun k => hc k a b) hlim)
    exact hC.mem_of_tendsto hT (Filter.Eventually.of_forall hcC)

  have s1 : ∀ k : ℕ, ∃ ρ : ↥Γ →* (Matrix (Fin r) (Fin r) (ZMod (ℓ ^ k)))ˣ, ∀ g g' : ↥Γ,
      ρ g = ρ g' ↔
      ∀ a b, ‖((g : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b -
        ((g' : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤
        (ℓ : ℝ) ^ (-(k : ℤ)) := by
    intro k
    let Mint : ↥Γ → Matrix (Fin r) (Fin r) ℤ_[ℓ] := fun g a b =>
      ⟨((g : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b,
        hint _ g.2 a b⟩
    have hM : ∀ g a b, ((Mint g a b : ℤ_[ℓ]) : ℚ_[ℓ]) =
        ((g : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b :=
      fun _ _ _ => rfl
    have hM1 : Mint 1 = 1 := by
      ext a b
      apply PadicInt.ext
      rw [hM]
      simp only [OneMemClass.coe_one, Units.val_one, Matrix.one_apply]
      split_ifs <;> simp
    have hMmul : ∀ g g', Mint (g * g') = Mint g * Mint g' := by
      intro g g'
      ext a b
      apply PadicInt.ext
      rw [hM, Matrix.mul_apply]
      change _ = PadicInt.Coe.ringHom (∑ j, Mint g a j * Mint g' j b)
      rw [map_sum]
      simp only [map_mul, Subgroup.coe_mul, Units.val_mul, Matrix.mul_apply]
      rfl
    let ρ₀ : ↥Γ →* Matrix (Fin r) (Fin r) (ZMod (ℓ ^ k)) :=
      { toFun := fun g => (Mint g).map (PadicInt.toZModPow k)
        map_one' := by
          show (Mint 1).map (PadicInt.toZModPow k) = 1
          rw [hM1]
          exact Matrix.map_one _ (map_zero _) (map_one _)
        map_mul' := fun g g' => by
          show (Mint (g * g')).map (PadicInt.toZModPow k) =
            (Mint g).map (PadicInt.toZModPow k) * (Mint g').map (PadicInt.toZModPow k)
          rw [hMmul]
          exact Matrix.map_mul }
    have key : ∀ g g' : ↥Γ, ∀ a b, (ρ₀ g a b = ρ₀ g' a b ↔
        ‖((g : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b -
        ((g' : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤
        (ℓ : ℝ) ^ (-(k : ℤ))) := by
      intro g g' a b
      change PadicInt.toZModPow k (Mint g a b) = PadicInt.toZModPow k (Mint g' a b) ↔ _
      rw [← RingHom.sub_mem_ker_iff, PadicInt.ker_toZModPow,
        ← PadicInt.norm_le_pow_iff_mem_span_pow, PadicInt.norm_def, PadicInt.coe_sub, hM, hM]
    refine ⟨ρ₀.toHomUnits, fun g g' => ?_⟩
    constructor
    · intro hρ a b
      apply (key g g' a b).1
      have := congrArg
        (fun u : (Matrix (Fin r) (Fin r) (ZMod (ℓ ^ k)))ˣ => u.val a b) hρ
      simpa only [MonoidHom.coe_toHomUnits] using this
    · intro hab
      apply Units.ext
      rw [MonoidHom.coe_toHomUnits, MonoidHom.coe_toHomUnits]
      ext a b
      exact (key g g' a b).2 (hab a b)

  have s2 : ∀ (G Q : Type) [Group G] [Group Q] [Finite Q]
      (ψ : G →* Q), Function.Surjective ψ → ∀ (P' : Set G),
      (∀ g : G, ∀ p ∈ P', g * p * g⁻¹ ∈ P') →
      (∀ (Q' : Type) [Group Q'] [Finite Q'] (χ : Q →* Q'),
        (∀ p ∈ P', χ (ψ p) = 1) → ∀ q : Q, χ q = 1) →
      ∀ g : G, ∃ x ∈ Submonoid.closure P', ψ x = ψ g := by
    intro G Q _ _ _ ψ hψ P' hconj hQ' g
    have hkill : ∀ p ∈ P', QuotientGroup.mk' (Subgroup.normalClosure (ψ '' P')) (ψ p) = 1 := by
      intro p hp
      rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
      exact Subgroup.subset_normalClosure ⟨p, hp, rfl⟩
    have h1 : ψ g ∈ Subgroup.normalClosure (ψ '' P') := by
      have := hQ' (Q ⧸ Subgroup.normalClosure (ψ '' P'))
        (QuotientGroup.mk' (Subgroup.normalClosure (ψ '' P'))) hkill (ψ g)
      rwa [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff] at this
    have h2 : Group.conjugatesOfSet (ψ '' P') ⊆ ψ '' P' := by
      intro y hy
      rw [Group.mem_conjugatesOfSet_iff] at hy
      obtain ⟨s, ⟨p, hp, rfl⟩, hc⟩ := hy
      rw [isConj_iff] at hc
      obtain ⟨c, rfl⟩ := hc
      obtain ⟨g₀, rfl⟩ := hψ c
      exact ⟨g₀ * p * g₀⁻¹, hconj g₀ p hp, by simp only [map_mul, map_inv]⟩
    have h3 : Subgroup.normalClosure (ψ '' P') ≤ Subgroup.closure (ψ '' P') :=
      Subgroup.closure_mono h2
    have h4 : ψ g ∈ Submonoid.closure (ψ '' P') := by
      rw [← Subgroup.closure_toSubmonoid_of_finite]
      exact h3 h1
    rw [← MonoidHom.map_mclosure, Submonoid.mem_map] at h4
    exact h4

  intro C hC h1C hmulC hPC h hh
  apply s3 C hC
  intro k
  obtain ⟨ρ, hρ⟩ := s1 k
  let P' : Set ↥Γ := {p | (p : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) ∈ P}
  have hconj' : ∀ g : ↥Γ, ∀ p ∈ P', g * p * g⁻¹ ∈ P' := by
    intro g p hp
    show ((g * p * g⁻¹ : ↥Γ) : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) ∈ P
    rw [Subgroup.coe_mul, Subgroup.coe_mul, Subgroup.coe_inv]
    exact hPconj g g.2 p hp
  have hQ' : ∀ (Q' : Type) [Group Q'] [Finite Q'] (χ : ↥ρ.range →* Q'),
      (∀ p ∈ P', χ (ρ.rangeRestrict p) = 1) → ∀ q : ↥ρ.range, χ q = 1 := by
    intro Q' _ _ χ hχ q
    obtain ⟨g, rfl⟩ := ρ.rangeRestrict_surjective q
    refine hQ Q' (χ.comp ρ.rangeRestrict) k ?_ ?_ g
    · intro x y hxy
      simp only [MonoidHom.comp_apply]
      congr 1
      apply Subtype.ext
      simp only [MonoidHom.coe_rangeRestrict]
      exact (hρ x y).2 hxy
    · intro p hp
      exact hχ p hp
  obtain ⟨x, hx, hxe⟩ := s2 ↥Γ ↥ρ.range ρ.rangeRestrict ρ.rangeRestrict_surjective P' hconj' hQ'
    ⟨h, hh⟩
  have hρx : ρ x = ρ ⟨h, hh⟩ := by
    have := congrArg Subtype.val hxe
    simpa only [MonoidHom.coe_rangeRestrict] using this
  refine ⟨((x : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]), ?_,
    (hρ x ⟨h, hh⟩).1 hρx⟩
  clear hρx hxe
  induction hx using Submonoid.closure_induction with
  | mem p hp => exact hPC p hp
  | one => simpa using h1C
  | mul a b _ _ ha hb =>
    rw [Subgroup.coe_mul, Units.val_mul]
    exact hmulC _ ha _ hb

theorem wc_vqm_inertia_frame_conj (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (r : ℕ)
    (θ : (wcPencilVQ D ℓ hP).over W ≅ (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W)
    (φ : W ⟶ W) (hB : wcVQGalFrame D ℓ hP W w r θ φ)
    (Γ : Subgroup (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ)
    (hΓ : ∀ h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ, h ∈ Γ ↔
      ∃ γ : W ⟶ W, γ ≫ w = w ∧ wcVQFrame D ℓ hP W r θ γ (h : Matrix (Fin r) (Fin r) ℚ_[ℓ])) :
    ∀ h ∈ Γ, ∀ (p : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) (i : Fin D.m) (σ : W ⟶ W),
      wcHonestIsInertia D hP W w i σ → wcVQFrame D ℓ hP W r θ σ (p : Matrix (Fin r) (Fin r) ℚ_[ℓ]) →
      ∃ σ' : W ⟶ W, wcHonestIsInertia D hP W w i σ' ∧
        wcVQFrame D ℓ hP W r θ σ' ((h * p * h⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
          Matrix (Fin r) (Fin r) ℚ_[ℓ]) :=
by
  classical
  obtain ⟨-, -, hconn, -, -, hgal, -⟩ := hB
  haveI := hconn
  intro h hh p i σ hσ hσp
  have hcancel2 : ∀ (T : Over W)
      (c : ((wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W).obj.obj
        (Opposite.op T)),
      (θ.hom.hom.app (Opposite.op T)).hom ((θ.inv.hom.app (Opposite.op T)).hom c) = c := by
    intro T c
    exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom c) θ.inv_hom_id
  have hs3 := fun γ : W ⟶ W =>
    wc_proet_deck_frame_linear (wcP1Over F'').left ℓ (wcPencilVQ D ℓ hP) W hconn r θ γ
  obtain ⟨z₀⟩ : Nonempty W.left := ConnectedSpace.toNonempty
  have hconst : ∀ v : Fin r → ℚ_[ℓ], ∃ s : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op W),
      ∀ z : W.left, (show C(↥W.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z = v := by
    intro v
    let c : (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op W) :=
      (show (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op W) from
        ULift.up (ContinuousMap.const ↥W.left v))
    refine ⟨(θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom c, fun z => ?_⟩
    have hs := hcancel2 (Over.mk (𝟙 W)) c
    exact congrArg (fun y : ULift.{u+1} C(↥W.left, Fin r → ℚ_[ℓ]) => y.down z) hs
  choose fr hfr0 using hs3

  have hA : ∀ (γ : W ⟶ W) (g : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      wcVQFrame D ℓ hP W r θ γ g → ∀ u, fr γ u = g.mulVec u := by
    intro γ g hg u
    obtain ⟨s, hs⟩ := hconst u
    have h1 := hfr0 γ W (𝟙 W) γ (Category.id_comp γ).symm s z₀
    have h2 := hg s z₀
    rw [hs z₀] at h1 h2
    exact h1.symm.trans h2
  obtain ⟨δ, hδw, hδ⟩ := (hΓ h).1 hh
  obtain ⟨δ', hδ'w, hinv⟩ := hgal W δ (𝟙 W) hconn (by rw [hδw, Category.id_comp])
  have hAδ := hA δ _ hδ
  have hAσ := hA σ _ hσp
  have hAδ' : ∀ u, fr δ' u =
      ((h⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec u := by
    intro u
    obtain ⟨s, hs⟩ := hconst
      (((h⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec u)
    have hhv : (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec
        (((h⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec u) = u := by
      rw [Matrix.mulVec_mulVec, Units.mul_inv, Matrix.one_mulVec]
    have h1 := hfr0 δ' W δ (𝟙 W) hinv s z₀
    have h2 := hδ s z₀
    rw [hs z₀] at h1 h2
    rw [h2, hhv] at h1
    exact h1.symm
  unfold wcHonestIsInertia at hσ ⊢
  refine ⟨δ' ≫ σ ≫ δ, ⟨?_, ?_⟩, ?_⟩
  · rw [Category.assoc, Category.assoc, hδw, hσ.1, hδ'w]
  · obtain ⟨_, V, v, A, i1, i2, i3, e, hV, L, j1, j2, Vt, eVt, u', c, τ, I1, I2, I3⟩ := hσ
    refine ⟨V, v, A, i1, i2, i3, e, hV, L, j1, j2, Vt, eVt, u', c ≫ δ, τ, ?_, I2, ?_⟩
    · rw [I1, Category.assoc, hδw]
    · have hc : c ≫ σ = c ≫ δ ≫ δ' ≫ σ := by
        rw [← Category.assoc δ δ' σ, ← hinv, Category.id_comp]
      rw [← Category.assoc τ c δ, I3, hc]
      simp only [Category.assoc]
  · intro s z
    have e1 := hfr0 δ W (δ' ≫ σ) (δ' ≫ σ ≫ δ) (Category.assoc _ _ _).symm s z
    have e2 := hfr0 σ W δ' (δ' ≫ σ) rfl s z
    have e3 := hfr0 δ' W (𝟙 W) δ' (Category.id_comp δ').symm s z
    rw [e1, e2, e3, hAδ, hAσ, hAδ', Matrix.mulVec_mulVec, Matrix.mulVec_mulVec,
      Units.val_mul, Units.val_mul]

theorem wc_vqm_quotient_torsor (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (r : ℕ)
    (θ : (wcPencilVQ D ℓ hP).over W ≅ (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W)
    (φ : W ⟶ W) (hB : wcVQGalFrame D ℓ hP W w r θ φ)
    (Γ : Subgroup (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ)
    (hΓ : ∀ h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ, h ∈ Γ ↔
      ∃ γ : W ⟶ W, γ ≫ w = w ∧ wcVQFrame D ℓ hP W r θ γ (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]))
    (Ub : (wcGeomPoint F'' (wcP1Over F'') hP).left.Opens)
    (hUb : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left, p ∈ Ub ↔
      ∀ i : Fin D.m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠ D.S i (IsLocalRing.closedPoint F''))
    (Q : Type) [Group Q] [Finite Q] (χ : ↥Γ →* Q) (k : ℕ)
    (hχc : ∀ h h' : ↥Γ, (∀ a b, ‖((h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
        Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b - ((h' : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
        Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ (ℓ : ℝ) ^ (-(k : ℤ))) → χ h = χ h')
    (hχP : ∀ (h : ↥Γ) (i : Fin D.m) (σ : W ⟶ W), wcHonestIsInertia D hP W w i σ →
      wcVQFrame D ℓ hP W r θ σ ((h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
        Matrix (Fin r) (Fin r) ℚ_[ℓ]) → χ h = 1) :
    ∃ (E : Scheme.{u}) (πE : E ⟶ Ub.toScheme), IsFinite πE ∧ Etale πE ∧ Surjective πE ∧
      (∀ (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
        (v : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
        (A : Type u) [CommRing A] [HenselianLocalRing A]
        [IsSepClosed (IsLocalRing.ResidueField A)] (e : V.left ≅ Spec (.of A)),
        V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F'') →
        ∀ y : ↥(Limits.pullback πE (Limits.pullback.snd v.left Ub.ι) : Scheme.{u}),
          ∃ sec : Limits.pullback v.left Ub.ι ⟶ Limits.pullback πE (Limits.pullback.snd v.left Ub.ι),
            sec ≫ Limits.pullback.snd _ _ = 𝟙 _ ∧ y ∈ Set.range ⇑sec) ∧
      (∀ sec : Ub.toScheme ⟶ E, sec ≫ πE = 𝟙 _ → ∀ h : ↥Γ, χ h = 1) :=
by
  classical
  obtain ⟨-, hqc, hconn, hoff, hcov, hgal, -, -, -, -⟩ := hB
  haveI := hconn
  obtain ⟨z₀⟩ : Nonempty W.left := ConnectedSpace.toNonempty

  obtain ⟨Gm, hGa, hGc, hGd, hGe⟩ : ∃ Gm : ↥(Limits.pullback w.left w.left) →
      ((Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])),
      (∀ z, ∃ γ : W ⟶ W, γ ≫ w = w ∧ ∀ (s : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op W))
        (x : W.left),
        (show C(↥W.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) x =
          Gm z ((show C(↥W.left, Fin r → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) x)) ∧
      (∀ j : Fin r, Continuous (fun z => Gm z (Pi.single j 1))) ∧
      (∀ (Z : Scheme.{u}) (a b d : Z ⟶ W.left) (hab : a ≫ w.left = b ≫ w.left)
        (hbd : b ≫ w.left = d ≫ w.left) (had : a ≫ w.left = d ≫ w.left) (z : Z),
        Gm (Limits.pullback.lift a d had z) =
          Gm (Limits.pullback.lift b d hbd z) ∘ₗ Gm (Limits.pullback.lift a b hab z)) ∧
      (∀ (δ : W ⟶ W) (g : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]))
        (hδ : δ.left ≫ w.left = 𝟙 W.left ≫ w.left), δ ≫ w = w →
        (∀ (s : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op W)) (x : W.left),
          (show C(↥W.left, Fin r → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk δ))).hom s).down) x =
            g ((show C(↥W.left, Fin r → ℚ_[ℓ]) from
              ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) x)) →
        ∀ z, Gm (Limits.pullback.lift δ.left (𝟙 W.left) hδ z) ∘ₗ g = LinearMap.id) := by

    haveI hBp : WeaklyEtale (wcGeomPoint F'' (wcP1Over F'') hP).hom :=
      (wcGeomPoint F'' (wcP1Over F'') hP).prop
    haveI hWp : WeaklyEtale W.hom := W.prop
    haveI hwB : WeaklyEtale (w.left ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) := by
      rw [MorphismProperty.Over.w w]; exact hWp
    haveI hwl : WeaklyEtale w.left :=
      WeaklyEtale.of_comp w.left (wcGeomPoint F'' (wcP1Over F'') hP).hom

    have TR : ∀ (V V' : (wcP1Over F'').left.ProEt) (h' : V' ⟶ W) (j : V ⟶ V')
        (y : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op V')) (z : V.left),
        (show C(↥V.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk (j ≫ h')))).hom
            (((wcPencilVQ D ℓ hP).obj.map j.op).hom y)).down) z =
        (show C(↥V'.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom y).down) (j.left z) := by
      intro V V' h' j y z
      have hn := θ.hom.hom.naturality
        (Over.homMk j (by rfl) : (Over.mk (j ≫ h') : Over W) ⟶ Over.mk h').op
      have h1 := congrArg (fun m => m.hom y) hn
      have h2 : (θ.hom.hom.app (Opposite.op (Over.mk (j ≫ h')))).hom
            (((wcPencilVQ D ℓ hP).obj.map j.op).hom y) =
          ((wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).obj.map j.op).hom
            ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom y) := h1
      rw [h2]
      rfl

    have hcancel2 : ∀ (T : Over W)
        (c : ((wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W).obj.obj
          (Opposite.op T)),
        (θ.hom.hom.app (Opposite.op T)).hom ((θ.inv.hom.app (Opposite.op T)).hom c) = c := by
      intro T c
      exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom c) θ.inv_hom_id
    have hK : ∀ (V : (wcP1Over F'').left.ProEt) (a : V ⟶ W) (v₀ : Fin r → ℚ_[ℓ]),
        ∃ t : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op V), ∀ x : V.left,
          (show C(↥V.left, Fin r → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom t).down) x = v₀ := by
      intro V a v₀
      let c : (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op V) :=
        (show (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op V) from
          ULift.up (ContinuousMap.const ↥V.left v₀))
      refine ⟨(θ.inv.hom.app (Opposite.op (Over.mk a))).hom c, fun x => ?_⟩
      have hs := hcancel2 (Over.mk a) c
      exact congrArg (fun y : ULift.{u+1} C(↥V.left, Fin r → ℚ_[ℓ]) => y.down x) hs

    choose A hA using fun γ : W ⟶ W =>
      wc_proet_deck_frame_linear (wcP1Over F'').left ℓ (wcPencilVQ D ℓ hP) W hconn r θ γ

    have hnbhd : ∀ (V₀ : (wcP1Over F'').left.ProEt) (z : V₀.left),
        ∃ (V₁ : (wcP1Over F'').left.ProEt) (kk : V₁ ⟶ V₀) (z₁ : V₁.left),
          ConnectedSpace V₁.left ∧ kk.left z₁ = z := by
      intro V₀ z
      have hι : WeaklyEtale (V₀.left.fromSpecStalk z) := by
        refine ⟨?_, inferInstance⟩
        obtain ⟨_, ⟨U, hU, rfl⟩, hx, -⟩ :=
          V₀.left.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ z) isOpen_univ
        replace hU : IsAffineOpen U := hU
        rw [← hU.fromSpecStalk_eq_fromSpecStalk hx]
        show Flat (Spec.map (V₀.left.presheaf.germ U z hx) ≫ hU.fromSpec)
        have : Flat (Spec.map (V₀.left.presheaf.germ U z hx)) := by
          rw [HasRingHomProperty.Spec_iff (P := @Flat)]
          letI : Algebra Γ(V₀.left, U) (V₀.left.presheaf.stalk z) :=
            (V₀.left.presheaf.germ U z hx).hom.toAlgebra
          haveI := hU.isLocalization_stalk ⟨z, hx⟩
          exact RingHom.flat_algebraMap_iff.mpr
            (IsLocalization.flat _ (hU.primeIdealOf ⟨z, hx⟩).asIdeal.primeCompl)
        have hoi : IsOpenImmersion hU.fromSpec := hU.isOpenImmersion_fromSpec
        have hfs : Flat hU.fromSpec := Flat.instOfIsOpenImmersion _
        exact MorphismProperty.comp_mem @Flat _ _ this hfs
      have hcomp : WeaklyEtale (V₀.left.fromSpecStalk z ≫ V₀.hom) :=
        @MorphismProperty.comp_mem _ _ @WeaklyEtale
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ hι V₀.prop
      let V₁ : (wcP1Over F'').left.ProEt :=
        MorphismProperty.Over.mk ⊤ (V₀.left.fromSpecStalk z ≫ V₀.hom) hcomp
      let kk : V₁ ⟶ V₀ := MorphismProperty.Over.homMk (V₀.left.fromSpecStalk z) rfl trivial
      have hconnR : ∀ (R : CommRingCat.{u}) [IsLocalRing R], ConnectedSpace (Spec R) := by
        intro R _
        have hpre : PreconnectedSpace (PrimeSpectrum R) := by
          rw [preconnectedSpace_iff_clopen]
          intro s hs
          obtain ⟨e, he, rfl⟩ := PrimeSpectrum.isClopen_iff.mp hs
          rcases IsLocalRing.isUnit_or_isUnit_one_sub_self e with h | h
          · right
            have he1 : e = 1 := h.mul_left_cancel (by rw [mul_one]; exact he.eq)
            subst he1
            simp
          · left
            have he0 : e = 0 := by
              have h0 : (1 - e) * e = (1 - e) * 0 := by
                rw [sub_mul, one_mul, he.eq, sub_self, mul_zero]
              exact h.mul_left_cancel h0
            subst he0
            simp
        have hc : ConnectedSpace (PrimeSpectrum R) :=
          { toPreconnectedSpace := hpre, toNonempty := ⟨IsLocalRing.closedPoint R⟩ }
        exact hc
      exact ⟨V₁, kk, IsLocalRing.closedPoint _, hconnR (V₀.left.presheaf.stalk z),
        Scheme.fromSpecStalk_closedPoint⟩

    haveI : WeaklyEtale (Limits.pullback.fst w.left w.left) := inferInstance
    haveI : WeaklyEtale (Limits.pullback.fst w.left w.left ≫ W.hom) := inferInstance
    let Zo : (wcP1Over F'').left.ProEt :=
      Scheme.ProEt.mk (Limits.pullback.fst w.left w.left ≫ W.hom)
    let P₁ : Zo ⟶ W :=
      MorphismProperty.Over.homMk (Limits.pullback.fst w.left w.left) rfl trivial
    have h₂ : Limits.pullback.snd w.left w.left ≫ W.hom =
        Limits.pullback.fst w.left w.left ≫ W.hom := by
      rw [← MorphismProperty.Over.w w, ← Category.assoc, ← Category.assoc,
        Limits.pullback.condition]
    let P₂ : Zo ⟶ W :=
      MorphismProperty.Over.homMk (Limits.pullback.snd w.left w.left) h₂ trivial
    have hPw : P₁ ≫ w = P₂ ≫ w := by
      apply MorphismProperty.Over.Hom.ext
      exact Limits.pullback.condition (f := w.left) (g := w.left)

    choose V₁ κ z₁ hc hκ using fun z : ↥(Limits.pullback w.left w.left) => hnbhd Zo z
    have hab0 : ∀ z, (κ z ≫ P₁) ≫ w = (κ z ≫ P₂) ≫ w := fun z => by
      rw [Category.assoc, Category.assoc, hPw]
    choose γ hγw hγ using fun z => hgal (V₁ z) (κ z ≫ P₁) (κ z ≫ P₂) (hc z) (hab0 z)

    have hb : ∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ W)
        (hl : a.left ≫ w.left = b.left ≫ w.left)
        (t : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op V)) (z : V.left),
        (show C(↥V.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom t).down) z =
        A (γ (Limits.pullback.lift a.left b.left hl z))
          ((show C(↥V.left, Fin r → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom t).down) z) := by
      intro V a b hl t v
      generalize hz₀ : Limits.pullback.lift a.left b.left hl v = z₀
      have hKw : Limits.pullback.lift a.left b.left hl ≫
          (Limits.pullback.fst w.left w.left ≫ W.hom) = V.hom := by
        rw [Limits.pullback.lift_fst_assoc, MorphismProperty.Over.w a]
      let Kh : V ⟶ Zo :=
        MorphismProperty.Over.homMk (Limits.pullback.lift a.left b.left hl) hKw trivial
      have hK1 : Kh ≫ P₁ = a := by
        apply MorphismProperty.Over.Hom.ext
        exact Limits.pullback.lift_fst a.left b.left hl
      have hK2 : Kh ≫ P₂ = b := by
        apply MorphismProperty.Over.Hom.ext
        exact Limits.pullback.lift_snd a.left b.left hl
      haveI : WeaklyEtale (V₁ z₀).hom := (V₁ z₀).prop
      haveI hVp : WeaklyEtale V.hom := V.prop
      haveI hZp : WeaklyEtale Zo.hom := Zo.prop
      haveI : WeaklyEtale (Kh.left ≫ Zo.hom) := by
        rw [MorphismProperty.Over.w Kh]; exact hVp
      haveI : WeaklyEtale Kh.left := WeaklyEtale.of_comp Kh.left Zo.hom
      haveI : WeaklyEtale (Limits.pullback.fst (κ z₀).left Kh.left) := inferInstance
      haveI : WeaklyEtale (Limits.pullback.fst (κ z₀).left Kh.left ≫ (V₁ z₀).hom) :=
        inferInstance
      let Q : (wcP1Over F'').left.ProEt :=
        Scheme.ProEt.mk (Limits.pullback.fst (κ z₀).left Kh.left ≫ (V₁ z₀).hom)
      let p₁ : Q ⟶ V₁ z₀ :=
        MorphismProperty.Over.homMk (Limits.pullback.fst (κ z₀).left Kh.left) rfl trivial
      have hq2 : Limits.pullback.snd (κ z₀).left Kh.left ≫ V.hom =
          Limits.pullback.fst (κ z₀).left Kh.left ≫ (V₁ z₀).hom := by
        rw [← MorphismProperty.Over.w Kh, ← MorphismProperty.Over.w (κ z₀), ← Category.assoc,
          ← Category.assoc, Limits.pullback.condition]
      let p₂ : Q ⟶ V :=
        MorphismProperty.Over.homMk (Limits.pullback.snd (κ z₀).left Kh.left) hq2 trivial
      have hsq : p₁ ≫ κ z₀ = p₂ ≫ Kh := by
        apply MorphismProperty.Over.Hom.ext
        exact Limits.pullback.condition (f := (κ z₀).left) (g := Kh.left)
      obtain ⟨qq, -, hqv⟩ := Scheme.Pullback.exists_preimage_pullback
        (f := (κ z₀).left) (g := Kh.left) (z₁ z₀) v ((hκ z₀).trans hz₀.symm)
      have key : p₂ ≫ b = (p₂ ≫ a) ≫ γ z₀ := by
        calc p₂ ≫ b = p₂ ≫ Kh ≫ P₂ := by rw [hK2]
          _ = (p₂ ≫ Kh) ≫ P₂ := (Category.assoc _ _ _).symm
          _ = (p₁ ≫ κ z₀) ≫ P₂ := by rw [hsq]
          _ = p₁ ≫ (κ z₀ ≫ P₂) := Category.assoc _ _ _
          _ = p₁ ≫ ((κ z₀ ≫ P₁) ≫ γ z₀) := by rw [hγ z₀]
          _ = ((p₁ ≫ κ z₀) ≫ P₁) ≫ γ z₀ := by simp only [Category.assoc]
          _ = ((p₂ ≫ Kh) ≫ P₁) ≫ γ z₀ := by rw [hsq]
          _ = (p₂ ≫ a) ≫ γ z₀ := by rw [Category.assoc p₂, hK1]
      have hF := hA (γ z₀) Q (p₂ ≫ a) (p₂ ≫ b) key
        (((wcPencilVQ D ℓ hP).obj.map p₂.op).hom t) qq
      have L1 := TR Q V b p₂ t qq
      have R1 := TR Q V a p₂ t qq
      have hp' : p₂.left qq = v := hqv
      rw [hp'] at L1 R1
      exact L1.symm.trans (hF.trans (congrArg (A (γ z₀)) R1))
    refine ⟨fun z => A (γ z), ?_, ?_, ?_, ?_⟩
    ·
      intro z
      exact ⟨γ z, hγw z, fun s x => hA (γ z) W (𝟙 W) (γ z) (Category.id_comp _).symm s x⟩
    ·
      intro j
      have hl : P₁.left ≫ w.left = P₂.left ≫ w.left :=
        Limits.pullback.condition (f := w.left) (g := w.left)
      have hid : ∀ z : ↥(Limits.pullback w.left w.left),
          Limits.pullback.lift P₁.left P₂.left hl z = z := by
        intro z
        have e : Limits.pullback.lift P₁.left P₂.left hl = 𝟙 _ :=
          Limits.pullback.lift_fst_snd w.left w.left
        rw [e]
        rfl
      obtain ⟨t, ht⟩ := hK Zo P₁ (Pi.single j 1)
      have hcont := (show C(↥Zo.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk P₂))).hom t).down).continuous
      refine hcont.congr ?_
      intro z
      have h1 := hb Zo P₁ P₂ hl t z
      rw [ht z, hid z] at h1
      exact h1
    ·
      intro Z a b d hab hbd had z
      obtain ⟨f₂, hf₂⟩ : ∃ f : Limits.pullback w.left w.left ⟶
          (wcGeomPoint F'' (wcP1Over F'') hP).left,
          f = Limits.pullback.snd w.left w.left ≫ w.left := ⟨_, rfl⟩
      haveI : WeaklyEtale (Limits.pullback.fst f₂ w.left) := inferInstance
      haveI : WeaklyEtale (Limits.pullback.fst f₂ w.left ≫
        Limits.pullback.fst w.left w.left ≫ W.hom) := inferInstance
      let Q3 : (wcP1Over F'').left.ProEt := Scheme.ProEt.mk (Limits.pullback.fst f₂ w.left ≫
        Limits.pullback.fst w.left w.left ≫ W.hom)
      have eab : (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.fst w.left w.left) ≫ w.left =
          (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left) ≫ w.left := by
        rw [Category.assoc, Category.assoc, Limits.pullback.condition (f := w.left) (g := w.left)]
      have ebd : (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left) ≫ w.left =
          Limits.pullback.snd f₂ w.left ≫ w.left := by
        rw [Category.assoc, ← hf₂]
        exact Limits.pullback.condition (f := f₂) (g := w.left)
      have ead := eab.trans ebd
      have hqb : (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left) ≫ W.hom =
