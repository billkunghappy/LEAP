    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.u0 (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom D.u0)
    (L : Sheaf (Scheme.ProEt.topology D.Yt.left) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology (Limits.pullback D.f D.u0)) AddCommGrpCat.{u+1})
    [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L]
    (adj : L ⊣ wcProEtPush (Limits.pullback.fst D.f D.u0))
    (θ : ∀ V : D.Yt.left.ProEt, L.obj (wcFreeSheaf D.Yt.left V) ≅
      wcFreeSheaf (Limits.pullback D.f D.u0) ((wcProEtPullback (Limits.pullback.fst D.f D.u0)).obj V))
    (j k : ℕ) :
    Function.Bijective (wcProEtRes (Limits.pullback.fst D.f D.u0) L adj θ (ZMod (ℓ ^ k))
      ((wcProEtPullback D.f).obj V₀) j) :=
by
  obtain ⟨hfin, hcard⟩ := wc_pencil_nbhd_zmod_card_le F' F'' Y n D ℓ hℓ V₀ A e ε hv hε j k
  haveI := hfin
  exact Function.Injective.bijective_of_nat_card_le
    (wc_pencil_nbhd_torsion_restriction_injective F' F'' Y n D ℓ hℓ V₀ A e ε hv hε L adj θ j k)
    hcard

theorem wc_pencil_strict_nbhd_pbc_all_q (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hX : WeaklyEtale (Limits.pullback.fst (Over.mk (Limits.pullback.snd D.f D.u0)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom D.u0 ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.u0 (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom D.u0) :
    ∀ q : ℕ, ∃ Ψ : Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀))
        (wcLadicSheaf D.Yt.left ℓ) q →+ wcCoh F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ q,
      Function.Bijective Ψ ∧
      ∀ (c : ℚ_[ℓ]) (z : Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀))
          (wcLadicSheaf D.Yt.left ℓ) q),
        Ψ (z.comp (Abelian.Ext.mk₀ (wcLadicScalar D.Yt.left ℓ c)) (add_zero q)) =
          wcCohScalar F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ q c (Ψ z) :=
by
  intro q
  classical
  have hℓ0 : ℓ ≠ 0 := (Fact.out : ℓ.Prime).ne_zero
  have hc : ∀ k : ℕ, Continuous ((PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom) := fun k =>
    ((continuous_apply k).comp (wc_padic_tower_facts ℓ).1).congr (fun _ => rfl)

  have F0 : ∀ {S : Scheme.{u}} {U V W : S.ProEt} (a : U ⟶ V) (b : V ⟶ W),
      wcFreeSheafMap S (a ≫ b) = wcFreeSheafMap S a ≫ wcFreeSheafMap S b := by
    intro S U V W a b
    simp only [wcFreeSheafMap, Functor.map_comp, Functor.whiskerRight_comp] <;> rfl
  have Fid : ∀ {S : Scheme.{u}} (U : S.ProEt), wcFreeSheafMap S (𝟙 U) = 𝟙 _ := by
    intro S U
    simp only [wcFreeSheafMap, CategoryTheory.Functor.map_id, Functor.whiskerRight_id'] <;> rfl

  obtain ⟨hW1, hW2, hW3, hW4⟩ := wc_pencil_nbhd_qcqs F' F'' Y n D V₀ A e
  have ratY := @proet_qcqs_ladic_rationalization D.Yt.left ((wcProEtPullback D.f).obj V₀)
    hW1 hW2 ℓ _ q
  have ratX := @proet_qcqs_ladic_rationalization (Limits.pullback D.f D.u0)
    ((wcProEtPullback (Limits.pullback.fst D.f D.u0)).obj ((wcProEtPullback D.f).obj V₀))
    hW3 hW4 ℓ _ q

  obtain ⟨L, adj, hL, θ, -⟩ := wc_proet_push_left_adjoint_free_nat (Limits.pullback.fst D.f D.u0)
  haveI := hL
  haveI : L.IsLeftAdjoint := ⟨_, ⟨adj⟩⟩
  haveI : Limits.PreservesColimitsOfSize.{0, 0} L := adj.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits L :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits L
  haveI : L.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint L
  haveI : L.Additive := Functor.additive_of_preserves_binary_products L
  obtain ⟨β⟩ := wc_pencil_closed_fibre_geom_iso_nonempty F' F'' Y n D hX V₀ ε hε

  let R : ∀ (G : Sheaf (Scheme.ProEt.topology D.Yt.left) AddCommGrpCat.{u+1})
      (G' : Sheaf (Scheme.ProEt.topology (Limits.pullback D.f D.u0)) AddCommGrpCat.{u+1})
      (_ : L.obj G ⟶ G') (j : ℕ),
      Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀)) G j →+
        Abelian.Ext (wcFreeSheaf (Limits.pullback D.f D.u0)
          ((wcProEtPullback (Limits.pullback.fst D.f D.u0)).obj ((wcProEtPullback D.f).obj V₀)))
          G' j :=
    fun G G' a j => ((Abelian.Ext.mk₀ (θ ((wcProEtPullback D.f).obj V₀)).inv).precomp G'
      (zero_add j)).comp (((Abelian.Ext.mk₀ a).postcomp _ (add_zero j)).comp (L.mapExtAddHom _ _ j))
  have hR : ∀ G G' (a : L.obj G ⟶ G') (j : ℕ)
      (z : Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀)) G j),
      R G G' a j z = (Abelian.Ext.mk₀ (θ ((wcProEtPullback D.f).obj V₀)).inv).comp
        ((Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ a) (add_zero j)) (zero_add j) := by
    intro G G' a j z
    first
      | rfl
      | (simp only [R, AddMonoidHom.comp_apply, Functor.mapExtAddHom_apply]; rfl)
  have hN : ∀ {G1 G2 : Sheaf (Scheme.ProEt.topology D.Yt.left) AddCommGrpCat.{u+1}}
      {G1' G2' : Sheaf (Scheme.ProEt.topology (Limits.pullback D.f D.u0)) AddCommGrpCat.{u+1}}
      (κY : G1 ⟶ G2) (κX : G1' ⟶ G2') (a1 : L.obj G1 ⟶ G1') (a2 : L.obj G2 ⟶ G2'),
      L.map κY ≫ a2 = a1 ≫ κX → ∀ (j : ℕ)
      (z : Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀)) G1 j),
      R G2 G2' a2 j (z.comp (Abelian.Ext.mk₀ κY) (add_zero j)) =
        (R G1 G1' a1 j z).comp (Abelian.Ext.mk₀ κX) (add_zero j) := by
    intro G1 G2 G1' G2' κY κX a1 a2 h j z
    have e1 : Abelian.Ext.mapExactFunctor L (z.comp (Abelian.Ext.mk₀ κY) (add_zero j)) =
        (Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ (L.map κY)) (add_zero j) := by
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
    have e2 : ((Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ (L.map κY)) (add_zero j)).comp
        (Abelian.Ext.mk₀ a2) (add_zero j) =
        ((Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ a1) (add_zero j)).comp
        (Abelian.Ext.mk₀ κX) (add_zero j) := by
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, h,
        ← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.comp_assoc_of_third_deg_zero]
    rw [hR, hR, e1, e2]
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add j) (add_zero j) (by omega)).symm
  have hAdj : ∀ {G1 G2 : Sheaf (Scheme.ProEt.topology D.Yt.left) AddCommGrpCat.{u+1}}
      {G1' G2' : Sheaf (Scheme.ProEt.topology (Limits.pullback D.f D.u0)) AddCommGrpCat.{u+1}}
      (κY : G1 ⟶ G2) (κX : G1' ⟶ G2')
      (p1 : G1 ⟶ (wcProEtPush (Limits.pullback.fst D.f D.u0)).obj G1')
      (p2 : G2 ⟶ (wcProEtPush (Limits.pullback.fst D.f D.u0)).obj G2'),
      κY ≫ p2 = p1 ≫ (wcProEtPush (Limits.pullback.fst D.f D.u0)).map κX →
      L.map κY ≫ (adj.homEquiv _ _).symm p2 = (adj.homEquiv _ _).symm p1 ≫ κX := by
    intro G1 G2 G1' G2' κY κX p1 p2 h
    rw [← adj.homEquiv_naturality_left_symm, h, adj.homEquiv_naturality_right_symm]
  let Ψ0 : Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀))
      (wcLadicSheaf D.Yt.left ℓ) q →+ Abelian.Ext (wcFreeSheaf (Limits.pullback D.f D.u0)
        ((wcProEtPullback (Limits.pullback.fst D.f D.u0)).obj ((wcProEtPullback D.f).obj V₀)))
      (wcLadicSheaf (Limits.pullback D.f D.u0) ℓ) q :=
    R (wcLadicSheaf D.Yt.left ℓ) (wcLadicSheaf (Limits.pullback D.f D.u0) ℓ)
      ((adj.homEquiv _ _).symm (wcContPull (Limits.pullback.fst D.f D.u0) ℚ_[ℓ])) q
  let ρI : Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀))
      (wcIntSheaf D.Yt.left ℓ) q →+ Abelian.Ext (wcFreeSheaf (Limits.pullback D.f D.u0)
        ((wcProEtPullback (Limits.pullback.fst D.f D.u0)).obj ((wcProEtPullback D.f).obj V₀)))
      (wcIntSheaf (Limits.pullback D.f D.u0) ℓ) q :=
    R (wcIntSheaf D.Yt.left ℓ) (wcIntSheaf (Limits.pullback D.f D.u0) ℓ)
      ((adj.homEquiv _ _).symm (wcContPull (Limits.pullback.fst D.f D.u0) ℤ_[ℓ])) q
  let ρT : ∀ k j : ℕ, Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀))
      (wcContSheaf D.Yt.left (ZMod (ℓ ^ k))) j →+ Abelian.Ext (wcFreeSheaf (Limits.pullback D.f D.u0)
        ((wcProEtPullback (Limits.pullback.fst D.f D.u0)).obj ((wcProEtPullback D.f).obj V₀)))
      (wcContSheaf (Limits.pullback D.f D.u0) (ZMod (ℓ ^ k))) j := fun k j =>
    R (wcContSheaf D.Yt.left (ZMod (ℓ ^ k))) (wcContSheaf (Limits.pullback D.f D.u0) (ZMod (ℓ ^ k)))
      ((adj.homEquiv _ _).symm (wcContPull (Limits.pullback.fst D.f D.u0) (ZMod (ℓ ^ k)))) j

  have hLin : ∀ (c : ℚ_[ℓ]) (z : Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀))
      (wcLadicSheaf D.Yt.left ℓ) q),
      Ψ0 (z.comp (Abelian.Ext.mk₀ (wcLadicScalar D.Yt.left ℓ c)) (add_zero q)) =
        (Ψ0 z).comp (Abelian.Ext.mk₀ (wcLadicScalar (Limits.pullback D.f D.u0) ℓ c)) (add_zero q) :=
    fun c z => hN _ _ _ _ (hAdj _ _ _ _
      (wc_contPull_ladicScalar (Limits.pullback.fst D.f D.u0) ℓ c)) q z
  have hNatQ : ∀ y : Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀))
      (wcIntSheaf D.Yt.left ℓ) q,
      Ψ0 (y.comp (Abelian.Ext.mk₀ (wcIntToLadic D.Yt.left ℓ)) (add_zero q)) =
        (ρI y).comp (Abelian.Ext.mk₀ (wcIntToLadic (Limits.pullback D.f D.u0) ℓ)) (add_zero q) := by
    intro y
    have hsq : wcIntToLadic D.Yt.left ℓ ≫ wcContPull (Limits.pullback.fst D.f D.u0) ℚ_[ℓ] =
        wcContPull (Limits.pullback.fst D.f D.u0) ℤ_[ℓ] ≫
          (wcProEtPush (Limits.pullback.fst D.f D.u0)).map
            (wcIntToLadic (Limits.pullback D.f D.u0) ℓ) := by
      exact wc_contPull_intToLadic (Limits.pullback.fst D.f D.u0) ℓ
    exact hN _ _ _ _ (hAdj _ _ _ _ hsq) q y
  have hNatI : ∀ (k : ℕ) (x : Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀))
      (wcIntSheaf D.Yt.left ℓ) q),
      ρT k q (x.comp (Abelian.Ext.mk₀ (wcContSheafMap D.Yt.left
        (PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom (hc k))) (add_zero q)) =
        (ρI x).comp (Abelian.Ext.mk₀ (wcContSheafMap (Limits.pullback D.f D.u0)
          (PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom (hc k))) (add_zero q) :=
    fun k x => hN _ _ _ _ (hAdj _ _ _ _
      (wc_contPull_contSheafMap (Limits.pullback.fst D.f D.u0) _ (hc k))) q x
  have hNatC : ∀ (k : ℕ) (x : Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀))
      (wcContSheaf D.Yt.left (ZMod (ℓ ^ (k + 1)))) q),
      ρT k q (x.comp (Abelian.Ext.mk₀ (wcContSheafMap D.Yt.left (wcTowerCast ℓ k)
        continuous_of_discreteTopology)) (add_zero q)) =
        (ρT (k + 1) q x).comp (Abelian.Ext.mk₀ (wcContSheafMap (Limits.pullback D.f D.u0)
          (wcTowerCast ℓ k) continuous_of_discreteTopology)) (add_zero q) :=
    fun k x => hN _ _ _ _ (hAdj _ _ _ _
      (wc_contPull_contSheafMap (Limits.pullback.fst D.f D.u0) _
        continuous_of_discreteTopology)) q x

  have hρb : ∀ k j, Function.Bijective (ρT k j) := by
    intro k j
    exact wc_pencil_nbhd_torsion_restriction_bijective F' F'' Y n D ℓ hℓ V₀ A e ε hv hε
      L adj θ j k
  have hfinY : ∀ j k : ℕ, Finite (Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀))
      (wcContSheaf D.Yt.left (ZMod (ℓ ^ k))) j) := fun j k =>
    wc_pencil_nbhd_zmod_finite F' F'' Y n hn2 D ℓ hℓ hX V₀ A e ε hv hε j k
  have hfinX : ∀ j k : ℕ, Finite (Abelian.Ext (wcFreeSheaf (Limits.pullback D.f D.u0)
      ((wcProEtPullback (Limits.pullback.fst D.f D.u0)).obj ((wcProEtPullback D.f).obj V₀)))
      (wcContSheaf (Limits.pullback D.f D.u0) (ZMod (ℓ ^ k))) j) := fun j k => by
    haveI := hfinY j k
    exact Finite.of_surjective _ (hρb k j).2
  have hred : ∀ (S : Scheme.{u}) (k : ℕ),
      wcContSheafMap S (PadicInt.toZModPow (p := ℓ) (k + 1)).toAddMonoidHom (hc (k + 1)) ≫
        wcContSheafMap S (wcTowerCast ℓ k) continuous_of_discreteTopology =
      wcContSheafMap S (PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom (hc k) := by
    intro S k
    rw [← (wc_contSheafMap_comp_sub S (PadicInt.toZModPow (p := ℓ) (k + 1)).toAddMonoidHom
      (PadicInt.toZModPow (p := ℓ) (k + 1)).toAddMonoidHom (hc (k + 1)) (hc (k + 1))
      (wcTowerCast ℓ k) continuous_of_discreteTopology).1]
    have hφ : (wcTowerCast ℓ k).comp (PadicInt.toZModPow (p := ℓ) (k + 1)).toAddMonoidHom =
        (PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom := by
      ext x
      exact congrArg (fun f => f x) (PadicInt.zmod_cast_comp_toZModPow k (k + 1) (Nat.le_succ k))
    have hcm : ∀ (φ1 φ2 : ℤ_[ℓ] →+ ZMod (ℓ ^ k)) (h1 : Continuous φ1) (h2 : Continuous φ2),
        φ1 = φ2 → wcContSheafMap S φ1 h1 = wcContSheafMap S φ2 h2 := by
      rintro φ1 φ2 h1 h2 rfl
      rfl
    exact hcm _ _ _ _ hφ

  have hρIinj : ∀ x, ρI x = 0 → x = 0 := by
    intro x hx
    refine wc_proet_int_separated_of_finite D.Yt.left ((wcProEtPullback D.f).obj V₀) ℓ hc hfinY q x ?_
    intro k
    apply (hρb k q).1
    rw [map_zero, hNatI k x, hx]
    exact Abelian.Ext.zero_comp _ _ _ _ _
  have hρIsurj : ∀ x', ∃ x, ρI x = x' := by
    intro x'
    choose y hy using fun k => (hρb k q).2 (x'.comp (Abelian.Ext.mk₀ (wcContSheafMap
      (Limits.pullback D.f D.u0) (PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom (hc k))) (add_zero q))
    have hcomp : ∀ k, (y (k + 1)).comp (Abelian.Ext.mk₀ (wcContSheafMap D.Yt.left (wcTowerCast ℓ k)
        continuous_of_discreteTopology)) (add_zero q) = y k := by
      intro k
      apply (hρb k q).1
      have e : (Abelian.Ext.mk₀ (wcContSheafMap (Limits.pullback D.f D.u0)
            (PadicInt.toZModPow (p := ℓ) (k + 1)).toAddMonoidHom (hc (k + 1)))).comp
          (Abelian.Ext.mk₀ (wcContSheafMap (Limits.pullback D.f D.u0) (wcTowerCast ℓ k)
            continuous_of_discreteTopology)) (add_zero 0) =
          Abelian.Ext.mk₀ (wcContSheafMap (Limits.pullback D.f D.u0)
            (PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom (hc k)) := by
        rw [Abelian.Ext.mk₀_comp_mk₀, hred]
      rw [hNatC k (y (k + 1)), hy (k + 1), hy k, Abelian.Ext.comp_assoc_of_third_deg_zero]
      exact congrArg (fun t => Abelian.Ext.comp x' t (add_zero q)) e
    obtain ⟨x, hx⟩ := wc_proet_int_lim_surj D.Yt.left ((wcProEtPullback D.f).obj V₀) ℓ hc q y hcomp
    refine ⟨x, ?_⟩
    rw [← sub_eq_zero]
    refine wc_proet_int_separated_of_finite (Limits.pullback D.f D.u0)
      ((wcProEtPullback (Limits.pullback.fst D.f D.u0)).obj ((wcProEtPullback D.f).obj V₀))
      ℓ hc hfinX q _ ?_
    intro k
    refine (map_sub ((Abelian.Ext.mk₀ (wcContSheafMap (Limits.pullback D.f D.u0)
      (PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom (hc k))).postcomp
      (wcFreeSheaf (Limits.pullback D.f D.u0)
        ((wcProEtPullback (Limits.pullback.fst D.f D.u0)).obj ((wcProEtPullback D.f).obj V₀)))
      (add_zero q)) (ρI x) x').trans ?_
    rw [sub_eq_zero]
    exact (hNatI k x).symm.trans ((congrArg (ρT k q) (hx k)).trans (hy k))

  have Q1 : ∀ (S : Scheme.{u}) (P : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (j N : ℕ)
      (x : Abelian.Ext P (wcLadicSheaf S ℓ) j),
      N • x = x.comp (Abelian.Ext.mk₀ (wcLadicScalar S ℓ (N : ℚ_[ℓ]))) (add_zero j) := by
    intro S P j N x
    obtain ⟨h1, -, hadd⟩ := wc_ladic_scalar_ring S ℓ
    induction N with
    | zero =>
      have h0 : wcLadicScalar S ℓ 0 = 0 := by
        have h := congrArg (fun t => t - wcLadicScalar S ℓ 0) (hadd 0 0)
        simp only [add_zero, sub_self, add_sub_cancel_right] at h
        exact h.symm
      rw [zero_nsmul, Nat.cast_zero, h0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    | succ N ih =>
      rw [succ_nsmul, ih, Nat.cast_succ, hadd, h1, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add,
        Abelian.Ext.comp_mk₀_id]
  have hinv : ∀ (S : Scheme.{u}) (P : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (j : ℕ)
      (x : Abelian.Ext P (wcLadicSheaf S ℓ) j) (c : ℚ_[ℓ]), c ≠ 0 →
      (x.comp (Abelian.Ext.mk₀ (wcLadicScalar S ℓ c)) (add_zero j)).comp
        (Abelian.Ext.mk₀ (wcLadicScalar S ℓ c⁻¹)) (add_zero j) = x := by
    intro S P j x c hc0
    obtain ⟨h1, hmul, -⟩ := wc_ladic_scalar_ring S ℓ
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, ← hmul,
      inv_mul_cancel₀ hc0, h1, Abelian.Ext.comp_mk₀_id]
  have hΨ0inj : Function.Injective Ψ0 := by
    rw [injective_iff_map_eq_zero]
    intro z hz
    obtain ⟨a, y, hy⟩ := ratY.1 z
    have h2 : (ρI y).comp (Abelian.Ext.mk₀ (wcIntToLadic (Limits.pullback D.f D.u0) ℓ))
        (add_zero q) = 0 := by
      rw [← hNatQ y, ← hy, map_nsmul, hz, smul_zero]
    obtain ⟨b, hb⟩ := ratX.2 (ρI y) h2
    have h3 : ℓ ^ b • y = 0 := hρIinj _ (by rw [map_nsmul, hb])
    have h4 : (ℓ ^ b * ℓ ^ a) • z = 0 := by
      calc (ℓ ^ b * ℓ ^ a) • z = ℓ ^ b • (y.comp (Abelian.Ext.mk₀ (wcIntToLadic D.Yt.left ℓ))
            (add_zero q)) := by rw [mul_smul, hy]
        _ = ((Abelian.Ext.mk₀ (wcIntToLadic D.Yt.left ℓ)).postcomp
              (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀)) (add_zero q)) (ℓ ^ b • y) :=
            (by rw [map_nsmul]; rfl)
        _ = 0 := by rw [h3, map_zero]
    have h5 : z.comp (Abelian.Ext.mk₀ (wcLadicScalar D.Yt.left ℓ ((ℓ ^ b * ℓ ^ a : ℕ) : ℚ_[ℓ])))
        (add_zero q) = 0 := by
      rw [← Q1, h4]
    have hN0 : ((ℓ ^ b * ℓ ^ a : ℕ) : ℚ_[ℓ]) ≠ 0 :=
      Nat.cast_ne_zero.mpr (mul_ne_zero (pow_ne_zero _ hℓ0) (pow_ne_zero _ hℓ0))
    have h6 := hinv _ _ q z _ hN0
    rw [h5, Abelian.Ext.zero_comp] at h6
    exact h6.symm
  have hΨ0surj : Function.Surjective Ψ0 := by
    intro x'
    obtain ⟨a, y', hy'⟩ := ratX.1 x'
    obtain ⟨y, rfl⟩ := hρIsurj y'
    have hc' : ((ℓ : ℚ_[ℓ]) ^ a) ≠ 0 := pow_ne_zero _ (Nat.cast_ne_zero.mpr hℓ0)
    refine ⟨(y.comp (Abelian.Ext.mk₀ (wcIntToLadic D.Yt.left ℓ)) (add_zero q)).comp
      (Abelian.Ext.mk₀ (wcLadicScalar D.Yt.left ℓ (((ℓ : ℚ_[ℓ]) ^ a)⁻¹))) (add_zero q), ?_⟩
    rw [hLin, hNatQ, ← hy', Q1, Nat.cast_pow]
    exact hinv _ _ q x' _ hc'

  refine ⟨((Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f D.u0) β.inv)).precomp
      (wcLadicSheaf (Limits.pullback D.f D.u0) ℓ) (zero_add q)).comp Ψ0, ⟨?_, ?_⟩, ?_⟩
  · intro z z' h
    change (Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f D.u0) β.inv)).comp (Ψ0 z)
      (zero_add q) = (Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f D.u0) β.inv)).comp
        (Ψ0 z') (zero_add q) at h
    apply hΨ0inj
    have h1 : ∀ w : Abelian.Ext (wcFreeSheaf (Limits.pullback D.f D.u0)
        ((wcProEtPullback (Limits.pullback.fst D.f D.u0)).obj ((wcProEtPullback D.f).obj V₀)))
        (wcLadicSheaf (Limits.pullback D.f D.u0) ℓ) q,
        (Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f D.u0) β.hom)).comp
          ((Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f D.u0) β.inv)).comp w
            (zero_add q)) (zero_add q) = w := by
      intro w
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, ← F0, Iso.hom_inv_id, Fid, Abelian.Ext.mk₀_id_comp]
    rw [← h1 (Ψ0 z), h, h1]
  · intro w
    obtain ⟨z, hz⟩ := hΨ0surj ((Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f D.u0)
      β.hom)).comp w (zero_add q))
    refine ⟨z, ?_⟩
    change (Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f D.u0) β.inv)).comp (Ψ0 z)
      (zero_add q) = w
    rw [hz, Abelian.Ext.mk₀_comp_mk₀_assoc, ← F0, Iso.inv_hom_id, Fid, Abelian.Ext.mk₀_id_comp]
  · intro c z
    change (Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f D.u0) β.inv)).comp
        (Ψ0 (z.comp (Abelian.Ext.mk₀ (wcLadicScalar D.Yt.left ℓ c)) (add_zero q))) (zero_add q) =
      ((Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f D.u0) β.inv)).comp (Ψ0 z)
        (zero_add q)).comp (Abelian.Ext.mk₀ (wcLadicScalar (Limits.pullback D.f D.u0) ℓ c))
        (add_zero q)
    rw [hLin]
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add q) (add_zero q) (by omega)).symm

theorem wc_strict_nbhd_Rq_torsion_const (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom D.u0 ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.u0 (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom D.u0) :
    ∀ q m : ℕ, ∃ (b : ℕ) (e' : Fin b → ℕ),
      Nonempty ((((wcProEtPush D.f).rightDerived q).obj (wcContSheaf D.Yt.left (ZMod (ℓ ^ m)))).over V₀ ≅
        (wcContSheaf (wcP1Over F'').left ((i : Fin b) → ZMod (ℓ ^ e' i))).over V₀) :=
by
  classical
  intro q m
  haveI := D.proper
  haveI hProp1 : IsProper (wcP1Over F'').hom := wc_proj_space_isProper F'' 1
  haveI hsep : IsSeparated (wcP1Over F'').hom := (inferInstance : IsSeparated (wcProjKStr F'' 1))
  haveI hcomp : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; exact D.proper
  haveI hfp : IsProper D.f := IsProper.of_comp D.f (wcP1Over F'').hom

  have hℓK : (ℓ : F'') ≠ 0 := by
    intro h0
    haveI := Fintype.ofFinite F''
    have hp : (ringChar F'').Prime := CharP.char_is_prime F'' (ringChar F'')
    have h1 : ringChar F'' ∣ ℓ := ringChar.dvd h0
    have h2 : ringChar F'' = ℓ := (Nat.prime_dvd_prime_iff_eq hp (Fact.out)).mp h1
    have h3 : ((Fintype.card F'' : ℕ) : F'') = 0 := FiniteField.cast_card_eq_zero F''
    have h4 : ringChar F'' ∣ Fintype.card F'' := ringChar.dvd h3
    apply hℓ
    rw [← h2, Nat.card_eq_fintype_card]
    exact h4

  have hS_ci : ∀ i, IsClosedImmersion (D.S i) := fun i =>
    isClosedImmersion_of_comp_eq_id (wcP1Over F'').hom (D.S i) (D.hS i)
  have hrange : ∀ (i : Fin D.m) (z : (wcP1Over F'').left),
      z ∈ Set.range (D.S i) ↔ z = D.S i (IsLocalRing.closedPoint F'') := by
    intro i z
    constructor
    · rintro ⟨w, rfl⟩
      rw [Subsingleton.elim w (IsLocalRing.closedPoint F'')]
    · rintro rfl
      exact ⟨_, rfl⟩
  have hWopen : IsOpen {z : (wcP1Over F'').left | ∀ i, z ≠ D.S i (IsLocalRing.closedPoint F'')} := by
    have he : {z : (wcP1Over F'').left | ∀ i, z ≠ D.S i (IsLocalRing.closedPoint F'')} =
        (⋃ i, Set.range (D.S i))ᶜ := by
      ext z
      simp only [Set.mem_setOf_eq, Set.mem_compl_iff, Set.mem_iUnion, not_exists, hrange]
    rw [he]
    exact (isClosed_iUnion_of_finite fun i => by
      haveI := hS_ci i
      exact (D.S i).isClosedEmbedding.isClosed_range).isOpen_compl
  let W : (wcP1Over F'').left.Opens := ⟨_, hWopen⟩
  have hsm : ∀ x : D.Yt.left, D.f x ∈ W → ∃ U' : D.Yt.left.Opens, x ∈ U' ∧ Smooth (U'.ι ≫ D.f) := by
    intro x hx
    apply D.smooth_off x
    intro i hxi
    apply (show ∀ i : Fin D.m, D.f x ≠ D.S i (IsLocalRing.closedPoint F'') from hx) i
    rw [hxi, ← D.hxs i]
    first
      | rfl
      | exact (Scheme.Hom.comp_apply _ _ _).symm
  have hy₀ : D.u0 (IsLocalRing.closedPoint F'') ∈ W :=
    (show ∀ i : Fin D.m, D.u0 (IsLocalRing.closedPoint F'') ≠ D.S i (IsLocalRing.closedPoint F'')
      from fun i => D.hu0S i)

  haveI := wc_et_enough_injectives D.Yt.left
  let I := injectiveResolution ((constantSheaf (Scheme.smallEtaleTopology D.Yt.left)
    AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ m)))))
  obtain ⟨α⟩ := wc_proet_rightDerived_push_epsInv F'' D.Yt.left (wcP1Over F'').left
    (wcP1Over F'').hom D.f (ℓ ^ m) I q

  obtain ⟨U, t, ht, b, e', ⟨β⟩⟩ := wc_et_P1_smooth_proper_Rq_locally_const F'' D.Yt.left D.f W hsm
    ℓ (Fact.out) hℓK m I q (D.u0 (IsLocalRing.closedPoint F'')) hy₀
  haveI := (wc_etToProEt_flat_cont (wcP1Over F'').left).2

  obtain ⟨s3⟩ := wc_epsInv_over_iso_of_etale_local_iso (wcP1Over F'').left _ _ U ⟨β⟩
  obtain ⟨c6⟩ := wc_epsInv_const (wcP1Over F'').left
    (AddCommGrpCat.of (ULift.{u+1} ((i : Fin b) → ZMod (ℓ ^ e' i))))
  obtain ⟨c5⟩ := wc_contSheaf_discrete_const (wcP1Over F'').left ((i : Fin b) → ZMod (ℓ ^ e' i))
  let γ : (((wcProEtPush D.f).rightDerived q).obj (wcContSheaf D.Yt.left (ZMod (ℓ ^ m)))).over
        ((wcEtToProEt (wcP1Over F'').left).obj U) ≅
      (wcContSheaf (wcP1Over F'').left ((i : Fin b) → ZMod (ℓ ^ e' i))).over
        ((wcEtToProEt (wcP1Over F'').left).obj U) :=
    ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1}
        ((wcEtToProEt (wcP1Over F'').left).obj U)).mapIso α ≪≫ s3 ≪≫
      ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1}
        ((wcEtToProEt (wcP1Over F'').left).obj U)).mapIso c6 ≪≫
      ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1}
        ((wcEtToProEt (wcP1Over F'').left).obj U)).mapIso c5.symm

  haveI : Etale U.hom := U.prop
  have hw : U.hom t = (e.inv ≫ V₀.hom) (IsLocalRing.closedPoint A) := by
    refine ht.trans (hv.symm.trans ?_)
    first
      | exact (Scheme.Hom.comp_apply _ _ _).symm
      | rfl
      | simp
  obtain ⟨σ, hσ⟩ := wc_strictHensel_etale_point_lift A (e.inv ≫ V₀.hom) U.hom t hw
  have hκ : (e.hom ≫ σ) ≫ U.hom = V₀.hom := by
    rw [Category.assoc, hσ, Iso.hom_inv_id_assoc]
  let κ : V₀ ⟶ (wcEtToProEt (wcP1Over F'').left).obj U :=
    MorphismProperty.Over.homMk (e.hom ≫ σ) hκ trivial
  exact ⟨b, e', ⟨((Scheme.ProEt.topology (wcP1Over F'').left).overMapPullback AddCommGrpCat.{u+1}
    κ).mapIso γ⟩⟩

theorem wc_strict_nbhd_Rq_const_equivariant (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom D.u0 ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.u0 (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom D.u0) (q : ℕ) :
    ∃ (r : ℕ) (φ : (wcRq D.f ℓ q).over V₀ ≅
        (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over V₀),
      ∀ c : ℚ_[ℓ],
        ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} V₀).map
            (wcRqScalar D.f ℓ q c) ≫ φ.hom =
          φ.hom ≫ ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} V₀).map
            (wcContSheafMap (wcP1Over F'').left (DistribSMul.toAddMonoidHom (Fin r → ℚ_[ℓ]) c)
              (continuous_const_smul c)) :=
by
  classical

  haveI := D.proper
  haveI hsep : IsSeparated (wcP1Over F'').hom := (inferInstance : IsSeparated (wcProjKStr F'' 1))
  haveI hcomp : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; exact D.proper
  haveI hfp : IsProper D.f := IsProper.of_comp D.f (wcP1Over F'').hom
  haveI : IsAffine V₀.left := IsAffine.of_isIso e.hom
  have hconn : ConnectedSpace V₀.left := by
    have hS : ConnectedSpace (PrimeSpectrum A) :=
      { isPreconnected_univ := isPreconnected_of_forall (IsLocalRing.closedPoint A)
          (fun y _ => ⟨closure {y}, Set.subset_univ _,
            specializes_iff_mem_closure.mp (IsLocalRing.specializes_closedPoint y),
            subset_closure (Set.mem_singleton y), isPreconnected_singleton.closure⟩)
        toNonempty := ⟨IsLocalRing.closedPoint A⟩ }
    have hS' : ConnectedSpace (Spec (.of A)) := hS
    exact Function.Surjective.connectedSpace (Scheme.homeoOfIso e).symm.surjective
      (Scheme.homeoOfIso e).symm.continuous
  have hcpt : CompactSpace V₀.left := inferInstance
  have hqs : QuasiSeparatedSpace V₀.left := inferInstance

  have htors := wc_strict_nbhd_Rq_torsion_const F' F'' Y n D ℓ hℓ V₀ A e ε hv hε
  obtain ⟨a, b, e', hZ⟩ :=
    wc_proet_Rq_int_const_of_torsion_const D.f ℓ V₀ hconn hcpt hqs htors q
  obtain ⟨τ, hτ⟩ := wc_proet_Rq_rat_linear_triv D.f ℓ V₀ hconn hcpt hqs q a b e' hZ
  exact ⟨a, τ, hτ⟩

theorem wc_ext0_contSheaf_eval (S : Scheme.{u}) (V : S.ProEt) (x₀ : V.left) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    ∃ val : Abelian.Ext (wcFreeSheaf S V) (wcContSheaf S ℚ_[ℓ]) 0 →+ ℚ_[ℓ],
      Function.Surjective val ∧
      ∀ (c : ℚ_[ℓ]) (s : Abelian.Ext (wcFreeSheaf S V) (wcContSheaf S ℚ_[ℓ]) 0),
        val (s.comp (Abelian.Ext.mk₀ (wcContSheafMap S (DistribSMul.toAddMonoidHom ℚ_[ℓ] c)
          (continuous_const_smul c))) (add_zero 0)) = c * val s :=
by
  classical
  obtain ⟨e, hnat⟩ : ∃ e : ∀ F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
      (wcFreeSheaf S V ⟶ F) ≃ F.obj.obj (Opposite.op V),
      ∀ (F F' : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (φ : F ⟶ F')
        (g : wcFreeSheaf S V ⟶ F), e F' (g ≫ φ) = φ.hom.app (Opposite.op V) (e F g) := by
    let e2 : ∀ G : S.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1},
        (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ G) ≃ G.obj (Opposite.op V) :=
      fun G => ((Adjunction.whiskerRight S.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
          (yoneda.obj V ⋙ uliftFunctor.{u+1, u}) G).trans
          (uliftYonedaEquiv.{u+1} (X := V) (F := G ⋙ forget AddCommGrpCat.{u+1}))
    have hnat2 : ∀ (G G' : S.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1}) (ψ : G ⟶ G')
        (h : yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ G),
        e2 G' (h ≫ ψ) = ψ.app (Opposite.op V) (e2 G h) := by
      intro G G' ψ h
      have hW := (Adjunction.whiskerRight S.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv_naturality_right
        (X := yoneda.obj V ⋙ uliftFunctor.{u+1, u}) h ψ
      have hY := uliftYonedaEquiv_comp.{u+1}
        ((Adjunction.whiskerRight S.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
          (yoneda.obj V ⋙ uliftFunctor.{u+1, u}) G h)
        (((Functor.whiskeringRight S.ProEtᵒᵖ AddCommGrpCat.{u+1} (Type (u+1))).obj
            (forget AddCommGrpCat.{u+1})).map ψ)
      exact (congrArg (uliftYonedaEquiv.{u+1} (X := V) (F := G' ⋙ forget AddCommGrpCat.{u+1})) hW).trans hY
    refine ⟨fun F =>
      ((sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).homEquiv
          (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) F).trans (e2 F.obj), ?_⟩
    intro F F' φ g
    have hA := (sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).homEquiv_naturality_right
      (X := yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) g φ
    exact (congrArg (e2 F'.obj) hA).trans (hnat2 F.obj F'.obj φ.hom _)
  have hev : ∀ (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (φ : wcFreeSheaf S V ⟶ F),
      e F φ = φ.hom.app (Opposite.op V) (e (wcFreeSheaf S V) (𝟙 _)) := by
    intro F φ
    have h := hnat (wcFreeSheaf S V) F φ (𝟙 _)
    rwa [Category.id_comp] at h
  let ev : ((wcContSheaf S ℚ_[ℓ]).obj.obj (Opposite.op V) : Type (u+1)) → ℚ_[ℓ] :=
    fun x => (show ULift.{u+1} C(↥V.left, ℚ_[ℓ]) from x).down x₀
  have hevadd : ∀ x y, ev (x + y) = ev x + ev y := fun x y => rfl
  let val : Abelian.Ext (wcFreeSheaf S V) (wcContSheaf S ℚ_[ℓ]) 0 →+ ℚ_[ℓ] :=
    AddMonoidHom.mk'
      (fun s => ev ((Abelian.Ext.addEquiv₀ s).hom.app (Opposite.op V)
        (e (wcFreeSheaf S V) (𝟙 _))))
      (by
        intro s t
        simp only [map_add, Sheaf.Hom.add_app, AddCommGrpCat.hom_add_apply]
        exact hevadd _ _)
  have hval : ∀ s, val s = ev ((Abelian.Ext.addEquiv₀ s).hom.app (Opposite.op V)
      (e (wcFreeSheaf S V) (𝟙 _))) := fun s => rfl
  have hcomp : ∀ (σ : wcContSheaf S ℚ_[ℓ] ⟶ wcContSheaf S ℚ_[ℓ])
      (s : Abelian.Ext (wcFreeSheaf S V) (wcContSheaf S ℚ_[ℓ]) 0),
      Abelian.Ext.addEquiv₀ (s.comp (Abelian.Ext.mk₀ σ) (add_zero 0)) =
        Abelian.Ext.addEquiv₀ s ≫ σ := by
    intro σ s
    apply (Abelian.Ext.mk₀_bijective _ _).1
    show Abelian.Ext.mk₀ (Abelian.Ext.homEquiv₀ (s.comp (Abelian.Ext.mk₀ σ) (add_zero 0))) =
      Abelian.Ext.mk₀ (Abelian.Ext.homEquiv₀ s ≫ σ)
    rw [Abelian.Ext.mk₀_homEquiv₀_apply, ← Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.mk₀_homEquiv₀_apply]
  refine ⟨val, ?_, ?_⟩
  · intro a
    refine ⟨(Abelian.Ext.addEquiv₀).symm ((e (wcContSheaf S ℚ_[ℓ])).symm
      (show ((wcContSheaf S ℚ_[ℓ]).obj.obj (Opposite.op V) : Type (u+1)) from
        (ULift.up (ContinuousMap.const (↥V.left) a) : ULift.{u+1} C(↥V.left, ℚ_[ℓ])))), ?_⟩
    rw [hval, AddEquiv.apply_symm_apply, ← hev, Equiv.apply_symm_apply]
    rfl
  · intro c s
    rw [hval, hval, hcomp, ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app,
      CategoryTheory.comp_apply]
    rfl

theorem wc_strict_nbhd_punct_purity (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom D.u0 ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.u0 (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom D.u0) :
    ∀ q : ℕ, ∃ τ : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V₀) (wcRq D.f ℓ q) 0 →+
        Abelian.Ext (wcFreeSheaf (wcP1Over F'').left
          (wcOpenRestr (wcP1Over F'').left (wcPunctOpen F'' D.u0) V₀)) (wcRq D.f ℓ q) 1,
      Function.Surjective τ ∧
      ∀ (c : ℚ_[ℓ]) (y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V₀) (wcRq D.f ℓ q) 0),
        τ (y.comp (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ q c)) (add_zero 0)) =
          (τ y).comp (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ q c)) (add_zero 1) :=
by
  intro q

  let sc : ℚ_[ℓ] → (wcContSheaf (wcP1Over F'').left ℚ_[ℓ] ⟶ wcContSheaf (wcP1Over F'').left ℚ_[ℓ]) :=
    fun a => wcContSheafMap (wcP1Over F'').left (DistribSMul.toAddMonoidHom ℚ_[ℓ] a)
      (continuous_const_smul a)
  have hcongr : ∀ (f g : ℚ_[ℓ] →+ ℚ_[ℓ]) (hf : Continuous f) (hg : Continuous g), f = g →
      wcContSheafMap (wcP1Over F'').left f hf = wcContSheafMap (wcP1Over F'').left g hg := by
    intro f g hf hg h
    subst h
    rfl
  have hmul : ∀ a b : ℚ_[ℓ], sc (a * b) = sc b ≫ sc a := by
    intro a b
    rw [← (wc_contSheafMap_comp_sub (wcP1Over F'').left (DistribSMul.toAddMonoidHom ℚ_[ℓ] b)
      (DistribSMul.toAddMonoidHom ℚ_[ℓ] b) (continuous_const_smul b) (continuous_const_smul b)
      (DistribSMul.toAddMonoidHom ℚ_[ℓ] a) (continuous_const_smul a)).1]
    apply hcongr
    ext x
    simp [mul_smul] <;> ring
  have hsub : ∀ a b : ℚ_[ℓ], sc (a - b) = sc a - sc b := by
    intro a b
    rw [← (wc_contSheafMap_comp_sub (wcP1Over F'').left (DistribSMul.toAddMonoidHom ℚ_[ℓ] a)
      (DistribSMul.toAddMonoidHom ℚ_[ℓ] b) (continuous_const_smul a) (continuous_const_smul b)
      (DistribSMul.toAddMonoidHom ℚ_[ℓ] a) (continuous_const_smul a)).2]
    apply hcongr
    ext x
    simp [sub_smul] <;> ring
  have hzero : sc 0 = 0 := by
    have := hsub 0 0
    rw [sub_self, sub_self] at this
    exact this
  have hadd : ∀ a b : ℚ_[ℓ], sc (a + b) = sc a + sc b := by
    intro a b
    have h1 : a + b = a - (0 - b) := by ring
    rw [h1, hsub, hsub, hzero, zero_sub, sub_neg_eq_add]

  obtain ⟨r, φ, hφ⟩ := wc_strict_nbhd_Rq_const_equivariant F' F'' Y n hn2 D ℓ hℓ V₀ A e ε hv hε q
  obtain ⟨ΘV, hΘV⟩ := wc_ext_free_over_transport (wcP1Over F'').left V₀ V₀ (𝟙 V₀)
    (wcRq D.f ℓ q) (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])) φ 0
  obtain ⟨ΘW, hΘW⟩ := wc_ext_free_over_transport (wcP1Over F'').left V₀
    (wcOpenRestr (wcP1Over F'').left (wcPunctOpen F'' D.u0) V₀)
    (wcOpenRestrIncl (wcP1Over F'').left (wcPunctOpen F'' D.u0) V₀)
    (wcRq D.f ℓ q) (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])) φ 1
  obtain ⟨PiV, hPiV⟩ := wc_ext_contSheaf_pi_split (wcP1Over F'').left V₀ ℓ r 0
  obtain ⟨PiW, hPiW⟩ := wc_ext_contSheaf_pi_split (wcP1Over F'').left
    (wcOpenRestr (wcP1Over F'').left (wcPunctOpen F'' D.u0) V₀) ℓ r 1
  obtain ⟨κ, hκ⟩ := wc_strict_trait_punct_H1_cyclic F'' D.u0 D.hu0 ℓ hℓ V₀ A e ε hv hε
  obtain ⟨val, hvs, hvc⟩ := wc_ext0_contSheaf_eval (wcP1Over F'').left V₀
    (e.inv (IsLocalRing.closedPoint A)) ℓ

  let P : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V₀) (wcContSheaf (wcP1Over F'').left ℚ_[ℓ]) 0 →+
      Abelian.Ext (wcFreeSheaf (wcP1Over F'').left
        (wcOpenRestr (wcP1Over F'').left (wcPunctOpen F'' D.u0) V₀))
        (wcContSheaf (wcP1Over F'').left ℚ_[ℓ]) 1 :=
    { toFun := fun s => κ.comp (Abelian.Ext.mk₀ (sc (val s))) (add_zero 1)
      map_zero' := by
        simp only [map_zero, hzero, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
      map_add' := fun s t => by
        simp only [map_add, hadd, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add] }
  have hPx : ∀ s, P s = κ.comp (Abelian.Ext.mk₀ (sc (val s))) (add_zero 1) := fun s => rfl
  have hPs : Function.Surjective P := by
    intro z
    obtain ⟨a, ha⟩ := hκ z
    obtain ⟨s, hs⟩ := hvs a
    exact ⟨s, by rw [hPx, hs, ha]⟩
  have hPc : ∀ (c : ℚ_[ℓ]) s, P (s.comp (Abelian.Ext.mk₀ (sc c)) (add_zero 0)) =
      (P s).comp (Abelian.Ext.mk₀ (sc c)) (add_zero 1) := by
    intro c s
    rw [hPx, hPx, hvc, hmul, ← Abelian.Ext.mk₀_comp_mk₀]
    exact (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).symm
  let Pr : (Fin r → Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V₀)
        (wcContSheaf (wcP1Over F'').left ℚ_[ℓ]) 0) →+
      (Fin r → Abelian.Ext (wcFreeSheaf (wcP1Over F'').left
        (wcOpenRestr (wcP1Over F'').left (wcPunctOpen F'' D.u0) V₀))
        (wcContSheaf (wcP1Over F'').left ℚ_[ℓ]) 1) :=
    Pi.addMonoidHom (fun j => P.comp (Pi.evalAddMonoidHom _ j))
  have hPrx : ∀ x j, Pr x j = P (x j) := fun x j => rfl
  have hPrs : Function.Surjective Pr := by
    intro w
    choose s hs using fun j => hPs (w j)
    exact ⟨s, funext fun j => by rw [hPrx, hs]⟩
  let τ := ΘW.symm.toAddMonoidHom.comp (PiW.symm.toAddMonoidHom.comp
    (Pr.comp (PiV.toAddMonoidHom.comp ΘV.toAddMonoidHom)))
  have hτx : ∀ y, τ y = ΘW.symm (PiW.symm (Pr (PiV (ΘV y)))) := fun y => rfl
  refine ⟨τ, ?_, ?_⟩
  · intro z
    obtain ⟨x, hx⟩ := hPrs (PiW (ΘW z))
    refine ⟨ΘV.symm (PiV.symm x), ?_⟩
    rw [hτx, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply, hx,
      AddEquiv.symm_apply_apply, AddEquiv.symm_apply_apply]
  · intro c y
    rw [hτx, hτx, hΘV _ _ (hφ c) y]
    have h2 : Pr (PiV ((ΘV y).comp (Abelian.Ext.mk₀ (wcContSheafMap (wcP1Over F'').left
        (DistribSMul.toAddMonoidHom (Fin r → ℚ_[ℓ]) c) (continuous_const_smul c))) (add_zero 0))) =
        fun j => (Pr (PiV (ΘV y)) j).comp (Abelian.Ext.mk₀ (sc c)) (add_zero 1) := by
      funext j
      rw [hPrx, hPrx, hPiV]
      exact hPc c _
    rw [h2]
    have h3 : PiW.symm (fun j => (Pr (PiV (ΘV y)) j).comp (Abelian.Ext.mk₀ (sc c)) (add_zero 1)) =
        (PiW.symm (Pr (PiV (ΘV y)))).comp (Abelian.Ext.mk₀ (wcContSheafMap (wcP1Over F'').left
          (DistribSMul.toAddMonoidHom (Fin r → ℚ_[ℓ]) c) (continuous_const_smul c))) (add_zero 1) := by
      apply PiW.injective
      rw [AddEquiv.apply_symm_apply]
      funext j
      rw [hPiW, AddEquiv.apply_symm_apply]
    rw [h3]
    apply ΘW.injective
    rw [AddEquiv.apply_symm_apply, hΘW _ _ (hφ c), AddEquiv.apply_symm_apply]

theorem wc_pencil_local_purity_all_q (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hX : WeaklyEtale (Limits.pullback.fst (Over.mk (Limits.pullback.snd D.f D.u0)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    ∀ q : ℕ, ∃ θ : wcCoh F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ q →+
        Abelian.Ext (Limits.cokernel
          (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' D.u0 hP))) (wcRq D.f ℓ q) 2,
      Function.Surjective θ ∧
      ∀ (c : ℚ_[ℓ]) (z : wcCoh F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ q),
        θ (wcCohScalar F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ q c z) =
          (θ z).comp (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ q c)) (add_zero 2) :=
by
  intro q
  obtain ⟨V₀, g₀, -, A, _, _, _, e, ε, hv, -, hε, -⟩ :=
    wc_P1bar_strict_local_nbhd F'' D.u0 D.hu0 hP
  haveI hproj : Projective (wcFreeSheaf (wcP1Over F'').left V₀) :=
    wc_proet_free_projective_strict_local (wcP1Over F'').left V₀ A e
  obtain ⟨L, adj, _, θV, -⟩ := wc_proet_push_left_adjoint_free_nat D.f
  obtain ⟨Λ, hΛσ, -⟩ := ext_rightDerived_adj_projective L (wcProEtPush D.f) adj
    (wcFreeSheaf (wcP1Over F'').left V₀) (wcLadicSheaf D.Yt.left ℓ) q
  obtain ⟨Ψ, hΨb, hΨs⟩ :=
    wc_pencil_strict_nbhd_pbc_all_q F' F'' Y n hn2 D ℓ hℓ hX V₀ A e ε hv hε q
  obtain ⟨κ, hκ, -⟩ := wc_strict_nbhd_punct_excision F'' D.u0 D.hu0 hP V₀ g₀ A e ε hv hε
  haveI := hκ
  obtain ⟨τ, hτs, hτc⟩ := wc_strict_nbhd_punct_purity F' F'' Y n hn2 D ℓ hℓ V₀ A e ε hv hε q

  let Φ : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V₀) (wcRq D.f ℓ q) 0 →+
      wcCoh F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ q :=
    Ψ.comp (((Abelian.Ext.mk₀ (θV V₀).inv).precomp (wcLadicSheaf D.Yt.left ℓ) (zero_add q)).comp
      Λ.toAddMonoidHom)
  have hΦx : ∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V₀) (wcRq D.f ℓ q) 0,
      Φ y = Ψ ((Abelian.Ext.mk₀ (θV V₀).inv).comp (Λ y) (zero_add q)) := fun y => rfl
  have hcancel : ∀ w : Abelian.Ext (L.obj (wcFreeSheaf (wcP1Over F'').left V₀))
      (wcLadicSheaf D.Yt.left ℓ) q,
      (Abelian.Ext.mk₀ (θV V₀).hom).comp ((Abelian.Ext.mk₀ (θV V₀).inv).comp w (zero_add q))
        (zero_add q) = w := by
    intro w
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
  have hcancel' : ∀ w : Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀))
      (wcLadicSheaf D.Yt.left ℓ) q,
      (Abelian.Ext.mk₀ (θV V₀).inv).comp ((Abelian.Ext.mk₀ (θV V₀).hom).comp w (zero_add q))
        (zero_add q) = w := by
    intro w
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
  have hΦinj : Function.Injective Φ := by
    intro y y' h
    rw [hΦx, hΦx] at h
    have h1 := hΨb.1 h
    apply Λ.injective
    rw [← hcancel (Λ y), h1, hcancel]
  have hΦsurj : Function.Surjective Φ := by
    intro z
    obtain ⟨w, rfl⟩ := hΨb.2 z
    refine ⟨Λ.symm ((Abelian.Ext.mk₀ (θV V₀).hom).comp w (zero_add q)), ?_⟩
    show Ψ ((Abelian.Ext.mk₀ (θV V₀).inv).comp
      (Λ (Λ.symm ((Abelian.Ext.mk₀ (θV V₀).hom).comp w (zero_add q)))) (zero_add q)) = Ψ w
    rw [AddEquiv.apply_symm_apply, hcancel']
  let Φe := AddEquiv.ofBijective Φ ⟨hΦinj, hΦsurj⟩
  have hΦlin : ∀ (c : ℚ_[ℓ]) (y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V₀) (wcRq D.f ℓ q) 0),
      Φ (y.comp (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ q c)) (add_zero 0)) =
        wcCohScalar F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ q c (Φ y) := by
    intro c y
    rw [hΦx, hΦx]
    have h1 : Λ (y.comp (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ q c)) (add_zero 0)) =
        (Λ y).comp (Abelian.Ext.mk₀ (wcLadicScalar D.Yt.left ℓ c)) (add_zero q) :=
      hΛσ (wcLadicScalar D.Yt.left ℓ c) y
    rw [h1, ← hΨs c]
    congr 1
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add q) (add_zero q) (by omega)).symm
  have hΦinv : ∀ (c : ℚ_[ℓ]) (z : wcCoh F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ q),
      Φe.symm (wcCohScalar F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ q c z) =
        (Φe.symm z).comp (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ q c)) (add_zero 0) := by
    intro c z
    apply Φe.injective
    rw [AddEquiv.apply_symm_apply]
    have h := hΦlin c (Φe.symm z)
    have h2 : Φ (Φe.symm z) = z := Φe.apply_symm_apply z
    rw [h2] at h
    exact h.symm

  have hmono : Mono (wcFreeSheafMap (wcP1Over F'').left
      (wcOpenRestrIncl (wcP1Over F'').left (wcPunctOpen F'' D.u0) V₀)) := by
    have h1 : Mono (wcOpenRestrIncl (wcP1Over F'').left (wcPunctOpen F'' D.u0) V₀) := by
      have : Mono ((Scheme.ProEt.forget _ ⋙ Over.forget _).map
          (wcOpenRestrIncl (wcP1Over F'').left (wcPunctOpen F'' D.u0) V₀)) := by
        have hoi : IsOpenImmersion (Limits.pullback.snd (wcPunctOpen F'' D.u0).ι V₀.hom) := by
          infer_instance
        exact @IsOpenImmersion.mono _ _ _ hoi
      exact Functor.mono_of_mono_map _ this
    have h2 : Mono (Functor.whiskerRight
        (yoneda.map (wcOpenRestrIncl (wcP1Over F'').left (wcPunctOpen F'' D.u0) V₀))
        (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) := by
      have : ∀ W, Mono ((Functor.whiskerRight
          (yoneda.map (wcOpenRestrIncl (wcP1Over F'').left (wcPunctOpen F'' D.u0) V₀))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app W) := by
        intro W
        rw [Functor.whiskerRight_app]
        have : Mono ((yoneda.map
            (wcOpenRestrIncl (wcP1Over F'').left (wcPunctOpen F'' D.u0) V₀)).app W) :=
          (NatTrans.mono_iff_mono_app _).mp inferInstance W
        exact Functor.map_mono _ _
      exact NatTrans.mono_of_mono_app _
    unfold wcFreeSheafMap
    exact Functor.map_mono _ _
  have hS₀ : (ShortComplex.mk (wcFreeSheafMap (wcP1Over F'').left
      (wcOpenRestrIncl (wcP1Over F'').left (wcPunctOpen F'' D.u0) V₀))
      (Limits.cokernel.π (wcFreeSheafMap (wcP1Over F'').left
        (wcOpenRestrIncl (wcP1Over F'').left (wcPunctOpen F'' D.u0) V₀)))
      (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) hmono inferInstance

  let θ : wcCoh F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ q →+
      Abelian.Ext (Limits.cokernel
        (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' D.u0 hP))) (wcRq D.f ℓ q) 2 :=
    ((Abelian.Ext.mk₀ (inv κ)).precomp (wcRq D.f ℓ q) (zero_add 2)).comp
      ((hS₀.extClass.precomp (wcRq D.f ℓ q) (show 1 + 1 = 2 by rfl)).comp
        (τ.comp Φe.symm.toAddMonoidHom))
  have hθx : ∀ z : wcCoh F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ q,
      θ z = (Abelian.Ext.mk₀ (inv κ)).comp
        (hS₀.extClass.comp (τ (Φe.symm z)) (show 1 + 1 = 2 by rfl)) (zero_add 2) := fun z => rfl
  refine ⟨θ, ?_, ?_⟩
  ·
    intro y
    have h0 : (Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap (wcP1Over F'').left
        (wcOpenRestrIncl (wcP1Over F'').left (wcPunctOpen F'' D.u0) V₀)))).comp
        ((Abelian.Ext.mk₀ κ).comp y (zero_add 2)) (zero_add 2) = 0 :=
      Abelian.Ext.eq_zero_of_projective (n := 1) _
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS₀ _
      ((Abelian.Ext.mk₀ κ).comp y (zero_add 2)) h0 (show 1 + 1 = 2 by rfl)
    obtain ⟨w, hw⟩ := hτs x₁
    refine ⟨Φe w, ?_⟩
    rw [hθx, AddEquiv.symm_apply_apply, hw, hx₁, Abelian.Ext.mk₀_comp_mk₀_assoc,
      IsIso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
  ·
    intro c z
    rw [hθx, hθx, hΦinv, hτc]
    have h1 : hS₀.extClass.comp ((τ (Φe.symm z)).comp
        (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ q c)) (add_zero 1)) (show 1 + 1 = 2 by rfl) =
        (hS₀.extClass.comp (τ (Φe.symm z)) (show 1 + 1 = 2 by rfl)).comp
          (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ q c)) (add_zero 2) :=
      (Abelian.Ext.comp_assoc _ _ _ _ _ (by omega)).symm
    rw [h1]
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add 2) (add_zero 2) (by omega)).symm

theorem wc_pencil_E2_col2_fibre_surj (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hX : WeaklyEtale (Limits.pullback.fst (Over.mk (Limits.pullback.snd D.f D.u0)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    ∀ q : ℕ, ∃ γ : wcCoh F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ q →+
        wcCohG F'' (wcP1Over F'') hP (wcRq D.f ℓ q) 2,
      Function.Surjective γ ∧ ∀ (c : ℚ_[ℓ])
        (z : wcCoh F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ q),
        γ (wcCohScalar F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ q c z) =
          wcCohGEnd F'' (wcP1Over F'') hP (wcRq D.f ℓ q) 2 (wcRqScalar D.f ℓ q c) (γ z) :=
by
  classical
  intro q

  have hmono : Mono (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' D.u0 hP)) := by
    have h1 : Mono (wcPunctIncl F'' D.u0 hP) := by
      have : Mono ((Scheme.ProEt.forget _ ⋙ Over.forget _).map (wcPunctIncl F'' D.u0 hP)) := by
        have hoi : IsOpenImmersion (Limits.pullback.snd (wcPunctOpen F'' D.u0).ι
            (Limits.pullback.fst (wcP1Over F'').hom
              (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) := by
          infer_instance
        exact @IsOpenImmersion.mono _ _ _ hoi
      exact Functor.mono_of_mono_map _ this
    have h2 : Mono (Functor.whiskerRight (yoneda.map (wcPunctIncl F'' D.u0 hP))
        (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) := by
      have : ∀ W, Mono ((Functor.whiskerRight (yoneda.map (wcPunctIncl F'' D.u0 hP))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app W) := by
        intro W
        rw [Functor.whiskerRight_app]
        have : Mono ((yoneda.map (wcPunctIncl F'' D.u0 hP)).app W) :=
          (NatTrans.mono_iff_mono_app _).mp inferInstance W
        exact Functor.map_mono _ _
      exact NatTrans.mono_of_mono_app _
    unfold wcFreeSheafMap
    exact Functor.map_mono _ _

  have hS : (ShortComplex.mk (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' D.u0 hP))
      (Limits.cokernel.π (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' D.u0 hP)))
      (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) hmono inferInstance
  obtain ⟨θ, hθs, hθc⟩ := wc_pencil_local_purity_all_q F' F'' Y n hn2 D ℓ hℓ hP hX q
  have hv := wc_pencil_punct_ext2_vanish F' F'' Y n hn2 D ℓ hℓ hP q
  refine ⟨((Abelian.Ext.mk₀ (Limits.cokernel.π
      (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' D.u0 hP)))).precomp
      (wcRq D.f ℓ q) (zero_add 2)).comp θ, ?_, ?_⟩
  · intro y
    have h0 : (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left
        (wcPunctIncl F'' D.u0 hP))).comp y (zero_add 2) = 0 := hv _
    obtain ⟨x1, hx1⟩ := Abelian.Ext.contravariant_sequence_exact₂ hS _ y h0
    obtain ⟨z, hz⟩ := hθs x1
    refine ⟨z, ?_⟩
    show (Abelian.Ext.mk₀ (Limits.cokernel.π
      (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' D.u0 hP)))).comp (θ z) (zero_add 2) = y
    rw [hz]
    exact hx1
  · intro c z
    show (Abelian.Ext.mk₀ (Limits.cokernel.π
        (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' D.u0 hP)))).comp
        (θ (wcCohScalar F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ q c z))
        (zero_add 2) =
      ((Abelian.Ext.mk₀ (Limits.cokernel.π
        (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' D.u0 hP)))).comp
        (θ z) (zero_add 2)).comp (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ q c)) (add_zero 2)
    rw [hθc]
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add 2) (add_zero 2) (by omega)).symm

theorem wc_pencil_E2_finite (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    ∀ p ≤ 2, ∀ q : ℕ, ∃ (r : ℕ)
      (e : wcCohG F'' (wcP1Over F'') hP (wcRq D.f ℓ q) p ≃+ (Fin r → ℚ_[ℓ])),
      ∀ (c : ℚ_[ℓ]) (x : wcCohG F'' (wcP1Over F'') hP (wcRq D.f ℓ q) p),
        e (wcCohGEnd F'' (wcP1Over F'') hP (wcRq D.f ℓ q) p (wcRqScalar D.f ℓ q c) x) = c • e x :=
by
  classical

  have lin : ∀ {U V W : Type (u+1)} [AddCommGroup U] [AddCommGroup V] [AddCommGroup W]
      (sU : ℚ_[ℓ] → U →+ U) (sV : ℚ_[ℓ] → V →+ V) (sW : ℚ_[ℓ] → W →+ W),
      (∀ w : W, sW 1 w = w) → (∀ (a b : ℚ_[ℓ]) (w : W), sW (a * b) w = sW a (sW b w)) →
      (∀ (a b : ℚ_[ℓ]) (w : W), sW (a + b) w = sW a w + sW b w) →
      (∃ (r : ℕ) (e : U ≃+ (Fin r → ℚ_[ℓ])), ∀ (c : ℚ_[ℓ]) (u : U), e (sU c u) = c • e u) →
      ((∀ (M : AddSubgroup U) (hM : ∀ (c : ℚ_[ℓ]), ∀ u ∈ M, sU c u ∈ M) (φ : M →+ W),
          Function.Surjective φ → (∀ (c : ℚ_[ℓ]) (u : M), φ ⟨sU c u, hM c u u.2⟩ = sW c (φ u)) →
          ∃ (r : ℕ) (e : W ≃+ (Fin r → ℚ_[ℓ])), ∀ (c : ℚ_[ℓ]) (w : W), e (sW c w) = c • e w) ∧
        (∀ (ε : U →+ W) (δ : W →+ V), (∀ (c : ℚ_[ℓ]) (u : U), ε (sU c u) = sW c (ε u)) →
          (∀ (c : ℚ_[ℓ]) (w : W), δ (sW c w) = sV c (δ w)) →
          (∀ w : W, δ w = 0 → ∃ u : U, ε u = w) →
          (∃ (r : ℕ) (e : V ≃+ (Fin r → ℚ_[ℓ])), ∀ (c : ℚ_[ℓ]) (v : V), e (sV c v) = c • e v) →
          ∃ (r : ℕ) (e : W ≃+ (Fin r → ℚ_[ℓ])), ∀ (c : ℚ_[ℓ]) (w : W), e (sW c w) = c • e w)) := by
    intro U V W _ _ _ sU sV sW h1 hmul hadd hU
    obtain ⟨r, e, he⟩ := hU
    have hes : ∀ (c : ℚ_[ℓ]) (v : Fin r → ℚ_[ℓ]), e.symm (c • v) = sU c (e.symm v) := fun c v =>
      e.injective (by rw [he, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
    have h0 : ∀ w : W, sW 0 w = 0 := by
      intro w
      have h := hadd 0 0 w
      rw [add_zero] at h
      simpa using (congrArg (· - sW 0 w) h).symm
    letI : Module ℚ_[ℓ] W :=
      { smul := fun c w => sW c w
        one_smul := h1
        mul_smul := hmul
        smul_zero := fun c => map_zero (sW c)
        smul_add := fun c x y => map_add (sW c) x y
        add_smul := hadd
        zero_smul := h0 }
    have hsm : ∀ (c : ℚ_[ℓ]) (w : W), c • w = sW c w := fun _ _ => rfl
    have finish : Module.Finite ℚ_[ℓ] W → ∃ (r : ℕ) (e : W ≃+ (Fin r → ℚ_[ℓ])),
        ∀ (c : ℚ_[ℓ]) (w : W), e (sW c w) = c • e w := by
      intro hfin
      let b := Module.finBasis ℚ_[ℓ] W
      refine ⟨Module.finrank ℚ_[ℓ] W, b.equivFun.toAddEquiv, fun c w => ?_⟩
      rw [← hsm]
      exact b.equivFun.map_smul c w
    constructor
    · intro M hM φ hφs hφ
      apply finish
      let N : Submodule ℚ_[ℓ] (Fin r → ℚ_[ℓ]) :=
        { carrier := {v | e.symm v ∈ M}
          add_mem' := fun {a b} ha hb => by
            simp only [Set.mem_setOf_eq, map_add] at *
            exact M.add_mem ha hb
          zero_mem' := by simp only [Set.mem_setOf_eq, map_zero]; exact M.zero_mem
          smul_mem' := fun c v hv => by
            simp only [Set.mem_setOf_eq] at *
            rw [hes]
            exact hM c _ hv }
      let ψ : N →ₗ[ℚ_[ℓ]] W :=
        { toFun := fun v => φ ⟨e.symm v, v.2⟩
          map_add' := fun v w => by
            rw [← map_add]
            congr 1
            apply Subtype.ext
            simp
          map_smul' := fun c v => by
            rw [RingHom.id_apply, hsm, ← hφ c ⟨e.symm v, v.2⟩]
            congr 1
            apply Subtype.ext
            simp [hes] }
      have hψ : Function.Surjective ψ := by
        intro w
        obtain ⟨m, rfl⟩ := hφs w
        refine ⟨⟨e m, by simp [N, m.2]⟩, ?_⟩
        show φ ⟨e.symm (e m), _⟩ = φ m
        congr 1
        apply Subtype.ext
        simp
      exact Module.Finite.of_surjective ψ hψ
    · intro ε δ hε hδ hex hV
      obtain ⟨r', eV, heV⟩ := hV
      apply finish
      let ε' : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] W :=
        { toFun := fun v => ε (e.symm v)
          map_add' := fun v w => by simp only [map_add]
          map_smul' := fun c v => by rw [RingHom.id_apply, hsm, hes, hε] }
      let δ' : W →ₗ[ℚ_[ℓ]] (Fin r' → ℚ_[ℓ]) :=
        { toFun := fun w => eV (δ w)
          map_add' := fun v w => by simp only [map_add]
          map_smul' := fun c v => by rw [RingHom.id_apply, hsm, hδ, heV] }
      have hs1 : ((⊤ : Submodule ℚ_[ℓ] W).map δ').FG := IsNoetherian.noetherian _
      have hT : ((⊤ : Submodule ℚ_[ℓ] (Fin r → ℚ_[ℓ])).map ε').FG :=
        Submodule.FG.map ε' (IsNoetherian.noetherian _)
      have hle : (⊤ : Submodule ℚ_[ℓ] W) ⊓ LinearMap.ker δ' ≤
          (⊤ : Submodule ℚ_[ℓ] (Fin r → ℚ_[ℓ])).map ε' := by
        intro x hx
        have hx2 : δ' x = 0 := hx.2
        have hx3 : δ x = 0 := by
          have : eV (δ x) = 0 := hx2
          exact (AddEquiv.map_eq_zero_iff eV).mp this
        obtain ⟨u, hu⟩ := hex x hx3
        refine ⟨e u, trivial, ?_⟩
        show ε (e.symm (e u)) = x
        rw [AddEquiv.symm_apply_apply, hu]
      have hfg := Submodule.fg_of_fg_map_of_fg_inf_ker δ' hs1 (Submodule.FG.of_le hT hle)
      exact ⟨hfg⟩

  have hψ := wc_weaklyEtale_algebraicClosure F''
  have ht : WeaklyEtale (Limits.pullback.fst D.Yt.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip hψ
  have hX₀ : WeaklyEtale (Limits.pullback.fst (Over.mk (Limits.pullback.snd D.f D.u0)).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip hψ

  haveI := D.gi
  haveI := D.proper
  haveI := D.smooth
  obtain ⟨hgi₀, hpr₀, hsm₀⟩ := wc_pencil_fibre_props F' F'' Y n hn2 D
  haveI : GeometricallyIrreducible (Over.mk (Limits.pullback.snd D.f D.u0)).hom := hgi₀
  haveI : IsProper (Over.mk (Limits.pullback.snd D.f D.u0)).hom := hpr₀
  haveI : SmoothOfRelativeDimension (n - 1) (Over.mk (Limits.pullback.snd D.f D.u0)).hom := hsm₀

  obtain ⟨L, adj, hL, θ, -⟩ := wc_proet_push_free_adjunction F'' (wcP1Over F'') D.Yt
    (Over.homMk D.f D.hf) hP ht
  haveI := hL

  have hU : ∀ k : ℕ, ∃ (r : ℕ) (e : Abelian.Ext
        (L.obj (wcFreeSheaf (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP)))
        (wcLadicSheaf D.Yt.left ℓ) k ≃+ (Fin r → ℚ_[ℓ])),
      ∀ (c : ℚ_[ℓ]) (x : Abelian.Ext
        (L.obj (wcFreeSheaf (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP)))
        (wcLadicSheaf D.Yt.left ℓ) k),
        e ((Abelian.Ext.mk₀ (wcLadicScalar D.Yt.left ℓ c)).postcomp
          (L.obj (wcFreeSheaf (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP)))
          (add_zero k) x) = c • e x := by
    intro k
    obtain ⟨r, e, he⟩ := wc_coh_finite F'' D.Yt n ℓ hℓ ht k
    let Ψ : Abelian.Ext
        (L.obj (wcFreeSheaf (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP)))
        (wcLadicSheaf D.Yt.left ℓ) k ≃+ wcCoh F'' D.Yt ht ℓ k :=
      { toFun := fun x => (Abelian.Ext.mk₀ θ.inv).comp x (zero_add k)
        invFun := fun y => (Abelian.Ext.mk₀ θ.hom).comp y (zero_add k)
        left_inv := fun x => by
          show (Abelian.Ext.mk₀ θ.hom).comp ((Abelian.Ext.mk₀ θ.inv).comp x (zero_add k))
            (zero_add k) = x
          rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
        right_inv := fun y => by
          show (Abelian.Ext.mk₀ θ.inv).comp ((Abelian.Ext.mk₀ θ.hom).comp y (zero_add k))
            (zero_add k) = y
          rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
        map_add' := fun x y => Abelian.Ext.comp_add _ _ _ _ }
    refine ⟨r, Ψ.trans e, fun c x => ?_⟩
    show e ((Abelian.Ext.mk₀ θ.inv).comp
      (x.comp (Abelian.Ext.mk₀ (wcLadicScalar D.Yt.left ℓ c)) (add_zero k)) (zero_add k)) =
        c • e ((Abelian.Ext.mk₀ θ.inv).comp x (zero_add k))
    rw [← he c]
    congr 1
    exact (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).symm

  obtain ⟨hs1, hsmul, hsadd⟩ := wc_ladic_scalar_ring D.Yt.left ℓ
  have hmapadd : ∀ (q : ℕ) (f g : wcLadicSheaf D.Yt.left ℓ ⟶ wcLadicSheaf D.Yt.left ℓ),
      ((wcProEtPush D.f).rightDerived q).map (f + g) =
        ((wcProEtPush D.f).rightDerived q).map f + ((wcProEtPush D.f).rightDerived q).map g := by
    intro q f g
    let I := injectiveResolution (wcLadicSheaf D.Yt.left ℓ)
    have c0 : ∀ h : wcLadicSheaf D.Yt.left ℓ ⟶ wcLadicSheaf D.Yt.left ℓ,
        I.ι.f 0 ≫ (InjectiveResolution.desc h I I).f 0 = h ≫ I.ι.f 0 :=
      fun h => InjectiveResolution.desc_commutes_zero h I I
    have hsum : I.ι.f 0 ≫ (InjectiveResolution.desc f I I + InjectiveResolution.desc g I I).f 0 =
        (f + g) ≫ I.ι.f 0 := by
      rw [HomologicalComplex.add_f_apply, Preadditive.comp_add, c0, c0]
      exact (Preadditive.add_comp _ _ _ _ _ _).symm
    have hf := InjectiveResolution.isoRightDerivedObj_hom_naturality f I I _ (c0 f) (wcProEtPush D.f) q
    have hg := InjectiveResolution.isoRightDerivedObj_hom_naturality g I I _ (c0 g) (wcProEtPush D.f) q
    have hfg := InjectiveResolution.isoRightDerivedObj_hom_naturality (f + g) I I _ hsum
      (wcProEtPush D.f) q
    rw [← Iso.cancel_iso_hom_right _ _ (I.isoRightDerivedObj (wcProEtPush D.f) q), hfg,
      Preadditive.add_comp, hf, hg, Functor.map_add, Preadditive.comp_add]
  have hW1 : ∀ (p q : ℕ) (w : Abelian.Ext
      (wcFreeSheaf (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP))
      (((wcProEtPush D.f).rightDerived q).obj (wcLadicSheaf D.Yt.left ℓ)) p),
      (Abelian.Ext.mk₀ (((wcProEtPush D.f).rightDerived q).map (wcLadicScalar D.Yt.left ℓ 1))).postcomp
        (wcFreeSheaf (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP)) (add_zero p) w = w := by
    intro p q w
    show w.comp (Abelian.Ext.mk₀ (((wcProEtPush D.f).rightDerived q).map
      (wcLadicScalar D.Yt.left ℓ 1))) (add_zero p) = w
    rw [hs1, CategoryTheory.Functor.map_id, Abelian.Ext.comp_mk₀_id]
  have hWmul : ∀ (p q : ℕ) (a b : ℚ_[ℓ]) (w : Abelian.Ext
      (wcFreeSheaf (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP))
      (((wcProEtPush D.f).rightDerived q).obj (wcLadicSheaf D.Yt.left ℓ)) p),
      (Abelian.Ext.mk₀ (((wcProEtPush D.f).rightDerived q).map (wcLadicScalar D.Yt.left ℓ (a * b)))).postcomp
        (wcFreeSheaf (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP)) (add_zero p) w =
      (Abelian.Ext.mk₀ (((wcProEtPush D.f).rightDerived q).map (wcLadicScalar D.Yt.left ℓ a))).postcomp
        (wcFreeSheaf (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP)) (add_zero p)
      ((Abelian.Ext.mk₀ (((wcProEtPush D.f).rightDerived q).map (wcLadicScalar D.Yt.left ℓ b))).postcomp
        (wcFreeSheaf (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP)) (add_zero p) w) := by
    intro p q a b w
    show w.comp (Abelian.Ext.mk₀ (((wcProEtPush D.f).rightDerived q).map
        (wcLadicScalar D.Yt.left ℓ (a * b)))) (add_zero p) =
      (w.comp (Abelian.Ext.mk₀ (((wcProEtPush D.f).rightDerived q).map
        (wcLadicScalar D.Yt.left ℓ b))) (add_zero p)).comp (Abelian.Ext.mk₀
          (((wcProEtPush D.f).rightDerived q).map (wcLadicScalar D.Yt.left ℓ a))) (add_zero p)
    rw [hsmul, Functor.map_comp, ← Abelian.Ext.mk₀_comp_mk₀]
    exact (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).symm
  have hWadd : ∀ (p q : ℕ) (a b : ℚ_[ℓ]) (w : Abelian.Ext
      (wcFreeSheaf (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP))
      (((wcProEtPush D.f).rightDerived q).obj (wcLadicSheaf D.Yt.left ℓ)) p),
      (Abelian.Ext.mk₀ (((wcProEtPush D.f).rightDerived q).map (wcLadicScalar D.Yt.left ℓ (a + b)))).postcomp
