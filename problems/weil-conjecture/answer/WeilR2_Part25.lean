    have hsqσ := IsPullback.of_right H hπZ hZ
    obtain ⟨Ei⟩ := wc_et_zmod_pull_data_exists
      (Limits.pullback.fst fA (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))) m
    obtain ⟨Eπ⟩ := wc_et_zmod_pull_data_exists π m
    have hbi := wc_r2gs_hens_closed_fibre_pull_bij A X fA m hmN wc_et_henselian_proper_vanishing
      _ _ _ hZ Ei j
    have hbπ := wc_et_sepclosed_field_ext_proper_pull_bij (IsLocalRing.ResidueField A) L σ
      (Limits.pullback fA (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))))
      (Limits.pullback.snd fA (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))))
