  have hΦ₀ : ∀ (c : ℚ_[ℓ]) (y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left
      (wcPencilGeomOffS D hP)) G 0),
      Φ₀ ((Abelian.Ext.mk₀ (τ c)).postcomp
        (wcFreeSheaf (wcP1Over F'').left (wcPencilGeomOffS D hP)) (add_zero 0) y) =
