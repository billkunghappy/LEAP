by
  classical

  have hmono : Mono (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' D.u0 hP)) := by
    have h1 : Mono (wcPunctIncl F'' D.u0 hP) := by
      have : Mono ((Scheme.ProEt.forget _ ⋙ Over.forget _).map (wcPunctIncl F'' D.u0 hP)) := by
        have hoi : IsOpenImmersion (Limits.pullback.snd (wcPunctOpen F'' D.u0).ι
