    simp only [Category.assoc, HomologicalComplex.liftCycles_i]
    erw [hci, Hκ]
    rw [HomologicalComplex.cyclesMap_i_assoc,
      HomologicalComplex.singleObjCyclesSelfIso_inv_iCycles_assoc, hf,
      CochainComplex.shiftShortComplexFunctorIso_hom_app_τ₂]
    simp only [CochainComplex.shiftFunctorObjXIso, Category.assoc]
    have hX : ∀ {a b : ℤ} (h1 h2 : a = b) {Z : C} (g : (K.extend ComplexShape.embeddingUpNat).X b ⟶ Z),
        ((K.extend ComplexShape.embeddingUpNat).XIsoOfEq h1).inv ≫ ((K.extend ComplexShape.embeddingUpNat).XIsoOfEq h2).hom ≫ g = g := by
      intro a b h1 h2 Z g
      subst h1
      simp
    first
      | (erw [hX]; simp)
      | simp [HomologicalComplex.XIsoOfEq]

  obtain ⟨F, hF0, hFsurj, hFker⟩ := s1
  obtain ⟨hDsurj, hDiff⟩ := s2
  refine ⟨1, fun c => (DerivedCategory.singleFunctorIsoCompQ C 0).hom.app X' ≫
      DerivedCategory.Q.map (F c) ≫
      (DerivedCategory.Q.commShiftIso (q : ℤ)).hom.app (K.extend ComplexShape.embeddingUpNat),
    Or.inl rfl, ?_, ?_, ?_⟩
  · intro ψ
    obtain ⟨g, hg⟩ := hDsurj ((DerivedCategory.singleFunctorIsoCompQ C 0).inv.app X' ≫ ψ ≫
      (DerivedCategory.Q.commShiftIso (q : ℤ)).inv.app (K.extend ComplexShape.embeddingUpNat))
    obtain ⟨c, hc⟩ := hFsurj ((HomotopyCategory.quotient C (ComplexShape.up ℤ)).map g)
    refine ⟨c, ?_⟩
    have e : DerivedCategory.Q.map (F c) = DerivedCategory.Q.map g := (hDiff _ _).mpr hc
    simp only [e, hg, Category.assoc, Iso.inv_hom_id_app, Iso.hom_inv_id_app_assoc]
    exact Category.comp_id ψ
  · intro c c'
    rw [← hFker c c', ← hDiff (F c) (F c')]
    dsimp only
    rw [cancel_epi, cancel_mono]
  · intro c
    have e1 := DerivedCategory.shiftMap_homologyFunctor_map_Q (F c) 0 (q : ℤ) (add_zero _)
    have e2 : (DerivedCategory.homologyFunctor C 0).shiftMap (ShiftedHom.map (F c) DerivedCategory.Q) 0 (q : ℤ) (add_zero _) = (DerivedCategory.homologyFunctor C 0).map (DerivedCategory.Q.map (F c) ≫ (DerivedCategory.Q.commShiftIso (q : ℤ)).hom.app (K.extend ComplexShape.embeddingUpNat)) ≫ ((DerivedCategory.homologyFunctor C 0).shiftIso (q : ℤ) 0 (q : ℤ) (add_zero _)).hom.app (DerivedCategory.Q.obj (K.extend ComplexShape.embeddingUpNat)) := rfl
    have e3 : (HomologicalComplex.homologyFunctor C (ComplexShape.up ℤ) 0).shiftMap (F c) 0 (q : ℤ) (add_zero _) = HomologicalComplex.homologyMap (F c) 0 ≫ (CochainComplex.ShiftSequence.shiftIso C (q : ℤ) 0 (q : ℤ) (add_zero _)).hom.app (K.extend ComplexShape.embeddingUpNat) := rfl
    rw [e2, e3] at e1
    have e1' : ∀ {Z : C} (h : (K.extend ComplexShape.embeddingUpNat).homology q ⟶ Z),
        (DerivedCategory.homologyFunctor C 0).map (DerivedCategory.Q.map (F c) ≫ (DerivedCategory.Q.commShiftIso (q : ℤ)).hom.app (K.extend ComplexShape.embeddingUpNat)) ≫ ((DerivedCategory.homologyFunctor C 0).shiftIso (q : ℤ) 0 (q : ℤ) (add_zero _)).hom.app (DerivedCategory.Q.obj (K.extend ComplexShape.embeddingUpNat)) ≫ (DerivedCategory.homologyFunctorFactors C (q : ℤ)).hom.app (K.extend ComplexShape.embeddingUpNat) ≫ h =
        (DerivedCategory.homologyFunctorFactors C 0).hom.app _ ≫ HomologicalComplex.homologyMap (F c) 0 ≫ (CochainComplex.ShiftSequence.shiftIso C (q : ℤ) 0 (q : ℤ) (add_zero _)).hom.app (K.extend ComplexShape.embeddingUpNat) ≫ h := by
      intro Z h
      have t1 := congrArg (fun x => x ≫ (DerivedCategory.homologyFunctorFactors C (q : ℤ)).hom.app (K.extend ComplexShape.embeddingUpNat) ≫ h) e1
      refine (Category.assoc _ _ _).symm.trans (t1.trans ?_)
      first
        | exact (Category.assoc _ _ _).trans ((congrArg (_ ≫ ·) (Iso.inv_hom_id_app_assoc _ _ _)).trans (Category.assoc _ _ _))
        | (simp only [Category.assoc]; erw [Iso.inv_hom_id_app_assoc])
        | exact ((Category.assoc _ _ _).trans (congrArg (_ ≫ ·) ((Category.assoc _ _ _).trans (congrArg (_ ≫ ·) (Iso.inv_hom_id_app_assoc _ _ _))))).trans (congrArg (_ ≫ ·) (Category.assoc _ _ _))
    have s4' : ∀ {Z : C} (h : (DerivedCategory.homologyFunctor C 0).obj (DerivedCategory.Q.obj ((CochainComplex.singleFunctor C 0).obj X')) ⟶ Z),
        (DerivedCategory.singleFunctorCompHomologyFunctorIso C 0).inv.app X' ≫ (DerivedCategory.homologyFunctor C 0).map ((DerivedCategory.singleFunctorIsoCompQ C 0).hom.app X') ≫ h = (HomologicalComplex.singleObjHomologySelfIso (ComplexShape.up ℤ) 0 X').inv ≫ (DerivedCategory.homologyFunctorFactors C 0).inv.app ((CochainComplex.singleFunctor C 0).obj X') ≫ h := by
      intro Z h
      exact (Category.assoc _ _ _).symm.trans ((s4 =≫ h).trans (Category.assoc _ _ _))
    have e4 := s5 c.1 c.2 (F c) (hF0 c)
    rw [one_smul, ← e4]
    erw [Functor.map_comp (DerivedCategory.homologyFunctor C 0) ((DerivedCategory.singleFunctorIsoCompQ C 0).hom.app X')]
    rw [Category.assoc]
    erw [s4', e1']
    erw [Iso.inv_hom_id_app_assoc]
    rfl

theorem wc_hler_open_imm_shdata : ∀ {X Xb : Scheme.{u}} (j : X ⟶ Xb) [IsOpenImmersion j] (x₀ : X) (B₀ : Type u) [CommRing B₀] [IsLocalRing B₀] (Λ₀ : Type u) [SmallCategory Λ₀] [IsCofiltered Λ₀] (W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt X x₀)) (Scheme.Etale.forget X)) (φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left) (a₀ : Spec (.of B₀) ⟶ X), wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀ → ∃ (W' : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Xb (j x₀))) (Scheme.Etale.forget Xb)) (φ' : ∀ l, Spec (.of B₀) ⟶ (W'.obj l).right.left), wcHalShData (j x₀) B₀ Λ₀ W' φ' (a₀ ≫ j) ∧ (∀ l, IsAffine (Limits.pullback (W'.obj l).right.hom j)) ∧ IsAffine (Limits.pullback (a₀ ≫ j) j) :=
by
  intro X Xb j _ x₀ B₀ _ _ Λ₀ _ _ W₀ φ₀ a₀ hsh
  obtain ⟨h1, h2, h3, h4, h5, ⟨e₀, h6, h7⟩⟩ := hsh

  have s4 : ∀ {Y Z : Scheme.{u}} (i : Y ⟶ Z) [IsOpenImmersion i] (y : Y),
      ∃ ψ : AlgebraicClosure (Y.residueField y) ≃+* AlgebraicClosure (Z.residueField (i y)),
        Spec.map (CommRingCat.ofHom ψ.toRingHom) ≫ wcEtGeomPt Y y ≫ i = wcEtGeomPt Z (i y) := by
    intro Y Z i _ y
    have hbij : Function.Bijective (i.residueFieldMap y).hom :=
      ConcreteCategory.bijective_of_isIso (i.residueFieldMap y)
    let ψ0 : Z.residueField (i y) ≃+* Y.residueField y :=
      RingEquiv.ofBijective (i.residueFieldMap y).hom hbij
    let Φ : AlgebraicClosure (Z.residueField (i y)) ≃+* AlgebraicClosure (Y.residueField y) :=
      IsAlgClosure.equivOfEquiv (AlgebraicClosure (Z.residueField (i y)))
        (AlgebraicClosure (Y.residueField y)) ψ0
    have hΦ : ∀ s : Z.residueField (i y),
        Φ.symm (algebraMap (Y.residueField y) (AlgebraicClosure (Y.residueField y))
          ((i.residueFieldMap y).hom s)) =
        algebraMap (Z.residueField (i y)) (AlgebraicClosure (Z.residueField (i y))) s := by
      intro s
      have h1 := IsAlgClosure.equivOfEquiv_symm_algebraMap
        (AlgebraicClosure (Z.residueField (i y))) (AlgebraicClosure (Y.residueField y)) ψ0 (ψ0 s)
      rw [RingEquiv.symm_apply_apply] at h1
      exact h1
    refine ⟨Φ.symm, ?_⟩
    have hring : i.residueFieldMap y ≫
        CommRingCat.ofHom (algebraMap (Y.residueField y) (AlgebraicClosure (Y.residueField y))) ≫
        CommRingCat.ofHom Φ.symm.toRingHom =
        CommRingCat.ofHom (algebraMap (Z.residueField (i y))
          (AlgebraicClosure (Z.residueField (i y)))) := by
      ext s
      exact hΦ s
    have Lspec : ∀ {R S T U : CommRingCat.{u}} (a : R ⟶ S) (b : S ⟶ T) (c : T ⟶ U) (d : R ⟶ U),
        a ≫ b ≫ c = d → Spec.map d = Spec.map c ≫ Spec.map b ≫ Spec.map a := by
      intro R S T U a b c d h
      subst h
      simp only [Spec.map_comp, Category.assoc]
    have key := Lspec _ _ _ _ hring
    show _ ≫ (Spec.map _ ≫ Y.fromSpecResidueField y) ≫ i =
      Spec.map _ ≫ Z.fromSpecResidueField (i y)
    simp only [Category.assoc]
    rw [← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField, key]
    simp only [Category.assoc]
    rfl

  have s5 : ∀ (E : Scheme.{u}) [IsAffine E] (g : E ⟶ Xb) (k : E ⟶ X), k ≫ j = g →
      IsAffine (Limits.pullback g j) := by
    intro E _ g k hk
    subst hk
    haveI : IsIso (Limits.pullback.fst (k ≫ j) j) :=
      Limits.pullback_snd_iso_of_left_factors_mono k j
    exact IsAffine.of_isIso (Limits.pullback.fst (k ≫ j) j)
  obtain ⟨W', hW'init, ⟨θ⟩⟩ := wc_et_open_imm_shens_transport j x₀ Λ₀ W₀ h1
  let ηh : ∀ l, (W'.obj l).right.left ⟶ (W₀.obj l).right.left := fun l => (θ.hom.app l).left
  let ηi : ∀ l, (W₀.obj l).right.left ⟶ (W'.obj l).right.left := fun l => (θ.inv.app l).left
  have hhi : ∀ l, ηh l ≫ ηi l = 𝟙 _ := fun l => by
    have := congrArg (fun f => f.left) (θ.hom_inv_id_app l)
    exact this
  have hih : ∀ l, ηi l ≫ ηh l = 𝟙 _ := fun l => by
    have := congrArg (fun f => f.left) (θ.inv_hom_id_app l)
    exact this
  have hs1 : ∀ l, ηh l ≫ (W₀.obj l).right.hom ≫ j = (W'.obj l).right.hom := fun l =>
    MorphismProperty.Over.w (θ.hom.app l)
  have hs2 : ∀ l, ηi l ≫ (W'.obj l).right.hom = (W₀.obj l).right.hom ≫ j := fun l =>
    MorphismProperty.Over.w (θ.inv.app l)
  have hn1 : ∀ {l l' : Λ₀} (t : l ⟶ l'),
      (W'.map t).right.left ≫ ηh l' = ηh l ≫ (W₀.map t).right.left := fun t =>
    congrArg (fun f => f.left) (θ.hom.naturality t)
  have hn2 : ∀ {l l' : Λ₀} (t : l ⟶ l'),
      (W₀.map t).right.left ≫ ηi l' = ηi l ≫ (W'.map t).right.left := fun t =>
    congrArg (fun f => f.left) (θ.inv.naturality t)
  let φ' : ∀ l, Spec (.of B₀) ⟶ (W'.obj l).right.left := fun l => φ₀ l ≫ ηi l
  have hAff : ∀ l, IsAffine (W'.obj l).right.left := by
    intro l
    haveI := h2 l
    haveI : IsIso (ηh l) := ⟨⟨ηi l, hhi l, hih l⟩⟩
    exact IsAffine.of_isIso (ηh l)
  have hD : wcHalShData (j x₀) B₀ Λ₀ W' φ' (a₀ ≫ j) := by
    refine ⟨hW'init, hAff, ?_, ?_, ?_, ?_⟩
    · intro l l' t
      show (φ₀ l ≫ ηi l) ≫ (W'.map t).right.left = φ₀ l' ≫ ηi l'
      rw [Category.assoc, ← hn2 t, ← Category.assoc, h3 t]
    · intro l
      show (φ₀ l ≫ ηi l) ≫ (W'.obj l).right.hom = a₀ ≫ j
      rw [Category.assoc, hs2 l, ← Category.assoc, h4 l]
    · intro T z hz
      obtain ⟨z₀, hz₀, huniq⟩ := h5 T (fun l => z l ≫ ηh l) (fun {l l'} t => by
        show (z l ≫ ηh l) ≫ (W₀.map t).right.left = z l' ≫ ηh l'
        rw [Category.assoc, ← hn1 t, ← Category.assoc, hz t])
      refine ⟨z₀, fun l => ?_, fun w hw => huniq w (fun l => ?_)⟩
      · have e1 : z₀ ≫ φ₀ l = z l ≫ ηh l := hz₀ l
        show z₀ ≫ (φ₀ l ≫ ηi l) = z l
        rw [← Category.assoc, e1, Category.assoc, hhi l, Category.comp_id]
      · have e2 : w ≫ (φ₀ l ≫ ηi l) = z l := hw l
        show w ≫ φ₀ l = z l ≫ ηh l
        rw [← e2, Category.assoc, Category.assoc, hih l, Category.comp_id]
    · obtain ⟨ψ, hψ⟩ := s4 j x₀
      refine ⟨ψ.toRingHom.comp e₀, RingHom.IsIntegral.trans _ _ h6
        (RingHom.isIntegral_of_surjective _ ψ.surjective), ?_⟩
      rw [← hψ, ← h7, CommRingCat.ofHom_comp, Spec.map_comp]
      simp only [Category.assoc]
  have hii : ∀ l, IsAffine (Limits.pullback (W'.obj l).right.hom j) := by
    intro l
    haveI := hAff l
    exact s5 (W'.obj l).right.left (W'.obj l).right.hom (ηh l ≫ (W₀.obj l).right.hom)
      (by rw [Category.assoc, hs1 l])
  have hiii : IsAffine (Limits.pullback (a₀ ≫ j) j) := s5 (Spec (.of B₀)) (a₀ ≫ j) a₀ rfl
  exact ⟨W', φ', hD, hii, hiii⟩

theorem wc_hler_milnor_pullback_iso : ∀ (A : Type u) [CommRing A] (X Xb : Scheme.{u}) (f : X ⟶ Spec (.of A)) (pb : Xb ⟶ Spec (.of A)) (j : X ⟶ Xb) [IsOpenImmersion j], j ≫ pb = f → ∀ (Ω : Type u) [Field Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A)) (Bs : Scheme.{u}) (a₀ : Bs ⟶ X), ∃ θ : Limits.pullback a₀ (Limits.pullback.fst f ξ) ⟶ Limits.pullback (Limits.pullback.fst (a₀ ≫ j) j ≫ (a₀ ≫ j) ≫ pb) ξ, IsIso θ ∧ θ ≫ Limits.pullback.fst (Limits.pullback.fst (a₀ ≫ j) j ≫ (a₀ ≫ j) ≫ pb) ξ ≫ Limits.pullback.snd (a₀ ≫ j) j = Limits.pullback.snd a₀ (Limits.pullback.fst f ξ) ≫ Limits.pullback.fst f ξ ∧ θ ≫ Limits.pullback.snd (Limits.pullback.fst (a₀ ≫ j) j ≫ (a₀ ≫ j) ≫ pb) ξ = Limits.pullback.snd a₀ (Limits.pullback.fst f ξ) ≫ Limits.pullback.snd f ξ :=
by
  intro A _ X Xb f pb j _ hcomm Ω _ ξ Bs a₀


  suffices H : ∀ (g : Bs ⟶ Xb) (_hg : a₀ ≫ j = g) (h : Limits.pullback g j ⟶ Spec (.of A))
      (_hh : Limits.pullback.fst g j ≫ g ≫ pb = h),
      ∃ θ : Limits.pullback a₀ (Limits.pullback.fst f ξ) ⟶ Limits.pullback h ξ, IsIso θ ∧
        θ ≫ Limits.pullback.fst h ξ ≫ Limits.pullback.snd g j =
          Limits.pullback.snd a₀ (Limits.pullback.fst f ξ) ≫ Limits.pullback.fst f ξ ∧
        θ ≫ Limits.pullback.snd h ξ =
          Limits.pullback.snd a₀ (Limits.pullback.fst f ξ) ≫ Limits.pullback.snd f ξ by
    exact H _ rfl _ rfl
  intro g hg h hh
  have hc1 : Limits.pullback.fst g j ≫ g = Limits.pullback.snd g j ≫ j :=
    Limits.pullback.condition
  have hc2 : Limits.pullback.fst h ξ ≫ h = Limits.pullback.snd h ξ ≫ ξ :=
    Limits.pullback.condition
  have hc3 : Limits.pullback.fst f ξ ≫ f = Limits.pullback.snd f ξ ≫ ξ := Limits.pullback.condition
  have hc4 : Limits.pullback.fst a₀ (Limits.pullback.fst f ξ) ≫ a₀ =
      Limits.pullback.snd a₀ (Limits.pullback.fst f ξ) ≫ Limits.pullback.fst f ξ :=
    Limits.pullback.condition

  have k1 : Limits.pullback.fst g j ≫ a₀ = Limits.pullback.snd g j := by
    apply (cancel_mono j).1
    rw [Category.assoc, hg, hc1]

  have k2 : Limits.pullback.snd g j ≫ f = h := by
    rw [← hh, ← hcomm, ← Category.assoc, ← hc1, Category.assoc]

  have wα : Limits.pullback.fst a₀ (Limits.pullback.fst f ξ) ≫ g =
      (Limits.pullback.snd a₀ (Limits.pullback.fst f ξ) ≫ Limits.pullback.fst f ξ) ≫ j := by
    rw [← hg, ← Category.assoc, hc4, Category.assoc]
  let α := Limits.pullback.lift (f := g) (g := j) _ _ wα
  have hα1 : α ≫ Limits.pullback.fst g j = Limits.pullback.fst a₀ (Limits.pullback.fst f ξ) :=
    Limits.pullback.lift_fst _ _ _
  have hα2 : α ≫ Limits.pullback.snd g j =
      Limits.pullback.snd a₀ (Limits.pullback.fst f ξ) ≫ Limits.pullback.fst f ξ :=
    Limits.pullback.lift_snd _ _ _

  have wθ : α ≫ h =
      (Limits.pullback.snd a₀ (Limits.pullback.fst f ξ) ≫ Limits.pullback.snd f ξ) ≫ ξ := by
    rw [← k2, ← Category.assoc, hα2, Category.assoc, hc3, Category.assoc]
  let θ := Limits.pullback.lift (f := h) (g := ξ) _ _ wθ
  have hθ1 : θ ≫ Limits.pullback.fst h ξ = α := Limits.pullback.lift_fst _ _ _
  have hθ2 : θ ≫ Limits.pullback.snd h ξ =
      Limits.pullback.snd a₀ (Limits.pullback.fst f ξ) ≫ Limits.pullback.snd f ξ :=
    Limits.pullback.lift_snd _ _ _

  have wβ : (Limits.pullback.fst h ξ ≫ Limits.pullback.snd g j) ≫ f =
      Limits.pullback.snd h ξ ≫ ξ := by
    rw [Category.assoc, k2, hc2]
  let β := Limits.pullback.lift (f := f) (g := ξ) _ _ wβ
  have hβ1 : β ≫ Limits.pullback.fst f ξ = Limits.pullback.fst h ξ ≫ Limits.pullback.snd g j :=
    Limits.pullback.lift_fst _ _ _
  have hβ2 : β ≫ Limits.pullback.snd f ξ = Limits.pullback.snd h ξ :=
    Limits.pullback.lift_snd _ _ _

  have wψ : (Limits.pullback.fst h ξ ≫ Limits.pullback.fst g j) ≫ a₀ =
      β ≫ Limits.pullback.fst f ξ := by
    rw [Category.assoc, k1, hβ1]
  let ψ := Limits.pullback.lift (f := a₀) (g := Limits.pullback.fst f ξ) _ _ wψ
  have hψ1 : ψ ≫ Limits.pullback.fst a₀ (Limits.pullback.fst f ξ) =
      Limits.pullback.fst h ξ ≫ Limits.pullback.fst g j :=
    Limits.pullback.lift_fst _ _ _
  have hψ2 : ψ ≫ Limits.pullback.snd a₀ (Limits.pullback.fst f ξ) = β :=
    Limits.pullback.lift_snd _ _ _

  have hψα : ψ ≫ α = Limits.pullback.fst h ξ := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hα1, hψ1]
    · rw [Category.assoc, hα2, ← Category.assoc, hψ2, hβ1]
  have hθβ : θ ≫ β = Limits.pullback.snd a₀ (Limits.pullback.fst f ξ) := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hβ1, ← Category.assoc, hθ1, hα2]
    · rw [Category.assoc, hβ2, hθ2]
  have e1 : ψ ≫ θ = 𝟙 _ := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hθ1, Category.id_comp, hψα]
    · rw [Category.assoc, hθ2, Category.id_comp, ← Category.assoc, hψ2, hβ2]
  have e2 : θ ≫ ψ = 𝟙 _ := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hψ1, Category.id_comp, ← Category.assoc, hθ1, hα1]
    · rw [Category.assoc, hψ2, Category.id_comp, hθβ]

