    have e2 : ρ ((D.f.stalkMap _).hom τ') - ∑ a, ∑ c, (M.map ρ) a c * ρ (t a) * ρ (t c) =
        ρ ((D.f.stalkMap _).hom τ' - ∑ a, ∑ c, M a c * t a * t c) := by
      simp only [map_sub, map_sum, map_mul, Matrix.map_apply]
    rw [e2, ← hmapm, ← Ideal.map_pow]
    exact Ideal.mem_map_of_mem ρ hcub
  have hdet' : IsUnit (M.map ρ + (M.map ρ).transpose).det := by
    have e3 : M.map ρ + (M.map ρ).transpose = (M + M.transpose).map ρ := by
      ext a c
      simp [Matrix.map_apply, Matrix.transpose_apply]
    rw [e3, ← RingHom.mapMatrix_apply, ← RingHom.map_det]
    exact hdet.map ρ
  refine ⟨hZc, hZs, T.left, r ≫ ε.hom, hfP, xb, T.hom ⁻¹ᵁ wcCritPunctOpen D i, hcl, hOset, hsmO,
    ⟨φ⟩, (Limits.pullback D.Yt.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))).presheaf.stalk (j xb),
    inferInstance, inferInstance, inferInstance, fun a => ρ (t a),
    ρ ((D.f.stalkMap _).hom τ'), M.map ρ, ?_, hmax, hcub', hdet',
    ⟨(RingHom.quotientKerEquivOfSurjective hsurj).symm.trans (Ideal.quotEquivOfEq hker)⟩⟩
  exact_mod_cast hdim

theorem wc_et_smooth_divisor_complement_coh_finite_gen : ∀ (K : Type u) [Field K] [IsAlgClosed K]
    (Yb E : Scheme.{u}) (fY : Yb ⟶ Spec (.of K)) [IsProper fY] (N : ℕ)
    [SmoothOfRelativeDimension N fY] (iE : E ⟶ Yb) [IsClosedImmersion iE]
    [SmoothOfRelativeDimension (N - 1) (iE ≫ fY)] (U : Yb.Opens),
    (U : Set Yb) = (Set.range iE)ᶜ → ∀ (m : ℕ), (m : K) ≠ 0 → ∀ q : ℕ, Finite (wcEtCoh U m q) :=
by
  intro K _ _ Yb E fY _ N _ iE _ _ U hU m hm q
  classical

  have c1 : ∀ (X : Type u) [TopologicalSpace X] [TopologicalSpace.NoetherianSpace X],
      (∀ x : X, IsOpen (connectedComponent x)) ∧ Finite (_root_.ConnectedComponents X) := by
    intro X _ _
    constructor
    · intro x
      have hT : {Z | Z ∈ irreducibleComponents X ∧ Disjoint Z (connectedComponent x)}.Finite :=
        (TopologicalSpace.NoetherianSpace.finite_irreducibleComponents).subset (fun Z hZ => hZ.1)
      have hcl : IsClosed
          (⋃₀ {Z | Z ∈ irreducibleComponents X ∧ Disjoint Z (connectedComponent x)}) :=
        hT.isClosed_sUnion (fun Z hZ => isClosed_of_mem_irreducibleComponents Z hZ.1)
      have heq : (connectedComponent x)ᶜ =
          ⋃₀ {Z | Z ∈ irreducibleComponents X ∧ Disjoint Z (connectedComponent x)} := by
        ext y
        rw [Set.mem_sUnion]
        constructor
        · intro hy
          refine ⟨irreducibleComponent y,
            ⟨irreducibleComponent_mem_irreducibleComponents y, ?_⟩, mem_irreducibleComponent⟩
          have hne : connectedComponent y ≠ connectedComponent x := by
            intro h
            apply hy
            rw [← h]
            exact mem_connectedComponent
          exact (connectedComponent_disjoint hne).mono_left
            irreducibleComponent_subset_connectedComponent
        · rintro ⟨Z, ⟨_, hZd⟩, hyZ⟩ hyC
          exact Set.disjoint_left.mp hZd hyZ hyC
      rw [← isClosed_compl_iff, heq]
      exact hcl
    · haveI := (TopologicalSpace.NoetherianSpace.finite_irreducibleComponents (α := X)).to_subtype
      let rr : _root_.ConnectedComponents X → X := fun c => (_root_.ConnectedComponents.surjective_coe c).choose
      have hrr : ∀ c, ((rr c : X) : _root_.ConnectedComponents X) = c :=
        fun c => (_root_.ConnectedComponents.surjective_coe c).choose_spec
      let g : _root_.ConnectedComponents X → irreducibleComponents X :=
        fun c => ⟨irreducibleComponent (rr c), irreducibleComponent_mem_irreducibleComponents _⟩
      refine Finite.of_injective g ?_
      intro c c' hcc
      have h1 : irreducibleComponent (rr c) = irreducibleComponent (rr c') :=
        congrArg Subtype.val hcc
      have h2 : rr c ∈ connectedComponent (rr c') := by
        apply irreducibleComponent_subset_connectedComponent
        rw [← h1]
        exact mem_irreducibleComponent
      calc c = ((rr c : X) : _root_.ConnectedComponents X) := (hrr c).symm
        _ = ((rr c' : X) : _root_.ConnectedComponents X) := _root_.ConnectedComponents.coe_eq_coe'.mpr h2
        _ = c' := hrr c'

  have c2 : ∀ (Y : Scheme.{u}) [TopologicalSpace.NoetherianSpace Y] (m : ℕ), m ≠ 0 →
      Finite (wcEtCoh Y m 0) := by
    intro Y _ m hm
    haveI : NeZero m := ⟨hm⟩
    let T₀ : Y.Etale := Scheme.Etale.mk (𝟙 Y)
    have hT : Limits.IsTerminal T₀ :=
      Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
        (fun V m => MorphismProperty.Over.Hom.ext
          ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
    obtain ⟨ε, -, -⟩ := wc_et_const_hom_sections_equiv Y T₀ hT
    obtain ⟨e, -⟩ := wc_et_const_zmod_sections_locallyConstant Y m
      (fun V S hS x hx => wc_et_locallyConstant_glue Y V S hS m x hx)
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    let E₁ : wcEtCoh Y m 0 ≃ ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶
        (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) :=
      (Abelian.Ext.addEquiv₀).toEquiv
    let Eq0 := E₁.trans ((ε _).trans (e T₀).toEquiv)
    obtain ⟨_, hfin⟩ := c1 Y
    let rr : _root_.ConnectedComponents Y → Y := fun c => (_root_.ConnectedComponents.surjective_coe c).choose
    have hrr : ∀ c, ((rr c : Y) : _root_.ConnectedComponents Y) = c :=
      fun c => (_root_.ConnectedComponents.surjective_coe c).choose_spec
    let Φ : wcEtCoh Y m 0 → (_root_.ConnectedComponents Y → ZMod m) :=
      fun x c => (Eq0 x : LocallyConstant Y (ZMod m)) (rr c)
    have hΦ : Function.Injective Φ := by
      intro a b hab
      apply Eq0.injective
      apply LocallyConstant.ext
      refine fun (y : Y) => ?_
      have hy : y ∈ connectedComponent (rr (_root_.ConnectedComponents.mk y)) := by
        rw [← _root_.ConnectedComponents.coe_eq_coe', hrr]
      have h1 := LocallyConstant.apply_eq_of_isPreconnected (Eq0 a : LocallyConstant Y (ZMod m))
        isPreconnected_connectedComponent hy mem_connectedComponent
      have h2 := LocallyConstant.apply_eq_of_isPreconnected (Eq0 b : LocallyConstant Y (ZMod m))
        isPreconnected_connectedComponent hy mem_connectedComponent
      exact h1.trans ((congrFun hab _).trans h2.symm)
    exact Finite.of_injective Φ hΦ

  have c3 : ∀ (Y : Scheme.{u}) (m : ℕ) {ι : Type u} (s : Finset ι) (W : ι → Y.Opens),
      (∀ i ∈ s, ∀ j ∈ s, i ≠ j → W i ⊔ W j = ⊤) →
      (∀ q : ℕ, Finite (wcEtCoh ((⊤ : Y.Opens) : Scheme.{u}) m q)) →
      (∀ i ∈ s, ∀ q : ℕ, Finite (wcEtCoh (W i : Scheme.{u}) m q)) →
      ∀ q : ℕ, Finite (wcEtCoh ((s.inf W : Y.Opens) : Scheme.{u}) m q) := by
    intro Y m ι s W
    induction s using Finset.induction_on with
    | empty =>
      intro _ htop _ q
      rw [Finset.inf_empty]
      exact htop q
    | insert a s ha ih =>
      intro hpair htop hW q
      rw [Finset.inf_insert]
      have hcov : W a ⊔ s.inf W = ⊤ := by
        rw [Finset.inf_sup_distrib_left, Finset.inf_eq_top_iff]
        intro i hi
        exact hpair a (Finset.mem_insert_self a s) i (Finset.mem_insert_of_mem hi)
          (fun h => ha (by rw [h]; exact hi))
      have ih' := ih (fun i hi j hj hij => hpair i (Finset.mem_insert_of_mem hi) j
        (Finset.mem_insert_of_mem hj) hij) htop (fun i hi => hW i (Finset.mem_insert_of_mem hi))
      exact (wc_et_zariski_mv_card_le_rev Y ⊤ (W a) (s.inf W) hcov m q
        (hW a (Finset.mem_insert_self a s) q) (ih' q) (htop (q + 1))).1

  have c5 : ∀ (Y : Scheme.{u}) [TopologicalSpace.NoetherianSpace Y] (A B : Y.Opens) (m : ℕ),
      m ≠ 0 → A ⊓ B = ⊥ →
      (∀ q : ℕ, Finite (wcEtCoh (A : Scheme.{u}) m q)) →
      (∀ q : ℕ, Finite (wcEtCoh (B : Scheme.{u}) m q)) →
      ∀ q : ℕ, Finite (wcEtCoh ((A ⊔ B : Y.Opens) : Scheme.{u}) m q) := by
    intro Y _ A B m hm hAB hA hB q
    cases q with
    | zero =>
      haveI : TopologicalSpace.NoetherianSpace ((A ⊔ B : Y.Opens) : Scheme.{u}) :=
        (A ⊔ B).ι.isOpenEmbedding.toIsEmbedding.toIsInducing.noetherianSpace
      exact c2 _ m hm
    | succ k =>
      have h2 : ((A ⊓ B : Y.Opens) : Set Y) = ∅ := by
        rw [hAB, TopologicalSpace.Opens.coe_bot]
      have hempty : IsEmpty ((A ⊓ B : Y.Opens) : Scheme.{u}) := by
        constructor
        intro x
        have h1 : (A ⊓ B).ι x ∈ Set.range (A ⊓ B).ι := ⟨x, rfl⟩
        rw [Scheme.Opens.range_ι, h2] at h1
        exact h1
      exact (wc_et_zariski_mv_card_le Y (A ⊔ B) A B rfl m k
        (wc_et_coh_empty_finite _ hempty m k) (hA (k + 1)) (hB (k + 1))).1

  haveI : IsLocallyNoetherian Yb := LocallyOfFiniteType.isLocallyNoetherian fY
  haveI : CompactSpace Yb := QuasiCompact.compactSpace_of_compactSpace fY
  haveI : AlgebraicGeometry.IsNoetherian Yb := {}
  haveI hYnoeth : TopologicalSpace.NoetherianSpace Yb := inferInstance

  have c4 : ∀ (D : Scheme.{u}) (iD : D ⟶ Yb) [IsClosedImmersion iD]
      [SmoothOfRelativeDimension (N - 1) (iD ≫ fY)] [ConnectedSpace D] (C : Yb.Opens),
      IsClosed (C : Set Yb) → _root_.IsConnected (C : Set Yb) → Set.range iD ⊆ (C : Set Yb) → 1 ≤ N →
      ∀ (B : Yb.Opens), (B : Set Yb) = (C : Set Yb) ∩ (Set.range iD)ᶜ →
      ∀ (p : ℕ) [Fact (Nat.Prime p)], (p : K) ≠ 0 → ∀ q : ℕ, Finite (wcEtCoh B p q) := by
    intro D iD _ _ _ C hCcl hCconn hsub hN B hB p _ hp q
    haveI : IsClosedImmersion C.ι :=
      IsClosedImmersion.of_isPreimmersion C.ι (by rw [Scheme.Opens.range_ι]; exact hCcl)
    haveI : IsProper (C.ι ≫ fY) := inferInstance
    haveI hsmC : SmoothOfRelativeDimension N (C.ι ≫ fY) := by
      have h := smoothOfRelativeDimension_comp 0 N C.ι fY
      rw [Nat.zero_add] at h
      exact h
    haveI : Smooth (C.ι ≫ fY) := SmoothOfRelativeDimension.smooth N (C.ι ≫ fY)
    haveI hCcs : ConnectedSpace (C : Scheme.{u}) := by
      obtain ⟨x, hx⟩ := hCconn.nonempty
      have hx' : x ∈ Set.range C.ι := by rw [Scheme.Opens.range_ι]; exact hx
      obtain ⟨y, -⟩ := hx'
      have h1 : _root_.IsPreconnected (⇑C.ι '' Set.univ) := by
        rw [Set.image_univ, Scheme.Opens.range_ι]
        exact hCconn.isPreconnected
      have hpre : PreconnectedSpace (C : Scheme.{u}) :=
        ⟨C.ι.isOpenEmbedding.toIsEmbedding.toIsInducing.isPreconnected_image.mp h1⟩
      have hne : Nonempty (C : Scheme.{u}) := ⟨y⟩
      exact @ConnectedSpace.mk _ _ hpre hne
    haveI : IrreducibleSpace (C : Scheme.{u}) :=
      wc_smooth_algclosed_connected_irreducible K (C : Scheme.{u}) (C.ι ≫ fY)
    haveI : Smooth (iD ≫ fY) := SmoothOfRelativeDimension.smooth (N - 1) (iD ≫ fY)
    haveI : IrreducibleSpace D := wc_smooth_algclosed_connected_irreducible K D (iD ≫ fY)
    obtain ⟨ι', hfac⟩ : ∃ ι' : D ⟶ (C : Scheme.{u}), ι' ≫ C.ι = iD :=
      ⟨IsOpenImmersion.lift C.ι iD (by rw [Scheme.Opens.range_ι]; exact hsub),
        IsOpenImmersion.lift_fac _ _ _⟩
    haveI : IsClosedImmersion (ι' ≫ C.ι) := by rw [hfac]; infer_instance
    haveI : IsClosedImmersion ι' := IsClosedImmersion.of_comp_isClosedImmersion ι' C.ι
    haveI : SmoothOfRelativeDimension (N - 1) (ι' ≫ C.ι ≫ fY) := by
      rw [← Category.assoc, hfac]
      infer_instance
    obtain ⟨U', hU'⟩ : ∃ U' : (C : Scheme.{u}).Opens, (U' : Set (C : Scheme.{u})) = (Set.range ι')ᶜ :=
      ⟨⟨(Set.range ι')ᶜ, ι'.isClosedEmbedding.isClosed_range.isOpen_compl⟩, rfl⟩
    have hU'fin : Finite (wcEtCoh U' p q) :=
      wc_et_smooth_divisor_complement_coh_finite K (C : Scheme.{u}) D (C.ι ≫ fY) N ι' hN U' hU'
        p hp q
    have hinj : Function.Injective C.ι := C.ι.isOpenEmbedding.toIsEmbedding.injective
    have hcomp : ∀ x, (U'.ι ≫ C.ι) x = C.ι (U'.ι x) := fun x => rfl
    have hfacx : ∀ d, iD d = C.ι (ι' d) := fun d => by rw [← hfac]; rfl
    have hrange : Set.range (U'.ι ≫ C.ι) = Set.range B.ι := by
      rw [Scheme.Opens.range_ι B, hB]
      ext y
      constructor
      · rintro ⟨x, rfl⟩
        rw [hcomp]
        refine ⟨?_, ?_⟩
        · have : C.ι (U'.ι x) ∈ Set.range C.ι := ⟨_, rfl⟩
          rw [Scheme.Opens.range_ι] at this
          exact this
        · rintro ⟨d, hd⟩
          rw [hfacx] at hd
          have h3 := hinj hd
          have h4 : U'.ι x ∈ Set.range U'.ι := ⟨x, rfl⟩
          rw [Scheme.Opens.range_ι, hU'] at h4
          exact h4 ⟨d, h3⟩
      · rintro ⟨hyC, hyD⟩
        have h5 : y ∈ Set.range C.ι := by rw [Scheme.Opens.range_ι]; exact hyC
        obtain ⟨z, rfl⟩ := h5
        have h6 : z ∈ Set.range U'.ι := by
          rw [Scheme.Opens.range_ι, hU']
          rintro ⟨d, rfl⟩
          exact hyD ⟨d, hfacx d⟩
        obtain ⟨x, rfl⟩ := h6
        exact ⟨x, hcomp x⟩
    obtain ⟨eqv⟩ := wc_et_coh_iso_invariance (IsOpenImmersion.isoOfRangeEq (U'.ι ≫ C.ι) B.ι
      hrange).hom p q
    exact Finite.of_equiv _ eqv.symm

  have c6 : ∀ (D : Scheme.{u}) (iD : D ⟶ Yb) [IsClosedImmersion iD]
      [SmoothOfRelativeDimension (N - 1) (iD ≫ fY)] [ConnectedSpace D], 1 ≤ N →
      ∀ (W : Yb.Opens), (W : Set Yb) = (Set.range iD)ᶜ →
      ∀ (p : ℕ) [Fact (Nat.Prime p)], (p : K) ≠ 0 → ∀ q : ℕ, Finite (wcEtCoh W p q) := by
    intro D iD _ _ _ hN W hW p _ hp q
    obtain ⟨d₀⟩ := (inferInstance : Nonempty D)
    have hCo : IsOpen (connectedComponent (iD d₀)) := (c1 Yb).1 _
    have hCc : IsClosed (connectedComponent (iD d₀)) := isClosed_connectedComponent
    have hsub : Set.range iD ⊆ connectedComponent (iD d₀) :=
      (isPreconnected_range iD.isClosedEmbedding.continuous).subset_connectedComponent ⟨d₀, rfl⟩
    obtain ⟨Cop, hCop⟩ : ∃ Cop : Yb.Opens, (Cop : Set Yb) = connectedComponent (iD d₀) :=
      ⟨⟨_, hCo⟩, rfl⟩
    obtain ⟨A, hA'⟩ : ∃ A : Yb.Opens, (A : Set Yb) = (connectedComponent (iD d₀))ᶜ :=
      ⟨⟨_, hCc.isOpen_compl⟩, rfl⟩
    have hBset : ((Cop ⊓ W : Yb.Opens) : Set Yb) = (Cop : Set Yb) ∩ (Set.range iD)ᶜ := by
      rw [TopologicalSpace.Opens.coe_inf, hW]
    have hB := c4 D iD Cop (by rw [hCop]; exact hCc)
      (by rw [hCop]; exact isConnected_connectedComponent) (by rw [hCop]; exact hsub) hN
      (Cop ⊓ W) hBset p hp
    haveI : IsClosedImmersion A.ι := IsClosedImmersion.of_isPreimmersion A.ι
      (by rw [Scheme.Opens.range_ι, hA']; exact isClosed_compl_iff.mpr hCo)
    have hA : ∀ q, Finite (wcEtCoh (A : Scheme.{u}) p q) :=
      fun q => wc_etale_proper_finite K A (A.ι ≫ fY) p hp q
    have hAB : A ⊓ (Cop ⊓ W) = ⊥ := by
      apply TopologicalSpace.Opens.ext
      rw [TopologicalSpace.Opens.coe_inf, TopologicalSpace.Opens.coe_inf,
        TopologicalSpace.Opens.coe_bot, hA', hCop]
      exact Set.subset_empty_iff.mp (fun y hy => hy.1 hy.2.1)
    have hABW : A ⊔ (Cop ⊓ W) = W := by
      apply TopologicalSpace.Opens.ext
      rw [TopologicalSpace.Opens.coe_sup, TopologicalSpace.Opens.coe_inf, hA', hCop, hW]
      ext y
      constructor
      · rintro (h | ⟨-, h⟩)
        · exact fun hy => h (hsub hy)
        · exact h
      · intro h
        by_cases hy : y ∈ connectedComponent (iD d₀)
        · exact Or.inr ⟨hy, h⟩
        · exact Or.inl hy
    have := c5 Yb A (Cop ⊓ W) p (Fact.out : p.Prime).ne_zero hAB hA hB q
    rw [hABW] at this
    exact this

  have hm0 : m ≠ 0 := by
    rintro rfl
    exact hm Nat.cast_zero
  refine wc_et_coh_coeff_devissage U m hm0 ?_ q
  intro p hp hpm i
  haveI : Fact p.Prime := ⟨hp⟩
  have hpK : (p : K) ≠ 0 := by
    obtain ⟨k, rfl⟩ := hpm
    intro h
    apply hm
    rw [Nat.cast_mul, h, zero_mul]
  rcases Nat.eq_zero_or_pos N with hN0 | hNpos
  ·
    have hopen : IsOpen (Set.range iE) :=
      (wc_smooth_closed_reldim_cases K Yb fY N (N - 1) E iE).2 (by omega)
    haveI : IsClosedImmersion U.ι := IsClosedImmersion.of_isPreimmersion U.ι
      (by rw [Scheme.Opens.range_ι, hU]; exact hopen.isClosed_compl)
    exact wc_etale_proper_finite K U (U.ι ≫ fY) p hpK i
  ·
    haveI : TopologicalSpace.NoetherianSpace E :=
      iE.isClosedEmbedding.toIsEmbedding.toIsInducing.noetherianSpace
    obtain ⟨hEopen, hEfin⟩ := c1 E
    letI : Fintype (_root_.ConnectedComponents E) := Fintype.ofFinite _
    let r : _root_.ConnectedComponents E → E := fun c => (_root_.ConnectedComponents.surjective_coe c).choose
    have hr : ∀ c, ((r c : E) : _root_.ConnectedComponents E) = c :=
      fun c => (_root_.ConnectedComponents.surjective_coe c).choose_spec
    have hμ : ∀ (c : _root_.ConnectedComponents E) (e : E),
        e ∈ connectedComponent (r c) ↔ (e : _root_.ConnectedComponents E) = c := by
      intro c e
      rw [← _root_.ConnectedComponents.coe_eq_coe', hr]
    obtain ⟨Dc, hDc⟩ : ∃ Dc : _root_.ConnectedComponents E → E.Opens,
        ∀ c, (Dc c : Set E) = connectedComponent (r c) :=
      ⟨fun c => ⟨_, hEopen (r c)⟩, fun c => rfl⟩
    have hDci : ∀ c, IsClosedImmersion (Dc c).ι := fun c =>
      IsClosedImmersion.of_isPreimmersion _
        (by rw [Scheme.Opens.range_ι, hDc]; exact isClosed_connectedComponent)
    have hDconn : ∀ c, ConnectedSpace (Dc c : Scheme.{u}) := by
      intro c
      have hx : r c ∈ Set.range (Dc c).ι := by
        rw [Scheme.Opens.range_ι, hDc]; exact mem_connectedComponent
      obtain ⟨y, -⟩ := hx
      have h1 : _root_.IsPreconnected (⇑(Dc c).ι '' Set.univ) := by
        rw [Set.image_univ, Scheme.Opens.range_ι, hDc]
        exact isPreconnected_connectedComponent
      have hpre : PreconnectedSpace (Dc c : Scheme.{u}) :=
        ⟨(Dc c).ι.isOpenEmbedding.toIsEmbedding.toIsInducing.isPreconnected_image.mp h1⟩
      have hne : Nonempty (Dc c : Scheme.{u}) := ⟨y⟩
      exact @ConnectedSpace.mk _ _ hpre hne

    have hDsm : ∀ c, SmoothOfRelativeDimension (N - 1) (((Dc c).ι ≫ iE) ≫ fY) := by
      intro c
      have h := smoothOfRelativeDimension_comp 0 (N - 1) (Dc c).ι (iE ≫ fY)
      rw [Nat.zero_add] at h
      rw [Category.assoc]
      exact h
    have hDcl : ∀ c, IsClosedImmersion ((Dc c).ι ≫ iE) := fun c => by
      haveI := hDci c
      infer_instance
    obtain ⟨W, hW⟩ : ∃ W : _root_.ConnectedComponents E → Yb.Opens,
        ∀ c, (W c : Set Yb) = (Set.range ((Dc c).ι ≫ iE))ᶜ :=
      ⟨fun c => ⟨_, (haveI := hDcl c; ((Dc c).ι ≫ iE).isClosedEmbedding.isClosed_range.isOpen_compl)⟩,
        fun c => rfl⟩
    have hWfin : ∀ c q, Finite (wcEtCoh (W c : Scheme.{u}) p q) := by
      intro c q
      haveI := hDcl c
      haveI := hDsm c
      haveI := hDconn c
      exact c6 (Dc c) ((Dc c).ι ≫ iE) hNpos (W c) (hW c) p hpK q

    have hrng : ∀ c (y : Yb), y ∈ Set.range ((Dc c).ι ≫ iE) ↔
        ∃ e : E, (e : _root_.ConnectedComponents E) = c ∧ iE e = y := by
      intro c y
      constructor
      · rintro ⟨x, rfl⟩
        refine ⟨(Dc c).ι x, ?_, rfl⟩
        have : (Dc c).ι x ∈ Set.range (Dc c).ι := ⟨x, rfl⟩
        rw [Scheme.Opens.range_ι, hDc] at this
        exact (hμ c _).mp this
      · rintro ⟨e, he, rfl⟩
        have : e ∈ Set.range (Dc c).ι := by
          rw [Scheme.Opens.range_ι, hDc]; exact (hμ c e).mpr he
        obtain ⟨x, hx⟩ := this
        exact ⟨x, by rw [← hx]; rfl⟩
    have hpair : ∀ c ∈ (Finset.univ : Finset (_root_.ConnectedComponents E)),
        ∀ c' ∈ (Finset.univ : Finset (_root_.ConnectedComponents E)), c ≠ c' → W c ⊔ W c' = ⊤ := by
      intro c _ c' _ hcc
      apply TopologicalSpace.Opens.ext
      rw [TopologicalSpace.Opens.coe_sup, TopologicalSpace.Opens.coe_top, hW c, hW c']
      apply Set.eq_univ_of_forall
      intro y
      by_contra hy
      simp only [Set.mem_union, not_or] at hy
      obtain ⟨h1, h2⟩ := hy
      have h1' : y ∈ Set.range ((Dc c).ι ≫ iE) := by
        by_contra h
        exact h1 h
      have h2' : y ∈ Set.range ((Dc c').ι ≫ iE) := by
        by_contra h
        exact h2 h
      obtain ⟨e, he, rfl⟩ := (hrng c y).mp h1'
      obtain ⟨e', he', hee⟩ := (hrng c' _).mp h2'
      have h3 : e' = e := iE.isClosedEmbedding.toIsEmbedding.injective hee
      apply hcc
      rw [← he, ← he', h3]
    have hkey : ∀ y : Yb, y ∈ ((Finset.univ.inf W : Yb.Opens) : Set Yb) ↔
        ∀ c, y ∈ (W c : Set Yb) := by
      intro y
      rw [TopologicalSpace.Opens.coe_finset_inf]
      first
        | (simp [Finset.inf_eq_iInf]; done)
        | (rw [Finset.inf_eq_iInf]; simp only [Set.iInf_eq_iInter, Set.mem_iInter, Finset.mem_univ,
            Function.comp_apply, forall_const]; done)
        | (induction (Finset.univ : Finset (_root_.ConnectedComponents E)) using Finset.induction_on
            <;> simp_all)
    have hUeq : U = Finset.univ.inf W := by
      apply TopologicalSpace.Opens.ext
      ext y
      rw [hkey, hU]
      constructor
      · intro hy c
        rw [hW c]
        intro hyc
        obtain ⟨e, -, rfl⟩ := (hrng c y).mp hyc
        exact hy ⟨e, rfl⟩
      · rintro hy ⟨e, rfl⟩
        have h4 := hy (_root_.ConnectedComponents.mk e)
        rw [hW] at h4
        exact h4 ((hrng _ _).mpr ⟨e, rfl, rfl⟩)

    have htop : ∀ q, Finite (wcEtCoh ((⊤ : Yb.Opens) : Scheme.{u}) p q) := by
      intro q
      obtain ⟨eqv⟩ := wc_et_coh_iso_invariance (Scheme.topIso Yb).hom p q
      haveI := wc_etale_proper_finite K Yb fY p hpK q
      first
        | exact Finite.of_equiv _ eqv
        | exact Finite.of_equiv _ eqv.symm

    rw [hUeq]
    exact c3 Yb p Finset.univ W hpair htop (fun c _ q => hWfin c q) i

theorem wc_crit_punct_fibre_zmod_finite (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'') (i : Fin D.m)
    (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom (D.S i) ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom (D.S i)) (j k : ℕ) :
    Finite (Abelian.Ext (wcFreeSheaf (Limits.pullback D.f (D.S i))
        ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
          (wcOpenRestr D.Yt.left ⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ,
            isOpen_compl_iff.mpr isClosed_closure⟩ ((wcProEtPullback D.f).obj V₀))))
      (wcContSheaf (Limits.pullback D.f (D.S i)) (ZMod (ℓ ^ k))) j) :=
by
  classical

  obtain ⟨hZc, hZs, P, fP, hP, xb, O, hxb, hO, hsm, ⟨φ⟩, R, iR, iRl, iRn, t, h, M, hdim, hmax,
    hq, hdet, ⟨σ⟩⟩ := wc_crit_punct_fibre_open_model F' F'' Y n D i V₀ A e ε hv hε

  obtain ⟨Yb, E, fY, hfY, hsY, iE, hiE, hsE, U, hU, ⟨ψ⟩⟩ :=
    @wc_odp_isolated_resolution (AlgebraicClosure F'') _ _ P fP hP n xb O hxb hO hsm R iR iRl iRn
      t h M hdim hmax hq hdet ⟨σ⟩

  have hmF : ((ℓ ^ k : ℕ) : F'') ≠ 0 := by
    intro h0
    haveI := Fintype.ofFinite F''
    obtain ⟨p, hp⟩ := CharP.exists F''
    haveI := hp
    have hpp : p.Prime := CharP.char_is_prime F'' p
    have h1 : p ∣ ℓ ^ k := (CharP.cast_eq_zero_iff F'' p _).mp h0
    have h2 : p ∣ ℓ := hpp.dvd_of_dvd_pow h1
    have h3 : p = ℓ := (Nat.prime_dvd_prime_iff_eq hpp Fact.out).mp h2
    have h4 : p ∣ Fintype.card F'' :=
      (CharP.cast_eq_zero_iff F'' p _).mp (FiniteField.cast_card_eq_zero F'')
    apply hℓ
    rw [← h3, Nat.card_eq_fintype_card]
    exact h4
  have hmFb : ((ℓ ^ k : ℕ) : AlgebraicClosure F'') ≠ 0 := by
    intro h0
    apply hmF
    apply (algebraMap F'' (AlgebraicClosure F'')).injective
    rw [map_natCast, map_zero]
    exact h0

  haveI hUfin : Finite (wcEtCoh U (ℓ ^ k) j) :=
    @wc_et_smooth_divisor_complement_coh_finite_gen (AlgebraicClosure F'') _ _ Yb E fY hfY (n - 1)
      hsY iE hiE hsE U hU (ℓ ^ k) hmFb j

  obtain ⟨E3⟩ := wc_et_coh_iso_invariance (φ ≪≫ ψ).hom (ℓ ^ k) j
  haveI hZfin : Finite (wcEtCoh ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
      (wcOpenRestr D.Yt.left ⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ,
        isOpen_compl_iff.mpr isClosed_closure⟩ ((wcProEtPullback D.f).obj V₀))).left (ℓ ^ k) j) :=
    Finite.of_equiv _ E3

  haveI := hZc
  haveI := hZs
  haveI := wc_proet_zmod_coh_finite_qcsep _ (ℓ ^ k) j hZfin

  obtain ⟨E2⟩ := wc_ext_free_slice_cont (Limits.pullback D.f (D.S i))
    ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
      (wcOpenRestr D.Yt.left ⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ,
        isOpen_compl_iff.mpr isClosed_closure⟩ ((wcProEtPullback D.f).obj V₀)))
    (ZMod (ℓ ^ k)) j
  exact Finite.of_equiv _ E2.symm

theorem wc_proet_free_zmod_ext_et_model (n j : ℕ) (hn : 0 < n) :
    ∃ Ψ : ∀ (S : Scheme.{u}) (U : S.ProEt),
        wcEtZModExt U.left n j →+ Abelian.Ext (wcFreeSheaf S U) (wcContSheaf S (ZMod n)) j,
      (∀ (S : Scheme.{u}) (U : S.ProEt), CompactSpace U.left → QuasiSeparatedSpace U.left →
        Function.Bijective (Ψ S U)) ∧
      (∀ (S : Scheme.{u}) {U V : S.ProEt} (a : V ⟶ U) (D : wcEtPullData a.left n)
        (x : wcEtZModExt U.left n j),
        (Abelian.Ext.mk₀ (wcFreeSheafMap S a)).comp (Ψ S U x) (zero_add j) =
          Ψ S V (wcEtPull D j x)) ∧
      (∀ {Y' X' : Scheme.{u}} (ι : X' ⟶ Y')
        (L : Sheaf (Scheme.ProEt.topology Y') AddCommGrpCat.{u+1} ⥤
          Sheaf (Scheme.ProEt.topology X') AddCommGrpCat.{u+1})
        [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L]
        (adj : L ⊣ wcProEtPush ι)
        (θ : ∀ V : Y'.ProEt, L.obj (wcFreeSheaf Y' V) ≅ wcFreeSheaf X' ((wcProEtPullback ι).obj V))
        (hθ : ∀ {V V' : Y'.ProEt} (a : V ⟶ V'),
          L.map (wcFreeSheafMap Y' a) ≫ (θ V').hom =
            (θ V).hom ≫ wcFreeSheafMap X' ((wcProEtPullback ι).map a))
        (U : Y'.ProEt) (D : wcEtPullData (Limits.pullback.fst U.hom ι) n)
        (x : wcEtZModExt U.left n j),
        wcEtPull D j x = 0 → wcProEtRes ι L adj θ (ZMod n) U j (Ψ Y' U x) = 0) :=
by
  obtain ⟨Θ, hΘbij, hΘnat⟩ := wc_zmod_et_proet_natural_comparison n hn j
  obtain ⟨Φ, hΦbij, hΦnat, hΦres⟩ := wc_proet_free_zmod_ext_mod_model n j hn
  refine ⟨fun S U => (Φ S U).comp (Θ U.left), ?_, ?_, ?_⟩
  · intro S U hc hq
    exact (hΦbij S U).comp (hΘbij U.left hc hq)
  · intro S U V a D x
    obtain ⟨D', hD'⟩ := wc_zmod_pull_data_exists a.left n
    show (Abelian.Ext.mk₀ (wcFreeSheafMap S a)).comp (Φ S U (Θ U.left x)) (zero_add j) =
      Φ S V (Θ V.left (wcEtPull D j x))
    rw [hΦnat S a D' hD' (Θ U.left x), hΘnat a.left D' hD' D x]
  · intro Y' X' ι L _ _ _ adj θ hθ U D x hx
    obtain ⟨D', hD'⟩ := wc_zmod_pull_data_exists (Limits.pullback.fst U.hom ι) n
    have h1 := hΘnat (Limits.pullback.fst U.hom ι) D' hD' D x
    rw [hx, map_zero] at h1
    have h0 : wcZModPull D' j (Θ U.left x) = 0 := h1
    exact hΦres ι L adj θ hθ U D' hD' (Θ U.left x) h0

theorem wc_ext_exact_pull_vanish_of_unit_resolution : ∀ {C : Type*} {D : Type*} {E : Type*} [Category C] [Category D] [Category E] [Abelian C] [Abelian D] [Abelian E] (L : D ⥤ C) (R : C ⥤ D) [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L] [R.Additive] (adj : L ⊣ R) (S : D ⥤ E) [S.Additive] [Limits.PreservesFiniteLimits S] [Limits.PreservesFiniteColimits S] (A : D) (B : C) (μ : L.obj A ≅ B) (I : InjectiveResolution B), letI := HasExt.standard C; letI := HasExt.standard D; letI := HasExt.standard E; IsIso (S.map (adj.unit.app A ≫ R.map μ.hom)) → (∀ q : ℕ, 1 ≤ q → Limits.IsZero (S.obj (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q))) → ∀ (k : ℕ) (x : Abelian.Ext A A k), ((Abelian.Ext.mk₀ μ.inv).precomp _ (zero_add k)).comp (((Abelian.Ext.mk₀ μ.hom).postcomp _ (add_zero k)).comp (L.mapExtAddHom A A k)) x = 0 → S.mapExtAddHom A A k x = 0 :=
by
  intro C D E _ _ _ _ _ _ L R _ _ _ _ adj S _ _ _ A B μ I H1 H2 k x hx
  letI instC : HasExt C := HasExt.standard C
  letI instD : HasExt D := HasExt.standard D
  letI instE : HasExt E := HasExt.standard E
  haveI := adj.rightAdjoint_preservesLimits
  haveI : L.PreservesMonomorphisms := inferInstance

  have c2 : ∀ n : ℕ, Nonempty (Limits.cokernel (R.map (Limits.kernel.lift
      (I.cocomplex.d (n + 1) (n + 2)) (I.cocomplex.d n (n + 1))
      (I.cocomplex.d_comp_d n (n + 1) (n + 2)))) ≅
      ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology (n + 1)) := by
    intro n
    let ψ₁ : R.obj (Limits.kernel (I.cocomplex.d (n + 1) (n + 2))) ≅
        Limits.kernel (R.map (I.cocomplex.d (n + 1) (n + 2))) :=
      Limits.PreservesKernel.iso R _
    have hψ₁ : ψ₁.hom ≫ Limits.kernel.ι (R.map (I.cocomplex.d (n + 1) (n + 2))) =
        R.map (Limits.kernel.ι (I.cocomplex.d (n + 1) (n + 2))) := by
      simp only [ψ₁, Limits.PreservesKernel.iso_hom, Limits.kernelComparison_comp_ι]
    let ψ₂ :=
      Limits.IsLimit.conePointUniqueUpToIso
        (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).cyclesIsKernel
          (n + 1) (n + 2) (by simp))
        (Limits.kernelIsKernel (R.map (I.cocomplex.d (n + 1) (n + 2))))
    have hψ₂ : ψ₂.inv ≫ ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).iCycles
        (n + 1) = Limits.kernel.ι (R.map (I.cocomplex.d (n + 1) (n + 2))) :=
      Limits.IsLimit.conePointUniqueUpToIso_inv_comp
        (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).cyclesIsKernel
          (n + 1) (n + 2) (by simp))
        (Limits.kernelIsKernel (R.map (I.cocomplex.d (n + 1) (n + 2))))
        Limits.WalkingParallelPair.zero
    have hφ : (ψ₁ ≪≫ ψ₂.symm).hom ≫
        ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).iCycles (n + 1) =
        R.map (Limits.kernel.ι (I.cocomplex.d (n + 1) (n + 2))) := by
      rw [Iso.trans_hom, Iso.symm_hom, Category.assoc, hψ₂, hψ₁]
    have claim : R.map (Limits.kernel.lift (I.cocomplex.d (n + 1) (n + 2)) (I.cocomplex.d n (n + 1))
        (I.cocomplex.d_comp_d n (n + 1) (n + 2))) ≫ (ψ₁ ≪≫ ψ₂.symm).hom =
        ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).toCycles n (n + 1) := by
      rw [← cancel_mono (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).iCycles
        (n + 1)), Category.assoc, hφ, ← R.map_comp, Limits.kernel.lift_ι,
        HomologicalComplex.toCycles_i]
      all_goals rfl
    exact ⟨(Limits.cokernelCompIsIso _ (ψ₁ ≪≫ ψ₂.symm).hom).symm ≪≫ Limits.cokernelIsoOfEq claim ≪≫
      Limits.IsColimit.coconePointUniqueUpToIso (Limits.cokernelIsCokernel _)
        (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homologyIsCokernel
          n (n + 1) (by simp))⟩

  have c3 : ∀ {T : ShortComplex D} (hT : T.ShortExact) {T' : ShortComplex C} (hT' : T'.ShortExact)
      (φ : T.map L ⟶ T') {X : D} (m : ℕ) (z : Abelian.Ext X T.X₃ m),
      (Abelian.Ext.mapExactFunctor L (z.comp hT.extClass rfl)).comp (Abelian.Ext.mk₀ φ.τ₁)
        (add_zero (m + 1)) =
      ((Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ φ.τ₃) (add_zero m)).comp
        hT'.extClass rfl := by
    intro T hT T' hT' φ X m z
    have h₁ : (T.map L).ShortExact := hT.map_of_exact L
    have hnat : h₁.extClass.comp (Abelian.Ext.mk₀ φ.τ₁) (add_zero 1) =
        (Abelian.Ext.mk₀ φ.τ₃).comp hT'.extClass (zero_add 1) :=
      h₁.extClass_naturality hT' φ
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass,
      Abelian.Ext.comp_assoc _ _ _ rfl (add_zero 1) (by omega),
      Abelian.Ext.comp_assoc _ _ _ (add_zero m) (zero_add 1) (by omega), hnat]

  let τ : ∀ (Y : C) (m : ℕ), Abelian.Ext A (R.obj Y) m →+ Abelian.Ext (L.obj A) Y m :=
    fun Y m => AddMonoidHom.mk'
      (fun α => (Abelian.Ext.mapExactFunctor L α).comp (Abelian.Ext.mk₀ (adj.counit.app Y))
        (add_zero m))
      (fun a b => by rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.add_comp])
  have hτ : ∀ (Y : C) (m : ℕ) (α : Abelian.Ext A (R.obj Y) m),
      τ Y m α = (Abelian.Ext.mapExactFunctor L α).comp (Abelian.Ext.mk₀ (adj.counit.app Y))
        (add_zero m) := fun _ _ _ => rfl

  have s1a : ∀ {Y Y' : C} (g : Y ⟶ Y') (m : ℕ) (v : Abelian.Ext A (R.obj Y) m),
      τ Y' m (v.comp (Abelian.Ext.mk₀ (R.map g)) (add_zero m)) =
        (τ Y m v).comp (Abelian.Ext.mk₀ g) (add_zero m) := by
    intro Y Y' g m v
    have e1 : L.map (R.map g) ≫ adj.counit.app Y' = adj.counit.app Y ≫ g :=
      adj.counit_naturality g
    rw [hτ, hτ, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc _ _ _ (add_zero m) (zero_add 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, e1,
      Abelian.Ext.comp_assoc _ _ _ (add_zero m) (zero_add 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀]

  have base : ∀ Y : C, Function.Bijective (τ Y 0) := by
    intro Y
    have e : ⇑(τ Y 0) = fun x =>
        Abelian.Ext.mk₀ ((adj.homEquiv A Y).symm (Abelian.Ext.homEquiv₀ x)) := by
      funext x
      conv_lhs => rw [← Abelian.Ext.mk₀_homEquiv₀_apply x]
      rw [hτ, Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀,
        Adjunction.homEquiv_counit]
    rw [e]
    exact (Abelian.Ext.mk₀_bijective _ _).comp
      ((adj.homEquiv A Y).symm.bijective.comp Abelian.Ext.homEquiv₀.bijective)

  have postE : ∀ {X Y Y' : E} (ψ : Y ≅ Y') (n : ℕ),
      Function.Bijective (fun x : Abelian.Ext X Y n => x.comp (Abelian.Ext.mk₀ ψ.hom) (add_zero n)) := by
    intro X Y Y' ψ n
    rw [Function.bijective_iff_has_inverse]
    refine ⟨fun x => x.comp (Abelian.Ext.mk₀ ψ.inv) (add_zero n), fun x => ?_, fun x => ?_⟩
    · dsimp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero n) (zero_add 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    · dsimp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero n) (zero_add 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
  have preC : ∀ {X X' Y : C} (φ : X' ≅ X) (n : ℕ),
      Function.Bijective (fun x : Abelian.Ext X Y n => (Abelian.Ext.mk₀ φ.hom).comp x (zero_add n)) := by
    intro X X' Y φ n
    rw [Function.bijective_iff_has_inverse]
    refine ⟨fun x => (Abelian.Ext.mk₀ φ.inv).comp x (zero_add n), fun x => ?_, fun x => ?_⟩
    · dsimp only
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add n) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
    · dsimp only
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add n) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
  have σsub : ∀ {X Y : D} {m : ℕ} (a b : Abelian.Ext X Y m),
      Abelian.Ext.mapExactFunctor S (a - b) =
        Abelian.Ext.mapExactFunctor S a - Abelian.Ext.mapExactFunctor S b := by
    intro X Y m a b
    rw [eq_sub_iff_add_eq, ← Abelian.Ext.mapExactFunctor_add, sub_add_cancel]

  obtain ⟨Y, f, g, w, hS, hRSex, hRf, hZ, ⟨e⟩⟩ : ∃ (Y : ℕ → C) (f : ∀ n, Y n ⟶ I.cocomplex.X n)
      (g : ∀ n, I.cocomplex.X n ⟶ Y (n + 1)) (w : ∀ n, f n ≫ g n = 0),
      (∀ n, (ShortComplex.mk (f n) (g n) (w n)).ShortExact) ∧
      (∀ n, ((ShortComplex.mk (f n) (g n) (w n)).map R).Exact) ∧
      (∀ n, Mono (R.map (f n))) ∧
      (∀ n, Limits.IsZero (S.obj (Limits.cokernel (R.map (g n))))) ∧
      Nonempty (B ≅ Y 0) := by
    have hw : ∀ n, Limits.kernel.ι (I.cocomplex.d n (n + 1)) ≫
        Limits.kernel.lift (I.cocomplex.d (n + 1) (n + 2)) (I.cocomplex.d n (n + 1))
          (I.cocomplex.d_comp_d n (n + 1) (n + 2)) = 0 := by
      intro n
      rw [← cancel_mono (Limits.kernel.ι (I.cocomplex.d (n + 1) (n + 2))), Category.assoc,
        Limits.kernel.lift_ι, Limits.zero_comp]
      exact Limits.kernel.condition _
    have hSE : ∀ n, (ShortComplex.mk (Limits.kernel.ι (I.cocomplex.d n (n + 1)))
        (Limits.kernel.lift (I.cocomplex.d (n + 1) (n + 2)) (I.cocomplex.d n (n + 1))
          (I.cocomplex.d_comp_d n (n + 1) (n + 2))) (hw n)).ShortExact := by
      intro n
      have hex : (I.cocomplex.sc' n (n + 1) (n + 2)).Exact :=
        (I.cocomplex.exactAt_iff' n (n + 1) (n + 2) (by simp) (by simp)).1
          (I.cocomplex_exactAt_succ n)
      rw [ShortComplex.exact_iff_epi_kernel_lift] at hex
      have hlim : Limits.IsLimit (Limits.KernelFork.ofι
          (Limits.kernel.ι (I.cocomplex.d n (n + 1))) (hw n)) :=
        Limits.KernelFork.IsLimit.ofι _ _
          (fun g' hg' => Limits.kernel.lift _ g' (by
            rw [← Limits.kernel.lift_ι (I.cocomplex.d (n + 1) (n + 2)) (I.cocomplex.d n (n + 1))
              (I.cocomplex.d_comp_d n (n + 1) (n + 2)), ← Category.assoc, hg', Limits.zero_comp]))
          (fun g' hg' => Limits.kernel.lift_ι _ _ _)
          (fun g' hg' m hm => by
            rw [← cancel_mono (Limits.kernel.ι (I.cocomplex.d n (n + 1))), hm,
              Limits.kernel.lift_ι])
      refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
      · exact ShortComplex.exact_of_f_is_kernel _ hlim
      · exact (inferInstance : Mono (Limits.kernel.ι (I.cocomplex.d n (n + 1))))
      · exact hex
    refine ⟨fun n => Limits.kernel (I.cocomplex.d n (n + 1)),
      fun n => Limits.kernel.ι (I.cocomplex.d n (n + 1)),
      fun n => Limits.kernel.lift (I.cocomplex.d (n + 1) (n + 2)) (I.cocomplex.d n (n + 1))
        (I.cocomplex.d_comp_d n (n + 1) (n + 2)), hw, hSE, ?_, ?_, ?_, ?_⟩
    · intro n
      exact (hSE n).exact.map_of_mono_of_preservesKernel R (hSE n).mono_f inferInstance
    · intro n
      exact (inferInstance : Mono (R.map (Limits.kernel.ι (I.cocomplex.d n (n + 1)))))
    · intro n
      obtain ⟨ψ⟩ := c2 n
      exact (H2 (n + 1) (by omega)).of_iso (S.mapIso ψ)
    · have h0 := I.exact₀.fIsKernel
      exact ⟨(HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 B).symm ≪≫
        Limits.IsLimit.conePointUniqueUpToIso h0 (Limits.limit.isLimit _)⟩


  have hfac : ∀ n, Limits.factorThruImage (R.map (g n)) ≫ Limits.image.ι (R.map (g n)) =
      R.map (g n) := fun n => Limits.image.fac _
  have wT : ∀ n, R.map (f n) ≫ Limits.factorThruImage (R.map (g n)) = 0 := by
    intro n
    rw [← cancel_mono (Limits.image.ι (R.map (g n))), Category.assoc, hfac, ← R.map_comp, w n,
      R.map_zero, Limits.zero_comp]
  have hT : ∀ n, (ShortComplex.mk _ _ (wT n)).ShortExact := by
    intro n
    let m : ShortComplex.mk _ _ (wT n) ⟶ (ShortComplex.mk (f n) (g n) (w n)).map R :=
      { τ₁ := 𝟙 _, τ₂ := 𝟙 _, τ₃ := Limits.image.ι (R.map (g n))
        comm₁₂ := by simp
        comm₂₃ := by simp [hfac] }
    haveI : Epi m.τ₁ := by change Epi (𝟙 _); infer_instance
    haveI : IsIso m.τ₂ := by change IsIso (𝟙 _); infer_instance
    haveI : Mono m.τ₃ := by change Mono (Limits.image.ι (R.map (g n))); infer_instance
    haveI := hRf n
    exact ShortComplex.ShortExact.mk' ((ShortComplex.exact_iff_of_epi_of_isIso_of_mono m).mpr
      (hRSex n)) (by dsimp; infer_instance) (by dsimp; infer_instance)
  have wU : ∀ n, Limits.image.ι (R.map (g n)) ≫ Limits.cokernel.π (R.map (g n)) = 0 := by
    intro n
    rw [← cancel_epi (Limits.factorThruImage (R.map (g n))), ← Category.assoc, hfac,
      Limits.cokernel.condition, Limits.comp_zero]
  have hU : ∀ n, (ShortComplex.mk _ _ (wU n)).ShortExact := by
    intro n
    have hT0 : (ShortComplex.mk _ _ (Limits.cokernel.condition (R.map (g n)))).Exact :=
      ShortComplex.exact_cokernel (R.map (g n))
    let m : ShortComplex.mk _ _ (Limits.cokernel.condition (R.map (g n))) ⟶
        ShortComplex.mk _ _ (wU n) :=
      { τ₁ := Limits.factorThruImage (R.map (g n)), τ₂ := 𝟙 _, τ₃ := 𝟙 _
        comm₁₂ := by simp [hfac]
        comm₂₃ := by simp }
    haveI : Epi m.τ₁ := by change Epi (Limits.factorThruImage (R.map (g n))); infer_instance
    haveI : IsIso m.τ₂ := by change IsIso (𝟙 _); infer_instance
    haveI : Mono m.τ₃ := by change Mono (𝟙 _); infer_instance
    exact ShortComplex.ShortExact.mk' ((ShortComplex.exact_iff_of_epi_of_isIso_of_mono m).mp hT0)
      (by dsimp; infer_instance) (by dsimp; infer_instance)
  have hSι : ∀ n, IsIso (S.map (Limits.image.ι (R.map (g n)))) := by
    intro n
    exact ((hU n).map_of_exact S).isIso_f_iff.2 (hZ n)

  have hJ : ∀ n, Injective (I.cocomplex.X n) := I.injective
  have hRJ : ∀ n, Injective (R.obj (I.cocomplex.X n)) := fun n => by
    haveI := hJ n
    exact Injective.injective_of_adjoint adj _
  have hJsurj : ∀ (n m : ℕ) (u : Abelian.Ext (L.obj A) (I.cocomplex.X n) m),
      ∃ v, τ (I.cocomplex.X n) m v = u := by
    intro n m u
    cases m with
    | zero => exact (base _).2 u
    | succ m' =>
      haveI := hJ n
      exact ⟨0, by rw [map_zero]; exact (Abelian.Ext.eq_zero_of_injective u).symm⟩
  have s1b' : ∀ (n m : ℕ) (x : Abelian.Ext A (Limits.image (R.map (g n))) m),
      τ (Y n) (m + 1) (x.comp (hT n).extClass rfl) =
        (τ (Y (n + 1)) m (x.comp (Abelian.Ext.mk₀ (Limits.image.ι (R.map (g n)))) (add_zero m))).comp
          (hS n).extClass rfl := by
    intro n m x
    let φ : (ShortComplex.mk _ _ (wT n)).map L ⟶ ShortComplex.mk (f n) (g n) (w n) :=
      { τ₁ := adj.counit.app (Y n)
        τ₂ := adj.counit.app (I.cocomplex.X n)
        τ₃ := L.map (Limits.image.ι (R.map (g n))) ≫ adj.counit.app (Y (n + 1))
        comm₁₂ := (adj.counit_naturality (f n)).symm
        comm₂₃ := by
          show adj.counit.app (I.cocomplex.X n) ≫ g n =
            L.map (Limits.factorThruImage (R.map (g n))) ≫
              L.map (Limits.image.ι (R.map (g n))) ≫ adj.counit.app (Y (n + 1))
          rw [← Category.assoc, ← L.map_comp, hfac]
          exact (adj.counit_naturality (g n)).symm }
    have h3 := c3 (hT n) (hS n) φ m x
    rw [hτ, hτ]
    refine h3.trans ?_
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc _ _ _ (add_zero m) (zero_add 0) (by omega), Abelian.Ext.mk₀_comp_mk₀]


  have tower : ∀ m n (y : Abelian.Ext A (R.obj (Y n)) m), τ (Y n) m y = 0 →
      Abelian.Ext.mapExactFunctor S y = 0 := by
    intro m
    induction m with
    | zero =>
      intro n y hy
      have hy0 : y = 0 := (base (Y n)).1 (by rw [hy, map_zero])
      rw [hy0, Abelian.Ext.mapExactFunctor_zero]
    | succ m ih =>
      intro n w' hw'
      haveI := hRJ n
      have h0 : w'.comp (Abelian.Ext.mk₀ (R.map (f n))) (add_zero _) = 0 :=
        Abelian.Ext.eq_zero_of_injective _
      obtain ⟨x, hx⟩ : ∃ x : Abelian.Ext A (Limits.image (R.map (g n))) m,
          x.comp (hT n).extClass rfl = w' :=
        Abelian.Ext.covariant_sequence_exact₁ A (hT n) w' h0 rfl
      have h1 : (τ (Y (n + 1)) m (x.comp (Abelian.Ext.mk₀ (Limits.image.ι (R.map (g n))))
          (add_zero m))).comp (hS n).extClass rfl = 0 := by
        rw [← s1b' n m x, hx]
        exact hw'
      obtain ⟨u, hu⟩ : ∃ u : Abelian.Ext (L.obj A) (I.cocomplex.X n) m,
          u.comp (Abelian.Ext.mk₀ (g n)) (add_zero m) = τ (Y (n + 1)) m
            (x.comp (Abelian.Ext.mk₀ (Limits.image.ι (R.map (g n)))) (add_zero m)) :=
        Abelian.Ext.covariant_sequence_exact₃ (L.obj A) (hS n) _ rfl h1
      obtain ⟨v, hv⟩ := hJsurj n m u
      have hδ : τ (Y (n + 1)) m
          (x.comp (Abelian.Ext.mk₀ (Limits.image.ι (R.map (g n)))) (add_zero m) -
            v.comp (Abelian.Ext.mk₀ (R.map (g n))) (add_zero m)) = 0 := by
        rw [map_sub, s1a, hv, hu, sub_self]
      have hSδ := ih (n + 1) _ hδ
      have e1 : Abelian.Ext.mapExactFunctor S
          (x.comp (Abelian.Ext.mk₀ (Limits.image.ι (R.map (g n)))) (add_zero m)) =
          (Abelian.Ext.mapExactFunctor S x).comp
            (Abelian.Ext.mk₀ (S.map (Limits.image.ι (R.map (g n))))) (add_zero m) := by
        rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
      have e2 : Abelian.Ext.mapExactFunctor S
          (v.comp (Abelian.Ext.mk₀ (R.map (g n))) (add_zero m)) =
          ((Abelian.Ext.mapExactFunctor S v).comp
            (Abelian.Ext.mk₀ (S.map (Limits.factorThruImage (R.map (g n))))) (add_zero m)).comp
            (Abelian.Ext.mk₀ (S.map (Limits.image.ι (R.map (g n))))) (add_zero m) := by
        rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
          Abelian.Ext.comp_assoc _ _ _ (add_zero m) (zero_add 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, ← S.map_comp, hfac]
      rw [σsub, sub_eq_zero, e1, e2] at hSδ
      haveI := hSι n
      have hx' : Abelian.Ext.mapExactFunctor S x =
          (Abelian.Ext.mapExactFunctor S v).comp
            (Abelian.Ext.mk₀ (S.map (Limits.factorThruImage (R.map (g n))))) (add_zero m) :=
        (postE (asIso (S.map (Limits.image.ι (R.map (g n))))) m).1 hSδ
      have hc : (Abelian.Ext.mk₀ (S.map (Limits.factorThruImage (R.map (g n))))).comp
          ((hT n).map_of_exact S).extClass (zero_add 1) = 0 :=
        ((hT n).map_of_exact S).comp_extClass
      rw [← hx, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass, hx',
        Abelian.Ext.comp_assoc _ _ _ (add_zero m) (zero_add 1) (by omega), hc,
        Abelian.Ext.comp_zero]


  have key : L.map (adj.unit.app A ≫ R.map μ.hom) ≫ adj.counit.app B = μ.hom := by
    have e2 : L.map (R.map μ.hom) ≫ adj.counit.app B = adj.counit.app (L.obj A) ≫ μ.hom :=
      adj.counit_naturality μ.hom
    have e3 : L.map (adj.unit.app A) ≫ adj.counit.app (L.obj A) = 𝟙 _ :=
      adj.left_triangle_components A
    rw [L.map_comp, Category.assoc, e2, ← Category.assoc]
    erw [e3]
    exact Category.id_comp _
  have hLx : (Abelian.Ext.mapExactFunctor L x).comp (Abelian.Ext.mk₀ μ.hom) (add_zero k) = 0 := by
    apply (preC μ.symm k).1
    show (Abelian.Ext.mk₀ μ.inv).comp ((Abelian.Ext.mapExactFunctor L x).comp
      (Abelian.Ext.mk₀ μ.hom) (add_zero k)) (zero_add k) =
      (Abelian.Ext.mk₀ μ.inv).comp (0 : Abelian.Ext (L.obj A) B k) (zero_add k)
    rw [Abelian.Ext.comp_zero]
    exact hx
  have hτB : τ B k (x.comp (Abelian.Ext.mk₀ (adj.unit.app A ≫ R.map μ.hom)) (add_zero k)) = 0 := by
    rw [hτ, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc _ _ _ (add_zero k) (zero_add 0) (by omega), Abelian.Ext.mk₀_comp_mk₀,
      key]
    exact hLx
  have hτ0 : τ (Y 0) k ((x.comp (Abelian.Ext.mk₀ (adj.unit.app A ≫ R.map μ.hom)) (add_zero k)).comp
      (Abelian.Ext.mk₀ (R.map e.hom)) (add_zero k)) = 0 := by
    rw [s1a, hτB, Abelian.Ext.zero_comp]
  have h0 := tower k 0 _ hτ0
  rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
    Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
    Abelian.Ext.comp_assoc _ _ _ (add_zero k) (zero_add 0) (by omega),
    Abelian.Ext.mk₀_comp_mk₀] at h0
  haveI := H1
  haveI : IsIso (S.map (adj.unit.app A ≫ R.map μ.hom) ≫ S.map (R.map e.hom)) := inferInstance
  have h1 : Abelian.Ext.mapExactFunctor S x = 0 := by
    apply (postE (asIso (S.map (adj.unit.app A ≫ R.map μ.hom) ≫ S.map (R.map e.hom))) k).1
    dsimp only
    rw [Abelian.Ext.zero_comp]
    exact h0
  exact h1

theorem wc_et_smooth_shens_fibre_res_vanish (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Y₀ : Scheme.{u}) [CompactSpace Y₀]
    [QuasiSeparatedSpace Y₀] (p : Y₀ ⟶ Spec (.of A)) (hp : Smooth p) (m : ℕ)
    (hm : IsUnit ((m : ℕ) : A))
    (K : Type u) [Field K] (c : Spec (.of K) ⟶ Spec (.of A)) (hc : IsClosedImmersion c)
    (Ys : Scheme.{u}) (js : Ys ⟶ Y₀) (qs : Ys ⟶ Spec (.of K)) (hs : IsPullback js qs p c)
    (Ω : Type u) [Field Ω] [IsSepClosed Ω] (c' : Spec (.of Ω) ⟶ Spec (.of A))
    (hc' : WeaklyEtale c')
    (Yη : Scheme.{u}) (iη : Yη ⟶ Y₀) (qη : Yη ⟶ Spec (.of Ω)) (hη : IsPullback iη qη p c')
    (Ds : wcEtPullData js m) (Dη : wcEtPullData iη m) (j : ℕ) (x : wcEtZModExt Y₀ m j)
    (hx : wcEtPull Dη j x = 0) : wcEtPull Ds j x = 0 :=
by
  classical

  have hm0 : 0 < m := by
    rcases Nat.eq_zero_or_pos m with h | h
    · subst h
      rw [Nat.cast_zero, isUnit_zero_iff] at hm
      exact absurd hm zero_ne_one
    · exact h

  haveI hjs : IsClosedImmersion js :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hs.flip hc
  have hrange : IsClosed (Set.range js) := js.isClosedEmbedding.isClosed_range

  have hclosed : ∀ t : Spec (.of K), c t = IsLocalRing.closedPoint A := by
    intro t
    haveI : Subsingleton (Spec (.of K)) := by
      show Subsingleton (PrimeSpectrum K)
      infer_instance
    have h1 : IsClosed (Set.range c) := c.isClosedEmbedding.isClosed_range
    have h2 : IsLocalRing.closedPoint A ∈ closure ({c t} : Set (Spec (.of A))) :=
      specializes_iff_mem_closure.mp (IsLocalRing.specializes_closedPoint (c t))
    have h3 : closure ({c t} : Set (Spec (.of A))) ⊆ Set.range c :=
      closure_minimal (Set.singleton_subset_iff.mpr ⟨t, rfl⟩) h1
    obtain ⟨t', ht'⟩ := h3 h2
    have ht : t' = t := Subsingleton.elim _ _
    rw [← ht, ht']
  have hfib : ∀ s' : Ys, p (js s') = IsLocalRing.closedPoint A := by
    intro s'
    have e : p (js s') = c (qs s') := by
      have := congrArg (fun f : Ys ⟶ Spec (.of A) => f s') hs.toCommSq.w
      first
        | exact this
        | simpa using this
    rw [e, hclosed]

  obtain ⟨z, hz⟩ : ∃ z : Spec (.of (AlgebraicClosure Ω)) ⟶ Spec (.of A),
      z = Spec.map (CommRingCat.ofHom (algebraMap Ω (AlgebraicClosure Ω))) ≫ c' := ⟨_, rfl⟩
  have hw : Limits.pullback.fst p z ≫ p =
      (Limits.pullback.snd p z ≫
        Spec.map (CommRingCat.ofHom (algebraMap Ω (AlgebraicClosure Ω)))) ≫ c' := by
    rw [Limits.pullback.condition, hz, Category.assoc]
  have hr := hη.lift_fst (Limits.pullback.fst p z) _ hw
  obtain ⟨Dπ⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.fst p z) m
  obtain ⟨Dr⟩ := wc_et_zmod_pull_data_exists (hη.lift (Limits.pullback.fst p z) _ hw) m
  have hπx : wcEtPull Dπ j x = 0 := by
    rw [wc_et_pull_comp iη _ _ hr Dη Dr Dπ j x, hx, map_zero]

  have hmil := fun s' : Ys =>
    wc_smooth_shens_milnor_fibre_acyclic A Y₀ p hp m hm (js s') (hfib s')
  haveI := Dπ.additive
  haveI := Dπ.presLim
  haveI := Dπ.presColim
  haveI := Ds.additive
  haveI := Ds.presLim
  haveI := Ds.presColim
  have hkc := fun s' : Ys =>
    wc_et_supp_unit_ker_coker_stalks_of_milnor_h0 A Y₀ p m hm0 (AlgebraicClosure Ω) z Dπ (js s')
      (by
        intro B _ _ _ Λ _ _ W' φ a hd
        exact (hmil s' B Λ W' φ a hd (AlgebraicClosure Ω) z).1)
  have hker : Limits.IsZero (Ds.Φ.obj (Limits.kernel (wcEtSuppUnitMap Dπ))) :=
    wc_et_pull_isZero_of_range_stalks js m Ds _ hrange (fun s' => (hkc s').1)
  have hcok : Limits.IsZero (Ds.Φ.obj (Limits.cokernel (wcEtSuppUnitMap Dπ))) :=
    wc_et_pull_isZero_of_range_stalks js m Ds _ hrange (fun s' => (hkc s').2)

  have hiso : IsIso (Ds.Φ.map (wcEtSuppUnitMap Dπ)) := by
    have h1 : Limits.IsZero (Limits.kernel (Ds.Φ.map (wcEtSuppUnitMap Dπ))) :=
      hker.of_iso (Limits.PreservesKernel.iso Ds.Φ (wcEtSuppUnitMap Dπ)).symm
    have h2 : Limits.IsZero (Limits.cokernel (Ds.Φ.map (wcEtSuppUnitMap Dπ))) :=
      hcok.of_iso (Limits.PreservesCokernel.iso Ds.Φ (wcEtSuppUnitMap Dπ)).symm
    haveI := Preadditive.mono_of_isZero_kernel _ h1
    haveI := Preadditive.epi_of_isZero_cokernel _ h2
    exact isIso_of_mono_of_epi _

  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback p z) m)) :=
    sheafOfModules_enoughInjectives _ _
  obtain ⟨I⟩ : Nonempty (InjectiveResolution
      (SheafOfModules.unit (wcEtZModRing (Limits.pullback p z) m))) :=
    ⟨InjectiveResolution.of _⟩
  letI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst p z)) _ _
      Dπ.cont Dπ.φ).Additive :=
    @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ Dπ.adj Dπ.additive

  have hS := wc_ext_exact_pull_vanish_of_unit_resolution Dπ.Φ
    (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst p z)) _ _
      Dπ.cont Dπ.φ) Dπ.adj Ds.Φ _ _ Dπ.μ I hiso
    (by
      intro q hq
      exact wc_et_pull_isZero_of_range_stalks js m Ds _ hrange (fun s' =>
        wc_et_module_push_higher_stalk_vanish_of_milnor A Y₀ p m hm0 (AlgebraicClosure Ω) z Dπ I
          (js s')
          (by
            intro B _ _ _ Λ _ _ W' φ a hd
            exact (hmil s' B Λ W' φ a hd (AlgebraicClosure Ω) z).2) q hq))
    j x hπx
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y₀ m)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Ys m)) := HasExt.standard _
  show ((Abelian.Ext.mk₀ Ds.μ.inv).precomp _ (zero_add j))
    (((Abelian.Ext.mk₀ Ds.μ.hom).postcomp _ (add_zero j)) (Ds.Φ.mapExtAddHom _ _ j x)) = 0
  rw [hS, map_zero, map_zero]

theorem wc_smooth_strict_local_zmod_res_vanish {Y' X' : Scheme.{u}} (ι : X' ⟶ Y')
    (L : Sheaf (Scheme.ProEt.topology Y') AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology X') AddCommGrpCat.{u+1})
    [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L]
    (adj : L ⊣ wcProEtPush ι)
    (θ : ∀ V : Y'.ProEt, L.obj (wcFreeSheaf Y' V) ≅ wcFreeSheaf X' ((wcProEtPullback ι).obj V))
    (hθ : ∀ {V V' : Y'.ProEt} (a : V ⟶ V'),
      L.map (wcFreeSheafMap Y' a) ≫ (θ V').hom =
        (θ V).hom ≫ wcFreeSheafMap X' ((wcProEtPullback ι).map a))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (hℓA : IsUnit ((ℓ : ℕ) : A))
    (U : Y'.ProEt) [CompactSpace U.left] [QuasiSeparatedSpace U.left]
    (p : U.left ⟶ Spec (.of A)) (hp : Smooth p)
    (K : Type u) [Field K] (c : Spec (.of K) ⟶ Spec (.of A)) (hc : IsClosedImmersion c)
    (qs : Limits.pullback U.hom ι ⟶ Spec (.of K))
    (hs : IsPullback (Limits.pullback.fst U.hom ι) qs p c)
    (Vη : Y'.ProEt) (η : Vη ⟶ U)
    (Ω : Type u) [Field Ω] [IsSepClosed Ω] (c' : Spec (.of Ω) ⟶ Spec (.of A))
    (hc' : WeaklyEtale c') (qη : Vη.left ⟶ Spec (.of Ω)) (hη : IsPullback η.left qη p c')
    (k j : ℕ) (y : Abelian.Ext (wcFreeSheaf Y' U) (wcContSheaf Y' (ZMod (ℓ ^ k))) j)
    (hy : (Abelian.Ext.mk₀ (wcFreeSheafMap Y' η)).comp y (zero_add j) = 0) :
    wcProEtRes ι L adj θ (ZMod (ℓ ^ k)) U j y = 0 :=
by
  classical
  have hn : 0 < ℓ ^ k := pow_pos (Fact.out : ℓ.Prime).pos k
  obtain ⟨Ψ, hbij, hnat, hres⟩ := wc_proet_free_zmod_ext_et_model (ℓ ^ k) j hn
  haveI hηaff : IsAffineHom η.left :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) hη.flip (inferInstance : IsAffineHom c')
  haveI hcη : CompactSpace Vη.left := QuasiCompact.compactSpace_of_compactSpace η.left
  haveI hqη : QuasiSeparatedSpace Vη.left := quasiSeparatedSpace_of_quasiSeparated η.left
  obtain ⟨x, rfl⟩ := (hbij Y' U inferInstance inferInstance).2 y
  obtain ⟨Dη⟩ := wc_et_zmod_pull_data_exists η.left (ℓ ^ k)
  obtain ⟨Ds⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.fst U.hom ι) (ℓ ^ k)
  have h1 : Ψ Y' Vη (wcEtPull Dη j x) = 0 := (hnat Y' η Dη x).symm.trans hy
  have h2 : wcEtPull Dη j x = 0 := (hbij Y' Vη hcη hqη).1 (h1.trans (map_zero _).symm)
  have hu : IsUnit (((ℓ ^ k : ℕ) : ℕ) : A) := by rw [Nat.cast_pow]; exact hℓA.pow k
  have h3 := wc_et_smooth_shens_fibre_res_vanish A U.left p hp (ℓ ^ k) hu K c hc
    (Limits.pullback U.hom ι) (Limits.pullback.fst U.hom ι) qs hs Ω c' hc' Vη.left η.left qη hη
    Ds Dη j x h2
  exact hres ι L adj θ hθ U Ds x h3

theorem wc_res_ladic_kernel_of_torsion {Y' X' : Scheme.{u}} (ι : X' ⟶ Y')
    (L : Sheaf (Scheme.ProEt.topology Y') AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology X') AddCommGrpCat.{u+1})
    [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L]
    (adj : L ⊣ wcProEtPush ι)
    (θ : ∀ V : Y'.ProEt, L.obj (wcFreeSheaf Y' V) ≅ wcFreeSheaf X' ((wcProEtPullback ι).obj V))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (U Vη : Y'.ProEt) (η : Vη ⟶ U)
    [CompactSpace U.left] [QuasiSeparatedSpace U.left]
    [CompactSpace Vη.left] [QuasiSeparatedSpace Vη.left]
    (hfin : ∀ j k : ℕ, Finite (Abelian.Ext (wcFreeSheaf X' ((wcProEtPullback ι).obj U))
      (wcContSheaf X' (ZMod (ℓ ^ k))) j))
    (htor : ∀ (k j : ℕ) (y : Abelian.Ext (wcFreeSheaf Y' U) (wcContSheaf Y' (ZMod (ℓ ^ k))) j),
      (Abelian.Ext.mk₀ (wcFreeSheafMap Y' η)).comp y (zero_add j) = 0 →
      wcProEtRes ι L adj θ (ZMod (ℓ ^ k)) U j y = 0)
    (j : ℕ) (z : Abelian.Ext (wcFreeSheaf Y' U) (wcContSheaf Y' ℚ_[ℓ]) j)
    (hz : (Abelian.Ext.mk₀ (wcFreeSheafMap Y' η)).comp z (zero_add j) = 0) :
    wcProEtRes ι L adj θ ℚ_[ℓ] U j z = 0 :=
by
  classical
  have hℓ0 : ℓ ≠ 0 := (Fact.out : ℓ.Prime).ne_zero
  have hc : ∀ k : ℕ, Continuous ((PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom) := fun k =>
    ((continuous_apply k).comp (wc_padic_tower_facts ℓ).1).congr (fun _ => rfl)
  have ratU := proet_qcqs_ladic_rationalization Y' U ℓ j
  have ratη := proet_qcqs_ladic_rationalization Y' Vη ℓ j

  let R : ∀ (G : Sheaf (Scheme.ProEt.topology Y') AddCommGrpCat.{u+1})
      (G' : Sheaf (Scheme.ProEt.topology X') AddCommGrpCat.{u+1})
      (_ : L.obj G ⟶ G') (q : ℕ),
      Abelian.Ext (wcFreeSheaf Y' U) G q →+
        Abelian.Ext (wcFreeSheaf X' ((wcProEtPullback ι).obj U)) G' q :=
    fun G G' a q => ((Abelian.Ext.mk₀ (θ U).inv).precomp G'
      (zero_add q)).comp (((Abelian.Ext.mk₀ a).postcomp _ (add_zero q)).comp (L.mapExtAddHom _ _ q))
  have hR : ∀ G G' (a : L.obj G ⟶ G') (q : ℕ)
      (z : Abelian.Ext (wcFreeSheaf Y' U) G q),
      R G G' a q z = (Abelian.Ext.mk₀ (θ U).inv).comp
        ((Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ a) (add_zero q)) (zero_add q) := by
    intro G G' a q z
    first
      | rfl
      | (simp only [R, AddMonoidHom.comp_apply, Functor.mapExtAddHom_apply]; rfl)
  have hN : ∀ {G1 G2 : Sheaf (Scheme.ProEt.topology Y') AddCommGrpCat.{u+1}}
      {G1' G2' : Sheaf (Scheme.ProEt.topology X') AddCommGrpCat.{u+1}}
      (κY : G1 ⟶ G2) (κX : G1' ⟶ G2') (a1 : L.obj G1 ⟶ G1') (a2 : L.obj G2 ⟶ G2'),
      L.map κY ≫ a2 = a1 ≫ κX → ∀ (q : ℕ)
      (z : Abelian.Ext (wcFreeSheaf Y' U) G1 q),
      R G2 G2' a2 q (z.comp (Abelian.Ext.mk₀ κY) (add_zero q)) =
        (R G1 G1' a1 q z).comp (Abelian.Ext.mk₀ κX) (add_zero q) := by
    intro G1 G2 G1' G2' κY κX a1 a2 h q z
    have e1 : Abelian.Ext.mapExactFunctor L (z.comp (Abelian.Ext.mk₀ κY) (add_zero q)) =
        (Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ (L.map κY)) (add_zero q) := by
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
    have e2 : ((Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ (L.map κY)) (add_zero q)).comp
        (Abelian.Ext.mk₀ a2) (add_zero q) =
        ((Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ a1) (add_zero q)).comp
        (Abelian.Ext.mk₀ κX) (add_zero q) := by
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, h,
        ← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.comp_assoc_of_third_deg_zero]
    rw [hR, hR, e1, e2]
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add q) (add_zero q) (by omega)).symm
  have hAdj : ∀ {G1 G2 : Sheaf (Scheme.ProEt.topology Y') AddCommGrpCat.{u+1}}
      {G1' G2' : Sheaf (Scheme.ProEt.topology X') AddCommGrpCat.{u+1}}
      (κY : G1 ⟶ G2) (κX : G1' ⟶ G2')
      (p1 : G1 ⟶ (wcProEtPush ι).obj G1')
      (p2 : G2 ⟶ (wcProEtPush ι).obj G2'),
      κY ≫ p2 = p1 ≫ (wcProEtPush ι).map κX →
      L.map κY ≫ (adj.homEquiv _ _).symm p2 = (adj.homEquiv _ _).symm p1 ≫ κX := by
    intro G1 G2 G1' G2' κY κX p1 p2 h
    rw [← adj.homEquiv_naturality_left_symm, h, adj.homEquiv_naturality_right_symm]
  let Ψ0 : Abelian.Ext (wcFreeSheaf Y' U) (wcLadicSheaf Y' ℓ) j →+
      Abelian.Ext (wcFreeSheaf X' ((wcProEtPullback ι).obj U)) (wcLadicSheaf X' ℓ) j :=
    R (wcLadicSheaf Y' ℓ) (wcLadicSheaf X' ℓ) ((adj.homEquiv _ _).symm (wcContPull ι ℚ_[ℓ])) j
  let ρI : Abelian.Ext (wcFreeSheaf Y' U) (wcIntSheaf Y' ℓ) j →+
      Abelian.Ext (wcFreeSheaf X' ((wcProEtPullback ι).obj U)) (wcIntSheaf X' ℓ) j :=
    R (wcIntSheaf Y' ℓ) (wcIntSheaf X' ℓ) ((adj.homEquiv _ _).symm (wcContPull ι ℤ_[ℓ])) j
  let ρT : ∀ k : ℕ, Abelian.Ext (wcFreeSheaf Y' U) (wcContSheaf Y' (ZMod (ℓ ^ k))) j →+
      Abelian.Ext (wcFreeSheaf X' ((wcProEtPullback ι).obj U)) (wcContSheaf X' (ZMod (ℓ ^ k))) j :=
    fun k => R (wcContSheaf Y' (ZMod (ℓ ^ k))) (wcContSheaf X' (ZMod (ℓ ^ k)))
      ((adj.homEquiv _ _).symm (wcContPull ι (ZMod (ℓ ^ k)))) j
  have hΨ0 : ∀ z, wcProEtRes ι L adj θ ℚ_[ℓ] U j z = Ψ0 z := fun z => rfl
  have hρT : ∀ k x, wcProEtRes ι L adj θ (ZMod (ℓ ^ k)) U j x = ρT k x := fun k x => rfl
  have hNatQ : ∀ y : Abelian.Ext (wcFreeSheaf Y' U) (wcIntSheaf Y' ℓ) j,
      Ψ0 (y.comp (Abelian.Ext.mk₀ (wcIntToLadic Y' ℓ)) (add_zero j)) =
        (ρI y).comp (Abelian.Ext.mk₀ (wcIntToLadic X' ℓ)) (add_zero j) := by
    intro y
    have hsq : wcIntToLadic Y' ℓ ≫ wcContPull ι ℚ_[ℓ] =
        wcContPull ι ℤ_[ℓ] ≫ (wcProEtPush ι).map (wcIntToLadic X' ℓ) :=
      wc_contPull_intToLadic ι ℓ
    exact hN _ _ _ _ (hAdj _ _ _ _ hsq) j y
  have hNatI : ∀ (k : ℕ) (x : Abelian.Ext (wcFreeSheaf Y' U) (wcIntSheaf Y' ℓ) j),
      ρT k (x.comp (Abelian.Ext.mk₀ (wcContSheafMap Y'
        (PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom (hc k))) (add_zero j)) =
        (ρI x).comp (Abelian.Ext.mk₀ (wcContSheafMap X'
          (PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom (hc k))) (add_zero j) :=
    fun k x => hN _ _ _ _ (hAdj _ _ _ _ (wc_contPull_contSheafMap ι _ (hc k))) j x

  have Q1 : ∀ (S : Scheme.{u}) (P : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (q N : ℕ)
      (x : Abelian.Ext P (wcLadicSheaf S ℓ) q),
      N • x = x.comp (Abelian.Ext.mk₀ (wcLadicScalar S ℓ (N : ℚ_[ℓ]))) (add_zero q) := by
    intro S P q N x
    obtain ⟨h1, -, hadd⟩ := wc_ladic_scalar_ring S ℓ
    induction N with
    | zero =>
      have h0 : wcLadicScalar S ℓ 0 = 0 := by
        have h := congrArg (fun t => t - wcLadicScalar S ℓ 0) (hadd 0 0)
        simp only [add_zero, sub_self, add_sub_cancel_right] at h
        exact h.symm
      rw [zero_nsmul, Nat.cast_zero, h0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    | succ N ih =>
      rw [succ_nsmul, ih, Nat.cast_succ, hadd, h1, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add,
        Abelian.Ext.comp_mk₀_id]
  have hinv : ∀ (S : Scheme.{u}) (P : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (q : ℕ)
      (x : Abelian.Ext P (wcLadicSheaf S ℓ) q) (c : ℚ_[ℓ]), c ≠ 0 →
      (x.comp (Abelian.Ext.mk₀ (wcLadicScalar S ℓ c)) (add_zero q)).comp
        (Abelian.Ext.mk₀ (wcLadicScalar S ℓ c⁻¹)) (add_zero q) = x := by
    intro S P q x c hc0
    obtain ⟨h1, hmul, -⟩ := wc_ladic_scalar_ring S ℓ
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, ← hmul,
      inv_mul_cancel₀ hc0, h1, Abelian.Ext.comp_mk₀_id]

  have hpre : ∀ {G : Sheaf (Scheme.ProEt.topology Y') AddCommGrpCat.{u+1}} (n : ℕ)
      (x : Abelian.Ext (wcFreeSheaf Y' U) G j),
      (Abelian.Ext.mk₀ (wcFreeSheafMap Y' η)).comp (n • x) (zero_add j) =
        n • (Abelian.Ext.mk₀ (wcFreeSheafMap Y' η)).comp x (zero_add j) := fun n x =>
    map_nsmul ((Abelian.Ext.mk₀ (wcFreeSheafMap Y' η)).precomp _ (zero_add j)) n x
  have hpost : ∀ {G G' : Sheaf (Scheme.ProEt.topology Y') AddCommGrpCat.{u+1}} (κ : G ⟶ G')
      (n : ℕ) (x : Abelian.Ext (wcFreeSheaf Y' U) G j),
      (n • x).comp (Abelian.Ext.mk₀ κ) (add_zero j) =
        n • x.comp (Abelian.Ext.mk₀ κ) (add_zero j) := fun κ n x =>
    map_nsmul ((Abelian.Ext.mk₀ κ).postcomp _ (add_zero j)) n x
  have hassoc : ∀ {G G' : Sheaf (Scheme.ProEt.topology Y') AddCommGrpCat.{u+1}} (κ : G ⟶ G')
      (x : Abelian.Ext (wcFreeSheaf Y' U) G j),
      (Abelian.Ext.mk₀ (wcFreeSheafMap Y' η)).comp (x.comp (Abelian.Ext.mk₀ κ) (add_zero j))
          (zero_add j) =
        ((Abelian.Ext.mk₀ (wcFreeSheafMap Y' η)).comp x (zero_add j)).comp
          (Abelian.Ext.mk₀ κ) (add_zero j) := fun κ x =>
    (Abelian.Ext.comp_assoc _ _ _ (zero_add j) (add_zero j) (by omega)).symm

  rw [hΨ0]
  let z' : Abelian.Ext (wcFreeSheaf Y' U) (wcLadicSheaf Y' ℓ) j := z
  have hz' : (Abelian.Ext.mk₀ (wcFreeSheafMap Y' η)).comp z' (zero_add j) = 0 := hz
  show Ψ0 z' = 0
  clear_value z'
  obtain ⟨a, y, hy⟩ := ratU.1 z'
  have h1 : ((Abelian.Ext.mk₀ (wcFreeSheafMap Y' η)).comp y (zero_add j)).comp
      (Abelian.Ext.mk₀ (wcIntToLadic Y' ℓ)) (add_zero j) = 0 := by
    rw [← hassoc, ← hy, hpre, hz', smul_zero]
  obtain ⟨r, hr⟩ := ratη.2 _ h1
  have h2 : (Abelian.Ext.mk₀ (wcFreeSheafMap Y' η)).comp (ℓ ^ r • y) (zero_add j) = 0 := by
    rw [hpre, hr]
  have h3 : ∀ k : ℕ, (ρI (ℓ ^ r • y)).comp (Abelian.Ext.mk₀ (wcContSheafMap X'
      (PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom (hc k))) (add_zero j) = 0 := by
    intro k
    rw [← hNatI k, ← hρT]
    apply htor k j
    have e := hassoc (G := wcIntSheaf Y' ℓ)
      (wcContSheafMap Y' (PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom (hc k)) (ℓ ^ r • y)
    rw [h2, Abelian.Ext.zero_comp] at e
    exact e
  have h4 : ρI (ℓ ^ r • y) = 0 :=
    wc_proet_int_separated_of_finite X' ((wcProEtPullback ι).obj U) ℓ hc hfin j _ h3
  have h5 : (ℓ ^ r * ℓ ^ a) • Ψ0 z' = 0 := by
    rw [← map_nsmul Ψ0, mul_smul, hy, ← hpost, hNatQ, h4, Abelian.Ext.zero_comp]
  have h6 : (Ψ0 z').comp (Abelian.Ext.mk₀ (wcLadicScalar X' ℓ ((ℓ ^ r * ℓ ^ a : ℕ) : ℚ_[ℓ])))
      (add_zero j) = 0 := by
    rw [← Q1, h5]
  have hN0 : ((ℓ ^ r * ℓ ^ a : ℕ) : ℚ_[ℓ]) ≠ 0 :=
    Nat.cast_ne_zero.mpr (mul_ne_zero (pow_ne_zero _ hℓ0) (pow_ne_zero _ hℓ0))
  have h7 := hinv _ _ j (Ψ0 z') _ hN0
  rw [h6, Abelian.Ext.zero_comp] at h7
  exact h7.symm

theorem wc_crit_nbhd_res_punct_vanish (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'') (i : Fin D.m)
    (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom (D.S i) ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom (D.S i))
    (L : Sheaf (Scheme.ProEt.topology D.Yt.left) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology (Limits.pullback D.f (D.S i))) AddCommGrpCat.{u+1})
    [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L]
    (adj : L ⊣ wcProEtPush (Limits.pullback.fst D.f (D.S i)))
    (θ : ∀ V : D.Yt.left.ProEt, L.obj (wcFreeSheaf D.Yt.left V) ≅
      wcFreeSheaf (Limits.pullback D.f (D.S i))
        ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj V))
    (hθ : ∀ {V V' : D.Yt.left.ProEt} (a : V ⟶ V'),
      L.map (wcFreeSheafMap D.Yt.left a) ≫ (θ V').hom =
        (θ V).hom ≫ wcFreeSheafMap (Limits.pullback D.f (D.S i))
          ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).map a))
    (z : Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀))
        (wcLadicSheaf D.Yt.left ℓ) n)
    (hz : ∀ (Vη : (wcP1Over F'').left.ProEt) (a : Vη ⟶ V₀) (B : Type u) [CommRing B]
        [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
        (eB : Vη.left ≅ Spec (.of B)),
        (∀ (v : Vη.left) (j : Fin D.m), Vη.hom v ≠ D.S j (IsLocalRing.closedPoint F'')) →
        (Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left ((wcProEtPullback D.f).map a))).comp z
          (zero_add n) = 0) :
    (Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f (D.S i))
        (wcOpenRestrIncl (Limits.pullback D.f (D.S i)) (wcCritPunctOpen D i)
          ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
            ((wcProEtPullback D.f).obj V₀))))).comp
      (wcProEtRes (Limits.pullback.fst D.f (D.S i)) L adj θ ℚ_[ℓ]
        ((wcProEtPullback D.f).obj V₀) n z) (zero_add n) = 0 :=
by
  classical

  have F0 : ∀ {S : Scheme.{u}} {U V W : S.ProEt} (a : U ⟶ V) (b : V ⟶ W),
      wcFreeSheafMap S (a ≫ b) = wcFreeSheafMap S a ≫ wcFreeSheafMap S b := by
    intro S U V W a b
    have h := (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_comp
      (Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
      (Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    first
      | rw [← Functor.whiskerRight_comp, ← yoneda.map_comp] at h
      | rw [← Functor.comp_whiskerRight, ← yoneda.map_comp] at h
    exact h
  have F1 : ∀ {S : Scheme.{u}} (U : S.ProEt), wcFreeSheafMap S (𝟙 U) = 𝟙 _ := by
    intro S U
    unfold wcFreeSheafMap
    rw [yoneda.map_id]
    first
      | rw [Functor.whiskerRight_id', Functor.map_id]
      | rw [Functor.whiskerRight_id, Functor.map_id]
      | simp
    try rfl

  have hnat : ∀ {U U' : D.Yt.left.ProEt} (a : U ⟶ U')
      (x : Abelian.Ext (wcFreeSheaf D.Yt.left U') (wcContSheaf D.Yt.left ℚ_[ℓ]) n),
      wcProEtRes (Limits.pullback.fst D.f (D.S i)) L adj θ ℚ_[ℓ] U n
          ((Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left a)).comp x (zero_add n)) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f (D.S i))
          ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).map a))).comp
          (wcProEtRes (Limits.pullback.fst D.f (D.S i)) L adj θ ℚ_[ℓ] U' n x) (zero_add n) := by
    intro U U' a x
    have hRz : ∀ (V : D.Yt.left.ProEt)
        (w : Abelian.Ext (wcFreeSheaf D.Yt.left V) (wcContSheaf D.Yt.left ℚ_[ℓ]) n),
        wcProEtRes (Limits.pullback.fst D.f (D.S i)) L adj θ ℚ_[ℓ] V n w =
          (Abelian.Ext.mk₀ (θ V).inv).comp
            ((Abelian.Ext.mapExactFunctor L w).comp
              (Abelian.Ext.mk₀ ((adj.homEquiv (wcContSheaf D.Yt.left ℚ_[ℓ])
                (wcContSheaf (Limits.pullback D.f (D.S i)) ℚ_[ℓ])).symm
                (wcContPull (Limits.pullback.fst D.f (D.S i)) ℚ_[ℓ]))) (add_zero n))
            (zero_add n) := fun V w => rfl
    have hθa : (θ U).inv ≫ L.map (wcFreeSheafMap D.Yt.left a) =
        wcFreeSheafMap (Limits.pullback D.f (D.S i))
          ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).map a) ≫ (θ U').inv := by
      rw [Iso.inv_comp_eq, ← Category.assoc, ← hθ a, Category.assoc, Iso.hom_inv_id,
        Category.comp_id]
    rw [hRz, hRz, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
    simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.mk₀_comp_mk₀_assoc, hθa]

  obtain ⟨Vη, a, Ω, _, _, _, _, eΩ, c', hc'we, hca, havoid⟩ :=
    wc_crit_nbhd_generic_geom_pt F' F'' Y n D i V₀ A e hv
  have hzη := hz Vη a Ω eΩ havoid
  obtain ⟨a', ha', hpbη, hcη, hqη⟩ := wc_crit_nbhd_generic_fibre_pullback F' F'' Y n D i V₀ A e
    Vη a Ω eΩ c' hca (fun v => havoid v i)
  obtain ⟨hsm, hcpt, hqs⟩ := wc_crit_nbhd_punct_smooth_qcqs F' F'' Y n D i V₀ A e hv
  obtain ⟨hcl, hℓA, qs, hpb⟩ := wc_crit_nbhd_punct_closed_fibre_pullback F' F'' Y n D ℓ hℓ i V₀
    A e ε hv hε
  have hfin := wc_crit_punct_fibre_zmod_finite F' F'' Y n D ℓ hℓ i V₀ A e ε hv hε
  haveI := hcpt
  haveI := hqs
  haveI := hcη
  haveI := hqη

  have hz0 : (Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left a')).comp
      ((Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left (wcOpenRestrIncl D.Yt.left
        ⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ, isOpen_compl_iff.mpr isClosed_closure⟩
        ((wcProEtPullback D.f).obj V₀)))).comp z (zero_add n)) (zero_add n) = 0 := by
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc, ← F0, ha']
    exact hzη

  have h0 := wc_res_ladic_kernel_of_torsion (Limits.pullback.fst D.f (D.S i)) L adj θ ℓ
    (wcOpenRestr D.Yt.left
      ⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ, isOpen_compl_iff.mpr isClosed_closure⟩
      ((wcProEtPullback D.f).obj V₀))
    ((wcProEtPullback D.f).obj Vη) a' hfin
    (fun k j y hy => wc_smooth_strict_local_zmod_res_vanish (Limits.pullback.fst D.f (D.S i))
      L adj θ hθ ℓ A hℓA _ _ hsm (AlgebraicClosure F'') _ hcl qs hpb _ a' Ω c' hc'we _ hpbη
      k j y hy)
    n _ hz0

  obtain ⟨β, hβ⟩ := wc_proet_pullback_openRestr_iso (Limits.pullback.fst D.f (D.S i))
    (⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ, isOpen_compl_iff.mpr isClosed_closure⟩ :
      D.Yt.left.Opens) ((wcProEtPullback D.f).obj V₀)
  have e1 : ∀ t : Abelian.Ext (wcFreeSheaf (Limits.pullback D.f (D.S i))
      (wcOpenRestr (Limits.pullback D.f (D.S i))
        (Limits.pullback.fst D.f (D.S i) ⁻¹ᵁ
          ⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ, isOpen_compl_iff.mpr isClosed_closure⟩)
        ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj ((wcProEtPullback D.f).obj V₀))))
      (wcContSheaf (Limits.pullback D.f (D.S i)) ℚ_[ℓ]) n,
      t = (Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f (D.S i)) β.inv)).comp
        ((Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f (D.S i)) β.hom)).comp t
          (zero_add n)) (zero_add n) := by
    intro t
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc, ← F0, Iso.inv_hom_id, F1, Abelian.Ext.mk₀_id_comp]
  show (Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f (D.S i))
      (wcOpenRestrIncl (Limits.pullback D.f (D.S i))
        (Limits.pullback.fst D.f (D.S i) ⁻¹ᵁ
          ⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ, isOpen_compl_iff.mpr isClosed_closure⟩)
        ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
          ((wcProEtPullback D.f).obj V₀))))).comp
    (wcProEtRes (Limits.pullback.fst D.f (D.S i)) L adj θ ℚ_[ℓ]
      ((wcProEtPullback D.f).obj V₀) n z) (zero_add n) = 0
  have h1 := hnat (wcOpenRestrIncl D.Yt.left
      ⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ, isOpen_compl_iff.mpr isClosed_closure⟩
      ((wcProEtPullback D.f).obj V₀)) z
  have h2 := h1.symm.trans h0
  have e2 : (Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f (D.S i)) β.hom)).comp
      ((Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f (D.S i))
        (wcOpenRestrIncl (Limits.pullback D.f (D.S i))
          (Limits.pullback.fst D.f (D.S i) ⁻¹ᵁ
            ⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ,
              isOpen_compl_iff.mpr isClosed_closure⟩)
          ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
            ((wcProEtPullback D.f).obj V₀))))).comp
        (wcProEtRes (Limits.pullback.fst D.f (D.S i)) L adj θ ℚ_[ℓ]
          ((wcProEtPullback D.f).obj V₀) n z) (zero_add n)) (zero_add n) =
      (Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f (D.S i))
        ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).map
          (wcOpenRestrIncl D.Yt.left
            ⟨(closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ,
              isOpen_compl_iff.mpr isClosed_closure⟩
            ((wcProEtPullback D.f).obj V₀))))).comp
        (wcProEtRes (Limits.pullback.fst D.f (D.S i)) L adj θ ℚ_[ℓ]
          ((wcProEtPullback D.f).obj V₀) n z) (zero_add n) := by
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc, ← F0, hβ]
  refine (e1 _).trans ?_
  rw [e2, h2, Abelian.Ext.comp_zero]

theorem wc_odp_punct_germ_zmod_finite (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom (D.S i) ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom (D.S i))
    (xb : ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
        ((wcProEtPullback D.f).obj V₀)).left)
    (hxb : Set.range (wcOpenRestrIncl (Limits.pullback D.f (D.S i)) (wcCritPunctOpen D i)
        ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
          ((wcProEtPullback D.f).obj V₀))).left = {xb}ᶜ)
    (Th VT : (Limits.pullback D.f (D.S i)).ProEt)
    (g : Th ⟶ (wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
        ((wcProEtPullback D.f).obj V₀))
    (B : Type u) [CommRing B] [IsNoetherianRing B] [HenselianLocalRing B]
    [IsSepClosed (IsLocalRing.ResidueField B)] (eB : Th.left ≅ Spec (.of B))
    (hpre : g.left ⁻¹' {xb} = {eB.inv (IsLocalRing.closedPoint B)})
    (hfib : IsIso (Limits.pullback.snd g.left
        (((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
          ((wcProEtPullback D.f).obj V₀)).left.fromSpecResidueField xb)))
    (j : VT ⟶ Th) (hj : IsOpenImmersion j.left)
    (hrange : Set.range j.left = {eB.inv (IsLocalRing.closedPoint B)}ᶜ) :
    ∀ jj k : ℕ, Finite (Abelian.Ext (wcFreeSheaf (Limits.pullback D.f (D.S i)) VT)
      (wcContSheaf (Limits.pullback D.f (D.S i)) (ZMod (ℓ ^ k))) jj) :=
by
  classical
  intro jj k

  have F0 : ∀ {S : Scheme.{u}} {U V W : S.ProEt} (a : U ⟶ V) (b : V ⟶ W),
      wcFreeSheafMap S (a ≫ b) = wcFreeSheafMap S a ≫ wcFreeSheafMap S b := by
    intro S U V W a b
    have h := (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_comp
      (Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
      (Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    first
      | rw [← Functor.whiskerRight_comp, ← yoneda.map_comp] at h
