        ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s) z = v := by
    intro v
    let c : (wcContSheaf (wcP1Over K).left (Fin N → ℚ_[ℓ])).obj.obj (Opposite.op W) :=
      (show (wcContSheaf (wcP1Over K).left (Fin N → ℚ_[ℓ])).obj.obj (Opposite.op W) from
        ULift.up (ContinuousMap.const ↥W.left v))
    refine ⟨(θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom c, fun z => ?_⟩
    have hs := hcancel2 (Over.mk (𝟙 W)) c
    exact congrArg (fun y : ULift.{u+1} C(↥W.left, Fin N → ℚ_[ℓ]) => y.down z) hs
  have huniq : ∀ (γ' : W ⟶ W) (g₁ g₂ : (Fin N → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin N → ℚ_[ℓ])),
      (∀ (s : G.obj.obj (Opposite.op W)) (z : W.left),
        wcContEval (wcP1Over K).left W ((θ.hom.hom.app (Opposite.op (Over.mk γ'))).hom s) z =
          g₁ (wcContEval (wcP1Over K).left W
            ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s) z)) →
      (∀ (s : G.obj.obj (Opposite.op W)) (z : W.left),
        wcContEval (wcP1Over K).left W ((θ.hom.hom.app (Opposite.op (Over.mk γ'))).hom s) z =
          g₂ (wcContEval (wcP1Over K).left W
            ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s) z)) → g₁ = g₂ := by
    intro γ' g₁ g₂ h1 h2
    apply LinearMap.ext
    intro v
    obtain ⟨s, hs⟩ := hconst v
    have e1 := h1 s z₀
    have e2 := h2 s z₀
    rw [hs z₀] at e1 e2
    exact e1.symm.trans e2
  have hs3 := fun γ' : W ⟶ W => wc_proet_deck_frame_linear (wcP1Over K).left ℓ G W hconn N θ γ'
  choose fr hfr0 using hs3
  have hfr : ∀ (γ' : W ⟶ W) (s : G.obj.obj (Opposite.op W)) (z : W.left),
      wcContEval (wcP1Over K).left W ((θ.hom.hom.app (Opposite.op (Over.mk γ'))).hom s) z =
        fr γ' (wcContEval (wcP1Over K).left W
          ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s) z) := by
    intro γ' s z
    exact hfr0 γ' W (𝟙 W) γ' (Category.id_comp γ').symm s z
  have hcomp : ∀ γ₁ γ₂ : W ⟶ W, fr (γ₁ ≫ γ₂) = fr γ₂ ∘ₗ fr γ₁ := by
    intro γ₁ γ₂
    apply huniq (γ₁ ≫ γ₂) _ _ (hfr _)
    intro s z
    rw [LinearMap.comp_apply, ← hfr γ₁ s z]
    exact hfr0 γ₂ W γ₁ (γ₁ ≫ γ₂) rfl s z

  let GG : Set ((Fin N → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin N → ℚ_[ℓ])) :=
    {g' | ∃ γ' : W ⟶ W, γ' ≫ w = w ∧ ∀ (s : G.obj.obj (Opposite.op W)) (z : W.left),
      wcContEval (wcP1Over K).left W ((θ.hom.hom.app (Opposite.op (Over.mk γ'))).hom s) z =
        g' (wcContEval (wcP1Over K).left W
          ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s) z)}
  have hGid : LinearMap.id ∈ GG := ⟨𝟙 W, Category.id_comp w, fun s z => rfl⟩
  have hGmul : ∀ g₁ ∈ GG, ∀ g₂ ∈ GG, g₂ ∘ₗ g₁ ∈ GG := by
    rintro g₁ ⟨γ₁, hγ₁, hg₁⟩ g₂ ⟨γ₂, hγ₂, hg₂⟩
    refine ⟨γ₁ ≫ γ₂, by rw [Category.assoc, hγ₂, hγ₁], ?_⟩
    rw [huniq γ₁ _ _ hg₁ (hfr γ₁), huniq γ₂ _ _ hg₂ (hfr γ₂), ← hcomp]
    exact hfr _
  have hGst : ∀ g₁ ∈ GG, ∀ y ∈ (⊤ : Submodule ℚ_[ℓ] (Fin N → ℚ_[ℓ])),
      g₁ y ∈ (⊤ : Submodule ℚ_[ℓ] (Fin N → ℚ_[ℓ])) ∧
        (y ∈ (⊥ : Submodule ℚ_[ℓ] (Fin N → ℚ_[ℓ])) →
          g₁ y ∈ (⊥ : Submodule ℚ_[ℓ] (Fin N → ℚ_[ℓ]))) := by
    intro g₁ _ y _
    refine ⟨Submodule.mem_top, fun hy => ?_⟩
    rw [Submodule.mem_bot] at hy ⊢
    rw [hy, map_zero]

  obtain ⟨Ub0, hUb0, -, hUb0c, -, -⟩ :=
    wc_P1bar_smooth_locus K hP 0 (fun i => Fin.elim0 i) (fun i => Fin.elim0 i)
  haveI := hUb0c
  haveI : CompactSpace (wcGeomPoint K (wcP1Over K) hP).left := by
    have hr : Set.range ⇑Ub0.ι = Set.univ := by
      rw [Scheme.Opens.range_ι]
      exact Set.eq_univ_of_forall (fun p => (hUb0 p).mpr (fun i => Fin.elim0 i))
    exact isCompact_univ_iff.mp (by rw [← hr]; exact isCompact_range Ub0.ι.continuous)
  haveI : QuasiCompact w.left := hqc
  have hWc : CompactSpace W.left := QuasiCompact.compactSpace_of_compactSpace w.left

  obtain ⟨C, hC⟩ := wc_proet_frames_bounded (wcP1Over K).left ℓ G
    (wcGeomPoint K (wcP1Over K) hP) W w hWc ⟨z₀⟩ hqc N θ
  obtain ⟨q, π, hπa, hπb, hπc⟩ := wc_padic_stable_lattice_coords ℓ N ⊥ ⊤ bot_le GG hGid hGmul
    hGst C (by rintro g₁ ⟨γ₁, hγ₁, hg₁⟩ j; exact hC γ₁ g₁ hγ₁ hg₁ j)

  obtain ⟨Ub, hUb, -, -, -, -⟩ := wc_P1bar_smooth_locus K hP m S hS
  have hst' : ∀ (γ' : W ⟶ W) (g' : (Fin N → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin N → ℚ_[ℓ])), γ' ≫ w = w →
      (∀ (s : G.obj.obj (Opposite.op W)) (z : W.left),
        wcContEval (wcP1Over K).left W ((θ.hom.hom.app (Opposite.op (Over.mk γ'))).hom s) z =
          g' (wcContEval (wcP1Over K).left W
            ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s) z)) →
      ∀ x ∈ (⊤ : Submodule ℚ_[ℓ] (Fin N → ℚ_[ℓ])),
        g' x ∈ (⊤ : Submodule ℚ_[ℓ] (Fin N → ℚ_[ℓ])) ∧
          ((∀ j, ‖π x j‖ ≤ 1) → ∀ j, ‖π (g' x) j‖ ≤ 1) := by
    intro γ' g' hγ' hg' x hx
    exact ⟨Submodule.mem_top, hπc g' ⟨γ', hγ', hg'⟩ x hx⟩
  have hin' : ∀ (i : Fin m) (σ : W ⟶ W) (g' : (Fin N → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin N → ℚ_[ℓ])),
      σ ≫ w = w →
      (∀ (s : G.obj.obj (Opposite.op W)) (z : W.left),
        wcContEval (wcP1Over K).left W ((θ.hom.hom.app (Opposite.op (Over.mk σ))).hom s) z =
          g' (wcContEval (wcP1Over K).left W
            ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s) z)) →
      ∀ (V : (wcP1Over K).left.ProEt) (v : V ⟶ wcGeomPoint K (wcP1Over K) hP)
        (A : Type u) [CommRing A] [HenselianLocalRing A]
        [IsSepClosed (IsLocalRing.ResidueField A)] (e : V.left ≅ Spec (.of A)),
        V.hom (e.inv (IsLocalRing.closedPoint A)) = S i (IsLocalRing.closedPoint K) →
      ∀ (L : Type u) [Field L] [IsSepClosed L] (Vt : (wcP1Over K).left.ProEt)
        (eL : Vt.left ≅ Spec (.of L)) (u' : Vt ⟶ V) (c : Vt ⟶ W) (τ : Vt ⟶ Vt),
        u' ≫ v = c ≫ w → τ ≫ u' = u' → τ ≫ c = c ≫ σ →
        ∀ x ∈ (⊤ : Submodule ℚ_[ℓ] (Fin N → ℚ_[ℓ])), π (g' x) = π x := by
    intro i σ g' hσ hg' V v A _ _ _ e hV L _ _ Vt eL u' c τ h1 h2 h3 x _
    rw [hin i σ g' hσ hg' V v A e hV L Vt eL u' c τ h1 h2 h3, LinearMap.id_apply]

  have hk : ∀ k : ℕ, ∀ y : Fin N → ℚ_[ℓ], (∀ j, ‖π y j‖ ≤ 1) →
      ∀ j, ‖π (g y) j - π y j‖ ≤ (ℓ : ℝ) ^ (-(k : ℤ)) := by
    intro k y hyi j
    obtain ⟨E, πE, hfin, het, hsurj, hsplit, htriv⟩ := wc_proet_P1_torsion_cover K hP ℓ m S hS
      G W w N θ hqc hconn hoff hcov hgal Ub hUb ⊤ q π hπb hst' hin' k
    obtain ⟨Eb, πEb, j', hfinb, hetb, hsurjb, hpb⟩ :=
      wc_hmg_fet_extend K hP m S hS Ub hUb E πE hfin het hsurj hsplit
    obtain ⟨σb, hσb⟩ := wc_P1bar_fet_section K hP Eb πEb hfinb hetb hsurjb
    have hsq : (Ub.ι ≫ σb) ≫ πEb = 𝟙 Ub.toScheme ≫ Ub.ι := by
      rw [Category.assoc, hσb, Category.comp_id, Category.id_comp]
    exact htriv (hpb.lift (Ub.ι ≫ σb) (𝟙 _) hsq) (hpb.lift_snd _ _ _) γ g hγ hg y
      Submodule.mem_top hyi j

  have hzero : ∀ y : Fin N → ℚ_[ℓ], (∀ j, ‖π y j‖ ≤ 1) → π (g y) = π y := by
    intro y hyi
    funext j
    have hb : ∀ k : ℕ, ‖π (g y) j - π y j‖ ≤ ((ℓ : ℝ)⁻¹) ^ k := by
      intro k
      have h := hk k y hyi j
      rwa [zpow_neg, zpow_natCast, ← inv_pow] at h
    by_contra hne
    have hpos : 0 < ‖π (g y) j - π y j‖ := norm_pos_iff.mpr (sub_ne_zero.mpr hne)
    obtain ⟨k, hk'⟩ := exists_pow_lt_of_lt_one hpos (inv_lt_one_of_one_lt₀ hℓ1)
    exact absurd (hb k) (not_le.mpr hk')

  apply LinearMap.ext
  intro x
  obtain ⟨N₀, hN₀⟩ := pow_unbounded_of_one_lt (∑ j, ‖π x j‖) hℓ1
  have hc0 : ((ℓ : ℚ_[ℓ]) ^ N₀) ≠ 0 :=
    pow_ne_zero N₀ (by exact_mod_cast (Fact.out : ℓ.Prime).ne_zero)
  have hcn : ‖((ℓ : ℚ_[ℓ]) ^ N₀)‖ = ((ℓ : ℝ) ^ N₀)⁻¹ := by
    rw [norm_pow, Padic.norm_p, inv_pow]
  have hcxi : ∀ j, ‖π (((ℓ : ℚ_[ℓ]) ^ N₀) • x) j‖ ≤ 1 := by
    intro j
    rw [map_smul, Pi.smul_apply, smul_eq_mul, norm_mul, hcn]
    have hle : ‖π x j‖ ≤ ∑ j, ‖π x j‖ :=
      Finset.single_le_sum (fun i _ => norm_nonneg (π x i)) (Finset.mem_univ j)
    have hpos : (0 : ℝ) < (ℓ : ℝ) ^ N₀ := by positivity
    rw [inv_mul_le_iff₀ hpos, mul_one]
    linarith
  have h1 := hzero _ hcxi
  simp only [map_smul] at h1
  have h2 : π (g x) = π x := smul_right_injective _ hc0 h1
  have h3 : π (g x - x) = 0 := by rw [map_sub, h2, sub_self]
  have h4 := (hπa _ Submodule.mem_top).mp h3
  rw [Submodule.mem_bot, sub_eq_zero] at h4
  rw [LinearMap.id_apply]
  exact h4

theorem wc_proet_P1_inertia_generation (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP) (N : ℕ)
    (θ : G.over W ≅ (wcContSheaf (wcP1Over K).left (Fin N → ℚ_[ℓ])).over W)
    (hqc : QuasiCompact w.left) (hconn : ConnectedSpace W.left)
    (hsurj : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left,
      (∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ z : W.left, w.left z = p)
    (hgal : ∀ (V : (wcP1Over K).left.ProEt) (a b : V ⟶ W), ConnectedSpace V.left →
      a ≫ w = b ≫ w → ∃ γ : W ⟶ W, γ ≫ w = w ∧ b = a ≫ γ)
    (hin : ∀ (i : Fin m) (σ : W ⟶ W), σ ≫ w = w →
      ∀ (V : (wcP1Over K).left.ProEt) (v : V ⟶ wcGeomPoint K (wcP1Over K) hP)
        (A : Type u) [CommRing A] [HenselianLocalRing A]
        [IsSepClosed (IsLocalRing.ResidueField A)] (e : V.left ≅ Spec (.of A)),
        V.hom (e.inv (IsLocalRing.closedPoint A)) = S i (IsLocalRing.closedPoint K) →
      ∀ (L : Type u) [Field L] [IsSepClosed L] (Vt : (wcP1Over K).left.ProEt)
        (eL : Vt.left ≅ Spec (.of L)) (u' : Vt ⟶ V) (c : Vt ⟶ W) (τ : Vt ⟶ Vt),
        u' ≫ v = c ≫ w → τ ≫ u' = u' → τ ≫ c = c ≫ σ →
      ∀ (s : G.obj.obj (Opposite.op W)) (z : W.left),
        wcContEval (wcP1Over K).left W ((θ.hom.hom.app (Opposite.op (Over.mk σ))).hom s) z =
          wcContEval (wcP1Over K).left W
            ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s) z) :
    ∀ (γ : W ⟶ W), γ ≫ w = w → ∀ (s : G.obj.obj (Opposite.op W)) (z : W.left),
      wcContEval (wcP1Over K).left W ((θ.hom.hom.app (Opposite.op (Over.mk γ))).hom s) z =
        wcContEval (wcP1Over K).left W ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s) z :=
by
  classical
  intro γ₀ hγ₀ s₀ z₀₀
  haveI := hconn

  obtain ⟨Ub, hUb, -, -, -, hUbqc⟩ := wc_P1bar_smooth_locus K hP m S hS
  have hwhom : ∀ τ : W.left,
      (wcGeomPoint K (wcP1Over K) hP).hom (w.left τ) = W.hom τ := by
    intro τ
    rw [← Scheme.Hom.comp_apply w.left (wcGeomPoint K (wcP1Over K) hP).hom,
      MorphismProperty.Over.w w]
  let O : W.left.Opens := w.left ⁻¹ᵁ Ub
  haveI hOι : IsOpenImmersion O.ι := inferInstanceAs (IsOpenImmersion (w.left ⁻¹ᵁ Ub).ι)
  have hmemO : ∀ τ : W.left, τ ∈ O ↔ ∀ i, W.hom τ ≠ S i (IsLocalRing.closedPoint K) := by
    intro τ
    show w.left τ ∈ Ub ↔ _
    rw [hUb, hwhom]
  have hrangeO : Set.range O.ι = {τ : W.left | ∀ i, W.hom τ ≠ S i (IsLocalRing.closedPoint K)} := by
    rw [Scheme.Opens.range_ι]
    ext τ
    exact hmemO τ
  have hιmem : ∀ y : O.toScheme, ∀ i, W.hom (O.ι y) ≠ S i (IsLocalRing.closedPoint K) := by
    intro y
    have : O.ι y ∈ Set.range O.ι := ⟨y, rfl⟩
    rw [hrangeO] at this
    exact this

  haveI hWp : WeaklyEtale W.hom := W.prop
  haveI hOe : WeaklyEtale O.ι := by
    first
    | infer_instance
    | exact etale_le_weaklyEtale _ inferInstance
  haveI : WeaklyEtale (O.ι ≫ W.hom) := inferInstance
  let W' : (wcP1Over K).left.ProEt := Scheme.ProEt.mk (O.ι ≫ W.hom)
  let ι : W' ⟶ W := MorphismProperty.Over.homMk O.ι rfl trivial

  haveI hOqc : QuasiCompact O.ι :=
    MorphismProperty.of_isPullback (P := @QuasiCompact) (isPullback_morphismRestrict w.left Ub)
      hUbqc
  haveI := hqc
  have hqc' : QuasiCompact (ι ≫ w).left := by
    show QuasiCompact (O.ι ≫ w.left)
    infer_instance

  have hoff' : ∀ (z : W'.left) (i : Fin m), W'.hom z ≠ S i (IsLocalRing.closedPoint K) := by
    intro z i
    have h0 := hιmem z i
    rw [← Scheme.Hom.comp_apply O.ι W.hom z] at h0
    exact h0

  have hcov' : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left,
      (∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ z : W'.left, (ι ≫ w).left z = p := by
    intro p hp
    obtain ⟨z, hz⟩ := hsurj p hp
    have hzO : z ∈ Set.range O.ι := by
      rw [hrangeO]
      intro i
      rw [← hwhom, hz]
      exact hp i
    obtain ⟨z', hz'⟩ := hzO
    refine ⟨z', ?_⟩
    show (O.ι ≫ w.left) z' = p
    rw [Scheme.Hom.comp_apply, hz', hz]

  have hlift : ∀ (V : (wcP1Over K).left.ProEt) (a : V ⟶ W),
      (∀ (z : V.left) (i : Fin m), V.hom z ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ a' : V ⟶ W', a' ≫ ι = a := by
    intro V a hV
    have H : Set.range a.left ⊆ Set.range O.ι := by
      rintro _ ⟨y, rfl⟩
      rw [hrangeO]
      intro i
      rw [← Scheme.Hom.comp_apply a.left W.hom, MorphismProperty.Over.w a]
      exact hV y i
    obtain ⟨l, hl⟩ : ∃ l : V.left ⟶ O.toScheme, l ≫ O.ι = a.left :=
      ⟨@IsOpenImmersion.lift _ _ _ O.ι a.left hOι H,
        @IsOpenImmersion.lift_fac _ _ _ O.ι a.left hOι H⟩
    refine ⟨MorphismProperty.Over.homMk l (by
        show l ≫ O.ι ≫ W.hom = V.hom
        rw [← Category.assoc, hl, MorphismProperty.Over.w a]) trivial, ?_⟩
    apply MorphismProperty.Over.Hom.ext
    exact hl
  have hres : ∀ γ : W ⟶ W, ∃ γ' : W' ⟶ W', γ' ≫ ι = ι ≫ γ :=
    fun γ => hlift W' (ι ≫ γ) hoff'

  have hmono : ∀ (V : (wcP1Over K).left.ProEt) (a b : V ⟶ W'), a ≫ ι = b ≫ ι → a = b := by
    intro V a b hab
    apply MorphismProperty.Over.Hom.ext
    have h1 := congrArg (fun f => f.left) hab
    change a.left ≫ O.ι = b.left ≫ O.ι at h1
    exact (cancel_mono O.ι).mp h1

  have s4 : ∀ {X : Type u} [TopologicalSpace X] [ConnectedSpace X] (Z : Set X),
      (∀ x : X, ∃ y ∈ Z, y ⤳ x) →
      (∀ x : X, ∃ O : Set X, IsOpen O ∧ x ∈ O ∧ ∀ U U' : Set X, IsOpen U → IsOpen U' →
        O ∩ Z ⊆ U ∪ U' → O ∩ Z ∩ U ∩ U' = ∅ →
        ∃ C : Set X, IsOpen C ∧ IsOpen (O \ C) ∧ C ⊆ O ∧ C ∩ Z = O ∩ Z ∩ U) →
      _root_.IsConnected Z := by
    intro X _ _ Z h1 h2
    obtain ⟨x₀⟩ := (inferInstance : Nonempty X)
    obtain ⟨y₀, hy₀, -⟩ := h1 x₀
    refine ⟨⟨y₀, hy₀⟩, ?_⟩
    rw [isPreconnected_iff_subset_of_disjoint]
    intro U U' hU hU' hZU hZUU
    choose O hO hxO hC using h2
    have hpre1 : ∀ x, O x ∩ Z ⊆ U ∪ U' := fun x => fun y hy => hZU hy.2
    have hpre2 : ∀ x, O x ∩ Z ∩ U ∩ U' = ∅ := by
      intro x
      refine Set.subset_empty_iff.mp ?_
      rintro y ⟨⟨⟨_, hyZ⟩, hyU⟩, hyU'⟩
      have : y ∈ Z ∩ (U ∩ U') := ⟨hyZ, hyU, hyU'⟩
      rw [hZUU] at this
      exact this
    choose C hCo hOC hCO hCZ using fun x => hC x U U' hU hU' (hpre1 x) (hpre2 x)
    let A : Set X := {x | ∀ y ∈ Z, y ⤳ x → y ∈ U}
    have hsub : ∀ x, x ∈ C x → C x ⊆ A := by
      intro x _ x' hx' y hyZ hyx'
      have hyC : y ∈ C x := hyx'.mem_open (hCo x) hx'
      have : y ∈ C x ∩ Z := ⟨hyC, hyZ⟩
      rw [hCZ x] at this
      exact this.2
    have hAC : ∀ x ∈ A, x ∈ C x := by
      intro x hx
      by_contra hxC
      obtain ⟨y, hyZ, hyx⟩ := h1 x
      have hyOC : y ∈ O x \ C x := hyx.mem_open (hOC x) ⟨hxO x, hxC⟩
      have hyU : y ∈ U := hx y hyZ hyx
      have : y ∈ O x ∩ Z ∩ U := ⟨⟨hyOC.1, hyZ⟩, hyU⟩
      rw [← hCZ x] at this
      exact hyOC.2 this.1
    have hAopen : IsOpen A := by
      rw [isOpen_iff_forall_mem_open]
      intro x hx
      exact ⟨C x, hsub x (hAC x hx), hCo x, hAC x hx⟩
    have hnotA : ∀ x, x ∉ A → x ∉ C x := by
      intro x hx hxC
      exact hx (hsub x hxC hxC)
    have hAcopen : IsOpen Aᶜ := by
      rw [isOpen_iff_forall_mem_open]
      intro x hx
      refine ⟨O x \ C x, ?_, hOC x, ⟨hxO x, hnotA x hx⟩⟩
      intro x' hx' hx'A
      obtain ⟨y', hy'Z, hy'x'⟩ := h1 x'
      have hy'OC : y' ∈ O x \ C x := hy'x'.mem_open (hOC x) hx'
      have hy'U : y' ∈ U := hx'A y' hy'Z hy'x'
      have : y' ∈ O x ∩ Z ∩ U := ⟨⟨hy'OC.1, hy'Z⟩, hy'U⟩
