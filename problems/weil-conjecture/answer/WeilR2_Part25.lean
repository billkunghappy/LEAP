    refine ⟨QuasiCompact.compactSpace_of_compactSpace ψ.hom, ?_⟩
    have e0 : Limits.terminal.from Z = ψ.hom ≫ (T.hom ⁻¹ᵁ wcCritPunctOpen D i).ι ≫
