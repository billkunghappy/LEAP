      | exact SurjectiveOnStalks.stalkMap_surjective j xb
  have hmax : IsLocalRing.maximalIdeal ((Limits.pullback D.Yt.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))).presheaf.stalk
