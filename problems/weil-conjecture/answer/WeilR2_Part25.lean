  have hθφ : (θ V₀).inv ≫ L.map (wcFreeSheafMap (wcP1Over F'').left φ₀) =
      wcFreeSheafMap D.Yt.left ((wcProEtPullback D.f).map φ₀) ≫ (θ V₀).inv := by
    rw [Iso.inv_comp_eq, ← Category.assoc, ← hθ φ₀, Category.assoc, Iso.hom_inv_id,
      Category.comp_id]

  let Ψ : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V₀) (wcRq D.f ℓ k) 0 →+
      wcCoh K (Over.mk (Limits.pullback.snd D.f t)) hX ℓ k :=
    ((Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f t) β.inv)).precomp
      (wcLadicSheaf (Limits.pullback D.f t) ℓ) (zero_add k)).comp
      (R.comp (((Abelian.Ext.mk₀ (θ V₀).inv).precomp (wcLadicSheaf D.Yt.left ℓ)
        (zero_add k)).comp Λ.toAddMonoidHom))
  have hΨ : ∀ y, Ψ y = (Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f t) β.inv)).comp
      (R ((Abelian.Ext.mk₀ (θ V₀).inv).comp (Λ y) (zero_add k))) (zero_add k) := fun y => rfl
  refine ⟨Ψ, ?_, ?_, ?_⟩
  ·
    have b1 : Function.Bijective (fun w : Abelian.Ext (L.obj (wcFreeSheaf (wcP1Over F'').left V₀))
        (wcLadicSheaf D.Yt.left ℓ) k => (Abelian.Ext.mk₀ (θ V₀).inv).comp w (zero_add k)) := by
      refine Function.bijective_iff_has_inverse.mpr
        ⟨fun w => (Abelian.Ext.mk₀ (θ V₀).hom).comp w (zero_add k), ?_, ?_⟩
      · intro w
        simp only
        rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
      · intro w
        simp only
        rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
    have b2 : Function.Bijective (fun w : Abelian.Ext (wcFreeSheaf (Limits.pullback D.f t)
        ((wcProEtPullback (Limits.pullback.fst D.f t)).obj ((wcProEtPullback D.f).obj V₀)))
        (wcLadicSheaf (Limits.pullback D.f t) ℓ) k =>
        (Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f t) β.inv)).comp w
          (zero_add k)) := by
      refine Function.bijective_iff_has_inverse.mpr
        ⟨fun w => (Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f t) β.hom)).comp w
          (zero_add k), ?_, ?_⟩
      · intro w
        simp only
        rw [Abelian.Ext.mk₀_comp_mk₀_assoc, ← F0, Iso.hom_inv_id, Fid, Abelian.Ext.mk₀_id_comp]
      · intro w
        simp only
        rw [Abelian.Ext.mk₀_comp_mk₀_assoc, ← F0, Iso.inv_hom_id, Fid, Abelian.Ext.mk₀_id_comp]
    exact b2.comp (hRbij.comp (b1.comp Λ.bijective))
  ·
    intro c y
    rw [hΨ, hΨ]
    show _ = ((Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f t) β.inv)).comp
      (R ((Abelian.Ext.mk₀ (θ V₀).inv).comp (Λ y) (zero_add k))) (zero_add k)).comp
        (Abelian.Ext.mk₀ (wcLadicScalar (Limits.pullback D.f t) ℓ c)) (add_zero k)
    have h1 : Λ (y.comp (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ k c)) (add_zero 0)) =
