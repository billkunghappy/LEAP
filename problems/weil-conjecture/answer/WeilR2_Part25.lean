    ∃ t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op (wcGeomPoint F'' (wcP1Over F'') hP)),
      ∀ z : W.left,
        wcContEval (wcP1Over F'').left W ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom
          (((wcRq D.f ℓ (n - 1)).obj.map w.op).hom t)) z = v :=
by
  classical
  have hF : ∀ {A B C : (wcP1Over F'').left.ProEt} (k : A ⟶ B) (m' : B ⟶ C)
      (y : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op C)),
      ((wcRq D.f ℓ (n - 1)).obj.map k.op).hom (((wcRq D.f ℓ (n - 1)).obj.map m'.op).hom y) =
        ((wcRq D.f ℓ (n - 1)).obj.map (k ≫ m').op).hom y := by
    intro A B C k m' y
    rw [op_comp, Functor.map_comp]
    rfl
  have hid : ∀ {A : (wcP1Over F'').left.ProEt} (y : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op A)),
      ((wcRq D.f ℓ (n - 1)).obj.map (𝟙 A).op).hom y = y := by
    intro A y
    rw [op_id, CategoryTheory.Functor.map_id]
    rfl
  have hCext : ∀ (V : (wcP1Over F'').left.ProEt)
      (f₁ f₂ : (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op V)),
      (∀ z, wcContEval (wcP1Over F'').left V f₁ z = wcContEval (wcP1Over F'').left V f₂ z) →
        f₁ = f₂ := by
    intro V f₁ f₂ h
    have : (show ULift.{u+1} C(↥V.left, Fin r → ℚ_[ℓ]) from f₁) =
        (show ULift.{u+1} C(↥V.left, Fin r → ℚ_[ℓ]) from f₂) :=
      ULift.ext _ _ (ContinuousMap.ext h)
    exact this
  have hN0 : ∀ (V V' : (wcP1Over F'').left.ProEt) (k : V' ⟶ V) (h' : V ⟶ W)
      (y : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)),
      (θ.hom.hom.app (Opposite.op (Over.mk (k ≫ h')))).hom
          (((wcRq D.f ℓ (n - 1)).obj.map k.op).hom y) =
        ((wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).obj.map k.op).hom
          ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom y) := by
    intro V V' k h' y
    exact congrArg (fun φ => φ.hom y)
      (θ.hom.hom.naturality (Over.homMk (U := Over.mk (k ≫ h')) (V := Over.mk h') k rfl).op)
  have hN : ∀ (V V' : (wcP1Over F'').left.ProEt) (k : V' ⟶ V) (h' : V ⟶ W)
      (y : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)) (z : V'.left),
      wcContEval (wcP1Over F'').left V' ((θ.hom.hom.app (Opposite.op (Over.mk (k ≫ h')))).hom
          (((wcRq D.f ℓ (n - 1)).obj.map k.op).hom y)) z =
        wcContEval (wcP1Over F'').left V ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom y)
          (k.left z) := by
    intro V V' k h' y z
    rw [hN0]
    rfl
  have hI : ∀ (V : (wcP1Over F'').left.ProEt) (h' : V ⟶ W)
      (a b : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)),
      (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom a =
        (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom b → a = b := by
    intro V h' a b hab
    have ha : (θ.inv.hom.app (Opposite.op (Over.mk h'))).hom
        ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom a) = a :=
      congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk h'))).hom a) θ.hom_inv_id
    have hb : (θ.inv.hom.app (Opposite.op (Over.mk h'))).hom
        ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom b) = b :=
      congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk h'))).hom b) θ.hom_inv_id
    rw [← ha, ← hb, hab]

  have hfix : ∀ (V : (wcP1Over F'').left.ProEt) (h₁ h₂ : V ⟶ W)
      (x : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)),
      (∀ z : V.left, wcContEval (wcP1Over F'').left V
        ((θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x) z ∈ Submodule.span ℚ_[ℓ] {v}) →
      h₁ ≫ w = h₂ ≫ w → ∀ z : V.left,
        wcContEval (wcP1Over F'').left V ((θ.hom.hom.app (Opposite.op (Over.mk h₂))).hom x) z =
          wcContEval (wcP1Over F'').left V
            ((θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x) z := by
    intro V h₁ h₂ x hU hw z
    obtain ⟨V₁, k, z₁, hV₁, hk⟩ := wc_proet_connected_nbhd (wcP1Over F'').left V z
    have hab : (k ≫ h₁) ≫ w = (k ≫ h₂) ≫ w := by
      rw [Category.assoc, Category.assoc, hw]
    obtain ⟨γ, hγ, hb⟩ := hgal V₁ (k ≫ h₁) (k ≫ h₂) hV₁ hab
    obtain ⟨A, hA⟩ :=
      wc_proet_deck_frame_linear (wcP1Over F'').left ℓ (wcRq D.f ℓ (n - 1)) W hconn r θ γ
    have hAv : A v = v :=
      hv γ hγ A (fun s z' => hA W (𝟙 W) γ (Category.id_comp γ).symm s z')
    have e1 : wcContEval (wcP1Over F'').left V
        ((θ.hom.hom.app (Opposite.op (Over.mk h₂))).hom x) z =
        A (wcContEval (wcP1Over F'').left V
          ((θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x) z) := by
      rw [← hk, ← hN V V₁ k h₂ x z₁, ← hN V V₁ k h₁ x z₁]
      exact hA V₁ (k ≫ h₁) (k ≫ h₂) hb _ z₁
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp (hU z)
    rw [e1, ← hc, LinearMap.map_smul, hAv]

  have hex : ∀ (V : (wcP1Over F'').left.ProEt) (h : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP),
      (∀ (z : V.left) (i : Fin D.m), V.hom z ≠ D.S i (IsLocalRing.closedPoint F'')) →
      ∃ x : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V),
        ∀ (V'' : (wcP1Over F'').left.ProEt) (h'' : V'' ⟶ V) (h' : V'' ⟶ W), h' ≫ w = h'' ≫ h →
          ∀ z : V''.left, wcContEval (wcP1Over F'').left V''
            ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom
              (((wcRq D.f ℓ (n - 1)).obj.map h''.op).hom x)) z = v := by
    intro V h hV
    have hlift : ∀ z : V.left, ∃ p : W.left, w.left p = h.left z := by
      intro z
      have e : (wcGeomPoint F'' (wcP1Over F'') hP).hom (h.left z) = V.hom z := by
        rw [← MorphismProperty.Over.w h, Scheme.Hom.comp_apply]
      apply hcov
      intro i
      rw [e]
      exact hV z i
    obtain ⟨x, hx⟩ := wc_kss_descend_section (wcP1Over F'').left ℓ
      (wcGeomPoint F'' (wcP1Over F'') hP) W w hqc (wcRq D.f ℓ (n - 1)) r θ
      (Submodule.span ℚ_[ℓ] {v}) hfix V h hlift
      (show (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op V) from
        ULift.up (ContinuousMap.const ↥V.left v))
      (fun _ => Submodule.mem_span_singleton_self v)
    refine ⟨x, fun V'' h'' h' hc z => ?_⟩
    rw [hx V'' h'' h' hc]
    rfl
  have huniq : ∀ (V : (wcP1Over F'').left.ProEt) (g : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP),
      (∀ (z : V.left) (i : Fin D.m), V.hom z ≠ D.S i (IsLocalRing.closedPoint F'')) →
      ∀ a b : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V),
      (∀ (V'' : (wcP1Over F'').left.ProEt) (h'' : V'' ⟶ V) (h' : V'' ⟶ W), h' ≫ w = h'' ≫ g →
        ∀ z : V''.left, wcContEval (wcP1Over F'').left V''
          ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom
            (((wcRq D.f ℓ (n - 1)).obj.map h''.op).hom a)) z = v) →
      (∀ (V'' : (wcP1Over F'').left.ProEt) (h'' : V'' ⟶ V) (h' : V'' ⟶ W), h' ≫ w = h'' ≫ g →
        ∀ z : V''.left, wcContEval (wcP1Over F'').left V''
          ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom
            (((wcRq D.f ℓ (n - 1)).obj.map h''.op).hom b)) z = v) →
      a = b := by
    intro V g hV a b ha hb
    have hd := wc_proet_detect_through_cover F'' hP D.m D.S W w hqc hcov (wcRq D.f ℓ (n - 1))
      V g (a - b)
      (fun V'' h'' h' hc => by
        have e : ((wcRq D.f ℓ (n - 1)).obj.map h''.op).hom a =
            ((wcRq D.f ℓ (n - 1)).obj.map h''.op).hom b :=
          hI V'' h' _ _ (hCext V'' _ _
            (fun z => (ha V'' h'' h' hc z).trans (hb V'' h'' h' hc z).symm))
        rw [map_sub, e, sub_self])
      V (𝟙 V) hV
    rw [hid] at hd
    exact sub_eq_zero.mp hd
  choose xs hxs using hex
  have hcomp : ∀ (V V' : (wcP1Over F'').left.ProEt) (k : V' ⟶ V)
      (h : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
      (hV : ∀ (v : V.left) (i : Fin D.m), V.hom v ≠ D.S i (IsLocalRing.closedPoint F''))
      (hV' : ∀ (v : V'.left) (i : Fin D.m), V'.hom v ≠ D.S i (IsLocalRing.closedPoint F'')),
      ((wcRq D.f ℓ (n - 1)).obj.map k.op).hom (xs V h hV) = xs V' (k ≫ h) hV' := by
    intro V V' k h hV hV'
    apply huniq V' (k ≫ h) hV'
    · intro V'' h'' h' hc z
      rw [hF h'' k]
      exact hxs V h hV V'' (h'' ≫ k) h' (by rw [hc, Category.assoc]) z
    · exact hxs V' (k ≫ h) hV'

  obtain ⟨t, ht⟩ := wc_pencil_Rq_extend_off_crit F' F'' Y n hn hn2 D ℓ hℓ hP
    (wcGeomPoint F'' (wcP1Over F'') hP) (𝟙 _) xs hcomp

  refine ⟨t, fun z => ?_⟩
  rw [ht W w hoff]
  have e := hxs W w hoff W (𝟙 W) (𝟙 W) rfl z
  rw [hid] at e
  exact e

theorem wc_pencil_R_perp_GC_sub (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (M : Subobject (wcRq D.f ℓ (n - 1))) (hMs : wcPencilStable D ℓ M)
    (hMc : wcPencilGC F'' hP ℓ (Limits.cokernel M.arrow))
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
    (hconn : ConnectedSpace W.left)
    (hcov : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left,
      (∀ i : Fin D.m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠ D.S i (IsLocalRing.closedPoint F'')) →
      ∃ z : W.left, w.left z = p)
    (a k : ℕ)
    (θR : (wcRq D.f ℓ (n - 1)).over W ≅ (wcContSheaf (wcP1Over F'').left (Fin a → ℚ_[ℓ])).over W)
    (θM : (Subobject.underlying.obj M).over W ≅
      (wcContSheaf (wcP1Over F'').left (Fin k → ℚ_[ℓ])).over W) :
    ∃ (M' : Subobject (wcRq D.f ℓ (n - 1))) (c : ℕ), wcPencilStable D ℓ M' ∧
      Nonempty ((Subobject.underlying.obj M').over (wcGeomPoint F'' (wcP1Over F'') hP) ≅
        (wcContSheaf (wcP1Over F'').left (Fin c → ℚ_[ℓ])).over (wcGeomPoint F'' (wcP1Over F'') hP)) ∧
      a ≤ k + c :=
by
  classical

  obtain ⟨W₀, w₀, r₀, θ₀, hθc, hqc, hconn₀, hoff, hcov₀, hgal⟩ :=
    wc_pencil_PL_galois_cover F' F'' Y n hn hn2 D ℓ hℓ hP
  obtain ⟨J, -, hJu, hJinv⟩ := wc_pencil_PL_cup_form F' F'' Y n hn hn2 D ℓ hℓ hP W₀ w₀ r₀ θ₀
    hθc hqc hconn₀ hoff hcov₀ hgal
  haveI := hconn₀
  obtain ⟨z₀⟩ : Nonempty W₀.left := ConnectedSpace.toNonempty

  choose ψ hψ using hMs
  obtain ⟨b, ⟨ρQ⟩⟩ := hMc
  have hR₀ : wcScalarTriv (wcP1Over F'').left ℓ (wcRq D.f ℓ (n - 1)) (wcRqScalar D.f ℓ (n - 1))
      W₀ r₀ := ⟨θ₀, hθc⟩
  obtain ⟨k₀, hk₀⟩ := wc_scalarTriv_sub_of_coker_const (wcP1Over F'').left ℓ W₀ hconn₀
    (wcRq D.f ℓ (n - 1)) (Subobject.underlying.obj M) (wcRqScalar D.f ℓ (n - 1)) ψ r₀ hR₀
    M.arrow hψ
    (Or.inr ⟨b, ⟨((Scheme.ProEt.topology (wcP1Over F'').left).overMapPullback
      AddCommGrpCat.{u+1} w₀).mapIso ρQ⟩⟩)
  unfold wcScalarTriv at hk₀
  obtain ⟨θM₀, -⟩ := hk₀

  obtain ⟨L, hL, hLinj'⟩ := wc_proet_over_frame_hom_linear (wcP1Over F'').left ℓ W₀ hconn₀
    (Subobject.underlying.obj M) (wcRq D.f ℓ (n - 1)) M.arrow k₀ r₀ θM₀ θ₀
  have hLinj : Function.Injective L := hLinj' inferInstance

  obtain ⟨k', q, θ', -, hqker, hq⟩ := wc_proet_coker_frame_of_linear (wcP1Over F'').left ℓ W₀
    (Subobject.underlying.obj M) (wcRq D.f ℓ (n - 1)) M.arrow k₀ r₀ θM₀ θ₀ L hLinj hL

  let ρW : (Limits.cokernel M.arrow).over W₀ ≅
      (wcContSheaf (wcP1Over F'').left (Fin b → ℚ_[ℓ])).over W₀ :=
    ((Scheme.ProEt.topology (wcP1Over F'').left).overMapPullback
      AddCommGrpCat.{u+1} w₀).mapIso ρQ
  obtain ⟨LQ, hLQ, hLQinj'⟩ := wc_proet_over_frame_hom_linear (wcP1Over F'').left ℓ W₀ hconn₀
    (Limits.cokernel M.arrow) (Limits.cokernel M.arrow) (𝟙 _) k' b θ' ρW
  have hLQinj : Function.Injective LQ := hLQinj' inferInstance
  have hkey : ∀ (h h' : W₀ ⟶ wcGeomPoint F'' (wcP1Over F'') hP), h = h' →
      ∀ (x : (Limits.cokernel M.arrow).obj.obj (Opposite.op W₀)) (z : W₀.left),
      wcContEval (wcP1Over F'').left W₀ ((ρQ.hom.hom.app (Opposite.op (Over.mk h))).hom x) z =
      wcContEval (wcP1Over F'').left W₀ ((ρQ.hom.hom.app (Opposite.op (Over.mk h'))).hom x) z := by
    rintro h h' rfl x z
    rfl
  have hs5 : ∀ γ : W₀ ⟶ W₀, γ ≫ w₀ = w₀ →
      ∀ (x : (Limits.cokernel M.arrow).obj.obj (Opposite.op W₀)) (z : W₀.left),
      wcContEval (wcP1Over F'').left W₀ ((θ'.hom.hom.app (Opposite.op (Over.mk γ))).hom x) z =
      wcContEval (wcP1Over F'').left W₀
        ((θ'.hom.hom.app (Opposite.op (Over.mk (𝟙 W₀)))).hom x) z := by
    intro γ hγ x z
    apply hLQinj
    have hmk : γ ≫ w₀ = 𝟙 W₀ ≫ w₀ := by rw [hγ, Category.id_comp]
    have e1 := hLQ (Over.mk γ) x z
    have e2 := hLQ (Over.mk (𝟙 W₀)) x z
    calc LQ (wcContEval (wcP1Over F'').left W₀ ((θ'.hom.hom.app (Opposite.op (Over.mk γ))).hom x) z)
        = wcContEval (wcP1Over F'').left W₀
            ((ρQ.hom.hom.app (Opposite.op (Over.mk (γ ≫ w₀)))).hom x) z := e1.symm
      _ = wcContEval (wcP1Over F'').left W₀
            ((ρQ.hom.hom.app (Opposite.op (Over.mk (𝟙 W₀ ≫ w₀)))).hom x) z := hkey _ _ hmk x z
      _ = LQ (wcContEval (wcP1Over F'').left W₀
            ((θ'.hom.hom.app (Opposite.op (Over.mk (𝟙 W₀)))).hom x) z) := e2

  have hdeck : ∀ γ : W₀ ⟶ W₀, γ ≫ w₀ = w₀ →
      ∀ g : (Fin r₀ → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r₀ → ℚ_[ℓ]),
      (∀ (s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op W₀)) (z : W₀.left),
        wcContEval (wcP1Over F'').left W₀ ((θ₀.hom.hom.app (Opposite.op (Over.mk γ))).hom s) z =
          g (wcContEval (wcP1Over F'').left W₀
            ((θ₀.hom.hom.app (Opposite.op (Over.mk (𝟙 W₀)))).hom s) z)) →
      ∀ v, g v - v ∈ LinearMap.range L := by
    intro γ hγ g hfr v
    let cv : (wcContSheaf (wcP1Over F'').left (Fin r₀ → ℚ_[ℓ])).obj.obj (Opposite.op W₀) :=
      (show (wcContSheaf (wcP1Over F'').left (Fin r₀ → ℚ_[ℓ])).obj.obj (Opposite.op W₀) from
        ULift.up (ContinuousMap.const ↥W₀.left v))
    have hsv : (θ₀.hom.hom.app (Opposite.op (Over.mk (𝟙 W₀)))).hom
        ((θ₀.inv.hom.app (Opposite.op (Over.mk (𝟙 W₀)))).hom cv) = cv :=
      congrArg (fun m => (m.hom.app (Opposite.op (Over.mk (𝟙 W₀)))).hom cv) θ₀.inv_hom_id
    obtain ⟨sv, hsvd⟩ : ∃ s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op W₀),
        wcContEval (wcP1Over F'').left W₀
          ((θ₀.hom.hom.app (Opposite.op (Over.mk (𝟙 W₀)))).hom s) z₀ = v :=
      ⟨(θ₀.inv.hom.app (Opposite.op (Over.mk (𝟙 W₀)))).hom cv, by rw [hsv]; rfl⟩
    have a1 : wcContEval (wcP1Over F'').left W₀
        ((θ₀.hom.hom.app (Opposite.op (Over.mk γ))).hom sv) z₀ = g v := by
      rw [hfr, hsvd]
    have e1 := hq (Over.mk γ) sv z₀
    have e2 := hq (Over.mk (𝟙 W₀)) sv z₀
    have hqq : q (g v) = q v := by
      calc q (g v) = q (wcContEval (wcP1Over F'').left W₀
            ((θ₀.hom.hom.app (Opposite.op (Over.mk γ))).hom sv) z₀) := by rw [a1]
        _ = wcContEval (wcP1Over F'').left W₀ ((θ'.hom.hom.app (Opposite.op (Over.mk γ))).hom
              (((Limits.cokernel.π M.arrow).hom.app (Opposite.op W₀)).hom sv)) z₀ := e1.symm
        _ = wcContEval (wcP1Over F'').left W₀
              ((θ'.hom.hom.app (Opposite.op (Over.mk (𝟙 W₀)))).hom
              (((Limits.cokernel.π M.arrow).hom.app (Opposite.op W₀)).hom sv)) z₀ := hs5 γ hγ _ z₀
        _ = q (wcContEval (wcP1Over F'').left W₀
              ((θ₀.hom.hom.app (Opposite.op (Over.mk (𝟙 W₀)))).hom sv) z₀) := e2
        _ = q v := by rw [hsvd]
    rw [← hqker, LinearMap.mem_ker, map_sub, hqq, sub_self]

  have hJinj : Function.Injective J.mulVec :=
    Matrix.mulVec_injective_iff_isUnit.mpr ((Matrix.isUnit_iff_isUnit_det J).mpr hJu)
  have hzero : ∀ w' : Fin r₀ → ℚ_[ℓ], (∀ x : Fin r₀ → ℚ_[ℓ], dotProduct x w' = 0) → w' = 0 := by
    intro w' hw
    funext i
    have h := hw (Pi.single i 1)
    rw [single_dotProduct, one_mul] at h
    exact h
  have hfixF : ∀ γ : W₀ ⟶ W₀, γ ≫ w₀ = w₀ →
      ∀ g : (Fin r₀ → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r₀ → ℚ_[ℓ]),
      (∀ (s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op W₀)) (z : W₀.left),
        wcContEval (wcP1Over F'').left W₀ ((θ₀.hom.hom.app (Opposite.op (Over.mk γ))).hom s) z =
          g (wcContEval (wcP1Over F'').left W₀
            ((θ₀.hom.hom.app (Opposite.op (Over.mk (𝟙 W₀)))).hom s) z)) →
      ∀ y ∈ (Matrix.toBilin' J).orthogonal (LinearMap.range L), g y = y := by
    intro γ hγ g hfr y hy
    have hiso := hJinv γ hγ g hfr
    have hU := hdeck γ hγ g hfr
    have hisoF : ∀ x x' : Fin r₀ → ℚ_[ℓ],
        dotProduct (g x) (J.mulVec (g x')) = dotProduct x (J.mulVec x') := by
      intro x x'
      rw [← LinearMap.toMatrix'_mulVec g x, ← LinearMap.toMatrix'_mulVec g x']
      conv_rhs => rw [← hiso]
      rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, Matrix.dotProduct_mulVec x,
        Matrix.vecMul_transpose]
    have hginj : Function.Injective g := by
      rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
      intro x hx
      apply hJinj
      rw [Matrix.mulVec_zero]
      apply hzero
      intro x'
      rw [← hisoF x' x, hx, Matrix.mulVec_zero, dotProduct_zero]
    have hgsurj : Function.Surjective g := LinearMap.injective_iff_surjective.mp hginj
    apply sub_eq_zero.mp
    apply hJinj
    rw [Matrix.mulVec_zero]
    apply hzero
    intro x
    obtain ⟨x', rfl⟩ := hgsurj x
    have h2 : (Matrix.toBilin' J) (g x' - x') y = 0 :=
      (LinearMap.BilinForm.mem_orthogonal_iff.mp hy) _ (hU x')
    rw [Matrix.toBilin'_apply', sub_dotProduct] at h2
    rw [Matrix.mulVec_sub, dotProduct_sub, hisoF x' y]
    linear_combination -h2
  have hnd : (Matrix.toBilin' J).Nondegenerate :=
    Matrix.nondegenerate_toBilin'_iff.mpr (Matrix.nondegenerate_iff_det_ne_zero.mpr hJu.ne_zero)
  have hdimF : Module.finrank ℚ_[ℓ] ((Matrix.toBilin' J).orthogonal (LinearMap.range L)) +
      Module.finrank ℚ_[ℓ] (LinearMap.range L) = r₀ := by
    have h2 := LinearMap.BilinForm.finrank_orthogonal hnd (LinearMap.range L)
    have h3 := Submodule.finrank_le (LinearMap.range L)
    rw [Module.finrank_fin_fun] at h2 h3
    omega
  have hdimU : Module.finrank ℚ_[ℓ] (LinearMap.range L) = k₀ := by
    rw [LinearMap.finrank_range_of_inj hLinj, Module.finrank_fin_fun]

  obtain ⟨C, hCs, hCgc, hCmax⟩ := wc_pencil_GC_max_exists F' F'' Y n hn hn2 D ℓ hℓ hP
  obtain ⟨c, ⟨ρC⟩⟩ := hCgc
  let θC : (Subobject.underlying.obj C).over W₀ ≅
      (wcContSheaf (wcP1Over F'').left (Fin c → ℚ_[ℓ])).over W₀ :=
    ((Scheme.ProEt.topology (wcP1Over F'').left).overMapPullback
      AddCommGrpCat.{u+1} w₀).mapIso ρC
  obtain ⟨LC, hLC, hLCinj'⟩ := wc_proet_over_frame_hom_linear (wcP1Over F'').left ℓ W₀ hconn₀
    (Subobject.underlying.obj C) (wcRq D.f ℓ (n - 1)) C.arrow c r₀ θC θ₀
  have hLCinj : Function.Injective LC := hLCinj' inferInstance
  obtain ⟨ev, hev, -⟩ := wc_free_ext0_eval (wcP1Over F'').left
  have hFle : (Matrix.toBilin' J).orthogonal (LinearMap.range L) ≤ LinearMap.range LC := by
    intro y hy
    obtain ⟨t, ht⟩ := wc_pencil_Rq_fixed_global_section F' F'' Y n hn hn2 D ℓ hℓ hP W₀ w₀ r₀ θ₀
      hqc hconn₀ hoff hcov₀ hgal y (fun γ hγ g hfr => hfixF γ hγ g hfr y hy)
    obtain ⟨My, hMys, hMygc, y', hy'⟩ := wc_pencil_Rq_H0_GC_span F' F'' Y n hn hn2 D ℓ hℓ hP
      ((ev (wcGeomPoint F'' (wcP1Over F'') hP) (wcRq D.f ℓ (n - 1))).symm t)
    have hle := hCmax My hMys hMygc
    have ht2 : (My.arrow.hom.app (Opposite.op (wcGeomPoint F'' (wcP1Over F'') hP))).hom
        (ev (wcGeomPoint F'' (wcP1Over F'') hP) (Subobject.underlying.obj My) y') = t := by
      have h1 := hev (wcGeomPoint F'' (wcP1Over F'') hP) (Subobject.underlying.obj My)
        (wcRq D.f ℓ (n - 1)) My.arrow y'
      have h2 : (Abelian.Ext.mk₀ My.arrow).postcomp
          (wcFreeSheaf (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP)) (add_zero 0) y' =
          (ev (wcGeomPoint F'' (wcP1Over F'') hP) (wcRq D.f ℓ (n - 1))).symm t := hy'.symm
      rw [h2, AddEquiv.apply_symm_apply] at h1
      exact h1.symm
    obtain ⟨t', ht'⟩ : ∃ t' : (Subobject.underlying.obj C).obj.obj
        (Opposite.op (wcGeomPoint F'' (wcP1Over F'') hP)),
        (C.arrow.hom.app (Opposite.op (wcGeomPoint F'' (wcP1Over F'') hP))).hom t' = t := by
      refine ⟨((Subobject.ofLE My C hle).hom.app
        (Opposite.op (wcGeomPoint F'' (wcP1Over F'') hP))).hom
          (ev (wcGeomPoint F'' (wcP1Over F'') hP) (Subobject.underlying.obj My) y'), ?_⟩
      have h3 := congrArg (fun f : Subobject.underlying.obj My ⟶ wcRq D.f ℓ (n - 1) =>
        (f.hom.app (Opposite.op (wcGeomPoint F'' (wcP1Over F'') hP))).hom
          (ev (wcGeomPoint F'' (wcP1Over F'') hP) (Subobject.underlying.obj My) y'))
        (Subobject.ofLE_arrow hle)
      exact h3.trans ht2
    have hN := C.arrow.hom.naturality w₀.op
    have hx : (C.arrow.hom.app (Opposite.op W₀)).hom
        (((Subobject.underlying.obj C).obj.map w₀.op).hom t') =
        ((wcRq D.f ℓ (n - 1)).obj.map w₀.op).hom t := by
      have h4 := congrArg (fun f : (Subobject.underlying.obj C).obj.obj
          (Opposite.op (wcGeomPoint F'' (wcP1Over F'') hP)) ⟶
          (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op W₀) => f.hom t') hN
      exact h4.trans (congrArg (fun s => ((wcRq D.f ℓ (n - 1)).obj.map w₀.op).hom s) ht')
    have e := hLC (Over.mk (𝟙 W₀)) (((Subobject.underlying.obj C).obj.map w₀.op).hom t') z₀
    refine LinearMap.mem_range.mpr ⟨wcContEval (wcP1Over F'').left W₀
      ((θC.hom.hom.app (Opposite.op (Over.mk (𝟙 W₀)))).hom
        (((Subobject.underlying.obj C).obj.map w₀.op).hom t')) z₀, ?_⟩
    calc LC (wcContEval (wcP1Over F'').left W₀
          ((θC.hom.hom.app (Opposite.op (Over.mk (𝟙 W₀)))).hom
            (((Subobject.underlying.obj C).obj.map w₀.op).hom t')) z₀)
        = wcContEval (wcP1Over F'').left W₀ ((θ₀.hom.hom.app (Opposite.op (Over.mk (𝟙 W₀)))).hom
            ((C.arrow.hom.app (Opposite.op W₀)).hom
              (((Subobject.underlying.obj C).obj.map w₀.op).hom t'))) z₀ := e.symm
      _ = wcContEval (wcP1Over F'').left W₀ ((θ₀.hom.hom.app (Opposite.op (Over.mk (𝟙 W₀)))).hom
            (((wcRq D.f ℓ (n - 1)).obj.map w₀.op).hom t)) z₀ := by rw [hx]
      _ = y := ht z₀
  have hdimC : Module.finrank ℚ_[ℓ] ((Matrix.toBilin' J).orthogonal (LinearMap.range L)) ≤ c := by
    have h1 := Submodule.finrank_mono hFle
    rw [LinearMap.finrank_range_of_inj hLCinj, Module.finrank_fin_fun] at h1
    exact h1

  obtain ⟨V₀, g₀, -, A, iR, iH, iS, e, -, hv0, -, -, -⟩ :=
    wc_P1bar_strict_local_nbhd F'' D.u0 D.hu0 hP
  letI := iR
  haveI := iH
  haveI := iS
  have hx₀ : (wcGeomPoint F'' (wcP1Over F'') hP).hom (g₀.left (e.inv (IsLocalRing.closedPoint A))) =
      V₀.hom (e.inv (IsLocalRing.closedPoint A)) := by
    rw [← MorphismProperty.Over.w g₀, Scheme.Hom.comp_apply]
  have hoffx : ∀ i : Fin D.m, (wcGeomPoint F'' (wcP1Over F'') hP).hom
      (g₀.left (e.inv (IsLocalRing.closedPoint A))) ≠ D.S i (IsLocalRing.closedPoint F'') := by
    intro i
    rw [hx₀, hv0]
    exact D.hu0S i
  obtain ⟨z, hz⟩ := hcov _ hoffx
  obtain ⟨z', hz'⟩ := hcov₀ _ hoffx
  obtain ⟨ι, -⟩ := wc_P1bar_strict_local_lift F'' hP W w V₀ g₀ A e ⟨z, hz⟩
  obtain ⟨ι₀, -⟩ := wc_P1bar_strict_local_lift F'' hP W₀ w₀ V₀ g₀ A e ⟨z', hz'⟩
  obtain ⟨V₁, k₁, -, hV₁, -⟩ :=
    wc_proet_connected_nbhd (wcP1Over F'').left V₀ (e.inv (IsLocalRing.closedPoint A))
  obtain ⟨L1, -, hL1⟩ := wc_proet_over_frame_hom_linear (wcP1Over F'').left ℓ V₁ hV₁
    (wcRq D.f ℓ (n - 1)) (wcRq D.f ℓ (n - 1)) (𝟙 _) a r₀
    (((Scheme.ProEt.topology (wcP1Over F'').left).overMapPullback
      AddCommGrpCat.{u+1} (k₁ ≫ ι)).mapIso θR)
    (((Scheme.ProEt.topology (wcP1Over F'').left).overMapPullback
      AddCommGrpCat.{u+1} (k₁ ≫ ι₀)).mapIso θ₀)
  obtain ⟨L2, -, hL2⟩ := wc_proet_over_frame_hom_linear (wcP1Over F'').left ℓ V₁ hV₁
    (Subobject.underlying.obj M) (Subobject.underlying.obj M) (𝟙 _) k₀ k
    (((Scheme.ProEt.topology (wcP1Over F'').left).overMapPullback
      AddCommGrpCat.{u+1} (k₁ ≫ ι₀)).mapIso θM₀)
    (((Scheme.ProEt.topology (wcP1Over F'').left).overMapPullback
      AddCommGrpCat.{u+1} (k₁ ≫ ι)).mapIso θM)
  have ha : a ≤ r₀ := by
    have h := LinearMap.finrank_le_finrank_of_injective (hL1 inferInstance)
    rw [Module.finrank_fin_fun, Module.finrank_fin_fun] at h
    exact h
  have hk : k₀ ≤ k := by
    have h := LinearMap.finrank_le_finrank_of_injective (hL2 inferInstance)
    rw [Module.finrank_fin_fun, Module.finrank_fin_fun] at h
    exact h

  refine ⟨C, c, hCs, ⟨ρC⟩, ?_⟩
  omega

theorem wc_scalarTriv_sub_of_plain_triv (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (W : S.ProEt) (hW : ConnectedSpace W.left)
    (G X : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (σG : ℚ_[ℓ] → (G ⟶ G)) (σX : ℚ_[ℓ] → (X ⟶ X)) (a k : ℕ)
    (hG : wcScalarTriv S ℓ G σG W a) (m : X ⟶ G) [Mono m]
    (hm : ∀ c : ℚ_[ℓ], σX c ≫ m = m ≫ σG c)
    (hX : Nonempty (X.over W ≅ (wcContSheaf S (Fin k → ℚ_[ℓ])).over W)) :
    wcScalarTriv S ℓ X σX W k :=
by
  classical
  obtain ⟨tG, htG⟩ := hG
  obtain ⟨θ⟩ := hX
  set ρ := (Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W with hρ
  have hm0 := Abelian.monoIsKernelOfCokernel _ (Limits.cokernelIsCokernel m)
  have hmρ := Limits.KernelFork.mapIsLimit _ hm0 ρ
  haveI : Mono (ρ.map m) := Limits.Fork.IsLimit.mono hmρ
  obtain ⟨J, hJ⟩ : ∃ J : (Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin a → ℚ_[ℓ]),
      θ.inv ≫ ρ.map m ≫ tG.hom =
        ρ.map (wcContSheafMap S J.toAddMonoidHom (LinearMap.continuous_of_finiteDimensional J)) :=
    wc_contSheaf_over_hom_linear S ℓ W hW k a _
  have hTmono : Mono (θ.inv ≫ ρ.map m ≫ tG.hom) := inferInstance
  have key : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]
      (f : A →+ B) (hf : Continuous f) (U : (S.ProEt)ᵒᵖ)
      (x : ((wcContSheaf S A).obj.obj U : Type (u+1))),
      (wcContSheafMap S f hf).hom.app U x =
        (ULift.up (AddMonoidHom.compLeftContinuous
          (↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj
            (Opposite.unop U))) f hf
          (ULift.down x : C(↥((Scheme.ProEt.forget S ⋙
            Over.forget S).obj (Opposite.unop U)), A))) : _) := by
    intro A B _ _ _ _ _ _ f hf U x
    rfl
  have hscal : ∀ c : ℚ_[ℓ],
      wcContSheafMap S J.toAddMonoidHom (LinearMap.continuous_of_finiteDimensional J) ≫
        wcConstScalar S ℓ a c = wcConstScalar S ℓ k c ≫
          wcContSheafMap S J.toAddMonoidHom (LinearMap.continuous_of_finiteDimensional J) := by
    intro c
    unfold wcConstScalar
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    simp only [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app,
      CategoryTheory.comp_apply, key]
    apply ULift.ext
    apply ContinuousMap.ext
    intro z
    exact (J.map_smul c _).symm
  refine ⟨θ, fun c => ?_⟩
  apply (cancel_mono (θ.inv ≫ ρ.map m ≫ tG.hom)).1
  have hLHS : (ρ.map (σX c) ≫ θ.hom) ≫ (θ.inv ≫ ρ.map m ≫ tG.hom) =
      ρ.map m ≫ tG.hom ≫ ρ.map (wcConstScalar S ℓ a c) := by
    rw [Category.assoc, Iso.hom_inv_id_assoc, ← Functor.map_comp_assoc, hm c,
      Functor.map_comp_assoc, htG c]
  have hRHS : (θ.hom ≫ ρ.map (wcConstScalar S ℓ k c)) ≫ (θ.inv ≫ ρ.map m ≫ tG.hom) =
      ρ.map m ≫ tG.hom ≫ ρ.map (wcConstScalar S ℓ a c) := by
    rw [hJ, Category.assoc, ← Functor.map_comp, ← hscal c, Functor.map_comp, ← hJ,
      ← Category.assoc, ← Category.assoc, Iso.hom_inv_id, Category.id_comp, Category.assoc]
  exact hLHS.trans hRHS.symm

theorem wc_vqm_hz_EC_rank_ge (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    ∀ (V : (wcP1Over F'').left.ProEt) (A : Type u) [CommRing A] [HenselianLocalRing A]
      [IsSepClosed (IsLocalRing.ResidueField A)] (e : V.left ≅ Spec (.of A)),
      IsClosed ({V.hom (e.inv (IsLocalRing.closedPoint A))} : Set (wcP1Over F'').left) →
      (∀ i, V.hom (e.inv (IsLocalRing.closedPoint A)) ≠ D.S i (IsLocalRing.closedPoint F'')) →
      ∃ (a : ℕ) (eR : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V) ≃+ (Fin a → ℚ_[ℓ])),
        (∀ (c : ℚ_[ℓ]) (y : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)),
          eR (((wcRqScalar D.f ℓ (n - 1) c).hom.app (Opposite.op V)).hom y) = c • eR y) ∧
        ∃ UE UC : Submodule ℚ_[ℓ] (Fin a → ℚ_[ℓ]),
          (∀ v, v ∈ UE ↔ ∃ z : (Subobject.underlying.obj (wcPencilE D ℓ hP)).obj.obj (Opposite.op V),
            eR (((wcPencilE D ℓ hP).arrow.hom.app (Opposite.op V)).hom z) = v) ∧
          (∀ v, v ∈ UC ↔ ∃ c : (Subobject.underlying.obj (wcPencilC D ℓ hP)).obj.obj (Opposite.op V),
            eR (((wcPencilC D ℓ hP).arrow.hom.app (Opposite.op V)).hom c) = v) ∧
          a ≤ Module.finrank ℚ_[ℓ] UE + Module.finrank ℚ_[ℓ] UC :=
by
  classical
  intro V A _ _ _ e _ hoff
  obtain ⟨ev, hev, -⟩ := wc_free_ext0_eval (wcP1Over F'').left
  have hevs : ∀ {G H : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      (g : G ⟶ H) (s : G.obj.obj (Opposite.op V)),
      (ev V H).symm ((g.hom.app (Opposite.op V)).hom s) =
        (Abelian.Ext.mk₀ g).postcomp (wcFreeSheaf (wcP1Over F'').left V) (add_zero 0)
          ((ev V G).symm s) := by
    intro G H g s
    apply (ev V H).injective
    rw [AddEquiv.apply_symm_apply, hev, AddEquiv.apply_symm_apply]

  have hpp : ∀ {A B C : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      (f : A ⟶ B) (g : B ⟶ C) (y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V) A 0),
      (Abelian.Ext.mk₀ g).postcomp (wcFreeSheaf (wcP1Over F'').left V) (add_zero 0)
          ((Abelian.Ext.mk₀ f).postcomp (wcFreeSheaf (wcP1Over F'').left V) (add_zero 0) y) =
        (Abelian.Ext.mk₀ (f ≫ g)).postcomp (wcFreeSheaf (wcP1Over F'').left V)
          (add_zero 0) y := by
    intro A B C f g y
    show (y.comp (Abelian.Ext.mk₀ f) (add_zero 0)).comp (Abelian.Ext.mk₀ g) (add_zero 0) =
      y.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero 0)
    rw [Abelian.Ext.comp_assoc y (Abelian.Ext.mk₀ f) (Abelian.Ext.mk₀ g) (add_zero 0)
      (add_zero 0) (by omega), Abelian.Ext.mk₀_comp_mk₀]
  have hpost : ∀ {A B' : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      (g : A ⟶ B') (f : wcFreeSheaf (wcP1Over F'').left V ⟶ A),
      (Abelian.Ext.mk₀ g).postcomp (wcFreeSheaf (wcP1Over F'').left V) (add_zero 0)
        (Abelian.Ext.mk₀ f) = Abelian.Ext.mk₀ (f ≫ g) := by
    intro A B' g f
    show (Abelian.Ext.mk₀ f).comp (Abelian.Ext.mk₀ g) (add_zero 0) = _
    exact Abelian.Ext.mk₀_comp_mk₀ f g
  have hinj : ∀ {A B' : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      (g : A ⟶ B') [Mono g],
      Function.Injective ((Abelian.Ext.mk₀ g).postcomp
        (wcFreeSheaf (wcP1Over F'').left V) (add_zero 0)) := by
    intro A B' g _ y y' h
    rw [← Abelian.Ext.mk₀_homEquiv₀_apply y, ← Abelian.Ext.mk₀_homEquiv₀_apply y',
      hpost, hpost] at h
    have h' := (Abelian.Ext.mk₀_bijective _ _).1 h
    rw [← Abelian.Ext.mk₀_homEquiv₀_apply y, ← Abelian.Ext.mk₀_homEquiv₀_apply y',
      (cancel_mono g).mp h']

  obtain ⟨W, w, a, hconn, hcov, hRW⟩ :=
    wc_pencil_Rq_scalar_triv_cover F' F'' Y n D ℓ hℓ hP (n - 1)
  obtain ⟨bR, hbR, -⟩ := wc_proet_scalarTriv_stalk_basis (wcP1Over F'').left ℓ
    (wcRq D.f ℓ (n - 1)) (wcRqScalar D.f ℓ (n - 1)) a V A e (𝟙 V)
    (wc_proet_scalarTriv_strict_local F'' hP ℓ (wcRq D.f ℓ (n - 1))
      (wcRqScalar D.f ℓ (n - 1)) a D.m D.S D.hS W w hcov hRW V A e hoff)
  let eR : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V) ≃+ (Fin a → ℚ_[ℓ]) :=
    (ev V (wcRq D.f ℓ (n - 1))).symm.trans bR
  have heR : ∀ y, eR y = bR ((ev V (wcRq D.f ℓ (n - 1))).symm y) := fun _ => rfl
  have hscal : ∀ (c : ℚ_[ℓ]) (y : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)),
      eR (((wcRqScalar D.f ℓ (n - 1) c).hom.app (Opposite.op V)).hom y) = c • eR y := by
    intro c y
    rw [heR, heR, hevs, hbR]

  have transl : ∀ (X : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1})
      (m : X ⟶ wcRq D.f ℓ (n - 1)) (v : Fin a → ℚ_[ℓ]),
      (∃ z : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V) X 0,
        bR ((Abelian.Ext.mk₀ m).postcomp (wcFreeSheaf (wcP1Over F'').left V) (add_zero 0) z) = v) ↔
      (∃ s : X.obj.obj (Opposite.op V), eR ((m.hom.app (Opposite.op V)).hom s) = v) := by
    intro X m v
    constructor
    · rintro ⟨z, rfl⟩
      refine ⟨ev V X z, ?_⟩
      rw [heR, hevs, AddEquiv.symm_apply_apply]
    · rintro ⟨s, rfl⟩
      refine ⟨(ev V X).symm s, ?_⟩
      rw [heR, hevs]

  have img : ∀ (X : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1})
      (m : X ⟶ wcRq D.f ℓ (n - 1)) (σX : ℚ_[ℓ] → (X ⟶ X))
      (hm : ∀ c : ℚ_[ℓ], σX c ≫ m = m ≫ wcRqScalar D.f ℓ (n - 1) c),
      ∃ U : Submodule ℚ_[ℓ] (Fin a → ℚ_[ℓ]), ∀ v, v ∈ U ↔
        ∃ z : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V) X 0,
          bR ((Abelian.Ext.mk₀ m).postcomp (wcFreeSheaf (wcP1Over F'').left V)
            (add_zero 0) z) = v := by
    intro X m σX hm
    refine ⟨{ carrier := {v | ∃ z : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V) X 0,
                bR ((Abelian.Ext.mk₀ m).postcomp (wcFreeSheaf (wcP1Over F'').left V)
                  (add_zero 0) z) = v}
              zero_mem' := ⟨0, by simp only [map_zero]⟩
              add_mem' := by
                rintro _ _ ⟨z, rfl⟩ ⟨z', rfl⟩
                exact ⟨z + z', by simp only [map_add]⟩
              smul_mem' := by
                rintro c _ ⟨z, rfl⟩
                rw [Set.mem_setOf_eq]
                refine ⟨(Abelian.Ext.mk₀ (σX c)).postcomp
                  (wcFreeSheaf (wcP1Over F'').left V) (add_zero 0) z, ?_⟩
                rw [hpp, hm, ← hpp, hbR] }, fun v => Iff.rfl⟩

  have sub : ∀ (X : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1})
      (m : X ⟶ wcRq D.f ℓ (n - 1)) [Mono m] (σX : ℚ_[ℓ] → (X ⟶ X))
      (hm : ∀ c : ℚ_[ℓ], σX c ≫ m = m ≫ wcRqScalar D.f ℓ (n - 1) c)
      (U : Submodule ℚ_[ℓ] (Fin a → ℚ_[ℓ]))
      (hU : ∀ v, v ∈ U ↔ ∃ z : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V) X 0,
          bR ((Abelian.Ext.mk₀ m).postcomp (wcFreeSheaf (wcP1Over F'').left V)
            (add_zero 0) z) = v) (k : ℕ)
      (b : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V) X 0 ≃+ (Fin k → ℚ_[ℓ]))
      (hb : ∀ (c : ℚ_[ℓ]) (y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V) X 0),
        b ((Abelian.Ext.mk₀ (σX c)).postcomp (wcFreeSheaf (wcP1Over F'').left V)
          (add_zero 0) y) = c • b y),
      Module.finrank ℚ_[ℓ] U = k := by
    intro X m _ σX hm U hU k b hb
    have hbs : ∀ (c : ℚ_[ℓ]) (v : Fin k → ℚ_[ℓ]), b.symm (c • v) =
        (Abelian.Ext.mk₀ (σX c)).postcomp (wcFreeSheaf (wcP1Over F'').left V)
          (add_zero 0) (b.symm v) := fun c v =>
      b.injective (by rw [hb, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
    let L : (Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin a → ℚ_[ℓ]) :=
      { toFun := fun v => bR ((Abelian.Ext.mk₀ m).postcomp
          (wcFreeSheaf (wcP1Over F'').left V) (add_zero 0) (b.symm v))
        map_add' := fun v w => by simp only [map_add]
        map_smul' := fun c v => by
          simp only [RingHom.id_apply]
          rw [hbs, hpp, hm, ← hpp, hbR] }
    have hLapp : ∀ v, L v = bR ((Abelian.Ext.mk₀ m).postcomp
        (wcFreeSheaf (wcP1Over F'').left V) (add_zero 0) (b.symm v)) := fun v => rfl
    have hL : Function.Injective L := by
      intro v w h
      rw [hLapp, hLapp] at h
      exact b.symm.injective (hinj m (bR.injective h))
    have hUL : U = LinearMap.range L := by
      ext v
      rw [hU, LinearMap.mem_range]
      constructor
      · rintro ⟨z, rfl⟩
        exact ⟨b z, by rw [hLapp, AddEquiv.symm_apply_apply]⟩
      · rintro ⟨u, rfl⟩
        exact ⟨b.symm u, (hLapp u).symm⟩
    rw [hUL, LinearMap.finrank_range_of_inj hL, Module.finrank_fin_fun]

  have stabE : wcPencilStable D ℓ (wcPencilE D ℓ hP) := by
    unfold wcPencilE
    split_ifs with h
    · exact (Classical.choose_spec h).1
    · intro c
      exact ⟨(⊤ : Subobject (wcRq D.f ℓ (n - 1))).factorThru
        ((⊤ : Subobject (wcRq D.f ℓ (n - 1))).arrow ≫ wcRqScalar D.f ℓ (n - 1) c)
        (Subobject.top_factors _), Subobject.factorThru_arrow _ _ _⟩
  have stabC : wcPencilStable D ℓ (wcPencilC D ℓ hP) := by
    unfold wcPencilC
    split_ifs with h
    · exact (Classical.choose_spec h).1
    · intro c
      exact ⟨(⊤ : Subobject (wcRq D.f ℓ (n - 1))).factorThru
        ((⊤ : Subobject (wcRq D.f ℓ (n - 1))).arrow ≫ wcRqScalar D.f ℓ (n - 1) c)
        (Subobject.top_factors _), Subobject.factorThru_arrow _ _ _⟩
  choose ψE hψE using stabE
  choose ψC hψC using stabC
  obtain ⟨UE, hUE⟩ := img _ (wcPencilE D ℓ hP).arrow ψE hψE
  obtain ⟨UC, hUC⟩ := img _ (wcPencilC D ℓ hP).arrow ψC hψC

  have hlow : a ≤ Module.finrank ℚ_[ℓ] UE + Module.finrank ℚ_[ℓ] UC := by
    by_cases hEc : ∃ M : Subobject (wcRq D.f ℓ (n - 1)), wcPencilStable D ℓ M ∧
        wcPencilGC F'' hP ℓ (Limits.cokernel M.arrow) ∧
        ∀ M' : Subobject (wcRq D.f ℓ (n - 1)), wcPencilStable D ℓ M' →
          wcPencilGC F'' hP ℓ (Limits.cokernel M'.arrow) → M ≤ M'
    · have hE : wcPencilE D ℓ hP = Classical.choose hEc := dif_pos hEc
      have hgc : wcPencilGC F'' hP ℓ (Limits.cokernel (wcPencilE D ℓ hP).arrow) := by
        rw [hE]; exact (Classical.choose_spec hEc).2.1
      have restr : ∀ (G : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}),
          wcPencilGC F'' hP ℓ G → ∃ b : ℕ,
            Nonempty (G.over W ≅ (wcContSheaf (wcP1Over F'').left (Fin b → ℚ_[ℓ])).over W) := by
        intro G hG
        obtain ⟨b, ⟨θ⟩⟩ := hG
        exact ⟨b, ⟨((Scheme.ProEt.topology (wcP1Over F'').left).overMapPullback
          AddCommGrpCat.{u+1} w).mapIso θ⟩⟩
      obtain ⟨k, hEW⟩ := wc_scalarTriv_sub_of_coker_const (wcP1Over F'').left ℓ W hconn
        (wcRq D.f ℓ (n - 1)) (Subobject.underlying.obj (wcPencilE D ℓ hP))
        (wcRqScalar D.f ℓ (n - 1)) ψE a hRW (wcPencilE D ℓ hP).arrow hψE
        (Or.inr (restr _ hgc))
      have hEW' := hEW
      unfold wcScalarTriv at hEW'
      obtain ⟨θM, -⟩ := hEW'
      have hRW' := hRW
      unfold wcScalarTriv at hRW'
      obtain ⟨θR, -⟩ := hRW'
      obtain ⟨M', c, hM's, ⟨θ'⟩, hac⟩ := wc_pencil_R_perp_GC_sub F' F'' Y n hn hn2 D ℓ hℓ hP
        (wcPencilE D ℓ hP) (fun c => ⟨ψE c, hψE c⟩) hgc W w hconn hcov a k θR θM
      have hCex := wc_pencil_GC_max_exists F' F'' Y n hn hn2 D ℓ hℓ hP
      have hC : wcPencilC D ℓ hP = Classical.choose hCex := dif_pos hCex
      have hle : M' ≤ wcPencilC D ℓ hP := by
        rw [hC]; exact (Classical.choose_spec hCex).2.2 M' hM's ⟨c, ⟨θ'⟩⟩
      choose ψ' hψ' using hM's
      have hM'W := wc_scalarTriv_sub_of_plain_triv (wcP1Over F'').left ℓ W hconn
        (wcRq D.f ℓ (n - 1)) (Subobject.underlying.obj M') (wcRqScalar D.f ℓ (n - 1)) ψ' a c
        hRW M'.arrow hψ'
        ⟨((Scheme.ProEt.topology (wcP1Over F'').left).overMapPullback
          AddCommGrpCat.{u+1} w).mapIso θ'⟩
      obtain ⟨bE, hbE, -⟩ := wc_proet_scalarTriv_stalk_basis (wcP1Over F'').left ℓ
        (Subobject.underlying.obj (wcPencilE D ℓ hP)) ψE k V A e (𝟙 V)
        (wc_proet_scalarTriv_strict_local F'' hP ℓ (Subobject.underlying.obj (wcPencilE D ℓ hP))
          ψE k D.m D.S D.hS W w hcov hEW V A e hoff)
      obtain ⟨b', hb', -⟩ := wc_proet_scalarTriv_stalk_basis (wcP1Over F'').left ℓ
        (Subobject.underlying.obj M') ψ' c V A e (𝟙 V)
        (wc_proet_scalarTriv_strict_local F'' hP ℓ (Subobject.underlying.obj M')
          ψ' c D.m D.S D.hS W w hcov hM'W V A e hoff)
      have hdE := sub _ (wcPencilE D ℓ hP).arrow ψE hψE UE hUE k bE hbE
      obtain ⟨U', hU'⟩ := img _ M'.arrow ψ' hψ'
      have hd' := sub _ M'.arrow ψ' hψ' U' hU' c b' hb'
      have hU'C : U' ≤ UC := by
        intro v hv
        obtain ⟨z, rfl⟩ := (hU' v).1 hv
        rw [hUC]
        refine ⟨(Abelian.Ext.mk₀ (Subobject.ofLE M' (wcPencilC D ℓ hP) hle)).postcomp
          (wcFreeSheaf (wcP1Over F'').left V) (add_zero 0) z, ?_⟩
        rw [hpp, Subobject.ofLE_arrow]
      have hfin := Submodule.finrank_mono hU'C
      omega
    · have hE : wcPencilE D ℓ hP = ⊤ := dif_neg hEc
      have hiso : IsIso (wcPencilE D ℓ hP).arrow := by
        rw [hE]
        infer_instance
      have htop : UE = ⊤ := by
        rw [eq_top_iff]
        intro v _
        rw [hUE]
        refine ⟨Abelian.Ext.mk₀ (Abelian.Ext.homEquiv₀ (bR.symm v) ≫
          inv (wcPencilE D ℓ hP).arrow), ?_⟩
        rw [hpost, Category.assoc, IsIso.inv_hom_id, Category.comp_id,
          Abelian.Ext.mk₀_homEquiv₀_apply, AddEquiv.apply_symm_apply]
      have hfin : Module.finrank ℚ_[ℓ] UE = a := by
        rw [htop, finrank_top, Module.finrank_fin_fun]
      omega
  exact ⟨a, eR, hscal, UE, UC, fun v => (hUE v).trans (transl _ _ v),
    fun v => (hUC v).trans (transl _ _ v), hlow⟩

theorem wc_proet_geomConst_restrict_injective (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (B V : S.ProEt) (h : V ⟶ B)
    (r : ℕ) (θ : G.over B ≅ (wcContSheaf S (Fin r → ℚ_[ℓ])).over B)
    (hB : ConnectedSpace B.left) (hV : Nonempty V.left) :
    Function.Injective (G.obj.map h.op).hom :=
by
  classical

  have hconst : ∀ (f : C(B.left, Fin r → ℚ_[ℓ])) (x y : B.left), f x = f y := by
    intro f x y
    haveI : PreconnectedSpace B.left := hB.toPreconnectedSpace
    exact (isPreconnected_range f.continuous).subsingleton
      (Set.mem_range_self x) (Set.mem_range_self y)

  let Xh : Over B := Over.mk h
  let XB : Over B := Over.mk (𝟙 B)
  let hX : Xh ⟶ XB := Over.homMk h (Category.comp_id h)
  let τV : G.obj.obj (Opposite.op V) ≃+ ULift.{u+1} C(V.left, Fin r → ℚ_[ℓ]) :=
    (((sheafToPresheaf _ _).mapIso θ).app (Opposite.op Xh)).addCommGroupIsoToAddEquiv
  let τB : G.obj.obj (Opposite.op B) ≃+ ULift.{u+1} C(B.left, Fin r → ℚ_[ℓ]) :=
    (((sheafToPresheaf _ _).mapIso θ).app (Opposite.op XB)).addCommGroupIsoToAddEquiv

  have key : ∀ c : G.obj.obj (Opposite.op B),
      (τV ((G.obj.map h.op).hom c)).down = (τB c).down.comp h.left.base.hom := by
    intro c
    exact congrArg ULift.down
      (congrArg (fun f => AddCommGrpCat.Hom.hom f c) (θ.hom.hom.naturality hX.op))

  intro c₁ c₂ hc
  obtain ⟨v⟩ := hV
  have e1 : (τV ((G.obj.map h.op).hom c₁)).down v = (τV ((G.obj.map h.op).hom c₂)).down v := by
    rw [hc]
  rw [key, key, ContinuousMap.comp_apply, ContinuousMap.comp_apply] at e1
  apply τB.injective
  apply ULift.ext
  apply ContinuousMap.ext
  intro x
  rw [hconst (τB c₁).down x (h.left.base.hom v), e1, hconst (τB c₂).down (h.left.base.hom v) x]

theorem wc_vqm_hz_VQ_pairing (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (B : ∀ V : (wcP1Over F'').left.ProEt,
      (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V) →+
        (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V) →+
          (wcRq D.f ℓ (2 * (n - 1))).obj.obj (Opposite.op V))
    (hBnat : ∀ (V V' : (wcP1Over F'').left.ProEt) (a : V' ⟶ V)
