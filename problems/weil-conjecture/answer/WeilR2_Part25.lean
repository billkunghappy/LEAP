          (AlgebraicClosure ((wcP1Over K).left.residueField x)) _ _ _).symm :
            AlgebraicClosure ((wcP1Over K).left.residueField x) →+*
              AlgebraicClosure ((wcP1Over K).left.residueField x))) ≫
