theorem wc_pencil_E2_two_fibre (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hX : WeaklyEtale (Limits.pullback.fst (Over.mk (Limits.pullback.snd D.f D.u0)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (α : AlgebraicClosure ℚ_[ℓ])
    (hα : wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - 2)) 2 (wcRqScalar D.f ℓ (n - 2) c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - 2)) 2) α) :
    ∃ γ : AlgebraicClosure ℚ_[ℓ],
      wcIsEigen ℓ (wcCohScalar F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2))
        (wcCohFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2)) γ ∧
      α = algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) (Nat.card F'' : ℚ_[ℓ]) * γ :=
by
  classical
  set f : ℚ_[ℓ] →+* AlgebraicClosure ℚ_[ℓ] := algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) with hf
  have hext : ∀ {m k : ℕ} (M N : Matrix (Fin m) (Fin k) ℚ_[ℓ]),
      (∀ v, M.mulVec v = N.mulVec v) → M = N := by
    intro m k M N h
    apply Matrix.toLin'.injective
    apply LinearMap.ext
    intro v
    rw [Matrix.toLin'_apply, Matrix.toLin'_apply, h v]
  have hdiag : ∀ {m : ℕ} (K : Type) [CommRing K] (c : K) (v : Fin m → K),
      (Matrix.diagonal fun _ => c).mulVec v = c • v := by
    intro m K _ c v
    ext i
    rw [Matrix.mulVec_diagonal]
    rfl
  have mk : ∀ {V W : Type (u+1)} [AddCommGroup V] [AddCommGroup W] {r r' : ℕ}
      (eV : V ≃+ (Fin r → ℚ_[ℓ])) (eW : W ≃+ (Fin r' → ℚ_[ℓ]))
      (sV : ℚ_[ℓ] → V →+ V) (sW : ℚ_[ℓ] → W →+ W),
      (∀ c x, eV (sV c x) = c • eV x) → (∀ c y, eW (sW c y) = c • eW y) →
      ∀ (ψ : V →+ W), (∀ c x, ψ (sV c x) = sW c (ψ x)) →
      ∃ M : Matrix (Fin r') (Fin r) ℚ_[ℓ], (∀ v, M.mulVec v = eW (ψ (eV.symm v))) ∧
        ∀ a b, M a b = eW (ψ (eV.symm (Pi.single b 1))) a := by
    intro V W _ _ r r' eV eW sV sW heV heW ψ hψ
    have hes : ∀ (c : ℚ_[ℓ]) (v : Fin r → ℚ_[ℓ]), eV.symm (c • v) = sV c (eV.symm v) :=
      fun c v => eV.injective (by rw [heV, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
    let L : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r' → ℚ_[ℓ]) :=
      { toFun := fun v => eW (ψ (eV.symm v))
        map_add' := fun v w => by simp only [map_add]
        map_smul' := fun c v => by simp only [hes, hψ, heW, RingHom.id_apply] }
    refine ⟨LinearMap.toMatrix' L, fun v => LinearMap.toMatrix'_mulVec L v, fun a b => ?_⟩
    rw [LinearMap.toMatrix'_apply]
    rfl
  have eig : ∀ {r : ℕ} (M : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (α : AlgebraicClosure ℚ_[ℓ]),
      α ∈ M.charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) →
      ∃ v : Fin r → AlgebraicClosure ℚ_[ℓ], v ≠ 0 ∧ (M.map f).mulVec v = α • v := by
    intro r M α hα
    rw [Polynomial.mem_aroots] at hα
    obtain ⟨_, hα⟩ := hα
    have hdet : (Matrix.scalar (Fin r) α - M.map f).det = 0 := by
      rw [← Matrix.eval_charpoly, Matrix.charpoly_map, Polynomial.eval_map, ← Polynomial.aeval_def]
      exact hα
    obtain ⟨v, hv0, hv⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
    refine ⟨v, hv0, ?_⟩
    rw [Matrix.sub_mulVec, sub_eq_zero] at hv
    rw [← hv, Matrix.scalar_apply, hdiag]
  have root : ∀ {r : ℕ} (M : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (α : AlgebraicClosure ℚ_[ℓ])
      (v : Fin r → AlgebraicClosure ℚ_[ℓ]), v ≠ 0 → (M.map f).mulVec v = α • v →
      α ∈ M.charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) := by
    intro r M α v hv0 hMv
    have hdet : (Matrix.scalar (Fin r) α - M.map f).det = 0 := by
      apply Matrix.exists_mulVec_eq_zero_iff.mp
      refine ⟨v, hv0, ?_⟩
      rw [Matrix.sub_mulVec, hMv, Matrix.scalar_apply, hdiag, sub_self]
    rw [Polynomial.mem_aroots]
    refine ⟨(Matrix.charpoly_monic M).ne_zero, ?_⟩
    rw [Polynomial.aeval_def, ← Polynomial.eval_map, ← Matrix.charpoly_map, Matrix.eval_charpoly]
    exact hdet

  have s6 : ∀ {W' W : Type (u+1)} [AddCommGroup W'] [AddCommGroup W] {r' r : ℕ}
      (eW' : W' ≃+ (Fin r' → ℚ_[ℓ])) (eW : W ≃+ (Fin r → ℚ_[ℓ]))
      (sW' : ℚ_[ℓ] → W' →+ W') (sW : ℚ_[ℓ] → W →+ W) (ΦW' : W' →+ W') (ΦW : W →+ W),
      (∀ c z, eW' (sW' c z) = c • eW' z) → (∀ c y, eW (sW c y) = c • eW y) →
      (∀ c z, ΦW' (sW' c z) = sW' c (ΦW' z)) → (∀ c y, ΦW (sW c y) = sW c (ΦW y)) →
      ∀ (γ : W' →+ W), Function.Surjective γ → (∀ c z, γ (sW' c z) = sW c (γ z)) →
      ∀ (c : ℚ_[ℓ]), c ≠ 0 → (∀ z, ΦW (γ z) = sW c (γ (ΦW' z))) →
      ∀ α ∈ (wcAddEquivMatrix eW ΦW).charpoly.aroots (AlgebraicClosure ℚ_[ℓ]),
      ∃ β ∈ (wcAddEquivMatrix eW' ΦW').charpoly.aroots (AlgebraicClosure ℚ_[ℓ]), α = f c * β := by
    intro W' W _ _ r' r eW' eW sW' sW ΦW' ΦW heW' heW hΦW' hΦW γ hγ hγs c hc hγΦ α hα
    obtain ⟨C, hCv, hCe⟩ := mk eW' eW' sW' sW' heW' heW' ΦW' hΦW'
    obtain ⟨B, hBv, hBe⟩ := mk eW eW sW sW heW heW ΦW hΦW
    obtain ⟨G, hGv, -⟩ := mk eW' eW sW' sW heW' heW γ hγs
    have hC : wcAddEquivMatrix eW' ΦW' = C := by
      ext a b
      rw [hCe]
      rfl
    have hB : wcAddEquivMatrix eW ΦW = B := by
      ext a b
      rw [hBe]
      rfl
    rw [hB] at hα
    rw [hC]
    have hBG : B * G = c • (G * C) := hext _ _ (fun z => by
      rw [Matrix.smul_mulVec, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, hGv, hBv, hCv, hGv,
        AddEquiv.symm_apply_apply, AddEquiv.symm_apply_apply, hγΦ, heW])
    have hGinj : ∀ w : Fin r → ℚ_[ℓ], Matrix.vecMul w G = 0 → w = 0 := by
      intro w hw
      funext i
      obtain ⟨z', hz'⟩ := hγ (eW.symm (Pi.single i 1))
      have h1 : G.mulVec (eW' z') = Pi.single i 1 := by
        rw [hGv, AddEquiv.symm_apply_apply, hz', AddEquiv.apply_symm_apply]
      have h2 := Matrix.dotProduct_mulVec w G (eW' z')
      rw [h1, hw, zero_dotProduct, dotProduct_single, mul_one] at h2
      exact h2
    set Gt := G.transpose with hGt
    have hker : LinearMap.ker (Matrix.toLin' Gt) = ⊥ := by
      rw [LinearMap.ker_eq_bot']
      intro w hw
      rw [Matrix.toLin'_apply, hGt, Matrix.mulVec_transpose] at hw
      exact hGinj w hw
    obtain ⟨g, hg⟩ := LinearMap.exists_leftInverse_of_injective _ hker
    have hHG : LinearMap.toMatrix' g * Gt = 1 := by
      have := congrArg LinearMap.toMatrix' hg
      rwa [LinearMap.toMatrix'_comp, LinearMap.toMatrix'_toLin', LinearMap.toMatrix'_id] at this
    have hHGL : (LinearMap.toMatrix' g).map f * Gt.map f = 1 := by
      rw [← Matrix.map_mul, hHG, Matrix.map_one _ (map_zero f) (map_one f)]
    have hrel : Gt * B.transpose = c • (C.transpose * Gt) := by
      rw [hGt, ← Matrix.transpose_mul, hBG, Matrix.transpose_smul, Matrix.transpose_mul]
    have hsm : ∀ M : Matrix (Fin r') (Fin r) ℚ_[ℓ], (c • M).map f = f c • M.map f := by
      intro M
      ext x y
      rw [Matrix.map_apply, Matrix.smul_apply, Matrix.smul_apply, Matrix.map_apply, smul_eq_mul,
        smul_eq_mul, map_mul]
    have hrelL : Gt.map f * B.transpose.map f = f c • (C.transpose.map f * Gt.map f) := by
      rw [← Matrix.map_mul, hrel, hsm, Matrix.map_mul]
    rw [← Matrix.charpoly_transpose] at hα
    obtain ⟨w, hw0, hw⟩ := eig B.transpose α hα
    have hy0 : (Gt.map f).mulVec w ≠ 0 := by
      intro h0
      apply hw0
      have e1 : ((LinearMap.toMatrix' g).map f).mulVec ((Gt.map f).mulVec w) = w := by
        rw [Matrix.mulVec_mulVec, hHGL, Matrix.one_mulVec]
      rw [← e1, h0, Matrix.mulVec_zero]
    have hfc : f c ≠ 0 := (map_ne_zero f).mpr hc
    have hCy : f c • (C.transpose.map f).mulVec ((Gt.map f).mulVec w) =
        α • (Gt.map f).mulVec w := by
      have h5 : (Gt.map f * B.transpose.map f).mulVec w =
          (f c • (C.transpose.map f * Gt.map f)).mulVec w := by rw [hrelL]
      rw [← Matrix.mulVec_mulVec, hw, Matrix.mulVec_smul, Matrix.smul_mulVec,
        ← Matrix.mulVec_mulVec] at h5
      exact h5.symm
    have hCy' : (C.transpose.map f).mulVec ((Gt.map f).mulVec w) =
        (α / f c) • (Gt.map f).mulVec w := by
      rw [div_eq_inv_mul, mul_smul, ← hCy, smul_smul, inv_mul_cancel₀ hfc, one_smul]
    have hβ := root C.transpose (α / f c) _ hy0 hCy'
    rw [Matrix.charpoly_transpose] at hβ
    refine ⟨α / f c, hβ, ?_⟩
    field_simp

  obtain ⟨r, e, he, hαroot⟩ := hα

  have hΦ₂ : ∀ (c : ℚ_[ℓ]) (x : wcCohG F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - 2)) 2),
      wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - 2)) 2
          (wcCohGEnd F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - 2)) 2 (wcRqScalar D.f ℓ (n - 2) c) x) =
        wcCohGEnd F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - 2)) 2 (wcRqScalar D.f ℓ (n - 2) c)
          (wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - 2)) 2 x) := by
    intro c x
    show (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left (wcGeomFrob F'' (wcP1Over F'') hP))).comp
        (x.comp (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ (n - 2) c)) (add_zero 2)) (zero_add 2) =
      ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left
          (wcGeomFrob F'' (wcP1Over F'') hP))).comp x (zero_add 2)).comp
        (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ (n - 2) c)) (add_zero 2)
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add 2) (add_zero 2) (by omega)).symm
  have hΦH : ∀ (c : ℚ_[ℓ]) (z : wcCoh F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2)),
      wcCohFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2)
          (wcCohScalar F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2) c z) =
        wcCohScalar F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2) c
          (wcCohFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2) z) := by
    intro c z
    show (Abelian.Ext.mk₀ (wcFreeSheafMap (Over.mk (Limits.pullback.snd D.f D.u0)).left
          (wcGeomFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX))).comp
        (z.comp (Abelian.Ext.mk₀ (wcLadicScalar (Over.mk (Limits.pullback.snd D.f D.u0)).left ℓ c))
          (add_zero (n - 2))) (zero_add (n - 2)) =
      ((Abelian.Ext.mk₀ (wcFreeSheafMap (Over.mk (Limits.pullback.snd D.f D.u0)).left
          (wcGeomFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX))).comp z
          (zero_add (n - 2))).comp
        (Abelian.Ext.mk₀ (wcLadicScalar (Over.mk (Limits.pullback.snd D.f D.u0)).left ℓ c))
          (add_zero (n - 2))
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add (n - 2)) (add_zero (n - 2)) (by omega)).symm

  obtain ⟨h1, h2, h3⟩ := wc_pencil_fibre_props F' F'' Y n hn2 D
  haveI : GeometricallyIrreducible (Over.mk (Limits.pullback.snd D.f D.u0)).hom := h1
  haveI : IsProper (Over.mk (Limits.pullback.snd D.f D.u0)).hom := h2
  haveI : SmoothOfRelativeDimension (n - 1) (Over.mk (Limits.pullback.snd D.f D.u0)).hom := h3

  obtain ⟨rX, eX, heX⟩ :=
    wc_coh_finite F'' (Over.mk (Limits.pullback.snd D.f D.u0)) (n - 1) ℓ hℓ hX (n - 2)

  obtain ⟨γ, hsurj, hγs, hγΦ⟩ := wc_pencil_E2_two_gysin F' F'' Y n hn hn2 D ℓ hℓ hP hX

  have hc : (Nat.card F'' : ℚ_[ℓ]) ≠ 0 :=
    Nat.cast_ne_zero.mpr (Finite.card_pos (α := F'')).ne'
  obtain ⟨β, hβ, hαβ⟩ := s6 eX e
    (wcCohScalar F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2))
    (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - 2)) 2 (wcRqScalar D.f ℓ (n - 2) c))
    (wcCohFrob F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX ℓ (n - 2))
    (wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - 2)) 2)
    heX he hΦH hΦ₂ γ hsurj hγs _ hc hγΦ α hαroot
  exact ⟨β, ⟨rX, eX, heX, hβ⟩, hαβ⟩

theorem wc_hm_smooth_divisor_complement_vanishing (F : Type u) [Field F] [Finite F]
    (X : Over (Spec (.of F))) [IsProper X.hom] (N : ℕ) [SmoothOfRelativeDimension N X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (Z : Over (Spec (.of F))) (ι : Z.left ⟶ X.left) (hι : IsClosedImmersion ι)
    (hιZ : ι ≫ X.hom = Z.hom)
    (hZs : SmoothOfRelativeDimension (N - 1) Z.hom)
    (hU : ∃ U : X.left.Opens, (U : Set ↥X.left) = (Set.range ι)ᶜ ∧ IsAffineOpen U)
    (ιb : wcXbar F Z ⟶ wcXbar F X)
    (hιb₁ : ιb ≫ Limits.pullback.fst X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
      Limits.pullback.fst Z.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫ ι)
    (hιb₂ : ιb ≫ Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
      Limits.pullback.snd Z.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
    (D : wcHMPullData ιb ℓ) (hD : wcHMPullCanonical D) (k : ℕ) (hk : k < N) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcXbar F X) ℓ)) := HasExt.standard _
    ∀ y : Abelian.Ext (SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ))
        (Limits.kernel (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC ιb) _ _
          D.cont D.φ)) k, y = 0 :=
by
  classical

  have Q : IsPullback ιb
      (Limits.pullback.fst Z.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
      (Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
      ι := by
    refine IsPullback.of_right ?_ hιb₁
      (IsPullback.of_hasPullback X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))).flip
    rw [hιb₂, hιZ]
    exact (IsPullback.of_hasPullback Z.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))).flip
  have hιbC : IsClosedImmersion ιb :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) Q.flip hι
  have hsep : IsSeparated (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) :=
    MorphismProperty.of_isPullback (P := @IsSeparated)
      (IsPullback.of_hasPullback X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
      (inferInstance : IsSeparated X.hom)
  have hQS : QuasiSeparatedSpace ↥(wcXbar F X) :=
    quasiSeparatedSpace_of_quasiSeparated (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
  have hfstA : IsAffineHom (Limits.pullback.fst X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom)
      (IsPullback.of_hasPullback X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))).flip
      (inferInstance : IsAffineHom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
  have hrange : Set.range ιb = (Limits.pullback.fst X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) ⁻¹' Set.range ι := by
    rw [← Scheme.Pullback.range_snd]
    have key : Q.flip.isoPullback.inv ≫ ιb = Limits.pullback.snd ι (Limits.pullback.fst X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) := by
      rw [Iso.inv_comp_eq]
      exact Q.flip.isoPullback_hom_snd.symm
    ext z
    constructor
    · rintro ⟨w, rfl⟩
      exact ⟨Q.flip.isoPullback.hom w, by
        rw [← Scheme.Hom.comp_apply, Q.flip.isoPullback_hom_snd]⟩
    · rintro ⟨w, rfl⟩
      exact ⟨Q.flip.isoPullback.inv w, by rw [← Scheme.Hom.comp_apply, key]⟩
  have hŪ : ∃ U : (wcXbar F X).Opens, (U : Set ↥(wcXbar F X)) = (Set.range ιb)ᶜ ∧
      IsAffineOpen U := by
    obtain ⟨U, hUset, hUaff⟩ := hU
    refine ⟨Limits.pullback.fst X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ⁻¹ᵁ U, ?_,
      hUaff.preimage _⟩
    rw [hrange, ← Set.preimage_compl, ← hUset]
    rfl
  obtain ⟨Ū, hŪset, hŪaff⟩ := hŪ
  haveI := hιbC

  have hC : IsClosed (Set.range ιb) := ιb.isClosedEmbedding.isClosed_range

  have hπP : IsProper (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) :
        wcXbar F X ⟶ Spec (.of (AlgebraicClosure F))) :=
    MorphismProperty.of_isPullback (P := @IsProper)
      (IsPullback.of_hasPullback X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
      (inferInstance : IsProper X.hom)
  haveI := smoothOfRelativeDimension_isStableUnderBaseChange N
  have hπS : SmoothOfRelativeDimension N (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) :
        wcXbar F X ⟶ Spec (.of (AlgebraicClosure F))) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension N)
      (IsPullback.of_hasPullback X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
      (inferInstance : SmoothOfRelativeDimension N X.hom)
  haveI := hπP
  haveI := hπS
  haveI := smoothOfRelativeDimension_isStableUnderBaseChange (N - 1)
  have hZbS : SmoothOfRelativeDimension (N - 1) (ιb ≫ Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) := by
    rw [hιb₂]
    exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension (N - 1))
      (IsPullback.of_hasPullback Z.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
      hZs

  have hcpt : CompactSpace ↥(wcXbar F X) := by
    haveI : IsProper (Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) := hπP
    exact QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
  have hsepT : IsSeparated (Limits.terminal.from (wcXbar F X)) := by
    haveI : IsSeparated (Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) :
          wcXbar F X ⟶ Spec (.of (AlgebraicClosure F))) := hsep
    have e : Limits.terminal.from (wcXbar F X) =
        (Limits.pullback.snd X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) :
            wcXbar F X ⟶ Spec (.of (AlgebraicClosure F))) ≫ Limits.terminal.from _ :=
      Limits.terminal.hom_ext _ _
    rw [e]
    infer_instance

  have hm : ∀ k' : ℕ, ((ℓ ^ (k' + 1) : ℕ) : AlgebraicClosure F) ≠ 0 := by
    intro k' h0
    letI := Fintype.ofFinite F
    haveI := ringChar.charP F
    have hpp : (ringChar F).Prime := CharP.char_is_prime F (ringChar F)
    have h1 : ((ℓ ^ (k' + 1) : ℕ) : F) = 0 := by
      apply (algebraMap F (AlgebraicClosure F)).injective
      rw [map_natCast, map_zero]
      exact h0
    have h2 : ringChar F ∣ ℓ ^ (k' + 1) := ringChar.dvd h1
    have h3 : ringChar F ∣ ℓ := hpp.dvd_of_dvd_pow h2
    have h4 : ringChar F = ℓ := (Nat.prime_dvd_prime_iff_eq hpp Fact.out).mp h3
    have h5 : ((Nat.card F : ℕ) : F) = 0 := by
      rw [Nat.card_eq_fintype_card]
      exact FiniteField.cast_card_eq_zero F
    apply hℓ
    rw [← h4]
    exact ringChar.dvd h5

  have hcrux : ∀ (m : ℕ), (m : AlgebraicClosure F) ≠ 0 → ∀ i < N,
      Subsingleton (wcEtExt (wcXbar F X) (wcEtExtZero (wcXbar F X) (Ū : Set ↥(wcXbar F X)) m) i) := by
    intro m hm' i hi
    have hA := wc_et_affine_open_artin_vanishing (AlgebraicClosure F) (wcXbar F X)
      (Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) N Ū hŪaff m hm'
      (2 * N - i) (by omega)
    haveI := hZbS
    exact wc_et_extzero_vanish_of_smooth_divisor_dual_vanish (AlgebraicClosure F) (wcXbar F X)
      (Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) N (by omega)
      (wcXbar F Z) ιb Ū hŪset m hm' i (by omega) hA

  obtain ⟨ιQ, hQm, hQ⟩ := wc_hm_kernel_toSheaf_vanSub ιb ℓ D hD
  obtain ⟨⟨FZ, ιZ, hZm, hZ⟩, hTor⟩ := wc_proet_vanishing_subsheaf_exists ιb ℓ
  choose FK ιK hKm hK using fun k' : ℕ => hTor (ℓ ^ (k' + 1))
  haveI hcptT : CompactSpace ↥(Scheme.ProEt.mk (𝟙 (wcXbar F X))).left := hcpt
  haveI hqsT : QuasiSeparatedSpace ↥(Scheme.ProEt.mk (𝟙 (wcXbar F X))).left := hQS
  haveI hsepT' : IsSeparated (Limits.terminal.from (Scheme.ProEt.mk (𝟙 (wcXbar F X))).left) :=
    hsepT
  have hT : ∀ (k' i : ℕ), i < N → ∀ z : Abelian.Ext (wcFreeSheaf (wcXbar F X)
      (Scheme.ProEt.mk (𝟙 (wcXbar F X)))) (FK k') i, z = 0 := by
    intro k' i hi z
    obtain ⟨E⟩ := wc_proet_vanSub_zmod_ext_equiv_et (wcXbar F X)
      (Scheme.ProEt.mk (𝟙 (wcXbar F X))) (Set.range ιb) hC (ℓ ^ (k' + 1)) (FK k') (ιK k')
      (hKm k') (hK k') i
    have hsub := hcrux (ℓ ^ (k' + 1)) (hm k') i hi
    rw [hŪset] at hsub
    exact E.injective (@Subsingleton.elim _ hsub _ _)
  have hI := wc_proet_kernel_int_ext_vanish_below_of_zmod (wcXbar F X)
    (Scheme.ProEt.mk (𝟙 (wcXbar F X))) (Set.range ιb) ℓ FZ ιZ hZm hZ FK ιK hKm hK N hT
  have hRat := wc_proet_kernel_rat_ext_vanish_of_int_deg (wcXbar F X)
    (Scheme.ProEt.mk (𝟙 (wcXbar F X))) (Set.range ιb) ℓ _ ιQ hQm hQ FZ ιZ hZm hZ k (hI k hk)
  exact wc_hm_unit_ext_vanish_of_free_ext_vanish (wcXbar F X) ℓ _ k hRat

theorem wc_hm_weak_lefschetz_injective_of_smooth_divisor (F : Type u) [Field F] [Finite F]
    (X : Over (Spec (.of F))) [IsProper X.hom] (N : ℕ) [SmoothOfRelativeDimension N X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (Z : Over (Spec (.of F))) (ι : Z.left ⟶ X.left) (hι : IsClosedImmersion ι)
    (hιZ : ι ≫ X.hom = Z.hom)
