  have fin_mid : ∀ {A₁ B₁ C₁ : Type (u+1)} [AddCommGroup B₁] [AddCommGroup C₁]
      (f : A₁ → B₁) (d : B₁ →+ C₁), Finite A₁ → Finite C₁ →
      (∀ b, d b = 0 → ∃ a, f a = b) → Finite B₁ := by
    intro A₁ B₁ C₁ _ _ f d hA hC hex
    haveI := hA
    haveI := hC
    let s : C₁ → B₁ := fun c => if h : ∃ b, d b = c then h.choose else 0
    have hs : ∀ b, d (s (d b)) = d b := by
      intro b
      have h : ∃ b', d b' = d b := ⟨b, rfl⟩
      simp only [s, dif_pos h]
      exact h.choose_spec
    have ha : ∀ b, ∃ a, f a = b - s (d b) := fun b => hex _ (by rw [map_sub, hs, sub_self])
