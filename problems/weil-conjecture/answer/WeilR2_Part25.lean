  obtain ⟨hZc, hZs⟩ := hgen _ φ

  obtain ⟨j, hj1, hj2⟩ : ∃ j : T.left ⟶ Limits.pullback D.Yt.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))),
      j ≫ Limits.pullback.fst D.Yt.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
        T.hom ≫ Limits.pullback.fst D.f (D.S i) ∧
      j ≫ Limits.pullback.snd D.Yt.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) = r ≫ ε.hom :=
    ⟨Limits.pullback.lift (T.hom ≫ Limits.pullback.fst D.f (D.S i)) (r ≫ ε.hom)
      (by rw [Category.assoc, hιY]; exact hA.w),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hBot := IsPullback.of_hasPullback D.Yt.hom
    (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))
  have hOut : IsPullback T.hom (j ≫ Limits.pullback.snd D.Yt.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))
      (Limits.pullback.fst D.f (D.S i) ≫ D.Yt.hom)
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) := by
    rw [hj2, hιY]; exact hA
  have hB : IsPullback T.hom j (Limits.pullback.fst D.f (D.S i))
      (Limits.pullback.fst D.Yt.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    IsPullback.of_bot hOut hj1.symm hBot
  have hC := hB.flip.paste_vert (IsPullback.of_hasPullback D.f (D.S i))
  haveI hjCI : IsClosedImmersion j :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hB hι

  have hTxb : Limits.pullback.fst D.f (D.S i) (T.hom xb) =
      D.xs i (IsLocalRing.closedPoint F'') := by
    by_contra hne
    have hmem : T.hom xb ∈ wcCritPunctOpen D i := (hmemO _).mpr hne
    have h1 : xb ∈ Set.range ⇑(wcOpenRestrIncl (Limits.pullback D.f (D.S i))
        (wcCritPunctOpen D i) T).left := by
      rw [hrange]; exact hmem
    rw [hxb] at h1
    exact h1 (Set.mem_singleton xb)
  have hpY : Limits.pullback.fst D.Yt.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) (j xb) =
      D.xs i (IsLocalRing.closedPoint F'') := by
    have e1 : (j ≫ Limits.pullback.fst D.Yt.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) xb =
        (T.hom ≫ Limits.pullback.fst D.f (D.S i)) xb := by rw [hj1]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at e1
    rw [e1]; exact hTxb
  have hyc := j.isClosedEmbedding.isClosedMap _ hcl
  rw [Set.image_singleton] at hyc

  have key : ∀ y' : D.Yt.left, y' = D.xs i (IsLocalRing.closedPoint F'') →
      ∃ (t : Fin n → D.Yt.left.presheaf.stalk y')
        (τ' : (wcP1Over F'').left.presheaf.stalk (D.f y'))
        (M : Matrix (Fin n) (Fin n) (D.Yt.left.presheaf.stalk y')),
        IsLocalRing.maximalIdeal (D.Yt.left.presheaf.stalk y') = Ideal.span (Set.range t) ∧
        IsLocalRing.maximalIdeal ((wcP1Over F'').left.presheaf.stalk (D.f y')) = Ideal.span {τ'} ∧
        (D.f.stalkMap y').hom τ' - ∑ a, ∑ c, M a c * t a * t c ∈
          IsLocalRing.maximalIdeal (D.Yt.left.presheaf.stalk y') ^ 3 ∧
