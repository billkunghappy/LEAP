        exact h2
      obtain ⟨z, hz, hxz⟩ := habsorb _ _ hflatQ
        (b ⊗ₜ[A] (1 : B) - (1 : B) ⊗ₜ[A] b) (by
          rw [RingHom.mem_ker]
          show Algebra.TensorProduct.lmul' A (S := B) (b ⊗ₜ[A] (1 : B) - (1 : B) ⊗ₜ[A] b) = 0
          rw [map_sub, Algebra.TensorProduct.lmul'_apply_tmul,
            Algebra.TensorProduct.lmul'_apply_tmul, mul_one, one_mul, sub_self])
      exact ⟨z, RingHom.mem_ker.mp hz, hxz⟩
    intro k B _ _ _ _ hW
    rw [Submodule.eq_bot_iff]
    intro b hb
    obtain ⟨w, hw0, hw⟩ := s4 k B hW b
    let res : B →ₐ[k] IsLocalRing.ResidueField B :=
      IsScalarTower.toAlgHom k B (IsLocalRing.ResidueField B)
    have hres : ∀ c : B, res c = IsLocalRing.residue B c := fun c => rfl
    let π : TensorProduct k B B →ₐ[k] TensorProduct k B (IsLocalRing.ResidueField B) :=
      Algebra.TensorProduct.map (AlgHom.id k B) res
    let lam : TensorProduct k B (IsLocalRing.ResidueField B) →ₐ[k] IsLocalRing.ResidueField B :=
      Algebra.TensorProduct.lift res (AlgHom.id k _) (fun _ _ => Commute.all _ _)
    have hlam : ∀ (c : B) (y : IsLocalRing.ResidueField B), lam (c ⊗ₜ[k] y) = res c * y := by
      intro c y
      simp [lam]
    have hπ : ∀ (c c' : B), π (c ⊗ₜ[k] c') = c ⊗ₜ[k] res c' := by
      intro c c'
      simp [π]
    have hlp : ∀ t, lam (π t) = res (Algebra.TensorProduct.lmul' k (S := B) t) := by
      intro t
      induction t using TensorProduct.induction_on with
      | zero => simp
      | tmul x y => rw [hπ, hlam, Algebra.TensorProduct.lmul'_apply_tmul, map_mul]
      | add s t hs ht => simp only [map_add, hs, ht]
    have hresb : res b = 0 := by rw [hres]; exact (IsLocalRing.residue_eq_zero_iff b).mpr hb
    set v : TensorProduct k B (IsLocalRing.ResidueField B) := π w - 1 with hv
    have hlv : lam v = -1 := by
      rw [hv, map_sub, hlp, hw0, map_zero, map_one, zero_sub]
    have hbv : (b ⊗ₜ[k] (1 : IsLocalRing.ResidueField B)) * v = 0 := by
      have h1 := congrArg π hw
      rw [map_mul, map_sub, hπ, hπ, hresb, map_one, TensorProduct.tmul_zero, sub_zero] at h1
      rw [hv, mul_sub, h1, mul_one, sub_self]
    have hsm : ∀ (a : B) (t : TensorProduct k B (IsLocalRing.ResidueField B)),
        a • t = (a ⊗ₜ[k] (1 : IsLocalRing.ResidueField B)) * t := by
      intro a t
      induction t using TensorProduct.induction_on with
      | zero => rw [smul_zero, mul_zero]
      | tmul x y => rw [TensorProduct.smul_tmul', Algebra.TensorProduct.tmul_mul_tmul, one_mul,
          smul_eq_mul]
      | add s t hs ht => rw [smul_add, hs, ht, mul_add]
    have hlsm : ∀ (a : B) (t : TensorProduct k B (IsLocalRing.ResidueField B)),
        lam (a • t) = res a * lam t := by
      intro a t
      rw [hsm, map_mul, hlam, mul_one]
    let 𝔟 := Algebra.TensorProduct.basis B
      (Module.Free.chooseBasis k (IsLocalRing.ResidueField B))
    have hcoord : ∀ i, b * 𝔟.repr v i = 0 := by
      intro i
      have h1 : 𝔟.repr (b • v) = b • 𝔟.repr v := map_smul _ _ _
      rw [hsm, hbv, map_zero] at h1
      have h2 := congrArg (fun f => f i) h1
      simp only [Finsupp.coe_zero, Pi.zero_apply, Finsupp.smul_apply, smul_eq_mul] at h2
      exact h2.symm
    have hsum : lam v = ∑ i ∈ (𝔟.repr v).support, res (𝔟.repr v i) * lam (𝔟 i) := by
      conv_lhs => rw [← 𝔟.linearCombination_repr v]
      rw [Finsupp.linearCombination_apply, Finsupp.sum, map_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [hlsm]
    have hne : ∑ i ∈ (𝔟.repr v).support, res (𝔟.repr v i) * lam (𝔟 i) ≠ 0 := by
      rw [← hsum, hlv]
      exact neg_ne_zero.mpr one_ne_zero
    obtain ⟨i, _, hi⟩ := Finset.exists_ne_zero_of_sum_ne_zero hne
    have hi' : res (𝔟.repr v i) ≠ 0 := left_ne_zero_of_mul hi
    have hunit : IsUnit (𝔟.repr v i) := by
      rw [hres] at hi'
      by_contra hnu
      exact hi' ((IsLocalRing.residue_eq_zero_iff _).mpr hnu)
    exact (hunit.mul_left_eq_zero).mp (hcoord i)

  have L2 : ∀ (X : Scheme.{u}) (x : X), IsClosed ({x} : Set X) →
      ∀ (W : Scheme.{u}) (h : W ⟶ X), WeaklyEtale h →
      ∀ (A : Type u) [CommRing A] [IsLocalRing A] (e : W ≅ Spec (.of A)),
      h (e.inv (IsLocalRing.closedPoint A)) = x →
      (∀ (k B : Type u) [Field k] [CommRing B] [IsLocalRing B] [Algebra k B],
        Algebra.WeaklyEtale k B → IsLocalRing.maximalIdeal B = ⊥) →
      ∃ (e' : Limits.pullback h (X.fromSpecResidueField x) ≅
          Spec (.of (IsLocalRing.ResidueField A)))
        (g : X.residueField x →+* IsLocalRing.ResidueField A),
        Limits.pullback.fst h (X.fromSpecResidueField x) ≫ e.hom =
          e'.hom ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) ∧
        e'.inv ≫ Limits.pullback.snd h (X.fromSpecResidueField x) =
          Spec.map (CommRingCat.ofHom g) ∧
        @Algebra.WeaklyEtale (X.residueField x) (IsLocalRing.ResidueField A) _ _ g.toAlgebra := by
    intro X x hcl W h hW A _ _ e hx hfield
    have lpkt : ∀ (R S : Type u) [CommRing R] [CommRing S] (ψ : R →+* S),
        WeaklyEtale (Spec.map (CommRingCat.ofHom ψ)) →
          @Algebra.WeaklyEtale R S _ _ ψ.toAlgebra := by
      intro R S _ _ ψ hW
      letI : Algebra R S := ψ.toAlgebra
      have hW' : WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R S))) := hW
      have hf : Module.Flat R S := RingHom.flat_algebraMap_iff.mp
        ((HasRingHomProperty.Spec_iff (P := @Flat)).mp hW'.flat)
      have h2 := hW'.flat_diagonal
      rw [diagonal_SpecMap] at h2
      have h3 : Flat (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.lmul' (S := S) R).toRingHom)) := by
        have e : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' (S := S) R).toRingHom) =
            (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' (S := S) R).toRingHom) ≫
              (pullbackSpecIso R S S).inv) ≫ (pullbackSpecIso R S S).hom := by
          rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
        rw [e]
        exact MorphismProperty.comp_mem @Flat _ _ h2 inferInstance
      exact Algebra.WeaklyEtale.mk (flat := hf) ((HasRingHomProperty.Spec_iff (P := @Flat)).mp h3)
    set t := X.fromSpecResidueField x with ht
    haveI : IsClosedImmersion t := isClosed_singleton_iff_isClosedImmersion.mp hcl
    haveI : IsClosedImmersion (Limits.pullback.fst h t ≫ e.hom) := inferInstance
    obtain ⟨I, e₀, he₀⟩ := (IsClosedImmersion.Spec_iff (f := Limits.pullback.fst h t ≫ e.hom)).mp
      inferInstance
    have htx : t (IsLocalRing.closedPoint (X.residueField x)) = x :=
      Scheme.fromSpecResidueField_apply x _
    obtain ⟨z, -, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := h) (g := t)
      (e.inv (IsLocalRing.closedPoint A)) (IsLocalRing.closedPoint (X.residueField x))
      (hx.trans htx.symm)
    haveI : Nontrivial (A ⧸ I) := PrimeSpectrum.nonempty_iff_nontrivial.mp ⟨e₀.hom z⟩
    haveI : IsLocalRing (A ⧸ I) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
    have hsnd : WeaklyEtale (Limits.pullback.snd h t) :=
      MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback h t) hW
    set φ₀ := Spec.preimage (e₀.inv ≫ Limits.pullback.snd h t) with hφ₀
    have hφ₀s : Spec.map φ₀ = e₀.inv ≫ Limits.pullback.snd h t := Spec.map_preimage _
    have hWφ : WeaklyEtale (Spec.map (CommRingCat.ofHom φ₀.hom)) := by
      rw [CommRingCat.ofHom_hom, hφ₀s]
      exact (MorphismProperty.cancel_left_of_respectsIso @WeaklyEtale e₀.inv _).mpr hsnd
    have hWE := lpkt _ _ φ₀.hom hWφ
    have hbot := @hfield (X.residueField x) (A ⧸ I) _ _ _ φ₀.hom.toAlgebra hWE
    have hF : IsField (A ⧸ I) := IsLocalRing.isField_iff_maximalIdeal_eq.mpr hbot
    have hmax : I.IsMaximal := Ideal.Quotient.maximal_of_isField I hF
    have hI : I = IsLocalRing.maximalIdeal A := IsLocalRing.eq_maximalIdeal hmax
    subst hI
    refine ⟨e₀, φ₀.hom, he₀, ?_, hWE⟩
    exact hφ₀s.symm

  have L3 : ∀ (k L : Type u) [Field k] [Finite k] [Field L]
      [IsSepClosed L] [Algebra k L], Algebra.WeaklyEtale k L → IsAlgClosure k L := by
    intro k L _ _ _ _ _ hW
    haveI : Algebra.IsAlgebraic k L := by
      constructor
      intro y
      by_contra hy
      have htr : Transcendental k y := hy

      have s1 : ∀ z : TensorProduct k L L,
          (y ⊗ₜ[k] (1 : L) - (1 : L) ⊗ₜ[k] y) * z = 0 → z = 0 := by
        intro z hz
        letI : Algebra (Polynomial k) L := (Polynomial.aeval y).toRingHom.toAlgebra
        have hPK : ∀ p : Polynomial k, algebraMap (Polynomial k) L p = Polynomial.aeval y p :=
          fun p => rfl
        haveI : IsScalarTower k (Polynomial k) L := IsScalarTower.of_algebraMap_eq (fun c => by
          rw [hPK]; exact ((Polynomial.aeval y).commutes c).symm)
        have hinjx : Function.Injective (Polynomial.aeval (R := k) y) :=
          (transcendental_iff_injective).mp htr
        haveI hflat : Module.Flat (Polynomial k) L := by
          rw [Module.Flat.flat_iff_torsion_eq_bot_of_isBezout, eq_bot_iff]
          intro q hq
          obtain ⟨a, ha⟩ := (Submodule.mem_torsion_iff q).mp hq
          rw [Submodule.mem_bot]
          rw [Submonoid.smul_def, Algebra.smul_def, hPK] at ha
          have ha0 : Polynomial.aeval y (a : Polynomial k) ≠ 0 := by
            intro h
            apply nonZeroDivisors.coe_ne_zero a
            apply hinjx
            rw [h, map_zero]
          exact (mul_eq_zero.mp ha).resolve_left ha0
        let e := Algebra.TensorProduct.cancelBaseChange k (Polynomial k) (Polynomial k) L L
        let u : TensorProduct k (Polynomial k) L :=
          (Polynomial.X : Polynomial k) ⊗ₜ[k] (1 : L) - (1 : Polynomial k) ⊗ₜ[k] y
        have heu : e ((1 : L) ⊗ₜ[Polynomial k] u) = y ⊗ₜ[k] (1 : L) - (1 : L) ⊗ₜ[k] y := by
          simp only [u, TensorProduct.tmul_sub, map_sub, e,
            Algebra.TensorProduct.cancelBaseChange_tmul]
          rw [Algebra.smul_def, Algebra.smul_def, hPK, hPK, Polynomial.aeval_X, map_one, mul_one,
            mul_one]
        let Ψ : Polynomial L ≃+* TensorProduct k (Polynomial k) L :=
          (polyEquivTensor' k L).toRingEquiv.trans
            (Algebra.TensorProduct.comm k L (Polynomial k)).toRingEquiv
        have hΨ : Ψ (Polynomial.X - Polynomial.C y) = u := by
          simp only [Ψ, RingEquiv.trans_apply, AlgEquiv.coe_ringEquiv]
          have h1 : (polyEquivTensor' k L) (Polynomial.X - Polynomial.C y) =
              (1 : L) ⊗ₜ[k] (Polynomial.X : Polynomial k) - y ⊗ₜ[k] (1 : Polynomial k) := by
            show polyEquivTensor k L _ = _
            rw [polyEquivTensor_apply, Polynomial.eval₂_sub, Polynomial.eval₂_X,
              Polynomial.eval₂_C]
            rfl
          rw [h1, map_sub, Algebra.TensorProduct.comm_tmul, Algebra.TensorProduct.comm_tmul]
        have hmu : Function.Injective (LinearMap.mulLeft (Polynomial k) u) := by
          rw [injective_iff_map_eq_zero]
          intro v hv
          rw [LinearMap.mulLeft_apply] at hv
          have h2 : Ψ.symm u * Ψ.symm v = 0 := by rw [← map_mul, hv, map_zero]
          have h3 : Ψ.symm u ≠ 0 := by
            rw [← hΨ, RingEquiv.symm_apply_apply]; exact Polynomial.X_sub_C_ne_zero y
          have h4 : Ψ.symm v = 0 := (mul_eq_zero.mp h2).resolve_left h3
          rw [← Ψ.apply_symm_apply v, h4, map_zero]
        have hlt := Module.Flat.lTensor_preserves_injective_linearMap (M := L) _ hmu
        have hkey : LinearMap.lTensor L (LinearMap.mulLeft (Polynomial k) u) =
            LinearMap.mulLeft (Polynomial k) ((1 : L) ⊗ₜ[Polynomial k] u) :=
          TensorProduct.ext' (fun a v => by
            rw [LinearMap.lTensor_tmul, LinearMap.mulLeft_apply, LinearMap.mulLeft_apply,
              Algebra.TensorProduct.tmul_mul_tmul, one_mul])
        have h5 : ((1 : L) ⊗ₜ[Polynomial k] u) * e.symm z = 0 := by
          apply e.injective
          rw [map_mul, heu, AlgEquiv.apply_symm_apply, hz, map_zero]
        have h6 : e.symm z = 0 := hlt (by rw [hkey, LinearMap.mulLeft_apply, h5, map_zero])
        rw [← e.apply_symm_apply z, h6, map_zero]

      have hμsurj : Function.Surjective (Algebra.TensorProduct.lmul' k (S := L)) := fun b =>
        ⟨b ⊗ₜ[k] (1 : L), by rw [Algebra.TensorProduct.lmul'_apply_tmul, mul_one]⟩
      have hflatQ : Module.Flat (TensorProduct k L L)
          (TensorProduct k L L ⧸ RingHom.ker (Algebra.TensorProduct.lmul' k (S := L)).toRingHom) := by
        let e := RingHom.quotientKerEquivOfSurjective
          (f := (Algebra.TensorProduct.lmul' k (S := L)).toRingHom) hμsurj
        have h1 : ((Algebra.TensorProduct.lmul' k (S := L)).toRingHom).Flat := hW.flat_lmul'
        have h2 : (e.symm.toRingHom.comp (Algebra.TensorProduct.lmul' k (S := L)).toRingHom).Flat :=
          RingHom.Flat.comp h1 (RingHom.Flat.of_bijective (f := e.symm.toRingHom) e.symm.bijective)
        have h3 : e.symm.toRingHom.comp (Algebra.TensorProduct.lmul' k (S := L)).toRingHom =
            algebraMap _ (TensorProduct k L L ⧸
              RingHom.ker (Algebra.TensorProduct.lmul' k (S := L)).toRingHom) := by
          refine RingHom.ext fun t => ?_
          rw [Ideal.Quotient.algebraMap_eq]
          show e.symm (Algebra.TensorProduct.lmul' k (S := L) t) = Ideal.Quotient.mk _ t
          rw [e.symm_apply_eq]
          rfl
        rw [h3, RingHom.flat_algebraMap_iff] at h2
        exact h2
      obtain ⟨w, hw, hxw⟩ : ∃ w ∈ RingHom.ker (Algebra.TensorProduct.lmul' k (S := L)).toRingHom,
          (y ⊗ₜ[k] (1 : L) - (1 : L) ⊗ₜ[k] y) * w = y ⊗ₜ[k] (1 : L) - (1 : L) ⊗ₜ[k] y := by
        have hrel : ∑ i : Fin 1, (fun _ => (y ⊗ₜ[k] (1 : L) - (1 : L) ⊗ₜ[k] y)) i •
            (fun _ => (1 : TensorProduct k L L ⧸
              RingHom.ker (Algebra.TensorProduct.lmul' k (S := L)).toRingHom)) i = 0 := by
          rw [Fin.sum_univ_one]
          rw [Algebra.smul_def, Ideal.Quotient.algebraMap_eq, mul_one,
            Ideal.Quotient.eq_zero_iff_mem, RingHom.mem_ker]
          show Algebra.TensorProduct.lmul' k (S := L) (y ⊗ₜ[k] (1 : L) - (1 : L) ⊗ₜ[k] y) = 0
          rw [map_sub, Algebra.TensorProduct.lmul'_apply_tmul,
            Algebra.TensorProduct.lmul'_apply_tmul, mul_one, one_mul, sub_self]
        obtain ⟨m, a, q, h1, h2⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero hrel
        choose b hb using fun j => Ideal.Quotient.mk_surjective (q j)
        set w0 := ∑ j, a 0 j * b j with hw0
        have hmk : Ideal.Quotient.mk
            (RingHom.ker (Algebra.TensorProduct.lmul' k (S := L)).toRingHom) w0 = 1 := by
          have h10 : (1 : TensorProduct k L L ⧸
              RingHom.ker (Algebra.TensorProduct.lmul' k (S := L)).toRingHom) =
              ∑ j, a 0 j • q j := h1 0
          rw [hw0, map_sum, h10]
          refine Finset.sum_congr rfl (fun j _ => ?_)
          rw [map_mul, hb j, Algebra.smul_def, Ideal.Quotient.algebraMap_eq]
        have hxw0 : (y ⊗ₜ[k] (1 : L) - (1 : L) ⊗ₜ[k] y) * w0 = 0 := by
          rw [hw0, Finset.mul_sum]
          refine Finset.sum_eq_zero (fun j _ => ?_)
          have := h2 j
          rw [Fin.sum_univ_one] at this
          rw [← mul_assoc, this, zero_mul]
        refine ⟨1 - w0, ?_, ?_⟩
        · rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_one, hmk, sub_self]
        · rw [mul_sub, mul_one, hxw0, sub_zero]
      have h1 : w - 1 = 0 := s1 _ (by rw [mul_sub, mul_one, hxw, sub_self])
      have h2 : w = 1 := sub_eq_zero.mp h1
      rw [h2, RingHom.mem_ker] at hw
      rw [map_one] at hw
      exact one_ne_zero hw
    haveI : PerfectField k := PerfectField.ofFinite
    haveI : PerfectField L := Algebra.IsAlgebraic.perfectField (K := k)
    haveI : IsAlgClosed L := IsSepClosed.isAlgClosed_of_perfectField L
    exact ⟨inferInstance, inferInstance⟩

  have L4 : ∀ (k : Type u) [Field k] [Fintype k] (A : Type u) [CommRing A]
      [IsLocalRing A] (γ : IsLocalRing.ResidueField A →+* AlgebraicClosure k) (ψ : A →+* A)
      (M : ℕ), Nat.card k = M → (∀ a : A, ψ a ^ M - a ∈ IsLocalRing.maximalIdeal A) →
      ∀ a : A, γ (IsLocalRing.residue A (ψ a)) =
        (FiniteField.frobeniusAlgEquivOfAlgebraic k (AlgebraicClosure k)).symm
          (γ (IsLocalRing.residue A a)) := by
    intro k _ _ A _ _ γ ψ M hM hfrob a
    have h1 : IsLocalRing.residue A (ψ a ^ M - a) = 0 :=
      (IsLocalRing.residue_eq_zero_iff _).mpr (hfrob a)
    rw [map_sub, map_pow, sub_eq_zero] at h1
    rw [AlgEquiv.eq_symm_apply, FiniteField.frobeniusAlgEquivOfAlgebraic_apply,
      ← Nat.card_eq_fintype_card, hM, ← map_pow, h1]

  have gen : ∀ (X : Scheme.{u}) (x : X) (hcl : IsClosed ({x} : Set X))
      (hfin : Finite (X.residueField x))
      (W : Scheme.{u}) (h : W ⟶ X) (hW : WeaklyEtale h) (φ : W ⟶ W)
      (A : Type u) [CommRing A] [IsLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
      (e : W ≅ Spec (.of A)) (hx : h (e.inv (IsLocalRing.closedPoint A)) = x)
      (ψ : A →+* A) (hψ : e.inv ≫ φ ≫ e.hom = Spec.map (CommRingCat.ofHom ψ))
      (M : ℕ) (hM : Nat.card (X.residueField x) = M)
      (hfrob : ∀ a : A, ψ a ^ M - a ∈ IsLocalRing.maximalIdeal A),
      ∃ ε : Limits.pullback h (X.fromSpecResidueField x) ≅
          Spec (.of (AlgebraicClosure (X.residueField x))),
        ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap (X.residueField x)
            (AlgebraicClosure (X.residueField x)))) =
          Limits.pullback.snd h (X.fromSpecResidueField x) ∧
        ε.inv ≫ Limits.pullback.fst h (X.fromSpecResidueField x) ≫ φ =
          Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic
            (X.residueField x) _ (@Fintype.ofFinite _ hfin)
            (AlgebraicClosure (X.residueField x)) _ _ _).symm :
              AlgebraicClosure (X.residueField x) →+* AlgebraicClosure (X.residueField x))) ≫
            ε.inv ≫ Limits.pullback.fst h (X.fromSpecResidueField x) := by
    intro X x hcl hfin W h hW φ A _ _ _ e hx ψ hψ M hM hfrob
    haveI : Finite (X.residueField x) := hfin
    letI : Fintype (X.residueField x) := @Fintype.ofFinite _ hfin
    obtain ⟨e', g, ha, hb, hc⟩ := L2 X x hcl W h hW A e hx L1
    letI : Algebra (X.residueField x) (IsLocalRing.ResidueField A) := g.toAlgebra
    haveI : IsAlgClosure (X.residueField x) (IsLocalRing.ResidueField A) := L3 _ _ hc
    let β : AlgebraicClosure (X.residueField x) ≃ₐ[X.residueField x]
        IsLocalRing.ResidueField A :=
      IsAlgClosure.equiv (X.residueField x) (AlgebraicClosure (X.residueField x))
        (IsLocalRing.ResidueField A)
    have hβg : (β : AlgebraicClosure (X.residueField x) →+* IsLocalRing.ResidueField A).comp
        (algebraMap (X.residueField x) (AlgebraicClosure (X.residueField x))) = g := by
      ext c
      exact β.commutes c
    let ι : Spec (.of (IsLocalRing.ResidueField A)) ≅
        Spec (.of (AlgebraicClosure (X.residueField x))) :=
      { hom := Spec.map (CommRingCat.ofHom
          (β : AlgebraicClosure (X.residueField x) →+* IsLocalRing.ResidueField A))
        inv := Spec.map (CommRingCat.ofHom
          (β.symm : IsLocalRing.ResidueField A →+* AlgebraicClosure (X.residueField x)))
        hom_inv_id := by
          rw [← Spec.map_comp, ← Spec.map_id]
          congr 1
          apply CommRingCat.hom_ext
          apply RingHom.ext
          intro y
          exact β.apply_symm_apply y
        inv_hom_id := by
          rw [← Spec.map_comp, ← Spec.map_id]
          congr 1
          apply CommRingCat.hom_ext
          apply RingHom.ext
          intro y
          exact β.symm_apply_apply y }
    refine ⟨e' ≪≫ ι, ?_, ?_⟩
    · show (e'.hom ≫ ι.hom) ≫ _ = _
      rw [Category.assoc]
      show e'.hom ≫ Spec.map (CommRingCat.ofHom
          (β : AlgebraicClosure (X.residueField x) →+* IsLocalRing.ResidueField A)) ≫ _ = _
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hβg, ← hb, Iso.hom_inv_id_assoc]
    · show (ι.inv ≫ e'.inv) ≫ _ = _ ≫ (ι.inv ≫ e'.inv) ≫ _
      have hψ' : φ ≫ e.hom = e.hom ≫ Spec.map (CommRingCat.ofHom ψ) := by
        rw [← hψ]; simp
      have ha' : ∀ {Z : Scheme.{u}} (k : Spec (.of A) ⟶ Z),
          Limits.pullback.fst h (X.fromSpecResidueField x) ≫ e.hom ≫ k =
            e'.hom ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) ≫ k := by
        intro Z k
        rw [← Category.assoc, ha, Category.assoc]
      rw [← cancel_mono e.hom]
      simp only [Category.assoc]
      rw [hψ', ha', ha, Iso.inv_hom_id_assoc, Iso.inv_hom_id_assoc]
      show Spec.map (CommRingCat.ofHom
          (β.symm : IsLocalRing.ResidueField A →+* AlgebraicClosure (X.residueField x))) ≫ _ ≫ _ =
        _ ≫ Spec.map (CommRingCat.ofHom
          (β.symm : IsLocalRing.ResidueField A →+* AlgebraicClosure (X.residueField x))) ≫ _
      rw [← Spec.map_comp, ← Spec.map_comp, ← Spec.map_comp, ← Spec.map_comp]
      congr 1
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro a
      exact L4 (X.residueField x) A
        (β.symm : IsLocalRing.ResidueField A →+* AlgebraicClosure (X.residueField x)) ψ M hM
        hfrob a

  have hN : Nat.card ((wcP1Over K).left.residueField x) = Nat.card K ^ d := by
    obtain ⟨_, hfr⟩ := hx
    letI : Module K ((wcP1Over K).left.residueField x) :=
      (((wcP1Over K).left.residue x).hom.comp (wcLdpConst K (wcP1Over K).hom x)).toModule
    have hfr' : Module.finrank K ((wcP1Over K).left.residueField x) = d := hfr
    haveI : Module.Finite K ((wcP1Over K).left.residueField x) :=
      Module.finite_of_finrank_pos (by omega)
    rw [Module.natCard_eq_pow_finrank (K := K) (V := (wcP1Over K).left.residueField x), hfr']
  letI := N.ringA
  haveI := N.hensA
  haveI := N.sepA
  exact gen (wcP1Over K).left x hx.1 hfin N.V.left N.V.hom N.V.prop N.φ.left N.A N.e N.hx N.ψ
    N.hψ (Nat.card K ^ d) hN N.hfrob

theorem wc_pencil_point_isClosedImmersion (F'' K : Type u) [Field F''] [Field K] [Finite K]
    (t : Spec (.of K) ⟶ (wcP1Over F'').left) (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [IsLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom t ≅ Spec (.of (AlgebraicClosure K)))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = t (IsLocalRing.closedPoint K)) :
    IsClosedImmersion t :=
by
  have hsepP : IsSeparated (wcP1Over F'').hom := by
    show IsSeparated (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'')
      MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
        (algebraMap F'' ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'' 0))))
    infer_instance
  classical

  have hrange : IsClosed (Set.range t) := by
    have hfin : (Spec.preimage (t ≫ (wcP1Over F'').hom)).hom.Finite := by
      letI := (Spec.preimage (t ≫ (wcP1Over F'').hom)).hom.toAlgebra
      exact @Module.Finite.of_finite _ _ _ _ _ ‹Finite K›
    haveI : IsFinite (t ≫ (wcP1Over F'').hom) := by
      rw [← Spec.map_preimage (t ≫ (wcP1Over F'').hom)]; exact (IsFinite.SpecMap_iff _).mpr hfin
    haveI : IsProper t := IsProper.of_comp t (wcP1Over F'').hom
    exact (Scheme.Hom.isClosedMap t).isClosed_range

  haveI hsub : Subsingleton ↥(Limits.pullback V₀.hom t) := by
    have hinj : Function.Injective ε.hom := by
      intro a b hab
      calc a = ε.inv (ε.hom a) := (Scheme.hom_inv_apply ε a).symm
        _ = ε.inv (ε.hom b) := by rw [hab]
        _ = b := Scheme.hom_inv_apply ε b
    exact hinj.subsingleton
  set cpK : ↥(Spec (.of K)) := IsLocalRing.closedPoint K with hcpK
  set cpA : ↥(Spec (.of A)) := IsLocalRing.closedPoint A with hcpA

  let T : Scheme.Pullback.Triplet V₀.hom t := ⟨e.inv cpA, cpK, t cpK, hv, rfl⟩
  have hT : Subsingleton (PrimeSpectrum T.tensor) := by
    have hinj : Function.Injective
        (fun p : ↥(Spec T.tensor) => Scheme.Pullback.carrierEquiv.symm ⟨T, p⟩) :=
      Scheme.Pullback.carrierEquiv.symm.injective.comp sigma_mk_injective
    exact hinj.subsingleton
  let ι₁ : (wcP1Over F'').left.residueField (t cpK) ⟶ V₀.left.residueField (e.inv cpA) :=
    (Scheme.residueFieldCongr hv).inv ≫ V₀.hom.residueFieldMap (e.inv cpA)
  let ι₂ : (wcP1Over F'').left.residueField (t cpK) ⟶ (Spec (.of K)).residueField cpK :=
    (Scheme.residueFieldCongr (rfl : t cpK = t cpK)).inv ≫ t.residueFieldMap cpK
  have hP : Subsingleton (PrimeSpectrum ↑(Limits.pushout (C := CommRingCat) ι₁ ι₂)) := hT

  haveI : IsIso (e.inv.residueFieldMap cpA) := inferInstance
  haveI hlocA : IsLocalRing ↑((Spec (.of A)).presheaf.stalk (IsLocalRing.closedPoint A)) :=
    inferInstanceAs (IsLocalRing ↑((Spec (.of A)).presheaf.stalk cpA))
  let α : V₀.left.residueField (e.inv cpA) ⟶ CommRingCat.of (IsLocalRing.ResidueField A) :=
    e.inv.residueFieldMap cpA ≫
      CommRingCat.ofHom (IsLocalRing.ResidueField.mapEquiv
        (stalkClosedPointIso (.of A)).commRingCatIsoToRingEquiv).toRingHom
  have hαs : Function.Surjective α.hom := by
    have h1 := ConcreteCategory.bijective_of_isIso (e.inv.residueFieldMap cpA)
    have h2 := (IsLocalRing.ResidueField.mapEquiv
        (stalkClosedPointIso (.of A)).commRingCatIsoToRingEquiv).surjective
    exact h2.comp h1.2

  have huniq : ∀ σ τ : (Spec (.of K)).residueField cpK ⟶ CommRingCat.of (IsLocalRing.ResidueField A),
      ι₁ ≫ α = ι₂ ≫ σ → ι₁ ≫ α = ι₂ ≫ τ → σ = τ := by
    intro σ τ hσ' hτ'
    let dσ := Limits.pushout.desc α σ hσ'
    let dτ := Limits.pushout.desc α τ hτ'
    have hker : RingHom.ker dσ.hom = RingHom.ker dτ.hom := by
      have := Subsingleton.elim
        (⟨RingHom.ker dσ.hom, RingHom.ker_isPrime _⟩ : PrimeSpectrum _)
        ⟨RingHom.ker dτ.hom, RingHom.ker_isPrime _⟩
      exact congrArg PrimeSpectrum.asIdeal this
    have hlσ := Limits.pushout.inl_desc α σ hσ'
    have hlτ := Limits.pushout.inl_desc α τ hτ'
    have hd : dσ = dτ := by
      apply CommRingCat.hom_ext
      refine RingHom.ext fun z => ?_
      obtain ⟨a, ha⟩ := hαs (dσ.hom z)
      have hw1 : dσ.hom ((Limits.pushout.inl ι₁ ι₂).hom a) = α.hom a := by
        have := congrArg (fun f => f.hom a) hlσ
        simpa only [CommRingCat.hom_comp, RingHom.comp_apply] using this
      have hw2 : dτ.hom ((Limits.pushout.inl ι₁ ι₂).hom a) = α.hom a := by
        have := congrArg (fun f => f.hom a) hlτ
        simpa only [CommRingCat.hom_comp, RingHom.comp_apply] using this
      have hmem : z - (Limits.pushout.inl ι₁ ι₂).hom a ∈ RingHom.ker dσ.hom := by
        rw [RingHom.mem_ker, map_sub, hw1, ha, sub_self]
      rw [hker, RingHom.mem_ker, map_sub, hw2, sub_eq_zero] at hmem
      rw [hmem, ha]
    have hrσ := Limits.pushout.inr_desc α σ hσ'
    have hrτ := Limits.pushout.inr_desc α τ hτ'
    rw [← hrσ, ← hrτ]
    exact congrArg (fun f => Limits.pushout.inr ι₁ ι₂ ≫ f) hd

  have hK'fin : Finite ↑((Spec (.of K)).residueField cpK) := by
    have : Finite ↑((Spec (.of K)).presheaf.stalk cpK) :=
      Finite.of_equiv _ (stalkClosedPointIso (.of K)).commRingCatIsoToRingEquiv.toEquiv.symm
    exact Finite.of_surjective _ (Scheme.residue_surjective _ _)

  have hsurj : Function.Surjective ι₂.hom := by
    letI : Algebra ↑((wcP1Over F'').left.residueField (t cpK)) ↑((Spec (.of K)).residueField cpK) :=
      ι₂.hom.toAlgebra
    letI : Algebra ↑((wcP1Over F'').left.residueField (t cpK)) (IsLocalRing.ResidueField A) := (ι₁ ≫ α).hom.toAlgebra
    haveI : FiniteDimensional ↑((wcP1Over F'').left.residueField (t cpK))
        ↑((Spec (.of K)).residueField cpK) := Module.Finite.of_finite
    have hspl : ∀ x : ↑((Spec (.of K)).residueField cpK),
        (Polynomial.map (algebraMap ↑((wcP1Over F'').left.residueField (t cpK)) (IsLocalRing.ResidueField A))
          (minpoly ↑((wcP1Over F'').left.residueField (t cpK)) x)).Splits := fun x =>
      IsSepClosed.splits_of_separable _
        (Polynomial.Separable.map (Algebra.IsSeparable.isSeparable _ x))
    have hcard := AlgHom.card_of_splits ↑((wcP1Over F'').left.residueField (t cpK))
      ↑((Spec (.of K)).residueField cpK) (IsLocalRing.ResidueField A) hspl
    have hφ : ∀ φ : ↑((Spec (.of K)).residueField cpK) →ₐ[↑((wcP1Over F'').left.residueField (t cpK))]
        IsLocalRing.ResidueField A, ι₁ ≫ α = ι₂ ≫ CommRingCat.ofHom φ.toRingHom := by
      intro φ
      apply CommRingCat.hom_ext
      refine RingHom.ext fun x => ?_
      exact (φ.commutes x).symm
    have hle : Fintype.card (↑((Spec (.of K)).residueField cpK) →ₐ[↑((wcP1Over F'').left.residueField (t cpK))]
        IsLocalRing.ResidueField A) ≤ 1 :=
      Fintype.card_le_one_iff_subsingleton.mpr
        ⟨fun φ ψ => AlgHom.coe_ringHom_injective
          (congrArg CommRingCat.Hom.hom (huniq _ _ (hφ φ) (hφ ψ)))⟩
    have hpos : 0 < Module.finrank ↑((wcP1Over F'').left.residueField (t cpK))
        ↑((Spec (.of K)).residueField cpK) := Module.finrank_pos
    have h1 : Module.finrank ↑((wcP1Over F'').left.residueField (t cpK))
        ↑((Spec (.of K)).residueField cpK) = 1 := by omega
    have hbt := Subalgebra.bot_eq_top_of_finrank_eq_one h1
    intro b
    have hb : b ∈ (⊥ : Subalgebra ↑((wcP1Over F'').left.residueField (t cpK))
        ↑((Spec (.of K)).residueField cpK)) := hbt ▸ Algebra.mem_top
    obtain ⟨a, ha⟩ := Algebra.mem_bot.mp hb
    exact ⟨a, ha⟩
  have hres : Function.Surjective (t.residueFieldMap cpK).hom := by
    have : Function.Surjective ((t.residueFieldMap cpK).hom ∘
        (Scheme.residueFieldCongr (rfl : t cpK = t cpK)).inv.hom) := hsurj
    exact this.of_comp

  haveI : SurjectiveOnStalks t := by
    refine SurjectiveOnStalks.mk fun x => ?_
    obtain rfl : x = cpK := Subsingleton.elim _ _
    have hfield : IsField ↑((Spec (.of K)).presheaf.stalk cpK) :=
      MulEquiv.isField (Field.toIsField K)
        (stalkClosedPointIso (.of K)).commRingCatIsoToRingEquiv.toMulEquiv
    have hinj : Function.Injective ((Spec (.of K)).residue cpK).hom := by
      rw [RingHom.injective_iff_ker_eq_bot]
      show RingHom.ker (IsLocalRing.residue _) = ⊥
      rw [IsLocalRing.ker_residue]
      exact (IsLocalRing.isField_iff_maximalIdeal_eq).mp hfield
    intro s
    obtain ⟨b, hb⟩ := hres (((Spec (.of K)).residue cpK).hom s)
    obtain ⟨a, rfl⟩ := Scheme.residue_surjective (wcP1Over F'').left (t cpK) b
    refine ⟨a, hinj ?_⟩
    have := congrArg (fun f => f.hom a) (Scheme.residue_residueFieldMap t cpK)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
    rw [← this]
    exact hb
  haveI : IsPreimmersion t := IsPreimmersion.mk (Topology.IsEmbedding.of_subsingleton _)
  exact IsClosedImmersion.of_isPreimmersion t hrange

theorem wc_pencil_point_nbhd_torsion_restriction_injective (F' F'' K : Type u) [Field F'] [Field F'']
    [Algebra F' F''] [Field K] [Finite K] (Y : Over (Spec (.of F'))) (n : ℕ)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (t : Spec (.of K) ⟶ (wcP1Over F'').left) [IsClosedImmersion t]
    (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom t ≅ Spec (.of (AlgebraicClosure K)))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = t (IsLocalRing.closedPoint K))
    (L : Sheaf (Scheme.ProEt.topology D.Yt.left) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology (Limits.pullback D.f t)) AddCommGrpCat.{u+1})
    [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L]
    (adj : L ⊣ wcProEtPush (Limits.pullback.fst D.f t))
    (θ : ∀ V : D.Yt.left.ProEt, L.obj (wcFreeSheaf D.Yt.left V) ≅
      wcFreeSheaf (Limits.pullback D.f t) ((wcProEtPullback (Limits.pullback.fst D.f t)).obj V))
    (j k : ℕ) :
    Function.Injective (wcProEtRes (Limits.pullback.fst D.f t) L adj θ (ZMod (ℓ ^ k))
      ((wcProEtPullback D.f).obj V₀) j) :=
by
  classical

  haveI hcl : IsClosedImmersion (Limits.pullback.fst D.f t) := inferInstance
  haveI : IsProper D.Yt.hom := D.proper
  haveI : IsLocallyNoetherian D.Yt.left :=
    LocallyOfFiniteType.isLocallyNoetherian (Y := Spec (.of F'')) D.Yt.hom

  haveI : (wcProEtPush (Limits.pullback.fst D.f t)).IsRightAdjoint := ⟨_, ⟨adj⟩⟩
  haveI : Limits.PreservesLimitsOfSize.{0, 0} (wcProEtPush (Limits.pullback.fst D.f t)) :=
    adj.rightAdjoint_preservesLimits
  haveI : Limits.PreservesFiniteLimits (wcProEtPush (Limits.pullback.fst D.f t)) :=
    Limits.PreservesLimitsOfSize.preservesFiniteLimits _
  haveI : Limits.PreservesFiniteColimits (wcProEtPush (Limits.pullback.fst D.f t)) :=
    wc_proet_push_closed_preservesFiniteColimits (Limits.pullback.fst D.f t)
  haveI : (wcProEtPush (Limits.pullback.fst D.f t)).PreservesZeroMorphisms :=
    Functor.preservesZeroMorphisms_of_isRightAdjoint _
  haveI : (wcProEtPush (Limits.pullback.fst D.f t)).Additive :=
    Functor.additive_of_preserves_binary_products _

  have hgeom : ∃ q : ((wcProEtPullback D.f).obj V₀).left ⟶ Spec (.of A), IsProper q ∧
      CompactSpace ((wcProEtPullback D.f).obj V₀).left ∧
      IsSeparated (Limits.terminal.from ((wcProEtPullback D.f).obj V₀).left) ∧
      ∀ z : ((wcProEtPullback D.f).obj V₀).left,
        ((wcProEtPullback D.f).obj V₀).hom z ∈ Set.range (Limits.pullback.fst D.f t) ↔
          q z = IsLocalRing.closedPoint A := by
    haveI hpsep : IsSeparated (wcP1Over F'').hom := by
      show IsSeparated (Proj.toSpecZero _ ≫ Spec.map _)
      infer_instance
    haveI hfp : IsProper D.f := by
      haveI : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; infer_instance
      exact IsProper.of_comp D.f (wcP1Over F'').hom
    haveI h1 : IsProper (Limits.pullback.fst V₀.hom D.f) := by
      first
      | infer_instance
      | exact MorphismProperty.pullback_fst (P := @IsProper) _ _ hfp
    obtain ⟨q, hqdef⟩ : ∃ q : Limits.pullback V₀.hom D.f ⟶ Spec (.of A),
        q = Limits.pullback.fst V₀.hom D.f ≫ e.hom := ⟨_, rfl⟩
    haveI hq : IsProper q := by rw [hqdef]; infer_instance
    have hc : CompactSpace (Limits.pullback (C := Scheme.{u}) V₀.hom D.f) :=
      QuasiCompact.compactSpace_of_compactSpace q
    have hsep : IsSeparated
        (Limits.terminal.from (Limits.pullback (C := Scheme.{u}) V₀.hom D.f)) := by
      rw [Limits.terminal.hom_ext (Limits.terminal.from _)
        (q ≫ Limits.terminal.from (Spec (.of A)))]
      infer_instance
    have hrng0 : Set.range t = {t (IsLocalRing.closedPoint K)} := by
      ext x
      constructor
      · rintro ⟨s, rfl⟩
        rw [Subsingleton.elim s (IsLocalRing.closedPoint K)]
        exact Set.mem_singleton _
      · rintro rfl
        exact ⟨_, rfl⟩
    have hsub : ∀ v : V₀.left, V₀.hom v = t (IsLocalRing.closedPoint K) ↔
        e.hom v = IsLocalRing.closedPoint A := by
      intro v
      constructor
      · intro h
        obtain ⟨w, hw1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := V₀.hom) (g := t)
          v (IsLocalRing.closedPoint K) h
        obtain ⟨w₀, hw₀1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := V₀.hom)
          (g := t) (e.inv (IsLocalRing.closedPoint A)) (IsLocalRing.closedPoint K) hv
        have hww : w = w₀ := by
          rw [← Scheme.hom_inv_apply ε w, ← Scheme.hom_inv_apply ε w₀,
            Subsingleton.elim (ε.hom w) (ε.hom w₀)]
        rw [← hw1, hww, hw₀1]
        first
          | exact Scheme.inv_hom_apply e (IsLocalRing.closedPoint A)
          | exact (Scheme.inv_hom_apply e (IsLocalRing.closedPoint A) :)
          | (rw [← Scheme.Hom.comp_apply, Iso.inv_hom_id]; rfl)
      · intro h
        rw [← Scheme.hom_inv_apply e v, h]
        exact hv
    have hfib : ∀ z : Limits.pullback (C := Scheme.{u}) V₀.hom D.f,
        Limits.pullback.snd V₀.hom D.f z ∈ Set.range (Limits.pullback.fst D.f t) ↔
          q z = IsLocalRing.closedPoint A := by
      intro z
      rw [Scheme.Pullback.range_fst, Set.mem_preimage, hrng0, Set.mem_singleton_iff]
      have hcond : V₀.hom (Limits.pullback.fst V₀.hom D.f z) =
          D.f (Limits.pullback.snd V₀.hom D.f z) := by
        have e1 := Scheme.Hom.comp_apply (Limits.pullback.fst V₀.hom D.f) V₀.hom z
        have e2 := Scheme.Hom.comp_apply (Limits.pullback.snd V₀.hom D.f) D.f z
        rw [Limits.pullback.condition] at e1
        exact e1.symm.trans e2
      rw [← hcond, hsub, hqdef]
      all_goals first
        | exact Iff.rfl
        | rw [Scheme.Hom.comp_apply]
        | simp only [Scheme.Hom.comp_apply]
    exact ⟨q, hq, hc, hsep, hfib⟩
  obtain ⟨q, hq, hcpt, hsep, hfib⟩ := hgeom
  haveI := hq
  haveI := hcpt
  haveI := hsep
  have hn : 0 < ℓ ^ k := pow_pos (Fact.out : ℓ.Prime).pos k

  obtain ⟨ι, hιm, hchar⟩ := wc_contPull_kernel_vanSub (Limits.pullback.fst D.f t) (ℓ ^ k)

  have hvan : ∀ (m : ℕ) (y : Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀))
      (Limits.kernel (wcContPull (Limits.pullback.fst D.f t) (ZMod (ℓ ^ k)))) m), y = 0 := by
    intro m y
    cases m with
    | succ m' =>
      have hC : IsClosed (Set.range (Limits.pullback.fst D.f t)) :=
        (Scheme.Hom.isClosedEmbedding (Limits.pullback.fst D.f t)).isClosed_range
      have hopen : IsOpen ({IsLocalRing.closedPoint A}ᶜ : Set (Spec (.of A))) := by
        apply isOpen_compl_iff.mpr
        exact IsLocalRing.isClosed_singleton_closedPoint A
      have hne : ({IsLocalRing.closedPoint A}ᶜ : Set (Spec (.of A))) ≠ Set.univ := by
        intro h
        have h' : IsLocalRing.closedPoint A ∈
            ({IsLocalRing.closedPoint A}ᶜ : Set (Spec (.of A))) :=
          h ▸ Set.mem_univ _
        exact h' (Set.mem_singleton _)
      have het : ∀ q' : ℕ, Subsingleton (wcEtExt ((wcProEtPullback D.f).obj V₀).left
          (wcEtExtZero ((wcProEtPullback D.f).obj V₀).left
            (((wcProEtPullback D.f).obj V₀).hom ⁻¹' Set.range (Limits.pullback.fst D.f t))ᶜ
            (ℓ ^ k)) (q' + 1)) := by
        intro q'
        have hset : (((wcProEtPullback D.f).obj V₀).hom ⁻¹'
            Set.range (Limits.pullback.fst D.f t))ᶜ =
            q ⁻¹' ({IsLocalRing.closedPoint A}ᶜ : Set (Spec (.of A))) := by
          ext z
          simp only [Set.mem_compl_iff, Set.mem_preimage]
          exact not_congr (hfib z)
        rw [hset]
        exact wc_et_henselian_proper_vanishing A _ q (ℓ ^ k) hn.ne' _ hopen hne (q' + 1)
      exact wc_proet_vanishing_subsheaf_zmod_of_et D.Yt.left ((wcProEtPullback D.f).obj V₀)
        (Set.range (Limits.pullback.fst D.f t)) hC (ℓ ^ k) hn _ ι hιm hchar het m' y
    | zero =>
      obtain ⟨φ, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 y
      obtain ⟨ev, -, hev0⟩ := proet_free_sheaf_hom_equiv D.Yt.left ((wcProEtPullback D.f).obj V₀)
      have hvz := (hchar ((wcProEtPullback D.f).obj V₀)
        ((ι.hom.app (Opposite.op ((wcProEtPullback D.f).obj V₀))).hom (ev _ φ))).1 ⟨_, rfl⟩
      let r : C(↥((wcProEtPullback D.f).obj V₀).left, ULift.{u+1} (ZMod (ℓ ^ k))) :=
        (ι.hom.app (Opposite.op ((wcProEtPullback D.f).obj V₀))).hom (ev _ φ)
      have hrz : ∀ z, r z = 0 := by
        intro z
        have hT : IsClosed (r ⁻¹' {r z}) := (isClosed_discrete _).preimage r.continuous
        have h1 : IsClosed (q '' (r ⁻¹' {r z})) := Scheme.Hom.isClosedMap q _ hT
        have h2 : q z ∈ q '' (r ⁻¹' {r z}) := ⟨z, rfl, rfl⟩
        obtain ⟨z', hz'1, hz'2⟩ := (IsLocalRing.specializes_closedPoint (q z)).mem_closed h1 h2
        have h3 : r z' = r z := hz'1
        rw [← h3]
        exact hvz z' ((hfib z').2 hz'2)
      have hr0 : r = 0 := ContinuousMap.ext hrz
      have hmono : Mono (ι.hom.app (Opposite.op ((wcProEtPullback D.f).obj V₀))) := by
        have h1 : Mono ι.hom := (Sheaf.Hom.mono_iff_presheaf_mono _ _ ι).1 hιm
        exact (NatTrans.mono_iff_mono_app _).1 h1 _
      have hinj : Function.Injective
          (ι.hom.app (Opposite.op ((wcProEtPullback D.f).obj V₀))).hom :=
        (AddCommGrpCat.mono_iff_injective _).1 hmono
      have hs : ev _ φ = 0 := by
        apply hinj
        rw [map_zero]
        exact hr0
      have hφ : φ = 0 := (ev _).injective (hs.trans (hev0 _).symm)
      rw [hφ]
      first
        | exact Abelian.Ext.mk₀_zero
        | simp

  rw [injective_iff_map_eq_zero]
  intro x hx
  change (Abelian.Ext.mk₀ (θ ((wcProEtPullback D.f).obj V₀)).inv).comp
    ((Abelian.Ext.mapExactFunctor L x).comp
      (Abelian.Ext.mk₀ ((adj.homEquiv (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))
        (wcContSheaf (Limits.pullback D.f t) (ZMod (ℓ ^ k)))).symm
          (wcContPull (Limits.pullback.fst D.f t) (ZMod (ℓ ^ k))))) (add_zero j))
    (zero_add j) = 0 at hx

  have h1 : (Abelian.Ext.mapExactFunctor L x).comp
      (Abelian.Ext.mk₀ ((adj.homEquiv (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))
        (wcContSheaf (Limits.pullback D.f t) (ZMod (ℓ ^ k)))).symm
          (wcContPull (Limits.pullback.fst D.f t) (ZMod (ℓ ^ k))))) (add_zero j) = 0 := by
    have h4 : (Abelian.Ext.mk₀ (θ ((wcProEtPullback D.f).obj V₀)).hom).comp
        ((Abelian.Ext.mk₀ (θ ((wcProEtPullback D.f).obj V₀)).inv).comp
          ((Abelian.Ext.mapExactFunctor L x).comp
            (Abelian.Ext.mk₀ ((adj.homEquiv (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))
              (wcContSheaf (Limits.pullback D.f t) (ZMod (ℓ ^ k)))).symm
                (wcContPull (Limits.pullback.fst D.f t) (ZMod (ℓ ^ k))))) (add_zero j))
          (zero_add j)) (zero_add j) =
        (Abelian.Ext.mapExactFunctor L x).comp
          (Abelian.Ext.mk₀ ((adj.homEquiv (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))
            (wcContSheaf (Limits.pullback D.f t) (ZMod (ℓ ^ k)))).symm
              (wcContPull (Limits.pullback.fst D.f t) (ZMod (ℓ ^ k))))) (add_zero j) := by
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    rw [← h4, hx, Abelian.Ext.comp_zero]

  have h2 : (Abelian.Ext.mapExactFunctor (wcProEtPush (Limits.pullback.fst D.f t))
      (Abelian.Ext.mapExactFunctor L x)).comp
      (Abelian.Ext.mk₀ ((wcProEtPush (Limits.pullback.fst D.f t)).map
        ((adj.homEquiv (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))
          (wcContSheaf (Limits.pullback D.f t) (ZMod (ℓ ^ k)))).symm
            (wcContPull (Limits.pullback.fst D.f t) (ZMod (ℓ ^ k)))))) (add_zero j) = 0 := by
    have e1 := congrArg (Abelian.Ext.mapExactFunctor (wcProEtPush (Limits.pullback.fst D.f t))) h1
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀] at e1
    rw [e1]
    exact map_zero ((wcProEtPush (Limits.pullback.fst D.f t)).mapExtAddHom _ _ j)

  have hη : x.comp (Abelian.Ext.mk₀ (adj.unit.app (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))))
      (add_zero j) =
      (Abelian.Ext.mk₀ (adj.unit.app (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀)))).comp
        (Abelian.Ext.mapExactFunctor (wcProEtPush (Limits.pullback.fst D.f t))
          (Abelian.Ext.mapExactFunctor L x)) (zero_add j) := by
    have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp x adj.unit
    rw [Abelian.Ext.comp_mapExactFunctor, Abelian.Ext.id_mapExactFunctor] at h
    exact h
  have hu : adj.unit.app (wcContSheaf D.Yt.left (ZMod (ℓ ^ k))) ≫
      (wcProEtPush (Limits.pullback.fst D.f t)).map
        ((adj.homEquiv (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))
          (wcContSheaf (Limits.pullback D.f t) (ZMod (ℓ ^ k)))).symm
            (wcContPull (Limits.pullback.fst D.f t) (ZMod (ℓ ^ k)))) =
      wcContPull (Limits.pullback.fst D.f t) (ZMod (ℓ ^ k)) := by
    have e2 := adj.homEquiv_unit (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))
      (wcContSheaf (Limits.pullback D.f t) (ZMod (ℓ ^ k)))
      ((adj.homEquiv (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))
        (wcContSheaf (Limits.pullback D.f t) (ZMod (ℓ ^ k)))).symm
          (wcContPull (Limits.pullback.fst D.f t) (ZMod (ℓ ^ k))))
    rw [Equiv.apply_symm_apply] at e2
    exact e2.symm
  have h3 : x.comp (Abelian.Ext.mk₀ (wcContPull (Limits.pullback.fst D.f t) (ZMod (ℓ ^ k))))
      (add_zero j) = 0 := by
    have e1 : (Abelian.Ext.mk₀ (adj.unit.app
        (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀)))).comp
        ((Abelian.Ext.mapExactFunctor (wcProEtPush (Limits.pullback.fst D.f t))
          (Abelian.Ext.mapExactFunctor L x)).comp
          (Abelian.Ext.mk₀ ((wcProEtPush (Limits.pullback.fst D.f t)).map
            ((adj.homEquiv (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))
              (wcContSheaf (Limits.pullback D.f t) (ZMod (ℓ ^ k)))).symm
                (wcContPull (Limits.pullback.fst D.f t) (ZMod (ℓ ^ k)))))) (add_zero j))
        (zero_add j) = 0 := by
      rw [h2, Abelian.Ext.comp_zero]
    rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add j) (add_zero j) (show 0 + j + 0 = j by omega),
      ← hη, Abelian.Ext.comp_assoc _ _ _ (add_zero j) (add_zero 0) (show j + 0 + 0 = j by omega),
      Abelian.Ext.mk₀_comp_mk₀, hu] at e1
    exact e1

  have hepi : Epi (wcContPull (Limits.pullback.fst D.f t) (ZMod (ℓ ^ k))) :=
    wc_contPull_zmod_pow_epi (Limits.pullback.fst D.f t) ℓ k
  have hSE : (ShortComplex.mk (Limits.kernel.ι (wcContPull (Limits.pullback.fst D.f t)
      (ZMod (ℓ ^ k)))) (wcContPull (Limits.pullback.fst D.f t) (ZMod (ℓ ^ k)))
      (Limits.kernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel _) inferInstance hepi
  obtain ⟨x', hx'⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hSE x h3

  rw [← hx', hvan j x', Abelian.Ext.zero_comp]

theorem wc_pencil_point_nbhd_zmod_card_le (F' F'' K : Type u) [Field F'] [Field F''] [Algebra F' F'']
    [Field K] [Finite K] (Y : Over (Spec (.of F'))) (n : ℕ)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (t : Spec (.of K) ⟶ (wcP1Over F'').left) [IsClosedImmersion t]
    (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom t ≅ Spec (.of (AlgebraicClosure K)))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = t (IsLocalRing.closedPoint K))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) =
      Limits.pullback.snd V₀.hom t) (j k : ℕ) :
    Finite (Abelian.Ext (wcFreeSheaf (Limits.pullback D.f t)
        ((wcProEtPullback (Limits.pullback.fst D.f t)).obj ((wcProEtPullback D.f).obj V₀)))
      (wcContSheaf (Limits.pullback D.f t) (ZMod (ℓ ^ k))) j) ∧
    Nat.card (Abelian.Ext (wcFreeSheaf (Limits.pullback D.f t)
        ((wcProEtPullback (Limits.pullback.fst D.f t)).obj ((wcProEtPullback D.f).obj V₀)))
      (wcContSheaf (Limits.pullback D.f t) (ZMod (ℓ ^ k))) j) ≤
    Nat.card (Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback D.f).obj V₀))
      (wcContSheaf D.Yt.left (ZMod (ℓ ^ k))) j) :=
by

  have hm0 : ℓ ^ k ≠ 0 := pow_ne_zero _ (Fact.out : ℓ.Prime).ne_zero
  have hℓK : ((ℓ : ℕ) : AlgebraicClosure K) ≠ 0 := by
    intro hk
    have hk' : ((ℓ : ℕ) : K) = 0 := by
      apply (algebraMap K (AlgebraicClosure K)).injective
      rw [map_natCast, map_zero]
      exact hk
    haveI : Fintype K := Fintype.ofFinite K
    have hprime : Nat.Prime (ringChar K) := CharP.char_is_prime K (ringChar K)
    have h2 : ringChar K ∣ ℓ := (CharP.cast_eq_zero_iff K (ringChar K) _).mp hk'
    have h3 : ringChar K = ℓ := (Nat.prime_dvd_prime_iff_eq hprime (Fact.out : ℓ.Prime)).mp h2
    have h4 : ringChar K ∣ Nat.card K := by
      rw [Nat.card_eq_fintype_card]
      exact (CharP.cast_eq_zero_iff K (ringChar K) _).mp (FiniteField.cast_card_eq_zero K)
    exact hℓ (h3 ▸ h4)
  have hmK : ((ℓ ^ k : ℕ) : AlgebraicClosure K) ≠ 0 := by
    rw [Nat.cast_pow]
    exact pow_ne_zero _ hℓK

  haveI := D.proper
  haveI hpP : IsProper (wcP1Over F'').hom := wc_proj_space_isProper F'' 1
  haveI hpsep : IsSeparated (wcP1Over F'').hom := inferInstance
  haveI : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; infer_instance
  haveI : IsProper D.f := IsProper.of_comp D.f (wcP1Over F'').hom

  haveI hfW : IsProper (Limits.pullback.fst V₀.hom D.f ≫ e.hom) := inferInstance
  haveI hti : IsClosedImmersion (ε.inv ≫ Limits.pullback.fst V₀.hom t ≫ e.hom) :=
    inferInstance

  have qcsep : ∀ {X : Scheme.{u}} {R : CommRingCat.{u}} (g : X ⟶ Spec R) [IsProper g],
      CompactSpace X ∧ IsSeparated (Limits.terminal.from X) := by
    intro X R g _
    refine ⟨QuasiCompact.compactSpace_of_compactSpace g, ?_⟩
    rw [show Limits.terminal.from X = g ≫ Limits.terminal.from (Spec R) from
      Limits.terminal.hom_ext _ _]
    infer_instance

  obtain ⟨φ', hφ'⟩ : ∃ φ' : A →+* AlgebraicClosure K,
      Spec.map (CommRingCat.ofHom φ') = ε.inv ≫ Limits.pullback.fst V₀.hom t ≫ e.hom :=
    ⟨(Spec.preimage (ε.inv ≫ Limits.pullback.fst V₀.hom t ≫ e.hom)).hom, by
      rw [CommRingCat.ofHom_hom, Spec.map_preimage]⟩
  have hsurj : Function.Surjective φ' := by
    have h1 : Function.Surjective (Spec.map (CommRingCat.ofHom φ')).appTop.hom := by
      rw [hφ']
      exact (IsClosedImmersion.isAffine_surjective_of_isAffine _).2
    intro y
    obtain ⟨x, hx⟩ := h1 ((Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure K))).inv.hom y)
    refine ⟨(Scheme.ΓSpecIso (CommRingCat.of A)).hom.hom x, ?_⟩
    have h2 : (Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure K))).hom.hom
        ((Spec.map (CommRingCat.ofHom φ')).appTop.hom x) =
        φ' ((Scheme.ΓSpecIso (CommRingCat.of A)).hom.hom x) := by
      have := congrArg (fun g => g.hom x) (Scheme.ΓSpecIso_naturality (CommRingCat.ofHom φ'))
      exact this
    rw [← h2, hx]
    have h3 := congrArg (fun g => g.hom y)
      (Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure K))).inv_hom_id
    exact h3
  haveI : IsLocalHom φ' := IsLocalHom.of_surjective φ' hsurj
  have hψbij : Function.Bijective (IsLocalRing.ResidueField.lift φ') := by
    refine ⟨(IsLocalRing.ResidueField.lift φ').injective, ?_⟩
    intro y
    obtain ⟨a, rfl⟩ := hsurj y
    exact ⟨IsLocalRing.residue A a, IsLocalRing.ResidueField.lift_residue_apply φ' a⟩
  haveI hσiso : IsIso (Spec.map (CommRingCat.ofHom (IsLocalRing.ResidueField.lift φ'))) :=
    isIso_SpecMap_iff.mpr hψbij
  have hcomp : CommRingCat.ofHom (IsLocalRing.residue A) ≫
      CommRingCat.ofHom (IsLocalRing.ResidueField.lift φ') = CommRingCat.ofHom φ' := by
    ext a
    exact IsLocalRing.ResidueField.lift_residue_apply φ' a
  have hσr : Spec.map (CommRingCat.ofHom (IsLocalRing.ResidueField.lift φ')) ≫
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) =
      ε.inv ≫ Limits.pullback.fst V₀.hom t ≫ e.hom := by
    rw [← Spec.map_comp, hcomp, hφ']

  have paste : ∀ {T : Scheme.{u}} (r : T ⟶ Spec (.of A)) (τ : Limits.pullback V₀.hom t ≅ T),
      τ.hom ≫ r = Limits.pullback.fst V₀.hom t ≫ e.hom →
      ∃ g : Limits.pullback (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f t) ⟶ T,
        IsPullback g (Limits.pullback.fst (Limits.pullback.snd V₀.hom D.f)
          (Limits.pullback.fst D.f t)) r (Limits.pullback.fst V₀.hom D.f ≫ e.hom) := by
    intro T r τ hτ
    have hL : IsPullback (Limits.pullback.snd (Limits.pullback.snd V₀.hom D.f)
          (Limits.pullback.fst D.f t))
        (Limits.pullback.fst (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f t))
        (Limits.pullback.fst D.f t) (Limits.pullback.snd V₀.hom D.f) :=
      (IsPullback.of_hasPullback _ _).flip
    have hR : IsPullback (Limits.pullback.snd D.f t) (Limits.pullback.fst D.f t)
        t D.f := (IsPullback.of_hasPullback _ _).flip
    have hO := hL.paste_horiz hR
    have hR2 : IsPullback (Limits.pullback.snd V₀.hom t) (Limits.pullback.fst V₀.hom t)
        t V₀.hom := (IsPullback.of_hasPullback _ _).flip
    have hcw : (Limits.pullback.fst (Limits.pullback.snd V₀.hom D.f)
          (Limits.pullback.fst D.f t) ≫ Limits.pullback.fst V₀.hom D.f) ≫ V₀.hom =
        (Limits.pullback.snd (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f t) ≫
          Limits.pullback.snd D.f t) ≫ t := by
      simp only [Category.assoc]
      rw [Limits.pullback.condition (f := V₀.hom) (g := D.f)]
      have hw := hO.w
      simp only [Category.assoc] at hw
      exact hw.symm
    let c : Limits.pullback (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f t) ⟶
        Limits.pullback V₀.hom t :=
      Limits.pullback.lift _ _ hcw
    have hc1 : c ≫ Limits.pullback.fst V₀.hom t =
        Limits.pullback.fst (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f t) ≫
          Limits.pullback.fst V₀.hom D.f := Limits.pullback.lift_fst _ _ _
    have hc2 : c ≫ Limits.pullback.snd V₀.hom t =
        Limits.pullback.snd (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f t) ≫
          Limits.pullback.snd D.f t := Limits.pullback.lift_snd _ _ _
    have s : IsPullback (c ≫ Limits.pullback.snd V₀.hom t)
        (Limits.pullback.fst (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f t))
        t (Limits.pullback.fst V₀.hom D.f ≫ V₀.hom) := by
      rw [hc2, Limits.pullback.condition (f := V₀.hom) (g := D.f)]
      exact hO
    have hLeft := IsPullback.of_right s hc1 hR2
    refine ⟨c ≫ τ.hom, ?_⟩
    refine hLeft.of_iso (Iso.refl _) τ (Iso.refl _) e ?_ ?_ ?_ ?_ <;> simp [hτ]

  obtain ⟨g₂, hP2⟩ := paste (ε.inv ≫ Limits.pullback.fst V₀.hom t ≫ e.hom) ε
    (Iso.hom_inv_id_assoc _ _)
  obtain ⟨g₁, hP1⟩ := paste (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))
    (ε ≪≫ asIso (Spec.map (CommRingCat.ofHom (IsLocalRing.ResidueField.lift φ')))) (by
      rw [Iso.trans_hom, asIso_hom, Category.assoc, hσr, Iso.hom_inv_id_assoc])
  haveI hg₂ : IsProper g₂ := MorphismProperty.of_isPullback (P := @IsProper) hP2.flip hfW
  let β₁ := hP1.flip.isoPullback

  obtain ⟨hW1, hW2⟩ := qcsep (Limits.pullback.fst V₀.hom D.f ≫ e.hom)
  obtain ⟨hW'1, hW'2⟩ := qcsep g₂

  have L1 : ∀ (S : Scheme.{u}) (U : S.ProEt) [CompactSpace U.left]
      [IsSeparated (Limits.terminal.from U.left)],
      Nonempty (Abelian.Ext (wcFreeSheaf S U) (wcContSheaf S (ZMod (ℓ ^ k))) j ≃
        wcEtCoh U.left (ℓ ^ k) j) := by
    intro S U _ _
    obtain ⟨E₁⟩ := wc_ext_free_slice_cont S U (ZMod (ℓ ^ k)) j
    obtain ⟨-, hcont⟩ := wc_etToProEt_flat_cont U.left
    haveI := hcont
    obtain ⟨c₁⟩ := wc_contSheaf_discrete_const U.left (ZMod (ℓ ^ k))
    obtain ⟨c₂⟩ := wc_epsInv_const U.left (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ k))))
    let c := c₁ ≪≫ c₂.symm
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology U.left) AddCommGrpCat.{u+1}) :=
      HasExt.standard _
    obtain ⟨E₃⟩ := wc_proet_etale_comparison_epsInv_qcsep U.left
      ((constantSheaf (Scheme.smallEtaleTopology U.left) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ k))))) j
    have key1 : ∀ x : Abelian.Ext (wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left)))
        (wcContSheaf U.left (ZMod (ℓ ^ k))) j,
        (x.comp (Abelian.Ext.mk₀ c.hom) (add_zero j)).comp (Abelian.Ext.mk₀ c.inv)
          (add_zero j) = x := by
      intro x
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id]
      exact Abelian.Ext.comp_mk₀_id x
    have key2 : ∀ y : Abelian.Ext (wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left)))
        ((wcEpsInv U.left).obj ((constantSheaf (Scheme.smallEtaleTopology U.left)
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ k)))))) j,
        (y.comp (Abelian.Ext.mk₀ c.inv) (add_zero j)).comp (Abelian.Ext.mk₀ c.hom)
          (add_zero j) = y := by
      intro y
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id]
      exact Abelian.Ext.comp_mk₀_id y
    let E₂ : Abelian.Ext (wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left)))
        (wcContSheaf U.left (ZMod (ℓ ^ k))) j ≃
        Abelian.Ext (wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left)))
        ((wcEpsInv U.left).obj ((constantSheaf (Scheme.smallEtaleTopology U.left)
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ k)))))) j :=
      { toFun := fun x => x.comp (Abelian.Ext.mk₀ c.hom) (add_zero j)
        invFun := fun y => y.comp (Abelian.Ext.mk₀ c.inv) (add_zero j)
        left_inv := key1
        right_inv := key2 }
    exact ⟨E₁.trans (E₂.trans E₃)⟩

  obtain ⟨eS⟩ := @L1 D.Yt.left ((wcProEtPullback D.f).obj V₀) hW1 hW2
  obtain ⟨eT⟩ := @L1 (Limits.pullback D.f t)
    ((wcProEtPullback (Limits.pullback.fst D.f t)).obj ((wcProEtPullback D.f).obj V₀))
    hW'1 hW'2
  obtain ⟨eH⟩ := wc_et_henselian_closed_fibre_coh A (Limits.pullback V₀.hom D.f)
    (Limits.pullback.fst V₀.hom D.f ≫ e.hom) (ℓ ^ k) hm0 wc_et_henselian_proper_vanishing j
  obtain ⟨eI⟩ := wc_et_coh_iso_invariance β₁.hom (ℓ ^ k) j
  have hfinW' := wc_etale_proper_finite (AlgebraicClosure K)
    (Limits.pullback (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f t)) g₂
    (ℓ ^ k) hmK j
  have hfinT := @Finite.of_equiv _ _ hfinW' eT.symm
  exact ⟨hfinT, le_of_eq (Nat.card_congr (eS.trans (eH.trans (eI.trans eT.symm)))).symm⟩

theorem wc_pencil_point_nbhd_sections_pbc (F' F'' K : Type u) [Field F'] [Field F''] [Algebra F' F'']
    [Field K] [Finite K] (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (t : Spec (.of K) ⟶ (wcP1Over F'').left)
    (ht : ∀ i, t (IsLocalRing.closedPoint K) ≠ D.S i (IsLocalRing.closedPoint F''))
    (hX : WeaklyEtale (Limits.pullback.fst (Over.mk (Limits.pullback.snd D.f t)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (k : ℕ) (V₀ : (wcP1Over F'').left.ProEt) (φ₀ : V₀ ⟶ V₀)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom t ≅ Spec (.of (AlgebraicClosure K)))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = t (IsLocalRing.closedPoint K))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) =
      Limits.pullback.snd V₀.hom t)
    (hεφ : ε.inv ≫ Limits.pullback.fst V₀.hom t ≫ φ₀.left =
      Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic K _
        (Fintype.ofFinite K) (AlgebraicClosure K) _ _ _).symm :
          AlgebraicClosure K →+* AlgebraicClosure K)) ≫
        ε.inv ≫ Limits.pullback.fst V₀.hom t) :
    ∃ Ψ : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V₀) (wcRq D.f ℓ k) 0 →+
        wcCoh K (Over.mk (Limits.pullback.snd D.f t)) hX ℓ k,
      Function.Bijective Ψ ∧
      (∀ (c : ℚ_[ℓ]) (y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V₀) (wcRq D.f ℓ k) 0),
        Ψ (y.comp (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ k c)) (add_zero 0)) =
          wcCohScalar K (Over.mk (Limits.pullback.snd D.f t)) hX ℓ k c (Ψ y)) ∧
      ∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V₀) (wcRq D.f ℓ k) 0,
        Ψ ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left φ₀)).comp y (zero_add 0)) =
          wcCohFrob K (Over.mk (Limits.pullback.snd D.f t)) hX ℓ k (Ψ y) :=
by
  classical

  have F0 : ∀ {S : Scheme.{u}} {U V W : S.ProEt} (a : U ⟶ V) (b : V ⟶ W),
      wcFreeSheafMap S (a ≫ b) = wcFreeSheafMap S a ≫ wcFreeSheafMap S b := by
    intro S U V W a b
    simp only [wcFreeSheafMap, Functor.map_comp, Functor.whiskerRight_comp] <;> rfl
  have Fid : ∀ {S : Scheme.{u}} (U : S.ProEt), wcFreeSheafMap S (𝟙 U) = 𝟙 _ := by
    intro S U
    simp only [wcFreeSheafMap, CategoryTheory.Functor.map_id, Functor.whiskerRight_id'] <;> rfl

  haveI hti : IsClosedImmersion t := wc_pencil_point_isClosedImmersion F'' K t V₀ A e ε hv

  obtain ⟨β, hβ⟩ : ∃ β : (wcProEtPullback (Limits.pullback.fst D.f t)).obj
        ((wcProEtPullback D.f).obj V₀) ≅
        wcGeomPoint K (Over.mk (Limits.pullback.snd D.f t)) hX,
      (wcProEtPullback (Limits.pullback.fst D.f t)).map ((wcProEtPullback D.f).map φ₀) ≫
          β.hom = β.hom ≫ wcGeomFrob K (Over.mk (Limits.pullback.snd D.f t)) hX := by
    have key : ∀ {V Yt P S Sb : Scheme.{u}} (v : V ⟶ P) (f : Yt ⟶ P) (u : S ⟶ P) (a : Sb ⟶ S)
        (ε : Limits.pullback v u ≅ Sb) (hε : ε.hom ≫ a = Limits.pullback.snd v u),
        ∃ β₀ : Limits.pullback (Limits.pullback.snd v f) (Limits.pullback.fst f u) ≅
            Limits.pullback (Limits.pullback.snd f u) a,
          β₀.hom ≫ Limits.pullback.fst (Limits.pullback.snd f u) a =
              Limits.pullback.snd (Limits.pullback.snd v f) (Limits.pullback.fst f u) ∧
          β₀.hom ≫ Limits.pullback.snd (Limits.pullback.snd f u) a ≫ ε.inv ≫
              Limits.pullback.fst v u =
            Limits.pullback.fst (Limits.pullback.snd v f) (Limits.pullback.fst f u) ≫
              Limits.pullback.fst v f := by
      intro V Yt P S Sb v f u a ε hε
      have hε' : ε.inv ≫ Limits.pullback.snd v u = a := by rw [← hε, Iso.inv_hom_id_assoc]
      have hε'' := reassoc_of% hε'
