  have s1 : ∀ (K : CochainComplex D ℕ) (j : ℕ), ∃ (B : D) (u : K.X j ⟶ B) (v : B ⟶ K.cycles (j + 1)) (h1 : K.iCycles j ≫ u = 0) (h2 : v ≫ K.homologyπ (j + 1) = 0), (ShortComplex.mk _ _ h1).ShortExact ∧ (ShortComplex.mk _ _ h2).ShortExact ∧ u ≫ v ≫ K.iCycles (j + 1) = K.d j (j + 1) := by
