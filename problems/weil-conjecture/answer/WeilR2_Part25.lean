      (x.comp (Abelian.Ext.mk₀ (wcLadicScalar S ℓ c)) (add_zero jd)).comp
        (Abelian.Ext.mk₀ (wcLadicScalar S ℓ c⁻¹)) (add_zero jd) = x := by
    intro S P jd x c hc0
    obtain ⟨h1, hmul, -⟩ := wc_ladic_scalar_ring S ℓ
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, ← hmul,
      inv_mul_cancel₀ hc0, h1, Abelian.Ext.comp_mk₀_id]

  have hpost : ∀ {G G' : Sheaf (Scheme.ProEt.topology (Limits.pullback D.f (D.S i)))
      AddCommGrpCat.{u+1}} (r : G ⟶ G')
      (z z' : Abelian.Ext (wcFreeSheaf (Limits.pullback D.f (D.S i)) VT) G (n - 1)) (N : ℕ),
      (z - N • z').comp (Abelian.Ext.mk₀ r) (add_zero (n - 1)) =
        z.comp (Abelian.Ext.mk₀ r) (add_zero (n - 1)) -
          N • z'.comp (Abelian.Ext.mk₀ r) (add_zero (n - 1)) := by
    intro G G' r z z' N
    have h1 := map_sub ((Abelian.Ext.mk₀ r).postcomp
      (wcFreeSheaf (Limits.pullback D.f (D.S i)) VT) (add_zero (n - 1))) z (N • z')
    have h2 := map_nsmul ((Abelian.Ext.mk₀ r).postcomp
      (wcFreeSheaf (Limits.pullback D.f (D.S i)) VT) (add_zero (n - 1))) N z'
    rw [h2] at h1
    exact h1
  have hpreS : ∀ {G : Sheaf (Scheme.ProEt.topology (Limits.pullback D.f (D.S i)))
      AddCommGrpCat.{u+1}}
      (z : Abelian.Ext (wcFreeSheaf (Limits.pullback D.f (D.S i)) VT) G (n - 1)) (N : ℕ),
      (Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f (D.S i)) φV)).comp (N • z)
          (zero_add (n - 1)) =
        N • (Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f (D.S i)) φV)).comp z
          (zero_add (n - 1)) := by
    intro G z N
    exact map_nsmul ((Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f (D.S i)) φV)).precomp
      G (zero_add (n - 1))) N z
  have hlev : ∀ {G G' : Sheaf (Scheme.ProEt.topology (Limits.pullback D.f (D.S i)))
      AddCommGrpCat.{u+1}} (r : G ⟶ G')
      (z : Abelian.Ext (wcFreeSheaf (Limits.pullback D.f (D.S i)) VT) G (n - 1)),
      ((Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f (D.S i)) φV)).comp
        ((Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f (D.S i)) φV)).comp z
          (zero_add (n - 1))) (zero_add (n - 1)) - (Nat.card F'' ^ n) • z).comp
          (Abelian.Ext.mk₀ r) (add_zero (n - 1)) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f (D.S i)) φV)).comp
          ((Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f (D.S i)) φV)).comp
            (z.comp (Abelian.Ext.mk₀ r) (add_zero (n - 1))) (zero_add (n - 1)))
            (zero_add (n - 1)) -
          (Nat.card F'' ^ n) • z.comp (Abelian.Ext.mk₀ r) (add_zero (n - 1)) := by
    intro G G' r z
    rw [hpost, Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.comp_assoc_of_third_deg_zero]

  rw [show ((Nat.card F'' : ℚ_[ℓ]) ^ n) = ((Nat.card F'' ^ n : ℕ) : ℚ_[ℓ]) from
    (Nat.cast_pow (Nat.card F'') n).symm, ← Q1]

  obtain ⟨a, y, hy⟩ :=
    (proet_qcqs_ladic_rationalization (Limits.pullback D.f (D.S i)) VT ℓ (n - 1)).1 w

  have hy2 : (Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f (D.S i)) φV)).comp
      ((Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f (D.S i)) φV)).comp y
        (zero_add (n - 1))) (zero_add (n - 1)) = (Nat.card F'' ^ n) • y := by
    rw [← sub_eq_zero]
    refine wc_proet_int_separated_of_finite (Limits.pullback D.f (D.S i)) VT ℓ hc hfin (n - 1) _ ?_
    intro k
    refine (hlev (wcContSheafMap (Limits.pullback D.f (D.S i))
      (PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom (hc k)) y).trans ?_
    rw [htor k, sub_self]

  have hD : ℓ ^ a • ((Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f (D.S i)) φV)).comp
      ((Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f (D.S i)) φV)).comp w
        (zero_add (n - 1))) (zero_add (n - 1)) - (Nat.card F'' ^ n) • w) = 0 := by
    rw [smul_sub, smul_comm (ℓ ^ a) (Nat.card F'' ^ n) w, ← hpreS, ← hpreS, hy,
      ← Abelian.Ext.comp_assoc_of_third_deg_zero, ← Abelian.Ext.comp_assoc_of_third_deg_zero,
      ← hpost, hy2, sub_self, Abelian.Ext.zero_comp]

  have hz : (Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f (D.S i)) φV)).comp
      ((Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f (D.S i)) φV)).comp w
        (zero_add (n - 1))) (zero_add (n - 1)) - (Nat.card F'' ^ n) • w = 0 := by
    have h5 := hinv _ _ (n - 1) ((Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f (D.S i)) φV)).comp
      ((Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f (D.S i)) φV)).comp w
        (zero_add (n - 1))) (zero_add (n - 1)) - (Nat.card F'' ^ n) • w) ((ℓ : ℚ_[ℓ]) ^ a)
