theorem wc_frobNbhd_point_fibre_data (K : Type u) [Field K] [Finite K] (d : ℕ) (hd : 1 ≤ d)
    (x : (wcP1Over K).left) (hx : x ∈ wcP1ClosedPt K d) (N : wcFrobNbhd K x d)
    (hfin : Finite ((wcP1Over K).left.residueField x)) :
    ∃ ε : Limits.pullback N.V.hom ((wcP1Over K).left.fromSpecResidueField x) ≅
