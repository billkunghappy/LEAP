  obtain ⟨t, τ', M, hmt, hmτ, hcub, hdet⟩ := key _ hpY
  have hker := wc_cpfo_stalk_ker_closed_pt_base_change j
    (T.hom ≫ Limits.pullback.snd D.f (D.S i))
    (Limits.pullback.fst D.Yt.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) D.f (D.S i) hC xb
    τ' hmτ

  haveI hqYs : SmoothOfRelativeDimension n (Limits.pullback.snd D.Yt.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension n) hBot D.smooth
  haveI : LocallyOfFiniteType (Limits.pullback.snd D.Yt.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @LocallyOfFiniteType) hBot inferInstance
  haveI : IsLocallyNoetherian (Limits.pullback D.Yt.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd D.Yt.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))
  have hdim := wc_lfi_smooth_stalk_dim (AlgebraicClosure F'') _ (Limits.pullback.snd D.Yt.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) n (j xb) hyc
  have hxsY : D.xs i ≫ D.Yt.hom = 𝟙 _ := by
    rw [← D.hf, ← Category.assoc, D.hxs i, D.hS i]
  have hmapm := wc_lfi_rational_fibre_maxIdeal F'' (AlgebraicClosure F'')
    (algebraMap F'' (AlgebraicClosure F'')) D.Yt.left _ D.Yt.hom
    (Limits.pullback.snd D.Yt.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))
    (Limits.pullback.fst D.Yt.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) hBot (D.xs i) hxsY
    (j xb) ⟨IsLocalRing.closedPoint F'', hpY.symm⟩
  obtain ⟨ρ, hρ⟩ : ∃ ρ, ρ = ((Limits.pullback.fst D.Yt.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))).stalkMap
