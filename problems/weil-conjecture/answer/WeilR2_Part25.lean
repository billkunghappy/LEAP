      exact hy
    calc x = x.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero 1) := (Abelian.Ext.comp_mk₀_id x).symm
      _ = x.comp (Abelian.Ext.mk₀ (wcLadicScalar (wcP1Over K).left ℓ
            (((ℓ : ℚ_[ℓ]) ^ n)⁻¹ * (ℓ : ℚ_[ℓ]) ^ n))) (add_zero 1) := by
          rw [inv_mul_cancel₀ hc, hs1]
      _ = (x.comp (Abelian.Ext.mk₀ (wcLadicScalar (wcP1Over K).left ℓ ((ℓ : ℚ_[ℓ]) ^ n)))
            (add_zero 1)).comp (Abelian.Ext.mk₀ (wcLadicScalar (wcP1Over K).left ℓ
              (((ℓ : ℚ_[ℓ]) ^ n)⁻¹))) (add_zero 1) := by
          rw [hmul, Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀]
      _ = 0 := by rw [key, Abelian.Ext.zero_comp]
  have hLad' : ∀ x : Abelian.Ext (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP))
      (wcContSheaf (wcP1Over K).left ℚ_[ℓ]) 1, x = 0 := fun x => hLad x

  have g9 : ∀ (r : ℕ) (x : Abelian.Ext (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP))
      (wcContSheaf (wcP1Over K).left (Fin r → ℚ_[ℓ])) 1), x = 0 := by
    intro r
    induction r with
    | zero =>
      intro x
      have hz : 𝟙 (wcContSheaf (wcP1Over K).left (Fin 0 → ℚ_[ℓ])) = 0 := by
        apply Sheaf.hom_ext
        apply NatTrans.ext
        funext W
        apply AddCommGrpCat.ext
        intro t
        apply ULift.ext
        apply ContinuousMap.ext
        intro p
        exact Subsingleton.elim _ _
      calc x = x.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero 1) := (Abelian.Ext.comp_mk₀_id x).symm
        _ = x.comp (Abelian.Ext.mk₀ 0) (add_zero 1) := by rw [hz]
        _ = 0 := by rw [Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    | succ r ih =>
      intro y
      let φ : ℚ_[ℓ] →+ (Fin (r + 1) → ℚ_[ℓ]) := AddMonoidHom.single (fun _ : Fin (r + 1) => ℚ_[ℓ]) 0
      let ψ : (Fin (r + 1) → ℚ_[ℓ]) →+ (Fin r → ℚ_[ℓ]) :=
        { toFun := fun b j => b j.succ
          map_zero' := rfl
          map_add' := fun _ _ => rfl }
      have hφapp : ∀ a : ℚ_[ℓ], φ a = Pi.single 0 a := fun a => rfl
      have hψapp : ∀ (b : Fin (r + 1) → ℚ_[ℓ]) (j : Fin r), ψ b j = b j.succ := fun b j => rfl
      have hφ : Continuous φ := by
        have : (⇑φ) = fun a : ℚ_[ℓ] => (Pi.single 0 a : Fin (r + 1) → ℚ_[ℓ]) := funext hφapp
        rw [this]
        exact continuous_single (A := fun _ : Fin (r + 1) => ℚ_[ℓ]) 0
      have hψ : Continuous ψ := by
        have : (⇑ψ) = fun (b : Fin (r + 1) → ℚ_[ℓ]) (j : Fin r) => b j.succ := rfl
        rw [this]
        exact continuous_pi fun j => continuous_apply _
      have hemb : Topology.IsEmbedding φ := by
        refine Function.LeftInverse.isEmbedding (f := fun b : Fin (r + 1) → ℚ_[ℓ] => b 0)
          (fun a => ?_) (continuous_apply 0) hφ
        show φ a 0 = a
        rw [hφapp, Pi.single_eq_same]
      have hker : ∀ b : Fin (r + 1) → ℚ_[ℓ], ψ b = 0 ↔ ∃ a : ℚ_[ℓ], φ a = b := by
        intro b
        constructor
        · intro hb
          refine ⟨b 0, ?_⟩
          funext i
          refine Fin.cases ?_ (fun j => ?_) i
          · rw [hφapp, Pi.single_eq_same]
          · rw [hφapp, Pi.single_eq_of_ne (Fin.succ_ne_zero j)]
            have := congrFun hb j
            rw [hψapp] at this
            exact this.symm
        · rintro ⟨a, rfl⟩
          funext j
          rw [hψapp, hφapp, Pi.single_eq_of_ne (Fin.succ_ne_zero j)]
          rfl
      have hsec : ∃ σ : (Fin r → ℚ_[ℓ]) → (Fin (r + 1) → ℚ_[ℓ]), Continuous σ ∧ ∀ c, ψ (σ c) = c := by
        refine ⟨fun c => Fin.cons (0 : ℚ_[ℓ]) c, Continuous.finCons continuous_const continuous_id, ?_⟩
        intro c
        funext j
        rw [hψapp]
        exact Fin.cons_succ _ _ _
      obtain ⟨hzero, hS⟩ := wc_contSheaf_shortExact (wcP1Over K).left φ hφ ψ hψ hemb hker hsec
      obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hS y (ih _)
      rw [← hx₁, show x₁ = 0 from hLad' x₁, Abelian.Ext.zero_comp]

  obtain ⟨r, ⟨eG⟩⟩ := hG
  intro x
  letI : HasExt (Sheaf ((Scheme.ProEt.topology (wcP1Over K).left).over
      (wcGeomPoint K (wcP1Over K) hP)) AddCommGrpCat.{u+1}) := HasExt.standard _
  obtain ⟨φG⟩ := wc_proet_free_slice_ext_equiv (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP) G 1
  obtain ⟨φH⟩ := wc_proet_free_slice_ext_equiv (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)
    (wcContSheaf (wcP1Over K).left (Fin r → ℚ_[ℓ])) 1
  have h1 : (φG x).comp (Abelian.Ext.mk₀ eG.hom) (add_zero 1) = 0 := by
    have h0 := g9 r (φH.symm ((φG x).comp (Abelian.Ext.mk₀ eG.hom) (add_zero 1)))
    have h0' := congrArg φH h0
    rw [AddEquiv.apply_symm_apply, map_zero] at h0'
    exact h0'
  have h2 : φG x = 0 := by
    calc φG x = ((φG x).comp (Abelian.Ext.mk₀ eG.hom) (add_zero 1)).comp
          (Abelian.Ext.mk₀ eG.inv) (add_zero 1) := by
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
      _ = 0 := by rw [h1, Abelian.Ext.zero_comp]
  exact φG.injective (h2.trans (map_zero φG).symm)

theorem wc_pencil_VQ_weight_of_honest_fixed (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (H : wcHonestPL D ℓ hP)
    (hfix : ∀ γ : H.W ⟶ H.W, γ ≫ H.w = H.w → ∀ u ∈ wcHonestEhon H, H.fr γ u = u) :
    ∀ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β →
      β ^ 2 = algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n) :=
by
  classical

  have s1 : ∀ {V : Type (u+1)} [AddCommGroup V] (s : ℚ_[ℓ] → V →+ V) (Φ : V →+ V),
      (∀ (c : ℚ_[ℓ]) (x : V), Φ (s c x) = s c (Φ x)) → ∀ (k : ℕ), (∀ x : V, Φ (Φ x) = k • x) →
      ∀ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ s Φ β →
        β ^ 2 = algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) (k : ℚ_[ℓ]) := by
    intro V _ s Φ hΦ k hk β hβ
    obtain ⟨r, e, he, hroot⟩ := hβ
    have hes : ∀ (c : ℚ_[ℓ]) (v : Fin r → ℚ_[ℓ]), e.symm (c • v) = s c (e.symm v) := fun c v =>
      e.injective (by rw [he, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
    let L : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]) :=
      { toFun := fun v => e (Φ (e.symm v))
        map_add' := fun v w => by simp only [map_add]
        map_smul' := fun c v => by simp only [hes, hΦ, he, RingHom.id_apply] }
    have hA : wcAddEquivMatrix e Φ = LinearMap.toMatrix' L := by
      ext a b
      rw [LinearMap.toMatrix'_apply]
      rfl
    have hLL : L ∘ₗ L = (k : ℚ_[ℓ]) • LinearMap.id := by
      apply LinearMap.ext
      intro v
      show e (Φ (e.symm (e (Φ (e.symm v))))) = (k : ℚ_[ℓ]) • v
      rw [AddEquiv.symm_apply_apply, hk, map_nsmul, AddEquiv.apply_symm_apply]
      exact (Nat.cast_smul_eq_nsmul ℚ_[ℓ] k v).symm
    have hA2 : wcAddEquivMatrix e Φ * wcAddEquivMatrix e Φ =
        (k : ℚ_[ℓ]) • (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) := by
      rw [hA, ← LinearMap.toMatrix'_comp, hLL, map_smul, LinearMap.toMatrix'_id]
    set f : ℚ_[ℓ] →+* AlgebraicClosure ℚ_[ℓ] := algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) with hf
    set A := wcAddEquivMatrix e Φ with hAdef
    rw [Polynomial.mem_aroots] at hroot
    obtain ⟨_, hμ⟩ := hroot
    have hdet : (Matrix.scalar (Fin r) β - A.map f).det = 0 := by
      rw [← Matrix.eval_charpoly, Matrix.charpoly_map, Polynomial.eval_map, ← Polynomial.aeval_def]
      exact hμ
    obtain ⟨v, hv0, hv⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
    have hAv : (A.map f).mulVec v = β • v := by
      rw [Matrix.sub_mulVec, sub_eq_zero] at hv
      rw [← hv, Matrix.scalar_apply]
      ext x
      simp [Matrix.mulVec_diagonal]
    have hA2L : (A.map f) * (A.map f) =
        f (k : ℚ_[ℓ]) • (1 : Matrix (Fin r) (Fin r) (AlgebraicClosure ℚ_[ℓ])) := by
      rw [← Matrix.map_mul, hA2]
      ext a b
      simp only [Matrix.map_apply, Matrix.smul_apply, Matrix.one_apply, smul_eq_mul]
      split_ifs <;> simp
    have h2 : (β * β) • v = f (k : ℚ_[ℓ]) • v := by
      have h4 : ((A.map f) * (A.map f)).mulVec v =
          (f (k : ℚ_[ℓ]) • (1 : Matrix (Fin r) (Fin r) (AlgebraicClosure ℚ_[ℓ]))).mulVec v := by
        rw [hA2L]
      rw [← Matrix.mulVec_mulVec, hAv, Matrix.mulVec_smul, hAv, smul_smul, Matrix.smul_mulVec,
        Matrix.one_mulVec] at h4
      exact h4
    obtain ⟨a, ha⟩ := Function.ne_iff.mp hv0
    have h3 := congrFun h2 a
    simp only [Pi.smul_apply, smul_eq_mul] at h3
    rw [pow_two]
    exact mul_right_cancel₀ ha h3

  set Fr := Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left (wcGeomFrob F'' (wcP1Over F'') hP))
    with hFr

  have hcomm : ∀ (c : ℚ_[ℓ]) (x : wcCohG F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1),
      wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1
        (wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c) x) =
      wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c)
        (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 x) := by
    intro c x
    show Fr.comp (x.comp (Abelian.Ext.mk₀ (wcPencilVQScalar D ℓ hP c)) (add_zero 1)) (zero_add 1) =
      (Fr.comp x (zero_add 1)).comp (Abelian.Ext.mk₀ (wcPencilVQScalar D ℓ hP c)) (add_zero 1)
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add 1) (add_zero 1) (by omega)).symm

  obtain ⟨G, P, ι, π, hw, hSE, hG, hsupp⟩ :=
    wc_honest_fixed_VQ_gc_envelope F' F'' Y n hn hn2 D ℓ hℓ hP H hfix
  have hPk := wc_pencil_VQ_envelope_punct_frob_sq F' F'' Y n hn hn2 D ℓ hℓ hP G P ι π hw hSE hG
    hsupp

  have hVQ : ∀ x : wcCohG F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1,
      wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1
        (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 x) = (Nat.card F'' ^ n) • x := by
    intro x
    have h0 : x.comp (Abelian.Ext.mk₀ (ShortComplex.mk ι π hw).f) (add_zero 1) = 0 :=
      wc_P1_H1_geomConst_vanish F'' hP ℓ hℓ G hG _
    obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hSE x h0 (zero_add 1)
    have hδ : ∀ z : wcCohG F'' (wcP1Over F'') hP P 0,
        wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (z.comp hSE.extClass (zero_add 1)) =
          (wcCohGFrob F'' (wcP1Over F'') hP P 0 z).comp hSE.extClass (zero_add 1) := by
      intro z
      show Fr.comp (z.comp hSE.extClass (zero_add 1)) (zero_add 1) =
        (Fr.comp z (zero_add 0)).comp hSE.extClass (zero_add 1)
      exact (Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add 1) (by omega)).symm
    rw [← hy, hδ, hδ, hPk y]
    exact map_nsmul (hSE.extClass.postcomp (wcFreeSheaf (wcP1Over F'').left
      (wcGeomPoint F'' (wcP1Over F'') hP)) (zero_add 1)) (Nat.card F'' ^ n) y
  intro β hβ
  have h' := s1 (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1
      (wcPencilVQScalar D ℓ hP c))
    (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) hcomm (Nat.card F'' ^ n) hVQ β hβ
  rw [Nat.cast_pow] at h'
  exact h'

theorem wc_proet_theta_sub_over_triv (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (W : S.ProEt) (N : ℕ)
    (θ : G.over W ≅ (wcContSheaf S (Fin N → ℚ_[ℓ])).over W)
    (U : Submodule ℚ_[ℓ] (Fin N → ℚ_[ℓ]))
    (hU : ∀ (V : S.ProEt) (h₁ h₂ : V ⟶ W) (x : G.obj.obj (Opposite.op V)),
      (∀ z : V.left, wcContEval S V ((θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x) z ∈ U) →
      ∀ z : V.left, wcContEval S V ((θ.hom.hom.app (Opposite.op (Over.mk h₂))).hom x) z ∈ U)
    (M : Subobject G)
    (hM : ∀ (T : S.ProEt) (x : G.obj.obj (Opposite.op T)),
      (∃ x' : (Subobject.underlying.obj M).obj.obj (Opposite.op T),
        (M.arrow.hom.app (Opposite.op T)).hom x' = x) ↔ wcThetaCond S ℓ G W N θ U T x)
    (r : ℕ) (b : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin N → ℚ_[ℓ]))
    (hb : Function.Injective b) (hbU : LinearMap.range b = U) :
    ∃ θ' : (Subobject.underlying.obj M).over W ≅ (wcContSheaf S (Fin r → ℚ_[ℓ])).over W,
      ∀ (T : Over W) (s : (Subobject.underlying.obj M).obj.obj (Opposite.op T.left))
        (z : T.left.left),
        b (wcContEval S T.left ((θ'.hom.hom.app (Opposite.op T)).hom s) z) =
          wcContEval S T.left ((θ.hom.hom.app (Opposite.op T)).hom
            ((M.arrow.hom.app (Opposite.op T.left)).hom s)) z :=
by
  classical

  obtain ⟨P, hP⟩ := LinearMap.exists_leftInverse_of_injective b (LinearMap.ker_eq_bot.mpr hb)
  have hPb : ∀ v, P (b v) = v := fun v => LinearMap.congr_fun hP v
  have hbP : ∀ y ∈ U, b (P y) = y := by
    intro y hy
    rw [← hbU] at hy
    obtain ⟨w, rfl⟩ := hy
    rw [hPb]
  have hPc : Continuous P := LinearMap.continuous_of_finiteDimensional P
  have hbc : Continuous b := LinearMap.continuous_of_finiteDimensional b

  let φ : (Subobject.underlying.obj M).over W ⟶ (wcContSheaf S (Fin r → ℚ_[ℓ])).over W :=
    ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map M.arrow ≫ θ.hom ≫
      ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map
        (wcContSheafMap S P.toAddMonoidHom hPc)
  have hev : ∀ (T : Over W) (s : (Subobject.underlying.obj M).obj.obj (Opposite.op T.left))
      (z : T.left.left),
      wcContEval S T.left ((φ.hom.app (Opposite.op T)).hom s) z =
        P (wcContEval S T.left ((θ.hom.hom.app (Opposite.op T)).hom
          ((M.arrow.hom.app (Opposite.op T.left)).hom s)) z) := by
    intro T s z
    rfl

  have hmemU : ∀ (T : Over W) (s : (Subobject.underlying.obj M).obj.obj (Opposite.op T.left))
      (z : T.left.left),
      wcContEval S T.left ((θ.hom.hom.app (Opposite.op T)).hom
          ((M.arrow.hom.app (Opposite.op T.left)).hom s)) z ∈ U := by
    intro T s z
    have h := (hM T.left ((M.arrow.hom.app (Opposite.op T.left)).hom s)).mp ⟨s, rfl⟩
      T.left (𝟙 T.left) T.hom z
    have e : (G.obj.map (𝟙 T.left).op).hom ((M.arrow.hom.app (Opposite.op T.left)).hom s) =
        (M.arrow.hom.app (Opposite.op T.left)).hom s := by
      rw [op_id, G.obj.map_id]
      rfl
    rw [e] at h
    exact h

  have hθinv : ∀ (T : Over W) (x : G.obj.obj (Opposite.op T.left)),
      (θ.inv.hom.app (Opposite.op T)).hom ((θ.hom.hom.app (Opposite.op T)).hom x) = x := by
    intro T x
    exact congrArg (fun f => (f.hom.app (Opposite.op T)).hom x) θ.hom_inv_id
  have hθinv' : ∀ (T : Over W)
      (y : (wcContSheaf S (Fin N → ℚ_[ℓ])).obj.obj (Opposite.op T.left)),
      (θ.hom.hom.app (Opposite.op T)).hom ((θ.inv.hom.app (Opposite.op T)).hom y) = y := by
    intro T y
    exact congrArg (fun f => (f.hom.app (Opposite.op T)).hom y) θ.inv_hom_id

  have hιinj : ∀ (Y : S.ProEt), Function.Injective (M.arrow.hom.app (Opposite.op Y)).hom := by
    intro Y
    have h1 : Mono M.arrow.hom := inferInstance
    haveI : Mono (M.arrow.hom.app (Opposite.op Y)) := (NatTrans.mono_iff_mono_app _).mp h1 _
    exact (AddCommGrpCat.mono_iff_injective _).mp this

  have hinj : ∀ T : Over W, Function.Injective (φ.hom.app (Opposite.op T)).hom := by
    intro T
    rw [injective_iff_map_eq_zero]
    intro s hs
    have h1 : (θ.hom.hom.app (Opposite.op T)).hom ((M.arrow.hom.app (Opposite.op T.left)).hom s)
        = 0 := by
      have h2 : (show ULift.{u+1} C(↥T.left.left, Fin N → ℚ_[ℓ]) from
          (θ.hom.hom.app (Opposite.op T)).hom ((M.arrow.hom.app (Opposite.op T.left)).hom s))
          = 0 := by
        apply ULift.ext
        apply ContinuousMap.ext
        intro z
        have e1 := hev T s z
        rw [hs] at e1
        have e2 : P (wcContEval S T.left ((θ.hom.hom.app (Opposite.op T)).hom
            ((M.arrow.hom.app (Opposite.op T.left)).hom s)) z) = 0 := e1.symm.trans rfl
        have e3 : wcContEval S T.left ((θ.hom.hom.app (Opposite.op T)).hom
            ((M.arrow.hom.app (Opposite.op T.left)).hom s)) z = 0 := by
          rw [← hbP _ (hmemU T s z), e2, map_zero]
        exact e3
      exact h2
    have h3 : (M.arrow.hom.app (Opposite.op T.left)).hom s = 0 := by
      rw [← hθinv T ((M.arrow.hom.app (Opposite.op T.left)).hom s), h1]
      exact map_zero _
    exact hιinj _ (h3.trans (map_zero _).symm)

  have hsurj : ∀ T : Over W, Function.Surjective (φ.hom.app (Opposite.op T)).hom := by
    intro T f
    let g := ((wcContSheafMap S b.toAddMonoidHom hbc).hom.app (Opposite.op T.left)).hom f
    have hg : ∀ z, wcContEval S T.left g z = b (wcContEval S T.left f z) := fun z => rfl
    let x := (θ.inv.hom.app (Opposite.op T)).hom g
    have hx : (θ.hom.hom.app (Opposite.op T)).hom x = g := hθinv' T g
    have hcond : wcThetaCond S ℓ G W N θ U T.left x := by
      intro V h h' z
      refine hU V (h ≫ T.hom) h' ((G.obj.map h.op).hom x) ?_ z
      intro z'
      have hnat := congrArg (fun F => AddCommGrpCat.Hom.hom F x)
        (θ.hom.hom.naturality (Over.homMk h rfl : Over.mk (h ≫ T.hom) ⟶ T).op)
      have e : (θ.hom.hom.app (Opposite.op (Over.mk (h ≫ T.hom)))).hom ((G.obj.map h.op).hom x) =
          ((wcContSheaf S (Fin N → ℚ_[ℓ])).obj.map h.op).hom g := by
        rw [← hx]
        exact hnat
      rw [e, ← hbU]
      exact ⟨wcContEval S T.left f (h.left z'), rfl⟩
    obtain ⟨s, hs⟩ := (hM T.left x).mpr hcond
    refine ⟨s, ?_⟩
    have h2 : (show ULift.{u+1} C(↥T.left.left, Fin r → ℚ_[ℓ]) from
        (φ.hom.app (Opposite.op T)).hom s) =
        (show ULift.{u+1} C(↥T.left.left, Fin r → ℚ_[ℓ]) from f) := by
      apply ULift.ext
      apply ContinuousMap.ext
      intro z
      have e1 := hev T s z
      rw [hs, hx] at e1
      exact e1.trans ((congrArg P (hg z)).trans (hPb _))
    exact h2

  have hiso : IsIso φ := by
    have happ : ∀ T : (Over W)ᵒᵖ, IsIso (φ.hom.app T) := by
      intro T
      exact (ConcreteCategory.isIso_iff_bijective (φ.hom.app T)).mpr
        ⟨hinj T.unop, hsurj T.unop⟩
    haveI : ∀ T : (Over W)ᵒᵖ, IsIso (φ.hom.app T) := happ
    haveI : IsIso φ.hom := NatIso.isIso_of_isIso_app φ.hom
    haveI : IsIso ((sheafToPresheaf _ _).map φ) := this
    exact isIso_of_fully_faithful (sheafToPresheaf _ _) φ
  refine ⟨asIso φ, ?_⟩
  intro T s z
  exact (congrArg b (hev T s z)).trans (hbP _ (hmemU T s z))

theorem wc_proet_descend_hom_offS (K : Type u) [Field K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP)
    (hqc : QuasiCompact w.left)
    (hsurj : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left,
      (∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ z : W.left, w.left z = p)
    (b : ℕ) (φ : G.over W ⟶ (wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).over W)
    (hinv : ∀ (V : (wcP1Over K).left.ProEt) (h₁ h₂ : V ⟶ W), h₁ ≫ w = h₂ ≫ w →
      ∀ x : G.obj.obj (Opposite.op V),
        (φ.hom.app (Opposite.op (Over.mk h₁))).hom x =
          (φ.hom.app (Opposite.op (Over.mk h₂))).hom x) :
    ∃ Φ : G.over (wcGeomPoint K (wcP1Over K) hP) ⟶
        (wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).over (wcGeomPoint K (wcP1Over K) hP),
      ∀ (V : (wcP1Over K).left.ProEt) (h' : V ⟶ W) (x : G.obj.obj (Opposite.op V)),
        (Φ.hom.app (Opposite.op (Over.mk (h' ≫ w)))).hom x =
          (φ.hom.app (Opposite.op (Over.mk h'))).hom x :=
by
  classical
  have hF : ∀ (F : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
      {A B C : (wcP1Over K).left.ProEt} (k : A ⟶ B) (m' : B ⟶ C) (y : F.obj.obj (Opposite.op C)),
      (F.obj.map k.op).hom ((F.obj.map m'.op).hom y) = (F.obj.map (k ≫ m').op).hom y := by
    intro F A B C k m' y
    rw [op_comp, Functor.map_comp]
    rfl
  have hid : ∀ (F : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
      {A : (wcP1Over K).left.ProEt} (y : F.obj.obj (Opposite.op A)),
      (F.obj.map (𝟙 A).op).hom y = y := by
    intro F A y
    rw [op_id, CategoryTheory.Functor.map_id]
    rfl
  have hCext : ∀ (V : (wcP1Over K).left.ProEt)
      (f₁ f₂ : (wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.obj (Opposite.op V)),
      (∀ z, wcContEval (wcP1Over K).left V f₁ z = wcContEval (wcP1Over K).left V f₂ z) →
      f₁ = f₂ := by
    intro V f₁ f₂ h
    have : (show ULift.{u+1} C(↥V.left, Fin b → ℚ_[ℓ]) from f₁) =
        (show ULift.{u+1} C(↥V.left, Fin b → ℚ_[ℓ]) from f₂) :=
      ULift.ext _ _ (ContinuousMap.ext h)
    exact this
  obtain ⟨Θ, hΘ⟩ : ∃ Θ : ∀ (V : (wcP1Over K).left.ProEt) (_ : V ⟶ W),
      G.obj.obj (Opposite.op V) →+
        (wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.obj (Opposite.op V),
      ∀ V h' y, Θ V h' y = (φ.hom.app (Opposite.op (Over.mk h'))).hom y :=
    ⟨fun V h' => (φ.hom.app (Opposite.op (Over.mk h'))).hom, fun _ _ _ => rfl⟩
  have hN : ∀ (V V' : (wcP1Over K).left.ProEt) (k : V' ⟶ V) (h' : V ⟶ W)
      (y : G.obj.obj (Opposite.op V)),
      Θ V' (k ≫ h') ((G.obj.map k.op).hom y) =
        ((wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.map k.op).hom (Θ V h' y) := by
    intro V V' k h' y
    rw [hΘ, hΘ]
    exact congrArg (fun f => f.hom y)
      (φ.hom.naturality (Over.homMk (U := Over.mk (k ≫ h')) (V := Over.mk h') k rfl).op)
  have hinvΘ : ∀ (V : (wcP1Over K).left.ProEt) (h₁ h₂ : V ⟶ W), h₁ ≫ w = h₂ ≫ w →
      ∀ y, Θ V h₁ y = Θ V h₂ y := by
    intro V h₁ h₂ hc y
    rw [hΘ, hΘ]
    exact hinv V h₁ h₂ hc y

  have bc : ∀ (B W' : (wcP1Over K).left.ProEt) (w' : W' ⟶ B), QuasiCompact w'.left →
      ∀ (V : (wcP1Over K).left.ProEt) (g' : V ⟶ B),
      ∃ (V₁ : (wcP1Over K).left.ProEt) (a : V₁ ⟶ V) (b : V₁ ⟶ W'), a ≫ g' = b ≫ w' ∧
        QuasiCompact a.left ∧
        ∀ z : V.left, (∃ p : W'.left, w'.left p = g'.left z) → ∃ y : V₁.left, a.left y = z := by
    intro B W' w' hqc' V g'
    haveI := hqc'
    haveI hWp : WeaklyEtale W'.hom := W'.prop
    haveI hBp : WeaklyEtale B.hom := B.prop
    haveI hVp : WeaklyEtale V.hom := V.prop
    haveI hwB : WeaklyEtale (w'.left ≫ B.hom) := by
      rw [MorphismProperty.Over.w w']; exact hWp
    haveI : WeaklyEtale w'.left := WeaklyEtale.of_comp w'.left B.hom
    haveI hfst : WeaklyEtale (Limits.pullback.fst g'.left w'.left) := inferInstance
    haveI hfstq : QuasiCompact (Limits.pullback.fst g'.left w'.left) := inferInstance
    haveI : WeaklyEtale (Limits.pullback.fst g'.left w'.left ≫ V.hom) := inferInstance
    let V₁ : (wcP1Over K).left.ProEt :=
      Scheme.ProEt.mk (Limits.pullback.fst g'.left w'.left ≫ V.hom)
    let a : V₁ ⟶ V :=
      MorphismProperty.Over.homMk (Limits.pullback.fst g'.left w'.left) rfl trivial
    have hb : Limits.pullback.snd g'.left w'.left ≫ W'.hom =
        Limits.pullback.fst g'.left w'.left ≫ V.hom := by
      rw [← MorphismProperty.Over.w w', ← MorphismProperty.Over.w g', ← Category.assoc,
        ← Category.assoc, Limits.pullback.condition]
    let b : V₁ ⟶ W' :=
      MorphismProperty.Over.homMk (Limits.pullback.snd g'.left w'.left) hb trivial
    refine ⟨V₁, a, b, ?_, hfstq, ?_⟩
    · apply MorphismProperty.Over.Hom.ext
      exact Limits.pullback.condition
    · rintro z ⟨p, hp⟩
      obtain ⟨τ, hτ, -⟩ := Scheme.Pullback.exists_preimage_pullback z p hp.symm
      exact ⟨τ, hτ⟩

  have glue : ∀ (F : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
      (T₀ V₁ : (wcP1Over K).left.ProEt) (a : V₁ ⟶ T₀), QuasiCompact a.left →
      (∀ z : T₀.left, ∃ y : V₁.left, a.left y = z) → ∀ (x₁ : F.obj.obj (Opposite.op V₁)),
      (∀ (Z : (wcP1Over K).left.ProEt) (c d : Z ⟶ V₁), c ≫ a = d ≫ a →
        (F.obj.map c.op).hom x₁ = (F.obj.map d.op).hom x₁) →
      ∃ x : F.obj.obj (Opposite.op T₀), (F.obj.map a.op).hom x = x₁ := by
    intro F T₀ V₁ a haq hsurj' x₁ hcomp
    haveI := haq
    haveI hTp : WeaklyEtale T₀.hom := T₀.prop
    haveI hVp : WeaklyEtale V₁.hom := V₁.prop
    haveI hwB : WeaklyEtale (a.left ≫ T₀.hom) := by
      rw [MorphismProperty.Over.w a]; exact hVp
    haveI hae : WeaklyEtale a.left := WeaklyEtale.of_comp a.left T₀.hom
    have hsurj'' : ∀ x : T₀.left, ∃ (_ : PUnit.{u+2}) (y : V₁.left), a.left y = x := by
      intro p
      obtain ⟨y, hy⟩ := hsurj' p
      exact ⟨PUnit.unit, y, hy⟩
    let 𝒰 : Scheme.Cover (Scheme.precoverage @WeaklyEtale) T₀.left :=
      Scheme.Cover.mkOfCovers (P := @WeaklyEtale) PUnit.{u+2} (fun _ => V₁.left)
        (fun _ => a.left) hsurj'' (fun _ => hae)
    have hqc𝒰 : QuasiCompactCover 𝒰.toPreZeroHypercover :=
      @QuasiCompactCover.of_finite _ _ 𝒰 Scheme.instJointlySurjectivePrecoverage
        (fun _ => haq) (inferInstanceAs (Finite PUnit.{u+2}))
    have hR0 : Presieve.ofArrows (fun _ : PUnit.{u+2} => V₁.left) (fun _ => a.left) ∈
        Scheme.proetalePrecoverage.coverings T₀.left :=
      Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover.mpr ⟨𝒰, hqc𝒰, rfl⟩
    have e := Presieve.map_ofArrows (F := Scheme.ProEt.forget (wcP1Over K).left ⋙
        Over.forget (wcP1Over K).left)
      (Y := fun _ : PUnit.{u+2} => V₁) (fun _ => a)
    have hR' : Presieve.ofArrows (fun _ : PUnit.{u+2} => V₁) (fun _ => a) ∈
        (Scheme.ProEt.precoverage (wcP1Over K).left).coverings T₀ :=
      Precoverage.mem_comap_iff.mpr (e ▸ hR0)
    have hRJ : Sieve.generate (Presieve.ofArrows (fun _ : PUnit.{u+2} => V₁) (fun _ => a)) ∈
        (Scheme.ProEt.topology (wcP1Over K).left) T₀ :=
      Precoverage.generate_mem_toGrothendieck hR'
    have hsh : Presieve.IsSheaf (Scheme.ProEt.topology (wcP1Over K).left)
        (F.obj ⋙ forget AddCommGrpCat.{u+1}) :=
      (isSheaf_iff_isSheaf_of_type _ _).mp
        ((sheafCompose (Scheme.ProEt.topology (wcP1Over K).left)
          (forget AddCommGrpCat.{u+1})).obj F).property
    have h1 := hsh _ hRJ
    rw [← Presieve.isSheafFor_iff_generate, Presieve.ofArrows_pUnit] at h1
    obtain ⟨t, ht, -⟩ := (Presieve.isSheafFor_singleton.mp h1) x₁
      (fun p₁ p₂ hp => hcomp _ p₁ p₂ hp)
    exact ⟨t, ht⟩

  have desc : ∀ (T : (wcP1Over K).left.ProEt) (g : T ⟶ wcGeomPoint K (wcP1Over K) hP),
      (∀ z : T.left, ∃ p : W.left, w.left p = g.left z) →
      ∀ x : G.obj.obj (Opposite.op T),
      ∃ f : (wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.obj (Opposite.op T),
        (∀ (V : (wcP1Over K).left.ProEt) (h : V ⟶ T) (h' : V ⟶ W), h' ≫ w = h ≫ g →
          Θ V h' ((G.obj.map h.op).hom x) =
            ((wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.map h.op).hom f) ∧
        ∀ f' : (wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.obj (Opposite.op T),
          (∀ (V : (wcP1Over K).left.ProEt) (h : V ⟶ T) (h' : V ⟶ W), h' ≫ w = h ≫ g →
            Θ V h' ((G.obj.map h.op).hom x) =
              ((wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.map h.op).hom f') →
          f' = f := by
    intro T g hlift x
    obtain ⟨V₁, p₁, p₂, hsq, hqc₁, hlift₁⟩ := bc _ W w hqc T g
    have hsurj₁ : ∀ z : T.left, ∃ y : V₁.left, p₁.left y = z := fun z => hlift₁ z (hlift z)
    have hsqk : ∀ {Z : (wcP1Over K).left.ProEt} (k : Z ⟶ V₁),
        (k ≫ p₂) ≫ w = (k ≫ p₁) ≫ g := by
      intro Z k
      simp only [Category.assoc, hsq]
    obtain ⟨f₁, hf₁⟩ : ∃ f₁ : (wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.obj
        (Opposite.op V₁), f₁ = Θ V₁ p₂ ((G.obj.map p₁.op).hom x) := ⟨_, rfl⟩
    have hK : ∀ (Z : (wcP1Over K).left.ProEt) (k : Z ⟶ V₁),
        ((wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.map k.op).hom f₁ =
          Θ Z (k ≫ p₂) ((G.obj.map (k ≫ p₁).op).hom x) := by
      intro Z k
      rw [hf₁, ← hN, hF]
    have hdesc : ∀ (Z : (wcP1Over K).left.ProEt) (c d : Z ⟶ V₁), c ≫ p₁ = d ≫ p₁ →
        ((wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.map c.op).hom f₁ =
          ((wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.map d.op).hom f₁ := by
      intro Z c d hcd
      have hw : (c ≫ p₂) ≫ w = (d ≫ p₂) ≫ w := by
        rw [hsqk c, hsqk d, hcd]
      rw [hK, hK, ← hcd]
      exact hinvΘ Z _ _ hw _
    obtain ⟨f, hf⟩ := glue (wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])) T V₁ p₁ hqc₁
      hsurj₁ f₁ hdesc
    have hchart : ∀ (V : (wcP1Over K).left.ProEt) (h : V ⟶ T) (h' : V ⟶ W), h' ≫ w = h ≫ g →
        Θ V h' ((G.obj.map h.op).hom x) =
          ((wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.map h.op).hom f := by
      intro V h h' hc
      obtain ⟨V', q, r, hsq₂, -, hlift₂⟩ := bc T V₁ p₁ hqc₁ V h
      have hw2 : (r ≫ p₂) ≫ w = (q ≫ h') ≫ w := by
        rw [hsqk r, ← hsq₂]
        simp only [Category.assoc, hc]
      have hfx := hinvΘ V' (r ≫ p₂) (q ≫ h') hw2 ((G.obj.map (r ≫ p₁).op).hom x)
      have e2 : Θ V' (r ≫ p₂) ((G.obj.map (r ≫ p₁).op).hom x) =
          ((wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.map q.op).hom
            (((wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.map h.op).hom f) := by
        rw [← hK, ← hf, hF, hF, hsq₂]
      have e3 : Θ V' (q ≫ h') ((G.obj.map (r ≫ p₁).op).hom x) =
          ((wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.map q.op).hom
            (Θ V h' ((G.obj.map h.op).hom x)) := by
        rw [← hsq₂, ← hF G q h, hN]
      rw [e2, e3] at hfx
      apply hCext
      intro v
      obtain ⟨v', hv'⟩ := hlift₂ v (hsurj₁ (h.left v))
      have e1 := congrArg (fun F => wcContEval (wcP1Over K).left V' F v') hfx
      rw [← hv']
      exact e1.symm
    refine ⟨f, hchart, ?_⟩
    intro f' hf'
    have h2 : ((wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.map p₁.op).hom f' =
        ((wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.map p₁.op).hom f :=
      (hf' V₁ p₁ p₂ hsq.symm).symm.trans (hchart V₁ p₁ p₂ hsq.symm)
    apply hCext
    intro z
    obtain ⟨y, rfl⟩ := hsurj₁ z
    exact congrArg (fun F => wcContEval (wcP1Over K).left V₁ F y) h2
  choose fd hfd_chart hfd_uniq using desc

  have havoid_lift : ∀ (V : (wcP1Over K).left.ProEt) (g : V ⟶ wcGeomPoint K (wcP1Over K) hP),
      (∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint K)) →
      ∀ z : V.left, ∃ p : W.left, w.left p = g.left z := by
    intro V g hV z
    apply hsurj
    intro i
    have e : (wcGeomPoint K (wcP1Over K) hP).hom (g.left z) = V.hom z := by
      rw [← MorphismProperty.Over.w g, Scheme.Hom.comp_apply]
    rw [e]
    exact hV z i
  have havoid_comp : ∀ (V V₁ : (wcP1Over K).left.ProEt) (k : V₁ ⟶ V),
      (∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint K)) →
      ∀ (v : V₁.left) (i : Fin m), V₁.hom v ≠ S i (IsLocalRing.closedPoint K) := by
    intro V V₁ k hV v i
    rw [← MorphismProperty.Over.w k, Scheme.Hom.comp_apply]
    exact hV _ i

  have hcompat : ∀ (T : (wcP1Over K).left.ProEt) (g : T ⟶ wcGeomPoint K (wcP1Over K) hP)
      (x : G.obj.obj (Opposite.op T))
      (V V' : (wcP1Over K).left.ProEt) (k : V' ⟶ V) (h : V ⟶ T)
      (hV : ∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint K))
      (hV' : ∀ (v : V'.left) (i : Fin m), V'.hom v ≠ S i (IsLocalRing.closedPoint K)),
      ((wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.map k.op).hom
          (fd V (h ≫ g) (havoid_lift V (h ≫ g) hV) ((G.obj.map h.op).hom x)) =
        fd V' ((k ≫ h) ≫ g) (havoid_lift V' ((k ≫ h) ≫ g) hV')
          ((G.obj.map (k ≫ h).op).hom x) := by
    intro T g x V V' k h hV hV'
    apply hfd_uniq
    intro V₁ h₁ h₁' hc
    rw [hF G h₁ (k ≫ h), show h₁ ≫ k ≫ h = (h₁ ≫ k) ≫ h from (Category.assoc _ _ _).symm,
      ← hF G (h₁ ≫ k) h, hF (wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])) h₁ k]
    exact hfd_chart V (h ≫ g) _ ((G.obj.map h.op).hom x) V₁ (h₁ ≫ k) h₁'
      (by rw [hc]; simp only [Category.assoc])

  have hext : ∀ (T : (wcP1Over K).left.ProEt) (g : T ⟶ wcGeomPoint K (wcP1Over K) hP)
      (x : G.obj.obj (Opposite.op T)),
      ∃ E : (wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.obj (Opposite.op T),
        ∀ (V : (wcP1Over K).left.ProEt) (h : V ⟶ T)
          (hV : ∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint K)),
          ((wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.map h.op).hom E =
            fd V (h ≫ g) (havoid_lift V (h ≫ g) hV) ((G.obj.map h.op).hom x) := by
    intro T g x
    exact wc_P1_contSheaf_extend_family K ℓ b m S hS T
      (fun V h hV => fd V (h ≫ g) (havoid_lift V (h ≫ g) hV) ((G.obj.map h.op).hom x))
      (fun V V' k h hV hV' => hcompat T g x V V' k h hV hV')
  choose E hE using hext

  have hSAT : ∀ (T : (wcP1Over K).left.ProEt) (g : T ⟶ wcGeomPoint K (wcP1Over K) hP)
      (x : G.obj.obj (Opposite.op T)) (V₁ : (wcP1Over K).left.ProEt) (h₁ : V₁ ⟶ T)
      (h₁' : V₁ ⟶ W),
      (∀ (v : V₁.left) (i : Fin m), V₁.hom v ≠ S i (IsLocalRing.closedPoint K)) →
      h₁' ≫ w = h₁ ≫ g →
      ((wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.map h₁.op).hom (E T g x) =
        Θ V₁ h₁' ((G.obj.map h₁.op).hom x) := by
    intro T g x V₁ h₁ h₁' hV₁ hc
    rw [hE T g x V₁ h₁ hV₁]
    have := hfd_chart V₁ (h₁ ≫ g) (havoid_lift V₁ (h₁ ≫ g) hV₁) ((G.obj.map h₁.op).hom x)
      V₁ (𝟙 _) h₁' (by rw [hc, Category.id_comp])
    rw [hid, hid] at this
    exact this.symm
  have hCRIT : ∀ (T : (wcP1Over K).left.ProEt) (g : T ⟶ wcGeomPoint K (wcP1Over K) hP)
      (x : G.obj.obj (Opposite.op T))
      (y : (wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.obj (Opposite.op T)),
      (∀ (V₁ : (wcP1Over K).left.ProEt) (h₁ : V₁ ⟶ T) (h₁' : V₁ ⟶ W),
        (∀ (v : V₁.left) (i : Fin m), V₁.hom v ≠ S i (IsLocalRing.closedPoint K)) →
        h₁' ≫ w = h₁ ≫ g →
        ((wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.map h₁.op).hom y =
          Θ V₁ h₁' ((G.obj.map h₁.op).hom x)) →
      y = E T g x := by
    intro T g x y hy
    have h0 : y - E T g x = 0 := by
      apply wc_P1_contSheaf_off_points_vanish K ℓ b m S hS T
      intro V h hV
      rw [map_sub, sub_eq_zero, hE T g x V h hV]
      apply hfd_uniq
      intro V₁ k h' hc
      rw [hF G k h, hF (wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])) k h]
      rw [hy V₁ (k ≫ h) h' (havoid_comp V V₁ k hV) (by rw [hc, Category.assoc])]
    exact sub_eq_zero.mp h0

  have hadd : ∀ (T : (wcP1Over K).left.ProEt) (g : T ⟶ wcGeomPoint K (wcP1Over K) hP)
      (x x' : G.obj.obj (Opposite.op T)), E T g (x + x') = E T g x + E T g x' := by
    intro T g x x'
    refine (hCRIT T g (x + x') (E T g x + E T g x') ?_).symm
    intro V₁ h₁ h₁' hV₁ hc
    rw [map_add, hSAT T g x V₁ h₁ h₁' hV₁ hc, hSAT T g x' V₁ h₁ h₁' hV₁ hc]
    simp only [map_add]
  have hnat : ∀ (T T' : Over (wcGeomPoint K (wcP1Over K) hP)) (c : T' ⟶ T)
      (x : G.obj.obj (Opposite.op T.left)),
      E T'.left T'.hom ((G.obj.map c.left.op).hom x) =
        ((wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.map c.left.op).hom
          (E T.left T.hom x) := by
    intro T T' c x
    refine (hCRIT T'.left T'.hom ((G.obj.map c.left.op).hom x) _ ?_).symm
    intro V₁ h₁ h₁' hV₁ hc
    rw [hF, hF, hSAT T.left T.hom x V₁ (h₁ ≫ c.left) h₁' hV₁
      (by rw [hc, ← Over.w c, Category.assoc])]

  let η : (G.over (wcGeomPoint K (wcP1Over K) hP)).obj ⟶
      ((wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).over
        (wcGeomPoint K (wcP1Over K) hP)).obj :=
    { app := fun T => AddCommGrpCat.ofHom
        (AddMonoidHom.mk' (E T.unop.left T.unop.hom) (hadd T.unop.left T.unop.hom))
      naturality := fun T T' c => by
        ext x
        exact hnat T.unop T'.unop c.unop x }
  refine ⟨ObjectProperty.homMk η, fun V h' x => ?_⟩
  show E V (h' ≫ w) x = _
  symm
  rw [← hΘ V h' x]
  apply hCRIT V (h' ≫ w) x
  intro V₁ h₁ h₁' hV₁ hc
  rw [← hN]
  exact hinvΘ V₁ _ _ (by rw [Category.assoc, hc]) _

theorem wc_proet_descended_ker_eq_theta (K : Type u) [Field K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP)
    (hqc : QuasiCompact w.left)
    (hsurj : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left,
      (∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ z : W.left, w.left z = p)
    (N : ℕ) (θ : G.over W ≅ (wcContSheaf (wcP1Over K).left (Fin N → ℚ_[ℓ])).over W)
    (U : Submodule ℚ_[ℓ] (Fin N → ℚ_[ℓ])) (b : ℕ)
    (L₀ : (Fin N → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin b → ℚ_[ℓ])) (hL : LinearMap.ker L₀ = U)
    (hUtw : ∀ (V : (wcP1Over K).left.ProEt) (h₁ h₂ : V ⟶ W) (x : G.obj.obj (Opposite.op V)),
      (∀ z : V.left, wcContEval (wcP1Over K).left V
        ((θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x) z ∈ U) →
      ∀ z : V.left, wcContEval (wcP1Over K).left V
        ((θ.hom.hom.app (Opposite.op (Over.mk h₂))).hom x) z ∈ U)
    (M : Subobject G)
    (hM : ∀ (T : (wcP1Over K).left.ProEt) (x : G.obj.obj (Opposite.op T)),
      (∃ x' : (Subobject.underlying.obj M).obj.obj (Opposite.op T),
        (M.arrow.hom.app (Opposite.op T)).hom x' = x) ↔
      wcThetaCond (wcP1Over K).left ℓ G W N θ U T x)
    (Φ : G.over (wcGeomPoint K (wcP1Over K) hP) ⟶
        (wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).over (wcGeomPoint K (wcP1Over K) hP))
    (hΦ : ∀ (V : (wcP1Over K).left.ProEt) (h' : V ⟶ W) (x : G.obj.obj (Opposite.op V))
      (z : V.left),
      wcContEval (wcP1Over K).left V ((Φ.hom.app (Opposite.op (Over.mk (h' ≫ w)))).hom x) z =
        L₀ (wcContEval (wcP1Over K).left V ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom x) z)) :
    ∀ (T : (wcP1Over K).left.ProEt) (g : T ⟶ wcGeomPoint K (wcP1Over K) hP)
      (x : G.obj.obj (Opposite.op T)),
      (Φ.hom.app (Opposite.op (Over.mk g))).hom x = 0 ↔
        ∃ x' : (Subobject.underlying.obj M).obj.obj (Opposite.op T),
          (M.arrow.hom.app (Opposite.op T)).hom x' = x :=
by
  classical

  have hmemU : ∀ v : Fin N → ℚ_[ℓ], v ∈ U ↔ L₀ v = 0 := by
    intro v
    rw [← hL, LinearMap.mem_ker]

  have hext : ∀ (V : (wcP1Over K).left.ProEt)
      (f : (wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.obj (Opposite.op V)),
      (∀ z : V.left, wcContEval (wcP1Over K).left V f z = 0) → f = 0 := by
    intro V f hf
    apply ULift.ext
    apply ContinuousMap.ext
    intro z
    exact hf z

  have hΦnat : ∀ (V V₁ : (wcP1Over K).left.ProEt) (j : V₁ ⟶ V)
      (t : V ⟶ wcGeomPoint K (wcP1Over K) hP) (s : G.obj.obj (Opposite.op V)),
      ((wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.map j.op).hom
        ((Φ.hom.app (Opposite.op (Over.mk t))).hom s) =
      (Φ.hom.app (Opposite.op (Over.mk (j ≫ t)))).hom ((G.obj.map j.op).hom s) := by
    intro V V₁ j t s
    exact (congrArg (fun f => AddCommGrpCat.Hom.hom f s)
      (Φ.hom.naturality (Over.homMk j rfl : Over.mk (j ≫ t) ⟶ Over.mk t).op)).symm
  have hΦcongr : ∀ (V : (wcP1Over K).left.ProEt) (t₁ t₂ : V ⟶ wcGeomPoint K (wcP1Over K) hP),
      t₁ = t₂ → ∀ s : G.obj.obj (Opposite.op V),
      (Φ.hom.app (Opposite.op (Over.mk t₁))).hom s =
        (Φ.hom.app (Opposite.op (Over.mk t₂))).hom s := by
    rintro V t₁ t₂ rfl s
    rfl

  have hθnat : ∀ (V V₁ : (wcP1Over K).left.ProEt) (k : V₁ ⟶ V) (h : V ⟶ W)
      (x : G.obj.obj (Opposite.op V)) (z₁ : V₁.left),
      wcContEval (wcP1Over K).left V₁ ((θ.hom.hom.app (Opposite.op (Over.mk (k ≫ h)))).hom
        ((G.obj.map k.op).hom x)) z₁ =
      wcContEval (wcP1Over K).left V
        ((θ.hom.hom.app (Opposite.op (Over.mk h))).hom x) (k.left z₁) := by
    intro V V₁ k h x z₁
    have h1 := congrArg (fun f => AddCommGrpCat.Hom.hom f x)
      (θ.hom.hom.naturality (Over.homMk k rfl : Over.mk (k ≫ h) ⟶ Over.mk h).op)
    exact congrArg (fun f => wcContEval (wcP1Over K).left V₁ f z₁) h1

  have hC : ∀ (T₀ : (wcP1Over K).left.ProEt) (g₀ : T₀ ⟶ wcGeomPoint K (wcP1Over K) hP)
      (y : (wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.obj (Opposite.op T₀)),
      (∀ (V : (wcP1Over K).left.ProEt) (h : V ⟶ T₀) (h' : V ⟶ W), h' ≫ w = h ≫ g₀ →
        ((wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.map h.op).hom y = 0) → y = 0 := by
    intro T₀ g₀ y H
    exact wc_P1_contSheaf_off_points_vanish K ℓ b m S hS T₀ y
      (wc_proet_detect_through_cover K hP m S W w hqc hsurj _ T₀ g₀ y H)
  intro T g x
  constructor
  ·
    intro hx
    apply (hM T x).mpr
    intro V h h' z
    let y : (wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.obj (Opposite.op V) :=
      (show (wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.obj (Opposite.op V) from
        ULift.up ((⟨L₀, LinearMap.continuous_of_finiteDimensional L₀⟩ :
            C(Fin N → ℚ_[ℓ], Fin b → ℚ_[ℓ])).comp
          (show C(↥V.left, Fin N → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom ((G.obj.map h.op).hom x)).down)))
    have hy : y = 0 := by
      apply hC V (h ≫ g) y
      intro V₂ k h₂ hc
      apply hext
      intro z₂
      show L₀ (wcContEval (wcP1Over K).left V ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom
        ((G.obj.map h.op).hom x)) (k.left z₂)) = 0
      have ha : (Φ.hom.app (Opposite.op (Over.mk (h₂ ≫ w)))).hom
          ((G.obj.map (k ≫ h).op).hom x) = 0 := by
        refine (hΦcongr V₂ _ _ (hc.trans (Category.assoc k h g).symm) _).trans ?_
        exact (hΦnat T V₂ (k ≫ h) g x).symm.trans
          ((congrArg ((wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.map (k ≫ h).op).hom
            hx).trans (map_zero _))
      have hb : ∀ z₃ : V₂.left, wcContEval (wcP1Over K).left V₂
          ((θ.hom.hom.app (Opposite.op (Over.mk h₂))).hom ((G.obj.map (k ≫ h).op).hom x)) z₃
          ∈ U := by
        intro z₃
        have e3 := congrArg (fun f => wcContEval (wcP1Over K).left V₂ f z₃) ha
        exact (hmemU _).mpr ((hΦ V₂ h₂ _ z₃).symm.trans e3)
      have hc' := hUtw V₂ h₂ (k ≫ h') ((G.obj.map (k ≫ h).op).hom x) hb z₂
      have e : (G.obj.map (k ≫ h).op).hom x = (G.obj.map k.op).hom ((G.obj.map h.op).hom x) := by
        rw [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply]
      rw [e, hθnat V V₂ k h' ((G.obj.map h.op).hom x) z₂] at hc'
      exact (hmemU _).mp hc'
    have e4 := congrArg (fun f => wcContEval (wcP1Over K).left V f z) hy
    exact (hmemU _).mpr e4
  ·
    rintro ⟨x', hx'⟩
    have hθc := (hM T x).mp ⟨x', hx'⟩
    apply hC T g
    intro V h h' hc
    refine (hΦnat T V h g x).trans ?_
    refine (hΦcongr V _ _ hc.symm _).trans ?_
    apply hext
    intro z
    exact (hΦ V h' _ z).trans ((hmemU _).mp (hθc V h h' z))

theorem wc_honest_strict_local_basis (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (H : wcHonestPL D ℓ hP) (U : Submodule ℚ_[ℓ] (Fin H.N → ℚ_[ℓ]))
    (hUS : ∀ (i : Fin D.m) (x : Fin H.N → ℚ_[ℓ]), ∃ u ∈ U, H.lam i (x - u) = 0)
    (b : ℕ) (L₀ : (Fin H.N → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin b → ℚ_[ℓ]))
    (hL : LinearMap.ker L₀ = U) (hLs : Function.Surjective L₀)
    (Φ : (wcRq D.f ℓ (n - 1)).over (wcGeomPoint F'' (wcP1Over F'') hP) ⟶
        (wcContSheaf (wcP1Over F'').left (Fin b → ℚ_[ℓ])).over
          (wcGeomPoint F'' (wcP1Over F'') hP))
    (hΦ : ∀ (V : (wcP1Over F'').left.ProEt) (h' : V ⟶ H.W)
      (x : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)) (z : V.left),
      wcContEval (wcP1Over F'').left V
          ((Φ.hom.app (Opposite.op (Over.mk (h' ≫ H.w)))).hom x) z =
        L₀ (wcContEval (wcP1Over F'').left V
          ((H.θ.hom.hom.app (Opposite.op (Over.mk h'))).hom x) z))
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (v : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F'')) :
    ∃ s : Fin b → (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V),
      ∀ (j : Fin b) (z : V.left),
        wcContEval (wcP1Over F'').left V ((Φ.hom.app (Opposite.op (Over.mk v))).hom (s j)) z =
          (Pi.single j 1 : Fin b → ℚ_[ℓ]) :=
by
  classical
  have key : ∀ j : Fin b, ∃ s₀ : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V),
      ∀ z : V.left, wcContEval (wcP1Over F'').left V
        ((Φ.hom.app (Opposite.op (Over.mk v))).hom s₀) z = (Pi.single j 1 : Fin b → ℚ_[ℓ]) := by
    intro j
    obtain ⟨V', a, β, z', hab, -, himg⟩ := H.hloc i V v A e hV
    obtain ⟨x, hx⟩ := hLs (Pi.single j 1)
    obtain ⟨u, hu, hlam⟩ := hUS i x
    have hLu : L₀ u = 0 := by
      rw [← LinearMap.mem_ker, hL]
      exact hu
    have hL0 : L₀ (x - u) = Pi.single j 1 := by
      rw [map_sub, hx, hLu, sub_zero]
    obtain ⟨s₀, hs₀⟩ := (himg (x - u)).mp hlam
    refine ⟨s₀, ?_⟩
    have h1 := congrArg (fun f => AddCommGrpCat.Hom.hom f s₀)
      (Φ.hom.naturality (Over.homMk a hab : Over.mk (β ≫ H.w) ⟶ Over.mk v).op)
    have hval : wcContEval (wcP1Over F'').left V
        ((Φ.hom.app (Opposite.op (Over.mk v))).hom s₀) (a.left z') = Pi.single j 1 := by
      have e1 : wcContEval (wcP1Over F'').left V'
          ((Φ.hom.app (Opposite.op (Over.mk (β ≫ H.w)))).hom
            (((wcRq D.f ℓ (n - 1)).obj.map a.op).hom s₀)) z' =
          wcContEval (wcP1Over F'').left V
            ((Φ.hom.app (Opposite.op (Over.mk v))).hom s₀) (a.left z') :=
        congrArg (fun f => wcContEval (wcP1Over F'').left V' f z') h1
      have e2 : wcContEval (wcP1Over F'').left V'
          ((H.θ.hom.hom.app (Opposite.op (Over.mk β))).hom
            (((wcRq D.f ℓ (n - 1)).obj.map a.op).hom s₀)) z' = x - u := hs₀
      rw [← e1, hΦ V' β _ z', e2, hL0]
    have hsp : ∀ p : V.left, p ⤳ e.inv (IsLocalRing.closedPoint A) := by
      intro p
      have h2 : e.hom p ⤳ IsLocalRing.closedPoint A := IsLocalRing.specializes_closedPoint _
      have h3 := h2.map (Scheme.Hom.continuous e.inv)
      rwa [Scheme.hom_inv_apply] at h3
    obtain ⟨F, hF⟩ : ∃ F : C(↥V.left, Fin b → ℚ_[ℓ]), ∀ p, wcContEval (wcP1Over F'').left V
        ((Φ.hom.app (Opposite.op (Over.mk v))).hom s₀) p = F p :=
      ⟨(show ULift.{u+1} C(↥V.left, Fin b → ℚ_[ℓ]) from
        (Φ.hom.app (Opposite.op (Over.mk v))).hom s₀).down, fun p => rfl⟩
    have hconst : ∀ p, F p = F (e.inv (IsLocalRing.closedPoint A)) :=
      fun p => ((hsp p).map F.continuous).eq
    intro z
    exact (hF z).trans ((hconst z).trans ((hconst (a.left z')).symm.trans ((hF _).symm.trans hval)))
  choose s hs using key
  exact ⟨s, hs⟩

theorem wc_P1bar_crit_cover (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP)
    (hqc : QuasiCompact w.left)
    (hsurj : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left,
      (∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ z : W.left, w.left z = p)
    (V : Fin m → (wcP1Over K).left.ProEt) (v : ∀ i, V i ⟶ wcGeomPoint K (wcP1Over K) hP)
    (hVc : ∀ i, CompactSpace (V i).left)
    (hVp : ∀ i, ∃ p : (V i).left, (V i).hom p = S i (IsLocalRing.closedPoint K))
    (T : (wcP1Over K).left.ProEt) (g : T ⟶ wcGeomPoint K (wcP1Over K) hP)
    (R : Sieve T)
    (hR : ∀ (T' : (wcP1Over K).left.ProEt) (k : T' ⟶ T),
      ((∃ c : T' ⟶ W, k ≫ g = c ≫ w) ∨ (∃ (i : Fin m) (c : T' ⟶ V i), k ≫ g = c ≫ v i)) →
      R.arrows k) :
    R ∈ Scheme.ProEt.topology (wcP1Over K).left T :=
by
  classical

  have hfib : ∀ i : Fin m, QuasiSeparatedSpace (wcGeomPoint K (wcP1Over K) hP).left ∧
      ∀ p q : (wcGeomPoint K (wcP1Over K) hP).left,
        (wcGeomPoint K (wcP1Over K) hP).hom p = S i (IsLocalRing.closedPoint K) →
        (wcGeomPoint K (wcP1Over K) hP).hom q = S i (IsLocalRing.closedPoint K) → p = q := by
    intro i
    have hcl0 := (wc_P1_sections_closed_generize K 1 (fun _ => S i) (fun _ => hS i)).1
    have hset : {p : (wcP1Over K).left | ∃ _ : Fin 1, p = S i (IsLocalRing.closedPoint K)} =
        {S i (IsLocalRing.closedPoint K)} := by
      ext p
      simp
    rw [hset] at hcl0
    let O : (wcP1Over K).left.Opens := ⟨{S i (IsLocalRing.closedPoint K)}ᶜ, hcl0.isOpen_compl⟩
    obtain ⟨xb, -, hfb, -, hqs, -⟩ := wc_pmod_geom_point_local_data K (wcP1Over K)
      (wc_proj_space_isProper K 1) (S i) (hS i) O rfl hP
    refine ⟨hqs, fun p q hp hq => ?_⟩
    have hp' : p ∈ (wcGeomPoint K (wcP1Over K) hP).hom ⁻¹' {S i (IsLocalRing.closedPoint K)} := hp
    have hq' : q ∈ (wcGeomPoint K (wcP1Over K) hP).hom ⁻¹' {S i (IsLocalRing.closedPoint K)} := hq
    rw [hfb] at hp' hq'
    exact hp'.trans hq'.symm

  let Wf : Option (Fin m) → (wcP1Over K).left.ProEt := fun j => Option.rec W V j
  let hf : ∀ j, Wf j ⟶ wcGeomPoint K (wcP1Over K) hP := fun j =>
    Option.rec (motive := fun j => Wf j ⟶ wcGeomPoint K (wcP1Over K) hP) w v j
  have hq : ∀ j, QuasiCompact (hf j).left := by
    intro j
    cases j with
    | none => exact hqc
    | some i =>
      show QuasiCompact (v i).left
      exact @quasiCompact_of_compactSpace _ _ (v i).left (hVc i) (hfib i).1
  have hJ : ∀ x : (wcGeomPoint K (wcP1Over K) hP).left, ∃ j, x ∈ Set.range (hf j).left := by
    intro x
    by_cases hx : ∀ i : Fin m,
        (wcGeomPoint K (wcP1Over K) hP).hom x ≠ S i (IsLocalRing.closedPoint K)
    · obtain ⟨z, hz⟩ := hsurj x hx
      exact ⟨none, z, hz⟩
    · push_neg at hx
      obtain ⟨i, hi⟩ := hx
      obtain ⟨p, hp⟩ := hVp i
      have h1 : (wcGeomPoint K (wcP1Over K) hP).hom ((v i).left p) = (V i).hom p := by
        rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w (v i)]
      exact ⟨some i, p, (hfib i).2 _ _ (h1.trans hp) hi⟩
  have hs : ∀ x : (wcGeomPoint K (wcP1Over K) hP).left, ∃ j y, (hf j).left y = x := by
    intro x
    obtain ⟨j, y, hy⟩ := hJ x
    exact ⟨j, y, hy⟩
  have hw : ∀ j, WeaklyEtale (hf j).left := fun j => by
    have h1 : WeaklyEtale ((hf j).left ≫ (wcGeomPoint K (wcP1Over K) hP).hom) := by
      rw [MorphismProperty.Over.w (hf j)]
      exact (Wf j).prop
    exact @WeaklyEtale.of_comp _ _ _ (hf j).left (wcGeomPoint K (wcP1Over K) hP).hom h1
      (wcGeomPoint K (wcP1Over K) hP).prop
  have H : Presieve.ofArrows (fun j => (Wf j).left) (fun j => (hf j).left) ∈
      Scheme.proetalePrecoverage.coverings (wcGeomPoint K (wcP1Over K) hP).left :=
    ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr (@QuasiCompactCover.of_finite _ _
      (Scheme.Cover.mkOfCovers (P := ⊤) (Option (Fin m)) (fun j => (Wf j).left)
        (fun j => (hf j).left) hs (fun _ => trivial)) _ hq
        (inferInstanceAs (Finite (Option (Fin m))))),
      (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr
        ⟨fun x => by obtain ⟨j, y, hy⟩ := hs x; exact ⟨j, y, hy⟩, hw⟩⟩
  have hR0 : Sieve.generate (Presieve.ofArrows Wf hf) ∈
      Scheme.ProEt.topology (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP) :=
    Precoverage.generate_mem_toGrothendieck
      (Precoverage.mem_comap_iff.mpr (by rw [Presieve.map_ofArrows]; exact H))
  refine GrothendieckTopology.superset_covering _ ?_
    (GrothendieckTopology.pullback_stable _ g hR0)
  intro T' k hk
  rw [Sieve.pullback_apply, Sieve.generate_apply] at hk
  obtain ⟨Y, h', f, hf', hcomp⟩ := hk
  rcases hf' with ⟨j⟩
  cases j with
  | none => exact hR T' k (Or.inl ⟨h', hcomp.symm⟩)
  | some i => exact hR T' k (Or.inr ⟨i, h', hcomp.symm⟩)

theorem wc_proet_frame_linear_descent (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (B₀ W : S.ProEt) (w : W ⟶ B₀) (hqc : QuasiCompact w.left)
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (N : ℕ)
    (θ : G.over W ≅ (wcContSheaf S (Fin N → ℚ_[ℓ])).over W)
    (hlin : ∀ (V : S.ProEt) (h₁ h₂ : V ⟶ W), h₁ ≫ w = h₂ ≫ w → ∀ z : V.left,
      ∃ A : (Fin N → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin N → ℚ_[ℓ]), ∀ x : G.obj.obj (Opposite.op V),
        wcContEval S V ((θ.hom.hom.app (Opposite.op (Over.mk h₂))).hom x) z =
          A (wcContEval S V ((θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x) z))
    (T : S.ProEt) (g : T ⟶ B₀) (hlift : ∀ z : T.left, ∃ p : W.left, w.left p = g.left z)
    (b : ℕ) (xs : Fin b → G.obj.obj (Opposite.op T))
    (y : (wcContSheaf S (Fin b → ℚ_[ℓ])).obj.obj (Opposite.op T)) :
    ∃ x : G.obj.obj (Opposite.op T),
      (∀ (V : S.ProEt) (h : V ⟶ T) (h' : V ⟶ W), h' ≫ w = h ≫ g → ∀ z : V.left,
        wcContEval S V ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom ((G.obj.map h.op).hom x)) z =
          ∑ j : Fin b, wcContEval S T y (h.left z) j •
            wcContEval S V ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom
              ((G.obj.map h.op).hom (xs j))) z) ∧
      (∀ x' : G.obj.obj (Opposite.op T),
        (∀ (V : S.ProEt) (h : V ⟶ T) (h' : V ⟶ W), h' ≫ w = h ≫ g → ∀ z : V.left,
          wcContEval S V ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom ((G.obj.map h.op).hom x')) z =
          wcContEval S V ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom ((G.obj.map h.op).hom x)) z) →
        x' = x) :=
by
  classical
  have hF : ∀ (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      {A B C : S.ProEt} (k : A ⟶ B) (m' : B ⟶ C) (y : F.obj.obj (Opposite.op C)),
      (F.obj.map k.op).hom ((F.obj.map m'.op).hom y) = (F.obj.map (k ≫ m').op).hom y := by
    intro F A B C k m' y
    rw [op_comp, Functor.map_comp]
    rfl
  have hCext : ∀ (V : S.ProEt)
      (f₁ f₂ : (wcContSheaf S (Fin N → ℚ_[ℓ])).obj.obj (Opposite.op V)),
      (∀ z, wcContEval S V f₁ z = wcContEval S V f₂ z) → f₁ = f₂ := by
    intro V f₁ f₂ h
    have : (show ULift.{u+1} C(↥V.left, Fin N → ℚ_[ℓ]) from f₁) =
        (show ULift.{u+1} C(↥V.left, Fin N → ℚ_[ℓ]) from f₂) :=
      ULift.ext _ _ (ContinuousMap.ext h)
    exact this
  have hEv : ∀ {a : ℕ} (V V' : S.ProEt) (k : V' ⟶ V)
      (f : (wcContSheaf S (Fin a → ℚ_[ℓ])).obj.obj (Opposite.op V)) (ζ : V'.left),
      wcContEval S V' (((wcContSheaf S (Fin a → ℚ_[ℓ])).obj.map k.op).hom f) ζ =
        wcContEval S V f (k.left ζ) := fun _ _ _ _ _ => rfl
  have hpt : ∀ {A B C : S.ProEt} (k : A ⟶ B) (m' : B ⟶ C) (ζ : A.left),
      (k ≫ m').left ζ = m'.left (k.left ζ) := by
    intro A B C k m' ζ
    first
      | rfl
      | simp [Scheme.Hom.comp_apply]
  obtain ⟨Θ, hΘ⟩ : ∃ Θ : ∀ (V : S.ProEt) (_ : V ⟶ W),
      G.obj.obj (Opposite.op V) →+ (wcContSheaf S (Fin N → ℚ_[ℓ])).obj.obj (Opposite.op V),
      ∀ V h' y, Θ V h' y = (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom y :=
    ⟨fun V h' => (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom, fun _ _ _ => rfl⟩
  have hN : ∀ (V V' : S.ProEt) (k : V' ⟶ V) (h' : V ⟶ W) (y : G.obj.obj (Opposite.op V)),
      Θ V' (k ≫ h') ((G.obj.map k.op).hom y) =
        ((wcContSheaf S (Fin N → ℚ_[ℓ])).obj.map k.op).hom (Θ V h' y) := by
    intro V V' k h' y
    rw [hΘ, hΘ]
    exact congrArg (fun φ => φ.hom y)
      (θ.hom.hom.naturality (Over.homMk (U := Over.mk (k ≫ h')) (V := Over.mk h') k rfl).op)
  have hI : ∀ (V : S.ProEt) (h' : V ⟶ W) (a b : G.obj.obj (Opposite.op V)),
      Θ V h' a = Θ V h' b → a = b := by
    intro V h' a b hab
    rw [hΘ, hΘ] at hab
    have ha : (θ.inv.hom.app (Opposite.op (Over.mk h'))).hom
        ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom a) = a :=
      congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk h'))).hom a) θ.hom_inv_id
    have hb : (θ.inv.hom.app (Opposite.op (Over.mk h'))).hom
        ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom b) = b :=
      congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk h'))).hom b) θ.hom_inv_id
    rw [← ha, ← hb, hab]
  have hR : ∀ (V : S.ProEt) (h' : V ⟶ W)
      (y : (wcContSheaf S (Fin N → ℚ_[ℓ])).obj.obj (Opposite.op V)),
      ∃ x₀ : G.obj.obj (Opposite.op V), Θ V h' x₀ = y := by
    intro V h' y
    refine ⟨(θ.inv.hom.app (Opposite.op (Over.mk h'))).hom y, ?_⟩
    exact (hΘ V h' _).trans
      (congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk h'))).hom y) θ.inv_hom_id)

  have bc : ∀ (B W' : S.ProEt) (w' : W' ⟶ B), QuasiCompact w'.left →
      ∀ (V : S.ProEt) (g' : V ⟶ B),
      ∃ (V₁ : S.ProEt) (a : V₁ ⟶ V) (b : V₁ ⟶ W'), a ≫ g' = b ≫ w' ∧ QuasiCompact a.left ∧
        ∀ z : V.left, (∃ p : W'.left, w'.left p = g'.left z) → ∃ y : V₁.left, a.left y = z := by
    intro B W' w' hqc' V g'
    haveI := hqc'
    haveI hWp : WeaklyEtale W'.hom := W'.prop
    haveI hBp : WeaklyEtale B.hom := B.prop
    haveI hVp : WeaklyEtale V.hom := V.prop
    haveI hwB : WeaklyEtale (w'.left ≫ B.hom) := by
      rw [MorphismProperty.Over.w w']; exact hWp
    haveI : WeaklyEtale w'.left := WeaklyEtale.of_comp w'.left B.hom
    haveI hfst : WeaklyEtale (Limits.pullback.fst g'.left w'.left) := inferInstance
    haveI hfstq : QuasiCompact (Limits.pullback.fst g'.left w'.left) := inferInstance
    haveI : WeaklyEtale (Limits.pullback.fst g'.left w'.left ≫ V.hom) := inferInstance
    let V₁ : S.ProEt := Scheme.ProEt.mk (Limits.pullback.fst g'.left w'.left ≫ V.hom)
    let a : V₁ ⟶ V :=
      MorphismProperty.Over.homMk (Limits.pullback.fst g'.left w'.left) rfl trivial
    have hb : Limits.pullback.snd g'.left w'.left ≫ W'.hom =
        Limits.pullback.fst g'.left w'.left ≫ V.hom := by
      rw [← MorphismProperty.Over.w w', ← MorphismProperty.Over.w g', ← Category.assoc,
        ← Category.assoc, Limits.pullback.condition]
    let b : V₁ ⟶ W' :=
      MorphismProperty.Over.homMk (Limits.pullback.snd g'.left w'.left) hb trivial
    refine ⟨V₁, a, b, ?_, hfstq, ?_⟩
    · apply MorphismProperty.Over.Hom.ext
      exact Limits.pullback.condition
    · rintro z ⟨p, hp⟩
      obtain ⟨τ, hτ, -⟩ := Scheme.Pullback.exists_preimage_pullback z p hp.symm
      exact ⟨τ, hτ⟩

  have glue : ∀ (T₀ V₁ : S.ProEt) (a : V₁ ⟶ T₀), QuasiCompact a.left →
      (∀ z : T₀.left, ∃ y : V₁.left, a.left y = z) → ∀ (x₁ : G.obj.obj (Opposite.op V₁)),
      (∀ (Z : S.ProEt) (c d : Z ⟶ V₁), c ≫ a = d ≫ a →
        (G.obj.map c.op).hom x₁ = (G.obj.map d.op).hom x₁) →
      ∃ x : G.obj.obj (Opposite.op T₀), (G.obj.map a.op).hom x = x₁ ∧
        ∀ x' : G.obj.obj (Opposite.op T₀), (G.obj.map a.op).hom x' = x₁ → x' = x := by
    intro T₀ V₁ a haq hsurj x₁ hcomp
    haveI := haq
    haveI hTp : WeaklyEtale T₀.hom := T₀.prop
    haveI hVp : WeaklyEtale V₁.hom := V₁.prop
    haveI hwB : WeaklyEtale (a.left ≫ T₀.hom) := by
      rw [MorphismProperty.Over.w a]; exact hVp
    haveI hae : WeaklyEtale a.left := WeaklyEtale.of_comp a.left T₀.hom
    have hsurj' : ∀ x : T₀.left, ∃ (_ : PUnit.{u+2}) (y : V₁.left), a.left y = x := by
      intro p
      obtain ⟨y, hy⟩ := hsurj p
      exact ⟨PUnit.unit, y, hy⟩
    let 𝒰 : Scheme.Cover (Scheme.precoverage @WeaklyEtale) T₀.left :=
      Scheme.Cover.mkOfCovers (P := @WeaklyEtale) PUnit.{u+2} (fun _ => V₁.left)
        (fun _ => a.left) hsurj' (fun _ => hae)
    have hqc𝒰 : QuasiCompactCover 𝒰.toPreZeroHypercover :=
      @QuasiCompactCover.of_finite _ _ 𝒰 Scheme.instJointlySurjectivePrecoverage
        (fun _ => haq) (inferInstanceAs (Finite PUnit.{u+2}))
    have hR0 : Presieve.ofArrows (fun _ : PUnit.{u+2} => V₁.left) (fun _ => a.left) ∈
        Scheme.proetalePrecoverage.coverings T₀.left :=
      Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover.mpr ⟨𝒰, hqc𝒰, rfl⟩
    have e := Presieve.map_ofArrows (F := Scheme.ProEt.forget S ⋙ Over.forget S)
      (Y := fun _ : PUnit.{u+2} => V₁) (fun _ => a)
    have hR' : Presieve.ofArrows (fun _ : PUnit.{u+2} => V₁) (fun _ => a) ∈
        (Scheme.ProEt.precoverage S).coverings T₀ :=
      Precoverage.mem_comap_iff.mpr (e ▸ hR0)
    have hRJ : Sieve.generate (Presieve.ofArrows (fun _ : PUnit.{u+2} => V₁) (fun _ => a)) ∈
        (Scheme.ProEt.topology S) T₀ :=
      Precoverage.generate_mem_toGrothendieck hR'
    have hsh : Presieve.IsSheaf (Scheme.ProEt.topology S) (G.obj ⋙ forget AddCommGrpCat.{u+1}) :=
      (isSheaf_iff_isSheaf_of_type _ _).mp
        ((sheafCompose (Scheme.ProEt.topology S) (forget AddCommGrpCat.{u+1})).obj G).property
    have h1 := hsh _ hRJ
    rw [← Presieve.isSheafFor_iff_generate, Presieve.ofArrows_pUnit] at h1
    obtain ⟨t, ht, hu⟩ := (Presieve.isSheafFor_singleton.mp h1) x₁
      (fun p₁ p₂ hp => hcomp _ p₁ p₂ hp)
    exact ⟨t, ht, fun x' hx' => hu x' hx'⟩

  obtain ⟨V₁, p₁, p₂, hsq, hqc₁, hlift₁⟩ := bc B₀ W w hqc T g
  have hsurj₁ : ∀ z : T.left, ∃ y : V₁.left, p₁.left y = z := fun z => hlift₁ z (hlift z)
  have hsqk : ∀ {Z : S.ProEt} (k : Z ⟶ V₁), (k ≫ p₂) ≫ w = (k ≫ p₁) ≫ g := by
    intro Z k
    simp only [Category.assoc, hsq]

  have hF₁ : Continuous (fun ζ : V₁.left => ∑ j : Fin b, wcContEval S T y (p₁.left ζ) j •
      wcContEval S V₁ (Θ V₁ p₂ ((G.obj.map p₁.op).hom (xs j))) ζ) := by
    refine continuous_finsetSum _ (fun j _ => ?_)
    have c1 : Continuous (fun ζ : V₁.left => wcContEval S T y (p₁.left ζ) j) :=
      (continuous_apply j).comp
        ((show ULift.{u+1} C(↥T.left, Fin b → ℚ_[ℓ]) from y).down.continuous.comp
          p₁.left.continuous)
    have c2 : Continuous (fun ζ : V₁.left =>
        wcContEval S V₁ (Θ V₁ p₂ ((G.obj.map p₁.op).hom (xs j))) ζ) :=
      (show ULift.{u+1} C(↥V₁.left, Fin N → ℚ_[ℓ]) from
        (Θ V₁ p₂ ((G.obj.map p₁.op).hom (xs j)))).down.continuous
    exact c1.smul c2
  let f₁ : (wcContSheaf S (Fin N → ℚ_[ℓ])).obj.obj (Opposite.op V₁) :=
    ULift.up ⟨fun ζ : V₁.left => ∑ j : Fin b, wcContEval S T y (p₁.left ζ) j •
      wcContEval S V₁ (Θ V₁ p₂ ((G.obj.map p₁.op).hom (xs j))) ζ, hF₁⟩
  obtain ⟨x₁, hx₁⟩ := hR V₁ p₂ f₁
  have hx₁e : ∀ ζ : V₁.left, wcContEval S V₁ (Θ V₁ p₂ x₁) ζ =
      ∑ j : Fin b, wcContEval S T y (p₁.left ζ) j •
        wcContEval S V₁ (Θ V₁ p₂ ((G.obj.map p₁.op).hom (xs j))) ζ := by
    intro ζ
    exact (congrArg (fun q => wcContEval S V₁ q ζ) hx₁).trans rfl

  have hK : ∀ (Z : S.ProEt) (k : Z ⟶ V₁) (h₂ : Z ⟶ W), h₂ ≫ w = (k ≫ p₁) ≫ g →
      ∀ ζ : Z.left, wcContEval S Z (Θ Z h₂ ((G.obj.map k.op).hom x₁)) ζ =
        ∑ j : Fin b, wcContEval S T y ((k ≫ p₁).left ζ) j •
          wcContEval S Z (Θ Z h₂ ((G.obj.map (k ≫ p₁).op).hom (xs j))) ζ := by
    intro Z k h₂ hh ζ
    have hc : (k ≫ p₂) ≫ w = h₂ ≫ w := by rw [hsqk k, hh]
    obtain ⟨A, hA⟩ := hlin Z (k ≫ p₂) h₂ hc ζ
    have hA' : ∀ x : G.obj.obj (Opposite.op Z),
        wcContEval S Z (Θ Z h₂ x) ζ = A (wcContEval S Z (Θ Z (k ≫ p₂) x) ζ) := by
      intro x
      rw [hΘ, hΘ]
      exact hA x
    have h1 : wcContEval S Z (Θ Z (k ≫ p₂) ((G.obj.map k.op).hom x₁)) ζ =
        ∑ j : Fin b, wcContEval S T y ((k ≫ p₁).left ζ) j •
          wcContEval S Z (Θ Z (k ≫ p₂) ((G.obj.map (k ≫ p₁).op).hom (xs j))) ζ := by
      rw [hN, hEv, hx₁e]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [← hF G k p₁, hN, hEv, hpt]
    rw [hA', h1, map_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [map_smul, hA']

  have hdesc : ∀ (Z : S.ProEt) (c d : Z ⟶ V₁), c ≫ p₁ = d ≫ p₁ →
      (G.obj.map c.op).hom x₁ = (G.obj.map d.op).hom x₁ := by
    intro Z c d hcd
    apply hI Z (d ≫ p₂)
    apply hCext
    intro ζ
    have e1 := hK Z c (d ≫ p₂) (by rw [hsqk d, hcd]) ζ
    have e2 := hK Z d (d ≫ p₂) (hsqk d) ζ
    rw [hcd] at e1
    rw [e1, e2]

  obtain ⟨x, hx, hxu⟩ := glue T V₁ p₁ hqc₁ hsurj₁ x₁ hdesc
  refine ⟨x, fun V h h' hc z => ?_, fun x' hx' => ?_⟩
  ·
    obtain ⟨V', q, r, hsq₂, -, hlift₂⟩ := bc T V₁ p₁ hqc₁ V h
    obtain ⟨v', hv'⟩ := hlift₂ z (hsurj₁ (h.left z))
    have hy : (G.obj.map (q ≫ h).op).hom x = (G.obj.map r.op).hom x₁ := by
      rw [hsq₂, ← hF G r p₁, hx]
    have hw : (q ≫ h') ≫ w = (r ≫ p₁) ≫ g := by
      rw [← hsq₂]
      simp only [Category.assoc, hc]
    have e1 := hK V' r (q ≫ h') hw v'
    rw [← hy, ← hsq₂] at e1
    simp only [← hΘ]
    rw [← hv', ← hEv V V' q, ← hN, hF, e1]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [hpt, ← hF G q h, hN, hEv]
  ·
    have h1 : (G.obj.map p₁.op).hom x' = (G.obj.map p₁.op).hom x := by
      apply hI V₁ p₂
      apply hCext
      intro ζ
      rw [hΘ, hΘ]
      exact hx' V₁ p₁ p₂ hsq.symm ζ
    exact hxu x' (h1.trans hx)

theorem wc_proet_comb_lift_phi_eq (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (B₀ W : S.ProEt) (w : W ⟶ B₀) (hqc : QuasiCompact w.left)
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (N : ℕ)
    (θ : G.over W ≅ (wcContSheaf S (Fin N → ℚ_[ℓ])).over W)
    (b : ℕ) (L₀ : (Fin N → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin b → ℚ_[ℓ]))
    (Φ : G.over B₀ ⟶ (wcContSheaf S (Fin b → ℚ_[ℓ])).over B₀)
    (hΦ : ∀ (V : S.ProEt) (h' : V ⟶ W) (x : G.obj.obj (Opposite.op V)) (z : V.left),
      wcContEval S V ((Φ.hom.app (Opposite.op (Over.mk (h' ≫ w)))).hom x) z =
        L₀ (wcContEval S V ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom x) z))
    (V : S.ProEt) (gV : V ⟶ B₀) (hlift : ∀ z : V.left, ∃ p : W.left, w.left p = gV.left z)
    (ts : Fin b → G.obj.obj (Opposite.op V))
    (hts : ∀ (j : Fin b) (z : V.left),
      wcContEval S V ((Φ.hom.app (Opposite.op (Over.mk gV))).hom (ts j)) z =
        (Pi.single j 1 : Fin b → ℚ_[ℓ]))
    (yV : (wcContSheaf S (Fin b → ℚ_[ℓ])).obj.obj (Opposite.op V))
    (X : G.obj.obj (Opposite.op V))
    (hX : ∀ (V' : S.ProEt) (h : V' ⟶ V) (h' : V' ⟶ W), h' ≫ w = h ≫ gV → ∀ z : V'.left,
      wcContEval S V' ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom ((G.obj.map h.op).hom X)) z =
        ∑ j : Fin b, wcContEval S V yV (h.left z) j •
          wcContEval S V' ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom
            ((G.obj.map h.op).hom (ts j))) z) :
    (Φ.hom.app (Opposite.op (Over.mk gV))).hom X = yV :=
by
  classical
  have hCext : ∀ (f₁ f₂ : (wcContSheaf S (Fin b → ℚ_[ℓ])).obj.obj (Opposite.op V)),
      (∀ z, wcContEval S V f₁ z = wcContEval S V f₂ z) → f₁ = f₂ := by
    intro f₁ f₂ h
    have : (show ULift.{u+1} C(↥V.left, Fin b → ℚ_[ℓ]) from f₁) =
        (show ULift.{u+1} C(↥V.left, Fin b → ℚ_[ℓ]) from f₂) :=
      ULift.ext _ _ (ContinuousMap.ext h)
    exact this
  obtain ⟨V₁, p₁, p₂, hsq, hsurj₁⟩ : ∃ (V₁ : S.ProEt) (p₁ : V₁ ⟶ V) (p₂ : V₁ ⟶ W),
      p₁ ≫ gV = p₂ ≫ w ∧ ∀ z : V.left, ∃ ζ : V₁.left, p₁.left ζ = z := by
    haveI := hqc
    haveI hWp : WeaklyEtale W.hom := W.prop
    haveI hBp : WeaklyEtale B₀.hom := B₀.prop
    haveI hVp : WeaklyEtale V.hom := V.prop
    haveI hwB : WeaklyEtale (w.left ≫ B₀.hom) := by
      rw [MorphismProperty.Over.w w]; exact hWp
    haveI : WeaklyEtale w.left := WeaklyEtale.of_comp w.left B₀.hom
    haveI hfst : WeaklyEtale (Limits.pullback.fst gV.left w.left) := inferInstance
    haveI : WeaklyEtale (Limits.pullback.fst gV.left w.left ≫ V.hom) := inferInstance
    let V₁ : S.ProEt := Scheme.ProEt.mk (Limits.pullback.fst gV.left w.left ≫ V.hom)
    let a : V₁ ⟶ V :=
      MorphismProperty.Over.homMk (Limits.pullback.fst gV.left w.left) rfl trivial
    have hb : Limits.pullback.snd gV.left w.left ≫ W.hom =
        Limits.pullback.fst gV.left w.left ≫ V.hom := by
      rw [← MorphismProperty.Over.w w, ← MorphismProperty.Over.w gV, ← Category.assoc,
        ← Category.assoc, Limits.pullback.condition]
    let c : V₁ ⟶ W :=
      MorphismProperty.Over.homMk (Limits.pullback.snd gV.left w.left) hb trivial
    refine ⟨V₁, a, c, ?_, ?_⟩
    · apply MorphismProperty.Over.Hom.ext
      exact Limits.pullback.condition
    · intro z
      obtain ⟨p, hp⟩ := hlift z
      obtain ⟨τ, hτ, -⟩ := Scheme.Pullback.exists_preimage_pullback z p hp.symm
      exact ⟨τ, hτ⟩
  have hswap : ∀ (g' : V₁ ⟶ B₀), g' = p₂ ≫ w → ∀ (u : G.obj.obj (Opposite.op V₁)) (ζ : V₁.left),
      wcContEval S V₁ ((Φ.hom.app (Opposite.op (Over.mk g'))).hom u) ζ =
        wcContEval S V₁ ((Φ.hom.app (Opposite.op (Over.mk (p₂ ≫ w)))).hom u) ζ := by
    intro g' hg u ζ
    subst hg
    rfl
  have hev : ∀ (u : G.obj.obj (Opposite.op V)) (ζ : V₁.left),
      wcContEval S V ((Φ.hom.app (Opposite.op (Over.mk gV))).hom u) (p₁.left ζ) =
        L₀ (wcContEval S V₁ ((θ.hom.hom.app (Opposite.op (Over.mk p₂))).hom
          ((G.obj.map p₁.op).hom u)) ζ) := by
    intro u ζ
    have h1 := congrArg (fun f => AddCommGrpCat.Hom.hom f u)
      (Φ.hom.naturality (Over.homMk p₁ rfl : Over.mk (p₁ ≫ gV) ⟶ Over.mk gV).op)
    have e : wcContEval S V₁ ((Φ.hom.app (Opposite.op (Over.mk (p₁ ≫ gV)))).hom
          ((G.obj.map p₁.op).hom u)) ζ =
        wcContEval S V ((Φ.hom.app (Opposite.op (Over.mk gV))).hom u) (p₁.left ζ) :=
      congrArg (fun f => wcContEval S V₁ f ζ) h1
    exact e.symm.trans ((hswap _ hsq _ ζ).trans (hΦ V₁ p₂ _ ζ))
  apply hCext
  intro z
  obtain ⟨ζ, rfl⟩ := hsurj₁ z
  have hj : ∀ j : Fin b, L₀ (wcContEval S V yV (p₁.left ζ) j •
      wcContEval S V₁ ((θ.hom.hom.app (Opposite.op (Over.mk p₂))).hom
        ((G.obj.map p₁.op).hom (ts j))) ζ) =
      wcContEval S V yV (p₁.left ζ) j • (Pi.single j 1 : Fin b → ℚ_[ℓ]) := by
    intro j
    rw [map_smul, ← hev (ts j) ζ, hts j]
  rw [hev X ζ, hX V₁ p₁ p₂ hsq.symm ζ, map_sum, Finset.sum_congr rfl (fun j _ => hj j)]
  ext i
  simp [Finset.sum_apply, Pi.single_apply]

theorem wc_proet_lift_of_const_lifts (K : Type u) [Field K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP)
    (hqc : QuasiCompact w.left)
    (hsurj : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left,
      (∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ z : W.left, w.left z = p)
    (N : ℕ) (θ : G.over W ≅ (wcContSheaf (wcP1Over K).left (Fin N → ℚ_[ℓ])).over W)
    (hlin : ∀ (V : (wcP1Over K).left.ProEt) (h₁ h₂ : V ⟶ W), h₁ ≫ w = h₂ ≫ w → ∀ z : V.left,
      ∃ A : (Fin N → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin N → ℚ_[ℓ]), ∀ x : G.obj.obj (Opposite.op V),
        wcContEval (wcP1Over K).left V ((θ.hom.hom.app (Opposite.op (Over.mk h₂))).hom x) z =
          A (wcContEval (wcP1Over K).left V ((θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x) z))
    (hext : ∀ (T : (wcP1Over K).left.ProEt) (g : T ⟶ wcGeomPoint K (wcP1Over K) hP)
      (xs : ∀ (V : (wcP1Over K).left.ProEt) (h : V ⟶ T),
        (∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint K)) →
        G.obj.obj (Opposite.op V)),
      (∀ (V V' : (wcP1Over K).left.ProEt) (k : V' ⟶ V) (h : V ⟶ T)
        (hV : ∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint K))
        (hV' : ∀ (v : V'.left) (i : Fin m), V'.hom v ≠ S i (IsLocalRing.closedPoint K)),
        (G.obj.map k.op).hom (xs V h hV) = xs V' (k ≫ h) hV') →
      ∃ x : G.obj.obj (Opposite.op T),
        ∀ (V : (wcP1Over K).left.ProEt) (h : V ⟶ T)
          (hV : ∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint K)),
          (G.obj.map h.op).hom x = xs V h hV)
    (b : ℕ) (L₀ : (Fin N → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin b → ℚ_[ℓ]))
    (Φ : G.over (wcGeomPoint K (wcP1Over K) hP) ⟶
        (wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).over (wcGeomPoint K (wcP1Over K) hP))
    (hΦ : ∀ (V : (wcP1Over K).left.ProEt) (h' : V ⟶ W) (x : G.obj.obj (Opposite.op V))
      (z : V.left),
      wcContEval (wcP1Over K).left V ((Φ.hom.app (Opposite.op (Over.mk (h' ≫ w)))).hom x) z =
        L₀ (wcContEval (wcP1Over K).left V ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom x) z))
    (T : (wcP1Over K).left.ProEt) (g : T ⟶ wcGeomPoint K (wcP1Over K) hP)
    (s : Fin b → G.obj.obj (Opposite.op T))
    (hs : ∀ (j : Fin b) (z : T.left),
      wcContEval (wcP1Over K).left T ((Φ.hom.app (Opposite.op (Over.mk g))).hom (s j)) z =
        (Pi.single j 1 : Fin b → ℚ_[ℓ]))
    (y : (wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.obj (Opposite.op T)) :
    ∃ x : G.obj.obj (Opposite.op T), (Φ.hom.app (Opposite.op (Over.mk g))).hom x = y :=
by
  classical
  have hF : ∀ (F : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
      {A B C : (wcP1Over K).left.ProEt} (k : A ⟶ B) (m' : B ⟶ C) (y : F.obj.obj (Opposite.op C)),
      (F.obj.map k.op).hom ((F.obj.map m'.op).hom y) = (F.obj.map (k ≫ m').op).hom y := by
    intro F A B C k m' y
    rw [op_comp, Functor.map_comp]
    rfl
  have hliftV : ∀ (V : (wcP1Over K).left.ProEt) (h : V ⟶ T),
      (∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint K)) →
      ∀ z : V.left, ∃ p : W.left, w.left p = (h ≫ g).left z := by
    intro V h hV z
    apply hsurj
    intro i
    have hw : (h ≫ g).left ≫ (wcGeomPoint K (wcP1Over K) hP).hom = V.hom := by
      obtain ⟨gh, hgh⟩ : ∃ gh : V ⟶ wcGeomPoint K (wcP1Over K) hP, gh = h ≫ g := ⟨_, rfl⟩
      rw [← hgh]
      exact MorphismProperty.Over.w gh
    have e : (wcGeomPoint K (wcP1Over K) hP).hom ((h ≫ g).left z) = V.hom z := by
      rw [← hw, Scheme.Hom.comp_apply]
    rw [e]
    exact hV z i
  have hdesc := fun (V : (wcP1Over K).left.ProEt) (h : V ⟶ T)
      (hV : ∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint K)) =>
    wc_proet_frame_linear_descent (wcP1Over K).left ℓ (wcGeomPoint K (wcP1Over K) hP) W w hqc
      G N θ hlin V (h ≫ g) (hliftV V h hV) b (fun j => (G.obj.map h.op).hom (s j))
      (((wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.map h.op).hom y)
  choose X hXc hXu using hdesc
  have hcompat : ∀ (V V' : (wcP1Over K).left.ProEt) (k : V' ⟶ V) (h : V ⟶ T)
      (hV : ∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint K))
      (hV' : ∀ (v : V'.left) (i : Fin m), V'.hom v ≠ S i (IsLocalRing.closedPoint K)),
      (G.obj.map k.op).hom (X V h hV) = X V' (k ≫ h) hV' := by
    intro V V' k h hV hV'
    apply hXu V' (k ≫ h) hV'
    intro V₂ k₂ h₂ hc z
    have hc' : h₂ ≫ w = (k₂ ≫ k) ≫ h ≫ g := by
      rw [hc]; simp only [Category.assoc]
    rw [hF G k₂ k, hXc V h hV V₂ (k₂ ≫ k) h₂ hc' z, hXc V' (k ≫ h) hV' V₂ k₂ h₂ hc z]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [hF G k₂ (k ≫ h), hF G (k₂ ≫ k) h, Category.assoc]
    rfl
  obtain ⟨x, hx⟩ := hext T g X hcompat
  refine ⟨x, ?_⟩
  have hnatΦ : ∀ (V : (wcP1Over K).left.ProEt) (h : V ⟶ T) (u : G.obj.obj (Opposite.op T)),
      ((wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.map h.op).hom
          ((Φ.hom.app (Opposite.op (Over.mk g))).hom u) =
        (Φ.hom.app (Opposite.op (Over.mk (h ≫ g)))).hom ((G.obj.map h.op).hom u) := by
    intro V h u
    exact (congrArg (fun f => AddCommGrpCat.Hom.hom f u)
      (Φ.hom.naturality (Over.homMk h rfl : Over.mk (h ≫ g) ⟶ Over.mk g).op)).symm
  obtain ⟨Φx, hΦx⟩ : ∃ Φx : (wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.obj
      (Opposite.op T), Φx = (Φ.hom.app (Opposite.op (Over.mk g))).hom x := ⟨_, rfl⟩
  have hD := wc_P1_contSheaf_off_points_vanish K ℓ b m S hS T (Φx - y) (by
      intro V h hV
      have e1 : ((wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.map h.op).hom Φx =
          ((wcContSheaf (wcP1Over K).left (Fin b → ℚ_[ℓ])).obj.map h.op).hom y := by
        rw [hΦx, hnatΦ V h x]
        have e2 := hx V h hV
        have e3 := wc_proet_comb_lift_phi_eq (wcP1Over K).left ℓ (wcGeomPoint K (wcP1Over K) hP)
          W w hqc G N θ b L₀ Φ hΦ V (h ≫ g) (hliftV V h hV) (fun j => (G.obj.map h.op).hom (s j))
          (fun j z => (congrArg (fun f => wcContEval (wcP1Over K).left V f z)
            (hnatΦ V h (s j))).symm.trans (hs j (h.left z)))
          _ (X V h hV) (hXc V h hV)
        exact (congrArg (fun u => (Φ.hom.app (Opposite.op (Over.mk (h ≫ g)))).hom u) e2).trans e3
      rw [map_sub, e1, sub_self])
  exact hΦx.symm.trans (sub_eq_zero.mp hD)

theorem wc_honest_descended_epi (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (H : wcHonestPL D ℓ hP) (U : Submodule ℚ_[ℓ] (Fin H.N → ℚ_[ℓ]))
    (hUr : ∀ γ : H.W ⟶ H.W, γ ≫ H.w = H.w → ∀ x, H.fr γ x - x ∈ U)
    (hUS : ∀ (i : Fin D.m) (x : Fin H.N → ℚ_[ℓ]), ∃ u ∈ U, H.lam i (x - u) = 0)
    (b : ℕ) (L₀ : (Fin H.N → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin b → ℚ_[ℓ]))
    (hL : LinearMap.ker L₀ = U) (hLs : Function.Surjective L₀)
    (Φ : (wcRq D.f ℓ (n - 1)).over (wcGeomPoint F'' (wcP1Over F'') hP) ⟶
        (wcContSheaf (wcP1Over F'').left (Fin b → ℚ_[ℓ])).over
          (wcGeomPoint F'' (wcP1Over F'') hP))
    (hΦ : ∀ (V : (wcP1Over F'').left.ProEt) (h' : V ⟶ H.W)
      (x : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)) (z : V.left),
      wcContEval (wcP1Over F'').left V
          ((Φ.hom.app (Opposite.op (Over.mk (h' ≫ H.w)))).hom x) z =
        L₀ (wcContEval (wcP1Over F'').left V
          ((H.θ.hom.hom.app (Opposite.op (Over.mk h'))).hom x) z)) :
    Epi Φ :=
by
  classical

  have hnat : ∀ (V V₁ : (wcP1Over F'').left.ProEt) (k : V₁ ⟶ V) (h : V ⟶ H.W)
      (x : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)) (z₁ : V₁.left),
      wcContEval (wcP1Over F'').left V₁ ((H.θ.hom.hom.app (Opposite.op (Over.mk (k ≫ h)))).hom
        (((wcRq D.f ℓ (n - 1)).obj.map k.op).hom x)) z₁ =
      wcContEval (wcP1Over F'').left V
        ((H.θ.hom.hom.app (Opposite.op (Over.mk h))).hom x) (k.left z₁) := by
    intro V V₁ k h x z₁
    have h1 := congrArg (fun f => AddCommGrpCat.Hom.hom f x)
      (H.θ.hom.hom.naturality (Over.homMk k rfl : Over.mk (k ≫ h) ⟶ Over.mk h).op)
    exact congrArg (fun f => wcContEval (wcP1Over F'').left V₁ f z₁) h1

  have hdeck : ∀ γ : H.W ⟶ H.W, γ ≫ H.w = H.w → ∀ (V : (wcP1Over F'').left.ProEt)
      (a c : V ⟶ H.W), c = a ≫ γ → ∀ (x : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V))
      (z : V.left),
      wcContEval (wcP1Over F'').left V ((H.θ.hom.hom.app (Opposite.op (Over.mk c))).hom x) z =
        H.fr γ (wcContEval (wcP1Over F'').left V
          ((H.θ.hom.hom.app (Opposite.op (Over.mk a))).hom x) z) := by
    intro γ hγ
    obtain ⟨A, hA⟩ := wc_proet_deck_frame_linear (wcP1Over F'').left ℓ (wcRq D.f ℓ (n - 1))
      H.W H.hconn H.N H.θ γ
    have hAfr : A = H.fr γ := by
      apply LinearMap.ext
      intro y
      haveI := H.hconn
      obtain ⟨z₀⟩ := (inferInstance : Nonempty ↥H.W.left)
      let c : (wcContSheaf (wcP1Over F'').left (Fin H.N → ℚ_[ℓ])).obj.obj (Opposite.op H.W) :=
        ULift.up (ContinuousMap.const _ y)
      let s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op H.W) :=
        (H.θ.inv.hom.app (Opposite.op (Over.mk (𝟙 H.W)))).hom c
      have hs : (H.θ.hom.hom.app (Opposite.op (Over.mk (𝟙 H.W)))).hom s = c :=
        congrArg (fun f => AddCommGrpCat.Hom.hom (f.hom.app (Opposite.op (Over.mk (𝟙 H.W)))) c)
          H.θ.inv_hom_id
      have h1 := hA H.W (𝟙 H.W) γ (Category.id_comp γ).symm s z₀
      have h2 := H.hfr γ hγ s z₀
      have h3 : (show C(↥H.W.left, Fin H.N → ℚ_[ℓ]) from
          ((H.θ.hom.hom.app (Opposite.op (Over.mk (𝟙 H.W)))).hom s).down) z₀ = y := by
        rw [hs]; rfl
      rw [h3] at h1 h2
      exact h1.symm.trans h2
    intro V a c hc x z
    have := hA V a c hc x z
    rw [hAfr] at this
    exact this

  have hlin : ∀ (V : (wcP1Over F'').left.ProEt) (h₁ h₂ : V ⟶ H.W), h₁ ≫ H.w = h₂ ≫ H.w →
      ∀ z : V.left, ∃ A : (Fin H.N → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin H.N → ℚ_[ℓ]),
        ∀ x : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V),
        wcContEval (wcP1Over F'').left V ((H.θ.hom.hom.app (Opposite.op (Over.mk h₂))).hom x) z =
          A (wcContEval (wcP1Over F'').left V
            ((H.θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x) z) := by
    intro V h₁ h₂ hc z
    obtain ⟨V₁, k, z₁, hV₁, rfl⟩ := wc_proet_connected_nbhd (wcP1Over F'').left V z
    obtain ⟨γ, hγ, hbγ⟩ := H.hgal V₁ (k ≫ h₁) (k ≫ h₂) hV₁
      (by rw [Category.assoc, Category.assoc, hc])
    refine ⟨H.fr γ, fun x => ?_⟩
    rw [← hnat V V₁ k h₁ x z₁, ← hnat V V₁ k h₂ x z₁]
    exact hdeck γ hγ V₁ (k ≫ h₁) (k ≫ h₂) hbγ _ z₁

  have hext := wc_pencil_Rq_extend_off_crit F' F'' Y n hn hn2 D ℓ hℓ hP

  have hCextb : ∀ (V : (wcP1Over F'').left.ProEt)
      (f₁ f₂ : (wcContSheaf (wcP1Over F'').left (Fin b → ℚ_[ℓ])).obj.obj (Opposite.op V)),
      (∀ z, wcContEval (wcP1Over F'').left V f₁ z = wcContEval (wcP1Over F'').left V f₂ z) →
        f₁ = f₂ := by
    intro V f₁ f₂ h
    have : (show ULift.{u+1} C(↥V.left, Fin b → ℚ_[ℓ]) from f₁) =
        (show ULift.{u+1} C(↥V.left, Fin b → ℚ_[ℓ]) from f₂) :=
      ULift.ext _ _ (ContinuousMap.ext h)
    exact this

  obtain ⟨σ, hσ⟩ := LinearMap.exists_rightInverse_of_surjective L₀
    (LinearMap.range_eq_top.mpr hLs)

  have hlocdata : ∀ i : Fin D.m, ∃ (V : (wcP1Over F'').left.ProEt)
      (v : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
      (s : Fin b → (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)),
      CompactSpace V.left ∧ (∃ p : V.left, V.hom p = D.S i (IsLocalRing.closedPoint F'')) ∧
      ∀ (j : Fin b) (z : V.left),
        wcContEval (wcP1Over F'').left V ((Φ.hom.app (Opposite.op (Over.mk v))).hom (s j)) z =
          (Pi.single j 1 : Fin b → ℚ_[ℓ]) := by
    intro i
    obtain ⟨V₀, g₀, φ₀, A, iA, hA, hsc, e, ε, hV, -, -, -⟩ :=
      wc_P1bar_strict_local_nbhd F'' (D.S i) (D.hS i) hP
    obtain ⟨s, hs⟩ := wc_honest_strict_local_basis F' F'' Y n hn hn2 D ℓ hℓ hP H U hUS b L₀ hL hLs
      Φ hΦ i V₀ g₀ A e hV
    have hcpt : CompactSpace V₀.left :=
      Function.Surjective.compactSpace (f := e.inv) e.inv.continuous
        (fun p => ⟨e.hom p, Scheme.hom_inv_apply e p⟩)
    exact ⟨V₀, g₀, s, hcpt, ⟨_, hV⟩, hs⟩
  choose V v s hVc hVp hs using hlocdata

  have hWcase : ∀ (T' : (wcP1Over F'').left.ProEt) (g₁ : T' ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
      (c : T' ⟶ H.W), g₁ = c ≫ H.w →
      ∀ y' : (wcContSheaf (wcP1Over F'').left (Fin b → ℚ_[ℓ])).obj.obj (Opposite.op T'),
      ∃ x : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op T'),
        (Φ.hom.app (Opposite.op (Over.mk g₁))).hom x = y' := by
    intro T' g₁ c hg y'
    subst hg
    let f : (wcContSheaf (wcP1Over F'').left (Fin H.N → ℚ_[ℓ])).obj.obj (Opposite.op T') :=
      ULift.up ⟨fun z => σ (wcContEval (wcP1Over F'').left T' y' z),
        (LinearMap.continuous_of_finiteDimensional σ).comp
          (show C(↥T'.left, Fin b → ℚ_[ℓ]) from y'.down).continuous⟩
    have hθ : (H.θ.hom.hom.app (Opposite.op (Over.mk c))).hom
        ((H.θ.inv.hom.app (Opposite.op (Over.mk c))).hom f) = f :=
      congrArg (fun φ => AddCommGrpCat.Hom.hom (φ.hom.app (Opposite.op (Over.mk c))) f)
        H.θ.inv_hom_id
    refine ⟨(H.θ.inv.hom.app (Opposite.op (Over.mk c))).hom f, ?_⟩
    refine hCextb T' _ _ (fun z => ?_)
    have hθz : wcContEval (wcP1Over F'').left T' ((H.θ.hom.hom.app (Opposite.op (Over.mk c))).hom
        ((H.θ.inv.hom.app (Opposite.op (Over.mk c))).hom f)) z =
        σ (wcContEval (wcP1Over F'').left T' y' z) := by
      first
        | (rw [hθ]; rfl)
        | (erw [hθ]; rfl)
        | exact congrArg (fun q => (show C(↥T'.left, Fin H.N → ℚ_[ℓ]) from q.down) z) hθ
    refine (hΦ T' c _ z).trans ?_
    rw [hθz, ← LinearMap.comp_apply, hσ, LinearMap.id_apply]

  have hVcase : ∀ (T' : (wcP1Over F'').left.ProEt) (g₁ : T' ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
      (i : Fin D.m) (c : T' ⟶ V i), g₁ = c ≫ v i →
      ∀ (j : Fin b) (z : T'.left),
        wcContEval (wcP1Over F'').left T' ((Φ.hom.app (Opposite.op (Over.mk g₁))).hom
          (((wcRq D.f ℓ (n - 1)).obj.map c.op).hom (s i j))) z =
          (Pi.single j 1 : Fin b → ℚ_[ℓ]) := by
    intro T' g₁ i c hg j z
    subst hg
    have h1 := congrArg (fun f => AddCommGrpCat.Hom.hom f (s i j))
      (Φ.hom.naturality (Over.homMk c rfl : Over.mk (c ≫ v i) ⟶ Over.mk (v i)).op)
    have e : wcContEval (wcP1Over F'').left T' ((Φ.hom.app (Opposite.op (Over.mk (c ≫ v i)))).hom
          (((wcRq D.f ℓ (n - 1)).obj.map c.op).hom (s i j))) z =
        wcContEval (wcP1Over F'').left (V i)
          ((Φ.hom.app (Opposite.op (Over.mk (v i)))).hom (s i j)) (c.left z) :=
      congrArg (fun f => wcContEval (wcP1Over F'').left T' f z) h1
    rw [e]
    exact hs i j _

  haveI : Sheaf.IsLocallySurjective Φ := by
    apply (Sheaf.isLocallySurjective_sheafToPresheaf_map_iff Φ).mp
    refine Presheaf.IsLocallySurjective.mk (fun {Yo} y => ?_)
    rw [GrothendieckTopology.mem_over_iff]
    apply wc_P1bar_crit_cover F'' hP D.m D.S D.hS H.W H.w H.hqc H.hcov V v hVc hVp Yo.left Yo.hom
    intro T' k hk
    rw [Sieve.overEquiv_iff]
    obtain ⟨y', hy'⟩ : ∃ y' : (wcContSheaf (wcP1Over F'').left (Fin b → ℚ_[ℓ])).obj.obj
        (Opposite.op T'),
        (((wcContSheaf (wcP1Over F'').left (Fin b → ℚ_[ℓ])).over
          (wcGeomPoint F'' (wcP1Over F'') hP)).obj.map
            (Over.homMk k rfl : Over.mk (k ≫ Yo.hom) ⟶ Yo).op).hom y = y' := ⟨_, rfl⟩
    have main : ∃ x : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op T'),
        (Φ.hom.app (Opposite.op (Over.mk (k ≫ Yo.hom)))).hom x = y' := by
      rcases hk with ⟨c, hc⟩ | ⟨i, c, hc⟩
      · exact hWcase T' (k ≫ Yo.hom) c hc y'
      · exact wc_proet_lift_of_const_lifts F'' hP ℓ D.m D.S D.hS (wcRq D.f ℓ (n - 1)) H.W H.w
          H.hqc H.hcov H.N H.θ hlin hext b L₀ Φ hΦ T' (k ≫ Yo.hom)
          (fun j => ((wcRq D.f ℓ (n - 1)).obj.map c.op).hom (s i j))
          (hVcase T' (k ≫ Yo.hom) i c hc) y'
    obtain ⟨x, hx⟩ := main
    exact ⟨x, hx.trans hy'.symm⟩
  exact Sheaf.epi_of_isLocallySurjective Φ

theorem wc_proet_over_coker_iso_of_epi_ker (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (B : S.ProEt) (R : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (M : Subobject R)
    (b : ℕ) (Φ : R.over B ⟶ (wcContSheaf S (Fin b → ℚ_[ℓ])).over B) (hepi : Epi Φ)
    (hker : ∀ (T : S.ProEt) (g : T ⟶ B) (x : R.obj.obj (Opposite.op T)),
      (Φ.hom.app (Opposite.op (Over.mk g))).hom x = 0 ↔
        ∃ x' : (Subobject.underlying.obj M).obj.obj (Opposite.op T),
          (M.arrow.hom.app (Opposite.op T)).hom x' = x) :
    Nonempty ((Limits.cokernel M.arrow).over B ≅ (wcContSheaf S (Fin b → ℚ_[ℓ])).over B) :=
by
  classical
  let ρ := (Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} B
  haveI : ρ.IsLeftAdjoint := ⟨_, ⟨(Over.forget B).sheafAdjunctionCocontinuous AddCommGrpCat.{u+1}
    ((Scheme.ProEt.topology S).over B) (Scheme.ProEt.topology S)⟩⟩
  have hinjM : ∀ T : (S.ProEt)ᵒᵖ, Function.Injective (M.arrow.hom.app T).hom := by
    intro T
    have h1 : Mono M.arrow.hom :=
      (Sheaf.Hom.mono_iff_presheaf_mono (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} M.arrow).1
        inferInstance
    have h2 : Mono (M.arrow.hom.app T) := (NatTrans.mono_iff_mono_app M.arrow.hom).1 h1 T
    exact (AddCommGrpCat.mono_iff_injective _).1 h2
  let ι := ρ.map M.arrow
  have hinj : ∀ X : (Over B)ᵒᵖ, Function.Injective (ι.hom.app X).hom := fun X => hinjM _
  have hex : ∀ (X : (Over B)ᵒᵖ) (z : (R.over B).obj.obj X),
      (Φ.hom.app X).hom z = 0 ↔ ∃ a, (ι.hom.app X).hom a = z := by
    intro X z
    exact hker X.unop.left X.unop.hom z
  have hext : ∀ {P Q : Sheaf ((Scheme.ProEt.topology S).over B) AddCommGrpCat.{u+1}}
      (f g : P ⟶ Q), (∀ X a, (f.hom.app X).hom a = (g.hom.app X).hom a) → f = g := by
    intro P Q f g h
    apply Sheaf.hom_ext
    ext X a
    exact h X a
  have hw : ι ≫ Φ = 0 := by
    apply hext
    intro X a
    show (Φ.hom.app X).hom ((ι.hom.app X).hom a) = 0
    exact (hex X _).2 ⟨a, rfl⟩
  have hpt : ∀ (W' : Sheaf ((Scheme.ProEt.topology S).over B) AddCommGrpCat.{u+1})
      (g' : W' ⟶ R.over B), g' ≫ Φ = 0 → ∀ (X : (Over B)ᵒᵖ) (s : W'.obj.obj X),
      ∃ a, (ι.hom.app X).hom a = (g'.hom.app X).hom s := by
    intro W' g' eq' X s
    apply (hex X _).1
    have := congrArg (fun f => (f.hom.app X).hom s) eq'
    exact this
  choose lf hlf using hpt
  let L : ∀ (W' : Sheaf ((Scheme.ProEt.topology S).over B) AddCommGrpCat.{u+1})
      (g' : W' ⟶ R.over B), g' ≫ Φ = 0 → (W' ⟶ ρ.obj (Subobject.underlying.obj M)) :=
    fun W' g' eq' => ObjectProperty.homMk
      { app := fun X => AddCommGrpCat.ofHom (AddMonoidHom.mk' (lf W' g' eq' X) (by
            intro s t
            apply hinj X
            refine (hlf W' g' eq' X (s + t)).trans ((map_add _ s t).trans ?_)
            rw [← hlf W' g' eq' X s, ← hlf W' g' eq' X t]
            exact (map_add (ι.hom.app X).hom _ _).symm))
        naturality := by
          intro X X' f
          ext s
          apply hinj X'
          have e1 := congrArg (fun φ => φ.hom (lf W' g' eq' X s)) (ι.hom.naturality f)
          have e2 := congrArg (fun φ => φ.hom s) (g'.hom.naturality f)
          change (ι.hom.app X').hom (lf W' g' eq' X' ((W'.obj.map f).hom s)) =
            (ι.hom.app X').hom (((ρ.obj (Subobject.underlying.obj M)).obj.map f).hom
              (lf W' g' eq' X s))
          rw [hlf]
          refine Eq.trans ?_ e1.symm
          change (g'.hom.app X').hom ((W'.obj.map f).hom s) =
            ((R.over B).obj.map f).hom ((ι.hom.app X).hom (lf W' g' eq' X s))
          rw [hlf]
          exact e2 }
  have hlim : Limits.IsLimit (Limits.KernelFork.ofι ι hw) := by
    refine Limits.KernelFork.IsLimit.ofι ι hw (fun {W'} g' eq' => L W' g' eq') ?_ ?_
    · intro W' g' eq'
      apply hext
      intro X s
      exact hlf W' g' eq' X s
    · intro W' g' eq' m hm
      apply hext
      intro X s
      apply hinj X
      have := congrArg (fun φ => (φ.hom.app X).hom s) hm
      exact this.trans (hlf W' g' eq' X s).symm
  haveI := hepi
  exact ⟨(Limits.CokernelCofork.mapIsColimit _ (Limits.cokernelIsCokernel M.arrow) ρ).coconePointUniqueUpToIso
    (Abelian.epiIsCokernelOfKernel _ hlim)⟩

theorem wc_honest_theta_coker_GC (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (H : wcHonestPL D ℓ hP) (U : Submodule ℚ_[ℓ] (Fin H.N → ℚ_[ℓ]))
    (hUr : ∀ γ : H.W ⟶ H.W, γ ≫ H.w = H.w → ∀ x, H.fr γ x - x ∈ U)
    (hUtw : ∀ (V : (wcP1Over F'').left.ProEt) (h₁ h₂ : V ⟶ H.W)
      (x : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)),
      (∀ z : V.left, wcContEval (wcP1Over F'').left V
        ((H.θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x) z ∈ U) →
      ∀ z : V.left, wcContEval (wcP1Over F'').left V
        ((H.θ.hom.hom.app (Opposite.op (Over.mk h₂))).hom x) z ∈ U)
    (hUS : ∀ (i : Fin D.m) (x : Fin H.N → ℚ_[ℓ]), ∃ u ∈ U, H.lam i (x - u) = 0)
    (M : Subobject (wcRq D.f ℓ (n - 1)))
    (hM : ∀ (T : (wcP1Over F'').left.ProEt) (x : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op T)),
      (∃ x' : (Subobject.underlying.obj M).obj.obj (Opposite.op T),
        (M.arrow.hom.app (Opposite.op T)).hom x' = x) ↔
      wcThetaCond (wcP1Over F'').left ℓ (wcRq D.f ℓ (n - 1)) H.W H.N H.θ U T x) :
    wcPencilGC F'' hP ℓ (Limits.cokernel M.arrow) :=
by
  classical

  obtain ⟨b, hb⟩ : ∃ b, Module.finrank ℚ_[ℓ] ((Fin H.N → ℚ_[ℓ]) ⧸ U) = b := ⟨_, rfl⟩
  let e : ((Fin H.N → ℚ_[ℓ]) ⧸ U) ≃ₗ[ℚ_[ℓ]] (Fin b → ℚ_[ℓ]) :=
    LinearEquiv.ofFinrankEq _ _ (by rw [hb, Module.finrank_fin_fun])
  let L₀ : (Fin H.N → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin b → ℚ_[ℓ]) := e.toLinearMap ∘ₗ U.mkQ
  have hL : LinearMap.ker L₀ = U := by
    show LinearMap.ker ((e : ((Fin H.N → ℚ_[ℓ]) ⧸ U) →ₗ[ℚ_[ℓ]] (Fin b → ℚ_[ℓ])) ∘ₗ U.mkQ) = U
    rw [LinearEquiv.ker_comp, Submodule.ker_mkQ]
  have hLs : Function.Surjective L₀ := by
    intro y
    obtain ⟨q, rfl⟩ := e.surjective y
    obtain ⟨v, rfl⟩ := Submodule.mkQ_surjective U q
    exact ⟨v, rfl⟩

  have hnat : ∀ (V V₁ : (wcP1Over F'').left.ProEt) (k : V₁ ⟶ V) (h : V ⟶ H.W)
      (x : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)) (z₁ : V₁.left),
      wcContEval (wcP1Over F'').left V₁ ((H.θ.hom.hom.app (Opposite.op (Over.mk (k ≫ h)))).hom
        (((wcRq D.f ℓ (n - 1)).obj.map k.op).hom x)) z₁ =
      wcContEval (wcP1Over F'').left V
        ((H.θ.hom.hom.app (Opposite.op (Over.mk h))).hom x) (k.left z₁) := by
    intro V V₁ k h x z₁
    have h1 := congrArg (fun f => AddCommGrpCat.Hom.hom f x)
      (H.θ.hom.hom.naturality (Over.homMk k rfl : Over.mk (k ≫ h) ⟶ Over.mk h).op)
    exact congrArg (fun f => wcContEval (wcP1Over F'').left V₁ f z₁) h1

  have hdeck : ∀ γ : H.W ⟶ H.W, γ ≫ H.w = H.w → ∀ (V : (wcP1Over F'').left.ProEt)
      (a c : V ⟶ H.W), c = a ≫ γ → ∀ (x : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V))
      (z : V.left),
      wcContEval (wcP1Over F'').left V ((H.θ.hom.hom.app (Opposite.op (Over.mk c))).hom x) z =
        H.fr γ (wcContEval (wcP1Over F'').left V
          ((H.θ.hom.hom.app (Opposite.op (Over.mk a))).hom x) z) := by
    intro γ hγ
    obtain ⟨A, hA⟩ := wc_proet_deck_frame_linear (wcP1Over F'').left ℓ (wcRq D.f ℓ (n - 1))
      H.W H.hconn H.N H.θ γ
    have hAfr : A = H.fr γ := by
      apply LinearMap.ext
      intro y
      haveI := H.hconn
      obtain ⟨z₀⟩ := (inferInstance : Nonempty ↥H.W.left)
      let c : (wcContSheaf (wcP1Over F'').left (Fin H.N → ℚ_[ℓ])).obj.obj (Opposite.op H.W) :=
        ULift.up (ContinuousMap.const _ y)
      let s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op H.W) :=
        (H.θ.inv.hom.app (Opposite.op (Over.mk (𝟙 H.W)))).hom c
      have hs : (H.θ.hom.hom.app (Opposite.op (Over.mk (𝟙 H.W)))).hom s = c :=
        congrArg (fun f => AddCommGrpCat.Hom.hom (f.hom.app (Opposite.op (Over.mk (𝟙 H.W)))) c)
          H.θ.inv_hom_id
      have h1 := hA H.W (𝟙 H.W) γ (Category.id_comp γ).symm s z₀
      have h2 := H.hfr γ hγ s z₀
      have h3 : (show C(↥H.W.left, Fin H.N → ℚ_[ℓ]) from
          ((H.θ.hom.hom.app (Opposite.op (Over.mk (𝟙 H.W)))).hom s).down) z₀ = y := by
        rw [hs]; rfl
      rw [h3] at h1 h2
      exact h1.symm.trans h2
    intro V a c hc x z
    have := hA V a c hc x z
    rw [hAfr] at this
    exact this

  let φ : (wcRq D.f ℓ (n - 1)).over H.W ⟶
      (wcContSheaf (wcP1Over F'').left (Fin b → ℚ_[ℓ])).over H.W :=
    H.θ.hom ≫ ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1}
      H.W).map (wcContSheafMap (wcP1Over F'').left L₀.toAddMonoidHom
        (LinearMap.continuous_of_finiteDimensional L₀))
  have hφ : ∀ (V : (wcP1Over F'').left.ProEt) (h' : V ⟶ H.W)
      (x : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)) (z : V.left),
      wcContEval (wcP1Over F'').left V ((φ.hom.app (Opposite.op (Over.mk h'))).hom x) z =
        L₀ (wcContEval (wcP1Over F'').left V
          ((H.θ.hom.hom.app (Opposite.op (Over.mk h'))).hom x) z) := by
    intro V h' x z
    rfl

  have hinv : ∀ (V : (wcP1Over F'').left.ProEt) (h₁ h₂ : V ⟶ H.W), h₁ ≫ H.w = h₂ ≫ H.w →
      ∀ x : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V),
        (φ.hom.app (Opposite.op (Over.mk h₁))).hom x =
          (φ.hom.app (Opposite.op (Over.mk h₂))).hom x := by
    intro V h₁ h₂ hc x
    have key : ∀ z : V.left,
        wcContEval (wcP1Over F'').left V ((φ.hom.app (Opposite.op (Over.mk h₁))).hom x) z =
        wcContEval (wcP1Over F'').left V ((φ.hom.app (Opposite.op (Over.mk h₂))).hom x) z := by
      intro z
      rw [hφ, hφ]
      obtain ⟨V₁, k, z₁, hV₁, rfl⟩ := wc_proet_connected_nbhd (wcP1Over F'').left V z
      obtain ⟨γ, hγ, hbγ⟩ := H.hgal V₁ (k ≫ h₁) (k ≫ h₂) hV₁
        (by rw [Category.assoc, Category.assoc, hc])
      rw [← hnat V V₁ k h₁ x z₁, ← hnat V V₁ k h₂ x z₁,
        hdeck γ hγ V₁ (k ≫ h₁) (k ≫ h₂) hbγ]
      symm
      rw [← sub_eq_zero, ← map_sub, ← LinearMap.mem_ker, hL]
      exact hUr γ hγ _
    apply ULift.ext
    apply ContinuousMap.ext
    intro z
    exact key z

  obtain ⟨Φ, hΦ⟩ := wc_proet_descend_hom_offS F'' hP ℓ D.m D.S D.hS (wcRq D.f ℓ (n - 1))
    H.W H.w H.hqc H.hcov b φ hinv
  have hΦ' : ∀ (V : (wcP1Over F'').left.ProEt) (h' : V ⟶ H.W)
      (x : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)) (z : V.left),
      wcContEval (wcP1Over F'').left V
          ((Φ.hom.app (Opposite.op (Over.mk (h' ≫ H.w)))).hom x) z =
        L₀ (wcContEval (wcP1Over F'').left V
          ((H.θ.hom.hom.app (Opposite.op (Over.mk h'))).hom x) z) := by
    intro V h' x z
    rw [hΦ V h' x]
    exact hφ V h' x z

  have hker := wc_proet_descended_ker_eq_theta F'' hP ℓ D.m D.S D.hS (wcRq D.f ℓ (n - 1))
    H.W H.w H.hqc H.hcov H.N H.θ U b L₀ hL hUtw M hM Φ hΦ'

  have hepi := wc_honest_descended_epi F' F'' Y n hn hn2 D ℓ hℓ hP H U hUr hUS b L₀ hL hLs Φ hΦ'

  obtain ⟨iso⟩ := wc_proet_over_coker_iso_of_epi_ker (wcP1Over F'').left ℓ
    (wcGeomPoint F'' (wcP1Over F'') hP) (wcRq D.f ℓ (n - 1)) M b Φ hepi hker
  exact ⟨b, ⟨iso⟩⟩

theorem wc_pencil_E_datum_of_honest (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (H : wcHonestPL D ℓ hP) (hstar : wcHonestEhon H ≤ wcHonestMov H) :
    ∃ (r : ℕ) (θ : (Subobject.underlying.obj (wcPencilE D ℓ hP)).over H.W ≅
        (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over H.W)
      (gE : (H.W ⟶ H.W) → ((Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]))),
      (∀ γ : H.W ⟶ H.W, γ ≫ H.w = H.w →
        ∀ (s : (Subobject.underlying.obj (wcPencilE D ℓ hP)).obj.obj (Opposite.op H.W))
          (z : H.W.left),
          (show C(↥H.W.left, Fin r → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z =
          gE γ ((show C(↥H.W.left, Fin r → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 H.W)))).hom s).down) z)) ∧
      Submodule.span ℚ_[ℓ] (⋃ γ : {γ : H.W ⟶ H.W // γ ≫ H.w = H.w},
        Set.range ⇑((gE γ.1 - LinearMap.id : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])))) = ⊤ :=
by
  classical

  have hRgstab : ∀ γ : H.W ⟶ H.W, γ ≫ H.w = H.w → ∀ v ∈ wcHonestRg H, H.fr γ v ∈ wcHonestRg H := by
    intro γ hγ v hv
    unfold wcHonestRg at hv ⊢
    induction hv using Submodule.span_induction with
    | mem v hv =>
      obtain ⟨γ', u, hγ', rfl⟩ := hv
      have e : H.fr γ (H.fr γ' u - u) = (H.fr (γ' ≫ γ) u - u) - (H.fr γ u - u) := by
        rw [H.hcomp γ' γ hγ' hγ, LinearMap.comp_apply, map_sub]
        abel
      rw [e]
      exact sub_mem
        (Submodule.subset_span ⟨γ' ≫ γ, u, by rw [Category.assoc, hγ, hγ'], rfl⟩)
        (Submodule.subset_span ⟨γ, u, hγ, rfl⟩)
    | zero => simp
    | add x y _ _ hx hy =>
      rw [map_add]
      exact add_mem hx hy
    | smul a x _ hx =>
      rw [map_smul]
      exact Submodule.smul_mem _ a hx

  have hRgE : wcHonestRg H ≤ wcHonestEhon H := by
    unfold wcHonestRg
    rw [Submodule.span_le]
    rintro v ⟨γ, u, hγ, rfl⟩
    exact H.hrange γ hγ u

  have hMovRg : wcHonestMov H ≤ wcHonestRg H := by
    unfold wcHonestMov wcHonestRg
    apply Submodule.span_mono
    rintro v ⟨γ, u, hγ, -, rfl⟩
    exact ⟨γ, u, hγ, rfl⟩
  have hERg : wcHonestEhon H ≤ wcHonestRg H := hstar.trans hMovRg

  have hUr : ∀ γ : H.W ⟶ H.W, γ ≫ H.w = H.w → ∀ x, H.fr γ x - x ∈ wcHonestRg H := by
    intro γ hγ x
    unfold wcHonestRg
    exact Submodule.subset_span ⟨γ, x, hγ, rfl⟩

  have hUS : ∀ (i : Fin D.m) (x : Fin H.N → ℚ_[ℓ]), ∃ u ∈ wcHonestRg H, H.lam i (x - u) = 0 := by
    intro i x
    by_cases hli : H.lam i = 0
    · exact ⟨0, zero_mem _, by rw [hli]; rfl⟩
    · have hdi : H.d i ≠ 0 := fun h => hli ((H.hdz i).mp h)
      have hdiE : H.d i ∈ wcHonestEhon H := by
        unfold wcHonestEhon
        exact Submodule.subset_span ⟨𝟙 H.W, i, Category.id_comp _, by rw [H.hfr1]; rfl⟩
      have hex : ∃ u₁ ∈ wcHonestRg H, H.lam i u₁ ≠ 0 := by
        by_contra hcon
        push_neg at hcon
        have hfix := H.hgen (wcHonestRg H) (fun γ i' hγ u hu => by
          obtain ⟨γ', c, hγ', hc, -, hlam⟩ := H.hconj i' i
          have h1 : H.lam i (H.fr γ' (H.fr γ u)) = 0 :=
            hcon _ (hRgstab γ' hγ' _ (hRgstab γ hγ u hu))
          rw [hlam] at h1
          exact (mul_eq_zero.mp h1).resolve_left (inv_ne_zero hc))
        have hMov0 : wcHonestMov H ≤ ⊥ := by
          unfold wcHonestMov
          rw [Submodule.span_le]
          rintro v ⟨γ, u, hγ, hu, rfl⟩
          rw [hfix γ hγ u (hERg hu), sub_self]
          exact zero_mem _
        have h0 := hMov0 (hstar hdiE)
        exact hdi ((Submodule.mem_bot ℚ_[ℓ]).mp h0)
      obtain ⟨u₁, hu₁, hl₁⟩ := hex
      refine ⟨(H.lam i x / H.lam i u₁) • u₁, Submodule.smul_mem _ _ hu₁, ?_⟩
      rw [map_sub, map_smul, smul_eq_mul, div_mul_cancel₀ _ hl₁, sub_self]

  obtain ⟨M, hM, hUniv⟩ := wc_proet_theta_subsheaf (wcP1Over F'').left ℓ (wcRq D.f ℓ (n - 1))
    H.W H.N H.θ (wcHonestRg H)

  have htw := wc_honest_Rg_twist_stable F' F'' Y n D ℓ hP H

  have hstable : wcPencilStable D ℓ M := by
    intro c
    refine hUniv _ (M.arrow ≫ wcRqScalar D.f ℓ (n - 1) c) ?_
    intro T x V h h' z
    have hy := (hM T ((M.arrow.hom.app (Opposite.op T)).hom x)).mp ⟨x, rfl⟩ V h h' z
    have e1 : ((wcRq D.f ℓ (n - 1)).obj.map h.op).hom
        (((M.arrow ≫ wcRqScalar D.f ℓ (n - 1) c).hom.app (Opposite.op T)).hom x) =
        ((wcRqScalar D.f ℓ (n - 1) c).hom.app (Opposite.op V)).hom
          (((wcRq D.f ℓ (n - 1)).obj.map h.op).hom ((M.arrow.hom.app (Opposite.op T)).hom x)) :=
      (congrArg (fun f => AddCommGrpCat.Hom.hom f ((M.arrow.hom.app (Opposite.op T)).hom x))
        ((wcRqScalar D.f ℓ (n - 1) c).hom.naturality h.op)).symm
    have e2 := congrArg (fun f => AddCommGrpCat.Hom.hom (f.hom.app (Opposite.op (Over.mk h')))
        (((wcRq D.f ℓ (n - 1)).obj.map h.op).hom ((M.arrow.hom.app (Opposite.op T)).hom x)))
        (H.hθc c)
    have e3 : wcContEval (wcP1Over F'').left V ((H.θ.hom.hom.app (Opposite.op (Over.mk h'))).hom
        (((wcRq D.f ℓ (n - 1)).obj.map h.op).hom
          (((M.arrow ≫ wcRqScalar D.f ℓ (n - 1) c).hom.app (Opposite.op T)).hom x))) z =
        c • wcContEval (wcP1Over F'').left V ((H.θ.hom.hom.app (Opposite.op (Over.mk h'))).hom
          (((wcRq D.f ℓ (n - 1)).obj.map h.op).hom ((M.arrow.hom.app (Opposite.op T)).hom x))) z := by
      rw [e1]
      exact congrArg (fun f => wcContEval (wcP1Over F'').left V f z) e2
    have hc := Submodule.smul_mem (wcHonestRg H) c hy
    rw [← e3] at hc
    exact hc

  have hGC := wc_honest_theta_coker_GC F' F'' Y n hn hn2 D ℓ hℓ hP H (wcHonestRg H) hUr htw hUS M hM
  have hle : ∀ M' : Subobject (wcRq D.f ℓ (n - 1)),
      wcPencilGC F'' hP ℓ (Limits.cokernel M'.arrow) → M ≤ M' := fun M' hM' =>
    wc_honest_theta_le_of_coker_GC F' F'' Y n hn hn2 D ℓ hℓ hP H (wcHonestRg H) le_rfl M hM M' hM'

  have hEM : wcPencilE D ℓ hP = M := by
    have h : ∃ M₀ : Subobject (wcRq D.f ℓ (n - 1)), wcPencilStable D ℓ M₀ ∧
        wcPencilGC F'' hP ℓ (Limits.cokernel M₀.arrow) ∧
        ∀ M' : Subobject (wcRq D.f ℓ (n - 1)), wcPencilStable D ℓ M' →
          wcPencilGC F'' hP ℓ (Limits.cokernel M'.arrow) → M₀ ≤ M' :=
      ⟨M, hstable, hGC, fun M' _ hM' => hle M' hM'⟩
    unfold wcPencilE
    rw [dif_pos h]
    obtain ⟨_, hg, hl⟩ := Classical.choose_spec h
    exact le_antisymm (hl M hstable hGC) (hle _ hg)

  obtain ⟨r, hr⟩ : ∃ r, Module.finrank ℚ_[ℓ] (wcHonestRg H) = r := ⟨_, rfl⟩
  let e : (Fin r → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] wcHonestRg H :=
    LinearEquiv.ofFinrankEq (Fin r → ℚ_[ℓ]) (wcHonestRg H) (by rw [Module.finrank_fin_fun, hr])
  let b : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin H.N → ℚ_[ℓ]) := (wcHonestRg H).subtype ∘ₗ e.toLinearMap
  have hb : Function.Injective b := Subtype.val_injective.comp e.injective
  have hbU : LinearMap.range b = wcHonestRg H := by
    ext v
    constructor
    · rintro ⟨w, rfl⟩
      exact (e w).2
    · intro hv
      exact ⟨e.symm ⟨v, hv⟩, by simp [b]⟩
  have hbmem : ∀ v, b v ∈ wcHonestRg H := fun v => by
    rw [← hbU]
    exact LinearMap.mem_range_self b v
  obtain ⟨P, hPl⟩ := LinearMap.exists_leftInverse_of_injective b (LinearMap.ker_eq_bot.mpr hb)
  have hPb : ∀ v, P (b v) = v := fun v => LinearMap.congr_fun hPl v
  have hbP : ∀ y ∈ wcHonestRg H, b (P y) = y := by
    intro y hy
    rw [← hbU] at hy
    obtain ⟨w, rfl⟩ := hy
    rw [hPb]

  obtain ⟨θ'', hθ''⟩ := wc_proet_theta_sub_over_triv (wcP1Over F'').left ℓ (wcRq D.f ℓ (n - 1))
    H.W H.N H.θ (wcHonestRg H) htw M hM r b hb hbU
  subst hEM

  refine ⟨r, θ'', fun γ => P ∘ₗ H.fr γ ∘ₗ b, ?_, ?_⟩
  · intro γ hγ s z
    apply hb
    have h1 := hθ'' (Over.mk γ) s z
    have h2 := hθ'' (Over.mk (𝟙 H.W)) s z
    have h3 := H.hfr γ hγ (((wcPencilE D ℓ hP).arrow.hom.app (Opposite.op H.W)).hom s) z
    have hm := hRgstab γ hγ _ (hbmem (wcContEval (wcP1Over F'').left (Over.mk (𝟙 H.W)).left
      ((θ''.hom.hom.app (Opposite.op (Over.mk (𝟙 H.W)))).hom s) z))
    exact (h1.trans (h3.trans (congrArg (H.fr γ) h2.symm))).trans (hbP _ hm).symm
  · rw [eq_top_iff]
    intro u _
    have hspan : wcHonestRg H ≤ Submodule.span ℚ_[ℓ] {v | ∃ (γ : H.W ⟶ H.W)
        (w : Fin H.N → ℚ_[ℓ]), γ ≫ H.w = H.w ∧ w ∈ wcHonestRg H ∧ H.fr γ w - w = v} := by
      refine hRgE.trans (hstar.trans ?_)
      unfold wcHonestMov
      apply Submodule.span_mono
      rintro v ⟨γ, w, hγ, hw, rfl⟩
      exact ⟨γ, w, hγ, hERg hw, rfl⟩
    have h1 : P (b u) ∈ Submodule.map P (Submodule.span ℚ_[ℓ] {v | ∃ (γ : H.W ⟶ H.W)
        (w : Fin H.N → ℚ_[ℓ]), γ ≫ H.w = H.w ∧ w ∈ wcHonestRg H ∧ H.fr γ w - w = v}) :=
      Submodule.mem_map_of_mem (hspan (hbmem u))
    rw [hPb, Submodule.map_span] at h1
    refine Submodule.span_mono ?_ h1
    rintro _ ⟨v, ⟨γ, w, hγ, hw, rfl⟩, rfl⟩
    rw [← hbU] at hw
    obtain ⟨w', rfl⟩ := hw
    refine Set.mem_iUnion.mpr ⟨⟨γ, hγ⟩, w', ?_⟩
    show ((P ∘ₗ H.fr γ ∘ₗ b - LinearMap.id : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]))) w' =
      P (H.fr γ (b w') - b w')
    rw [LinearMap.sub_apply, map_sub, hPb]
    rfl

theorem wc_pencil_E_coinv_datum_of_conj (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (π : wcPencilPL D ℓ hP) (hπ : wcPencilConj π)
    (hNI : ∃ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β ∧
      β ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n)) :
    ∃ (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (r : ℕ)
      (θ : (Subobject.underlying.obj (wcPencilE D ℓ hP)).over W ≅
        (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W)
      (k : ℕ) (γ : Fin k → (W ⟶ W))
      (g : Fin k → ((Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]))),
      QuasiCompact w.left ∧ ConnectedSpace W.left ∧
      (∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left,
        (∀ i : Fin D.m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠
          D.S i (IsLocalRing.closedPoint F'')) →
        ∃ z : W.left, w.left z = p) ∧
      (∀ j, γ j ≫ w = w) ∧
      (∀ (j : Fin k) (s : (Subobject.underlying.obj (wcPencilE D ℓ hP)).obj.obj (Opposite.op W))
          (z : W.left),
        (show C(↥W.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk (γ j)))).hom s).down) z =
        g j ((show C(↥W.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z)) ∧
      Submodule.span ℚ_[ℓ] (⋃ j, Set.range ⇑((g j - LinearMap.id :
        (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])))) = ⊤ :=
by
  classical

  obtain ⟨W₀, w₀, N₀, θ₀, hqc₀, hconn₀, hcov₀, hgal₀⟩ :=
    wc_pencil_Rq_sub_galois_trivialization F' F'' Y n hn2 D ℓ hℓ hP (n - 1) ⊤
      (Or.inr (Limits.isZero_cokernel_of_epi _))

  obtain ⟨H⟩ := wc_pencil_honest_PL_of_conj F' F'' Y n hn hn2 D ℓ hℓ hP π hπ W₀ w₀ N₀ θ₀
    hqc₀ hconn₀ hcov₀ hgal₀
  by_cases hA : ∀ γ : H.W ⟶ H.W, γ ≫ H.w = H.w → ∀ u ∈ wcHonestEhon H, H.fr γ u = u
  ·
    exfalso
    obtain ⟨β, hβ, hne⟩ := hNI
    exact hne (wc_pencil_VQ_weight_of_honest_fixed F' F'' Y n hn hn2 D ℓ hℓ hP H hA β hβ)
  ·
    have hstab : ∀ γ : H.W ⟶ H.W, γ ≫ H.w = H.w →
        ∀ u ∈ wcHonestEhon H, H.fr γ u ∈ wcHonestEhon H := by
      intro γ hγ u hu
      unfold wcHonestEhon at hu ⊢
      induction hu using Submodule.span_induction with
      | mem v hv =>
        obtain ⟨γ', i, hγ', rfl⟩ := hv
        apply Submodule.subset_span
        refine ⟨γ' ≫ γ, i, ?_, ?_⟩
        · rw [Category.assoc, hγ, hγ']
        · rw [H.hcomp γ' γ hγ' hγ]
          rfl
      | zero => simp
      | add x y _ _ hx hy =>
        rw [map_add]
        exact add_mem hx hy
      | smul a x _ hx =>
        rw [map_smul]
        exact Submodule.smul_mem _ a hx
    have hMstab : ∀ γ : H.W ⟶ H.W, γ ≫ H.w = H.w →
        ∀ v ∈ wcHonestMov H, H.fr γ v ∈ wcHonestMov H := by
      intro γ hγ v hv
      unfold wcHonestMov at hv ⊢
      induction hv using Submodule.span_induction with
      | mem v hv =>
        obtain ⟨γ', u, hγ', hu, rfl⟩ := hv
        have e : H.fr γ (H.fr γ' u - u) = (H.fr (γ' ≫ γ) u - u) - (H.fr γ u - u) := by
          rw [H.hcomp γ' γ hγ' hγ, LinearMap.comp_apply, map_sub]
          abel
        rw [e]
        exact sub_mem
          (Submodule.subset_span ⟨γ' ≫ γ, u, by rw [Category.assoc, hγ, hγ'], hu, rfl⟩)
          (Submodule.subset_span ⟨γ, u, hγ, hu, rfl⟩)
      | zero => simp
      | add x y _ _ hx hy =>
        rw [map_add]
        exact add_mem hx hy
      | smul a x _ hx =>
        rw [map_smul]
        exact Submodule.smul_mem _ a hx
    have hex : ∃ (i0 : Fin D.m) (u1 : Fin H.N → ℚ_[ℓ]),
        u1 ∈ wcHonestEhon H ∧ H.lam i0 u1 ≠ 0 := by
      by_contra hcon
      push_neg at hcon
      exact hA (H.hgen (wcHonestEhon H) (fun γ i hγ u hu => hcon i _ (hstab γ hγ u hu)))
    obtain ⟨i0, u1, hu1, hlam1⟩ := hex
    have hd : ∀ i, H.d i ∈ wcHonestMov H := by
      intro i
      obtain ⟨γ2, c, hγ2, hc, -, hlam2⟩ := H.hconj i0 i
      have hu2 : H.fr γ2 u1 ∈ wcHonestEhon H := hstab γ2 hγ2 u1 hu1
      have hl2 : H.lam i (H.fr γ2 u1) ≠ 0 := by
        rw [hlam2]
        exact mul_ne_zero (inv_ne_zero hc) hlam1
      obtain ⟨γ3, hγ3, htv3⟩ := H.htv i
      have hmem : H.fr γ3 (H.fr γ2 u1) - H.fr γ2 u1 ∈ wcHonestMov H :=
        Submodule.subset_span ⟨γ3, H.fr γ2 u1, hγ3, hu2, rfl⟩
      have e : H.d i = (H.lam i (H.fr γ2 u1))⁻¹ •
          (H.fr γ3 (H.fr γ2 u1) - H.fr γ2 u1) := by
        rw [htv3, add_sub_cancel_left, smul_smul, inv_mul_cancel₀ hl2, one_smul]
      rw [e]
      exact Submodule.smul_mem _ _ hmem
    have hstar : wcHonestEhon H ≤ wcHonestMov H := by
      unfold wcHonestEhon
      rw [Submodule.span_le]
      rintro v ⟨γ, i, hγ, rfl⟩
      exact hMstab γ hγ _ (hd i)

    obtain ⟨r, θ, gE, hθ, hspan⟩ :=
      wc_pencil_E_datum_of_honest F' F'' Y n hn hn2 D ℓ hℓ hP H hstar

    have hcpt : IsCompactElement (⊤ : Submodule ℚ_[ℓ] (Fin r → ℚ_[ℓ])) :=
      (Submodule.fg_iff_compact ⊤).mp Module.Finite.fg_top
    obtain ⟨s, hs⟩ := IsCompactElement.exists_finset_of_le_iSup hcpt
      (fun γ : {γ : H.W ⟶ H.W // γ ≫ H.w = H.w} =>
        Submodule.span ℚ_[ℓ] (Set.range ⇑((gE γ.1 - LinearMap.id :
          (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])))))
      (by rw [← Submodule.span_iUnion, hspan])
    refine ⟨H.W, H.w, r, θ, s.card, fun j => (s.equivFin.symm j).1.1,
      fun j => gE (s.equivFin.symm j).1.1, H.hqc, H.hconn, H.hcov,
      fun j => (s.equivFin.symm j).1.2, fun j => hθ _ (s.equivFin.symm j).1.2, ?_⟩
    refine top_unique (hs.trans ?_)
    refine iSup₂_le fun γ hγs => ?_
    refine Submodule.span_mono ?_
    intro x hx
    refine Set.mem_iUnion.mpr ⟨s.equivFin ⟨γ, hγs⟩, ?_⟩
    simpa using hx

theorem wc_proet_over_hom_kill_of_coinv (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (B W : S.ProEt) (w : W ⟶ B)
    (hW : ConnectedSpace W.left) (r b k : ℕ)
    (θ : G.over W ≅ (wcContSheaf S (Fin r → ℚ_[ℓ])).over W)
    (γ : Fin k → (W ⟶ W)) (hγ : ∀ j, γ j ≫ w = w)
    (g : Fin k → ((Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])))
    (hθ : ∀ (j : Fin k) (s : G.obj.obj (Opposite.op W)) (z : W.left),
      (show C(↥W.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk (γ j)))).hom s).down) z =
      g j ((show C(↥W.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z))
    (hspan : Submodule.span ℚ_[ℓ] (⋃ j, Set.range ⇑((g j - LinearMap.id :
        (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])))) = ⊤)
    (φ : G.over B ⟶ (wcContSheaf S (Fin b → ℚ_[ℓ])).over B) :
    ∀ (V : S.ProEt) (h' : V ⟶ W) (s : G.obj.obj (Opposite.op V)),
      (φ.hom.app (Opposite.op (Over.mk (h' ≫ w)))).hom s = 0 :=
by
  classical
  haveI := hW

  let φW : G.over W ⟶ (wcContSheaf S (Fin b → ℚ_[ℓ])).over W :=
    ⟨{ app := fun T => φ.hom.app (Opposite.op (Over.mk (T.unop.hom ≫ w)))
       naturality := fun X Y f => φ.hom.naturality
          (Over.homMk f.unop.left (by
            show f.unop.left ≫ X.unop.hom ≫ w = Y.unop.hom ≫ w
            rw [← Category.assoc, Over.w f.unop]) :
            Over.mk (Y.unop.hom ≫ w) ⟶ Over.mk (X.unop.hom ≫ w)).op }⟩
  have hres : ∀ (f : W ⟶ W) (u : W ⟶ B), f ≫ w = u → ∀ s : G.obj.obj (Opposite.op W),
      (φW.hom.app (Opposite.op (Over.mk f))).hom s = (φ.hom.app (Opposite.op (Over.mk u))).hom s := by
    rintro f u rfl s
    rfl

  have hcancel1 : ∀ (T : Over W) (s : (G.over W).obj.obj (Opposite.op T)),
      (θ.inv.hom.app (Opposite.op T)).hom ((θ.hom.hom.app (Opposite.op T)).hom s) = s := by
    intro T s
    exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom s) θ.hom_inv_id
  have hcancel2 : ∀ (T : Over W)
      (c : ((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.obj (Opposite.op T)),
      (θ.hom.hom.app (Opposite.op T)).hom ((θ.inv.hom.app (Opposite.op T)).hom c) = c := by
    intro T c
    exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom c) θ.inv_hom_id

  obtain ⟨A, hA⟩ := wc_contSheaf_over_hom_linear S ℓ W hW r b (θ.inv ≫ φW)
  have hP : ∀ (T : Over W) (c : (wcContSheaf S (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op T.left))
      (t : T.left.left),
      (show C(↥T.left.left, Fin b → ℚ_[ℓ]) from
        (((θ.inv ≫ φW).hom.app (Opposite.op T)).hom c).down) t =
        A ((show C(↥T.left.left, Fin r → ℚ_[ℓ]) from c.down) t) := by
    intro T c t
    rw [hA]
    rfl

  have hkey : ∀ (f : W ⟶ W), f ≫ w = w → ∀ (s : G.obj.obj (Opposite.op W)) (z : W.left),
      A ((show C(↥W.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk f))).hom s).down) z) =
      (show C(↥W.left, Fin b → ℚ_[ℓ]) from
        ((φ.hom.app (Opposite.op (Over.mk w))).hom s).down) z := by
    intro f hf s z
    have e1 : ((θ.inv ≫ φW).hom.app (Opposite.op (Over.mk f))).hom
        ((θ.hom.hom.app (Opposite.op (Over.mk f))).hom s) =
        (φW.hom.app (Opposite.op (Over.mk f))).hom s :=
      congrArg (φW.hom.app (Opposite.op (Over.mk f))).hom (hcancel1 (Over.mk f) s)
    have E := e1.trans (hres f w hf s)
    have h1 := hP (Over.mk f) ((θ.hom.hom.app (Opposite.op (Over.mk f))).hom s) z
    have h4 := congrArg (fun y : ULift.{u+1} C(↥W.left, Fin b → ℚ_[ℓ]) => y.down z) E
    exact h1.symm.trans h4

  obtain ⟨z₀⟩ : Nonempty W.left := ConnectedSpace.toNonempty
  have hinv : ∀ (j : Fin k) (v : Fin r → ℚ_[ℓ]), A (g j v) = A v := by
    intro j v
    let c : (wcContSheaf S (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op W) :=
      (show (wcContSheaf S (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op W) from
        ULift.up (ContinuousMap.const ↥W.left v))
    let s : G.obj.obj (Opposite.op W) := (θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom c
    have hs : (θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s = c :=
      hcancel2 (Over.mk (𝟙 W)) c
    have hv : (show C(↥W.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z₀ = v :=
      congrArg (fun y : ULift.{u+1} C(↥W.left, Fin r → ℚ_[ℓ]) => y.down z₀) hs
    have k1 := hkey (γ j) (hγ j) s z₀
    have k2 := hkey (𝟙 W) (Category.id_comp w) s z₀
    rw [hθ j s z₀, hv] at k1
    rw [hv] at k2
    exact k1.trans k2.symm

  have hA0 : A = 0 := by
    rw [← LinearMap.ker_eq_top, eq_top_iff, ← hspan, Submodule.span_le]
    intro x hx
    obtain ⟨j, hj⟩ := Set.mem_iUnion.mp hx
    obtain ⟨v, rfl⟩ := hj
    rw [SetLike.mem_coe, LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.id_apply, map_sub,
      hinv, sub_self]

  intro V h' s
  let T : Over W := Over.mk h'
  have e1 : ((θ.inv ≫ φW).hom.app (Opposite.op T)).hom ((θ.hom.hom.app (Opposite.op T)).hom s) =
      (φ.hom.app (Opposite.op (Over.mk (h' ≫ w)))).hom s :=
    congrArg (φW.hom.app (Opposite.op T)).hom (hcancel1 T s)
  refine e1.symm.trans ?_
  apply ULift.ext
  apply ContinuousMap.ext
  intro t
  have h1 := hP T ((θ.hom.hom.app (Opposite.op T)).hom s) t
  rw [hA0, LinearMap.zero_apply] at h1
  exact h1

theorem wc_pencil_no_mixed_of_conj (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n)
    (hC : ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (_hℓ : ¬ ℓ ∣ Nat.card F'')
      (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))),
      ∃ π : wcPencilPL D ℓ hP, wcPencilConj π) :
    wcPencilNoMixed D :=
by
  intro ℓ _ hℓ hP hNI φ
  classical
  obtain ⟨π, hπ⟩ := hC ℓ hℓ hP

  obtain ⟨W, w, r, θ, k, γ, g, hqc, hconn, hcov, hγ, hθ, hspan⟩ :=
    wc_pencil_E_coinv_datum_of_conj F' F'' Y n hn hn2 D ℓ hℓ hP π hπ hNI

  let ι₁ : ℚ_[ℓ] →+ (Fin 1 → ℚ_[ℓ]) :=
    { toFun := fun c _ => c, map_zero' := rfl, map_add' := fun _ _ => rfl }
  have hι₁ : Continuous ι₁ := by
    have h : Continuous (fun (c : ℚ_[ℓ]) (_ : Fin 1) => c) := continuous_pi fun _ => continuous_id
    exact h
  let e := wcContSheafMap (wcP1Over F'').left ι₁ hι₁
  have he_inj : ∀ (V : ((wcP1Over F'').left.ProEt)ᵒᵖ)
      (x : (wcContSheaf (wcP1Over F'').left ℚ_[ℓ]).obj.obj V),
      (e.hom.app V).hom x = 0 → x = 0 := by
    intro V x hx
    have h1 := congrArg
      (fun y : ULift.{u+1} C(↥(Opposite.unop V).left, Fin 1 → ℚ_[ℓ]) => y.down) hx
    have h2 : (show ULift.{u+1} C(↥(Opposite.unop V).left, ℚ_[ℓ]) from x) = 0 := by
      apply ULift.ext
      apply ContinuousMap.ext
      intro z
      have h3 := congrArg (fun f : C(↥(Opposite.unop V).left, Fin 1 → ℚ_[ℓ]) => f z 0) h1
      exact h3
    exact h2

  let φ' := φ ≫ ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1}
    (wcGeomPoint F'' (wcP1Over F'') hP)).map e
  have hkill := wc_proet_over_hom_kill_of_coinv (wcP1Over F'').left ℓ
    (Subobject.underlying.obj (wcPencilE D ℓ hP)) (wcGeomPoint F'' (wcP1Over F'') hP) W w hconn
    r 1 k θ γ hγ g hθ hspan φ'
  have hkill' : ∀ (V : (wcP1Over F'').left.ProEt) (kk : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
      (h' : V ⟶ W), h' ≫ w = kk →
      ∀ s : (Subobject.underlying.obj (wcPencilE D ℓ hP)).obj.obj (Opposite.op V),
        (φ.hom.app (Opposite.op (Over.mk kk))).hom s = 0 := by
    intro V kk h' hk s
    subst hk
    exact he_inj (Opposite.op V) ((φ.hom.app (Opposite.op (Over.mk (h' ≫ w)))).hom s)
      (hkill V h' s)

  apply Sheaf.hom_ext
  apply NatTrans.ext
  funext T
  apply AddCommGrpCat.hom_ext
  apply AddMonoidHom.ext
  intro s
  show (φ.hom.app T).hom s = 0

  have hΛ : ∀ (V : (wcP1Over F'').left.ProEt) (h : V ⟶ T.unop.left),
      (∀ (v : V.left) (i : Fin D.m), V.hom v ≠ D.S i (IsLocalRing.closedPoint F'')) →
      ((wcContSheaf (wcP1Over F'').left ℚ_[ℓ]).obj.map h.op).hom ((φ.hom.app T).hom s) = 0 := by
    refine wc_proet_detect_through_cover F'' hP D.m D.S W w hqc hcov
      (wcContSheaf (wcP1Over F'').left ℚ_[ℓ]) T.unop.left T.unop.hom ((φ.hom.app T).hom s) ?_
    intro V h h' hcomm
    have hnat := congrArg (fun f => AddCommGrpCat.Hom.hom f s)
      (φ.hom.naturality (Over.homMk h rfl : Over.mk (h ≫ T.unop.hom) ⟶ T.unop).op)
    have h0 := hkill' V (h ≫ T.unop.hom) h' hcomm
      (((Subobject.underlying.obj (wcPencilE D ℓ hP)).obj.map h.op).hom s)
    exact hnat.symm.trans h0

  have hy : (e.hom.app (Opposite.op T.unop.left)).hom ((φ.hom.app T).hom s) = 0 := by
    refine wc_P1_contSheaf_off_points_vanish F'' ℓ 1 D.m D.S D.hS T.unop.left
      ((e.hom.app (Opposite.op T.unop.left)).hom ((φ.hom.app T).hom s)) ?_
    intro V h hV
    have hnat := congrArg (fun f => AddCommGrpCat.Hom.hom f ((φ.hom.app T).hom s))
      (e.hom.naturality h.op)
    have hz := hΛ V h hV
    calc ((wcContSheaf (wcP1Over F'').left (Fin 1 → ℚ_[ℓ])).obj.map h.op).hom
          ((e.hom.app (Opposite.op T.unop.left)).hom ((φ.hom.app T).hom s))
        = (e.hom.app (Opposite.op V)).hom
            (((wcContSheaf (wcP1Over F'').left ℚ_[ℓ]).obj.map h.op).hom ((φ.hom.app T).hom s)) :=
          hnat.symm
      _ = (e.hom.app (Opposite.op V)).hom 0 := by rw [hz]
      _ = 0 := map_zero _
  exact he_inj (Opposite.op T.unop.left) ((φ.hom.app T).hom s) hy

theorem wc_lefschetz_datum_no_mixed_exists (F' : Type u) [Finite F'] [Field F']
    (Y : Over (Spec (.of F'))) [GeometricallyIrreducible Y.hom] [IsProper Y.hom] (n : ℕ)
    [SmoothOfRelativeDimension n Y.hom] (hn : Even n) (hn2 : 2 ≤ n)
    (N : ℕ) (j : Y.left ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
      MvPolynomial.gradedAlgebra)
    (hj : IsClosedImmersion j)
    (hjY : j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
      MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
        (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0))) = Y.hom) :
    ∃ (F'' : Type u) (_ : Field F'') (_ : Finite F'') (_ : Algebra F' F''),
      ∃ D : wcLefschetzDatum F' F'' Y n, wcPencilNoMixed D :=
by
  classical
  obtain ⟨F'', _, _, _, D, hF⟩ := wc_ldnm_family_datum_exists F' Y n hn hn2 N j hj hjY
  refine ⟨F'', inferInstance, inferInstance, inferInstance, D, ?_⟩
  apply wc_pencil_no_mixed_of_conj F' F'' Y n hn hn2 D
  intro ℓ _ hℓ hP
  obtain ⟨π⟩ := wc_pencil_PL_datum_exists F' F'' Y n hn hn2 D ℓ hℓ hP
  exact wc_pencil_conj_of_family F' F'' Y n hn hn2 D ℓ hℓ hP hF π

theorem wc_leray_col0_exact : ∀ {C : Type*} {D : Type*} [Category C] [Category D] [Abelian C]
    [Abelian D] [HasExt C] [HasExt D] [HasInjectiveResolutions C] (L : D ⥤ C) (R : C ⥤ D)
    [R.Additive] (adj : L ⊣ R) [Limits.PreservesFiniteLimits L] (P : D) (A : C)
    (I : InjectiveResolution A) {S : Type*} (s : S → (A ⟶ A)),
    (∀ j : ℕ, ∀ z : Abelian.Ext P
        (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).cycles j) 2,
      z.comp (Abelian.Ext.mk₀
        (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homologyπ j))
        (add_zero 2) = 0 → z = 0) →
    ∀ q : ℕ, ∃ (ε : Abelian.Ext (L.obj P) A q →+ Abelian.Ext P ((R.rightDerived q).obj A) 0)
      (δ : Abelian.Ext P ((R.rightDerived q).obj A) 0 →+
        Abelian.Ext P ((R.rightDerived (q - 1)).obj A) 2),
      (∀ (c : S) (x : Abelian.Ext (L.obj P) A q),
        ε ((Abelian.Ext.mk₀ (s c)).postcomp (L.obj P) (add_zero q) x) =
          (Abelian.Ext.mk₀ ((R.rightDerived q).map (s c))).postcomp P (add_zero 0) (ε x)) ∧
      (∀ (c : S) (y : Abelian.Ext P ((R.rightDerived q).obj A) 0),
        δ ((Abelian.Ext.mk₀ ((R.rightDerived q).map (s c))).postcomp P (add_zero 0) y) =
          (Abelian.Ext.mk₀ ((R.rightDerived (q - 1)).map (s c))).postcomp P (add_zero 2) (δ y)) ∧
      ∀ y : Abelian.Ext P ((R.rightDerived q).obj A) 0, δ y = 0 → ∃ x, ε x = y :=
by
  intro C D _ _ _ _ _ _ _ L R _ adj _ P A I S s hcyc q
  set K := (R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex with hK

  obtain ⟨lam, hlam⟩ : ∃ lam : S → (I.cocomplex ⟶ I.cocomplex),
      ∀ c, I.ι.f 0 ≫ (lam c).f 0 = s c ≫ I.ι.f 0 :=
    ⟨fun c => InjectiveResolution.desc (s c) I I,
      fun c => InjectiveResolution.desc_commutes_zero (s c) I I⟩
  obtain ⟨Λ, hΛ⟩ : ∃ Λ : S → (K ⟶ K),
      ∀ c, Λ c = (R.mapHomologicalComplex (ComplexShape.up ℕ)).map (lam c) :=
    ⟨fun c => (R.mapHomologicalComplex (ComplexShape.up ℕ)).map (lam c), fun c => rfl⟩

  have hiso0 : ∀ n : ℕ, ∃ (ιh : (R.rightDerived n).obj A ⟶ K.homology n)
      (ιi : K.homology n ⟶ (R.rightDerived n).obj A), ιh ≫ ιi = 𝟙 _ ∧ ιi ≫ ιh = 𝟙 _ ∧
      ∀ c, HomologicalComplex.homologyMap (Λ c) n ≫ ιi = ιi ≫ (R.rightDerived n).map (s c) := by
    intro n
    refine ⟨(I.isoRightDerivedObj R n).hom, (I.isoRightDerivedObj R n).inv,
      (I.isoRightDerivedObj R n).hom_inv_id, (I.isoRightDerivedObj R n).inv_hom_id,
      fun c => ?_⟩
    have hstar := InjectiveResolution.isoRightDerivedObj_hom_naturality (s c) I I (lam c)
      (hlam c) R n
    have key : (R.mapHomologicalComplex (ComplexShape.up ℕ) ⋙
        HomologicalComplex.homologyFunctor D (ComplexShape.up ℕ) n).map (lam c) ≫
          (I.isoRightDerivedObj R n).inv =
        (I.isoRightDerivedObj R n).inv ≫ (R.rightDerived n).map (s c) := by
      rw [Iso.comp_inv_eq, Category.assoc, hstar, Iso.inv_hom_id_assoc]
    rw [hΛ c]
    exact key
  have hiso : ∀ n : ℕ, ∃ (ιh : (R.rightDerived n).obj A ⟶ K.homology n)
      (ιi : K.homology n ⟶ (R.rightDerived n).obj A), ιh ≫ ιi = 𝟙 _ ∧ ιi ≫ ιh = 𝟙 _ ∧
      (∀ c, HomologicalComplex.homologyMap (Λ c) n ≫ ιi = ιi ≫ (R.rightDerived n).map (s c)) ∧
      (∀ c, (R.rightDerived n).map (s c) ≫ ιh = ιh ≫ HomologicalComplex.homologyMap (Λ c) n) := by
    intro n
    obtain ⟨ιh, ιi, e1, e2, hn⟩ := hiso0 n
    refine ⟨ιh, ιi, e1, e2, hn, fun c => ?_⟩
    calc (R.rightDerived n).map (s c) ≫ ιh
        = (ιh ≫ ιi) ≫ (R.rightDerived n).map (s c) ≫ ιh := by rw [e1, Category.id_comp]
      _ = ιh ≫ (HomologicalComplex.homologyMap (Λ c) n ≫ ιi) ≫ ιh := by
          rw [hn c]; simp only [Category.assoc]
      _ = ιh ≫ HomologicalComplex.homologyMap (Λ c) n := by
          rw [Category.assoc, e2, Category.comp_id]

  have hadd : ∀ (Y : C) (a b : L.obj P ⟶ Y),
      adj.homEquiv P Y (a + b) = adj.homEquiv P Y a + adj.homEquiv P Y b := by
    intro Y a b
    simp only [Adjunction.homEquiv_unit, Functor.map_add, Preadditive.comp_add]
  have hsymm_add : ∀ (Y : C) (a b : P ⟶ R.obj Y),
      (adj.homEquiv P Y).symm (a + b) = (adj.homEquiv P Y).symm a + (adj.homEquiv P Y).symm b := by
    intro Y a b
    rw [Equiv.symm_apply_eq, hadd, Equiv.apply_symm_apply, Equiv.apply_symm_apply]
  have hφs0 : ∀ Y : C, (adj.homEquiv P Y).symm 0 = 0 := by
    intro Y
    rw [Equiv.symm_apply_eq, Adjunction.homEquiv_unit, Functor.map_zero, Limits.comp_zero]
  have hΦ0 : ∀ Y : C, adj.homEquiv P Y 0 = 0 := by
    intro Y
    rw [Adjunction.homEquiv_unit, Functor.map_zero, Limits.comp_zero]

  have hψnat : ∀ (n : ℕ) (ιi : K.homology n ⟶ (R.rightDerived n).obj A),
      (∀ c, HomologicalComplex.homologyMap (Λ c) n ≫ ιi = ιi ≫ (R.rightDerived n).map (s c)) →
      ∀ (c : S) (z : P ⟶ K.cycles n),
      Abelian.Ext.mk₀ ((z ≫ HomologicalComplex.cyclesMap (Λ c) n) ≫ K.homologyπ n ≫ ιi) =
        (Abelian.Ext.mk₀ (z ≫ K.homologyπ n ≫ ιi)).comp
          (Abelian.Ext.mk₀ ((R.rightDerived n).map (s c))) (add_zero 0) := by
    intro n ιi hn c z
    rw [Abelian.Ext.mk₀_comp_mk₀]
    congr 1
    rw [Category.assoc, ← HomologicalComplex.homologyπ_naturality_assoc, hn c]
    simp only [Category.assoc]
  cases q with
  | zero =>

    obtain ⟨ιh, ιi, hιhi, hιih, hιnat, -⟩ := hiso 0
    obtain ⟨ι0, hι0⟩ : ∃ ι0 : A ⟶ I.cocomplex.X 0, ι0 = I.ι.f 0 := ⟨I.ι.f 0, rfl⟩
    have hι0d : ι0 ≫ I.cocomplex.d 0 1 = 0 := by
      subst hι0
      exact I.ι_f_zero_comp_complex_d
    have hlam' : ∀ c, ι0 ≫ (lam c).f 0 = s c ≫ ι0 := by
      subst hι0
      exact hlam
    have hae : ∀ f : L.obj P ⟶ A, Abelian.Ext.addEquiv₀ (Abelian.Ext.mk₀ f) = f := by
      intro f
      rw [← Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
    have hcoc : ∀ f : L.obj P ⟶ A,
        adj.homEquiv P (I.cocomplex.X 0) (f ≫ ι0) ≫ K.d 0 1 = 0 := by
      intro f
      show adj.homEquiv P _ (f ≫ ι0) ≫ R.map (I.cocomplex.d 0 1) = 0
      rw [← adj.homEquiv_naturality_right, Category.assoc, hι0d, Limits.comp_zero, hΦ0]
    obtain ⟨κ, hκ⟩ : ∃ κ : (L.obj P ⟶ A) →+ (P ⟶ K.cycles 0),
        ∀ f, κ f ≫ K.iCycles 0 = adj.homEquiv P (I.cocomplex.X 0) (f ≫ ι0) := by
      refine ⟨AddMonoidHom.mk' (fun f => K.liftCycles
          (adj.homEquiv P (I.cocomplex.X 0) (f ≫ ι0)) 1 (by simp) (hcoc f)) ?_,
        fun f => K.liftCycles_i (adj.homEquiv P (I.cocomplex.X 0) (f ≫ ι0)) 1 (by simp) (hcoc f)⟩
      intro a b
      rw [← cancel_mono (K.iCycles 0)]
      simp only [Preadditive.add_comp, HomologicalComplex.liftCycles_i, hadd]
    obtain ⟨ψ, hψ⟩ : ∃ ψ : (P ⟶ K.cycles 0) →+ Abelian.Ext P ((R.rightDerived 0).obj A) 0,
        ∀ z, ψ z = Abelian.Ext.mk₀ (z ≫ K.homologyπ 0 ≫ ιi) :=
      ⟨AddMonoidHom.mk' (fun z => Abelian.Ext.mk₀ (z ≫ K.homologyπ 0 ≫ ιi))
        (fun a b => by rw [Preadditive.add_comp, Abelian.Ext.mk₀_add]), fun z => rfl⟩
    refine ⟨(ψ.comp κ).comp (Abelian.Ext.addEquiv₀ (X := L.obj P) (Y := A)).toAddMonoidHom,
      0, ?_, ?_, ?_⟩
    · intro c x
      obtain ⟨f, rfl⟩ : ∃ f : L.obj P ⟶ A, Abelian.Ext.mk₀ f = x :=
        ⟨_, Abelian.Ext.mk₀_addEquiv₀_apply x⟩
      show ψ (κ (Abelian.Ext.addEquiv₀ ((Abelian.Ext.mk₀ f).comp (Abelian.Ext.mk₀ (s c))
          (add_zero 0)))) = (ψ (κ (Abelian.Ext.addEquiv₀ (Abelian.Ext.mk₀ f)))).comp
          (Abelian.Ext.mk₀ ((R.rightDerived 0).map (s c))) (add_zero 0)
      rw [Abelian.Ext.mk₀_comp_mk₀, hae, hae]
      have e : (f ≫ s c) ≫ ι0 = (f ≫ ι0) ≫ (lam c).f 0 := by
        rw [Category.assoc, Category.assoc, hlam' c]
      have hκs : κ (f ≫ s c) = κ f ≫ HomologicalComplex.cyclesMap (Λ c) 0 := by
        rw [← cancel_mono (K.iCycles 0), hκ, e, adj.homEquiv_naturality_right, Category.assoc,
          HomologicalComplex.cyclesMap_i, reassoc_of% (hκ f), hΛ c,
          Functor.mapHomologicalComplex_map_f]
      rw [hκs, hψ, hψ]
      exact hψnat 0 ιi hιnat c (κ f)
    · intro c y
      simp only [AddMonoidHom.zero_apply, map_zero]
    · intro y _
      have hπ0 : IsIso (K.homologyπ 0) :=
        K.isIso_homologyπ 0 0 CochainComplex.prev_nat_zero (K.shape 0 0 (by simp))
      obtain ⟨g, rfl⟩ : ∃ g : P ⟶ (R.rightDerived 0).obj A, Abelian.Ext.mk₀ g = y :=
        ⟨_, Abelian.Ext.mk₀_addEquiv₀_apply y⟩
      obtain ⟨w, hw⟩ : ∃ w : P ⟶ K.cycles 0, w = g ≫ ιh ≫ inv (K.homologyπ 0) := ⟨_, rfl⟩
      have hf₀ : (adj.homEquiv P (I.cocomplex.X 0)).symm (w ≫ K.iCycles 0) ≫
          I.cocomplex.d 0 1 = 0 := by
        rw [← adj.homEquiv_naturality_right_symm, Category.assoc]
        have h3 : K.iCycles 0 ≫ R.map (I.cocomplex.d 0 1) = 0 := K.iCycles_d 0 1
        rw [h3, Limits.comp_zero, hφs0]
      obtain ⟨f', hf'⟩ : ∃ f' : L.obj P ⟶ A,
          f' ≫ ι0 = (adj.homEquiv P (I.cocomplex.X 0)).symm (w ≫ K.iCycles 0) := by
        subst hι0
        exact ⟨I.exact₀.lift _ hf₀, I.exact₀.lift_f _ hf₀⟩
      refine ⟨Abelian.Ext.mk₀ f', ?_⟩
      show ψ (κ (Abelian.Ext.addEquiv₀ (Abelian.Ext.mk₀ f'))) = Abelian.Ext.mk₀ g
      have hκw : κ f' = w := by
        rw [← cancel_mono (K.iCycles 0), hκ, hf', Equiv.apply_symm_apply]
      rw [hae, hκw, hψ, hw]
      congr 1
      simp only [Category.assoc, IsIso.inv_hom_id_assoc, hιhi, Category.comp_id]
  | succ m =>
    rw [Nat.add_sub_cancel]
    obtain ⟨ιh₀, ιi₀, hιhi₀, hιih₀, hιnat₀, hιhnat₀⟩ := hiso m
    obtain ⟨ιh₁, ιi₁, hιhi₁, hιih₁, hιnat₁, hιhnat₁⟩ := hiso (m + 1)
    have hinj : Injective (K.X m) := by
      haveI := I.injective m
      exact Injective.injective_of_adjoint adj (I.cocomplex.X m)

    obtain ⟨B, u, v, h1, h2, hS1, hS2, huv⟩ : ∃ (B : D) (u : K.X m ⟶ B)
        (v : B ⟶ K.cycles (m + 1)) (h1 : K.iCycles m ≫ u = 0) (h2 : v ≫ K.homologyπ (m + 1) = 0),
        (ShortComplex.mk _ _ h1).ShortExact ∧ (ShortComplex.mk _ _ h2).ShortExact ∧
          u ≫ v = K.toCycles m (m + 1) := by
      have hv : Limits.image.ι (K.d m (m + 1)) ≫ K.d (m + 1) (m + 1 + 1) = 0 := by
        rw [← cancel_epi (Limits.factorThruImage (K.d m (m + 1))), Limits.image.fac_assoc,
          K.d_comp_d, Limits.comp_zero]
      let v := K.liftCycles (Limits.image.ι (K.d m (m + 1))) (m + 1 + 1)
        (CochainComplex.next ℕ (m + 1)) hv
      have hvi : v ≫ K.iCycles (m + 1) = Limits.image.ι (K.d m (m + 1)) :=
        K.liftCycles_i _ _ _ _
      have huv : Limits.factorThruImage (K.d m (m + 1)) ≫ v = K.toCycles m (m + 1) := by
        rw [← cancel_mono (K.iCycles (m + 1)), Category.assoc, hvi, Limits.image.fac,
          K.toCycles_i]
      have h1 : K.iCycles m ≫ Limits.factorThruImage (K.d m (m + 1)) = 0 := by
        rw [← cancel_mono (Limits.image.ι (K.d m (m + 1))), Category.assoc, Limits.image.fac,
          Limits.zero_comp]
        exact K.iCycles_d m (m + 1)
      have h2 : v ≫ K.homologyπ (m + 1) = 0 := by
        rw [← cancel_epi (Limits.factorThruImage (K.d m (m + 1))), ← Category.assoc, huv,
          Limits.comp_zero]
        exact K.toCycles_comp_homologyπ m (m + 1)
      haveI : Mono v := mono_of_mono_fac hvi
      refine ⟨Limits.image (K.d m (m + 1)), Limits.factorThruImage (K.d m (m + 1)), v, h1, h2,
        ?_, ?_, huv⟩
      · refine ShortComplex.ShortExact.mk' (ShortComplex.exact_of_f_is_kernel _
          (Limits.KernelFork.IsLimit.ofι _ _
            (fun g' hg' => K.liftCycles g' (m + 1) (CochainComplex.next ℕ m) (by
              rw [← Limits.image.fac (K.d m (m + 1)), ← Category.assoc,
                show g' ≫ Limits.factorThruImage (K.d m (m + 1)) = 0 from hg', Limits.zero_comp]))
            (fun g' hg' => K.liftCycles_i _ _ _ _)
            (fun g' hg' m' hm => by
              rw [← cancel_mono (K.iCycles m), K.liftCycles_i]
              exact hm))) inferInstance inferInstance
      · have hprev : (ComplexShape.up ℕ).prev (m + 1) = m := by simp
        refine ShortComplex.ShortExact.mk' (ShortComplex.exact_of_g_is_cokernel _
          (Limits.CokernelCofork.IsColimit.ofπ _ _
            (fun g' hg' => (Limits.CokernelCofork.IsColimit.desc'
              (K.homologyIsCokernel m (m + 1) hprev) g' (by
                rw [← huv, Category.assoc, show v ≫ g' = 0 from hg', Limits.comp_zero])).1)
            (fun g' hg' => (Limits.CokernelCofork.IsColimit.desc'
              (K.homologyIsCokernel m (m + 1) hprev) g' (by
                rw [← huv, Category.assoc, show v ≫ g' = 0 from hg', Limits.comp_zero])).2)
            (fun g' hg' m' hm => by
              rw [← cancel_epi (K.homologyπ (m + 1))]
              exact hm.trans (Limits.CokernelCofork.IsColimit.desc'
                (K.homologyIsCokernel m (m + 1) hprev) g' (by
                  rw [← huv, Category.assoc, show v ≫ g' = 0 from hg', Limits.comp_zero])).2.symm)))
          inferInstance inferInstance
    haveI : Mono v := hS2.mono_f
    haveI : Epi u := hS1.epi_g

    have hβ : ∀ f : K ⟶ K, ∃ β : B ⟶ B, u ≫ β = f.f m ≫ u ∧
        β ≫ v = v ≫ HomologicalComplex.cyclesMap f (m + 1) := by
      intro f
      have hk : K.iCycles m ≫ f.f m ≫ u = 0 := by
        rw [← Category.assoc, ← HomologicalComplex.cyclesMap_i, Category.assoc, h1,
          Limits.comp_zero]
      have hub : u ≫ hS1.exact.desc (f.f m ≫ u) hk = f.f m ≫ u := hS1.exact.g_desc _ _
      refine ⟨hS1.exact.desc (f.f m ≫ u) hk, hub, ?_⟩
      rw [← cancel_epi u, ← cancel_mono (K.iCycles (m + 1))]
      simp only [Category.assoc, HomologicalComplex.cyclesMap_i]
      rw [reassoc_of% hub, reassoc_of% huv, reassoc_of% huv, HomologicalComplex.toCycles_i,
        HomologicalComplex.toCycles_i_assoc]
      exact f.comm m (m + 1)

    have hzc : ∀ z : P ⟶ K.cycles (m + 1),
        (adj.homEquiv P (I.cocomplex.X (m + 1))).symm (z ≫ K.iCycles (m + 1)) ≫
          I.cocomplex.d (m + 1) (m + 1 + 1) = 0 := by
      intro z
      rw [← adj.homEquiv_naturality_right_symm, Category.assoc]
      have h3 : K.iCycles (m + 1) ≫ R.map (I.cocomplex.d (m + 1) (m + 1 + 1)) = 0 :=
        K.iCycles_d (m + 1) (m + 1 + 1)
      rw [h3, Limits.comp_zero, hφs0]
    have hextc : ∀ (f g : L.obj P ⟶ I.cocomplex.X (m + 1))
        (hf : f ≫ I.cocomplex.d (m + 1) (m + 1 + 1) = 0)
        (hg : g ≫ I.cocomplex.d (m + 1) (m + 1 + 1) = 0), f = g →
        I.extMk f (m + 1 + 1) rfl hf = I.extMk g (m + 1 + 1) rfl hg := by
      rintro f g hf hg rfl
      rfl
    obtain ⟨Θ, hΘapply⟩ : ∃ Θ : (P ⟶ K.cycles (m + 1)) →+ Abelian.Ext (L.obj P) A (m + 1),
        ∀ z, Θ z = I.extMk ((adj.homEquiv P (I.cocomplex.X (m + 1))).symm
          (z ≫ K.iCycles (m + 1))) (m + 1 + 1) rfl (hzc z) :=
      ⟨AddMonoidHom.mk' (fun z => I.extMk ((adj.homEquiv P (I.cocomplex.X (m + 1))).symm
          (z ≫ K.iCycles (m + 1))) (m + 1 + 1) rfl (hzc z)) (fun a b => by
          rw [I.add_extMk]
          apply hextc
          rw [Preadditive.add_comp, hsymm_add]), fun z => rfl⟩
    have hΘker : ∀ z, Θ z = 0 → ∃ e : P ⟶ K.X m, e ≫ K.toCycles m (m + 1) = z := by
      intro z hz
      rw [hΘapply, I.extMk_eq_zero_iff _ _ _ _ m rfl] at hz
      obtain ⟨g, hg⟩ := hz
      refine ⟨adj.homEquiv P _ g, ?_⟩
      rw [← cancel_mono (K.iCycles (m + 1)), Category.assoc, K.toCycles_i]
      show adj.homEquiv P _ g ≫ R.map (I.cocomplex.d m (m + 1)) = z ≫ K.iCycles (m + 1)
      rw [← adj.homEquiv_naturality_right, hg, Equiv.apply_symm_apply]
    have hΘnat : ∀ (c : S) z, Θ (z ≫ HomologicalComplex.cyclesMap (Λ c) (m + 1)) =
        (Θ z).comp (Abelian.Ext.mk₀ (s c)) (add_zero (m + 1)) := by
      intro c z
      let φ' : I.Hom I (s c) := InjectiveResolution.Hom.mk (lam c)
        (by rw [CochainComplex.single₀_map_f_zero]; exact hlam c)
      rw [hΘapply, hΘapply, InjectiveResolution.extMk_comp_mk₀ _ _ _ _ φ']
      apply hextc
      rw [Category.assoc, HomologicalComplex.cyclesMap_i, ← Category.assoc, hΛ c,
        Functor.mapHomologicalComplex_map_f]
      exact adj.homEquiv_naturality_right_symm _ _
    have hΘsurj : Function.Surjective Θ := by
      intro x
      obtain ⟨f, hf, rfl⟩ := I.extMk_surjective x (m + 1 + 1) rfl
      have hc : adj.homEquiv P _ f ≫ K.d (m + 1) (m + 1 + 1) = 0 := by
        show adj.homEquiv P _ f ≫ R.map (I.cocomplex.d (m + 1) (m + 1 + 1)) = 0
        rw [← adj.homEquiv_naturality_right, hf, hΦ0]
      refine ⟨K.liftCycles (adj.homEquiv P _ f) (m + 1 + 1) (by simp) hc, ?_⟩
      rw [hΘapply]
      apply hextc
      rw [K.liftCycles_i, Equiv.symm_apply_apply]

    obtain ⟨ψ, hψ⟩ : ∃ ψ : (P ⟶ K.cycles (m + 1)) →+
        Abelian.Ext P ((R.rightDerived (m + 1)).obj A) 0,
        ∀ z, ψ z = Abelian.Ext.mk₀ (z ≫ K.homologyπ (m + 1) ≫ ιi₁) :=
      ⟨AddMonoidHom.mk' (fun z => Abelian.Ext.mk₀ (z ≫ K.homologyπ (m + 1) ≫ ιi₁))
        (fun a b => by rw [Preadditive.add_comp, Abelian.Ext.mk₀_add]), fun z => rfl⟩
    have hkey : ∀ a b, Θ a = Θ b → ψ a = ψ b := by
      intro a b hab
      obtain ⟨e, he⟩ := hΘker (a - b) (by rw [map_sub, hab, sub_self])
      rw [← sub_eq_zero, ← map_sub, ← he, hψ, Category.assoc,
        HomologicalComplex.toCycles_comp_homologyπ_assoc, Limits.zero_comp, Limits.comp_zero,
        Abelian.Ext.mk₀_zero]
    have hσ : ∀ x, Θ (Function.surjInv hΘsurj x) = x := Function.surjInv_eq hΘsurj
    obtain ⟨ε, hεΘ⟩ : ∃ ε : Abelian.Ext (L.obj P) A (m + 1) →+
        Abelian.Ext P ((R.rightDerived (m + 1)).obj A) 0, ∀ z, ε (Θ z) = ψ z :=
      ⟨AddMonoidHom.mk' (fun x => ψ (Function.surjInv hΘsurj x)) (fun x y => by
          rw [← map_add]
          apply hkey
          rw [map_add, hσ, hσ, hσ]),
        fun z => hkey _ _ (hσ _)⟩

    obtain ⟨Ψ, hΨdef⟩ : ∃ Ψ : Abelian.Ext B ((R.rightDerived m).obj A) 1,
        Ψ = hS1.extClass.comp (Abelian.Ext.mk₀ (K.homologyπ m ≫ ιi₀)) (add_zero 1) := ⟨_, rfl⟩
    obtain ⟨Φ', hΦdef⟩ : ∃ Φ' : Abelian.Ext (K.homology (m + 1)) ((R.rightDerived m).obj A) 2,
        Φ' = hS2.extClass.comp Ψ (show 1 + 1 = 2 from rfl) := ⟨_, rfl⟩
    obtain ⟨Ω, hΩdef⟩ : ∃ Ω : Abelian.Ext ((R.rightDerived (m + 1)).obj A)
        ((R.rightDerived m).obj A) 2, Ω = (Abelian.Ext.mk₀ ιh₁).comp Φ' (zero_add 2) :=
      ⟨_, rfl⟩
    have hΩnat : ∀ c, (Abelian.Ext.mk₀ ((R.rightDerived (m + 1)).map (s c))).comp Ω
        (zero_add 2) = Ω.comp (Abelian.Ext.mk₀ ((R.rightDerived m).map (s c))) (add_zero 2) := by
      intro c
      obtain ⟨βc, hub, hβv⟩ := hβ (Λ c)
      have hN0 : hS1.extClass.comp (Abelian.Ext.mk₀ (HomologicalComplex.cyclesMap (Λ c) m))
          (add_zero 1) = (Abelian.Ext.mk₀ βc).comp hS1.extClass (zero_add 1) :=
        hS1.extClass_naturality hS1
          (ShortComplex.Hom.mk (S₁ := ShortComplex.mk (K.iCycles m) u h1)
            (S₂ := ShortComplex.mk (K.iCycles m) u h1)
            (HomologicalComplex.cyclesMap (Λ c) m) ((Λ c).f m) βc
            (HomologicalComplex.cyclesMap_i _ _) hub.symm)
      have hN2 : hS2.extClass.comp (Abelian.Ext.mk₀ βc) (add_zero 1) =
          (Abelian.Ext.mk₀ (HomologicalComplex.homologyMap (Λ c) (m + 1))).comp hS2.extClass
            (zero_add 1) :=
        hS2.extClass_naturality hS2
          (ShortComplex.Hom.mk (S₁ := ShortComplex.mk v (K.homologyπ (m + 1)) h2)
            (S₂ := ShortComplex.mk v (K.homologyπ (m + 1)) h2)
            βc (HomologicalComplex.cyclesMap (Λ c) (m + 1))
            (HomologicalComplex.homologyMap (Λ c) (m + 1)) hβv
            (HomologicalComplex.homologyπ_naturality _ _).symm)
      have hfin : HomologicalComplex.cyclesMap (Λ c) m ≫ K.homologyπ m ≫ ιi₀ =
          (K.homologyπ m ≫ ιi₀) ≫ (R.rightDerived m).map (s c) := by
        rw [Category.assoc, ← HomologicalComplex.homologyπ_naturality_assoc, hιnat₀ c]
      have hΨ : (Abelian.Ext.mk₀ βc).comp Ψ (zero_add 1) =
          Ψ.comp (Abelian.Ext.mk₀ ((R.rightDerived m).map (s c))) (add_zero 1) := by
        rw [hΨdef, ← Abelian.Ext.comp_assoc_of_third_deg_zero, ← hN0,
          Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
          Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
        congr 2
      have key : Φ'.comp (Abelian.Ext.mk₀ ((R.rightDerived m).map (s c))) (add_zero 2) =
          (Abelian.Ext.mk₀ (HomologicalComplex.homologyMap (Λ c) (m + 1))).comp Φ' (zero_add 2) := by
        rw [hΦdef, Abelian.Ext.comp_assoc_of_third_deg_zero, ← hΨ,
          ← Abelian.Ext.comp_assoc_of_second_deg_zero, hN2,
          Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (HomologicalComplex.homologyMap (Λ c) (m + 1)))
            hS2.extClass Ψ (zero_add 1) (show 1 + 1 = 2 from rfl) (show 0 + 1 + 1 = 2 from rfl)]
      rw [hΩdef, Abelian.Ext.mk₀_comp_mk₀_assoc, hιhnat₁ c, ← Abelian.Ext.mk₀_comp_mk₀_assoc,
        ← key, Abelian.Ext.comp_assoc_of_third_deg_zero]
    refine ⟨ε, Ω.postcomp P (zero_add 2), ?_, ?_, ?_⟩
    · intro c x
      obtain ⟨z, rfl⟩ := hΘsurj x
      show ε ((Θ z).comp (Abelian.Ext.mk₀ (s c)) (add_zero (m + 1))) =
        (ε (Θ z)).comp (Abelian.Ext.mk₀ ((R.rightDerived (m + 1)).map (s c))) (add_zero 0)
      rw [← hΘnat c z, hεΘ, hεΘ, hψ, hψ]
      exact hψnat (m + 1) ιi₁ hιnat₁ c z
    · intro c y
      show (y.comp (Abelian.Ext.mk₀ ((R.rightDerived (m + 1)).map (s c))) (add_zero 0)).comp Ω
          (zero_add 2) =
        (y.comp Ω (zero_add 2)).comp (Abelian.Ext.mk₀ ((R.rightDerived m).map (s c))) (add_zero 2)
      rw [Abelian.Ext.comp_assoc_of_second_deg_zero, hΩnat c,
        ← Abelian.Ext.comp_assoc_of_third_deg_zero]
    · intro y hy
      have hy' : y.comp Ω (zero_add 2) = 0 := hy
      obtain ⟨w, hw⟩ : ∃ w : Abelian.Ext P B 1,
          w = (y.comp (Abelian.Ext.mk₀ ιh₁) (add_zero 0)).comp hS2.extClass (zero_add 1) :=
        ⟨_, rfl⟩
      have hYW : y.comp Ω (zero_add 2) = w.comp Ψ (show 1 + 1 = 2 from rfl) := by
        rw [hw, hΩdef, hΦdef, Abelian.Ext.comp_assoc _ hS2.extClass Ψ (zero_add 1)
          (show 1 + 1 = 2 from rfl) (show 0 + 1 + 1 = 2 from rfl),
          Abelian.Ext.comp_assoc_of_second_deg_zero]
      have hwε : (w.comp hS1.extClass (show 1 + 1 = 2 from rfl)).comp
          (Abelian.Ext.mk₀ (K.homologyπ m)) (add_zero 2) = 0 := by
        calc (w.comp hS1.extClass (show 1 + 1 = 2 from rfl)).comp
              (Abelian.Ext.mk₀ (K.homologyπ m)) (add_zero 2)
            = ((w.comp hS1.extClass (show 1 + 1 = 2 from rfl)).comp
                (Abelian.Ext.mk₀ (K.homologyπ m ≫ ιi₀)) (add_zero 2)).comp
                (Abelian.Ext.mk₀ ιh₀) (add_zero 2) := by
              simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
                Category.assoc, hιih₀, Category.comp_id]
          _ = 0 := by
              rw [Abelian.Ext.comp_assoc_of_third_deg_zero w hS1.extClass, ← hΨdef, ← hYW, hy',
                Abelian.Ext.zero_comp]
      have hw0' := hcyc m _ hwε
      haveI : Injective (ShortComplex.mk _ _ h1).X₂ := hinj
      obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ P hS1 w rfl hw0'
      have hw0 : w = 0 := by
        rw [← hx₂, Abelian.Ext.eq_zero_of_injective (n := 0) x₂, Abelian.Ext.zero_comp]
      obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₃ P hS2
        (y.comp (Abelian.Ext.mk₀ ιh₁) (add_zero 0)) (zero_add 1) (by rw [← hw, hw0])
      obtain ⟨z, hz⟩ : ∃ z : P ⟶ K.cycles (m + 1), Abelian.Ext.mk₀ z = x₃ :=
        ⟨_, Abelian.Ext.mk₀_homEquiv₀_apply x₃⟩
      refine ⟨Θ z, ?_⟩
      rw [hεΘ, hψ]
      calc Abelian.Ext.mk₀ (z ≫ K.homologyπ (m + 1) ≫ ιi₁)
          = ((Abelian.Ext.mk₀ z).comp (Abelian.Ext.mk₀ (K.homologyπ (m + 1))) (add_zero 0)).comp
              (Abelian.Ext.mk₀ ιi₁) (add_zero 0) := by
            rw [Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, Category.assoc]
        _ = (y.comp (Abelian.Ext.mk₀ ιh₁) (add_zero 0)).comp (Abelian.Ext.mk₀ ιi₁) (add_zero 0) := by
            rw [hz]
            exact congrArg (fun t => t.comp (Abelian.Ext.mk₀ ιi₁) (add_zero 0)) hx₃
        _ = y := by
            rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, hιhi₁,
              Abelian.Ext.comp_mk₀_id]

theorem wc_pencil_closed_fibre_geom_iso_nonempty (F' F'' : Type u) [Field F'] [Field F'']
    [Finite F''] [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ)
    (D : wcLefschetzDatum F' F'' Y n)
    (hX : WeaklyEtale (Limits.pullback.fst (Over.mk (Limits.pullback.snd D.f D.u0)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (V₀ : (wcP1Over F'').left.ProEt)
    (ε : Limits.pullback V₀.hom D.u0 ≅ Spec (.of (AlgebraicClosure F'')))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom D.u0) :
    Nonempty ((wcProEtPullback (Limits.pullback.fst D.f D.u0)).obj ((wcProEtPullback D.f).obj V₀) ≅
      wcGeomPoint F'' (Over.mk (Limits.pullback.snd D.f D.u0)) hX) :=
by
  classical
  have key : ∀ {V Yt P S Sb : Scheme.{u}} (v : V ⟶ P) (f : Yt ⟶ P) (u : S ⟶ P) (a : Sb ⟶ S)
      (ε : Limits.pullback v u ≅ Sb), ε.hom ≫ a = Limits.pullback.snd v u →
      ∃ β₀ : Limits.pullback (Limits.pullback.snd v f) (Limits.pullback.fst f u) ≅
          Limits.pullback (Limits.pullback.snd f u) a,
        β₀.hom ≫ Limits.pullback.fst (Limits.pullback.snd f u) a =
          Limits.pullback.snd (Limits.pullback.snd v f) (Limits.pullback.fst f u) := by
    intro V Yt P S Sb v f u a ε hε
    have cW : Limits.pullback.fst v f ≫ v = Limits.pullback.snd v f ≫ f :=
      Limits.pullback.condition
    have cT : Limits.pullback.fst (Limits.pullback.snd v f) (Limits.pullback.fst f u) ≫
        Limits.pullback.snd v f =
        Limits.pullback.snd (Limits.pullback.snd v f) (Limits.pullback.fst f u) ≫
          Limits.pullback.fst f u := Limits.pullback.condition
    have cP : Limits.pullback.fst f u ≫ f = Limits.pullback.snd f u ≫ u :=
      Limits.pullback.condition
    have cE : Limits.pullback.fst v u ≫ v = Limits.pullback.snd v u ≫ u :=
      Limits.pullback.condition
    have cX : Limits.pullback.fst (Limits.pullback.snd f u) a ≫ Limits.pullback.snd f u =
        Limits.pullback.snd (Limits.pullback.snd f u) a ≫ a := Limits.pullback.condition
    have hε' : ε.inv ≫ Limits.pullback.snd v u = a := by rw [← hε, Iso.inv_hom_id_assoc]
    obtain ⟨κ, hκ1, hκ2⟩ : ∃ κ : Limits.pullback (Limits.pullback.snd v f)
        (Limits.pullback.fst f u) ⟶ Limits.pullback v u,
        κ ≫ Limits.pullback.fst v u =
          Limits.pullback.fst (Limits.pullback.snd v f) (Limits.pullback.fst f u) ≫
            Limits.pullback.fst v f ∧
        κ ≫ Limits.pullback.snd v u =
          Limits.pullback.snd (Limits.pullback.snd v f) (Limits.pullback.fst f u) ≫
            Limits.pullback.snd f u :=
      ⟨Limits.pullback.lift _ _ (by
        simp only [Category.assoc]; rw [cW, reassoc_of% cT, cP]),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    obtain ⟨βl, hβ1, hβ2⟩ : ∃ βl : Limits.pullback (Limits.pullback.snd v f)
        (Limits.pullback.fst f u) ⟶ Limits.pullback (Limits.pullback.snd f u) a,
        βl ≫ Limits.pullback.fst (Limits.pullback.snd f u) a =
          Limits.pullback.snd (Limits.pullback.snd v f) (Limits.pullback.fst f u) ∧
        βl ≫ Limits.pullback.snd (Limits.pullback.snd f u) a = κ ≫ ε.hom :=
      ⟨Limits.pullback.lift _ (κ ≫ ε.hom) (by rw [Category.assoc, hε, hκ2]),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    obtain ⟨w, hw1, hw2⟩ : ∃ w : Limits.pullback (Limits.pullback.snd f u) a ⟶
        Limits.pullback v f,
        w ≫ Limits.pullback.fst v f =
          Limits.pullback.snd (Limits.pullback.snd f u) a ≫ ε.inv ≫ Limits.pullback.fst v u ∧
        w ≫ Limits.pullback.snd v f =
          Limits.pullback.fst (Limits.pullback.snd f u) a ≫ Limits.pullback.fst f u :=
      ⟨Limits.pullback.lift _ _ (by
        simp only [Category.assoc]; rw [cE, reassoc_of% hε', ← reassoc_of% cX, cP]),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    obtain ⟨γ, hγ1, hγ2⟩ : ∃ γ : Limits.pullback (Limits.pullback.snd f u) a ⟶
        Limits.pullback (Limits.pullback.snd v f) (Limits.pullback.fst f u),
        γ ≫ Limits.pullback.fst (Limits.pullback.snd v f) (Limits.pullback.fst f u) = w ∧
        γ ≫ Limits.pullback.snd (Limits.pullback.snd v f) (Limits.pullback.fst f u) =
          Limits.pullback.fst (Limits.pullback.snd f u) a :=
      ⟨Limits.pullback.lift w _ hw2, Limits.pullback.lift_fst _ _ _,
        Limits.pullback.lift_snd _ _ _⟩
    have hγκ : γ ≫ κ = Limits.pullback.snd (Limits.pullback.snd f u) a ≫ ε.inv := by
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc]
        rw [hκ1, reassoc_of% hγ1, hw1]
      · simp only [Category.assoc]
        rw [hκ2, reassoc_of% hγ2, cX, hε']
    have hβγ : βl ≫ γ = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hγ1, Category.id_comp]
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, hw1, reassoc_of% hβ2]
          simp only [Category.assoc, Iso.hom_inv_id_assoc]
          rw [hκ1]
        · rw [Category.assoc, hw2, reassoc_of% hβ1, cT]
      · rw [Category.assoc, hγ2, hβ1, Category.id_comp]
    have hγβ : γ ≫ βl = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hβ1, hγ2, Category.id_comp]
      · rw [Category.assoc, hβ2, ← Category.assoc, hγκ, Category.assoc, Iso.inv_hom_id,
          Category.comp_id, Category.id_comp]
    exact ⟨⟨βl, γ, hβγ, hγβ⟩, hβ1⟩
  obtain ⟨β₀, hβ₀⟩ := key V₀.hom D.f D.u0
    (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ε hε
  exact ⟨MorphismProperty.Over.isoMk β₀ hβ₀⟩

theorem wc_pencil_nbhd_torsion_restriction_bijective (F' F'' : Type u) [Field F'] [Field F'']
    [Finite F''] [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
