    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) hmono inferInstance
  obtain ⟨θ, hθs, hθc, hθF⟩ := wc_pencil_local_purity F' F'' Y n hn hn2 D ℓ hℓ hP hX
  have hv := wc_pencil_punct_ext2_vanish F' F'' Y n hn2 D ℓ hℓ hP (n - 2)
  refine ⟨((Abelian.Ext.mk₀ (Limits.cokernel.π
      (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' D.u0 hP)))).precomp
      (wcRq D.f ℓ (n - 2)) (zero_add 2)).comp θ, ?_, ?_, ?_⟩
  · intro y
    have h0 : (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left
