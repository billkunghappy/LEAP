    simpa only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] using h
  obtain ⟨ev, hev1, -⟩ := wc_free_ext0_eval (wcP1Over F'').left

  have hglue : ∀ (Off Good : (wcP1Over F'').left.ProEt → Prop)
      (hOff : ∀ (V V' : (wcP1Over F'').left.ProEt) (a : V' ⟶ V), Off V → Off V')
      (hcov : ∀ U : (wcP1Over F'').left.ProEt,
        Sieve.generate (fun (W : (wcP1Over F'').left.ProEt) (_ : W ⟶ U) => Good W) ∈
          Scheme.ProEt.topology (wcP1Over F'').left U)
      (G H : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}) (ι : Type)
      (σG : ι → (G ⟶ G)) (σH : ι → (H ⟶ H))
      (β : ∀ V : (wcP1Over F'').left.ProEt, Off V → Good V →
        G.obj.obj (Opposite.op V) →+ G.obj.obj (Opposite.op V) →+ H.obj.obj (Opposite.op V))
      (hβ : ∀ (V V' : (wcP1Over F'').left.ProEt) (hV : Off V) (gV : Good V) (hV' : Off V')
        (gV' : Good V') (a : V' ⟶ V) (y y' : G.obj.obj (Opposite.op V)),
