    ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V)
    (wcIntSheaf X ℓ) (wcLadicSheaf X ℓ) (wcIntScalar X ℓ (ℓ : ℤ_[ℓ])) κ ⟨h2⟩
    (wcContSheaf B ((Fin a → ℤ_[ℓ]) × ((j : Fin b) → ZMod (ℓ ^ e j))))
    (wcContSheaf B (Fin a → ℚ_[ℓ])) (ℓ • 𝟙 _) κ1 ⟨hR⟩ θ hcomm
  have hτn : ∀ n : ℕ, ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (((wcProEtPush g).rightDerived q).map (k n)) ≫ τ.hom =
      θ.hom ≫ ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
          (wcContSheafMap B (AddMonoidHom.fst (Fin a → ℤ_[ℓ]) ((j : Fin b) → ZMod (ℓ ^ e j))) hp) ≫
        ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
          (wcContSheafMap B (ψ n) (hψc n)) := by
    intro n
    have h := hτ n
    rw [hκ1 n, hκ8 n, Functor.map_comp] at h
    exact h

  have hE := wc_padic_intertwine_of_separated ℓ
    (fun c : ℤ_[ℓ] => θ.inv ≫ ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (((wcProEtPush g).rightDerived q).map (wcIntScalar X ℓ c)) ≫ θ.hom)
    (fun c : ℤ_[ℓ] => ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (wcContSheafMap B (DistribSMul.toAddMonoidHom (Fin a → ℤ_[ℓ]) c) (continuous_const_smul c)))
    (((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (wcContSheafMap B (AddMonoidHom.fst (Fin a → ℤ_[ℓ]) ((j : Fin b) → ZMod (ℓ ^ e j))) hp))
    (fun x y => by
      rw [hiadd, wc_rightDerived_map_add, Functor.map_add, Preadditive.add_comp,
        Preadditive.comp_add])
    (fun n => by
      rw [wc_intScalar_natCast_eq_nsmul, wc_rightDerived_map_nsmul_id, Functor.map_nsmul,
        CategoryTheory.Functor.map_id, Preadditive.nsmul_comp, Preadditive.comp_nsmul]
      exact congrArg (fun z => n • z)
        ((congrArg (fun w => θ.inv ≫ w) (Category.id_comp θ.hom)).trans θ.inv_hom_id))
    (fun x y => by
      rw [himul, Functor.map_comp, Functor.map_comp]
      simp only [Category.assoc, Iso.hom_inv_id_assoc])
    (fun x y => by
      rw [hsadd, Functor.map_add])
    (fun n => by
      rw [hsnat, Functor.map_nsmul, CategoryTheory.Functor.map_id])
    (fun x y => by
      rw [hsmul, Functor.map_comp])
    (fun Δ hΔ => wc_contSheaf_over_hom_ladic_separated B V (Fin a → ℤ_[ℓ]) ℓ
      (wc_padic_pi_int_separated ℓ a) _ Δ hΔ)
  have hInt : ∀ c : ℤ_[ℓ],
      ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
          (wcRqScalar g ℓ q (c : ℚ_[ℓ])) ≫ τ.hom =
        τ.hom ≫ ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
          (wcContSheafMap B (DistribSMul.toAddMonoidHom (Fin a → ℚ_[ℓ]) (c : ℚ_[ℓ]))
            (continuous_const_smul (c : ℚ_[ℓ]))) := by
    intro c
    apply h2.hom_ext
    intro n
    show ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
          (((wcProEtPush g).rightDerived q).map (k n)) ≫
        ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
          (((wcProEtPush g).rightDerived q).map (wcLadicScalar X ℓ (c : ℚ_[ℓ]))) ≫ τ.hom =
      ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
          (((wcProEtPush g).rightDerived q).map (k n)) ≫ τ.hom ≫
        ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
          (wcContSheafMap B (DistribSMul.toAddMonoidHom (Fin a → ℚ_[ℓ]) (c : ℚ_[ℓ]))
            (continuous_const_smul (c : ℚ_[ℓ])))
    have hi_n : k n ≫ wcLadicScalar X ℓ (c : ℚ_[ℓ]) = wcIntScalar X ℓ c ≫ k n := by
      rw [hk n, Category.assoc, ← hlmul, mul_comm (c : ℚ_[ℓ]), hlmul, ← Category.assoc,
        ← hicomm, Category.assoc]
    have hψO : ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
          (wcContSheafMap B (DistribSMul.toAddMonoidHom (Fin a → ℤ_[ℓ]) c) (continuous_const_smul c)) ≫
        ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
          (wcContSheafMap B (ψ n) (hψc n)) =
        ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
          (wcContSheafMap B (ψ n) (hψc n)) ≫
        ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
          (wcContSheafMap B (DistribSMul.toAddMonoidHom (Fin a → ℚ_[ℓ]) (c : ℚ_[ℓ]))
            (continuous_const_smul (c : ℚ_[ℓ]))) := by
      rw [← Functor.map_comp, ← Functor.map_comp, hψcomm (ψ n) (hψc n) _ (hψ n) c]
    have hEc := hE c
    beta_reduce at hEc
    have key : ∀ {W} (h : ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).obj (wcContSheaf B (Fin a → ℤ_[ℓ])) ⟶ W),
        ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map (((wcProEtPush g).rightDerived q).map (wcIntScalar X ℓ c)) ≫ θ.hom ≫
          ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
          (wcContSheafMap B (AddMonoidHom.fst (Fin a → ℤ_[ℓ]) ((j : Fin b) → ZMod (ℓ ^ e j))) hp) ≫ h =
        θ.hom ≫ ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
          (wcContSheafMap B (AddMonoidHom.fst (Fin a → ℤ_[ℓ]) ((j : Fin b) → ZMod (ℓ ^ e j))) hp) ≫ ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
          (wcContSheafMap B (DistribSMul.toAddMonoidHom (Fin a → ℤ_[ℓ]) c) (continuous_const_smul c)) ≫ h := by
      intro W h
      have h' := congrArg (fun z => θ.hom ≫ z ≫ h) hEc
      simpa only [Category.assoc, Iso.hom_inv_id_assoc] using h'
    have hτn' : ∀ {W} (h : ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).obj (wcContSheaf B (Fin a → ℚ_[ℓ])) ⟶ W),
        ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map (((wcProEtPush g).rightDerived q).map (k n)) ≫ τ.hom ≫ h =
        θ.hom ≫ ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
          (wcContSheafMap B (AddMonoidHom.fst (Fin a → ℤ_[ℓ]) ((j : Fin b) → ZMod (ℓ ^ e j))) hp) ≫ ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map (wcContSheafMap B (ψ n) (hψc n)) ≫ h := by
      intro W h
      rw [← Category.assoc, hτn n]
      simp only [Category.assoc]
    rw [← Category.assoc, ← Functor.map_comp, ← Functor.map_comp, hi_n, Functor.map_comp,
      Functor.map_comp, Category.assoc, hτn n, hτn', key, hψO]

  have hψ0 : ∀ (v : Fin a → ℤ_[ℓ]) (i : Fin a), ψ 0 v i = ((v i : ℤ_[ℓ]) : ℚ_[ℓ]) := by
    intro v i
    rw [hψ 0 v i, pow_zero, inv_one, one_mul]
  have hframe := hN1 (wcRq g ℓ q) (((wcProEtPush g).rightDerived q).obj (wcIntSheaf X ℓ))
    (((wcProEtPush g).rightDerived q).map (k 0)) θ τ hp (ψ 0) (hψc 0) hψ0 (hτn 0)

  refine ⟨τ, fun c => wc_rat_intertwine_of_int ℓ
    (fun c : ℚ_[ℓ] => ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
      (wcRqScalar g ℓ q c))
    (fun c : ℚ_[ℓ] => ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
      (wcContSheafMap B (DistribSMul.toAddMonoidHom (Fin a → ℚ_[ℓ]) c) (continuous_const_smul c)))
    τ.hom ?_ ?_ ?_ hInt c, hframe⟩
  · show ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
      (((wcProEtPush g).rightDerived q).map (wcLadicScalar X ℓ 1)) = 𝟙 _
    rw [hl1, CategoryTheory.Functor.map_id, CategoryTheory.Functor.map_id]
  · intro x y
    show ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (((wcProEtPush g).rightDerived q).map (wcLadicScalar X ℓ (x * y))) =
      ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (((wcProEtPush g).rightDerived q).map (wcLadicScalar X ℓ y)) ≫
      ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (((wcProEtPush g).rightDerived q).map (wcLadicScalar X ℓ x))
    rw [hlmul, Functor.map_comp, Functor.map_comp]
  · intro x y
    show ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (wcContSheafMap B (DistribSMul.toAddMonoidHom (Fin a → ℚ_[ℓ]) (x * y))
          (continuous_const_smul (x * y))) =
      ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (wcContSheafMap B (DistribSMul.toAddMonoidHom (Fin a → ℚ_[ℓ]) y) (continuous_const_smul y)) ≫
      ((Scheme.ProEt.topology B).overPullback AddCommGrpCat.{u+1} V).map
        (wcContSheafMap B (DistribSMul.toAddMonoidHom (Fin a → ℚ_[ℓ]) x) (continuous_const_smul x))
    rw [hqmul, Functor.map_comp]

theorem wc_frame_integral_transport : ∀ (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (W : S.ProEt), ConnectedSpace W.left →
    ∀ (R E Q : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (ι : E ⟶ R) (π : E ⟶ Q),
    Mono ι → Epi π → ∀ (σQ : ℚ_[ℓ] → (Q ⟶ Q)) (a e r : ℕ)
    (τ : R.over W ≅ (wcContSheaf S (Fin a → ℚ_[ℓ])).over W)
    (θE : E.over W ≅ (wcContSheaf S (Fin e → ℚ_[ℓ])).over W)
    (θQ : Q.over W ≅ (wcContSheaf S (Fin r → ℚ_[ℓ])).over W),
    (∀ c : ℚ_[ℓ], ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map (σQ c) ≫
        θQ.hom = θQ.hom ≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map
          (wcConstScalar S ℓ r c)) →
    (∀ (γ : W ⟶ W) (M : Matrix (Fin a) (Fin a) ℚ_[ℓ]),
      (∀ (s : R.obj.obj (Opposite.op W)) (z : W.left),
        (show C(↥W.left, Fin a → ℚ_[ℓ]) from
          ((τ.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z =
        M.mulVec ((show C(↥W.left, Fin a → ℚ_[ℓ]) from
          ((τ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z)) →
      ∀ i j, ‖M i j‖ ≤ 1) →
    ∃ θ : Q.over W ≅ (wcContSheaf S (Fin r → ℚ_[ℓ])).over W,
      (∀ c : ℚ_[ℓ], ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map (σQ c) ≫
          θ.hom = θ.hom ≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map
            (wcConstScalar S ℓ r c)) ∧
      (∀ (γ : W ⟶ W) (M : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
        (∀ (s : Q.obj.obj (Opposite.op W)) (z : W.left),
          (show C(↥W.left, Fin r → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z =
          M.mulVec ((show C(↥W.left, Fin r → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z)) →
        ∀ i j, ‖M i j‖ ≤ 1) ∧
      (∀ (γ γ' : W ⟶ W), γ' ≫ γ = 𝟙 W → ∀ M : Matrix (Fin r) (Fin r) ℚ_[ℓ],
        (∀ (s : Q.obj.obj (Opposite.op W)) (z : W.left),
          (show C(↥W.left, Fin r → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z =
          M.mulVec ((show C(↥W.left, Fin r → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z)) →
        ∃ M' : Matrix (Fin r) (Fin r) ℚ_[ℓ], M * M' = 1 ∧ ∀ i j, ‖M' i j‖ ≤ 1) :=
by
  classical
  intro S ℓ _ W hW R E Q ι π hι hπ σQ a e r τ θE θQ hθQ hτint
  obtain ⟨z₀⟩ := hW.toNonempty
  set ρ := (Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W with hρ

  have key : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]
      (φ : A →+ B) (hφ : Continuous φ) (U : (S.ProEt)ᵒᵖ)
      (x : ((wcContSheaf S A).obj.obj U : Type (u+1))),
      (wcContSheafMap S φ hφ).hom.app U x =
        (ULift.up (AddMonoidHom.compLeftContinuous
          (↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U))) φ hφ
          (ULift.down x : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), A))) : _) := by
    intro A B _ _ _ _ _ _ φ hφ U x
    rfl

  have hext : ∀ {A : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      {F : Sheaf ((Scheme.ProEt.topology S).over W) AddCommGrpCat.{u+1}}
      (α β : F ⟶ (wcContSheaf S A).over W),
      (∀ (T : Over W) (y : F.obj.obj (Opposite.op T)) (z : T.left.left),
        wcContEval S T.left ((α.hom.app (Opposite.op T)).hom y) z =
        wcContEval S T.left ((β.hom.app (Opposite.op T)).hom y) z) → α = β := by
    intro A _ _ _ F α β h
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext T
    apply AddCommGrpCat.ext
    intro y
    apply ULift.ext
    apply ContinuousMap.ext
    intro z
    exact h T.unop y z

  have hconst : ∀ (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (k : ℕ)
      (θ : G.over W ≅ (wcContSheaf S (Fin k → ℚ_[ℓ])).over W) (u : Fin k → ℚ_[ℓ]),
      ∃ x : G.obj.obj (Opposite.op W), ∀ z : W.left,
        wcContEval S W ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom x) z = u := by
    intro G k θ u
    let κ : (wcContSheaf S (Fin k → ℚ_[ℓ])).obj.obj (Opposite.op W) :=
      ULift.up (ContinuousMap.const ↥W.left u)
    refine ⟨(θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom κ, fun z => ?_⟩
    have hx : (θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom
        ((θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom κ) = κ :=
      congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom κ) θ.inv_hom_id
    have := congrArg (fun c : (wcContSheaf S (Fin k → ℚ_[ℓ])).obj.obj (Opposite.op W) =>
      wcContEval S W c z) hx
    exact this

  have s2 : ∀ (X Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (f : X ⟶ Y) (a b : ℕ)
      (θX : X.over W ≅ (wcContSheaf S (Fin a → ℚ_[ℓ])).over W)
      (θY : Y.over W ≅ (wcContSheaf S (Fin b → ℚ_[ℓ])).over W)
      (L : (Fin a → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin b → ℚ_[ℓ])),
      (∀ (T : Over W) (x : X.obj.obj (Opposite.op T.left)) (z : T.left.left),
        wcContEval S T.left ((θY.hom.hom.app (Opposite.op T)).hom
          ((f.hom.app (Opposite.op T.left)).hom x)) z =
          L (wcContEval S T.left ((θX.hom.hom.app (Opposite.op T)).hom x) z)) →
      ∀ (γ : W ⟶ W) (gX : (Fin a → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin a → ℚ_[ℓ]))
        (gY : (Fin b → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin b → ℚ_[ℓ])),
      (∀ (s : X.obj.obj (Opposite.op W)) (z : W.left),
        wcContEval S W ((θX.hom.hom.app (Opposite.op (Over.mk γ))).hom s) z =
          gX (wcContEval S W ((θX.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s) z)) →
      (∀ (s : Y.obj.obj (Opposite.op W)) (z : W.left),
        wcContEval S W ((θY.hom.hom.app (Opposite.op (Over.mk γ))).hom s) z =
          gY (wcContEval S W ((θY.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s) z)) →
      ∀ v, gY (L v) = L (gX v) := by
    intro X Y f a b θX θY L hL γ gX gY hgX hgY v
    obtain ⟨x, hx⟩ := hconst X a θX v
    have h1 : wcContEval S W ((θY.hom.hom.app (Opposite.op (Over.mk γ))).hom
        ((f.hom.app (Opposite.op W)).hom x)) z₀ =
        L (wcContEval S W ((θX.hom.hom.app (Opposite.op (Over.mk γ))).hom x) z₀) :=
      hL (Over.mk γ) x z₀
    have h4 : wcContEval S W ((θY.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom
        ((f.hom.app (Opposite.op W)).hom x)) z₀ =
        L (wcContEval S W ((θX.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom x) z₀) :=
      hL (Over.mk (𝟙 W)) x z₀
    have h2 := hgX x z₀
    have h3 := hgY ((f.hom.app (Opposite.op W)).hom x) z₀
    rw [hx z₀] at h2 h4
    rw [h4] at h3
    rw [← h3, h1, h2]

  obtain ⟨Lι, hLι, hιinj⟩ := wc_proet_over_frame_hom_linear S ℓ W hW E R ι e a θE τ
  have hι' : Function.Injective Lι := hιinj hι
  obtain ⟨Lπ, hLπ, -⟩ := wc_proet_over_frame_hom_linear S ℓ W hW E Q π e r θE θQ

  have hπ' : Function.Surjective Lπ := by
    have adj := (Over.forget W).sheafAdjunctionCocontinuous AddCommGrpCat.{u+1}
      ((Scheme.ProEt.topology S).over W) (Scheme.ProEt.topology S)
    haveI : ρ.IsLeftAdjoint := ⟨_, ⟨adj⟩⟩
    haveI : ρ.PreservesEpimorphisms := Functor.preservesEpimorphisms_of_isLeftAdjoint ρ
    haveI : Epi (ρ.map π) := ρ.map_epi π
    let Φ : (wcContSheaf S (Fin e → ℚ_[ℓ])).over W ⟶ (wcContSheaf S (Fin r → ℚ_[ℓ])).over W :=
      θE.inv ≫ ρ.map π ≫ θQ.hom
    haveI : Epi Φ := by
      show Epi (θE.inv ≫ ρ.map π ≫ θQ.hom)
      infer_instance
    have hΦ : ∀ (T : Over W) (y : (wcContSheaf S (Fin e → ℚ_[ℓ])).obj.obj (Opposite.op T.left))
        (z : T.left.left),
        wcContEval S T.left ((Φ.hom.app (Opposite.op T)).hom y) z =
          Lπ (wcContEval S T.left y z) := by
      intro T y z
      have h2 : (θE.hom.hom.app (Opposite.op T)).hom ((θE.inv.hom.app (Opposite.op T)).hom y) = y :=
        congrArg (fun φ => (φ.hom.app (Opposite.op T)).hom y) θE.inv_hom_id
      have h1 := hLπ T ((θE.inv.hom.app (Opposite.op T)).hom y) z
      rw [h2] at h1
      exact h1
    have hcg : ∀ (g : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] ℚ_[ℓ]) (T : Over W)
        (y : (wcContSheaf S (Fin e → ℚ_[ℓ])).obj.obj (Opposite.op T.left)) (z : T.left.left),
        wcContEval S T.left (((Φ ≫ ρ.map (wcContSheafMap S g.toAddMonoidHom
          (LinearMap.continuous_of_finiteDimensional g))).hom.app (Opposite.op T)).hom y) z =
          g (Lπ (wcContEval S T.left y z)) := by
      intro g T y z
      rw [← hΦ T y z]
      rfl
    by_contra hns
    have hlt : LinearMap.range Lπ < ⊤ :=
      lt_top_iff_ne_top.mpr (fun h => hns (LinearMap.range_eq_top.mp h))
    obtain ⟨fl, hfl0, hfl⟩ := Submodule.exists_le_ker_of_lt_top _ hlt
    have heq : Φ ≫ ρ.map (wcContSheafMap S fl.toAddMonoidHom
          (LinearMap.continuous_of_finiteDimensional fl)) =
        Φ ≫ ρ.map (wcContSheafMap S (0 : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] ℚ_[ℓ]).toAddMonoidHom
          (LinearMap.continuous_of_finiteDimensional (0 : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] ℚ_[ℓ]))) := by
      apply hext
      intro T y z
      rw [hcg fl T y z, hcg 0 T y z]
      have hk : Lπ (wcContEval S T.left y z) ∈ LinearMap.ker fl :=
        hfl (LinearMap.mem_range_self Lπ _)
      rw [LinearMap.mem_ker] at hk
      rw [hk, LinearMap.zero_apply]
    have hΨ := (cancel_epi Φ).mp heq
    apply hfl0
    apply LinearMap.ext
    intro v
    have hv := congrArg (fun φ : (wcContSheaf S (Fin r → ℚ_[ℓ])).over W ⟶
        (wcContSheaf S ℚ_[ℓ]).over W =>
      wcContEval S W ((φ.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom
        (show (wcContSheaf S (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op W) from
          ULift.up (ContinuousMap.const ↥W.left v))) z₀) hΨ
    exact hv

  have s3 : ∃ C : ℝ, ∀ (gR : (Fin a → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin a → ℚ_[ℓ]))
      (gE : (Fin e → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin e → ℚ_[ℓ]))
      (gV : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])),
      (∀ i j, ‖LinearMap.toMatrix' gR i j‖ ≤ 1) → gR ∘ₗ Lι = Lι ∘ₗ gE → gV ∘ₗ Lπ = Lπ ∘ₗ gE →
      ∀ j : Fin r, ‖gV (Pi.single j 1)‖ ≤ C := by
    obtain ⟨ιp, hιp⟩ := LinearMap.exists_leftInverse_of_injective Lι (LinearMap.ker_eq_bot.mpr hι')
    obtain ⟨πp, hπp⟩ := LinearMap.exists_rightInverse_of_surjective Lπ
      (LinearMap.range_eq_top.mpr hπ')
    obtain ⟨T, hT⟩ : ∃ T : (Fin a → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]), T = Lπ ∘ₗ ιp := ⟨_, rfl⟩
    obtain ⟨U, hU⟩ : ∃ U : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin a → ℚ_[ℓ]), U = Lι ∘ₗ πp := ⟨_, rfl⟩
    refine ⟨‖LinearMap.toContinuousLinearMap T‖ * ‖LinearMap.toContinuousLinearMap U‖, ?_⟩
    intro gR gE gV hR h1 h2 j
    have hfac : ∀ v, gV v = T (gR (U v)) := by
      intro v
      have e1 : Lπ (πp v) = v := LinearMap.congr_fun hπp v
      have e2 : ∀ w, ιp (Lι w) = w := fun w => LinearMap.congr_fun hιp w
      have e3 : ∀ w, gR (Lι w) = Lι (gE w) := fun w => LinearMap.congr_fun h1 w
      have e4 : ∀ w, gV (Lπ w) = Lπ (gE w) := fun w => LinearMap.congr_fun h2 w
      rw [hT, hU]
      show gV v = Lπ (ιp (gR (Lι (πp v))))
      rw [e3, e2, ← e4, e1]
    have hcon : ∀ w, ‖gR w‖ ≤ ‖w‖ := by
      intro w
      refine (pi_norm_le_iff_of_nonneg (norm_nonneg w)).mpr ?_
      intro i
      have hsum : gR w i = ∑ k, LinearMap.toMatrix' gR i k * w k := by
        rw [← LinearMap.toMatrix'_mulVec gR w]; rfl
      rw [hsum]
      apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg (norm_nonneg w)
      intro k _
      rw [norm_mul]
      calc ‖LinearMap.toMatrix' gR i k‖ * ‖w k‖ ≤ 1 * ‖w‖ :=
            mul_le_mul (hR i k) (norm_le_pi_norm w k) (norm_nonneg _) zero_le_one
        _ = ‖w‖ := one_mul _
    have hej : ‖(Pi.single j 1 : Fin r → ℚ_[ℓ])‖ ≤ 1 := by
      refine (pi_norm_le_iff_of_nonneg zero_le_one).mpr ?_
      intro i
      by_cases h : i = j
      · subst h; simp
      · rw [Pi.single_eq_of_ne h]; simp
    rw [hfac]
    have hT' := (LinearMap.toContinuousLinearMap T).le_opNorm (gR (U (Pi.single j 1)))
    have hU' := (LinearMap.toContinuousLinearMap U).le_opNorm (Pi.single j 1)
    rw [LinearMap.coe_toContinuousLinearMap'] at hT' hU'
    have n1 := (LinearMap.toContinuousLinearMap T).opNorm_nonneg
    have n2 := (LinearMap.toContinuousLinearMap U).opNorm_nonneg
    calc ‖T (gR (U (Pi.single j 1)))‖
        ≤ ‖LinearMap.toContinuousLinearMap T‖ * ‖gR (U (Pi.single j 1))‖ := hT'
      _ ≤ ‖LinearMap.toContinuousLinearMap T‖ * ‖U (Pi.single j 1)‖ :=
          mul_le_mul_of_nonneg_left (hcon _) n1
      _ ≤ ‖LinearMap.toContinuousLinearMap T‖ *
            (‖LinearMap.toContinuousLinearMap U‖ * ‖(Pi.single j 1 : Fin r → ℚ_[ℓ])‖) :=
          mul_le_mul_of_nonneg_left hU' n1
      _ ≤ ‖LinearMap.toContinuousLinearMap T‖ * (‖LinearMap.toContinuousLinearMap U‖ * 1) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hej n2) n1
      _ = _ := by ring
  obtain ⟨C, hC⟩ := s3

  obtain ⟨H, hH⟩ : ∃ H : Set ((Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])), ∀ h, h ∈ H ↔
      ∃ γ : W ⟶ W, ∀ (V : S.ProEt) (p q : V ⟶ W), q = p ≫ γ →
        ∀ (x : Q.obj.obj (Opposite.op V)) (z : V.left),
          (show C(↥V.left, Fin r → ℚ_[ℓ]) from
            ((θQ.hom.hom.app (Opposite.op (Over.mk q))).hom x).down) z =
          h ((show C(↥V.left, Fin r → ℚ_[ℓ]) from
            ((θQ.hom.hom.app (Opposite.op (Over.mk p))).hom x).down) z) :=
    ⟨{h | ∃ γ : W ⟶ W, ∀ (V : S.ProEt) (p q : V ⟶ W), q = p ≫ γ →
        ∀ (x : Q.obj.obj (Opposite.op V)) (z : V.left),
          (show C(↥V.left, Fin r → ℚ_[ℓ]) from
            ((θQ.hom.hom.app (Opposite.op (Over.mk q))).hom x).down) z =
          h ((show C(↥V.left, Fin r → ℚ_[ℓ]) from
            ((θQ.hom.hom.app (Opposite.op (Over.mk p))).hom x).down) z)}, fun h => Iff.rfl⟩
  have hmul : ∀ h₁ ∈ H, ∀ h₂ ∈ H, h₂ ∘ₗ h₁ ∈ H := by
    intro h₁ hh₁ h₂ hh₂
    obtain ⟨γ₁, hγ₁⟩ := (hH h₁).mp hh₁
    obtain ⟨γ₂, hγ₂⟩ := (hH h₂).mp hh₂
    refine (hH _).mpr ⟨γ₁ ≫ γ₂, ?_⟩
    intro V p q hq x z
    rw [hγ₂ V (p ≫ γ₁) q (by rw [hq, Category.assoc]) x z, hγ₁ V p (p ≫ γ₁) rfl x z]
    rfl
  have hbd : ∃ C : ℝ, ∀ h ∈ H, ∀ j : Fin r, ‖h (Pi.single j 1)‖ ≤ C := by
    refine ⟨C, ?_⟩
    intro h hh j
    obtain ⟨γ, hγ⟩ := (hH h).mp hh
    obtain ⟨gR, hgR⟩ := wc_proet_deck_frame_linear S ℓ R W hW a τ γ
    obtain ⟨gE, hgE⟩ := wc_proet_deck_frame_linear S ℓ E W hW e θE γ
    have hRint := hτint γ (LinearMap.toMatrix' gR) (fun s z =>
      (hgR W (𝟙 W) γ (Category.id_comp γ).symm s z).trans (LinearMap.toMatrix'_mulVec gR _).symm)
    have i1 := s2 E R ι e a θE τ Lι hLι γ gE gR
      (fun s z => hgE W (𝟙 W) γ (Category.id_comp γ).symm s z)
      (fun s z => hgR W (𝟙 W) γ (Category.id_comp γ).symm s z)
    have i2 := s2 E Q π e r θE θQ Lπ hLπ γ gE h
      (fun s z => hgE W (𝟙 W) γ (Category.id_comp γ).symm s z)
      (fun s z => hγ W (𝟙 W) γ (Category.id_comp γ).symm s z)
    exact hC gR gE h hRint (LinearMap.ext fun v => i1 v) (LinearMap.ext fun v => i2 v) j

  obtain ⟨P, hP⟩ := wc_qtl_bounded_monoid_lattice ℓ r H hbd hmul

  let cP := wcContSheafMap S P.toLinearMap.toAddMonoidHom
    (LinearMap.continuous_of_finiteDimensional P.toLinearMap)
  let cP' := wcContSheafMap S P.symm.toLinearMap.toAddMonoidHom
    (LinearMap.continuous_of_finiteDimensional P.symm.toLinearMap)
  have hPP' : cP ≫ cP' = 𝟙 _ := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    apply ULift.ext
    apply ContinuousMap.ext
    intro z
    exact P.symm_apply_apply _
  have hP'P : cP' ≫ cP = 𝟙 _ := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    apply ULift.ext
    apply ContinuousMap.ext
    intro z
    exact P.apply_symm_apply _
  have hPs : ∀ c : ℚ_[ℓ], wcConstScalar S ℓ r c ≫ cP = cP ≫ wcConstScalar S ℓ r c := by
    intro c
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    apply ULift.ext
    apply ContinuousMap.ext
    intro z
    exact P.map_smul c _
  let eP : wcContSheaf S (Fin r → ℚ_[ℓ]) ≅ wcContSheaf S (Fin r → ℚ_[ℓ]) := ⟨cP, cP', hPP', hP'P⟩
  let θ : Q.over W ≅ (wcContSheaf S (Fin r → ℚ_[ℓ])).over W := θQ ≪≫ ρ.mapIso eP
  have hθW : ∀ (γ : W ⟶ W) (s : Q.obj.obj (Opposite.op W)) (z : W.left),
      wcContEval S W ((θ.hom.hom.app (Opposite.op (Over.mk γ))).hom s) z =
        P (wcContEval S W ((θQ.hom.hom.app (Opposite.op (Over.mk γ))).hom s) z) :=
    fun γ s z => rfl
  have hθc : ∀ c : ℚ_[ℓ], ρ.map (σQ c) ≫ θ.hom = θ.hom ≫ ρ.map (wcConstScalar S ℓ r c) := by
    intro c
    show ρ.map (σQ c) ≫ θQ.hom ≫ ρ.map cP = (θQ.hom ≫ ρ.map cP) ≫ ρ.map (wcConstScalar S ℓ r c)
    rw [← Category.assoc, hθQ c, Category.assoc, Category.assoc, ← ρ.map_comp, ← ρ.map_comp,
      hPs c]

  have hej : ∀ (j i : Fin r), ‖(Pi.single j (1 : ℚ_[ℓ]) : Fin r → ℚ_[ℓ]) i‖ ≤ 1 := by
    intro j i
    by_cases h : i = j
    · subst h; simp
    · rw [Pi.single_eq_of_ne h]; simp
  have IC : ∀ h ∈ H, ∀ (j i : Fin r), ‖P (h (P.symm (Pi.single j 1))) i‖ ≤ 1 := by
    intro h hh j i
    refine hP h hh (P.symm (Pi.single j 1)) (fun i' => ?_) i
    rw [LinearEquiv.apply_symm_apply]
    exact hej j i'

  have FI : ∀ (γ : W ⟶ W) (M : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      (∀ (s : Q.obj.obj (Opposite.op W)) (z : W.left),
        (show C(↥W.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z =
        M.mulVec ((show C(↥W.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z)) →
      ∀ hγ : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]),
      (∀ (V : S.ProEt) (p q : V ⟶ W), q = p ≫ γ →
        ∀ (x : Q.obj.obj (Opposite.op V)) (z : V.left),
          (show C(↥V.left, Fin r → ℚ_[ℓ]) from
            ((θQ.hom.hom.app (Opposite.op (Over.mk q))).hom x).down) z =
          hγ ((show C(↥V.left, Fin r → ℚ_[ℓ]) from
            ((θQ.hom.hom.app (Opposite.op (Over.mk p))).hom x).down) z)) →
      ∀ u, M.mulVec u = P (hγ (P.symm u)) := by
    intro γ M hM hγ hSF u
    obtain ⟨x, hx⟩ := hconst Q r θQ (P.symm u)
    have e1 : wcContEval S W ((θ.hom.hom.app (Opposite.op (Over.mk γ))).hom x) z₀ =
        M.mulVec (wcContEval S W ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom x) z₀) :=
      hM x z₀
    have e4 : wcContEval S W ((θQ.hom.hom.app (Opposite.op (Over.mk γ))).hom x) z₀ =
        hγ (wcContEval S W ((θQ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom x) z₀) :=
      hSF W (𝟙 W) γ (Category.id_comp γ).symm x z₀
    rw [hθW γ x z₀, hθW (𝟙 W) x z₀, e4, hx z₀, LinearEquiv.apply_symm_apply] at e1
    exact e1.symm
  refine ⟨θ, hθc, ?_, ?_⟩

  · intro γ M hM i j
    obtain ⟨hγ, hSF⟩ := wc_proet_deck_frame_linear S ℓ Q W hW r θQ γ
    have hmem : hγ ∈ H := (hH hγ).mpr ⟨γ, hSF⟩
    have hMij : M i j = P (hγ (P.symm (Pi.single j 1))) i := by
      rw [← FI γ M hM hγ hSF (Pi.single j 1), Matrix.mulVec_single_one]
      rfl
    rw [hMij]
    exact IC hγ hmem j i

  · intro γ γ' hγγ' M hM
    obtain ⟨hγ, hSF⟩ := wc_proet_deck_frame_linear S ℓ Q W hW r θQ γ
    obtain ⟨hγ', hSF'⟩ := wc_proet_deck_frame_linear S ℓ Q W hW r θQ γ'
    have hmem' : hγ' ∈ H := (hH hγ').mpr ⟨γ', hSF'⟩
    have hinv : ∀ v, hγ (hγ' v) = v := by
      intro v
      obtain ⟨x, hx⟩ := hconst Q r θQ v
      have e1 : wcContEval S W ((θQ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom x) z₀ =
          hγ (wcContEval S W ((θQ.hom.hom.app (Opposite.op (Over.mk γ'))).hom x) z₀) :=
        hSF W γ' (𝟙 W) hγγ'.symm x z₀
      have e2 : wcContEval S W ((θQ.hom.hom.app (Opposite.op (Over.mk γ'))).hom x) z₀ =
          hγ' (wcContEval S W ((θQ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom x) z₀) :=
        hSF' W (𝟙 W) γ' (Category.id_comp γ').symm x z₀
      rw [hx z₀] at e1 e2
      rw [e2] at e1
      exact e1.symm
    refine ⟨LinearMap.toMatrix' (P.toLinearMap ∘ₗ hγ' ∘ₗ P.symm.toLinearMap), ?_, ?_⟩
    · apply Matrix.toLin'.injective
      apply LinearMap.ext
      intro u
      rw [Matrix.toLin'_mul, Matrix.toLin'_one]
      show M.mulVec ((LinearMap.toMatrix' (P.toLinearMap ∘ₗ hγ' ∘ₗ P.symm.toLinearMap)).mulVec u) = u
      rw [LinearMap.toMatrix'_mulVec, FI γ M hM hγ hSF]
      show P (hγ (P.symm (P (hγ' (P.symm u))))) = u
      rw [LinearEquiv.symm_apply_apply, hinv, LinearEquiv.apply_symm_apply]
    · intro i j
      rw [LinearMap.toMatrix'_apply]
      show ‖P (hγ' (P.symm (Pi.single j 1))) i‖ ≤ 1
      exact IC hγ' hmem' j i

theorem wc_vqm_galois_frame_exists (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hNI : ∃ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β ∧
      β ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n)) :
    ∃ (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (r : ℕ)
      (θ : (wcPencilVQ D ℓ hP).over W ≅ (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W)
      (φ : W ⟶ W), wcVQGalFrame D ℓ hP W w r θ φ :=
by
  classical
  haveI := D.proper
  haveI hsep : IsSeparated (wcP1Over F'').hom := (inferInstance : IsSeparated (wcProjKStr F'' 1))
  haveI hcomp : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; exact D.proper
  haveI hfp : IsProper D.f := IsProper.of_comp D.f (wcP1Over F'').hom
  haveI hPw : WeaklyEtale (wcGeomPoint F'' (wcP1Over F'') hP).hom := hP

  obtain ⟨Ub, hUb, hconn, hcpt, hqs, hqcι⟩ := wc_P1bar_smooth_locus F'' hP D.m D.S D.hS
  haveI := hqcι
  have hu : WeaklyEtale (Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) := inferInstance
  have htors : ∀ j : ℕ, ∃ (E : Scheme.{u}) (πE : E ⟶ Ub.toScheme),
      IsFinite πE ∧ Etale πE ∧ Surjective πE ∧
      ∃ hE : WeaklyEtale (πE ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom),
      ∃ (b' : ℕ) (e' : Fin b' → ℕ),
        Nonempty ((((wcProEtPush D.f).rightDerived (Nat.unpair j).1).obj
            (wcContSheaf D.Yt.left (ZMod (ℓ ^ (Nat.unpair j).2)))).over
            (MorphismProperty.Over.mk ⊤ (πE ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) hE) ≅
          (wcContSheaf (wcP1Over F'').left ((i : Fin b') → ZMod (ℓ ^ e' i))).over
            (MorphismProperty.Over.mk ⊤ (πE ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) hE)) := by
    intro j
    obtain ⟨N, V, v, het, hcov, hV, b, e, hiso⟩ :=
      wc_pencil_Rq_torsion_etale_locally_const F' F'' Y n D ℓ hℓ hP Ub hUb
        (Nat.unpair j).1 (Nat.unpair j).2
    exact wc_proet_loc_const_finite_fet_trivial (wcP1Over F'').left _ ℓ Ub.toScheme
      (Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) hu hconn hcpt hqs N V v het hcov hV b e hiso
  choose E πE hfin het hsurj hE b' e' hθ using htors

  have hFrIso : IsIso (wcGeomFrob F'' (wcP1Over F'') hP).left := by
    haveI : IsIso (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
        (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
          AlgebraicClosure F'' →+* AlgebraicClosure F'')) :=
      (RingEquiv.toCommRingCatIso (@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
        (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm.toRingEquiv).isIso_hom
    change IsIso (Limits.pullback.map (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))
      (wcP1Over F'').hom (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))
      (𝟙 (wcP1Over F'').left)
      (Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
        (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
          AlgebraicClosure F'' →+* AlgebraicClosure F'')))
      (𝟙 _) (by simp) (by
        rw [Category.comp_id, ← Spec.map_comp]
        congr 1
        ext x
        exact ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _ (Fintype.ofFinite F'')
          (AlgebraicClosure F'') _ _ _).symm.commutes x).symm))
    apply Limits.pullback.map_isIso
  have hFrW : (wcGeomFrob F'' (wcP1Over F'') hP).left ≫
      (wcGeomPoint F'' (wcP1Over F'') hP).hom = (wcGeomPoint F'' (wcP1Over F'') hP).hom :=
    MorphismProperty.Over.w _
  obtain ⟨Fr, hFr⟩ : ∃ Fr : (wcGeomPoint F'' (wcP1Over F'') hP).left ⟶
      (wcGeomPoint F'' (wcP1Over F'') hP).left, Fr = (wcGeomFrob F'' (wcP1Over F'') hP).left :=
    ⟨_, rfl⟩
  rw [← hFr] at hFrIso hFrW
  have hFriW : inv Fr ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom =
      (wcGeomPoint F'' (wcP1Over F'') hP).hom := by
    conv_lhs => rw [← hFrW]
    rw [← Category.assoc, IsIso.inv_hom_id, Category.id_comp]
  have hpres : ∀ g : (wcGeomPoint F'' (wcP1Over F'') hP).left ⟶
      (wcGeomPoint F'' (wcP1Over F'') hP).left,
      g ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom = (wcGeomPoint F'' (wcP1Over F'') hP).hom →
      Ub ≤ g ⁻¹ᵁ Ub := by
    intro g hg x hx
    rw [Scheme.Hom.mem_preimage, hUb]
    intro i
    have h1 := (hUb x).1 hx i
    have h2 : (g ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) x =
        (wcGeomPoint F'' (wcP1Over F'') hP).hom x := by rw [hg]
    rw [Scheme.Hom.comp_apply] at h2
    rw [h2]
    exact h1
  let σ : Ub.toScheme ⟶ Ub.toScheme := Fr.resLE Ub Ub (hpres Fr hFrW)
  let σ' : Ub.toScheme ⟶ Ub.toScheme := (inv Fr).resLE Ub Ub (hpres (inv Fr) hFriW)
  have hσι : σ ≫ Ub.ι = Ub.ι ≫ Fr := Scheme.Hom.resLE_comp_ι _ _
  have hσ'ι : σ' ≫ Ub.ι = Ub.ι ≫ inv Fr := Scheme.Hom.resLE_comp_ι _ _
  have hσσ' : σ ≫ σ' = 𝟙 _ := by
    rw [← cancel_mono Ub.ι, Category.assoc, hσ'ι, ← Category.assoc, hσι, Category.assoc,
      IsIso.hom_inv_id, Category.comp_id, Category.id_comp]
  have hσ'σ : σ' ≫ σ = 𝟙 _ := by
    rw [← cancel_mono Ub.ι, Category.assoc, hσι, ← Category.assoc, hσ'ι, Category.assoc,
      IsIso.inv_hom_id, Category.comp_id, Category.id_comp]

  obtain ⟨W₀, p, hpWE, hpqc, hpsurj, hW₀conn, hW₀cpt, hW₀qs, ht, hgal₀, φ₀, φ₀', hφp, hφφ',
    hφ'φ⟩ := wc_fet_galois_limit_frobenius Ub.toScheme hconn hcpt hqs σ σ' hσσ' hσ'σ E πE hfin
      het hsurj
  choose t ht using ht
  haveI := hpWE
  haveI := hpqc
  have hWE : WeaklyEtale (p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) := inferInstance
  let W : (wcP1Over F'').left.ProEt :=
    MorphismProperty.Over.mk ⊤ (p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) hWE
  let w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP :=
    MorphismProperty.Over.homMk (p ≫ Ub.ι) (Category.assoc _ _ _) trivial
  have hφ'p : φ₀' ≫ p = p ≫ σ' := by
    calc φ₀' ≫ p = φ₀' ≫ p ≫ σ ≫ σ' := by rw [hσσ', Category.comp_id]
      _ = φ₀' ≫ (φ₀ ≫ p) ≫ σ' := by rw [hφp]; simp only [Category.assoc]
      _ = (φ₀' ≫ φ₀) ≫ p ≫ σ' := by simp only [Category.assoc]
      _ = p ≫ σ' := by rw [hφ'φ, Category.id_comp]
  have hφW : φ₀ ≫ p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom =
      p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom := by
    rw [← Category.assoc φ₀, hφp, Category.assoc, ← Category.assoc σ, hσι, Category.assoc, hFrW]
  have hφ'W : φ₀' ≫ p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom =
      p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom := by
    rw [← Category.assoc φ₀', hφ'p, Category.assoc, ← Category.assoc σ', hσ'ι, Category.assoc,
      hFriW]
  let φ : W ⟶ W := MorphismProperty.Over.homMk φ₀ hφW trivial
  let φ' : W ⟶ W := MorphismProperty.Over.homMk φ₀' hφ'W trivial
  have hφ'φW : φ' ≫ φ = 𝟙 W := by
    apply MorphismProperty.Over.Hom.ext
    exact hφ'φ

  let Ej : ℕ → (wcP1Over F'').left.ProEt := fun j =>
    MorphismProperty.Over.mk ⊤ (πE j ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) (hE j)
  let c : ∀ j, W ⟶ Ej j := fun j =>
    MorphismProperty.Over.homMk (t j)
      (show t j ≫ πE j ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom =
          p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom by
        rw [← Category.assoc, ht j]) trivial
  have hres : ∀ q' k : ℕ, ∃ (b : ℕ) (e : Fin b → ℕ),
      Nonempty ((((wcProEtPush D.f).rightDerived q').obj (wcContSheaf D.Yt.left (ZMod (ℓ ^ k)))).over W ≅
        (wcContSheaf (wcP1Over F'').left ((j : Fin b) → ZMod (ℓ ^ e j))).over W) := by
    intro q' k
    have h := hθ (Nat.pair q' k)
    rw [Nat.unpair_pair] at h
    obtain ⟨θ⟩ := h
    exact ⟨b' (Nat.pair q' k), e' (Nat.pair q' k),
      ⟨((Scheme.ProEt.topology (wcP1Over F'').left).overMapPullback AddCommGrpCat.{u+1}
        (c (Nat.pair q' k))).mapIso θ⟩⟩
  obtain ⟨a, b, e, hZ⟩ :=
    wc_proet_Rq_int_const_of_torsion_const D.f ℓ W hW₀conn hW₀cpt hW₀qs hres (n - 1)
  obtain ⟨τ, hτc, hτint⟩ :=
    wc_proet_Rq_rat_triv_integral_frames D.f ℓ W hW₀conn hW₀cpt hW₀qs (n - 1) a b e hZ

  have hR : wcScalarTriv (wcP1Over F'').left ℓ (wcRq D.f ℓ (n - 1)) (wcRqScalar D.f ℓ (n - 1)) W a :=
    ⟨τ, hτc⟩
  choose ψ hψE hψπ using wc_pencil_VQScalar_spec F' F'' Y n D ℓ hP
  have restr : ∀ (G : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}),
      wcPencilGC F'' hP ℓ G → ∃ b : ℕ,
        Nonempty (G.over W ≅ (wcContSheaf (wcP1Over F'').left (Fin b → ℚ_[ℓ])).over W) := by
    intro G hG
    obtain ⟨b, ⟨θ⟩⟩ := hG
    exact ⟨b, ⟨((Scheme.ProEt.topology (wcP1Over F'').left).overMapPullback
      AddCommGrpCat.{u+1} w).mapIso θ⟩⟩
  have hcok : IsIso (wcPencilE D ℓ hP).arrow ∨ ∃ b : ℕ,
      Nonempty ((Limits.cokernel (wcPencilE D ℓ hP).arrow).over W ≅
        (wcContSheaf (wcP1Over F'').left (Fin b → ℚ_[ℓ])).over W) := by
    by_cases h : ∃ M : Subobject (wcRq D.f ℓ (n - 1)), wcPencilStable D ℓ M ∧
        wcPencilGC F'' hP ℓ (Limits.cokernel M.arrow) ∧
        ∀ M' : Subobject (wcRq D.f ℓ (n - 1)), wcPencilStable D ℓ M' →
          wcPencilGC F'' hP ℓ (Limits.cokernel M'.arrow) → M ≤ M'
    · have hE : wcPencilE D ℓ hP = Classical.choose h := dif_pos h
      have hgc : wcPencilGC F'' hP ℓ (Limits.cokernel (wcPencilE D ℓ hP).arrow) := by
        rw [hE]; exact (Classical.choose_spec h).2.1
      exact Or.inr (restr _ hgc)
    · have hE : wcPencilE D ℓ hP = ⊤ := dif_neg h
      left
      rw [hE]
      infer_instance
  obtain ⟨eE, hEW⟩ := wc_scalarTriv_sub_of_coker_const (wcP1Over F'').left ℓ W hW₀conn
    (wcRq D.f ℓ (n - 1)) (Subobject.underlying.obj (wcPencilE D ℓ hP))
    (wcRqScalar D.f ℓ (n - 1)) ψ a hR (wcPencilE D ℓ hP).arrow hψE hcok
  obtain ⟨k, hZ'⟩ := restr _ (wc_pencil_EC_geomConst F' F'' Y n hn hn2 D ℓ hℓ hP)
  obtain ⟨r, θQ, hθQ⟩ := wc_scalarTriv_coker_of_const (wcP1Over F'').left ℓ W hW₀conn
    (Subobject.underlying.obj (wcPencilE D ℓ hP))
    (Subobject.underlying.obj (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP)) ψ eE hEW k hZ'
    ((wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP).ofLE (wcPencilE D ℓ hP) inf_le_left)
    (wcPencilVQScalar D ℓ hP) hψπ
  obtain ⟨θE, -⟩ := hEW

  obtain ⟨θ, hθc, hint, hinv⟩ := wc_frame_integral_transport (wcP1Over F'').left ℓ W hW₀conn
    (wcRq D.f ℓ (n - 1)) (Subobject.underlying.obj (wcPencilE D ℓ hP)) (wcPencilVQ D ℓ hP)
    (wcPencilE D ℓ hP).arrow
    (Limits.cokernel.π ((wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP).ofLE (wcPencilE D ℓ hP)
      inf_le_left))
    inferInstance Limits.coequalizer.π_epi (wcPencilVQScalar D ℓ hP) a eE r τ θE θQ hθQ hτint

  refine ⟨W, w, r, θ, φ, ?_⟩
  unfold wcVQGalFrame
  refine ⟨hθc, ?_, hW₀conn, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · show QuasiCompact (p ≫ Ub.ι)
    infer_instance
  · intro z i
    have hy : Ub.ι (p z) ∈ Ub := by
      have hr : Ub.ι (p z) ∈ Set.range Ub.ι := ⟨p z, rfl⟩
      rw [Scheme.Opens.range_ι] at hr
      exact hr
    exact (hUb (Ub.ι (p z))).1 hy i
  · intro x hx
    have hxU : x ∈ Ub := (hUb x).2 hx
    obtain ⟨y, hy⟩ : x ∈ Set.range Ub.ι := by rw [Scheme.Opens.range_ι]; exact hxU
    obtain ⟨z, hz⟩ := hpsurj.surj y
    refine ⟨z, ?_⟩
    show (p ≫ Ub.ι) z = x
    rw [Scheme.Hom.comp_apply, hz, hy]
  · intro V a' b'' hV hab
    have h1 : a'.left ≫ p ≫ Ub.ι = b''.left ≫ p ≫ Ub.ι := by
      have := congrArg (fun f => f.left) hab
      exact this
    have h2' : (a'.left ≫ p) ≫ Ub.ι = (b''.left ≫ p) ≫ Ub.ι := by
      have e1 := Category.assoc a'.left p Ub.ι
      have e2 := Category.assoc b''.left p Ub.ι
      exact e1.trans (h1.trans e2.symm)
    have h2 : a'.left ≫ p = b''.left ≫ p := (cancel_mono Ub.ι).1 h2'
    obtain ⟨γ₀, hγp, hγb⟩ := hgal₀ V.left a'.left b''.left hV h2
    let γ : W ⟶ W := MorphismProperty.Over.homMk γ₀
      (show γ₀ ≫ p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom =
          p ≫ Ub.ι ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom by
        rw [← Category.assoc, hγp]) trivial
    refine ⟨γ, ?_, ?_⟩
    · apply MorphismProperty.Over.Hom.ext
      show γ₀ ≫ p ≫ Ub.ι = p ≫ Ub.ι
      rw [← Category.assoc, hγp]
    · apply MorphismProperty.Over.Hom.ext
      show b''.left = a'.left ≫ γ₀
      exact hγb
  · apply MorphismProperty.Over.Hom.ext
    show φ₀ ≫ p ≫ Ub.ι = (p ≫ Ub.ι) ≫ (wcGeomFrob F'' (wcP1Over F'') hP).left
    rw [← hFr, ← Category.assoc φ₀, hφp, Category.assoc, hσι, Category.assoc]
  · intro δ hδ
    let δ₀ : W₀ ⟶ W₀ := δ.left
    have hδ1 : δ₀ ≫ p ≫ Ub.ι = p ≫ Ub.ι := congrArg (fun f => f.left) hδ
    have hδp : δ₀ ≫ p = p := by
      apply (cancel_mono Ub.ι).1
      exact (Category.assoc δ₀ p Ub.ι).trans hδ1
    refine ⟨φ ≫ δ ≫ φ', ?_, ?_⟩
    · apply MorphismProperty.Over.Hom.ext
      change (φ₀ ≫ δ₀ ≫ φ₀') ≫ p ≫ Ub.ι = p ≫ Ub.ι
      have e1 : (φ₀ ≫ δ₀ ≫ φ₀') ≫ p = p := by
        calc (φ₀ ≫ δ₀ ≫ φ₀') ≫ p = φ₀ ≫ δ₀ ≫ (φ₀' ≫ p) := by
              simp only [Category.assoc]
          _ = φ₀ ≫ (δ₀ ≫ p) ≫ σ' := by rw [hφ'p]; simp only [Category.assoc]
          _ = (φ₀ ≫ p) ≫ σ' := by rw [hδp, Category.assoc]
          _ = p ≫ (σ ≫ σ') := by rw [hφp, Category.assoc]
          _ = p := by rw [hσσ', Category.comp_id]
      rw [← Category.assoc, e1]
    · apply MorphismProperty.Over.Hom.ext
      change (φ₀ ≫ δ₀ ≫ φ₀') ≫ φ₀ = φ₀ ≫ δ₀
      rw [Category.assoc, Category.assoc, hφ'φ, Category.comp_id]
  · intro γ g _ hg
    exact hint γ g hg
  · intro g hg
    exact ⟨hint φ g hg, hinv φ φ' hφ'φW g hg⟩

theorem wc_vqm_frame_group (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (r : ℕ)
    (θ : (wcPencilVQ D ℓ hP).over W ≅ (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W)
    (φ : W ⟶ W) (hB : wcVQGalFrame D ℓ hP W w r θ φ) :
    ∃ (Γ : Subgroup (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) (Φ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ),
      wcVQFrame D ℓ hP W r θ φ (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]) ∧
      (∀ h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ, h ∈ Γ ↔
        ∃ γ : W ⟶ W, γ ≫ w = w ∧ wcVQFrame D ℓ hP W r θ γ (h : Matrix (Fin r) (Fin r) ℚ_[ℓ])) ∧
      (∀ h ∈ Γ, Φ * h * Φ⁻¹ ∈ Γ ∧ Φ⁻¹ * h * Φ ∈ Γ) ∧
      (∀ h ∈ Γ, ∀ a b, ‖(h : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ 1) ∧
      (∀ a b, ‖(Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ 1) ∧
      (∀ a b, ‖((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ 1) :=
by
  classical
  obtain ⟨_, _, hconn, _, _, hgal, hφw, hrev, hdint, hφint⟩ := hB
  obtain ⟨z₀⟩ := @ConnectedSpace.toNonempty _ _ hconn

  have hsurj : ∀ v : Fin r → ℚ_[ℓ], ∃ x : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op W),
      ∀ z : W.left, (show C(↥W.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom x).down) z = v := by
    intro v
    have key : ∀ y, (θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom
        ((θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom y) = y := by
      intro y
      change ((θ.inv ≫ θ.hom).hom.app (Opposite.op (Over.mk (𝟙 W)))).hom y = y
      rw [θ.inv_hom_id]
      rfl
    refine ⟨(θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom
      (ULift.up (ContinuousMap.const ↥W.left v)), ?_⟩
    intro z
    erw [key]
    rfl

  choose A hA using fun γ : W ⟶ W =>
    wc_proet_deck_frame_linear (wcP1Over F'').left ℓ (wcPencilVQ D ℓ hP) W hconn r θ γ
  have hex : ∀ γ : W ⟶ W, wcVQFrame D ℓ hP W r θ γ (LinearMap.toMatrix' (A γ)) := by
    intro γ s z
    rw [LinearMap.toMatrix'_mulVec]
    exact hA γ W (𝟙 W) γ (Category.id_comp γ).symm s z
  have hval : ∀ (γ : W ⟶ W) (g : Matrix (Fin r) (Fin r) ℚ_[ℓ]), wcVQFrame D ℓ hP W r θ γ g →
      ∀ v, g.mulVec v = A γ v := by
    intro γ g hg v
    obtain ⟨x, hx⟩ := hsurj v
    have h1 := hg x z₀
    have h2 := hA γ W (𝟙 W) γ (Category.id_comp γ).symm x z₀
    rw [hx] at h1 h2
    exact h1.symm.trans h2
  have huniq : ∀ (γ : W ⟶ W) (g g' : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      wcVQFrame D ℓ hP W r θ γ g → wcVQFrame D ℓ hP W r θ γ g' → g = g' := by
    intro γ g g' hg hg'
    apply Matrix.toLin'.injective
    refine LinearMap.ext fun v => ?_
    rw [Matrix.toLin'_apply, Matrix.toLin'_apply, hval γ g hg v, hval γ g' hg' v]
  have hcomp : ∀ (a b : W ⟶ W) (g g' : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      wcVQFrame D ℓ hP W r θ a g → wcVQFrame D ℓ hP W r θ b g' →
      wcVQFrame D ℓ hP W r θ (a ≫ b) (g' * g) := by
    intro a b g g' hg hg' s z
    refine (hA b W a (a ≫ b) rfl s z).trans ?_
    rw [← hval b g' hg', hg s z, Matrix.mulVec_mulVec]
  have h1 : wcVQFrame D ℓ hP W r θ (𝟙 W) 1 := fun s z => (Matrix.one_mulVec _).symm

  let Γ : Subgroup (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ :=
    { carrier := {h | ∃ γ : W ⟶ W, γ ≫ w = w ∧
        wcVQFrame D ℓ hP W r θ γ (h : Matrix (Fin r) (Fin r) ℚ_[ℓ])}
      mul_mem' := by
        rintro h₁ h₂ ⟨a₁, ha₁, hf₁⟩ ⟨a₂, ha₂, hf₂⟩
        refine ⟨a₂ ≫ a₁, by rw [Category.assoc, ha₁, ha₂], ?_⟩
        rw [Units.val_mul]
        exact hcomp a₂ a₁ _ _ hf₂ hf₁
      one_mem' := ⟨𝟙 W, Category.id_comp w, by rw [Units.val_one]; exact h1⟩
      inv_mem' := by
        rintro h ⟨a, ha, hf⟩
        obtain ⟨a', ha', he⟩ := hgal W a (𝟙 W) hconn (by rw [ha, Category.id_comp])
        refine ⟨a', ha', ?_⟩
        have hc := hcomp a a' _ _ hf (hex a')
        rw [← he] at hc
        have h1' := huniq _ _ _ hc h1
        rw [Units.inv_eq_of_mul_eq_one_left h1']
        exact hex a' }
  obtain ⟨hgint, g', hgg', hg'int⟩ := hφint _ (hex φ)
  have hg'g : g' * LinearMap.toMatrix' (A φ) = 1 := mul_eq_one_comm.mp hgg'
  let Φ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ := ⟨LinearMap.toMatrix' (A φ), g', hgg', hg'g⟩
  refine ⟨Γ, Φ, hex φ, fun h => Iff.rfl, ?_, ?_, hgint, hg'int⟩
  · intro h hh
    obtain ⟨a, ha, hf⟩ := hh
    constructor
    · have e : (a ≫ φ) ≫ w = φ ≫ w := by
        rw [Category.assoc, hφw, ← Category.assoc, ha]
      obtain ⟨d, hd, hde⟩ := hgal W φ (a ≫ φ) hconn e.symm
      have c1 := hcomp a φ _ _ hf (hex φ)
      have c2 := hcomp φ d _ _ (hex φ) (hex d)
      rw [hde] at c1
      have key := huniq _ _ _ c1 c2
      refine ⟨d, hd, ?_⟩
      have hv : ((Φ * h * Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
          Matrix (Fin r) (Fin r) ℚ_[ℓ]) = LinearMap.toMatrix' (A d) := by
        rw [Units.val_mul, Units.val_mul]
        change LinearMap.toMatrix' (A φ) * (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]) * g' = _
        rw [key, Matrix.mul_assoc, hgg', Matrix.mul_one]
      rw [hv]
      exact hex d
    · obtain ⟨a'', ha'', he''⟩ := hrev a ha
      have c1 := hcomp a'' φ _ _ (hex a'') (hex φ)
      have c2 := hcomp φ a _ _ (hex φ) hf
      rw [he''] at c1
      have key := huniq _ _ _ c1 c2
      refine ⟨a'', ha'', ?_⟩
      have hv : ((Φ⁻¹ * h * Φ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
          Matrix (Fin r) (Fin r) ℚ_[ℓ]) = LinearMap.toMatrix' (A a'') := by
        rw [Units.val_mul, Units.val_mul]
        change g' * (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]) * LinearMap.toMatrix' (A φ) = _
        rw [Matrix.mul_assoc, ← key, ← Matrix.mul_assoc, hg'g, Matrix.one_mul]
      rw [hv]
      exact hex a''
  · intro h hh
    obtain ⟨a, ha, hf⟩ := hh
    exact hdint a _ ha hf

theorem wc_proet_openRestr_over_hom_zero (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (O : S.Opens) (B : S.ProEt)
    (E : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (hgen : ∀ (T : S.ProEt) (x : T.left),
      ∃ y : (wcOpenRestr S O T).left, (wcOpenRestrIncl S O T).left y ⤳ x)
    (hext : ∀ (T : S.ProEt) (g : C((wcOpenRestr S O T).left, ℚ_[ℓ])),
      ∃ G : C(T.left, ℚ_[ℓ]), ∀ y : (wcOpenRestr S O T).left,
        G ((wcOpenRestrIncl S O T).left y) = g y)
    (hE : ∀ φ : E.over B ⟶ (wcContSheaf S ℚ_[ℓ]).over B, φ = 0) :
    ∀ φ : E.over (wcOpenRestr S O B) ⟶ (wcContSheaf S ℚ_[ℓ]).over (wcOpenRestr S O B), φ = 0 :=
by
  intro φ

  have huniq : ∀ (T : S.ProEt) (G G' : C(T.left, ℚ_[ℓ])),
      (∀ y : (wcOpenRestr S O T).left,
        G ((wcOpenRestrIncl S O T).left y) = G' ((wcOpenRestrIncl S O T).left y)) → G = G' := by
    intro T G G' h
    apply ContinuousMap.ext
    intro x
    obtain ⟨y, hy⟩ := hgen T x
    rw [← (hy.map G.continuous).eq, ← (hy.map G'.continuous).eq]
    exact h y

  have hcancel : ∀ (T V : S.ProEt) (f g : V ⟶ wcOpenRestr S O T),
      f ≫ wcOpenRestrIncl S O T = g ≫ wcOpenRestrIncl S O T → f = g := by
    intro T V f g h
    apply MorphismProperty.Over.Hom.ext
    have h1 : f.left ≫ (wcOpenRestrIncl S O T).left = g.left ≫ (wcOpenRestrIncl S O T).left :=
      congrArg (fun k => k.left) h
    haveI : Mono (wcOpenRestrIncl S O T).left := by
      show Mono (Limits.pullback.snd O.ι T.hom)
      exact IsOpenImmersion.mono _
    exact (cancel_mono _).mp h1

  have hresex : ∀ (T T' : S.ProEt) (a : T' ⟶ T), ∃ a' : wcOpenRestr S O T' ⟶ wcOpenRestr S O T,
      a' ≫ wcOpenRestrIncl S O T = wcOpenRestrIncl S O T' ≫ a := by
    intro T T' a
    have w : Limits.pullback.fst O.ι T'.hom ≫ O.ι =
        (Limits.pullback.snd O.ι T'.hom ≫ a.left) ≫ T.hom := by
      rw [Limits.pullback.condition, Category.assoc, MorphismProperty.Over.w a]
    refine ⟨MorphismProperty.Over.homMk (Limits.pullback.lift _ _ w) ?_ trivial, ?_⟩
    · show Limits.pullback.lift _ _ w ≫ Limits.pullback.snd O.ι T.hom ≫ T.hom =
        Limits.pullback.snd O.ι T'.hom ≫ T'.hom
      rw [Limits.pullback.lift_snd_assoc, Category.assoc, MorphismProperty.Over.w a]
    · apply MorphismProperty.Over.Hom.ext
      show Limits.pullback.lift _ _ w ≫ Limits.pullback.snd O.ι T.hom =
        Limits.pullback.snd O.ι T'.hom ≫ a.left
      exact Limits.pullback.lift_snd _ _ _

  have hsec : ∀ (V : S.ProEt) (t : V ⟶ wcOpenRestr S O B), ∃ σ : V ⟶ wcOpenRestr S O V,
      σ ≫ wcOpenRestrIncl S O V = 𝟙 V := by
    intro V t
    let tl : V.left ⟶ Limits.pullback O.ι B.hom := t.left
    have ht : tl ≫ Limits.pullback.snd O.ι B.hom ≫ B.hom = V.hom := MorphismProperty.Over.w t
    have w : (tl ≫ Limits.pullback.fst O.ι B.hom) ≫ O.ι = 𝟙 V.left ≫ V.hom := by
      rw [Category.assoc, Limits.pullback.condition, Category.id_comp]
      exact ht
    refine ⟨MorphismProperty.Over.homMk (Limits.pullback.lift _ _ w) ?_ trivial, ?_⟩
    · show Limits.pullback.lift _ _ w ≫ Limits.pullback.snd O.ι V.hom ≫ V.hom = V.hom
      rw [Limits.pullback.lift_snd_assoc, Category.id_comp]
    · apply MorphismProperty.Over.Hom.ext
      show Limits.pullback.lift _ _ w ≫ Limits.pullback.snd O.ι V.hom = 𝟙 V.left
      exact Limits.pullback.lift_snd _ _ _

  let Φ : ∀ (V : S.ProEt) (h : V ⟶ wcOpenRestr S O B),
      E.obj.obj (Opposite.op V) →+ C(V.left, ℚ_[ℓ]) :=
    fun V h => AddEquiv.ulift.toAddMonoidHom.comp (φ.hom.app (Opposite.op (Over.mk h))).hom
  have hΦnat : ∀ (V V' : S.ProEt) (h : V ⟶ wcOpenRestr S O B) (a : V' ⟶ V)
      (z : E.obj.obj (Opposite.op V)) (y : V'.left),
      Φ V' (a ≫ h) ((E.obj.map a.op).hom z) y = Φ V h z (a.left y) := by
    intro V V' h a z y
    have h1 := congrArg ULift.down (congrArg (fun f => AddCommGrpCat.Hom.hom f z)
      (φ.hom.naturality (Over.homMk a rfl : Over.mk (a ≫ h) ⟶ Over.mk h).op))
    exact congrArg (fun u : C(V'.left, ℚ_[ℓ]) => u y) h1
  have hdet : (∀ (V : S.ProEt) (h : V ⟶ wcOpenRestr S O B) (z : E.obj.obj (Opposite.op V)),
      Φ V h z = 0) → φ = 0 := by
    intro H
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext X
    apply AddCommGrpCat.ext
    intro x
    apply ULift.ext
    apply ContinuousMap.ext
    intro y
    have h1 := congrArg (fun u : C(X.unop.left.left, ℚ_[ℓ]) => u y) (H X.unop.left X.unop.hom x)
    first
      | exact h1
      | (simp only [Sheaf.instPreadditive, NatTrans.app_zero] at h1 ⊢; exact h1)
      | simpa using h1

  choose res hres using hresex
  have hP : ∀ (V V' : S.ProEt) (h : V ⟶ B) (a : V' ⟶ V),
      res V V' a ≫ res B V h = res B V' (a ≫ h) := by
    intro V V' h a
    apply hcancel B
    rw [Category.assoc, hres B V h, ← Category.assoc, hres V V' a, Category.assoc,
      hres B V' (a ≫ h)]

  let g : ∀ (V : S.ProEt) (h : V ⟶ B),
      E.obj.obj (Opposite.op V) →+ C((wcOpenRestr S O V).left, ℚ_[ℓ]) :=
    fun V h => (Φ (wcOpenRestr S O V) (res B V h)).comp
      (E.obj.map (wcOpenRestrIncl S O V).op).hom
  choose Fx hFx using fun (V : S.ProEt) (h : V ⟶ B) (z : E.obj.obj (Opposite.op V)) =>
    hext V (g V h z)
  have hFxadd : ∀ (V : S.ProEt) (h : V ⟶ B) (z₁ z₂ : E.obj.obj (Opposite.op V)),
      Fx V h (z₁ + z₂) = Fx V h z₁ + Fx V h z₂ := by
    intro V h z₁ z₂
    apply huniq V
    intro y
    simp only [hFx, ContinuousMap.add_apply, map_add]
  have hFxnat : ∀ (V V' : S.ProEt) (h : V ⟶ B) (a : V' ⟶ V) (z : E.obj.obj (Opposite.op V))
      (y : V'.left), Fx V' (a ≫ h) ((E.obj.map a.op).hom z) y = Fx V h z (a.left y) := by
    intro V V' h a z y
    have hE1 : (E.obj.map (res V V' a).op).hom ((E.obj.map (wcOpenRestrIncl S O V).op).hom z) =
        (E.obj.map (wcOpenRestrIncl S O V').op).hom ((E.obj.map a.op).hom z) := by
      have e1 : E.obj.map (wcOpenRestrIncl S O V).op ≫ E.obj.map (res V V' a).op =
          E.obj.map a.op ≫ E.obj.map (wcOpenRestrIncl S O V').op := by
        rw [← Functor.map_comp, ← Functor.map_comp, ← op_comp, ← op_comp, hres]
      exact congrArg (fun f => AddCommGrpCat.Hom.hom f z) e1
    have key : Fx V' (a ≫ h) ((E.obj.map a.op).hom z) =
        (Fx V h z).comp ⟨fun p => a.left p, Scheme.Hom.continuous a.left⟩ := by
      apply huniq V'
      intro y₀
      have hpt : a.left ((wcOpenRestrIncl S O V').left y₀) =
          (wcOpenRestrIncl S O V).left ((res V V' a).left y₀) := by
        have h2 : (res V V' a).left ≫ (wcOpenRestrIncl S O V).left =
            (wcOpenRestrIncl S O V').left ≫ a.left := congrArg (fun k => k.left) (hres V V' a)
        rw [← Scheme.Hom.comp_apply (wcOpenRestrIncl S O V').left a.left,
          ← Scheme.Hom.comp_apply (res V V' a).left (wcOpenRestrIncl S O V).left, h2]
      rw [hFx]
      show g V' (a ≫ h) ((E.obj.map a.op).hom z) y₀ =
        Fx V h z (a.left ((wcOpenRestrIncl S O V').left y₀))
      rw [hpt, hFx]
      show Φ (wcOpenRestr S O V') (res B V' (a ≫ h))
          ((E.obj.map (wcOpenRestrIncl S O V').op).hom ((E.obj.map a.op).hom z)) y₀ =
        Φ (wcOpenRestr S O V) (res B V h) ((E.obj.map (wcOpenRestrIncl S O V).op).hom z)
          ((res V V' a).left y₀)
      rw [← hP V V' h a, ← hE1, hΦnat]
    exact DFunLike.congr_fun key y

  let ψ : E.over B ⟶ (wcContSheaf S ℚ_[ℓ]).over B := ObjectProperty.homMk
    { app := fun X => AddCommGrpCat.ofHom (AddEquiv.ulift.symm.toAddMonoidHom.comp
        (AddMonoidHom.mk' (Fx X.unop.left X.unop.hom) (hFxadd X.unop.left X.unop.hom)))
      naturality := by
        intro X Y f
        apply AddCommGrpCat.ext
        intro z
        apply ULift.ext
        apply ContinuousMap.ext
        intro y
        have h1 := hFxnat X.unop.left Y.unop.left X.unop.hom f.unop.left z y
        rw [Over.w f.unop] at h1
        exact h1 }
  have hF0 : ∀ (V : S.ProEt) (h : V ⟶ B) (z : E.obj.obj (Opposite.op V)), Fx V h z = 0 := by
    intro V h z
    have h0 : ψ = 0 := hE ψ
    apply ContinuousMap.ext
    intro y
    have h1 := congrArg (fun k : E.over B ⟶ (wcContSheaf S ℚ_[ℓ]).over B =>
      (@DFunLike.coe C(V.left, ℚ_[ℓ]) _ _ _
        ((AddCommGrpCat.Hom.hom (k.hom.app (Opposite.op (Over.mk h)))) z).down y)) h0
    first
      | exact h1
      | (simp only [Sheaf.instPreadditive, NatTrans.app_zero] at h1 ⊢; exact h1)
      | simpa using h1
  have hg0 : ∀ (V : S.ProEt) (h : V ⟶ B) (z : E.obj.obj (Opposite.op V))
      (y : (wcOpenRestr S O V).left), g V h z y = 0 := by
    intro V h z y
    rw [← hFx V h z y, hF0 V h z, ContinuousMap.zero_apply]

  apply hdet
  intro V k z
  obtain ⟨σ, hσ⟩ := hsec V k
  have hσk : σ ≫ res B V (k ≫ wcOpenRestrIncl S O B) = k := by
    apply hcancel B
    rw [Category.assoc, hres B V (k ≫ wcOpenRestrIncl S O B), ← Category.assoc, hσ,
      Category.id_comp]
  have hz : (E.obj.map σ.op).hom ((E.obj.map (wcOpenRestrIncl S O V).op).hom z) = z := by
    have e1 : E.obj.map (wcOpenRestrIncl S O V).op ≫ E.obj.map σ.op = 𝟙 _ := by
      rw [← CategoryTheory.Functor.map_comp, ← op_comp, hσ, op_id, CategoryTheory.Functor.map_id]
    exact congrArg (fun f => AddCommGrpCat.Hom.hom f z) e1
  apply ContinuousMap.ext
  intro y
  rw [← hσk, ← hz, hΦnat, ContinuousMap.zero_apply]
  exact hg0 V (k ≫ wcOpenRestrIncl S O B) z (σ.left y)

theorem wc_P1_proet_open_local_clopen (K : Type u) [Field K] (O : (wcP1Over K).left.Opens)
    (Zs : Finset (wcP1Over K).left) (hZ : ∀ z ∈ Zs, IsClosed ({z} : Set (wcP1Over K).left))
    (hO : (O : Set (wcP1Over K).left) = ((Zs : Set (wcP1Over K).left))ᶜ) :
    ∀ (T : (wcP1Over K).left.ProEt) (t : T.left),
      ∃ U : Set T.left, IsOpen U ∧ t ∈ U ∧
        ∀ C : Set (wcOpenRestr (wcP1Over K).left O T).left,
          C ⊆ (wcOpenRestrIncl (wcP1Over K).left O T).left ⁻¹' U → IsOpen C →
          IsOpen ((wcOpenRestrIncl (wcP1Over K).left O T).left ⁻¹' U \ C) →
          ∃ W : Set T.left, W ⊆ U ∧ IsOpen W ∧ IsOpen (U \ W) ∧
            (wcOpenRestrIncl (wcP1Over K).left O T).left ⁻¹' W = C :=
by
  classical

  have wc_weaklyEtale_normal_idem : ∀ (D C : Type u) [CommRing D] [IsDomain D] [IsIntegrallyClosed D] [CommRing C] [Algebra D C], Algebra.WeaklyEtale D C → ∀ (c : C) (s : D), s ≠ 0 → c * c = s • c → ∃ c' : C, c = s • c' := by
    have s1 : ∀ (D : Type u) [CommRing D] [IsDomain D] [IsIntegrallyClosed D] (s d : D), s ≠ 0 →
        (∀ B : ValuationSubring (FractionRing D), (∀ e : D, algebraMap D (FractionRing D) e ∈ B) →
          algebraMap D (FractionRing D) d / algebraMap D (FractionRing D) s ∈ B) →
        ∃ d' : D, d = s * d' := by
      intro D _ _ _ s d hs hB
      have hαinj : Function.Injective (algebraMap D (FractionRing D)) :=
        IsFractionRing.injective D (FractionRing D)
      have hαs : algebraMap D (FractionRing D) s ≠ 0 := fun h => hs (hαinj (by rw [h, map_zero]))
      set x : FractionRing D := algebraMap D (FractionRing D) d / algebraMap D (FractionRing D) s
        with hxdef
      by_cases hint : IsIntegral D x
      · obtain ⟨y, hy⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral hint
        refine ⟨y, hαinj ?_⟩
        rw [map_mul, hy, hxdef, mul_div_cancel₀ _ hαs]
      · exfalso
        have hx0 : x ≠ 0 := by
          intro h; apply hint; rw [h]; exact isIntegral_zero
        set y : FractionRing D := x⁻¹ with hydef
        have hy0 : y ≠ 0 := inv_ne_zero hx0
        have hxy : y * x = 1 := inv_mul_cancel₀ hx0
        have hnotin : x ∉ Algebra.adjoin D {y} := by
          intro hxmem
          apply hint
          rw [Algebra.adjoin_singleton_eq_range_aeval] at hxmem
          obtain ⟨g, hg⟩ := hxmem
          letI : Invertible y := invertibleOfNonzero hy0
          have h1 := Polynomial.eval₂_reflect_mul_pow (algebraMap D (FractionRing D)) y
            g.natDegree g le_rfl
          have hinv : (⅟y : FractionRing D) = x := by rw [invOf_eq_inv, hydef, inv_inv]
          have hg' : Polynomial.eval₂ (algebraMap D (FractionRing D)) y g = x := by
            rw [← Polynomial.aeval_def]; exact hg
          rw [hinv, hg'] at h1
          have h2 : Polynomial.eval₂ (algebraMap D (FractionRing D)) x
              (Polynomial.reflect g.natDegree g) = x ^ (g.natDegree + 1) := by
            have h3 : Polynomial.eval₂ (algebraMap D (FractionRing D)) x
                (Polynomial.reflect g.natDegree g) * y ^ g.natDegree * x ^ g.natDegree =
                x * x ^ g.natDegree := by rw [h1]
            rw [mul_assoc, ← mul_pow, hxy, one_pow, mul_one] at h3
            rw [h3, pow_succ, mul_comm]
          refine ⟨Polynomial.X ^ (g.natDegree + 1) - Polynomial.reflect g.natDegree g, ?_, ?_⟩
          · apply Polynomial.monic_X_pow_sub
            have hnd : (Polynomial.reflect g.natDegree g).natDegree ≤ g.natDegree :=
              Polynomial.natDegree_reflect_le.trans (max_self _).le
            exact (Polynomial.degree_le_of_natDegree_le hnd).trans_lt
              (by exact_mod_cast Nat.lt_succ_self _)
          · rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, h2, sub_self]
        let A : Subring (FractionRing D) := (Algebra.adjoin D {y}).toSubring
        have hyA : y ∈ A := Algebra.subset_adjoin (Set.mem_singleton y)
        let y' : A := ⟨y, hyA⟩
        have hnu : ¬ IsUnit y' := by
          intro hu
          obtain ⟨z, hz⟩ := isUnit_iff_exists_inv.mp hu
          have hz' : y * (z : FractionRing D) = 1 := congrArg Subtype.val hz
          have hzx : (z : FractionRing D) = x := by
            calc (z : FractionRing D) = (y * x) * (z : FractionRing D) := by rw [hxy, one_mul]
              _ = x * (y * (z : FractionRing D)) := by ring
              _ = x := by rw [hz', mul_one]
          exact hnotin (hzx ▸ z.2)
        have hspan : Ideal.span {y'} ≠ ⊤ := fun h => hnu (Ideal.span_singleton_eq_top.mp h)
        obtain ⟨M, hM, hyM⟩ := Ideal.exists_le_maximal _ hspan
        haveI := hM.isPrime
        obtain ⟨B, hLB⟩ := LocalSubring.exists_le_valuationSubring (LocalSubring.ofPrime A M)
        obtain ⟨hle, hloc⟩ := LocalSubring.le_def.mp hLB
        have hAL := LocalSubring.le_ofPrime A M
        have hAB : ∀ z ∈ A, z ∈ B := fun z hz => hle (hAL hz)
        have hxB : x ∈ B := hB B (fun e => hAB _ (Subalgebra.algebraMap_mem _ e))
        have hyL : y ∈ (LocalSubring.ofPrime A M).toSubring := hAL hyA
        have hyBu : IsUnit (Subring.inclusion hle ⟨y, hyL⟩) := by
          refine isUnit_iff_exists_inv.mpr ⟨⟨x, hxB⟩, ?_⟩
          apply Subtype.ext
          exact hxy
        have hyLu := hloc.map_nonunit _ hyBu
        obtain ⟨b, hb⟩ := isUnit_iff_exists_inv.mp hyLu
        have hb' : y * (b : FractionRing D) = 1 := congrArg Subtype.val hb
        have hg : ∀ z : M.primeCompl, IsUnit (A.subtype (z : A)) := by
          intro z
          apply IsUnit.mk0
          intro h0
          apply z.2
          have : (z : A) = 0 := Subtype.ext h0
          rw [this]
          exact M.zero_mem
        let f : Localization.AtPrime M →+* FractionRing D :=
          IsLocalization.lift (M := M.primeCompl) (S := Localization.AtPrime M) hg
        have hbr : (b : FractionRing D) ∈ f.range := b.2
        obtain ⟨w, hw⟩ := hbr
        have hfa : f (algebraMap A (Localization.AtPrime M) y') = y := IsLocalization.lift_eq hg y'
        have ha : algebraMap A (Localization.AtPrime M) y' ∈
            IsLocalRing.maximalIdeal (Localization.AtPrime M) :=
          (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime M) M y').mpr
            (hyM (Ideal.mem_span_singleton_self y'))
        have haw := Ideal.mul_mem_right w _ ha
        have hu : IsUnit (1 - algebraMap A (Localization.AtPrime M) y' * w) :=
          (IsLocalRing.isUnit_or_isUnit_one_sub_self _).resolve_left
            ((IsLocalRing.mem_maximalIdeal _).mp haw)
        have hf0 : f (1 - algebraMap A (Localization.AtPrime M) y' * w) = 0 := by
          rw [map_sub, map_one, map_mul, hfa, hw, hb', sub_self]
        exact (hu.map f).ne_zero hf0
    have s2 : ∀ (ι : Type u) (V : ι → Type u) [∀ i, CommRing (V i)] [∀ i, IsDomain (V i)]
        (N : Type u) [AddCommGroup N] [Module (∀ i, V i) N], (∀ i (a b : V i), a ∣ b ∨ b ∣ a) →
        (∀ g : (∀ i, V i), (∀ i, g i ≠ 0) → ∀ n : N, g • n = 0 → n = 0) →
        Module.Flat (∀ i, V i) N := by
      intro ι V _ _ N _ _ htot htf
      apply Module.Flat.of_forall_isTrivialRelation
      intro l f x hfx
      rcases Nat.eq_zero_or_pos l with hl | hl
      · subst hl
        exact ⟨0, fun i => Fin.elim0 i, fun j => Fin.elim0 j, fun i => Fin.elim0 i,
          fun j => Fin.elim0 j⟩
      have hpiv : ∀ v : ι, ∃ m : Fin l, ∀ j, f m v ∣ f j v := by
        intro v
        have key : ∀ S : Finset (Fin l), S.Nonempty → ∃ m ∈ S, ∀ j ∈ S, f m v ∣ f j v := by
          intro S hS
          induction hS using Finset.Nonempty.cons_induction with
          | singleton a =>
            exact ⟨a, Finset.mem_singleton_self a, fun j hj => by rw [Finset.mem_singleton.mp hj]⟩
          | cons a S haS hS ih =>
            obtain ⟨m, hmS, hm⟩ := ih
            rcases htot v (f m v) (f a v) with h | h
            · refine ⟨m, Finset.mem_cons_of_mem hmS, fun j hj => ?_⟩
              rcases Finset.mem_cons.mp hj with rfl | hj
              · exact h
              · exact hm j hj
            · refine ⟨a, Finset.mem_cons_self a S, fun j hj => ?_⟩
              rcases Finset.mem_cons.mp hj with rfl | hj
              · exact dvd_rfl
              · exact h.trans (hm j hj)
        obtain ⟨m, _, hm⟩ := key Finset.univ ⟨⟨0, hl⟩, Finset.mem_univ _⟩
        exact ⟨m, fun j => hm j (Finset.mem_univ j)⟩
      choose m hm using hpiv
      choose cc hcc using hm
      let hh : (∀ i, V i) := fun v => if f (m v) v = 0 then 1 else f (m v) v
      let β : Fin l → (∀ i, V i) := fun j v => if f (m v) v = 0 then 0 else cc v j
      let e : Fin l → (∀ i, V i) := fun j v => if m v = j then 1 else 0
      have hz : ∀ v j, f (m v) v = 0 → f j v = 0 := by
        intro v j h0
        rw [hcc v j, h0, zero_mul]
      have F1 : ∀ j, hh * β j = f j := by
        intro j; funext v
        simp only [Pi.mul_apply, hh, β]
        split_ifs with h0
        · rw [mul_zero, hz v j h0]
        · rw [hcc v j]
      have F2 : ∑ k, f k * e k = fun v => f (m v) v := by
        funext v
        rw [Finset.sum_apply]
        simp [e]
      have F3 : ∀ j, (∑ k, f k * e k) * β j = f j := by
        intro j; rw [F2]; funext v
        simp only [Pi.mul_apply, β]
        split_ifs with h0
        · rw [mul_zero, hz v j h0]
        · rw [hcc v j]
      have hhne : ∀ v, hh v ≠ 0 := by
        intro v; simp only [hh]; split_ifs with h0
        · exact one_ne_zero
        · exact h0
      have hβx : ∑ j, β j • x j = 0 := by
        apply htf hh hhne
        rw [Finset.smul_sum]
        simp_rw [smul_smul, F1]
        exact hfx
      refine ⟨l, fun i j => (if i = j then 1 else 0) - e i * β j, x, fun i => ?_, fun j => ?_⟩
      · have : ∑ j, ((if i = j then 1 else 0) - e i * β j) • x j = x i - e i • ∑ j, β j • x j := by
          simp_rw [sub_smul, Finset.sum_sub_distrib, ite_smul, one_smul, zero_smul,
            Finset.sum_ite_eq, Finset.mem_univ, if_true, mul_smul, Finset.smul_sum]
        rw [this, hβx, smul_zero, sub_zero]
      · have h1 : ∑ i, f i * ((if i = j then 1 else 0) - e i * β j) =
            f j - (∑ k, f k * e k) * β j := by
          simp_rw [mul_sub, Finset.sum_sub_distrib, mul_ite, mul_one, mul_zero,
            Finset.sum_ite_eq', Finset.mem_univ, if_true, Finset.sum_mul, mul_assoc]
        rw [h1, F3, sub_self]
    have wc_flat_quot_absorb : ∀ (R : Type u) [CommRing R] (I : Ideal R),
        Module.Flat R (R ⧸ I) → ∀ x ∈ I, ∃ z ∈ I, x * z = x := by
      intro R _ I hflat x hx
      have hrel : ∑ i : Fin 1, (fun _ => x) i • (fun _ => (1 : R ⧸ I)) i = 0 := by
        rw [Fin.sum_univ_one]
        show x • (1 : R ⧸ I) = 0
        rw [Algebra.smul_def, Ideal.Quotient.algebraMap_eq, mul_one,
          Ideal.Quotient.eq_zero_iff_mem]
        exact hx
      obtain ⟨k, a, y, h1, h2⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero hrel
      choose b hb using fun j => Ideal.Quotient.mk_surjective (I := I) (y j)
      set w : R := ∑ j, a 0 j * b j with hw
      have h10 : (1 : R ⧸ I) = ∑ j, a 0 j • y j := h1 0
      have hmk : Ideal.Quotient.mk I w = 1 := by
        rw [hw, map_sum, h10]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [map_mul, hb j, Algebra.smul_def, Ideal.Quotient.algebraMap_eq]
      have hxw : x * w = 0 := by
        rw [hw, Finset.mul_sum]
        refine Finset.sum_eq_zero (fun j _ => ?_)
        have := h2 j
        rw [Fin.sum_univ_one] at this
        rw [← mul_assoc, this, zero_mul]
      refine ⟨1 - w, ?_, ?_⟩
      · rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_one, hmk, sub_self]
      · rw [mul_sub, mul_one, hxw, sub_zero]
    have s3 : ∀ (P' W' : Type u) [CommRing P'] [CommRing W'] [Algebra P' W'],
        Algebra.WeaklyEtale P' W' → ∀ γ' : W', ∃ ω : TensorProduct P' W' W',
          Algebra.TensorProduct.lmul' P' ω = 1 ∧
            (γ' ⊗ₜ[P'] (1 : W')) * ω = ((1 : W') ⊗ₜ[P'] γ') * ω := by
      intro P' W' _ _ _ hWE γ'
      have hμsurj : Function.Surjective (Algebra.TensorProduct.lmul' P' (S := W')) := fun b =>
        ⟨b ⊗ₜ[P'] (1 : W'), by rw [Algebra.TensorProduct.lmul'_apply_tmul, mul_one]⟩
      have hflatQ : Module.Flat (TensorProduct P' W' W')
          (TensorProduct P' W' W' ⧸ RingHom.ker (Algebra.TensorProduct.lmul' P' (S := W')).toRingHom) := by
        let e := RingHom.quotientKerEquivOfSurjective
          (f := (Algebra.TensorProduct.lmul' P' (S := W')).toRingHom) hμsurj
        have h1 : ((Algebra.TensorProduct.lmul' P' (S := W')).toRingHom).Flat := hWE.flat_lmul'
        have h2 : (e.symm.toRingHom.comp (Algebra.TensorProduct.lmul' P' (S := W')).toRingHom).Flat :=
          RingHom.Flat.comp h1 (RingHom.Flat.of_bijective (f := e.symm.toRingHom) e.symm.bijective)
        have h3 : e.symm.toRingHom.comp (Algebra.TensorProduct.lmul' P' (S := W')).toRingHom =
            algebraMap _ (TensorProduct P' W' W' ⧸
              RingHom.ker (Algebra.TensorProduct.lmul' P' (S := W')).toRingHom) := by
          refine RingHom.ext fun x => ?_
          rw [Ideal.Quotient.algebraMap_eq]
          show e.symm (Algebra.TensorProduct.lmul' P' (S := W') x) = Ideal.Quotient.mk _ x
          rw [e.symm_apply_eq]
          rfl
        rw [h3, RingHom.flat_algebraMap_iff] at h2
        exact h2
      have hx : γ' ⊗ₜ[P'] (1 : W') - (1 : W') ⊗ₜ[P'] γ' ∈
          RingHom.ker (Algebra.TensorProduct.lmul' P' (S := W')).toRingHom := by
        rw [RingHom.mem_ker]
        show Algebra.TensorProduct.lmul' P' (S := W') (γ' ⊗ₜ[P'] (1 : W') - (1 : W') ⊗ₜ[P'] γ') = 0
        rw [map_sub, Algebra.TensorProduct.lmul'_apply_tmul, Algebra.TensorProduct.lmul'_apply_tmul,
          mul_one, one_mul, sub_self]
      obtain ⟨z, hz, hxz⟩ := wc_flat_quot_absorb _ _ hflatQ _ hx
      have hz0 : Algebra.TensorProduct.lmul' P' (S := W') z = 0 := RingHom.mem_ker.mp hz
      refine ⟨1 - z, ?_, ?_⟩
      · rw [map_sub, map_one, hz0, sub_zero]
      · rw [← sub_eq_zero, ← sub_mul, mul_sub, mul_one, hxz, sub_self]
    have s4 : ∀ (P W : Type u) [CommRing P] [CommRing W] [Algebra P W], Module.Flat P W →
        ∀ t ∈ nonZeroDivisors P, ∀ (γ : W) (ω : TensorProduct P W W), γ * γ = t • γ →
        Algebra.TensorProduct.lmul' P ω = 1 → (γ ⊗ₜ[P] (1 : W)) * ω = ((1 : W) ⊗ₜ[P] γ) * ω →
        Module.Flat P ↥((Ideal.span {algebraMap P W t, γ} : Ideal W).restrictScalars P) →
        ∃ w : W, γ = t • w := by
      intro P W _ _ _ hWf t ht γ ω hγ hω1 hω2 hIf
      set τ := algebraMap P W t with hτ
      have hsmul : ∀ x : W, t • x = τ * x := fun x => Algebra.smul_def t x
      have hreg : ∀ x : W, τ * x = 0 → x = 0 := by
        intro x hx
        have h := Module.Flat.isSMulRegular_of_nonZeroDivisors (M := W) ht
        apply h
        show t • x = t • 0
        rw [smul_zero, hsmul, hx]
      have hγ' : γ * γ = τ * γ := by rw [hγ, hsmul]
      set I : Ideal W := Ideal.span {τ, γ} with hI
      have hτI : τ ∈ I := Ideal.subset_span (Set.mem_insert _ _)
      have hγI : γ ∈ I := Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
      let IP : Submodule P W := I.restrictScalars P
      haveI : Module.Flat P IP := hIf
      let gA : W → IP := fun a => ⟨γ * a, Ideal.mul_mem_right a I hγI⟩
      let tA : W → IP := fun a => ⟨τ * a, Ideal.mul_mem_right a I hτI⟩
      obtain ⟨S, hS⟩ := TensorProduct.exists_finset ω
      have B1 : ∑ i ∈ S, i.1 * i.2 = 1 := by
        have h := hω1
        rw [hS, map_sum] at h
        simpa only [Algebra.TensorProduct.lmul'_apply_tmul] using h
      have B2 : ∑ i ∈ S, (γ * i.1) ⊗ₜ[P] i.2 = ∑ i ∈ S, i.1 ⊗ₜ[P] (γ * i.2) := by
        have h := hω2
        rw [hS, Finset.mul_sum, Finset.mul_sum] at h
        simpa only [Algebra.TensorProduct.tmul_mul_tmul, one_mul] using h
      let X : TensorProduct P IP IP := ∑ i ∈ S, (gA i.1 ⊗ₜ[P] tA i.2 - tA i.1 ⊗ₜ[P] gA i.2)
      have hXimg : TensorProduct.map IP.subtype IP.subtype X =
          t • (∑ i ∈ S, (γ * i.1) ⊗ₜ[P] i.2 - ∑ i ∈ S, i.1 ⊗ₜ[P] (γ * i.2)) := by
        rw [smul_sub, Finset.smul_sum, Finset.smul_sum, ← Finset.sum_sub_distrib]
        simp only [X, map_sum, map_sub, TensorProduct.map_tmul]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        show (γ * i.1) ⊗ₜ[P] (τ * i.2) - (τ * i.1) ⊗ₜ[P] (γ * i.2) = _
        rw [← hsmul, ← hsmul, TensorProduct.tmul_smul, TensorProduct.smul_tmul',
          TensorProduct.smul_tmul']
      rw [B2, sub_self, smul_zero] at hXimg
      have hinj : Function.Injective (TensorProduct.map IP.subtype IP.subtype) := by
        have h1 : Function.Injective (LinearMap.lTensor IP IP.subtype) :=
          Module.Flat.lTensor_preserves_injective_linearMap _ IP.injective_subtype
        have h2 : Function.Injective (LinearMap.rTensor W IP.subtype) :=
          Module.Flat.rTensor_preserves_injective_linearMap _ IP.injective_subtype
        rw [← LinearMap.rTensor_comp_lTensor, LinearMap.coe_comp]
        exact h2.comp h1
      have hX0 : X = 0 := hinj (by rw [hXimg, map_zero])
      have hc : ∀ x : IP, ∃ c : W, τ * c * γ = γ * (x : W) := by
        intro x
        obtain ⟨u, v, huv⟩ := Ideal.mem_span_pair.mp x.2
        refine ⟨u + v, ?_⟩
        rw [← huv]
        linear_combination (-v) * hγ'
      choose c hcspec using hc
      let J : Submodule P W := (Ideal.span {τ} : Ideal W).restrictScalars P
      have hind : ∀ d : W, τ * d * γ = 0 → ∀ y : IP, d * (y : W) ∈ J := by
        intro d hd y
        have hdγ : d * γ = 0 := hreg _ (by rw [← mul_assoc]; exact hd)
        obtain ⟨u, v, huv⟩ := Ideal.mem_span_pair.mp y.2
        show d * (y : W) ∈ Ideal.span {τ}
        rw [← huv, Ideal.mem_span_singleton']
        exact ⟨d * u, by linear_combination (-v) * hdγ⟩
      let Φ : IP →ₗ[P] IP →ₗ[P] (W ⧸ J) := LinearMap.mk₂ P (fun x y => J.mkQ (c x * (y : W)))
        (fun x₁ x₂ y => by
          rw [← map_add, ← add_mul, ← sub_eq_zero, ← map_sub, ← sub_mul, Submodule.mkQ_apply,
            Submodule.Quotient.mk_eq_zero]
          apply hind
          have h1 := hcspec (x₁ + x₂)
          have h2 := hcspec x₁
          have h3 := hcspec x₂
          rw [Submodule.coe_add] at h1
          linear_combination h1 - h2 - h3)
        (fun p x y => by
          rw [← map_smul, ← sub_eq_zero, ← map_sub, Submodule.mkQ_apply,
            Submodule.Quotient.mk_eq_zero, ← smul_mul_assoc, ← sub_mul]
          apply hind
          have h1 := hcspec (p • x)
          have h2 := hcspec x
          rw [Submodule.coe_smul, Algebra.smul_def] at h1
          rw [Algebra.smul_def]
          linear_combination h1 - (algebraMap P W p) * h2)
        (fun x y₁ y₂ => by rw [Submodule.coe_add, mul_add, map_add])
        (fun p x y => by rw [Submodule.coe_smul, mul_smul_comm, map_smul])
      have hterm1 : ∀ i : W × W, J.mkQ (c (gA i.1) * (τ * i.2)) = 0 := by
        intro i
        rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
        show _ ∈ Ideal.span {τ}
        exact Ideal.mem_span_singleton'.mpr ⟨c (gA i.1) * i.2, by ring⟩
      have hterm2 : ∀ i : W × W, c (tA i.1) * (γ * i.2) = γ * (i.1 * i.2) := by
        intro i
        have h := hcspec (tA i.1)
        have h' : c (tA i.1) * γ = i.1 * γ := by
          apply sub_eq_zero.mp
          apply hreg
          have h2 : τ * c (tA i.1) * γ = γ * (τ * i.1) := h
          linear_combination h2
        calc c (tA i.1) * (γ * i.2) = (c (tA i.1) * γ) * i.2 := by ring
          _ = γ * (i.1 * i.2) := by rw [h']; ring
      have hΦX : TensorProduct.lift Φ X = - J.mkQ γ := by
        simp only [X, map_sum, map_sub, TensorProduct.lift.tmul]
        have hterm : ∀ i ∈ S, Φ (gA i.1) (tA i.2) - Φ (tA i.1) (gA i.2) =
            - J.mkQ (γ * (i.1 * i.2)) := by
          intro i _
          show J.mkQ (c (gA i.1) * (τ * i.2)) - J.mkQ (c (tA i.1) * (γ * i.2)) = _
          rw [hterm1 i, hterm2 i, zero_sub]
        rw [Finset.sum_congr rfl hterm, Finset.sum_neg_distrib, ← map_sum, ← Finset.mul_sum, B1,
          mul_one]
      rw [hX0, map_zero, eq_comm, neg_eq_zero, Submodule.mkQ_apply,
        Submodule.Quotient.mk_eq_zero] at hΦX
      obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp hΦX
      exact ⟨w, by rw [hsmul, mul_comm, hw]⟩
    have s5 : ∀ (D C P : Type u) [CommRing D] [CommRing C] [Algebra D C] [CommRing P] [Algebra D P],
        Module.Flat D C → ∀ s : D, (∀ (d : D) (p : P), algebraMap D P d = s • p → ∃ d' : D, d = s * d') →
        ∀ (c : C) (w : TensorProduct D P C), s • w = (1 : P) ⊗ₜ[D] c → ∃ c' : C, c = s • c' := by
      intro D C P _ _ _ _ _ hC s hpure c w hw
      let I : Ideal D := Ideal.span {s}
      have hmemI : ∀ (M : Type u) [AddCommGroup M] [Module D M] (x : M),
          x ∈ I • (⊤ : Submodule D M) → ∃ m : M, x = s • m := by
        intro M _ _ x hx
        refine Submodule.smul_induction_on (p := fun x => ∃ m : M, x = s • m) hx ?_ ?_
        · intro r hr n _
          obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hr
          exact ⟨a • n, by rw [smul_smul, mul_comm]⟩
        · intro x y hx hy
          obtain ⟨m₁, rfl⟩ := hx
          obtain ⟨m₂, rfl⟩ := hy
          exact ⟨m₁ + m₂, by rw [smul_add]⟩
      let N : Submodule D P := I • (⊤ : Submodule D P)
      have hsN : ∀ p : P, s • p ∈ N := fun p =>
        Submodule.smul_mem_smul (Ideal.mem_span_singleton_self s) Submodule.mem_top
      have hle : I ≤ N.comap (Algebra.linearMap D P) := by
        intro x hx
        rw [Submodule.mem_comap, Algebra.linearMap_apply, Algebra.algebraMap_eq_smul_one]
        exact Submodule.smul_mem_smul hx Submodule.mem_top
      let f : (D ⧸ I) →ₗ[D] (P ⧸ N) := Submodule.mapQ I N (Algebra.linearMap D P) hle
      have hf : Function.Injective f := by
        rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
        intro x hx
        obtain ⟨d, rfl⟩ := Submodule.Quotient.mk_surjective _ x
        rw [LinearMap.mem_ker, Submodule.mapQ_apply, Submodule.Quotient.mk_eq_zero,
          Algebra.linearMap_apply] at hx
        obtain ⟨p, hp⟩ := hmemI P _ hx
        obtain ⟨d', hd'⟩ := hpure d p hp
        rw [Submodule.Quotient.mk_eq_zero]
        exact Ideal.mem_span_singleton'.mpr ⟨d', by rw [hd', mul_comm]⟩
      have hinj := Module.Flat.rTensor_preserves_injective_linearMap (M := C) f hf
      let q := LinearMap.rTensor C N.mkQ
      have hkill : ∀ z : TensorProduct D (P ⧸ N) C, s • z = 0 := by
        intro z
        induction z using TensorProduct.induction_on with
        | zero => rw [smul_zero]
        | tmul x c₀ =>
          obtain ⟨p, rfl⟩ := Submodule.Quotient.mk_surjective _ x
          rw [TensorProduct.smul_tmul', ← Submodule.Quotient.mk_smul,
            (Submodule.Quotient.mk_eq_zero N).mpr (hsN p), TensorProduct.zero_tmul]
        | add x y hx hy => rw [smul_add, hx, hy, add_zero]
      have h1 : LinearMap.rTensor C f (Submodule.Quotient.mk (1 : D) ⊗ₜ[D] c) = 0 := by
        rw [LinearMap.rTensor_tmul, Submodule.mapQ_apply, Algebra.linearMap_apply, map_one]
        have : q ((1 : P) ⊗ₜ[D] c) = 0 := by
          rw [← hw, map_smul, hkill]
        exact this
      have h2 : (Submodule.Quotient.mk (1 : D) : D ⧸ I) ⊗ₜ[D] c = 0 :=
        hinj (by rw [h1, map_zero])
      have h3 := congrArg (TensorProduct.quotTensorEquivQuotSMul C I) h2
      rw [map_zero] at h3
      have h4 : (TensorProduct.quotTensorEquivQuotSMul C I)
          ((Ideal.Quotient.mk I (1 : D)) ⊗ₜ[D] c) = 0 := h3
      rw [TensorProduct.quotTensorEquivQuotSMul_mk_tmul, one_smul,
        Submodule.Quotient.mk_eq_zero] at h4
      obtain ⟨c', hc'⟩ := hmemI C c h4
      exact ⟨c', hc'⟩
    intro D C _ _ _ _ _ hW c s hs hc
    haveI := hW
    have hαinj : Function.Injective (algebraMap D (FractionRing D)) :=
      IsFractionRing.injective D (FractionRing D)
    have hαs : algebraMap D (FractionRing D) s ≠ 0 := fun h => hs (hαinj (by rw [h, map_zero]))
    let ι := {B : ValuationSubring (FractionRing D) // ∀ e : D, algebraMap D (FractionRing D) e ∈ B}
    letI : Algebra D (∀ i : ι, ↥(i.1)) :=
      (RingHom.pi (fun i : ι => (algebraMap D (FractionRing D)).codRestrict i.1 i.2)).toAlgebra
    have hcomp : ∀ (d : D) (i : ι),
        ((algebraMap D (∀ i : ι, ↥(i.1)) d i : ↥(i.1)) : FractionRing D) =
          algebraMap D (FractionRing D) d := fun d i => rfl
    have hnzd : ∀ g : (∀ i : ι, ↥(i.1)), (∀ i, g i ≠ 0) → g ∈ nonZeroDivisors (∀ i : ι, ↥(i.1)) := by
      intro g hg
      rw [mem_nonZeroDivisors_iff]
      constructor
      · intro x hx
        funext i
        have := congrFun hx i
        rw [Pi.mul_apply, Pi.zero_apply] at this
        exact (mul_eq_zero.mp this).resolve_left (hg i)
      · intro x hx
        funext i
        have := congrFun hx i
        rw [Pi.mul_apply, Pi.zero_apply] at this
        exact (mul_eq_zero.mp this).resolve_right (hg i)
    have hpure : ∀ (d : D) (p : ∀ i : ι, ↥(i.1)),
        algebraMap D (∀ i : ι, ↥(i.1)) d = s • p → ∃ d' : D, d = s * d' := by
      intro d p hdp
      apply s1 D s d hs
      intro B hB
      rw [Algebra.smul_def] at hdp
      have h1 : algebraMap D (FractionRing D) d =
          algebraMap D (FractionRing D) s * ((p ⟨B, hB⟩ : ↥B) : FractionRing D) :=
        congrArg (fun q : (∀ i : ι, ↥(i.1)) => ((q ⟨B, hB⟩ : ↥B) : FractionRing D)) hdp
      rw [h1, mul_div_cancel_left₀ _ hαs]
      exact (p ⟨B, hB⟩).2
    have ht : algebraMap D (∀ i : ι, ↥(i.1)) s ∈ nonZeroDivisors (∀ i : ι, ↥(i.1)) := by
      apply hnzd
      intro i h
      apply hαs
      rw [← hcomp s i, h]
      rfl
    let W := TensorProduct D (∀ i : ι, ↥(i.1)) C
    let γ : W := (1 : ∀ i : ι, ↥(i.1)) ⊗ₜ[D] c
    have hγ : γ * γ = algebraMap D (∀ i : ι, ↥(i.1)) s • γ := by
      simp only [γ]
      rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, hc, TensorProduct.tmul_smul, algebraMap_smul]
    obtain ⟨ω, hω1, hω2⟩ := s3 (∀ i : ι, ↥(i.1)) W inferInstance γ
    have hIflat : Module.Flat (∀ i : ι, ↥(i.1))
        ↥((Ideal.span {algebraMap (∀ i : ι, ↥(i.1)) W (algebraMap D (∀ i : ι, ↥(i.1)) s), γ} :
          Ideal W).restrictScalars (∀ i : ι, ↥(i.1))) := by
      refine s2 ι (fun i : ι => ↥(i.1))
        ↥((Ideal.span {algebraMap (∀ i : ι, ↥(i.1)) W (algebraMap D (∀ i : ι, ↥(i.1)) s), γ} :
          Ideal W).restrictScalars (∀ i : ι, ↥(i.1))) ?_ ?_
      · intro i a b
        exact ValuationRing.dvd_total a b
      · intro g hg n hn
        have hreg := Module.Flat.isSMulRegular_of_nonZeroDivisors (M := W) (hnzd g hg)
        apply Subtype.ext
        apply hreg
        have := congrArg Subtype.val hn
        simpa using this
    obtain ⟨w, hw⟩ := s4 (∀ i : ι, ↥(i.1)) W inferInstance
      (algebraMap D (∀ i : ι, ↥(i.1)) s) ht γ ω hγ hω1 hω2 hIflat
    have hsw : s • w = (1 : ∀ i : ι, ↥(i.1)) ⊗ₜ[D] c := by
      rw [← algebraMap_smul (∀ i : ι, ↥(i.1)) s w]
      exact hw.symm
    exact s5 D C (∀ i : ι, ↥(i.1)) hW.flat s hpure c w hsw

  have wc_weaklyEtale_away_idem_lift : ∀ (D C : Type u) [CommRing D] [IsDomain D] [CommRing C]
      [Algebra D C] (hW : Algebra.WeaklyEtale D C)
      (hnorm : ∀ (c : C) (s : D), s ≠ 0 → c * c = s • c → ∃ c' : C, c = s • c')
      (π : D) (hπ : π ≠ 0),
      ∀ e : Localization.Away (algebraMap D C π), IsIdempotentElem e →
        ∃ c : C, IsIdempotentElem c ∧ algebraMap C (Localization.Away (algebraMap D C π)) c = e := by
    intro D C _ _ _ _ hW hnorm π hπ e he
    have : Module.Flat D C := hW.flat
    have REG : ∀ (m : ℕ) (x y : C), algebraMap D C π ^ m * x = algebraMap D C π ^ m * y →
        x = y := by
      intro m x y hxy
      have hreg : IsSMulRegular C (π ^ m) :=
        Module.Flat.isSMulRegular_of_nonZeroDivisors
          (mem_nonZeroDivisors_of_ne_zero (pow_ne_zero m hπ))
      apply hreg
      simp only [Algebra.smul_def, map_pow]
      exact hxy
    obtain ⟨n, a, E1⟩ := IsLocalization.Away.surj (algebraMap D C π) e
    have he' : e * e = e := he
    have s3 : algebraMap C (Localization.Away (algebraMap D C π)) (a * a) =
        algebraMap C (Localization.Away (algebraMap D C π)) (algebraMap D C π ^ n * a) := by
      rw [map_mul, map_mul, map_pow, ← E1]
      linear_combination
        (algebraMap C (Localization.Away (algebraMap D C π)) (algebraMap D C π) ^ n) ^ 2 * he'
    obtain ⟨⟨c, hc⟩, hc'⟩ := (IsLocalization.eq_iff_exists (Submonoid.powers (algebraMap D C π))
      (Localization.Away (algebraMap D C π))).mp s3
    obtain ⟨k, rfl⟩ := (Submonoid.mem_powers_iff c (algebraMap D C π)).mp hc
    have s5 : a * a = algebraMap D C π ^ n * a := REG k _ _ hc'
    have s5' : a * a = (π ^ n) • a := by rw [Algebra.smul_def, map_pow]; exact s5
    obtain ⟨c', E2⟩ := hnorm a (π ^ n) (pow_ne_zero n hπ) s5'
    have E2' : a = algebraMap D C π ^ n * c' := by rw [E2, Algebra.smul_def, map_pow]
    refine ⟨c', ?_, ?_⟩
    · show c' * c' = c'
      apply REG (n + n)
      have h1 : algebraMap D C π ^ (n + n) * (c' * c') = a * a := by rw [E2']; ring
      rw [h1, s5, E2']
      ring
    · have hu : IsUnit (algebraMap C (Localization.Away (algebraMap D C π)) (algebraMap D C π) ^ n) :=
        IsLocalization.Away.algebraMap_pow_isUnit (algebraMap D C π) n
      apply hu.mul_right_cancel
      rw [E1, E2', map_mul, map_pow]
      ring

  have L5 : ∀ {X Y Z : Type u} [TopologicalSpace X] [TopologicalSpace Y] [TopologicalSpace Z]
      (ι : Y → X) (hι : Topology.IsOpenEmbedding ι) (F : Z → X) (hF : Topology.IsOpenEmbedding F)
      (H : ∀ Cl : Set Z, Cl ⊆ F ⁻¹' Set.range ι → IsOpen Cl → IsOpen (F ⁻¹' Set.range ι \ Cl) →
        ∃ W' : Set Z, IsOpen W' ∧ IsOpen W'ᶜ ∧ W' ∩ F ⁻¹' Set.range ι = Cl),
      ∀ C : Set Y, C ⊆ ι ⁻¹' Set.range F → IsOpen C → IsOpen (ι ⁻¹' Set.range F \ C) →
        ∃ W : Set X, W ⊆ Set.range F ∧ IsOpen W ∧ IsOpen (Set.range F \ W) ∧ ι ⁻¹' W = C := by
    intro X Y Z _ _ _ ι hι F hF H C hC hCo hCc
    have hιi := hι.isEmbedding.injective
    have hFi := hF.isEmbedding.injective
    have hdiff : F ⁻¹' Set.range ι \ F ⁻¹' (ι '' C) = F ⁻¹' (ι '' (ι ⁻¹' Set.range F \ C)) := by
      ext z
      constructor
      · rintro ⟨⟨y, hy⟩, hn⟩
        exact ⟨y, ⟨⟨z, hy.symm⟩, fun hc => hn ⟨y, hc, hy⟩⟩, hy⟩
      · rintro ⟨y, ⟨_, hyC⟩, hy⟩
        refine ⟨⟨y, hy⟩, ?_⟩
        rintro ⟨c, hc, hc'⟩
        exact hyC (hιi (hc'.trans hy.symm) ▸ hc)
    obtain ⟨W', hW'o, hW'c, hW'⟩ := H (F ⁻¹' (ι '' C))
      (fun z hz => by obtain ⟨c, _, hc⟩ := hz; exact ⟨c, hc⟩)
      ((hι.isOpenMap C hCo).preimage hF.continuous)
      (by rw [hdiff]; exact (hι.isOpenMap _ hCc).preimage hF.continuous)
    refine ⟨F '' W', Set.image_subset_range _ _, hF.isOpenMap _ hW'o, ?_, ?_⟩
    · rw [Set.range_diff_image hFi]; exact hF.isOpenMap _ hW'c
    · ext y
      constructor
      · rintro ⟨z, hz, hzy⟩
        have hz' : z ∈ W' ∩ F ⁻¹' Set.range ι := ⟨hz, y, hzy.symm⟩
        rw [hW'] at hz'
        obtain ⟨c, hc, hc'⟩ := hz'
        rw [← hιi (hc'.trans hzy)]; exact hc
      · intro hy
        obtain ⟨z, hz⟩ := hC hy
        have : z ∈ W' ∩ F ⁻¹' Set.range ι := by rw [hW']; exact ⟨y, hy, hz.symm⟩
        exact ⟨z, this.1, hz⟩

  have L3 : ∀ (C : Type u) [CommRing C] (ψ : Polynomial K →+* C),
      @Algebra.WeaklyEtale (Polynomial K) C _ _ ψ.toAlgebra → ∀ (s : Polynomial K), s ≠ 0 →
      ∀ (B : Set (PrimeSpectrum C)), (∀ x, x ∈ B ↔ x ∈ PrimeSpectrum.basicOpen (ψ s)) →
      ∀ Cl : Set (PrimeSpectrum C), Cl ⊆ B → IsOpen Cl → IsOpen (B \ Cl) →
      ∃ W' : Set (PrimeSpectrum C), IsOpen W' ∧ IsOpen W'ᶜ ∧ W' ∩ B = Cl := by
    intro C _ ψ hW s hs B hB Cl hCl hCo hCc
    letI : Algebra (Polynomial K) C := ψ.toAlgebra
    have hBeq : B = (PrimeSpectrum.basicOpen (algebraMap (Polynomial K) C s) : Set _) :=
      Set.ext hB
    subst hBeq
    have hlift := wc_weaklyEtale_away_idem_lift (Polynomial K) C hW
      (wc_weaklyEtale_normal_idem (Polynomial K) C hW) s hs
    set σ := algebraMap (Polynomial K) C s with hσ
    let c₀ := PrimeSpectrum.comap (algebraMap C (Localization.Away σ))
    have hrange : Set.range c₀ = PrimeSpectrum.basicOpen σ :=
      PrimeSpectrum.localization_away_comap_range (Localization.Away σ) σ
    have hc₀ : Continuous c₀ := PrimeSpectrum.continuous_comap _
    have hclo : IsClopen (c₀ ⁻¹' Cl) := by
      refine ⟨?_, hCo.preimage hc₀⟩
      rw [← isOpen_compl_iff]
      have : (c₀ ⁻¹' Cl)ᶜ = c₀ ⁻¹' ((PrimeSpectrum.basicOpen σ : Set _) \ Cl) := by
        ext q
        simp only [Set.mem_compl_iff, Set.mem_preimage, Set.mem_diff]
        constructor
        · intro h; exact ⟨hrange ▸ Set.mem_range_self q, h⟩
        · exact fun h => h.2
      rw [this]; exact hCc.preimage hc₀
    obtain ⟨ε, hε, hεeq⟩ := PrimeSpectrum.exists_idempotent_basicOpen_eq_of_isClopen hclo
    obtain ⟨c, hc, hcε⟩ := hlift ε hε
    have hmem : ∀ q : PrimeSpectrum (Localization.Away σ),
        c₀ q ∈ (PrimeSpectrum.basicOpen c : Set _) ↔ q ∈ (PrimeSpectrum.basicOpen ε : Set _) := by
      intro q
      simp only [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen, c₀, PrimeSpectrum.comap_asIdeal,
        Ideal.mem_comap, hcε]
    have heq : (PrimeSpectrum.basicOpen c : Set (PrimeSpectrum C)) ∩
        PrimeSpectrum.basicOpen σ = Cl := by
      ext p
      constructor
      · rintro ⟨hpc, hpσ⟩
        rw [← hrange] at hpσ
        obtain ⟨q, rfl⟩ := hpσ
        have : q ∈ c₀ ⁻¹' Cl := by rw [hεeq]; exact (hmem q).mp hpc
        exact this
      · intro hp
        have hpσ := hCl hp
        refine ⟨?_, hpσ⟩
        have hpσ' : p ∈ Set.range c₀ := by rw [hrange]; exact hpσ
        obtain ⟨q, rfl⟩ := hpσ'
        have : q ∈ (PrimeSpectrum.basicOpen ε : Set _) := by rw [← hεeq]; exact hp
        exact (hmem q).mpr this
    refine ⟨PrimeSpectrum.basicOpen c, PrimeSpectrum.isOpen_basicOpen, ?_, heq⟩
    have h0 : c * (1 - c) = 0 := by rw [mul_sub, mul_one, hc.eq, sub_self]
    exact (PrimeSpectrum.isClopen_basicOpen_of_mul_add c (1 - c) h0 (by ring)).compl.isOpen

  have L2 : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsPrincipalIdealRing R], ¬ IsField R →
      ∀ {X : Type u} [TopologicalSpace X] (f : PrimeSpectrum R → X), Function.Injective f →
      Continuous f → ∀ (Zs : Finset X), (∀ z ∈ Zs, IsClosed ({z} : Set X)) →
      ∃ s : R, s ≠ 0 ∧ ∀ y : PrimeSpectrum R, f y ∉ Zs ↔ y ∈ PrimeSpectrum.basicOpen s := by
    intro R _ _ _ hR X _ f hinj hc Zs hZ
    have hfin : (f ⁻¹' (Zs : Set X)).Finite := Zs.finite_toSet.preimage hinj.injOn
    set Z := hfin.toFinset with hZdef
    have hmax : ∀ q ∈ Z, q.asIdeal.IsMaximal := by
      intro q hq
      rw [Set.Finite.mem_toFinset] at hq
      rw [← PrimeSpectrum.isClosed_singleton_iff_isMaximal]
      have : ({q} : Set (PrimeSpectrum R)) = f ⁻¹' {f q} := by
        ext y
        simp only [Set.mem_singleton_iff, Set.mem_preimage]
        exact ⟨fun h => h ▸ rfl, fun h => hinj h⟩
      rw [this]
      exact (hZ _ hq).preimage hc
    let g : PrimeSpectrum R → R := fun q => Submodule.IsPrincipal.generator q.asIdeal
    have hg : ∀ q : PrimeSpectrum R, Ideal.span {g q} = q.asIdeal := fun q =>
      Submodule.IsPrincipal.span_singleton_generator q.asIdeal
    have hg0 : ∀ q ∈ Z, g q ≠ 0 := by
      intro q hq h
      have := hg q
      rw [h, Ideal.span_singleton_eq_bot.mpr rfl] at this
      exact Ring.ne_bot_of_isMaximal_of_not_isField (hmax q hq) hR this.symm
    refine ⟨∏ q ∈ Z, g q, Finset.prod_ne_zero_iff.mpr hg0, ?_⟩
    intro y
    have hyp : y.asIdeal.IsPrime := y.isPrime
    rw [PrimeSpectrum.mem_basicOpen, Ideal.IsPrime.prod_mem_iff]
    simp only [not_exists, not_and]
    constructor
    · intro hy q hq hgq
      have hle : q.asIdeal ≤ y.asIdeal := by
        rw [← hg q]; exact (Ideal.span_singleton_le_iff_mem _).mpr hgq
      have heq : q = y := PrimeSpectrum.ext ((hmax q hq).eq_of_le hyp.ne_top hle)
      rw [Set.Finite.mem_toFinset] at hq
      exact hy (heq ▸ hq)
    · intro h hy
      have hyZ : y ∈ Z := by rw [Set.Finite.mem_toFinset]; exact hy
      apply h y hyZ
      rw [← Ideal.span_singleton_le_iff_mem, hg]

  have hlpkt : ∀ (R S : Type u) [CommRing R] [CommRing S] (ψ : R →+* S),
      WeaklyEtale (Spec.map (CommRingCat.ofHom ψ)) → @Algebra.WeaklyEtale R S _ _ ψ.toAlgebra := by
    intro R S _ _ ψ hW
    letI : Algebra R S := ψ.toAlgebra
    have hW' : WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R S))) := hW
    have hf : Module.Flat R S := RingHom.flat_algebraMap_iff.mp
      ((HasRingHomProperty.Spec_iff (P := @Flat)).mp hW'.flat)
    have h2 := hW'.flat_diagonal
    rw [diagonal_SpecMap] at h2
    have h3 : Flat (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.lmul' (S := S) R).toRingHom)) := by
      have e : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' (S := S) R).toRingHom) =
          (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' (S := S) R).toRingHom) ≫
            (pullbackSpecIso R S S).inv) ≫ (pullbackSpecIso R S S).hom := by
        rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
      rw [e]
      exact MorphismProperty.comp_mem @Flat _ _ h2 inferInstance
    exact Algebra.WeaklyEtale.mk (flat := hf) ((HasRingHomProperty.Spec_iff (P := @Flat)).mp h3)

  have L4 : ∀ (S : Scheme.{u}) (A : Type u) [CommRing A]
      (j : Spec (.of A) ⟶ S) [IsOpenImmersion j] (Y : Scheme.{u}) (g : Y ⟶ S)
      [WeaklyEtale g] (t : Y), g t ∈ Set.range j →
      ∃ (C : Type u) (_ : CommRing C) (ψ : A →+* C) (F₀ : Spec (.of C) ⟶ Y),
        IsOpenImmersion F₀ ∧ t ∈ Set.range F₀ ∧
        F₀ ≫ g = Spec.map (CommRingCat.ofHom ψ) ≫ j ∧
        @Algebra.WeaklyEtale A C _ _ ψ.toAlgebra := by
    intro S A _ j _ Y g _ t ht
    have hV : t ∈ g ⁻¹ᵁ j.opensRange := by
      rw [Scheme.Hom.mem_preimage, Scheme.Hom.mem_opensRange]
      exact ht
    obtain ⟨U', hU'aff, htU', hU'le⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Scheme.isBasis_affineOpens Y)) hV
    have hU' : IsAffineOpen U' := hU'aff
    haveI := hU'.isOpenImmersion_fromSpec
    have hrng : Set.range (hU'.fromSpec ≫ g) ⊆ Set.range j := by
      rintro _ ⟨x, rfl⟩
      have hx : hU'.fromSpec x ∈ (U' : Set Y) := by
        rw [← hU'.range_fromSpec]; exact Set.mem_range_self x
      have h2 := hU'le hx
      rw [Scheme.Hom.mem_preimage, Scheme.Hom.mem_opensRange] at h2
      rw [Scheme.Hom.comp_apply]
      exact h2
    let l := IsOpenImmersion.lift j (hU'.fromSpec ≫ g) hrng
    have hl : l ≫ j = hU'.fromSpec ≫ g := IsOpenImmersion.lift_fac _ _ _
    let ψ : A →+* Γ(Y, U') := (Spec.preimage l).hom
    have hψ : Spec.map (CommRingCat.ofHom ψ) = l := by
      simp only [ψ, CommRingCat.ofHom_hom, Spec.map_preimage]
    have hWl : WeaklyEtale l := by
      haveI : WeaklyEtale hU'.fromSpec := etale_le_weaklyEtale _ _ _ (inferInstance : Etale _)
      haveI : WeaklyEtale (l ≫ j) := by rw [hl]; infer_instance
      haveI : WeaklyEtale j := etale_le_weaklyEtale _ _ _ (inferInstance : Etale j)
      exact WeaklyEtale.of_comp l j
    refine ⟨Γ(Y, U'), inferInstance, ψ, hU'.fromSpec, inferInstance, ?_, ?_, ?_⟩
    · rw [hU'.range_fromSpec]; exact htU'
    · rw [hψ, hl]
    · exact hlpkt _ _ ψ (by rw [hψ]; exact hWl)

  have hcover : (⨆ a : Fin (1 + 1), @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) MvPolynomial.gradedAlgebra
      (MvPolynomial.X a)) = ⊤ := by
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) :=
      MvPolynomial.gradedAlgebra
    refine Proj.iSup_basicOpen_eq_top _ _ ?_
    intro p hp
    have h0 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) 0 p = 0 :=
      (HomogeneousIdeal.mem_irrelevant_iff
        (𝒜 := MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) p).mp hp
    have h1 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) 0 p =
        MvPolynomial.homogeneousComponent 0 p :=
      (GradedRing.proj_apply _ 0 p).trans (MvPolynomial.decomposition.decompose'_apply p 0)
    rw [h1, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
    rw [← Set.image_univ]
    rw [MvPolynomial.mem_ideal_span_X_image]
    intro e he
    rw [MvPolynomial.mem_support_iff] at he
    have hne : e ≠ 0 := by
      rintro rfl
      exact he h0
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hne
    exact ⟨i, Set.mem_univ i, by simpa using hi⟩
  have hchart : ∀ (a : Fin (1 + 1)), ∃ eW : (@Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) MvPolynomial.gradedAlgebra
      (MvPolynomial.X a) : Scheme.{u}) ≅ Spec (.of (Polynomial K)), True := by
    intro a
    have hrev : a.rev ≠ a := by revert a; decide
    have hcases : ∀ i : Fin (1 + 1), i = a ∨ i = a.rev := by revert a; decide
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) :=
      MvPolynomial.gradedAlgebra
    have hscale : ∀ {S : Type u} [CommRing S] (f : K →+* S) (x : Fin (1 + 1) → S) (s : S)
        (p : MvPolynomial (Fin (1 + 1)) K) (n : ℕ), p.IsHomogeneous n →
        MvPolynomial.eval₂ f (fun i => s * x i) p = s ^ n * MvPolynomial.eval₂ f x p := by
      intro S _ f x s p n hp
      rw [MvPolynomial.eval₂_eq, MvPolynomial.eval₂_eq, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun d hd => ?_)
      have hdeg : ∑ i ∈ d.support, d i = n := by
        have h := hp (MvPolynomial.mem_support_iff.mp hd)
        simpa [Finsupp.weight_apply, Finsupp.sum] using h
      simp_rw [mul_pow, Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
      ring
    have hf : (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 1 := by
      rw [MvPolynomial.mem_homogeneousSubmodule]; exact MvPolynomial.isHomogeneous_X K a
    have hb : (MvPolynomial.X a.rev : MvPolynomial (Fin (1 + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K (1 • 1) := by
      rw [smul_eq_mul, mul_one, MvPolynomial.mem_homogeneousSubmodule]
      exact MvPolynomial.isHomogeneous_X K a.rev
    let T : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
        (MvPolynomial.X a) :=
      HomogeneousLocalization.Away.mk _ hf 1 (MvPolynomial.X a.rev) hb
    let ι₀ := HomogeneousLocalization.fromZeroRingHom
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (Submonoid.powers (MvPolynomial.X a))
    let c₀ := algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0)
    let ψ : Polynomial K →+* HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X a) :=
      Polynomial.eval₂RingHom (ι₀.comp c₀) T
    let χ₀ : MvPolynomial (Fin (1 + 1)) K →+* Polynomial K :=
      MvPolynomial.eval₂Hom Polynomial.C (fun i => if i = a then 1 else Polynomial.X)
    have hχa : χ₀ (MvPolynomial.X a) = 1 := by simp [χ₀]
    have hχb : χ₀ (MvPolynomial.X a.rev) = Polynomial.X := by simp [χ₀, hrev]
    have hχC : ∀ k, χ₀ (MvPolynomial.C k) = Polynomial.C k := by intro k; simp [χ₀]
    let Λ : Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K) →+*
        Polynomial K :=
      IsLocalization.Away.lift (MvPolynomial.X a) (g := χ₀) (by rw [hχa]; exact isUnit_one)
    have hΛ : ∀ p, Λ (algebraMap _ (Localization.Away (MvPolynomial.X a :
        MvPolynomial (Fin (1 + 1)) K)) p) = χ₀ p := fun p => IsLocalization.Away.lift_eq _ _ p
    let χ : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
        (MvPolynomial.X a) →+* Polynomial K :=
      Λ.comp (algebraMap _ (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K)))
    have hΛ1 : ∀ y : Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K),
        Λ (IsLocalization.mk' (Localization.Away (MvPolynomial.X a :
          MvPolynomial (Fin (1 + 1)) K)) 1 y) = 1 := by
      intro y
      have h := congrArg Λ (IsLocalization.mk'_spec (Localization.Away (MvPolynomial.X a :
          MvPolynomial (Fin (1 + 1)) K)) (1 : MvPolynomial (Fin (1 + 1)) K) y)
      rw [map_mul, hΛ, hΛ] at h
      obtain ⟨n, hn⟩ := y.2
      rw [← hn, map_pow, hχa, one_pow, mul_one, map_one] at h
      exact h
    have F1 : ∀ n p hp, χ (HomogeneousLocalization.Away.mk _ hf n p hp) = χ₀ p := by
      intro n p hp
      simp only [χ, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply,
        HomogeneousLocalization.Away.val_mk]
      rw [Localization.mk_eq_mk', IsLocalization.mk'_eq_mul_mk'_one, map_mul, hΛ, hΛ1, mul_one]
    have F0 : ∀ k : K, (ι₀ (c₀ k)).val = algebraMap (MvPolynomial (Fin (1 + 1)) K)
        (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K))
        (MvPolynomial.C k) := by
      intro k
      rw [← Localization.mk_one_eq_algebraMap]
      rfl
    have hψC : ∀ k, ψ (Polynomial.C k) = ι₀ (c₀ k) := by
      intro k; simp [ψ]
    have hψX : ψ Polynomial.X = T := by simp [ψ]
    have hi : χ.comp ψ = RingHom.id _ := by
      apply Polynomial.ringHom_ext
      · intro k
        rw [RingHom.comp_apply, hψC, RingHom.id_apply]
        simp only [χ, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply]
        rw [F0, hΛ, hχC]
      · rw [RingHom.comp_apply, hψX, RingHom.id_apply, F1, hχb]
    have hii : ψ.comp χ = RingHom.id _ := by
      apply RingHom.ext
      intro y
      obtain ⟨n, p, hp, rfl⟩ := HomogeneousLocalization.Away.mk_surjective _ hf y
      rw [RingHom.comp_apply, F1, RingHom.id_apply]
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk]
      let u : Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K) :=
        Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩
      let V : MvPolynomial (Fin (1 + 1)) K →+*
          Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K) :=
        (algebraMap _ _).comp (ψ.comp χ₀)
      let W : MvPolynomial (Fin (1 + 1)) K →+*
          Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K) :=
        MvPolynomial.eval₂Hom (algebraMap K _) (fun i : Fin (1 + 1) => u *
          algebraMap (MvPolynomial (Fin (1 + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K))
            (MvPolynomial.X i))
      have hKA : ∀ k : K, algebraMap (MvPolynomial (Fin (1 + 1)) K)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K))
          (MvPolynomial.C k) = algebraMap K _ k := by
        intro k
        rw [IsScalarTower.algebraMap_apply K (MvPolynomial (Fin (1 + 1)) K)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K)),
          MvPolynomial.algebraMap_eq]
      have hVW : V = W := by
        apply MvPolynomial.ringHom_ext
        · intro k
          simp only [V, W, RingHom.comp_apply, MvPolynomial.eval₂Hom_C, hχC, hψC,
            HomogeneousLocalization.algebraMap_apply]
          rw [F0, hKA]
        · intro i
          rcases hcases i with rfl | rfl
          · simp only [V, W, RingHom.comp_apply, MvPolynomial.eval₂Hom_X', hχa, map_one, u]
            rw [← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]
            exact (Localization.mk_self (⟨MvPolynomial.X i, Submonoid.mem_powers _⟩ :
              Submonoid.powers (MvPolynomial.X i : MvPolynomial (Fin (1 + 1)) K))).symm
          · simp only [V, W, RingHom.comp_apply, MvPolynomial.eval₂Hom_X', hχb, hψX, u,
              HomogeneousLocalization.algebraMap_apply, T, HomogeneousLocalization.Away.val_mk]
            rw [← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]
            congr 1
            ext
            simp
      have hval : (ψ (χ₀ p)).val = V p := by
        simp only [V, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply]
      have hph : p.IsHomogeneous n := by
        have hp' := hp
        rw [smul_eq_mul, mul_one, MvPolynomial.mem_homogeneousSubmodule] at hp'
        exact hp'
      have heta : MvPolynomial.eval₂ (algebraMap K (Localization.Away (MvPolynomial.X a :
          MvPolynomial (Fin (1 + 1)) K))) (fun i : Fin (1 + 1) =>
            algebraMap (MvPolynomial (Fin (1 + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K))
            (MvPolynomial.X i)) p =
          algebraMap (MvPolynomial (Fin (1 + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K)) p := by
        have h := MvPolynomial.eval₂_comp_left (algebraMap (MvPolynomial (Fin (1 + 1)) K)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K)))
          MvPolynomial.C MvPolynomial.X p
        rw [MvPolynomial.eval₂_eta] at h
        rw [h, ← MvPolynomial.algebraMap_eq, ← IsScalarTower.algebraMap_eq]
        rfl
      rw [hval, hVW]
      simp only [W, MvPolynomial.coe_eval₂Hom]
      rw [hscale _ _ u p n hph, heta, ← Localization.mk_one_eq_algebraMap]
      simp only [u]
      rw [Localization.mk_pow, Localization.mk_mul, one_pow, one_mul, mul_one]
      congr 1
    let e2 : Spec (.of (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X a))) ≅
        Spec (.of (Polynomial K)) :=
      { hom := Spec.map (CommRingCat.ofHom ψ)
        inv := Spec.map (CommRingCat.ofHom χ)
        hom_inv_id := by
          rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hii]
          exact Spec.map_id _
        inv_hom_id := by
          rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hi]
          exact Spec.map_id _ }
    exact ⟨Proj.basicOpenIsoSpec (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
      (MvPolynomial.X a) hf Nat.one_pos ≪≫ e2, trivial⟩
  have hspecj : ∀ (R : Type u) [CommRing R] {S : Scheme.{u}}
      (j : Spec (.of (Polynomial K)) ⟶ S) (ψ : Polynomial K →+* R) (y : Spec (.of R)),
      j (Spec.map (CommRingCat.ofHom ψ) y) = j (PrimeSpectrum.comap ψ y) :=
    fun R _ S j ψ y => congrArg j (Spec.map_apply _ _)

  intro T t
  haveI : WeaklyEtale T.hom := T.prop
  have hx0 : T.hom t ∈ (⨆ a : Fin (1 + 1), @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) MvPolynomial.gradedAlgebra
      (MvPolynomial.X a)) := by
    rw [hcover]; trivial
  obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hx0
  obtain ⟨eW, -⟩ := hchart a
  obtain ⟨j, hjdef⟩ : ∃ j : Spec (.of (Polynomial K)) ⟶ (wcP1Over K).left,
      j = eW.inv ≫ (@Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) MvPolynomial.gradedAlgebra
        (MvPolynomial.X a)).ι := ⟨_, rfl⟩
  haveI hj : IsOpenImmersion j := by rw [hjdef]; infer_instance
  have hxj : T.hom t ∈ Set.range j := by
    have hxW : T.hom t ∈ Set.range (@Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) MvPolynomial.gradedAlgebra
        (MvPolynomial.X a)).ι := by
      rw [Scheme.Opens.range_ι]; exact ha
    obtain ⟨w, hw⟩ := hxW
    refine ⟨eW.hom w, ?_⟩
    rw [hjdef, ← Scheme.Hom.comp_apply, Iso.hom_inv_id_assoc]
    exact hw
  obtain ⟨Cr, _, ψ, F₀, hF₀, ht₀, hfac, hWE⟩ := L4 _ (Polynomial K) j T.left T.hom t hxj
  haveI := hF₀
  have hjinj : Function.Injective (fun y : PrimeSpectrum (Polynomial K) => j y) :=
    fun a b h => (Scheme.Hom.isOpenEmbedding j).isEmbedding.injective h
  have hjc : Continuous (fun y : PrimeSpectrum (Polynomial K) => j y) := j.continuous
  obtain ⟨s, hs, hjs⟩ := L2 (Polynomial K) (Polynomial.not_isField K) _ hjinj hjc Zs hZ
  have hpb : ∀ {X Y : Scheme.{u}} (U : X.Opens) (g : Y ⟶ X),
      IsOpenImmersion (Limits.pullback.snd U.ι g) ∧
      ∀ y : Y, y ∈ Set.range (Limits.pullback.snd U.ι g) ↔ g y ∈ (U : Set X) := by
    intro X Y U g
    refine ⟨inferInstance, fun y => ?_⟩
    rw [IsOpenImmersion.range_pullbackSnd, Scheme.Opens.opensRange_ι]
    exact Iff.rfl
  have hsq : ∀ {X Y Z W : Scheme.{u}} (a : X ⟶ Y) (b : Y ⟶ W) (c : X ⟶ Z) (d : Z ⟶ W),
      a ≫ b = c ≫ d → ∀ x : X, b (a x) = d (c x) := by
    intro X Y Z W a b c d h x
    rw [← Scheme.Hom.comp_apply, h, Scheme.Hom.comp_apply]
  have hO' : ∀ p : (wcP1Over K).left, p ∈ (O : Set (wcP1Over K).left) ↔ p ∉ Zs := by
    intro p; rw [hO]; simp
  set ι := (wcOpenRestrIncl (wcP1Over K).left O T).left with hιset
  haveI : IsOpenImmersion ι := (hpb O T.hom).1
  have hrange : ∀ x : T.left, x ∈ Set.range ι ↔ T.hom x ∈ (O : Set (wcP1Over K).left) :=
    (hpb O T.hom).2
  have hkey : ∀ x : PrimeSpectrum Cr, F₀ x ∈ Set.range ι ↔
      x ∈ PrimeSpectrum.basicOpen (ψ s) := by
    intro x
    have h1 : T.hom (F₀ x) = j (PrimeSpectrum.comap ψ x) :=
      (hsq F₀ T.hom _ j hfac x).trans (hspecj Cr j ψ x)
    have h2 : (T.hom (F₀ x) ∉ Zs) = (j (PrimeSpectrum.comap ψ x) ∉ Zs) :=
      congrArg (fun p => p ∉ Zs) h1
    have h3 : PrimeSpectrum.comap ψ x ∈ PrimeSpectrum.basicOpen s ↔
        x ∈ PrimeSpectrum.basicOpen (ψ s) := by
      simp only [PrimeSpectrum.mem_basicOpen, PrimeSpectrum.comap_asIdeal, Ideal.mem_comap]
    exact (hrange _).trans ((hO' _).trans ((Iff.of_eq h2).trans ((hjs _).trans h3)))
  refine ⟨Set.range F₀, IsOpenImmersion.isOpen_range F₀, ht₀, ?_⟩
  exact L5 ι (Scheme.Hom.isOpenEmbedding ι) F₀ (Scheme.Hom.isOpenEmbedding F₀)
    (fun Cl hCl hCo hCc => L3 Cr ψ hWE s hs (F₀ ⁻¹' Set.range ι) hkey Cl hCl hCo hCc)

theorem wc_vqm_hz_E_hom_zero_offS (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hhom : ∀ φ : (Subobject.underlying.obj (wcPencilE D ℓ hP)).over (wcGeomPoint F'' (wcP1Over F'') hP) ⟶
        (wcContSheaf (wcP1Over F'').left ℚ_[ℓ]).over (wcGeomPoint F'' (wcP1Over F'') hP), φ = 0) :
    ∀ φ : (Subobject.underlying.obj (wcPencilE D ℓ hP)).over (wcPencilGeomOffS D hP) ⟶
        (wcContSheaf (wcP1Over F'').left ℚ_[ℓ]).over (wcPencilGeomOffS D hP), φ = 0 :=
by
  classical
  intro φ

  haveI hsub : Subsingleton (Spec (.of F'')) := by
    show Subsingleton (PrimeSpectrum F''); infer_instance
  have hpt : ∀ i, IsClosed ({D.S i (IsLocalRing.closedPoint F'')} : Set (wcP1Over F'').left) := by
    intro i
    haveI := isClosedImmersion_of_comp_eq_id (wcP1Over F'').hom (D.S i) (D.hS i)
    have hr : IsClosed (Set.range (D.S i)) := (D.S i).isClosedEmbedding.isClosed_range
    have e : Set.range (D.S i) = {D.S i (IsLocalRing.closedPoint F'')} := by
      ext x
      simp only [Set.mem_range, Set.mem_singleton_iff]
      constructor
      · rintro ⟨p, rfl⟩; rw [Subsingleton.elim p (IsLocalRing.closedPoint F'')]
      · rintro rfl; exact ⟨_, rfl⟩
    rw [← e]; exact hr

  let Zs : Finset (wcP1Over F'').left :=
    Finset.univ.image (fun i => D.S i (IsLocalRing.closedPoint F''))
  have hZ : ∀ z ∈ Zs, IsClosed ({z} : Set (wcP1Over F'').left) := by
    intro z hz
    obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hz
    exact hpt i
  have hO : ((wcPencilSOpen D : (wcP1Over F'').left.Opens) : Set (wcP1Over F'').left) =
      ((Zs : Set (wcP1Over F'').left))ᶜ := by
    show (⋃ i, closure {D.S i (IsLocalRing.closedPoint F'')})ᶜ = _
    congr 1
    ext p
    simp only [Set.mem_iUnion, Zs, Finset.coe_image, Finset.coe_univ, Set.image_univ,
      Set.mem_range]
    constructor
    · rintro ⟨i, hi⟩
      rw [(hpt i).closure_eq] at hi
      exact ⟨i, (Set.mem_singleton_iff.mp hi).symm⟩
    · rintro ⟨i, rfl⟩
      exact ⟨i, subset_closure rfl⟩

  have hrange : ∀ (T : (wcP1Over F'').left.ProEt) (x : T.left),
      T.hom x ∈ ((wcPencilSOpen D : (wcP1Over F'').left.Opens) : Set (wcP1Over F'').left) →
      ∃ y : (wcOpenRestr (wcP1Over F'').left (wcPencilSOpen D) T).left,
        (wcOpenRestrIncl (wcP1Over F'').left (wcPencilSOpen D) T).left y = x := by
    intro T x hx
    have h1 : x ∈ Set.range (Limits.pullback.snd (wcPencilSOpen D).ι T.hom) := by
      rw [IsOpenImmersion.range_pullbackSnd, Scheme.Opens.opensRange_ι]
      exact hx
    obtain ⟨y, hy⟩ := h1
    exact ⟨y, hy⟩

  obtain ⟨η, hη, hne⟩ : ∃ η : (wcP1Over F'').left, (∀ x : (wcP1Over F'').left, η ⤳ x) ∧
      ∃ x : (wcP1Over F'').left, x ≠ η := by
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') :=
      MvPolynomial.gradedAlgebra
    change ∃ η : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F''),
      (∀ x, η ⤳ x) ∧ ∃ x, x ≠ η
    have hprime : (⊥ : HomogeneousIdeal
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'')).toIdeal.IsPrime := by
      rw [HomogeneousIdeal.toIdeal_bot]
      exact Ideal.isPrime_bot
    have hX : ∀ j : Fin (1 + 1), MvPolynomial.X j ∈
        HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') :=
      fun j => HomogeneousIdeal.mem_irrelevant_of_mem
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') (i := 1) Nat.one_pos
        ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X F'' j))
    have hirr : ¬ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'')
        ≤ ⊥ := by
      intro h
      have h0 := h (hX 0)
      rw [← HomogeneousIdeal.mem_iff, HomogeneousIdeal.toIdeal_bot, Ideal.mem_bot] at h0
      exact MvPolynomial.X_ne_zero (0 : Fin (1 + 1)) h0
    let η : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') :=
      ⟨⊥, hprime, hirr⟩
    let J : Ideal (MvPolynomial (Fin (1 + 1)) F'') := Ideal.span {MvPolynomial.X 0}
    have hJh : J.IsHomogeneous (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') := by
      apply Ideal.homogeneous_span
      intro y hy
      rw [Set.mem_singleton_iff] at hy
      subst hy
      exact ⟨1, (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X F'' 0)⟩
    let I := Ideal.homogeneousHull (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') J
    have hI : I.toIdeal = J := hJh.toIdeal_homogeneousHull_eq_self
    have hIprime : I.toIdeal.IsPrime := by
      rw [hI]
      exact (Ideal.span_singleton_prime (MvPolynomial.X_ne_zero 0)).mpr MvPolynomial.X_prime
    have hIirr : ¬ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'')
        ≤ I := by
      intro h
      have h1 := h (hX 1)
      rw [← HomogeneousIdeal.mem_iff, hI, Ideal.mem_span_singleton] at h1
      obtain ⟨c, hc⟩ := h1
      have := congrArg (MvPolynomial.eval ![(0 : F''), 1]) hc
      simp at this
    let x : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') :=
      ⟨I, hIprime, hIirr⟩
    refine ⟨η, fun y => ?_, x, ?_⟩
    · apply specializes_iff_mem_closure.mpr
      apply (ProjectiveSpectrum.le_iff_mem_closure _ η y).mp
      apply (ProjectiveSpectrum.as_ideal_le_as_ideal _ η y).mp
      exact bot_le
    · intro hxη
      have e : I = ⊥ := congrArg ProjectiveSpectrum.asHomogeneousIdeal hxη
      have h0 : MvPolynomial.X 0 ∈ I.toIdeal := by
        rw [hI]; exact Ideal.mem_span_singleton_self _
      rw [e, HomogeneousIdeal.toIdeal_bot, Ideal.mem_bot] at h0
      exact MvPolynomial.X_ne_zero (0 : Fin (1 + 1)) h0
  have hetaS : η ∉ {p : (wcP1Over F'').left | ∃ i : Fin D.m, p = D.S i (IsLocalRing.closedPoint F'')} := by
    rintro ⟨i, hi⟩
    obtain ⟨x, hx⟩ := hne
    have hxm : x ∈ ({D.S i (IsLocalRing.closedPoint F'')} : Set (wcP1Over F'').left) :=
      (hη x).mem_closed (hpt i) (by rw [Set.mem_singleton_iff]; exact hi)
    exact hx ((Set.mem_singleton_iff.mp hxm).trans hi.symm)
  have hgenS : ∀ (T : (wcP1Over F'').left.ProEt) (t : T.left),
      T.hom t ∈ {p : (wcP1Over F'').left | ∃ i : Fin D.m, p = D.S i (IsLocalRing.closedPoint F'')} →
      ∃ t' : T.left, t' ⤳ t ∧
        T.hom t' ∉ {p : (wcP1Over F'').left | ∃ i : Fin D.m, p = D.S i (IsLocalRing.closedPoint F'')} := by
    intro T t _
    haveI : WeaklyEtale T.hom := T.prop
    obtain ⟨t', ht', hpt'⟩ := Flat.generalizingMap T.hom (hη (T.hom t))
    refine ⟨t', ht', ?_⟩
    rw [show T.hom t' = η from hpt']
    exact hetaS
  have hOmem : ∀ p : (wcP1Over F'').left,
      p ∉ {p : (wcP1Over F'').left | ∃ i : Fin D.m, p = D.S i (IsLocalRing.closedPoint F'')} →
      p ∈ ((wcPencilSOpen D : (wcP1Over F'').left.Opens) : Set (wcP1Over F'').left) := by
    intro p hp
    rw [hO]
    intro hpZ
    apply hp
    obtain ⟨i, _, hi⟩ := Finset.mem_image.mp (Finset.mem_coe.mp hpZ)
    exact ⟨i, hi.symm⟩
  have hgen : ∀ (T : (wcP1Over F'').left.ProEt) (x : T.left),
      ∃ y : (wcOpenRestr (wcP1Over F'').left (wcPencilSOpen D) T).left,
        (wcOpenRestrIncl (wcP1Over F'').left (wcPencilSOpen D) T).left y ⤳ x := by
    intro T x
    by_cases hx : T.hom x ∈
        {p : (wcP1Over F'').left | ∃ i : Fin D.m, p = D.S i (IsLocalRing.closedPoint F'')}
    · obtain ⟨t', ht', hnot⟩ := hgenS T x hx
      obtain ⟨y, hy⟩ := hrange T t' (hOmem _ hnot)
      exact ⟨y, by rw [hy]; exact ht'⟩
    · obtain ⟨y, hy⟩ := hrange T x (hOmem _ hx)
      exact ⟨y, by rw [hy]⟩

  have hloc := wc_P1_proet_open_local_clopen F'' (wcPencilSOpen D) Zs hZ hO

  have s7 : ∀ {X Y : Type u} [TopologicalSpace X] [TopologicalSpace Y] (ι : Y → X),
      Continuous ι → (∀ x : X, ∃ y : Y, ι y ⤳ x) →
      (∀ x : X, ∃ U : Set X, IsOpen U ∧ x ∈ U ∧ ∀ C : Set Y, C ⊆ ι ⁻¹' U → IsOpen C →
          IsOpen (ι ⁻¹' U \ C) → ∃ W : Set X, W ⊆ U ∧ IsOpen W ∧ IsOpen (U \ W) ∧
            ι ⁻¹' W = C) →
      ∀ f : C(Y, ℚ_[ℓ]), ∃ F : C(X, ℚ_[ℓ]), ∀ y, F (ι y) = f y := by
    intro X Y _ _ ι hι hg hl f
    have L : ∀ (y : Y) (x : X), ι y ⤳ x → ∀ ε > 0, ∃ W : Set X, IsOpen W ∧ x ∈ W ∧
        ∀ y', ι y' ∈ W → dist (f y') (f y) < ε := by
      intro y x hyx ε hε
      obtain ⟨U, hU, hxU, hex⟩ := hl x
      have hB := IsUltrametricDist.isClopen_ball (f y) ε
      have hdiff : ι ⁻¹' U \ (f ⁻¹' Metric.ball (f y) ε ∩ ι ⁻¹' U) =
          ι ⁻¹' U ∩ f ⁻¹' (Metric.ball (f y) ε)ᶜ := by
        ext z
        simp only [Set.mem_diff, Set.mem_inter_iff, Set.mem_preimage, Set.mem_compl_iff]
        tauto
      obtain ⟨W, _, hW, hUW, hWC⟩ := hex (f ⁻¹' Metric.ball (f y) ε ∩ ι ⁻¹' U)
        Set.inter_subset_right
        ((hB.isOpen.preimage f.continuous).inter (hU.preimage hι))
        (by rw [hdiff]; exact (hU.preimage hι).inter (hB.compl.isOpen.preimage f.continuous))
      refine ⟨W, hW, ?_, ?_⟩
      · by_contra hxW
        have h1 : ι y ∈ U \ W := hyx.mem_open hUW ⟨hxU, hxW⟩
        have h2 : y ∈ ι ⁻¹' W := by
          rw [hWC]
          exact ⟨Metric.mem_ball_self hε, h1.1⟩
        exact h1.2 h2
      · intro y' hy'
        have h2 : y' ∈ ι ⁻¹' W := hy'
        rw [hWC] at h2
        exact h2.1
    have wd : ∀ (y₁ y₂ : Y) (x : X), ι y₁ ⤳ x → ι y₂ ⤳ x → f y₁ = f y₂ := by
      intro y₁ y₂ x h1 h2
      refine (eq_of_forall_dist_le fun ε hε => ?_).symm
      obtain ⟨W, hW, hxW, hb⟩ := L y₁ x h1 ε hε
      exact (hb y₂ (h2.mem_open hW hxW)).le
    choose g hgx using hg
    refine ⟨⟨fun x => f (g x), ?_⟩, fun y => wd _ _ _ (hgx (ι y)) (specializes_refl _)⟩
    rw [Metric.continuous_iff']
    intro a ε hε
    obtain ⟨W, hW, haW, hb⟩ := L (g a) a (hgx a) ε hε
    filter_upwards [hW.mem_nhds haW] with x' hx'
    exact hb (g x') ((hgx x').mem_open hW hx')

  have hext : ∀ (T : (wcP1Over F'').left.ProEt)
      (g : C((wcOpenRestr (wcP1Over F'').left (wcPencilSOpen D) T).left, ℚ_[ℓ])),
      ∃ G : C(T.left, ℚ_[ℓ]), ∀ y : (wcOpenRestr (wcP1Over F'').left (wcPencilSOpen D) T).left,
        G ((wcOpenRestrIncl (wcP1Over F'').left (wcPencilSOpen D) T).left y) = g y :=
    fun T g => s7 _ (wcOpenRestrIncl (wcP1Over F'').left (wcPencilSOpen D) T).left.continuous
      (hgen T) (hloc T) g

  exact wc_proet_openRestr_over_hom_zero (wcP1Over F'').left ℓ (wcPencilSOpen D)
    (wcGeomPoint F'' (wcP1Over F'') hP) _ hgen hext hhom φ

theorem wc_proet_over_hom_zero_of_geomConst (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (B0 : S.ProEt) (E H : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (r : ℕ)
    (θ : H.over B0 ≅ (wcContSheaf S (Fin r → ℚ_[ℓ])).over B0)
    (hE : ∀ φ : E.over B0 ⟶ (wcContSheaf S ℚ_[ℓ]).over B0, φ = 0) :
    ∀ φ : E.over B0 ⟶ H.over B0, φ = 0 :=
by
  intro φ
  have hj : ∀ j : Fin r, (φ ≫ θ.hom) ≫
      (GrothendieckTopology.overPullback (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} B0).map
        (wcContSheafMap S (Pi.evalAddMonoidHom (fun _ : Fin r => ℚ_[ℓ]) j) (continuous_apply j)) = 0 :=
    fun j => hE _
  have hψ : φ ≫ θ.hom = 0 := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext X
    apply AddCommGrpCat.ext
    intro x
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    funext j
    have h := congrArg
      (fun g : E.over B0 ⟶ (wcContSheaf S ℚ_[ℓ]).over B0 =>
        (@DFunLike.coe C(X.unop.left.left, ℚ_[ℓ]) _ _ _ ((g.hom.app X).hom x).down t)) (hj j)
    first
      | exact h
      | (simp only [Sheaf.instPreadditive, NatTrans.app_zero] at h; exact h)
      | simpa using h
  calc φ = (φ ≫ θ.hom) ≫ θ.inv := by simp
    _ = 0 := by rw [hψ, Limits.zero_comp]

theorem wc_proet_pairing_orth_of_hom_zero (S : Scheme.{u}) (B0 : S.ProEt)
    (E C G H : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (iE : E ⟶ G) (iC : C ⟶ G)
    (β : ∀ V : S.ProEt, G.obj.obj (Opposite.op V) →+ G.obj.obj (Opposite.op V) →+
      H.obj.obj (Opposite.op V))
    (hβ : ∀ (V V' : S.ProEt) (a : V' ⟶ V) (y y' : G.obj.obj (Opposite.op V)),
      β V' ((G.obj.map a.op).hom y) ((G.obj.map a.op).hom y') = (H.obj.map a.op).hom (β V y y'))
    (hE : ∀ φ : E.over B0 ⟶ H.over B0, φ = 0) :
    ∀ (c : C.obj.obj (Opposite.op B0)) (V : S.ProEt) (s : V ⟶ B0) (z : E.obj.obj (Opposite.op V)),
      β V ((iE.hom.app (Opposite.op V)).hom z)
          ((iC.hom.app (Opposite.op V)).hom ((C.obj.map s.op).hom c)) = 0 ∧
