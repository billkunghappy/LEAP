    have hUs : ∀ y : ↥(Limits.pullback pb (wcQmSp A)), y ≠ z → y ∈ wcQmUs z := by
      intro y hy
      show y ∈ (closure ({z} : Set ↥(Limits.pullback pb (wcQmSp A))))ᶜ
      rw [hzclos]
      simpa using hy
    obtain ⟨J, φ, hφ⟩ := hoff
    obtain ⟨ψ₁, hψ₁⟩ := wc_qm_open_restrict_push_stalk_iso (Limits.pullback pb (wcQmSp A))
      (wcQmUs z) _ _ φ hφ
    haveI := wc_et_enough_injectives
      ((Limits.pullback.fst pb (wcQmSp A) ⁻¹ᵁ j.opensRange : Scheme.Opens _) : Scheme.{u})
    let IO := injectiveResolution ((constantSheaf (Scheme.smallEtaleTopology
      ((Limits.pullback.fst pb (wcQmSp A) ⁻¹ᵁ j.opensRange : Scheme.Opens _) : Scheme.{u}))
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))
    obtain ⟨ψ₂, hψ₂⟩ := wc_qm_open_push_compare_stalk_iso (Limits.pullback pb (wcQmSp A))
      (Limits.pullback.fst pb (wcQmSp A) ⁻¹ᵁ j.opensRange) (wcQmUs z)
      (wcQmWs (Limits.pullback.fst pb (wcQmSp A)) j z) inf_le_right inf_le_left ℓ IO J
    obtain ⟨e⟩ := wc_qm_special_chart_iso A n π c hπ Xb pb j hcomm
    have hℓk : ((ℓ : ℕ) : IsLocalRing.ResidueField A) ≠ 0 := by
      have h1 := hℓA.map (IsLocalRing.residue A)
      rw [map_natCast] at h1
      exact h1.ne_zero
    obtain ⟨h0, hv⟩ := wc_et_quadric_cone_acyclic (IsLocalRing.ResidueField A) ℓ hℓ hℓk n
      (c.map (IsLocalRing.residue A))
    have h0O : Nat.card (wcEtCoh
        ((Limits.pullback.fst pb (wcQmSp A) ⁻¹ᵁ j.opensRange : Scheme.Opens _) : Scheme.{u})
          ℓ 0) = ℓ := by
      obtain ⟨E⟩ := wc_et_coh_iso_invariance e.hom ℓ 0
      rw [← Nat.card_congr E]
      exact h0
    have hvO : ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh
        ((Limits.pullback.fst pb (wcQmSp A) ⁻¹ᵁ j.opensRange : Scheme.Opens _) : Scheme.{u})
          ℓ q) := by
      intro q hq
      obtain ⟨E⟩ := wc_et_coh_iso_invariance e.hom ℓ q
      haveI := hv q hq
      exact E.symm.subsingleton
    have hzO : z ∈ (Limits.pullback.fst pb (wcQmSp A) ⁻¹ᵁ j.opensRange : Scheme.Opens _) := by
      show Limits.pullback.fst pb (wcQmSp A) z ∈ j.opensRange
      rw [Scheme.Hom.mem_opensRange]
      exact ⟨x₀, hz.symm⟩
    have hE1 := wc_qm_edge_open_push_acyclic (Limits.pullback pb (wcQmSp A))
      (Limits.pullback.fst pb (wcQmSp A) ⁻¹ᵁ j.opensRange) z hzO ℓ hℓ.ne_zero IO h0O hvO
    have hE2 := (wc_qm_edge_two_of_three (Limits.pullback pb (wcQmSp A)) z hzcl hzsep _ _ ψ₂
      (fun y hy p => hψ₂ y ⟨wcQmUs z, hUs y hy, (inf_left_idem _ _).symm⟩ p)).mp hE1
    exact (wc_qm_edge_two_of_three (Limits.pullback pb (wcQmSp A)) z hzcl hzsep _ _ ψ₁
      (fun y hy p => hψ₁ y (hUs y hy) p)).mpr hE2

  obtain ⟨P, τ, hP, hτ, hPτ⟩ := wc_hmtg_pbc_edge_transfer A Xb
    (Limits.pullback (wcQuadModelStr A n π c) ξ) pb
    (Limits.pullback.fst (wcQuadModelStr A n π c) ξ ≫ j) ℓ hℓ.ne_zero I z q
  have hEXb : Function.Bijective (wcQmEdge Xb (Limits.pullback.fst pb (wcQmSp A) z)
      (((wcEtPush (Limits.pullback.fst (wcQuadModelStr A n π c) ξ ≫ j)).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj I.cocomplex) q) := by
    have hfun : wcQmEdge Xb (Limits.pullback.fst pb (wcQmSp A) z)
        (((wcEtPush (Limits.pullback.fst (wcQuadModelStr A n π c) ξ ≫ j)).mapHomologicalComplex
          (ComplexShape.up ℕ)).obj I.cocomplex) q =
        τ ∘ (wcQmEdge (Limits.pullback pb (wcQmSp A)) z
          (wcQmCx (Limits.pullback.fst (wcQuadModelStr A n π c) ξ ≫ j)
            (Limits.pullback.fst pb (wcQmSp A)) I.cocomplex) q) ∘ P :=
      funext fun x => (hPτ x).symm
    rw [hfun]
    exact hτ.comp ((hE3 q).comp hP)

  obtain ⟨Lr, Ψ, hLr, hΨ, hform⟩ := wc_hmtg_leray_edge_restr A _ Xb (wcQuadModelStr A n π c) pb j
    hcomm Ω ξ x₀ B₀ Λ₀ W₀ φ₀ a₀ hsh ℓ hℓ.ne_zero I (Limits.pullback.fst pb (wcQmSp A) z) hz q

  have hid : ∀ {S : Scheme.{u}} (D1 : wcEtPullData (𝟙 S) ℓ) (x : wcEtZModExt S ℓ q),
      wcEtPull D1 q x = x := by
    intro S D1 x
    have h1 : wcEtPull D1 q x = wcEtPull D1 q (wcEtPull D1 q x) :=
      wc_et_pull_comp (𝟙 S) (𝟙 S) (𝟙 S) (Category.id_comp _) D1 D1 D1 q x
    have h2 : wcEtPull D1 q (wcEtPull D1 q x - x) = 0 := by
      rw [map_sub, ← h1, sub_self]
    exact sub_eq_zero.mp (wc_et_pull_id_injective D1 q _ h2)

  let iso := Limits.pullbackRightPullbackFstIso (wcQuadModelStr A n π c) ξ a₀
  have hθr : iso.inv ≫ Limits.pullback.snd a₀ (Limits.pullback.fst (wcQuadModelStr A n π c) ξ) =
      r := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Limits.pullbackRightPullbackFstIso_inv_snd_fst, hr₁]
    · rw [Category.assoc, Limits.pullbackRightPullbackFstIso_inv_snd_snd, hr₂]
  obtain ⟨D'⟩ := wc_et_zmod_pull_data_exists
    (Limits.pullback.snd a₀ (Limits.pullback.fst (wcQuadModelStr A n π c) ξ)) ℓ
  obtain ⟨Dθ⟩ := wc_et_zmod_pull_data_exists iso.inv ℓ
  obtain ⟨Dh⟩ := wc_et_zmod_pull_data_exists iso.hom ℓ
  obtain ⟨D1P⟩ := wc_et_zmod_pull_data_exists
    (𝟙 (Limits.pullback a₀ (Limits.pullback.fst (wcQuadModelStr A n π c) ξ))) ℓ
  obtain ⟨D1F⟩ := wc_et_zmod_pull_data_exists
    (𝟙 (Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) ξ)) ℓ
  have hθb : Function.Bijective (wcEtPull Dθ q) := by
    constructor
    · intro x y hxy
      rw [← hid D1P x, ← hid D1P y,
        wc_et_pull_comp iso.inv iso.hom _ iso.hom_inv_id Dθ Dh D1P q x,
        wc_et_pull_comp iso.inv iso.hom _ iso.hom_inv_id Dθ Dh D1P q y, hxy]
    · intro y
      refine ⟨wcEtPull Dh q y, ?_⟩
      rw [← wc_et_pull_comp iso.hom iso.inv _ iso.inv_hom_id Dh Dθ D1F q y, hid D1F y]

  have hfun : ⇑(wcEtPull D q) = ⇑(wcEtPull Dθ q) ∘ Ψ ∘
      (wcQmEdge Xb (Limits.pullback.fst pb (wcQmSp A) z)
        (((wcEtPush (Limits.pullback.fst (wcQuadModelStr A n π c) ξ ≫ j)).mapHomologicalComplex
          (ComplexShape.up ℕ)).obj I.cocomplex) q) ∘ Lr := by
    funext cl
    show wcEtPull D q cl = wcEtPull Dθ q (Ψ (wcQmEdge Xb (Limits.pullback.fst pb (wcQmSp A) z)
        (((wcEtPush (Limits.pullback.fst (wcQuadModelStr A n π c) ξ ≫ j)).mapHomologicalComplex
          (ComplexShape.up ℕ)).obj I.cocomplex) q (Lr cl)))
    rw [hform cl D']
    exact wc_et_pull_comp _ iso.inv r hθr D' Dθ D q cl
  rw [hfun]
  exact hθb.comp (hΨ.comp (hEXb.comp hLr))

theorem wc_hmtg_et_pull_bij_prime_pow {S S' : Scheme.{u}} (g : S' ⟶ S) (ℓ : ℕ) (hℓ : ℓ.Prime)
    (h1 : ∀ (E : wcEtPullData g ℓ) (q : ℕ), Function.Bijective (wcEtPull E q))
    (k : ℕ) (hk : 1 ≤ k) (E : wcEtPullData g (ℓ ^ k)) (q : ℕ) :
    Function.Bijective (wcEtPull E q) :=
by
  classical
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) := HasExt.standard _
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology S') AddCommGrpCat.{u+1}) := HasExt.standard _

  have s1 : ∀ (m : ℕ) (A : wcR2gsAdjData g m),
      (∀ (E : wcEtPullData g m) (q : ℕ), Function.Bijective (wcEtPull E q)) ↔
        ∀ q : ℕ, Function.Bijective (wcR2gsAPull A q) := by
    intro m A
    constructor
    · intro h q
      obtain ⟨N, hN, hnat⟩ := wc_r2gs_zmod_change_rings_pull_all m q
      obtain ⟨E⟩ := wc_et_zmod_pull_data_exists g m
      have hc : (⇑(N S')) ∘ ⇑(wcEtPull E q) = (wcR2gsAPull A q) ∘ ⇑(N S) :=
        funext fun b => hnat g A E b
      have hb : Function.Bijective ((⇑(N S')) ∘ ⇑(wcEtPull E q)) := (hN S').comp (h E q)
      rw [hc] at hb
      exact (Function.Bijective.of_comp_iff (wcR2gsAPull A q) (hN S)).mp hb
    · intro h E q
      obtain ⟨N, hN, hnat⟩ := wc_r2gs_zmod_change_rings_pull_all m q
      have hc : (⇑(N S')) ∘ ⇑(wcEtPull E q) = (wcR2gsAPull A q) ∘ ⇑(N S) :=
        funext fun b => hnat g A E b
      have hb : Function.Bijective ((wcR2gsAPull A q) ∘ ⇑(N S)) := (h q).comp (hN S)
      rw [← hc] at hb
      exact (Function.Bijective.of_comp_iff' (hN S') _).mp hb

  have s2 : ∀ (p k : ℕ), p ≠ 0 →
      ∃ (f : AddCommGrpCat.of (ULift.{u+1} (ZMod k)) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))))
        (gg : AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod p)))
        (hw : f ≫ gg = 0), (ShortComplex.mk f gg hw).ShortExact ∧
          f.hom (ULift.up (1 : ZMod k)) = p • (ULift.up (1 : ZMod (p * k)) : ULift.{u+1} (ZMod (p * k))) ∧
          gg.hom (ULift.up (1 : ZMod (p * k))) = (ULift.up (1 : ZMod p) : ULift.{u+1} (ZMod p)) := by
    intro p k hp
    have hk0 : (zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k))) (k : ℤ) = 0 := by
      rw [zmultiplesHom_apply, zsmul_eq_mul, Int.cast_natCast, ← Nat.cast_mul, mul_comm,
        ZMod.natCast_self]
    let α : ZMod k →+ ZMod (p * k) :=
      ZMod.lift k ⟨zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k)), hk0⟩
    have hα : ∀ z : ℤ, α (z : ZMod k) = ((z * p : ℤ) : ZMod (p * k)) := by
      intro z
      show (ZMod.lift k ⟨zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k)), hk0⟩) (z : ZMod k) = _
      rw [ZMod.lift_coe]
      change z • (p : ZMod (p * k)) = _
      rw [zsmul_eq_mul]
      push_cast
      ring
    let β : ZMod (p * k) →+ ZMod p := (ZMod.castHom (dvd_mul_right p k) (ZMod p)).toAddMonoidHom
    have hβ : ∀ z : ℤ, β (z : ZMod (p * k)) = (z : ZMod p) := fun z =>
      map_intCast (ZMod.castHom (dvd_mul_right p k) (ZMod p)) z
    have hαinj : Function.Injective α := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
      rw [hα, ZMod.intCast_zmod_eq_zero_iff_dvd] at hx
      rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
      have hp' : (p : ℤ) ≠ 0 := by exact_mod_cast hp
      push_cast at hx
      rw [mul_comm z] at hx
      exact (mul_dvd_mul_iff_left hp').mp hx
    have hβsurj : Function.Surjective β := by
      intro y
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
      exact ⟨(z : ZMod (p * k)), hβ z⟩
    have hβα : ∀ x, β (α x) = 0 := by
      intro x
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
      rw [hα, hβ]
      push_cast
      rw [ZMod.natCast_self, mul_zero]
    have hker : ∀ y, β y = 0 → ∃ x, α x = y := by
      intro y hy
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
      rw [hβ, ZMod.intCast_zmod_eq_zero_iff_dvd] at hy
      obtain ⟨t, rfl⟩ := hy
      refine ⟨(t : ZMod k), ?_⟩
      rw [hα]
      congr 1
      ring
    let f : AddCommGrpCat.of (ULift.{u+1} (ZMod k)) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) :=
      AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp α).comp
        AddEquiv.ulift.toAddMonoidHom)
    let gg : AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod p)) :=
      AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp β).comp
        AddEquiv.ulift.toAddMonoidHom)
    have hw : f ≫ gg = 0 := by
      ext x
      exact hβα x.down
    refine ⟨f, gg, hw, ShortComplex.ShortExact.mk' ?_ ?_ ?_, ?_, ?_⟩
    · rw [ShortComplex.ab_exact_iff]
      intro x₂ hx₂
      obtain ⟨x₁, hx₁⟩ := hker x₂.down (congrArg ULift.down hx₂)
      exact ⟨ULift.up x₁, congrArg ULift.up hx₁⟩
    · rw [AddCommGrpCat.mono_iff_injective]
      intro a b hab
      exact ULift.ext _ _ (hαinj (congrArg ULift.down hab))
    · rw [AddCommGrpCat.epi_iff_surjective]
      intro y
      obtain ⟨x, hx⟩ := hβsurj y.down
      exact ⟨ULift.up x, congrArg ULift.up hx⟩
    · apply ULift.ext
      show α 1 = p • (1 : ZMod (p * k))
      have h1' := hα 1
      rw [Int.cast_one] at h1'
      rw [h1', nsmul_one]
      simp
    · apply ULift.ext
      show β 1 = 1
      exact map_one (ZMod.castHom (dvd_mul_right p k) (ZMod p))

  have s3a : ∀ (X : Scheme.{u}) (A B : Type (u+1)) [AddCommGroup A] [AddCommGroup B]
      (t : AddCommGrpCat.of A ⟶ AddCommGrpCat.of B) (U : X.Etale) (x : A),
      (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map t).hom.app
          (Opposite.op U)).hom (wcConstSec X A U x) = wcConstSec X B U (t.hom x) := by
    intro X A B _ _ t U x
    have h := toSheafify_naturality (Scheme.smallEtaleTopology X)
      ((Functor.const (X.Etale)ᵒᵖ).map t)
    exact (congrArg (fun φ => (φ.app (Opposite.op U)).hom x) h).symm
  have Hcn : ∀ (X : Scheme.{u}) (m : ℕ) (V : X.Etale) (n : ℕ) (x : ULift.{u+1} (ZMod m)),
      wcConstSec X (ULift.{u+1} (ZMod m)) V (n • x) =
        n • wcConstSec X (ULift.{u+1} (ZMod m)) V x := by
    intro X m V n x
    exact map_nsmul (((toSheafify (Scheme.smallEtaleTopology X)
      ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).app
        (Opposite.op V)).hom) n x
  have hinv : ∀ {P Q : Sheaf (Scheme.smallEtaleTopology S') AddCommGrpCat.{u+1}} (κ : P ≅ Q)
      (U : (S'.Etale)ᵒᵖ) (x : P.obj.obj U), (κ.inv.hom.app U).hom ((κ.hom.hom.app U).hom x) = x := by
    intro P Q κ U x
    have h := congrArg (fun φ : P ⟶ P => (φ.hom.app U).hom x) κ.hom_inv_id
    exact h
  have hg₀ : g ≫ (wcEtTop S).hom = (wcEtTop S').hom ≫ g :=
    (Category.comp_id _).trans (Category.id_comp _).symm

  have s3 : ∀ (L : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1} ⥤
        Sheaf (Scheme.smallEtaleTopology S') AddCommGrpCat.{u+1})
      (ρ : ∀ G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1},
        wcEtTransport g G (L.obj G)), wcR2gsNUT g L ρ →
      ∀ (m₁ m₂ : ℕ) (t : AddCommGrpCat.of (ULift.{u+1} (ZMod m₁)) ⟶
        AddCommGrpCat.of (ULift.{u+1} (ZMod m₂))) (n : ℕ),
      t.hom (ULift.up (1 : ZMod m₁)) = n • (ULift.up (1 : ZMod m₂) : ULift.{u+1} (ZMod m₂)) →
      ∀ (κ₁ : L.obj (wcConstZ S m₁) ≅ wcConstZ S' m₁) (κ₂ : L.obj (wcConstZ S m₂) ≅ wcConstZ S' m₂),
      (∀ hg : g ≫ (wcEtTop S).hom = (wcEtTop S').hom ≫ g,
        (κ₁.hom.hom.app (Opposite.op (wcEtTop S'))).hom
            ((ρ (wcConstZ S m₁)).ρ (wcEtTop S) (wcEtTop S') g hg
              (wcConstSec S (ULift.{u+1} (ZMod m₁)) (wcEtTop S) (ULift.up 1))) =
          wcConstSec S' (ULift.{u+1} (ZMod m₁)) (wcEtTop S') (ULift.up 1)) →
      (∀ hg : g ≫ (wcEtTop S).hom = (wcEtTop S').hom ≫ g,
        (κ₂.hom.hom.app (Opposite.op (wcEtTop S'))).hom
            ((ρ (wcConstZ S m₂)).ρ (wcEtTop S) (wcEtTop S') g hg
              (wcConstSec S (ULift.{u+1} (ZMod m₂)) (wcEtTop S) (ULift.up 1))) =
          wcConstSec S' (ULift.{u+1} (ZMod m₂)) (wcEtTop S') (ULift.up 1)) →
      κ₁.hom ≫ (constantSheaf (Scheme.smallEtaleTopology S') AddCommGrpCat.{u+1}).map t =
        L.map ((constantSheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}).map t) ≫ κ₂.hom := by
    intro L ρ hnut m₁ m₂ t n ht κ₁ κ₂ h₁ h₂
    have secS : (((constantSheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}).map t).hom.app
        (Opposite.op (wcEtTop S))).hom (wcConstSec S (ULift.{u+1} (ZMod m₁)) (wcEtTop S) (ULift.up 1)) =
        n • wcConstSec S (ULift.{u+1} (ZMod m₂)) (wcEtTop S) (ULift.up 1) := by
      rw [s3a, ht, Hcn]
    have secS' : (((constantSheaf (Scheme.smallEtaleTopology S') AddCommGrpCat.{u+1}).map t).hom.app
        (Opposite.op (wcEtTop S'))).hom
          (wcConstSec S' (ULift.{u+1} (ZMod m₁)) (wcEtTop S') (ULift.up 1)) =
        n • wcConstSec S' (ULift.{u+1} (ZMod m₂)) (wcEtTop S') (ULift.up 1) := by
      rw [s3a, ht, Hcn]
    have e1 : (κ₁.inv.hom.app (Opposite.op (wcEtTop S'))).hom
        (wcConstSec S' (ULift.{u+1} (ZMod m₁)) (wcEtTop S') (ULift.up 1)) =
        (ρ (wcConstZ S m₁)).ρ (wcEtTop S) (wcEtTop S') g hg₀
          (wcConstSec S (ULift.{u+1} (ZMod m₁)) (wcEtTop S) (ULift.up 1)) := by
      rw [← h₁ hg₀]
      exact hinv κ₁ _ _
    symm
    rw [← Iso.inv_comp_eq]
    apply wc_lsiaq_const_zmod_hom_ext S' m₁
    rw [secS']
    show (κ₂.hom.hom.app (Opposite.op (wcEtTop S'))).hom
      (((L.map ((constantSheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}).map t)).hom.app
        (Opposite.op (wcEtTop S'))).hom ((κ₁.inv.hom.app (Opposite.op (wcEtTop S'))).hom
          (wcConstSec S' (ULift.{u+1} (ZMod m₁)) (wcEtTop S') (ULift.up 1)))) = _
    rw [e1, ← hnut.2 (wcConstZ S m₁) (wcConstZ S m₂)
      ((constantSheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}).map t)
      (wcEtTop S) (wcEtTop S') g hg₀, secS, map_nsmul, map_nsmul, h₂ hg₀]

  haveI : Limits.PreservesFiniteLimits
      (constantSheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) :=
    Limits.comp_preservesFiniteLimits (Functor.const (Scheme.Etale S)ᵒᵖ)
      (presheafToSheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1})
  haveI : Limits.PreservesFiniteLimits
      (constantSheaf (Scheme.smallEtaleTopology S') AddCommGrpCat.{u+1}) :=
    Limits.comp_preservesFiniteLimits (Functor.const (Scheme.Etale S')ᵒᵖ)
      (presheafToSheaf (Scheme.smallEtaleTopology S') AddCommGrpCat.{u+1})

  have step : ∀ (a b : ℕ), a ≠ 0 →
      (∀ (E : wcEtPullData g a) (q : ℕ), Function.Bijective (wcEtPull E q)) →
      (∀ (E : wcEtPullData g b) (q : ℕ), Function.Bijective (wcEtPull E q)) →
      ∀ (E : wcEtPullData g (a * b)) (q : ℕ), Function.Bijective (wcEtPull E q) := by
    intro a b ha hQa hQb
    obtain ⟨A₀⟩ := wc_lsi_adjdata_exists g (a * b)
    obtain ⟨κa, hκa⟩ := wc_r2gs_adj_const_zmod_norm g a A₀.L A₀.adj A₀.ρ A₀.nut
    obtain ⟨κb, hκb⟩ := wc_r2gs_adj_const_zmod_norm g b A₀.L A₀.adj A₀.ρ A₀.nut
    let Aa : wcR2gsAdjData g a := ⟨A₀.L, A₀.adj, A₀.additive, A₀.presLim, A₀.presColim, A₀.ρ,
      A₀.nut, A₀.ε, A₀.epsNorm, κa, hκa⟩
    let Ab : wcR2gsAdjData g b := ⟨A₀.L, A₀.adj, A₀.additive, A₀.presLim, A₀.presColim, A₀.ρ,
      A₀.nut, A₀.ε, A₀.epsNorm, κb, hκb⟩
    have hPa := (s1 a Aa).mp hQa
    have hPb := (s1 b Ab).mp hQb

    let Ψ : ∀ {P : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}}
        {P' : Sheaf (Scheme.smallEtaleTopology S') AddCommGrpCat.{u+1}}
        (_ : A₀.L.obj P ⟶ P') (k : ℕ),
        Abelian.Ext (wcR2gsZ S) P k →+ Abelian.Ext (wcR2gsZ S') P' k :=
      fun τ k => ((Abelian.Ext.mk₀ A₀.ε).precomp _ (zero_add k)).comp
        (((Abelian.Ext.mk₀ τ).postcomp _ (add_zero k)).comp (A₀.L.mapExtAddHom _ _ k))
    have hΨ : ∀ {P : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}}
        {P' : Sheaf (Scheme.smallEtaleTopology S') AddCommGrpCat.{u+1}}
        (τ : A₀.L.obj P ⟶ P') (k : ℕ) (x : Abelian.Ext (wcR2gsZ S) P k),
        Ψ τ k x = (Abelian.Ext.mk₀ A₀.ε).comp ((Abelian.Ext.mapExactFunctor A₀.L x).comp
          (Abelian.Ext.mk₀ τ) (add_zero k)) (zero_add k) := fun _ _ _ => rfl

    have ladder : ∀ (SS : ShortComplex (Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}))
        (hSS : SS.ShortExact)
        (ST : ShortComplex (Sheaf (Scheme.smallEtaleTopology S') AddCommGrpCat.{u+1}))
        (hST : ST.ShortExact) (φ : SS.map A₀.L ⟶ ST),
        (∀ k, Function.Bijective (Ψ (P := SS.X₁) (P' := ST.X₁) φ.τ₁ k)) →
        (∀ k, Function.Bijective (Ψ (P := SS.X₃) (P' := ST.X₃) φ.τ₃ k)) →
        ∀ k, Function.Bijective (Ψ (P := SS.X₂) (P' := ST.X₂) φ.τ₂ k) := by
      intro SS hSS ST hST φ hα hγ

      have sq : ∀ {P Q : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}} (u' : P ⟶ Q)
          {P' Q' : Sheaf (Scheme.smallEtaleTopology S') AddCommGrpCat.{u+1}}
          (τP : A₀.L.obj P ⟶ P') (τQ : A₀.L.obj Q ⟶ Q') (v : P' ⟶ Q'),
          τP ≫ v = A₀.L.map u' ≫ τQ → ∀ (k : ℕ) (x : Abelian.Ext (wcR2gsZ S) P k),
          Ψ τQ k (x.comp (Abelian.Ext.mk₀ u') (add_zero k)) =
            (Ψ τP k x).comp (Abelian.Ext.mk₀ v) (add_zero k) := by
        intro P Q u' P' Q' τP τQ v hc k x
        have eL : Ψ τQ k (x.comp (Abelian.Ext.mk₀ u') (add_zero k)) =
            (Abelian.Ext.mk₀ A₀.ε).comp ((Abelian.Ext.mapExactFunctor A₀.L x).comp
              (Abelian.Ext.mk₀ (A₀.L.map u' ≫ τQ)) (add_zero k)) (zero_add k) := by
          rw [hΨ, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
            Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
        have eR : (Ψ τP k x).comp (Abelian.Ext.mk₀ v) (add_zero k) =
            (Abelian.Ext.mk₀ A₀.ε).comp ((Abelian.Ext.mapExactFunctor A₀.L x).comp
              (Abelian.Ext.mk₀ (τP ≫ v)) (add_zero k)) (zero_add k) := by
          rw [hΨ, Abelian.Ext.comp_assoc_of_third_deg_zero,
            Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
        rw [eL, eR, hc]

      let fS : ∀ k, Abelian.Ext (wcR2gsZ S) SS.X₁ k →+ Abelian.Ext (wcR2gsZ S) SS.X₂ k :=
        fun k => (Abelian.Ext.mk₀ SS.f).postcomp _ (add_zero k)
      let gS : ∀ k, Abelian.Ext (wcR2gsZ S) SS.X₂ k →+ Abelian.Ext (wcR2gsZ S) SS.X₃ k :=
        fun k => (Abelian.Ext.mk₀ SS.g).postcomp _ (add_zero k)
      let δS : ∀ k, Abelian.Ext (wcR2gsZ S) SS.X₃ k →+ Abelian.Ext (wcR2gsZ S) SS.X₁ (k + 1) :=
        fun k => hSS.extClass.postcomp _ (rfl : k + 1 = k + 1)
      let fT : ∀ k, Abelian.Ext (wcR2gsZ S') ST.X₁ k →+ Abelian.Ext (wcR2gsZ S') ST.X₂ k :=
        fun k => (Abelian.Ext.mk₀ ST.f).postcomp _ (add_zero k)
      let gT : ∀ k, Abelian.Ext (wcR2gsZ S') ST.X₂ k →+ Abelian.Ext (wcR2gsZ S') ST.X₃ k :=
        fun k => (Abelian.Ext.mk₀ ST.g).postcomp _ (add_zero k)
      let δT : ∀ k, Abelian.Ext (wcR2gsZ S') ST.X₃ k →+ Abelian.Ext (wcR2gsZ S') ST.X₁ (k + 1) :=
        fun k => hST.extClass.postcomp _ (rfl : k + 1 = k + 1)
      have sq1 : ∀ k (x : Abelian.Ext (wcR2gsZ S) SS.X₁ k),
          Ψ (P := SS.X₂) (P' := ST.X₂) φ.τ₂ k (fS k x) =
            fT k (Ψ (P := SS.X₁) (P' := ST.X₁) φ.τ₁ k x) :=
        fun k x => sq SS.f φ.τ₁ φ.τ₂ ST.f φ.comm₁₂ k x
      have sq2 : ∀ k (x : Abelian.Ext (wcR2gsZ S) SS.X₂ k),
          Ψ (P := SS.X₃) (P' := ST.X₃) φ.τ₃ k (gS k x) =
            gT k (Ψ (P := SS.X₂) (P' := ST.X₂) φ.τ₂ k x) :=
        fun k x => sq SS.g φ.τ₂ φ.τ₃ ST.g φ.comm₂₃ k x
      have sqδ : ∀ k (c : Abelian.Ext (wcR2gsZ S) SS.X₃ k),
          Ψ (P := SS.X₁) (P' := ST.X₁) φ.τ₁ (k + 1) (δS k c) =
            δT k (Ψ (P := SS.X₃) (P' := ST.X₃) φ.τ₃ k c) := by
        intro k c
        have eL : Ψ (P := SS.X₁) (P' := ST.X₁) φ.τ₁ (k + 1) (δS k c) =
            (Abelian.Ext.mk₀ A₀.ε).comp (((Abelian.Ext.mapExactFunctor A₀.L c).comp
              (Abelian.Ext.mk₀ φ.τ₃) (add_zero k)).comp hST.extClass rfl) (zero_add (k + 1)) := by
          rw [hΨ]
          show (Abelian.Ext.mk₀ A₀.ε).comp ((Abelian.Ext.mapExactFunctor A₀.L
              (c.comp hSS.extClass rfl)).comp (Abelian.Ext.mk₀ φ.τ₁) (add_zero (k + 1)))
              (zero_add (k + 1)) = _
          rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass,
            Abelian.Ext.comp_assoc_of_third_deg_zero,
            ShortComplex.ShortExact.extClass_naturality (hSS.map_of_exact A₀.L) hST φ,
            Abelian.Ext.comp_assoc_of_second_deg_zero]
        have eR : δT k (Ψ (P := SS.X₃) (P' := ST.X₃) φ.τ₃ k c) =
            (Abelian.Ext.mk₀ A₀.ε).comp (((Abelian.Ext.mapExactFunctor A₀.L c).comp
              (Abelian.Ext.mk₀ φ.τ₃) (add_zero k)).comp hST.extClass rfl) (zero_add (k + 1)) := by
          show ((Abelian.Ext.mk₀ A₀.ε).comp ((Abelian.Ext.mapExactFunctor A₀.L c).comp
              (Abelian.Ext.mk₀ φ.τ₃) (add_zero k)) (zero_add k)).comp hST.extClass rfl = _
          rw [Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ A₀.ε) _ _ (zero_add k) rfl (by omega)]
        rw [eL, eR]

      have E2S : ∀ k (x : Abelian.Ext (wcR2gsZ S) SS.X₂ k), gS k x = 0 → ∃ y, fS k y = x :=
        fun k x hx => Abelian.Ext.covariant_sequence_exact₂ _ hSS x hx
      have E2T : ∀ k (x : Abelian.Ext (wcR2gsZ S') ST.X₂ k), gT k x = 0 → ∃ y, fT k y = x :=
        fun k x hx => Abelian.Ext.covariant_sequence_exact₂ _ hST x hx
      have E3S : ∀ k (x : Abelian.Ext (wcR2gsZ S) SS.X₃ k), δS k x = 0 → ∃ y, gS k y = x :=
        fun k x hx => Abelian.Ext.covariant_sequence_exact₃ _ hSS x rfl hx
      have E1T : ∀ j (x : Abelian.Ext (wcR2gsZ S') ST.X₁ (j + 1)), fT (j + 1) x = 0 →
          ∃ y, δT j y = x :=
        fun j x hx => Abelian.Ext.covariant_sequence_exact₁ _ hST x hx rfl
      have Z1S : ∀ j (c : Abelian.Ext (wcR2gsZ S) SS.X₃ j), fS (j + 1) (δS j c) = 0 := by
        intro j c
        show (c.comp hSS.extClass rfl).comp (Abelian.Ext.mk₀ SS.f) (add_zero (j + 1)) = 0
        rw [Abelian.Ext.comp_assoc_of_third_deg_zero, ShortComplex.ShortExact.extClass_comp,
          Abelian.Ext.comp_zero]
      have Z2T : ∀ k (x : Abelian.Ext (wcR2gsZ S') ST.X₂ k), δT k (gT k x) = 0 := by
        intro k x
        show (x.comp (Abelian.Ext.mk₀ ST.g) (add_zero k)).comp hST.extClass rfl = 0
        rw [Abelian.Ext.comp_assoc_of_second_deg_zero, ShortComplex.ShortExact.comp_extClass,
          Abelian.Ext.comp_zero]
      have fT0inj : Function.Injective (fT 0) := by
        haveI := hST.mono_f
        exact Abelian.Ext.postcomp_mk₀_injective_of_mono _ ST.f

      intro k
      constructor
      · rw [injective_iff_map_eq_zero]
        intro b hb
        have h1' : Ψ (P := SS.X₃) (P' := ST.X₃) φ.τ₃ k (gS k b) = 0 := by
          rw [sq2 k b, hb, map_zero]
        have h2 : gS k b = 0 := (injective_iff_map_eq_zero _).mp (hγ k).1 _ h1'
        obtain ⟨a, rfl⟩ := E2S k b h2
        have h3 : fT k (Ψ (P := SS.X₁) (P' := ST.X₁) φ.τ₁ k a) = 0 := by
          rw [← sq1 k a]; exact hb
        cases k with
        | zero =>
          have h4 : Ψ (P := SS.X₁) (P' := ST.X₁) φ.τ₁ 0 a = 0 :=
            (injective_iff_map_eq_zero _).mp fT0inj _ h3
          have h5 : a = 0 := (injective_iff_map_eq_zero _).mp (hα 0).1 _ h4
          rw [h5, map_zero]
        | succ j =>
          obtain ⟨c', hc'⟩ := E1T j _ h3
          obtain ⟨c, rfl⟩ := (hγ j).2 c'
          have h6 : Ψ (P := SS.X₁) (P' := ST.X₁) φ.τ₁ (j + 1) (δS j c) =
              Ψ (P := SS.X₁) (P' := ST.X₁) φ.τ₁ (j + 1) a := by
            rw [sqδ j c, hc']
          have h7 := (hα (j + 1)).1 h6
          rw [← h7]
          exact Z1S j c
      · intro b'
        obtain ⟨c, hc⟩ := (hγ k).2 (gT k b')
        have h1' : Ψ (P := SS.X₁) (P' := ST.X₁) φ.τ₁ (k + 1) (δS k c) = 0 := by
          rw [sqδ k c, hc]; exact Z2T k b'
        have h2 : δS k c = 0 := (injective_iff_map_eq_zero _).mp (hα (k + 1)).1 _ h1'
        obtain ⟨b, rfl⟩ := E3S k c h2
        have h3 : gT k (b' - Ψ (P := SS.X₂) (P' := ST.X₂) φ.τ₂ k b) = 0 := by
          rw [map_sub, ← sq2 k b, hc, sub_self]
        obtain ⟨a', ha'⟩ := E2T k _ h3
        obtain ⟨a, rfl⟩ := (hα k).2 a'
        exact ⟨b + fS k a, by rw [map_add, sq1 k a, ha', add_sub_cancel]⟩

    obtain ⟨f, gg, hw, hSE, hf1, hg1⟩ := s2 a b ha
    have hSS := hSE.map_of_exact (constantSheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1})
    have hST := hSE.map_of_exact (constantSheaf (Scheme.smallEtaleTopology S') AddCommGrpCat.{u+1})
    have w₁₂ := s3 A₀.L A₀.ρ A₀.nut b (a * b) f a hf1 κb A₀.κ hκb A₀.kapNorm
    have w₂₃ := s3 A₀.L A₀.ρ A₀.nut (a * b) a gg 1 (by rw [hg1, one_nsmul]) A₀.κ κa A₀.kapNorm hκa
    let φ : ((ShortComplex.mk f gg hw).map
          (constantSheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1})).map A₀.L ⟶
        (ShortComplex.mk f gg hw).map
          (constantSheaf (Scheme.smallEtaleTopology S') AddCommGrpCat.{u+1}) :=
      ShortComplex.homMk κb.hom A₀.κ.hom κa.hom w₁₂ w₂₃
    have hB1 : ∀ k, Function.Bijective (Ψ (P := ((ShortComplex.mk f gg hw).map
          (constantSheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1})).X₁)
        (P' := ((ShortComplex.mk f gg hw).map
          (constantSheaf (Scheme.smallEtaleTopology S') AddCommGrpCat.{u+1})).X₁) φ.τ₁ k) := by
      intro k
      have e : ⇑(Ψ (P := ((ShortComplex.mk f gg hw).map
          (constantSheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1})).X₁)
          (P' := ((ShortComplex.mk f gg hw).map
          (constantSheaf (Scheme.smallEtaleTopology S') AddCommGrpCat.{u+1})).X₁) φ.τ₁ k) =
          wcR2gsAPull Ab k := funext fun x => rfl
      rw [e]
      exact hPb k
    have hB3 : ∀ k, Function.Bijective (Ψ (P := ((ShortComplex.mk f gg hw).map
          (constantSheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1})).X₃)
        (P' := ((ShortComplex.mk f gg hw).map
          (constantSheaf (Scheme.smallEtaleTopology S') AddCommGrpCat.{u+1})).X₃) φ.τ₃ k) := by
      intro k
      have e : ⇑(Ψ (P := ((ShortComplex.mk f gg hw).map
          (constantSheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1})).X₃)
          (P' := ((ShortComplex.mk f gg hw).map
          (constantSheaf (Scheme.smallEtaleTopology S') AddCommGrpCat.{u+1})).X₃) φ.τ₃ k) =
          wcR2gsAPull Aa k := funext fun x => rfl
      rw [e]
      exact hPa k
    have hmain := ladder _ hSS _ hST φ hB1 hB3
    refine (s1 (a * b) A₀).mpr (fun k => ?_)
    have e : ⇑(Ψ (P := ((ShortComplex.mk f gg hw).map
        (constantSheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1})).X₂)
        (P' := ((ShortComplex.mk f gg hw).map
        (constantSheaf (Scheme.smallEtaleTopology S') AddCommGrpCat.{u+1})).X₂) φ.τ₂ k) =
        wcR2gsAPull A₀ k := funext fun x => rfl
    rw [← e]
    exact hmain k

  have main : ∀ j : ℕ, ∀ (E : wcEtPullData g (ℓ ^ (j + 1))) (q : ℕ),
      Function.Bijective (wcEtPull E q) := by
    intro j
    induction j with
    | zero => rw [zero_add, pow_one]; exact h1
    | succ j ih =>
      rw [pow_succ' ℓ (j + 1)]
      exact step ℓ (ℓ ^ (j + 1)) hℓ.ne_zero h1 ih
  obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
  exact main j E q

theorem wc_hmtg_generic_top_generator (L : Type u) [Field L] [IsSepClosed L]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓL : ((ℓ : ℕ) : L) ≠ 0)
    (n : ℕ) (hnm : n = 2 * (n / 2)) (hn2 : 2 ≤ n) (c₀ : L) (hc₀ : c₀ ≠ 0) (k : ℕ) (hk : 1 ≤ k) :
    ∃ x : wcZModProEtExt (Spec (.of (wcQuadModelRing L n c₀
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))))
        (ℓ ^ k) (n - 1),
      ℓ ^ k ≤ addOrderOf x :=
by
  classical
  obtain ⟨m, hnm', hm⟩ : ∃ m : ℕ, n = 2 * m ∧ 1 ≤ m := ⟨n / 2, hnm, by omega⟩

  have s1 : ∃ (K : Type u) (_ : Field K), IsAlgClosed K ∧ Nonempty (K →+* L) := by
    rcases CharP.char_is_prime_or_zero L (ringChar L) with hp | h0
    · haveI : Fact (Nat.Prime (ringChar L)) := ⟨hp⟩
      letI : Algebra (ZMod (ringChar L)) L := ZMod.algebra L (ringChar L)
      haveI : IsSepClosure (ZMod (ringChar L)) (separableClosure (ZMod (ringChar L)) L) :=
        separableClosure.isSepClosure _ _
      haveI : IsSepClosed (separableClosure (ZMod (ringChar L)) L) :=
        IsSepClosure.sep_closed (ZMod (ringChar L))
      haveI : Algebra.IsAlgebraic (ZMod (ringChar L)) (separableClosure (ZMod (ringChar L)) L) :=
        separableClosure.isAlgebraic _ _
      haveI : PerfectField (separableClosure (ZMod (ringChar L)) L) :=
        Algebra.IsAlgebraic.perfectField (ZMod (ringChar L))
      exact ⟨_, inferInstance, IsSepClosed.isAlgClosed_of_perfectField _,
        ⟨(separableClosure (ZMod (ringChar L)) L).val.toRingHom⟩⟩
    · haveI : CharP L 0 := h0 ▸ ringChar.charP L
      haveI : CharZero L := CharP.charP_to_charZero L
      haveI : IsSepClosure ℚ (separableClosure ℚ L) := separableClosure.isSepClosure _ _
      haveI : IsSepClosed (separableClosure ℚ L) := IsSepClosure.sep_closed ℚ
      haveI : Algebra.IsAlgebraic ℚ (separableClosure ℚ L) := separableClosure.isAlgebraic _ _
      haveI : PerfectField (separableClosure ℚ L) := Algebra.IsAlgebraic.perfectField ℚ
      exact ⟨_, inferInstance, IsSepClosed.isAlgClosed_of_perfectField _,
        ⟨(separableClosure ℚ L).val.toRingHom⟩⟩
  obtain ⟨K, _, hK, ⟨σ⟩⟩ := s1
  haveI := hK
  have hℓK : ((ℓ : ℕ) : K) ≠ 0 := by
    intro h
    apply hℓL
    rw [← map_natCast σ ℓ, h, map_zero]

  have hcl : IsClosed (Set.range (Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff : MvPolynomial (Fin m) K →+* K)))) := by
    have he : (Set.range (Spec.map (CommRingCat.ofHom
        (MvPolynomial.constantCoeff : MvPolynomial (Fin m) K →+* K)))) =
        PrimeSpectrum.zeroLocus (Set.range (MvPolynomial.X : Fin m → MvPolynomial (Fin m) K)) := by
      ext x
      rw [wc_affine_origin_range_iff K m x]
      constructor
      · intro h
        rintro _ ⟨i, rfl⟩
        exact h i
      · intro h i
        exact h ⟨i, rfl⟩
    rw [he]
    exact PrimeSpectrum.isClosed_zeroLocus _
  obtain ⟨U₀, hU₀⟩ : ∃ U₀ : (Spec (.of (MvPolynomial (Fin m) K))).Opens,
      (U₀ : Set (Spec (.of (MvPolynomial (Fin m) K)))) =
        (Set.range (Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin m) K →+* K))))ᶜ :=
    ⟨⟨_, hcl.isOpen_compl⟩, rfl⟩

  have havoid : ∀ y : Spec (.of (wcQuadModelRing L n c₀
      (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))),
      Spec.map (CommRingCat.ofHom (MvPolynomial.eval₂Hom
        ((algebraMap L (wcQuadModelRing L n c₀
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))).comp
            σ)
        (fun t : Fin m => Ideal.Quotient.mk (wcQuadModelIdeal L n c₀
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
          (MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n))))) y ∉
        Set.range (Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin m) K →+* K))) := by
    intro y hy
    have hX := (wc_affine_origin_range_iff K m _).mp hy
    have h2 : ∀ t : Fin m, (MvPolynomial.eval₂Hom
        ((algebraMap L (wcQuadModelRing L n c₀
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))).comp
            σ)
        (fun t : Fin m => Ideal.Quotient.mk (wcQuadModelIdeal L n c₀
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
          (MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n)))) (MvPolynomial.X t) ∈ y.asIdeal :=
      fun t => hX t
    have hmem : ∀ p : Fin n, p.val % 2 = 0 →
        Ideal.Quotient.mk (wcQuadModelIdeal L n c₀
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
          (MvPolynomial.X p) ∈ y.asIdeal := by
      intro p hp
      have ht : p.val / 2 < m := by omega
      have h3 := h2 ⟨p.val / 2, ht⟩
      rw [MvPolynomial.eval₂Hom_X'] at h3
      have e : p = (⟨2 * (p.val / 2), by omega⟩ : Fin n) := Fin.ext (by simp only; omega)
      rw [e]
      exact h3
    have hS : Ideal.Quotient.mk (wcQuadModelIdeal L n c₀
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
          (∑ p, ∑ q, MvPolynomial.C ((Matrix.of fun p q : Fin n =>
            if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0) p q) *
            MvPolynomial.X p * MvPolynomial.X q) ∈ y.asIdeal := by
      rw [map_sum]
      refine Ideal.sum_mem _ (fun p _ => ?_)
      rw [map_sum]
      refine Ideal.sum_mem _ (fun q _ => ?_)
      by_cases hpq : p.val % 2 = 0 ∧ q.val = p.val + 1
      · rw [map_mul, map_mul]
        exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ (hmem p hpq.1))
      · simp only [Matrix.of_apply, if_neg hpq, map_zero, zero_mul]
        exact y.asIdeal.zero_mem
    have hEq : Ideal.Quotient.mk (wcQuadModelIdeal L n c₀
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
          (∑ p, ∑ q, MvPolynomial.C ((Matrix.of fun p q : Fin n =>
            if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0) p q) *
            MvPolynomial.X p * MvPolynomial.X q) =
        Ideal.Quotient.mk (wcQuadModelIdeal L n c₀
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
          (MvPolynomial.C c₀) :=
      Ideal.Quotient.eq.mpr (Ideal.subset_span (Set.mem_singleton _))
    rw [hEq] at hS
    have hunit : IsUnit (Ideal.Quotient.mk (wcQuadModelIdeal L n c₀
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
          (MvPolynomial.C c₀)) :=
      ((Ne.isUnit hc₀).map MvPolynomial.C).map _
    exact y.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hS hunit)

  have hrange : Set.range (Spec.map (CommRingCat.ofHom (MvPolynomial.eval₂Hom
        ((algebraMap L (wcQuadModelRing L n c₀
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))).comp
            σ)
        (fun t : Fin m => Ideal.Quotient.mk (wcQuadModelIdeal L n c₀
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
          (MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n)))))) ⊆ Set.range U₀.ι := by
    rintro _ ⟨y, rfl⟩
    rw [Scheme.Opens.range_ι, hU₀]
    exact havoid y
  have hbij := wc_pmhpi_quadric_punct_pull_bij K L σ ℓ hℓK n m hnm' hm c₀ hc₀ U₀ hU₀
    (IsOpenImmersion.lift U₀.ι _ hrange) (IsOpenImmersion.lift_fac _ _ hrange) k hk (n - 1)
  obtain ⟨De, hDe⟩ := wc_zmod_pull_data_exists (IsOpenImmersion.lift U₀.ι _ hrange) (ℓ ^ k)
  obtain ⟨ω, hω⟩ := wc_pmtv_punct_top_generator K ℓ hℓK m (n - 1) hm (by omega) U₀ hU₀ k hk
  refine ⟨wcZModPull De (n - 1) ω, ?_⟩
  rw [addOrderOf_injective (wcZModPull De (n - 1)) (hbij De hDe).1 ω]
  exact hω

theorem wc_hmtg_restr_transfer (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (π : A) (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓA : IsUnit ((ℓ : ℕ) : A))
    (n : ℕ) (hnm : n = 2 * (n / 2)) (hn2 : 2 ≤ n)
    (B : Type u) [CommRing B] [IsNoetherianRing B] [HenselianLocalRing B]
    [IsSepClosed (IsLocalRing.ResidueField B)]
    (β' : wcQuadModelRing A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0) →+* B)
    (hβ' : WeaklyEtale (Spec.map (CommRingCat.ofHom β')))
    (hβ'X : ∀ p, β' (Ideal.Quotient.mk (wcQuadModelIdeal A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))
          (MvPolynomial.X p)) ∈ IsLocalRing.maximalIdeal B)
    (L : Type u) [Field L] [IsSepClosed L] (lam : A →+* L) (hlamπ : lam π ≠ 0)
    {Pm : Scheme.{u}} (p₁ : Pm ⟶ Spec (.of B)) (p₂ : Pm ⟶ Spec (.of L))
    (hPm : IsPullback p₁ p₂
      (Spec.map (CommRingCat.ofHom (β'.comp (algebraMap A (wcQuadModelRing A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))))))
      (Spec.map (CommRingCat.ofHom lam)))
    (h₀ : Pm ⟶ Spec (.of (wcQuadModelRing L n (lam π)
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))))
    (hh₀κ : h₀ ≫ Spec.map (CommRingCat.ofHom (wcHypBaseMap lam n π)) =
      p₁ ≫ Spec.map (CommRingCat.ofHom β'))
    (hh₀L : h₀ ≫ Spec.map (CommRingCat.ofHom (algebraMap L (wcQuadModelRing L n (lam π)
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0)))) =
      p₂)
    (k : ℕ) (hk : 1 ≤ k)
    (Hbij : ∀ (r : Limits.pullback (Spec.map (CommRingCat.ofHom β') ≫ wcQuadModelStr A n π
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))
          (Spec.map (CommRingCat.ofHom ((algebraMap L (AlgebraicClosure L)).comp lam))) ⟶
        Limits.pullback (wcQuadModelStr A n π
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))
          (Spec.map (CommRingCat.ofHom ((algebraMap L (AlgebraicClosure L)).comp lam)))),
      r ≫ Limits.pullback.fst _ _ = Limits.pullback.fst _ _ ≫ Spec.map (CommRingCat.ofHom β') →
      r ≫ Limits.pullback.snd _ _ = Limits.pullback.snd _ _ →
      ∀ (E : wcEtPullData r (ℓ ^ k)) (q : ℕ), Function.Bijective (wcEtPull E q)) :
    ∀ D₀ : wcZModPullData h₀ (ℓ ^ k), wcZModPullCanonical D₀ →
      Function.Injective (wcZModPull D₀ (n - 1)) :=
by
  classical
  intro D₀ hD₀

  have hal : ∀ l : L, algebraMap L (wcQuadModelRing L n (lam π)
      (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0)) l =
      Ideal.Quotient.mk (wcQuadModelIdeal L n (lam π)
      (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
        (MvPolynomial.C l) := fun l => rfl
  have kill : ∀ (T : CommRingCat.{u}) (s₁ : wcQuadModelRing A n π
      (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0) →+* T)
      (s₂ : L →+* T), (∀ a, s₂ (lam a) = s₁ (Ideal.Quotient.mk (wcQuadModelIdeal A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))
          (MvPolynomial.C a))) →
      ∀ x ∈ wcQuadModelIdeal L n (lam π)
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0),
        MvPolynomial.eval₂Hom s₂ (fun p => s₁ (Ideal.Quotient.mk (wcQuadModelIdeal A n π
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))
            (MvPolynomial.X p))) x = 0 := by
    intro T s₁ s₂ hs x hx
    have hcomp : (MvPolynomial.eval₂Hom s₂ (fun p => s₁ (Ideal.Quotient.mk (wcQuadModelIdeal A n π
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))
            (MvPolynomial.X p)))).comp (MvPolynomial.map lam) =
        s₁.comp (Ideal.Quotient.mk (wcQuadModelIdeal A n π
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))) := by
      apply MvPolynomial.ringHom_ext
      · intro a
        rw [RingHom.comp_apply, RingHom.comp_apply, MvPolynomial.map_C, MvPolynomial.eval₂Hom_C, hs]
      · intro i
        rw [RingHom.comp_apply, RingHom.comp_apply, MvPolynomial.map_X, MvPolynomial.eval₂Hom_X']
    have hG : MvPolynomial.map lam (∑ p : Fin n, ∑ q : Fin n,
          MvPolynomial.C ((Matrix.of fun p q : Fin n =>
            if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0) p q) *
            MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C π) =
        ∑ p : Fin n, ∑ q : Fin n,
          MvPolynomial.C ((Matrix.of fun p q : Fin n =>
            if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0) p q) *
            MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C (lam π) := by
      simp only [map_sub, map_sum, map_mul, MvPolynomial.map_C, MvPolynomial.map_X]
      congr 1
      refine Finset.sum_congr rfl fun p _ => Finset.sum_congr rfl fun q _ => ?_
      congr 3
      simp only [Matrix.of_apply]
      split_ifs <;> simp
    unfold wcQuadModelIdeal at hx
    obtain ⟨t, rfl⟩ := Ideal.mem_span_singleton'.mp hx
    rw [map_mul, ← hG, ← RingHom.comp_apply, hcomp, RingHom.comp_apply,
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _)), map_zero, mul_zero]
  have hw : CommRingCat.ofHom (algebraMap A (wcQuadModelRing A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))) ≫
      CommRingCat.ofHom (wcHypBaseMap lam n π) =
      CommRingCat.ofHom lam ≫ CommRingCat.ofHom (algebraMap L (wcQuadModelRing L n (lam π)
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))) := by
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro a
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom]
    rw [hal]
    show wcHypBaseMap lam n π (Ideal.Quotient.mk _ (MvPolynomial.C a)) = _
    unfold wcHypBaseMap
    rw [Ideal.quotientMap_mk, MvPolynomial.map_C]
  have hcond : ∀ (s : Limits.PushoutCocone (CommRingCat.ofHom (algebraMap A (wcQuadModelRing A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))))
        (CommRingCat.ofHom lam)) (a : A),
      s.inr.hom (lam a) = s.inl.hom (Ideal.Quotient.mk (wcQuadModelIdeal A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))
          (MvPolynomial.C a)) := by
    intro s a
    have := congrArg (fun f => f.hom a) s.condition
    exact this.symm
  have hpo : IsPushout (CommRingCat.ofHom (algebraMap A (wcQuadModelRing A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))))
      (CommRingCat.ofHom lam) (CommRingCat.ofHom (wcHypBaseMap lam n π))
      (CommRingCat.ofHom (algebraMap L (wcQuadModelRing L n (lam π)
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0)))) := by
    refine IsPushout.of_isColimit (Limits.PushoutCocone.IsColimit.mk hw
      (fun s => CommRingCat.ofHom (Ideal.Quotient.lift _
        (MvPolynomial.eval₂Hom s.inr.hom (fun p => s.inl.hom (Ideal.Quotient.mk (wcQuadModelIdeal A n π
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))
            (MvPolynomial.X p)))) (kill s.pt s.inl.hom s.inr.hom (hcond s))))
      (fun s => ?_) (fun s => ?_) (fun s m h1 h2 => ?_))
    · apply CommRingCat.hom_ext
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro a
        simp only [RingHom.comp_apply, CommRingCat.hom_comp, CommRingCat.hom_ofHom, wcHypBaseMap,
          Ideal.quotientMap_mk, MvPolynomial.map_C, Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C]
        exact hcond s a
      · intro i
        simp only [RingHom.comp_apply, CommRingCat.hom_comp, CommRingCat.hom_ofHom, wcHypBaseMap,
          Ideal.quotientMap_mk, MvPolynomial.map_X, Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X']
    · apply CommRingCat.hom_ext
      apply RingHom.ext
      intro l
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom]
      rw [hal, Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C]
    · apply CommRingCat.hom_ext
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro l
        have := congrArg (fun f => f.hom l) h2
        simp only [RingHom.comp_apply, CommRingCat.hom_ofHom, Ideal.Quotient.lift_mk,
          MvPolynomial.eval₂Hom_C]
        exact this
      · intro i
        have := congrArg (fun f => f.hom (Ideal.Quotient.mk (wcQuadModelIdeal A n π
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))
            (MvPolynomial.X i))) h1
        simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom, wcHypBaseMap,
          Ideal.quotientMap_mk, MvPolynomial.map_X] at this
        simp only [RingHom.comp_apply, CommRingCat.hom_ofHom, Ideal.Quotient.lift_mk,
          MvPolynomial.eval₂Hom_X']
        exact this
  have Q1 : IsPullback (Spec.map (CommRingCat.ofHom (wcHypBaseMap lam n π)))
      (Spec.map (CommRingCat.ofHom (algebraMap L (wcQuadModelRing L n (lam π)
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0)))))
      (wcQuadModelStr A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))
      (Spec.map (CommRingCat.ofHom lam)) :=
    isPullback_SpecMap_of_isPushout _ _ _ _ hpo

  have e₁ : Spec.map (CommRingCat.ofHom (β'.comp (algebraMap A (wcQuadModelRing A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))))) =
      Spec.map (CommRingCat.ofHom β') ≫ wcQuadModelStr A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0) := by
    rw [CommRingCat.ofHom_comp, Spec.map_comp]
  have e₂ : Spec.map (CommRingCat.ofHom ((algebraMap L (AlgebraicClosure L)).comp lam)) =
      Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))) ≫
        Spec.map (CommRingCat.ofHom lam) := by
    rw [CommRingCat.ofHom_comp, Spec.map_comp]

  obtain ⟨r, hr₁, hr₂⟩ : ∃ r : Limits.pullback (Spec.map (CommRingCat.ofHom β') ≫ wcQuadModelStr A n π
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))
          (Spec.map (CommRingCat.ofHom ((algebraMap L (AlgebraicClosure L)).comp lam))) ⟶
        Limits.pullback (wcQuadModelStr A n π
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))
          (Spec.map (CommRingCat.ofHom ((algebraMap L (AlgebraicClosure L)).comp lam))),
      r ≫ Limits.pullback.fst _ _ = Limits.pullback.fst _ _ ≫ Spec.map (CommRingCat.ofHom β') ∧
      r ≫ Limits.pullback.snd _ _ = Limits.pullback.snd _ _ :=
    ⟨Limits.pullback.lift _ _ (by rw [Category.assoc]; exact Limits.pullback.condition),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have Hr := Hbij r hr₁ hr₂

  obtain ⟨b, hb₁, hb₂⟩ : ∃ b : Limits.pullback (Spec.map (CommRingCat.ofHom β') ≫ wcQuadModelStr A n π
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))
          (Spec.map (CommRingCat.ofHom ((algebraMap L (AlgebraicClosure L)).comp lam))) ⟶ Pm,
      b ≫ p₁ = Limits.pullback.fst _ _ ∧
      b ≫ p₂ = Limits.pullback.snd _ _ ≫
        Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))) :=
    ⟨hPm.lift _ _ (by rw [e₁, Category.assoc, ← e₂]; exact Limits.pullback.condition),
      hPm.lift_fst _ _ _, hPm.lift_snd _ _ _⟩

  obtain ⟨a, ha₁, ha₂⟩ : ∃ a : Limits.pullback (wcQuadModelStr A n π
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))
          (Spec.map (CommRingCat.ofHom ((algebraMap L (AlgebraicClosure L)).comp lam))) ⟶
        Spec (.of (wcQuadModelRing L n (lam π)
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))),
      a ≫ Spec.map (CommRingCat.ofHom (wcHypBaseMap lam n π)) = Limits.pullback.fst _ _ ∧
      a ≫ Spec.map (CommRingCat.ofHom (algebraMap L (wcQuadModelRing L n (lam π)
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0)))) =
        Limits.pullback.snd _ _ ≫ Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))) :=
    ⟨Q1.lift _ _ (by rw [Category.assoc, ← e₂]; exact Limits.pullback.condition),
      Q1.lift_fst _ _ _, Q1.lift_snd _ _ _⟩

  have hsq : b ≫ h₀ = r ≫ a := by
    apply Q1.hom_ext
    · simp only [Category.assoc]
      rw [hh₀κ, ha₁, ← Category.assoc, hb₁, hr₁]
    · simp only [Category.assoc]
      rw [hh₀L, hb₂, ha₂, ← Category.assoc, hr₂]

  have outer0 : ∀ g : Spec (.of (AlgebraicClosure L)) ⟶ Spec (.of A),
      g = Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))) ≫
        Spec.map (CommRingCat.ofHom lam) →
      IsPullback (Limits.pullback.fst (wcQuadModelStr A n π
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0)) g)
        (Limits.pullback.snd _ g) (wcQuadModelStr A n π
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))
        (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))) ≫
          Spec.map (CommRingCat.ofHom lam)) := by
    intro g hg
    subst hg
    exact IsPullback.of_hasPullback _ _
  have outer := outer0 _ e₂
  rw [← ha₁] at outer
  have ha_pb := IsPullback.of_right outer ha₂ Q1

  have hint : (algebraMap L (AlgebraicClosure L)).IsIntegral :=
    algebraMap_isIntegral_iff.mpr inferInstance
  have hne : ℓ ^ k ≠ 0 := pow_ne_zero k (Fact.out : Nat.Prime ℓ).ne_zero
  have Ha := wc_r2gs_integral_field_ext_pull_bij L (AlgebraicClosure L)
    (algebraMap L (AlgebraicClosure L)) hint _ _ _ a _ ha_pb (ℓ ^ k) hne
  have Het : ∀ (E : wcEtPullData h₀ (ℓ ^ k)) (q : ℕ), Function.Injective (wcEtPull E q) := by
    intro E q x y hxy
    obtain ⟨Eb⟩ := wc_et_zmod_pull_data_exists b (ℓ ^ k)
    obtain ⟨Ea⟩ := wc_et_zmod_pull_data_exists a (ℓ ^ k)
    obtain ⟨Er⟩ := wc_et_zmod_pull_data_exists r (ℓ ^ k)
    obtain ⟨Ec⟩ := wc_et_zmod_pull_data_exists (b ≫ h₀) (ℓ ^ k)
    have h1 := wc_et_pull_comp h₀ b (b ≫ h₀) rfl E Eb Ec q
    have h2 := wc_et_pull_comp a r (b ≫ h₀) hsq.symm Ea Er Ec q
    apply (Ha Ea q).1
    apply (Hr Er q).1
    rw [← h2 x, ← h2 y, h1 x, h1 y, hxy]

  haveI : IsAffine Pm := IsAffine.of_isIso hPm.isoPullback.hom
  obtain ⟨Θ, hΘ, hnat⟩ := wc_zmod_et_proet_natural_comparison_all.{u} (ℓ ^ k) (n - 1)
  obtain ⟨E⟩ := wc_et_zmod_pull_data_exists h₀ (ℓ ^ k)
  intro y₁ y₂ hy
  obtain ⟨x₁, rfl⟩ := (hΘ _ inferInstance inferInstance).2 y₁
  obtain ⟨x₂, rfl⟩ := (hΘ _ inferInstance inferInstance).2 y₂
  rw [hnat h₀ D₀ hD₀ E x₁, hnat h₀ D₀ hD₀ E x₂] at hy
  rw [Het E (n - 1) ((hΘ Pm inferInstance inferInstance).1 hy)]

theorem wc_pmhpi_hyp_model_top_generator (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (π : A) (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓA : IsUnit ((ℓ : ℕ) : A))
    (n : ℕ) (hnm : n = 2 * (n / 2)) (hn2 : 2 ≤ n)
    (B : Type u) [CommRing B] [IsNoetherianRing B] [HenselianLocalRing B]
    [IsSepClosed (IsLocalRing.ResidueField B)]
    (β' : wcQuadModelRing A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0) →+* B)
    (hβ' : WeaklyEtale (Spec.map (CommRingCat.ofHom β')))
    (hβ'X : ∀ p, β' (Ideal.Quotient.mk (wcQuadModelIdeal A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))
          (MvPolynomial.X p)) ∈ IsLocalRing.maximalIdeal B)
    (L : Type u) [Field L] [IsSepClosed L] (lam : A →+* L) (hlamπ : lam π ≠ 0)
    {Pm : Scheme.{u}} (p₁ : Pm ⟶ Spec (.of B)) (p₂ : Pm ⟶ Spec (.of L))
    (hPm : IsPullback p₁ p₂
      (Spec.map (CommRingCat.ofHom (β'.comp (algebraMap A (wcQuadModelRing A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))))))
      (Spec.map (CommRingCat.ofHom lam)))
    (h₀ : Pm ⟶ Spec (.of (wcQuadModelRing L n (lam π)
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))))
    (hh₀κ : h₀ ≫ Spec.map (CommRingCat.ofHom (wcHypBaseMap lam n π)) =
      p₁ ≫ Spec.map (CommRingCat.ofHom β'))
    (hh₀L : h₀ ≫ Spec.map (CommRingCat.ofHom (algebraMap L (wcQuadModelRing L n (lam π)
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0)))) =
      p₂)
    (k : ℕ) (hk : 1 ≤ k) :
    ∀ D₀ : wcZModPullData h₀ (ℓ ^ k), wcZModPullCanonical D₀ →
      ∃ x : wcZModProEtExt (Spec (.of (wcQuadModelRing L n (lam π)
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))))
          (ℓ ^ k) (n - 1),
        ℓ ^ k ≤ addOrderOf (wcZModPull D₀ (n - 1) x) :=
by
  classical
  intro D₀ hD₀

  obtain ⟨hdom, hdvr⟩ := wc_hmtg_base_dvr A π hπ n hnm hn2 B β' hβ' hβ'X L lam hlamπ

  obtain ⟨x₀, hx₀, hx₀s, Λ₀, _, _, W₀, φ₀, hsh⟩ :=
    wc_hmtg_shens_identify A π hπ n hnm hn2 B β' hβ' hβ'X

  have hc : IsUnit ((Matrix.of fun p q : Fin n =>
      if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0) +
      (Matrix.of fun p q : Fin n =>
      if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0).transpose).det := by
    set M := (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0) +
        (Matrix.of fun p q : Fin n =>
          if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0).transpose with hM
    have hs : ∀ p : Fin n, (if p.val % 2 = 0 then p.val + 1 else p.val - 1) < n := by
      intro p
      have := p.isLt
      split_ifs <;> omega
    let s : Fin n → Fin n := fun p => ⟨if p.val % 2 = 0 then p.val + 1 else p.val - 1, hs p⟩
    have hsv : ∀ p q : Fin n, s p = q ↔
        ((p.val % 2 = 0 ∧ q.val = p.val + 1) ∨ (q.val % 2 = 0 ∧ p.val = q.val + 1)) := by
      intro p q
      rw [Fin.ext_iff]
      show (if p.val % 2 = 0 then p.val + 1 else p.val - 1) = q.val ↔ _
      have := p.isLt
      have := q.isLt
      split_ifs <;> omega
    have hss : ∀ p, s (s p) = p := by
      intro p
      rw [hsv]
      show _ ∨ _
      simp only [s]
      have := p.isLt
      split_ifs <;> omega
    have hMe : ∀ p q, M p q = if s p = q then 1 else 0 := by
      intro p q
      simp only [hM, Matrix.add_apply, Matrix.transpose_apply, Matrix.of_apply]
      by_cases h : s p = q
      · rw [if_pos h]
        rcases (hsv p q).mp h with h1 | h1
        · rw [if_pos h1, if_neg (by omega)]; simp
        · rw [if_neg (by omega), if_pos (by omega)]; simp
      · rw [if_neg h]
        have h' := fun x => h ((hsv p q).mpr x)
        rw [if_neg (fun x => h' (Or.inl x)), if_neg (fun x => h' (Or.inr ⟨x.1, x.2⟩))]
        simp
    have hMM : M * M = 1 := by
      ext p r
      rw [Matrix.mul_apply, Matrix.one_apply]
      simp only [hMe]
      rw [Finset.sum_eq_single (s p)]
      · simp only [if_true, one_mul]
        by_cases h : p = r
        · subst h; simp [hss]
        · rw [if_neg h, if_neg]
          intro h2; apply h; rw [← h2, hss]
      · intro q _ hq
        rw [if_neg (fun h => hq h.symm), zero_mul]
      · intro h; exact absurd (Finset.mem_univ _) h
    have hdet : M.det * M.det = 1 := by
      rw [← Matrix.det_mul, hMM, Matrix.det_one]
    exact ⟨⟨M.det, M.det, hdet, hdet⟩, rfl⟩

  have hξ : (Spec.map (CommRingCat.ofHom ((algebraMap L (AlgebraicClosure L)).comp lam)))
      (IsLocalRing.closedPoint (AlgebraicClosure L)) ≠ IsLocalRing.closedPoint A := by
    intro h
    have h2 := congrArg PrimeSpectrum.asIdeal h
    have hmem : π ∈ (IsLocalRing.closedPoint A).asIdeal := by
      show π ∈ IsLocalRing.maximalIdeal A
      rw [hπ]; exact Ideal.mem_span_singleton_self π
    rw [← h2] at hmem
    have h3 : ((algebraMap L (AlgebraicClosure L)).comp lam) π ∈
        IsLocalRing.maximalIdeal (AlgebraicClosure L) := hmem
    rw [IsLocalRing.maximalIdeal_eq_bot, Ideal.mem_bot, RingHom.comp_apply] at h3
    exact hlamπ ((map_eq_zero_iff _ (algebraMap L (AlgebraicClosure L)).injective).mp h3)
  have hℓL : ((ℓ : ℕ) : L) ≠ 0 := by
    have h := hℓA.map lam
    rw [map_natCast] at h
    exact h.ne_zero
  have hneven : Even n := ⟨n / 2, by omega⟩


  have hinj := wc_hmtg_restr_transfer A π hπ ℓ hℓA n hnm hn2 B β' hβ' hβ'X L lam hlamπ p₁ p₂ hPm
    h₀ hh₀κ hh₀L k hk
    (fun r hr₁ hr₂ E q =>
      wc_hmtg_et_pull_bij_prime_pow r ℓ (Fact.out)
        (fun E' q' => wc_hmtg_milnor_restr_bij_ell A ℓ (Fact.out) hℓA n hneven hn2 π _ hπ hc
          x₀ hx₀ hx₀s B Λ₀ W₀ φ₀ _ hsh (AlgebraicClosure L) _ hξ r hr₁ hr₂ E' q') k hk E q)
    D₀ hD₀

  obtain ⟨x, hx⟩ := wc_hmtg_generic_top_generator L ℓ hℓL n hnm hn2 (lam π) hlamπ k hk
  refine ⟨x, ?_⟩
  rw [addOrderOf_injective (wcZModPull D₀ (n - 1)) hinj x]
  exact hx

theorem wc_pmhpi_milnor_quadric_restr_inj (F' F'' : Type u) [Field F'] [Field F'']
    [Finite F''] [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom (D.S i) ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom (D.S i))
    (Ω : (wcP1Over F'').left.ProEt) (a₀ : Ω ⟶ V₀)
    (L : Type u) [Field L] [IsSepClosed L] (eΩ : Ω.left ≅ Spec (.of L))
    (hΩ : ∀ (z : Ω.left) (j : Fin D.m), Ω.hom z ≠ D.S j (IsLocalRing.closedPoint F''))
    (xb : ((wcProEtPullback D.f).obj V₀).left)
    (hxb : ((wcProEtPullback D.f).obj V₀).hom xb = D.xs i (IsLocalRing.closedPoint F''))
    (Th : D.Yt.left.ProEt) (g : Th ⟶ (wcProEtPullback D.f).obj V₀)
    (B : Type u) [CommRing B] [IsNoetherianRing B] [HenselianLocalRing B]
    [IsSepClosed (IsLocalRing.ResidueField B)] (eB : Th.left ≅ Spec (.of B))
    (hpre : g.left ⁻¹' {xb} = {eB.inv (IsLocalRing.closedPoint B)})
    (hfib : IsIso (Limits.pullback.snd g.left
      (((wcProEtPullback D.f).obj V₀).left.fromSpecResidueField xb)))
    (Fm : D.Yt.left.ProEt) (rW : Fm ⟶ (wcProEtPullback D.f).obj Ω) (rT : Fm ⟶ Th)
    (hsq : rT ≫ g = rW ≫ (wcProEtPullback D.f).map a₀)
    (hpb : IsPullback rT.left rW.left g.left ((wcProEtPullback D.f).map a₀).left)
    (Tη : D.Yt.left.ProEt) (j : Tη ⟶ Th) (hj : IsOpenImmersion j.left)
    (hrange : Set.range j.left = {z | D.f (Th.hom z) ≠ D.S i (IsLocalRing.closedPoint F'')})
    (ρ : Fm ⟶ Tη) (hρ : ρ ≫ j = rT) (hnm : n = 2 * (n / 2))
    (K : Type u) [Field K] [IsAlgClosed K] (ι : K →+* A) (π : A)
    (c : Matrix (Fin n) (Fin n) A) (β : wcQuadModelRing A n π c →+* B)
    (P : Matrix (Fin n) (Fin n) A) (D' : MvPolynomial (Fin n) A)
    (U₀ : (Spec (.of (MvPolynomial (Fin (n / 2)) K))).Opens)
    (ψ : Tη.left ⟶ (U₀ : Scheme.{u}))
    (hι : Function.Bijective ((IsLocalRing.residue A).comp ι)) (hℓK : ((ℓ : ℕ) : K) ≠ 0)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    (hβ : WeaklyEtale (Spec.map (CommRingCat.ofHom β)))
    (hβX : ∀ p, β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) ∈
      IsLocalRing.maximalIdeal B)
    (hβA : eB.inv ≫ g.left ≫ Limits.pullback.fst V₀.hom D.f ≫ e.hom =
      Spec.map (CommRingCat.ofHom (β.comp (algebraMap A (wcQuadModelRing A n π c)))))
    (hP : IsUnit P.det) (hD' : MvPolynomial.constantCoeff D' = 0)
    (hhyp : (∑ p, ∑ q, MvPolynomial.C (c p q) *
          (∑ a, MvPolynomial.C (P p a) * MvPolynomial.X a) *
          (∑ b, MvPolynomial.C (P q b) * MvPolynomial.X b) : MvPolynomial (Fin n) A) =
        ∑ t : Fin (n / 2), MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n) *
          MvPolynomial.X (⟨2 * t.val + 1, by omega⟩ : Fin n) + MvPolynomial.C π * D')
    (hU₀ : (U₀ : Set (Spec (.of (MvPolynomial (Fin (n / 2)) K)))) =
        (Set.range (Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin (n / 2)) K →+* K))))ᶜ)
    (hψ : ψ ≫ U₀.ι = j.left ≫ eB.hom ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.eval₂Hom
        ((β.comp (algebraMap A (wcQuadModelRing A n π c))).comp ι)
        (fun t : Fin (n / 2) => β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (∑ a, MvPolynomial.C (P⁻¹ (⟨2 * t.val, by omega⟩ : Fin n) a) *
            MvPolynomial.X a))))))
    (lam : A →+* L) (hlam : Spec.map (CommRingCat.ofHom lam) = eΩ.inv ≫ a₀.left ≫ e.hom)
    (hlamπ : lam π ≠ 0)
    (h : Fm.left ⟶ Spec (.of (wcQuadModelRing L n (lam π)
      (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))))
    (e' : Spec (.of (wcQuadModelRing L n (lam π)
      (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0)))
        ⟶ (U₀ : Scheme.{u}))
    (he' : e' ≫ U₀.ι = Spec.map (CommRingCat.ofHom (MvPolynomial.eval₂Hom
        ((algebraMap L (wcQuadModelRing L n (lam π)
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))).comp
            (lam.comp ι))
        (fun t : Fin (n / 2) => Ideal.Quotient.mk (wcQuadModelIdeal L n (lam π)
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
          (MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n))))))
    (hhL : h ≫ Spec.map (CommRingCat.ofHom (algebraMap L (wcQuadModelRing L n (lam π)
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0)))) =
        rW.left ≫ Limits.pullback.fst Ω.hom D.f ≫ eΩ.hom)
    (hfac : h ≫ e' = ρ.left ≫ ψ)
    (k : ℕ) (hk : 1 ≤ k) :
    ∀ Dh : wcZModPullData h (ℓ ^ k), wcZModPullCanonical Dh →
      Function.Injective (wcZModPull Dh (n - 1)) :=
by
  intro Dh hDh
  classical
  have hℓp : ℓ.Prime := Fact.out
  have hℓpos : 0 < ℓ := hℓp.pos
  have hm : 1 ≤ n / 2 := by omega

  have hℓA : IsUnit ((ℓ : ℕ) : A) := by
    by_contra hnu
    have hmem : ((ℓ : ℕ) : A) ∈ IsLocalRing.maximalIdeal A := (IsLocalRing.mem_maximalIdeal _).mpr hnu
    have h0 : (IsLocalRing.residue A) ((ℓ : ℕ) : A) = 0 :=
      (IsLocalRing.residue_eq_zero_iff _).mpr hmem
    rw [map_natCast] at h0
    apply hℓK
    apply hι.1
    rw [map_natCast, map_zero]
    exact h0

  obtain ⟨β', hβ'W, hβ'A, hβ'X, hβ'Z⟩ :=
    wc_pmhpi_hyp_recoord A n hnm π c P D' hP hD' hhyp B β hβ hβX
  obtain ⟨hPm, h₀, hh₀κ, hh₀L, hh₀e⟩ := wc_pmhpi_fm_model_square F' F'' Y n hn hn2 D ℓ hℓ i V₀
    A e ε hv hε Ω a₀ L eΩ hΩ xb hxb Th g B eB hpre hfib Fm rW rT hsq hpb Tη j hj hrange ρ hρ hnm
    K ι π c β P D' U₀ ψ hι hℓK hπ hc hβ hβX hβA hP hD' hhyp hU₀ hψ lam hlam hlamπ e' he'
    β' hβ'A hβ'Z
  obtain ⟨D₀, hD₀⟩ := wc_zmod_pull_data_exists h₀ (ℓ ^ k)

  obtain ⟨x, hx⟩ := wc_pmhpi_hyp_model_top_generator A π hπ ℓ hℓA n hnm hn2 B β' hβ'W hβ'X
    L lam hlamπ (rT.left ≫ eB.hom) (rW.left ≫ Limits.pullback.fst Ω.hom D.f ≫ eΩ.hom) hPm h₀
    hh₀κ hh₀L k hk D₀ hD₀

  obtain ⟨De, hDe⟩ := wc_zmod_pull_data_exists e' (ℓ ^ k)
  obtain ⟨Dk, hDk⟩ := wc_zmod_pull_data_exists (ρ.left ≫ ψ) (ℓ ^ k)
  have hbije := wc_pmhpi_quadric_punct_pull_bij K L (lam.comp ι) ℓ hℓK n (n / 2) hnm
    hm (lam π) hlamπ U₀ hU₀ e' he' k hk (n - 1) De hDe
  have hsame : ∀ z, wcZModPull Dh (n - 1) z = wcZModPull D₀ (n - 1) z := by
    intro z
    obtain ⟨y, rfl⟩ := hbije.2 z
    rw [← wc_zmod_pull_comp e' h (ρ.left ≫ ψ) hfac De hDe Dh hDh Dk hDk,
      ← wc_zmod_pull_comp e' h₀ (ρ.left ≫ ψ) hh₀e De hDe D₀ hD₀ Dk hDk]

  have hcntU : ∀ (m q : ℕ), 1 ≤ m → q + 1 = 2 * m →
      ∀ (U₀ : (Spec (.of (MvPolynomial (Fin m) K))).Opens),
      (U₀ : Set (Spec (.of (MvPolynomial (Fin m) K)))) =
        (Set.range (Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin m) K →+* K))))ᶜ →
      ∀ kk : ℕ, 1 ≤ kk → Nat.card (wcEtCoh (U₀ : Scheme.{u}) (ℓ ^ kk) q) = ℓ ^ kk := by
    intro m q hm hq U₀ hU₀

    have hE : (U₀ : Set (Spec (.of (MvPolynomial (Fin m) K)))) =
        {x | ∃ j : Fin m, j.val < m ∧ (MvPolynomial.X j : MvPolynomial (Fin m) K) ∉ x.asIdeal} := by
      rw [hU₀]
      ext x
      rw [Set.mem_compl_iff, wc_affine_origin_range_iff, not_forall, Set.mem_setOf_eq]
      exact ⟨fun ⟨j, hj⟩ => ⟨j, j.isLt, hj⟩, fun ⟨j, _, hj⟩ => ⟨j, hj⟩⟩
    have hsub : Subsingleton (wcEtCoh (U₀ : Scheme.{u}) ℓ (q + 1)) :=
      wc_et_affine_partial_punct_vanishing K ℓ hℓp hℓK m m le_rfl U₀ hE (q + 1) (by omega)
    have hq' : 2 * m - 1 = q := by omega
    have hcnt : ∀ kk : ℕ, 1 ≤ kk → Nat.card (wcEtCoh (U₀ : Scheme.{u}) (ℓ ^ kk) q) = ℓ ^ kk := by
      rcases Nat.lt_or_ge m 2 with hm1 | hm2
      ·
        have htors : ∀ (Z : Scheme.{u}) (n j : ℕ) (y : wcEtZModExt Z n j), n • y = 0 := by
          intro Z n j y
          letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Z n)) := HasExt.standard _
          have hsm : ∀ (c : ℕ) X (s : (SheafOfModules.unit (wcEtZModRing Z n)).val.obj X),
              ((c • 𝟙 (SheafOfModules.unit (wcEtZModRing Z n))).val.app X).hom s = c • s := by
            intro c X s
            induction c with
            | zero =>
              rw [zero_smul, zero_smul]
              have h00 : ((0 : SheafOfModules.unit (wcEtZModRing Z n) ⟶
                    SheafOfModules.unit (wcEtZModRing Z n)).val.app X).hom s =
                  ((0 : SheafOfModules.unit (wcEtZModRing Z n) ⟶
                    SheafOfModules.unit (wcEtZModRing Z n)).val.app X).hom s +
                  ((0 : SheafOfModules.unit (wcEtZModRing Z n) ⟶
                    SheafOfModules.unit (wcEtZModRing Z n)).val.app X).hom s := by
                conv_lhs => rw [← add_zero (0 : SheafOfModules.unit (wcEtZModRing Z n) ⟶
                  SheafOfModules.unit (wcEtZModRing Z n))]
                rw [SheafOfModules.add_val, PresheafOfModules.add_app]
                rfl
              exact add_left_cancel (h00.symm.trans (add_zero _).symm)
            | succ c ih =>
              rw [succ_nsmul, succ_nsmul, SheafOfModules.add_val, PresheafOfModules.add_app]
              rw [ModuleCat.hom_add, LinearMap.add_apply, ih]
              rfl
          obtain ⟨-, -, -, hn⟩ := wc_et_zmod_ring_locbij Z n
          have hmU : n • 𝟙 (SheafOfModules.unit (wcEtZModRing Z n)) = 0 := by
            apply SheafOfModules.hom_ext
            apply PresheafOfModules.hom_ext
            intro X
            apply ModuleCat.hom_ext
            apply LinearMap.ext
            intro s
            rw [hsm n X s, show (0 : SheafOfModules.unit (wcEtZModRing Z n) ⟶
                SheafOfModules.unit (wcEtZModRing Z n)) =
                0 • 𝟙 (SheafOfModules.unit (wcEtZModRing Z n)) from (zero_smul _ _).symm, hsm 0 X s,
              zero_smul, ← Nat.cast_smul_eq_nsmul ((wcEtZModRing Z n).obj.obj X), hn X, zero_smul]
          have hcomp : ∀ c : ℕ, y.comp (Abelian.Ext.mk₀ (c • 𝟙 (SheafOfModules.unit
              (wcEtZModRing Z n)))) (add_zero j) = c • y := by
            intro c
            induction c with
            | zero => rw [zero_smul, zero_smul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
            | succ c ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih,
                Abelian.Ext.comp_mk₀_id]
          rw [← hcomp n, hmU, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
        have S6 : ∀ (Z : Scheme.{u}) (j : ℕ), Finite (wcEtCoh Z ℓ j) → Nat.card (wcEtCoh Z ℓ j) ≤ ℓ →
            (∃ ω : wcEtZModExt Z ℓ j, ω ≠ 0) → Nat.card (wcEtCoh Z ℓ j) = ℓ := by
          intro Z j hfin hcard hex
          obtain ⟨ω, hω⟩ := hex
          obtain ⟨EO⟩ := wc_et_zmodext_coh_equiv Z ℓ j
          haveI := hfin
          haveI : Finite (wcEtZModExt Z ℓ j) := Finite.of_equiv _ EO.symm
          have hG : Nat.card (wcEtZModExt Z ℓ j) ≤ ℓ := (Nat.card_congr EO).trans_le hcard
          have hord : addOrderOf ω = ℓ := addOrderOf_eq_prime (htors Z ℓ j ω) hω
          have hlow : ℓ ≤ Nat.card (wcEtZModExt Z ℓ j) := by
            have h1 : Nat.card (AddSubgroup.zmultiples ω) = ℓ := by rw [Nat.card_zmultiples, hord]
            have h2 := Nat.card_le_card_of_injective
              (Subtype.val : AddSubgroup.zmultiples ω → wcEtZModExt Z ℓ j) Subtype.val_injective
            exact (le_of_eq h1.symm).trans h2
          rw [← Nat.card_congr EO]
          exact le_antisymm hG hlow
