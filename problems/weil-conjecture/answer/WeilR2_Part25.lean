theorem wc_crit_fibre_geom_point_coker_iso (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (i : Fin D.m) (V₀ : (wcP1Over F'').left.ProEt) (φ₀ : V₀ ⟶ V₀)
    (ε : Limits.pullback V₀.hom (D.S i) ≅ Spec (.of (AlgebraicClosure F'')))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom (D.S i))
    (hεφ : ε.inv ≫ Limits.pullback.fst V₀.hom (D.S i) ≫ φ₀.left =
      Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
        (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
          AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫
        ε.inv ≫ Limits.pullback.fst V₀.hom (D.S i))
    (hX : WeaklyEtale (Limits.pullback.fst (Over.mk (Limits.pullback.snd D.f (D.S i))).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    ∃ κ' : Limits.cokernel (wcFreeSheafMap (Limits.pullback D.f (D.S i))
          (wcOpenRestrIncl (Limits.pullback D.f (D.S i)) (wcCritPunctOpen D i)
            ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj ((wcProEtPullback D.f).obj V₀)))) ≅
        Limits.cokernel (wcFreeSheafMap (Limits.pullback D.f (D.S i))
          (wcOpenRestrIncl (Limits.pullback D.f (D.S i)) (wcCritPunctOpen D i)
            (wcGeomPoint F'' (Over.mk (Limits.pullback.snd D.f (D.S i))) hX))),
      ∀ (Φ : Limits.cokernel (wcFreeSheafMap (Limits.pullback D.f (D.S i))
            (wcOpenRestrIncl (Limits.pullback D.f (D.S i)) (wcCritPunctOpen D i)
              ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj ((wcProEtPullback D.f).obj V₀)))) ⟶
          Limits.cokernel (wcFreeSheafMap (Limits.pullback D.f (D.S i))
            (wcOpenRestrIncl (Limits.pullback D.f (D.S i)) (wcCritPunctOpen D i)
              ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj ((wcProEtPullback D.f).obj V₀)))))
        (Ψ : Limits.cokernel (wcFreeSheafMap (Limits.pullback D.f (D.S i))
            (wcOpenRestrIncl (Limits.pullback D.f (D.S i)) (wcCritPunctOpen D i)
              (wcGeomPoint F'' (Over.mk (Limits.pullback.snd D.f (D.S i))) hX))) ⟶
          Limits.cokernel (wcFreeSheafMap (Limits.pullback D.f (D.S i))
            (wcOpenRestrIncl (Limits.pullback D.f (D.S i)) (wcCritPunctOpen D i)
              (wcGeomPoint F'' (Over.mk (Limits.pullback.snd D.f (D.S i))) hX)))),
        Limits.cokernel.π _ ≫ Φ = wcFreeSheafMap (Limits.pullback D.f (D.S i))
            ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).map ((wcProEtPullback D.f).map φ₀)) ≫
          Limits.cokernel.π _ →
        Limits.cokernel.π _ ≫ Ψ = wcFreeSheafMap (Limits.pullback D.f (D.S i))
            (wcGeomFrob F'' (Over.mk (Limits.pullback.snd D.f (D.S i))) hX) ≫ Limits.cokernel.π _ →
        κ'.hom ≫ Ψ = Φ ≫ κ'.hom :=
by
  classical

  have F0 : ∀ {S : Scheme.{u}} {U V W : S.ProEt} (a : U ⟶ V) (b : V ⟶ W),
      wcFreeSheafMap S (a ≫ b) = wcFreeSheafMap S a ≫ wcFreeSheafMap S b := by
    intro S U V W a b
    have h := (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_comp
      (Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
      (Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    first
      | rw [← Functor.whiskerRight_comp, ← yoneda.map_comp] at h
      | rw [← Functor.comp_whiskerRight, ← yoneda.map_comp] at h
    exact h
  have F1 : ∀ {S : Scheme.{u}} (U : S.ProEt), wcFreeSheafMap S (𝟙 U) = 𝟙 _ := by
    intro S U
    first
      | (unfold wcFreeSheafMap
         rw [CategoryTheory.Functor.map_id, Functor.whiskerRight_id',
           CategoryTheory.Functor.map_id]
         rfl)
      | (unfold wcFreeSheafMap wcFreeSheaf
         rw [CategoryTheory.Functor.map_id, Functor.whiskerRight_id',
           CategoryTheory.Functor.map_id]
         done)
      | (simp [wcFreeSheafMap, wcFreeSheaf]; done)

  have Hres : ∀ {S : Scheme.{u}} (O : S.Opens) {V V' : S.ProEt} (ψ : V ⟶ V'),
      ∃ ψo : wcOpenRestr S O V ⟶ wcOpenRestr S O V',
        ψo ≫ wcOpenRestrIncl S O V' = wcOpenRestrIncl S O V ≫ ψ := by
    intro S O V V' ψ
    have w : ψ.left ≫ V'.hom = V.hom := MorphismProperty.Over.w ψ
    have hc : Limits.pullback.fst O.ι V.hom ≫ O.ι =
        (Limits.pullback.snd O.ι V.hom ≫ ψ.left) ≫ V'.hom :=
      Limits.pullback.condition.trans
        ((congrArg (fun k => Limits.pullback.snd O.ι V.hom ≫ k) w).symm.trans
          (Category.assoc _ _ _).symm)
    have hl : Limits.pullback.lift (Limits.pullback.fst O.ι V.hom)
        (Limits.pullback.snd O.ι V.hom ≫ ψ.left) hc ≫ (Limits.pullback.snd O.ι V'.hom ≫ V'.hom) =
        Limits.pullback.snd O.ι V.hom ≫ V.hom :=
      (Category.assoc _ _ _).symm.trans
        ((congrArg (fun k => k ≫ V'.hom) (Limits.pullback.lift_snd _ _ hc)).trans
          ((Category.assoc _ _ _).trans
            (congrArg (fun k => Limits.pullback.snd O.ι V.hom ≫ k) w)))
    refine ⟨MorphismProperty.Over.homMk (Limits.pullback.lift (Limits.pullback.fst O.ι V.hom)
        (Limits.pullback.snd O.ι V.hom ≫ ψ.left) hc) (by exact hl) trivial, ?_⟩
    apply MorphismProperty.Over.Hom.ext
    exact Limits.pullback.lift_snd _ _ _

  have L1 : ∀ {S : Scheme.{u}} (O : S.Opens) {U U' : S.ProEt} (β : U ≅ U') (φ : U ⟶ U)
      (φ' : U' ⟶ U'), φ ≫ β.hom = β.hom ≫ φ' →
      ∃ κ' : Limits.cokernel (wcFreeSheafMap S (wcOpenRestrIncl S O U)) ≅
          Limits.cokernel (wcFreeSheafMap S (wcOpenRestrIncl S O U')),
        ∀ (Φ : Limits.cokernel (wcFreeSheafMap S (wcOpenRestrIncl S O U)) ⟶
              Limits.cokernel (wcFreeSheafMap S (wcOpenRestrIncl S O U)))
          (Ψ : Limits.cokernel (wcFreeSheafMap S (wcOpenRestrIncl S O U')) ⟶
              Limits.cokernel (wcFreeSheafMap S (wcOpenRestrIncl S O U'))),
          Limits.cokernel.π _ ≫ Φ = wcFreeSheafMap S φ ≫ Limits.cokernel.π _ →
          Limits.cokernel.π _ ≫ Ψ = wcFreeSheafMap S φ' ≫ Limits.cokernel.π _ →
          κ'.hom ≫ Ψ = Φ ≫ κ'.hom := by
    intro S O U U' β φ φ' hβφ
    have hdesc : ∀ {V V' : S.ProEt} (ψ : V ⟶ V'),
        wcFreeSheafMap S (wcOpenRestrIncl S O V) ≫ wcFreeSheafMap S ψ ≫
          Limits.cokernel.π (wcFreeSheafMap S (wcOpenRestrIncl S O V')) = 0 := by
      intro V V' ψ
      obtain ⟨ψo, hψo⟩ := Hres O ψ
      rw [← Category.assoc, ← F0, ← hψo, F0, Category.assoc, Limits.cokernel.condition,
        Limits.comp_zero]
    obtain ⟨kh, hkh⟩ : ∃ kh : Limits.cokernel (wcFreeSheafMap S (wcOpenRestrIncl S O U)) ⟶
        Limits.cokernel (wcFreeSheafMap S (wcOpenRestrIncl S O U')),
        Limits.cokernel.π (wcFreeSheafMap S (wcOpenRestrIncl S O U)) ≫ kh =
          wcFreeSheafMap S β.hom ≫ Limits.cokernel.π (wcFreeSheafMap S (wcOpenRestrIncl S O U')) :=
      ⟨_, Limits.cokernel.π_desc _ _ (hdesc β.hom)⟩
    obtain ⟨ki, hki⟩ : ∃ ki : Limits.cokernel (wcFreeSheafMap S (wcOpenRestrIncl S O U')) ⟶
        Limits.cokernel (wcFreeSheafMap S (wcOpenRestrIncl S O U)),
        Limits.cokernel.π (wcFreeSheafMap S (wcOpenRestrIncl S O U')) ≫ ki =
          wcFreeSheafMap S β.inv ≫ Limits.cokernel.π (wcFreeSheafMap S (wcOpenRestrIncl S O U)) :=
      ⟨_, Limits.cokernel.π_desc _ _ (hdesc β.inv)⟩
    have e1 : kh ≫ ki = 𝟙 _ := by
      apply (cancel_epi (Limits.cokernel.π (wcFreeSheafMap S (wcOpenRestrIncl S O U)))).mp
      rw [reassoc_of% hkh, hki, ← Category.assoc, ← F0, Iso.hom_inv_id, F1, Category.id_comp,
        Category.comp_id]
    have e2 : ki ≫ kh = 𝟙 _ := by
      apply (cancel_epi (Limits.cokernel.π (wcFreeSheafMap S (wcOpenRestrIncl S O U')))).mp
      rw [reassoc_of% hki, hkh, ← Category.assoc, ← F0, Iso.inv_hom_id, F1, Category.id_comp,
        Category.comp_id]
    refine ⟨⟨kh, ki, e1, e2⟩, ?_⟩
    intro Φ Ψ hΦ hΨ
    apply (cancel_epi (Limits.cokernel.π (wcFreeSheafMap S (wcOpenRestrIncl S O U)))).mp
    show Limits.cokernel.π _ ≫ kh ≫ Ψ = Limits.cokernel.π _ ≫ Φ ≫ kh
    rw [reassoc_of% hkh, hΨ, reassoc_of% hΦ, hkh, ← Category.assoc, ← Category.assoc, ← F0,
      ← F0, hβφ]

  have FrobGen : ∀ {Tl Wl Xs K Kb V P1 : Scheme.{u}} (πX : Xs ⟶ K) (α : Kb ⟶ K)
      (v : V ⟶ P1) (s : K ⟶ P1) (ε : Limits.pullback v s ≅ Kb)
      (hε : ε.hom ≫ α = Limits.pullback.snd v s)
      (φ0 : V ⟶ V) (Fσ : Kb ⟶ Kb)
      (hεφ : ε.inv ≫ Limits.pullback.fst v s ≫ φ0 = Fσ ≫ ε.inv ≫ Limits.pullback.fst v s)
      (hFσ : Fσ ≫ α = α)
      (Fr : Limits.pullback πX α ⟶ Limits.pullback πX α)
      (hFr1 : Fr ≫ Limits.pullback.fst πX α = Limits.pullback.fst πX α)
      (hFr2 : Fr ≫ Limits.pullback.snd πX α = Limits.pullback.snd πX α ≫ Fσ)
      (φ : Tl ⟶ Tl) (tT : Tl ⟶ Xs) (fT : Tl ⟶ Wl) (fW : Wl ⟶ V) (φW : Wl ⟶ Wl)
      (hφw : φ ≫ tT = tT) (hT1 : φ ≫ fT = fT ≫ φW) (hW1 : φW ≫ fW = fW ≫ φ0)
      (b : Tl ⟶ Limits.pullback πX α)
      (hb1 : b ≫ Limits.pullback.fst πX α = tT)
      (hb2 : b ≫ Limits.pullback.snd πX α ≫ ε.inv ≫ Limits.pullback.fst v s = fT ≫ fW),
      φ ≫ b = b ≫ Fr := by
    intro Tl Wl Xs K Kb V P1 πX α v s ε hε φ0 Fσ hεφ hFσ Fr hFr1 hFr2 φ tT fT fW φW hφw hT1 hW1
      b hb1 hb2
    have hεi : ε.inv ≫ Limits.pullback.snd v s = α := by rw [← hε, Iso.inv_hom_id_assoc]
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc, hb1, hFr1, hφw]
    · simp only [Category.assoc, hFr2]
      apply (cancel_mono ε.inv).mp
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc]
        rw [hb2, ← hεφ, reassoc_of% hT1, hW1, ← reassoc_of% hb2]
      · simp only [Category.assoc]
        rw [hεi, hFσ, ← Limits.pullback.condition, reassoc_of% hb1, reassoc_of% hφw]

  have Sq1 : IsPullback
      (Limits.pullback.fst (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f (D.S i)))
      (Limits.pullback.snd (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f (D.S i)))
      (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f (D.S i)) :=
    IsPullback.of_hasPullback _ _
  have Sq2 : IsPullback (Limits.pullback.fst V₀.hom D.f) (Limits.pullback.snd V₀.hom D.f)
      V₀.hom D.f := IsPullback.of_hasPullback _ _
  have Big := Sq1.paste_horiz Sq2
  rw [Limits.pullback.condition (f := D.f) (g := D.S i)] at Big
  have Sq3 : IsPullback (Limits.pullback.fst V₀.hom (D.S i)) (Limits.pullback.snd V₀.hom (D.S i))
      V₀.hom (D.S i) := IsPullback.of_hasPullback _ _
  obtain ⟨a, Sq4, ha1⟩ : ∃ a : Limits.pullback (Limits.pullback.snd V₀.hom D.f)
        (Limits.pullback.fst D.f (D.S i)) ⟶ Limits.pullback V₀.hom (D.S i),
      IsPullback a
        (Limits.pullback.snd (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f (D.S i)))
        (Limits.pullback.snd V₀.hom (D.S i)) (Limits.pullback.snd D.f (D.S i)) ∧
      a ≫ Limits.pullback.fst V₀.hom (D.S i) =
        Limits.pullback.fst (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f (D.S i)) ≫
          Limits.pullback.fst V₀.hom D.f :=
    ⟨_, IsPullback.of_right' Big Sq3, IsPullback.lift_fst _ _ _ _⟩
  have SqE : IsPullback ε.hom (Limits.pullback.snd V₀.hom (D.S i))
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) (𝟙 _) :=
    IsPullback.of_horiz_isIso ⟨by rw [Category.comp_id]; exact hε⟩
  have Sq5 := Sq4.paste_horiz SqE
  rw [Category.comp_id] at Sq5
  have Sq6 := Sq5.flip
  have hb1 := Sq6.isoPullback_hom_fst
  have hb2' := Sq6.isoPullback_hom_snd
  have hb2 : Sq6.isoPullback.hom ≫
      Limits.pullback.snd (Limits.pullback.snd D.f (D.S i))
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ≫
      ε.inv ≫ Limits.pullback.fst V₀.hom (D.S i) =
        Limits.pullback.fst (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f (D.S i)) ≫
          Limits.pullback.fst V₀.hom D.f := by
    rw [← Category.assoc, hb2', Category.assoc, Iso.hom_inv_id_assoc, ha1]
  have hinv : Sq6.isoPullback.inv ≫
      Limits.pullback.snd (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f (D.S i)) =
      Limits.pullback.fst (Limits.pullback.snd D.f (D.S i))
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) := by
    exact Sq6.isoPullback_inv_fst

  have hFσ : Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
        (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
          AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫
      Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) := by
    rw [← Spec.map_comp]
    congr 1
    ext x
    exact ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _ (Fintype.ofFinite F'')
      (AlgebraicClosure F'') _ _ _).symm.commutes x)
  have hFr1 : (wcGeomFrob F'' (Over.mk (Limits.pullback.snd D.f (D.S i))) hX).left ≫
      Limits.pullback.fst (Limits.pullback.snd D.f (D.S i))
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
      Limits.pullback.fst (Limits.pullback.snd D.f (D.S i))
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) :=
    (Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _)
  have hFr2 : (wcGeomFrob F'' (Over.mk (Limits.pullback.snd D.f (D.S i))) hX).left ≫
      Limits.pullback.snd (Limits.pullback.snd D.f (D.S i))
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
      Limits.pullback.snd (Limits.pullback.snd D.f (D.S i))
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ≫
      Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
        (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
          AlgebraicClosure F'' →+* AlgebraicClosure F'')) :=
    Limits.pullback.lift_snd _ _ _
  have hφw : ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).map
        ((wcProEtPullback D.f).map φ₀)).left ≫
      Limits.pullback.snd (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f (D.S i)) =
      Limits.pullback.snd (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f (D.S i)) :=
    MorphismProperty.Over.w _
  have hT1 : ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).map
        ((wcProEtPullback D.f).map φ₀)).left ≫
      Limits.pullback.fst (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f (D.S i)) =
      Limits.pullback.fst (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f (D.S i)) ≫
        ((wcProEtPullback D.f).map φ₀).left := by
    first
      | exact Limits.pullback.lift_fst _ _ _
      | (erw [MorphismProperty.Over.pullback_map_left]; exact Limits.pullback.lift_fst _ _ _)
  have hW1 : ((wcProEtPullback D.f).map φ₀).left ≫ Limits.pullback.fst V₀.hom D.f =
      Limits.pullback.fst V₀.hom D.f ≫ φ₀.left := by
    first
      | exact Limits.pullback.lift_fst _ _ _
      | (erw [MorphismProperty.Over.pullback_map_left]; exact Limits.pullback.lift_fst _ _ _)
  have hfr := FrobGen (Limits.pullback.snd D.f (D.S i))
    (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))
    V₀.hom (D.S i) ε hε φ₀.left _ hεφ hFσ
    (wcGeomFrob F'' (Over.mk (Limits.pullback.snd D.f (D.S i))) hX).left hFr1 hFr2
    ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).map ((wcProEtPullback D.f).map φ₀)).left
    (Limits.pullback.snd (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f (D.S i)))
    (Limits.pullback.fst (Limits.pullback.snd V₀.hom D.f) (Limits.pullback.fst D.f (D.S i)))
    (Limits.pullback.fst V₀.hom D.f) ((wcProEtPullback D.f).map φ₀).left
    hφw hT1 hW1 Sq6.isoPullback.hom hb1 hb2

  let β : (wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj ((wcProEtPullback D.f).obj V₀) ≅
      wcGeomPoint F'' (Over.mk (Limits.pullback.snd D.f (D.S i))) hX :=
    { hom := MorphismProperty.Over.homMk Sq6.isoPullback.hom (by exact hb1) trivial
      inv := MorphismProperty.Over.homMk Sq6.isoPullback.inv (by exact hinv) trivial
      hom_inv_id := MorphismProperty.Over.Hom.ext (by exact Sq6.isoPullback.hom_inv_id)
      inv_hom_id := MorphismProperty.Over.Hom.ext (by exact Sq6.isoPullback.inv_hom_id) }
  have hβφ : (wcProEtPullback (Limits.pullback.fst D.f (D.S i))).map
        ((wcProEtPullback D.f).map φ₀) ≫ β.hom =
      β.hom ≫ wcGeomFrob F'' (Over.mk (Limits.pullback.snd D.f (D.S i))) hX :=
    MorphismProperty.Over.Hom.ext (by exact hfr)
  exact L1 (wcCritPunctOpen D i) β _ _ hβφ

theorem wc_pmod_snbhd_closed_fibre_iso (K : Type u) [Field K] (X Xt Th : Scheme.{u})
    (b : Xt ⟶ X) (s : Spec (.of K) ⟶ X) (hsc : IsClosedImmersion s) (tT : Th ⟶ X)
    (B : Type u) [CommRing B] [IsLocalRing B] (eB : Th ≅ Spec (.of B))
    (ε : Limits.pullback tT s ≅ Spec (.of (AlgebraicClosure K)))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) =
      Limits.pullback.snd tT s) :
    Nonempty (Limits.pullback (Limits.pullback.fst tT b ≫ eB.hom)
        (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) ≅
      Limits.pullback b (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) ≫ s)) :=
by
  classical
  haveI := hsc
  have hg : IsClosedImmersion (Limits.pullback.fst tT s ≫ eB.hom) := inferInstance
  obtain ⟨I, e, he⟩ := IsClosedImmersion.Spec_iff.mp hg
  have hfield : IsField (B ⧸ I) :=
    MulEquiv.isField (Field.toIsField (AlgebraicClosure K))
      ((Scheme.Spec.preimageIso (ε.symm ≪≫ e)).unop.commRingCatIsoToRingEquiv.toMulEquiv)
  have hmax : I.IsMaximal := Ideal.Quotient.maximal_of_isField I hfield
  obtain rfl := IsLocalRing.eq_maximalIdeal hmax
  set r := Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)) with hr
  set c := Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) with hc
  let ψ₀ : Spec (.of (IsLocalRing.ResidueField B)) ≅ Limits.pullback tT s := e.symm
  have hψ₀ : ψ₀.hom ≫ Limits.pullback.fst tT s ≫ eB.hom = r := by
    show e.inv ≫ Limits.pullback.fst tT s ≫ eB.hom = r
    rw [he, Iso.inv_hom_id_assoc]
    rfl
  let ψ := ψ₀ ≪≫ ε
  have h : (r ≫ eB.inv) ≫ tT = ψ.hom ≫ c ≫ s := by
    rw [← hψ₀]
    simp only [Category.assoc, Iso.hom_inv_id_assoc, Iso.trans_hom, ψ]
    rw [Limits.pullback.condition, ← hε]
    simp only [Category.assoc]
  set f := Limits.pullback.fst tT b with hf
  have eq₂ : (r ≫ eB.inv) ≫ eB.hom = 𝟙 _ ≫ r := by simp
  let i1 : Limits.pullback f (r ≫ eB.inv) ⟶ Limits.pullback (f ≫ eB.hom) r :=
    Limits.pullback.map f (r ≫ eB.inv) (f ≫ eB.hom) r (𝟙 _) (𝟙 _) eB.hom (by simp) eq₂
  haveI : IsIso i1 := Limits.pullback.map_isIso _ _ _ _ _ _ _ _ _
  let i5 : Limits.pullback (ψ.hom ≫ c ≫ s) b ⟶ Limits.pullback (c ≫ s) b :=
    Limits.pullback.map (ψ.hom ≫ c ≫ s) b (c ≫ s) b ψ.hom (𝟙 _) (𝟙 _) (by simp) (by simp)
  haveI : IsIso i5 := Limits.pullback.map_isIso _ _ _ _ _ _ _ _ _
  exact ⟨(asIso i1).symm ≪≫ Limits.pullbackSymmetry f (r ≫ eB.inv) ≪≫
    Limits.pullbackRightPullbackFstIso tT b (r ≫ eB.inv) ≪≫
    Limits.pullback.congrHom h rfl ≪≫ asIso i5 ≪≫ Limits.pullbackSymmetry (c ≫ s) b⟩

theorem wc_pmod_exc_fibre_coh_card (K : Type u) [Field K] (X Xt E : Scheme.{u})
    (pX : X ⟶ Spec (.of K)) (pXt : Xt ⟶ Spec (.of K)) (pE : E ⟶ Spec (.of K))
    (b : Xt ⟶ X) (hbX : b ≫ pX = pXt) (s : Spec (.of K) ⟶ X) (hs : s ≫ pX = 𝟙 _)
    (iE : E ⟶ Xt) (hiE : IsClosedImmersion iE) (hiEX : iE ≫ pXt = pE)
    (hrange : Set.range iE = b ⁻¹' {s (IsLocalRing.closedPoint K)}) (m q : ℕ) :
    Nat.card (wcEtCoh (Limits.pullback b
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) ≫ s)) m q) =
      Nat.card (wcEtCoh (Limits.pullback pE
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) m q) :=
by
  classical
  haveI := hiE
  haveI hsc : IsClosedImmersion s := isClosedImmersion_of_comp_eq_id pX s hs
  have hrs : Set.range s = {s (IsLocalRing.closedPoint K)} := by
    ext y
    constructor
    · rintro ⟨z, rfl⟩
      rw [Subsingleton.elim z (IsLocalRing.closedPoint K)]
      rfl
    · rintro rfl
      exact ⟨_, rfl⟩
  have hφ : Set.range (Limits.pullback.fst b s) = Set.range iE := by
    rw [Scheme.Pullback.range_fst, hrs, hrange]
  have h3 : Limits.pullback.snd b s = Limits.pullback.fst b s ≫ pXt := by
    rw [← hbX, ← Category.assoc, Limits.pullback.condition, Category.assoc, hs,
      Category.comp_id]
  obtain ⟨R, r, hr, hrU, hRred⟩ := wc_reduced_subscheme_exists E
  haveI := hr
  haveI := hRred
  have hsub : Set.range (r ≫ iE) ⊆ Set.range (Limits.pullback.fst b s) := by
    rw [hφ]
    rintro _ ⟨z, rfl⟩
    exact ⟨r z, (Scheme.Hom.comp_apply r iE z).symm⟩
  obtain ⟨ρ, hρ⟩ := wc_ap_reduced_factor_closed_immersion R (Limits.pullback b s) Xt (r ≫ iE)
    (Limits.pullback.fst b s) hsub
  haveI : IsClosedImmersion (ρ ≫ Limits.pullback.fst b s) := by rw [hρ]; infer_instance
  haveI : IsClosedImmersion ρ :=
    IsClosedImmersion.of_comp_isClosedImmersion ρ (Limits.pullback.fst b s)
  have hρU : Set.range ρ = Set.univ := by
    rw [Set.eq_univ_iff_forall]
    intro p
    have hp : Limits.pullback.fst b s p ∈ Set.range iE := by rw [← hφ]; exact ⟨p, rfl⟩
    obtain ⟨e, he⟩ := hp
    have he' : e ∈ Set.range r := by rw [hrU]; trivial
    obtain ⟨z, rfl⟩ := he'
    refine ⟨z, (Limits.pullback.fst b s).isClosedEmbedding.injective ?_⟩
    have c1 := Scheme.Hom.comp_apply ρ (Limits.pullback.fst b s) z
    have c2 := Scheme.Hom.comp_apply r iE z
    rw [← c1, hρ, c2, he]
  have h7 : ρ ≫ Limits.pullback.snd b s = r ≫ pE := by
    rw [h3, ← Category.assoc, hρ, Category.assoc, hiEX]
  have j1 := wc_et_fibre_coh_reduced_invariance (Spec (.of K)) (Spec (.of (AlgebraicClosure K)))
    E R pE r hrU (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) m q
  have j2 := wc_et_fibre_coh_reduced_invariance (Spec (.of K)) (Spec (.of (AlgebraicClosure K)))
    (Limits.pullback b s) R (Limits.pullback.snd b s) ρ hρU
    (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) m q
  obtain ⟨e1⟩ := wc_et_coh_iso_invariance (Limits.pullbackLeftPullbackSndIso b s
    (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))).hom m q
  rw [h7] at j2
  rw [Nat.card_congr e1, ← j2, j1]

theorem wc_pmod_strict_nbhd_pull_vanish (K : Type u) [Field K] [Finite K]
    (X Xt E : Over (Spec (.of K))) (hpX : IsProper X.hom)
    (b : Xt.left ⟶ X.left) (hb : IsProper b) (hbX : b ≫ X.hom = Xt.hom)
    (s : Spec (.of K) ⟶ X.left) (hs : s ≫ X.hom = 𝟙 _)
    (O : X.left.Opens) (hO : (O : Set X.left) = {s (IsLocalRing.closedPoint K)}ᶜ)
    (hbO : IsIso (b ∣_ O))
    (iE : E.left ⟶ Xt.left) (hiE : IsClosedImmersion iE) (hiEX : iE ≫ Xt.hom = E.hom)
    (hrange : ((b ⁻¹ᵁ O : Xt.left.Opens) : Set Xt.left) = (Set.range iE)ᶜ)
    (hE : WeaklyEtale (Limits.pullback.fst E.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K) (k j : ℕ)
    (hodd : ∀ x : wcCohG K E hE (wcContSheaf E.left (ZMod (ℓ ^ k))) j, x = 0)
    (Th : X.left.ProEt) (B : Type u) [CommRing B] [IsNoetherianRing B] [HenselianLocalRing B]
    [IsSepClosed (IsLocalRing.ResidueField B)] (eB : Th.left ≅ Spec (.of B))
    (ε : Limits.pullback Th.hom s ≅ Spec (.of (AlgebraicClosure K)))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) =
      Limits.pullback.snd Th.hom s) :
    ∀ y : Abelian.Ext (wcFreeSheaf Xt.left ((wcProEtPullback b).obj Th))
        (wcContSheaf Xt.left (ZMod (ℓ ^ k))) j, y = 0 :=
by
  classical
  intro y
  have hn : 0 < ℓ ^ k := pow_pos (Fact.out : ℓ.Prime).pos k
  have hn0 : ℓ ^ k ≠ 0 := hn.ne'
  obtain ⟨Ψ, hΨ, -, -⟩ := wc_proet_free_zmod_ext_et_model (ℓ ^ k) j hn
  haveI := hpX
  haveI := hb
  haveI := hiE
  haveI hXtp : IsProper Xt.hom := by rw [← hbX]; infer_instance
  haveI hEp : IsProper E.hom := by rw [← hiEX]; infer_instance
  have hsc : IsClosedImmersion s := isClosedImmersion_of_comp_eq_id X.hom s hs

  have hcardE : Nat.card (wcEtCoh (Limits.pullback E.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) (ℓ ^ k) j) = 1 := by
    haveI hEsnd : IsProper (Limits.pullback.snd E.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) := inferInstance
    haveI hEsndqc : QuasiCompact (Limits.pullback.snd E.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) := inferInstance
    haveI hEsndqs : QuasiSeparated (Limits.pullback.snd E.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) := inferInstance
    have hcE0 := QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.snd E.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
    have hqE0 := quasiSeparatedSpace_of_quasiSeparated (Limits.pullback.snd E.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
    haveI hcE : CompactSpace (wcGeomPoint K E hE).left := hcE0
    haveI hqE : QuasiSeparatedSpace (wcGeomPoint K E hE).left := hqE0
    haveI hsubG : Subsingleton (Abelian.Ext (wcFreeSheaf E.left (wcGeomPoint K E hE))
        (wcContSheaf E.left (ZMod (ℓ ^ k))) j) :=
      ⟨fun x y => (hodd x).trans (hodd y).symm⟩
    haveI hsubZ : Subsingleton (wcEtZModExt (wcGeomPoint K E hE).left (ℓ ^ k) j) :=
      (hΨ E.left (wcGeomPoint K E hE) hcE hqE).injective.subsingleton
    obtain ⟨e⟩ := wc_et_zmodext_coh_equiv (wcGeomPoint K E hE).left (ℓ ^ k) j
    haveI hsubC : Subsingleton (wcEtCoh (wcGeomPoint K E hE).left (ℓ ^ k) j) :=
      e.symm.subsingleton
    have h1 : Nat.card (wcEtCoh (wcGeomPoint K E hE).left (ℓ ^ k) j) = 1 :=
      Nat.card_eq_one_iff_unique.mpr ⟨hsubC, ⟨e 0⟩⟩
    exact h1

  have hrange' : Set.range iE = b ⁻¹' {s (IsLocalRing.closedPoint K)} := by
    have h1 := hrange
    rw [Scheme.Hom.coe_preimage, hO, Set.preimage_compl] at h1
    exact (compl_inj_iff.mp h1).symm
  have hcardF := wc_pmod_exc_fibre_coh_card K X.left Xt.left E.left X.hom Xt.hom E.hom b hbX s hs
    iE hiE hiEX hrange' (ℓ ^ k) j
  rw [hcardE] at hcardF

  obtain ⟨φ⟩ := wc_pmod_snbhd_closed_fibre_iso K X.left Xt.left Th.left b s hsc Th.hom B eB ε hε
  obtain ⟨e1⟩ := wc_et_coh_iso_invariance φ.hom (ℓ ^ k) j
  have hP0 := (Nat.card_congr e1).symm.trans hcardF

  haveI hfp : IsProper (Limits.pullback.fst Th.hom b ≫ eB.hom) := inferInstance
  obtain ⟨e2⟩ := wc_et_henselian_closed_fibre_coh B (Limits.pullback Th.hom b)
    (Limits.pullback.fst Th.hom b ≫ eB.hom) (ℓ ^ k) hn0 wc_et_henselian_proper_vanishing j
  have hT : Nat.card (wcEtCoh (Limits.pullback Th.hom b) (ℓ ^ k) j) = 1 :=
    (Nat.card_congr e2).trans hP0
  have hsubT : Subsingleton (wcEtCoh (Limits.pullback Th.hom b) (ℓ ^ k) j) :=
    (Nat.card_eq_one_iff_unique.mp hT).1

  haveI hfqc : QuasiCompact (Limits.pullback.fst Th.hom b ≫ eB.hom) := inferInstance
  haveI hfqs : QuasiSeparated (Limits.pullback.fst Th.hom b ≫ eB.hom) := inferInstance
  have hcT0 := QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.fst Th.hom b ≫ eB.hom)
  have hqT0 := quasiSeparatedSpace_of_quasiSeparated (Limits.pullback.fst Th.hom b ≫ eB.hom)
  haveI hcT : CompactSpace ((wcProEtPullback b).obj Th).left := hcT0
  haveI hqT : QuasiSeparatedSpace ((wcProEtPullback b).obj Th).left := hqT0
  obtain ⟨e3⟩ := wc_et_zmodext_coh_equiv ((wcProEtPullback b).obj Th).left (ℓ ^ k) j
  haveI hsubT' : Subsingleton (wcEtCoh ((wcProEtPullback b).obj Th).left (ℓ ^ k) j) := hsubT
  haveI hsubZT : Subsingleton (wcEtZModExt ((wcProEtPullback b).obj Th).left (ℓ ^ k) j) :=
    e3.subsingleton
  haveI hsubY : Subsingleton (Abelian.Ext (wcFreeSheaf Xt.left ((wcProEtPullback b).obj Th))
      (wcContSheaf Xt.left (ZMod (ℓ ^ k))) j) :=
    (hΨ Xt.left ((wcProEtPullback b).obj Th) hcT hqT).surjective.subsingleton
  exact Subsingleton.elim y 0

theorem wc_pmri_push_iso_preservesFiniteColimits {P T : Scheme.{u}} (f : P ⟶ T) [IsIso f] :
    Limits.PreservesFiniteColimits (wcProEtPush f) :=
by
  have crit : ∀ (S : Scheme.{u}) (X : S.ProEt) (R : Sieve X),
      R ∈ Scheme.ProEt.topology S X ↔
        Sieve.functorPushforward (Scheme.ProEt.forget S ⋙ Over.forget S) R ∈
          Scheme.proetaleTopology X.left := by
    intro S X R
    letI := MorphismProperty.IsMultiplicative.toIsStableUnderComposition (W := @WeaklyEtale)
    have h : Scheme.ProEt.topology S =
        (Scheme.ProEt.forget S).restrictedTopology (Scheme.proetaleTopology.over S) :=
      MorphismProperty.toGrothendieck_comap_forget_eq_restrictedTopology (S := S)
        (P := @WeaklyEtale) Scheme.proetalePrecoverage
        Scheme.proetalePrecoverage_le_precoverage_weaklyEtale
    rw [h, Functor.mem_restrictedTopology_iff, GrothendieckTopology.mem_over_iff,
      Sieve.overEquiv_apply, ← Sieve.functorPushforward_comp]
    rfl
  have hπ : ∀ {S₁ S₂ : Scheme.{u}} (f : S₁ ⟶ S₂),
      (wcProEtBaseChange f).IsContinuous (Scheme.ProEt.topology S₂) (Scheme.ProEt.topology S₁) := by
    intro S₁ S₂ f
    have hpres : Limits.PreservesFiniteLimits (wcProEtBaseChange f) := by
      let e : Scheme.ProEt.forget S₂ ⋙ Over.pullback f ≅
          wcProEtBaseChange f ⋙ Scheme.ProEt.forget S₁ :=
        NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl)
      haveI : Limits.PreservesFiniteLimits (wcProEtBaseChange f ⋙ Scheme.ProEt.forget S₁) :=
        Limits.preservesFiniteLimits_of_natIso e
      exact Limits.preservesFiniteLimits_of_reflects_of_preserves (wcProEtBaseChange f)
        (Scheme.ProEt.forget S₁)
    haveI := hpres
    haveI hflat : RepresentablyFlat (wcProEtBaseChange f) :=
      flat_of_preservesFiniteLimits (wcProEtBaseChange f)
    have hle : ∀ (U : S₂.ProEt) (R : Sieve U),
        Sieve.pullback (Limits.pullback.fst U.hom f)
          (Sieve.functorPushforward (Scheme.ProEt.forget S₂ ⋙ Over.forget S₂) R) ≤
        Sieve.functorPushforward (Scheme.ProEt.forget S₁ ⋙ Over.forget S₁)
          (Sieve.functorPushforward (wcProEtBaseChange f) R) := by
      intro U R Z h hh
      obtain ⟨V, g, k, hg, hk⟩ := hh
      change h ≫ Limits.pullback.fst U.hom f = k ≫ g.left at hk
      have hw : g.left ≫ U.hom = V.hom := MorphismProperty.Over.w g
      have w : k ≫ V.hom = (h ≫ Limits.pullback.snd U.hom f) ≫ f :=
        calc k ≫ V.hom = k ≫ (g.left ≫ U.hom) := congrArg (k ≫ ·) hw.symm
        _ = (k ≫ g.left) ≫ U.hom := (Category.assoc _ _ _).symm
        _ = (h ≫ Limits.pullback.fst U.hom f) ≫ U.hom := congrArg (· ≫ U.hom) hk.symm
        _ = h ≫ (Limits.pullback.fst U.hom f ≫ U.hom) := Category.assoc _ _ _
        _ = h ≫ (Limits.pullback.snd U.hom f ≫ f) := congrArg (h ≫ ·) Limits.pullback.condition
        _ = (h ≫ Limits.pullback.snd U.hom f) ≫ f := (Category.assoc _ _ _).symm
      refine ⟨(wcProEtBaseChange f).obj V, (wcProEtBaseChange f).map g,
        Limits.pullback.lift k (h ≫ Limits.pullback.snd U.hom f) w,
        Sieve.image_mem_functorPushforward (wcProEtBaseChange f) R hg, ?_⟩
      have hmap : ((wcProEtBaseChange f).map g).left =
          Limits.pullback.lift (Limits.pullback.fst V.hom f ≫ g.left) (Limits.pullback.snd V.hom f)
            (by rw [Category.assoc, MorphismProperty.Over.w g]; exact Limits.pullback.condition) :=
        rfl
      change h = Limits.pullback.lift k (h ≫ Limits.pullback.snd U.hom f) w ≫
        ((wcProEtBaseChange f).map g).left
      rw [hmap]
      apply Limits.pullback.hom_ext
      · refine hk.trans ?_
        refine Eq.symm ((Category.assoc _ _ _).trans ?_)
        refine (congrArg (fun x => Limits.pullback.lift k (h ≫ Limits.pullback.snd U.hom f) w ≫ x)
          (Limits.pullback.lift_fst _ _ _)).trans ?_
        refine (Category.assoc _ _ _).symm.trans ?_
        exact congrArg (fun x => x ≫ g.left) (Limits.pullback.lift_fst _ _ _)
      · refine Eq.symm ((Category.assoc _ _ _).trans ?_)
        refine (congrArg (fun x => Limits.pullback.lift k (h ≫ Limits.pullback.snd U.hom f) w ≫ x)
          (Limits.pullback.lift_snd _ _ _)).trans ?_
        exact Limits.pullback.lift_snd _ _ _
    have hcov : CoverPreserving (Scheme.ProEt.topology S₂) (Scheme.ProEt.topology S₁)
        (wcProEtBaseChange f) := by
      refine ⟨fun {U} {R} hR => ?_⟩
      have hS := (crit S₂ U R).1 hR
      have hP := Scheme.proetaleTopology.pullback_stable (Limits.pullback.fst U.hom f) hS
      have hQ := Scheme.proetaleTopology.superset_covering (hle U R) hP
      exact (crit S₁ ((wcProEtBaseChange f).obj U)
        (Sieve.functorPushforward (wcProEtBaseChange f) R)).2 hQ
    exact Functor.isContinuous_of_coverPreserving
      (compatiblePreservingOfFlat (Scheme.ProEt.topology S₁) (wcProEtBaseChange f)) hcov
  have s6 : ∀ {X' B' : Scheme.{u}} (f : X' ⟶ B')
      [(wcProEtBaseChange f).IsContinuous (Scheme.ProEt.topology B') (Scheme.ProEt.topology X')],
      Nonempty (wcProEtPush f ≅ (wcProEtBaseChange f).sheafPushforwardContinuous
        AddCommGrpCat.{u+1} (Scheme.ProEt.topology B') (Scheme.ProEt.topology X')) := by
    intro X' B' f _
    haveI : ∀ P : Sheaf (Scheme.ProEt.topology B') AddCommGrpCat.{u+1},
        IsIso ((sheafificationAdjunction (Scheme.ProEt.topology B') AddCommGrpCat.{u+1}).counit.app
          P) := fun P => isIso_sheafificationAdjunction_counit P
    haveI : IsIso (sheafificationAdjunction (Scheme.ProEt.topology B') AddCommGrpCat.{u+1}).counit :=
      NatIso.isIso_of_isIso_app _
    exact ⟨Functor.isoWhiskerRight (Functor.sheafPushforwardContinuousCompSheafToPresheafIso
        (wcProEtBaseChange f) AddCommGrpCat.{u+1} (Scheme.ProEt.topology B')
        (Scheme.ProEt.topology X')).symm (presheafToSheaf (Scheme.ProEt.topology B')
          AddCommGrpCat.{u+1}) ≪≫
      Functor.associator _ _ _ ≪≫
      Functor.isoWhiskerLeft _ (asIso (sheafificationAdjunction (Scheme.ProEt.topology B')
        AddCommGrpCat.{u+1}).counit) ≪≫ Functor.rightUnitor _⟩

  have s3 : ∀ {A B : Scheme.{u}} (a : A ⟶ B) (b : B ⟶ A), a ≫ b = 𝟙 A → b ≫ a = 𝟙 B →
      Nonempty (wcProEtBaseChange a ⋙ wcProEtBaseChange b ≅ 𝟭 B.ProEt) := by
    intro A B a b hab hba
    let isoF : ∀ {X Y Z : Scheme.{u}} (v : X ⟶ Z) (c : Y ⟶ Z) (d : Z ⟶ Y),
        d ≫ c = 𝟙 Z → c ≫ d = 𝟙 Y → (Limits.pullback v c ≅ X) := fun v c d h1 h2 =>
      { hom := Limits.pullback.fst v c
        inv := Limits.pullback.lift (𝟙 _) (v ≫ d)
          (by rw [Category.id_comp, Category.assoc, h1, Category.comp_id])
        hom_inv_id := by
          apply Limits.pullback.hom_ext
          · rw [Category.assoc, Limits.pullback.lift_fst, Category.comp_id, Category.id_comp]
          · rw [Category.assoc, Limits.pullback.lift_snd, ← Category.assoc,
              Limits.pullback.condition, Category.assoc, h2, Category.comp_id, Category.id_comp]
        inv_hom_id := Limits.pullback.lift_fst _ _ _ }
    have hov : ∀ V : B.ProEt,
        (Limits.pullback.fst (Limits.pullback.snd V.hom a) b ≫ Limits.pullback.fst V.hom a) ≫
          V.hom = Limits.pullback.snd (Limits.pullback.snd V.hom a) b := by
      intro V
      rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, Limits.pullback.condition,
        Category.assoc, hba, Category.comp_id]
    refine ⟨NatIso.ofComponents (fun V => MorphismProperty.Over.isoMk
      (isoF (Limits.pullback.snd V.hom a) b a hab hba ≪≫ isoF V.hom a b hba hab)
      (hov V)) ?_⟩
    intro V V' t
    apply MorphismProperty.Over.Hom.ext
    have h1 : (Limits.pullback.fst V.hom a ≫ t.left) ≫ V'.hom =
        Limits.pullback.snd V.hom a ≫ a := by
      rw [Category.assoc, MorphismProperty.Over.w t]; exact Limits.pullback.condition
    have h2 : (Limits.pullback.fst (Limits.pullback.snd V.hom a) b ≫
        Limits.pullback.lift (Limits.pullback.fst V.hom a ≫ t.left) (Limits.pullback.snd V.hom a)
          h1) ≫ Limits.pullback.snd V'.hom a =
        Limits.pullback.snd (Limits.pullback.snd V.hom a) b ≫ b := by
      rw [Category.assoc, Limits.pullback.lift_snd]; exact Limits.pullback.condition
    change Limits.pullback.lift (Limits.pullback.fst (Limits.pullback.snd V.hom a) b ≫
        Limits.pullback.lift (Limits.pullback.fst V.hom a ≫ t.left) (Limits.pullback.snd V.hom a)
          h1) (Limits.pullback.snd (Limits.pullback.snd V.hom a) b) h2 ≫
        (Limits.pullback.fst (Limits.pullback.snd V'.hom a) b ≫ Limits.pullback.fst V'.hom a) =
      (Limits.pullback.fst (Limits.pullback.snd V.hom a) b ≫ Limits.pullback.fst V.hom a) ≫ t.left
    simp only [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_fst_assoc]
  haveI hF : (wcProEtBaseChange f).IsContinuous (Scheme.ProEt.topology T)
      (Scheme.ProEt.topology P) := hπ f
  haveI hF' : (wcProEtBaseChange (inv f)).IsContinuous (Scheme.ProEt.topology P)
      (Scheme.ProEt.topology T) := hπ (inv f)
  obtain ⟨e₁⟩ := s3 f (inv f) (IsIso.hom_inv_id f) (IsIso.inv_hom_id f)
  obtain ⟨e₂⟩ := s3 (inv f) f (IsIso.inv_hom_id f) (IsIso.hom_inv_id f)
  haveI h12 : (wcProEtBaseChange f ⋙ wcProEtBaseChange (inv f)).IsContinuous
      (Scheme.ProEt.topology T) (Scheme.ProEt.topology T) :=
    Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology P) _
  haveI h21 : (wcProEtBaseChange (inv f) ⋙ wcProEtBaseChange f).IsContinuous
      (Scheme.ProEt.topology P) (Scheme.ProEt.topology P) :=
    Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology T) _
  let Φ := (wcProEtBaseChange f).sheafPushforwardContinuous AddCommGrpCat.{u+1}
    (Scheme.ProEt.topology T) (Scheme.ProEt.topology P)
  let Ψ := (wcProEtBaseChange (inv f)).sheafPushforwardContinuous AddCommGrpCat.{u+1}
    (Scheme.ProEt.topology P) (Scheme.ProEt.topology T)
  let η : 𝟭 _ ≅ Φ ⋙ Ψ :=
    (Functor.sheafPushforwardContinuousComp (wcProEtBaseChange (inv f)) (wcProEtBaseChange f)
      AddCommGrpCat.{u+1} (Scheme.ProEt.topology P) (Scheme.ProEt.topology T)
      (Scheme.ProEt.topology P) ≪≫
      Functor.sheafPushforwardContinuousId' e₂ AddCommGrpCat.{u+1} (Scheme.ProEt.topology P)).symm
  let ε : Ψ ⋙ Φ ≅ 𝟭 _ :=
    Functor.sheafPushforwardContinuousComp (wcProEtBaseChange f) (wcProEtBaseChange (inv f))
      AddCommGrpCat.{u+1} (Scheme.ProEt.topology T) (Scheme.ProEt.topology P)
      (Scheme.ProEt.topology T) ≪≫
      Functor.sheafPushforwardContinuousId' e₁ AddCommGrpCat.{u+1} (Scheme.ProEt.topology T)
  let E := CategoryTheory.Equivalence.mk Φ Ψ η ε
  haveI : Limits.PreservesColimitsOfSize.{0, 0} Φ := E.toAdjunction.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits Φ :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits Φ
  obtain ⟨η0⟩ := s6 f
  exact Limits.preservesFiniteColimits_of_natIso η0.symm

theorem wc_pmri_push_slice_iso {Y Z : Scheme.{u}} (i : Z ⟶ Y) (U : Y.ProEt)
    (hj : WeaklyEtale (Limits.pullback.fst i U.hom))
    [(wcSliceFunctor Y U).IsContinuous (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology Y)]
    [(wcSliceFunctor Z (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst i U.hom) hj)).IsContinuous
      (Scheme.ProEt.topology (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst i U.hom) hj).left)
      (Scheme.ProEt.topology Z)] :
    Nonempty (wcProEtPush i ⋙ wcLpscG Y U ≅
      wcLpscG Z (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst i U.hom) hj) ⋙
        wcProEtPush (Limits.pullback.snd i U.hom)) :=
by
  have crit : ∀ (S : Scheme.{u}) (X : S.ProEt) (R : Sieve X),
      R ∈ Scheme.ProEt.topology S X ↔
        Sieve.functorPushforward (Scheme.ProEt.forget S ⋙ Over.forget S) R ∈
          Scheme.proetaleTopology X.left := by
    intro S X R
    letI := MorphismProperty.IsMultiplicative.toIsStableUnderComposition (W := @WeaklyEtale)
    have h : Scheme.ProEt.topology S =
        (Scheme.ProEt.forget S).restrictedTopology (Scheme.proetaleTopology.over S) :=
      MorphismProperty.toGrothendieck_comap_forget_eq_restrictedTopology (S := S)
        (P := @WeaklyEtale) Scheme.proetalePrecoverage
        Scheme.proetalePrecoverage_le_precoverage_weaklyEtale
    rw [h, Functor.mem_restrictedTopology_iff, GrothendieckTopology.mem_over_iff,
      Sieve.overEquiv_apply, ← Sieve.functorPushforward_comp]
    rfl
  have hπ : ∀ {S₁ S₂ : Scheme.{u}} (f : S₁ ⟶ S₂),
      (wcProEtBaseChange f).IsContinuous (Scheme.ProEt.topology S₂) (Scheme.ProEt.topology S₁) := by
    intro S₁ S₂ f
    have hpres : Limits.PreservesFiniteLimits (wcProEtBaseChange f) := by
      let e : Scheme.ProEt.forget S₂ ⋙ Over.pullback f ≅
          wcProEtBaseChange f ⋙ Scheme.ProEt.forget S₁ :=
        NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl)
      haveI : Limits.PreservesFiniteLimits (wcProEtBaseChange f ⋙ Scheme.ProEt.forget S₁) :=
        Limits.preservesFiniteLimits_of_natIso e
      exact Limits.preservesFiniteLimits_of_reflects_of_preserves (wcProEtBaseChange f)
        (Scheme.ProEt.forget S₁)
    haveI := hpres
    haveI hflat : RepresentablyFlat (wcProEtBaseChange f) :=
      flat_of_preservesFiniteLimits (wcProEtBaseChange f)
    have hle : ∀ (U : S₂.ProEt) (R : Sieve U),
        Sieve.pullback (Limits.pullback.fst U.hom f)
          (Sieve.functorPushforward (Scheme.ProEt.forget S₂ ⋙ Over.forget S₂) R) ≤
        Sieve.functorPushforward (Scheme.ProEt.forget S₁ ⋙ Over.forget S₁)
          (Sieve.functorPushforward (wcProEtBaseChange f) R) := by
      intro U R Z h hh
      obtain ⟨V, g, k, hg, hk⟩ := hh
      change h ≫ Limits.pullback.fst U.hom f = k ≫ g.left at hk
      have hw : g.left ≫ U.hom = V.hom := MorphismProperty.Over.w g
      have w : k ≫ V.hom = (h ≫ Limits.pullback.snd U.hom f) ≫ f :=
        calc k ≫ V.hom = k ≫ (g.left ≫ U.hom) := congrArg (k ≫ ·) hw.symm
        _ = (k ≫ g.left) ≫ U.hom := (Category.assoc _ _ _).symm
        _ = (h ≫ Limits.pullback.fst U.hom f) ≫ U.hom := congrArg (· ≫ U.hom) hk.symm
        _ = h ≫ (Limits.pullback.fst U.hom f ≫ U.hom) := Category.assoc _ _ _
        _ = h ≫ (Limits.pullback.snd U.hom f ≫ f) := congrArg (h ≫ ·) Limits.pullback.condition
        _ = (h ≫ Limits.pullback.snd U.hom f) ≫ f := (Category.assoc _ _ _).symm
      refine ⟨(wcProEtBaseChange f).obj V, (wcProEtBaseChange f).map g,
        Limits.pullback.lift k (h ≫ Limits.pullback.snd U.hom f) w,
        Sieve.image_mem_functorPushforward (wcProEtBaseChange f) R hg, ?_⟩
      have hmap : ((wcProEtBaseChange f).map g).left =
          Limits.pullback.lift (Limits.pullback.fst V.hom f ≫ g.left) (Limits.pullback.snd V.hom f)
            (by rw [Category.assoc, MorphismProperty.Over.w g]; exact Limits.pullback.condition) :=
        rfl
      change h = Limits.pullback.lift k (h ≫ Limits.pullback.snd U.hom f) w ≫
        ((wcProEtBaseChange f).map g).left
      rw [hmap]
      apply Limits.pullback.hom_ext
      · refine hk.trans ?_
        refine Eq.symm ((Category.assoc _ _ _).trans ?_)
        refine (congrArg (fun x => Limits.pullback.lift k (h ≫ Limits.pullback.snd U.hom f) w ≫ x)
          (Limits.pullback.lift_fst _ _ _)).trans ?_
        refine (Category.assoc _ _ _).symm.trans ?_
        exact congrArg (fun x => x ≫ g.left) (Limits.pullback.lift_fst _ _ _)
      · refine Eq.symm ((Category.assoc _ _ _).trans ?_)
        refine (congrArg (fun x => Limits.pullback.lift k (h ≫ Limits.pullback.snd U.hom f) w ≫ x)
          (Limits.pullback.lift_snd _ _ _)).trans ?_
        exact Limits.pullback.lift_snd _ _ _
    have hcov : CoverPreserving (Scheme.ProEt.topology S₂) (Scheme.ProEt.topology S₁)
        (wcProEtBaseChange f) := by
      refine ⟨fun {U} {R} hR => ?_⟩
      have hS := (crit S₂ U R).1 hR
      have hP := Scheme.proetaleTopology.pullback_stable (Limits.pullback.fst U.hom f) hS
      have hQ := Scheme.proetaleTopology.superset_covering (hle U R) hP
      exact (crit S₁ ((wcProEtBaseChange f).obj U)
        (Sieve.functorPushforward (wcProEtBaseChange f) R)).2 hQ
    exact Functor.isContinuous_of_coverPreserving
      (compatiblePreservingOfFlat (Scheme.ProEt.topology S₁) (wcProEtBaseChange f)) hcov
  have s3 : ∀ (B X : Scheme.{u}) (U : B.ProEt) (g : X ⟶ B)
      (hj : WeaklyEtale (Limits.pullback.fst g U.hom)),
      Nonempty (wcProEtBaseChange (Limits.pullback.snd g U.hom) ⋙
          wcSliceFunctor X (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst g U.hom) hj) ≅
        wcSliceFunctor B U ⋙ wcProEtBaseChange g) := by
    intro B X U g hj
    let eV : ∀ V : U.left.ProEt, Limits.pullback V.hom (Limits.pullback.snd g U.hom) ≅
        Limits.pullback (V.hom ≫ U.hom) g := fun V =>
      Limits.pullbackSymmetry V.hom (Limits.pullback.snd g U.hom) ≪≫
        Limits.pullbackLeftPullbackSndIso g U.hom V.hom ≪≫
        Limits.pullbackSymmetry g (V.hom ≫ U.hom)
    have hfst : ∀ (V : U.left.ProEt) {Z : Scheme.{u}} (k : V.left ⟶ Z),
        (eV V).hom ≫ Limits.pullback.fst (V.hom ≫ U.hom) g ≫ k =
          Limits.pullback.fst V.hom (Limits.pullback.snd g U.hom) ≫ k := by
      intro V Z k
      simp [eV]
    have hsnd : ∀ (V : U.left.ProEt),
        (eV V).hom ≫ Limits.pullback.snd (V.hom ≫ U.hom) g =
          Limits.pullback.snd V.hom (Limits.pullback.snd g U.hom) ≫
            Limits.pullback.fst g U.hom := by
      intro V
      simp [eV]
    refine ⟨NatIso.ofComponents (fun V => MorphismProperty.Over.isoMk (eV V) (hsnd V)) ?_⟩
    intro V V' t
    apply MorphismProperty.Over.Hom.ext
    have h1 : (Limits.pullback.fst V.hom (Limits.pullback.snd g U.hom) ≫ t.left) ≫ V'.hom =
        Limits.pullback.snd V.hom (Limits.pullback.snd g U.hom) ≫
          Limits.pullback.snd g U.hom := by
      rw [Category.assoc, MorphismProperty.Over.w t]; exact Limits.pullback.condition
    have h2 : (Limits.pullback.fst (V.hom ≫ U.hom) g ≫ t.left) ≫ (V'.hom ≫ U.hom) =
        Limits.pullback.snd (V.hom ≫ U.hom) g ≫ g := by
      rw [Category.assoc, ← Category.assoc t.left, MorphismProperty.Over.w t]
      exact Limits.pullback.condition
    change Limits.pullback.lift (Limits.pullback.fst V.hom (Limits.pullback.snd g U.hom) ≫ t.left)
        (Limits.pullback.snd V.hom (Limits.pullback.snd g U.hom)) h1 ≫ (eV V').hom =
      (eV V).hom ≫ Limits.pullback.lift (Limits.pullback.fst (V.hom ≫ U.hom) g ≫ t.left)
        (Limits.pullback.snd (V.hom ≫ U.hom) g) h2
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Category.assoc, Limits.pullback.lift_fst]
      have hV' : (eV V').hom ≫ Limits.pullback.fst (V'.hom ≫ U.hom) g =
          Limits.pullback.fst V'.hom (Limits.pullback.snd g U.hom) := by
        first
          | simp [eV]
          | (have h0 := hfst V' (𝟙 _)
             erw [Category.comp_id, Category.comp_id] at h0
             exact h0)
      rw [hV', Limits.pullback.lift_fst, hfst V t.left]
    · rw [Category.assoc, Category.assoc, Limits.pullback.lift_snd, hsnd V',
        ← Category.assoc, Limits.pullback.lift_snd, hsnd V]
  have s6 : ∀ {X' B' : Scheme.{u}} (f : X' ⟶ B')
      [(wcProEtBaseChange f).IsContinuous (Scheme.ProEt.topology B') (Scheme.ProEt.topology X')],
      Nonempty (wcProEtPush f ≅ (wcProEtBaseChange f).sheafPushforwardContinuous
        AddCommGrpCat.{u+1} (Scheme.ProEt.topology B') (Scheme.ProEt.topology X')) := by
    intro X' B' f _
    haveI : ∀ P : Sheaf (Scheme.ProEt.topology B') AddCommGrpCat.{u+1},
        IsIso ((sheafificationAdjunction (Scheme.ProEt.topology B') AddCommGrpCat.{u+1}).counit.app
          P) := fun P => isIso_sheafificationAdjunction_counit P
    haveI : IsIso (sheafificationAdjunction (Scheme.ProEt.topology B') AddCommGrpCat.{u+1}).counit :=
      NatIso.isIso_of_isIso_app _
    exact ⟨Functor.isoWhiskerRight (Functor.sheafPushforwardContinuousCompSheafToPresheafIso
        (wcProEtBaseChange f) AddCommGrpCat.{u+1} (Scheme.ProEt.topology B')
        (Scheme.ProEt.topology X')).symm (presheafToSheaf (Scheme.ProEt.topology B')
          AddCommGrpCat.{u+1}) ≪≫
      Functor.associator _ _ _ ≪≫
      Functor.isoWhiskerLeft _ (asIso (sheafificationAdjunction (Scheme.ProEt.topology B')
        AddCommGrpCat.{u+1}).counit) ≪≫ Functor.rightUnitor _⟩
  rename_i hcU hcW
  let W : Z.ProEt := MorphismProperty.Over.mk ⊤ (Limits.pullback.fst i U.hom) hj
  let LU := (wcSliceFunctor Y U).sheafPushforwardContinuous AddCommGrpCat.{u+1}
    (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology Y)
  let LW := (wcSliceFunctor Z W).sheafPushforwardContinuous AddCommGrpCat.{u+1}
    (Scheme.ProEt.topology W.left) (Scheme.ProEt.topology Z)
  haveI hπg : (wcProEtBaseChange i).IsContinuous (Scheme.ProEt.topology Y)
      (Scheme.ProEt.topology Z) := hπ i
  haveI hπgU : (wcProEtBaseChange (Limits.pullback.snd i U.hom)).IsContinuous
      (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology W.left) :=
    hπ (Limits.pullback.snd i U.hom)
  haveI hc1 : (wcSliceFunctor Y U ⋙ wcProEtBaseChange i).IsContinuous
      (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology Z) :=
    Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology Y) _
  haveI hc2 : (wcProEtBaseChange (Limits.pullback.snd i U.hom) ⋙ wcSliceFunctor Z W).IsContinuous
      (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology Z) :=
    @Functor.isContinuous_comp _ _ _ _ _ _ _ _ (Scheme.ProEt.topology U.left)
      (Scheme.ProEt.topology W.left) (Scheme.ProEt.topology Z) hπgU hcW
  obtain ⟨σ⟩ := s3 Y Z U i hj
  obtain ⟨ηg⟩ := s6 i
  obtain ⟨ηgU⟩ := @s6 W.left U.left (Limits.pullback.snd i U.hom) hπgU
  exact ⟨Functor.isoWhiskerRight ηg LU ≪≫
      @Functor.sheafPushforwardContinuousComp _ _ _ _ _ _ (wcSliceFunctor Y U) (wcProEtBaseChange i)
        AddCommGrpCat.{u+1} _ (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology Y)
        (Scheme.ProEt.topology Z) hcU hπg ≪≫
      @Functor.sheafPushforwardContinuousIso _ _ _ _ _ _ σ.symm AddCommGrpCat.{u+1} _
        (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology Z) hc1 hc2 ≪≫
      (@Functor.sheafPushforwardContinuousComp _ _ _ _ _ _
        (wcProEtBaseChange (Limits.pullback.snd i U.hom))
        (wcSliceFunctor Z W) AddCommGrpCat.{u+1} _ (Scheme.ProEt.topology U.left)
        (Scheme.ProEt.topology W.left) (Scheme.ProEt.topology Z) hπgU hcW).symm ≪≫
      Functor.isoWhiskerLeft LW ηgU.symm⟩

theorem wc_pmri_slice_contPull_isIso {Y Z : Scheme.{u}} (i : Z ⟶ Y) (U : Y.ProEt)
    [(wcSliceFunctor Y U).IsContinuous (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology Y)]
    (M : Type) [AddCommGroup M] [TopologicalSpace M] [IsTopologicalAddGroup M]
    (h : ∀ W : U.left.ProEt, IsIso (Limits.pullback.fst (W.hom ≫ U.hom) i)) :
    IsIso ((wcLpscG Y U).map (wcContPull i M)) :=
by
  have wc_proet_mem_topology_iff : ∀ (S : Scheme.{u}) (X : S.ProEt) (R : Sieve X),
      R ∈ Scheme.ProEt.topology S X ↔
        Sieve.functorPushforward (Scheme.ProEt.forget S ⋙ Over.forget S) R ∈
          Scheme.proetaleTopology X.left := by
    intro S X R
    letI := MorphismProperty.IsMultiplicative.toIsStableUnderComposition (W := @WeaklyEtale)
    have h : Scheme.ProEt.topology S =
        (Scheme.ProEt.forget S).restrictedTopology (Scheme.proetaleTopology.over S) :=
      MorphismProperty.toGrothendieck_comap_forget_eq_restrictedTopology (S := S)
        (P := @WeaklyEtale) Scheme.proetalePrecoverage
        Scheme.proetalePrecoverage_le_precoverage_weaklyEtale
    rw [h, Functor.mem_restrictedTopology_iff, GrothendieckTopology.mem_over_iff,
      Sieve.overEquiv_apply, ← Sieve.functorPushforward_comp]
    rfl
  have wc_slice_pushforward_functorPullback : ∀ (S : Scheme.{u}) (U : S.ProEt)
      (V : U.left.ProEt) (T : Sieve ((wcSliceFunctor S U).obj V)),
      Sieve.functorPushforward (Scheme.ProEt.forget U.left ⋙ Over.forget U.left)
          (Sieve.functorPullback (wcSliceFunctor S U) T) =
        Sieve.functorPushforward (Scheme.ProEt.forget S ⋙ Over.forget S) T := by
    intro S U V T
    ext Z g
    constructor
    · rintro ⟨W, t', h, ht', rfl⟩
      exact ⟨(wcSliceFunctor S U).obj W, (wcSliceFunctor S U).map t', h, ht', rfl⟩
    · rintro ⟨W', t, h, ht, rfl⟩
      have hw : (t.left ≫ V.hom) ≫ U.hom = W'.hom :=
        (Category.assoc _ _ _).trans (MorphismProperty.Over.w t)
      haveI : WeaklyEtale ((t.left ≫ V.hom) ≫ U.hom) := hw ▸ W'.prop
      haveI : WeaklyEtale (t.left ≫ V.hom) := WeaklyEtale.of_comp _ U.hom
      let W'' : U.left.ProEt := Scheme.ProEt.mk (t.left ≫ V.hom)
      let t'' : W'' ⟶ V := MorphismProperty.Over.homMk t.left rfl trivial
      let e : (wcSliceFunctor S U).obj W'' ⟶ W' :=
        MorphismProperty.Over.homMk (𝟙 _) ((Category.id_comp _).trans hw.symm) trivial
      have he : (wcSliceFunctor S U).map t'' = e ≫ t := by
        apply MorphismProperty.Over.Hom.ext
        exact (Category.id_comp _).symm
      refine ⟨W'', t'', h, ?_, rfl⟩
      show T.arrows ((wcSliceFunctor S U).map t'')
      rw [he]
      exact T.downward_closed ht e
  haveI hcocont : (wcSliceFunctor Y U).IsCocontinuous (Scheme.ProEt.topology U.left)
      (Scheme.ProEt.topology Y) :=
    Functor.IsCocontinuous.mk (fun {W} {T} hT => by
      have h1 := (wc_proet_mem_topology_iff Y ((wcSliceFunctor Y U).obj W) T).1 hT
      rw [← wc_slice_pushforward_functorPullback Y U W T] at h1
      exact (wc_proet_mem_topology_iff U.left W _).2 h1)
  let P : (Y.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
    (wcProEtBaseChange i).op ⋙ (wcContSheaf Z M).obj
  let α : (wcContSheaf Y M).obj ⟶ P :=
    Functor.whiskerRight (NatTrans.op
        ({ app := fun V =>
              (Limits.pullback.fst V.hom i : Limits.pullback V.hom i ⟶ V.left)
           naturality := fun _ _ _ => Limits.pullback.lift_fst _ _ _ } :
          wcProEtBaseChange i ⋙ Scheme.ProEt.forget Z ⋙ Over.forget Z ⟶
            Scheme.ProEt.forget Y ⋙ Over.forget Y))
      (continuousMapPresheafAb.{0, u} M ⋙ AddCommGrpCat.uliftFunctor.{u+1, u})
  have hcp : (wcContPull i M).hom = α ≫ toSheafify (Scheme.ProEt.topology Y) P := rfl
  have hβ : IsIso (Functor.whiskerLeft (wcSliceFunctor Y U).op α) := by
    rw [NatTrans.isIso_iff_isIso_app]
    intro W
    haveI := h W.unop
    change IsIso ((continuousMapPresheafAb.{0, u} M ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}).map
      (Limits.pullback.fst (W.unop.hom ≫ U.hom) i).op)
    infer_instance
  have hsh : Presheaf.IsSheaf (Scheme.ProEt.topology U.left) ((wcSliceFunctor Y U).op ⋙ P) :=
    (Presheaf.isSheaf_of_iso_iff (asIso (Functor.whiskerLeft (wcSliceFunctor Y U).op α))).mp
      (Functor.op_comp_isSheaf (wcSliceFunctor Y U) _ _ (wcContSheaf Y M))
  have hT : IsIso (Functor.whiskerLeft (wcSliceFunctor Y U).op
      (toSheafify (Scheme.ProEt.topology Y) P)) := by
    rw [← Functor.toSheafify_pullbackSheafificationCompatibility (wcSliceFunctor Y U)
      AddCommGrpCat.{u+1} (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology Y) P]
    exact @IsIso.comp_isIso _ _ _ _ _ _ _ (isIso_toSheafify _ hsh)
      (Iso.isIso_hom ((sheafToPresheaf (Scheme.ProEt.topology U.left) AddCommGrpCat.{u+1}).mapIso
        (((wcSliceFunctor Y U).pushforwardContinuousSheafificationCompatibility
          AddCommGrpCat.{u+1} (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology Y)).app P)))
  have hhom : IsIso ((sheafToPresheaf _ _).map ((wcLpscG Y U).map (wcContPull i M))) := by
    change IsIso (Functor.whiskerLeft (wcSliceFunctor Y U).op (wcContPull i M).hom)
    rw [hcp, Functor.whiskerLeft_comp]
    exact @IsIso.comp_isIso _ _ _ _ _ _ _ hβ hT
  exact isIso_of_fully_faithful (sheafToPresheaf _ _) _

theorem wc_pmod_res_injective_over_iso_locus {Y Z : Scheme.{u}} (i : Z ⟶ Y)
    (L : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1})
    [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L]
    (adj : L ⊣ wcProEtPush i)
    (θ : ∀ V : Y.ProEt, L.obj (wcFreeSheaf Y V) ≅ wcFreeSheaf Z ((wcProEtPullback i).obj V))
    (hθ : ∀ {V V' : Y.ProEt} (a : V ⟶ V'),
      L.map (wcFreeSheafMap Y a) ≫ (θ V').hom =
        (θ V).hom ≫ wcFreeSheafMap Z ((wcProEtPullback i).map a))
    (O : Y.Opens) (hO : IsIso (i ∣_ O))
    (U : Y.ProEt) (hU : Set.range U.hom ⊆ (O : Set Y)) (n j : ℕ) :
    Function.Injective (wcProEtRes i L adj θ (ZMod n) U j) :=
by
  classical
  have topι : ∀ {X : Scheme.{u}} (V : X.Opens), V = ⊤ → IsIso V.ι := by
    intro X V hV
    subst hV
    rw [← Scheme.topIso_hom]
    infer_instance
  have isoTop : ∀ {X X' : Scheme.{u}} (f : X ⟶ X') (V : X'.Opens), V = ⊤ →
      IsIso (f ∣_ V) → IsIso f := by
    intro X X' f V hV hf
    haveI := topι V hV
    haveI := topι (f ⁻¹ᵁ V) (by rw [hV]; exact Scheme.Hom.preimage_top f)
    haveI : IsIso ((f ⁻¹ᵁ V).ι ≫ f) := by rw [← morphismRestrict_ι]; infer_instance
    exact IsIso.of_isIso_comp_left (f ⁻¹ᵁ V).ι f
  have c1 : ∀ {W : Scheme.{u}} (a : W ⟶ Y), Set.range a ⊆ (O : Set Y) →
      IsIso (Limits.pullback.fst a i) := by
    intro W a ha
    exact isoTop _ (a ⁻¹ᵁ O) (top_unique fun x _ => ha ⟨x, rfl⟩)
      (wc_isIso_restrict_pullback_fst a i O hO)
  have hrange : ∀ W : U.left.ProEt, Set.range (W.hom ≫ U.hom) ⊆ (O : Set Y) := by
    rintro W _ ⟨x, rfl⟩
    exact hU ⟨W.hom x, (Scheme.Hom.comp_apply _ _ _).symm⟩
  obtain ⟨hcU, -, haddU, hflU, hfcU⟩ := wc_lpsc_site Y U
  have hj : WeaklyEtale (Limits.pullback.fst i U.hom) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback i U.hom).flip
      U.prop
  obtain ⟨hcW, -, haddW, hflW, hfcW⟩ :=
    wc_lpsc_site Z (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst i U.hom) hj)
  haveI : (wcProEtPush i).IsRightAdjoint := ⟨_, ⟨adj⟩⟩
  haveI : Limits.PreservesLimitsOfSize.{0, 0} (wcProEtPush i) := adj.rightAdjoint_preservesLimits
  haveI : Limits.PreservesFiniteLimits (wcProEtPush i) :=
    Limits.PreservesLimitsOfSize.preservesFiniteLimits _
  haveI : (wcProEtPush i).PreservesZeroMorphisms :=
    Functor.preservesZeroMorphisms_of_isRightAdjoint _
  haveI : (wcProEtPush i).Additive := Functor.additive_of_preserves_binary_products _
  haveI hsnd : IsIso (Limits.pullback.snd i U.hom) := by
    haveI := c1 U.hom hU
    rw [← Limits.pullbackSymmetry_hom_comp_fst]
    infer_instance
  haveI hpushsnd := wc_pmri_push_iso_preservesFiniteColimits (Limits.pullback.snd i U.hom)
  obtain ⟨σ⟩ := wc_pmri_push_slice_iso i U hj
  haveI hcompW : Limits.PreservesFiniteColimits
      (wcLpscG Z (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst i U.hom) hj) ⋙
        wcProEtPush (Limits.pullback.snd i U.hom)) :=
    @Limits.comp_preservesFiniteColimits _ _ _ _ _ _ _ _ hfcW hpushsnd
  haveI : Limits.PreservesFiniteColimits (wcProEtPush i ⋙ wcLpscG Y U) :=
    @Limits.preservesFiniteColimits_of_natIso _ _ _ _ _ _ σ.symm hcompW
  haveI hc : IsIso ((wcLpscG Y U).map (wcContPull i (ZMod n))) :=
    wc_pmri_slice_contPull_isIso i U (ZMod n) (fun W => c1 _ (hrange W))
  let lamN : ((wcLpscG Y U).obj (wcContSheaf Y (ZMod n))).obj ≅
      (wcContSheaf U.left (ZMod n)).obj :=
    NatIso.ofComponents (fun W => (Iso.refl _ :
        ((wcLpscG Y U).obj (wcContSheaf Y (ZMod n))).obj.obj W ≅
          (wcContSheaf U.left (ZMod n)).obj.obj W))
      (fun {V W} f => by
        apply AddCommGrpCat.ext
        intro r
        rfl)
  let lam : (wcLpscG Y U).obj (wcContSheaf Y (ZMod n)) ≅ wcContSheaf U.left (ZMod n) :=
    ObjectProperty.isoMk _ lamN
  obtain ⟨ν, hνapp⟩ : ∃ ν : wcLpscG Y U ⟶ L ⋙ (wcProEtPush i ⋙ wcLpscG Y U),
      ∀ X, ν.app X = (wcLpscG Y U).map (adj.unit.app X) :=
    ⟨Functor.whiskerRight adj.unit (wcLpscG Y U), fun X => rfl⟩
  obtain ⟨ψ, hψ⟩ : ∃ ψ : Abelian.Ext (wcFreeSheaf Z ((wcProEtPullback i).obj U))
        (wcContSheaf Z (ZMod n)) j →
      Abelian.Ext (wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left)))
        (wcContSheaf U.left (ZMod n)) j,
      ∀ w, ψ w = (Abelian.Ext.mk₀ (wcLpscGen Y U (Scheme.ProEt.mk (𝟙 U.left)) U
          (wcLpscBetaTop Y U) ≫
          (wcLpscG Y U).map (adj.unit.app (wcFreeSheaf Y U) ≫ (wcProEtPush i).map (θ U).hom))).comp
        ((Abelian.Ext.mapExactFunctor (wcProEtPush i ⋙ wcLpscG Y U) w).comp
          (Abelian.Ext.mk₀ (inv ((wcLpscG Y U).map (wcContPull i (ZMod n))) ≫ lam.hom))
          (add_zero j))
        (zero_add j) := ⟨_, fun w => rfl⟩
  have key : ∀ e, ψ (wcProEtRes i L adj θ (ZMod n) U j e) = wcZmRho Y U n j lam e := by
    intro e
    have hRes : wcProEtRes i L adj θ (ZMod n) U j e =
        (Abelian.Ext.mk₀ (θ U).inv).comp ((Abelian.Ext.mapExactFunctor L e).comp
          (Abelian.Ext.mk₀ ((adj.homEquiv (wcContSheaf Y (ZMod n)) (wcContSheaf Z (ZMod n))).symm
            (wcContPull i (ZMod n)))) (add_zero j)) (zero_add j) := rfl
    have e1 : (wcProEtPush i ⋙ wcLpscG Y U).map (θ U).inv =
        (wcLpscG Y U).map ((wcProEtPush i).map (θ U).inv) := rfl
    have hRθ : (wcProEtPush i).map (θ U).hom ≫ (wcProEtPush i).map (θ U).inv = 𝟙 _ :=
      ((wcProEtPush i).mapIso (θ U)).hom_inv_id
    have hpre : (wcLpscGen Y U (Scheme.ProEt.mk (𝟙 U.left)) U (wcLpscBetaTop Y U) ≫
          (wcLpscG Y U).map (adj.unit.app (wcFreeSheaf Y U) ≫ (wcProEtPush i).map (θ U).hom)) ≫
          (wcProEtPush i ⋙ wcLpscG Y U).map (θ U).inv =
        wcLpscGen Y U (Scheme.ProEt.mk (𝟙 U.left)) U (wcLpscBetaTop Y U) ≫
          ν.app (wcFreeSheaf Y U) := by
      rw [e1, hνapp, Category.assoc, ← Functor.map_comp (wcLpscG Y U), Category.assoc, hRθ]
      erw [Category.comp_id]
    have e2 : (wcProEtPush i ⋙ wcLpscG Y U).map
          ((adj.homEquiv (wcContSheaf Y (ZMod n)) (wcContSheaf Z (ZMod n))).symm
            (wcContPull i (ZMod n))) =
        (wcLpscG Y U).map ((wcProEtPush i).map
          ((adj.homEquiv (wcContSheaf Y (ZMod n)) (wcContSheaf Z (ZMod n))).symm
            (wcContPull i (ZMod n)))) := rfl
    have h0 : adj.unit.app (wcContSheaf Y (ZMod n)) ≫ (wcProEtPush i).map
          ((adj.homEquiv (wcContSheaf Y (ZMod n)) (wcContSheaf Z (ZMod n))).symm
            (wcContPull i (ZMod n))) = wcContPull i (ZMod n) :=
      (adj.homEquiv_unit _ _ _).symm.trans (Equiv.apply_symm_apply _ _)
    have hlast : ν.app (wcContSheaf Y (ZMod n)) ≫ ((wcProEtPush i ⋙ wcLpscG Y U).map
          ((adj.homEquiv (wcContSheaf Y (ZMod n)) (wcContSheaf Z (ZMod n))).symm
            (wcContPull i (ZMod n))) ≫
          (inv ((wcLpscG Y U).map (wcContPull i (ZMod n))) ≫ lam.hom)) = lam.hom := by
      rw [e2, hνapp, ← Category.assoc, ← Functor.map_comp (wcLpscG Y U), h0,
        IsIso.hom_inv_id_assoc]
    have hnat := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp e ν
    rw [hψ, hRes, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_mapExactFunctor]
    simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.mk₀_comp_mk₀_assoc]
    rw [hpre, ← Abelian.Ext.mk₀_comp_mk₀_assoc,
      ← Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mk₀ (ν.app (wcFreeSheaf Y U))),
      ← hnat]
    simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
    rw [hlast]
    show _ = ((Abelian.Ext.mk₀ (wcLpscGen Y U (Scheme.ProEt.mk (𝟙 U.left)) U
        (wcLpscBetaTop Y U))).comp (Abelian.Ext.mapExactFunctor (wcLpscG Y U) e)
        (zero_add j)).comp (Abelian.Ext.mk₀ lam.hom) (add_zero j)
    exact (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).symm
  intro e₁ e₂ h
  apply (wc_zmod_rho_bij Y U n j lam).1
  rw [← key e₁, ← key e₂, h]

theorem wc_proper_modif_point_local_coh_pull_inj (K : Type u) [Field K] [Finite K]
    (X Xt E : Over (Spec (.of K))) (hpX : IsProper X.hom)
    (b : Xt.left ⟶ X.left) (hb : IsProper b) (hbX : b ≫ X.hom = Xt.hom)
    (s : Spec (.of K) ⟶ X.left) (hs : s ≫ X.hom = 𝟙 _)
    (O : X.left.Opens) (hO : (O : Set X.left) = {s (IsLocalRing.closedPoint K)}ᶜ)
    (hbO : IsIso (b ∣_ O))
    (iE : E.left ⟶ Xt.left) (hiE : IsClosedImmersion iE) (hiEX : iE ≫ Xt.hom = E.hom)
    (hrange : ((b ⁻¹ᵁ O : Xt.left.Opens) : Set Xt.left) = (Set.range iE)ᶜ)
    (hX : WeaklyEtale (Limits.pullback.fst X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (hXt : WeaklyEtale (Limits.pullback.fst Xt.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (hE : WeaklyEtale (Limits.pullback.fst E.hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K) (k m j : ℕ) (hm : 2 ≤ m)
    (hj : j + 1 = m)
    (hodd : ∀ x : wcCohG K E hE (wcContSheaf E.left (ZMod (ℓ ^ k))) j, x = 0)
    (Ψ : Limits.cokernel (wcFreeSheafMap X.left (wcOpenRestrIncl X.left O (wcGeomPoint K X hX))) ⟶
      Limits.cokernel (wcFreeSheafMap X.left (wcOpenRestrIncl X.left O (wcGeomPoint K X hX))))
    (hΨ : Limits.cokernel.π _ ≫ Ψ =
      wcFreeSheafMap X.left (wcGeomFrob K X hX) ≫ Limits.cokernel.π _)
    (Ψt : Limits.cokernel (wcFreeSheafMap Xt.left
          (wcOpenRestrIncl Xt.left (b ⁻¹ᵁ O) (wcGeomPoint K Xt hXt))) ⟶
      Limits.cokernel (wcFreeSheafMap Xt.left
          (wcOpenRestrIncl Xt.left (b ⁻¹ᵁ O) (wcGeomPoint K Xt hXt))))
    (hΨt : Limits.cokernel.π _ ≫ Ψt =
      wcFreeSheafMap Xt.left (wcGeomFrob K Xt hXt) ≫ Limits.cokernel.π _) :
    ∃ β : Abelian.Ext (Limits.cokernel (wcFreeSheafMap X.left
            (wcOpenRestrIncl X.left O (wcGeomPoint K X hX))))
          (wcContSheaf X.left (ZMod (ℓ ^ k))) m →+
        Abelian.Ext (Limits.cokernel (wcFreeSheafMap Xt.left
            (wcOpenRestrIncl Xt.left (b ⁻¹ᵁ O) (wcGeomPoint K Xt hXt))))
          (wcContSheaf Xt.left (ZMod (ℓ ^ k))) m,
      Function.Injective β ∧
      ∀ z, β ((Abelian.Ext.mk₀ Ψ).comp z (zero_add m)) =
        (Abelian.Ext.mk₀ Ψt).comp (β z) (zero_add m) :=
by
  classical
  subst hj

  have liftV : ∀ {S : Scheme.{u}} {T To Th VT : S.ProEt} (incl : To ⟶ T)
      (hι : IsOpenImmersion incl.left) (xb : T.left) (hxb : Set.range incl.left = {xb}ᶜ)
      (g : Th ⟶ T) (j : VT ⟶ Th) (c : Th.left) (hpre : g.left ⁻¹' {xb} = {c})
      (hrange : Set.range j.left = {c}ᶜ), ∃ gV : VT ⟶ To, gV ≫ incl = j ≫ g := by
    intro S T To Th VT incl hι xb hxb g j c hpre hrange
    haveI := hι
    have hsub : Set.range (j ≫ g).left ⊆ Set.range incl.left := by
      rintro _ ⟨v, rfl⟩
      rw [hxb]
      intro hv
      have hv1 : (j ≫ g).left v = xb := hv
      have hv2 : g.left (j.left v) = xb := by
        rw [show (j ≫ g).left = j.left ≫ g.left from rfl, Scheme.Hom.comp_apply] at hv1
        exact hv1
      have h2 : j.left v ∈ g.left ⁻¹' {xb} := hv2
      rw [hpre] at h2
      have h3 : j.left v ∈ Set.range j.left := ⟨v, rfl⟩
      rw [hrange] at h3
      exact h3 h2
    let Lg : VT.left ⟶ To.left := IsOpenImmersion.lift incl.left (j ≫ g).left hsub
    have hLg : Lg ≫ incl.left = (j ≫ g).left := IsOpenImmersion.lift_fac _ _ hsub
    have hLgw : Lg ≫ To.hom = VT.hom := by
      rw [← MorphismProperty.Over.w incl, ← Category.assoc, hLg]
      show (j.left ≫ g.left) ≫ T.hom = VT.hom
      rw [Category.assoc, MorphismProperty.Over.w g, MorphismProperty.Over.w j]
    exact ⟨MorphismProperty.Over.homMk Lg hLgw trivial, MorphismProperty.Over.Hom.ext hLg⟩

  obtain ⟨L, adj, hLlim, θ, hθ⟩ := wc_proet_push_left_adjoint_free_nat b
  haveI := hLlim
  haveI : L.IsLeftAdjoint := ⟨_, ⟨adj⟩⟩
  haveI : Limits.PreservesColimitsOfSize.{0, 0} L := adj.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits L :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits L
  haveI : L.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint L
  haveI : L.Additive := Functor.additive_of_preserves_binary_products L
  obtain ⟨π, hπ⟩ : ∃ π : L.obj (wcContSheaf X.left (ZMod (ℓ ^ k))) ⟶
      wcContSheaf Xt.left (ZMod (ℓ ^ k)),
      π = (adj.homEquiv (wcContSheaf X.left (ZMod (ℓ ^ k)))
        (wcContSheaf Xt.left (ZMod (ℓ ^ k)))).symm (wcContPull b (ZMod (ℓ ^ k))) := ⟨_, rfl⟩

  obtain ⟨κ, hκ⟩ := wc_pmod_geom_coker_pull_iso K X Xt b hbX O hX hXt L θ hθ
  have hκΨ : κ.inv ≫ L.map Ψ = Ψt ≫ κ.inv := by
    rw [Iso.inv_comp_eq, ← Category.assoc, ← hκ Ψ Ψt hΨ hΨt, Category.assoc, Iso.hom_inv_id,
      Category.comp_id]
  obtain ⟨β, hβ⟩ : ∃ β : Abelian.Ext (Limits.cokernel (wcFreeSheafMap X.left
            (wcOpenRestrIncl X.left O (wcGeomPoint K X hX))))
          (wcContSheaf X.left (ZMod (ℓ ^ k))) (j + 1) →+
        Abelian.Ext (Limits.cokernel (wcFreeSheafMap Xt.left
            (wcOpenRestrIncl Xt.left (b ⁻¹ᵁ O) (wcGeomPoint K Xt hXt))))
          (wcContSheaf Xt.left (ZMod (ℓ ^ k))) (j + 1),
      ∀ z, β z = (Abelian.Ext.mk₀ κ.inv).comp
        ((Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ π) (add_zero (j + 1)))
        (zero_add (j + 1)) :=
    ⟨((Abelian.Ext.mk₀ κ.inv).precomp _ (zero_add (j + 1))).comp
      (((Abelian.Ext.mk₀ π).postcomp _ (add_zero (j + 1))).comp
        (L.mapExtAddHom _ _ (j + 1))), fun z => rfl⟩

  have hequiv : ∀ z, β ((Abelian.Ext.mk₀ Ψ).comp z (zero_add (j + 1))) =
      (Abelian.Ext.mk₀ Ψt).comp (β z) (zero_add (j + 1)) := by
    intro z
    rw [hβ, hβ, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
    simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.mk₀_comp_mk₀_assoc, hκΨ]

  obtain ⟨xb, hxb, hpreS, hln, hqs, hsep, hεall⟩ :=
    wc_pmod_geom_point_local_data K X hpX s hs O hO hX
  haveI := hln
  obtain ⟨Th, g, φh, B, iB, iBn, iBh, iBs, eB, VT, j', φV, -, hpre, hfib, hj', hrangeJ, -, hTc⟩ :=
    wc_proet_strict_nbhd_of_fixed_point X.left (wcGeomPoint K X hX) xb (𝟙 _)
      (by first | rfl | simp) hsep
  have hι : IsOpenImmersion (wcOpenRestrIncl X.left O (wcGeomPoint K X hX)).left := by
    show IsOpenImmersion (Limits.pullback.snd O.ι _)
    infer_instance
  obtain ⟨gV, hgV⟩ := liftV _ hι xb hxb g j' _ hpre hrangeJ
  have hrj : Set.range j'.left = g.left ⁻¹' {xb}ᶜ := by
    rw [hrangeJ, Set.preimage_compl, hpre]
  obtain ⟨κ₁, hκ₁iso, -⟩ := wc_lfi_point_excision _ _ _ _ _ _ hι xb hxb g j' hj' hrj gV hgV
    hfib hTc hqs hln
  haveI := hκ₁iso
  have hmono := wc_free_sheaf_map_mono _ _ _ j' (@IsOpenImmersion.mono _ _ _ hj')
  haveI hproj := wc_proet_free_projective_strict_local X.left Th B eB
  have hS : (ShortComplex.mk (wcFreeSheafMap X.left j')
      (Limits.cokernel.π (wcFreeSheafMap X.left j')) (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) hmono inferInstance

  obtain ⟨ε, hεε⟩ := hεall Th g hfib
  have h0 := wc_pmod_strict_nbhd_pull_vanish K X Xt E hpX b hb hbX s hs O hO hbO iE hiE hiEX
    hrange hE ℓ hℓ k j hodd Th B eB ε hεε
  have hvan : ∀ y : Abelian.Ext (L.obj (wcFreeSheaf X.left Th))
      (wcContSheaf Xt.left (ZMod (ℓ ^ k))) j, y = 0 := by
    intro y
    have e1 : y = (Abelian.Ext.mk₀ (θ Th).hom).comp
        ((Abelian.Ext.mk₀ (θ Th).inv).comp y (zero_add j)) (zero_add j) := by
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    rw [e1, h0 ((Abelian.Ext.mk₀ (θ Th).inv).comp y (zero_add j)), Abelian.Ext.comp_zero]

  have hU : Set.range VT.hom ⊆ (O : Set X.left) := by
    rintro _ ⟨v, rfl⟩
    rw [hO]
    intro hv
    have e1 : j'.left ≫ g.left ≫ (wcGeomPoint K X hX).hom = VT.hom := by
      rw [MorphismProperty.Over.w g, MorphismProperty.Over.w j']
    have h1 : VT.hom v = (wcGeomPoint K X hX).hom (g.left (j'.left v)) := by
      rw [← e1, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
    have h2 : g.left (j'.left v) ≠ xb := by
      intro h
      have h3 : j'.left v ∈ g.left ⁻¹' {xb} := h
      rw [hpre] at h3
      have h4 : j'.left v ∈ Set.range j'.left := ⟨v, rfl⟩
      rw [hrangeJ] at h4
      exact h4 h3
    apply h2
    have h5 : g.left (j'.left v) ∈
        (wcGeomPoint K X hX).hom ⁻¹' {s (IsLocalRing.closedPoint K)} := by
      show (wcGeomPoint K X hX).hom (g.left (j'.left v)) ∈
        ({s (IsLocalRing.closedPoint K)} : Set X.left)
      rw [← h1]
      exact hv
    rw [hpreS] at h5
    exact h5
  have hR := wc_pmod_res_injective_over_iso_locus b L adj θ hθ O hbO VT hU (ℓ ^ k) j
  have hres : ∀ w : Abelian.Ext (wcFreeSheaf X.left VT) (wcContSheaf X.left (ZMod (ℓ ^ k))) j,
      (Abelian.Ext.mapExactFunctor L w).comp (Abelian.Ext.mk₀ π) (add_zero j) = 0 → w = 0 := by
    intro w hw
    apply hR
    have e : wcProEtRes b L adj θ (ZMod (ℓ ^ k)) VT j w =
        (Abelian.Ext.mk₀ (θ VT).inv).comp
          ((Abelian.Ext.mapExactFunctor L w).comp (Abelian.Ext.mk₀ π) (add_zero j))
          (zero_add j) := by
      rw [hπ]
      rfl
    rw [e, hw, Abelian.Ext.comp_zero, map_zero]

  have hchase : ∀ z' : Abelian.Ext (Limits.cokernel (wcFreeSheafMap X.left j'))
      (wcContSheaf X.left (ZMod (ℓ ^ k))) (j + 1),
      (Abelian.Ext.mapExactFunctor L z').comp (Abelian.Ext.mk₀ π) (add_zero (j + 1)) = 0 →
        z' = 0 := by
    intro z' hz'
    obtain ⟨w, hw⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS _ z'
      (Abelian.Ext.eq_zero_of_projective (P := wcFreeSheaf X.left Th) _) (add_comm 1 j)
    have hSF := hS.map_of_exact L
    have e2 : (Abelian.Ext.mapExactFunctor L z').comp (Abelian.Ext.mk₀ π) (add_zero (j + 1)) =
        hSF.extClass.comp ((Abelian.Ext.mapExactFunctor L w).comp (Abelian.Ext.mk₀ π)
          (add_zero j)) (add_comm 1 j) := by
      rw [← hw, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass,
        Abelian.Ext.comp_assoc_of_third_deg_zero]
    rw [e2] at hz'
    obtain ⟨x₂, hx₂⟩ := Abelian.Ext.contravariant_sequence_exact₁ hSF _ _ (add_comm 1 j) hz'
    have hy0 : (Abelian.Ext.mapExactFunctor L w).comp (Abelian.Ext.mk₀ π) (add_zero j) = 0 := by
      rw [← hx₂, show x₂ = 0 from hvan x₂, Abelian.Ext.comp_zero]
    rw [← hw, hres w hy0, Abelian.Ext.comp_zero]

  have hinj : Function.Injective β := by
    rw [injective_iff_map_eq_zero]
    intro z hz
    have hz1 : (Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ π)
        (add_zero (j + 1)) = 0 := by
      have h := congrArg (fun t => (Abelian.Ext.mk₀ κ.hom).comp t (zero_add (j + 1))) hz
      simp only [hβ, Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp,
        Abelian.Ext.comp_zero] at h
      exact h
    have hz' : (Abelian.Ext.mapExactFunctor L ((Abelian.Ext.mk₀ κ₁).comp z
        (zero_add (j + 1)))).comp (Abelian.Ext.mk₀ π) (add_zero (j + 1)) = 0 := by
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.comp_assoc_of_third_deg_zero, hz1, Abelian.Ext.comp_zero]
    have hz0 := hchase _ hz'
    have e3 : z = (Abelian.Ext.mk₀ (inv κ₁)).comp ((Abelian.Ext.mk₀ κ₁).comp z
        (zero_add (j + 1))) (zero_add (j + 1)) := by
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, IsIso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
    rw [e3, hz0, Abelian.Ext.comp_zero]
  exact ⟨β, hinj, hequiv⟩

theorem wc_odp_fibre_geom_local_coh_quadric (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m)
    (hX : WeaklyEtale (Limits.pullback.fst (Over.mk (Limits.pullback.snd D.f (D.S i))).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (a : Fin (n - 2 + 1 + 1) → Fin (n - 2 + 1 + 1) → F'')
    (ha : (Matrix.of a + (Matrix.of a).transpose).det ≠ 0)
    (t : Fin n → D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F'')))
    (τ : (wcP1Over F'').left.presheaf.stalk (D.f (D.xs i (IsLocalRing.closedPoint F''))))
    (A : Matrix (Fin n) (Fin n) (D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F''))))
    (ht : IsLocalRing.maximalIdeal (D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F''))) =
        Ideal.span (Set.range t))
    (hτ : IsLocalRing.maximalIdeal
          ((wcP1Over F'').left.presheaf.stalk (D.f (D.xs i (IsLocalRing.closedPoint F'')))) =
        Ideal.span {τ})
    (hA : (D.f.stalkMap (D.xs i (IsLocalRing.closedPoint F''))).hom τ - ∑ a, ∑ c, A a c * t a * t c ∈
        IsLocalRing.maximalIdeal (D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F''))) ^ 3)
    (hAa : ∀ p c : Fin (n - 2 + 1 + 1),
        A (Fin.cast (by omega) p) (Fin.cast (by omega) c) -
            wcLdpConst F'' D.Yt.hom (D.xs i (IsLocalRing.closedPoint F'')) (a p c) ∈
          IsLocalRing.maximalIdeal (D.Yt.left.presheaf.stalk (D.xs i (IsLocalRing.closedPoint F''))))
    (E₀ : Over (Spec (.of F''))) (hpr : IsProper E₀.hom)
    (hsm : SmoothOfRelativeDimension (n - 2) E₀.hom)
    (jE : E₀.left ⟶ wcProjK F'' (n - 2 + 1)) (hjE : IsClosedImmersion jE)
    (hjEY : jE ≫ wcProjKStr F'' (n - 2 + 1) = E₀.hom)
    (hEG : ∀ (x : E₀.left) (c : Fin (n - 2 + 1 + 1)) (hx : x ∈ jE ⁻¹ᵁ wcSgD F'' (n - 2 + 1) c),
      wcLdpGerm F'' (n - 2 + 1) jE (wcLdpQuad F'' (n - 2 + 1) a) c x hx ∈
        IsLocalRing.maximalIdeal (E₀.left.presheaf.stalk x))
    (hEall : ∀ p : wcProjK F'' (n - 2 + 1), (∀ (c : Fin (n - 2 + 1 + 1))
        (hp : p ∈ wcSgD F'' (n - 2 + 1) c),
        ((wcProjK F'' (n - 2 + 1)).presheaf.germ (wcSgD F'' (n - 2 + 1) c) p hp).hom
            (wcLdpSec F'' (n - 2 + 1) (wcLdpQuad F'' (n - 2 + 1) a) c) ∈
          IsLocalRing.maximalIdeal ((wcProjK F'' (n - 2 + 1)).presheaf.stalk p)) →
      p ∈ Set.range jE)
    (hE : WeaklyEtale (Limits.pullback.fst E₀.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (k : ℕ)
    (hodd : ∀ x : wcCohG F'' E₀ hE (wcContSheaf E₀.left (ZMod (ℓ ^ k))) (n - 2 + 1), x = 0)
    (Ψ : Limits.cokernel (wcFreeSheafMap (Limits.pullback D.f (D.S i))
          (wcOpenRestrIncl (Limits.pullback D.f (D.S i)) (wcCritPunctOpen D i)
            (wcGeomPoint F'' (Over.mk (Limits.pullback.snd D.f (D.S i))) hX))) ⟶
        Limits.cokernel (wcFreeSheafMap (Limits.pullback D.f (D.S i))
          (wcOpenRestrIncl (Limits.pullback D.f (D.S i)) (wcCritPunctOpen D i)
            (wcGeomPoint F'' (Over.mk (Limits.pullback.snd D.f (D.S i))) hX))))
    (hΨ : Limits.cokernel.π _ ≫ Ψ = wcFreeSheafMap (Limits.pullback D.f (D.S i))
        (wcGeomFrob F'' (Over.mk (Limits.pullback.snd D.f (D.S i))) hX) ≫ Limits.cokernel.π _) :
    ∃ ι₂ : Abelian.Ext (Limits.cokernel (wcFreeSheafMap (Limits.pullback D.f (D.S i))
          (wcOpenRestrIncl (Limits.pullback D.f (D.S i)) (wcCritPunctOpen D i)
            (wcGeomPoint F'' (Over.mk (Limits.pullback.snd D.f (D.S i))) hX))))
          (wcContSheaf (Limits.pullback D.f (D.S i)) (ZMod (ℓ ^ k))) n →+
        wcCohG F'' E₀ hE (wcContSheaf E₀.left (ZMod (ℓ ^ k))) (n - 2),
      Function.Injective ι₂ ∧
      ∀ z, ι₂ ((Abelian.Ext.mk₀ Ψ).comp z (zero_add n)) =
        Nat.card F'' • wcCohGFrob F'' E₀ hE (wcContSheaf E₀.left (ZMod (ℓ ^ k))) (n - 2) (ι₂ z) :=
by
  classical

  have F0 : ∀ {S : Scheme.{u}} {U V W : S.ProEt} (a : U ⟶ V) (b : V ⟶ W),
      wcFreeSheafMap S (a ≫ b) = wcFreeSheafMap S a ≫ wcFreeSheafMap S b := by
    intro S U V W a b
    have h := (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_comp
      (Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
      (Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    first
      | rw [← Functor.whiskerRight_comp, ← yoneda.map_comp] at h
      | rw [← Functor.comp_whiskerRight, ← yoneda.map_comp] at h
    exact h
  have Hres : ∀ {S : Scheme.{u}} (O : S.Opens) (Tc : S.ProEt) (φ : Tc ⟶ Tc),
      ∃ φo : wcOpenRestr S O Tc ⟶ wcOpenRestr S O Tc,
        φo ≫ wcOpenRestrIncl S O Tc = wcOpenRestrIncl S O Tc ≫ φ := by
    intro S O Tc φ
    have w : φ.left ≫ Tc.hom = Tc.hom := MorphismProperty.Over.w φ
    have hc : Limits.pullback.fst O.ι Tc.hom ≫ O.ι =
        (Limits.pullback.snd O.ι Tc.hom ≫ φ.left) ≫ Tc.hom :=
      Limits.pullback.condition.trans
        ((congrArg (fun k => Limits.pullback.snd O.ι Tc.hom ≫ k) w).symm.trans
          (Category.assoc _ _ _).symm)
    have hl : Limits.pullback.lift (Limits.pullback.fst O.ι Tc.hom)
        (Limits.pullback.snd O.ι Tc.hom ≫ φ.left) hc ≫ (Limits.pullback.snd O.ι Tc.hom ≫ Tc.hom) =
        Limits.pullback.snd O.ι Tc.hom ≫ Tc.hom :=
      (Category.assoc _ _ _).symm.trans
        ((congrArg (fun k => k ≫ Tc.hom) (Limits.pullback.lift_snd _ _ hc)).trans
          ((Category.assoc _ _ _).trans
            (congrArg (fun k => Limits.pullback.snd O.ι Tc.hom ≫ k) w)))
    refine ⟨MorphismProperty.Over.homMk (Limits.pullback.lift (Limits.pullback.fst O.ι Tc.hom)
        (Limits.pullback.snd O.ι Tc.hom ≫ φ.left) hc) (by exact hl) trivial, ?_⟩
    apply MorphismProperty.Over.Hom.ext
    exact Limits.pullback.lift_snd _ _ _
  have Hcok : ∀ {S : Scheme.{u}} (O : S.Opens) (Tc : S.ProEt) (φ : Tc ⟶ Tc),
      ∃ Φ : Limits.cokernel (wcFreeSheafMap S (wcOpenRestrIncl S O Tc)) ⟶
          Limits.cokernel (wcFreeSheafMap S (wcOpenRestrIncl S O Tc)),
        Limits.cokernel.π (wcFreeSheafMap S (wcOpenRestrIncl S O Tc)) ≫ Φ =
          wcFreeSheafMap S φ ≫ Limits.cokernel.π (wcFreeSheafMap S (wcOpenRestrIncl S O Tc)) := by
    intro S O Tc φ
    obtain ⟨φo, hcomm⟩ := Hres O Tc φ
    have hdesc : wcFreeSheafMap S (wcOpenRestrIncl S O Tc) ≫ wcFreeSheafMap S φ ≫
        Limits.cokernel.π (wcFreeSheafMap S (wcOpenRestrIncl S O Tc)) = 0 := by
      rw [← Category.assoc, ← F0, ← hcomm, F0, Category.assoc, Limits.cokernel.condition,
        Limits.comp_zero]
    exact ⟨_, Limits.cokernel.π_desc _ _ hdesc⟩


  have hP1sep : IsSeparated (wcP1Over F'').hom := by
    show IsSeparated (wcProjKStr F'' 1)
    infer_instance
  haveI := hP1sep
  haveI hYtp : IsProper D.Yt.hom := D.proper
  haveI hfp : IsProper D.f := by
    haveI : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; exact hYtp
    exact IsProper.of_comp D.f (wcP1Over F'').hom
  have hXp : IsProper (Over.mk (Limits.pullback.snd D.f (D.S i))).hom := by
    show IsProper (Limits.pullback.snd D.f (D.S i))
    infer_instance
  have hxsf : D.xs i ≫ D.f = 𝟙 _ ≫ D.S i := (D.hxs i).trans (Category.id_comp _).symm
  let s : Spec (.of F'') ⟶ Limits.pullback D.f (D.S i) := Limits.pullback.lift (D.xs i) (𝟙 _) hxsf
  have hs : s ≫ (Over.mk (Limits.pullback.snd D.f (D.S i))).hom = 𝟙 _ :=
    Limits.pullback.lift_snd _ _ _
  have hsf : s ≫ Limits.pullback.fst D.f (D.S i) = D.xs i := Limits.pullback.lift_fst _ _ _
  haveI hSci : IsClosedImmersion (D.S i) :=
    isClosedImmersion_of_comp_eq_id (wcP1Over F'').hom (D.S i) (D.hS i)
  have hxsY : D.xs i ≫ D.Yt.hom = 𝟙 _ := by
    rw [← D.hf, ← Category.assoc, D.hxs i, D.hS i]
  haveI hxci : IsClosedImmersion (D.xs i) :=
    isClosedImmersion_of_comp_eq_id D.Yt.hom (D.xs i) hxsY
  have hclosed : IsClosed ({D.xs i (IsLocalRing.closedPoint F'')} : Set D.Yt.left) := by
    have h1 : IsClosed (Set.range (D.xs i)) := (D.xs i).isClosedEmbedding.isClosed_range
    have h2 : Set.range (D.xs i) = {D.xs i (IsLocalRing.closedPoint F'')} := by
      ext y
      constructor
      · rintro ⟨z, rfl⟩
        rw [Subsingleton.elim z (IsLocalRing.closedPoint F'')]
        rfl
      · rintro rfl
        exact ⟨_, rfl⟩
    rw [← h2]; exact h1
  have hfinj : Function.Injective (Limits.pullback.fst D.f (D.S i)) :=
    (Limits.pullback.fst D.f (D.S i)).isClosedEmbedding.injective
  have hO : SetLike.coe (wcCritPunctOpen D i) = {s (IsLocalRing.closedPoint F'')}ᶜ := by
    ext x
    show x ∈ (Limits.pullback.fst D.f (D.S i)) ⁻¹' (closure {D.xs i (IsLocalRing.closedPoint F'')})ᶜ ↔ _
    rw [hclosed.closure_eq]
    simp only [Set.mem_preimage, Set.mem_compl_iff, Set.mem_singleton_iff]
    have hfs : (Limits.pullback.fst D.f (D.S i)) (s (IsLocalRing.closedPoint F'')) =
        D.xs i (IsLocalRing.closedPoint F'') := by
      first
        | exact congrArg (fun g : Spec (.of F'') ⟶ D.Yt.left => g (IsLocalRing.closedPoint F'')) hsf
        | exact (Scheme.Hom.comp_apply _ _ _).symm.trans
            (congrArg (fun g : Spec (.of F'') ⟶ D.Yt.left => g (IsLocalRing.closedPoint F'')) hsf)
        | simp [← hsf]
    constructor
    · intro h hx
      exact h (hx ▸ hfs)
    · intro h hx
      exact h (hfinj (hx.trans hfs.symm))

  obtain ⟨Xt, hpXt, hsXt, b, iE, hb, hbX, hbO, hiE, hiEX, hrange⟩ :=
    wc_odp_fibre_blowup_model F' F'' Y n hn2 D i a ha t τ A ht hτ hA hAa E₀ hpr hsm jE hjE hjEY
      hEG hEall

  have hXt : WeaklyEtale (Limits.pullback.fst Xt.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F'')

  obtain ⟨Ψt, hΨt⟩ := Hcok (b ⁻¹ᵁ wcCritPunctOpen D i) (wcGeomPoint F'' Xt hXt)
    (wcGeomFrob F'' Xt hXt)

  obtain ⟨β, hβ, hβΨ⟩ := wc_proper_modif_point_local_coh_pull_inj F''
    (Over.mk (Limits.pullback.snd D.f (D.S i))) Xt E₀ hXp b hb hbX s hs (wcCritPunctOpen D i)
    hO hbO iE hiE hiEX hrange hX hXt hE ℓ hℓ k n (n - 2 + 1) hn2 (by omega) hodd Ψ hΨ Ψt hΨt

  obtain ⟨γ, hγ, hγΨ⟩ := wc_smooth_divisor_local_coh_gysin_frob F'' Xt E₀ hpXt (n - 2) hsXt hpr
    hsm iE hiE hiEX (b ⁻¹ᵁ wcCritPunctOpen D i) hrange hXt hE ℓ hℓ k n hn2 Ψt hΨt

  refine ⟨γ.comp β, hγ.comp hβ, fun z => ?_⟩
  show γ (β ((Abelian.Ext.mk₀ Ψ).comp z (zero_add n))) = _
  rw [hβΨ, hγΨ]
  rfl

theorem wc_odp_punct_germ_quadric_embed (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V₀ : (wcP1Over F'').left.ProEt) (φ₀ : V₀ ⟶ V₀)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom (D.S i) ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom (D.S i))
    (hεφ : ε.inv ≫ Limits.pullback.fst V₀.hom (D.S i) ≫ φ₀.left =
      Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
