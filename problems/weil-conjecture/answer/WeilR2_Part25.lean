    obtain ⟨a, ha⟩ : ∃ a : ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
          ((wcProEtPullback D.f).obj V₀)).left ⟶ Limits.pullback V₀.hom (D.S i),
        a ≫ Limits.pullback.fst V₀.hom (D.S i) = fT ≫ fW :=
      ⟨Limits.pullback.lift _ _ hw, Limits.pullback.lift_fst _ _ _⟩
    haveI : IsProper (a ≫ Limits.pullback.fst V₀.hom (D.S i)) := by rw [ha]; exact hfTW
    haveI ha' : IsProper a := IsProper.of_comp a (Limits.pullback.fst V₀.hom (D.S i))
