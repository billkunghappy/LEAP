    have hw : (fT ≫ fW) ≫ V₀.hom =
        (((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
          ((wcProEtPullback D.f).obj V₀)).hom ≫ Limits.pullback.snd D.f (D.S i)) ≫ D.S i := by
      calc (fT ≫ fW) ≫ V₀.hom = fT ≫ (fW ≫ V₀.hom) := Category.assoc _ _ _
        _ = fT ≫ (((wcProEtPullback D.f).obj V₀).hom ≫ D.f) := by rw [hc1]
        _ = (fT ≫ ((wcProEtPullback D.f).obj V₀).hom) ≫ D.f := (Category.assoc _ _ _).symm
        _ = (((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
              ((wcProEtPullback D.f).obj V₀)).hom ≫ Limits.pullback.fst D.f (D.S i)) ≫ D.f := by
            rw [hc2]
        _ = ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
              ((wcProEtPullback D.f).obj V₀)).hom ≫ (Limits.pullback.fst D.f (D.S i) ≫ D.f) :=
            Category.assoc _ _ _
        _ = ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
              ((wcProEtPullback D.f).obj V₀)).hom ≫ (Limits.pullback.snd D.f (D.S i) ≫ D.S i) := by
            rw [hc3]
        _ = (((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
              ((wcProEtPullback D.f).obj V₀)).hom ≫ Limits.pullback.snd D.f (D.S i)) ≫ D.S i :=
