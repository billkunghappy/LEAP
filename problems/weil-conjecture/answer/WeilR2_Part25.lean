      | infer_instance
      | exact MorphismProperty.of_isPullback (P := @IsProper) hZ ‹IsProper fA›
      | exact MorphismProperty.of_isPullback (P := @IsProper) hZ.flip ‹IsProper fA›
    have hw : p ≫ fA = (p' ≫ Spec.map (CommRingCat.ofHom σ)) ≫
