theorem wc_pencil_Rq_offmid_cosp_surj (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (q : ℕ) (hq : q ≠ n - 1) (i : Fin D.m)
    (V : (wcP1Over F'').left.ProEt) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (L : Type u) [Field L] [IsSepClosed L] (Vt : (wcP1Over F'').left.ProEt)
    (eL : Vt.left ≅ Spec (.of L)) (u' : Vt ⟶ V) :
    Function.Surjective ((wcRq D.f ℓ q).obj.map u'.op).hom :=
by
  classical

  have hres : IsSepClosed (IsLocalRing.ResidueField L) := by
    have hbij : Function.Bijective (IsLocalRing.residue L) :=
      ⟨(IsLocalRing.residue L).injective, IsLocalRing.residue_surjective⟩
    let eR : L ≃+* IsLocalRing.ResidueField L := RingEquiv.ofBijective _ hbij
    refine IsSepClosed.of_exists_root _ (fun p _ hirr hsep => ?_)
    have hdeg : (p.map (eR.symm : IsLocalRing.ResidueField L →+* L)).degree ≠ 0 := by
      rw [Polynomial.degree_map]
      intro h
      have := hirr.natDegree_pos
      rw [Polynomial.natDegree_eq_of_degree_eq_some h] at this
      exact lt_irrefl 0 this
    obtain ⟨x, hx⟩ := IsSepClosed.exists_root
      (p.map (eR.symm : IsLocalRing.ResidueField L →+* L)) hdeg hsep.map
    refine ⟨eR x, ?_⟩
    have := hx.map (f := (eR : L →+* IsLocalRing.ResidueField L))
    have hc : ((eR : L →+* IsLocalRing.ResidueField L).comp
        (eR.symm : IsLocalRing.ResidueField L →+* L)) = RingHom.id _ := by
      ext y; simp
    rw [Polynomial.map_map, hc, Polynomial.map_id] at this
    exact this
  haveI := hres

  obtain ⟨Φ, -, hΦnat⟩ := wc_pencil_Rq_hm_comparison F' F'' Y n D ℓ
  have hVp : Projective (wcFreeSheaf (wcP1Over F'').left V) :=
    wc_proet_free_projective_strict_local _ V A e
  have hVtp : Projective (wcFreeSheaf (wcP1Over F'').left Vt) :=
    wc_proet_free_projective_strict_local _ Vt L eL
  obtain ⟨Da, hDa⟩ := wc_hm_pull_data_exists ((wcProEtPullback D.f).map u').left ℓ
  choose Dk hDk using fun k : ℕ =>
    wc_zmod_pull_data_exists ((wcProEtPullback D.f).map u').left (ℓ ^ k)
  obtain ⟨hc1, hq1, -, -⟩ := wc_pencil_nbhd_qcqs F' F'' Y n D V A e
  obtain ⟨hc2, hq2, -, -⟩ := wc_pencil_nbhd_qcqs F' F'' Y n D Vt L eL
  haveI := hc1
  haveI := hq1
  haveI := hc2
  haveI := hq2

  have hfY : ∀ k : ℕ, 1 ≤ k →
      Finite (wcZModProEtExt ((wcProEtPullback D.f).obj V).left (ℓ ^ k) q) :=
    fun k hk => (wc_pencil_PL_sp_zmod_finite F' F'' Y n D ℓ hℓ V A e Vt L eL k q hk).1
  have hfT : ∀ k : ℕ, 1 ≤ k →
      Finite (wcZModProEtExt ((wcProEtPullback D.f).obj Vt).left (ℓ ^ k) (q - 1)) :=
    fun k hk => (wc_pencil_PL_sp_zmod_finite F' F'' Y n D ℓ hℓ V A e Vt L eL k
      (q - 1) hk).2

  have hsk : ∀ k : ℕ, 1 ≤ k → Function.Surjective (wcZModPull (Dk k) q) := by
    intro k hk
    by_cases hc : u'.left (eL.inv (IsLocalRing.closedPoint L)) = e.inv (IsLocalRing.closedPoint A)
    · exact (wc_pencil_Rq_sp_torsion_bij_closed F' F'' Y n D ℓ hℓ V A e L Vt eL u' hc k q hk
        (Dk k) (hDk k)).2
    · exact wc_pencil_Rq_sp_torsion_surj_offmid F' F'' Y n hn hn2 D ℓ hℓ q hq i V A e hV
        L Vt eL u' hc k hk (Dk k) (hDk k)

  have hps := wc_ladic_pull_surjective_of_torsion ℓ ((wcProEtPullback D.f).map u').left
    Da hDa Dk hDk q hfY hfT hsk

  intro t
  obtain ⟨y, hy⟩ := hps (Φ q Vt hVtp t)
  refine ⟨(Φ q V hVp).symm y, ?_⟩
  apply (Φ q Vt hVtp).injective
  rw [hΦnat q V Vt hVp hVtp u' Da hDa, AddEquiv.apply_symm_apply, hy]

theorem wc_proet_P1_torsion_cover (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP) (r : ℕ)
    (θ : G.over W ≅ (wcContSheaf (wcP1Over K).left (Fin r → ℚ_[ℓ])).over W)
    (hqc : QuasiCompact w.left) (hconn : ConnectedSpace W.left)
    (hoff : ∀ (z : W.left) (i : Fin m), W.hom z ≠ S i (IsLocalRing.closedPoint K))
    (hcov : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left,
      (∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ z : W.left, w.left z = p)
    (hgal : ∀ (V : (wcP1Over K).left.ProEt) (a b : V ⟶ W), ConnectedSpace V.left →
      a ≫ w = b ≫ w → ∃ γ : W ⟶ W, γ ≫ w = w ∧ b = a ≫ γ)
    (Ub : (wcGeomPoint K (wcP1Over K) hP).left.Opens)
    (hUb : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left, p ∈ Ub ↔
      ∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K))
    (U₂ : Submodule ℚ_[ℓ] (Fin r → ℚ_[ℓ])) (q : ℕ)
    (π : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin q → ℚ_[ℓ]))
    (hπs : ∀ y, ∃ x ∈ U₂, π x = y)
    (hst : ∀ (γ : W ⟶ W) (g : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])), γ ≫ w = w →
      (∀ (s : G.obj.obj (Opposite.op W)) (z : W.left),
        wcContEval (wcP1Over K).left W ((θ.hom.hom.app (Opposite.op (Over.mk γ))).hom s) z =
          g (wcContEval (wcP1Over K).left W
            ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s) z)) →
      ∀ x ∈ U₂, g x ∈ U₂ ∧ ((∀ j, ‖π x j‖ ≤ 1) → ∀ j, ‖π (g x) j‖ ≤ 1))
    (hin : ∀ (i : Fin m) (σ : W ⟶ W) (g : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])),
      σ ≫ w = w →
      (∀ (s : G.obj.obj (Opposite.op W)) (z : W.left),
        wcContEval (wcP1Over K).left W ((θ.hom.hom.app (Opposite.op (Over.mk σ))).hom s) z =
          g (wcContEval (wcP1Over K).left W
            ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s) z)) →
      ∀ (V : (wcP1Over K).left.ProEt) (v : V ⟶ wcGeomPoint K (wcP1Over K) hP)
        (A : Type u) [CommRing A] [HenselianLocalRing A]
        [IsSepClosed (IsLocalRing.ResidueField A)] (e : V.left ≅ Spec (.of A)),
        V.hom (e.inv (IsLocalRing.closedPoint A)) = S i (IsLocalRing.closedPoint K) →
      ∀ (L : Type u) [Field L] [IsSepClosed L] (Vt : (wcP1Over K).left.ProEt)
        (eL : Vt.left ≅ Spec (.of L)) (u' : Vt ⟶ V) (c : Vt ⟶ W) (τ : Vt ⟶ Vt),
        u' ≫ v = c ≫ w → τ ≫ u' = u' → τ ≫ c = c ≫ σ → ∀ x ∈ U₂, π (g x) = π x)
    (k : ℕ) :
    ∃ (E : Scheme.{u}) (πE : E ⟶ Ub.toScheme), IsFinite πE ∧ Etale πE ∧ Surjective πE ∧
      (∀ (i : Fin m) (V : (wcP1Over K).left.ProEt)
        (v : V ⟶ wcGeomPoint K (wcP1Over K) hP)
        (A : Type u) [CommRing A] [HenselianLocalRing A]
        [IsSepClosed (IsLocalRing.ResidueField A)] (e : V.left ≅ Spec (.of A)),
        V.hom (e.inv (IsLocalRing.closedPoint A)) = S i (IsLocalRing.closedPoint K) →
        ∀ y : ↥(Limits.pullback πE (Limits.pullback.snd v.left Ub.ι) : Scheme.{u}),
          ∃ sec : Limits.pullback v.left Ub.ι ⟶ Limits.pullback πE (Limits.pullback.snd v.left Ub.ι),
            sec ≫ Limits.pullback.snd _ _ = 𝟙 _ ∧ y ∈ Set.range ⇑sec) ∧
      (∀ sec : Ub.toScheme ⟶ E, sec ≫ πE = 𝟙 _ →
        ∀ (γ : W ⟶ W) (g : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])), γ ≫ w = w →
          (∀ (s : G.obj.obj (Opposite.op W)) (z : W.left),
            wcContEval (wcP1Over K).left W ((θ.hom.hom.app (Opposite.op (Over.mk γ))).hom s) z =
              g (wcContEval (wcP1Over K).left W
                ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s) z)) →
          ∀ x ∈ U₂, (∀ j, ‖π x j‖ ≤ 1) → ∀ j, ‖π (g x) j - π x j‖ ≤ (ℓ : ℝ) ^ (-(k : ℤ))) :=
by
  classical
  haveI := hconn
  obtain ⟨z₀⟩ : Nonempty W.left := ConnectedSpace.toNonempty

  obtain ⟨Gm, hGa, hGc, hGd, hGe⟩ : ∃ Gm : ↥(Limits.pullback w.left w.left) →
      ((Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])),
      (∀ z, ∃ γ : W ⟶ W, γ ≫ w = w ∧ ∀ (s : G.obj.obj (Opposite.op W)) (x : W.left),
        wcContEval (wcP1Over K).left W ((θ.hom.hom.app (Opposite.op (Over.mk γ))).hom s) x =
          Gm z (wcContEval (wcP1Over K).left W
            ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s) x)) ∧
      (∀ j : Fin r, Continuous (fun z => Gm z (Pi.single j 1))) ∧
      (∀ (Z : Scheme.{u}) (a b d : Z ⟶ W.left) (hab : a ≫ w.left = b ≫ w.left)
        (hbd : b ≫ w.left = d ≫ w.left) (had : a ≫ w.left = d ≫ w.left) (z : Z),
        Gm (Limits.pullback.lift a d had z) =
          Gm (Limits.pullback.lift b d hbd z) ∘ₗ Gm (Limits.pullback.lift a b hab z)) ∧
      (∀ (δ : W ⟶ W) (g : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]))
        (hδ : δ.left ≫ w.left = 𝟙 W.left ≫ w.left), δ ≫ w = w →
        (∀ (s : G.obj.obj (Opposite.op W)) (x : W.left),
          wcContEval (wcP1Over K).left W ((θ.hom.hom.app (Opposite.op (Over.mk δ))).hom s) x =
            g (wcContEval (wcP1Over K).left W
              ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s) x)) →
        ∀ z, Gm (Limits.pullback.lift δ.left (𝟙 W.left) hδ z) ∘ₗ g = LinearMap.id) := by

    haveI hBp : WeaklyEtale (wcGeomPoint K (wcP1Over K) hP).hom :=
      (wcGeomPoint K (wcP1Over K) hP).prop
    haveI hWp : WeaklyEtale W.hom := W.prop
    haveI hwB : WeaklyEtale (w.left ≫ (wcGeomPoint K (wcP1Over K) hP).hom) := by
      rw [MorphismProperty.Over.w w]; exact hWp
    haveI hwl : WeaklyEtale w.left :=
      WeaklyEtale.of_comp w.left (wcGeomPoint K (wcP1Over K) hP).hom

    have TR : ∀ (V V' : (wcP1Over K).left.ProEt) (h' : V' ⟶ W) (j : V ⟶ V')
        (y : G.obj.obj (Opposite.op V')) (z : V.left),
        (show C(↥V.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk (j ≫ h')))).hom
            ((G.obj.map j.op).hom y)).down) z =
        (show C(↥V'.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom y).down) (j.left z) := by
      intro V V' h' j y z
      have hn := θ.hom.hom.naturality
        (Over.homMk j (by rfl) : (Over.mk (j ≫ h') : Over W) ⟶ Over.mk h').op
      have h1 := congrArg (fun m => m.hom y) hn
      have h2 : (θ.hom.hom.app (Opposite.op (Over.mk (j ≫ h')))).hom
            ((G.obj.map j.op).hom y) =
          ((wcContSheaf (wcP1Over K).left (Fin r → ℚ_[ℓ])).obj.map j.op).hom
            ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom y) := h1
      rw [h2]
      rfl

    have hcancel2 : ∀ (T : Over W)
        (c : ((wcContSheaf (wcP1Over K).left (Fin r → ℚ_[ℓ])).over W).obj.obj
          (Opposite.op T)),
        (θ.hom.hom.app (Opposite.op T)).hom ((θ.inv.hom.app (Opposite.op T)).hom c) = c := by
      intro T c
      exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom c) θ.inv_hom_id
    have hK : ∀ (V : (wcP1Over K).left.ProEt) (a : V ⟶ W) (v₀ : Fin r → ℚ_[ℓ]),
        ∃ t : G.obj.obj (Opposite.op V), ∀ x : V.left,
          (show C(↥V.left, Fin r → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom t).down) x = v₀ := by
      intro V a v₀
      let c : (wcContSheaf (wcP1Over K).left (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op V) :=
        (show (wcContSheaf (wcP1Over K).left (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op V) from
          ULift.up (ContinuousMap.const ↥V.left v₀))
      refine ⟨(θ.inv.hom.app (Opposite.op (Over.mk a))).hom c, fun x => ?_⟩
      have hs := hcancel2 (Over.mk a) c
      exact congrArg (fun y : ULift.{u+1} C(↥V.left, Fin r → ℚ_[ℓ]) => y.down x) hs

    choose A hA using fun γ : W ⟶ W =>
      wc_proet_deck_frame_linear (wcP1Over K).left ℓ G W hconn r θ γ

    have hnbhd : ∀ (V₀ : (wcP1Over K).left.ProEt) (z : V₀.left),
        ∃ (V₁ : (wcP1Over K).left.ProEt) (kk : V₁ ⟶ V₀) (z₁ : V₁.left),
          ConnectedSpace V₁.left ∧ kk.left z₁ = z := by
      intro V₀ z
      have hι : WeaklyEtale (V₀.left.fromSpecStalk z) := by
        refine ⟨?_, inferInstance⟩
        obtain ⟨_, ⟨U, hU, rfl⟩, hx, -⟩ :=
          V₀.left.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ z) isOpen_univ
        replace hU : IsAffineOpen U := hU
        rw [← hU.fromSpecStalk_eq_fromSpecStalk hx]
        show Flat (Spec.map (V₀.left.presheaf.germ U z hx) ≫ hU.fromSpec)
        have : Flat (Spec.map (V₀.left.presheaf.germ U z hx)) := by
          rw [HasRingHomProperty.Spec_iff (P := @Flat)]
          letI : Algebra Γ(V₀.left, U) (V₀.left.presheaf.stalk z) :=
            (V₀.left.presheaf.germ U z hx).hom.toAlgebra
          haveI := hU.isLocalization_stalk ⟨z, hx⟩
          exact RingHom.flat_algebraMap_iff.mpr
            (IsLocalization.flat _ (hU.primeIdealOf ⟨z, hx⟩).asIdeal.primeCompl)
        have hoi : IsOpenImmersion hU.fromSpec := hU.isOpenImmersion_fromSpec
        have hfs : Flat hU.fromSpec := Flat.instOfIsOpenImmersion _
        exact MorphismProperty.comp_mem @Flat _ _ this hfs
      have hcomp : WeaklyEtale (V₀.left.fromSpecStalk z ≫ V₀.hom) :=
        @MorphismProperty.comp_mem _ _ @WeaklyEtale
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ hι V₀.prop
      let V₁ : (wcP1Over K).left.ProEt :=
        MorphismProperty.Over.mk ⊤ (V₀.left.fromSpecStalk z ≫ V₀.hom) hcomp
      let kk : V₁ ⟶ V₀ := MorphismProperty.Over.homMk (V₀.left.fromSpecStalk z) rfl trivial
      have hconnR : ∀ (R : CommRingCat.{u}) [IsLocalRing R], ConnectedSpace (Spec R) := by
        intro R _
        have hpre : PreconnectedSpace (PrimeSpectrum R) := by
          rw [preconnectedSpace_iff_clopen]
          intro s hs
          obtain ⟨e, he, rfl⟩ := PrimeSpectrum.isClopen_iff.mp hs
          rcases IsLocalRing.isUnit_or_isUnit_one_sub_self e with h | h
          · right
            have he1 : e = 1 := h.mul_left_cancel (by rw [mul_one]; exact he.eq)
            subst he1
            simp
          · left
            have he0 : e = 0 := by
              have h0 : (1 - e) * e = (1 - e) * 0 := by
                rw [sub_mul, one_mul, he.eq, sub_self, mul_zero]
              exact h.mul_left_cancel h0
            subst he0
            simp
        have hc : ConnectedSpace (PrimeSpectrum R) :=
          { toPreconnectedSpace := hpre, toNonempty := ⟨IsLocalRing.closedPoint R⟩ }
        exact hc
      exact ⟨V₁, kk, IsLocalRing.closedPoint _, hconnR (V₀.left.presheaf.stalk z),
        Scheme.fromSpecStalk_closedPoint⟩

    haveI : WeaklyEtale (Limits.pullback.fst w.left w.left) := inferInstance
    haveI : WeaklyEtale (Limits.pullback.fst w.left w.left ≫ W.hom) := inferInstance
    let Zo : (wcP1Over K).left.ProEt :=
      Scheme.ProEt.mk (Limits.pullback.fst w.left w.left ≫ W.hom)
    let P₁ : Zo ⟶ W :=
      MorphismProperty.Over.homMk (Limits.pullback.fst w.left w.left) rfl trivial
    have h₂ : Limits.pullback.snd w.left w.left ≫ W.hom =
        Limits.pullback.fst w.left w.left ≫ W.hom := by
      rw [← MorphismProperty.Over.w w, ← Category.assoc, ← Category.assoc,
        Limits.pullback.condition]
    let P₂ : Zo ⟶ W :=
      MorphismProperty.Over.homMk (Limits.pullback.snd w.left w.left) h₂ trivial
    have hPw : P₁ ≫ w = P₂ ≫ w := by
      apply MorphismProperty.Over.Hom.ext
      exact Limits.pullback.condition (f := w.left) (g := w.left)

    choose V₁ κ z₁ hc hκ using fun z : ↥(Limits.pullback w.left w.left) => hnbhd Zo z
    have hab0 : ∀ z, (κ z ≫ P₁) ≫ w = (κ z ≫ P₂) ≫ w := fun z => by
      rw [Category.assoc, Category.assoc, hPw]
    choose γ hγw hγ using fun z => hgal (V₁ z) (κ z ≫ P₁) (κ z ≫ P₂) (hc z) (hab0 z)

    have hb : ∀ (V : (wcP1Over K).left.ProEt) (a b : V ⟶ W)
        (hl : a.left ≫ w.left = b.left ≫ w.left)
        (t : G.obj.obj (Opposite.op V)) (z : V.left),
        (show C(↥V.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom t).down) z =
        A (γ (Limits.pullback.lift a.left b.left hl z))
          ((show C(↥V.left, Fin r → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom t).down) z) := by
      intro V a b hl t v
      generalize hz₀ : Limits.pullback.lift a.left b.left hl v = z₀
      have hKw : Limits.pullback.lift a.left b.left hl ≫
          (Limits.pullback.fst w.left w.left ≫ W.hom) = V.hom := by
        rw [Limits.pullback.lift_fst_assoc, MorphismProperty.Over.w a]
      let Kh : V ⟶ Zo :=
        MorphismProperty.Over.homMk (Limits.pullback.lift a.left b.left hl) hKw trivial
      have hK1 : Kh ≫ P₁ = a := by
        apply MorphismProperty.Over.Hom.ext
        exact Limits.pullback.lift_fst a.left b.left hl
      have hK2 : Kh ≫ P₂ = b := by
        apply MorphismProperty.Over.Hom.ext
        exact Limits.pullback.lift_snd a.left b.left hl
      haveI : WeaklyEtale (V₁ z₀).hom := (V₁ z₀).prop
      haveI hVp : WeaklyEtale V.hom := V.prop
      haveI hZp : WeaklyEtale Zo.hom := Zo.prop
      haveI : WeaklyEtale (Kh.left ≫ Zo.hom) := by
        rw [MorphismProperty.Over.w Kh]; exact hVp
      haveI : WeaklyEtale Kh.left := WeaklyEtale.of_comp Kh.left Zo.hom
      haveI : WeaklyEtale (Limits.pullback.fst (κ z₀).left Kh.left) := inferInstance
      haveI : WeaklyEtale (Limits.pullback.fst (κ z₀).left Kh.left ≫ (V₁ z₀).hom) :=
        inferInstance
      let Q : (wcP1Over K).left.ProEt :=
        Scheme.ProEt.mk (Limits.pullback.fst (κ z₀).left Kh.left ≫ (V₁ z₀).hom)
      let p₁ : Q ⟶ V₁ z₀ :=
        MorphismProperty.Over.homMk (Limits.pullback.fst (κ z₀).left Kh.left) rfl trivial
      have hq2 : Limits.pullback.snd (κ z₀).left Kh.left ≫ V.hom =
          Limits.pullback.fst (κ z₀).left Kh.left ≫ (V₁ z₀).hom := by
        rw [← MorphismProperty.Over.w Kh, ← MorphismProperty.Over.w (κ z₀), ← Category.assoc,
          ← Category.assoc, Limits.pullback.condition]
      let p₂ : Q ⟶ V :=
        MorphismProperty.Over.homMk (Limits.pullback.snd (κ z₀).left Kh.left) hq2 trivial
      have hsq : p₁ ≫ κ z₀ = p₂ ≫ Kh := by
        apply MorphismProperty.Over.Hom.ext
        exact Limits.pullback.condition (f := (κ z₀).left) (g := Kh.left)
      obtain ⟨qq, -, hqv⟩ := Scheme.Pullback.exists_preimage_pullback
        (f := (κ z₀).left) (g := Kh.left) (z₁ z₀) v ((hκ z₀).trans hz₀.symm)
      have key : p₂ ≫ b = (p₂ ≫ a) ≫ γ z₀ := by
        calc p₂ ≫ b = p₂ ≫ Kh ≫ P₂ := by rw [hK2]
          _ = (p₂ ≫ Kh) ≫ P₂ := (Category.assoc _ _ _).symm
          _ = (p₁ ≫ κ z₀) ≫ P₂ := by rw [hsq]
          _ = p₁ ≫ (κ z₀ ≫ P₂) := Category.assoc _ _ _
          _ = p₁ ≫ ((κ z₀ ≫ P₁) ≫ γ z₀) := by rw [hγ z₀]
          _ = ((p₁ ≫ κ z₀) ≫ P₁) ≫ γ z₀ := by simp only [Category.assoc]
          _ = ((p₂ ≫ Kh) ≫ P₁) ≫ γ z₀ := by rw [hsq]
          _ = (p₂ ≫ a) ≫ γ z₀ := by rw [Category.assoc p₂, hK1]
      have hF := hA (γ z₀) Q (p₂ ≫ a) (p₂ ≫ b) key
        ((G.obj.map p₂.op).hom t) qq
      have L1 := TR Q V b p₂ t qq
      have R1 := TR Q V a p₂ t qq
      have hp' : p₂.left qq = v := hqv
      rw [hp'] at L1 R1
      exact L1.symm.trans (hF.trans (congrArg (A (γ z₀)) R1))
    refine ⟨fun z => A (γ z), ?_, ?_, ?_, ?_⟩
    ·
      intro z
      exact ⟨γ z, hγw z, fun s x => hA (γ z) W (𝟙 W) (γ z) (Category.id_comp _).symm s x⟩
    ·
      intro j
      have hl : P₁.left ≫ w.left = P₂.left ≫ w.left :=
        Limits.pullback.condition (f := w.left) (g := w.left)
      have hid : ∀ z : ↥(Limits.pullback w.left w.left),
          Limits.pullback.lift P₁.left P₂.left hl z = z := by
        intro z
        have e : Limits.pullback.lift P₁.left P₂.left hl = 𝟙 _ :=
          Limits.pullback.lift_fst_snd w.left w.left
        rw [e]
        rfl
      obtain ⟨t, ht⟩ := hK Zo P₁ (Pi.single j 1)
      have hcont := (show C(↥Zo.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk P₂))).hom t).down).continuous
      refine hcont.congr ?_
      intro z
      have h1 := hb Zo P₁ P₂ hl t z
      rw [ht z, hid z] at h1
      exact h1
    ·
      intro Z a b d hab hbd had z
      obtain ⟨f₂, hf₂⟩ : ∃ f : Limits.pullback w.left w.left ⟶
          (wcGeomPoint K (wcP1Over K) hP).left,
          f = Limits.pullback.snd w.left w.left ≫ w.left := ⟨_, rfl⟩
      haveI : WeaklyEtale (Limits.pullback.fst f₂ w.left) := inferInstance
      haveI : WeaklyEtale (Limits.pullback.fst f₂ w.left ≫
        Limits.pullback.fst w.left w.left ≫ W.hom) := inferInstance
      let Q3 : (wcP1Over K).left.ProEt := Scheme.ProEt.mk (Limits.pullback.fst f₂ w.left ≫
        Limits.pullback.fst w.left w.left ≫ W.hom)
      have eab : (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.fst w.left w.left) ≫ w.left =
          (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left) ≫ w.left := by
        rw [Category.assoc, Category.assoc, Limits.pullback.condition (f := w.left) (g := w.left)]
      have ebd : (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left) ≫ w.left =
          Limits.pullback.snd f₂ w.left ≫ w.left := by
        rw [Category.assoc, ← hf₂]
        exact Limits.pullback.condition (f := f₂) (g := w.left)
      have ead := eab.trans ebd
      have hqb : (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left) ≫ W.hom =
          Limits.pullback.fst f₂ w.left ≫ Limits.pullback.fst w.left w.left ≫ W.hom := by
        rw [← MorphismProperty.Over.w w,
          ← Category.assoc (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left),
          ← eab]
        simp only [Category.assoc]
      have hqd : Limits.pullback.snd f₂ w.left ≫ W.hom =
          Limits.pullback.fst f₂ w.left ≫ Limits.pullback.fst w.left w.left ≫ W.hom := by
        rw [← MorphismProperty.Over.w w, ← Category.assoc (Limits.pullback.snd f₂ w.left),
          ← ebd, ← eab]
        simp only [Category.assoc]
      let Qa : Q3 ⟶ W := MorphismProperty.Over.homMk
        (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.fst w.left w.left)
        (Category.assoc _ _ _) trivial
      let Qb : Q3 ⟶ W := MorphismProperty.Over.homMk
        (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left) hqb trivial
      let Qd : Q3 ⟶ W := MorphismProperty.Over.homMk (Limits.pullback.snd f₂ w.left) hqd trivial
      have hQ : ∀ y : ↥(Limits.pullback f₂ w.left),
          A (γ (Limits.pullback.lift
            (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.fst w.left w.left)
            (Limits.pullback.snd f₂ w.left) ead y)) =
          A (γ (Limits.pullback.lift
            (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left)
            (Limits.pullback.snd f₂ w.left) ebd y)) ∘ₗ
          A (γ (Limits.pullback.lift
            (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.fst w.left w.left)
            (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left) eab y)) := by
        intro y
        apply LinearMap.ext
        intro v₀
        obtain ⟨t, ht⟩ := hK Q3 Qa v₀
        have e1 := hb Q3 Qa Qb eab t y
        have e2 := hb Q3 Qb Qd ebd t y
        have e3 := hb Q3 Qa Qd ead t y
        rw [ht y] at e1 e3
        rw [e1] at e2
        rw [LinearMap.comp_apply]
        exact e3.symm.trans e2
      have hm : Limits.pullback.lift a b hab ≫ f₂ = d ≫ w.left := by
        rw [hf₂, Limits.pullback.lift_snd_assoc]
        exact hbd
      obtain ⟨mm, hm1, hm2⟩ : ∃ mm : Z ⟶ Limits.pullback f₂ w.left,
          mm ≫ Limits.pullback.fst f₂ w.left = Limits.pullback.lift a b hab ∧
          mm ≫ Limits.pullback.snd f₂ w.left = d :=
        ⟨Limits.pullback.lift _ _ hm, Limits.pullback.lift_fst _ _ _,
          Limits.pullback.lift_snd _ _ _⟩
      have ma : mm ≫ (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.fst w.left w.left) = a := by
        rw [← Category.assoc, hm1, Limits.pullback.lift_fst]
      have mb : mm ≫ (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left) = b := by
        rw [← Category.assoc, hm1, Limits.pullback.lift_snd]
      have e_ab : Limits.pullback.lift a b hab = mm ≫ Limits.pullback.lift
          (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.fst w.left w.left)
          (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left) eab := by
        apply Limits.pullback.hom_ext
        · rw [Limits.pullback.lift_fst, Category.assoc, Limits.pullback.lift_fst, ma]
        · rw [Limits.pullback.lift_snd, Category.assoc, Limits.pullback.lift_snd, mb]
      have e_bd : Limits.pullback.lift b d hbd = mm ≫ Limits.pullback.lift
          (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left)
          (Limits.pullback.snd f₂ w.left) ebd := by
