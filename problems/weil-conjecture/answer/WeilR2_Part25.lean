    intro X T fA _ σ p p' hsq m hm E j
    have hmN : m ≠ 0 := by
      rintro rfl
      exact hm Nat.cast_zero
    have hmκ : (m : IsLocalRing.ResidueField A) ≠ 0 := by
      intro h
      apply hm
      rw [← map_natCast σ m, h, map_zero]
    have hZ := IsPullback.of_hasPullback fA (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))
    haveI hZp : IsProper (Limits.pullback.snd fA
        (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))) := by
