    (xb : ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
        ((wcProEtPullback D.f).obj V₀)).left)
    (hxb : Set.range (wcOpenRestrIncl (Limits.pullback D.f (D.S i)) (wcCritPunctOpen D i)
        ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
          ((wcProEtPullback D.f).obj V₀))).left = {xb}ᶜ)
    (Th VT : (Limits.pullback D.f (D.S i)).ProEt)
    (g : Th ⟶ (wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
        ((wcProEtPullback D.f).obj V₀))
    (φh : Th ⟶ Th)
    (hφg : φh ≫ g = g ≫ (wcProEtPullback (Limits.pullback.fst D.f (D.S i))).map
        ((wcProEtPullback D.f).map φ₀))
    (B : Type u) [CommRing B] [IsNoetherianRing B] [HenselianLocalRing B]
    [IsSepClosed (IsLocalRing.ResidueField B)] (eB : Th.left ≅ Spec (.of B))
    (hpre : g.left ⁻¹' {xb} = {eB.inv (IsLocalRing.closedPoint B)})
    (hfib : IsIso (Limits.pullback.snd g.left
        (((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
          ((wcProEtPullback D.f).obj V₀)).left.fromSpecResidueField xb)))
    (j : VT ⟶ Th) (hj : IsOpenImmersion j.left)
    (hrange : Set.range j.left = {eB.inv (IsLocalRing.closedPoint B)}ᶜ)
    (φV : VT ⟶ VT) (hφV : φV ≫ j = j ≫ φh) (k : ℕ) :
    ∃ (a : Fin (n - 2 + 1 + 1) → Fin (n - 2 + 1 + 1) → F''),
      (Matrix.of a + (Matrix.of a).transpose).det ≠ 0 ∧
      ∃ (E₀ : Over (Spec (.of F''))) (_ : IsProper E₀.hom)
        (_ : SmoothOfRelativeDimension (n - 2) E₀.hom)
        (jE : E₀.left ⟶ wcProjK F'' (n - 2 + 1)),
        IsClosedImmersion jE ∧ jE ≫ wcProjKStr F'' (n - 2 + 1) = E₀.hom ∧
        (∀ (x : E₀.left) (c : Fin (n - 2 + 1 + 1)) (hx : x ∈ jE ⁻¹ᵁ wcSgD F'' (n - 2 + 1) c),
          wcLdpGerm F'' (n - 2 + 1) jE (wcLdpQuad F'' (n - 2 + 1) a) c x hx ∈
            IsLocalRing.maximalIdeal (E₀.left.presheaf.stalk x)) ∧
        ∃ hE : WeaklyEtale (Limits.pullback.fst E₀.hom
            (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))),
          (∀ x : wcCohG F'' E₀ hE (wcContSheaf E₀.left (ZMod (ℓ ^ k))) (n - 2 + 1), x = 0) →
          ∃ ι : Abelian.Ext (wcFreeSheaf (Limits.pullback D.f (D.S i)) VT)
              (wcContSheaf (Limits.pullback D.f (D.S i)) (ZMod (ℓ ^ k))) (n - 1) →+
              wcCohG F'' E₀ hE (wcContSheaf E₀.left (ZMod (ℓ ^ k))) (n - 2),
            Function.Injective ι ∧
            ∀ y, ι ((Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f (D.S i)) φV)).comp y
                (zero_add (n - 1))) =
              Nat.card F'' • wcCohGFrob F'' E₀ hE (wcContSheaf E₀.left (ZMod (ℓ ^ k))) (n - 2) (ι y) :=
by
  classical

  have F0 : ∀ {S : Scheme.{u}} {U V W : S.ProEt} (a : U ⟶ V) (b : V ⟶ W),
      wcFreeSheafMap S (a ≫ b) = wcFreeSheafMap S a ≫ wcFreeSheafMap S b := by
    intro S U V W a b
    have h := (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_comp
      (Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
      (Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    first
      | rw [← Functor.whiskerRight_comp, ← yoneda.map_comp] at h
      | rw [← Functor.comp_whiskerRight, ← yoneda.map_comp] at h
    exact h

  have Hres : ∀ {S : Scheme.{u}} (O : S.Opens) (Tc : S.ProEt) (φ : Tc ⟶ Tc),
      ∃ φo : wcOpenRestr S O Tc ⟶ wcOpenRestr S O Tc,
        φo ≫ wcOpenRestrIncl S O Tc = wcOpenRestrIncl S O Tc ≫ φ := by
    intro S O Tc φ
    have w : φ.left ≫ Tc.hom = Tc.hom := MorphismProperty.Over.w φ
    have hc : Limits.pullback.fst O.ι Tc.hom ≫ O.ι =
        (Limits.pullback.snd O.ι Tc.hom ≫ φ.left) ≫ Tc.hom :=
      Limits.pullback.condition.trans
        ((congrArg (fun k => Limits.pullback.snd O.ι Tc.hom ≫ k) w).symm.trans
          (Category.assoc _ _ _).symm)
    have hl : Limits.pullback.lift (Limits.pullback.fst O.ι Tc.hom)
        (Limits.pullback.snd O.ι Tc.hom ≫ φ.left) hc ≫ (Limits.pullback.snd O.ι Tc.hom ≫ Tc.hom) =
        Limits.pullback.snd O.ι Tc.hom ≫ Tc.hom :=
      (Category.assoc _ _ _).symm.trans
        ((congrArg (fun k => k ≫ Tc.hom) (Limits.pullback.lift_snd _ _ hc)).trans
          ((Category.assoc _ _ _).trans
            (congrArg (fun k => Limits.pullback.snd O.ι Tc.hom ≫ k) w)))
    refine ⟨MorphismProperty.Over.homMk (Limits.pullback.lift (Limits.pullback.fst O.ι Tc.hom)
        (Limits.pullback.snd O.ι Tc.hom ≫ φ.left) hc) (by exact hl) trivial, ?_⟩
    apply MorphismProperty.Over.Hom.ext
    exact Limits.pullback.lift_snd _ _ _

  have Hcok : ∀ {S : Scheme.{u}} (O : S.Opens) (Tc : S.ProEt) (φ : Tc ⟶ Tc),
      ∃ Φ : Limits.cokernel (wcFreeSheafMap S (wcOpenRestrIncl S O Tc)) ⟶
          Limits.cokernel (wcFreeSheafMap S (wcOpenRestrIncl S O Tc)),
        Limits.cokernel.π (wcFreeSheafMap S (wcOpenRestrIncl S O Tc)) ≫ Φ =
          wcFreeSheafMap S φ ≫ Limits.cokernel.π (wcFreeSheafMap S (wcOpenRestrIncl S O Tc)) := by
    intro S O Tc φ
    obtain ⟨φo, hcomm⟩ := Hres O Tc φ
    have hdesc : wcFreeSheafMap S (wcOpenRestrIncl S O Tc) ≫ wcFreeSheafMap S φ ≫
        Limits.cokernel.π (wcFreeSheafMap S (wcOpenRestrIncl S O Tc)) = 0 := by
      rw [← Category.assoc, ← F0, ← hcomm, F0, Category.assoc, Limits.cokernel.condition,
        Limits.comp_zero]
    exact ⟨_, Limits.cokernel.π_desc _ _ hdesc⟩

  have liftV : ∀ {S : Scheme.{u}} {T To Th VT : S.ProEt} (incl : To ⟶ T)
      (hι : IsOpenImmersion incl.left) (xb : T.left) (hxb : Set.range incl.left = {xb}ᶜ)
      (g : Th ⟶ T) (j : VT ⟶ Th) (c : Th.left) (hpre : g.left ⁻¹' {xb} = {c})
      (hrange : Set.range j.left = {c}ᶜ), ∃ gV : VT ⟶ To, gV ≫ incl = j ≫ g := by
    intro S T To Th VT incl hι xb hxb g j c hpre hrange
    haveI := hι
    have hsub : Set.range (j ≫ g).left ⊆ Set.range incl.left := by
      rintro _ ⟨v, rfl⟩
      rw [hxb]
      intro hv
      have hv1 : (j ≫ g).left v = xb := hv
      have hv2 : g.left (j.left v) = xb := by
        rw [show (j ≫ g).left = j.left ≫ g.left from rfl, Scheme.Hom.comp_apply] at hv1
        exact hv1
      have h2 : j.left v ∈ g.left ⁻¹' {xb} := hv2
      rw [hpre] at h2
      have h3 : j.left v ∈ Set.range j.left := ⟨v, rfl⟩
      rw [hrange] at h3
      exact h3 h2
    let Lg : VT.left ⟶ To.left := IsOpenImmersion.lift incl.left (j ≫ g).left hsub
    have hLg : Lg ≫ incl.left = (j ≫ g).left := IsOpenImmersion.lift_fac _ _ hsub
    have hLgw : Lg ≫ To.hom = VT.hom := by
      rw [← MorphismProperty.Over.w incl, ← Category.assoc, hLg]
      show (j.left ≫ g.left) ≫ T.hom = VT.hom
      rw [Category.assoc, MorphismProperty.Over.w g, MorphismProperty.Over.w j]
    exact ⟨MorphismProperty.Over.homMk Lg hLgw trivial, MorphismProperty.Over.Hom.ext hLg⟩

  have S3 : ∀ {S : Scheme.{u}} {U V Th VT : S.ProEt} (incl : V ⟶ U) (φU : U ⟶ U)
      (g : Th ⟶ U) (φh : Th ⟶ Th) (j : VT ⟶ Th) (φV : VT ⟶ VT)
      (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (m : ℕ) (hm2 : 2 ≤ m),
      Projective (wcFreeSheaf S Th) → Mono (wcFreeSheafMap S j) →
      ∀ (κ : Limits.cokernel (wcFreeSheafMap S j) ⟶ Limits.cokernel (wcFreeSheafMap S incl)),
      IsIso κ →
      Limits.cokernel.π (wcFreeSheafMap S j) ≫ κ =
        wcFreeSheafMap S g ≫ Limits.cokernel.π (wcFreeSheafMap S incl) →
      φh ≫ g = g ≫ φU → φV ≫ j = j ≫ φh →
      ∀ (Φ : Limits.cokernel (wcFreeSheafMap S incl) ⟶ Limits.cokernel (wcFreeSheafMap S incl)),
      Limits.cokernel.π (wcFreeSheafMap S incl) ≫ Φ =
        wcFreeSheafMap S φU ≫ Limits.cokernel.π (wcFreeSheafMap S incl) →
      ∃ ι₁ : Abelian.Ext (wcFreeSheaf S VT) G (m - 1) →+
          Abelian.Ext (Limits.cokernel (wcFreeSheafMap S incl)) G m,
        Function.Injective ι₁ ∧
        ∀ y, ι₁ ((Abelian.Ext.mk₀ (wcFreeSheafMap S φV)).comp y (zero_add (m - 1))) =
          (Abelian.Ext.mk₀ Φ).comp (ι₁ y) (zero_add m) := by
    intro S U V Th VT incl φU g φh j φV G m hm2 hproj hmono κ hκiso hκπ hφg hφV Φ hΦ
    haveI := hproj
    haveI := hκiso
    have hS : (ShortComplex.mk (wcFreeSheafMap S j)
        (Limits.cokernel.π (wcFreeSheafMap S j)) (Limits.cokernel.condition _)).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) hmono inferInstance
    have hιT : wcFreeSheafMap S j ≫ wcFreeSheafMap S φh ≫
        Limits.cokernel.π (wcFreeSheafMap S j) = 0 := by
      rw [← Category.assoc, ← F0, ← hφV, F0, Category.assoc, Limits.cokernel.condition,
        Limits.comp_zero]
    obtain ⟨σT, hσT⟩ : ∃ σT : Limits.cokernel (wcFreeSheafMap S j) ⟶
        Limits.cokernel (wcFreeSheafMap S j),
        Limits.cokernel.π (wcFreeSheafMap S j) ≫ σT =
          wcFreeSheafMap S φh ≫ Limits.cokernel.π (wcFreeSheafMap S j) :=
      ⟨_, Limits.cokernel.π_desc _ _ hιT⟩
    have hnat : hS.extClass.comp (Abelian.Ext.mk₀ (wcFreeSheafMap S φV)) (add_zero 1) =
        (Abelian.Ext.mk₀ σT).comp hS.extClass (zero_add 1) :=
      hS.extClass_naturality hS
        { τ₁ := wcFreeSheafMap S φV
          τ₂ := wcFreeSheafMap S φh
          τ₃ := σT
          comm₁₂ := (F0 φV j).symm.trans ((congrArg (wcFreeSheafMap S) hφV).trans (F0 j φh))
          comm₂₃ := hσT.symm }
    have hvan : ∀ (p : ℕ) (w : Abelian.Ext (wcFreeSheaf S Th) G p), 1 ≤ p → w = 0 := by
      intro p w hp
      cases p with
      | zero => omega
      | succ k => exact Abelian.Ext.eq_zero_of_projective w
    have hm : 1 + (m - 1) = m := by omega
    have hδF : ∀ w : Abelian.Ext (wcFreeSheaf S VT) G (m - 1),
        (Abelian.Ext.mk₀ σT).comp (hS.extClass.comp w hm) (zero_add m) =
          hS.extClass.comp ((Abelian.Ext.mk₀ (wcFreeSheafMap S φV)).comp w
            (zero_add (m - 1))) hm := by
      intro w
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 1) hm (by omega), ← hnat,
        Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (zero_add (m - 1)) (by omega)]
    have hkey : κ ≫ Φ = σT ≫ κ := by
      apply (cancel_epi (Limits.cokernel.π (wcFreeSheafMap S j))).mp
      rw [reassoc_of% hκπ, hΦ, reassoc_of% hσT, hκπ, ← Category.assoc, ← Category.assoc,
        ← F0, ← F0, hφg]
    have hkey' : inv κ ≫ σT = Φ ≫ inv κ := by
      rw [IsIso.inv_comp_eq, ← Category.assoc, hkey, Category.assoc, IsIso.hom_inv_id,
        Category.comp_id]
    refine ⟨((Abelian.Ext.mk₀ (inv κ)).precomp G (zero_add m)).comp
      (hS.extClass.precomp G hm), ?_, ?_⟩
    · rw [injective_iff_map_eq_zero]
      intro y hy
      change (Abelian.Ext.mk₀ (inv κ)).comp (hS.extClass.comp y hm) (zero_add m) = 0 at hy
      have h1 : hS.extClass.comp y hm = 0 := by
        have h2 := congrArg (fun w => (Abelian.Ext.mk₀ κ).comp w (zero_add m)) hy
        simp only [Abelian.Ext.mk₀_comp_mk₀_assoc, IsIso.hom_inv_id, Abelian.Ext.mk₀_id_comp,
          Abelian.Ext.comp_zero] at h2
        exact h2
      obtain ⟨x₂, hx₂⟩ := Abelian.Ext.contravariant_sequence_exact₁ hS G y hm h1
      rw [← hx₂, hvan _ x₂ (by omega), Abelian.Ext.comp_zero]
    · intro y
      change (Abelian.Ext.mk₀ (inv κ)).comp (hS.extClass.comp
          ((Abelian.Ext.mk₀ (wcFreeSheafMap S φV)).comp y (zero_add (m - 1))) hm) (zero_add m) =
        (Abelian.Ext.mk₀ Φ).comp ((Abelian.Ext.mk₀ (inv κ)).comp (hS.extClass.comp y hm)
          (zero_add m)) (zero_add m)
      rw [← hδF, Abelian.Ext.mk₀_comp_mk₀_assoc, Abelian.Ext.mk₀_comp_mk₀_assoc, hkey']

  obtain ⟨a, t, τ, A₀, ha, ht, hτ, hA, hAa⟩ := wc_odp_residue_quadric_form F' F'' Y n hn2 D i
  obtain ⟨E₀, hpr, hsm, jE, hjE, hjEY, hEG, hEall⟩ :=
    wc_smooth_quadric_hypersurface F'' (n - 2) a ha

  have hE : WeaklyEtale (Limits.pullback.fst E₀.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F'')
  have hX : WeaklyEtale (Limits.pullback.fst (Over.mk (Limits.pullback.snd D.f (D.S i))).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F'')
  refine ⟨a, ha, E₀, hpr, hsm, jE, hjE, hjEY, hEG, hE, fun hodd => ?_⟩

  have hι : IsOpenImmersion (wcOpenRestrIncl (Limits.pullback D.f (D.S i)) (wcCritPunctOpen D i)
      ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
        ((wcProEtPullback D.f).obj V₀))).left := by
    show IsOpenImmersion (Limits.pullback.snd (wcCritPunctOpen D i).ι _)
    infer_instance
  have hTc : CompactSpace Th.left := by
    haveI : CompactSpace (Spec (.of B)) := by
      first
        | exact inferInstance
        | exact (inferInstance : CompactSpace (PrimeSpectrum B))
    first
      | exact (Scheme.homeoOfIso eB).symm.compactSpace
      | exact QuasiCompact.compactSpace_of_compactSpace eB.hom
      | exact (Scheme.homeoOfIso eB.symm).compactSpace
  obtain ⟨-, -, -, hln, hqs, -⟩ := wc_odp_fibre_sing_point F' F'' Y n D i V₀ A e ε hv hε
  obtain ⟨gV, hgV⟩ := liftV _ hι xb hxb g j _ hpre hrange
  have hrj : Set.range j.left = g.left ⁻¹' {xb}ᶜ := by
    rw [hrange, Set.preimage_compl, hpre]
  obtain ⟨κ, hκiso, hκπ⟩ := wc_lfi_point_excision _ _ _ _ _ _ hι xb hxb g j hj hrj gV hgV
    hfib hTc hqs hln
  have hmono := wc_free_sheaf_map_mono _ _ _ j (@IsOpenImmersion.mono _ _ _ hj)
  obtain ⟨ΦT, hΦT⟩ := Hcok (wcCritPunctOpen D i)
    ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj ((wcProEtPullback D.f).obj V₀))
    ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).map ((wcProEtPullback D.f).map φ₀))

  obtain ⟨ι₁, hι₁, hι₁φ⟩ := S3 (wcOpenRestrIncl (Limits.pullback D.f (D.S i)) (wcCritPunctOpen D i)
      ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj ((wcProEtPullback D.f).obj V₀)))
    ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).map ((wcProEtPullback D.f).map φ₀))
    g φh j φV (wcContSheaf (Limits.pullback D.f (D.S i)) (ZMod (ℓ ^ k))) n hn2
    (wc_proet_free_projective_strict_local _ Th B eB) hmono κ hκiso hκπ hφg hφV ΦT hΦT

  obtain ⟨Ψ, hΨ⟩ := Hcok (wcCritPunctOpen D i)
    (wcGeomPoint F'' (Over.mk (Limits.pullback.snd D.f (D.S i))) hX)
    (wcGeomFrob F'' (Over.mk (Limits.pullback.snd D.f (D.S i))) hX)

  obtain ⟨κ', hκ'⟩ := wc_crit_fibre_geom_point_coker_iso F' F'' Y n D i V₀ φ₀ ε hε hεφ hX
  have hc : κ'.hom ≫ Ψ = ΦT ≫ κ'.hom := hκ' ΦT Ψ hΦT hΨ
  have hc' : κ'.inv ≫ ΦT = Ψ ≫ κ'.inv := by
    rw [Iso.inv_comp_eq, ← Category.assoc, hc, Category.assoc, Iso.hom_inv_id, Category.comp_id]
  have hτ₂ : Function.Injective ((Abelian.Ext.mk₀ κ'.inv).precomp
      (wcContSheaf (Limits.pullback D.f (D.S i)) (ZMod (ℓ ^ k))) (zero_add n)) := by
    intro z₁ z₂ h
    change (Abelian.Ext.mk₀ κ'.inv).comp z₁ (zero_add n) =
      (Abelian.Ext.mk₀ κ'.inv).comp z₂ (zero_add n) at h
    have h' := congrArg (fun w => (Abelian.Ext.mk₀ κ'.hom).comp w (zero_add n)) h
    simp only [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp] at h'
    exact h'

  obtain ⟨ι₂, hι₂, hι₂φ⟩ := wc_odp_fibre_geom_local_coh_quadric F' F'' Y n hn hn2 D ℓ hℓ i hX
    a ha t τ A₀ ht hτ hA hAa E₀ hpr hsm jE hjE hjEY hEG hEall hE k hodd Ψ hΨ

  refine ⟨ι₂.comp (((Abelian.Ext.mk₀ κ'.inv).precomp
      (wcContSheaf (Limits.pullback D.f (D.S i)) (ZMod (ℓ ^ k))) (zero_add n)).comp ι₁),
    hι₂.comp (hτ₂.comp hι₁), ?_⟩
  intro y
  change ι₂ ((Abelian.Ext.mk₀ κ'.inv).comp
      (ι₁ ((Abelian.Ext.mk₀ (wcFreeSheafMap (Limits.pullback D.f (D.S i)) φV)).comp y
        (zero_add (n - 1)))) (zero_add n)) =
    Nat.card F'' • wcCohGFrob F'' E₀ hE (wcContSheaf E₀.left (ZMod (ℓ ^ k))) (n - 2)
      (ι₂ ((Abelian.Ext.mk₀ κ'.inv).comp (ι₁ y) (zero_add n)))
  rw [hι₁φ, Abelian.Ext.mk₀_comp_mk₀_assoc, hc', ← Abelian.Ext.mk₀_comp_mk₀_assoc Ψ κ'.inv,
    hι₂φ]

theorem wc_even_quadric_zmod_odd_vanish (K : Type u) [Field K] [Finite K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hℓ : ¬ ℓ ∣ Nat.card K) (d : ℕ) (hd : Even d) (E₀ : Over (Spec (.of K)))
    [IsProper E₀.hom] [SmoothOfRelativeDimension d E₀.hom]
    (jE : E₀.left ⟶ wcProjK K (d + 1)) (hjE : IsClosedImmersion jE)
    (hjEY : jE ≫ wcProjKStr K (d + 1) = E₀.hom)
    (a : Fin (d + 1 + 1) → Fin (d + 1 + 1) → K)
    (ha : (Matrix.of a + (Matrix.of a).transpose).det ≠ 0)
    (hEG : ∀ (x : E₀.left) (c : Fin (d + 1 + 1)) (hx : x ∈ jE ⁻¹ᵁ wcSgD K (d + 1) c),
      wcLdpGerm K (d + 1) jE (wcLdpQuad K (d + 1) a) c x hx ∈
        IsLocalRing.maximalIdeal (E₀.left.presheaf.stalk x))
    (hE : WeaklyEtale (Limits.pullback.fst E₀.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (k : ℕ) :
    ∀ x : wcCohG K E₀ hE (wcContSheaf E₀.left (ZMod (ℓ ^ k))) (d + 1), x = 0 :=
by
  classical
  intro x
  have hℓp : ℓ.Prime := Fact.out
  cases k with
  | zero =>

    have hzero0 : (𝟙 (wcContSheaf E₀.left (ZMod (ℓ ^ 0))) : _ ⟶ _) = 0 := by
      haveI : Subsingleton (ZMod (ℓ ^ 0)) := ZMod.subsingleton_iff.mpr (pow_zero ℓ)
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext V
      apply AddCommGrpCat.ext
      intro y
      apply ULift.ext
      apply ContinuousMap.ext
      intro t
      exact Subsingleton.elim _ _
    calc x = x.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero _) := (Abelian.Ext.comp_mk₀_id x).symm
      _ = 0 := by rw [hzero0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
  | succ n =>

    have hg1 : ((ℓ : ℕ) : AlgebraicClosure K) ≠ 0 := by
      intro h
      have hK : ((ℓ : ℕ) : K) = 0 := by
        apply (algebraMap K (AlgebraicClosure K)).injective
        rw [map_natCast, map_zero]
        exact h
      haveI := Fintype.ofFinite K
      have hp : (ringChar K).Prime := CharP.char_is_prime K (ringChar K)
      have h1 : ringChar K ∣ ℓ := ringChar.dvd hK
      have h2 : ringChar K = ℓ := (Nat.prime_dvd_prime_iff_eq hp hℓp).mp h1
      have h3 : ((Fintype.card K : ℕ) : K) = 0 := FiniteField.cast_card_eq_zero K
      have h4 : ringChar K ∣ Fintype.card K := ringChar.dvd h3
      apply hℓ
      rw [← h2, Nat.card_eq_fintype_card]
      exact h4

    haveI hP : IsProper (Limits.pullback.snd E₀.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) := inferInstance
    haveI hS : SmoothOfRelativeDimension d (Limits.pullback.snd E₀.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) :=
      MorphismProperty.IsStableUnderBaseChange.of_isPullback (P := @SmoothOfRelativeDimension d)
        (IsPullback.of_hasPullback E₀.hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) ‹_›

    have hEt : Subsingleton (wcEtCoh (Limits.pullback E₀.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) (ℓ ^ (n + 1)) (d + 1)) := by
      rcases Nat.eq_zero_or_pos d with hd0 | hdpos
      ·
        have hdim := wc_smooth_alg_closed_dim_le (AlgebraicClosure K) _
          (Limits.pullback.snd E₀.hom
            (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) d
        rw [hd0] at hdim
        exact wc_et_zero_dim_vanishing (AlgebraicClosure K) _
          (Limits.pullback.snd E₀.hom
            (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) hdim
          (ℓ ^ (n + 1)) (pow_ne_zero _ hℓp.ne_zero) (d + 1) (Nat.succ_pos d)
      ·
        have hd2 : 2 ≤ d := by
          obtain ⟨t, ht⟩ := hd
          omega
        apply wc_et_coh_zmod_prime_pow_of_prime _ ℓ hℓp
        obtain ⟨jΩ, hjΩ, hjΩY, hgermΩ⟩ :=
          wc_quadric_germ_base_change K (AlgebraicClosure K) (d + 1) E₀ jE hjE hjEY a hEG
        have hAdet : ((Matrix.of a).map (algebraMap K (AlgebraicClosure K)) +
            ((Matrix.of a).map (algebraMap K (AlgebraicClosure K))).transpose).det ≠ 0 := by
          have e1 : (Matrix.of a).map (algebraMap K (AlgebraicClosure K)) +
              ((Matrix.of a).map (algebraMap K (AlgebraicClosure K))).transpose =
              (Matrix.of a + (Matrix.of a).transpose).map (algebraMap K (AlgebraicClosure K)) := by
            rw [Matrix.map_add _ (fun x y => map_add (algebraMap K (AlgebraicClosure K)) x y),
              Matrix.transpose_map]
          have e2 : ((Matrix.of a + (Matrix.of a).transpose).map
              (algebraMap K (AlgebraicClosure K))).det =
              algebraMap K (AlgebraicClosure K) (Matrix.of a + (Matrix.of a).transpose).det :=
            (RingHom.map_det _ _).symm
          rw [e1, e2]
          exact (map_ne_zero _).mpr ha
        obtain ⟨P, hPdet, hPeq⟩ := wc_quadric_split_normal_form_alg_closed (AlgebraicClosure K) d hd
          ((Matrix.of a).map (algebraMap K (AlgebraicClosure K))) hAdet
        obtain ⟨jY, hjY, hjYY, hgermY⟩ := wc_quadric_germ_linear_change (AlgebraicClosure K) (d + 1)
          _ (Limits.pullback.snd E₀.hom
            (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) jΩ hjΩ hjΩY
          ((Matrix.of a).map (algebraMap K (AlgebraicClosure K)))
          (fun w c hw => hgermΩ w c hw) P hPdet
        exact wc_et_hyperbolic_quadric_odd_vanish (AlgebraicClosure K) ℓ hg1 d hd hd2 _
          (Limits.pullback.snd E₀.hom
            (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) jY hjY hjYY
          (fun w c hw => by rw [← hPeq]; exact hgermY w c hw)

    have hEt' : Subsingleton (wcEtCoh (wcGeomPoint K E₀ hE).left (ℓ ^ (n + 1)) (d + 1)) := hEt
    have hfY : IsProper (Limits.pullback.snd E₀.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) :
          (wcGeomPoint K E₀ hE).left ⟶ Spec (.of (AlgebraicClosure K))) := hP
    obtain ⟨e3⟩ := @wc_proet_etale_comparison_zmod (AlgebraicClosure K) _
      (wcGeomPoint K E₀ hE).left
      (Limits.pullback.snd E₀.hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) :
          (wcGeomPoint K E₀ hE).left ⟶ Spec (.of (AlgebraicClosure K))) hfY (ℓ ^ (n + 1)) (d + 1)
    obtain ⟨c₁⟩ := wc_contSheaf_discrete_const (wcGeomPoint K E₀ hE).left (ZMod (ℓ ^ (n + 1)))
    obtain ⟨c₂⟩ := wc_zmod_sheaf_const (wcGeomPoint K E₀ hE).left (ℓ ^ (n + 1))
    have hZ : ∀ z : Abelian.Ext (wcFreeSheaf (wcGeomPoint K E₀ hE).left
        (Scheme.ProEt.mk (𝟙 (wcGeomPoint K E₀ hE).left)))
        (wcContSheaf (wcGeomPoint K E₀ hE).left (ZMod (ℓ ^ (n + 1)))) (d + 1), z = 0 := by
      intro z
      haveI := hEt'
      haveI := e3.subsingleton
      have h1 : z.comp (Abelian.Ext.mk₀ (c₁ ≪≫ c₂.symm).hom) (add_zero (d + 1)) = 0 :=
        Subsingleton.elim _ _
      calc z = (z.comp (Abelian.Ext.mk₀ (c₁ ≪≫ c₂.symm).hom) (add_zero (d + 1))).comp
            (Abelian.Ext.mk₀ (c₁ ≪≫ c₂.symm).inv) (add_zero (d + 1)) := by
            rw [Abelian.Ext.comp_assoc _ _ _ (add_zero (d + 1)) (add_zero 0) (by omega),
              Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
        _ = 0 := by rw [h1, Abelian.Ext.zero_comp]
    obtain ⟨E1⟩ := wc_ext_free_slice_cont E₀.left (wcGeomPoint K E₀ hE) (ZMod (ℓ ^ (n + 1))) (d + 1)
    exact E1.injective ((hZ (E1 x)).trans (hZ (E1 0)).symm)

theorem wc_odp_punct_germ_zmod_frob_sq (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V₀ : (wcP1Over F'').left.ProEt) (φ₀ : V₀ ⟶ V₀)
