              ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) x) :=
      fun s x => (hX s x).trans (Matrix.toLin'_apply _ _).symm
    have hgh : ((h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) =
        LinearMap.toMatrix' (Matrix.toLin'
          ((h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ])) :=
      (LinearMap.toMatrix'_toLin' _).symm
    have h1 : δ.left ≫ s γ₀ = 𝟙 W.left ≫ s γ₀ := by
      rw [hγ₀', ← Category.assoc, hdeckp δ hδ, Category.id_comp]
    have h2 := (hMR W.left δ.left (𝟙 W.left) (hdeckp' δ hδ) γ₀ γ₀).mp h1 z₀
    rw [hs9 δ _ hδ hg z₀] at h2
    have h3 := mul_left_cancel (h2.symm.trans (mul_one γ₀).symm)
    rw [← hρχ h _ hgh]
    exact h3

theorem wc_vqm_inertia_generation (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (r : ℕ)
    (θ : (wcPencilVQ D ℓ hP).over W ≅ (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W)
    (φ : W ⟶ W) (hB : wcVQGalFrame D ℓ hP W w r θ φ)
    (Γ : Subgroup (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ)
    (hΓ : ∀ h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ, h ∈ Γ ↔
      ∃ γ : W ⟶ W, γ ≫ w = w ∧ wcVQFrame D ℓ hP W r θ γ (h : Matrix (Fin r) (Fin r) ℚ_[ℓ])) :
    ∀ C : Set (Matrix (Fin r) (Fin r) ℚ_[ℓ]), IsClosed C → (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) ∈ C →
      (∀ a ∈ C, ∀ b ∈ C, a * b ∈ C) →
      (∀ (i : Fin D.m) (σ : W ⟶ W) (g : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
        wcHonestIsInertia D hP W w i σ → wcVQFrame D ℓ hP W r θ σ g → g ∈ C) →
      ∀ h ∈ Γ, (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]) ∈ C :=
by
  classical
  intro C hC h1 hmul hCI
  obtain ⟨P, hPdef⟩ : ∃ P : Set (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ,
      P = {g : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ | ∃ (i : Fin D.m)
      (σ : W ⟶ W), wcHonestIsInertia D hP W w i σ ∧
        wcVQFrame D ℓ hP W r θ σ (g : Matrix (Fin r) (Fin r) ℚ_[ℓ])} := ⟨_, rfl⟩
  have hint9 := hB.2.2.2.2.2.2.2.2.1
  have hint : ∀ h ∈ Γ, ∀ a b, ‖(h : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ 1 := by
    intro h hh a b
    obtain ⟨γ, hγ, hfr⟩ := (hΓ h).1 hh
    exact hint9 γ _ hγ hfr a b
  have hPΓ : P ⊆ Γ := by
    intro g hg
    rw [hPdef] at hg
    obtain ⟨i, σ, hi, hfr⟩ := hg
    exact (hΓ g).2 ⟨σ, hi.1, hfr⟩
  have hPconj : ∀ h ∈ Γ, ∀ p ∈ P, h * p * h⁻¹ ∈ P := by
    intro h hh p hp
    rw [hPdef] at hp ⊢
    obtain ⟨i, σ, hi, hfr⟩ := hp
    obtain ⟨σ', hi', hfr'⟩ :=
      wc_vqm_inertia_frame_conj F' F'' Y n hn hn2 D ℓ hℓ hP W w r θ φ hB Γ hΓ h hh p i σ hi hfr
    exact ⟨i, σ', hi', hfr'⟩
  have hQ : ∀ (Q : Type) [Group Q] [Finite Q] (χ : ↥Γ →* Q) (k : ℕ),
      (∀ h h' : ↥Γ, (∀ a b, ‖((h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
          Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b - ((h' : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
          Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ (ℓ : ℝ) ^ (-(k : ℤ))) → χ h = χ h') →
      (∀ p : ↥Γ, (p : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) ∈ P → χ p = 1) →
      ∀ h : ↥Γ, χ h = 1 := by
    intro Q _ _ χ k hχc hχP'
    obtain ⟨Ub, hUb, -⟩ := wc_P1bar_smooth_locus F'' hP D.m D.S D.hS
    obtain ⟨E, πE, hfin, het, hsurj, hsplit, htriv⟩ :=
      wc_vqm_quotient_torsor F' F'' Y n hn hn2 D ℓ hℓ hP W w r θ φ hB Γ hΓ Ub hUb Q χ k hχc
        (fun h i σ hi hfr => hχP' h (by rw [hPdef]; exact ⟨i, σ, hi, hfr⟩))
    obtain ⟨Eb, πEb, j, hfinb, hetb, hsurjb, hpb⟩ :=
      wc_hmg_fet_extend F'' hP D.m D.S D.hS Ub hUb E πE hfin het hsurj hsplit
    obtain ⟨σb, hσb⟩ := wc_P1bar_fet_section F'' hP Eb πEb hfinb hetb hsurjb
    refine htriv (hpb.lift (Ub.ι ≫ σb) (𝟙 _) ?_) (hpb.lift_snd _ _ _)
    rw [Category.assoc, hσb, Category.comp_id, Category.id_comp]
  exact wc_vqm_closed_monoid_of_quotients ℓ r Γ hint P hPΓ hPconj hQ C hC h1 hmul
    (fun p hp => by
      rw [hPdef] at hp
      obtain ⟨i, σ, hi, hfr⟩ := hp
      exact hCI i σ _ hi hfr)

theorem wc_vqm_coinv_of_hhom (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hhom : ∀ φ : (Subobject.underlying.obj (wcPencilE D ℓ hP)).over (wcGeomPoint F'' (wcP1Over F'') hP) ⟶
        (wcContSheaf (wcP1Over F'').left ℚ_[ℓ]).over (wcGeomPoint F'' (wcP1Over F'') hP), φ = 0)
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (r : ℕ)
    (θ : (wcPencilVQ D ℓ hP).over W ≅ (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W)
    (φ : W ⟶ W) (hB : wcVQGalFrame D ℓ hP W w r θ φ)
    (Γ : Subgroup (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ)
    (hΓ : ∀ h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ, h ∈ Γ ↔
      ∃ γ : W ⟶ W, γ ≫ w = w ∧ wcVQFrame D ℓ hP W r θ γ (h : Matrix (Fin r) (Fin r) ℚ_[ℓ])) :
    Submodule.span ℚ_[ℓ] {v : Fin r → ℚ_[ℓ] | ∃ h ∈ Γ, ∃ x : Fin r → ℚ_[ℓ],
      v = (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec x - x} = ⊤ :=
by
  classical
  obtain ⟨_, hqc, hconn, _, hsurj, hgal, _, _, _, _⟩ := hB
  obtain ⟨z₀⟩ := @ConnectedSpace.toNonempty _ _ hconn

  by_contra hne
  obtain ⟨f, hf0, hPf⟩ := Submodule.exists_le_ker_of_lt_top _ (lt_top_iff_ne_top.mpr hne)
  have hμ : ∀ h ∈ Γ, ∀ x : Fin r → ℚ_[ℓ],
      f ((h : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec x) = f x := by
    intro h hh x
    have hm := hPf (Submodule.subset_span ⟨h, hh, x, rfl⟩)
    rw [LinearMap.mem_ker, map_sub, sub_eq_zero] at hm
    exact hm
  obtain ⟨v₀, hv₀⟩ : ∃ v₀ : Fin r → ℚ_[ℓ], f v₀ ≠ 0 := by
    by_contra hcon
    push_neg at hcon
    exact hf0 (LinearMap.ext fun v => by rw [hcon v, LinearMap.zero_apply])

  have key : ∀ y, (θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom
      ((θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom y) = y := by
    intro y
    change ((θ.inv ≫ θ.hom).hom.app (Opposite.op (Over.mk (𝟙 W)))).hom y = y
    rw [θ.inv_hom_id]
    rfl
  have hsurjθ : ∀ v : Fin r → ℚ_[ℓ], ∃ x : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op W),
      ∀ z : W.left, (show C(↥W.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom x).down) z = v := by
    intro v
    refine ⟨(θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom
      (ULift.up (ContinuousMap.const ↥W.left v)), ?_⟩
    intro z
    erw [key]
    rfl
  choose A hA using fun γ : W ⟶ W =>
    wc_proet_deck_frame_linear (wcP1Over F'').left ℓ (wcPencilVQ D ℓ hP) W hconn r θ γ
  have hex : ∀ γ : W ⟶ W, wcVQFrame D ℓ hP W r θ γ (LinearMap.toMatrix' (A γ)) := by
    intro γ s z
    rw [LinearMap.toMatrix'_mulVec]
    exact hA γ W (𝟙 W) γ (Category.id_comp γ).symm s z
  have hval : ∀ (γ : W ⟶ W) (g : Matrix (Fin r) (Fin r) ℚ_[ℓ]), wcVQFrame D ℓ hP W r θ γ g →
      ∀ v, g.mulVec v = A γ v := by
    intro γ g hg v
    obtain ⟨x, hx⟩ := hsurjθ v
    have h1 := hg x z₀
    have h2 := hA γ W (𝟙 W) γ (Category.id_comp γ).symm x z₀
    rw [hx] at h1 h2
    exact h1.symm.trans h2
  have huniq : ∀ (γ : W ⟶ W) (g g' : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      wcVQFrame D ℓ hP W r θ γ g → wcVQFrame D ℓ hP W r θ γ g' → g = g' := by
    intro γ g g' hg hg'
    apply Matrix.toLin'.injective
    refine LinearMap.ext fun v => ?_
    rw [Matrix.toLin'_apply, Matrix.toLin'_apply, hval γ g hg v, hval γ g' hg' v]
  have hcomp : ∀ (a b : W ⟶ W) (g g' : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      wcVQFrame D ℓ hP W r θ a g → wcVQFrame D ℓ hP W r θ b g' →
      wcVQFrame D ℓ hP W r θ (a ≫ b) (g' * g) := by
    intro a b g g' hg hg' s z
    refine (hA b W a (a ≫ b) rfl s z).trans ?_
    rw [← hval b g' hg', hg s z, Matrix.mulVec_mulVec]
  have h1 : wcVQFrame D ℓ hP W r θ (𝟙 W) 1 := fun s z => (Matrix.one_mulVec _).symm
  have hinv : ∀ γ : W ⟶ W, γ ≫ w = w → ∀ (s : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op W))
      (z : W.left),
      f (wcContEval (wcP1Over F'').left W ((θ.hom.hom.app (Opposite.op (Over.mk γ))).hom s) z) =
      f (wcContEval (wcP1Over F'').left W
        ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s) z) := by
    intro γ hγ s z
    obtain ⟨γ', _, he⟩ := hgal W γ (𝟙 W) hconn (by rw [hγ, Category.id_comp])
    have hc := hcomp γ γ' _ _ (hex γ) (hex γ')
    rw [← he] at hc
    have h1' := huniq _ _ _ hc h1
    have h2' : LinearMap.toMatrix' (A γ) * LinearMap.toMatrix' (A γ') = 1 :=
      mul_eq_one_comm.mp h1'
    let u : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ :=
      ⟨LinearMap.toMatrix' (A γ), LinearMap.toMatrix' (A γ'), h2', h1'⟩
    have hu : u ∈ Γ := (hΓ u).2 ⟨γ, hγ, hex γ⟩
    have e : wcContEval (wcP1Over F'').left W ((θ.hom.hom.app (Opposite.op (Over.mk γ))).hom s) z =
        (u : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec (wcContEval (wcP1Over F'').left W
          ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s) z) := hex γ s z
    rw [e]
    exact hμ u hu _

  obtain ⟨Ψ₁, hΨ₁⟩ := wc_proet_invariant_functional_descent F'' hP D.m D.S D.hS ℓ
    (wcPencilVQ D ℓ hP) W w hqc hconn hsurj hgal r θ f hinv
  let ψ : (wcPencilVQ D ℓ hP).over (wcGeomPoint F'' (wcP1Over F'') hP) ⟶
      (wcContSheaf (wcP1Over F'').left ℚ_[ℓ]).over (wcGeomPoint F'' (wcP1Over F'') hP) :=
    Ψ₁ ≫ ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1}
      (wcGeomPoint F'' (wcP1Over F'') hP)).map
        (wcContSheafMap (wcP1Over F'').left (Pi.evalAddMonoidHom (fun _ : Fin 1 => ℚ_[ℓ]) 0)
          (continuous_apply 0))

  obtain ⟨π, hπ⟩ : ∃ π : Subobject.underlying.obj (wcPencilE D ℓ hP) ⟶ wcPencilVQ D ℓ hP,
      Epi π :=
    ⟨_, (inferInstance : Epi (Limits.cokernel.π (Subobject.ofLE
      (wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP) (wcPencilE D ℓ hP) inf_le_left)))⟩
  haveI := hπ
  have hχ : ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1}
      (wcGeomPoint F'' (wcP1Over F'') hP)).map π ≫ ψ = 0 := hhom _
  have hψ0 : ∀ (T : Over (wcGeomPoint F'' (wcP1Over F'') hP))
      (y : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op T.left)),
      (ψ.hom.app (Opposite.op T)).hom y = 0 := by
    intro T y
    have hR := wc_sheaf_epi_locallySurjective (Scheme.ProEt.topology (wcP1Over F'').left) π
      T.left y
    refine (wcContSheaf (wcP1Over F'').left ℚ_[ℓ]).isSeparated T.left _ hR
      ((ψ.hom.app (Opposite.op T)).hom y) 0 ?_
    intro V g hg
    obtain ⟨e, he⟩ := hg
    have he' : (π.hom.app (Opposite.op V)).hom e = ((wcPencilVQ D ℓ hP).obj.map g.op).hom y := he
    let T' : Over (wcGeomPoint F'' (wcP1Over F'') hP) := Over.mk (g ≫ T.hom)
    let c : T' ⟶ T := Over.homMk g
    have hnat : (ψ.hom.app (Opposite.op T')).hom (((wcPencilVQ D ℓ hP).obj.map g.op).hom y) =
        ((wcContSheaf (wcP1Over F'').left ℚ_[ℓ]).obj.map g.op).hom
          ((ψ.hom.app (Opposite.op T)).hom y) :=
      congrArg (fun m => m.hom y) (ψ.hom.naturality c.op)
    have h0 : ((((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1}
        (wcGeomPoint F'' (wcP1Over F'') hP)).map π ≫ ψ).hom.app (Opposite.op T')).hom e = 0 := by
      rw [hχ]
      rfl
    show ((wcContSheaf (wcP1Over F'').left ℚ_[ℓ]).obj.map g.op).hom
        ((ψ.hom.app (Opposite.op T)).hom y) =
      ((wcContSheaf (wcP1Over F'').left ℚ_[ℓ]).obj.map g.op).hom 0
    rw [map_zero, ← hnat, ← he']
    exact h0

  let y : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op W) :=
    (θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom (ULift.up (ContinuousMap.const ↥W.left v₀))
  have hy : (θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom y =
      ULift.up (ContinuousMap.const ↥W.left v₀) := key _
  have h2 : wcContEval (wcP1Over F'').left W
      ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom y) z₀ = v₀ :=
    congrArg (fun c : ULift.{u+1} C(↥W.left, Fin r → ℚ_[ℓ]) => c.down z₀) hy
  have hd := hΨ₁ W (𝟙 W) y z₀
  have h3 : wcContEval (wcP1Over F'').left W
      ((Ψ₁.hom.app (Opposite.op (Over.mk (𝟙 W ≫ w)))).hom y) z₀ 0 =
      wcContEval (wcP1Over F'').left W ((ψ.hom.app (Opposite.op (Over.mk (𝟙 W ≫ w)))).hom y) z₀ :=
    rfl
  have h5 := hψ0 (Over.mk (𝟙 W ≫ w)) y
  apply hv₀
  rw [← h2, ← hd, h3]
  first
    | (rw [h5]; rfl)
    | (erw [h5]; rfl)
    | (show wcContEval (wcP1Over F'').left W
          ((ψ.hom.app (Opposite.op (Over.mk (𝟙 W ≫ w)))).hom y) z₀ = 0
       exact (congrArg (fun c => wcContEval (wcP1Over F'').left W c z₀) h5).trans rfl)

theorem wc_vqm_vanishing_system_hz (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hNI : ∃ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β ∧
      β ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n))
    (hhom : ∀ φ : (Subobject.underlying.obj (wcPencilE D ℓ hP)).over (wcGeomPoint F'' (wcP1Over F'') hP) ⟶
        (wcContSheaf (wcP1Over F'').left ℚ_[ℓ]).over (wcGeomPoint F'' (wcP1Over F'') hP), φ = 0)
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (r : ℕ)
    (θ : (wcPencilVQ D ℓ hP).over W ≅ (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W)
    (φ : W ⟶ W) (hB : wcVQGalFrame D ℓ hP W w r θ φ)
    (Γ : Subgroup (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) (Φ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ)
    (hΦ : wcVQFrame D ℓ hP W r θ φ (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]))
    (hΓ : ∀ h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ, h ∈ Γ ↔
      ∃ γ : W ⟶ W, γ ≫ w = w ∧ wcVQFrame D ℓ hP W r θ γ (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]))
    (J : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (hJ : J.transpose = -J) (hJdet : IsUnit J.det)
    (hΓJ : ∀ h ∈ Γ, (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]).transpose * J *
      (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]) = J) :
    ∃ (m : ℕ) (v₀ : Fin m → Fin r → ℚ_[ℓ]) (ε : Fin m → ℚ_[ℓ])
      (T : Fin m → (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ),
      (∀ s, v₀ s ≠ 0 ∧ ε s ≠ 0 ∧ T s ∈ Γ ∧
        (T s : Matrix (Fin r) (Fin r) ℚ_[ℓ]) =
          1 + ε s • Matrix.vecMulVec (v₀ s) (Matrix.vecMul (v₀ s) J)) ∧
      (∀ s, ∃ h ∈ Γ, ((Φ * h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
        Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec (v₀ s) ∈ Submodule.span ℚ_[ℓ] {v₀ s}) ∧
      Submodule.span ℚ_[ℓ]
        {v | ∃ h ∈ Γ, ∃ s, v = (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec (v₀ s)} = ⊤ ∧
      (∀ Wsub : Submodule ℚ_[ℓ] (Fin r → ℚ_[ℓ]),
        (∀ h ∈ Γ, ∀ s, ∀ x ∈ Wsub, ((h * T s * h⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
          Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec x ∈ Wsub) →
        ∀ h ∈ Γ, ∀ x ∈ Wsub, (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec x ∈ Wsub) :=
by
  classical

  obtain ⟨I, hI⟩ : ∃ I : Set (Matrix (Fin r) (Fin r) ℚ_[ℓ]), I = {x | ∃ (i : Fin D.m) (σ : W ⟶ W),
      wcHonestIsInertia D hP W w i σ ∧ wcVQFrame D ℓ hP W r θ σ x} := ⟨_, rfl⟩
  choose σ g hσ hgfr hgr1 hconj using
    wc_vqm_inertia_PL_frames F' F'' Y n hn hn2 D ℓ hℓ hP W w r θ φ hB Γ hΓ
  have hgΓ : ∀ i, g i ∈ Γ := fun i => (hΓ (g i)).2 ⟨σ i, (hσ i).1, hgfr i⟩
  have hgI : ∀ i, (g i : Matrix (Fin r) (Fin r) ℚ_[ℓ]) ∈ I := fun i => by
    rw [hI]; exact ⟨i, σ i, hσ i, hgfr i⟩
  have hIconj : ∀ x ∈ I, ∃ i, ∃ c ∈ Γ, ∃ a : ℚ_[ℓ], x = (c : Matrix (Fin r) (Fin r) ℚ_[ℓ]) *
      (1 + a • ((g i : Matrix (Fin r) (Fin r) ℚ_[ℓ]) - 1)) *
      ((c⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) := by
    intro x hx
    rw [hI] at hx
    obtain ⟨i, σ', hi, hx⟩ := hx
    exact ⟨i, hconj i σ' x hi hx⟩
  have hIfrob : ∀ x ∈ I, ∃ h ∈ Γ, ∃ c : ℚ_[ℓ],
      ((Φ * h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) * x =
        (1 + c • (x - 1)) *
          ((Φ * h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) := by
    intro x hx
    rw [hI] at hx
    obtain ⟨i, σ', hi, hx⟩ := hx
    exact wc_vqm_inertia_frobenius F' F'' Y n hn hn2 D ℓ hℓ hP W w r θ φ hB Γ hΓ Φ hΦ i σ' x hi hx
  have htop : ∀ C : Set (Matrix (Fin r) (Fin r) ℚ_[ℓ]), IsClosed C →
      (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) ∈ C → (∀ a ∈ C, ∀ b ∈ C, a * b ∈ C) → I ⊆ C →
      ∀ h ∈ Γ, (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]) ∈ C := by
    intro C hC h1 hmul hIC
    exact wc_vqm_inertia_generation F' F'' Y n hn hn2 D ℓ hℓ hP W w r θ φ hB Γ hΓ C hC h1 hmul
      (fun i σ' x hi hx => hIC (by rw [hI]; exact ⟨i, σ', hi, hx⟩))
  have hcoinv := wc_vqm_coinv_of_hhom F' F'' Y n hn hn2 D ℓ hℓ hP hhom W w r θ φ hB Γ hΓ

  have hNv : ∀ (d b y : Fin r → ℚ_[ℓ]), (Matrix.vecMulVec d b).mulVec y = (b ⬝ᵥ y) • d := by
    intro d b y
    rw [Matrix.vecMulVec_mulVec, op_smul_eq_smul]
  have hJinj : Function.Injective fun v : Fin r → ℚ_[ℓ] => Matrix.vecMul v J :=
    Matrix.vecMul_injective_iff_isUnit.mpr ((Matrix.isUnit_iff_isUnit_det J).mpr hJdet)

  have hNF : ∀ i, (g i : Matrix (Fin r) (Fin r) ℚ_[ℓ]) ≠ 1 → ∃ (d : Fin r → ℚ_[ℓ]) (e : ℚ_[ℓ]),
      d ≠ 0 ∧ e ≠ 0 ∧ (g i : Matrix (Fin r) (Fin r) ℚ_[ℓ]) =
        1 + e • Matrix.vecMulVec d (Matrix.vecMul d J) := by
    intro i hne
    obtain ⟨d, lam, hdl⟩ := hgr1 i
    have hd : d ≠ 0 := by
      rintro rfl
      apply hne
      rw [hdl]
      ext a c
      simp
    have hlam : lam ≠ 0 := by
      rintro rfl
      apply hne
      rw [hdl]
      ext a c
      simp
    have hJd : J.mulVec d = -Matrix.vecMul d J := by
      rw [← Matrix.vecMul_transpose, hJ, Matrix.vecMul_neg]
    have hbd : Matrix.vecMul d J ⬝ᵥ d = 0 := by
      have h1 : Matrix.vecMul d J ⬝ᵥ d = -(Matrix.vecMul d J ⬝ᵥ d) := by
        calc Matrix.vecMul d J ⬝ᵥ d = d ⬝ᵥ J.mulVec d := by rw [Matrix.dotProduct_mulVec]
          _ = -(Matrix.vecMul d J ⬝ᵥ d) := by rw [hJd, dotProduct_neg, dotProduct_comm]
      have h2 : (2 : ℚ_[ℓ]) * (Matrix.vecMul d J ⬝ᵥ d) = 0 := by linear_combination h1
      exact (mul_eq_zero.mp h2).resolve_left two_ne_zero
    have hsym := hΓJ (g i) (hgΓ i)
    rw [hdl, Matrix.transpose_add, Matrix.transpose_one, Matrix.transpose_vecMulVec] at hsym
    have hz : d ⬝ᵥ -Matrix.vecMul d J = 0 := by
      rw [dotProduct_neg, dotProduct_comm, hbd, neg_zero]
    have hexp : (1 + Matrix.vecMulVec lam d) * J * (1 + Matrix.vecMulVec d lam) =
        J + Matrix.vecMulVec lam (Matrix.vecMul d J) + Matrix.vecMulVec (-Matrix.vecMul d J) lam +
          Matrix.vecMulVec lam ((d ⬝ᵥ -Matrix.vecMul d J) • lam) := by
      have e0 : (1 + Matrix.vecMulVec lam d) * J * (1 + Matrix.vecMulVec d lam) =
          J + Matrix.vecMulVec lam d * J + J * Matrix.vecMulVec d lam +
            Matrix.vecMulVec lam d * (J * Matrix.vecMulVec d lam) := by
        simp only [Matrix.add_mul, Matrix.mul_add, Matrix.one_mul, Matrix.mul_one, Matrix.mul_assoc]
        abel
      rw [e0, Matrix.mul_vecMulVec J d lam, hJd, Matrix.vecMulVec_mul, Matrix.vecMulVec_mul,
        Matrix.vecMul_vecMulVec]
    have hent : ∀ a c, lam a * Matrix.vecMul d J c = Matrix.vecMul d J a * lam c := by
      intro a c
      have := congrFun (congrFun (hexp.symm.trans hsym) a) c
      rw [hz, zero_smul] at this
      simp only [Matrix.add_apply, Matrix.vecMulVec_apply, Pi.neg_apply, Pi.zero_apply,
        mul_zero, add_zero] at this
      linear_combination this
    have hb0 : Matrix.vecMul d J ≠ 0 := fun h => hd (hJinj (by
      show Matrix.vecMul d J = Matrix.vecMul 0 J
      rw [h, Matrix.zero_vecMul]))
    obtain ⟨j, hj⟩ := Function.ne_iff.mp hb0
    have hj' : Matrix.vecMul d J j ≠ 0 := hj
    have hlamj : lam j ≠ 0 := by
      intro h0
      apply hlam
      funext a
      have := hent a j
      rw [h0, mul_zero] at this
      exact (mul_eq_zero.mp this).resolve_right hj'
    have hlam_eq : lam = (lam j / Matrix.vecMul d J j) • Matrix.vecMul d J := by
      funext a
      rw [Pi.smul_apply, smul_eq_mul, div_mul_eq_mul_div, eq_div_iff hj']
      linear_combination hent a j
    refine ⟨d, lam j / Matrix.vecMul d J j, hd, div_ne_zero hlamj hj', ?_⟩
    rw [hdl]
    congr 1
    rw [← Matrix.vecMulVec_smul, ← hlam_eq]
  choose! dd ee hdd hee hge using hNF
  have hgz : ∀ i, (g i : Matrix (Fin r) (Fin r) ℚ_[ℓ]) ≠ 1 → ∀ z : Fin r → ℚ_[ℓ],
      (g i : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec z =
        z + (ee i * (Matrix.vecMul (dd i) J ⬝ᵥ z)) • dd i := by
    intro i hi z
    rw [hge i hi, Matrix.add_mulVec, Matrix.one_mulVec, Matrix.smul_mulVec, hNv, smul_smul]
  have hbne : ∀ i, (g i : Matrix (Fin r) (Fin r) ℚ_[ℓ]) ≠ 1 → Matrix.vecMul (dd i) J ≠ 0 :=
    fun i hi h => hdd i hi (hJinj (by
      show Matrix.vecMul (dd i) J = Matrix.vecMul 0 J
      rw [h, Matrix.zero_vecMul]))
  have hconjv : ∀ (c : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) (G : Matrix (Fin r) (Fin r) ℚ_[ℓ])
      (a : ℚ_[ℓ]) (z : Fin r → ℚ_[ℓ]),
      ((c : Matrix (Fin r) (Fin r) ℚ_[ℓ]) * (1 + a • (G - 1)) *
        ((c⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ])).mulVec z =
      z + a • (((c : Matrix (Fin r) (Fin r) ℚ_[ℓ]) * G *
        ((c⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ])).mulVec z - z) := by
    intro c G a z
    have hm : (c : Matrix (Fin r) (Fin r) ℚ_[ℓ]) * (1 + a • (G - 1)) *
        ((c⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) =
        1 + a • ((c : Matrix (Fin r) (Fin r) ℚ_[ℓ]) * G *
          ((c⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) - 1) := by
      simp only [mul_add, mul_one, mul_smul_comm, add_mul, Units.mul_inv, smul_mul_assoc,
        mul_sub, sub_mul]
    rw [hm, Matrix.add_mulVec, Matrix.one_mulVec, Matrix.smul_mulVec, Matrix.sub_mulVec,
      Matrix.one_mulVec]
  have hcG : ∀ (c : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) (G : Matrix (Fin r) (Fin r) ℚ_[ℓ])
      (z : Fin r → ℚ_[ℓ]),
      ((c : Matrix (Fin r) (Fin r) ℚ_[ℓ]) * G *
        ((c⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ])).mulVec z - z =
      (c : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec (G.mulVec
        (((c⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec z) -
        ((c⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec z) := by
    intro c G z
    simp only [Matrix.mulVec_sub, Matrix.mulVec_mulVec, Matrix.mul_assoc, Units.mul_inv,
      Matrix.one_mulVec]

  let P := {i : Fin D.m // (g i : Matrix (Fin r) (Fin r) ℚ_[ℓ]) ≠ 1}
  let eP : Fin (Fintype.card P) ≃ P := (Fintype.equivFin P).symm
  obtain ⟨v₀, hv₀⟩ : ∃ v₀ : Fin (Fintype.card P) → Fin r → ℚ_[ℓ], ∀ s, v₀ s = dd (eP s).1 :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨ε, hε⟩ : ∃ ε : Fin (Fintype.card P) → ℚ_[ℓ], ∀ s, ε s = ee (eP s).1 :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨T, hT⟩ : ∃ T : Fin (Fintype.card P) → (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ,
      ∀ s, T s = g (eP s).1 := ⟨_, fun _ => rfl⟩
  have hTs : ∀ i (hi : (g i : Matrix (Fin r) (Fin r) ℚ_[ℓ]) ≠ 1),
      T (eP.symm ⟨i, hi⟩) = g i ∧ v₀ (eP.symm ⟨i, hi⟩) = dd i := by
    intro i hi
    rw [hT, hv₀, Equiv.apply_symm_apply]
    exact ⟨rfl, rfl⟩
  have hspan_of : ∀ (A B : ℚ_[ℓ]) (u d : Fin r → ℚ_[ℓ]), A ≠ 0 → A • u = B • d →
      u ∈ Submodule.span ℚ_[ℓ] {d} := by
    intro A B u d hA h
    rw [Submodule.mem_span_singleton]
    refine ⟨A⁻¹ * B, ?_⟩
    rw [mul_smul, ← h, smul_smul, inv_mul_cancel₀ hA, one_smul]
  refine ⟨Fintype.card P, v₀, ε, T, ?_, ?_, ?_, ?_⟩
  ·
    intro s
    rw [hv₀, hε, hT]
    exact ⟨hdd _ (eP s).2, hee _ (eP s).2, hgΓ _, hge _ (eP s).2⟩
  ·
    intro s
    rw [hv₀]
    obtain ⟨h, hh, c, hc⟩ := hIfrob _ (hgI (eP s).1)
    refine ⟨h, hh, ?_⟩
    have hi := (eP s).2
    obtain ⟨j, hj⟩ := Function.ne_iff.mp (hbne _ hi)
    have hj' : Matrix.vecMul (dd (eP s).1) J j ≠ 0 := hj
    have e1 := congrArg (fun A => A.mulVec (Pi.single j (1 : ℚ_[ℓ]))) hc
    rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec] at e1
    simp only [Matrix.add_mulVec, Matrix.one_mulVec, Matrix.smul_mulVec, Matrix.sub_mulVec,
      hgz _ hi, add_sub_cancel_left, Matrix.mulVec_add, Matrix.mulVec_smul] at e1
    have e2 := add_left_cancel e1
    rw [smul_smul] at e2
    refine hspan_of _ _ _ _ ?_ e2
    refine mul_ne_zero (hee _ hi) ?_
    rw [dotProduct_single, mul_one]
    exact hj'
  ·
    obtain ⟨S, hS⟩ : ∃ S : Submodule ℚ_[ℓ] (Fin r → ℚ_[ℓ]), S = Submodule.span ℚ_[ℓ]
        {v | ∃ h ∈ Γ, ∃ s, v = (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec (v₀ s)} := ⟨_, rfl⟩
    rw [← hS]
    have hSc : IsClosed (S : Set (Fin r → ℚ_[ℓ])) := Submodule.closed_of_finiteDimensional S
    obtain ⟨C, hC⟩ : ∃ C : Set (Matrix (Fin r) (Fin r) ℚ_[ℓ]),
        C = (⋂ z : Fin r → ℚ_[ℓ], {A | A.mulVec z - z ∈ S}) ∩
          ⋂ y ∈ (S : Set (Fin r → ℚ_[ℓ])), {A | A.mulVec y ∈ S} := ⟨_, rfl⟩
    have hmemC : ∀ A, A ∈ C ↔ (∀ z, A.mulVec z - z ∈ S) ∧ ∀ y ∈ S, A.mulVec y ∈ S := by
      intro A
      rw [hC]
      simp only [Set.mem_inter_iff, Set.mem_iInter, Set.mem_setOf_eq, SetLike.mem_coe]
    have hCc : IsClosed C := by
      rw [hC]
      refine IsClosed.inter (isClosed_iInter fun z => ?_) (isClosed_biInter fun y _ => ?_)
      · exact hSc.preimage ((Continuous.matrix_mulVec continuous_id continuous_const).sub
          continuous_const)
      · exact hSc.preimage (Continuous.matrix_mulVec continuous_id continuous_const)
    have h1C : (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) ∈ C := by
      rw [hmemC]
      refine ⟨fun z => ?_, fun y hy => ?_⟩
      · rw [Matrix.one_mulVec, sub_self]; exact S.zero_mem
      · rw [Matrix.one_mulVec]; exact hy
    have hmulC : ∀ a ∈ C, ∀ b ∈ C, a * b ∈ C := by
      intro a ha b hb
      rw [hmemC] at ha hb ⊢
      refine ⟨fun z => ?_, fun y hy => ?_⟩
      · have e : (a * b).mulVec z - z = a.mulVec (b.mulVec z - z) + (a.mulVec z - z) := by
          rw [← Matrix.mulVec_mulVec, Matrix.mulVec_sub]
          abel
        rw [e]
        exact S.add_mem (ha.2 _ (hb.1 z)) (ha.1 z)
      · rw [← Matrix.mulVec_mulVec]
        exact ha.2 _ (hb.2 y hy)
    have hIC : I ⊆ C := by
      intro X hX
      obtain ⟨i, c, hc, a, rfl⟩ := hIconj X hX
      have hdisp : ∀ z, ((c : Matrix (Fin r) (Fin r) ℚ_[ℓ]) *
          (1 + a • ((g i : Matrix (Fin r) (Fin r) ℚ_[ℓ]) - 1)) *
          ((c⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ])).mulVec z - z
            ∈ S := by
        intro z
        rw [hconjv, add_sub_cancel_left]
        refine S.smul_mem _ ?_
        rw [hcG]
        by_cases hi : (g i : Matrix (Fin r) (Fin r) ℚ_[ℓ]) = 1
        · rw [hi, Matrix.one_mulVec, sub_self, Matrix.mulVec_zero]
          exact S.zero_mem
        · rw [hgz i hi, add_sub_cancel_left, Matrix.mulVec_smul]
          refine S.smul_mem _ ?_
          rw [hS]
          refine Submodule.subset_span ⟨c, hc, eP.symm ⟨i, hi⟩, ?_⟩
          rw [(hTs i hi).2]
      rw [hmemC]
      refine ⟨hdisp, fun y hy => ?_⟩
      have := S.add_mem hy (hdisp y)
      rwa [add_sub_cancel] at this
    rw [eq_top_iff, ← hcoinv, Submodule.span_le]
    rintro v ⟨h, hh, z, rfl⟩
    exact ((hmemC _).1 (htop C hCc h1C hmulC hIC h hh)).1 z
  ·
    intro Wsub hWsub h hh x hx
    have hWc : IsClosed (Wsub : Set (Fin r → ℚ_[ℓ])) :=
      Submodule.closed_of_finiteDimensional Wsub
    obtain ⟨C, hC⟩ : ∃ C : Set (Matrix (Fin r) (Fin r) ℚ_[ℓ]),
        C = ⋂ y ∈ (Wsub : Set (Fin r → ℚ_[ℓ])), {A | A.mulVec y ∈ Wsub} := ⟨_, rfl⟩
    have hmemC : ∀ A, A ∈ C ↔ ∀ y ∈ Wsub, A.mulVec y ∈ Wsub := by
      intro A
      rw [hC]
      simp only [Set.mem_iInter, Set.mem_setOf_eq, SetLike.mem_coe]
    have hCc : IsClosed C := by
      rw [hC]
      exact isClosed_biInter fun y _ =>
        hWc.preimage (Continuous.matrix_mulVec continuous_id continuous_const)
    have h1C : (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) ∈ C := by
      rw [hmemC]
      intro y hy
      rw [Matrix.one_mulVec]; exact hy
    have hmulC : ∀ a ∈ C, ∀ b ∈ C, a * b ∈ C := by
      intro a ha b hb
      rw [hmemC] at ha hb ⊢
      intro y hy
      rw [← Matrix.mulVec_mulVec]
      exact ha _ (hb y hy)
    have hIC : I ⊆ C := by
      intro X hX
      obtain ⟨i, c, hc, a, rfl⟩ := hIconj X hX
      rw [hmemC]
      intro y hy
      rw [hconjv]
      by_cases hi : (g i : Matrix (Fin r) (Fin r) ℚ_[ℓ]) = 1
      · rw [hi, Matrix.mul_one, Units.mul_inv, Matrix.one_mulVec, sub_self, smul_zero, add_zero]
        exact hy
      · have hs := hWsub c hc (eP.symm ⟨i, hi⟩) y hy
        rw [Units.val_mul, Units.val_mul, (hTs i hi).1] at hs
        exact Wsub.add_mem hy (Wsub.smul_mem _ (Wsub.sub_mem hs hy))
    exact (hmemC _).1 (htop C hCc h1C hmulC hIC h hh) x hx

theorem wc_vqmc_stalk_dictionary (F' F'' : Type u) [Field F'] [Field F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (W : (wcP1Over F'').left.ProEt) (r : ℕ)
    (θ : (wcPencilVQ D ℓ hP).over W ≅ (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W)
    (hθc : ∀ c : ℚ_[ℓ],
      ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} W).map
          (wcPencilVQScalar D ℓ hP c) ≫ θ.hom =
        θ.hom ≫ ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} W).map
          (wcConstScalar (wcP1Over F'').left ℓ r c))
    (x : (wcP1Over F'').left) (d : ℕ) (Nx : wcFrobNbhd F'' x d) (ι : Nx.V ⟶ W) (σ : W ⟶ W)
    (g : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ)
    (hσ : Nx.φ ≫ ι = ι ≫ σ)
    (hg : ∀ (V : (wcP1Over F'').left.ProEt) (f : V ⟶ W)
      (s : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op V)) (z : V.left),
      (show C(↥V.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk (f ≫ σ)))).hom s).down) z =
      (g : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec ((show C(↥V.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk f))).hom s).down) z))
    (rr : ℕ)
    (e : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left Nx.V) (wcPencilVQ D ℓ hP) 0 ≃+
      (Fin rr → ℚ_[ℓ]))
    (he : ∀ (c : ℚ_[ℓ])
      (y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left Nx.V) (wcPencilVQ D ℓ hP) 0),
      e ((Abelian.Ext.mk₀ (wcPencilVQScalar D ℓ hP c)).postcomp
        (wcFreeSheaf (wcP1Over F'').left Nx.V) (add_zero 0) y) = c • e y) :
    (wcAddEquivMatrix e ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left
      Nx.φ)).precomp (wcPencilVQ D ℓ hP) (zero_add 0))).charpoly.aroots
        (AlgebraicClosure ℚ_[ℓ]) =
      ((g⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
        Matrix (Fin r) (Fin r) ℚ_[ℓ]).charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) :=
by
  classical
  letI := Nx.ringA
  haveI := Nx.hensA

  let v₀ : Nx.V.left := Nx.e.inv (IsLocalRing.closedPoint Nx.A)
  have hconst : ∀ (f : C(Nx.V.left, Fin r → ℚ_[ℓ])) (z : Nx.V.left), f z = f v₀ := by
    intro f z
    have h1 : Nx.e.hom z ⤳ (IsLocalRing.closedPoint Nx.A : Spec (.of Nx.A)) :=
      IsLocalRing.specializes_closedPoint (R := Nx.A) (Nx.e.hom z)
    have h2 : Nx.e.inv (Nx.e.hom z) ⤳ v₀ := h1.map (Scheme.Hom.continuous Nx.e.inv)
    rw [Scheme.hom_inv_apply] at h2
    exact (h2.map f.continuous).eq

  let X₀ : Over W := Over.mk ι
  let X₁ : Over W := Over.mk (Nx.φ ≫ ι)
  let hX : X₁ ⟶ X₀ := Over.homMk Nx.φ rfl
  let τ₀ : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op Nx.V) → C(Nx.V.left, Fin r → ℚ_[ℓ]) :=
    fun s => (show ULift.{u+1} C(Nx.V.left, Fin r → ℚ_[ℓ]) from
      (θ.hom.hom.app (Opposite.op X₀)).hom s).down
  let τ₁ : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op Nx.V) → C(Nx.V.left, Fin r → ℚ_[ℓ]) :=
    fun s => (show ULift.{u+1} C(Nx.V.left, Fin r → ℚ_[ℓ]) from
      (θ.hom.hom.app (Opposite.op X₁)).hom s).down
  let τe : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op Nx.V) ≃+
      ULift.{u+1} C(Nx.V.left, Fin r → ℚ_[ℓ]) :=
    (((sheafToPresheaf _ _).mapIso θ).app (Opposite.op X₀)).addCommGroupIsoToAddEquiv
  let ev : ULift.{u+1} C(Nx.V.left, Fin r → ℚ_[ℓ]) ≃+ (Fin r → ℚ_[ℓ]) :=
    { toFun := fun F => F.down v₀
      invFun := fun m => ULift.up (ContinuousMap.const _ m)
      left_inv := fun F => ULift.ext _ _ (ContinuousMap.ext fun x => (hconst F.down x).symm)
      right_inv := fun m => rfl
      map_add' := fun F F' => rfl }
  let β : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op Nx.V) ≃+ (Fin r → ℚ_[ℓ]) := τe.trans ev
  have hβ : ∀ s, β s = τ₀ s v₀ := fun _ => rfl

  have hscal : ∀ (c : ℚ_[ℓ]) (s : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op Nx.V)),
      β (((wcPencilVQScalar D ℓ hP c).hom.app (Opposite.op Nx.V)).hom s) = c • β s := by
    intro c s
    have h1 := NatTrans.congr_app (congrArg (fun f => f.hom) (hθc c)) (Opposite.op X₀)
    have h2 := congrArg ULift.down (ConcreteCategory.congr_hom h1 s)
    have h3 := congrArg (fun f : C(Nx.V.left, Fin r → ℚ_[ℓ]) => f v₀) h2
    exact h3

  have key : ∀ s : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op Nx.V),
      τ₁ (((wcPencilVQ D ℓ hP).obj.map Nx.φ.op).hom s) = (τ₀ s).comp Nx.φ.left.base.hom := by
    intro s
    exact congrArg ULift.down
      (congrArg (fun f => AddCommGrpCat.Hom.hom f s) (θ.hom.hom.naturality hX.op))

  have hk : ∀ k : Nx.V ⟶ W, k = ι ≫ σ →
      ∀ (s : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op Nx.V)) (z : Nx.V.left),
      (show C(↥Nx.V.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk k))).hom s).down) z =
      (g : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec (τ₀ s z) := by
    rintro k rfl s z
    exact hg Nx.V ι s z

  have hstar : ∀ s : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op Nx.V),
      (g : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec
        (β (((wcPencilVQ D ℓ hP).obj.map Nx.φ.op).hom s)) = β s := by
    intro s
    have e1 := hk (Nx.φ ≫ ι) hσ (((wcPencilVQ D ℓ hP).obj.map Nx.φ.op).hom s) v₀
    have e2 := congrArg (fun f : C(Nx.V.left, Fin r → ℚ_[ℓ]) => f v₀) (key s)
    rw [hβ, hβ]
    calc (g : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec
          (τ₀ (((wcPencilVQ D ℓ hP).obj.map Nx.φ.op).hom s) v₀)
        = τ₁ (((wcPencilVQ D ℓ hP).obj.map Nx.φ.op).hom s) v₀ := e1.symm
      _ = τ₀ s (Nx.φ.left.base.hom v₀) := e2
      _ = τ₀ s v₀ := hconst _ _

  have hfrob : ∀ s : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op Nx.V),
      β (((wcPencilVQ D ℓ hP).obj.map Nx.φ.op).hom s) =
        ((g⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec (β s) := by
    intro s
    rw [← hstar s, Matrix.mulVec_mulVec, Units.inv_mul, Matrix.one_mulVec]

  let J := Scheme.ProEt.topology (wcP1Over F'').left
  let P := yoneda.obj Nx.V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
  let η : (wcFreeSheaf (wcP1Over F'').left Nx.V).obj.obj (Opposite.op Nx.V) :=
    ((toSheafify J P).app (Opposite.op Nx.V)).hom (FreeAbelianGroup.of (ULift.up (𝟙 Nx.V)))
  let eqv : (wcFreeSheaf (wcP1Over F'').left Nx.V ⟶ wcPencilVQ D ℓ hP) ≃
      (wcPencilVQ D ℓ hP).obj.obj (Opposite.op Nx.V) :=
    ((sheafificationAdjunction J AddCommGrpCat.{u+1}).homEquiv P (wcPencilVQ D ℓ hP)).trans
      (((Adjunction.whiskerRight ((wcP1Over F'').left.ProEt)ᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
          (yoneda.obj Nx.V ⋙ uliftFunctor.{u+1, u}) (wcPencilVQ D ℓ hP).obj).trans
        (uliftYonedaEquiv.{u+1} (X := Nx.V)
          (F := (wcPencilVQ D ℓ hP).obj ⋙ forget AddCommGrpCat.{u+1})))
  have heqv : ∀ h : wcFreeSheaf (wcP1Over F'').left Nx.V ⟶ wcPencilVQ D ℓ hP,
      eqv h = (h.hom.app (Opposite.op Nx.V)).hom η :=
    fun _ => rfl
  have hadd : ∀ h h' : wcFreeSheaf (wcP1Over F'').left Nx.V ⟶ wcPencilVQ D ℓ hP,
      eqv (h + h') = eqv h + eqv h' := by
    intro h h'
    rw [heqv, heqv, heqv]
    first
      | rfl
      | simp [Sheaf.Hom.add_app]
      | simp
  let eqvA : (wcFreeSheaf (wcP1Over F'').left Nx.V ⟶ wcPencilVQ D ℓ hP) ≃+
      (wcPencilVQ D ℓ hP).obj.obj (Opposite.op Nx.V) := AddEquiv.mk' eqv hadd
  have hnat : ((wcFreeSheafMap (wcP1Over F'').left Nx.φ).hom.app (Opposite.op Nx.V)).hom η =
      ((wcFreeSheaf (wcP1Over F'').left Nx.V).obj.map Nx.φ.op).hom η := by
    let w : P ⟶ P :=
      Functor.whiskerRight (yoneda.map Nx.φ) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
    let x : P.obj (Opposite.op Nx.V) := FreeAbelianGroup.of (ULift.up (𝟙 Nx.V))
    have h1 : ((sheafifyMap J w).app (Opposite.op Nx.V)).hom (((toSheafify J P).app
        (Opposite.op Nx.V)).hom x) = ((toSheafify J P).app (Opposite.op Nx.V)).hom
          ((w.app (Opposite.op Nx.V)).hom x) :=
      (ConcreteCategory.congr_hom
        (congrArg (fun ψ => ψ.app (Opposite.op Nx.V)) (toSheafify_naturality J w)) x).symm
    have h2 : (w.app (Opposite.op Nx.V)).hom x = (P.map Nx.φ.op).hom x := by
      change FreeAbelianGroup.map _ (FreeAbelianGroup.of _) =
        FreeAbelianGroup.map _ (FreeAbelianGroup.of _)
      refine (FreeAbelianGroup.map_of_apply _).trans
        (Eq.trans ?_ (FreeAbelianGroup.map_of_apply _).symm)
      congr 1
    have hn : ((toSheafify J P).app (Opposite.op Nx.V)).hom ((P.map Nx.φ.op).hom x) =
        ((sheafify J P).map Nx.φ.op).hom (((toSheafify J P).app (Opposite.op Nx.V)).hom x) :=
      NatTrans.naturality_apply (toSheafify J P) Nx.φ.op x
    change ((sheafifyMap J w).app (Opposite.op Nx.V)).hom (((toSheafify J P).app
        (Opposite.op Nx.V)).hom x) =
      ((sheafify J P).map Nx.φ.op).hom (((toSheafify J P).app (Opposite.op Nx.V)).hom x)
    rw [h1, h2, hn]
  have hnatG : ∀ h : wcFreeSheaf (wcP1Over F'').left Nx.V ⟶ wcPencilVQ D ℓ hP,
      eqv (wcFreeSheafMap (wcP1Over F'').left Nx.φ ≫ h) =
        ((wcPencilVQ D ℓ hP).obj.map Nx.φ.op).hom (eqv h) := by
    intro h
    rw [heqv, heqv]
    change (h.hom.app (Opposite.op Nx.V)).hom
      (((wcFreeSheafMap (wcP1Over F'').left Nx.φ).hom.app (Opposite.op Nx.V)).hom η) = _
    rw [hnat]
    exact NatTrans.naturality_apply h.hom Nx.φ.op η
  have hpostG : ∀ (ψ : wcPencilVQ D ℓ hP ⟶ wcPencilVQ D ℓ hP)
      (h : wcFreeSheaf (wcP1Over F'').left Nx.V ⟶ wcPencilVQ D ℓ hP),
      eqv (h ≫ ψ) = (ψ.hom.app (Opposite.op Nx.V)).hom (eqv h) := by
    intro ψ h
    rw [heqv, heqv]
    rfl
  let E0 : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left Nx.V) (wcPencilVQ D ℓ hP) 0 ≃+
      (wcFreeSheaf (wcP1Over F'').left Nx.V ⟶ wcPencilVQ D ℓ hP) := Abelian.Ext.addEquiv₀
  have hE0 : ∀ h : wcFreeSheaf (wcP1Over F'').left Nx.V ⟶ wcPencilVQ D ℓ hP,
      E0 (Abelian.Ext.mk₀ h) = h := by
    intro h
    apply (Abelian.Ext.mk₀_bijective _ _).1
    exact Abelian.Ext.mk₀_addEquiv₀_apply _
  let b : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left Nx.V) (wcPencilVQ D ℓ hP) 0 ≃+
      (Fin r → ℚ_[ℓ]) := E0.trans (eqvA.trans β)
  have hb : ∀ h : wcFreeSheaf (wcP1Over F'').left Nx.V ⟶ wcPencilVQ D ℓ hP,
      b (Abelian.Ext.mk₀ h) = β (eqv h) := by
    intro h
    show β (eqvA (E0 (Abelian.Ext.mk₀ h))) = β (eqv h)
    rw [hE0]
    rfl
  have hbs : ∀ (c : ℚ_[ℓ])
      (y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left Nx.V) (wcPencilVQ D ℓ hP) 0),
      b ((Abelian.Ext.mk₀ (wcPencilVQScalar D ℓ hP c)).postcomp
        (wcFreeSheaf (wcP1Over F'').left Nx.V) (add_zero 0) y) = c • b y := by
    intro c y
    obtain ⟨h, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 y
    have hp : (Abelian.Ext.mk₀ (wcPencilVQScalar D ℓ hP c)).postcomp
        (wcFreeSheaf (wcP1Over F'').left Nx.V) (add_zero 0)
        (Abelian.Ext.mk₀ h) = Abelian.Ext.mk₀ (h ≫ wcPencilVQScalar D ℓ hP c) :=
      Abelian.Ext.mk₀_comp_mk₀ _ _
    rw [hp, hb, hb, hpostG]
    exact hscal c (eqv h)
  have hbΦ : ∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left Nx.V) (wcPencilVQ D ℓ hP) 0,
      b ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left Nx.φ)).precomp
        (wcPencilVQ D ℓ hP) (zero_add 0) y) =
        ((g⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec (b y) := by
    intro y
    obtain ⟨h, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 y
    have hp : (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left Nx.φ)).precomp
        (wcPencilVQ D ℓ hP) (zero_add 0) (Abelian.Ext.mk₀ h) =
          Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left Nx.φ ≫ h) :=
      Abelian.Ext.mk₀_comp_mk₀ _ _
    rw [hp, hb, hb, hnatG]
    exact hfrob (eqv h)

  have hbsymm : ∀ (c : ℚ_[ℓ]) (v : Fin r → ℚ_[ℓ]),
      b.symm (c • v) = (Abelian.Ext.mk₀ (wcPencilVQScalar D ℓ hP c)).postcomp
        (wcFreeSheaf (wcP1Over F'').left Nx.V) (add_zero 0) (b.symm v) := fun c v =>
    b.injective (by rw [hbs, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
  let L : (Fin r → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin rr → ℚ_[ℓ]) :=
    (b.symm.trans e).toLinearEquiv (fun c v => by
      show e (b.symm (c • v)) = c • e (b.symm v)
      rw [hbsymm, he])
  have hLb : ∀ y, L (b y) = e y := fun y => by
    show e (b.symm (b y)) = e y
    rw [AddEquiv.symm_apply_apply]
  have hLs : ∀ w, L.symm w = b (e.symm w) := fun w => by
    rw [LinearEquiv.symm_apply_eq, hLb, AddEquiv.apply_symm_apply]
  let Ψ : Module.End ℚ_[ℓ] (Fin rr → ℚ_[ℓ]) :=
    L.conj (Matrix.toLin'
      ((g⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]))
  have hΨw : ∀ w, Ψ w = e ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left
      Nx.φ)).precomp (wcPencilVQ D ℓ hP) (zero_add 0) (e.symm w)) := by
    intro w
    simp only [Ψ, LinearEquiv.conj_apply, LinearMap.comp_apply, LinearEquiv.coe_coe,
      Matrix.toLin'_apply, hLs]
    rw [← hbΦ, hLb]
  have hΨ : wcAddEquivMatrix e ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left
      Nx.φ)).precomp (wcPencilVQ D ℓ hP) (zero_add 0)) = LinearMap.toMatrix' Ψ := by
    ext a c
    rw [LinearMap.toMatrix'_apply, hΨw]
    rfl
  have hcp : (wcAddEquivMatrix e ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left
      Nx.φ)).precomp (wcPencilVQ D ℓ hP) (zero_add 0))).charpoly =
      ((g⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]).charpoly := by
    rw [hΨ, ← Matrix.charpoly_toLin' (LinearMap.toMatrix' Ψ), Matrix.toLin'_toMatrix',
      LinearEquiv.charpoly_conj, Matrix.charpoly_toLin']
  rw [hcp]

theorem wc_cheb_redMat_facts : ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (t r : ℕ),
    (∀ A B : Matrix (Fin r) (Fin r) ℚ_[ℓ], (∀ a b, ‖A a b‖ ≤ 1) → (∀ a b, ‖B a b‖ ≤ 1) →
      (∀ a b, ‖(A * B) a b‖ ≤ 1) ∧ wcRedMat ℓ t (A * B) = wcRedMat ℓ t A * wcRedMat ℓ t B ∧
      (wcRedMat ℓ t A = wcRedMat ℓ t B ↔ ∀ a b, ‖A a b - B a b‖ ≤ (ℓ : ℝ) ^ (-(t : ℤ)))) ∧
    wcRedMat ℓ t (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) = 1 ∧
    ∀ A : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ, (∀ a b, ‖(A : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ 1) →
      (∀ a b, ‖((A⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ 1) →
      ∃ M₀ : ℕ, 1 ≤ M₀ ∧
        wcRedMat ℓ t ((A ^ M₀ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) = 1 :=
by
  intro ℓ _ t r
  have hint : ∀ C : Matrix (Fin r) (Fin r) ℤ_[ℓ], ∀ a b,
      ‖(C.map (PadicInt.Coe.ringHom : ℤ_[ℓ] →+* ℚ_[ℓ])) a b‖ ≤ 1 := by
    intro C a b
    show ‖((C a b : ℤ_[ℓ]) : ℚ_[ℓ])‖ ≤ 1
    rw [← PadicInt.norm_def]
    exact PadicInt.norm_le_one _
  have L0 : ∀ C : Matrix (Fin r) (Fin r) ℤ_[ℓ],
      wcRedMat ℓ t (C.map (PadicInt.Coe.ringHom : ℤ_[ℓ] →+* ℚ_[ℓ])) =
        C.map (PadicInt.toZModPow t) := by
    intro C
    ext a b
    have hc : ‖((C a b : ℤ_[ℓ]) : ℚ_[ℓ])‖ ≤ 1 := by
      rw [← PadicInt.norm_def]; exact PadicInt.norm_le_one _
    show (if h : ‖((C a b : ℤ_[ℓ]) : ℚ_[ℓ])‖ ≤ 1 then
        PadicInt.toZModPow t (⟨((C a b : ℤ_[ℓ]) : ℚ_[ℓ]), h⟩ : ℤ_[ℓ]) else 0) =
      PadicInt.toZModPow t (C a b)
    exact (dif_pos hc).trans rfl
  let lift : (A : Matrix (Fin r) (Fin r) ℚ_[ℓ]) → (∀ a b, ‖A a b‖ ≤ 1) →
      Matrix (Fin r) (Fin r) ℤ_[ℓ] :=
    fun A hA => Matrix.of (fun a b => (⟨A a b, hA a b⟩ : ℤ_[ℓ]))
  have L1 : ∀ A hA, (lift A hA).map (PadicInt.Coe.ringHom : ℤ_[ℓ] →+* ℚ_[ℓ]) = A := by
    intro A hA
    ext a b
    rfl
  have L2 : ∀ A hA, wcRedMat ℓ t A = (lift A hA).map (PadicInt.toZModPow t) := by
    intro A hA
    have e := L0 (lift A hA)
    rwa [L1] at e
  have hmul : ∀ (A B : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (hA : ∀ a b, ‖A a b‖ ≤ 1)
      (hB : ∀ a b, ‖B a b‖ ≤ 1),
      A * B = (lift A hA * lift B hB).map (PadicInt.Coe.ringHom : ℤ_[ℓ] →+* ℚ_[ℓ]) := by
    intro A B hA hB
    rw [Matrix.map_mul, L1, L1]
  have hred : ∀ (A B : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (hA : ∀ a b, ‖A a b‖ ≤ 1)
      (hB : ∀ a b, ‖B a b‖ ≤ 1), wcRedMat ℓ t (A * B) = wcRedMat ℓ t A * wcRedMat ℓ t B := by
    intro A B hA hB
    rw [hmul A B hA hB, L0, Matrix.map_mul, L2 A hA, L2 B hB]
  have hone : wcRedMat ℓ t (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) = 1 := by
    have h1 : (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) =
        (1 : Matrix (Fin r) (Fin r) ℤ_[ℓ]).map (PadicInt.Coe.ringHom : ℤ_[ℓ] →+* ℚ_[ℓ]) := by
      rw [Matrix.map_one _ (map_zero _) (map_one _)]
    rw [h1, L0, Matrix.map_one _ (map_zero _) (map_one _)]
  refine ⟨fun A B hA hB => ⟨?_, hred A B hA hB, ?_⟩, hone, ?_⟩
  · rw [hmul A B hA hB]
    exact hint _
  · rw [L2 A hA, L2 B hB]
    constructor
    · intro h a b
      have h0 := congrFun (congrFun h a) b
      simp only [Matrix.map_apply] at h0
      have h2 : (lift A hA a b - lift B hB a b) ∈ Ideal.span {(ℓ : ℤ_[ℓ]) ^ t} := by
        rw [← PadicInt.ker_toZModPow]
        exact (RingHom.sub_mem_ker_iff _).mpr h0
      rw [← PadicInt.norm_le_pow_iff_mem_span_pow, PadicInt.norm_def, PadicInt.coe_sub] at h2
      exact h2
    · intro h
      ext a b
      simp only [Matrix.map_apply]
      apply (RingHom.sub_mem_ker_iff _).mp
      rw [PadicInt.ker_toZModPow, ← PadicInt.norm_le_pow_iff_mem_span_pow, PadicInt.norm_def,
        PadicInt.coe_sub]
      exact h a b
  · intro A hA hA'
    have hpow : ∀ n : ℕ, wcRedMat ℓ t ((A ^ n : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
        Matrix (Fin r) (Fin r) ℚ_[ℓ]) = (wcRedMat ℓ t (A : Matrix (Fin r) (Fin r) ℚ_[ℓ])) ^ n := by
      intro n
      rw [Units.val_pow_eq_pow_val]
      have e := L0 (lift _ hA ^ n)
      rw [Matrix.map_pow, L1] at e
      rw [e, Matrix.map_pow, ← L2]
    have hu1 : wcRedMat ℓ t (A : Matrix (Fin r) (Fin r) ℚ_[ℓ]) *
        wcRedMat ℓ t ((A⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) = 1 := by
      rw [← hred _ _ hA hA', Units.mul_inv, hone]
    have hu2 : wcRedMat ℓ t ((A⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) *
        wcRedMat ℓ t (A : Matrix (Fin r) (Fin r) ℚ_[ℓ]) = 1 := by
      rw [← hred _ _ hA' hA, Units.inv_mul, hone]
    have : NeZero (ℓ ^ t) := ⟨pow_ne_zero _ (Fact.out : ℓ.Prime).ne_zero⟩
    let u : (Matrix (Fin r) (Fin r) (ZMod (ℓ ^ t)))ˣ := ⟨_, _, hu1, hu2⟩
    refine ⟨orderOf u, orderOf_pos u, ?_⟩
    rw [hpow]
    have h2 := congrArg Units.val (pow_orderOf_eq_one u)
    rw [Units.val_pow_eq_pow_val, Units.val_one] at h2
    exact h2

theorem wc_cheb_frame_group_facts (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (r : ℕ)
    (θ : (wcPencilVQ D ℓ hP).over W ≅ (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W)
    (φ : W ⟶ W) (hB : wcVQGalFrame D ℓ hP W w r θ φ)
    (Γ : Subgroup (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) (Φ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ)
    (hΦ : wcVQFrame D ℓ hP W r θ φ (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]))
    (hΓ : ∀ h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ, h ∈ Γ ↔
      ∃ γ : W ⟶ W, γ ≫ w = w ∧ wcVQFrame D ℓ hP W r θ γ (h : Matrix (Fin r) (Fin r) ℚ_[ℓ])) :
    (∀ g ∈ Γ, ∀ a b, ‖(g : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ 1) ∧
    (∀ a b, ‖(Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ 1) ∧
    (∀ a b, ‖((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ 1) ∧
    (∀ g ∈ Γ, Φ * g * Φ⁻¹ ∈ Γ ∧ Φ⁻¹ * g * Φ ∈ Γ) :=
by
  classical
  obtain ⟨_, _, hconn, _, _, hgal, hφw, hrev, hdint, hφint⟩ := id hB
  obtain ⟨z₀⟩ := @ConnectedSpace.toNonempty _ _ hconn
  have hsurj : ∀ v : Fin r → ℚ_[ℓ], ∃ x : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op W),
      ∀ z : W.left, (show C(↥W.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom x).down) z = v := by
    intro v
    have key : ∀ y, (θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom
        ((θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom y) = y := by
      intro y
      change ((θ.inv ≫ θ.hom).hom.app (Opposite.op (Over.mk (𝟙 W)))).hom y = y
      rw [θ.inv_hom_id]
      rfl
    refine ⟨(θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom
      (ULift.up (ContinuousMap.const ↥W.left v)), ?_⟩
    intro z
    erw [key]
    rfl
  choose A hA using fun γ : W ⟶ W =>
    wc_proet_deck_frame_linear (wcP1Over F'').left ℓ (wcPencilVQ D ℓ hP) W hconn r θ γ
  have hex : ∀ γ : W ⟶ W, wcVQFrame D ℓ hP W r θ γ (LinearMap.toMatrix' (A γ)) := by
    intro γ s z
    rw [LinearMap.toMatrix'_mulVec]
    exact hA γ W (𝟙 W) γ (Category.id_comp γ).symm s z
  have hval : ∀ (γ : W ⟶ W) (g : Matrix (Fin r) (Fin r) ℚ_[ℓ]), wcVQFrame D ℓ hP W r θ γ g →
      ∀ v, g.mulVec v = A γ v := by
    intro γ g hg v
    obtain ⟨x, hx⟩ := hsurj v
    have h1 := hg x z₀
    have h2 := hA γ W (𝟙 W) γ (Category.id_comp γ).symm x z₀
    rw [hx] at h1 h2
    exact h1.symm.trans h2
  have huniq : ∀ (γ : W ⟶ W) (g g' : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      wcVQFrame D ℓ hP W r θ γ g → wcVQFrame D ℓ hP W r θ γ g' → g = g' := by
    intro γ g g' hg hg'
    apply Matrix.toLin'.injective
    refine LinearMap.ext fun v => ?_
    rw [Matrix.toLin'_apply, Matrix.toLin'_apply, hval γ g hg v, hval γ g' hg' v]
  have hcomp : ∀ (a b : W ⟶ W) (g g' : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      wcVQFrame D ℓ hP W r θ a g → wcVQFrame D ℓ hP W r θ b g' →
      wcVQFrame D ℓ hP W r θ (a ≫ b) (g' * g) := by
    intro a b g g' hg hg' s z
    refine (hA b W a (a ≫ b) rfl s z).trans ?_
    rw [← hval b g' hg', hg s z, Matrix.mulVec_mulVec]
  obtain ⟨hΦint, g', hΦg', hg'int⟩ := hφint (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]) hΦ
  refine ⟨?_, hΦint, ?_, ?_⟩
  · intro g hg
    obtain ⟨γ, hγ, hf⟩ := (hΓ g).mp hg
    exact hdint γ _ hγ hf
  · rw [Units.inv_eq_of_mul_eq_one_right hΦg']
    exact hg'int
  · intro h hh
    obtain ⟨γ, hγ, hf⟩ := (hΓ h).mp hh
    constructor
    · have e : φ ≫ w = (γ ≫ φ) ≫ w := by
        rw [Category.assoc, hφw, ← Category.assoc, hγ]
      obtain ⟨d, hd, hde⟩ := hgal W φ (γ ≫ φ) hconn e
      have c1 := hcomp γ φ _ _ hf hΦ
      have c2 := hcomp φ d _ _ hΦ (hex d)
      rw [hde] at c1
      have key := huniq _ _ _ c1 c2
      have hval' : ((Φ * h * Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
          Matrix (Fin r) (Fin r) ℚ_[ℓ]) = LinearMap.toMatrix' (A d) := by
        rw [Units.val_mul, Units.val_mul, key, Matrix.mul_assoc, Units.mul_inv, Matrix.mul_one]
      exact (hΓ _).mpr ⟨d, hd, by rw [hval']; exact hex d⟩
    · obtain ⟨a'', ha'', he''⟩ := hrev γ hγ
      have c1 := hcomp a'' φ _ _ (hex a'') hΦ
      have c2 := hcomp φ γ _ _ hΦ hf
      rw [he''] at c1
      have key := huniq _ _ _ c1 c2
      have hval' : ((Φ⁻¹ * h * Φ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
          Matrix (Fin r) (Fin r) ℚ_[ℓ]) = LinearMap.toMatrix' (A a'') := by
        rw [Units.val_mul, Units.val_mul, Matrix.mul_assoc, ← key, ← Matrix.mul_assoc,
          Units.inv_mul, Matrix.one_mul]
      exact (hΓ _).mpr ⟨a'', ha'', by rw [hval']; exact hex a''⟩

theorem wc_P1_offS_open (K : Type u) [Field K] [Finite K] (m : ℕ)
    (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left)) (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _) :
    ∃ Uo : (wcP1Over K).left.Opens,
      ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K) :=
by
  classical

  have hclosed : ∀ (X : Scheme.{u}) (q : X ⟶ Spec (.of K)) (s : Spec (.of K) ⟶ X),
      s ≫ q = 𝟙 _ → IsClosed ({s (IsLocalRing.closedPoint K)} : Set X) := by
    intro X q s hs
    have affine : ∀ (A : CommRingCat.{u}) (t : Spec (.of K) ⟶ Spec A) (g : Spec A ⟶ Spec (.of K)),
        t ≫ g = 𝟙 _ → IsClosed ({t (IsLocalRing.closedPoint K)} : Set (Spec A)) := by
      intro A t g htg
      obtain ⟨φ, rfl⟩ : ∃ φ, Spec.map φ = t := ⟨_, Spec.map_preimage t⟩
      obtain ⟨ψ, rfl⟩ : ∃ ψ, Spec.map ψ = g := ⟨_, Spec.map_preimage g⟩
      have h1 : ψ ≫ φ = 𝟙 _ := by
        apply Spec.map_injective
        rw [Spec.map_comp, htg, Spec.map_id]
      have hsurj : Function.Surjective φ.hom := fun k => ⟨ψ.hom k, by
        have := congrArg (fun f => f.hom k) h1
        simpa using this⟩
      have hmax := RingHom.ker_isMaximal_of_surjective φ.hom hsurj
      have hid : (PrimeSpectrum.comap φ.hom (IsLocalRing.closedPoint K)).asIdeal
          = RingHom.ker φ.hom := by
        rw [PrimeSpectrum.comap_asIdeal, RingHom.ker_eq_comap_bot]
        congr 1
        exact IsLocalRing.maximalIdeal_eq_bot
      have key := (PrimeSpectrum.isClosed_singleton_iff_isMaximal
        (PrimeSpectrum.comap φ.hom (IsLocalRing.closedPoint K))).mpr (by rw [hid]; exact hmax)
      exact key
    apply isClosed_of_closure_subset
    intro y hy
    have hxy : s (IsLocalRing.closedPoint K) ⤳ y := specializes_iff_mem_closure.mpr hy
    obtain ⟨V, hV, hyV, -⟩ :=
      exists_isAffineOpen_mem_and_subset (x := y) (U := ⊤) (TopologicalSpace.Opens.mem_top y)
    have hxV : s (IsLocalRing.closedPoint K) ∈ V := hxy.mem_open V.isOpen hyV
    have := hV.isOpenImmersion_fromSpec
    have hrange : Set.range hV.fromSpec = V := hV.range_fromSpec
    have hsub : Set.range s ⊆ Set.range hV.fromSpec := by
      rintro _ ⟨w, rfl⟩
      have hw : w = IsLocalRing.closedPoint K := Subsingleton.elim (α := PrimeSpectrum K) _ _
      rw [hw, hrange]
      exact hxV
    let t := IsOpenImmersion.lift hV.fromSpec s hsub
    have ht : t ≫ hV.fromSpec = s := IsOpenImmersion.lift_fac _ _ _
    have htg : t ≫ (hV.fromSpec ≫ q) = 𝟙 _ := by rw [← Category.assoc, ht, hs]
    have hcl := affine Γ(X, V) t (hV.fromSpec ≫ q) htg
    have hιt : hV.fromSpec (t (IsLocalRing.closedPoint K)) = s (IsLocalRing.closedPoint K) := by
      have e := Scheme.Hom.comp_apply t hV.fromSpec (IsLocalRing.closedPoint K)
      rw [ht] at e
      exact e.symm
    have hyr : y ∈ Set.range hV.fromSpec := by rw [hrange]; exact hyV
    obtain ⟨y', rfl⟩ := hyr
    have hspec : t (IsLocalRing.closedPoint K) ⤳ y' := by
      rw [← hV.fromSpec.isOpenEmbedding.isInducing.specializes_iff, hιt]
      exact hxy
    have hmem := hspec.mem_closed hcl rfl
    rw [Set.mem_singleton_iff] at hmem ⊢
    rw [hmem, hιt]
  have hcl : ∀ i, IsClosed ({S i (IsLocalRing.closedPoint K)} : Set (wcP1Over K).left) :=
    fun i => hclosed _ (wcP1Over K).hom (S i) (hS i)
  have hC : IsClosed (⋃ i, ({S i (IsLocalRing.closedPoint K)} : Set (wcP1Over K).left)) :=
    isClosed_iUnion_of_finite hcl
  refine ⟨⟨(⋃ i, ({S i (IsLocalRing.closedPoint K)} : Set (wcP1Over K).left))ᶜ,
    hC.isOpen_compl⟩, fun p => ?_⟩
  show p ∈ (⋃ i, ({S i (IsLocalRing.closedPoint K)} : Set (wcP1Over K).left))ᶜ ↔ _
  simp only [Set.mem_compl_iff, Set.mem_iUnion, Set.mem_singleton_iff, not_exists]

theorem wc_clc_geom_torsor (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (r : ℕ)
    (θ : (wcPencilVQ D ℓ hP).over W ≅ (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W)
    (φ : W ⟶ W) (hB : wcVQGalFrame D ℓ hP W w r θ φ)
    (Γ : Subgroup (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) (Φ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ)
    (hΦ : wcVQFrame D ℓ hP W r θ φ (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]))
    (hΓ : ∀ h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ, h ∈ Γ ↔
      ∃ γ : W ⟶ W, γ ≫ w = w ∧ wcVQFrame D ℓ hP W r θ γ (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]))
    (t : ℕ) (H : Subgroup (Matrix (Fin r) (Fin r) (ZMod (ℓ ^ t)))ˣ)
    (hH : ∀ y, y ∈ H ↔ ∃ v : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ, v ∈ Γ ∧
      (y : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ t))) = wcRedMat ℓ t (v : Matrix (Fin r) (Fin r) ℚ_[ℓ]))
    (P : (Matrix (Fin r) (Fin r) (ZMod (ℓ ^ t)))ˣ)
    (hP1 : (P : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ t))) = wcRedMat ℓ t (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ])) :
    ∃ (Ub : (wcGeomPoint F'' (wcP1Over F'') hP).left.Opens) (p : W.left ⟶ Ub.toScheme)
      (FrU : Ub.toScheme ⟶ Ub.toScheme) (E : Scheme.{u}) (πE : E ⟶ Ub.toScheme)
      (s : H → (W.left ⟶ E)) (τ : H → (E ⟶ E)) (FH FH' : E ⟶ E),
      (∀ y, y ∈ Ub ↔ ∀ i, (wcGeomPoint F'' (wcP1Over F'') hP).hom y ≠ D.S i (IsLocalRing.closedPoint F'')) ∧
      p ≫ Ub.ι = w.left ∧ FrU ≫ Ub.ι = Ub.ι ≫ (wcGeomFrob F'' (wcP1Over F'') hP).left ∧
      IsFinite πE ∧ Etale πE ∧ Surjective πE ∧ ConnectedSpace E ∧ (∀ h, s h ≫ πE = p) ∧
      τ 1 = 𝟙 E ∧ (∀ η η', τ η ≫ τ η' = τ (η' * η)) ∧ (∀ η, τ η ≫ πE = πE) ∧
      (∀ h η, s h ≫ τ η = s (η * h)) ∧
      (∀ (T : Scheme.{u}), ConnectedSpace T → ∀ (a b : T ⟶ E), a ≫ πE = b ≫ πE →
        ∃! η, b = a ≫ τ η) ∧
      FH ≫ FH' = 𝟙 E ∧ FH' ≫ FH = 𝟙 E ∧ FH ≫ πE = πE ≫ FrU ∧
      (∀ η η' : H, (η' : (Matrix (Fin r) (Fin r) (ZMod (ℓ ^ t)))ˣ) = P * η * P⁻¹ →
        τ η ≫ FH = FH ≫ τ η') ∧
      (∀ h h' : H, (h' : (Matrix (Fin r) (Fin r) (ZMod (ℓ ^ t)))ˣ) = P * h * P⁻¹ →
        s h ≫ FH = φ.left ≫ s h') ∧
      (∀ (d : ℕ) (δ : W ⟶ W) (v : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ), δ ≫ w = w → v ∈ Γ →
        wcVQFrame D ℓ hP W r θ ((fun γ : W ⟶ W => φ ≫ γ)^[d] (𝟙 W) ≫ δ)
          ((v * Φ ^ d : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) →
        ∀ h h' : H, (((h' : (Matrix (Fin r) (Fin r) (ZMod (ℓ ^ t)))ˣ)) :
            Matrix (Fin r) (Fin r) (ZMod (ℓ ^ t))) =
          ((h : (Matrix (Fin r) (Fin r) (ZMod (ℓ ^ t)))ˣ) : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ t))) *
            wcRedMat ℓ t (v : Matrix (Fin r) (Fin r) ℚ_[ℓ]) →
        δ.left ≫ s h = s h') :=
by
  classical
  obtain ⟨hΓint, hΦint, hΦiint, hnorm⟩ :=
    wc_cheb_frame_group_facts F' F'' Y n hn hn2 D ℓ hℓ hP W w r θ φ hB Γ Φ hΦ hΓ
  obtain ⟨hmul, hred1, -⟩ := wc_cheb_redMat_facts ℓ t r
  obtain ⟨-, hqc, hconn, hoff, hcov, hgal, hφw, -, -, -⟩ := hB
  haveI := hconn
  obtain ⟨z₀⟩ : Nonempty W.left := ConnectedSpace.toNonempty
  haveI : NeZero (ℓ ^ t) := ⟨pow_ne_zero _ (Fact.out : ℓ.Prime).ne_zero⟩
  haveI : Finite ↥H := inferInstance



  have hinvL : ∀ v : ↥Γ,
      wcRedMat ℓ t ((v : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) *
        wcRedMat ℓ t (((v : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ)⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
          Matrix (Fin r) (Fin r) ℚ_[ℓ]) = 1 := by
    intro v
    rw [← (hmul _ _ (hΓint _ v.2) (hΓint _ (Γ.inv_mem v.2))).2.1, Units.mul_inv, hred1]
  have hinvR : ∀ v : ↥Γ,
      wcRedMat ℓ t (((v : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ)⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
          Matrix (Fin r) (Fin r) ℚ_[ℓ]) *
        wcRedMat ℓ t ((v : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) = 1 := by
    intro v
    rw [← (hmul _ _ (hΓint _ (Γ.inv_mem v.2)) (hΓint _ v.2)).2.1, Units.inv_mul, hred1]
  obtain ⟨ρΓ, hρΓ⟩ : ∃ ρΓ : ↥Γ →* (Matrix (Fin r) (Fin r) (ZMod (ℓ ^ t)))ˣ, ∀ v : ↥Γ,
      ((ρΓ v : (Matrix (Fin r) (Fin r) (ZMod (ℓ ^ t)))ˣ) : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ t))) =
        wcRedMat ℓ t ((v : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) :=
    ⟨{ toFun := fun v => ⟨_, _, hinvL v, hinvR v⟩
       map_one' := Units.ext (by
         change wcRedMat ℓ t (((1 : ↥Γ) : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
