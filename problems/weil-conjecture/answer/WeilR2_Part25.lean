theorem wc_hyprc_model_identity (A : Type u) [CommRing A] (n : ℕ) (hnm : n = 2 * (n / 2)) (π : A)
    (c P : Matrix (Fin n) (Fin n) A) (D' : MvPolynomial (Fin n) A)
    (hP : IsUnit P.det)
    (hhyp : (∑ p, ∑ q, MvPolynomial.C (c p q) *
          (∑ a, MvPolynomial.C (P p a) * MvPolynomial.X a) *
          (∑ b, MvPolynomial.C (P q b) * MvPolynomial.X b) : MvPolynomial (Fin n) A) =
        ∑ t : Fin (n / 2), MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n) *
          MvPolynomial.X (⟨2 * t.val + 1, by omega⟩ : Fin n) + MvPolynomial.C π * D') :
    (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q :
        MvPolynomial (Fin n) A) =
      ∑ t : Fin (n / 2),
        (∑ b, MvPolynomial.C (P⁻¹ (⟨2 * t.val, by omega⟩ : Fin n) b) * MvPolynomial.X b) *
        (∑ b, MvPolynomial.C (P⁻¹ (⟨2 * t.val + 1, by omega⟩ : Fin n) b) * MvPolynomial.X b) +
      MvPolynomial.C π * MvPolynomial.bind₁
        (fun a => ∑ b, MvPolynomial.C (P⁻¹ a b) * MvPolynomial.X b) D' :=
by
  classical
  have hPP : P * P⁻¹ = 1 := Matrix.mul_nonsing_inv P hP
  have s1 : ∀ p : Fin n, MvPolynomial.bind₁
      (fun a => ∑ b, MvPolynomial.C (P⁻¹ a b) * MvPolynomial.X b)
      (∑ a, MvPolynomial.C (P p a) * MvPolynomial.X a : MvPolynomial (Fin n) A) =
      MvPolynomial.X p := by
    intro p
    simp only [map_sum, map_mul, MvPolynomial.bind₁_C_right, MvPolynomial.bind₁_X_right,
      Finset.mul_sum]
    rw [Finset.sum_comm]
    have hb : ∀ b : Fin n, ∑ a, MvPolynomial.C (P p a) *
        (MvPolynomial.C (P⁻¹ a b) * (MvPolynomial.X b : MvPolynomial (Fin n) A)) =
        MvPolynomial.C ((P * P⁻¹) p b) * MvPolynomial.X b := by
      intro b
      rw [Matrix.mul_apply, map_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl (fun a _ => ?_)
      rw [MvPolynomial.C_mul, mul_assoc]
    simp only [hb, hPP, Matrix.one_apply]
    simp
  have hL : MvPolynomial.bind₁ (fun a => ∑ b, MvPolynomial.C (P⁻¹ a b) * MvPolynomial.X b)
      (∑ p, ∑ q, MvPolynomial.C (c p q) *
          (∑ a, MvPolynomial.C (P p a) * MvPolynomial.X a) *
          (∑ b, MvPolynomial.C (P q b) * MvPolynomial.X b) : MvPolynomial (Fin n) A) =
      ∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q := by
    rw [map_sum]
    refine Finset.sum_congr rfl (fun p _ => ?_)
    rw [map_sum]
    refine Finset.sum_congr rfl (fun q _ => ?_)
    rw [map_mul, map_mul, s1, s1, MvPolynomial.bind₁_C_right]
  rw [← hL, hhyp]
  simp only [map_add, map_sum, map_mul, MvPolynomial.bind₁_X_right, MvPolynomial.bind₁_C_right]

theorem wc_hyprc_hyp_form (A : Type u) [CommRing A] (n : ℕ) (hnm : n = 2 * (n / 2)) :
    (∑ p, ∑ q, MvPolynomial.C ((Matrix.of fun p q : Fin n =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0) p q) *
        MvPolynomial.X p * MvPolynomial.X q : MvPolynomial (Fin n) A) =
      ∑ t : Fin (n / 2), MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n) *
        MvPolynomial.X (⟨2 * t.val + 1, by omega⟩ : Fin n) :=
by
  classical
  have hs : ∀ p q : Fin n, (MvPolynomial.C ((Matrix.of fun p q : Fin n =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0) p q) *
        MvPolynomial.X p * MvPolynomial.X q : MvPolynomial (Fin n) A) =
      if p.val % 2 = 0 ∧ q.val = p.val + 1 then
        (MvPolynomial.X p * MvPolynomial.X q : MvPolynomial (Fin n) A) else 0 := by
    intro p q
    rw [Matrix.of_apply]
    split_ifs <;> simp
  rw [Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl (fun q _ => hs p q))]
  rw [← Fintype.sum_prod_type' (f := fun p q : Fin n =>
    if p.val % 2 = 0 ∧ q.val = p.val + 1 then
      (MvPolynomial.X p * MvPolynomial.X q : MvPolynomial (Fin n) A) else 0)]
  rw [← Finset.sum_filter]
  symm
  refine Finset.sum_nbij'
    (fun t : Fin (n / 2) => ((⟨2 * t.val, by omega⟩ : Fin n), (⟨2 * t.val + 1, by omega⟩ : Fin n)))
    (fun x : Fin n × Fin n => (⟨x.1.val / 2, by have := x.1.isLt; omega⟩ : Fin (n / 2)))
    ?_ ?_ ?_ ?_ ?_
  · intro t _
    rw [Finset.mem_filter]
    refine ⟨Finset.mem_univ _, ?_⟩
    show (2 * t.val) % 2 = 0 ∧ 2 * t.val + 1 = 2 * t.val + 1
    omega
  · intro x _
    exact Finset.mem_univ _
  · intro t _
    apply Fin.ext
    show 2 * t.val / 2 = t.val
    omega
  · intro x hx
    rw [Finset.mem_filter] at hx
    obtain ⟨_, h1, h2⟩ := hx
    apply Prod.ext
    · apply Fin.ext
      show 2 * (x.1.val / 2) = x.1.val
      omega
    · apply Fin.ext
      show 2 * (x.1.val / 2) + 1 = x.2.val
      omega
  · intro t _
    rfl

theorem wc_hyprc_psi_exists (A : Type u) [CommRing A] (n : ℕ) (hnm : n = 2 * (n / 2)) (π : A)
    (c ch : Matrix (Fin n) (Fin n) A) (D' : MvPolynomial (Fin n) A)
    (Z : Fin n → MvPolynomial (Fin n) A) (w u g : MvPolynomial (Fin n) A)
    (hw : w = 1 - MvPolynomial.bind₁ Z D') (hg : g = w * u)
    (hQ : (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q :
        MvPolynomial (Fin n) A) =
      ∑ t : Fin (n / 2), Z ⟨2 * t.val, by omega⟩ * Z ⟨2 * t.val + 1, by omega⟩ +
        MvPolynomial.C π * MvPolynomial.bind₁ Z D')
    (hH : (∑ p, ∑ q, MvPolynomial.C (ch p q) * MvPolynomial.X p * MvPolynomial.X q :
        MvPolynomial (Fin n) A) =
      ∑ t : Fin (n / 2), MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n) *
        MvPolynomial.X (⟨2 * t.val + 1, by omega⟩ : Fin n))
    (S : Type u) [CommRing S] [Algebra (wcQuadModelRing A n π c) S]
    [IsLocalization.Away (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) g) S] :
    ∃ Ψ : wcQuadModelRing A n π ch →+* S,
      Ψ.comp (algebraMap A (wcQuadModelRing A n π ch)) =
        (algebraMap (wcQuadModelRing A n π c) S).comp (algebraMap A (wcQuadModelRing A n π c)) ∧
      (∀ p : Fin n, p.val % 2 = 0 →
        Ψ (Ideal.Quotient.mk (wcQuadModelIdeal A n π ch) (MvPolynomial.X p)) =
          algebraMap (wcQuadModelRing A n π c) S
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (Z p))) ∧
      (∀ p : Fin n, p.val % 2 = 1 →
        Ψ (Ideal.Quotient.mk (wcQuadModelIdeal A n π ch) (MvPolynomial.X p)) *
          algebraMap (wcQuadModelRing A n π c) S
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) w) =
          algebraMap (wcQuadModelRing A n π c) S
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (Z p))) :=
by
  classical
  obtain ⟨κ, hκ⟩ : ∃ κ : MvPolynomial (Fin n) A →+* S, ∀ f, κ f =
      algebraMap (wcQuadModelRing A n π c) S (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) f) :=
    ⟨(algebraMap (wcQuadModelRing A n π c) S).comp (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)),
      fun f => rfl⟩
  have hWu : IsUnit (κ w) := by
    have h := IsLocalization.Away.algebraMap_isUnit (S := S)
      (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) g)
    rw [← hκ, hg, map_mul] at h
    exact isUnit_of_mul_isUnit_left h
  obtain ⟨Winv, hWinv1, hWinv2⟩ : ∃ Winv : S, κ w * Winv = 1 ∧ Winv * κ w = 1 :=
    ⟨_, hWu.mul_val_inv, hWu.val_inv_mul⟩
  obtain ⟨ξ, hξe, hξo⟩ : ∃ ξ : Fin n → S, (∀ p : Fin n, p.val % 2 = 0 → ξ p = κ (Z p)) ∧
      (∀ p : Fin n, p.val % 2 ≠ 0 → ξ p = κ (Z p) * Winv) :=
    ⟨fun p => if p.val % 2 = 0 then κ (Z p) else κ (Z p) * Winv,
      fun p hp => if_pos hp, fun p hp => if_neg hp⟩
  obtain ⟨Ψ₀, hΨX, hΨC⟩ : ∃ Ψ₀ : MvPolynomial (Fin n) A →+* S,
      (∀ p, Ψ₀ (MvPolynomial.X p) = ξ p) ∧
      (∀ r, Ψ₀ (MvPolynomial.C r) = κ (MvPolynomial.C r)) :=
    ⟨MvPolynomial.eval₂Hom (κ.comp MvPolynomial.C) ξ,
      fun p => MvPolynomial.eval₂Hom_X' _ _ p, fun r => MvPolynomial.eval₂Hom_C _ _ r⟩
  have hkey : ∑ t : Fin (n / 2), Z ⟨2 * t.val, by omega⟩ * Z ⟨2 * t.val + 1, by omega⟩ =
      ((∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q :
        MvPolynomial (Fin n) A) - MvPolynomial.C π) + MvPolynomial.C π * w := by
    rw [hQ, hw]; ring
  have hgen : κ ((∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q :
        MvPolynomial (Fin n) A) - MvPolynomial.C π) = 0 := by
    have hm : Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
        ((∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q :
          MvPolynomial (Fin n) A) - MvPolynomial.C π) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
    rw [hκ, hm, map_zero]
  have hkZ : κ (∑ t : Fin (n / 2), Z ⟨2 * t.val, by omega⟩ * Z ⟨2 * t.val + 1, by omega⟩) =
      κ (MvPolynomial.C π) * κ w := by
    rw [hkey, map_add, hgen, zero_add, map_mul]
  have hsum : Ψ₀ (∑ t : Fin (n / 2), MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n) *
        MvPolynomial.X (⟨2 * t.val + 1, by omega⟩ : Fin n)) =
      κ (∑ t : Fin (n / 2), Z ⟨2 * t.val, by omega⟩ * Z ⟨2 * t.val + 1, by omega⟩) * Winv := by
    rw [map_sum, map_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl (fun t _ => ?_)
    rw [map_mul, map_mul, hΨX, hΨX,
      hξe ⟨2 * t.val, by omega⟩ (by show (2 * t.val) % 2 = 0; omega),
      hξo ⟨2 * t.val + 1, by omega⟩ (by show (2 * t.val + 1) % 2 ≠ 0; omega), mul_assoc]
  have hH0 : Ψ₀ ((∑ p, ∑ q, MvPolynomial.C (ch p q) * MvPolynomial.X p * MvPolynomial.X q :
        MvPolynomial (Fin n) A) - MvPolynomial.C π) = 0 := by
    rw [map_sub, hH, hsum, hkZ, hΨC, mul_assoc, hWinv1, mul_one, sub_self]
  have hker : ∀ a ∈ wcQuadModelIdeal A n π ch, Ψ₀ a = 0 := by
    intro a ha
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul, hH0, mul_zero]
  refine ⟨Ideal.Quotient.lift (wcQuadModelIdeal A n π ch) Ψ₀ hker, ?_, ?_, ?_⟩
  · refine RingHom.ext fun r => ?_
    simp only [RingHom.comp_apply]
    rw [← Ideal.Quotient.mk_algebraMap, Ideal.Quotient.lift_mk, MvPolynomial.algebraMap_eq, hΨC,
      hκ]
    rfl
  · intro p hp
    rw [Ideal.Quotient.lift_mk, hΨX, hξe p hp, hκ]
  · intro p hp
    rw [Ideal.Quotient.lift_mk, hΨX, hξo p (by omega), ← hκ, ← hκ, mul_assoc, hWinv2, mul_one]

theorem wc_hyprc_psi_etale (A : Type u) [CommRing A] (n : ℕ) (hnm : n = 2 * (n / 2)) (π : A)
    (c ch P : Matrix (Fin n) (Fin n) A) (D' : MvPolynomial (Fin n) A) (hP : IsUnit P.det)
    (Z : Fin n → MvPolynomial (Fin n) A) (w u g : MvPolynomial (Fin n) A)
    (hZ : ∀ a, Z a = ∑ b, MvPolynomial.C (P⁻¹ a b) * MvPolynomial.X b)
    (hw : w = 1 - MvPolynomial.bind₁ Z D')
    (hu : u = w + ∑ t : Fin (n / 2), Z ⟨2 * t.val + 1, by omega⟩ *
        MvPolynomial.bind₁ Z (MvPolynomial.pderiv (⟨2 * t.val + 1, by omega⟩ : Fin n) D'))
    (hg : g = w * u)
    (hQ : (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q :
        MvPolynomial (Fin n) A) =
      ∑ t : Fin (n / 2), Z ⟨2 * t.val, by omega⟩ * Z ⟨2 * t.val + 1, by omega⟩ +
        MvPolynomial.C π * MvPolynomial.bind₁ Z D')
    (hH : (∑ p, ∑ q, MvPolynomial.C (ch p q) * MvPolynomial.X p * MvPolynomial.X q :
        MvPolynomial (Fin n) A) =
      ∑ t : Fin (n / 2), MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n) *
        MvPolynomial.X (⟨2 * t.val + 1, by omega⟩ : Fin n))
    (S : Type u) [CommRing S] [Algebra (wcQuadModelRing A n π c) S]
    [IsLocalization.Away (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) g) S]
    (Ψ : wcQuadModelRing A n π ch →+* S)
    (hc : Ψ.comp (algebraMap A (wcQuadModelRing A n π ch)) =
        (algebraMap (wcQuadModelRing A n π c) S).comp (algebraMap A (wcQuadModelRing A n π c)))
    (ha : ∀ p : Fin n, p.val % 2 = 0 →
        Ψ (Ideal.Quotient.mk (wcQuadModelIdeal A n π ch) (MvPolynomial.X p)) =
          algebraMap (wcQuadModelRing A n π c) S
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (Z p)))
    (hb : ∀ p : Fin n, p.val % 2 = 1 →
        Ψ (Ideal.Quotient.mk (wcQuadModelIdeal A n π ch) (MvPolynomial.X p)) *
          algebraMap (wcQuadModelRing A n π c) S
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) w) =
          algebraMap (wcQuadModelRing A n π c) S
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (Z p))) :
    Ψ.Etale :=
by
  classical

  have s1 : ∀ (R : Type u) [CommRing R] (m : ℕ) (y : Fin m → R) (F : MvPolynomial (Fin m) R)
      (G : Fin m → MvPolynomial (Fin m) R), (∀ t, MvPolynomial.pderiv t F = G t) →
      ∀ (rel : Fin m ⊕ Unit → MvPolynomial (Fin m ⊕ Unit) R),
      (∀ t, rel (Sum.inl t) = MvPolynomial.X (Sum.inl t) - MvPolynomial.C (y t) *
        (1 - MvPolynomial.rename Sum.inl F)) →
      rel (Sum.inr ()) = MvPolynomial.X (Sum.inr ()) * ((1 - MvPolynomial.rename Sum.inl F) *
        (1 + ∑ t, MvPolynomial.C (y t) * MvPolynomial.rename Sum.inl (G t))) - 1 →
      Algebra.Etale R (MvPolynomial (Fin m ⊕ Unit) R ⧸ Ideal.span (Set.range rel)) := by
    intro R _ m y F G hG rel hr1 hr2
    have noinr : ∀ H : MvPolynomial (Fin m) R,
        MvPolynomial.pderiv (Sum.inr () : Fin m ⊕ Unit) (MvPolynomial.rename Sum.inl H) = 0 := by
      intro H
      induction H using MvPolynomial.induction_on with
      | C a => simp
      | add p q hp hq => simp [hp, hq]
      | mul_X p i hp => simp [hp, MvPolynomial.pderiv_X]
    let P := Algebra.PreSubmersivePresentation.naive (R := R) (v := rel) id Function.injective_id
    have hMe : ∀ i j, P.jacobiMatrix i j = MvPolynomial.pderiv i (rel j) := by
      intro i j
      rw [Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
      rfl
    let W : MvPolynomial (Fin m ⊕ Unit) R := 1 - MvPolynomial.rename Sum.inl F
    let J : MvPolynomial (Fin m ⊕ Unit) R :=
      1 + ∑ t, MvPolynomial.C (y t) * MvPolynomial.rename Sum.inl (G t)
    let M11 : Matrix (Fin m) (Fin m) (MvPolynomial (Fin m ⊕ Unit) R) :=
      1 + (Matrix.replicateCol Unit (fun u => MvPolynomial.rename Sum.inl (G u)) :
        Matrix (Fin m) Unit (MvPolynomial (Fin m ⊕ Unit) R)) *
        (Matrix.replicateRow Unit (fun t => MvPolynomial.C (y t)) :
          Matrix Unit (Fin m) (MvPolynomial (Fin m ⊕ Unit) R))
    let M22 : Matrix Unit Unit (MvPolynomial (Fin m ⊕ Unit) R) := Matrix.of fun _ _ => W * J
    let M12 : Matrix (Fin m) Unit (MvPolynomial (Fin m ⊕ Unit) R) :=
      Matrix.of fun u _ => P.jacobiMatrix (Sum.inl u) (Sum.inr ())
    have hblock : (P.jacobiMatrix :
        Matrix (Fin m ⊕ Unit) (Fin m ⊕ Unit) (MvPolynomial (Fin m ⊕ Unit) R)) =
        Matrix.fromBlocks M11 M12 0 M22 := by
      refine Matrix.ext fun i j => ?_
      rcases i with u | u <;> rcases j with t | t
      · rw [hMe, Matrix.fromBlocks_apply₁₁, hr1]
        simp only [M11, Matrix.add_apply, Matrix.one_apply, Matrix.mul_apply,
          Matrix.replicateCol_apply, Matrix.replicateRow_apply, Finset.univ_unique,
          Finset.sum_singleton, map_sub, MvPolynomial.pderiv_X, Derivation.leibniz,
          MvPolynomial.pderiv_C, map_one, MvPolynomial.pderiv_rename Sum.inl_injective, hG,
          smul_eq_mul]
        simp [Pi.single_apply, Sum.inl.injEq, mul_comm, eq_comm]
      · rw [Matrix.fromBlocks_apply₁₂]; rfl
      · rw [hMe, Matrix.fromBlocks_apply₂₁, hr1]
        simp [MvPolynomial.pderiv_X, noinr]
      · rw [hMe, Matrix.fromBlocks_apply₂₂, hr2]
        simp [M22, W, J, MvPolynomial.pderiv_X, noinr]
    have hdet : (P.jacobiMatrix.det : MvPolynomial (Fin m ⊕ Unit) R) = J * (W * J) := by
      rw [hblock, Matrix.det_fromBlocks_zero₂₁]
      have h1 : M11.det = J := by
        simp only [M11]
        rw [Matrix.det_one_add_replicateCol_mul_replicateRow]
        simp [J, dotProduct, mul_comm]
      rw [h1, Matrix.det_unique]
      rfl
    have halg : ∀ x : MvPolynomial (Fin m ⊕ Unit) R,
        algebraMap P.Ring (MvPolynomial (Fin m ⊕ Unit) R ⧸ Ideal.span (Set.range rel)) x =
          Ideal.Quotient.mk (Ideal.span (Set.range rel)) x := by
      intro x
      rw [Algebra.Generators.algebraMap_apply]
      have hv : P.val = fun i =>
          Ideal.Quotient.mk (Ideal.span (Set.range rel)) (MvPolynomial.X i) := by
        funext i
        rfl
      rw [hv]
      have h1 := MvPolynomial.aeval_unique (Ideal.Quotient.mkₐ R (Ideal.span (Set.range rel)))
      have h2 : (Ideal.Quotient.mkₐ R (Ideal.span (Set.range rel))) x =
          Ideal.Quotient.mk (Ideal.span (Set.range rel)) x := rfl
      rw [← h2, h1]
      rfl
    have hrel0 : Ideal.Quotient.mk (Ideal.span (Set.range rel)) (rel (Sum.inr ())) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨Sum.inr (), rfl⟩)
    have hWJ : IsUnit (Ideal.Quotient.mk (Ideal.span (Set.range rel)) (W * J)) := by
      refine IsUnit.of_mul_eq_one
        (Ideal.Quotient.mk (Ideal.span (Set.range rel)) (MvPolynomial.X (Sum.inr ()))) ?_
      rw [hr2, map_sub, map_one, sub_eq_zero] at hrel0
      rw [← map_mul, mul_comm]
      exact hrel0
    have hJ : IsUnit (Ideal.Quotient.mk (Ideal.span (Set.range rel)) J) := by
      rw [map_mul] at hWJ
      exact isUnit_of_mul_isUnit_right hWJ
    have hunit : IsUnit P.jacobian := by
      rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det]
      erw [halg]
      rw [hdet, map_mul]
      exact hJ.mul hWJ
    have hdim : (Algebra.SubmersivePresentation.mk P hunit).dimension = 0 := by
      show Nat.card _ - Nat.card _ = 0
      exact Nat.sub_self _
    have := (Algebra.SubmersivePresentation.mk P hunit).isStandardSmoothOfRelativeDimension hdim
    infer_instance

  have s2 : ∀ (R S : Type u) [CommRing R] [CommRing S] (Ψ : R →+* S) (ι : Type)
      (rel : ι → MvPolynomial ι R),
      Algebra.Etale R (MvPolynomial ι R ⧸ Ideal.span (Set.range rel)) →
      ∀ (x : ι → S), (∀ j, MvPolynomial.eval₂ Ψ x (rel j) = 0) →
      (∀ (T : Type u) [CommRing T] (φ : R →+* T) (a : ι → T),
        (∀ j, MvPolynomial.eval₂ φ a (rel j) = 0) →
        ∃ ω : S →+* T, ω.comp Ψ = φ ∧ ∀ i, ω (x i) = a i) →
      (∀ ω : S →+* S, ω.comp Ψ = Ψ → (∀ i, ω (x i) = x i) → ω = RingHom.id S) →
      Ψ.Etale := by
    intro R S _ _ Ψ ι rel hEt x hx huniv hrig
    have hle : Ideal.span (Set.range rel) ≤ RingHom.ker (MvPolynomial.eval₂Hom Ψ x) := by
      rw [Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      exact (RingHom.mem_ker).mpr (hx j)
    let α : (MvPolynomial ι R ⧸ Ideal.span (Set.range rel)) →+* S :=
      Ideal.Quotient.lift (Ideal.span (Set.range rel)) (MvPolynomial.eval₂Hom Ψ x)
        (fun a ha => (RingHom.mem_ker).mp (hle ha))
    have hαmk : ∀ p, α (Ideal.Quotient.mk (Ideal.span (Set.range rel)) p) =
        MvPolynomial.eval₂ Ψ x p := fun p => Ideal.Quotient.lift_mk _ _ _
    have hmkeval : ∀ p : MvPolynomial ι R,
        MvPolynomial.eval₂ (algebraMap R (MvPolynomial ι R ⧸ Ideal.span (Set.range rel)))
          (fun i => Ideal.Quotient.mk (Ideal.span (Set.range rel)) (MvPolynomial.X i)) p =
        Ideal.Quotient.mk (Ideal.span (Set.range rel)) p := by
      intro p
      have : (MvPolynomial.eval₂Hom (algebraMap R (MvPolynomial ι R ⧸ Ideal.span (Set.range rel)))
          (fun i => Ideal.Quotient.mk (Ideal.span (Set.range rel)) (MvPolynomial.X i))) =
          Ideal.Quotient.mk (Ideal.span (Set.range rel)) := by
        apply MvPolynomial.ringHom_ext
        · intro r; simp [MvPolynomial.algebraMap_eq]; rfl
        · intro i; simp
      exact congrArg (fun f : MvPolynomial ι R →+* (MvPolynomial ι R ⧸ Ideal.span (Set.range rel)) =>
        f p) this
    obtain ⟨β, hβΨ, hβx⟩ := huniv (MvPolynomial ι R ⧸ Ideal.span (Set.range rel))
      (algebraMap R (MvPolynomial ι R ⧸ Ideal.span (Set.range rel)))
      (fun i => Ideal.Quotient.mk (Ideal.span (Set.range rel)) (MvPolynomial.X i)) (by
        intro j
        rw [hmkeval]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨j, rfl⟩))
    have hαalg : ∀ r, α (algebraMap R (MvPolynomial ι R ⧸ Ideal.span (Set.range rel)) r) = Ψ r := by
      intro r
      have : algebraMap R (MvPolynomial ι R ⧸ Ideal.span (Set.range rel)) r =
          Ideal.Quotient.mk (Ideal.span (Set.range rel)) (MvPolynomial.C r) := rfl
      rw [this, hαmk, MvPolynomial.eval₂_C]
    have h1 : α.comp β = RingHom.id S := by
      apply hrig
      · ext r
        simp only [RingHom.comp_apply]
        rw [← RingHom.comp_apply β Ψ, hβΨ, hαalg]
      · intro i
        simp only [RingHom.comp_apply]
        rw [hβx, hαmk, MvPolynomial.eval₂_X]
    have h2 : β.comp α = RingHom.id _ := by
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro r
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hαmk, MvPolynomial.eval₂_C, ← RingHom.comp_apply β Ψ, hβΨ]
        rfl
      · intro i
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hαmk, MvPolynomial.eval₂_X, hβx]
    have hbij : Function.Bijective α := by
      rw [Function.bijective_iff_has_inverse]
      refine ⟨β, fun q => ?_, fun s => ?_⟩
      · exact congrArg (fun f : (MvPolynomial ι R ⧸ Ideal.span (Set.range rel)) →+*
          (MvPolynomial ι R ⧸ Ideal.span (Set.range rel)) => f q) h2
      · exact congrArg (fun f : S →+* S => f s) h1
    have hΨ : Ψ = α.comp (algebraMap R (MvPolynomial ι R ⧸ Ideal.span (Set.range rel))) := by
      ext r
      simp only [RingHom.comp_apply]
      rw [hαalg]
    rw [hΨ]
    exact RingHom.Etale.stableUnderComposition _ _ (RingHom.etale_algebraMap.mpr hEt)
      (RingHom.Etale.of_bijective hbij)
  obtain ⟨ζ, hζ⟩ : ∃ ζ : Fin n → MvPolynomial (Fin (n / 2)) (wcQuadModelRing A n π ch),
      ∀ p : Fin n, ζ p = if p.val % 2 = 0 then MvPolynomial.C ((Ideal.Quotient.mk (wcQuadModelIdeal A n π ch)) (MvPolynomial.X p))
        else MvPolynomial.X ⟨p.val / 2, by omega⟩ := ⟨_, fun _ => rfl⟩
  obtain ⟨F, hF⟩ : ∃ F : MvPolynomial (Fin (n / 2)) (wcQuadModelRing A n π ch),
      F = MvPolynomial.eval₂ (MvPolynomial.C.comp (algebraMap A (wcQuadModelRing A n π ch))) ζ D' := ⟨_, rfl⟩
  obtain ⟨G, hGd⟩ : ∃ G : Fin (n / 2) → MvPolynomial (Fin (n / 2)) (wcQuadModelRing A n π ch),
      ∀ t, G t = MvPolynomial.eval₂ (MvPolynomial.C.comp (algebraMap A (wcQuadModelRing A n π ch))) ζ
        (MvPolynomial.pderiv (⟨2 * t.val + 1, by omega⟩ : Fin n) D') := ⟨_, fun _ => rfl⟩
  obtain ⟨y, hy⟩ : ∃ y : Fin (n / 2) → (wcQuadModelRing A n π ch),
      ∀ t, y t = (Ideal.Quotient.mk (wcQuadModelIdeal A n π ch)) (MvPolynomial.X (⟨2 * t.val + 1, by omega⟩ : Fin n)) := ⟨_, fun _ => rfl⟩
  obtain ⟨rel, hrel⟩ : ∃ rel : Fin (n / 2) ⊕ Unit → MvPolynomial (Fin (n / 2) ⊕ Unit) (wcQuadModelRing A n π ch),
      rel = Sum.elim (fun t => MvPolynomial.X (Sum.inl t) - MvPolynomial.C (y t) *
        (1 - MvPolynomial.rename Sum.inl F))
      (fun _ => MvPolynomial.X (Sum.inr ()) * ((1 - MvPolynomial.rename Sum.inl F) *
        (1 + ∑ t, MvPolynomial.C (y t) * MvPolynomial.rename Sum.inl (G t))) - 1) := ⟨_, rfl⟩
  have hr1 : ∀ t, rel (Sum.inl t) = MvPolynomial.X (Sum.inl t) - MvPolynomial.C (y t) *
        (1 - MvPolynomial.rename Sum.inl F) := fun t => by rw [hrel, Sum.elim_inl]
  have hr2 : rel (Sum.inr ()) = MvPolynomial.X (Sum.inr ()) * ((1 - MvPolynomial.rename Sum.inl F) *
        (1 + ∑ t, MvPolynomial.C (y t) * MvPolynomial.rename Sum.inl (G t))) - 1 := by rw [hrel, Sum.elim_inr]

  have hevrel1 : ∀ (T : Type u) [CommRing T] (φ : (wcQuadModelRing A n π ch) →+* T) (a : Fin (n / 2) ⊕ Unit → T)
      (t : Fin (n / 2)), MvPolynomial.eval₂ φ a (rel (Sum.inl t)) =
        a (Sum.inl t) - φ (y t) * (1 - MvPolynomial.eval₂ φ (a ∘ Sum.inl) F) := by
    intro T _ φ a t
    rw [hr1]
    simp only [MvPolynomial.eval₂_sub, MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X,
      MvPolynomial.eval₂_C, MvPolynomial.eval₂_one, MvPolynomial.eval₂_rename]
  have hevrel2 : ∀ (T : Type u) [CommRing T] (φ : (wcQuadModelRing A n π ch) →+* T) (a : Fin (n / 2) ⊕ Unit → T),
      MvPolynomial.eval₂ φ a (rel (Sum.inr ())) =
        a (Sum.inr ()) * ((1 - MvPolynomial.eval₂ φ (a ∘ Sum.inl) F) *
          (1 + ∑ t, φ (y t) * MvPolynomial.eval₂ φ (a ∘ Sum.inl) (G t))) - 1 := by
    intro T _ φ a
    rw [hr2]
    simp only [MvPolynomial.eval₂_sub, MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X,
      MvPolynomial.eval₂_C, MvPolynomial.eval₂_one, MvPolynomial.eval₂_rename,
      MvPolynomial.eval₂_add, MvPolynomial.eval₂_sum]

  have hζev : ∀ (T : Type u) [CommRing T] (φ : (wcQuadModelRing A n π ch) →+* T) (a : Fin (n / 2) → T) (p : Fin n),
      MvPolynomial.eval₂ φ a (ζ p) = if p.val % 2 = 0 then φ ((Ideal.Quotient.mk (wcQuadModelIdeal A n π ch)) (MvPolynomial.X p))
        else a ⟨p.val / 2, by omega⟩ := by
    intro T _ φ a p
    rw [hζ p]
    split_ifs <;> simp
  have hcomp : ∀ (T : Type u) [CommRing T] (φ : (wcQuadModelRing A n π ch) →+* T) (a : Fin (n / 2) → T)
      (q : MvPolynomial (Fin n) A),
      MvPolynomial.eval₂ φ a (MvPolynomial.eval₂ (MvPolynomial.C.comp (algebraMap A (wcQuadModelRing A n π ch))) ζ q) =
      MvPolynomial.eval₂ (φ.comp (algebraMap A (wcQuadModelRing A n π ch))) (fun p => MvPolynomial.eval₂ φ a (ζ p)) q := by
    intro T _ φ a q
    induction q using MvPolynomial.induction_on with
    | C r => simp
    | add p q hp hq => simp only [MvPolynomial.eval₂_add, hp, hq]
    | mul_X p i hp => simp only [MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X, hp]

  have hchain : ∀ (t : Fin (n / 2)) (q : MvPolynomial (Fin n) A),
      MvPolynomial.pderiv t (MvPolynomial.eval₂ (MvPolynomial.C.comp (algebraMap A (wcQuadModelRing A n π ch))) ζ q) =
      MvPolynomial.eval₂ (MvPolynomial.C.comp (algebraMap A (wcQuadModelRing A n π ch))) ζ
        (MvPolynomial.pderiv (⟨2 * t.val + 1, by omega⟩ : Fin n) q) := by
    intro t q
    induction q using MvPolynomial.induction_on with
    | C a => simp
    | add p q hp hq => simp only [map_add, MvPolynomial.eval₂_add, hp, hq]
    | mul_X p r hp =>
      rw [MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X, MvPolynomial.pderiv_mul,
        MvPolynomial.pderiv_mul, MvPolynomial.eval₂_add, MvPolynomial.eval₂_mul,
        MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X, hp]
      congr 1
      congr 1
      rw [MvPolynomial.pderiv_X, hζ r]
      split_ifs with hr
      · have hne : r ≠ (⟨2 * t.val + 1, by omega⟩ : Fin n) := by
          intro h
          have h' := congrArg Fin.val h
          simp only [Fin.val_mk] at h'
          omega
        rw [Pi.single_eq_of_ne hne]
        simp
      · by_cases hro : r = (⟨2 * t.val + 1, by omega⟩ : Fin n)
        · subst hro
          rw [Pi.single_eq_same, MvPolynomial.eval₂_one, MvPolynomial.pderiv_X, Pi.single_apply,
            if_pos (Fin.ext (by show (2 * t.val + 1) / 2 = t.val; omega))]
        · rw [Pi.single_eq_of_ne hro, MvPolynomial.eval₂_zero, MvPolynomial.pderiv_X,
            Pi.single_apply, if_neg]
          intro h
          apply hro
          have h' := congrArg Fin.val h
          apply Fin.ext
          revert h'
          show r.val / 2 = t.val → r.val = 2 * t.val + 1
          omega
  have hG : ∀ t, MvPolynomial.pderiv t F = G t := by
    intro t
    rw [hF, hGd]
    exact hchain t D'
  have hEt := s1 (wcQuadModelRing A n π ch) (n / 2) y F G hG rel hr1 hr2

  obtain ⟨v, hv⟩ : ∃ v : Fin (n / 2) → S,
      ∀ t, v t = (algebraMap (wcQuadModelRing A n π c) S) ((Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) (Z (⟨2 * t.val + 1, by omega⟩ : Fin n))) := ⟨_, fun _ => rfl⟩
  have hcr : ∀ r, Ψ ((algebraMap A (wcQuadModelRing A n π ch)) r) = (algebraMap (wcQuadModelRing A n π c) S) ((algebraMap A (wcQuadModelRing A n π c)) r) := fun r => RingHom.congr_fun hc r

  have hS : ∀ q : MvPolynomial (Fin n) A,
      MvPolynomial.eval₂ Ψ v (MvPolynomial.eval₂ (MvPolynomial.C.comp (algebraMap A (wcQuadModelRing A n π ch))) ζ q) =
        (algebraMap (wcQuadModelRing A n π c) S) ((Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) (MvPolynomial.bind₁ Z q)) := by
    intro q
    rw [hcomp]
    have h := MvPolynomial.hom_bind₁ (((algebraMap (wcQuadModelRing A n π c) S)).comp ((Ideal.Quotient.mk (wcQuadModelIdeal A n π c)))) Z q
    rw [RingHom.comp_apply] at h
    rw [h, MvPolynomial.coe_eval₂Hom]
    congr 1
    all_goals try (refine RingHom.ext fun r => ?_
                   rw [RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply]
                   exact hcr r)
    funext p
    rw [hζev, RingHom.comp_apply]
    split_ifs with hp
    · exact ha p hp
    · rw [hv]
      exact congrArg (fun s => (algebraMap (wcQuadModelRing A n π c) S) ((Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) (Z s)))
        (Fin.ext (by show 2 * (p.val / 2) + 1 = p.val; omega))
  have hSF : MvPolynomial.eval₂ Ψ v F = (algebraMap (wcQuadModelRing A n π c) S) ((Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) (MvPolynomial.bind₁ Z D')) := by
    rw [hF]; exact hS D'
  have hSG : ∀ t, MvPolynomial.eval₂ Ψ v (G t) = (algebraMap (wcQuadModelRing A n π c) S) ((Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) (MvPolynomial.bind₁ Z
      (MvPolynomial.pderiv (⟨2 * t.val + 1, by omega⟩ : Fin n) D'))) := by
    intro t; rw [hGd]; exact hS _
  have hW : 1 - MvPolynomial.eval₂ Ψ v F = (algebraMap (wcQuadModelRing A n π c) S) ((Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) w) := by
    rw [hSF, hw, map_sub, map_sub, map_one, map_one]
  have hyv : ∀ t, Ψ (y t) * (algebraMap (wcQuadModelRing A n π c) S) ((Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) w) = v t := by
    intro t
    rw [hy, hv]
    exact hb _ (by show (2 * t.val + 1) % 2 = 1; omega)
  have hU : IsUnit ((algebraMap (wcQuadModelRing A n π c) S) ((Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) g)) := IsLocalization.Away.algebraMap_isUnit _
  obtain ⟨e, he⟩ : ∃ e : S, e = (algebraMap (wcQuadModelRing A n π c) S) ((Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) w) * ↑hU.unit⁻¹ := ⟨_, rfl⟩
  have he1 : e * (algebraMap (wcQuadModelRing A n π c) S) ((Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) u) = 1 := by
    rw [he, mul_right_comm, ← map_mul ((algebraMap (wcQuadModelRing A n π c) S)), ← map_mul ((Ideal.Quotient.mk (wcQuadModelIdeal A n π c))), ← hg, hU.mul_val_inv]
  have heg : e * (algebraMap (wcQuadModelRing A n π c) S) ((Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) g) = (algebraMap (wcQuadModelRing A n π c) S) ((Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) w) := by
    rw [he, mul_assoc, hU.val_inv_mul, mul_one]
  have hWJS : (algebraMap (wcQuadModelRing A n π c) S) ((Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) w) * (1 + ∑ t, Ψ (y t) * MvPolynomial.eval₂ Ψ v (G t)) =
      (algebraMap (wcQuadModelRing A n π c) S) ((Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) u) := by
    rw [hu, map_add, map_add, mul_add, mul_one, map_sum, map_sum, Finset.mul_sum]
    congr 1
    refine Finset.sum_congr rfl fun t _ => ?_
    rw [hSG t, map_mul, map_mul, ← mul_assoc, mul_comm ((algebraMap (wcQuadModelRing A n π c) S) ((Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) w)) (Ψ (y t)), hyv, hv]
  have hx : ∀ j, MvPolynomial.eval₂ Ψ (Sum.elim v fun _ : Unit => e) (rel j) = 0 := by
    rintro (t | ⟨⟩)
    · rw [hevrel1, Sum.elim_comp_inl, Sum.elim_inl, hW, hyv, sub_self]
    · rw [hevrel2, Sum.elim_comp_inl]
      simp only [Sum.elim_inr]
      rw [hW, hWJS, he1, sub_self]

  have hrig : ∀ ω : S →+* S, ω.comp Ψ = Ψ →
      (∀ i : Fin (n / 2) ⊕ Unit, ω (Sum.elim v (fun _ : Unit => e) i) = Sum.elim v (fun _ : Unit => e) i) → ω = RingHom.id S := by
    intro ω hωΨ hωx
    have hωΨ' : ∀ r, ω (Ψ r) = Ψ r := fun r => RingHom.congr_fun hωΨ r
    have hfixZ : ∀ a', ω ((algebraMap (wcQuadModelRing A n π c) S) ((Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) (Z a'))) = (algebraMap (wcQuadModelRing A n π c) S) ((Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) (Z a')) := by
      intro a'
      rcases Nat.mod_two_eq_zero_or_one a'.val with hp | hp
      · rw [← ha a' hp, hωΨ']
      · have e1 : (algebraMap (wcQuadModelRing A n π c) S) ((Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) (Z a')) = v ⟨a'.val / 2, by omega⟩ := by
          rw [hv]
          exact congrArg (fun s => (algebraMap (wcQuadModelRing A n π c) S) ((Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) (Z s)))
            (Fin.ext (by show a'.val = 2 * (a'.val / 2) + 1; omega))
        rw [e1]
        exact hωx (Sum.inl _)
    have hC : ∀ r, ω ((algebraMap (wcQuadModelRing A n π c) S) ((Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) (MvPolynomial.C r))) =
        (algebraMap (wcQuadModelRing A n π c) S) ((Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) (MvPolynomial.C r)) := by
      intro r
      have : (algebraMap (wcQuadModelRing A n π c) S) ((Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) (MvPolynomial.C r)) = Ψ ((algebraMap A (wcQuadModelRing A n π ch)) r) := (hcr r).symm
      rw [this, hωΨ']
    have hXZ : ∀ b, (MvPolynomial.X b : MvPolynomial (Fin n) A) =
        ∑ a', MvPolynomial.C (P b a') * Z a' := by
      intro b
      have hPP : ∀ k, ∑ a', P b a' * P⁻¹ a' k = if b = k then 1 else 0 := by
        intro k
        rw [← Matrix.mul_apply, Matrix.mul_nonsing_inv P hP, Matrix.one_apply]
      symm
      calc ∑ a', MvPolynomial.C (P b a') * Z a'
          = ∑ a', ∑ k, MvPolynomial.C (P b a' * P⁻¹ a' k) * MvPolynomial.X k := by
            refine Finset.sum_congr rfl fun a' _ => ?_
            rw [hZ a', Finset.mul_sum]
            refine Finset.sum_congr rfl fun k _ => ?_
            rw [MvPolynomial.C_mul, mul_assoc]
        _ = ∑ k, MvPolynomial.C (∑ a', P b a' * P⁻¹ a' k) * MvPolynomial.X k := by
            rw [Finset.sum_comm]
            refine Finset.sum_congr rfl fun k _ => ?_
            rw [map_sum, Finset.sum_mul]
        _ = MvPolynomial.X b := by
            simp only [hPP]
            rw [Finset.sum_eq_single b
              (fun k _ hk => by rw [if_neg (Ne.symm hk), map_zero, zero_mul]) (by simp)]
            rw [if_pos rfl, map_one, one_mul]
    apply IsLocalization.ringHom_ext (Submonoid.powers ((Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) g))
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro r
      simp only [RingHom.comp_apply, RingHom.id_apply]
      exact hC r
    · intro b
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hXZ b, map_sum, map_sum, map_sum]
      refine Finset.sum_congr rfl fun a' _ => ?_
      rw [map_mul, map_mul, map_mul, hC, hfixZ]

  have huniv : ∀ (T : Type u) [CommRing T] (φ : (wcQuadModelRing A n π ch) →+* T) (a : Fin (n / 2) ⊕ Unit → T),
      (∀ j, MvPolynomial.eval₂ φ a (rel j) = 0) →
      ∃ ω : S →+* T, ω.comp Ψ = φ ∧ ∀ i : Fin (n / 2) ⊕ Unit, ω (Sum.elim v (fun _ : Unit => e) i) = a i := by
    intro T _ φ a hrel
    obtain ⟨aa, haa⟩ : ∃ aa : Fin (n / 2) → T, aa = a ∘ Sum.inl := ⟨_, rfl⟩
    have haat : ∀ t, a (Sum.inl t) = aa t := fun t => by rw [haa]; rfl
    obtain ⟨ξ, hξ⟩ : ∃ ξ : Fin n → T, ∀ p : Fin n, ξ p = if p.val % 2 = 0 then
        φ ((Ideal.Quotient.mk (wcQuadModelIdeal A n π ch)) (MvPolynomial.X p)) else aa ⟨p.val / 2, by omega⟩ := ⟨_, fun _ => rfl⟩
    have hφζ : ∀ q, MvPolynomial.eval₂ φ aa
        (MvPolynomial.eval₂ (MvPolynomial.C.comp (algebraMap A (wcQuadModelRing A n π ch))) ζ q) =
        MvPolynomial.eval₂ (φ.comp (algebraMap A (wcQuadModelRing A n π ch))) ξ q := by
      intro q
      rw [hcomp]
      congr 1
      funext p
      rw [hζev, hξ]
    have hFT : MvPolynomial.eval₂ φ aa F = MvPolynomial.eval₂ (φ.comp (algebraMap A (wcQuadModelRing A n π ch))) ξ D' := by
      rw [hF, hφζ]
    have hGT : ∀ t, MvPolynomial.eval₂ φ aa (G t) = MvPolynomial.eval₂ (φ.comp (algebraMap A (wcQuadModelRing A n π ch))) ξ
        (MvPolynomial.pderiv (⟨2 * t.val + 1, by omega⟩ : Fin n) D') := by
      intro t; rw [hGd, hφζ]
    have h1 : ∀ t, aa t = φ (y t) * (1 - MvPolynomial.eval₂ (φ.comp (algebraMap A (wcQuadModelRing A n π ch))) ξ D') := by
      intro t
      have h := hrel (Sum.inl t)
      rw [hevrel1, sub_eq_zero, ← haa, haat, hFT] at h
      exact h
    have h2 : a (Sum.inr ()) * ((1 - MvPolynomial.eval₂ (φ.comp (algebraMap A (wcQuadModelRing A n π ch))) ξ D') *
        (1 + ∑ t, φ (y t) * MvPolynomial.eval₂ (φ.comp (algebraMap A (wcQuadModelRing A n π ch))) ξ
          (MvPolynomial.pderiv (⟨2 * t.val + 1, by omega⟩ : Fin n) D'))) = 1 := by
      have h := hrel (Sum.inr ())
      rw [hevrel2, sub_eq_zero, ← haa, hFT] at h
      simp only [hGT] at h
      exact h
    have hξe : ∀ p : Fin n, p.val % 2 = 0 → ξ p = φ ((Ideal.Quotient.mk (wcQuadModelIdeal A n π ch)) (MvPolynomial.X p)) := by
      intro p hp
      rw [hξ, if_pos hp]
    have hξo : ∀ t : Fin (n / 2), ξ (⟨2 * t.val + 1, by omega⟩ : Fin n) = aa t := by
      intro t
      have hc' : ¬ ((⟨2 * t.val + 1, by omega⟩ : Fin n).val % 2 = 0) := by
        show ¬ ((2 * t.val + 1) % 2 = 0); omega
      rw [hξ, if_neg hc']
      exact congrArg aa (Fin.ext (by show (2 * t.val + 1) / 2 = t.val; omega))

    have hQh : (Ideal.Quotient.mk (wcQuadModelIdeal A n π ch)) (∑ t : Fin (n / 2), MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n) *
        MvPolynomial.X (⟨2 * t.val + 1, by omega⟩ : Fin n)) = (algebraMap A (wcQuadModelRing A n π ch)) π := by
      rw [← hH]
      show (Ideal.Quotient.mk (wcQuadModelIdeal A n π ch)) _ = (Ideal.Quotient.mk (wcQuadModelIdeal A n π ch)) (MvPolynomial.C π)
      exact Ideal.Quotient.eq.mpr (Ideal.subset_span (Set.mem_singleton _))
    have hquad : ∑ t : Fin (n / 2), ξ (⟨2 * t.val, by omega⟩ : Fin n) *
        ξ (⟨2 * t.val + 1, by omega⟩ : Fin n) +
        (φ.comp (algebraMap A (wcQuadModelRing A n π ch))) π * MvPolynomial.eval₂ (φ.comp (algebraMap A (wcQuadModelRing A n π ch))) ξ D' = (φ.comp (algebraMap A (wcQuadModelRing A n π ch))) π := by
      have hs : ∑ t : Fin (n / 2), ξ (⟨2 * t.val, by omega⟩ : Fin n) *
          ξ (⟨2 * t.val + 1, by omega⟩ : Fin n) =
          (1 - MvPolynomial.eval₂ (φ.comp (algebraMap A (wcQuadModelRing A n π ch))) ξ D') *
            φ ((Ideal.Quotient.mk (wcQuadModelIdeal A n π ch)) (∑ t : Fin (n / 2), MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n) *
              MvPolynomial.X (⟨2 * t.val + 1, by omega⟩ : Fin n))) := by
        rw [map_sum, map_sum, Finset.mul_sum]
        refine Finset.sum_congr rfl fun t _ => ?_
        rw [hξe ⟨2 * t.val, by omega⟩ (by show (2 * t.val) % 2 = 0; omega), hξo, h1, hy,
          map_mul, map_mul]
        ring
      rw [hs, hQh, RingHom.comp_apply]
      ring

    obtain ⟨ω₀, hω₀⟩ : ∃ ω₀ : MvPolynomial (Fin n) A →+* T, ω₀ = MvPolynomial.eval₂Hom (φ.comp (algebraMap A (wcQuadModelRing A n π ch)))
        (fun b => ∑ p, (φ.comp (algebraMap A (wcQuadModelRing A n π ch))) (P b p) * ξ p) := ⟨_, rfl⟩
    have hω₀C : ∀ r, ω₀ (MvPolynomial.C r) = (φ.comp (algebraMap A (wcQuadModelRing A n π ch))) r := by
      intro r; rw [hω₀, MvPolynomial.eval₂Hom_C]
    have hω₀X : ∀ b, ω₀ (MvPolynomial.X b) = ∑ p, (φ.comp (algebraMap A (wcQuadModelRing A n π ch))) (P b p) * ξ p := by
      intro b; rw [hω₀]; exact MvPolynomial.eval₂_X _ _ _
    have hω₀Z : ∀ a', ω₀ (Z a') = ξ a' := by
      intro a'
      have hPP : ∀ p, ∑ b, P⁻¹ a' b * P b p = if a' = p then 1 else 0 := by
        intro p
        rw [← Matrix.mul_apply, Matrix.nonsing_inv_mul P hP, Matrix.one_apply]
      calc ω₀ (Z a') = ∑ b, ∑ p, (φ.comp (algebraMap A (wcQuadModelRing A n π ch))) (P⁻¹ a' b * P b p) * ξ p := by
            rw [hZ a', map_sum]
            refine Finset.sum_congr rfl fun b _ => ?_
            rw [map_mul, hω₀C, hω₀X, Finset.mul_sum]
            refine Finset.sum_congr rfl fun p _ => ?_
            rw [map_mul, mul_assoc]
        _ = ∑ p, (φ.comp (algebraMap A (wcQuadModelRing A n π ch))) (∑ b, P⁻¹ a' b * P b p) * ξ p := by
            rw [Finset.sum_comm]
            refine Finset.sum_congr rfl fun p _ => ?_
            rw [map_sum, Finset.sum_mul]
        _ = ξ a' := by
            simp only [hPP]
            rw [Finset.sum_eq_single a'
              (fun p _ hp => by rw [if_neg (Ne.symm hp), map_zero, zero_mul]) (by simp)]
            rw [if_pos rfl, map_one, one_mul]
    have hω₀b : ∀ q, ω₀ (MvPolynomial.bind₁ Z q) = MvPolynomial.eval₂ (φ.comp (algebraMap A (wcQuadModelRing A n π ch))) ξ q := by
      intro q
      rw [MvPolynomial.hom_bind₁, MvPolynomial.coe_eval₂Hom]
      congr 1
      · refine RingHom.ext fun r => ?_
        show ω₀ (MvPolynomial.C r) = _
        rw [hω₀C]
      · funext i
        exact hω₀Z i
    have hker : ω₀ ((∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q :
        MvPolynomial (Fin n) A) - MvPolynomial.C π) = 0 := by
      rw [hQ]
      simp only [map_sub, map_add, map_sum, map_mul, hω₀C, hω₀b, hω₀Z]
      linear_combination hquad
    let ω₁ : (wcQuadModelRing A n π c) →+* T := Ideal.Quotient.lift (wcQuadModelIdeal A n π c) ω₀ (by
      intro z hz
      obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hz
      rw [map_mul, hker, mul_zero])
    have hω₁ : ∀ q, ω₁ ((Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) q) = ω₀ q := fun q => Ideal.Quotient.lift_mk _ _ _

    have hω₁w : ω₁ ((Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) w) = 1 - MvPolynomial.eval₂ (φ.comp (algebraMap A (wcQuadModelRing A n π ch))) ξ D' := by
      rw [hω₁, hw, map_sub, map_one, hω₀b]
    have hω₁u : ω₁ ((Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) u) = (1 - MvPolynomial.eval₂ (φ.comp (algebraMap A (wcQuadModelRing A n π ch))) ξ D') *
        (1 + ∑ t, φ (y t) * MvPolynomial.eval₂ (φ.comp (algebraMap A (wcQuadModelRing A n π ch))) ξ
          (MvPolynomial.pderiv (⟨2 * t.val + 1, by omega⟩ : Fin n) D')) := by
      rw [hω₁, hu, hw, map_add, map_sub, map_one, hω₀b, map_sum, mul_add, mul_one, Finset.mul_sum]
      congr 1
      refine Finset.sum_congr rfl fun t _ => ?_
      rw [map_mul, hω₀Z, hω₀b, hξo, h1]
      ring
    have hω₁g : ω₁ ((Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) g) = (1 - MvPolynomial.eval₂ (φ.comp (algebraMap A (wcQuadModelRing A n π ch))) ξ D') *
        ((1 - MvPolynomial.eval₂ (φ.comp (algebraMap A (wcQuadModelRing A n π ch))) ξ D') *
        (1 + ∑ t, φ (y t) * MvPolynomial.eval₂ (φ.comp (algebraMap A (wcQuadModelRing A n π ch))) ξ
          (MvPolynomial.pderiv (⟨2 * t.val + 1, by omega⟩ : Fin n) D'))) := by
      rw [hg, map_mul, map_mul, hω₁w, hω₁u]
    have hWJu : IsUnit ((1 - MvPolynomial.eval₂ (φ.comp (algebraMap A (wcQuadModelRing A n π ch))) ξ D') *
        (1 + ∑ t, φ (y t) * MvPolynomial.eval₂ (φ.comp (algebraMap A (wcQuadModelRing A n π ch))) ξ
          (MvPolynomial.pderiv (⟨2 * t.val + 1, by omega⟩ : Fin n) D'))) :=
      IsUnit.of_mul_eq_one (a (Sum.inr ())) (by linear_combination h2)
    have hWu : IsUnit (1 - MvPolynomial.eval₂ (φ.comp (algebraMap A (wcQuadModelRing A n π ch))) ξ D') := isUnit_of_mul_isUnit_left hWJu
    have hgu : IsUnit (ω₁ ((Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) g)) := by
      rw [hω₁g]; exact hWu.mul hWJu
    let ω : S →+* T := IsLocalization.Away.lift ((Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) g) hgu
    have hωι : ∀ z, ω ((algebraMap (wcQuadModelRing A n π c) S) z) = ω₁ z := fun z => IsLocalization.Away.lift_eq _ hgu z
    refine ⟨ω, ?_, ?_⟩
    · apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro r
        simp only [RingHom.comp_apply]
        have e1 : Ψ ((Ideal.Quotient.mk (wcQuadModelIdeal A n π ch)) (MvPolynomial.C r)) = (algebraMap (wcQuadModelRing A n π c) S) ((Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) (MvPolynomial.C r)) :=
          hcr r
        rw [e1, hωι, hω₁, hω₀C] <;> rfl
      · intro p
        simp only [RingHom.comp_apply]
        rcases Nat.mod_two_eq_zero_or_one p.val with hp | hp
        · rw [ha p hp, hωι, hω₁, hω₀Z, hξe p hp]
        · have hbp := congrArg ω (hb p hp)
          rw [map_mul, hωι, hωι, hω₁w, hω₁, hω₀Z] at hbp
          have hξp : ξ p = φ ((Ideal.Quotient.mk (wcQuadModelIdeal A n π ch)) (MvPolynomial.X p)) *
              (1 - MvPolynomial.eval₂ (φ.comp (algebraMap A (wcQuadModelRing A n π ch))) ξ D') := by
            rw [hξ, if_neg (show ¬ (p.val % 2 = 0) by omega), h1, hy]
            exact congrArg (fun s => φ ((Ideal.Quotient.mk (wcQuadModelIdeal A n π ch)) (MvPolynomial.X s)) *
              (1 - MvPolynomial.eval₂ (φ.comp (algebraMap A (wcQuadModelRing A n π ch))) ξ D'))
              (Fin.ext (by show 2 * (p.val / 2) + 1 = p.val; omega))
          rw [hξp] at hbp
          exact hWu.mul_right_cancel hbp
    · rintro (t | ⟨⟩)
      · simp only [Sum.elim_inl]
        rw [hv, hωι, hω₁, hω₀Z, hξo, haat]
      · simp only [Sum.elim_inr]
        have hee := congrArg ω heg
        rw [map_mul, hωι, hωι, hω₁g, hω₁w] at hee
        apply hWu.mul_right_cancel
        linear_combination (-(ω e * (1 - MvPolynomial.eval₂ (φ.comp (algebraMap A (wcQuadModelRing A n π ch))) ξ D'))) * h2 +
          (a (Sum.inr ())) * hee
  exact s2 (wcQuadModelRing A n π ch) S Ψ (Fin (n / 2) ⊕ Unit) rel hEt (Sum.elim v fun _ : Unit => e) hx huniv hrig

theorem wc_pmhpi_hyp_recoord (A : Type u) [CommRing A] (n : ℕ) (hnm : n = 2 * (n / 2)) (π : A)
    (c P : Matrix (Fin n) (Fin n) A) (D' : MvPolynomial (Fin n) A)
    (hP : IsUnit P.det) (hD' : MvPolynomial.constantCoeff D' = 0)
    (hhyp : (∑ p, ∑ q, MvPolynomial.C (c p q) *
          (∑ a, MvPolynomial.C (P p a) * MvPolynomial.X a) *
          (∑ b, MvPolynomial.C (P q b) * MvPolynomial.X b) : MvPolynomial (Fin n) A) =
        ∑ t : Fin (n / 2), MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n) *
          MvPolynomial.X (⟨2 * t.val + 1, by omega⟩ : Fin n) + MvPolynomial.C π * D')
    (B : Type u) [CommRing B] [IsLocalRing B] (β : wcQuadModelRing A n π c →+* B)
    (hβ : WeaklyEtale (Spec.map (CommRingCat.ofHom β)))
    (hβX : ∀ p, β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) ∈
      IsLocalRing.maximalIdeal B) :
    ∃ β' : wcQuadModelRing A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0) →+* B,
      WeaklyEtale (Spec.map (CommRingCat.ofHom β')) ∧
      β'.comp (algebraMap A (wcQuadModelRing A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))) =
        β.comp (algebraMap A (wcQuadModelRing A n π c)) ∧
      (∀ p, β' (Ideal.Quotient.mk (wcQuadModelIdeal A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))
          (MvPolynomial.X p)) ∈ IsLocalRing.maximalIdeal B) ∧
      ∀ t : Fin (n / 2), β' (Ideal.Quotient.mk (wcQuadModelIdeal A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))
          (MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n))) =
        β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (∑ a, MvPolynomial.C (P⁻¹ (⟨2 * t.val, by omega⟩ : Fin n) a) * MvPolynomial.X a)) :=
by
  classical

  obtain ⟨Z, hZ⟩ : ∃ Z : Fin n → MvPolynomial (Fin n) A,
      ∀ a, Z a = ∑ b, MvPolynomial.C (P⁻¹ a b) * MvPolynomial.X b := ⟨_, fun _ => rfl⟩
  have hZfun : Z = fun a => ∑ b, MvPolynomial.C (P⁻¹ a b) * MvPolynomial.X b := funext hZ
  obtain ⟨w, hw⟩ : ∃ w : MvPolynomial (Fin n) A, w = 1 - MvPolynomial.bind₁ Z D' := ⟨_, rfl⟩
  obtain ⟨u, hu⟩ : ∃ u : MvPolynomial (Fin n) A, u = w + ∑ t : Fin (n / 2),
      Z ⟨2 * t.val + 1, by omega⟩ *
        MvPolynomial.bind₁ Z (MvPolynomial.pderiv (⟨2 * t.val + 1, by omega⟩ : Fin n) D') :=
    ⟨_, rfl⟩
  obtain ⟨g, hg⟩ : ∃ g : MvPolynomial (Fin n) A, g = w * u := ⟨_, rfl⟩
  have hQ : (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q :
        MvPolynomial (Fin n) A) =
      ∑ t : Fin (n / 2), Z ⟨2 * t.val, by omega⟩ * Z ⟨2 * t.val + 1, by omega⟩ +
        MvPolynomial.C π * MvPolynomial.bind₁ Z D' := by
    rw [hZfun]
    exact wc_hyprc_model_identity A n hnm π c P D' hP hhyp
  have hH := wc_hyprc_hyp_form A n hnm

  obtain ⟨Ψ, hΨc, hΨa, hΨb⟩ := wc_hyprc_psi_exists A n hnm π c
    (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0)
    D' Z w u g hw hg hQ hH
    (Localization.Away (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) g))
  have hΨet : Ψ.Etale := wc_hyprc_psi_etale A n hnm π c
    (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0)
    P D' hP Z w u g hZ hw hu hg hQ hH
    (Localization.Away (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) g)) Ψ hΨc hΨa hΨb

  have hZm : ∀ a, β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (Z a)) ∈
      IsLocalRing.maximalIdeal B := by
    intro a
    rw [hZ a, map_sum, map_sum]
    refine Ideal.sum_mem _ (fun b _ => ?_)
    rw [map_mul, map_mul]
    exact Ideal.mul_mem_left _ _ (hβX b)

  have hbind : ∀ q : MvPolynomial (Fin n) A,
      β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.bind₁ Z q)) -
        β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (MvPolynomial.C (MvPolynomial.constantCoeff q))) ∈ IsLocalRing.maximalIdeal B := by
    intro q
    induction q using MvPolynomial.induction_on
    · rename_i a
      rw [MvPolynomial.bind₁_C_right, MvPolynomial.constantCoeff_C, sub_self]
      exact Ideal.zero_mem _
    · rename_i p q hp hq
      have e : ∀ x y z v : B, x + y - (z + v) = (x - z) + (y - v) := fun x y z v => by ring
      simp only [map_add]
      rw [e]
      exact Ideal.add_mem _ hp hq
    · rename_i p i _
      simp only [map_mul, MvPolynomial.bind₁_X_right, MvPolynomial.constantCoeff_X, mul_zero,
        map_zero, sub_zero]
      exact Ideal.mul_mem_left _ _ (hZm i)
  have hD'm : β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.bind₁ Z D')) ∈
      IsLocalRing.maximalIdeal B := by
    have h := hbind D'
    rwa [hD', map_zero, map_zero, map_zero, sub_zero] at h

  have hwU : IsUnit (β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) w)) := by
    rw [← IsLocalRing.notMem_maximalIdeal]
    intro h
    have h1 := Ideal.add_mem _ h hD'm
    rw [← map_add, ← map_add, hw, sub_add_cancel, map_one, map_one] at h1
    exact (IsLocalRing.maximalIdeal.isMaximal B).ne_top ((Ideal.eq_top_iff_one _).mpr h1)
  have huw : β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) u) -
      β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) w) ∈ IsLocalRing.maximalIdeal B := by
    rw [hu, map_add, map_add, add_sub_cancel_left, map_sum, map_sum]
    refine Ideal.sum_mem _ (fun t _ => ?_)
    rw [map_mul, map_mul]
    exact Ideal.mul_mem_right _ _ (hZm _)
  have huU : IsUnit (β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) u)) := by
    rw [← IsLocalRing.notMem_maximalIdeal]
    intro h
    have h1 := Ideal.sub_mem _ h huw
    rw [sub_sub_cancel] at h1
    exact (IsLocalRing.notMem_maximalIdeal.mpr hwU) h1
  have hgU : IsUnit (β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) g)) := by
    rw [hg, map_mul, map_mul]
    exact hwU.mul huU

  obtain ⟨βt, hlift⟩ : ∃ βt : Localization.Away (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) g)
      →+* B, βt.comp (algebraMap (wcQuadModelRing A n π c)
        (Localization.Away (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) g))) = β :=
    ⟨IsLocalization.Away.lift (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) g) hgU,
      IsLocalization.lift_comp _⟩
  have hβtι : ∀ x, βt (algebraMap (wcQuadModelRing A n π c)
      (Localization.Away (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) g)) x) = β x := by
    intro x
    rw [← RingHom.comp_apply, hlift]

  have hW1 : WeaklyEtale (Spec.map (CommRingCat.ofHom βt) ≫
      Spec.map (CommRingCat.ofHom (algebraMap (wcQuadModelRing A n π c)
        (Localization.Away (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) g))))) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hlift]
    exact hβ
  haveI := hW1
  haveI hW2 : WeaklyEtale (Spec.map (CommRingCat.ofHom βt)) :=
    WeaklyEtale.of_comp _ (Spec.map (CommRingCat.ofHom (algebraMap (wcQuadModelRing A n π c)
        (Localization.Away (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) g)))))
  haveI hΨE : AlgebraicGeometry.Etale (Spec.map (CommRingCat.ofHom Ψ)) :=
    (HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hΨet
  refine ⟨βt.comp Ψ, ?_, ?_, ?_, ?_⟩
  · rw [CommRingCat.ofHom_comp, Spec.map_comp]
    infer_instance
  · rw [RingHom.comp_assoc, hΨc, ← RingHom.comp_assoc, hlift]
  · intro p
    rw [RingHom.comp_apply]
    rcases Nat.mod_two_eq_zero_or_one p.val with hp | hp
    · rw [hΨa p hp, hβtι]
      exact hZm p
    · have h1 := congrArg βt (hΨb p hp)
      rw [map_mul, hβtι, hβtι] at h1
      have h2 : βt (Ψ (Ideal.Quotient.mk (wcQuadModelIdeal A n π
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))
            (MvPolynomial.X p))) * β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) w) ∈
          IsLocalRing.maximalIdeal B := by
        rw [h1]; exact hZm p
      exact (Ideal.mul_unit_mem_iff_mem _ hwU).mp h2
  · intro t
    rw [RingHom.comp_apply, hΨa _ (by show (2 * t.val) % 2 = 0; omega), hβtι, hZ]

theorem wc_pmhpi_fm_model_square (F' F'' : Type u) [Field F'] [Field F'']
    [Finite F''] [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V₀ : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom (D.S i) ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom (D.S i))
    (Ω : (wcP1Over F'').left.ProEt) (a₀ : Ω ⟶ V₀)
    (L : Type u) [Field L] [IsSepClosed L] (eΩ : Ω.left ≅ Spec (.of L))
    (hΩ : ∀ (z : Ω.left) (j : Fin D.m), Ω.hom z ≠ D.S j (IsLocalRing.closedPoint F''))
    (xb : ((wcProEtPullback D.f).obj V₀).left)
    (hxb : ((wcProEtPullback D.f).obj V₀).hom xb = D.xs i (IsLocalRing.closedPoint F''))
    (Th : D.Yt.left.ProEt) (g : Th ⟶ (wcProEtPullback D.f).obj V₀)
    (B : Type u) [CommRing B] [IsNoetherianRing B] [HenselianLocalRing B]
    [IsSepClosed (IsLocalRing.ResidueField B)] (eB : Th.left ≅ Spec (.of B))
    (hpre : g.left ⁻¹' {xb} = {eB.inv (IsLocalRing.closedPoint B)})
    (hfib : IsIso (Limits.pullback.snd g.left
      (((wcProEtPullback D.f).obj V₀).left.fromSpecResidueField xb)))
    (Fm : D.Yt.left.ProEt) (rW : Fm ⟶ (wcProEtPullback D.f).obj Ω) (rT : Fm ⟶ Th)
    (hsq : rT ≫ g = rW ≫ (wcProEtPullback D.f).map a₀)
    (hpb : IsPullback rT.left rW.left g.left ((wcProEtPullback D.f).map a₀).left)
    (Tη : D.Yt.left.ProEt) (j : Tη ⟶ Th) (hj : IsOpenImmersion j.left)
    (hrange : Set.range j.left = {z | D.f (Th.hom z) ≠ D.S i (IsLocalRing.closedPoint F'')})
    (ρ : Fm ⟶ Tη) (hρ : ρ ≫ j = rT) (hnm : n = 2 * (n / 2))
    (K : Type u) [Field K] [IsAlgClosed K] (ι : K →+* A) (π : A)
    (c : Matrix (Fin n) (Fin n) A) (β : wcQuadModelRing A n π c →+* B)
    (P : Matrix (Fin n) (Fin n) A) (D' : MvPolynomial (Fin n) A)
    (U₀ : (Spec (.of (MvPolynomial (Fin (n / 2)) K))).Opens)
    (ψ : Tη.left ⟶ (U₀ : Scheme.{u}))
    (hι : Function.Bijective ((IsLocalRing.residue A).comp ι)) (hℓK : ((ℓ : ℕ) : K) ≠ 0)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    (hβ : WeaklyEtale (Spec.map (CommRingCat.ofHom β)))
    (hβX : ∀ p, β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) ∈
      IsLocalRing.maximalIdeal B)
    (hβA : eB.inv ≫ g.left ≫ Limits.pullback.fst V₀.hom D.f ≫ e.hom =
      Spec.map (CommRingCat.ofHom (β.comp (algebraMap A (wcQuadModelRing A n π c)))))
    (hP : IsUnit P.det) (hD' : MvPolynomial.constantCoeff D' = 0)
    (hhyp : (∑ p, ∑ q, MvPolynomial.C (c p q) *
          (∑ a, MvPolynomial.C (P p a) * MvPolynomial.X a) *
          (∑ b, MvPolynomial.C (P q b) * MvPolynomial.X b) : MvPolynomial (Fin n) A) =
        ∑ t : Fin (n / 2), MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n) *
          MvPolynomial.X (⟨2 * t.val + 1, by omega⟩ : Fin n) + MvPolynomial.C π * D')
    (hU₀ : (U₀ : Set (Spec (.of (MvPolynomial (Fin (n / 2)) K)))) =
        (Set.range (Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin (n / 2)) K →+* K))))ᶜ)
    (hψ : ψ ≫ U₀.ι = j.left ≫ eB.hom ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.eval₂Hom
        ((β.comp (algebraMap A (wcQuadModelRing A n π c))).comp ι)
        (fun t : Fin (n / 2) => β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (∑ a, MvPolynomial.C (P⁻¹ (⟨2 * t.val, by omega⟩ : Fin n) a) *
            MvPolynomial.X a))))))
    (lam : A →+* L) (hlam : Spec.map (CommRingCat.ofHom lam) = eΩ.inv ≫ a₀.left ≫ e.hom)
    (hlamπ : lam π ≠ 0)
    (e' : Spec (.of (wcQuadModelRing L n (lam π)
      (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0)))
        ⟶ (U₀ : Scheme.{u}))
    (he' : e' ≫ U₀.ι = Spec.map (CommRingCat.ofHom (MvPolynomial.eval₂Hom
        ((algebraMap L (wcQuadModelRing L n (lam π)
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))).comp
            (lam.comp ι))
        (fun t : Fin (n / 2) => Ideal.Quotient.mk (wcQuadModelIdeal L n (lam π)
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
          (MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n))))))
    (β' : wcQuadModelRing A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0) →+* B)
    (hβ'A : β'.comp (algebraMap A (wcQuadModelRing A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))) =
        β.comp (algebraMap A (wcQuadModelRing A n π c)))
    (hβ'Z : ∀ t : Fin (n / 2), β' (Ideal.Quotient.mk (wcQuadModelIdeal A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))
          (MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n))) =
        β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (∑ a, MvPolynomial.C (P⁻¹ (⟨2 * t.val, by omega⟩ : Fin n) a) * MvPolynomial.X a))) :
    IsPullback (rT.left ≫ eB.hom) (rW.left ≫ Limits.pullback.fst Ω.hom D.f ≫ eΩ.hom)
      (Spec.map (CommRingCat.ofHom (β'.comp (algebraMap A (wcQuadModelRing A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))))))
      (Spec.map (CommRingCat.ofHom lam)) ∧
    ∃ h₀ : Fm.left ⟶ Spec (.of (wcQuadModelRing L n (lam π)
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))),
      h₀ ≫ Spec.map (CommRingCat.ofHom (wcHypBaseMap lam n π)) =
        (rT.left ≫ eB.hom) ≫ Spec.map (CommRingCat.ofHom β') ∧
      h₀ ≫ Spec.map (CommRingCat.ofHom (algebraMap L (wcQuadModelRing L n (lam π)
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0)))) =
        rW.left ≫ Limits.pullback.fst Ω.hom D.f ≫ eΩ.hom ∧
      h₀ ≫ e' = ρ.left ≫ ψ :=
by
  classical

  have hpaste : IsPullback rT.left (rW.left ≫ Limits.pullback.fst Ω.hom D.f)
      (g.left ≫ Limits.pullback.fst V₀.hom D.f) a₀.left := by
    have hw : a₀.left ≫ V₀.hom = Ω.hom := MorphismProperty.Over.w a₀
    have h1 : ((wcProEtPullback D.f).map a₀).left ≫ Limits.pullback.fst V₀.hom D.f =
        Limits.pullback.fst Ω.hom D.f ≫ a₀.left := Limits.pullback.lift_fst _ _ _
    have h2 : ((wcProEtPullback D.f).map a₀).left ≫ Limits.pullback.snd V₀.hom D.f =
        Limits.pullback.snd Ω.hom D.f := MorphismProperty.Over.w ((wcProEtPullback D.f).map a₀)
    have hsq : IsPullback ((wcProEtPullback D.f).map a₀).left (Limits.pullback.fst Ω.hom D.f)
        (Limits.pullback.fst V₀.hom D.f) a₀.left := by
      refine IsPullback.of_right (h₁₂ := Limits.pullback.snd V₀.hom D.f) (v₁₃ := D.f)
        (h₂₂ := V₀.hom) ?_ h1 (IsPullback.of_hasPullback V₀.hom D.f).flip
      have e : ∀ (x : Limits.pullback Ω.hom D.f ⟶ D.Yt.left) (z : Ω.left ⟶ (wcP1Over F'').left),
          x = Limits.pullback.snd Ω.hom D.f → z = Ω.hom →
          IsPullback x (Limits.pullback.fst Ω.hom D.f) D.f z := by
        rintro _ _ rfl rfl
        exact (IsPullback.of_hasPullback Ω.hom D.f).flip
      exact e _ _ h2 hw
    exact hpb.paste_vert hsq
  have hI : IsPullback (rT.left ≫ eB.hom) (rW.left ≫ Limits.pullback.fst Ω.hom D.f ≫ eΩ.hom)
      (Spec.map (CommRingCat.ofHom (β'.comp (algebraMap A (wcQuadModelRing A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))))))
      (Spec.map (CommRingCat.ofHom lam)) := by
    refine IsPullback.of_iso hpaste (Iso.refl _) eB eΩ e ?_ ?_ ?_ ?_
    · simp
    · simp only [Iso.refl_hom, Category.id_comp]
      exact Category.assoc _ _ _
    · rw [hβ'A, ← hβA, Iso.hom_inv_id_assoc]
      exact Category.assoc _ _ _
    · rw [hlam]
      simp

  have hκ : ∀ x, wcHypBaseMap lam n π (Ideal.Quotient.mk _ x) =
      Ideal.Quotient.mk _ (MvPolynomial.map lam x) := fun x => Ideal.quotientMap_mk
  have hαA : ∀ a : A, algebraMap A (wcQuadModelRing A n π
      (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0)) a =
      Ideal.Quotient.mk _ (MvPolynomial.C a) := fun a => by
    rw [← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq]
  have hαL : ∀ a : L, algebraMap L (wcQuadModelRing L n (lam π)
      (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0)) a =
      Ideal.Quotient.mk _ (MvPolynomial.C a) := fun a => by
    rw [← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq]
  have hPO : IsPushout
      (CommRingCat.ofHom (algebraMap A (wcQuadModelRing A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))))
      (CommRingCat.ofHom lam)
      (CommRingCat.ofHom (wcHypBaseMap lam n π))
      (CommRingCat.ofHom (algebraMap L (wcQuadModelRing L n (lam π)
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0)))) := by
    have heq : CommRingCat.ofHom (algebraMap A (wcQuadModelRing A n π
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))) ≫
          CommRingCat.ofHom (wcHypBaseMap lam n π) =
        CommRingCat.ofHom lam ≫ CommRingCat.ofHom (algebraMap L (wcQuadModelRing L n (lam π)
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))) := by
      ext a
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
      rw [hαA, hαL, hκ, MvPolynomial.map_C]
    have hGen : MvPolynomial.map lam (∑ p : Fin n, ∑ q : Fin n,
        MvPolynomial.C ((Matrix.of fun p q : Fin n =>
          if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0) p q) *
          MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C π) =
        ∑ p : Fin n, ∑ q : Fin n,
        MvPolynomial.C ((Matrix.of fun p q : Fin n =>
          if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0) p q) *
          MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C (lam π) := by
      simp only [map_sub, map_sum, map_mul, MvPolynomial.map_C, MvPolynomial.map_X, Matrix.of_apply,
        apply_ite lam, map_one, map_zero]
    have key : ∀ (T : Type u) [CommRing T] (φ : wcQuadModelRing A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0) →+* T)
        (χ : L →+* T), (∀ a, φ (algebraMap A _ a) = χ (lam a)) →
        (MvPolynomial.eval₂Hom χ (fun p => φ (Ideal.Quotient.mk _ (MvPolynomial.X p)))).comp
          (MvPolynomial.map lam) = φ.comp (Ideal.Quotient.mk _) := by
      intro T _ φ χ hc
      apply MvPolynomial.ringHom_ext
      · intro r
        simp only [RingHom.comp_apply, MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
        rw [← hαA, hc]
      · intro p
        simp only [RingHom.comp_apply, MvPolynomial.map_X, MvPolynomial.eval₂Hom_X']
    have hΨ : ∀ (T : Type u) [CommRing T] (φ : wcQuadModelRing A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0) →+* T)
        (χ : L →+* T), (∀ a, φ (algebraMap A _ a) = χ (lam a)) →
        ∀ a ∈ wcQuadModelIdeal L n (lam π)
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0),
        MvPolynomial.eval₂Hom χ (fun p => φ (Ideal.Quotient.mk _ (MvPolynomial.X p))) a = 0 := by
      intro T _ φ χ hc a ha
      obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      rw [map_mul, ← hGen, ← RingHom.comp_apply, key T φ χ hc, RingHom.comp_apply,
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _)), map_zero,
        mul_zero]
    have hc : ∀ (s : Limits.PushoutCocone (CommRingCat.ofHom (algebraMap A (wcQuadModelRing A n π
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))))
        (CommRingCat.ofHom lam)) (a : A),
        s.inl.hom (algebraMap A _ a) = s.inr.hom (lam a) := by
      intro s a
      have := congrArg (fun φ => φ.hom a) s.condition
      simpa only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply] using this
    refine IsPushout.of_isColimit' ⟨heq⟩ (Limits.PushoutCocone.IsColimit.mk heq
      (fun s => CommRingCat.ofHom (Ideal.Quotient.lift _
        (MvPolynomial.eval₂Hom s.inr.hom
          (fun p => s.inl.hom (Ideal.Quotient.mk _ (MvPolynomial.X p))))
        (hΨ _ s.inl.hom s.inr.hom (hc s)))) ?_ ?_ ?_)
    · intro s
      apply CommRingCat.hom_ext
      apply Ideal.Quotient.ringHom_ext
      refine RingHom.ext fun x => ?_
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply, hκ,
        Ideal.Quotient.lift_mk]
      exact RingHom.congr_fun (key _ s.inl.hom s.inr.hom (hc s)) x
    · intro s
      apply CommRingCat.hom_ext
      refine RingHom.ext fun l => ?_
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
      rw [hαL, Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C]
    · intro s m h1 h2
      apply CommRingCat.hom_ext
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro r
        simp only [RingHom.comp_apply, CommRingCat.hom_ofHom, Ideal.Quotient.lift_mk,
          MvPolynomial.eval₂Hom_C]
        rw [← hαL, ← h2]
        rfl
      · intro p
        simp only [RingHom.comp_apply, CommRingCat.hom_ofHom, Ideal.Quotient.lift_mk,
          MvPolynomial.eval₂Hom_X']
        rw [← h1]
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply, hκ,
          MvPolynomial.map_X]
  have PB := isPullback_SpecMap_of_isPushout _ _ _ _ hPO
  have hw : (rT.left ≫ eB.hom ≫ Spec.map (CommRingCat.ofHom β')) ≫
      Spec.map (CommRingCat.ofHom (algebraMap A (wcQuadModelRing A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0)))) =
      (rW.left ≫ Limits.pullback.fst Ω.hom D.f ≫ eΩ.hom) ≫ Spec.map (CommRingCat.ofHom lam) := by
    rw [← hI.w]
    simp only [Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp]

  have hΦL : CommRingCat.ofHom (MvPolynomial.eval₂Hom
        ((algebraMap L (wcQuadModelRing L n (lam π)
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))).comp
            (lam.comp ι))
        (fun t : Fin (n / 2) => Ideal.Quotient.mk (wcQuadModelIdeal L n (lam π)
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
          (MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n)))) =
      CommRingCat.ofHom (MvPolynomial.eval₂Hom
        ((algebraMap A (wcQuadModelRing A n π
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))).comp ι)
        (fun t : Fin (n / 2) => Ideal.Quotient.mk (wcQuadModelIdeal A n π
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))
          (MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n)))) ≫
        CommRingCat.ofHom (wcHypBaseMap lam n π) := by
    rw [← CommRingCat.ofHom_comp]
    congr 1
    apply MvPolynomial.ringHom_ext
    · intro k
      simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_C]
      rw [hαA, hαL, hκ, MvPolynomial.map_C]
    · intro t
      simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_X']
      rw [hκ, MvPolynomial.map_X]
  have hΦB : CommRingCat.ofHom (MvPolynomial.eval₂Hom
        ((β.comp (algebraMap A (wcQuadModelRing A n π c))).comp ι)
        (fun t : Fin (n / 2) => β (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (∑ a, MvPolynomial.C (P⁻¹ (⟨2 * t.val, by omega⟩ : Fin n) a) *
            MvPolynomial.X a)))) =
      CommRingCat.ofHom (MvPolynomial.eval₂Hom
        ((algebraMap A (wcQuadModelRing A n π
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))).comp ι)
        (fun t : Fin (n / 2) => Ideal.Quotient.mk (wcQuadModelIdeal A n π
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))
          (MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n)))) ≫
        CommRingCat.ofHom β' := by
    rw [← CommRingCat.ofHom_comp]
    congr 1
    apply MvPolynomial.ringHom_ext
    · intro k
      simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_C]
      exact (RingHom.congr_fun hβ'A (ι k)).symm
    · intro t
      simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_X']
      exact (hβ'Z t).symm
  have hρj : ρ.left ≫ j.left = rT.left := by
    rw [← hρ]
    rfl
  refine ⟨hI, PB.lift (rT.left ≫ eB.hom ≫ Spec.map (CommRingCat.ofHom β'))
    (rW.left ≫ Limits.pullback.fst Ω.hom D.f ≫ eΩ.hom) hw, ?_, ?_, ?_⟩
  · rw [PB.lift_fst, Category.assoc]
  · exact PB.lift_snd _ _ _
  · rw [← cancel_mono U₀.ι]
    simp only [Category.assoc]
    rw [he', hψ, hΦL, hΦB, Spec.map_comp, Spec.map_comp, PB.lift_fst_assoc, ← hρj]
    simp only [Category.assoc]

theorem wc_hmtg_base_dvr (A : Type u) [CommRing A] [HenselianLocalRing A]
    (π : A) (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    (n : ℕ) (hnm : n = 2 * (n / 2)) (hn2 : 2 ≤ n)
    (B : Type u) [CommRing B] [IsNoetherianRing B] [HenselianLocalRing B]
    (β' : wcQuadModelRing A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0) →+* B)
    (hβ' : WeaklyEtale (Spec.map (CommRingCat.ofHom β')))
    (hβ'X : ∀ p, β' (Ideal.Quotient.mk (wcQuadModelIdeal A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))
          (MvPolynomial.X p)) ∈ IsLocalRing.maximalIdeal B)
    (L : Type u) [Field L] (lam : A →+* L) (hlamπ : lam π ≠ 0) :
    ∃ _ : IsDomain A, IsDiscreteValuationRing A :=
by
  classical

  have s1 : ∀ k : ℕ, Module.Flat A (wcQuadModelRing A (k + 2) π
      (Matrix.of fun p q : Fin (k + 2) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0)) := by
    intro k
    set c : Matrix (Fin (k + 2)) (Fin (k + 2)) A :=
      Matrix.of fun p q : Fin (k + 2) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0
      with hc
    set S := MvPolynomial (Fin (k + 1)) A
    let σ : MvPolynomial (Fin (k + 2)) A →ₐ[A] MvPolynomial (Fin (k + 2)) A :=
      MvPolynomial.aeval (fun i => if i = 1 then MvPolynomial.X 1 + MvPolynomial.X 0
        else MvPolynomial.X i)
    let τ : MvPolynomial (Fin (k + 2)) A →ₐ[A] MvPolynomial (Fin (k + 2)) A :=
      MvPolynomial.aeval (fun i => if i = 1 then MvPolynomial.X 1 - MvPolynomial.X 0
        else MvPolynomial.X i)
    have h01 : (0 : Fin (k + 2)) ≠ 1 := by
      intro h; have := congrArg Fin.val h; simp at this
    have hστ : σ.comp τ = AlgHom.id A _ := by
      apply MvPolynomial.algHom_ext
      intro i
      by_cases hi : i = 1
      · subst hi; simp [σ, τ]
      · simp [σ, τ, hi]
    have hτσ : τ.comp σ = AlgHom.id A _ := by
      apply MvPolynomial.algHom_ext
      intro i
      by_cases hi : i = 1
      · subst hi; simp [σ, τ]
      · simp [σ, τ, hi]
    let σe : MvPolynomial (Fin (k + 2)) A ≃ₐ[A] MvPolynomial (Fin (k + 2)) A :=
      AlgEquiv.ofAlgHom σ τ hστ hτσ
    let ψ : MvPolynomial (Fin (k + 2)) A ≃ₐ[A] Polynomial S :=
      σe.trans (MvPolynomial.finSuccEquiv A (k + 1))
    have hψ0 : ψ (MvPolynomial.X 0) = Polynomial.X := by
      show MvPolynomial.finSuccEquiv A (k + 1) (σ (MvPolynomial.X 0)) = _
      rw [show σ (MvPolynomial.X 0) = MvPolynomial.X 0 by simp [σ, h01]]
      exact MvPolynomial.finSuccEquiv_X_zero
    have hψ1 : ψ (MvPolynomial.X 1) = Polynomial.C (MvPolynomial.X 0) + Polynomial.X := by
      show MvPolynomial.finSuccEquiv A (k + 1) (σ (MvPolynomial.X 1)) = _
      rw [show σ (MvPolynomial.X 1) = MvPolynomial.X 1 + MvPolynomial.X 0 by simp [σ]]
      have e1 : (MvPolynomial.X 1 : MvPolynomial (Fin (k + 2)) A) =
          MvPolynomial.X (Fin.succ (0 : Fin (k + 1))) := rfl
      rw [map_add, e1, MvPolynomial.finSuccEquiv_X_succ, MvPolynomial.finSuccEquiv_X_zero]
    have hψC : ∀ i : Fin (k + 2), 2 ≤ i.val →
        ψ (MvPolynomial.X i) ∈ (Polynomial.C : S →+* Polynomial S).range := by
      intro i hi
      have hi1 : i ≠ 1 := by intro h; rw [h] at hi; simp at hi
      have hi0 : i ≠ 0 := by intro h; rw [h] at hi; simp at hi
      obtain ⟨j, rfl⟩ := Fin.exists_succ_eq.mpr hi0
      refine ⟨MvPolynomial.X j, ?_⟩
      simp only [ψ, σe, σ, AlgEquiv.trans_apply, AlgEquiv.ofAlgHom_apply, MvPolynomial.aeval_X,
        if_neg hi1]
      rw [MvPolynomial.finSuccEquiv_X_succ]
    set Rg := (Polynomial.C : S →+* Polynomial S).range
    have hterm : ∀ p q : Fin (k + 2),
        ψ (MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q) -
          (if p = 0 then (if q = 1 then Polynomial.X * (Polynomial.C (MvPolynomial.X 0) +
            Polynomial.X) else 0) else 0) ∈ Rg := by
      intro p q
      by_cases hpq : p.val % 2 = 0 ∧ q.val = p.val + 1
      · have hcpq : c p q = 1 := by simp [hc, hpq]
        by_cases hp0 : p = 0
        · have hq1 : q = 1 := by
            apply Fin.ext; rw [hpq.2, hp0]; simp
          subst hp0; subst hq1
          rw [if_pos rfl, if_pos rfl, hcpq, map_one, one_mul, map_mul, hψ0, hψ1, sub_self]
          exact Rg.zero_mem
        · rw [if_neg hp0, sub_zero, hcpq, map_one, one_mul, map_mul]
          have hp2 : 2 ≤ p.val := by
            have : p.val ≠ 0 := fun h => hp0 (Fin.ext h)
            omega
          exact Rg.mul_mem (hψC p hp2) (hψC q (by omega))
      · have hcpq : c p q = 0 := by simp [hc, hpq]
        have hite : (if p = 0 then (if q = 1 then Polynomial.X * (Polynomial.C (MvPolynomial.X 0) +
            Polynomial.X) else 0) else 0 : Polynomial S) = 0 := by
          by_cases hp0 : p = 0
          · by_cases hq1 : q = 1
            · exfalso; apply hpq; subst hp0; subst hq1; simp
            · rw [if_pos hp0, if_neg hq1]
          · rw [if_neg hp0]
        rw [hite, hcpq, map_zero, zero_mul, zero_mul, map_zero, sub_zero]
        exact Rg.zero_mem
    have hsum : ψ (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q) -
        Polynomial.X * (Polynomial.C (MvPolynomial.X 0) + Polynomial.X) ∈ Rg := by
      have e : (Polynomial.X * (Polynomial.C (MvPolynomial.X 0) + Polynomial.X) : Polynomial S) =
          ∑ p : Fin (k + 2), ∑ q : Fin (k + 2), (if p = 0 then (if q = 1 then
            Polynomial.X * (Polynomial.C (MvPolynomial.X 0) + Polynomial.X) else 0) else 0) := by
        simp
      rw [e, map_sum, ← Finset.sum_sub_distrib]
      refine Rg.sum_mem (fun p _ => ?_)
      rw [map_sum, ← Finset.sum_sub_distrib]
      exact Rg.sum_mem (fun q _ => hterm p q)
    obtain ⟨s, hs⟩ := hsum
    set F := ∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
      MvPolynomial.C π with hF
    have hψF : ψ F = Polynomial.X ^ 2 + (Polynomial.C (MvPolynomial.X 0) * Polynomial.X +
        Polynomial.C (s - MvPolynomial.C π)) := by
      rw [hF, map_sub, sub_eq_iff_eq_add.mp hs.symm]
      have : ψ (MvPolynomial.C π) = Polynomial.C (MvPolynomial.C π) := by
        rw [← MvPolynomial.algebraMap_eq, AlgEquiv.commutes]; rfl
      rw [this, map_sub]; ring
    have hmon : (ψ F).Monic := by
      rw [hψF]
      apply Polynomial.monic_X_pow_add
      refine lt_of_le_of_lt (Polynomial.degree_add_le _ _) (max_lt ?_ ?_)
      · exact lt_of_le_of_lt (Polynomial.degree_C_mul_X_le _) (by norm_num)
      · exact lt_of_le_of_lt (Polynomial.degree_C_le) (by norm_num)
    let e : wcQuadModelRing A (k + 2) π c ≃ₐ[A] Polynomial S ⧸ Ideal.span {ψ F} :=
      Ideal.quotientEquivAlg _ _ ψ (by rw [Ideal.map_span, Set.image_singleton]; rfl)
    have : Module.Free S (Polynomial S ⧸ Ideal.span {ψ F}) := hmon.free_quotient
    have : Module.Free A (Polynomial S ⧸ Ideal.span {ψ F}) := Module.Free.trans (R := A) (S := S)
    have : Module.Free A (wcQuadModelRing A (k + 2) π c) :=
      Module.Free.of_equiv e.symm.toLinearEquiv
    exact Module.Flat.of_free

  obtain ⟨k, rfl⟩ : ∃ k, n = k + 2 := ⟨n - 2, by omega⟩
  set R := wcQuadModelRing A (k + 2) π
    (Matrix.of fun p q : Fin (k + 2) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0)
    with hR
  set φ : A →+* B := β'.comp (algebraMap A R) with hφ

  have hflatβ : β'.Flat := by
    have hF : AlgebraicGeometry.Flat (Spec.map (CommRingCat.ofHom β')) := hβ'.flat
    have h2 := (HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Flat)).mp hF
    simpa only [CommRingCat.hom_ofHom] using h2
  have hflatA : (algebraMap A R).Flat := RingHom.flat_algebraMap_iff.mpr (s1 k)
  have hφflat : φ.Flat := RingHom.Flat.comp hflatA hflatβ
  letI : Algebra A B := φ.toAlgebra
  have hflatAB : Module.Flat A B := hφflat

  have hφπ : φ π ∈ IsLocalRing.maximalIdeal B := by
    set c : Matrix (Fin (k + 2)) (Fin (k + 2)) A :=
      Matrix.of fun p q : Fin (k + 2) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0
      with hc
    have h1 : algebraMap A R π = Ideal.Quotient.mk (wcQuadModelIdeal A (k + 2) π c)
        (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q) := by
      show Ideal.Quotient.mk _ (MvPolynomial.C π) = _
      symm
      rw [Ideal.Quotient.eq]
      exact Ideal.subset_span rfl
    rw [hφ, RingHom.comp_apply, h1]
    simp only [map_sum, map_mul]
    refine Ideal.sum_mem _ (fun p _ => Ideal.sum_mem _ (fun q _ => ?_))
    exact Ideal.mul_mem_left _ _ (hβ'X q)

  have hloc : IsLocalHom (algebraMap A B) := by
    constructor
    intro a ha
    by_contra h
    have h1 : a ∈ Ideal.span {π} := by
      rw [← hπ]; exact (IsLocalRing.mem_maximalIdeal a).mpr h
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp h1
    have h2 : algebraMap A B (c * π) ∈ IsLocalRing.maximalIdeal B := by
      rw [map_mul]
      exact Ideal.mul_mem_left _ _ hφπ
    exact (IsLocalRing.mem_maximalIdeal _).mp h2 ha
  have hff : Module.FaithfullyFlat A B := Module.FaithfullyFlat.of_flat_of_isLocalHom

  have hnoeth : IsNoetherianRing A := by
    have key : ∀ I J : Ideal A, I.map (algebraMap A B) ≤ J.map (algebraMap A B) ↔ I ≤ J := by
      intro I J
      constructor
      · intro h
        have h1 := Ideal.comap_mono (f := algebraMap A B) h
        rwa [Ideal.comap_map_eq_self_of_faithfullyFlat,
          Ideal.comap_map_eq_self_of_faithfullyFlat] at h1
      · intro h; exact Ideal.map_mono h
    let e : Ideal A ↪o Ideal B := OrderEmbedding.ofMapLEIff (fun I => I.map (algebraMap A B)) key
    have hB : WellFoundedGT (Ideal B) := by
      have := (isNoetherianRing_iff (R := B)).mp inferInstance
      exact (_root_.isNoetherian_iff (R := B) (M := B)).mp this
    rw [isNoetherianRing_iff, _root_.isNoetherian_iff]
    exact e.wellFoundedGT

  have hnil : ∀ k : ℕ, π ^ k ≠ 0 := by
    intro k h
    have := congrArg lam h
    rw [map_pow, map_zero] at this
    exact hlamπ (pow_eq_zero_iff'.mp this).1

  have hK : ⨅ i : ℕ, (IsLocalRing.maximalIdeal A) ^ i = ⊥ :=
    Ideal.iInf_pow_eq_bot_of_isLocalRing _ (IsLocalRing.maximalIdeal.isMaximal A).ne_top
  have hfac : ∀ x : A, x ≠ 0 → ∃ (k : ℕ) (u : Aˣ), x = u * π ^ k := by
    intro x hx
    have hex : ∃ i : ℕ, x ∉ Ideal.span {π ^ i} := by
      by_contra h
      push_neg at h
      apply hx
      have : x ∈ ⨅ i : ℕ, (IsLocalRing.maximalIdeal A) ^ i := by
        rw [Ideal.mem_iInf]
        intro i
        rw [hπ, Ideal.span_singleton_pow]
        exact h i
      rw [hK] at this
      exact (Submodule.mem_bot A).mp this
    have hi₀ : x ∉ Ideal.span {π ^ (Nat.find hex)} := Nat.find_spec hex
    have hi0 : Nat.find hex ≠ 0 := by
      intro h
      apply hi₀
      rw [h, pow_zero, Ideal.span_singleton_one]
      exact Submodule.mem_top
    obtain ⟨k, hk⟩ := Nat.exists_eq_succ_of_ne_zero hi0
    have hxk : x ∈ Ideal.span {π ^ k} := by
      by_contra h
      exact Nat.find_min hex (show k < Nat.find hex by omega) h
    obtain ⟨u, hu⟩ := Ideal.mem_span_singleton'.mp hxk
    have hunit : IsUnit u := by
      by_contra hu'
      have h1 : u ∈ IsLocalRing.maximalIdeal A := (IsLocalRing.mem_maximalIdeal u).mpr hu'
      rw [hπ] at h1
      obtain ⟨v, hv⟩ := Ideal.mem_span_singleton'.mp h1
      apply hi₀
      rw [hk]
      refine Ideal.mem_span_singleton'.mpr ⟨v, ?_⟩
      rw [← hu, ← hv, pow_succ]; ring
    exact ⟨k, hunit.unit, by rw [IsUnit.unit_spec, hu]⟩
  have hdom : IsDomain A := by
    have : NoZeroDivisors A := by
      constructor
      intro a b hab
      by_contra h
      push_neg at h
      obtain ⟨k, u, hku⟩ := hfac a h.1
      obtain ⟨l, v, hlv⟩ := hfac b h.2
      have h2 : ((u * v : Aˣ) : A) * π ^ (k + l) = 0 := by
        rw [← hab, hku, hlv]; push_cast; ring
      exact hnil (k + l) ((Units.mul_right_eq_zero _).mp h2)
    exact NoZeroDivisors.to_isDomain A
  refine ⟨hdom, ?_⟩
  have hmem : π ∈ IsLocalRing.maximalIdeal A := by
    rw [hπ]; exact Ideal.mem_span_singleton_self π
  have hirr : Irreducible π := by
    rw [irreducible_iff]
    refine ⟨fun hu => (IsLocalRing.mem_maximalIdeal π).mp hmem hu, ?_⟩
    intro a b hab
    by_contra h
    push_neg at h
    have ha : a ∈ Ideal.span {π} := by
      rw [← hπ]; exact (IsLocalRing.mem_maximalIdeal a).mpr h.1
    have hb : b ∈ Ideal.span {π} := by
      rw [← hπ]; exact (IsLocalRing.mem_maximalIdeal b).mpr h.2
    obtain ⟨a', rfl⟩ := Ideal.mem_span_singleton'.mp ha
    obtain ⟨b', rfl⟩ := Ideal.mem_span_singleton'.mp hb
    have h1 : π * (1 - a' * b' * π) = 0 := by
      calc π * (1 - a' * b' * π) = π - (a' * π) * (b' * π) := by ring
        _ = 0 := by rw [← hab, sub_self]
    have h2 : IsUnit (1 - a' * b' * π) := by
      by_contra h3
      have h4 := (IsLocalRing.mem_maximalIdeal _).mpr h3
      have h5 : a' * b' * π ∈ IsLocalRing.maximalIdeal A :=
        Ideal.mul_mem_left _ _ hmem
      have h6 := Ideal.add_mem _ h4 h5
      rw [sub_add_cancel] at h6
      exact (IsLocalRing.maximalIdeal.isMaximal A).ne_top ((Ideal.eq_top_iff_one _).mpr h6)
    apply hnil 1
    rw [pow_one]
    exact (h2.mul_left_eq_zero).mp h1
  apply IsDiscreteValuationRing.ofHasUnitMulPowIrreducibleFactorization
  refine ⟨π, hirr, ?_⟩
  intro x hx
  obtain ⟨k, u, hku⟩ := hfac x hx
  refine ⟨k, ?_⟩
  exact ⟨u, by rw [hku]; ring⟩

theorem wc_hmtg_shens_identify (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)]
    (π : A) (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    (n : ℕ) (hnm : n = 2 * (n / 2)) (hn2 : 2 ≤ n)
    (B : Type u) [CommRing B] [IsNoetherianRing B] [HenselianLocalRing B]
    [IsSepClosed (IsLocalRing.ResidueField B)]
    (β' : wcQuadModelRing A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0) →+* B)
    (hβ' : WeaklyEtale (Spec.map (CommRingCat.ofHom β')))
    (hβ'X : ∀ p, β' (Ideal.Quotient.mk (wcQuadModelIdeal A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))
          (MvPolynomial.X p)) ∈ IsLocalRing.maximalIdeal B) :
    ∃ x₀ : Spec (.of (wcQuadModelRing A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))),
      (∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))
          (MvPolynomial.X p) ∈ PrimeSpectrum.asIdeal x₀) ∧
      wcQuadModelStr A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0) x₀ =
        IsLocalRing.closedPoint A ∧
      ∃ (Λ₀ : Type u) (_ : SmallCategory Λ₀) (_ : IsCofiltered Λ₀)
        (W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0)))) x₀))
          (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))))))
        (φ₀ : ∀ l, Spec (.of B) ⟶ (W₀.obj l).right.left),
        wcHalShData x₀ B Λ₀ W₀ φ₀ (Spec.map (CommRingCat.ofHom β')) :=
by
  classical
  refine ⟨Spec.map (CommRingCat.ofHom β') (IsLocalRing.closedPoint B), ?_, ?_, ?_⟩
  ·
    intro p
    exact hβ'X p
  ·
    apply PrimeSpectrum.ext
    show Ideal.comap (β'.comp (algebraMap A (wcQuadModelRing A n π
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))))
        (IsLocalRing.maximalIdeal B) = IsLocalRing.maximalIdeal A
    apply le_antisymm
    · exact IsLocalRing.le_maximalIdeal (Ideal.comap_isPrime _ _).ne_top
    · rw [hπ, Ideal.span_singleton_le_iff_mem, Ideal.mem_comap]
      have h1 : algebraMap A (wcQuadModelRing A n π
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0)) π =
          Ideal.Quotient.mk (wcQuadModelIdeal A n π
            (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0))
            (∑ p, ∑ q, MvPolynomial.C ((Matrix.of fun p q : Fin n =>
              if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0) p q) *
              MvPolynomial.X p * MvPolynomial.X q) := by
        rw [← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq, Ideal.Quotient.eq, ← neg_sub]
        exact (Ideal.neg_mem_iff _).mpr (Ideal.subset_span rfl)
      rw [RingHom.comp_apply, h1]
      simp only [map_sum, map_mul]
      refine Ideal.sum_mem _ (fun p _ => Ideal.sum_mem _ (fun q _ => ?_))
      exact Ideal.mul_mem_left _ _ (hβ'X q)
  ·
    obtain ⟨B₀, _, _, _, Λ, _, _, W', φ, a, e, h1, h2, h3, h4, h5, h6, h7⟩ :=
      wc_et_geom_strict_henselization (Spec.map (CommRingCat.ofHom β') (IsLocalRing.closedPoint B))
    have hsh₀ : wcHalShData (Spec.map (CommRingCat.ofHom β') (IsLocalRing.closedPoint B)) B₀ Λ W' φ a :=
      ⟨h1, h2, h3, h4, h5, e, h6, h7⟩
    obtain ⟨ε, hεi, hεq⟩ := wc_pltr_wet_residue_geom_point
      (Spec.map (CommRingCat.ofHom β') (IsLocalRing.closedPoint B)) B
      (Spec.map (CommRingCat.ofHom β')) hβ' rfl
    have hq1 : (Spec.map (CommRingCat.ofHom ε) ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) (IsLocalRing.closedPoint _) =
        IsLocalRing.closedPoint B := by
      apply PrimeSpectrum.ext
      show Ideal.comap (IsLocalRing.residue B)
        (PrimeSpectrum.asIdeal ((Spec.map (CommRingCat.ofHom ε)) (IsLocalRing.closedPoint _))) =
          IsLocalRing.maximalIdeal B
      apply le_antisymm
      · exact IsLocalRing.le_maximalIdeal (Ideal.comap_ne_top _ (PrimeSpectrum.isPrime _).ne_top)
      · intro x hx
        rw [Ideal.mem_comap, (IsLocalRing.residue_eq_zero_iff x).mpr hx]
        exact Ideal.zero_mem _
    have hq2 : (Spec.map (CommRingCat.ofHom ε) ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) ≫ Spec.map (CommRingCat.ofHom β') =
        wcEtGeomPt _ (Spec.map (CommRingCat.ofHom β') (IsLocalRing.closedPoint B)) := by
      rw [Category.assoc]; exact hεq
    obtain ⟨δ, hδ, -⟩ := wc_shdata_lift_geom_point _ B₀ Λ W' φ a hsh₀ B
      (Spec.map (CommRingCat.ofHom β')) _ hq1 hq2
    have hiso := wc_pltr_shens_lift_iso _ B₀ Λ W' φ a hsh₀ B
      (Spec.map (CommRingCat.ofHom β')) hβ' rfl δ hδ
    have h9 := wc_pltr_shdata_iso_transport _ B₀ B Λ W' φ a hsh₀ δ hiso ε hεi
      (by rw [hδ]; exact hεq)
    rw [hδ] at h9
    exact ⟨Λ, inferInstance, inferInstance, W', fun l => δ ≫ φ l, h9⟩

theorem wc_hmtg_closed_inv_germ_transfer : ∀ {Z Y : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i] (z : Z) (H : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}), ∃ τ : (wcEtStalk Z z).obj ((wcEtInv i).obj H) → (wcEtStalk Y (i z)).obj H, Function.Bijective τ ∧ ∀ s : H.obj.obj (Opposite.op (wcEtTop Y)), τ (wcEtGlobalGerm ((wcEtInv i).obj H) z (wcEtInvRho i H (wcEtTop Y) (wcEtTop Z) i ((Category.comp_id i).trans (Category.id_comp i).symm) s)) = wcEtGlobalGerm H (i z) s :=
by
  intro Z Y i _ z H
  obtain ⟨e, he, hsq⟩ := wc_closed_immersion_geomPt_compat Z Y i z
  haveI := he
  have hθ : wcEtGeomPt Z z ≫ i = inv e ≫ wcEtGeomPt Y (i z) := by
    rw [← hsq, IsIso.inv_hom_id_assoc]
  obtain ⟨e', he'⟩ := wc_qmbst_inv_stalk_germ_equiv i z (i z) (inv e) inferInstance hθ H
  have hgerm : ∀ s : H.obj.obj (Opposite.op (wcEtTop Y)),
      e' (wcEtGlobalGerm H (i z) s) = wcEtGlobalGerm ((wcEtInv i).obj H) z
        (wcEtInvRho i H (wcEtTop Y) (wcEtTop Z) i
          ((Category.comp_id i).trans (Category.id_comp i).symm) s) := by
    intro s
    exact he' (StructuredArrow.mk (Y := Scheme.Etale.mk (𝟙 Y))
        (Over.homMk (wcEtGeomPt Y (i z)) (by simp)))
      (StructuredArrow.mk (Y := Scheme.Etale.mk (𝟙 Z))
        (Over.homMk (wcEtGeomPt Z z) (by simp))) i
      ((Category.comp_id i).trans (Category.id_comp i).symm) hθ s
  refine ⟨e'.symm, e'.symm.bijective, fun s => ?_⟩
  rw [← hgerm s, Equiv.symm_apply_apply]

theorem wc_hmtg_derived_exact_H0_compat {C D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] [HasDerivedCategory C] [HasDerivedCategory D] (F : C ⥤ D) [F.Additive] [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F] (X : C) (T : DerivedCategory C) : ∃ (ω : F.obj X ≅ F.obj X) (μ : F.obj ((DerivedCategory.homologyFunctor C 0).obj T) ≅ (DerivedCategory.homologyFunctor D 0).obj (F.mapDerivedCategory.obj T)), ∀ x : (DerivedCategory.singleFunctor C 0).obj X ⟶ T, (DerivedCategory.singleFunctorCompHomologyFunctorIso D 0).inv.app (F.obj X) ≫ (DerivedCategory.homologyFunctor D 0).map ((F.mapDerivedCategorySingleFunctor 0).inv.app X ≫ F.mapDerivedCategory.map x) = ω.hom ≫ F.map ((DerivedCategory.singleFunctorCompHomologyFunctorIso C 0).inv.app X ≫ (DerivedCategory.homologyFunctor C 0).map x) ≫ μ.hom :=
by

  have A : F.mapHomologicalComplex (ComplexShape.up ℤ) ⋙
      HomologicalComplex.shortComplexFunctor D (ComplexShape.up ℤ) 0 ≅
      HomologicalComplex.shortComplexFunctor C (ComplexShape.up ℤ) 0 ⋙ F.mapShortComplex :=
    NatIso.ofComponents (fun K => Iso.refl _) (fun f => by
      ext <;> exact (Category.comp_id _).trans (Category.id_comp _).symm)
  let Ψ : F.mapHomologicalComplex (ComplexShape.up ℤ) ⋙
      HomologicalComplex.homologyFunctor D (ComplexShape.up ℤ) 0 ≅
      HomologicalComplex.homologyFunctor C (ComplexShape.up ℤ) 0 ⋙ F :=
    Functor.isoWhiskerLeft _ (HomologicalComplex.homologyFunctorIso D (ComplexShape.up ℤ) 0) ≪≫
      (Functor.associator _ _ _).symm ≪≫
      Functor.isoWhiskerRight A _ ≪≫ Functor.associator _ _ _ ≪≫
      Functor.isoWhiskerLeft _ (ShortComplex.homologyFunctorIso F) ≪≫
      (Functor.associator _ _ _).symm ≪≫
      Functor.isoWhiskerRight (HomologicalComplex.homologyFunctorIso C (ComplexShape.up ℤ) 0).symm F

  let e : DerivedCategory.Q ⋙ (F.mapDerivedCategory ⋙ DerivedCategory.homologyFunctor D 0) ≅
      DerivedCategory.Q ⋙ (DerivedCategory.homologyFunctor C 0 ⋙ F) :=
    (Functor.associator _ _ _).symm ≪≫
      Functor.isoWhiskerRight F.mapDerivedCategoryFactors _ ≪≫ Functor.associator _ _ _ ≪≫
      Functor.isoWhiskerLeft _ (DerivedCategory.homologyFunctorFactors D 0) ≪≫ Ψ ≪≫
      Functor.isoWhiskerRight (DerivedCategory.homologyFunctorFactors C 0).symm F ≪≫
      Functor.associator _ _ _
  have := Localization.full_whiskeringLeft (DerivedCategory.Q (C := C))
    (HomologicalComplex.quasiIso C (ComplexShape.up ℤ)) D
  have := Localization.faithful_whiskeringLeft (DerivedCategory.Q (C := C))
    (HomologicalComplex.quasiIso C (ComplexShape.up ℤ)) D
  let Φ : F.mapDerivedCategory ⋙ DerivedCategory.homologyFunctor D 0 ≅
      DerivedCategory.homologyFunctor C 0 ⋙ F :=
    ((Functor.whiskeringLeft _ _ D).obj DerivedCategory.Q).preimageIso e

  refine ⟨((DerivedCategory.singleFunctorCompHomologyFunctorIso D 0).app (F.obj X)).symm ≪≫
      (DerivedCategory.homologyFunctor D 0).mapIso ((F.mapDerivedCategorySingleFunctor 0).app X).symm ≪≫
      Φ.app ((DerivedCategory.singleFunctor C 0).obj X) ≪≫
      F.mapIso ((DerivedCategory.singleFunctorCompHomologyFunctorIso C 0).app X),
    (Φ.app T).symm, fun x => ?_⟩
  have hN := Φ.hom.naturality x
  simp only [Functor.comp_map, Functor.comp_obj] at hN
  have hε : F.map ((DerivedCategory.singleFunctorCompHomologyFunctorIso C 0).hom.app X) ≫
      F.map ((DerivedCategory.singleFunctorCompHomologyFunctorIso C 0).inv.app X ≫
        (DerivedCategory.homologyFunctor C 0).map x) =
      F.map ((DerivedCategory.homologyFunctor C 0).map x) := by
    rw [← F.map_comp, Iso.hom_inv_id_app_assoc]
  simp only [Iso.trans_hom, Iso.symm_hom, Iso.app_hom, Iso.app_inv, Functor.mapIso_hom,
    Category.assoc]
  rw [reassoc_of% hε, ← reassoc_of% hN, Iso.hom_inv_id_app, Functor.map_comp]
  erw [Category.comp_id]

