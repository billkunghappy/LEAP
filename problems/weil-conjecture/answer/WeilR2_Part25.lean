    | (simp only [wcEtGeomPt, comp_ap, Scheme.fromSpecResidueField_apply])
    | (simp [wcEtGeomPt])
  have hwN : ∀ (c : (wcP1Over F'').left)
      (N : StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left c))
        (Scheme.Etale.forget (wcP1Over F'').left)),
      N.hom.left ≫ N.right.hom = wcEtGeomPt (wcP1Over F'').left c := fun c N => Over.w N.hom
  obtain ⟨l₁⟩ : Nonempty Λ := IsCofiltered.nonempty
  have hφa : ∀ l, φ l ≫ (W'.obj l).right.hom = a := hA.2.2.2.1
  have hcl := wc_shdata_closed_point_compat _ A Λ W' φ a hA l₁
  have ha_cl : a (IsLocalRing.closedPoint A) = D.S i (IsLocalRing.closedPoint F'') := by
    calc a (IsLocalRing.closedPoint A)
        = (φ l₁ ≫ (W'.obj l₁).right.hom) (IsLocalRing.closedPoint A) := by rw [hφa l₁]
      _ = (W'.obj l₁).right.hom (φ l₁ (IsLocalRing.closedPoint A)) := comp_ap _ _ _
