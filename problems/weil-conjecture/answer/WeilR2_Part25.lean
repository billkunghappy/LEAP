      rw [show Limits.terminal.from ((wcProEtPullback (Limits.pullback.fst D.f (D.S i))).obj
          ((wcProEtPullback D.f).obj V₀)).left = (a ≫ ε.hom) ≫ Limits.terminal.from _ from
