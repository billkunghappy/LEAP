  have hδ := s5 K P σ (m + 1) (B (m + 1)) (u (m + 1)) (h1 (m + 1)) (hS1 (m + 1)) τ
    (fun c => β c (m + 1)) (fun c => hβu c (m + 1)) (E (m + 1)) (ι (m + 1))
    (fun c => t c (m + 1)) (fun c => ht c (m + 1)) g.natDegree g.coeff (hG 1 (by norm_num))
    b ⟨e, hebu⟩
  obtain ⟨e₂, he₂⟩ := s6 K P σ B u v h1 h2 hS1 hS2 τ β hβu hβv E ι t ht
    g.natDegree g.coeff m (h0a m) (h0b m) (hG 2 le_rfl) hM b ⟨e, hebu⟩ hδ
  refine hcob ⟨e₂, ?_⟩
  have h3 : e₂ ≫ u (m + 1) ≫ v (m + 1) ≫ K.iCycles (m + 1 + 1) = c := by
    rw [reassoc_of% he₂, reassoc_of% hb, HomologicalComplex.liftCycles_i]
  rw [hfac (m + 1)] at h3
  exact h3

theorem wc_minpoly_eval_criterion : ∀ {V : Type*} [AddCommGroup V] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (s : ℚ_[ℓ] → V →+ V) (Φ : V →+ V), (∀ (c : ℚ_[ℓ]) (x : V), Φ (s c x) = s c (Φ x)) →
    ∀ (r : ℕ) (e : V ≃+ (Fin r → ℚ_[ℓ])), (∀ (c : ℚ_[ℓ]) (x : V), e (s c x) = c • e x) →
    ∀ α : AlgebraicClosure ℚ_[ℓ],
      (α ∈ (wcAddEquivMatrix e Φ).charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) →
        ∃ x : V, x ≠ 0 ∧ ∑ i ∈ Finset.range ((minpoly ℚ_[ℓ] α).natDegree + 1),
          s ((minpoly ℚ_[ℓ] α).coeff i) ((⇑Φ)^[i] x) = 0) ∧
      (α ∉ (wcAddEquivMatrix e Φ).charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) →
        (∀ x : V, ∑ i ∈ Finset.range ((minpoly ℚ_[ℓ] α).natDegree + 1),
          s ((minpoly ℚ_[ℓ] α).coeff i) ((⇑Φ)^[i] x) = 0 → x = 0) ∧
        ∀ M : AddSubgroup V, (∀ c : ℚ_[ℓ], ∀ x ∈ M, s c x ∈ M) → (∀ x ∈ M, Φ x ∈ M) →
          ∀ x ∈ M, ∃ y ∈ M, ∑ i ∈ Finset.range ((minpoly ℚ_[ℓ] α).natDegree + 1),
            s ((minpoly ℚ_[ℓ] α).coeff i) ((⇑Φ)^[i] y) = x) :=
by
  classical
  intro V _ ℓ _ s Φ hΦ r e he α
  have hes : ∀ (c : ℚ_[ℓ]) (v : Fin r → ℚ_[ℓ]), e.symm (c • v) = s c (e.symm v) := fun c v =>
    e.injective (by rw [he, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
  let LA : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]) :=
    { toFun := fun v => e (Φ (e.symm v))
      map_add' := fun v w => by simp only [map_add]
      map_smul' := fun c v => by simp only [hes, hΦ, he, RingHom.id_apply] }
  have hA : wcAddEquivMatrix e Φ = LinearMap.toMatrix' LA := by
    ext a b
    rw [LinearMap.toMatrix'_apply]
    rfl
  have hAk : ∀ (k : ℕ) (z : V), ((wcAddEquivMatrix e Φ) ^ k).mulVec (e z) = e ((⇑Φ)^[k] z) := by
    intro k
    induction k with
    | zero => intro z; simp
    | succ k ih =>
      intro z
      rw [pow_succ', ← Matrix.mulVec_mulVec, ih, hA, LinearMap.toMatrix'_mulVec]
      show e (Φ (e.symm (e ((⇑Φ)^[k] z)))) = _
      rw [AddEquiv.symm_apply_apply, Function.iterate_succ_apply']
  have hstar : ∀ (p : Polynomial ℚ_[ℓ]) (y : V),
      e (∑ i ∈ Finset.range (p.natDegree + 1), s (p.coeff i) ((⇑Φ)^[i] y)) =
        (Polynomial.aeval (wcAddEquivMatrix e Φ) p).mulVec (e y) := by
    intro p y
    rw [Polynomial.aeval_eq_sum_range, Matrix.sum_mulVec, map_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [he, Matrix.smul_mulVec, hAk]
  have hint : IsIntegral ℚ_[ℓ] α := Algebra.IsIntegral.isIntegral α
  refine ⟨fun hα => ?_, fun hα => ?_⟩
  · set f : ℚ_[ℓ] →+* AlgebraicClosure ℚ_[ℓ] := algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])
      with hf
    rw [Polynomial.mem_aroots] at hα
    obtain ⟨_, hμ⟩ := hα
    have hdet : (Matrix.scalar (Fin r) α - (wcAddEquivMatrix e Φ).map f).det = 0 := by
      rw [← Matrix.eval_charpoly, Matrix.charpoly_map, Polynomial.eval_map, ← Polynomial.aeval_def]
      exact hμ
    obtain ⟨v, hv0, hv⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
    have hAv : ((wcAddEquivMatrix e Φ).map f).mulVec v = α • v := by
      rw [Matrix.sub_mulVec, sub_eq_zero] at hv
      rw [← hv, Matrix.scalar_apply]
      ext x
      simp [Matrix.mulVec_diagonal]
    have hAkv : ∀ k : ℕ, ((wcAddEquivMatrix e Φ).map f ^ k).mulVec v = α ^ k • v := by
      intro k
      induction k with
      | zero => simp
      | succ k ih =>
        rw [pow_succ ((wcAddEquivMatrix e Φ).map f), ← Matrix.mulVec_mulVec, hAv,
          Matrix.mulVec_smul, ih, smul_smul, ← pow_succ']
    have hgv : (Polynomial.aeval ((wcAddEquivMatrix e Φ).map f) (minpoly ℚ_[ℓ] α)).mulVec v
        = 0 := by
      rw [Polynomial.aeval_eq_sum_range, Matrix.sum_mulVec]
      have h0 := minpoly.aeval ℚ_[ℓ] α
      rw [Polynomial.aeval_eq_sum_range] at h0
      calc _ = ∑ i ∈ Finset.range ((minpoly ℚ_[ℓ] α).natDegree + 1),
              ((minpoly ℚ_[ℓ] α).coeff i • α ^ i) • v := by
            refine Finset.sum_congr rfl (fun i _ => ?_)
            rw [Matrix.smul_mulVec, hAkv, smul_assoc]
        _ = 0 := by rw [← Finset.sum_smul, h0, zero_smul]
    have hmap : Polynomial.aeval ((wcAddEquivMatrix e Φ).map f) (minpoly ℚ_[ℓ] α) =
        (Polynomial.aeval (wcAddEquivMatrix e Φ) (minpoly ℚ_[ℓ] α)).map f := by
      have := Polynomial.aeval_algHom_apply
        ((Algebra.ofId ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])).mapMatrix (m := Fin r))
        (wcAddEquivMatrix e Φ) (minpoly ℚ_[ℓ] α)
      simp only [AlgHom.mapMatrix_apply] at this
      exact this
    have hdet2 : (Polynomial.aeval (wcAddEquivMatrix e Φ) (minpoly ℚ_[ℓ] α)).det = 0 := by
      have h1 : ((Polynomial.aeval (wcAddEquivMatrix e Φ) (minpoly ℚ_[ℓ] α)).map f).det = 0 := by
        rw [← hmap]
        exact Matrix.exists_mulVec_eq_zero_iff.mp ⟨v, hv0, hgv⟩
      rw [← RingHom.mapMatrix_apply, ← RingHom.map_det] at h1
      exact (map_eq_zero_iff f f.injective).mp h1
    obtain ⟨w, hw0, hw⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet2
    refine ⟨e.symm w, ?_, ?_⟩
    · intro h
      apply hw0
      rw [← e.apply_symm_apply w, h, map_zero]
    · apply e.injective
      rw [hstar, e.apply_symm_apply, hw, map_zero]
  · have hirr : Irreducible (minpoly ℚ_[ℓ] α) := minpoly.irreducible hint
    have hndvd : ¬ minpoly ℚ_[ℓ] α ∣ (wcAddEquivMatrix e Φ).charpoly := by
      intro hd
      apply hα
      rw [Polynomial.mem_aroots]
      exact ⟨(Matrix.charpoly_monic _).ne_zero,
        Polynomial.aeval_eq_zero_of_dvd_aeval_eq_zero hd (minpoly.aeval ℚ_[ℓ] α)⟩
    obtain ⟨u, v, huv⟩ := (hirr.coprime_iff_not_dvd).mpr hndvd
    have hU1 : Polynomial.aeval (wcAddEquivMatrix e Φ) u *
        Polynomial.aeval (wcAddEquivMatrix e Φ) (minpoly ℚ_[ℓ] α) = 1 := by
      have := congrArg (Polynomial.aeval (wcAddEquivMatrix e Φ)) huv
      rw [map_add, map_mul, map_mul, Matrix.aeval_self_charpoly, mul_zero, add_zero,
        map_one] at this
      exact this
    have hU2 : Polynomial.aeval (wcAddEquivMatrix e Φ) (minpoly ℚ_[ℓ] α) *
        Polynomial.aeval (wcAddEquivMatrix e Φ) u = 1 := by
      rw [← map_mul, mul_comm, map_mul]
      exact hU1
    refine ⟨fun x hx => ?_, fun M hMs hMΦ x hx => ?_⟩
    · have h1 : (Polynomial.aeval (wcAddEquivMatrix e Φ) (minpoly ℚ_[ℓ] α)).mulVec (e x) = 0 := by
        rw [← hstar, hx, map_zero]
      apply e.injective
      calc e x = (Polynomial.aeval (wcAddEquivMatrix e Φ) u *
            Polynomial.aeval (wcAddEquivMatrix e Φ) (minpoly ℚ_[ℓ] α)).mulVec (e x) := by
            rw [hU1, Matrix.one_mulVec]
        _ = 0 := by rw [← Matrix.mulVec_mulVec, h1, Matrix.mulVec_zero]
        _ = e 0 := (map_zero e).symm
    · have hiter : ∀ k : ℕ, (⇑Φ)^[k] x ∈ M := by
        intro k
        induction k with
        | zero => exact hx
        | succ k ih =>
          rw [Function.iterate_succ_apply']
          exact hMΦ _ ih
      refine ⟨∑ i ∈ Finset.range (u.natDegree + 1), s (u.coeff i) ((⇑Φ)^[i] x), ?_, ?_⟩
      · exact AddSubgroup.sum_mem M (fun i _ => hMs _ _ (hiter i))
      · apply e.injective
        rw [hstar, hstar, Matrix.mulVec_mulVec, hU2, Matrix.one_mulVec]

theorem wc_pencil_leray_eigen (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (ht : WeaklyEtale (Limits.pullback.fst D.Yt.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (α : AlgebraicClosure ℚ_[ℓ])
    (hα : wcIsEigen ℓ (wcCohScalar F'' D.Yt ht ℓ n) (wcCohFrob F'' D.Yt ht ℓ n) α) :
    ∃ p ≤ 2, wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - p)) p (wcRqScalar D.f ℓ (n - p) c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - p)) p) α :=
by
  classical
  by_contra hne
  push_neg at hne

  have hcomm : ∀ (p q : ℕ) (c : ℚ_[ℓ]) (x : wcCohG F'' (wcP1Over F'') hP (wcRq D.f ℓ q) p),
      wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ q) p
        (wcCohGEnd F'' (wcP1Over F'') hP (wcRq D.f ℓ q) p (wcRqScalar D.f ℓ q c) x) =
      wcCohGEnd F'' (wcP1Over F'') hP (wcRq D.f ℓ q) p (wcRqScalar D.f ℓ q c)
        (wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ q) p x) := by
    intro p q c x
    show (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left
          (wcGeomFrob F'' (wcP1Over F'') hP))).comp
        (x.comp (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ q c)) (add_zero p)) (zero_add p) =
      ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left
          (wcGeomFrob F'' (wcP1Over F'') hP))).comp x (zero_add p)).comp
        (Abelian.Ext.mk₀ (wcRqScalar D.f ℓ q c)) (add_zero p)
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add p) (add_zero p) (by omega)).symm

  have hcommV : ∀ (c : ℚ_[ℓ]) (x : wcCoh F'' D.Yt ht ℓ n),
      wcCohFrob F'' D.Yt ht ℓ n (wcCohScalar F'' D.Yt ht ℓ n c x) =
        wcCohScalar F'' D.Yt ht ℓ n c (wcCohFrob F'' D.Yt ht ℓ n x) := by
    intro c x
    show (Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left (wcGeomFrob F'' D.Yt ht))).comp
        (x.comp (Abelian.Ext.mk₀ (wcLadicScalar D.Yt.left ℓ c)) (add_zero n)) (zero_add n) =
      ((Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left (wcGeomFrob F'' D.Yt ht))).comp x
          (zero_add n)).comp
        (Abelian.Ext.mk₀ (wcLadicScalar D.Yt.left ℓ c)) (add_zero n)
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add n) (add_zero n) (by omega)).symm

  have hW : ∀ p ≤ 2,
      (∀ x : wcCohG F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - p)) p,
        ∑ i ∈ Finset.range ((minpoly ℚ_[ℓ] α).natDegree + 1),
          wcCohGEnd F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - p)) p
            (wcRqScalar D.f ℓ (n - p) ((minpoly ℚ_[ℓ] α).coeff i))
            ((⇑(wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - p)) p))^[i] x) = 0 → x = 0) ∧
      ∀ M : AddSubgroup (wcCohG F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - p)) p),
        (∀ c : ℚ_[ℓ], ∀ x ∈ M,
          wcCohGEnd F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - p)) p
            (wcRqScalar D.f ℓ (n - p) c) x ∈ M) →
        (∀ x ∈ M, wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - p)) p x ∈ M) →
        ∀ x ∈ M, ∃ y ∈ M, ∑ i ∈ Finset.range ((minpoly ℚ_[ℓ] α).natDegree + 1),
          wcCohGEnd F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - p)) p
            (wcRqScalar D.f ℓ (n - p) ((minpoly ℚ_[ℓ] α).coeff i))
            ((⇑(wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - p)) p))^[i] y) = x := by
    intro p hp
    obtain ⟨r, e, he⟩ := wc_pencil_E2_finite F' F'' Y n hn2 D ℓ hℓ hP p hp (n - p)
    have hnot : α ∉ (wcAddEquivMatrix e
        (wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - p)) p)).charpoly.aroots
          (AlgebraicClosure ℚ_[ℓ]) := fun hroot => hne p hp ⟨r, e, he, hroot⟩
    exact (wc_minpoly_eval_criterion ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - p)) p (wcRqScalar D.f ℓ (n - p) c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - p)) p)
      (hcomm p (n - p)) r e he α).2 hnot

  obtain ⟨r, e, he, hroot⟩ := hα
  obtain ⟨x, hx0, hGx⟩ := (wc_minpoly_eval_criterion ℓ (wcCohScalar F'' D.Yt ht ℓ n)
    (wcCohFrob F'' D.Yt ht ℓ n) hcommV r e he α).1 hroot

  obtain ⟨L, adj, hL, θ, hθ⟩ := wc_proet_push_free_adjunction F'' (wcP1Over F'') D.Yt
    (Over.homMk D.f D.hf) hP ht
  haveI := hL

  exact hx0 (wc_ext_leray_poly_injective L (wcProEtPush D.f) adj
    (wcFreeSheaf (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP))
    (wcFreeSheafMap (wcP1Over F'').left (wcGeomFrob F'' (wcP1Over F'') hP))
    (wcFreeSheaf D.Yt.left (wcGeomPoint F'' D.Yt ht))
    (wcFreeSheafMap D.Yt.left (wcGeomFrob F'' D.Yt ht)) θ hθ
    (wcLadicSheaf D.Yt.left ℓ) ℓ (wcLadicScalar D.Yt.left ℓ) (minpoly ℚ_[ℓ] α) n hn2
    (wc_pencil_E2_vanish F' F'' Y n hn2 D ℓ hℓ hP)
    (fun p hp => (hW p hp).1) (hW 2 le_rfl).2 x hGx)

theorem wc_punct_excision (F'' : Type u) [Field F'']
    (u0 : Spec (.of F'') ⟶ (wcP1Over F'').left) (hu0 : u0 ≫ (wcP1Over F'').hom = 𝟙 _)
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (V : (wcP1Over F'').left.ProEt) (g : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
    (ε : Limits.pullback V.hom u0 ≅ Spec (.of (AlgebraicClosure F'')))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V.hom u0) :
    ∃ κ : Limits.cokernel (wcFreeSheafMap (wcP1Over F'').left (wcPunctOfIncl F'' u0 V)) ⟶
        Limits.cokernel (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' u0 hP)),
      IsIso κ ∧
      Limits.cokernel.π (wcFreeSheafMap (wcP1Over F'').left (wcPunctOfIncl F'' u0 V)) ≫ κ =
        wcFreeSheafMap (wcP1Over F'').left g ≫
          Limits.cokernel.π (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' u0 hP)) :=
by
  classical

  have hs1 : ∀ (S : Scheme.{u}) (U V T VT : S.ProEt) (ι : V ⟶ U)
      (hι : IsOpenImmersion ι.left) (x : U.left) (hr : Set.range ι.left = {x}ᶜ)
      (g : T ⟶ U) (j : VT ⟶ T) (hj : IsOpenImmersion j.left)
      (hrj : Set.range j.left = g.left ⁻¹' {x}ᶜ) (gV : VT ⟶ V) (hgV : gV ≫ ι = j ≫ g)
      (hfib : IsIso (Limits.pullback.snd g.left (U.left.fromSpecResidueField x)))
      (hln : IsLocallyNoetherian U.left),
      ∃ κ : Limits.cokernel (wcFreeSheafMap S j) ⟶ Limits.cokernel (wcFreeSheafMap S ι),
        IsIso κ ∧
        Limits.cokernel.π (wcFreeSheafMap S j) ≫ κ =
          wcFreeSheafMap S g ≫ Limits.cokernel.π (wcFreeSheafMap S ι) := by
    intro S U V T VT ι hι x hr g j hj hrj gV hgV hfib hln
    obtain ⟨e, he0, hen⟩ : ∃ e : ∀ (W : S.ProEt) (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}),
          (wcFreeSheaf S W ⟶ G) ≃ G.obj.obj (Opposite.op W),
        (∀ (W : S.ProEt) (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}), e W G 0 = 0) ∧
        (∀ {W W' : S.ProEt} (f : W ⟶ W') (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
          (φ : wcFreeSheaf S W' ⟶ G),
          e W G (wcFreeSheafMap S f ≫ φ) = G.obj.map f.op (e W' G φ)) := by
      let adj := sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}
      let adjW := Adjunction.whiskerRight S.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}
      let e2 : ∀ (W : S.ProEt) (G : S.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1}),
          (yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ G) ≃ G.obj (Opposite.op W) :=
        fun W G => (adjW.homEquiv (yoneda.obj W ⋙ uliftFunctor.{u+1, u}) G).trans
            (uliftYonedaEquiv.{u+1} (X := W) (F := G ⋙ forget AddCommGrpCat.{u+1}))
      let e : ∀ (W : S.ProEt) (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}),
          (wcFreeSheaf S W ⟶ G) ≃ G.obj.obj (Opposite.op W) := fun W G =>
        (adj.homEquiv (yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) G).trans (e2 W G.obj)
      have hnat2 : ∀ (W : S.ProEt) (G G' : S.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1}) (ψ : G ⟶ G')
          (h : yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ G),
          e2 W G' (h ≫ ψ) = ψ.app (Opposite.op W) (e2 W G h) := by
        intro W G G' ψ h
        have hW := adjW.homEquiv_naturality_right (X := yoneda.obj W ⋙ uliftFunctor.{u+1, u}) h ψ
        have hY := uliftYonedaEquiv_comp.{u+1}
          (adjW.homEquiv (yoneda.obj W ⋙ uliftFunctor.{u+1, u}) G h)
          (((Functor.whiskeringRight S.ProEtᵒᵖ AddCommGrpCat.{u+1} (Type (u+1))).obj
              (forget AddCommGrpCat.{u+1})).map ψ)
        exact (congrArg (uliftYonedaEquiv.{u+1} (X := W) (F := G' ⋙ forget AddCommGrpCat.{u+1})) hW).trans hY
      have hnat : ∀ (W : S.ProEt) (F F' : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
          (φ : F ⟶ F') (g : wcFreeSheaf S W ⟶ F), e W F' (g ≫ φ) = φ.hom.app (Opposite.op W) (e W F g) := by
        intro W F F' φ g
        have hA := adj.homEquiv_naturality_right
          (X := yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) g φ
        exact (congrArg (e2 W F'.obj) hA).trans (hnat2 W F.obj F'.obj φ.hom _)
      refine ⟨e, fun W F => ?_, fun {W W'} f G φ => ?_⟩
      · have h1 := hnat W F F 0 0
        rw [Limits.zero_comp] at h1
        rw [h1]
        have h0 : (0 : F ⟶ F).hom = 0 :=
          (sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_zero F F
        rw [h0, NatTrans.app_zero]
        rfl
      · let α := Functor.whiskerRight (yoneda.map f) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
        let β : uliftYoneda.{u+1}.obj W ⟶ uliftYoneda.{u+1}.obj W' := uliftYoneda.{u+1}.map f
        have e1 : adj.homEquiv _ G (wcFreeSheafMap S f ≫ φ) = α ≫ adj.homEquiv _ G φ :=
          adj.homEquiv_naturality_left α φ
        have hsrc2 : ∀ (P : S.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1})
            (h : yoneda.obj W' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ P),
            e2 W P (α ≫ h) = P.map f.op (e2 W' P h) := by
          intro P h
          have e3 := adjW.homEquiv_naturality_left β h
          have e4 := uliftYonedaEquiv_naturality.{u+1} (adjW.homEquiv _ P h) f.op
          exact (congrArg uliftYonedaEquiv.{u+1} e3).trans e4.symm
        calc e W G (wcFreeSheafMap S f ≫ φ)
            = e2 W G.obj (adj.homEquiv _ G (wcFreeSheafMap S f ≫ φ)) := rfl
          _ = e2 W G.obj (α ≫ adj.homEquiv _ G φ) := congrArg (e2 W G.obj) e1
          _ = G.obj.map f.op (e2 W' G.obj (adj.homEquiv _ G φ)) := hsrc2 _ _
          _ = G.obj.map f.op (e W' G φ) := rfl

    have hs3 : ∀ (Y A B : S.ProEt) (p : A ⟶ Y) (q : B ⟶ Y)
        (hp : IsOpenImmersion p.left) (hpqc : QuasiCompact p.left) (y₀ : Y.left)
        (hy₀ : y₀ ∈ Set.range q.left) (hcomp : ∀ y : Y.left, y ∈ Set.range p.left ∨ y = y₀)
        (R : Sieve Y) (hRp : R.arrows p) (hRq : R.arrows q),
        R ∈ Scheme.ProEt.topology S Y := by
      intro Y A B p q hp hpqc y₀ hy₀ hcomp R hRp hRq
      let W' : ULift.{u+1} Bool → S.ProEt := fun i => Bool.rec B A i.down
      let f : ∀ i, W' i ⟶ Y := fun i => Bool.rec (motive := fun b => W' ⟨b⟩ ⟶ Y) q p i.down
      have hcov : ∀ y : ↥Y.left, ∃ (i : ULift.{u+1} Bool) (z : ↥(W' i).left), (f i).left z = y := by
        intro y
        rcases hcomp y with ⟨a, ha⟩ | rfl
        · exact ⟨⟨true⟩, a, ha⟩
        · obtain ⟨b, hb⟩ := hy₀
          exact ⟨⟨false⟩, b, hb⟩
      have hwe : ∀ i, WeaklyEtale (f i).left := by
        intro i
        haveI := (W' i).prop
        haveI := Y.prop
        haveI : WeaklyEtale ((f i).left ≫ Y.hom) := by
          rw [MorphismProperty.Over.w (f i)]; exact (W' i).prop
        exact WeaklyEtale.of_comp _ Y.hom
      let 𝒰 : Scheme.Cover (Scheme.precoverage @WeaklyEtale) Y.left :=
        Scheme.Cover.mkOfCovers (P := @WeaklyEtale) (ULift.{u+1} Bool)
          (fun i => (W' i).left) (fun i => (f i).left) hcov hwe
      have hqc : QuasiCompactCover 𝒰.toPreZeroHypercover := by
        rw [quasiCompactCover_iff]
        intro O hO
        have hcA : IsCompact ((p.left ⁻¹ᵁ O : A.left.Opens) : Set A.left) :=
          QuasiCompact.isCompact_preimage _ O.isOpen hO.isCompact
        by_cases hy : y₀ ∈ O
        · obtain ⟨b, hb⟩ := hy₀
          have hbO : b ∈ q.left ⁻¹ᵁ O := by
            show q.left b ∈ O; rw [hb]; exact hy
          obtain ⟨Wb, hWa, hbW, hWsub⟩ := exists_isAffineOpen_mem_and_subset hbO
          refine IsCompactOpenCovered.of_finite (κ := Bool) (fun b => (⟨b⟩ : ULift.{u+1} Bool))
            (fun k => Bool.rec (motive := fun b => TopologicalSpace.Opens (𝒰.X ⟨b⟩))
              Wb (p.left ⁻¹ᵁ O) k) ?_ ?_
          · intro k
            cases k
            · exact hWa.isCompact
            · exact hcA
          · ext y
            simp only [Set.mem_iUnion, Set.mem_image]
            constructor
            · rintro ⟨k, z, hz, rfl⟩
              cases k
              · have hz' : z ∈ q.left ⁻¹ᵁ O := hWsub hz
                exact hz'
              · exact hz
            · intro hyO
              rcases hcomp y with ⟨a, rfl⟩ | rfl
              · exact ⟨true, a, hyO, rfl⟩
              · exact ⟨false, b, hbW, hb⟩
        · refine IsCompactOpenCovered.of_finite (κ := Unit) (fun _ => (⟨true⟩ : ULift.{u+1} Bool))
            (fun _ => (p.left ⁻¹ᵁ O : A.left.Opens)) (fun _ => hcA) ?_
          ext y
          simp only [Set.mem_iUnion, Set.mem_image, exists_const]
          constructor
          · rintro ⟨z, hz, rfl⟩
            exact hz
          · intro hyO
            rcases hcomp y with ⟨a, rfl⟩ | rfl
            · exact ⟨a, hyO, rfl⟩
            · exact absurd hyO hy
      have hRb : Presieve.ofArrows (fun i => (W' i).left) (fun i => (f i).left) ∈
          Scheme.proetalePrecoverage.coverings Y.left :=
        Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover.mpr ⟨𝒰, hqc, rfl⟩
      have e := Presieve.map_ofArrows (F := Scheme.ProEt.forget S ⋙ Over.forget S) (Y := W') f
      have hR' : Presieve.ofArrows W' f ∈ (Scheme.ProEt.precoverage S).coverings Y :=
        Precoverage.mem_comap_iff.mpr (e ▸ hRb)
      have hRJ : Sieve.generate (Presieve.ofArrows W' f) ∈ (Scheme.ProEt.topology S) Y :=
        Precoverage.generate_mem_toGrothendieck hR'
      refine (Scheme.ProEt.topology S).superset_covering ?_ hRJ
      rw [Sieve.generate_le_iff]
      rintro _ _ ⟨i⟩
      rcases i with ⟨_ | _⟩
      · exact hRq
      · exact hRp

    have hs4 : ∀ (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
        (Y A B : S.ProEt) (p : A ⟶ Y) (q : B ⟶ Y)
        (hcov : ∀ R : Sieve Y, R.arrows p → R.arrows q → R ∈ Scheme.ProEt.topology S Y),
        (∀ s s' : G.obj.obj (Opposite.op Y), G.obj.map p.op s = G.obj.map p.op s' →
            G.obj.map q.op s = G.obj.map q.op s' → s = s') ∧
        (∀ (sA : G.obj.obj (Opposite.op A)) (sB : G.obj.obj (Opposite.op B)),
          (∀ (Z : S.ProEt) (u v : Z ⟶ A), u ≫ p = v ≫ p → G.obj.map u.op sA = G.obj.map v.op sA) →
          (∀ (Z : S.ProEt) (u : Z ⟶ A) (v : Z ⟶ B), u ≫ p = v ≫ q →
            G.obj.map u.op sA = G.obj.map v.op sB) →
          (∀ (Z : S.ProEt) (u v : Z ⟶ B), u ≫ q = v ≫ q → G.obj.map u.op sB = G.obj.map v.op sB) →
          ∃ s : G.obj.obj (Opposite.op Y), G.obj.map p.op s = sA ∧ G.obj.map q.op s = sB) := by
      intro G Y A B p q hcov
      let W' : ULift.{u+1} Bool → S.ProEt := fun i => Bool.rec B A i.down
      let f : ∀ i, W' i ⟶ Y := fun i => Bool.rec (motive := fun b => W' ⟨b⟩ ⟶ Y) q p i.down
      have hR : Sieve.generate (Presieve.ofArrows W' f) ∈ Scheme.ProEt.topology S Y :=
        hcov _ ⟨_, 𝟙 _, f ⟨true⟩, Presieve.ofArrows.mk (Y := W') (f := f) ⟨true⟩, Category.id_comp _⟩
          ⟨_, 𝟙 _, f ⟨false⟩, Presieve.ofArrows.mk (Y := W') (f := f) ⟨false⟩, Category.id_comp _⟩
      have hG : Presieve.IsSheaf (Scheme.ProEt.topology S) (G.obj ⋙ forget AddCommGrpCat.{u+1}) :=
        (isSheaf_iff_isSheaf_of_type _ _).mp
          ((Presheaf.isSheaf_iff_isSheaf_forget (Scheme.ProEt.topology S) G.obj
            (forget AddCommGrpCat.{u+1})).mp G.cond)
      have hSF := (Presieve.isSheafFor_arrows_iff _ f).mp (hG.isSheafFor _ hR)
      refine ⟨fun s s' h1 h2 => ?_, fun sA sB hAA hAB hBB => ?_⟩
      · obtain ⟨t, _, huniq⟩ := hSF (fun i => G.obj.map (f i).op s) (by
          intro i j Z gi gj h
          change G.obj.map gi.op (G.obj.map (f i).op s) = G.obj.map gj.op (G.obj.map (f j).op s)
          rw [← CategoryTheory.comp_apply, ← Functor.map_comp, ← op_comp, h, op_comp, Functor.map_comp,
            CategoryTheory.comp_apply])
        have e1 := huniq s (fun i => rfl)
        have e2 := huniq s' (fun i => by
          rcases i with ⟨_ | _⟩
          · exact h2.symm
          · exact h1.symm)
        rw [e1, e2]
      · obtain ⟨t, ht, _⟩ := hSF
          (fun i => Bool.rec (motive := fun b => (G.obj ⋙ forget AddCommGrpCat.{u+1}).obj
            (Opposite.op (W' ⟨b⟩))) sB sA i.down) (by
          intro i j Z gi gj h
          rcases i with ⟨_ | _⟩ <;> rcases j with ⟨_ | _⟩
          · exact hBB Z gi gj h
          · exact (hAB Z gj gi h.symm).symm
          · exact hAB Z gi gj h
          · exact hAA Z gi gj h)
        exact ⟨t, ht ⟨true⟩, ht ⟨false⟩⟩

    have hs5 : ∀ (T U : Scheme.{u}) (g : T ⟶ U) (x : U)
        (hfib : IsIso (Limits.pullback.snd g (U.fromSpecResidueField x))),
        (∃ t₀ : T, ∀ t : T, g t = x ↔ t = t₀) ∧
        ∀ w : ↥(Limits.pullback g g), g (Limits.pullback.fst g g w) = x →
          w ∈ Set.range (Limits.pullback.diagonal g) := by
      intro T U g x hfib
      haveI := hfib
      have hsub : Subsingleton ↥(Limits.pullback g (U.fromSpecResidueField x)) :=
        (Scheme.Hom.homeomorph (Limits.pullback.snd g (U.fromSpecResidueField x))).injective.subsingleton
      have hxr : x ∈ Set.range (U.fromSpecResidueField x) := by
        rw [Scheme.range_fromSpecResidueField]; rfl
      obtain ⟨k, hk⟩ := hxr
      let p₀ := (Scheme.Hom.homeomorph (Limits.pullback.snd g (U.fromSpecResidueField x))).symm k
      have hpt : ∀ p : ↥(Limits.pullback g (U.fromSpecResidueField x)),
          g (Limits.pullback.fst g (U.fromSpecResidueField x) p) = x := by
        intro p
        have h1 := congrArg (fun φ : (Limits.pullback g (U.fromSpecResidueField x)) ⟶ U => φ p)
          (Limits.pullback.condition (f := g) (g := U.fromSpecResidueField x))
        simp only [Scheme.Hom.comp_apply] at h1
        rw [h1]
        have h2 : (U.fromSpecResidueField x) (Limits.pullback.snd g (U.fromSpecResidueField x) p) ∈
            Set.range (U.fromSpecResidueField x) := ⟨_, rfl⟩
        rw [Scheme.range_fromSpecResidueField] at h2
        exact h2
      refine ⟨⟨Limits.pullback.fst g (U.fromSpecResidueField x) p₀, fun t => ⟨fun ht => ?_, fun ht => ?_⟩⟩, ?_⟩
      · have hm : t ∈ Set.range (Limits.pullback.fst g (U.fromSpecResidueField x)) := by
          rw [Scheme.Pullback.range_fst, Scheme.range_fromSpecResidueField]; exact ht
        obtain ⟨p, rfl⟩ := hm
        rw [Subsingleton.elim p p₀]
      · rw [ht]; exact hpt p₀
      · intro w hw
        have hw' : (Limits.pullback.fst g g ≫ g) w = x := by
          rw [Scheme.Hom.comp_apply]; exact hw
        let kk := Spec.map (Scheme.Hom.residueFieldMap (Limits.pullback.fst g g ≫ g) w) ≫
          Spec.map (Scheme.residueFieldCongr hw'.symm).hom
        have hkk : kk ≫ U.fromSpecResidueField x =
            (Limits.pullback g g).fromSpecResidueField w ≫ Limits.pullback.fst g g ≫ g := by
          simp only [kk, Category.assoc, Scheme.residueFieldCongr_fromSpecResidueField,
            Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField]
        have hα : ((Limits.pullback g g).fromSpecResidueField w ≫ Limits.pullback.fst g g) ≫ g =
            kk ≫ U.fromSpecResidueField x := by rw [hkk, Category.assoc]
        have hβ : ((Limits.pullback g g).fromSpecResidueField w ≫ Limits.pullback.snd g g) ≫ g =
            kk ≫ U.fromSpecResidueField x := by
          rw [hkk, Category.assoc, ← Limits.pullback.condition]
        have hl : Limits.pullback.lift _ _ hα = Limits.pullback.lift _ _ hβ := by
          rw [← cancel_mono (Limits.pullback.snd g (U.fromSpecResidueField x))]
          simp only [Limits.pullback.lift_snd]
        have hαβ : (Limits.pullback g g).fromSpecResidueField w ≫ Limits.pullback.fst g g =
            (Limits.pullback g g).fromSpecResidueField w ≫ Limits.pullback.snd g g := by
          have := congrArg (fun φ => φ ≫ Limits.pullback.fst g (U.fromSpecResidueField x)) hl
          simpa only [Limits.pullback.lift_fst] using this
        have hdiag : (Limits.pullback g g).fromSpecResidueField w =
            ((Limits.pullback g g).fromSpecResidueField w ≫ Limits.pullback.fst g g) ≫
              Limits.pullback.diagonal g := by
          apply Limits.pullback.hom_ext
          · rw [Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
          · rw [Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id, hαβ]
        have hwr : w ∈ Set.range ((Limits.pullback g g).fromSpecResidueField w) := by
          rw [Scheme.range_fromSpecResidueField]; rfl
        obtain ⟨q, hq⟩ := hwr
        refine ⟨((Limits.pullback g g).fromSpecResidueField w ≫ Limits.pullback.fst g g) q, ?_⟩
        rw [← Scheme.Hom.comp_apply, ← hdiag, hq]
    obtain ⟨⟨t₀, ht₀⟩, hdiag⟩ := hs5 T.left U.left g.left x hfib

    have hιqc : QuasiCompact ι.left := by
      haveI := hln
      haveI := hι
      rw [← Scheme.Hom.isoOpensRange_hom_ι ι.left]; infer_instance

    have hs7 : ∀ (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (t : G.obj.obj (Opposite.op T)),
        G.obj.map j.op t = 0 → ∀ (Z : S.ProEt) (v : Z ⟶ T),
        (∀ z : Z.left, g.left (v.left z) ≠ x) → G.obj.map v.op t = 0 := by
      intro G t ht Z v hv
      have H : Set.range v.left ⊆ Set.range j.left := by
        rintro _ ⟨z, rfl⟩
        rw [hrj]; exact hv z
      let l := IsOpenImmersion.lift j.left v.left H
      have hl : l ≫ j.left = v.left := IsOpenImmersion.lift_fac _ _ H
      have hlw : l ≫ VT.hom = Z.hom := by
        rw [← MorphismProperty.Over.w j, ← Category.assoc, hl, MorphismProperty.Over.w v]
      let l' : Z ⟶ VT := MorphismProperty.Over.homMk l hlw trivial
      have hl' : l' ≫ j = v := MorphismProperty.Over.Hom.ext hl
      rw [← hl', op_comp, Functor.map_comp, CategoryTheory.comp_apply, ht, map_zero]
    have hAB : ∀ (Z : S.ProEt) (u : Z ⟶ V) (v : Z ⟶ T), u ≫ ι = v ≫ g →
        ∀ z : Z.left, g.left (v.left z) ≠ x := by
      intro Z u v huv z
      intro hz
      have h1 : (u.left ≫ ι.left) z = (v.left ≫ g.left) z := by
        have h := congrArg (fun φ => φ.left) huv
        exact congrArg (fun φ : Z.left ⟶ U.left => φ z) h
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h1
      have h2 : ι.left (u.left z) ∈ Set.range ι.left := ⟨_, rfl⟩
      rw [hr, h1] at h2
      exact h2 hz

    have hs8 : ∀ (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
        (hsep : ∀ (Y A B : S.ProEt) (p : A ⟶ Y) (q : B ⟶ Y) (y₀ : Y.left),
          IsOpenImmersion p.left → QuasiCompact p.left → y₀ ∈ Set.range q.left →
          (∀ y : Y.left, y ∈ Set.range p.left ∨ y = y₀) →
          ∀ s s' : G.obj.obj (Opposite.op Y), G.obj.map p.op s = G.obj.map p.op s' →
            G.obj.map q.op s = G.obj.map q.op s' → s = s')
        (t : G.obj.obj (Opposite.op T))
        (hvan : ∀ (Z : S.ProEt) (v : Z ⟶ T), (∀ z : Z.left, g.left (v.left z) ≠ x) →
          G.obj.map v.op t = 0)
        (Z : S.ProEt) (a b : Z ⟶ T) (hab : a ≫ g = b ≫ g),
        G.obj.map a.op t = G.obj.map b.op t := by
      intro G hsep t hvan Z a b hab
      haveI := hι
      haveI := hln
      haveI := T.prop
      haveI := U.prop
      haveI : WeaklyEtale (g.left ≫ U.hom) := by
        rw [MorphismProperty.Over.w g]; exact T.prop
      haveI : WeaklyEtale g.left := WeaklyEtale.of_comp _ U.hom
      let P : S.ProEt := Scheme.ProEt.mk (Limits.pullback.fst g.left g.left ≫ T.hom)
      have hcond : Limits.pullback.snd g.left g.left ≫ T.hom = Limits.pullback.fst g.left g.left ≫ T.hom := by
        rw [← MorphismProperty.Over.w g, ← Category.assoc, ← Limits.pullback.condition, Category.assoc]
      let p₁ : P ⟶ T := MorphismProperty.Over.homMk (Limits.pullback.fst g.left g.left) rfl trivial
      let p₂ : P ⟶ T := MorphismProperty.Over.homMk (Limits.pullback.snd g.left g.left) hcond trivial
      have hΔw : Limits.pullback.diagonal g.left ≫ (Limits.pullback.fst g.left g.left ≫ T.hom) = T.hom := by
        rw [← Category.assoc, Limits.pullback.diagonal_fst, Category.id_comp]
      let Δ : T ⟶ P := MorphismProperty.Over.homMk (Limits.pullback.diagonal g.left) hΔw trivial
      have hΔ1 : Δ ≫ p₁ = 𝟙 T := MorphismProperty.Over.Hom.ext (Limits.pullback.diagonal_fst g.left)
      have hΔ2 : Δ ≫ p₂ = 𝟙 T := MorphismProperty.Over.Hom.ext (Limits.pullback.diagonal_snd g.left)
      have hab' : a.left ≫ g.left = b.left ≫ g.left := congrArg (fun φ => φ.left) hab
      have hhw : Limits.pullback.lift a.left b.left hab' ≫ (Limits.pullback.fst g.left g.left ≫ T.hom) =
          Z.hom := by
        rw [← Category.assoc, Limits.pullback.lift_fst, MorphismProperty.Over.w a]
      let h : Z ⟶ P := MorphismProperty.Over.homMk (Limits.pullback.lift a.left b.left hab') hhw trivial
      have hh1 : h ≫ p₁ = a := MorphismProperty.Over.Hom.ext (Limits.pullback.lift_fst _ _ _)
      have hh2 : h ≫ p₂ = b := MorphismProperty.Over.Hom.ext (Limits.pullback.lift_snd _ _ _)
      have hmap : ∀ {X Y W : S.ProEt} (f₁ : X ⟶ Y) (f₂ : Y ⟶ W) (s : G.obj.obj (Opposite.op W)),
          G.obj.map (f₁ ≫ f₂).op s = G.obj.map f₁.op (G.obj.map f₂.op s) := by
        intro X Y W f₁ f₂ s
        rw [op_comp, Functor.map_comp, CategoryTheory.comp_apply]
      suffices hP : G.obj.map p₁.op t = G.obj.map p₂.op t by
        rw [← hh1, ← hh2, hmap, hmap, hP]

      let hO := Limits.pullback.fst g.left g.left ≫ g.left
      let O : (Limits.pullback g.left g.left).Opens := hO ⁻¹ᵁ ι.left.opensRange
      haveI := P.prop
      let A : S.ProEt := Scheme.ProEt.mk (O.ι ≫ Limits.pullback.fst g.left g.left ≫ T.hom)
      let p : A ⟶ P := MorphismProperty.Over.homMk (A := A) (B := P) O.ι rfl trivial
      have hpqc : QuasiCompact p.left :=
        MorphismProperty.of_isPullback (P := @QuasiCompact)
          (isPullback_morphismRestrict hO ι.left.opensRange) inferInstance
      have hpoi : IsOpenImmersion p.left := by
        show IsOpenImmersion O.ι; infer_instance
      have hOmem : ∀ y : ↥(Limits.pullback g.left g.left), y ∈ O ↔
          g.left (Limits.pullback.fst g.left g.left y) ≠ x := by
        intro y
        show hO y ∈ (ι.left.opensRange : Set U.left) ↔ _
        rw [Scheme.Hom.coe_opensRange, hr]
        show (Limits.pullback.fst g.left g.left ≫ g.left) y ≠ x ↔ _
        rw [Scheme.Hom.comp_apply]
      have hsnd : ∀ y : ↥(Limits.pullback g.left g.left),
          g.left (Limits.pullback.snd g.left g.left y) = g.left (Limits.pullback.fst g.left g.left y) := by
        intro y
        have h1 := congrArg (fun φ : (Limits.pullback g.left g.left) ⟶ U.left => φ y)
          (Limits.pullback.condition (f := g.left) (g := g.left))
        simp only [Scheme.Hom.comp_apply] at h1
        exact h1.symm
      apply hsep P A T p Δ (Δ.left t₀) hpoi hpqc ⟨t₀, rfl⟩
      · intro y
        by_cases hy : g.left (Limits.pullback.fst g.left g.left y) = x
        · right
          obtain ⟨t', rfl⟩ := hdiag y hy
          have hfd : Limits.pullback.fst g.left g.left (Limits.pullback.diagonal g.left t') = t' := by
            rw [← Scheme.Hom.comp_apply, Limits.pullback.diagonal_fst]; rfl
          rw [hfd] at hy
          rw [(ht₀ t').mp hy]
          rfl
        · left
          have hyO : y ∈ O := (hOmem y).mpr hy
          show y ∈ Set.range O.ι
