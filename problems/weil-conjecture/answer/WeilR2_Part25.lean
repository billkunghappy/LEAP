by
  classical
  intro w
  have hℓ0 : ℓ ≠ 0 := (Fact.out : ℓ.Prime).ne_zero
  have hc : ∀ k : ℕ, Continuous ((PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom) := fun k =>
    ((continuous_apply k).comp (wc_padic_tower_facts ℓ).1).congr (fun _ => rfl)

  haveI := hj
  haveI hBn : TopologicalSpace.NoetherianSpace (Spec (.of B)) := by
    first
      | exact inferInstance
      | exact (inferInstance : TopologicalSpace.NoetherianSpace (PrimeSpectrum B))
  haveI hVn : TopologicalSpace.NoetherianSpace VT.left := by
    have hemb := (j.left ≫ eB.hom).isOpenEmbedding
    first
      | exact hemb.isInducing.noetherianSpace
      | exact hemb.toIsEmbedding.toIsInducing.noetherianSpace
      | exact hemb.isEmbedding.noetherianSpace
      | exact hemb.toIsEmbedding.noetherianSpace
  haveI hVc : CompactSpace VT.left := ⟨TopologicalSpace.NoetherianSpace.isCompact Set.univ⟩
  haveI hVq : QuasiSeparatedSpace VT.left :=
    ⟨fun _ _ _ _ _ _ => TopologicalSpace.NoetherianSpace.isCompact _⟩

  have hfin := wc_odp_punct_germ_zmod_finite F' F'' Y n hn hn2 D ℓ hℓ i V₀ A e ε hv hε xb hxb
    Th VT g B eB hpre hfib j hj hrange
  have htor := fun k => wc_odp_punct_germ_zmod_frob_sq F' F'' Y n hn hn2 D ℓ hℓ i V₀ φ₀ A e ε hv
    hε hεφ xb hxb Th VT g φh hφg B eB hpre hfib j hj hrange φV hφV k

  have Q1 : ∀ (S : Scheme.{u}) (P : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (jd N : ℕ)
      (x : Abelian.Ext P (wcLadicSheaf S ℓ) jd),
      N • x = x.comp (Abelian.Ext.mk₀ (wcLadicScalar S ℓ (N : ℚ_[ℓ]))) (add_zero jd) := by
    intro S P jd N x
    obtain ⟨h1, -, hadd⟩ := wc_ladic_scalar_ring S ℓ
    induction N with
    | zero =>
      have h0 : wcLadicScalar S ℓ 0 = 0 := by
        have h := congrArg (fun t => t - wcLadicScalar S ℓ 0) (hadd 0 0)
        simp only [add_zero, sub_self, add_sub_cancel_right] at h
        exact h.symm
      rw [zero_nsmul, Nat.cast_zero, h0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    | succ N ih =>
      rw [succ_nsmul, ih, Nat.cast_succ, hadd, h1, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add,
        Abelian.Ext.comp_mk₀_id]
  have hinv : ∀ (S : Scheme.{u}) (P : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (jd : ℕ)
