      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Abelian.Ext.mk₀_comp_mk₀_assoc, hθφ]
    rw [h1, h3, hRF, Abelian.Ext.mk₀_comp_mk₀_assoc, Abelian.Ext.mk₀_comp_mk₀_assoc, hβF]

theorem wc_pencil_fibre_stalk_trace_integral (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'') :
    ∀ d : ℕ, 1 ≤ d → ∀ x ∈ wcP1ClosedPt F'' d, (∀ i, x ≠ D.S i (IsLocalRing.closedPoint F'')) →
    ∀ (N : wcFrobNbhd F'' x d) (r : ℕ → ℕ)
      (e : ∀ q : ℕ, Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) (wcRq D.f ℓ q) 0 ≃+
        (Fin (r q) → ℚ_[ℓ])),
      (∀ (q : ℕ) (c : ℚ_[ℓ]) (y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left N.V) (wcRq D.f ℓ q) 0),
        e q ((Abelian.Ext.mk₀ (wcRqScalar D.f ℓ q c)).postcomp
          (wcFreeSheaf (wcP1Over F'').left N.V) (add_zero 0) y) = c • e q y) →
      ∀ j : ℕ, 1 ≤ j → ∃ c : ℤ, ∑ q ∈ Finset.Iic (2 * (n - 1)), (-1 : ℚ_[ℓ]) ^ q *
        ((wcAddEquivMatrix (e q) ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left N.φ)).precomp
          (wcRq D.f ℓ q) (zero_add 0))) ^ j).trace = (c : ℚ_[ℓ]) :=
by
  classical
  intro d hd x hx hxS N r e he j hj
  letI := N.ringA
  haveI := N.hensA
  haveI := N.sepA

  have main : ∀ (K : Type u) [Field K] [Finite K] (hℓK : ¬ ℓ ∣ Nat.card K)
      (t : Spec (.of K) ⟶ (wcP1Over F'').left)
      (ht : ∀ i, t (IsLocalRing.closedPoint K) ≠ D.S i (IsLocalRing.closedPoint F''))
      (ε : Limits.pullback N.V.hom t ≅ Spec (.of (AlgebraicClosure K)))
      (hv : N.V.hom (N.e.inv (IsLocalRing.closedPoint N.A)) = t (IsLocalRing.closedPoint K))
      (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) =
        Limits.pullback.snd N.V.hom t)
      (hεφ : ε.inv ≫ Limits.pullback.fst N.V.hom t ≫ N.φ.left =
        Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic K _
          (Fintype.ofFinite K) (AlgebraicClosure K) _ _ _).symm :
            AlgebraicClosure K →+* AlgebraicClosure K)) ≫
          ε.inv ≫ Limits.pullback.fst N.V.hom t),
      ∃ c : ℤ, ∑ q ∈ Finset.Iic (2 * (n - 1)), (-1 : ℚ_[ℓ]) ^ q *
        ((wcAddEquivMatrix (e q) ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left N.φ)).precomp
          (wcRq D.f ℓ q) (zero_add 0))) ^ j).trace = (c : ℚ_[ℓ]) := by
    intro K _ _ hℓK t ht ε hv hε hεφ
    obtain ⟨hgi, hpr, hsm⟩ := wc_pencil_point_fibre_props F' F'' K Y n hn2 D t ht
    haveI : GeometricallyIrreducible (Over.mk (Limits.pullback.snd D.f t)).hom := hgi
    haveI : IsProper (Over.mk (Limits.pullback.snd D.f t)).hom := hpr
    haveI : SmoothOfRelativeDimension (n - 1) (Over.mk (Limits.pullback.snd D.f t)).hom := hsm
    have hX : WeaklyEtale (Limits.pullback.fst (Over.mk (Limits.pullback.snd D.f t)).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) :=
      MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
        (wc_weaklyEtale_algebraicClosure K)
    have hΨ := fun k => wc_pencil_point_nbhd_sections_pbc F' F'' K Y n hn2 D ℓ hℓK t ht hX k
      N.V N.φ N.A N.e ε hv hε hεφ
    choose Ψ hΨb hΨs hΨf using hΨ
    let e' : ∀ q, wcCoh K (Over.mk (Limits.pullback.snd D.f t)) hX ℓ q ≃+ (Fin (r q) → ℚ_[ℓ]) :=
      fun q => (AddEquiv.ofBijective (Ψ q) (hΨb q)).symm.trans (e q)
    have h1 : ∀ q y, e' q (Ψ q y) = e q y := by
      intro q y
      show e q ((AddEquiv.ofBijective (Ψ q) (hΨb q)).symm (Ψ q y)) = e q y
      congr 1
      apply (AddEquiv.ofBijective (Ψ q) (hΨb q)).injective
      rw [AddEquiv.apply_symm_apply, AddEquiv.ofBijective_apply]
    have h2 : ∀ q v, (e' q).symm v = Ψ q ((e q).symm v) := by
      intro q v
      apply (e' q).injective
      rw [AddEquiv.apply_symm_apply, h1, AddEquiv.apply_symm_apply]
    have he' : ∀ q (c : ℚ_[ℓ]) (z : wcCoh K (Over.mk (Limits.pullback.snd D.f t)) hX ℓ q),
        e' q (wcCohScalar K (Over.mk (Limits.pullback.snd D.f t)) hX ℓ q c z) = c • e' q z := by
      intro q c z
      obtain ⟨y, rfl⟩ := (hΨb q).2 z
      rw [← hΨs q c y, h1, h1]
      exact he q c y
    have hmat : ∀ q, wcAddEquivMatrix (e' q)
        (wcCohFrob K (Over.mk (Limits.pullback.snd D.f t)) hX ℓ q) =
        wcAddEquivMatrix (e q) ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left N.φ)).precomp
          (wcRq D.f ℓ q) (zero_add 0)) := by
      intro q
      ext a b
      simp only [wcAddEquivMatrix, Matrix.of_apply]
      rw [h2, ← hΨf, h1]
      rfl
    haveI : Fact (Nat.Prime (ringChar K)) := ⟨CharP.char_is_prime K (ringChar K)⟩
    haveI : NeZero j := ⟨by omega⟩
    haveI : FiniteDimensional K (ULift.{u} (FiniteField.Extension K (ringChar K) j)) :=
      Module.Finite.equiv (ULift.moduleEquiv (R := K)).symm
    have hE : Module.finrank K (ULift.{u} (FiniteField.Extension K (ringChar K) j)) = j := by
      rw [LinearEquiv.finrank_eq (ULift.moduleEquiv (R := K))]
      exact FiniteField.finrank_extension K (ringChar K) j
    have htr := wc_trace_formula K (Over.mk (Limits.pullback.snd D.f t)) (n - 1) ℓ hℓK hX
      (wc_coh_vanishing K (Over.mk (Limits.pullback.snd D.f t)) (n - 1) ℓ hℓK hX) r
      (fun q => wcAddEquivMatrix (e q) ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left
        N.φ)).precomp (wcRq D.f ℓ q) (zero_add 0)))
      (fun q _ => ⟨e' q, he' q, (hmat q).symm⟩)
      (ULift.{u} (FiniteField.Extension K (ringChar K) j))
    rw [hE] at htr
    refine ⟨(Nat.card (Over.mk (Spec.map (CommRingCat.ofHom (algebraMap K
      (ULift.{u} (FiniteField.Extension K (ringChar K) j))))) ⟶
        Over.mk (Limits.pullback.snd D.f t)) : ℤ), ?_⟩
    rw [Int.cast_natCast]
    exact htr.symm

  have hκ : Finite ((wcP1Over F'').left.residueField x) ∧
      Nat.card ((wcP1Over F'').left.residueField x) = Nat.card F'' ^ d := by
    obtain ⟨_, hfr⟩ := hx
    letI : Module F'' ((wcP1Over F'').left.residueField x) :=
      (((wcP1Over F'').left.residue x).hom.comp (wcLdpConst F'' (wcP1Over F'').hom x)).toModule
    have hfr' : Module.finrank F'' ((wcP1Over F'').left.residueField x) = d := hfr
    haveI : Module.Finite F'' ((wcP1Over F'').left.residueField x) :=
      Module.finite_of_finrank_pos (by omega)
    refine ⟨Module.finite_of_finite F'', ?_⟩
    rw [Module.natCard_eq_pow_finrank (K := F'') (V := (wcP1Over F'').left.residueField x), hfr']
  obtain ⟨hfin, hcard⟩ := hκ
  haveI : Finite ((wcP1Over F'').left.residueField x) := hfin
  have htx : (wcP1Over F'').left.fromSpecResidueField x
      (IsLocalRing.closedPoint ((wcP1Over F'').left.residueField x)) = x :=
    Scheme.fromSpecResidueField_apply x _
  have ht : ∀ i, (wcP1Over F'').left.fromSpecResidueField x
      (IsLocalRing.closedPoint ((wcP1Over F'').left.residueField x)) ≠
        D.S i (IsLocalRing.closedPoint F'') := by
    intro i h
    exact hxS i (htx ▸ h)
  have hℓκ : ¬ ℓ ∣ Nat.card ((wcP1Over F'').left.residueField x) := by
    rw [hcard]
    intro h
    exact hℓ ((Fact.out : ℓ.Prime).dvd_of_dvd_pow h)
  obtain ⟨ε, hε, hεφ⟩ := wc_frobNbhd_point_fibre_data F'' d hd x hx N hfin
  exact main ((wcP1Over F'').left.residueField x) hℓκ ((wcP1Over F'').left.fromSpecResidueField x)
    ht ε (N.hx.trans htx.symm) hε hεφ

theorem wc_pencilGeomOffS_connected (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    ConnectedSpace (wcPencilGeomOffS D hP).left :=
by
  obtain ⟨Ub, hUb, hUbc, -, -, -⟩ := wc_P1bar_smooth_locus F'' hP D.m D.S D.hS
  have hSig := (wc_P1_sections_closed_generize F'' D.m D.S D.hS).1
  have hO : ∀ p : (wcP1Over F'').left, p ∈ ((wcPencilSOpen D : (wcP1Over F'').left.Opens) :
      Set (wcP1Over F'').left) ↔ ∀ i, p ≠ D.S i (IsLocalRing.closedPoint F'') := by
    intro p
    show p ∈ (⋃ i, closure {D.S i (IsLocalRing.closedPoint F'')})ᶜ ↔ _
    rw [Set.mem_compl_iff, Set.mem_iUnion]
    constructor
    · intro h i hpi
      exact h ⟨i, by rw [hpi]; exact subset_closure (Set.mem_singleton _)⟩
    · rintro h ⟨i, hi⟩
      have hsub : closure {D.S i (IsLocalRing.closedPoint F'')} ⊆
          {p : (wcP1Over F'').left | ∃ i : Fin D.m, p = D.S i (IsLocalRing.closedPoint F'')} :=
        closure_minimal (fun q hq => ⟨i, hq⟩) hSig
      obtain ⟨k, hk⟩ := hsub hi
      exact h k hk
  change ConnectedSpace
    ↥(Limits.pullback (wcPencilSOpen D).ι (wcGeomPoint F'' (wcP1Over F'') hP).hom)
  have hrange : Set.range
      (Limits.pullback.snd (wcPencilSOpen D).ι (wcGeomPoint F'' (wcP1Over F'') hP).hom) =
      (Ub : Set (wcGeomPoint F'' (wcP1Over F'') hP).left) := by
    rw [Scheme.Pullback.range_snd, Scheme.Opens.range_ι]
    ext q
    rw [Set.mem_preimage, hO, SetLike.mem_coe, hUb]
  have hUconn : _root_.IsConnected (Ub : Set (wcGeomPoint F'' (wcP1Over F'') hP).left) := by
    rw [← Scheme.Opens.range_ι Ub]
    exact isConnected_range Ub.ι.continuous
  rw [← hrange] at hUconn
  have hind : Topology.IsInducing
      (Limits.pullback.snd (wcPencilSOpen D).ι (wcGeomPoint F'' (wcP1Over F'') hP).hom) :=
    (Limits.pullback.snd (wcPencilSOpen D).ι
      (wcGeomPoint F'' (wcP1Over F'') hP).hom).isOpenEmbedding.isEmbedding.isInducing
  have hpre : _root_.IsPreconnected (Set.univ :
      Set ↥(Limits.pullback (wcPencilSOpen D).ι (wcGeomPoint F'' (wcP1Over F'') hP).hom)) := by
    rw [← hind.isPreconnected_image, Set.image_univ]
    exact hUconn.isPreconnected
  haveI : Nonempty
      ↥(Limits.pullback (wcPencilSOpen D).ι (wcGeomPoint F'' (wcP1Over F'') hP).hom) :=
    Set.range_nonempty_iff_nonempty.mp hUconn.nonempty
  exact connectedSpace_iff_univ.mpr ⟨Set.univ_nonempty, hpre⟩

theorem wc_proet_connected_GC_ext0_basis (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (τ : ℚ_[ℓ] → (G ⟶ G))
    (hτ1 : τ 1 = 𝟙 G) (hτm : ∀ a b, τ (a * b) = τ b ≫ τ a)
    (hτa : ∀ a b, τ (a + b) = τ a + τ b)
    (W : S.ProEt) (hW : ConnectedSpace W.left) (r : ℕ)
    (θ : G.over W ≅ (wcContSheaf S (Fin r → ℚ_[ℓ])).over W) :
    ∃ (r' : ℕ) (e : Abelian.Ext (wcFreeSheaf S W) G 0 ≃+ (Fin r' → ℚ_[ℓ])),
      ∀ (c : ℚ_[ℓ]) (y : Abelian.Ext (wcFreeSheaf S W) G 0),
        e ((Abelian.Ext.mk₀ (τ c)).postcomp (wcFreeSheaf S W) (add_zero 0) y) = c • e y :=
by
  classical

  obtain ⟨ev, hpost, -⟩ := wc_free_ext0_eval S

  haveI : Nonempty W.left := hW.toNonempty
  let w₀ : W.left := Classical.choice inferInstance
  have hconst : ∀ (f : C(W.left, Fin r → ℚ_[ℓ])) (x : W.left), f x = f w₀ := by
    intro f x
    exact (isPreconnected_range f.continuous).subsingleton (Set.mem_range_self x)
      (Set.mem_range_self w₀)
  let X₀ : Over W := Over.mk (𝟙 W)
  let τe : G.obj.obj (Opposite.op W) ≃+ ULift.{u+1} C(W.left, Fin r → ℚ_[ℓ]) :=
    (((sheafToPresheaf _ _).mapIso θ).app (Opposite.op X₀)).addCommGroupIsoToAddEquiv
  let evw : ULift.{u+1} C(W.left, Fin r → ℚ_[ℓ]) ≃+ (Fin r → ℚ_[ℓ]) :=
    { toFun := fun F => F.down w₀
      invFun := fun m => ULift.up (ContinuousMap.const _ m)
      left_inv := fun F => ULift.ext _ _ (ContinuousMap.ext fun x => (hconst F.down x).symm)
      right_inv := fun m => rfl
      map_add' := fun F F' => rfl }
  let β : G.obj.obj (Opposite.op W) ≃+ (Fin r → ℚ_[ℓ]) := τe.trans evw
  have hlin : ∀ ψ : G ⟶ G, ∃ A : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]),
      ∀ s : G.obj.obj (Opposite.op W), β ((ψ.hom.app (Opposite.op W)).hom s) = A (β s) := by
    intro ψ
    let ψ' : (wcContSheaf S (Fin r → ℚ_[ℓ])).over W ⟶ (wcContSheaf S (Fin r → ℚ_[ℓ])).over W :=
      θ.inv ≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map ψ ≫ θ.hom
    obtain ⟨A, hA⟩ := wc_contSheaf_over_hom_linear S ℓ W hW r r ψ'
    have hkey : θ.hom ≫ ψ' =
        ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map ψ ≫ θ.hom := by
      show θ.hom ≫ θ.inv ≫ _ = _
      rw [Iso.hom_inv_id_assoc]
    rw [hA] at hkey
    refine ⟨A, fun s => ?_⟩
    have h1 := NatTrans.congr_app (congrArg (fun f => f.hom) hkey) (Opposite.op X₀)
    have h2 := congrArg ULift.down (ConcreteCategory.congr_hom h1 s)
    have h3 := congrArg (fun f : C(W.left, Fin r → ℚ_[ℓ]) => f w₀) h2
    exact h3.symm
  choose A hA using hlin

  let e₁ : Abelian.Ext (wcFreeSheaf S W) G 0 ≃+ (Fin r → ℚ_[ℓ]) := (ev W G).trans β
  let ρ : ℚ_[ℓ] → Abelian.Ext (wcFreeSheaf S W) G 0 →+ Abelian.Ext (wcFreeSheaf S W) G 0 :=
    fun c => (Abelian.Ext.mk₀ (τ c)).postcomp (wcFreeSheaf S W) (add_zero 0)
  have hK : ∀ c y, e₁ (ρ c y) = A (τ c) (e₁ y) := by
    intro c y
    show β (ev W G (ρ c y)) = A (τ c) (β (ev W G y))
    rw [show ev W G (ρ c y) = ((τ c).hom.app (Opposite.op W)).hom (ev W G y) from
      hpost W G G (τ c) y]
    exact hA (τ c) (ev W G y)
  let σ : ℚ_[ℓ] → Abelian.Ext (wcFreeSheaf S W) G 0 →+ Abelian.Ext (wcFreeSheaf S W) G 0 :=
    fun d => e₁.symm.toAddMonoidHom.comp
      ((DistribSMul.toAddMonoidHom (Fin r → ℚ_[ℓ]) d).comp e₁.toAddMonoidHom)
  have hσ : ∀ (d : ℚ_[ℓ]) x, e₁ (σ d x) = d • e₁ x := fun d x => e₁.apply_symm_apply _
  have h1 : ∀ x, ρ 1 x = x := by
    intro x
    show x.comp (Abelian.Ext.mk₀ (τ 1)) (add_zero 0) = x
    rw [hτ1]
    exact Abelian.Ext.comp_mk₀_id x
  have hmul : ∀ a b x, ρ (a * b) x = ρ a (ρ b x) := by
    intro a b x
    show x.comp (Abelian.Ext.mk₀ (τ (a * b))) (add_zero 0) =
      (x.comp (Abelian.Ext.mk₀ (τ b)) (add_zero 0)).comp (Abelian.Ext.mk₀ (τ a)) (add_zero 0)
    rw [hτm, ← Abelian.Ext.mk₀_comp_mk₀]
    exact (Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (add_zero 0) rfl).symm
  have hadd : ∀ a b x, ρ (a + b) x = ρ a x + ρ b x := by
    intro a b x
    show x.comp (Abelian.Ext.mk₀ (τ (a + b))) (add_zero 0) =
      x.comp (Abelian.Ext.mk₀ (τ a)) (add_zero 0) + x.comp (Abelian.Ext.mk₀ (τ b)) (add_zero 0)
    rw [hτa, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add]
  have hcomm : ∀ c d x, ρ c (σ d x) = σ d (ρ c x) := by
    intro c d x
    apply e₁.injective
    rw [hK, hσ, hσ, hK, map_smul]
  obtain ⟨r', e', he'⟩ := wc_ring_action_findim_of_commuting ℓ σ ρ r e₁ hσ h1 hmul hadd hcomm
  exact ⟨r', e', he'⟩

theorem wc_proet_geomConst_section_of_local (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (B0 V : S.ProEt) (s : V ⟶ B0)
    (A : Type u) [CommRing A] [IsLocalRing A] (e : V.left ≅ Spec (.of A)) (r : ℕ)
    (θ : G.over B0 ≅ (wcContSheaf S (Fin r → ℚ_[ℓ])).over B0)
    (w : G.obj.obj (Opposite.op V)) :
    ∃ c : G.obj.obj (Opposite.op B0), (G.obj.map s.op).hom c = w :=
by
  classical

  let v₀ : V.left := e.inv (IsLocalRing.closedPoint A)
  have hconst : ∀ (f : C(V.left, Fin r → ℚ_[ℓ])) (x : V.left), f x = f v₀ := by
    intro f x
    have h1 : e.hom x ⤳ (IsLocalRing.closedPoint A : Spec (.of A)) :=
      IsLocalRing.specializes_closedPoint (R := A) (e.hom x)
    have h2 : e.inv (e.hom x) ⤳ v₀ := h1.map (Scheme.Hom.continuous e.inv)
    rw [Scheme.hom_inv_apply] at h2
    exact (h2.map f.continuous).eq

  let Xs : Over B0 := Over.mk s
  let XB : Over B0 := Over.mk (𝟙 B0)
  let hX : Xs ⟶ XB := Over.homMk s (Category.comp_id s)
  let τV : G.obj.obj (Opposite.op V) ≃+ ULift.{u+1} C(V.left, Fin r → ℚ_[ℓ]) :=
    (((sheafToPresheaf _ _).mapIso θ).app (Opposite.op Xs)).addCommGroupIsoToAddEquiv
  let τB : G.obj.obj (Opposite.op B0) ≃+ ULift.{u+1} C(B0.left, Fin r → ℚ_[ℓ]) :=
    (((sheafToPresheaf _ _).mapIso θ).app (Opposite.op XB)).addCommGroupIsoToAddEquiv

  have key : ∀ c : G.obj.obj (Opposite.op B0),
      (τV ((G.obj.map s.op).hom c)).down = (τB c).down.comp s.left.base.hom := by
    intro c
    exact congrArg ULift.down
      (congrArg (fun f => AddCommGrpCat.Hom.hom f c) (θ.hom.hom.naturality hX.op))

  let m : Fin r → ℚ_[ℓ] := (τV w).down v₀
  refine ⟨τB.symm (ULift.up (ContinuousMap.const B0.left m)), ?_⟩
  apply τV.injective
  apply ULift.ext
  apply ContinuousMap.ext
  intro x
  rw [key, ContinuousMap.comp_apply, AddEquiv.apply_symm_apply, ContinuousMap.const_apply]
  exact (hconst _ x).symm

theorem wc_proet_ext0_restrict_bijective_of_GC (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (W V : S.ProEt) (g : V ⟶ W)
    (hW : ConnectedSpace W.left) (r : ℕ)
    (θ : G.over W ≅ (wcContSheaf S (Fin r → ℚ_[ℓ])).over W)
    (A : Type u) [CommRing A] [IsLocalRing A] (e : V.left ≅ Spec (.of A)) :
    Function.Bijective ((Abelian.Ext.mk₀ (wcFreeSheafMap S g)).precomp G (zero_add 0)) :=
by
  obtain ⟨ev, -, hpre⟩ := wc_free_ext0_eval S
  have hst : ∀ y, ev V G ((Abelian.Ext.mk₀ (wcFreeSheafMap S g)).precomp G (zero_add 0) y) =
      (G.obj.map g.op).hom (ev W G y) := fun y => hpre W V g G y
  refine ⟨?_, ?_⟩
  · rw [injective_iff_map_eq_zero]
    intro y hy
    have ha : (G.obj.map g.op).hom (ev W G y) = 0 := by
      rw [← hst, hy, map_zero]
    have hrig := wc_proet_rigid_on_connected_constant S G ℓ r W W (𝟙 W) hW θ (ev W G y) V g
      (e.inv (IsLocalRing.closedPoint A)) (g.left (e.inv (IsLocalRing.closedPoint A))) rfl ha
    have h0 : ev W G y = 0 := by
      simpa using hrig
    exact (ev W G).map_eq_zero_iff.mp h0
  · intro z
    obtain ⟨c, hc⟩ := wc_proet_geomConst_section_of_local S ℓ G W V g A e r θ (ev V G z)
    refine ⟨(ev W G).symm c, (ev V G).injective ?_⟩
    rw [hst, AddEquiv.apply_symm_apply, hc]

theorem wc_P1_strict_local_offS_map (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (V : (wcP1Over F'').left.ProEt) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (e : V.left ≅ Spec (.of A))
    (hoff : ∀ i, V.hom (e.inv (IsLocalRing.closedPoint A)) ≠ D.S i (IsLocalRing.closedPoint F'')) :
    Nonempty (V ⟶ wcPencilGeomOffS D hP) :=
by
  classical
  obtain ⟨h⟩ := wc_P1_strict_local_geomPoint_map F'' hP V A e
  have hh : h.left ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom = V.hom := MorphismProperty.Over.w h
  have hSig := (wc_P1_sections_closed_generize F'' D.m D.S D.hS).1
  have hspec : ∀ v : V.left, V.hom v ⤳ V.hom (e.inv (IsLocalRing.closedPoint A)) := by
    intro v
    have h1 : e.hom v ⤳ IsLocalRing.closedPoint A := IsLocalRing.specializes_closedPoint _
    have h2 := (h1.map e.inv.continuous).map V.hom.continuous
    have h3 : e.inv (e.hom v) = v := by
      rw [← Scheme.Hom.comp_apply, Iso.hom_inv_id]; rfl
    rwa [h3] at h2
  have hO : ∀ v : V.left, V.hom v ∈ wcPencilSOpen D := by
    intro v
    show V.hom v ∈ (⋃ i, closure {D.S i (IsLocalRing.closedPoint F'')})ᶜ
    simp only [Set.mem_compl_iff, Set.mem_iUnion, not_exists]
    intro i hmem
    have hc := (hspec v).mem_closed isClosed_closure hmem
    have hsub : closure {D.S i (IsLocalRing.closedPoint F'')} ⊆
        {p | ∃ j, p = D.S j (IsLocalRing.closedPoint F'')} :=
      closure_minimal (Set.singleton_subset_iff.mpr ⟨i, rfl⟩) hSig
    obtain ⟨j, hj⟩ := hsub hc
    exact hoff j hj
  have hrange : Set.range V.hom ⊆ Set.range (wcPencilSOpen D).ι := by
    rintro _ ⟨v, rfl⟩
    rw [Scheme.Opens.range_ι]
    exact hO v
  let u := IsOpenImmersion.lift (wcPencilSOpen D).ι V.hom hrange
  have hu : u ≫ (wcPencilSOpen D).ι = V.hom := IsOpenImmersion.lift_fac _ _ _
  let g := Limits.pullback.lift u h.left (hu.trans hh.symm)
  have hg : g ≫ (Limits.pullback.snd (wcPencilSOpen D).ι (wcGeomPoint F'' (wcP1Over F'') hP).hom ≫
      (wcGeomPoint F'' (wcP1Over F'') hP).hom) = V.hom := by
    rw [Limits.pullback.lift_snd_assoc, hh]
  exact ⟨MorphismProperty.Over.homMk g hg trivial⟩

theorem wc_frobNbhd_geomFrob_iterate_comm (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (x : (wcP1Over K).left) (d : ℕ) (N : wcFrobNbhd K x d)
    (g : N.V ⟶ wcGeomPoint K (wcP1Over K) hP)
    (t : ℕ → (wcGeomPoint K (wcP1Over K) hP ⟶ wcGeomPoint K (wcP1Over K) hP))
    (ht0 : t 0 = 𝟙 _) (hts : ∀ j, t (j + 1) = wcGeomFrob K (wcP1Over K) hP ≫ t j) :
    N.φ ≫ g = g ≫ t d :=
by
  classical
  letI := N.ringA
  haveI := N.hensA

  obtain ⟨σ, hσdef⟩ : ∃ σ : AlgebraicClosure K ≃ₐ[K] AlgebraicClosure K,
      σ = @FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K)
        (AlgebraicClosure K) _ _ _ := ⟨_, rfl⟩
  have hσapp : ∀ a : AlgebraicClosure K, σ a = a ^ Nat.card K := by
    intro a
    rw [hσdef, FiniteField.frobeniusAlgEquivOfAlgebraic_apply,
      @Nat.card_eq_fintype_card K (Fintype.ofFinite K)]
  have hσinv : ∀ y : AlgebraicClosure K, (σ.symm y) ^ Nat.card K = y := by
    intro y
    rw [← hσapp, AlgEquiv.apply_symm_apply]
  obtain ⟨ρ, hρdef⟩ : ∃ ρ : ℕ → (AlgebraicClosure K →+* AlgebraicClosure K),
      ∀ j, ρ j = ((σ.symm ^ j : AlgebraicClosure K ≃ₐ[K] AlgebraicClosure K) :
        AlgebraicClosure K →+* AlgebraicClosure K) :=
    ⟨fun j => ((σ.symm ^ j : AlgebraicClosure K ≃ₐ[K] AlgebraicClosure K) :
        AlgebraicClosure K →+* AlgebraicClosure K), fun j => rfl⟩
  have hρapp : ∀ j b, ρ j b = (σ.symm ^ j) b := by
    intro j b
    rw [hρdef]
    rfl
  have hρ0 : ρ 0 = RingHom.id _ := by
    refine RingHom.ext fun b => ?_
    rw [hρapp, pow_zero, AlgEquiv.one_apply, RingHom.id_apply]
  have hρs : ∀ j, ((σ.symm : AlgebraicClosure K ≃ₐ[K] AlgebraicClosure K) :
      AlgebraicClosure K →+* AlgebraicClosure K).comp (ρ j) = ρ (j + 1) := by
    intro j
    refine RingHom.ext fun b => ?_
    rw [RingHom.comp_apply, hρapp, hρapp, pow_succ' σ.symm j, AlgEquiv.mul_apply]
    try rfl
  have hρK : ∀ j, (ρ j).comp (algebraMap K (AlgebraicClosure K)) =
      algebraMap K (AlgebraicClosure K) := by
    intro j
    refine RingHom.ext fun a => ?_
    rw [RingHom.comp_apply, hρapp, AlgEquiv.commutes]
  have hroot : ∀ j (b : AlgebraicClosure K), (ρ j b) ^ (Nat.card K ^ j) = b := by
    intro j
    induction j with
    | zero => intro b; rw [hρ0, RingHom.id_apply, pow_zero, pow_one]
    | succ j ih =>
      intro b
      rw [hρapp, pow_succ' σ.symm j, AlgEquiv.mul_apply, pow_succ' (Nat.card K) j, pow_mul,
        hσinv, ← hρapp, ih]

  have s1 : ∀ u v : AlgebraicClosure K →+* N.A,
      u.comp (algebraMap K (AlgebraicClosure K)) = v.comp (algebraMap K (AlgebraicClosure K)) →
      (∀ b, u b - v b ∈ IsLocalRing.maximalIdeal N.A) → u = v := by
    intro u v huv hm
    refine RingHom.ext fun b => ?_
    have hsep : IsCoprime (minpoly K b) (Polynomial.derivative (minpoly K b)) :=
      Algebra.IsSeparable.isSeparable K b
    obtain ⟨a₁, a₂, hab⟩ := hsep
    have hx : ((minpoly K b).map (u.comp (algebraMap K (AlgebraicClosure K)))).eval (u b) = 0 := by
      rw [Polynomial.eval_map, ← Polynomial.hom_eval₂, ← Polynomial.aeval_def, minpoly.aeval,
        map_zero]
    have hy : ((minpoly K b).map (u.comp (algebraMap K (AlgebraicClosure K)))).eval (v b) = 0 := by
      rw [huv, Polynomial.eval_map, ← Polynomial.hom_eval₂, ← Polynomial.aeval_def, minpoly.aeval,
        map_zero]
    obtain ⟨F, hF⟩ : ∃ F : Polynomial N.A,
        F = (minpoly K b).map (u.comp (algebraMap K (AlgebraicClosure K))) := ⟨_, rfl⟩
    rw [← hF] at hx hy
    have hB := congrArg
      (fun p => (p.map (u.comp (algebraMap K (AlgebraicClosure K)))).eval (u b)) hab
    simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_one, Polynomial.eval_add,
      Polynomial.eval_mul, Polynomial.eval_one] at hB
    rw [← Polynomial.derivative_map, ← hF, hx, mul_zero, zero_add] at hB
    have hunit : IsUnit ((Polynomial.derivative F).eval (u b)) := by
      have h0 : IsUnit (((a₂.map (u.comp (algebraMap K (AlgebraicClosure K)))).eval (u b)) *
          (Polynomial.derivative F).eval (u b)) := by
        rw [hB]; exact isUnit_one
      exact (IsUnit.mul_iff.mp h0).2
    obtain ⟨k₀, hk⟩ := Polynomial.binomExpansion F (u b) (v b - u b)
    have e : u b + (v b - u b) = v b := by ring
    rw [e, hy, hx] at hk
    have hw : (v b - u b) * ((Polynomial.derivative F).eval (u b) + k₀ * (v b - u b)) = 0 := by
      linear_combination -hk
    have hwu : IsUnit ((Polynomial.derivative F).eval (u b) + k₀ * (v b - u b)) := by
      by_contra hcon
      have h1 : (Polynomial.derivative F).eval (u b) + k₀ * (v b - u b) ∈
          IsLocalRing.maximalIdeal N.A := (IsLocalRing.mem_maximalIdeal _).mpr hcon
      have h2 : v b - u b ∈ IsLocalRing.maximalIdeal N.A := by
        have := neg_mem (hm b)
        rwa [neg_sub] at this
      have h3 : (Polynomial.derivative F).eval (u b) ∈ IsLocalRing.maximalIdeal N.A := by
        have := sub_mem h1 ((IsLocalRing.maximalIdeal N.A).mul_mem_left k₀ h2)
        rwa [add_sub_cancel_right] at this
      exact (IsLocalRing.mem_maximalIdeal _).mp h3 hunit
    have := (hwu.mul_left_eq_zero).mp hw
    exact (sub_eq_zero.mp this).symm

  obtain ⟨gl, hgl⟩ : ∃ gl : N.V.left ⟶ Limits.pullback (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))), gl = g.left :=
    ⟨g.left, rfl⟩
  obtain ⟨tl, htl⟩ : ∃ tl : ℕ → (Limits.pullback (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) ⟶
      Limits.pullback (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))),
      ∀ j, tl j = (t j).left := ⟨fun j => (t j).left, fun j => rfl⟩
  obtain ⟨Fl, hFl⟩ : ∃ Fl : Limits.pullback (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) ⟶
      Limits.pullback (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))),
      Fl = (wcGeomFrob K (wcP1Over K) hP).left := ⟨_, rfl⟩
  have htl0 : tl 0 = 𝟙 _ := by
    rw [htl, ht0]
    try rfl
  have htls : ∀ j, tl (j + 1) = Fl ≫ tl j := by
    intro j
    rw [htl, htl, hFl, hts j]
    all_goals first | rfl | exact MorphismProperty.Comma.comp_left _ _
  have hg : gl ≫ Limits.pullback.fst (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) = N.V.hom := by
    rw [hgl]
    exact MorphismProperty.Over.w g
  have htfst : ∀ j, tl j ≫ Limits.pullback.fst (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) =
      Limits.pullback.fst (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) := by
    intro j
    rw [htl]
    exact MorphismProperty.Over.w (t j)
  have hFr : Fl ≫ Limits.pullback.snd (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) =
      Limits.pullback.snd (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) ≫
      Spec.map (CommRingCat.ofHom ((σ.symm : AlgebraicClosure K ≃ₐ[K] AlgebraicClosure K) :
        AlgebraicClosure K →+* AlgebraicClosure K)) := by
    rw [hFl, hσdef]
    first
      | exact Limits.pullback.lift_snd _ _ _
      | (change Limits.pullback.map _ _ _ _ (𝟙 _) _ (𝟙 _) _ _ ≫ _ = _
         exact Limits.pullback.lift_snd _ _ _)
      | (unfold wcGeomFrob; erw [Limits.pullback.lift_snd])
      | simp [wcGeomFrob]
  have hiter : ∀ j, tl j ≫ Limits.pullback.snd (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) =
      Limits.pullback.snd (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) ≫
      Spec.map (CommRingCat.ofHom (ρ j)) := by
    intro j
    induction j with
    | zero =>
      rw [htl0, Category.id_comp, hρ0, CommRingCat.ofHom_id, Spec.map_id, Category.comp_id]
    | succ j ih =>
      rw [htls, Category.assoc, ih, ← Category.assoc, hFr, Category.assoc, ← Spec.map_comp,
        ← CommRingCat.ofHom_comp, hρs]

  obtain ⟨H, hH⟩ : ∃ H : CommRingCat.of (AlgebraicClosure K) ⟶ CommRingCat.of N.A,
      Spec.map H = N.e.inv ≫ gl ≫ Limits.pullback.snd (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) :=
    ⟨Spec.preimage _, Spec.map_preimage _⟩
  have hh : Spec.map (CommRingCat.ofHom H.hom) = N.e.inv ≫ gl ≫ Limits.pullback.snd
      (wcP1Over K).hom (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) := by
    rw [CommRingCat.ofHom_hom]
    exact hH
  have hφ : N.e.inv ≫ N.φ.left = Spec.map (CommRingCat.ofHom N.ψ) ≫ N.e.inv := by
