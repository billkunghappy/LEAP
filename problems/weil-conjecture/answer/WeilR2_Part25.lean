      (hSj.extClass.precomp G (rfl : 1 + q = 1 + q)) hTh hCj
      (fun x₁ hx₁ => Abelian.Ext.contravariant_sequence_exact₁ hSj G x₁ rfl hx₁)

  have liftV : ∀ {S : Scheme.{u}} {T To Th' VT' : S.ProEt} (incl : To ⟶ T)
      (hι : IsOpenImmersion incl.left) (x : T.left) (hx : Set.range incl.left = {x}ᶜ)
      (g' : Th' ⟶ T) (j' : VT' ⟶ Th') (c : Th'.left) (hpre' : g'.left ⁻¹' {x} = {c})
