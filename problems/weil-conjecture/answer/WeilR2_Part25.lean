      hε Ω a₀ L eΩ hΩ xb hxb Th g B eB hpre hfib Fm rW rT hsq hpb k hk1
    obtain ⟨v₀, hv₀⟩ := wc_pencil_milnor_tube_vanishing_class F' F'' Y n hn hn2 D ℓ hℓ i V₀ A e
      ε hv hε Ω a₀ L eΩ hΩ xb hxb Th g B eB hpre hfib Fm rW rT hsq hpb Tη j hj hrange ρ hρ k hk1
    have hH1 : Nat.card (AddSubgroup.zmultiples
        ((Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left ρ)).comp v₀ (zero_add (n - 1)))) =
        addOrderOf ((Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left ρ)).comp v₀ (zero_add (n - 1))) :=
      Nat.card_zmultiples _
    have hH2 : Nat.card (AddSubgroup.zmultiples
        ((Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left ρ)).comp v₀ (zero_add (n - 1)))) ≤
        Nat.card (Abelian.Ext (wcFreeSheaf D.Yt.left Fm)
          (wcContSheaf D.Yt.left (ZMod (ℓ ^ k))) (n - 1)) :=
      Nat.card_le_card_of_injective _ Subtype.val_injective
    haveI : Finite (AddSubgroup.zmultiples
        ((Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left ρ)).comp v₀ (zero_add (n - 1)))) :=
      Subtype.finite
    have hHtop := AddSubgroup.eq_top_of_card_eq (AddSubgroup.zmultiples
        ((Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left ρ)).comp v₀ (zero_add (n - 1))))
      (by omega)
    have hw : w ∈ AddSubgroup.zmultiples
        ((Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left ρ)).comp v₀ (zero_add (n - 1))) := by
      rw [hHtop]; exact AddSubgroup.mem_top w
    obtain ⟨z, hz⟩ := AddSubgroup.mem_zmultiples_iff.mp hw
    refine ⟨z • v₀, ?_⟩
    exact (map_zsmul ((Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left ρ)).precomp
      (wcContSheaf D.Yt.left (ZMod (ℓ ^ k))) (zero_add (n - 1))) z v₀).trans hz

theorem wc_pencil_milnor_fibre_zmod_frob_sq (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V₀ : (wcP1Over F'').left.ProEt) (φ₀ : V₀ ⟶ V₀)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom (D.S i) ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom (D.S i))
    (hεφ : ε.inv ≫ Limits.pullback.fst V₀.hom (D.S i) ≫ φ₀.left =
      Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
        (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
          AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫
        ε.inv ≫ Limits.pullback.fst V₀.hom (D.S i))
    (Ω : (wcP1Over F'').left.ProEt) (a₀ : Ω ⟶ V₀) (φΩ : Ω ⟶ Ω) (hφΩ : φΩ ≫ a₀ = a₀ ≫ φ₀)
    (L : Type u) [Field L] [IsSepClosed L] (eΩ : Ω.left ≅ Spec (.of L))
    (hΩ : ∀ (z : Ω.left) (j : Fin D.m), Ω.hom z ≠ D.S j (IsLocalRing.closedPoint F''))
    (xb : ((wcProEtPullback D.f).obj V₀).left)
    (hxb : ((wcProEtPullback D.f).obj V₀).hom xb = D.xs i (IsLocalRing.closedPoint F''))
    (Th : D.Yt.left.ProEt) (g : Th ⟶ (wcProEtPullback D.f).obj V₀) (φh : Th ⟶ Th)
    (hφh : φh ≫ g = g ≫ (wcProEtPullback D.f).map φ₀)
    (B : Type u) [CommRing B] [IsNoetherianRing B] [HenselianLocalRing B]
    [IsSepClosed (IsLocalRing.ResidueField B)] (eB : Th.left ≅ Spec (.of B))
    (hpre : g.left ⁻¹' {xb} = {eB.inv (IsLocalRing.closedPoint B)})
    (hfib : IsIso (Limits.pullback.snd g.left
      (((wcProEtPullback D.f).obj V₀).left.fromSpecResidueField xb)))
    (Fm : D.Yt.left.ProEt) (rW : Fm ⟶ (wcProEtPullback D.f).obj Ω) (rT : Fm ⟶ Th)
    (φF : Fm ⟶ Fm)
    (hsq : rT ≫ g = rW ≫ (wcProEtPullback D.f).map a₀)
    (hpb : IsPullback rT.left rW.left g.left ((wcProEtPullback D.f).map a₀).left)
    (hφW : φF ≫ rW = rW ≫ (wcProEtPullback D.f).map φΩ) (hφT : φF ≫ rT = rT ≫ φh)
    (k : ℕ) :
    ∀ w : Abelian.Ext (wcFreeSheaf D.Yt.left Fm) (wcContSheaf D.Yt.left (ZMod (ℓ ^ k))) (n - 1),
      (Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left φF)).comp
          ((Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left φF)).comp w (zero_add (n - 1)))
          (zero_add (n - 1)) = (Nat.card F'' ^ n) • w :=
by
  classical
  intro w

  have hSi : IsClosedImmersion (D.S i) := by
    haveI : IsClosedImmersion (D.S i ≫ (wcP1Over F'').hom) := by
      rw [D.hS i]; infer_instance
    haveI : IsSeparated (wcP1Over F'').hom := by
      show IsSeparated (@Proj.toSpecZero _ _ _ _ _
          (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') MvPolynomial.gradedAlgebra ≫
        Spec.map (CommRingCat.ofHom (algebraMap F''
          ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'' 0))))
      infer_instance
    exact IsClosedImmersion.of_comp (D.S i) (wcP1Over F'').hom
  have hrS : Set.range (D.S i) = {D.S i (IsLocalRing.closedPoint F'')} := by
    ext y
    constructor
    · rintro ⟨x, rfl⟩
      rw [Set.mem_singleton_iff, Subsingleton.elim x (IsLocalRing.closedPoint F'')]
    · intro h
      rw [Set.mem_singleton_iff] at h
      exact ⟨_, h.symm⟩
  have hcl : IsClosed ({D.S i (IsLocalRing.closedPoint F'')} : Set (wcP1Over F'').left) := by
    rw [← hrS]; exact (D.S i).isClosedEmbedding.isClosed_range
  let O : Th.left.Opens :=
    ⟨{z | D.f (Th.hom z) ≠ D.S i (IsLocalRing.closedPoint F'')},
      hcl.isOpen_compl.preimage (D.f.continuous.comp Th.hom.continuous)⟩
  have hO : O ≤ φh.left ⁻¹ᵁ O := by
    intro z hz
    have h1 : Th.hom (φh.left z) = Th.hom z := by
      rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w φh]
    show D.f (Th.hom (φh.left z)) ≠ D.S i (IsLocalRing.closedPoint F'')
    rw [h1]; exact hz
  have hrT : Set.range rT.left ⊆ Set.range O.ι := by
    rintro _ ⟨z, rfl⟩
    rw [Scheme.Opens.range_ι]
    show D.f (Th.hom (rT.left z)) ≠ D.S i (IsLocalRing.closedPoint F'')
    have h1 : Th.hom (rT.left z) = ((wcProEtPullback D.f).obj Ω).hom (rW.left z) := by
      rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w rT, ← Scheme.Hom.comp_apply,
        MorphismProperty.Over.w rW]
    have h2 : ((wcProEtPullback D.f).obj Ω).hom ≫ D.f =
        Limits.pullback.fst Ω.hom D.f ≫ Ω.hom := Limits.pullback.condition.symm
    have h3 := congrArg (fun h => h (rW.left z)) h2
    simp only [Scheme.Hom.comp_apply] at h3
    rw [h1, h3]
    exact hΩ _ i
  obtain ⟨Tη, j, ρ, φT, hj, hrange, hρ, hφTj, hρφ⟩ : ∃ (Tη : D.Yt.left.ProEt) (j : Tη ⟶ Th)
      (ρ : Fm ⟶ Tη) (φT : Tη ⟶ Tη), IsOpenImmersion j.left ∧
      Set.range j.left = {z | D.f (Th.hom z) ≠ D.S i (IsLocalRing.closedPoint F'')} ∧
      ρ ≫ j = rT ∧ φT ≫ j = j ≫ φh ∧ φF ≫ ρ = ρ ≫ φT := by
    haveI hOι : IsOpenImmersion O.ι := inferInstance
    let j : wcVRes D.Yt.left Th O ⟶ Th := MorphismProperty.Over.homMk O.ι rfl trivial
    let φT : wcVRes D.Yt.left Th O ⟶ wcVRes D.Yt.left Th O := wcVResEndo D.Yt.left Th φh O hO
    let ρl : Fm.left ⟶ (O : Scheme) := @IsOpenImmersion.lift _ _ _ O.ι rT.left hOι hrT
    have hl1 : ρl ≫ O.ι = rT.left := @IsOpenImmersion.lift_fac _ _ _ O.ι rT.left hOι hrT
    let ρ : Fm ⟶ wcVRes D.Yt.left Th O :=
      MorphismProperty.Over.homMk ρl
        (by
          show ρl ≫ (O.ι ≫ Th.hom) = Fm.hom
          rw [← Category.assoc, hl1, MorphismProperty.Over.w rT]) trivial
    have hl2 : φT.left ≫ O.ι = O.ι ≫ φh.left := Scheme.Hom.resLE_comp_ι _ _
    have hl3 : φF.left ≫ rT.left = rT.left ≫ φh.left := by
      have h := congrArg (fun t => t.left) hφT
      exact h
    refine ⟨wcVRes D.Yt.left Th O, j, ρ, φT, ?_, ?_, ?_, ?_, ?_⟩
    · show IsOpenImmersion O.ι
      infer_instance
    · show Set.range O.ι = _
      rw [Scheme.Opens.range_ι]
      rfl
    · apply MorphismProperty.Over.Hom.ext
      show ρl ≫ O.ι = rT.left
      exact hl1
    · apply MorphismProperty.Over.Hom.ext
      show φT.left ≫ O.ι = O.ι ≫ φh.left
      exact hl2
    · apply MorphismProperty.Over.Hom.ext
      show φF.left ≫ ρl = ρl ≫ φT.left
      apply (cancel_mono O.ι).mp
      have e3 : ρl ≫ (φT.left ≫ O.ι) = ρl ≫ (O.ι ≫ φh.left) :=
        congrArg (fun t => ρl ≫ t) hl2
      calc (φF.left ≫ ρl) ≫ O.ι = φF.left ≫ (ρl ≫ O.ι) := Category.assoc _ _ _
        _ = φF.left ≫ rT.left := congrArg (fun t => φF.left ≫ t) hl1
        _ = rT.left ≫ φh.left := hl3
        _ = (ρl ≫ O.ι) ≫ φh.left := (congrArg (fun t => t ≫ φh.left) hl1).symm
        _ = ρl ≫ (O.ι ≫ φh.left) := Category.assoc _ _ _
        _ = ρl ≫ (φT.left ≫ O.ι) := e3.symm
        _ = (ρl ≫ φT.left) ≫ O.ι := (Category.assoc _ _ _).symm

  have hfun : ∀ {A₁ B₁ C₁ : D.Yt.left.ProEt} (a : A₁ ⟶ B₁) (b : B₁ ⟶ C₁),
      wcFreeSheafMap D.Yt.left (a ≫ b) =
        wcFreeSheafMap D.Yt.left a ≫ wcFreeSheafMap D.Yt.left b := by
    intro A₁ B₁ C₁ a b
    have h := (presheafToSheaf (Scheme.ProEt.topology D.Yt.left) AddCommGrpCat.{u+1}).map_comp
      (Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
      (Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    first
      | rw [← Functor.whiskerRight_comp, ← yoneda.map_comp] at h
      | rw [← Functor.comp_whiskerRight, ← yoneda.map_comp] at h
    exact h
  have hcompr : ∀ {V₁ V₂ V₃ : D.Yt.left.ProEt} (a : V₁ ⟶ V₂) (b : V₂ ⟶ V₃)
      (y : Abelian.Ext (wcFreeSheaf D.Yt.left V₃) (wcContSheaf D.Yt.left (ZMod (ℓ ^ k))) (n - 1)),
      (Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left a)).comp
          ((Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left b)).comp y (zero_add (n - 1)))
          (zero_add (n - 1)) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left (a ≫ b))).comp y (zero_add (n - 1)) := by
    intro V₁ V₂ V₃ a b y
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc, ← hfun]

  obtain ⟨v, rfl⟩ := wc_pencil_milnor_tube_restr_surj F' F'' Y n hn hn2 D ℓ hℓ i V₀ A e ε hv hε
    Ω a₀ L eΩ hΩ xb hxb Th g B eB hpre hfib Fm rW rT hsq hpb Tη j hj hrange ρ hρ k w
  have hT := wc_pencil_milnor_tube_zmod_frob_sq F' F'' Y n hn hn2 D ℓ hℓ i V₀ φ₀ A e ε hv hε hεφ
    xb hxb Th g φh hφh B eB hpre hfib Tη j hj hrange φT hφTj k v
  rw [hcompr φF ρ, hρφ, hcompr φF (ρ ≫ φT), ← Category.assoc, hρφ, Category.assoc,
    ← hcompr ρ (φT ≫ φT), ← hcompr φT φT, hT]
  exact map_nsmul ((Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left ρ)).precomp _ (zero_add (n - 1)))
    _ v

theorem wc_pencil_milnor_fibre_frob_sq (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V₀ : (wcP1Over F'').left.ProEt) (φ₀ : V₀ ⟶ V₀)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom (D.S i) ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom (D.S i))
    (hεφ : ε.inv ≫ Limits.pullback.fst V₀.hom (D.S i) ≫ φ₀.left =
      Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
        (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
          AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫
        ε.inv ≫ Limits.pullback.fst V₀.hom (D.S i))
    (Ω : (wcP1Over F'').left.ProEt) (a₀ : Ω ⟶ V₀) (φΩ : Ω ⟶ Ω) (hφΩ : φΩ ≫ a₀ = a₀ ≫ φ₀)
    (L : Type u) [Field L] [IsSepClosed L] (eΩ : Ω.left ≅ Spec (.of L))
    (hΩ : ∀ (z : Ω.left) (j : Fin D.m), Ω.hom z ≠ D.S j (IsLocalRing.closedPoint F''))
    (xb : ((wcProEtPullback D.f).obj V₀).left)
    (hxb : ((wcProEtPullback D.f).obj V₀).hom xb = D.xs i (IsLocalRing.closedPoint F''))
    (Th : D.Yt.left.ProEt) (g : Th ⟶ (wcProEtPullback D.f).obj V₀) (φh : Th ⟶ Th)
    (hφh : φh ≫ g = g ≫ (wcProEtPullback D.f).map φ₀)
    (B : Type u) [CommRing B] [IsNoetherianRing B] [HenselianLocalRing B]
    [IsSepClosed (IsLocalRing.ResidueField B)] (eB : Th.left ≅ Spec (.of B))
    (hpre : g.left ⁻¹' {xb} = {eB.inv (IsLocalRing.closedPoint B)})
    (hfib : IsIso (Limits.pullback.snd g.left
      (((wcProEtPullback D.f).obj V₀).left.fromSpecResidueField xb)))
    (Fm : D.Yt.left.ProEt) (rW : Fm ⟶ (wcProEtPullback D.f).obj Ω) (rT : Fm ⟶ Th)
    (φF : Fm ⟶ Fm)
    (hsq : rT ≫ g = rW ≫ (wcProEtPullback D.f).map a₀)
    (hpb : IsPullback rT.left rW.left g.left ((wcProEtPullback D.f).map a₀).left)
    (hφW : φF ≫ rW = rW ≫ (wcProEtPullback D.f).map φΩ) (hφT : φF ≫ rT = rT ≫ φh) :
    ∀ w : Abelian.Ext (wcFreeSheaf D.Yt.left Fm) (wcLadicSheaf D.Yt.left ℓ) (n - 1),
      (Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left φF)).comp
          ((Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left φF)).comp w (zero_add (n - 1)))
          (zero_add (n - 1)) = (Nat.card F'' ^ n) • w :=
by
  classical
  intro w
  have hℓ0 : ℓ ≠ 0 := (Fact.out : ℓ.Prime).ne_zero
  have hc : ∀ k : ℕ, Continuous ((PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom) := fun k =>
    ((continuous_apply k).comp (wc_padic_tower_facts ℓ).1).congr (fun _ => rfl)

  obtain ⟨hΩc, hΩq, -, -⟩ := wc_pencil_nbhd_qcqs F' F'' Y n D Ω L eΩ
  obtain ⟨-, hVq, -, -⟩ := wc_pencil_nbhd_qcqs F' F'' Y n D V₀ A e
  haveI := hΩc
  haveI := hΩq
  haveI := hVq
  haveI hThc : CompactSpace Th.left := (Scheme.homeoOfIso eB.symm).compactSpace
  haveI hThq : QuasiSeparatedSpace Th.left := quasiSeparatedSpace_of_quasiSeparated eB.hom
  haveI hgc : QuasiCompact g.left := quasiCompact_of_compactSpace g.left
  haveI hgs : QuasiSeparated g.left := QuasiSeparated.of_quasiSeparatedSpace g.left
  haveI hrWc : QuasiCompact rW.left := MorphismProperty.of_isPullback (P := @QuasiCompact) hpb hgc
  haveI hrWs : QuasiSeparated rW.left :=
    MorphismProperty.of_isPullback (P := @QuasiSeparated) hpb hgs
  haveI hFc : CompactSpace Fm.left := QuasiCompact.compactSpace_of_compactSpace rW.left
  haveI hFq : QuasiSeparatedSpace Fm.left := quasiSeparatedSpace_of_quasiSeparated rW.left

  have hfin := wc_pencil_milnor_fibre_zmod_finite F' F'' Y n hn hn2 D ℓ hℓ i V₀ A e ε hv hε
    Ω a₀ L eΩ hΩ xb hxb Th g B eB hpre hfib Fm rW rT hsq hpb
  have htor := fun k => wc_pencil_milnor_fibre_zmod_frob_sq F' F'' Y n hn hn2 D ℓ hℓ i V₀ φ₀ A e
    ε hv hε hεφ Ω a₀ φΩ hφΩ L eΩ hΩ xb hxb Th g φh hφh B eB hpre hfib Fm rW rT φF hsq hpb hφW
    hφT k

  have Q1 : ∀ (S : Scheme.{u}) (P : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (jd N : ℕ)
      (x : Abelian.Ext P (wcLadicSheaf S ℓ) jd),
      N • x = x.comp (Abelian.Ext.mk₀ (wcLadicScalar S ℓ (N : ℚ_[ℓ]))) (add_zero jd) := by
    intro S P jd N x
    obtain ⟨h1, -, hadd⟩ := wc_ladic_scalar_ring S ℓ
    induction N with
    | zero =>
      have h0 : wcLadicScalar S ℓ 0 = 0 := by
        have h := congrArg (fun t => t - wcLadicScalar S ℓ 0) (hadd 0 0)
        simp only [add_zero, sub_self, add_sub_cancel_right] at h
        exact h.symm
      rw [zero_nsmul, Nat.cast_zero, h0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    | succ N ih =>
      rw [succ_nsmul, ih, Nat.cast_succ, hadd, h1, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add,
        Abelian.Ext.comp_mk₀_id]
  have hinv : ∀ (S : Scheme.{u}) (P : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (jd : ℕ)
      (x : Abelian.Ext P (wcLadicSheaf S ℓ) jd) (c : ℚ_[ℓ]), c ≠ 0 →
      (x.comp (Abelian.Ext.mk₀ (wcLadicScalar S ℓ c)) (add_zero jd)).comp
        (Abelian.Ext.mk₀ (wcLadicScalar S ℓ c⁻¹)) (add_zero jd) = x := by
    intro S P jd x c hc0
    obtain ⟨h1, hmul, -⟩ := wc_ladic_scalar_ring S ℓ
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, ← hmul,
      inv_mul_cancel₀ hc0, h1, Abelian.Ext.comp_mk₀_id]

  have hpost : ∀ {G G' : Sheaf (Scheme.ProEt.topology D.Yt.left) AddCommGrpCat.{u+1}}
      (r : G ⟶ G') (z z' : Abelian.Ext (wcFreeSheaf D.Yt.left Fm) G (n - 1)) (N : ℕ),
      (z - N • z').comp (Abelian.Ext.mk₀ r) (add_zero (n - 1)) =
        z.comp (Abelian.Ext.mk₀ r) (add_zero (n - 1)) -
          N • z'.comp (Abelian.Ext.mk₀ r) (add_zero (n - 1)) := by
    intro G G' r z z' N
    have h1 := map_sub ((Abelian.Ext.mk₀ r).postcomp
      (wcFreeSheaf D.Yt.left Fm) (add_zero (n - 1))) z (N • z')
    have h2 := map_nsmul ((Abelian.Ext.mk₀ r).postcomp
      (wcFreeSheaf D.Yt.left Fm) (add_zero (n - 1))) N z'
    rw [h2] at h1
    exact h1
  have hpreS : ∀ {G : Sheaf (Scheme.ProEt.topology D.Yt.left) AddCommGrpCat.{u+1}}
      (z : Abelian.Ext (wcFreeSheaf D.Yt.left Fm) G (n - 1)) (N : ℕ),
      (Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left φF)).comp (N • z) (zero_add (n - 1)) =
        N • (Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left φF)).comp z (zero_add (n - 1)) := by
    intro G z N
    exact map_nsmul ((Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left φF)).precomp
      G (zero_add (n - 1))) N z
  have hlev : ∀ {G G' : Sheaf (Scheme.ProEt.topology D.Yt.left) AddCommGrpCat.{u+1}}
      (r : G ⟶ G') (z : Abelian.Ext (wcFreeSheaf D.Yt.left Fm) G (n - 1)),
      ((Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left φF)).comp
        ((Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left φF)).comp z
          (zero_add (n - 1))) (zero_add (n - 1)) - (Nat.card F'' ^ n) • z).comp
          (Abelian.Ext.mk₀ r) (add_zero (n - 1)) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left φF)).comp
          ((Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left φF)).comp
            (z.comp (Abelian.Ext.mk₀ r) (add_zero (n - 1))) (zero_add (n - 1)))
            (zero_add (n - 1)) -
          (Nat.card F'' ^ n) • z.comp (Abelian.Ext.mk₀ r) (add_zero (n - 1)) := by
    intro G G' r z
    rw [hpost, Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.comp_assoc_of_third_deg_zero]

  obtain ⟨a, y, hy⟩ := (proet_qcqs_ladic_rationalization D.Yt.left Fm ℓ (n - 1)).1 w

  have hy2 : (Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left φF)).comp
      ((Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left φF)).comp y
        (zero_add (n - 1))) (zero_add (n - 1)) = (Nat.card F'' ^ n) • y := by
    rw [← sub_eq_zero]
    refine wc_proet_int_separated_of_finite D.Yt.left Fm ℓ hc hfin (n - 1) _ ?_
    intro k
    refine (hlev (wcContSheafMap D.Yt.left
      (PadicInt.toZModPow (p := ℓ) k).toAddMonoidHom (hc k)) y).trans ?_
    rw [htor k, sub_self]

  have hD : ℓ ^ a • ((Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left φF)).comp
      ((Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left φF)).comp w
        (zero_add (n - 1))) (zero_add (n - 1)) - (Nat.card F'' ^ n) • w) = 0 := by
    rw [smul_sub, smul_comm (ℓ ^ a) (Nat.card F'' ^ n) w, ← hpreS, ← hpreS, hy,
      ← Abelian.Ext.comp_assoc_of_third_deg_zero, ← Abelian.Ext.comp_assoc_of_third_deg_zero,
      ← hpost, hy2, sub_self, Abelian.Ext.zero_comp]

  have hz : (Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left φF)).comp
      ((Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left φF)).comp w
        (zero_add (n - 1))) (zero_add (n - 1)) - (Nat.card F'' ^ n) • w = 0 := by
    have h5 := hinv _ _ (n - 1) ((Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left φF)).comp
      ((Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left φF)).comp w
        (zero_add (n - 1))) (zero_add (n - 1)) - (Nat.card F'' ^ n) • w) ((ℓ : ℚ_[ℓ]) ^ a)
      (pow_ne_zero _ (Nat.cast_ne_zero.mpr hℓ0))
    rw [show ((ℓ : ℚ_[ℓ]) ^ a) = ((ℓ ^ a : ℕ) : ℚ_[ℓ]) from (Nat.cast_pow ℓ a).symm, ← Q1, hD,
      Abelian.Ext.zero_comp] at h5
    exact h5.symm
  exact sub_eq_zero.mp hz

theorem wc_pencil_R_geom_generic_frob_sq (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (i : Fin D.m) (V₀ : (wcP1Over F'').left.ProEt)
    (g₀ : V₀ ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (φ₀ : V₀ ⟶ V₀)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom (D.S i) ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (hφg : φ₀ ≫ g₀ = g₀ ≫ wcGeomFrob F'' (wcP1Over F'') hP)
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom (D.S i))
    (hεφ : ε.inv ≫ Limits.pullback.fst V₀.hom (D.S i) ≫ φ₀.left =
      Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
        (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
          AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫
        ε.inv ≫ Limits.pullback.fst V₀.hom (D.S i))
    (Ω : (wcP1Over F'').left.ProEt) (a₀ : Ω ⟶ V₀) (φΩ : Ω ⟶ Ω) (hφΩ : φΩ ≫ a₀ = a₀ ≫ φ₀)
    (L : Type u) [Field L] [IsSepClosed L] (eΩ : Ω.left ≅ Spec (.of L))
    (hΩ : ∀ (z : Ω.left) (j : Fin D.m), Ω.hom z ≠ D.S j (IsLocalRing.closedPoint F'')) :
    ∀ t : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left Ω) (wcRq D.f ℓ (n - 1)) 0,
      ∃ r : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V₀) (wcRq D.f ℓ (n - 1)) 0,
        (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left φΩ)).comp
            ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left φΩ)).comp t (zero_add 0))
            (zero_add 0) - (Nat.card F'' ^ n) • t =
          (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left a₀)).comp r (zero_add 0) :=
by
  classical
  intro t

  have hfun : ∀ {S : Scheme.{u}} {A₁ B₁ C₁ : S.ProEt} (a : A₁ ⟶ B₁) (b : B₁ ⟶ C₁),
      wcFreeSheafMap S (a ≫ b) = wcFreeSheafMap S a ≫ wcFreeSheafMap S b := by
    intro S A₁ B₁ C₁ a b
    have h := (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_comp
      (Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
      (Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    first
      | rw [← Functor.whiskerRight_comp, ← yoneda.map_comp] at h
      | rw [← Functor.comp_whiskerRight, ← yoneda.map_comp] at h
    exact h
  have hcompr : ∀ {S : Scheme.{u}} {M : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}}
      {k : ℕ} {V₁ V₂ V₃ : S.ProEt} (a : V₁ ⟶ V₂) (b : V₂ ⟶ V₃)
      (y : Abelian.Ext (wcFreeSheaf S V₃) M k),
      (Abelian.Ext.mk₀ (wcFreeSheafMap S a)).comp
          ((Abelian.Ext.mk₀ (wcFreeSheafMap S b)).comp y (zero_add k)) (zero_add k) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap S (a ≫ b))).comp y (zero_add k) := by
    intro S M k V₁ V₂ V₃ a b y
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc, ← hfun]
  have hrs : ∀ {S : Scheme.{u}} {M : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}}
      {k : ℕ} {V V' : S.ProEt} (c : V' ⟶ V) (a b : Abelian.Ext (wcFreeSheaf S V) M k),
      (Abelian.Ext.mk₀ (wcFreeSheafMap S c)).comp (a - b) (zero_add k) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap S c)).comp a (zero_add k) -
          (Abelian.Ext.mk₀ (wcFreeSheafMap S c)).comp b (zero_add k) := by
    intro S M k V V' c a b
    exact map_sub ((Abelian.Ext.mk₀ (wcFreeSheafMap S c)).precomp M (zero_add k)) a b
  have hrn : ∀ {S : Scheme.{u}} {M : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}}
      {k : ℕ} {V V' : S.ProEt} (c : V' ⟶ V) (m : ℕ) (a : Abelian.Ext (wcFreeSheaf S V) M k),
      (Abelian.Ext.mk₀ (wcFreeSheafMap S c)).comp (m • a) (zero_add k) =
        m • (Abelian.Ext.mk₀ (wcFreeSheafMap S c)).comp a (zero_add k) := by
    intro S M k V V' c m a
    exact map_nsmul ((Abelian.Ext.mk₀ (wcFreeSheafMap S c)).precomp M (zero_add k)) m a

  haveI hLres : IsSepClosed (IsLocalRing.ResidueField L) := by
    let eL : L ≃+* IsLocalRing.ResidueField L :=
      RingEquiv.ofBijective (IsLocalRing.residue L)
        ⟨(IsLocalRing.residue L).injective, IsLocalRing.residue_surjective⟩
    refine IsSepClosed.of_exists_root _ (fun p _ hirr hsep => ?_)
    obtain ⟨x, hx⟩ := IsSepClosed.exists_root (p.map eL.symm.toRingHom)
      (by rw [Polynomial.degree_map]; exact (Polynomial.degree_pos_of_irreducible hirr).ne')
      hsep.map
    refine ⟨eL.toRingHom x, ?_⟩
    have hpm : (p.map eL.symm.toRingHom).map eL.toRingHom = p := by
      ext k
      simp [Polynomial.coeff_map]
    rw [← hpm, Polynomial.eval_map, Polynomial.eval₂_at_apply, hx.eq_zero, map_zero]
  have hV₀p : Projective (wcFreeSheaf (wcP1Over F'').left V₀) :=
    wc_proet_free_projective_strict_local _ V₀ A e
  have hΩp : Projective (wcFreeSheaf (wcP1Over F'').left Ω) :=
    wc_proet_free_projective_strict_local _ Ω L eΩ
  obtain ⟨Λ, hΛ⟩ := wc_pencil_Rq_free_ext_transport F' F'' Y n D ℓ (n - 1)

  obtain ⟨xb, hxb, hfix, hnoeth, hsep⟩ :=
    wc_pencil_total_odp_point F' F'' Y n D i V₀ φ₀ A e ε hv hε
  haveI := hnoeth
  obtain ⟨Th, g, φh, B, instB1, instB2, instB3, instB4, eB, VT, j, φV, hφh, hpre, hfib,
      -, -, -, -⟩ :=
    wc_proet_strict_nbhd_of_fixed_point D.Yt.left ((wcProEtPullback D.f).obj V₀) xb
      ((wcProEtPullback D.f).map φ₀) hfix hsep
  have hΩ0 : (wcProEtPullback D.f).map φΩ ≫ (wcProEtPullback D.f).map a₀ =
      (wcProEtPullback D.f).map a₀ ≫ (wcProEtPullback D.f).map φ₀ := by
    rw [← Functor.map_comp, hφΩ, Functor.map_comp]
  obtain ⟨Fm, rW, rT, φF, hsq, hpb, hφW, hφT⟩ :=
    wc_proet_frob_pullback_square D.Yt.left g ((wcProEtPullback D.f).map a₀) φh
      ((wcProEtPullback D.f).map φ₀) ((wcProEtPullback D.f).map φΩ) hφh hΩ0

  have hs4 := wc_pencil_milnor_fibre_frob_sq F' F'' Y n hn hn2 D ℓ hℓ i V₀ φ₀ A e ε hv hε hεφ
    Ω a₀ φΩ hφΩ L eΩ hΩ xb hxb Th g φh hφh B eB hpre hfib Fm rW rT φF hsq hpb hφW hφT
    ((Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left rW)).comp (Λ Ω hΩp t) (zero_add (n - 1)))
  have hm : (rW ≫ (wcProEtPullback D.f).map φΩ) ≫ (wcProEtPullback D.f).map φΩ =
      φF ≫ φF ≫ rW := by
    rw [← hφW, Category.assoc, ← hφW]
  have hres : (Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left rW)).comp
      ((Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left ((wcProEtPullback D.f).map φΩ))).comp
        ((Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left ((wcProEtPullback D.f).map φΩ))).comp
          (Λ Ω hΩp t) (zero_add (n - 1))) (zero_add (n - 1)) -
        (Nat.card F'' ^ n) • (Λ Ω hΩp t)) (zero_add (n - 1)) = 0 := by
    rw [hrs, hrn, hcompr rW, hcompr (rW ≫ _), hm, ← hcompr φF (φF ≫ rW), ← hcompr φF rW, hs4,
      sub_self]

  obtain ⟨y, hy⟩ := wc_pencil_milnor_res_ker_le_sp F' F'' Y n hn hn2 D ℓ hℓ i V₀ A e ε hv hε
    Ω a₀ L eΩ hΩ xb hxb Th g B eB hpre hfib Fm rW rT hsq hpb _ hres

  refine ⟨(Λ V₀ hV₀p).symm y, ?_⟩
  apply (Λ Ω hΩp).injective
  rw [hΛ V₀ Ω hV₀p hΩp a₀, AddEquiv.apply_symm_apply, hy, map_sub, map_nsmul,
    hΛ Ω Ω hΩp hΩp φΩ, hΛ Ω Ω hΩp hΩp φΩ]

theorem wc_envelope_strict_nbhd_frob_sq_mod (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (G P : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1})
    (ι : wcPencilVQ D ℓ hP ⟶ G) (π : G ⟶ P) (hw : ι ≫ π = 0)
    (hSE : (ShortComplex.mk ι π hw).ShortExact) (hG : wcPencilGC F'' hP ℓ G)
    (hsupp : ∀ V : (wcP1Over F'').left.ProEt,
      (∀ (v : V.left) (i : Fin D.m), V.hom v ≠ D.S i (IsLocalRing.closedPoint F'')) →
      ∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V) P 0, y = 0)
    (i : Fin D.m) (V₀ : (wcP1Over F'').left.ProEt)
    (g₀ : V₀ ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (φ₀ : V₀ ⟶ V₀)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V₀.left ≅ Spec (.of A))
    (ε : Limits.pullback V₀.hom (D.S i) ≅ Spec (.of (AlgebraicClosure F'')))
    (hv : V₀.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (hφg : φ₀ ≫ g₀ = g₀ ≫ wcGeomFrob F'' (wcP1Over F'') hP)
    (hε : ε.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) =
      Limits.pullback.snd V₀.hom (D.S i))
    (hεφ : ε.inv ≫ Limits.pullback.fst V₀.hom (D.S i) ≫ φ₀.left =
      Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F'' _
        (Fintype.ofFinite F'') (AlgebraicClosure F'') _ _ _).symm :
          AlgebraicClosure F'' →+* AlgebraicClosure F'')) ≫
        ε.inv ≫ Limits.pullback.fst V₀.hom (D.S i)) :
    ∀ w : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V₀) G 0,
      ∃ u : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V₀) (wcPencilVQ D ℓ hP) 0,
        (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left φ₀)).comp
            ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left φ₀)).comp w (zero_add 0))
            (zero_add 0) - (Nat.card F'' ^ n) • w =
          u.comp (Abelian.Ext.mk₀ ι) (add_zero 0) :=
by
  classical
  intro w

  have hfun : ∀ {A₁ B₁ C₁ : (wcP1Over F'').left.ProEt} (a : A₁ ⟶ B₁) (b : B₁ ⟶ C₁),
      wcFreeSheafMap (wcP1Over F'').left (a ≫ b) =
        wcFreeSheafMap (wcP1Over F'').left a ≫ wcFreeSheafMap (wcP1Over F'').left b := by
    intro A₁ B₁ C₁ a b
    have h := (presheafToSheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}).map_comp
      (Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
      (Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    first
      | rw [← Functor.whiskerRight_comp, ← yoneda.map_comp] at h
      | rw [← Functor.comp_whiskerRight, ← yoneda.map_comp] at h
    exact h

  have hcomm : ∀ {M N : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      (f : M ⟶ N) {V V' : (wcP1Over F'').left.ProEt} (a : V' ⟶ V)
      (y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V) M 0),
      ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left a)).comp y (zero_add 0)).comp
          (Abelian.Ext.mk₀ f) (add_zero 0) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left a)).comp
          (y.comp (Abelian.Ext.mk₀ f) (add_zero 0)) (zero_add 0) := by
    intro M N f V V' a y
    exact Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (add_zero 0) (by omega)

  have hcompr : ∀ {M : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      {V₁ V₂ V₃ : (wcP1Over F'').left.ProEt} (a : V₁ ⟶ V₂) (b : V₂ ⟶ V₃)
      (y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V₃) M 0),
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left a)).comp
          ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left b)).comp y (zero_add 0))
          (zero_add 0) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left (a ≫ b))).comp y (zero_add 0) := by
    intro M V₁ V₂ V₃ a b y
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc, ← hfun]

  have hpost_sub : ∀ {M N : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      (f : M ⟶ N) {V : (wcP1Over F'').left.ProEt}
      (a b : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V) M 0),
      (a - b).comp (Abelian.Ext.mk₀ f) (add_zero 0) =
        a.comp (Abelian.Ext.mk₀ f) (add_zero 0) - b.comp (Abelian.Ext.mk₀ f) (add_zero 0) := by
    intro M N f V a b
    exact map_sub ((Abelian.Ext.mk₀ f).postcomp _ (add_zero 0)) a b
  have hpost_ns : ∀ {M N : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      (f : M ⟶ N) {V : (wcP1Over F'').left.ProEt} (k : ℕ)
      (a : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V) M 0),
      (k • a).comp (Abelian.Ext.mk₀ f) (add_zero 0) = k • a.comp (Abelian.Ext.mk₀ f) (add_zero 0) := by
    intro M N f V k a
    exact map_nsmul ((Abelian.Ext.mk₀ f).postcomp _ (add_zero 0)) k a
  have hpre_sub : ∀ {M : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      {V V' : (wcP1Over F'').left.ProEt} (c : V' ⟶ V)
      (a b : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V) M 0),
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left c)).comp (a - b) (zero_add 0) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left c)).comp a (zero_add 0) -
          (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left c)).comp b (zero_add 0) := by
    intro M V V' c a b
    exact map_sub ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left c)).precomp _
      (zero_add 0)) a b
  have hpre_ns : ∀ {M : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      {V V' : (wcP1Over F'').left.ProEt} (c : V' ⟶ V) (k : ℕ)
      (a : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V) M 0),
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left c)).comp (k • a) (zero_add 0) =
        k • (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left c)).comp a (zero_add 0) := by
    intro M V V' c k a
    exact map_nsmul ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left c)).precomp _
      (zero_add 0)) k a

  have hpushF : ∀ {M N : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      (f : M ⟶ N) {V : (wcP1Over F'').left.ProEt} (φ : V ⟶ V)
      (y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V) M 0),
      ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left φ)).comp
          ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left φ)).comp y (zero_add 0))
          (zero_add 0) - (Nat.card F'' ^ n) • y).comp (Abelian.Ext.mk₀ f) (add_zero 0) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left φ)).comp
          ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left φ)).comp
            (y.comp (Abelian.Ext.mk₀ f) (add_zero 0)) (zero_add 0))
          (zero_add 0) - (Nat.card F'' ^ n) • (y.comp (Abelian.Ext.mk₀ f) (add_zero 0)) := by
    intro M N f V φ y
    rw [hpost_sub, hpost_ns, hcomm, hcomm]

  have hresF : ∀ {M : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      {V V' : (wcP1Over F'').left.ProEt} (a : V' ⟶ V) (φ : V ⟶ V) (φ' : V' ⟶ V')
      (h : φ' ≫ a = a ≫ φ) (y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V) M 0),
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left a)).comp
        ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left φ)).comp
          ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left φ)).comp y (zero_add 0))
          (zero_add 0) - (Nat.card F'' ^ n) • y) (zero_add 0) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left φ')).comp
          ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left φ')).comp
            ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left a)).comp y (zero_add 0))
            (zero_add 0)) (zero_add 0) -
          (Nat.card F'' ^ n) •
            (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left a)).comp y (zero_add 0) := by
    intro M V V' a φ φ' h y
    have hm : (a ≫ φ) ≫ φ = φ' ≫ φ' ≫ a := by
      rw [← h, Category.assoc, ← h]
    rw [hpre_sub, hpre_ns, hcompr a φ, hcompr (a ≫ φ) φ, hcompr φ' a, hcompr φ' (φ' ≫ a), hm]

  have minj : ∀ {M N : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      (f : M ⟶ N) [Mono f] {V : (wcP1Over F'').left.ProEt}
      (x y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V) M 0),
      x.comp (Abelian.Ext.mk₀ f) (add_zero 0) = y.comp (Abelian.Ext.mk₀ f) (add_zero 0) → x = y := by
    intro M N f _ V x y h
    have h' : Abelian.Ext.mk₀ (Abelian.Ext.homEquiv₀ x ≫ f) =
        Abelian.Ext.mk₀ (Abelian.Ext.homEquiv₀ y ≫ f) := by
      rw [← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_homEquiv₀_apply,
        Abelian.Ext.mk₀_homEquiv₀_apply]
      exact h
    have h'' : Abelian.Ext.homEquiv₀ x ≫ f = Abelian.Ext.homEquiv₀ y ≫ f := by
      rw [← Abelian.Ext.homEquiv₀_symm_apply, ← Abelian.Ext.homEquiv₀_symm_apply] at h'
      exact Abelian.Ext.homEquiv₀.symm.injective h'
    have h3 := (cancel_mono f).mp h''
    rw [← Abelian.Ext.mk₀_homEquiv₀_apply x, ← Abelian.Ext.mk₀_homEquiv₀_apply y, h3]

  have hE5 : wcPencilE D ℓ hP = ⊤ ∨
      wcPencilGC F'' hP ℓ (Limits.cokernel (wcPencilE D ℓ hP).arrow) := by
    generalize hX : wcPencilE D ℓ hP = X
    unfold wcPencilE at hX
    split_ifs at hX with h
    · subst hX
      exact Or.inr (Classical.choose_spec h).2.1
    · subst hX
      exact Or.inl rfl

  obtain ⟨Ω, a₀, φΩ, L, instL, instSC, eΩ, hsq, hΩ⟩ :=
    wc_strict_nbhd_frob_geom_generic_point F'' D.m D.S D.hS V₀ φ₀ A e

  haveI hLres : IsSepClosed (IsLocalRing.ResidueField L) := by
    let eL : L ≃+* IsLocalRing.ResidueField L :=
      RingEquiv.ofBijective (IsLocalRing.residue L)
        ⟨(IsLocalRing.residue L).injective, IsLocalRing.residue_surjective⟩
    refine IsSepClosed.of_exists_root _ (fun p _ hirr hsep => ?_)
    obtain ⟨x, hx⟩ := IsSepClosed.exists_root (p.map eL.symm.toRingHom)
      (by rw [Polynomial.degree_map]; exact (Polynomial.degree_pos_of_irreducible hirr).ne')
      hsep.map
    refine ⟨eL.toRingHom x, ?_⟩
    have hpm : (p.map eL.symm.toRingHom).map eL.toRingHom = p := by
      ext k
      simp [Polynomial.coeff_map]
    rw [← hpm, Polynomial.eval_map, Polynomial.eval₂_at_apply, hx.eq_zero, map_zero]
  haveI : Projective (wcFreeSheaf (wcP1Over F'').left Ω) :=
    wc_proet_free_projective_strict_local _ Ω L eΩ
  have hne : Nonempty Ω.left := ⟨eΩ.inv (IsLocalRing.closedPoint L)⟩

  have hP0 : ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left a₀)).comp w (zero_add 0)).comp
      (Abelian.Ext.mk₀ π) (add_zero 0) = 0 := hsupp Ω hΩ _
  obtain ⟨t, ht⟩ := Abelian.Ext.covariant_sequence_exact₂ (wcFreeSheaf (wcP1Over F'').left Ω) hSE _
    hP0
  change t.comp (Abelian.Ext.mk₀ ι) (add_zero 0) =
    (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left a₀)).comp w (zero_add 0) at ht

  let ρ : Subobject.underlying.obj (wcPencilE D ℓ hP) ⟶ wcPencilVQ D ℓ hP :=
    Limits.cokernel.π ((wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP).ofLE (wcPencilE D ℓ hP) inf_le_left)
  haveI : Epi ρ := by
    show Epi (Limits.cokernel.π
      ((wcPencilE D ℓ hP ⊓ wcPencilC D ℓ hP).ofLE (wcPencilE D ℓ hP) inf_le_left))
    infer_instance
  have ht1 : (Abelian.Ext.mk₀ (Projective.factorThru (Abelian.Ext.homEquiv₀ t) ρ)).comp
      (Abelian.Ext.mk₀ ρ) (add_zero 0) = t := by
    rw [Abelian.Ext.mk₀_comp_mk₀, Projective.factorThru_comp, Abelian.Ext.mk₀_homEquiv₀_apply]

  obtain ⟨r, hr⟩ := wc_pencil_R_geom_generic_frob_sq F' F'' Y n hn hn2 D ℓ hℓ hP i V₀ g₀ φ₀ A e ε
    hv hφg hε hεφ Ω a₀ φΩ hsq L eΩ hΩ
    ((Abelian.Ext.mk₀ (Projective.factorThru (Abelian.Ext.homEquiv₀ t) ρ)).comp
      (Abelian.Ext.mk₀ (wcPencilE D ℓ hP).arrow) (add_zero 0))

  have hd : ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left φΩ)).comp
        ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left φΩ)).comp
          (Abelian.Ext.mk₀ (Projective.factorThru (Abelian.Ext.homEquiv₀ t) ρ)) (zero_add 0))
        (zero_add 0) - (Nat.card F'' ^ n) •
          Abelian.Ext.mk₀ (Projective.factorThru (Abelian.Ext.homEquiv₀ t) ρ)).comp
        (Abelian.Ext.mk₀ (wcPencilE D ℓ hP).arrow) (add_zero 0) =
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left a₀)).comp r (zero_add 0) := by
    rw [hpushF]
    exact hr
  have hκΩ : (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left a₀)).comp
      (r.comp (Abelian.Ext.mk₀ (Limits.cokernel.π (wcPencilE D ℓ hP).arrow)) (add_zero 0))
      (zero_add 0) = 0 := by
    rw [← hcomm, ← hd, Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀ (wcPencilE D ℓ hP).arrow
        (Limits.cokernel.π (wcPencilE D ℓ hP).arrow), Limits.cokernel.condition, Abelian.Ext.mk₀_zero,
      Abelian.Ext.comp_zero]
  have hκ0 : r.comp (Abelian.Ext.mk₀ (Limits.cokernel.π (wcPencilE D ℓ hP).arrow)) (add_zero 0)
      = 0 := by
    rcases hE5 with hE | hE
    · have hZ : Limits.IsZero (Limits.cokernel (wcPencilE D ℓ hP).arrow) := by
        haveI : IsIso (wcPencilE D ℓ hP).arrow := by
          rw [hE]
          exact Subobject.isIso_top_arrow
        exact Limits.isZero_cokernel_of_epi _
      have h1 := hZ.eq_zero_of_tgt (Abelian.Ext.homEquiv₀
        (r.comp (Abelian.Ext.mk₀ (Limits.cokernel.π (wcPencilE D ℓ hP).arrow)) (add_zero 0)))
      rw [← Abelian.Ext.mk₀_homEquiv₀_apply
        (r.comp (Abelian.Ext.mk₀ (Limits.cokernel.π (wcPencilE D ℓ hP).arrow)) (add_zero 0)),
        h1, Abelian.Ext.mk₀_zero]
    · exact wc_gc_strict_local_res_injective F'' hP ℓ _ hE V₀ g₀ A e Ω a₀ hne _ hκΩ
  have hSE2 : (ShortComplex.mk (wcPencilE D ℓ hP).arrow
      (Limits.cokernel.π (wcPencilE D ℓ hP).arrow) (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) (Subobject.arrow_mono _)
      inferInstance
  obtain ⟨e₀, he₀⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hSE2 r hκ0
  change e₀.comp (Abelian.Ext.mk₀ (wcPencilE D ℓ hP).arrow) (add_zero 0) = r at he₀
  haveI := Subobject.arrow_mono (wcPencilE D ℓ hP)
  have hcmp : (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left a₀)).comp e₀ (zero_add 0) =
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left φΩ)).comp
        ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left φΩ)).comp
          (Abelian.Ext.mk₀ (Projective.factorThru (Abelian.Ext.homEquiv₀ t) ρ)) (zero_add 0))
        (zero_add 0) - (Nat.card F'' ^ n) •
          Abelian.Ext.mk₀ (Projective.factorThru (Abelian.Ext.homEquiv₀ t) ρ) := by
    apply minj (wcPencilE D ℓ hP).arrow
    rw [hcomm, he₀, hd]

  refine ⟨e₀.comp (Abelian.Ext.mk₀ ρ) (add_zero 0), ?_⟩
  rw [← sub_eq_zero]
  apply wc_gc_strict_local_res_injective F'' hP ℓ G hG V₀ g₀ A e Ω a₀ hne
  rw [hpre_sub, hresF a₀ φ₀ φΩ hsq w, ← ht, ← hpushF ι φΩ t, ← hcomm ι a₀, ← hcomm ρ a₀, hcmp,
    hpushF ρ φΩ, ht1, sub_self]

theorem wc_pencil_VQ_envelope_punct_frob_sq (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (G P : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1})
    (ι : wcPencilVQ D ℓ hP ⟶ G) (π : G ⟶ P) (hw : ι ≫ π = 0)
    (hSE : (ShortComplex.mk ι π hw).ShortExact) (hG : wcPencilGC F'' hP ℓ G)
    (hsupp : ∀ V : (wcP1Over F'').left.ProEt,
      (∀ (v : V.left) (i : Fin D.m), V.hom v ≠ D.S i (IsLocalRing.closedPoint F'')) →
      ∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V) P 0, y = 0) :
    ∀ y : wcCohG F'' (wcP1Over F'') hP P 0,
      wcCohGFrob F'' (wcP1Over F'') hP P 0 (wcCohGFrob F'' (wcP1Over F'') hP P 0 y) =
        (Nat.card F'' ^ n) • y :=
by
  classical
  intro y

  have hfun : ∀ {A B C : (wcP1Over F'').left.ProEt} (a : A ⟶ B) (b : B ⟶ C),
      wcFreeSheafMap (wcP1Over F'').left (a ≫ b) =
        wcFreeSheafMap (wcP1Over F'').left a ≫ wcFreeSheafMap (wcP1Over F'').left b := by
    intro A B C a b
    have h := (presheafToSheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}).map_comp
      (Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
      (Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    first
      | rw [← Functor.whiskerRight_comp, ← yoneda.map_comp] at h
      | rw [← Functor.comp_whiskerRight, ← yoneda.map_comp] at h
    exact h

  have huniq : ∀ (i : Fin D.m) (p p' : (wcGeomPoint F'' (wcP1Over F'') hP).left),
      (wcGeomPoint F'' (wcP1Over F'') hP).hom p = D.S i (IsLocalRing.closedPoint F'') →
      (wcGeomPoint F'' (wcP1Over F'') hP).hom p' = D.S i (IsLocalRing.closedPoint F'') →
      p = p' := by
    intro i p p' hp hp'
    obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))
      (g := D.S i) p (IsLocalRing.closedPoint F'') hp
    obtain ⟨z', hz1', -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))
      (g := D.S i) p' (IsLocalRing.closedPoint F'') hp'
    haveI : IsIso (D.S i ≫ (wcP1Over F'').hom) := by rw [D.hS i]; infer_instance
    let e := Limits.pullbackSymmetry (Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) (D.S i) ≪≫
      Limits.pullbackRightPullbackFstIso (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) (D.S i) ≪≫
      asIso (Limits.pullback.snd (D.S i ≫ (wcP1Over F'').hom)
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))
    have hsub : Subsingleton (Spec (.of (AlgebraicClosure F''))) := by
      show Subsingleton (PrimeSpectrum (AlgebraicClosure F''))
      infer_instance
    have hzz : z = z' := e.hom.isOpenEmbedding.injective (Subsingleton.elim _ _)
    rw [← hz1, ← hz1', hzz]

  have hloc : ∀ i : Fin D.m, ∃ (V : (wcP1Over F'').left.ProEt)
      (g : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (v : V.left),
      V.hom v = D.S i (IsLocalRing.closedPoint F'') ∧
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g)).comp
        (wcCohGFrob F'' (wcP1Over F'') hP P 0 (wcCohGFrob F'' (wcP1Over F'') hP P 0 y) -
          (Nat.card F'' ^ n) • y) (zero_add 0) = 0 := by
    intro i
    obtain ⟨V₀, g₀, φ₀, A, _, _, _, e, ε, hv, hφg, hε, hεφ⟩ :=
      wc_P1bar_strict_local_nbhd F'' (D.S i) (D.hS i) hP
    refine ⟨V₀, g₀, e.inv (IsLocalRing.closedPoint A), hv, ?_⟩

    have hkey : ∀ x : wcCohG F'' (wcP1Over F'') hP P 0,
        (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g₀)).comp
          (wcCohGFrob F'' (wcP1Over F'') hP P 0 x) (zero_add 0) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left φ₀)).comp
          ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g₀)).comp x (zero_add 0))
          (zero_add 0) := by
      intro x
      show (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g₀)).comp
        ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left
          (wcGeomFrob F'' (wcP1Over F'') hP))).comp x (zero_add 0)) (zero_add 0) = _
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Abelian.Ext.mk₀_comp_mk₀_assoc, ← hfun, ← hfun, hφg]

    have e1 : (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g₀)).comp
        (wcCohGFrob F'' (wcP1Over F'') hP P 0 (wcCohGFrob F'' (wcP1Over F'') hP P 0 y) -
          (Nat.card F'' ^ n) • y) (zero_add 0) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g₀)).comp
          (wcCohGFrob F'' (wcP1Over F'') hP P 0 (wcCohGFrob F'' (wcP1Over F'') hP P 0 y))
          (zero_add 0) -
        (Nat.card F'' ^ n) •
          (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g₀)).comp y (zero_add 0) :=
      map_sub ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g₀)).precomp P
          (zero_add 0)) _ _ |>.trans (congrArg _ (map_nsmul ((Abelian.Ext.mk₀
            (wcFreeSheafMap (wcP1Over F'').left g₀)).precomp P (zero_add 0)) _ y))
    rw [e1, hkey, hkey]

    haveI : Projective (wcFreeSheaf (wcP1Over F'').left V₀) :=
      wc_proet_free_projective_strict_local _ V₀ A e
    haveI : Epi π := hSE.epi_g
    let f₁ := Projective.factorThru (Abelian.Ext.homEquiv₀
      ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g₀)).comp y (zero_add 0))) π
    have hlift : (Abelian.Ext.mk₀ π).postcomp (wcFreeSheaf (wcP1Over F'').left V₀) (add_zero 0)
        (Abelian.Ext.mk₀ f₁) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left g₀)).comp y (zero_add 0) := by
      show (Abelian.Ext.mk₀ f₁).comp (Abelian.Ext.mk₀ π) (add_zero 0) = _
      rw [Abelian.Ext.mk₀_comp_mk₀, Projective.factorThru_comp, Abelian.Ext.mk₀_homEquiv₀_apply]

    obtain ⟨u, hu⟩ := wc_envelope_strict_nbhd_frob_sq_mod F' F'' Y n hn hn2 D ℓ hℓ hP G P ι π hw
      hSE hG hsupp i V₀ g₀ φ₀ A e ε hv hφg hε hεφ (Abelian.Ext.mk₀ f₁)

    have hcommπ : ∀ x : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V₀) G 0,
        (Abelian.Ext.mk₀ π).postcomp (wcFreeSheaf (wcP1Over F'').left V₀) (add_zero 0)
          ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left φ₀)).comp x (zero_add 0)) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left φ₀)).comp
          ((Abelian.Ext.mk₀ π).postcomp (wcFreeSheaf (wcP1Over F'').left V₀) (add_zero 0) x)
          (zero_add 0) := by
      intro x
      show ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left φ₀)).comp x (zero_add 0)).comp
          (Abelian.Ext.mk₀ π) (add_zero 0) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left φ₀)).comp
          (x.comp (Abelian.Ext.mk₀ π) (add_zero 0)) (zero_add 0)
      exact Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (add_zero 0) (by omega)
    have hR : (Abelian.Ext.mk₀ π).postcomp (wcFreeSheaf (wcP1Over F'').left V₀) (add_zero 0)
        (u.comp (Abelian.Ext.mk₀ ι) (add_zero 0)) = 0 := by
      show (u.comp (Abelian.Ext.mk₀ ι) (add_zero 0)).comp (Abelian.Ext.mk₀ π) (add_zero 0) = 0
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, hw, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    have hπ := congrArg ((Abelian.Ext.mk₀ π).postcomp (wcFreeSheaf (wcP1Over F'').left V₀)
      (add_zero 0)) hu
    rw [map_sub, map_nsmul, hcommπ, hcommπ, hR, hlift] at hπ
    exact hπ
  have hz := wc_P1_geom_section_zero_of_local F'' hP P D.m D.S D.hS huniq
    (wcCohGFrob F'' (wcP1Over F'') hP P 0 (wcCohGFrob F'' (wcP1Over F'') hP P 0 y) -
      (Nat.card F'' ^ n) • y)
    (fun V _ hV => hsupp V hV _) hloc
  exact sub_eq_zero.mp hz

theorem wc_P1_H1_geomConst_vanish (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (hG : wcPencilGC K hP ℓ G) :
    ∀ x : wcCohG K (wcP1Over K) hP G 1, x = 0 :=
by
  classical
  have hℓp : ℓ.Prime := Fact.out

  have g1 : ((ℓ : ℕ) : AlgebraicClosure K) ≠ 0 := by
    intro h
    have hK : ((ℓ : ℕ) : K) = 0 := by
      apply (algebraMap K (AlgebraicClosure K)).injective
      rw [map_natCast, map_zero]
      exact h
    haveI := Fintype.ofFinite K
    have hp : (ringChar K).Prime := CharP.char_is_prime K (ringChar K)
    have h1 : ringChar K ∣ ℓ := ringChar.dvd hK
    have h2 : ringChar K = ℓ := (Nat.prime_dvd_prime_iff_eq hp hℓp).mp h1
