          (H.obj.map a.op).hom (β V hV gV y y'))
      (hβL : ∀ (V : (wcP1Over F'').left.ProEt) (hV : Off V) (gV : Good V) (c : ι)
        (y y' : G.obj.obj (Opposite.op V)),
        β V hV gV (((σG c).hom.app (Opposite.op V)).hom y) y' =
          ((σH c).hom.app (Opposite.op V)).hom (β V hV gV y y'))
      (hβA : ∀ (V : (wcP1Over F'').left.ProEt) (hV : Off V) (gV : Good V)
        (y y' : G.obj.obj (Opposite.op V)), β V hV gV y y' = -(β V hV gV y' y)),
      ∃ B' : ∀ V : (wcP1Over F'').left.ProEt, Off V →
          G.obj.obj (Opposite.op V) →+ G.obj.obj (Opposite.op V) →+ H.obj.obj (Opposite.op V),
        (∀ (V V' : (wcP1Over F'').left.ProEt) (hV : Off V) (hV' : Off V') (a : V' ⟶ V)
          (y y' : G.obj.obj (Opposite.op V)),
          B' V' hV' ((G.obj.map a.op).hom y) ((G.obj.map a.op).hom y') =
            (H.obj.map a.op).hom (B' V hV y y')) ∧
        (∀ (V : (wcP1Over F'').left.ProEt) (hV : Off V) (c : ι)
