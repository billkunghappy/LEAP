import WeilR2_Part24
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem wc_pmhpi_hyp_chart_iso (K L : Type u) [Field K] [Field L] [Algebra K L] (e : ℕ) (c₀ : L)
    (k : Fin (e + 1))
    (φ : MvPolynomial (Fin (e + 1)) L →+* wcQuadModelRing L (2 * (e + 1)) c₀
      (Matrix.of fun p q : Fin (2 * (e + 1)) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
    (hφ : φ = (MvPolynomial.aeval (R := L) (fun i : Fin (e + 1) => Ideal.Quotient.mk
      (wcQuadModelIdeal L (2 * (e + 1)) c₀
        (Matrix.of fun p q : Fin (2 * (e + 1)) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
      (MvPolynomial.X (⟨2 * i.val, by omega⟩ : Fin (2 * (e + 1)))))).toRingHom) :
    ∃ Ψ : TensorProduct K (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) L))
        (MvPolynomial (Fin e) K) ≃+* Localization.Away (φ (MvPolynomial.X k)),
      Ψ.toRingHom.comp Algebra.TensorProduct.includeLeftRingHom =
        Localization.awayMap φ (MvPolynomial.X k) :=
by
  classical
  generalize hcH : (Matrix.of fun p q : Fin (2 * (e + 1)) =>
    if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0) = cH at φ hφ ⊢

  have hgen : (∑ p, ∑ q, MvPolynomial.C (cH p q) * MvPolynomial.X p * MvPolynomial.X q -
      MvPolynomial.C c₀ : MvPolynomial (Fin (2 * (e + 1))) L) =
      ∑ i : Fin (e + 1), MvPolynomial.X (⟨2 * i.val, by omega⟩ : Fin (2 * (e + 1))) *
        MvPolynomial.X (⟨2 * i.val + 1, by omega⟩ : Fin (2 * (e + 1))) - MvPolynomial.C c₀ := by
    subst hcH
    congr 1
    rw [← Fintype.sum_prod_type']
    symm
    refine Finset.sum_of_injOn (fun i : Fin (e + 1) =>
      ((⟨2 * i.val, by omega⟩ : Fin (2 * (e + 1))), (⟨2 * i.val + 1, by omega⟩ : Fin (2 * (e + 1)))))
      ?_ ?_ ?_ ?_
    · intro a _ b _ hab
      simp only [Prod.mk.injEq, Fin.mk.injEq] at hab
      exact Fin.ext (by omega)
    · intro a _
      simp
    · intro x _ hx
      have hnot : ¬ (x.1.val % 2 = 0 ∧ x.2.val = x.1.val + 1) := by
        rintro ⟨h1, h2⟩
        apply hx
        refine ⟨⟨x.1.val / 2, by omega⟩, by simp, ?_⟩
        refine Prod.ext (Fin.ext ?_) (Fin.ext ?_)
        · show 2 * (x.1.val / 2) = x.1.val
          omega
        · show 2 * (x.1.val / 2) + 1 = x.2.val
          omega
      simp [Matrix.of_apply, hnot]
    · intro i _
      simp [Matrix.of_apply]

  have hrelA : ∑ i : Fin (e + 1),
      Ideal.Quotient.mk (wcQuadModelIdeal L (2 * (e + 1)) c₀ cH)
          (MvPolynomial.X (⟨2 * i.val, by omega⟩ : Fin (2 * (e + 1)))) *
        Ideal.Quotient.mk (wcQuadModelIdeal L (2 * (e + 1)) c₀ cH)
          (MvPolynomial.X (⟨2 * i.val + 1, by omega⟩ : Fin (2 * (e + 1)))) =
      algebraMap L (wcQuadModelRing L (2 * (e + 1)) c₀ cH) c₀ := by
    have h0 : Ideal.Quotient.mk (wcQuadModelIdeal L (2 * (e + 1)) c₀ cH)
        (∑ p, ∑ q, MvPolynomial.C (cH p q) * MvPolynomial.X p * MvPolynomial.X q -
          MvPolynomial.C c₀) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
    rw [hgen, map_sub, sub_eq_zero, map_sum, ← MvPolynomial.algebraMap_eq,
      Ideal.Quotient.mk_algebraMap] at h0
    simpa only [map_mul] using h0
  have hφX : ∀ i : Fin (e + 1), φ (MvPolynomial.X i) =
      Ideal.Quotient.mk (wcQuadModelIdeal L (2 * (e + 1)) c₀ cH)
        (MvPolynomial.X (⟨2 * i.val, by omega⟩ : Fin (2 * (e + 1)))) := by
    intro i
    rw [hφ]
    exact MvPolynomial.aeval_X _ _
  have hφC : ∀ l : L, φ (MvPolynomial.C l) = algebraMap L (wcQuadModelRing L (2 * (e + 1)) c₀ cH) l := by
    intro l
    rw [hφ]
    exact MvPolynomial.aeval_C _ _

  have hf : ∀ p : MvPolynomial (Fin (e + 1)) L,
      Localization.awayMap φ (MvPolynomial.X k)
        (algebraMap _ (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) L)) p) =
      algebraMap _ (Localization.Away (φ (MvPolynomial.X k))) (φ p) :=
    fun p => IsLocalization.map_eq _ _

  obtain ⟨γ, hγC, hγE, hγO, hγK⟩ : ∃ γ : wcQuadModelRing L (2 * (e + 1)) c₀ cH →+*
      MvPolynomial (Fin e) (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) L)),
      (∀ l : L, γ (algebraMap L _ l) = MvPolynomial.C (algebraMap L _ l)) ∧
      (∀ i : Fin (e + 1), γ (Ideal.Quotient.mk (wcQuadModelIdeal L (2 * (e + 1)) c₀ cH)
          (MvPolynomial.X (⟨2 * i.val, by omega⟩ : Fin (2 * (e + 1))))) =
        MvPolynomial.C (algebraMap (MvPolynomial (Fin (e + 1)) L) _ (MvPolynomial.X i))) ∧
      (∀ j : Fin e, γ (Ideal.Quotient.mk (wcQuadModelIdeal L (2 * (e + 1)) c₀ cH)
          (MvPolynomial.X (⟨2 * (k.succAbove j).val + 1, by omega⟩ : Fin (2 * (e + 1))))) =
        MvPolynomial.X j) ∧
      γ (Ideal.Quotient.mk (wcQuadModelIdeal L (2 * (e + 1)) c₀ cH)
          (MvPolynomial.X (⟨2 * k.val + 1, by omega⟩ : Fin (2 * (e + 1))))) =
        MvPolynomial.C (IsLocalization.Away.invSelf (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) L)) *
          (MvPolynomial.C (algebraMap L _ c₀) -
            ∑ j : Fin e, MvPolynomial.C (algebraMap (MvPolynomial (Fin (e + 1)) L) _
              (MvPolynomial.X (k.succAbove j))) * MvPolynomial.X j) := by
    obtain ⟨t, ht⟩ : ∃ t : MvPolynomial (Fin e)
        (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) L)),
        t = MvPolynomial.C (IsLocalization.Away.invSelf (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) L)) *
          (MvPolynomial.C (algebraMap L _ c₀) -
            ∑ j : Fin e, MvPolynomial.C (algebraMap (MvPolynomial (Fin (e + 1)) L) _
              (MvPolynomial.X (k.succAbove j))) * MvPolynomial.X j) := ⟨_, rfl⟩
    obtain ⟨w, hwk, hws⟩ : ∃ w : Fin (e + 1) → MvPolynomial (Fin e)
        (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) L)),
        w k = t ∧ ∀ j : Fin e, w (k.succAbove j) = MvPolynomial.X j :=
      ⟨Fin.insertNth (α := fun _ => MvPolynomial (Fin e)
          (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) L))) k t
        (fun j => MvPolynomial.X j),
        Fin.insertNth_apply_same _ _ _, fun j => Fin.insertNth_apply_succAbove _ _ _ _⟩
    obtain ⟨v, hvE, hvO⟩ : ∃ v : Fin (2 * (e + 1)) → MvPolynomial (Fin e)
        (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) L)),
        (∀ i : Fin (e + 1), v ⟨2 * i.val, by omega⟩ =
          MvPolynomial.C (algebraMap (MvPolynomial (Fin (e + 1)) L) _ (MvPolynomial.X i))) ∧
        (∀ i : Fin (e + 1), v ⟨2 * i.val + 1, by omega⟩ = w i) := by
      refine ⟨fun p => if p.val % 2 = 0 then
          (if h : p.val / 2 < e + 1 then
            MvPolynomial.C (algebraMap (MvPolynomial (Fin (e + 1)) L) _ (MvPolynomial.X ⟨p.val / 2, h⟩))
          else 0)
        else (if h : p.val / 2 < e + 1 then w ⟨p.val / 2, h⟩ else 0), ?_, ?_⟩
      · intro i
        show (if 2 * i.val % 2 = 0 then _ else _) = _
        rw [if_pos (by omega)]
        simp only [show 2 * i.val / 2 = i.val by omega]
        exact dif_pos i.isLt
      · intro i
        show (if (2 * i.val + 1) % 2 = 0 then _ else _) = _
        rw [if_neg (by omega)]
        simp only [show (2 * i.val + 1) / 2 = i.val by omega]
        exact dif_pos i.isLt
    have hYu : MvPolynomial.C (algebraMap (MvPolynomial (Fin (e + 1)) L)
          (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) L)) (MvPolynomial.X k)) *
        MvPolynomial.C (IsLocalization.Away.invSelf (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) L)) =
        (1 : MvPolynomial (Fin e)
          (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) L))) := by
      rw [← map_mul, IsLocalization.Away.mul_invSelf, map_one]
    have hγ₀gen : MvPolynomial.eval₂Hom ((MvPolynomial.C).comp (algebraMap L
        (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) L)))) v
        (∑ p, ∑ q, MvPolynomial.C (cH p q) * MvPolynomial.X p * MvPolynomial.X q -
          MvPolynomial.C c₀) = 0 := by
      rw [hgen, map_sub, map_sum]
      simp only [map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C, RingHom.comp_apply,
        hvE, hvO]
      rw [Fin.sum_univ_succAbove _ k, hwk]
      simp only [hws]
      rw [ht, ← mul_assoc, hYu, one_mul]
      ring
    refine ⟨Ideal.Quotient.lift (wcQuadModelIdeal L (2 * (e + 1)) c₀ cH)
      (MvPolynomial.eval₂Hom ((MvPolynomial.C).comp (algebraMap L
        (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) L)))) v) ?_, ?_, ?_, ?_, ?_⟩
    · intro a ha
      obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      rw [map_mul, hγ₀gen, mul_zero]
    · intro l
      rw [← Ideal.Quotient.mk_algebraMap, Ideal.Quotient.lift_mk, MvPolynomial.algebraMap_eq,
        MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
    · intro i
      rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X', hvE]
    · intro j
      rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X', hvO, hws]
    · rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X', hvO, hwk, ht]

  obtain ⟨Θ₀, hΘC, hΘX⟩ : ∃ Θ₀ : MvPolynomial (Fin e)
      (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) L)) →+*
        Localization.Away (φ (MvPolynomial.X k)),
      (∀ s, Θ₀ (MvPolynomial.C s) = Localization.awayMap φ (MvPolynomial.X k) s) ∧
      ∀ j : Fin e, Θ₀ (MvPolynomial.X j) = algebraMap _ (Localization.Away (φ (MvPolynomial.X k)))
        (Ideal.Quotient.mk (wcQuadModelIdeal L (2 * (e + 1)) c₀ cH)
          (MvPolynomial.X (⟨2 * (k.succAbove j).val + 1, by omega⟩ : Fin (2 * (e + 1))))) :=
    ⟨MvPolynomial.eval₂Hom _ _, fun s => MvPolynomial.eval₂Hom_C _ _ _,
      fun j => MvPolynomial.eval₂Hom_X' _ _ _⟩

  have hunit : IsUnit (γ (φ (MvPolynomial.X k))) := by
    rw [hφX, hγE]
    exact (IsLocalization.Away.algebraMap_isUnit _).map _
  obtain ⟨Γ, hΓ⟩ : ∃ Γ : Localization.Away (φ (MvPolynomial.X k)) →+* MvPolynomial (Fin e)
      (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) L)),
      ∀ a, Γ (algebraMap _ (Localization.Away (φ (MvPolynomial.X k))) a) = γ a :=
    ⟨IsLocalization.Away.lift (φ (MvPolynomial.X k)) hunit, IsLocalization.Away.lift_eq _ hunit⟩
  have hc : ∀ l : L, Localization.awayMap φ (MvPolynomial.X k)
      (algebraMap L (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) L)) l) =
      algebraMap _ (Localization.Away (φ (MvPolynomial.X k)))
        (algebraMap L (wcQuadModelRing L (2 * (e + 1)) c₀ cH) l) := by
    intro l
    rw [IsScalarTower.algebraMap_apply L (MvPolynomial (Fin (e + 1)) L), hf,
      MvPolynomial.algebraMap_eq, hφC]
  have hΓf : ∀ s, Γ (Localization.awayMap φ (MvPolynomial.X k) s) = MvPolynomial.C s := by
    have h : Γ.comp (Localization.awayMap φ (MvPolynomial.X k)) = MvPolynomial.C := by
      apply IsLocalization.ringHom_ext
        (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) L))
      apply MvPolynomial.ringHom_ext
      · intro l
        simp only [RingHom.comp_apply]
        rw [← MvPolynomial.algebraMap_eq, ← IsScalarTower.algebraMap_apply, hc, hΓ, hγC]
      · intro i
        simp only [RingHom.comp_apply]
        rw [hf, hφX i, hΓ, hγE]
    exact fun s => RingHom.congr_fun h s
  have ha : Γ.comp Θ₀ = RingHom.id _ := by
    apply MvPolynomial.ringHom_ext
    · intro s
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hΘC, hΓf]
    · intro j
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hΘX, hΓ, hγO]
  have hb : Θ₀.comp Γ = RingHom.id _ := by
    apply IsLocalization.ringHom_ext (Submonoid.powers (φ (MvPolynomial.X k)))
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro l
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap, hΓ, hγC, hΘC, hc]
    · intro p
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hΓ]
      have hp := p.isLt
      obtain ⟨i, hi | hi⟩ := Nat.even_or_odd' p.val
      · have hi' : i < e + 1 := by omega
        rw [show p = ⟨2 * (⟨i, hi'⟩ : Fin (e + 1)).val, by omega⟩ from Fin.ext hi]
        rw [hγE, hΘC, hf, hφX ⟨i, hi'⟩]
      · have hi' : i < e + 1 := by omega
        by_cases hik : (⟨i, hi'⟩ : Fin (e + 1)) = k
        · have hk' : k.val = i := by rw [← hik]
          rw [show p = ⟨2 * k.val + 1, by omega⟩ from Fin.ext (by show p.val = 2 * k.val + 1; omega)]
          rw [hγK]
          simp only [map_mul, map_sub, map_sum, hΘC, hΘX, hf, hφX]
          have hrelT := congrArg (algebraMap _ (Localization.Away (φ (MvPolynomial.X k)))) hrelA
          rw [map_sum, Fin.sum_univ_succAbove _ k] at hrelT
          simp only [map_mul] at hrelT
          have hu : Localization.awayMap φ (MvPolynomial.X k)
              (IsLocalization.Away.invSelf (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) L)) *
              algebraMap _ (Localization.Away (φ (MvPolynomial.X k)))
                (Ideal.Quotient.mk (wcQuadModelIdeal L (2 * (e + 1)) c₀ cH)
                  (MvPolynomial.X (⟨2 * k.val, by omega⟩ : Fin (2 * (e + 1))))) = 1 := by
            have hu0 : Localization.awayMap φ (MvPolynomial.X k)
                (IsLocalization.Away.invSelf (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) L)) *
                algebraMap _ (Localization.Away (φ (MvPolynomial.X k))) (φ (MvPolynomial.X k)) = 1 := by
              rw [← hf, ← map_mul, mul_comm (IsLocalization.Away.invSelf _), IsLocalization.Away.mul_invSelf, map_one]
            have h1 : algebraMap _ (Localization.Away (φ (MvPolynomial.X k)))
                (Ideal.Quotient.mk (wcQuadModelIdeal L (2 * (e + 1)) c₀ cH)
                  (MvPolynomial.X (⟨2 * k.val, by omega⟩ : Fin (2 * (e + 1))))) =
                algebraMap _ (Localization.Away (φ (MvPolynomial.X k))) (φ (MvPolynomial.X k)) :=
              congrArg _ (hφX k).symm
            rw [h1]
            exact hu0
          rw [hc]
          linear_combination (-(Localization.awayMap φ (MvPolynomial.X k)
              (IsLocalization.Away.invSelf (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) L)))) * hrelT +
            (algebraMap _ (Localization.Away (φ (MvPolynomial.X k)))
              (Ideal.Quotient.mk (wcQuadModelIdeal L (2 * (e + 1)) c₀ cH)
                (MvPolynomial.X (⟨2 * k.val + 1, by omega⟩ : Fin (2 * (e + 1)))))) * hu
        · obtain ⟨j, hj⟩ := Fin.exists_succAbove_eq hik
          rw [show p = ⟨2 * (k.succAbove j).val + 1, by omega⟩ from
            Fin.ext (by show p.val = 2 * (k.succAbove j).val + 1; rw [hi, hj])]
          rw [hγO, hΘX]

  refine ⟨(MvPolynomial.algebraTensorAlgEquiv K
    (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) L))).toRingEquiv.trans
      (RingEquiv.ofRingHom Θ₀ Γ hb ha), ?_⟩
  refine RingHom.ext fun s => ?_
  change Θ₀ (MvPolynomial.algebraTensorAlgEquiv K _ (s ⊗ₜ[K] (1 : MvPolynomial (Fin e) K))) = _
  rw [MvPolynomial.algebraTensorAlgEquiv_tmul, map_one, MvPolynomial.smul_eq_C_mul, mul_one]
  exact hΘC s

theorem wc_pmhpi_mvpoly_field_bc_isPullback : ∀ (K L : Type u) [CommRing K] [CommRing L] (σ : K →+* L) (m : ℕ), IsPullback (Spec.map (CommRingCat.ofHom (MvPolynomial.map σ : MvPolynomial (Fin m) K →+* MvPolynomial (Fin m) L))) (Spec.map (CommRingCat.ofHom (algebraMap L (MvPolynomial (Fin m) L)))) (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin m) K)))) (Spec.map (CommRingCat.ofHom σ)) :=
by
  intro K L _ _ σ m
  letI : Algebra K L := σ.toAlgebra
  letI : Algebra (MvPolynomial (Fin m) K) (MvPolynomial (Fin m) L) :=
    MvPolynomial.algebraMvPolynomial
  exact AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _
    (CommRingCat.isPushout_of_isPushout K L (MvPolynomial (Fin m) K)
      (MvPolynomial (Fin m) L)).flip

theorem wc_pmhpi_quadric_L_punct_glue (L : Type u) [Field L] (N e : ℕ) (c₀ : L) (hc₀ : c₀ ≠ 0)
    (φ : MvPolynomial (Fin (e + 1)) L →+* wcQuadModelRing L (2 * (e + 1)) c₀
      (Matrix.of fun p q : Fin (2 * (e + 1)) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
    (hφ : φ = (MvPolynomial.aeval (R := L) (fun i : Fin (e + 1) => Ideal.Quotient.mk
      (wcQuadModelIdeal L (2 * (e + 1)) c₀
        (Matrix.of fun p q : Fin (2 * (e + 1)) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
      (MvPolynomial.X (⟨2 * i.val, by omega⟩ : Fin (2 * (e + 1)))))).toRingHom)
    (O : (Spec (.of (MvPolynomial (Fin (e + 1)) L))).Opens)
    (hO : ∀ y : Spec (.of (MvPolynomial (Fin (e + 1)) L)), y ∈ O ↔
      ∃ k : Fin (e + 1), (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) L) ∉ y.asIdeal)
    (hloc : ∀ (k : Fin (e + 1)) (W : (Spec (.of (MvPolynomial (Fin (e + 1)) L))).Opens),
      W ≤ PrimeSpectrum.basicOpen (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) L) →
      ∀ (j : ℕ) (D : wcEtPullData (Spec.map (CommRingCat.ofHom φ) ∣_ W) N),
        Function.Bijective (wcEtPull D j)) :
    Spec.map (CommRingCat.ofHom φ) ⁻¹ᵁ O = ⊤ ∧
      ∀ (j : ℕ) (D : wcEtPullData (Spec.map (CommRingCat.ofHom φ) ∣_ O) N),
        Function.Bijective (wcEtPull D j) :=
by
  have hs6 : Spec.map (CommRingCat.ofHom φ) ⁻¹ᵁ O = ⊤ := by
    subst hφ
    set I := wcQuadModelIdeal L (2 * (e + 1)) c₀ (Matrix.of fun p q : Fin (2 * (e + 1)) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0) with hI
    rw [eq_top_iff]
    intro x _
    rw [Scheme.Hom.mem_preimage, hO]
    by_contra hcon
    push_neg at hcon
    have hk : ∀ k : Fin (e + 1), Ideal.Quotient.mk I (MvPolynomial.X (⟨2 * k.val, by omega⟩ : Fin (2 * (e + 1)))) ∈ x.asIdeal := by
      intro k
      have h' := hcon k
      first
      | exact h'
      | simpa [Spec.map_apply, PrimeSpectrum.comap_asIdeal, Ideal.mem_comap] using h'
      | (erw [Spec.map_apply, PrimeSpectrum.comap_asIdeal, Ideal.mem_comap] at h'; simpa using h')
    have h1 : Ideal.Quotient.mk I (∑ p, ∑ q, MvPolynomial.C ((Matrix.of fun p q : Fin (2 * (e + 1)) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0) p q) * MvPolynomial.X p * MvPolynomial.X q) = Ideal.Quotient.mk I (MvPolynomial.C c₀) := by
      have h0 : Ideal.Quotient.mk I (∑ p, ∑ q, MvPolynomial.C ((Matrix.of fun p q : Fin (2 * (e + 1)) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0) p q) * MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C c₀) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      rw [map_sub, sub_eq_zero] at h0
      exact h0
    have h2 : Ideal.Quotient.mk I (MvPolynomial.C c₀) ∈ x.asIdeal := by
      rw [← h1, map_sum]
      refine Ideal.sum_mem _ (fun p _ => ?_)
      rw [map_sum]
      refine Ideal.sum_mem _ (fun q _ => ?_)
      by_cases hpq : p.val % 2 = 0 ∧ q.val = p.val + 1
      · have hp : p = (⟨2 * (p.val / 2), by omega⟩ : Fin (2 * (e + 1))) := Fin.ext (by simp; omega)
        have hmem := hk ⟨p.val / 2, by omega⟩
        rw [map_mul, map_mul]
        apply Ideal.mul_mem_right
        apply Ideal.mul_mem_left
        rw [hp]
        exact hmem
      · simp [Matrix.of_apply, hpq]
    have hunit : IsUnit (Ideal.Quotient.mk I (MvPolynomial.C c₀)) :=
      ((isUnit_iff_ne_zero.mpr hc₀).map MvPolynomial.C).map (Ideal.Quotient.mk I)
    exact x.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ h2 hunit)
  have hpull_id : ∀ {A : Scheme.{u}} (D : wcEtPullData (𝟙 A) N) (j : ℕ) (x : wcEtZModExt A N j), wcEtPull D j x = x := by
    intro A D j x
    have h1 := wc_et_pull_comp (𝟙 A) (𝟙 A) (𝟙 A) (Category.comp_id _) D D D j x
    have h2 : wcEtPull D j (wcEtPull D j x - x) = 0 := by rw [map_sub, ← h1, sub_self]
    exact sub_eq_zero.mp (wc_et_pull_id_injective D j _ h2)
  have hpull_iso : ∀ {A B : Scheme.{u}} (i : A ⟶ B) [IsIso i] (D : wcEtPullData i N) (j : ℕ), Function.Bijective (wcEtPull D j) := by
    intro A B i _ D j
    obtain ⟨Dinv⟩ := wc_et_zmod_pull_data_exists (inv i) N
    obtain ⟨DA⟩ := wc_et_zmod_pull_data_exists (𝟙 A) N
    obtain ⟨DB⟩ := wc_et_zmod_pull_data_exists (𝟙 B) N
    refine ⟨fun x y hxy => ?_, fun x => ⟨wcEtPull Dinv j x, ?_⟩⟩
    · have e1 := wc_et_pull_comp i (inv i) (𝟙 B) (IsIso.inv_hom_id i) D Dinv DB j x
      have e2 := wc_et_pull_comp i (inv i) (𝟙 B) (IsIso.inv_hom_id i) D Dinv DB j y
      rw [hpull_id] at e1 e2
      rw [e1, e2, hxy]
    · have e := wc_et_pull_comp (inv i) i (𝟙 A) (IsIso.hom_inv_id i) Dinv D DA j x
      rw [hpull_id] at e
      exact e.symm
  have hs1 : ∀ {X Y X' Y' : Scheme.{u}} (f : X ⟶ Y) (f' : X' ⟶ Y'), (Arrow.mk f ≅ Arrow.mk f') → (∀ (j : ℕ) (D : wcEtPullData f N), Function.Bijective (wcEtPull D j)) → ∀ (j : ℕ) (D' : wcEtPullData f' N), Function.Bijective (wcEtPull D' j) := by
    intro X Y X' Y' f f' E hf j D'
    have hsq : (Comma.leftIso E).hom ≫ f' = f ≫ (Comma.rightIso E).hom := Arrow.w_mk_right E.hom
    obtain ⟨Da⟩ := wc_et_zmod_pull_data_exists (Comma.leftIso E).hom N
    obtain ⟨Db⟩ := wc_et_zmod_pull_data_exists (Comma.rightIso E).hom N
    obtain ⟨Df⟩ := wc_et_zmod_pull_data_exists f N
    obtain ⟨Dk⟩ := wc_et_zmod_pull_data_exists (f ≫ (Comma.rightIso E).hom) N
    have hcomp : Function.Bijective (fun x => wcEtPull Da j (wcEtPull D' j x)) := by
      have h := (hf j Df).comp (hpull_iso _ Db j)
      have heq : (fun x => wcEtPull Da j (wcEtPull D' j x)) = (⇑(wcEtPull Df j) ∘ ⇑(wcEtPull Db j)) := by
        funext x
        exact (wc_et_pull_comp f' (Comma.leftIso E).hom (f ≫ (Comma.rightIso E).hom) hsq D' Da Dk j x).symm.trans
          (wc_et_pull_comp (Comma.rightIso E).hom f (f ≫ (Comma.rightIso E).hom) rfl Db Df Dk j x)
      rw [heq]
      exact h
    have ha := hpull_iso _ Da j
    refine ⟨fun x y hxy => hcomp.1 (congrArg (wcEtPull Da j) hxy), fun y => ?_⟩
    obtain ⟨x, hx⟩ := hcomp.2 (wcEtPull Da j y)
    exact ⟨x, ha.1 hx⟩
  have hs2 : ∀ {Z' Z : Scheme.{u}} (g : Z' ⟶ Z) {ι : Type} [Fintype ι] (k₀ : ι) (V : ι → Z.Opens), (⨆ k, V k) = ⊤ → (∀ (k : ι) (W : Z.Opens), W ≤ V k → ∀ (j : ℕ) (D : wcEtPullData (g ∣_ W) N), Function.Bijective (wcEtPull D j)) → ∀ (j : ℕ) (D : wcEtPullData g N), Function.Bijective (wcEtPull D j) := by
    intro Z' Z g ι _ k₀ V hV hloc'
    classical
    have hstep : ∀ (U1 U2 W : Z.Opens), W ≤ U1 ⊔ U2 →
        (∀ W' : Z.Opens, W' ≤ U1 → ∀ (j : ℕ) (D : wcEtPullData (g ∣_ W') N), Function.Bijective (wcEtPull D j)) →
        (∀ W' : Z.Opens, W' ≤ U2 → ∀ (j : ℕ) (D : wcEtPullData (g ∣_ W') N), Function.Bijective (wcEtPull D j)) →
        ∀ (j : ℕ) (D : wcEtPullData (g ∣_ W) N), Function.Bijective (wcEtPull D j) := by
      intro U1 U2 W hW h1 h2
      have hC : ∀ (U : Z.Opens), (∀ W' : Z.Opens, W' ≤ U → ∀ (j : ℕ) (D : wcEtPullData (g ∣_ W') N), Function.Bijective (wcEtPull D j)) → ∀ C : (W : Scheme.{u}).Opens, W.ι ''ᵁ C ≤ U → ∀ (j : ℕ) (D : wcEtPullData (g ∣_ W ∣_ C) N), Function.Bijective (wcEtPull D j) := by
        intro U hU C hCU
        exact hs1 _ _ (morphismRestrictRestrict g W C).symm (hU _ hCU)
      have hAB : W.ι ⁻¹ᵁ U1 ⊔ W.ι ⁻¹ᵁ U2 = ⊤ := by
        rw [← Scheme.Hom.preimage_sup]
        exact top_le_iff.mp ((Scheme.Opens.ι_preimage_self W).symm.le.trans (Scheme.Hom.preimage_mono W.ι hW))
      exact (wc_et_mv_pull_five (g ∣_ W) N (W.ι ⁻¹ᵁ U1) (W.ι ⁻¹ᵁ U2) hAB
        (hC U1 h1 _ (Scheme.Hom.image_preimage_le W.ι U1))
        (hC U2 h2 _ (Scheme.Hom.image_preimage_le W.ι U2))).mp
        (hC U1 h1 _ ((Scheme.Hom.image_mono W.ι (inf_le_left : W.ι ⁻¹ᵁ U1 ⊓ W.ι ⁻¹ᵁ U2 ≤ W.ι ⁻¹ᵁ U1)).trans
          (Scheme.Hom.image_preimage_le W.ι U1)))
    have key : ∀ s : Finset ι, ∀ W : Z.Opens, W ≤ s.sup V → ∀ (j : ℕ) (D : wcEtPullData (g ∣_ W) N), Function.Bijective (wcEtPull D j) := by
      intro s
      induction s using Finset.induction_on with
      | empty =>
        intro W hW
        exact hloc' k₀ W (hW.trans (by rw [Finset.sup_empty]; exact bot_le))
      | insert a s ha ih =>
        intro W hW
        rw [Finset.sup_insert] at hW
        exact hstep (V a) (s.sup V) W hW (hloc' a) ih
    have htop : ∀ W : Z.Opens, ∀ (j : ℕ) (D : wcEtPullData (g ∣_ W) N), Function.Bijective (wcEtPull D j) := by
      intro W
      apply key Finset.univ W
      rw [Finset.sup_univ_eq_iSup]
      exact le_top.trans hV.ge
    exact (wc_et_mv_pull_five g N ⊤ ⊤ (sup_idem _) (htop ⊤) (htop ⊤)).mp (htop _)
  have hbij : ∀ (j : ℕ) (D : wcEtPullData (Spec.map (CommRingCat.ofHom φ) ∣_ O) N), Function.Bijective (wcEtPull D j) := by
    refine hs2 (Spec.map (CommRingCat.ofHom φ) ∣_ O) (0 : Fin (e + 1)) (fun k => O.ι ⁻¹ᵁ PrimeSpectrum.basicOpen (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) L)) ?_ ?_
    · rw [eq_top_iff]
      intro x _
      have hx : O.ι x ∈ O := by
        first
        | exact x.2
        | simp
        | exact (Scheme.Opens.range_ι O).symm ▸ ⟨x, rfl⟩
      obtain ⟨k, hk⟩ := (hO _).mp hx
      exact (TopologicalSpace.Opens.mem_iSup (s := fun k : Fin (e + 1) => O.ι ⁻¹ᵁ PrimeSpectrum.basicOpen (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) L))).mpr ⟨k, hk⟩
    · intro k W hW j Dd
      have hle : O.ι ''ᵁ W ≤ PrimeSpectrum.basicOpen (MvPolynomial.X k : MvPolynomial (Fin (e + 1)) L) :=
        (Scheme.Hom.image_mono O.ι hW).trans (Scheme.Hom.image_preimage_le O.ι _)
      exact hs1 _ _ (morphismRestrictRestrict (Spec.map (CommRingCat.ofHom φ)) O W).symm (hloc k _ hle) j Dd
  exact ⟨hs6, hbij⟩

theorem wc_pmhpi_quadric_punct_pull_bij (K L : Type u) [Field K] [IsAlgClosed K] [Field L]
    [IsSepClosed L] (σ : K →+* L) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓK : ((ℓ : ℕ) : K) ≠ 0)
    (n m : ℕ) (hnm : n = 2 * m) (hm : 1 ≤ m) (c₀ : L) (hc₀ : c₀ ≠ 0)
    (U₀ : (Spec (.of (MvPolynomial (Fin m) K))).Opens)
    (hU₀ : (U₀ : Set (Spec (.of (MvPolynomial (Fin m) K)))) =
        (Set.range (Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin m) K →+* K))))ᶜ)
    (e' : Spec (.of (wcQuadModelRing L n c₀
        (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0)))
          ⟶ (U₀ : Scheme.{u}))
    (he' : e' ≫ U₀.ι = Spec.map (CommRingCat.ofHom (MvPolynomial.eval₂Hom
        ((algebraMap L (wcQuadModelRing L n c₀
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))).comp
            σ)
        (fun t : Fin m => Ideal.Quotient.mk (wcQuadModelIdeal L n c₀
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
          (MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin n))))))
    (k : ℕ) (hk : 1 ≤ k) (q : ℕ) :
    ∀ De : wcZModPullData e' (ℓ ^ k), wcZModPullCanonical De →
      Function.Bijective (wcZModPull De q) :=
by
  intro De hDe
  subst hnm
  obtain ⟨e, rfl⟩ : ∃ e, m = e + 1 := ⟨m - 1, by omega⟩
  have hN : ((ℓ ^ k : ℕ) : K) ≠ 0 := by rw [Nat.cast_pow]; exact pow_ne_zero _ hℓK
  have hNpos : 0 < ℓ ^ k := pow_pos (Fact.out : ℓ.Prime).pos k
  letI : Algebra K L := σ.toAlgebra

  obtain ⟨φL, hφL⟩ : ∃ f : MvPolynomial (Fin (e + 1)) L →+* wcQuadModelRing L (2 * (e + 1)) c₀
      (Matrix.of fun p q : Fin (2 * (e + 1)) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0),
      f = (MvPolynomial.aeval (R := L) (fun i : Fin (e + 1) => Ideal.Quotient.mk
        (wcQuadModelIdeal L (2 * (e + 1)) c₀
          (Matrix.of fun p q : Fin (2 * (e + 1)) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
        (MvPolynomial.X (⟨2 * i.val, by omega⟩ : Fin (2 * (e + 1)))))).toRingHom := ⟨_, rfl⟩



  have hring : MvPolynomial.eval₂Hom
      ((algebraMap L (wcQuadModelRing L (2 * (e + 1)) c₀
        (Matrix.of fun p q : Fin (2 * (e + 1)) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))).comp σ)
      (fun t : Fin (e + 1) => Ideal.Quotient.mk (wcQuadModelIdeal L (2 * (e + 1)) c₀
        (Matrix.of fun p q : Fin (2 * (e + 1)) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : L) else 0))
        (MvPolynomial.X (⟨2 * t.val, by omega⟩ : Fin (2 * (e + 1))))) =
      φL.comp (MvPolynomial.map σ) := by
    subst hφL
    apply MvPolynomial.ringHom_ext
    · intro r
      simp [MvPolynomial.aeval_C]
    · intro t
      simp
  have hfac : e' ≫ U₀.ι = Spec.map (CommRingCat.ofHom φL) ≫
      Spec.map (CommRingCat.ofHom (MvPolynomial.map σ : MvPolynomial (Fin (e + 1)) K →+* MvPolynomial (Fin (e + 1)) L)) := by
    rw [he', hring, CommRingCat.ofHom_comp, Spec.map_comp]



  have hOmem : ∀ y : Spec (.of (MvPolynomial (Fin (e + 1)) L)),
      y ∈ Spec.map (CommRingCat.ofHom (MvPolynomial.map σ : MvPolynomial (Fin (e + 1)) K →+* MvPolynomial (Fin (e + 1)) L)) ⁻¹ᵁ U₀ ↔
      ∃ i : Fin (e + 1), (MvPolynomial.X i : MvPolynomial (Fin (e + 1)) L) ∉ y.asIdeal := by
    intro y
    rw [Scheme.Hom.mem_preimage]
    first
    | rw [← SetLike.mem_coe, hU₀, Set.mem_compl_iff, wc_affine_origin_range_iff, not_forall]
    | (show _ ∈ (U₀ : Set (Spec (.of (MvPolynomial (Fin (e + 1)) K)))) ↔ _
       rw [hU₀, Set.mem_compl_iff, wc_affine_origin_range_iff, not_forall])
    apply exists_congr
    intro i
    apply not_congr
    show MvPolynomial.map σ (MvPolynomial.X i) ∈ y.asIdeal ↔ _
    rw [MvPolynomial.map_X]



  have hs4 : ∀ (K S R T : Type u) [CommRing K] [CommRing S] [CommRing R] [CommRing T] [Algebra K S] [Algebra K T] (φ : S →+* R) (r : S) (Ψ : TensorProduct K (Localization.Away r) T ≃+* Localization.Away (φ r)), Ψ.toRingHom.comp Algebra.TensorProduct.includeLeftRingHom = Localization.awayMap φ r → ∃ q : ((Spec.map (CommRingCat.ofHom φ) ⁻¹ᵁ PrimeSpectrum.basicOpen r : (Spec (.of R)).Opens) : Scheme.{u}) ⟶ Spec (.of T), IsPullback (Spec.map (CommRingCat.ofHom φ) ∣_ PrimeSpectrum.basicOpen r) q (Scheme.Opens.ι (X := Spec (.of S)) (PrimeSpectrum.basicOpen r) ≫ Spec.map (CommRingCat.ofHom (algebraMap K S))) (Spec.map (CommRingCat.ofHom (algebraMap K T))) := by
    intro K S R T _ _ _ _ _ _ φ r Ψ hΨ
    have hpb := isPullback_SpecMap_of_isPushout _ _ _ _
      (CommRingCat.isPushout_tensorProduct K (Localization.Away r) T)
    let e₁ : Spec (.of (TensorProduct K (Localization.Away r) T)) ≅ Spec (.of (Localization.Away (φ r))) :=
      { hom := Spec.map (CommRingCat.ofHom Ψ.symm.toRingHom)
        inv := Spec.map (CommRingCat.ofHom Ψ.toRingHom)
        hom_inv_id := by
          rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
          have : Ψ.symm.toRingHom.comp Ψ.toRingHom = RingHom.id _ := RingHom.ext fun x => by simp
          rw [this, CommRingCat.ofHom_id, Spec.map_id]
        inv_hom_id := by
          rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
          have : Ψ.toRingHom.comp Ψ.symm.toRingHom = RingHom.id _ := RingHom.ext fun x => by simp
          rw [this, CommRingCat.ofHom_id, Spec.map_id] }
    have hb := IsPullback.of_iso hpb e₁ (Iso.refl _) (Iso.refl _) (Iso.refl _)
      (fst' := Spec.map (CommRingCat.ofHom (Localization.awayMap φ r)))
      (snd' := e₁.inv ≫ Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom))
      (f' := Spec.map (CommRingCat.ofHom (algebraMap K (Localization.Away r))))
      (g' := Spec.map (CommRingCat.ofHom (algebraMap K T)))
      (by
        rw [Iso.refl_hom, Category.comp_id]
        show _ = Spec.map _ ≫ Spec.map _
        rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, ← hΨ]
        congr 2
        ext x
        simp)
      (by simp) (by simp) (by simp)
    let E := SpecMapRestrictBasicOpenIso (CommRingCat.ofHom φ) r
    have hfac : (basicOpenIsoSpecAway (R := CommRingCat.of S) r).inv ≫ Scheme.Opens.ι (X := Spec (.of S)) (PrimeSpectrum.basicOpen r) =
        Spec.map (CommRingCat.ofHom (algebraMap S (Localization.Away r))) := by
      simp [basicOpenIsoSpecAway]
    have hEr : (Comma.rightIso E).symm.hom = (basicOpenIsoSpecAway (R := CommRingCat.of S) r).inv := rfl
    refine ⟨E.hom.left ≫ e₁.inv ≫ Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom), ?_⟩
    refine IsPullback.of_iso hb (Comma.leftIso E).symm (Comma.rightIso E).symm (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
    · exact (Arrow.w E.inv).symm
    · rw [Iso.refl_hom, Category.comp_id]
      exact (Iso.inv_hom_id_assoc (Comma.leftIso E) _).symm
    · rw [Iso.refl_hom, Category.comp_id, hEr, reassoc_of% hfac, ← Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← IsScalarTower.algebraMap_eq]
    · rw [Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp]
  have hs5 : ∀ {P Y T B : Scheme.{u}} (π : P ⟶ Y) (V W : Y.Opens) (hWV : W ≤ V) (fY : Y ⟶ B) (q : ((π ⁻¹ᵁ V : P.Opens) : Scheme.{u}) ⟶ T) (t : T ⟶ B), IsPullback (π ∣_ V) q (V.ι ≫ fY) t → IsPullback (π ∣_ W) (P.homOfLE (Scheme.Hom.preimage_mono π hWV) ≫ q) (W.ι ≫ fY) t := by
    intro P Y T B π V W hWV fY q t h
    have hsq : P.homOfLE (Scheme.Hom.preimage_mono π hWV) ≫ π ∣_ V = π ∣_ W ≫ Y.homOfLE hWV := by
      rw [← cancel_mono V.ι, Category.assoc, morphismRestrict_ι, Category.assoc, Scheme.homOfLE_ι,
        morphismRestrict_ι, Scheme.homOfLE_ι_assoc]
    have hR : IsPullback (π⁻¹ᵁ V).ι (π ∣_ V) π V.ι := (isPullback_morphismRestrict π V).flip
    have hO' : IsPullback (P.homOfLE (Scheme.Hom.preimage_mono π hWV) ≫ (π⁻¹ᵁ V).ι) (π ∣_ W) π
        (Y.homOfLE hWV ≫ V.ι) := by
      rw [Scheme.homOfLE_ι, Scheme.homOfLE_ι]
      exact (isPullback_morphismRestrict π W).flip
    have hL : IsPullback (P.homOfLE (Scheme.Hom.preimage_mono π hWV)) (π ∣_ W) (π ∣_ V)
        (Y.homOfLE hWV) := IsPullback.of_right hO' hsq hR
    have := (IsPullback.paste_horiz hL h.flip).flip
    rw [Scheme.homOfLE_ι_assoc] at this
    exact this
  have hpull_id : ∀ {A : Scheme.{u}} (D : wcEtPullData (𝟙 A) (ℓ ^ k)) (j : ℕ) (x : wcEtZModExt A (ℓ ^ k) j), wcEtPull D j x = x := by
    intro A D j x
    have h1 := wc_et_pull_comp (𝟙 A) (𝟙 A) (𝟙 A) (Category.comp_id _) D D D j x
    have h2 : wcEtPull D j (wcEtPull D j x - x) = 0 := by rw [map_sub, ← h1, sub_self]
    exact sub_eq_zero.mp (wc_et_pull_id_injective D j _ h2)
  have hpull_iso : ∀ {A B : Scheme.{u}} (i : A ⟶ B) [IsIso i] (D : wcEtPullData i (ℓ ^ k)) (j : ℕ), Function.Bijective (wcEtPull D j) := by
    intro A B i _ D j
    obtain ⟨Dinv⟩ := wc_et_zmod_pull_data_exists (inv i) (ℓ ^ k)
    obtain ⟨DA⟩ := wc_et_zmod_pull_data_exists (𝟙 A) (ℓ ^ k)
    obtain ⟨DB⟩ := wc_et_zmod_pull_data_exists (𝟙 B) (ℓ ^ k)
    refine ⟨fun x y hxy => ?_, fun x => ⟨wcEtPull Dinv j x, ?_⟩⟩
    · have e1 := wc_et_pull_comp i (inv i) (𝟙 B) (IsIso.inv_hom_id i) D Dinv DB j x
      have e2 := wc_et_pull_comp i (inv i) (𝟙 B) (IsIso.inv_hom_id i) D Dinv DB j y
      rw [hpull_id] at e1 e2
      rw [e1, e2, hxy]
    · have e := wc_et_pull_comp (inv i) i (𝟙 A) (IsIso.hom_inv_id i) Dinv D DA j x
      rw [hpull_id] at e
      exact e.symm



  have hloc : ∀ (i : Fin (e + 1)) (W : (Spec (.of (MvPolynomial (Fin (e + 1)) L))).Opens),
      W ≤ PrimeSpectrum.basicOpen (MvPolynomial.X i : MvPolynomial (Fin (e + 1)) L) →
      ∀ (j : ℕ) (D : wcEtPullData (Spec.map (CommRingCat.ofHom φL) ∣_ W) (ℓ ^ k)),
        Function.Bijective (wcEtPull D j) := by
    intro i W hW j D
    obtain ⟨Ψ, hΨ⟩ := wc_pmhpi_hyp_chart_iso K L e c₀ i φL hφL
    obtain ⟨qk, hqk⟩ := hs4 K (MvPolynomial (Fin (e + 1)) L) _ (MvPolynomial (Fin e) K) φL
      (MvPolynomial.X i) Ψ hΨ
