  have hβF : wcFreeSheafMap (Limits.pullback D.f t) β.inv ≫
      wcFreeSheafMap (Limits.pullback D.f t)
        ((wcProEtPullback (Limits.pullback.fst D.f t)).map ((wcProEtPullback D.f).map φ₀)) =
      wcFreeSheafMap (Limits.pullback D.f t)
        (wcGeomFrob K (Over.mk (Limits.pullback.snd D.f t)) hX) ≫
        wcFreeSheafMap (Limits.pullback D.f t) β.inv := by
