    have hfix0 : ∀ y : (wcRq D.f ℓ q).obj.obj (Opposite.op Vt),
        wcContEval (wcP1Over F'').left Vt ((θ.hom.hom.app (Opposite.op (Over.mk (c ≫ σ)))).hom y) z₀ =
          wcContEval (wcP1Over F'').left Vt ((θ.hom.hom.app (Opposite.op (Over.mk c))).hom y) z₀ := by
      intro y
      have e1 := hnat y
      rw [hτfix y, hsub (τ.left z₀) z₀] at e1
      have e2 := congrArg (fun h : Vt ⟶ W =>
        wcContEval (wcP1Over F'').left Vt ((θ.hom.hom.app (Opposite.op (Over.mk h))).hom y) z₀) h3
      exact e2.symm.trans e1

    have hAid : ∀ x, Aσ x = x := by
      intro x
      obtain ⟨y, hy⟩ := hconst Vt c x
      have e1 := hAσ Vt c y z₀
      rw [hfix0 y, hy z₀] at e1
      exact e1.symm

    have e1 := hAσ W (𝟙 W) s z
    rw [Category.id_comp, hAid] at e1
    exact e1

  have hstar : ∀ γ : W ⟶ W, γ ≫ w = w → ∀ (V' : (wcP1Over F'').left.ProEt) (c : V' ⟶ W)
      (t : (wcRq D.f ℓ q).obj.obj (Opposite.op V')) (z : V'.left),
      wcContEval (wcP1Over F'').left V' ((θ.hom.hom.app (Opposite.op (Over.mk (c ≫ γ)))).hom t) z =
        wcContEval (wcP1Over F'').left V' ((θ.hom.hom.app (Opposite.op (Over.mk c))).hom t) z := by
    intro γ hγ V' c t z
    obtain ⟨Aγ, hAγ⟩ := hframe γ
    obtain ⟨z₀⟩ : Nonempty W.left := ConnectedSpace.toNonempty
    have hAid : ∀ x, Aγ x = x := by
      intro x
      obtain ⟨y, hy⟩ := hconst W (𝟙 W) x
      have e1 := hAγ W (𝟙 W) y z₀
      rw [Category.id_comp, hall γ hγ y z₀, hy z₀] at e1
      exact e1.symm
    rw [hAγ V' c t z, hAid]

  have hSO : ∀ i : Fin D.m, D.S i (IsLocalRing.closedPoint F'') ∉ wcPencilSOpen D := by
    intro i h
    have h2 : D.S i (IsLocalRing.closedPoint F'') ∈
        (⋃ j, closure {D.S j (IsLocalRing.closedPoint F'')})ᶜ := h
    exact h2 (Set.mem_iUnion.mpr ⟨i, subset_closure rfl⟩)
  have hrange : ∀ y, (wcPencilSOpen D).ι y ∈ wcPencilSOpen D := by
    intro y
    have : (wcPencilSOpen D).ι y ∈ Set.range (wcPencilSOpen D).ι := ⟨y, rfl⟩
    rwa [Scheme.Opens.range_ι] at this
  obtain ⟨wl, hwl1, hwl2⟩ : ∃ wl : Limits.pullback (wcPencilSOpen D).ι W.hom ⟶
      Limits.pullback (wcPencilSOpen D).ι (wcGeomPoint F'' (wcP1Over F'') hP).hom,
      wl ≫ Limits.pullback.fst _ _ = Limits.pullback.fst _ _ ∧
      wl ≫ Limits.pullback.snd _ _ = Limits.pullback.snd _ _ ≫ w.left :=
    ⟨Limits.pullback.lift (Limits.pullback.fst _ _) (Limits.pullback.snd _ _ ≫ w.left)
        (by rw [Category.assoc, MorphismProperty.Over.w w]; exact Limits.pullback.condition),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  let W' : (wcP1Over F'').left.ProEt := wcOpenRestr (wcP1Over F'').left (wcPencilSOpen D) W
  let ι : W' ⟶ W := wcOpenRestrIncl (wcP1Over F'').left (wcPencilSOpen D) W
  let w' : W' ⟶ wcPencilGeomOffS D hP :=
    MorphismProperty.Over.homMk wl
      (show wl ≫ (Limits.pullback.snd (wcPencilSOpen D).ι
          (wcGeomPoint F'' (wcP1Over F'') hP).hom ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) =
          Limits.pullback.snd (wcPencilSOpen D).ι W.hom ≫ W.hom by
        rw [← Category.assoc, hwl2, Category.assoc, MorphismProperty.Over.w w]) trivial
  have hcomm : ι ≫ w = w' ≫ wcOpenRestrIncl (wcP1Over F'').left (wcPencilSOpen D)
      (wcGeomPoint F'' (wcP1Over F'') hP) := by
    apply MorphismProperty.Over.Hom.ext
    show Limits.pullback.snd (wcPencilSOpen D).ι W.hom ≫ w.left =
      wl ≫ Limits.pullback.snd (wcPencilSOpen D).ι (wcGeomPoint F'' (wcP1Over F'') hP).hom
    rw [hwl2]
  have hpb : IsPullback wl (Limits.pullback.snd (wcPencilSOpen D).ι W.hom)
      (Limits.pullback.snd (wcPencilSOpen D).ι (wcGeomPoint F'' (wcP1Over F'') hP).hom) w.left := by
    have houter : IsPullback (wl ≫ Limits.pullback.fst _ _)
        (Limits.pullback.snd (wcPencilSOpen D).ι W.hom) (wcPencilSOpen D).ι
        (w.left ≫ (wcGeomPoint F'' (wcP1Over F'') hP).hom) := by
      rw [hwl1, MorphismProperty.Over.w w]
      exact IsPullback.of_hasPullback _ _
    exact IsPullback.of_right houter hwl2 (IsPullback.of_hasPullback _ _)
  have hqc' : QuasiCompact w'.left :=
    MorphismProperty.of_isPullback (P := @QuasiCompact) hpb.flip hqc
  have keyP : ∀ x : ↥(Limits.pullback (wcPencilSOpen D).ι (wcGeomPoint F'' (wcP1Over F'') hP).hom),
      (wcPencilSOpen D).ι
          (Limits.pullback.fst (wcPencilSOpen D).ι (wcGeomPoint F'' (wcP1Over F'') hP).hom x) =
        (wcGeomPoint F'' (wcP1Over F'') hP).hom
          (Limits.pullback.snd (wcPencilSOpen D).ι (wcGeomPoint F'' (wcP1Over F'') hP).hom x) :=
    fun x =>
    (Scheme.Hom.comp_apply _ _ x).symm.trans
      ((congrArg (fun f : Limits.pullback (wcPencilSOpen D).ι
          (wcGeomPoint F'' (wcP1Over F'') hP).hom ⟶ (wcP1Over F'').left => f x)
        Limits.pullback.condition).trans (Scheme.Hom.comp_apply _ _ x))
  have hsurj' : ∀ p : (wcPencilGeomOffS D hP).left, ∃ z : W'.left, w'.left z = p := by
    intro p
    have e1 := keyP p
    have hoff : ∀ i : Fin D.m, (wcGeomPoint F'' (wcP1Over F'') hP).hom
        (Limits.pullback.snd (wcPencilSOpen D).ι (wcGeomPoint F'' (wcP1Over F'') hP).hom p) ≠
        D.S i (IsLocalRing.closedPoint F'') := by
      intro i h
      exact hSO i ((e1.trans h) ▸ hrange _)
    obtain ⟨z, hz⟩ := hcov _ hoff
    have hzW : (wcPencilSOpen D).ι
        (Limits.pullback.fst (wcPencilSOpen D).ι (wcGeomPoint F'' (wcP1Over F'') hP).hom p) =
        W.hom z :=
      e1.trans ((congrArg (fun y => (wcGeomPoint F'' (wcP1Over F'') hP).hom y) hz.symm).trans
        ((Scheme.Hom.comp_apply w.left _ z).symm.trans
          (congrArg (fun f : W.left ⟶ (wcP1Over F'').left => f z) (MorphismProperty.Over.w w))))
    obtain ⟨z', _, hz'2⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := (wcPencilSOpen D).ι) (g := W.hom) _ z hzW
    refine ⟨z', ?_⟩
    apply (Scheme.Hom.isOpenEmbedding
      (Limits.pullback.snd (wcPencilSOpen D).ι (wcGeomPoint F'' (wcP1Over F'') hP).hom)).injective
    exact (Scheme.Hom.comp_apply wl _ z').symm.trans
      ((congrArg (fun f : Limits.pullback (wcPencilSOpen D).ι W.hom ⟶
          (wcGeomPoint F'' (wcP1Over F'') hP).left => f z') hwl2).trans
        ((Scheme.Hom.comp_apply _ _ z').trans ((congrArg (fun y => w.left y) hz'2).trans hz)))

  let θ' : (wcRq D.f ℓ q).over W' ≅
      (wcContSheaf (wcP1Over F'').left (Fin k → ℚ_[ℓ])).over W' :=
    ((Scheme.ProEt.topology (wcP1Over F'').left).overMapPullback AddCommGrpCat.{u+1} ι).mapIso θ

  have hfix' : ∀ (V : (wcP1Over F'').left.ProEt), ConnectedSpace V.left → ∀ (h₁ h₂ : V ⟶ W')
      (x : (wcRq D.f ℓ q).obj.obj (Opposite.op V)), h₁ ≫ w' = h₂ ≫ w' →
      (θ'.hom.hom.app (Opposite.op (Over.mk h₁))).hom x =
        (θ'.hom.hom.app (Opposite.op (Over.mk h₂))).hom x := by
    intro V hV h₁ h₂ x hh
    have hh' : (h₁ ≫ ι) ≫ w = (h₂ ≫ ι) ≫ w := by
      rw [Category.assoc, Category.assoc, hcomm, ← Category.assoc, hh, Category.assoc]
    obtain ⟨γ, hγ, hb⟩ := hgal V (h₁ ≫ ι) (h₂ ≫ ι) hV hh'
    have e2 : ∀ z : V.left,
        wcContEval (wcP1Over F'').left V
            ((θ.hom.hom.app (Opposite.op (Over.mk (h₂ ≫ ι)))).hom x) z =
          wcContEval (wcP1Over F'').left V
            ((θ.hom.hom.app (Opposite.op (Over.mk (h₁ ≫ ι)))).hom x) z := by
      intro z
      have e3 := congrArg (fun h : V ⟶ W =>
        wcContEval (wcP1Over F'').left V ((θ.hom.hom.app (Opposite.op (Over.mk h))).hom x) z) hb
      exact e3.trans (hstar γ hγ V (h₁ ≫ ι) x z)
    apply ULift.ext
    apply ContinuousMap.ext
    intro z
    exact (e2 z).symm

  obtain ⟨eiso⟩ := wc_proet_frame_fixed_descent (wcP1Over F'').left ℓ (wcPencilGeomOffS D hP) W' w'
    hqc' hsurj' (wcRq D.f ℓ q) k θ' hfix'
  exact ⟨k, ⟨eiso⟩⟩

theorem wc_pencil_VQ_stalk_basis_nonempty (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hNI : ∃ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β ∧
      β ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n)) :
    ∀ d : ℕ, 1 ≤ d → ∀ x ∈ wcP1ClosedPt F'' d, (∀ i, x ≠ D.S i (IsLocalRing.closedPoint F'')) →
      Nonempty (wcPencilStalkBasis D ℓ hP x d) :=
by
  intro d hd x hx hxS
  obtain ⟨W, w, r, hcov, hW⟩ := wc_pencil_VQ_cover_triv F' F'' Y n hn hn2 D ℓ hℓ hP hNI
  obtain ⟨N⟩ := wc_P1_frob_nbhd_exists F'' d hd x hx
  letI := N.ringA
  haveI := N.hensA
  haveI := N.sepA
  have ht : wcScalarTriv (wcP1Over F'').left ℓ (wcPencilVQ D ℓ hP)
      (wcPencilVQScalar D ℓ hP) N.V r :=
    wc_proet_scalarTriv_strict_local F'' hP ℓ _ _ r D.m D.S D.hS W w hcov hW N.V N.A N.e
      (by intro i; rw [N.hx]; exact hxS i)
  obtain ⟨b, hb, -⟩ := wc_proet_scalarTriv_stalk_basis _ ℓ _ _ r N.V N.A N.e N.φ ht
  exact ⟨⟨N, r, b, hb⟩⟩

theorem wc_ext0_projective_cokernel {C : Type*} [Category C] [Abelian C] [HasExt C]
    {P A B : C} [Projective P] (i : A ⟶ B) [Mono i] :
    Function.Surjective ((Abelian.Ext.mk₀ (Limits.cokernel.π i)).postcomp P (add_zero 0)) ∧
    ∀ y : Abelian.Ext P B 0,
      (Abelian.Ext.mk₀ (Limits.cokernel.π i)).postcomp P (add_zero 0) y = 0 ↔
        ∃ z : Abelian.Ext P A 0, y = (Abelian.Ext.mk₀ i).postcomp P (add_zero 0) z :=
by
  have s1 : ∀ {Y Z : C} (f : P ⟶ Y) (g : Y ⟶ Z),
      (Abelian.Ext.mk₀ g).postcomp P (add_zero 0) (Abelian.Ext.mk₀ f) =
        Abelian.Ext.mk₀ (f ≫ g) := by
    intro Y Z f g
    show (Abelian.Ext.mk₀ f).comp (Abelian.Ext.mk₀ g) (add_zero 0) = _
    exact Abelian.Ext.mk₀_comp_mk₀ f g
  have s2 : ∀ {Y : C} (y : Abelian.Ext P Y 0), ∃ f : P ⟶ Y, y = Abelian.Ext.mk₀ f := by
    intro Y y
    obtain ⟨f, hf⟩ := (Abelian.Ext.mk₀_bijective P Y).2 y
    exact ⟨f, hf.symm⟩
  refine ⟨?_, fun y => ⟨?_, ?_⟩⟩
  · intro w
    obtain ⟨g, rfl⟩ := s2 w
    refine ⟨Abelian.Ext.mk₀ (Projective.factorThru g (Limits.cokernel.π i)), ?_⟩
    rw [s1, Projective.factorThru_comp]
  · intro hy
    obtain ⟨f, rfl⟩ := s2 y
    rw [s1] at hy
    have hf : f ≫ Limits.cokernel.π i = 0 := by
      apply (Abelian.Ext.mk₀_bijective P _).1
      rw [hy, Abelian.Ext.mk₀_zero]
    refine ⟨Abelian.Ext.mk₀ (Abelian.monoLift i f hf), ?_⟩
    rw [s1, Abelian.monoLift_comp]
  · rintro ⟨z, rfl⟩
    obtain ⟨h, rfl⟩ := s2 z
    rw [s1, s1, Category.assoc, Limits.cokernel.condition, Limits.comp_zero,
      Abelian.Ext.mk₀_zero]

theorem wc_pencil_mid_stalk_split (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hNI : ∃ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β ∧
      β ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n)) :
    ∃ Gm : Multiset (AlgebraicClosure ℚ_[ℓ]), (0 : AlgebraicClosure ℚ_[ℓ]) ∉ Gm ∧
      ∀ d : ℕ, 1 ≤ d → ∀ x ∈ wcP1ClosedPt F'' d, (∀ i, x ≠ D.S i (IsLocalRing.closedPoint F'')) →
      ∀ B : wcPencilStalkBasis D ℓ hP x d,
        ∃ (r : ℕ) (e : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left B.N.V) (wcRq D.f ℓ (n - 1)) 0 ≃+
            (Fin r → ℚ_[ℓ])),
          (∀ (c : ℚ_[ℓ])
              (y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left B.N.V) (wcRq D.f ℓ (n - 1)) 0),
            e ((Abelian.Ext.mk₀ (wcRqScalar D.f ℓ (n - 1) c)).postcomp
              (wcFreeSheaf (wcP1Over F'').left B.N.V) (add_zero 0) y) = c • e y) ∧
          ∀ j : ℕ, 1 ≤ j → algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])
            ((wcAddEquivMatrix e ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left B.N.φ)).precomp
              (wcRq D.f ℓ (n - 1)) (zero_add 0)) ^ j).trace) =
            (((wcAddEquivMatrix B.e ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over F'').left
                B.N.φ)).precomp (wcPencilVQ D ℓ hP) (zero_add 0))).charpoly.aroots
                  (AlgebraicClosure ℚ_[ℓ])).map (· ^ j)).sum +
              (Gm.map (· ^ (d * j))).sum :=
by
  classical

  have trK : ∀ {r : ℕ} (A : Matrix (Fin r) (Fin r) (AlgebraicClosure ℚ_[ℓ])) (m : ℕ),
      (A ^ m).trace = (A.charpoly.roots.map (· ^ m)).sum := by
    intro r A m
    set f : Module.End (AlgebraicClosure ℚ_[ℓ]) (Fin r → AlgebraicClosure ℚ_[ℓ]) :=
      Matrix.toLin' A with hf
    have h1 : (A ^ m).trace =
        LinearMap.trace (AlgebraicClosure ℚ_[ℓ]) (Fin r → AlgebraicClosure ℚ_[ℓ]) (f ^ m) := by
      rw [← Matrix.trace_toLin'_eq, Matrix.toLin'_pow]
    have h2 : A.charpoly = LinearMap.charpoly f := (Matrix.charpoly_toLin' A).symm
    rw [h1, h2]
    set p := LinearMap.charpoly f with hp
    have s3 : ∀ μ : AlgebraicClosure ℚ_[ℓ], LinearMap.trace (AlgebraicClosure ℚ_[ℓ])
        (f.maxGenEigenspace μ)
        ((f ^ m).restrict (Module.End.mapsTo_maxGenEigenspace_of_comm (Commute.self_pow f m) μ)) =
        (Module.finrank (AlgebraicClosure ℚ_[ℓ]) (f.maxGenEigenspace μ) : AlgebraicClosure ℚ_[ℓ]) *
          μ ^ m := by
      intro μ
      have hW : Set.MapsTo f (f.maxGenEigenspace μ) (f.maxGenEigenspace μ) :=
        Module.End.mapsTo_maxGenEigenspace_of_comm (Commute.refl f) μ
      set a : Module.End (AlgebraicClosure ℚ_[ℓ]) (f.maxGenEigenspace μ) := f.restrict hW
        with ha_def
      set c : Module.End (AlgebraicClosure ℚ_[ℓ]) (f.maxGenEigenspace μ) := algebraMap _ _ μ
        with hc_def
      have ha : (f ^ m).restrict
          (Module.End.mapsTo_maxGenEigenspace_of_comm (Commute.self_pow f m) μ) = a ^ m :=
        (Module.End.pow_restrict m hW _).symm
      have hnil : IsNilpotent (a - c) := by
        have := Module.End.isNilpotent_restrict_maxGenEigenspace_sub_algebraMap f μ
        convert this using 1
        ext x
        simp [a, c, LinearMap.coe_restrict_apply, Algebra.algebraMap_eq_smul_one]
        rfl
      have hac : Commute a c := by
        show a * c = c * a
        exact (Algebra.commutes μ a).symm
      have key : ∀ {R : Type} [Ring R] (x y : R), Commute x y → IsNilpotent (x - y) →
          IsNilpotent (x ^ m - y ^ m) := by
        intro R _ x y hxy hn
        have hd : Commute (x - y) x := (Commute.refl x).sub_left hxy.symm
        have hd' : Commute (x - y) y := hxy.sub_left (Commute.refl y)
        have hcomm : Commute (x - y)
            (∑ i ∈ Finset.range m, x ^ i * y ^ (m - 1 - i)) :=
          Commute.sum_right _ _ _ (fun i _ => (hd.pow_right i).mul_right (hd'.pow_right _))
        rw [← hxy.geom_sum₂_mul m]
        exact Commute.isNilpotent_mul_left hcomm.symm hn
      have hnil2 : IsNilpotent (a ^ m - c ^ m) := key a c hac hnil
      have ht : LinearMap.trace (AlgebraicClosure ℚ_[ℓ]) _ (a ^ m - c ^ m) = 0 :=
        (LinearMap.isNilpotent_trace_of_isNilpotent hnil2).eq_zero
      rw [ha]
      have h3 := (LinearMap.trace (AlgebraicClosure ℚ_[ℓ]) (f.maxGenEigenspace μ)).map_sub
        (a ^ m) (c ^ m)
      have ht' : LinearMap.trace (AlgebraicClosure ℚ_[ℓ]) _ (a ^ m) =
          LinearMap.trace (AlgebraicClosure ℚ_[ℓ]) _ (c ^ m) :=
        sub_eq_zero.mp (h3.symm.trans ht)
      rw [ht', hc_def, ← map_pow, Algebra.algebraMap_eq_smul_one, map_smul, LinearMap.trace_one,
        smul_eq_mul, mul_comm]
    have hI : DirectSum.IsInternal (fun μ => f.maxGenEigenspace μ) :=
      DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top
        (Module.End.independent_maxGenEigenspace f) (Module.End.iSup_maxGenEigenspace_eq_top f)
    have hb : ∀ μ, f.maxGenEigenspace μ ≠ ⊥ ↔ μ ∈ p.roots.toFinset := by
      intro μ
      rw [Multiset.mem_toFinset, ← Multiset.count_ne_zero, Polynomial.count_roots,
        hp, ← LinearMap.finrank_maxGenEigenspace_eq, ne_eq, ne_eq, Submodule.finrank_eq_zero]
    have hN : {μ | f.maxGenEigenspace μ ≠ ⊥}.Finite := by
      apply (p.roots.toFinset.finite_toSet).subset
      intro μ hμ
      exact (hb μ).1 hμ
    have hmaps := Module.End.mapsTo_maxGenEigenspace_of_comm (Commute.self_pow f m)
    rw [LinearMap.trace_eq_sum_trace_restrict' hI hN hmaps]
    have hfs : hN.toFinset = p.roots.toFinset := by
      ext μ
      rw [Set.Finite.mem_toFinset, ← hb μ]
      rfl
    rw [hfs, Finset.sum_multiset_map_count]
    refine Finset.sum_congr rfl (fun μ _ => ?_)
    rw [s3, LinearMap.finrank_maxGenEigenspace_eq, ← hp, ← Polynomial.count_roots, nsmul_eq_mul]
  have trpow : ∀ {r : ℕ} (M : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (j : ℕ),
      algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((M ^ j).trace) =
        ((M.charpoly.aroots (AlgebraicClosure ℚ_[ℓ])).map (· ^ j)).sum := by
    intro r M j
    rw [AddMonoidHom.map_trace, Matrix.map_pow, trK, Polynomial.aroots_def, ← Matrix.charpoly_map]

  have hMdef : ∀ {V : Type (u+1)} [AddCommGroup V] {r : ℕ} (e : V ≃+ (Fin r → ℚ_[ℓ]))
      (Φ : V →+ V) (a b : Fin r),
      wcAddEquivMatrix e Φ a b = e (Φ (e.symm (Pi.single b 1))) a := by
    intros; rfl
  have s3 : ∀ {V₁ V₂ V₃ : Type (u+1)} [AddCommGroup V₁] [AddCommGroup V₂] [AddCommGroup V₃]
      {r₁ r₃ : ℕ} (e₁ : V₁ ≃+ (Fin r₁ → ℚ_[ℓ])) (e₂ : V₂ ≃+ (Fin (r₁ + r₃) → ℚ_[ℓ]))
      (e₃ : V₃ ≃+ (Fin r₃ → ℚ_[ℓ]))
      (Φ₁ : V₁ →+ V₁) (Φ₂ : V₂ →+ V₂) (Φ₃ : V₃ →+ V₃) (δ : V₁ →+ V₂) (p : V₂ →+ V₃)
      (hδΦ : ∀ x : V₁, δ (Φ₁ x) = Φ₂ (δ x)) (hpΦ : ∀ y : V₂, p (Φ₂ y) = Φ₃ (p y))
      (hδe : ∀ x : V₁, e₂ (δ x) = Fin.append (e₁ x) 0)
      (hpe : ∀ (y : V₂) (i : Fin r₃), e₂ y (Fin.natAdd r₁ i) = e₃ (p y) i),
      (wcAddEquivMatrix e₂ Φ₂).charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) =
        (wcAddEquivMatrix e₁ Φ₁).charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) +
        (wcAddEquivMatrix e₃ Φ₃).charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) := by
    intro V₁ V₂ V₃ _ _ _ r₁ r₃ e₁ e₂ e₃ Φ₁ Φ₂ Φ₃ δ p hδΦ hpΦ hδe hpe
    have hsingL : ∀ j : Fin r₁, Fin.append (Pi.single j (1 : ℚ_[ℓ])) (0 : Fin r₃ → ℚ_[ℓ]) =
        Pi.single (Fin.castAdd r₃ j) 1 := by
      intro j
      funext m
      induction m using Fin.addCases with
      | left i =>
        rw [Fin.append_left]
        by_cases hij : i = j
        · subst hij; simp
        · rw [Pi.single_eq_of_ne hij, Pi.single_eq_of_ne
            (fun h => hij (by simpa [Fin.ext_iff] using h))]
      | right k =>
        rw [Fin.append_right, Pi.zero_apply, Pi.single_eq_of_ne]
        intro h
        have hj := j.isLt
        simp only [Fin.ext_iff, Fin.val_natAdd, Fin.val_castAdd] at h
        omega
    have hsingR : ∀ k i : Fin r₃,
        (Pi.single (Fin.natAdd r₁ k) (1 : ℚ_[ℓ]) : Fin (r₁ + r₃) → ℚ_[ℓ]) (Fin.natAdd r₁ i) =
          (Pi.single k (1 : ℚ_[ℓ]) : Fin r₃ → ℚ_[ℓ]) i := by
      intro k i
      by_cases hik : i = k
      · subst hik; simp
      · rw [Pi.single_eq_of_ne hik, Pi.single_eq_of_ne
          (fun h => hik (by simpa [Fin.ext_iff] using h))]
    have hcolL : ∀ j : Fin r₁, e₂.symm (Pi.single (Fin.castAdd r₃ j) 1) =
        δ (e₁.symm (Pi.single j 1)) := by
      intro j
      rw [AddEquiv.symm_apply_eq, hδe, AddEquiv.apply_symm_apply, hsingL]
    have hcolR : ∀ k : Fin r₃, p (e₂.symm (Pi.single (Fin.natAdd r₁ k) 1)) =
        e₃.symm (Pi.single k 1) := by
      intro k
      rw [AddEquiv.eq_symm_apply]
      funext i
      rw [← hpe, AddEquiv.apply_symm_apply, hsingR]
    have h11 : ∀ i j, wcAddEquivMatrix e₂ Φ₂ (Fin.castAdd r₃ i) (Fin.castAdd r₃ j) =
        wcAddEquivMatrix e₁ Φ₁ i j := by
      intro i j
      rw [hMdef, hMdef, hcolL, ← hδΦ, hδe, Fin.append_left]
    have h21 : ∀ (i : Fin r₃) (j : Fin r₁),
        wcAddEquivMatrix e₂ Φ₂ (Fin.natAdd r₁ i) (Fin.castAdd r₃ j) = 0 := by
      intro i j
      rw [hMdef, hcolL, ← hδΦ, hδe, Fin.append_right, Pi.zero_apply]
    have h22 : ∀ i k, wcAddEquivMatrix e₂ Φ₂ (Fin.natAdd r₁ i) (Fin.natAdd r₁ k) =
        wcAddEquivMatrix e₃ Φ₃ i k := by
      intro i k
      rw [hMdef, hMdef, hpe, hpΦ, hcolR]
    have hN : Matrix.reindex finSumFinEquiv.symm finSumFinEquiv.symm (wcAddEquivMatrix e₂ Φ₂) =
        Matrix.fromBlocks (wcAddEquivMatrix e₁ Φ₁)
          (Matrix.of fun i k => wcAddEquivMatrix e₂ Φ₂ (Fin.castAdd r₃ i) (Fin.natAdd r₁ k)) 0
          (wcAddEquivMatrix e₃ Φ₃) := by
      ext (i | i) (j | j)
      · simp only [Matrix.reindex_apply, Equiv.symm_symm, Matrix.submatrix_apply,
          finSumFinEquiv_apply_left, Matrix.fromBlocks_apply₁₁]
        exact h11 i j
      · simp only [Matrix.reindex_apply, Equiv.symm_symm, Matrix.submatrix_apply,
          finSumFinEquiv_apply_left, finSumFinEquiv_apply_right, Matrix.fromBlocks_apply₁₂,
          Matrix.of_apply]
      · simp only [Matrix.reindex_apply, Equiv.symm_symm, Matrix.submatrix_apply,
          finSumFinEquiv_apply_left, finSumFinEquiv_apply_right, Matrix.fromBlocks_apply₂₁,
          Matrix.zero_apply]
        exact h21 i j
      · simp only [Matrix.reindex_apply, Equiv.symm_symm, Matrix.submatrix_apply,
          finSumFinEquiv_apply_right, Matrix.fromBlocks_apply₂₂]
        exact h22 i j
    have hchar : (wcAddEquivMatrix e₂ Φ₂).charpoly =
        (wcAddEquivMatrix e₁ Φ₁).charpoly * (wcAddEquivMatrix e₃ Φ₃).charpoly := by
      rw [← Matrix.charpoly_reindex finSumFinEquiv.symm (wcAddEquivMatrix e₂ Φ₂), hN,
        Matrix.charpoly_fromBlocks_zero₂₁]
    rw [hchar, Polynomial.aroots_mul
      ((Matrix.charpoly_monic _).mul (Matrix.charpoly_monic _)).ne_zero]
  have s2 : ∀ {V₁ V₂ V₃ : Type (u+1)} [AddCommGroup V₁] [AddCommGroup V₂] [AddCommGroup V₃]
      (σ₁ : ℚ_[ℓ] → V₁ →+ V₁) (σ₂ : ℚ_[ℓ] → V₂ →+ V₂) (σ₃ : ℚ_[ℓ] → V₃ →+ V₃)
      (δ : V₁ →+ V₂) (p : V₂ →+ V₃) (hδ : Function.Injective δ)
      (hex : ∀ y : V₂, p y = 0 → ∃ x, δ x = y) (hpδ : ∀ x : V₁, p (δ x) = 0)
      (hp : Function.Surjective p)
      (hδσ : ∀ (c : ℚ_[ℓ]) (x : V₁), δ (σ₁ c x) = σ₂ c (δ x))
      (hpσ : ∀ (c : ℚ_[ℓ]) (y : V₂), p (σ₂ c y) = σ₃ c (p y))
      (hσadd : ∀ (a b : ℚ_[ℓ]) (y : V₂), σ₂ (a + b) y = σ₂ a y + σ₂ b y)
      (hσmul : ∀ (a b : ℚ_[ℓ]) (y : V₂), σ₂ (a * b) y = σ₂ a (σ₂ b y))
      (r₁ r₃ : ℕ) (e₁ : V₁ ≃+ (Fin r₁ → ℚ_[ℓ]))
      (he₁ : ∀ (c : ℚ_[ℓ]) (x : V₁), e₁ (σ₁ c x) = c • e₁ x)
      (e₃ : V₃ ≃+ (Fin r₃ → ℚ_[ℓ])) (he₃ : ∀ (c : ℚ_[ℓ]) (z : V₃), e₃ (σ₃ c z) = c • e₃ z),
      ∃ e₂ : V₂ ≃+ (Fin (r₁ + r₃) → ℚ_[ℓ]),
        (∀ (c : ℚ_[ℓ]) (y : V₂), e₂ (σ₂ c y) = c • e₂ y) ∧
        (∀ x : V₁, e₂ (δ x) = Fin.append (e₁ x) 0) ∧
        (∀ (y : V₂) (i : Fin r₃), e₂ y (Fin.natAdd r₁ i) = e₃ (p y) i) := by
    intro V₁ V₂ V₃ _ _ _ σ₁ σ₂ σ₃ δ p hδ hex hpδ hp hδσ hpσ hσadd hσmul r₁ r₃ e₁ he₁ e₃ he₃
    have hσ0 : ∀ y : V₂, σ₂ 0 y = 0 := by
      intro y
      have h := hσadd 0 0 y
      rw [add_zero] at h
      have h' : σ₂ 0 y + σ₂ 0 y = σ₂ 0 y + 0 := by rw [add_zero]; exact h.symm
      exact add_left_cancel h'
    have he₁s : ∀ (c : ℚ_[ℓ]) (w : Fin r₁ → ℚ_[ℓ]), e₁.symm (c • w) = σ₁ c (e₁.symm w) :=
      fun c w => e₁.injective (by rw [he₁, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
    have he₃s : ∀ (c : ℚ_[ℓ]) (w : Fin r₃ → ℚ_[ℓ]), e₃.symm (c • w) = σ₃ c (e₃.symm w) :=
      fun c w => e₃.injective (by rw [he₃, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
    choose t ht using fun k : Fin r₃ => hp (e₃.symm (Pi.single k 1))
    have hsum : ∀ b : Fin r₃ → ℚ_[ℓ], p (∑ k, σ₂ (b k) (t k)) = e₃.symm b := by
      intro b
      rw [map_sum]
      have h1 : ∀ k, p (σ₂ (b k) (t k)) = e₃.symm (b k • Pi.single k 1) := by
        intro k; rw [hpσ, ht, he₃s]
      rw [Finset.sum_congr rfl (fun k _ => h1 k), ← map_sum e₃.symm]
      congr 1
      funext i
      simp [Finset.sum_apply, Pi.single_apply]
    let θf : (Fin (r₁ + r₃) → ℚ_[ℓ]) → V₂ := fun v =>
      δ (e₁.symm (fun i => v (Fin.castAdd r₃ i))) + ∑ k, σ₂ (v (Fin.natAdd r₁ k)) (t k)
    have hpθ : ∀ v, p (θf v) = e₃.symm (fun k => v (Fin.natAdd r₁ k)) := by
      intro v
      show p (δ _ + _) = _
      rw [map_add, hpδ, zero_add, hsum]
    have θadd : ∀ v w, θf (v + w) = θf v + θf w := by
      intro v w
      have h1 : (fun i => (v + w) (Fin.castAdd r₃ i)) =
          (fun i => v (Fin.castAdd r₃ i)) + (fun i => w (Fin.castAdd r₃ i)) := rfl
      show δ (e₁.symm (fun i => (v + w) (Fin.castAdd r₃ i))) +
          ∑ k, σ₂ ((v + w) (Fin.natAdd r₁ k)) (t k) =
        (δ (e₁.symm (fun i => v (Fin.castAdd r₃ i))) + ∑ k, σ₂ (v (Fin.natAdd r₁ k)) (t k)) +
        (δ (e₁.symm (fun i => w (Fin.castAdd r₃ i))) + ∑ k, σ₂ (w (Fin.natAdd r₁ k)) (t k))
      rw [h1, map_add, map_add]
      simp only [Pi.add_apply, hσadd, Finset.sum_add_distrib]
      abel
    have θsmul : ∀ (c : ℚ_[ℓ]) v, θf (c • v) = σ₂ c (θf v) := by
      intro c v
      have h1 : (fun i => (c • v) (Fin.castAdd r₃ i)) = c • (fun i => v (Fin.castAdd r₃ i)) := rfl
      show δ (e₁.symm (fun i => (c • v) (Fin.castAdd r₃ i))) +
          ∑ k, σ₂ ((c • v) (Fin.natAdd r₁ k)) (t k) =
        σ₂ c (δ (e₁.symm (fun i => v (Fin.castAdd r₃ i))) + ∑ k, σ₂ (v (Fin.natAdd r₁ k)) (t k))
      rw [h1, he₁s, hδσ, map_add, map_sum]
      congr 1
      refine Finset.sum_congr rfl (fun k _ => ?_)
      rw [Pi.smul_apply, smul_eq_mul, hσmul]
    have θinj : ∀ v, θf v = 0 → v = 0 := by
      intro v hv
      have hb : (fun k => v (Fin.natAdd r₁ k)) = 0 := by
        have h1 := hpθ v
        rw [hv, map_zero] at h1
        exact e₃.symm.injective (h1.symm.trans (map_zero e₃.symm).symm)
      have hb' : ∀ k, v (Fin.natAdd r₁ k) = 0 := fun k => congrFun hb k
      have ha : (fun i => v (Fin.castAdd r₃ i)) = 0 := by
        have hs : ∑ k, σ₂ (v (Fin.natAdd r₁ k)) (t k) = 0 :=
          Finset.sum_eq_zero (fun k _ => by rw [hb' k, hσ0])
        have h2 : θf v = δ (e₁.symm (fun i => v (Fin.castAdd r₃ i))) := by
          show _ + _ = _
          rw [hs, add_zero]
        rw [h2] at hv
        have h3 : e₁.symm (fun i => v (Fin.castAdd r₃ i)) = 0 := hδ (hv.trans (map_zero δ).symm)
        exact e₁.symm.injective (h3.trans (map_zero e₁.symm).symm)
      funext j
      induction j using Fin.addCases with
      | left i => exact congrFun ha i
      | right k => exact hb' k
    have θsurj : ∀ y, ∃ v, θf v = y := by
      intro y
      obtain ⟨x, hx⟩ := hex (y - ∑ k, σ₂ (e₃ (p y) k) (t k))
        (by rw [map_sub, hsum, AddEquiv.symm_apply_apply, sub_self])
      refine ⟨Fin.append (e₁ x) (e₃ (p y)), ?_⟩
      show δ (e₁.symm (fun i => Fin.append (e₁ x) (e₃ (p y)) (Fin.castAdd r₃ i))) +
        ∑ k, σ₂ (Fin.append (e₁ x) (e₃ (p y)) (Fin.natAdd r₁ k)) (t k) = y
      simp only [Fin.append_left, Fin.append_right]
      rw [show (fun i => e₁ x i) = e₁ x from rfl, AddEquiv.symm_apply_apply, hx]
      abel
    let θ : (Fin (r₁ + r₃) → ℚ_[ℓ]) →+ V₂ := AddMonoidHom.mk' θf θadd
    have hbij : Function.Bijective θ := by
      constructor
      · rw [injective_iff_map_eq_zero]
        intro v hv
        exact θinj v hv
      · intro y
        obtain ⟨v, hv⟩ := θsurj y
        exact ⟨v, hv⟩
    let E := AddEquiv.ofBijective θ hbij
    have hE : ∀ v, E v = θf v := fun v => rfl
    refine ⟨E.symm, ?_, ?_, ?_⟩
    · intro c y
      rw [AddEquiv.symm_apply_eq, hE, θsmul]
      congr 1
      rw [← hE, AddEquiv.apply_symm_apply]
    · intro x
      rw [AddEquiv.symm_apply_eq, hE]
      show δ x = δ (e₁.symm (fun i => Fin.append (e₁ x) 0 (Fin.castAdd r₃ i))) +
        ∑ k, σ₂ (Fin.append (e₁ x) (0 : Fin r₃ → ℚ_[ℓ]) (Fin.natAdd r₁ k)) (t k)
      simp only [Fin.append_left, Fin.append_right, Pi.zero_apply, hσ0, Finset.sum_const_zero,
        add_zero]
      rw [show (fun i => e₁ x i) = e₁ x from rfl, AddEquiv.symm_apply_apply]
    · intro y i
      have h1 := hpθ (E.symm y)
      rw [← hE, AddEquiv.apply_symm_apply] at h1
      rw [h1, AddEquiv.apply_symm_apply]

  have s5 : ∀ (P : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1})
      [Projective P] (Fr : P ⟶ P)
      {A B : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      (i : A ⟶ B) [Mono i]
      (sA : ℚ_[ℓ] → (A ⟶ A)) (sB : ℚ_[ℓ] → (B ⟶ B))
      (sQ : ℚ_[ℓ] → (Limits.cokernel i ⟶ Limits.cokernel i))
      (hAB : ∀ c, sA c ≫ i = i ≫ sB c)
      (hBQ : ∀ c, Limits.cokernel.π i ≫ sQ c = sB c ≫ Limits.cokernel.π i)
      (hBadd : ∀ a b, sB (a + b) = sB a + sB b) (hBmul : ∀ a b, sB (a * b) = sB b ≫ sB a)
      (rA : ℕ) (eA : Abelian.Ext P A 0 ≃+ (Fin rA → ℚ_[ℓ]))
      (heA : ∀ (c : ℚ_[ℓ]) (y : Abelian.Ext P A 0),
        eA ((Abelian.Ext.mk₀ (sA c)).postcomp P (add_zero 0) y) = c • eA y)
      (rQ : ℕ) (eQ : Abelian.Ext P (Limits.cokernel i) 0 ≃+ (Fin rQ → ℚ_[ℓ]))
      (heQ : ∀ (c : ℚ_[ℓ]) (y : Abelian.Ext P (Limits.cokernel i) 0),
        eQ ((Abelian.Ext.mk₀ (sQ c)).postcomp P (add_zero 0) y) = c • eQ y),
      ∃ (r : ℕ) (eB : Abelian.Ext P B 0 ≃+ (Fin r → ℚ_[ℓ])),
        (∀ (c : ℚ_[ℓ]) (y : Abelian.Ext P B 0),
          eB ((Abelian.Ext.mk₀ (sB c)).postcomp P (add_zero 0) y) = c • eB y) ∧
        (wcAddEquivMatrix eB ((Abelian.Ext.mk₀ Fr).precomp B (zero_add 0))).charpoly.aroots
            (AlgebraicClosure ℚ_[ℓ]) =
          (wcAddEquivMatrix eA ((Abelian.Ext.mk₀ Fr).precomp A (zero_add 0))).charpoly.aroots
              (AlgebraicClosure ℚ_[ℓ]) +
          (wcAddEquivMatrix eQ ((Abelian.Ext.mk₀ Fr).precomp (Limits.cokernel i)
            (zero_add 0))).charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) := by
    intro P _ Fr A B i _ sA sB sQ hAB hBQ hBadd hBmul rA eA heA rQ eQ heQ
    have hpost : ∀ {Y Z : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
        {n a b : ℕ} (β : Abelian.Ext Y Z n) (h : a + n = b) (x : Abelian.Ext P Y a),
        β.postcomp P h x = x.comp β h := fun _ _ _ => rfl
    have hpre : ∀ {W Y Z : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
        {n a b : ℕ} (α : Abelian.Ext W Y n) (h : n + a = b) (x : Abelian.Ext Y Z a),
        α.precomp Z h x = α.comp x h := fun _ _ _ => rfl
    obtain ⟨hsurj, hker⟩ := wc_ext0_projective_cokernel (P := P) i
    have hδ : Function.Injective ((Abelian.Ext.mk₀ i).postcomp P (add_zero 0)) := by
      rw [injective_iff_map_eq_zero]
      intro y hy
      rw [← Abelian.Ext.mk₀_homEquiv₀_apply y] at hy ⊢
      rw [hpost, Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_eq_zero_iff] at hy
      have h' : Abelian.Ext.homEquiv₀ y = 0 :=
        (cancel_mono i).mp (hy.trans Limits.zero_comp.symm)
      rw [h', Abelian.Ext.mk₀_zero]
    have hex : ∀ y : Abelian.Ext P B 0,
        (Abelian.Ext.mk₀ (Limits.cokernel.π i)).postcomp P (add_zero 0) y = 0 →
        ∃ x, (Abelian.Ext.mk₀ i).postcomp P (add_zero 0) x = y := by
      intro y hy
      obtain ⟨z, hz⟩ := (hker y).mp hy
      exact ⟨z, hz.symm⟩
    have hpδ : ∀ x : Abelian.Ext P A 0,
        (Abelian.Ext.mk₀ (Limits.cokernel.π i)).postcomp P (add_zero 0)
          ((Abelian.Ext.mk₀ i).postcomp P (add_zero 0) x) = 0 :=
      fun x => (hker _).mpr ⟨x, rfl⟩
    have hδσ : ∀ (c : ℚ_[ℓ]) (x : Abelian.Ext P A 0),
        (Abelian.Ext.mk₀ i).postcomp P (add_zero 0)
          ((Abelian.Ext.mk₀ (sA c)).postcomp P (add_zero 0) x) =
        (Abelian.Ext.mk₀ (sB c)).postcomp P (add_zero 0)
          ((Abelian.Ext.mk₀ i).postcomp P (add_zero 0) x) := by
      intro c x
      simp only [hpost]
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (add_zero 0) (by omega),
        Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, hAB]
    have hpσ : ∀ (c : ℚ_[ℓ]) (y : Abelian.Ext P B 0),
        (Abelian.Ext.mk₀ (Limits.cokernel.π i)).postcomp P (add_zero 0)
          ((Abelian.Ext.mk₀ (sB c)).postcomp P (add_zero 0) y) =
        (Abelian.Ext.mk₀ (sQ c)).postcomp P (add_zero 0)
          ((Abelian.Ext.mk₀ (Limits.cokernel.π i)).postcomp P (add_zero 0) y) := by
      intro c y
      simp only [hpost]
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (add_zero 0) (by omega),
        Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, hBQ]
    have hσadd : ∀ (a b : ℚ_[ℓ]) (y : Abelian.Ext P B 0),
        (Abelian.Ext.mk₀ (sB (a + b))).postcomp P (add_zero 0) y =
        (Abelian.Ext.mk₀ (sB a)).postcomp P (add_zero 0) y +
          (Abelian.Ext.mk₀ (sB b)).postcomp P (add_zero 0) y := by
      intro a b y
      simp only [hpost]
      rw [hBadd, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add]
    have hσmul : ∀ (a b : ℚ_[ℓ]) (y : Abelian.Ext P B 0),
        (Abelian.Ext.mk₀ (sB (a * b))).postcomp P (add_zero 0) y =
        (Abelian.Ext.mk₀ (sB a)).postcomp P (add_zero 0)
          ((Abelian.Ext.mk₀ (sB b)).postcomp P (add_zero 0) y) := by
      intro a b y
      simp only [hpost]
      rw [hBmul, ← Abelian.Ext.mk₀_comp_mk₀,
        Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (add_zero 0) (by omega)]
    have hδΦ : ∀ x : Abelian.Ext P A 0,
        (Abelian.Ext.mk₀ i).postcomp P (add_zero 0)
          ((Abelian.Ext.mk₀ Fr).precomp A (zero_add 0) x) =
        (Abelian.Ext.mk₀ Fr).precomp B (zero_add 0)
          ((Abelian.Ext.mk₀ i).postcomp P (add_zero 0) x) := by
      intro x
      simp only [hpost, hpre]
      exact Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (add_zero 0) (by omega)
    have hpΦ : ∀ y : Abelian.Ext P B 0,
        (Abelian.Ext.mk₀ (Limits.cokernel.π i)).postcomp P (add_zero 0)
          ((Abelian.Ext.mk₀ Fr).precomp B (zero_add 0) y) =
        (Abelian.Ext.mk₀ Fr).precomp (Limits.cokernel i) (zero_add 0)
          ((Abelian.Ext.mk₀ (Limits.cokernel.π i)).postcomp P (add_zero 0) y) := by
      intro y
