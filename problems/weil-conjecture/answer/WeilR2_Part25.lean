  haveI hfA : IsProper (Limits.pullback.fst V.hom D.f ≫ e.hom) := inferInstance

  have hp1 : (((wcProEtPullback D.f).map u').left :
      Limits.pullback Vt.hom D.f ⟶ Limits.pullback V.hom D.f) ≫
