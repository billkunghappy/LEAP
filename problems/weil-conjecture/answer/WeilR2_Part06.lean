    obtain ⟨ψ₀⟩ : Nonempty (L →ₐ[k] N) := ⟨res (IsAlgClosed.lift : L →ₐ[k] Ω)⟩
    obtain ⟨H, hH⟩ : ∃ H : Subgroup (N ≃ₐ[k] N), ∀ τ, τ ∈ H ↔ γN (act τ ψ₀) = γN ψ₀ :=
      ⟨{ carrier := {τ | γN (act τ ψ₀) = γN ψ₀}
         one_mem' := by
           show γN (act 1 ψ₀) = γN ψ₀
           rw [act_one]
         mul_mem' := by
           intro τ₁ τ₂ h₁ h₂
           show γN (act (τ₁ * τ₂) ψ₀) = γN ψ₀
           rw [act_mul]
           exact (hI τ₁ _ _ h₂).trans h₁
         inv_mem' := by
           intro τ h
           show γN (act τ⁻¹ ψ₀) = γN ψ₀
           have h' := hI τ⁻¹ _ _ h
           rw [← act_mul, inv_mul_cancel, act_one] at h'
           exact h'.symm }, fun _ => Iff.rfl⟩
    have hM : (IntermediateField.fixedField H).fixingSubgroup = H :=
      IntermediateField.fixingSubgroup_fixedField H
    have hMP : IntermediateField.fixedField H ≤ ψ₀.fieldRange := by
      have h1 : ψ₀.fieldRange.fixingSubgroup ≤ H := by
        intro τ hτ
        have h2 : act τ ψ₀ = ψ₀ := AlgHom.ext fun a =>
          (IntermediateField.mem_fixingSubgroup_iff _ _).mp hτ (ψ₀ a)
            (AlgHom.mem_fieldRange.mpr ⟨a, rfl⟩)
        rw [hH, h2]
      calc IntermediateField.fixedField H
          ≤ IntermediateField.fixedField ψ₀.fieldRange.fixingSubgroup :=
            IntermediateField.fixedField_le h1
        _ = ψ₀.fieldRange := IsGalois.fixedField_fixingSubgroup _
    obtain ⟨L', hL'⟩ : ∃ L' : Subfield L, ∀ a, a ∈ L' ↔ ψ₀ a ∈ IntermediateField.fixedField H :=
      ⟨Subfield.comap ψ₀.toRingHom (IntermediateField.fixedField H).toSubfield, fun _ => Iff.rfl⟩
    refine ⟨L', fun c => (hL' _).mpr ?_, fun φ φ' => ?_⟩
    · rw [ψ₀.commutes]
      exact IntermediateField.algebraMap_mem _ c
    obtain ⟨τ₁, h₁⟩ := htrans ψ₀ (res φ)
    obtain ⟨τ₂, h₂⟩ := htrans ψ₀ (res φ')
    have hφ : ∀ a, φ a = ((τ₁ (ψ₀ a) : N) : Ω) := fun a => by
      rw [← act_apply τ₁ ψ₀ a, h₁]; rfl
    have hφ' : ∀ a, φ' a = ((τ₂ (ψ₀ a) : N) : Ω) := fun a => by
      rw [← act_apply τ₂ ψ₀ a, h₂]; rfl
    rw [← hγN φ, ← hγN φ', ← h₁, ← h₂]
    constructor
    · intro h a ha
      have hτ : τ₁⁻¹ * τ₂ ∈ H := by
        rw [hH]
        have h' := hI τ₁⁻¹ _ _ h
        rw [← act_mul, ← act_mul, inv_mul_cancel, act_one] at h'
        exact h'.symm
      rw [← hM] at hτ
      have h3 := (IntermediateField.mem_fixingSubgroup_iff _ _).mp hτ (ψ₀ a) ((hL' a).mp ha)
      rw [AlgEquiv.mul_apply] at h3
      have h4 := congrArg τ₁ h3
      rw [AlgEquiv.aut_inv, AlgEquiv.apply_symm_apply] at h4
      rw [hφ, hφ', h4]
    · intro h
      have hτ : τ₁⁻¹ * τ₂ ∈ (IntermediateField.fixedField H).fixingSubgroup := by
        rw [IntermediateField.mem_fixingSubgroup_iff]
        intro m hm
        obtain ⟨a, rfl⟩ := AlgHom.mem_fieldRange.mp (hMP hm)
        have h4 : τ₁ (ψ₀ a) = τ₂ (ψ₀ a) :=
          Subtype.ext ((hφ a).symm.trans ((h a ((hL' a).mpr hm)).trans (hφ' a)))
        rw [AlgEquiv.mul_apply, ← h4, AlgEquiv.aut_inv, AlgEquiv.symm_apply_apply]
      rw [hM, hH] at hτ
      have h' := hI τ₁ _ _ hτ
      rw [← act_mul, mul_inv_cancel_left] at h'
      exact h'.symm

  have hs2 : ∀ (Y B' : Scheme.{u}) (h : Y ⟶ B') [Etale h] (y : Y),
      letI := (h.residueFieldMap y).hom.toAlgebra;
      FiniteDimensional (B'.residueField (h y)) (Y.residueField y) ∧
        Algebra.IsSeparable (B'.residueField (h y)) (Y.residueField y) := by
    intro Y B' h _ y
    letI A : Algebra (B'.presheaf.stalk (h y)) (Y.presheaf.stalk y) := (h.stalkMap y).hom.toAlgebra
    haveI : IsLocalHom (algebraMap (B'.presheaf.stalk (h y)) (Y.presheaf.stalk y)) :=
      inferInstanceAs (IsLocalHom (h.stalkMap y).hom)
    haveI : Algebra.FormallyUnramified (B'.presheaf.stalk (h y)) (Y.presheaf.stalk y) :=
      AlgebraicGeometry.FormallyUnramified.stalkMap h y
    haveI : Algebra.EssFiniteType (B'.presheaf.stalk (h y)) (Y.presheaf.stalk y) :=
      AlgebraicGeometry.LocallyOfFiniteType.stalkMap h y
    have h1 : Module.Finite (IsLocalRing.ResidueField (B'.presheaf.stalk (h y)))
        (IsLocalRing.ResidueField (Y.presheaf.stalk y)) :=
      Algebra.instFiniteResidueFieldOfFormallyUnramified
    have h2 : Algebra.IsSeparable (IsLocalRing.ResidueField (B'.presheaf.stalk (h y)))
        (IsLocalRing.ResidueField (Y.presheaf.stalk y)) :=
      Algebra.instIsSeparableResidueFieldOfFormallyUnramified
    have heq : (h.residueFieldMap y).hom.toAlgebra =
        (IsLocalRing.ResidueField.instAlgebra : Algebra
          (IsLocalRing.ResidueField (B'.presheaf.stalk (h y)))
          (IsLocalRing.ResidueField (Y.presheaf.stalk y))) :=
      Algebra.algebra_ext _ _ (fun r => rfl)
    show @FiniteDimensional _ _ _ _ (h.residueFieldMap y).hom.toAlgebra.toModule ∧
      @Algebra.IsSeparable _ _ _ _ (h.residueFieldMap y).hom.toAlgebra
    rw [heq]
    exact ⟨h1, h2⟩
  intro B b F V₀ v₀ hv s₀
  subst hv
  classical

  have hs3 : ∀ φ : V₀.left.residueField v₀ ⟶
      CommRingCat.of (AlgebraicClosure (B.residueField (V₀.hom v₀))),
      (Spec.map φ ≫ V₀.left.fromSpecResidueField v₀) ≫ V₀.hom = wcEtGeomPt B (V₀.hom v₀) ↔
        V₀.hom.residueFieldMap v₀ ≫ φ = CommRingCat.ofHom (algebraMap (B.residueField (V₀.hom v₀))
          (AlgebraicClosure (B.residueField (V₀.hom v₀)))) := by
    intro φ
    have e : (Spec.map φ ≫ V₀.left.fromSpecResidueField v₀) ≫ V₀.hom =
        Spec.map (V₀.hom.residueFieldMap v₀ ≫ φ) ≫ B.fromSpecResidueField (V₀.hom v₀) := by
      rw [Category.assoc, ← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField,
        ← Category.assoc, ← Spec.map_comp]
      rfl
    rw [e]
    constructor
    · intro h
      apply Spec.map_injective
      exact (cancel_mono (B.fromSpecResidueField (V₀.hom v₀))).mp h
    · intro h
      rw [h]

  have hC : ∀ (t t₁ : Spec (.of (AlgebraicClosure (B.residueField (V₀.hom v₀)))) ⟶ V₀.left),
      t = t₁ → ∀ (ht : t ≫ V₀.hom = wcEtGeomPt B (V₀.hom v₀))
      (ht₁ : t₁ ≫ V₀.hom = wcEtGeomPt B (V₀.hom v₀)),
      (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B (V₀.hom v₀)))
        (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk (Over.homMk t ht :
          Over.mk (wcEtGeomPt B (V₀.hom v₀)) ⟶ (Scheme.Etale.forget B).obj V₀)))).hom s₀ =
      (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B (V₀.hom v₀)))
        (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk (Over.homMk t₁ ht₁ :
          Over.mk (wcEtGeomPt B (V₀.hom v₀)) ⟶ (Scheme.Etale.forget B).obj V₀)))).hom s₀ := by
    intro t t₁ h ht ht₁
    subst h
    rfl

  have hs4 : ∀ (τ : Spec (.of (AlgebraicClosure (B.residueField (V₀.hom v₀)))) ⟶
      Spec (.of (AlgebraicClosure (B.residueField (V₀.hom v₀))))),
      τ ≫ wcEtGeomPt B (V₀.hom v₀) = wcEtGeomPt B (V₀.hom v₀) →
      ∃ Ψ : Limits.colimit ((StructuredArrow.proj (Over.mk (wcEtGeomPt B (V₀.hom v₀)))
        (Scheme.Etale.forget B)).op ⋙ F.obj) ⟶ Limits.colimit ((StructuredArrow.proj
          (Over.mk (wcEtGeomPt B (V₀.hom v₀))) (Scheme.Etale.forget B)).op ⋙ F.obj),
      ∀ (t : Spec (.of (AlgebraicClosure (B.residueField (V₀.hom v₀)))) ⟶ V₀.left)
        (ht : t ≫ V₀.hom = wcEtGeomPt B (V₀.hom v₀))
        (h1 : (τ ≫ t) ≫ V₀.hom = wcEtGeomPt B (V₀.hom v₀)),
        Ψ.hom ((Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B (V₀.hom v₀)))
          (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk (Over.homMk t ht :
            Over.mk (wcEtGeomPt B (V₀.hom v₀)) ⟶ (Scheme.Etale.forget B).obj V₀)))).hom s₀) =
        (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B (V₀.hom v₀)))
          (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk
            (Over.homMk (τ ≫ t) h1 :
              Over.mk (wcEtGeomPt B (V₀.hom v₀)) ⟶ (Scheme.Etale.forget B).obj V₀)))).hom s₀ := by
    intro τ hτ
    let D := (StructuredArrow.proj (Over.mk (wcEtGeomPt B (V₀.hom v₀)))
      (Scheme.Etale.forget B)).op ⋙ F.obj
    let τh : Over.mk (wcEtGeomPt B (V₀.hom v₀)) ⟶ Over.mk (wcEtGeomPt B (V₀.hom v₀)) :=
      Over.homMk τ hτ
    let E := StructuredArrow.map (T := Scheme.Etale.forget B) τh
    let c : Limits.Cocone D :=
      { pt := Limits.colimit D
        ι := { app := fun A => Limits.colimit.ι D (Opposite.op (E.obj A.unop))
               naturality := fun A A' g => by
                 simp only [Functor.const_obj_obj, Functor.const_obj_map, Category.comp_id]
                 exact Limits.colimit.w D (E.map g.unop).op } }
    refine ⟨Limits.colimit.desc D c, fun t ht h1 => ?_⟩
    have h2 := Limits.colimit.ι_desc c (Opposite.op (StructuredArrow.mk (Over.homMk t ht :
        Over.mk (wcEtGeomPt B (V₀.hom v₀)) ⟶ (Scheme.Etale.forget B).obj V₀)))
    have h3 : c.ι.app (Opposite.op (StructuredArrow.mk (Over.homMk t ht :
        Over.mk (wcEtGeomPt B (V₀.hom v₀)) ⟶ (Scheme.Etale.forget B).obj V₀))) =
        Limits.colimit.ι D (Opposite.op (StructuredArrow.mk (Over.homMk (τ ≫ t) h1 :
          Over.mk (wcEtGeomPt B (V₀.hom v₀)) ⟶ (Scheme.Etale.forget B).obj V₀))) := rfl
    rw [h3] at h2
    rw [← h2]
    rfl

  haveI : Etale V₀.hom := V₀.prop
  letI : Algebra (B.residueField (V₀.hom v₀)) (V₀.left.residueField v₀) :=
    (V₀.hom.residueFieldMap v₀).hom.toAlgebra
  obtain ⟨hfin, hsep⟩ := hs2 V₀.left B V₀.hom v₀
  haveI := hfin
  haveI := hsep

  have hlift : ∀ ψ : (V₀.left.residueField v₀) →ₐ[B.residueField (V₀.hom v₀)]
      AlgebraicClosure (B.residueField (V₀.hom v₀)),
      (Spec.map (CommRingCat.ofHom ψ.toRingHom) ≫ V₀.left.fromSpecResidueField v₀) ≫ V₀.hom =
        wcEtGeomPt B (V₀.hom v₀) := by
    intro ψ
    rw [hs3]
    ext c
    exact ψ.commutes c

  let γ : ((V₀.left.residueField v₀) →ₐ[B.residueField (V₀.hom v₀)]
      AlgebraicClosure (B.residueField (V₀.hom v₀))) →
      ↑(Limits.colimit ((StructuredArrow.proj (Over.mk (wcEtGeomPt B (V₀.hom v₀)))
        (Scheme.Etale.forget B)).op ⋙ F.obj)) := fun ψ =>
    (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B (V₀.hom v₀)))
      (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk
        (Over.homMk (Spec.map (CommRingCat.ofHom ψ.toRingHom) ≫ V₀.left.fromSpecResidueField v₀)
          (hlift ψ) :
          Over.mk (wcEtGeomPt B (V₀.hom v₀)) ⟶ (Scheme.Etale.forget B).obj V₀)))).hom s₀

  have htw : ∀ (σ : AlgebraicClosure (B.residueField (V₀.hom v₀)) →ₐ[B.residueField (V₀.hom v₀)]
      AlgebraicClosure (B.residueField (V₀.hom v₀)))
      (ψ ψ' : (V₀.left.residueField v₀) →ₐ[B.residueField (V₀.hom v₀)]
        AlgebraicClosure (B.residueField (V₀.hom v₀))),
      γ ψ = γ ψ' → γ (σ.comp ψ) = γ (σ.comp ψ') := by
    intro σ ψ ψ' h
    have hσa : CommRingCat.ofHom (algebraMap (B.residueField (V₀.hom v₀))
        (AlgebraicClosure (B.residueField (V₀.hom v₀)))) ≫ CommRingCat.ofHom σ.toRingHom =
        CommRingCat.ofHom (algebraMap (B.residueField (V₀.hom v₀))
          (AlgebraicClosure (B.residueField (V₀.hom v₀)))) := by
      ext c
      exact σ.commutes c
    have hτ : Spec.map (CommRingCat.ofHom σ.toRingHom) ≫ wcEtGeomPt B (V₀.hom v₀) =
        wcEtGeomPt B (V₀.hom v₀) := by
      show Spec.map (CommRingCat.ofHom σ.toRingHom) ≫ (Spec.map (CommRingCat.ofHom
        (algebraMap (B.residueField (V₀.hom v₀)) (AlgebraicClosure (B.residueField (V₀.hom v₀))))) ≫
          B.fromSpecResidueField (V₀.hom v₀)) = Spec.map (CommRingCat.ofHom
        (algebraMap (B.residueField (V₀.hom v₀)) (AlgebraicClosure (B.residueField (V₀.hom v₀))))) ≫
          B.fromSpecResidueField (V₀.hom v₀)
      rw [← Category.assoc, ← Spec.map_comp, hσa]
    obtain ⟨Ψ, hΨ⟩ := hs4 _ hτ
    have hcomp : ∀ ψ₁ : (V₀.left.residueField v₀) →ₐ[B.residueField (V₀.hom v₀)]
        AlgebraicClosure (B.residueField (V₀.hom v₀)),
        Spec.map (CommRingCat.ofHom σ.toRingHom) ≫
          (Spec.map (CommRingCat.ofHom ψ₁.toRingHom) ≫ V₀.left.fromSpecResidueField v₀) =
        Spec.map (CommRingCat.ofHom (σ.comp ψ₁).toRingHom) ≫ V₀.left.fromSpecResidueField v₀ := by
      intro ψ₁
      rw [← Category.assoc, ← Spec.map_comp]
      rfl
    have h1 : (Spec.map (CommRingCat.ofHom σ.toRingHom) ≫
        (Spec.map (CommRingCat.ofHom ψ.toRingHom) ≫ V₀.left.fromSpecResidueField v₀)) ≫ V₀.hom =
        wcEtGeomPt B (V₀.hom v₀) := by
      rw [hcomp]; exact hlift _
    have h1' : (Spec.map (CommRingCat.ofHom σ.toRingHom) ≫
        (Spec.map (CommRingCat.ofHom ψ'.toRingHom) ≫ V₀.left.fromSpecResidueField v₀)) ≫ V₀.hom =
        wcEtGeomPt B (V₀.hom v₀) := by
      rw [hcomp]; exact hlift _
    calc γ (σ.comp ψ) = _ := hC _ _ (hcomp ψ).symm (hlift _) h1
      _ = Ψ.hom (γ ψ) := (hΨ _ (hlift ψ) h1).symm
      _ = Ψ.hom (γ ψ') := congrArg (fun z => Ψ.hom z) h
      _ = _ := hΨ _ (hlift ψ') h1'
      _ = γ (σ.comp ψ') := hC _ _ (hcomp ψ') h1' (hlift _)

  obtain ⟨L'₀, hk, hiff⟩ := hs5 (B.residueField (V₀.hom v₀))
    (V₀.left.residueField v₀) (AlgebraicClosure (B.residueField (V₀.hom v₀))) _ γ htw
  refine ⟨L'₀, ?_, ?_⟩
  · rintro _ ⟨c, rfl⟩
    exact hk c
  · intro φ φ' ht ht'
    have hφ := (hs3 φ).mp ht
    have hφ' := (hs3 φ').mp ht'
    let ψ : (V₀.left.residueField v₀) →ₐ[B.residueField (V₀.hom v₀)]
        AlgebraicClosure (B.residueField (V₀.hom v₀)) :=
      { toRingHom := φ.hom
        commutes' := fun c => congrArg (fun f => CommRingCat.Hom.hom f c) hφ }
    let ψ' : (V₀.left.residueField v₀) →ₐ[B.residueField (V₀.hom v₀)]
        AlgebraicClosure (B.residueField (V₀.hom v₀)) :=
      { toRingHom := φ'.hom
        commutes' := fun c => congrArg (fun f => CommRingCat.Hom.hom f c) hφ' }
    refine Iff.trans (Eq.congr
      (hC _ (Spec.map (CommRingCat.ofHom ψ.toRingHom) ≫ V₀.left.fromSpecResidueField v₀) rfl ht
        (hlift ψ))
      (hC _ (Spec.map (CommRingCat.ofHom ψ'.toRingHom) ≫ V₀.left.fromSpecResidueField v₀) rfl ht'
        (hlift ψ'))) ?_
    exact hiff ψ ψ'

theorem wc_esgr_etale_model : ∀ (B : Scheme.{u}) (b : B) (K : Type u) [Field K] [Algebra (B.residueField b) K] [FiniteDimensional (B.residueField b) K] [Algebra.IsSeparable (B.residueField b) K], ∃ (V' : B.Etale) (v' : V'.left) (e : V'.left.residueField v' ⟶ CommRingCat.of K), IsIso e ∧ V'.hom v' = b ∧ (∀ w : V'.left, V'.hom w = b → w = v') ∧ (Spec.map e ≫ V'.left.fromSpecResidueField v') ≫ V'.hom = Spec.map (CommRingCat.ofHom (algebraMap (B.residueField b) K)) ≫ B.fromSpecResidueField b :=
by
  intro B b K _ _ _ _
  have s1 : ∀ (R : Type u) [CommRing R] (κ : Type u) [Field κ] (q : R →+* κ),
      (∀ c : κ, ∃ r s : R, q s ≠ 0 ∧ c * q s = q r) → ∀ (L : Type u) [Field L] (χ : R →+* L),
      RingHom.ker χ = RingHom.ker q → ∃ j : κ →+* L, j.comp q = χ := by
    intro R _ κ _ q hfrac L _ χ hker
    classical
    have hqb : Function.Injective q.kerLift := q.kerLift_injective
    let χb : R ⧸ RingHom.ker q →+* L := Ideal.Quotient.lift (RingHom.ker q) χ (fun a ha => by
      have : a ∈ RingHom.ker χ := hker ▸ ha
      exact this)
    have hχb : Function.Injective χb := by
      rw [injective_iff_map_eq_zero]
      intro a ha
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a
      change χ a = 0 at ha
      rw [Ideal.Quotient.eq_zero_iff_mem]
      rw [← hker]; exact ha
    letI : Algebra (R ⧸ RingHom.ker q) κ := q.kerLift.toAlgebra
    haveI : FaithfulSMul (R ⧸ RingHom.ker q) κ :=
      (faithfulSMul_iff_algebraMap_injective _ _).mpr hqb
    haveI : IsFractionRing (R ⧸ RingHom.ker q) κ := IsFractionRing.of_field _ _ (fun z => by
      obtain ⟨r, s, hs, h⟩ := hfrac z
      refine ⟨Ideal.Quotient.mk _ r, Ideal.Quotient.mk _ s, ?_⟩
      show z = q.kerLift (Ideal.Quotient.mk _ r) / q.kerLift (Ideal.Quotient.mk _ s)
      rw [RingHom.kerLift_mk, RingHom.kerLift_mk, eq_div_iff hs, h])
    refine ⟨IsFractionRing.lift hχb, ?_⟩
    ext r
    have : q r = algebraMap (R ⧸ RingHom.ker q) κ (Ideal.Quotient.mk _ r) :=
      (RingHom.kerLift_mk q r).symm
    rw [RingHom.comp_apply, this, IsFractionRing.lift_algebraMap]
    rfl
  have s4 : ∀ (R : Type u) [CommRing R] (κ : Type u) [Field κ] (q : R →+* κ),
      (∀ c : κ, ∃ r s : R, q s ≠ 0 ∧ c * q s = q r) → ∀ (K : Type u) [Field K] [Algebra κ K] (β : K),
      IntermediateField.adjoin κ {β} = ⊤ → ∀ S : Subfield K, (∀ r : R, algebraMap κ K (q r) ∈ S) →
      β ∈ S → S = ⊤ := by
    intro R _ κ _ q hfrac K _ _ β hβ S hS hβS
    have hκ : ∀ c : κ, algebraMap κ K c ∈ S := by
      intro c
      obtain ⟨r, s, hs, h⟩ := hfrac c
      have : c = q r / q s := by rw [eq_div_iff hs, h]
      rw [this, map_div₀]
      exact S.div_mem (hS r) (hS s)
    have h1 : IntermediateField.adjoin κ {β} ≤ S.toIntermediateField hκ :=
      IntermediateField.adjoin_simple_le_iff.mpr hβS
    rw [hβ] at h1
    rw [eq_top_iff]
    intro y _
    exact h1 (IntermediateField.mem_top : y ∈ (⊤ : IntermediateField κ K))
  have s5 : ∀ (R : Type u) [CommRing R] (κ : Type u) [Field κ] (q : R →+* κ) (K : Type u) [Field K]
      [Algebra κ K] [FiniteDimensional κ K] (β : K) (F : Polynomial R) (A : Type u) [CommRing A]
      [Algebra R A] (x : A) (ψ : A →+* K), IntermediateField.adjoin κ {β} = ⊤ →
      F.map q = minpoly κ β → Polynomial.aeval x F = 0 → ψ x = β →
      ψ.comp (algebraMap R A) = (algebraMap κ K).comp q →
      (∀ (L : Type u) [Field L] (f g : A →+* L), f.comp (algebraMap R A) = g.comp (algebraMap R A) →
        f x = g x → f = g) →
      (∀ (L : Type u) [Field L] (χ : R →+* L), RingHom.ker χ = RingHom.ker q →
        ∃ j : κ →+* L, j.comp q = χ) →
      ∀ Q : Ideal A, Q.IsPrime → Q.comap (algebraMap R A) = RingHom.ker q → Q = RingHom.ker ψ := by
    intro R _ κ _ q K _ _ _ β F A _ _ x ψ hβ hFq hxF hψx hψR huniq hlift Q hQ hQc
    have hkerA : RingHom.ker (algebraMap A Q.ResidueField) = Q := Ideal.ker_algebraMap_residueField Q
    have hkerχ : RingHom.ker ((algebraMap A Q.ResidueField).comp (algebraMap R A)) =
        RingHom.ker q := by
      rw [← RingHom.comap_ker, hkerA, hQc]
    obtain ⟨j, hj⟩ := hlift Q.ResidueField _ hkerχ
    have hroot : Polynomial.eval₂ j (algebraMap A Q.ResidueField x) (minpoly κ β) = 0 := by
      rw [← hFq, Polynomial.eval₂_map, hj, ← Polynomial.hom_eval₂, ← Polynomial.aeval_def, hxF,
        map_zero]
    letI : Algebra κ Q.ResidueField := j.toAlgebra
    have hint : IsIntegral κ β := IsIntegral.of_finite κ β
    have hadj : Algebra.adjoin κ {β} = ⊤ :=
      (IntermediateField.adjoin_simple_eq_top_iff_of_isAlgebraic hint.isAlgebraic).mp hβ
    have hpbgen : (PowerBasis.ofAdjoinEqTop hint hadj).gen = β :=
      PowerBasis.ofAdjoinEqTop_gen hint hadj
    have hroot' : Polynomial.aeval (algebraMap A Q.ResidueField x)
        (minpoly κ (PowerBasis.ofAdjoinEqTop hint hadj).gen) = 0 := by
      rw [hpbgen, Polynomial.aeval_def, RingHom.algebraMap_toAlgebra]; exact hroot
    have hσβ : (PowerBasis.ofAdjoinEqTop hint hadj).lift _ hroot' β =
        algebraMap A Q.ResidueField x := by
      have := PowerBasis.lift_gen (PowerBasis.ofAdjoinEqTop hint hadj) _ hroot'
      rw [hpbgen] at this; exact this
    have heq : algebraMap A Q.ResidueField =
        (((PowerBasis.ofAdjoinEqTop hint hadj).lift _ hroot' : K →ₐ[κ] Q.ResidueField) :
          K →+* Q.ResidueField).comp ψ := by
      apply huniq Q.ResidueField
      · rw [RingHom.comp_assoc, hψR, ← RingHom.comp_assoc, AlgHom.comp_algebraMap,
          RingHom.algebraMap_toAlgebra, hj]
      · rw [RingHom.comp_apply, hψx]
        exact hσβ.symm
    rw [← hkerA, heq, RingHom.ker_comp_of_injective]
    exact RingHom.injective _
  have s3 : ∀ (R : Type u) [CommRing R] (κ : Type u) [Field κ] (q : R →+* κ) (K : Type u) [Field K]
      [Algebra κ K] [Algebra.IsSeparable κ K] (β : K) (F : Polynomial R), F.Monic →
      F.map q = minpoly κ β →
      ∃ (A : Type u) (_ : CommRing A) (_ : Algebra R A) (x : A) (ψ : A →+* K), Algebra.Etale R A ∧
        Polynomial.aeval x F = 0 ∧ ψ x = β ∧ ψ.comp (algebraMap R A) = (algebraMap κ K).comp q ∧
        ∀ (L : Type u) [Field L] (f g : A →+* L), f.comp (algebraMap R A) = g.comp (algebraMap R A) →
          f x = g x → f = g := by
    intro R _ κ _ q K _ _ _ β F hFm hFq
    let P : StandardEtalePair R := ⟨F, hFm, Polynomial.derivative F, ⟨1, 0, 1, by ring⟩⟩
    letI : Algebra R K := ((algebraMap κ K).comp q).toAlgebra
    have hev : ∀ p : Polynomial R, Polynomial.aeval β p = Polynomial.aeval β (p.map q) := by
      intro p
      rw [Polynomial.aeval_def, Polynomial.aeval_def, Polynomial.eval₂_map,
        RingHom.algebraMap_toAlgebra]
    have hsep : (minpoly κ β).Separable := Algebra.IsSeparable.isSeparable κ β
    have hmap : P.HasMap β := by
      unfold StandardEtalePair.HasMap
      refine ⟨?_, ?_⟩
      · show Polynomial.aeval β F = 0
        rw [hev, hFq, minpoly.aeval]
      · show IsUnit (Polynomial.aeval β (Polynomial.derivative F))
        rw [hev, ← Polynomial.derivative_map, hFq]
        exact (hsep.aeval_derivative_ne_zero (minpoly.aeval κ β)).isUnit
    have hX : Polynomial.aeval P.X F = 0 := by
      have h := (StandardEtalePair.hasMap_X (P := P))
      unfold StandardEtalePair.HasMap at h
      exact h.1
    refine ⟨P.Ring, inferInstance, inferInstance, P.X, (P.lift β hmap).toRingHom, P.instEtaleRing,
      hX, P.lift_X β hmap, ?_, ?_⟩
    · exact (P.lift β hmap).comp_algebraMap
    · intro L _ f g hfg hx
      letI : Algebra R L := (f.comp (algebraMap R P.Ring)).toAlgebra
      let f' : P.Ring →ₐ[R] L := { f with commutes' := fun r => rfl }
      let g' : P.Ring →ₐ[R] L := { g with commutes' := fun r => (RingHom.congr_fun hfg r).symm }
      have := StandardEtalePair.hom_ext (f := f') (g := g') hx
      ext a
      exact congrArg (fun h : P.Ring →ₐ[R] L => h a) this
  have s2 : ∀ (R : Type u) [CommRing R] (κ : Type u) [Field κ] (q : R →+* κ),
      (∀ c : κ, ∃ r s : R, q s ≠ 0 ∧ c * q s = q r) → ∀ (K : Type u) [Field K] [Algebra κ K]
      [FiniteDimensional κ K] [Algebra.IsSeparable κ K],
      ∃ (β : K) (F : Polynomial R), IntermediateField.adjoin κ {β} = ⊤ ∧ F.Monic ∧
        F.map q = minpoly κ β := by
    intro R _ κ _ q hfrac K _ _ _ _
    classical
    obtain ⟨α, hα⟩ := Field.exists_primitive_element κ K
    have hαi : IsIntegral κ α := IsIntegral.of_finite κ α
    have hfm : (minpoly κ α).Monic := minpoly.monic hαi
    have hnK : (minpoly κ α).natDegree = Module.finrank κ K := by
      rw [← IntermediateField.adjoin.finrank hαi, hα, IntermediateField.finrank_top']
    choose r s hs hrs using fun i => hfrac ((minpoly κ α).coeff i)
    obtain ⟨n, hn⟩ : ∃ n, (minpoly κ α).natDegree = n := ⟨_, rfl⟩
    obtain ⟨S, hSdef⟩ : ∃ S : R, S = ∏ i ∈ Finset.range n, s i := ⟨_, rfl⟩
    have hS : q S ≠ 0 := by
      rw [hSdef, map_prod]
      exact Finset.prod_ne_zero_iff.mpr (fun i _ => hs i)
    obtain ⟨β, hβdef⟩ : ∃ β : K, β = algebraMap κ K (q S) * α := ⟨_, rfl⟩
    have hβ : IntermediateField.adjoin κ {β} = ⊤ := by
      rw [eq_top_iff, ← hα, IntermediateField.adjoin_simple_le_iff]
      have : α = (q S)⁻¹ • β := by
        rw [hβdef, Algebra.smul_def, ← mul_assoc, ← map_mul, inv_mul_cancel₀ hS, map_one, one_mul]
      rw [this]
      exact IntermediateField.smul_mem _ (IntermediateField.mem_adjoin_simple_self κ β)
    have hgm : ((minpoly κ α).scaleRoots (q S)).Monic :=
      (Polynomial.monic_scaleRoots_iff _).mpr hfm
    have hgdeg : ((minpoly κ α).scaleRoots (q S)).natDegree = n := by
      rw [Polynomial.natDegree_scaleRoots, hn]
    have hgβ : Polynomial.aeval β ((minpoly κ α).scaleRoots (q S)) = 0 := by
      rw [hβdef]; exact Polynomial.scaleRoots_aeval_eq_zero (minpoly.aeval κ α)
    have hβi : IsIntegral κ β := IsIntegral.of_finite κ β
    have hmindeg : (minpoly κ β).natDegree = n := by
      rw [← IntermediateField.adjoin.finrank hβi, hβ, IntermediateField.finrank_top', ← hnK, hn]
    have hgmin : (minpoly κ α).scaleRoots (q S) = minpoly κ β :=
      Polynomial.eq_of_monic_of_dvd_of_natDegree_le (minpoly.monic hβi) hgm (minpoly.dvd κ β hgβ)
        (by rw [hgdeg, hmindeg])
    have hlifts : (minpoly κ α).scaleRoots (q S) ∈ Polynomial.lifts q := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      rw [Polynomial.coeff_scaleRoots, hn]
      rcases lt_trichotomy i n with hi | hi | hi
      · obtain ⟨m, hm⟩ : ∃ m, n - i = m + 1 := ⟨n - i - 1, by omega⟩
        refine ⟨r i * (∏ j ∈ (Finset.range n).erase i, s j) * S ^ m, ?_⟩
        have hSi : S = s i * ∏ j ∈ (Finset.range n).erase i, s j := by
          rw [hSdef]; exact (Finset.mul_prod_erase _ _ (Finset.mem_range.mpr hi)).symm
        have e1 : q (r i) = (minpoly κ α).coeff i * q (s i) := (hrs i).symm
        have e2 : q S = q (s i) * q (∏ j ∈ (Finset.range n).erase i, s j) := by
          rw [← map_mul, ← hSi]
        rw [hm, map_mul, map_mul, map_pow, e1, pow_succ, e2]
        ring
      · subst hi
        refine ⟨1, ?_⟩
        rw [Nat.sub_self, pow_zero, mul_one, ← hn, hfm.coeff_natDegree, map_one]
      · refine ⟨0, ?_⟩
        rw [Polynomial.coeff_eq_zero_of_natDegree_lt (hn ▸ hi), zero_mul, map_zero]
    obtain ⟨F, hFmap, -, hFm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlifts hgm
    exact ⟨β, F, hβ, hFm, hFmap.trans hgmin⟩
  have s6 : ∀ (B : Scheme.{u}) (U : B.Opens), IsAffineOpen U → ∀ (b : B) (hb : b ∈ U)
      (c : B.residueField b), ∃ r s : Γ(B, U), (B.presheaf.germ U b hb ≫ B.residue b).hom s ≠ 0 ∧
      c * (B.presheaf.germ U b hb ≫ B.residue b).hom s =
        (B.presheaf.germ U b hb ≫ B.residue b).hom r := by
    intro B U hU b hb c
    let x : U := ⟨b, hb⟩
    letI := TopCat.Presheaf.algebra_section_stalk B.presheaf x
    haveI := hU.isLocalization_stalk x
    have hg : ∀ a : Γ(B, U), (B.presheaf.germ U b hb ≫ B.residue b).hom a =
        (B.residue b).hom (algebraMap Γ(B, U) (B.presheaf.stalk (x : B)) a) := by
      intro a
      rw [TopCat.Presheaf.stalk_open_algebraMap]
      rfl
    obtain ⟨τ, rfl⟩ := B.residue_surjective b c
    obtain ⟨⟨r, s⟩, hτ⟩ := IsLocalization.mk'_surjective (hU.primeIdealOf x).asIdeal.primeCompl τ
    refine ⟨r, s, ?_, ?_⟩
    · rw [hg]
      exact ((IsLocalization.map_units (B.presheaf.stalk (x : B)) s).map (B.residue b).hom).ne_zero
    · rw [hg, hg, ← hτ]
      change (B.residue b).hom _ * (B.residue b).hom _ = (B.residue b).hom _
      rw [← map_mul]
      congr 1
      exact IsLocalization.mk'_spec _ r s
  have s7 : ∀ (A K : Type u) [CommRing A] [Field K] (ψ : A →+* K),
      Subfield.closure (Set.range ψ) = ⊤ →
      ∃ e : (Spec (.of A)).residueField (Spec.map (CommRingCat.ofHom ψ) (IsLocalRing.closedPoint K)) ⟶
          CommRingCat.of K, IsIso e ∧
        Spec.map e ≫ (Spec (.of A)).fromSpecResidueField
          (Spec.map (CommRingCat.ofHom ψ) (IsLocalRing.closedPoint K)) =
            Spec.map (CommRingCat.ofHom ψ) := by
    intro A K _ _ ψ hcl
    have key : ∀ (y : Spec (.of A)) (e : (Spec (.of A)).residueField y ⟶ CommRingCat.of K),
        Spec.map e ≫ (Spec (.of A)).fromSpecResidueField y = Spec.map (CommRingCat.ofHom ψ) →
          IsIso e := by
      intro y e hsym
      have hρ : Spec.map (Spec.preimage ((Spec (.of A)).fromSpecResidueField y) ≫ e) =
          Spec.map (CommRingCat.ofHom ψ) := by
        rw [Spec.map_comp, Spec.map_preimage]
        exact hsym
      have hρ' := Spec.map_injective hρ
      have hψe : ∀ a : A, ψ a =
          e.hom ((Spec.preimage ((Spec (.of A)).fromSpecResidueField y)).hom a) := by
        intro a
        have := congrArg (fun f => f.hom a) hρ'
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply] at this
        exact this.symm
      have hsurj : Function.Surjective e.hom := by
        have hle : Subfield.closure (Set.range ψ) ≤ e.hom.fieldRange := by
          rw [Subfield.closure_le]
          rintro _ ⟨a, rfl⟩
          rw [hψe a]
          exact RingHom.mem_fieldRange.mpr ⟨_, rfl⟩
        rw [hcl] at hle
        intro z
        exact RingHom.mem_fieldRange.mp (hle (Subfield.mem_top z))
      exact (ConcreteCategory.isIso_iff_bijective e).mpr ⟨RingHom.injective e.hom, hsurj⟩
    have hsym := (Scheme.SpecToEquivOfField K (Spec (.of A))).symm_apply_apply
      (Spec.map (CommRingCat.ofHom ψ))
    rw [Scheme.SpecToEquivOfField_symm_apply] at hsym
    exact ⟨(Scheme.SpecToEquivOfField K (Spec (.of A)) (Spec.map (CommRingCat.ofHom ψ))).2,
      key _ _ hsym, hsym⟩
  have s8 : ∀ (B : Scheme.{u}) (b : B) (U : B.Opens), IsAffineOpen U → ∀ (hb : b ∈ U) (K : Type u)
      [Field K] [Algebra (B.residueField b) K] (A : Type u) [CommRing A] [Algebra Γ(B, U) A]
      [Algebra.Etale Γ(B, U) A] (ψ : A →+* K),
      ψ.comp (algebraMap Γ(B, U) A) =
        (algebraMap (B.residueField b) K).comp (B.presheaf.germ U b hb ≫ B.residue b).hom →
      (∀ Q : Ideal A, Q.IsPrime → Q.comap (algebraMap Γ(B, U) A) =
        RingHom.ker (B.presheaf.germ U b hb ≫ B.residue b).hom → Q = RingHom.ker ψ) →
      ∀ (e : (Spec (.of A)).residueField (Spec.map (CommRingCat.ofHom ψ) (IsLocalRing.closedPoint K)) ⟶
        CommRingCat.of K), IsIso e →
      Spec.map e ≫ (Spec (.of A)).fromSpecResidueField
        (Spec.map (CommRingCat.ofHom ψ) (IsLocalRing.closedPoint K)) = Spec.map (CommRingCat.ofHom ψ) →
      ∃ (V' : B.Etale) (v' : V'.left) (e : V'.left.residueField v' ⟶ CommRingCat.of K), IsIso e ∧
        V'.hom v' = b ∧ (∀ w : V'.left, V'.hom w = b → w = v') ∧
        (Spec.map e ≫ V'.left.fromSpecResidueField v') ≫ V'.hom =
          Spec.map (CommRingCat.ofHom (algebraMap (B.residueField b) K)) ≫ B.fromSpecResidueField b := by
    intro B b U hU hb K _ _ A _ _ _ ψ H1 H2 e he H3
    have hpt : ∀ {R : CommRingCat.{u}} (S : Type u) [Field S] (φ : R ⟶ CommRingCat.of S),
        (Spec.map φ (IsLocalRing.closedPoint S)).asIdeal = RingHom.ker φ.hom := by
      intro R S _ φ
      change (PrimeSpectrum.comap φ.hom (IsLocalRing.closedPoint S)).asIdeal = _
      rw [PrimeSpectrum.comap_asIdeal, RingHom.ker_eq_comap_bot, ← IsLocalRing.maximalIdeal_eq_bot]
      rfl
    have ha : Spec.map (B.presheaf.germ U b hb ≫ B.residue b) ≫ hU.fromSpec =
        B.fromSpecResidueField b := by
      rw [Spec.map_comp, Category.assoc]
      have : Spec.map (B.presheaf.germ U b hb) ≫ hU.fromSpec = B.fromSpecStalk b :=
        hU.fromSpecStalk_eq_fromSpecStalk hb
      rw [this]
      rfl
    let ι : Γ(B, U) ⟶ CommRingCat.of A := CommRingCat.ofHom (algebraMap Γ(B, U) A)
    haveI hEt : Etale (Spec.map ι) :=
      HasRingHomProperty.Spec_iff.mpr (RingHom.etale_algebraMap.mpr ‹Algebra.Etale Γ(B, U) A›)
    haveI : IsOpenImmersion hU.fromSpec := hU.isOpenImmersion_fromSpec
    let h : Spec (.of A) ⟶ B := Spec.map ι ≫ hU.fromSpec
    have hring : ι ≫ CommRingCat.ofHom ψ =
        (B.presheaf.germ U b hb ≫ B.residue b) ≫
          CommRingCat.ofHom (algebraMap (B.residueField b) K) := by
      ext a
      exact RingHom.congr_fun H1 a
    have hcomp : Spec.map (CommRingCat.ofHom ψ) ≫ Spec.map ι =
        Spec.map (CommRingCat.ofHom (algebraMap (B.residueField b) K)) ≫
          Spec.map (B.presheaf.germ U b hb ≫ B.residue b) := by
      calc _ = Spec.map (ι ≫ CommRingCat.ofHom ψ) := (Spec.map_comp _ _).symm
        _ = Spec.map ((B.presheaf.germ U b hb ≫ B.residue b) ≫
              CommRingCat.ofHom (algebraMap (B.residueField b) K)) := by rw [hring]
        _ = _ := Spec.map_comp _ _
    have hstar : Spec.map (CommRingCat.ofHom ψ) ≫ h =
        Spec.map (CommRingCat.ofHom (algebraMap (B.residueField b) K)) ≫
          B.fromSpecResidueField b := by
      show Spec.map (CommRingCat.ofHom ψ) ≫ Spec.map ι ≫ hU.fromSpec = _
      rw [← Category.assoc, hcomp, Category.assoc, ha]
    have hv' : h (Spec.map (CommRingCat.ofHom ψ) (IsLocalRing.closedPoint K)) = b :=
      (Scheme.Hom.comp_apply _ _ _).symm.trans
        ((congrArg (fun f : Spec (.of K) ⟶ B => f (IsLocalRing.closedPoint K)) hstar).trans
          ((Scheme.Hom.comp_apply _ _ _).trans (Scheme.fromSpecResidueField_apply _ _)))
    have hinj : Function.Injective hU.fromSpec :=
      (Scheme.Hom.isOpenEmbedding hU.fromSpec).isEmbedding.injective
    have hpb : hU.fromSpec (Spec.map (B.presheaf.germ U b hb ≫ B.residue b)
        (IsLocalRing.closedPoint (B.residueField b))) = b :=
      (Scheme.Hom.comp_apply _ _ _).symm.trans
        ((congrArg (fun f : Spec (B.residueField b) ⟶ B =>
          f (IsLocalRing.closedPoint (B.residueField b))) ha).trans
          (Scheme.fromSpecResidueField_apply _ _))
    refine ⟨Scheme.Etale.mk h, Spec.map (CommRingCat.ofHom ψ) (IsLocalRing.closedPoint K), e, he,
      hv', ?_, ?_⟩
    · intro w hw
      change h w = b at hw
      have h1 : Spec.map ι w = Spec.map (B.presheaf.germ U b hb ≫ B.residue b)
          (IsLocalRing.closedPoint (B.residueField b)) := by
        apply hinj
        rw [hpb, ← hw]
        rfl
      have h2 : Ideal.comap (algebraMap Γ(B, U) A) (w : PrimeSpectrum A).asIdeal =
          RingHom.ker (B.presheaf.germ U b hb ≫ B.residue b).hom := by
        have := congrArg PrimeSpectrum.asIdeal h1
        rw [hpt] at this
        rw [← this]
        rfl
      have h3 := H2 _ (w : PrimeSpectrum A).isPrime h2
      apply PrimeSpectrum.ext
      rw [h3, hpt]
      rfl
    · change (Spec.map e ≫ (Spec (.of A)).fromSpecResidueField
        (Spec.map (CommRingCat.ofHom ψ) (IsLocalRing.closedPoint K))) ≫ h = _
      rw [H3]
      exact hstar

  obtain ⟨U, hU, hb, -⟩ := exists_isAffineOpen_mem_and_subset (x := b) (U := ⊤) trivial
  have hfrac := s6 B U hU b hb
  obtain ⟨β, F, hβ, hFm, hFq⟩ := s2 Γ(B, U) (B.residueField b) _ hfrac K
  obtain ⟨A, iA, aA, x, ψ, hEt, hxF, hψx, hψR, huniq⟩ :=
    s3 Γ(B, U) (B.residueField b) _ K β F hFm hFq
  letI := iA
  letI := aA
  haveI := hEt
  have hQ := s5 Γ(B, U) (B.residueField b) _ K β F A x ψ hβ hFq hxF hψx hψR huniq
    (s1 Γ(B, U) (B.residueField b) _ hfrac)
  have hcl : Subfield.closure (Set.range ψ) = ⊤ := by
    refine s4 Γ(B, U) (B.residueField b) _ hfrac K β hβ _ (fun r => ?_)
      (Subfield.subset_closure ⟨x, hψx⟩)
    have h := RingHom.congr_fun hψR r
    rw [RingHom.comp_apply, RingHom.comp_apply] at h
    rw [← h]
    exact Subfield.subset_closure ⟨_, rfl⟩
  obtain ⟨e, he, heq⟩ := s7 A K ψ hcl
  exact s8 B b U hU hb K A ψ hψR hQ e he heq

theorem wc_esgr_generic_open : ∀ (X : Scheme.{u}) [IsLocallyNoetherian X] (x : X), (∀ y : X, y ⤳ x → y = x) → ∃ E : X.Opens, x ∈ E ∧ ∀ z ∈ E, x ⤳ z :=
by
  classical
  intro X _ x hx
  obtain ⟨W, hW, hxW, -⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := (⊤ : X.Opens)) (x := x) trivial
  haveI := IsLocallyNoetherian.component_noetherian (X := X) ⟨W, hW⟩
  haveI hN : TopologicalSpace.NoetherianSpace ↥(W : Set X) := noetherianSpace_of_isAffineOpen W hW
  haveI hQ : QuasiSober ↥(W : Set X) := W.isOpen.isOpenEmbedding_subtypeVal.quasiSober
  let y : ↥(W : Set X) := ⟨x, hxW⟩
  have hymin : ∀ w : ↥(W : Set X), w ⤳ y → w = y := by
    intro w hw
    exact Subtype.ext (hx _ (hw.map continuous_subtype_val))
  let S : Set (Set ↥(W : Set X)) := {T | T ∈ irreducibleComponents ↥(W : Set X) ∧ y ∉ T}
  have hSfin : S.Finite :=
    (TopologicalSpace.NoetherianSpace.finite_irreducibleComponents (α := ↥(W : Set X))).subset
      (fun T hT => hT.1)
  let K : Set ↥(W : Set X) := ⋃ T ∈ S, T
  have hK : IsClosed K :=
    hSfin.isClosed_biUnion (fun T hT => isClosed_of_mem_irreducibleComponents T hT.1)
  have hyK : y ∉ K := by
    intro h
    simp only [K, Set.mem_iUnion] at h
    obtain ⟨T, hT, hyT⟩ := h
    exact hT.2 hyT
  have hspec : ∀ z : ↥(W : Set X), z ∉ K → y ⤳ z := by
    intro z hz
    have hyZ : y ∈ irreducibleComponent z := by
      by_contra hn
      apply hz
      simp only [K, Set.mem_iUnion]
      exact ⟨irreducibleComponent z, ⟨irreducibleComponent_mem_irreducibleComponents z, hn⟩,
        mem_irreducibleComponent⟩
    obtain ⟨g, hg⟩ := QuasiSober.sober (isIrreducible_irreducibleComponent (x := z))
      isClosed_irreducibleComponent
    have hgy : g = y := hymin g (hg.specializes hyZ)
    rw [← hgy]
    exact hg.specializes mem_irreducibleComponent
  refine ⟨⟨Subtype.val '' Kᶜ, W.isOpen.isOpenMap_subtype_val _ hK.isOpen_compl⟩, ?_, ?_⟩
  · show x ∈ Subtype.val '' Kᶜ
    exact ⟨y, hyK, rfl⟩
  · intro z hz
    have hz' : z ∈ Subtype.val '' Kᶜ := hz
    obtain ⟨w, hw, rfl⟩ := hz'
    exact (hspec w hw).map continuous_subtype_val

theorem wc_esgr_spread_section : ∀ {X Y S : Scheme.{u}} [IsLocallyNoetherian X] (sX : X ⟶ S) (sY : Y ⟶ S) [Etale sY] (x : X) (E : X.Opens), x ∈ E → (∀ z ∈ E, x ⤳ z) → ∀ (σ₀ : Spec (X.residueField x) ⟶ Y), σ₀ ≫ sY = X.fromSpecResidueField x ≫ sX → ∃ (U : X.Opens) (g : (U : Scheme.{u}) ⟶ Y), x ∈ U ∧ g ≫ sY = U.ι ≫ sX ∧ ∀ m : Spec (X.residueField x) ⟶ (U : Scheme.{u}), m ≫ U.ι = X.fromSpecResidueField x → m ≫ g = σ₀ :=
by
  intro X Y S _ sX sY _ x E hxE hE σ₀ hσ₀
  classical
  have hgen : ∀ y : X, y ⤳ x → x ⤳ y := fun y hy => hE y (hy.mem_open E.isOpen hxE)

  have hnil : IsNilpotent (IsLocalRing.maximalIdeal (X.presheaf.stalk x)) := by
    have hprime : ∀ q : PrimeSpectrum (X.presheaf.stalk x),
        q = IsLocalRing.closedPoint (X.presheaf.stalk x) := by
      intro q
      apply (Scheme.Hom.isEmbedding (X.fromSpecStalk x)).injective
      rw [Scheme.fromSpecStalk_closedPoint]
      have h1 : X.fromSpecStalk x q ∈ Set.range (X.fromSpecStalk x) := ⟨q, rfl⟩
      rw [Scheme.range_fromSpecStalk] at h1
      exact (Specializes.antisymm h1 (hgen _ h1)).eq
    have hle : IsLocalRing.maximalIdeal (X.presheaf.stalk x) ≤ nilradical (X.presheaf.stalk x) := by
      rw [nilradical_eq_sInf]
      refine le_sInf fun J hJ => ?_
      have h2 : J = IsLocalRing.maximalIdeal (X.presheaf.stalk x) :=
        congrArg PrimeSpectrum.asIdeal (hprime ⟨J, hJ⟩)
      rw [h2]
    obtain ⟨n, hn⟩ := IsNoetherianRing.isNilpotent_nilradical (X.presheaf.stalk x)
    refine ⟨n, ?_⟩
    have h3 := Ideal.pow_right_mono hle n
    rw [hn] at h3
    exact le_bot_iff.mp h3
  have hfac : ∀ {Z : Scheme.{u}} {R : CommRingCat.{u}} [IsLocalRing R] (g : Spec R ⟶ Z)
      (V : Z.Opens) (hV : IsAffineOpen V), g (IsLocalRing.closedPoint R) ∈ V →
      ∃ c : Γ(Z, V) ⟶ R, Spec.map c ≫ hV.fromSpec = g := by
    intro Z R _ g V hV hg
    have hr : Set.range g ⊆ Set.range hV.fromSpec := by
      rw [hV.range_fromSpec]
      rintro _ ⟨q, rfl⟩
      have hs : q ⤳ IsLocalRing.closedPoint R :=
        (PrimeSpectrum.le_iff_specializes _ _).mp (IsLocalRing.le_maximalIdeal q.isPrime.ne_top)
      exact (hs.map g.continuous).mem_open V.isOpen hg
    haveI := hV.isOpenImmersion_fromSpec
    exact ⟨Spec.preimage (IsOpenImmersion.lift hV.fromSpec g hr),
      by rw [Spec.map_preimage, IsOpenImmersion.lift_fac]⟩
  have hlift : ∀ {P : Scheme.{u}} (π : P ⟶ X) [Etale π] (σ : Spec (X.residueField x) ⟶ P),
      σ ≫ π = X.fromSpecResidueField x →
      ∃ φ : Spec (X.presheaf.stalk x) ⟶ P, φ ≫ π = X.fromSpecStalk x ∧
        Spec.map (X.residue x) ≫ φ = σ := by
    intro P π _ σ hσ
    obtain ⟨V, hV, hεV, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens X)) (show x ∈ (⊤ : X.Opens) from trivial)
    have hV' : IsAffineOpen V := hV
    have hp0' : ∀ y : Spec (X.residueField x), π (σ y) = x := by
      intro y
      rw [← Scheme.Hom.comp_apply, hσ, Scheme.fromSpecResidueField_apply]
    have hp0 : π (σ (IsLocalRing.closedPoint (X.residueField x))) = x := hp0' _
    obtain ⟨W, hW, hpW, hWV⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens P))
      (show σ (IsLocalRing.closedPoint (X.residueField x)) ∈ π ⁻¹ᵁ V by
        rw [Scheme.Hom.mem_preimage, hp0]; exact hεV)
    have hW' : IsAffineOpen W := hW
    obtain ⟨ψ, hψ⟩ := hfac σ W hW' hpW
    have hρ : RingHom.Etale (π.appLE V W hWV).hom :=
      HasRingHomProperty.appLE @Etale π ‹_› ⟨V, hV⟩ ⟨W, hW⟩ hWV
    have hdag := IsAffineOpen.SpecMap_appLE_fromSpec π hV' hW' hWV
    have hsec : Spec.map (X.presheaf.germ V x hεV) ≫ hV'.fromSpec = X.fromSpecStalk x := by
      rw [← hV'.fromSpecStalk_eq_fromSpecStalk hεV]
      rfl
    haveI := hV'.isOpenImmersion_fromSpec
    have hcomp : π.appLE V W hWV ≫ ψ = X.presheaf.germ V x hεV ≫ X.residue x := by
      apply Spec.map_injective
      rw [← cancel_mono hV'.fromSpec]
      rw [Spec.map_comp, Category.assoc, hdag, ← Category.assoc, hψ, hσ, Spec.map_comp,
        Category.assoc, hsec, Scheme.fromSpecResidueField.eq_1]
    letI : Algebra Γ(X, V) Γ(P, W) := (π.appLE V W hWV).hom.toAlgebra
    letI : Algebra Γ(X, V) (X.presheaf.stalk x) := (X.presheaf.germ V x hεV).hom.toAlgebra
    haveI : Algebra.Etale Γ(X, V) Γ(P, W) := RingHom.Etale.toAlgebra hρ
    let ψ' : Γ(P, W) →ₐ[Γ(X, V)]
        (X.presheaf.stalk x) ⧸ IsLocalRing.maximalIdeal (X.presheaf.stalk x) :=
      { toRingHom := ψ.hom
        commutes' := fun a => by
          have h := congrArg (fun f => CommRingCat.Hom.hom f a) hcomp
          exact h }
    obtain ⟨f, hf⟩ := Algebra.FormallySmooth.exists_lift _ hnil ψ'
    obtain ⟨F, hF⟩ : ∃ F : Γ(P, W) ⟶ X.presheaf.stalk x, F.hom = f.toRingHom :=
      ⟨CommRingCat.ofHom f.toRingHom, rfl⟩
    have hF1 : π.appLE V W hWV ≫ F = X.presheaf.germ V x hεV := by
      ext a
      show F.hom ((π.appLE V W hWV).hom a) = (X.presheaf.germ V x hεV).hom a
      rw [hF]
      exact f.commutes a
    have hF2 : F ≫ X.residue x = ψ := by
      ext b
      show (X.residue x).hom (F.hom b) = ψ.hom b
      rw [hF]
      exact DFunLike.congr_fun hf b
    refine ⟨Spec.map F ≫ hW'.fromSpec, ?_, ?_⟩
    · rw [Category.assoc, ← hdag, ← Category.assoc, ← Spec.map_comp, hF1, hsec]
    · rw [← Category.assoc, ← Spec.map_comp, hF2, hψ]

  obtain ⟨φ, hφ1, hφ2⟩ := hlift (Limits.pullback.fst sX sY)
    (Limits.pullback.lift (X.fromSpecResidueField x) σ₀ hσ₀.symm) (Limits.pullback.lift_fst _ _ _)
  have hφq : (φ ≫ Limits.pullback.snd sX sY) ≫ sY = X.fromSpecStalk x ≫ sX := by
    rw [Category.assoc, ← Limits.pullback.condition, ← Category.assoc, hφ1]

  obtain ⟨U, hxU, f, hf1, hf2⟩ :=
    spread_out_of_isGermInjective' sX sY (φ ≫ Limits.pullback.snd sX sY) hφq
  refine ⟨U, f, hxU, hf2, ?_⟩
  intro m hm
  have hm0 : m = Spec.map (X.residue x) ≫ U.fromSpecStalkOfMem x hxU := by
    rw [← cancel_mono U.ι, hm, Category.assoc, Scheme.Opens.fromSpecStalkOfMem_ι,
      Scheme.fromSpecResidueField.eq_1]
  rw [hm0, Category.assoc, ← hf1, ← Category.assoc, hφ2, Limits.pullback.lift_snd]

theorem wc_esgr_finite_shrink : ∀ {X Y : Scheme.{u}} [IsLocallyNoetherian Y] (g : X ⟶ Y) [Etale g] (x : X), (∀ y : Y, y ⤳ g x → y = g x) → ∀ (E : X.Opens), x ∈ E → (∀ z ∈ E, x ⤳ z) → ∃ (W : X.Opens) (O : Y.Opens) (e : W ≤ g ⁻¹ᵁ O), x ∈ W ∧ (∀ w ∈ W, g w = g x → w = x) ∧ IsFinite (g.resLE O W e) ∧ AlgebraicGeometry.Surjective (g.resLE O W e) :=
by
  intro X Y _ g _ x hgen E hxE hE
  classical

  have hmemι : ∀ {S : Scheme.{u}} (U : S.Opens) (s : (U : Scheme.{u})), U.ι s ∈ U := by
    intro S U s
    have h := Set.mem_range_self (f := U.ι) s
    rw [Scheme.Opens.range_ι] at h
    exact h
  have hex : ∀ {S : Scheme.{u}} (U : S.Opens) (s : S), s ∈ U → ∃ t : (U : Scheme.{u}), U.ι t = s := by
    intro S U s hs
    have h : s ∈ (U : Set S) := hs
    rw [← Scheme.Opens.range_ι] at h
    exact h

  have hI : ∀ z : X, x ⤳ z → g z = g x → z = x := by
    intro z hz hgz
    obtain ⟨U, hzU, hU⟩ := wc_etale_fibre_point_isolated g z
    exact (hU x (hz.mem_open U.isOpen hzU) hgz.symm).symm

  have hP : ∀ {U : Y.Opens} {V : X.Opens} (e : V ≤ g ⁻¹ᵁ U) (v : (V : Scheme.{u})),
      U.ι (g.resLE U V e v) = g (V.ι v) := by
    intro U V e v
    rw [← Scheme.Hom.comp_apply, Scheme.Hom.resLE_comp_ι, Scheme.Hom.comp_apply]

  have hR : ∀ {S : Scheme.{u}} {U V : S.Opens} (h : U ≤ V) (v : (V : Scheme.{u})),
      v ∈ Set.range (S.homOfLE h) ↔ V.ι v ∈ U := by
    intro S U V h v
    constructor
    · rintro ⟨w, rfl⟩
      rw [← Scheme.Hom.comp_apply, Scheme.homOfLE_ι]
      exact hmemι U w
    · intro hv
      obtain ⟨w, hw⟩ := hex U _ hv
      refine ⟨w, (Scheme.Hom.isOpenEmbedding V.ι).injective ?_⟩
      rw [← Scheme.Hom.comp_apply, Scheme.homOfLE_ι]
      exact hw

  obtain ⟨OY, W₀, e₀, hxW₀, -, -, hfin₀⟩ := wc_r2gs_etale_finite_near_generic Y X g x hgen

  have hTc : IsClosed (closure {x} ∩ (E : Set X)ᶜ) :=
    isClosed_closure.inter E.isOpen.isClosed_compl
  have hyOY : g x ∈ OY := e₀ hxW₀
  have hTW : ∀ w ∈ W₀, w ∈ closure {x} ∩ (E : Set X)ᶜ → g w ≠ g x := by
    intro w _ hwT hgw
    have hxw : x ⤳ w := specializes_iff_mem_closure.mpr hwT.1
    have hwx := hI w hxw hgw
    exact hwT.2 (by rw [hwx]; exact hxE)

  have hcm : IsClosedMap (g.resLE OY W₀ e₀) := Scheme.Hom.isClosedMap _
  have hCc : IsClosed ((g.resLE OY W₀ e₀) '' (W₀.ι ⁻¹' (closure {x} ∩ (E : Set X)ᶜ))) :=
    hcm _ (hTc.preimage W₀.ι.continuous)
  have hO₁open : IsOpen (OY.ι '' ((g.resLE OY W₀ e₀) '' (W₀.ι ⁻¹' (closure {x} ∩ (E : Set X)ᶜ)))ᶜ) :=
    (Scheme.Hom.isOpenEmbedding OY.ι).isOpenMap _ hCc.isOpen_compl
  let O₁ : Y.Opens := ⟨_, hO₁open⟩
  have hO₁ : O₁ ≤ OY := by
    intro y hy
    obtain ⟨c, -, rfl⟩ := hy
    exact hmemι OY c
  have hyO₁ : g x ∈ O₁ := by
    obtain ⟨c, hc⟩ := hex OY _ hyOY
    refine ⟨c, ?_, hc⟩
    rintro ⟨u, hu, hfu⟩
    rw [Set.mem_preimage] at hu
    apply hTW (W₀.ι u) (hmemι W₀ u) hu
    rw [← hP e₀ u, hfu, hc]
  have hbad : ∀ w ∈ W₀, g w ∈ O₁ → w ∉ closure {x} ∩ (E : Set X)ᶜ := by
    intro w hw hgw hwT
    obtain ⟨c, hc, hcw⟩ := hgw
    obtain ⟨u, hu⟩ := hex W₀ w hw
    apply hc
    have hc' : c = g.resLE OY W₀ e₀ u := by
      apply (Scheme.Hom.isOpenEmbedding OY.ι).injective
      rw [hcw, hP e₀ u, hu]
    rw [hc']
    refine ⟨u, ?_, rfl⟩
    rw [Set.mem_preimage, hu]
    exact hwT

  have hxW : x ∈ W₀ ⊓ g ⁻¹ᵁ O₁ ⊓ E := ⟨⟨hxW₀, hyO₁⟩, hxE⟩
  have hOopen : IsOpen (g '' ((W₀ ⊓ g ⁻¹ᵁ O₁ ⊓ E : X.Opens) : Set X)) :=
    g.isOpenMap _ (W₀ ⊓ g ⁻¹ᵁ O₁ ⊓ E).isOpen
  have e : W₀ ⊓ g ⁻¹ᵁ O₁ ⊓ E ≤ g ⁻¹ᵁ (⟨_, hOopen⟩ : Y.Opens) := fun w hw => ⟨w, hw, rfl⟩
  have hOO₁ : (⟨_, hOopen⟩ : Y.Opens) ≤ O₁ := by
    intro y hy
    obtain ⟨w, hw, rfl⟩ := hy
    exact hw.1.2

  have hd₀ : W₀ ⊓ g ⁻¹ᵁ O₁ ≤ W₀ := inf_le_left
  have hd₁ : W₀ ⊓ g ⁻¹ᵁ O₁ ≤ g ⁻¹ᵁ O₁ := inf_le_right
  have hcomm : X.homOfLE hd₀ ≫ g.resLE OY W₀ e₀ = g.resLE O₁ _ hd₁ ≫ Y.homOfLE hO₁ := by
    rw [Scheme.Hom.map_resLE, Scheme.Hom.resLE_map]
  have hpre : (g.resLE OY W₀ e₀) ⁻¹ᵁ (Y.homOfLE hO₁).opensRange = (X.homOfLE hd₀).opensRange := by
    ext u
    show g.resLE OY W₀ e₀ u ∈ ((Y.homOfLE hO₁).opensRange : Set (OY : Scheme.{u})) ↔
      u ∈ ((X.homOfLE hd₀).opensRange : Set (W₀ : Scheme.{u}))
    rw [Scheme.Hom.coe_opensRange, Scheme.Hom.coe_opensRange, hR, hR, hP e₀ u]
    exact ⟨fun h => ⟨hmemι W₀ u, h⟩, fun h => h.2⟩
  have hpb : IsPullback (g.resLE O₁ _ hd₁) (X.homOfLE hd₀) (Y.homOfLE hO₁) (g.resLE OY W₀ e₀) :=
    IsOpenImmersion.isPullback _ _ _ _ hcomm hpre
  haveI hfd : IsFinite (g.resLE O₁ _ hd₁) :=
    MorphismProperty.of_isPullback (P := @IsFinite) hpb.flip hfin₀

  have hWd : W₀ ⊓ g ⁻¹ᵁ O₁ ⊓ E ≤ W₀ ⊓ g ⁻¹ᵁ O₁ := inf_le_left
  have hrange : Set.range (X.homOfLE hWd) = (W₀ ⊓ g ⁻¹ᵁ O₁).ι ⁻¹' closure {x} := by
    ext u
    rw [hR, Set.mem_preimage]
    have hu : (W₀ ⊓ g ⁻¹ᵁ O₁).ι u ∈ W₀ ⊓ g ⁻¹ᵁ O₁ := hmemι _ u
    constructor
    · intro h
      exact specializes_iff_mem_closure.mp (hE _ h.2)
    · intro h
      by_cases hEu : (W₀ ⊓ g ⁻¹ᵁ O₁).ι u ∈ E
      · exact ⟨hu, hEu⟩
      · exact absurd ⟨h, hEu⟩ (hbad _ hu.1 hu.2)
  have hjcl : IsClosed (Set.range (X.homOfLE hWd)) := by
    rw [hrange]
    exact isClosed_closure.preimage (W₀ ⊓ g ⁻¹ᵁ O₁).ι.continuous
  haveI : IsClosedImmersion (X.homOfLE hWd) := IsClosedImmersion.of_isPreimmersion _ hjcl

  have hcomp : X.homOfLE hWd ≫ g.resLE O₁ _ hd₁ =
      g.resLE (⟨_, hOopen⟩ : Y.Opens) _ e ≫ Y.homOfLE hOO₁ := by
    rw [Scheme.Hom.map_resLE, Scheme.Hom.resLE_map]
  haveI : IsFinite (g.resLE (⟨_, hOopen⟩ : Y.Opens) _ e ≫ Y.homOfLE hOO₁) := by
    rw [← hcomp]
    infer_instance
  haveI hfin : IsFinite (g.resLE (⟨_, hOopen⟩ : Y.Opens) _ e) :=
    IsFinite.of_comp _ (Y.homOfLE hOO₁)

  have hsurj : AlgebraicGeometry.Surjective (g.resLE (⟨_, hOopen⟩ : Y.Opens) _ e) := by
    refine AlgebraicGeometry.Surjective.mk (fun o => ?_)
    obtain ⟨w, hw, hwo⟩ := hmemι (⟨_, hOopen⟩ : Y.Opens) o
    obtain ⟨t, ht⟩ := hex _ w hw
    let O : Y.Opens := ⟨_, hOopen⟩
    refine ⟨t, (Scheme.Hom.isOpenEmbedding (Scheme.Opens.ι O)).injective ?_⟩
    rw [hP e t, ht, hwo]

  have huniq : ∀ w ∈ W₀ ⊓ g ⁻¹ᵁ O₁ ⊓ E, g w = g x → w = x :=
    fun w hw hgw => hI w (hE w hw.2) hgw
  exact ⟨W₀ ⊓ g ⁻¹ᵁ O₁ ⊓ E, ⟨_, hOopen⟩, e, hxW, huniq, hfin, hsurj⟩

theorem wc_esgr_residue_bookkeeping : ∀ {X Y : Scheme.{u}} (x : X) (U : X.Opens) (hx : x ∈ U) (g : (U : Scheme.{u}) ⟶ Y) (y : Y) (K : Type u) [Field K] (e : Y.residueField y ⟶ CommRingCat.of K) (i : CommRingCat.of K ⟶ X.residueField x), IsIso e → (∀ m : Spec (X.residueField x) ⟶ (U : Scheme.{u}), m ≫ U.ι = X.fromSpecResidueField x → m ≫ g = Spec.map i ≫ Spec.map e ≫ Y.fromSpecResidueField y) → g ⟨x, hx⟩ = y ∧ (∀ (Ω : Type u) [Field Ω] (φ φ' : X.residueField x ⟶ CommRingCat.of Ω) (l l' : Spec (.of Ω) ⟶ (U : Scheme.{u})), l ≫ U.ι = Spec.map φ ≫ X.fromSpecResidueField x → l' ≫ U.ι = Spec.map φ' ≫ X.fromSpecResidueField x → (l ≫ g = l' ≫ g ↔ ∀ a : K, φ.hom (i.hom a) = φ'.hom (i.hom a))) ∧ ((∀ a : X.residueField x, ∃ p : Polynomial K, p ≠ 0 ∧ p.eval₂ i.hom a = 0) → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (w : Spec (.of Ω) ⟶ Y), w (IsLocalRing.closedPoint Ω) = y → ∃ (φ : X.residueField x ⟶ CommRingCat.of Ω) (l : Spec (.of Ω) ⟶ (U : Scheme.{u})), l ≫ U.ι = Spec.map φ ≫ X.fromSpecResidueField x ∧ l ≫ g = w) :=
by
  intro X Y x U hx g y K _ e i he H
  classical
  have hr : Set.range (X.fromSpecResidueField x) ⊆ Set.range U.ι := by
    rw [Scheme.range_fromSpecResidueField, Scheme.Opens.range_ι]
    exact Set.singleton_subset_iff.mpr hx
  obtain ⟨m₀, hm₀⟩ : ∃ m₀ : Spec (X.residueField x) ⟶ (U : Scheme.{u}),
      m₀ ≫ U.ι = X.fromSpecResidueField x :=
    ⟨IsOpenImmersion.lift U.ι _ hr, IsOpenImmersion.lift_fac _ _ _⟩
  have hσ := H m₀ hm₀
  have hnf : ∀ (Ω : Type u) [Field Ω] (φ : X.residueField x ⟶ CommRingCat.of Ω)
      (l : Spec (.of Ω) ⟶ (U : Scheme.{u})), l ≫ U.ι = Spec.map φ ≫ X.fromSpecResidueField x →
      l ≫ g = Spec.map (e ≫ i ≫ φ) ≫ Y.fromSpecResidueField y := by
    intro Ω _ φ l hl
    have hl' : l = Spec.map φ ≫ m₀ := by
      apply (cancel_mono U.ι).mp
      rw [hl, Category.assoc, hm₀]
    rw [hl', Category.assoc, hσ, Spec.map_comp, Spec.map_comp]
    simp only [Category.assoc]
  have hinj : ∀ (Ω : Type u) [Field Ω] (ψ ψ' : Y.residueField y ⟶ CommRingCat.of Ω),
      Spec.map ψ ≫ Y.fromSpecResidueField y = Spec.map ψ' ≫ Y.fromSpecResidueField y → ψ = ψ' := by
    intro Ω _ ψ ψ' h
    have h2 : (Scheme.SpecToEquivOfField Ω Y).symm ⟨y, ψ⟩ =
        (Scheme.SpecToEquivOfField Ω Y).symm ⟨y, ψ'⟩ := by
      rw [Scheme.SpecToEquivOfField_symm_apply, Scheme.SpecToEquivOfField_symm_apply]
      exact h
    have h3 := (Scheme.SpecToEquivOfField Ω Y).symm.injective h2
    exact eq_of_heq (Sigma.mk.inj_iff.mp h3).2
  refine ⟨?_, ?_, ?_⟩
  · obtain ⟨p⟩ : Nonempty (Spec (X.residueField x)) :=
      ⟨IsLocalRing.closedPoint (X.residueField x)⟩
    have h1 : U.ι (m₀ p) = x := by
      rw [← Scheme.Hom.comp_apply, hm₀, Scheme.fromSpecResidueField_apply]
    have hp : m₀ p = ⟨x, hx⟩ :=
      Subtype.ext ((Scheme.Opens.ι_apply U _).symm.trans h1)
    rw [← hp, ← Scheme.Hom.comp_apply, hσ]
    simp only [Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]
  · intro Ω _ φ φ' l l' hl hl'
    rw [hnf Ω φ l hl, hnf Ω φ' l' hl']
    constructor
    · intro h a
      have h1 := hinj Ω _ _ h
      have h2 : i ≫ φ = i ≫ φ' := (cancel_epi e).mp h1
      have h3 := congrArg (fun f => f.hom a) h2
      simpa using h3
    · intro h
      have h2 : i ≫ φ = i ≫ φ' := by
        ext a
        simpa using h a
      rw [h2]
  · intro halg Ω _ _ w hw
    subst hw
    obtain ⟨ψ, hψ⟩ : ∃ ψ : Y.residueField (w (IsLocalRing.closedPoint Ω)) ⟶ CommRingCat.of Ω,
        Spec.map ψ ≫ Y.fromSpecResidueField (w (IsLocalRing.closedPoint Ω)) = w :=
      ⟨_, Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField Ω Y w⟩
    let χ : CommRingCat.of K ⟶ CommRingCat.of Ω := inv e ≫ ψ
    letI : Algebra K (X.residueField x) := i.hom.toAlgebra
    letI : Algebra K Ω := χ.hom.toAlgebra
    haveI : Algebra.IsAlgebraic K (X.residueField x) := by
      constructor
      intro a
      obtain ⟨p, hp0, hp⟩ := halg a
      exact ⟨p, hp0, by rw [Polynomial.aeval_def]; exact hp⟩
    let f : X.residueField x →ₐ[K] Ω := IsAlgClosed.lift
    let φ : X.residueField x ⟶ CommRingCat.of Ω := CommRingCat.ofHom f.toRingHom
    have hiφ : i ≫ φ = χ := by
      ext a
      exact f.commutes a
    have hl : (Spec.map φ ≫ m₀) ≫ U.ι = Spec.map φ ≫ X.fromSpecResidueField x := by
      rw [Category.assoc, hm₀]
    refine ⟨φ, Spec.map φ ≫ m₀, hl, ?_⟩
    rw [hnf Ω φ _ hl, hiφ]
    simp only [χ, IsIso.hom_inv_id_assoc]
    exact hψ

theorem wc_esg_realise_subfield : ∀ (B : Scheme.{u}) [IsLocallyNoetherian B] (V₀ : B.Etale) (v₀ : V₀.left), (∀ y : B, y ⤳ V₀.hom v₀ → y = V₀.hom v₀) → ∀ (L' : Subfield (V₀.left.residueField v₀)), Set.range (V₀.hom.residueFieldMap v₀).hom ⊆ (L' : Set (V₀.left.residueField v₀)) → ∃ (V₁ : B.Etale) (ι : V₁ ⟶ V₀) (v₁ : V₁.left) (V' : B.Etale) (π : V₁ ⟶ V') (v' : V'.left), IsOpenImmersion ι.left ∧ ι.left v₁ = v₀ ∧ (∀ w : V₁.left, V₁.hom w = V₀.hom v₀ → w = v₁) ∧ IsFinite π.left ∧ AlgebraicGeometry.Surjective π.left ∧ π.left v₁ = v' ∧ (∀ w : V'.left, V'.hom w = V₀.hom v₀ → w = v') ∧ (∀ (Ω : Type u) [Field Ω] (φ φ' : V₀.left.residueField v₀ ⟶ CommRingCat.of Ω) (l l' : Spec (.of Ω) ⟶ V₁.left), l ≫ ι.left = Spec.map φ ≫ V₀.left.fromSpecResidueField v₀ → l' ≫ ι.left = Spec.map φ' ≫ V₀.left.fromSpecResidueField v₀ → (l ≫ π.left = l' ≫ π.left ↔ ∀ a ∈ L', φ.hom a = φ'.hom a)) ∧ ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (w : Spec (.of Ω) ⟶ V'.left), w (IsLocalRing.closedPoint Ω) = v' → ∃ (φ : V₀.left.residueField v₀ ⟶ CommRingCat.of Ω) (l : Spec (.of Ω) ⟶ V₁.left), l ≫ ι.left = Spec.map φ ≫ V₀.left.fromSpecResidueField v₀ ∧ l ≫ π.left = w :=
by

  have hs1 : ∀ (Y B' : Scheme.{u}) (h : Y ⟶ B') [Etale h] (y : Y),
      letI := (h.residueFieldMap y).hom.toAlgebra;
      FiniteDimensional (B'.residueField (h y)) (Y.residueField y) ∧
        Algebra.IsSeparable (B'.residueField (h y)) (Y.residueField y) := by
    intro Y B' h _ y
    letI A : Algebra (B'.presheaf.stalk (h y)) (Y.presheaf.stalk y) := (h.stalkMap y).hom.toAlgebra
    haveI : IsLocalHom (algebraMap (B'.presheaf.stalk (h y)) (Y.presheaf.stalk y)) :=
      inferInstanceAs (IsLocalHom (h.stalkMap y).hom)
    haveI : Algebra.FormallyUnramified (B'.presheaf.stalk (h y)) (Y.presheaf.stalk y) :=
      AlgebraicGeometry.FormallyUnramified.stalkMap h y
    haveI : Algebra.EssFiniteType (B'.presheaf.stalk (h y)) (Y.presheaf.stalk y) :=
      AlgebraicGeometry.LocallyOfFiniteType.stalkMap h y
    have h1 : Module.Finite (IsLocalRing.ResidueField (B'.presheaf.stalk (h y)))
        (IsLocalRing.ResidueField (Y.presheaf.stalk y)) :=
      Algebra.instFiniteResidueFieldOfFormallyUnramified
    have h2 : Algebra.IsSeparable (IsLocalRing.ResidueField (B'.presheaf.stalk (h y)))
        (IsLocalRing.ResidueField (Y.presheaf.stalk y)) :=
      Algebra.instIsSeparableResidueFieldOfFormallyUnramified
    have heq : (h.residueFieldMap y).hom.toAlgebra =
        (IsLocalRing.ResidueField.instAlgebra : Algebra
          (IsLocalRing.ResidueField (B'.presheaf.stalk (h y)))
          (IsLocalRing.ResidueField (Y.presheaf.stalk y))) :=
      Algebra.algebra_ext _ _ (fun r => rfl)
    show @FiniteDimensional _ _ _ _ (h.residueFieldMap y).hom.toAlgebra.toModule ∧
      @Algebra.IsSeparable _ _ _ _ (h.residueFieldMap y).hom.toAlgebra
    rw [heq]
    exact ⟨h1, h2⟩
  intro B _ V₀ v₀ hgen L' hL'
  classical
  haveI hV₀et : Etale V₀.hom := V₀.prop
  haveI : IsLocallyNoetherian V₀.left :=
    @LocallyOfFiniteType.isLocallyNoetherian V₀.left B V₀.hom inferInstance inferInstance
  letI : Algebra (B.residueField (V₀.hom v₀)) (V₀.left.residueField v₀) :=
    (V₀.hom.residueFieldMap v₀).hom.toAlgebra
  obtain ⟨hfin, hsep⟩ := hs1 V₀.left B V₀.hom v₀
  haveI := hfin
  haveI := hsep
  have hK : ∀ c : B.residueField (V₀.hom v₀),
      algebraMap (B.residueField (V₀.hom v₀)) (V₀.left.residueField v₀) c ∈ L' :=
    fun c => hL' ⟨c, rfl⟩
  obtain ⟨K, hKdef⟩ : ∃ K : IntermediateField (B.residueField (V₀.hom v₀))
      (V₀.left.residueField v₀), K = L'.toIntermediateField hK := ⟨_, rfl⟩
  have hmemK : ∀ a : V₀.left.residueField v₀, a ∈ K ↔ a ∈ L' := by
    intro a; rw [hKdef]; exact Iff.rfl
  let i : CommRingCat.of K ⟶ V₀.left.residueField v₀ := CommRingCat.ofHom K.val.toRingHom
  have hi : ∀ a : K, i.hom a = (a : V₀.left.residueField v₀) := fun _ => rfl
  have hik : CommRingCat.ofHom (algebraMap (B.residueField (V₀.hom v₀)) K) ≫ i =
      V₀.hom.residueFieldMap v₀ := by
    ext c
    exact K.val.commutes c

  obtain ⟨V', v', e, he, hv'b, huniq', hsq⟩ := wc_esgr_etale_model B (V₀.hom v₀) K
  haveI hV'et : Etale V'.hom := V'.prop
  haveI : IsLocallyNoetherian V'.left :=
    @LocallyOfFiniteType.isLocallyNoetherian V'.left B V'.hom inferInstance inferInstance

  have hgenX : ∀ y : V₀.left, y ⤳ v₀ → y = v₀ := by
    intro y hy
    have h1 : V₀.hom y = V₀.hom v₀ := hgen _ (hy.map V₀.hom.continuous)
    obtain ⟨U, hvU, hU⟩ := wc_etale_fibre_point_isolated V₀.hom v₀
    exact hU y (hy.mem_open U.isOpen hvU) h1

  obtain ⟨E, hv₀E, hE⟩ := wc_esgr_generic_open V₀.left v₀ hgenX

  have hσ₀ : (Spec.map i ≫ Spec.map e ≫ V'.left.fromSpecResidueField v') ≫ V'.hom =
      V₀.left.fromSpecResidueField v₀ ≫ V₀.hom := by
    calc (Spec.map i ≫ Spec.map e ≫ V'.left.fromSpecResidueField v') ≫ V'.hom
        = Spec.map i ≫ ((Spec.map e ≫ V'.left.fromSpecResidueField v') ≫ V'.hom) := by
          simp only [Category.assoc]
      _ = Spec.map i ≫ (Spec.map (CommRingCat.ofHom (algebraMap (B.residueField (V₀.hom v₀)) K)) ≫
          B.fromSpecResidueField (V₀.hom v₀)) := by rw [hsq]
      _ = Spec.map (CommRingCat.ofHom (algebraMap (B.residueField (V₀.hom v₀)) K) ≫ i) ≫
          B.fromSpecResidueField (V₀.hom v₀) := by rw [Spec.map_comp, Category.assoc]
      _ = V₀.left.fromSpecResidueField v₀ ≫ V₀.hom := by
          rw [hik, Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField]
          rfl

  obtain ⟨U, g, hxU, hg, hpt⟩ := wc_esgr_spread_section (X := V₀.left) (Y := V'.left) (S := B)
    V₀.hom V'.hom v₀ E hv₀E hE
    (Spec.map i ≫ Spec.map e ≫ V'.left.fromSpecResidueField v') hσ₀

  obtain ⟨hgx, hiff, hext⟩ := wc_esgr_residue_bookkeeping v₀ U hxU g v' K e i he hpt

  haveI : Etale (g ≫ V'.hom) := by rw [hg]; infer_instance
  haveI : Etale g := Etale.of_comp g V'.hom
  have hgen' : ∀ y : V'.left, y ⤳ g ⟨v₀, hxU⟩ → y = g ⟨v₀, hxU⟩ := by
    rw [hgx]
    intro y hy
    have h1 : V'.hom y = V₀.hom v₀ := by
      rw [← hv'b]
      have h2 := hy.map V'.hom.continuous
      rw [hv'b] at h2 ⊢
      exact hgen _ h2
    exact huniq' y h1
  have hxE : (⟨v₀, hxU⟩ : (U : Scheme.{u})) ∈ U.ι ⁻¹ᵁ E := hv₀E
  have hE' : ∀ z ∈ U.ι ⁻¹ᵁ E, (⟨v₀, hxU⟩ : (U : Scheme.{u})) ⤳ z := by
    intro z hz
    exact (Scheme.Hom.isOpenEmbedding U.ι).isInducing.specializes_iff.mp (hE _ hz)
  obtain ⟨W, O, eWO, hxW, huniqW, hfinW, hsurjW⟩ :=
    wc_esgr_finite_shrink g ⟨v₀, hxU⟩ hgen' (U.ι ⁻¹ᵁ E) hxE hE'
  have hv'O : v' ∈ O := by
    have h := eWO hxW
    rw [← hgx]
    exact h

  let V₁ : B.Etale := MorphismProperty.Over.mk ⊤ ((W.ι ≫ U.ι) ≫ V₀.hom) (by infer_instance)
  let ι : V₁ ⟶ V₀ := MorphismProperty.Over.homMk (W.ι ≫ U.ι) rfl trivial
  let V'' : B.Etale := MorphismProperty.Over.mk ⊤ (O.ι ≫ V'.hom) (by infer_instance)
  have hπw : g.resLE O W eWO ≫ (O.ι ≫ V'.hom) = (W.ι ≫ U.ι) ≫ V₀.hom := by
    rw [← Category.assoc, Scheme.Hom.resLE_comp_ι, Category.assoc, hg, Category.assoc]
  let π : V₁ ⟶ V'' := MorphismProperty.Over.homMk (g.resLE O W eWO) hπw trivial
  have hιl : ι.left = W.ι ≫ U.ι := rfl
  have hπl : π.left = g.resLE O W eWO := rfl
  haveI hWo : IsOpenImmersion W.ι := Scheme.Opens.instIsOpenImmersionι W
  haveI hOo : IsOpenImmersion O.ι := Scheme.Opens.instIsOpenImmersionι O
  have eπ : ∀ {T : Scheme.{u}} (m : T ⟶ (W : Scheme.{u})),
      (m ≫ g.resLE O W eWO) ≫ O.ι = (m ≫ W.ι) ≫ g := fun m =>
    (Category.assoc _ _ _).trans ((congrArg (m ≫ ·) (Scheme.Hom.resLE_comp_ι g eWO)).trans
      (Category.assoc _ _ _).symm)
  refine ⟨V₁, ι, (⟨⟨v₀, hxU⟩, hxW⟩ : (W : Scheme.{u})), V'', π, (⟨v', hv'O⟩ : (O : Scheme.{u})),
    ?_, rfl, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact (inferInstance : IsOpenImmersion (W.ι ≫ U.ι))
  · intro w hw
    have h1 : V'.hom (g (W.ι w)) = V₀.hom v₀ := by
      rw [← Scheme.Hom.comp_apply, hg]
      exact hw
    exact Subtype.ext (huniqW (W.ι w) w.2 ((huniq' _ h1).trans hgx.symm))
  · rw [hπl]; exact hfinW
  · rw [hπl]; exact hsurjW
  · apply (Scheme.Hom.isOpenEmbedding O.ι).injective
    have h : (g.resLE O W eWO ≫ O.ι) (⟨⟨v₀, hxU⟩, hxW⟩ : (W : Scheme.{u})) =
        (W.ι ≫ g) (⟨⟨v₀, hxU⟩, hxW⟩ : (W : Scheme.{u})) := by
      rw [Scheme.Hom.resLE_comp_ι]
    exact h.trans hgx
  · intro w hw
    exact Subtype.ext (huniq' w.1 hw)
  · intro Ω _ φ φ' l l' hl hl'
    have hl2 : ((l : Spec (.of Ω) ⟶ (W : Scheme.{u})) ≫ W.ι) ≫ U.ι =
        Spec.map φ ≫ V₀.left.fromSpecResidueField v₀ := (Category.assoc _ _ _).trans hl
    have hl2' : ((l' : Spec (.of Ω) ⟶ (W : Scheme.{u})) ≫ W.ι) ≫ U.ι =
        Spec.map φ' ≫ V₀.left.fromSpecResidueField v₀ := (Category.assoc _ _ _).trans hl'
    have key := hiff Ω φ φ' _ _ hl2 hl2'
    have h1 : l ≫ π.left = l' ≫ π.left ↔ ((l : Spec (.of Ω) ⟶ (W : Scheme.{u})) ≫ W.ι) ≫ g =
        ((l' : Spec (.of Ω) ⟶ (W : Scheme.{u})) ≫ W.ι) ≫ g :=
      ⟨fun h => (eπ l).symm.trans ((congrArg (· ≫ O.ι) h).trans (eπ l')),
        fun h => (cancel_mono O.ι).mp ((eπ l).trans (h.trans (eπ l').symm))⟩
    refine h1.trans (key.trans ?_)
    constructor
    · intro h a ha
      exact h ⟨a, (hmemK a).mpr ha⟩
    · intro h a
      exact h a.1 ((hmemK a.1).mp a.2)
  · intro Ω _ _ w hw
    have halg : ∀ a : V₀.left.residueField v₀, ∃ p : Polynomial K, p ≠ 0 ∧ p.eval₂ i.hom a = 0 := by
      intro a
      have hint : IsIntegral (B.residueField (V₀.hom v₀)) a := Algebra.IsIntegral.isIntegral a
      refine ⟨(minpoly (B.residueField (V₀.hom v₀)) a).map
        (algebraMap (B.residueField (V₀.hom v₀)) K), Polynomial.map_ne_zero (minpoly.ne_zero hint), ?_⟩
      rw [Polynomial.eval₂_map]
      have hc : i.hom.comp (algebraMap (B.residueField (V₀.hom v₀)) K) =
          algebraMap (B.residueField (V₀.hom v₀)) (V₀.left.residueField v₀) :=
        RingHom.ext fun c => K.val.commutes c
      rw [hc, ← Polynomial.aeval_def]
      exact minpoly.aeval _ a
    have hwO : ((w : Spec (.of Ω) ⟶ (O : Scheme.{u})) ≫ O.ι) (IsLocalRing.closedPoint Ω) = v' :=
      congrArg (fun z => O.ι z) hw
    obtain ⟨φ, l₀, hl₀, hl₀g⟩ := hext halg Ω _ hwO
    have hr : Set.range l₀ ⊆ Set.range W.ι := by
      rintro _ ⟨p, rfl⟩
      rw [Scheme.Opens.range_ι]
      have h1 : U.ι (l₀ p) = v₀ := by
        rw [← Scheme.Hom.comp_apply, hl₀, Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]
      have h2 : l₀ p = ⟨v₀, hxU⟩ := Subtype.ext h1
      rw [h2]
      exact hxW
    obtain ⟨lW, hlW⟩ : ∃ lW : Spec (.of Ω) ⟶ (W : Scheme.{u}), lW ≫ W.ι = l₀ :=
      ⟨@IsOpenImmersion.lift _ _ _ W.ι l₀ hWo hr, @IsOpenImmersion.lift_fac _ _ _ W.ι l₀ hWo hr⟩
    refine ⟨φ, lW, ?_, ?_⟩
    · exact (Category.assoc _ _ _).symm.trans ((congrArg (· ≫ U.ι) hlW).trans hl₀)
    · apply (cancel_mono O.ι).mp
      exact (eπ lW).trans ((congrArg (· ≫ g) hlW).trans hl₀g)

theorem wc_esg_descend_section : ∀ (B : Scheme.{u}) (b : B) (F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (V₁ V' : B.Etale) (π : V₁ ⟶ V') (v' : V'.left), IsFinite π.left → AlgebraicGeometry.Surjective π.left → V'.hom v' = b → ∀ (s₁ : F.obj.obj (Opposite.op V₁)), (∀ (t t' : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ V₁.left) (ht : t ≫ V₁.hom = wcEtGeomPt B b) (ht' : t' ≫ V₁.hom = wcEtGeomPt B b), t ≫ π.left = t' ≫ π.left → (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk (Over.homMk t ht : Over.mk (wcEtGeomPt B b) ⟶ (Scheme.Etale.forget B).obj V₁)))).hom s₁ = (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk (Over.homMk t' ht' : Over.mk (wcEtGeomPt B b) ⟶ (Scheme.Etale.forget B).obj V₁)))).hom s₁) → ∃ (V'' : B.Etale) (ι'' : V'' ⟶ V') (s'' : F.obj.obj (Opposite.op V'')), IsOpenImmersion ι''.left ∧ v' ∈ Set.range ι''.left ∧ ∀ (t : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ V₁.left) (ht : t ≫ V₁.hom = wcEtGeomPt B b) (w : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ V''.left) (hw : w ≫ V''.hom = wcEtGeomPt B b), t ≫ π.left = w ≫ ι''.left → (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk (Over.homMk t ht : Over.mk (wcEtGeomPt B b) ⟶ (Scheme.Etale.forget B).obj V₁)))).hom s₁ = (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk (Over.homMk w hw : Over.mk (wcEtGeomPt B b) ⟶ (Scheme.Etale.forget B).obj V'')))).hom s'' :=
by
  intro B b F V₁ V' π v' hπf hπs hv' s₁ hH
  classical
  have hcof := wc_et_geomstalk_cofiltered B b (@wc_etale_maps_agree_near_geom_point)
  obtain ⟨germ, hgerm⟩ : ∃ g : ∀ (V : B.Etale)
      (t : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ V.left),
      t ≫ V.hom = wcEtGeomPt B b → F.obj.obj (Opposite.op V) → ↑((wcEtStalk B b).obj F),
      ∀ V t ht s, g V t ht s = (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b))
        (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk (Over.homMk t ht :
          Over.mk (wcEtGeomPt B b) ⟶ (Scheme.Etale.forget B).obj V)))).hom s :=
    ⟨fun V t ht s => (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b))
        (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk (Over.homMk t ht :
          Over.mk (wcEtGeomPt B b) ⟶ (Scheme.Etale.forget B).obj V)))).hom s,
      fun _ _ _ _ => rfl⟩
  have hT : ∀ (V V₂ : B.Etale) (c : V₂ ⟶ V)
      (t : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ V₂.left)
      (ht : t ≫ V₂.hom = wcEtGeomPt B b) (ht2 : (t ≫ c.left) ≫ V.hom = wcEtGeomPt B b)
      (s : F.obj.obj (Opposite.op V)),
      germ V₂ t ht ((F.obj.map c.op).hom s) = germ V (t ≫ c.left) ht2 s := by
    intro V V₂ c t ht ht2 s
    rw [hgerm, hgerm]
    have hm : (Over.homMk t ht : Over.mk (wcEtGeomPt B b) ⟶ (Scheme.Etale.forget B).obj V₂) ≫
        (Scheme.Etale.forget B).map c =
        (Over.homMk (t ≫ c.left) ht2 : Over.mk (wcEtGeomPt B b) ⟶ (Scheme.Etale.forget B).obj V) := by
      apply Over.OverMorphism.ext <;> rfl
    let m : StructuredArrow.mk (Over.homMk t ht :
        Over.mk (wcEtGeomPt B b) ⟶ (Scheme.Etale.forget B).obj V₂) ⟶
        StructuredArrow.mk (Over.homMk (t ≫ c.left) ht2 :
          Over.mk (wcEtGeomPt B b) ⟶ (Scheme.Etale.forget B).obj V) := StructuredArrow.homMk c hm
    exact Limits.colimit.w_apply ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b))
      (Scheme.Etale.forget B)).op ⋙ F.obj) m.op s
  have hC : ∀ (V : B.Etale) (t t₁ : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ V.left),
      t = t₁ → ∀ (ht : t ≫ V.hom = wcEtGeomPt B b) (ht₁ : t₁ ≫ V.hom = wcEtGeomPt B b)
      (s : F.obj.obj (Opposite.op V)), germ V t ht s = germ V t₁ ht₁ s := by
    intro V t t₁ h ht ht₁ s
    subst h
    rfl
  have hmap : ∀ {A A' C : B.Etale} (f : A ⟶ A') (g : A' ⟶ C) (s : F.obj.obj (Opposite.op C)),
      (F.obj.map (f ≫ g).op).hom s = (F.obj.map f.op).hom ((F.obj.map g.op).hom s) := by
    intro A A' C f g s
    rw [op_comp, Functor.map_comp]
    rfl
  have hgp : ∀ p : Spec (.of (AlgebraicClosure (B.residueField b))), (wcEtGeomPt B b) p = b := by
    intro p
    simp only [wcEtGeomPt, Scheme.Hom.comp_apply]
    exact Scheme.fromSpecResidueField_apply b _

  have hloc : ∀ (W : B.Etale) (a₁ a₂ : W ⟶ V₁), a₁ ≫ π = a₂ ≫ π → ∀ w : W.left,
      π.left (a₁.left w) = v' → ∃ (W₂ : B.Etale) (c : W₂ ⟶ W), w ∈ Set.range c.left ∧
        (F.obj.map c.op).hom ((F.obj.map a₁.op).hom s₁) =
          (F.obj.map c.op).hom ((F.obj.map a₂.op).hom s₁) := by
    intro W a₁ a₂ ha w hw
    haveI : Etale W.hom := W.prop
    have hWw : W.hom w = (wcEtGeomPt B b)
        (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b))) := by
      refine Eq.trans ?_ (hgp _).symm
      calc W.hom w = (a₁.left ≫ V₁.hom) w := by rw [MorphismProperty.Over.w a₁]
        _ = V₁.hom (a₁.left w) := Scheme.Hom.comp_apply _ _ _
        _ = (π.left ≫ V'.hom) (a₁.left w) := by rw [MorphismProperty.Over.w π]
        _ = V'.hom (π.left (a₁.left w)) := Scheme.Hom.comp_apply _ _ _
        _ = b := by rw [hw, hv']
    obtain ⟨r, hr, hrw⟩ := wc_etale_lift_alg_closed_point (AlgebraicClosure (B.residueField b))
      W.hom (wcEtGeomPt B b) w hWw
    have hl : a₁.left ≫ π.left = a₂.left ≫ π.left := congrArg (fun f : W ⟶ V' => f.left) ha
    have h1 : (r ≫ a₁.left) ≫ V₁.hom = wcEtGeomPt B b := by
      rw [Category.assoc, MorphismProperty.Over.w a₁, hr]
    have h2 : (r ≫ a₂.left) ≫ V₁.hom = wcEtGeomPt B b := by
      rw [Category.assoc, MorphismProperty.Over.w a₂, hr]
    have hπeq : (r ≫ a₁.left) ≫ π.left = (r ≫ a₂.left) ≫ π.left := by
      rw [Category.assoc, Category.assoc, hl]
    have hg : germ V₁ _ h1 s₁ = germ V₁ _ h2 s₁ := by
      rw [hgerm, hgerm]
      exact hH _ _ h1 h2 hπeq
    have hxy : germ W r hr ((F.obj.map a₁.op).hom s₁) = germ W r hr ((F.obj.map a₂.op).hom s₁) :=
      (hT V₁ W a₁ r hr h1 s₁).trans (hg.trans (hT V₁ W a₂ r hr h2 s₁).symm)
    rw [hgerm, hgerm] at hxy
    have hz : germ W r hr ((F.obj.map a₁.op).hom s₁ - (F.obj.map a₂.op).hom s₁) =
        germ W r hr 0 := by
      rw [hgerm, hgerm, map_sub, map_zero, hxy, sub_self]
    rw [hgerm, hgerm] at hz
    obtain ⟨A'', f, f', hff⟩ := (wc_et_stalk_germ_facts B b hcof F).2.1
      (StructuredArrow.mk (Over.homMk r hr :
        Over.mk (wcEtGeomPt B b) ⟶ (Scheme.Etale.forget B).obj W))
      (StructuredArrow.mk (Over.homMk r hr :
        Over.mk (wcEtGeomPt B b) ⟶ (Scheme.Etale.forget B).obj W))
      ((F.obj.map a₁.op).hom s₁ - (F.obj.map a₂.op).hom s₁) 0 hz
    refine ⟨A''.right, f.right, ?_, ?_⟩
    · have hw' := congrArg (fun φ => φ.left) (StructuredArrow.w f)
      have hcomp : A''.hom.left ≫ f.right.left = r := hw'
      refine ⟨A''.hom.left (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b))), ?_⟩
      exact (Scheme.Hom.comp_apply A''.hom.left f.right.left _).symm.trans
        ((congrArg (fun g => g (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b))))
          hcomp).trans hrw)
    · rw [map_sub, map_zero] at hff
      exact sub_eq_zero.mp hff

  haveI : IsFinite π.left := hπf
  haveI : Etale V'.hom := V'.prop
  haveI : Etale V₁.hom := V₁.prop
  haveI : Etale π.left := by
    haveI : Etale (π.left ≫ V'.hom) := by rw [MorphismProperty.Over.w π]; exact V₁.prop
    exact Etale.of_comp π.left V'.hom
  let R : B.Etale := MorphismProperty.Over.mk ⊤
    (Limits.pullback.fst π.left π.left ≫ V₁.hom) inferInstance
  let q₁ : R ⟶ V₁ := MorphismProperty.Over.homMk (Limits.pullback.fst π.left π.left) rfl trivial
  have e2 : Limits.pullback.snd π.left π.left ≫ V₁.hom =
      Limits.pullback.fst π.left π.left ≫ V₁.hom := by
    rw [← MorphismProperty.Over.w π, Limits.pullback.condition_assoc]
  let q₂ : R ⟶ V₁ := MorphismProperty.Over.homMk (Limits.pullback.snd π.left π.left) e2 trivial
  have hq : q₁ ≫ π = q₂ ≫ π := MorphismProperty.Over.Hom.ext Limits.pullback.condition
  set d : F.obj.obj (Opposite.op R) := (F.obj.map q₁.op).hom s₁ - (F.obj.map q₂.op).hom s₁
    with hd
  have hvan := wc_etale_section_vanishing_open B F R d
  set Zs : Set R.left := {v : R.left | ∃ (V₂ : B.Etale) (c : V₂ ⟶ R), v ∈ Set.range c.left ∧
    F.obj.map c.op d = 0} with hZs
  have hcl : IsClosed ((Limits.pullback.fst π.left π.left ≫ π.left) '' Zsᶜ) :=
    Scheme.Hom.isClosedMap (Limits.pullback.fst π.left π.left ≫ π.left) _
      hvan.1.isClosed_compl
  let O : V'.left.Opens := ⟨((Limits.pullback.fst π.left π.left ≫ π.left) '' Zsᶜ)ᶜ,
    hcl.isOpen_compl⟩
  have hv'O : v' ∈ O := by
    show v' ∉ (Limits.pullback.fst π.left π.left ≫ π.left) '' Zsᶜ
    rintro ⟨r, hrC, hrp⟩
    apply hrC
    obtain ⟨W₂, c, hc, hceq⟩ := hloc R q₁ q₂ hq r
      ((Scheme.Hom.comp_apply (Limits.pullback.fst π.left π.left) π.left r).symm.trans hrp)
    refine ⟨W₂, c, hc, ?_⟩
    show (F.obj.map c.op).hom d = 0
    rw [hd, map_sub, hceq, sub_self]
  have hagree : ∀ (Z : B.Etale) (a₁ a₂ : Z ⟶ V₁), a₁ ≫ π = a₂ ≫ π →
      (∀ z : Z.left, π.left (a₁.left z) ∈ O) →
      (F.obj.map a₁.op).hom s₁ = (F.obj.map a₂.op).hom s₁ := by
    intro Z a₁ a₂ ha hz
    have hl : a₁.left ≫ π.left = a₂.left ≫ π.left := congrArg (fun f : Z ⟶ V' => f.left) ha
    let mo : Z ⟶ R := MorphismProperty.Over.homMk (Limits.pullback.lift a₁.left a₂.left hl)
      (by
        show Limits.pullback.lift a₁.left a₂.left hl ≫ Limits.pullback.fst π.left π.left ≫ V₁.hom
          = Z.hom
        rw [Limits.pullback.lift_fst_assoc]
        exact MorphismProperty.Over.w a₁) trivial
    have h1 : mo ≫ q₁ = a₁ := MorphismProperty.Over.Hom.ext (Limits.pullback.lift_fst _ _ _)
    have h2 : mo ≫ q₂ = a₂ := MorphismProperty.Over.Hom.ext (Limits.pullback.lift_snd _ _ _)
    have hmf : mo.left ≫ Limits.pullback.fst π.left π.left = a₁.left :=
      Limits.pullback.lift_fst _ _ _
    have hsub : Set.range mo.left ⊆ Zs := by
      rintro _ ⟨z, rfl⟩
      by_contra hn
      have hzz : π.left (a₁.left z) ∉ (Limits.pullback.fst π.left π.left ≫ π.left) '' Zsᶜ := hz z
      apply hzz
      refine ⟨mo.left z, hn, ?_⟩
      exact (Scheme.Hom.comp_apply (Limits.pullback.fst π.left π.left) π.left (mo.left z)).trans
        (congrArg π.left ((Scheme.Hom.comp_apply mo.left
          (Limits.pullback.fst π.left π.left) z).symm.trans
          (congrArg (fun g => g z) hmf)))
    have h0 : (F.obj.map mo.op).hom d = 0 := hvan.2 Z mo hsub
    rw [hd, map_sub, ← hmap, ← hmap, h1, h2, sub_eq_zero] at h0
    exact h0

  let U : V₁.left.Opens := π.left ⁻¹ᵁ O
  have hUmem : ∀ x : V₁.left, x ∈ U → π.left x ∈ O := fun x hx => hx
  have hUmem' : ∀ x : V₁.left, π.left x ∈ O → x ∈ U := fun x hx => hx
  have hιO : ∀ y : (O : Scheme.{u}), O.ι y ∈ O := by
    intro y
    have : O.ι y ∈ Set.range O.ι := ⟨y, rfl⟩
    rw [Scheme.Opens.range_ι] at this
    exact this
  have hιU : ∀ y : (U : Scheme.{u}), U.ι y ∈ U := by
    intro y
    have : U.ι y ∈ Set.range U.ι := ⟨y, rfl⟩
    rw [Scheme.Opens.range_ι] at this
    exact this
  have hrU : Set.range (U.ι ≫ π.left) ⊆ Set.range O.ι := by
    rintro _ ⟨x, rfl⟩
    rw [Scheme.Opens.range_ι, Scheme.Hom.comp_apply]
    exact hUmem _ (hιU x)
  let ℓ : (U : Scheme.{u}) ⟶ (O : Scheme.{u}) := IsOpenImmersion.lift O.ι (U.ι ≫ π.left) hrU
  have hℓ : ℓ ≫ O.ι = U.ι ≫ π.left := IsOpenImmersion.lift_fac _ _ _
  let πU : wcEtOpen B V₁ U ⟶ wcEtOpen B V' O := MorphismProperty.Over.homMk ℓ
    (by
      show ℓ ≫ O.ι ≫ V'.hom = U.ι ≫ V₁.hom
      rw [← Category.assoc, hℓ, Category.assoc, MorphismProperty.Over.w π]) trivial
  have hj : wcEtOpenι B V₁ U ≫ π = πU ≫ wcEtOpenι B V' O :=
    MorphismProperty.Over.Hom.ext hℓ.symm
  have hF : Presieve.IsSheaf (Scheme.smallEtaleTopology B) (F.obj ⋙ forget AddCommGrpCat) :=
    (isSheaf_iff_isSheaf_of_type _ _).1
      ((Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology B) F.obj
        (forget AddCommGrpCat.{u+1})).1 F.property)
  have hS : Sieve.generate (Presieve.singleton πU) ∈
      Scheme.smallEtaleTopology B (wcEtOpen B V' O) := by
    apply wc_etale_jointly_surjective_covers
    intro v
    obtain ⟨x, hx⟩ := hπs.surj (O.ι v)
    have hxU : x ∈ U := hUmem' x (by rw [hx]; exact hιO v)
    refine ⟨wcEtOpen B V₁ U, πU,
      ⟨wcEtOpen B V₁ U, 𝟙 _, πU, Presieve.singleton.mk, Category.id_comp πU⟩,
      (⟨x, hxU⟩ : U), ?_⟩
    apply (Scheme.Hom.isOpenEmbedding O.ι).injective
    show (ℓ ≫ O.ι) (⟨x, hxU⟩ : U) = O.ι v
    refine (congrArg (fun g => g (⟨x, hxU⟩ : U)) hℓ).trans ?_
    refine (Scheme.Hom.comp_apply U.ι π.left _).trans ?_
    rw [Scheme.Opens.ι_apply]
    exact hx
  have h1 := (Presieve.isSheafFor_iff_generate (Presieve.singleton πU)).2 (hF _ hS)
  have h2 := (Presieve.isSheafFor_singleton (P := F.obj ⋙ forget AddCommGrpCat)).1 h1
  obtain ⟨s'', hs'', -⟩ := h2 ((F.obj.map (wcEtOpenι B V₁ U).op).hom s₁)
    (fun {Y} p₁ p₂ hp => by
      change (F.obj.map p₁.op).hom ((F.obj.map (wcEtOpenι B V₁ U).op).hom s₁) =
        (F.obj.map p₂.op).hom ((F.obj.map (wcEtOpenι B V₁ U).op).hom s₁)
      rw [← hmap, ← hmap]
      apply hagree
      · rw [Category.assoc, Category.assoc, hj, ← Category.assoc, hp, Category.assoc]
      · intro y
        exact hUmem _ (hιU (p₁.left y)))
  have hs' : (F.obj.map πU.op).hom s'' = (F.obj.map (wcEtOpenι B V₁ U).op).hom s₁ := hs''

  refine ⟨wcEtOpen B V' O, wcEtOpenι B V' O, s'', ?_, ?_, ?_⟩
  · show IsOpenImmersion O.ι
    infer_instance
  · show v' ∈ Set.range O.ι
    rw [Scheme.Opens.range_ι]
    exact hv'O
  · intro t ht w hw htw
    have htU : Set.range t ⊆ Set.range U.ι := by
      rintro _ ⟨q, rfl⟩
      rw [Scheme.Opens.range_ι]
      apply hUmem'
      rw [← Scheme.Hom.comp_apply, htw, Scheme.Hom.comp_apply]
      exact hιO (w q)
    let tU := IsOpenImmersion.lift U.ι t htU
    have htU' : tU ≫ U.ι = t := IsOpenImmersion.lift_fac _ _ _
    have htℓ : tU ≫ ℓ = w := by
      apply (cancel_mono O.ι).mp
      rw [Category.assoc, hℓ, ← Category.assoc, htU', htw]
      rfl
    have e1 : tU ≫ (wcEtOpen B V₁ U).hom = wcEtGeomPt B b := by
      show tU ≫ U.ι ≫ V₁.hom = _
      rw [← Category.assoc, htU', ht]
    have e2 : (tU ≫ (wcEtOpenι B V₁ U).left) ≫ V₁.hom = wcEtGeomPt B b := by
      show (tU ≫ U.ι) ≫ V₁.hom = _
      rw [htU', ht]
    have e3 : (tU ≫ πU.left) ≫ (wcEtOpen B V' O).hom = wcEtGeomPt B b := by
      show (tU ≫ ℓ) ≫ (wcEtOpen B V' O).hom = _
      rw [htℓ]
      exact hw
    have key := (hC V₁ t (tU ≫ (wcEtOpenι B V₁ U).left) htU'.symm ht e2 s₁).trans
      ((hT V₁ (wcEtOpen B V₁ U) (wcEtOpenι B V₁ U) tU e1 e2 s₁).symm.trans
        ((congrArg (germ (wcEtOpen B V₁ U) tU e1) hs'.symm).trans
          ((hT (wcEtOpen B V' O) (wcEtOpen B V₁ U) πU tU e1 e3 s'').trans
            (hC (wcEtOpen B V' O) (tU ≫ πU.left) w htℓ e3 hw s''))))
    rw [hgerm, hgerm] at key
    exact key

theorem wc_et_stalk_germ_injective_chart : ∀ (K : Type u) [Field K] (B : Scheme.{u}) (fB : B ⟶ Spec (.of K)) [IsProper fB] (b : B), (∀ y : B, y ⤳ b → y = b) → ∀ (F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (x : ↑((wcEtStalk B b).obj F)), ∃ (V : B.Etale) (OY : B.Opens) (εO : V.left ⟶ (OY : Scheme.{u})) (s : F.obj.obj (Opposite.op V)) (t₀ : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ V.left) (ht₀ : t₀ ≫ V.hom = wcEtGeomPt B b), IsAffineOpen OY ∧ IrreducibleSpace V.left ∧ IsFinite εO ∧ εO ≫ OY.ι = V.hom ∧ (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk (Over.homMk t₀ ht₀ : Over.mk (wcEtGeomPt B b) ⟶ (Scheme.Etale.forget B).obj V)))).hom s = x ∧ (∀ (t : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ V.left), t ≫ V.hom = wcEtGeomPt B b → t (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b))) = t₀ (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b)))) ∧ ∀ (t t' : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ V.left) (ht : t ≫ V.hom = wcEtGeomPt B b) (ht' : t' ≫ V.hom = wcEtGeomPt B b), (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk (Over.homMk t ht : Over.mk (wcEtGeomPt B b) ⟶ (Scheme.Etale.forget B).obj V)))).hom s = (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk (Over.homMk t' ht' : Over.mk (wcEtGeomPt B b) ⟶ (Scheme.Etale.forget B).obj V)))).hom s → t = t' :=
by
  intro K _ B fB _ b hgen F x
  classical

  have hpt : ∀ p q : Spec (.of (AlgebraicClosure (B.residueField b))), p = q :=
    fun p q => Subsingleton.elim p q
  have hgp : ∀ p : Spec (.of (AlgebraicClosure (B.residueField b))), (wcEtGeomPt B b) p = b := by
    intro p
    simp only [wcEtGeomPt, Scheme.Hom.comp_apply]
    exact Scheme.fromSpecResidueField_apply b _
  have hP : ∀ (V : B.Etale) (t : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ V.left),
      t ≫ V.hom = wcEtGeomPt B b → ∀ p, V.hom (t p) = b := by
    intro V t ht p
    have h1 := congrArg (fun f : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ B => f p) ht
    simp only [Scheme.Hom.comp_apply] at h1
    exact h1.trans (hgp _)
  have hfac : ∀ (Y : Scheme.{u}) (y : Y) (t : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ Y),
      t (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b))) = y →
      ∃ φ : Y.residueField y ⟶ CommRingCat.of (AlgebraicClosure (B.residueField b)),
        t = Spec.map φ ≫ Y.fromSpecResidueField y := by
    intro Y y t hy
    obtain ⟨⟨y₁, φ₁⟩, he⟩ : ∃ p, Scheme.SpecToEquivOfField (AlgebraicClosure (B.residueField b)) Y t = p :=
      ⟨_, rfl⟩
    have ht : t = Spec.map φ₁ ≫ Y.fromSpecResidueField y₁ := by
      rw [← (Scheme.SpecToEquivOfField (AlgebraicClosure (B.residueField b)) Y).symm_apply_apply t, he]
      rfl
    subst ht
    have hy₁ : y₁ = y :=
      ((Scheme.Hom.comp_apply _ _ _).trans (Scheme.fromSpecResidueField_apply _ _)).symm.trans hy
    subst hy₁
    exact ⟨φ₁, rfl⟩

  let germ : ∀ (V : B.Etale) (t : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ V.left),
      t ≫ V.hom = wcEtGeomPt B b → F.obj.obj (Opposite.op V) → ↑((wcEtStalk B b).obj F) :=
    fun V t ht s => (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b))
      (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk (Over.homMk t ht :
        Over.mk (wcEtGeomPt B b) ⟶ (Scheme.Etale.forget B).obj V)))).hom s
  have hT : ∀ (V V' : B.Etale) (c : V' ⟶ V)
      (t : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ V'.left)
      (ht : t ≫ V'.hom = wcEtGeomPt B b) (ht2 : (t ≫ c.left) ≫ V.hom = wcEtGeomPt B b)
      (s : F.obj.obj (Opposite.op V)),
      germ V' t ht ((F.obj.map c.op).hom s) = germ V (t ≫ c.left) ht2 s := by
    intro V V' c t ht ht2 s
    have hm : (Over.homMk t ht : Over.mk (wcEtGeomPt B b) ⟶ (Scheme.Etale.forget B).obj V') ≫
        (Scheme.Etale.forget B).map c =
        (Over.homMk (t ≫ c.left) ht2 : Over.mk (wcEtGeomPt B b) ⟶ (Scheme.Etale.forget B).obj V) := by
      apply Over.OverMorphism.ext <;> rfl
    let m : StructuredArrow.mk (Over.homMk t ht :
        Over.mk (wcEtGeomPt B b) ⟶ (Scheme.Etale.forget B).obj V') ⟶
        StructuredArrow.mk (Over.homMk (t ≫ c.left) ht2 :
          Over.mk (wcEtGeomPt B b) ⟶ (Scheme.Etale.forget B).obj V) := StructuredArrow.homMk c hm
    exact Limits.colimit.w_apply ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b))
      (Scheme.Etale.forget B)).op ⋙ F.obj) m.op s
  have hC : ∀ (V : B.Etale) (t t₁ : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ V.left),
      t = t₁ → ∀ (ht : t ≫ V.hom = wcEtGeomPt B b) (ht₁ : t₁ ≫ V.hom = wcEtGeomPt B b)
      (s : F.obj.obj (Opposite.op V)), germ V t ht s = germ V t₁ ht₁ s := by
    intro V t t₁ h ht ht₁ s
    subst h
    rfl

  have hcof := wc_et_geomstalk_cofiltered B b (@wc_etale_maps_agree_near_geom_point)
  obtain ⟨A, s₀', hA⟩ := (wc_et_stalk_germ_facts B b hcof F).1 x
  obtain ⟨V₀, a₀, ha₀, s₀, hx0⟩ : ∃ (V₀ : B.Etale)
      (a₀ : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ V₀.left)
      (ha₀ : a₀ ≫ V₀.hom = wcEtGeomPt B b) (s₀ : F.obj.obj (Opposite.op V₀)),
      germ V₀ a₀ ha₀ s₀ = x := ⟨A.right, A.hom.left, Over.w A.hom, s₀', hA⟩
  obtain ⟨v₀, hv₀d⟩ : ∃ v₀ : V₀.left,
      a₀ (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b))) = v₀ := ⟨_, rfl⟩
  have hv₀ : V₀.hom v₀ = b := by
    rw [← hv₀d]
    exact hP V₀ a₀ ha₀ _
  have hgen₀ : ∀ y : B, y ⤳ V₀.hom v₀ → y = V₀.hom v₀ := by
    rw [hv₀]
    exact hgen
  haveI : IsLocallyNoetherian B := LocallyOfFiniteType.isLocallyNoetherian fB

  obtain ⟨L', hL'r, hL'⟩ := wc_esg_germ_fixed_subfield B b F V₀ v₀ hv₀ s₀
  obtain ⟨V₁, ι, v₁, V', π, v', hιo, hιv, hV₁u, hπf, hπs, hπv, hV'u, hcmp, hext⟩ :=
    wc_esg_realise_subfield B V₀ v₀ hgen₀ L' hL'r
  haveI := hιo

  have hV1 : ∀ (l : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ V₁.left)
      (hl : l ≫ V₁.hom = wcEtGeomPt B b),
      ∃ (φ : V₀.left.residueField v₀ ⟶ CommRingCat.of (AlgebraicClosure (B.residueField b)))
        (hφ : l ≫ ι.left = Spec.map φ ≫ V₀.left.fromSpecResidueField v₀)
        (h' : (Spec.map φ ≫ V₀.left.fromSpecResidueField v₀) ≫ V₀.hom = wcEtGeomPt B b),
        germ V₁ l hl ((F.obj.map ι.op).hom s₀) =
          germ V₀ (Spec.map φ ≫ V₀.left.fromSpecResidueField v₀) h' s₀ := by
    intro l hl
    have hlpt : l (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b))) = v₁ :=
      hV₁u _ ((hP V₁ l hl _).trans hv₀.symm)
    have hpt0 : (l ≫ ι.left) (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b))) = v₀ :=
      (Scheme.Hom.comp_apply _ _ _).trans ((congrArg ι.left hlpt).trans hιv)
    obtain ⟨φ, hφ⟩ := hfac V₀.left v₀ (l ≫ ι.left) hpt0
    have h1 : (l ≫ ι.left) ≫ V₀.hom = wcEtGeomPt B b := by
      rw [Category.assoc, MorphismProperty.Over.w ι, hl]
    have h' : (Spec.map φ ≫ V₀.left.fromSpecResidueField v₀) ≫ V₀.hom = wcEtGeomPt B b := by
      rw [← hφ]
      exact h1
    exact ⟨φ, hφ, h', (hT V₀ V₁ ι l hl h1 s₀).trans (hC V₀ _ _ hφ h1 h' s₀)⟩
  have hgerm1 : ∀ (l l' : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ V₁.left)
      (hl : l ≫ V₁.hom = wcEtGeomPt B b) (hl' : l' ≫ V₁.hom = wcEtGeomPt B b),
      germ V₁ l hl ((F.obj.map ι.op).hom s₀) = germ V₁ l' hl' ((F.obj.map ι.op).hom s₀) ↔
        l ≫ π.left = l' ≫ π.left := by
    intro l l' hl hl'
    obtain ⟨φ, hφ, h', e⟩ := hV1 l hl
    obtain ⟨φ', hφ', h'', e'⟩ := hV1 l' hl'
    rw [e, e']
    exact (hL' φ φ' h' h'').trans (hcmp _ φ φ' l l' hφ hφ').symm

  have hr1 : Set.range a₀ ⊆ Set.range ι.left := by
    rintro _ ⟨p, rfl⟩
    exact ⟨v₁, hιv.trans (hv₀d.symm.trans (congrArg a₀ (hpt _ p)))⟩
  obtain ⟨a₁, ha₁ι⟩ : ∃ a₁ : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ V₁.left,
      a₁ ≫ ι.left = a₀ := ⟨IsOpenImmersion.lift ι.left a₀ hr1, IsOpenImmersion.lift_fac _ _ _⟩
  have ha₁ : a₁ ≫ V₁.hom = wcEtGeomPt B b := by
    rw [← MorphismProperty.Over.w ι, ← Category.assoc, ha₁ι, ha₀]
  have ha₁p : ∀ p, a₁ p = v₁ := fun p => hV₁u _ ((hP V₁ a₁ ha₁ p).trans hv₀.symm)
  have hgermV1 : germ V₁ a₁ ha₁ ((F.obj.map ι.op).hom s₀) = x := by
    have h2 : (a₁ ≫ ι.left) ≫ V₀.hom = wcEtGeomPt B b := by
      rw [ha₁ι]
      exact ha₀
    exact (hT V₀ V₁ ι a₁ ha₁ h2 s₀).trans ((hC V₀ _ _ ha₁ι h2 ha₀ s₀).trans hx0)

  have hv'b : V'.hom v' = b := by
    rw [← hπv, ← Scheme.Hom.comp_apply, MorphismProperty.Over.w π, ← MorphismProperty.Over.w ι,
      Scheme.Hom.comp_apply, hιv, hv₀]
  obtain ⟨V'', ι'', s'', hι''o, hv'', hg''⟩ :=
    wc_esg_descend_section B b F V₁ V' π v' hπf hπs hv'b ((F.obj.map ι.op).hom s₀)
      (fun t t' ht ht' h => (hgerm1 t t' ht ht').mpr h)
  haveI := hι''o
  have hr2 : Set.range (a₁ ≫ π.left) ⊆ Set.range ι''.left := by
    rintro _ ⟨p, rfl⟩
    obtain ⟨q, hq⟩ := hv''
    refine ⟨q, hq.trans ?_⟩
    rw [Scheme.Hom.comp_apply, ha₁p, hπv]
  obtain ⟨w₀, hw₀ι⟩ : ∃ w₀ : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ V''.left,
      w₀ ≫ ι''.left = a₁ ≫ π.left :=
    ⟨IsOpenImmersion.lift ι''.left (a₁ ≫ π.left) hr2, IsOpenImmersion.lift_fac _ _ _⟩
  have hw₀ : w₀ ≫ V''.hom = wcEtGeomPt B b := by
    rw [← MorphismProperty.Over.w ι'', ← Category.assoc, hw₀ι, Category.assoc,
      MorphismProperty.Over.w π, ha₁]
  have hgermx : germ V'' w₀ hw₀ s'' = x :=
    (hg'' a₁ ha₁ w₀ hw₀ hw₀ι.symm).symm.trans hgermV1

  have hι''pt : ∀ (t : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ V''.left),
      t ≫ V''.hom = wcEtGeomPt B b → ∀ p, ι''.left (t p) = v' := by
    intro t ht p
    apply hV'u
    rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w ι'', hP V'' t ht p, hv₀]
  have hU'' : ∀ (t : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ V''.left),
      t ≫ V''.hom = wcEtGeomPt B b →
      t (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b))) =
        w₀ (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b))) := fun t ht =>
    (Scheme.Hom.isOpenEmbedding ι''.left).injective
      ((hι''pt t ht _).trans (hι''pt w₀ hw₀ _).symm)

  have hI'' : ∀ (t t' : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ V''.left)
      (ht : t ≫ V''.hom = wcEtGeomPt B b) (ht' : t' ≫ V''.hom = wcEtGeomPt B b),
      germ V'' t ht s'' = germ V'' t' ht' s'' → t = t' := by
    intro t t' ht ht' heq
    obtain ⟨φ, l, -, hlπ⟩ := hext (AlgebraicClosure (B.residueField b)) (t ≫ ι''.left)
      ((Scheme.Hom.comp_apply _ _ _).trans (hι''pt t ht _))
    obtain ⟨φ', l', -, hlπ'⟩ := hext (AlgebraicClosure (B.residueField b)) (t' ≫ ι''.left)
      ((Scheme.Hom.comp_apply _ _ _).trans (hι''pt t' ht' _))
    have hl : l ≫ V₁.hom = wcEtGeomPt B b := by
      rw [← MorphismProperty.Over.w π, ← Category.assoc, hlπ, Category.assoc,
        MorphismProperty.Over.w ι'', ht]
    have hl' : l' ≫ V₁.hom = wcEtGeomPt B b := by
      rw [← MorphismProperty.Over.w π, ← Category.assoc, hlπ', Category.assoc,
        MorphismProperty.Over.w ι'', ht']
    have e1 := hg'' l hl t ht hlπ
    have e2 := hg'' l' hl' t' ht' hlπ'
    have hll : l ≫ π.left = l' ≫ π.left :=
      (hgerm1 l l' hl hl').mp ((e1.trans heq).trans e2.symm)
    have hι : t ≫ ι''.left = t' ≫ ι''.left := hlπ.symm.trans (hll.trans hlπ')
    exact (cancel_mono ι''.left).mp hι

  obtain ⟨u₀, hu₀d⟩ : ∃ u₀ : V''.left,
      w₀ (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b))) = u₀ := ⟨_, rfl⟩
  have hu₀ : V''.hom u₀ = b := by
    rw [← hu₀d]
    exact hP V'' w₀ hw₀ _
  have hgen'' : ∀ y : B, y ⤳ V''.hom u₀ → y = V''.hom u₀ := by
    rw [hu₀]
    exact hgen
  obtain ⟨W, OY, εO, hvW, hWirr, hOY, hεO, hεc⟩ :=
    wc_r2gs_etale_chart_at_generic K B fB V'' u₀ hgen''
  have hrW : Set.range w₀ ⊆ Set.range W.ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨p, rfl⟩
    have hp : w₀ p = u₀ := (congrArg w₀ (hpt p _)).trans hu₀d
    exact (congrArg (· ∈ (W : Set V''.left)) hp).mpr hvW
  obtain ⟨t₀, ht₀W⟩ : ∃ t₀ : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ (W : Scheme.{u}),
      t₀ ≫ W.ι = w₀ := ⟨IsOpenImmersion.lift W.ι w₀ hrW, IsOpenImmersion.lift_fac _ _ _⟩
  have ht₀ : t₀ ≫ (wcEtOpen B V'' W).hom = wcEtGeomPt B b := by
    show t₀ ≫ (W.ι ≫ V''.hom) = wcEtGeomPt B b
    rw [← Category.assoc, ht₀W, hw₀]
  have hlift : ∀ (t : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ (wcEtOpen B V'' W).left),
      t ≫ (wcEtOpen B V'' W).hom = wcEtGeomPt B b →
      (t ≫ (wcEtOpenι B V'' W).left) ≫ V''.hom = wcEtGeomPt B b := by
    intro t ht
    rw [Category.assoc]
    exact ht
  refine ⟨wcEtOpen B V'' W, OY, εO, (F.obj.map (wcEtOpenι B V'' W).op).hom s'', t₀, ht₀,
    hOY, hWirr, hεO, hεc, ?_, ?_, ?_⟩
  · have h2 := hlift t₀ ht₀
    exact (hT V'' (wcEtOpen B V'' W) (wcEtOpenι B V'' W) t₀ ht₀ h2 s'').trans
      ((hC V'' _ _ ht₀W h2 hw₀ s'').trans hgermx)
  · intro t ht
    apply (Scheme.Hom.isOpenEmbedding W.ι).injective
    have e1 := hU'' (t ≫ W.ι) (hlift t ht)
    rw [← ht₀W] at e1
    exact ((Scheme.Hom.comp_apply _ _ _).symm.trans e1).trans (Scheme.Hom.comp_apply _ _ _)
  · intro t t' ht ht' heq
    have h1 := hlift t ht
    have h1' := hlift t' ht'
    have hh := hI'' _ _ h1 h1'
      (((hT V'' (wcEtOpen B V'' W) (wcEtOpenι B V'' W) t ht h1 s'').symm.trans heq).trans
        (hT V'' (wcEtOpen B V'' W) (wcEtOpenι B V'' W) t' ht' h1' s''))
    exact (cancel_mono W.ι).mp hh

theorem wc_r2gi_geom_lift_conj : ∀ (B Y : Scheme.{u}) (h : Y ⟶ B) (b : B) (t t₀ : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ Y), t ≫ h = wcEtGeomPt B b → t₀ ≫ h = wcEtGeomPt B b → t (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b))) = t₀ (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b))) → ∃ τ : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ Spec (.of (AlgebraicClosure (B.residueField b))), τ ≫ wcEtGeomPt B b = wcEtGeomPt B b ∧ t = τ ≫ t₀ :=
by

  have fieldext : ∀ (k L : Type u) [Field k] [Field L] (r : k →+* L)
      (φ ψ : L →+* AlgebraicClosure k),
      φ.comp r = algebraMap k (AlgebraicClosure k) →
      ψ.comp r = algebraMap k (AlgebraicClosure k) →
      ∃ σ : AlgebraicClosure k →+* AlgebraicClosure k, σ.comp ψ = φ ∧
        σ.comp (algebraMap k (AlgebraicClosure k)) = algebraMap k (AlgebraicClosure k) := by
    intro k L _ _ r φ ψ hφ hψ
    have hAlg : @Algebra.IsAlgebraic L (AlgebraicClosure k) _ _ ψ.toAlgebra := by
      letI : Algebra L (AlgebraicClosure k) := ψ.toAlgebra
      refine ⟨fun x => ?_⟩
      obtain ⟨p, hp0, hpx⟩ := Algebra.IsAlgebraic.isAlgebraic (R := k) x
      refine ⟨p.map r, (Polynomial.map_ne_zero_iff r.injective).mpr hp0, ?_⟩
      rw [Polynomial.aeval_def, Polynomial.eval₂_map]
      rw [Polynomial.aeval_def] at hpx
      change Polynomial.eval₂ (ψ.comp r) x p = 0
      rw [hψ]
      exact hpx
    obtain ⟨σ, hσ⟩ : ∃ σ : AlgebraicClosure k →+* AlgebraicClosure k, ∀ l, σ (ψ l) = φ l := by
      let σ₀ := @IsAlgClosed.lift (AlgebraicClosure k) _ _ L _ _ (AlgebraicClosure k) _ _
        ψ.toAlgebra φ.toAlgebra _ _ hAlg
      exact ⟨@AlgHom.toRingHom L _ _ _ _ _ ψ.toAlgebra φ.toAlgebra σ₀,
        fun l => @AlgHom.commutes L _ _ _ _ _ ψ.toAlgebra φ.toAlgebra σ₀ l⟩
    have h1 : σ.comp ψ = φ := by
      ext l
      exact hσ l
    refine ⟨σ, h1, ?_⟩
    conv_lhs => rw [← hψ]
    rw [← RingHom.comp_assoc, h1, hφ]

  have factor : ∀ (B Y : Scheme.{u}) (h : Y ⟶ B) (b : B) (y : Y) (hy : h y = b)
      (t : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ Y),
      t ≫ h = wcEtGeomPt B b →
      t (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b))) = y →
      ∃ φ : Y.residueField y ⟶ CommRingCat.of (AlgebraicClosure (B.residueField b)),
        t = Spec.map φ ≫ Y.fromSpecResidueField y ∧
        (Scheme.residueFieldCongr hy.symm).hom ≫ h.residueFieldMap y ≫ φ =
          CommRingCat.ofHom (algebraMap (B.residueField b) (AlgebraicClosure (B.residueField b))) := by
    intro B Y h b y hy t ht e
    subst e
    refine ⟨Scheme.descResidueField (Scheme.stalkClosedPointTo t), ?_, ?_⟩
    · exact (Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField _ Y t).symm
    · apply Spec.map_injective
      rw [← cancel_mono (B.fromSpecResidueField b)]
      rw [Spec.map_comp, Spec.map_comp, Category.assoc, Category.assoc,
        Scheme.residueFieldCongr_fromSpecResidueField,
        Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField, ← Category.assoc,
        Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField]
      exact ht
  intro B Y h b t t₀ ht ht₀ hpt
  have hy : h (t₀ (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b)))) = b := by
    have h1 := congrArg (fun f : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ B =>
      f (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b)))) ht₀
    simp only [Scheme.Hom.comp_apply] at h1
    refine h1.trans ?_
    simp only [wcEtGeomPt, Scheme.Hom.comp_apply]
    exact Scheme.fromSpecResidueField_apply b _
  obtain ⟨φ, hφ1, hφ2⟩ := factor B Y h b _ hy t ht hpt
  obtain ⟨ψ, hψ1, hψ2⟩ := factor B Y h b _ hy t₀ ht₀ rfl
  obtain ⟨σ, hσ1, hσ2⟩ := fieldext (B.residueField b) _
    ((Scheme.residueFieldCongr hy.symm).hom ≫ h.residueFieldMap _).hom φ.hom ψ.hom
    (congrArg CommRingCat.Hom.hom ((Category.assoc _ _ _).trans hφ2))
    (congrArg CommRingCat.Hom.hom ((Category.assoc _ _ _).trans hψ2))
  have e1 : CommRingCat.ofHom (algebraMap (B.residueField b) (AlgebraicClosure (B.residueField b)))
      ≫ CommRingCat.ofHom σ =
      CommRingCat.ofHom (algebraMap (B.residueField b) (AlgebraicClosure (B.residueField b))) :=
    CommRingCat.hom_ext hσ2
  have e2 : ψ ≫ CommRingCat.ofHom σ = φ := CommRingCat.hom_ext hσ1
  refine ⟨Spec.map (CommRingCat.ofHom σ), ?_, ?_⟩
  · show Spec.map _ ≫ Spec.map _ ≫ _ = _
    rw [← Spec.map_comp_assoc, e1]
  · rw [hψ1, ← Spec.map_comp_assoc, e2, ← hφ1]

theorem wc_r2gi_twist_component_preimage : ∀ (X B : Scheme.{u}) (g : X ⟶ B) (η : B) (τ : Spec (.of (AlgebraicClosure (B.residueField η))) ⟶ Spec (.of (AlgebraicClosure (B.residueField η)))) (hτ : τ ≫ wcEtGeomPt B η = wcEtGeomPt B η), Function.Injective ⇑(Limits.pullback.map g (wcEtGeomPt B η) g (wcEtGeomPt B η) (𝟙 X) τ (𝟙 B) (by simp) (by rw [Category.comp_id, hτ])) ∧ ∀ Z₀ : Set ↥(Limits.pullback g (wcEtGeomPt B η)), Z₀ ∈ irreducibleComponents ↥(Limits.pullback g (wcEtGeomPt B η)) → ¬ topologicalKrullDim ↥Z₀ ≤ ((0 : ℕ) : WithBot ℕ∞) → ∃ Z : Set ↥(Limits.pullback g (wcEtGeomPt B η)), Z ∈ irreducibleComponents ↥(Limits.pullback g (wcEtGeomPt B η)) ∧ ¬ topologicalKrullDim ↥Z ≤ ((0 : ℕ) : WithBot ℕ∞) ∧ ⇑(Limits.pullback.map g (wcEtGeomPt B η) g (wcEtGeomPt B η) (𝟙 X) τ (𝟙 B) (by simp) (by rw [Category.comp_id, hτ])) '' Z = Z₀ :=
by
  intro X B g η τ hτ
  have key : ∀ (P : Scheme.{u}) (f : P ⟶ P) [IsIso f], Function.Injective ⇑f ∧
      ∀ Z₀ : Set ↥P, Z₀ ∈ irreducibleComponents ↥P →
        ¬ topologicalKrullDim ↥Z₀ ≤ ((0 : ℕ) : WithBot ℕ∞) →
        ∃ Z : Set ↥P, Z ∈ irreducibleComponents ↥P ∧
          ¬ topologicalKrullDim ↥Z ≤ ((0 : ℕ) : WithBot ℕ∞) ∧ ⇑f '' Z = Z₀ := by
    intro P f _
    have e : ⇑(Scheme.Hom.homeomorph f) = ⇑f := funext (Scheme.Hom.homeomorph_apply f)
    have hh : IsHomeomorph ⇑f := by
      have h0 := (Scheme.Hom.homeomorph f).isHomeomorph
      rwa [e] at h0
    refine ⟨hh.injective, fun Z₀ hZ₀ hd => ?_⟩
    have himg : ⇑f '' (⇑f ⁻¹' Z₀) = Z₀ := Set.image_preimage_eq Z₀ hh.surjective
    refine ⟨⇑f ⁻¹' Z₀, ?_, ?_, himg⟩
    · apply preimage_mem_irreducibleComponents_of_isPreirreducible_fiber hZ₀ hh.continuous
        hh.isOpenMap
      · intro x
        apply Set.Subsingleton.isPreirreducible
        intro a ha b hb
        exact hh.injective ((Set.mem_singleton_iff.mp ha).trans (Set.mem_singleton_iff.mp hb).symm)
      · obtain ⟨q, hq⟩ := (show Maximal IsIrreducible Z₀ from hZ₀).prop.nonempty
        obtain ⟨p, rfl⟩ := hh.surjective q
        exact ⟨f p, hq, p, rfl⟩
    · have hset : ⇑(Scheme.Hom.homeomorph f) '' (⇑f ⁻¹' Z₀) = Z₀ := by rw [e]; exact himg
      let eZ : ↥(⇑f ⁻¹' Z₀) ≃ₜ ↥Z₀ :=
        ((Scheme.Hom.homeomorph f).image _).trans (Homeomorph.setCongr hset)
      rwa [IsHomeomorph.topologicalKrullDim_eq eZ eZ.isHomeomorph]
  have hiso : IsIso τ := by
    obtain ⟨φ, rfl⟩ : ∃ φ, Spec.map φ = τ := ⟨_, Spec.map_preimage τ⟩
    have h1 : Spec.map φ ≫ Spec.map (CommRingCat.ofHom (algebraMap (B.residueField η)
        (AlgebraicClosure (B.residueField η)))) = Spec.map (CommRingCat.ofHom
        (algebraMap (B.residueField η) (AlgebraicClosure (B.residueField η)))) := by
      have h := hτ
      simp only [wcEtGeomPt] at h
      rw [← Category.assoc] at h
      exact (cancel_mono _).mp h
    rw [← Spec.map_comp] at h1
    have h2 := Spec.map_injective h1
    have h3 : ∀ r : B.residueField η, φ.hom (algebraMap (B.residueField η)
        (AlgebraicClosure (B.residueField η)) r) =
        algebraMap (B.residueField η) (AlgebraicClosure (B.residueField η)) r := by
      intro r
      have h4 := congrArg (fun k => k.hom r) h2
      simpa using h4
    let ψ : AlgebraicClosure (B.residueField η) →ₐ[B.residueField η]
        AlgebraicClosure (B.residueField η) := { φ.hom with commutes' := h3 }
    have hb : Function.Bijective ψ := Algebra.IsAlgebraic.algHom_bijective ψ
    exact isIso_SpecMap_iff.mpr hb
  haveI := hiso
  exact key _ _

theorem wc_r2gi_geom_fibre_has_curve_component : ∀ (X B : Scheme.{u}) (g : X ⟶ B) [IsProper g] (η : B), ¬ topologicalKrullDim ↥(⇑g ⁻¹' {η}) ≤ ((0 : ℕ) : WithBot ℕ∞) → ∃ Z : Set ↥(Limits.pullback g (wcEtGeomPt B η)), Z ∈ irreducibleComponents ↥(Limits.pullback g (wcEtGeomPt B η)) ∧ ¬ topologicalKrullDim ↥Z ≤ ((0 : ℕ) : WithBot ℕ∞) :=
by
  intro X B g _ η hη
  classical

  have topo : ∀ (P Y : Type u) [TopologicalSpace P] [TopologicalSpace Y] [T0Space P]
      [QuasiSober Y] (f : P → Y), IsClosedMap f → Function.Surjective f →
      0 < topologicalKrullDim Y → ∃ Z : Set P, Z ∈ irreducibleComponents P ∧
        0 < topologicalKrullDim ↥Z := by
    intro P Y _ _ _ _ f hfc hfs hpos
    unfold topologicalKrullDim at hpos
    obtain ⟨C₀, C₁, hlt⟩ := Order.krullDim_pos_iff.mp hpos
    obtain ⟨y₀, hy₀⟩ := QuasiSober.sober C₁.isIrreducible C₁.isClosed
    obtain ⟨y₁, hy₁⟩ := QuasiSober.sober C₀.isIrreducible C₀.isClosed
    have hsub : (C₀ : Set Y) ⊆ C₁ := hlt.le
    have hsp : y₀ ⤳ y₁ := hy₀.specializes (hsub hy₁.mem)
    have hne : y₀ ≠ y₁ := by
      intro h
      apply hlt.ne
      apply TopologicalSpace.IrreducibleCloseds.ext
      rw [← hy₀.def, ← hy₁.def, h]
    obtain ⟨p₀, hp₀⟩ := hfs y₀
    have hcl := (specializingMap_iff_closure_singleton_subset.mp hfc.specializingMap) p₀
    have hy₁mem : y₁ ∈ closure {f p₀} := by
      rw [hp₀]; exact specializes_iff_mem_closure.mp hsp
    obtain ⟨p₁, hp₁c, hp₁⟩ := hcl hy₁mem
    have hpne : p₀ ≠ p₁ := by
      intro h; apply hne; rw [← hp₀, ← hp₁, h]
    obtain ⟨Z, hZ, hZsub⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible _
      (isIrreducible_singleton (x := p₀)).closure
    refine ⟨Z, hZ, ?_⟩
    have h0 : p₀ ∈ Z := hZsub (subset_closure rfl)
    have h1 : p₁ ∈ Z := hZsub hp₁c
    let z₀ : Z := ⟨p₀, h0⟩
    let z₁ : Z := ⟨p₁, h1⟩
    have hz : z₀ ⤳ z₁ := (subtype_specializes_iff z₀ z₁).mpr (specializes_iff_mem_closure.mpr hp₁c)
    let D₀ : TopologicalSpace.IrreducibleCloseds Z :=
      ⟨closure {z₁}, isIrreducible_singleton.closure, isClosed_closure⟩
    let D₁ : TopologicalSpace.IrreducibleCloseds Z :=
      ⟨closure {z₀}, isIrreducible_singleton.closure, isClosed_closure⟩
    have hle : D₀ ≤ D₁ := by
      show (closure {z₁} : Set Z) ⊆ closure {z₀}
      exact specializes_iff_closure_subset.mp hz
    have hne' : D₀ ≠ D₁ := by
      intro h
      have hc : (closure {z₁} : Set Z) = closure {z₀} :=
        congrArg (fun D : TopologicalSpace.IrreducibleCloseds Z => (D : Set Z)) h
      have hmem : z₀ ∈ closure ({z₁} : Set Z) := by
        rw [hc]; exact subset_closure rfl
      have hz' : z₁ ⤳ z₀ := specializes_iff_mem_closure.mpr hmem
      apply hpne
      exact congrArg Subtype.val (hz.antisymm hz').eq
    unfold topologicalKrullDim
