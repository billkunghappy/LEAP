        ((wcR2FreeMap V ((wcEtBaseChange π).op ⋙ (wcEtExtZero B'' S ℓ).obj) γ0).app
          (Opposite.op T')).hom r =
          (((wcEtBaseChange π).op ⋙ (wcEtExtZero B'' S ℓ).obj).map c.op).hom q by
    exact key (AlgebraicClosure (T.left.residueField t)) (wcEtGeomPt T.left t)
      ((Scheme.Hom.comp_apply _ _ _).trans (Scheme.fromSpecResidueField_apply t _))
  intro Ω _ _ tb htb

  let F := {vb : Spec (.of Ω) ⟶ V.left // vb ≫ V.hom = tb ≫ T.hom}
  haveI hFfin : Finite F := by
    haveI := wc_finite_geom_fibre_finite π Ω (tb ≫ T.hom)
    refine Finite.of_injective (β := {zb : Spec (.of Ω) ⟶ B'' // zb ≫ π = tb ≫ T.hom})
      (fun vb => ⟨vb.1 ≫ e, by rw [Category.assoc, heπ, vb.2]⟩) ?_
    intro a b hab
    apply Subtype.ext
    exact (cancel_mono e).mp (congrArg Subtype.val hab)
  obtain ⟨k, ⟨eqv⟩⟩ := Finite.exists_equiv_fin F
  let vbs : Fin k → (Spec (.of Ω) ⟶ V.left) := fun i => (eqv.symm i).1
  have hvbs : ∀ i, vbs i ≫ V.hom = tb ≫ T.hom := fun i => (eqv.symm i).2
  obtain ⟨T', c, tb', g, htb'c, htb'g⟩ := wc_r2gc_geom_multi_lift T V Ω tb k vbs hvbs
  have hH0 : c.left (tb' (IsLocalRing.closedPoint Ω)) = t :=
    (Scheme.Hom.comp_apply tb' c.left _).symm.trans
      ((congrArg (fun f : Spec (.of Ω) ⟶ T.left => f (IsLocalRing.closedPoint Ω)) htb'c).trans htb)
  have hdist : ∀ i j, i ≠ j → wcR2Graph π V e heπ (g i) (tb' (IsLocalRing.closedPoint Ω)) ∉
      Set.range (wcR2Graph π V e heπ (g j)) := by
    intro i j hij hmem
    have h1 := wc_r2gc_graph_point_separation π V e he heπ T' (g i) (g j) Ω tb' hmem
    have h2 : vbs i = vbs j := (htb'g i).symm.trans (h1.trans (htb'g j))
    exact hij (eqv.symm.injective (Subtype.ext h2))
  have hexh : ∀ z : ((wcEtBaseChange π).obj T').left,
      Limits.pullback.fst T'.hom π z = tb' (IsLocalRing.closedPoint Ω) →
      ((wcEtBaseChange π).obj T').hom z ∈ S →
      ∃ i, z = wcR2Graph π V e heπ (g i) (tb' (IsLocalRing.closedPoint Ω)) := by
    intro z hz hzS
    rw [← hS] at hzS
    obtain ⟨zb, hzb1, hzb2⟩ :=
      wc_finite_geom_point_lift Ω (Limits.pullback.fst T'.hom π) tb' z hz
    obtain ⟨vb, hvb, hall⟩ := wc_r2gc_graph_point_exhaust π V e he heπ T' Ω tb' zb hzb1
      (by rw [hzb2]; exact hzS)
    have hvbF : vb ≫ V.hom = tb ≫ T.hom :=
      hvb.trans (by rw [← MorphismProperty.Over.w c, ← Category.assoc, htb'c])
    refine ⟨eqv ⟨vb, hvbF⟩, ?_⟩
    have h3 := hall (g (eqv ⟨vb, hvbF⟩))
      ((htb'g _).trans (congrArg Subtype.val (eqv.symm_apply_apply ⟨vb, hvbF⟩)))
    exact hzb2.symm.trans h3

  let q' : (wcEtExtZero B'' S ℓ).obj.obj (Opposite.op ((wcEtBaseChange π).obj T')) :=
    ((wcEtExtZero B'' S ℓ).obj.map ((wcEtBaseChange π).map c).op).hom q
  choose W₀ h₀ w₀ y₀ hw₀ hq₀ _hz₀ using fun i : Fin k =>
    wc_r2gc_section_locally_pre B'' S ℓ ((wcEtBaseChange π).obj T') q'
      (wcR2Graph π V e heπ (g i) (tb' (IsLocalRing.closedPoint Ω)))
  choose n hn using fun i : Fin k => ZMod.intCast_surjective ((y₀ i).1.down)
  let r : FreeAbelianGroup (ULift.{u+1} (T' ⟶ V)) :=
    ∑ i, n i • FreeAbelianGroup.of (ULift.up (g i))
  let γ : Fin k → (wcEtExtZero B'' S ℓ).obj.obj (Opposite.op ((wcEtBaseChange π).obj T')) :=
    fun i => ((wcEtExtZero B'' S ℓ).obj.map ((wcEtBaseChange π).map (g i)).op).hom γ0
  have hκr : ((wcR2FreeMap V ((wcEtBaseChange π).op ⋙ (wcEtExtZero B'' S ℓ).obj) γ0).app
      (Opposite.op T')).hom r = ∑ i, n i • γ i := by
    show FreeAbelianGroup.lift _ r = _
    simp only [r, map_sum, map_zsmul, FreeAbelianGroup.lift_apply_of]
    rfl
  obtain ⟨δ, hδ⟩ : ∃ δ : (wcEtExtZero B'' S ℓ).obj.obj (Opposite.op ((wcEtBaseChange π).obj T')),
      δ = ∑ i, n i • γ i - q' := ⟨_, rfl⟩
  have hA : ∀ j, IsClopen (Set.range (wcR2Graph π V e heπ (g j))) := fun j => by
    obtain ⟨h1, h2, -, -⟩ := wc_r2gc_graph_basic π V e he heπ T' T' (g j) (𝟙 T')
    haveI := h1
    exact ⟨h2, IsOpenImmersion.isOpen_range _⟩
  have hcomp : ∀ {W₁ W₂ : B''.Etale} (a : W₁ ⟶ W₂) (b : W₂ ⟶ (wcEtBaseChange π).obj T')
      (x : (wcEtExtZero B'' S ℓ).obj.obj (Opposite.op ((wcEtBaseChange π).obj T'))),
      ((wcEtExtZero B'' S ℓ).obj.map (a ≫ b).op).hom x =
        ((wcEtExtZero B'' S ℓ).obj.map a.op).hom (((wcEtExtZero B'' S ℓ).obj.map b.op).hom x) := by
    intro W₁ W₂ a b x
    rw [op_comp, Functor.map_comp]
    rfl
  have hnat : ∀ {W₁ W₂ : B''.Etale} (a : W₁ ⟶ W₂) (y : (wcEtExtZeroPre B'' S ℓ).obj (Opposite.op W₂)),
      ((wcEtExtZero B'' S ℓ).obj.map a.op).hom
        (((toSheafify (Scheme.smallEtaleTopology B'') (wcEtExtZeroPre B'' S ℓ)).app
          (Opposite.op W₂)).hom y) =
      ((toSheafify (Scheme.smallEtaleTopology B'') (wcEtExtZeroPre B'' S ℓ)).app
          (Opposite.op W₁)).hom (((wcEtExtZeroPre B'' S ℓ).map a.op).hom y) := by
    intro W₁ W₂ a y
    exact (congrArg (fun φ => φ.hom y)
      ((toSheafify (Scheme.smallEtaleTopology B'') (wcEtExtZeroPre B'' S ℓ)).naturality a.op)).symm
  have hLZ : ∀ z : ((wcEtBaseChange π).obj T').left,
      Limits.pullback.fst T'.hom π z = tb' (IsLocalRing.closedPoint Ω) →
      ∃ (V₁ : B''.Etale) (c₁ : V₁ ⟶ (wcEtBaseChange π).obj T'), z ∈ Set.range c₁.left ∧
        (wcEtExtZero B'' S ℓ).obj.map c₁.op δ = 0 := by
    intro z hz
    by_cases hzS : ((wcEtBaseChange π).obj T').hom z ∈ S
    · obtain ⟨i, rfl⟩ := hexh z hz hzS
      obtain ⟨W, h, w, hw, hcl⟩ := wc_et_clopen_family_shrink ((wcEtBaseChange π).obj T') (W₀ i)
        (h₀ i) (w₀ i) k (fun j => Set.range (wcR2Graph π V e heπ (g j))) hA
      refine ⟨W, h ≫ h₀ i, ⟨w, ?_⟩, ?_⟩
      · exact (Scheme.Hom.comp_apply h.left (h₀ i).left w).trans (by rw [hw, hw₀ i])
      · have hcl_i : Set.range (h ≫ h₀ i).left ⊆ Set.range (wcR2Graph π V e heπ (g i)) :=
          (hcl i).1 (by rw [hw₀ i]; exact ⟨_, rfl⟩)
        obtain ⟨y', hy'1, hy'2⟩ := (hγ T' (g i) W (h ≫ h₀ i)).1 hcl_i
        have hy'3 : ((wcEtExtZero B'' S ℓ).obj.map (h ≫ h₀ i).op).hom (γ i) =
            ((toSheafify (Scheme.smallEtaleTopology B'') (wcEtExtZeroPre B'' S ℓ)).app
              (Opposite.op W)).hom y' := hy'2
        have hoff : ∀ j, j ≠ i → ((wcEtExtZero B'' S ℓ).obj.map (h ≫ h₀ i).op).hom (γ j) = 0 := by
          intro j hj
          apply (hγ T' (g j) W (h ≫ h₀ i)).2
          apply (hcl j).2
          rw [hw₀ i]
          exact hdist i j (Ne.symm hj)
        have hq' : ((wcEtExtZero B'' S ℓ).obj.map (h ≫ h₀ i).op).hom q' =
            ((toSheafify (Scheme.smallEtaleTopology B'') (wcEtExtZeroPre B'' S ℓ)).app
              (Opposite.op W)).hom (((wcEtExtZeroPre B'' S ℓ).map h.op).hom (y₀ i)) := by
          rw [hcomp, hq₀ i, hnat]
        have hzero : n i • y' - ((wcEtExtZeroPre B'' S ℓ).map h.op).hom (y₀ i) = 0 := by
          apply Subtype.ext
          apply ULift.ext
          change n i • (y'.1.down) - (y₀ i).1.down = 0
          rw [hy'1]
          change n i • (1 : ZMod ℓ) - (y₀ i).1.down = 0
          rw [zsmul_one, hn i, sub_self]
        show ((wcEtExtZero B'' S ℓ).obj.map (h ≫ h₀ i).op).hom δ = 0
        rw [hδ, map_sub, map_sum]
        simp only [map_zsmul]
        rw [Finset.sum_eq_single i (fun j _ hj => by rw [hoff j hj, smul_zero])
          (fun hi => absurd (Finset.mem_univ i) hi), hy'3, hq']
        have key : ((toSheafify (Scheme.smallEtaleTopology B'') (wcEtExtZeroPre B'' S ℓ)).app
            (Opposite.op W)).hom (n i • y' - ((wcEtExtZeroPre B'' S ℓ).map h.op).hom (y₀ i)) = 0 := by
          rw [hzero, map_zero]
        rw [map_sub, map_zsmul] at key
        exact key
    · obtain ⟨W₁, h₁, w₁, y₁, hw₁, hq₁, hy₁⟩ :=
        wc_r2gc_section_locally_pre B'' S ℓ ((wcEtBaseChange π).obj T') q' z
      have hy₁0 := hy₁ hzS
      have hnot : ∀ j, h₁.left w₁ ∉ Set.range (wcR2Graph π V e heπ (g j)) := by
        rintro j ⟨x, hx⟩
        apply hzS
        have h5 := (wc_r2gc_graph_basic π V e he heπ T' T' (g j) (𝟙 T')).2.2.1 x
        rw [hx, hw₁, hS] at h5
        exact h5
      obtain ⟨W, h, w, hw, hcl⟩ := wc_et_clopen_family_shrink ((wcEtBaseChange π).obj T') W₁
        h₁ w₁ k (fun j => Set.range (wcR2Graph π V e heπ (g j))) hA
      refine ⟨W, h ≫ h₁, ⟨w, ?_⟩, ?_⟩
      · exact (Scheme.Hom.comp_apply h.left h₁.left w).trans (by rw [hw, hw₁])
      · have hoff : ∀ j, ((wcEtExtZero B'' S ℓ).obj.map (h ≫ h₁).op).hom (γ j) = 0 :=
          fun j => (hγ T' (g j) W (h ≫ h₁)).2 ((hcl j).2 (hnot j))
        have hq' : ((wcEtExtZero B'' S ℓ).obj.map (h ≫ h₁).op).hom q' = 0 := by
          rw [hcomp, hq₁, hy₁0, map_zero]
          exact map_zero ((wcEtExtZero B'' S ℓ).obj.map h.op).hom
        show ((wcEtExtZero B'' S ℓ).obj.map (h ≫ h₁).op).hom δ = 0
        rw [hδ, map_sub, map_sum]
        simp only [map_zsmul, hoff, smul_zero, Finset.sum_const_zero, hq', sub_zero]

  obtain ⟨W, hW, hWδ⟩ := wc_finite_fibre_vanishing_zariski_nbhd π (wcEtExtZero B'' S ℓ)
    (fun O g => wc_etale_section_vanishing_open B'' (wcEtExtZero B'' S ℓ) O g) T' δ
    (tb' (IsLocalRing.closedPoint Ω)) hLZ
  refine ⟨wcEtOpen B T' W, wcEtOpenι B T' W ≫ c, (⟨tb' (IsLocalRing.closedPoint Ω), hW⟩ : W),
    ((wcFTKU V).map (wcEtOpenι B T' W).op).hom r, ?_, ?_⟩
  · exact (Scheme.Hom.comp_apply W.ι c.left _).trans
      ((congrArg c.left (Scheme.Opens.ι_apply W _)).trans hH0)
  · have nat := congrArg (fun φ => φ.hom r)
      ((wcR2FreeMap V ((wcEtBaseChange π).op ⋙ (wcEtExtZero B'' S ℓ).obj) γ0).naturality
        (wcEtOpenι B T' W).op)
    refine nat.trans ?_
    have e2 : ((wcEtExtZero B'' S ℓ).obj.map
        ((wcEtBaseChange π).map (wcEtOpenι B T' W)).op).hom (∑ j, n j • γ j) =
        ((wcEtExtZero B'' S ℓ).obj.map
          ((wcEtBaseChange π).map (wcEtOpenι B T' W)).op).hom q' := by
      have h := hWδ
      rw [hδ, map_sub, sub_eq_zero] at h
      exact h
    have e3 : ((wcEtExtZero B'' S ℓ).obj.map
        ((wcEtBaseChange π).map (wcEtOpenι B T' W)).op).hom q' =
        (((wcEtBaseChange π).op ⋙ (wcEtExtZero B'' S ℓ).obj).map
          (wcEtOpenι B T' W ≫ c).op).hom q := by
      show _ = ((wcEtExtZero B'' S ℓ).obj.map
        ((wcEtBaseChange π).map (wcEtOpenι B T' W ≫ c)).op).hom q
      rw [Functor.map_comp, op_comp, Functor.map_comp]
      rfl
    calc _ = ((wcEtExtZero B'' S ℓ).obj.map
          ((wcEtBaseChange π).map (wcEtOpenι B T' W)).op).hom (∑ j, n j • γ j) := by
          show ((wcEtExtZero B'' S ℓ).obj.map
            ((wcEtBaseChange π).map (wcEtOpenι B T' W)).op).hom
              (((wcR2FreeMap V ((wcEtBaseChange π).op ⋙ (wcEtExtZero B'' S ℓ).obj) γ0).app
                (Opposite.op T')).hom r) = _
          rw [hκr]
      _ = _ := e2.trans e3

theorem wc_r2gc_kernel_local : ∀ {B B'' : Scheme.{u}} (π : B'' ⟶ B) [IsFinite π] (V : B.Etale) (e : V.left ⟶ B''), IsOpenImmersion e → ∀ (heπ : e ≫ π = V.hom) (S : Set B'') (ℓ : ℕ) (γ0 : (wcEtExtZero B'' S ℓ).obj.obj (Opposite.op ((wcEtBaseChange π).obj V))), wcR2GraphInd π V e heπ S ℓ γ0 → ∀ (T : B.Etale) (r : (wcFTKU V).obj (Opposite.op T)), ((wcR2FreeMap V ((wcEtBaseChange π).op ⋙ (wcEtExtZero B'' S ℓ).obj) γ0).app (Opposite.op T)).hom r = 0 → ∀ t : T.left, ∃ (T' : B.Etale) (c : T' ⟶ T) (t' : T'.left) (y : (wcFTKU V).obj (Opposite.op T')), c.left t' = t ∧ ((wcFTKU V).map c.op).hom r = ℓ • y :=
by
  intro B B'' π _ V e he heπ S ℓ γ0 hγ T r hr t
  classical
  haveI := he

  have hEtArr : ∀ (A A' : B.Etale) (c : A ⟶ A'), Etale c.left := by
    intro A A' c
    have hw : c.left ≫ A'.hom = A.hom := MorphismProperty.Over.w c
    have h1 : Etale A'.hom := A'.prop
    have h2 : Etale (c.left ≫ A'.hom) := by rw [hw]; exact A.prop
    exact Etale.of_comp c.left A'.hom

  have hcovR : ∀ (W : B''.Etale) (R : Sieve W), R ∈ Scheme.smallEtaleTopology B'' W →
      ∀ w : W.left, ∃ (V₁ : B''.Etale) (c : V₁ ⟶ W), R.arrows c ∧ w ∈ Set.range c.left := by
    intro W R hR w
    change R ∈ Scheme.smallGrothendieckTopology @Etale B'' W at hR
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B''
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
    obtain ⟨V₁, c, y, hc, _, hy⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B''
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hR w
    exact ⟨V₁, c, hc, y, hy⟩

  have rigid : ∀ (W : B''.Etale) (w : W.left) (y : (wcEtExtZeroPre B'' S ℓ).obj (Opposite.op W))
      (N : ℤ), y.1 = ULift.up 1 →
      N • ((toSheafify (Scheme.smallEtaleTopology B'') (wcEtExtZeroPre B'' S ℓ)).app
        (Opposite.op W)).hom y = 0 → (ℓ : ℤ) ∣ N := by
    intro W w y N hy hN
    have hx : ((toSheafify (Scheme.smallEtaleTopology B'') (wcEtExtZeroPre B'' S ℓ)).app
        (Opposite.op W)).hom (N • y) = 0 := by
      rw [map_zsmul]; exact hN
    haveI := Presheaf.isLocallyInjective_toSheafify' (Scheme.smallEtaleTopology B'')
      (wcEtExtZeroPre B'' S ℓ)
    have hmem := Presheaf.equalizerSieve_mem (Scheme.smallEtaleTopology B'')
      (toSheafify (Scheme.smallEtaleTopology B'') (wcEtExtZeroPre B'' S ℓ)) (N • y) 0
      (by rw [map_zero]; exact hx)
    obtain ⟨V₁, c, hc, _⟩ := hcovR W _ hmem w
    rw [Presheaf.equalizerSieve_apply, map_zero] at hc
    have hz : N • y = 0 := by
      have h' := congrArg Subtype.val hc
      exact Subtype.ext h'
    have h3 : N • (1 : ZMod ℓ) = 0 := by
      have h4 : (N • y).1.down = (0 : (wcEtExtZeroPre B'' S ℓ).obj (Opposite.op W)).1.down := by
        rw [hz]
      have h5 : (N • y).1.down = N • y.1.down := rfl
      rw [h5, hy] at h4
      exact h4
    rw [zsmul_one] at h3
    exact (ZMod.intCast_zmod_eq_zero_iff_dvd N ℓ).mp h3

  have hG1 : ∀ g : T ⟶ V, (wcR2Graph π V e heπ g : T.left ⟶ Limits.pullback T.hom π) ≫
      Limits.pullback.fst T.hom π = 𝟙 T.left := by
    intro g
    unfold wcR2Graph
    exact Limits.pullback.lift_fst _ _ _
  have hG2 : ∀ g : T ⟶ V, (wcR2Graph π V e heπ g : T.left ⟶ Limits.pullback T.hom π) ≫
      Limits.pullback.snd T.hom π = g.left ≫ e := by
    intro g
    unfold wcR2Graph
    exact Limits.pullback.lift_snd _ _ _

  have memι : ∀ (U : T.left.Opens) (z : U), U.ι z ∈ U := by
    intro U z
    show U.ι z ∈ (U : Set T.left)
    rw [← Scheme.Opens.range_ι U]
    exact ⟨z, rfl⟩
  have dichG : ∀ (Γ₁ Γ₂ : T.left ⟶ Limits.pullback T.hom π) (a₁ a₂ : T.left ⟶ V.left),
      IsOpenImmersion Γ₂ → IsClosed (Set.range Γ₂) →
      Γ₁ ≫ Limits.pullback.fst T.hom π = 𝟙 T.left → Γ₂ ≫ Limits.pullback.fst T.hom π = 𝟙 T.left →
      Γ₁ ≫ Limits.pullback.snd T.hom π = a₁ ≫ e → Γ₂ ≫ Limits.pullback.snd T.hom π = a₂ ≫ e →
      ∃ O : T.left.Opens, t ∈ O ∧
        (O.ι ≫ a₁ = O.ι ≫ a₂ ∨ ∀ x : T.left, x ∈ O → Γ₁ x ∉ Set.range Γ₂) := by
    intro Γ₁ Γ₂ a₁ a₂ hopen hclosed h11 h21 h12 h22
    haveI := hopen
    by_cases hmem : Γ₁ t ∈ Set.range Γ₂
    · let O : T.left.Opens := ⟨Γ₁ ⁻¹' Set.range Γ₂,
        (IsOpenImmersion.isOpen_range Γ₂).preimage Γ₁.continuous⟩
      refine ⟨O, hmem, Or.inl ?_⟩
      have hsub : Set.range (O.ι ≫ Γ₁) ⊆ Set.range Γ₂ := by
        rintro _ ⟨z, rfl⟩
        rw [Scheme.Hom.comp_apply]
        exact memι O z
      have hfac := IsOpenImmersion.lift_fac Γ₂ (O.ι ≫ Γ₁) hsub
      have hψ : IsOpenImmersion.lift Γ₂ (O.ι ≫ Γ₁) hsub = O.ι := by
        have h := congrArg (fun k => k ≫ Limits.pullback.fst T.hom π) hfac
        simp only [Category.assoc, h21, h11, Category.comp_id] at h
        exact h
      rw [hψ] at hfac
      have h := congrArg (fun k => k ≫ Limits.pullback.snd T.hom π) hfac
      simp only [Category.assoc, h22, h12] at h
      rw [← Category.assoc, ← Category.assoc] at h
      exact ((cancel_mono e).mp h).symm
    · let O : T.left.Opens := ⟨Γ₁ ⁻¹' (Set.range Γ₂)ᶜ,
        hclosed.isOpen_compl.preimage Γ₁.continuous⟩
      exact ⟨O, hmem, Or.inr (fun x hx => hx)⟩

  have gs1 : ∀ {S X Y B'' : Scheme.{u}} (t : X ⟶ S) (v : Y ⟶ S) [Etale v] (π : B'' ⟶ S)
      (e : Y ⟶ B'') [IsOpenImmersion e], e ≫ π = v → ∀ (a : X ⟶ Y), a ≫ v = t →
      ∀ (Γ : X ⟶ Limits.pullback t π), Γ ≫ Limits.pullback.fst t π = 𝟙 X →
        Γ ≫ Limits.pullback.snd t π = a ≫ e → IsOpenImmersion Γ := by
    intro S X Y B'' t v _ π e _ heπ a ha Γ hΓ1 hΓ2
    subst ha
    have hd : IsOpenImmersion (Limits.pullback.diagonal v) :=
      FormallyUnramified.isOpenImmersion_diagonal v
    have hσ : IsOpenImmersion (Limits.pullback.lift (𝟙 X) a (by simp) :
        X ⟶ Limits.pullback (a ≫ v) v) :=
      MorphismProperty.of_isPullback (P := @IsOpenImmersion)
        (Limits.pullback_lift_diagonal_isPullback a v) hd
    obtain ⟨m, hm1, hm2⟩ : ∃ m : Limits.pullback (a ≫ v) v ⟶ Limits.pullback (a ≫ v) π,
        m ≫ Limits.pullback.fst (a ≫ v) π = Limits.pullback.fst (a ≫ v) v ∧
        m ≫ Limits.pullback.snd (a ≫ v) π = Limits.pullback.snd (a ≫ v) v ≫ e :=
      ⟨Limits.pullback.lift (Limits.pullback.fst (a ≫ v) v) (Limits.pullback.snd (a ≫ v) v ≫ e)
        (by rw [Limits.pullback.condition, Category.assoc, heπ]),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have hsq : IsPullback m (Limits.pullback.snd (a ≫ v) v) (Limits.pullback.snd (a ≫ v) π) e := by
      refine IsPullback.of_right (h₁₂ := Limits.pullback.fst (a ≫ v) π) (v₁₃ := a ≫ v)
        (h₂₂ := π) ?_ hm2 (IsPullback.of_hasPullback (a ≫ v) π)
      rw [hm1, heπ]
      exact IsPullback.of_hasPullback (a ≫ v) v
    have hm : IsOpenImmersion m :=
      MorphismProperty.of_isPullback (P := @IsOpenImmersion) hsq.flip ‹IsOpenImmersion e›
    have heq : Γ = (Limits.pullback.lift (𝟙 X) a (by simp) :
        X ⟶ Limits.pullback (a ≫ v) v) ≫ m := by
      apply Limits.pullback.hom_ext
      · rw [hΓ1, Category.assoc, hm1, Limits.pullback.lift_fst]
      · rw [hΓ2, Category.assoc, hm2, ← Category.assoc, Limits.pullback.lift_snd]
    rw [heq]
    exact IsOpenImmersion.comp _ _
  have gs2 : ∀ {S X B'' : Scheme.{u}} (t : X ⟶ S) (π : B'' ⟶ S) [IsFinite π]
      (Γ : X ⟶ Limits.pullback t π), Γ ≫ Limits.pullback.fst t π = 𝟙 X →
        IsClosed (Set.range Γ) := by
    intro S X B'' t π _ Γ hΓ
    have : IsClosedImmersion (Γ ≫ Limits.pullback.fst t π) := by rw [hΓ]; infer_instance
    have : IsClosedImmersion Γ := IsClosedImmersion.of_comp Γ (Limits.pullback.fst t π)
    exact Γ.isClosedEmbedding.isClosed_range
  have dich : ∀ g₁ g₂ : T ⟶ V, ∃ O : T.left.Opens, t ∈ O ∧
      (O.ι ≫ g₁.left = O.ι ≫ g₂.left ∨ ∀ x : T.left, x ∈ O →
        wcR2Graph π V e heπ g₁ x ∉ Set.range (wcR2Graph π V e heπ g₂)) := by
    intro g₁ g₂
    haveI : Etale V.hom := V.prop
    have hw : g₂.left ≫ V.hom = T.hom := MorphismProperty.Over.w g₂
    have hopen := gs1 T.hom V.hom π e heπ g₂.left hw _ (hG1 g₂) (hG2 g₂)
    have hclosed := gs2 T.hom π _ (hG1 g₂)
    exact dichG _ _ g₁.left g₂.left hopen hclosed (hG1 g₁) (hG1 g₂) (hG2 g₁) (hG2 g₂)

  obtain ⟨q, hq⟩ : ∃ q : FreeAbelianGroup (ULift.{u+1} (T ⟶ V)), q = r := ⟨r, rfl⟩
  subst hq
  have hrep : q = ∑ a ∈ (FreeAbelianGroup.toFinsupp q).support,
      (FreeAbelianGroup.toFinsupp q) a • FreeAbelianGroup.of a := by
    conv_lhs => rw [← Finsupp.toFreeAbelianGroup_toFinsupp q,
      ← Finsupp.sum_single (FreeAbelianGroup.toFinsupp q)]
    rw [map_finsuppSum]
    simp only [Finsupp.toFreeAbelianGroup_single]
    rfl
  generalize FreeAbelianGroup.toFinsupp q = n at hrep
  let φ : ULift.{u+1} (T ⟶ V) →
      (wcEtExtZero B'' S ℓ).obj.obj (Opposite.op ((wcEtBaseChange π).obj T)) :=
    fun g => ((wcEtExtZero B'' S ℓ).obj.map ((wcEtBaseChange π).map g.down).op).hom γ0
  have hr' : FreeAbelianGroup.lift φ q = 0 := hr
  have hsum : ∑ g ∈ n.support, n g • φ g = 0 := by
    have h := hr'
    rw [hrep, map_sum] at h
    simpa only [map_zsmul, FreeAbelianGroup.lift_apply_of] using h

  choose Op hOpt hOp using fun p : ULift.{u+1} (T ⟶ V) × ULift.{u+1} (T ⟶ V) =>
    dich p.1.down p.2.down
  let O : T.left.Opens := ⟨⋂ p ∈ n.support ×ˢ n.support, (Op p : Set T.left),
    isOpen_biInter_finset (fun p _ => (Op p).isOpen)⟩
  have ht : t ∈ O := by
    show t ∈ ⋂ p ∈ n.support ×ˢ n.support, (Op p : Set T.left)
    exact Set.mem_iInter₂.mpr (fun p _ => hOpt p)
  have hpair : ∀ g₁ ∈ n.support, ∀ g₂ ∈ n.support,
      O.ι ≫ g₁.down.left = O.ι ≫ g₂.down.left ∨ ∀ x : T.left, x ∈ O →
        wcR2Graph π V e heπ g₁.down x ∉ Set.range (wcR2Graph π V e heπ g₂.down) := by
    intro g₁ h₁ g₂ h₂
    have hp : (g₁, g₂) ∈ n.support ×ˢ n.support := Finset.mem_product.mpr ⟨h₁, h₂⟩
    have hle : O ≤ Op (g₁, g₂) := by
      intro x hx
      exact Set.mem_iInter₂.mp
        (show x ∈ ⋂ p ∈ n.support ×ˢ n.support, (Op p : Set T.left) from hx) (g₁, g₂) hp
    rcases hOp (g₁, g₂) with hc | hd
    · left
      have hc' : (Op (g₁, g₂)).ι ≫ g₁.down.left = (Op (g₁, g₂)).ι ≫ g₂.down.left := hc
      rw [← Scheme.homOfLE_ι T.left hle, Category.assoc, Category.assoc, hc']
    · right
      intro x hx
      exact hd x (hle hx)

  let c : wcEtOpen B T O ⟶ T := wcEtOpenι B T O
  let f : ULift.{u+1} (T ⟶ V) → ULift.{u+1} (wcEtOpen B T O ⟶ V) :=
    fun g => ULift.up (c ≫ g.down)
  have hf : ∀ g g' : ULift.{u+1} (T ⟶ V),
      f g = f g' ↔ O.ι ≫ g.down.left = O.ι ≫ g'.down.left := by
    intro g g'
    constructor
    · intro hgg
      have h1 : c ≫ g.down = c ≫ g'.down := congrArg ULift.down hgg
      have h2 := congrArg (fun k => k.left) h1
      exact h2
    · intro hgg
      show ULift.up (c ≫ g.down) = ULift.up (c ≫ g'.down)
      congr 1
      apply MorphismProperty.Over.Hom.ext
      exact hgg
  have assoc' : ∀ {X Y Z W : Scheme.{u}} (f₁ : X ⟶ Y) (f₂ : Y ⟶ Z) (f₃ : Z ⟶ W),
      (f₁ ≫ f₂) ≫ f₃ = f₁ ≫ f₂ ≫ f₃ := fun f₁ f₂ f₃ => Category.assoc f₁ f₂ f₃

  have hclass : ∀ a₀ ∈ n.support, (ℓ : ℤ) ∣ ∑ g ∈ n.support with f g = f a₀, n g := by
    intro a₀ ha₀
    haveI : Etale a₀.down.left := hEtArr T V a₀.down
    let W : B''.Etale := MorphismProperty.Over.mk ⊤ (O.ι ≫ a₀.down.left ≫ e) (by infer_instance)
    have hW : (O.ι ≫ wcR2Graph π V e heπ a₀.down) ≫ ((wcEtBaseChange π).obj T).hom =
        W.hom :=
      (assoc' O.ι (wcR2Graph π V e heπ a₀.down) (Limits.pullback.snd T.hom π)).trans
        (congrArg (fun k => O.ι ≫ k) (hG2 a₀.down))
    let h : W ⟶ (wcEtBaseChange π).obj T :=
      MorphismProperty.Over.homMk (O.ι ≫ wcR2Graph π V e heπ a₀.down) hW trivial
    let ρ := ((wcEtExtZero B'' S ℓ).obj.map h.op).hom
    obtain ⟨y₀, hy₀, -⟩ := (hγ T a₀.down W h).1 (by
      rintro _ ⟨z, rfl⟩
      exact ⟨O.ι z, (Scheme.Hom.comp_apply O.ι (wcR2Graph π V e heπ a₀.down) z).symm⟩)
    have hin : ∀ g ∈ n.support, f g = f a₀ → ρ (φ g) =
        ((toSheafify (Scheme.smallEtaleTopology B'') (wcEtExtZeroPre B'' S ℓ)).app
          (Opposite.op W)).hom y₀ := by
      intro g _ hfg
      have hcl : O.ι ≫ g.down.left = O.ι ≫ a₀.down.left := (hf g a₀).mp hfg
      have hmid : O.ι ≫ g.down.left ≫ e = O.ι ≫ a₀.down.left ≫ e := by
        rw [← Category.assoc, hcl, Category.assoc]
      have heqΓ : O.ι ≫ (wcR2Graph π V e heπ g.down : T.left ⟶ Limits.pullback T.hom π) =
          O.ι ≫ (wcR2Graph π V e heπ a₀.down : T.left ⟶ Limits.pullback T.hom π) := by
        apply Limits.pullback.hom_ext
        · exact (assoc' _ _ _).trans ((congrArg (fun k => O.ι ≫ k) (hG1 g.down)).trans
            ((congrArg (fun k => O.ι ≫ k) (hG1 a₀.down)).symm.trans (assoc' _ _ _).symm))
        · exact (assoc' _ _ _).trans ((congrArg (fun k => O.ι ≫ k) (hG2 g.down)).trans
            (hmid.trans ((congrArg (fun k => O.ι ≫ k) (hG2 a₀.down)).symm.trans
              (assoc' _ _ _).symm)))
      obtain ⟨y, hy, hEy⟩ := (hγ T g.down W h).1 (by
        rintro _ ⟨z, rfl⟩
        refine ⟨O.ι z, ?_⟩
        have hz := congrArg (fun k => k z) heqΓ
        exact (Scheme.Hom.comp_apply O.ι (wcR2Graph π V e heπ g.down) z).symm.trans hz)
      have hyy : y = y₀ := Subtype.ext (hy.trans hy₀.symm)
      rw [← hyy]
      exact hEy
    have hout : ∀ g ∈ n.support, ¬ f g = f a₀ → ρ (φ g) = 0 := by
      intro g hg hfg
      rcases hpair a₀ ha₀ g hg with hc | hd
      · exact absurd ((hf g a₀).mpr hc.symm) hfg
      · apply (hγ T g.down W h).2
        rintro _ ⟨z, rfl⟩
        have hz : h.left z = wcR2Graph π V e heπ a₀.down (O.ι z) :=
          Scheme.Hom.comp_apply O.ι (wcR2Graph π V e heπ a₀.down) z
        rw [hz]
        exact hd (O.ι z) (memι O z)
    have h1 : ∑ g ∈ n.support, n g • ρ (φ g) = 0 := by
      have h := congrArg ρ hsum
      rw [map_sum, map_zero] at h
      simpa only [map_zsmul] using h
    have hA : ∑ g ∈ n.support with ¬ f g = f a₀, n g • ρ (φ g) = 0 :=
      Finset.sum_eq_zero (fun g hg => by
        rw [Finset.mem_filter] at hg
        rw [hout g hg.1 hg.2, smul_zero])
    have hB : ∑ g ∈ n.support with f g = f a₀, n g • ρ (φ g) =
        (∑ g ∈ n.support with f g = f a₀, n g) •
          ((toSheafify (Scheme.smallEtaleTopology B'') (wcEtExtZeroPre B'' S ℓ)).app
            (Opposite.op W)).hom y₀ := by
      rw [Finset.sum_smul]
      exact Finset.sum_congr rfl (fun g hg =>
        congrArg (fun x => n g • x) (hin g (Finset.mem_filter.mp hg).1 (Finset.mem_filter.mp hg).2))
    rw [← Finset.sum_filter_add_sum_filter_not n.support (fun g => f g = f a₀), hA, add_zero,
      hB] at h1
    exact rigid W (⟨t, ht⟩ : O) y₀ _ hy₀ h1

  have hmap : FreeAbelianGroup.map f q = ∑ a ∈ n.support, n a • FreeAbelianGroup.of (f a) := by
    conv_lhs => rw [hrep]
    rw [map_sum]
    simp only [map_zsmul, FreeAbelianGroup.map_of_apply]
  refine ⟨wcEtOpen B T O, c, (⟨t, ht⟩ : O),
    ∑ b ∈ n.support.image f, ((∑ a ∈ n.support with f a = b, n a) / (ℓ : ℤ)) •
      FreeAbelianGroup.of b, Scheme.Opens.ι_apply O ⟨t, ht⟩, ?_⟩
  show FreeAbelianGroup.map f q = (ℓ • (∑ b ∈ n.support.image f,
    ((∑ a ∈ n.support with f a = b, n a) / (ℓ : ℤ)) • FreeAbelianGroup.of b) :
      FreeAbelianGroup (ULift.{u+1} (wcEtOpen B T O ⟶ V)))
  rw [hmap, ← Finset.sum_fiberwise_of_maps_to (s := n.support) (t := n.support.image f) (g := f)
    (fun a ha => Finset.mem_image_of_mem f ha), Finset.smul_sum]
  refine Finset.sum_congr rfl (fun b hb => ?_)
  obtain ⟨a₀, ha₀, rfl⟩ := Finset.mem_image.mp hb
  rw [← natCast_zsmul, smul_smul, Int.mul_ediv_cancel' (hclass a₀ ha₀), Finset.sum_smul]
  refine Finset.sum_congr (by ext a; simp only [Finset.mem_filter]) (fun a ha => ?_)
  rw [Finset.mem_filter] at ha
  rw [ha.2]

theorem wc_r2gc_factor_through_sheafify : ∀ {B : Scheme.{u}} (P Q : (B.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (κ₀ : P ⟶ Q) (ℓ : ℕ) (F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}), ℓ • 𝟙 F = 0 → (∀ (T : B.Etale) (q : Q.obj (Opposite.op T)) (t : T.left), ∃ (T' : B.Etale) (c : T' ⟶ T) (t' : T'.left) (r : P.obj (Opposite.op T')), c.left t' = t ∧ (κ₀.app (Opposite.op T')).hom r = (Q.map c.op).hom q) → (∀ (T : B.Etale) (r : P.obj (Opposite.op T)), (κ₀.app (Opposite.op T)).hom r = 0 → ∀ t : T.left, ∃ (T' : B.Etale) (c : T' ⟶ T) (t' : T'.left) (y : P.obj (Opposite.op T')), c.left t' = t ∧ (P.map c.op).hom r = ℓ • y) → ∀ ψ₀ : P ⟶ F.obj, ∃ φ : (presheafToSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj Q ⟶ F, ∀ (T : B.Etale) (r : P.obj (Opposite.op T)), (φ.hom.app (Opposite.op T)).hom (((toSheafify (Scheme.smallEtaleTopology B) Q).app (Opposite.op T)).hom ((κ₀.app (Opposite.op T)).hom r)) = (ψ₀.app (Opposite.op T)).hom r :=
by
  intro B P Q κ₀ ℓ F htor hLS hKL ψ₀
  classical

  have hcov : ∀ (V : B.Etale) (R : Sieve V), R ∈ Scheme.smallEtaleTopology B V →
      ∀ x : V.left, ∃ (V₁ : B.Etale) (c : V₁ ⟶ V) (y : V₁.left), R.arrows c ∧ c.left y = x := by
    intro V R hR x
    change R ∈ Scheme.smallGrothendieckTopology @Etale B V at hR
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
    obtain ⟨V₁, c, y, hc, -, hy⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hR x
    exact ⟨V₁, c, y, hc, hy⟩
  have hcov' : ∀ (V : B.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : B.Etale) (c : V₁ ⟶ V),
      S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology B V := by
    intro V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale B V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩

  let ψ : (presheafToSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj P ⟶ F :=
    ⟨sheafifyLift (Scheme.smallEtaleTopology B) ψ₀ F.cond⟩
  have hψ : ∀ (T : B.Etale) (r : P.obj (Opposite.op T)),
      (ψ.hom.app (Opposite.op T)).hom
        (((toSheafify (Scheme.smallEtaleTopology B) P).app (Opposite.op T)).hom r) =
      (ψ₀.app (Opposite.op T)).hom r := by
    intro T r
    exact congrArg (fun f => (f.app (Opposite.op T)).hom r)
      (toSheafify_sheafifyLift (Scheme.smallEtaleTopology B) ψ₀ F.cond)

  let κ := (presheafToSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).map κ₀
  have hnat : ∀ (T : B.Etale) (r : P.obj (Opposite.op T)),
      ((toSheafify (Scheme.smallEtaleTopology B) Q).app (Opposite.op T)).hom
        ((κ₀.app (Opposite.op T)).hom r) =
      (κ.hom.app (Opposite.op T)).hom
        (((toSheafify (Scheme.smallEtaleTopology B) P).app (Opposite.op T)).hom r) := by
    intro T r
    exact congrArg (fun f => (f.app (Opposite.op T)).hom r)
      (toSheafify_naturality (Scheme.smallEtaleTopology B) κ₀)

  have hls0 : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology B) κ₀ := by
    apply Presheaf.IsLocallySurjective.mk
    intro T q
    apply hcov'
    intro v
    obtain ⟨T', c, t', r, hc, hr⟩ := hLS T q v
    exact ⟨T', c, ⟨r, hr⟩, ⟨t', hc⟩⟩

  haveI := hls0
  haveI hcompls : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology B)
      (κ₀ ≫ toSheafify (Scheme.smallEtaleTopology B) Q) :=
    Presheaf.isLocallySurjective_comp _ _ _
  have hκls : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology B) κ.hom :=
    Presheaf.isLocallySurjective_of_isLocallySurjective_fac (Scheme.smallEtaleTopology B)
      (toSheafify_naturality (Scheme.smallEtaleTopology B) κ₀).symm
  haveI : Epi κ := (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} κ).mp
    ((Sheaf.isLocallySurjective_sheafToPresheaf_map_iff κ).mp hκls)

  have htorsF : ∀ (T : B.Etale) (z : F.obj.obj (Opposite.op T)), ℓ • z = 0 := by
    intro T z
    have h1 : (sheafToPresheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).map
        (ℓ • 𝟙 F) = 0 := by rw [htor, Functor.map_zero]
    rw [Functor.map_nsmul, CategoryTheory.Functor.map_id] at h1
    have h2 := congrArg (fun f => (f.app (Opposite.op T)).hom z) h1
    simpa using h2

  have hker : ∀ (T : B.Etale)
      (x : ((presheafToSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj P).obj.obj
        (Opposite.op T)),
      (κ.hom.app (Opposite.op T)).hom x = 0 → (ψ.hom.app (Opposite.op T)).hom x = 0 := by
    intro T x hx
    have hsub : ∀ w : T.left, ∃ (V₂ : B.Etale) (c₂ : V₂ ⟶ T),
        w ∈ Set.range c₂.left ∧ (F.obj.map c₂.op).hom ((ψ.hom.app (Opposite.op T)).hom x) = 0 := by
      intro w
      obtain ⟨T₁, c₁, t₁, ⟨r₁, hr₁⟩, ht₁⟩ := hcov T _
        (Presheaf.imageSieve_mem (Scheme.smallEtaleTopology B)
          (toSheafify (Scheme.smallEtaleTopology B) P) (U := Opposite.op T) x) w
      have hr₁' : ((toSheafify (Scheme.smallEtaleTopology B) P).app (Opposite.op T₁)).hom r₁ =
          ((((presheafToSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj P).obj.map
            c₁.op).hom x) := hr₁
      have hb : ((toSheafify (Scheme.smallEtaleTopology B) Q).app (Opposite.op T₁)).hom
          ((κ₀.app (Opposite.op T₁)).hom r₁) =
          ((toSheafify (Scheme.smallEtaleTopology B) Q).app (Opposite.op T₁)).hom 0 := by
        rw [hnat, hr₁', map_zero]
        have e2 : (κ.hom.app (Opposite.op T₁)).hom
            ((((presheafToSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj P).obj.map
              c₁.op).hom x) =
            ((((presheafToSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj Q).obj.map
              c₁.op).hom ((κ.hom.app (Opposite.op T)).hom x)) :=
          NatTrans.naturality_apply κ.hom c₁.op x
        rw [e2, hx, map_zero]
      obtain ⟨T₂, c₂, t₂, hc₂, ht₂⟩ := hcov T₁ _
        (Presheaf.equalizerSieve_mem (Scheme.smallEtaleTopology B)
          (toSheafify (Scheme.smallEtaleTopology B) Q) ((κ₀.app (Opposite.op T₁)).hom r₁) 0 hb) t₁
      have hc₂' : (Q.map c₂.op).hom ((κ₀.app (Opposite.op T₁)).hom r₁) = (Q.map c₂.op).hom 0 :=
        hc₂
      have hk2 : (κ₀.app (Opposite.op T₂)).hom ((P.map c₂.op).hom r₁) = 0 := by
        have e : (κ₀.app (Opposite.op T₂)).hom ((P.map c₂.op).hom r₁) =
            (Q.map c₂.op).hom ((κ₀.app (Opposite.op T₁)).hom r₁) :=
          NatTrans.naturality_apply κ₀ c₂.op r₁
        rw [e, hc₂', map_zero]
      obtain ⟨T₃, c₃, t₃, y, ht₃, hy⟩ := hKL T₂ ((P.map c₂.op).hom r₁) hk2 t₂
      refine ⟨T₃, c₃ ≫ c₂ ≫ c₁, ⟨t₃, ?_⟩, ?_⟩
      · change c₁.left (c₂.left (c₃.left t₃)) = w
        rw [ht₃, ht₂, ht₁]
      · have n1 : ((((presheafToSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj P).obj.map
              c₂.op).hom (((toSheafify (Scheme.smallEtaleTopology B) P).app (Opposite.op T₁)).hom r₁)) =
            ((toSheafify (Scheme.smallEtaleTopology B) P).app (Opposite.op T₂)).hom
              ((P.map c₂.op).hom r₁) :=
          (NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology B) P) c₂.op r₁).symm
        have n2 : ((((presheafToSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj P).obj.map
              c₃.op).hom (((toSheafify (Scheme.smallEtaleTopology B) P).app (Opposite.op T₂)).hom
                ((P.map c₂.op).hom r₁))) =
            ((toSheafify (Scheme.smallEtaleTopology B) P).app (Opposite.op T₃)).hom
              ((P.map c₃.op).hom ((P.map c₂.op).hom r₁)) :=
          (NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology B) P) c₃.op _).symm
        calc (F.obj.map (c₃ ≫ c₂ ≫ c₁).op).hom ((ψ.hom.app (Opposite.op T)).hom x)
            = (ψ.hom.app (Opposite.op T₃)).hom
                ((((presheafToSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj P).obj.map
                  (c₃ ≫ c₂ ≫ c₁).op).hom x) :=
              (NatTrans.naturality_apply ψ.hom (c₃ ≫ c₂ ≫ c₁).op x).symm
          _ = (ψ.hom.app (Opposite.op T₃)).hom
                ((((presheafToSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj P).obj.map
                  c₃.op).hom
                ((((presheafToSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj P).obj.map
                  c₂.op).hom
                ((((presheafToSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj P).obj.map
                  c₁.op).hom x))) := by
              rw [op_comp, op_comp, Functor.map_comp, Functor.map_comp]
              rfl
          _ = (ψ.hom.app (Opposite.op T₃)).hom
                (((toSheafify (Scheme.smallEtaleTopology B) P).app (Opposite.op T₃)).hom
                  ((P.map c₃.op).hom ((P.map c₂.op).hom r₁))) := by
              rw [← hr₁', n1, n2]
          _ = (ψ.hom.app (Opposite.op T₃)).hom
                (((toSheafify (Scheme.smallEtaleTopology B) P).app (Opposite.op T₃)).hom
                  (ℓ • y)) := by rw [hy]
          _ = (ψ₀.app (Opposite.op T₃)).hom (ℓ • y) := hψ T₃ _
          _ = ℓ • (ψ₀.app (Opposite.op T₃)).hom y := map_nsmul _ _ _
          _ = 0 := htorsF T₃ _
    have hS : Presheaf.equalizerSieve (F := F.obj) (X := Opposite.op T)
        ((ψ.hom.app (Opposite.op T)).hom x) 0 ∈ Scheme.smallEtaleTopology B T := by
      apply hcov'
      intro w
      obtain ⟨V₂, c₂, hw, hc⟩ := hsub w
      refine ⟨V₂, c₂, ?_, hw⟩
      rw [Presheaf.equalizerSieve_apply]
      exact hc.trans (map_zero _).symm
    have hsh1 : Presheaf.IsSheaf (Scheme.smallEtaleTopology B)
        (F.obj ⋙ forget AddCommGrpCat.{u+1}) :=
      GrothendieckTopology.HasSheafCompose.isSheaf _ F.cond
    have hsh2 := (isSheaf_iff_isSheaf_of_type _ _).mp hsh1
    refine (hsh2 _ hS).isSeparatedFor.ext (fun Y f hf => ?_)
    have hf' := hf
    rw [Presheaf.equalizerSieve_apply] at hf'
    exact hf'

  have hkz : Limits.kernel.ι κ ≫ ψ = 0 := by
    have h0 : ((0 : Limits.kernel κ ⟶ F)).hom = 0 :=
      (sheafToPresheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).map_zero _ _
    have h0' : ((0 : Limits.kernel κ ⟶
        (presheafToSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj Q)).hom = 0 :=
      (sheafToPresheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).map_zero _ _
    apply Sheaf.hom_ext
    rw [h0]
    ext T z
    show (ψ.hom.app T).hom (((Limits.kernel.ι κ).hom.app T).hom z) = 0
    apply hker (Opposite.unop T)
    have h1 := congrArg (fun f => (f.hom.app T).hom z) (Limits.kernel.condition κ)
    simp only [h0'] at h1
    exact h1

  have hc := Abelian.comp_epiDesc κ ψ hkz
  refine ⟨Abelian.epiDesc κ ψ hkz, fun T r => ?_⟩
  rw [hnat]
  exact (congrArg (fun f => (f.hom.app (Opposite.op T)).hom
    (((toSheafify (Scheme.smallEtaleTopology B) P).app (Opposite.op T)).hom r)) hc).trans (hψ T r)

theorem wc_r2gc_map_of_section : ∀ {B B'' Z'' : Scheme.{u}} (π : B'' ⟶ B) [IsFinite π] (iZ : Z'' ⟶ B'') [IsClosedImmersion iZ] (V : B.Etale) (e : V.left ⟶ B''), IsOpenImmersion e → Set.range e = (Set.range iZ)ᶜ → e ≫ π = V.hom → ∀ (ℓ : ℕ) (F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}), ℓ • 𝟙 F = 0 → ∀ (s : F.obj.obj (Opposite.op V)), ∃ φ : (wcEtPush π).obj (wcEtExtZero B'' (Set.range iZ)ᶜ ℓ) ⟶ F, ∀ (b : B) (A : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) (c : A.right ⟶ V), (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op A)).hom ((F.obj.map c.op).hom s) ∈ Set.range ((wcEtStalk B b).map φ).hom :=
by
  intro B B'' Z'' π _ iZ _ V e he hrange heπ ℓ F htor s

  obtain ⟨hGopen, hGclosed, hGover, -⟩ := wc_r2gc_graph_basic π V e he heπ V V (𝟙 V) (𝟙 V)
  haveI := hGopen
  have hD0 : IsClopen (Set.range (wcR2Graph π V e heπ (𝟙 V))) :=
    ⟨hGclosed, (wcR2Graph π V e heπ (𝟙 V)).isOpenEmbedding.isOpen_range⟩
  have hD0S : ∀ x ∈ Set.range (wcR2Graph π V e heπ (𝟙 V)),
      ((wcEtBaseChange π).obj V).hom x ∈ (Set.range iZ)ᶜ := by
    rintro _ ⟨y, rfl⟩
    rw [← hrange]
    exact hGover y
  obtain ⟨γ0, hγ1, hγ2⟩ := wc_r2gc_extZero_indicator B'' (Set.range iZ)ᶜ ℓ
    ((wcEtBaseChange π).obj V) _ hD0 hD0S (ULift.up 1)

  have hγ : wcR2GraphInd π V e heπ (Set.range iZ)ᶜ ℓ γ0 := by
    intro T g W h
    have hpre : ((wcEtBaseChange π).map g).left ⁻¹' Set.range (wcR2Graph π V e heπ (𝟙 V)) =
        Set.range (wcR2Graph π V e heπ g) := by
      have := (wc_r2gc_graph_basic π V e he heπ V T (𝟙 V) g).2.2.2
      rwa [Category.comp_id] at this
    have hmap : ∀ y, ((wcEtExtZero B'' (Set.range iZ)ᶜ ℓ).obj.map h.op).hom
        (((wcEtExtZero B'' (Set.range iZ)ᶜ ℓ).obj.map ((wcEtBaseChange π).map g).op).hom y) =
        ((wcEtExtZero B'' (Set.range iZ)ᶜ ℓ).obj.map (h ≫ (wcEtBaseChange π).map g).op).hom y := by
      intro y
      rw [op_comp, Functor.map_comp]
      rfl
    have hrng : ∀ (D : Set ((wcEtBaseChange π).obj V).left),
        Set.range h.left ⊆ ((wcEtBaseChange π).map g).left ⁻¹' D →
        Set.range (h ≫ (wcEtBaseChange π).map g).left ⊆ D := by
      rintro D hD _ ⟨x, rfl⟩
      exact hD ⟨x, rfl⟩
    refine ⟨fun hsub => ?_, fun hsub => ?_⟩
    · rw [← hpre] at hsub
      obtain ⟨y, hy1, hy2⟩ := hγ1 W _ (hrng _ hsub)
      exact ⟨y, hy1, (hmap γ0).trans hy2⟩
    · rw [← hpre, ← Set.preimage_compl] at hsub
      rw [hmap γ0]
      exact hγ2 W _ (hrng _ hsub)

  obtain ⟨φ, hφ⟩ := wc_r2gc_factor_through_sheafify (wcFTKU V)
    ((wcEtBaseChange π).op ⋙ (wcEtExtZero B'' (Set.range iZ)ᶜ ℓ).obj)
    (wcR2FreeMap V ((wcEtBaseChange π).op ⋙ (wcEtExtZero B'' (Set.range iZ)ᶜ ℓ).obj) γ0) ℓ F htor
    (wc_r2gc_local_surj π V e he heπ (Set.range iZ)ᶜ hrange ℓ γ0 hγ)
    (wc_r2gc_kernel_local π V e he heπ (Set.range iZ)ᶜ ℓ γ0 hγ)
    (wcR2FreeMap V F.obj s)

  refine ⟨φ, fun b A c => ?_⟩
  have h1 := hφ A.right (FreeAbelianGroup.of (ULift.up c))
  have h2 : ((wcR2FreeMap V F.obj s).app (Opposite.op A.right)).hom
      (FreeAbelianGroup.of (ULift.up c)) = (F.obj.map c.op).hom s := by
    exact FreeAbelianGroup.lift_apply_of
      (fun g : ULift.{u+1} (A.right ⟶ V) => (F.obj.map g.down.op).hom s) (ULift.up c)
  rw [h2] at h1
  have germ : ∀ z : ((wcEtPush π).obj (wcEtExtZero B'' (Set.range iZ)ᶜ ℓ)).obj.obj
      (Opposite.op A.right),
      (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b))
        (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op A)).hom
        ((φ.hom.app (Opposite.op A.right)).hom z) ∈ Set.range ((wcEtStalk B b).map φ).hom := by
    intro z
    refine ⟨(Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b))
      (Scheme.Etale.forget B)).op ⋙ ((wcEtPush π).obj (wcEtExtZero B'' (Set.range iZ)ᶜ ℓ)).obj)
      (Opposite.op A)).hom z, ?_⟩
    exact congrArg (fun f => f.hom z) (Limits.colimit.ι_map (Functor.whiskerLeft
      (StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op φ.hom)
      (Opposite.op A))
  rw [← h1]
  exact germ _

theorem wc_r2gc_cover_of_finite_chart : ∀ (K : Type u) [Field K] [IsAlgClosed K] (B : Scheme.{u}) (fB : B ⟶ Spec (.of K)) [IsProper fB] (n : ℕ), topologicalKrullDim B ≤ (n : WithBot ℕ∞) → ∀ (V : B.Etale) (OY : B.Opens), IsAffineOpen OY → IrreducibleSpace V.left → ∀ (εO : V.left ⟶ (OY : Scheme.{u})), IsFinite εO → εO ≫ OY.ι = V.hom → ∃ (B'' : Scheme.{u}) (π : B'' ⟶ B) (Z'' : Scheme.{u}) (iZ : Z'' ⟶ B'') (e : V.left ⟶ B''), IsFinite π ∧ IsClosedImmersion iZ ∧ IsOpenImmersion e ∧ Set.range e = (Set.range iZ)ᶜ ∧ e ≫ π = V.hom ∧ IrreducibleSpace B'' ∧ topologicalKrullDim B'' ≤ (n : WithBot ℕ∞) ∧ topologicalKrullDim Z'' < (n : WithBot ℕ∞) :=
by
  intro K _ _ B fB _ n hB V OY hOY hVirr εO hεO hεc
  haveI : CompactSpace B := QuasiCompact.compactSpace_of_compactSpace fB
  haveI : QuasiSeparatedSpace B := quasiSeparatedSpace_of_quasiSeparated fB
  obtain ⟨B'', π, hπ, e, he, hrange, hdense, heπ⟩ :=
    wc_finite_extension_of_affine_finite B OY hOY V.left εO hεO
  haveI := hπ
  haveI := he
  have heπ' : e ≫ π = V.hom := heπ.trans hεc
  have hopen : IsOpen (Set.range e) := IsOpenImmersion.isOpen_range e
  have hdense' : Dense (Set.range e) := hrange ▸ hdense
  have hirr : IrreducibleSpace B'' := by
    have h1 : IsIrreducible (Set.range e) := by
      have := (IrreducibleSpace.isIrreducible_univ V.left).image e e.continuous.continuousOn
      simpa [Set.image_univ] using this
    have h2 := h1.closure
    rw [hdense'.closure_eq] at h2
    exact (irreducibleSpace_def B'').mpr h2
  haveI : IsProper (π ≫ fB) := inferInstance
  have hdimB : topologicalKrullDim B'' ≤ (n : WithBot ℕ∞) :=
    (wc_finite_topologicalKrullDim_le π).trans hB
  obtain ⟨Z'', iZ, hiZ, hrZ, h0, hd⟩ :=
    wc_dense_open_compl_subscheme K B'' (π ≫ fB) (Set.range e) hopen hdense' n hdimB
  have hZ : topologicalKrullDim Z'' < (n : WithBot ℕ∞) := by
    cases n with
    | zero =>
      haveI := h0 rfl
      have hbot : topologicalKrullDim Z'' = ⊥ := by
        unfold topologicalKrullDim
        rw [Order.krullDim_eq_bot_iff]
        exact ⟨fun s => isEmptyElim s.isIrreducible.nonempty.some⟩
      rw [hbot]
      exact WithBot.bot_lt_coe _
    | succ d =>
      refine lt_of_le_of_lt (hd d rfl) ?_
      exact_mod_cast Nat.lt_succ_self d
  refine ⟨B'', π, Z'', iZ, e, hπ, hiZ, he, ?_, heπ', hirr, hdimB, hZ⟩
  rw [hrZ, compl_compl]

theorem wc_et_zmod_pull_data_exists : ∀ {S S' : Scheme.{u}} (g : S' ⟶ S) (n : ℕ), Nonempty (wcEtPullData g n) :=
by
  classical
  intro S S' g n

  have hjs : ∀ (Y : Scheme.{u}) (V : Y.Etale) (T : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
      (c : V₁ ⟶ V), T.arrows c ∧ v ∈ Set.range c.left) → T ∈ Scheme.smallEtaleTopology Y V := by
    intro Y V T hT
    change T ∈ Scheme.smallGrothendieckTopology @Etale Y V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hT x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩
  have hcov : CoverPreserving (Scheme.smallEtaleTopology S)
      (Scheme.smallEtaleTopology S') (wcEtBaseChange g) := by
    constructor
    intro V T hT
    change T ∈ Scheme.smallGrothendieckTopology @Etale S V at hT
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale S
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hT
    have hT' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale S
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hT
    apply hjs
    intro v
    obtain ⟨W, a, w, ha, -, hw⟩ := hT' (Limits.pullback.fst V.hom g v)
    refine ⟨(wcEtBaseChange g).obj W, (wcEtBaseChange g).map a,
      Sieve.image_mem_functorPushforward (wcEtBaseChange g) T ha, ?_⟩
    have h0 : (Limits.pullback.fst W.hom g ≫ a.left) ≫ V.hom = Limits.pullback.snd W.hom g ≫ g := by
      rw [Category.assoc, MorphismProperty.Over.w a]
      exact Limits.pullback.condition
    let m : Limits.pullback W.hom g ⟶ Limits.pullback V.hom g :=
      Limits.pullback.lift (Limits.pullback.fst W.hom g ≫ a.left) (Limits.pullback.snd W.hom g) h0
    have hmap : ((wcEtBaseChange g).map a).left = m := rfl
    have h1 : Limits.pullback.fst a.left (Limits.pullback.fst V.hom g) ≫ W.hom =
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) ≫ g := by
      rw [← MorphismProperty.Over.w a, ← Category.assoc, Limits.pullback.condition, Category.assoc,
        Limits.pullback.condition, Category.assoc]
    let ψ : Limits.pullback a.left (Limits.pullback.fst V.hom g) ⟶ Limits.pullback W.hom g :=
      Limits.pullback.lift (Limits.pullback.fst a.left (Limits.pullback.fst V.hom g))
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) h1
    have hψ : ψ ≫ m = Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, Limits.pullback.lift_fst,
          Limits.pullback.condition]
      · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
    obtain ⟨z, hz⟩ : ∃ z, Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) z = v := by
      have hv : (v : ↥(Limits.pullback V.hom g)) ∈
          Set.range (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g)) := by
        rw [Scheme.Pullback.range_snd]
        exact ⟨w, hw⟩
      exact hv
    rw [hmap]
    exact ⟨ψ z, (Scheme.Hom.comp_apply ψ m z).symm.trans (by rw [hψ]; exact hz)⟩
  haveI h1 : Limits.PreservesFiniteLimits (wcEtBaseChange g) := ⟨fun J _ _ =>
    haveI : Limits.PreservesLimitsOfShape J (wcEtBaseChange g ⋙ Scheme.Etale.forget S') :=
      Limits.preservesLimitsOfShape_of_natIso
        (NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl) :
          Scheme.Etale.forget S ⋙ Over.pullback g ≅ wcEtBaseChange g ⋙ Scheme.Etale.forget S')
    Limits.preservesLimitsOfShape_of_reflects_of_preserves (wcEtBaseChange g)
      (Scheme.Etale.forget S')⟩
  haveI hflat : RepresentablyFlat (wcEtBaseChange g) := flat_of_preservesFiniteLimits _
  haveI hcont : (wcEtBaseChange g).IsContinuous (Scheme.smallEtaleTopology S)
      (Scheme.smallEtaleTopology S') :=
    Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat _ _) hcov
  have hT : Limits.IsTerminal ((wcEtBaseChange g).obj (⊤_ S.Etale)) :=
    Limits.IsTerminal.isTerminalObj _ _ Limits.terminalIsTerminal

  let A : RingCat.{u+1} := RingCat.of (ULift.{u+1} (ZMod n))
  let P : (S.Etale)ᵒᵖ ⥤ RingCat.{u+1} := (Functor.const (S.Etale)ᵒᵖ).obj A
  let P' : (S'.Etale)ᵒᵖ ⥤ RingCat.{u+1} := (Functor.const (S'.Etale)ᵒᵖ).obj A
  let α : P ⟶ (wcEtZModRing S n).obj := toSheafify (Scheme.smallEtaleTopology S) P
  let α' : P' ⟶ (wcEtZModRing S' n).obj := toSheafify (Scheme.smallEtaleTopology S') P'
  haveI hαs : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology S) α :=
    Presheaf.isLocallySurjective_toSheafify' _ P
  haveI hα's : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology S') α' :=
    Presheaf.isLocallySurjective_toSheafify' _ P'
  haveI hα'i : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology S') α' :=
    Presheaf.isLocallyInjective_toSheafify' _ P'
  have hα'nat : ∀ {W₁ W₂ : S'.Etale} (h : W₁ ⟶ W₂) (t : ULift.{u+1} (ZMod n)),
      ((wcEtZModRing S' n).obj.map h.op).hom ((α'.app (Opposite.op W₂)).hom t) =
        (α'.app (Opposite.op W₁)).hom t := by
    intro W₁ W₂ h t
    have := congrArg (fun k => k.hom t) (α'.naturality h.op)
    exact this.symm
  let η : P ⟶ (wcEtBaseChange g).op ⋙ (wcEtZModRing S' n).obj :=
    { app := fun V => α'.app (Opposite.op ((wcEtBaseChange g).obj V.unop))
      naturality := fun V W f => by
        have := α'.naturality ((wcEtBaseChange g).map f.unop).op
        exact this }
  have hsheaf : Presheaf.IsSheaf (Scheme.smallEtaleTopology S)
      ((wcEtBaseChange g).op ⋙ (wcEtZModRing S' n).obj) :=
    (((wcEtBaseChange g).sheafPushforwardContinuous RingCat.{u+1} (Scheme.smallEtaleTopology S)
      (Scheme.smallEtaleTopology S')).obj (wcEtZModRing S' n)).cond
  let φhom : (wcEtZModRing S n).obj ⟶ (wcEtBaseChange g).op ⋙ (wcEtZModRing S' n).obj :=
    sheafifyLift (Scheme.smallEtaleTopology S) η hsheaf
  let φ : wcEtZModRing S n ⟶ ((wcEtBaseChange g).sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S')).obj (wcEtZModRing S' n) :=
    ObjectProperty.homMk φhom
  have hC : ∀ (V : S.Etale) (t : ULift.{u+1} (ZMod n)),
      (φ.hom.app (Opposite.op V)).hom ((α.app (Opposite.op V)).hom t) =
        (α'.app (Opposite.op ((wcEtBaseChange g).obj V))).hom t := by
    intro V t
    have h := toSheafify_sheafifyLift (Scheme.smallEtaleTopology S) η hsheaf
    have h2 := congrArg (fun k => (k.app (Opposite.op V)).hom t) h
    exact h2

  have hsurj : ∀ (V' : S'.Etale) (r' : (wcEtZModRing S' n).obj.obj (Opposite.op V')),
      ∃ T ∈ Scheme.smallEtaleTopology S' V', ∀ ⦃W' : S'.Etale⦄ (f : W' ⟶ V'),
      T.arrows f → ∃ (V : S.Etale) (a : W' ⟶ (wcEtBaseChange g).obj V)
        (r : (wcEtZModRing S n).obj.obj (Opposite.op V)),
        ((wcEtZModRing S' n).obj.map f.op).hom r' =
          ((wcEtZModRing S' n).obj.map a.op).hom ((φ.hom.app (Opposite.op V)).hom r) := by
    intro V' r'
    refine ⟨Presheaf.imageSieve α' r', Presheaf.imageSieve_mem _ α' r', ?_⟩
    intro W' f hf
    obtain ⟨t, ht⟩ := hf
    refine ⟨⊤_ S.Etale, hT.from W', (α.app (Opposite.op (⊤_ S.Etale))).hom t, ?_⟩
    rw [hC (⊤_ S.Etale) t, hα'nat (hT.from W') t]
    exact ht.symm
  have hcomp : ∀ {X₁ X₂ X₃ : (S'.Etale)ᵒᵖ} (p : X₁ ⟶ X₂) (q : X₂ ⟶ X₃)
      (x : (wcEtZModRing S' n).obj.obj X₁),
      ((wcEtZModRing S' n).obj.map q).hom (((wcEtZModRing S' n).obj.map p).hom x) =
        ((wcEtZModRing S' n).obj.map (p ≫ q)).hom x := by
    intro X₁ X₂ X₃ p q x
    rw [Functor.map_comp]
    rfl
  have hinj : ∀ (V' : S'.Etale) (V : S.Etale) (a : V' ⟶ (wcEtBaseChange g).obj V)
      (r : (wcEtZModRing S n).obj.obj (Opposite.op V)),
      ((wcEtZModRing S' n).obj.map a.op).hom ((φ.hom.app (Opposite.op V)).hom r) = 0 →
      ∃ T ∈ Scheme.smallEtaleTopology S' V', ∀ ⦃W' : S'.Etale⦄ (f : W' ⟶ V'), T.arrows f →
        ∃ (W : S.Etale) (b : W ⟶ V) (a' : W' ⟶ (wcEtBaseChange g).obj W),
          a' ≫ (wcEtBaseChange g).map b = f ≫ a ∧
            ((wcEtZModRing S n).obj.map b.op).hom r = 0 := by
    intro V' V a r hr
    let T : Sieve V' :=
      { arrows := fun W' f => ∃ (W : S.Etale) (b : W ⟶ V) (a' : W' ⟶ (wcEtBaseChange g).obj W),
          a' ≫ (wcEtBaseChange g).map b = f ≫ a ∧ ((wcEtZModRing S n).obj.map b.op).hom r = 0
        downward_closed := by
          rintro W₁ W₂ f ⟨W, b, a', e1, e2⟩ m
          exact ⟨W, b, m ≫ a', by simp only [Category.assoc, e1], e2⟩ }
    refine ⟨T, ?_, fun W' f hf => hf⟩
    have hI : Presheaf.imageSieve α r ∈ Scheme.smallEtaleTopology S V :=
      Presheaf.imageSieve_mem _ α r
    have hP1 : Sieve.pullback a (Sieve.functorPushforward (wcEtBaseChange g)
        (Presheaf.imageSieve α r)) ∈ Scheme.smallEtaleTopology S' V' :=
      (Scheme.smallEtaleTopology S').pullback_stable a (hcov.cover_preserve hI)
    apply (Scheme.smallEtaleTopology S').transitive hP1
    intro W₁ h hh
    obtain ⟨Z, c, k, hc, hk⟩ := hh
    obtain ⟨t, ht⟩ := hc
    have ht' : (α.app (Opposite.op Z)).hom t = ((wcEtZModRing S n).obj.map c.op).hom r := ht
    have hnat : ((wcEtZModRing S' n).obj.map ((wcEtBaseChange g).map c).op).hom
        ((φ.hom.app (Opposite.op V)).hom r) =
        (φ.hom.app (Opposite.op Z)).hom (((wcEtZModRing S n).obj.map c.op).hom r) := by
      have := congrArg (fun q => q.hom r) (φ.hom.naturality c.op)
      exact this.symm
    have key : ∀ x : (wcEtZModRing S' n).obj.obj (Opposite.op ((wcEtBaseChange g).obj V)),
        ((wcEtZModRing S' n).obj.map k.op).hom
          (((wcEtZModRing S' n).obj.map ((wcEtBaseChange g).map c).op).hom x) =
        ((wcEtZModRing S' n).obj.map h.op).hom (((wcEtZModRing S' n).obj.map a.op).hom x) := by
      intro x
      rw [hcomp, hcomp, ← op_comp, ← op_comp, hk]
    have e : (α'.app (Opposite.op W₁)).hom t = ((wcEtZModRing S' n).obj.map h.op).hom
        (((wcEtZModRing S' n).obj.map a.op).hom ((φ.hom.app (Opposite.op V)).hom r)) := by
      rw [← hα'nat k t, ← hC Z t, ht', ← hnat]
      exact key _
    have hzero : (α'.app (Opposite.op W₁)).hom t = (α'.app (Opposite.op W₁)).hom 0 := by
      rw [e, hr, map_zero, map_zero]
    refine (Scheme.smallEtaleTopology S').superset_covering ?_
      (Presheaf.equalizerSieve_mem _ α' t 0 hzero)
    intro W₂ m hm
    have ht0 : t = 0 := hm
    refine ⟨Z, c, m ≫ k, ?_, ?_⟩
    · simp only [Category.assoc, hk]
    · have h3 := ht'.symm
      rw [ht0, map_zero] at h3
      exact h3

  haveI : (PresheafOfModules.pushforward.{u+1} φ.hom).IsRightAdjoint :=
    wc_presheafOfModules_pushforward_isRightAdjoint _ φ.hom
  let Φ : SheafOfModules.{u+1} (wcEtZModRing S n) ⥤ SheafOfModules.{u+1} (wcEtZModRing S' n) :=
    SheafOfModules.pullback φ
  let adj : Φ ⊣ SheafOfModules.pushforward φ := SheafOfModules.pullbackPushforwardAdjunction φ
  haveI : Φ.IsLeftAdjoint := adj.isLeftAdjoint
  haveI : Φ.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint Φ
  haveI : Limits.PreservesColimitsOfSize.{0, 0} Φ := adj.leftAdjoint_preservesColimits
  haveI hcol : Limits.PreservesFiniteColimits Φ :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits Φ
  haveI : Limits.PreservesBinaryBiproducts Φ :=
    Limits.preservesBinaryBiproducts_of_preservesBinaryCoproducts Φ
  haveI hadd : Φ.Additive := Functor.additive_of_preservesBinaryBiproducts Φ

  obtain ⟨ι⟩ := wc_sheafOfModules_pullback_toSheaf_iso (Scheme.smallEtaleTopology S)
    (Scheme.smallEtaleTopology S') (wcEtBaseChange g) (wcEtZModRing S n) (wcEtZModRing S' n) φ
    hsurj hinj Φ adj
  haveI := wc_sheafPullback_preservesFiniteLimits_of_flat (Scheme.smallEtaleTopology S)
    (Scheme.smallEtaleTopology S') (wcEtBaseChange g)
  haveI : Limits.PreservesFiniteLimits (SheafOfModules.toSheaf.{u+1} (wcEtZModRing S n) ⋙
      (wcEtBaseChange g).sheafPullback AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology S)
        (Scheme.smallEtaleTopology S')) :=
    Limits.comp_preservesFiniteLimits _ _
  haveI : Limits.PreservesFiniteLimits (Φ ⋙ SheafOfModules.toSheaf.{u+1} (wcEtZModRing S' n)) :=
    Limits.preservesFiniteLimits_of_natIso ι.symm
  haveI hlim : Limits.PreservesFiniteLimits Φ :=
    Limits.preservesFiniteLimits_of_reflects_of_preserves Φ
      (SheafOfModules.toSheaf.{u+1} (wcEtZModRing S' n))

  haveI : (wcEtBaseChange g).Final := final_of_representablyFlat _
  let μ : Φ.obj (SheafOfModules.unit (wcEtZModRing S n)) ≅ SheafOfModules.unit (wcEtZModRing S' n) :=
    Φ.mapIso (Limits.coproductUniqueIso
        (fun _ : PUnit.{u+2} => SheafOfModules.unit (wcEtZModRing S n))).symm ≪≫
      SheafOfModules.pullbackObjFreeIso φ PUnit.{u+2} ≪≫
      Limits.coproductUniqueIso (fun _ : PUnit.{u+2} => SheafOfModules.unit (wcEtZModRing S' n))

  exact ⟨⟨hcont, φ, Φ, adj, hadd, hlim, hcol, μ⟩⟩

theorem wc_et_pull_comp : ∀ {S S' S'' : Scheme.{u}} {n : ℕ} (f : S' ⟶ S) (g : S'' ⟶ S') (k : S'' ⟶ S), g ≫ f = k → ∀ (Df : wcEtPullData f n) (Dg : wcEtPullData g n) (Dk : wcEtPullData k n) (i : ℕ) (x : wcEtZModExt S n i), wcEtPull Dk i x = wcEtPull Dg i (wcEtPull Df i x) :=
by
  classical
  intro S S' S'' n f g k hk Df Dg Dk i x
  subst hk

  have s1 : ∀ (X : Scheme.{u}) (T : Sheaf (Scheme.smallEtaleTopology X) RingCat.{u+1})
      (a b : wcEtZModRing X n ⟶ T), a = b := by
    intro X T a b
    have key : ∀ {R : Type (u+1)} [Semiring R] (ψ ψ' : ULift.{u+1} (ZMod n) →+* R), ψ = ψ' := by
      intro R _ ψ ψ'
      have h : ψ.comp (ULift.ringEquiv (R := ZMod n)).symm.toRingHom =
          ψ'.comp (ULift.ringEquiv (R := ZMod n)).symm.toRingHom := Subsingleton.elim _ _
      ext z
      have h' := congrArg (fun φ : ZMod n →+* R => φ (ULift.ringEquiv z)) h
      simpa using h'
    apply Sheaf.hom_ext
    apply sheafify_hom_ext (Scheme.smallEtaleTopology X) _ _ T.cond
    apply NatTrans.ext
    funext V
    apply RingCat.hom_ext
    exact key _ _

  have s2 : ∀ (X : Scheme.{u}) (V : (X.Etale)ᵒᵖ) (a b : ↑((wcEtZModRing X n).obj.obj V)),
      a * b = b * a := by
    intro X V a b
    obtain ⟨α, hsurj⟩ : ∃ α : (Functor.const (X.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶
        (wcEtZModRing X n).obj, Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X) α :=
      ⟨toSheafify (Scheme.smallEtaleTopology X)
          ((Functor.const (X.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n)))),
        Presheaf.isLocallySurjective_toSheafify' (Scheme.smallEtaleTopology X) _⟩
    haveI := hsurj
    have hsep := Sheaf.isSeparated (wcEtZModRing X n)
    induction V using Opposite.rec with
    | op V =>
    refine hsep V _ (GrothendieckTopology.intersection_covering _
      (Presheaf.imageSieve_mem _ α a) (Presheaf.imageSieve_mem _ α b)) (a * b) (b * a) ?_
    intro W h hh
    have hh' : (Presheaf.imageSieve α a).arrows h ∧ (Presheaf.imageSieve α b).arrows h := hh
    obtain ⟨⟨t₁, ht₁⟩, ⟨t₂, ht₂⟩⟩ := hh'
    have hc : t₁ * t₂ = t₂ * t₁ := @mul_comm (ULift.{u+1} (ZMod n)) _ t₁ t₂
    rw [map_mul, map_mul, ← ht₁, ← ht₂, ← map_mul, ← map_mul]
    exact congrArg _ hc

  have hmap : ∀ {A B : Scheme.{u}} (h : A ⟶ B) {V V' : B.Etale} (u : V ⟶ V'),
      ((wcEtBaseChange h).map u).left ≫ Limits.pullback.fst V'.hom h =
        Limits.pullback.fst V.hom h ≫ u.left ∧
      ((wcEtBaseChange h).map u).left ≫ Limits.pullback.snd V'.hom h =
        Limits.pullback.snd V.hom h := by
    intro A B h V V' u
    exact ⟨Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hsnd : ∀ V : S.Etale, (Limits.pullbackLeftPullbackSndIso V.hom f g).symm.hom ≫
      Limits.pullback.snd (Limits.pullback.snd V.hom f) g = Limits.pullback.snd V.hom (g ≫ f) := by
    intro V
    rw [Iso.symm_hom, Iso.inv_comp_eq, Limits.pullbackLeftPullbackSndIso_hom_snd]
  choose c hc using fun V : S.Etale =>
    (⟨MorphismProperty.Over.isoMk (A := (wcEtBaseChange (g ≫ f)).obj V)
        (B := (wcEtBaseChange f ⋙ wcEtBaseChange g).obj V)
        (Limits.pullbackLeftPullbackSndIso V.hom f g).symm (hsnd V),
      MorphismProperty.Over.isoMk_hom_left _ _⟩ :
      ∃ c : (wcEtBaseChange (g ≫ f)).obj V ≅ (wcEtBaseChange f ⋙ wcEtBaseChange g).obj V,
        c.hom.left = (Limits.pullbackLeftPullbackSndIso V.hom f g).inv)
  have nat : ∀ {V V' : S.Etale} (u : V ⟶ V'),
      (wcEtBaseChange (g ≫ f)).map u ≫ (c V').hom =
        (c V).hom ≫ (wcEtBaseChange f ⋙ wcEtBaseChange g).map u := by
    intro V V' u
    have key : ∀ (L : Limits.pullback V.hom (g ≫ f) ⟶ Limits.pullback V'.hom (g ≫ f))
        (M1 : Limits.pullback V.hom f ⟶ Limits.pullback V'.hom f)
        (M2 : Limits.pullback (Limits.pullback.snd V.hom f) g ⟶
          Limits.pullback (Limits.pullback.snd V'.hom f) g),
        L ≫ Limits.pullback.fst V'.hom (g ≫ f) = Limits.pullback.fst V.hom (g ≫ f) ≫ u.left →
        L ≫ Limits.pullback.snd V'.hom (g ≫ f) = Limits.pullback.snd V.hom (g ≫ f) →
        M1 ≫ Limits.pullback.fst V'.hom f = Limits.pullback.fst V.hom f ≫ u.left →
        M1 ≫ Limits.pullback.snd V'.hom f = Limits.pullback.snd V.hom f →
        M2 ≫ Limits.pullback.fst (Limits.pullback.snd V'.hom f) g =
          Limits.pullback.fst (Limits.pullback.snd V.hom f) g ≫ M1 →
        M2 ≫ Limits.pullback.snd (Limits.pullback.snd V'.hom f) g =
          Limits.pullback.snd (Limits.pullback.snd V.hom f) g →
        L ≫ (Limits.pullbackLeftPullbackSndIso V'.hom f g).inv =
          (Limits.pullbackLeftPullbackSndIso V.hom f g).inv ≫ M2 := by
      intro L M1 M2 hL1 hL2 hM1 _ hM2 hM2'
      rw [Iso.comp_inv_eq, Category.assoc, Iso.eq_inv_comp]
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hL1, Category.assoc, Limits.pullbackLeftPullbackSndIso_hom_fst,
          reassoc_of% hM2, hM1, reassoc_of% (Limits.pullbackLeftPullbackSndIso_hom_fst V.hom f g)]
      · rw [Category.assoc, hL2, Limits.pullbackLeftPullbackSndIso_hom_snd, Category.assoc,
          Limits.pullbackLeftPullbackSndIso_hom_snd, hM2']
    apply MorphismProperty.Over.Hom.ext
    change ((wcEtBaseChange (g ≫ f)).map u).left ≫ (c V').hom.left =
      (c V).hom.left ≫ ((wcEtBaseChange g).map ((wcEtBaseChange f).map u)).left
    rw [hc V, hc V']
    exact key _ _ _ (hmap (g ≫ f) u).1 (hmap (g ≫ f) u).2 (hmap f u).1 (hmap f u).2
      (hmap g ((wcEtBaseChange f).map u)).1 (hmap g ((wcEtBaseChange f).map u)).2
  let α : wcEtBaseChange (g ≫ f) ≅ wcEtBaseChange f ⋙ wcEtBaseChange g := NatIso.ofComponents c nat

  haveI := Df.cont
  haveI := Dg.cont
  haveI := Dk.cont
  haveI : (wcEtBaseChange f ⋙ wcEtBaseChange g).IsContinuous (Scheme.smallEtaleTopology S)
      (Scheme.smallEtaleTopology S'') :=
    Functor.isContinuous_comp _ _ _ (Scheme.smallEtaleTopology S') _
  let τ := (Functor.sheafPushforwardContinuousNatTrans α.hom RingCat.{u+1}
    (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S'')).app (wcEtZModRing S'' n)
  let φfg : wcEtZModRing S n ⟶ ((wcEtBaseChange f ⋙ wcEtBaseChange g).sheafPushforwardContinuous
      RingCat.{u+1} (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S'')).obj
        (wcEtZModRing S'' n) :=
    Df.φ ≫ ((wcEtBaseChange f).sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S')).map Dg.φ
  have hcompat : φfg ≫ τ = Dk.φ := s1 S _ _ _
  let ι : SheafOfModules.pushforward Dg.φ ⋙ SheafOfModules.pushforward Df.φ ≅
      SheafOfModules.pushforward Dk.φ :=
    SheafOfModules.pushforwardComp Df.φ Dg.φ ≪≫
      SheafOfModules.pushforwardNatIso φfg α ≪≫ SheafOfModules.pushforwardCongr hcompat
  have θ : Dk.Φ ≅ Df.Φ ⋙ Dg.Φ := Dk.adj.leftAdjointUniq ((Df.adj.comp Dg.adj).ofNatIsoRight ι)

  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S n)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S' n)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S'' n)) := HasExt.standard _
  haveI := Df.additive
  haveI := Df.presLim
  haveI := Df.presColim
  haveI := Dg.additive
  haveI := Dg.presLim
  haveI := Dg.presColim
  haveI := Dk.additive
  haveI := Dk.presLim
  haveI := Dk.presColim
  have h2 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcEtZModRing S'' n)} {a : ℕ}
      (f : A ⟶ B) (g : B ⟶ C') (z : Abelian.Ext C' D' a),
      (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ g).comp z (zero_add a)) (zero_add a) =
        (Abelian.Ext.mk₀ (f ≫ g)).comp z (zero_add a) := by
    intro A B C' D' a f g z
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
  have h3 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcEtZModRing S'' n)} {a : ℕ}
      (z : Abelian.Ext A B a) (f : B ⟶ C') (g : C' ⟶ D'),
      (z.comp (Abelian.Ext.mk₀ f) (add_zero a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        z.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero a) := by
    intro A B C' D' a z f g
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  have h4 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcEtZModRing S'' n)} {a : ℕ}
      (f : A ⟶ B) (z : Abelian.Ext B C' a) (g : C' ⟶ D'),
      ((Abelian.Ext.mk₀ f).comp z (zero_add a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        (Abelian.Ext.mk₀ f).comp (z.comp (Abelian.Ext.mk₀ g) (add_zero a)) (zero_add a) := by
    intro A B C' D' a f z g
    exact Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _
  have central : ∀ (e : SheafOfModules.unit (wcEtZModRing S'' n) ⟶
      SheafOfModules.unit (wcEtZModRing S'' n)) (y : wcEtZModExt S'' n i),
      (Abelian.Ext.mk₀ e).comp y (zero_add i) = y.comp (Abelian.Ext.mk₀ e) (add_zero i) := by
    intro e y
    have hcomm : ∀ (X : (S''.Etale)ᵒᵖ) (a b : (wcEtZModRing S'' n).obj.obj X), a * b = b * a :=
      s2 S''
    have hext : ∃ m : 𝟭 (SheafOfModules.{u+1} (wcEtZModRing S'' n)) ⟶
        𝟭 (SheafOfModules.{u+1} (wcEtZModRing S'' n)),
        m.app (SheafOfModules.unit (wcEtZModRing S'' n)) = e := by
      let R := wcEtZModRing S'' n
      let s := (SheafOfModules.unit R).unitHomEquiv e
      let σ : ∀ X : (S''.Etale)ᵒᵖ, R.obj.obj X := fun X => (s.1 X : R.obj.obj X)
      have hσ : ∀ {X Y : (S''.Etale)ᵒᵖ} (f : X ⟶ Y), (R.obj.map f).hom (σ X) = σ Y :=
        fun f => PresheafOfModules.sections_property s f
      let L : ∀ (M : SheafOfModules.{u+1} R) (X : (S''.Etale)ᵒᵖ), M.val.obj X ⟶ M.val.obj X :=
        fun M X => ModuleCat.ofHom
          { toFun := fun x => σ X • x
            map_add' := fun x y => smul_add _ _ _
            map_smul' := fun r x => by
              simp only [RingHom.id_apply, smul_smul]
              rw [hcomm X] }
      let mM : ∀ M : SheafOfModules.{u+1} R, M ⟶ M := fun M =>
        ⟨PresheafOfModules.Hom.mk (L M) (by
          intro X Y f
          ext x
          show σ Y • (M.val.map f).hom x = (M.val.map f).hom (σ X • x)
          rw [PresheafOfModules.map_smul, hσ])⟩
      refine ⟨{ app := mM, naturality := ?_ }, ?_⟩
      · intro M N g
        apply SheafOfModules.hom_ext
        apply PresheafOfModules.hom_ext
        intro X
        ext x
        show σ X • (g.val.app X).hom x = (g.val.app X).hom (σ X • x)
        exact ((g.val.app X).hom.map_smul _ _).symm
      · apply (SheafOfModules.unit R).unitHomEquiv.injective
        apply PresheafOfModules.sections_ext
        intro X
        rw [SheafOfModules.unitHomEquiv_apply_coe]
        show σ X • (1 : R.obj.obj X) = s.1 X
        rw [smul_eq_mul, mul_one]
    have hcen : ∀ (m : 𝟭 (SheafOfModules.{u+1} (wcEtZModRing S'' n)) ⟶
        𝟭 (SheafOfModules.{u+1} (wcEtZModRing S'' n))) (z : wcEtZModExt S'' n i),
        (Abelian.Ext.mk₀ (m.app (SheafOfModules.unit (wcEtZModRing S'' n)))).comp z (zero_add i) =
          z.comp (Abelian.Ext.mk₀ (m.app (SheafOfModules.unit (wcEtZModRing S'' n))))
            (add_zero i) := by
      intro m z
      have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp z m
      simp only [Abelian.Ext.id_mapExactFunctor] at h
      exact h.symm
    obtain ⟨m, hm⟩ := hext
    subst hm
    exact hcen m y
  have gen : ∀ {Y : SheafOfModules.{u+1} (wcEtZModRing S'' n)} (y : Abelian.Ext Y Y i)
      (a a' : SheafOfModules.unit (wcEtZModRing S'' n) ⟶ Y)
      (b b' : Y ⟶ SheafOfModules.unit (wcEtZModRing S'' n)),
      a ≫ b = 𝟙 _ → b' ≫ a' = 𝟙 _ →
      (Abelian.Ext.mk₀ a).comp (y.comp (Abelian.Ext.mk₀ b) (add_zero i)) (zero_add i) =
        (Abelian.Ext.mk₀ a').comp (y.comp (Abelian.Ext.mk₀ b') (add_zero i)) (zero_add i) := by
    intro Y y a a' b b' hab hba
    have ea : (a ≫ b') ≫ a' = a := by rw [Category.assoc, hba, Category.comp_id]
    have eb : b' ≫ a' ≫ b = b := by rw [← Category.assoc, hba, Category.id_comp]
    have eE : (a ≫ b') ≫ (a' ≫ b) = 𝟙 _ := by rw [← Category.assoc, ea, hab]
    have hc : (Abelian.Ext.mk₀ (a ≫ b')).comp ((Abelian.Ext.mk₀ a').comp
          (y.comp (Abelian.Ext.mk₀ b') (add_zero i)) (zero_add i)) (zero_add i) =
        ((Abelian.Ext.mk₀ a').comp (y.comp (Abelian.Ext.mk₀ b') (add_zero i)) (zero_add i)).comp
          (Abelian.Ext.mk₀ (a ≫ b')) (add_zero i) :=
      central _ _
    have e1 : (Abelian.Ext.mk₀ a).comp (y.comp (Abelian.Ext.mk₀ b) (add_zero i)) (zero_add i) =
        ((Abelian.Ext.mk₀ (a ≫ b')).comp ((Abelian.Ext.mk₀ a').comp
          (y.comp (Abelian.Ext.mk₀ b') (add_zero i)) (zero_add i)) (zero_add i)).comp
          (Abelian.Ext.mk₀ (a' ≫ b)) (add_zero i) := by
      rw [h2, h4, h3, ea, eb]
    rw [e1, hc, h3, eE, Abelian.Ext.comp_mk₀_id]
  show (Abelian.Ext.mk₀ Dk.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dk.Φ x).comp
      (Abelian.Ext.mk₀ Dk.μ.hom) (add_zero i)) (zero_add i) =
    (Abelian.Ext.mk₀ Dg.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dg.Φ
      ((Abelian.Ext.mk₀ Df.μ.inv).comp ((Abelian.Ext.mapExactFunctor Df.Φ x).comp
        (Abelian.Ext.mk₀ Df.μ.hom) (add_zero i)) (zero_add i))).comp
      (Abelian.Ext.mk₀ Dg.μ.hom) (add_zero i)) (zero_add i)
  have nat' : (Abelian.Ext.mapExactFunctor Dk.Φ x).comp
      (Abelian.Ext.mk₀ (θ.hom.app (SheafOfModules.unit (wcEtZModRing S n)))) (add_zero i) =
      (Abelian.Ext.mk₀ (θ.hom.app (SheafOfModules.unit (wcEtZModRing S n)))).comp
        (Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Dg.Φ) x) (zero_add i) :=
    Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp x θ.hom
  have step1 : (Abelian.Ext.mapExactFunctor Dk.Φ x).comp (Abelian.Ext.mk₀ Dk.μ.hom) (add_zero i) =
      ((Abelian.Ext.mk₀ (θ.hom.app (SheafOfModules.unit (wcEtZModRing S n)))).comp
        (Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Dg.Φ) x) (zero_add i)).comp
        (Abelian.Ext.mk₀ (θ.inv.app (SheafOfModules.unit (wcEtZModRing S n)) ≫ Dk.μ.hom))
        (add_zero i) := by
    rw [← nat', h3, Iso.hom_inv_id_app_assoc]
  have hL : (Abelian.Ext.mk₀ Dk.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dk.Φ x).comp
      (Abelian.Ext.mk₀ Dk.μ.hom) (add_zero i)) (zero_add i) =
      (Abelian.Ext.mk₀ (Dk.μ.inv ≫ θ.hom.app (SheafOfModules.unit (wcEtZModRing S n)))).comp
        ((Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Dg.Φ) x).comp
          (Abelian.Ext.mk₀ (θ.inv.app (SheafOfModules.unit (wcEtZModRing S n)) ≫ Dk.μ.hom))
          (add_zero i)) (zero_add i) := by
    rw [step1, h4, h2]
  have hR : (Abelian.Ext.mk₀ Dg.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dg.Φ
      ((Abelian.Ext.mk₀ Df.μ.inv).comp ((Abelian.Ext.mapExactFunctor Df.Φ x).comp
        (Abelian.Ext.mk₀ Df.μ.hom) (add_zero i)) (zero_add i))).comp
      (Abelian.Ext.mk₀ Dg.μ.hom) (add_zero i)) (zero_add i) =
      (Abelian.Ext.mk₀ (Dg.μ.inv ≫ Dg.Φ.map Df.μ.inv)).comp
        ((Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Dg.Φ) x).comp
          (Abelian.Ext.mk₀ (Dg.Φ.map Df.μ.hom ≫ Dg.μ.hom)) (add_zero i)) (zero_add i) := by
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_mapExactFunctor, h4, h3, h2]
  rw [hL, hR]
  have hab : (Dk.μ.inv ≫ θ.hom.app (SheafOfModules.unit (wcEtZModRing S n))) ≫
      (θ.inv.app (SheafOfModules.unit (wcEtZModRing S n)) ≫ Dk.μ.hom) = 𝟙 _ := by
    rw [Category.assoc, Iso.hom_inv_id_app_assoc, Iso.inv_hom_id]
  have hba : (Dg.Φ.map Df.μ.hom ≫ Dg.μ.hom) ≫ (Dg.μ.inv ≫ Dg.Φ.map Df.μ.inv) =
      𝟙 (Dg.Φ.obj (Df.Φ.obj (SheafOfModules.unit (wcEtZModRing S n)))) := by
    rw [Category.assoc, Iso.hom_inv_id_assoc, ← CategoryTheory.Functor.map_comp, Iso.hom_inv_id,
      CategoryTheory.Functor.map_id]
  exact gen _ _ _ _ _ hab hba

theorem wc_et_pull_id_injective : ∀ {S : Scheme.{u}} {n : ℕ} (D : wcEtPullData (𝟙 S) n) (i : ℕ) (x : wcEtZModExt S n i), wcEtPull D i x = 0 → x = 0 :=
by
  classical
  intro S n D i x hx

  have s1 : ∀ (T : Sheaf (Scheme.smallEtaleTopology S) RingCat.{u+1})
      (a b : wcEtZModRing S n ⟶ T), a = b := by
    intro T a b
    have key : ∀ {R : Type (u+1)} [Semiring R] (ψ ψ' : ULift.{u+1} (ZMod n) →+* R), ψ = ψ' := by
      intro R _ ψ ψ'
      have h : ψ.comp (ULift.ringEquiv (R := ZMod n)).symm.toRingHom =
          ψ'.comp (ULift.ringEquiv (R := ZMod n)).symm.toRingHom := Subsingleton.elim _ _
      ext z
      have h' := congrArg (fun φ : ZMod n →+* R => φ (ULift.ringEquiv z)) h
      simpa using h'
    apply Sheaf.hom_ext
    apply sheafify_hom_ext (Scheme.smallEtaleTopology S) _ _ T.cond
    apply NatTrans.ext
    funext V
    apply RingCat.hom_ext
    exact key _ _

  have hw : ∀ V : S.Etale, Limits.pullback.fst V.hom (𝟙 S) ≫ V.hom =
      Limits.pullback.snd V.hom (𝟙 S) := by
    intro V
    rw [Limits.pullback.condition, Category.comp_id]
  have hiso : ∀ V : S.Etale, IsIso (Limits.pullback.fst V.hom (𝟙 S)) :=
    fun V => Limits.pullback_fst_iso_of_right_iso V.hom (𝟙 S)
  choose c hc using fun V : S.Etale =>
    (⟨MorphismProperty.Over.isoMk (A := (wcEtBaseChange (𝟙 S)).obj V) (B := V)
        (@asIso _ _ _ _ (Limits.pullback.fst V.hom (𝟙 S)) (hiso V)) (hw V),
      MorphismProperty.Over.isoMk_hom_left _ _⟩ :
      ∃ c : (wcEtBaseChange (𝟙 S)).obj V ≅ (𝟭 S.Etale).obj V,
        c.hom.left = Limits.pullback.fst V.hom (𝟙 S))
  have nat : ∀ {V V' : S.Etale} (u : V ⟶ V'),
      (wcEtBaseChange (𝟙 S)).map u ≫ (c V').hom = (c V).hom ≫ (𝟭 S.Etale).map u := by
    intro V V' u
    apply MorphismProperty.Over.Hom.ext
    change ((wcEtBaseChange (𝟙 S)).map u).left ≫ (c V').hom.left = (c V).hom.left ≫ u.left
    rw [hc V, hc V']
    exact Limits.pullback.lift_fst _ _ _
  let β : wcEtBaseChange (𝟙 S) ≅ 𝟭 S.Etale := NatIso.ofComponents c nat

  haveI := D.cont
  let τ := (Functor.sheafPushforwardContinuousNatTrans β.hom RingCat.{u+1}
    (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S)).app (wcEtZModRing S n)
  have hcompat : (𝟙 (wcEtZModRing S n) : wcEtZModRing S n ⟶
      ((𝟭 S.Etale).sheafPushforwardContinuous RingCat.{u+1} (Scheme.smallEtaleTopology S)
        (Scheme.smallEtaleTopology S)).obj (wcEtZModRing S n)) ≫ τ = D.φ := s1 _ _ _
  let ι : 𝟭 (SheafOfModules.{u+1} (wcEtZModRing S n)) ≅ SheafOfModules.pushforward D.φ :=
    (SheafOfModules.pushforwardId (wcEtZModRing S n)).symm ≪≫
      SheafOfModules.pushforwardNatIso _ β ≪≫ SheafOfModules.pushforwardCongr hcompat
  have θ : D.Φ ≅ 𝟭 (SheafOfModules.{u+1} (wcEtZModRing S n)) :=
    D.adj.leftAdjointUniq (Adjunction.id.ofNatIsoRight ι)

  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S n)) := HasExt.standard _
  haveI := D.additive
  haveI := D.presLim
  haveI := D.presColim
  have h2 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcEtZModRing S n)} {a : ℕ}
      (f : A ⟶ B) (g : B ⟶ C') (z : Abelian.Ext C' D' a),
      (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ g).comp z (zero_add a)) (zero_add a) =
        (Abelian.Ext.mk₀ (f ≫ g)).comp z (zero_add a) := by
    intro A B C' D' a f g z
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
  have h3 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcEtZModRing S n)} {a : ℕ}
      (z : Abelian.Ext A B a) (f : B ⟶ C') (g : C' ⟶ D'),
      (z.comp (Abelian.Ext.mk₀ f) (add_zero a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        z.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero a) := by
    intro A B C' D' a z f g
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  have h4 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcEtZModRing S n)} {a : ℕ}
      (f : A ⟶ B) (z : Abelian.Ext B C' a) (g : C' ⟶ D'),
      ((Abelian.Ext.mk₀ f).comp z (zero_add a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        (Abelian.Ext.mk₀ f).comp (z.comp (Abelian.Ext.mk₀ g) (add_zero a)) (zero_add a) := by
    intro A B C' D' a f z g
    exact Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _
  have hx' : (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ x).comp
      (Abelian.Ext.mk₀ D.μ.hom) (add_zero i)) (zero_add i) = 0 := hx
  have nat' : (Abelian.Ext.mapExactFunctor D.Φ x).comp
      (Abelian.Ext.mk₀ (θ.hom.app (SheafOfModules.unit (wcEtZModRing S n)))) (add_zero i) =
      (Abelian.Ext.mk₀ (θ.hom.app (SheafOfModules.unit (wcEtZModRing S n)))).comp x
        (zero_add i) := by
    have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp x θ.hom
    simp only [Abelian.Ext.id_mapExactFunctor] at h
    exact h
  have step1 : (Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero i) =
      ((Abelian.Ext.mk₀ (θ.hom.app (SheafOfModules.unit (wcEtZModRing S n)))).comp x
        (zero_add i)).comp
        (Abelian.Ext.mk₀ (θ.inv.app (SheafOfModules.unit (wcEtZModRing S n)) ≫ D.μ.hom))
        (add_zero i) := by
    rw [← nat', h3, Iso.hom_inv_id_app_assoc]
  have hL : (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ x).comp
      (Abelian.Ext.mk₀ D.μ.hom) (add_zero i)) (zero_add i) =
      (Abelian.Ext.mk₀ (D.μ.inv ≫ θ.hom.app (SheafOfModules.unit (wcEtZModRing S n)))).comp
        (x.comp
          (Abelian.Ext.mk₀ (θ.inv.app (SheafOfModules.unit (wcEtZModRing S n)) ≫ D.μ.hom))
          (add_zero i)) (zero_add i) := by
    rw [step1, h4, h2]
  have hqp : (θ.inv.app (SheafOfModules.unit (wcEtZModRing S n)) ≫ D.μ.hom) ≫
      (D.μ.inv ≫ θ.hom.app (SheafOfModules.unit (wcEtZModRing S n))) =
      𝟙 (SheafOfModules.unit (wcEtZModRing S n)) := by
    rw [Category.assoc, Iso.hom_inv_id_assoc]
    exact Iso.inv_hom_id_app θ _
  have e : x = (Abelian.Ext.mk₀ (θ.inv.app (SheafOfModules.unit (wcEtZModRing S n)) ≫ D.μ.hom)).comp
      (((Abelian.Ext.mk₀ (D.μ.inv ≫ θ.hom.app (SheafOfModules.unit (wcEtZModRing S n)))).comp
        (x.comp
          (Abelian.Ext.mk₀ (θ.inv.app (SheafOfModules.unit (wcEtZModRing S n)) ≫ D.μ.hom))
          (add_zero i)) (zero_add i)).comp
        (Abelian.Ext.mk₀ (D.μ.inv ≫ θ.hom.app (SheafOfModules.unit (wcEtZModRing S n))))
        (add_zero i)) (zero_add i) := by
    rw [h4, h2, h3, hqp, Abelian.Ext.comp_mk₀_id]
    exact (Abelian.Ext.mk₀_id_comp x).symm
  rw [e, ← hL, hx', Abelian.Ext.zero_comp, Abelian.Ext.comp_zero]

theorem wc_r2gs_stalk_colim_assembly : ∀ (B : Scheme.{u}) (b : B) (F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (E : Type*) [AddCommGroup E] (H : B.Etale → Type*) [∀ V, AddCommGroup (H V)] (ψ : ∀ V : B.Etale, H V →+ F.obj.obj (Opposite.op V)) (res : ∀ {V V' : B.Etale}, (V' ⟶ V) → (H V →+ H V')) (θ : ∀ A : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B), H A.right →+ E), IsCofiltered (StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) → (∀ {V V' : B.Etale} (f : V' ⟶ V) (x : H V), (F.obj.map f.op).hom (ψ V x) = ψ V' (res f x)) → (∀ {V V' V'' : B.Etale} (f : V' ⟶ V) (f' : V'' ⟶ V') (x : H V), res (f' ≫ f) x = res f' (res f x)) → (∀ (A A' : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) (f : A' ⟶ A) (x : H A.right), θ A x = θ A' (res f.right x)) → (∀ (A : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) (s : F.obj.obj (Opposite.op A.right)), ∃ (A' : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) (f : A' ⟶ A) (x : H A'.right), (F.obj.map f.right.op).hom s = ψ A'.right x) → (∀ (A : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) (x : H A.right), ψ A.right x = 0 → ∃ (A' : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) (f : A' ⟶ A), res f.right x = 0) → (∀ y : E, ∃ (A : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) (x : H A.right), θ A x = y) → (∀ (A : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) (x : H A.right), θ A x = 0 → ∃ (A' : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) (f : A' ⟶ A), res f.right x = 0) → ∃ e : ↑((wcEtStalk B b).obj F) ≃+ E, ∀ (A : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) (x : H A.right), e ((Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op A)).hom (ψ A.right x)) = θ A x :=
by
  intro B b F E _ H _ ψ res θ hcof h1 h2 h3 h4 h5 h6 h7
  classical
  haveI := hcof
  haveI : IsFiltered (StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B))ᵒᵖ :=
    isFiltered_op_of_isCofiltered _
  haveI := Limits.preservesFilteredColimitsOfSize_shrink.{u+1, u+1, u, u+1} (forget AddCommGrpCat.{u+1})
  have G1 : ∀ x : (wcEtStalk B b).obj F, ∃ (A : StructuredArrow (Over.mk (wcEtGeomPt B b))
      (Scheme.Etale.forget B)) (s : F.obj.obj (Opposite.op A.right)),
      (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b))
        (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op A)).hom s = x := by
    intro x
    obtain ⟨j, y, hy⟩ := Limits.Concrete.colimit_exists_rep
      ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙ F.obj) x
    exact ⟨j.unop, y, hy⟩
  have G2 : ∀ (A A' : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B))
