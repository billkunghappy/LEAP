by

  have hs5 : ∀ (k L Ω : Type u) [Field k] [Field L] [Field Ω] [Algebra k L] [Algebra k Ω]
      [FiniteDimensional k L] [Algebra.IsSeparable k L] [IsAlgClosed Ω] [Algebra.IsAlgebraic k Ω]
      (S : Type (u+1)) (γ : (L →ₐ[k] Ω) → S),
      (∀ (σ : Ω →ₐ[k] Ω) (φ φ' : L →ₐ[k] Ω), γ φ = γ φ' → γ (σ.comp φ) = γ (σ.comp φ')) →
      ∃ L' : Subfield L, (∀ c : k, algebraMap k L c ∈ L') ∧
        ∀ φ φ' : L →ₐ[k] Ω, γ φ = γ φ' ↔ ∀ a ∈ L', φ a = φ' a := by
    intro k L Ω _ _ _ _ _ _ _ _ _ S γ hγ
    classical
