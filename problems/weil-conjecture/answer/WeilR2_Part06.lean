  haveI := hVirr
  obtain ⟨φ, hφ⟩ := wc_r2gc_map_of_section π iZ V e he hrange heπ (ℓ ^ m) _ hFt s

  have hgp : ∀ (b : B) (p : Spec (.of (AlgebraicClosure (B.residueField b)))),
      (wcEtGeomPt B b) p = b := by
    intro b p
    simp only [wcEtGeomPt, Scheme.Hom.comp_apply]
