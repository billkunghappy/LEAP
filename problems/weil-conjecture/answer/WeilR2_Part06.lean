            sheafifyMap (Scheme.smallEtaleTopology X) w) ≫
            sheafifyMap (Scheme.smallEtaleTopology X) b := by
      intro P P' Q Q' a w w' b h
      rw [← Category.assoc, toSheafify_naturality, Category.assoc, ← sheafifyMap_comp, h,
        sheafifyMap_comp, Category.assoc]
    have gen2 : ∀ {K P Q : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}}
        (c : sheafify (Scheme.smallEtaleTopology X) K ⟶ P) (g : K ⟶ P) (w : P ⟶ Q) (k : K ⟶ Q),
        toSheafify (Scheme.smallEtaleTopology X) K ≫ c = g → g ≫ w = k →
        toSheafify (Scheme.smallEtaleTopology X) K ≫ c ≫ toSheafify (Scheme.smallEtaleTopology X) P ≫
            sheafifyMap (Scheme.smallEtaleTopology X) w =
          toSheafify (Scheme.smallEtaleTopology X) K ≫ sheafifyMap (Scheme.smallEtaleTopology X) k := by
      intro K P Q c g w k h1 h2
      rw [← Category.assoc, h1, ← toSheafify_naturality, ← Category.assoc, h2,
        toSheafify_naturality]
    have hw : ∀ V : X.Etale, Limits.pullback.fst V.hom (inv σ) ≫
        ((wcEtSlice (Scheme.Etale.mk σ)).obj V).hom = ((wcEtBaseChange (inv σ)).obj V).hom := by
      intro V
