theorem wc_alg_closed_poly_transcendence_embedding : ∀ (K Ω : Type u) [Field K] [Field Ω] [IsAlgClosed Ω] (σ : K →+* Ω), ∃ (T : Type u) (ι : MvPolynomial T K →+* Ω), Function.Injective ι ∧ ι.comp MvPolynomial.C = σ ∧ (letI := ι.toAlgebra; Algebra.IsAlgebraic (MvPolynomial T K) Ω) :=
by
  intro K Ω _ _ _ σ
  letI : Algebra K Ω := σ.toAlgebra
  haveI : FaithfulSMul K Ω := (faithfulSMul_iff_algebraMap_injective K Ω).mpr σ.injective
  obtain ⟨s, hs⟩ := exists_isTranscendenceBasis K Ω
  have hx : AlgebraicIndependent K (Subtype.val : s → Ω) := hs.1
  refine ⟨s, (MvPolynomial.aeval (Subtype.val : s → Ω)).toRingHom, ?_, ?_, ?_⟩
  · exact algebraicIndependent_iff_injective_aeval.mp hx
  · refine RingHom.ext fun r => ?_
    show MvPolynomial.aeval (Subtype.val : s → Ω) (MvPolynomial.C r) = σ r
    rw [MvPolynomial.aeval_C]
    rfl
  · letI : Algebra (MvPolynomial s K) Ω :=
      (MvPolynomial.aeval (Subtype.val : s → Ω)).toRingHom.toAlgebra
    have hA := hs.isAlgebraic
    exact (Algebra.isAlgebraic_ringHom_iff_of_comp_eq hx.aevalEquiv.toRingEquiv
      (RingEquiv.refl Ω) (RingHom.ext fun p => hx.algebraMap_aevalEquiv p)).mp hA

theorem wc_et_K_point_fibre_card : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) (T : Type u) (a : T → K) (m q : ℕ), Nat.card (wcEtCoh (Limits.pullback f (wcEtGeomPt (Spec (.of (MvPolynomial T K))) ((Spec.map (CommRingCat.ofHom (MvPolynomial.aeval a).toRingHom)) (IsLocalRing.closedPoint K)) ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K))))) m q) = Nat.card (wcEtCoh Y m q) :=
by
  intro K _ _ Y f T a m q
  classical
  obtain ⟨b, hb⟩ : ∃ b : Spec (.of (MvPolynomial T K)),
      b = (Spec.map (CommRingCat.ofHom (MvPolynomial.aeval a).toRingHom)) (IsLocalRing.closedPoint K) :=
    ⟨_, rfl⟩
  rw [← hb]
  obtain ⟨ρ, hρ⟩ : ∃ ρ : CommRingCat.of K ⟶ (Spec (.of (MvPolynomial T K))).residueField b,
      Spec.map ρ = (Spec (.of (MvPolynomial T K))).fromSpecResidueField b ≫
        Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K))) :=
    ⟨Spec.preimage _, Spec.map_preimage _⟩
  obtain ⟨δ, hδ⟩ : ∃ δ : (Spec (.of (MvPolynomial T K))).residueField b ⟶ CommRingCat.of K,
      Spec.map δ ≫ (Spec (.of (MvPolynomial T K))).fromSpecResidueField b =
        Spec.map (CommRingCat.ofHom (MvPolynomial.aeval a).toRingHom) := by
    subst hb
    exact ⟨_, Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField K _ _⟩
  have hsπ : Spec.map (CommRingCat.ofHom (MvPolynomial.aeval a).toRingHom) ≫
      Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K))) = 𝟙 _ := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have h1 : (MvPolynomial.aeval a).toRingHom.comp (algebraMap K (MvPolynomial T K)) =
        RingHom.id K := by
      ext r
      simp
    rw [h1, CommRingCat.ofHom_id, Spec.map_id]
  have hρδ : ρ ≫ δ = 𝟙 _ := by
    apply Spec.map_injective
    rw [Spec.map_comp, hρ, ← Category.assoc, hδ, hsπ, Spec.map_id]
  have hsurj : Function.Surjective ρ.hom := by
    intro y
    refine ⟨δ.hom y, ?_⟩
    apply δ.hom.injective
    have h2 := congrArg (fun φ => φ.hom (δ.hom y)) hρδ
    simpa using h2
  have hρbij : Function.Bijective ρ.hom := ⟨ρ.hom.injective, hsurj⟩
  haveI : IsAlgClosed ((Spec (.of (MvPolynomial T K))).residueField b) :=
    IsAlgClosed.of_ringEquiv K _ (RingEquiv.ofBijective ρ.hom hρbij)
  have hιbij : Function.Bijective (algebraMap ((Spec (.of (MvPolynomial T K))).residueField b)
      (AlgebraicClosure ((Spec (.of (MvPolynomial T K))).residueField b))) :=
    IsAlgClosed.algebraMap_bijective_of_isIntegral
  let τ : CommRingCat.of K ⟶ CommRingCat.of
      (AlgebraicClosure ((Spec (.of (MvPolynomial T K))).residueField b)) :=
    ρ ≫ CommRingCat.ofHom (algebraMap ((Spec (.of (MvPolynomial T K))).residueField b)
      (AlgebraicClosure ((Spec (.of (MvPolynomial T K))).residueField b)))
  have hτbij : Function.Bijective τ.hom := by
    have : τ.hom = (algebraMap ((Spec (.of (MvPolynomial T K))).residueField b)
        (AlgebraicClosure ((Spec (.of (MvPolynomial T K))).residueField b))).comp ρ.hom := rfl
    rw [this, RingHom.coe_comp]
    exact hιbij.comp hρbij
  haveI : IsIso τ := (ConcreteCategory.isIso_iff_bijective τ).mpr hτbij
  have hg : Spec.map τ = wcEtGeomPt (Spec (.of (MvPolynomial T K))) b ≫
        Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K))) :=
    ((Spec.map_comp ρ (CommRingCat.ofHom (algebraMap ((Spec (.of (MvPolynomial T K))).residueField b)
      (AlgebraicClosure ((Spec (.of (MvPolynomial T K))).residueField b))))).trans
      (congrArg (fun g => Spec.map (CommRingCat.ofHom (algebraMap
        ((Spec (.of (MvPolynomial T K))).residueField b)
        (AlgebraicClosure ((Spec (.of (MvPolynomial T K))).residueField b)))) ≫ g) hρ)).trans
      (Category.assoc _ _ _).symm
  haveI : IsIso (wcEtGeomPt (Spec (.of (MvPolynomial T K))) b ≫
        Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K)))) := by
    rw [← hg]
    infer_instance
  obtain ⟨e⟩ := wc_et_coh_iso_invariance (Limits.pullback.fst f
    (wcEtGeomPt (Spec (.of (MvPolynomial T K))) b ≫
      Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K))))) m q
  exact (Nat.card_congr e).symm

theorem wc_spec_generic_geom_point_iso : ∀ (K Ω : Type u) [Field K] [Field Ω] [IsAlgClosed Ω] (T : Type u) (ι : MvPolynomial T K →+* Ω), Function.Injective ι → (letI := ι.toAlgebra; Algebra.IsAlgebraic (MvPolynomial T K) Ω) → ∃ e : Spec (.of Ω) ⟶ Spec (.of (AlgebraicClosure ((Spec (.of (MvPolynomial T K))).residueField (genericPoint (Spec (.of (MvPolynomial T K))))))), IsIso e ∧ e ≫ wcEtGeomPt (Spec (.of (MvPolynomial T K))) (genericPoint (Spec (.of (MvPolynomial T K)))) = Spec.map (CommRingCat.ofHom ι) :=
by
  intro K Ω _ _ _ T ι hinj halg
  generalize hp : Scheme.SpecToEquivOfField Ω (Spec (.of (MvPolynomial T K)))
    (Spec.map (CommRingCat.ofHom ι)) = p
  obtain ⟨x, φ₀⟩ := p
  have hF : Spec.map φ₀ ≫ (Spec (.of (MvPolynomial T K))).fromSpecResidueField x =
      Spec.map (CommRingCat.ofHom ι) := by
    have h2 := (Equiv.symm_apply_eq _).mpr hp.symm
    rw [Scheme.SpecToEquivOfField_symm_apply] at h2
    exact h2
  have hx : x = genericPoint (Spec (.of (MvPolynomial T K))) := by
    have h1 : (Spec.map (CommRingCat.ofHom ι)) (default : Spec (.of Ω)) = x := by
      rw [← hF, Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]
    rw [genericPoint_eq_bot_of_affine, ← h1]
    apply PrimeSpectrum.ext
    have hd : (default : Spec (.of Ω)).asIdeal = ⊥ := Scheme.default_asIdeal
    rw [Spec.map_apply]
    show Ideal.comap (CommRingCat.Hom.hom (CommRingCat.ofHom ι)) (default : Spec (.of Ω)).asIdeal =
      (⊥ : PrimeSpectrum (MvPolynomial T K)).asIdeal
    rw [hd, PrimeSpectrum.asIdeal_bot, CommRingCat.hom_ofHom]
    exact Ideal.comap_bot_of_injective ι hinj
  subst hx
  have hC : Spec.preimage ((Spec (.of (MvPolynomial T K))).fromSpecResidueField
      (genericPoint (Spec (.of (MvPolynomial T K))))) ≫ φ₀ = CommRingCat.ofHom ι := by
    apply Spec.map_inj.mp
    rw [Spec.map_comp, Spec.map_preimage, hF]
  set ρ := Spec.preimage ((Spec (.of (MvPolynomial T K))).fromSpecResidueField
      (genericPoint (Spec (.of (MvPolynomial T K))))) with hρ
  have hC' : φ₀.hom.comp ρ.hom = ι := by
    have := congrArg CommRingCat.Hom.hom hC
    rwa [CommRingCat.hom_comp, CommRingCat.hom_ofHom] at this
  have hρinj : Function.Injective ρ.hom := by
    rw [← hC', RingHom.coe_comp] at hinj
    exact Function.Injective.of_comp hinj
  letI : Algebra (MvPolynomial T K) ((Spec (.of (MvPolynomial T K))).residueField
      (genericPoint (Spec (.of (MvPolynomial T K))))) := ρ.hom.toAlgebra
  letI : Algebra ((Spec (.of (MvPolynomial T K))).residueField
      (genericPoint (Spec (.of (MvPolynomial T K))))) Ω := φ₀.hom.toAlgebra
  letI : Algebra (MvPolynomial T K) Ω := ι.toAlgebra
  haveI : Algebra.IsAlgebraic (MvPolynomial T K) Ω := halg
  haveI : IsScalarTower (MvPolynomial T K) ((Spec (.of (MvPolynomial T K))).residueField
      (genericPoint (Spec (.of (MvPolynomial T K))))) Ω :=
    IsScalarTower.of_algebraMap_eq' hC'.symm
  haveI : Algebra.IsAlgebraic ((Spec (.of (MvPolynomial T K))).residueField
      (genericPoint (Spec (.of (MvPolynomial T K))))) Ω :=
    Algebra.IsAlgebraic.extendScalars (R := MvPolynomial T K) hρinj
  haveI : IsAlgClosure ((Spec (.of (MvPolynomial T K))).residueField
      (genericPoint (Spec (.of (MvPolynomial T K))))) Ω := IsAlgClosure.mk inferInstance inferInstance
  let ε := IsAlgClosure.equiv ((Spec (.of (MvPolynomial T K))).residueField
      (genericPoint (Spec (.of (MvPolynomial T K)))))
    (AlgebraicClosure ((Spec (.of (MvPolynomial T K))).residueField
      (genericPoint (Spec (.of (MvPolynomial T K)))))) Ω
  have hE : (ε.toRingEquiv.toRingHom).comp (algebraMap _ (AlgebraicClosure
      ((Spec (.of (MvPolynomial T K))).residueField
        (genericPoint (Spec (.of (MvPolynomial T K))))))) = φ₀.hom :=
    RingHom.ext fun c => ε.commutes c
  refine ⟨Spec.map (CommRingCat.ofHom ε.toRingEquiv.toRingHom), ?_, ?_⟩
  · have : IsIso (CommRingCat.ofHom ε.toRingEquiv.toRingHom) :=
      (ε.toRingEquiv.toCommRingCatIso).isIso_hom
    infer_instance
  · rw [wcEtGeomPt, ← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hE,
      CommRingCat.ofHom_hom, hF]

theorem wc_et_section_free_unit_iso : ∀ {X Y : Scheme.{u}} (s' : Y ⟶ X) (L' : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}), Nonempty (L' ⊣ wcEtPush s') → ∀ (U : X.Etale) (ι : wcFtcFS X U ⟶ (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))), (ι.hom.app (Opposite.op U)).hom (wcFtcGen X U) = wcConstSec X (ULift.{u+1} ℤ) U (ULift.up 1) → ∀ (s : Y ⟶ U.left), s ≫ U.hom = s' → ∃ κ : (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ L'.obj (wcFtcFS X U), IsIso (κ ≫ L'.map ι) :=
by
  intro X Y s' L' hadj U ι hι s hs

  have hfree : ∀ {X E : Scheme.{u}} (e : E ⟶ X)
      (Λ : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⥤
        Sheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1})
      (hΛ : Nonempty (Λ ⊣ wcEtPush e)),
      ∃ θ : ∀ T : X.Etale, Λ.obj ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
            (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≅
          (presheafToSheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}).obj
            (yoneda.obj ((wcEtBaseChange e).obj T) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free),
        ∀ {T T' : X.Etale} (c : T ⟶ T'),
          Λ.map ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
              (Functor.whiskerRight (yoneda.map c) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) ≫
            (θ T').hom =
          (θ T).hom ≫ (presheafToSheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}).map
              (Functor.whiskerRight (yoneda.map ((wcEtBaseChange e).map c))
                (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) := by
    intro X E e Λ hΛ
    have hjs : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
        (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
      intro Y V S hS
      change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      obtain ⟨V₁, c, hc, y, hy⟩ := hS x
      have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
      have hEt : Etale c.left := by
        have h1 : Etale V.hom := V.prop
        have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
        exact Etale.of_comp c.left V.hom
      exact ⟨V₁, c, y, hc, hEt, hy⟩
    have hcov : ∀ {X B : Scheme.{u}} (g : X ⟶ B), CoverPreserving (Scheme.smallEtaleTopology B)
        (Scheme.smallEtaleTopology X) (wcEtBaseChange g) := by
      intro X B g
      constructor
      intro V S hS
      change S ∈ Scheme.smallGrothendieckTopology @Etale B V at hS
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
      have hS' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS
      apply hjs
      intro v
      obtain ⟨W, a, w, ha, -, hw⟩ := hS' (Limits.pullback.fst V.hom g v)
      refine ⟨(wcEtBaseChange g).obj W, (wcEtBaseChange g).map a,
        Sieve.image_mem_functorPushforward (wcEtBaseChange g) S ha, ?_⟩
      have h0 : (Limits.pullback.fst W.hom g ≫ a.left) ≫ V.hom = Limits.pullback.snd W.hom g ≫ g := by
        rw [Category.assoc, MorphismProperty.Over.w a]
        exact Limits.pullback.condition
      let m : Limits.pullback W.hom g ⟶ Limits.pullback V.hom g :=
        Limits.pullback.lift (Limits.pullback.fst W.hom g ≫ a.left) (Limits.pullback.snd W.hom g) h0
      have hmap : ((wcEtBaseChange g).map a).left = m := rfl
      have h1 : Limits.pullback.fst a.left (Limits.pullback.fst V.hom g) ≫ W.hom =
          (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) ≫ g := by
        rw [← MorphismProperty.Over.w a, ← Category.assoc, Limits.pullback.condition, Category.assoc,
          Limits.pullback.condition, Category.assoc]
      let ψ : Limits.pullback a.left (Limits.pullback.fst V.hom g) ⟶ Limits.pullback W.hom g :=
        Limits.pullback.lift (Limits.pullback.fst a.left (Limits.pullback.fst V.hom g))
          (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) h1
      have hψ : ψ ≫ m = Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) := by
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, Limits.pullback.lift_fst,
            Limits.pullback.condition]
        · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
      obtain ⟨z, hz⟩ : ∃ z, Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) z = v := by
        have hv : (v : ↥(Limits.pullback V.hom g)) ∈
            Set.range (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g)) := by
          rw [Scheme.Pullback.range_snd]
          exact ⟨w, hw⟩
        exact hv
      rw [hmap]
      exact ⟨ψ z, (Scheme.Hom.comp_apply ψ m z).symm.trans (by rw [hψ]; exact hz)⟩
    obtain ⟨adj⟩ := hΛ
    let Φ := wcEtBaseChange e
    haveI h1 : Limits.PreservesFiniteLimits Φ := ⟨fun J _ _ =>
      haveI : Limits.PreservesLimitsOfShape J (wcEtBaseChange e ⋙ Scheme.Etale.forget E) :=
        Limits.preservesLimitsOfShape_of_natIso
          (NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl) :
            Scheme.Etale.forget X ⋙ Over.pullback e ≅ wcEtBaseChange e ⋙ Scheme.Etale.forget E)
      Limits.preservesLimitsOfShape_of_reflects_of_preserves (wcEtBaseChange e) (Scheme.Etale.forget E)⟩
    haveI := flat_of_preservesFiniteLimits Φ
    haveI : Φ.IsContinuous (Scheme.smallEtaleTopology X) (Scheme.smallEtaleTopology E) :=
      Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat _ _) (hcov e)
    let ε : wcEtPush e ≅ Φ.sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology X) (Scheme.smallEtaleTopology E) :=
      Functor.isoWhiskerRight (Φ.sheafPushforwardContinuousCompSheafToPresheafIso AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology X) (Scheme.smallEtaleTopology E)).symm
        (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) ≪≫
      Functor.associator _ _ _ ≪≫
      Functor.isoWhiskerLeft _ (asIso (sheafificationAdjunction (Scheme.smallEtaleTopology X)
        AddCommGrpCat.{u+1}).counit) ≪≫
      Functor.rightUnitor _
    let adj' := adj.ofNatIsoRight ε
    have s1 : ∀ {C : Type (u+1)} [Category.{u} C] (J' : GrothendieckTopology C)
        [HasWeakSheafify J' AddCommGrpCat.{u+1}] {Y Y' : C} (g : Y ⟶ Y')
        (G : Sheaf J' AddCommGrpCat.{u+1})
        (φ : (presheafToSheaf J' AddCommGrpCat.{u+1}).obj
          (yoneda.obj Y' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ G),
        uliftYonedaEquiv ((Adjunction.whiskerRight Cᵒᵖ AddCommGrpCat.adj).homEquiv
            (yoneda.obj Y ⋙ uliftFunctor.{u+1, u}) ((sheafToPresheaf J' AddCommGrpCat.{u+1}).obj G)
            ((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv _ G
              ((presheafToSheaf J' AddCommGrpCat.{u+1}).map
                (Functor.whiskerRight (yoneda.map g)
                  (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫ φ))) =
          ((sheafToPresheaf J' AddCommGrpCat.{u+1}).obj G ⋙ forget AddCommGrpCat.{u+1}).map g.op
            (uliftYonedaEquiv ((Adjunction.whiskerRight Cᵒᵖ AddCommGrpCat.adj).homEquiv
              (yoneda.obj Y' ⋙ uliftFunctor.{u+1, u}) ((sheafToPresheaf J' AddCommGrpCat.{u+1}).obj G)
              ((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv _ G φ))) := by
      intro C _ J' _ Y Y' g G φ
      have e1 := (sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv_naturality_left
        (Functor.whiskerRight (yoneda.map g) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) φ
      have e2 := (Adjunction.whiskerRight Cᵒᵖ AddCommGrpCat.adj).homEquiv_naturality_left
        (uliftYoneda.{u+1}.map g) ((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv _ G φ)
      have e3 := uliftYonedaEquiv_naturality
        (F := (sheafToPresheaf J' AddCommGrpCat.{u+1}).obj G ⋙ forget AddCommGrpCat.{u+1})
        ((Adjunction.whiskerRight Cᵒᵖ AddCommGrpCat.adj).homEquiv
          (yoneda.obj Y' ⋙ uliftFunctor.{u+1, u}) ((sheafToPresheaf J' AddCommGrpCat.{u+1}).obj G)
          ((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv _ G φ)) g.op
      refine Eq.trans ?_ e3.symm
      refine Eq.trans ?_ (congrArg uliftYonedaEquiv e2)
      exact congrArg (fun t => uliftYonedaEquiv ((Adjunction.whiskerRight Cᵒᵖ AddCommGrpCat.adj).homEquiv
            (yoneda.obj Y ⋙ uliftFunctor.{u+1, u}) ((sheafToPresheaf J' AddCommGrpCat.{u+1}).obj G) t))
        e1
    have s2 : ∀ (F F' : Sheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1} ⥤ Type (u+1))
        (τ : F' ⟶ F)
        {A A' B B' : Sheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}}
        (rA : F.CorepresentableBy A) (rA' : F'.CorepresentableBy A')
        (rB : F.CorepresentableBy B) (rB' : F'.CorepresentableBy B')
        (a : A ⟶ A') (b : B ⟶ B'),
        (∀ {G : Sheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}} (φ : A' ⟶ G),
          rA.homEquiv (a ≫ φ) = τ.app G (rA'.homEquiv φ)) →
        (∀ {G : Sheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}} (φ : B' ⟶ G),
          rB.homEquiv (b ≫ φ) = τ.app G (rB'.homEquiv φ)) →
        a ≫ (rA'.uniqueUpToIso rB').hom = (rA.uniqueUpToIso rB).hom ≫ b := by
      intro F F' τ A A' B B' rA rA' rB rB' a b ha hb
      show a ≫ rA'.homEquiv.symm (rB'.homEquiv (𝟙 _)) = rA.homEquiv.symm (rB.homEquiv (𝟙 _)) ≫ b
      apply rA.homEquiv.injective
      have hb1 := hb (𝟙 _)
      rw [Category.comp_id] at hb1
      rw [ha, Equiv.apply_symm_apply, rA.homEquiv_comp, Equiv.apply_symm_apply, ← rB.homEquiv_comp,
        Category.id_comp, hb1]
    let rep : ∀ {C : Type (u+1)} [Category.{u} C] (J' : GrothendieckTopology C)
        [HasWeakSheafify J' AddCommGrpCat.{u+1}] (Y : C),
        (sheafToPresheaf J' AddCommGrpCat.{u+1} ⋙ (evaluation Cᵒᵖ AddCommGrpCat.{u+1}).obj
          (Opposite.op Y) ⋙ forget AddCommGrpCat.{u+1}).CorepresentableBy
          ((presheafToSheaf J' AddCommGrpCat.{u+1}).obj
            (yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) :=
      fun {C} _ J' _ Y =>
        { homEquiv := fun {G} =>
            ((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv _ G).trans
              (((Adjunction.whiskerRight Cᵒᵖ AddCommGrpCat.adj).homEquiv
                (yoneda.obj Y ⋙ uliftFunctor.{u+1, u}) _).trans uliftYonedaEquiv)
          homEquiv_comp := fun {G G'} f g => by
            simp only [Equiv.trans_apply, Adjunction.homEquiv_naturality_right]
            rfl }
    let r3 : ∀ T : X.Etale, (sheafToPresheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1} ⋙
          (evaluation (E.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj
          (Opposite.op (Φ.obj T)) ⋙ forget AddCommGrpCat.{u+1}).CorepresentableBy
          (Λ.obj ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
            (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) := fun T =>
      { homEquiv := fun {G} => (adj'.homEquiv _ G).trans (rep (Scheme.smallEtaleTopology X) T).homEquiv
        homEquiv_comp := fun {G G'} f k => by
          show (rep (Scheme.smallEtaleTopology X) T).homEquiv (adj'.homEquiv _ G' (k ≫ f)) = _
          rw [Adjunction.homEquiv_naturality_right, (rep (Scheme.smallEtaleTopology X) T).homEquiv_comp]
          rfl }
    refine ⟨fun T => (r3 T).uniqueUpToIso (rep (Scheme.smallEtaleTopology E) (Φ.obj T)), ?_⟩
    intro T T' c
    refine s2 _ _ (Functor.whiskerLeft (sheafToPresheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1})
        (Functor.whiskerRight ((evaluation (E.Etale)ᵒᵖ AddCommGrpCat.{u+1}).map (Φ.map c).op)
          (forget AddCommGrpCat.{u+1})))
      (r3 T) (r3 T') (rep (Scheme.smallEtaleTopology E) (Φ.obj T))
      (rep (Scheme.smallEtaleTopology E) (Φ.obj T')) _ _ ?_ ?_
    · intro G φ
      show (rep (Scheme.smallEtaleTopology X) T).homEquiv (adj'.homEquiv _ G (Λ.map _ ≫ φ)) = _
      rw [Adjunction.homEquiv_naturality_left]
      exact s1 (Scheme.smallEtaleTopology X) c
        ((Φ.sheafPushforwardContinuous AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology X)
          (Scheme.smallEtaleTopology E)).obj G) (adj'.homEquiv _ G φ)
    · intro G φ
      exact s1 (Scheme.smallEtaleTopology E) (Φ.map c) G φ
  obtain ⟨θ, hθ⟩ := hfree s' L' hadj

  have hterm : ∀ (Z : Scheme.{u}) (V : Z.Etale), IsIso V.hom → Nonempty (Limits.IsTerminal V) := by
    intro Z V hV
    exact ⟨Limits.IsTerminal.ofUniqueHom
      (fun W => MorphismProperty.Over.homMk (W.hom ≫ inv V.hom) (by simp) trivial)
      (fun W m => MorphismProperty.Over.Hom.ext (by
        show m.left = W.hom ≫ inv V.hom
        rw [IsIso.eq_comp_inv]
        exact MorphismProperty.Over.w m))⟩

  have hlhs : ∀ (Z : Scheme.{u}) (V : Z.Etale) (F : (Z.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1})
      (η : yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ F),
      (((presheafToSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).map η).hom.app
          (Opposite.op V)).hom (wcFtcGen Z V) =
        ((toSheafify (Scheme.smallEtaleTopology Z) F).app (Opposite.op V)).hom
          ((η.app (Opposite.op V)).hom (FreeAbelianGroup.of (ULift.up (𝟙 V)))) := by
    intro Z V F η
    exact (congrArg (fun k => (k.app (Opposite.op V)).hom (FreeAbelianGroup.of (ULift.up (𝟙 V))))
      (toSheafify_naturality (Scheme.smallEtaleTopology Z) η)).symm
  have hnat : ∀ (Z : Scheme.{u}) (V V' : Z.Etale) (g : V' ⟶ V),
      ((wcFtcFS Z V).obj.map g.op).hom (wcFtcGen Z V) =
        ((toSheafify (Scheme.smallEtaleTopology Z)
          (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app (Opposite.op V')).hom
          (FreeAbelianGroup.of (ULift.up g)) := by
    intro Z V V' g
    have h := NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology Z)
      (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) g.op
      (FreeAbelianGroup.of (ULift.up (𝟙 V)))
    have e : ((yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map g.op).hom
        (FreeAbelianGroup.of (ULift.up (𝟙 V))) = FreeAbelianGroup.of (ULift.up g) := by
      change FreeAbelianGroup.of (ULift.up (g ≫ 𝟙 V)) = _
      rw [Category.comp_id]
    refine h.symm.trans (congrArg (fun z => ((toSheafify (Scheme.smallEtaleTopology Z)
      (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app (Opposite.op V')).hom z) e)

  have yonU : ∀ (Z : Scheme.{u}) (V : Z.Etale) (F : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
      (φ ψ : wcFtcFS Z V ⟶ F),
      (φ.hom.app (Opposite.op V)).hom (wcFtcGen Z V) = (ψ.hom.app (Opposite.op V)).hom (wcFtcGen Z V) →
      φ = ψ := by
    intro Z V F φ ψ h
    apply Sheaf.hom_ext
    apply sheafify_hom_ext _ φ.hom ψ.hom F.property
    apply NatTrans.ext
    funext W
    apply AddCommGrpCat.hom_ext
    refine FreeAbelianGroup.lift_ext _ _ (fun t => ?_)
    have e : (FreeAbelianGroup.of t : FreeAbelianGroup (ULift.{u+1} (W.unop ⟶ V))) =
        ((yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map t.down.op).hom
          (FreeAbelianGroup.of (ULift.up (𝟙 V))) := by
      change _ = FreeAbelianGroup.of (ULift.up (t.down ≫ 𝟙 V))
      rw [Category.comp_id]
      rfl
    have nφ := NatTrans.naturality_apply
      (toSheafify (Scheme.smallEtaleTopology Z) (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫ φ.hom)
      t.down.op (FreeAbelianGroup.of (ULift.up (𝟙 V)))
    have nψ := NatTrans.naturality_apply
      (toSheafify (Scheme.smallEtaleTopology Z) (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫ ψ.hom)
      t.down.op (FreeAbelianGroup.of (ULift.up (𝟙 V)))
    exact (congrArg (fun z => ((toSheafify (Scheme.smallEtaleTopology Z)
        (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫ φ.hom).app W).hom z) e).trans
      (nφ.trans ((congrArg (fun z => (F.obj.map t.down.op).hom z) h).trans (nψ.symm.trans
        (congrArg (fun z => ((toSheafify (Scheme.smallEtaleTopology Z)
          (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫ ψ.hom).app W).hom z) e).symm)))

  have hfreeT : ∀ (Z : Scheme.{u}) (T : Z.Etale), Limits.IsTerminal T →
      ∃ e : wcFtcFS Z T ≅ (constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} ℤ)),
        (e.hom.hom.app (Opposite.op T)).hom (wcFtcGen Z T) = wcConstSec Z (ULift.{u+1} ℤ) T (ULift.up 1) := by
    intro Z T hT
    let f : ∀ V : (Z.Etale)ᵒᵖ, FreeAbelianGroup (ULift.{u+1} (V.unop ⟶ T)) →+ ULift.{u+1} ℤ :=
      fun V => FreeAbelianGroup.lift (fun _ => (ULift.up 1 : ULift.{u+1} ℤ))
    let g : ∀ V : (Z.Etale)ᵒᵖ, ULift.{u+1} ℤ →+ FreeAbelianGroup (ULift.{u+1} (V.unop ⟶ T)) :=
      fun V => AddMonoidHom.mk' (fun n => n.down • FreeAbelianGroup.of (ULift.up (hT.from V.unop)))
        (fun a b => add_zsmul _ _ _)
    have hfg : ∀ V, (f V).comp (g V) = AddMonoidHom.id _ := by
      intro V
      apply AddMonoidHom.ext
      intro n
      show FreeAbelianGroup.lift (fun _ => (ULift.up 1 : ULift.{u+1} ℤ))
        (n.down • FreeAbelianGroup.of (ULift.up (hT.from V.unop))) = n
      rw [map_zsmul, FreeAbelianGroup.lift_apply_of]
      apply ULift.ext
      show n.down • (1 : ℤ) = n.down
      rw [smul_eq_mul, mul_one]
    have hgf : ∀ V, (g V).comp (f V) = AddMonoidHom.id _ := by
      intro V
      refine FreeAbelianGroup.lift_ext _ _ (fun t => ?_)
      show (FreeAbelianGroup.lift (fun _ => (ULift.up 1 : ULift.{u+1} ℤ)) (FreeAbelianGroup.of t)).down •
        FreeAbelianGroup.of (ULift.up (hT.from V.unop)) = FreeAbelianGroup.of t
      rw [FreeAbelianGroup.lift_apply_of]
      show (1 : ℤ) • FreeAbelianGroup.of (ULift.up (hT.from V.unop)) = FreeAbelianGroup.of t
      rw [one_zsmul]
      congr 1
      apply ULift.ext
      exact hT.hom_ext _ _
    let β : (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≅
        (Functor.const (Z.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)) :=
      NatIso.ofComponents
        (fun V => AddEquiv.toAddCommGrpIso (AddMonoidHom.toAddEquiv (f V) (g V) (hgf V) (hfg V)))
        (fun {V W} h => by
          apply AddCommGrpCat.hom_ext
          refine FreeAbelianGroup.lift_ext _ _ (fun t => ?_)
          exact (FreeAbelianGroup.lift_apply_of _ _).trans (FreeAbelianGroup.lift_apply_of _ _).symm)
    refine ⟨(presheafToSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).mapIso β, ?_⟩
    refine (hlhs Z T _ β.hom).trans ?_
    have h2 : (β.hom.app (Opposite.op T)).hom (FreeAbelianGroup.of (ULift.up (𝟙 T))) = ULift.up 1 := by
      show f (Opposite.op T) (FreeAbelianGroup.of (ULift.up (𝟙 T))) = ULift.up 1
      exact FreeAbelianGroup.lift_apply_of _ _
    rw [h2]
    rfl

  have hgenmap : ∀ (Z : Scheme.{u}) (V W : Z.Etale) (c : V ⟶ W),
      (((presheafToSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).map
        (Functor.whiskerRight (yoneda.map c) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))).hom.app
          (Opposite.op V)).hom (wcFtcGen Z V) =
      ((wcFtcFS Z W).obj.map c.op).hom (wcFtcGen Z W) := by
    intro Z V W c
    have e : ((Functor.whiskerRight (yoneda.map c) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
        (Opposite.op V)).hom (FreeAbelianGroup.of (ULift.up (𝟙 V))) = FreeAbelianGroup.of (ULift.up c) := by
      change FreeAbelianGroup.of (ULift.up (𝟙 V ≫ c)) = _
      rw [Category.id_comp]
    refine (hlhs Z V _ _).trans ?_
    refine Eq.trans ?_ (hnat Z W V c).symm
    exact congrArg (fun z => ((toSheafify (Scheme.smallEtaleTopology Z)
      (yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app (Opposite.op V)).hom z) e
  obtain ⟨hTX⟩ := hterm X (Scheme.Etale.mk (𝟙 X)) (by change IsIso (𝟙 X); infer_instance)
  obtain ⟨eX, heX⟩ := hfreeT X _ hTX
  let c : U ⟶ Scheme.Etale.mk (𝟙 X) := hTX.from U
  have hfac : ι = (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
      (Functor.whiskerRight (yoneda.map c) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫ eX.hom := by
    apply yonU X U _ ι _
    refine hι.trans ?_
    have n1 := NatTrans.naturality_apply eX.hom.hom c.op (wcFtcGen X (Scheme.Etale.mk (𝟙 X)))
    have n2 := NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology X)
      ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))) c.op (ULift.up 1 : ULift.{u+1} ℤ)
    have hg := hgenmap X U _ c
    refine Eq.trans ?_ (congrArg (fun z => (eX.hom.hom.app (Opposite.op U)).hom z) hg).symm
    refine Eq.trans ?_ n1.symm
    refine Eq.trans ?_ (congrArg (fun z => ((((constantSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))).obj.map c.op)).hom z) heX).symm
    exact n2

  obtain ⟨hTY⟩ := hterm Y (Scheme.Etale.mk (𝟙 Y)) (by change IsIso (𝟙 Y); infer_instance)
  obtain ⟨hB⟩ := hterm Y ((wcEtBaseChange s').obj (Scheme.Etale.mk (𝟙 X))) (by
    change IsIso (Limits.pullback.snd (𝟙 X) s')
    infer_instance)
  obtain ⟨eY, -⟩ := hfreeT Y _ hTY
  let σ : Scheme.Etale.mk (𝟙 Y) ⟶ (wcEtBaseChange s').obj U :=
    MorphismProperty.Over.homMk (Limits.pullback.lift s (𝟙 Y) (hs.trans (Category.id_comp s').symm))
      (Limits.pullback.lift_snd _ _ _) trivial
  haveI hj : IsIso (σ ≫ (wcEtBaseChange s').map c) := Limits.isIso_of_isTerminal hTY hB _
  let H : Y.Etale ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} :=
    yoneda ⋙ (Functor.whiskeringRight _ _ _).obj (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⋙
      presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}
  have hθ' : (θ U).inv ≫ L'.map ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
      (Functor.whiskerRight (yoneda.map c) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) =
      H.map ((wcEtBaseChange s').map c) ≫ (θ (Scheme.Etale.mk (𝟙 X))).inv := by
    rw [Iso.inv_comp_eq, ← Category.assoc, Iso.eq_comp_inv]
    exact hθ c
  refine ⟨eY.inv ≫ H.map σ ≫ (θ U).inv, ?_⟩
  have key : (eY.inv ≫ H.map σ ≫ (θ U).inv) ≫ L'.map ι =
      eY.inv ≫ H.map (σ ≫ (wcEtBaseChange s').map c) ≫ (θ (Scheme.Etale.mk (𝟙 X))).inv ≫
        L'.map eX.hom := by
    rw [hfac, L'.map_comp, H.map_comp]
    simp only [Category.assoc]
    rw [reassoc_of% hθ']
  rw [key]
  infer_instance

theorem wc_et_ext_pull_section_injective : ∀ {X Y : Scheme.{u}} (p : X ⟶ Y) (m q : ℕ), letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _; letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _; ∃ P : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) q →+ Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) q, ∀ (U : X.Etale) (ι : wcFtcFS X U ⟶ (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))), (ι.hom.app (Opposite.op U)).hom (wcFtcGen X U) = wcConstSec X (ULift.{u+1} ℤ) U (ULift.up 1) → ∀ (s : Y ⟶ U.left), s ≫ U.hom ≫ p = 𝟙 Y → ∀ x, (Abelian.Ext.mk₀ ι).comp (P x) (zero_add q) = 0 → x = 0 :=
by
  intro X Y p m q
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _

  obtain ⟨L, ⟨adj⟩, hL, ⟨ε⟩⟩ := wc_et_push_left_adjoint p
  haveI := hL
  haveI : (wcEtPush p).IsRightAdjoint := adj.isRightAdjoint
  haveI : (wcEtPush p).PreservesZeroMorphisms :=
    Functor.preservesZeroMorphisms_of_isRightAdjoint (wcEtPush p)
  haveI : (wcEtPush p).Additive := Functor.additive_of_preserves_binary_products (wcEtPush p)
  haveI : L.Additive := adj.left_adjoint_additive
  haveI : Limits.PreservesColimitsOfSize.{0, 0} L := adj.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits L :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits L
  obtain ⟨μ⟩ := wc_et_left_adjoint_const_zmod L ⟨ε⟩ m
  refine ⟨AddMonoidHom.mk' (fun x => (Abelian.Ext.mk₀ ε.inv).comp
      ((Abelian.Ext.mapExactFunctor L x).comp (Abelian.Ext.mk₀ μ.hom) (add_zero q)) (zero_add q))
    (fun a b => by
      rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.add_comp, Abelian.Ext.comp_add]), ?_⟩
  intro U ι hι s hs x hx
  have hx' : (Abelian.Ext.mk₀ ι).comp ((Abelian.Ext.mk₀ ε.inv).comp
      ((Abelian.Ext.mapExactFunctor L x).comp (Abelian.Ext.mk₀ μ.hom) (add_zero q)) (zero_add q))
      (zero_add q) = 0 := hx

  obtain ⟨s', hs'⟩ : ∃ s' : Y ⟶ X, s ≫ U.hom = s' := ⟨_, rfl⟩
  have hsp : s' ≫ p = 𝟙 Y := by rw [← hs', Category.assoc]; exact hs
  obtain ⟨L', ⟨adj'⟩, hL', -⟩ := wc_et_push_left_adjoint s'
  haveI := hL'
  haveI : (wcEtPush s').IsRightAdjoint := adj'.isRightAdjoint
  haveI : (wcEtPush s').PreservesZeroMorphisms :=
    Functor.preservesZeroMorphisms_of_isRightAdjoint (wcEtPush s')
  haveI : (wcEtPush s').Additive :=
    Functor.additive_of_preserves_binary_products (wcEtPush s')
  haveI : L'.Additive := adj'.left_adjoint_additive
  haveI : Limits.PreservesColimitsOfSize.{0, 0} L' := adj'.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits L' :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits L'

  obtain ⟨e1⟩ := (wc_et_push_id_comp_iso s' p).2
  obtain ⟨e0⟩ := (wc_et_push_id_comp_iso (𝟙 Y) (𝟙 Y)).1
  let ϑ : L ⋙ L' ≅ 𝟭 (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := Adjunction.leftAdjointUniq
    ((adj.comp adj').ofNatIsoRight (e1 ≪≫ eqToIso (congrArg wcEtPush hsp) ≪≫ e0)) Adjunction.id

  obtain ⟨κ, hκ⟩ := wc_et_section_free_unit_iso s' L' ⟨adj'⟩ U ι hι s hs'

  have assoc0 : ∀ {A B C D : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}} {n : ℕ} (f : A ⟶ B) (g : B ⟶ C) (y : Abelian.Ext C D n),
      (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ g).comp y (zero_add n)) (zero_add n) =
        (Abelian.Ext.mk₀ (f ≫ g)).comp y (zero_add n) := by
    intro A B C D n f g y
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
  have assocR : ∀ {A B C D : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}} {n : ℕ} (y : Abelian.Ext A B n) (f : B ⟶ C) (g : C ⟶ D),
      (y.comp (Abelian.Ext.mk₀ f) (add_zero n)).comp (Abelian.Ext.mk₀ g) (add_zero n) =
        y.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero n) := by
    intro A B C D n y f g
    rw [Abelian.Ext.comp_assoc y (Abelian.Ext.mk₀ f) (Abelian.Ext.mk₀ g) (add_zero n)
      (add_zero 0) (by omega), Abelian.Ext.mk₀_comp_mk₀]
  have assocM : ∀ {A B C D : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}} {n : ℕ} (f : A ⟶ B) (y : Abelian.Ext B C n) (g : C ⟶ D),
      ((Abelian.Ext.mk₀ f).comp y (zero_add n)).comp (Abelian.Ext.mk₀ g) (add_zero n) =
        (Abelian.Ext.mk₀ f).comp (y.comp (Abelian.Ext.mk₀ g) (add_zero n)) (zero_add n) := by
    intro A B C D n f y g
    exact Abelian.Ext.comp_assoc _ _ _ (zero_add n) (add_zero n) (by omega)
  have h1 := congrArg (Abelian.Ext.mapExactFunctor L') hx'
  simp only [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
    Abelian.Ext.mapExactFunctor_zero] at h1
  rw [assoc0] at h1
  have hN : (Abelian.Ext.mapExactFunctor L' (Abelian.Ext.mapExactFunctor L x)).comp
      (Abelian.Ext.mk₀ (ϑ.hom.app ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))))) (add_zero q) =
      (Abelian.Ext.mk₀ (ϑ.hom.app ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))))).comp x (zero_add q) := by
    have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp x ϑ.hom
    rw [Abelian.Ext.comp_mapExactFunctor, Abelian.Ext.id_mapExactFunctor] at h
