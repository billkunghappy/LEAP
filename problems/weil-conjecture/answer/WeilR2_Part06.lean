    intro x
    have hpt : ∀ y : Spec (.of (IsLocalRing.ResidueField A)), r y = IsLocalRing.closedPoint A := by
      intro y
      rw [hr, Spec.map_base]
      exact IsLocalRing.PrimeSpectrum.comap_residue A y
    constructor
    · rintro ⟨y, rfl⟩
      exact hpt y
    · intro hx
