theorem wc_et_zero_dim_open_vanishing : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : Scheme.{u}) (fW : W ⟶ Spec (.of Ω)) [IsProper fW], topologicalKrullDim W ≤ ((0 : ℕ) : WithBot ℕ∞) → ∀ (V : Scheme.{u}) (ι : V ⟶ W) [IsOpenImmersion ι] (m : ℕ), m ≠ 0 → ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh V m q) :=
by
  intro Ω _ _ W fW _ hW V ι _ m hm q hq

  have s1 : ∀ (X : Type u) [TopologicalSpace X] [TopologicalSpace.NoetherianSpace X] [T0Space X],
      topologicalKrullDim X ≤ ((0 : ℕ) : WithBot ℕ∞) → ∀ S : Set X, IsClosed S := by
    intro X _ _ _ hX S
    have hmax : ∀ Z : TopologicalSpace.IrreducibleCloseds X, IsMax Z := by
      rw [topologicalKrullDim, Nat.cast_zero] at hX
      exact Order.krullDim_nonpos_iff_forall_isMax.mp hX
    haveI : T1Space X := by
      rw [t1Space_iff_specializes_imp_eq]
      intro x y hxy
      have h1 : closure ({y} : Set X) ⊆ closure ({x} : Set X) :=
        specializes_iff_closure_subset.mp hxy
      let Cx : TopologicalSpace.IrreducibleCloseds X :=
        ⟨closure {x}, isIrreducible_singleton.closure, isClosed_closure⟩
      let Cy : TopologicalSpace.IrreducibleCloseds X :=
        ⟨closure {y}, isIrreducible_singleton.closure, isClosed_closure⟩
      have h2 : Cy ≤ Cx := h1
      have h3 : Cx ≤ Cy := hmax Cy h2
      have h3' : closure ({x} : Set X) ⊆ closure ({y} : Set X) := h3
      have h4 : closure ({x} : Set X) = closure {y} := Set.Subset.antisymm h3' h1
      exact (inseparable_iff_closure_eq.mpr h4).eq
    have hcomp : ∀ Z ∈ irreducibleComponents X, Z.Finite := by
      intro Z hZ
      have hirr : IsIrreducible Z := hZ.prop
      have hcl : IsClosed Z := isClosed_of_mem_irreducibleComponents Z hZ
      obtain ⟨x, hx⟩ := hirr.nonempty
      let Px : TopologicalSpace.IrreducibleCloseds X :=
        ⟨{x}, isIrreducible_singleton, isClosed_singleton⟩
      let Pz : TopologicalSpace.IrreducibleCloseds X := ⟨Z, hirr, hcl⟩
      have h1 : Px ≤ Pz := Set.singleton_subset_iff.mpr hx
      have h2 : Pz ≤ Px := hmax Px h1
      have h2' : Z ⊆ {x} := h2
      exact (Set.finite_singleton x).subset h2'
    have huniv : (Set.univ : Set X).Finite := by
      rw [← sUnion_irreducibleComponents]
      exact TopologicalSpace.NoetherianSpace.finite_irreducibleComponents.sUnion hcomp
    exact (huniv.subset (Set.subset_univ S)).isClosed

  haveI : IsLocallyNoetherian W := LocallyOfFiniteType.isLocallyNoetherian fW
  haveI : CompactSpace W := QuasiCompact.compactSpace_of_compactSpace fW
  haveI : IsNoetherian W := ⟨⟩

  have hcl : IsClosed (Set.range ⇑ι) := s1 W hW _
  haveI : IsClosedImmersion ι := IsClosedImmersion.of_isPreimmersion ι hcl

  haveI : IsProper (ι ≫ fW) := inferInstance
  have hV : topologicalKrullDim V ≤ ((0 : ℕ) : WithBot ℕ∞) :=
    (Topology.IsInducing.topologicalKrullDim_le ι.isOpenEmbedding.isInducing).trans hW

  exact wc_et_zero_dim_vanishing Ω V (ι ≫ fW) hV m hm q (by omega)

theorem wc_et_affine_open_curve_reduction : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ℓ : ℕ), ℓ.Prime → (ℓ : Ω) ≠ 0 → (∀ (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX], IrreducibleSpace X → (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) → topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) → ∀ (V : Scheme.{u}) (ι : V ⟶ X) [IsOpenImmersion ι] [IsAffine V], ∀ q : ℕ, 2 ≤ q → Subsingleton (wcEtCoh V ℓ q)) → (∀ (W : Scheme.{u}) (fW : W ⟶ Spec (.of Ω)) [IsProper fW], topologicalKrullDim W ≤ ((0 : ℕ) : WithBot ℕ∞) → ∀ (V : Scheme.{u}) (ι : V ⟶ W) [IsOpenImmersion ι], ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh V ℓ q)) → ∀ (W : Scheme.{u}) (fW : W ⟶ Spec (.of Ω)) [IsProper fW], topologicalKrullDim W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (V : Scheme.{u}) (ι : V ⟶ W) [IsOpenImmersion ι] [IsAffine V], ∀ q : ℕ, 2 ≤ q → Subsingleton (wcEtCoh V ℓ q) :=
by
  intro Ω _ _ ℓ hℓ hℓΩ HN HZ W fW _ hW V ι _ _ q hq
  have hℓ0 : ℓ ≠ 0 := hℓ.ne_zero

  have hEmpty : ∀ (Y : Scheme.{u}), IsEmpty Y → ∀ (m q : ℕ), Subsingleton (wcEtCoh Y m q) := by
    intro Y hY m q
    have s1 : ∀ U : Y.Etale, IsEmpty U.left := fun U => ⟨fun x => hY.false (U.hom.base x)⟩
    have s2 : ∀ U : Y.Etale, (⊥ : Sieve U) ∈ Scheme.smallEtaleTopology Y U := by
      intro U
      change (⊥ : Sieve U) ∈ Scheme.smallGrothendieckTopology @Etale Y U
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      exact ((s1 U).false x).elim
    have s4 : ∀ G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}, Limits.IsZero G := by
      intro G
      have h : Limits.IsZero G.obj :=
        Functor.isZero G.obj (fun X => (Sheaf.isTerminalOfBotCover G X.unop (s2 X.unop)).isZero)
      exact Limits.IsZero.of_full_of_faithful_of_isZero
        (sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) G h
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    have hB := s4 ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))
    have hsub : ∀ {A B : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}},
        Limits.IsZero B → Subsingleton (Abelian.Ext A B q) := by
      intro A B hB
      have hx : ∀ x : Abelian.Ext A B q, x = 0 := by
        intro x
        rw [← Abelian.Ext.comp_mk₀_id x, hB.eq_of_src (𝟙 B) 0, Abelian.Ext.mk₀_zero,
          Abelian.Ext.comp_zero]
      exact ⟨fun x y => (hx x).trans (hx y).symm⟩
    haveI := hsub (A := (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) hB
    unfold wcEtCoh
    infer_instance

  have hdim1 : ∀ x : WithBot ℕ∞, x ≤ ((1 : ℕ) : WithBot ℕ∞) → ¬ x ≤ ((0 : ℕ) : WithBot ℕ∞) →
      x = ((1 : ℕ) : WithBot ℕ∞) := by
    intro x h1 h0
    induction x using WithBot.recBotCoe with
    | bot => exact absurd bot_le h0
    | coe y =>
      induction y using ENat.recTopCoe with
      | top =>
        exfalso
        have : ((⊤ : ℕ∞) : WithBot ℕ∞) ≤ ((1 : ℕ∞) : WithBot ℕ∞) := by exact_mod_cast h1
        have h2 : (⊤ : ℕ∞) ≤ 1 := WithBot.coe_le_coe.mp this
        simp at h2
      | coe n =>
        have h1' : n ≤ 1 := by exact_mod_cast h1
        have h0' : ¬ n ≤ 0 := fun h => h0 (by exact_mod_cast h)
        have hn : n = 1 := by omega
        subst hn
        rfl

  have hBC : ∀ {Y X' Z V : Scheme.{u}} (b : X' ⟶ Y) (iZ : Z ⟶ Y) [IsClosedImmersion iZ] (ι : V ⟶ Y),
      (∀ U : Y.Opens, (U : Set Y) = (Set.range iZ)ᶜ → IsIso (b ∣_ U)) →
      ∀ U : V.Opens, (U : Set V) = (Set.range (Limits.pullback.snd iZ ι))ᶜ →
        IsIso ((Limits.pullback.fst ι b) ∣_ U) := by
    intro Y X' Z V b iZ _ ι H U hU
    let Oc : Y.Opens := ⟨(Set.range iZ)ᶜ, iZ.isClosedEmbedding.isClosed_range.isOpen_compl⟩
    have h1 := wc_isIso_restrict_pullback_fst ι b Oc (H Oc rfl)
    have hUeq : U = ι ⁻¹ᵁ Oc := by
      apply TopologicalSpace.Opens.ext
      rw [hU, Scheme.Pullback.range_snd]
      rfl
    subst hUeq
    exact h1

  have hEopen : ∀ {R X' Z O : Scheme.{u}} (b : X' ⟶ R) (iZ : Z ⟶ R) (ιO : O ⟶ R)
      [IsOpenImmersion ιO],
      ∃ φ : Limits.pullback (Limits.pullback.fst ιO b) (Limits.pullback.snd iZ ιO) ⟶
        Limits.pullback b iZ, IsOpenImmersion φ := by
    intro R X' Z O b iZ ιO _
    have s := (IsPullback.of_hasPullback (Limits.pullback.fst ιO b)
      (Limits.pullback.snd iZ ιO)).flip
    have t := IsPullback.of_hasPullback iZ ιO
    have outer := s.paste_horiz t
    rw [Limits.pullback.condition (f := ιO) (g := b)] at outer
    let φ : Limits.pullback (Limits.pullback.fst ιO b) (Limits.pullback.snd iZ ιO) ⟶
        Limits.pullback b iZ :=
      Limits.pullback.lift
        (Limits.pullback.fst (Limits.pullback.fst ιO b) (Limits.pullback.snd iZ ιO) ≫
          Limits.pullback.snd ιO b)
        (Limits.pullback.snd (Limits.pullback.fst ιO b) (Limits.pullback.snd iZ ιO) ≫
          Limits.pullback.fst iZ ιO)
        (by have hw := outer.w; simp only [Category.assoc] at hw ⊢; exact hw.symm)
    have h2 : φ ≫ Limits.pullback.snd b iZ =
        Limits.pullback.snd (Limits.pullback.fst ιO b) (Limits.pullback.snd iZ ιO) ≫
          Limits.pullback.fst iZ ιO := Limits.pullback.lift_snd _ _ _
    have h1 : φ ≫ Limits.pullback.fst b iZ =
        Limits.pullback.fst (Limits.pullback.fst ιO b) (Limits.pullback.snd iZ ιO) ≫
          Limits.pullback.snd ιO b := Limits.pullback.lift_fst _ _ _
    rw [← h2] at outer
    have hP := IsPullback.of_right outer h1 (IsPullback.of_hasPullback b iZ).flip
    exact ⟨φ, MorphismProperty.of_isPullback (P := @IsOpenImmersion) hP.flip inferInstance⟩

  have hfin0 : ∀ (W : Scheme.{u}) (fW : W ⟶ Spec (.of Ω)) [IsProper fW],
      topologicalKrullDim W ≤ ((0 : ℕ) : WithBot ℕ∞) → Finite W := by
    intro W fW _ hW
    haveI := LocallyOfFiniteType.isLocallyNoetherian fW
    haveI := QuasiCompact.compactSpace_of_compactSpace fW
    haveI : AlgebraicGeometry.IsNoetherian W := ⟨⟩
    have hmax : ∀ A : TopologicalSpace.IrreducibleCloseds W, IsMax A := by
      rw [← Order.krullDim_nonpos_iff_forall_isMax]
      exact hW
    have hT1 : T1Space W := by
      rw [t1Space_iff_specializes_imp_eq]
      intro x y hxy
      let A : TopologicalSpace.IrreducibleCloseds W :=
        ⟨closure {x}, isIrreducible_singleton.closure, isClosed_closure⟩
      let B : TopologicalSpace.IrreducibleCloseds W :=
        ⟨closure {y}, isIrreducible_singleton.closure, isClosed_closure⟩
      have hBA : B ≤ A := by
        show closure {y} ⊆ closure {x}
        exact specializes_iff_closure_subset.mp hxy
      have hAB : A ≤ B := hmax B hBA
      apply Inseparable.eq
      rw [inseparable_iff_closure_eq]
      exact le_antisymm hAB hBA
    have hcomp : ∀ Z ∈ irreducibleComponents W, Z.Finite := by
      intro Z hZ
      obtain ⟨x, hx⟩ := hZ.1.nonempty
      let A : TopologicalSpace.IrreducibleCloseds W :=
        ⟨{x}, isIrreducible_singleton, isClosed_singleton⟩
      let B : TopologicalSpace.IrreducibleCloseds W :=
        ⟨Z, hZ.1, isClosed_of_mem_irreducibleComponents Z hZ⟩
      have hAB : A ≤ B := by
        show {x} ⊆ Z
        exact Set.singleton_subset_iff.mpr hx
      have hBA : B ≤ A := hmax A hAB
      exact (Set.finite_singleton x).subset hBA
    have huniv : (Set.univ : Set W).Finite := by
      rw [← sUnion_irreducibleComponents]
      exact Set.Finite.sUnion TopologicalSpace.NoetherianSpace.finite_irreducibleComponents hcomp
    exact Set.finite_univ_iff.mp huniv

  have hfib : ∀ {R X' Z : Scheme.{u}} (b : X' ⟶ R) (iZ : Z ⟶ R) [IsClosedImmersion iZ],
      (∀ U : R.Opens, (U : Set R) = (Set.range iZ)ᶜ → IsIso (b ∣_ U)) →
      Finite ↥(Limits.pullback b iZ) → ∀ y : R, (⇑b ⁻¹' {y}).Finite := by
    intro R X' Z b iZ _ H hE y
    by_cases hy : y ∈ Set.range iZ
    · apply (Set.finite_range (Limits.pullback.fst b iZ)).subset
      rw [Scheme.Pullback.range_fst]
      intro x hx
      simp only [Set.mem_preimage, Set.mem_singleton_iff] at hx
      show b x ∈ Set.range iZ
      rw [hx]; exact hy
    · let Oc : R.Opens := ⟨(Set.range iZ)ᶜ, iZ.isClosedEmbedding.isClosed_range.isOpen_compl⟩
      haveI hiso : IsIso (b ∣_ Oc) := H Oc rfl
      apply Set.Subsingleton.finite
      intro x₁ hx₁ x₂ hx₂
      simp only [Set.mem_preimage, Set.mem_singleton_iff] at hx₁ hx₂
      have m₁ : x₁ ∈ b ⁻¹ᵁ Oc := by
        show b x₁ ∈ (Set.range iZ)ᶜ
        rw [hx₁]; exact hy
      have m₂ : x₂ ∈ b ⁻¹ᵁ Oc := by
        show b x₂ ∈ (Set.range iZ)ᶜ
        rw [hx₂]; exact hy
      obtain ⟨p₁, rfl⟩ : x₁ ∈ Set.range (b ⁻¹ᵁ Oc).ι := by rw [Scheme.Opens.range_ι]; exact m₁
      obtain ⟨p₂, rfl⟩ : x₂ ∈ Set.range (b ⁻¹ᵁ Oc).ι := by rw [Scheme.Opens.range_ι]; exact m₂
      have heq : (b ∣_ Oc ≫ Oc.ι) p₁ = (b ∣_ Oc ≫ Oc.ι) p₂ := by
        rw [morphismRestrict_ι, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
        exact hx₁.trans hx₂.symm
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at heq
      have h3 := (b ∣_ Oc).isOpenEmbedding.injective (Oc.ι.isOpenEmbedding.injective heq)
      rw [h3]

  have hfinite : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) [IsProper f],
      (∀ y : Y, (⇑f ⁻¹' {y}).Finite) → IsFinite f := by
    intro X Y f _ hf
    haveI : LocallyQuasiFinite f := by
      constructor
      intro U hU V hV e
      letI := (f.appLE U V e).hom.toAlgebra
      haveI : Algebra.FiniteType Γ(Y, U) Γ(X, V) := LocallyOfFiniteType.finiteType_appLE f hU hV e
      show Algebra.QuasiFinite Γ(Y, U) Γ(X, V)
      apply Algebra.QuasiFinite.iff_finite_comap_preimage_singleton.mpr
      intro x
      have key : ∀ p : Spec Γ(X, V),
          f (hV.fromSpec p) = hU.fromSpec (Spec.map (f.appLE U V e) p) := by
        intro p
        rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply,
          IsAffineOpen.SpecMap_appLE_fromSpec f hU hV e]
      apply ((hf (hU.fromSpec x)).preimage hV.fromSpec.isOpenEmbedding.injective.injOn).subset
      intro p hp
      simp only [Set.mem_preimage, Set.mem_singleton_iff] at hp ⊢
      rw [key p]
      congr 1
    exact IsFinite.of_isProper_of_locallyQuasiFinite f

  have P1 : ∀ (n : ℕ) (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX],
      (irreducibleComponents X).ncard = n →
      (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
      topologicalKrullDim X ≤ ((1 : ℕ) : WithBot ℕ∞) →
      ∀ (V : Scheme.{u}) (ι : V ⟶ X) [IsOpenImmersion ι] [IsAffine V],
        Subsingleton (wcEtCoh V ℓ q) := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n IH =>
      intro X fX _ hn hnorm hX V ι _ _
      by_cases hE : IsEmpty X
      · haveI : IsEmpty V := ⟨fun v => hE.false (ι v)⟩
        exact hEmpty V inferInstance ℓ q
      · haveI : Nonempty X := not_isEmpty_iff.mp hE
        obtain ⟨Z, iZ, X', b, hiZ, hb, hiso, hdisj, hirr, hnZ, hnX', hdZ, hdX', hcard⟩ :=
          wc_normal_split_component Ω X fX hnorm inferInstance
        haveI := hiZ
        haveI := hb
        haveI : IsAffine (Limits.pullback ι b) :=
          isAffine_of_isAffineHom (Limits.pullback.fst ι b)
        haveI : IsAffine (Limits.pullback iZ ι) :=
          isAffine_of_isAffineHom (Limits.pullback.snd iZ ι)
        refine wc_et_abstract_blowup_vanishing V (Limits.pullback ι b) (Limits.pullback iZ ι)
          (Limits.pullback.fst ι b) (Limits.pullback.snd iZ ι) (hBC b iZ ι hiso) ℓ hℓ0 q
          ?_ ?_ ?_
        · exact IH _ (by omega) X' (b ≫ fX) rfl hnX' (hdX'.trans hX) (Limits.pullback ι b)
            (Limits.pullback.snd ι b)
        · by_cases h0 : topologicalKrullDim Z ≤ ((0 : ℕ) : WithBot ℕ∞)
          · exact HZ Z (iZ ≫ fX) h0 (Limits.pullback iZ ι) (Limits.pullback.fst iZ ι) q
              (by omega)
          · exact HN Z (iZ ≫ fX) hirr hnZ (hdim1 _ (hdZ.trans hX) h0) (Limits.pullback iZ ι)
              (Limits.pullback.fst iZ ι) q hq
        · intro q' _
          exact hEmpty _ (Scheme.isEmpty_pullback _ _ (by
            rw [Scheme.Pullback.range_fst, Scheme.Pullback.range_snd]
            exact Disjoint.preimage _ hdisj)) ℓ q'

  have G2 : ∀ (R : Scheme.{u}) (fR : R ⟶ Spec (.of Ω)) [IsProper fR] [IsReduced R],
      topologicalKrullDim R ≤ ((1 : ℕ) : WithBot ℕ∞) →
      ∀ (O : Scheme.{u}) (ιO : O ⟶ R) [IsOpenImmersion ιO] [IsAffine O],
        Subsingleton (wcEtCoh O ℓ q) := by
    intro R fR _ _ hR O ιO _ _
    obtain ⟨X', b, Z, iZ, hb, hiZ, hiso, hn, hdX', hdZ, hdE⟩ :=
      wc_reduced_curve_normalization Ω R fR hR
    haveI := hb
    haveI := hiZ
    haveI : IsFinite b := hfinite b (hfib b iZ hiso
      (hfin0 (Limits.pullback b iZ) (Limits.pullback.snd b iZ ≫ iZ ≫ fR) hdE))
    haveI : IsAffine (Limits.pullback ιO b) := isAffine_of_isAffineHom (Limits.pullback.fst ιO b)
    refine wc_et_abstract_blowup_vanishing O (Limits.pullback ιO b) (Limits.pullback iZ ιO)
      (Limits.pullback.fst ιO b) (Limits.pullback.snd iZ ιO) (hBC b iZ ιO hiso) ℓ hℓ0 q
      ?_ ?_ ?_
    · exact P1 _ X' (b ≫ fR) rfl hn hdX' (Limits.pullback ιO b) (Limits.pullback.snd ιO b)
    · exact HZ Z (iZ ≫ fR) hdZ (Limits.pullback iZ ιO) (Limits.pullback.fst iZ ιO) q (by omega)
    · intro q' hq'
      obtain ⟨φ, hφ⟩ := hEopen b iZ ιO
      haveI := hφ
      exact HZ (Limits.pullback b iZ) (Limits.pullback.snd b iZ ≫ iZ ≫ fR) hdE _ φ q'
        (by omega)

  obtain ⟨R, r, hr, hsurj, hred⟩ := wc_reduced_subscheme_exists W
  haveI := hr
  haveI := hred
  have hdimR : topologicalKrullDim R = topologicalKrullDim W :=
    IsHomeomorph.topologicalKrullDim_eq r (isHomeomorph_iff_isEmbedding_surjective.mpr
      ⟨r.isClosedEmbedding.isEmbedding, Set.range_eq_univ.mp hsurj⟩)
  haveI : IsAffine (Limits.pullback r ι) := isAffine_of_isAffineHom (Limits.pullback.snd r ι)
  have hFR := G2 R (r ≫ fW) (by rw [hdimR]; exact hW) (Limits.pullback r ι)
    (Limits.pullback.fst r ι)
  refine wc_et_abstract_blowup_vanishing V _ (Limits.pullback r ι) (Scheme.emptyTo V)
    (Limits.pullback.snd r ι) ?_ ℓ hℓ0 q ?_ hFR ?_
  · intro U hU
    have hU' : (U : Set V) = ∅ := by
      rw [hU, Scheme.Pullback.range_snd, hsurj, Set.preimage_univ, Set.compl_univ]
    haveI : IsEmpty ↥(U : Scheme.{u}) := ⟨fun x => by
      have hx : U.ι x ∈ Set.range U.ι := ⟨x, rfl⟩
      rw [Scheme.Opens.range_ι, hU'] at hx
      exact hx⟩
    exact isIso_of_isEmpty (Scheme.emptyTo V ∣_ U)
  · exact hEmpty _ inferInstance ℓ q
  · intro q' _
    exact hEmpty _ (Scheme.isEmpty_pullback _ _
      (by rw [Set.range_eq_empty]; exact Set.empty_disjoint _)) ℓ q'

theorem wc_open_curve_integral_normal_dim : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX], IrreducibleSpace X → (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) → topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) → ∀ (V : Scheme.{u}) (ι : V ⟶ X) [IsOpenImmersion ι], Nonempty V → IsIntegral V ∧ (∀ v : V, IsIntegrallyClosed (V.presheaf.stalk v)) ∧ topologicalKrullDim V = ((1 : ℕ) : WithBot ℕ∞) :=
by
  intro Ω _ _ X fX _ hirr hnorm hdim V ι _ hV
  haveI : ∀ x : X, _root_.IsReduced (X.presheaf.stalk x) := fun x => by
    haveI := (hnorm x).1
    infer_instance
  haveI : AlgebraicGeometry.IsReduced X := isReduced_of_isReduced_stalk X
  haveI := hirr
  haveI : AlgebraicGeometry.IsIntegral X := isIntegral_of_irreducibleSpace_of_isReduced X
  haveI := hV
  refine ⟨isIntegral_of_isOpenImmersion ι, ?_, ?_⟩
  · intro v
    haveI := (hnorm (ι v)).2
    exact IsIntegrallyClosed.of_equiv (asIso (ι.stalkMap v)).commRingCatIsoToRingEquiv
  · haveI : JacobsonSpace X := LocallyOfFiniteType.jacobsonSpace fX
    have hf : Topology.IsOpenEmbedding ι := ι.isOpenEmbedding
    haveI : IrreducibleSpace V := hf.irreducibleSpace
    rw [Nat.cast_one] at hdim ⊢
    apply le_antisymm
    · rw [← hdim]; exact hf.isInducing.topologicalKrullDim_le
    · obtain ⟨y0⟩ := hV
      have hU : (Set.range ι ∩ closedPoints X).Nonempty :=
        nonempty_inter_closedPoints ⟨ι y0, y0, rfl⟩ hf.isOpen_range.isLocallyClosed
      obtain ⟨x, ⟨y, rfl⟩, hx⟩ := hU
      have hxc : IsClosed ({ι y} : Set X) := mem_closedPoints_iff.mp hx
      have hyc : IsClosed ({y} : Set V) := by
        have hpre : (ι : V → X) ⁻¹' {ι y} = {y} := by
          ext z
          simp [hf.injective.eq_iff]
        rw [← hpre]
        exact hxc.preimage ι.continuous
      have hne : ({y} : Set V) ≠ Set.univ := by
        intro h
        have hr : Set.range ι = {ι y} := by
          ext z
          constructor
          · rintro ⟨w, rfl⟩
            have hw : w ∈ ({y} : Set V) := by rw [h]; exact Set.mem_univ w
            rw [Set.mem_singleton_iff.mp hw]
            rfl
          · intro hz
            rw [Set.mem_singleton_iff.mp hz]
            exact ⟨y, rfl⟩
        have hclo : IsClopen ({ι y} : Set X) := ⟨hxc, hr ▸ hf.isOpen_range⟩
        have huniv : ({ι y} : Set X) = Set.univ := hclo.eq_univ ⟨_, rfl⟩
        have h1 : (1 : WithBot ℕ∞) ≤ Order.krullDim (TopologicalSpace.IrreducibleCloseds X) :=
          hdim.symm.le
        obtain ⟨a, b, hab⟩ := Order.one_le_krullDim_iff.mp h1
        have key : ∀ Z : TopologicalSpace.IrreducibleCloseds X, (Z : Set X) = {ι y} := by
          intro Z
          obtain ⟨z, hz⟩ := Z.isIrreducible.nonempty
          apply Set.Subset.antisymm
          · rw [huniv]
            exact Set.subset_univ _
          · intro w hw
            have hz' : z ∈ ({ι y} : Set X) := by rw [huniv]; exact Set.mem_univ z
            rw [Set.mem_singleton_iff.mp hw, ← Set.mem_singleton_iff.mp hz']
            exact hz
        have hab' : a = b := TopologicalSpace.IrreducibleCloseds.ext ((key a).trans (key b).symm)
        exact hab.ne hab'
      let a : TopologicalSpace.IrreducibleCloseds V := ⟨{y}, isIrreducible_singleton, hyc⟩
      let b : TopologicalSpace.IrreducibleCloseds V :=
        ⟨Set.univ, IrreducibleSpace.isIrreducible_univ V, isClosed_univ⟩
      have hab : a < b := by
        refine lt_of_le_of_ne ?_ ?_
        · show (a : Set V) ⊆ b
