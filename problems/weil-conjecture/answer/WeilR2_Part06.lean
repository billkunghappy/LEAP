        (T₁ i x).comp (Abelian.Ext.mk₀ (wcModConst F X h ℓ c)) (add_zero i) := by
      rw [hT₁s]; rfl
    have s2 : Abelian.Ext.mapExactFunctor
          (SheafOfModules.pushforward.{u+1} (F := wcSliceToOver X.left (wcGeomPoint F X h))
            (S := wcRingSheaf (wcGeomPoint F X h).left ℓ) (R := wcSliceRing F X h ℓ)
            (𝟙 (wcRingSheaf (wcGeomPoint F X h).left ℓ)))
          ((T₁ i x).comp (Abelian.Ext.mk₀ (wcModConst F X h ℓ c)) (add_zero i)) =
        (Abelian.Ext.mapExactFunctor
          (SheafOfModules.pushforward.{u+1} (F := wcSliceToOver X.left (wcGeomPoint F X h))
            (S := wcRingSheaf (wcGeomPoint F X h).left ℓ) (R := wcSliceRing F X h ℓ)
            (𝟙 (wcRingSheaf (wcGeomPoint F X h).left ℓ))) (T₁ i x)).comp
          (Abelian.Ext.mk₀ (wcHMConst (wcGeomPoint F X h).left ℓ c)) (add_zero i) := by
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀, hAconst]
      rfl
    exact (congrArg (Am i) s1).trans s2
  ·
    intro Dg hDg i x
    obtain ⟨adj, hc, hu⟩ := wc_xbar_frob_site_adjunction F X h
    obtain ⟨θ⟩ := wc_xbar_frob_pull_twist_iso F X h ℓ adj hc hu Dg hDg
    obtain ⟨κ⟩ := wc_slice_frob_twist_pushforward_iso F X h ℓ
    have key := @ext_twist_conj_eq _ _ _ _ _ _ _ _
      (SheafOfModules.pushforward.{u+1} (F := Over.map (wcGeomFrob F X h))
        (J := (Scheme.ProEt.topology X.left).over (wcGeomPoint F X h))
        (K := (Scheme.ProEt.topology X.left).over (wcGeomPoint F X h))
        (S := wcSliceRing F X h ℓ) (R := wcSliceRing F X h ℓ) (𝟙 (wcSliceRing F X h ℓ)))
      (SheafOfModules.pushforward.{u+1} (F := wcSliceToOver X.left (wcGeomPoint F X h))
        (S := wcRingSheaf (wcGeomPoint F X h).left ℓ) (R := wcSliceRing F X h ℓ)
        (𝟙 (wcRingSheaf (wcGeomPoint F X h).left ℓ)))
      Dg.Φ _ _ _ _ _ _ _ Dg.additive Dg.presLim Dg.presColim
      θ κ (SheafOfModules.unit (wcSliceRing F X h ℓ)) Dg.μ
      (fun w m z => wc_hm_unit_end_central (wcGeomPoint F X h).left ℓ w m z) i (T₁ i x)
    show Am i (T₁ i (wcCohFrob F X h ℓ i x)) = wcHMPull Dg i (Am i (T₁ i x))
    rw [hT₁F]
    exact key

theorem wc_abs_frob_exists (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))) :
    ∃ φ : wcXbar F X ⟶ wcXbar F X, wcIsAbsFrob φ (Nat.card F) ∧
      (wcGeomFrobX F X h ≫ φ) ≫ wcPi2 F X = wcPi2 F X :=
by
  classical

  have key : ∀ (Y : Scheme.{u}) (q : ℕ), 0 < q →
      (∀ (U : Y.Opens) (a b : Γ(Y, U)), (a + b) ^ q = a ^ q + b ^ q) →
      ∃ φ : Y ⟶ Y, wcIsAbsFrob φ q ∧ ∀ s : Γ(Y, ⊤), φ.appTop.hom s = s ^ q := by
    intro Y q hq hadd
    let fr : ∀ U : Y.Opens, Γ(Y, U) →+* Γ(Y, U) := fun U =>
      { toFun := fun s => s ^ q
        map_one' := one_pow q
        map_mul' := fun a b => mul_pow a b q
        map_zero' := zero_pow hq.ne'
        map_add' := hadd U }
    let c : Y.presheaf ⟶
        (TopCat.Presheaf.pushforward CommRingCat (𝟙 Y.toTopCat)).obj Y.presheaf :=
      { app := fun U => CommRingCat.ofHom (fr U.unop)
        naturality := by
          intro U V i
          ext s
          exact (map_pow (Y.presheaf.map i).hom s q).symm }
    let ψ : Y.toPresheafedSpace ⟶ Y.toPresheafedSpace := ⟨𝟙 _, c⟩
    have hloc : ∀ y, IsLocalHom (ψ.stalkMap y).hom := by
      intro y
      constructor
      intro a ha
      obtain ⟨U, hyU, s, rfl⟩ := Y.presheaf.exists_germ_eq a
      rw [PresheafedSpace.stalkMap_germ_apply ψ U y hyU s] at ha
      change IsUnit ((Y.presheaf.germ U y hyU).hom (s ^ q)) at ha
      rwa [map_pow, isUnit_pow_iff hq.ne'] at ha
    let φ : Y ⟶ Y := ⟨⟨ψ, hloc⟩⟩
    refine ⟨φ, ⟨fun y => rfl, fun U hU s => ?_⟩, fun s => rfl⟩
    change (Y.presheaf.map (homOfLE hU).op).hom (s ^ q) = s ^ q
    erw [show (homOfLE hU).op = 𝟙 (Opposite.op U) from rfl, Y.presheaf.map_id]
    rfl
  letI : Fintype F := Fintype.ofFinite F
  have hq : 0 < Nat.card F := Finite.card_pos

  have hadd : ∀ (U : (wcXbar F X).Opens) (a b : Γ(wcXbar F X, U)),
      (a + b) ^ Nat.card F = a ^ Nat.card F + b ^ Nat.card F := by
    intro U a b
    let f : wcXbar F X ⟶ Spec (.of F) := Limits.pullback.fst _ _ ≫ X.hom
    letI : Algebra F Γ(wcXbar F X, U) := ((Scheme.ΓSpecIso (.of F)).inv ≫ f.appTop ≫
      (wcXbar F X).presheaf.map (homOfLE le_top).op).hom.toAlgebra
    have := map_add (FiniteField.frobeniusAlgHom F Γ(wcXbar F X, U)) a b
    simp only [FiniteField.coe_frobeniusAlgHom, Fintype.card_eq_nat_card] at this
    exact this
  obtain ⟨φ, hφ, happ⟩ := key _ _ hq hadd
  set σ := (@FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F)
          (AlgebraicClosure F) _ _ _) with hσdef
  have hσ : ∀ x, σ x = x ^ Nat.card F := by
    intro x
    rw [FiniteField.coe_frobeniusAlgEquivOfAlgebraic, Fintype.card_eq_nat_card]

  have h3 : φ ≫ wcPi2 F X = wcPi2 F X ≫
      Spec.map (CommRingCat.ofHom (σ : AlgebraicClosure F →+* AlgebraicClosure F)) := by
    apply ext_of_isAffine
    rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop]
    ext s
    have e2 := Scheme.ΓSpecIso_inv_naturality
      (CommRingCat.ofHom (σ : AlgebraicClosure F →+* AlgebraicClosure F))
    have e3 : (Spec.map (CommRingCat.ofHom (σ : AlgebraicClosure F →+* AlgebraicClosure F))).appTop.hom s
        = s ^ Nat.card F := by
      obtain ⟨r, rfl⟩ : ∃ r, (Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure F))).inv.hom r = s :=
        ⟨_, Iso.hom_inv_id_apply _ s⟩
      have := congrArg (fun g => g.hom r) e2
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
      rw [← this, ← map_pow]
      congr 1
      exact hσ r
    change φ.appTop.hom ((wcPi2 F X).appTop.hom s) = (wcPi2 F X).appTop.hom
      ((Spec.map (CommRingCat.ofHom (σ : AlgebraicClosure F →+* AlgebraicClosure F))).appTop.hom s)
    rw [happ, e3, map_pow]

  have h4 : wcGeomFrobX F X h ≫ wcPi2 F X = wcPi2 F X ≫
      Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F)
          (AlgebraicClosure F) _ _ _).symm : AlgebraicClosure F →+* AlgebraicClosure F)) := by
    exact Limits.pullback.lift_snd _ _ _

  refine ⟨φ, hφ, ?_⟩
  rw [Category.assoc, h3, ← Category.assoc, h4, Category.assoc, ← Spec.map_comp]
  have e : CommRingCat.ofHom (σ : AlgebraicClosure F →+* AlgebraicClosure F) ≫
      CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F)
          (AlgebraicClosure F) _ _ _).symm : AlgebraicClosure F →+* AlgebraicClosure F) = 𝟙 _ := by
    ext x
    exact σ.symm_apply_apply x
  rw [e, Spec.map_id, Category.comp_id]

theorem wc_hm_pull_Phi_iso {S S' : Scheme.{u}} {f₁ f₂ : S' ⟶ S} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (D₁ : wcHMPullData f₁ ℓ) (hD₁ : wcHMPullCanonical D₁)
    (D₂ : wcHMPullData f₂ ℓ) (hD₂ : wcHMPullCanonical D₂)
    (α : wcProEtBC f₁ ≅ wcProEtBC f₂)
    (hα : ∀ (V : S.ProEt) (z : ↥((wcProEtBC f₁).obj V).left),
      (Limits.pullback.fst V.hom f₂) ((α.hom.app V).left z) = (Limits.pullback.fst V.hom f₁) z) :
    Nonempty (D₁.Φ ≅ D₂.Φ) :=
by
  classical
  haveI := D₁.cont
  haveI := D₂.cont
  let τ := (Functor.sheafPushforwardContinuousNatTrans α.hom RingCat.{u+1}
    (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')).app (wcRingSheaf S' ℓ)
  have hcompat : D₂.φ ≫ τ = D₁.φ := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext V
    induction V using Opposite.rec with
    | op V =>
    apply RingCat.hom_ext
    apply RingHom.ext
    intro s
    rw [hD₁ V s]
    apply ContinuousMap.ext
    intro z
    refine (congrArg (fun g : C(↥(Limits.pullback V.hom f₂), ULift.{u+1} ℚ_[ℓ]) =>
      g ((α.hom.app V).left.base z)) (hD₂ V s)).trans ?_
    let s' : C(↥V.left, ULift.{u+1} ℚ_[ℓ]) := s
    exact congrArg (fun p => s' p) (hα V z)
  let ι := SheafOfModules.pushforwardNatIso D₂.φ α ≪≫ SheafOfModules.pushforwardCongr hcompat
  exact ⟨D₁.adj.leftAdjointUniq (D₂.adj.ofNatIsoRight ι)⟩

theorem wc_rel_frob_isIso (V Y : Scheme.{u}) (q : ℕ) (p : V ⟶ Y) [WeaklyEtale p]
    (φY : Y ⟶ Y) (φV : V ⟶ V) (hφY : wcIsAbsFrob φY q) (hφV : wcIsAbsFrob φV q)
    (w : φV ≫ p = p ≫ φY)
    (hex : ∀ (T : Scheme.{u}) (t : T ⟶ Y), ∃ φT : T ⟶ T, wcIsAbsFrob φT q)
    (hnat : ∀ {A B : Scheme.{u}} (h : A ⟶ B) (φA : A ⟶ A) (φB : B ⟶ B),
      wcIsAbsFrob φA q → wcIsAbsFrob φB q → h ≫ φB = φA ≫ h) :
    IsIso (Limits.pullback.lift φV p w : V ⟶ Limits.pullback p φY) :=
by
  classical

  have s1 : ∀ {A B : Scheme.{u}} (f : A ⟶ B) [Flat f] [Mono f] (r : B ⟶ A),
      (∀ b, f (r b) = b) → (∀ a, r (f a) = a) → IsIso f := by
    intro A B f _ _ r hfr hrf
    have : Surjective f := (surjective_iff f).mpr (fun b => ⟨r b, hfr b⟩)
    have : QuasiCompact f := by
      rw [quasiCompact_iff]
      intro U _ hUc
      have h : (f : A → B) ⁻¹' U = (r : B → A) '' U := by
        ext a
        constructor
        · intro ha; exact ⟨f a, ha, hrf a⟩
        · rintro ⟨b, hb, rfl⟩
          show f (r b) ∈ U
          rw [hfr]; exact hb
      rw [h]; exact hUc.image r.continuous
    exact Flat.isIso_of_surjective_of_mono f

  have s2 : ∀ {A B : Scheme.{u}} (f : A ⟶ B) [Flat (Limits.pullback.diagonal f)]
      (ψ : Limits.pullback f f ⟶ Limits.pullback f f), (∀ z, ψ z = z) →
      ψ ≫ Limits.pullback.fst f f = ψ ≫ Limits.pullback.snd f f → Mono f := by
    intro A B f _ ψ hψpt hψeq
    have hψ : ψ = (ψ ≫ Limits.pullback.fst f f) ≫ Limits.pullback.diagonal f := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
      · rw [Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id, hψeq]
    have h1 : ∀ a, Limits.pullback.fst f f (Limits.pullback.diagonal f a) = a := by
      intro a
      rw [← Scheme.Hom.comp_apply, Limits.pullback.diagonal_fst]
      rfl
    have h2 : ∀ z, Limits.pullback.diagonal f (Limits.pullback.fst f f z) = z := by
      intro z
      conv_lhs => rw [← hψpt z]
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, ← Category.assoc, ← hψ, hψpt]
    have : IsIso (Limits.pullback.diagonal f) :=
      s1 (Limits.pullback.diagonal f) (Limits.pullback.fst f f) h2 h1
    exact (Limits.pullback.isIso_diagonal_iff f).mp inferInstance

  set Fr : V ⟶ Limits.pullback p φY := Limits.pullback.lift φV p w with hFr
  have hFrsnd : Fr ≫ Limits.pullback.snd p φY = p := Limits.pullback.lift_snd _ _ _
  have hFrfst : Fr ≫ Limits.pullback.fst p φY = φV := Limits.pullback.lift_fst _ _ _
  have : WeaklyEtale (Fr ≫ Limits.pullback.snd p φY) := by
    rw [hFrsnd]; infer_instance
  have : WeaklyEtale Fr := WeaklyEtale.of_comp Fr (Limits.pullback.snd p φY)

  obtain ⟨φW, hφW⟩ := hex (Limits.pullback p φY) (Limits.pullback.snd p φY)
  have hb : Limits.pullback.fst p φY ≫ Fr = φW := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hFrfst, hnat (Limits.pullback.fst p φY) φW φV hφW hφV]
    · rw [Category.assoc, hFrsnd, Limits.pullback.condition,
        hnat (Limits.pullback.snd p φY) φW φY hφW hφY]

  have hfr : ∀ z, Fr (Limits.pullback.fst p φY z) = z := by
    intro z
    rw [← Scheme.Hom.comp_apply, hb, hφW.1 z]
  have hrf : ∀ v, Limits.pullback.fst p φY (Fr v) = v := by
    intro v
    rw [← Scheme.Hom.comp_apply, hFrfst, hφV.1 v]

  obtain ⟨φD, hφD⟩ := hex (Limits.pullback Fr Fr) (Limits.pullback.fst Fr Fr ≫ p)
  have hD : φD ≫ Limits.pullback.fst Fr Fr = φD ≫ Limits.pullback.snd Fr Fr := by
    rw [← hnat (Limits.pullback.fst Fr Fr) φD φV hφD hφV,
      ← hnat (Limits.pullback.snd Fr Fr) φD φV hφD hφV, ← hFrfst, ← Category.assoc,
      Limits.pullback.condition, Category.assoc]
  have : Mono Fr := s2 Fr φD hφD.1 hD
  exact s1 Fr (Limits.pullback.fst p φY) hfr hrf

theorem wc_proEtBC_comp_absFrob_iso {S S' : Scheme.{u}} (g : S' ⟶ S) (φ : S ⟶ S) (q : ℕ)
    (hφ : wcIsAbsFrob φ q)
    (hex : ∀ (T : Scheme.{u}) (t : T ⟶ S), ∃ φT : T ⟶ T, wcIsAbsFrob φT q)
    (hnat : ∀ {A B : Scheme.{u}} (h : A ⟶ B) (φA : A ⟶ A) (φB : B ⟶ B),
      wcIsAbsFrob φA q → wcIsAbsFrob φB q → h ≫ φB = φA ≫ h)
    (hrel : ∀ (V : Scheme.{u}) (p : V ⟶ S) [WeaklyEtale p] (φV : V ⟶ V), wcIsAbsFrob φV q →
      ∀ (w : φV ≫ p = p ≫ φ), IsIso (Limits.pullback.lift φV p w)) :
    ∃ α : wcProEtBC (g ≫ φ) ≅ wcProEtBC g, ∀ (V : S.ProEt) (z : ↥((wcProEtBC (g ≫ φ)).obj V).left),
      (Limits.pullback.fst V.hom g) ((α.hom.app V).left z) = (Limits.pullback.fst V.hom (g ≫ φ)) z :=
by
  classical

  have s1 : ∀ {V : Scheme.{u}} (p : V ⟶ S) (φV : V ⟶ V) (w : φV ≫ p = p ≫ φ)
      (_ : IsIso (Limits.pullback.lift φV p w)),
      ∃ e : Limits.pullback p (g ≫ φ) ≅ Limits.pullback p g,
        e.hom ≫ Limits.pullback.snd p g = Limits.pullback.snd p (g ≫ φ) ∧
        e.hom ≫ Limits.pullback.fst p g ≫ φV = Limits.pullback.fst p (g ≫ φ) := by
    intro V p φV w hFr
    obtain ⟨Fr, hF1, hF2, hFi⟩ : ∃ Fr : V ⟶ Limits.pullback p φ,
        Fr ≫ Limits.pullback.fst p φ = φV ∧ Fr ≫ Limits.pullback.snd p φ = p ∧ IsIso Fr :=
      ⟨_, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _, hFr⟩
    have hE1 : inv Fr ≫ φV = Limits.pullback.fst p φ := by
      rw [IsIso.inv_comp_eq, hF1]
    have hE2 : inv Fr ≫ p = Limits.pullback.snd p φ := by
      rw [IsIso.inv_comp_eq, hF2]
    obtain ⟨k, hk1, hk2⟩ : ∃ k : Limits.pullback p (g ≫ φ) ⟶ Limits.pullback p φ,
        k ≫ Limits.pullback.fst p φ = Limits.pullback.fst p (g ≫ φ) ∧
        k ≫ Limits.pullback.snd p φ = Limits.pullback.snd p (g ≫ φ) ≫ g :=
      ⟨Limits.pullback.lift (Limits.pullback.fst p (g ≫ φ)) (Limits.pullback.snd p (g ≫ φ) ≫ g)
        (by rw [Limits.pullback.condition, Category.assoc]),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    obtain ⟨a, ha1, ha2⟩ : ∃ a : Limits.pullback p (g ≫ φ) ⟶ Limits.pullback p g,
        a ≫ Limits.pullback.fst p g = k ≫ inv Fr ∧
        a ≫ Limits.pullback.snd p g = Limits.pullback.snd p (g ≫ φ) :=
      ⟨Limits.pullback.lift (k ≫ inv Fr) (Limits.pullback.snd p (g ≫ φ))
        (by rw [Category.assoc, hE2, hk2]),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    obtain ⟨b, hb1, hb2⟩ : ∃ b : Limits.pullback p g ⟶ Limits.pullback p (g ≫ φ),
        b ≫ Limits.pullback.fst p (g ≫ φ) = Limits.pullback.fst p g ≫ φV ∧
        b ≫ Limits.pullback.snd p (g ≫ φ) = Limits.pullback.snd p g :=
      ⟨Limits.pullback.lift (Limits.pullback.fst p g ≫ φV) (Limits.pullback.snd p g)
        (by rw [Category.assoc, w, ← Category.assoc, Limits.pullback.condition, Category.assoc]),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have hbk : b ≫ k = Limits.pullback.fst p g ≫ Fr := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hk1, hb1, Category.assoc, hF1]
      · rw [Category.assoc, hk2, reassoc_of% hb2, Category.assoc, hF2, Limits.pullback.condition]
    have hab : a ≫ b = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hb1, reassoc_of% ha1, hE1, hk1, Category.id_comp]
      · rw [Category.assoc, hb2, ha2, Category.id_comp]
    have hba : b ≫ a = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, ha1, reassoc_of% hbk, IsIso.hom_inv_id, Category.comp_id,
          Category.id_comp]
      · rw [Category.assoc, ha2, hb2, Category.id_comp]
    refine ⟨⟨a, b, hab, hba⟩, ha2, ?_⟩
    show a ≫ Limits.pullback.fst p g ≫ φV = _
    rw [reassoc_of% ha1, hE1, hk1]

  have s2 : ∀ {V T : Scheme.{u}} (p : V ⟶ S) (φV : V ⟶ V) (w : φV ≫ p = p ≫ φ)
      (_ : IsIso (Limits.pullback.lift φV p w)) (m m' : T ⟶ Limits.pullback p g),
      m ≫ Limits.pullback.snd p g = m' ≫ Limits.pullback.snd p g →
      m ≫ Limits.pullback.fst p g ≫ φV = m' ≫ Limits.pullback.fst p g ≫ φV → m = m' := by
    intro V T p φV w hFr m m' h1 h2
    have h3 : (m ≫ Limits.pullback.fst p g) ≫ Limits.pullback.lift φV p w =
        (m' ≫ Limits.pullback.fst p g) ≫ Limits.pullback.lift φV p w := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, Category.assoc, Category.assoc,
          Limits.pullback.lift_fst, Category.assoc]
        exact h2
      · rw [Category.assoc, Limits.pullback.lift_snd, Category.assoc, Category.assoc,
          Limits.pullback.lift_snd, Category.assoc, Limits.pullback.condition,
          reassoc_of% h1]
    have h4 : m ≫ Limits.pullback.fst p g = m' ≫ Limits.pullback.fst p g :=
      (cancel_mono _).mp h3
    exact Limits.pullback.hom_ext h4 h1

  choose φV hφV using fun V : S.ProEt => hex V.left V.hom
  have w : ∀ V : S.ProEt, φV V ≫ V.hom = V.hom ≫ φ := fun V =>
    (hnat V.hom (φV V) φ (hφV V) hφ).symm
  have hFr : ∀ V : S.ProEt, IsIso (Limits.pullback.lift (φV V) V.hom (w V)) := fun V =>
    @hrel V.left V.hom V.prop (φV V) (hφV V) (w V)
  choose e he₁ he₂ using fun V : S.ProEt => s1 V.hom (φV V) (w V) (hFr V)

  choose c hc using fun V : S.ProEt =>
    (⟨MorphismProperty.Over.isoMk (A := (wcProEtBC (g ≫ φ)).obj V) (B := (wcProEtBC g).obj V)
      (e V) (he₁ V), MorphismProperty.Over.isoMk_hom_left _ _⟩ :
      ∃ c : (wcProEtBC (g ≫ φ)).obj V ≅ (wcProEtBC g).obj V, c.hom.left = (e V).hom)

  have hmap : ∀ (f : S' ⟶ S) {V V' : S.ProEt} (u : V ⟶ V'),
      ((wcProEtBC f).map u).left ≫ Limits.pullback.fst V'.hom f =
        Limits.pullback.fst V.hom f ≫ u.left ∧
      ((wcProEtBC f).map u).left ≫ Limits.pullback.snd V'.hom f = Limits.pullback.snd V.hom f := by
    intro f V V' u
    exact ⟨Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩

  have nat : ∀ {V V' : S.ProEt} (u : V ⟶ V'),
      (wcProEtBC (g ≫ φ)).map u ≫ (c V').hom = (c V).hom ≫ (wcProEtBC g).map u := by
    intro V V' u
    apply MorphismProperty.Over.Hom.ext
    change ((wcProEtBC (g ≫ φ)).map u).left ≫ (c V').hom.left =
      (c V).hom.left ≫ ((wcProEtBC g).map u).left
    rw [hc V, hc V']
    have key : ∀ (L1 : Limits.pullback V.hom (g ≫ φ) ⟶ Limits.pullback V'.hom (g ≫ φ))
        (L2 : Limits.pullback V.hom g ⟶ Limits.pullback V'.hom g),
        L1 ≫ Limits.pullback.fst V'.hom (g ≫ φ) = Limits.pullback.fst V.hom (g ≫ φ) ≫ u.left →
        L1 ≫ Limits.pullback.snd V'.hom (g ≫ φ) = Limits.pullback.snd V.hom (g ≫ φ) →
        L2 ≫ Limits.pullback.fst V'.hom g = Limits.pullback.fst V.hom g ≫ u.left →
        L2 ≫ Limits.pullback.snd V'.hom g = Limits.pullback.snd V.hom g →
        L1 ≫ (e V').hom = (e V).hom ≫ L2 := by
      intro L1 L2 hL1 hL1' hL2 hL2'
      apply s2 V'.hom (φV V') (w V') (hFr V')
      · rw [Category.assoc, Category.assoc, he₁ V', hL1', hL2', he₁ V]
      · rw [Category.assoc, Category.assoc, he₂ V', hL1, reassoc_of% hL2,
          hnat u.left (φV V) (φV V') (hφV V) (hφV V'), ← he₂ V, Category.assoc,
          Category.assoc]
    exact key _ _ (hmap (g ≫ φ) u).1 (hmap (g ≫ φ) u).2 (hmap g u).1 (hmap g u).2

  refine ⟨NatIso.ofComponents c nat, fun V z => ?_⟩
  change (Limits.pullback.fst V.hom g) ((c V).hom.left z) = _
  rw [hc V]
  have key : ∀ z' : ↥(Limits.pullback V.hom (g ≫ φ)),
      (Limits.pullback.fst V.hom g) ((e V).hom z') = (Limits.pullback.fst V.hom (g ≫ φ)) z' := by
    intro z'
    calc (Limits.pullback.fst V.hom g) ((e V).hom z')
        = (φV V) ((Limits.pullback.fst V.hom g) ((e V).hom z')) := ((hφV V).1 _).symm
      _ = ((e V).hom ≫ Limits.pullback.fst V.hom g ≫ φV V) z' := rfl
      _ = (Limits.pullback.fst V.hom (g ≫ φ)) z' := by rw [he₂ V]
  exact key z

theorem wc_baffling (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (φ : wcXbar F X ⟶ wcXbar F X) (hφ : wcIsAbsFrob φ (Nat.card F))
    (Dg : wcHMPullData (wcGeomFrobX F X h) ℓ) (hDg : wcHMPullCanonical Dg)
    (DF : wcHMPullData (wcGeomFrobX F X h ≫ φ) ℓ) (hDF : wcHMPullCanonical DF) :
    ∀ (n : ℕ) (x : wcHM (wcXbar F X) ℓ n), wcHMPull DF n x = wcHMPull Dg n x :=
by
  classical
  intro n x

  have hnat : ∀ {A B : Scheme.{u}} (h' : A ⟶ B) (φA : A ⟶ A) (φB : B ⟶ B),
      wcIsAbsFrob φA (Nat.card F) → wcIsAbsFrob φB (Nat.card F) → h' ≫ φB = φA ≫ h' := by
    intro A B h' φA φB hA hB
    refine Scheme.Hom.ext ?_ ?_
    · ext a
      show (h' ≫ φB) a = (φA ≫ h') a
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hB.1, hA.1]
    · intro U
      have hU : U ≤ φB ⁻¹ᵁ U := fun y hy => by
        show φB y ∈ U
        rw [hB.1]
        exact hy
      have hVh : (φA ≫ h') ⁻¹ᵁ U ≤ h' ⁻¹ᵁ U := fun y hy => by
        have h1 : (φA ≫ h') y ∈ U := hy
        rw [Scheme.Hom.comp_apply, hA.1] at h1
        exact h1
      have hVA : (φA ≫ h') ⁻¹ᵁ U ≤ φA ⁻¹ᵁ ((φA ≫ h') ⁻¹ᵁ U) := fun y hy => by
        show (φA ≫ h') (φA y) ∈ U
        rw [hA.1]
        exact hy
      rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_map, Scheme.Hom.app_eq_appLE,
        ← Scheme.Hom.appLE_comp_appLE h' φB U U _ hU hVh,
        ← Scheme.Hom.appLE_comp_appLE φA h' U _ _ hVh hVA]
      ext s
      simp only [CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply]
      rw [hA.2 _ hVA, hB.2 _ hU, map_pow]

  have hex : ∀ (T : Scheme.{u}) (t : T ⟶ wcXbar F X), ∃ φT : T ⟶ T,
      wcIsAbsFrob φT (Nat.card F) := by
    intro T t
    letI : Fintype F := Fintype.ofFinite F
    have hq : 0 < Nat.card F := Finite.card_pos
    let f : T ⟶ Spec (.of F) := t ≫ Limits.pullback.fst X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫ X.hom
    have hadd : ∀ (U : T.Opens) (a b : Γ(T, U)),
        (a + b) ^ Nat.card F = a ^ Nat.card F + b ^ Nat.card F := by
      intro U a b
      letI : Algebra F Γ(T, U) := ((Scheme.ΓSpecIso (.of F)).inv ≫ f.appTop ≫
        T.presheaf.map (homOfLE le_top).op).hom.toAlgebra
      have := map_add (FiniteField.frobeniusAlgHom F Γ(T, U)) a b
      simp only [FiniteField.coe_frobeniusAlgHom, Fintype.card_eq_nat_card] at this
      exact this
    let fr : ∀ U : T.Opens, Γ(T, U) →+* Γ(T, U) := fun U =>
      { toFun := fun s => s ^ Nat.card F
        map_one' := one_pow _
        map_mul' := fun a b => mul_pow a b _
        map_zero' := zero_pow hq.ne'
        map_add' := hadd U }
    let c : T.presheaf ⟶
        (TopCat.Presheaf.pushforward CommRingCat (𝟙 T.toTopCat)).obj T.presheaf :=
      { app := fun U => CommRingCat.ofHom (fr U.unop)
        naturality := by
          intro U V i
          ext s
          exact (map_pow (T.presheaf.map i).hom s _).symm }
    let ψ : T.toPresheafedSpace ⟶ T.toPresheafedSpace := ⟨𝟙 _, c⟩
    have hloc : ∀ y, IsLocalHom (ψ.stalkMap y).hom := by
      intro y
      constructor
      intro a ha
      obtain ⟨U, hyU, s, rfl⟩ := T.presheaf.exists_germ_eq a
      rw [PresheafedSpace.stalkMap_germ_apply ψ U y hyU s] at ha
      change IsUnit ((T.presheaf.germ U y hyU).hom (s ^ Nat.card F)) at ha
      rwa [map_pow, isUnit_pow_iff hq.ne'] at ha
    let φT : T ⟶ T := ⟨⟨ψ, hloc⟩⟩
    refine ⟨φT, ⟨fun y => rfl, fun U hU s => ?_⟩⟩
    change (T.presheaf.map (homOfLE hU).op).hom (s ^ Nat.card F) = s ^ Nat.card F
    erw [show (homOfLE hU).op = 𝟙 (Opposite.op U) from rfl, T.presheaf.map_id]
    rfl

  have hrel : ∀ (V : Scheme.{u}) (p : V ⟶ wcXbar F X) [WeaklyEtale p] (φV : V ⟶ V),
      wcIsAbsFrob φV (Nat.card F) → ∀ (w : φV ≫ p = p ≫ φ),
        IsIso (Limits.pullback.lift φV p w) := by
    intro V p _ φV hV w
    exact wc_rel_frob_isIso V (wcXbar F X) (Nat.card F) p φ φV hφ hV w hex hnat
  obtain ⟨α, hα⟩ := wc_proEtBC_comp_absFrob_iso (wcGeomFrobX F X h) φ (Nat.card F) hφ hex hnat hrel
  obtain ⟨θ⟩ := wc_hm_pull_Phi_iso DF hDF Dg hDg α hα

  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcXbar F X) ℓ)) := HasExt.standard _
  haveI := DF.additive
  haveI := DF.presLim
  haveI := DF.presColim
  haveI := Dg.additive
  haveI := Dg.presLim
  haveI := Dg.presColim
  have h2 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf (wcXbar F X) ℓ)} {a : ℕ}
      (f : A ⟶ B) (g : B ⟶ C') (z : Abelian.Ext C' D' a),
      (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ g).comp z (zero_add a)) (zero_add a) =
        (Abelian.Ext.mk₀ (f ≫ g)).comp z (zero_add a) := by
    intro A B C' D' a f g z
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
  have h3 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf (wcXbar F X) ℓ)} {a : ℕ}
      (z : Abelian.Ext A B a) (f : B ⟶ C') (g : C' ⟶ D'),
      (z.comp (Abelian.Ext.mk₀ f) (add_zero a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        z.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero a) := by
    intro A B C' D' a z f g
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  have h4 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf (wcXbar F X) ℓ)} {a : ℕ}
      (f : A ⟶ B) (z : Abelian.Ext B C' a) (g : C' ⟶ D'),
      ((Abelian.Ext.mk₀ f).comp z (zero_add a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        (Abelian.Ext.mk₀ f).comp (z.comp (Abelian.Ext.mk₀ g) (add_zero a)) (zero_add a) := by
    intro A B C' D' a f z g
    exact Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _
  have key : ∀ (y : wcHM (wcXbar F X) ℓ n)
      (E E' : SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ) ⟶
        SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ)), E ≫ E' = 𝟙 _ →
      (Abelian.Ext.mk₀ E).comp y (zero_add n) = y.comp (Abelian.Ext.mk₀ E) (add_zero n) →
      (Abelian.Ext.mk₀ E).comp (y.comp (Abelian.Ext.mk₀ E') (add_zero n)) (zero_add n) = y := by
    intro y E E' hEE hc
    rw [← h4, hc, h3, hEE, Abelian.Ext.comp_mk₀_id]
  show (Abelian.Ext.mk₀ DF.μ.inv).comp ((Abelian.Ext.mapExactFunctor DF.Φ x).comp
      (Abelian.Ext.mk₀ DF.μ.hom) (add_zero n)) (zero_add n) =
    (Abelian.Ext.mk₀ Dg.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dg.Φ x).comp
      (Abelian.Ext.mk₀ Dg.μ.hom) (add_zero n)) (zero_add n)
  have nat : (Abelian.Ext.mapExactFunctor DF.Φ x).comp
      (Abelian.Ext.mk₀ (θ.hom.app (SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ)))) (add_zero n) =
      (Abelian.Ext.mk₀ (θ.hom.app (SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ)))).comp
        (Abelian.Ext.mapExactFunctor Dg.Φ x) (zero_add n) :=
    Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp x θ.hom
  have step1 : (Abelian.Ext.mapExactFunctor DF.Φ x).comp (Abelian.Ext.mk₀ DF.μ.hom) (add_zero n) =
      ((Abelian.Ext.mk₀ (θ.hom.app (SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ)))).comp
        (Abelian.Ext.mapExactFunctor Dg.Φ x) (zero_add n)).comp
        (Abelian.Ext.mk₀ (θ.inv.app (SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ)) ≫ DF.μ.hom))
        (add_zero n) := by
    rw [← nat, h3, Iso.hom_inv_id_app_assoc]
  rw [step1, h4, h2]
  have hPe' : ((Abelian.Ext.mk₀ Dg.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dg.Φ x).comp
      (Abelian.Ext.mk₀ Dg.μ.hom) (add_zero n)) (zero_add n)).comp
      (Abelian.Ext.mk₀ (Dg.μ.inv ≫
        θ.inv.app (SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ)) ≫ DF.μ.hom)) (add_zero n) =
      (Abelian.Ext.mk₀ Dg.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dg.Φ x).comp
        (Abelian.Ext.mk₀ (θ.inv.app (SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ)) ≫ DF.μ.hom))
        (add_zero n)) (zero_add n) := by
    rw [h4, h3, Iso.hom_inv_id_assoc]
  have hcen : (Abelian.Ext.mk₀ (DF.μ.inv ≫
        θ.hom.app (SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ)) ≫ Dg.μ.hom)).comp
      ((Abelian.Ext.mk₀ Dg.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dg.Φ x).comp
        (Abelian.Ext.mk₀ Dg.μ.hom) (add_zero n)) (zero_add n)) (zero_add n) =
      ((Abelian.Ext.mk₀ Dg.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dg.Φ x).comp
        (Abelian.Ext.mk₀ Dg.μ.hom) (add_zero n)) (zero_add n)).comp
      (Abelian.Ext.mk₀ (DF.μ.inv ≫
        θ.hom.app (SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ)) ≫ Dg.μ.hom)) (add_zero n) :=
    wc_hm_unit_end_central (wcXbar F X) ℓ _ n _
  have he1 : DF.μ.inv ≫ θ.hom.app (SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ)) =
      (DF.μ.inv ≫ θ.hom.app (SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ)) ≫ Dg.μ.hom) ≫
        Dg.μ.inv := by
    simp only [Category.assoc, Iso.hom_inv_id, Category.comp_id]
  have he2 : (DF.μ.inv ≫ θ.hom.app (SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ)) ≫ Dg.μ.hom) ≫
      (Dg.μ.inv ≫ θ.inv.app (SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ)) ≫ DF.μ.hom) =
        𝟙 _ := by
    simp only [Category.assoc, Iso.hom_inv_id_assoc, Iso.hom_inv_id_app_assoc, Iso.inv_hom_id]
  rw [he1, ← h2, ← hPe']
  exact key _ _ _ he2 hcen

theorem sheafOfModules_enoughInjectives : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
    (R : Sheaf J RingCat.{u+1}), EnoughInjectives (SheafOfModules.{u+1} R) :=
by
  intro C _ J _ _ R
  have s2 : HasSeparator (PresheafOfModules.{u+1} R.obj) := by
    let G : C → PresheafOfModules.{u+1} R.obj := fun X =>
      (PresheafOfModules.free.{u+1} R.obj).obj (uliftYoneda.{u+1}.obj X)
    have key : ∀ (X : C) (M N : PresheafOfModules.{u+1} R.obj) (φ : M ⟶ N) (h : G X ⟶ M),
        uliftYonedaEquiv.{u+1}
          ((PresheafOfModules.freeAdjunction.{u+1} R.obj).homEquiv _ N (h ≫ φ)) =
          φ.app (Opposite.op X) (uliftYonedaEquiv.{u+1}
            ((PresheafOfModules.freeAdjunction.{u+1} R.obj).homEquiv _ M h)) := by
      intro X M N φ h
      rw [Adjunction.homEquiv_naturality_right, uliftYonedaEquiv_comp]
      rfl
    have hsep : (ObjectProperty.ofObj G).IsSeparating := by
      intro M N f g hfg
      apply PresheafOfModules.hom_ext
      intro Y
      obtain ⟨X⟩ := Y
      ext m
      let e := ((PresheafOfModules.freeAdjunction.{u+1} R.obj).homEquiv
        (uliftYoneda.{u+1}.obj X) M).trans uliftYonedaEquiv.{u+1}
      have h1 := hfg _ (ObjectProperty.ofObj_apply G X) (e.symm m)
      have h2 := congrArg (fun k => uliftYonedaEquiv.{u+1}
        ((PresheafOfModules.freeAdjunction.{u+1} R.obj).homEquiv _ N k)) h1
      rw [key, key] at h2
      have h3 : uliftYonedaEquiv.{u+1}
          ((PresheafOfModules.freeAdjunction.{u+1} R.obj).homEquiv _ M (e.symm m)) = m :=
        e.apply_symm_apply m
      rw [h3] at h2
      exact h2
    exact HasSeparator.mk ⟨_, hsep.isSeparator_coproduct⟩
  have h5 : AB5OfSize.{u+1, u+1} (SheafOfModules.{u+1} R) :=
    ⟨fun K _ _ =>
      haveI := HasExactColimitsOfShape.domain_of_functor K
        (PresheafOfModules.toPresheaf.{u+1} R.obj)
      (PresheafOfModules.sheafificationAdjunction.{u+1} (𝟙 R.obj)).hasExactColimitsOfShape K⟩
  have hs : HasSeparator (SheafOfModules.{u+1} R) :=
    HasSeparator.of_adjunction (PresheafOfModules.sheafificationAdjunction.{u+1} (𝟙 R.obj))
  exact @IsGrothendieckAbelian.enoughInjectives _ _ _
    (IsGrothendieckAbelian.mk.{u+1} (C := SheafOfModules.{u+1} R) inferInstance inferInstance h5 hs)

theorem ext_epi_effaces : ∀ {C : Type*} [Category C] [Abelian C] [HasExt C] [EnoughInjectives C]
    {K M : C} {n : ℕ} (z : Abelian.Ext K M (n+1)),
    ∃ (E : C) (π : E ⟶ K), Epi π ∧ (Abelian.Ext.mk₀ π).comp z (zero_add (n+1)) = 0 :=
by
  intro C _ _ _ _ K M n z
  have base : ∀ {S : ShortComplex C} (hS : S.ShortExact) (g : K ⟶ S.X₃),
      ∃ (E : C) (π : E ⟶ K), Epi π ∧
        (Abelian.Ext.mk₀ π).comp ((Abelian.Ext.mk₀ g).comp hS.extClass (zero_add 1))
          (zero_add 1) = 0 := by
    intro S hS g
    have := hS.epi_g
    refine ⟨Limits.pullback g S.g, Limits.pullback.fst g S.g,
      Abelian.epi_pullback_of_epi_g g S.g, ?_⟩
    rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
      Limits.pullback.condition, ← Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.comp_assoc_of_second_deg_zero, hS.comp_extClass, Abelian.Ext.comp_zero]
  induction n generalizing M with
  | zero =>
    let S := ShortComplex.cokernelSequence (Injective.ι M)
    have hS : S.ShortExact := ShortComplex.ShortExact.mk' (ShortComplex.cokernelSequence_exact _)
      (Injective.ι_mono M) (inferInstance : Epi (Limits.cokernel.π (Injective.ι M)))
    have : Injective S.X₂ := Injective.injective_under M
    obtain ⟨w, hw⟩ := Abelian.Ext.covariant_sequence_exact₁ K hS (z : Abelian.Ext K S.X₁ (0+1))
      (Abelian.Ext.eq_zero_of_injective _) (show 0 + 1 = 0 + 1 from rfl)
    obtain ⟨g, rfl⟩ := (Abelian.Ext.mk₀_bijective K S.X₃).2 w
    obtain ⟨E, π, hπ, h⟩ := base hS g
    refine ⟨E, π, hπ, ?_⟩
    rw [← hw]
    exact h
  | succ n ih =>
    let S := ShortComplex.cokernelSequence (Injective.ι M)
    have hS : S.ShortExact := ShortComplex.ShortExact.mk' (ShortComplex.cokernelSequence_exact _)
      (Injective.ι_mono M) (inferInstance : Epi (Limits.cokernel.π (Injective.ι M)))
    have : Injective S.X₂ := Injective.injective_under M
    obtain ⟨w, hw⟩ := Abelian.Ext.covariant_sequence_exact₁ K hS
      (z : Abelian.Ext K S.X₁ (n+1+1))
      (Abelian.Ext.eq_zero_of_injective _) (show n + 1 + 1 = n + 1 + 1 from rfl)
    obtain ⟨E, π, hπ, h⟩ := ih w
    refine ⟨E, π, hπ, ?_⟩
    have key : (Abelian.Ext.mk₀ π).comp (w.comp hS.extClass (show n + 1 + 1 = n + 1 + 1 from rfl))
        (zero_add (n + 1 + 1)) = 0 := by
      rw [← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ π) w hS.extClass (zero_add (n + 1))
        (show n + 1 + 1 = n + 1 + 1 from rfl) (show 0 + (n + 1) + 1 = n + 1 + 1 by omega), h,
        Abelian.Ext.zero_comp]
    rw [← hw]
    exact key

theorem ext_mapExact_ses_sign : ∀ {C : Type*} [Category C] [Abelian C] [HasExt C] [EnoughInjectives C]
    {D : Type*} [Category D] [Abelian D] [HasExt D] (F' F F'' : C ⥤ D) [F'.Additive] [F.Additive]
    [F''.Additive] [Limits.PreservesFiniteLimits F'] [Limits.PreservesFiniteColimits F']
    [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F]
    [Limits.PreservesFiniteLimits F''] [Limits.PreservesFiniteColimits F'']
    (α : F' ⟶ F) (β : F ⟶ F'') (hzero : ∀ X, α.app X ≫ β.app X = 0)
    (hS : ∀ X, (ShortComplex.mk (α.app X) (β.app X) (hzero X)).ShortExact)
    {X Y : C} {i k : ℕ} (x : Abelian.Ext X Y i) (h₁ : i + 1 = k) (h₂ : 1 + i = k),
    (Abelian.Ext.mapExactFunctor F'' x).comp (hS Y).extClass h₁ =
      ((-1 : ℤ) ^ i) • (hS X).extClass.comp (Abelian.Ext.mapExactFunctor F' x) h₂ :=
by
  intro C _ _ _ _ D _ _ _ F' F F'' _ _ _ _ _ _ _ _ _ α β hzero hS X Y i k x h₁ h₂

  have anti : ∀ {R1 R2 R3 : ShortComplex D} (hR1 : R1.ShortExact) (hR2 : R2.ShortExact)
      (hR3 : R3.ShortExact) (φ : R1 ⟶ R2) (ψ : R2 ⟶ R3) (w₁ : φ.τ₁ ≫ ψ.τ₁ = 0)
      (w₂ : φ.τ₂ ≫ ψ.τ₂ = 0) (w₃ : φ.τ₃ ≫ ψ.τ₃ = 0)
      (hC1 : (ShortComplex.mk φ.τ₁ ψ.τ₁ w₁).ShortExact)
      (hC3 : (ShortComplex.mk φ.τ₃ ψ.τ₃ w₃).ShortExact),
      hR3.extClass.comp hC1.extClass (show 1 + 1 = 2 from rfl) =
        -(hC3.extClass.comp hR1.extClass (show 1 + 1 = 2 from rfl)) := by
    intro R1 R2 R3 hR1 hR2 hR3 φ ψ w₁ w₂ w₃ hC1 hC3
    have := hR1.mono_f
    have := hR1.epi_g
    have := hR2.mono_f
    have := hR2.epi_g
    have := hR3.mono_f
    have hC3m : Mono φ.τ₃ := hC3.mono_f
    have hC3e : Epi ψ.τ₃ := hC3.epi_g
    obtain ⟨t, ht⟩ : ∃ t : R1.X₁ ⟶ R1.X₂ ⊞ R2.X₁, t = Limits.biprod.lift R1.f φ.τ₁ := ⟨_, rfl⟩
    obtain ⟨s, hs⟩ : ∃ s : R1.X₂ ⊞ R2.X₁ ⟶ R2.X₂, s = Limits.biprod.desc φ.τ₂ (-R2.f) :=
      ⟨_, rfl⟩
    obtain ⟨d, hd⟩ : ∃ d : R2.X₂ ⟶ R3.X₃, d = R2.g ≫ ψ.τ₃ := ⟨_, rfl⟩
    have ht1 : t ≫ Limits.biprod.fst = R1.f := by rw [ht, Limits.biprod.lift_fst]
    have ht2 : t ≫ Limits.biprod.snd = φ.τ₁ := by rw [ht, Limits.biprod.lift_snd]
    have hs1 : Limits.biprod.inl ≫ s = φ.τ₂ := by rw [hs, Limits.biprod.inl_desc]
    have hs2 : Limits.biprod.inr ≫ s = -R2.f := by rw [hs, Limits.biprod.inr_desc]
    have hsE : s = Limits.biprod.fst ≫ φ.τ₂ - Limits.biprod.snd ≫ R2.f := by
      rw [hs, Limits.biprod.desc_eq, Preadditive.comp_neg, ← sub_eq_add_neg]
    have hde : Epi d := by rw [hd]; exact epi_comp _ _
    have hsd : s ≫ d = 0 := by
      rw [hd]
      apply Limits.biprod.hom_ext'
      · rw [reassoc_of% hs1, ← Category.assoc, φ.comm₂₃, Category.assoc, w₃, Limits.comp_zero,
          Limits.comp_zero]
      · rw [reassoc_of% hs2]
        simp
    have hts : t ≫ s = 0 := by
      rw [ht, hs, Limits.biprod.lift_desc, Preadditive.comp_neg, φ.comm₁₂, add_neg_cancel]
    obtain ⟨s', hs'⟩ : ∃ s' : R1.X₂ ⊞ R2.X₁ ⟶ Limits.kernel d, s' ≫ Limits.kernel.ι d = s :=
      ⟨Limits.kernel.lift d s hsd, Limits.kernel.lift_ι _ _ _⟩
    have hts' : t ≫ s' = 0 := by
      rw [← cancel_mono (Limits.kernel.ι d), Category.assoc, hs', hts, Limits.zero_comp]
    have hE2 : (ShortComplex.mk (Limits.kernel.ι d) d (Limits.kernel.condition d)).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.kernelSequence_exact d) inferInstance hde
    have htm : Mono t := mono_of_mono_fac ht1
    have hs'e : Epi s' := by
      rw [epi_iff_surjective_up_to_refinements]
      intro A y
      have h1 : (y ≫ Limits.kernel.ι d ≫ R2.g) ≫ ψ.τ₃ = 0 := by
        rw [Category.assoc, Category.assoc, ← hd, Limits.kernel.condition, Limits.comp_zero]
      obtain ⟨A₁, π₁, hπ₁, c, hc⟩ := hC3.exact.exact_up_to_refinements _ h1
      have hc' : π₁ ≫ y ≫ Limits.kernel.ι d ≫ R2.g = c ≫ φ.τ₃ := hc
      obtain ⟨A₂, π₂, hπ₂, a, ha⟩ :=
        (epi_iff_surjective_up_to_refinements R1.g).1 inferInstance c
      have hz : (π₂ ≫ π₁ ≫ y ≫ Limits.kernel.ι d - a ≫ φ.τ₂) ≫ R2.g = 0 := by
        rw [Preadditive.sub_comp]
        simp only [Category.assoc]
        rw [hc', φ.comm₂₃, ← Category.assoc π₂ c, ha, Category.assoc, sub_self]
      obtain ⟨A₃, π₃, hπ₃, q, hq⟩ := hR2.exact.exact_up_to_refinements _ hz
      have hq' : π₃ ≫ (π₂ ≫ π₁ ≫ y ≫ Limits.kernel.ι d - a ≫ φ.τ₂) = q ≫ R2.f := hq
      refine ⟨A₃, π₃ ≫ π₂ ≫ π₁, inferInstance, Limits.biprod.lift (π₃ ≫ a) (-q), ?_⟩
      rw [← cancel_mono (Limits.kernel.ι d)]
      simp only [Category.assoc, hs']
      rw [hsE, Preadditive.comp_sub, Limits.biprod.lift_fst_assoc, Limits.biprod.lift_snd_assoc,
        Preadditive.neg_comp, sub_neg_eq_add, ← hq', Preadditive.comp_sub]
      simp only [Category.assoc]
      abel
    have hE1ex : (ShortComplex.mk t s' hts').Exact := by
      rw [ShortComplex.exact_iff_exact_up_to_refinements]
      intro A x hx
      have hx' : x ≫ s' = 0 := hx
      have hxs : x ≫ s = 0 := by
        have := congrArg (· ≫ Limits.kernel.ι d) hx'
        simp only [Category.assoc, hs', Limits.zero_comp] at this
        exact this
      have e1 : x ≫ Limits.biprod.fst ≫ φ.τ₂ = x ≫ Limits.biprod.snd ≫ R2.f := by
        rw [← sub_eq_zero, ← Preadditive.comp_sub, ← hsE]
        exact hxs
      have e2 : (x ≫ Limits.biprod.fst) ≫ R1.g = 0 := by
        rw [← cancel_mono φ.τ₃]
        simp only [Category.assoc, Limits.zero_comp]
        rw [← φ.comm₂₃, reassoc_of% e1, R2.zero, Limits.comp_zero, Limits.comp_zero]
      obtain ⟨A', π, hπ, p, hp⟩ := hR1.exact.exact_up_to_refinements _ e2
      have hp' : π ≫ x ≫ Limits.biprod.fst = p ≫ R1.f := hp
      refine ⟨A', π, hπ, p, ?_⟩
      show π ≫ x = p ≫ t
      apply Limits.biprod.hom_ext
      · simp only [Category.assoc, ht1]
        exact hp'
      · simp only [Category.assoc, ht2]
        rw [← cancel_mono R2.f]
        simp only [Category.assoc]
        rw [φ.comm₁₂, ← e1, ← reassoc_of% hp']
    have hE1 : (ShortComplex.mk t s' hts').ShortExact :=
      ShortComplex.ShortExact.mk' hE1ex htm hs'e
    obtain ⟨κ, hκ⟩ : ∃ κ : Limits.kernel d ⟶ R1.X₃, κ ≫ φ.τ₃ = Limits.kernel.ι d ≫ R2.g := by
      have : Mono (ShortComplex.mk φ.τ₃ ψ.τ₃ w₃).f := hC3.mono_f
      have h0 : (Limits.kernel.ι d ≫ R2.g) ≫ (ShortComplex.mk φ.τ₃ ψ.τ₃ w₃).g = 0 := by
        show (Limits.kernel.ι d ≫ R2.g) ≫ ψ.τ₃ = 0
        rw [Category.assoc, ← hd, Limits.kernel.condition]
      exact ⟨hC3.exact.lift _ h0, hC3.exact.lift_f _ h0⟩
    obtain ⟨κ', hκ'⟩ : ∃ κ' : Limits.kernel d ⟶ R3.X₁,
        κ' ≫ R3.f = Limits.kernel.ι d ≫ ψ.τ₂ := by
      have h0 : (Limits.kernel.ι d ≫ ψ.τ₂) ≫ R3.g = 0 := by
        rw [Category.assoc, ψ.comm₂₃, ← hd, Limits.kernel.condition]
      exact ⟨hR3.exact.lift _ h0, hR3.exact.lift_f _ h0⟩
    have N1 : hE2.extClass.comp (Abelian.Ext.mk₀ κ) (add_zero 1) =
        (Abelian.Ext.mk₀ (𝟙 _)).comp hC3.extClass (zero_add 1) :=
      hE2.extClass_naturality hC3 (ShortComplex.homMk κ R2.g (𝟙 _) hκ
        (by dsimp; rw [Category.comp_id, hd]))
    have N2 : hE1.extClass.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero 1) =
        (Abelian.Ext.mk₀ κ).comp hR1.extClass (zero_add 1) :=
      hE1.extClass_naturality hR1 (ShortComplex.homMk (𝟙 _) Limits.biprod.fst κ
        (by dsimp; rw [Category.id_comp, ht1])
        (by
          dsimp
          rw [← cancel_mono φ.τ₃, Category.assoc, Category.assoc, hκ, ← φ.comm₂₃,
            reassoc_of% hs']
          apply Limits.biprod.hom_ext'
          · rw [Limits.biprod.inl_fst_assoc, reassoc_of% hs1]
          · rw [Limits.biprod.inr_fst_assoc, reassoc_of% hs2, Limits.zero_comp,
              Preadditive.neg_comp, R2.zero, neg_zero]))
    have N3 : hE2.extClass.comp (Abelian.Ext.mk₀ κ') (add_zero 1) =
        (Abelian.Ext.mk₀ (𝟙 _)).comp hR3.extClass (zero_add 1) :=
      hE2.extClass_naturality hR3 (ShortComplex.homMk κ' ψ.τ₂ (𝟙 _) hκ'
        (by dsimp; rw [Category.comp_id, hd]; exact ψ.comm₂₃))
    have N4 : hE1.extClass.comp (Abelian.Ext.mk₀ (-𝟙 _)) (add_zero 1) =
        (Abelian.Ext.mk₀ κ').comp hC1.extClass (zero_add 1) :=
      hE1.extClass_naturality hC1 (ShortComplex.homMk (-𝟙 _) (-Limits.biprod.snd) κ'
        (by dsimp; rw [Preadditive.neg_comp, Category.id_comp, Preadditive.comp_neg, ht2])
        (by
          dsimp
          rw [← cancel_mono R3.f, Category.assoc, Category.assoc, hκ', ψ.comm₁₂,
            reassoc_of% hs']
          apply Limits.biprod.hom_ext'
          · rw [reassoc_of% hs1, w₂, Preadditive.neg_comp, Preadditive.comp_neg,
              Limits.biprod.inl_snd_assoc, Limits.zero_comp, neg_zero]
          · rw [reassoc_of% hs2, Preadditive.neg_comp, Preadditive.comp_neg,
              Limits.biprod.inr_snd_assoc, Preadditive.neg_comp]))
    rw [Abelian.Ext.comp_mk₀_id] at N2
    rw [Abelian.Ext.mk₀_neg, Abelian.Ext.comp_neg, Abelian.Ext.comp_mk₀_id,
      neg_eq_iff_eq_neg] at N4
    rw [Abelian.Ext.mk₀_id_comp] at N1 N3
    have key1 : hE2.extClass.comp hE1.extClass (show 1 + 1 = 2 from rfl) =
        hC3.extClass.comp hR1.extClass (show 1 + 1 = 2 from rfl) := by
      rw [N2, ← Abelian.Ext.comp_assoc hE2.extClass (Abelian.Ext.mk₀ κ) hR1.extClass
        (add_zero 1) (zero_add 1) rfl, N1]
    have key2 : hE2.extClass.comp hE1.extClass (show 1 + 1 = 2 from rfl) =
        -(hR3.extClass.comp hC1.extClass (show 1 + 1 = 2 from rfl)) := by
      rw [N4, Abelian.Ext.comp_neg, ← Abelian.Ext.comp_assoc hE2.extClass (Abelian.Ext.mk₀ κ')
        hC1.extClass (add_zero 1) (zero_add 1) rfl, N3]
    rw [← key1, key2, neg_neg]
  have hsmulL : ∀ {A B E : D} {a b c : ℕ} (u : Abelian.Ext A B a) (v : Abelian.Ext B E b)
      (h : a + b = c) (m : ℤ), (m • u).comp v h = m • u.comp v h := by
    intro A B E a b c u v h m
    rw [← Abelian.Ext.bilinearComp_apply_apply, map_zsmul, AddMonoidHom.zsmul_apply,
      Abelian.Ext.bilinearComp_apply_apply]
  induction i generalizing Y k with
  | zero =>
    obtain ⟨g, rfl⟩ := (Abelian.Ext.mk₀_bijective X Y).2 x
    subst h₁
    rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀, pow_zero, one_smul]
    exact ((hS X).extClass_naturality (hS Y) (ShortComplex.homMk (F'.map g) (F.map g)
      (F''.map g) (α.naturality g) (β.naturality g))).symm
  | succ n ih =>
    subst h₁
    let T := ShortComplex.mk (Injective.ι Y) (Limits.cokernel.π (Injective.ι Y))
      (Limits.cokernel.condition _)
    have hT : T.ShortExact := ShortComplex.ShortExact.mk' (ShortComplex.cokernelSequence_exact _)
      (Injective.ι_mono Y) inferInstance
    obtain ⟨x₃, rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ X hT x
      (Abelian.Ext.eq_zero_of_injective (I := Injective.under Y) _) (rfl : n + 1 = n + 1)
    have hR1 := hT.map_of_exact F'
    have hR2 := hT.map_of_exact F
    have hR3 := hT.map_of_exact F''
    have key : hR3.extClass.comp (hS Y).extClass (show 1 + 1 = 2 from rfl) =
        -((hS T.X₃).extClass.comp hR1.extClass (show 1 + 1 = 2 from rfl)) :=
      anti hR1 hR2 hR3 (T.mapNatTrans α) (T.mapNatTrans β) (hzero _) (hzero _)
        (hzero _) (hS Y) (hS _)
    have e3 : Abelian.Ext.mapExactFunctor F'' (x₃.comp hT.extClass (rfl : n + 1 = n + 1)) =
        (Abelian.Ext.mapExactFunctor F'' x₃).comp hR3.extClass (rfl : n + 1 = n + 1) := by
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass]
    have e1 : Abelian.Ext.mapExactFunctor F' (x₃.comp hT.extClass (rfl : n + 1 = n + 1)) =
        (Abelian.Ext.mapExactFunctor F' x₃).comp hR1.extClass (rfl : n + 1 = n + 1) := by
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass]
    rw [e3, e1,
      Abelian.Ext.comp_assoc (Abelian.Ext.mapExactFunctor F'' x₃) hR3.extClass (hS Y).extClass
        (rfl : n + 1 = n + 1) (show 1 + 1 = 2 from rfl) (by omega),
      key, Abelian.Ext.comp_neg,
      ← Abelian.Ext.comp_assoc (Abelian.Ext.mapExactFunctor F'' x₃) (hS T.X₃).extClass
        hR1.extClass (rfl : n + 1 = n + 1) (show 1 + 1 = 2 from rfl) (by omega),
      ih x₃ (rfl : n + 1 = n + 1) (by omega), hsmulL,
      Abelian.Ext.comp_assoc (hS X).extClass (Abelian.Ext.mapExactFunctor F' x₃) hR1.extClass
        (show 1 + n = n + 1 by omega) (rfl : n + 1 = n + 1) (by omega),
      pow_succ, mul_neg_one, neg_smul]

theorem wcst_tensorLeft_rightExact {C : Type (u+1)} [Category.{u} C] (R0 : Cᵒᵖ ⥤ CommRingCat.{u+1})
    (M : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat)) :
    (MonoidalCategory.tensorLeft M).Additive ∧
      Limits.PreservesFiniteColimits (MonoidalCategory.tensorLeft M) :=
by
  exact ⟨@Functor.additive_of_preservesBinaryBiproducts _ _ _ _ _ _ (MonoidalCategory.tensorLeft M) _ _
      (Limits.preservesBinaryBiproducts_of_preservesBinaryCoproducts (MonoidalCategory.tensorLeft M)),
    inferInstance⟩

theorem wcst_tensorLeft_flat_leftExact {C : Type (u+1)} [Category.{u} C] (R0 : Cᵒᵖ ⥤ CommRingCat.{u+1})
    (F : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat))
    [(MonoidalCategory.tensorLeft F).Additive]
    [Limits.PreservesFiniteColimits (MonoidalCategory.tensorLeft F)] :
    (∀ X, Module.Flat (R0.obj X) (F.obj X)) →
      Limits.PreservesFiniteLimits (MonoidalCategory.tensorLeft F) :=
by
  intro hF
  refine ⟨fun J _ _ => ⟨fun {K} => ?_⟩⟩
  refine Limits.preservesLimit_of_preserves_limit_cone (Limits.limit.isLimit K) ?_
  apply PresheafOfModules.evaluationJointlyReflectsLimits
  intro X
  haveI hX : Limits.PreservesFiniteLimits (MonoidalCategory.tensorLeft (F.obj X)) :=
    (fun (M : ModuleCat.{u+1} (R0.obj X)) (h : Module.Flat (R0.obj X) M) =>
      (haveI := h; (inferInstance :
        Limits.PreservesFiniteLimits (MonoidalCategory.tensorLeft M)))) (F.obj X) (hF X)
  have h₁ := Limits.isLimitOfPreserves (MonoidalCategory.tensorLeft (F.obj X))
    (Limits.isLimitOfPreserves (PresheafOfModules.evaluation (R0 ⋙ forget₂ CommRingCat RingCat) X)
      (Limits.limit.isLimit K))
  let e : PresheafOfModules.evaluation (R0 ⋙ forget₂ CommRingCat RingCat) X ⋙
      MonoidalCategory.tensorLeft (F.obj X) ≅
      MonoidalCategory.tensorLeft F ⋙
        PresheafOfModules.evaluation (R0 ⋙ forget₂ CommRingCat RingCat) X :=
    NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => by rfl)
  exact (Limits.IsLimit.mapConeEquiv e (h₁.ofIsoLimit (Functor.mapConeMapCone _))).ofIsoLimit
    (Functor.mapConeMapCone _).symm

theorem wcst_flat_presentation {C : Type (u+1)} [Category.{u} C] (R0 : Cᵒᵖ ⥤ CommRingCat.{u+1})
    (M : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat)) :
    ∃ (F L : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat)) (i : L ⟶ F) (e : F ⟶ M),
      (∀ X, Function.Exact (i.app X).hom (e.app X).hom) ∧
      (∀ X, Function.Surjective (e.app X).hom) ∧
      ∀ X, Module.Flat (R0.obj X) (F.obj X) :=
by
  classical
  refine ⟨PresheafOfModules.freeObj (M.presheaf ⋙ forget AddCommGrpCat),
    Limits.kernel (PresheafOfModules.freeObjDesc (F := M.presheaf ⋙ forget AddCommGrpCat) (G := M)
      (𝟙 _)),
    Limits.kernel.ι (PresheafOfModules.freeObjDesc (F := M.presheaf ⋙ forget AddCommGrpCat) (G := M)
      (𝟙 _)),
    PresheafOfModules.freeObjDesc (F := M.presheaf ⋙ forget AddCommGrpCat) (G := M) (𝟙 _),
    ?_, ?_, ?_⟩
  · intro X
    have h := (ShortComplex.kernelSequence_exact
      (PresheafOfModules.freeObjDesc (F := M.presheaf ⋙ forget AddCommGrpCat) (G := M)
        (𝟙 _))).map (PresheafOfModules.evaluation (R0 ⋙ forget₂ CommRingCat RingCat) X)
    exact (ShortComplex.ShortExact.moduleCat_exact_iff_function_exact _).1 h
  · intro X m
    refine ⟨ModuleCat.freeMk m, ?_⟩
    rw [PresheafOfModules.freeObjDesc_app]
    exact ModuleCat.freeDesc_apply _ _
  · intro X
    exact Module.Flat.finsupp (R := R0.obj X) (M.obj X)

theorem wcst_sheafification_isIso_iff {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
    (R : Sheaf J RingCat.{u+1}) {P₁ P₂ : PresheafOfModules.{u+1} R.obj} (f : P₁ ⟶ P₂) :
    IsIso ((PresheafOfModules.sheafification.{u+1} (𝟙 R.obj)).map f) ↔
      (Presheaf.IsLocallyInjective J ((PresheafOfModules.toPresheaf R.obj).map f) ∧
        Presheaf.IsLocallySurjective J ((PresheafOfModules.toPresheaf R.obj).map f)) :=
by
  rw [← isIso_iff_of_reflects_iso _ (SheafOfModules.toSheaf R), ← Functor.comp_map,
    NatIso.isIso_map_iff (PresheafOfModules.sheafificationCompToSheaf (𝟙 R.obj)) f,
    Functor.comp_map, ← GrothendieckTopology.W_iff,
    GrothendieckTopology.W_iff_isLocallyBijective]

theorem wcst_whiskerLeft_locallySurjective {C : Type (u+1)} [Category.{u} C]
    (J : GrothendieckTopology C) (R0 : Cᵒᵖ ⥤ CommRingCat.{u+1})
    (M : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat))
    {P₁ P₂ : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat)} (φ : P₁ ⟶ P₂) :
    Presheaf.IsLocallySurjective J ((PresheafOfModules.toPresheaf _).map φ) →
      Presheaf.IsLocallySurjective J
        ((PresheafOfModules.toPresheaf _).map (MonoidalCategoryStruct.whiskerLeft M φ)) :=
by
  intro hφ
  refine ⟨fun {U} s => ?_⟩
  have key : ∀ t : TensorProduct (R0.obj (Opposite.op U)) (M.obj (Opposite.op U))
      (P₂.obj (Opposite.op U)),
      Presheaf.imageSieve ((PresheafOfModules.toPresheaf _).map
        (MonoidalCategoryStruct.whiskerLeft M φ)) (U := U) t ∈ J U := by
    intro t
    induction t using TensorProduct.induction_on with
    | zero =>
      refine J.superset_covering ?_ (J.top_mem U)
      intro V i _
      exact ⟨0, (map_zero _).trans (map_zero _).symm⟩
    | tmul m p =>
      refine J.superset_covering ?_ (hφ.imageSieve_mem (U := U) p)
      rintro V i ⟨q, hq⟩
      have hq' : (φ.app (Opposite.op V)) q = (P₂.map i.op) p := hq
      have e := PresheafOfModulesOfCommRing.Monoidal.tensorObj_map_tmul (M₁ := M) (M₂ := P₂) i.op m p
      rw [← hq'] at e
      exact ⟨TensorProduct.tmul _ (ConcreteCategory.hom (PresheafOfModulesOfCommRing.map M i.op) m) q,
        e.symm⟩
    | add x y hx hy =>
      refine J.superset_covering ?_ (J.intersection_covering hx hy)
      rintro V i ⟨⟨q₁, h₁⟩, ⟨q₂, h₂⟩⟩
      exact ⟨q₁ + q₂, (map_add _ _ _).trans ((congrArg₂ (· + ·) h₁ h₂).trans (map_add _ _ _).symm)⟩
  exact key s

theorem wcst_whiskerLeft_locallyInjective_of_flat {C : Type (u+1)} [Category.{u} C]
    (J : GrothendieckTopology C) (R0 : Cᵒᵖ ⥤ CommRingCat.{u+1})
    (M : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat))
    {P₁ P₂ : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat)} (φ : P₁ ⟶ P₂) :
    (∀ X, Module.Flat (R0.obj X) (M.obj X)) →
    Presheaf.IsLocallyInjective J ((PresheafOfModules.toPresheaf _).map φ) →
      Presheaf.IsLocallyInjective J
        ((PresheafOfModules.toPresheaf _).map (MonoidalCategoryStruct.whiskerLeft M φ)) :=
by
  intro hM hφ
  have hsub : ∀ {F : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}} {X : Cᵒᵖ} (x y : ToType (F.obj X)),
      Presheaf.equalizerSieve (x - y) 0 ≤ Presheaf.equalizerSieve x y := by
    intro F X x y Y f hf
    simp only [Presheaf.equalizerSieve_apply, map_sub, map_zero] at hf ⊢
    exact sub_eq_zero.mp hf
  have hadd : ∀ {F : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}} {X : Cᵒᵖ} (x y : ToType (F.obj X)),
      Presheaf.equalizerSieve x 0 ⊓ Presheaf.equalizerSieve y 0 ≤
        Presheaf.equalizerSieve (x + y) 0 := by
    intro F X x y Y f hf
    rw [Sieve.inter_apply] at hf
    obtain ⟨h1, h2⟩ := hf
    simp only [Presheaf.equalizerSieve_apply, map_add, map_zero] at h1 h2 ⊢
    rw [h1, h2, add_zero]
  have s2 : ∀ (X : Cᵒᵖ)
      (z : TensorProduct (R0.obj X) (M.obj X) (LinearMap.ker (φ.app X).hom)),
      Presheaf.equalizerSieve
        (F := (PresheafOfModules.toPresheaf _).obj (MonoidalCategoryStruct.tensorObj M P₁))
        (X := X)
        (LinearMap.lTensor (M.obj X) (LinearMap.ker (φ.app X).hom).subtype z) 0 ∈ J X.unop := by
    intro X z
    induction z using TensorProduct.induction_on with
    | zero =>
      refine J.superset_covering ?_ (J.top_mem _)
      intro Y f _
      exact congrArg _ (map_zero _)
    | tmul m k =>
      have h0 : (φ.app X).hom k.1 = 0 := LinearMap.mem_ker.mp k.2
      have hk : Presheaf.equalizerSieve
          (F := (PresheafOfModules.toPresheaf _).obj P₁) (X := X) k.1 0 ∈ J X.unop := by
        haveI := hφ
        apply Presheaf.equalizerSieve_mem J ((PresheafOfModules.toPresheaf _).map φ)
        rw [map_zero]
        exact h0
      refine J.superset_covering ?_ hk
      intro Y f hf
      have hf' : (((PresheafOfModules.toPresheaf _).obj P₁).map f.op).hom k.1 =
          (((PresheafOfModules.toPresheaf _).obj P₁).map f.op).hom 0 := hf
      rw [map_zero] at hf'
      have hf'' : (P₁.map f.op).hom k.1 = 0 := hf'
      show ((PresheafOfModulesOfCommRing.Monoidal.tensorObj M P₁).map f.op).hom
          (LinearMap.lTensor (M.obj X) (LinearMap.ker (φ.app X).hom).subtype (m ⊗ₜ k)) =
        ((PresheafOfModulesOfCommRing.Monoidal.tensorObj M P₁).map f.op).hom 0
      rw [map_zero, LinearMap.lTensor_tmul, Submodule.subtype_apply]
      refine (PresheafOfModulesOfCommRing.Monoidal.tensorObj_map_tmul (M₁ := M) (M₂ := P₁)
        f.op m k.1).trans ?_
      erw [hf'']
      exact TensorProduct.tmul_zero _ _
    | add a b ha hb =>
      have e : (LinearMap.lTensor (M.obj X) (LinearMap.ker (φ.app X).hom).subtype (a + b) :
          ToType (((PresheafOfModules.toPresheaf _).obj
            (MonoidalCategoryStruct.tensorObj M P₁)).obj X)) =
          (LinearMap.lTensor (M.obj X) (LinearMap.ker (φ.app X).hom).subtype a :
            ToType (((PresheafOfModules.toPresheaf _).obj
              (MonoidalCategoryStruct.tensorObj M P₁)).obj X)) +
          (LinearMap.lTensor (M.obj X) (LinearMap.ker (φ.app X).hom).subtype b :
            ToType (((PresheafOfModules.toPresheaf _).obj
              (MonoidalCategoryStruct.tensorObj M P₁)).obj X)) :=
        map_add _ a b
      rw [e]
      exact J.superset_covering (hadd _ _) (J.intersection_covering ha hb)
  constructor
  intro X x y h
  let φX : P₁.obj X →ₗ[R0.obj X] P₂.obj X := (φ.app X).hom
  have hd : LinearMap.lTensor (M.obj X) φX (x - y) = 0 := by
    have : (((PresheafOfModules.toPresheaf _).map
        (MonoidalCategoryStruct.whiskerLeft M φ)).app X).hom (x - y) = 0 := by
      rw [map_sub, h, sub_self]
    exact this
  haveI := hM X
  have hex := Module.Flat.lTensor_exact (R := R0.obj X) (M.obj X)
    (LinearMap.exact_subtype_ker_map φX)
  obtain ⟨z, hz⟩ := (hex (x - y)).mp hd
  refine J.superset_covering (hsub x y) ?_
  have e : (x - y : ToType (((PresheafOfModules.toPresheaf _).obj
      (MonoidalCategoryStruct.tensorObj M P₁)).obj X)) =
      LinearMap.lTensor (M.obj X) (LinearMap.ker (φ.app X).hom).subtype z := hz.symm
  rw [e]
  exact s2 X z

theorem wcst_whiskerLeft_locallyInjective_of_presentation {C : Type (u+1)} [Category.{u} C]
    (J : GrothendieckTopology C) (R0 : Cᵒᵖ ⥤ CommRingCat.{u+1})
    {M F L : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat)} (i : L ⟶ F) (e : F ⟶ M) :
    (∀ X, Function.Exact (i.app X).hom (e.app X).hom) →
    (∀ X, Function.Surjective (e.app X).hom) →
    ∀ {P₁ P₂ : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat)} (φ : P₁ ⟶ P₂),
    Presheaf.IsLocallySurjective J
      ((PresheafOfModules.toPresheaf _).map (MonoidalCategoryStruct.whiskerLeft L φ)) →
    Presheaf.IsLocallyInjective J
      ((PresheafOfModules.toPresheaf _).map (MonoidalCategoryStruct.whiskerLeft F φ)) →
      Presheaf.IsLocallyInjective J
        ((PresheafOfModules.toPresheaf _).map (MonoidalCategoryStruct.whiskerLeft M φ)) :=
by
  intro hex hsurj P₁ P₂ φ hL hF

  have rows : ∀ (P : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat)) (X : Cᵒᵖ),
      Function.Exact
        (((PresheafOfModules.toPresheaf _).map (MonoidalCategoryStruct.whiskerRight i P)).app X).hom
        (((PresheafOfModules.toPresheaf _).map (MonoidalCategoryStruct.whiskerRight e P)).app X).hom ∧
      Function.Surjective
        (((PresheafOfModules.toPresheaf _).map (MonoidalCategoryStruct.whiskerRight e P)).app X).hom := by
    intro P X
    exact ⟨rTensor_exact (R := R0.obj X) (P.obj X) (hex X) (hsurj X),
      LinearMap.rTensor_surjective (R := R0.obj X) (P.obj X) (hsurj X)⟩

  have four : ∀ {A₁ B₁ C₁ A₂ B₂ C₂ : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}}
      (a₁ : A₁ ⟶ B₁) (b₁ : B₁ ⟶ C₁) (a₂ : A₂ ⟶ B₂) (b₂ : B₂ ⟶ C₂)
      (α : A₁ ⟶ A₂) (β : B₁ ⟶ B₂) (γ : C₁ ⟶ C₂),
      a₁ ≫ β = α ≫ a₂ → b₁ ≫ γ = β ≫ b₂ →
      (∀ X, Function.Exact (a₁.app X).hom (b₁.app X).hom) →
      (∀ X, Function.Surjective (b₁.app X).hom) →
      (∀ X, Function.Exact (a₂.app X).hom (b₂.app X).hom) →
      Presheaf.IsLocallySurjective J α → Presheaf.IsLocallyInjective J β →
        Presheaf.IsLocallyInjective J γ := by
    intro A₁ B₁ C₁ A₂ B₂ C₂ a₁ b₁ a₂ b₂ α β γ hsq1 hsq2 hex1 hsurj1 hex2 hα hβ
    have p1 : ∀ X (t : A₁.obj X),
        (β.app X).hom ((a₁.app X).hom t) = (a₂.app X).hom ((α.app X).hom t) := by
      intro X t
      have := congrArg (fun φ => (φ.app X).hom t) hsq1
      simpa using this
    have p2 : ∀ X (t : B₁.obj X),
        (γ.app X).hom ((b₁.app X).hom t) = (b₂.app X).hom ((β.app X).hom t) := by
      intro X t
      have := congrArg (fun φ => (φ.app X).hom t) hsq2
      simpa using this
    have nat : ∀ {G H : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}} (η : G ⟶ H) {X Y : Cᵒᵖ} (f : X ⟶ Y)
        (t : G.obj X), (η.app Y).hom ((G.map f).hom t) = (H.map f).hom ((η.app X).hom t) := by
      intro G H η X Y f t
      have := congrArg (fun φ => φ.hom t) (η.naturality f)
      simpa using this
    refine ⟨fun {X} x y hxy => ?_⟩
    have hxy' : (γ.app X).hom x = (γ.app X).hom y := hxy
    obtain ⟨y₀, hy₀⟩ := hsurj1 X (x - y)
    have hb2 : (b₂.app X).hom ((β.app X).hom y₀) = 0 := by
      rw [← p2, hy₀, map_sub, hxy', sub_self]
    obtain ⟨z, hz⟩ := (hex2 X _).1 hb2
    refine J.transitive (hα.imageSieve_mem z) _ ?_
    intro Y f hf
    obtain ⟨w, hw⟩ := hf
    have hw' : (α.app (Opposite.op Y)).hom w = (A₂.map f.op).hom z := hw
    have hβeq : (β.app (Opposite.op Y)).hom ((B₁.map f.op).hom y₀) =
        (β.app (Opposite.op Y)).hom ((a₁.app (Opposite.op Y)).hom w) := by
      rw [p1, hw', nat a₂, hz, nat β]
    refine J.superset_covering ?_ (hβ.equalizerSieve_mem _ _ hβeq)
    intro Z g hg
    have hg' : (B₁.map g.op).hom ((B₁.map f.op).hom y₀) =
        (B₁.map g.op).hom ((a₁.app (Opposite.op Y)).hom w) := hg
    show (C₁.map (g ≫ f).op).hom x = (C₁.map (g ≫ f).op).hom y
    rw [← sub_eq_zero, ← map_sub, ← hy₀, ← nat b₁, op_comp, Functor.map_comp,
      AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, hg', ← nat a₁]
    exact (hex1 _).apply_apply_eq_zero _

  refine four _ _ _ _ _ _ _ ?_ ?_ (fun X => (rows P₁ X).1) (fun X => (rows P₁ X).2)
    (fun X => (rows P₂ X).1) hL hF
  · rw [← Functor.map_comp, ← Functor.map_comp, MonoidalCategory.whisker_exchange]
  · rw [← Functor.map_comp, ← Functor.map_comp, MonoidalCategory.whisker_exchange]

theorem wcst_reflective_preservesFiniteColimits {C₁ : Type*} [Category C₁] {C₂ : Type*} [Category C₂]
    {C₃ : Type*} [Category C₃] [Limits.HasFiniteColimits C₁] {a : C₁ ⥤ C₂} {ι : C₂ ⥤ C₁}
    (adj : a ⊣ ι) [IsIso adj.counit] (G : C₁ ⥤ C₃) [Limits.PreservesFiniteColimits G] :
    (∀ {P Q : C₁} (φ : P ⟶ Q), IsIso (a.map φ) → IsIso (G.map φ)) →
      Limits.PreservesFiniteColimits (ι ⋙ G) :=
by
  intro hG
  constructor
  intro J _ _
  constructor
  intro K
  constructor
  intro c hc
  haveI : Limits.PreservesColimitsOfSize a := adj.leftAdjoint_preservesColimits
  let d := Limits.colimit.cocone (K ⋙ ι)
  let hd : Limits.IsColimit d := Limits.colimit.isColimit (K ⋙ ι)
  let f : d ⟶ ι.mapCocone c := hd.descCoconeMorphism (ι.mapCocone c)
  have h₁ : Limits.IsColimit (a.mapCocone (ι.mapCocone c)) :=
    (Limits.IsColimit.mapCoconeEquiv (asIso adj.counit).symm
      (Limits.isColimitOfPreserves (𝟭 C₂) hc)).ofIsoColimit (Functor.mapCoconeMapCocone c).symm
  have h₂ : Limits.IsColimit (a.mapCocone d) := Limits.isColimitOfPreserves a hd
  have hf1 : IsIso (a.mapCoconeMorphism f) := Limits.IsColimit.hom_isIso h₂ h₁ _
  have hf2 : IsIso (a.map f.hom) :=
    Functor.map_isIso (Limits.Cocone.forget _) (a.mapCoconeMorphism f)
  have hf3 : IsIso (G.mapCoconeMorphism f).hom := hG _ hf2
  have : IsIso (G.mapCoconeMorphism f) := Limits.Cocone.cocone_iso_of_hom_iso _
  have h₃ : Limits.IsColimit (G.mapCocone d) := Limits.isColimitOfPreserves G hd
  exact ⟨(h₃.ofIsoColimit (asIso (G.mapCoconeMorphism f))).ofIsoColimit
    (Functor.mapCoconeMapCocone c)⟩

theorem wc_sheaf_tensor_package (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    ∃ Tns : SheafOfModules.{u+1} (wcRingSheaf S ℓ) ⥤ SheafOfModules.{u+1} (wcRingSheaf S ℓ) ⥤
        SheafOfModules.{u+1} (wcRingSheaf S ℓ),
      (∀ K, (Tns.obj K).Additive ∧ Limits.PreservesFiniteColimits (Tns.obj K)) ∧
      (∀ N, (Tns.flip.obj N).Additive ∧ Limits.PreservesFiniteColimits (Tns.flip.obj N)) ∧
      Nonempty (Tns ≅ Tns.flip) ∧
      Nonempty (Tns.obj (SheafOfModules.unit (wcRingSheaf S ℓ)) ≅ 𝟭 _) ∧
      ∀ N, ∃ (P : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (π : P ⟶ N),
        Epi π ∧ Limits.PreservesFiniteLimits (Tns.obj P) :=
by
  have gen : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
      [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
      (R0 : Cᵒᵖ ⥤ CommRingCat.{u+1}) (hR : Presheaf.IsSheaf J (R0 ⋙ forget₂ CommRingCat RingCat)),
      ∃ Tns : SheafOfModules.{u+1} (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1}) ⥤
          SheafOfModules.{u+1} (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1}) ⥤
          SheafOfModules.{u+1} (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1}),
        (∀ K, (Tns.obj K).Additive ∧ Limits.PreservesFiniteColimits (Tns.obj K)) ∧
        (∀ N, (Tns.flip.obj N).Additive ∧ Limits.PreservesFiniteColimits (Tns.flip.obj N)) ∧
        Nonempty (Tns ≅ Tns.flip) ∧
        Nonempty (Tns.obj (SheafOfModules.unit
          (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1})) ≅ 𝟭 _) ∧
        ∀ N, ∃ (P : SheafOfModules.{u+1}
            (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1})) (π : P ⟶ N),
          Epi π ∧ Limits.PreservesFiniteLimits (Tns.obj P) := by
    intro C _ J _ _ R0 hR

    have hflat : ∀ M : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat),
        ∃ (F : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat)) (e : F ⟶ M),
          Epi e ∧ Limits.PreservesFiniteLimits (MonoidalCategory.tensorLeft F) := by
      intro M
      obtain ⟨F, L, i, e, -, hsurj, hF⟩ := wcst_flat_presentation R0 M
      obtain ⟨h1, h2⟩ := wcst_tensorLeft_rightExact R0 F
      exact ⟨F, e, PresheafOfModules.epi_of_surjective (fun X => hsurj X),
        @wcst_tensorLeft_flat_leftExact _ _ R0 F h1 h2 hF⟩

    obtain ⟨a, ι, adj, hcounit, hιadd, haadd, hafl, ⟨eU⟩, star⟩ :
        ∃ (a : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat) ⥤
            SheafOfModules.{u+1} (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1}))
          (ι : SheafOfModules.{u+1} (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1}) ⥤
            PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat))
          (adj : a ⊣ ι), IsIso adj.counit ∧ ι.Additive ∧ a.Additive ∧ Limits.PreservesFiniteLimits a ∧
          Nonempty (ι.obj (SheafOfModules.unit
              (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1})) ≅
            MonoidalCategoryStruct.tensorUnit (PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat))) ∧
          ∀ (M : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat))
            {P₁ P₂ : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat)} (φ : P₁ ⟶ P₂),
            IsIso (a.map φ) → IsIso (a.map (MonoidalCategoryStruct.whiskerLeft M φ)) := by
      haveI hιA : (SheafOfModules.forget.{u+1}
          (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1}) ⋙
          PresheafOfModules.restrictScalars (𝟙 (R0 ⋙ forget₂ CommRingCat RingCat))).Additive :=
        (fun (R : Sheaf J RingCat.{u+1}) => (inferInstance :
          (SheafOfModules.forget.{u+1} R ⋙ PresheafOfModules.restrictScalars.{u+1} (𝟙 R.obj)).Additive)) _
      refine ⟨_, _, PresheafOfModules.sheafificationAdjunction (𝟙 (R0 ⋙ forget₂ CommRingCat RingCat)),
        inferInstance, hιA, (PresheafOfModules.sheafificationAdjunction _).left_adjoint_additive,
        inferInstance, ⟨Iso.refl _⟩, ?_⟩
      intro M P₁ P₂ φ hφ
      have h := (wcst_sheafification_isIso_iff J
        (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1}) φ).1 hφ
      obtain ⟨F, L, i, e, hex, hsurj, hF⟩ := wcst_flat_presentation R0 M
      have hL := wcst_whiskerLeft_locallySurjective J R0 L φ h.2
      have hFi := wcst_whiskerLeft_locallyInjective_of_flat J R0 F φ hF h.1
      have hMi := wcst_whiskerLeft_locallyInjective_of_presentation J R0 i e hex hsurj φ hL hFi
      have hMs := wcst_whiskerLeft_locallySurjective J R0 M φ h.2
      exact (wcst_sheafification_isIso_iff J
        (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1})
        (MonoidalCategoryStruct.whiskerLeft M φ)).2 ⟨hMi, hMs⟩
    haveI := hcounit
    haveI := hιadd
    haveI := haadd
    haveI := hafl
    haveI : Limits.PreservesLimitsOfSize.{0, 0} ι := adj.rightAdjoint_preservesLimits
    haveI : Limits.PreservesColimitsOfSize.{0, 0} a := adj.leftAdjoint_preservesColimits
    haveI : a.IsLeftAdjoint := ⟨_, ⟨adj⟩⟩

    have starR : ∀ (M : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat))
        {P₁ P₂ : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat)} (φ : P₁ ⟶ P₂),
        IsIso (a.map φ) → IsIso (a.map (MonoidalCategoryStruct.whiskerRight φ M)) := by
      intro M P₁ P₂ φ hφ
      have e : MonoidalCategoryStruct.whiskerRight φ M = (BraidedCategory.braiding P₁ M).hom ≫
          MonoidalCategoryStruct.whiskerLeft M φ ≫ (BraidedCategory.braiding P₂ M).inv := by
        rw [← BraidedCategory.braiding_naturality_left_assoc, Iso.hom_inv_id, Category.comp_id]
      haveI := star M φ hφ
      rw [e, a.map_comp, a.map_comp]
      infer_instance

    have hTR : ∀ M : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat),
        (MonoidalCategory.tensorRight M).Additive ∧
          Limits.PreservesFiniteColimits (MonoidalCategory.tensorRight M) := by
      intro M
      obtain ⟨h1, h2⟩ := wcst_tensorLeft_rightExact R0 M
      let e : MonoidalCategory.tensorLeft M ≅ MonoidalCategory.tensorRight M :=
        NatIso.ofComponents (fun Y => BraidedCategory.braiding M Y)
          (fun f => BraidedCategory.braiding_naturality_right M f)
      exact ⟨Functor.additive_of_iso e, Limits.preservesFiniteColimits_of_natIso e⟩
    refine ⟨ι ⋙ MonoidalCategory.curriedTensor _ ⋙ (Functor.whiskeringLeft _ _ _).obj ι ⋙
      (Functor.whiskeringRight _ _ _).obj a, ?_, ?_, ⟨?_⟩, ⟨?_⟩, ?_⟩
    ·
      intro K
      obtain ⟨h1, h2⟩ := wcst_tensorLeft_rightExact R0 (ι.obj K)
      haveI := h1
      haveI := h2
      haveI : Limits.PreservesFiniteColimits (ι ⋙ (MonoidalCategory.tensorLeft (ι.obj K) ⋙ a)) :=
        wcst_reflective_preservesFiniteColimits adj _ (fun φ hφ => star (ι.obj K) φ hφ)
      show (ι ⋙ (MonoidalCategory.tensorLeft (ι.obj K) ⋙ a)).Additive ∧
        Limits.PreservesFiniteColimits (ι ⋙ (MonoidalCategory.tensorLeft (ι.obj K) ⋙ a))
      exact ⟨inferInstance, inferInstance⟩
    ·
      intro N
      obtain ⟨h1, h2⟩ := hTR (ι.obj N)
      haveI := h1
      haveI := h2
      haveI : Limits.PreservesFiniteColimits (ι ⋙ (MonoidalCategory.tensorRight (ι.obj N) ⋙ a)) :=
        wcst_reflective_preservesFiniteColimits adj _ (fun φ hφ => starR (ι.obj N) φ hφ)
      show (ι ⋙ (MonoidalCategory.tensorRight (ι.obj N) ⋙ a)).Additive ∧
        Limits.PreservesFiniteColimits (ι ⋙ (MonoidalCategory.tensorRight (ι.obj N) ⋙ a))
      exact ⟨inferInstance, inferInstance⟩
    ·
      refine NatIso.ofComponents (fun K => NatIso.ofComponents
        (fun N => a.mapIso (BraidedCategory.braiding (ι.obj K) (ι.obj N))) ?_) ?_
      · intro N N' g
        show a.map (MonoidalCategoryStruct.whiskerLeft (ι.obj K) (ι.map g)) ≫
            a.map (BraidedCategory.braiding (ι.obj K) (ι.obj N')).hom =
          a.map (BraidedCategory.braiding (ι.obj K) (ι.obj N)).hom ≫
            a.map (MonoidalCategoryStruct.whiskerRight (ι.map g) (ι.obj K))
        rw [← a.map_comp, ← a.map_comp, BraidedCategory.braiding_naturality_right]
      · intro K K' f
        refine NatTrans.ext (funext fun N => ?_)
        show a.map (MonoidalCategoryStruct.whiskerRight (ι.map f) (ι.obj N)) ≫
            a.map (BraidedCategory.braiding (ι.obj K') (ι.obj N)).hom =
          a.map (BraidedCategory.braiding (ι.obj K) (ι.obj N)).hom ≫
            a.map (MonoidalCategoryStruct.whiskerLeft (ι.obj N) (ι.map f))
        rw [← a.map_comp, ← a.map_comp, BraidedCategory.braiding_naturality_left]
    ·
      refine NatIso.ofComponents (fun N => a.mapIso (MonoidalCategory.whiskerRightIso eU (ι.obj N) ≪≫
        MonoidalCategoryStruct.leftUnitor (ι.obj N)) ≪≫ asIso (adj.counit.app N)) ?_
      intro N N' g
      show a.map (MonoidalCategoryStruct.whiskerLeft (ι.obj (SheafOfModules.unit
            (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1}))) (ι.map g)) ≫
          (a.map (MonoidalCategoryStruct.whiskerRight eU.hom (ι.obj N') ≫
            (MonoidalCategoryStruct.leftUnitor (ι.obj N')).hom) ≫ adj.counit.app N') =
        (a.map (MonoidalCategoryStruct.whiskerRight eU.hom (ι.obj N) ≫
            (MonoidalCategoryStruct.leftUnitor (ι.obj N)).hom) ≫ adj.counit.app N) ≫ g
      rw [← a.map_comp_assoc, MonoidalCategory.whisker_exchange_assoc,
        MonoidalCategory.leftUnitor_naturality]
      have hn : a.map (ι.map g) ≫ adj.counit.app N' = adj.counit.app N ≫ g :=
        adj.counit_naturality g
      simp only [Functor.map_comp, Category.assoc]
      rw [hn]
    ·
      intro N
      obtain ⟨F, e, he, hFfl⟩ := hflat (ι.obj N)
      haveI := he
      haveI := hFfl
      refine ⟨a.obj F, a.map e ≫ adj.counit.app N, inferInstance, ?_⟩
      have hη : IsIso (a.map (adj.unit.app F)) := by
        have h := adj.left_triangle_components F
        haveI : IsIso (a.map (adj.unit.app F) ≫ adj.counit.app (a.obj F)) := by
          rw [h]
          infer_instance
        exact IsIso.of_isIso_comp_right _ (adj.counit.app (a.obj F))
      let θ : ι ⋙ (MonoidalCategory.tensorLeft F ⋙ a) ≅
          ι ⋙ (MonoidalCategory.tensorLeft (ι.obj (a.obj F)) ⋙ a) :=
        NatIso.ofComponents (fun Y => @asIso _ _ _ _
            (a.map (MonoidalCategoryStruct.whiskerRight (adj.unit.app F) (ι.obj Y)))
            (starR (ι.obj Y) (adj.unit.app F) hη))
          (by
            intro Y Y' g
            show a.map (MonoidalCategoryStruct.whiskerLeft F (ι.map g)) ≫
                a.map (MonoidalCategoryStruct.whiskerRight (adj.unit.app F) (ι.obj Y')) =
              a.map (MonoidalCategoryStruct.whiskerRight (adj.unit.app F) (ι.obj Y)) ≫
                a.map (MonoidalCategoryStruct.whiskerLeft (ι.obj (a.obj F)) (ι.map g))
            rw [← a.map_comp, ← a.map_comp, MonoidalCategory.whisker_exchange]
            rfl)
      haveI : Limits.PreservesFiniteLimits (ι ⋙ (MonoidalCategory.tensorLeft F ⋙ a)) := inferInstance
      haveI : Limits.PreservesFiniteLimits
          (ι ⋙ (MonoidalCategory.tensorLeft (ι.obj (a.obj F)) ⋙ a)) :=
        Limits.preservesFiniteLimits_of_natIso θ
      show Limits.PreservesFiniteLimits (ι ⋙ (MonoidalCategory.tensorLeft (ι.obj (a.obj F)) ⋙ a))
      infer_instance
  exact gen (Scheme.ProEt.topology S)
    ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙
      ({ obj := fun U => CommRingCat.of C(↥(Opposite.unop U), ULift.{u+1} ℚ_[ℓ])
         map := fun f => CommRingCat.ofHom
           (ContinuousMap.compRightAlgHom ℤ (ULift.{u+1} ℚ_[ℓ]) f.unop.base.hom).toRingHom
         map_id := fun _ => rfl
         map_comp := fun _ _ => rfl } : Scheme.{u}ᵒᵖ ⥤ CommRingCat.{u+1}))
    (wcRingSheaf S ℓ).property

theorem tensor_flat_two_of_three : ∀ {C : Type*} [Category C] [Abelian C] (Tns : C ⥤ C ⥤ C)
    [∀ K, (Tns.obj K).Additive] [∀ K, Limits.PreservesFiniteColimits (Tns.obj K)]
    [∀ N, (Tns.flip.obj N).Additive] [∀ N, Limits.PreservesFiniteColimits (Tns.flip.obj N)],
    Nonempty (Tns ≅ Tns.flip) →
    (∀ N, ∃ (P : C) (π : P ⟶ N), Epi π ∧ Limits.PreservesFiniteLimits (Tns.obj P)) →
    ∀ (S : ShortComplex C), S.ShortExact → Limits.PreservesFiniteLimits (Tns.obj S.X₃) →
      (∀ N, (S.map (Tns.flip.obj N)).ShortExact) ∧
      (Limits.PreservesFiniteLimits (Tns.obj S.X₂) → Limits.PreservesFiniteLimits (Tns.obj S.X₁)) :=
by
  intro C _ _ Tns _ _ _ _ hβ hfl S hS hX₃
  obtain ⟨β⟩ := hβ
  have colimT : ∀ (F : C ⥤ C) [F.Additive] [Limits.PreservesFiniteColimits F]
      (S' : ShortComplex C), S'.ShortExact → (S'.map F).Exact ∧ Epi (F.map S'.g) :=
    by
      intro F _ hF S' hS'
      have key := (Functor.preservesFiniteColimits_tfae F).out 4 1
      exact key.mp hF S' hS'
  have limT : ∀ (F : C ⥤ C) [F.Additive] [Limits.PreservesFiniteLimits F]
      (S' : ShortComplex C), S'.ShortExact → (S'.map F).Exact ∧ Mono (F.map S'.f) :=
    by
      intro F _ hF S' hS'
      have key := (Functor.preservesFiniteLimits_tfae F).out 4 1
      exact key.mp hF S' hS'
  have IL : ∀ {K K' M M' : C} (f : K ⟶ K') (h : M ⟶ M'),
      (Tns.obj K).map h ≫ (Tns.map f).app M' = (Tns.map f).app M ≫ (Tns.obj K').map h :=
    fun f h => (Tns.map f).naturality h
  have zL : ∀ {K K' K'' : C} (a : K ⟶ K') (b : K' ⟶ K'') (M : C), a ≫ b = 0 →
      (Tns.map a).app M ≫ (Tns.map b).app M = 0 := by
    intro K K' K'' a b M hab
    rw [← Functor.flip_obj_map, ← Functor.flip_obj_map, ← Functor.map_comp, hab, Functor.map_zero]
  have zR : ∀ (K : C) {M M' M'' : C} (a : M ⟶ M') (b : M' ⟶ M''), a ≫ b = 0 →
      (Tns.obj K).map a ≫ (Tns.obj K).map b = 0 := by
    intro K M M' M'' a b hab
    rw [← Functor.map_comp, hab, Functor.map_zero]
  have hmono : ∀ N, Mono ((Tns.map S.f).app N) := by
    intro N
    obtain ⟨P, π, hπ, hP⟩ := hfl N
    have hR : (ShortComplex.mk (Limits.kernel.ι π) π (Limits.kernel.condition _)).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.kernelSequence_exact π)
        (show Mono (Limits.kernel.ι π) from inferInstance) hπ

    have hb : Mono ((Tns.map S.f).app P) := by
      have h1 := congrArg (fun t => t.app P) (β.hom.naturality S.f)
      simp only [NatTrans.comp_app, Functor.flip_map_app] at h1
      have : Mono ((Tns.obj P).map S.f) := (limT (Tns.obj P) S hS).2
      have : Mono ((Tns.map S.f).app P ≫ (β.hom.app S.X₂).app P) := by
        rw [h1]; infer_instance
      exact mono_of_mono _ ((β.hom.app S.X₂).app P)

    have e1 : Epi ((Tns.obj S.X₁).map π) := (colimT (Tns.obj S.X₁) _ hR).2
    have ex2 := (colimT (Tns.obj S.X₂) _ hR).1
    have m3 : Mono ((Tns.obj S.X₃).map (Limits.kernel.ι π)) := (limT (Tns.obj S.X₃) _ hR).2
    have exK := (colimT (Tns.flip.obj (Limits.kernel π)) S hS).1

    apply Preadditive.mono_of_cancel_zero
    intro A x hx
    obtain ⟨A₁, π₁, hπ₁, y, hy⟩ := surjective_up_to_refinements_of_epi ((Tns.obj S.X₁).map π) x
    have h2 : (y ≫ (Tns.map S.f).app P) ≫ (Tns.obj S.X₂).map π = 0 := by
      rw [Category.assoc, ← IL, ← Category.assoc, ← hy, Category.assoc, hx, Limits.comp_zero]
    obtain ⟨A₂, π₂, hπ₂, z, hz⟩ := ex2.exact_up_to_refinements (y ≫ (Tns.map S.f).app P) h2
    change π₂ ≫ y ≫ (Tns.map S.f).app P = z ≫ (Tns.obj S.X₂).map (Limits.kernel.ι π) at hz
    have h3 : (z ≫ (Tns.map S.g).app (Limits.kernel π)) ≫
        (Tns.obj S.X₃).map (Limits.kernel.ι π) = 0 := by
      rw [Category.assoc, ← IL, ← Category.assoc, ← hz]
      simp only [Category.assoc, zL S.f S.g P S.zero, Limits.comp_zero]
    have hz3 : z ≫ (Tns.map S.g).app (Limits.kernel π) = 0 := by
      rw [← cancel_mono ((Tns.obj S.X₃).map (Limits.kernel.ι π)), Limits.zero_comp]
      exact h3
    obtain ⟨A₃, π₃, hπ₃, w, hw⟩ := exK.exact_up_to_refinements z hz3
    change π₃ ≫ z = w ≫ (Tns.map S.f).app (Limits.kernel π) at hw
    have h4 : π₃ ≫ π₂ ≫ y = w ≫ (Tns.obj S.X₁).map (Limits.kernel.ι π) := by
      rw [← cancel_mono ((Tns.map S.f).app P)]
      simp only [Category.assoc]
      rw [hz, ← Category.assoc, hw, Category.assoc, ← IL]
    have h5 : (π₃ ≫ π₂ ≫ π₁) ≫ x = 0 := by
      simp only [Category.assoc]
      rw [hy, ← Category.assoc π₂, ← Category.assoc π₃, h4, Category.assoc,
        zR S.X₁ _ _ (Limits.kernel.condition π), Limits.comp_zero]
    rw [← cancel_epi (π₃ ≫ π₂ ≫ π₁), h5, Limits.comp_zero]
  refine ⟨fun N => ?_, fun hX₂ => ?_⟩
  · obtain ⟨hex, hepi⟩ := colimT (Tns.flip.obj N) S hS
    exact ShortComplex.ShortExact.mk' hex (hmono N) hepi
  · refine ((Functor.preservesFiniteLimits_tfae (Tns.obj S.X₁)).out 1 4).mp ?_
    intro S' hS'
    refine ⟨(colimT (Tns.obj S.X₁) S' hS').1, ?_⟩
    have : Mono ((Tns.obj S.X₂).map S'.f) := (limT (Tns.obj S.X₂) S' hS').2
    have := hmono S'.X₁
    have h := IL S.f S'.f
    have : Mono ((Tns.obj S.X₁).map S'.f ≫ (Tns.map S.f).app S'.X₂) := by
      rw [h]; infer_instance
    exact mono_of_mono _ ((Tns.map S.f).app S'.X₂)

theorem wc_hm_graded_comm (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (i j k : ℕ)
    (hk : i + j = k) (hk' : j + i = k) (x : wcHM S ℓ i) (y : wcHM S ℓ j) :
    wcHMCup S ℓ i j k hk x y = ((-1 : ℤ) ^ (i * j)) • wcHMCup S ℓ j i k hk' y x :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) :=
    sheafOfModules_enoughInjectives _ _
  obtain ⟨Tns, hT1, hT2, ⟨β⟩, ⟨lam⟩, hfl⟩ := wc_sheaf_tensor_package S ℓ
  haveI i1 : ∀ K, (Tns.obj K).Additive := fun K => (hT1 K).1
  haveI i2 : ∀ K, Limits.PreservesFiniteColimits (Tns.obj K) := fun K => (hT1 K).2
  haveI i3 : ∀ N, (Tns.flip.obj N).Additive := fun N => (hT2 N).1
  haveI i4 : ∀ N, Limits.PreservesFiniteColimits (Tns.flip.obj N) := fun N => (hT2 N).2
  simp only [wcHMCup, Abelian.Ext.bilinearComp_apply_apply]
  set U := SheafOfModules.unit (wcRingSheaf S ℓ) with hU
  have hsmulL : ∀ {X Y Z : SheafOfModules.{u+1} (wcRingSheaf S ℓ)} {a b c : ℕ}
      (α : Abelian.Ext X Y a) (γ : Abelian.Ext Y Z b) (h : a + b = c) (n : ℤ),
      (n • α).comp γ h = n • α.comp γ h := by
    intro X Y Z a b c α γ h n
    rw [← Abelian.Ext.bilinearComp_apply_apply, map_zsmul, AddMonoidHom.zsmul_apply,
      Abelian.Ext.bilinearComp_apply_apply]
  have hsmulR : ∀ {X Y Z : SheafOfModules.{u+1} (wcRingSheaf S ℓ)} {a b c : ℕ}
      (α : Abelian.Ext X Y a) (γ : Abelian.Ext Y Z b) (h : a + b = c) (n : ℤ),
      α.comp (n • γ) h = n • α.comp γ h := by
    intro X Y Z a b c α γ h n
    rw [← Abelian.Ext.bilinearComp_apply_apply, map_zsmul, Abelian.Ext.bilinearComp_apply_apply]
  obtain ⟨ρ, hρdef⟩ : ∃ ρ : ∀ K, (Tns.obj K).obj U ≅ K,
      ∀ K, ρ K = (β.app K).app U ≪≫ lam.app K := ⟨_, fun _ => rfl⟩
  have hρ : ∀ {K K' : SheafOfModules.{u+1} (wcRingSheaf S ℓ)} (f : K ⟶ K'),
      (Tns.map f).app U ≫ (ρ K').hom = (ρ K).hom ≫ f := by
    intro K K' f
    have h1 := congrArg (fun t => t.app U) (β.hom.naturality f)
    have h2 := lam.hom.naturality f
    simp only [NatTrans.comp_app, Functor.flip_map_app, Functor.id_map] at h1 h2
    rw [hρdef, hρdef]
    simp only [Iso.trans_hom, Iso.app_hom]
    rw [← Category.assoc, h1, Category.assoc, Category.assoc, h2]
  have hρ' : ∀ {K K' : SheafOfModules.{u+1} (wcRingSheaf S ℓ)} (f : K ⟶ K'),
      (ρ K).inv ≫ (Tns.map f).app U = f ≫ (ρ K').inv := by
    intro K K' f
    rw [Iso.inv_comp_eq, ← Category.assoc, Iso.eq_comp_inv]
    exact hρ f

  have hmk : ∀ {X Y Z W : SheafOfModules.{u+1} (wcRingSheaf S ℓ)} (f : X ⟶ Y) (g : Y ⟶ Z) {n : ℕ}
      (z : Abelian.Ext Z W n),
      (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ g).comp z (zero_add n)) (zero_add n) =
        (Abelian.Ext.mk₀ (f ≫ g)).comp z (zero_add n) := by
    intro X Y Z W f g n z
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
  have hmk' : ∀ {X Y Z W : SheafOfModules.{u+1} (wcRingSheaf S ℓ)} {n : ℕ}
      (z : Abelian.Ext X Y n) (f : Y ⟶ Z) (g : Z ⟶ W),
      (z.comp (Abelian.Ext.mk₀ f) (add_zero n)).comp (Abelian.Ext.mk₀ g) (add_zero n) =
        z.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero n) := by
    intro X Y Z W n z f g
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_third_deg_zero]
  have hA0 : ∀ {X Y Z W : SheafOfModules.{u+1} (wcRingSheaf S ℓ)} {a b c : ℕ} (f : X ⟶ Y)
      (β' : Abelian.Ext Y Z a) (γ : Abelian.Ext Z W b) (h : a + b = c),
      ((Abelian.Ext.mk₀ f).comp β' (zero_add a)).comp γ h =
        (Abelian.Ext.mk₀ f).comp (β'.comp γ h) (zero_add c) := by
    intro X Y Z W a b c f β' γ h
    exact Abelian.Ext.comp_assoc _ _ _ _ _ (by omega)
  haveI hUfl : Limits.PreservesFiniteLimits (Tns.obj U) :=
    Limits.preservesFiniteLimits_of_natIso lam.symm

  have P1 : (Abelian.Ext.mk₀ (ρ U).inv).comp
      ((Abelian.Ext.mapExactFunctor (Tns.obj U) x).comp (Abelian.Ext.mk₀ (ρ U).hom) (add_zero i))
      (zero_add i) = x := by
    have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp x lam.hom
    simp only [Abelian.Ext.id_mapExactFunctor] at h
    have hc := wc_hm_unit_end_central S ℓ ((lam.app U).inv ≫ (ρ U).hom) i x
    have hρU : (ρ U).hom = lam.hom.app U ≫ ((lam.app U).inv ≫ (ρ U).hom) := by
      rw [← Category.assoc, ← Iso.app_hom, Iso.hom_inv_id, Category.id_comp]
    conv_lhs => rw [hρU, ← hmk', h, Abelian.Ext.comp_assoc_of_third_deg_zero, ← hc,
      hmk (lam.hom.app U) ((lam.app U).inv ≫ (ρ U).hom) x, ← hρU, hmk, Iso.inv_hom_id,
      Abelian.Ext.mk₀_id_comp]

  have P2 : ∀ (K K' : SheafOfModules.{u+1} (wcRingSheaf S ℓ))
      [Limits.PreservesFiniteLimits (Tns.obj K)] [Limits.PreservesFiniteLimits (Tns.obj K')]
      (f : K ⟶ K'),
      ((Abelian.Ext.mk₀ (ρ K).inv).comp
        ((Abelian.Ext.mapExactFunctor (Tns.obj K) x).comp (Abelian.Ext.mk₀ (ρ K).hom) (add_zero i))
        (zero_add i)).comp (Abelian.Ext.mk₀ f) (add_zero i) =
      (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ (ρ K').inv).comp
        ((Abelian.Ext.mapExactFunctor (Tns.obj K') x).comp (Abelian.Ext.mk₀ (ρ K').hom) (add_zero i))
        (zero_add i)) (zero_add i) := by
    intro K K' _ _ f
    have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp x (Tns.map f)
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, hmk', ← hρ f, ← hmk', h,
      Abelian.Ext.comp_assoc_of_third_deg_zero, hmk, hρ' f, ← hmk]

  have P3 : ∀ {X₁ X₂ X₃ : SheafOfModules.{u+1} (wcRingSheaf S ℓ)} (f : X₁ ⟶ X₂) (g : X₂ ⟶ X₃)
      (hfg : f ≫ g = 0) (hT : (ShortComplex.mk f g hfg).ShortExact)
      [Limits.PreservesFiniteLimits (Tns.obj X₁)] [Limits.PreservesFiniteLimits (Tns.obj X₂)]
      [Limits.PreservesFiniteLimits (Tns.obj X₃)] (m : ℕ) (h₁ : i + 1 = m) (h₂ : 1 + i = m),
      ((Abelian.Ext.mk₀ (ρ X₃).inv).comp
        ((Abelian.Ext.mapExactFunctor (Tns.obj X₃) x).comp (Abelian.Ext.mk₀ (ρ X₃).hom) (add_zero i))
        (zero_add i)).comp hT.extClass h₁ =
      ((-1 : ℤ) ^ i) • hT.extClass.comp ((Abelian.Ext.mk₀ (ρ X₁).inv).comp
        ((Abelian.Ext.mapExactFunctor (Tns.obj X₁) x).comp (Abelian.Ext.mk₀ (ρ X₁).hom) (add_zero i))
        (zero_add i)) h₂ := by
    intro X₁ X₂ X₃ f g hfg hT _ _ _ m h₁ h₂
    have hzero : ∀ N, (Tns.map f).app N ≫ (Tns.map g).app N = 0 := by
      intro N
      rw [← Functor.flip_obj_map, ← Functor.flip_obj_map, ← Functor.map_comp, hfg,
        Functor.map_zero]
    have h5 := tensor_flat_two_of_three Tns ⟨β⟩ hfl (ShortComplex.mk f g hfg) hT
      (show Limits.PreservesFiniteLimits (Tns.obj X₃) from inferInstance)
    have hS : ∀ N, (ShortComplex.mk ((Tns.map f).app N) ((Tns.map g).app N)
        (hzero N)).ShortExact := fun N => h5.1 N
    have hs3 := ext_mapExact_ses_sign (Tns.obj X₁) (Tns.obj X₂) (Tns.obj X₃) (Tns.map f)
      (Tns.map g) hzero hS x h₁ h₂
    have hM : (hS U).extClass.comp (Abelian.Ext.mk₀ (ρ X₁).hom) (add_zero 1) =
        (Abelian.Ext.mk₀ (ρ X₃).hom).comp hT.extClass (zero_add 1) :=
      ShortComplex.ShortExact.extClass_naturality (hS U) hT
        (ShortComplex.homMk (ρ X₁).hom (ρ X₂).hom (ρ X₃).hom (hρ f).symm (hρ g).symm)
    have hN : hT.extClass.comp (Abelian.Ext.mk₀ (ρ X₁).inv) (add_zero 1) =
        (Abelian.Ext.mk₀ (ρ X₃).inv).comp (hS U).extClass (zero_add 1) :=
      ShortComplex.ShortExact.extClass_naturality hT (hS U)
        (ShortComplex.homMk (ρ X₁).inv (ρ X₂).inv (ρ X₃).inv (hρ' f) (hρ' g))
    conv_lhs => rw [hA0, Abelian.Ext.comp_assoc_of_second_deg_zero, ← hM,
      ← Abelian.Ext.comp_assoc_of_third_deg_zero, hs3, hsmulL,
      Abelian.Ext.comp_assoc_of_third_deg_zero, hsmulR, ← hA0, ← hN,
      Abelian.Ext.comp_assoc_of_second_deg_zero]

  have C : ∀ (j : ℕ) (K : SheafOfModules.{u+1} (wcRingSheaf S ℓ))
      [Limits.PreservesFiniteLimits (Tns.obj K)] (z : Abelian.Ext K U j) (m : ℕ)
      (h₁ : i + j = m) (h₂ : j + i = m),
      ((Abelian.Ext.mk₀ (ρ K).inv).comp
        ((Abelian.Ext.mapExactFunctor (Tns.obj K) x).comp (Abelian.Ext.mk₀ (ρ K).hom) (add_zero i))
        (zero_add i)).comp z h₁ = ((-1 : ℤ) ^ (i * j)) • z.comp x h₂ := by
    intro j
    induction j with
    | zero =>
      intro K _ z m h₁ h₂
      obtain ⟨f, rfl⟩ := (Abelian.Ext.mk₀_bijective K U).2 z
      obtain rfl : m = i := by omega
      rw [P2 K U f, P1, mul_zero, pow_zero, one_smul]
    | succ j ih =>
      intro K _ z m h₁ h₂
      obtain ⟨E', π, hπ, hz⟩ := ext_epi_effaces z
      obtain ⟨P, q, hq, hP⟩ := hfl E'
      haveI := hπ
      haveI := hq
      haveI := hP
      have hpz : (Abelian.Ext.mk₀ (q ≫ π)).comp z (zero_add (j + 1)) = 0 := by
        rw [← hmk, hz, Abelian.Ext.comp_zero]
      have hT : (ShortComplex.mk (Limits.kernel.ι (q ≫ π)) (q ≫ π)
          (Limits.kernel.condition _)).ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.kernelSequence_exact (q ≫ π))
          (show Mono (Limits.kernel.ι (q ≫ π)) from inferInstance)
          (show Epi (q ≫ π) from inferInstance)
      have h5 := tensor_flat_two_of_three Tns ⟨β⟩ hfl _ hT
        (show Limits.PreservesFiniteLimits (Tns.obj K) from inferInstance)
      haveI hK' : Limits.PreservesFiniteLimits (Tns.obj (Limits.kernel (q ≫ π))) := h5.2 hP
      obtain ⟨z'', rfl⟩ := Abelian.Ext.contravariant_sequence_exact₃ hT U z hpz
        (show 1 + j = j + 1 by omega)
      rw [← Abelian.Ext.comp_assoc _ hT.extClass z'' (show i + 1 = i + 1 from rfl)
          (show 1 + j = j + 1 by omega) (show i + 1 + j = m by omega),
        P3 _ _ _ hT (i + 1) rfl (by omega), hsmulL,
        Abelian.Ext.comp_assoc hT.extClass _ z'' (show 1 + i = i + 1 by omega)
          (show i + j = j + i by omega) (show 1 + i + j = m by omega),
        ih _ z'' (j + i) (by omega) rfl, hsmulR, smul_smul,
        Abelian.Ext.comp_assoc hT.extClass z'' x (show 1 + j = j + 1 by omega)
          (show j + i = j + i from rfl) (show 1 + j + i = m by omega)]
      have hs : ((-1 : ℤ) ^ i * (-1) ^ (i * j)) = (-1) ^ (i * (j + 1)) := by ring
      rw [hs]
  have hfin := C j U y k hk hk'
  rw [P1] at hfin
  exact hfin

theorem wc_et_coh_zero_irreducible_card_le : ∀ (Y : Scheme.{u}) [IrreducibleSpace Y] (m : ℕ),
    m ≠ 0 → Finite (wcEtCoh Y m 0) ∧ Nat.card (wcEtCoh Y m 0) ≤ m :=
by
  intro Y _ m hm
  haveI : NeZero m := ⟨hm⟩
  let T₀ : Y.Etale := Scheme.Etale.mk (𝟙 Y)
  have hT : Limits.IsTerminal T₀ :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
  obtain ⟨ε, -, -⟩ := wc_et_const_hom_sections_equiv Y T₀ hT
  obtain ⟨e, -⟩ := wc_et_const_zmod_sections_locallyConstant Y m
    (fun V S hS x hx => wc_et_locallyConstant_glue Y V S hS m x hx)
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  let E₁ : wcEtCoh Y m 0 ≃ ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶
      (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) :=
    (Abelian.Ext.addEquiv₀).toEquiv
  let E := E₁.trans ((ε _).trans (e T₀).toEquiv)
  obtain ⟨y₀⟩ : Nonempty Y := inferInstance
  have hpc : _root_.IsPreconnected (Set.univ : Set Y) :=
    (IrreducibleSpace.isIrreducible_univ Y).isPreirreducible.isPreconnected
  let Φ : wcEtCoh Y m 0 → ZMod m := fun x => (E x : LocallyConstant Y (ZMod m)) y₀
  have hΦ : Function.Injective Φ := by
    intro a b hab
    apply E.injective
    apply LocallyConstant.ext
    intro x
    have h1 := LocallyConstant.apply_eq_of_isPreconnected (E a : LocallyConstant Y (ZMod m)) hpc
      (Set.mem_univ x) (Set.mem_univ y₀)
    have h2 := LocallyConstant.apply_eq_of_isPreconnected (E b : LocallyConstant Y (ZMod m)) hpc
      (Set.mem_univ x) (Set.mem_univ y₀)
    exact h1.trans (hab.trans h2.symm)
  refine ⟨Finite.of_injective Φ hΦ, ?_⟩
  calc Nat.card (wcEtCoh Y m 0) ≤ Nat.card (ZMod m) := Nat.card_le_card_of_injective Φ hΦ
    _ = m := Nat.card_zmod m

theorem wc_et_abstract_blowup_card_le : ∀ (Y X' Z : Scheme.{u}) (b : X' ⟶ Y) [IsProper b] (iZ : Z ⟶ Y) [IsClosedImmersion iZ], (∀ U : Y.Opens, (U : Set Y) = (Set.range iZ)ᶜ → IsIso (b ∣_ U)) → ∀ m : ℕ, m ≠ 0 → ∀ q : ℕ, Finite (wcEtCoh X' m q) → Subsingleton (wcEtCoh Z m q) → (∀ q' : ℕ, q' + 1 = q → Subsingleton (wcEtCoh (Limits.pullback b iZ) m q')) → Finite (wcEtCoh Y m q) ∧ Nat.card (wcEtCoh Y m q) ≤ Nat.card (wcEtCoh X' m q) :=
by
  intro Y X' Z b _ iZ _ hiso m hm q hX hZ hE
  classical

  have hmono : ∀ (W : Scheme.{u}) (S : Set W), Mono (wcEtExtZeroι W S m) := by
    intro W S
    let α : wcEtExtZeroPre W S m ⟶
        (Functor.const _).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) :=
      { app := fun V => AddCommGrpCat.ofHom (wcSuppSub.{u} m (∀ x, V.unop.hom x ∈ S)).subtype
        naturality := fun _ _ _ => rfl }
    haveI : ∀ V, Mono (α.app V) := fun V =>
      (AddCommGrpCat.mono_iff_injective _).mpr (AddSubgroup.subtype_injective _)
    haveI : Mono α := NatTrans.mono_of_mono_app α
    exact Functor.map_mono (presheafToSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}) α
  have hT : ∀ (W : Scheme.{u}) (S : Set W),
      (ShortComplex.mk (wcEtExtZeroι W S m) (Limits.cokernel.π _)
        (Limits.cokernel.condition _)).ShortExact := by
    intro W S
    haveI := hmono W S
    exact ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) inferInstance inferInstance
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}) := HasExt.standard _

  have hJ' : Finite (wcEtExt X'
      (wcEtExtZero X' (Set.range (Limits.pullback.fst b iZ))ᶜ m) q) ∧
      Nat.card (wcEtExt X'
        (wcEtExtZero X' (Set.range (Limits.pullback.fst b iZ))ᶜ m) q) ≤
        Nat.card (wcEtCoh X' m q) := by
    let T := ShortComplex.mk (wcEtExtZeroι X' (Set.range (Limits.pullback.fst b iZ))ᶜ m)
      (Limits.cokernel.π _) (Limits.cokernel.condition _)
    have hTs : T.ShortExact := hT X' _
    let P := (constantSheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))
    change Finite (Abelian.Ext P T.X₁ q) ∧
      Nat.card (Abelian.Ext P T.X₁ q) ≤ Nat.card (Abelian.Ext P T.X₂ q)
    have h2 : Finite (Abelian.Ext P T.X₂ q) := hX
    let φ : Abelian.Ext P T.X₁ q →+ Abelian.Ext P T.X₂ q :=
      (Abelian.Ext.mk₀ T.f).postcomp P (add_zero q)
    have hinj : Function.Injective φ := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      cases q with
      | zero =>
        obtain ⟨g, rfl⟩ : ∃ g, Abelian.Ext.mk₀ g = x := ⟨_, Abelian.Ext.mk₀_homEquiv₀_apply x⟩
        have hx' : Abelian.Ext.mk₀ (g ≫ T.f) = Abelian.Ext.mk₀ 0 := by
          rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_zero]
          exact hx
        rw [← Abelian.Ext.homEquiv₀_symm_apply, ← Abelian.Ext.homEquiv₀_symm_apply] at hx'
        have hg : g ≫ T.f = 0 := Abelian.Ext.homEquiv₀.symm.injective hx'
        haveI := hTs.mono_f
        rw [Limits.zero_of_comp_mono T.f hg, Abelian.Ext.mk₀_zero]
      | succ n₀ =>
        obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₁ P hTs x hx rfl
        obtain ⟨e⟩ := wc_et_closed_complement_coh X' (Limits.pullback b iZ)
          (Limits.pullback.fst b iZ) m n₀
        haveI := hE n₀ rfl
        haveI : Subsingleton (Abelian.Ext P T.X₃ n₀) := e.subsingleton
        rw [← hy, Subsingleton.elim y 0, Abelian.Ext.zero_comp]
    exact ⟨Finite.of_injective φ hinj, Nat.card_le_card_of_injective φ hinj⟩

  obtain ⟨eX⟩ := wc_et_proper_excision Y X' Z b iZ hiso m hm
    wc_et_henselian_proper_vanishing q
  obtain ⟨hJ'fin, hJ'card⟩ := hJ'
  haveI := hJ'fin
  have hJfin : Finite (wcEtExt Y (wcEtExtZero Y (Set.range iZ)ᶜ m) q) :=
    Finite.of_equiv _ eX.symm
  have hJcard := Nat.card_congr eX

  let T := ShortComplex.mk (wcEtExtZeroι Y (Set.range iZ)ᶜ m)
    (Limits.cokernel.π _) (Limits.cokernel.condition _)
  have hTs : T.ShortExact := hT Y _
  let P := (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} ℤ))
  obtain ⟨eZ⟩ := wc_et_closed_complement_coh Y Z iZ m q
  haveI : Subsingleton (Abelian.Ext P T.X₃ q) := eZ.subsingleton
  have h1 : Finite (Abelian.Ext P T.X₁ q) := hJfin
  let φ : Abelian.Ext P T.X₁ q →+ Abelian.Ext P T.X₂ q :=
    (Abelian.Ext.mk₀ T.f).postcomp P (add_zero q)
  have hsurj : Function.Surjective φ := fun x =>
    Abelian.Ext.covariant_sequence_exact₂ P hTs x (Subsingleton.elim _ _)
  change Finite (Abelian.Ext P T.X₂ q) ∧
    Nat.card (Abelian.Ext P T.X₂ q) ≤ Nat.card (wcEtCoh X' m q)
  refine ⟨Finite.of_surjective φ hsurj, ?_⟩
  calc Nat.card (Abelian.Ext P T.X₂ q) ≤ Nat.card (Abelian.Ext P T.X₁ q) :=
        Nat.card_le_card_of_surjective φ hsurj
    _ = _ := hJcard
    _ ≤ _ := hJ'card

theorem wc_leray_ext_corner_card : ∀ {C : Type*} {D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] [EnoughInjectives D] (L : D ⥤ C) (R : C ⥤ D) [R.Additive] (adj : L ⊣ R) [Limits.PreservesFiniteLimits L] (P : D) (A : C) (I : InjectiveResolution A) (N : ℕ), letI := HasExt.standard C; letI := HasExt.standard D; (∀ p q : ℕ, q ≠ 2 → N + 2 ≤ p + q → ∀ x : Abelian.Ext P (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) p, x = 0) → Finite (Abelian.Ext P (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 2) N) → Finite (Abelian.Ext (L.obj P) A (N + 2)) ∧ Nat.card (Abelian.Ext (L.obj P) A (N + 2)) ≤ Nat.card (Abelian.Ext P (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 2) N) :=
by
  intro C D _ _ _ _ _ L R _ adj _ P A I N hH hfin
  letI : HasExt C := HasExt.standard C
  letI : HasExt D := HasExt.standard D
  classical

  have s1 : ∀ (K : CochainComplex D ℕ) (j : ℕ), ∃ (B : D) (u : K.X j ⟶ B)
      (v : B ⟶ K.cycles (j + 1)) (h1 : K.iCycles j ≫ u = 0) (h2 : v ≫ K.homologyπ (j + 1) = 0),
      (ShortComplex.mk _ _ h1).ShortExact ∧ (ShortComplex.mk _ _ h2).ShortExact ∧
        u ≫ v ≫ K.iCycles (j + 1) = K.d j (j + 1) := by
    intro K j
    have hv : Limits.image.ι (K.d j (j + 1)) ≫ K.d (j + 1) (j + 1 + 1) = 0 := by
      rw [← cancel_epi (Limits.factorThruImage (K.d j (j + 1))), Limits.image.fac_assoc,
        K.d_comp_d, Limits.comp_zero]
    let v := K.liftCycles (Limits.image.ι (K.d j (j + 1))) (j + 1 + 1)
      (CochainComplex.next ℕ (j + 1)) hv
    have hvi : v ≫ K.iCycles (j + 1) = Limits.image.ι (K.d j (j + 1)) :=
      K.liftCycles_i _ _ _ _
    have huv : Limits.factorThruImage (K.d j (j + 1)) ≫ v = K.toCycles j (j + 1) := by
      rw [← cancel_mono (K.iCycles (j + 1)), Category.assoc, hvi, Limits.image.fac,
        K.toCycles_i]
    have h1 : K.iCycles j ≫ Limits.factorThruImage (K.d j (j + 1)) = 0 := by
      rw [← cancel_mono (Limits.image.ι (K.d j (j + 1))), Category.assoc, Limits.image.fac,
        Limits.zero_comp]
      exact K.iCycles_d j (j + 1)
    have h2 : v ≫ K.homologyπ (j + 1) = 0 := by
      rw [← cancel_epi (Limits.factorThruImage (K.d j (j + 1))), ← Category.assoc, huv,
        Limits.comp_zero]
      exact K.toCycles_comp_homologyπ j (j + 1)
    haveI : Mono v := mono_of_mono_fac hvi
    refine ⟨Limits.image (K.d j (j + 1)), Limits.factorThruImage (K.d j (j + 1)), v, h1, h2,
      ?_, ?_, ?_⟩
    · refine ShortComplex.ShortExact.mk' (ShortComplex.exact_of_f_is_kernel _
        (Limits.KernelFork.IsLimit.ofι _ _
          (fun g' hg' => K.liftCycles g' (j + 1) (CochainComplex.next ℕ j) (by
            rw [← Limits.image.fac (K.d j (j + 1)), ← Category.assoc,
              show g' ≫ Limits.factorThruImage (K.d j (j + 1)) = 0 from hg', Limits.zero_comp]))
          (fun g' hg' => K.liftCycles_i _ _ _ _)
          (fun g' hg' m hm => by
            rw [← cancel_mono (K.iCycles j), K.liftCycles_i]
            exact hm))) inferInstance inferInstance
    · have hprev : (ComplexShape.up ℕ).prev (j + 1) = j := by simp
      refine ShortComplex.ShortExact.mk' (ShortComplex.exact_of_g_is_cokernel _
        (Limits.CokernelCofork.IsColimit.ofπ _ _
          (fun g' hg' => (Limits.CokernelCofork.IsColimit.desc'
            (K.homologyIsCokernel j (j + 1) hprev) g' (by
              rw [← huv, Category.assoc, show v ≫ g' = 0 from hg', Limits.comp_zero])).1)
          (fun g' hg' => (Limits.CokernelCofork.IsColimit.desc'
            (K.homologyIsCokernel j (j + 1) hprev) g' (by
              rw [← huv, Category.assoc, show v ≫ g' = 0 from hg', Limits.comp_zero])).2)
          (fun g' hg' m hm => by
            rw [← cancel_epi (K.homologyπ (j + 1))]
            exact hm.trans (Limits.CokernelCofork.IsColimit.desc'
              (K.homologyIsCokernel j (j + 1) hprev) g' (by
                rw [← huv, Category.assoc, show v ≫ g' = 0 from hg', Limits.comp_zero])).2.symm)))
        inferInstance inferInstance
    · rw [hvi, Limits.image.fac]

  have core : ∀ (K : CochainComplex D ℕ), (∀ j, Injective (K.X j)) →
      (∀ p q : ℕ, q ≠ 2 → N + 2 ≤ p + q → ∀ x : Abelian.Ext P (K.homology q) p, x = 0) →
      Finite (Abelian.Ext P (K.homology 2) N) →
      ∃ S : Set (P ⟶ K.X (N + 1 + 1)), S.Finite ∧
        Nat.card S ≤ Nat.card (Abelian.Ext P (K.homology 2) N) ∧
        ∀ c : P ⟶ K.X (N + 1 + 1), c ≫ K.d (N + 1 + 1) (N + 1 + 1 + 1) = 0 →
          ∃ c' ∈ S, c' ≫ K.d (N + 1 + 1) (N + 1 + 1 + 1) = 0 ∧
            ∃ e : P ⟶ K.X (N + 1), e ≫ K.d (N + 1) (N + 1 + 1) = c - c' := by
    intro K hinj hH hfin
    choose Bo u v h1 h2 hS1 hS2 hfac using s1 K

    have T1 : ∀ (b a : ℕ) (y : Abelian.Ext P (Bo b) (a + 1)),
        y.comp (hS1 b).extClass (rfl : a + 1 + 1 = a + 1 + 1) = 0 → y = 0 := by
      intro b a y hy
      haveI : Injective (ShortComplex.mk _ _ (h1 b)).X₂ := hinj b
      obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ P (hS1 b) y rfl hy
      rw [← hx₂, Abelian.Ext.eq_zero_of_injective x₂, Abelian.Ext.zero_comp]

    have hiso0 : IsIso (K.homologyπ 0) :=
      K.isIso_homologyπ 0 0 CochainComplex.prev_nat_zero (K.shape 0 0 (by simp))
    have hZ0 : ∀ x : Abelian.Ext P (K.cycles 0) (N + 1 + 1), x = 0 := by
      intro x
      have hl : (x.comp (Abelian.Ext.mk₀ (K.homologyπ 0)) (add_zero _)).comp
          (Abelian.Ext.mk₀ (inv (K.homologyπ 0))) (add_zero _) = x := by
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero _) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, IsIso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
      have h0 : x.comp (Abelian.Ext.mk₀ (K.homologyπ 0)) (add_zero _) = 0 :=
        hH (N + 1 + 1) 0 (by omega) (by omega) _
      rw [← hl, h0, Abelian.Ext.zero_comp]
    have hZ1 : ∀ x : Abelian.Ext P (K.cycles 1) (N + 1), x = 0 := by
      intro x
      have h0 : x.comp (Abelian.Ext.mk₀ (K.homologyπ (0 + 1))) (add_zero _) = 0 :=
        hH (N + 1) 1 (by omega) (by omega) _
      obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₂ P (hS2 0) x h0
      have hy0 : y = 0 := T1 0 N y (hZ0 _)
      rw [← hy, hy0, Abelian.Ext.zero_comp]

    have chain : ∀ j i : ℕ, i + 1 + j = N →
        Finite (Abelian.Ext P (K.cycles (j + 2)) (i + 1)) ∧
          Nat.card (Abelian.Ext P (K.cycles (j + 2)) (i + 1)) ≤
            Nat.card (Abelian.Ext P (K.homology 2) N) := by
      intro j
      induction j with
      | zero =>
        intro i hi
        obtain rfl : N = i + 1 := by omega
        have hB1 : ∀ y : Abelian.Ext P (Bo 1) (i + 1), y = 0 := fun y => T1 1 i y (hZ1 _)
        let φ : Abelian.Ext P (K.cycles 2) (i + 1) →+ Abelian.Ext P (K.homology 2) (i + 1) :=
          (Abelian.Ext.mk₀ (K.homologyπ 2)).postcomp P (add_zero (i + 1))
        have hφ : Function.Injective φ := by
          rw [injective_iff_map_eq_zero]
          intro x hx
          obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₂ P (hS2 1) x hx
          rw [← hy, hB1 y, Abelian.Ext.zero_comp]
        exact ⟨Finite.of_injective φ hφ, Nat.card_le_card_of_injective φ hφ⟩
      | succ j ih =>
        intro i hi
        obtain ⟨hf1, hc1⟩ := ih (i + 1) (by omega)
        haveI := hf1
        let δ := (hS1 (j + 2)).extClass.postcomp P (rfl : (i + 1) + 1 = (i + 1) + 1)
        have hδ : Function.Injective δ := by
          rw [injective_iff_map_eq_zero]
          intro y hy
          exact T1 (j + 2) i y hy
        haveI : Finite (Abelian.Ext P (Bo (j + 2)) (i + 1)) := Finite.of_injective δ hδ
        have hcB : Nat.card (Abelian.Ext P (Bo (j + 2)) (i + 1)) ≤
            Nat.card (Abelian.Ext P (K.homology 2) N) :=
          (Nat.card_le_card_of_injective δ hδ).trans hc1
        let ν : Abelian.Ext P (Bo (j + 2)) (i + 1) →
            Abelian.Ext P (K.cycles (j + 2 + 1)) (i + 1) :=
          fun y => y.comp (Abelian.Ext.mk₀ (v (j + 2))) (add_zero _)
        have hν : Function.Surjective ν := by
          intro x
          have h0 : x.comp (Abelian.Ext.mk₀ (K.homologyπ (j + 2 + 1))) (add_zero _) = 0 :=
            hH (i + 1) (j + 2 + 1) (by omega) (by omega) _
          exact Abelian.Ext.covariant_sequence_exact₂ P (hS2 (j + 2)) x h0
        have hfin' : Finite (Abelian.Ext P (K.cycles (j + 2 + 1)) (i + 1)) :=
          Finite.of_surjective ν hν
        exact ⟨hfin', (Nat.card_le_card_of_surjective ν hν).trans hcB⟩

    have hF : Finite (Abelian.Ext P (K.homology (N + 1 + 1)) 0) ∧
        Finite (Abelian.Ext P (K.cycles (N + 1)) 1) ∧
        Nat.card (Abelian.Ext P (K.homology (N + 1 + 1)) 0) *
          Nat.card (Abelian.Ext P (K.cycles (N + 1)) 1) ≤
            Nat.card (Abelian.Ext P (K.homology 2) N) := by
      rcases Nat.eq_zero_or_pos N with hN | hN
      · subst hN
        have hsub : Subsingleton (Abelian.Ext P (K.cycles (0 + 1)) 1) :=
          ⟨fun a b => (hZ1 a).trans (hZ1 b).symm⟩
        haveI := hsub
        have hb : Nat.card (Abelian.Ext P (K.cycles (0 + 1)) 1) ≤ 1 :=
          Finite.card_le_one_iff_subsingleton.mpr hsub
        refine ⟨hfin, inferInstance, ?_⟩
        calc Nat.card (Abelian.Ext P (K.homology (0 + 1 + 1)) 0) *
              Nat.card (Abelian.Ext P (K.cycles (0 + 1)) 1)
            ≤ Nat.card (Abelian.Ext P (K.homology (0 + 1 + 1)) 0) * 1 :=
              Nat.mul_le_mul le_rfl hb
          _ = Nat.card (Abelian.Ext P (K.homology 2) 0) := mul_one _
      · obtain ⟨m, rfl⟩ : ∃ m, N = m + 1 := ⟨N - 1, by omega⟩
        have hsub : Subsingleton (Abelian.Ext P (K.homology (m + 1 + 1 + 1)) 0) :=
          ⟨fun a b => (hH 0 (m + 1 + 1 + 1) (by omega) (by omega) a).trans
            (hH 0 (m + 1 + 1 + 1) (by omega) (by omega) b).symm⟩
        haveI := hsub
        have ha : Nat.card (Abelian.Ext P (K.homology (m + 1 + 1 + 1)) 0) ≤ 1 :=
          Finite.card_le_one_iff_subsingleton.mpr hsub
        obtain ⟨hf, hc⟩ := chain m 0 (by omega)
        have hf' : Finite (Abelian.Ext P (K.cycles (m + 1 + 1)) 1) := hf
        have hc' : Nat.card (Abelian.Ext P (K.cycles (m + 1 + 1)) 1) ≤
            Nat.card (Abelian.Ext P (K.homology 2) (m + 1)) := hc
        refine ⟨inferInstance, hf', ?_⟩
        calc Nat.card (Abelian.Ext P (K.homology (m + 1 + 1 + 1)) 0) *
              Nat.card (Abelian.Ext P (K.cycles (m + 1 + 1)) 1)
            ≤ 1 * Nat.card (Abelian.Ext P (K.cycles (m + 1 + 1)) 1) :=
              Nat.mul_le_mul ha le_rfl
          _ = Nat.card (Abelian.Ext P (K.cycles (m + 1 + 1)) 1) := one_mul _
          _ ≤ _ := hc'

    obtain ⟨hF0, hF1, hB⟩ := hF
    haveI := hF0
    haveI := hF1
    let Z := {c : P ⟶ K.X (N + 1 + 1) // c ≫ K.d (N + 1 + 1) (N + 1 + 1 + 1) = 0}
    let Θ : Z → Abelian.Ext P (K.homology (N + 1 + 1)) 0 := fun c =>
      Abelian.Ext.mk₀ (K.liftCycles c.1 (N + 1 + 1 + 1) (CochainComplex.next ℕ (N + 1 + 1)) c.2 ≫
        K.homologyπ (N + 1 + 1))
    haveI : Nonempty Z := ⟨⟨0, Limits.zero_comp⟩⟩
    let ρ := Function.invFun Θ
    have hρ : ∀ z, Θ (ρ (Θ z)) = Θ z := fun z => Function.invFun_eq ⟨z, rfl⟩
    let Ξ : (P ⟶ Bo (N + 1)) → Abelian.Ext P (K.cycles (N + 1)) 1 := fun b =>
      (Abelian.Ext.mk₀ b).comp (hS1 (N + 1)).extClass (zero_add 1)
    haveI : Nonempty (P ⟶ Bo (N + 1)) := ⟨0⟩
    let σ := Function.invFun Ξ
    have hσ : ∀ b, Ξ (σ (Ξ b)) = Ξ b := fun b => Function.invFun_eq ⟨b, rfl⟩
    let F : Abelian.Ext P (K.homology (N + 1 + 1)) 0 × Abelian.Ext P (K.cycles (N + 1)) 1 →
        (P ⟶ K.X (N + 1 + 1)) := fun hε =>
      (ρ hε.1).1 + σ hε.2 ≫ v (N + 1) ≫ K.iCycles (N + 1 + 1)
    refine ⟨Set.range F, Set.finite_range F, ?_, ?_⟩
    · calc Nat.card (Set.range F)
          ≤ Nat.card (Abelian.Ext P (K.homology (N + 1 + 1)) 0 ×
              Abelian.Ext P (K.cycles (N + 1)) 1) :=
            Nat.card_le_card_of_surjective _ Set.rangeFactorization_surjective
        _ = Nat.card (Abelian.Ext P (K.homology (N + 1 + 1)) 0) *
              Nat.card (Abelian.Ext P (K.cycles (N + 1)) 1) := Nat.card_prod _ _
        _ ≤ _ := hB
    intro c hc
    let z : Z := ⟨c, hc⟩
    let w := ρ (Θ z)
    have hwd : w.1 ≫ K.d (N + 1 + 1) (N + 1 + 1 + 1) = 0 := w.2
    have hmd : (c - w.1) ≫ K.d (N + 1 + 1) (N + 1 + 1 + 1) = 0 := by
      rw [Preadditive.sub_comp, hc, hwd, sub_zero]
    have hlift : K.liftCycles (c - w.1) (N + 1 + 1 + 1) (CochainComplex.next ℕ (N + 1 + 1)) hmd =
        K.liftCycles c (N + 1 + 1 + 1) (CochainComplex.next ℕ (N + 1 + 1)) hc -
          K.liftCycles w.1 (N + 1 + 1 + 1) (CochainComplex.next ℕ (N + 1 + 1)) hwd := by
      rw [← cancel_mono (K.iCycles (N + 1 + 1)), Preadditive.sub_comp, K.liftCycles_i,
        K.liftCycles_i, K.liftCycles_i]
    have hΘ : K.liftCycles (c - w.1) (N + 1 + 1 + 1) (CochainComplex.next ℕ (N + 1 + 1)) hmd ≫
        K.homologyπ (N + 1 + 1) = 0 := by
      have e : Abelian.Ext.mk₀ (K.liftCycles w.1 (N + 1 + 1 + 1)
            (CochainComplex.next ℕ (N + 1 + 1)) hwd ≫ K.homologyπ (N + 1 + 1)) =
          Abelian.Ext.mk₀ (K.liftCycles c (N + 1 + 1 + 1) (CochainComplex.next ℕ (N + 1 + 1)) hc ≫
            K.homologyπ (N + 1 + 1)) := hρ z
      rw [← Abelian.Ext.homEquiv₀_symm_apply, ← Abelian.Ext.homEquiv₀_symm_apply] at e
      have e' := Abelian.Ext.homEquiv₀.symm.injective e
      rw [hlift, Preadditive.sub_comp]
      exact sub_eq_zero.mpr e'.symm
    have hS2p := hS2 (N + 1)
    haveI := hS2p.mono_f
    let b : P ⟶ Bo (N + 1) := hS2p.exact.lift
      (K.liftCycles (c - w.1) (N + 1 + 1 + 1) (CochainComplex.next ℕ (N + 1 + 1)) hmd) hΘ
    have hb : b ≫ v (N + 1) =
        K.liftCycles (c - w.1) (N + 1 + 1 + 1) (CochainComplex.next ℕ (N + 1 + 1)) hmd :=
      hS2p.exact.lift_f _ _
    have hbm : b ≫ v (N + 1) ≫ K.iCycles (N + 1 + 1) = c - w.1 := by
      rw [← Category.assoc, hb, K.liftCycles_i]
    let b₀ := σ (Ξ b)
    have hΞ : (Abelian.Ext.mk₀ (b - b₀)).comp (hS1 (N + 1)).extClass (zero_add 1) = 0 := by
      have e : (Abelian.Ext.mk₀ b₀).comp (hS1 (N + 1)).extClass (zero_add 1) =
          (Abelian.Ext.mk₀ b).comp (hS1 (N + 1)).extClass (zero_add 1) := hσ b
      have hsub : Abelian.Ext.mk₀ (b - b₀) = Abelian.Ext.mk₀ b - Abelian.Ext.mk₀ b₀ := by
        rw [eq_sub_iff_add_eq, ← Abelian.Ext.mk₀_add, sub_add_cancel]
      change ((hS1 (N + 1)).extClass.postcomp P (zero_add 1)) (Abelian.Ext.mk₀ (b - b₀)) = 0
      rw [hsub, map_sub]
      exact sub_eq_zero.mpr e.symm
    obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ P (hS1 (N + 1))
      (Abelian.Ext.mk₀ (b - b₀)) (zero_add 1) hΞ
    let e : P ⟶ K.X (N + 1) := Abelian.Ext.homEquiv₀ x₂
    have he : e ≫ u (N + 1) = b - b₀ := by
      have h3 : Abelian.Ext.mk₀ (e ≫ u (N + 1)) = Abelian.Ext.mk₀ (b - b₀) := by
        rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_homEquiv₀_apply]
        exact hx₂
      rw [← Abelian.Ext.homEquiv₀_symm_apply, ← Abelian.Ext.homEquiv₀_symm_apply] at h3
      exact Abelian.Ext.homEquiv₀.symm.injective h3
    refine ⟨F (Θ z, Ξ b), ⟨_, rfl⟩, ?_, e, ?_⟩
    · show (w.1 + b₀ ≫ v (N + 1) ≫ K.iCycles (N + 1 + 1)) ≫ K.d (N + 1 + 1) (N + 1 + 1 + 1) = 0
      rw [Preadditive.add_comp, hwd, Category.assoc, Category.assoc, K.iCycles_d,
        Limits.comp_zero, Limits.comp_zero, add_zero]
    · rw [← hfac (N + 1), ← Category.assoc, he, Preadditive.sub_comp, hbm]
      show c - w.1 - b₀ ≫ v (N + 1) ≫ K.iCycles (N + 1 + 1) =
        c - (w.1 + b₀ ≫ v (N + 1) ≫ K.iCycles (N + 1 + 1))
      abel

  have hinj : ∀ j, Injective (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj
      I.cocomplex).X j) := fun j => by
    haveI := I.injective j
    exact Injective.injective_of_adjoint adj (I.cocomplex.X j)
  obtain ⟨S, hS, hcardS, hrep⟩ := core _ hinj hH hfin

  have hφ0 : ∀ j, (adj.homEquiv P (I.cocomplex.X j)) 0 = 0 := fun j => by
    rw [Adjunction.homEquiv_unit, Functor.map_zero, Limits.comp_zero]
  have hφs0 : ∀ j, (adj.homEquiv P (I.cocomplex.X j)).symm 0 = 0 := fun j => by
    rw [Equiv.symm_apply_eq, hφ0]
  have hφsub : ∀ j (f g : L.obj P ⟶ I.cocomplex.X j),
      adj.homEquiv P _ (f - g) = adj.homEquiv P _ f - adj.homEquiv P _ g := fun j f g => by
    simp only [Adjunction.homEquiv_unit, Functor.map_sub, Preadditive.comp_sub]
  let T : Set (P ⟶ R.obj (I.cocomplex.X (N + 1 + 1))) :=
    {c' | c' ∈ S ∧ c' ≫ R.map (I.cocomplex.d (N + 1 + 1) (N + 1 + 1 + 1)) = 0}
  have hT : T.Finite := hS.subset (fun x hx => hx.1)
  haveI := hT.to_subtype
  have hTS : Nat.card T ≤ Nat.card S := Nat.card_mono hS (fun x hx => hx.1)
  let Φ : T → Abelian.Ext (L.obj P) A (N + 1 + 1) := fun c' =>
    I.extMk ((adj.homEquiv P _).symm c'.1) (N + 1 + 1 + 1) rfl
      (by rw [← adj.homEquiv_naturality_right_symm, c'.2.2, hφs0])
  have hΦ : Function.Surjective Φ := by
    intro α
    obtain ⟨f, hf, rfl⟩ := I.extMk_surjective α (N + 1 + 1 + 1) rfl
    have hc : adj.homEquiv P _ f ≫ R.map (I.cocomplex.d (N + 1 + 1) (N + 1 + 1 + 1)) = 0 := by
      rw [← adj.homEquiv_naturality_right, hf, hφ0]
    obtain ⟨c', hc'S, hc'd, e, he⟩ := hrep (adj.homEquiv P _ f) hc
    refine ⟨⟨c', hc'S, hc'd⟩, ?_⟩
    refine (sub_eq_zero.mp ?_).symm
    rw [I.sub_extMk, I.extMk_eq_zero_iff _ _ _ _ (N + 1) rfl]
    refine ⟨(adj.homEquiv P _).symm e, ?_⟩
    rw [← adj.homEquiv_naturality_right_symm, Equiv.symm_apply_eq, hφsub, Equiv.apply_symm_apply]
    exact he
  have hfinA : Finite (Abelian.Ext (L.obj P) A (N + 1 + 1)) := Finite.of_surjective Φ hΦ
  exact ⟨hfinA, (Nat.card_le_card_of_surjective Φ hΦ).trans (hTS.trans hcardS)⟩

theorem wc_et_curve_top_coh_card_le : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (C : Scheme.{u}) (fC : C ⟶ Spec (.of Ω)) [IsProper fC] [IrreducibleSpace C], topologicalKrullDim C ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (ℓ : ℕ), ℓ.Prime → (ℓ : Ω) ≠ 0 → Finite (wcEtCoh C ℓ 2) ∧ Nat.card (wcEtCoh C ℓ 2) ≤ ℓ :=
by
  intro Ω _ _ C fC _ _ hdim ℓ hℓ hℓΩ
  have hnorm : ∀ (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX], IrreducibleSpace X →
      (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
      topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) → Nat.card (wcEtCoh X ℓ 2) = ℓ :=
    fun X fX _ hirr hst hd => wc_et_normal_curve_h2_card Ω X fX hirr hst hd ℓ hℓ hℓΩ
  have hcard : Nat.card (wcEtCoh C ℓ 2) = ℓ ^ Set.ncard {x : C | ¬ IsClosed ({x} : Set C)} :=
    wc_et_curve_h2_card_reduction Ω ℓ hℓ hℓΩ wc_et_henselian_proper_vanishing hnorm C fC hdim

  have hmin : ∀ s : TopologicalSpace.IrreducibleCloseds C, IsMin s ∨ IsMax s :=
    Order.krullDim_le_one_iff.mp (by simpa [topologicalKrullDim] using hdim)
  have hsub : {x : C | ¬ IsClosed ({x} : Set C)} ⊆ {genericPoint C} := by
    intro x hx
    simp only [Set.mem_setOf_eq] at hx
    rw [Set.mem_singleton_iff]
    by_contra hne
    have hcl : closure ({x} : Set C) ≠ {x} := fun h => hx (closure_eq_iff_isClosed.mp h)
    obtain ⟨y, hy, hyx⟩ : ∃ y ∈ closure ({x} : Set C), y ≠ x := by
      by_contra hh
      push_neg at hh
      apply hcl
      apply Set.Subset.antisymm
      · intro z hz
        exact hh z hz
      · exact subset_closure
    have hxy : x ⤳ y := specializes_iff_mem_closure.mpr hy
    have hnyx : x ∉ closure ({y} : Set C) := by
      intro h
      have hyx' : y ⤳ x := specializes_iff_mem_closure.mpr h
      exact hyx (hyx'.antisymm hxy).eq
    have hη : genericPoint C ∉ closure ({x} : Set C) := by
      intro h
      have h1 : x ⤳ genericPoint C := specializes_iff_mem_closure.mpr h
      have h2 : genericPoint C ⤳ x := (genericPoint_spec C).specializes (Set.mem_univ x)
      exact hne (h1.antisymm h2).eq
    let a : TopologicalSpace.IrreducibleCloseds C :=
      ⟨closure {y}, isIrreducible_singleton.closure, isClosed_closure⟩
    let b : TopologicalSpace.IrreducibleCloseds C :=
      ⟨closure {x}, isIrreducible_singleton.closure, isClosed_closure⟩
    let t : TopologicalSpace.IrreducibleCloseds C :=
      ⟨Set.univ, IrreducibleSpace.isIrreducible_univ C, isClosed_univ⟩
    have hab : a < b := by
      apply SetLike.coe_ssubset_coe.mp
      show closure ({y} : Set C) ⊂ closure ({x} : Set C)
      rw [Set.ssubset_def]
      exact ⟨closure_minimal (Set.singleton_subset_iff.mpr hy) isClosed_closure,
        fun h => hnyx (h (subset_closure (Set.mem_singleton x)))⟩
    have hbt : b < t := by
      apply SetLike.coe_ssubset_coe.mp
      show closure ({x} : Set C) ⊂ Set.univ
      rw [Set.ssubset_def]
      exact ⟨Set.subset_univ _, fun h => hη (h (Set.mem_univ _))⟩
    rcases hmin b with h | h
    · exact not_isMin_of_lt hab h
    · exact not_isMax_of_lt hbt h
  have hc : Set.ncard {x : C | ¬ IsClosed ({x} : Set C)} ≤ 1 :=
    (Set.ncard_le_ncard hsub (Set.finite_singleton _)).trans (Set.ncard_singleton _).le
  have hpos : 0 < ℓ ^ Set.ncard {x : C | ¬ IsClosed ({x} : Set C)} := pow_pos hℓ.pos _
  refine ⟨Nat.finite_of_card_ne_zero (by rw [hcard]; exact hpos.ne'), ?_⟩
  rw [hcard]
  calc ℓ ^ Set.ncard {x : C | ¬ IsClosed ({x} : Set C)} ≤ ℓ ^ 1 := Nat.pow_le_pow_right hℓ.pos hc
    _ = ℓ := pow_one ℓ

theorem wc_et_vanish_off_of_stalks : ∀ {B : Scheme.{u}} (F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (V : B.Etale) (g : F.obj.obj (Opposite.op V)) (v : V.left), Subsingleton ((wcEtStalk B (V.hom v)).obj F) → ∃ (V₁ : B.Etale) (c : V₁ ⟶ V), v ∈ Set.range c.left ∧ F.obj.map c.op g = 0 :=
by
  intro B F V g v hS
  haveI : Etale V.hom := V.prop
  have hb : V.hom v = (wcEtGeomPt B (V.hom v))
      (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField (V.hom v)))) := by
    have e1 := Scheme.Hom.comp_apply (Spec.map (CommRingCat.ofHom (algebraMap
      (B.residueField (V.hom v)) (AlgebraicClosure (B.residueField (V.hom v))))))
      (B.fromSpecResidueField (V.hom v))
      (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField (V.hom v))))
    refine (e1.trans ?_).symm
    first
      | exact Scheme.fromSpecResidueField_apply _ _ _
      | exact Scheme.fromSpecResidueField_apply _ _
      | simp only [Scheme.fromSpecResidueField_apply]
  obtain ⟨t, ht, htv⟩ := wc_etale_lift_alg_closed_point
    (AlgebraicClosure (B.residueField (V.hom v))) V.hom (wcEtGeomPt B (V.hom v)) v hb
  let X₀ : Over B := Over.mk (wcEtGeomPt B (V.hom v))
  let A : StructuredArrow X₀ (Scheme.Etale.forget B) :=
    StructuredArrow.mk (Y := V) (Over.homMk (U := X₀) (V := (Scheme.Etale.forget B).obj V) t ht)
  let G := (StructuredArrow.proj X₀ (Scheme.Etale.forget B)).op ⋙ F.obj
  haveI : IsCofiltered (StructuredArrow X₀ (Scheme.Etale.forget B)) :=
    IsCofiltered.of_hasFiniteLimits _
  haveI : Limits.PreservesFilteredColimitsOfSize.{u, u+1} (forget AddCommGrpCat.{u+1}) :=
    Limits.preservesFilteredColimitsOfSize_shrink.{u+1, u+1, u, u+1} (forget AddCommGrpCat.{u+1})
  obtain ⟨k, f, f', hfg⟩ := Limits.Concrete.colimit_exists_of_rep_eq G
    (i := Opposite.op A) (j := Opposite.op A) g 0 (@Subsingleton.elim _ hS _ _)
  refine ⟨k.unop.right, f.unop.right, ?_, ?_⟩
  · have hw : k.unop.hom.left ≫ f.unop.right.left = t :=
      congrArg (fun φ => φ.left) (StructuredArrow.w f.unop)
    refine ⟨k.unop.hom.left (IsLocalRing.closedPoint _), ?_⟩
    have e2 := Scheme.Hom.comp_apply k.unop.hom.left f.unop.right.left
      (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField (V.hom v))))
    have e3 : (k.unop.hom.left ≫ f.unop.right.left)
        (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField (V.hom v)))) =
        t (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField (V.hom v)))) := by
      first
        | rw [hw]
        | simp only [hw]
        | exact congrArg (fun φ => φ (IsLocalRing.closedPoint _)) hw
    exact (e2.symm.trans e3).trans htv
  · exact hfg.trans (map_zero _)

theorem wc_et_push_vanish_off_range : ∀ {Z B : Scheme.{u}} (i : Z ⟶ B) (H : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}), IsClosed (Set.range i) → ∀ (V : B.Etale) (g : ((wcEtPush i).obj H).obj.obj (Opposite.op V)) (v : V.left), V.hom v ∉ Set.range i → ∃ (V₁ : B.Etale) (c : V₁ ⟶ V), v ∈ Set.range c.left ∧ ((wcEtPush i).obj H).obj.map c.op g = 0 :=
by
  intro Z B i H hT V g v hv
  let O : V.left.Opens :=
    ⟨V.hom ⁻¹' (Set.range i)ᶜ, hT.isOpen_compl.preimage V.hom.continuous⟩
  let V₁ : B.Etale :=
    MorphismProperty.Over.mk ⊤ (O.ι ≫ V.hom) (by have := V.prop; infer_instance)
  let c : V₁ ⟶ V := MorphismProperty.Over.homMk O.ι rfl trivial
  refine ⟨V₁, c, ?_, ?_⟩
  · show v ∈ Set.range O.ι
    rw [Scheme.Opens.range_ι]
    exact hv
  ·
    have hP : ∀ (W : B.Etale) (_ : W ⟶ V₁),
        Subsingleton (H.obj.obj (Opposite.op ((wcEtBaseChange i).obj W))) := by
      intro W d
      have hE : IsEmpty ↥(Limits.pullback W.hom i) := by
        rw [Scheme.isEmpty_pullback_iff, Set.disjoint_left]
        rintro _ ⟨w, rfl⟩
        have hw : d.left ≫ V₁.hom = W.hom := MorphismProperty.Over.w d
        have e1 : W.hom w = V.hom (O.ι (d.left w)) := by
          rw [← hw, Scheme.Hom.comp_apply]
          exact Scheme.Hom.comp_apply O.ι V.hom (d.left w)
        rw [e1]
        have hmem : O.ι (d.left w) ∈ (O : Set V.left) := by
          rw [← Scheme.Opens.range_ι]; exact ⟨_, rfl⟩
        exact hmem
      have hcov : ∀ (S : Sieve ((wcEtBaseChange i).obj W)),
          S ∈ Scheme.smallEtaleTopology Z ((wcEtBaseChange i).obj W) := by
        intro S
        change S ∈ Scheme.smallGrothendieckTopology @Etale Z _
        rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Z
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
        apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Z
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
        intro x
        exact isEmptyElim (α := ↥(Limits.pullback W.hom i)) x
      have hz := (Sheaf.isTerminalOfBotCover H _ (hcov ⊥)).isZero
      exact AddCommGrpCat.isZero_iff_subsingleton.mp hz

    let J := Scheme.smallEtaleTopology B
    let P : (B.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1} := (wcEtBaseChange i).op ⋙ H.obj
    haveI := Presheaf.isLocallySurjective_toSheafify' J P
    let τ : (sheafify J P).obj (Opposite.op V₁) := ((wcEtPush i).obj H).obj.map c.op g
    have hS := Presheaf.imageSieve_mem J (toSheafify J P) τ
    refine Sheaf.isSeparated ((wcEtPush i).obj H) V₁ _ hS τ 0 ?_
    intro W d hd
    obtain ⟨t, ht⟩ := hd
    have ht0 : t = 0 := @Subsingleton.elim _ (hP W d) t 0
    have h1 : (ConcreteCategory.hom ((sheafify J P).map d.op)) τ = 0 := by
      rw [← ht, ht0, map_zero]
    exact h1.trans (map_zero _).symm

theorem wc_et_vanish_off_of_epi : ∀ {B : Scheme.{u}} (S : Set B) {F G : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}} (π : F ⟶ G), Epi π → (∀ (V : B.Etale) (g : F.obj.obj (Opposite.op V)) (v : V.left), V.hom v ∈ S → ∃ (V₁ : B.Etale) (c : V₁ ⟶ V), v ∈ Set.range c.left ∧ F.obj.map c.op g = 0) → ∀ (V : B.Etale) (g : G.obj.obj (Opposite.op V)) (v : V.left), V.hom v ∈ S → ∃ (V₁ : B.Etale) (c : V₁ ⟶ V), v ∈ Set.range c.left ∧ G.obj.map c.op g = 0 :=
by
  intro B S F G π hπ hF V g v hv
  have hLS : Sheaf.IsLocallySurjective π :=
    (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} π).mpr hπ
  have hmem : Presheaf.imageSieve π.hom g ∈ Scheme.smallEtaleTopology B V :=
    Presheaf.IsLocallySurjective.imageSieve_mem (self := hLS) g
  change _ ∈ Scheme.smallGrothendieckTopology @Etale B V at hmem
  rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
    MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hmem
  have key : ∃ (Y₁ : B.Etale) (f : Y₁ ⟶ V) (y : Y₁.left),
      (Presheaf.imageSieve π.hom g).arrows f ∧ f.left y = v := by
    obtain ⟨Y₁, f, y, hf, -, hy⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hmem v
    exact ⟨Y₁, f, y, hf, hy⟩
  obtain ⟨Y₁, f, y, hf, hy⟩ := key
  obtain ⟨t, ht⟩ := hf
  have hyS : Y₁.hom y ∈ S := by
    rw [← MorphismProperty.Over.w f, Scheme.Hom.comp_apply, hy]
    exact hv
  obtain ⟨V₂, c, ⟨z, hz⟩, hc⟩ := hF Y₁ t y hyS
  refine ⟨V₂, c ≫ f, ⟨z, ?_⟩, ?_⟩
  · change f.left (c.left z) = v
    rw [hz, hy]
  · have e : (ConcreteCategory.hom (G.obj.map (c ≫ f).op)) g =
        (ConcreteCategory.hom (G.obj.map c.op)) ((ConcreteCategory.hom (G.obj.map f.op)) g) := by
      rw [← ConcreteCategory.comp_apply, ← Functor.map_comp, ← op_comp]
    rw [e, ← ht, ← NatTrans.naturality_apply π.hom c.op t, hc, map_zero]

theorem wc_et_unit_mono_of_vanish_off : ∀ {X B : Scheme.{u}} (h : X ⟶ B) (L : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (adj : L ⊣ wcEtPush h) (G : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}), (∀ (V : B.Etale) (g : G.obj.obj (Opposite.op V)) (v : V.left), V.hom v ∉ Set.range h → ∃ (V₁ : B.Etale) (c : V₁ ⟶ V), v ∈ Set.range c.left ∧ G.obj.map c.op g = 0) → Mono (adj.unit.app G) :=
by
  intro X B h L adj G hLV

  have s1 : ∀ (F : (B.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (U : X.Etale) (V₁ : B.Etale)
      (a : U ⟶ (wcEtBaseChange h).obj V₁) (t : F.obj (Opposite.op V₁)),
      ((wcEtBaseChange h).op.lan.obj F).map a.op
        (((wcEtBaseChange h).op.lanUnit.app F).app (Opposite.op V₁) t) = 0 →
      ∃ (V₂ : B.Etale) (c : V₂ ⟶ V₁) (a' : U ⟶ (wcEtBaseChange h).obj V₂),
        a' ≫ (wcEtBaseChange h).map c = a ∧ F.map c.op t = 0 := by
    intro F U V₁ a t ht
    haveI : Limits.PreservesFiniteLimits (wcEtBaseChange h) := ⟨fun J _ _ =>
      haveI : Limits.PreservesLimitsOfShape J (wcEtBaseChange h ⋙ Scheme.Etale.forget X) :=
        Limits.preservesLimitsOfShape_of_natIso
          (NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl) :
            Scheme.Etale.forget B ⋙ Over.pullback h ≅ wcEtBaseChange h ⋙ Scheme.Etale.forget X)
      Limits.preservesLimitsOfShape_of_reflects_of_preserves (wcEtBaseChange h)
        (Scheme.Etale.forget X)⟩
    haveI : RepresentablyFlat (wcEtBaseChange h) := flat_of_preservesFiniteLimits _
    haveI : IsCofiltered (StructuredArrow U (wcEtBaseChange h)) := RepresentablyFlat.cofiltered U
    haveI hI : IsFiltered (CostructuredArrow (wcEtBaseChange h).op (Opposite.op U)) :=
      IsFiltered.of_equivalence (structuredArrowOpEquivalence (wcEtBaseChange h) U)
    haveI : IsFiltered (ULiftHom.{u+1} (CostructuredArrow (wcEtBaseChange h).op (Opposite.op U))) :=
      IsFiltered.of_equivalence ULiftHom.equiv
    haveI := Limits.preservesColimitsOfShape_of_equiv
      (ULiftHom.equiv (C := CostructuredArrow (wcEtBaseChange h).op (Opposite.op U))).symm
      (forget AddCommGrpCat.{u+1})
    let E := Functor.LeftExtension.mk ((wcEtBaseChange h).op.leftKanExtension F)
      ((wcEtBaseChange h).op.leftKanExtensionUnit F)
    have hc : Limits.IsColimit (E.coconeAt (Opposite.op U)) :=
      (wcEtBaseChange h).op.isPointwiseLeftKanExtensionLeftKanExtensionUnit F (Opposite.op U)
    have hleg : (E.coconeAt (Opposite.op U)).ι.app (CostructuredArrow.mk (Y := Opposite.op V₁) a.op) t =
        ((wcEtBaseChange h).op.lan.obj F).map a.op
          (((wcEtBaseChange h).op.lanUnit.app F).app (Opposite.op V₁) t) := rfl
    let j : CostructuredArrow (wcEtBaseChange h).op (Opposite.op U) :=
      CostructuredArrow.mk (Y := Opposite.op V₁) a.op
    let t' : ToType ((CostructuredArrow.proj (wcEtBaseChange h).op (Opposite.op U) ⋙ F).obj j) := t
    have h0 : (E.coconeAt (Opposite.op U)).ι.app j t' = (E.coconeAt (Opposite.op U)).ι.app j 0 := by
      rw [map_zero]
      exact hleg.trans ht
    obtain ⟨k, f, g', hfg⟩ := Limits.Concrete.isColimit_exists_of_rep_eq _ hc t' 0 h0
    have hw : (wcEtBaseChange h).op.map f.left ≫ k.hom = a.op := CostructuredArrow.w f
    refine ⟨k.left.unop, f.left.unop, k.hom.unop, ?_, ?_⟩
    · apply Quiver.Hom.op_inj
      rw [op_comp]
      exact hw
    · have : F.map f.left t = 0 := by
        refine hfg.trans ?_
        exact map_zero _
      exact this

  have s2 : ∀ (V : B.Etale) (S : Sieve V),
      Sieve.functorPushforward (wcEtBaseChange h) S ∈
        Scheme.smallEtaleTopology X ((wcEtBaseChange h).obj V) →
      (∀ v : V.left, V.hom v ∉ Set.range h →
        ∃ (V₁ : B.Etale) (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) →
      S ∈ Scheme.smallEtaleTopology B V := by
    intro V S hS' hoff
    change _ ∈ Scheme.smallGrothendieckTopology @Etale X _ at hS'
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS'
    have H := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS'
    change S ∈ Scheme.smallGrothendieckTopology @Etale B V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro v
    by_cases hv : V.hom v ∈ Set.range h
    swap
    · obtain ⟨V₁, c, hc, w, hw⟩ := hoff v hv
      have hwc : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
      have hEt : Etale c.left := by
        have h1 : Etale V.hom := V.prop
        have h2 : Etale (c.left ≫ V.hom) := by rw [hwc]; exact V₁.prop
        exact Etale.of_comp c.left V.hom
      exact ⟨V₁, c, w, hc, hEt, hw⟩
    obtain ⟨x, hx⟩ := hv
    obtain ⟨y, hy1, -⟩ := Scheme.Pullback.exists_preimage_pullback v x hx.symm
    obtain ⟨Y, f, y', hf, -, hfy⟩ := H y
    rw [Sieve.functorPushforward_apply] at hf
    obtain ⟨Z, g, k, hg, hfk⟩ := hf
    have hw : g.left ≫ V.hom = Z.hom := MorphismProperty.Over.w g
    have hEt : Etale g.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (g.left ≫ V.hom) := by rw [hw]; exact Z.prop
      exact Etale.of_comp g.left V.hom
    refine ⟨Z, g, Limits.pullback.fst Z.hom h (k.left y'), hg, hEt, ?_⟩
    have h0 : (Limits.pullback.fst Z.hom h ≫ g.left) ≫ V.hom =
        Limits.pullback.snd Z.hom h ≫ h := by
      rw [Category.assoc, MorphismProperty.Over.w g]
      exact Limits.pullback.condition
    have hm : ((wcEtBaseChange h).map g).left =
        Limits.pullback.lift (Limits.pullback.fst Z.hom h ≫ g.left)
          (Limits.pullback.snd Z.hom h) h0 := rfl
    have hmap : ((wcEtBaseChange h).map g).left ≫ Limits.pullback.fst V.hom h =
        Limits.pullback.fst Z.hom h ≫ g.left := by
      rw [hm]
      exact Limits.pullback.lift_fst _ _ _
    have e1 : f.left = k.left ≫ ((wcEtBaseChange h).map g).left := by
      rw [hfk]
      rfl
    calc g.left (Limits.pullback.fst Z.hom h (k.left y'))
        = (Limits.pullback.fst Z.hom h ≫ g.left) (k.left y') :=
          (Scheme.Hom.comp_apply _ _ _).symm
      _ = (((wcEtBaseChange h).map g).left ≫ Limits.pullback.fst V.hom h) (k.left y') := by
          rw [hmap]; rfl
      _ = Limits.pullback.fst V.hom h (((wcEtBaseChange h).map g).left (k.left y')) :=
          Scheme.Hom.comp_apply _ _ _
      _ = Limits.pullback.fst V.hom h ((k.left ≫ ((wcEtBaseChange h).map g).left) y') := by
          rw [Scheme.Hom.comp_apply]
      _ = Limits.pullback.fst V.hom h (f.left y') := by rw [e1]
      _ = v := by rw [hfy, hy1]

  have s3 : ∀ (V : B.Etale) (g : G.obj.obj (Opposite.op V)),
      (toSheafify (Scheme.smallEtaleTopology B) ((wcEtBaseChange h).op ⋙
        ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          ((wcEtBaseChange h).op.lan.obj G.obj)).obj)).app (Opposite.op V)
        ((toSheafify (Scheme.smallEtaleTopology X) ((wcEtBaseChange h).op.lan.obj G.obj)).app
          (Opposite.op ((wcEtBaseChange h).obj V))
          (((wcEtBaseChange h).op.lanUnit.app G.obj).app (Opposite.op V) g)) = 0 → g = 0 := by
    intro V g hyp
    haveI := Presheaf.isLocallyInjective_toSheafify' (Scheme.smallEtaleTopology B)
      ((wcEtBaseChange h).op ⋙ ((presheafToSheaf (Scheme.smallEtaleTopology X)
        AddCommGrpCat.{u+1}).obj ((wcEtBaseChange h).op.lan.obj G.obj)).obj)
    haveI := Presheaf.isLocallyInjective_toSheafify' (Scheme.smallEtaleTopology X)
      ((wcEtBaseChange h).op.lan.obj G.obj)
    have hS₁ := Presheaf.equalizerSieve_mem (Scheme.smallEtaleTopology B)
      (toSheafify (Scheme.smallEtaleTopology B) ((wcEtBaseChange h).op ⋙
        ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          ((wcEtBaseChange h).op.lan.obj G.obj)).obj)) (X := Opposite.op V)
      ((toSheafify (Scheme.smallEtaleTopology X) ((wcEtBaseChange h).op.lan.obj G.obj)).app
          (Opposite.op ((wcEtBaseChange h).obj V))
          (((wcEtBaseChange h).op.lanUnit.app G.obj).app (Opposite.op V) g)) 0
      (hyp.trans (map_zero _).symm)
    have hT : Presheaf.equalizerSieve (F := G.obj) (X := Opposite.op V) g 0 ∈
        Scheme.smallEtaleTopology B V := by
      refine GrothendieckTopology.transitive _ hS₁ _ ?_
      intro W d hd
      rw [Presheaf.equalizerSieve_apply, map_zero] at hd
      refine s2 W (Sieve.pullback d (Presheaf.equalizerSieve (F := G.obj) (X := Opposite.op V) g 0))
        ?_ ?_
      · have hW : (toSheafify (Scheme.smallEtaleTopology X) ((wcEtBaseChange h).op.lan.obj G.obj)).app
            (Opposite.op ((wcEtBaseChange h).obj W))
            (((wcEtBaseChange h).op.lanUnit.app G.obj).app (Opposite.op W) (G.obj.map d.op g)) = 0 := by
          refine Eq.trans ?_ hd
          have n1 : ((wcEtBaseChange h).op.lanUnit.app G.obj).app (Opposite.op W) (G.obj.map d.op g) =
              ((wcEtBaseChange h).op.lan.obj G.obj).map ((wcEtBaseChange h).op.map d.op)
                (((wcEtBaseChange h).op.lanUnit.app G.obj).app (Opposite.op V) g) :=
            NatTrans.naturality_apply ((wcEtBaseChange h).op.lanUnit.app G.obj) d.op g
          have n2 := NatTrans.naturality_apply
            (toSheafify (Scheme.smallEtaleTopology X) ((wcEtBaseChange h).op.lan.obj G.obj))
            ((wcEtBaseChange h).op.map d.op)
            (((wcEtBaseChange h).op.lanUnit.app G.obj).app (Opposite.op V) g)
          rw [n1]
          exact n2
        have hS₂ := Presheaf.equalizerSieve_mem (Scheme.smallEtaleTopology X)
          (toSheafify (Scheme.smallEtaleTopology X) ((wcEtBaseChange h).op.lan.obj G.obj))
          (X := Opposite.op ((wcEtBaseChange h).obj W))
          (((wcEtBaseChange h).op.lanUnit.app G.obj).app (Opposite.op W) (G.obj.map d.op g)) 0
          (hW.trans (map_zero _).symm)
        refine GrothendieckTopology.superset_covering _ ?_ hS₂
        intro U e he
        rw [Presheaf.equalizerSieve_apply, map_zero] at he
        obtain ⟨V₂, c, a', hca, hc0⟩ := s1 G.obj U W e (G.obj.map d.op g) he
        rw [Sieve.functorPushforward_apply]
        show ∃ (Z : B.Etale) (g₁ : Z ⟶ W) (k : U ⟶ (wcEtBaseChange h).obj Z),
          (Sieve.pullback d (Presheaf.equalizerSieve (F := G.obj) (X := Opposite.op V) g 0)).arrows g₁ ∧
            e = k ≫ (wcEtBaseChange h).map g₁
        refine ⟨V₂, c, a', ?_, hca.symm⟩
        show G.obj.map (c ≫ d).op g = G.obj.map (c ≫ d).op 0
        rw [map_zero, op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
        exact hc0
      · intro w hw
        obtain ⟨V₁, c, hwc, hc0⟩ := hLV W (G.obj.map d.op g) w hw
        refine ⟨V₁, c, ?_, hwc⟩
        show G.obj.map (c ≫ d).op g = G.obj.map (c ≫ d).op 0
        rw [map_zero, op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
        exact hc0
    exact Sheaf.isSeparated G V _ hT g 0 (fun Y k hk => hk)

  let L₀G := (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
    ((wcEtBaseChange h).op.lan.obj G.obj)
  let ψ : G ⟶ (wcEtPush h).obj L₀G := ObjectProperty.homMk
    (((wcEtBaseChange h).op.lanUnit.app G.obj) ≫
      Functor.whiskerLeft (wcEtBaseChange h).op
        (toSheafify (Scheme.smallEtaleTopology X) ((wcEtBaseChange h).op.lan.obj G.obj)) ≫
      toSheafify (Scheme.smallEtaleTopology B) ((wcEtBaseChange h).op ⋙ L₀G.obj))
  haveI hψ : Mono ψ := by
    apply Preadditive.mono_of_cancel_zero
    intro P k hk
    apply Sheaf.hom_ext
    ext V x
    have h1 : (k ≫ ψ).hom.app V = (0 : P ⟶ (wcEtPush h).obj L₀G).hom.app V := by rw [hk]
    have h2 := ConcreteCategory.congr_hom h1 x
    exact (s3 V.unop (k.hom.app V x) h2).trans rfl
  have hfac : adj.unit.app G ≫ (wcEtPush h).map ((adj.homEquiv G L₀G).symm ψ) = ψ := by
    have e := adj.homEquiv_unit (f := (adj.homEquiv G L₀G).symm ψ)
    rw [Equiv.apply_symm_apply] at e
    exact e.symm
  haveI : Mono (adj.unit.app G ≫ (wcEtPush h).map ((adj.homEquiv G L₀G).symm ψ)) := by
    rw [hfac]; exact hψ
  exact mono_of_mono (adj.unit.app G) ((wcEtPush h).map ((adj.homEquiv G L₀G).symm ψ))

theorem wc_et_closed_bc_cover_dense : ∀ {Z B : Scheme.{u}} (i : Z ⟶ B) [IsClosedImmersion i], (∀ {T V : Scheme.{u}} (j : T ⟶ V) [IsClosedImmersion j] {W : Scheme.{u}} (w : W ⟶ T) [Etale w] (x : W), ∃ (V' : Scheme.{u}) (e : V' ⟶ V) (_ : Etale e) (h : Limits.pullback e j ⟶ W) (x' : ↥(Limits.pullback e j)), h ≫ w = Limits.pullback.snd e j ∧ h x' = x) → (wcEtBaseChange i).IsCoverDense (Scheme.smallEtaleTopology Z) :=
by
  intro Z B i _ hlift
  refine Functor.IsCoverDense.mk (fun U => ?_)
  haveI : Etale U.hom := U.prop
  choose V' e he h x' hh hx' using fun x : U.left => hlift i U.hom x
  let W : U.left → B.Etale := fun x => MorphismProperty.Over.mk ⊤ (e x) (he x)
  let k : ∀ x : U.left, (wcEtBaseChange i).obj (W x) ⟶ U := fun x =>
    MorphismProperty.Over.homMk (h x) (hh x) trivial
  have hmem : Sieve.ofArrows (fun x => (wcEtBaseChange i).obj (W x)) k ∈
      Scheme.smallEtaleTopology Z U := by
    rw [Scheme.ofArrows_mem_smallEtaleTopology_iff]
    exact Set.eq_univ_of_forall (fun x => Set.mem_iUnion.mpr ⟨x, x' x, hx' x⟩)
  refine GrothendieckTopology.superset_covering _ ?_ hmem
  rw [Sieve.ofArrows, Sieve.generate_le_iff]
  intro Y f hf
  cases hf with
  | mk x => exact Presieve.in_coverByImage _ (k x)

theorem wc_et_closed_bc_locally_full : ∀ {Z B : Scheme.{u}} (i : Z ⟶ B) [IsClosedImmersion i], (∀ {T V : Scheme.{u}} (j : T ⟶ V) [IsClosedImmersion j] {W : Scheme.{u}} (w : W ⟶ T) [Etale w] (x : W), ∃ (V' : Scheme.{u}) (e : V' ⟶ V) (_ : Etale e) (h : Limits.pullback e j ⟶ W) (x' : ↥(Limits.pullback e j)), h ≫ w = Limits.pullback.snd e j ∧ h x' = x) → (wcEtBaseChange i).IsLocallyFull (Scheme.smallEtaleTopology Z) :=
by
  intro Z B i _ hL
  refine Functor.IsLocallyFull.mk (fun {U V} f => ?_)
  haveI : Etale U.hom := U.prop
  haveI : Etale V.hom := V.prop
  obtain ⟨φ, hφdef⟩ : ∃ φ : Limits.pullback U.hom i ⟶ Limits.pullback V.hom i, φ = f.left :=
    ⟨f.left, rfl⟩
  have hφ : φ ≫ Limits.pullback.snd V.hom i = Limits.pullback.snd U.hom i := by
    rw [hφdef]; exact MorphismProperty.Over.w f
  obtain ⟨pB, hpB⟩ : ∃ pB : Limits.pullback U.hom V.hom ⟶ B,
      pB = Limits.pullback.fst U.hom V.hom ≫ U.hom := ⟨_, rfl⟩
  have hp' : Limits.pullback.fst U.hom V.hom ≫ U.hom = pB := hpB.symm
  have hcUV : Limits.pullback.snd U.hom V.hom ≫ V.hom = pB := by
    rw [← hp']; exact (Limits.pullback.condition (f := U.hom) (g := V.hom)).symm
  haveI : Etale pB := by rw [hpB]; infer_instance

  obtain ⟨Γ, hΓs, hΓ1, hΓ2⟩ : ∃ Γ : Limits.pullback U.hom i ⟶ Limits.pullback pB i,
      Γ ≫ Limits.pullback.snd pB i = Limits.pullback.snd U.hom i ∧
      Γ ≫ Limits.pullback.fst pB i ≫ Limits.pullback.fst U.hom V.hom =
        Limits.pullback.fst U.hom i ∧
      Γ ≫ Limits.pullback.fst pB i ≫ Limits.pullback.snd U.hom V.hom =
        φ ≫ Limits.pullback.fst V.hom i := by
    have e1 : Limits.pullback.fst U.hom i ≫ U.hom =
        (φ ≫ Limits.pullback.fst V.hom i) ≫ V.hom := by
      rw [Limits.pullback.condition (f := U.hom) (g := i), ← hφ, Category.assoc, Category.assoc,
        ← Limits.pullback.condition (f := V.hom) (g := i)]
    have e2 : Limits.pullback.lift _ _ e1 ≫ pB = Limits.pullback.snd U.hom i ≫ i := by
      rw [← hp', Limits.pullback.lift_fst_assoc, Limits.pullback.condition]
    exact ⟨Limits.pullback.lift _ _ e2, Limits.pullback.lift_snd _ _ _,
      by rw [Limits.pullback.lift_fst_assoc, Limits.pullback.lift_fst],
      by rw [Limits.pullback.lift_fst_assoc, Limits.pullback.lift_snd]⟩
  haveI : Etale Γ := by
    haveI : Etale (Γ ≫ Limits.pullback.snd pB i) := by rw [hΓs]; infer_instance
    exact Etale.of_comp Γ (Limits.pullback.snd pB i)

  change _ ∈ Scheme.smallGrothendieckTopology @Etale Z _
  rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Z
    MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
  apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Z
    MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
  intro x
  obtain ⟨E, e, he, h, x', hh, hx'⟩ := hL (Limits.pullback.fst pB i) Γ x
  haveI := he
  let W' : B.Etale := MorphismProperty.Over.mk ⊤ (e ≫ pB) inferInstance
  let g : W' ⟶ U := MorphismProperty.Over.homMk (e ≫ Limits.pullback.fst U.hom V.hom)
    (by show (e ≫ Limits.pullback.fst U.hom V.hom) ≫ U.hom = e ≫ pB
        rw [Category.assoc, hp']) trivial
  let g' : W' ⟶ V := MorphismProperty.Over.homMk (e ≫ Limits.pullback.snd U.hom V.hom)
    (by show (e ≫ Limits.pullback.snd U.hom V.hom) ≫ V.hom = e ≫ pB
        rw [Category.assoc, hcUV]) trivial
  have h0 : (Limits.pullback.fst (e ≫ pB) i ≫ (e ≫ Limits.pullback.fst U.hom V.hom)) ≫ U.hom =
      Limits.pullback.snd (e ≫ pB) i ≫ i := by
    simp only [Category.assoc]
    rw [hp']
    exact Limits.pullback.condition
  have h0' : (Limits.pullback.fst (e ≫ pB) i ≫ (e ≫ Limits.pullback.snd U.hom V.hom)) ≫ V.hom =
      Limits.pullback.snd (e ≫ pB) i ≫ i := by
    simp only [Category.assoc]
    rw [hcUV]
    exact Limits.pullback.condition
  have hm : ((wcEtBaseChange i).map g).left =
      Limits.pullback.lift (Limits.pullback.fst (e ≫ pB) i ≫ (e ≫ Limits.pullback.fst U.hom V.hom))
        (Limits.pullback.snd (e ≫ pB) i) h0 := rfl
  have hm' : ((wcEtBaseChange i).map g').left =
      Limits.pullback.lift (Limits.pullback.fst (e ≫ pB) i ≫ (e ≫ Limits.pullback.snd U.hom V.hom))
        (Limits.pullback.snd (e ≫ pB) i) h0' := rfl

  have hMρ : ((wcEtBaseChange i).map g).left =
      (Limits.pullbackRightPullbackFstIso pB i e).inv ≫ h := by
    rw [hm]
    apply Limits.pullback.hom_ext
    · rw [Limits.pullback.lift_fst]
      simp only [Category.assoc]
      rw [← hΓ1, reassoc_of% hh, Limits.pullbackRightPullbackFstIso_inv_snd_fst_assoc]
    · rw [Limits.pullback.lift_snd]
      simp only [Category.assoc]
      rw [← hΓs, reassoc_of% hh, Limits.pullbackRightPullbackFstIso_inv_snd_snd]

  have keyL : Limits.pullback.lift
      (Limits.pullback.fst (e ≫ pB) i ≫ (e ≫ Limits.pullback.snd U.hom V.hom))
      (Limits.pullback.snd (e ≫ pB) i) h0' =
      ((Limits.pullbackRightPullbackFstIso pB i e).inv ≫ h) ≫ φ := by
    apply Limits.pullback.hom_ext
    · rw [Limits.pullback.lift_fst, Category.assoc, Category.assoc,
        ← hΓ2, reassoc_of% hh, Limits.pullbackRightPullbackFstIso_inv_snd_fst_assoc]
    · rw [Limits.pullback.lift_snd, Category.assoc, Category.assoc,
        hφ, ← hΓs, reassoc_of% hh, Limits.pullbackRightPullbackFstIso_inv_snd_snd]
  have key : (wcEtBaseChange i).map g' = (wcEtBaseChange i).map g ≫ f := by
    apply MorphismProperty.Over.Hom.ext
    show ((wcEtBaseChange i).map g').left = ((wcEtBaseChange i).map g).left ≫ f.left
    rw [← hφdef, hMρ, hm']
    exact keyL
  have hg : ((wcEtBaseChange i).imageSieve f).arrows g := ⟨g', key⟩
  refine ⟨(wcEtBaseChange i).obj W', (wcEtBaseChange i).map g,
    (Limits.pullbackRightPullbackFstIso pB i e).hom x',
    Sieve.image_mem_functorPushforward (wcEtBaseChange i) _ hg, ?_, ?_⟩
  · have hw : ((wcEtBaseChange i).map g).left ≫ ((wcEtBaseChange i).obj U).hom =
        ((wcEtBaseChange i).obj W').hom := MorphismProperty.Over.w _
    have h1 : Etale ((wcEtBaseChange i).obj U).hom := ((wcEtBaseChange i).obj U).prop
    have h2 : Etale (((wcEtBaseChange i).map g).left ≫ ((wcEtBaseChange i).obj U).hom) := by
      rw [hw]; exact ((wcEtBaseChange i).obj W').prop
    exact Etale.of_comp _ ((wcEtBaseChange i).obj U).hom
  · have hy : (Limits.pullbackRightPullbackFstIso pB i e).inv
        ((Limits.pullbackRightPullbackFstIso pB i e).hom x') = x' := by
      rw [← Scheme.Hom.comp_apply, Iso.hom_inv_id]
      all_goals rfl
    have hpt : ((Limits.pullbackRightPullbackFstIso pB i e).inv ≫ h)
        ((Limits.pullbackRightPullbackFstIso pB i e).hom x') = x := by
      rw [Scheme.Hom.comp_apply, hy, hx']
    rw [hMρ]
    exact hpt

theorem wc_et_push_counit_iso_of_dense_full : ∀ {Z B : Scheme.{u}} (i : Z ⟶ B) [(wcEtBaseChange i).IsCoverDense (Scheme.smallEtaleTopology Z)] [(wcEtBaseChange i).IsLocallyFull (Scheme.smallEtaleTopology Z)] (L : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (adj : L ⊣ wcEtPush i), IsIso adj.counit :=
by
  intro Z Y i _ _ L adj
  haveI hlim : Limits.PreservesFiniteLimits (wcEtBaseChange i) :=
    @Limits.preservesFiniteLimits_of_reflects_of_preserves _ _ _ _ _ _ (wcEtBaseChange i)
      (Scheme.Etale.forget Z)
      (inferInstanceAs (Limits.PreservesFiniteLimits (Scheme.Etale.forget Y ⋙ Over.pullback i)))
      inferInstance
  have hcov : CoverPreserving (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology Z)
      (wcEtBaseChange i) := by
    refine ⟨fun {V} {R} hR => ?_⟩
    have key : ∀ {ι : Type u} (X' : ι → Y.Etale) (f' : ∀ j, X' j ⟶ V),
        Presieve.ofArrows X' f' ≤ R.arrows → (∀ x : V.left, ∃ j y, (f' j).left y = x) →
        R.functorPushforward (wcEtBaseChange i) ∈
          Scheme.smallEtaleTopology Z ((wcEtBaseChange i).obj V) := by
      intro ι X' f' hle hsurj
      have hmem : Sieve.ofArrows (fun j => (wcEtBaseChange i).obj (X' j))
          (fun j => (wcEtBaseChange i).map (f' j)) ∈
          Scheme.smallEtaleTopology Z ((wcEtBaseChange i).obj V) := by
        rw [Scheme.ofArrows_mem_smallEtaleTopology_iff]
        apply Set.eq_univ_of_forall
        intro z
        obtain ⟨j, y, hy⟩ := hsurj (Limits.pullback.fst V.hom i z)
        refine Set.mem_iUnion.mpr ⟨j, ?_⟩
        have hr := @Scheme.Pullback.range_map _ _ _ (X' j).hom i _ _ _ V.hom i (f' j).left
          (𝟙 Z) (𝟙 Y)
          ((Category.comp_id _).trans (MorphismProperty.Over.w (f' j)).symm)
          ((Category.comp_id i).trans (Category.id_comp i).symm) (inferInstance : Mono (𝟙 Y))
        show z ∈ Set.range (Limits.pullback.map (X' j).hom i V.hom i (f' j).left (𝟙 Z) (𝟙 Y)
          ((Category.comp_id _).trans (MorphismProperty.Over.w (f' j)).symm)
          ((Category.comp_id i).trans (Category.id_comp i).symm))
        rw [hr]
        exact ⟨⟨y, hy⟩, ⟨Limits.pullback.snd V.hom i z, rfl⟩⟩
      refine GrothendieckTopology.superset_covering _ ?_ hmem
      rw [Sieve.ofArrows, Sieve.generate_le_iff]
      intro W f hf
      cases hf with
      | mk j => exact Sieve.image_mem_functorPushforward _ _ (hle _ _ (Presieve.ofArrows.mk j))
    obtain ⟨𝒰, h₁, h, hle⟩ := (Scheme.mem_smallGrothendieckTopology V R).1 hR
    haveI : Scheme.JointlySurjective.{u} (Scheme.precoverage (@Etale : MorphismProperty Scheme.{u})) :=
      Scheme.instJointlySurjectivePrecoverage
    unfold Scheme.Cover.toPresieveOverProp at hle
    exact key _ _ hle (fun x => 𝒰.exists_eq x)
  haveI := flat_of_preservesFiniteLimits (wcEtBaseChange i)
  haveI hcont : (wcEtBaseChange i).IsContinuous (Scheme.smallEtaleTopology Y)
      (Scheme.smallEtaleTopology Z) :=
    Functor.isContinuous_of_coverPreserving
      (compatiblePreservingOfFlat (Scheme.smallEtaleTopology Z) (wcEtBaseChange i)) hcov
  let F := (wcEtBaseChange i).sheafPushforwardContinuous AddCommGrpCat.{u+1}
    (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology Z)
  haveI hFull : F.Full := Functor.IsCoverDense.full_sheafPushforwardContinuous
    (A := AddCommGrpCat.{u+1}) (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology Z)
    (wcEtBaseChange i)
  haveI hFaith : F.Faithful := Functor.IsCoverDense.faithful_sheafPushforwardContinuous
    (A := AddCommGrpCat.{u+1}) (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology Z)
    (wcEtBaseChange i)
  let α : F ≅ wcEtPush i :=
    (Functor.rightUnitor F).symm
      ≪≫ Functor.isoWhiskerLeft F (sheafificationNatIso (Scheme.smallEtaleTopology Y)
        AddCommGrpCat.{u+1})
      ≪≫ (Functor.associator F _ _).symm
      ≪≫ Functor.isoWhiskerRight (Functor.sheafPushforwardContinuousCompSheafToPresheafIso
        (wcEtBaseChange i) AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y)
        (Scheme.smallEtaleTopology Z)) _
      ≪≫ Functor.associator _ _ _
  haveI : (wcEtPush i).Full := Functor.Full.of_iso α
  haveI : (wcEtPush i).Faithful := Functor.Faithful.of_iso α
  exact Adjunction.counit_isIso_of_R_fully_faithful adj

theorem wc_et_low_support_coh_vanish : ∀ (K : Type u) [Field K] [IsAlgClosed K] (B : Scheme.{u}) (fB : B ⟶ Spec (.of K)) [IsProper fB] (T : Set B), IsClosed T → ∀ n : ℕ, topologicalKrullDim ↥T < (n : WithBot ℕ∞) → ∀ (m : ℕ), (m : K) ≠ 0 → ∀ (G : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}), m • 𝟙 G = 0 → (∀ b : B, b ∉ T → Subsingleton ((wcEtStalk B b).obj G)) → letI : HasExt (Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) := HasExt.standard _; ∀ q : ℕ, 2 * n < q + 2 → ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) G q, x = 0 :=
by
  intro K _ _ B fB _ T hT n hTd m hm G hG hstalk
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) := HasExt.standard _
  intro q hq x
  rcases n with _ | d
  ·
    have hTe : T = ∅ := by
      by_contra hne
      obtain ⟨t, ht⟩ := Set.nonempty_iff_ne_empty.mpr hne
      haveI : Nonempty (TopologicalSpace.IrreducibleCloseds ↥T) :=
        ⟨⟨closure {(⟨t, ht⟩ : ↥T)}, isIrreducible_singleton.closure, isClosed_closure⟩⟩
      have h0 : (0 : WithBot ℕ∞) ≤ topologicalKrullDim ↥T := Order.krullDim_nonneg
      have h1 : topologicalKrullDim ↥T < 0 := by simpa using hTd
      exact absurd h1 (not_lt.mpr h0)
    have hz : Limits.IsZero G :=
      wc_et_stalks_zero G (fun b => hstalk b (by simp [hTe]))
    calc x = x.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero q) := (Abelian.Ext.comp_mk₀_id x).symm
      _ = x.comp (Abelian.Ext.mk₀ 0) (add_zero q) := by rw [hz.eq_of_src (𝟙 _) 0]
      _ = 0 := by rw [Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
  ·
    have hq' : 2 * d < q := by omega

    obtain ⟨Z, i, hi, hrange, hdim⟩ : ∃ (Z : Scheme.{u}) (i : Z ⟶ B), IsClosedImmersion i ∧
        Set.range i = T ∧ topologicalKrullDim Z = topologicalKrullDim ↥T := by
      let I := Scheme.IdealSheafData.vanishingIdeal (⟨T, hT⟩ : TopologicalSpace.Closeds B)
      have hr : Set.range I.subschemeι = T := by
        rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.coe_support_vanishingIdeal]
        rfl
      refine ⟨I.subscheme, I.subschemeι, inferInstance, hr, ?_⟩
      have e := (I.subschemeι.isClosedEmbedding.isEmbedding).toHomeomorph
      exact IsHomeomorph.topologicalKrullDim_eq _ ((e.trans (Homeomorph.setCongr hr)).isHomeomorph)
    haveI := hi
    have hZd : topologicalKrullDim Z ≤ (d : WithBot ℕ∞) := by
      rw [hdim]
      generalize topologicalKrullDim ↥T = y at hTd ⊢
      induction y using WithBot.recBotCoe with
      | bot => exact bot_le
      | coe e =>
        induction e using ENat.recTopCoe with
        | top =>
          exfalso
          exact absurd hTd (not_lt.mpr (WithBot.coe_le_coe.mpr le_top))
        | coe k =>
          have hk : k < d + 1 := by exact_mod_cast hTd
          exact_mod_cast (show k ≤ d by omega)
    haveI : IsFinite i := inferInstance
    haveI : IsProper (i ≫ fB) := inferInstance
    have hTc : IsClosed (Set.range i) := i.isClosedEmbedding.isClosed_range

    obtain ⟨L, ⟨adj⟩, -, -⟩ := wc_et_push_left_adjoint i
    haveI := adj.isRightAdjoint
    haveI := adj.isLeftAdjoint
    haveI := adj.rightAdjoint_preservesLimits.{0, 0}
    haveI : (wcEtPush i).PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isRightAdjoint _
    haveI : (wcEtPush i).Additive := Functor.additive_of_preserves_binary_products _
    haveI : L.Additive := adj.left_adjoint_additive
    haveI : L.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint L
    haveI : L.PreservesEpimorphisms := Functor.preservesEpimorphisms_of_isLeftAdjoint L
    have htors : m • 𝟙 (L.obj G) = 0 := by
      rw [← L.map_id, ← L.map_nsmul, hG, L.map_zero]

    haveI := wc_et_closed_bc_cover_dense i
      (by intros; exact wc_etale_lift_closed_immersion wc_etale_lift_quotient_alg _ _ _)
    haveI := wc_et_closed_bc_locally_full i
      (by intros; exact wc_etale_lift_closed_immersion wc_etale_lift_quotient_alg _ _ _)
    haveI hcounit : IsIso adj.counit := wc_et_push_counit_iso_of_dense_full i L adj

    let P : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1} → Prop := fun F =>
      ∀ (V : B.Etale) (g : F.obj.obj (Opposite.op V)) (v : V.left), V.hom v ∈ (Set.range i)ᶜ →
        ∃ (V₁ : B.Etale) (c : V₁ ⟶ V), v ∈ Set.range c.left ∧ F.obj.map c.op g = 0
    have hPpush : ∀ H, P ((wcEtPush i).obj H) := fun H V g v hv =>
      wc_et_push_vanish_off_range i H hTc V g v hv
    have hPepi : ∀ {F F' : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}} (π : F ⟶ F'),
        Epi π → P F → P F' := fun π hπ hF => wc_et_vanish_off_of_epi (Set.range i)ᶜ π hπ hF
    have hPmono : ∀ F, P F → Mono (adj.unit.app F) := fun F hF =>
      wc_et_unit_mono_of_vanish_off i L adj F hF
    have hPG : P G := by
      intro V g v hv
      apply wc_et_vanish_off_of_stalks G V g v
      apply hstalk
      rw [← hrange]
      exact hv

    have hunit : ∀ F, P F → IsIso (adj.unit.app F) := by
      intro F hF
      haveI := hPmono F hF
      have hPC : P (Limits.cokernel (adj.unit.app F)) :=
        hPepi (Limits.cokernel.π (adj.unit.app F)) inferInstance (hPpush _)
      have eL : L.map (adj.unit.app F) = inv (adj.counit.app (L.obj F)) :=
        IsIso.eq_inv_of_inv_hom_id (adj.left_triangle_components F)
      haveI : IsIso (L.map (adj.unit.app F)) := by
        rw [eL]
        exact IsIso.inv_isIso
      have hLπ : L.map (Limits.cokernel.π (adj.unit.app F)) = 0 := by
        rw [← cancel_epi (L.map (adj.unit.app F)), ← L.map_comp, Limits.cokernel.condition,
          L.map_zero, Limits.comp_zero]
      have hLC : Limits.IsZero (L.obj (Limits.cokernel (adj.unit.app F))) :=
        Limits.IsZero.of_epi_eq_zero (L.map (Limits.cokernel.π (adj.unit.app F))) hLπ
      have hRLC : Limits.IsZero ((wcEtPush i).obj (L.obj (Limits.cokernel (adj.unit.app F)))) :=
        (wcEtPush i).map_isZero hLC
      haveI := hPmono _ hPC
      have hC : Limits.IsZero (Limits.cokernel (adj.unit.app F)) :=
        Limits.IsZero.of_mono (adj.unit.app (Limits.cokernel (adj.unit.app F))) hRLC
      have hπ0 : Limits.cokernel.π (adj.unit.app F) = 0 := hC.eq_of_tgt _ _
      haveI : Epi (adj.unit.app F) := Abelian.epi_of_cokernel_π_eq_zero _ hπ0
      exact isIso_of_mono_of_epi _
    haveI := hunit G hPG

    obtain ⟨E₂⟩ := wc_et_finite_push_ext_equiv i (L.obj G) q
    have hvan := wc_et_cd_proper_torsion K Z (i ≫ fB) d hZd m hm (L.obj G) htors q hq'
    have h1 : x.comp (Abelian.Ext.mk₀ (adj.unit.app G)) (add_zero q) = 0 := by
      apply E₂.injective
      exact (hvan _).trans (hvan _).symm
    calc x = (x.comp (Abelian.Ext.mk₀ (adj.unit.app G)) (add_zero q)).comp
          (Abelian.Ext.mk₀ (inv (adj.unit.app G))) (add_zero q) := by
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, IsIso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
      _ = 0 := by rw [h1, Abelian.Ext.zero_comp]

theorem wc_ext_card_le_of_coker_vanish : ∀ {C : Type*} [Category C] [Abelian C] [HasExt C] (P G F : C) (φ : G ⟶ F) (N : ℕ), (∀ x : Abelian.Ext P (Limits.kernel φ) (N + 1), x = 0) → (∀ x : Abelian.Ext P (Limits.cokernel φ) N, x = 0) → Finite (Abelian.Ext P G N) → Finite (Abelian.Ext P F N) ∧ Nat.card (Abelian.Ext P F N) ≤ Nat.card (Abelian.Ext P G N) :=
by
  intro C _ _ _ P G F φ N hK hQ hG
  classical
  haveI := hG
  have hfac : Abelian.factorThruImage φ ≫ Abelian.image.ι φ = φ := Abelian.image.fac φ
  have w1 : Limits.kernel.ι φ ≫ Abelian.factorThruImage φ = 0 := by
    rw [← cancel_mono (Abelian.image.ι φ), Category.assoc, hfac, Limits.kernel.condition,
      Limits.zero_comp]
  have w2 : Abelian.image.ι φ ≫ Limits.cokernel.π φ = 0 := by
    rw [← cancel_epi (Abelian.factorThruImage φ), ← Category.assoc, hfac, Limits.cokernel.condition,
      Limits.comp_zero]
  let S1 := ShortComplex.mk (Limits.kernel.ι φ) (Abelian.factorThruImage φ) w1
  let Sk := ShortComplex.mk (Limits.kernel.ι φ) φ (Limits.kernel.condition φ)
  let ψ1 : S1 ⟶ Sk :=
    { τ₁ := 𝟙 _
      τ₂ := 𝟙 _
      τ₃ := Abelian.image.ι φ
      comm₁₂ := by simp [S1, Sk]
      comm₂₃ := by simp [S1, Sk, hfac] }
  haveI : Epi ψ1.τ₁ := by change Epi (𝟙 _); infer_instance
  haveI : IsIso ψ1.τ₂ := by change IsIso (𝟙 _); infer_instance
  haveI : Mono ψ1.τ₃ := by change Mono (Abelian.image.ι φ); infer_instance
  have hE1 : S1.Exact :=
    (ShortComplex.exact_iff_of_epi_of_isIso_of_mono ψ1).mpr (ShortComplex.exact_kernel φ)
  have hS1 : S1.ShortExact :=
    ShortComplex.ShortExact.mk' hE1 (inferInstance : Mono (Limits.kernel.ι φ))
      (inferInstance : Epi (Abelian.factorThruImage φ))
  let S2 := ShortComplex.mk (Abelian.image.ι φ) (Limits.cokernel.π φ) w2
  let Sc := ShortComplex.mk φ (Limits.cokernel.π φ) (Limits.cokernel.condition φ)
  let ψ2 : Sc ⟶ S2 :=
    { τ₁ := Abelian.factorThruImage φ
      τ₂ := 𝟙 _
      τ₃ := 𝟙 _
      comm₁₂ := by simp [S2, Sc, hfac]
      comm₂₃ := by simp [S2, Sc] }
  haveI : Epi ψ2.τ₁ := by change Epi (Abelian.factorThruImage φ); infer_instance
  haveI : IsIso ψ2.τ₂ := by change IsIso (𝟙 _); infer_instance
  haveI : Mono ψ2.τ₃ := by change Mono (𝟙 _); infer_instance
  have hE2 : S2.Exact :=
    (ShortComplex.exact_iff_of_epi_of_isIso_of_mono ψ2).mp (ShortComplex.exact_cokernel φ)
  have hS2 : S2.ShortExact :=
    ShortComplex.ShortExact.mk' hE2 (inferInstance : Mono (Abelian.image.ι φ))
      (inferInstance : Epi (Limits.cokernel.π φ))
  have hsurj : Function.Surjective
      (fun x : Abelian.Ext P G N => x.comp (Abelian.Ext.mk₀ φ) (add_zero N)) := by
    intro y
    obtain ⟨z, hz⟩ := Abelian.Ext.covariant_sequence_exact₂ P hS2 y (hQ _)
    obtain ⟨x, hx⟩ := Abelian.Ext.covariant_sequence_exact₃ P hS1 z rfl (hK _)
    refine ⟨x, ?_⟩
    show x.comp (Abelian.Ext.mk₀ φ) (add_zero N) = y
    rw [← hz, ← hx, Abelian.Ext.comp_assoc _ _ _ (add_zero N) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀]
    exact congrArg (fun f => x.comp (Abelian.Ext.mk₀ f) (add_zero N)) hfac.symm
  exact ⟨Finite.of_surjective _ hsurj, Nat.card_le_card_of_surjective _ hsurj⟩

theorem wc_et_extZero_coh_card_le : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y Z : Scheme.{u}) (fY : Y ⟶ Spec (.of K)) [IsProper fY] (iZ : Z ⟶ Y) [IsClosedImmersion iZ] (n : ℕ), topologicalKrullDim Z < (n : WithBot ℕ∞) → ∀ (m : ℕ), (m : K) ≠ 0 → Finite (wcEtCoh Y m (2 * n)) → Finite (wcEtExt Y (wcEtExtZero Y (Set.range iZ)ᶜ m) (2 * n)) ∧ Nat.card (wcEtExt Y (wcEtExtZero Y (Set.range iZ)ᶜ m) (2 * n)) ≤ Nat.card (wcEtCoh Y m (2 * n)) :=
by
  intro K _ _ Y Z fY _ iZ _ n hdim m hm hfin
  classical

  have hmono : Mono (wcEtExtZeroι Y (Set.range iZ)ᶜ m) := by
    let α : wcEtExtZeroPre Y (Set.range iZ)ᶜ m ⟶
        (Functor.const _).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) :=
      { app := fun V => AddCommGrpCat.ofHom
          (wcSuppSub.{u} m (∀ x, V.unop.hom x ∈ (Set.range iZ)ᶜ)).subtype
        naturality := fun _ _ _ => rfl }
    haveI : ∀ V, Mono (α.app V) := fun V =>
      (AddCommGrpCat.mono_iff_injective _).mpr (AddSubgroup.subtype_injective _)
    haveI : Mono α := NatTrans.mono_of_mono_app α
    exact Functor.map_mono (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) α
  let T := ShortComplex.mk (wcEtExtZeroι Y (Set.range iZ)ᶜ m) (Limits.cokernel.π _)
    (Limits.cokernel.condition _)
  have hTs : T.ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) hmono inferInstance
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  let P := (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} ℤ))

  have hinjgen : ∀ q : ℕ, (∀ q' : ℕ, q' + 1 = q → Subsingleton (wcEtCoh Z m q')) →
      Function.Injective ((Abelian.Ext.mk₀ T.f).postcomp P (add_zero q)) := by
    intro q hZq
    rw [injective_iff_map_eq_zero]
    intro x hx
    cases q with
    | zero =>
      obtain ⟨g, rfl⟩ : ∃ g, Abelian.Ext.mk₀ g = x := ⟨_, Abelian.Ext.mk₀_homEquiv₀_apply x⟩
      have hx' : Abelian.Ext.mk₀ (g ≫ T.f) = Abelian.Ext.mk₀ 0 := by
        rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_zero]
        exact hx
      rw [← Abelian.Ext.homEquiv₀_symm_apply, ← Abelian.Ext.homEquiv₀_symm_apply] at hx'
      have hg : g ≫ T.f = 0 := Abelian.Ext.homEquiv₀.symm.injective hx'
      haveI := hTs.mono_f
      rw [Limits.zero_of_comp_mono T.f hg, Abelian.Ext.mk₀_zero]
    | succ n₀ =>
      obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₁ P hTs x hx rfl
      obtain ⟨e⟩ := wc_et_closed_complement_coh Y Z iZ m n₀
      haveI := hZq n₀ rfl
      haveI : Subsingleton (Abelian.Ext P T.X₃ n₀) := e.subsingleton
      rw [← hy, Subsingleton.elim y 0, Abelian.Ext.zero_comp]

  have hvan : ∀ q' : ℕ, q' + 1 = 2 * n → Subsingleton (wcEtCoh Z m q') := by
    intro q' hq'
    obtain _ | k := n
    · omega
    have hdimZ : topologicalKrullDim Z ≤ (k : WithBot ℕ∞) := by
      rcases hd : topologicalKrullDim Z with _ | e
      · exact bot_le
      · rw [hd] at hdim
        have h1 : e < (((k + 1 : ℕ)) : ℕ∞) := WithBot.coe_lt_coe.mp hdim
        have h2 : e ≤ (k : ℕ∞) := by
          rw [Nat.cast_add, Nat.cast_one] at h1
          exact (ENat.lt_add_one_iff (ENat.coe_ne_top k)).mp h1
        exact WithBot.coe_le_coe.mpr h2
    have hMZ : m • 𝟙 ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) = 0 := by
      have h0 : (m : ℤ) • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) = 0 := by
        ext x
        simp
      rw [← natCast_zsmul, ← CategoryTheory.Functor.map_id (constantSheaf
        (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}), ← CategoryTheory.Functor.map_zsmul, h0,
        CategoryTheory.Functor.map_zero]
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) := HasExt.standard _
    have h := wc_et_cd_proper_torsion K Z (iZ ≫ fY) k hdimZ m hm _ hMZ q' (by omega)
    show Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Z)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ((constantSheaf
        (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) q')
    exact ⟨fun a b => (h a).trans (h b).symm⟩

  change Finite (Abelian.Ext P T.X₁ (2 * n)) ∧
    Nat.card (Abelian.Ext P T.X₁ (2 * n)) ≤ Nat.card (Abelian.Ext P T.X₂ (2 * n))
  haveI h2 : Finite (Abelian.Ext P T.X₂ (2 * n)) := hfin
  have hinj := hinjgen (2 * n) hvan
  exact ⟨Finite.of_injective _ hinj, Nat.card_le_card_of_injective _ hinj⟩

theorem wc_dim_succ_le_of_proper_closed_subset : ∀ (X : Type u) [TopologicalSpace X] (Z W : Set X), IsIrreducible Z → IsClosed W → W ⊆ Z → W ≠ Z → ∀ m : ℕ, (m : WithBot ℕ∞) ≤ topologicalKrullDim ↥W → ((m + 1 : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim ↥Z :=
by
  intro X _ Z W hZ hW hWZ hne m hm
  classical
  have hm' : (m : WithBot ℕ∞) ≤ Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥W) := hm
  obtain ⟨p, hp⟩ := Order.le_krullDim_iff.mp hm'
  have hι : Topology.IsClosedEmbedding (Set.inclusion hWZ) :=
    Topology.IsClosedEmbedding.inclusion hWZ hW.preimage_val
  let φ : TopologicalSpace.IrreducibleCloseds ↥W → TopologicalSpace.IrreducibleCloseds ↥Z :=
    fun S => ⟨Set.inclusion hWZ '' (S : Set ↥W),
      S.isIrreducible.image _ hι.continuous.continuousOn, hι.isClosedMap _ S.isClosed⟩
  have hφ : StrictMono φ := by
    intro S T hST
    have h1 : (S : Set ↥W) ⊂ (T : Set ↥W) := SetLike.coe_ssubset_coe.mpr hST
    have h2 := (Set.inclusion_injective hWZ).image_strictMono h1
    exact SetLike.coe_ssubset_coe.mp h2
  haveI : IrreducibleSpace ↥Z := Subtype.irreducibleSpace hZ
  let top : TopologicalSpace.IrreducibleCloseds ↥Z :=
    ⟨Set.univ, IrreducibleSpace.isIrreducible_univ ↥Z, isClosed_univ⟩
  obtain ⟨z, hzZ, hzW⟩ : ∃ z ∈ Z, z ∉ W := by
    by_contra h
    push_neg at h
    exact hne (Set.Subset.antisymm hWZ h)
  have hlast : (p.map φ hφ).last < top := by
    rw [LTSeries.last_map]
    apply SetLike.coe_ssubset_coe.mp
    show Set.inclusion hWZ '' (p.last : Set ↥W) ⊂ Set.univ
    refine ⟨Set.subset_univ _, fun h => ?_⟩
    obtain ⟨w, _, hw⟩ := h (Set.mem_univ (⟨z, hzZ⟩ : ↥Z))
    apply hzW
    have h3 : (w : X) = z := congrArg Subtype.val hw
    exact h3 ▸ w.2
  show ((m + 1 : ℕ) : WithBot ℕ∞) ≤ Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥Z)
  exact Order.le_krullDim_iff.mpr ⟨(p.map φ hφ).snoc top hlast, by simp [hp]⟩

theorem wc_fibre_dim_nonpos_of_no_specialization : ∀ (X B : Type u) [TopologicalSpace X] [TopologicalSpace B] [QuasiSober X] [T0Space B] (g : X → B), Continuous g → ∀ (C : Set X), IsClosed C → ∀ b : B, (∀ x y : X, x ∈ C → y ∈ C → g x = b → g y = b → x ⤳ y → x = y) → topologicalKrullDim ↥(C ∩ g ⁻¹' {b}) ≤ ((0 : ℕ) : WithBot ℕ∞) :=
by
  intro X B _ _ _ _ g hg C hC b hH
  have hs1 : ∀ S : Set X, IsIrreducible S → S ⊆ C → S ⊆ g ⁻¹' {b} → S.Subsingleton := by
    intro S hS hSC hSb
    obtain ⟨ξ, hξ⟩ := QuasiSober.sober hS.closure isClosed_closure
    obtain ⟨s₀, hs₀⟩ := hS.nonempty
    have hξC : ξ ∈ C := closure_minimal hSC hC hξ.mem
    have hgξ : g ξ = b := by
      have h1 : g ξ ⤳ b := by
        have := (hξ.specializes (subset_closure hs₀)).map hg
        rwa [show g s₀ = b from hSb hs₀] at this
      have h2 : b ⤳ g ξ := by
        rw [specializes_iff_mem_closure]
        have hsub : g '' S ⊆ {b} := Set.image_subset_iff.mpr hSb
        exact closure_mono hsub
          (image_closure_subset_closure_image hg (Set.mem_image_of_mem g hξ.mem))
      exact (h1.antisymm h2).eq
    have hall : ∀ s ∈ S, s = ξ := fun s hs =>
      (hH ξ s hξC (hSC hs) hgξ (hSb hs) (hξ.specializes (subset_closure hs))).symm
    intro x hx y hy
    rw [hall x hx, hall y hy]
  rw [Nat.cast_zero, topologicalKrullDim, Order.krullDim_nonpos_iff_forall_isMax]
  intro Z W hZW
  obtain ⟨z, hz⟩ := Z.isIrreducible.nonempty
  have hW : (Subtype.val '' (W : Set ↥(C ∩ g ⁻¹' {b}))).Subsingleton := by
    apply hs1
    · exact W.isIrreducible.image _ continuous_subtype_val.continuousOn
    · rintro _ ⟨y, _, rfl⟩
      exact y.2.1
    · rintro _ ⟨y, _, rfl⟩
      exact y.2.2
  have hzW : z ∈ (W : Set ↥(C ∩ g ⁻¹' {b})) := SetLike.le_def.mp hZW hz
  rw [SetLike.le_def]
  intro w hw
  have hwz : w = z := Subtype.ext (hW ⟨w, hw, rfl⟩ ⟨z, hzW, rfl⟩)
  rw [hwz]
  exact hz

theorem wc_dim_finite_union_closed_lt : ∀ (X : Type u) [TopologicalSpace X] {ι : Type*} (s : Finset ι) (A : ι → Set X) (n : ℕ), (∀ i ∈ s, IsClosed (A i)) → (∀ i ∈ s, topologicalKrullDim ↥(A i) < (n : WithBot ℕ∞)) → topologicalKrullDim ↥(⋃ i ∈ s, A i) < (n : WithBot ℕ∞) :=
by
  intro X _ ι s A n hc hd
  classical
  have wc_union : ∀ (A B : Set X) (n : ℕ),
      IsClosed A → IsClosed B → topologicalKrullDim ↥A ≤ (n : WithBot ℕ∞) →
      topologicalKrullDim ↥B ≤ (n : WithBot ℕ∞) →
      topologicalKrullDim ↥(A ∪ B) ≤ (n : WithBot ℕ∞) := by
    intro A B n hAc hBc hA hB
    have key : ∀ (S T : Set X) (h : S ⊆ T) (Z : TopologicalSpace.IrreducibleCloseds ↥T),
        (∀ z ∈ (Z : Set ↥T), (z : X) ∈ S) →
        Order.krullDim ↑(Set.Iic Z) ≤ topologicalKrullDim ↥S := by
      intro S T h Z hZ
      have hlift : ∀ P : Set ↥T, (∀ p ∈ P, (p : X) ∈ S) →
          Set.inclusion h '' (Set.inclusion h ⁻¹' P) = P := by
        intro P hP
        apply Set.image_preimage_eq_of_subset
        intro p hp
        exact ⟨⟨p.1, hP p hp⟩, rfl⟩
      have hirr : ∀ W : Set ↥T, IsIrreducible W → (∀ w ∈ W, (w : X) ∈ S) →
          IsIrreducible (Set.inclusion h ⁻¹' W) := by
        intro W hW hWS
        refine ⟨?_, ?_⟩
        · obtain ⟨w, hw⟩ := hW.nonempty
          exact ⟨⟨w.1, hWS w hw⟩, hw⟩
        · rw [isPreirreducible_iff_isClosed_union_isClosed]
          intro z₁ z₂ hz₁ hz₂ hsub
          have hind := (Topology.IsEmbedding.inclusion h).isInducing
          obtain ⟨c₁, hc₁, rfl⟩ := hind.isClosed_iff.mp hz₁
          obtain ⟨c₂, hc₂, rfl⟩ := hind.isClosed_iff.mp hz₂
          have hW' : W ⊆ c₁ ∪ c₂ := by
            intro w hw
            have hmem : (⟨w.1, hWS w hw⟩ : ↥S) ∈ Set.inclusion h ⁻¹' W := hw
            exact hsub hmem
          rcases (isPreirreducible_iff_isClosed_union_isClosed.mp hW.isPreirreducible)
              c₁ c₂ hc₁ hc₂ hW' with h1 | h1
          · left; exact Set.preimage_mono h1
          · right; exact Set.preimage_mono h1
      have hsubZ : ∀ W : ↑(Set.Iic Z), (W.1 : Set ↥T) ⊆ (Z : Set ↥T) := fun W =>
        SetLike.coe_subset_coe.mpr W.2
      let Φ : ↑(Set.Iic Z) → TopologicalSpace.IrreducibleCloseds ↥S := fun W =>
        ⟨Set.inclusion h ⁻¹' (W.1 : Set ↥T),
          hirr _ W.1.isIrreducible (fun w hw => hZ w (hsubZ W hw)),
          W.1.isClosed.preimage (continuous_inclusion h)⟩
      have hmono : Monotone Φ := by
        intro W W' hle
        have hle' : (W.1 : Set ↥T) ⊆ (W'.1 : Set ↥T) := SetLike.coe_subset_coe.mpr hle
        exact SetLike.coe_subset_coe.mp (Set.preimage_mono hle' :
          Set.inclusion h ⁻¹' (W.1 : Set ↥T) ⊆ Set.inclusion h ⁻¹' (W'.1 : Set ↥T))
      have hinj : Function.Injective Φ := by
        intro W W' hWW
        have e1 : Set.inclusion h ⁻¹' (W.1 : Set ↥T) = Set.inclusion h ⁻¹' (W'.1 : Set ↥T) :=
          congrArg (fun V : TopologicalSpace.IrreducibleCloseds ↥S => (V : Set ↥S)) hWW
        have e2 : (W.1 : Set ↥T) = (W'.1 : Set ↥T) := by
          calc (W.1 : Set ↥T) = Set.inclusion h '' (Set.inclusion h ⁻¹' (W.1 : Set ↥T)) :=
                (hlift _ (fun w hw => hZ w (hsubZ W hw))).symm
            _ = Set.inclusion h '' (Set.inclusion h ⁻¹' (W'.1 : Set ↥T)) := by rw [e1]
            _ = (W'.1 : Set ↥T) := hlift _ (fun w hw => hZ w (hsubZ W' hw))
        exact Subtype.ext (TopologicalSpace.IrreducibleCloseds.ext e2)
      exact Order.krullDim_le_of_strictMono Φ (hmono.strictMono_of_injective hinj)
    have hU : topologicalKrullDim ↥(A ∪ B) =
        Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥(A ∪ B)) := rfl
    rw [hU, Order.krullDim_eq_iSup_height]
    refine iSup_le (fun Z => ?_)
    rw [Order.height_eq_krullDim_Iic]
    have himg : IsIrreducible (Subtype.val '' (Z : Set ↥(A ∪ B))) :=
      Z.isIrreducible.image _ continuous_subtype_val.continuousOn
    have hcov : Subtype.val '' (Z : Set ↥(A ∪ B)) ⊆ A ∪ B := by
      rintro _ ⟨z, _, rfl⟩
      exact z.2
    rcases (isPreirreducible_iff_isClosed_union_isClosed.mp himg.isPreirreducible)
        A B hAc hBc hcov with hZA | hZB
    · exact (key A (A ∪ B) Set.subset_union_left Z
        (fun z hz => hZA (Set.mem_image_of_mem _ hz))).trans hA
    · exact (key B (A ∪ B) Set.subset_union_right Z
        (fun z hz => hZB (Set.mem_image_of_mem _ hz))).trans hB
  have hE : ∀ S : Set X, S = ∅ → topologicalKrullDim ↥S = ⊥ := by
    intro S hS
    subst hS
    unfold topologicalKrullDim
    rw [Order.krullDim_eq_bot_iff]
    constructor
    intro Z
    obtain ⟨p, _⟩ := Z.isIrreducible.nonempty
    exact p.2
  have hN : ∀ S : Set X, topologicalKrullDim ↥S < ((0 : ℕ) : WithBot ℕ∞) → S = ∅ := by
    intro S hS
    by_contra hne
    obtain ⟨a, ha⟩ := Set.nonempty_iff_ne_empty.mpr hne
    haveI : Nonempty (TopologicalSpace.IrreducibleCloseds ↥S) :=
      ⟨⟨closure {(⟨a, ha⟩ : ↥S)}, isIrreducible_singleton.closure, isClosed_closure⟩⟩
    have h0 : (0 : WithBot ℕ∞) ≤ topologicalKrullDim ↥S := Order.krullDim_nonneg
    rw [Nat.cast_zero] at hS
    exact absurd hS (not_lt.mpr h0)
  have hS : ∀ (m : ℕ) (x : WithBot ℕ∞),
      x < ((m + 1 : ℕ) : WithBot ℕ∞) ↔ x ≤ ((m : ℕ) : WithBot ℕ∞) := by
    intro m x
    induction x using WithBot.recBotCoe with
    | bot => simp
    | coe e =>
      rw [← WithBot.coe_natCast, ← WithBot.coe_natCast, WithBot.coe_lt_coe, WithBot.coe_le_coe,
        Nat.cast_add, Nat.cast_one]
      exact ENat.lt_add_one_iff (by simp)
  rcases n with _ | m
  · have hAe : ∀ i ∈ s, A i = ∅ := fun i hi => hN _ (hd i hi)
    have hU : (⋃ i ∈ s, A i) = ∅ := by
      ext x
      simp only [Set.mem_iUnion, Set.mem_empty_iff_false, iff_false]
      rintro ⟨i, hi, hx⟩
      rw [hAe i hi] at hx
      exact hx
    rw [hE _ hU]
    exact bot_lt_iff_ne_bot.mpr (WithBot.natCast_ne_bot _)
  · rw [hS m]
    have hd' : ∀ i ∈ s, topologicalKrullDim ↥(A i) ≤ ((m : ℕ) : WithBot ℕ∞) :=
      fun i hi => (hS m _).mp (hd i hi)
    clear hd
    revert hc hd'
    induction s using Finset.induction_on with
    | empty =>
      intro _ _
      rw [hE _ (by simp)]
      exact bot_le
    | insert a t hat ih =>
      intro hc hd'
      rw [Finset.set_biUnion_insert]
      apply wc_union (A a) (⋃ x ∈ t, A x) m
      · exact hc a (Finset.mem_insert_self a t)
      · exact isClosed_biUnion_finset (fun i hi => hc i (Finset.mem_insert_of_mem hi))
      · exact hd' a (Finset.mem_insert_self a t)
      · exact ih (fun i hi => hc i (Finset.mem_insert_of_mem hi))
          (fun i hi => hd' i (Finset.mem_insert_of_mem hi))

theorem wc_alg_isolated_prime_spread : ∀ (A R : Type u) [CommRing A] [CommRing R] [Algebra A R] [Algebra.FiniteType A R] (p : Ideal R), p.IsPrime → (∀ P : Ideal R, P.IsPrime → p ≤ P → P.comap (algebraMap A R) = p.comap (algebraMap A R) → P = p) → ∃ a : A, a ∉ p.comap (algebraMap A R) ∧ ∀ P P' : Ideal R, P.IsPrime → P'.IsPrime → p ≤ P → P ≤ P' → P.comap (algebraMap A R) = P'.comap (algebraMap A R) → a ∉ P.comap (algebraMap A R) → P = P' :=
by

  have s1 : ∀ (A R : Type u) [CommRing A] [CommRing R] [IsDomain A] [IsDomain R] [Algebra A R],
      Function.Injective (algebraMap A R) →
      (∀ Q : Ideal R, Q.IsPrime → Q.comap (algebraMap A R) = ⊥ → Q = ⊥) →
      IsField (Localization (Algebra.algebraMapSubmonoid R (nonZeroDivisors A))) := by
    intro A R _ _ _ _ _ hinj hH
    have hSle : Algebra.algebraMapSubmonoid R (nonZeroDivisors A) ≤ nonZeroDivisors R := by
      apply le_nonZeroDivisors_of_noZeroDivisors
      rintro ⟨c, hc, hc0⟩
      have : c = 0 := hinj (by rw [hc0, map_zero])
      exact zero_notMem_nonZeroDivisors (this ▸ hc)
    haveI : IsDomain (Localization (Algebra.algebraMapSubmonoid R (nonZeroDivisors A))) :=
      IsLocalization.isDomain_of_le_nonZeroDivisors
        (Localization (Algebra.algebraMapSubmonoid R (nonZeroDivisors A))) hSle
    obtain ⟨M, hM⟩ :=
      Ideal.exists_maximal (Localization (Algebra.algebraMapSubmonoid R (nonZeroDivisors A)))
    have hQ := (IsLocalization.isPrime_iff_isPrime_disjoint
      (Algebra.algebraMapSubmonoid R (nonZeroDivisors A))
      (Localization (Algebra.algebraMapSubmonoid R (nonZeroDivisors A))) M).mp hM.isPrime
    have hQbot : M.comap (algebraMap R
        (Localization (Algebra.algebraMapSubmonoid R (nonZeroDivisors A)))) = ⊥ := by
      apply hH _ hQ.1
      ext c
      simp only [Ideal.mem_comap, Ideal.mem_bot]
      constructor
      · intro hc
        by_contra hc0
        have hcS : algebraMap A R c ∈ Algebra.algebraMapSubmonoid R (nonZeroDivisors A) :=
          ⟨c, mem_nonZeroDivisors_of_ne_zero hc0, rfl⟩
        exact Set.disjoint_left.mp hQ.2 hcS hc
      · rintro rfl; simp
    have hMbot : M = ⊥ := by
      rw [← IsLocalization.map_under (Algebra.algebraMapSubmonoid R (nonZeroDivisors A))
        (Localization (Algebra.algebraMapSubmonoid R (nonZeroDivisors A))) M]
      show Ideal.map _ (Ideal.comap _ M) = ⊥
      rw [hQbot, Ideal.map_bot]
    rw [Ring.isField_iff_maximal_bot]
    exact hMbot ▸ hM

  have s2 : ∀ (A R : Type u) [CommRing A] [CommRing R] [IsDomain A] [IsDomain R] [Algebra A R]
      [Algebra.FiniteType A R], Function.Injective (algebraMap A R) →
      IsField (Localization (Algebra.algebraMapSubmonoid R (nonZeroDivisors A))) →
      Algebra.IsAlgebraic A R := by
    intro A R _ _ _ _ _ _ hinj hL
    letI : Algebra (FractionRing A)
        (Localization (Algebra.algebraMapSubmonoid R (nonZeroDivisors A))) :=
      localizationAlgebra (nonZeroDivisors A) R
    haveI : IsLocalization (Submonoid.map (algebraMap A R) (nonZeroDivisors A))
        (Localization (Algebra.algebraMapSubmonoid R (nonZeroDivisors A))) :=
      Localization.isLocalization
    have hft : (algebraMap (FractionRing A)
        (Localization (Algebra.algebraMapSubmonoid R (nonZeroDivisors A)))).FiniteType :=
      RingHom.finiteType_localizationPreserves (algebraMap A R) (nonZeroDivisors A) (FractionRing A)
        (Localization (Algebra.algebraMapSubmonoid R (nonZeroDivisors A)))
        (RingHom.finiteType_algebraMap.mpr inferInstance)
    haveI : Algebra.FiniteType (FractionRing A)
        (Localization (Algebra.algebraMapSubmonoid R (nonZeroDivisors A))) :=
      RingHom.finiteType_algebraMap.mp hft
    have hfin : Module.Finite (FractionRing A)
        (Localization (Algebra.algebraMapSubmonoid R (nonZeroDivisors A))) := by
      letI : Field (Localization (Algebra.algebraMapSubmonoid R (nonZeroDivisors A))) :=
        hL.toField
      exact finite_of_finite_type_of_isJacobsonRing (FractionRing A)
        (Localization (Algebra.algebraMapSubmonoid R (nonZeroDivisors A)))
    haveI : IsScalarTower A (FractionRing A)
        (Localization (Algebra.algebraMapSubmonoid R (nonZeroDivisors A))) := by
      apply IsScalarTower.of_algebraMap_eq'
      rw [IsScalarTower.algebraMap_eq A R
        (Localization (Algebra.algebraMapSubmonoid R (nonZeroDivisors A)))]
      exact (IsLocalization.map_comp _).symm
    have hSle : Algebra.algebraMapSubmonoid R (nonZeroDivisors A) ≤ nonZeroDivisors R := by
      apply le_nonZeroDivisors_of_noZeroDivisors
      rintro ⟨c, hc, hc0⟩
      have : c = 0 := hinj (by rw [hc0, map_zero])
      exact zero_notMem_nonZeroDivisors (this ▸ hc)
    have hinjL : Function.Injective (algebraMap R
        (Localization (Algebra.algebraMapSubmonoid R (nonZeroDivisors A)))) :=
      IsLocalization.injective _ hSle
    haveI := Algebra.IsAlgebraic.of_finite (FractionRing A)
      (Localization (Algebra.algebraMapSubmonoid R (nonZeroDivisors A)))
    refine ⟨fun x => ?_⟩
    have h1 : IsAlgebraic (FractionRing A) (algebraMap R
        (Localization (Algebra.algebraMapSubmonoid R (nonZeroDivisors A))) x) :=
      Algebra.IsAlgebraic.isAlgebraic _
    have h2 := (IsFractionRing.isAlgebraic_iff A (FractionRing A) _).mpr h1
    exact (isAlgebraic_algebraMap_iff hinjL).mp h2

  have s3 : ∀ (A R : Type u) [CommRing A] [CommRing R] [IsDomain A] [Algebra A R]
      [Algebra.FiniteType A R] [Algebra.IsAlgebraic A R],
      ∃ a : A, a ≠ 0 ∧ ∀ x : R, ∃ N : ℕ, IsIntegral A (algebraMap A R a ^ N * x) := by
    intro A R _ _ _ _ _ _
    obtain ⟨t, ht⟩ := (Algebra.FiniteType.out : (⊤ : Subalgebra A R).FG)
    obtain ⟨a, ha0, ha⟩ := Algebra.IsAlgebraic.exists_integral_multiples A t
    have he : ∀ k : ℕ, IsIntegral A (algebraMap A R a ^ k) := fun k =>
      (isIntegral_algebraMap (x := a)).pow k
    refine ⟨a, ha0, fun x => ?_⟩
    have hx : x ∈ Algebra.adjoin A (t : Set R) := by rw [ht]; trivial
    induction hx using Algebra.adjoin_induction with
    | mem z hz => exact ⟨1, by rw [pow_one, ← Algebra.smul_def]; exact ha z hz⟩
    | algebraMap c => exact ⟨0, by rw [pow_zero, one_mul]; exact isIntegral_algebraMap⟩
    | add x y _ _ hx hy =>
      obtain ⟨N₁, h₁⟩ := hx
      obtain ⟨N₂, h₂⟩ := hy
      refine ⟨N₁ + N₂, ?_⟩
      have e : algebraMap A R a ^ (N₁ + N₂) * (x + y) =
          algebraMap A R a ^ N₂ * (algebraMap A R a ^ N₁ * x) +
            algebraMap A R a ^ N₁ * (algebraMap A R a ^ N₂ * y) := by ring
      rw [e]
      exact ((he N₂).mul h₁).add ((he N₁).mul h₂)
    | mul x y _ _ hx hy =>
      obtain ⟨N₁, h₁⟩ := hx
      obtain ⟨N₂, h₂⟩ := hy
      refine ⟨N₁ + N₂, ?_⟩
      have e : algebraMap A R a ^ (N₁ + N₂) * (x * y) =
          (algebraMap A R a ^ N₁ * x) * (algebraMap A R a ^ N₂ * y) := by ring
      rw [e]
      exact h₁.mul h₂
  intro A R _ _ _ _ p hp hH

  have s4 : ∀ Q : Ideal (R ⧸ p), Q.IsPrime →
      Q.comap (algebraMap (A ⧸ p.comap (algebraMap A R)) (R ⧸ p)) = ⊥ → Q = ⊥ := by
    intro Q hQ hQb
    have hP : (Q.comap (Ideal.Quotient.mk p)).IsPrime := Ideal.comap_isPrime _ Q
    have hpP : p ≤ Q.comap (Ideal.Quotient.mk p) := fun x hx => by
      rw [Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr hx]
      exact Q.zero_mem
    have hc : (Q.comap (Ideal.Quotient.mk p)).comap (algebraMap A R) =
        p.comap (algebraMap A R) := by
      ext b
      have h : (Ideal.Quotient.mk (p.comap (algebraMap A R)) b ∈
          Q.comap (algebraMap (A ⧸ p.comap (algebraMap A R)) (R ⧸ p))) ↔
            (algebraMap A R b ∈ p) := by
        rw [hQb, Ideal.mem_bot, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_comap]
      exact h
    have hPp := hH _ hP hpP hc
    rw [← Ideal.map_comap_of_surjective _ Ideal.Quotient.mk_surjective Q, hPp,
      Ideal.map_quotient_self]

  have s5 : ∀ a : A, (∀ x : R ⧸ p, ∃ N : ℕ, IsIntegral (A ⧸ p.comap (algebraMap A R))
      (algebraMap (A ⧸ p.comap (algebraMap A R)) (R ⧸ p)
        (Ideal.Quotient.mk (p.comap (algebraMap A R)) a) ^ N * x)) →
      ∀ P P' : Ideal R, P.IsPrime → P'.IsPrime → p ≤ P → P ≤ P' →
        P.comap (algebraMap A R) = P'.comap (algebraMap A R) →
        a ∉ P.comap (algebraMap A R) → P = P' := by
    intro a hint P P' hP hP' hpP hPP' hc ha
    by_contra hne
    obtain ⟨x, hxP', hxP⟩ := SetLike.exists_of_lt (lt_of_le_of_ne hPP' hne)
    have hker : RingHom.ker (Ideal.Quotient.mk p) ≤ P := by rw [Ideal.mk_ker]; exact hpP
    haveI hPb : (P.map (Ideal.Quotient.mk p)).IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker
    have hcP : (P.map (Ideal.Quotient.mk p)).comap (Ideal.Quotient.mk p) = P :=
      Ideal.comap_map_mk hpP
    have hcP' : (P'.map (Ideal.Quotient.mk p)).comap (Ideal.Quotient.mk p) = P' :=
      Ideal.comap_map_mk (hpP.trans hPP')
    have hmemP : ∀ y : R, Ideal.Quotient.mk p y ∈ P.map (Ideal.Quotient.mk p) ↔ y ∈ P :=
      fun y => by rw [← Ideal.mem_comap, hcP]
    have hmemP' : ∀ y : R, Ideal.Quotient.mk p y ∈ P'.map (Ideal.Quotient.mk p) ↔ y ∈ P' :=
      fun y => by rw [← Ideal.mem_comap, hcP']
    obtain ⟨N, hN⟩ := hint (Ideal.Quotient.mk p x)
    have habar : algebraMap (A ⧸ p.comap (algebraMap A R)) (R ⧸ p)
        (Ideal.Quotient.mk (p.comap (algebraMap A R)) a) =
          Ideal.Quotient.mk p (algebraMap A R a) := rfl
    rw [habar] at hN
    have hyJ : Ideal.Quotient.mk p (algebraMap A R a) ^ N * Ideal.Quotient.mk p x ∈
        P'.map (Ideal.Quotient.mk p) :=
      Ideal.mul_mem_left _ _ ((hmemP' x).mpr hxP')
    have hyI : Ideal.Quotient.mk p (algebraMap A R a) ^ N * Ideal.Quotient.mk p x ∉
        P.map (Ideal.Quotient.mk p) := by
      intro hy
      rcases hPb.mem_or_mem hy with h | h
      · exact ha ((hmemP _).mp (hPb.mem_of_pow_mem N h))
      · exact hxP ((hmemP x).mp h)
    have hlt := Ideal.under_lt_under_of_integral_mem_sdiff (R := A ⧸ p.comap (algebraMap A R))
      (Ideal.map_mono hPP') ⟨hyJ, hyI⟩ hN
    have heq : (P.map (Ideal.Quotient.mk p)).under (A ⧸ p.comap (algebraMap A R)) =
        (P'.map (Ideal.Quotient.mk p)).under (A ⧸ p.comap (algebraMap A R)) := by
      ext z
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective z
      show Ideal.Quotient.mk p (algebraMap A R b) ∈ P.map (Ideal.Quotient.mk p) ↔
        Ideal.Quotient.mk p (algebraMap A R b) ∈ P'.map (Ideal.Quotient.mk p)
      rw [hmemP, hmemP']
      exact Ideal.ext_iff.mp hc b
    exact lt_irrefl _ (heq ▸ hlt)

  haveI := hp
  haveI : (p.comap (algebraMap A R)).IsPrime := Ideal.comap_isPrime _ p
  haveI : Algebra.FiniteType A (R ⧸ p) :=
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ A p) (Ideal.Quotient.mkₐ_surjective A p)
  haveI : Algebra.FiniteType (A ⧸ p.comap (algebraMap A R)) (R ⧸ p) :=
    Algebra.FiniteType.of_restrictScalars_finiteType A (A ⧸ p.comap (algebraMap A R)) (R ⧸ p)
  have hinj : Function.Injective (algebraMap (A ⧸ p.comap (algebraMap A R)) (R ⧸ p)) :=
    Ideal.algebraMap_quotient_injective
  have h1 := s1 (A ⧸ p.comap (algebraMap A R)) (R ⧸ p) hinj s4
  haveI := s2 (A ⧸ p.comap (algebraMap A R)) (R ⧸ p) hinj h1
  obtain ⟨a', ha'0, ha'⟩ := s3 (A ⧸ p.comap (algebraMap A R)) (R ⧸ p)
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a'
  exact ⟨a, fun h => ha'0 (Ideal.Quotient.eq_zero_iff_mem.mpr h), s5 a ha'⟩

theorem wc_isolated_generic_point_open_nbhd : ∀ (X B : Scheme.{u}) (g : X ⟶ B) [IsProper g], (∀ (A R : Type u) [CommRing A] [CommRing R] [Algebra A R] [Algebra.FiniteType A R] (p : Ideal R), p.IsPrime → (∀ P : Ideal R, P.IsPrime → p ≤ P → P.comap (algebraMap A R) = p.comap (algebraMap A R) → P = p) → ∃ a : A, a ∉ p.comap (algebraMap A R) ∧ ∀ P P' : Ideal R, P.IsPrime → P'.IsPrime → p ≤ P → P ≤ P' → P.comap (algebraMap A R) = P'.comap (algebraMap A R) → a ∉ P.comap (algebraMap A R) → P = P') → ∀ ξ : X, (∀ x : X, ξ ⤳ x → g x = g ξ → x = ξ) → ∃ O : Set B, IsOpen O ∧ g ξ ∈ O ∧ ∀ x y : X, ξ ⤳ x → x ⤳ y → g x = g y → g x ∈ O → x = y :=
by
  intro X B g _ H ξ hξ
  classical
  obtain ⟨V, hV, hgξV, -⟩ := exists_isAffineOpen_mem_and_subset (x := g ξ) (U := ⊤) trivial
  have hξV : ξ ∈ g ⁻¹ᵁ V := hgξV
  obtain ⟨W, hW, hξW, hWV⟩ := exists_isAffineOpen_mem_and_subset (x := ξ) (U := g ⁻¹ᵁ V) hξV
  have e : W ≤ g ⁻¹ᵁ V := hWV
  let φ : Γ(B, V) ⟶ Γ(X, W) := g.appLE V W e
  have hft : φ.hom.FiniteType :=
    HasRingHomProperty.appLE @LocallyOfFiniteType g inferInstance ⟨V, hV⟩ ⟨W, hW⟩ e
  letI : Algebra Γ(B, V) Γ(X, W) := φ.hom.toAlgebra
  haveI : Algebra.FiniteType Γ(B, V) Γ(X, W) := by
    rw [← RingHom.finiteType_algebraMap]; exact hft
  let ιW := hW.fromSpec
  let ιV := hV.fromSpec
  have hιW : Topology.IsOpenEmbedding ιW := ιW.isOpenEmbedding
  have hιV : Topology.IsOpenEmbedding ιV := ιV.isOpenEmbedding
  have hrW : Set.range ιW = (W : Set X) := hW.range_fromSpec
  have hcompat : ∀ P : ↥(Spec Γ(X, W)), g (ιW P) = ιV (Spec.map φ P) := by
    intro P
    have h := hV.SpecMap_appLE_fromSpec g hW e
    have h2 := congrArg (fun f => f P) h
    simp only at h2
    exact h2.symm
  have hmapI : ∀ P : ↥(Spec Γ(X, W)),
      (Spec.map φ P).asIdeal = P.asIdeal.comap (algebraMap Γ(B, V) Γ(X, W)) := fun P => rfl
  have hmemW : ∀ w : X, w ∈ (W : Set X) → ∃ P, ιW P = w := by
    intro w hw
    rw [← hrW] at hw
    exact hw
  obtain ⟨p₀, hp₀⟩ := hmemW ξ hξW
  subst hp₀
  have hspecW : ∀ P Q : ↥(Spec Γ(X, W)), ιW P ⤳ ιW Q ↔ P.asIdeal ≤ Q.asIdeal := by
    intro P Q
    rw [hιW.isInducing.specializes_iff]
    exact (PrimeSpectrum.le_iff_specializes (R := Γ(X, W)) P Q).symm
  have hcomapEq : ∀ P Q : ↥(Spec Γ(X, W)), g (ιW P) = g (ιW Q) →
      P.asIdeal.comap (algebraMap Γ(B, V) Γ(X, W)) = Q.asIdeal.comap (algebraMap Γ(B, V) Γ(X, W)) := by
    intro P Q h
    rw [hcompat, hcompat] at h
    rw [← hmapI, ← hmapI, hιV.injective h]
  have hiso : ∀ P : Ideal Γ(X, W), P.IsPrime → p₀.asIdeal ≤ P →
      P.comap (algebraMap Γ(B, V) Γ(X, W)) = p₀.asIdeal.comap (algebraMap Γ(B, V) Γ(X, W)) →
      P = p₀.asIdeal := by
    intro P hP hle hc
    let Pt : ↥(Spec Γ(X, W)) := ⟨P, hP⟩
    have hPt : Pt.asIdeal = P := rfl
    have hx1 : ιW p₀ ⤳ ιW Pt := (hspecW p₀ Pt).2 hle
    have hx2 : g (ιW Pt) = g (ιW p₀) := by
      rw [hcompat Pt, hcompat p₀]
      congr 1
      apply PrimeSpectrum.ext
      rw [hmapI, hmapI, hPt]
      exact hc
    have h3 := hξ _ hx1 hx2
    exact congrArg PrimeSpectrum.asIdeal (hιW.injective h3)
  obtain ⟨a, ha, hchain⟩ := H Γ(B, V) Γ(X, W) p₀.asIdeal p₀.isPrime hiso
  let S : Set ↥(Spec Γ(B, V)) := {q | a ∉ q.asIdeal}
  have hS : IsOpen S := (PrimeSpectrum.basicOpen a).isOpen
  let O₁ : Set B := ιV '' S
  have hO₁ : IsOpen O₁ := hιV.isOpenMap _ hS
  let Z : Set X := closure {ιW p₀} ∩ (W : Set X)ᶜ
  have hZ : IsClosed Z := isClosed_closure.inter W.isOpen.isClosed_compl
  have hgZ : IsClosed (g '' Z) := g.isClosedMap Z hZ
  refine ⟨O₁ ∩ (g '' Z)ᶜ, hO₁.inter hgZ.isOpen_compl, ⟨?_, ?_⟩, ?_⟩
  · rw [hcompat p₀]
    refine ⟨Spec.map φ p₀, ?_, rfl⟩
    show a ∉ (Spec.map φ p₀).asIdeal
    rw [hmapI]
    exact ha
  · rintro ⟨z, ⟨hz1, hz2⟩, hgz⟩
    have h1 : z = ιW p₀ := hξ z (specializes_iff_mem_closure.2 hz1) hgz
    exact hz2 (h1 ▸ hξW)
  · have key : ∀ w, ιW p₀ ⤳ w → g w ∉ g '' Z → w ∈ (W : Set X) := by
      intro w hw hgw
      by_contra hn
      exact hgw ⟨w, ⟨specializes_iff_mem_closure.1 hw, hn⟩, rfl⟩
    rintro x y hx hxy hgxy ⟨hxO₁, hxZ⟩
    have hxW := key x hx hxZ
    have hyW := key y (hx.trans hxy) (hgxy ▸ hxZ)
    obtain ⟨Px, rfl⟩ := hmemW x hxW
    obtain ⟨Py, rfl⟩ := hmemW y hyW
    have hx' := (hspecW p₀ Px).1 hx
    have hxy' := (hspecW Px Py).1 hxy
    obtain ⟨q, hq, hqx⟩ := hxO₁
    rw [hcompat Px] at hqx
    have hqeq : q = Spec.map φ Px := hιV.injective hqx
    have hq' : a ∉ q.asIdeal := hq
    have haPx : a ∉ Px.asIdeal.comap (algebraMap Γ(B, V) Γ(X, W)) := by
      rw [← hmapI, ← hqeq]
      exact hq'
    have h4 := hchain Px.asIdeal Py.asIdeal Px.isPrime Py.isPrime hx' hxy'
      (hcomapEq Px Py hgxy) haPx
    have h5 : Px = Py := PrimeSpectrum.ext h4
    rw [h5]

theorem wc_fibre_dim_jump_locus_small : ∀ (K : Type u) [Field K] [IsAlgClosed K] (X B : Scheme.{u}) (fB : B ⟶ Spec (.of K)) [IsProper fB] (g : X ⟶ B) [IsProper g] (C : Set X), IsClosed C → ∀ n : ℕ, topologicalKrullDim ↥C ≤ (n : WithBot ℕ∞) → ∃ T : Set B, IsClosed T ∧ topologicalKrullDim ↥T < (n : WithBot ℕ∞) ∧ ∀ b : B, b ∉ T → topologicalKrullDim ↥(C ∩ ⇑g ⁻¹' {b}) ≤ ((0 : ℕ) : WithBot ℕ∞) :=
by
  intro K _ _ X B fB _ g _ C hC n hCn
  classical

  haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian (g ≫ fB)
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace (g ≫ fB)
  haveI : AlgebraicGeometry.IsNoetherian X := AlgebraicGeometry.IsNoetherian.mk

  obtain ⟨S, hSfin, hSc, hSirr, hCS⟩ :=
    TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible hC
  have hgc : IsClosedMap ⇑g := g.isClosedMap
  have hcast : ¬ (((n + 1 : ℕ) : WithBot ℕ∞) ≤ (n : WithBot ℕ∞)) := by
    intro h
    have : n + 1 ≤ n := by exact_mod_cast h
    omega
  have himdim : ∀ s : Set X, IsClosed s →
      topologicalKrullDim ↥(⇑g '' s) ≤ topologicalKrullDim ↥s := by
    intro s hs
    have h := wc_dim_range_closed_map_le (↥s) (↥B) (fun x : s => g x.1)
      (g.continuous.comp continuous_subtype_val) (hgc.comp hs.isClosedMap_subtype_val)
    have hr : Set.range (fun x : s => g x.1) = ⇑g '' s := by
      ext y
      constructor
      · rintro ⟨⟨x, hx⟩, rfl⟩
        exact ⟨x, hx, rfl⟩
      · rintro ⟨x, hx, rfl⟩
        exact ⟨⟨x, hx⟩, rfl⟩
    rw [hr] at h
    exact h

  have hcomp : ∀ t ∈ S, ∃ Tt : Set B, IsClosed Tt ∧ topologicalKrullDim ↥Tt < (n : WithBot ℕ∞) ∧
      ∀ x y : X, x ∈ t → y ∈ t → x ⤳ y → g x = g y → g x ∉ Tt → x = y := by
    intro t ht
    have htc := hSc t ht
    have hti := hSirr t ht
    obtain ⟨ξ, hξ⟩ := QuasiSober.sober hti htc
    have hξt : closure ({ξ} : Set X) = t := isGenericPoint_def.1 hξ
    have hspec : ∀ x, ξ ⤳ x ↔ x ∈ t := fun x => by rw [specializes_iff_mem_closure, hξt]
    have hξmem : ξ ∈ t := (hspec ξ).1 specializes_rfl
    have htC : t ⊆ C := by rw [hCS]; exact Set.subset_sUnion_of_mem ht
    have hdimt : topologicalKrullDim ↥t ≤ (n : WithBot ℕ∞) :=
      ((Topology.IsEmbedding.inclusion htC).isInducing.topologicalKrullDim_le).trans hCn
    have hgt_c : IsClosed (⇑g '' t) := hgc t htc
    have hgt_i : IsIrreducible (⇑g '' t) := hti.image g g.continuous.continuousOn
    have hgt_d : topologicalKrullDim ↥(⇑g '' t) ≤ (n : WithBot ℕ∞) := (himdim t htc).trans hdimt
    by_cases hA : ∃ x ∈ t, x ≠ ξ ∧ g x = g ξ
    ·
      obtain ⟨x, hxt, hxξ, hgx⟩ := hA
      refine ⟨⇑g '' t, hgt_c, ?_, ?_⟩
      · have hcx : IsClosed (closure ({x} : Set X)) := isClosed_closure
        have hsub : closure ({x} : Set X) ⊆ t :=
          closure_minimal (Set.singleton_subset_iff.2 hxt) htc
        have heq : ⇑g '' t = ⇑g '' closure ({x} : Set X) := by
          apply Set.Subset.antisymm
          · rintro _ ⟨y, hy, rfl⟩
            have h1 : ξ ⤳ y := (hspec y).2 hy
            have h2 : g ξ ⤳ g y := h1.map g.continuous
            rw [← hgx] at h2
            have h3 : g y ∈ closure ({g x} : Set B) := specializes_iff_mem_closure.1 h2
            exact closure_minimal (Set.singleton_subset_iff.2
              (Set.mem_image_of_mem (⇑g) (subset_closure (Set.mem_singleton x))))
              (hgc _ hcx) h3
          · exact Set.image_mono hsub
        have hne : closure ({x} : Set X) ≠ t := by
          intro h
          have h1 : x ⤳ ξ := specializes_iff_mem_closure.2 (by rw [h]; exact hξmem)
          have h2 : ξ ⤳ x := (hspec x).2 hxt
          exact hxξ (h1.antisymm h2).eq
        rw [lt_iff_not_ge]
        intro hle
        rw [heq] at hle
        have h := wc_dim_succ_le_of_proper_closed_subset (↥X) t (closure ({x} : Set X)) hti hcx
          hsub hne n (hle.trans (himdim _ hcx))
        exact hcast (h.trans hdimt)
      · intro x' y' hx' _ _ _ hn
        exact absurd ⟨x', hx', rfl⟩ hn
    ·
      push_neg at hA
      have hB' : ∀ x : X, ξ ⤳ x → g x = g ξ → x = ξ := by
        intro x hx hgx
        by_contra hne
        exact hA x ((hspec x).1 hx) hne hgx
      obtain ⟨O, hOo, hξO, hO⟩ :=
        wc_isolated_generic_point_open_nbhd X B g wc_alg_isolated_prime_spread ξ hB'
      have hTc : IsClosed (⇑g '' t ∩ Oᶜ) := hgt_c.inter hOo.isClosed_compl
      refine ⟨⇑g '' t ∩ Oᶜ, hTc, ?_, ?_⟩
      · rw [lt_iff_not_ge]
        intro hle
        have hne : ⇑g '' t ∩ Oᶜ ≠ ⇑g '' t := by
          intro h
          have hm : g ξ ∈ ⇑g '' t ∩ Oᶜ := by rw [h]; exact ⟨ξ, hξmem, rfl⟩
          exact hm.2 hξO
        have h := wc_dim_succ_le_of_proper_closed_subset (↥B) (⇑g '' t) (⇑g '' t ∩ Oᶜ) hgt_i hTc
          Set.inter_subset_left hne n hle
        exact hcast (h.trans hgt_d)
      · intro x y hx _ hxy hgxy hn
        have hO' : g x ∈ O := by
          by_contra h
          exact hn ⟨⟨x, hx, rfl⟩, h⟩
        exact hO x y ((hspec x).2 hx) hxy hgxy hO'

  choose! Tt hTtc hTtd hTt using hcomp
  refine ⟨⋃ t ∈ hSfin.toFinset, Tt t, ?_, ?_, ?_⟩
  · exact isClosed_biUnion_finset (fun t ht => hTtc t (hSfin.mem_toFinset.1 ht))
  · exact wc_dim_finite_union_closed_lt (↥B) hSfin.toFinset Tt n
      (fun t ht => hTtc t (hSfin.mem_toFinset.1 ht)) (fun t ht => hTtd t (hSfin.mem_toFinset.1 ht))
  ·
    intro b hb
    apply wc_fibre_dim_nonpos_of_no_specialization (↥X) (↥B) (⇑g) g.continuous C hC b
    intro x y hx hy hgx hgy hxy
    rw [hCS, Set.mem_sUnion] at hx
    obtain ⟨t, ht, hxt⟩ := hx
    have hyt : y ∈ t := hxy.mem_closed (hSc t ht) hxt
    apply hTt t ht x y hxt hyt hxy (hgx.trans hgy.symm)
    rw [hgx]
    intro hbT
    exact hb (Set.mem_iUnion₂.2 ⟨t, hSfin.mem_toFinset.2 ht, hbT⟩)

theorem wc_r2gc_stalk_zero_of_fibre_dim_zero : ∀ (X B : Scheme.{u}) (g : X ⟶ B) [IsProper g] (ℓ : ℕ), ℓ.Prime → ∀ (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) (b : B), topologicalKrullDim ↥(⇑g ⁻¹' {b}) ≤ ((0 : ℕ) : WithBot ℕ∞) → Subsingleton ((wcEtStalk B b).obj ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 2)) :=
by
  intro X B g _ ℓ hℓ I b hb

  obtain ⟨e⟩ := wc_et_proper_stalk_coh g ℓ hℓ.ne_zero wc_et_henselian_proper_vanishing I b 2

  have L3 : ∀ (T : Type u) [TopologicalSpace T] [QuasiSober T] [T0Space T],
      topologicalKrullDim T ≤ ((0 : ℕ) : WithBot ℕ∞) ↔ ∀ x y : T, x ⤳ y → x = y := by
    intro T _ _ _
    rw [Nat.cast_zero]
    unfold topologicalKrullDim
    rw [Order.krullDim_nonpos_iff_forall_isMax]
    constructor
    · intro h x y hxy
      let Cx : TopologicalSpace.IrreducibleCloseds T :=
        ⟨closure {x}, isIrreducible_singleton.closure, isClosed_closure⟩
      let Cy : TopologicalSpace.IrreducibleCloseds T :=
        ⟨closure {y}, isIrreducible_singleton.closure, isClosed_closure⟩
      have h1 : Cy ≤ Cx := by
        show closure {y} ⊆ closure {x}
        exact specializes_iff_closure_subset.mp hxy
      have h2 : Cx ≤ Cy := h Cy h1
      have h3 : y ⤳ x := specializes_iff_closure_subset.mpr h2
      exact (hxy.antisymm h3).eq
    · intro h Z Z' hZZ'
      obtain ⟨z, hz⟩ := QuasiSober.sober Z.isIrreducible Z.isClosed
      obtain ⟨z', hz'⟩ := QuasiSober.sober Z'.isIrreducible Z'.isClosed
      have hzZ' : z ∈ (Z' : Set T) := hZZ' hz.mem
      have hsp : z' ⤳ z := hz'.specializes hzZ'
      have heq := h z' z hsp
      show (Z' : Set T) ⊆ Z
      rw [← hz'.def, ← hz.def, heq]

  have L4 : ∀ {P Y : Scheme.{u}} (p : P ⟶ Y) [IsIntegralHom p] (x y : P),
      x ⤳ y → p x = p y → x = y := by
    intro P Y p _ x y hxy hpxy
    obtain ⟨V, hV, hyV, -⟩ := exists_isAffineOpen_mem_and_subset (x := p y) (U := ⊤) trivial
    have hU : IsAffineOpen (p ⁻¹ᵁ V) := hV.preimage p
    have hyU : y ∈ p ⁻¹ᵁ V := hyV
    have hxU : x ∈ p ⁻¹ᵁ V := hxy.mem_open (p ⁻¹ᵁ V).isOpen hyU
    haveI := hU.isOpenImmersion_fromSpec
    haveI := hV.isOpenImmersion_fromSpec
    obtain ⟨a, rfl⟩ : ∃ a, hU.fromSpec a = x := by
      rw [← Set.mem_range, hU.range_fromSpec]; exact hxU
    obtain ⟨c, rfl⟩ : ∃ c, hU.fromSpec c = y := by
      rw [← Set.mem_range, hU.range_fromSpec]; exact hyU
    have hac : a.asIdeal ≤ c.asIdeal := by
      have h1 : a ⤳ c := (hU.fromSpec.isOpenEmbedding.isInducing).specializes_iff.mp hxy
      exact (PrimeSpectrum.le_iff_specializes (R := Γ(P, p ⁻¹ᵁ V)) a c).mpr h1
    have hsq := hV.SpecMap_appLE_fromSpec p hU (le_refl _)
    rw [Scheme.Hom.appLE_eq_app] at hsq
    have hcomp : ∀ z, hV.fromSpec (Spec.map (p.app V) z) = p (hU.fromSpec z) := by
      intro z
      rw [← Scheme.Hom.comp_apply, hsq, Scheme.Hom.comp_apply]
    have hcomap : Spec.map (p.app V) a = Spec.map (p.app V) c :=
      hV.fromSpec.isOpenEmbedding.injective (by rw [hcomp, hcomp, hpxy])
    letI := (p.app V).hom.toAlgebra
    haveI : Algebra.IsIntegral Γ(Y, V) Γ(P, p ⁻¹ᵁ V) :=
      algebraMap_isIntegral_iff.mp (IsIntegralHom.isIntegral_app p V hV)
    have hund : Ideal.under Γ(Y, V) a.asIdeal = Ideal.under Γ(Y, V) c.asIdeal := by
      have h := congrArg PrimeSpectrum.asIdeal hcomap
      simp only [Spec.map_base] at h
      exact h
    haveI : a.asIdeal.IsPrime := a.isPrime
    by_contra hne
    have hlt : a.asIdeal < c.asIdeal :=
      lt_of_le_of_ne hac (fun h => hne (congrArg hU.fromSpec (PrimeSpectrum.ext h)))
    exact (Ideal.IsIntegral.under_lt_under hlt).ne hund

  have hs : IsIntegralHom (Spec.map (CommRingCat.ofHom (algebraMap (B.residueField b)
      (AlgebraicClosure (B.residueField b))))) :=
    IsIntegralHom.SpecMap_iff.mpr (fun x => Algebra.IsIntegral.isIntegral (R := B.residueField b) x)
  haveI hp : IsIntegralHom (Limits.pullback.fst (Limits.pullback.snd g (B.fromSpecResidueField b))
      (Spec.map (CommRingCat.ofHom (algebraMap (B.residueField b)
        (AlgebraicClosure (B.residueField b)))))) :=
    MorphismProperty.of_isPullback (P := @IsIntegralHom)
      (IsPullback.of_hasPullback (Limits.pullback.snd g (B.fromSpecResidueField b))
        (Spec.map (CommRingCat.ofHom (algebraMap (B.residueField b)
          (AlgebraicClosure (B.residueField b)))))).flip hs

  have hfib : topologicalKrullDim ↥(Limits.pullback g (B.fromSpecResidueField b)) ≤
      ((0 : ℕ) : WithBot ℕ∞) :=
    (IsHomeomorph.topologicalKrullDim_eq _ (Scheme.Hom.fiberHomeo g b).isHomeomorph).trans_le hb

  have hP : topologicalKrullDim ↥(Limits.pullback (Limits.pullback.snd g (B.fromSpecResidueField b))
      (Spec.map (CommRingCat.ofHom (algebraMap (B.residueField b)
        (AlgebraicClosure (B.residueField b)))))) ≤ ((0 : ℕ) : WithBot ℕ∞) := by
    apply (L3 _).mpr
    intro x y hxy
    apply L4 (Limits.pullback.fst (Limits.pullback.snd g (B.fromSpecResidueField b))
      (Spec.map (CommRingCat.ofHom (algebraMap (B.residueField b)
        (AlgebraicClosure (B.residueField b)))))) x y hxy
    exact (L3 _).mp hfib _ _ (hxy.map (Scheme.Hom.continuous _))

  have hW : topologicalKrullDim ↥(Limits.pullback g (wcEtGeomPt B b)) ≤ ((0 : ℕ) : WithBot ℕ∞) :=
    (IsHomeomorph.topologicalKrullDim_eq _ (Scheme.homeoOfIso
      (Limits.pullbackLeftPullbackSndIso g (B.fromSpecResidueField b)
        (Spec.map (CommRingCat.ofHom (algebraMap (B.residueField b)
          (AlgebraicClosure (B.residueField b))))))).isHomeomorph).symm.trans_le hP

  haveI := wc_et_zero_dim_vanishing (AlgebraicClosure (B.residueField b))
    (Limits.pullback g (wcEtGeomPt B b)) (Limits.pullback.snd g (wcEtGeomPt B b)) hW ℓ
    hℓ.ne_zero 2 (by norm_num)
  exact e.subsingleton

theorem wc_r2gc_stalk_coker_subsingleton : ∀ {B : Scheme.{u}} (G F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (φ : G ⟶ F) (b : B), Function.Surjective ((wcEtStalk B b).map φ).hom → Subsingleton ((wcEtStalk B b).obj (Limits.cokernel φ)) :=
by
  intro B G F φ b hsurj
  classical
  have hlift : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] {V U : Scheme.{u}} (g : V ⟶ U) [Etale g]
      (s : Spec (.of Ω) ⟶ U) (v : V), g v = s (IsLocalRing.closedPoint Ω) →
      ∃ t : Spec (.of Ω) ⟶ V, t ≫ g = s := by
    intro Ω _ _ V U g _ s v hv
    have hs : s = Spec.map (Scheme.SpecToEquivOfField Ω U s).2 ≫
        U.fromSpecResidueField (Scheme.SpecToEquivOfField Ω U s).1 := by
      rw [← Scheme.SpecToEquivOfField_symm_apply, Equiv.symm_apply_apply]
    have h1 : (Scheme.SpecToEquivOfField Ω U s).1 = s (IsLocalRing.closedPoint Ω) := rfl
    generalize Scheme.SpecToEquivOfField Ω U s = p at hs h1
    obtain ⟨u', ψ⟩ := p
    simp only at hs h1
    rw [← h1] at hv
    subst hv
    letI : Algebra (U.residueField (g v)) (V.residueField v) := (g.residueFieldMap v).hom.toAlgebra
    haveI : Algebra.IsSeparable (U.residueField (g v)) (V.residueField v) := inferInstance
    haveI : Algebra.IsAlgebraic (U.residueField (g v)) (V.residueField v) :=
      Algebra.IsSeparable.isAlgebraic _ _
    letI : Algebra (U.residueField (g v)) Ω := ψ.hom.toAlgebra
    let χ₀ : V.residueField v →ₐ[U.residueField (g v)] Ω :=
      IsAlgClosed.lift (R := U.residueField (g v)) (S := V.residueField v) (M := Ω)
    let χ : V.residueField v ⟶ CommRingCat.of Ω := CommRingCat.ofHom χ₀.toRingHom
    have hχ : g.residueFieldMap v ≫ χ = ψ := by
      ext r
      exact χ₀.commutes r
    refine ⟨Spec.map χ ≫ V.fromSpecResidueField v, ?_⟩
    rw [Category.assoc, ← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField,
      ← Category.assoc, ← Spec.map_comp, hχ, hs]
  have hcov : ∀ (V : B.Etale) (R : Sieve V), R ∈ Scheme.smallEtaleTopology B V →
      ∀ x : V.left, ∃ (V₁ : B.Etale) (c : V₁ ⟶ V) (y : V₁.left), R.arrows c ∧ c.left y = x := by
    intro V R hR x
    change R ∈ Scheme.smallGrothendieckTopology @Etale B V at hR
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
    obtain ⟨V₁, c, y, hc, -, hy⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hR x
    exact ⟨V₁, c, y, hc, hy⟩
  let X₀ : Over B := Over.mk (wcEtGeomPt B b)
  haveI : IsCofiltered (StructuredArrow X₀ (Scheme.Etale.forget B)) :=
    IsCofiltered.of_hasFiniteLimits _
  haveI : Limits.PreservesFilteredColimitsOfSize.{u, u+1} (forget AddCommGrpCat.{u+1}) :=
    Limits.preservesFilteredColimitsOfSize_shrink.{u+1, u+1, u, u+1} (forget AddCommGrpCat.{u+1})
  haveI hls : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology B)
      (Limits.cokernel.π φ).hom :=
    (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} (Limits.cokernel.π φ)).mpr
      inferInstance

  have hp : Function.Surjective ((wcEtStalk B b).map (Limits.cokernel.π φ)).hom := by
    intro z
    let D := (StructuredArrow.proj X₀ (Scheme.Etale.forget B)).op ⋙ (Limits.cokernel φ).obj
    let DF := (StructuredArrow.proj X₀ (Scheme.Etale.forget B)).op ⋙ F.obj
    obtain ⟨j, t, ht⟩ := Limits.Concrete.colimit_exists_rep D z
    have hR : Presheaf.imageSieve (Limits.cokernel.π φ).hom t ∈
        Scheme.smallEtaleTopology B j.unop.right :=
      Presheaf.imageSieve_mem (Scheme.smallEtaleTopology B) (Limits.cokernel.π φ).hom
        (U := Opposite.op j.unop.right) t
    obtain ⟨V₁, c, y, hc, hy⟩ := hcov j.unop.right _ hR
      (j.unop.hom.left (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b))))
    obtain ⟨f, hf⟩ := hc
    have hw : c.left ≫ j.unop.right.hom = V₁.hom := MorphismProperty.Over.w c
    haveI : Etale c.left := by
      have h1 : Etale j.unop.right.hom := j.unop.right.prop
      have h2 : Etale (c.left ≫ j.unop.right.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left j.unop.right.hom
    obtain ⟨a', ha'⟩ := hlift (AlgebraicClosure (B.residueField b))
      c.left j.unop.hom.left y hy
    have hA : j.unop.hom.left ≫ j.unop.right.hom = wcEtGeomPt B b := Over.w j.unop.hom
    have h : a' ≫ V₁.hom = wcEtGeomPt B b := by
      rw [← hw, ← Category.assoc, ha']
      exact hA
    let A' : StructuredArrow X₀ (Scheme.Etale.forget B) :=
      StructuredArrow.mk (Y := V₁) (Over.homMk (U := X₀) (V := (Scheme.Etale.forget B).obj V₁) a' h)
    let α : A' ⟶ j.unop := StructuredArrow.homMk c (Over.OverMorphism.ext ha')
    refine ⟨(Limits.colimit.ι DF (Opposite.op A')).hom f, ?_⟩
    have e1 := Limits.colimit.ι_map_apply
      (Functor.whiskerLeft (StructuredArrow.proj X₀ (Scheme.Etale.forget B)).op
        (Limits.cokernel.π φ).hom) (Opposite.op A') f
    have e2 := Limits.colimit.w_apply D α.op t
    calc ((wcEtStalk B b).map (Limits.cokernel.π φ)).hom ((Limits.colimit.ι DF (Opposite.op A')).hom f)
        = (Limits.colimit.ι D (Opposite.op A')).hom
            (((Limits.cokernel.π φ).hom.app (Opposite.op V₁)).hom f) := e1
      _ = (Limits.colimit.ι D (Opposite.op A')).hom
            (((Limits.cokernel φ).obj.map c.op).hom t) :=
          congrArg (fun w => (Limits.colimit.ι D (Opposite.op A')).hom w) hf
      _ = (Limits.colimit.ι D (Opposite.op A')).hom ((D.map α.op).hom t) := rfl
      _ = (Limits.colimit.ι D j).hom t := e2
      _ = z := ht

  have hzero : ∀ g, ((wcEtStalk B b).map (Limits.cokernel.π φ)).hom
      (((wcEtStalk B b).map φ).hom g) = 0 := by
    intro g
    have h0 : (wcEtStalk B b).map φ ≫ (wcEtStalk B b).map (Limits.cokernel.π φ) = 0 := by
      rw [← Functor.map_comp, Limits.cokernel.condition, Functor.map_zero]
    have := congrArg (fun h => h.hom g) h0
    simpa using this

  have key : ∀ z, z = (0 : (wcEtStalk B b).obj (Limits.cokernel φ)) := by
    intro z
    obtain ⟨y, rfl⟩ := hp z
    obtain ⟨g, rfl⟩ := hsurj y
    exact hzero g
  exact ⟨fun z₁ z₂ => (key z₁).trans (key z₂).symm⟩

theorem wc_r2gc_graph_basic : ∀ {B B'' : Scheme.{u}} (π : B'' ⟶ B) [IsFinite π] (V : B.Etale) (e : V.left ⟶ B''), IsOpenImmersion e → ∀ (heπ : e ≫ π = V.hom) (T T' : B.Etale) (g : T ⟶ V) (k : T' ⟶ T), IsOpenImmersion (wcR2Graph π V e heπ g) ∧ IsClosed (Set.range (wcR2Graph π V e heπ g)) ∧ (∀ x : T.left, ((wcEtBaseChange π).obj T).hom (wcR2Graph π V e heπ g x) ∈ Set.range e) ∧ ((wcEtBaseChange π).map k).left ⁻¹' Set.range (wcR2Graph π V e heπ g) = Set.range (wcR2Graph π V e heπ (k ≫ g)) :=
by


  have s1 : ∀ {S X Y B'' : Scheme.{u}} (t : X ⟶ S) (v : Y ⟶ S) [Etale v] (π : B'' ⟶ S)
      (e : Y ⟶ B'') [IsOpenImmersion e], e ≫ π = v → ∀ (a : X ⟶ Y), a ≫ v = t →
      ∀ (Γ : X ⟶ Limits.pullback t π), Γ ≫ Limits.pullback.fst t π = 𝟙 X →
        Γ ≫ Limits.pullback.snd t π = a ≫ e → IsOpenImmersion Γ := by
    intro S X Y B'' t v _ π e _ heπ a ha Γ hΓ1 hΓ2
    subst ha
    have hd : IsOpenImmersion (Limits.pullback.diagonal v) :=
      FormallyUnramified.isOpenImmersion_diagonal v
    have hσ : IsOpenImmersion (Limits.pullback.lift (𝟙 X) a (by simp) :
        X ⟶ Limits.pullback (a ≫ v) v) :=
      MorphismProperty.of_isPullback (P := @IsOpenImmersion)
        (Limits.pullback_lift_diagonal_isPullback a v) hd
    obtain ⟨m, hm1, hm2⟩ : ∃ m : Limits.pullback (a ≫ v) v ⟶ Limits.pullback (a ≫ v) π,
        m ≫ Limits.pullback.fst (a ≫ v) π = Limits.pullback.fst (a ≫ v) v ∧
        m ≫ Limits.pullback.snd (a ≫ v) π = Limits.pullback.snd (a ≫ v) v ≫ e :=
      ⟨Limits.pullback.lift (Limits.pullback.fst (a ≫ v) v) (Limits.pullback.snd (a ≫ v) v ≫ e)
        (by rw [Limits.pullback.condition, Category.assoc, heπ]),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have hsq : IsPullback m (Limits.pullback.snd (a ≫ v) v) (Limits.pullback.snd (a ≫ v) π) e := by
      refine IsPullback.of_right (h₁₂ := Limits.pullback.fst (a ≫ v) π) (v₁₃ := a ≫ v)
        (h₂₂ := π) ?_ hm2 (IsPullback.of_hasPullback (a ≫ v) π)
      rw [hm1, heπ]
      exact IsPullback.of_hasPullback (a ≫ v) v
    have hm : IsOpenImmersion m :=
      MorphismProperty.of_isPullback (P := @IsOpenImmersion) hsq.flip ‹IsOpenImmersion e›
    have heq : Γ = (Limits.pullback.lift (𝟙 X) a (by simp) :
        X ⟶ Limits.pullback (a ≫ v) v) ≫ m := by
      apply Limits.pullback.hom_ext
      · rw [hΓ1, Category.assoc, hm1, Limits.pullback.lift_fst]
      · rw [hΓ2, Category.assoc, hm2, ← Category.assoc, Limits.pullback.lift_snd]
    rw [heq]
    exact IsOpenImmersion.comp _ _

  have s2 : ∀ {S X B'' : Scheme.{u}} (t : X ⟶ S) (π : B'' ⟶ S) [IsFinite π]
      (Γ : X ⟶ Limits.pullback t π), Γ ≫ Limits.pullback.fst t π = 𝟙 X →
        IsClosed (Set.range Γ) := by
    intro S X B'' t π _ Γ hΓ
    have : IsClosedImmersion (Γ ≫ Limits.pullback.fst t π) := by rw [hΓ]; infer_instance
    have : IsClosedImmersion Γ := IsClosedImmersion.of_comp Γ (Limits.pullback.fst t π)
    exact Γ.isClosedEmbedding.isClosed_range

  have s3 : ∀ {S X X' B'' : Scheme.{u}} (t : X ⟶ S) (t' : X' ⟶ S) (π : B'' ⟶ S)
      (κ : X' ⟶ X), κ ≫ t = t' → ∀ (b : X ⟶ B'') (Γ : X ⟶ Limits.pullback t π)
      (Γ' : X' ⟶ Limits.pullback t' π) (M : Limits.pullback t' π ⟶ Limits.pullback t π),
      Γ ≫ Limits.pullback.fst t π = 𝟙 X → Γ ≫ Limits.pullback.snd t π = b →
      Γ' ≫ Limits.pullback.fst t' π = 𝟙 X' → Γ' ≫ Limits.pullback.snd t' π = κ ≫ b →
      M ≫ Limits.pullback.fst t π = Limits.pullback.fst t' π ≫ κ →
      M ≫ Limits.pullback.snd t π = Limits.pullback.snd t' π →
      M ⁻¹' Set.range Γ = Set.range Γ' := by
    intro S X X' B'' t t' π κ hκ b Γ Γ' M hΓ1 hΓ2 hΓ'1 hΓ'2 hMf hMs
    have hR : IsPullback M (Limits.pullback.fst t' π) (Limits.pullback.fst t π) κ := by
      refine IsPullback.of_right (h₁₂ := Limits.pullback.snd t π) (v₁₃ := π) (h₂₂ := t) ?_ hMf
        (IsPullback.of_hasPullback t π).flip
      rw [hMs, hκ]
      exact (IsPullback.of_hasPullback t' π).flip
    have hcomm : Γ' ≫ M = κ ≫ Γ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hMf, ← Category.assoc, hΓ'1, Category.id_comp, Category.assoc, hΓ1,
          Category.comp_id]
      · rw [Category.assoc, hMs, hΓ'2, Category.assoc, hΓ2]
    have hG : IsPullback Γ' κ M Γ := by
      refine IsPullback.of_right (h₁₂ := Limits.pullback.fst t' π) (v₁₃ := κ)
        (h₂₂ := Limits.pullback.fst t π) ?_ hcomm hR.flip
      rw [hΓ'1, hΓ1]
      exact IsPullback.id_horiz κ
    have h1 : hG.isoPullback.hom ≫ Limits.pullback.fst M Γ = Γ' := hG.isoPullback_hom_fst
    have hsurj : Function.Surjective hG.isoPullback.hom := hG.isoPullback.hom.surjective
    rw [← Scheme.Pullback.range_fst, ← h1]
    ext z
    constructor
    · rintro ⟨w, rfl⟩
      obtain ⟨x, rfl⟩ := hsurj w
      exact ⟨x, by rw [Scheme.Hom.comp_apply]⟩
    · rintro ⟨x, rfl⟩
      exact ⟨hG.isoPullback.hom x, by rw [Scheme.Hom.comp_apply]⟩

  intro B B'' π _ V e he heπ T T' g k
  haveI : Etale V.hom := V.prop
  haveI := he
  have hw : g.left ≫ V.hom = T.hom := MorphismProperty.Over.w g
  have hG1 : (wcR2Graph π V e heπ g : T.left ⟶ Limits.pullback T.hom π) ≫
      Limits.pullback.fst T.hom π = 𝟙 T.left := by
    unfold wcR2Graph
    exact Limits.pullback.lift_fst _ _ _
  have hG2 : (wcR2Graph π V e heπ g : T.left ⟶ Limits.pullback T.hom π) ≫
      Limits.pullback.snd T.hom π = g.left ≫ e := by
    unfold wcR2Graph
    exact Limits.pullback.lift_snd _ _ _
  have hG'1 : (wcR2Graph π V e heπ (k ≫ g) : T'.left ⟶ Limits.pullback T'.hom π) ≫
      Limits.pullback.fst T'.hom π = 𝟙 T'.left := by
    unfold wcR2Graph
    exact Limits.pullback.lift_fst _ _ _
  have hG'2 : (wcR2Graph π V e heπ (k ≫ g) : T'.left ⟶ Limits.pullback T'.hom π) ≫
      Limits.pullback.snd T'.hom π = k.left ≫ g.left ≫ e := by
    exact (Limits.pullback.lift_snd _ _ _).trans (Category.assoc _ _ _)
  have hM : ((wcEtBaseChange π).map k).left = Limits.pullback.lift
      (Limits.pullback.fst T'.hom π ≫ k.left) (Limits.pullback.snd T'.hom π)
      (by rw [Category.assoc, MorphismProperty.Over.w k, Limits.pullback.condition]) := by
    first
    | exact MorphismProperty.Over.pullback_map_left _ _ π k
    | rfl
    | (unfold wcEtBaseChange; erw [MorphismProperty.Over.pullback_map_left])
  have hMf : ((wcEtBaseChange π).map k).left ≫ Limits.pullback.fst T.hom π =
      Limits.pullback.fst T'.hom π ≫ k.left := by
    rw [hM]
    exact Limits.pullback.lift_fst _ _ _
  have hMs : ((wcEtBaseChange π).map k).left ≫ Limits.pullback.snd T.hom π =
      Limits.pullback.snd T'.hom π := by
    rw [hM]
    exact Limits.pullback.lift_snd _ _ _
  refine ⟨s1 T.hom V.hom π e heπ g.left hw _ hG1 hG2, s2 T.hom π _ hG1, ?_,
    s3 T.hom T'.hom π k.left (MorphismProperty.Over.w k) (g.left ≫ e) _ _ _ hG1 hG2 hG'1 hG'2
      hMf hMs⟩
  intro x
  refine ⟨g.left x, ?_⟩
  have hx := congrArg (fun f : T.left ⟶ B'' => f x) hG2
  simp only [Scheme.Hom.comp_apply] at hx
  exact hx.symm

theorem wc_r2gc_extZero_indicator : ∀ (Y : Scheme.{u}) (S : Set Y) (m : ℕ) (W : Y.Etale) (D : Set W.left), IsClopen D → (∀ x ∈ D, W.hom x ∈ S) → ∀ (a : ULift.{u+1} (ZMod m)), ∃ χ : (wcEtExtZero Y S m).obj.obj (Opposite.op W), (∀ (W' : Y.Etale) (h : W' ⟶ W), Set.range h.left ⊆ D → ∃ y : (wcEtExtZeroPre Y S m).obj (Opposite.op W'), y.1 = a ∧ ((wcEtExtZero Y S m).obj.map h.op).hom χ = ((toSheafify (Scheme.smallEtaleTopology Y) (wcEtExtZeroPre Y S m)).app (Opposite.op W')).hom y) ∧ (∀ (W' : Y.Etale) (h : W' ⟶ W), Set.range h.left ⊆ Dᶜ → ((wcEtExtZero Y S m).obj.map h.op).hom χ = 0) :=
by
  intro Y S m W D hD hDS a
  classical

  have hglue : ∀ (T : Y.Etale) (n : ℕ) (Ti : Fin n → Y.Etale) (t : ∀ i, Ti i ⟶ T),
      (∀ i, IsOpenImmersion (t i).left) →
      (∀ i j, i ≠ j → Disjoint (Set.range (t i).left) (Set.range (t j).left)) →
      (∀ x : T.left, ∃ i, x ∈ Set.range (t i).left) →
      ∀ (F : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}),
      Function.Surjective (fun (s : F.obj.obj (Opposite.op T)) (i : Fin n) =>
        (F.obj.map (t i).op).hom s) := by
    intro T n Ti t hopen hdisj hcov F
    have s1 : ∀ W : Y.Etale, IsEmpty W.left → Subsingleton (F.obj.obj (Opposite.op W)) := by
      intro W hW
      have hbot : (⊥ : Sieve W) ∈ Scheme.smallEtaleTopology Y W := by
        change (⊥ : Sieve W) ∈ Scheme.smallGrothendieckTopology @Etale Y W
        rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
        apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
        intro x
        exact isEmptyElim x
      exact AddCommGrpCat.isZero_iff_subsingleton.mp (Sheaf.isTerminalOfBotCover F W hbot).isZero
    have s2 : Sieve.generate (Presieve.ofArrows Ti t) ∈ Scheme.smallEtaleTopology Y T := by
      change Sieve.generate (Presieve.ofArrows Ti t) ∈ Scheme.smallGrothendieckTopology @Etale Y T
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      obtain ⟨i, y, hy⟩ := hcov x
      haveI := hopen i
      have hmem : (Sieve.generate (Presieve.ofArrows Ti t)).arrows (t i) :=
        Sieve.le_generate (Presieve.ofArrows Ti t) (Ti i) (t i) (Presieve.ofArrows.mk i)
      exact ⟨Ti i, t i, y, hmem, inferInstance, hy⟩
    let P := F.obj ⋙ forget AddCommGrpCat
    have hP : Presieve.IsSheaf (Scheme.smallEtaleTopology Y) P :=
      (isSheaf_iff_isSheaf_of_type _ _).1
        ((Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology Y) F.obj
          (forget AddCommGrpCat)).1 F.cond)
    have s3 := (Presieve.isSheafFor_arrows_iff P t).1 (hP.isSheafFor _ s2)
    have s4 : ∀ x : ∀ i, P.obj (Opposite.op (Ti i)), Presieve.Arrows.Compatible P t x := by
      intro x i j Z gi gj h
      have hl : gi.left ≫ (t i).left = gj.left ≫ (t j).left := by
        have h1 : (Scheme.Etale.forget Y ⋙ Over.forget Y).map gi ≫
            (Scheme.Etale.forget Y ⋙ Over.forget Y).map (t i) =
            (Scheme.Etale.forget Y ⋙ Over.forget Y).map gj ≫
            (Scheme.Etale.forget Y ⋙ Over.forget Y).map (t j) := by
          rw [← Functor.map_comp, ← Functor.map_comp, h]
        exact h1
      by_cases hij : i = j
      · subst hij
        haveI := hopen i
        have hg : gi = gj := by
          apply MorphismProperty.Over.Hom.ext
          exact (cancel_mono (t i).left).1 hl
        rw [hg]
      · haveI : IsEmpty Z.left := ⟨fun z => by
          have hz : (t i).left (gi.left z) = (t j).left (gj.left z) := by
            rw [← Scheme.Hom.comp_apply, hl, Scheme.Hom.comp_apply]
          exact Set.disjoint_left.1 (hdisj i j hij) ⟨_, rfl⟩ ⟨_, hz.symm⟩⟩
        exact @Subsingleton.elim _ (s1 Z inferInstance) _ _
    intro x
    obtain ⟨s, hs, _⟩ := s3 x (s4 x)
    exact ⟨s, funext hs⟩

  let O₀ : W.left.Opens := ⟨D, hD.isOpen⟩
  let O₁ : W.left.Opens := ⟨Dᶜ, hD.compl.isOpen⟩
  let O : Fin 2 → W.left.Opens := ![O₀, O₁]
  let Ti : Fin 2 → Y.Etale := fun i => wcEtOpen Y W (O i)
  let t : ∀ i, Ti i ⟶ W := fun i => wcEtOpenι Y W (O i)
  have hrange : ∀ i, Set.range (t i).left = (O i : Set W.left) := fun i =>
    Scheme.Opens.range_ι (O i)
  have hopen : ∀ i, IsOpenImmersion (t i).left := fun i => by
    show IsOpenImmersion (O i).ι
    infer_instance
  have hdisj : ∀ i j, i ≠ j → Disjoint (Set.range (t i).left) (Set.range (t j).left) := by
    intro i j hij
    rw [hrange, hrange]
    fin_cases i <;> fin_cases j
    · exact absurd rfl hij
    · show Disjoint D Dᶜ
      exact disjoint_compl_right
    · show Disjoint Dᶜ D
      exact disjoint_compl_left
    · exact absurd rfl hij
  have hcov : ∀ x : W.left, ∃ i, x ∈ Set.range (t i).left := by
    intro x
    by_cases hx : x ∈ D
    · exact ⟨0, by rw [hrange]; exact hx⟩
    · exact ⟨1, by rw [hrange]; exact hx⟩

  have hp' : ∀ x : (O₀ : Scheme.{u}), (O₀.ι ≫ W.hom) x ∈ S := by
    intro x
    rw [Scheme.Hom.comp_apply]
    have hx : O₀.ι x ∈ Set.range O₀.ι := ⟨x, rfl⟩
    rw [Scheme.Opens.range_ι] at hx
    exact hDS _ hx
  have hp : ∀ x, (Ti 0).hom x ∈ S := hp'
  let y₀ : (wcEtExtZeroPre Y S m).obj (Opposite.op (Ti 0)) :=
    (⟨a, AddSubgroup.mem_iSup_of_mem hp (AddSubgroup.mem_top a)⟩ :
      wcSuppSub.{u} m (∀ x, (Ti 0).hom x ∈ S))
  let toSh := toSheafify (Scheme.smallEtaleTopology Y) (wcEtExtZeroPre Y S m)
  let f : ∀ i : Fin 2, (wcEtExtZero Y S m).obj.obj (Opposite.op (Ti i)) :=
    Fin.cases ((toSh.app (Opposite.op (Ti 0))).hom y₀) (fun _ => 0)
  obtain ⟨χ, hχ⟩ := hglue W 2 Ti t hopen hdisj hcov (wcEtExtZero Y S m) f
  have R0 : ((wcEtExtZero Y S m).obj.map (t 0).op).hom χ =
      (toSh.app (Opposite.op (Ti 0))).hom y₀ := congrFun hχ 0
  have R1 : ((wcEtExtZero Y S m).obj.map (t 1).op).hom χ = 0 := congrFun hχ 1

  have hfac : ∀ (i : Fin 2) (W' : Y.Etale) (h : W' ⟶ W), Set.range h.left ⊆ (O i : Set W.left) →
      ∃ h' : W' ⟶ Ti i, h' ≫ t i = h := by
    intro i W' h hsub
    have H : Set.range h.left ⊆ Set.range (O i).ι := by
      rw [Scheme.Opens.range_ι]; exact hsub
    let h₁ := IsOpenImmersion.lift (O i).ι h.left H
    have hw : h₁ ≫ (Ti i).hom = W'.hom := by
      show h₁ ≫ (O i).ι ≫ W.hom = W'.hom
      rw [← Category.assoc, IsOpenImmersion.lift_fac]
      exact MorphismProperty.Over.w h
    refine ⟨MorphismProperty.Over.homMk h₁ hw trivial, ?_⟩
    apply MorphismProperty.Over.Hom.ext
    show h₁ ≫ (O i).ι = h.left
    exact IsOpenImmersion.lift_fac _ _ _
  have hcomp : ∀ {W' T : Y.Etale} (h' : W' ⟶ T) (g : T ⟶ W)
      (σ : (wcEtExtZero Y S m).obj.obj (Opposite.op W)),
      ((wcEtExtZero Y S m).obj.map (h' ≫ g).op).hom σ =
        ((wcEtExtZero Y S m).obj.map h'.op).hom (((wcEtExtZero Y S m).obj.map g.op).hom σ) := by
    intro W' T h' g σ
    rw [op_comp, Functor.map_comp]
    rfl
  refine ⟨χ, fun W' h hsub => ?_, fun W' h hsub => ?_⟩
  · obtain ⟨h', rfl⟩ := hfac 0 W' h hsub
    refine ⟨(wcEtExtZeroPre Y S m).map h'.op y₀, rfl, ?_⟩
    rw [hcomp, R0]
    have hn := congrArg (fun φ => φ.hom y₀) (toSh.naturality h'.op)
    exact hn.symm
  · obtain ⟨h', rfl⟩ := hfac 1 W' h hsub
    rw [hcomp, R1, map_zero]

theorem wc_r2gc_section_locally_pre : ∀ (Y : Scheme.{u}) (S : Set Y) (m : ℕ) (U : Y.Etale) (s : (wcEtExtZero Y S m).obj.obj (Opposite.op U)) (z : U.left), ∃ (W : Y.Etale) (h : W ⟶ U) (w : W.left) (y : (wcEtExtZeroPre Y S m).obj (Opposite.op W)), h.left w = z ∧ ((wcEtExtZero Y S m).obj.map h.op).hom s = ((toSheafify (Scheme.smallEtaleTopology Y) (wcEtExtZeroPre Y S m)).app (Opposite.op W)).hom y ∧ (U.hom z ∉ S → y = 0) :=
by
  intro Y S m U s z
  classical
  have hcov : ∀ (V : Y.Etale) (R : Sieve V), R ∈ Scheme.smallEtaleTopology Y V →
      ∀ x : V.left, ∃ (V₁ : Y.Etale) (c : V₁ ⟶ V) (y : V₁.left), R.arrows c ∧ c.left y = x := by
    intro V R hR x
    change R ∈ Scheme.smallGrothendieckTopology @Etale Y V at hR
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
    obtain ⟨V₁, c, y, hc, -, hy⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hR x
    exact ⟨V₁, c, y, hc, hy⟩
  obtain ⟨W, h, w, ⟨y, hy⟩, hw⟩ := hcov U _
    (Presheaf.imageSieve_mem (Scheme.smallEtaleTopology Y)
      (toSheafify (Scheme.smallEtaleTopology Y) (wcEtExtZeroPre Y S m)) (U := Opposite.op U) s) z
  have hy' : ((toSheafify (Scheme.smallEtaleTopology Y) (wcEtExtZeroPre Y S m)).app
      (Opposite.op W)).hom y = ((wcEtExtZero Y S m).obj.map h.op).hom s := hy
  refine ⟨W, h, w, y, hw, hy'.symm, fun hz => ?_⟩
  have hWw : W.hom w = U.hom z := by
    rw [← MorphismProperty.Over.w h, Scheme.Hom.comp_apply, hw]
  have hnp : ¬ (∀ x : W.left, W.hom x ∈ S) := fun hp => hz (hWw ▸ hp w)
  have hy1 : (y.1 : ULift.{u+1} (ZMod m)) ∈
      (⨆ _ : (∀ x : W.left, W.hom x ∈ S), (⊤ : AddSubgroup (ULift.{u+1} (ZMod m)))) := y.2
  rw [iSup_neg hnp, AddSubgroup.mem_bot] at hy1
  exact Subtype.ext hy1

theorem wc_et_clopen_family_shrink : ∀ {Y : Scheme.{u}} (U W₀ : Y.Etale) (h₀ : W₀ ⟶ U) (w₀ : W₀.left) (k : ℕ) (A : Fin k → Set U.left), (∀ j, IsClopen (A j)) → ∃ (W : Y.Etale) (h : W ⟶ W₀) (w : W.left), h.left w = w₀ ∧ ∀ j, (h₀.left w₀ ∈ A j → Set.range (h ≫ h₀).left ⊆ A j) ∧ (h₀.left w₀ ∉ A j → Set.range (h ≫ h₀).left ⊆ (A j)ᶜ) :=
by
  intro Y U W₀ h₀ w₀ k A hA
  classical
  let A' : Fin k → Set U.left := fun j => if h₀.left w₀ ∈ A j then A j else (A j)ᶜ
  have hopen : ∀ j, IsOpen (A' j) := by
    intro j
    by_cases hj : h₀.left w₀ ∈ A j
    · simp only [A', if_pos hj]; exact (hA j).isOpen
    · simp only [A', if_neg hj]; exact (hA j).compl.isOpen
  have hmem : ∀ j, h₀.left w₀ ∈ A' j := by
    intro j
    by_cases hj : h₀.left w₀ ∈ A j
    · simp only [A', if_pos hj]; exact hj
    · simp only [A', if_neg hj]; exact hj
  let O : Set W₀.left := ⋂ j, h₀.left ⁻¹' A' j
  have hO : IsOpen O :=
    isOpen_iInter_of_finite (fun j => (hopen j).preimage h₀.left.continuous)
  have hw₀O : w₀ ∈ O := Set.mem_iInter.mpr (fun j => hmem j)
  let O' : W₀.left.Opens := ⟨O, hO⟩
  have hcl : ∀ j, Set.range (wcEtOpenι Y W₀ O' ≫ h₀).left ⊆ A' j := by
    rintro j _ ⟨x, rfl⟩
    let x' : O' := x
    have hx : (wcEtOpenι Y W₀ O' ≫ h₀).left x = h₀.left x'.1 :=
      (Scheme.Hom.comp_apply O'.ι h₀.left x').trans (congrArg h₀.left (Scheme.Opens.ι_apply O' x'))
    rw [hx]
    exact Set.mem_iInter.mp x'.2 j
  refine ⟨wcEtOpen Y W₀ O', wcEtOpenι Y W₀ O', (⟨w₀, hw₀O⟩ : O'), Scheme.Opens.ι_apply O' _, ?_⟩
  intro j
  refine ⟨fun hj => ?_, fun hj => ?_⟩
  · have := hcl j
    simp only [A', if_pos hj] at this
    exact this
  · have := hcl j
    simp only [A', if_neg hj] at this
    exact this

theorem wc_r2gc_geom_multi_lift : ∀ {B : Scheme.{u}} (T V : B.Etale) (Ω : Type u) [Field Ω] (tb : Spec (.of Ω) ⟶ T.left) (k : ℕ) (vb : Fin k → (Spec (.of Ω) ⟶ V.left)), (∀ i, vb i ≫ V.hom = tb ≫ T.hom) → ∃ (T' : B.Etale) (c : T' ⟶ T) (tb' : Spec (.of Ω) ⟶ T'.left) (g : Fin k → (T' ⟶ V)), tb' ≫ c.left = tb ∧ ∀ i, tb' ≫ (g i).left = vb i :=
by
  intro B T V Ω _ tb k
  induction k with
  | zero =>
    intro vb _
    refine ⟨T, 𝟙 T, tb, fun i => i.elim0, ?_, fun i => i.elim0⟩
    show tb ≫ 𝟙 T.left = tb
    exact Category.comp_id _
  | succ k ih =>
    intro vb hvb
    obtain ⟨T₁, c₁, tb₁, g₁, I1, I2⟩ := ih (fun i => vb i.castSucc) (fun i => hvb i.castSucc)
    have hcond : tb₁ ≫ T₁.hom = vb (Fin.last k) ≫ V.hom := by
      rw [← MorphismProperty.Over.w c₁, ← Category.assoc, I1, hvb]
    haveI : Etale T₁.hom := T₁.prop
    haveI : Etale V.hom := V.prop
    let T₂ : B.Etale := MorphismProperty.Over.mk ⊤
      (Limits.pullback.fst T₁.hom V.hom ≫ T₁.hom) inferInstance
    let c₂ : T₂ ⟶ T₁ := MorphismProperty.Over.homMk (Limits.pullback.fst T₁.hom V.hom) rfl trivial
    let gl : T₂ ⟶ V := MorphismProperty.Over.homMk (Limits.pullback.snd T₁.hom V.hom)
      Limits.pullback.condition.symm trivial
    let tb₂ : Spec (.of Ω) ⟶ T₂.left := Limits.pullback.lift tb₁ (vb (Fin.last k)) hcond
    refine ⟨T₂, c₂ ≫ c₁, tb₂,
      Fin.lastCases (motive := fun _ => T₂ ⟶ V) gl (fun i => c₂ ≫ g₁ i), ?_, ?_⟩
    · show Limits.pullback.lift tb₁ (vb (Fin.last k)) hcond ≫
        Limits.pullback.fst T₁.hom V.hom ≫ c₁.left = tb
      rw [Limits.pullback.lift_fst_assoc, I1]
    · intro i
      induction i using Fin.lastCases with
      | last =>
        rw [Fin.lastCases_last]
        show Limits.pullback.lift tb₁ (vb (Fin.last k)) hcond ≫
          Limits.pullback.snd T₁.hom V.hom = vb (Fin.last k)
        exact Limits.pullback.lift_snd _ _ _
      | cast j =>
        rw [Fin.lastCases_castSucc]
        show Limits.pullback.lift tb₁ (vb (Fin.last k)) hcond ≫
          Limits.pullback.fst T₁.hom V.hom ≫ (g₁ j).left = vb j.castSucc
        rw [Limits.pullback.lift_fst_assoc, I2]

theorem wc_r2gc_graph_point_separation : ∀ {B B'' : Scheme.{u}} (π : B'' ⟶ B) [IsFinite π] (V : B.Etale) (e : V.left ⟶ B''), IsOpenImmersion e → ∀ (heπ : e ≫ π = V.hom) (T : B.Etale) (g₁ g₂ : T ⟶ V) (Ω : Type u) [Field Ω] (tb : Spec (.of Ω) ⟶ T.left), wcR2Graph π V e heπ g₁ (tb (IsLocalRing.closedPoint Ω)) ∈ Set.range (wcR2Graph π V e heπ g₂) → tb ≫ g₁.left = tb ≫ g₂.left :=
by
  intro B B'' π _ V e he heπ T g₁ g₂ Ω _ tb hmem
  haveI := he
  haveI : Etale V.hom := V.prop

  have hG1 : ∀ g : T ⟶ V, (wcR2Graph π V e heπ g : T.left ⟶ Limits.pullback T.hom π) ≫
      Limits.pullback.fst T.hom π = 𝟙 T.left := by
    intro g
    unfold wcR2Graph
    exact Limits.pullback.lift_fst _ _ _
  have hG2 : ∀ g : T ⟶ V, (wcR2Graph π V e heπ g : T.left ⟶ Limits.pullback T.hom π) ≫
      Limits.pullback.snd T.hom π = g.left ≫ e := by
    intro g
    unfold wcR2Graph
    exact Limits.pullback.lift_snd _ _ _

  have gs1 : ∀ {S X Y B'' : Scheme.{u}} (t : X ⟶ S) (v : Y ⟶ S) [Etale v] (π : B'' ⟶ S)
      (e : Y ⟶ B'') [IsOpenImmersion e], e ≫ π = v → ∀ (a : X ⟶ Y), a ≫ v = t →
      ∀ (Γ : X ⟶ Limits.pullback t π), Γ ≫ Limits.pullback.fst t π = 𝟙 X →
        Γ ≫ Limits.pullback.snd t π = a ≫ e → IsOpenImmersion Γ := by
    intro S X Y B'' t v _ π e _ heπ a ha Γ hΓ1 hΓ2
    subst ha
    have hd : IsOpenImmersion (Limits.pullback.diagonal v) :=
      FormallyUnramified.isOpenImmersion_diagonal v
    have hσ : IsOpenImmersion (Limits.pullback.lift (𝟙 X) a (by simp) :
        X ⟶ Limits.pullback (a ≫ v) v) :=
      MorphismProperty.of_isPullback (P := @IsOpenImmersion)
        (Limits.pullback_lift_diagonal_isPullback a v) hd
    obtain ⟨m, hm1, hm2⟩ : ∃ m : Limits.pullback (a ≫ v) v ⟶ Limits.pullback (a ≫ v) π,
        m ≫ Limits.pullback.fst (a ≫ v) π = Limits.pullback.fst (a ≫ v) v ∧
        m ≫ Limits.pullback.snd (a ≫ v) π = Limits.pullback.snd (a ≫ v) v ≫ e :=
      ⟨Limits.pullback.lift (Limits.pullback.fst (a ≫ v) v) (Limits.pullback.snd (a ≫ v) v ≫ e)
        (by rw [Limits.pullback.condition, Category.assoc, heπ]),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have hsq : IsPullback m (Limits.pullback.snd (a ≫ v) v) (Limits.pullback.snd (a ≫ v) π) e := by
      refine IsPullback.of_right (h₁₂ := Limits.pullback.fst (a ≫ v) π) (v₁₃ := a ≫ v)
        (h₂₂ := π) ?_ hm2 (IsPullback.of_hasPullback (a ≫ v) π)
      rw [hm1, heπ]
      exact IsPullback.of_hasPullback (a ≫ v) v
    have hm : IsOpenImmersion m :=
      MorphismProperty.of_isPullback (P := @IsOpenImmersion) hsq.flip ‹IsOpenImmersion e›
    have heq : Γ = (Limits.pullback.lift (𝟙 X) a (by simp) :
        X ⟶ Limits.pullback (a ≫ v) v) ≫ m := by
      apply Limits.pullback.hom_ext
      · rw [hΓ1, Category.assoc, hm1, Limits.pullback.lift_fst]
      · rw [hΓ2, Category.assoc, hm2, ← Category.assoc, Limits.pullback.lift_snd]
    rw [heq]
    exact IsOpenImmersion.comp _ _
  have memι : ∀ (U : T.left.Opens) (z : U), U.ι z ∈ U := by
    intro U z
    show U.ι z ∈ (U : Set T.left)
    rw [← Scheme.Opens.range_ι U]
    exact ⟨z, rfl⟩

  have key : ∀ (Γ₁ Γ₂ : T.left ⟶ Limits.pullback T.hom π) (a₁ a₂ : T.left ⟶ V.left),
      IsOpenImmersion Γ₂ →
      Γ₁ ≫ Limits.pullback.fst T.hom π = 𝟙 T.left → Γ₂ ≫ Limits.pullback.fst T.hom π = 𝟙 T.left →
      Γ₁ ≫ Limits.pullback.snd T.hom π = a₁ ≫ e → Γ₂ ≫ Limits.pullback.snd T.hom π = a₂ ≫ e →
      Γ₁ (tb (IsLocalRing.closedPoint Ω)) ∈ Set.range Γ₂ → tb ≫ a₁ = tb ≫ a₂ := by
    intro Γ₁ Γ₂ a₁ a₂ hopen h11 h21 h12 h22 hx
    haveI := hopen
    let O : T.left.Opens := ⟨Γ₁ ⁻¹' Set.range Γ₂,
      (IsOpenImmersion.isOpen_range Γ₂).preimage Γ₁.continuous⟩
    have hsub : Set.range (O.ι ≫ Γ₁) ⊆ Set.range Γ₂ := by
      rintro _ ⟨z, rfl⟩
      rw [Scheme.Hom.comp_apply]
      exact memι O z
    have hfac := IsOpenImmersion.lift_fac Γ₂ (O.ι ≫ Γ₁) hsub
    have hψ : IsOpenImmersion.lift Γ₂ (O.ι ≫ Γ₁) hsub = O.ι := by
      have h := congrArg (fun k => k ≫ Limits.pullback.fst T.hom π) hfac
      simp only [Category.assoc, h21, h11, Category.comp_id] at h
      exact h
    rw [hψ] at hfac
    have hO : O.ι ≫ a₁ = O.ι ≫ a₂ := by
      have h := congrArg (fun k => k ≫ Limits.pullback.snd T.hom π) hfac
      simp only [Category.assoc, h22, h12] at h
      rw [← Category.assoc, ← Category.assoc] at h
      exact ((cancel_mono e).mp h).symm
    have hrange : Set.range tb ⊆ Set.range O.ι := by
      rintro _ ⟨p, rfl⟩
      rw [Scheme.Opens.range_ι]
      have hp : p = IsLocalRing.closedPoint Ω := Subsingleton.elim _ _
      rw [hp]
      exact hx
    have hfac₀ := IsOpenImmersion.lift_fac O.ι tb hrange
    rw [← hfac₀, Category.assoc, Category.assoc, hO]
  exact key _ _ g₁.left g₂.left
    (gs1 T.hom V.hom π e heπ g₂.left (MorphismProperty.Over.w g₂) _ (hG1 g₂) (hG2 g₂))
    (hG1 g₁) (hG1 g₂) (hG2 g₁) (hG2 g₂) hmem

theorem wc_r2gc_graph_point_exhaust : ∀ {B B'' : Scheme.{u}} (π : B'' ⟶ B) (V : B.Etale) (e : V.left ⟶ B''), IsOpenImmersion e → ∀ (heπ : e ≫ π = V.hom) (T : B.Etale) (Ω : Type u) [Field Ω] (tb : Spec (.of Ω) ⟶ T.left) (zb : Spec (.of Ω) ⟶ Limits.pullback T.hom π), zb ≫ Limits.pullback.fst T.hom π = tb → Limits.pullback.snd T.hom π (zb (IsLocalRing.closedPoint Ω)) ∈ Set.range e → ∃ vb : Spec (.of Ω) ⟶ V.left, vb ≫ V.hom = tb ≫ T.hom ∧ ∀ g : T ⟶ V, tb ≫ g.left = vb → zb (IsLocalRing.closedPoint Ω) = wcR2Graph π V e heπ g (tb (IsLocalRing.closedPoint Ω)) :=
by
  intro B B'' π V e he heπ T Ω _ tb zb hfst hsnd
  haveI := he
  have hrange : Set.range (zb ≫ Limits.pullback.snd T.hom π) ⊆ Set.range e := by
    rintro _ ⟨x, rfl⟩
    have hx : x = IsLocalRing.closedPoint Ω := Subsingleton.elim _ _
    have hc : (zb ≫ Limits.pullback.snd T.hom π) x =
        Limits.pullback.snd T.hom π (zb (IsLocalRing.closedPoint Ω)) :=
      (Scheme.Hom.comp_apply zb (Limits.pullback.snd T.hom π) x).trans
        (congrArg (fun y => Limits.pullback.snd T.hom π (zb y)) hx)
    exact (congrArg (· ∈ Set.range e) hc).mpr hsnd
  have hF : IsOpenImmersion.lift e (zb ≫ Limits.pullback.snd T.hom π) hrange ≫ e =
      zb ≫ Limits.pullback.snd T.hom π :=
    IsOpenImmersion.lift_fac _ _ _
  refine ⟨IsOpenImmersion.lift e (zb ≫ Limits.pullback.snd T.hom π) hrange, ?_, ?_⟩
  · rw [← heπ, ← Category.assoc, hF, Category.assoc, ← Limits.pullback.condition,
      ← Category.assoc, hfst]
  · intro g hg
    have hG1 : (wcR2Graph π V e heπ g : T.left ⟶ Limits.pullback T.hom π) ≫
        Limits.pullback.fst T.hom π = 𝟙 _ :=
      Limits.pullback.lift_fst _ _ _
    have hG2 : (wcR2Graph π V e heπ g : T.left ⟶ Limits.pullback T.hom π) ≫
        Limits.pullback.snd T.hom π = g.left ≫ e :=
      Limits.pullback.lift_snd _ _ _
    have h5 : zb = tb ≫ (wcR2Graph π V e heπ g : T.left ⟶ Limits.pullback T.hom π) := by
      apply Limits.pullback.hom_ext
      · exact hfst.trans ((Category.assoc _ _ _).trans
          ((congrArg (fun f => tb ≫ f) hG1).trans (Category.comp_id _))).symm
      · exact hF.symm.trans ((congrArg (fun f => f ≫ e) hg.symm).trans
          ((Category.assoc _ _ _).trans
            ((congrArg (fun f => tb ≫ f) hG2.symm).trans (Category.assoc _ _ _).symm)))
    have h6 := congrArg (fun f => f (IsLocalRing.closedPoint Ω)) h5
    exact h6.trans (Scheme.Hom.comp_apply _ _ _)

theorem wc_r2gc_local_surj : ∀ {B B'' : Scheme.{u}} (π : B'' ⟶ B) [IsFinite π] (V : B.Etale) (e : V.left ⟶ B''), IsOpenImmersion e → ∀ (heπ : e ≫ π = V.hom) (S : Set B''), Set.range e = S → ∀ (ℓ : ℕ) (γ0 : (wcEtExtZero B'' S ℓ).obj.obj (Opposite.op ((wcEtBaseChange π).obj V))), wcR2GraphInd π V e heπ S ℓ γ0 → ∀ (T : B.Etale) (q : ((wcEtBaseChange π).op ⋙ (wcEtExtZero B'' S ℓ).obj).obj (Opposite.op T)) (t : T.left), ∃ (T' : B.Etale) (c : T' ⟶ T) (t' : T'.left) (r : (wcFTKU V).obj (Opposite.op T')), c.left t' = t ∧ ((wcR2FreeMap V ((wcEtBaseChange π).op ⋙ (wcEtExtZero B'' S ℓ).obj) γ0).app (Opposite.op T')).hom r = (((wcEtBaseChange π).op ⋙ (wcEtExtZero B'' S ℓ).obj).map c.op).hom q :=
by
  intro B B'' π _ V e he heπ S hS ℓ γ0 hγ T q t
  classical
  haveI := he

  suffices key : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (tb : Spec (.of Ω) ⟶ T.left),
      tb (IsLocalRing.closedPoint Ω) = t → ∃ (T' : B.Etale) (c : T' ⟶ T) (t' : T'.left)
