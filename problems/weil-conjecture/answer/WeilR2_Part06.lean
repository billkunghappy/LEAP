    Functor.isoWhiskerLeft _ (sheafificationNatIso (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1})⟩

theorem wc_r2gs_integral_field_ext_pull_bij : ∀ (k K : Type u) [Field k] [Field K] [IsSepClosed k] (e : k →+* K), e.IsIntegral → ∀ (Y : Scheme.{u}) (f : Y ⟶ Spec (.of k)) (P : Scheme.{u}) (π : P ⟶ Y) (p : P ⟶ Spec (.of K)), IsPullback π p f (Spec.map (CommRingCat.ofHom e)) → ∀ (m : ℕ), m ≠ 0 → ∀ (D : wcEtPullData π m) (q : ℕ), Function.Bijective (wcEtPull D q) :=
by
  intro k K _ _ _ e he Y f P π p h m _hm D q
  classical

  letI := e.toAlgebra
  have hae : algebraMap k K = e := RingHom.algebraMap_toAlgebra e
  have hint : (algebraMap k K).IsIntegral := by rw [hae]; exact he
  have h' : IsPullback π p f (Spec.map (CommRingCat.ofHom (algebraMap k K))) := by
    rw [hae]; exact h
  haveI : Algebra.IsIntegral k K := ⟨hint⟩
  haveI : Algebra.IsAlgebraic k K := Algebra.IsIntegral.isAlgebraic
  haveI : IsPurelyInseparable k K := Algebra.IsAlgebraic.isPurelyInseparable_of_isSepClosed
  haveI hsint : IsIntegralHom (Spec.map (CommRingCat.ofHom (algebraMap k K))) :=
    IsIntegralHom.SpecMap_iff.mpr hint
  have hsinj : UniversallyInjective (Spec.map (CommRingCat.ofHom (algebraMap k K))) := by
    rw [universallyInjective_eq_diagonal]
    change Surjective (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap k K))))
    have h1 : Subsingleton (PrimeSpectrum (TensorProduct k K K)) :=
      (PrimeSpectrum.isHomeomorph_comap_of_isPurelyInseparable k K K).injective.subsingleton
    haveI : Subsingleton ↥(Spec (CommRingCat.of (TensorProduct k K K))) := h1
    haveI : Subsingleton ↥(Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap k K)))
        (Spec.map (CommRingCat.ofHom (algebraMap k K)))) :=
      (Scheme.homeoOfIso (pullbackSpecIso k K K)).injective.subsingleton
    obtain ⟨x⟩ : Nonempty (PrimeSpectrum K) := inferInstance
    exact ⟨fun z => ⟨x, Subsingleton.elim _ _⟩⟩
  have hssurj : Surjective (Spec.map (CommRingCat.ofHom (algebraMap k K))) := inferInstance
  haveI hπint : IsIntegralHom π :=
    MorphismProperty.of_isPullback (P := @IsIntegralHom) h'.flip hsint
  have hV : ∀ V : Y.Etale, IsHomeomorph (Limits.pullback.fst V.hom π) := by
    intro V
    have hpaste : IsPullback (Limits.pullback.fst V.hom π) (Limits.pullback.snd V.hom π ≫ p)
        (V.hom ≫ f) (Spec.map (CommRingCat.ofHom (algebraMap k K))) :=
      IsPullback.paste_vert (IsPullback.of_hasPullback V.hom π) h'
    haveI : UniversallyInjective (Limits.pullback.fst V.hom π) :=
      MorphismProperty.of_isPullback (P := @UniversallyInjective) hpaste.flip hsinj
    haveI : IsIntegralHom (Limits.pullback.fst V.hom π) :=
      MorphismProperty.of_isPullback (P := @IsIntegralHom) hpaste.flip hsint
    haveI : Surjective (Limits.pullback.fst V.hom π) :=
      MorphismProperty.of_isPullback (P := @Surjective) hpaste.flip hssurj
    rw [isHomeomorph_iff_continuous_isClosedMap_bijective]
    exact ⟨Scheme.Hom.continuous _, Scheme.Hom.isClosedMap _,
      Scheme.Hom.injective _, Scheme.Hom.surjective _⟩

  haveI := D.cont
  haveI := D.additive
  haveI := D.presLim
  haveI := D.presColim
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y m)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing P m)) := HasExt.standard _
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing Y m)) :=
    sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology Y) (wcEtZModRing Y m)
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing P m)) :=
    sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology P) (wcEtZModRing P m)
  haveI hRadd : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange π) _ _ D.cont D.φ).Additive :=
    @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D.adj D.additive
  haveI hRlim : Limits.PreservesFiniteLimits
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange π) _ _ D.cont D.φ) := by
    have : Limits.PreservesLimitsOfSize.{0, 0}
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange π) _ _ D.cont D.φ) :=
      D.adj.rightAdjoint_preservesLimits
    infer_instance

  haveI hRcolim : Limits.PreservesFiniteColimits
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange π) _ _ D.cont D.φ) := by
    haveI hfin : Limits.PreservesFiniteColimits (wcEtPush π) := wc_et_integral_push_exact π
    let e0 : @Functor.sheafPushforwardContinuous _ _ _ _ (wcEtBaseChange π) AddCommGrpCat.{u+1} _
        (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology P) D.cont ≅
        (sheafToPresheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1} ⋙
          (Functor.whiskeringLeft (Y.Etale)ᵒᵖ (P.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj
            (@Functor.op Y.Etale _ P.Etale _ (wcEtBaseChange π)) ⋙
          presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
      (@Functor.sheafPushforwardContinuous _ _ _ _ (wcEtBaseChange π) AddCommGrpCat.{u+1} _
        (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology P) D.cont).rightUnitor.symm ≪≫
      Functor.isoWhiskerLeft (@Functor.sheafPushforwardContinuous _ _ _ _ (wcEtBaseChange π)
          AddCommGrpCat.{u+1} _ (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology P) D.cont)
        (asIso (sheafificationAdjunction (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).counit).symm ≪≫
      (Functor.associator _ _ _).symm ≪≫
      Functor.isoWhiskerRight (@Functor.sheafPushforwardContinuousCompSheafToPresheafIso _ _ _ _
          (wcEtBaseChange π) AddCommGrpCat.{u+1} _ (Scheme.smallEtaleTopology Y)
          (Scheme.smallEtaleTopology P) D.cont)
        (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) ≪≫
      Functor.associator _ _ _
    haveI hfin' : Limits.PreservesFiniteColimits
        (sheafToPresheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1} ⋙
          (Functor.whiskeringLeft (Y.Etale)ᵒᵖ (P.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj
            (@Functor.op Y.Etale _ P.Etale _ (wcEtBaseChange π)) ⋙
          presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := hfin
    haveI hc : Limits.PreservesFiniteColimits
        (@Functor.sheafPushforwardContinuous _ _ _ _ (wcEtBaseChange π) AddCommGrpCat.{u+1} _
          (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology P) D.cont) :=
      Limits.preservesFiniteColimits_of_natIso e0.symm
    haveI hl : Limits.PreservesFiniteLimits
        (@Functor.sheafPushforwardContinuous _ _ _ _ (wcEtBaseChange π) AddCommGrpCat.{u+1} _
          (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology P) D.cont) := inferInstance
    haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.smallEtaleTopology Y)
      (wcEtZModRing Y m)
    haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.smallEtaleTopology P)
      (wcEtZModRing P m)
    exact (sheafOfModules_pushforward_exact (J := Scheme.smallEtaleTopology Y)
      (K := Scheme.smallEtaleTopology P) (wcEtBaseChange π) (wcEtZModRing Y m)
      (wcEtZModRing P m) D.φ).2.2

  have s3 : ∀ (F : SheafOfModules.{u+1} (wcEtZModRing Y m) ⥤ SheafOfModules.{u+1} (wcEtZModRing P m))
      (G : SheafOfModules.{u+1} (wcEtZModRing P m) ⥤ SheafOfModules.{u+1} (wcEtZModRing Y m))
      [F.Additive] [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F]
      [G.Additive] [Limits.PreservesFiniteLimits G] [Limits.PreservesFiniteColimits G]
      (η : 𝟭 _ ⟶ F ⋙ G) (n : ℕ) {A B : SheafOfModules.{u+1} (wcEtZModRing Y m)}
      (u : Abelian.Ext A B n),
      u.comp (Abelian.Ext.mk₀ (η.app B)) (add_zero n) =
        (Abelian.Ext.mk₀ (η.app A)).comp
          (Abelian.Ext.mapExactFunctor G (Abelian.Ext.mapExactFunctor F u)) (zero_add n) := by
    intro F G _ _ _ _ _ _ η n
    induction n with
    | zero =>
      intro A B u
      obtain ⟨g, rfl⟩ := (Abelian.Ext.mk₀_bijective A B).2 u
      rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀]
      congr 1
      exact η.naturality g
    | succ n ih =>
      intro A B u
      let ι := Injective.ι B
      let S := ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)
      have hS : S.ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) inferInstance inferInstance
      obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ A hS u
        (Abelian.Ext.eq_zero_of_injective _) rfl
      have hS2 := (hS.map_of_exact F).map_of_exact G
      let φ : S ⟶ (S.map F).map G :=
        { τ₁ := η.app S.X₁
          τ₂ := η.app S.X₂
          τ₃ := η.app S.X₃
          comm₁₂ := (η.naturality S.f).symm
          comm₂₃ := (η.naturality S.g).symm }
      have N1 : hS.extClass.comp (Abelian.Ext.mk₀ (η.app S.X₁)) (add_zero 1) =
          (Abelian.Ext.mk₀ (η.app S.X₃)).comp hS2.extClass (zero_add 1) :=
        hS.extClass_naturality hS2 φ
      have N2 : Abelian.Ext.mapExactFunctor G (Abelian.Ext.mapExactFunctor F hS.extClass) =
          hS2.extClass := by
        rw [Abelian.Ext.mapExactFunctor_extClass F hS, Abelian.Ext.mapExactFunctor_extClass G]
      subst hx₃
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp, N2]
      calc (x₃.comp hS.extClass rfl).comp (Abelian.Ext.mk₀ (η.app S.X₁)) (add_zero (n + 1))
          = x₃.comp (hS.extClass.comp (Abelian.Ext.mk₀ (η.app S.X₁)) (add_zero 1)) rfl :=
            Abelian.Ext.comp_assoc _ _ _ rfl (add_zero 1) (by omega)
        _ = x₃.comp ((Abelian.Ext.mk₀ (η.app S.X₃)).comp hS2.extClass (zero_add 1)) rfl := by
            rw [N1]
        _ = (x₃.comp (Abelian.Ext.mk₀ (η.app S.X₃)) (add_zero n)).comp hS2.extClass rfl :=
            (Abelian.Ext.comp_assoc _ _ _ (add_zero n) (zero_add 1) (by omega)).symm
        _ = ((Abelian.Ext.mk₀ (η.app A)).comp (Abelian.Ext.mapExactFunctor G
              (Abelian.Ext.mapExactFunctor F x₃)) (zero_add n)).comp hS2.extClass rfl := by
            rw [ih]
        _ = _ := Abelian.Ext.comp_assoc _ _ _ (zero_add n) rfl (by omega)

  have s4 : ∀ (L : SheafOfModules.{u+1} (wcEtZModRing Y m) ⥤ SheafOfModules.{u+1} (wcEtZModRing P m))
      (R : SheafOfModules.{u+1} (wcEtZModRing P m) ⥤ SheafOfModules.{u+1} (wcEtZModRing Y m))
      (adj : L ⊣ R) (X : SheafOfModules.{u+1} (wcEtZModRing Y m))
      (Z : SheafOfModules.{u+1} (wcEtZModRing P m)) (μ : L.obj X ≅ Z) (ψ : R.obj Z ≅ X),
      (∀ a b : X ⟶ X, a ≫ b = b ≫ a) → IsIso (adj.unit.app X ≫ R.map μ.hom) := by
    intro L R adj X Z μ ψ hcomm
    obtain ⟨g, hg⟩ := (adj.homEquiv X Z).surjective ψ.inv
    have h1 : adj.unit.app X ≫ R.map μ.hom ≫ R.map (μ.inv ≫ g) = ψ.inv := by
      rw [← R.map_comp, Iso.hom_inv_id_assoc, ← hg, Adjunction.homEquiv_unit]
    have hts : (adj.unit.app X ≫ R.map μ.hom ≫ ψ.hom) ≫
        (ψ.inv ≫ R.map (μ.inv ≫ g) ≫ ψ.hom) = 𝟙 X := by
      simp only [Category.assoc, Iso.hom_inv_id_assoc]
      rw [reassoc_of% h1, Iso.inv_hom_id]
    have hst := (hcomm _ _).symm.trans hts
    haveI : IsIso (adj.unit.app X ≫ R.map μ.hom ≫ ψ.hom) := ⟨⟨_, hts, hst⟩⟩
    have e1 : adj.unit.app X ≫ R.map μ.hom =
        (adj.unit.app X ≫ R.map μ.hom ≫ ψ.hom) ≫ ψ.inv := by
      simp
    rw [e1]
    infer_instance

  have s5 : ∀ (V : (Y.Etale)ᵒᵖ) (x y : ↑((wcEtZModRing Y m).obj.obj V)), x * y = y * x := by
    obtain ⟨α, _, hsurj, _⟩ := wc_et_zmod_ring_locbij Y m
    intro V x y
    have hsep := (wcEtZModRing Y m).isSeparated
    apply hsep (Opposite.unop V) _ ((Scheme.smallEtaleTopology Y).intersection_covering
      (Presheaf.imageSieve_mem (Scheme.smallEtaleTopology Y) α x)
      (Presheaf.imageSieve_mem (Scheme.smallEtaleTopology Y) α y))
    intro W g hg
    obtain ⟨⟨a, ha⟩, ⟨b, hb⟩⟩ := hg
    rw [map_mul, map_mul, ← ha, ← hb, ← map_mul, ← map_mul]
    congr 1
    exact @mul_comm (ULift.{u+1} (ZMod m)) _ a b

  have s6 : ∀ (a b : SheafOfModules.unit (wcEtZModRing Y m) ⟶ SheafOfModules.unit (wcEtZModRing Y m)),
      a ≫ b = b ≫ a := by
    intro a b
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro X
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    let fa : ↑((wcEtZModRing Y m).obj.obj X) →ₗ[↑((wcEtZModRing Y m).obj.obj X)]
        ↑((wcEtZModRing Y m).obj.obj X) := (a.val.app X).hom
    let fb : ↑((wcEtZModRing Y m).obj.obj X) →ₗ[↑((wcEtZModRing Y m).obj.obj X)]
        ↑((wcEtZModRing Y m).obj.obj X) := (b.val.app X).hom
    have key : ∀ (g : ↑((wcEtZModRing Y m).obj.obj X) →ₗ[↑((wcEtZModRing Y m).obj.obj X)]
        ↑((wcEtZModRing Y m).obj.obj X)) (y : ↑((wcEtZModRing Y m).obj.obj X)),
        g y = y * g 1 := by
      intro g y
      have h2 := g.map_smul y 1
      rw [smul_eq_mul, mul_one] at h2
      rw [h2, smul_eq_mul]
    revert x
    change ∀ x : ↑((wcEtZModRing Y m).obj.obj X), fb (fa x) = fa (fb x)
    intro x
    rw [key fb (fa x), key fa x, key fa (fb x), key fb x, mul_assoc, mul_assoc, s5 X (fa 1)]

  obtain ⟨E1⟩ := wc_et_toSheaf_pushforward_iso π m D
  obtain ⟨E2⟩ := wc_et_zmod_unit_toSheaf_iso P m
  obtain ⟨E3⟩ := wc_et_push_const_of_homeomorph π hV m (wc_et_const_sheaf_local_form P m).1
    (wc_et_const_sheaf_local_form P m).2
  obtain ⟨E4⟩ := wc_et_zmod_unit_toSheaf_iso Y m
  obtain ⟨α, hinj, hsurj, _⟩ := wc_et_zmod_ring_locbij Y m
  haveI : (SheafOfModules.toSheaf (wcEtZModRing Y m)).Full :=
    (sheafOfModules_toSheaf_torsion_equiv (Scheme.smallEtaleTopology Y) (wcEtZModRing Y m) m
      α hinj hsurj).1
  let Θ : (SheafOfModules.toSheaf (wcEtZModRing Y m)).obj
      ((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange π) _ _ D.cont D.φ).obj
        (SheafOfModules.unit (wcEtZModRing P m))) ≅
      (SheafOfModules.toSheaf (wcEtZModRing Y m)).obj (SheafOfModules.unit (wcEtZModRing Y m)) :=
    E1.app (SheafOfModules.unit (wcEtZModRing P m)) ≪≫ (wcEtPush π).mapIso E2 ≪≫ E3 ≪≫ E4.symm
  let ψ := (SheafOfModules.toSheaf (wcEtZModRing Y m)).preimageIso Θ
  have hc := s4 D.Φ _ D.adj _ _ D.μ ψ s6

  have hT := wc_ext_adjoint_transfer D.Φ
    (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange π) _ _ D.cont D.φ) D.adj
    (SheafOfModules.unit (wcEtZModRing Y m)) (SheafOfModules.unit (wcEtZModRing P m)) q
  have h3 := s3 D.Φ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange π) _ _ D.cont D.φ)
    D.adj.unit q (A := SheafOfModules.unit (wcEtZModRing Y m))
    (B := SheafOfModules.unit (wcEtZModRing Y m))
  set c := D.adj.unit.app (SheafOfModules.unit (wcEtZModRing Y m)) ≫
    (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange π) _ _ D.cont D.φ).map D.μ.hom
    with hc_def
  have hTh : ∀ x : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y m))
      (SheafOfModules.unit (wcEtZModRing Y m)) q,
      (Abelian.Ext.mk₀ (D.adj.unit.app (SheafOfModules.unit (wcEtZModRing Y m)))).comp
        (Abelian.Ext.mapExactFunctor
          (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange π) _ _ D.cont D.φ)
          ((Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero q)))
        (zero_add q)
        = x.comp (Abelian.Ext.mk₀ c) (add_zero q) := by
    intro x
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_assoc _ _ _ (zero_add q) (add_zero q) (by omega), ← h3 x,
      Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀]
  have hcbij : Function.Bijective (fun x : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y m))
      (SheafOfModules.unit (wcEtZModRing Y m)) q => x.comp (Abelian.Ext.mk₀ c) (add_zero q)) := by
    refine Function.bijective_iff_has_inverse.mpr
      ⟨fun z => z.comp (Abelian.Ext.mk₀ (inv c)) (add_zero q), ?_, ?_⟩
    · intro x
      simp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, IsIso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    · intro x
      simp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, IsIso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
  have hh : Function.Bijective (fun x : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y m))
      (SheafOfModules.unit (wcEtZModRing Y m)) q =>
      (Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero q)) := by
    have hcomp : (fun z : Abelian.Ext (D.Φ.obj (SheafOfModules.unit (wcEtZModRing Y m)))
        (SheafOfModules.unit (wcEtZModRing P m)) q =>
        (Abelian.Ext.mk₀ (D.adj.unit.app (SheafOfModules.unit (wcEtZModRing Y m)))).comp
          (Abelian.Ext.mapExactFunctor
            (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange π) _ _ D.cont D.φ) z)
          (zero_add q)) ∘
        (fun x : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y m))
          (SheafOfModules.unit (wcEtZModRing Y m)) q =>
          (Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero q)) =
        (fun x : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y m))
          (SheafOfModules.unit (wcEtZModRing Y m)) q => x.comp (Abelian.Ext.mk₀ c) (add_zero q)) := by
      funext x
      exact hTh x
    rw [← hcomp] at hcbij
    exact (Function.Bijective.of_comp_iff' hT _).mp hcbij
  have hpre : Function.Bijective (fun z : Abelian.Ext (D.Φ.obj (SheafOfModules.unit (wcEtZModRing Y m)))
      (SheafOfModules.unit (wcEtZModRing P m)) q =>
      (Abelian.Ext.mk₀ D.μ.inv).comp z (zero_add q)) := by
    refine Function.bijective_iff_has_inverse.mpr
      ⟨fun w => (Abelian.Ext.mk₀ D.μ.hom).comp w (zero_add q), ?_, ?_⟩
    · intro z
      simp only [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    · intro z
