    exact ext_transfer_of_hom_bijective LΛ (SheafOfModules.toSheaf.{u+1} (wcIntSliceRing F X h ℓ)) adjΛ
      Z (SheafOfModules.unit (wcIntSliceRing F X h ℓ)) εΛ HΛ
      ((SheafOfModules.restrictScalars (wcIntRatSliceMap F X h ℓ)).obj
        (SheafOfModules.unit (wcSliceRing F X h ℓ))) n
  have hBRb : ∀ n, Function.Bijective (BRm n) := by
