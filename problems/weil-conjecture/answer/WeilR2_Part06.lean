    exact (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).symm
  have K2 : ∀ n a, BB n (Ψ n a) = (BA n a).comp (Abelian.Ext.mk₀
      ((SheafOfModules.toSheaf.{u+1} (wcIntSliceRing F X h ℓ)).map
        (wcUnitRestrict (wcIntRatSliceMap F X h ℓ)))) (add_zero n) := by
    intro n a
    rw [hBB, hΨ, hBA, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
    exact (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).symm
  have hcomp : ∀ n a, (BB n (Ψ n a)).comp (Abelian.Ext.mk₀ ιQ'.hom) (add_zero n) =
      ((BA n a).comp (Abelian.Ext.mk₀ ιZ.hom) (add_zero n)).comp (Abelian.Ext.mk₀
        (((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1}
          (wcGeomPoint F X h)).map (wcIntToLadic X.left ℓ))) (add_zero n) := by
    intro n a
    rw [K2, Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.comp_assoc_of_third_deg_zero,
      Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, hι']
  have hcancelQ : ∀ n (u v : Abelian.Ext Z ((SheafOfModules.toSheaf.{u+1} (wcIntSliceRing F X h ℓ)).obj
        ((SheafOfModules.restrictScalars (wcIntRatSliceMap F X h ℓ)).obj
          (SheafOfModules.unit (wcSliceRing F X h ℓ)))) n),
      u.comp (Abelian.Ext.mk₀ ιQ'.hom) (add_zero n) = v.comp (Abelian.Ext.mk₀ ιQ'.hom) (add_zero n) →
        u = v := by
    intro n u v huv
    have := congrArg (fun w => w.comp (Abelian.Ext.mk₀ ιQ'.inv) (add_zero n)) huv
    simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
      Abelian.Ext.comp_mk₀_id] at this
    exact this
  have hcancelZ : ∀ n (u v : Abelian.Ext Z ((SheafOfModules.toSheaf.{u+1} (wcIntSliceRing F X h ℓ)).obj
        (SheafOfModules.unit (wcIntSliceRing F X h ℓ))) n),
      u.comp (Abelian.Ext.mk₀ ιZ.hom) (add_zero n) = v.comp (Abelian.Ext.mk₀ ιZ.hom) (add_zero n) →
        u = v := by
    intro n u v huv
    have := congrArg (fun w => w.comp (Abelian.Ext.mk₀ ιZ.inv) (add_zero n)) huv
    simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
      Abelian.Ext.comp_mk₀_id] at this
    exact this
  refine ⟨ι, ?_, ?_, ?_⟩
  ·
    intro i j k hk a b
    apply (hΦb k).1
    have e1 : wcModCup F X h ℓ i j k hk (ι i a) (ι j b) = (ι i a).comp (ι j b) hk := rfl
    have e2 : wcIntModCup F X h ℓ i j k hk a b = a.comp b hk := rfl
    have s1 : Φ k ((ι i a).comp (ι j b) hk) = (Φ i (ι i a)).comp (Abelian.Ext.mapExactFunctor
        (wcIntRatRestrict F X h ℓ) (ι j b)) hk := by
      rw [hΦ, hΦ, Abelian.Ext.mapExactFunctor_comp]
      exact (Abelian.Ext.comp_assoc _ _ _ (zero_add i) hk (by omega)).symm
    have s2 : (Ψ i a).comp (Abelian.Ext.mapExactFunctor
        (wcIntRatRestrict F X h ℓ) (ι j b)) hk =
        a.comp (Φ j (ι j b)) hk := by
      rw [hΨ, hΦ]
      exact Abelian.Ext.comp_assoc _ _ _ (add_zero i) (zero_add j) (by omega)
    have s3 : a.comp (Ψ j b) hk = Ψ k (a.comp b hk) := by
      rw [hΨ, hΨ]
      exact (Abelian.Ext.comp_assoc _ _ _ hk (add_zero j) (by omega)).symm
    rw [hΦι, e1, e2, s1, hΦι, s2, hΦι, s3]
  ·
    intro n x
    obtain ⟨q, hq⟩ := (hAQb n).2 ((BB n (Φ n x)).comp (Abelian.Ext.mk₀ ιQ'.hom) (add_zero n))
    obtain ⟨k, y, hy⟩ := (proet_qcqs_ladic_rationalization X.left (wcGeomPoint F X h) ℓ n).1 q
    obtain ⟨a, ha⟩ := (hBAb n).2 ((AZ n y).comp (Abelian.Ext.mk₀ ιZ.inv) (add_zero n))
    refine ⟨k, a, ?_⟩
    have hBAZ : (BA n a).comp (Abelian.Ext.mk₀ ιZ.hom) (add_zero n) = AZ n y := by
      rw [ha, Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
        Abelian.Ext.comp_mk₀_id]
    have e3 : (ℓ ^ k • BB n (Φ n x)).comp (Abelian.Ext.mk₀ ιQ'.hom) (add_zero n) =
        ℓ ^ k • (BB n (Φ n x)).comp (Abelian.Ext.mk₀ ιQ'.hom) (add_zero n) :=
      map_nsmul ((Abelian.Ext.mk₀ ιQ'.hom).postcomp Z (add_zero n)) (ℓ ^ k) (BB n (Φ n x))
    apply (hΦb n).1
    rw [hΦι, map_nsmul]
    apply (hBBb n).1
    rw [map_nsmul]
    apply hcancelQ
    rw [hcomp, hBAZ, ← K1, ← hy, map_nsmul, hq, e3]
  ·
    intro n a ha0
    have hΨ0 : Ψ n a = 0 := by rw [← hΦι, ha0, map_zero]
    obtain ⟨y, hy⟩ := (hAZb n).2 ((BA n a).comp (Abelian.Ext.mk₀ ιZ.hom) (add_zero n))
    have hyf : y.comp (Abelian.Ext.mk₀ (wcIntToLadic X.left ℓ)) (add_zero n) = 0 := by
      apply (hAQb n).1
      rw [K1, hy, ← hcomp, hΨ0]
      simp only [map_zero, Abelian.Ext.zero_comp]
    obtain ⟨r, hr⟩ := (proet_qcqs_ladic_rationalization X.left (wcGeomPoint F X h) ℓ n).2 y hyf
    refine ⟨r, ?_⟩
    have e4 : (ℓ ^ r • BA n a).comp (Abelian.Ext.mk₀ ιZ.hom) (add_zero n) =
        ℓ ^ r • (BA n a).comp (Abelian.Ext.mk₀ ιZ.hom) (add_zero n) :=
      map_nsmul ((Abelian.Ext.mk₀ ιZ.hom).postcomp Z (add_zero n)) (ℓ ^ r) (BA n a)
    apply (hBAb n).1
    apply hcancelZ
    rw [map_nsmul, e4, ← hy, ← map_nsmul, hr]
    simp only [map_zero, Abelian.Ext.zero_comp]

theorem wc_proet_free_slice_ext_equiv : ∀ (S : Scheme.{u}) (U : S.ProEt)
    (Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (n : ℕ),
    letI : HasExt (Sheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}) := HasExt.standard _
    Nonempty (Abelian.Ext (wcFreeSheaf S U) Y n ≃+
      Abelian.Ext ((presheafToSheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}).obj
          (yoneda.obj (Over.mk (𝟙 U)) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
        (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj Y) n) :=
by

  have wc_over_costructuredArrow_final : ∀ (S : Scheme.{u}) (U W : S.ProEt),
      ∃ (I : Type u)
        (D : Discrete I ⥤ CostructuredArrow (Over.forget U).op (Opposite.op W)),
        D.Final := by
    intro S U W
    obtain ⟨D, hD⟩ : ∃ D : Discrete (W ⟶ U) ⥤
        CostructuredArrow (Over.forget U).op (Opposite.op W),
        ∀ f, D.obj ⟨f⟩ = CostructuredArrow.mk (Y := Opposite.op (Over.mk f)) (𝟙 W).op :=
      ⟨Discrete.functor (fun f => CostructuredArrow.mk (Y := Opposite.op (Over.mk f)) (𝟙 W).op),
        fun f => rfl⟩
    have key : ∀ (c : CostructuredArrow (Over.forget U).op (Opposite.op W)) (f : W ⟶ U)
        (k : c.left ⟶ Opposite.op (Over.mk f))
        (hk : (Over.forget U).op.map k ≫ (𝟙 W).op = c.hom),
        (Quiver.Hom.unop k).left = Quiver.Hom.unop c.hom ∧
          f = Quiver.Hom.unop c.hom ≫ c.left.unop.hom := by
      intro c f k hk
      have h0 : 𝟙 W ≫ (Quiver.Hom.unop k).left = Quiver.Hom.unop c.hom :=
        congrArg Quiver.Hom.unop hk
      have h1 : (Quiver.Hom.unop k).left = Quiver.Hom.unop c.hom :=
        (Category.id_comp _).symm.trans h0
      refine ⟨h1, ?_⟩
      have hw : (Quiver.Hom.unop k).left ≫ c.left.unop.hom = (Over.mk f).hom :=
        Over.w (Quiver.Hom.unop k)
      exact hw.symm.trans (congrArg (· ≫ c.left.unop.hom) h1)
    refine ⟨W ⟶ U, D, Functor.Final.mk (fun c => ?_)⟩
    have hext : ∀ (f : W ⟶ U) (h h' : c ⟶ D.obj ⟨f⟩), h = h' := by
      intro f h h'
      refine (cancel_mono (eqToHom (hD f))).1 ?_
      apply CostructuredArrow.hom_ext
      apply Quiver.Hom.unop_inj
      apply Over.OverMorphism.ext
      exact (key c f (h ≫ eqToHom (hD f)).left (CostructuredArrow.w _)).1.trans
        (key c f (h' ≫ eqToHom (hD f)).left (CostructuredArrow.w _)).1.symm
    obtain ⟨fc, hfc⟩ : ∃ fc : W ⟶ U, fc = Quiver.Hom.unop c.hom ≫ c.left.unop.hom :=
      ⟨_, rfl⟩
    obtain ⟨κc, hκc⟩ : ∃ κc : Over.mk fc ⟶ c.left.unop,
        κc.left = Quiver.Hom.unop c.hom :=
      ⟨Over.homMk (Quiver.Hom.unop c.hom) hfc.symm, rfl⟩
    have hw : (Over.forget U).op.map κc.op ≫ (𝟙 W).op = c.hom := by
      apply Quiver.Hom.unop_inj
      exact (Category.id_comp _).trans hκc
    let φc : c ⟶ D.obj ⟨fc⟩ :=
      CostructuredArrow.homMk (f := c)
        (f' := CostructuredArrow.mk (Y := Opposite.op (Over.mk fc)) (𝟙 W).op)
        κc.op hw ≫ eqToHom (hD fc).symm
    have hto : ∀ s : StructuredArrow c D, s.right.as = fc := fun s =>
      (key c s.right.as (s.hom ≫ eqToHom (hD s.right.as)).left
        (CostructuredArrow.w _)).2.trans hfc.symm
    let tc : StructuredArrow c D := StructuredArrow.mk (Y := ⟨fc⟩) φc
    exact isConnected_of_isTerminal _ (Limits.IsTerminal.ofUniqueHom (X := tc)
      (fun s => StructuredArrow.homMk (Discrete.eqToHom (hto s)) (hext _ _ _))
      (fun s m => StructuredArrow.ext _ _ (Subsingleton.elim _ _)))

  have wc_lan_eval_iso : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (L : C ⥤ D)
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F] (Y : D),
      Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
          (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim) := by
    intro C D _ _ L _ _ Y
    refine ⟨NatIso.ofComponents (fun F => L.leftKanExtensionObjIsoColimit F Y) ?_⟩
    intro F₁ F₂ φ
    have hnat : ∀ j : CostructuredArrow L Y,
        (L.leftKanExtension F₁).map j.hom ≫ (L.lan.map φ).app Y =
        (L.lan.map φ).app (L.obj j.left) ≫ (L.leftKanExtension F₂).map j.hom :=
      fun j => (L.lan.map φ).naturality j.hom
    have hfac : ∀ j : CostructuredArrow L Y,
        (L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left) =
        φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left := fun j =>
      Functor.descOfIsLeftKanExtension_fac_app (L.leftKanExtension F₁)
        (L.leftKanExtensionUnit F₁) (L.leftKanExtension F₂) (φ ≫ L.leftKanExtensionUnit F₂) j.left
    refine (Iso.inv_comp_eq _).1 ?_
    apply Limits.colimit.hom_ext
    intro j
    have key : (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
        (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom =
        φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
      calc (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
            (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom
          = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.leftKanExtension F₁).map j.hom ≫
            (L.lan.map φ).app Y) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _).symm
        _ = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.lan.map φ).app (L.obj j.left) ≫
            (L.leftKanExtension F₂).map j.hom) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg (fun k => (L.leftKanExtensionUnit F₁).app j.left ≫ k ≫
              (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hnat j)
        _ = ((L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left)) ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            (congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _)).trans
              (Category.assoc _ _ _).symm
        _ = (φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left) ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg (· ≫ (L.leftKanExtension F₂).map j.hom ≫
              (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hfac j)
        _ = φ.app j.left ≫ ((L.leftKanExtensionUnit F₂).app j.left ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom) :=
            Category.assoc _ _ _
        _ = φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
            congrArg (φ.app j.left ≫ ·) (Functor.ι_leftKanExtensionObjIsoColimit_hom L F₂ Y j)
    erw [Functor.ι_leftKanExtensionObjIsoColimit_inv_assoc, Limits.ι_colimMap]
    exact key

  have wc_lan_preservesFiniteLimits_of_discrete_final : ∀ {C D : Type (u+1)} [Category.{u} C]
      [Category.{u} D] (L : C ⥤ D)
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F],
      (∀ Y : D, Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
          (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim)) →
      (∀ Y : D, ∃ (I : Type u) (G : Discrete I ⥤ CostructuredArrow L Y), G.Final) →
      Limits.PreservesFiniteLimits
        (L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) := by
    intro C D _ _ L _ _ hiso hfin
    constructor
    intro J _ _
    apply Limits.preservesLimitsOfShape_of_evaluation
    intro Y
    obtain ⟨θ⟩ := hiso Y
    obtain ⟨I, G, hG⟩ := hfin Y
    haveI : HasExactColimitsOfShape (Discrete I) AddCommGrpCat.{u+1} :=
      HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1}
        (Discrete.equivalence (Equiv.ulift : ULift.{u+1} I ≃ I))
    let e2 : (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
        ((Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj G ⋙ Limits.colim) ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim :=
      Functor.isoWhiskerLeft _ (Functor.Final.colimIso G)
    exact Limits.preservesLimitsOfShape_of_natIso (e2 ≪≫ θ.symm)

  have wc_leftAdjoint_freeYoneda_iso : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D]
      (J : GrothendieckTopology C) (K : GrothendieckTopology D)
      [HasWeakSheafify J AddCommGrpCat.{u+1}] [HasWeakSheafify K AddCommGrpCat.{u+1}]
      (Φ : C ⥤ D) [Φ.IsContinuous J K]
      (L : Sheaf J AddCommGrpCat.{u+1} ⥤ Sheaf K AddCommGrpCat.{u+1})
      (adj : L ⊣ Φ.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K) (X : C),
      Nonempty (L.obj ((presheafToSheaf J AddCommGrpCat.{u+1}).obj
          (yoneda.obj X ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≅
        (presheafToSheaf K AddCommGrpCat.{u+1}).obj
          (yoneda.obj (Φ.obj X) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) := by
    intro C D _ _ J K _ _ Φ _ L adj X
    have rep : ∀ {E : Type (u+1)} [Category.{u} E] (J' : GrothendieckTopology E)
        [HasWeakSheafify J' AddCommGrpCat.{u+1}] (Y : E),
        (sheafToPresheaf J' AddCommGrpCat.{u+1} ⋙ (evaluation Eᵒᵖ AddCommGrpCat.{u+1}).obj
          (Opposite.op Y) ⋙ forget AddCommGrpCat.{u+1}).CorepresentableBy
          ((presheafToSheaf J' AddCommGrpCat.{u+1}).obj
            (yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) := by
      intro E _ J' _ Y
      exact
        { homEquiv := fun {G} =>
            ((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv _ G).trans
              (((Adjunction.whiskerRight Eᵒᵖ AddCommGrpCat.adj).homEquiv
                (yoneda.obj Y ⋙ uliftFunctor.{u+1, u}) _).trans uliftYonedaEquiv)
          homEquiv_comp := fun {G G'} f g => by
            simp only [Equiv.trans_apply, Adjunction.homEquiv_naturality_right]
            rfl }
    have r1 := rep J X
    have r2 := rep K (Φ.obj X)
    let r3 : (sheafToPresheaf K AddCommGrpCat.{u+1} ⋙ (evaluation Dᵒᵖ AddCommGrpCat.{u+1}).obj
          (Opposite.op (Φ.obj X)) ⋙ forget AddCommGrpCat.{u+1}).CorepresentableBy
          (L.obj ((presheafToSheaf J AddCommGrpCat.{u+1}).obj
            (yoneda.obj X ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) :=
      { homEquiv := fun {G} => (adj.homEquiv _ G).trans r1.homEquiv
        homEquiv_comp := fun {G G'} f g => by
          show r1.homEquiv (adj.homEquiv _ G' (g ≫ f)) = _
          rw [Adjunction.homEquiv_naturality_right, r1.homEquiv_comp]
          rfl }
    exact ⟨r3.uniqueUpToIso r2⟩
  intro S U Y n
  letI : HasExt (Sheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}) := HasExt.standard _

  haveI hlan : Limits.PreservesFiniteLimits ((Over.forget U).op.lan :
      ((Over U)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) ⥤ ((S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})) :=
    wc_lan_preservesFiniteLimits_of_discrete_final (Over.forget U).op
      (fun V => wc_lan_eval_iso (Over.forget U).op V)
      (fun V => wc_over_costructuredArrow_final S U V.unop)

  let G := (Over.forget U).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        ((Scheme.ProEt.topology S).over U) (Scheme.ProEt.topology S)
  let F := (Over.forget U).sheafPullback AddCommGrpCat.{u+1}
        ((Scheme.ProEt.topology S).over U) (Scheme.ProEt.topology S)
  let adj : F ⊣ G := (Over.forget U).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
        ((Scheme.ProEt.topology S).over U) (Scheme.ProEt.topology S)
  let adj2 := (Over.forget U).sheafAdjunctionCocontinuous AddCommGrpCat.{u+1}
        ((Scheme.ProEt.topology S).over U) (Scheme.ProEt.topology S)
  haveI : Limits.PreservesColimitsOfSize.{0, 0} F := adj.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits F :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits F
  haveI : Limits.PreservesColimitsOfSize.{0, 0} G := adj2.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits G :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits G
  haveI : G.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isRightAdjoint G
  haveI : G.Additive := Functor.additive_of_preserves_binary_products G
  haveI : F.Additive := adj.left_adjoint_additive
  let Z := (presheafToSheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}).obj
    (yoneda.obj (Over.mk (𝟙 U)) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
  let E₁ : Abelian.Ext (F.obj Z) Y n ≃+ Abelian.Ext Z (G.obj Y) n :=
    adj.extEquiv (X := Z) (Y := Y) (n := n)

  obtain ⟨e⟩ := wc_leftAdjoint_freeYoneda_iso ((Scheme.ProEt.topology S).over U)
    (Scheme.ProEt.topology S) (Over.forget U) F adj (Over.mk (𝟙 U))
  let e' : F.obj Z ≅ wcFreeSheaf S U := e

  let E₀ : Abelian.Ext (wcFreeSheaf S U) Y n ≃+ Abelian.Ext (F.obj Z) Y n :=
    { toFun := fun x => (Abelian.Ext.mk₀ e'.hom).comp x (zero_add n)
      invFun := fun y => (Abelian.Ext.mk₀ e'.inv).comp y (zero_add n)
      left_inv := fun x => by
        simp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add n) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
      right_inv := fun y => by
        simp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add n) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
      map_add' := fun x y => Abelian.Ext.comp_add _ x y (zero_add n) }
  exact ⟨E₀.trans E₁⟩

theorem wc_intslice_modext_equiv : ∀ (F : Type u) [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (n : ℕ),
    letI : HasExt (Sheaf ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h)) AddCommGrpCat.{u+1}) :=
      HasExt.standard _
    Nonempty (wcIntModCoh F X h ℓ n ≃+
      Abelian.Ext ((presheafToSheaf ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h))
            AddCommGrpCat.{u+1}).obj
          (yoneda.obj (Over.mk (𝟙 (wcGeomPoint F X h))) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
        ((SheafOfModules.toSheaf (wcIntSliceRing F X h ℓ)).obj
          (SheafOfModules.unit (wcIntSliceRing F X h ℓ))) n) :=
by
  intro F _ X h ℓ _ n
  classical
  letI hD : HasExt (Sheaf ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h))
      AddCommGrpCat.{u+1}) := HasExt.standard _
  letI hM : HasExt (SheafOfModules.{u+1} (wcIntSliceRing F X h ℓ)) := HasExt.standard _

  have hΛ : ∀ (V : (Over (wcGeomPoint F X h))ᵒᵖ) (m : ℤ) (r : ↑((wcIntSliceRing F X h ℓ).obj.obj V)),
      m ≠ 0 → (m : ↑((wcIntSliceRing F X h ℓ).obj.obj V)) * r = 0 → r = 0 := by
    intro V m r hm hr
    change C(↥((Opposite.unop V).left.left), ULift.{u+1} ℤ_[ℓ]) at r
    change (m : C(↥((Opposite.unop V).left.left), ULift.{u+1} ℤ_[ℓ])) * r = 0 at hr
    have hm' : (m : ℤ_[ℓ]) ≠ 0 := Int.cast_ne_zero.mpr hm
    refine ContinuousMap.ext fun t => ULift.ext _ _ ?_
    have h1 : (m : ℤ_[ℓ]) * (r t).down = 0 := by
      first
        | exact congrArg (fun g : C(↥((Opposite.unop V).left.left), ULift.{u+1} ℤ_[ℓ]) => (g t).down) hr
        | simpa using congrArg (fun g : C(↥((Opposite.unop V).left.left), ULift.{u+1} ℤ_[ℓ]) =>
            (g t).down) hr
    exact (mul_eq_zero.mp h1).resolve_left hm'
  obtain ⟨T, adjT, hmono⟩ := presheafOfModules_tensorInt_leftAdjoint_mono
    (wcIntSliceRing F X h ℓ).obj hΛ
  obtain ⟨L, adj, hLA, hLL, hLC⟩ := sheafOfModules_toSheaf_exactLeftAdjoint_of_presheaf
    ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h)) (wcIntSliceRing F X h ℓ) T adjT hmono
  haveI := hLA
  haveI := hLL
  haveI := hLC
  haveI hGC := sheafOfModules_toSheaf_preservesFiniteColimits
    ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h)) (wcIntSliceRing F X h ℓ)
  obtain ⟨ε, hε⟩ := sheafOfModules_unit_corepresented_by_free_terminal
    ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h)) (wcIntSliceRing F X h ℓ)
    (Over.mk (𝟙 (wcGeomPoint F X h))) Over.mkIdTerminal
  have hbij := ext_transfer_of_hom_bijective L (SheafOfModules.toSheaf.{u+1} (wcIntSliceRing F X h ℓ))
    adj _ (SheafOfModules.unit (wcIntSliceRing F X h ℓ)) ε hε
    (SheafOfModules.unit (wcIntSliceRing F X h ℓ)) n
  let Bm : wcIntModCoh F X h ℓ n →+ Abelian.Ext ((presheafToSheaf ((Scheme.ProEt.topology X.left).over
        (wcGeomPoint F X h)) AddCommGrpCat.{u+1}).obj
        (yoneda.obj (Over.mk (𝟙 (wcGeomPoint F X h))) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
      ((SheafOfModules.toSheaf (wcIntSliceRing F X h ℓ)).obj
        (SheafOfModules.unit (wcIntSliceRing F X h ℓ))) n :=
    AddMonoidHom.mk' (fun β => (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor
        (SheafOfModules.toSheaf.{u+1} (wcIntSliceRing F X h ℓ)) β) (zero_add n))
      (fun a b => by rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.comp_add])
  exact ⟨AddEquiv.ofBijective Bm hbij⟩

theorem wc_intslice_unit_iso : ∀ (F : Type u) [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)],
    Nonempty ((SheafOfModules.toSheaf (wcIntSliceRing F X h ℓ)).obj
        (SheafOfModules.unit (wcIntSliceRing F X h ℓ)) ≅
      ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)).obj
        (wcIntSheaf X.left ℓ)) :=
by
  intro F _ X h ℓ _
  let e : ∀ V : (Over (wcGeomPoint F X h))ᵒᵖ,
      C(↥V.unop.left.left, ULift.{u+1} ℤ_[ℓ]) ≃+ ULift.{u+1} C(↥V.unop.left.left, ℤ_[ℓ]) :=
    fun V =>
      { toFun := fun r => ULift.up ⟨fun t => (r t).down, continuous_uliftDown.comp r.continuous⟩
        invFun := fun w => ⟨fun t => ULift.up (w.down t), continuous_uliftUp.comp w.down.continuous⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        map_add' := fun _ _ => rfl }
  let φ : ∀ V : (Over (wcGeomPoint F X h))ᵒᵖ,
      ((SheafOfModules.toSheaf (wcIntSliceRing F X h ℓ)).obj
        (SheafOfModules.unit (wcIntSliceRing F X h ℓ))).obj.obj V ≅
      (((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)).obj
        (wcIntSheaf X.left ℓ)).obj.obj V :=
    fun V => (e V).toAddCommGrpIso
  refine ⟨(fullyFaithfulSheafToPresheaf _ _).preimageIso (NatIso.ofComponents φ ?_)⟩
  intro V W f
  ext r
  rfl

theorem wc_intmodcoh_fg (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (n : ℕ) : ∃ _ : Module ℤ_[ℓ] (wcIntModCoh F X h ℓ n), Module.Finite ℤ_[ℓ] (wcIntModCoh F X h ℓ n) :=
by
  classical
  obtain ⟨hs1, hsmul, hsadd, -⟩ := wc_int_scalar_ring X.left ℓ

  let M := Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) (wcIntSheaf X.left ℓ) n
  letI smulM : SMul ℤ_[ℓ] M :=
    ⟨fun a m => m.comp (Abelian.Ext.mk₀ (wcIntScalar X.left ℓ a)) (add_zero n)⟩
  have A1 : ∀ x : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) (wcIntSheaf X.left ℓ) n,
      x.comp (Abelian.Ext.mk₀ (wcIntScalar X.left ℓ 1)) (add_zero n) = x := by
    intro x
    rw [hs1, Abelian.Ext.comp_mk₀_id]
  have Amul : ∀ (a b : ℤ_[ℓ])
      (x : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) (wcIntSheaf X.left ℓ) n),
      x.comp (Abelian.Ext.mk₀ (wcIntScalar X.left ℓ (a * b))) (add_zero n) =
        (x.comp (Abelian.Ext.mk₀ (wcIntScalar X.left ℓ b)) (add_zero n)).comp
          (Abelian.Ext.mk₀ (wcIntScalar X.left ℓ a)) (add_zero n) := by
    intro a b x
    rw [hsmul, ← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc _ _ _ (add_zero n) (add_zero 0)
      (by omega)]
  have Aadd : ∀ (a b : ℤ_[ℓ])
      (x : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) (wcIntSheaf X.left ℓ) n),
      x.comp (Abelian.Ext.mk₀ (wcIntScalar X.left ℓ (a + b))) (add_zero n) =
        x.comp (Abelian.Ext.mk₀ (wcIntScalar X.left ℓ a)) (add_zero n) +
          x.comp (Abelian.Ext.mk₀ (wcIntScalar X.left ℓ b)) (add_zero n) := by
    intro a b x
    rw [hsadd, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add]
  letI modM : Module ℤ_[ℓ] M := Module.ofMinimalAxioms
    (fun a x y => Abelian.Ext.add_comp x y _ _)
    (fun a b x => Aadd a b x)
    (fun a b x => Amul a b x)
    (fun x => A1 x)

  haveI hmono : Mono (wcIntScalar X.left ℓ (ℓ : ℤ_[ℓ])) := wc_int_scalar_ell_mono X.left ℓ
  haveI hfin := wc_coh_mod_ell_finite F X d ℓ hℓ h n
  have hT : ∃ T : Finset M, ∀ m : M, ∃ t ∈ T, ∃ m' : M, m = t + (ℓ : ℤ_[ℓ]) • m' := by
    let f := wcIntScalar X.left ℓ (ℓ : ℤ_[ℓ])
    let S : ShortComplex (Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}) :=
      ShortComplex.mk f (Limits.cokernel.π f) (Limits.cokernel.condition f)
    have hS : S.ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel f) hmono inferInstance
    let β : M → Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) (Limits.cokernel f) n :=
      fun m => m.comp (Abelian.Ext.mk₀ (Limits.cokernel.π f)) (add_zero n)
    have hfr : (Set.range β).Finite := Set.toFinite _
    let pre : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) (Limits.cokernel f) n → M :=
      fun y => if hy : ∃ m, β m = y then hy.choose else 0
    refine ⟨hfr.toFinset.image pre, fun m => ?_⟩
    refine ⟨pre (β m), Finset.mem_image_of_mem _ (hfr.mem_toFinset.mpr ⟨m, rfl⟩), ?_⟩
    have hpre : β (pre (β m)) = β m := by
      have hy : ∃ m', β m' = β m := ⟨m, rfl⟩
      simp only [pre, dif_pos hy]
      exact hy.choose_spec
    have hsub := map_sub ((Abelian.Ext.mk₀ (Limits.cokernel.π f)).postcomp
      (wcFreeSheaf X.left (wcGeomPoint F X h)) (add_zero n)) m (pre (β m))
    have h0 : (m - pre (β m)).comp (Abelian.Ext.mk₀ S.g) (add_zero n) = 0 := by
      change ((Abelian.Ext.mk₀ (Limits.cokernel.π f)).postcomp
        (wcFreeSheaf X.left (wcGeomPoint F X h)) (add_zero n)) (m - pre (β m)) = 0
      rw [hsub]
      exact sub_eq_zero.mpr hpre.symm
    obtain ⟨m', hm'⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hS (m - pre (β m)) h0
    refine ⟨m', ?_⟩
    change m = pre (β m) + m'.comp (Abelian.Ext.mk₀ S.f) (add_zero n)
    rw [hm']
    abel

  have hD : ∀ w : ℕ → M, (∀ k, w k = (ℓ : ℤ_[ℓ]) • w (k + 1)) → w 0 = 0 := by
    intro w hw
    have hpow : ∀ k : ℕ, w 0 = ((ℓ : ℤ_[ℓ]) ^ k) • w k := by
      intro k
      induction k with
      | zero => rw [pow_zero, one_smul]
      | succ k ih => rw [ih, hw k, ← mul_smul, ← pow_succ]
    apply wc_int_coh_separated F X d ℓ hℓ h n (w 0)
    intro k
    rw [hpow k]
    change ((w k).comp (Abelian.Ext.mk₀ (wcIntScalar X.left ℓ ((ℓ : ℤ_[ℓ]) ^ k))) (add_zero n)).comp
      (Abelian.Ext.mk₀ (Limits.cokernel.π (wcIntScalar X.left ℓ ((ℓ : ℤ_[ℓ]) ^ k)))) (add_zero n) = 0
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero n) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, Limits.cokernel.condition, Abelian.Ext.mk₀_zero,
      Abelian.Ext.comp_zero]

  haveI hMfin : Module.Finite ℤ_[ℓ] M := padic_fg_of_mod_ell_reps ℓ M hT hD

  letI : HasExt (Sheaf ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h))
      AddCommGrpCat.{u+1}) := HasExt.standard _
  obtain ⟨e₁⟩ := wc_proet_free_slice_ext_equiv X.left (wcGeomPoint F X h) (wcIntSheaf X.left ℓ) n
  obtain ⟨ι⟩ := wc_intslice_unit_iso F X h ℓ
  obtain ⟨e₂⟩ := wc_intslice_modext_equiv F X h ℓ n
  let e₃ : Abelian.Ext ((presheafToSheaf ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h))
          AddCommGrpCat.{u+1}).obj
        (yoneda.obj (Over.mk (𝟙 (wcGeomPoint F X h))) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
      (((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)).obj
        (wcIntSheaf X.left ℓ)) n ≃+
    Abelian.Ext ((presheafToSheaf ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h))
          AddCommGrpCat.{u+1}).obj
        (yoneda.obj (Over.mk (𝟙 (wcGeomPoint F X h))) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
      ((SheafOfModules.toSheaf (wcIntSliceRing F X h ℓ)).obj
        (SheafOfModules.unit (wcIntSliceRing F X h ℓ))) n :=
    { toFun := fun z => z.comp (Abelian.Ext.mk₀ ι.inv) (add_zero n)
      invFun := fun w => w.comp (Abelian.Ext.mk₀ ι.hom) (add_zero n)
      left_inv := fun z => by
        change (z.comp (Abelian.Ext.mk₀ ι.inv) (add_zero n)).comp (Abelian.Ext.mk₀ ι.hom)
          (add_zero n) = z
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero n) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
      right_inv := fun w => by
        change (w.comp (Abelian.Ext.mk₀ ι.hom) (add_zero n)).comp (Abelian.Ext.mk₀ ι.inv)
          (add_zero n) = w
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero n) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
      map_add' := fun x y => Abelian.Ext.add_comp x y _ _ }
  let e : M ≃+ wcIntModCoh F X h ℓ n := e₁.trans (e₃.trans e₂.symm)

  letI smulA : SMul ℤ_[ℓ] (wcIntModCoh F X h ℓ n) := ⟨fun c z => e (c • e.symm z)⟩
  letI modA : Module ℤ_[ℓ] (wcIntModCoh F X h ℓ n) :=
    Function.Injective.module ℤ_[ℓ] e.symm.toAddMonoidHom e.symm.injective
      (fun c z => e.symm_apply_apply (c • e.symm z))
  let L : M ≃ₗ[ℤ_[ℓ]] wcIntModCoh F X h ℓ n := e.toLinearEquiv (fun c x => by
    show e (c • x) = e (c • e.symm (e x))
    rw [e.symm_apply_apply])
  exact ⟨modA, Module.Finite.equiv L⟩

theorem padic_fg_torsion_primitive (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (M : Type*) [AddCommGroup M]
    [Module ℤ_[ℓ] M] [Module.Finite ℤ_[ℓ] M] :
    (∃ e : ℕ, ∀ a : M, (∃ r : ℕ, ℓ ^ r • a = 0) → ℓ ^ e • a = 0) ∧
    (∀ a : M, (∀ r : ℕ, ℓ ^ r • a ≠ 0) → ∃ (s : ℕ) (a₀ τ : M), a = ℓ ^ s • a₀ + τ ∧
      (∃ r : ℕ, ℓ ^ r • τ = 0) ∧ ∀ (m : ℕ) (z : M), ℓ ^ m • a₀ ≠ ℓ ^ (m + 1) • z) :=
by
  classical
  have : IsNoetherian ℤ_[ℓ] M := isNoetherian_of_isNoetherianRing_of_finite ℤ_[ℓ] M
  have hcast : ∀ (k : ℕ) (x : M), ℓ ^ k • x = ((ℓ : ℤ_[ℓ]) ^ k) • x := by
    intro k x; rw [← Nat.cast_pow, Nat.cast_smul_eq_nsmul]
  have hK : ∀ (r : ℕ) (x : M),
      x ∈ LinearMap.ker (LinearMap.lsmul ℤ_[ℓ] M ((ℓ : ℤ_[ℓ]) ^ r)) ↔ ℓ ^ r • x = 0 := by
    intro r x
    rw [LinearMap.mem_ker, LinearMap.lsmul_apply, ← hcast]
  let K : ℕ →o Submodule ℤ_[ℓ] M :=
    { toFun := fun r => LinearMap.ker (LinearMap.lsmul ℤ_[ℓ] M ((ℓ : ℤ_[ℓ]) ^ r))
      monotone' := by
        intro r r' hrr' x hx
        obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hrr'
        rw [hK] at hx ⊢
        rw [pow_add, mul_comm, mul_smul, hx, smul_zero] }
  obtain ⟨n, hn⟩ := (monotone_stabilizes_iff_noetherian.mpr inferInstance) K
  have he : ∀ a : M, (∃ r : ℕ, ℓ ^ r • a = 0) → ℓ ^ n • a = 0 := by
    rintro a ⟨r, hr⟩
    have h1 : a ∈ K (max n r) := K.monotone (le_max_right n r) ((hK r a).mpr hr)
    rw [← hn _ (le_max_left n r)] at h1
    exact (hK n a).mp h1
  refine ⟨⟨n, he⟩, ?_⟩
  intro a ha
  let P : ℕ → Prop := fun k => ∃ y t : M, a = ℓ ^ k • y + t ∧ ∃ r : ℕ, ℓ ^ r • t = 0
  have hP0 : P 0 := ⟨a, 0, by simp, 0, by simp⟩
  have hex : ∃ k, ¬ P k := by
    by_contra hall
    push_neg at hall
    set I : Ideal ℤ_[ℓ] := Ideal.span {(ℓ : ℤ_[ℓ])} with hIdef
    have hI : I ≠ ⊤ := by
      rw [hIdef, ← PadicInt.maximalIdeal_eq_span_p]
      exact (IsLocalRing.maximalIdeal.isMaximal ℤ_[ℓ]).ne_top
    have hmem : ℓ ^ n • a ∈ ⨅ k : ℕ, I ^ k • (⊤ : Submodule ℤ_[ℓ] M) := by
      rw [Submodule.mem_iInf]
      intro k
      obtain ⟨y, t, hyt, r, hr⟩ := hall k
      have ht : ℓ ^ n • t = 0 := he t ⟨r, hr⟩
      have hrw : ℓ ^ n • a = ((ℓ : ℤ_[ℓ]) ^ k) • (ℓ ^ n • y) := by
        rw [hyt, smul_add, ht, add_zero, ← hcast, smul_smul, smul_smul, mul_comm]
      rw [hrw]
      exact Submodule.smul_mem_smul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self _) k)
        Submodule.mem_top
    rw [Ideal.iInf_pow_smul_eq_bot_of_isLocalRing I hI, Submodule.mem_bot] at hmem
    exact ha n hmem
  have hn0 : Nat.find hex ≠ 0 := by
    intro h0
    have := Nat.find_spec hex
    rw [h0] at this
    exact this hP0
  obtain ⟨s, hs⟩ : ∃ s, Nat.find hex = s + 1 := Nat.exists_eq_succ_of_ne_zero hn0
  have hPs : P s := not_not.mp (Nat.find_min hex (show s < Nat.find hex by omega))
  have hnPs1 : ¬ P (s + 1) := by
    have := Nat.find_spec hex
    rw [hs] at this
    exact this
  obtain ⟨a₀, τ, hdec, r₀, hr₀⟩ := hPs
  refine ⟨s, a₀, τ, hdec, ⟨r₀, hr₀⟩, ?_⟩
  intro m z hmz
  apply hnPs1
  have hw : ℓ ^ m • (a₀ - ℓ • z) = 0 := by
    rw [smul_sub, smul_smul, ← pow_succ, hmz, sub_self]
  refine ⟨z, ℓ ^ s • (a₀ - ℓ • z) + τ, ?_, m + r₀, ?_⟩
  · rw [hdec, smul_sub, pow_succ, mul_smul]
    abel
  · have h1 : ℓ ^ (m + r₀) • ℓ ^ s • (a₀ - ℓ • z) = ℓ ^ (r₀ + s) • (ℓ ^ m • (a₀ - ℓ • z)) := by
      rw [smul_smul, smul_smul]
      congr 1
      ring
    have h2 : ℓ ^ (m + r₀) • τ = ℓ ^ m • (ℓ ^ r₀ • τ) := by
      rw [smul_smul, ← pow_add]
    rw [smul_add, h1, h2, hw, hr₀, smul_zero, smul_zero, add_zero]

theorem wc_tormod_les (F : Type u) [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (m n : ℕ) :
    (∀ a : wcIntModCoh F X h ℓ n, wcTorRed F X h ℓ m n a = 0 →
      ∃ z : wcIntModCoh F X h ℓ n, a = ℓ ^ m • z) ∧
    (∀ (e : ℕ) (c : wcTorModCoh F X h ℓ m n),
      (∀ w : wcIntModCoh F X h ℓ (n + 1), ℓ ^ m • w = 0 → ℓ ^ e • w = 0) →
      ∃ y : wcIntModCoh F X h ℓ n, wcTorRed F X h ℓ m n y = ℓ ^ e • c) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcIntSliceRing F X h ℓ)) := HasExt.standard _

  have hmono : ∀ N : ℕ, N ≠ 0 →
      Mono (N • 𝟙 (SheafOfModules.unit (wcIntSliceRing F X h ℓ))) := by
    intro N hN
    have key : ∀ V : (Over (wcGeomPoint F X h))ᵒᵖ,
        ∀ t : C(↥((Opposite.unop V).left.left), ULift.{u+1} ℤ_[ℓ]), N • t = 0 → t = 0 := by
      intro V t ht
      ext x
      have hx : N • (t x).down = 0 := by
        have := congrArg (fun g : C(↥((Opposite.unop V).left.left), ULift.{u+1} ℤ_[ℓ]) =>
          (g x).down) ht
        exact this
      rw [nsmul_eq_mul, mul_eq_zero] at hx
      rcases hx with h0 | h0
      · exact absurd (Nat.cast_eq_zero.mp h0) hN
      · exact h0
    apply Preadditive.mono_of_cancel_zero
    intro Q φ hφ
    rw [Preadditive.comp_nsmul, Category.comp_id] at hφ
    have hzero : ∀ V (s : Q.val.obj V),
        ((0 : Q ⟶ SheafOfModules.unit (wcIntSliceRing F X h ℓ)).val.app V).hom s = 0 :=
      fun _ _ => rfl
    have happ : ∀ (k : ℕ) V (s : Q.val.obj V),
        ((k • φ).val.app V).hom s = k • (φ.val.app V).hom s := by
      intro k V s
      induction k with
      | zero => rw [zero_nsmul, zero_nsmul]; exact hzero V s
      | succ k ih =>
        rw [succ_nsmul, SheafOfModules.add_val, PresheafOfModules.add_app, ModuleCat.hom_add,
          LinearMap.add_apply, ih, succ_nsmul]
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro V
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro s
    have h1 : N • (φ.val.app V).hom s = 0 := by rw [← happ, hφ, hzero]
    exact (key V _ h1).trans (hzero V s).symm

  have hcomp : ∀ (j p : ℕ)
      (α : Abelian.Ext (SheafOfModules.unit (wcIntSliceRing F X h ℓ))
        (SheafOfModules.unit (wcIntSliceRing F X h ℓ)) p),
      α.comp (Abelian.Ext.mk₀ (j • 𝟙 (SheafOfModules.unit (wcIntSliceRing F X h ℓ))))
        (add_zero p) = j • α := by
    intro j p α
    induction j with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    | succ j ih =>
      rw [succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih, Abelian.Ext.comp_mk₀_id,
        succ_nsmul]
  have hnsmul : ∀ (j : ℕ) {W Z : SheafOfModules.{u+1} (wcIntSliceRing F X h ℓ)} {p q r : ℕ}
      (α : Abelian.Ext (SheafOfModules.unit (wcIntSliceRing F X h ℓ)) W p)
      (β : Abelian.Ext W Z q) (hr : p + q = r),
      (j • α).comp β hr = j • α.comp β hr := by
    intro j W Z p q r α β hr
    induction j with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.zero_comp]
    | succ j ih => rw [succ_nsmul, Abelian.Ext.add_comp, ih, succ_nsmul]

  have hN : ℓ ^ m ≠ 0 := pow_ne_zero m (Nat.Prime.ne_zero (Fact.out))
  let S : ShortComplex (SheafOfModules.{u+1} (wcIntSliceRing F X h ℓ)) :=
    ShortComplex.mk ((ℓ ^ m : ℕ) • 𝟙 (SheafOfModules.unit (wcIntSliceRing F X h ℓ)))
      (Limits.cokernel.π ((ℓ ^ m : ℕ) • 𝟙 (SheafOfModules.unit (wcIntSliceRing F X h ℓ))))
      (Limits.cokernel.condition _)
  have hS : S.ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) (hmono _ hN) inferInstance
  refine ⟨?_, ?_⟩
  · intro a ha
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂
      (SheafOfModules.unit (wcIntSliceRing F X h ℓ)) hS a ha
    refine ⟨x₁, ?_⟩
    rw [← hx₁]
    exact hcomp (ℓ ^ m) n x₁
  · intro e c hyp
    have hδ : ℓ ^ m • c.comp hS.extClass (rfl : n + 1 = n + 1) = 0 := by
      calc ℓ ^ m • c.comp hS.extClass (rfl : n + 1 = n + 1)
          = (c.comp hS.extClass (rfl : n + 1 = n + 1)).comp (Abelian.Ext.mk₀ S.f)
              (add_zero (n + 1)) := (hcomp (ℓ ^ m) (n + 1) _).symm
        _ = c.comp (hS.extClass.comp (Abelian.Ext.mk₀ S.f) (add_zero 1)) (by omega) :=
            Abelian.Ext.comp_assoc c hS.extClass (Abelian.Ext.mk₀ S.f) rfl (add_zero 1)
              (by omega)
        _ = 0 := by rw [hS.extClass_comp, Abelian.Ext.comp_zero]
    have h3 : (ℓ ^ e • c).comp hS.extClass (rfl : n + 1 = n + 1) = 0 := by
      rw [hnsmul]
      exact hyp _ hδ
    obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₃
      (SheafOfModules.unit (wcIntSliceRing F X h ℓ)) hS (ℓ ^ e • c) rfl h3
    exact ⟨y, hy⟩

theorem sheafOfModules_restrictScalars_unit_cokernel : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
    (R R' : Sheaf J RingCat.{u+1}) (φ : R ⟶ R') (n : ℕ),
    (∀ (V : Cᵒᵖ) (r' : R'.obj.obj V), ∃ r : R.obj.obj V, (φ.hom.app V).hom r = r') →
    (∀ (V : Cᵒᵖ) (r : R.obj.obj V), (φ.hom.app V).hom r = 0 → ∃ s : R.obj.obj V, r = n • s) →
    (∀ V : Cᵒᵖ, (n : R'.obj.obj V) = 0) →
    ∃ (q : SheafOfModules.unit R ⟶ (SheafOfModules.restrictScalars.{u+1} φ).obj (SheafOfModules.unit R'))
      (w : (n • 𝟙 (SheafOfModules.unit R)) ≫ q = 0),
      Nonempty (Limits.IsColimit (Limits.CokernelCofork.ofπ q w)) ∧
      ∀ M : SheafOfModules.{u+1} R', Function.Bijective
        (fun f : SheafOfModules.unit R' ⟶ M => q ≫ (SheafOfModules.restrictScalars.{u+1} φ).map f) :=
by
  intro C _ J _ _ R R' φ n hS hK hZ
  have hφnat : ∀ ⦃V W : Cᵒᵖ⦄ (f : V ⟶ W) (x : R.obj.obj V),
      (φ.hom.app W).hom ((R.obj.map f).hom x) = (R'.obj.map f).hom ((φ.hom.app V).hom x) := by
    intro V W f x
    exact congrArg (fun g => g.hom x) (φ.hom.naturality f)

  obtain ⟨q, hq⟩ : ∃ q : SheafOfModules.unit R ⟶
      (SheafOfModules.restrictScalars.{u+1} φ).obj (SheafOfModules.unit R'),
      ∀ (V : Cᵒᵖ) (r : R.obj.obj V), (q.val.app V).hom r = (φ.hom.app V).hom r :=
    ⟨⟨PresheafOfModules.homMk
      { app := fun V => AddCommGrpCat.ofHom
          (show R.obj.obj V →+ R'.obj.obj V from (φ.hom.app V).hom.toAddMonoidHom)
        naturality := fun V W f => by
          ext x
          exact hφnat f x }
      (fun V r m => by
          exact map_mul (φ.hom.app V).hom r m)⟩, fun _ _ => rfl⟩

  have hN : ∀ (m : ℕ) (V : Cᵒᵖ) (s : R.obj.obj V),
      ((m • 𝟙 (SheafOfModules.unit R)).val.app V).hom s = m • s := by
    intro m V s
    induction m with
    | zero => rw [zero_nsmul, zero_nsmul]; rfl
    | succ m ih =>
      rw [succ_nsmul, succ_nsmul, ← ih]
      rfl

  have w : (n • 𝟙 (SheafOfModules.unit R)) ≫ q = 0 := by
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro V
    refine ModuleCat.hom_ext (LinearMap.ext fun (r : R.obj.obj V) => ?_)
    change (q.val.app V).hom (((n • 𝟙 (SheafOfModules.unit R)).val.app V).hom r) = 0
    have e1 := hN n V r
    have e2 : (φ.hom.app V).hom (n • r) = 0 := by
      rw [map_nsmul, nsmul_eq_mul, hZ, zero_mul]
    exact (congrArg (q.val.app V).hom e1).trans ((hq V _).trans e2)
  let σ : ∀ V : Cᵒᵖ, R'.obj.obj V → R.obj.obj V := fun V => Function.surjInv (hS V)
  have hσ : ∀ V (r' : R'.obj.obj V), (φ.hom.app V).hom (σ V r') = r' :=
    fun V r' => Function.surjInv_eq (hS V) r'
  have hqσ : ∀ V (r' : R'.obj.obj V), (q.val.app V).hom (σ V r') = r' :=
    fun V r' => (hq V _).trans (hσ V r')

  have : Epi q := ⟨fun {A} m₁ m₂ h => by
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro V
    refine ModuleCat.hom_ext (LinearMap.ext fun (r' : R'.obj.obj V) => ?_)
    have h1 := congrArg (fun t => (t.val.app V).hom (σ V r')) h
    change (m₁.val.app V).hom ((q.val.app V).hom (σ V r')) =
      (m₂.val.app V).hom ((q.val.app V).hom (σ V r')) at h1
    exact (congrArg (m₁.val.app V).hom (hqσ V r')).symm.trans
      (h1.trans (congrArg (m₂.val.app V).hom (hqσ V r')))⟩
  refine ⟨q, w, ⟨Limits.CokernelCofork.IsColimit.ofπ' q w (fun {A} k hk => ?_)⟩, ?_⟩
  ·
    have hk0 : ∀ V (s : R.obj.obj V), (k.val.app V).hom (n • s) = 0 := by
      intro V s
      have h1 := congrArg (fun t => (t.val.app V).hom s) hk
      change (k.val.app V).hom (((n • 𝟙 (SheafOfModules.unit R)).val.app V).hom s) = 0 at h1
      rwa [hN] at h1
    have hd : ∀ V (x y : R.obj.obj V), (φ.hom.app V).hom x = (φ.hom.app V).hom y →
        (k.val.app V).hom x = (k.val.app V).hom y := by
      intro V x y hxy
      obtain ⟨s, hs⟩ := hK V (x - y) (by rw [map_sub, hxy, sub_self])
      have h1 : (k.val.app V).hom (x - y) = 0 := by rw [hs]; exact hk0 V s
      have h2 : (k.val.app V).hom x - (k.val.app V).hom y = (k.val.app V).hom (x - y) :=
        ((k.val.app V).hom.map_sub x y).symm
      exact sub_eq_zero.mp (h2.trans h1)
    let L : ∀ V : Cᵒᵖ, R'.obj.obj V →+ A.val.obj V := fun V =>
      AddMonoidHom.mk' (fun r' : R'.obj.obj V => (k.val.app V).hom (σ V r')) (by
        intro a b
        have e : (k.val.app V).hom (σ V a + σ V b) =
            (k.val.app V).hom (σ V a) + (k.val.app V).hom (σ V b) := map_add _ _ _
        refine Eq.trans ?_ e
        apply hd
        rw [map_add, hσ, hσ, hσ])
    have hLnat : ∀ ⦃V W : Cᵒᵖ⦄ (f : V ⟶ W) (r' : R'.obj.obj V),
        (k.val.app W).hom (σ W ((R'.obj.map f).hom r')) =
          (A.val.map f).hom ((k.val.app V).hom (σ V r')) := by
      intro V W f r'
      have e := PresheafOfModules.naturality_apply k.val f (σ V r')
      refine Eq.trans ?_ e
      apply hd
      change (φ.hom.app W).hom (σ W ((R'.obj.map f).hom r')) =
        (φ.hom.app W).hom ((R.obj.map f).hom (σ V r'))
      rw [hσ, hφnat, hσ]
    have hLsmul : ∀ V (r : R.obj.obj V) (r' : R'.obj.obj V),
        (k.val.app V).hom (σ V ((φ.hom.app V).hom r * r')) =
          r • (k.val.app V).hom (σ V r') := by
      intro V r r'
      have e : (k.val.app V).hom (r * σ V r') = r • (k.val.app V).hom (σ V r') :=
        (k.val.app V).hom.map_smul r (σ V r')
      refine Eq.trans ?_ e
      apply hd
      rw [hσ, map_mul, hσ]
    refine ⟨⟨PresheafOfModules.homMk
      { app := fun V => AddCommGrpCat.ofHom (L V)
        naturality := fun V W f => by
          ext r'
          exact hLnat f r' }
      (fun V r m => hLsmul V r m)⟩, ?_⟩
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro V
    refine ModuleCat.hom_ext (LinearMap.ext fun (r : R.obj.obj V) => ?_)
    change (k.val.app V).hom (σ V (show R'.obj.obj V from (q.val.app V).hom r)) =
      (k.val.app V).hom r
    apply hd
    exact (congrArg (fun z => (φ.hom.app V).hom (σ V z)) (hq V r)).trans (hσ V _)
  ·
    intro M
    let E := SheafOfModules.unitHomEquiv M
    let E' := SheafOfModules.unitHomEquiv ((SheafOfModules.restrictScalars.{u+1} φ).obj M)
    have key : ∀ f : SheafOfModules.unit R' ⟶ M,
        E' (q ≫ (SheafOfModules.restrictScalars.{u+1} φ).map f) = E f := by
      intro f
      apply PresheafOfModules.sections_ext
      intro V
      rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
      change (f.val.app V).hom ((q.val.app V).hom (1 : R.obj.obj V)) =
        (f.val.app V).hom (1 : R'.obj.obj V)
      rw [hq, map_one]
    have hfun : (fun f : SheafOfModules.unit R' ⟶ M =>
        q ≫ (SheafOfModules.restrictScalars.{u+1} φ).map f) = fun f => E'.symm (E f) := by
      funext f
      apply E'.injective
      exact (key f).trans (E'.apply_symm_apply (E f)).symm
    rw [hfun]
    exact E'.symm.bijective.comp E.bijective

theorem sheafOfModules_unit_torsionfree_injective_divisible : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
    (R : Sheaf J RingCat.{u+1}) (n : ℕ),
    (∀ (V : Cᵒᵖ) (r : R.obj.obj V), n • r = 0 → r = 0) →
    Mono (n • 𝟙 (SheafOfModules.unit R)) ∧ ∀ (I : SheafOfModules.{u+1} R) [Injective I], Epi (n • 𝟙 I) :=
by
  intro C _ J _ _ R n hT
  have hp : ∀ {M N : PresheafOfModules.{u+1} R.obj} (f : M ⟶ N) (k : ℕ) (V : Cᵒᵖ) (x : M.obj V),
      ((k • f).app V).hom x = k • (f.app V).hom x := by
    intro M N f k V x
    induction k with
    | zero => simp
    | succ k ih =>
      rw [succ_nsmul, PresheafOfModules.add_app, ModuleCat.hom_add, LinearMap.add_apply, ih,
        succ_nsmul]
  have hz : ∀ {M N : PresheafOfModules.{u+1} R.obj} (V : Cᵒᵖ) (x : M.obj V),
      ((0 : M ⟶ N).app V).hom x = 0 := by
    intro M N V x
    rw [PresheafOfModules.zero_app, ModuleCat.hom_zero, LinearMap.zero_apply]
  have hsv : ∀ {M N : SheafOfModules.{u+1} R} (f : M ⟶ N) (k : ℕ), (k • f).val = k • f.val := by
    intro M N f k
    have h : (SheafOfModules.forget R).map (k • f) = k • (SheafOfModules.forget R).map f :=
      Functor.map_nsmul _
    exact h
  have hzv : ∀ {M N : SheafOfModules.{u+1} R}, (0 : M ⟶ N).val = 0 := by
    intro M N
    have h : (SheafOfModules.forget R).map (0 : M ⟶ N) = 0 := Functor.map_zero _ _ _
    exact h
  have V0 : ∀ {M N : SheafOfModules.{u+1} R} (f : M ⟶ N),
      (∀ V (x : M.val.obj V), (f.val.app V).hom x = 0) → f = 0 := by
    intro M N f hf
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro V
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    rw [hf V x, hzv, hz]
  constructor
  · apply Preadditive.mono_of_cancel_zero
    intro P g hg
    rw [Preadditive.comp_nsmul, Category.comp_id] at hg
    apply V0
    intro V x
    apply hT V
    have h1 := congrArg (fun φ => ((φ : P ⟶ _).val.app V).hom x) hg
    simp only [hsv, hp, hzv, hz] at h1
    exact h1
  · intro I _
    have hdiv : ∀ (G : PresheafOfModules.{u+1} R.obj) [Injective G] (V : Cᵒᵖ) (t : G.obj V),
        ∃ t' : G.obj V, n • t' = t := by
      intro G _ V t
      cases V with
      | op X =>
      let P := PresheafOfModules.freeObj (R := R.obj) (uliftYoneda.{u+1}.obj X)
      let e : P.obj (Opposite.op X) :=
        ModuleCat.freeMk (ULift.up (𝟙 X) : (uliftYoneda.{u+1}.obj X).obj (Opposite.op X))
      let τ0 : uliftYoneda.{u+1}.obj X ⟶ G.presheaf ⋙ forget Ab := uliftYonedaEquiv.symm t
      let σ : P ⟶ G := PresheafOfModules.freeObjDesc τ0
      have hσ : (σ.app (Opposite.op X)).hom e = t := by
        have e1 : uliftYonedaEquiv τ0 = t := Equiv.apply_symm_apply _ _
        rw [uliftYonedaEquiv_apply] at e1
        rw [PresheafOfModules.freeObjDesc_app]
        rw [← e1]
        exact ModuleCat.freeDesc_apply _ _
      have hmono : Mono (n • 𝟙 P) := by
        apply Preadditive.mono_of_cancel_zero
        intro Q g hg
        rw [Preadditive.comp_nsmul, Category.comp_id] at hg
        apply PresheafOfModules.hom_ext
        intro W
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro y
        have h1 : ((n • g).app W).hom y = ((0 : Q ⟶ P).app W).hom y := by rw [hg]
        rw [hp, hz] at h1
        rw [hz]
        let c : (uliftYoneda.{u+1}.obj X).obj W →₀ R.obj.obj W := (g.app W).hom y
        have h3 : n • c = 0 := h1
        change c = 0
        ext a
        have h4 : n • (c a) = 0 := by
          rw [← Finsupp.smul_apply, h3, Finsupp.zero_apply]
        exact (hT W _ h4).trans (Finsupp.zero_apply).symm
      let τ := Injective.factorThru σ (n • 𝟙 P)
      have hτ : (n • 𝟙 P) ≫ τ = σ := Injective.comp_factorThru _ _
      rw [Preadditive.nsmul_comp, Category.id_comp] at hτ
      refine ⟨(τ.app (Opposite.op X)).hom e, ?_⟩
      have h5 := hp τ n (Opposite.op X) e
      rw [hτ] at h5
      rw [← h5, hσ]
    have hG := Injective.injective_of_adjoint
      (PresheafOfModules.sheafificationAdjunction (J := J) (R := R) (𝟙 R.obj)) I
    apply Preadditive.epi_of_cancel_zero
    intro Z g hg
    rw [Preadditive.nsmul_comp, Category.id_comp] at hg
    apply V0
    intro V x
    obtain ⟨x', hx'⟩ : ∃ x' : I.val.obj V, n • x' = x := @hdiv _ hG V x
    rw [← hx', map_nsmul, ← hp, ← hsv, hg, hzv, hz]

theorem sheafOfModules_restrictScalars_quotient_embedding : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
    (R R' : Sheaf J RingCat.{u+1}) (φ : R ⟶ R') (n : ℕ),
    (∀ (V : Cᵒᵖ) (r' : R'.obj.obj V), ∃ r : R.obj.obj V, (φ.hom.app V).hom r = r') →
    (∀ (V : Cᵒᵖ) (r : R.obj.obj V), (φ.hom.app V).hom r = 0 → ∃ s : R.obj.obj V, r = n • s) →
    (∀ V : Cᵒᵖ, (n : R'.obj.obj V) = 0) →
    (SheafOfModules.restrictScalars.{u+1} φ).Full ∧ (SheafOfModules.restrictScalars.{u+1} φ).Faithful ∧
      (∀ M : SheafOfModules.{u+1} R', n • 𝟙 M = 0) ∧
      ∀ N : SheafOfModules.{u+1} R, n • 𝟙 N = 0 →
        ∃ M : SheafOfModules.{u+1} R', Nonempty ((SheafOfModules.restrictScalars.{u+1} φ).obj M ≅ N) :=
by
  intro C _ J _ _ R R' φ n hS hK hZ

  have hev : ∀ {S : Sheaf J RingCat.{u+1}} {M M' : SheafOfModules.{u+1} S} (f : M ⟶ M') (V : Cᵒᵖ),
      f.val.app V = (SheafOfModules.forget S ⋙ PresheafOfModules.evaluation S.obj V).map f :=
    fun _ _ => rfl
  have hnsmulApp : ∀ {S : Sheaf J RingCat.{u+1}} (M : SheafOfModules.{u+1} S) (V : Cᵒᵖ),
      (n • 𝟙 M).val.app V = n • 𝟙 (M.val.obj V) := by
    intro S M V
    rw [hev, CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
    rfl
  have hzeroApp : ∀ {S : Sheaf J RingCat.{u+1}} (M M' : SheafOfModules.{u+1} S) (V : Cᵒᵖ),
      (0 : M ⟶ M').val.app V = 0 := by
    intro S M M' V
    rw [hev, CategoryTheory.Functor.map_zero]
    rfl

  have hFaith : (SheafOfModules.restrictScalars.{u+1} φ).Faithful := by
    constructor
    intro M M' f g h
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro V
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    have h1 := congrArg (fun k => k.val.app V) h
    exact LinearMap.congr_fun (congrArg ModuleCat.Hom.hom h1) x

  have hFull : (SheafOfModules.restrictScalars.{u+1} φ).Full := by
    constructor
    intro M M' g
    let φ₀ : M.val.presheaf ⟶ M'.val.presheaf := (PresheafOfModules.toPresheaf R.obj).map g.val
    refine ⟨⟨PresheafOfModules.homMk φ₀ ?_⟩, ?_⟩
    · intro V r' m
      obtain ⟨r, rfl⟩ := hS V r'
      exact (g.val.app V).hom.map_smul r m
    · apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro V
      rfl

  have G3 : ∀ M : SheafOfModules.{u+1} R', n • 𝟙 M = 0 := by
    intro M
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro V
    rw [hnsmulApp, hzeroApp]
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    rw [ModuleCat.hom_nsmul, ModuleCat.hom_id, ModuleCat.hom_zero, LinearMap.smul_apply,
      LinearMap.id_apply, LinearMap.zero_apply, ← Nat.cast_smul_eq_nsmul (R'.obj.obj V), hZ V,
      zero_smul]
  refine ⟨hFull, hFaith, G3, ?_⟩

  intro N hN
  have hkill : ∀ (V : Cᵒᵖ) (x : N.val.obj V), n • x = 0 := by
    intro V x
    have h1 : (n • 𝟙 N).val.app V = (0 : N ⟶ N).val.app V := by rw [hN]
    rw [hnsmulApp, hzeroApp] at h1
    have h2 := LinearMap.congr_fun (congrArg ModuleCat.Hom.hom h1) x
    rw [ModuleCat.hom_nsmul, ModuleCat.hom_id, ModuleCat.hom_zero, LinearMap.smul_apply,
      LinearMap.id_apply, LinearMap.zero_apply] at h2
    exact h2
  have hcompat : ∀ (V : Cᵒᵖ) (r r₀ : R.obj.obj V) (x : N.val.obj V),
      (φ.hom.app V).hom r = (φ.hom.app V).hom r₀ → r • x = r₀ • x := by
    intro V r r₀ x h
    obtain ⟨s, hs⟩ := hK V (r - r₀) (by rw [map_sub, h, sub_self])
    rw [← sub_eq_zero, ← sub_smul, hs, smul_assoc, hkill]
  choose σ hσ using hS
  letI inst : ∀ V : Cᵒᵖ, Module (R'.obj.obj V) (N.val.obj V) := fun V =>
    letI : SMul (R'.obj.obj V) (N.val.obj V) := ⟨fun r' x => σ V r' • x⟩
    Function.Surjective.moduleLeft (φ.hom.app V).hom (fun r' => ⟨σ V r', hσ V r'⟩)
      (fun c x => hcompat V _ _ x (hσ V _))
  have hmap : ∀ ⦃X Y : Cᵒᵖ⦄ (f : X ⟶ Y) (r : R'.obj.obj X) (m : N.val.obj X),
      (N.val.map f).hom (σ X r • m) =
        σ Y ((R'.obj.map f).hom r) • (N.val.map f).hom m := by
    intro X Y f r m
    have hnat : (φ.hom.app Y).hom ((R.obj.map f).hom (σ X r)) =
        (φ.hom.app Y).hom (σ Y ((R'.obj.map f).hom r)) := by
      rw [hσ Y]
      have h1 := congrArg (fun k => k.hom (σ X r)) (φ.hom.naturality f)
      simp only [RingCat.hom_comp, RingHom.comp_apply] at h1
      rw [h1, hσ X]
    exact (N.val.map_smul f (σ X r) m).trans (hcompat Y _ _ _ hnat)
  let M₀ : PresheafOfModules.{u+1} R'.obj :=
    @PresheafOfModules.ofPresheaf _ _ R'.obj N.val.presheaf (fun V => inst V) hmap
  let M' : SheafOfModules.{u+1} R' := ⟨M₀, N.isSheaf⟩
  let eV : ∀ V : Cᵒᵖ, (((SheafOfModules.restrictScalars.{u+1} φ).obj M').val.obj V) ≃ₗ[R.obj.obj V]
      (N.val.obj V) := fun V =>
    { toFun := fun x => x
      invFun := fun x => x
      map_add' := fun _ _ => rfl
      map_smul' := fun r x => hcompat V _ _ x (hσ V _)
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  let e₀ : (SheafOfModules.forget R).obj ((SheafOfModules.restrictScalars.{u+1} φ).obj M') ≅
      (SheafOfModules.forget R).obj N :=
    PresheafOfModules.isoMk (fun V => LinearEquiv.toModuleIso (eV V)) (by
      intro X Y f
      rfl)
  exact ⟨M', ⟨(SheafOfModules.fullyFaithfulForget R).preimageIso e₀⟩⟩

theorem wc_int_zmod_slice_ring_map : ∀ (F : Type u) [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (m : ℕ),
    ∃ φ : wcIntSliceRing F X h ℓ ⟶ wcZModSliceRing F X h (ℓ ^ m),
      (∀ (V : (Over (wcGeomPoint F X h))ᵒᵖ) (r : (wcIntSliceRing F X h ℓ).obj.obj V),
        (ℓ ^ m) • r = 0 → r = 0) ∧
      (∀ (V : (Over (wcGeomPoint F X h))ᵒᵖ) (r' : (wcZModSliceRing F X h (ℓ ^ m)).obj.obj V),
        ∃ r : (wcIntSliceRing F X h ℓ).obj.obj V, (φ.hom.app V).hom r = r') ∧
      (∀ (V : (Over (wcGeomPoint F X h))ᵒᵖ) (r : (wcIntSliceRing F X h ℓ).obj.obj V),
        (φ.hom.app V).hom r = 0 → ∃ s : (wcIntSliceRing F X h ℓ).obj.obj V, r = (ℓ ^ m) • s) ∧
      (∀ V : (Over (wcGeomPoint F X h))ᵒᵖ, ((ℓ ^ m : ℕ) : (wcZModSliceRing F X h (ℓ ^ m)).obj.obj V) = 0) :=
by
  intro F _ X h ℓ _ m
  have hℓpos : (0 : ℝ) < (ℓ : ℝ) := by exact_mod_cast (Fact.out : Nat.Prime ℓ).pos
  have hρc : Continuous (PadicInt.toZModPow (p := ℓ) m) := by
    rw [continuous_discrete_rng]
    intro b
    rw [Metric.isOpen_iff]
    intro y hy
    refine ⟨(ℓ : ℝ) ^ (-(m : ℤ)), zpow_pos hℓpos _, ?_⟩
    intro z hz
    rw [Metric.mem_ball, dist_eq_norm] at hz
    have h1 : z - y ∈ Ideal.span {(ℓ : ℤ_[ℓ]) ^ m} :=
      (PadicInt.norm_le_pow_iff_mem_span_pow _ _).mp hz.le
    rw [← PadicInt.ker_toZModPow, RingHom.mem_ker, map_sub, sub_eq_zero] at h1
    simp only [Set.mem_preimage, Set.mem_singleton_iff] at hy ⊢
    rw [h1, hy]
  have hdiv : ∀ (T : Type u) [TopologicalSpace T] (g : C(T, ℤ_[ℓ])),
      (∀ t, PadicInt.toZModPow m (g t) = 0) →
      ∃ c : C(T, ℤ_[ℓ]), ∀ t, g t = (ℓ : ℤ_[ℓ]) ^ m * c t := by
    intro T _ g hg
    have hl : ((ℓ : ℚ_[ℓ]) ^ m) ≠ 0 :=
      pow_ne_zero _ (Nat.cast_ne_zero.mpr (Fact.out : Nat.Prime ℓ).ne_zero)
    have hb : ∀ t, ‖((g t : ℚ_[ℓ])) / (ℓ : ℚ_[ℓ]) ^ m‖ ≤ 1 := by
      intro t
      have h1 : g t ∈ Ideal.span {(ℓ : ℤ_[ℓ]) ^ m} := by
        rw [← PadicInt.ker_toZModPow, RingHom.mem_ker]; exact hg t
      have h2 := (PadicInt.norm_le_pow_iff_mem_span_pow _ _).mpr h1
      rw [PadicInt.norm_def] at h2
      rw [norm_div, Padic.norm_p_pow]
      exact (div_le_one (zpow_pos hℓpos _)).mpr h2
    refine ⟨⟨fun t => (⟨(g t : ℚ_[ℓ]) / (ℓ : ℚ_[ℓ]) ^ m, hb t⟩ : ℤ_[ℓ]),
      Continuous.subtype_mk ((continuous_subtype_val.comp g.continuous).div_const _) hb⟩, ?_⟩
    intro t
    apply PadicInt.ext
    rw [PadicInt.coe_mul, PadicInt.coe_pow, PadicInt.coe_natCast]
    change (g t : ℚ_[ℓ]) = (ℓ : ℚ_[ℓ]) ^ m * ((g t : ℚ_[ℓ]) / (ℓ : ℚ_[ℓ]) ^ m)
    field_simp
  let g : ULift.{u+1} ℤ_[ℓ] →+* ULift.{u+1} (ZMod (ℓ ^ m)) :=
    (ULift.ringEquiv.{0, u+1} (R := ZMod (ℓ ^ m))).symm.toRingHom.comp
      ((PadicInt.toZModPow (p := ℓ) m).comp (ULift.ringEquiv.{0, u+1} (R := ℤ_[ℓ])).toRingHom)
  have hg : Continuous g := continuous_uliftUp.comp (hρc.comp continuous_uliftDown)
  let φ₀ : wcIntRingPresheaf.{u} ℓ ⟶ wcZModRingPresheaf.{u} (ℓ ^ m) :=
    { app := fun S => RingCat.ofHom (RingHom.compLeftContinuous (↥(Opposite.unop S)) g hg)
      naturality := fun _ _ _ => rfl }
  let φ : wcIntSliceRing F X h ℓ ⟶ wcZModSliceRing F X h (ℓ ^ m) :=
    ((Scheme.ProEt.topology X.left).overPullback RingCat.{u+1} (wcGeomPoint F X h)).map
      (((Scheme.ProEt.forget X.left ⋙ Over.forget X.left).sheafPushforwardContinuous RingCat.{u+1}
        (Scheme.ProEt.topology X.left) Scheme.proetaleTopology).map (ObjectProperty.homMk φ₀))
  refine ⟨φ, ?_, ?_, ?_, ?_⟩
  · intro V r hr
    let f : C(↥(Opposite.unop V).left.left, ULift.{u+1} ℤ_[ℓ]) := r
    have hpt : ∀ t, (ℓ ^ m : ℕ) • (f t).down = 0 := by
      intro t
      have := congrArg
        (fun z : C(↥(Opposite.unop V).left.left, ULift.{u+1} ℤ_[ℓ]) => (z t).down) hr
      exact this
    have h0 : ∀ t, (f t).down = 0 := by
      intro t
      have := hpt t
      rw [nsmul_eq_mul] at this
      refine (mul_eq_zero.mp this).resolve_left ?_
      rw [Nat.cast_pow]
      exact pow_ne_zero _ (Nat.cast_ne_zero.mpr (Fact.out : Nat.Prime ℓ).ne_zero)
    change f = 0
    apply ContinuousMap.ext
    intro t
    apply ULift.ext
    exact h0 t
  · intro V r'
    let f' : C(↥(Opposite.unop V).left.left, ULift.{u+1} (ZMod (ℓ ^ m))) := r'
    let f : C(↥(Opposite.unop V).left.left, ULift.{u+1} ℤ_[ℓ]) :=
      ⟨fun t => ULift.up (((f' t).down.val : ℕ) : ℤ_[ℓ]),
        (continuous_of_discreteTopology (f := fun b : ULift.{u+1} (ZMod (ℓ ^ m)) =>
          (ULift.up (((b.down).val : ℕ) : ℤ_[ℓ]) : ULift.{u+1} ℤ_[ℓ]))).comp f'.continuous⟩
    refine ⟨f, ?_⟩
    change RingHom.compLeftContinuous (↥(Opposite.unop V).left.left) g hg f = f'
    apply ContinuousMap.ext
    intro t
    apply ULift.ext
    change PadicInt.toZModPow m (((f' t).down.val : ℕ) : ℤ_[ℓ]) = (f' t).down
    rw [map_natCast, ZMod.natCast_zmod_val]
  · intro V r hr
    let f : C(↥(Opposite.unop V).left.left, ULift.{u+1} ℤ_[ℓ]) := r
    have hx : ∀ t, PadicInt.toZModPow m (f t).down = 0 := by
      intro t
      have := congrArg
        (fun z : C(↥(Opposite.unop V).left.left, ULift.{u+1} (ZMod (ℓ ^ m))) => (z t).down) hr
      exact this
    obtain ⟨c, hc⟩ := hdiv _ ⟨fun t => (f t).down, continuous_uliftDown.comp f.continuous⟩ hx
    let s : C(↥(Opposite.unop V).left.left, ULift.{u+1} ℤ_[ℓ]) :=
      ⟨fun t => ULift.up (c t), continuous_uliftUp.comp c.continuous⟩
    refine ⟨s, ?_⟩
    change f = (ℓ ^ m) • s
    apply ContinuousMap.ext
    intro t
    apply ULift.ext
    change (f t).down = (ℓ ^ m) • c t
    rw [nsmul_eq_mul, Nat.cast_pow]
    exact hc t
  · intro V
    change ((ℓ ^ m : ℕ) : C(↥(Opposite.unop V).left.left, ULift.{u+1} (ZMod (ℓ ^ m)))) = 0
    apply ContinuousMap.ext
    intro t
    apply ULift.ext
    change ((ℓ ^ m : ℕ) : ZMod (ℓ ^ m)) = 0
    exact ZMod.natCast_self _

theorem wc_tormod_ring_comparison (F : Type u) [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (m : ℕ) (hm : 1 ≤ m) :
    ∃ Φ : ∀ n : ℕ, wcZModSliceCoh F X h (ℓ ^ m) n ≃+ wcTorModCoh F X h ℓ m n,
      ∀ (i j k : ℕ) (hk : i + j = k) (a : wcIntModCoh F X h ℓ i)
        (x : wcZModSliceCoh F X h (ℓ ^ m) i) (y : wcZModSliceCoh F X h (ℓ ^ m) j),
        wcTorRed F X h ℓ m i a = Φ i x →
        wcIntTorAct F X h ℓ m i j k hk a (Φ j y) = Φ k (wcZModSliceCup F X h (ℓ ^ m) i j k hk x y) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcIntSliceRing F X h ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcZModSliceRing F X h (ℓ ^ m))) := HasExt.standard _
  obtain ⟨φ, hT, hS, hK, hZ⟩ := wc_int_zmod_slice_ring_map F X h ℓ m
  obtain ⟨hPL, hPC⟩ : Limits.PreservesFiniteLimits (SheafOfModules.restrictScalars.{u+1} φ) ∧
      Limits.PreservesFiniteColimits (SheafOfModules.restrictScalars.{u+1} φ) := by
    let e : SheafOfModules.restrictScalars.{u+1} φ ⋙
        SheafOfModules.toSheaf (wcIntSliceRing F X h ℓ) ≅
        SheafOfModules.toSheaf (wcZModSliceRing F X h (ℓ ^ m)) :=
      NatIso.ofComponents (fun M => Iso.refl _) (fun f => by rfl)
    haveI := sheafOfModules_toSheaf_preservesFiniteColimits _ (wcIntSliceRing F X h ℓ)
    haveI := sheafOfModules_toSheaf_preservesFiniteColimits _ (wcZModSliceRing F X h (ℓ ^ m))
    haveI : Limits.PreservesFiniteLimits (SheafOfModules.restrictScalars.{u+1} φ ⋙
        SheafOfModules.toSheaf (wcIntSliceRing F X h ℓ)) :=
      Limits.preservesFiniteLimits_of_natIso e.symm
    haveI : Limits.PreservesFiniteColimits (SheafOfModules.restrictScalars.{u+1} φ ⋙
        SheafOfModules.toSheaf (wcIntSliceRing F X h ℓ)) :=
      Limits.preservesFiniteColimits_of_natIso e.symm
    haveI : Limits.ReflectsFiniteLimits (SheafOfModules.toSheaf (wcIntSliceRing F X h ℓ)) :=
      Limits.reflectsFiniteLimits_of_reflectsIsomorphisms _
    haveI : Limits.ReflectsFiniteColimits (SheafOfModules.toSheaf (wcIntSliceRing F X h ℓ)) := by
      refine @Limits.ReflectsFiniteColimits.mk _ _ _ _ _ ?_
      intro K _ _
      haveI hK1 : Limits.HasColimitsOfShape K (SheafOfModules.{u+1} (wcIntSliceRing F X h ℓ)) :=
        Limits.HasFiniteColimits.out K
      haveI hK2 : Limits.PreservesColimitsOfShape K
          (SheafOfModules.toSheaf (wcIntSliceRing F X h ℓ)) :=
        Limits.PreservesFiniteColimits.preservesFiniteColimits K
      exact @Limits.reflectsColimitsOfShape_of_reflectsIsomorphisms _ _ _ _ K _ _ inferInstance
        hK1 hK2
    exact ⟨Limits.preservesFiniteLimits_of_reflects_of_preserves _
        (SheafOfModules.toSheaf (wcIntSliceRing F X h ℓ)),
      Limits.preservesFiniteColimits_of_reflects_of_preserves _
        (SheafOfModules.toSheaf (wcIntSliceRing F X h ℓ))⟩
  obtain ⟨q, w, ⟨hcolim⟩, hcorep⟩ :=
    sheafOfModules_restrictScalars_unit_cokernel _ _ _ φ (ℓ ^ m) hS hK hZ
  obtain ⟨hFull, hFaith, hkill, hess⟩ :=
    sheafOfModules_restrictScalars_quotient_embedding _ _ _ φ (ℓ ^ m) hS hK hZ
  obtain ⟨hmono, hdiv⟩ :=
    sheafOfModules_unit_torsionfree_injective_divisible _ (wcIntSliceRing F X h ℓ) (ℓ ^ m) hT
  haveI hEI1 : EnoughInjectives (SheafOfModules.{u+1} (wcIntSliceRing F X h ℓ)) :=
    sheafOfModules_enoughInjectives _ _
  haveI hEI2 : EnoughInjectives (SheafOfModules.{u+1} (wcZModSliceRing F X h (ℓ ^ m))) :=
    sheafOfModules_enoughInjectives _ _

  have c5 : ∀ (G : SheafOfModules.{u+1} (wcZModSliceRing F X h (ℓ ^ m)) ⥤
      SheafOfModules.{u+1} (wcIntSliceRing F X h ℓ)) [G.Additive] [G.Full] [G.Faithful]
      (P : SheafOfModules.{u+1} (wcIntSliceRing F X h ℓ)) (n : ℕ),
      Mono (n • 𝟙 P) →
      (∀ (J : SheafOfModules.{u+1} (wcIntSliceRing F X h ℓ)) [Injective J], Epi (n • 𝟙 J)) →
      (∀ M : SheafOfModules.{u+1} (wcZModSliceRing F X h (ℓ ^ m)), n • 𝟙 M = 0) →
      (∀ N : SheafOfModules.{u+1} (wcIntSliceRing F X h ℓ), n • 𝟙 N = 0 →
        ∃ M : SheafOfModules.{u+1} (wcZModSliceRing F X h (ℓ ^ m)), Nonempty (G.obj M ≅ N)) →
      ∀ (I : SheafOfModules.{u+1} (wcZModSliceRing F X h (ℓ ^ m))) [Injective I] (k : ℕ)
        (e : Abelian.Ext P (G.obj I) (k + 1)), e = 0 := by
    intro G _ _ _ P n h1 h2 h3 h4 I _ k e
    let ι := Injective.ι (G.obj I)
    let J := Injective.under (G.obj I)
    let ν : J ⟶ J := n • 𝟙 J
    haveI : Epi ν := h2 J
    have hιν : ι ≫ ν = 0 := by
      have e1 : ι ≫ ν = (n • 𝟙 (G.obj I)) ≫ ι := by
        show ι ≫ (n • 𝟙 _) = (n • 𝟙 _) ≫ ι
        rw [Preadditive.comp_nsmul, Preadditive.nsmul_comp, Category.comp_id, Category.id_comp]
      rw [e1, ← G.map_id, ← Functor.map_nsmul, h3 I, G.map_zero, Limits.zero_comp]
    let ι' : G.obj I ⟶ Limits.kernel ν := Limits.kernel.lift ν ι hιν
    have hι' : ι' ≫ Limits.kernel.ι ν = ι := Limits.kernel.lift_ι _ _ _
    haveI : Mono ι' := mono_of_mono_fac hι'
    have hker : n • 𝟙 (Limits.kernel ν) = 0 := by
      rw [← cancel_mono (Limits.kernel.ι ν), Limits.zero_comp, Preadditive.nsmul_comp,
        Category.id_comp]
      have := Limits.kernel.condition ν
      simp only [ν, Preadditive.comp_nsmul, Category.comp_id] at this
      exact this
    obtain ⟨M, ⟨eM⟩⟩ := h4 _ hker
    let g : I ⟶ M := G.preimage (ι' ≫ eM.inv)
    have hg : G.map g = ι' ≫ eM.inv := G.map_preimage _
    haveI : Mono (G.map g) := by rw [hg]; infer_instance
    haveI : Mono g := G.mono_of_mono_map this
    let r : M ⟶ I := Injective.factorThru (𝟙 I) g
    have hr : g ≫ r = 𝟙 I := Injective.comp_factorThru _ _
    have hst : ι' ≫ (eM.inv ≫ G.map r) = 𝟙 (G.obj I) := by
      rw [← Category.assoc, ← hg, ← G.map_comp, hr, G.map_id]
    let S : ShortComplex (SheafOfModules.{u+1} (wcIntSliceRing F X h ℓ)) :=
      ShortComplex.mk (Limits.kernel.ι ν) ν (Limits.kernel.condition ν)
    have hS' : S.ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel ν) inferInstance inferInstance
    haveI : Injective S.X₂ := (inferInstance : Injective (Injective.under (G.obj I)))
    have hz : e.comp (Abelian.Ext.mk₀ ι') (add_zero _) = 0 := by
      set z := e.comp (Abelian.Ext.mk₀ ι') (add_zero _)
      have h0 : z.comp (Abelian.Ext.mk₀ S.f) (add_zero _) = 0 :=
        Abelian.Ext.eq_zero_of_injective _
      obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ P hS' z h0 (n₀ := k) rfl
      rw [← hx₃]
      obtain ⟨y, hy⟩ : ∃ y : Abelian.Ext P S.X₂ k,
          x₃ = y.comp (Abelian.Ext.mk₀ S.g) (add_zero k) := by
        cases k with
        | zero =>
          obtain ⟨f, rfl⟩ : ∃ f : P ⟶ J, Abelian.Ext.mk₀ f = x₃ :=
            ⟨_, Abelian.Ext.mk₀_homEquiv₀_apply x₃⟩
          let g' : P ⟶ J := Injective.factorThru f (n • 𝟙 P)
          have hg' : (n • 𝟙 P) ≫ g' = f := Injective.comp_factorThru _ _
          refine ⟨Abelian.Ext.mk₀ g', ?_⟩
          rw [Abelian.Ext.mk₀_comp_mk₀]
          congr 1
          rw [← hg']
          simp only [S, ν, Preadditive.comp_nsmul, Preadditive.nsmul_comp, Category.comp_id,
            Category.id_comp]
        | succ k' =>
          refine ⟨0, ?_⟩
          rw [Abelian.Ext.zero_comp]
          exact Abelian.Ext.eq_zero_of_injective _
      rw [hy, Abelian.Ext.comp_assoc _ _ _ (add_zero k) (zero_add 1) (by omega),
        hS'.comp_extClass, Abelian.Ext.comp_zero]
    have he : e = (e.comp (Abelian.Ext.mk₀ ι') (add_zero _)).comp
        (Abelian.Ext.mk₀ (eM.inv ≫ G.map r)) (add_zero _) := by
      calc e = e.comp (Abelian.Ext.mk₀ (ι' ≫ (eM.inv ≫ G.map r))) (add_zero _) := by
            rw [hst, Abelian.Ext.comp_mk₀_id]
        _ = e.comp ((Abelian.Ext.mk₀ ι').comp (Abelian.Ext.mk₀ (eM.inv ≫ G.map r)) (add_zero 0))
              (add_zero _) := by rw [Abelian.Ext.mk₀_comp_mk₀]
        _ = _ := (Abelian.Ext.comp_assoc _ _ _ (add_zero _) (add_zero 0) (by omega)).symm
    rw [he, hz, Abelian.Ext.zero_comp]

  have c1 : ∀ (G : SheafOfModules.{u+1} (wcZModSliceRing F X h (ℓ ^ m)) ⥤
      SheafOfModules.{u+1} (wcIntSliceRing F X h ℓ)) [G.Additive]
      [Limits.PreservesFiniteLimits G] [Limits.PreservesFiniteColimits G]
      (Xo : SheafOfModules.{u+1} (wcZModSliceRing F X h (ℓ ^ m)))
      (P : SheafOfModules.{u+1} (wcIntSliceRing F X h ℓ)) (ε : P ⟶ G.obj Xo),
      (∀ Y, Function.Bijective (fun f : Xo ⟶ Y => ε ≫ G.map f)) →
      (∀ (I : SheafOfModules.{u+1} (wcZModSliceRing F X h (ℓ ^ m))) [Injective I] (n : ℕ)
        (e : Abelian.Ext P (G.obj I) (n + 1)), e = 0) →
      ∀ (Y : SheafOfModules.{u+1} (wcZModSliceRing F X h (ℓ ^ m))) (n : ℕ),
        Function.Bijective (fun x : Abelian.Ext Xo Y n =>
          (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor G x) (zero_add n)) := by
    intro G _ _ _ Xo P ε ha hb
    have key : ∀ (n : ℕ) (Y : SheafOfModules.{u+1} (wcZModSliceRing F X h (ℓ ^ m))),
        Function.Bijective (fun x : Abelian.Ext Xo Y n =>
          (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor G x) (zero_add n)) := by
      intro n
      induction n with
      | zero =>
        intro Y
        have hm' : ∀ f : Xo ⟶ Y, (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor G
            (Abelian.Ext.mk₀ f)) (zero_add 0) = Abelian.Ext.mk₀ (ε ≫ G.map f) := by
          intro f
          rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀]
        constructor
        · intro x₁ x₂ hx
          have e1 := Abelian.Ext.mk₀_homEquiv₀_apply x₁
          have e2 := Abelian.Ext.mk₀_homEquiv₀_apply x₂
          simp only at hx
