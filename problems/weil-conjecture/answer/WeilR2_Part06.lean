  obtain ⟨V, OY, εO, s, hOY, hVirr, hεO, hεc, ⟨⟨t₀, ht₀⟩⟩, hgens, hFηfin, hcount⟩ :=
    wc_r2gi_generic_injective_chart K X B fB g ℓ hℓ hℓK m hm hfib U hUirr η hηcl hgen
