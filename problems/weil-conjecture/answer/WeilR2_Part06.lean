      intro y
      change ((((ι W).inv ≫ (ι W).hom).hom.app (Opposite.op (wcEtTop W))).hom y) = y
      rw [Iso.inv_hom_id]
      rfl
    change (((ι W).hom.hom.app (Opposite.op (wcEtTop W))).hom
      (((c W).hom.app (Opposite.op (wcEtTop W))).hom
        (wcConstSec W (ULift.{u+1} ℤ) (wcEtTop W) (ULift.up 1)))) = _
    rw [h1, ← h2, h3]
  refine ⟨N, hN, ?_⟩
  intro Y Z σ A D b

  have hjs : ∀ (Y₀ : Scheme.{u}) (V : Y₀.Etale) (T : Sieve V), (∀ v : V.left, ∃ (V₁ : Y₀.Etale)
      (c₀ : V₁ ⟶ V), T.arrows c₀ ∧ v ∈ Set.range c₀.left) → T ∈ Scheme.smallEtaleTopology Y₀ V := by
    intro Y₀ V T hT
    change T ∈ Scheme.smallGrothendieckTopology @Etale Y₀ V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y₀
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y₀
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c₀, hc₀, y, hy⟩ := hT x
    have hw : c₀.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c₀
    have hEt : Etale c₀.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c₀.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c₀.left V.hom
    exact ⟨V₁, c₀, y, hc₀, hEt, hy⟩
  have hcov : CoverPreserving (Scheme.smallEtaleTopology Y)
      (Scheme.smallEtaleTopology Z) (wcEtBaseChange σ) := by
    constructor
    intro V T hT
    change T ∈ Scheme.smallGrothendieckTopology @Etale Y V at hT
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hT
    have hT' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hT
    apply hjs
    intro v
    obtain ⟨W, a, w, ha, -, hw⟩ := hT' (Limits.pullback.fst V.hom σ v)
    refine ⟨(wcEtBaseChange σ).obj W, (wcEtBaseChange σ).map a,
      Sieve.image_mem_functorPushforward (wcEtBaseChange σ) T ha, ?_⟩
    have h0 : (Limits.pullback.fst W.hom σ ≫ a.left) ≫ V.hom = Limits.pullback.snd W.hom σ ≫ σ := by
      rw [Category.assoc, MorphismProperty.Over.w a]
      exact Limits.pullback.condition
    let mm : Limits.pullback W.hom σ ⟶ Limits.pullback V.hom σ :=
      Limits.pullback.lift (Limits.pullback.fst W.hom σ ≫ a.left) (Limits.pullback.snd W.hom σ) h0
    have hmap : ((wcEtBaseChange σ).map a).left = mm := rfl
    have h1 : Limits.pullback.fst a.left (Limits.pullback.fst V.hom σ) ≫ W.hom =
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom σ) ≫ Limits.pullback.snd V.hom σ) ≫ σ := by
      rw [← MorphismProperty.Over.w a, ← Category.assoc, Limits.pullback.condition, Category.assoc,
        Limits.pullback.condition, Category.assoc]
    let ψ : Limits.pullback a.left (Limits.pullback.fst V.hom σ) ⟶ Limits.pullback W.hom σ :=
      Limits.pullback.lift (Limits.pullback.fst a.left (Limits.pullback.fst V.hom σ))
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom σ) ≫ Limits.pullback.snd V.hom σ) h1
    have hψ : ψ ≫ mm = Limits.pullback.snd a.left (Limits.pullback.fst V.hom σ) := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, Limits.pullback.lift_fst,
          Limits.pullback.condition]
      · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
    obtain ⟨z, hz⟩ : ∃ z, Limits.pullback.snd a.left (Limits.pullback.fst V.hom σ) z = v := by
      have hv : (v : ↥(Limits.pullback V.hom σ)) ∈
          Set.range (Limits.pullback.snd a.left (Limits.pullback.fst V.hom σ)) := by
        rw [Scheme.Pullback.range_snd]
        exact ⟨w, hw⟩
      exact hv
    rw [hmap]
    exact ⟨ψ z, (Scheme.Hom.comp_apply ψ mm z).symm.trans (by rw [hψ]; exact hz)⟩
  haveI h1 : Limits.PreservesFiniteLimits (wcEtBaseChange σ) := ⟨fun J _ _ =>
    haveI : Limits.PreservesLimitsOfShape J (wcEtBaseChange σ ⋙ Scheme.Etale.forget Z) :=
      Limits.preservesLimitsOfShape_of_natIso
        (NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl) :
          Scheme.Etale.forget Y ⋙ Over.pullback σ ≅ wcEtBaseChange σ ⋙ Scheme.Etale.forget Z)
    Limits.preservesLimitsOfShape_of_reflects_of_preserves (wcEtBaseChange σ)
      (Scheme.Etale.forget Z)⟩
  haveI hflat : RepresentablyFlat (wcEtBaseChange σ) := flat_of_preservesFiniteLimits _
  haveI hcont : (wcEtBaseChange σ).IsContinuous (Scheme.smallEtaleTopology Y)
