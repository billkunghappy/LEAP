    · intro h
      have h' : closure ({b} : Set A) = closure {η} :=
        congrArg (fun s : TopologicalSpace.IrreducibleCloseds A => (s : Set A)) h
      have h1 : η ∈ closure ({b} : Set A) := h' ▸ subset_closure rfl
      exact hbη ((specializes_iff_mem_closure.mpr h1).antisymm
        (specializes_iff_mem_closure.mpr hspec)).eq
  have h_union : ∀ {Y : Type u} [TopologicalSpace Y] (A C : Set Y), IsClosed A → IsClosed C →
      topologicalKrullDim ↥A < (n : WithBot ℕ∞) → topologicalKrullDim ↥C < (n : WithBot ℕ∞) →
