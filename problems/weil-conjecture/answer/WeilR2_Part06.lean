      Z (wcFreeSheaf X.left (wcGeomPoint F X h)) ε₁ H1 (wcIntSheaf X.left ℓ) n
  have hAQb : ∀ n, Function.Bijective (AQ n) := by
    intro n
    have e : (⇑(AQ n)) = fun y => (Abelian.Ext.mk₀ ε₁).comp (Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)) y)
