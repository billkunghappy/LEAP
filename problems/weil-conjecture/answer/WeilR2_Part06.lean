    rw [hzero, map_zero]
  exact ⟨fun z₁ z₂ => (key z₁).trans (key z₂).symm⟩

theorem wc_et_fibration_R2_generic_iso : ∀ (K : Type u) [Field K] [IsAlgClosed K] (X B : Scheme.{u}) (fB : B ⟶ Spec (.of K)) [IsProper fB] (g : X ⟶ B) [IsProper g] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (m : ℕ), 1 ≤ m → ∀ n : ℕ, topologicalKrullDim B ≤ (n : WithBot ℕ∞) → (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ B), topologicalKrullDim ↥(Limits.pullback g t) ≤ ((1 : ℕ) : WithBot ℕ∞)) → ∀ (U : X.Opens), IrreducibleSpace ↥U → topologicalKrullDim ↥((U : Set X)ᶜ) ≤ (n : WithBot ℕ∞) → ∀ (T₁ : Set B), IsClosed T₁ → topologicalKrullDim ↥T₁ < (n : WithBot ℕ∞) → (∀ b : B, b ∉ T₁ → topologicalKrullDim ↥((U : Set X)ᶜ ∩ ⇑g ⁻¹' {b}) ≤ ((0 : ℕ) : WithBot ℕ∞)) → ∀ (η : B), closure ({η} : Set B) = closure (⇑g '' (U : Set X)) → topologicalKrullDim ↥(closure ({η} : Set B)) = (n : WithBot ℕ∞) → ¬ topologicalKrullDim ↥(⇑g ⁻¹' {η}) ≤ ((0 : ℕ) : WithBot ℕ∞) → ∀ (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ m)))))), ∃ (B'' : Scheme.{u}) (π : B'' ⟶ B) (Z'' : Scheme.{u}) (iZ : Z'' ⟶ B'') (T : Set B) (φ : (wcEtPush π).obj (wcEtExtZero B'' (Set.range iZ)ᶜ (ℓ ^ m)) ⟶ (((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 2), IsFinite π ∧ IsClosedImmersion iZ ∧ IrreducibleSpace B'' ∧ topologicalKrullDim B'' = (n : WithBot ℕ∞) ∧ topologicalKrullDim Z'' < (n : WithBot ℕ∞) ∧ IsClosed T ∧ topologicalKrullDim ↥T < (n : WithBot ℕ∞) ∧ ∀ b : B, b ∉ T → Subsingleton ((wcEtStalk B b).obj (Limits.kernel φ)) ∧ Subsingleton ((wcEtStalk B b).obj (Limits.cokernel φ)) :=
by
  intro K _ _ X B fB _ g _ ℓ hℓ hℓK m hm n hB hfib U hUirr hUc T₁ hT₁c hT₁d hT₁f η hηcl hηdim
    hηfib I
  classical

  have h_emb_le : ∀ {A Y : Type u} [TopologicalSpace A] [TopologicalSpace Y] (f : A → Y),
      Topology.IsEmbedding f → topologicalKrullDim A ≤ topologicalKrullDim Y := by
    intro A Y _ _ f hf
    rw [IsHomeomorph.topologicalKrullDim_eq _ hf.toHomeomorph.isHomeomorph]
    exact topologicalKrullDim_subspace_le _ _
  have h_empty : ∀ {A : Type u} [TopologicalSpace A], IsEmpty A → topologicalKrullDim A = ⊥ := by
    intro A _ hA
    unfold topologicalKrullDim
    rw [Order.krullDim_eq_bot_iff]
    exact ⟨fun s => isEmptyElim s.isIrreducible.nonempty.some⟩
  have h_lt_zero : ∀ {A : Type u} [TopologicalSpace A],
      topologicalKrullDim A < ((0 : ℕ) : WithBot ℕ∞) → IsEmpty A := by
    intro A _ h
    by_contra hne'
    rw [not_isEmpty_iff] at hne'
    obtain ⟨a⟩ := hne'
    haveI : Nonempty (TopologicalSpace.IrreducibleCloseds A) :=
      ⟨⟨closure {a}, isIrreducible_singleton.closure, isClosed_closure⟩⟩
    have h0 : (0 : WithBot ℕ∞) ≤ topologicalKrullDim A := Order.krullDim_nonneg
    have h1 : topologicalKrullDim A < 0 := by simpa using h
    exact absurd (lt_of_le_of_lt h0 h1) (lt_irrefl _)
  have h_succ : ∀ (x : WithBot ℕ∞) (k : ℕ),
      x < ((k + 1 : ℕ) : WithBot ℕ∞) ↔ x ≤ (k : WithBot ℕ∞) := by
    intro x k
    induction x using WithBot.recBotCoe with
    | bot => simp
    | coe y =>
      induction y using ENat.recTopCoe with
      | top =>
        have h1 : ((k : ℕ∞) : WithBot ℕ∞) < ((⊤ : ℕ∞) : WithBot ℕ∞) :=
          WithBot.coe_lt_coe.mpr (ENat.coe_lt_top k)
        have h2 : (((k + 1 : ℕ) : ℕ∞) : WithBot ℕ∞) < ((⊤ : ℕ∞) : WithBot ℕ∞) :=
          WithBot.coe_lt_coe.mpr (ENat.coe_lt_top _)
        constructor
        · intro h; exact absurd (lt_trans h h2) (lt_irrefl _)
        · intro h; exact absurd (lt_of_le_of_lt h h1) (lt_irrefl _)
      | coe j => norm_cast; omega
  have h_pos : ∀ {A : Type u} [TopologicalSpace A] [T0Space A] (b η : A),
      b ∈ closure ({η} : Set A) → b ≠ η → 0 < topologicalKrullDim A := by
    intro A _ _ b η hspec hbη
    unfold topologicalKrullDim
    rw [Order.krullDim_pos_iff]
    refine ⟨⟨closure {b}, isIrreducible_singleton.closure, isClosed_closure⟩,
      ⟨closure {η}, isIrreducible_singleton.closure, isClosed_closure⟩, ?_⟩
    refine lt_of_le_of_ne ?_ ?_
    · show closure {b} ⊆ closure {η}
