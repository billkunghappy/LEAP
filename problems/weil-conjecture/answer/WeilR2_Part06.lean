  intro K _ _ X B fB _ g _ ℓ hℓ hℓK n hB hfib U hUirr η hgen hD hUc hPη I
  classical
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  haveI : NeZero ℓ := ⟨hℓ.ne_zero⟩
  haveI : IsLocallyNoetherian B := LocallyOfFiniteType.isLocallyNoetherian fB
  haveI : CompactSpace B := QuasiCompact.compactSpace_of_compactSpace fB
  haveI : IsNoetherian B := ⟨⟩
  have h_emb_le : ∀ {A Y : Type u} [TopologicalSpace A] [TopologicalSpace Y] (f : A → Y),
      Topology.IsEmbedding f → topologicalKrullDim A ≤ topologicalKrullDim Y := by
    intro A Y _ _ f hf
    rw [IsHomeomorph.topologicalKrullDim_eq _ hf.toHomeomorph.isHomeomorph]
    exact topologicalKrullDim_subspace_le _ _

  have hgenpt : ∀ y : B, y ⤳ η → y = η := by
    intro y hy
    by_contra hne
    have hηy : η ∈ closure ({y} : Set B) := specializes_iff_mem_closure.mp hy
    have hyη : y ∉ closure ({η} : Set B) := fun h =>
      hne (hy.antisymm (specializes_iff_mem_closure.mpr h)).eq
    have hsub : closure ({η} : Set B) ⊆ closure ({y} : Set B) :=
      closure_minimal (Set.singleton_subset_iff.mpr hηy) isClosed_closure
    cases n with
    | zero =>
      have hpos : 0 < topologicalKrullDim B := by
        unfold topologicalKrullDim
        rw [Order.krullDim_pos_iff]
        refine ⟨⟨closure {η}, isIrreducible_singleton.closure, isClosed_closure⟩,
          ⟨closure {y}, isIrreducible_singleton.closure, isClosed_closure⟩, ?_⟩
        refine lt_of_le_of_ne ?_ ?_
        · show closure {η} ⊆ closure {y}
