    ext x
    constructor
    · rintro ⟨z, rfl⟩
      exact ⟨hsq.isoPullback.hom z, by rw [← Scheme.Hom.comp_apply, hsq.isoPullback_hom_fst]⟩
    · rintro ⟨w, rfl⟩
      exact ⟨hsq.isoPullback.inv w, by rw [← Scheme.Hom.comp_apply, hinv]⟩
