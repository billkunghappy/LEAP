      Function.Bijective (fun f : wcFtcFS X U ⟶ Y => γ ≫ A.L.map f) := by
    intro Y
    have hev := wc_et_const_hom_eval_bij U.left (A.L.obj Y)
    have hcr := wc_et_free_sheaf_corep U Y
    have hr := wc_et_univ_transport_bijective_of_iso U.hom Y (A.L.obj Y) (A.ρ Y) (A.nut.1 Y) U
      (wcEtTop U.left) (𝟙 U.left) hσ₀ (IsIso.id _)
    have hkey : (fun g : wcR2gsZ U.left ⟶ A.L.obj Y =>
          (g.hom.app (Opposite.op (wcEtTop U.left))).hom
            (wcConstSec U.left (ULift.{u+1} ℤ) (wcEtTop U.left) (ULift.up 1))) ∘
        (fun f : wcFtcFS X U ⟶ Y => γ ≫ A.L.map f) =
        (fun x => (A.ρ Y).ρ U (wcEtTop U.left) (𝟙 U.left) hσ₀ x) ∘
          (fun φ : wcFtcFS X U ⟶ Y => (φ.hom.app (Opposite.op U)).hom (wcFtcGen X U)) := by
      funext f
      simp only [Function.comp_apply]
      rw [A.nut.2 (wcFtcFS X U) Y f U (wcEtTop U.left) (𝟙 U.left) hσ₀ (wcFtcGen X U)]
