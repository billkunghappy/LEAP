    haveI : Mono g := (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y ℓ)).mono_of_mono_map hmg
    let r : M ⟶ I := Injective.factorThru (𝟙 I) g
    have hr : g ≫ r = 𝟙 I := Injective.comp_factorThru _ _
    have hst : ι' ≫ (eM.inv ≫ (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y ℓ)).map r) =
        𝟙 ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y ℓ)).obj I) := by
      rw [← Category.assoc, ← hg, ← Functor.map_comp, hr,
        (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y ℓ)).map_id]
    have hz : e.comp (Abelian.Ext.mk₀ ι') (add_zero _) = 0 := L2 K k _
    have he : e = (e.comp (Abelian.Ext.mk₀ ι') (add_zero _)).comp
        (Abelian.Ext.mk₀ (eM.inv ≫ (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y ℓ)).map r))
        (add_zero _) := by
      calc e = e.comp (Abelian.Ext.mk₀ (ι' ≫ (eM.inv ≫
              (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y ℓ)).map r))) (add_zero _) := by
            rw [hst, Abelian.Ext.comp_mk₀_id]
        _ = e.comp ((Abelian.Ext.mk₀ ι').comp (Abelian.Ext.mk₀ (eM.inv ≫
              (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y ℓ)).map r)) (add_zero 0))
              (add_zero _) := by rw [Abelian.Ext.mk₀_comp_mk₀]
        _ = _ := (Abelian.Ext.comp_assoc _ _ _ (add_zero _) (add_zero 0) (by omega)).symm
    rw [he, hz, Abelian.Ext.zero_comp]



  have hΦ := ext_transfer_of_corep (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y ℓ))
    N ZT (ε₀ ≫ eN.inv) hhom hvan (SheafOfModules.unit (wcEtZModRing Y ℓ)) q

  obtain ⟨ιu⟩ := wc_et_zmod_unit_toSheaf_iso Y ℓ
  have hΨ : Function.Bijective (fun y : Abelian.Ext ZT
      ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y ℓ)).obj
        (SheafOfModules.unit (wcEtZModRing Y ℓ))) q =>
      y.comp (Abelian.Ext.mk₀ ιu.hom) (add_zero q)) := by
    refine ⟨fun y₁ y₂ hy => ?_, fun z => ⟨z.comp (Abelian.Ext.mk₀ ιu.inv) (add_zero q), ?_⟩⟩
    · have hy' := congrArg (fun t => t.comp (Abelian.Ext.mk₀ ιu.inv) (add_zero q)) hy
