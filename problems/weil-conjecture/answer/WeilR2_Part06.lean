        (MorphismProperty.Over.homMk V.hom rfl trivial : (wcEtSlice U').obj V ⟶ U')
      have e3 := hgnat U (k V)
        ((MorphismProperty.Over.homMk V.hom rfl trivial : (wcEtSlice U').obj V ⟶ U') ≫ h)
      have e4 := hres (MorphismProperty.Over.mk ⊤ h.left hk : U.left.Etale) (ULift.{u+1} ℤ) V (ULift.up 1)
      have e5 := ha U ((wcEtSlice (MorphismProperty.Over.mk ⊤ h.left hk : U.left.Etale)).obj V)
