      let C : Set ↥S := Subtype.val ⁻¹' closure ({η} : Set B)
      have hC : IsClosed C := isClosed_closure.preimage continuous_subtype_val
      have hdense : Dense Cᶜ := hC.isOpen_compl.dense ⟨⟨y, subset_closure rfl⟩, fun h => hyη h⟩
      have hS : topologicalKrullDim ↥S ≤ ((m + 1 : ℕ) : WithBot ℕ∞) :=
