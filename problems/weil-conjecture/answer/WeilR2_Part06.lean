    exact Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat _ _) (hcov g)
  have hg₀ : g ≫ (wcEtTop S).hom = (wcEtTop Z).hom ≫ g :=
    (Category.comp_id _).trans (Category.id_comp _).symm
  let bang : ∀ {Y : Scheme.{u}} (W : Y.Etale), W ⟶ wcEtTop Y := fun W =>
    MorphismProperty.Over.homMk W.hom (Category.comp_id _) trivial

  have hA : ∀ a : ULift.{u+1} (ZMod m),
      a = (ZMod.cast a.down : ℤ) • (ULift.up 1 : ULift.{u+1} (ZMod m)) := by
    intro a
    apply ULift.ext
    show a.down = (ZMod.cast a.down : ℤ) • (1 : ZMod m)
    rw [zsmul_one, ZMod.intCast_zmod_cast]
  have h1m : m • (ULift.up 1 : ULift.{u+1} (ZMod m)) = 0 := by
    apply ULift.ext
    show m • (1 : ZMod m) = 0
    rw [nsmul_one, ZMod.natCast_self]
  have Hcz : ∀ (X : Scheme.{u}) (V : X.Etale) (n : ℤ) (a : ULift.{u+1} (ZMod m)),
      wcConstSec X (ULift.{u+1} (ZMod m)) V (n • a) =
        n • wcConstSec X (ULift.{u+1} (ZMod m)) V a := by
    intro X V n a
    exact map_zsmul (((toSheafify (Scheme.smallEtaleTopology X)
      ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).app
        (Opposite.op V)).hom) n a
  have Hcn : ∀ (X : Scheme.{u}) (V : X.Etale) (n : ℕ) (a : ULift.{u+1} (ZMod m)),
      wcConstSec X (ULift.{u+1} (ZMod m)) V (n • a) =
        n • wcConstSec X (ULift.{u+1} (ZMod m)) V a := by
    intro X V n a
    exact map_nsmul (((toSheafify (Scheme.smallEtaleTopology X)
      ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).app
        (Opposite.op V)).hom) n a
  have Hc0 : ∀ (X : Scheme.{u}) (V : X.Etale),
      wcConstSec X (ULift.{u+1} (ZMod m)) V 0 = 0 := by
    intro X V
    exact map_zero (((toSheafify (Scheme.smallEtaleTopology X)
      ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).app
        (Opposite.op V)).hom)
  have Hgen : ∀ (X : Scheme.{u}) (V : X.Etale) {B : AddCommGrpCat.{u+1}}
      (φ : (wcConstZ X m).obj.obj (Opposite.op V) →+ B) (a : ULift.{u+1} (ZMod m)),
      φ (wcConstSec X (ULift.{u+1} (ZMod m)) V a) =
        (ZMod.cast a.down : ℤ) • φ (wcConstSec X (ULift.{u+1} (ZMod m)) V (ULift.up 1)) := by
    intro X V B φ a
    conv_lhs => rw [hA a]
    rw [Hcz, map_zsmul]

  have Hid : ∀ {X : Scheme.{u}} (G : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (A : X.Etale)
      (y : G.obj (Opposite.op A)), G.map (𝟙 A).op y = y := by
    intro X G A y
    rw [op_id, CategoryTheory.Functor.map_id]
    rfl
  have Hmapcomp : ∀ {X : Scheme.{u}} (G : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) {A B C : X.Etale}
      (g1 : A ⟶ B) (g2 : B ⟶ C) (y : G.obj (Opposite.op C)),
      (G.map g1.op).hom ((G.map g2.op).hom y) = (G.map (g1 ≫ g2).op).hom y := by
    intro X G A B C g1 g2 y
    rw [op_comp, G.map_comp]
    rfl
  have Hconst : ∀ (X : Scheme.{u}) (V O : X.Etale) (q : O ⟶ V) (a : ULift.{u+1} (ZMod m)),
      ((wcConstZ X m).obj.map q.op).hom (wcConstSec X (ULift.{u+1} (ZMod m)) V a) =
        wcConstSec X (ULift.{u+1} (ZMod m)) O a := by
    intro X V O q a
    have h := (toSheafify (Scheme.smallEtaleTopology X)
      ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).naturality q.op
    exact (congrArg (fun φ => AddCommGrpCat.Hom.hom φ a) h).symm
  have pc : ∀ {Y Z : Scheme.{u}} (f : Y ⟶ Z) (V : Z.Etale),
      Limits.pullback.fst V.hom f ≫ V.hom = ((wcEtBaseChange f).obj V).hom ≫ f := by
    intro Y Z f V
    change Limits.pullback.fst V.hom f ≫ V.hom = Limits.pullback.snd V.hom f ≫ f
    exact Limits.pullback.condition
  have hBc_fst : ∀ {Y Z : Scheme.{u}} (f : Y ⟶ Z) (V V' : Z.Etale) (c : V' ⟶ V),
      Limits.pullback.fst V'.hom f ≫ c.left =
        ((wcEtBaseChange f).map c).left ≫ Limits.pullback.fst V.hom f := by
    intro Y Z f V V' c
    change Limits.pullback.fst V'.hom f ≫ c.left =
      Limits.pullback.lift (Limits.pullback.fst V'.hom f ≫ c.left)
        (Limits.pullback.snd V'.hom f)
        (by rw [Category.assoc, MorphismProperty.Over.w c]; exact Limits.pullback.condition) ≫
        Limits.pullback.fst V.hom f
    rw [Limits.pullback.lift_fst]
  let ℓ : ∀ {Y Z : Scheme.{u}} (f : Y ⟶ Z) (V : Z.Etale) (O : Y.Etale) (k : O.left ⟶ V.left),
      k ≫ V.hom = O.hom ≫ f → (O ⟶ (wcEtBaseChange f).obj V) :=
    fun f V O k hk => MorphismProperty.Over.homMk (Limits.pullback.lift k O.hom hk)
      (Limits.pullback.lift_snd _ _ _) trivial
  have Hℓfst : ∀ {Y Z : Scheme.{u}} (f : Y ⟶ Z) (V : Z.Etale) (O : Y.Etale) (k : O.left ⟶ V.left)
      (hk : k ≫ V.hom = O.hom ≫ f),
      k ≫ (𝟙 V : V ⟶ V).left = (ℓ f V O k hk).left ≫ Limits.pullback.fst V.hom f := by
    intro Y Z f V O k hk
    change k ≫ 𝟙 V.left = Limits.pullback.lift k O.hom hk ≫ Limits.pullback.fst V.hom f
    rw [Category.comp_id, Limits.pullback.lift_fst]
  have Eℓ1 : ∀ {Y Z : Scheme.{u}} (f : Y ⟶ Z) (V V' : Z.Etale) (c : V' ⟶ V) (O O' : Y.Etale)
      (d : O' ⟶ O) (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ f)
      (h' : O'.left ⟶ V'.left) (hh' : h' ≫ V'.hom = O'.hom ≫ f),
      h' ≫ c.left = d.left ≫ h → ℓ f V' O' h' hh' ≫ (wcEtBaseChange f).map c = d ≫ ℓ f V O h hh := by
    intro Y Z f V V' c O O' d h hh h' hh' H
    apply MorphismProperty.Over.Hom.ext
    change Limits.pullback.lift h' O'.hom hh' ≫
        Limits.pullback.lift (Limits.pullback.fst V'.hom f ≫ c.left)
          (Limits.pullback.snd V'.hom f)
          (by rw [Category.assoc, MorphismProperty.Over.w c]; exact Limits.pullback.condition) =
      d.left ≫ Limits.pullback.lift h O.hom hh
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_fst_assoc]
      exact H
    · simp only [Category.assoc, Limits.pullback.lift_snd]
      exact (MorphismProperty.Over.w d).symm

  have Hex : ∀ {Y Z : Scheme.{u}} (f : Y ⟶ Z),
      ∃ c : wcEtTransport f (wcConstZ Z m) (wcConstZ Y m),
        ∀ (V : Z.Etale) (O : Y.Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ f)
          (a : ULift.{u+1} (ZMod m)),
          c.ρ V O k hk (wcConstSec Z (ULift.{u+1} (ZMod m)) V a) =
            wcConstSec Y (ULift.{u+1} (ZMod m)) O a := by
    intro Y Z f
    haveI := hcont f
    have hQ : Presheaf.IsSheaf (Scheme.smallEtaleTopology Z)
        ((wcEtBaseChange f).op ⋙ (wcConstZ Y m).obj) :=
      Functor.op_comp_isSheaf (wcEtBaseChange f) _ _ (wcConstZ Y m)
    let ψ : (Functor.const (Z.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ⟶
        (wcEtBaseChange f).op ⋙ (wcConstZ Y m).obj :=
      { app := fun V => (toSheafify (Scheme.smallEtaleTopology Y)
            ((Functor.const (Y.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).app
            (Opposite.op ((wcEtBaseChange f).obj V.unop))
        naturality := fun V V' g =>
          (Functor.whiskerLeft (wcEtBaseChange f).op (toSheafify (Scheme.smallEtaleTopology Y)
            ((Functor.const (Y.Etale)ᵒᵖ).obj
              (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))))).naturality g }
    let φ := sheafifyLift (Scheme.smallEtaleTopology Z) ψ hQ
    have hφ : toSheafify (Scheme.smallEtaleTopology Z) _ ≫ φ = ψ :=
      toSheafify_sheafifyLift (Scheme.smallEtaleTopology Z) ψ hQ
    refine ⟨{ ρ := fun V O k hk => ((wcConstZ Y m).obj.map (ℓ f V O k hk).op).hom.comp
                (φ.app (Opposite.op V)).hom
              nat := ?_ }, ?_⟩
    · intro V V' c O O' d h hh h' hh' H x
      have h1 : (φ.app (Opposite.op V')).hom (((wcConstZ Z m).obj.map c.op).hom x) =
          ((wcConstZ Y m).obj.map ((wcEtBaseChange f).map c).op).hom
            ((φ.app (Opposite.op V)).hom x) :=
        congrArg (fun g => AddCommGrpCat.Hom.hom g x) (φ.naturality c.op)
      show ((wcConstZ Y m).obj.map (ℓ f V' O' h' hh').op).hom
          ((φ.app (Opposite.op V')).hom (((wcConstZ Z m).obj.map c.op).hom x)) =
        ((wcConstZ Y m).obj.map d.op).hom (((wcConstZ Y m).obj.map (ℓ f V O h hh).op).hom
          ((φ.app (Opposite.op V)).hom x))
      exact (congrArg (fun y => ((wcConstZ Y m).obj.map (ℓ f V' O' h' hh').op).hom y) h1).trans
        ((Hmapcomp _ _ _ _).trans ((congrArg (fun t : O' ⟶ (wcEtBaseChange f).obj V =>
          ((wcConstZ Y m).obj.map t.op).hom ((φ.app (Opposite.op V)).hom x))
          (Eℓ1 f V V' c O O' d h hh h' hh' H)).trans (Hmapcomp _ _ _ _).symm))
    · intro V O k hk a
      have h2 : (φ.app (Opposite.op V)).hom (wcConstSec Z (ULift.{u+1} (ZMod m)) V a) =
          wcConstSec Y (ULift.{u+1} (ZMod m)) ((wcEtBaseChange f).obj V) a :=
        congrArg (fun g => (g.app (Opposite.op V)).hom a) hφ
      show ((wcConstZ Y m).obj.map (ℓ f V O k hk).op).hom
          ((φ.app (Opposite.op V)).hom (wcConstSec Z (ULift.{u+1} (ZMod m)) V a)) = _
      exact (congrArg (fun y => ((wcConstZ Y m).obj.map (ℓ f V O k hk).op).hom y) h2).trans
        (Hconst Y _ _ _ a)

  have Huniq : ∀ {Y Z : Scheme.{u}} (f : Y ⟶ Z)
      (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (τ τ' : wcEtTransport f (wcConstZ Z m) G),
      (∀ (V : Z.Etale) (O : Y.Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ f)
        (a : ULift.{u+1} (ZMod m)),
        τ.ρ V O k hk (wcConstSec Z (ULift.{u+1} (ZMod m)) V a) =
          τ'.ρ V O k hk (wcConstSec Z (ULift.{u+1} (ZMod m)) V a)) →
      ∀ (V : Z.Etale) (O : Y.Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ f)
        (x : (wcConstZ Z m).obj.obj (Opposite.op V)), τ.ρ V O k hk x = τ'.ρ V O k hk x := by
    intro Y Z f G τ τ' hc
    haveI := hcont f
    have hQ : Presheaf.IsSheaf (Scheme.smallEtaleTopology Z) ((wcEtBaseChange f).op ⋙ G.obj) :=
      Functor.op_comp_isSheaf (wcEtBaseChange f) _ _ G
    let χ : wcEtTransport f (wcConstZ Z m) G →
        ((sheafify (Scheme.smallEtaleTopology Z)
          ((Functor.const (Z.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) ⟶
          (wcEtBaseChange f).op ⋙ G.obj) := fun r =>
      { app := fun V => AddCommGrpCat.ofHom (r.ρ V.unop ((wcEtBaseChange f).obj V.unop)
            (Limits.pullback.fst V.unop.hom f) (pc f V.unop))
        naturality := fun V V' g => by
          ext x
          exact r.nat V.unop V'.unop g.unop _ _ ((wcEtBaseChange f).map g.unop) _ _ _ _
            (hBc_fst f V.unop V'.unop g.unop) x }
    have hχ : χ τ = χ τ' := by
      apply sheafify_hom_ext _ _ _ hQ
      ext V a
      exact hc V.unop ((wcEtBaseChange f).obj V.unop) (Limits.pullback.fst V.unop.hom f)
        (pc f V.unop) a
    have hB : ∀ (V : Z.Etale) (x : (wcConstZ Z m).obj.obj (Opposite.op V)),
        τ.ρ V ((wcEtBaseChange f).obj V) (Limits.pullback.fst V.hom f) (pc f V) x =
          τ'.ρ V ((wcEtBaseChange f).obj V) (Limits.pullback.fst V.hom f) (pc f V) x :=
      fun V x => congrArg (fun g => (g.app (Opposite.op V)).hom x) hχ
    intro V O k hk x
    have e1 := τ.nat V V (𝟙 V) ((wcEtBaseChange f).obj V) O (ℓ f V O k hk)
      (Limits.pullback.fst V.hom f) (pc f V) k hk (Hℓfst f V O k hk) x
    have e2 := τ'.nat V V (𝟙 V) ((wcEtBaseChange f).obj V) O (ℓ f V O k hk)
      (Limits.pullback.fst V.hom f) (pc f V) k hk (Hℓfst f V O k hk) x
    rw [Hid] at e1 e2
    rw [e1, e2, hB V x]

  have Hrig : ∀ (M : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
      (τ₁ τ₂ : wcEtTransport g (wcConstZ S m) M),
      τ₁.ρ (wcEtTop S) (wcEtTop Z) g hg₀
          (wcConstSec S (ULift.{u+1} (ZMod m)) (wcEtTop S) (ULift.up 1)) =
        τ₂.ρ (wcEtTop S) (wcEtTop Z) g hg₀
          (wcConstSec S (ULift.{u+1} (ZMod m)) (wcEtTop S) (ULift.up 1)) →
      ∀ (V : S.Etale) (O : Z.Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ g)
        (x : (wcConstZ S m).obj.obj (Opposite.op V)), τ₁.ρ V O k hk x = τ₂.ρ V O k hk x := by
    intro M τ₁ τ₂ h1
    have hv : ∀ (τ : wcEtTransport g (wcConstZ S m) M) (V : S.Etale) (O : Z.Etale)
        (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ g) (a : ULift.{u+1} (ZMod m)),
        τ.ρ V O k hk (wcConstSec S (ULift.{u+1} (ZMod m)) V a) =
          (M.obj.map (bang O).op).hom (τ.ρ (wcEtTop S) (wcEtTop Z) g hg₀
            (wcConstSec S (ULift.{u+1} (ZMod m)) (wcEtTop S) a)) := by
      intro τ V O k hk a
      exact (congrArg (fun y => τ.ρ V O k hk y) (Hconst S (wcEtTop S) V (bang V) a).symm).trans
        (τ.nat (wcEtTop S) V (bang V) (wcEtTop Z) O (bang O) g hg₀ k hk hk
          (wcConstSec S (ULift.{u+1} (ZMod m)) (wcEtTop S) a))
    apply Huniq g M τ₁ τ₂
    intro V O k hk a
    rw [hv τ₁ V O k hk a, hv τ₂ V O k hk a,
      Hgen S (wcEtTop S) (τ₁.ρ (wcEtTop S) (wcEtTop Z) g hg₀) a,
      Hgen S (wcEtTop S) (τ₂.ρ (wcEtTop S) (wcEtTop Z) g hg₀) a, h1]

  have Hext : ∀ (Y : Scheme.{u}) (M : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (f₁ f₂ : wcConstZ Y m ⟶ M),
      (f₁.hom.app (Opposite.op (wcEtTop Y))).hom
          (wcConstSec Y (ULift.{u+1} (ZMod m)) (wcEtTop Y) (ULift.up 1)) =
        (f₂.hom.app (Opposite.op (wcEtTop Y))).hom
          (wcConstSec Y (ULift.{u+1} (ZMod m)) (wcEtTop Y) (ULift.up 1)) →
      f₁ = f₂ := by
    intro Y M f₁ f₂ h1
    have hval : ∀ (f : wcConstZ Y m ⟶ M) (U : Y.Etale) (a : ULift.{u+1} (ZMod m)),
        (f.hom.app (Opposite.op U)).hom (wcConstSec Y (ULift.{u+1} (ZMod m)) U a) =
          (M.obj.map (bang U).op).hom ((ZMod.cast a.down : ℤ) •
            (f.hom.app (Opposite.op (wcEtTop Y))).hom
              (wcConstSec Y (ULift.{u+1} (ZMod m)) (wcEtTop Y) (ULift.up 1))) := by
      intro f U a
      rw [← Hgen Y (wcEtTop Y) (f.hom.app (Opposite.op (wcEtTop Y))).hom a,
        ← Hconst Y (wcEtTop Y) U (bang U) a]
      exact congrArg (fun φ => AddCommGrpCat.Hom.hom φ
        (wcConstSec Y (ULift.{u+1} (ZMod m)) (wcEtTop Y) a)) (f.hom.naturality (bang U).op)
    apply Sheaf.hom_ext
    refine sheafify_hom_ext (Scheme.smallEtaleTopology Y)
      (P := (Functor.const (Y.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))
      f₁.hom f₂.hom M.property ?_
    ext U a
    have e := hval f₁ U.unop a
    have e' := hval f₂ U.unop a
    rw [h1] at e
    exact e.trans e'.symm

  have Hψ : ∀ (Y : Scheme.{u}) (m : ℕ) (F : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (z : F.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y)))), m • z = 0 →
      ∃ ψ : (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ⟶ F,
        (ψ.hom.app (Opposite.op (Scheme.Etale.mk (𝟙 Y)))).hom
          (wcConstSec Y (ULift.{u+1} (ZMod m)) (Scheme.Etale.mk (𝟙 Y)) (ULift.up 1)) = z := by
    intro Y m F z hz
    let bang : ∀ W : Y.Etale, W ⟶ Scheme.Etale.mk (𝟙 Y) := fun W =>
      MorphismProperty.Over.homMk W.hom (Category.comp_id _) trivial
    have huniq : ∀ (W : Y.Etale) (q : W ⟶ Scheme.Etale.mk (𝟙 Y)), q = bang W := by
      intro W q
      apply MorphismProperty.Over.Hom.ext
      have h := MorphismProperty.Over.w q
      exact (Category.comp_id _).symm.trans h
    let g : ℤ →+ F.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y))) :=
      zmultiplesHom (F.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y)))) z
    have hg : g (m : ℤ) = 0 := by
      change ((m : ℤ)) • z = 0
      rw [natCast_zsmul, hz]
    let f₀ : ZMod m →+ F.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y))) := ZMod.lift m ⟨g, hg⟩
    have hf₀ : f₀ 1 = z := by
      have h := ZMod.lift_coe m ⟨g, hg⟩ (1 : ℤ)
      rw [Int.cast_one] at h
      change f₀ 1 = g 1 at h
      rw [h]
      change (1 : ℤ) • z = z
      exact one_zsmul z
    let x : ∀ U : (Y.Etale)ᵒᵖ, F.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y))) →+ F.obj.obj U :=
      fun U => (F.obj.map (bang U.unop).op).hom
    have hx : ∀ {U U' : (Y.Etale)ᵒᵖ} (f : U ⟶ U') (a : F.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y)))),
        (F.obj.map f).hom (x U a) = x U' a := by
      intro U U' f a
      have h1 := congrArg (fun φ => φ.hom a) (F.obj.map_comp (bang U.unop).op f)
      have h2 : (bang U.unop).op ≫ f = (bang U'.unop).op := by
        change (f.unop ≫ bang U.unop).op = (bang U'.unop).op
        rw [huniq _ (f.unop ≫ bang U.unop)]
      rw [h2] at h1
      exact h1.symm
    let η : (Functor.const (Y.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ⟶ F.obj :=
      { app := fun U => AddCommGrpCat.ofHom
          (((x U).comp f₀).comp AddEquiv.ulift.toAddMonoidHom)
        naturality := by
          intro U U' f
          apply AddCommGrpCat.ext
          intro n
          change x U' (f₀ n.down) = (F.obj.map f).hom (x U (f₀ n.down))
          rw [hx] }
    let ψ : (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ⟶ F :=
      ObjectProperty.homMk (sheafifyLift (Scheme.smallEtaleTopology Y) η F.property)
    have hK : toSheafify (Scheme.smallEtaleTopology Y)
        ((Functor.const (Y.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) ≫ ψ.hom = η :=
      toSheafify_sheafifyLift (Scheme.smallEtaleTopology Y) η F.property
    refine ⟨ψ, ?_⟩
    have h := congrArg (fun φ => (φ.app (Opposite.op (Scheme.Etale.mk (𝟙 Y)))).hom
      (ULift.up (1 : ZMod m))) hK
    change (ψ.hom.app (Opposite.op (Scheme.Etale.mk (𝟙 Y)))).hom
      (((toSheafify (Scheme.smallEtaleTopology Y)
        ((Functor.const (Y.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).app
          (Opposite.op (Scheme.Etale.mk (𝟙 Y)))).hom (ULift.up 1)) =
        x (Opposite.op (Scheme.Etale.mk (𝟙 Y))) (f₀ 1) at h
    have hb : bang (Scheme.Etale.mk (𝟙 Y)) = 𝟙 _ := (huniq _ (𝟙 _)).symm
    have hxT : x (Opposite.op (Scheme.Etale.mk (𝟙 Y))) (f₀ 1) = z := by
      change (F.obj.map (bang (Scheme.Etale.mk (𝟙 Y))).op).hom (f₀ 1) = z
      rw [hb, op_id, F.obj.map_id, hf₀]
      rfl
    exact h.trans hxT

  obtain ⟨T', hT'⟩ := Hex g
  obtain ⟨φ, hφ, -⟩ := hU (wcConstZ S m) (wcConstZ Z m) T'
  have hr : m • ((ρ (wcConstZ S m)).ρ (wcEtTop S) (wcEtTop Z) g hg₀
      (wcConstSec S (ULift.{u+1} (ZMod m)) (wcEtTop S) (ULift.up 1))) = 0 := by
    rw [← map_nsmul ((ρ (wcConstZ S m)).ρ (wcEtTop S) (wcEtTop Z) g hg₀),
      ← Hcn S (wcEtTop S) m (ULift.up 1), h1m, Hc0 S (wcEtTop S), map_zero]
  obtain ⟨ψ, hψ⟩ : ∃ ψ : wcConstZ Z m ⟶ L.obj (wcConstZ S m),
      (ψ.hom.app (Opposite.op (wcEtTop Z))).hom
          (wcConstSec Z (ULift.{u+1} (ZMod m)) (wcEtTop Z) (ULift.up 1)) =
        (ρ (wcConstZ S m)).ρ (wcEtTop S) (wcEtTop Z) g hg₀
          (wcConstSec S (ULift.{u+1} (ZMod m)) (wcEtTop S) (ULift.up 1)) :=
    Hψ Z m (L.obj (wcConstZ S m)) ((ρ (wcConstZ S m)).ρ (wcEtTop S) (wcEtTop Z) g hg₀
      (wcConstSec S (ULift.{u+1} (ZMod m)) (wcEtTop S) (ULift.up 1))) hr
  have h_inv_hom : ψ ≫ φ = 𝟙 (wcConstZ Z m) := by
    apply Hext Z (wcConstZ Z m)
    exact (congrArg (fun y => (φ.hom.app (Opposite.op (wcEtTop Z))).hom y) hψ).trans
      ((hφ (wcEtTop S) (wcEtTop Z) g hg₀ _).trans (hT' (wcEtTop S) (wcEtTop Z) g hg₀ (ULift.up 1)))
  let Tψ : wcEtTransport g (wcConstZ S m) (L.obj (wcConstZ S m)) :=
    { ρ := fun V O h hh => (ψ.hom.app (Opposite.op O)).hom.comp (T'.ρ V O h hh)
      nat := by
        intro V V' c O O' d h hh h' hh' H x
        show (ψ.hom.app (Opposite.op O')).hom (T'.ρ V' O' h' hh' ((wcConstZ S m).obj.map c.op x)) =
          ((L.obj (wcConstZ S m)).obj.map d.op).hom
            ((ψ.hom.app (Opposite.op O)).hom (T'.ρ V O h hh x))
        rw [T'.nat V V' c O O' d h hh h' hh' H x]
        exact congrArg (fun f => AddCommGrpCat.Hom.hom f (T'.ρ V O h hh x)) (ψ.hom.naturality d.op) }
  have hTψ : ∀ (V : S.Etale) (O : Z.Etale) (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ g)
      (x : (wcConstZ S m).obj.obj (Opposite.op V)),
      Tψ.ρ V O h hh x = (ρ (wcConstZ S m)).ρ V O h hh x := by
    apply Hrig (L.obj (wcConstZ S m)) Tψ (ρ (wcConstZ S m))
    exact (congrArg (fun y => (ψ.hom.app (Opposite.op (wcEtTop Z))).hom y)
      (hT' (wcEtTop S) (wcEtTop Z) g hg₀ (ULift.up 1))).trans hψ
  obtain ⟨φ₀, -, huniq⟩ := hU (wcConstZ S m) (L.obj (wcConstZ S m)) (ρ (wcConstZ S m))
  have h_hom_inv : φ ≫ ψ = 𝟙 (L.obj (wcConstZ S m)) := by
    have e1 := huniq (φ ≫ ψ) (fun V O h hh x => by
      show (ψ.hom.app (Opposite.op O)).hom ((φ.hom.app (Opposite.op O)).hom
        ((ρ (wcConstZ S m)).ρ V O h hh x)) = _
      rw [hφ]
      exact hTψ V O h hh x)
    have e2 := huniq (𝟙 _) (fun V O h hh x => rfl)
    exact e1.trans e2.symm
  refine ⟨Iso.mk φ ψ h_hom_inv h_inv_hom, fun hg => ?_⟩
  exact (hφ (wcEtTop S) (wcEtTop Z) g hg _).trans (hT' (wcEtTop S) (wcEtTop Z) g hg (ULift.up 1))

theorem wc_r2gs_zmod_change_rings_pull : ∀ (m : ℕ), m ≠ 0 → ∀ q : ℕ,
    ∃ N : ∀ Y : Scheme.{u}, wcEtZModExt Y m q →+ wcR2gsH Y m q,
      (∀ Y, Function.Bijective (N Y)) ∧
      ∀ {Y Z : Scheme.{u}} (σ : Z ⟶ Y) (A : wcR2gsAdjData σ m) (D : wcEtPullData σ m)
        (b : wcEtZModExt Y m q), N Z (wcEtPull D q b) = wcR2gsAPull A q (N Y b) :=
by
  intro m hm q
  classical

  have hPFC : ∀ Y : Scheme.{u},
      Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y m)) :=
    fun Y => sheafOfModules_toSheaf_preservesFiniteColimits _ _
  choose c hc hbij using fun Y : Scheme.{u} => @wc_r2gs_zmod_unit_corep Y m hm (hPFC Y)
  choose ι hι using fun Y : Scheme.{u} => wc_r2gs_zmod_unit_const_iso Y m

  let N : ∀ Y : Scheme.{u}, wcEtZModExt Y m q →+ wcR2gsH Y m q := fun Y =>
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y m)) := HasExt.standard _
    haveI := hPFC Y
    AddMonoidHom.mk' (fun β => ((Abelian.Ext.mk₀ (c Y)).comp
        (Abelian.Ext.mapExactFunctor (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y m)) β)
        (zero_add q)).comp (Abelian.Ext.mk₀ (ι Y).hom) (add_zero q))
      (fun a b => by
        rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.comp_add, Abelian.Ext.add_comp])

  have hN : ∀ Y : Scheme.{u}, Function.Bijective (N Y) := by
    intro Y
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y m)) := HasExt.standard _
    haveI := hPFC Y
    have h1 : Function.Bijective (fun β : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y m))
        (SheafOfModules.unit (wcEtZModRing Y m)) q => (Abelian.Ext.mk₀ (c Y)).comp
        (Abelian.Ext.mapExactFunctor (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y m)) β)
        (zero_add q)) := hbij Y (SheafOfModules.unit (wcEtZModRing Y m)) q
    have h2 : Function.Bijective (fun y : Abelian.Ext
        ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} ℤ)))
        ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y m)).obj
          (SheafOfModules.unit (wcEtZModRing Y m))) q =>
        y.comp (Abelian.Ext.mk₀ (ι Y).hom) (add_zero q)) := by
      refine ⟨fun y₁ y₂ hy => ?_, fun z => ⟨z.comp (Abelian.Ext.mk₀ (ι Y).inv) (add_zero q), ?_⟩⟩
      · have hy' := congrArg (fun t => t.comp (Abelian.Ext.mk₀ (ι Y).inv) (add_zero q)) hy
        simp only at hy'
        rwa [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
          Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id,
          Abelian.Ext.comp_mk₀_id] at hy'
      · simp only
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
    exact h2.comp h1

  have indep : ∀ {S S' : Scheme.{u}} {h : S' ⟶ S} (D D' : wcEtPullData h m) (i : ℕ)
      (x : wcEtZModExt S m i), wcEtPull D' i x = wcEtPull D i x := by
    intro S S' h D D' i x
    obtain ⟨Did⟩ := wc_et_zmod_pull_data_exists (𝟙 S') m
    have hid : ∀ y, wcEtPull Did i y = y := by
      intro y
      have h1 := wc_et_pull_comp (𝟙 S') (𝟙 S') (𝟙 S') (Category.comp_id _) Did Did Did i y
      have h2 : wcEtPull Did i (wcEtPull Did i y - y) = 0 := by
        rw [map_sub, ← h1, sub_self]
      exact sub_eq_zero.mp (wc_et_pull_id_injective Did i _ h2)
    rw [wc_et_pull_comp h (𝟙 S') h (Category.id_comp _) D Did D' i x, hid]

  have hone : ∀ W : Scheme.{u}, (((c W ≫ (ι W).hom).hom.app (Opposite.op (wcEtTop W))).hom
      (wcConstSec W (ULift.{u+1} ℤ) (wcEtTop W) (ULift.up 1))) =
      wcConstSec W (ULift.{u+1} (ZMod m)) (wcEtTop W) (ULift.up 1) := by
    intro W
