          (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app (Opposite.op U')).hom
        (((yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map h.op).hom
