theorem wc_et_open_generator_vanishing : ∀ (Ω : Type u) [Field Ω] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of Ω)) [IsProper f], topologicalKrullDim Y ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (U : Scheme.{u}) (j : U ⟶ Y) [IsOpenImmersion j] [IsAffine U] (L : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology U) AddCommGrpCat.{u+1}), Nonempty (L ⊣ wcEtPush j) → ∀ (ℓ : ℕ), (∀ (W : Scheme.{u}) (fW : W ⟶ Spec (.of Ω)) [IsProper fW], topologicalKrullDim W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (V : Scheme.{u}) (ι : V ⟶ W) [IsOpenImmersion ι] [IsAffine V], ∀ q : ℕ, 2 ≤ q → Subsingleton (wcEtCoh V ℓ q)) → (∀ (W : Scheme.{u}) (fW : W ⟶ Spec (.of Ω)) [IsProper fW], topologicalKrullDim W ≤ ((0 : ℕ) : WithBot ℕ∞) → ∀ (V : Scheme.{u}) (ι : V ⟶ W) [IsOpenImmersion ι], ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh V ℓ q)) → ∀ (W : Scheme.{u}) (π : W ⟶ Y) [IsFinite π] (S : Set W), IsOpen S → Dense S → letI : HasExt (Sheaf (Scheme.smallEtaleTopology U) AddCommGrpCat.{u+1}) := HasExt.standard _; ∀ q : ℕ, 1 < q → ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology U) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (L.obj ((wcEtPush π).obj (wcEtExtZero W S ℓ))) q, x = 0 :=
by
  intro Ω _ Y f _ hdim U j _ _ L hL ℓ HC HZ W π _ S hS hD
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology U) AddCommGrpCat.{u+1}) := HasExt.standard _
  intro q hq x

  have hs3 : ∀ (V Z : Scheme.{u}) (i : Z ⟶ V) [IsClosedImmersion i] (N : ℕ),
      (∀ q₀ : ℕ, N < q₀ → Subsingleton (wcEtCoh V ℓ q₀)) →
      (∀ q' : ℕ, N < q' + 1 → Subsingleton (wcEtCoh Z ℓ q')) →
      ∀ q₀ : ℕ, N < q₀ → Subsingleton (wcEtExt V (wcEtExtZero V (Set.range i)ᶜ ℓ) q₀) := by
