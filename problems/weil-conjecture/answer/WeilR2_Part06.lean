        rw [← hPeq]
        congr 2
    let F : PUnit.{u+1} → Type u := fun _ => Γ(Spec (R.presheaf.stalk η), (R.fromSpecStalk η) ⁻¹ᵁ V)
    let φ : ∀ i : PUnit.{u+1}, Γ(R, V) →+* F i := fun _ => ((R.fromSpecStalk η).app V).hom
    let L : ι → Type u := fun j => Localization.AtPrime j.1.asIdeal
    choose e he using fun s : S => s3 R V hV η s.2
    have hsub : ∀ i ∉ S, Subsingleton (F i) := fun i hi =>
      s4 R V η hgenη hi
    obtain ⟨Ψ, hΨ⟩ := s6 Γ(R, V) PUnit.{u+1} F φ S ι L b hb e he hsub
    let E : Γ(Spec (R.presheaf.stalk η), (R.fromSpecStalk η) ⁻¹ᵁ V) ≃+* ((i : PUnit.{u+1}) → F i) :=
      (RingEquiv.piUnique F).symm
    refine ⟨AlgEquiv.ofRingEquiv (f := E.trans Ψ) ?_⟩
    intro a
    funext j
    rw [RingEquiv.trans_apply, RingHom.algebraMap_toAlgebra]
    have : E (((R.fromSpecStalk η).app V).hom a) = fun i => φ i a := rfl
    rw [this, hΨ, Pi.algebraMap_apply]

  have L3 : ∀ (R : Scheme.{u}) [IrreducibleSpace R] [QuasiCompact (R.fromSpecStalk (genericPoint R))]
      (τR : R ⟶ R), IsIso τR → ∃ τX : Scheme.Hom.normalization (R.fromSpecStalk (genericPoint R)) ⟶
        Scheme.Hom.normalization (R.fromSpecStalk (genericPoint R)), IsIso τX ∧
        τX ≫ Scheme.Hom.fromNormalization (R.fromSpecStalk (genericPoint R)) =
          Scheme.Hom.fromNormalization (R.fromSpecStalk (genericPoint R)) ≫ τR := by
    intro R _ _ τR hτR
    set η := genericPoint R with hη
    set g := R.fromSpecStalk η with hg
    have hfix : ∀ ψ : R ⟶ R, IsIso ψ → ψ η = η := by
      intro ψ _
      have h1 := (genericPoint_spec R).image (f := ψ) ψ.continuous
      rw [Set.image_univ, Set.range_eq_univ.mpr ψ.surjective, closure_univ] at h1
      exact h1.eq (genericPoint_spec R)
    have hσ : ∀ ψ : R ⟶ R, IsIso ψ → ∃ σ : Spec (R.presheaf.stalk η) ⟶ Spec (R.presheaf.stalk η),
        σ ≫ g = g ≫ ψ := by
      intro ψ hψ
      have hsp : ψ η ⤳ η := specializes_of_eq (hfix ψ hψ)
      refine ⟨Spec.map (ψ.stalkMap η) ≫ Spec.map (R.presheaf.stalkSpecializes hsp), ?_⟩
      rw [Category.assoc, Scheme.SpecMap_stalkSpecializes_fromSpecStalk,
        Scheme.SpecMap_stalkMap_fromSpecStalk]
    set t := Scheme.Hom.toNormalization g
    set b := Scheme.Hom.fromNormalization g
    have hL : ∀ ψ : R ⟶ R, IsIso ψ → ∀ σ : Spec (R.presheaf.stalk η) ⟶ Spec (R.presheaf.stalk η),
        σ ≫ g = g ≫ ψ → ∃ L : Scheme.Hom.normalization g ⟶ Scheme.Hom.normalization g,
          L ≫ b = b ≫ ψ ∧ t ≫ L = σ ≫ t := by
      intro ψ hψ σ hσψ
      have H : g = (σ ≫ t) ≫ (b ≫ inv ψ) := by
        rw [Category.assoc, ← Category.assoc t, Scheme.Hom.toNormalization_fromNormalization,
          ← Category.assoc, hσψ, Category.assoc, IsIso.hom_inv_id, Category.comp_id]
      refine ⟨Scheme.Hom.normalizationDesc g (σ ≫ t) (b ≫ inv ψ) H, ?_,
        Scheme.Hom.toNormalization_normalizationDesc g _ _ H⟩
      have := Scheme.Hom.normalizationDesc_comp g (σ ≫ t) (b ≫ inv ψ) H
      rw [← IsIso.comp_inv_eq, Category.assoc, this]
    obtain ⟨σ, hσ1⟩ := hσ τR hτR
    obtain ⟨σ', hσ2⟩ := hσ (inv τR) inferInstance
    obtain ⟨L, hL1, hL2⟩ := hL τR hτR σ hσ1
    obtain ⟨L', hL1', hL2'⟩ := hL (inv τR) inferInstance σ' hσ2
    have hm1 : σ ≫ σ' = 𝟙 _ := by
      rw [← cancel_mono g, Category.assoc, hσ2, ← Category.assoc, hσ1, Category.assoc,
        IsIso.hom_inv_id, Category.comp_id, Category.id_comp]
    have hm2 : σ' ≫ σ = 𝟙 _ := by
      rw [← cancel_mono g, Category.assoc, hσ1, ← Category.assoc, hσ2, Category.assoc,
        IsIso.inv_hom_id, Category.comp_id, Category.id_comp]
    have e1 : L ≫ L' = 𝟙 _ := by
      apply Scheme.Hom.normalization.hom_ext g _ _ b
      · rw [← Category.assoc, hL2, Category.assoc, hL2', ← Category.assoc, hm1, Category.id_comp,
          Category.comp_id]
      · rw [Category.assoc, hL1', ← Category.assoc, hL1, Category.assoc, IsIso.hom_inv_id,
          Category.comp_id]
      · rw [Category.id_comp]
    have e2 : L' ≫ L = 𝟙 _ := by
      apply Scheme.Hom.normalization.hom_ext g _ _ b
      · rw [← Category.assoc, hL2', Category.assoc, hL2, ← Category.assoc, hm2, Category.id_comp,
          Category.comp_id]
      · rw [Category.assoc, hL1, ← Category.assoc, hL1', Category.assoc, IsIso.inv_hom_id,
          Category.comp_id]
      · rw [Category.id_comp]
    exact ⟨L, ⟨L', e1, e2⟩, hL1⟩

  have L4 : ∀ {α β : Type u} [TopologicalSpace α] [TopologicalSpace β] [T0Space α] [IrreducibleSpace α]
      (f : α → β), Function.Surjective f → ¬ topologicalKrullDim β ≤ ((0 : ℕ) : WithBot ℕ∞) →
      ¬ topologicalKrullDim α ≤ ((0 : ℕ) : WithBot ℕ∞) := by
    intro α β _ _ _ _ f hf hβ hα
    apply hβ
    have hsub : Subsingleton α := by
      unfold topologicalKrullDim at hα
      replace hα : Order.krullDim (TopologicalSpace.IrreducibleCloseds α) ≤ ((0 : ℕ∞) : WithBot ℕ∞) := hα
      rw [WithBot.coe_zero, Order.krullDim_nonpos_iff_forall_isMax] at hα
      refine ⟨fun x y => ?_⟩
      have key : ∀ x y : α, x ⤳ y := by
        intro x y
        let Cx : TopologicalSpace.IrreducibleCloseds α :=
          ⟨closure {x}, isIrreducible_singleton.closure, isClosed_closure⟩
        let T : TopologicalSpace.IrreducibleCloseds α :=
          ⟨Set.univ, IrreducibleSpace.isIrreducible_univ α, isClosed_univ⟩
        have hle : Cx ≤ T := fun _ _ => Set.mem_univ _
        have := hα Cx hle
        have hy : y ∈ (T : Set α) := Set.mem_univ y
        exact specializes_iff_mem_closure.mpr (this hy)
      exact (key x y).antisymm (key y x) |>.eq
    have hsubβ : Subsingleton β := ⟨fun x y => by
      obtain ⟨a, rfl⟩ := hf x
      obtain ⟨b, rfl⟩ := hf y
      rw [Subsingleton.elim a b]⟩
    unfold topologicalKrullDim
    show Order.krullDim (TopologicalSpace.IrreducibleCloseds β) ≤ ((0 : ℕ∞) : WithBot ℕ∞)
    rw [WithBot.coe_zero, Order.krullDim_nonpos_iff_forall_isMax]
    intro C D hCD
    obtain ⟨c, hc⟩ := C.isIrreducible.nonempty
    intro d _
    rw [Subsingleton.elim d c]
    exact hc

  have L5 : ∀ {X R Z : Scheme.{u}} (b : X ⟶ R) (iZ : Z ⟶ R) [IsIntegralHom b] [IsClosedImmersion iZ]
      [IrreducibleSpace R], ¬ topologicalKrullDim R ≤ ((0 : ℕ) : WithBot ℕ∞) →
      topologicalKrullDim Z ≤ ((0 : ℕ) : WithBot ℕ∞) →
      (∀ U : R.Opens, (U : Set R) = (Set.range iZ)ᶜ → IsIso (b ∣_ U)) → Function.Surjective b := by
    intro X R Z b iZ _ _ _ hR0 hZ0 hU
    let U₀ : R.Opens := ⟨(Set.range iZ)ᶜ, iZ.isClosedEmbedding.isClosed_range.isOpen_compl⟩
    have hne : (U₀ : Set R).Nonempty := by
      by_contra h
      rw [Set.not_nonempty_iff_eq_empty] at h
      have hr : Set.range iZ = Set.univ := by
        have : (Set.range iZ)ᶜ = ∅ := h
        simpa using this
      have hh : IsHomeomorph iZ := isHomeomorph_iff_isEmbedding_surjective.mpr
        ⟨iZ.isClosedEmbedding.isEmbedding, Set.range_eq_univ.mp hr⟩
      apply hR0
      rw [← IsHomeomorph.topologicalKrullDim_eq _ hh]
      exact hZ0
    have hdense : Dense (U₀ : Set R) := U₀.isOpen.dense hne
    have := hU U₀ rfl
    have hsub : (U₀ : Set R) ⊆ Set.range b := by
      intro y hy
      obtain ⟨x', hx'⟩ := (b ∣_ U₀).surjective ⟨y, hy⟩
      refine ⟨(b ⁻¹ᵁ U₀).ι x', ?_⟩
      have h2 : (b ∣_ U₀ ≫ U₀.ι) x' = y := by rw [Scheme.Hom.comp_apply, hx']; rfl
      rw [morphismRestrict_ι, Scheme.Hom.comp_apply] at h2
      exact h2
    have hcl : IsClosed (Set.range b) := by
      rw [← Set.image_univ]
      exact b.isClosedMap _ isClosed_univ
    intro y
    have : y ∈ closure (U₀ : Set R) := by rw [hdense.closure_eq]; trivial
    exact (closure_minimal hsub hcl) this

  have s0 : ∀ (Ω : Type u) [Field Ω] (R : Scheme.{u}) (fR : R ⟶ Spec (.of Ω)) [IsProper fR]
      (V : R.affineOpens), ∃ φ : Ω →+* Γ(R, V), φ.FiniteType := by
    intro Ω _ R fR _ V
    have h := HasRingHomProperty.appLE @LocallyOfFiniteType fR inferInstance
      ⟨⊤, isAffineOpen_top _⟩ V (by simp)
    refine ⟨(fR.appLE ⊤ V.1 (by simp)).hom.comp (Scheme.ΓSpecIso (.of Ω)).inv.hom, ?_⟩
    exact h.comp (RingHom.FiniteType.of_surjective _
      (Scheme.ΓSpecIso (.of Ω)).commRingCatIsoToRingEquiv.symm.surjective)
  have s4b : ∀ (B : Type u) [CommRing B] [IsDomain B] [IsIntegrallyClosed B] (L : Type u)
      [CommRing L] [Algebra B L], Nonempty (L ≃ₐ[B] ((P : {P : PrimeSpectrum B //
        P.asIdeal ∈ minimalPrimes B}) → Localization.AtPrime P.1.asIdeal)) →
      Function.Bijective (algebraMap B (integralClosure B L)) := by
    intro B _ _ _ L _ _ ⟨e⟩
    have hmin : (⊥ : Ideal B) ∈ minimalPrimes B := by
      refine ⟨⟨Ideal.isPrime_bot, bot_le⟩, fun q _ _ => bot_le⟩
    let P0 : {P : PrimeSpectrum B // P.asIdeal ∈ minimalPrimes B} :=
      ⟨⟨⊥, Ideal.isPrime_bot⟩, hmin⟩
    have huniq : ∀ P : {P : PrimeSpectrum B // P.asIdeal ∈ minimalPrimes B}, P = P0 := by
      intro P
      apply Subtype.ext
      apply PrimeSpectrum.ext
      exact le_antisymm (P.2.2 ⟨Ideal.isPrime_bot, bot_le⟩ bot_le) bot_le
    haveI : IsFractionRing B (Localization.AtPrime P0.1.asIdeal) := by
      have : P0.1.asIdeal.primeCompl = nonZeroDivisors B := by
        ext x; simp [Ideal.primeCompl, P0, mem_nonZeroDivisors_iff_ne_zero]
      show IsLocalization (nonZeroDivisors B) _
      rw [← this]; infer_instance
    let π : L →ₐ[B] Localization.AtPrime P0.1.asIdeal := (Pi.evalAlgHom B _ P0).comp e.toAlgHom
    have hπinj : Function.Injective π := by
      intro x y hxy
      apply e.injective
      funext P
      rw [huniq P]
      exact hxy
    constructor
    · intro a a' h
      have h2 : algebraMap B L a = algebraMap B L a' := congrArg Subtype.val h
      have h3 := congrArg π h2
      rw [π.commutes, π.commutes] at h3
      exact IsFractionRing.injective B _ h3
    · rintro ⟨x, hx⟩
      have hx' : IsIntegral B (π x) := hx.map π
      obtain ⟨a, ha⟩ := IsIntegrallyClosed.isIntegral_iff.mp hx'
      refine ⟨a, Subtype.ext (hπinj ?_)⟩
      show π (algebraMap B L a) = π x
      rw [π.commutes, ha]
  have s6a : ∀ (X R : Scheme.{u}) (g : X ⟶ R) [QuasiCompact g] [QuasiSeparated g],
      (∀ V : R.affineOpens, letI := (g.app V).hom.toAlgebra;
        Module.Finite Γ(R, V) (integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V))) →
      IsFinite (Scheme.Hom.fromNormalization g) := by
    intro X R g _ _ h
    rw [isFinite_iff]
    refine ⟨inferInstance, fun U hU => ?_⟩
    rw [Scheme.Hom.fromNormalization_app g hU]
    letI := (g.app U).hom.toAlgebra
    have h1 := h ⟨U, hU⟩
    rw [CommRingCat.hom_comp]
    apply RingHom.Finite.comp
    · exact RingHom.Finite.of_surjective _
        (Scheme.Hom.normalizationObjIso g hU).commRingCatIsoToRingEquiv.symm.surjective
    · exact RingHom.finite_algebraMap.mpr h1
  have s6b : ∀ (X R : Scheme.{u}) (g : X ⟶ R) [QuasiCompact g] [QuasiSeparated g],
      (∀ V : R.affineOpens, letI := (g.app V).hom.toAlgebra;
        ∀ (Q : Ideal (integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V))) [Q.IsPrime],
          IsDomain (Localization.AtPrime Q) ∧ IsIntegrallyClosed (Localization.AtPrime Q)) →
      ∀ x : Scheme.Hom.normalization g,
        IsDomain ((Scheme.Hom.normalization g).presheaf.stalk x) ∧
        IsIntegrallyClosed ((Scheme.Hom.normalization g).presheaf.stalk x) := by
    intro X R g _ _ h x
    set b := Scheme.Hom.fromNormalization g
    obtain ⟨V, hV, hbV, -⟩ := exists_isAffineOpen_mem_and_subset (x := b x) (U := ⊤) trivial
    have hW : IsAffineOpen (b ⁻¹ᵁ V) := hV.preimage b
    have hx : x ∈ b ⁻¹ᵁ V := hbV
    letI := (g.app V).hom.toAlgebra
    let e : Γ(Scheme.Hom.normalization g, b ⁻¹ᵁ V) ≃+* integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V) :=
      (Scheme.Hom.normalizationObjIso g hV).commRingCatIsoToRingEquiv
    let p := (hW.primeIdealOf ⟨x, hx⟩).asIdeal
    let Q : Ideal (integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V)) := p.comap e.symm.toRingHom
    haveI : Q.IsPrime := Ideal.comap_isPrime _ _
    obtain ⟨hd, hic⟩ := h ⟨V, hV⟩ Q
    set y : (b ⁻¹ᵁ V : Scheme) := ⟨x, hx⟩
    show IsDomain ((Scheme.Hom.normalization g).presheaf.stalk y.1) ∧
      IsIntegrallyClosed ((Scheme.Hom.normalization g).presheaf.stalk y.1)
    letI : Algebra Γ(Scheme.Hom.normalization g, b ⁻¹ᵁ V)
        ((Scheme.Hom.normalization g).presheaf.stalk y.1) :=
      TopCat.Presheaf.algebra_section_stalk (Scheme.Hom.normalization g).presheaf y
    haveI := hW.isLocalization_stalk y
    have hM : p.primeCompl.map e.toMonoidHom = Q.primeCompl := by
      ext z
      constructor
      · rintro ⟨w, hw, rfl⟩
        show e.symm (e w) ∉ p
        rw [e.symm_apply_apply]
        exact hw
      · intro hz
        exact ⟨e.symm z, hz, e.apply_symm_apply z⟩
    let f : (Scheme.Hom.normalization g).presheaf.stalk y.1 ≃+* Localization.AtPrime Q :=
      IsLocalization.ringEquivOfRingEquiv (M := p.primeCompl) (T := Q.primeCompl) _ _ e hM
    haveI : IsDomain ((Scheme.Hom.normalization g).presheaf.stalk y.1) :=
      MulEquiv.isDomain _ f.toMulEquiv
    exact ⟨inferInstance, IsIntegrallyClosed.of_equiv f.symm⟩
  have s6c : ∀ (X R : Scheme.{u}) (g : X ⟶ R) [QuasiCompact g] [QuasiSeparated g] (W : R.Opens),
      IsAffineOpen W → (letI := (g.app W).hom.toAlgebra;
        Function.Bijective (algebraMap Γ(R, W) (integralClosure Γ(R, W) Γ(X, g ⁻¹ᵁ W)))) →
      IsIso (Scheme.Hom.fromNormalization g ∣_ W) := by
    intro X R g _ _ W hW hbij
    set b := Scheme.Hom.fromNormalization g
    haveI : IsAffine W := hW
    haveI : IsAffine (b ⁻¹ᵁ W : Scheme) := hW.preimage b
    have hiso : IsIso (b.app W) := by
      rw [Scheme.Hom.fromNormalization_app g hW]
      letI := (g.app W).hom.toAlgebra
      haveI : IsIso (CommRingCat.ofHom (algebraMap Γ(R, W)
          (integralClosure Γ(R, W) Γ(X, g ⁻¹ᵁ W)))) :=
        (RingEquiv.ofBijective _ hbij).toCommRingCatIso.isIso_hom
      infer_instance
    have hiso' : ∀ U' : R.Opens, U' = W → IsIso (b.app U') := by
      rintro U' rfl; exact hiso
    have htop : IsIso (Scheme.Hom.appTop (b ∣_ W)) := by
      rw [morphismRestrict_appTop]
      have h3 := hiso' _ (Scheme.Opens.ι_image_top W)
      exact @IsIso.comp_isIso _ _ _ _ _ _ _ h3 (Functor.map_isIso _ _)
    have := Scheme.isoSpec_hom_naturality (b ∣_ W)
    have h2 : b ∣_ W = (b ⁻¹ᵁ W : Scheme).isoSpec.hom ≫ Spec.map (Scheme.Hom.appTop (b ∣_ W)) ≫
        (W : Scheme).isoSpec.inv := by
      rw [← Category.assoc, this]; simp
    rw [h2]
    infer_instance
  have s7 : ∀ (X Y : Scheme.{u}) (b : X ⟶ Y) [IsIntegralHom b],
      topologicalKrullDim X ≤ topologicalKrullDim Y := by
    intro X Y b _
    have incomp : ∀ (t t' : X), t' ⤳ t → b t = b t' → t = t' := by
      intro t t' hsp heq
      obtain ⟨V, hV, hbV, -⟩ := exists_isAffineOpen_mem_and_subset (x := b t) (U := ⊤) trivial
      have ht : t ∈ b ⁻¹ᵁ V := hbV
      have ht' : t' ∈ b ⁻¹ᵁ V := by
        show b t' ∈ V
        rw [← heq]; exact hbV
      haveI : IsAffine (V : Scheme) := hV
      haveI : IsAffine (b ⁻¹ᵁ V : Scheme) := hV.preimage b
      let x : (b ⁻¹ᵁ V : Scheme) := ⟨t, ht⟩
      let x' : (b ⁻¹ᵁ V : Scheme) := ⟨t', ht'⟩
      have hxsp : x' ⤳ x := by
        rw [← (b ⁻¹ᵁ V).ι.isOpenEmbedding.isInducing.specializes_iff]
        exact hsp
      have hxne : x = x' → t = t' := fun h => congrArg Subtype.val h
      have himg : (b ∣_ V) x = (b ∣_ V) x' := by
        apply V.ι.isOpenEmbedding.injective
        rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, morphismRestrict_ι,
          Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
        exact heq
      apply hxne
      by_contra hne
      set e := (b ⁻¹ᵁ V : Scheme).isoSpec
      set φ := Scheme.Hom.appTop (b ∣_ V)
      have hnat := Scheme.isoSpec_hom_naturality (b ∣_ V)
      have hφ : φ.hom.IsIntegral := by
        have := IsIntegralHom.isIntegral_app (b ∣_ V) ⊤ (isAffineOpen_top _)
        exact this
      let s := e.hom x
      let s' := e.hom x'
      have hssp : s' ⤳ s := hxsp.map e.hom.continuous
      have hsne : s ≠ s' := fun h => hne (e.hom.isOpenEmbedding.injective h)
      have hlt : s'.asIdeal < s.asIdeal :=
        lt_of_le_of_ne ((PrimeSpectrum.le_iff_specializes s' s).mpr hssp)
          (fun h => hsne (PrimeSpectrum.ext h).symm)
      letI := φ.hom.toAlgebra
      haveI : Algebra.IsIntegral _ _ := ⟨hφ⟩
      haveI := s'.isPrime
      have hlt' := Ideal.IsIntegral.under_lt_under (R := Γ((V : Scheme), ⊤)) hlt
      have h1 : (Spec.map φ) s = (V : Scheme).isoSpec.hom ((b ∣_ V) x) := by
        rw [← Scheme.Hom.comp_apply, hnat, Scheme.Hom.comp_apply]
      have h1' : (Spec.map φ) s' = (V : Scheme).isoSpec.hom ((b ∣_ V) x') := by
        rw [← Scheme.Hom.comp_apply, hnat, Scheme.Hom.comp_apply]
      have h2 : (Spec.map φ) s = (Spec.map φ) s' := by rw [h1, h1', himg]
      have h3 : ((Spec.map φ) s).asIdeal = Ideal.under _ s.asIdeal := rfl
      have h3' : ((Spec.map φ) s').asIdeal = Ideal.under _ s'.asIdeal := rfl
      rw [← h3, ← h3', h2] at hlt'
      exact lt_irrefl _ hlt'
    have hcl : ∀ (a c : Y), c ⤳ a → a ≠ c →
        (⟨closure {a}, isIrreducible_singleton.closure, isClosed_closure⟩ :
          TopologicalSpace.IrreducibleCloseds Y) <
        ⟨closure {c}, isIrreducible_singleton.closure, isClosed_closure⟩ := by
      intro a c hca hac
      refine lt_of_le_of_ne ?_ ?_
      · show closure {a} ⊆ closure {c}
        exact specializes_iff_closure_subset.mp hca
      · intro h
        have h' : closure ({a} : Set Y) = closure {c} :=
          congrArg TopologicalSpace.IrreducibleCloseds.carrier h
        have hac' : a ⤳ c := specializes_iff_closure_subset.mpr h'.ge
        exact hac (hac'.antisymm hca).eq
    let F : TopologicalSpace.IrreducibleCloseds X → TopologicalSpace.IrreducibleCloseds Y :=
      fun T => ⟨closure {b T.isIrreducible.genericPoint}, isIrreducible_singleton.closure,
        isClosed_closure⟩
    have hF : StrictMono F := by
      intro T T' hTT'
      have hgT := T.isIrreducible.isGenericPoint_genericPoint_closure
      have hgT' := T'.isIrreducible.isGenericPoint_genericPoint_closure
      rw [T.isClosed.closure_eq] at hgT
      rw [T'.isClosed.closure_eq] at hgT'
      have htT : T.isIrreducible.genericPoint ∈ (T : Set X) := hgT.mem
      have hsp : T'.isIrreducible.genericPoint ⤳ T.isIrreducible.genericPoint :=
        hgT'.specializes (hTT'.le htT)
      have hne : T.isIrreducible.genericPoint ≠ T'.isIrreducible.genericPoint := by
        intro heq
        apply hTT'.ne
        apply TopologicalSpace.IrreducibleCloseds.ext
        rw [← hgT.def, ← hgT'.def, heq]
      exact hcl _ _ (hsp.map b.continuous) (fun h => hne (incomp _ _ hsp h))
    exact Order.krullDim_le_of_strictMono F hF
  have s8 : ∀ (R Z : Scheme.{u}) (iZ : Z ⟶ R) [IsClosedImmersion iZ],
      topologicalKrullDim R ≤ ((1 : ℕ) : WithBot ℕ∞) →
      (∀ z : Z, ∃ y : R, y ⤳ iZ z ∧ y ≠ iZ z) →
      topologicalKrullDim Z ≤ ((0 : ℕ) : WithBot ℕ∞) := by
    intro R Z iZ _ hR hgen
    have hcl : ∀ (a b : R), b ⤳ a → a ≠ b →
        (⟨closure {a}, isIrreducible_singleton.closure, isClosed_closure⟩ :
          TopologicalSpace.IrreducibleCloseds R) <
        ⟨closure {b}, isIrreducible_singleton.closure, isClosed_closure⟩ := by
      intro a b hba hab
      refine lt_of_le_of_ne ?_ ?_
      · show closure {a} ⊆ closure {b}
        exact specializes_iff_closure_subset.mp hba
      · intro h
        have h' : closure ({a} : Set R) = closure {b} :=
          congrArg TopologicalSpace.IrreducibleCloseds.carrier h
        have hab' : a ⤳ b := specializes_iff_closure_subset.mpr h'.ge
        exact hab (hab'.antisymm hba).eq
    unfold topologicalKrullDim
    show Order.krullDim (TopologicalSpace.IrreducibleCloseds Z) ≤ ((0 : ℕ∞) : WithBot ℕ∞)
    rw [WithBot.coe_zero, Order.krullDim_nonpos_iff_forall_isMax]
    intro T T' hTT'
    have hgT := T.isIrreducible.isGenericPoint_genericPoint_closure
    have hgT' := T'.isIrreducible.isGenericPoint_genericPoint_closure
    rw [T.isClosed.closure_eq] at hgT
    rw [T'.isClosed.closure_eq] at hgT'
    set t := T.isIrreducible.genericPoint
    set t' := T'.isIrreducible.genericPoint
    have htT : t ∈ (T : Set Z) := hgT.mem
    have hsp : t' ⤳ t := hgT'.specializes (hTT' htT)
    by_cases heq : t = t'
    · show (T' : Set Z) ⊆ T
      rw [← hgT.def, ← hgT'.def, heq]
    · exfalso
      have hsp' : iZ t' ⤳ iZ t := hsp.map iZ.continuous
      have hne' : iZ t ≠ iZ t' := fun h => heq (iZ.isClosedEmbedding.injective h)
      obtain ⟨y, hy, hyne⟩ := hgen t'
      have l1 := hcl _ _ hsp' hne'
      have l2 := hcl _ _ hy hyne.symm
      have hR' : Order.krullDim (TopologicalSpace.IrreducibleCloseds R) ≤ 1 := by
        have := hR; unfold topologicalKrullDim at this; exact_mod_cast this
      rcases Order.krullDim_le_one_iff.mp hR'
          ⟨closure {iZ t'}, isIrreducible_singleton.closure, isClosed_closure⟩ with h | h
      · exact (h.not_lt l1)
      · exact (h.not_lt l2)
  have s9 : ∀ (R : Scheme.{u}) (N : Set R), IsClosed N →
      ∃ (Z : Scheme.{u}) (iZ : Z ⟶ R), IsClosedImmersion iZ ∧ Set.range iZ = N := by
    intro R N hN
    refine ⟨(Scheme.IdealSheafData.vanishingIdeal ⟨N, hN⟩).subscheme,
      (Scheme.IdealSheafData.vanishingIdeal ⟨N, hN⟩).subschemeι, inferInstance, ?_⟩
    rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.coe_support_vanishingIdeal]
    rfl
  have s10 : ∀ (X R : Scheme.{u}) (b : X ⟶ R) (U : R.Opens),
      (∀ y ∈ U, ∃ V : R.Opens, y ∈ V ∧ IsIso (b ∣_ V)) → IsIso (b ∣_ U) := by
    intro X R b U h
    have hmono : ∀ (V W : R.Opens), W ≤ V → IsIso (b ∣_ V) → IsIso (b ∣_ W) := by
      intro V W hWV hV
      have h1 : IsIso ((b ∣_ V) ∣_ (V.ι ⁻¹ᵁ W)) :=
        IsZariskiLocalAtTarget.restrict (P := MorphismProperty.isomorphisms Scheme) hV _
      have e : V.ι ''ᵁ (V.ι ⁻¹ᵁ W) = W := by
        rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
        exact inf_eq_right.mpr hWV
      have h2 := (MorphismProperty.isomorphisms Scheme).arrow_mk_iso_iff
        (morphismRestrictRestrict b V (V.ι ⁻¹ᵁ W)) |>.mp h1
      rw [e] at h2
      exact h2
    choose! V hyV hV using h
    have key : ∀ y : U, IsIso ((b ∣_ U) ∣_ (U.ι ⁻¹ᵁ V y.1)) := by
      intro y
      have h1 : IsIso (b ∣_ (U.ι ''ᵁ (U.ι ⁻¹ᵁ V y.1))) := by
        apply hmono (V y.1) _ _ (hV y.1 y.2)
        rw [Scheme.Hom.image_preimage_eq_opensRange_inf]
        exact inf_le_right
      exact (MorphismProperty.isomorphisms Scheme).arrow_mk_iso_iff
        (morphismRestrictRestrict b U (U.ι ⁻¹ᵁ V y.1)) |>.mpr h1
    have htop : ⨆ y : U, U.ι ⁻¹ᵁ V y.1 = ⊤ := by
      rw [eq_top_iff]
      intro z _
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨z, hyV z.1 z.2⟩
    exact (IsZariskiLocalAtTarget.iff_of_iSup_eq_top
      (P := MorphismProperty.isomorphisms Scheme) _ htop).mpr key
  have s12 : ∀ (R : Scheme.{u}) (V : R.Opens) (hV : IsAffineOpen V) (y : R) (hy : y ∈ V),
      ((∀ y' : R, y' ⤳ y → y' = y) →
        (hV.primeIdealOf ⟨y, hy⟩).asIdeal ∈ minimalPrimes Γ(R, V)) ∧
      ∀ f : Γ(R, V), f ∉ (hV.primeIdealOf ⟨y, hy⟩).asIdeal → y ∈ R.basicOpen f := by
    intro R V hV y hy
    have hfy : hV.fromSpec (hV.primeIdealOf ⟨y, hy⟩) = y := hV.fromSpec_primeIdealOf ⟨y, hy⟩
    refine ⟨fun hgen => ?_, fun f hf => ?_⟩
    · refine ⟨⟨(hV.primeIdealOf ⟨y, hy⟩).isPrime, bot_le⟩, fun q ⟨hq, _⟩ hle => ?_⟩
      let q' : PrimeSpectrum Γ(R, V) := ⟨q, hq⟩
      have hsp : q' ⤳ hV.primeIdealOf ⟨y, hy⟩ := (PrimeSpectrum.le_iff_specializes _ _).mp hle
      have h1 : hV.fromSpec q' ⤳ y := hfy ▸ hsp.map hV.fromSpec.continuous
      have h2 : hV.fromSpec q' = hV.fromSpec (hV.primeIdealOf ⟨y, hy⟩) :=
        (hgen _ h1).trans hfy.symm
      have h3 := hV.fromSpec.isOpenEmbedding.injective h2
      have : q' = hV.primeIdealOf ⟨y, hy⟩ := h3
      rw [← this]
    · have h1 : hV.primeIdealOf ⟨y, hy⟩ ∈ PrimeSpectrum.basicOpen f := hf
      rw [← hV.fromSpec_preimage_basicOpen] at h1
      have h2 : hV.fromSpec (hV.primeIdealOf ⟨y, hy⟩) ∈ R.basicOpen f := h1
      rwa [hfy] at h2

  intro Ω _ _ W fW _ _ hd1 hd0
  obtain ⟨R, r, hr, hrr, hRred⟩ := wc_reduced_subscheme_exists W
  haveI := hr
  haveI := hRred
  have hhom : IsHomeomorph r := isHomeomorph_iff_isEmbedding_surjective.mpr
    ⟨r.isClosedEmbedding.isEmbedding, Set.range_eq_univ.mp hrr⟩
  haveI hRirr : IrreducibleSpace R := by
    have hWR := (hhom.homeomorph r).symm
    exact Function.Surjective.irreducibleSpace hWR.continuous hWR.surjective
  have hdimRW : topologicalKrullDim R = topologicalKrullDim W := IsHomeomorph.topologicalKrullDim_eq r hhom
  have hR1 : topologicalKrullDim R ≤ ((1 : ℕ) : WithBot ℕ∞) := hdimRW ▸ hd1
  have hR0 : ¬ topologicalKrullDim R ≤ ((0 : ℕ) : WithBot ℕ∞) := hdimRW ▸ hd0
  haveI : IsIntegral R := isIntegral_of_irreducibleSpace_of_isReduced R
  let fR : R ⟶ Spec (.of Ω) := r ≫ fW
  haveI : IsProper fR := by dsimp [fR]; infer_instance
  haveI : QuasiSeparatedSpace R := quasiSeparatedSpace_of_quasiSeparated fR
  set g := R.fromSpecStalk (genericPoint R) with hgdef
  haveI hgqc : QuasiCompact g := quasiCompact_of_compactSpace g
  have hL := L2 R

  have hnoeth : ∀ (V : R.Opens) (hV : IsAffineOpen V), IsNoetherianRing Γ(R, V) := by
    intro V hV
    obtain ⟨φ, hφ⟩ := s0 Ω R fR ⟨V, hV⟩
    letI := φ.toAlgebra
    haveI : Algebra.FiniteType Ω Γ(R, V) := hφ
    exact Algebra.FiniteType.isNoetherianRing Ω _
  have hfinP : ∀ (V : R.Opens) (hV : IsAffineOpen V), ∀ P ∈ minimalPrimes Γ(R, V),
      Module.Finite (Γ(R, V) ⧸ P)
        (integralClosure (Γ(R, V) ⧸ P) (FractionRing (Γ(R, V) ⧸ P))) := by
    intro V hV P hP
    obtain ⟨φ, hφ⟩ := s0 Ω R fR ⟨V, hV⟩
    letI := φ.toAlgebra
    haveI : Algebra.FiniteType Ω Γ(R, V) := hφ
    haveI : P.IsPrime := hP.1.1
    exact noether_integralClosure_finite Ω (Γ(R, V) ⧸ P)
  haveI hfin : IsFinite (Scheme.Hom.fromNormalization g) := by
    apply s6a _ R g
    intro V
    letI := (g.app V).hom.toAlgebra
    haveI := hnoeth V.1 V.2
    exact integralClosure_prod_minimal_finite Γ(R, V) _ (hL V) (hfinP V.1 V.2)
  have hnorm := s6b _ R g (fun V => by
    letI := (g.app V).hom.toAlgebra
    haveI := hnoeth V.1 V.2
    exact integralClosure_prod_minimal_stalks_normal Γ(R, V) _ (hL V))
  have hgen : ∀ y : R, (∀ y' : R, y' ⤳ y → y' = y) →
      ∃ W : R.Opens, y ∈ W ∧ IsIso (Scheme.Hom.fromNormalization g ∣_ W) := by
    intro y hy
    obtain ⟨V, hV, hyV, -⟩ := exists_isAffineOpen_mem_and_subset (x := y) (U := ⊤) trivial
    obtain ⟨hmin, hbasic⟩ := s12 R V hV y hyV
    haveI := hnoeth V hV
    obtain ⟨f, hf, hB⟩ := reduced_noetherian_generic_normal Γ(R, V) (hfinP V hV) _ (hmin hy)
    have hW : IsAffineOpen (R.basicOpen f) := hV.basicOpen f
    haveI := hV.isLocalization_basicOpen f
    obtain ⟨hdom, hic⟩ := hB Γ(R, R.basicOpen f)
    refine ⟨R.basicOpen f, hbasic f hf, ?_⟩
    apply s6c _ R g _ hW
    letI := (g.app (R.basicOpen f)).hom.toAlgebra
    exact s4b Γ(R, R.basicOpen f) _ (hL ⟨R.basicOpen f, hW⟩)
  let G : Set R := {y | ∃ W : R.Opens, y ∈ W ∧ IsIso (Scheme.Hom.fromNormalization g ∣_ W)}
  have hGopen : IsOpen G := by
    rw [isOpen_iff_forall_mem_open]
    rintro y ⟨W, hyW, hW⟩
    exact ⟨W, fun z hz => ⟨W, hz, hW⟩, W.isOpen, hyW⟩
  obtain ⟨Z, iZ, hiZ, hrange⟩ := s9 R Gᶜ hGopen.isClosed_compl
  haveI := hiZ
  have hnongen : ∀ z : Z, ∃ y' : R, y' ⤳ iZ z ∧ y' ≠ iZ z := by
    intro z
    have hz : iZ z ∈ Gᶜ := by rw [← hrange]; exact ⟨z, rfl⟩
    by_contra hcon
    push_neg at hcon
    obtain ⟨W, hyW, hW⟩ := hgen (iZ z) hcon
    exact hz ⟨W, hyW, hW⟩
  have hZ0 := s8 R Z iZ hR1 hnongen
  have hbU : ∀ U : R.Opens, (U : Set R) = (Set.range iZ)ᶜ →
      IsIso (Scheme.Hom.fromNormalization g ∣_ U) := by
    intro U hU
    apply s10 _ R _ U
    intro y hy
    have h : y ∈ (U : Set R) := hy
    rw [hU, hrange, compl_compl] at h
    exact h
  have hX1' : topologicalKrullDim (Scheme.Hom.normalization g) ≤ ((1 : ℕ) : WithBot ℕ∞) :=
    (s7 _ _ (Scheme.Hom.fromNormalization g)).trans hR1

  haveI hXint : IsIntegral (Scheme.Hom.normalization g) := inferInstance
  have hsurj := L5 (Scheme.Hom.fromNormalization g) iZ hR0 hZ0 hbU
  have hX0 := L4 (Scheme.Hom.fromNormalization g) hsurj hR0
  have hX1 : topologicalKrullDim (Scheme.Hom.normalization g) = ((1 : ℕ) : WithBot ℕ∞) := by
    generalize topologicalKrullDim (Scheme.Hom.normalization g) = d at hX1' hX0 ⊢
    induction d using WithBot.recBotCoe with
    | bot => exact absurd bot_le hX0
    | coe e =>
      induction e using ENat.recTopCoe with
      | top => exact absurd hX1' (by decide)
      | coe n =>
        have h1 : n ≤ 1 := by exact_mod_cast hX1'
        have h0 : ¬ n ≤ 0 := fun h => hX0 (by exact_mod_cast h)
        have : n = 1 := by omega
        subst this
        rfl
  refine ⟨R, r, Scheme.Hom.normalization g, Scheme.Hom.fromNormalization g, Z, iZ, hr, hrr,
    hRirr, hR1, hR0, hfin, hiZ, hZ0, hbU, inferInstance, hnorm, hX1, ?_⟩
  intro τ hτ
  obtain ⟨τR, hτR, hR⟩ := L1 r hrr τ hτ
  obtain ⟨τX, hτX, hX⟩ := L3 R τR hτR
  exact ⟨τR, τX, hτR, hτX, hR, hX⟩

theorem wc_et_pull_surj_closed_immersion_injective : ∀ {R W : Scheme.{u}} (r : R ⟶ W) [IsClosedImmersion r], Set.range r = Set.univ → ∀ (n : ℕ) (D : wcEtPullData r n) (i : ℕ), Function.Injective (wcEtPull D i) :=
by
  classical
  intro R W r _ hsurj n D i
  haveI := D.cont
  haveI := D.additive
  haveI := D.presLim
  haveI := D.presColim
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing W n)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing R n)) := HasExt.standard _

  haveI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ).Additive :=
    D.adj.right_adjoint_additive
  haveI : Limits.PreservesFiniteLimits
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ) := by
    letI := D.adj.rightAdjoint_preservesLimits
    infer_instance
  haveI : IsFinite r := inferInstance
  haveI : Limits.PreservesFiniteColimits
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ) :=
    wc_et_finite_push_modules_exact r n D

  have covbot : ∀ (V : W.Etale), IsEmpty V.left → ∀ (S : Sieve V),
      S ∈ Scheme.smallEtaleTopology W V := by
    intro V hV S
    haveI : MorphismProperty.IsStableUnderComposition (@Etale : MorphismProperty Scheme.{u}) :=
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have e := Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := (@Etale : MorphismProperty Scheme.{u})) (Q := (@Etale : MorphismProperty Scheme.{u}))
      W le_rfl
    have h' := (Scheme.mem_toGrothendieck_smallPretopology (P := @Etale) (Q := @Etale) V S).mpr
      (fun x => (hV.false x).elim)
    rw [← e] at h'
    exact h'

  let K := (SheafOfModules.toSheaf (wcEtZModRing W n)).obj (Limits.kernel (wcEtSuppUnitMap D))
  have hempty : ∀ (V : W.Etale), IsEmpty V.left → ∀ s : K.obj.obj (Opposite.op V), s = 0 := by
    intro V hV s
    apply K.isSeparated V ⊥ (covbot V hV ⊥) s 0
    intro Y f hf
    simp at hf

  have hsupp := wc_et_supp_unit_ker_suppIn r n D
  have hc : (Set.range r)ᶜ = ∅ := by rw [hsurj, Set.compl_univ]
  rw [hc] at hsupp
  have hvan : ∀ (V : W.Etale) (s : K.obj.obj (Opposite.op V)), s = 0 := by
    intro V s
    have hS := hsupp V s
    apply K.isSeparated V _ hS s 0
    intro Y f hf
    rw [Sieve.generate_apply] at hf
    obtain ⟨V', h, g, hg, rfl⟩ := hf
    rcases hg with hg | hg
    · have e : (K.obj.map (h ≫ g).op) s = (K.obj.map h.op) ((K.obj.map g.op) s) := by
        rw [op_comp, Functor.map_comp]; rfl
      rw [map_zero, e, hg, map_zero]
    · have hY : IsEmpty Y.left := ⟨fun y => Set.notMem_empty _ (hg (h.left y))⟩
      exact (hempty Y hY _).trans (hempty Y hY _).symm

  have hmono : Mono (wcEtSuppUnitMap D) := by
    apply Abelian.mono_of_kernel_ι_eq_zero
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro X
    ext k
    have hk : k = 0 := hvan X.unop k
    subst hk
    simp
  haveI := wc_et_supp_unit_epi r D
  haveI : IsIso (wcEtSuppUnitMap D) := isIso_of_mono_of_epi _

  have hη : IsIso (D.adj.unit.app (SheafOfModules.unit (wcEtZModRing W n))) := by
    haveI : IsIso (D.adj.unit.app (SheafOfModules.unit (wcEtZModRing W n)) ≫
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ).map D.μ.hom) :=
      (inferInstance : IsIso (wcEtSuppUnitMap D))
    exact IsIso.of_isIso_comp_right _
      ((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ).map D.μ.hom)

  have h2 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcEtZModRing R n)} {a : ℕ}
      (f : A ⟶ B) (g : B ⟶ C') (z : Abelian.Ext C' D' a),
      (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ g).comp z (zero_add a)) (zero_add a) =
        (Abelian.Ext.mk₀ (f ≫ g)).comp z (zero_add a) := by
    intro A B C' D' a f g z
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
  have h3 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcEtZModRing R n)} {a : ℕ}
      (z : Abelian.Ext A B a) (f : B ⟶ C') (g : C' ⟶ D'),
      (z.comp (Abelian.Ext.mk₀ f) (add_zero a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        z.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero a) := by
    intro A B C' D' a z f g
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  have h4 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcEtZModRing R n)} {a : ℕ}
      (f : A ⟶ B) (z : Abelian.Ext B C' a) (g : C' ⟶ D'),
      ((Abelian.Ext.mk₀ f).comp z (zero_add a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        (Abelian.Ext.mk₀ f).comp (z.comp (Abelian.Ext.mk₀ g) (add_zero a)) (zero_add a) := by
    intro A B C' D' a f z g
    exact Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _
  have h3W : ∀ {A B C' D' : SheafOfModules.{u+1} (wcEtZModRing W n)} {a : ℕ}
      (z : Abelian.Ext A B a) (f : B ⟶ C') (g : C' ⟶ D'),
      (z.comp (Abelian.Ext.mk₀ f) (add_zero a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        z.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero a) := by
    intro A B C' D' a z f g
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]

  rw [injective_iff_map_eq_zero]
  intro x hx
  have hx' : (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ x).comp
      (Abelian.Ext.mk₀ D.μ.hom) (add_zero i)) (zero_add i) = 0 := hx
  have hy : Abelian.Ext.mapExactFunctor D.Φ x = 0 := by
    have e : Abelian.Ext.mapExactFunctor D.Φ x = (Abelian.Ext.mk₀ D.μ.hom).comp
        (((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ x).comp
          (Abelian.Ext.mk₀ D.μ.hom) (add_zero i)) (zero_add i)).comp
          (Abelian.Ext.mk₀ D.μ.inv) (add_zero i)) (zero_add i) := by
      rw [h4, h2, h3, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id, Abelian.Ext.mk₀_id_comp]
    rw [e, hx', Abelian.Ext.zero_comp, Abelian.Ext.comp_zero]

  have nat' : x.comp (Abelian.Ext.mk₀ (D.adj.unit.app (SheafOfModules.unit (wcEtZModRing W n))))
      (add_zero i) = 0 := by
    have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp x D.adj.unit
    simp only [Abelian.Ext.id_mapExactFunctor, Abelian.Ext.comp_mapExactFunctor, hy,
      Abelian.Ext.mapExactFunctor_zero, Abelian.Ext.comp_zero] at h
    exact h
  have e2 : x = (x.comp (Abelian.Ext.mk₀ (D.adj.unit.app (SheafOfModules.unit (wcEtZModRing W n))))
      (add_zero i)).comp
        (Abelian.Ext.mk₀ (inv (D.adj.unit.app (SheafOfModules.unit (wcEtZModRing W n)))))
        (add_zero i) := by
    rw [h3W, IsIso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
  rw [e2, nat', Abelian.Ext.zero_comp]

theorem wc_bfpi_supp_unit_local_surj : ∀ {X Y : Scheme.{u}} (b : X ⟶ Y) (O : Y.Opens), (∀ {W : Scheme.{u}} (h : W ⟶ Y), Set.range h ⊆ (O : Set Y) → IsIso (Limits.pullback.fst h b)) → ∀ (n : ℕ) (D : wcEtPullData b n) (V : Y.Etale) (g : ((SheafOfModules.toSheaf (wcEtZModRing Y n)).obj (wcEtSuppObj D)).obj.obj (Opposite.op V)) (v : V.left), V.hom v ∈ (O : Set Y) → ∃ (V₁ : Y.Etale) (c : V₁ ⟶ V) (v₁ : V₁.left) (t : ((SheafOfModules.toSheaf (wcEtZModRing Y n)).obj (SheafOfModules.unit (wcEtZModRing Y n))).obj.obj (Opposite.op V₁)), c.left v₁ = v ∧ (((SheafOfModules.toSheaf (wcEtZModRing Y n)).map (wcEtSuppUnitMap D)).hom.app (Opposite.op V₁)).hom t = (((SheafOfModules.toSheaf (wcEtZModRing Y n)).obj (wcEtSuppObj D)).obj.map c.op).hom g :=
by
  intro X Y b O hπ n D V g v hv
  classical
  have hcov' : ∀ (S : Scheme.{u}) (V : S.Etale) (T : Sieve V), T ∈ Scheme.smallEtaleTopology S V →
      ∀ v : V.left, ∃ (W : S.Etale) (f : W ⟶ V) (w : W.left),
        T.arrows f ∧ Etale f.left ∧ f.left w = v := by
    intro S V T hT
    change T ∈ Scheme.smallGrothendieckTopology @Etale S V at hT
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale S
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hT
    exact (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale S
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V T).mp hT
  obtain ⟨α, hαs⟩ : ∃ α : (Functor.const (X.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶
      (wcEtZModRing X n).obj, Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X) α :=
    ⟨toSheafify _ _, Presheaf.isLocallySurjective_toSheafify' _ _⟩
  have hcomp : ∀ {A B C : X.Etale} (f : A ⟶ B) (h : B ⟶ C)
      (z : ↑((wcEtZModRing X n).obj.obj (Opposite.op C))),
      ((wcEtZModRing X n).obj.map f.op).hom (((wcEtZModRing X n).obj.map h.op).hom z) =
        ((wcEtZModRing X n).obj.map (f ≫ h).op).hom z := by
    intro A B C f h z
    rw [op_comp, Functor.map_comp]
    rfl

  have hL3 : ∀ (U : X.Etale) (m : ↑((wcEtZModRing X n).obj.obj (Opposite.op U))) (x : U.left),
      ∃ (W : X.Etale) (f : W ⟶ U) (w : W.left) (k : ℤ), Etale f.left ∧ f.left w = x ∧
        ((wcEtZModRing X n).obj.map f.op).hom m =
          ((k : ℤ) : ↑((wcEtZModRing X n).obj.obj (Opposite.op W))) := by
    intro U m x
    haveI := hαs
    have hS := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology X) α (U := Opposite.op U) m
    obtain ⟨W, f, w, ⟨a, ha⟩, hEt, hw⟩ := hcov' X _ _ hS x
    refine ⟨W, f, w, ((a.down).cast : ℤ), hEt, hw, ?_⟩
    have hak : (((a.down.cast : ℤ)) : ULift.{u+1} (ZMod n)) = a :=
      ULift.ext _ _ (by rw [ULift.down_intCast]; exact ZMod.intCast_zmod_cast _)
    rw [← map_intCast (α.app (Opposite.op W)).hom, hak]
    exact ha.symm

  let ρV : ∀ W : Y.Etale, ↑((wcEtZModRing Y n).obj.obj (Opposite.op W)) →+
      ↑((wcEtZModRing X n).obj.obj (Opposite.op ((wcEtBaseChange b).obj W))) :=
    fun W => ((wcEtSuppUnitMap D).val.app (Opposite.op W)).hom.toAddMonoidHom
  have huntw : ∀ V : Y.Etale, ∃ s t : ↑((wcEtZModRing X n).obj.obj
      (Opposite.op ((wcEtBaseChange b).obj V))), ρV V 1 = s ∧ s * t = 1 := by
    intro V
    haveI := D.cont
    let c := @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange b) _ _
      D.cont D.φ
    let e := D.μ.inv ≫ (D.adj.homEquiv _ _).symm c
    have h0 : wcEtSuppUnitMap D = D.adj.homEquiv _ _ D.μ.hom :=
      (D.adj.homEquiv_unit _ _ _).symm
    have h1 : (D.adj.homEquiv _ _ D.μ.hom) ≫ (@SheafOfModules.pushforward _ _ _ _ _ _
        (wcEtBaseChange b) _ _ D.cont D.φ).map e = c := by
      rw [← Adjunction.homEquiv_naturality_right, Iso.hom_inv_id_assoc,
        Equiv.apply_symm_apply]
    let eF : ↑((wcEtZModRing X n).obj.obj (Opposite.op ((wcEtBaseChange b).obj V))) →
        ↑((wcEtZModRing X n).obj.obj (Opposite.op ((wcEtBaseChange b).obj V))) :=
      fun y => (e.val.app (Opposite.op ((wcEtBaseChange b).obj V))).hom y
    let cV : ↑((wcEtZModRing Y n).obj.obj (Opposite.op V)) →
        ↑((wcEtZModRing X n).obj.obj (Opposite.op ((wcEtBaseChange b).obj V))) :=
      fun y => (c.val.app (Opposite.op V)).hom y
    have h3 : cV 1 = 1 :=
      (SheafOfModules.unitToPushforwardObjUnit_val_app_apply D.φ
        (1 : ↑((wcEtZModRing Y n).obj.obj (Opposite.op V)))).trans
        (map_one (D.φ.hom.app (Opposite.op V)).hom)
    have h2' : eF (ρV V 1) = cV 1 := by
      have hA := congrArg (fun φ : SheafOfModules.unit (wcEtZModRing Y n) ⟶ wcEtSuppObj D =>
        ((φ ≫ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange b) _ _ D.cont
          D.φ).map e).val.app (Opposite.op V)).hom
          (1 : ↑((wcEtZModRing Y n).obj.obj (Opposite.op V)))) h0
      have hB := congrArg (fun φ => (φ.val.app (Opposite.op V)).hom
        (1 : ↑((wcEtZModRing Y n).obj.obj (Opposite.op V)))) h1
      exact hA.trans hB
    have h2 : eF (ρV V 1) = 1 := h2'.trans h3
    have h4 : ∀ y, eF y = y * eF 1 := by
      intro y
      have h := (e.val.app (Opposite.op ((wcEtBaseChange b).obj V))).hom.map_smul y
        (1 : ↑((wcEtZModRing X n).obj.obj (Opposite.op ((wcEtBaseChange b).obj V))))
      exact (congrArg eF (mul_one y).symm).trans h
    exact ⟨ρV V 1, eF 1, rfl, (h4 _).symm.trans h2⟩
  let m' : ↑((wcEtZModRing X n).obj.obj (Opposite.op ((wcEtBaseChange b).obj V))) := g
  obtain ⟨s, t, hs, hst⟩ := huntw V
  have hm : m' = s * (t * m') := by rw [← mul_assoc, hst, one_mul]

  let A : V.left.Opens := V.hom ⁻¹ᵁ O
  let V' : Y.Etale := wcEtOpen Y V A
  let j : V' ⟶ V := wcEtOpenι Y V A
  have hV'range : Set.range V'.hom ⊆ (O : Set Y) := by
    rintro _ ⟨z, rfl⟩
    have h1 : V'.hom z = V.hom (A.ι z) := Scheme.Hom.comp_apply _ _ _
    rw [h1]
    have h2 : A.ι z ∈ A := by
      have := Set.mem_range_self (f := ⇑A.ι) z
      rwa [Scheme.Opens.range_ι] at this
    exact h2
  obtain ⟨v', hv'⟩ : v ∈ Set.range A.ι := by
    rw [Scheme.Opens.range_ι]
    exact hv
  haveI hπ' : IsIso (Limits.pullback.fst V'.hom b) := hπ V'.hom hV'range
  obtain ⟨w, hw⟩ := (Limits.pullback.fst V'.hom b).homeomorph.surjective v'
  have hw' : Limits.pullback.fst V'.hom b w = v' := hw

  obtain ⟨W, f, w₀, k, hEtf, hw₀, hk⟩ := hL3 ((wcEtBaseChange b).obj V')
    (((wcEtZModRing X n).obj.map ((wcEtBaseChange b).map j).op).hom (t * m')) w

  haveI := hEtf
  haveI : Etale V'.hom := V'.prop
  have hfw : f.left ≫ Limits.pullback.snd V'.hom b = W.hom := MorphismProperty.Over.w f
  have hEtπ : Etale (Limits.pullback.fst V'.hom b) := inferInstance
  have hEt2 : Etale (Limits.pullback.fst V'.hom b ≫ V'.hom) :=
    @MorphismProperty.comp_mem _ _ @Etale
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ hEtπ V'.prop
  have hg₂et : Etale (f.left ≫ Limits.pullback.fst V'.hom b ≫ V'.hom) :=
    @MorphismProperty.comp_mem _ _ @Etale
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ hEtf hEt2
  have hg₂range : Set.range (f.left ≫ Limits.pullback.fst V'.hom b ≫ V'.hom) ⊆ (O : Set Y) := by
    rintro _ ⟨z, rfl⟩
    apply hV'range
    refine ⟨Limits.pullback.fst V'.hom b (f.left z), ?_⟩
    exact ((Scheme.Hom.comp_apply f.left (Limits.pullback.fst V'.hom b ≫ V'.hom) z).trans
      (Scheme.Hom.comp_apply _ _ _)).symm
  haveI hfst₂ : IsIso (Limits.pullback.fst (f.left ≫ Limits.pullback.fst V'.hom b ≫ V'.hom) b) :=
    hπ _ hg₂range
  have hWb : W.hom ≫ b = f.left ≫ Limits.pullback.fst V'.hom b ≫ V'.hom :=
    (congrArg (· ≫ b) hfw.symm).trans ((Category.assoc _ _ _).trans
      (congrArg (f.left ≫ ·) (Limits.pullback.condition (f := V'.hom) (g := b)).symm))
  have hw₂ : Limits.pullback.fst (f.left ≫ Limits.pullback.fst V'.hom b ≫ V'.hom) b ≫
      (f.left ≫ Limits.pullback.fst V'.hom b ≫ V'.hom) =
      (Limits.pullback.fst (f.left ≫ Limits.pullback.fst V'.hom b ≫ V'.hom) b ≫ W.hom) ≫ b := by
    rw [Category.assoc, hWb]
  have hE : Limits.pullback.fst (f.left ≫ Limits.pullback.fst V'.hom b ≫ V'.hom) b ≫ W.hom =
      Limits.pullback.snd (f.left ≫ Limits.pullback.fst V'.hom b ≫ V'.hom) b := by
    have hl : Limits.pullback.lift (f := f.left ≫ Limits.pullback.fst V'.hom b ≫ V'.hom) (g := b)
        (Limits.pullback.fst (f.left ≫ Limits.pullback.fst V'.hom b ≫ V'.hom) b)
        (Limits.pullback.fst (f.left ≫ Limits.pullback.fst V'.hom b ≫ V'.hom) b ≫ W.hom) hw₂ =
        𝟙 _ := by
      rw [← cancel_mono (Limits.pullback.fst (f.left ≫ Limits.pullback.fst V'.hom b ≫ V'.hom) b),
        Limits.pullback.lift_fst, Category.id_comp]
    have h2 : Limits.pullback.lift (f := f.left ≫ Limits.pullback.fst V'.hom b ≫ V'.hom) (g := b)
        (Limits.pullback.fst (f.left ≫ Limits.pullback.fst V'.hom b ≫ V'.hom) b)
        (Limits.pullback.fst (f.left ≫ Limits.pullback.fst V'.hom b ≫ V'.hom) b ≫ W.hom) hw₂ ≫
        Limits.pullback.snd (f.left ≫ Limits.pullback.fst V'.hom b ≫ V'.hom) b =
        Limits.pullback.fst (f.left ≫ Limits.pullback.fst V'.hom b ≫ V'.hom) b ≫ W.hom :=
      Limits.pullback.lift_snd _ _ _
    rw [hl, Category.id_comp] at h2
    exact h2.symm
  obtain ⟨V₂, c₂, h, hfac, v₂, hc₂pt⟩ : ∃ (V₂ : Y.Etale) (c₂ : V₂ ⟶ V')
      (h : (wcEtBaseChange b).obj V₂ ⟶ W),
      (wcEtBaseChange b).map c₂ = h ≫ f ∧ ∃ v₂ : V₂.left, c₂.left v₂ = v' := by
    let V₂ : Y.Etale := MorphismProperty.Over.mk ⊤
      (f.left ≫ Limits.pullback.fst V'.hom b ≫ V'.hom) hg₂et
    let c₂ : V₂ ⟶ V' := MorphismProperty.Over.homMk (f.left ≫ Limits.pullback.fst V'.hom b)
      (Category.assoc _ _ _) trivial
    let h : (wcEtBaseChange b).obj V₂ ⟶ W := MorphismProperty.Over.homMk
      (Limits.pullback.fst (f.left ≫ Limits.pullback.fst V'.hom b ≫ V'.hom) b) hE trivial
    have h1 : ((wcEtBaseChange b).map c₂).left ≫ Limits.pullback.fst V'.hom b =
        Limits.pullback.fst (f.left ≫ Limits.pullback.fst V'.hom b ≫ V'.hom) b ≫
          (f.left ≫ Limits.pullback.fst V'.hom b) :=
      Limits.pullback.lift_fst _ _ _
    refine ⟨V₂, c₂, h, ?_, w₀, ?_⟩
    · apply MorphismProperty.Over.Hom.ext
      apply (cancel_mono (Limits.pullback.fst V'.hom b)).mp
      exact h1.trans (Category.assoc _ _ _).symm
    · exact (Scheme.Hom.comp_apply f.left (Limits.pullback.fst V'.hom b) w₀).trans
        ((congrArg (Limits.pullback.fst V'.hom b) hw₀).trans hw')
  have hpt : (c₂ ≫ j).left v₂ = v :=
    (Scheme.Hom.comp_apply c₂.left j.left v₂).trans ((congrArg j.left hc₂pt).trans hv')
  refine ⟨V₂, c₂ ≫ j, v₂, (k : ↑((wcEtZModRing Y n).obj.obj (Opposite.op V₂))), hpt, ?_⟩
  change ρV V₂ (k : ↑((wcEtZModRing Y n).obj.obj (Opposite.op V₂))) =
      ((wcEtZModRing X n).obj.map ((wcEtBaseChange b).map (c₂ ≫ j)).op).hom m'
  have e1 : ρV V₂ (k : ↑((wcEtZModRing Y n).obj.obj (Opposite.op V₂))) =
      (k : ↑((wcEtZModRing X n).obj.obj (Opposite.op ((wcEtBaseChange b).obj V₂)))) *
        ρV V₂ 1 := by
    have hk1 : (k : ↑((wcEtZModRing Y n).obj.obj (Opposite.op V₂))) =
        k • (1 : ↑((wcEtZModRing Y n).obj.obj (Opposite.op V₂))) :=
      (Int.smul_one_eq_cast k).symm
    rw [hk1, map_zsmul, zsmul_eq_mul]
  have e2 : ρV V₂ 1 =
      ((wcEtZModRing X n).obj.map ((wcEtBaseChange b).map (c₂ ≫ j)).op).hom (ρV V 1) := by
    have h := PresheafOfModules.naturality_apply (wcEtSuppUnitMap D).val
      (c₂ ≫ j).op (1 : ↑((wcEtZModRing Y n).obj.obj (Opposite.op V)))
    have h1' : ((wcEtZModRing Y n).obj.map (c₂ ≫ j).op).hom
        (1 : ↑((wcEtZModRing Y n).obj.obj (Opposite.op V))) = 1 := map_one _
    exact (congrArg (ρV V₂) h1'.symm).trans h
  have e3 : ((wcEtZModRing X n).obj.map ((wcEtBaseChange b).map (c₂ ≫ j)).op).hom (t * m') =
      (k : ↑((wcEtZModRing X n).obj.obj (Opposite.op ((wcEtBaseChange b).obj V₂)))) := by
    rw [Functor.map_comp, ← hcomp, hfac, ← hcomp, hk]
    exact map_intCast _ _
  rw [e1, e2, hs, hm, map_mul, e3]
  exact Int.cast_comm _ _

theorem wc_bfpi_stalk_surj_of_local_surj : ∀ {B : Scheme.{u}} {F G : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}} (φ : F ⟶ G) (b : B), (∀ (V : B.Etale) (s : G.obj.obj (Opposite.op V)) (v : V.left), V.hom v = b → ∃ (V₁ : B.Etale) (c : V₁ ⟶ V) (v₁ : V₁.left) (t : F.obj.obj (Opposite.op V₁)), c.left v₁ = v ∧ (φ.hom.app (Opposite.op V₁)).hom t = (G.obj.map c.op).hom s) → Function.Surjective ((wcEtStalk B b).map φ).hom :=
by
  intro B F G φ b hloc
  classical
  have hlift : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] {V U : Scheme.{u}} (g : V ⟶ U) [Etale g]
      (s : Spec (.of Ω) ⟶ U) (v : V), g v = s (IsLocalRing.closedPoint Ω) →
      ∃ t : Spec (.of Ω) ⟶ V, t ≫ g = s := by
    intro Ω _ _ V U g _ s v hv
    have hs : s = Spec.map (Scheme.SpecToEquivOfField Ω U s).2 ≫
        U.fromSpecResidueField (Scheme.SpecToEquivOfField Ω U s).1 := by
      rw [← Scheme.SpecToEquivOfField_symm_apply, Equiv.symm_apply_apply]
    have h1 : (Scheme.SpecToEquivOfField Ω U s).1 = s (IsLocalRing.closedPoint Ω) := rfl
    generalize Scheme.SpecToEquivOfField Ω U s = p at hs h1
    obtain ⟨u', ψ⟩ := p
    simp only at hs h1
    rw [← h1] at hv
    subst hv
    letI : Algebra (U.residueField (g v)) (V.residueField v) := (g.residueFieldMap v).hom.toAlgebra
    haveI : Algebra.IsSeparable (U.residueField (g v)) (V.residueField v) := inferInstance
    haveI : Algebra.IsAlgebraic (U.residueField (g v)) (V.residueField v) :=
      Algebra.IsSeparable.isAlgebraic _ _
    letI : Algebra (U.residueField (g v)) Ω := ψ.hom.toAlgebra
    let χ₀ : V.residueField v →ₐ[U.residueField (g v)] Ω :=
      IsAlgClosed.lift (R := U.residueField (g v)) (S := V.residueField v) (M := Ω)
    let χ : V.residueField v ⟶ CommRingCat.of Ω := CommRingCat.ofHom χ₀.toRingHom
    have hχ : g.residueFieldMap v ≫ χ = ψ := by
      ext r
      exact χ₀.commutes r
    refine ⟨Spec.map χ ≫ V.fromSpecResidueField v, ?_⟩
    rw [Category.assoc, ← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField,
      ← Category.assoc, ← Spec.map_comp, hχ, hs]
  let X₀ : Over B := Over.mk (wcEtGeomPt B b)
  haveI : IsCofiltered (StructuredArrow X₀ (Scheme.Etale.forget B)) :=
    IsCofiltered.of_hasFiniteLimits _
  haveI : Limits.PreservesFilteredColimitsOfSize.{u, u+1} (forget AddCommGrpCat.{u+1}) :=
    Limits.preservesFilteredColimitsOfSize_shrink.{u+1, u+1, u, u+1} (forget AddCommGrpCat.{u+1})
  intro z
  let D := (StructuredArrow.proj X₀ (Scheme.Etale.forget B)).op ⋙ G.obj
  let DF := (StructuredArrow.proj X₀ (Scheme.Etale.forget B)).op ⋙ F.obj
  obtain ⟨j, t, ht⟩ := Limits.Concrete.colimit_exists_rep D z
  have hA : j.unop.hom.left ≫ j.unop.right.hom = wcEtGeomPt B b := Over.w j.unop.hom
  have hv : j.unop.right.hom
      (j.unop.hom.left (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b)))) = b := by
    have e : (j.unop.hom.left ≫ j.unop.right.hom)
        (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b))) =
        (wcEtGeomPt B b) (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b))) := by
      rw [hA]
    exact e.trans (Scheme.fromSpecResidueField_apply b _)
  obtain ⟨V₁, c, y, f, hy, hf⟩ := hloc j.unop.right t
    (j.unop.hom.left (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b)))) hv
  have hw : c.left ≫ j.unop.right.hom = V₁.hom := MorphismProperty.Over.w c
  haveI : Etale c.left := by
    have h1 : Etale j.unop.right.hom := j.unop.right.prop
    have h2 : Etale (c.left ≫ j.unop.right.hom) := by rw [hw]; exact V₁.prop
    exact Etale.of_comp c.left j.unop.right.hom
  obtain ⟨a', ha'⟩ := hlift (AlgebraicClosure (B.residueField b))
    c.left j.unop.hom.left y hy
  have h : a' ≫ V₁.hom = wcEtGeomPt B b := by
    rw [← hw, ← Category.assoc, ha']
    exact hA
  let A' : StructuredArrow X₀ (Scheme.Etale.forget B) :=
    StructuredArrow.mk (Y := V₁) (Over.homMk (U := X₀) (V := (Scheme.Etale.forget B).obj V₁) a' h)
  let α : A' ⟶ j.unop := StructuredArrow.homMk c (Over.OverMorphism.ext ha')
  refine ⟨(Limits.colimit.ι DF (Opposite.op A')).hom f, ?_⟩
  have e1 := Limits.colimit.ι_map_apply
    (Functor.whiskerLeft (StructuredArrow.proj X₀ (Scheme.Etale.forget B)).op
      φ.hom) (Opposite.op A') f
  have e2 := Limits.colimit.w_apply D α.op t
  calc ((wcEtStalk B b).map φ).hom ((Limits.colimit.ι DF (Opposite.op A')).hom f)
      = (Limits.colimit.ι D (Opposite.op A')).hom
          ((φ.hom.app (Opposite.op V₁)).hom f) := e1
    _ = (Limits.colimit.ι D (Opposite.op A')).hom
          ((G.obj.map c.op).hom t) :=
        congrArg (fun w => (Limits.colimit.ι D (Opposite.op A')).hom w) hf
    _ = (Limits.colimit.ι D (Opposite.op A')).hom ((D.map α.op).hom t) := rfl
    _ = (Limits.colimit.ι D j).hom t := e2
    _ = z := ht

theorem wc_bfpi_supp_unit_mono_of_surj : ∀ {X Y : Scheme.{u}} (b : X ⟶ Y), Set.range b = Set.univ → ∀ (n : ℕ) (D : wcEtPullData b n), Mono (wcEtSuppUnitMap D) :=
by
  intro X Y b hsurj n D
  classical

  have locbij : ∀ (S : Scheme.{u}) (n : ℕ),
      ∃ α : (Functor.const (S.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶ (wcEtZModRing S n).obj,
        Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology S) α ∧
        Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology S) α := by
    intro S n
    let P : (S.Etale)ᵒᵖ ⥤ RingCat.{u+1} :=
      (Functor.const (S.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n)))
    exact ⟨toSheafify (Scheme.smallEtaleTopology S) P,
      Presheaf.isLocallyInjective_toSheafify' (Scheme.smallEtaleTopology S) P,
      Presheaf.isLocallySurjective_toSheafify' (Scheme.smallEtaleTopology S) P⟩

  have covsurj : ∀ (S : Scheme.{u}) (V : S.Etale) (R : Sieve V),
      R ∈ Scheme.smallEtaleTopology S V → ∀ x : V.left,
      ∃ (Y : S.Etale) (f : Y ⟶ V) (y : Y.left), R.arrows f ∧ f.left y = x := by
    intro S V R h x
    haveI : MorphismProperty.IsStableUnderComposition (@Etale : MorphismProperty Scheme.{u}) :=
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have e := Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := (@Etale : MorphismProperty Scheme.{u})) (Q := (@Etale : MorphismProperty Scheme.{u})) S le_rfl
    have h' := (Scheme.mem_toGrothendieck_smallPretopology (P := @Etale) (Q := @Etale) V R).mp (e ▸ h)
    obtain ⟨Y, f, y, h1, _, h3⟩ := h' x
    exact ⟨Y, f, y, h1, h3⟩

  have hcov : ∀ (S : Scheme.{u}) (V : S.Etale) (T : Sieve V), (∀ v : V.left, ∃ (W : S.Etale)
      (f : W ⟶ V) (w : W.left), T.arrows f ∧ Etale f.left ∧ f.left w = v) →
      T ∈ Scheme.smallEtaleTopology S V := by
    intro S V T h
    change T ∈ Scheme.smallGrothendieckTopology @Etale S V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale S
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    exact (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale S
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V T).mpr h

  have twist : ∀ {S T : Scheme.{u}} {j : T ⟶ S} {n : ℕ} (E : wcEtPullData j n),
      ∃ e : SheafOfModules.unit (wcEtZModRing T n) ⟶ SheafOfModules.unit (wcEtZModRing T n),
        wcEtSuppUnitMap E ≫ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange j) _ _ E.cont E.φ).map e
          = @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange j) _ _ E.cont E.φ := by
    intro S T j n E
    refine ⟨E.μ.inv ≫ (E.adj.homEquiv _ _).symm
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange j) _ _ E.cont E.φ), ?_⟩
    dsimp only [wcEtSuppUnitMap, wcEtSuppObj]
    rw [Category.assoc, ← Functor.map_comp, Iso.hom_inv_id_assoc,
      ← Adjunction.homEquiv_unit, Equiv.apply_symm_apply]
  have intcast_eq : ∀ (S : Scheme.{u}) (n : ℕ) (V : S.Etale)
      (α : (Functor.const (S.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶ (wcEtZModRing S n).obj)
      (c : ULift.{u+1} (ZMod n)),
      (α.app (Opposite.op V)).hom c = (((c.down.cast : ℤ)) : ↑((wcEtZModRing S n).obj.obj (Opposite.op V))) := by
    intro S n V α c
    have hc : c = (((c.down.cast : ℤ)) : ULift.{u+1} (ZMod n)) := by
      apply ULift.ext
      rw [ULift.down_intCast, ZMod.intCast_zmod_cast]
    conv_lhs => rw [hc]
    exact map_intCast (α.app (Opposite.op V)).hom _
  have intzero : ∀ (S : Scheme.{u}) (n : ℕ) (V : S.Etale) (k : ℤ),
      (k : ↑((wcEtZModRing S n).obj.obj (Opposite.op V))) = 0 → (k : ZMod n) = 0 ∨ IsEmpty V.left := by
    intro S n V k hk
    by_cases hV : IsEmpty V.left
    · exact Or.inr hV
    · left
      obtain ⟨x⟩ := not_isEmpty_iff.mp hV
      obtain ⟨α, hinj, hsurj⟩ := locbij S n
      have h1 : (α.app (Opposite.op V)).hom ((k : ULift.{u+1} (ZMod n))) =
          (α.app (Opposite.op V)).hom (0 : ULift.{u+1} (ZMod n)) := by
        rw [map_intCast, map_zero]; exact hk
      have hmem := Presheaf.equalizerSieve_mem (Scheme.smallEtaleTopology S) α _ _ h1
      obtain ⟨Q, g, _, hg, _⟩ := covsurj S V _ hmem x
      have h2 : ((k : ULift.{u+1} (ZMod n))) = 0 := hg
      have h3 := congrArg ULift.down h2
      rw [ULift.down_intCast] at h3
      exact h3

  have hsepY : Presheaf.IsSeparated (Scheme.smallEtaleTopology Y) (wcEtZModRing Y n).obj :=
    Sheaf.isSeparated (wcEtZModRing Y n)
  have hemptyY : ∀ (Q : Y.Etale), IsEmpty Q.left →
      ∀ a c : ↑((wcEtZModRing Y n).obj.obj (Opposite.op Q)), a = c := by
    intro Q hQ a c
    exact hsepY Q ⊥ (hcov Y Q ⊥ (fun v => isEmptyElim v)) a c (fun _ _ h => False.elim h)

  have core : ∀ (V : Y.Etale) (k : ↑((wcEtZModRing Y n).obj.obj (Opposite.op V))),
      ((wcEtSuppUnitMap D).val.app (Opposite.op V)).hom k = 0 → k = 0 := by
    intro V k hρk
    have hφk : (D.φ.hom.app (Opposite.op V)).hom k = 0 := by
      obtain ⟨e', he'⟩ := twist D
      have h2 := congrArg (fun h => (h.val.app (Opposite.op V)).hom k) he'
      change (e'.val.app (Opposite.op ((wcEtBaseChange b).obj V))).hom
        (((wcEtSuppUnitMap D).val.app (Opposite.op V)).hom k) =
        (D.φ.hom.app (Opposite.op V)).hom k at h2
      rw [hρk] at h2
      exact h2.symm.trans (LinearMap.map_zero _)
    obtain ⟨α, -, hαs⟩ := locbij Y n
    refine hsepY V _ (Presheaf.imageSieve_mem (Scheme.smallEtaleTopology Y) α k) k 0
      (fun V' g hg => ?_)
    have h0 : ((wcEtZModRing Y n).obj.map g.op).hom
        (0 : ↑((wcEtZModRing Y n).obj.obj (Opposite.op V))) = 0 := map_zero _
    refine Eq.trans ?_ h0.symm
    obtain ⟨c, hc⟩ := hg
    have hk' : ((wcEtZModRing Y n).obj.map g.op).hom k =
        ((c.down.cast : ℤ) : ↑((wcEtZModRing Y n).obj.obj (Opposite.op V'))) :=
      hc.symm.trans (intcast_eq Y n V' α c)
    have hnat := congrArg (fun h => h.hom k) (D.φ.hom.naturality g.op)
    simp only [RingCat.hom_comp, RingHom.comp_apply] at hnat
    rw [hφk, map_zero, hk', map_intCast] at hnat
    rcases intzero X n ((wcEtBaseChange b).obj V') _ hnat with hk0 | hE
    · rw [ZMod.intCast_zmod_cast] at hk0
      have hc0 : c = 0 := ULift.ext _ _ hk0
      rw [← hc, hc0, map_zero]
    · apply hemptyY
      refine ⟨fun v => ?_⟩
      have hv : V'.hom v ∈ Set.range b := by rw [hsurj]; exact Set.mem_univ _
      obtain ⟨z, hz⟩ := hv
      have hE' : IsEmpty ↥(Limits.pullback V'.hom b) := hE
      obtain ⟨w, -, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := V'.hom) (g := b) v z hz.symm
      exact hE'.false w

  have hrefl : (SheafOfModules.toSheaf (wcEtZModRing Y n)).ReflectsMonomorphisms :=
    Functor.reflectsMonomorphisms_of_faithful _
  apply Functor.mono_of_mono_map (SheafOfModules.toSheaf (wcEtZModRing Y n))
  haveI : Sheaf.IsLocallyInjective
      ((SheafOfModules.toSheaf (wcEtZModRing Y n)).map (wcEtSuppUnitMap D)) := by
    refine Presheaf.IsLocallyInjective.mk (fun {V} x y hxy => ?_)
    have hxy' : x = y := by
      let x' : ↑((SheafOfModules.unit (wcEtZModRing Y n)).val.obj V) := x
      let y' : ↑((SheafOfModules.unit (wcEtZModRing Y n)).val.obj V) := y
      have h1 : ((wcEtSuppUnitMap D).val.app V).hom (x' - y') = 0 := by
        rw [map_sub, sub_eq_zero]
        exact hxy
      have h2 := core V.unop (x' - y') h1
      exact sub_eq_zero.mp h2
    subst hxy'
    exact (Scheme.smallEtaleTopology Y).superset_covering (fun W f _ => rfl)
      ((Scheme.smallEtaleTopology Y).top_mem _)
  exact Sheaf.mono_of_isLocallyInjective _

theorem wc_bfpi_pull_supp_transfer_finite : ∀ {X Z : Scheme.{u}} (i : Z ⟶ X) [IsFinite i] (n : ℕ) (D : wcEtPullData i n) (k : ℕ), letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing X n)) := HasExt.standard _; ∃ T : wcEtZModExt Z n k → Abelian.Ext (SheafOfModules.unit (wcEtZModRing X n)) (wcEtSuppObj D) k, Function.Injective T ∧ ∀ y : wcEtZModExt X n k, T (wcEtPull D k y) = y.comp (Abelian.Ext.mk₀ (wcEtSuppUnitMap D)) (add_zero k) :=
by
  intro X Z i _ n D k
  letI hX : HasExt (SheafOfModules.{u+1} (wcEtZModRing X n)) := HasExt.standard _
  letI hZ : HasExt (SheafOfModules.{u+1} (wcEtZModRing Z n)) := HasExt.standard _
  haveI := D.additive
  haveI := D.presLim
  haveI := D.presColim
  haveI := D.cont
  let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ
  haveI : P.Additive := D.adj.right_adjoint_additive
  haveI : Limits.PreservesLimitsOfSize.{0, 0} P := D.adj.rightAdjoint_preservesLimits
  haveI : Limits.PreservesFiniteLimits P := inferInstance
  haveI : Limits.PreservesFiniteColimits P := wc_et_finite_push_modules_exact i n D
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing X n)) :=
    sheafOfModules_enoughInjectives _ _
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing Z n)) :=
    sheafOfModules_enoughInjectives _ _

  have hnat : ∀ (m : ℕ) (B : SheafOfModules.{u+1} (wcEtZModRing X n))
      (u : Abelian.Ext (SheafOfModules.unit (wcEtZModRing X n)) B m),
      u.comp (Abelian.Ext.mk₀ (D.adj.unit.app B)) (add_zero m) =
        (Abelian.Ext.mk₀ (D.adj.unit.app (SheafOfModules.unit (wcEtZModRing X n)))).comp
          (Abelian.Ext.mapExactFunctor P (Abelian.Ext.mapExactFunctor D.Φ u)) (zero_add m) := by
    intro m
    induction m with
    | zero =>
      intro B u
      obtain ⟨f, rfl⟩ : ∃ f, Abelian.Ext.mk₀ f = u := ⟨_, Abelian.Ext.mk₀_homEquiv₀_apply u⟩
      rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀]
      congr 1
      exact D.adj.unit.naturality f
    | succ m ih =>
      intro B u
      let j := Injective.ι B
      let S : ShortComplex (SheafOfModules.{u+1} (wcEtZModRing X n)) :=
        ShortComplex.mk j (Limits.cokernel.π j) (Limits.cokernel.condition j)
      have hS : S.ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel j) inferInstance inferInstance
      haveI : Injective S.X₂ := (inferInstance : Injective (Injective.under B))
      have h0 : u.comp (Abelian.Ext.mk₀ S.f) (add_zero _) = 0 :=
        Abelian.Ext.eq_zero_of_injective _
      obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hS u h0 (n₀ := m) rfl
      subst hx₃
      have hS1 : (S.map D.Φ).ShortExact := hS.map_of_exact D.Φ
      have hS2 : ((S.map D.Φ).map P).ShortExact := hS1.map_of_exact P
      let φ : S ⟶ (S.map D.Φ).map P :=
        ShortComplex.homMk (D.adj.unit.app S.X₁) (D.adj.unit.app S.X₂) (D.adj.unit.app S.X₃)
          (D.adj.unit.naturality S.f).symm (D.adj.unit.naturality S.g).symm
      have hnatS : hS.extClass.comp (Abelian.Ext.mk₀ (D.adj.unit.app S.X₁)) (add_zero 1) =
          (Abelian.Ext.mk₀ (D.adj.unit.app S.X₃)).comp hS2.extClass (zero_add 1) :=
        hS.extClass_naturality hS2 φ
      have hext : Abelian.Ext.mapExactFunctor P (Abelian.Ext.mapExactFunctor D.Φ hS.extClass) =
          hS2.extClass := by
        rw [Abelian.Ext.mapExactFunctor_extClass, Abelian.Ext.mapExactFunctor_extClass]
      calc (x₃.comp hS.extClass rfl).comp (Abelian.Ext.mk₀ (D.adj.unit.app B)) (add_zero (m + 1))
          = x₃.comp (hS.extClass.comp (Abelian.Ext.mk₀ (D.adj.unit.app S.X₁)) (add_zero 1))
              (by omega) :=
            Abelian.Ext.comp_assoc x₃ hS.extClass (Abelian.Ext.mk₀ (D.adj.unit.app S.X₁)) rfl
              (add_zero 1) (by omega)
        _ = x₃.comp ((Abelian.Ext.mk₀ (D.adj.unit.app S.X₃)).comp hS2.extClass (zero_add 1))
              (by omega) := by rw [hnatS]
        _ = (x₃.comp (Abelian.Ext.mk₀ (D.adj.unit.app S.X₃)) (add_zero m)).comp hS2.extClass rfl :=
            (Abelian.Ext.comp_assoc x₃ (Abelian.Ext.mk₀ (D.adj.unit.app S.X₃)) hS2.extClass
              (add_zero m) (zero_add 1) (by omega)).symm
        _ = ((Abelian.Ext.mk₀ (D.adj.unit.app (SheafOfModules.unit (wcEtZModRing X n)))).comp
              (Abelian.Ext.mapExactFunctor P (Abelian.Ext.mapExactFunctor D.Φ x₃)) (zero_add m)).comp
              hS2.extClass rfl := by rw [ih S.X₃ x₃]
        _ = (Abelian.Ext.mk₀ (D.adj.unit.app (SheafOfModules.unit (wcEtZModRing X n)))).comp
              ((Abelian.Ext.mapExactFunctor P (Abelian.Ext.mapExactFunctor D.Φ x₃)).comp
                hS2.extClass rfl) (by omega) :=
            Abelian.Ext.comp_assoc _ _ _ (zero_add m) rfl (by omega)
        _ = (Abelian.Ext.mk₀ (D.adj.unit.app (SheafOfModules.unit (wcEtZModRing X n)))).comp
              (Abelian.Ext.mapExactFunctor P (Abelian.Ext.mapExactFunctor D.Φ
                (x₃.comp hS.extClass rfl))) (zero_add (m + 1)) := by
            rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp, hext]

  have hΘ := (wc_ext_adjoint_transfer D.Φ P D.adj (SheafOfModules.unit (wcEtZModRing X n))
    (SheafOfModules.unit (wcEtZModRing Z n)) k).1
  have hfac : ∀ β : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Z n))
      (SheafOfModules.unit (wcEtZModRing Z n)) k,
      (Abelian.Ext.mk₀ (wcEtSuppUnitMap D)).comp (Abelian.Ext.mapExactFunctor P β) (zero_add k) =
      (Abelian.Ext.mk₀ (D.adj.unit.app (SheafOfModules.unit (wcEtZModRing X n)))).comp
        (Abelian.Ext.mapExactFunctor P ((Abelian.Ext.mk₀ D.μ.hom).comp β (zero_add k)))
        (zero_add k) := by
    intro β
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.mk₀_comp_mk₀_assoc]
    rfl
  refine ⟨fun β => (Abelian.Ext.mk₀ (wcEtSuppUnitMap D)).comp
    (Abelian.Ext.mapExactFunctor P β) (zero_add k), ?_, ?_⟩
  · intro β₁ β₂ h
    have h' : (Abelian.Ext.mk₀ D.μ.hom).comp β₁ (zero_add k) =
        (Abelian.Ext.mk₀ D.μ.hom).comp β₂ (zero_add k) :=
      hΘ ((hfac β₁).symm.trans (h.trans (hfac β₂)))
    have e : ∀ β : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Z n))
        (SheafOfModules.unit (wcEtZModRing Z n)) k,
        (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mk₀ D.μ.hom).comp β (zero_add k))
          (zero_add k) = β := by
      intro β
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
    rw [← e β₁, ← e β₂, h']
  · intro y
    have hpull : wcEtPull D k y = (Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero k))
        (zero_add k) := rfl
    show (Abelian.Ext.mk₀ (wcEtSuppUnitMap D)).comp
      (Abelian.Ext.mapExactFunctor P (wcEtPull D k y)) (zero_add k) = _
    rw [hpull, hfac, Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp,
      Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_assoc _ _ _ (zero_add k) (add_zero k) (show 0 + k + 0 = k by omega),
      ← hnat k _ y,
      Abelian.Ext.comp_assoc _ _ _ (add_zero k) (zero_add 0) (show k + 0 + 0 = k by omega),
      Abelian.Ext.mk₀_comp_mk₀]
    rfl

theorem wc_pow_curve_h2_birational_finite_pull_injective : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (R : Scheme.{u}) (fR : R ⟶ Spec (.of Ω)) [IsProper fR] [IrreducibleSpace R], topologicalKrullDim R ≤ ((1 : ℕ) : WithBot ℕ∞) → ¬ topologicalKrullDim R ≤ ((0 : ℕ) : WithBot ℕ∞) → ∀ (X : Scheme.{u}) (b : X ⟶ R) (Z : Scheme.{u}) (iZ : Z ⟶ R), IsFinite b → IsClosedImmersion iZ → topologicalKrullDim Z ≤ ((0 : ℕ) : WithBot ℕ∞) → (∀ U : R.Opens, (U : Set R) = (Set.range iZ)ᶜ → IsIso (b ∣_ U)) → ∀ (M : ℕ), M ≠ 0 → (M : Ω) ≠ 0 → ∀ (D : wcEtPullData b M), Function.Injective (wcEtPull D 2) :=
by
  intro Ω _ _ R fR _ _ hR1 hR0 X b Z iZ hb hiZ hZ0 hbU M hM hMΩ D
  classical
  haveI := hb
  haveI := hiZ
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing R M)) := HasExt.standard _

  have hTc : IsClosed (Set.range iZ) := iZ.isClosedEmbedding.isClosed_range
  have hTdim0 : topologicalKrullDim ↥(Set.range iZ) ≤ ((0 : ℕ) : WithBot ℕ∞) := by
    have h := IsHomeomorph.topologicalKrullDim_eq _
      iZ.isClosedEmbedding.isEmbedding.toHomeomorph.isHomeomorph
    rw [← h]
    exact hZ0
  have hTdim : topologicalKrullDim ↥(Set.range iZ) < ((1 : ℕ) : WithBot ℕ∞) :=
    lt_of_le_of_lt hTdim0 (by exact_mod_cast Nat.zero_lt_one)
  have hTne : Set.range iZ ≠ Set.univ := by
    intro hT
    apply hR0
    have hsurj : Function.Surjective iZ := fun y => by
      have hy : y ∈ Set.range iZ := hT ▸ Set.mem_univ y
      exact hy
    have hh : IsHomeomorph iZ := isHomeomorph_iff_isEmbedding_surjective.mpr
      ⟨iZ.isClosedEmbedding.isEmbedding, hsurj⟩
    rw [← IsHomeomorph.topologicalKrullDim_eq _ hh]
    exact hZ0
  let O : R.Opens := ⟨(Set.range iZ)ᶜ, hTc.isOpen_compl⟩
  have hO : IsIso (b ∣_ O) := hbU O rfl
  haveI := hO
  have hOne : (O : Set R).Nonempty := Set.nonempty_compl.mpr hTne
  have hOd : Dense (O : Set R) := O.isOpen.dense hOne
  have hOsub : (O : Set R) ⊆ Set.range b := by
    intro y hy
    have hy' : y ∈ Set.range O.ι := by rw [Scheme.Opens.range_ι]; exact hy
    obtain ⟨y', rfl⟩ := hy'
    obtain ⟨x', hx'⟩ := (b ∣_ O).homeomorph.surjective y'
    refine ⟨(b ⁻¹ᵁ O).ι x', ?_⟩
    have e := congrArg (fun f : (b ⁻¹ᵁ O).toScheme ⟶ R => f x') (morphismRestrict_ι b O)
    simp only [Scheme.Hom.comp_apply] at e
    rw [← e]
    exact congrArg O.ι hx'
  have hsurj : Set.range b = Set.univ := by
    apply Set.eq_univ_of_univ_subset
    rw [← hOd.closure_eq]
    exact closure_minimal hOsub b.isClosedMap.isClosed_range

  have hπ : ∀ {W : Scheme.{u}} (h : W ⟶ R), Set.range h ⊆ (O : Set R) →
      IsIso (Limits.pullback.fst h b) := by
    intro W h hh
    let a : W ⟶ O := IsOpenImmersion.lift O.ι h (by rw [Scheme.Opens.range_ι]; exact hh)
    have ha : a ≫ O.ι = h := IsOpenImmersion.lift_fac _ _ _
    have sq1 := IsPullback.of_hasPullback a (b ∣_ O)
    have sq2 := isPullback_morphismRestrict b O
    have sq := (IsPullback.paste_horiz sq1.flip sq2.flip).flip
    rw [ha] at sq
    haveI := sq1.isIso_fst_of_isIso
    rw [← sq.isoPullback_inv_fst]
    infer_instance

  haveI : Mono (wcEtSuppUnitMap D) := wc_bfpi_supp_unit_mono_of_surj b hsurj M D

  have hstalk : ∀ r : R, r ∉ Set.range iZ → Subsingleton ((wcEtStalk R r).obj
      ((SheafOfModules.toSheaf (wcEtZModRing R M)).obj (Limits.cokernel (wcEtSuppUnitMap D)))) := by
    intro r hr
    have hs := wc_bfpi_stalk_surj_of_local_surj
      ((SheafOfModules.toSheaf (wcEtZModRing R M)).map (wcEtSuppUnitMap D)) r
      (fun V s v hv => wc_bfpi_supp_unit_local_surj b O (fun h hh => hπ h hh) M D V s v
        (by rw [hv]; exact hr))
    haveI := wc_r2gc_stalk_coker_subsingleton _ _ _ r hs
    haveI hpres := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.smallEtaleTopology R)
      (wcEtZModRing R M)
    let e : (SheafOfModules.toSheaf (wcEtZModRing R M)).obj (Limits.cokernel (wcEtSuppUnitMap D)) ≅
        Limits.cokernel ((SheafOfModules.toSheaf (wcEtZModRing R M)).map (wcEtSuppUnitMap D)) :=
      Limits.PreservesCokernel.iso (SheafOfModules.toSheaf (wcEtZModRing R M)) (wcEtSuppUnitMap D)
    exact Equiv.subsingleton (Iso.addCommGroupIsoToAddEquiv ((wcEtStalk R r).mapIso e)).toEquiv

  have hE : ∀ x : Abelian.Ext (SheafOfModules.unit (wcEtZModRing R M))
      (Limits.cokernel (wcEtSuppUnitMap D)) 1, x = 0 :=
    (wc_pcrb_module_ext_vanish Ω R fR M hM hMΩ hR1 (Limits.cokernel (wcEtSuppUnitMap D))).2
      (Set.range iZ) hTc hTdim hstalk 1 Nat.one_pos

  obtain ⟨T, -, hT⟩ := wc_bfpi_pull_supp_transfer_finite b M D 2

  have hS : (ShortComplex.mk (wcEtSuppUnitMap D) (Limits.cokernel.π (wcEtSuppUnitMap D))
      (Limits.cokernel.condition (wcEtSuppUnitMap D))).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) inferInstance inferInstance
  rw [injective_iff_map_eq_zero]
  intro y hy
  have hT0 := hT 0
  rw [map_zero, Abelian.Ext.zero_comp] at hT0
  have h0 : y.comp (Abelian.Ext.mk₀ (wcEtSuppUnitMap D)) (add_zero 2) = 0 := by
    rw [← hT y, hy, hT0]
  obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hS y h0 (rfl : 1 + 1 = 2)
  rw [← hx₃, hE x₃, Abelian.Ext.zero_comp]

theorem wc_pow_aut_kummer_root_fixed : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ε : Spec (.of Ω) ⟶ Spec (.of K)) (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) (M : ℕ), M ≠ 0 → (M : K) ≠ 0 → ∀ (τ : X ⟶ X) (ρ : Spec (.of Ω) ⟶ Spec (.of Ω)), τ ≫ fX = fX ≫ ρ → ρ ≫ ε = ε → ∃ ζ : Ω, IsPrimitiveRoot ζ M ∧ τ.appTop.hom (fX.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom ζ)) = fX.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom ζ) :=
by
  intro K _ _ Ω _ _ ε X fX M hM hMK τ ρ hτ hρ
  obtain ⟨e, rfl⟩ : ∃ e, Spec.map e = ε := ⟨_, Spec.map_preimage ε⟩
  obtain ⟨σ, rfl⟩ : ∃ σ, Spec.map σ = ρ := ⟨_, Spec.map_preimage ρ⟩
  have heσ : e ≫ σ = e := by
    apply Spec.map_injective
    rw [Spec.map_comp, hρ]
  have hfixK : ∀ a : K, σ.hom (e.hom a) = e.hom a := by
    intro a
    have h := congrArg (fun φ => φ.hom a) heσ
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply] using h
  have : NeZero (M : K) := ⟨hMK⟩
  obtain ⟨ζK, hζK⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot K M
  refine ⟨e.hom ζK, hζK.map_of_injective e.hom.injective, ?_⟩
  have hnat : ∀ t : Ω, (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom (σ.hom t) =
      (Spec.map σ).appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom t) := by
    intro t
    have h := congrArg (fun φ => φ.hom t) (Scheme.ΓSpecIso_inv_naturality σ)
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply] using h
  have hcomp : ∀ t, τ.appTop.hom (fX.appTop.hom t) =
      fX.appTop.hom ((Spec.map σ).appTop.hom t) := by
    intro t
    have h := congrArg (fun f : X ⟶ Spec (.of Ω) => f.appTop.hom t) hτ
    simpa only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] using h
  rw [hcomp, ← hnat, hfixK]

theorem wc_et_kummer_ses_explicit : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) (M : ℕ), (M : Ω) ≠ 0 → ∀ ζ : Ω, IsPrimitiveRoot ζ M → ∃ κ : (Functor.const (Scheme.Etale X)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod M))) ⟶ wcEtGmPre X, (∀ (U : X.Etale) (x : ULift.{u+1} (ZMod M)), ((Additive.toMul (κ.app (Opposite.op U) x).down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)) = (U.hom.appTop.hom (fX.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom ζ))) ^ x.down.val) ∧ ∃ h : (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map κ ≫ (M • 𝟙 (wcEtGm X)) = 0, (ShortComplex.mk ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map κ) (M • 𝟙 (wcEtGm X)) h).ShortExact :=
by
  intro Ω _ _ X fX M hMΩ ζ hζ
  classical
  have hM0 : M ≠ 0 := fun h => hMΩ (by rw [h, Nat.cast_zero])

  have hkappa : ∃ κ : (Functor.const (Scheme.Etale X)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod M))) ⟶ wcEtGmPre X, (∀ (U : X.Etale) (x : ULift.{u+1} (ZMod M)), ((Additive.toMul (κ.app (Opposite.op U) x).down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)) = (U.hom.appTop.hom (fX.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom ζ))) ^ x.down.val) ∧ κ ≫ (M • 𝟙 (wcEtGmPre X)) = 0 ∧ Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology X) κ ∧ ∀ (U : Scheme.Etale X) (s : ToType ((wcEtGmPre X).obj (Opposite.op U))), (M • 𝟙 (wcEtGmPre X)).app (Opposite.op U) s = 0 → Presheaf.imageSieve κ s ∈ Scheme.smallEtaleTopology X U := by
    haveI : NeZero M := ⟨hM0⟩
    haveI : NeZero (M : Ω) := ⟨hMΩ⟩

    have s2 : ∀ (O : Type u) [CommRing O] [IsLocalRing O] (φ : Ω →+* O) (v : O),
        v ^ M = 1 → ∃ k : ℕ, v = φ ζ ^ k := by
      intro O _ _ φ v hv
      let π := IsLocalRing.residue O
      have hinj : Function.Injective (π.comp φ) := (π.comp φ).injective
      have hprim : IsPrimitiveRoot ((π.comp φ) ζ) M := hζ.map_of_injective hinj
      have hπv : π v ^ M = 1 := by rw [← map_pow, hv, map_one]
      obtain ⟨i, -, hiv⟩ := hprim.eq_pow_of_pow_eq_one hπv
      refine ⟨i, ?_⟩
      have hw : (φ ζ ^ i) ^ M = 1 := by
        rw [← pow_mul, mul_comm, pow_mul, ← map_pow, hζ.pow_eq_one, map_one, one_pow]
      have hπw : π (φ ζ ^ i) = π v := by rw [map_pow]; exact hiv
      have hS : (∑ j ∈ Finset.range M, v ^ j * (φ ζ ^ i) ^ (M - 1 - j)) * (v - φ ζ ^ i) = 0 := by
        rw [geom_sum₂_mul, hv, hw, sub_self]
      have hSu : IsUnit (∑ j ∈ Finset.range M, v ^ j * (φ ζ ^ i) ^ (M - 1 - j)) := by
        rw [← IsLocalRing.residue_ne_zero_iff_isUnit]
        have e : π (∑ j ∈ Finset.range M, v ^ j * (φ ζ ^ i) ^ (M - 1 - j)) =
            (M : IsLocalRing.ResidueField O) * π v ^ (M - 1) := by
          rw [map_sum, ← geom_sum₂_self]
          refine Finset.sum_congr rfl (fun j _ => ?_)
          rw [map_mul, map_pow, map_pow, hπw]
        rw [e]
        refine mul_ne_zero ?_ (pow_ne_zero _ ?_)
        · have h1 : (M : IsLocalRing.ResidueField O) = (π.comp φ) (M : Ω) := by rw [map_natCast]
          rw [h1]
          exact (map_ne_zero_iff _ hinj).mpr hMΩ
        · intro h0
          rw [h0, zero_pow hM0] at hπv
          exact zero_ne_one hπv
      exact sub_eq_zero.mp (hSu.mul_right_eq_zero.mp hS)

    have s3 : ∀ (Y : Scheme.{u}) (y : Y) (a b : Γ(Y, ⊤)),
        (Y.presheaf.germ ⊤ y trivial).hom a = (Y.presheaf.germ ⊤ y trivial).hom b →
        ∃ W : Y.Opens, y ∈ W ∧ W.ι.appTop.hom a = W.ι.appTop.hom b := by
      intro Y y a b h
      obtain ⟨W, hyW, iU, iV, e⟩ :=
        TopCat.Presheaf.germ_eq (U := ⊤) (V := ⊤) Y.presheaf y trivial trivial a b h
      refine ⟨W, hyW, ?_⟩
      obtain rfl : iV = iU := Subsingleton.elim _ _
      have e' : (Y.presheaf.map iV.op).hom a = (Y.presheaf.map iV.op).hom b := e
      have gen : ∀ (V : Y.Opens) (j : V ⟶ ⊤), V ≤ W →
          (Y.presheaf.map j.op).hom a = (Y.presheaf.map j.op).hom b := by
        intro V j hVW
        obtain rfl : j = homOfLE hVW ≫ iV := Subsingleton.elim _ _
        rw [op_comp, Functor.map_comp, CommRingCat.comp_apply, CommRingCat.comp_apply, e']
      rw [Scheme.Opens.ι_appTop]
      exact gen _ _ (by simp)

    have hcov : ∀ (V : X.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : X.Etale) (c : V₁ ⟶ V),
        S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology X V := by
      intro V S hS
      change S ∈ Scheme.smallGrothendieckTopology @Etale X V
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      obtain ⟨V₁, c, hc, y, hy⟩ := hS x
      have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
      have hEt : Etale c.left := by
        have h1 : Etale V.hom := V.prop
        have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
        exact Etale.of_comp c.left V.hom
      exact ⟨V₁, c, y, hc, hEt, hy⟩
    have hG3 : ∀ (U : X.Etale) (a b : ToType ((wcEtGmPre X).obj (Opposite.op U))),
        ((Additive.toMul a.down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)) =
          ((Additive.toMul b.down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)) → a = b :=
      fun U a b h => ULift.ext _ _ (Additive.toMul.injective (Units.ext h))
    let cX : Ω →+* Γ(X, ⊤) := fX.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom
    let ψ : ∀ U : X.Etale, Ω →+* Γ(U.left, ⊤) := fun U => U.hom.appTop.hom.comp cX
    have hψnat : ∀ (U V : X.Etale) (f : V ⟶ U) (a : Ω), f.left.appTop.hom (ψ U a) = ψ V a := by
      intro U V f a
      have hw : f.left ≫ U.hom = V.hom := MorphismProperty.Over.w f
      simp only [ψ, RingHom.comp_apply]
      rw [← hw, Scheme.Hom.comp_appTop]
      rfl
    have hζmod : ∀ (m : ℕ), ζ ^ m = ζ ^ (m % M) := fun m => by
      conv_lhs => rw [← Nat.div_add_mod m M, pow_add, pow_mul, hζ.pow_eq_one, one_pow, one_mul]
    have hζu : IsUnit ζ := hζ.isUnit hM0
    let zU : ∀ U : X.Etale, (Γ(U.left, ⊤))ˣ := fun U => Units.map (ψ U).toMonoidHom hζu.unit
    have hzU : ∀ U : X.Etale, ((zU U : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)) = ψ U ζ := fun U => by
      simp [zU]
    have hzpow : ∀ (U : X.Etale) (m : ℕ), ((zU U ^ m : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)) = ψ U ζ ^ m :=
      fun U m => by rw [Units.val_pow_eq_pow_val, hzU]
    have hψmod : ∀ (U : X.Etale) (m : ℕ), ψ U ζ ^ m = ψ U ζ ^ (m % M) := fun U m => by
      rw [← map_pow, ← map_pow, ← hζmod]
    have hzmod : ∀ (U : X.Etale) (m : ℕ), zU U ^ m = zU U ^ (m % M) := fun U m => by
      ext
      rw [hzpow, hzpow, ← hψmod]
    let κf : ∀ U : X.Etale, ULift.{u+1} (ZMod M) →+ ULift.{u+1} (Additive (Γ(U.left, ⊤))ˣ) :=
      fun U => AddMonoidHom.mk' (fun x => ULift.up (Additive.ofMul (zU U ^ x.down.val))) (by
        intro a b
        apply ULift.ext
        apply Additive.toMul.injective
        change zU U ^ (a.down + b.down).val = zU U ^ a.down.val * zU U ^ b.down.val
        rw [ZMod.val_add, ← hzmod, pow_add])
    let κ : (Functor.const (Scheme.Etale X)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod M))) ⟶
        wcEtGmPre X :=
      { app := fun U => AddCommGrpCat.ofHom (κf U.unop)
        naturality := by
          intro U V f
          ext x
          apply hG3 V.unop
          change ((zU V.unop ^ x.down.val : (Γ(V.unop.left, ⊤))ˣ) : Γ(V.unop.left, ⊤)) =
            f.unop.left.appTop.hom ((zU U.unop ^ x.down.val : (Γ(U.unop.left, ⊤))ˣ) : Γ(U.unop.left, ⊤))
          rw [hzpow, hzpow, map_pow, hψnat] }
    have hκv : ∀ (U : X.Etale) (x : ULift.{u+1} (ZMod M)),
        ((Additive.toMul (κ.app (Opposite.op U) x).down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)) =
          ψ U ζ ^ x.down.val := fun U x => hzpow U x.down.val
    refine ⟨κ, hκv, ?_, ?_, ?_⟩
    ·
      rw [Preadditive.comp_nsmul, Category.comp_id]
      ext U x
      simp only [NatTrans.app_nsmul, NatTrans.app_zero, AddCommGrpCat.hom_nsmul,
        AddCommGrpCat.hom_zero, AddMonoidHom.nsmul_apply, AddMonoidHom.zero_apply]
      apply ULift.ext
      apply Additive.toMul.injective
      change (zU U.unop ^ x.down.val) ^ M = 1
      rw [← pow_mul, mul_comm, pow_mul, hzmod U.unop M, Nat.mod_self, pow_zero, one_pow]
    ·
      refine ⟨fun {U'} x y hxy => ?_⟩
      obtain ⟨U⟩ := U'
      rcases isEmpty_or_nonempty U.left with hE | ⟨⟨y₀⟩⟩
      · exact hcov _ _ (fun v => isEmptyElim v)
      · haveI : Nontrivial Γ(U.left, ⊤) := @Scheme.component_nontrivial U.left ⊤ ⟨⟨y₀, trivial⟩⟩
        have hinj : Function.Injective (ψ U) := (ψ U).injective
        have hprim := hζ.map_of_injective hinj
        have h1 : ψ U ζ ^ x.down.val = ψ U ζ ^ y.down.val := by
          rw [← hκv U x, ← hκv U y]
          exact congrArg (fun t : ToType ((wcEtGmPre X).obj (Opposite.op U)) =>
            ((Additive.toMul t.down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤))) hxy
        have hval := hprim.pow_inj (ZMod.val_lt _) (ZMod.val_lt _) h1
        have hxy' : x = y := ULift.ext _ _ (ZMod.val_injective _ hval)
        subst hxy'
        rw [Presheaf.equalizerSieve_self_eq_top]
        exact (Scheme.smallEtaleTopology X).top_mem _
    ·
      intro U s hs
      have hs' : M • s = 0 := by
        first
          | exact hs
          | simpa using hs
      have hv : ((Additive.toMul s.down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)) ^ M = 1 :=
        congrArg (fun t : ToType ((wcEtGmPre X).obj (Opposite.op U)) =>
            ((Additive.toMul t.down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤))) hs'
      refine hcov U _ (fun y => ?_)
      obtain ⟨k, hk⟩ := s2 (U.left.presheaf.stalk y)
        ((U.left.presheaf.germ ⊤ y trivial).hom.comp (ψ U))
        ((U.left.presheaf.germ ⊤ y trivial).hom
          ((Additive.toMul s.down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)))
        (by rw [← map_pow, hv, map_one])
      rw [RingHom.comp_apply, ← map_pow] at hk
      obtain ⟨W, hyW, hW⟩ := s3 U.left y _ _ hk
      let V₁ : X.Etale := MorphismProperty.Over.mk ⊤ (W.ι ≫ U.hom) inferInstance
      let c : V₁ ⟶ U := MorphismProperty.Over.homMk W.ι rfl trivial
      refine ⟨V₁, c, ⟨ULift.up (k : ZMod M), ?_⟩, ?_⟩
      · apply hG3 V₁
        rw [hκv]
        change _ = W.ι.appTop.hom ((Additive.toMul s.down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤))
        rw [hW, map_pow, show W.ι.appTop.hom (ψ U ζ) = ψ V₁ ζ from hψnat U V₁ c ζ,
          ZMod.val_natCast]
        exact (hψmod V₁ k).symm
      · exact ⟨⟨y, hyW⟩, rfl⟩

  have hsurjM : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X) (M • 𝟙 (wcEtGmPre X)) := by

    have s2 : ∀ (R : Type u) [CommRing R], IsUnit (M : R) → ∀ a : R, IsUnit a →
        ∃ (B : Type u) (_ : CommRing B) (_ : Algebra R B), Algebra.Etale R B ∧
          Function.Surjective (PrimeSpectrum.comap (algebraMap R B)) ∧
          ∃ t : B, t ^ M = algebraMap R B a := by
      intro R _ hMR a ha
      set f : Polynomial R := Polynomial.X ^ M - Polynomial.C a with hf
      have hfm : f.Monic := Polynomial.monic_X_pow_sub_C a hM0
      obtain ⟨u, hu⟩ := (hMR.mul ha).exists_left_inv
      have hcert : ∃ (p₁ p₂ : Polynomial R) (n : ℕ),
          Polynomial.derivative f * p₁ + f * p₂ = (1 : Polynomial R) ^ n := by
        refine ⟨Polynomial.C u * Polynomial.X, -(Polynomial.C u * Polynomial.C (M : R)), 1, ?_⟩
        have hd : Polynomial.derivative f = Polynomial.C (M : R) * Polynomial.X ^ (M - 1) := by
          rw [hf, Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C,
            sub_zero]
        have hX : Polynomial.X ^ (M - 1) * Polynomial.X = (Polynomial.X : Polynomial R) ^ M :=
          pow_sub_one_mul hM0 Polynomial.X
        have hu' : Polynomial.C u * (Polynomial.C (M : R) * Polynomial.C a) = 1 := by
          rw [← map_mul, ← map_mul, hu, map_one]
        rw [hd, hf, pow_one]
        linear_combination hu' + (Polynomial.C u * Polynomial.C (M : R)) * hX
      let P : StandardEtalePair R := ⟨f, hfm, 1, hcert⟩
      have e₂ : AdjoinRoot f ≃ₐ[R] Localization.Away ((AdjoinRoot.mk f) 1) :=
        (IsLocalization.atUnit (AdjoinRoot f) (Localization.Away ((AdjoinRoot.mk f) 1))
          ((AdjoinRoot.mk f) 1) (by simp)).restrictScalars R
      have e : P.Ring ≃ₐ[R] AdjoinRoot f := P.equivAwayAdjoinRoot.trans e₂.symm
      have het : Algebra.Etale R (AdjoinRoot f) := Algebra.Etale.of_equiv e
      refine ⟨AdjoinRoot f, inferInstance, inferInstance, het, ?_, AdjoinRoot.root f, ?_⟩
      · rcases subsingleton_or_nontrivial R with hR | hR
        · have : IsEmpty (PrimeSpectrum R) := PrimeSpectrum.isEmpty_iff_subsingleton.mpr hR
          intro x
          exact isEmptyElim x
        · have : Module.Free R (AdjoinRoot f) := hfm.free_adjoinRoot
          let pb := AdjoinRoot.powerBasis' hfm
          have hdim : 0 < pb.dim := by
            rw [AdjoinRoot.powerBasis'_dim, hf, Polynomial.natDegree_X_pow_sub_C]
            exact Nat.pos_of_ne_zero hM0
          have : Nontrivial (AdjoinRoot f) := nontrivial_of_ne _ _ (pb.basis.ne_zero ⟨0, hdim⟩)
          exact PrimeSpectrum.comap_surjective_of_faithfullyFlat
      · have h1 : Polynomial.aeval (AdjoinRoot.root f) f = 0 := by
          rw [AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]
        rw [hf, map_sub, Polynomial.aeval_X_pow, Polynomial.aeval_C] at h1
        exact sub_eq_zero.mp h1

    have s3 : ∀ (Y : Scheme.{u}) (B : Type u) [CommRing B] [Algebra Γ(Y, ⊤) B],
        Algebra.Etale Γ(Y, ⊤) B → Function.Surjective (PrimeSpectrum.comap (algebraMap Γ(Y, ⊤) B)) →
        ∃ (V : Scheme.{u}) (p : V ⟶ Y) (ψ : B →+* Γ(V, ⊤)), Etale p ∧ Function.Surjective p ∧
          ∀ r : Γ(Y, ⊤), ψ (algebraMap Γ(Y, ⊤) B r) = p.appTop.hom r := by
      intro Y B _ _ hB hsurj
      let φ : CommRingCat.of Γ(Y, ⊤) ⟶ CommRingCat.of B := CommRingCat.ofHom (algebraMap Γ(Y, ⊤) B)
      let g : Spec (CommRingCat.of B) ⟶ Spec (CommRingCat.of Γ(Y, ⊤)) := Spec.map φ
      have hg : Etale g := by
        apply (HasRingHomProperty.Spec_iff (P := @Etale)).mpr
        rw [CommRingCat.hom_ofHom]
        exact RingHom.etale_algebraMap.mpr hB
      have hgs : Surjective g := by
        constructor
        exact hsurj
      let p := Limits.pullback.fst Y.toSpecΓ g
      let q := Limits.pullback.snd Y.toSpecΓ g
      refine ⟨Limits.pullback Y.toSpecΓ g, p,
        ((Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫ q.appTop).hom,
        inferInstance, p.surjective, fun r => ?_⟩
      have hc : Y.toSpecΓ.appTop ≫ p.appTop = g.appTop ≫ q.appTop := by
        rw [← Scheme.Hom.comp_appTop, ← Scheme.Hom.comp_appTop, Limits.pullback.condition]
      have hn := Scheme.ΓSpecIso_inv_naturality φ
      have key : φ ≫ (Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫ q.appTop = p.appTop := by
        rw [← Category.assoc, hn, Category.assoc, ← hc, Scheme.toSpecΓ_appTop]
        exact Iso.inv_hom_id_assoc _ _
      exact congrArg (fun h => h.hom r) key

    have hcov : ∀ (V : X.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : X.Etale) (c : V₁ ⟶ V),
        S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology X V := by
      intro V S hS
      change S ∈ Scheme.smallGrothendieckTopology @Etale X V
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      obtain ⟨V₁, c, hc, y, hy⟩ := hS x
      have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
      have hEt : Etale c.left := by
        have h1 : Etale V.hom := V.prop
        have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
        exact Etale.of_comp c.left V.hom
      exact ⟨V₁, c, y, hc, hEt, hy⟩
    refine Presheaf.IsLocallySurjective.mk (fun {U} s => ?_)
    let aU : (Γ(U.left, ⊤))ˣ := Additive.toMul s.down
    let cU : Ω →+* Γ(U.left, ⊤) :=
      ((U.hom ≫ fX).appTop).hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom
    have hMR : IsUnit (M : Γ(U.left, ⊤)) := by
      rw [← map_natCast cU]
      exact (Ne.isUnit hMΩ).map cU
    obtain ⟨B, _, _, hBet, hBsurj, t, ht⟩ := s2 Γ(U.left, ⊤) hMR (aU : Γ(U.left, ⊤)) aU.isUnit
    obtain ⟨V, p, ψ, hpet, hpsurj, hψ⟩ := s3 U.left B hBet hBsurj
    have hT : ψ t ^ M = p.appTop.hom (aU : Γ(U.left, ⊤)) := by rw [← map_pow, ht, hψ]
    have hTu : IsUnit (ψ t) := by
      have h1 : IsUnit (ψ t ^ M) := by rw [hT]; exact aU.isUnit.map _
      exact (isUnit_pow_iff hM0).mp h1
    haveI := hpet
    let V₁ : X.Etale := MorphismProperty.Over.mk ⊤ (p ≫ U.hom) inferInstance
    let c : V₁ ⟶ U := MorphismProperty.Over.homMk p rfl trivial
    have hc : (Presheaf.imageSieve (M • 𝟙 (wcEtGmPre X)) s).arrows c := by
      refine ⟨ULift.up (Additive.ofMul hTu.unit), ?_⟩
      simp only [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.hom_nsmul,
        AddMonoidHom.nsmul_apply, AddCommGrpCat.hom_id, AddMonoidHom.id_apply]
      apply ULift.ext
      apply Additive.toMul.injective
      apply Units.ext
      change ((hTu.unit ^ M : (Γ(V, ⊤))ˣ) : Γ(V, ⊤)) = p.appTop.hom (aU : Γ(U.left, ⊤))
      rw [Units.val_pow_eq_pow_val, IsUnit.unit_spec, hT]
    exact hcov U _ (fun v => ⟨V₁, c, hc, hpsurj v⟩)

  have hA : ∀ (P₁ P₂ P₃ : (Scheme.Etale X)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (f : P₁ ⟶ P₂) (g : P₂ ⟶ P₃),
      f ≫ g = 0 → Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology X) f →
      (∀ (U : Scheme.Etale X) (s : ToType (P₂.obj (Opposite.op U))),
        g.app (Opposite.op U) s = 0 → Presheaf.imageSieve f s ∈ Scheme.smallEtaleTopology X U) →
      Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X) g →
      ∀ (g' : (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj P₂ ⟶
          (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj P₃),
        (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map g = g' →
        ∃ h : (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f ≫ g' = 0,
          (ShortComplex.mk ((presheafToSheaf (Scheme.smallEtaleTopology X)
            AddCommGrpCat.{u+1}).map f) g' h).ShortExact := by
    intro P₁ P₂ P₃ f g hfg hinj hex hsurj g' hg'
    subst hg'
    have h : (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f ≫
        (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map g = 0 := by
      rw [← Functor.map_comp, hfg, Functor.map_zero]
    refine ⟨h, ?_⟩
    have hmono : Mono ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f) := by
      haveI : Sheaf.IsLocallyInjective
          ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f) :=
        (Presheaf.isLocallyInjective_presheafToSheaf_map_iff _ f).mpr hinj
      exact Sheaf.mono_of_isLocallyInjective _
    have hepi : Epi ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map g) := by
      rw [← Sheaf.isLocallySurjective_iff_epi']
      exact (Presheaf.isLocallySurjective_presheafToSheaf_map_iff _ g).mpr hsurj
    refine ShortComplex.ShortExact.mk' ?_ hmono hepi
    rw [ShortComplex.exact_iff_epi_kernel_lift]
    have hk : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X)
        (Limits.kernel.lift g f hfg) := by
      refine Presheaf.IsLocallySurjective.mk (fun {U} s => ?_)
      have ht : g.app (Opposite.op U) ((Limits.kernel.ι g).app (Opposite.op U) s) = 0 := by
        rw [← ConcreteCategory.comp_apply, ← NatTrans.comp_app, Limits.kernel.condition]
        rfl
      refine GrothendieckTopology.superset_covering _ ?_ (hex U _ ht)
      intro V φ hφ
      obtain ⟨r, hr⟩ := hφ
      refine ⟨r, ?_⟩
      have hm : Mono ((Limits.kernel.ι g).app (Opposite.op V)) :=
        (NatTrans.mono_iff_mono_app _).mp inferInstance _
      apply (AddCommGrpCat.mono_iff_injective _).mp hm
      rw [← ConcreteCategory.comp_apply, ← NatTrans.comp_app, Limits.kernel.lift_ι, hr,
        ← ConcreteCategory.comp_apply, ← ConcreteCategory.comp_apply, NatTrans.naturality]
    have hkF : Epi ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
        (Limits.kernel.lift g f hfg)) := by
      rw [← Sheaf.isLocallySurjective_iff_epi']
      exact (Presheaf.isLocallySurjective_presheafToSheaf_map_iff _ _).mpr hk
    have heq : Limits.kernel.lift
        ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map g)
        ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f) h =
        (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
          (Limits.kernel.lift g f hfg) ≫
        (Limits.PreservesKernel.iso
          (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) g).hom := by
      rw [Limits.PreservesKernel.iso_hom, Limits.map_lift_kernelComparison]
    change Epi (Limits.kernel.lift
        ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map g)
        ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f) h)
    rw [heq]
    exact epi_comp _ _

  have hmap : (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
      (M • 𝟙 (wcEtGmPre X)) = M • 𝟙 (wcEtGm X) := by
    rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
    rfl

  obtain ⟨κ, hκf, h0, hinj, hex⟩ := hkappa
  obtain ⟨h, hS⟩ := hA _ _ _ κ (M • 𝟙 (wcEtGmPre X)) h0 hinj hex
    hsurjM (M • 𝟙 (wcEtGm X)) hmap
  exact ⟨κ, hκf, h, hS⟩

theorem wc_et_push_iso_exact_can : ∀ {X Y : Scheme.{u}} (g : Y ⟶ X) [IsIso g], (wcEtPush g).Additive ∧ Limits.PreservesFiniteLimits (wcEtPush g) ∧ Limits.PreservesFiniteColimits (wcEtPush g) ∧ (∀ A : AddCommGrpCat.{u+1}, IsIso (wcEtCanConst g A)) ∧ IsIso (wcEtCanGm g) :=
by
  intro X Y g _
  have hSurj : ∀ (Z : Scheme.{u}) (V : Z.Etale) (R : Sieve V), R ∈ Scheme.smallEtaleTopology Z V →
      ∀ y : V.left, ∃ (V₁ : Z.Etale) (c : V₁ ⟶ V) (w : V₁.left), R.arrows c ∧ c.left w = y := by
    intro Z V R hR y
    change R ∈ Scheme.smallGrothendieckTopology @Etale Z V at hR
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Z
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
    obtain ⟨V₁, c, w, hc, -, hw⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Z
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V R).mp hR y
    exact ⟨V₁, c, w, hc, hw⟩
  have hjs : ∀ (Z : Scheme.{u}) (V : Z.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Z.Etale)
      (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Z V := by
    intro Z V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale Z V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Z
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Z
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩
  have hpush : ∀ {X Y Z : Scheme.{u}} (a : X ⟶ Y) (b : Y ⟶ Z),
      Nonempty (wcEtPush (𝟙 X) ≅ 𝟭 (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})) ∧
      Nonempty (wcEtPush a ⋙ wcEtPush b ≅ wcEtPush (a ≫ b)) := by
    have hcov : ∀ {X B : Scheme.{u}} (g : X ⟶ B), CoverPreserving (Scheme.smallEtaleTopology B)
        (Scheme.smallEtaleTopology X) (wcEtBaseChange g) := by
      intro X B g
      constructor
      intro V S hS
      change S ∈ Scheme.smallGrothendieckTopology @Etale B V at hS
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
      have hS' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS
      apply hjs
      intro v
      obtain ⟨W, a, w, ha, -, hw⟩ := hS' (Limits.pullback.fst V.hom g v)
      refine ⟨(wcEtBaseChange g).obj W, (wcEtBaseChange g).map a,
        Sieve.image_mem_functorPushforward (wcEtBaseChange g) S ha, ?_⟩
      have h0 : (Limits.pullback.fst W.hom g ≫ a.left) ≫ V.hom =
          Limits.pullback.snd W.hom g ≫ g := by
        rw [Category.assoc, MorphismProperty.Over.w a]
        exact Limits.pullback.condition
      let m : Limits.pullback W.hom g ⟶ Limits.pullback V.hom g :=
        Limits.pullback.lift (Limits.pullback.fst W.hom g ≫ a.left) (Limits.pullback.snd W.hom g) h0
      have hmap : ((wcEtBaseChange g).map a).left = m := rfl
      have h1 : Limits.pullback.fst a.left (Limits.pullback.fst V.hom g) ≫ W.hom =
          (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫
            Limits.pullback.snd V.hom g) ≫ g := by
        rw [← MorphismProperty.Over.w a, ← Category.assoc, Limits.pullback.condition,
          Category.assoc, Limits.pullback.condition, Category.assoc]
      let ψ : Limits.pullback a.left (Limits.pullback.fst V.hom g) ⟶ Limits.pullback W.hom g :=
        Limits.pullback.lift (Limits.pullback.fst a.left (Limits.pullback.fst V.hom g))
          (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫
            Limits.pullback.snd V.hom g) h1
      have hψ : ψ ≫ m = Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) := by
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc,
            Limits.pullback.lift_fst, Limits.pullback.condition]
        · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
      obtain ⟨z, hz⟩ : ∃ z, Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) z = v := by
        have hv : (v : ↥(Limits.pullback V.hom g)) ∈
            Set.range (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g)) := by
          rw [Scheme.Pullback.range_snd]
          exact ⟨w, hw⟩
        exact hv
      rw [hmap]
      exact ⟨ψ z, (Scheme.Hom.comp_apply ψ m z).symm.trans (by rw [hψ]; exact hz)⟩
    have hcont : ∀ {X B : Scheme.{u}} (g : X ⟶ B), (wcEtBaseChange g).IsContinuous
        (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology X) := by
      intro X B g
      haveI h1 : Limits.PreservesFiniteLimits (wcEtBaseChange g) := ⟨fun J _ _ =>
        haveI : Limits.PreservesLimitsOfShape J (wcEtBaseChange g ⋙ Scheme.Etale.forget X) :=
          Limits.preservesLimitsOfShape_of_natIso
            (NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl) :
              Scheme.Etale.forget B ⋙ Over.pullback g ≅ wcEtBaseChange g ⋙ Scheme.Etale.forget X)
        Limits.preservesLimitsOfShape_of_reflects_of_preserves (wcEtBaseChange g)
          (Scheme.Etale.forget X)⟩
      haveI := flat_of_preservesFiniteLimits (wcEtBaseChange g)
      exact Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat _ _) (hcov g)
    have he : ∀ {X B : Scheme.{u}} (g : X ⟶ B) [(wcEtBaseChange g).IsContinuous
        (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology X)],
        Nonempty (wcEtPush g ≅ (wcEtBaseChange g).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology X)) := by
      intro X B g _
      exact ⟨Functor.isoWhiskerRight
          ((wcEtBaseChange g).sheafPushforwardContinuousCompSheafToPresheafIso
          AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology X)).symm
          (presheafToSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) ≪≫
        Functor.associator _ _ _ ≪≫
        Functor.isoWhiskerLeft _ (asIso (sheafificationAdjunction (Scheme.smallEtaleTopology B)
          AddCommGrpCat.{u+1}).counit) ≪≫
        Functor.rightUnitor _⟩
    have hι : ∀ (X : Scheme.{u}), Nonempty (wcEtBaseChange (𝟙 X) ≅ 𝟭 X.Etale) := by
      intro X
      let hiso : ∀ V : X.Etale, Limits.pullback V.hom (𝟙 X) ≅ V.left := fun V =>
        { hom := Limits.pullback.fst V.hom (𝟙 X)
          inv := Limits.pullback.lift (𝟙 V.left) V.hom
            ((Category.id_comp V.hom).trans (Category.comp_id V.hom).symm)
          hom_inv_id := by
            apply Limits.pullback.hom_ext
            · rw [Category.assoc, Limits.pullback.lift_fst, Category.comp_id, Category.id_comp]
            · rw [Category.assoc, Limits.pullback.lift_snd, Category.id_comp,
                Limits.pullback.condition, Category.comp_id]
          inv_hom_id := Limits.pullback.lift_fst _ _ _ }
      refine ⟨NatIso.ofComponents (fun V => MorphismProperty.Over.isoMk (hiso V) ?_) ?_⟩
      · change Limits.pullback.fst V.hom (𝟙 X) ≫ V.hom = Limits.pullback.snd V.hom (𝟙 X)
        rw [Limits.pullback.condition, Category.comp_id]
      · intro V W f
        apply MorphismProperty.Over.Hom.ext
        change Limits.pullback.lift (Limits.pullback.fst V.hom (𝟙 X) ≫ f.left)
          (Limits.pullback.snd V.hom (𝟙 X)) _ ≫ Limits.pullback.fst W.hom (𝟙 X) =
          Limits.pullback.fst V.hom (𝟙 X) ≫ f.left
        exact Limits.pullback.lift_fst _ _ _
    have hκ : ∀ {X Y Z : Scheme.{u}} (a : X ⟶ Y) (b : Y ⟶ Z),
        Nonempty (wcEtBaseChange (a ≫ b) ≅ wcEtBaseChange b ⋙ wcEtBaseChange a) := by
      intro X Y Z a b
      letI : ∀ {A B : Scheme.{u}} (f : A ⟶ B),
          MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) f :=
        fun _ => ⟨fun _ _ => inferInstance⟩
      letI : ∀ {A B : Scheme.{u}} (f : A ⟶ B),
          MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) f :=
        fun f => (fun (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange] =>
          (inferInstance : P.IsStableUnderBaseChangeAlong f)) (@Etale : MorphismProperty Scheme.{u})
      exact ⟨MorphismProperty.Over.pullbackComp (P := (@Etale : MorphismProperty Scheme.{u}))
        (Q := ⊤) a b⟩
    intro X Y Z a b
    haveI := hcont (𝟙 X)
    haveI := hcont a
    haveI := hcont b
    haveI := hcont (a ≫ b)
    obtain ⟨e1⟩ := he (𝟙 X)
    obtain ⟨ι⟩ := hι X
    obtain ⟨ea⟩ := he a
    obtain ⟨eb⟩ := he b
    obtain ⟨eab⟩ := he (a ≫ b)
    obtain ⟨κ⟩ := hκ a b
    haveI : (wcEtBaseChange b ⋙ wcEtBaseChange a).IsContinuous (Scheme.smallEtaleTopology Z)
        (Scheme.smallEtaleTopology X) :=
      Functor.isContinuous_comp (wcEtBaseChange b) (wcEtBaseChange a) (Scheme.smallEtaleTopology Z)
        (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology X)
    refine ⟨⟨e1 ≪≫ Functor.sheafPushforwardContinuousIso ι AddCommGrpCat.{u+1} _ _ ≪≫
      Functor.sheafPushforwardContinuousId AddCommGrpCat.{u+1} _⟩, ⟨?_⟩⟩
    exact Functor.isoWhiskerRight ea (wcEtPush b) ≪≫ Functor.isoWhiskerLeft _ eb ≪≫
      Functor.sheafPushforwardContinuousComp (wcEtBaseChange b) (wcEtBaseChange a)
        AddCommGrpCat.{u+1} _ _ _ ≪≫
      Functor.sheafPushforwardContinuousIso κ.symm AddCommGrpCat.{u+1} _ _ ≪≫ eab.symm
  obtain ⟨⟨iY⟩, ⟨e₁⟩⟩ := hpush g (inv g)
  obtain ⟨⟨iX⟩, ⟨e₂⟩⟩ := hpush (inv g) g
  have h₁ : g ≫ inv g = 𝟙 Y := IsIso.hom_inv_id g
  have h₂ : inv g ≫ g = 𝟙 X := IsIso.inv_hom_id g
  haveI hEq : (wcEtPush g).IsEquivalence :=
    Functor.IsEquivalence.mk' (wcEtPush (inv g))
      (e₁ ≪≫ eqToIso (congrArg (fun h => wcEtPush h) h₁) ≪≫ iY).symm
      (e₂ ≪≫ eqToIso (congrArg (fun h => wcEtPush h) h₂) ≪≫ iX)
  haveI hcoc : (wcEtBaseChange g).IsCocontinuous (Scheme.smallEtaleTopology X)
      (Scheme.smallEtaleTopology Y) := by
    constructor
    intro U S hS
    apply hjs
    intro u
    obtain ⟨W, f, w, hf, hw⟩ := hSurj Y _ S hS (inv (Limits.pullback.fst U.hom g) u)
    have hfw : f.left ≫ Limits.pullback.snd U.hom g = W.hom := MorphismProperty.Over.w f
    haveI hWet : Etale W.hom := W.prop
    let V : X.Etale := MorphismProperty.Over.mk ⊤ (W.hom ≫ g) inferInstance
    have hcw : (f.left ≫ Limits.pullback.fst U.hom g) ≫ U.hom = V.hom :=
      (Category.assoc _ _ _).trans
        ((congrArg (fun k => f.left ≫ k) Limits.pullback.condition).trans
          ((Category.assoc _ _ _).symm.trans (congrArg (fun k => k ≫ g) hfw)))
    let c : V ⟶ U := MorphismProperty.Over.homMk (f.left ≫ Limits.pullback.fst U.hom g) hcw trivial
    have hφw : Limits.pullback.fst V.hom g ≫ W.hom = Limits.pullback.snd V.hom g :=
      (cancel_mono g).mp ((Category.assoc _ _ _).trans Limits.pullback.condition)
    let φ : (wcEtBaseChange g).obj V ⟶ W :=
      MorphismProperty.Over.homMk (Limits.pullback.fst V.hom g) hφw trivial
    have h0 : (Limits.pullback.fst V.hom g ≫ c.left) ≫ U.hom = Limits.pullback.snd V.hom g ≫ g :=
      (Category.assoc _ _ _).trans
        ((congrArg (fun k => Limits.pullback.fst V.hom g ≫ k) (MorphismProperty.Over.w c)).trans
          Limits.pullback.condition)
    let m : Limits.pullback V.hom g ⟶ Limits.pullback U.hom g :=
      Limits.pullback.lift (Limits.pullback.fst V.hom g ≫ c.left) (Limits.pullback.snd V.hom g) h0
    have hm : ((wcEtBaseChange g).map c).left = m := rfl
    have hm' : m = Limits.pullback.fst V.hom g ≫ f.left := by
      apply Limits.pullback.hom_ext
      · exact (Limits.pullback.lift_fst _ _ _).trans (Category.assoc _ _ _).symm
      · exact (Limits.pullback.lift_snd _ _ _).trans (hφw.symm.trans
          ((congrArg (fun k => Limits.pullback.fst V.hom g ≫ k) hfw).symm.trans
            (Category.assoc _ _ _).symm))
    have hmap : (wcEtBaseChange g).map c = φ ≫ f :=
      MorphismProperty.Over.Hom.ext (hm.trans hm')
    refine ⟨V, c, ?_, w, ?_⟩
    · show S.arrows ((wcEtBaseChange g).map c)
      rw [hmap]
      exact S.downward_closed hf φ
    · show (f.left ≫ Limits.pullback.fst U.hom g) w = u
      have hu : (inv (Limits.pullback.fst U.hom g) ≫ Limits.pullback.fst U.hom g) u = u := by
        first
          | exact (congrArg (fun h : U.left ⟶ U.left => h u) (IsIso.inv_hom_id _)).trans rfl
          | simp
          | (rw [IsIso.inv_hom_id]; rfl)
      exact (Scheme.Hom.comp_apply _ _ w).trans
        ((congrArg (fun z => (Limits.pullback.fst U.hom g) z) hw).trans
          ((Scheme.Hom.comp_apply _ _ u).symm.trans hu))
  have hW : ∀ (P : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}),
      IsIso ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
        (Functor.whiskerLeft (wcEtBaseChange g).op (toSheafify (Scheme.smallEtaleTopology Y) P))) := by
    intro P
    haveI := Presheaf.isLocallyInjective_toSheafify' (Scheme.smallEtaleTopology Y) P
    haveI := Presheaf.isLocallySurjective_toSheafify' (Scheme.smallEtaleTopology Y) P
    haveI := Presheaf.isLocallyInjective_whisker (Scheme.smallEtaleTopology X)
      (Scheme.smallEtaleTopology Y) (wcEtBaseChange g) (toSheafify (Scheme.smallEtaleTopology Y) P)
    haveI := Presheaf.isLocallySurjective_whisker (Scheme.smallEtaleTopology X)
      (Scheme.smallEtaleTopology Y) (wcEtBaseChange g) (toSheafify (Scheme.smallEtaleTopology Y) P)
    exact (GrothendieckTopology.W_iff (Scheme.smallEtaleTopology X) _).mp
      (GrothendieckTopology.W_of_isLocallyBijective (Scheme.smallEtaleTopology X)
        (Functor.whiskerLeft (wcEtBaseChange g).op (toSheafify (Scheme.smallEtaleTopology Y) P)))
  have gen : ∀ {P Q R : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (a : P ⟶ Q) (b : Q ⟶ R), IsIso a →
      IsIso ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map b) →
      IsIso ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map (a ≫ b)) := by
    intro P Q R a b ha hb
    rw [Functor.map_comp]
    haveI := Functor.map_isIso (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) a
    exact IsIso.comp_isIso
  have hConst : ∀ A : AddCommGrpCat.{u+1}, IsIso (wcEtCanConst g A) := by
    intro A
    let γ : (Functor.const (X.Etale)ᵒᵖ).obj A ⟶
        (wcEtBaseChange g).op ⋙ (Functor.const (Y.Etale)ᵒᵖ).obj A :=
      { app := fun _ => 𝟙 A, naturality := fun _ _ _ => rfl }
    have hγ : IsIso γ := by
      haveI : ∀ V, IsIso (γ.app V) := fun V => (inferInstance : IsIso (𝟙 A))
      exact NatIso.isIso_of_isIso_app γ
    exact gen γ _ hγ (hW _)
  have hGm : IsIso (wcEtCanGm g) := by
    have hα : IsIso (Functor.whiskerRight (NatTrans.op (wcEtBaseChangeFst g))
        (Scheme.Γ ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙
          CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u})) := by
      haveI : ∀ V, IsIso ((Functor.whiskerRight (NatTrans.op (wcEtBaseChangeFst g))
          (Scheme.Γ ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙
            CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u})).app V) := by
        intro V
        haveI : IsIso (Limits.pullback.fst V.unop.hom g) := inferInstance
        exact Functor.map_isIso (Scheme.Γ ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙
          CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u})
          (Limits.pullback.fst V.unop.hom g).op
      exact NatIso.isIso_of_isIso_app _
    exact gen (P := wcEtGmPre X) _ _ hα (hW _)
  exact ⟨inferInstance, inferInstance, inferInstance, hConst, hGm⟩

theorem wc_pow_aut_pull_ext_bridge : ∀ (X : Scheme.{u}) [IrreducibleSpace X] (M : ℕ), M ≠ 0 → ∀ (σ : X ⟶ X) [IsIso σ] [(wcEtPush (inv σ)).Additive] [Limits.PreservesFiniteLimits (wcEtPush (inv σ))] [Limits.PreservesFiniteColimits (wcEtPush (inv σ))] [IsIso (wcEtCanConst (inv σ) (AddCommGrpCat.of (ULift.{u+1} (ZMod M))))] (D : wcEtPullData σ M) (n : ℕ), letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _; ∃ B : wcEtZModExt X M n → Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod M)))) n, Function.Bijective B ∧ ∀ x, B (wcEtPull D n x) = wcExtTwist (wcEtPush (inv σ)) (wcEtCanConst (inv σ) (AddCommGrpCat.of (ULift.{u+1} ℤ))) (wcEtCanConst (inv σ) (AddCommGrpCat.of (ULift.{u+1} (ZMod M)))) n (B x) :=
by
  intro X _ M hM σ _ hFA hFL hFC hcanμ D n
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
  classical

  have hindep : ∀ (D' : wcEtPullData σ M) (x : wcEtZModExt X M n),
      wcEtPull D' n x = wcEtPull D n x := by
    intro D' x
    have Did : wcEtPullData (𝟙 X) M := (wc_et_zmod_pull_data_exists (𝟙 X) M).some
    have hP : ∀ y : wcEtZModExt X M n, wcEtPull Did n y = y := by
      intro y
      have hidem : wcEtPull Did n y = wcEtPull Did n (wcEtPull Did n y) :=
        wc_et_pull_comp (𝟙 X) (𝟙 X) (𝟙 X) (Category.id_comp _) Did Did Did n y
      have h0 : wcEtPull Did n (wcEtPull Did n y - y) = 0 := by
        rw [map_sub, ← hidem, sub_self]
      exact sub_eq_zero.mp (wc_et_pull_id_injective Did n _ h0)
    rw [wc_et_pull_comp σ (𝟙 X) σ (Category.id_comp σ) D Did D' n x, hP]

  have s4 : ∀ (F' G' : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⥤
        Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
      [F'.Additive] [Limits.PreservesFiniteLimits F'] [Limits.PreservesFiniteColimits F']
      [G'.Additive] [Limits.PreservesFiniteLimits G'] [Limits.PreservesFiniteColimits G']
      (θ' : G' ≅ F') {P Y : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}}
      (cP : P ⟶ G'.obj P) (cY : Y ⟶ G'.obj Y) (kP : P ⟶ F'.obj P) (kY : Y ⟶ F'.obj Y)
      [IsIso cY] [IsIso kY], cP ≫ θ'.hom.app P = kP → cY ≫ θ'.hom.app Y = kY →
      ∀ h : Abelian.Ext P Y n, wcExtTwist F' kP kY n h = wcExtTwist G' cP cY n h := by
    intro F' G' _ _ _ _ _ _ θ' P Y cP cY kP kY _ _ hPk hYk h
    have h2 : ∀ {A B C' E : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}}
        (f : A ⟶ B) (g : B ⟶ C') (z : Abelian.Ext C' E n),
        (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ g).comp z (zero_add n)) (zero_add n) =
          (Abelian.Ext.mk₀ (f ≫ g)).comp z (zero_add n) := by
      intro A B C' E f g z
      rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
    have h3 : ∀ {A B C' E : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}}
        (z : Abelian.Ext A B n) (f : B ⟶ C') (g : C' ⟶ E),
        (z.comp (Abelian.Ext.mk₀ f) (add_zero n)).comp (Abelian.Ext.mk₀ g) (add_zero n) =
          z.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero n) := by
      intro A B C' E z f g
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
    have h4 : ∀ {A B C' E : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}}
        (f : A ⟶ B) (z : Abelian.Ext B C' n) (g : C' ⟶ E),
        ((Abelian.Ext.mk₀ f).comp z (zero_add n)).comp (Abelian.Ext.mk₀ g) (add_zero n) =
          (Abelian.Ext.mk₀ f).comp (z.comp (Abelian.Ext.mk₀ g) (add_zero n)) (zero_add n) := by
      intro A B C' E f z g
      exact Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _
    have hinv : θ'.hom.app Y ≫ inv kY = inv cY := by
      apply IsIso.eq_inv_of_hom_inv_id
      rw [← Category.assoc, hYk, IsIso.hom_inv_id]
    have hN : (Abelian.Ext.mapExactFunctor G' h).comp (Abelian.Ext.mk₀ (θ'.hom.app Y))
        (add_zero n) =
        (Abelian.Ext.mk₀ (θ'.hom.app P)).comp (Abelian.Ext.mapExactFunctor F' h) (zero_add n) :=
      Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp h θ'.hom
    show (Abelian.Ext.mk₀ kP).comp ((Abelian.Ext.mapExactFunctor F' h).comp
        (Abelian.Ext.mk₀ (inv kY)) (add_zero n)) (zero_add n) =
      (Abelian.Ext.mk₀ cP).comp ((Abelian.Ext.mapExactFunctor G' h).comp
        (Abelian.Ext.mk₀ (inv cY)) (add_zero n)) (zero_add n)
    rw [← hPk, ← h2]
    refine congrArg (fun z => (Abelian.Ext.mk₀ cP).comp z (zero_add n)) ?_
    rw [← h4, ← hN, h3, hinv]

  obtain ⟨hcont, -⟩ := wc_et_slice_continuous (Scheme.Etale.mk σ)
  haveI := hcont

  have hs3 : ∃ θ : (wcEtSlice (Scheme.Etale.mk σ)).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology (Scheme.Etale.mk σ).left) (Scheme.smallEtaleTopology X) ≅
        wcEtPush (X := X) (B := X) (inv σ),
      ∀ A : AddCommGrpCat.{u+1}, wcR2gsConstRes (Scheme.Etale.mk σ) A ≫
        θ.hom.app ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj A) =
        wcEtCanConst (inv σ) A := by

    have gen1 : ∀ {P P' Q Q' : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (a : P ⟶ P') (w : P ⟶ Q)
        (w' : P' ⟶ Q') (b : Q ⟶ Q'), a ≫ w' = w ≫ b →
        a ≫ toSheafify (Scheme.smallEtaleTopology X) P' ≫
            sheafifyMap (Scheme.smallEtaleTopology X) w' =
