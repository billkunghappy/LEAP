      (w : W ⟶ Spec (.of Ω)) [IsProper w] [IrreducibleSpace W],
      topologicalKrullDim W = (n : WithBot ℕ∞) → ∀ (ℓ : ℕ), ℓ.Prime → (ℓ : Ω) ≠ 0 →
