      rw [← Category.assoc, Limits.pullback.condition, Category.assoc, IsIso.inv_hom_id,
        Category.comp_id]
    let βc : ∀ V : X.Etale,
        (wcEtBaseChange (inv σ)).obj V ≅ (wcEtSlice (Scheme.Etale.mk σ)).obj V := fun V =>
      MorphismProperty.Over.isoMk
        (@asIso _ _ _ _ (Limits.pullback.fst V.hom (inv σ))
          (Limits.pullback_fst_iso_of_right_iso V.hom (inv σ))) (hw V)
    let β : wcEtBaseChange (inv σ) ≅ wcEtSlice (Scheme.Etale.mk σ) :=
      NatIso.ofComponents βc (fun {V V'} u => by
        apply MorphismProperty.Over.Hom.ext
        show ((wcEtBaseChange (inv σ)).map u).left ≫ Limits.pullback.fst V'.hom (inv σ) =
          Limits.pullback.fst V.hom (inv σ) ≫ u.left
        exact (wcEtBaseChangeFst (inv σ)).naturality u)
    let θc : ∀ S : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1},
        ((wcEtSlice (Scheme.Etale.mk σ)).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.smallEtaleTopology (Scheme.Etale.mk σ).left) (Scheme.smallEtaleTopology X)).obj S ≅
        (wcEtPush (X := X) (B := X) (inv σ)).obj S := fun S =>
      sheafificationIso (J := Scheme.smallEtaleTopology X)
          (((wcEtSlice (Scheme.Etale.mk σ)).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.smallEtaleTopology (Scheme.Etale.mk σ).left) (Scheme.smallEtaleTopology X)).obj S) ≪≫
        (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).mapIso
          (Functor.isoWhiskerRight (NatIso.op β) S.obj)
    have hθc : ∀ S : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}, (θc S).hom.hom =
        toSheafify (Scheme.smallEtaleTopology X) ((wcEtSlice (Scheme.Etale.mk σ)).op ⋙ S.obj) ≫
          sheafifyMap (Scheme.smallEtaleTopology X)
            (Functor.whiskerRight (NatTrans.op β.hom) S.obj) := by
      intro S
      have e1 := sheafificationIso_hom_hom (J := Scheme.smallEtaleTopology X)
        (((wcEtSlice (Scheme.Etale.mk σ)).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.smallEtaleTopology (Scheme.Etale.mk σ).left) (Scheme.smallEtaleTopology X)).obj S)
      rw [isoSheafify_hom] at e1
      exact congrArg (fun t => t ≫ sheafifyMap (Scheme.smallEtaleTopology X)
        (Functor.whiskerRight (NatTrans.op β.hom) S.obj)) e1
    refine ⟨NatIso.ofComponents θc (fun {S S'} f => ?_), fun A => ?_⟩
    · apply Sheaf.hom_ext
      refine (congrArg (fun t => Functor.whiskerLeft (wcEtSlice (Scheme.Etale.mk σ)).op f.hom ≫ t)
        (hθc S')).trans ((gen1 _ _ _ _ ?_).trans
          (congrArg (fun t => t ≫ sheafifyMap (Scheme.smallEtaleTopology X)
            (Functor.whiskerLeft (wcEtBaseChange (inv σ)).op f.hom)) (hθc S)).symm)
      exact NatTrans.ext (funext fun V => (f.hom.naturality (β.hom.app V.unop).op).symm)
    · apply Sheaf.hom_ext
      refine sheafify_hom_ext (Scheme.smallEtaleTopology X)
        (P := (Functor.const (X.Etale)ᵒᵖ).obj A) _ _
        ((wcEtPush (X := X) (B := X) (inv σ)).obj
          ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj A)).property ?_
      have L1 : toSheafify (Scheme.smallEtaleTopology X) ((Functor.const (X.Etale)ᵒᵖ).obj A) ≫
          (wcR2gsConstRes (Scheme.Etale.mk σ) A).hom =
          Functor.whiskerLeft (wcEtSlice (Scheme.Etale.mk σ)).op
            (toSheafify (Scheme.smallEtaleTopology X) ((Functor.const (X.Etale)ᵒᵖ).obj A)) :=
        toSheafify_sheafifyLift _ _ _
      have key : Functor.whiskerLeft (wcEtSlice (Scheme.Etale.mk σ)).op
            (toSheafify (Scheme.smallEtaleTopology X) ((Functor.const (X.Etale)ᵒᵖ).obj A)) ≫
