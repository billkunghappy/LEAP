            Abelian.Ext.covariant_sequence_exact₁ P hFS z' h0 (n₀ := n) rfl
          obtain ⟨w, hw⟩ := (ih S.X₃).2 w'
          refine ⟨w.comp hS'.extClass rfl, ?_⟩
          change Ψ S.X₁ (n + 1) (w.comp hS'.extClass rfl) = z'
          rw [bridge]
          change Ψ S.X₃ n w = w' at hw
          rw [hw, hw']
    exact fun Y n => key n Y

  haveI := hPL
  haveI := hPC
  haveI := hFull
  haveI := hFaith
  have hvan := c5 (SheafOfModules.restrictScalars.{u+1} φ)
    (SheafOfModules.unit (wcIntSliceRing F X h ℓ)) (ℓ ^ m) hmono hdiv hkill hess
  have hβ := c1 (SheafOfModules.restrictScalars.{u+1} φ)
    (SheafOfModules.unit (wcZModSliceRing F X h (ℓ ^ m)))
    (SheafOfModules.unit (wcIntSliceRing F X h ℓ)) q hcorep hvan
  let θ : wcTorMod F X h ℓ m ≅
      (SheafOfModules.restrictScalars.{u+1} φ).obj (SheafOfModules.unit (wcZModSliceRing F X h (ℓ ^ m))) :=
    (Limits.cokernelIsCokernel ((ℓ ^ m : ℕ) • 𝟙 (SheafOfModules.unit (wcIntSliceRing F X h ℓ)))).coconePointUniqueUpToIso
      hcolim
  have hπθ : Limits.cokernel.π ((ℓ ^ m : ℕ) • 𝟙 (SheafOfModules.unit (wcIntSliceRing F X h ℓ))) ≫
      θ.hom = q :=
    Limits.IsColimit.comp_coconePointUniqueUpToIso_hom
      (Limits.cokernelIsCokernel ((ℓ ^ m : ℕ) • 𝟙 (SheafOfModules.unit (wcIntSliceRing F X h ℓ))))
      hcolim Limits.WalkingParallelPair.one
  let Φp : ∀ n : ℕ, wcZModSliceCoh F X h (ℓ ^ m) n →+ wcTorModCoh F X h ℓ m n := fun n =>
    ((Abelian.Ext.mk₀ θ.inv).postcomp (SheafOfModules.unit (wcIntSliceRing F X h ℓ))
        (add_zero n)).comp
      (((Abelian.Ext.mk₀ q).precomp _ (zero_add n)).comp
        (AddMonoidHom.mk' (Abelian.Ext.mapExactFunctor (SheafOfModules.restrictScalars.{u+1} φ))
          (Abelian.Ext.mapExactFunctor_add (SheafOfModules.restrictScalars.{u+1} φ) _ _ n)))
  have hΦp : ∀ (n : ℕ) (x : wcZModSliceCoh F X h (ℓ ^ m) n), Φp n x =
      ((Abelian.Ext.mk₀ q).comp
        (Abelian.Ext.mapExactFunctor (SheafOfModules.restrictScalars.{u+1} φ) x)
          (zero_add n)).comp (Abelian.Ext.mk₀ θ.inv) (add_zero n) := fun _ _ => rfl
  have hbij : ∀ n, Function.Bijective (Φp n) := by
    intro n
    have hpost : Function.Bijective (fun y : Abelian.Ext (SheafOfModules.unit (wcIntSliceRing F X h ℓ))
        ((SheafOfModules.restrictScalars.{u+1} φ).obj
          (SheafOfModules.unit (wcZModSliceRing F X h (ℓ ^ m)))) n =>
        y.comp (Abelian.Ext.mk₀ θ.inv) (add_zero n)) := by
      refine ⟨fun y₁ y₂ hy => ?_, fun z => ⟨z.comp (Abelian.Ext.mk₀ θ.hom) (add_zero n), ?_⟩⟩
      · have hy' := congrArg (fun t => t.comp (Abelian.Ext.mk₀ θ.hom) (add_zero n)) hy
        simp only at hy'
        rwa [Abelian.Ext.comp_assoc _ _ _ (add_zero n) (add_zero 0) (by omega),
          Abelian.Ext.comp_assoc _ _ _ (add_zero n) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id,
          Abelian.Ext.comp_mk₀_id] at hy'
      · simp only
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero n) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    have hfun : (Φp n : wcZModSliceCoh F X h (ℓ ^ m) n → wcTorModCoh F X h ℓ m n) =
        (fun y : Abelian.Ext (SheafOfModules.unit (wcIntSliceRing F X h ℓ))
          ((SheafOfModules.restrictScalars.{u+1} φ).obj
            (SheafOfModules.unit (wcZModSliceRing F X h (ℓ ^ m)))) n =>
          y.comp (Abelian.Ext.mk₀ θ.inv) (add_zero n)) ∘
        (fun x : wcZModSliceCoh F X h (ℓ ^ m) n =>
          (Abelian.Ext.mk₀ q).comp
            (Abelian.Ext.mapExactFunctor (SheafOfModules.restrictScalars.{u+1} φ) x) (zero_add n)) :=
      funext fun x => hΦp n x
    rw [hfun]
    exact hpost.comp (hβ _ n)
  refine ⟨fun n => AddEquiv.ofBijective (Φp n) (hbij n), ?_⟩
  intro i j k hk a x y H
  change wcTorRed F X h ℓ m i a = Φp i x at H
  change wcIntTorAct F X h ℓ m i j k hk a (Φp j y) =
    Φp k (wcZModSliceCup F X h (ℓ ^ m) i j k hk x y)
  have hRed : wcTorRed F X h ℓ m i a = a.comp (Abelian.Ext.mk₀
      (Limits.cokernel.π ((ℓ ^ m : ℕ) • 𝟙 (SheafOfModules.unit (wcIntSliceRing F X h ℓ)))))
      (add_zero i) := rfl
  have hAct : ∀ c : wcTorModCoh F X h ℓ m j, wcIntTorAct F X h ℓ m i j k hk a c = a.comp c hk :=
    fun _ => rfl
  have hCup : wcZModSliceCup F X h (ℓ ^ m) i j k hk x y = x.comp y hk := rfl
  rw [hRed, hΦp] at H
  have hstar : a.comp (Abelian.Ext.mk₀ q) (add_zero i) = (Abelian.Ext.mk₀ q).comp
      (Abelian.Ext.mapExactFunctor (SheafOfModules.restrictScalars.{u+1} φ) x) (zero_add i) := by
    have H' := congrArg (fun t => t.comp (Abelian.Ext.mk₀ θ.hom) (add_zero i)) H
    try simp only at H'
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, hπθ,
      Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id] at H'
    exact H'
  rw [hAct, hCup, hΦp, hΦp]
  symm
  calc ((Abelian.Ext.mk₀ q).comp (Abelian.Ext.mapExactFunctor
          (SheafOfModules.restrictScalars.{u+1} φ) (x.comp y hk)) (zero_add k)).comp
          (Abelian.Ext.mk₀ θ.inv) (add_zero k)
      = ((Abelian.Ext.mk₀ q).comp ((Abelian.Ext.mapExactFunctor
          (SheafOfModules.restrictScalars.{u+1} φ) x).comp (Abelian.Ext.mapExactFunctor
          (SheafOfModules.restrictScalars.{u+1} φ) y) hk) (zero_add k)).comp
          (Abelian.Ext.mk₀ θ.inv) (add_zero k) := by
        rw [Abelian.Ext.mapExactFunctor_comp]
    _ = (((Abelian.Ext.mk₀ q).comp (Abelian.Ext.mapExactFunctor
          (SheafOfModules.restrictScalars.{u+1} φ) x) (zero_add i)).comp
          (Abelian.Ext.mapExactFunctor (SheafOfModules.restrictScalars.{u+1} φ) y) hk).comp
          (Abelian.Ext.mk₀ θ.inv) (add_zero k) := by
        rw [Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ q) _ _ (zero_add i) hk (by omega)]
    _ = ((a.comp (Abelian.Ext.mk₀ q) (add_zero i)).comp
          (Abelian.Ext.mapExactFunctor (SheafOfModules.restrictScalars.{u+1} φ) y) hk).comp
          (Abelian.Ext.mk₀ θ.inv) (add_zero k) := by
        rw [hstar]
    _ = (a.comp ((Abelian.Ext.mk₀ q).comp
          (Abelian.Ext.mapExactFunctor (SheafOfModules.restrictScalars.{u+1} φ) y) (zero_add j))
          hk).comp (Abelian.Ext.mk₀ θ.inv) (add_zero k) := by
        rw [Abelian.Ext.comp_assoc a (Abelian.Ext.mk₀ q) _ (add_zero i) (zero_add j) (by omega)]
    _ = a.comp (((Abelian.Ext.mk₀ q).comp
          (Abelian.Ext.mapExactFunctor (SheafOfModules.restrictScalars.{u+1} φ) y) (zero_add j)).comp
