      · intro hx
        have hxV : x ∈ Set.range V.ι := by
          rw [Scheme.Opens.range_ι]
          exact hWV hx
        obtain ⟨v, rfl⟩ := hxV
        have hv : v ∈ Set.range W'.ι := by
          rw [Scheme.Opens.range_ι, hW']
          exact hx
        obtain ⟨w, rfl⟩ := hv
        exact ⟨w, Scheme.Hom.comp_apply _ _ _⟩
    let e := IsOpenImmersion.isoOfRangeEq (W'.ι ≫ V.ι) W.ι hr
    obtain ⟨e'⟩ := wc_et_coh_iso_invariance e.hom m p
    exact ⟨e'.symm⟩



  have hAV : A ≤ V := by rw [← hAB]; exact le_sup_left
  have hBV : B ≤ V := by rw [← hAB]; exact le_sup_right
  have hcov : V.ι ⁻¹ᵁ A ⊔ V.ι ⁻¹ᵁ B = ⊤ := by
    rw [← Scheme.Hom.preimage_sup, hAB, Scheme.Opens.ι_preimage_self]
  letI hExt : HasExt (Sheaf (Scheme.smallEtaleTopology (V : Scheme.{u})) AddCommGrpCat.{u+1}) :=
    HasExt.standard _
  obtain ⟨f, g, hfg, hS⟩ := wc_et_free_mayer_vietoris_ses (V : Scheme.{u}) (V.ι ⁻¹ᵁ A)
    (V.ι ⁻¹ᵁ B) hcov

  have hexact : ∀ ξ : Abelian.Ext
      ((constantSheaf (Scheme.smallEtaleTopology (V : Scheme.{u})) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      ((constantSheaf (Scheme.smallEtaleTopology (V : Scheme.{u})) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) (q + 1),
      (Abelian.Ext.mk₀ (Limits.biprod.inl ≫ g)).comp ξ (zero_add (q + 1)) = 0 →
      (Abelian.Ext.mk₀ (Limits.biprod.inr ≫ g)).comp ξ (zero_add (q + 1)) = 0 →
      ∃ y, hS.extClass.comp y (Nat.add_comm 1 q) = ξ := by
    intro ξ h0 h1
    have e : g = Limits.biprod.fst ≫ (Limits.biprod.inl ≫ g) +
        Limits.biprod.snd ≫ (Limits.biprod.inr ≫ g) := by
      rw [← Category.assoc, ← Category.assoc, ← Preadditive.add_comp, Limits.biprod.total,
        Category.id_comp]
    have hg : (Abelian.Ext.mk₀ g).comp ξ (zero_add (q + 1)) = 0 := by
      have gen : ∀ {Z W : Sheaf (Scheme.smallEtaleTopology (V : Scheme.{u})) AddCommGrpCat.{u+1}}
          (a : Z ⟶ W) (b : W ⟶ (constantSheaf (Scheme.smallEtaleTopology (V : Scheme.{u}))
            AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))),
          (Abelian.Ext.mk₀ b).comp ξ (zero_add (q + 1)) = 0 →
          (Abelian.Ext.mk₀ (a ≫ b)).comp ξ (zero_add (q + 1)) = 0 := by
        intro Z W a b hb
        rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero, hb,
          Abelian.Ext.comp_zero]
      rw [e, Abelian.Ext.mk₀_add, Abelian.Ext.add_comp, gen _ _ h0, gen _ _ h1, add_zero]
    exact Abelian.Ext.contravariant_sequence_exact₃ hS _ ξ hg (Nat.add_comm 1 q)

  obtain ⟨eAB⟩ := s3 (V : Scheme.{u}) (V.ι ⁻¹ᵁ A ⊓ V.ι ⁻¹ᵁ B) q
  obtain ⟨eAB'⟩ := s4 (A ⊓ B) (V.ι ⁻¹ᵁ A ⊓ V.ι ⁻¹ᵁ B) (inf_le_left.trans hAV) rfl q
  obtain ⟨eA⟩ := s3 (V : Scheme.{u}) (V.ι ⁻¹ᵁ A) (q + 1)
  obtain ⟨eA'⟩ := s4 A (V.ι ⁻¹ᵁ A) hAV rfl (q + 1)
  obtain ⟨eB⟩ := s3 (V : Scheme.{u}) (V.ι ⁻¹ᵁ B) (q + 1)
  obtain ⟨eB'⟩ := s4 B (V.ι ⁻¹ᵁ B) hBV rfl (q + 1)
  obtain ⟨hfin, hcard⟩ := count
    (hS.extClass.precomp
      ((constantSheaf (Scheme.smallEtaleTopology (V : Scheme.{u})) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) (Nat.add_comm 1 q))
    ((Abelian.Ext.mk₀ (Limits.biprod.inl ≫ g)).precomp
      ((constantSheaf (Scheme.smallEtaleTopology (V : Scheme.{u})) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) (zero_add (q + 1)))
    ((Abelian.Ext.mk₀ (Limits.biprod.inr ≫ g)).precomp
      ((constantSheaf (Scheme.smallEtaleTopology (V : Scheme.{u})) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) (zero_add (q + 1)))
    (Finite.of_equiv _ (eAB.trans eAB').symm)
    (Finite.of_equiv _ (eA.trans eA').symm)
    (Finite.of_equiv _ (eB.trans eB').symm)
    (fun ξ h0 h1 => hexact ξ h0 h1)
  refine ⟨hfin, ?_⟩
  rw [← Nat.card_congr (eAB.trans eAB'), ← Nat.card_congr (eA.trans eA'),
    ← Nat.card_congr (eB.trans eB')]
  exact hcard

theorem wc_et_affine_line_push_const_iso : ∀ (K : Type u) [Field K] (X : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (m : ℕ), Nonempty ((wcEtPush (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))).obj ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback fX (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) ≅ (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) :=
by
  classical
  intro K _ X fX m

  have s1 : ∀ (V : Scheme.{u}) (fV : V ⟶ Spec (.of K)) (A : Type (u+1))
      (h : LocallyConstant ↥(Limits.pullback fV (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) A)
      (x y : ↥(Limits.pullback fV (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))),
      Limits.pullback.fst fV (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) x =
        Limits.pullback.fst fV (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) y →
      h x = h y := by
    intro V fV A h x y hxy
    obtain ⟨v, hv⟩ : ∃ v, Limits.pullback.fst fV
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) x = v := ⟨_, rfl⟩
    have hx : x ∈ Set.range (Limits.pullback.snd (V.fromSpecResidueField v)
        (Limits.pullback.fst fV (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))) := by
      rw [Scheme.Pullback.range_snd, Scheme.range_fromSpecResidueField]
      exact hv
    have hy : y ∈ Set.range (Limits.pullback.snd (V.fromSpecResidueField v)
        (Limits.pullback.fst fV (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))) := by
      rw [Scheme.Pullback.range_snd, Scheme.range_fromSpecResidueField]
      exact hxy.symm.trans hv
    let φ : CommRingCat.of K ⟶ V.residueField v := Spec.preimage (V.fromSpecResidueField v ≫ fV)
    letI : Algebra K (V.residueField v) := φ.hom.toAlgebra
    have hφ : Spec.map (CommRingCat.ofHom (algebraMap K (V.residueField v))) =
        V.fromSpecResidueField v ≫ fV := by
      show Spec.map (CommRingCat.ofHom φ.hom) = _
      rw [CommRingCat.ofHom_hom]
      exact Spec.map_preimage _
    haveI : IsDomain (TensorProduct K (V.residueField v) (Polynomial K)) :=
      MulEquiv.isDomain (Polynomial (V.residueField v))
        (polyEquivTensor K (V.residueField v)).symm.toMulEquiv
    let ψ : Spec (.of (TensorProduct K (V.residueField v) (Polynomial K))) ≅
        Limits.pullback (V.fromSpecResidueField v)
          (Limits.pullback.fst fV (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) :=
      ((Limits.pullbackRightPullbackFstIso fV _ (V.fromSpecResidueField v)) ≪≫
        Limits.pullback.congrHom hφ.symm rfl ≪≫
        pullbackSpecIso K (V.residueField v) (Polynomial K)).symm
    haveI : IrreducibleSpace ↥(Limits.pullback (V.fromSpecResidueField v)
        (Limits.pullback.fst fV (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))) :=
      Function.Surjective.irreducibleSpace ψ.hom.continuous
        (fun z => ⟨ψ.inv z, Scheme.inv_hom_apply ψ z⟩)
    have hirr : IsIrreducible (Set.range (Limits.pullback.snd (V.fromSpecResidueField v)
        (Limits.pullback.fst fV (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))))) := by
      rw [← Set.image_univ]
      exact (IrreducibleSpace.isIrreducible_univ _).image _
        (Limits.pullback.snd (V.fromSpecResidueField v) (Limits.pullback.fst fV
          (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))).continuous.continuousOn
    exact h.isLocallyConstant.apply_eq_of_isPreconnected hirr.isPreirreducible.isPreconnected hx hy

  have hz : Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : K))) ≫
      Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))) = 𝟙 (Spec (.of K)) := by
    rw [← Spec.map_comp, ← Spec.map_id]
    congr 1
    ext k
    simp

  have hsec : ∀ (V : X.Etale), ∃ σ : V.left ⟶ Limits.pullback V.hom
      (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))),
      σ ≫ Limits.pullback.fst V.hom
        (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) =
        𝟙 V.left := by
    intro V
    refine ⟨Limits.pullback.lift (𝟙 V.left)
      ((V.hom ≫ fX) ≫ Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : K))))
      (by simp only [Category.id_comp, Category.assoc, hz, Category.comp_id]) ≫
      (Limits.pullbackRightPullbackFstIso fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) V.hom).inv, ?_⟩
    rw [Category.assoc, Limits.pullbackRightPullbackFstIso_inv_fst, Limits.pullback.lift_fst]

  have hfib : ∀ (V : X.Etale) (h : LocallyConstant ↥(Limits.pullback V.hom
      (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))))
        (ULift.{u+1} (ZMod m)))
      (x y : ↥(Limits.pullback V.hom
        (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))))),
      Limits.pullback.fst V.hom
          (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) x =
        Limits.pullback.fst V.hom
          (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) y →
      h x = h y := by
    intro V h x y hxy
    have he : ∀ w, Limits.pullback.fst (V.hom ≫ fX)
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))
        ((Limits.pullbackRightPullbackFstIso fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) V.hom).hom w) =
        Limits.pullback.fst V.hom
          (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) w := by
      intro w
      rw [← Scheme.Hom.comp_apply, Limits.pullbackRightPullbackFstIso_hom_fst]
    have key := s1 V.left (V.hom ≫ fX) _
      (h.comap ⟨(Limits.pullbackRightPullbackFstIso fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) V.hom).inv,
        (Limits.pullbackRightPullbackFstIso fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) V.hom).inv.continuous⟩)
      ((Limits.pullbackRightPullbackFstIso fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) V.hom).hom x)
      ((Limits.pullbackRightPullbackFstIso fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) V.hom).hom y)
      (by rw [he, he, hxy])
    rw [LocallyConstant.coe_comap_apply, LocallyConstant.coe_comap_apply] at key
    simpa only [ContinuousMap.coe_mk, Scheme.hom_inv_apply] using key

  have hbij : ∀ V : X.Etale, Function.Bijective (LocallyConstant.comapAddMonoidHom
      ⟨Limits.pullback.fst V.hom
          (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))),
        (Limits.pullback.fst V.hom
          (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))).continuous⟩ :
      LocallyConstant V.left (ULift.{u+1} (ZMod m)) →+ LocallyConstant ↥(Limits.pullback V.hom
          (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))))
        (ULift.{u+1} (ZMod m))) := by
    intro V
    obtain ⟨σ, hσ⟩ := hsec V
    have hcσ : ∀ v, Limits.pullback.fst V.hom
        (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) (σ v) = v := by
      intro v
      rw [← Scheme.Hom.comp_apply, hσ]
      rfl
    refine ⟨fun a b hab => LocallyConstant.comap_injective _ (fun v => ⟨σ v, hcσ v⟩) hab,
      fun h => ⟨h.comap ⟨σ, σ.continuous⟩, ?_⟩⟩
    apply LocallyConstant.ext
    intro w
    show h (σ (Limits.pullback.fst V.hom
      (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) w)) = h w
    exact hfib V h _ _ (hcσ _)
  let Ψ : wcEtLC X (ULift.{u+1} (ZMod m)) ≅ wcLCPb (Limits.pullback.fst fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) (ULift.{u+1} (ZMod m)) :=
    NatIso.ofComponents (fun V => (AddEquiv.ofBijective _ (hbij V.unop)).toAddCommGrpIso) (by
      intro V W g
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro h
      apply LocallyConstant.ext
      intro w
      have key : ((wcEtBaseChange (Limits.pullback.fst fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))).map g.unop).left ≫
          Limits.pullback.fst V.unop.hom (Limits.pullback.fst fX
            (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) =
          Limits.pullback.fst W.unop.hom (Limits.pullback.fst fX
            (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) ≫ g.unop.left := by
        exact Limits.pullback.lift_fst _ _ _
      let h' : LocallyConstant V.unop.left (ULift.{u+1} (ZMod m)) := h
      have key2 := congrArg (fun k => h' (k w)) key
      exact key2.symm)
  obtain ⟨ea⟩ := wc_et_push_const_lc_iso (Limits.pullback.fst fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) (ULift.{u+1} (ZMod m))
    (wc_et_lc_isSheaf _ _) (wc_et_const_to_lc_locBij _ _)
  obtain ⟨φ, hinj, hsurj⟩ := wc_et_const_to_lc_locBij X (ULift.{u+1} (ZMod m))
  have hW : (Scheme.smallEtaleTopology X).W φ :=
    (GrothendieckTopology.W_iff_isLocallyBijective (Scheme.smallEtaleTopology X) φ).mpr
      ⟨hinj, hsurj⟩
  have hI : IsIso ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map φ) :=
    (GrothendieckTopology.W_iff (Scheme.smallEtaleTopology X) φ).mp hW
  let e1 := @asIso _ _ _ _ ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map φ) hI
  exact ⟨ea.symm ≪≫ ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).mapIso Ψ).symm ≪≫
    e1.symm⟩

theorem wc_et_limit_push_homology_affine : ∀ {X B : Scheme.{u}} (g : X ⟶ B) [IsAffineHom g] (A : Type u) [CommRing A] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W : Λ ⥤ B.Etale) (φ : ∀ l, Spec (.of A) ⟶ (W.obj l).left) (a : Spec (.of A) ⟶ B), (∀ l, IsAffine (W.obj l).left) → (∀ {l l' : Λ} (t : l ⟶ l'), φ l ≫ (W.map t).left = φ l') → (∀ l, φ l ≫ (W.obj l).hom = a) → (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (W.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (W.map t).left = z l') → ∃! z₀ : T ⟶ Spec (.of A), ∀ l, z₀ ≫ φ l = z l) → ∀ (m : ℕ) (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) (q : ℕ), Nonempty ((((sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⋙ (Functor.whiskeringLeft (B.Etale)ᵒᵖ (X.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj (@Functor.op B.Etale _ X.Etale _ (wcEtBaseChange g)) ⋙ (Functor.whiskeringLeft Λᵒᵖ (B.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj W.op ⋙ Limits.colim).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q ≃ wcEtCoh (Limits.pullback g a) m q) :=
by
  intro X B g _ A _ Λ _ _ W φ a haff hφ hφa hlim m I q

  have pres : ∀ (XZ : Scheme.{u}) (p : XZ ⟶ X) (hZ : XZ ⟶ Spec (.of A)), IsPullback p hZ g a →
      ∃ π : ∀ l, XZ ⟶ ((W ⋙ wcEtBaseChange g).obj l).left,
        (∀ l, π l ≫ ((W ⋙ wcEtBaseChange g).obj l).hom = p) ∧
        (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ ((W ⋙ wcEtBaseChange g).map t).left = π l') ∧
        (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ ((W ⋙ wcEtBaseChange g).obj l).left),
          (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ ((W ⋙ wcEtBaseChange g).map t).left = z l') →
          ∃! z₀ : T ⟶ XZ, ∀ l, z₀ ≫ π l = z l) ∧
        (∀ l, CompactSpace ((W ⋙ wcEtBaseChange g).obj l).left) ∧
        (∀ l, QuasiSeparatedSpace ((W ⋙ wcEtBaseChange g).obj l).left) ∧
        (∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom ((W ⋙ wcEtBaseChange g).map t).left) ∧
        CompactSpace XZ ∧ QuasiSeparatedSpace XZ ∧ XZ.IsSeparated := by
    intro XZ p hZ hpb
    have M1 : ∀ {l l' : Λ} (t : l ⟶ l'),
        ((W ⋙ wcEtBaseChange g).map t).left ≫ Limits.pullback.fst (W.obj l').hom g =
          Limits.pullback.fst (W.obj l).hom g ≫ (W.map t).left := by
      intro l l' t
      exact Limits.pullback.lift_fst _ _ _
    have M2 : ∀ {l l' : Λ} (t : l ⟶ l'),
        ((W ⋙ wcEtBaseChange g).map t).left ≫ Limits.pullback.snd (W.obj l').hom g =
          Limits.pullback.snd (W.obj l).hom g := by
      intro l l' t
      exact Limits.pullback.lift_snd _ _ _
    have hw : p ≫ g = hZ ≫ a := hpb.w
    have wl : ∀ l, (hZ ≫ φ l) ≫ (W.obj l).hom = p ≫ g := by
      intro l
      rw [Category.assoc, hφa l, hw]
    let π : ∀ l, XZ ⟶ ((W ⋙ wcEtBaseChange g).obj l).left := fun l =>
      Limits.pullback.lift (hZ ≫ φ l) p (wl l)
    have P1 : ∀ l, π l ≫ Limits.pullback.fst (W.obj l).hom g = hZ ≫ φ l := fun l =>
      Limits.pullback.lift_fst _ _ _
    have P2 : ∀ l, π l ≫ Limits.pullback.snd (W.obj l).hom g = p := fun l =>
      Limits.pullback.lift_snd _ _ _
    have C2 : ∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ ((W ⋙ wcEtBaseChange g).map t).left = π l' := by
      intro l l' t
      refine Limits.pullback.hom_ext (f := (W.obj l').hom) (g := g) ?_ ?_
      · calc (π l ≫ ((W ⋙ wcEtBaseChange g).map t).left) ≫ Limits.pullback.fst (W.obj l').hom g
            = π l ≫ (((W ⋙ wcEtBaseChange g).map t).left ≫
                Limits.pullback.fst (W.obj l').hom g) := Category.assoc _ _ _
          _ = π l ≫ (Limits.pullback.fst (W.obj l).hom g ≫ (W.map t).left) := whisker_eq _ (M1 t)
          _ = (π l ≫ Limits.pullback.fst (W.obj l).hom g) ≫ (W.map t).left :=
              (Category.assoc _ _ _).symm
          _ = (hZ ≫ φ l) ≫ (W.map t).left := eq_whisker (P1 l) _
          _ = hZ ≫ φ l' := by rw [Category.assoc, hφ t]
          _ = π l' ≫ Limits.pullback.fst (W.obj l').hom g := (P1 l').symm
      · calc (π l ≫ ((W ⋙ wcEtBaseChange g).map t).left) ≫ Limits.pullback.snd (W.obj l').hom g
            = π l ≫ (((W ⋙ wcEtBaseChange g).map t).left ≫
                Limits.pullback.snd (W.obj l').hom g) := Category.assoc _ _ _
          _ = π l ≫ Limits.pullback.snd (W.obj l).hom g := whisker_eq _ (M2 t)
          _ = p := P2 l
          _ = π l' ≫ Limits.pullback.snd (W.obj l').hom g := (P2 l').symm
    have C3 : ∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ ((W ⋙ wcEtBaseChange g).obj l).left),
        (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ ((W ⋙ wcEtBaseChange g).map t).left = z l') →
        ∃! z₀ : T ⟶ XZ, ∀ l, z₀ ≫ π l = z l := by
      intro T z hz
      have hs : ∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ Limits.pullback.snd (W.obj l).hom g =
          z l' ≫ Limits.pullback.snd (W.obj l').hom g := by
        intro l l' t
        calc z l ≫ Limits.pullback.snd (W.obj l).hom g
            = z l ≫ (((W ⋙ wcEtBaseChange g).map t).left ≫
                Limits.pullback.snd (W.obj l').hom g) := (whisker_eq _ (M2 t)).symm
          _ = (z l ≫ ((W ⋙ wcEtBaseChange g).map t).left) ≫
                Limits.pullback.snd (W.obj l').hom g := (Category.assoc _ _ _).symm
          _ = z l' ≫ Limits.pullback.snd (W.obj l').hom g := eq_whisker (hz t) _
      obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
      have hX : ∀ l, z l ≫ Limits.pullback.snd (W.obj l).hom g =
          z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom g := fun l =>
        (hs (IsCofiltered.minToLeft l l₀)).symm.trans (hs (IsCofiltered.minToRight l l₀))
      have hf : ∀ {l l' : Λ} (t : l ⟶ l'), (z l ≫ Limits.pullback.fst (W.obj l).hom g) ≫
          (W.map t).left = z l' ≫ Limits.pullback.fst (W.obj l').hom g := by
        intro l l' t
        calc (z l ≫ Limits.pullback.fst (W.obj l).hom g) ≫ (W.map t).left
            = z l ≫ (Limits.pullback.fst (W.obj l).hom g ≫ (W.map t).left) := Category.assoc _ _ _
          _ = z l ≫ (((W ⋙ wcEtBaseChange g).map t).left ≫
                Limits.pullback.fst (W.obj l').hom g) := whisker_eq _ (M1 t).symm
          _ = (z l ≫ ((W ⋙ wcEtBaseChange g).map t).left) ≫
                Limits.pullback.fst (W.obj l').hom g := (Category.assoc _ _ _).symm
          _ = z l' ≫ Limits.pullback.fst (W.obj l').hom g := eq_whisker (hz t) _
      obtain ⟨y, hy, hyu⟩ := hlim T (fun l => z l ≫ Limits.pullback.fst (W.obj l).hom g) hf
      have hy' : ∀ l, y ≫ φ l = z l ≫ Limits.pullback.fst (W.obj l).hom g := hy
      have hxy : (z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom g) ≫ g = y ≫ a := by
        calc (z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom g) ≫ g
            = z l₀ ≫ (Limits.pullback.snd (W.obj l₀).hom g ≫ g) := Category.assoc _ _ _
          _ = z l₀ ≫ (Limits.pullback.fst (W.obj l₀).hom g ≫ (W.obj l₀).hom) :=
              whisker_eq _ Limits.pullback.condition.symm
          _ = (z l₀ ≫ Limits.pullback.fst (W.obj l₀).hom g) ≫ (W.obj l₀).hom :=
              (Category.assoc _ _ _).symm
          _ = (y ≫ φ l₀) ≫ (W.obj l₀).hom := eq_whisker (hy' l₀).symm _
          _ = y ≫ a := by rw [Category.assoc, hφa l₀]
      obtain ⟨z₀, hz₀p, hz₀Z⟩ : ∃ z₀ : T ⟶ XZ,
          z₀ ≫ p = z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom g ∧ z₀ ≫ hZ = y :=
        ⟨hpb.lift _ y hxy, hpb.lift_fst _ _ _, hpb.lift_snd _ _ _⟩
      refine ⟨z₀, fun l => ?_, fun z' hz' => ?_⟩
      · refine Limits.pullback.hom_ext (f := (W.obj l).hom) (g := g) ?_ ?_
        · calc (z₀ ≫ π l) ≫ Limits.pullback.fst (W.obj l).hom g
              = z₀ ≫ (π l ≫ Limits.pullback.fst (W.obj l).hom g) := Category.assoc _ _ _
            _ = z₀ ≫ (hZ ≫ φ l) := whisker_eq _ (P1 l)
            _ = (z₀ ≫ hZ) ≫ φ l := (Category.assoc _ _ _).symm
            _ = y ≫ φ l := eq_whisker hz₀Z _
            _ = z l ≫ Limits.pullback.fst (W.obj l).hom g := hy' l
        · calc (z₀ ≫ π l) ≫ Limits.pullback.snd (W.obj l).hom g
              = z₀ ≫ (π l ≫ Limits.pullback.snd (W.obj l).hom g) := Category.assoc _ _ _
            _ = z₀ ≫ p := whisker_eq _ (P2 l)
            _ = z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom g := hz₀p
            _ = z l ≫ Limits.pullback.snd (W.obj l).hom g := (hX l).symm
      · have e1 : z' ≫ p = z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom g := by
          calc z' ≫ p = z' ≫ (π l₀ ≫ Limits.pullback.snd (W.obj l₀).hom g) :=
                whisker_eq _ (P2 l₀).symm
            _ = (z' ≫ π l₀) ≫ Limits.pullback.snd (W.obj l₀).hom g := (Category.assoc _ _ _).symm
            _ = z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom g := eq_whisker (hz' l₀) _
        have e2 : z' ≫ hZ = y := by
          apply hyu
          intro l
          calc (z' ≫ hZ) ≫ φ l = z' ≫ (hZ ≫ φ l) := Category.assoc _ _ _
            _ = z' ≫ (π l ≫ Limits.pullback.fst (W.obj l).hom g) := whisker_eq _ (P1 l).symm
            _ = (z' ≫ π l) ≫ Limits.pullback.fst (W.obj l).hom g := (Category.assoc _ _ _).symm
            _ = z l ≫ Limits.pullback.fst (W.obj l).hom g := eq_whisker (hz' l) _
        exact hpb.hom_ext (e1.trans hz₀p.symm) (e2.trans hz₀Z.symm)

    have keyA : ∀ {S T V : Scheme.{u}} (v : V ⟶ S) (h : T ⟶ S), IsAffineHom h → IsAffine V →
        IsAffine (Limits.pullback v h) := by
      intro S T V v h hh hV
      haveI : IsAffineHom (Limits.pullback.fst v h) :=
        MorphismProperty.of_isPullback (P := @IsAffineHom)
          (IsPullback.of_hasPullback v h).flip hh
      exact isAffine_of_isAffineHom (Limits.pullback.fst v h)
    have hlev : ∀ l, IsAffine ((W ⋙ wcEtBaseChange g).obj l).left := fun l =>
      keyA (W.obj l).hom g inferInstance (haff l)
    have C4 : ∀ l, CompactSpace ((W ⋙ wcEtBaseChange g).obj l).left := fun l => by
      haveI := hlev l
      infer_instance
    have C5 : ∀ l, QuasiSeparatedSpace ((W ⋙ wcEtBaseChange g).obj l).left := fun l => by
      haveI := hlev l
      infer_instance

    have C6 : ∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom ((W ⋙ wcEtBaseChange g).map t).left := by
      intro l l' t
      haveI := hlev l
      haveI := hlev l'
      exact @isAffineHom_of_isAffine _ _ _ (hlev l) (hlev l')

    haveI : IsAffineHom hZ := MorphismProperty.of_isPullback (P := @IsAffineHom) hpb inferInstance
    haveI : IsAffine XZ := isAffine_of_isAffineHom hZ
    have C7 : CompactSpace XZ := inferInstance
    have C8 : QuasiSeparatedSpace XZ := inferInstance
    have C9 : XZ.IsSeparated := inferInstance
    exact ⟨π, P2, C2, C3, C4, C5, C6, C7, C8, C9⟩
  obtain ⟨π, hπ, hπc, hπlim, hcpt, hqs, htaff, hZc, hZqs, hZsep⟩ :=
    pres (Limits.pullback g a) (Limits.pullback.fst g a) (Limits.pullback.snd g a)
      (IsPullback.of_hasPullback g a)

  obtain ⟨L, ⟨adj⟩, hPFL, ⟨eℤ⟩⟩ := wc_et_push_left_adjoint (Limits.pullback.fst g a)
  haveI := hPFL
  haveI : L.Additive := adj.left_adjoint_additive
  haveI : Limits.PreservesColimitsOfSize.{0, 0} L := adj.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits L := inferInstance
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Limits.pullback g a)) AddCommGrpCat.{u+1}) :=
    HasExt.standard _

  obtain ⟨hH⟩ := wc_et_limit_sections_colim_iso (Limits.pullback.fst g a) L ⟨adj⟩ Λ
    (W ⋙ wcEtBaseChange g) π hπ hπc hπlim hcpt hqs htaff hZc hZqs

  have hT : Limits.IsTerminal (Scheme.Etale.mk (𝟙 (Limits.pullback g a))) :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
  obtain ⟨hS⟩ := wc_et_sections_coyoneda_iso (Limits.pullback g a) _ hT
  let P := (constantSheaf (Scheme.smallEtaleTopology (Limits.pullback g a))
    AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))
  let K := (L.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex
  have hex : ∀ n : ℕ, K.ExactAt (n + 1) := by
    intro n
    rw [HomologicalComplex.exactAt_iff' K n (n + 1) (n + 1 + 1) (CochainComplex.prev_nat_succ n)
      (CochainComplex.next ℕ (n + 1))]
    exact (I.exact_succ n).map L
  have hι0 : L.map (I.ι.f 0) ≫ L.map (I.cocomplex.d 0 1) = 0 := by
    rw [← L.map_comp, InjectiveResolution.ι_f_zero_comp_complex_d, L.map_zero]
  haveI : Mono (L.map (I.ι.f 0)) := L.map_mono _
  have h₀ : Limits.IsLimit (Limits.KernelFork.ofι (L.map (I.ι.f 0)) hι0) := by
    let S0 := ShortComplex.mk (I.ι.f 0) (I.cocomplex.d 0 1)
      (by rw [InjectiveResolution.ι_f_zero_comp_complex_d])
    have hE : (S0.map L).Exact := I.exact₀.map L
    haveI : Mono (S0.map L).f := (inferInstance : Mono (L.map (I.ι.f 0)))
    exact hE.fIsKernel
  let e₀ := (CochainComplex.isoHomologyπ₀ K).symm ≪≫
    Limits.IsLimit.conePointUniqueUpToIso (K.cyclesIsKernel 0 1 (CochainComplex.next ℕ 0)) h₀ ≪≫
    L.mapIso (HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0
      ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))))

  have hacyc : ∀ n k : ℕ, Subsingleton (Abelian.Ext P (K.X n) (k + 1)) := by
    intro n k
    haveI := I.injective n
    exact wc_et_pullback_injective_limit_acyclic (Limits.pullback.fst g a) L ⟨adj⟩ Λ
      (W ⋙ wcEtBaseChange g) π hπ hπc hπlim hcpt hqs htaff hZc hZqs hZsep (I.cocomplex.X n) k

  obtain ⟨E₂⟩ := wc_ext_acyclic_resolution_homology P K hex hacyc q

  obtain ⟨eΛ⟩ := wc_et_left_adjoint_const_zmod L ⟨eℤ⟩ m
  let e := e₀ ≪≫ eΛ
  let E₃ : Abelian.Ext P (K.homology 0) q ≃ Abelian.Ext P
      ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback g a)) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) q :=
    { toFun := fun x => x.comp (Abelian.Ext.mk₀ e.hom) (add_zero q)
      invFun := fun y => y.comp (Abelian.Ext.mk₀ e.inv) (add_zero q)
      left_inv := fun x => by
        simp only
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
      right_inv := fun y => by
        simp only
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id] }

  let iso := (NatIso.mapHomologicalComplex (hH ≪≫ Functor.isoWhiskerLeft L hS)
      (ComplexShape.up ℕ)).app I.cocomplex ≪≫
    ((Functor.mapHomologicalComplexCompIso
      (Iso.refl (L ⋙ preadditiveCoyoneda.obj (Opposite.op P))) (ComplexShape.up ℕ)).app
        I.cocomplex).symm
  exact ⟨((HomologicalComplex.homologyMapIso iso q).addCommGroupIsoToAddEquiv.toEquiv).trans
    (E₂.trans E₃)⟩

theorem wc_et_strictly_local_ext_vanishing : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (F : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}) (q : ℕ), Subsingleton (wcEtExt (Spec (.of A)) F (q + 1)) :=
by
  intro A _ _ _ F q
  classical


  have hetale : ∀ (E : Type u) [CommRing E] [Algebra A E] [Algebra.Etale A E]
      (σ : E →ₐ[A] IsLocalRing.ResidueField A), ∃ τ : E →ₐ[A] A,
        ∀ x : E, IsLocalRing.residue A (τ x) = σ x := by
    intro E _ _ _ σ
    haveI hq : (RingHom.ker σ).IsPrime := RingHom.ker_isPrime σ
    haveI : Algebra.FormallyEtale E (Localization.AtPrime (RingHom.ker σ)) :=
      Algebra.FormallyEtale.of_isLocalization (RingHom.ker σ).primeCompl
    haveI : Algebra.IsEtaleAt A (RingHom.ker σ) :=
      Algebra.FormallyEtale.comp A E (Localization.AtPrime (RingHom.ker σ))
    obtain ⟨g, hg, hstd⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := A) (RingHom.ker σ)
    have hσg : IsUnit (σ g) := isUnit_iff_ne_zero.mpr (fun h => hg (RingHom.mem_ker.mpr h))
    let σg : Localization.Away g →ₐ[A] IsLocalRing.ResidueField A :=
      IsLocalization.Away.liftAlgHom g hσg
    have hσg_apply : ∀ y : E, σg (algebraMap E (Localization.Away g) y) = σ y := by
      intro y
      rw [IsLocalization.Away.liftAlgHom_apply, IsLocalization.Away.lift_eq]
      rfl
    obtain ⟨Q⟩ := hstd.nonempty_standardEtalePresentation
    let e : Q.Ring ≃ₐ[A] Localization.Away g :=
      AlgEquiv.ofBijective (Q.lift Q.x Q.hasMap) Q.lift_bijective
    have heX : e Q.X = Q.x := by
      rw [AlgEquiv.ofBijective_apply]
      exact Q.lift_X _ _
    set a₀ := σg Q.x with ha₀
    have hf0 : Polynomial.aeval a₀ Q.f = 0 := by
      rw [ha₀, Polynomial.aeval_algHom_apply, Q.hasMap.1, map_zero]
    have hf' : Polynomial.aeval a₀ (Polynomial.derivative Q.f) ≠ 0 := by
      rw [ha₀, Polynomial.aeval_algHom_apply]
      exact ((StandardEtalePair.HasMap.isUnit_derivative_f Q.P Q.hasMap).map σg).ne_zero
    have hg0 : Polynomial.aeval a₀ Q.g ≠ 0 := by
      rw [ha₀, Polynomial.aeval_algHom_apply]
      exact (Q.hasMap.2.map σg).ne_zero
    have hHen := ((HenselianLocalRing.TFAE A).out 1 2).mp (inferInstance : HenselianLocalRing A)
    obtain ⟨a, hroot, hres⟩ := hHen Q.f Q.monic_f a₀ hf0 hf'
    have hres' : ∀ p : Polynomial A,
        IsLocalRing.residue A (Polynomial.aeval a p) = Polynomial.aeval a₀ p := by
      intro p
      rw [← hres, ← IsLocalRing.ResidueField.algebraMap_eq, ← Algebra.ofId_apply,
        ← Algebra.ofId_apply, ← Polynomial.aeval_algHom_apply]
    have hHas : Q.HasMap a := by
      refine ⟨?_, ?_⟩
      · rw [Polynomial.coe_aeval_eq_eval]
        exact hroot
      · rw [← IsLocalRing.residue_ne_zero_iff_isUnit, hres']
        exact hg0
    have hcomp : (Algebra.ofId A (IsLocalRing.ResidueField A)).comp (Q.lift a hHas) =
        σg.comp (e : Q.Ring →ₐ[A] Localization.Away g) := by
      apply StandardEtalePair.hom_ext
      rw [AlgHom.comp_apply, AlgHom.comp_apply, Q.lift_X, AlgEquiv.coe_toAlgHom, heX,
        Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq, hres]
    refine ⟨((Q.lift a hHas).comp (e.symm : Localization.Away g →ₐ[A] Q.Ring)).comp
      (IsScalarTower.toAlgHom A E (Localization.Away g)), fun y => ?_⟩
    have h1 := congrArg (fun φ => φ (e.symm (algebraMap E (Localization.Away g) y))) hcomp
    simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom, AlgEquiv.apply_symm_apply,
      Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq] at h1
    rw [AlgHom.comp_apply, AlgHom.comp_apply, IsScalarTower.coe_toAlgHom',
      AlgEquiv.coe_toAlgHom, h1, hσg_apply]

  have Hsec : ∀ (E : Type u) [CommRing E] [Algebra A E], Algebra.Etale A E →
      ∀ φ : E →ₐ[A] IsLocalRing.ResidueField A, ∃ τ : E →ₐ[A] A,
        (Algebra.ofId A (IsLocalRing.ResidueField A)).comp τ = φ := by
    intro E _ _ hE φ
    haveI := hE
    obtain ⟨τ, hτ⟩ := hetale E φ
    refine ⟨τ, AlgHom.ext fun x => ?_⟩
    rw [AlgHom.comp_apply, Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq]
    exact hτ x


  have hsec : ∀ {V : Scheme.{u}} (g : V ⟶ Spec (.of A)) [Etale g] (v : V),
      g v = IsLocalRing.closedPoint A → ∃ σ : Spec (.of A) ⟶ V, σ ≫ g = 𝟙 _ := by
    intro V g _ v hv
    have hres : ∀ (S : Type u) [CommRing S] [Algebra A S], Algebra.Etale A S →
        ∀ (q : Ideal S) [q.IsPrime], q.comap (algebraMap A S) = IsLocalRing.maximalIdeal A →
        Nonempty (S →ₐ[A] IsLocalRing.ResidueField A) := by
      intro S _ _ hE q _ hq
      have hker : RingHom.ker (algebraMap A q.ResidueField) = IsLocalRing.maximalIdeal A := by
        rw [IsScalarTower.algebraMap_eq A S q.ResidueField, ← RingHom.comap_ker,
          Ideal.ker_algebraMap_residueField, hq]
      have : IsLocalHom (algebraMap A q.ResidueField) := by
        constructor
        intro a ha
        by_contra hna
        have hm : a ∈ IsLocalRing.maximalIdeal A := hna
        rw [← hker, RingHom.mem_ker] at hm
        exact ha.ne_zero hm
      let j : IsLocalRing.ResidueField A →+* q.ResidueField :=
        IsLocalRing.ResidueField.lift (algebraMap A q.ResidueField)
      letI : Algebra (IsLocalRing.ResidueField A) q.ResidueField := j.toAlgebra
      have : IsScalarTower A (IsLocalRing.ResidueField A) q.ResidueField :=
        IsScalarTower.of_algebraMap_eq (fun r => by
          rw [RingHom.algebraMap_toAlgebra, IsLocalRing.ResidueField.algebraMap_eq,
            IsLocalRing.ResidueField.lift_residue_apply])
      have : Algebra.FormallyUnramified S (Localization.AtPrime q) :=
        Algebra.FormallyUnramified.of_isLocalization q.primeCompl
      have : Algebra.FormallyUnramified S q.ResidueField :=
        Algebra.FormallyUnramified.comp S (Localization.AtPrime q) q.ResidueField
      have : Algebra.FormallyUnramified A q.ResidueField :=
        Algebra.FormallyUnramified.comp A S q.ResidueField
      have : Algebra.EssFiniteType A q.ResidueField := Algebra.EssFiniteType.comp A S q.ResidueField
      have : Algebra.FormallyUnramified (IsLocalRing.ResidueField A) q.ResidueField :=
        Algebra.FormallyUnramified.of_restrictScalars A _ q.ResidueField
      have : Algebra.EssFiniteType (IsLocalRing.ResidueField A) q.ResidueField :=
        Algebra.EssFiniteType.of_comp A _ q.ResidueField
      have : Algebra.IsSeparable (IsLocalRing.ResidueField A) q.ResidueField :=
        Algebra.FormallyUnramified.isSeparable _ q.ResidueField
      have hsurj := IsSepClosed.algebraMap_surjective (IsLocalRing.ResidueField A) q.ResidueField
      let eq : IsLocalRing.ResidueField A ≃ₐ[A] q.ResidueField :=
        AlgEquiv.ofBijective (IsScalarTower.toAlgHom A (IsLocalRing.ResidueField A) q.ResidueField)
          ⟨(algebraMap (IsLocalRing.ResidueField A) q.ResidueField).injective, hsurj⟩
      exact ⟨eq.symm.toAlgHom.comp (IsScalarTower.toAlgHom A S q.ResidueField)⟩
    obtain ⟨E, ι, hι, hvι, -⟩ :=
      Scheme.exists_affine_mem_range_and_range_subset (U := (⊤ : V.Opens)) (x := v) trivial
    obtain ⟨w, hw⟩ := hvι
    have := hι
    let h : Spec E ⟶ Spec (.of A) := ι ≫ g
    have : Etale h := inferInstance
    let φ : CommRingCat.of A ⟶ E := Spec.preimage h
    have hφ : Spec.map φ = h := Spec.map_preimage h
    have hEt : (CommRingCat.Hom.hom φ).Etale := by
      have : Etale (Spec.map φ) := by rw [hφ]; infer_instance
      exact (HasRingHomProperty.Spec_iff (P := @Etale)).mp this
    letI : Algebra A E := (CommRingCat.Hom.hom φ).toAlgebra
    have hAE : Algebra.Etale A E := RingHom.Etale.toAlgebra hEt
    let p : PrimeSpectrum E := w
    have hq : (p.asIdeal).comap (algebraMap A E) = IsLocalRing.maximalIdeal A := by
      have h1 : (Spec.map φ) w = IsLocalRing.closedPoint A := by
        rw [hφ]
        show g (ι w) = _
        rw [hw, hv]
      have h2 := congrArg PrimeSpectrum.asIdeal h1
      exact h2
    obtain ⟨φ₀⟩ := hres E hAE p.asIdeal hq
    obtain ⟨τ, -⟩ := Hsec E hAE φ₀
    let τ' : E ⟶ CommRingCat.of A := CommRingCat.ofHom (τ : E →+* A)
    have hret : φ ≫ τ' = 𝟙 _ := by
      ext r
      exact τ.commutes r
    refine ⟨Spec.map τ' ≫ ι, ?_⟩
    have h3 : ι ≫ g = Spec.map φ := hφ.symm
    rw [Category.assoc, h3, ← Spec.map_comp, hret, Spec.map_id]

  let T : (Spec (.of A)).Etale := Scheme.Etale.mk (𝟙 (Spec (.of A)))
  have hT : Limits.IsTerminal T :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
  have hcov : ∀ R ∈ (Scheme.smallEtaleTopology (Spec (.of A))) T, R.arrows (𝟙 T) := by
    intro R hR
    change R ∈ Scheme.smallGrothendieckTopology @Etale (Spec (.of A)) T at hR
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale _
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
    have hR' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale _
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hR
    obtain ⟨Y, f, y, hf, hfe, hy⟩ := hR' (IsLocalRing.closedPoint A)
    haveI : Etale f.left := hfe
    obtain ⟨σ, hσ⟩ := @hsec Y.left f.left hfe y hy
    let σ' : T ⟶ Y := MorphismProperty.Over.homMk σ (by
      rw [← MorphismProperty.Over.w f]
      exact (Category.assoc _ _ _).symm.trans
        ((congrArg (fun k => k ≫ T.hom) hσ).trans (Category.id_comp _)))
    have h := R.downward_closed hf σ'
    rwa [hT.hom_ext (σ' ≫ f) (𝟙 T)] at h

  have hsurjT : ∀ {F G : (Spec (.of A)).Etaleᵒᵖ ⥤ AddCommGrpCat.{u+1}} (φ : F ⟶ G),
      Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology (Spec (.of A))) φ →
      Function.Surjective (φ.app (Opposite.op T)) := by
    intro F G φ hφ s
    have h1 := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology (Spec (.of A))) φ s
    have h2 := hcov _ h1
    rw [Presheaf.imageSieve_apply] at h2
    obtain ⟨t, ht⟩ := h2
    exact ⟨t, by simpa using ht⟩

  haveI : ((sheafSections (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}).obj
      (Opposite.op T)).PreservesEpimorphisms := by
    constructor
    intro F G φ hφ
    have h1 : Sheaf.IsLocallySurjective φ :=
      (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} φ).mpr hφ
    exact (AddCommGrpCat.epi_iff_surjective _).mpr (hsurjT φ.hom h1)

  have hP : Projective (AddCommGrpCat.of (ULift.{u+1} ℤ)) := by
    refine ⟨fun {E X} f e he => ?_⟩
    have hs := (AddCommGrpCat.epi_iff_surjective e).mp he
    obtain ⟨y, hy⟩ := hs (f ⟨1⟩)
    refine ⟨AddCommGrpCat.ofHom ((zmultiplesHom E y).comp AddEquiv.ulift.toAddMonoidHom), ?_⟩
    ext ⟨n⟩
    have h1 : (⟨n⟩ : ULift.{u+1} ℤ) = n • (⟨1⟩ : ULift.{u+1} ℤ) := by
      ext; simp
    change e (n • y) = f ⟨n⟩
    rw [h1, map_zsmul, map_zsmul, hy]

  have adj := constantSheafAdj (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1} hT
  haveI hproj := adj.map_projective _ hP

  letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}) :=
    HasExt.standard _
  unfold wcEtExt
  exact Abelian.Ext.subsingleton_of_projective _ _ q

theorem wc_proj_space_smooth : ∀ (K : Type u) [Field K] (d : ℕ),
    SmoothOfRelativeDimension d (wcProjKStr K d) :=
by
  intro K _ d
  classical
  letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) :=
    MvPolynomial.gradedAlgebra

  have scaling : ∀ (T : Type u) [CommRing T] (ν ι : MvPolynomial (Fin (d + 1)) K →+* T) (t : T),
      (∀ c : K, ν (MvPolynomial.C c) = ι (MvPolynomial.C c)) →
      (∀ k, ν (MvPolynomial.X k) * t = ι (MvPolynomial.X k)) →
      ∀ (n : ℕ) (a : MvPolynomial (Fin (d + 1)) K), a.IsHomogeneous n → ν a * t ^ n = ι a := by
    intro T _ ν ι t hC hXk n a ha
    conv_rhs => rw [a.as_sum]
    conv_lhs => rw [a.as_sum]
    rw [map_sum, map_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl (fun m hm => ?_)
    have hdeg : ∑ k ∈ m.support, m k = n := by
      have := ha (MvPolynomial.mem_support_iff.mp hm)
      simpa [Finsupp.weight_apply, Finsupp.sum] using this
    rw [MvPolynomial.monomial_eq, map_mul, map_mul, Finsupp.prod, map_prod, map_prod, ← hdeg,
      ← Finset.prod_pow_eq_pow_sum, mul_assoc, ← Finset.prod_mul_distrib, hC]
    congr 1
    refine Finset.prod_congr rfl (fun k _ => ?_)
    rw [map_pow, map_pow, ← mul_pow, hXk]

  have mvpoly : ∀ (S : Type u) [CommRing S] (e : MvPolynomial (Fin d) K ≃+* S),
      RingHom.IsStandardSmoothOfRelativeDimension d
        ((e : MvPolynomial (Fin d) K →+* S).comp MvPolynomial.C) := by
    intro S _ e
    have h1 : RingHom.IsStandardSmoothOfRelativeDimension d
        (algebraMap K (MvPolynomial (Fin d) K)) := by
      rw [RingHom.isStandardSmoothOfRelativeDimension_algebraMap]
      have := Algebra.IsStandardSmoothOfRelativeDimension.mvPolynomial K (Fin d)
      rwa [Nat.card_fin] at this
    have h3 := (RingHom.IsStandardSmoothOfRelativeDimension.equiv e).comp h1
    rw [zero_add, MvPolynomial.algebraMap_eq] at h3
    exact h3
  have hX : ∀ k : Fin (d + 1), (MvPolynomial.X k : MvPolynomial (Fin (d + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K 1 :=
    fun k => (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K k)

  have chart : ∀ i : Fin (d + 1), ∃ e : MvPolynomial (Fin d) K ≃+* HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) (MvPolynomial.X i),
      ∀ c : K, e (MvPolynomial.C c) =
        HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)
          (Submonoid.powers (MvPolynomial.X i))
          (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K 0) c) := by
    intro i
    let κ := (HomogeneousLocalization.fromZeroRingHom
      (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) (Submonoid.powers (MvPolynomial.X i))).comp
        (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K 0))
    have h1 : ∀ j : Fin d, (MvPolynomial.X (i.succAbove j) : MvPolynomial (Fin (d + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K (1 • 1) := fun j => by
      rw [smul_eq_mul, mul_one]; exact hX _
    let y : Fin d → HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) (MvPolynomial.X i) := fun j =>
      HomogeneousLocalization.Away.mk _ (hX i) 1 (MvPolynomial.X (i.succAbove j)) (h1 j)
    let φ := MvPolynomial.eval₂Hom κ y
    let δ : MvPolynomial (Fin (d + 1)) K →ₐ[K] MvPolynomial (Fin d) K :=
      MvPolynomial.aeval (Fin.insertNth i (1 : MvPolynomial (Fin d) K) MvPolynomial.X)
    have hδi : δ (MvPolynomial.X i) = 1 := by
      simp only [δ, MvPolynomial.aeval_X, Fin.insertNth_apply_same]
    have hδs : ∀ j, δ (MvPolynomial.X (i.succAbove j)) = MvPolynomial.X j := by
      intro j; simp only [δ, MvPolynomial.aeval_X, Fin.insertNth_apply_succAbove]
    have hδC : ∀ c, δ (MvPolynomial.C c) = MvPolynomial.C c := by
      intro c; simp only [δ, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
    let L := Localization (Submonoid.powers (MvPolynomial.X i : MvPolynomial (Fin (d + 1)) K))
    have hu : IsUnit (δ.toRingHom (MvPolynomial.X i)) := by
      show IsUnit (δ (MvPolynomial.X i))
      rw [hδi]; exact isUnit_one
    let Λ : L →+* MvPolynomial (Fin d) K := IsLocalization.Away.lift (MvPolynomial.X i) hu
    have hΛ : ∀ a, Λ (algebraMap _ L a) = δ a := fun a => IsLocalization.Away.lift_eq _ hu a
    let ψ : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)
        (MvPolynomial.X i) →+* MvPolynomial (Fin d) K := Λ.comp (algebraMap _ L)
    have hF : ∀ (n : ℕ) (a : MvPolynomial (Fin (d + 1)) K)
        (ha : a ∈ MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K (n • 1)),
        ψ (HomogeneousLocalization.Away.mk _ (hX i) n a ha) = δ a := by
      intro n a ha
      have hs := IsLocalization.mk'_spec L a
        (⟨MvPolynomial.X i ^ n, n, rfl⟩ : Submonoid.powers (MvPolynomial.X i))
      have h2 := congrArg Λ hs
      rw [map_mul, hΛ, hΛ] at h2
      change Λ _ * δ (MvPolynomial.X i ^ n) = δ a at h2
      rw [map_pow, hδi, one_pow, mul_one] at h2
      show Λ (algebraMap _ L _) = _
      rw [HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
        Localization.mk_eq_mk'_apply]
      exact h2
    have hC0 : ∀ c : K, (MvPolynomial.C c : MvPolynomial (Fin (d + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K (0 • 1) := fun c => by
      rw [zero_smul]
      exact (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_C _ c)
    have hκ : ∀ c, κ c = HomogeneousLocalization.Away.mk _ (hX i) 0 (MvPolynomial.C c) (hC0 c) := by
      intro c
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk]
      change (HomogeneousLocalization.mk
          ⟨0, algebraMap K _ c, 1, by rw [SetLike.GradeZero.coe_one]; exact Submonoid.one_mem _⟩ :
            HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)
              (MvPolynomial.X i)).val = _
      rw [HomogeneousLocalization.val_mk]
      congr 1
    have hψφ : ψ.comp φ = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro c
        rw [RingHom.comp_apply, RingHom.id_apply]
        show ψ (MvPolynomial.eval₂Hom κ y (MvPolynomial.C c)) = _
        rw [MvPolynomial.eval₂Hom_C, hκ, hF, hδC]
      · intro j
        rw [RingHom.comp_apply, RingHom.id_apply]
        show ψ (MvPolynomial.eval₂Hom κ y (MvPolynomial.X j)) = _
        rw [MvPolynomial.eval₂Hom_X', hF, hδs]
    have hφψ : φ.comp ψ = RingHom.id _ := by
      refine RingHom.ext fun x => ?_
      obtain ⟨n, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective _ (hX i) x
      rw [RingHom.comp_apply, RingHom.id_apply, hF]
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk'_apply, eq_comm,
        IsLocalization.mk'_eq_iff_eq_mul]
      have hahom : a.IsHomogeneous n := by
        rw [smul_eq_mul, mul_one] at ha
        exact (MvPolynomial.mem_homogeneousSubmodule _ _).mp ha
      have key := scaling L
        ((algebraMap (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) (MvPolynomial.X i)) L).comp
            (φ.comp δ.toRingHom))
        (algebraMap (MvPolynomial (Fin (d + 1)) K) L)
        (algebraMap (MvPolynomial (Fin (d + 1)) K) L (MvPolynomial.X i)) ?_ ?_ n a hahom
      · rw [← key, RingHom.comp_apply, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply]
        congr 1
        exact (map_pow _ _ _).symm
      · intro c
        show algebraMap _ L (φ (δ (MvPolynomial.C c))) = _
        rw [hδC]
        show algebraMap _ L (MvPolynomial.eval₂Hom κ y (MvPolynomial.C c)) = _
        rw [MvPolynomial.eval₂Hom_C, hκ, HomogeneousLocalization.algebraMap_apply,
          HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk'_apply,
          IsLocalization.mk'_eq_iff_eq_mul]
        show _ = _ * algebraMap (MvPolynomial (Fin (d + 1)) K) L (MvPolynomial.X i ^ 0)
        rw [pow_zero, map_one, mul_one]
      · intro k
        obtain h | ⟨j, h⟩ := Fin.eq_self_or_eq_succAbove i k
        · rw [h]
          show algebraMap _ L (φ (δ (MvPolynomial.X i))) * _ = _
          rw [hδi, map_one, map_one, one_mul]
        · rw [h]
          show algebraMap _ L (φ (δ (MvPolynomial.X (i.succAbove j)))) * _ = _
          rw [hδs]
          show algebraMap _ L (MvPolynomial.eval₂Hom κ y (MvPolynomial.X j)) * _ = _
          rw [MvPolynomial.eval₂Hom_X', HomogeneousLocalization.algebraMap_apply,
            HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk'_apply]
          have hs := IsLocalization.mk'_spec L
            (MvPolynomial.X (i.succAbove j) : MvPolynomial (Fin (d + 1)) K)
            (⟨MvPolynomial.X i ^ 1, 1, rfl⟩ : Submonoid.powers (MvPolynomial.X i))
          rw [← hs]
          congr 1
          show _ = algebraMap (MvPolynomial (Fin (d + 1)) K) L (MvPolynomial.X i ^ 1)
          rw [pow_one]
    exact ⟨RingEquiv.ofRingHom φ ψ hφψ hψφ, fun c => MvPolynomial.eval₂Hom_C _ _ _⟩

  have hspan : (HomogeneousIdeal.irrelevant
      (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)).toIdeal ≤
      Ideal.span (Set.range (MvPolynomial.X : Fin (d + 1) → MvPolynomial (Fin (d + 1)) K)) := by
    intro a ha
    have ha2 : a ∈ HomogeneousIdeal.irrelevant
        (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) := HomogeneousIdeal.mem_iff.mp ha
    rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply] at ha2
    have ha' : MvPolynomial.homogeneousComponent 0 a = 0 :=
      (MvPolynomial.decomposition.decompose'_apply a 0).symm.trans ha2
    rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at ha'
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    by_contra hc
    push_neg at hc
    have hm0 : m = 0 := Finsupp.ext fun k => hc k (Set.mem_univ k)
    rw [hm0] at hm
    exact (MvPolynomial.mem_support_iff.mp hm) ha'

  haveI : IsZariskiLocalAtSource (@SmoothOfRelativeDimension d) :=
    HasRingHomProperty.instIsZariskiLocalAtSource
  apply IsZariskiLocalAtSource.of_openCover
    (Proj.affineOpenCoverOfIrrelevantLESpan (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)
      (MvPolynomial.X : Fin (d + 1) → MvPolynomial (Fin (d + 1)) K) (m := fun _ => 1) hX
      (fun _ => one_pos) hspan).openCover
  intro (i : Fin (d + 1))
  change SmoothOfRelativeDimension d
    (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) (MvPolynomial.X i) (hX i)
      one_pos ≫ (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) ≫
        Spec.map (CommRingCat.ofHom
          (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K 0)))))
  rw [Proj.awayι_toSpecZero_assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
    HasRingHomProperty.Spec_iff (P := @SmoothOfRelativeDimension d), CommRingCat.hom_ofHom]
  apply RingHom.locally_of RingHom.isStandardSmoothOfRelativeDimension_respectsIso
  obtain ⟨e, he⟩ := chart i
  have heq : (HomogeneousLocalization.fromZeroRingHom
      (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) (Submonoid.powers (MvPolynomial.X i))).comp
        (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K 0)) =
      (e : MvPolynomial (Fin d) K →+* _).comp MvPolynomial.C :=
    RingHom.ext fun c => (he c).symm
  rw [heq]
  exact mvpoly _ e

theorem wc_et_open_fp_lift : ∀ {Y U : Scheme.{u}} (j : U ⟶ Y) [IsOpenImmersion j] (L : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology U) AddCommGrpCat.{u+1}), Nonempty (L ⊣ wcEtPush j) → ∀ (U' V' : U.Etale) (g : (presheafToSheaf (Scheme.smallEtaleTopology U) AddCommGrpCat.{u+1}).obj (yoneda.obj V' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ (presheafToSheaf (Scheme.smallEtaleTopology U) AddCommGrpCat.{u+1}).obj (yoneda.obj U' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)), CompactSpace U'.left → QuasiSeparatedSpace U'.left → CompactSpace V'.left → QuasiSeparatedSpace V'.left → ∀ ℓ : ℕ, ℓ • 𝟙 (Limits.cokernel g) = 0 → ∃ (U'' V'' : Y.Etale) (g'' : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj V'' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj U'' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)), CompactSpace U''.left ∧ QuasiSeparatedSpace U''.left ∧ CompactSpace V''.left ∧ QuasiSeparatedSpace V''.left ∧ ℓ • 𝟙 (Limits.cokernel g'') = 0 ∧ Nonempty (L.obj (Limits.cokernel g'') ≅ Limits.cokernel g) :=
by

  have hjs : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
      (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
    intro Y V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩

  have hcov : ∀ {X B : Scheme.{u}} (g : X ⟶ B), CoverPreserving (Scheme.smallEtaleTopology B)
      (Scheme.smallEtaleTopology X) (wcEtBaseChange g) := by
    intro X B g
    constructor
    intro V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale B V at hS
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
    have hS' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS
    apply hjs
    intro v
    obtain ⟨W, a, w, ha, -, hw⟩ := hS' (Limits.pullback.fst V.hom g v)
    refine ⟨(wcEtBaseChange g).obj W, (wcEtBaseChange g).map a,
      Sieve.image_mem_functorPushforward (wcEtBaseChange g) S ha, ?_⟩
    have h0 : (Limits.pullback.fst W.hom g ≫ a.left) ≫ V.hom = Limits.pullback.snd W.hom g ≫ g := by
      rw [Category.assoc, MorphismProperty.Over.w a]
      exact Limits.pullback.condition
    let m : Limits.pullback W.hom g ⟶ Limits.pullback V.hom g :=
      Limits.pullback.lift (Limits.pullback.fst W.hom g ≫ a.left) (Limits.pullback.snd W.hom g) h0
    have hmap : ((wcEtBaseChange g).map a).left = m := rfl
    have h1 : Limits.pullback.fst a.left (Limits.pullback.fst V.hom g) ≫ W.hom =
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) ≫ g := by
      rw [← MorphismProperty.Over.w a, ← Category.assoc, Limits.pullback.condition, Category.assoc,
        Limits.pullback.condition, Category.assoc]
    let ψ : Limits.pullback a.left (Limits.pullback.fst V.hom g) ⟶ Limits.pullback W.hom g :=
      Limits.pullback.lift (Limits.pullback.fst a.left (Limits.pullback.fst V.hom g))
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) h1
    have hψ : ψ ≫ m = Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, Limits.pullback.lift_fst,
          Limits.pullback.condition]
      · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
    obtain ⟨z, hz⟩ : ∃ z, Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) z = v := by
      have hv : (v : ↥(Limits.pullback V.hom g)) ∈
          Set.range (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g)) := by
        rw [Scheme.Pullback.range_snd]
        exact ⟨w, hw⟩
      exact hv
    rw [hmap]
    exact ⟨ψ z, (Scheme.Hom.comp_apply ψ m z).symm.trans (by rw [hψ]; exact hz)⟩

  let rep : ∀ {E : Type (u+1)} [Category.{u} E] (J' : GrothendieckTopology E)
      [HasWeakSheafify J' AddCommGrpCat.{u+1}] (Y : E),
      (sheafToPresheaf J' AddCommGrpCat.{u+1} ⋙ (evaluation Eᵒᵖ AddCommGrpCat.{u+1}).obj
        (Opposite.op Y) ⋙ forget AddCommGrpCat.{u+1}).CorepresentableBy
        ((presheafToSheaf J' AddCommGrpCat.{u+1}).obj
          (yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) :=
    fun {E} _ J' _ Y =>
      { homEquiv := fun {G} =>
          ((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv _ G).trans
            (((Adjunction.whiskerRight Eᵒᵖ AddCommGrpCat.adj).homEquiv
              (yoneda.obj Y ⋙ uliftFunctor.{u+1, u}) _).trans uliftYonedaEquiv)
        homEquiv_comp := fun {G G'} f g => by
          simp only [Equiv.trans_apply, Adjunction.homEquiv_naturality_right]
          rfl }
  intro Y U j _ L hadj U' V' g hU hU' hV hV' ℓ htor
  obtain ⟨adj⟩ := hadj
  letI : MorphismProperty.IsStableUnderComposition (@Etale : MorphismProperty Scheme.{u}) :=
    MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  let ι : U.Etale ⥤ Y.Etale :=
    MorphismProperty.Over.map (P := @Etale) (⊤ : MorphismProperty Scheme.{u}) (inferInstance : Etale j)
  let Φ := wcEtBaseChange j

  haveI h1 : Limits.PreservesFiniteLimits Φ := ⟨fun J _ _ =>
    haveI : Limits.PreservesLimitsOfShape J (wcEtBaseChange j ⋙ Scheme.Etale.forget U) :=
      Limits.preservesLimitsOfShape_of_natIso
        (NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl) :
          Scheme.Etale.forget Y ⋙ Over.pullback j ≅ wcEtBaseChange j ⋙ Scheme.Etale.forget U)
    Limits.preservesLimitsOfShape_of_reflects_of_preserves (wcEtBaseChange j) (Scheme.Etale.forget U)⟩
  haveI := flat_of_preservesFiniteLimits Φ
  haveI hΦ : Φ.IsContinuous (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology U) :=
    Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat _ _) (hcov j)
  let e : wcEtPush j ≅ Φ.sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology U) :=
    Functor.isoWhiskerRight (Φ.sheafPushforwardContinuousCompSheafToPresheafIso AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology U)).symm
      (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) ≪≫
    Functor.associator _ _ _ ≪≫
    Functor.isoWhiskerLeft _ (asIso (sheafificationAdjunction (Scheme.smallEtaleTopology Y)
      AddCommGrpCat.{u+1}).counit) ≪≫
    Functor.rightUnitor _

  haveI hfaith : ι.Faithful := ⟨fun {T₁ T₂} a b h => MorphismProperty.Over.Hom.ext
    (congrArg (fun φ => φ.left) h : (ι.map a).left = (ι.map b).left)⟩
  haveI hfull : ι.Full := ⟨fun {T₁ T₂} φ =>
    ⟨MorphismProperty.Over.homMk φ.left
      ((cancel_mono j).1 ((Category.assoc φ.left T₂.hom j).trans (MorphismProperty.Over.w φ))) trivial,
      MorphismProperty.Over.Hom.ext rfl⟩⟩
  let hF : ∀ {c : U.Etale} {d : Y.Etale}, (d ⟶ ι.obj c) → (c' : U.Etale) × (ι.obj c' ≅ d) := by
    intro c d f
    have hd : f.left ≫ c.hom ≫ j = d.hom := MorphismProperty.Over.w f
    have h2 : d.hom = (f.left ≫ c.hom) ≫ j := hd.symm.trans (Category.assoc f.left c.hom j).symm
    have hEt : Etale (f.left ≫ c.hom) := by
      have hp : Etale d.hom := d.prop
      haveI : Etale ((f.left ≫ c.hom) ≫ j) :=
        (congrArg (fun k : d.left ⟶ Y => Etale k) h2).mp hp
      exact Etale.of_comp (f.left ≫ c.hom) j
    exact ⟨MorphismProperty.Over.mk ⊤ (f.left ≫ c.hom) hEt,
      MorphismProperty.Over.isoMk (Iso.refl d.left)
        (show 𝟙 d.left ≫ d.hom = (f.left ≫ c.hom) ≫ j from (Category.id_comp _).trans h2)⟩
  have hcovι : CoverPreserving (Scheme.smallEtaleTopology U) (Scheme.smallEtaleTopology Y) ι := by
    constructor
    intro T S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale U T at hS
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale U
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
    have hS' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale U
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS
    apply hjs
    intro v
    obtain ⟨W, a, w, ha, -, hw⟩ := hS' v
    exact ⟨ι.obj W, ι.map a, Sieve.image_mem_functorPushforward ι S ha, w, hw⟩
  haveI hι : ι.IsContinuous (Scheme.smallEtaleTopology U) (Scheme.smallEtaleTopology Y) :=
    Functor.isContinuous_of_coverPreserving
      (compatiblePreservingOfDownwardsClosed (Scheme.smallEtaleTopology Y) ι hF) hcovι

  have hK : ∀ T : U.Etale, Limits.pullback.fst (T.hom ≫ j) j ≫ T.hom =
      Limits.pullback.snd (T.hom ≫ j) j :=
    fun T => (cancel_mono j).1 (by rw [Category.assoc]; exact Limits.pullback.condition)
  let eT : ∀ T : U.Etale, Limits.pullback (T.hom ≫ j) j ≅ T.left := fun T =>
    { hom := Limits.pullback.fst (T.hom ≫ j) j
      inv := Limits.pullback.lift (𝟙 T.left) T.hom (by rw [Category.id_comp])
      hom_inv_id := by
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, Limits.pullback.lift_fst, Category.comp_id, Category.id_comp]
        · rw [Category.assoc, Limits.pullback.lift_snd, Category.id_comp, hK T]
      inv_hom_id := Limits.pullback.lift_fst _ _ _ }
  let ε : ι ⋙ Φ ≅ 𝟭 U.Etale := NatIso.ofComponents
    (fun T => MorphismProperty.Over.isoMk (eT T) (hK T))
    (fun {T T'} a => by
      apply MorphismProperty.Over.Hom.ext
      show _ ≫ Limits.pullback.fst (T'.hom ≫ j) j = Limits.pullback.fst (T.hom ≫ j) j ≫ a.left
      exact Limits.pullback.lift_fst _ _ _)

  haveI := Functor.isContinuous_comp ι Φ (Scheme.smallEtaleTopology U) (Scheme.smallEtaleTopology Y)
    (Scheme.smallEtaleTopology U)
  let ιs := Functor.sheafPullbackConstruction.sheafPullback ι AddCommGrpCat.{u+1}
    (Scheme.smallEtaleTopology U) (Scheme.smallEtaleTopology Y)
  let adjI : ιs ⊣ ι.sheafPushforwardContinuous AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology U)
      (Scheme.smallEtaleTopology Y) :=
    Functor.sheafPullbackConstruction.sheafAdjunctionContinuous ι AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology U) (Scheme.smallEtaleTopology Y)
  let R : wcEtPush j ⋙ ι.sheafPushforwardContinuous AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology U)
      (Scheme.smallEtaleTopology Y) ≅ 𝟭 _ :=
    Functor.isoWhiskerRight e _ ≪≫
    Functor.sheafPushforwardContinuousComp ι Φ AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology U)
      (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology U) ≪≫
    Functor.sheafPushforwardContinuousIso ε AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology U)
      (Scheme.smallEtaleTopology U) ≪≫
    Functor.sheafPushforwardContinuousId AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology U)
  let η : ιs ⋙ L ≅ 𝟭 _ := ((adjI.comp adj).ofNatIsoRight R).leftAdjointUniq Adjunction.id

  let r3 : ∀ T : U.Etale, (sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} ⋙
        (evaluation (Y.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj
        (Opposite.op (ι.obj T)) ⋙ forget AddCommGrpCat.{u+1}).CorepresentableBy
        (ιs.obj ((presheafToSheaf (Scheme.smallEtaleTopology U) AddCommGrpCat.{u+1}).obj
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) := fun T =>
    { homEquiv := fun {G} => (adjI.homEquiv _ G).trans (rep (Scheme.smallEtaleTopology U) T).homEquiv
      homEquiv_comp := fun {G G'} f k => by
        show (rep (Scheme.smallEtaleTopology U) T).homEquiv (adjI.homEquiv _ G' (k ≫ f)) = _
        rw [Adjunction.homEquiv_naturality_right, (rep (Scheme.smallEtaleTopology U) T).homEquiv_comp]
        rfl }
  let θ : ∀ T : U.Etale, ιs.obj ((presheafToSheaf (Scheme.smallEtaleTopology U) AddCommGrpCat.{u+1}).obj
        (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≅
      (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (yoneda.obj (ι.obj T) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) :=
    fun T => (r3 T).uniqueUpToIso (rep (Scheme.smallEtaleTopology Y) (ι.obj T))

  haveI := adjI.isLeftAdjoint
  haveI : ιs.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint ιs
  haveI : Limits.PreservesColimitsOfSize.{0, 0} ιs := adjI.leftAdjoint_preservesColimits
  haveI := Limits.preservesBinaryBiproducts_of_preservesBinaryCoproducts ιs
  haveI : ιs.Additive := Functor.additive_of_preservesBinaryBiproducts ιs

  let g'' := (θ V').inv ≫ ιs.map g ≫ (θ U').hom
  have hsq : ιs.map g ≫ (θ U').hom = (θ V').hom ≫ g'' := (Iso.hom_inv_id_assoc _ _).symm
  let E1 := Limits.PreservesCokernel.iso ιs g ≪≫
    Limits.cokernel.mapIso (ιs.map g) g'' (θ V') (θ U') hsq
  have htor'' : ℓ • 𝟙 (Limits.cokernel g'') = 0 := by
    calc ℓ • 𝟙 (Limits.cokernel g'') = E1.inv ≫ ιs.map (ℓ • 𝟙 (Limits.cokernel g)) ≫ E1.hom := by
          rw [Functor.map_nsmul, ιs.map_id, Preadditive.nsmul_comp, Category.id_comp,
            Preadditive.comp_nsmul, E1.inv_hom_id]
      _ = 0 := by rw [htor, ιs.map_zero, Limits.zero_comp, Limits.comp_zero]
  let E : L.obj (Limits.cokernel g'') ≅ Limits.cokernel g :=
    L.mapIso E1.symm ≪≫ η.app (Limits.cokernel g)
  exact ⟨ι.obj U', ι.obj V', g'', hU, hU', hV, hV', htor'', ⟨E⟩⟩

theorem wc_et_open_push_base_change : ∀ {Y U W : Scheme.{u}} (j : U ⟶ Y) [IsOpenImmersion j] (π : W ⟶ Y) (L : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology U) AddCommGrpCat.{u+1}) (L' : Sheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology (Limits.pullback π j)) AddCommGrpCat.{u+1}), Nonempty (L ⊣ wcEtPush j) → Nonempty (L' ⊣ wcEtPush (Limits.pullback.fst π j)) → ∀ (M : Sheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}), Nonempty (L.obj ((wcEtPush π).obj M) ≅ (wcEtPush (Limits.pullback.snd π j)).obj (L'.obj M)) :=
by
  intro Y U W j _ π L L' hL hL' M
  obtain ⟨a⟩ := hL
  obtain ⟨a'⟩ := hL'

  have hjs : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
      (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
    intro Y V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩

  have hSurj : ∀ (Y : Scheme.{u}) (V : Y.Etale) (R : Sieve V), R ∈ Scheme.smallEtaleTopology Y V →
      ∀ y : V.left, ∃ (V₁ : Y.Etale) (c : V₁ ⟶ V) (w : V₁.left), R.arrows c ∧ c.left w = y := by
    intro Y V R hR y
    change R ∈ Scheme.smallGrothendieckTopology @Etale Y V at hR
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
    obtain ⟨V₁, c, w, hc, -, hw⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V R).mp hR y
    exact ⟨V₁, c, w, hc, hw⟩

  have hcov : ∀ {X B : Scheme.{u}} (g : X ⟶ B), CoverPreserving (Scheme.smallEtaleTopology B)
      (Scheme.smallEtaleTopology X) (wcEtBaseChange g) := by
    intro X B g
    constructor
    intro V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale B V at hS
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
    have hS' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS
    apply hjs
    intro v
    obtain ⟨W, a, w, ha, -, hw⟩ := hS' (Limits.pullback.fst V.hom g v)
    refine ⟨(wcEtBaseChange g).obj W, (wcEtBaseChange g).map a,
      Sieve.image_mem_functorPushforward (wcEtBaseChange g) S ha, ?_⟩
    have h0 : (Limits.pullback.fst W.hom g ≫ a.left) ≫ V.hom = Limits.pullback.snd W.hom g ≫ g := by
      rw [Category.assoc, MorphismProperty.Over.w a]
      exact Limits.pullback.condition
    let m : Limits.pullback W.hom g ⟶ Limits.pullback V.hom g :=
      Limits.pullback.lift (Limits.pullback.fst W.hom g ≫ a.left) (Limits.pullback.snd W.hom g) h0
    have hmap : ((wcEtBaseChange g).map a).left = m := rfl
    have h1 : Limits.pullback.fst a.left (Limits.pullback.fst V.hom g) ≫ W.hom =
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) ≫ g := by
      rw [← MorphismProperty.Over.w a, ← Category.assoc, Limits.pullback.condition, Category.assoc,
        Limits.pullback.condition, Category.assoc]
    let ψ : Limits.pullback a.left (Limits.pullback.fst V.hom g) ⟶ Limits.pullback W.hom g :=
      Limits.pullback.lift (Limits.pullback.fst a.left (Limits.pullback.fst V.hom g))
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) h1
    have hψ : ψ ≫ m = Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, Limits.pullback.lift_fst,
          Limits.pullback.condition]
      · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
    obtain ⟨z, hz⟩ : ∃ z, Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) z = v := by
      have hv : (v : ↥(Limits.pullback V.hom g)) ∈
          Set.range (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g)) := by
        rw [Scheme.Pullback.range_snd]
        exact ⟨w, hw⟩
      exact hv
    rw [hmap]
    exact ⟨ψ z, (Scheme.Hom.comp_apply ψ m z).symm.trans (by rw [hψ]; exact hz)⟩
  have hBC : ∀ {X B : Scheme.{u}} (g : X ⟶ B), (wcEtBaseChange g).IsContinuous
      (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology X) := by
    intro X B g
    haveI h1 : Limits.PreservesFiniteLimits (wcEtBaseChange g) := ⟨fun J _ _ =>
      haveI : Limits.PreservesLimitsOfShape J (wcEtBaseChange g ⋙ Scheme.Etale.forget X) :=
        Limits.preservesLimitsOfShape_of_natIso
          (NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl) :
            Scheme.Etale.forget B ⋙ Over.pullback g ≅ wcEtBaseChange g ⋙ Scheme.Etale.forget X)
      Limits.preservesLimitsOfShape_of_reflects_of_preserves (wcEtBaseChange g) (Scheme.Etale.forget X)⟩
    haveI := flat_of_preservesFiniteLimits (wcEtBaseChange g)
    exact Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat _ _) (hcov g)

  have hSl : ∀ {S : Scheme.{u}} (T : S.Etale), (wcEtSlice T).IsContinuous
      (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology S) := by
    intro S T
    haveI hT : Etale T.hom := T.prop
    have hcovS : CoverPreserving (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology S)
        (wcEtSlice T) := by
      refine CoverPreserving.mk (fun {V} {R} hR => ?_)
      apply hjs
      intro v
      obtain ⟨V₁, c, w, hc, hw⟩ := hSurj T.left V R hR v
      exact ⟨(wcEtSlice T).obj V₁, (wcEtSlice T).map c, ⟨V₁, c, 𝟙 _, hc, (Category.id_comp _).symm⟩,
        ⟨w, hw⟩⟩
    have hcomp : CompatiblePreserving.{u+1} (Scheme.smallEtaleTopology S) (wcEtSlice T) := by
      apply CompatiblePreserving.mk
      intro ℱ Z T' x hx Y₁ Y₂ X f₁ f₂ g₁ g₂ hg₁ hg₂ hfg
      have hw : (f₁.left ≫ Y₁.hom) ≫ T.hom = X.hom :=
        (Category.assoc _ _ _).trans (MorphismProperty.Over.w f₁)
      haveI : Etale ((f₁.left ≫ Y₁.hom) ≫ T.hom) := hw ▸ X.prop
      haveI : Etale (f₁.left ≫ Y₁.hom) := Etale.of_comp _ T.hom
      let X' : T.left.Etale := MorphismProperty.Over.mk ⊤ (f₁.left ≫ Y₁.hom) ‹_›
      have hleft : f₁.left ≫ g₁.left = f₂.left ≫ g₂.left :=
        congrArg (fun k => k.left) hfg
      have h2 : f₂.left ≫ Y₂.hom = f₁.left ≫ Y₁.hom := by
        have e1 : Y₁.hom = g₁.left ≫ Z.hom := (MorphismProperty.Over.w g₁).symm
        have e2 : Y₂.hom = g₂.left ≫ Z.hom := (MorphismProperty.Over.w g₂).symm
        calc f₂.left ≫ Y₂.hom = (f₂.left ≫ g₂.left) ≫ Z.hom :=
              (congrArg (f₂.left ≫ ·) e2).trans (Category.assoc _ _ _).symm
          _ = (f₁.left ≫ g₁.left) ≫ Z.hom := congrArg (· ≫ Z.hom) hleft.symm
          _ = f₁.left ≫ Y₁.hom :=
              (Category.assoc _ _ _).trans (congrArg (f₁.left ≫ ·) e1.symm)
      let f₁' : X' ⟶ Y₁ := MorphismProperty.Over.homMk f₁.left rfl trivial
      let f₂' : X' ⟶ Y₂ := MorphismProperty.Over.homMk f₂.left h2 trivial
      let e : X ⟶ (wcEtSlice T).obj X' :=
        MorphismProperty.Over.homMk (𝟙 _) ((Category.id_comp _).trans hw) trivial
      have hf₁ : f₁ = e ≫ (wcEtSlice T).map f₁' := by
        apply MorphismProperty.Over.Hom.ext
        exact (Category.id_comp _).symm
      have hf₂ : f₂ = e ≫ (wcEtSlice T).map f₂' := by
        apply MorphismProperty.Over.Hom.ext
        exact (Category.id_comp _).symm
      have hsq : f₁' ≫ g₁ = f₂' ≫ g₂ := by
        apply MorphismProperty.Over.Hom.ext
        exact hleft
      have hc := hx f₁' f₂' hg₁ hg₂ hsq
      rw [hf₁, hf₂]
      simp only [Functor.map_comp, op_comp]
      rw [ConcreteCategory.comp_apply, ConcreteCategory.comp_apply]
      exact congrArg _ hc
    exact Functor.isContinuous_of_coverPreserving hcomp hcovS

  have epush : ∀ {X B : Scheme.{u}} (g : X ⟶ B)
      [(wcEtBaseChange g).IsContinuous (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology X)],
      wcEtPush g ≅ (wcEtBaseChange g).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology X) := by
    intro X B g _
    exact Functor.isoWhiskerRight ((wcEtBaseChange g).sheafPushforwardContinuousCompSheafToPresheafIso
        AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology X)).symm
        (presheafToSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) ≪≫
      Functor.associator _ _ _ ≪≫
      Functor.isoWhiskerLeft _ (asIso (sheafificationAdjunction (Scheme.smallEtaleTopology B)
        AddCommGrpCat.{u+1}).counit) ≪≫
      Functor.rightUnitor _

  have eLeft : ∀ {S : Scheme.{u}} (T : S.Etale)
      [c1 : (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology S)]
      [c2 : (wcEtBaseChange T.hom).IsContinuous (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology T.left)]
      (L₀ : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology T.left) AddCommGrpCat.{u+1})
      (a₀ : L₀ ⊣ wcEtPush T.hom),
      L₀ ≅ (wcEtSlice T).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology S) := by
    intro S T _ _ L₀ a₀
    letI : MorphismProperty.IsStableUnderComposition (@Etale : MorphismProperty Scheme.{u}) :=
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) T.hom :=
      ⟨fun _ _ => inferInstance⟩
    letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) T.hom :=
      (fun (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange] =>
        (inferInstance : P.IsStableUnderBaseChangeAlong T.hom)) (@Etale : MorphismProperty Scheme.{u})
    let adj : wcEtSlice T ⊣ wcEtBaseChange T.hom :=
      MorphismProperty.Over.mapPullbackAdj (@Etale : MorphismProperty Scheme.{u}) ⊤ T.hom T.prop trivial
    exact a₀.leftAdjointUniq ((adj.sheafPushforwardContinuous (E := AddCommGrpCat.{u+1})
