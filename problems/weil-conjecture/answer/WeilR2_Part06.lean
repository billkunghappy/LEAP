      (by rw [Scheme.Hom.id_preimage])
    have hfin' := MorphismProperty.of_isPullback (P := @IsFinite) hpb hfin
    have hgc : Continuous (fun y : ((V ⊓ f ⁻¹ᵁ U' : X.Opens) : Scheme.{u}) =>
        (⟨y.1, y.2.1⟩ : ↥V)) := continuous_subtype_val.subtype_mk _
    have hrange : Set.range (X.homOfLE hWV') =
        (fun y : ((V ⊓ f ⁻¹ᵁ U' : X.Opens) : Scheme.{u}) => (⟨y.1, y.2.1⟩ : ↥V)) ⁻¹' C := by
      ext y
      simp only [Set.mem_preimage, Set.mem_range]
      constructor
      · rintro ⟨w, hw⟩
        have hy : y.1 = w.1 :=
          (congrArg Subtype.val hw).symm.trans (Scheme.homOfLE_apply hWV' w)
        have hwW : w.1 ∈ (W : Set X) := w.2
        rw [hW] at hwW
        obtain ⟨⟨c, hcC, hc⟩, _⟩ := hwW
        have hc' : c = ⟨y.1, y.2.1⟩ := Subtype.ext (hc.trans hy.symm)
        exact hc' ▸ hcC
      · intro hyC
        have hyW : y.1 ∈ (W : Set X) := by
          rw [hW]
          exact ⟨⟨⟨y.1, y.2.1⟩, hyC, rfl⟩, y.2.2⟩
        exact ⟨⟨y.1, hyW⟩, Subtype.ext (Scheme.homOfLE_apply _ _)⟩
    haveI : IsClosedImmersion (X.homOfLE hWV') :=
      IsClosedImmersion.of_isPreimmersion _
        (by rw [hrange]; exact hC.preimage hgc)
    have hfac : f.resLE U' W e' = X.homOfLE hWV' ≫ f.resLE U' (V ⊓ f ⁻¹ᵁ U') inf_le_right := by
      simp [Scheme.Hom.resLE]
    rw [hfac]
    haveI := hfin'
    infer_instance

  intro K _ B fB _ V₀ v hgen
  haveI hB : IsLocallyNoetherian B := LocallyOfFiniteType.isLocallyNoetherian fB
  haveI hX : IsLocallyNoetherian V₀.left := by
    haveI : IsLocallyNoetherian ((Functor.fromPUnit B).obj V₀.right) := hB
    exact LocallyOfFiniteType.isLocallyNoetherian V₀.hom
  obtain ⟨OY₁, W₁, e₁, hv₁, hOY₁, hW₁, hπ₁⟩ :=
    wc_r2gs_etale_finite_near_generic B V₀.left V₀.hom v hgen
  haveI : IsAffine (W₁ : Scheme.{u}) := hW₁
  haveI : IsNoetherian (W₁ : Scheme.{u}) := ⟨⟩
  have hpt : ∀ x : (W₁ : Scheme.{u}),
      (V₀.hom.resLE OY₁ W₁ e₁ x).1 = V₀.hom x.1 := by
    intro x
    have h := Scheme.Hom.resLE_comp_ι V₀.hom e₁
    have h2 : (V₀.hom.resLE OY₁ W₁ e₁ ≫ OY₁.ι) x = (W₁.ι ≫ V₀.hom) x := by rw [h]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h2
    exact h2
  have hiso : ∀ x y : (W₁ : Scheme.{u}), V₀.hom.resLE OY₁ W₁ e₁ x =
      V₀.hom.resLE OY₁ W₁ e₁ ⟨v, hv₁⟩ → y ⤳ x → y = x := by
    intro x y hx hyx
    have hφx : V₀.hom x.1 = V₀.hom v :=
      (hpt x).symm.trans ((congrArg Subtype.val hx).trans (hpt ⟨v, hv₁⟩))
    have hyx' : W₁.ι y ⤳ W₁.ι x := hyx.map W₁.ι.continuous
    have hφy : V₀.hom y.1 = V₀.hom v := hgen _ (hφx ▸ hyx'.map V₀.hom.continuous)
    obtain ⟨U, hxU, hU⟩ := wc_etale_fibre_point_isolated V₀.hom x.1
    have hyU : y.1 ∈ U := hyx'.mem_open U.isOpen hxU
    exact Subtype.ext (hU _ hyU (hφy.trans hφx.symm))
  obtain ⟨O, F, G, hO, hvO, hFc, hFirr, hGc, hvF, hvG, hFG⟩ :=
    c3 (W₁ : Scheme.{u}) (OY₁ : Scheme.{u}) (V₀.hom.resLE OY₁ W₁ e₁)
      (V₀.hom.resLE OY₁ W₁ e₁).isClosedMap ⟨v, hv₁⟩ hiso
  have hηOY₂ : V₀.hom v ∈ OY₁.ι ''ᵁ (⟨O, hO⟩ : (OY₁ : Scheme.{u}).Opens) := by
    rw [← hpt ⟨v, hv₁⟩]
    exact ⟨_, hvO, rfl⟩
  obtain ⟨r, hrle, hηr⟩ := hOY₁.exists_basicOpen_le
    (V := OY₁.ι ''ᵁ (⟨O, hO⟩ : (OY₁ : Scheme.{u}).Opens)) ⟨V₀.hom v, hηOY₂⟩
    (by show V₀.hom v ∈ OY₁; rw [← hpt ⟨v, hv₁⟩]; exact (V₀.hom.resLE OY₁ W₁ e₁ ⟨v, hv₁⟩).2)
  have hOYO : ∀ x : (W₁ : Scheme.{u}), V₀.hom x.1 ∈ B.basicOpen r →
      V₀.hom.resLE OY₁ W₁ e₁ x ∈ O := by
    intro x hx
    have h1 : V₀.hom x.1 ∈ OY₁.ι '' O := hrle hx
    obtain ⟨o, ho, hoeq⟩ := h1
    have : o = V₀.hom.resLE OY₁ W₁ e₁ x := Subtype.ext (hoeq.trans (hpt x).symm)
    rw [← this]
    exact ho
  let W : V₀.left.Opens := W₁.ι ''ᵁ (⟨Gᶜ, hGc.isOpen_compl⟩ : (W₁ : Scheme.{u}).Opens) ⊓
    V₀.hom ⁻¹ᵁ (B.basicOpen r)
  have hWset : (W : Set V₀.left) = W₁.ι '' F ∩ V₀.hom ⁻¹' (B.basicOpen r : Set B) := by
    ext z
    constructor
    · rintro ⟨⟨x, hxG, rfl⟩, hz⟩
