        refine ⟨Opposite.op j, ⟨StructuredArrow.homMk g ?_⟩⟩
        apply Over.OverMorphism.ext
        show Spec.map (CommRingCat.ofHom (ρ.comp (β j).hom)) ≫ Spec.map (CommRingCat.ofHom α) ≫ w =
          d.hom.left
        have hc : (ρ.comp (β j).hom).comp α = γ₀ := by
          rw [RingHom.comp_assoc, hβα, hργ]
        rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hc, hγw]
      ·
        intro d c s₁ s₂
        have hff : s₁.right.left ≫ d.right.hom = s₂.right.left ≫ d.right.hom :=
          (MorphismProperty.Over.w s₁.right).trans (MorphismProperty.Over.w s₂.right).symm
        have e1 : Spec.map (CommRingCat.ofHom (ρ.comp (β c.unop).hom)) ≫ s₁.right.left =
            d.hom.left :=
          congrArg (fun k => k.left) (StructuredArrow.w s₁)
        have e2 : Spec.map (CommRingCat.ofHom (ρ.comp (β c.unop).hom)) ≫ s₂.right.left =
            d.hom.left :=
          congrArg (fun k => k.left) (StructuredArrow.w s₂)
        obtain ⟨g, hg0, hgeq⟩ :=
          hAGREE c.unop d.right s₁.right.left s₂.right.left hff (e1.trans e2.symm)
        have hu : IsUnit ((β c.unop).hom g) := isUnit_of_map_unit ρ _ (isUnit_iff_ne_zero.mpr hg0)
        letI : Algebra Γ(B, U) (D.obj c.unop) := (s c.unop).toAlgebra
        haveI : Algebra.Etale Γ(B, U) (D.obj c.unop) := RingHom.etale_algebraMap.mp (hs c.unop)
        haveI : Algebra.FinitePresentation Γ(B, U) (Localization.Away g) :=
          Algebra.FinitePresentation.trans Γ(B, U) (D.obj c.unop) (Localization.Away g)
        have hβ' : (IsLocalization.Away.lift g hu).comp
            (algebraMap Γ(B, U) (Localization.Away g)) = σ := by
          rw [IsScalarTower.algebraMap_eq Γ(B, U) (D.obj c.unop) (Localization.Away g),
            ← RingHom.comp_assoc, IsLocalization.Away.lift_comp]
          exact hβs c.unop
        obtain ⟨j'', α, hα1, hα2⟩ := hFPL (Localization.Away g) inferInstance _ hβ'
        have hf1 : (α.comp (algebraMap (D.obj c.unop) (Localization.Away g))).comp (s c.unop) =
            s j'' := by
          rw [RingHom.comp_assoc]
          rw [← hα1, IsScalarTower.algebraMap_eq Γ(B, U) (D.obj c.unop) (Localization.Away g)]
          rfl
        have hf2 : (β j'').hom.comp (α.comp (algebraMap (D.obj c.unop) (Localization.Away g))) =
            (β c.unop).hom := by
          rw [← RingHom.comp_assoc, hα2, IsLocalization.Away.lift_comp]
        obtain ⟨u, hu'⟩ := hFULL c.unop j'' _ hf1 hf2
        refine ⟨Opposite.op j'', (u.op : Opposite.op j'' ⟶ c), ?_⟩
        apply StructuredArrow.hom_ext
        apply MorphismProperty.Over.Hom.ext
        show Spec.map (D.map u) ≫ s₁.right.left = Spec.map (D.map u) ≫ s₂.right.left
        have hD : D.map u = CommRingCat.ofHom (algebraMap (D.obj c.unop) (Localization.Away g)) ≫
            CommRingCat.ofHom α := by
          rw [← CommRingCat.ofHom_comp, ← hu', CommRingCat.ofHom_hom]
        rw [hD, Spec.map_comp]
        exact (Category.assoc _ _ _).trans
          ((congrArg (fun k => Spec.map (CommRingCat.ofHom α) ≫ k) hgeq).trans
            (Category.assoc _ _ _).symm)
    · intro l
      show IsAffine (Spec (D.obj l.unop))
      infer_instance
    · intro l l' t
      show Spec.map (β l.unop) ≫ Spec.map (D.map t.unop) = Spec.map (β l'.unop)
      rw [← Spec.map_comp, hDβ]
    · intro l
      show Spec.map (β l.unop) ≫ Spec.map (S l.unop) ≫ hU.fromSpec =
        Spec.map (CommRingCat.ofHom σ) ≫ hU.fromSpec
      rw [← Category.assoc, ← Spec.map_comp, hSβ]
    · intro T z hz
      obtain ⟨z₀, hz₀, hu⟩ := hLIM T (fun j => z (Opposite.op j)) (fun {j j'} t => hz t.op)
      exact ⟨z₀, fun l => hz₀ l.unop, fun w hw => hu w (fun j => hw (Opposite.op j))⟩
    ·
      intro l
      show Spec.map (CommRingCat.ofHom ρ) ≫ Spec.map (β l.unop) =
        Spec.map (CommRingCat.ofHom (ρ.comp (β l.unop).hom))
      rw [CommRingCat.ofHom_comp, CommRingCat.ofHom_hom, Spec.map_comp]

  intro B b
  obtain ⟨U, hU, hb, -⟩ := exists_isAffineOpen_mem_and_subset (X := B) (x := b) (U := ⊤) trivial
  let τ : Γ(B, U) →+* AlgebraicClosure (B.residueField b) :=
    (algebraMap (B.residueField b) (AlgebraicClosure (B.residueField b))).comp
      (B.presheaf.germ U b hb ≫ B.residue b).hom

  have hp : Spec.map (CommRingCat.ofHom τ) ≫ hU.fromSpec = wcEtGeomPt B b := by
    have h1 : B.fromSpecResidueField b =
        Spec.map (B.residue b) ≫ Spec.map (B.presheaf.germ U b hb) ≫ hU.fromSpec := by
      rw [Scheme.fromSpecResidueField, ← hU.fromSpecStalk_eq_fromSpecStalk hb,
        IsAffineOpen.fromSpecStalk]
    show Spec.map (CommRingCat.ofHom ((algebraMap (B.residueField b)
        (AlgebraicClosure (B.residueField b))).comp (B.presheaf.germ U b hb ≫ B.residue b).hom)) ≫
        hU.fromSpec = Spec.map (CommRingCat.ofHom (algebraMap (B.residueField b)
          (AlgebraicClosure (B.residueField b)))) ≫ B.fromSpecResidueField b
    rw [h1, CommRingCat.ofHom_comp, Spec.map_comp, CommRingCat.ofHom_hom, Spec.map_comp]
    simp only [Category.assoc]
  have hsep : IsSepClosed (IsLocalRing.ResidueField (AlgebraicClosure (B.residueField b))) := by
    haveI := IsAlgClosed.of_ringEquiv (AlgebraicClosure (B.residueField b))
      (IsLocalRing.ResidueField (AlgebraicClosure (B.residueField b)))
      (RingEquiv.ofBijective (IsLocalRing.residue (AlgebraicClosure (B.residueField b)))
        ⟨RingHom.injective _, IsLocalRing.residue_surjective⟩)
    infer_instance
  obtain ⟨A, _, σ, ρ, hAloc, hρσ₀, hAh, hAsep, hρloc, hind⟩ :=
    @wc_strict_hull Γ(B, U) (AlgebraicClosure (B.residueField b)) _ _ τ.toAlgebra _ hsep
  have hρσ : ρ.comp σ = τ := hρσ₀
  obtain ⟨J, _, _, D, s, β, hs, hsD, hDβ, hβs, hsurj, hinj, hFPL, hFULL⟩ := sInd _ A σ hind
  have hLIM := sLim A J D β hDβ hsurj hinj
  have hHLIFT : ∀ (C : Type u) [CommRing C] [Algebra Γ(B, U) C], Algebra.Etale Γ(B, U) C →
      ∀ γ₀ : C →+* AlgebraicClosure (B.residueField b), γ₀.comp (algebraMap Γ(B, U) C) = τ →
      ∃ γ : C →+* A, γ.comp (algebraMap Γ(B, U) C) = σ ∧ ρ.comp γ = γ₀ := by
    intro C _ _ hC γ₀ h
    exact sLift _ A _ σ ρ (sRet A)
      (sRat (IsLocalRing.ResidueField A) _ (IsLocalRing.ResidueField.lift ρ)) C hC γ₀
      (h.trans hρσ.symm)
  have hCHART : ∀ (V : B.Etale) (t : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ V.left),
      t ≫ V.hom = wcEtGeomPt B b → ∃ (C : Type u) (_ : CommRing C) (_ : Algebra Γ(B, U) C)
      (γ₀ : C →+* AlgebraicClosure (B.residueField b)) (w : Spec (.of C) ⟶ V.left),
      Algebra.Etale Γ(B, U) C ∧ γ₀.comp (algebraMap Γ(B, U) C) = τ ∧
      Spec.map (CommRingCat.ofHom γ₀) ≫ w = t ∧
      w ≫ V.hom = Spec.map (CommRingCat.ofHom (algebraMap Γ(B, U) C)) ≫ hU.fromSpec :=
    fun V t ht => sChart U hU V _ t τ (ht.trans hp.symm)
  have hAGREE : ∀ (j : J) (V : B.Etale) (f f' : Spec (D.obj j) ⟶ V.left),
      f ≫ V.hom = f' ≫ V.hom →
      Spec.map (CommRingCat.ofHom (ρ.comp (β j).hom)) ≫ f =
        Spec.map (CommRingCat.ofHom (ρ.comp (β j).hom)) ≫ f' →
      ∃ g : D.obj j, ρ ((β j).hom g) ≠ 0 ∧
        Spec.map (CommRingCat.ofHom (algebraMap (D.obj j) (Localization.Away g))) ≫ f =
        Spec.map (CommRingCat.ofHom (algebraMap (D.obj j) (Localization.Away g))) ≫ f' := by
    intro j V f f' hff h
    haveI : Etale V.hom := V.prop
    obtain ⟨O, hO, hOf⟩ := wc_etale_maps_agree_near_geom_point V.hom f f' hff _
      (Spec.map (CommRingCat.ofHom (ρ.comp (β j).hom))) h
    exact sBasic (D.obj j) _ (ρ.comp (β j).hom) f f' O hO hOf
  obtain ⟨W', φ, hinit, haff, hφ, hφa, hlim, hWρ⟩ :=
    sPkg U hU _ τ (wcEtGeomPt B b) hp A σ ρ hρloc hρσ J D s β hs hsD hDβ hβs hLIM hFPL hFULL
      hHLIFT hCHART hAGREE
  haveI : IsCofiltered Jᵒᵖ := isCofiltered_op_of_isFiltered J
  have hsr : Spec.map (CommRingCat.ofHom (IsLocalRing.ResidueField.lift ρ)) ≫
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) = Spec.map (CommRingCat.ofHom ρ) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, IsLocalRing.ResidueField.lift_comp_residue]
  refine ⟨A, inferInstance, hAh, hAsep, Jᵒᵖ, inferInstance, inferInstance, W', φ,
    Spec.map (CommRingCat.ofHom σ) ≫ hU.fromSpec, IsLocalRing.ResidueField.lift ρ,
    hinit, haff, hφ, hφa, hlim, ?_, ?_, ?_⟩
  · exact sInt _ A (B.residueField b) _ σ ρ (B.presheaf.germ U b hb ≫ B.residue b).hom hρσ
      (sFrac U hU b hb)
  · have hc : (IsLocalRing.ResidueField.lift ρ).comp ((IsLocalRing.residue A).comp σ) = τ := by
      rw [← RingHom.comp_assoc, IsLocalRing.ResidueField.lift_comp_residue, hρσ]
    rw [← hp, ← hc, CommRingCat.ofHom_comp, CommRingCat.ofHom_comp, Spec.map_comp, Spec.map_comp]
    simp only [Category.assoc]
  · intro l
    exact (Category.assoc _ _ _).symm.trans ((congrArg (· ≫ φ l) hsr).trans (hWρ l))

theorem wc_ext_colim_compare_effaceable : ∀ {C : Type*} [Category C] [Abelian C] [HasExt C] [EnoughInjectives C] {D : Type*} [Category D] [Abelian D] [HasExt D] (L : C ⥤ D) [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L] (Λ : Type*) [Category Λ] (P : Λ → C) (Pm : ∀ {l l' : Λ}, (l' ⟶ l) → (P l' ⟶ P l)) (Q : D) (ε : ∀ l, Q ⟶ L.obj (P l)), (∀ (F : C) (y : Q ⟶ L.obj F), ∃ (l : Λ) (x : P l ⟶ F), ε l ≫ L.map x = y) → (∀ (I K : C) (k : I ⟶ K) (l : Λ) (x : P l ⟶ K) (z : Q ⟶ L.obj I), ε l ≫ L.map x = z ≫ L.map k → ∃ (l' : Λ) (t : l' ⟶ l) (w : P l' ⟶ I), Pm t ≫ x = w ≫ k) → (∀ (I : C) [Injective I] (n : ℕ) (e : Abelian.Ext Q (L.obj I) (n + 1)), e = 0) → ∀ (F : C) (q : ℕ), (∀ y : Abelian.Ext Q (L.obj F) q, ∃ (l : Λ) (x : Abelian.Ext (P l) F q), (Abelian.Ext.mk₀ (ε l)).comp (Abelian.Ext.mapExactFunctor L x) (zero_add q) = y) ∧ (∀ (l : Λ) (x : Abelian.Ext (P l) F q), (Abelian.Ext.mk₀ (ε l)).comp (Abelian.Ext.mapExactFunctor L x) (zero_add q) = 0 → ∃ (l' : Λ) (t : l' ⟶ l), (Abelian.Ext.mk₀ (Pm t)).comp x (zero_add q) = 0) :=
by
  intro C _ _ _ _ D _ _ _ L _ _ _ Λ _ P Pm Q ε H0S H0K Hacyc
  have hcomp : ∀ {l : Λ} {Z W : C} {a b c : ℕ} (w : Abelian.Ext (P l) Z a)
      (γ : Abelian.Ext Z W b) (h : a + b = c),
      (Abelian.Ext.mk₀ (ε l)).comp (Abelian.Ext.mapExactFunctor L (w.comp γ h)) (zero_add c) =
        ((Abelian.Ext.mk₀ (ε l)).comp (Abelian.Ext.mapExactFunctor L w) (zero_add a)).comp
          (Abelian.Ext.mapExactFunctor L γ) h := by
    intro l Z W a b c w γ h
    rw [Abelian.Ext.mapExactFunctor_comp]
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add a) h (by omega)).symm
  have hmk : ∀ {l : Λ} {Z : C} (f : P l ⟶ Z),
      (Abelian.Ext.mk₀ (ε l)).comp (Abelian.Ext.mapExactFunctor L (Abelian.Ext.mk₀ f))
        (zero_add 0) = Abelian.Ext.mk₀ (ε l ≫ L.map f) := by
    intro l Z f
    rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀]
  have key : ∀ (q : ℕ) (F : C),
      (∀ y : Abelian.Ext Q (L.obj F) q, ∃ (l : Λ) (x : Abelian.Ext (P l) F q),
        (Abelian.Ext.mk₀ (ε l)).comp (Abelian.Ext.mapExactFunctor L x) (zero_add q) = y) ∧
      (∀ (l : Λ) (x : Abelian.Ext (P l) F q),
        (Abelian.Ext.mk₀ (ε l)).comp (Abelian.Ext.mapExactFunctor L x) (zero_add q) = 0 →
        ∃ (l' : Λ) (t : l' ⟶ l), (Abelian.Ext.mk₀ (Pm t)).comp x (zero_add q) = 0) := by
    intro q
    induction q with
    | zero =>
      intro F
      constructor
      · intro y
        obtain ⟨l, x₀, hx⟩ := H0S F (Abelian.Ext.homEquiv₀ y)
        refine ⟨l, Abelian.Ext.mk₀ x₀, ?_⟩
        rw [hmk, hx, Abelian.Ext.mk₀_homEquiv₀_apply]
      · intro l x hx
        obtain ⟨x₀, rfl⟩ : ∃ x₀, Abelian.Ext.mk₀ x₀ = x :=
          ⟨_, Abelian.Ext.mk₀_homEquiv₀_apply x⟩
        rw [hmk] at hx
        have h0 : ε l ≫ L.map x₀ = 0 := (Abelian.Ext.mk₀_eq_zero_iff _).1 hx
        obtain ⟨l', t, w, hw⟩ := H0K F F 0 l x₀ 0 (by rw [h0, Limits.zero_comp])
        refine ⟨l', t, ?_⟩
        rw [Abelian.Ext.mk₀_comp_mk₀, hw, Limits.comp_zero, Abelian.Ext.mk₀_zero]
    | succ q ih =>
      intro F
      let i := Injective.ι F
      let S : ShortComplex C :=
        ShortComplex.mk i (Limits.cokernel.π i) (Limits.cokernel.condition i)
      have hS : S.ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel i) inferInstance inferInstance
      have hLS : (S.map L).ShortExact := hS.map_of_exact L
      haveI : Injective S.X₂ := (inferInstance : Injective (Injective.under F))
      have bridge : ∀ {l : Λ} (w : Abelian.Ext (P l) S.X₃ q),
          (Abelian.Ext.mk₀ (ε l)).comp
            (Abelian.Ext.mapExactFunctor L (w.comp hS.extClass rfl)) (zero_add (q + 1)) =
          ((Abelian.Ext.mk₀ (ε l)).comp (Abelian.Ext.mapExactFunctor L w) (zero_add q)).comp
            hLS.extClass rfl := by
        intro l w
        rw [hcomp, Abelian.Ext.mapExactFunctor_extClass]
      constructor
      · intro y
        have h0 : y.comp (Abelian.Ext.mk₀ (S.map L).f) (add_zero _) = 0 :=
          Hacyc (Injective.under F) q _
        obtain ⟨y₃, hy₃⟩ := Abelian.Ext.covariant_sequence_exact₁ Q hLS y h0 (n₀ := q) rfl
        obtain ⟨l, x₃, hx₃⟩ := (ih S.X₃).1 y₃
        refine ⟨l, x₃.comp hS.extClass rfl, ?_⟩
        rw [bridge, hx₃, hy₃]
      · intro l x hx
        have h0 : x.comp (Abelian.Ext.mk₀ S.f) (add_zero _) = 0 :=
          Abelian.Ext.eq_zero_of_injective _
        obtain ⟨x₃, rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ (P l) hS x h0 (n₀ := q) rfl
        rw [bridge] at hx
        obtain ⟨z, hz⟩ := Abelian.Ext.covariant_sequence_exact₃ Q hLS _ rfl hx
        have hassoc : ∀ {l' : Λ} (t : l' ⟶ l),
            (Abelian.Ext.mk₀ (Pm t)).comp (x₃.comp hS.extClass rfl) (zero_add (q + 1)) =
              ((Abelian.Ext.mk₀ (Pm t)).comp x₃ (zero_add q)).comp hS.extClass rfl :=
          fun t => (Abelian.Ext.comp_assoc _ _ _ (zero_add q) rfl (by omega)).symm
        cases q with
        | zero =>
          obtain ⟨z₀, rfl⟩ : ∃ z₀, Abelian.Ext.mk₀ z₀ = z :=
            ⟨_, Abelian.Ext.mk₀_homEquiv₀_apply z⟩
          obtain ⟨x₀, rfl⟩ : ∃ x₀, Abelian.Ext.mk₀ x₀ = x₃ :=
            ⟨_, Abelian.Ext.mk₀_homEquiv₀_apply x₃⟩
          rw [Abelian.Ext.mk₀_comp_mk₀, hmk] at hz
          have hz' := (Abelian.Ext.mk₀_bijective _ _).1 hz
          obtain ⟨l', t, w, hw⟩ := H0K S.X₂ S.X₃ S.g l x₀ z₀ hz'.symm
          refine ⟨l', t, ?_⟩
          rw [hassoc, Abelian.Ext.mk₀_comp_mk₀, hw, ← Abelian.Ext.mk₀_comp_mk₀,
            Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add 1) (by omega),
            hS.comp_extClass, Abelian.Ext.comp_zero]
        | succ m =>
          have hz0 : z = 0 := Hacyc (Injective.under F) m z
          rw [hz0, Abelian.Ext.zero_comp] at hz
          obtain ⟨l', t, ht⟩ := (ih S.X₃).2 l x₃ hz.symm
          exact ⟨l', t, by rw [hassoc, ht, Abelian.Ext.zero_comp]⟩
  intro F q
  exact key q F

theorem wc_et_basechange_isContinuous : ∀ {X B : Scheme.{u}} (g : X ⟶ B), (wcEtBaseChange g).IsContinuous (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology X) :=
by
  have hjs : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
      (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
    intro Y V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩
  have hcov : ∀ {X B : Scheme.{u}} (g : X ⟶ B), CoverPreserving (Scheme.smallEtaleTopology B)
      (Scheme.smallEtaleTopology X) (wcEtBaseChange g) := by
    intro X B g
    constructor
    intro V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale B V at hS
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
    have hS' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS
    apply hjs
    intro v
    obtain ⟨W, a, w, ha, -, hw⟩ := hS' (Limits.pullback.fst V.hom g v)
    refine ⟨(wcEtBaseChange g).obj W, (wcEtBaseChange g).map a,
      Sieve.image_mem_functorPushforward (wcEtBaseChange g) S ha, ?_⟩
    have h0 : (Limits.pullback.fst W.hom g ≫ a.left) ≫ V.hom = Limits.pullback.snd W.hom g ≫ g := by
      rw [Category.assoc, MorphismProperty.Over.w a]
      exact Limits.pullback.condition
    let m : Limits.pullback W.hom g ⟶ Limits.pullback V.hom g :=
      Limits.pullback.lift (Limits.pullback.fst W.hom g ≫ a.left) (Limits.pullback.snd W.hom g) h0
    have hmap : ((wcEtBaseChange g).map a).left = m := rfl
    have h1 : Limits.pullback.fst a.left (Limits.pullback.fst V.hom g) ≫ W.hom =
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) ≫ g := by
      rw [← MorphismProperty.Over.w a, ← Category.assoc, Limits.pullback.condition, Category.assoc,
        Limits.pullback.condition, Category.assoc]
    let ψ : Limits.pullback a.left (Limits.pullback.fst V.hom g) ⟶ Limits.pullback W.hom g :=
      Limits.pullback.lift (Limits.pullback.fst a.left (Limits.pullback.fst V.hom g))
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) h1
    have hψ : ψ ≫ m = Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, Limits.pullback.lift_fst,
          Limits.pullback.condition]
      · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
    obtain ⟨z, hz⟩ : ∃ z, Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) z = v := by
      have hv : (v : ↥(Limits.pullback V.hom g)) ∈
          Set.range (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g)) := by
        rw [Scheme.Pullback.range_snd]
        exact ⟨w, hw⟩
      exact hv
    rw [hmap]
    exact ⟨ψ z, (Scheme.Hom.comp_apply ψ m z).symm.trans (by rw [hψ]; exact hz)⟩
  intro X B g
  let Φ := wcEtBaseChange g
  haveI h1 : Limits.PreservesFiniteLimits Φ := ⟨fun J _ _ =>
    haveI : Limits.PreservesLimitsOfShape J (wcEtBaseChange g ⋙ Scheme.Etale.forget X) :=
      Limits.preservesLimitsOfShape_of_natIso
        (NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl) :
          Scheme.Etale.forget B ⋙ Over.pullback g ≅ wcEtBaseChange g ⋙ Scheme.Etale.forget X)
    Limits.preservesLimitsOfShape_of_reflects_of_preserves (wcEtBaseChange g) (Scheme.Etale.forget X)⟩
  haveI := flat_of_preservesFiniteLimits Φ
  exact Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat _ _) (hcov g)

theorem wc_et_const_hom_eval_bij : ∀ (Y : Scheme.{u}) (M : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}), Function.Bijective (fun g : (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ M => (g.hom.app (Opposite.op (wcEtTop Y))).hom (wcConstSec Y (ULift.{u+1} ℤ) (wcEtTop Y) (ULift.up 1))) :=
by
  intro Y M
  have hT : Limits.IsTerminal (wcEtTop Y) :=
    @MorphismProperty.Over.mkIdTerminal Scheme _ @AlgebraicGeometry.Etale Y
      MorphismProperty.IsMultiplicative.toContainsIdentities
  let adj := constantSheafAdj (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} hT
  let ev : ∀ X : AddCommGrpCat.{u+1}, (AddCommGrpCat.of (ULift.{u+1} ℤ) ⟶ X) ≃ X := fun X =>
    { toFun := fun φ => φ.hom (ULift.up 1)
      invFun := fun x => AddCommGrpCat.ofHom
        ((zmultiplesHom X x).comp (AddEquiv.ulift : ULift.{u+1} ℤ ≃+ ℤ).toAddMonoidHom)
      left_inv := fun φ => by
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        rintro ⟨n⟩
        have hn : (ULift.up n : ULift.{u+1} ℤ) = n • (ULift.up 1 : ULift.{u+1} ℤ) := by
          apply ULift.ext
          simp
        change (zmultiplesHom X (φ.hom (ULift.up 1))) n = φ.hom (ULift.up n)
        rw [zmultiplesHom_apply, hn, map_zsmul]
      right_inv := fun x => by
        change (zmultiplesHom X x) (1 : ℤ) = x
        rw [zmultiplesHom_apply, one_zsmul] }
  have key : (fun g : (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ M =>
        (g.hom.app (Opposite.op (wcEtTop Y))).hom
          (wcConstSec Y (ULift.{u+1} ℤ) (wcEtTop Y) (ULift.up 1))) =
      ⇑((adj.homEquiv (AddCommGrpCat.of (ULift.{u+1} ℤ)) M).trans
        (ev (M.obj.obj (Opposite.op (wcEtTop Y))))) := by
    funext g
    rfl
  rw [key]
  exact Equiv.bijective _

theorem wc_r2gs_basechange_lift_cone_limit : ∀ {X B : Scheme.{u}} (g : X ⟶ B) (A : Type u) [CommRing A] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W : Λ ⥤ B.Etale) (φ : ∀ l, Spec (.of A) ⟶ (W.obj l).left) (a : Spec (.of A) ⟶ B), (∀ l, φ l ≫ (W.obj l).hom = a) → (∀ {l l' : Λ} (t : l ⟶ l'), φ l ≫ (W.map t).left = φ l') → (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (W.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (W.map t).left = z l') → ∃! z₀ : T ⟶ Spec (.of A), ∀ l, z₀ ≫ φ l = z l) → ∀ (π : ∀ l, Limits.pullback g a ⟶ Limits.pullback (W.obj l).hom g), (∀ l, π l ≫ Limits.pullback.fst (W.obj l).hom g = Limits.pullback.snd g a ≫ φ l) → (∀ l, π l ≫ Limits.pullback.snd (W.obj l).hom g = Limits.pullback.fst g a) → (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ ((W ⋙ wcEtBaseChange g).map t).left = π l') ∧ (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ ((W ⋙ wcEtBaseChange g).obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ ((W ⋙ wcEtBaseChange g).map t).left = z l') → ∃! z₀ : T ⟶ Limits.pullback g a, ∀ l, z₀ ≫ π l = z l) :=
by
  intro X B g A _ Λ _ _ W φ a hφa hφ hlim π P1 P2
  have M1 : ∀ {l l' : Λ} (t : l ⟶ l'),
      ((W ⋙ wcEtBaseChange g).map t).left ≫ Limits.pullback.fst (W.obj l').hom g =
        Limits.pullback.fst (W.obj l).hom g ≫ (W.map t).left := by
    intro l l' t
    exact Limits.pullback.lift_fst _ _ _
  have M2 : ∀ {l l' : Λ} (t : l ⟶ l'),
      ((W ⋙ wcEtBaseChange g).map t).left ≫ Limits.pullback.snd (W.obj l').hom g =
        Limits.pullback.snd (W.obj l).hom g := by
    intro l l' t
    exact Limits.pullback.lift_snd _ _ _
  have C2 : ∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ ((W ⋙ wcEtBaseChange g).map t).left = π l' := by
    intro l l' t
    refine Limits.pullback.hom_ext (f := (W.obj l').hom) (g := g) ?_ ?_
    · calc (π l ≫ ((W ⋙ wcEtBaseChange g).map t).left) ≫ Limits.pullback.fst (W.obj l').hom g
          = π l ≫ (((W ⋙ wcEtBaseChange g).map t).left ≫
              Limits.pullback.fst (W.obj l').hom g) := Category.assoc _ _ _
        _ = π l ≫ (Limits.pullback.fst (W.obj l).hom g ≫ (W.map t).left) := whisker_eq _ (M1 t)
        _ = (π l ≫ Limits.pullback.fst (W.obj l).hom g) ≫ (W.map t).left :=
            (Category.assoc _ _ _).symm
        _ = (Limits.pullback.snd g a ≫ φ l) ≫ (W.map t).left := eq_whisker (P1 l) _
        _ = Limits.pullback.snd g a ≫ φ l' := by rw [Category.assoc, hφ t]
        _ = π l' ≫ Limits.pullback.fst (W.obj l').hom g := (P1 l').symm
    · calc (π l ≫ ((W ⋙ wcEtBaseChange g).map t).left) ≫ Limits.pullback.snd (W.obj l').hom g
          = π l ≫ (((W ⋙ wcEtBaseChange g).map t).left ≫
              Limits.pullback.snd (W.obj l').hom g) := Category.assoc _ _ _
        _ = π l ≫ Limits.pullback.snd (W.obj l).hom g := whisker_eq _ (M2 t)
        _ = Limits.pullback.fst g a := P2 l
        _ = π l' ≫ Limits.pullback.snd (W.obj l').hom g := (P2 l').symm
  have C3 : ∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ ((W ⋙ wcEtBaseChange g).obj l).left),
      (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ ((W ⋙ wcEtBaseChange g).map t).left = z l') →
      ∃! z₀ : T ⟶ Limits.pullback g a, ∀ l, z₀ ≫ π l = z l := by
    intro T z hz
    have hs : ∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ Limits.pullback.snd (W.obj l).hom g =
        z l' ≫ Limits.pullback.snd (W.obj l').hom g := by
      intro l l' t
      calc z l ≫ Limits.pullback.snd (W.obj l).hom g
          = z l ≫ (((W ⋙ wcEtBaseChange g).map t).left ≫
              Limits.pullback.snd (W.obj l').hom g) := (whisker_eq _ (M2 t)).symm
        _ = (z l ≫ ((W ⋙ wcEtBaseChange g).map t).left) ≫
              Limits.pullback.snd (W.obj l').hom g := (Category.assoc _ _ _).symm
        _ = z l' ≫ Limits.pullback.snd (W.obj l').hom g := eq_whisker (hz t) _
    obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
    have hX : ∀ l, z l ≫ Limits.pullback.snd (W.obj l).hom g =
        z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom g := fun l =>
      (hs (IsCofiltered.minToLeft l l₀)).symm.trans (hs (IsCofiltered.minToRight l l₀))
    have hf : ∀ {l l' : Λ} (t : l ⟶ l'), (z l ≫ Limits.pullback.fst (W.obj l).hom g) ≫
        (W.map t).left = z l' ≫ Limits.pullback.fst (W.obj l').hom g := by
      intro l l' t
      calc (z l ≫ Limits.pullback.fst (W.obj l).hom g) ≫ (W.map t).left
          = z l ≫ (Limits.pullback.fst (W.obj l).hom g ≫ (W.map t).left) := Category.assoc _ _ _
        _ = z l ≫ (((W ⋙ wcEtBaseChange g).map t).left ≫
              Limits.pullback.fst (W.obj l').hom g) := whisker_eq _ (M1 t).symm
        _ = (z l ≫ ((W ⋙ wcEtBaseChange g).map t).left) ≫
              Limits.pullback.fst (W.obj l').hom g := (Category.assoc _ _ _).symm
        _ = z l' ≫ Limits.pullback.fst (W.obj l').hom g := eq_whisker (hz t) _
    obtain ⟨y, hy, hyu⟩ := hlim T (fun l => z l ≫ Limits.pullback.fst (W.obj l).hom g) hf
    have hy' : ∀ l, y ≫ φ l = z l ≫ Limits.pullback.fst (W.obj l).hom g := hy
    have hxy : (z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom g) ≫ g = y ≫ a := by
      calc (z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom g) ≫ g
          = z l₀ ≫ (Limits.pullback.snd (W.obj l₀).hom g ≫ g) := Category.assoc _ _ _
        _ = z l₀ ≫ (Limits.pullback.fst (W.obj l₀).hom g ≫ (W.obj l₀).hom) :=
            whisker_eq _ Limits.pullback.condition.symm
        _ = (z l₀ ≫ Limits.pullback.fst (W.obj l₀).hom g) ≫ (W.obj l₀).hom :=
            (Category.assoc _ _ _).symm
        _ = (y ≫ φ l₀) ≫ (W.obj l₀).hom := eq_whisker (hy' l₀).symm _
        _ = y ≫ a := by rw [Category.assoc, hφa l₀]
    obtain ⟨z₀, hz₀p, hz₀Z⟩ : ∃ z₀ : T ⟶ Limits.pullback g a,
        z₀ ≫ Limits.pullback.fst g a = z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom g ∧
          z₀ ≫ Limits.pullback.snd g a = y :=
      ⟨Limits.pullback.lift _ y hxy, Limits.pullback.lift_fst _ _ _,
        Limits.pullback.lift_snd _ _ _⟩
    refine ⟨z₀, fun l => ?_, fun z' hz' => ?_⟩
    · refine Limits.pullback.hom_ext (f := (W.obj l).hom) (g := g) ?_ ?_
      · calc (z₀ ≫ π l) ≫ Limits.pullback.fst (W.obj l).hom g
            = z₀ ≫ (π l ≫ Limits.pullback.fst (W.obj l).hom g) := Category.assoc _ _ _
          _ = z₀ ≫ (Limits.pullback.snd g a ≫ φ l) := whisker_eq _ (P1 l)
          _ = (z₀ ≫ Limits.pullback.snd g a) ≫ φ l := (Category.assoc _ _ _).symm
          _ = y ≫ φ l := eq_whisker hz₀Z _
          _ = z l ≫ Limits.pullback.fst (W.obj l).hom g := hy' l
      · calc (z₀ ≫ π l) ≫ Limits.pullback.snd (W.obj l).hom g
            = z₀ ≫ (π l ≫ Limits.pullback.snd (W.obj l).hom g) := Category.assoc _ _ _
          _ = z₀ ≫ Limits.pullback.fst g a := whisker_eq _ (P2 l)
          _ = z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom g := hz₀p
          _ = z l ≫ Limits.pullback.snd (W.obj l).hom g := (hX l).symm
    · have e1 : z' ≫ Limits.pullback.fst g a = z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom g := by
        calc z' ≫ Limits.pullback.fst g a
            = z' ≫ (π l₀ ≫ Limits.pullback.snd (W.obj l₀).hom g) := whisker_eq _ (P2 l₀).symm
          _ = (z' ≫ π l₀) ≫ Limits.pullback.snd (W.obj l₀).hom g := (Category.assoc _ _ _).symm
          _ = z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom g := eq_whisker (hz' l₀) _
      have e2 : z' ≫ Limits.pullback.snd g a = y := by
        apply hyu
        intro l
        calc (z' ≫ Limits.pullback.snd g a) ≫ φ l
            = z' ≫ (Limits.pullback.snd g a ≫ φ l) := Category.assoc _ _ _
          _ = z' ≫ (π l ≫ Limits.pullback.fst (W.obj l).hom g) := whisker_eq _ (P1 l).symm
          _ = (z' ≫ π l) ≫ Limits.pullback.fst (W.obj l).hom g := (Category.assoc _ _ _).symm
          _ = z l ≫ Limits.pullback.fst (W.obj l).hom g := eq_whisker (hz' l) _
      exact Limits.pullback.hom_ext (f := g) (g := a) (e1.trans hz₀p.symm) (e2.trans hz₀Z.symm)
  exact ⟨C2, C3⟩

theorem wc_et_free_gen_map_naturality : ∀ {X : Scheme.{u}} {V V' : X.Etale} (c : V' ⟶ V), (((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map (Functor.whiskerRight (yoneda.map c) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))).hom.app (Opposite.op V')).hom (wcFtcGen X V') = ((wcFtcFS X V).obj.map c.op).hom (wcFtcGen X V) :=
by
  intro X V V' c
  have e1 : ((Functor.whiskerRight (yoneda.map c)
      (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app (Opposite.op V')).hom
        (FreeAbelianGroup.of (ULift.up (𝟙 V'))) = FreeAbelianGroup.of (ULift.up c) := by
    change FreeAbelianGroup.map _ (FreeAbelianGroup.of _) = _
    first
      | exact (FreeAbelianGroup.map_of_apply _).trans
          (congrArg FreeAbelianGroup.of (congrArg ULift.up (Category.id_comp c)))
      | (erw [FreeAbelianGroup.map_of_apply]
         exact congrArg FreeAbelianGroup.of (congrArg ULift.up (Category.id_comp c)))
      | (simp [FreeAbelianGroup.map_of_apply]; done)
  have e2 : ((yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map c.op).hom
        (FreeAbelianGroup.of (ULift.up (𝟙 V))) = FreeAbelianGroup.of (ULift.up c) := by
    change FreeAbelianGroup.map _ (FreeAbelianGroup.of _) = _
    first
      | exact (FreeAbelianGroup.map_of_apply _).trans
          (congrArg FreeAbelianGroup.of (congrArg ULift.up (Category.comp_id c)))
      | (erw [FreeAbelianGroup.map_of_apply]
         exact congrArg FreeAbelianGroup.of (congrArg ULift.up (Category.comp_id c)))
      | (simp [FreeAbelianGroup.map_of_apply]; done)
  have k1 := congrArg
    (fun f => (f.app (Opposite.op V')).hom (FreeAbelianGroup.of (ULift.up (𝟙 V'))))
    (toSheafify_naturality (Scheme.smallEtaleTopology X)
      (Functor.whiskerRight (yoneda.map c) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)))
  have k2 := congrArg (fun f => f.hom (FreeAbelianGroup.of (ULift.up (𝟙 V))))
    ((toSheafify (Scheme.smallEtaleTopology X)
      (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).naturality c.op)
  calc _ = ((toSheafify (Scheme.smallEtaleTopology X)
          (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app (Opposite.op V')).hom
          (((Functor.whiskerRight (yoneda.map c)
            (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app (Opposite.op V')).hom
              (FreeAbelianGroup.of (ULift.up (𝟙 V')))) := k1.symm
    _ = ((toSheafify (Scheme.smallEtaleTopology X)
          (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app (Opposite.op V')).hom
          (FreeAbelianGroup.of (ULift.up c)) := congrArg _ e1
    _ = ((toSheafify (Scheme.smallEtaleTopology X)
          (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app (Opposite.op V')).hom
          (((yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map c.op).hom
            (FreeAbelianGroup.of (ULift.up (𝟙 V)))) := congrArg _ e2.symm
    _ = _ := k2

theorem wc_et_univ_transport_level_eq : ∀ {S Z : Scheme.{u}} (g : Z ⟶ S) (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) (H : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (ρ : wcEtTransport g G H), wcEtTransportUniv ρ → ∀ (U : Z.Etale) (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (D : Λ ⥤ S.Etale) (π : ∀ l, U.left ⟶ (D.obj l).left) (hπ : ∀ l, π l ≫ (D.obj l).hom = U.hom ≫ g), (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ (D.map t).left = π l') → (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (D.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (D.map t).left = z l') → ∃! z₀ : T ⟶ U.left, ∀ l, z₀ ≫ π l = z l) → (∀ l, CompactSpace (D.obj l).left) → (∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom (D.map t).left) → ∀ (l₁ l₂ : Λ) (x₁ : G.obj.obj (Opposite.op (D.obj l₁))) (x₂ : G.obj.obj (Opposite.op (D.obj l₂))), ρ.ρ (D.obj l₁) U (π l₁) (hπ l₁) x₁ = ρ.ρ (D.obj l₂) U (π l₂) (hπ l₂) x₂ → ∃ (l₃ : Λ) (t₁ : l₃ ⟶ l₁) (t₂ : l₃ ⟶ l₂), (G.obj.map (D.map t₁).op).hom x₁ = (G.obj.map (D.map t₂).op).hom x₂ :=
by
  intro S Z g G H ρ hu U Λ _ _ D π hπ hcomp hlim hcpt haff l₁ l₂ x₁ x₂ heq

  have hTS : ∀ {l m' : Λ} (t : m' ⟶ l) (y : G.obj.obj (Opposite.op (D.obj l))),
      ρ.ρ (D.obj m') U (π m') (hπ m') ((G.obj.map (D.map t).op).hom y) =
        ρ.ρ (D.obj l) U (π l) (hπ l) y := by
    intro l m' t y
    have h := ρ.nat (D.obj l) (D.obj m') (D.map t) U U (𝟙 U) (π l) (hπ l) (π m') (hπ m')
      ((hcomp t).trans (Category.id_comp (π l)).symm) y
    refine h.trans ?_
    simp
  let m := IsCofiltered.min l₁ l₂
  let s₁ : m ⟶ l₁ := IsCofiltered.minToLeft l₁ l₂
  let s₂ : m ⟶ l₂ := IsCofiltered.minToRight l₁ l₂
  obtain ⟨δ, hδdef⟩ : ∃ δ : G.obj.obj (Opposite.op (D.obj m)),
      δ = (G.obj.map (D.map s₁).op).hom x₁ - (G.obj.map (D.map s₂).op).hom x₂ := ⟨_, rfl⟩
  have hδ : ρ.ρ (D.obj m) U (π m) (hπ m) δ = 0 := by
    rw [hδdef, map_sub, hTS, hTS, heq, sub_self]
  obtain ⟨l₃, t, hkill⟩ := wc_et_univ_transport_limit_vanish g G H ρ hu U Λ D π hπ hcomp hlim
    haff m (D.obj m) (𝟙 (D.obj m)) (hcpt m) δ (fun O d k hk hkc => by
      have h := ρ.nat (D.obj m) (D.obj m) (𝟙 (D.obj m)) U O d (π m) (hπ m) k hk hkc δ
      rw [hδ] at h
      simpa using h)
  have hz := hkill (D.obj l₃) (D.map t) (𝟙 _) (by rw [Category.comp_id, Category.id_comp])
  refine ⟨l₃, t ≫ s₁, t ≫ s₂, ?_⟩
  have e : ∀ {l : Λ} (s : m ⟶ l) (x : G.obj.obj (Opposite.op (D.obj l))),
      (G.obj.map (D.map (t ≫ s)).op).hom x =
        (G.obj.map (D.map t).op).hom ((G.obj.map (D.map s).op).hom x) := by
    intro l s x
    rw [Functor.map_comp, op_comp, Functor.map_comp]
    rfl
  rw [← sub_eq_zero, e, e, ← map_sub, ← hδdef]
  exact hz

theorem wc_et_free_sheaf_corep : ∀ {X : Scheme.{u}} (U : X.Etale) (F : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}), Function.Bijective (fun φ : wcFtcFS X U ⟶ F => (φ.hom.app (Opposite.op U)).hom (wcFtcGen X U)) :=
by
  intro X U F
  let P : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
    yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
  let g₀ : P.obj (Opposite.op U) := FreeAbelianGroup.of (ULift.up (𝟙 U))
  let Φ : (wcFtcFS X U ⟶ F) → (P ⟶ F.obj) := fun φ =>
    toSheafify (Scheme.smallEtaleTopology X) P ≫ φ.hom
  let Ψ : (P ⟶ F.obj) → F.obj.obj (Opposite.op U) := fun α => (α.app (Opposite.op U)).hom g₀
  have hfac : (fun φ : wcFtcFS X U ⟶ F => (φ.hom.app (Opposite.op U)).hom (wcFtcGen X U)) =
      Ψ ∘ Φ := by
    funext φ
    rfl
  have hΦ : Function.Bijective Φ := by
    constructor
    · intro φ ψ h
      apply Sheaf.hom_ext
      exact sheafify_hom_ext (Scheme.smallEtaleTopology X) _ _ F.property h
    · intro α
