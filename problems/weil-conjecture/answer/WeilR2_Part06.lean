        simp only [IntermediateField.algebraMap_apply] at h1
        exact h1.symm
      show γ (N.val.comp (act τ ψ)) = γ (N.val.comp (act τ ψ'))
      rw [e, e]
      exact hγ _ _ _ h
    have htrans : ∀ ψ₀ ψ : L →ₐ[k] N, ∃ τ : N ≃ₐ[k] N, act τ ψ₀ = ψ := by
      intro ψ₀ ψ
      let e := AlgEquiv.ofInjectiveField ψ₀
      obtain ⟨σ, hσ⟩ := IntermediateField.exists_algHom_of_splits (L := ψ₀.fieldRange)
        (fun s : N => ⟨Normal.isIntegral inferInstance s, Normal.splits inferInstance s⟩)
        (ψ.comp (e.symm : ψ₀.range →ₐ[k] L))
      refine ⟨AlgEquiv.ofBijective σ (AlgHom.normal_bijective k N N σ), AlgHom.ext fun a => ?_⟩
      have h1 : σ (ψ₀.fieldRange.val (e a)) = ψ (e.symm (e a)) := DFunLike.congr_fun hσ (e a)
      rw [e.symm_apply_apply] at h1
