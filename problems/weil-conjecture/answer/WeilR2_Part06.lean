    · apply closure_minimal _ isClosed_closure
      calc ⇑g '' (U : Set X) ⊆ ⇑g '' closure ({ξ} : Set X) := by
            rw [hξcl]; exact Set.image_mono subset_closure
        _ ⊆ closure (⇑g '' {ξ}) := image_closure_subset_closure_image g.continuous
