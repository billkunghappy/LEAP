import WeilR2_Part05
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem wc_hm_unit_end_central (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (e : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶ SheafOfModules.unit (wcRingSheaf S ℓ))
    (n : ℕ) (y : wcHM S ℓ n) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    (Abelian.Ext.mk₀ e).comp y (zero_add n) = y.comp (Abelian.Ext.mk₀ e) (add_zero n) :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _

  have hcomm : ∀ (X : (S.ProEt)ᵒᵖ) (a b : (wcRingSheaf S ℓ).obj.obj X), a * b = b * a := by
    intro X a b
    exact @mul_comm C(↥(Opposite.unop X).left, ULift.{u+1} ℚ_[ℓ]) _ a b

  have hext : ∃ m : 𝟭 (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) ⟶ 𝟭 (SheafOfModules.{u+1} (wcRingSheaf S ℓ)),
      m.app (SheafOfModules.unit (wcRingSheaf S ℓ)) = e := by
    let R := wcRingSheaf S ℓ
    let s := (SheafOfModules.unit R).unitHomEquiv e
    let σ : ∀ X : (S.ProEt)ᵒᵖ, R.obj.obj X := fun X => (s.1 X : R.obj.obj X)
    have hσ : ∀ {X Y : (S.ProEt)ᵒᵖ} (f : X ⟶ Y), (R.obj.map f).hom (σ X) = σ Y :=
      fun f => PresheafOfModules.sections_property s f
    let L : ∀ (M : SheafOfModules.{u+1} R) (X : (S.ProEt)ᵒᵖ), M.val.obj X ⟶ M.val.obj X :=
      fun M X => ModuleCat.ofHom
        { toFun := fun x => σ X • x
          map_add' := fun x y => smul_add _ _ _
          map_smul' := fun r x => by
            simp only [RingHom.id_apply, smul_smul]
            rw [hcomm X] }
    let mM : ∀ M : SheafOfModules.{u+1} R, M ⟶ M := fun M =>
      ⟨PresheafOfModules.Hom.mk (L M) (by
        intro X Y f
        ext x
        show σ Y • (M.val.map f).hom x = (M.val.map f).hom (σ X • x)
        rw [PresheafOfModules.map_smul, hσ])⟩
    refine ⟨{ app := mM, naturality := ?_ }, ?_⟩
    · intro M N g
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro X
      ext x
      show σ X • (g.val.app X).hom x = (g.val.app X).hom (σ X • x)
      exact ((g.val.app X).hom.map_smul _ _).symm
    · apply (SheafOfModules.unit R).unitHomEquiv.injective
      apply PresheafOfModules.sections_ext
      intro X
      rw [SheafOfModules.unitHomEquiv_apply_coe]
      show σ X • (1 : R.obj.obj X) = s.1 X
      rw [smul_eq_mul, mul_one]

  have hcen : ∀ (τ : 𝟭 (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) ⟶ 𝟭 (SheafOfModules.{u+1} (wcRingSheaf S ℓ)))
      (z : wcHM S ℓ n),
      (Abelian.Ext.mk₀ (τ.app (SheafOfModules.unit (wcRingSheaf S ℓ)))).comp z (zero_add n) =
        z.comp (Abelian.Ext.mk₀ (τ.app (SheafOfModules.unit (wcRingSheaf S ℓ)))) (add_zero n) := by
    intro τ z
    have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp z τ
    simp only [Abelian.Ext.id_mapExactFunctor] at h
    exact h.symm

  obtain ⟨m, hm⟩ := hext
  subst hm
  exact hcen m y

theorem wc_slice_over_sites_cont : ∀ (S : Scheme.{u}) (U : S.ProEt),
    (wcSliceToOver S U).IsContinuous (Scheme.ProEt.topology U.left) ((Scheme.ProEt.topology S).over U) ∧
    (wcOverToSlice S U).IsContinuous ((Scheme.ProEt.topology S).over U) (Scheme.ProEt.topology U.left) ∧
    (wcSliceToOver S U).IsCocontinuous (Scheme.ProEt.topology U.left) ((Scheme.ProEt.topology S).over U) ∧
    (wcOverToSlice S U).IsCocontinuous ((Scheme.ProEt.topology S).over U) (Scheme.ProEt.topology U.left) :=
by
  intro S U
  have hmem : ∀ (T : Scheme.{u}) (V : T.ProEt) (R : Sieve V),
      R ∈ Scheme.ProEt.topology T V ↔
        Sieve.functorPushforward (Scheme.ProEt.forget T ⋙ Over.forget T) R ∈
          Scheme.proetaleTopology V.left := by
    intro T V R
    letI := MorphismProperty.IsMultiplicative.toIsStableUnderComposition (W := @WeaklyEtale)
    have hT : Scheme.ProEt.topology T =
        (Scheme.ProEt.forget T).restrictedTopology (Scheme.proetaleTopology.over T) :=
      MorphismProperty.toGrothendieck_comap_forget_eq_restrictedTopology (S := T)
        (P := @WeaklyEtale) Scheme.proetalePrecoverage
        Scheme.proetalePrecoverage_le_precoverage_weaklyEtale
    rw [hT, Functor.mem_restrictedTopology_iff, GrothendieckTopology.mem_over_iff,
      Sieve.overEquiv_apply, ← Sieve.functorPushforward_comp]
    rfl
  let εapp : ∀ V : Over U, (wcOverToSlice S U ⋙ wcSliceToOver S U).obj V ≅ V := fun V =>
    Over.isoMk (MorphismProperty.Over.isoMk (Iso.refl V.left.left)
        ((Category.id_comp _).trans (MorphismProperty.Over.w V.hom).symm))
      (MorphismProperty.Over.Hom.ext (Category.id_comp V.hom.left))
  let ε : wcOverToSlice S U ⋙ wcSliceToOver S U ≅ 𝟭 (Over U) :=
    NatIso.ofComponents εapp (fun {V V'} g => by
      apply Over.OverMorphism.ext
      apply MorphismProperty.Over.Hom.ext
      exact (Category.comp_id g.left.left).trans (Category.id_comp g.left.left).symm)
  have hmemD : ∀ (V : Over U) (R : Sieve V), R ∈ (Scheme.ProEt.topology S).over U V ↔
      Sieve.functorPushforward (Over.forget U ⋙ Scheme.ProEt.forget S ⋙ Over.forget S) R ∈
        Scheme.proetaleTopology V.left.left := by
    intro V R
    rw [GrothendieckTopology.mem_over_iff, Sieve.overEquiv_apply, hmem S V.left,
      ← Sieve.functorPushforward_comp]
  have hFc : (wcSliceToOver S U).IsCocontinuous (Scheme.ProEt.topology U.left)
      ((Scheme.ProEt.topology S).over U) := by
    constructor
    intro W T hT
    rw [hmem U.left W]
    rw [hmemD] at hT
    refine GrothendieckTopology.superset_covering _ ?_ hT
    rintro Z f ⟨V', t, a, ht, rfl⟩
    refine ⟨(wcOverToSlice S U).obj V', (wcOverToSlice S U).map t, a, ?_, rfl⟩
    show T.arrows ((wcSliceToOver S U).map ((wcOverToSlice S U).map t))
    have hft : (wcSliceToOver S U).map ((wcOverToSlice S U).map t) = (εapp V').hom ≫ t := by
      apply Over.OverMorphism.ext
      apply MorphismProperty.Over.Hom.ext
      exact (Category.id_comp t.left.left).symm
    exact (congrArg (fun g => T.arrows g) hft).mpr (T.downward_closed ht _)
  have hGc : (wcOverToSlice S U).IsCocontinuous ((Scheme.ProEt.topology S).over U)
      (Scheme.ProEt.topology U.left) := by
    constructor
    intro V T hT
    rw [hmemD]
    rw [hmem U.left] at hT
    refine GrothendieckTopology.superset_covering _ ?_ hT
    rintro Z f ⟨W', t, a, ht, rfl⟩
    refine ⟨(wcSliceToOver S U).obj W', (wcSliceToOver S U).map t ≫ (εapp V).hom, a, ?_, ?_⟩
    · show T.arrows ((wcOverToSlice S U).map ((wcSliceToOver S U).map t ≫ (εapp V).hom))
      have hgt : (wcOverToSlice S U).map ((wcSliceToOver S U).map t ≫ (εapp V).hom) = t := by
        apply MorphismProperty.Over.Hom.ext
        exact Category.comp_id t.left
      exact (congrArg (fun g => T.arrows g) hgt).mpr ht
    · exact (congrArg (a ≫ ·) (Category.comp_id t.left)).symm
  let eqv : U.left.ProEt ≌ Over U :=
    Equivalence.mk' (wcSliceToOver S U) (wcOverToSlice S U) (Iso.refl _) ε (fun W => by
      apply Over.OverMorphism.ext
      apply MorphismProperty.Over.Hom.ext
      exact Category.comp_id (𝟙 W.left))
  haveI : eqv.functor.IsCocontinuous (Scheme.ProEt.topology U.left)
      ((Scheme.ProEt.topology S).over U) := hFc
  haveI : eqv.inverse.IsCocontinuous ((Scheme.ProEt.topology S).over U)
      (Scheme.ProEt.topology U.left) := hGc
  haveI := Equivalence.isDenseSubsite_functor_of_isCocontinuous (Scheme.ProEt.topology U.left)
    ((Scheme.ProEt.topology S).over U) eqv
  haveI := Equivalence.isDenseSubsite_inverse_of_isCocontinuous (Scheme.ProEt.topology U.left)
    ((Scheme.ProEt.topology S).over U) eqv
  refine ⟨?_, ?_, hFc, hGc⟩
  · exact (inferInstance : eqv.functor.IsContinuous (Scheme.ProEt.topology U.left)
      ((Scheme.ProEt.topology S).over U))
  · exact (inferInstance : eqv.inverse.IsContinuous ((Scheme.ProEt.topology S).over U)
      (Scheme.ProEt.topology U.left))

theorem ext_twist_conj_eq : ∀ {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] [HasExt 𝒜]
    {ℬ : Type*} [Category ℬ] [Abelian ℬ] [HasExt ℬ]
    (Ψ : 𝒜 ⥤ 𝒜) (G : 𝒜 ⥤ ℬ) (Φ : ℬ ⥤ ℬ) {Ξ : ℬ ⥤ ℬ}
    [Ψ.Additive] [Limits.PreservesFiniteLimits Ψ] [Limits.PreservesFiniteColimits Ψ]
    [G.Additive] [Limits.PreservesFiniteLimits G] [Limits.PreservesFiniteColimits G]
    [Φ.Additive] [Limits.PreservesFiniteLimits Φ] [Limits.PreservesFiniteColimits Φ]
    (_θ : Φ ≅ Ξ) (_κ : Ψ ⋙ G ≅ G ⋙ Ξ) (P : 𝒜) (μ : Φ.obj (G.obj P) ≅ G.obj (Ψ.obj P)),
    (∀ (w : G.obj (Ψ.obj P) ⟶ G.obj (Ψ.obj P)) (m : ℕ)
        (z : Abelian.Ext (G.obj (Ψ.obj P)) (G.obj (Ψ.obj P)) m),
      (Abelian.Ext.mk₀ w).comp z (zero_add m) = z.comp (Abelian.Ext.mk₀ w) (add_zero m)) →
    ∀ (n : ℕ) (y : Abelian.Ext P P n),
      Abelian.Ext.mapExactFunctor G (Abelian.Ext.mapExactFunctor Ψ y) =
        (Abelian.Ext.mk₀ μ.inv).comp ((Abelian.Ext.mapExactFunctor Φ
          (Abelian.Ext.mapExactFunctor G y)).comp (Abelian.Ext.mk₀ μ.hom) (add_zero n))
          (zero_add n) :=
by
  intro 𝒜 _ _ _ ℬ _ _ _ Ψ G Φ Ξ _ _ _ _ _ _ _ _ _ θ κ P μ hcen n y
  let τ : Ψ ⋙ G ⟶ G ⋙ Φ := κ.hom ≫ Functor.whiskerLeft G θ.inv
  obtain ⟨t, ht⟩ : ∃ t : G.obj (Ψ.obj P) ⟶ Φ.obj (G.obj P), t = τ.app P := ⟨_, rfl⟩
  obtain ⟨t', ht'⟩ : ∃ t' : Φ.obj (G.obj P) ⟶ G.obj (Ψ.obj P),
      t' = θ.hom.app (G.obj P) ≫ κ.inv.app P := ⟨_, rfl⟩
  have htt : t ≫ t' = 𝟙 _ := by
    rw [ht, ht']
    simp [τ]
  obtain ⟨a, ha⟩ : ∃ a : Abelian.Ext (G.obj (Ψ.obj P)) (G.obj (Ψ.obj P)) n,
      a = Abelian.Ext.mapExactFunctor (Ψ ⋙ G) y := ⟨_, rfl⟩
  obtain ⟨b, hb⟩ : ∃ b : Abelian.Ext (Φ.obj (G.obj P)) (Φ.obj (G.obj P)) n,
      b = Abelian.Ext.mapExactFunctor (G ⋙ Φ) y := ⟨_, rfl⟩
  have hE1 : a.comp (Abelian.Ext.mk₀ t) (add_zero n) =
      (Abelian.Ext.mk₀ t).comp b (zero_add n) := by
    rw [ha, hb, ht]
    exact Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp y τ
  have hLHS : Abelian.Ext.mapExactFunctor G (Abelian.Ext.mapExactFunctor Ψ y) = a := by
    rw [ha, Abelian.Ext.comp_mapExactFunctor]
  have hRHS : Abelian.Ext.mapExactFunctor Φ (Abelian.Ext.mapExactFunctor G y) = b := by
    rw [hb, Abelian.Ext.comp_mapExactFunctor]
  rw [hLHS, hRHS]
  obtain ⟨w, hw⟩ : ∃ w : G.obj (Ψ.obj P) ⟶ G.obj (Ψ.obj P), w = t ≫ μ.hom := ⟨_, rfl⟩
  obtain ⟨w', hw'⟩ : ∃ w' : G.obj (Ψ.obj P) ⟶ G.obj (Ψ.obj P), w' = μ.inv ≫ t' := ⟨_, rfl⟩
  have hwinv : w ≫ μ.inv = t := by rw [hw]; simp
  have hww : w ≫ w' = 𝟙 _ := by rw [hw, hw']; simp [htt]
  obtain ⟨c, hc⟩ : ∃ c : Abelian.Ext (G.obj (Ψ.obj P)) (G.obj (Ψ.obj P)) n,
      c = (Abelian.Ext.mk₀ μ.inv).comp (b.comp (Abelian.Ext.mk₀ μ.hom) (add_zero n))
        (zero_add n) := ⟨_, rfl⟩
  rw [← hc]
  have hwc : (Abelian.Ext.mk₀ w).comp c (zero_add n) =
      a.comp (Abelian.Ext.mk₀ w) (add_zero n) := by
    calc (Abelian.Ext.mk₀ w).comp c (zero_add n)
        = ((Abelian.Ext.mk₀ w).comp (Abelian.Ext.mk₀ μ.inv) (zero_add 0)).comp
            (b.comp (Abelian.Ext.mk₀ μ.hom) (add_zero n)) (zero_add n) := by
          rw [hc]
          exact (Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add n) (by omega)).symm
      _ = (Abelian.Ext.mk₀ t).comp (b.comp (Abelian.Ext.mk₀ μ.hom) (add_zero n))
            (zero_add n) := by
          rw [Abelian.Ext.mk₀_comp_mk₀, hwinv]
      _ = ((Abelian.Ext.mk₀ t).comp b (zero_add n)).comp (Abelian.Ext.mk₀ μ.hom)
            (add_zero n) :=
          (Abelian.Ext.comp_assoc _ _ _ (zero_add n) (add_zero n) (by omega)).symm
      _ = (a.comp (Abelian.Ext.mk₀ t) (add_zero n)).comp (Abelian.Ext.mk₀ μ.hom)
            (add_zero n) := by
          rw [hE1]
      _ = a.comp (Abelian.Ext.mk₀ w) (add_zero n) := by
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero n) (zero_add 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, hw]
  calc a = a.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero n) := (Abelian.Ext.comp_mk₀_id a).symm
    _ = a.comp (Abelian.Ext.mk₀ (w ≫ w')) (add_zero n) := by rw [hww]
    _ = (a.comp (Abelian.Ext.mk₀ w) (add_zero n)).comp (Abelian.Ext.mk₀ w') (add_zero n) := by
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero n) (zero_add 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀]
    _ = (c.comp (Abelian.Ext.mk₀ w) (add_zero n)).comp (Abelian.Ext.mk₀ w') (add_zero n) := by
        rw [← hwc, hcen w n c]
    _ = c := by
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero n) (zero_add 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, hww, Abelian.Ext.comp_mk₀_id]

theorem ext_transfer_of_hom_bijective : ∀ {C : Type*} [Category C] [Abelian C] [HasExt C]
    {D : Type*} [Category D] [Abelian D] [HasExt D]
    (L : C ⥤ D) (G : D ⥤ C) (adj : L ⊣ G) [L.Additive] [G.Additive]
    [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L]
    [Limits.PreservesFiniteLimits G] [Limits.PreservesFiniteColimits G]
    (P : C) (X : D) (ε : P ⟶ G.obj X),
    (∀ Y : D, Function.Bijective (fun f : X ⟶ Y => ε ≫ G.map f)) →
    ∀ (Y : D) (n : ℕ), Function.Bijective (fun β : Abelian.Ext X Y n =>
      (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor G β) (zero_add n)) :=
by
  intro C _ _ _ D _ _ _ L G adj _ _ _ _ _ _ P X ε hε Y n
  obtain ⟨θ, hθ⟩ : ∃ θ : L.obj P ⟶ X, adj.homEquiv P X θ = ε :=
    ⟨_, (adj.homEquiv P X).apply_symm_apply ε⟩
  have hbij : ∀ T : D, Function.Bijective (fun f : X ⟶ T => θ ≫ f) := by
    intro T
    have e : (fun f : X ⟶ T => θ ≫ f) =
        (adj.homEquiv P T).symm ∘ (fun f : X ⟶ T => ε ≫ G.map f) := by
      funext f
      simp only [Function.comp_apply]
      rw [_root_.Equiv.eq_symm_apply, Adjunction.homEquiv_naturality_right, hθ]
    rw [e]
    exact (adj.homEquiv P T).symm.bijective.comp (hε T)
  haveI : IsIso θ := isIso_of_coyoneda_map_bijective θ hbij
  have hψ : Function.Bijective
      (fun β : Abelian.Ext X Y n => (Abelian.Ext.mk₀ θ).comp β (zero_add n)) := by
    refine Function.bijective_iff_has_inverse.mpr
      ⟨fun γ => (Abelian.Ext.mk₀ (inv θ)).comp γ (zero_add n), ?_, ?_⟩
    · intro β
      simp only
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, IsIso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
    · intro γ
      simp only
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, IsIso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
  have hfac : (fun β : Abelian.Ext X Y n =>
      (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor G β) (zero_add n)) =
      adj.extEquiv ∘ (fun β : Abelian.Ext X Y n => (Abelian.Ext.mk₀ θ).comp β (zero_add n)) := by
    funext β
    simp only [Function.comp_apply]
    rw [Adjunction.extEquiv_apply, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀_assoc,
      ← hθ, Adjunction.homEquiv_unit]
  rw [hfac]
  exact adj.extEquiv.bijective.comp hψ

theorem proet_overPullback_exact_left_adjoint : ∀ (S : Scheme.{u}) (U : S.ProEt),
    ∃ (L : Sheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1} ⥤
        Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (_ : L ⊣ (Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U),
      L.Additive ∧ Limits.PreservesFiniteLimits L ∧ Limits.PreservesFiniteColimits L :=
by
  intro S U

  have hfinal : ∀ W : S.ProEt, ∃ (I : Type u)
      (D : Discrete I ⥤ CostructuredArrow (Over.forget U).op (Opposite.op W)), D.Final := by
    intro W
    obtain ⟨D, hD⟩ : ∃ D : Discrete (W ⟶ U) ⥤
        CostructuredArrow (Over.forget U).op (Opposite.op W),
        ∀ f, D.obj ⟨f⟩ = CostructuredArrow.mk (Y := Opposite.op (Over.mk f)) (𝟙 W).op :=
      ⟨Discrete.functor (fun f => CostructuredArrow.mk (Y := Opposite.op (Over.mk f)) (𝟙 W).op),
        fun f => rfl⟩
    have key : ∀ (c : CostructuredArrow (Over.forget U).op (Opposite.op W)) (f : W ⟶ U)
        (k : c.left ⟶ Opposite.op (Over.mk f))
        (hk : (Over.forget U).op.map k ≫ (𝟙 W).op = c.hom),
        (Quiver.Hom.unop k).left = Quiver.Hom.unop c.hom ∧
          f = Quiver.Hom.unop c.hom ≫ c.left.unop.hom := by
      intro c f k hk
      have h0 : 𝟙 W ≫ (Over.forget U).map k.unop = c.hom.unop := congrArg Quiver.Hom.unop hk
      have h1 : (Quiver.Hom.unop k).left = Quiver.Hom.unop c.hom :=
        (Category.id_comp _).symm.trans h0
      refine ⟨h1, ?_⟩
      have hw : (Quiver.Hom.unop k).left ≫ c.left.unop.hom = (Over.mk f).hom :=
        Over.w k.unop
      exact hw.symm.trans (congrArg (· ≫ c.left.unop.hom) h1)
    refine ⟨W ⟶ U, D, Functor.Final.mk (fun c => ?_)⟩
    have hext : ∀ (f : W ⟶ U) (h h' : c ⟶ D.obj ⟨f⟩), h = h' := by
      intro f h h'
      refine (cancel_mono (eqToHom (hD f))).1 ?_
      apply CostructuredArrow.hom_ext
      apply Quiver.Hom.unop_inj
      apply Over.OverMorphism.ext
      exact (key c f (h ≫ eqToHom (hD f)).left (CostructuredArrow.w _)).1.trans
        (key c f (h' ≫ eqToHom (hD f)).left (CostructuredArrow.w _)).1.symm
    let fc : W ⟶ U := Quiver.Hom.unop c.hom ≫ c.left.unop.hom
    obtain ⟨κc, hκc⟩ : ∃ κc : Over.mk fc ⟶ c.left.unop,
        κc.left = Quiver.Hom.unop c.hom :=
      ⟨Over.homMk (Quiver.Hom.unop c.hom) rfl, rfl⟩
    have hw : (Over.forget U).op.map κc.op ≫ (𝟙 W).op = c.hom := by
      apply Quiver.Hom.unop_inj
      exact (Category.id_comp _).trans hκc
    let φc : c ⟶ D.obj ⟨fc⟩ :=
      CostructuredArrow.homMk (f := c)
        (f' := CostructuredArrow.mk (Y := Opposite.op (Over.mk fc)) (𝟙 W).op)
        κc.op hw ≫ eqToHom (hD fc).symm
    have hto : ∀ s : StructuredArrow c D, s.right.as = fc := fun s =>
      (key c s.right.as (s.hom ≫ eqToHom (hD s.right.as)).left (CostructuredArrow.w _)).2
    let tc : StructuredArrow c D := StructuredArrow.mk (Y := ⟨fc⟩) φc
    exact isConnected_of_isTerminal _ (Limits.IsTerminal.ofUniqueHom (X := tc)
      (fun s => StructuredArrow.homMk (Discrete.eqToHom (hto s)) (hext _ _ _))
      (fun s m => StructuredArrow.ext _ _ (Subsingleton.elim _ _)))

  have lan_eval_iso : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (L : C ⥤ D)
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F] (Y : D),
      Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
          (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim) := by
    intro C D _ _ L _ _ Y
    refine ⟨NatIso.ofComponents (fun F => L.leftKanExtensionObjIsoColimit F Y) ?_⟩
    intro F₁ F₂ φ
    have hnat : ∀ j : CostructuredArrow L Y,
        (L.leftKanExtension F₁).map j.hom ≫ (L.lan.map φ).app Y =
        (L.lan.map φ).app (L.obj j.left) ≫ (L.leftKanExtension F₂).map j.hom :=
      fun j => (L.lan.map φ).naturality j.hom
    have hfac : ∀ j : CostructuredArrow L Y,
        (L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left) =
        φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left := fun j =>
      Functor.descOfIsLeftKanExtension_fac_app (L.leftKanExtension F₁)
        (L.leftKanExtensionUnit F₁) (L.leftKanExtension F₂) (φ ≫ L.leftKanExtensionUnit F₂) j.left
    refine (Iso.inv_comp_eq _).1 ?_
    apply Limits.colimit.hom_ext
    intro j
    have key : (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
        (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom =
        φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
      calc (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
            (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom
          = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.leftKanExtension F₁).map j.hom ≫
            (L.lan.map φ).app Y) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _).symm
        _ = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.lan.map φ).app (L.obj j.left) ≫
            (L.leftKanExtension F₂).map j.hom) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg (fun k => (L.leftKanExtensionUnit F₁).app j.left ≫ k ≫
              (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hnat j)
        _ = ((L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left)) ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            (congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _)).trans
              (Category.assoc _ _ _).symm
        _ = (φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left) ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg (· ≫ (L.leftKanExtension F₂).map j.hom ≫
              (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hfac j)
        _ = φ.app j.left ≫ ((L.leftKanExtensionUnit F₂).app j.left ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom) :=
            Category.assoc _ _ _
        _ = φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
            congrArg (φ.app j.left ≫ ·) (Functor.ι_leftKanExtensionObjIsoColimit_hom L F₂ Y j)
    erw [Functor.ι_leftKanExtensionObjIsoColimit_inv_assoc, Limits.ι_colimMap]
    exact key

  have lan_pfl : ∀ {C D : Type (u+1)} [Category.{u} C]
      [Category.{u} D] (L : C ⥤ D)
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F],
      (∀ Y : D, Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
          (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim)) →
      (∀ Y : D, ∃ (I : Type u) (G : Discrete I ⥤ CostructuredArrow L Y), G.Final) →
      Limits.PreservesFiniteLimits
        (L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) := by
    intro C D _ _ L _ _ hiso hfin
    constructor
    intro J _ _
    apply Limits.preservesLimitsOfShape_of_evaluation
    intro Y
    obtain ⟨θ⟩ := hiso Y
    obtain ⟨I, G, hG⟩ := hfin Y
    haveI : HasExactColimitsOfShape (Discrete I) AddCommGrpCat.{u+1} :=
      HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1}
        (Discrete.equivalence (Equiv.ulift : ULift.{u+1} I ≃ I))
    let e2 : (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
        ((Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj G ⋙ Limits.colim) ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim :=
      Functor.isoWhiskerLeft _ (Functor.Final.colimIso G)
    exact Limits.preservesLimitsOfShape_of_natIso (e2 ≪≫ θ.symm)

  haveI hlan : Limits.PreservesFiniteLimits ((Over.forget U).op.lan :
      ((Over U)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) ⥤ ((S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})) :=
    lan_pfl (Over.forget U).op (fun Y => lan_eval_iso (Over.forget U).op Y)
      (fun Y => hfinal Y.unop)
  let G := (Over.forget U).sheafPushforwardContinuous AddCommGrpCat.{u+1}
    ((Scheme.ProEt.topology S).over U) (Scheme.ProEt.topology S)
  let F := (Over.forget U).sheafPullback AddCommGrpCat.{u+1}
    ((Scheme.ProEt.topology S).over U) (Scheme.ProEt.topology S)
  let adj : F ⊣ G := (Over.forget U).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
    ((Scheme.ProEt.topology S).over U) (Scheme.ProEt.topology S)
  haveI : Limits.PreservesColimitsOfSize.{0, 0} F := adj.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits F :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits F
  haveI : G.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isRightAdjoint G
  haveI : G.Additive := Functor.additive_of_preserves_binary_products G
  haveI : F.Additive := adj.left_adjoint_additive
  haveI : Limits.PreservesFiniteLimits F := by
    show Limits.PreservesFiniteLimits ((Over.forget U).sheafPullback AddCommGrpCat.{u+1}
      ((Scheme.ProEt.topology S).over U) (Scheme.ProEt.topology S))
    infer_instance
  exact ⟨F, adj, inferInstance, inferInstance, inferInstance⟩

theorem sheafOfModules_toSheaf_exact_left_adjoint : ∀ {C : Type (u+1)} [Category.{u} C]
    (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
    (R : Sheaf J RingCat.{u+1}),
    (∀ (V : Cᵒᵖ) (m : ℕ), m ≠ 0 → IsUnit (m : ↑(R.obj.obj V))) →
    ∃ (L : Sheaf J AddCommGrpCat.{u+1} ⥤ SheafOfModules.{u+1} R) (_ : L ⊣ SheafOfModules.toSheaf.{u+1} R),
      L.Additive ∧ Limits.PreservesFiniteLimits L ∧ Limits.PreservesFiniteColimits L :=
by
  intro C _ J _ _ R hunit

  have hflat : ∀ V : Cᵒᵖ, Module.Flat ℤ (R.obj.obj V) := by
    intro V
    rw [Module.Flat.flat_iff_torsion_eq_bot_of_isBezout, Submodule.eq_bot_iff]
    intro x hx
    obtain ⟨a, ha⟩ := (Submodule.mem_torsion_iff x).mp hx
    have ha' : ((a : ℤ) : R.obj.obj V) * x = 0 := by
      rw [← zsmul_eq_mul]; exact ha
    have hk : (a : ℤ) ≠ 0 := nonZeroDivisors.coe_ne_zero a
    generalize (a : ℤ) = k at ha' hk
    obtain ⟨n, hn | hn⟩ := Int.eq_nat_or_neg k
    · subst hn
      have hn0 : n ≠ 0 := by exact_mod_cast hk
      rw [Int.cast_natCast] at ha'
      exact (IsUnit.mul_right_eq_zero (hunit V n hn0)).mp ha'
    · subst hn
      have hn0 : n ≠ 0 := by intro h; apply hk; simp [h]
      rw [Int.cast_neg, Int.cast_natCast] at ha'
      exact (IsUnit.mul_right_eq_zero (hunit V n hn0).neg).mp ha'

  haveI hTA : (somTensorFunctor R.obj).Additive := (somTensorAdj R.obj).left_adjoint_additive
  haveI hTL : Limits.PreservesFiniteLimits (somTensorFunctor R.obj) := by
    haveI : Limits.PreservesFiniteLimits
        (somTensorFunctor R.obj ⋙ PresheafOfModules.toPresheaf R.obj) := by
      apply preservesFiniteLimits_of_evaluation
      intro X
      haveI := hflat X
      have key : ∀ {P Q : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}} (g : P ⟶ Q),
          (⇑(ConcreteCategory.hom (((somTensorFunctor R.obj ⋙ PresheafOfModules.toPresheaf R.obj) ⋙
            (evaluation Cᵒᵖ AddCommGrpCat.{u+1}).obj X).map g)) :
              TensorProduct ℤ (R.obj.obj X) (P.obj X) → TensorProduct ℤ (R.obj.obj X) (Q.obj X)) =
            ⇑(LinearMap.lTensor (R.obj.obj X) (g.app X).hom.toIntLinearMap) := by
        intro P Q g
        funext t
        induction t using TensorProduct.induction_on with
        | zero => exact (map_zero _).trans (map_zero _).symm
        | tmul r p =>
          change r • ((1 : R.obj.obj X) ⊗ₜ[ℤ] (g.app X).hom p) = r ⊗ₜ[ℤ] (g.app X).hom p
          show (r • (1 : R.obj.obj X)) ⊗ₜ[ℤ] (g.app X).hom p = _
          rw [smul_eq_mul, mul_one]
        | add x y hx hy =>
          refine ((ConcreteCategory.hom (((somTensorFunctor R.obj ⋙
            PresheafOfModules.toPresheaf R.obj) ⋙
            (evaluation Cᵒᵖ AddCommGrpCat.{u+1}).obj X).map g)).map_add x y).trans ?_
          rw [map_add]
          exact congrArg₂ (· + ·) hx hy
      rw [Functor.preservesFiniteLimits_iff_forall_exact_map_and_mono]
      intro S hS
      have hS' := hS.map_of_exact ((evaluation Cᵒᵖ AddCommGrpCat.{u+1}).obj X)
      have hE := (ShortComplex.ab_exact_iff_function_exact _).mp hS'.exact
      have hM := (AddCommGrpCat.mono_iff_injective _).mp hS'.mono_f
      refine ⟨?_, ?_⟩
      · rw [ShortComplex.ab_exact_iff_function_exact]
        change Function.Exact
          ⇑(ConcreteCategory.hom (((somTensorFunctor R.obj ⋙ PresheafOfModules.toPresheaf R.obj) ⋙
            (evaluation Cᵒᵖ AddCommGrpCat.{u+1}).obj X).map S.f))
          ⇑(ConcreteCategory.hom (((somTensorFunctor R.obj ⋙ PresheafOfModules.toPresheaf R.obj) ⋙
            (evaluation Cᵒᵖ AddCommGrpCat.{u+1}).obj X).map S.g))
        rw [key S.f, key S.g]
        exact Module.Flat.lTensor_exact _ hE
      · rw [AddCommGrpCat.mono_iff_injective, key S.f]
        exact Module.Flat.lTensor_preserves_injective_linearMap _ hM
    exact Limits.preservesFiniteLimits_of_reflects_of_preserves _
      (PresheafOfModules.toPresheaf R.obj)

  haveI hSL : Limits.PreservesFiniteLimits
      (PresheafOfModules.sheafification (J := J) (𝟙 R.obj)) := by
    haveI : Limits.PreservesFiniteLimits (PresheafOfModules.sheafification (J := J) (𝟙 R.obj) ⋙
        SheafOfModules.toSheaf.{u+1} R) :=
      Limits.preservesFiniteLimits_of_natIso
        (PresheafOfModules.sheafificationCompToSheaf (𝟙 R.obj)).symm
    exact Limits.preservesFiniteLimits_of_reflects_of_preserves _ (SheafOfModules.toSheaf.{u+1} R)

  have adj : sheafToPresheaf J AddCommGrpCat.{u+1} ⋙
      (somTensorFunctor R.obj ⋙ PresheafOfModules.sheafification (J := J) (𝟙 R.obj)) ⊣
      SheafOfModules.toSheaf.{u+1} R :=
    Adjunction.restrictFullyFaithful
      ((somTensorAdj R.obj).comp (PresheafOfModules.sheafificationAdjunction (J := J) (𝟙 R.obj)))
      (fullyFaithfulSheafToPresheaf J AddCommGrpCat.{u+1}) (Functor.FullyFaithful.id _)
      (L := sheafToPresheaf J AddCommGrpCat.{u+1} ⋙
        (somTensorFunctor R.obj ⋙ PresheafOfModules.sheafification (J := J) (𝟙 R.obj)))
      (R := SheafOfModules.toSheaf.{u+1} R)
      (Functor.rightUnitor _).symm (Iso.refl _)
  refine ⟨_, adj, adj.left_adjoint_additive, inferInstance, ?_⟩
  haveI := adj.isLeftAdjoint
  infer_instance

theorem wc_slice_free_data : ∀ (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)],
    ∃ (Z : Sheaf ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h)) AddCommGrpCat.{u+1})
      (ε₁ : Z ⟶ ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)).obj
        (wcFreeSheaf X.left (wcGeomPoint F X h)))
      (ε₂ : Z ⟶ (SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)).obj (SheafOfModules.unit (wcSliceRing F X h ℓ)))
      (ρ : Z ⟶ ((Scheme.ProEt.topology X.left).overMapPullback AddCommGrpCat.{u+1} (wcGeomFrob F X h)).obj Z),
      (∀ Y : Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1},
        Function.Bijective (fun f : wcFreeSheaf X.left (wcGeomPoint F X h) ⟶ Y =>
          ε₁ ≫ ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)).map f)) ∧
      (∀ M : SheafOfModules.{u+1} (wcSliceRing F X h ℓ),
        Function.Bijective (fun f : SheafOfModules.unit (wcSliceRing F X h ℓ) ⟶ M =>
          ε₂ ≫ (SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)).map f)) ∧
      ε₁ ≫ ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)).map
          (wcFreeSheafMap X.left (wcGeomFrob F X h)) =
        ρ ≫ ((Scheme.ProEt.topology X.left).overMapPullback AddCommGrpCat.{u+1} (wcGeomFrob F X h)).map ε₁ ∧
      ε₂ = ρ ≫ ((Scheme.ProEt.topology X.left).overMapPullback AddCommGrpCat.{u+1} (wcGeomFrob F X h)).map ε₂ :=
by
  intro F _ _ X h ℓ _

  have s1 : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
      [HasWeakSheafify J AddCommGrpCat.{u+1}] (T : C) (Fs : Sheaf J AddCommGrpCat.{u+1}),
      Function.Bijective (fun φ : (presheafToSheaf J AddCommGrpCat.{u+1}).obj
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Fs =>
        φ.hom.app (Opposite.op T)
          ((toSheafify J (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
            (Opposite.op T) (FreeAbelianGroup.of (ULift.up (𝟙 T))))) := by
    intro C _ J _ T Fs
    let e2 : ∀ G : Cᵒᵖ ⥤ AddCommGrpCat.{u+1},
        (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ G) ≃ G.obj (Opposite.op T) :=
      fun G => ((Adjunction.whiskerRight Cᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u}) G).trans
          (uliftYonedaEquiv.{u+1} (X := T) (F := G ⋙ forget AddCommGrpCat.{u+1}))
    have he2 : ∀ (G : Cᵒᵖ ⥤ AddCommGrpCat.{u+1})
        (ψ : yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ G),
        e2 G ψ = ψ.app (Opposite.op T) (FreeAbelianGroup.of (ULift.up (𝟙 T))) := by
      intro G ψ
      rfl
    let e : ((presheafToSheaf J AddCommGrpCat.{u+1}).obj
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Fs) ≃
          Fs.obj.obj (Opposite.op T) :=
      ((sheafificationAdjunction J AddCommGrpCat.{u+1}).homEquiv
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) Fs).trans (e2 Fs.obj)
    have he : ∀ φ, e φ = φ.hom.app (Opposite.op T)
          ((toSheafify J (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
            (Opposite.op T) (FreeAbelianGroup.of (ULift.up (𝟙 T)))) := by
      intro φ
      show e2 Fs.obj ((sheafificationAdjunction J AddCommGrpCat.{u+1}).homEquiv
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) Fs φ) = _
      rw [he2, Adjunction.homEquiv_unit, sheafificationAdjunction_unit_app]
      rfl
    have hfun : (fun φ : (presheafToSheaf J AddCommGrpCat.{u+1}).obj
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Fs =>
        φ.hom.app (Opposite.op T)
          ((toSheafify J (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
            (Opposite.op T) (FreeAbelianGroup.of (ULift.up (𝟙 T))))) = ⇑e :=
      funext fun φ => (he φ).symm
    rw [hfun]
    exact e.bijective

  have s2 : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
      [HasWeakSheafify J AddCommGrpCat.{u+1}] {T T' : C} (g : T ⟶ T'),
      ((presheafToSheaf J AddCommGrpCat.{u+1}).map
          (Functor.whiskerRight (yoneda.map g) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))).hom.app
          (Opposite.op T)
          ((toSheafify J (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
            (Opposite.op T) (FreeAbelianGroup.of (ULift.up (𝟙 T)))) =
        ((presheafToSheaf J AddCommGrpCat.{u+1}).obj
          (yoneda.obj T' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).obj.map g.op
          ((toSheafify J (yoneda.obj T' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
            (Opposite.op T') (FreeAbelianGroup.of (ULift.up (𝟙 T')))) := by
    intro C _ J _ T T' g
    have h1 : (toSheafify J (yoneda.obj T' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
          (Opposite.op T)
        ((Functor.whiskerRight (yoneda.map g) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
          (Opposite.op T) (FreeAbelianGroup.of (ULift.up (𝟙 T)))) =
        (sheafifyMap J (Functor.whiskerRight (yoneda.map g)
            (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))).app (Opposite.op T)
          ((toSheafify J (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
            (Opposite.op T) (FreeAbelianGroup.of (ULift.up (𝟙 T)))) := by
      have hn := NatTrans.congr_app (toSheafify_naturality J
        (Functor.whiskerRight (yoneda.map g) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)))
        (Opposite.op T)
      rw [NatTrans.comp_app, NatTrans.comp_app] at hn
      exact ConcreteCategory.congr_hom hn _
    have h2 := NatTrans.naturality_apply
      (toSheafify J (yoneda.obj T' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) g.op
      (FreeAbelianGroup.of (ULift.up (𝟙 T')))
    have h3 : (Functor.whiskerRight (yoneda.map g)
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app (Opposite.op T)
          (FreeAbelianGroup.of (ULift.up (𝟙 T))) =
        (yoneda.obj T' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map g.op
          (FreeAbelianGroup.of (ULift.up (𝟙 T'))) := by
      show FreeAbelianGroup.of (ULift.up (𝟙 T ≫ g)) = FreeAbelianGroup.of (ULift.up (g ≫ 𝟙 T'))
      rw [Category.id_comp, Category.comp_id]
    exact (h1.symm.trans (congrArg _ h3)).trans h2

  have s3 : ∀ {C : Type (u+1)} [Category.{u} C]
      (J : GrothendieckTopology C) (R : Sheaf J RingCat.{u+1}) (T : C), Limits.IsTerminal T →
      ∀ M : SheafOfModules.{u+1} R,
      Function.Bijective (fun f : SheafOfModules.unit R ⟶ M =>
        f.val.app (Opposite.op T) (1 : R.obj.obj (Opposite.op T))) := by
    intro C _ J R T hT M
    have hev : Function.Bijective (fun s : M.val.sections =>
        (show M.val.obj (Opposite.op T) from s.1 (Opposite.op T))) := by
      constructor
      · intro s s' hss
        apply Subtype.ext
        funext X
        have e1 := s.2 (hT.from X.unop).op
        have e2 := s'.2 (hT.from X.unop).op
        simp only at hss
        rw [← e1, ← e2, hss]
      · intro m
        refine ⟨PresheafOfModules.sectionsMk (fun X => M.val.map (hT.from X.unop).op m) ?_, ?_⟩
        · intro X Y f
          rw [← PresheafOfModules.map_comp_apply]
          exact PresheafOfModules.congr_map_apply M.val (Quiver.Hom.unop_inj (hT.hom_ext _ _)) m
        · change M.val.map (hT.from T).op m = m
          rw [show hT.from T = 𝟙 T from hT.hom_ext _ _]
          simp only [op_id, PresheafOfModules.map_id]
          rfl
    have hfun : (fun f : SheafOfModules.unit R ⟶ M =>
        f.val.app (Opposite.op T) (1 : R.obj.obj (Opposite.op T))) =
        (fun s : M.val.sections =>
          (show M.val.obj (Opposite.op T) from s.1 (Opposite.op T))) ∘
            ⇑(SheafOfModules.unitHomEquiv M) := by
      funext f
      simp [SheafOfModules.unitHomEquiv_apply_coe]
    rw [hfun]
    exact hev.comp (SheafOfModules.unitHomEquiv M).bijective

  have bij_help : ∀ {α β γ : Type (u+1)} (ev : β → γ) (Θ : α → β) (e : α → γ),
      Function.Bijective ev → Function.Bijective e → (∀ a, ev (Θ a) = e a) →
      Function.Bijective Θ := by
    intro α β γ ev Θ e hev he hc
    refine ⟨fun a b hab => he.1 ((hc a).symm.trans ((congrArg ev hab).trans (hc b))), fun b => ?_⟩
    obtain ⟨a, ha⟩ := he.2 (ev b)
    exact ⟨a, hev.1 ((hc a).trans ha)⟩

  have key : ∀ (S : Scheme.{u}) (U : S.ProEt) (g : U ⟶ U),
      ∃ (Z : Sheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1})
        (ε₁ : Z ⟶ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj
          (wcFreeSheaf S U))
        (ε₂ : Z ⟶ (SheafOfModules.toSheaf.{u+1} ((wcRingSheaf S ℓ).over U)).obj
          (SheafOfModules.unit ((wcRingSheaf S ℓ).over U)))
        (ρ : Z ⟶ ((Scheme.ProEt.topology S).overMapPullback AddCommGrpCat.{u+1} g).obj Z),
        (∀ Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
          Function.Bijective (fun f : wcFreeSheaf S U ⟶ Y =>
            ε₁ ≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).map f)) ∧
        (∀ M : SheafOfModules.{u+1} ((wcRingSheaf S ℓ).over U),
          Function.Bijective (fun f : SheafOfModules.unit ((wcRingSheaf S ℓ).over U) ⟶ M =>
            ε₂ ≫ (SheafOfModules.toSheaf.{u+1} ((wcRingSheaf S ℓ).over U)).map f)) ∧
        ε₁ ≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).map
            (wcFreeSheafMap S g) =
          ρ ≫ ((Scheme.ProEt.topology S).overMapPullback AddCommGrpCat.{u+1} g).map ε₁ ∧
        ε₂ = ρ ≫ ((Scheme.ProEt.topology S).overMapPullback AddCommGrpCat.{u+1} g).map ε₂ := by
    intro S U g
    obtain ⟨Z, γ, hZ⟩ : ∃ (Z : Sheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1})
        (γ : Z.obj.obj (Opposite.op (Over.mk (𝟙 U)))),
        ∀ Fs : Sheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1},
          Function.Bijective (fun φ : Z ⟶ Fs => φ.hom.app (Opposite.op (Over.mk (𝟙 U))) γ) :=
      ⟨(presheafToSheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}).obj
          (yoneda.obj (Over.mk (𝟙 U)) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free),
        (toSheafify ((Scheme.ProEt.topology S).over U)
          (yoneda.obj (Over.mk (𝟙 U)) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
          (Opposite.op (Over.mk (𝟙 U))) (FreeAbelianGroup.of (ULift.up (𝟙 (Over.mk (𝟙 U))))),
        fun Fs => s1 ((Scheme.ProEt.topology S).over U) (Over.mk (𝟙 U)) Fs⟩
    obtain ⟨γU, hUb, hUg⟩ : ∃ γU : (wcFreeSheaf S U).obj.obj (Opposite.op U),
        (∀ Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
          Function.Bijective (fun f : wcFreeSheaf S U ⟶ Y => f.hom.app (Opposite.op U) γU)) ∧
        (wcFreeSheafMap S g).hom.app (Opposite.op U) γU =
          (wcFreeSheaf S U).obj.map g.op γU :=
      ⟨(toSheafify (Scheme.ProEt.topology S)
          (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
          (Opposite.op U) (FreeAbelianGroup.of (ULift.up (𝟙 U))),
        fun Y => s1 (Scheme.ProEt.topology S) U Y, s2 (Scheme.ProEt.topology S) g⟩
    obtain ⟨k, hk⟩ : ∃ k : (Over.map g).obj (Over.mk (𝟙 U)) ⟶ Over.mk (𝟙 U), k.left = g :=
      ⟨Over.homMk g, rfl⟩
    have hT : Limits.IsTerminal (Over.mk (𝟙 U)) := Over.mkIdTerminal
    obtain ⟨ε₁, e1⟩ := (hZ (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj
      (wcFreeSheaf S U))).2 γU
    obtain ⟨ε₂, e2⟩ := (hZ ((SheafOfModules.toSheaf.{u+1} ((wcRingSheaf S ℓ).over U)).obj
      (SheafOfModules.unit ((wcRingSheaf S ℓ).over U)))).2
      (1 : ((wcRingSheaf S ℓ).over U).obj.obj (Opposite.op (Over.mk (𝟙 U))))
    obtain ⟨ρ, e3⟩ := (hZ (((Scheme.ProEt.topology S).overMapPullback AddCommGrpCat.{u+1} g).obj
      Z)).2 (Z.obj.map k.op γ)
    refine ⟨Z, ε₁, ε₂, ρ, ?_, ?_, ?_, ?_⟩
    · intro Y
      refine bij_help
        (fun φ : Z ⟶ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj Y =>
          φ.hom.app (Opposite.op (Over.mk (𝟙 U))) γ)
        (fun f : wcFreeSheaf S U ⟶ Y =>
          ε₁ ≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).map f)
        (fun f : wcFreeSheaf S U ⟶ Y => f.hom.app (Opposite.op U) γU)
        (hZ _) (hUb Y) (fun f => ?_)
      exact congrArg (fun x => (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).map
        f).hom.app (Opposite.op (Over.mk (𝟙 U))) x) e1
    · intro M
      refine bij_help
        (fun φ : Z ⟶ (SheafOfModules.toSheaf.{u+1} ((wcRingSheaf S ℓ).over U)).obj M =>
          φ.hom.app (Opposite.op (Over.mk (𝟙 U))) γ)
        (fun f : SheafOfModules.unit ((wcRingSheaf S ℓ).over U) ⟶ M =>
          ε₂ ≫ (SheafOfModules.toSheaf.{u+1} ((wcRingSheaf S ℓ).over U)).map f)
        (fun f : SheafOfModules.unit ((wcRingSheaf S ℓ).over U) ⟶ M =>
          f.val.app (Opposite.op (Over.mk (𝟙 U)))
            (1 : ((wcRingSheaf S ℓ).over U).obj.obj (Opposite.op (Over.mk (𝟙 U)))))
        (hZ _) (s3 _ ((wcRingSheaf S ℓ).over U) (Over.mk (𝟙 U)) hT M) (fun f => ?_)
      exact congrArg (fun x => ((SheafOfModules.toSheaf.{u+1} ((wcRingSheaf S ℓ).over U)).map
        f).hom.app (Opposite.op (Over.mk (𝟙 U))) x) e2
    · apply (hZ _).1
      have p1 := congrArg (fun x => (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1}
        U).map (wcFreeSheafMap S g)).hom.app (Opposite.op (Over.mk (𝟙 U))) x) e1
      have n1 := NatTrans.naturality_apply ε₁.hom k.op γ
      have q3 := congrArg (fun x => ε₁.hom.app
        (Opposite.op ((Over.map g).obj (Over.mk (𝟙 U)))) x) e3
      have q1 := congrArg (fun x => (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1}
        U).obj (wcFreeSheaf S U)).obj.map k.op x) e1
      have hkU : (wcFreeSheaf S U).obj.map k.left.op γU = (wcFreeSheaf S U).obj.map g.op γU := by
        rw [hk]
      exact p1.trans (hUg.trans (hkU.symm.trans (q1.symm.trans (n1.symm.trans q3.symm))))
    · apply (hZ _).1
      have n2 := NatTrans.naturality_apply ε₂.hom k.op γ
      have m1 := map_one (((wcRingSheaf S ℓ).over U).obj.map k.op).hom
      have q3 := congrArg (fun x => ε₂.hom.app
        (Opposite.op ((Over.map g).obj (Over.mk (𝟙 U)))) x) e3
      have q2 := congrArg (fun x => ((SheafOfModules.toSheaf.{u+1} ((wcRingSheaf S ℓ).over U)).obj
        (SheafOfModules.unit ((wcRingSheaf S ℓ).over U))).obj.map k.op x) e2
      exact e2.trans (m1.symm.trans (q2.symm.trans (n2.symm.trans q3.symm)))
  exact key X.left (wcGeomPoint F X h) (wcGeomFrob F X h)

theorem wc_slice_ladic_unit_iso : ∀ (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)],
    ∃ ι : (SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)).obj (SheafOfModules.unit (wcSliceRing F X h ℓ)) ≅
        ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)).obj
          (wcLadicSheaf X.left ℓ),
      (∀ c : ℚ_[ℓ], (SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)).map (wcModConst F X h ℓ c) ≫ ι.hom =
        ι.hom ≫ ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)).map
          (wcLadicScalar X.left ℓ c)) ∧
      ((Scheme.ProEt.topology X.left).overMapPullback AddCommGrpCat.{u+1} (wcGeomFrob F X h)).map ι.hom =
        ι.hom :=
by
  intro F _ _ X h ℓ _
  let G1 := (SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)).obj
    (SheafOfModules.unit (wcSliceRing F X h ℓ))
  let jQ := ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1}
    (wcGeomPoint F X h)).obj (wcLadicSheaf X.left ℓ)
  let e : ∀ V : (Over (wcGeomPoint F X h))ᵒᵖ, G1.obj.obj V ≅ jQ.obj.obj V := fun V =>
    { hom := AddCommGrpCat.ofHom
        { toFun := fun r => (ULift.up ((ContinuousMap.mk ULift.down continuous_uliftDown).comp
              (r : C(↥V.unop.left.left, ULift.{u+1} ℚ_[ℓ]))) :
              ULift.{u+1} C(↥V.unop.left.left, ℚ_[ℓ]))
          map_zero' := ULift.ext _ _ (ContinuousMap.ext fun _ => rfl)
          map_add' := fun _ _ => ULift.ext _ _ (ContinuousMap.ext fun _ => rfl) }
      inv := AddCommGrpCat.ofHom
        { toFun := fun w => ((ContinuousMap.mk ULift.up continuous_uliftUp).comp
              (w.down : C(↥V.unop.left.left, ℚ_[ℓ])) : C(↥V.unop.left.left, ULift.{u+1} ℚ_[ℓ]))
          map_zero' := ContinuousMap.ext fun _ => rfl
          map_add' := fun _ _ => ContinuousMap.ext fun _ => rfl }
      hom_inv_id := by
        apply AddCommGrpCat.ext
        intro r
        rfl
      inv_hom_id := by
        apply AddCommGrpCat.ext
        intro w
        rfl }
  let N : G1.obj ≅ jQ.obj := NatIso.ofComponents e (fun {V W} f => by
    apply AddCommGrpCat.ext
    intro r
    rfl)
  let ι : G1 ≅ jQ := ObjectProperty.isoMk _ N
  refine ⟨ι, fun c => ?_, ?_⟩
  · apply Sheaf.hom_ext
    apply NatTrans.ext
    funext V
    apply AddCommGrpCat.ext
    intro r
    change (ULift.up ((ContinuousMap.mk ULift.down continuous_uliftDown).comp
        ((@id C(↥V.unop.left.left, ULift.{u+1} ℚ_[ℓ]) r) * ContinuousMap.const _ (ULift.up c))) :
          ULift.{u+1} C(↥V.unop.left.left, ℚ_[ℓ])) =
      ULift.up (c • (ContinuousMap.mk ULift.down continuous_uliftDown).comp
        (@id C(↥V.unop.left.left, ULift.{u+1} ℚ_[ℓ]) r))
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    show ((@id C(↥V.unop.left.left, ULift.{u+1} ℚ_[ℓ]) r) t).down * c =
      c * ((@id C(↥V.unop.left.left, ULift.{u+1} ℚ_[ℓ]) r) t).down
    exact mul_comm _ _
  · apply Sheaf.hom_ext
    apply NatTrans.ext
    funext V
    apply AddCommGrpCat.ext
    intro r
    rfl

theorem wc_slice_frob_ext_comparison : ∀ (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    [hA : (SheafOfModules.pushforward.{u+1} (F := Over.map (wcGeomFrob F X h))
      (J := (Scheme.ProEt.topology X.left).over (wcGeomPoint F X h))
      (K := (Scheme.ProEt.topology X.left).over (wcGeomPoint F X h))
      (S := wcSliceRing F X h ℓ) (R := wcSliceRing F X h ℓ) (𝟙 (wcSliceRing F X h ℓ))).Additive]
    [hL : Limits.PreservesFiniteLimits (SheafOfModules.pushforward.{u+1} (F := Over.map (wcGeomFrob F X h))
      (J := (Scheme.ProEt.topology X.left).over (wcGeomPoint F X h))
      (K := (Scheme.ProEt.topology X.left).over (wcGeomPoint F X h))
      (S := wcSliceRing F X h ℓ) (R := wcSliceRing F X h ℓ) (𝟙 (wcSliceRing F X h ℓ)))]
    [hC : Limits.PreservesFiniteColimits (SheafOfModules.pushforward.{u+1} (F := Over.map (wcGeomFrob F X h))
      (J := (Scheme.ProEt.topology X.left).over (wcGeomPoint F X h))
      (K := (Scheme.ProEt.topology X.left).over (wcGeomPoint F X h))
      (S := wcSliceRing F X h ℓ) (R := wcSliceRing F X h ℓ) (𝟙 (wcSliceRing F X h ℓ)))],
    letI : HasExt (SheafOfModules.{u+1} (wcSliceRing F X h ℓ)) := HasExt.standard _
    ∃ T : ∀ n : ℕ, wcCoh F X h ℓ n ≃+ wcModCoh F X h ℓ n,
      (∀ (n : ℕ) (c : ℚ_[ℓ]) (x : wcCoh F X h ℓ n),
        T n (wcCohScalar F X h ℓ n c x) = wcModScalar F X h ℓ n c (T n x)) ∧
      ∀ (n : ℕ) (x : wcCoh F X h ℓ n),
        T n (wcCohFrob F X h ℓ n x) = Abelian.Ext.mapExactFunctor
          (SheafOfModules.pushforward.{u+1} (F := Over.map (wcGeomFrob F X h))
            (J := (Scheme.ProEt.topology X.left).over (wcGeomPoint F X h))
            (K := (Scheme.ProEt.topology X.left).over (wcGeomPoint F X h))
            (S := wcSliceRing F X h ℓ) (R := wcSliceRing F X h ℓ) (𝟙 (wcSliceRing F X h ℓ))) (T n x) :=
by
  classical
  intro F _ _ X h ℓ _ hA hL hC
  letI hM : HasExt (SheafOfModules.{u+1} (wcSliceRing F X h ℓ)) := HasExt.standard _
  letI hD : HasExt (Sheaf ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h))
      AddCommGrpCat.{u+1}) := HasExt.standard _

  obtain ⟨Z, ε₁, ε₂, ρ, H1, H2, F1, F2⟩ := wc_slice_free_data F X h ℓ
  obtain ⟨ι, I1, I2⟩ := wc_slice_ladic_unit_iso F X h ℓ

  obtain ⟨hjA, hjC⟩ := sheafPushforward_additive_finiteColimits
    ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h)) (Scheme.ProEt.topology X.left)
    (Over.forget (wcGeomPoint F X h))
  obtain ⟨hΦA, hΦC⟩ := sheafPushforward_additive_finiteColimits
    ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h))
    ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h)) (Over.map (wcGeomFrob F X h))
  have hGC := sheafOfModules_toSheaf_preservesFiniteColimits
    ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h)) (wcSliceRing F X h ℓ)
  obtain ⟨L₁, adj₁, hL₁A, hL₁L, hL₁C⟩ :=
    proet_overPullback_exact_left_adjoint X.left (wcGeomPoint F X h)
  have hunit : ∀ (V : (Over (wcGeomPoint F X h))ᵒᵖ) (m : ℕ), m ≠ 0 →
      IsUnit (m : ↑((wcSliceRing F X h ℓ).obj.obj V)) := by
    intro V m hm
    have hm' : (m : ℚ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr hm
    change IsUnit (m : C(↥((Opposite.unop V).left.left), ULift.{u+1} ℚ_[ℓ]))
    refine isUnit_iff_exists_inv.mpr ⟨ContinuousMap.const _ (ULift.up ((m : ℚ_[ℓ])⁻¹)), ?_⟩
    refine ContinuousMap.ext fun t => ULift.ext _ _ ?_
    simp [hm']
  obtain ⟨L₂, adj₂, hL₂A, hL₂L, hL₂C⟩ := sheafOfModules_toSheaf_exact_left_adjoint
    ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h)) (wcSliceRing F X h ℓ) hunit

  obtain ⟨Am, hAm⟩ : ∃ Am : ∀ n, wcCoh F X h ℓ n →+ Abelian.Ext Z
      (((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)).obj
        (wcLadicSheaf X.left ℓ)) n,
      ∀ n x, Am n x = (Abelian.Ext.mk₀ ε₁).comp (Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)) x)
          (zero_add n) :=
    ⟨fun n => AddMonoidHom.mk' (fun x => (Abelian.Ext.mk₀ ε₁).comp (Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)) x)
          (zero_add n))
      (fun a b => by rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.comp_add]), fun _ _ => rfl⟩
  obtain ⟨Bm, hBm⟩ : ∃ Bm : ∀ n, wcModCoh F X h ℓ n →+ Abelian.Ext Z
      ((SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)).obj (SheafOfModules.unit (wcSliceRing F X h ℓ))) n,
      ∀ n β, Bm n β = (Abelian.Ext.mk₀ ε₂).comp (Abelian.Ext.mapExactFunctor
        (SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)) β) (zero_add n) :=
    ⟨fun n => AddMonoidHom.mk' (fun β => (Abelian.Ext.mk₀ ε₂).comp (Abelian.Ext.mapExactFunctor
        (SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)) β) (zero_add n))
      (fun a b => by rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.comp_add]), fun _ _ => rfl⟩
  obtain ⟨Pe, hPe⟩ : ∃ Pe : ∀ n, Abelian.Ext Z
      (((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)).obj
        (wcLadicSheaf X.left ℓ)) n ≃+ Abelian.Ext Z
      ((SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)).obj (SheafOfModules.unit (wcSliceRing F X h ℓ))) n,
      ∀ n z, Pe n z = z.comp (Abelian.Ext.mk₀ ι.inv) (add_zero n) :=
    ⟨fun n =>
      { toFun := fun z => z.comp (Abelian.Ext.mk₀ ι.inv) (add_zero n)
        invFun := fun z => z.comp (Abelian.Ext.mk₀ ι.hom) (add_zero n)
        left_inv := fun z => by
          change (z.comp (Abelian.Ext.mk₀ ι.inv) (add_zero n)).comp (Abelian.Ext.mk₀ ι.hom)
            (add_zero n) = z
          rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
            Abelian.Ext.comp_mk₀_id]
        right_inv := fun z => by
          change (z.comp (Abelian.Ext.mk₀ ι.hom) (add_zero n)).comp (Abelian.Ext.mk₀ ι.inv)
            (add_zero n) = z
          rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
            Abelian.Ext.comp_mk₀_id]
        map_add' := fun a b => Abelian.Ext.add_comp _ _ _ _ }, fun _ _ => rfl⟩
  have hAbij : ∀ n, Function.Bijective (Am n) := by
    intro n
    have e : (⇑(Am n)) = fun x => (Abelian.Ext.mk₀ ε₁).comp (Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)) x)
          (zero_add n) := funext (hAm n)
    rw [e]
    exact ext_transfer_of_hom_bijective L₁
      ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)) adj₁
      Z (wcFreeSheaf X.left (wcGeomPoint F X h)) ε₁ H1 (wcLadicSheaf X.left ℓ) n
  have hB : ∀ n, Function.Bijective (Bm n) := by
    intro n
    have e : (⇑(Bm n)) = fun β => (Abelian.Ext.mk₀ ε₂).comp (Abelian.Ext.mapExactFunctor
        (SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)) β) (zero_add n) := funext (hBm n)
    rw [e]
    exact ext_transfer_of_hom_bijective L₂ (SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)) adj₂
      Z (SheafOfModules.unit (wcSliceRing F X h ℓ)) ε₂ H2 (SheafOfModules.unit (wcSliceRing F X h ℓ)) n
  obtain ⟨T, hT⟩ : ∃ T : ∀ n, wcCoh F X h ℓ n ≃+ wcModCoh F X h ℓ n,
      ∀ n x, Bm n (T n x) = Pe n (Am n x) :=
    ⟨fun n => (AddEquiv.ofBijective (Am n) (hAbij n)).trans
        ((Pe n).trans (AddEquiv.ofBijective (Bm n) (hB n)).symm),
      fun n x => AddEquiv.ofBijective_apply_symm_apply (Bm n) (hB n)⟩

  obtain ⟨φ, hφ⟩ : ∃ φ : ∀ n, wcModCoh F X h ℓ n → wcModCoh F X h ℓ n,
      ∀ n β, φ n β = Abelian.Ext.mapExactFunctor
          (SheafOfModules.pushforward.{u+1} (F := Over.map (wcGeomFrob F X h))
            (J := (Scheme.ProEt.topology X.left).over (wcGeomPoint F X h))
            (K := (Scheme.ProEt.topology X.left).over (wcGeomPoint F X h))
            (S := wcSliceRing F X h ℓ) (R := wcSliceRing F X h ℓ) (𝟙 (wcSliceRing F X h ℓ))) β :=
    ⟨fun n β => Abelian.Ext.mapExactFunctor
          (SheafOfModules.pushforward.{u+1} (F := Over.map (wcGeomFrob F X h))
            (J := (Scheme.ProEt.topology X.left).over (wcGeomPoint F X h))
            (K := (Scheme.ProEt.topology X.left).over (wcGeomPoint F X h))
            (S := wcSliceRing F X h ℓ) (R := wcSliceRing F X h ℓ) (𝟙 (wcSliceRing F X h ℓ))) β,
      fun _ _ => rfl⟩
  have hΦj : ∀ n (x : wcCoh F X h ℓ n),
      Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology X.left).overMapPullback AddCommGrpCat.{u+1} (wcGeomFrob F X h))
        (Abelian.Ext.mapExactFunctor
          ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)) x) =
      Abelian.Ext.mapExactFunctor
          ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)) x := by
    intro n x
    rw [← Abelian.Ext.comp_mapExactFunctor]
    rfl
  let φ0 : wcSliceRing F X h ℓ ⟶ ((Over.map (wcGeomFrob F X h)).sheafPushforwardContinuous
      RingCat.{u+1} ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h))
      ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h))).obj (wcSliceRing F X h ℓ) :=
    𝟙 (wcSliceRing F X h ℓ)
  obtain ⟨hΨA, hΨL, hΨC⟩ := sheafOfModules_pushforward_exact (Over.map (wcGeomFrob F X h))
    (wcSliceRing F X h ℓ) (wcSliceRing F X h ℓ) φ0
  have hGΨ0 : ∀ n (β : wcModCoh F X h ℓ n),
      Abelian.Ext.mapExactFunctor (SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ))
        (Abelian.Ext.mapExactFunctor
          (SheafOfModules.pushforward.{u+1} φ0) β) =
      Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology X.left).overMapPullback AddCommGrpCat.{u+1} (wcGeomFrob F X h))
        (Abelian.Ext.mapExactFunctor (SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)) β) := by
    intro n β
    rw [← Abelian.Ext.comp_mapExactFunctor, ← Abelian.Ext.comp_mapExactFunctor]
    rfl
  have hGΨ : ∀ n (β : wcModCoh F X h ℓ n),
      Abelian.Ext.mapExactFunctor (SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ))
        (φ n β) =
      Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology X.left).overMapPullback AddCommGrpCat.{u+1} (wcGeomFrob F X h))
        (Abelian.Ext.mapExactFunctor (SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)) β) :=
    fun n β => by rw [hφ]; exact hGΨ0 n β
  have hΦι : ((Scheme.ProEt.topology X.left).overMapPullback AddCommGrpCat.{u+1}
      (wcGeomFrob F X h)).map ι.inv = ι.inv :=
    congrArg Iso.inv (Iso.ext (α := ((Scheme.ProEt.topology X.left).overMapPullback
      AddCommGrpCat.{u+1} (wcGeomFrob F X h)).mapIso ι) (β := ι) I2)
  have hι : ∀ c : ℚ_[ℓ],
      ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)).map
        (wcLadicScalar X.left ℓ c) ≫ ι.inv =
      ι.inv ≫ (SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)).map (wcModConst F X h ℓ c) := by
    intro c
    rw [Iso.eq_inv_comp, ← Category.assoc, ← I1, Category.assoc, Iso.hom_inv_id, Category.comp_id]

  have hAF : ∀ n (x : wcCoh F X h ℓ n), Am n (wcCohFrob F X h ℓ n x) =
      (Abelian.Ext.mk₀ ρ).comp (Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology X.left).overMapPullback AddCommGrpCat.{u+1} (wcGeomFrob F X h))
        (Am n x)) (zero_add n) := by
    intro n x
    have hfx : wcCohFrob F X h ℓ n x =
        (Abelian.Ext.mk₀ (wcFreeSheafMap X.left (wcGeomFrob F X h))).comp x (zero_add n) := rfl
    have s1 : Am n (wcCohFrob F X h ℓ n x) = (Abelian.Ext.mk₀ (ε₁ ≫
        ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)).map
          (wcFreeSheafMap X.left (wcGeomFrob F X h)))).comp (Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)) x)
          (zero_add n) := by
      rw [hfx, hAm, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.mk₀_comp_mk₀_assoc]
    rw [F1] at s1
    rw [s1, hAm, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.mk₀_comp_mk₀_assoc]
    exact congrArg (fun y => (Abelian.Ext.mk₀ (ρ ≫ ((Scheme.ProEt.topology X.left).overMapPullback
      AddCommGrpCat.{u+1} (wcGeomFrob F X h)).map ε₁)).comp y (zero_add n)) (hΦj n x).symm
  have hBΨ : ∀ n (β : wcModCoh F X h ℓ n), Bm n (φ n β) =
      (Abelian.Ext.mk₀ ρ).comp (Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology X.left).overMapPullback AddCommGrpCat.{u+1} (wcGeomFrob F X h))
        (Bm n β)) (zero_add n) := by
    intro n β
    have hGφ := hGΨ n β
    rw [hBm, hBm, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.mk₀_comp_mk₀_assoc, ← F2]
    exact congrArg (fun y => (Abelian.Ext.mk₀ ε₂).comp y (zero_add n)) hGφ
  have hAP : ∀ n (x : wcCoh F X h ℓ n), Pe n (Am n (wcCohFrob F X h ℓ n x)) =
      (Abelian.Ext.mk₀ ρ).comp (Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology X.left).overMapPullback AddCommGrpCat.{u+1} (wcGeomFrob F X h))
        (Pe n (Am n x))) (zero_add n) := by
    intro n x
    rw [hPe, hPe, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_assoc_of_third_deg_zero, hAF]
    exact congrArg (fun g => ((Abelian.Ext.mk₀ ρ).comp (Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology X.left).overMapPullback AddCommGrpCat.{u+1} (wcGeomFrob F X h))
        (Am n x)) (zero_add n)).comp (Abelian.Ext.mk₀ g) (add_zero n)) hΦι.symm
  have hTFr : ∀ n (x : wcCoh F X h ℓ n), T n (wcCohFrob F X h ℓ n x) = φ n (T n x) := by
    intro n x
    apply (hB n).1
    rw [hT, hBΨ, hT]
    exact hAP n x
  refine ⟨T, ?_, fun n x => (hTFr n x).trans (hφ n (T n x))⟩
  intro n c x
  apply (hB n).1
  rw [hT]
  have e1 : Am n (wcCohScalar F X h ℓ n c x) = (Am n x).comp (Abelian.Ext.mk₀
      (((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)).map
        (wcLadicScalar X.left ℓ c))) (add_zero n) := by
    have hsc : wcCohScalar F X h ℓ n c x =
        x.comp (Abelian.Ext.mk₀ (wcLadicScalar X.left ℓ c)) (add_zero n) := rfl
    rw [hsc, hAm, hAm, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
    exact (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).symm
  have e2 : ∀ β : wcModCoh F X h ℓ n, Bm n (wcModScalar F X h ℓ n c β) =
      (Bm n β).comp (Abelian.Ext.mk₀
        ((SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)).map (wcModConst F X h ℓ c))) (add_zero n) := by
    intro β
    have hSc : wcModScalar F X h ℓ n c β =
        β.comp (Abelian.Ext.mk₀ (wcModConst F X h ℓ c)) (add_zero n) := rfl
    rw [hSc, hBm, hBm, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
    exact (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).symm
  rw [e1, e2, hT, hPe, hPe, Abelian.Ext.comp_assoc_of_third_deg_zero,
    Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀,
    hι]

theorem wc_xbar_frob_site_adjunction : ∀ (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))),
    ∃ adj : (wcSliceToOver X.left (wcGeomPoint F X h) ⋙ Over.map (wcGeomFrob F X h) ⋙
        wcOverToSlice X.left (wcGeomPoint F X h)) ⊣ wcProEtBC (wcGeomFrobX F X h),
      (∀ W' : (wcGeomPoint F X h).left.ProEt,
        (adj.counit.app W').left = Limits.pullback.fst W'.hom (wcGeomFrobX F X h)) ∧
      (∀ W : (wcGeomPoint F X h).left.ProEt,
        (adj.unit.app W).left ≫ Limits.pullback.fst
          ((wcSliceToOver X.left (wcGeomPoint F X h) ⋙ Over.map (wcGeomFrob F X h) ⋙
            wcOverToSlice X.left (wcGeomPoint F X h)).obj W).hom (wcGeomFrobX F X h) = 𝟙 W.left) :=
by
  intro F _ _ X h
  let Θ := wcSliceToOver X.left (wcGeomPoint F X h) ⋙ Over.map (wcGeomFrob F X h) ⋙
    wcOverToSlice X.left (wcGeomPoint F X h)
  let BC := wcProEtBC (wcGeomFrobX F X h)

  have keyψ : ∀ {T A Y : Scheme.{u}} (a : A ⟶ Y) (g : Y ⟶ Y) (t : T ⟶ Y)
      (kl : T ⟶ Limits.pullback a g), kl ≫ Limits.pullback.snd a g = t →
      (kl ≫ Limits.pullback.fst a g) ≫ a = t ≫ g := by
    intro T A Y a g t kl hk
    rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hk]
  have natH : ∀ {T P P' A B : Scheme.{u}} (p : T ⟶ P) (q : P ⟶ P') (fa : P ⟶ A) (fb : P' ⟶ B)
      (ml : A ⟶ B) (pl : T ⟶ A), q ≫ fb = fa ≫ ml → p ≫ fa = pl → (p ≫ q) ≫ fb = pl ≫ ml := by
    intro T P P' A B p q fa fb ml pl h1 h2
    rw [Category.assoc, h1, ← Category.assoc, h2]
  have natH2 : ∀ {T P P' Y : Scheme.{u}} (p : T ⟶ P) (q : P ⟶ P') (sa : P ⟶ Y) (sb : P' ⟶ Y)
      (t : T ⟶ Y), q ≫ sb = sa → p ≫ sa = t → (p ≫ q) ≫ sb = t := by
    intro T P P' Y p q sa sb t h1 h2
    rw [Category.assoc, h1, h2]
  have hBCfst : ∀ {A B : (wcGeomPoint F X h).left.ProEt} (m : A ⟶ B),
      (BC.map m).left ≫ Limits.pullback.fst B.hom (wcGeomFrobX F X h) =
        Limits.pullback.fst A.hom (wcGeomFrobX F X h) ≫ m.left := by
    intro A B m
    exact Limits.pullback.lift_fst _ _ _
  have hBCsnd : ∀ {A B : (wcGeomPoint F X h).left.ProEt} (m : A ⟶ B),
      (BC.map m).left ≫ Limits.pullback.snd B.hom (wcGeomFrobX F X h) =
        Limits.pullback.snd A.hom (wcGeomFrobX F X h) := fun m => MorphismProperty.Over.w (BC.map m)
  let φ : ∀ (W : (wcGeomPoint F X h).left.ProEt) (W' : (wcGeomPoint F X h).left.ProEt),
      (Θ.obj W ⟶ W') → (W ⟶ BC.obj W') := fun W W' f =>
    MorphismProperty.Over.homMk
      (Limits.pullback.lift f.left W.hom (MorphismProperty.Over.w f) :
        W.left ⟶ Limits.pullback W'.hom (wcGeomFrobX F X h))
      (Limits.pullback.lift_snd _ _ _) trivial
  let ψ : ∀ (W : (wcGeomPoint F X h).left.ProEt) (W' : (wcGeomPoint F X h).left.ProEt),
      (W ⟶ BC.obj W') → (Θ.obj W ⟶ W') := fun W W' k =>
    MorphismProperty.Over.homMk
      ((k.left : W.left ⟶ Limits.pullback W'.hom (wcGeomFrobX F X h)) ≫
        Limits.pullback.fst W'.hom (wcGeomFrobX F X h))
      (keyψ W'.hom (wcGeomFrobX F X h) W.hom k.left (MorphismProperty.Over.w k))
      trivial
  have hφfst : ∀ W W' (f : Θ.obj W ⟶ W'),
      ((φ W W' f).left : W.left ⟶ Limits.pullback W'.hom (wcGeomFrobX F X h)) ≫
        Limits.pullback.fst W'.hom (wcGeomFrobX F X h) = f.left :=
    fun W W' f => Limits.pullback.lift_fst _ _ _
  have hφsnd : ∀ W W' (f : Θ.obj W ⟶ W'),
      ((φ W W' f).left : W.left ⟶ Limits.pullback W'.hom (wcGeomFrobX F X h)) ≫
        Limits.pullback.snd W'.hom (wcGeomFrobX F X h) = W.hom :=
    fun W W' f => Limits.pullback.lift_snd _ _ _
  have hψφ : ∀ W W' (f : Θ.obj W ⟶ W'), ψ W W' (φ W W' f) = f := by
    intro W W' f
    apply MorphismProperty.Over.Hom.ext
    exact hφfst W W' f
  have hφψ : ∀ W W' (k : W ⟶ BC.obj W'), φ W W' (ψ W W' k) = k := by
    intro W W' k
    apply MorphismProperty.Over.Hom.ext
    apply Limits.pullback.hom_ext
    · exact Limits.pullback.lift_fst _ _ _
    · exact (Limits.pullback.lift_snd _ _ _).trans (MorphismProperty.Over.w k).symm
  let core : Adjunction.CoreHomEquiv Θ BC :=
    { homEquiv := fun W W' => ⟨φ W W', ψ W W', hψφ W W', hφψ W W'⟩
      homEquiv_naturality_left_symm := by
        intro W₀ W W' a k
        show ψ W₀ W' (a ≫ k) = Θ.map a ≫ ψ W W' k
        apply MorphismProperty.Over.Hom.ext
        exact Category.assoc a.left k.left (Limits.pullback.fst W'.hom (wcGeomFrobX F X h))
      homEquiv_naturality_right := by
        intro W W' W'' f m
        show φ W W'' (f ≫ m) = φ W W' f ≫ BC.map m
        apply MorphismProperty.Over.Hom.ext
        apply Limits.pullback.hom_ext
        · exact (hφfst W W'' (f ≫ m)).trans
            (natH (φ W W' f).left (BC.map m).left _ _ m.left f.left (hBCfst m) (hφfst W W' f)).symm
        · exact (hφsnd W W'' (f ≫ m)).trans
            (natH2 (φ W W' f).left (BC.map m).left _ _ W.hom (hBCsnd m) (hφsnd W W' f)).symm }
  refine ⟨Adjunction.mkOfHomEquiv core, ?_, ?_⟩
  · intro W'
    exact Category.id_comp (Limits.pullback.fst W'.hom (wcGeomFrobX F X h))
  · intro W
    exact hφfst W (Θ.obj W) (𝟙 _)

theorem wc_xbar_frob_pull_twist_iso : ∀ (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    [hΘ : (wcSliceToOver X.left (wcGeomPoint F X h) ⋙ Over.map (wcGeomFrob F X h) ⋙
        wcOverToSlice X.left (wcGeomPoint F X h)).IsContinuous
      (Scheme.ProEt.topology (wcGeomPoint F X h).left) (Scheme.ProEt.topology (wcGeomPoint F X h).left)]
    (adj : (wcSliceToOver X.left (wcGeomPoint F X h) ⋙ Over.map (wcGeomFrob F X h) ⋙
        wcOverToSlice X.left (wcGeomPoint F X h)) ⊣ wcProEtBC (wcGeomFrobX F X h)),
    (∀ W' : (wcGeomPoint F X h).left.ProEt,
        (adj.counit.app W').left = Limits.pullback.fst W'.hom (wcGeomFrobX F X h)) →
    (∀ W : (wcGeomPoint F X h).left.ProEt,
        (adj.unit.app W).left ≫ Limits.pullback.fst
          ((wcSliceToOver X.left (wcGeomPoint F X h) ⋙ Over.map (wcGeomFrob F X h) ⋙
            wcOverToSlice X.left (wcGeomPoint F X h)).obj W).hom (wcGeomFrobX F X h) = 𝟙 W.left) →
    ∀ (Dg : wcHMPullData (wcGeomFrobX F X h) ℓ), wcHMPullCanonical Dg →
    Nonempty (Dg.Φ ≅ SheafOfModules.pushforward.{u+1}
      (F := wcSliceToOver X.left (wcGeomPoint F X h) ⋙ Over.map (wcGeomFrob F X h) ⋙
        wcOverToSlice X.left (wcGeomPoint F X h))
      (S := wcRingSheaf (wcGeomPoint F X h).left ℓ) (R := wcRingSheaf (wcGeomPoint F X h).left ℓ)
      (𝟙 (wcRingSheaf (wcGeomPoint F X h).left ℓ))) :=
by
  intro F _ _ X h ℓ _ hΘ adj hc hu Dg hDg
  letI := Dg.cont
  have H1 : Functor.whiskerRight (NatTrans.op adj.counit) (wcRingSheaf (wcGeomPoint F X h).left ℓ).obj =
      Dg.φ.hom ≫ (wcProEtBC (wcGeomFrobX F X h)).op.whiskerLeft
        (𝟙 (wcRingSheaf (wcGeomPoint F X h).left ℓ) :
          wcRingSheaf (wcGeomPoint F X h).left ℓ ⟶
            ((wcSliceToOver X.left (wcGeomPoint F X h) ⋙ Over.map (wcGeomFrob F X h) ⋙
              wcOverToSlice X.left (wcGeomPoint F X h)).sheafPushforwardContinuous RingCat.{u+1}
              (Scheme.ProEt.topology (wcGeomPoint F X h).left)
              (Scheme.ProEt.topology (wcGeomPoint F X h).left)).obj
              (wcRingSheaf (wcGeomPoint F X h).left ℓ)).hom := by
    ext V s
    obtain ⟨W'⟩ := V
    show s.comp (adj.counit.app W').left.base.hom = (Dg.φ.hom.app (Opposite.op W')).hom s
    rw [hDg W' s, hc W']
    rfl
  have H2 : (𝟙 (wcRingSheaf (wcGeomPoint F X h).left ℓ) :
          wcRingSheaf (wcGeomPoint F X h).left ℓ ⟶
            ((wcSliceToOver X.left (wcGeomPoint F X h) ⋙ Over.map (wcGeomFrob F X h) ⋙
              wcOverToSlice X.left (wcGeomPoint F X h)).sheafPushforwardContinuous RingCat.{u+1}
              (Scheme.ProEt.topology (wcGeomPoint F X h).left)
              (Scheme.ProEt.topology (wcGeomPoint F X h).left)).obj
              (wcRingSheaf (wcGeomPoint F X h).left ℓ)).hom ≫
      (wcSliceToOver X.left (wcGeomPoint F X h) ⋙ Over.map (wcGeomFrob F X h) ⋙
        wcOverToSlice X.left (wcGeomPoint F X h)).op.whiskerLeft Dg.φ.hom ≫
      Functor.whiskerRight (NatTrans.op adj.unit) (wcRingSheaf (wcGeomPoint F X h).left ℓ).obj =
      𝟙 (wcRingSheaf (wcGeomPoint F X h).left ℓ).obj := by
    ext V s
    obtain ⟨W⟩ := V
    show ((Dg.φ.hom.app (Opposite.op ((wcSliceToOver X.left (wcGeomPoint F X h) ⋙
        Over.map (wcGeomFrob F X h) ⋙ wcOverToSlice X.left (wcGeomPoint F X h)).obj W))).hom s).comp
        (adj.unit.app W).left.base.hom = s
    refine (congrArg (fun g => ContinuousMap.comp g (adj.unit.app W).left.base.hom)
      (hDg ((wcSliceToOver X.left (wcGeomPoint F X h) ⋙
        Over.map (wcGeomFrob F X h) ⋙ wcOverToSlice X.left (wcGeomPoint F X h)).obj W) s)).trans ?_
    have key : ∀ t : C(↥W.left, ULift.{u+1} ℚ_[ℓ]),
        ContinuousMap.comp (ContinuousMap.comp t (Limits.pullback.fst
          ((wcSliceToOver X.left (wcGeomPoint F X h) ⋙ Over.map (wcGeomFrob F X h) ⋙
            wcOverToSlice X.left (wcGeomPoint F X h)).obj W).hom (wcGeomFrobX F X h)).base.hom)
          (adj.unit.app W).left.base.hom = t := by
      intro t
      first
      | (rw [ContinuousMap.comp_assoc, ← TopCat.hom_comp, ← Scheme.Hom.comp_base, hu W,
          Scheme.Hom.id_base, TopCat.hom_id, ContinuousMap.comp_id])
      | (refine ContinuousMap.ext fun x => ?_
         change t _ = t x
         congr 1
         exact congrArg (fun k : W.left ⟶ W.left => k.base x) (hu W))
      | (refine ContinuousMap.ext fun x => ?_
         change t _ = t x
         congr 1
         have e := congrArg (fun k : W.left ⟶ W.left => k x) (hu W)
         simpa only [Scheme.Hom.comp_apply, Scheme.Hom.id_apply] using e)
    exact key s
  haveI hΘ' : (wcSliceToOver X.left (wcGeomPoint F X h) ⋙ Over.map (wcGeomFrob F X h) ⋙
