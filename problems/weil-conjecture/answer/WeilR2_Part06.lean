  let εR : Z ⟶ (SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)).obj
      (SheafOfModules.unit (wcSliceRing F X h ℓ)) :=
    εΛ ≫ (SheafOfModules.toSheaf.{u+1} (wcIntSliceRing F X h ℓ)).map
      (wcUnitRestrict (wcIntRatSliceMap F X h ℓ))
  obtain ⟨BRm, hBRm⟩ : ∃ BRm : ∀ n, wcModCoh F X h ℓ n →+ Abelian.Ext Z
