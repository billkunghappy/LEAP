theorem wc_r2gs_univ_transport_comp_nat : ∀ {X U Z : Scheme.{u}} (p : U ⟶ X) (σ : Z ⟶ U) (f : Z ⟶ X), σ ≫ p = f → ∀ (L₁ : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology U) AddCommGrpCat.{u+1}) (ρ₁ : ∀ G : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}, wcEtTransport p G (L₁.obj G)), wcR2gsNUT p L₁ ρ₁ → ∀ (L₂ : Sheaf (Scheme.smallEtaleTopology U) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (ρ₂ : ∀ G : Sheaf (Scheme.smallEtaleTopology U) AddCommGrpCat.{u+1}, wcEtTransport σ G (L₂.obj G)), wcR2gsNUT σ L₂ ρ₂ → ∀ (L : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (ρ : ∀ G : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}, wcEtTransport f G (L.obj G)), wcR2gsNUT f L ρ → ∃ χ : L₁ ⋙ L₂ ⟶ L, ∀ (G : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (V : X.Etale) (O₁ : U.Etale) (h₁ : O₁.left ⟶ V.left) (hh₁ : h₁ ≫ V.hom = O₁.hom ≫ p) (O : Z.Etale) (k : O.left ⟶ O₁.left) (hk : k ≫ O₁.hom = O.hom ≫ σ) (hkh : (k ≫ h₁) ≫ V.hom = O.hom ≫ f) (x : G.obj.obj (Opposite.op V)), ((χ.app G).hom.app (Opposite.op O)).hom ((ρ₂ (L₁.obj G)).ρ O₁ O k hk ((ρ₁ G).ρ V O₁ h₁ hh₁ x)) = (ρ G).ρ V O (k ≫ h₁) hkh x :=
by
  intro X U Z p σ f hf L₁ ρ₁ nut₁ L₂ ρ₂ nut₂ L ρ nut


  have ext : ∀ (J : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
      (G : Sheaf (Scheme.smallEtaleTopology U) AddCommGrpCat.{u+1}) (ρ' : wcEtTransport p J G),
      wcEtTransportUniv ρ' → ∀ (H : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
      (τ₁ τ₂ : wcEtTransport σ G H),
      (∀ (V : X.Etale) (O₁ : U.Etale) (h₁ : O₁.left ⟶ V.left) (hh₁ : h₁ ≫ V.hom = O₁.hom ≫ p)
        (x : J.obj.obj (Opposite.op V)) (O : Z.Etale) (k : O.left ⟶ O₁.left)
        (hk : k ≫ O₁.hom = O.hom ≫ σ),
        τ₁.ρ O₁ O k hk (ρ'.ρ V O₁ h₁ hh₁ x) = τ₂.ρ O₁ O k hk (ρ'.ρ V O₁ h₁ hh₁ x)) →
      ∀ (O₁ : U.Etale) (O : Z.Etale) (k : O.left ⟶ O₁.left) (hk : k ≫ O₁.hom = O.hom ≫ σ)
        (y : G.obj.obj (Opposite.op O₁)), τ₁.ρ O₁ O k hk y = τ₂.ρ O₁ O k hk y := by
    intro J G ρ' hρ' H τ₁ τ₂ hagree O₁ O k hk y
    let S : Sieve O :=
      { arrows := fun O' e => ∃ (O₁' : U.Etale) (d : O₁' ⟶ O₁) (k' : O'.left ⟶ O₁'.left)
          (hk' : k' ≫ O₁'.hom = O'.hom ≫ σ) (_ : k' ≫ d.left = e.left ≫ k)
          (V : X.Etale) (h : O₁'.left ⟶ V.left) (hh : h ≫ V.hom = O₁'.hom ≫ p)
          (x : J.obj.obj (Opposite.op V)), G.obj.map d.op y = ρ'.ρ V O₁' h hh x
        downward_closed := by
          intro O' O'' e he e'
          obtain ⟨O₁', d, k', hk', hsq, V, h, hh, x, hx⟩ := he
          refine ⟨O₁', d, e'.left ≫ k', ?_, ?_, V, h, hh, x, hx⟩
          · rw [Category.assoc, hk', ← Category.assoc, MorphismProperty.Over.w e']
          · calc (e'.left ≫ k') ≫ d.left = e'.left ≫ (e.left ≫ k) := by
                  rw [Category.assoc, hsq]
              _ = (e' ≫ e).left ≫ k := (Category.assoc _ _ _).symm }
    have hres : ∀ (O' : Z.Etale) (e : O' ⟶ O), S.arrows e →
        (H.obj.map e.op) (τ₁.ρ O₁ O k hk y) = (H.obj.map e.op) (τ₂.ρ O₁ O k hk y) := by
      intro O' e he
      obtain ⟨O₁', d, k', hk', hsq, V, h, hh, x, hx⟩ := he
      have e1 := τ₁.nat O₁ O₁' d O O' e k hk k' hk' hsq y
      have e2 := τ₂.nat O₁ O₁' d O O' e k hk k' hk' hsq y
      refine e1.symm.trans ?_
      refine (congrArg (fun t => τ₁.ρ O₁' O' k' hk' t) hx).trans ?_
      refine (hagree V O₁' h hh x O' k' hk').trans ?_
      refine (congrArg (fun t => τ₂.ρ O₁' O' k' hk' t) hx).symm.trans ?_
      exact e2
    have hS : S ∈ Scheme.smallEtaleTopology Z O := by
      apply wc_etale_jointly_surjective_covers
      intro o
      obtain ⟨O₁', d, o₁', V, h, hh, x, hdo, hx⟩ :=
        wc_et_univ_transport_locally_surjective p J G ρ' hρ' O₁ y (k o)
      haveI : Etale O₁'.hom := O₁'.prop
      haveI : Etale O₁.hom := O₁.prop
      haveI : Etale O.hom := O.prop
      haveI : Etale (d.left ≫ O₁.hom) := by rw [MorphismProperty.Over.w d]; infer_instance
      haveI : Etale d.left := Etale.of_comp d.left O₁.hom
      let O' : Z.Etale := MorphismProperty.Over.mk (P := (@Etale : MorphismProperty Scheme.{u})) ⊤
        (Limits.pullback.fst k d.left ≫ O.hom)
        (inferInstance : Etale (Limits.pullback.fst k d.left ≫ O.hom))
      let e : O' ⟶ O := MorphismProperty.Over.homMk (Limits.pullback.fst k d.left) rfl trivial
      obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := k) (g := d.left)
        o o₁' hdo.symm
      refine ⟨O', e, ⟨O₁', d, Limits.pullback.snd k d.left, ?_, ?_, V, h, hh, x, hx⟩, ⟨z, hz1⟩⟩
      · show Limits.pullback.snd k d.left ≫ O₁'.hom = (Limits.pullback.fst k d.left ≫ O.hom) ≫ σ
        rw [← MorphismProperty.Over.w d, ← Category.assoc, ← Limits.pullback.condition,
          Category.assoc, hk, Category.assoc]
      · exact Limits.pullback.condition.symm
    exact Sheaf.isSeparated H O S hS _ _ hres
  haveI := wc_et_basechange_isContinuous σ
  have hsh : ∀ G : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1},
      Presheaf.IsSheaf (Scheme.smallEtaleTopology U) ((wcEtBaseChange σ).op ⋙ (L.obj G).obj) :=
    fun G => Functor.op_comp_isSheaf (wcEtBaseChange σ) (Scheme.smallEtaleTopology U)
      (Scheme.smallEtaleTopology Z) (L.obj G)
  have hτex : ∀ G : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1},
      ∃ τ : wcEtTransport σ (L₁.obj G) (L.obj G), wcEtTransportFactor hf (ρ₁ G) τ (ρ G) :=
    fun G => wc_et_transport_compose_exists p σ f hf G (L₁.obj G) (ρ₁ G) (nut₁.1 G) (L.obj G)
      (ρ G) (hsh G)
  choose τ' hτ' using hτex
  have hχex : ∀ G : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1},
      ∃ φ : L₂.obj (L₁.obj G) ⟶ L.obj G, ∀ (O₁ : U.Etale) (O : Z.Etale) (k : O.left ⟶ O₁.left)
        (hk : k ≫ O₁.hom = O.hom ≫ σ) (y : (L₁.obj G).obj.obj (Opposite.op O₁)),
        (φ.hom.app (Opposite.op O)).hom ((ρ₂ (L₁.obj G)).ρ O₁ O k hk y) =
          (τ' G).ρ O₁ O k hk y :=
    fun G => (nut₂.1 (L₁.obj G) (L.obj G) (τ' G)).exists
  choose χ₀ hχ₀ using hχex
  have hnat : ∀ (G G' : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (ψ : G ⟶ G'),
      L₂.map (L₁.map ψ) ≫ χ₀ G' = χ₀ G ≫ L.map ψ := by
    intro G G' ψ
    let Tstar : wcEtTransport σ (L₁.obj G) (L.obj G') :=
      { ρ := fun O₁ O k hk =>
          ((L.map ψ).hom.app (Opposite.op O)).hom.comp ((τ' G).ρ O₁ O k hk)
        nat := by
          intro V V' c O O' d h hh h' hh' hc x
          exact (congrArg (fun t => ((L.map ψ).hom.app (Opposite.op O')).hom t)
            ((τ' G).nat V V' c O O' d h hh h' hh' hc x)).trans
            (NatTrans.naturality_apply (L.map ψ).hom d.op _) }
    let TA : wcEtTransport σ (L₁.obj G) (L.obj G') :=
      { ρ := fun O₁ O k hk =>
          ((τ' G').ρ O₁ O k hk).comp ((L₁.map ψ).hom.app (Opposite.op O₁)).hom
        nat := by
          intro V V' c O O' d h hh h' hh' hc x
          exact (congrArg (fun t => (τ' G').ρ V' O' h' hh' t)
            (NatTrans.naturality_apply (L₁.map ψ).hom c.op x)).trans
            ((τ' G').nat V V' c O O' d h hh h' hh' hc _) }
    have hext := ext G (L₁.obj G) (ρ₁ G) (nut₁.1 G)
      (L.obj G') TA Tstar (by
        intro V O₁ h₁ hh₁ x O k hk
        show (τ' G').ρ O₁ O k hk
            (((L₁.map ψ).hom.app (Opposite.op O₁)).hom ((ρ₁ G).ρ V O₁ h₁ hh₁ x)) =
          ((L.map ψ).hom.app (Opposite.op O)).hom ((τ' G).ρ O₁ O k hk ((ρ₁ G).ρ V O₁ h₁ hh₁ x))
        have hkh : (k ≫ h₁) ≫ V.hom = O.hom ≫ f := by
          rw [Category.assoc, hh₁, ← Category.assoc, hk, Category.assoc, hf]
        refine (congrArg (fun t => (τ' G').ρ O₁ O k hk t)
          (nut₁.2 G G' ψ V O₁ h₁ hh₁ x).symm).trans ?_
        refine (hτ' G' V O₁ h₁ hh₁ O k hk ((ψ.hom.app (Opposite.op V)).hom x)).symm.trans ?_
        refine (nut.2 G G' ψ V O (k ≫ h₁) hkh x).trans ?_
        exact congrArg (fun t => ((L.map ψ).hom.app (Opposite.op O)).hom t)
          (hτ' G V O₁ h₁ hh₁ O k hk x))
    refine (nut₂.1 (L₁.obj G) (L.obj G') Tstar).unique ?_ ?_
    · intro O₁ O k hk y
      change ((χ₀ G').hom.app (Opposite.op O)).hom
          (((L₂.map (L₁.map ψ)).hom.app (Opposite.op O)).hom ((ρ₂ (L₁.obj G)).ρ O₁ O k hk y)) =
        ((L.map ψ).hom.app (Opposite.op O)).hom ((τ' G).ρ O₁ O k hk y)
      refine (congrArg (fun t => ((χ₀ G').hom.app (Opposite.op O)).hom t)
        (nut₂.2 (L₁.obj G) (L₁.obj G') (L₁.map ψ) O₁ O k hk y).symm).trans ?_
      refine (hχ₀ G' O₁ O k hk _).trans ?_
      exact hext O₁ O k hk y
    · intro O₁ O k hk y
      change ((L.map ψ).hom.app (Opposite.op O)).hom
          (((χ₀ G).hom.app (Opposite.op O)).hom ((ρ₂ (L₁.obj G)).ρ O₁ O k hk y)) =
        ((L.map ψ).hom.app (Opposite.op O)).hom ((τ' G).ρ O₁ O k hk y)
      exact congrArg (fun t => ((L.map ψ).hom.app (Opposite.op O)).hom t) (hχ₀ G O₁ O k hk y)
  refine ⟨{ app := fun G => χ₀ G, naturality := fun G G' ψ => hnat G G' ψ }, ?_⟩
  intro G V O₁ h₁ hh₁ O k hk hkh x
  exact (hχ₀ G O₁ O k hk _).trans (hτ' G V O₁ h₁ hh₁ O k hk x).symm

theorem wc_r2gs_zmod_hom_ext_of_iso : ∀ (Y : Scheme.{u}) (m : ℕ) (M : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (φ₁ φ₂ : M ⟶ wcConstZ Y m) (r : M.obj.obj (Opposite.op (wcEtTop Y))), IsIso φ₁ → (φ₁.hom.app (Opposite.op (wcEtTop Y))).hom r = wcConstSec Y (ULift.{u+1} (ZMod m)) (wcEtTop Y) (ULift.up 1) → (φ₂.hom.app (Opposite.op (wcEtTop Y))).hom r = wcConstSec Y (ULift.{u+1} (ZMod m)) (wcEtTop Y) (ULift.up 1) → φ₁ = φ₂ :=
by
  intro Y m M φ₁ φ₂ r hiso h₁ h₂
  haveI := hiso
  have hbij : ∀ (N : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}),
      Function.Bijective (fun g : (constantSheaf (Scheme.smallEtaleTopology Y)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ N =>
        (g.hom.app (Opposite.op (wcEtTop Y))).hom
          (wcConstSec Y (ULift.{u+1} ℤ) (wcEtTop Y) (ULift.up 1))) := by
    intro N
    have hT : Limits.IsTerminal (wcEtTop Y) :=
      @MorphismProperty.Over.mkIdTerminal Scheme _ @AlgebraicGeometry.Etale Y
        MorphismProperty.IsMultiplicative.toContainsIdentities
    let adj := constantSheafAdj (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} hT
    let ev : ∀ X : AddCommGrpCat.{u+1}, (AddCommGrpCat.of (ULift.{u+1} ℤ) ⟶ X) ≃ X := fun X =>
      { toFun := fun φ => φ.hom (ULift.up 1)
        invFun := fun x => AddCommGrpCat.ofHom
          ((zmultiplesHom X x).comp (AddEquiv.ulift : ULift.{u+1} ℤ ≃+ ℤ).toAddMonoidHom)
        left_inv := fun φ => by
          apply AddCommGrpCat.hom_ext
          apply AddMonoidHom.ext
          rintro ⟨n⟩
          have hn : (ULift.up n : ULift.{u+1} ℤ) = n • (ULift.up 1 : ULift.{u+1} ℤ) := by
            apply ULift.ext
            simp
          change (zmultiplesHom X (φ.hom (ULift.up 1))) n = φ.hom (ULift.up n)
          rw [zmultiplesHom_apply, hn, map_zsmul]
        right_inv := fun x => by
          change (zmultiplesHom X x) (1 : ℤ) = x
          rw [zmultiplesHom_apply, one_zsmul] }
    have key : (fun g : (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ N =>
          (g.hom.app (Opposite.op (wcEtTop Y))).hom
            (wcConstSec Y (ULift.{u+1} ℤ) (wcEtTop Y) (ULift.up 1))) =
        ⇑((adj.homEquiv (AddCommGrpCat.of (ULift.{u+1} ℤ)) N).trans
          (ev (N.obj.obj (Opposite.op (wcEtTop Y))))) := by
      funext g
      rfl
    rw [key]
    exact Equiv.bijective _
  let rm : ULift.{u+1} ℤ →+ ULift.{u+1} (ZMod m) :=
    AddEquiv.ulift.symm.toAddMonoidHom.comp
      ((Int.castAddHom (ZMod m)).comp AddEquiv.ulift.toAddMonoidHom)
  let ι : (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ wcConstZ Y m :=
    (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (AddCommGrpCat.ofHom rm)
  have hsurj : Function.Surjective rm := by
    intro b
    obtain ⟨n, hn⟩ := ZMod.intCast_surjective b.down
    refine ⟨ULift.up n, ?_⟩
    apply ULift.ext
    exact hn
  haveI : Epi (AddCommGrpCat.ofHom rm) := (AddCommGrpCat.epi_iff_surjective _).2 hsurj
  haveI hιepi : Epi ι := Functor.map_epi _ _
  have hr : rm (ULift.up 1) = ULift.up 1 := by
    show (ULift.up ((1 : ℤ) : ZMod m) : ULift.{u+1} (ZMod m)) = ULift.up 1
    rw [Int.cast_one]
  have hι1 : (ι.hom.app (Opposite.op (wcEtTop Y))).hom
      (wcConstSec Y (ULift.{u+1} ℤ) (wcEtTop Y) (ULift.up 1)) =
      wcConstSec Y (ULift.{u+1} (ZMod m)) (wcEtTop Y) (ULift.up 1) := by
    have h := congrArg (fun φ => (φ.app (Opposite.op (wcEtTop Y))).hom
        (ULift.up (1 : ℤ) : ULift.{u+1} ℤ))
      (toSheafify_naturality (Scheme.smallEtaleTopology Y)
        ((Functor.const (Y.Etale)ᵒᵖ).map (AddCommGrpCat.ofHom rm)))
    simp only [NatTrans.comp_app, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply,
      Functor.const_map_app, AddCommGrpCat.hom_ofHom] at h
    rw [hr] at h
    exact h.symm
  obtain ⟨η, hη⟩ := (hbij M).2 r
  have hη' : (η.hom.app (Opposite.op (wcEtTop Y))).hom
      (wcConstSec Y (ULift.{u+1} ℤ) (wcEtTop Y) (ULift.up 1)) = r := hη
  have key : ∀ φ : M ⟶ wcConstZ Y m, (φ.hom.app (Opposite.op (wcEtTop Y))).hom r =
      wcConstSec Y (ULift.{u+1} (ZMod m)) (wcEtTop Y) (ULift.up 1) → η ≫ φ = ι := by
    intro φ hφ
