theorem wc_et_const_zmod_pow_cokernel_iso (Y : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (m : ℕ)
    (hm : 1 ≤ m) (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
    (e : G ≅ (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ m))))) :
    Nonempty (Limits.cokernel (ℓ • 𝟙 G) ≅
      (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) :=
by
  classical
  have hd : ℓ ∣ ℓ ^ m := dvd_pow_self ℓ (by omega)
  let c : ULift.{u+1} (ZMod (ℓ ^ m)) →+ ULift.{u+1} (ZMod ℓ) :=
    (AddEquiv.ulift.symm : ZMod ℓ ≃+ ULift.{u+1} (ZMod ℓ)).toAddMonoidHom.comp
      (((ZMod.castHom hd (ZMod ℓ)).toAddMonoidHom).comp
        (AddEquiv.ulift : ULift.{u+1} (ZMod (ℓ ^ m)) ≃+ ZMod (ℓ ^ m)).toAddMonoidHom)
  have hc_apply : ∀ x, (c x).down = ZMod.castHom hd (ZMod ℓ) x.down := fun x => rfl
  have hc : Function.Surjective c := by
    intro z
    obtain ⟨w, hw⟩ := ZMod.castHom_surjective hd z.down
    exact ⟨⟨w⟩, ULift.ext _ _ (by rw [hc_apply]; exact hw)⟩
  have hS : (AddCommGrpCat.Hom.hom
      (ℓ • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ m)))))).range = c.ker := by
    ext x
    rw [AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id, AddMonoidHom.mem_range,
      AddMonoidHom.mem_ker]
    constructor
    · rintro ⟨y, rfl⟩
      apply ULift.ext
      rw [hc_apply]
      show ZMod.castHom hd (ZMod ℓ) (ℓ • y.down) = 0
      rw [map_nsmul, nsmul_eq_mul, ZMod.natCast_self, zero_mul]
    · intro hx
      have hx' : ZMod.castHom hd (ZMod ℓ) x.down = 0 := by
        rw [← hc_apply, hx]
        rfl
      rw [← ZMod.natCast_zmod_val x.down, map_natCast] at hx'
      obtain ⟨j, hj⟩ := (ZMod.natCast_eq_zero_iff _ ℓ).mp hx'
      refine ⟨⟨(j : ZMod (ℓ ^ m))⟩, ?_⟩
      rw [AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply]
      apply ULift.ext
      show ℓ • (j : ZMod (ℓ ^ m)) = x.down
      rw [nsmul_eq_mul, ← Nat.cast_mul, ← hj, ZMod.natCast_zmod_val]
  let E := (QuotientAddGroup.quotientAddEquivOfEq hS).trans
    (QuotientAddGroup.quotientKerEquivOfSurjective c hc)
  let iso4 : Limits.cokernel (ℓ • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ m))))) ≅
      AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)) :=
    AddCommGrpCat.cokernelIsoQuotient _ ≪≫ E.toAddCommGrpIso
  have w : (ℓ • 𝟙 G) ≫ e.hom = e.hom ≫ (ℓ • 𝟙 _) := by
    rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp, Category.comp_id]
  have h : ℓ • 𝟙 ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ m))))) =
      (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
        (ℓ • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ m))))) := by
    rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
  exact ⟨Limits.cokernel.mapIso _ _ e e w ≪≫ Limits.cokernelIsoOfEq h ≪≫
    (Limits.PreservesCokernel.iso
      (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) _).symm ≪≫
    (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).mapIso iso4⟩

theorem wc_et_zmodext_top_cyclic (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u})
    (f : Y ⟶ Spec (.of K)) [IsProper f] (d : ℕ) [SmoothOfRelativeDimension d f]
    [IrreducibleSpace Y] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0) (m : ℕ) :
    IsAddCyclic (wcEtZModExt Y (ℓ ^ m) (2 * d)) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y (ℓ ^ m))) := HasExt.standard _
  obtain ⟨α, _, _, hR⟩ := wc_et_zmod_ring_locbij Y (ℓ ^ m)

  have T : ∀ N : SheafOfModules.{u+1} (wcEtZModRing Y (ℓ ^ m)), (ℓ ^ m) • 𝟙 N = 0 := by
    intro N
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro V
    ext s
    have h0 : ((0 : N ⟶ N).val.app V).hom s = 0 := by
      first
        | rfl
        | simp
        | (rw [SheafOfModules.zero_val]; rfl)
    have hz : ∀ k : ℕ, ((k • 𝟙 N).val.app V).hom s = k • s := by
      intro k
      induction k with
      | zero => rw [zero_nsmul, zero_nsmul]; exact h0
      | succ k ih =>
        rw [succ_nsmul, SheafOfModules.add_val, PresheafOfModules.add_app, ModuleCat.hom_add,
          LinearMap.add_apply, ih, succ_nsmul]
        rfl
    rw [hz, ← Nat.cast_smul_eq_nsmul (R := ↑((wcEtZModRing Y (ℓ ^ m)).obj.obj V)), hR V,
      zero_smul, h0]

  have s2 : ∀ {X Z : SheafOfModules.{u+1} (wcEtZModRing Y (ℓ ^ m))} {k : ℕ}
      (x : Abelian.Ext X Z k) (n : ℕ), x.comp (Abelian.Ext.mk₀ (n • 𝟙 Z)) (add_zero k) = n • x := by
    intro X Z k x n
    induction n with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    | succ n ih =>
      rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih,
        Abelian.Ext.comp_mk₀_id]

  have hM : ∀ x : wcEtZModExt Y (ℓ ^ m) (2 * d), ℓ ^ m • x = 0 := by
    intro x
    have h := s2 x (ℓ ^ m)
    rw [T, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero] at h
    exact h.symm

  have s1 : ∀ (M A : Type (u+2)) [AddCommGroup M] [AddCommGroup A] [Finite A] (φ : M →+ A),
      (∀ x : M, ℓ ^ m • x = 0) → Nat.card A ≤ ℓ → (∀ x : M, φ x = 0 → ∃ y : M, x = ℓ • y) →
      IsAddCyclic M := by
    intro M A _ _ _ φ hM hA hker
    have hp : Nat.Prime ℓ := Fact.out
    by_cases h0 : ∀ x, φ x = 0
    · have key : ∀ k (x : M), ∃ y, x = ℓ ^ k • y := by
        intro k
        induction k with
        | zero => intro x; exact ⟨x, by simp⟩
        | succ k ih =>
          intro x
          obtain ⟨y, rfl⟩ := ih x
          obtain ⟨z, rfl⟩ := hker y (h0 y)
          exact ⟨z, by rw [smul_smul, pow_succ]⟩
      have : Subsingleton M := ⟨fun a b => by
        obtain ⟨y, hy⟩ := key m a
        obtain ⟨z, hz⟩ := key m b
        rw [hy, hz, hM, hM]⟩
      exact isAddCyclic_of_subsingleton
    · push_neg at h0
      obtain ⟨g, hg⟩ := h0
      have hord : ℓ ≤ addOrderOf (φ g) := by
        have hdvd : addOrderOf (φ g) ∣ ℓ ^ m :=
          addOrderOf_dvd_of_nsmul_eq_zero (by rw [← map_nsmul, hM, map_zero])
        obtain ⟨k, _, hk'⟩ := (Nat.dvd_prime_pow hp).mp hdvd
        rcases k with _ | k
        · exfalso; apply hg; rw [pow_zero] at hk'; exact AddMonoid.addOrderOf_eq_one_iff.mp hk'
        · rw [hk']; exact Nat.le_self_pow (by omega) ℓ
      have htop : AddSubgroup.zmultiples (φ g) = ⊤ := by
        apply AddSubgroup.eq_top_of_le_card
        rw [Nat.card_zmultiples]
        omega
      have hstep : ∀ x : M, ∃ (k : ℤ) (y : M), x = k • g + ℓ • y := by
        intro x
        have hx : φ x ∈ AddSubgroup.zmultiples (φ g) := by rw [htop]; trivial
        obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.mp hx
        obtain ⟨y, hy⟩ := hker (x - k • g) (by rw [map_sub, map_zsmul, hk, sub_self])
        exact ⟨k, y, by rw [← hy]; abel⟩
      have hiter : ∀ (j : ℕ) (x : M), ∃ (k : ℤ) (y : M), x = k • g + ℓ ^ j • y := by
        intro j
        induction j with
        | zero => intro x; exact ⟨0, x, by simp⟩
        | succ j ih =>
          intro x
          obtain ⟨k, y, rfl⟩ := ih x
          obtain ⟨k', y', rfl⟩ := hstep y
          refine ⟨k + ((ℓ ^ j : ℕ) : ℤ) * k', y', ?_⟩
          have e1 : (((ℓ ^ j : ℕ) : ℤ) * k') • g = ℓ ^ j • (k' • g) := by
            rw [mul_smul, natCast_zsmul]
          have e2 : ℓ ^ j • (ℓ • y') = ℓ ^ (j + 1) • y' := by
            rw [smul_smul, pow_succ]
          rw [add_smul, e1, ← e2, smul_add]
          abel
      rw [isAddCyclic_iff_exists_zmultiples_eq_top]
      refine ⟨g, ?_⟩
      rw [AddSubgroup.eq_top_iff']
      intro x
      obtain ⟨k, y, hxy⟩ := hiter m x
      rw [hM, add_zero] at hxy
      exact AddSubgroup.mem_zmultiples_iff.mpr ⟨k, hxy.symm⟩

  by_cases hm0 : m = 0
  · have : Subsingleton (wcEtZModExt Y (ℓ ^ m) (2 * d)) := ⟨fun a b => by
      have h1 : (1 : ℕ) = ℓ ^ m := by rw [hm0, pow_zero]
      have ha : a = 0 :=
        (one_nsmul a).symm.trans ((congrArg (fun k : ℕ => k • a) h1).trans (hM a))
      have hb : b = 0 :=
        (one_nsmul b).symm.trans ((congrArg (fun k : ℕ => k • b) h1).trans (hM b))
      rw [ha, hb]⟩
    exact isAddCyclic_of_subsingleton

  have hm : 1 ≤ m := Nat.one_le_iff_ne_zero.mpr hm0
  have hn : 0 < ℓ ^ m := pow_pos (Fact.out : Nat.Prime ℓ).pos m
  have hcast : ((ℓ ^ m : ℕ) : K) ≠ 0 := by rw [Nat.cast_pow]; exact pow_ne_zero m hℓ
  haveI hpres : Limits.PreservesFiniteColimits
      (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y (ℓ ^ m))) :=
    sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.smallEtaleTopology Y) _

  have s3 : ∀ {G H : SheafOfModules.{u+1} (wcEtZModRing Y (ℓ ^ m))} (g : G ⟶ H) (N : ℕ),
      (∀ e : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))) (Limits.kernel g) (N + 1),
        e = 0) →
      ∀ x : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))) H N,
      x.comp (Abelian.Ext.mk₀ (Limits.cokernel.π g)) (add_zero N) = 0 →
      ∃ y : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))) G N,
        x = y.comp (Abelian.Ext.mk₀ g) (add_zero N) := by
    intro G H g N hK x hx
    let S₁ : ShortComplex (SheafOfModules.{u+1} (wcEtZModRing Y (ℓ ^ m))) :=
      ShortComplex.mk (Abelian.image.ι g) (Limits.cokernel.π g) (Limits.kernel.condition _)
    have hS₁ : S₁.ShortExact :=
      ShortComplex.ShortExact.mk' (S₁.exact_of_f_is_kernel (Limits.kernelIsKernel _))
        (by dsimp [S₁]; infer_instance) (by dsimp [S₁]; infer_instance)
    have w : Limits.kernel.ι g ≫ Abelian.factorThruImage g = 0 := by
      rw [← cancel_mono (Abelian.image.ι g), Category.assoc, Abelian.image.fac,
        Limits.kernel.condition, Limits.zero_comp]
    let S₂ : ShortComplex (SheafOfModules.{u+1} (wcEtZModRing Y (ℓ ^ m))) :=
      ShortComplex.mk (Limits.kernel.ι g) (Abelian.factorThruImage g) w
    have hS₂ : S₂.ShortExact :=
      ShortComplex.ShortExact.mk'
        (S₂.exact_of_f_is_kernel
          (Limits.isKernelOfComp (Abelian.image.ι g) g (Limits.kernelIsKernel g) w
            (Abelian.image.fac g)))
        (by dsimp [S₂]; infer_instance) (by dsimp [S₂]; infer_instance)
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hS₁ x hx
    obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₃ _ hS₂ x₁ rfl (hK _)
    refine ⟨y, ?_⟩
    rw [← hx₁, ← hy]
    rw [Abelian.Ext.comp_assoc y (Abelian.Ext.mk₀ S₂.g) (Abelian.Ext.mk₀ S₁.f) (add_zero N)
      (add_zero 0) (by omega)]
    rw [Abelian.Ext.mk₀_comp_mk₀]
    dsimp [S₁, S₂]
    rw [Abelian.image.fac]

  have hK : ∀ e : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))
      (Limits.kernel (ℓ • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))))) (2 * d + 1),
      e = 0 := by
    intro e
    obtain ⟨E⟩ := wc_et_zmod_modext_toSheaf_equiv Y (ℓ ^ m) hn
      (Limits.kernel (ℓ • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))))) (2 * d + 1)
    have htor : (ℓ ^ m) • 𝟙 ((SheafOfModules.toSheaf (wcEtZModRing Y (ℓ ^ m))).obj
        (Limits.kernel (ℓ • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))))) = 0 := by
      rw [← (SheafOfModules.toSheaf (wcEtZModRing Y (ℓ ^ m))).map_id, ← Functor.map_nsmul, T,
        Functor.map_zero]
    have hv := wc_et_cd_proper_torsion K Y f d (wc_smooth_alg_closed_dim_le K Y f d) (ℓ ^ m)
      hcast _ htor (2 * d + 1) (by omega)
    apply E.injective
    rw [hv (E e), hv (E 0)]

  have hker : ∀ x : wcEtZModExt Y (ℓ ^ m) (2 * d),
      (Abelian.Ext.mk₀ (Limits.cokernel.π
        (ℓ • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))))).postcomp
        (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))) (add_zero (2 * d)) x = 0 →
      ∃ y : wcEtZModExt Y (ℓ ^ m) (2 * d), x = ℓ • y := by
    intro x hx
    obtain ⟨y, hy⟩ := s3 (ℓ • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))) (2 * d) hK x hx
    exact ⟨y, hy.trans (s2 y ℓ)⟩

  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  have s4 : ∀ {A B : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}} (e : A ≅ B) (n : ℕ),
      Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) A n ≃
      Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) B n := fun {A B} e n =>
    { toFun := fun x => x.comp (Abelian.Ext.mk₀ e.hom) (add_zero n)
      invFun := fun y => y.comp (Abelian.Ext.mk₀ e.inv) (add_zero n)
      left_inv := fun x => by
        simp only
        rw [Abelian.Ext.comp_assoc x (Abelian.Ext.mk₀ e.hom) (Abelian.Ext.mk₀ e.inv) (add_zero n)
          (add_zero 0) (by omega), Abelian.Ext.mk₀_comp_mk₀, e.hom_inv_id,
          Abelian.Ext.comp_mk₀_id]
      right_inv := fun y => by
        simp only
        rw [Abelian.Ext.comp_assoc y (Abelian.Ext.mk₀ e.inv) (Abelian.Ext.mk₀ e.hom) (add_zero n)
          (add_zero 0) (by omega), Abelian.Ext.mk₀_comp_mk₀, e.inv_hom_id,
          Abelian.Ext.comp_mk₀_id] }
  obtain ⟨E1⟩ := wc_et_zmod_modext_toSheaf_equiv Y (ℓ ^ m) hn
    (Limits.cokernel (ℓ • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))))) (2 * d)
  obtain ⟨e7⟩ := wc_et_zmod_unit_toSheaf_iso Y (ℓ ^ m)
  obtain ⟨e8⟩ := wc_et_const_zmod_pow_cokernel_iso Y ℓ m hm _ e7
  have hmap : (SheafOfModules.toSheaf (wcEtZModRing Y (ℓ ^ m))).map
      (ℓ • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))) = ℓ • 𝟙 _ := by
    rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
  have E2 := s4 (Limits.PreservesCokernel.iso (SheafOfModules.toSheaf (wcEtZModRing Y (ℓ ^ m)))
      (ℓ • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))) ≪≫
    Limits.cokernelIsoOfEq hmap ≪≫ e8) (2 * d)
  have Etot : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))
      (Limits.cokernel (ℓ • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))))) (2 * d) ≃
      wcEtCoh Y ℓ (2 * d) := E1.trans (E2.trans (Equiv.refl _))
  obtain ⟨hfin, hcard⟩ := wc_et_top_coh_card_le K Y f d ℓ hℓ
  haveI : Finite (Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))
      (Limits.cokernel (ℓ • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))))) (2 * d)) :=
    Finite.of_equiv _ Etot.symm
  have hA : Nat.card (Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))
      (Limits.cokernel (ℓ • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))))) (2 * d)) ≤ ℓ :=
    (Nat.card_congr Etot).trans_le hcard
  exact s1 _ _ _ hM hA hker

theorem wc_ext_pairing_devissage : ∀ {C : Type u₁} [Category.{v₁} C] [Abelian C] [HasExt.{w} C] (A : C) (n : ℕ) (η : Abelian.Ext A A n →+ AddCircle (1 : ℚ)) (S : ShortComplex C), S.ShortExact → (∀ (i j : ℕ) (h : i + j = n), Function.Bijective (fun x : Abelian.Ext A S.X₁ i => η.comp (Abelian.Ext.bilinearComp A S.X₁ A i j n h x))) → (∀ (i j : ℕ) (h : i + j = n), Function.Bijective (fun x : Abelian.Ext A S.X₃ i => η.comp (Abelian.Ext.bilinearComp A S.X₃ A i j n h x))) → (∀ x : Abelian.Ext A S.X₁ (n + 1), x = 0) → (∀ y : Abelian.Ext S.X₁ A (n + 1), y = 0) → (∀ y : Abelian.Ext S.X₃ A (n + 1), y = 0) → (∀ (i j : ℕ) (h : i + j = n), Function.Bijective (fun x : Abelian.Ext A S.X₂ i => η.comp (Abelian.Ext.bilinearComp A S.X₂ A i j n h x))) ∧ ∀ y : Abelian.Ext S.X₂ A (n + 1), y = 0 :=
by
  intro C _ _ _ A n η S hS hB1 hB3 hV1 hV1' hV3

  have s1 : ∀ {P Q : Type w} [AddCommGroup P] [AddCommGroup Q] (α : P →+ Q)
      (φ : P →+ AddCircle (1 : ℚ)), (∀ p, α p = 0 → φ p = 0) →
      ∃ ψ : Q →+ AddCircle (1 : ℚ), ∀ p, ψ (α p) = φ p := by
    intro P Q _ _ α φ hφ
    have hK : α.ker ≤ φ.ker := fun p hp => hφ p hp
    let φ₁ : P ⧸ α.ker →+ AddCircle (1 : ℚ) := QuotientAddGroup.lift α.ker φ hK
    let e : P ⧸ α.ker ≃+ α.range := QuotientAddGroup.quotientKerEquivRange α
    let φ₂ : α.range →+ AddCircle (1 : ℚ) := φ₁.comp e.symm.toAddMonoidHom
    have hinj : Function.Injective (α.range.subtype.toIntLinearMap) := by
      rw [AddMonoidHom.coe_toIntLinearMap]
      exact Subtype.val_injective
    obtain ⟨ψ, hψ⟩ := CharacterModule.dual_surjective_of_injective _ hinj φ₂
    refine ⟨ψ, fun p => ?_⟩
    have h1 := DFunLike.congr_fun hψ (α.rangeRestrict p)
    rw [CharacterModule.dual_apply] at h1
    have h2 : e (QuotientAddGroup.mk p) = α.rangeRestrict p := rfl
    have h3 : φ₂ (α.rangeRestrict p) = φ p := by
      show φ₁ (e.symm (α.rangeRestrict p)) = φ p
      rw [← h2, AddEquiv.symm_apply_apply]
      rfl
    exact h1.trans h3

  have hD : ∀ {N : C} {i j : ℕ} (h : i + j = n) (x : Abelian.Ext A N i) (y : Abelian.Ext N A j),
      (η.comp (Abelian.Ext.bilinearComp A N A i j n h x)) y = η (x.comp y h) := by
    intro N i j h x y
    rw [AddMonoidHom.comp_apply, Abelian.Ext.bilinearComp_apply_apply]

  have hzero : ∀ {N : C} {i j : ℕ} (h : i + j = n) (x : Abelian.Ext A N i),
      Function.Injective (fun x : Abelian.Ext A N i =>
        η.comp (Abelian.Ext.bilinearComp A N A i j n h x)) →
      (∀ y : Abelian.Ext N A j, η (x.comp y h) = 0) → x = 0 := by
    intro N i j h x hinj hx
    apply hinj
    dsimp only
    rw [map_zero, AddMonoidHom.comp_zero]
    ext y
    rw [hD, hx, AddMonoidHom.zero_apply]

  have s2 : ∀ (i j : ℕ) (h : i + j = n), Function.Injective (fun x : Abelian.Ext A S.X₂ i =>
      η.comp (Abelian.Ext.bilinearComp A S.X₂ A i j n h x)) := by
    intro i j h
    have key : ∀ x : Abelian.Ext A S.X₂ i, (∀ y : Abelian.Ext S.X₂ A j, η (x.comp y h) = 0) →
        x = 0 := by
      intro x hx
      have hx3 : x.comp (Abelian.Ext.mk₀ S.g) (add_zero i) = 0 := by
        apply hzero h _ (hB3 i j h).1
        intro z
        rw [Abelian.Ext.comp_assoc x (Abelian.Ext.mk₀ S.g) z (add_zero i) (zero_add j)
          (show i + 0 + j = n by omega)]
        exact hx _
      obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂ A hS x hx3
      have hker : ∀ y : Abelian.Ext S.X₁ A j, hS.extClass.comp y (add_comm 1 j) = 0 →
          η (x₁.comp y h) = 0 := by
        intro y hy
        obtain ⟨y₂, hy₂⟩ := Abelian.Ext.contravariant_sequence_exact₁ hS A y (add_comm 1 j) hy
        rw [← hy₂, ← Abelian.Ext.comp_assoc x₁ (Abelian.Ext.mk₀ S.f) y₂ (add_zero i) (zero_add j)
          (show i + 0 + j = n by omega), hx₁]
        exact hx y₂
      cases i with
      | zero =>
        have hj : j = n := by omega
        subst hj
        have hx₁0 : x₁ = 0 := hzero h x₁ (hB1 0 j h).1 (fun y => hker y (hV3 _))
        rw [← hx₁, hx₁0, Abelian.Ext.zero_comp]
      | succ i' =>
        obtain ⟨ψ, hψ⟩ := s1 (Abelian.Ext.bilinearComp S.X₃ S.X₁ A 1 j (j + 1) (add_comm 1 j)
            hS.extClass) (η.comp (Abelian.Ext.bilinearComp A S.X₁ A (i' + 1) j n h x₁))
          (fun y hy => by
            rw [hD]
            apply hker
            rwa [Abelian.Ext.bilinearComp_apply_apply] at hy)
        have h' : i' + (j + 1) = n := by omega
        obtain ⟨x₀, hx₀⟩ := (hB3 i' (j + 1) h').2 ψ
        have hx₀' : ∀ w, η (x₀.comp w h') = ψ w := fun w => by
          rw [← hx₀]
          exact (hD h' x₀ w).symm
        have hx₁' : x₀.comp hS.extClass (rfl : i' + 1 = i' + 1) = x₁ := by
          apply (hB1 (i' + 1) j h).1
          dsimp only
          ext y
          rw [hD, hD, Abelian.Ext.comp_assoc x₀ hS.extClass y rfl (add_comm 1 j)
            (show i' + 1 + j = n by omega), hx₀', ← hD h x₁ y, ← hψ y,
            Abelian.Ext.bilinearComp_apply_apply]
        rw [← hx₁, ← hx₁', Abelian.Ext.comp_assoc x₀ hS.extClass (Abelian.Ext.mk₀ S.f) rfl
          (add_zero 1) (show i' + 1 + 0 = i' + 1 by omega), hS.extClass_comp,
          Abelian.Ext.comp_zero]
    intro a b hab
    have hab' : ∀ y : Abelian.Ext S.X₂ A j, η (a.comp y h) = η (b.comp y h) := by
      intro y
      have := DFunLike.congr_fun hab y
      dsimp only at this
      rw [hD, hD] at this
      exact this
    have hsub : a - b = 0 := key (a - b) (fun y => by
      rw [sub_eq_add_neg, Abelian.Ext.add_comp, Abelian.Ext.neg_comp, map_add, map_neg, hab' y,
        add_neg_cancel])
    exact sub_eq_zero.mp hsub

  have s3 : ∀ (i j : ℕ) (h : i + j = n), Function.Surjective (fun x : Abelian.Ext A S.X₂ i =>
      η.comp (Abelian.Ext.bilinearComp A S.X₂ A i j n h x)) := by
    intro i j h φ
    obtain ⟨x₃, hx₃⟩ := (hB3 i j h).2
      (φ.comp (Abelian.Ext.bilinearComp S.X₂ S.X₃ A 0 j j (zero_add j) (Abelian.Ext.mk₀ S.g)))
    have hx₃' : ∀ z : Abelian.Ext S.X₃ A j,
        η (x₃.comp z h) = φ ((Abelian.Ext.mk₀ S.g).comp z (zero_add j)) := by
      intro z
      have h1 := DFunLike.congr_fun hx₃ z
      dsimp only at h1
      rw [hD, AddMonoidHom.comp_apply, Abelian.Ext.bilinearComp_apply_apply] at h1
      exact h1
    have hx3δ : x₃.comp hS.extClass (rfl : i + 1 = i + 1) = 0 := by
      cases j with
      | zero =>
        have hi : n = i := by omega
        subst hi
        exact hV1 _
      | succ j' =>
        have h'' : (i + 1) + j' = n := by omega
        apply hzero h'' _ (hB1 (i + 1) j' h'').1
        intro y
        rw [Abelian.Ext.comp_assoc x₃ hS.extClass y rfl (add_comm 1 j')
            (show i + 1 + j' = n by omega), hx₃',
          ← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ S.g) hS.extClass y (zero_add 1) (add_comm 1 j')
            (show 0 + 1 + j' = j' + 1 by omega), hS.comp_extClass, Abelian.Ext.zero_comp,
          map_zero]
    obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ A hS x₃ rfl hx3δ
    have hχ : ∀ y₃ : Abelian.Ext S.X₃ A j,
        (φ - η.comp (Abelian.Ext.bilinearComp A S.X₂ A i j n h x₂))
          ((Abelian.Ext.mk₀ S.g).comp y₃ (zero_add j)) = 0 := by
      intro y₃
      rw [AddMonoidHom.sub_apply, hD, ← Abelian.Ext.comp_assoc x₂ (Abelian.Ext.mk₀ S.g) y₃
        (add_zero i) (zero_add j) (show i + 0 + j = n by omega), hx₂, hx₃', sub_self]
    obtain ⟨ψ', hψ'⟩ := s1 (Abelian.Ext.bilinearComp S.X₁ S.X₂ A 0 j j (zero_add j)
        (Abelian.Ext.mk₀ S.f)) (φ - η.comp (Abelian.Ext.bilinearComp A S.X₂ A i j n h x₂))
      (fun y hy => by
        rw [Abelian.Ext.bilinearComp_apply_apply] at hy
        obtain ⟨y₃, hy₃⟩ := Abelian.Ext.contravariant_sequence_exact₂ hS A y hy
        rw [← hy₃]
        exact hχ y₃)
    obtain ⟨x₁, hx₁⟩ := (hB1 i j h).2 ψ'
    have hx₁' : ∀ w, η (x₁.comp w h) = ψ' w := fun w => by
      rw [← hx₁]
      exact (hD h x₁ w).symm
    refine ⟨x₂ + x₁.comp (Abelian.Ext.mk₀ S.f) (add_zero i), ?_⟩
    dsimp only
    ext y
    rw [hD, Abelian.Ext.add_comp, map_add, Abelian.Ext.comp_assoc x₁ (Abelian.Ext.mk₀ S.f) y
      (add_zero i) (zero_add j) (show i + 0 + j = n by omega), hx₁',
      ← Abelian.Ext.bilinearComp_apply_apply S.X₁ S.X₂ A 0 j j (zero_add j), hψ',
      AddMonoidHom.sub_apply, hD]
    abel

  have s4 : ∀ y : Abelian.Ext S.X₂ A (n + 1), y = 0 := by
    intro y
    obtain ⟨y₃, hy₃⟩ := Abelian.Ext.contravariant_sequence_exact₂ hS A y (hV1' _)
    rw [← hy₃, hV3 y₃, Abelian.Ext.comp_zero]
  exact ⟨fun i j h => ⟨s2 i j h, s3 i j h⟩, s4⟩

theorem wc_coker_pow_ses : ∀ {C : Type u₁} [Category.{v₁} C] [Abelian C] (A : C) (ℓ m : ℕ), (ℓ ^ m) • 𝟙 A = 0 → (∀ k : ℕ, 1 ≤ k → k < m → ∀ {Z : C} (z : Z ⟶ A), z ≫ ((ℓ ^ k) • 𝟙 A) = 0 → ∃ (Z' : C) (π : Z' ⟶ Z) (_ : Epi π) (t : Z' ⟶ A), π ≫ z = t ≫ ((ℓ ^ (m - k)) • 𝟙 A)) → ∀ k : ℕ, 1 ≤ k → k < m → ∃ (f : Limits.cokernel ((ℓ ^ 1) • 𝟙 A) ⟶ Limits.cokernel ((ℓ ^ (k + 1)) • 𝟙 A)) (g : Limits.cokernel ((ℓ ^ (k + 1)) • 𝟙 A) ⟶ Limits.cokernel ((ℓ ^ k) • 𝟙 A)) (w : f ≫ g = 0), (ShortComplex.mk f g w).ShortExact :=
by
  intro C _ _ A ℓ m _hT H k hk1 hkm
  have hmul : ∀ a b : ℕ, (a • 𝟙 A) ≫ (b • 𝟙 A) = (a * b) • 𝟙 A := by
    intro a b
    rw [Preadditive.nsmul_comp, Category.id_comp, smul_smul]
  have hpow : ∀ a b : ℕ, ((ℓ ^ a) • 𝟙 A) ≫ ((ℓ ^ b) • 𝟙 A) = (ℓ ^ (a + b)) • 𝟙 A := by
    intro a b
    rw [hmul, pow_add]
  have hg0 : ((ℓ ^ (k + 1)) • 𝟙 A) ≫ Limits.cokernel.π ((ℓ ^ k) • 𝟙 A) = 0 := by
    rw [show k + 1 = 1 + k by omega, ← hpow, Category.assoc, Limits.cokernel.condition,
      Limits.comp_zero]
  have hf0 : ((ℓ ^ 1) • 𝟙 A) ≫ ((ℓ ^ k) • 𝟙 A) ≫
      Limits.cokernel.π ((ℓ ^ (k + 1)) • 𝟙 A) = 0 := by
    rw [← Category.assoc, hpow, show 1 + k = k + 1 by omega, Limits.cokernel.condition]
  obtain ⟨g, hg⟩ : ∃ g : Limits.cokernel ((ℓ ^ (k + 1)) • 𝟙 A) ⟶ Limits.cokernel ((ℓ ^ k) • 𝟙 A),
      Limits.cokernel.π ((ℓ ^ (k + 1)) • 𝟙 A) ≫ g = Limits.cokernel.π ((ℓ ^ k) • 𝟙 A) :=
    ⟨_, Limits.cokernel.π_desc _ _ hg0⟩
  obtain ⟨f, hf⟩ : ∃ f : Limits.cokernel ((ℓ ^ 1) • 𝟙 A) ⟶ Limits.cokernel ((ℓ ^ (k + 1)) • 𝟙 A),
      Limits.cokernel.π ((ℓ ^ 1) • 𝟙 A) ≫ f =
        ((ℓ ^ k) • 𝟙 A) ≫ Limits.cokernel.π ((ℓ ^ (k + 1)) • 𝟙 A) :=
    ⟨_, Limits.cokernel.π_desc _ _ hf0⟩
  have w : f ≫ g = 0 := by
    rw [← cancel_epi (Limits.cokernel.π ((ℓ ^ 1) • 𝟙 A)), ← Category.assoc, hf, Category.assoc,
      hg, Limits.cokernel.condition, Limits.comp_zero]
  refine ⟨f, g, w, ?_⟩
  have hepi : Epi g := epi_of_epi_fac hg
  have hkill : ∀ {W : C} (u : W ⟶ A) (j : ℕ), 1 ≤ j →
      u ≫ ((ℓ ^ j) • 𝟙 A) ≫ Limits.cokernel.π ((ℓ ^ 1) • 𝟙 A) = 0 := by
    intro W u j hj
    obtain ⟨i, rfl⟩ : ∃ i, j = i + 1 := ⟨j - 1, by omega⟩
    rw [← hpow i 1, Category.assoc, Limits.cokernel.condition, Limits.comp_zero, Limits.comp_zero]
  have hmono : Mono f := by
    apply Preadditive.mono_of_cancel_zero
    intro P y hy
    obtain ⟨P₁, π₁, hπ₁, c, hc⟩ :=
      surjective_up_to_refinements_of_epi (Limits.cokernel.π ((ℓ ^ 1) • 𝟙 A)) y
    have h1 : (c ≫ ((ℓ ^ k) • 𝟙 A)) ≫ Limits.cokernel.π ((ℓ ^ (k + 1)) • 𝟙 A) = 0 := by
      rw [Category.assoc, ← hf, ← Category.assoc, ← hc, Category.assoc, hy, Limits.comp_zero]
    obtain ⟨P₂, π₂, hπ₂, d, hd⟩ :=
      (ShortComplex.exact_cokernel ((ℓ ^ (k + 1)) • 𝟙 A)).exact_up_to_refinements
        (c ≫ ((ℓ ^ k) • 𝟙 A)) h1
    dsimp only at hd
    have hz : (π₂ ≫ c - d ≫ ((ℓ ^ 1) • 𝟙 A)) ≫ ((ℓ ^ k) • 𝟙 A) = 0 := by
      rw [Preadditive.sub_comp, Category.assoc, hd, Category.assoc, hpow,
        show 1 + k = k + 1 by omega, sub_self]
    obtain ⟨P₃, π₃, hπ₃, t, ht⟩ := H k hk1 hkm (π₂ ≫ c - d ≫ ((ℓ ^ 1) • 𝟙 A)) hz
    have e : π₃ ≫ π₂ ≫ c = t ≫ ((ℓ ^ (m - k)) • 𝟙 A) + π₃ ≫ d ≫ ((ℓ ^ 1) • 𝟙 A) := by
      rw [← ht, Preadditive.comp_sub, sub_add_cancel]
    have hc0 : c ≫ Limits.cokernel.π ((ℓ ^ 1) • 𝟙 A) = 0 := by
      rw [← cancel_epi (π₃ ≫ π₂), Limits.comp_zero, Category.assoc, ← Category.assoc π₂,
        ← Category.assoc π₃, e]
      simp only [Preadditive.add_comp, Category.assoc, hkill t (m - k) (by omega),
        hkill d 1 le_rfl, Limits.comp_zero, add_zero]
    rw [← cancel_epi π₁, hc, hc0, Limits.comp_zero]
  have hex : (ShortComplex.mk f g w).Exact := by
    rw [ShortComplex.exact_iff_exact_up_to_refinements]
    intro W x₂ hx₂
    have hx₂' : x₂ ≫ g = 0 := hx₂
    obtain ⟨W₁, π₁, hπ₁, a, ha⟩ :=
      surjective_up_to_refinements_of_epi (Limits.cokernel.π ((ℓ ^ (k + 1)) • 𝟙 A)) x₂
    have ha0 : a ≫ Limits.cokernel.π ((ℓ ^ k) • 𝟙 A) = 0 := by
      rw [← hg, ← Category.assoc, ← ha, Category.assoc, hx₂', Limits.comp_zero]
    obtain ⟨W₂, π₂, hπ₂, b, hb⟩ :=
      (ShortComplex.exact_cokernel ((ℓ ^ k) • 𝟙 A)).exact_up_to_refinements a ha0
    dsimp only at hb
    refine ⟨W₂, π₂ ≫ π₁, epi_comp _ _, b ≫ Limits.cokernel.π ((ℓ ^ 1) • 𝟙 A), ?_⟩
    show (π₂ ≫ π₁) ≫ x₂ = (b ≫ Limits.cokernel.π ((ℓ ^ 1) • 𝟙 A)) ≫ f
    rw [Category.assoc, ha, ← Category.assoc, hb, Category.assoc, Category.assoc, hf]
  exact { exact := hex, mono_f := hmono, epi_g := hepi }

theorem wc_et_zmod_unit_pow_exact : ∀ (Y : Scheme.{u}) (ℓ m : ℕ), 0 < ℓ → (ℓ ^ m) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))) = 0 ∧ ∀ k : ℕ, 1 ≤ k → k < m → ∀ {Z : SheafOfModules.{u+1} (wcEtZModRing Y (ℓ ^ m))} (z : Z ⟶ SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))), z ≫ ((ℓ ^ k) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))) = 0 → ∃ (Z' : SheafOfModules.{u+1} (wcEtZModRing Y (ℓ ^ m))) (π : Z' ⟶ Z) (_ : Epi π) (t : Z' ⟶ SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))), π ≫ z = t ≫ ((ℓ ^ (m - k)) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))) :=
by
  intro Y ℓ m hℓ
  classical
  obtain ⟨-, -, -, hR⟩ := wc_et_zmod_ring_locbij Y (ℓ ^ m)

  have hev : ∀ {M M' : SheafOfModules.{u+1} (wcEtZModRing Y (ℓ ^ m))} (f : M ⟶ M')
      (V : (Y.Etale)ᵒᵖ), f.val.app V = (SheafOfModules.forget (wcEtZModRing Y (ℓ ^ m)) ⋙
        PresheafOfModules.evaluation (wcEtZModRing Y (ℓ ^ m)).obj V).map f :=
    fun _ _ => rfl
  have hnsmulApp : ∀ (M : SheafOfModules.{u+1} (wcEtZModRing Y (ℓ ^ m))) (V : (Y.Etale)ᵒᵖ),
      ((ℓ ^ m) • 𝟙 M).val.app V = (ℓ ^ m) • 𝟙 (M.val.obj V) := by
    intro M V
    rw [hev, CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
    rfl
  have hzeroApp : ∀ (M M' : SheafOfModules.{u+1} (wcEtZModRing Y (ℓ ^ m))) (V : (Y.Etale)ᵒᵖ),
      (0 : M ⟶ M').val.app V = 0 := by
    intro M M' V
    rw [hev, CategoryTheory.Functor.map_zero]
    rfl
  have hI : (ℓ ^ m) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))) = 0 := by
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro V
    rw [hnsmulApp, hzeroApp]
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    rw [ModuleCat.hom_nsmul, ModuleCat.hom_id, ModuleCat.hom_zero, LinearMap.smul_apply,
      LinearMap.id_apply, LinearMap.zero_apply,
      ← Nat.cast_smul_eq_nsmul ((wcEtZModRing Y (ℓ ^ m)).obj.obj V), hR V, zero_smul]
  refine ⟨hI, ?_⟩
  intro k hk1 hkm Z z hz
  have hmk : ℓ ^ (m - k) * ℓ ^ k = ℓ ^ m := by
    rw [← pow_add]
    congr 1
    omega
  have w : ((ℓ ^ (m - k)) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))) ≫
      ((ℓ ^ k) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))) = 0 := by
    rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp, ← mul_nsmul', hmk, hI]

  haveI : NeZero (ℓ ^ m) := NeZero.of_pos (pow_pos hℓ m)
  have hG : ∀ (c : ℕ) (x : AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ m)))),
      (c • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ m))))).hom x = c • x := by
    intro c x
    rw [AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id]
    rfl
  have w0 : ((ℓ ^ (m - k)) • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ m))))) ≫
      ((ℓ ^ k) • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ m))))) = 0 := by
    rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp, ← mul_nsmul', hmk]
    ext x
    rw [hG]
    change (ℓ ^ m) • x.down = (0 : ZMod (ℓ ^ m))
    rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
  have hS0 : (ShortComplex.mk _ _ w0).Exact := by
    rw [ShortComplex.ab_exact_iff]
    intro x hx
    change (ℓ ^ k • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ m))))).hom x = 0 at hx
    rw [hG] at hx
    have hx' : (ℓ ^ k) • x.down = 0 := congrArg ULift.down hx
    have hv : (((ℓ ^ k * x.down.val : ℕ)) : ZMod (ℓ ^ m)) = 0 := by
      rw [Nat.cast_mul, ZMod.natCast_zmod_val, ← nsmul_eq_mul]
      exact hx'
    rw [ZMod.natCast_eq_zero_iff] at hv
    have hdvd : ℓ ^ (m - k) ∣ x.down.val := by
      have hv2 : ℓ ^ k * ℓ ^ (m - k) ∣ ℓ ^ k * x.down.val := by
        rw [mul_comm (ℓ ^ k) (ℓ ^ (m - k)), hmk]
        exact hv
      exact Nat.dvd_of_mul_dvd_mul_left (pow_pos hℓ k) hv2
    obtain ⟨c, hc⟩ := hdvd
    refine ⟨ULift.up (c : ZMod (ℓ ^ m)), ?_⟩
    change (ℓ ^ (m - k) • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ m))))).hom _ = x
    rw [hG]
    apply ULift.ext
    change (ℓ ^ (m - k)) • (c : ZMod (ℓ ^ m)) = x.down
    rw [nsmul_eq_mul, ← Nat.cast_mul, ← hc, ZMod.natCast_zmod_val]
  have hC : ((ShortComplex.mk _ _ w0).map
      (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})).Exact := by
    have e : (ShortComplex.mk _ _ w0).map
        (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) =
        ((ShortComplex.mk _ _ w0).map (Functor.const (Y.Etale)ᵒᵖ)).map
          (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := rfl
    rw [e]
    exact (hS0.map _).map _
  obtain ⟨θ⟩ := wc_et_zmod_unit_toSheaf_iso Y (ℓ ^ m)
  have hcomm : ∀ c : ℕ, θ.hom ≫ (constantSheaf (Scheme.smallEtaleTopology Y)
      AddCommGrpCat.{u+1}).map (c • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ m))))) =
      (SheafOfModules.toSheaf (wcEtZModRing Y (ℓ ^ m))).map
        (c • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))) ≫ θ.hom := by
    intro c
    rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_nsmul,
      CategoryTheory.Functor.map_id, CategoryTheory.Functor.map_id,
      Preadditive.comp_nsmul, Preadditive.nsmul_comp, Category.comp_id, Category.id_comp]
  let e : (ShortComplex.mk _ _ w).map (SheafOfModules.toSheaf (wcEtZModRing Y (ℓ ^ m))) ≅
      (ShortComplex.mk _ _ w0).map
        (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
    ShortComplex.isoMk θ θ θ (hcomm _) (hcomm _)
  have hSU := (ShortComplex.exact_iff_of_iso e).mpr hC
  have hS := Functor.reflects_exact_of_faithful
    (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y (ℓ ^ m))) (ShortComplex.mk _ _ w) hSU
  obtain ⟨A', π, hπ, x₁, hx₁⟩ := hS.exact_up_to_refinements z hz
  exact ⟨A', π, hπ, x₁, hx₁⟩

theorem wc_et_zmod_ext_unit_modell_vanish : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsProper f] (d : ℕ) [SmoothOfRelativeDimension d f] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (m : ℕ), 1 ≤ m → ∀ x : @Abelian.Ext (SheafOfModules.{u+1} (wcEtZModRing Y (ℓ ^ m))) _ _ (HasExt.standard _) (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))) (Limits.cokernel ((ℓ ^ 1) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))))) (2 * d + 1), x = 0 :=
by
  intro K _ _ Y f _ d _ ℓ _ hℓ m _ x
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  have hn : 0 < ℓ ^ m := pow_pos (Fact.out : Nat.Prime ℓ).pos m

  have hN : ℓ • 𝟙 (Limits.cokernel ((ℓ ^ 1) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))))) = 0 := by
    rw [← cancel_epi (Limits.cokernel.π ((ℓ ^ 1) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))))),
      Preadditive.comp_nsmul, Category.comp_id, Limits.comp_zero]
    have h := Limits.cokernel.condition ((ℓ ^ 1) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))))
    rw [Preadditive.nsmul_comp, Category.id_comp] at h
    exact (congrArg (fun k : ℕ => k • Limits.cokernel.π
      ((ℓ ^ 1) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))))) (pow_one ℓ)).symm.trans h

  have htor : ℓ • 𝟙 ((SheafOfModules.toSheaf (wcEtZModRing Y (ℓ ^ m))).obj
      (Limits.cokernel ((ℓ ^ 1) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))))) = 0 := by
    rw [← (SheafOfModules.toSheaf (wcEtZModRing Y (ℓ ^ m))).map_id, ← Functor.map_nsmul, hN,
      Functor.map_zero]

  obtain ⟨E⟩ := wc_et_zmod_modext_toSheaf_equiv Y (ℓ ^ m) hn
    (Limits.cokernel ((ℓ ^ 1) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))))) (2 * d + 1)
  have hv := wc_et_cd_proper_torsion K Y f d (wc_smooth_alg_closed_dim_le K Y f d) ℓ
    hℓ _ htor (2 * d + 1) (by omega)
  apply E.injective
  rw [hv (E x), hv (E 0)]

theorem wc_const_sheafify_ringHom_sections_surj : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C) (A B : RingCat.{u+1}) (c : A ⟶ B) (RA RB : Sheaf J RingCat.{u+1}) (αA : (Functor.const Cᵒᵖ).obj A ⟶ RA.obj) (αB : (Functor.const Cᵒᵖ).obj B ⟶ RB.obj) (φ : RA ⟶ RB), Presheaf.IsLocallyInjective J αB → Presheaf.IsLocallySurjective J αB → αA ≫ φ.hom = (Functor.const Cᵒᵖ).map c ≫ αB → Function.Surjective c.hom → ∀ (V : Cᵒᵖ) (r' : RB.obj.obj V), ∃ r : RA.obj.obj V, (φ.hom.app V).hom r = r' :=
by
  intro C _ J A B c RA RB αA αB φ hinj hsurj hsq hc V r'
  have hshf : ∀ (R : Sheaf J RingCat.{u+1}), Presheaf.IsSheaf J (R.obj ⋙ forget RingCat.{u+1}) :=
    fun R => (Presheaf.isSheaf_iff_isSheaf_forget J R.obj (forget RingCat.{u+1})).1 R.cond
  have hsep : ∀ (R : Sheaf J RingCat.{u+1}) (U : C) (S : Sieve U), S ∈ J U →
      ∀ (x y : R.obj.obj (Opposite.op U)),
      (∀ (W : C) (f : W ⟶ U), S f → (R.obj.map f.op).hom x = (R.obj.map f.op).hom y) → x = y := by
    intro R U S hS x y h
    exact ((Presheaf.IsSheaf.isSheafFor (hshf R) S hS).isSeparatedFor).ext
      (fun W f hf => h W f hf)
  have natA : ∀ {W Z : C} (g : Z ⟶ W) (a : A),
      (RA.obj.map g.op).hom ((αA.app (Opposite.op W)).hom a) = (αA.app (Opposite.op Z)).hom a := by
    intro W Z g a
    have h := congrArg (fun τ => τ.hom a) (αA.naturality g.op)
    simpa using h.symm
  have natB : ∀ {W Z : C} (g : Z ⟶ W) (b : B),
      (RB.obj.map g.op).hom ((αB.app (Opposite.op W)).hom b) = (αB.app (Opposite.op Z)).hom b := by
    intro W Z g b
    have h := congrArg (fun τ => τ.hom b) (αB.naturality g.op)
    simpa using h.symm
  have hsqW : ∀ (W : Cᵒᵖ) (a : A),
      (φ.hom.app W).hom ((αA.app W).hom a) = (αB.app W).hom (c.hom a) := by
    intro W a
    have h := congrArg (fun τ => (τ.app W).hom a) hsq
    simpa using h
  let sec : B → A := Function.surjInv hc
  have crux : ∀ (Z : C) (b b' : B),
      (αB.app (Opposite.op Z)).hom b = (αB.app (Opposite.op Z)).hom b' →
      (αA.app (Opposite.op Z)).hom (sec b) = (αA.app (Opposite.op Z)).hom (sec b') := by
    intro Z b b' hbb
    have hT := @Presheaf.IsLocallyInjective.equalizerSieve_mem _ _ _ _ _ _ _ _ J _ _ αB hinj
      (Opposite.op Z) b b' hbb
    apply hsep RA Z _ hT
    intro W f hf
    rw [Presheaf.equalizerSieve_apply] at hf
    have hbb' : b = b' := by simpa using hf
    rw [natA, natA, hbb']
  obtain ⟨U⟩ := V
  let S := Presheaf.imageSieve αB r'
  have hS : S ∈ J U := Presheaf.imageSieve_mem J αB r'
  have hpre : ∀ (W : C) (f : W ⟶ U) (hf : S f),
      (αB.app (Opposite.op W)).hom (Presheaf.localPreimage αB r' f hf) = (RB.obj.map f.op).hom r' :=
    fun W f hf => Presheaf.app_localPreimage αB r' f hf
  let x : Presieve.FamilyOfElements (RA.obj ⋙ forget RingCat.{u+1}) S.arrows :=
    fun W f hf => (αA.app (Opposite.op W)).hom (sec (Presheaf.localPreimage αB r' f hf))
  have hx : x.Compatible := by
    intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ h₁ h₂ heq
    change (RA.obj.map g₁.op).hom ((αA.app (Opposite.op Y₁)).hom
        (sec (Presheaf.localPreimage αB r' f₁ h₁))) =
      (RA.obj.map g₂.op).hom ((αA.app (Opposite.op Y₂)).hom
        (sec (Presheaf.localPreimage αB r' f₂ h₂)))
    rw [natA, natA]
    apply crux
    rw [← natB g₁, ← natB g₂, hpre, hpre]
    change (RB.obj.map f₁.op ≫ RB.obj.map g₁.op).hom r' = (RB.obj.map f₂.op ≫ RB.obj.map g₂.op).hom r'
    rw [← Functor.map_comp, ← Functor.map_comp, ← op_comp, ← op_comp, heq]
  have hSF := Presheaf.IsSheaf.isSheafFor (hshf RA) S hS
  refine ⟨hSF.amalgamate x hx, ?_⟩
  apply hsep RB U S hS
  intro W f hf
  have hv := hSF.valid_glue hx f hf
  have hnat : ∀ r : RA.obj.obj (Opposite.op U), (RB.obj.map f.op).hom ((φ.hom.app (Opposite.op U)).hom r) =
      (φ.hom.app (Opposite.op W)).hom ((RA.obj.map f.op).hom r) := by
    intro r
    have h := congrArg (fun τ => τ.hom r) (φ.hom.naturality f.op)
    simpa using h.symm
  rw [hnat]
  change (φ.hom.app (Opposite.op W)).hom ((RA.obj ⋙ forget RingCat.{u+1}).map f.op
    (hSF.amalgamate x hx)) = _
  rw [hv]
  change (φ.hom.app (Opposite.op W)).hom ((αA.app (Opposite.op W)).hom
    (sec (Presheaf.localPreimage αB r' f hf))) = _
  rw [hsqW, Function.surjInv_eq hc, hpre]

theorem wc_const_sheafify_ringHom_ker_nsmul : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C) (A B : RingCat.{u+1}) (c : A ⟶ B) (RA RB : Sheaf J RingCat.{u+1}) (αA : (Functor.const Cᵒᵖ).obj A ⟶ RA.obj) (αB : (Functor.const Cᵒᵖ).obj B ⟶ RB.obj) (φ : RA ⟶ RB) (n : ℕ), Presheaf.IsLocallyInjective J αA → Presheaf.IsLocallySurjective J αA → Presheaf.IsLocallyInjective J αB → αA ≫ φ.hom = (Functor.const Cᵒᵖ).map c ≫ αB → (∀ a : A, c.hom a = 0 → ∃ b : A, a = n • b) → ∀ (V : Cᵒᵖ) (r : RA.obj.obj V), (φ.hom.app V).hom r = 0 → ∃ s : RA.obj.obj V, r = n • s :=
by
  intro C _ J A B c RA RB αA αB φ n hAinj hAsurj hBinj hsq hcker V r hr
  classical

  have hcker' : ∀ a : A, ∃ b : A, c.hom a = 0 → a = n • b := by
    intro a
    by_cases h : c.hom a = 0
    · obtain ⟨b, hb⟩ := hcker a h
      exact ⟨b, fun _ => hb⟩
    · exact ⟨0, fun h' => absurd h' h⟩
  choose β hβ using hcker'

  have hN : ∀ {W W' : C} (g : W' ⟶ W) (a : A),
      (RA.obj.map g.op).hom ((αA.app (Opposite.op W)).hom a) =
        (αA.app (Opposite.op W')).hom a := by
    intro W W' g a
    have h := congrArg (fun h => h.hom a) (αA.naturality g.op)
    simp only [Functor.const_obj_map, RingCat.hom_comp, RingHom.comp_apply] at h
    exact h.symm

  have hPs : ∀ {X : C} (T : Sieve X), T ∈ J X →
      Presieve.IsSheafFor (RA.obj ⋙ forget RingCat.{u+1}) T.arrows := by
    intro X T hT
    have hP : Presheaf.IsSheaf J (RA.obj ⋙ forget RingCat.{u+1}) :=
      ((sheafCompose J (forget RingCat.{u+1})).obj RA).property
    exact (isSheaf_iff_isSheaf_of_type J _).mp hP T hT

  let S : Sieve V.unop :=
    { arrows := fun W f => ∃ a : A, c.hom a = 0 ∧
        (αA.app (Opposite.op W)).hom a = (RA.obj.map f.op).hom r
      downward_closed := by
        rintro W W' f ⟨a, ha0, ha⟩ g
        refine ⟨a, ha0, ?_⟩
        rw [← hN g a, ha, op_comp, Functor.map_comp, RingCat.hom_comp, RingHom.comp_apply] }
  have hS : S ∈ J V.unop := by
    haveI := hAsurj
    haveI := hBinj
    have h1 : Presheaf.imageSieve αA r ∈ J V.unop := Presheaf.imageSieve_mem J αA r
    refine J.transitive h1 S ?_
    intro W f hf
    obtain ⟨a, ha⟩ := hf
    change (αA.app (Opposite.op W)).hom a = (RA.obj.map f.op).hom r at ha
    have hc : (αB.app (Opposite.op W)).hom (c.hom a) = (αB.app (Opposite.op W)).hom 0 := by
      have e1 := congrArg (fun h => h.hom a) (NatTrans.congr_app hsq (Opposite.op W))
      simp only [NatTrans.comp_app, Functor.const_map_app, RingCat.hom_comp,
        RingHom.comp_apply] at e1
      rw [← e1, ha, map_zero]
      have e2 := congrArg (fun h => h.hom r) (φ.hom.naturality f.op)
      simp only [RingCat.hom_comp, RingHom.comp_apply] at e2
      rw [e2]
      erw [hr]
      exact map_zero _
    have hE := Presheaf.equalizerSieve_mem J αB (X := Opposite.op W) (c.hom a) 0 hc
    refine J.superset_covering ?_ hE
    intro W' g hg
    have hca : c.hom a = 0 := by simpa using hg
    refine ⟨a, hca, ?_⟩
    rw [← hN g a, ha, op_comp, Functor.map_comp, RingCat.hom_comp, RingHom.comp_apply]

  let x : Presieve.FamilyOfElements (RA.obj ⋙ forget RingCat.{u+1}) S.arrows :=
    fun W _ hf => (αA.app (Opposite.op W)).hom (β (Classical.choose hf))
  have hx : x.Compatible := by
    rw [Presieve.compatible_iff_sieveCompatible]
    intro Y Z f g hf
    change (αA.app (Opposite.op Z)).hom (β (Classical.choose (S.downward_closed hf g))) =
      (RA.obj.map g.op).hom ((αA.app (Opposite.op Y)).hom (β (Classical.choose hf)))
    rw [hN g]
    have h₁ := Classical.choose_spec (S.downward_closed hf g)
    have h₂ := Classical.choose_spec hf
    by_cases h : Classical.choose (S.downward_closed hf g) = Classical.choose hf
    · rw [h]
    · have heq : (αA.app (Opposite.op Z)).hom (Classical.choose (S.downward_closed hf g)) =
          (αA.app (Opposite.op Z)).hom (Classical.choose hf) := by
        rw [h₁.2, ← hN g (Classical.choose hf), h₂.2, op_comp, Functor.map_comp,
          RingCat.hom_comp, RingHom.comp_apply]
      haveI := hAinj
      have hE := Presheaf.equalizerSieve_mem J αA (X := Opposite.op Z) _ _ heq
      have hbot : (⊥ : Sieve Z) ∈ J Z :=
        J.superset_covering (fun W' k hk => absurd (by simpa using hk) h) hE
      exact (hPs ⊥ hbot).isSeparatedFor.ext (fun _ _ hk => ((Sieve.bot_apply _).mp hk).elim)
  have hsh := hPs S hS
  refine ⟨hsh.amalgamate x hx, ?_⟩
  apply hsh.isSeparatedFor.ext
  intro W f hf
  have hv := hsh.valid_glue hx f hf
  have h₂ := Classical.choose_spec hf
  change (RA.obj.map f.op).hom r = (RA.obj.map f.op).hom (n • hsh.amalgamate x hx)
  rw [map_nsmul]
  change _ = n • ((RA.obj ⋙ forget RingCat.{u+1}).map f.op (hsh.amalgamate x hx))
  rw [hv]
  change _ = n • (αA.app (Opposite.op W)).hom (β (Classical.choose hf))
  rw [← map_nsmul, ← hβ _ h₂.1, h₂.2]

theorem wc_torsion_coreflector_exists : ∀ {C : Type*} {D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] (G : D ⥤ C) [G.Additive] [G.Full] [G.Faithful] (n : ℕ), (∀ M : D, n • 𝟙 (G.obj M) = 0) → (∀ N : C, n • 𝟙 N = 0 → ∃ M : D, Nonempty (G.obj M ≅ N)) → ∃ (R : C ⥤ D) (_ : R.Additive) (adj : G ⊣ R), ∀ N : C, ∃ e : G.obj (R.obj N) ≅ Limits.kernel (n • 𝟙 N), e.hom ≫ Limits.kernel.ι (n • 𝟙 N) = adj.counit.app N :=
by
  intro C D _ _ _ _ G _ _ _ n hT hE
  classical
  have s1 : ∀ N : C, n • 𝟙 (Limits.kernel (n • 𝟙 N)) = 0 := by
    intro N
    rw [← cancel_mono (Limits.kernel.ι (n • 𝟙 N)), Preadditive.nsmul_comp, Category.id_comp,
      Limits.zero_comp]
    have h := Limits.kernel.condition (n • 𝟙 N)
    rwa [Preadditive.comp_nsmul, Category.comp_id] at h
  choose M hM using fun N : C => hE _ (s1 N)
  let e : ∀ N : C, G.obj (M N) ≅ Limits.kernel (n • 𝟙 N) := fun N => (hM N).some
  have s3 : ∀ {X : D} {Y : C} (f : G.obj X ⟶ Y), f ≫ (n • 𝟙 Y) = 0 := by
    intro X Y f
    have h := congrArg (· ≫ f) (hT X)
    simp only [Preadditive.nsmul_comp, Category.id_comp, Limits.zero_comp] at h
    rw [Preadditive.comp_nsmul, Category.comp_id, h]
  let E : ∀ (X : D) (Y : C), (G.obj X ⟶ Y) ≃ (X ⟶ M Y) := fun X Y =>
    { toFun := fun f => G.preimage (Limits.kernel.lift (n • 𝟙 Y) f (s3 f) ≫ (e Y).inv)
      invFun := fun g => G.map g ≫ (e Y).hom ≫ Limits.kernel.ι (n • 𝟙 Y)
      left_inv := fun f => by
        simp only [Functor.map_preimage, Category.assoc, Iso.inv_hom_id_assoc,
          Limits.kernel.lift_ι]
      right_inv := fun g => by
        apply G.map_injective
        simp only [Functor.map_preimage]
        rw [← cancel_mono (e Y).hom, Category.assoc, Iso.inv_hom_id, Category.comp_id,
          ← cancel_mono (Limits.kernel.ι (n • 𝟙 Y)), Limits.kernel.lift_ι, Category.assoc] }
  have he : ∀ (X' X : D) (Y : C) (f : X' ⟶ X) (g : G.obj X ⟶ Y),
      E X' Y (G.map f ≫ g) = f ≫ E X Y g := by
    intro X' X Y f g
    rw [Equiv.apply_eq_iff_eq_symm_apply]
    show G.map f ≫ g = G.map (f ≫ E X Y g) ≫ (e Y).hom ≫ Limits.kernel.ι (n • 𝟙 Y)
    rw [G.map_comp, Category.assoc]
    congr 1
    exact ((E X Y).symm_apply_apply g).symm
  let adj := Adjunction.adjunctionOfEquivRight E he
  haveI : (Adjunction.rightAdjointOfEquiv E he).Additive := adj.right_adjoint_additive
  refine ⟨Adjunction.rightAdjointOfEquiv E he, inferInstance, adj, fun N => ⟨e N, ?_⟩⟩
  rw [Adjunction.adjunctionOfEquivRight_counit_app]
  show (e N).hom ≫ _ = G.map (𝟙 _) ≫ (e N).hom ≫ _
  rw [G.map_id, Category.id_comp]

theorem wc_kernel_iso_cokernel_of_div : ∀ {C : Type*} [Category C] [Abelian C] (X : C) (a b : ℕ), (a • 𝟙 X) ≫ (b • 𝟙 X) = 0 → (b • 𝟙 X) ≫ (a • 𝟙 X) = 0 → (∀ {Z : C} (z : Z ⟶ X), z ≫ (a • 𝟙 X) = 0 → ∃ (Z' : C) (π : Z' ⟶ Z) (_ : Epi π) (t : Z' ⟶ X), π ≫ z = t ≫ (b • 𝟙 X)) → (∀ {Z : C} (z : Z ⟶ X), z ≫ (b • 𝟙 X) = 0 → ∃ (Z' : C) (π : Z' ⟶ Z) (_ : Epi π) (t : Z' ⟶ X), π ≫ z = t ≫ (a • 𝟙 X)) → Nonempty (Limits.kernel (a • 𝟙 X) ≅ Limits.cokernel (a • 𝟙 X)) :=
by
  intro C _ _ X a b hab hba hA hB
  generalize a • 𝟙 X = A at hab hba hA hB ⊢
  generalize b • 𝟙 X = B at hab hba hA hB ⊢
  let φ : X ⟶ Limits.kernel A := Limits.kernel.lift A B hba
  have hφ : φ ≫ Limits.kernel.ι A = B := Limits.kernel.lift_ι _ _ _
  have h2 : A ≫ φ = 0 := by
    rw [← cancel_mono (Limits.kernel.ι A), Category.assoc, hφ, hab, Limits.zero_comp]
  let ψ : Limits.cokernel A ⟶ Limits.kernel A := Limits.cokernel.desc A φ h2
  have hK : Limits.cokernel.π A ≫ ψ ≫ Limits.kernel.ι A = B := by
    rw [Limits.cokernel.π_desc_assoc, hφ]
  have hmono : Mono ψ := by
    apply Preadditive.mono_of_cancel_zero
    intro P g hg
    obtain ⟨P', π₁, hπ₁, x, hx⟩ :=
      surjective_up_to_refinements_of_epi (Limits.cokernel.π A) g
    have hxB : x ≫ B = 0 := by
      rw [← hK, ← Category.assoc x, ← hx, Category.assoc, ← Category.assoc g, hg,
        Limits.zero_comp, Limits.comp_zero]
    obtain ⟨P'', π₂, hπ₂, t, ht⟩ := hB x hxB
    haveI := hπ₁
    haveI := hπ₂
    have h3 : (π₂ ≫ π₁) ≫ g = 0 := by
      rw [Category.assoc, hx, ← Category.assoc, ht, Category.assoc,
        Limits.cokernel.condition, Limits.comp_zero]
    exact (cancel_epi (π₂ ≫ π₁)).1 (h3.trans Limits.comp_zero.symm)
  have hepi : Epi ψ := by
    obtain ⟨Z', π₀, hπ₀, t, ht⟩ := hA (Limits.kernel.ι A) (Limits.kernel.condition A)
    have h4 : π₀ = (t ≫ Limits.cokernel.π A) ≫ ψ := by
      rw [← cancel_mono (Limits.kernel.ι A), ht, Category.assoc, Category.assoc, hK]
    haveI := hπ₀
    exact epi_of_epi_fac h4.symm
  haveI := isIso_of_mono_of_epi ψ
  exact ⟨(asIso ψ).symm⟩

theorem wc_div_resolution_cocycle : ∀ {C : Type*} [Category C] [Abelian C] (K : CochainComplex C ℕ) (A : C) (ι : A ⟶ K.X 0) (a b : ℕ), Mono ι → ι ≫ K.d 0 1 = 0 → (∀ {Z : C} (z : Z ⟶ K.X 0), z ≫ K.d 0 1 = 0 → ∃ (Z' : C) (π : Z' ⟶ Z) (_ : Epi π) (t : Z' ⟶ A), π ≫ z = t ≫ ι) → (∀ n : ℕ, K.ExactAt (n + 1)) → (∀ {Z : C} (z : Z ⟶ A), z ≫ (a • 𝟙 A) = 0 → ∃ (Z' : C) (π : Z' ⟶ Z) (_ : Epi π) (t : Z' ⟶ A), π ≫ z = t ≫ (b • 𝟙 A)) → (∀ {Z : C} (z : Z ⟶ A), z ≫ (b • 𝟙 A) = 0 → ∃ (Z' : C) (π : Z' ⟶ Z) (_ : Epi π) (t : Z' ⟶ A), π ≫ z = t ≫ (a • 𝟙 A)) → (∀ n : ℕ, (a • 𝟙 (K.X n)) ≫ (b • 𝟙 (K.X n)) = 0 ∧ (b • 𝟙 (K.X n)) ≫ (a • 𝟙 (K.X n)) = 0 ∧ (∀ {Z : C} (z : Z ⟶ K.X n), z ≫ (a • 𝟙 (K.X n)) = 0 → ∃ (Z' : C) (π : Z' ⟶ Z) (_ : Epi π) (t : Z' ⟶ K.X n), π ≫ z = t ≫ (b • 𝟙 (K.X n))) ∧ (∀ {Z : C} (z : Z ⟶ K.X n), z ≫ (b • 𝟙 (K.X n)) = 0 → ∃ (Z' : C) (π : Z' ⟶ Z) (_ : Epi π) (t : Z' ⟶ K.X n), π ≫ z = t ≫ (a • 𝟙 (K.X n)))) → ∀ (q : ℕ) {Z : C} (x : Z ⟶ K.X (q + 1)), x ≫ (a • 𝟙 (K.X (q + 1))) = 0 → x ≫ K.d (q + 1) (q + 2) = 0 → ∃ (Z' : C) (π : Z' ⟶ Z) (_ : Epi π) (y : Z' ⟶ K.X q), y ≫ (a • 𝟙 (K.X q)) = 0 ∧ π ≫ x = y ≫ K.d q (q + 1) :=
by
  intro C _ _ K A ι a b hι hι0 hE0 hE hAab hAba hK q
  have sm1 : ∀ {P Q : C} (f : P ⟶ Q) (c : ℕ), f ≫ (c • 𝟙 Q) = c • f := by
    intro P Q f c
    rw [Preadditive.comp_nsmul, Category.comp_id]
  have sm2 : ∀ {P Q : C} (f : P ⟶ Q) (c : ℕ), (c • 𝟙 P) ≫ f = c • f := by
    intro P Q f c
    rw [Preadditive.nsmul_comp, Category.id_comp]
  have lift : ∀ (q : ℕ) {Z : C} (x : Z ⟶ K.X (q + 1)), x ≫ K.d (q + 1) (q + 2) = 0 →
      ∃ (Z' : C) (π : Z' ⟶ Z) (_ : Epi π) (w : Z' ⟶ K.X q), π ≫ x = w ≫ K.d q (q + 1) := by
    intro q Z x hx
    have h := (HomologicalComplex.exactAt_iff' K q (q + 1) (q + 2)
      (CochainComplex.prev_nat_succ q) (CochainComplex.next ℕ (q + 1))).1 (hE q)
    exact h.exact_up_to_refinements x hx
  induction q generalizing a b with
  | zero =>
    show ∀ {Z : C} (x : Z ⟶ K.X 1), x ≫ (a • 𝟙 (K.X 1)) = 0 → x ≫ K.d 1 2 = 0 →
      ∃ (Z' : C) (π : Z' ⟶ Z) (_ : Epi π) (y : Z' ⟶ K.X 0),
        y ≫ (a • 𝟙 (K.X 0)) = 0 ∧ π ≫ x = y ≫ K.d 0 1
    intro Z x hxa hxd
    obtain ⟨Z₁, π₁, hπ₁, w, hw⟩ := lift 0 x hxd
    have hw' : π₁ ≫ x = w ≫ K.d 0 1 := hw
    have hud : (w ≫ (a • 𝟙 (K.X 0))) ≫ K.d 0 1 = 0 := by
      rw [Category.assoc, sm2, ← sm1, ← Category.assoc, ← hw', Category.assoc, hxa,
        Limits.comp_zero]
    have hub : (w ≫ (a • 𝟙 (K.X 0))) ≫ (b • 𝟙 (K.X 0)) = 0 := by
      rw [Category.assoc, (hK 0).1, Limits.comp_zero]
    obtain ⟨Z₂, π₂, hπ₂, t, ht⟩ := hE0 (w ≫ (a • 𝟙 (K.X 0))) hud
    have htb : t ≫ (b • 𝟙 A) = 0 := by
      rw [← cancel_mono ι, Limits.zero_comp, Category.assoc, sm2, ← sm1, ← Category.assoc, ← ht,
        Category.assoc, hub, Limits.comp_zero]
    obtain ⟨Z₃, π₃, hπ₃, s, hs⟩ := hAba t htb
    refine ⟨Z₃, π₃ ≫ π₂ ≫ π₁, epi_comp _ _, π₃ ≫ π₂ ≫ w - s ≫ ι, ?_, ?_⟩
    · simp only [Preadditive.sub_comp, Category.assoc]
      rw [ht, sm1 ι, ← sm2 ι, ← Category.assoc s, ← hs, Category.assoc, sub_self]
    · simp only [Preadditive.sub_comp, Category.assoc, hι0, Limits.comp_zero, sub_zero, hw']
  | succ n ih =>
    intro Z x hxa hxd
    obtain ⟨Z₁, π₁, hπ₁, w, hw⟩ := lift (n + 1) x hxd
    have hud : (w ≫ (a • 𝟙 (K.X (n + 1)))) ≫ K.d (n + 1) (n + 1 + 1) = 0 := by
      rw [Category.assoc, sm2, ← sm1, ← Category.assoc, ← hw, Category.assoc, hxa,
        Limits.comp_zero]
    have hub : (w ≫ (a • 𝟙 (K.X (n + 1)))) ≫ (b • 𝟙 (K.X (n + 1))) = 0 := by
      rw [Category.assoc, (hK (n + 1)).1, Limits.comp_zero]
    obtain ⟨Z₂, π₂, hπ₂, v, hvb, hv⟩ := ih b a hAba hAab
      (fun m => ⟨(hK m).2.1, (hK m).1, (hK m).2.2.2, (hK m).2.2.1⟩)
      (w ≫ (a • 𝟙 (K.X (n + 1)))) hub hud
    obtain ⟨Z₃, π₃, hπ₃, s, hs⟩ := (hK n).2.2.2 v hvb
    refine ⟨Z₃, π₃ ≫ π₂ ≫ π₁, epi_comp _ _, π₃ ≫ π₂ ≫ w - s ≫ K.d n (n + 1), ?_, ?_⟩
    · simp only [Preadditive.sub_comp, Category.assoc]
      have e2 : K.d n (n + 1) ≫ (a • 𝟙 (K.X (n + 1))) = (a • 𝟙 (K.X n)) ≫ K.d n (n + 1) := by
        rw [sm1, sm2]
      rw [hv, e2, ← Category.assoc s, ← hs, Category.assoc, sub_self]
    · simp only [Preadditive.sub_comp, Category.assoc, HomologicalComplex.d_comp_d,
        Limits.comp_zero, sub_zero, hw]

theorem wc_coreflector_homology_vanish : ∀ {C : Type*} {D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] (G : D ⥤ C) [G.Additive] [Limits.PreservesFiniteLimits G] [Limits.PreservesFiniteColimits G] [G.Faithful] (R : C ⥤ D) [R.Additive] (adj : G ⊣ R) (n : ℕ), (∀ N : C, ∃ e : G.obj (R.obj N) ≅ Limits.kernel (n • 𝟙 N), e.hom ≫ Limits.kernel.ι (n • 𝟙 N) = adj.counit.app N) → ∀ (K : CochainComplex C ℕ), (∀ (q : ℕ) {Z : C} (x : Z ⟶ K.X (q + 1)), x ≫ (n • 𝟙 (K.X (q + 1))) = 0 → x ≫ K.d (q + 1) (q + 2) = 0 → ∃ (Z' : C) (π : Z' ⟶ Z) (_ : Epi π) (y : Z' ⟶ K.X q), y ≫ (n • 𝟙 (K.X q)) = 0 ∧ π ≫ x = y ≫ K.d q (q + 1)) → ∀ q : ℕ, 1 ≤ q → Limits.IsZero (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj K).homology q) :=
by
  intro C D _ _ _ _ G _ _ _ _ R _ adj n H1 K H2 q hq
  obtain ⟨p, rfl⟩ : ∃ p, q = p + 1 := ⟨q - 1, by omega⟩
  rw [← HomologicalComplex.exactAt_iff_isZero_homology]
  have hnext : (ComplexShape.up ℕ).next (p + 1) = p + 2 := CochainComplex.next ℕ (p + 1)
  rw [HomologicalComplex.exactAt_iff' _ p (p + 1) (p + 2) (CochainComplex.prev_nat_succ p) hnext]
  apply Functor.reflects_exact_of_faithful G
  rw [ShortComplex.exact_iff_exact_up_to_refinements]
  change ∀ ⦃A : C⦄ (x₂ : A ⟶ G.obj (R.obj (K.X (p + 1)))),
    x₂ ≫ G.map (R.map (K.d (p + 1) (p + 2))) = 0 →
    ∃ (A' : C) (π : A' ⟶ A) (_ : Epi π) (x₁ : A' ⟶ G.obj (R.obj (K.X p))),
      π ≫ x₂ = x₁ ≫ G.map (R.map (K.d p (p + 1)))
  intro A x₂ hx₂
  let ε : ∀ N : C, G.obj (R.obj N) ⟶ N := fun N => adj.counit.app N
  have hε : ∀ N : C, ∃ e : G.obj (R.obj N) ≅ Limits.kernel (n • 𝟙 N),
      e.hom ≫ Limits.kernel.ι (n • 𝟙 N) = ε N := H1
  have hmono : ∀ N : C, Mono (ε N) := by
    intro N
    obtain ⟨e, he⟩ := hε N
    rw [← he]
    infer_instance
  have htor : ∀ N : C, ε N ≫ (n • 𝟙 N) = 0 := by
    intro N
    obtain ⟨e, he⟩ := hε N
    rw [← he, Category.assoc, Limits.kernel.condition, Limits.comp_zero]
  have hnat : ∀ {N N' : C} (f : N ⟶ N'),
      G.map (R.map f) ≫ ε N' = ε N ≫ f :=
    fun f => adj.counit_naturality f
  obtain ⟨Z', π, hπ, y, hy, hxy⟩ := H2 p (x₂ ≫ ε (K.X (p + 1)))
    (by rw [Category.assoc, htor, Limits.comp_zero])
    (by rw [Category.assoc, ← hnat, ← Category.assoc, hx₂, Limits.zero_comp])
  obtain ⟨e, he⟩ := hε (K.X p)
  refine ⟨Z', π, hπ, Limits.kernel.lift _ y hy ≫ e.inv, ?_⟩
  rw [← cancel_mono (ε (K.X (p + 1)))]
  simp only [Category.assoc]
  rw [hxy, hnat, ← he]
  simp only [Category.assoc, Iso.inv_hom_id_assoc, Limits.kernel.lift_ι_assoc]

theorem wc_sheafOfModules_injective_sections_div : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C) [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}] (R : Sheaf J RingCat.{u+1}) (R0 : Cᵒᵖ ⥤ RingCat.{u+1}) (α : R0 ⟶ R.obj), Presheaf.IsLocallyInjective J α → Presheaf.IsLocallySurjective J α → ∀ (a b : ℕ), (∀ (V : Cᵒᵖ) (r : R0.obj V), a • r = 0 → ∃ r' : R0.obj V, r = b • r') → ∀ (I : SheafOfModules.{u+1} R) [Injective I] (W : Cᵒᵖ) (s : I.val.obj W), b • s = 0 → ∃ t : I.val.obj W, s = a • t :=
by
  intro C _ J _ _ R R0 α hinj hsurj a b hab I _ W s hs
  haveI : Presheaf.IsLocallyInjective J α := hinj
  haveI : Presheaf.IsLocallySurjective J α := hsurj
  have hG := Injective.injective_of_adjoint
    (PresheafOfModules.sheafificationAdjunction (J := J) (R := R) α) I
  have hp : ∀ {M N : PresheafOfModules.{u+1} R0} (f : M ⟶ N) (k : ℕ) (V : Cᵒᵖ) (x : M.obj V),
      ((k • f).app V).hom x = k • (f.app V).hom x := by
    intro M N f k V x
    induction k with
    | zero => simp
    | succ k ih =>
      rw [succ_nsmul, PresheafOfModules.add_app, ModuleCat.hom_add, LinearMap.add_apply, ih,
        succ_nsmul]
  have hz : ∀ {M N : PresheafOfModules.{u+1} R0} (V : Cᵒᵖ) (x : M.obj V),
      ((0 : M ⟶ N).app V).hom x = 0 := by
    intro M N V x
    rw [PresheafOfModules.zero_app, ModuleCat.hom_zero, LinearMap.zero_apply]
  have hmain : ∀ (G : PresheafOfModules.{u+1} R0) [Injective G] (X : C)
      (s : G.obj (Opposite.op X)), b • s = 0 → ∃ t : G.obj (Opposite.op X), s = a • t := by
    intro G _ X s hs
    let P := PresheafOfModules.freeObj (R := R0) (uliftYoneda.{u+1}.obj X)
    let e : P.obj (Opposite.op X) :=
      ModuleCat.freeMk (ULift.up (𝟙 X) : (uliftYoneda.{u+1}.obj X).obj (Opposite.op X))
    let τ0 : uliftYoneda.{u+1}.obj X ⟶ G.presheaf ⋙ forget Ab := uliftYonedaEquiv.symm s
    let σ : P ⟶ G := PresheafOfModules.freeObjDesc τ0
    have hσ : (σ.app (Opposite.op X)).hom e = s := by
      have e1 : uliftYonedaEquiv τ0 = s := Equiv.apply_symm_apply _ _
      rw [uliftYonedaEquiv_apply] at e1
      rw [PresheafOfModules.freeObjDesc_app]
      rw [← e1]
      exact ModuleCat.freeDesc_apply _ _
    have hbσ : b • σ = 0 := by
      apply PresheafOfModules.hom_ext
      intro V
      refine ModuleCat.free_hom_ext (fun y => ?_)
      let x : P.obj V := ModuleCat.freeMk y
      have hx : (σ.app V).hom x = (G.presheaf.map y.down.op).hom s := by
        rw [PresheafOfModules.freeObjDesc_app]
        refine (ModuleCat.freeDesc_apply _ _).trans ?_
        rfl
      show ((b • σ).app V).hom x = ((0 : P ⟶ G).app V).hom x
      rw [hp, hz, hx]
      exact (map_nsmul (G.presheaf.map y.down.op).hom b s).symm.trans
        ((congrArg (G.presheaf.map y.down.op).hom hs).trans (map_zero _))
    let μ : P ⟶ P := a • 𝟙 P
    have hk : Limits.kernel.ι μ ≫ σ = 0 := by
      apply PresheafOfModules.hom_ext
      intro V
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro y
      rw [hz]
      have h1 : ((Limits.kernel.ι μ ≫ μ).app V).hom y =
          ((0 : Limits.kernel μ ⟶ P).app V).hom y := by
        rw [Limits.kernel.condition]
      rw [Preadditive.comp_nsmul, Category.comp_id, hp, hz] at h1
      let c : (uliftYoneda.{u+1}.obj X).obj V →₀ R0.obj V := ((Limits.kernel.ι μ).app V).hom y
      have h3 : a • c = 0 := h1
      classical
      let f : R0.obj V → R0.obj V := fun r =>
        if r = 0 then 0 else if h : a • r = 0 then Classical.choose (hab V r h) else 0
      have hf0 : f 0 = 0 := by simp only [f, if_true]
      have hfb : ∀ r : R0.obj V, a • r = 0 → r = b • f r := by
        intro r hr
        by_cases h0 : r = 0
        · rw [h0, hf0, smul_zero]
        · have : f r = Classical.choose (hab V r hr) := by
            simp only [f]; rw [if_neg h0, dif_pos hr]
          rw [this]
          exact Classical.choose_spec (hab V r hr)
      have hc' : c = b • Finsupp.mapRange f hf0 c := by
        ext x
        rw [Finsupp.smul_apply, Finsupp.mapRange_apply]
        apply hfb
        rw [← Finsupp.smul_apply, h3, Finsupp.zero_apply]
      let c' : P.obj V := Finsupp.mapRange f hf0 c
      have hc'' : ((Limits.kernel.ι μ).app V).hom y = b • c' := hc'
      change (σ.app V).hom (((Limits.kernel.ι μ).app V).hom y) = 0
      rw [hc'', map_nsmul, ← hp, hbσ, hz]
    let σ' : Abelian.coimage μ ⟶ G := Limits.cokernel.desc (Limits.kernel.ι μ) σ hk
    let τ : P ⟶ G := Injective.factorThru σ' (Abelian.factorThruCoimage μ)
    have hτ : μ ≫ τ = σ := by
      rw [← Abelian.coimage.fac μ, Category.assoc, Injective.comp_factorThru]
      exact Limits.cokernel.π_desc _ _ _
    have hτ' : a • τ = σ := by
      rw [← hτ]
      simp only [μ, Preadditive.nsmul_comp, Category.id_comp]
    refine ⟨(τ.app (Opposite.op X)).hom e, ?_⟩
    have h5 := hp τ a (Opposite.op X) e
    rw [hτ'] at h5
    rw [← h5, hσ]
  obtain ⟨t, ht⟩ := @hmain _ hG W.unop s hs
  exact ⟨t, ht⟩

theorem wc_sheafOfModules_div_sections_refine : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C) [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}] (R : Sheaf J RingCat.{u+1}) (M : SheafOfModules.{u+1} R) (a b : ℕ), (b • 𝟙 M) ≫ (a • 𝟙 M) = 0 → (∀ (W : Cᵒᵖ) (s : M.val.obj W), a • s = 0 → ∃ t : M.val.obj W, s = b • t) → ∀ {Z : SheafOfModules.{u+1} R} (z : Z ⟶ M), z ≫ (a • 𝟙 M) = 0 → ∃ (Z' : SheafOfModules.{u+1} R) (π : Z' ⟶ Z) (_ : Epi π) (t : Z' ⟶ M), π ≫ z = t ≫ (b • 𝟙 M) :=
by
  intro C _ J _ _ R M a b _ hdiv Z z hz
  have hns : ∀ (N : SheafOfModules.{u+1} R) (n : ℕ) (W : Cᵒᵖ) (y : N.val.obj W),
      ((n • 𝟙 N).val.app W).hom y = n • y := by
    intro N n W y
    have h1 : (SheafOfModules.forget R ⋙ PresheafOfModules.evaluation R.val W).map (n • 𝟙 N) =
        n • 𝟙 ((SheafOfModules.forget R ⋙ PresheafOfModules.evaluation R.val W).obj N) := by
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
    have h2 : ((n • 𝟙 N).val.app W) =
        (SheafOfModules.forget R ⋙ PresheafOfModules.evaluation R.val W).map (n • 𝟙 N) := rfl
    rw [h2, h1]
    rfl
  have hzero : ∀ (W : Cᵒᵖ) (x : Z.val.obj W), ((0 : Z ⟶ M).val.app W).hom x = 0 := by
    intro W x
    have h1 : (SheafOfModules.forget R ⋙ PresheafOfModules.evaluation R.val W).map (0 : Z ⟶ M) = 0 :=
      CategoryTheory.Functor.map_zero _ _ _
    have h2 : ((0 : Z ⟶ M).val.app W) =
        (SheafOfModules.forget R ⋙ PresheafOfModules.evaluation R.val W).map (0 : Z ⟶ M) := rfl
    rw [h2, h1]
    rfl
  have hsurj : ∀ (W : Cᵒᵖ) (x : Z.val.obj W),
      ∃ p : (Limits.pullback z (b • 𝟙 M)).val.obj W,
        ((Limits.pullback.fst z (b • 𝟙 M)).val.app W).hom p = x := by
    intro W x
    have hy : a • (z.val.app W).hom x = 0 := by
      have h := congrArg (fun f => (f.val.app W).hom x) hz
      have h' : ((z ≫ (a • 𝟙 M)).val.app W).hom x = ((a • 𝟙 M).val.app W).hom ((z.val.app W).hom x) := rfl
      rw [← hns M a W, ← h']
      exact h.trans (hzero W x)
    obtain ⟨t₀, ht₀⟩ := hdiv W _ hy
    let G : SheafOfModules.{u+1} R ⥤ Type (u+1) :=
      SheafOfModules.forget R ⋙ PresheafOfModules.evaluation R.val W ⋙ forget (ModuleCat (R.val.obj W))
    have hP := (IsPullback.of_hasPullback z (b • 𝟙 M)).map G
    have heq : G.map z x = G.map (b • 𝟙 M) t₀ := by
      change (z.val.app W).hom x = ((b • 𝟙 M).val.app W).hom t₀
      rw [hns]
      exact ht₀
    obtain ⟨p, hp1, -⟩ := Limits.Types.exists_of_isPullback hP x t₀ heq
    exact ⟨p, hp1⟩
  refine ⟨_, Limits.pullback.fst z (b • 𝟙 M), ⟨fun {Q} g h hgh => ?_⟩,
    Limits.pullback.snd z (b • 𝟙 M), Limits.pullback.condition⟩
  apply SheafOfModules.hom_ext
  apply PresheafOfModules.hom_ext
  intro W
  ext x
  obtain ⟨p, hp⟩ := hsurj W x
  rw [← hp]
  exact congrArg (fun f => (f.val.app W).hom p) hgh

