    have hres : ∀ φ : L →ₐ[k] Ω, N.val.comp (res φ) = φ := fun φ => AlgHom.ext fun _ => rfl
    let γN : (L →ₐ[k] N) → S := fun ψ => γ (N.val.comp ψ)
    have hγN : ∀ φ, γN (res φ) = γ φ := fun φ => congrArg γ (hres φ)
    let act : (N ≃ₐ[k] N) → (L →ₐ[k] N) → (L →ₐ[k] N) := fun τ ψ => (τ : N →ₐ[k] N).comp ψ
    have act_one : ∀ ψ, act 1 ψ = ψ := fun ψ => AlgHom.ext fun _ => rfl
    have act_mul : ∀ τ₁ τ₂ ψ, act (τ₁ * τ₂) ψ = act τ₁ (act τ₂ ψ) :=
      fun _ _ _ => AlgHom.ext fun _ => rfl
    have act_apply : ∀ τ ψ a, act τ ψ a = τ (ψ a) := fun _ _ _ => rfl
    have hI : ∀ (τ : N ≃ₐ[k] N) ψ ψ', γN ψ = γN ψ' → γN (act τ ψ) = γN (act τ ψ') := by
      intro τ ψ ψ' h
      have e : ∀ ψ₁ : L →ₐ[k] N, N.val.comp (act τ ψ₁) =
          ((τ.liftNormal Ω : Ω ≃ₐ[k] Ω) : Ω →ₐ[k] Ω).comp (N.val.comp ψ₁) := by
        intro ψ₁
        ext a
