        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
  let E1 := Equiv.ofBijective _ (hΨ.comp hΦ)
  let E3 := Equiv.ofBijective _ hΨ₃
