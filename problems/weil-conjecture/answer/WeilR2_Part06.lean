  have hsheaf : Presheaf.IsSheaf (Scheme.smallEtaleTopology Y)
      ((wcEtBaseChange σ).op ⋙ (wcEtZModRing Z m).obj) :=
    (((wcEtBaseChange σ).sheafPushforwardContinuous RingCat.{u+1} (Scheme.smallEtaleTopology Y)
      (Scheme.smallEtaleTopology Z)).obj (wcEtZModRing Z m)).cond
  let φhom : (wcEtZModRing Y m).obj ⟶ (wcEtBaseChange σ).op ⋙ (wcEtZModRing Z m).obj :=
    sheafifyLift (Scheme.smallEtaleTopology Y) η hsheaf
  let φ : wcEtZModRing Y m ⟶ ((wcEtBaseChange σ).sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology Z)).obj (wcEtZModRing Z m) :=
    ObjectProperty.homMk φhom
  have hC : ∀ (V : Y.Etale) (t : ULift.{u+1} (ZMod m)),
      (φ.hom.app (Opposite.op V)).hom ((α.app (Opposite.op V)).hom t) =
        (α'.app (Opposite.op ((wcEtBaseChange σ).obj V))).hom t := by
    intro V t
    have h := toSheafify_sheafifyLift (Scheme.smallEtaleTopology Y) η hsheaf
    have h2 := congrArg (fun k => (k.app (Opposite.op V)).hom t) h
    exact h2
  have hsurj : ∀ (V' : Z.Etale) (r' : (wcEtZModRing Z m).obj.obj (Opposite.op V')),
      ∃ T ∈ Scheme.smallEtaleTopology Z V', ∀ ⦃W' : Z.Etale⦄ (f : W' ⟶ V'),
      T.arrows f → ∃ (V : Y.Etale) (a : W' ⟶ (wcEtBaseChange σ).obj V)
        (r : (wcEtZModRing Y m).obj.obj (Opposite.op V)),
        ((wcEtZModRing Z m).obj.map f.op).hom r' =
          ((wcEtZModRing Z m).obj.map a.op).hom ((φ.hom.app (Opposite.op V)).hom r) := by
    intro V' r'
    refine ⟨Presheaf.imageSieve α' r', Presheaf.imageSieve_mem _ α' r', ?_⟩
    intro W' f hf
    obtain ⟨t, ht⟩ := hf
    refine ⟨⊤_ Y.Etale, hT.from W', (α.app (Opposite.op (⊤_ Y.Etale))).hom t, ?_⟩
    rw [hC (⊤_ Y.Etale) t, hα'nat (hT.from W') t]
    exact ht.symm
  have hcomp : ∀ {X₁ X₂ X₃ : (Z.Etale)ᵒᵖ} (p₀ : X₁ ⟶ X₂) (q₀ : X₂ ⟶ X₃)
      (x : (wcEtZModRing Z m).obj.obj X₁),
      ((wcEtZModRing Z m).obj.map q₀).hom (((wcEtZModRing Z m).obj.map p₀).hom x) =
        ((wcEtZModRing Z m).obj.map (p₀ ≫ q₀)).hom x := by
    intro X₁ X₂ X₃ p₀ q₀ x
    rw [Functor.map_comp]
    rfl
  have hinj : ∀ (V' : Z.Etale) (V : Y.Etale) (a : V' ⟶ (wcEtBaseChange σ).obj V)
      (r : (wcEtZModRing Y m).obj.obj (Opposite.op V)),
      ((wcEtZModRing Z m).obj.map a.op).hom ((φ.hom.app (Opposite.op V)).hom r) = 0 →
      ∃ T ∈ Scheme.smallEtaleTopology Z V', ∀ ⦃W' : Z.Etale⦄ (f : W' ⟶ V'), T.arrows f →
        ∃ (W : Y.Etale) (bb : W ⟶ V) (a' : W' ⟶ (wcEtBaseChange σ).obj W),
          a' ≫ (wcEtBaseChange σ).map bb = f ≫ a ∧
            ((wcEtZModRing Y m).obj.map bb.op).hom r = 0 := by
    intro V' V a r hr
    let T : Sieve V' :=
      { arrows := fun W' f => ∃ (W : Y.Etale) (bb : W ⟶ V) (a' : W' ⟶ (wcEtBaseChange σ).obj W),
          a' ≫ (wcEtBaseChange σ).map bb = f ≫ a ∧ ((wcEtZModRing Y m).obj.map bb.op).hom r = 0
        downward_closed := by
          rintro W₁ W₂ f ⟨W, bb, a', e1, e2⟩ mm
          exact ⟨W, bb, mm ≫ a', by simp only [Category.assoc, e1], e2⟩ }
    refine ⟨T, ?_, fun W' f hf => hf⟩
    have hI : Presheaf.imageSieve α r ∈ Scheme.smallEtaleTopology Y V :=
      Presheaf.imageSieve_mem _ α r
    have hP1 : Sieve.pullback a (Sieve.functorPushforward (wcEtBaseChange σ)
        (Presheaf.imageSieve α r)) ∈ Scheme.smallEtaleTopology Z V' :=
      (Scheme.smallEtaleTopology Z).pullback_stable a (hcov.cover_preserve hI)
    apply (Scheme.smallEtaleTopology Z).transitive hP1
    intro W₁ h hh
    obtain ⟨Zo, co, k, hco, hk⟩ := hh
    obtain ⟨t, ht⟩ := hco
    have ht' : (α.app (Opposite.op Zo)).hom t = ((wcEtZModRing Y m).obj.map co.op).hom r := ht
    have hnat : ((wcEtZModRing Z m).obj.map ((wcEtBaseChange σ).map co).op).hom
        ((φ.hom.app (Opposite.op V)).hom r) =
        (φ.hom.app (Opposite.op Zo)).hom (((wcEtZModRing Y m).obj.map co.op).hom r) := by
      have := congrArg (fun qq => qq.hom r) (φ.hom.naturality co.op)
      exact this.symm
    have key : ∀ x : (wcEtZModRing Z m).obj.obj (Opposite.op ((wcEtBaseChange σ).obj V)),
        ((wcEtZModRing Z m).obj.map k.op).hom
          (((wcEtZModRing Z m).obj.map ((wcEtBaseChange σ).map co).op).hom x) =
        ((wcEtZModRing Z m).obj.map h.op).hom (((wcEtZModRing Z m).obj.map a.op).hom x) := by
      intro x
