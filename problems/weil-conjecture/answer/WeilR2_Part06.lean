  have hM0 : ℓ ^ m ≠ 0 := pow_ne_zero m hℓ.ne_zero
  have hMpos : 0 < ℓ ^ m := Nat.pos_of_ne_zero hM0
  have hMK : ((ℓ ^ m : ℕ) : K) ≠ 0 := by
    rw [Nat.cast_pow]
