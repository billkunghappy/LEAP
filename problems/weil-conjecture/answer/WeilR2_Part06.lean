    rw [← Scheme.Hom.comp_apply, heπ, hv]

  have hrangeπ : Set.range π = closure ({η} : Set B) := by
    apply Set.Subset.antisymm
    · have hVB0 : ∀ w : V.left, V.hom w ∈ closure ({η} : Set B) := by
