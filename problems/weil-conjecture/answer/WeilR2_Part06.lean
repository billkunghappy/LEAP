  have hWirr : IsIrreducible (W : Set V₀.left) :=
    hFirr'.isPreirreducible.subset_irreducible ⟨v, hvW⟩ W.isOpen (subset_refl _)
      (by rw [hWset]; exact Set.inter_subset_left)
  exact ⟨W, B.basicOpen r, V₀.hom.resLE (B.basicOpen r) W inf_le_right, hvW,
    Subtype.irreducibleSpace hWirr, hOY₁.basicOpen r, hfin, Scheme.Hom.resLE_comp_ι _ _⟩

theorem wc_r2gc_generic_generating_section : ∀ (K : Type u) [Field K] [IsAlgClosed K] (X B : Scheme.{u}) (fB : B ⟶ Spec (.of K)) [IsProper fB] (g : X ⟶ B) [IsProper g] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ n : ℕ, topologicalKrullDim B ≤ (n : WithBot ℕ∞) → (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ B), topologicalKrullDim ↥(Limits.pullback g t) ≤ ((1 : ℕ) : WithBot ℕ∞)) → ∀ (U : X.Opens), IrreducibleSpace ↥U → ∀ (η : B), closure ({η} : Set B) = closure (⇑g '' (U : Set X)) → ¬ topologicalKrullDim ↥(closure ({η} : Set B)) < (n : WithBot ℕ∞) → topologicalKrullDim ↥((U : Set X)ᶜ ∩ ⇑g ⁻¹' {η}) ≤ ((0 : ℕ) : WithBot ℕ∞) → ¬ topologicalKrullDim ↥(⇑g ⁻¹' {η}) ≤ ((0 : ℕ) : WithBot ℕ∞) → ∀ (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))), ∃ (V : B.Etale) (OY : B.Opens) (εO : V.left ⟶ (OY : Scheme.{u})) (s : ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 2).obj.obj (Opposite.op V)), IsAffineOpen OY ∧ IrreducibleSpace V.left ∧ IsFinite εO ∧ εO ≫ OY.ι = V.hom ∧ AddSubgroup.closure {x : ↑((wcEtStalk B η).obj ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 2)) | ∃ (A : StructuredArrow (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B)) (c : A.right ⟶ V), x = (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B)).op ⋙ ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 2).obj) (Opposite.op A)).hom ((((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 2).obj.map c.op).hom s)} = ⊤ :=
