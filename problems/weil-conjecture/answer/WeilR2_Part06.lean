      (θ₀ x) = 0 → x = 0 := by
    intro a x hx
    obtain ⟨W, t, ι, ht, hι, hz⟩ := hΘ a (P x) hx
    let sa : Y ⟶ Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K)))) :=
      Limits.pullback.lift (𝟙 Y) (f ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.aeval a).toRingHom))
        (by rw [Category.assoc, hσπ, Category.comp_id, Category.id_comp])
    let s : Y ⟶ Limits.pullback W.hom
        (Limits.pullback.snd f (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K))))) :=
      Limits.pullback.lift (f ≫ t) sa (by rw [Category.assoc, ht, Limits.pullback.lift_snd])
    refine hP _ ι hι s ?_ x hz
    change s ≫ Limits.pullback.snd W.hom
        (Limits.pullback.snd f (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K))))) ≫
      Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K)))) = 𝟙 Y
    rw [← Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_fst]
  have hinj : Function.Injective θ₀ := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    refine key (fun _ => 0) x ?_
    rw [hx]
    simp only [wcEtGlobalGerm, map_zero]
  refine ⟨θ₀.range, inferInstance, θ₀.range.subtype, ?_, ?_⟩
  · exact (Nat.card_congr (AddMonoidHom.ofInjective hinj).toEquiv).symm
  · intro a u v huv
    obtain ⟨x1, hx1⟩ := AddMonoidHom.mem_range.mp u.2
    obtain ⟨x2, hx2⟩ := AddMonoidHom.mem_range.mp v.2
    have e1 : θ₀.range.subtype u = θ₀ x1 := hx1.symm
    have e2 : θ₀.range.subtype v = θ₀ x2 := hx2.symm
    simp only [e1, e2] at huv
    have h0 := key a (x1 - x2) (by
      rw [map_sub]
      simp only [wcEtGlobalGerm, map_sub] at huv ⊢
      rw [huv, sub_self])
    apply Subtype.ext
    rw [← hx1, ← hx2, sub_eq_zero.mp h0]

theorem wc_et_germ_injective_of_specializing_points : ∀ (B : Scheme.{u}) (η : B) (P : Set B) (G : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (A : Type (u+1)) [AddCommGroup A] (θ : A →+ G.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 B)))), IsCofiltered (StructuredArrow (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B)) → (∀ (b : B), ∀ (N : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) (g : N.right ⟶ Scheme.Etale.mk (𝟙 B)) (x : G.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 B)))), (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙ G.obj) (Opposite.op N)).hom ((G.obj.map g.op).hom x) = wcEtGlobalGerm G b x) → (∀ (V : B.Etale) (v : V.left), V.hom v = η → ∃ w : V.left, v ⤳ w ∧ V.hom w ∈ P) → (∀ p ∈ P, Function.Injective (fun x : A => wcEtGlobalGerm G p (θ x))) → Function.Injective (fun x : A => wcEtGlobalGerm G η (θ x)) :=
by
  intro B η P G A _ θ hcof hR hSP hinj
  classical

  have hlift : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] {V U : Scheme.{u}} (g : V ⟶ U) [Etale g]
      (s : Spec (.of Ω) ⟶ U) (v : V), g v = s (IsLocalRing.closedPoint Ω) →
      ∃ t : Spec (.of Ω) ⟶ V, t ≫ g = s := by
    intro Ω _ _ V U g _ s v hv
    have hs : s = Spec.map (Scheme.SpecToEquivOfField Ω U s).2 ≫
        U.fromSpecResidueField (Scheme.SpecToEquivOfField Ω U s).1 := by
      rw [← Scheme.SpecToEquivOfField_symm_apply, Equiv.symm_apply_apply]
    have h1 : (Scheme.SpecToEquivOfField Ω U s).1 = s (IsLocalRing.closedPoint Ω) := rfl
    generalize Scheme.SpecToEquivOfField Ω U s = p at hs h1
    obtain ⟨u, φ⟩ := p
    simp only at hs h1
    rw [← h1] at hv
    subst hv
    letI : Algebra (U.residueField (g v)) (V.residueField v) := (g.residueFieldMap v).hom.toAlgebra
    haveI : Algebra.IsSeparable (U.residueField (g v)) (V.residueField v) := inferInstance
    haveI : Algebra.IsAlgebraic (U.residueField (g v)) (V.residueField v) :=
      Algebra.IsSeparable.isAlgebraic _ _
    letI : Algebra (U.residueField (g v)) Ω := φ.hom.toAlgebra
    let χ₀ : V.residueField v →ₐ[U.residueField (g v)] Ω :=
      IsAlgClosed.lift (R := U.residueField (g v)) (S := V.residueField v) (M := Ω)
    let χ : V.residueField v ⟶ CommRingCat.of Ω := CommRingCat.ofHom χ₀.toRingHom
    have hχ : g.residueFieldMap v ≫ χ = φ := by
      ext r
      exact χ₀.commutes r
    refine ⟨Spec.map χ ≫ V.fromSpecResidueField v, ?_⟩
    rw [Category.assoc, ← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField,
      ← Category.assoc, ← Spec.map_comp, hχ, hs]

  have factP : ∀ (b : B) (s : Spec (.of (AlgebraicClosure (B.residueField b)))),
      (wcEtGeomPt B b) s = b := by
    intro b s
    rw [Scheme.Hom.comp_apply]
    exact Scheme.fromSpecResidueField_apply _ _
  intro x y hxy
  haveI := hcof
  haveI : IsFiltered (StructuredArrow (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B))ᵒᵖ :=
    isFiltered_op_of_isCofiltered _
  haveI := Limits.preservesFilteredColimitsOfSize_shrink.{u+1, u+1, u, u+1}
    (forget AddCommGrpCat.{u+1})
  let N0 : StructuredArrow (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B) :=
    StructuredArrow.mk (Y := Scheme.Etale.mk (𝟙 B))
      (Over.homMk (wcEtGeomPt B η) (by simp) :
        Over.mk (wcEtGeomPt B η) ⟶ (Scheme.Etale.forget B).obj (Scheme.Etale.mk (𝟙 B)))
  obtain ⟨k, f, f', hk⟩ := (Limits.Concrete.colimit_rep_eq_iff_exists
      ((StructuredArrow.proj (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B)).op ⋙ G.obj)
      (i := Opposite.op N0) (j := Opposite.op N0) (θ x) (θ y)).mp hxy
  let W : B.Etale := k.unop.right
  have e : k.unop.hom.left ≫ W.hom = wcEtGeomPt B η := Over.w k.unop.hom
  have hw : W.hom (k.unop.hom.left
      (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField η)))) = η := by
    have h2 : (k.unop.hom.left ≫ W.hom)
        (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField η))) = η := by
      rw [e]
      exact factP η _
    exact (Scheme.Hom.comp_apply k.unop.hom.left W.hom
      (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField η)))).symm.trans h2
  obtain ⟨w', -, hp⟩ := hSP W _ hw
  obtain ⟨t, ht⟩ := hlift (AlgebraicClosure (B.residueField (W.hom w'))) W.hom
    (wcEtGeomPt B (W.hom w')) w' (factP _ _).symm
  let Np : StructuredArrow (Over.mk (wcEtGeomPt B (W.hom w'))) (Scheme.Etale.forget B) :=
    StructuredArrow.mk (Over.homMk t ht :
      Over.mk (wcEtGeomPt B (W.hom w')) ⟶ (Scheme.Etale.forget B).obj W)
  apply hinj _ hp
  show wcEtGlobalGerm G (W.hom w') (θ x) = wcEtGlobalGerm G (W.hom w') (θ y)
  rw [← hR _ Np (f.unop.right : Np.right ⟶ Scheme.Etale.mk (𝟙 B)) (θ x),
    ← hR _ Np (f'.unop.right : Np.right ⟶ Scheme.Etale.mk (𝟙 B)) (θ y)]
  exact congrArg (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B (W.hom w')))
    (Scheme.Etale.forget B)).op ⋙ G.obj) (Opposite.op Np)).hom hk

theorem wc_et_germ_surjective_of_specializing_points : ∀ (B : Scheme.{u}) (η : B) (P : Set B) (G : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (A : Type (u+1)) [AddCommGroup A] (θ : A →+ G.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 B)))), (∀ b : B, IsCofiltered (StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B))) → (∀ (b : B), ∀ (N : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) (g : N.right ⟶ Scheme.Etale.mk (𝟙 B)) (x : G.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 B)))), (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙ G.obj) (Opposite.op N)).hom ((G.obj.map g.op).hom x) = wcEtGlobalGerm G b x) → (∀ (V : B.Etale) (v : V.left), V.hom v = η → ∃ w : V.left, v ⤳ w ∧ V.hom w ∈ P) → (∀ p ∈ P, Function.Surjective (fun x : A => wcEtGlobalGerm G p (θ x))) → Function.Surjective (fun x : A => wcEtGlobalGerm G η (θ x)) :=
by
  intro B η P G A _ θ hcof hR hSP hsurj z

  have hP : ∀ b : B, (wcEtGeomPt B b) (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b))) = b := by
    intro b
    have e := Scheme.Hom.comp_apply (Spec.map (CommRingCat.ofHom (algebraMap (B.residueField b)
      (AlgebraicClosure (B.residueField b))))) (B.fromSpecResidueField b)
      (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b)))
    rw [Scheme.fromSpecResidueField_apply] at e
    exact e

  have hU : ∀ (V : B.Etale) (c c' : V ⟶ Scheme.Etale.mk (𝟙 B)), c = c' := by
    intro V c c'
    have h1 : c.left = V.hom := (Category.comp_id c.left).symm.trans (MorphismProperty.Over.w c)
    have h2 : c'.left = V.hom := (Category.comp_id c'.left).symm.trans (MorphismProperty.Over.w c')
    exact MorphismProperty.Over.Hom.ext (h1.trans h2.symm)

  obtain ⟨hgf1, -, -⟩ := wc_et_stalk_germ_facts B η (hcof η) G
  obtain ⟨N, h, rfl⟩ := hgf1 z
  obtain ⟨cW⟩ : Nonempty (N.right ⟶ Scheme.Etale.mk (𝟙 B)) :=
    ⟨MorphismProperty.Over.homMk N.right.hom (Category.comp_id _) trivial⟩
  have hcomp : ∀ {V : B.Etale} (g : V ⟶ N.right)
      (x : G.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 B)))),
      G.obj.map g.op (G.obj.map cW.op x) = G.obj.map (g ≫ cW).op x := by
    intro V g x
    rw [op_comp, Functor.map_comp]
    rfl

  have hZ : ∀ a : A, IsOpen {x : N.right.left | ∃ (V₁ : B.Etale) (c : V₁ ⟶ N.right),
      x ∈ Set.range c.left ∧ G.obj.map c.op (h - G.obj.map cW.op (θ a)) = 0} :=
    fun a => (wc_etale_section_vanishing_open B G N.right (h - G.obj.map cW.op (θ a))).1

  have hv : N.right.hom (N.hom.left (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField η))))
      = η := by
    have h2 : N.hom.left ≫ N.right.hom = wcEtGeomPt B η := Over.w N.hom
    have := Scheme.Hom.comp_apply N.hom.left N.right.hom
      (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField η)))
    rw [h2, hP] at this
    exact this.symm

  have hvU : N.hom.left (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField η))) ∈
      ⋃ a : A, {x : N.right.left | ∃ (V₁ : B.Etale) (c : V₁ ⟶ N.right),
        x ∈ Set.range c.left ∧ G.obj.map c.op (h - G.obj.map cW.op (θ a)) = 0} := by
    by_contra hvU
    obtain ⟨w, hvw, hwP⟩ := hSP N.right _ hv
    have hwU := hvw.mem_closed (isOpen_iUnion hZ).isClosed_compl hvU
    apply hwU
    obtain ⟨p, hp⟩ : ∃ p, N.right.hom w = p := ⟨_, rfl⟩
    rw [hp] at hwP
    obtain ⟨t, ht, htw⟩ := wc_etale_lift_alg_closed_point (AlgebraicClosure (B.residueField p))
      N.right.hom (wcEtGeomPt B p) w (by rw [hP p]; exact hp)
    let Nw : StructuredArrow (Over.mk (wcEtGeomPt B p)) (Scheme.Etale.forget B) :=
      StructuredArrow.mk (Y := N.right)
        (Over.homMk t ht : Over.mk (wcEtGeomPt B p) ⟶ (Scheme.Etale.forget B).obj N.right)
    obtain ⟨a, ha⟩ := hsurj p hwP ((Limits.colimit.ι ((StructuredArrow.proj
      (Over.mk (wcEtGeomPt B p)) (Scheme.Etale.forget B)).op ⋙ G.obj) (Opposite.op Nw)).hom h)
    have hRp := hR p Nw cW (θ a)
    obtain ⟨-, hgf2, -⟩ := wc_et_stalk_germ_facts B p (hcof p) G
    obtain ⟨N3, f, f', hff⟩ := hgf2 Nw Nw h ((G.obj.map cW.op).hom (θ a)) (hRp.trans ha).symm
    have hzero : G.obj.map f.right.op (h - G.obj.map cW.op (θ a)) = 0 := by
      rw [map_sub]
      have e : G.obj.map f.right.op h = G.obj.map f'.right.op (G.obj.map cW.op (θ a)) := hff
      rw [e, sub_eq_zero, hcomp, hcomp]
      exact congrArg (fun g => G.obj.map g.op (θ a)) (hU _ _ _)
    have h3 : N3.hom.left ≫ f.right.left = t := congrArg CommaMorphism.left (StructuredArrow.w f)
    refine Set.mem_iUnion.mpr ⟨a, N3.right, f.right,
      ⟨N3.hom.left (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField p))), ?_⟩, hzero⟩
    have := Scheme.Hom.comp_apply N3.hom.left f.right.left
      (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField p)))
    rw [h3, htw] at this
    exact this.symm

  obtain ⟨a, V₁, c, ⟨v₁, hv₁⟩, hca⟩ := Set.mem_iUnion.mp hvU
  obtain ⟨t₁, ht₁, -⟩ := wc_etale_lift_alg_closed_point (AlgebraicClosure (B.residueField η))
    c.left N.hom.left v₁ hv₁
  have ht₁' : t₁ ≫ V₁.hom = wcEtGeomPt B η := by
    have hc : c.left ≫ N.right.hom = V₁.hom := MorphismProperty.Over.w c
    have h2 : N.hom.left ≫ N.right.hom = wcEtGeomPt B η := Over.w N.hom
    rw [← hc, ← Category.assoc, ht₁]
    exact h2
  let N₁ : StructuredArrow (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B) :=
    StructuredArrow.mk (Y := V₁)
      (Over.homMk t₁ ht₁' : Over.mk (wcEtGeomPt B η) ⟶ (Scheme.Etale.forget B).obj V₁)
  let e : N₁ ⟶ N := StructuredArrow.homMk c (by
    apply Over.OverMorphism.ext
    exact ht₁)
  have hw := congrArg (fun φ => φ.hom (h - G.obj.map cW.op (θ a)))
    (Limits.colimit.w ((StructuredArrow.proj (Over.mk (wcEtGeomPt B η))
      (Scheme.Etale.forget B)).op ⋙ G.obj) e.op)
  have hsa0 : (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B η))
      (Scheme.Etale.forget B)).op ⋙ G.obj) (Opposite.op N)).hom
        (h - G.obj.map cW.op (θ a)) = 0 := by
    refine hw.symm.trans ?_
    show (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B η))
      (Scheme.Etale.forget B)).op ⋙ G.obj) (Opposite.op N₁)).hom
        (G.obj.map c.op (h - G.obj.map cW.op (θ a))) = 0
    rw [hca, map_zero]
  rw [map_sub, sub_eq_zero] at hsa0
  refine ⟨a, ?_⟩
  show wcEtGlobalGerm G η (θ a) = _
  rw [← hR η N cW (θ a)]
  exact hsa0.symm

theorem wc_etale_generic_fibre_quotient_algebraic : ∀ (R : Type u) [CommRing R] [IsDomain R] (B : Type u) [CommRing B] (φ : R →+* B), φ.Etale → ∀ (𝔭 : Ideal B), 𝔭.IsPrime → Ideal.comap φ 𝔭 = ⊥ → ((Ideal.Quotient.mk 𝔭).comp φ).FiniteType ∧ ∀ b : B, ∃ p : Polynomial R, p ≠ 0 ∧ Polynomial.eval₂ ((Ideal.Quotient.mk 𝔭).comp φ) (Ideal.Quotient.mk 𝔭 b) p = 0 :=
by
  intro R _ _ B _ φ hφ 𝔭 h𝔭 h0
  letI : Algebra R B := φ.toAlgebra
  haveI : Algebra.Etale R B := hφ
  haveI : 𝔭.IsPrime := h𝔭
  have hφft : φ.FiniteType := RingHom.finiteType_algebraMap.mpr inferInstance
  refine ⟨RingHom.FiniteType.comp
    (RingHom.FiniteType.of_surjective (Ideal.Quotient.mk 𝔭) Ideal.Quotient.mk_surjective) hφft, ?_⟩
  intro b
  haveI hfin : Module.Finite (⊥ : Ideal R).ResidueField ((⊥ : Ideal R).Fiber B) :=
    Algebra.QuasiFinite.finite_fiber ⊥
  let x : (⊥ : Ideal R).Fiber B := TensorProduct.tmul R (1 : (⊥ : Ideal R).ResidueField) b
  have hx0 : IsAlgebraic (⊥ : Ideal R).ResidueField x := IsAlgebraic.of_finite _ x
  haveI : Algebra.IsAlgebraic R (⊥ : Ideal R).ResidueField :=
    IsLocalization.isAlgebraic _ (nonZeroDivisors R)
  have hx : IsAlgebraic R x := IsAlgebraic.restrictScalars R hx0
  have hinj : Function.Injective (Algebra.ofId R 𝔭.ResidueField) := by
    rw [injective_iff_map_eq_zero]
    intro r hr
    have h1 : algebraMap B 𝔭.ResidueField (φ r) = 0 := by
      rw [← hr, Algebra.ofId_apply, IsScalarTower.algebraMap_apply R B 𝔭.ResidueField]
      rfl
    have h2 : φ r ∈ 𝔭 := by
      rw [← Ideal.ker_algebraMap_residueField 𝔭, RingHom.mem_ker]
      exact h1
    have h3 : r ∈ Ideal.comap φ 𝔭 := Ideal.mem_comap.mpr h2
    rw [h0] at h3
    exact (Submodule.mem_bot R).mp h3
  let Φ : (⊥ : Ideal R).Fiber B →ₐ[R] 𝔭.ResidueField :=
    Algebra.TensorProduct.productMap (IsFractionRing.liftAlgHom (K := (⊥ : Ideal R).ResidueField) hinj)
      (IsScalarTower.toAlgHom R B 𝔭.ResidueField)
  have hΦ : Φ x = algebraMap B 𝔭.ResidueField b := by
    simp [Φ, x, Algebra.TensorProduct.productMap_apply_tmul]
  have hy : IsAlgebraic R (algebraMap B 𝔭.ResidueField b) := hΦ ▸ hx.algHom Φ
  let ι : (B ⧸ 𝔭) →ₐ[R] 𝔭.ResidueField := IsScalarTower.toAlgHom R (B ⧸ 𝔭) 𝔭.ResidueField
  have hι : Function.Injective ι := Ideal.injective_algebraMap_quotient_residueField 𝔭
  have hιb : ι (Ideal.Quotient.mk 𝔭 b) = algebraMap B 𝔭.ResidueField b := by
    simp [ι, IsScalarTower.toAlgHom_apply]
  rw [← hιb] at hy
  obtain ⟨p, hp0, hp⟩ := (isAlgebraic_algHom_iff ι hι).mp hy
  refine ⟨p, hp0, ?_⟩
  rw [Polynomial.aeval_def] at hp
  exact hp

theorem wc_poly_domain_algebraic_prime_over_rational : ∀ (K : Type u) [Field K] [Infinite K] (T : Type u) (B : Type u) [CommRing B] (φ : MvPolynomial T K →+* B) (𝔭 : Ideal B), 𝔭.IsPrime → Ideal.comap φ 𝔭 = ⊥ → ((Ideal.Quotient.mk 𝔭).comp φ).FiniteType → (∀ b : B, ∃ p : Polynomial (MvPolynomial T K), p ≠ 0 ∧ Polynomial.eval₂ ((Ideal.Quotient.mk 𝔭).comp φ) (Ideal.Quotient.mk 𝔭 b) p = 0) → ∃ (𝔮 : Ideal B) (a : T → K), 𝔮.IsPrime ∧ 𝔭 ≤ 𝔮 ∧ Ideal.comap φ 𝔮 = RingHom.ker (MvPolynomial.aeval a).toRingHom :=
by
  intro K _ _ T B _ φ 𝔭 h𝔭 h0 hft halg
  classical

  have s2 : ∀ (R : Type u) [CommRing R] [IsDomain R] (D : Type u) [CommRing D] (ψ : R →+* D),
      ψ.FiniteType → (∀ d : D, ∃ p : Polynomial R, p ≠ 0 ∧ Polynomial.eval₂ ψ d p = 0) →
      ∃ c : R, c ≠ 0 ∧ ∀ d : D, ∃ N : ℕ, ψ.IsIntegralElem (ψ c ^ N * d) := by
    intro R _ _ D _ ψ hft halg
    letI := ψ.toAlgebra
    have hft' : Algebra.FiniteType R D := hft
    obtain ⟨s, hs⟩ := hft'.out
    choose p hp0 hp using halg
    set c : R := ∏ x ∈ s, (p x).leadingCoeff with hc
    refine ⟨c, ?_, ?_⟩
    · rw [hc, Finset.prod_ne_zero_iff]
      intro x _
      exact Polynomial.leadingCoeff_ne_zero.mpr (hp0 x)
    · intro d
      have hd : d ∈ Algebra.adjoin R (s : Set D) := by rw [hs]; trivial
      induction hd using Algebra.adjoin_induction with
      | mem x hx =>
        refine ⟨1, ?_⟩
        rw [pow_one, hc, ← Finset.mul_prod_erase s _ hx, map_mul, mul_comm (ψ _), mul_assoc]
        exact RingHom.IsIntegralElem.mul ψ (RingHom.isIntegralElem_map ψ)
          (RingHom.isIntegralElem_leadingCoeff_mul ψ (p x) x (hp x))
      | algebraMap r =>
        refine ⟨0, ?_⟩
        rw [pow_zero, one_mul]
        exact RingHom.isIntegralElem_map ψ
      | add x y _ _ hx hy =>
        obtain ⟨N₁, h₁⟩ := hx
        obtain ⟨N₂, h₂⟩ := hy
        refine ⟨N₁ + N₂, ?_⟩
        have e : ψ c ^ (N₁ + N₂) * (x + y) =
            ψ (c ^ N₂) * (ψ c ^ N₁ * x) + ψ (c ^ N₁) * (ψ c ^ N₂ * y) := by
          rw [map_pow, map_pow]; ring
        rw [e]
        exact RingHom.IsIntegralElem.add ψ
          (RingHom.IsIntegralElem.mul ψ (RingHom.isIntegralElem_map ψ) h₁)
          (RingHom.IsIntegralElem.mul ψ (RingHom.isIntegralElem_map ψ) h₂)
      | mul x y _ _ hx hy =>
        obtain ⟨N₁, h₁⟩ := hx
        obtain ⟨N₂, h₂⟩ := hy
        refine ⟨N₁ + N₂, ?_⟩
        have e : ψ c ^ (N₁ + N₂) * (x * y) = (ψ c ^ N₁ * x) * (ψ c ^ N₂ * y) := by ring
        rw [e]
        exact RingHom.IsIntegralElem.mul ψ h₁ h₂

  have s3 : ∀ (R : Type u) [CommRing R] (D : Type u) [CommRing D] (ψ : R →+* D) (c : R)
      (𝔪 : Ideal R), 𝔪.IsPrime → c ∉ 𝔪 → RingHom.ker ψ ≤ 𝔪 →
      (∀ d : D, ∃ N : ℕ, ψ.IsIntegralElem (ψ c ^ N * d)) →
      ∃ 𝔫 : Ideal D, 𝔫.IsPrime ∧ Ideal.comap ψ 𝔫 = 𝔪 := by
    intro R _ D _ ψ c 𝔪 h𝔪 hc hker hint
    let Rc := Localization.Away c
    let Dc := Localization.Away (ψ c)
    let ιR := algebraMap R Rc
    let ιD := algebraMap D Dc
    have hy : Submonoid.powers c ≤ Submonoid.comap ψ (Submonoid.powers (ψ c)) := by
      rintro _ ⟨n, rfl⟩
      exact ⟨n, by simp⟩
    let g : Rc →+* Dc := IsLocalization.map Dc ψ hy
    have hg : ∀ r, g (ιR r) = ιD (ψ r) := fun r => IsLocalization.map_eq hy r
    have hgc : g.comp ιR = ιD.comp ψ := RingHom.ext hg
    let u : Rc := IsLocalization.Away.invSelf c
    have hu : ιR c * u = 1 := IsLocalization.Away.mul_invSelf c
    have hv : ιD (ψ c) * g u = 1 := by rw [← hg, ← map_mul, hu, map_one]
    have hdisj : Disjoint (Submonoid.powers c : Set R) (𝔪 : Set R) := by
      rw [Set.disjoint_left]
      rintro _ ⟨n, rfl⟩ hn
      exact hc (h𝔪.mem_of_pow_mem n hn)
    set P := Ideal.map ιR 𝔪 with hP
    haveI hPprime : P.IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers c) Rc 𝔪 h𝔪 hdisj
    have hPc : Ideal.comap ιR P = 𝔪 :=
      IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers c) Rc h𝔪 hdisj
    have hgint : g.IsIntegral := by
      intro z
      obtain ⟨n, d, hz⟩ := IsLocalization.Away.surj (ψ c) z
      obtain ⟨N, hN⟩ := hint d
      have h1 : g.IsIntegralElem (ιD (ψ c ^ N * d)) := by
        have := hN.map ιD
        rw [← hgc] at this
        exact this.of_comp
      have h2 : g.IsIntegralElem (g (u ^ (N + n))) := RingHom.isIntegralElem_map g
      have hv' : ∀ k : ℕ, ιD (ψ c) ^ k * g u ^ k = 1 := fun k => by rw [← mul_pow, hv, one_pow]
      have e : z = ιD (ψ c ^ N * d) * g (u ^ (N + n)) := by
        calc z = z * (ιD (ψ c) ^ n * g u ^ n) := by rw [hv', mul_one]
          _ = ιD d * g u ^ n := by rw [← mul_assoc, hz]
          _ = ιD d * g u ^ n * (ιD (ψ c) ^ N * g u ^ N) := by rw [hv', mul_one]
          _ = _ := by rw [map_pow, map_mul, map_pow, pow_add]; ring
      rw [e]
      exact RingHom.IsIntegralElem.mul g h1 h2
    have hkerg : RingHom.ker g ≤ P := by
      intro z hz
      rw [RingHom.mem_ker] at hz
      obtain ⟨k, r, hzr⟩ := IsLocalization.Away.surj c z
      have h0 : ιD (ψ r) = 0 := by
        rw [← hg, ← hzr, map_mul, hz, zero_mul]
      obtain ⟨⟨_, j, rfl⟩, hm⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers (ψ c)) Dc (ψ r)).mp h0
      have hmem : c ^ j * r ∈ 𝔪 := hker (by rw [RingHom.mem_ker, map_mul, map_pow]; exact hm)
      have hr : r ∈ 𝔪 :=
        (h𝔪.mem_or_mem hmem).resolve_left (fun h => hc (h𝔪.mem_of_pow_mem j h))
      have e : z = ιR r * u ^ k := by
        calc z = z * (ιR c ^ k * u ^ k) := by rw [← mul_pow, hu, one_pow, mul_one]
          _ = ιR r * u ^ k := by rw [← mul_assoc, hzr]
      rw [e]
      exact P.mul_mem_right _ (Ideal.mem_map_of_mem _ hr)
    letI : Algebra Rc Dc := g.toAlgebra
    haveI : Algebra.IsIntegral Rc Dc := ⟨hgint⟩
    obtain ⟨Q, -, hQ, hQP⟩ := Ideal.exists_ideal_over_prime_of_isIntegral P (⊥ : Ideal Dc) (by
      intro z hz
      apply hkerg
      exact RingHom.mem_ker.mpr (Ideal.mem_bot.mp (Ideal.mem_comap.mp hz)))
    have hQP' : Ideal.comap g Q = P := hQP
    haveI := hQ
    refine ⟨Ideal.comap ιD Q, Ideal.comap_isPrime ιD Q, ?_⟩
    rw [Ideal.comap_comap, ← hgc, ← Ideal.comap_comap, hQP', hPc]

  have hker : ∀ I : Ideal (MvPolynomial T K), RingHom.ker ((Ideal.Quotient.mk 𝔭).comp φ) ≤ I := by
    intro I x hx
    have hx' : x ∈ Ideal.comap φ 𝔭 :=
      Ideal.mem_comap.mpr (Ideal.Quotient.eq_zero_iff_mem.mp (RingHom.mem_ker.mp hx))
    rw [h0, Ideal.mem_bot] at hx'
    rw [hx']
    exact I.zero_mem
  have halg' : ∀ d : B ⧸ 𝔭, ∃ p : Polynomial (MvPolynomial T K), p ≠ 0 ∧
      Polynomial.eval₂ ((Ideal.Quotient.mk 𝔭).comp φ) d p = 0 := by
    intro d
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective d
    exact halg b
  obtain ⟨c, hc0, hcint⟩ := s2 _ _ _ hft halg'

  have hex : ∃ a : T → K, MvPolynomial.eval a c ≠ 0 := by
    by_contra hne
    push_neg at hne
    apply hc0
    apply MvPolynomial.funext
    intro x
    rw [hne x, map_zero]
  obtain ⟨a, ha⟩ := hex
  have h𝔪 : (RingHom.ker (MvPolynomial.aeval (R := K) a).toRingHom).IsPrime :=
    RingHom.ker_isPrime _
  have hc𝔪 : c ∉ RingHom.ker (MvPolynomial.aeval (R := K) a).toRingHom := by
    rw [RingHom.mem_ker]
    simpa [MvPolynomial.coe_aeval_eq_eval] using ha

  obtain ⟨𝔫, h𝔫, h𝔫c⟩ := s3 _ _ _ c _ h𝔪 hc𝔪 (hker _) hcint
  refine ⟨Ideal.comap (Ideal.Quotient.mk 𝔭) 𝔫, a, Ideal.comap_isPrime _ _, ?_, ?_⟩
  · intro x hx
    rw [Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr hx]
    exact 𝔫.zero_mem
  · rw [Ideal.comap_comap]
    exact h𝔫c

theorem wc_etale_poly_generic_closure_rational_of_alg : ∀ (K : Type u) [Field K] (T : Type u), (∀ (B : Type u) [CommRing B] (φ : MvPolynomial T K →+* B), φ.Etale → ∀ (𝔭 : Ideal B), 𝔭.IsPrime → Ideal.comap φ 𝔭 = ⊥ → ∃ (𝔮 : Ideal B) (a : T → K), 𝔮.IsPrime ∧ 𝔭 ≤ 𝔮 ∧ Ideal.comap φ 𝔮 = RingHom.ker (MvPolynomial.aeval a).toRingHom) → ∀ (V : (Spec (.of (MvPolynomial T K))).Etale) (v : V.left), V.hom v = genericPoint (Spec (.of (MvPolynomial T K))) → ∃ (w : V.left) (a : T → K), v ⤳ w ∧ V.hom w = (Spec.map (CommRingCat.ofHom (MvPolynomial.aeval a).toRingHom)) (IsLocalRing.closedPoint K) :=
by
  intro K _ T hH V v hv
  obtain ⟨U, hU, hvU, -⟩ := exists_isAffineOpen_mem_and_subset (TopologicalSpace.Opens.mem_top v)
  have hS : IsAffineOpen (⊤ : (Spec (.of (MvPolynomial T K))).Opens) := isAffineOpen_top _
  have e : U ≤ V.hom ⁻¹ᵁ ⊤ := by rw [Scheme.Hom.preimage_top]; exact le_top
  let φ : MvPolynomial T K →+* Γ(V.left, U) :=
    (V.hom.appLE ⊤ U e).hom.comp (Scheme.ΓSpecIso (.of (MvPolynomial T K))).inv.hom
  have hφ : φ.Etale := by
    have h1 : (V.hom.appLE ⊤ U e).hom.Etale :=
      HasRingHomProperty.appLE @Etale V.hom inferInstance ⟨⊤, hS⟩ ⟨U, hU⟩ e
    have h2 : (Scheme.ΓSpecIso (.of (MvPolynomial T K))).inv.hom.Etale :=
      RingHom.Etale.of_bijective (ConcreteCategory.bijective_of_isIso _)
    exact RingHom.Etale.stableUnderComposition _ _ h2 h1
  have hS' : hS.fromSpec = Spec.map (Scheme.ΓSpecIso (.of (MvPolynomial T K))).inv := by
    rw [IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv]
  have hmap : hU.fromSpec ≫ V.hom = Spec.map (CommRingCat.ofHom φ) := by
    rw [← IsAffineOpen.SpecMap_appLE_fromSpec V.hom hS hU e, hS', ← Spec.map_comp]
    rfl
  have hpt : ∀ x : Spec Γ(V.left, U),
      (V.hom (hU.fromSpec x)).asIdeal = Ideal.comap φ x.asIdeal := by
    intro x
    rw [← Scheme.Hom.comp_apply, hmap]
    rfl
  have hx₀ : hU.fromSpec (hU.primeIdealOf ⟨v, hvU⟩) = v :=
    IsAffineOpen.fromSpec_primeIdealOf hU ⟨v, hvU⟩
  have h0 : Ideal.comap φ (hU.primeIdealOf ⟨v, hvU⟩).asIdeal = ⊥ := by
    have h := hpt (hU.primeIdealOf ⟨v, hvU⟩)
    rw [hx₀, hv, genericPoint_eq_bot_of_affine] at h
    exact h.symm
  obtain ⟨𝔮, a, h𝔮, hle, hcomap⟩ :=
    hH (Γ(V.left, U)) φ hφ (hU.primeIdealOf ⟨v, hvU⟩).asIdeal
      (hU.primeIdealOf ⟨v, hvU⟩).isPrime h0
  refine ⟨hU.fromSpec ⟨𝔮, h𝔮⟩, a, ?_, ?_⟩
  · have hsp := Specializes.map
      ((PrimeSpectrum.le_iff_specializes (hU.primeIdealOf ⟨v, hvU⟩) ⟨𝔮, h𝔮⟩).mp hle)
      hU.fromSpec.continuous
    rwa [hx₀] at hsp
  · apply PrimeSpectrum.ext
    refine (hpt ⟨𝔮, h𝔮⟩).trans ?_
    change Ideal.comap φ 𝔮 =
      Ideal.comap (MvPolynomial.aeval a).toRingHom (IsLocalRing.maximalIdeal K)
    rw [hcomap, IsLocalRing.maximalIdeal_eq_bot, RingHom.ker_eq_comap_bot]

theorem wc_et_poly_generic_germ_bijective : ∀ (K : Type u) [Field K] [IsAlgClosed K] (T : Type u) (G : Sheaf (Scheme.smallEtaleTopology (Spec (.of (MvPolynomial T K)))) AddCommGrpCat.{u+1}) (A : Type (u+1)) [AddCommGroup A] (θ : A →+ G.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 (Spec (.of (MvPolynomial T K))))))), (∀ b : Spec (.of (MvPolynomial T K)), IsCofiltered (StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (MvPolynomial T K))) b)) (Scheme.Etale.forget (Spec (.of (MvPolynomial T K)))))) → (∀ a : T → K, Function.Bijective (fun x : A => wcEtGlobalGerm G ((Spec.map (CommRingCat.ofHom (MvPolynomial.aeval a).toRingHom)) (IsLocalRing.closedPoint K)) (θ x))) → Function.Bijective (fun x : A => wcEtGlobalGerm G (genericPoint (Spec (.of (MvPolynomial T K)))) (θ x)) :=
by
  intro K _ _ T G A _ θ hcof hbij

  have hR : ∀ (b : Spec (.of (MvPolynomial T K)))
      (N : StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (MvPolynomial T K))) b))
        (Scheme.Etale.forget (Spec (.of (MvPolynomial T K)))))
      (g : N.right ⟶ Scheme.Etale.mk (𝟙 (Spec (.of (MvPolynomial T K)))))
      (x : G.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 (Spec (.of (MvPolynomial T K))))))),
      (Limits.colimit.ι ((StructuredArrow.proj
          (Over.mk (wcEtGeomPt (Spec (.of (MvPolynomial T K))) b))
          (Scheme.Etale.forget (Spec (.of (MvPolynomial T K))))).op ⋙ G.obj)
        (Opposite.op N)).hom ((G.obj.map g.op).hom x) = wcEtGlobalGerm G b x := by
    intro b N g x
    have h1 : g.left = N.right.hom := by
      have := MorphismProperty.Over.w g
      exact (Category.comp_id g.left).symm.trans this
    have h2 := Over.w N.hom
    have hw : N.hom ≫ (Scheme.Etale.forget (Spec (.of (MvPolynomial T K)))).map g =
        (Over.homMk (wcEtGeomPt (Spec (.of (MvPolynomial T K))) b) (by simp) :
          Over.mk (wcEtGeomPt (Spec (.of (MvPolynomial T K))) b) ⟶
            (Scheme.Etale.forget (Spec (.of (MvPolynomial T K)))).obj
              (Scheme.Etale.mk (𝟙 (Spec (.of (MvPolynomial T K)))))) := by
      apply Over.OverMorphism.ext
      change N.hom.left ≫ g.left = wcEtGeomPt (Spec (.of (MvPolynomial T K))) b
      rw [h1]
      exact h2
    let f : N ⟶ StructuredArrow.mk (Y := Scheme.Etale.mk (𝟙 (Spec (.of (MvPolynomial T K)))))
        (Over.homMk (wcEtGeomPt (Spec (.of (MvPolynomial T K))) b) (by simp) :
          Over.mk (wcEtGeomPt (Spec (.of (MvPolynomial T K))) b) ⟶
            (Scheme.Etale.forget (Spec (.of (MvPolynomial T K)))).obj
              (Scheme.Etale.mk (𝟙 (Spec (.of (MvPolynomial T K)))))) :=
      StructuredArrow.homMk g hw
    have := congrArg (fun φ => φ.hom x) (Limits.colimit.w ((StructuredArrow.proj
          (Over.mk (wcEtGeomPt (Spec (.of (MvPolynomial T K))) b))
          (Scheme.Etale.forget (Spec (.of (MvPolynomial T K))))).op ⋙ G.obj) f.op)
    exact this

  have hSP : ∀ (V : (Spec (.of (MvPolynomial T K))).Etale) (v : V.left),
      V.hom v = genericPoint (Spec (.of (MvPolynomial T K))) →
      ∃ w : V.left, v ⤳ w ∧ V.hom w ∈ Set.range (fun a : T → K =>
        (Spec.map (CommRingCat.ofHom (MvPolynomial.aeval a).toRingHom))
          (IsLocalRing.closedPoint K)) := by
    intro V v hv
    obtain ⟨w, a, hsp, hw⟩ := wc_etale_poly_generic_closure_rational_of_alg K T
      (fun B _ φ hφ 𝔭 h𝔭 h0 => by
        obtain ⟨hft, halg⟩ :=
          wc_etale_generic_fibre_quotient_algebraic (MvPolynomial T K) B φ hφ 𝔭 h𝔭 h0
        exact wc_poly_domain_algebraic_prime_over_rational K T B φ 𝔭 h𝔭 h0 hft halg)
      V v hv
    exact ⟨w, hsp, a, hw.symm⟩
  refine ⟨?_, ?_⟩
  · exact wc_et_germ_injective_of_specializing_points _ _ _ G A θ (hcof _) hR hSP
      (by rintro p ⟨a, rfl⟩; exact (hbij a).1)
  · exact wc_et_germ_surjective_of_specializing_points _ _ _ G A θ hcof hR hSP
      (by rintro p ⟨a, rfl⟩; exact (hbij a).2)

theorem wc_et_alg_closed_field_invariance_card : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsProper f] (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ Spec (.of K)) (m : ℕ), (m : K) ≠ 0 → ∀ q : ℕ, Nat.card (wcEtCoh (Limits.pullback f t) m q) = Nat.card (wcEtCoh Y m q) :=
by
  classical
  intro K _ _ Y f _ Ω _ _ t m hm q
  have hm0 : m ≠ 0 := by
    rintro rfl
    exact hm Nat.cast_zero

  obtain ⟨σ, hσ⟩ : ∃ σ : K →+* Ω, Spec.map (CommRingCat.ofHom σ) = t :=
    ⟨(Spec.preimage t).hom, by rw [CommRingCat.ofHom_hom, Spec.map_preimage]⟩

  obtain ⟨T, ι, hιinj, hιC, hιalg⟩ := wc_alg_closed_poly_transcendence_embedding K Ω σ

  haveI := wc_et_enough_injectives
    (Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K)))))
  obtain ⟨I⟩ : Nonempty (InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology
      (Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K))))))
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) :=
    ⟨InjectiveResolution.of _⟩

  have hst := fun b => wc_et_proper_stalk_coh
    (Limits.pullback.snd f (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K)))))
    m hm0 wc_et_henselian_proper_vanishing I b q

  have hfib : ∀ {Z : Scheme.{u}} (h : Z ⟶ Spec (.of (MvPolynomial T K))),
      Nat.card (wcEtCoh (Limits.pullback
        (Limits.pullback.snd f (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K))))) h)
        m q) =
      Nat.card (wcEtCoh (Limits.pullback f
        (h ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K))))) m q) := by
    intro Z h
    obtain ⟨e⟩ := wc_et_coh_iso_invariance (Limits.pullbackLeftPullbackSndIso f
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K)))) h).hom m q
    exact (Nat.card_congr e).symm

  obtain ⟨A, _, θ, hA, hinj⟩ := wc_et_poly_family_K_point_germ_injective K Y f T m I q

  haveI := wc_etale_proper_finite K Y f m hm q
  obtain ⟨eZ⟩ := wc_et_zmodext_coh_equiv Y m q
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y m)) := HasExt.standard _
  haveI : Nonempty (wcEtCoh Y m q) := ⟨eZ 0⟩
  have hpos : 0 < Nat.card (wcEtCoh Y m q) := Nat.card_pos

  have hbij : ∀ a : T → K, Function.Bijective (fun x : A => wcEtGlobalGerm _
      ((Spec.map (CommRingCat.ofHom (MvPolynomial.aeval a).toRingHom)) (IsLocalRing.closedPoint K))
      (θ x)) := by
    intro a
    obtain ⟨e⟩ := hst ((Spec.map (CommRingCat.ofHom (MvPolynomial.aeval a).toRingHom))
      (IsLocalRing.closedPoint K))
    have hc := (Nat.card_congr e).trans ((hfib _).trans (wc_et_K_point_fibre_card K Y f T a m q))
    haveI := Nat.finite_of_card_ne_zero (hc.trans_ne hpos.ne')
    exact (hinj a).bijective_of_nat_card_le (le_of_eq (hc.trans hA.symm))

  have hcof : ∀ b : Spec (.of (MvPolynomial T K)), IsCofiltered (StructuredArrow
      (Over.mk (wcEtGeomPt (Spec (.of (MvPolynomial T K))) b))
      (Scheme.Etale.forget (Spec (.of (MvPolynomial T K))))) := fun b =>
    wc_et_geomstalk_cofiltered _ b wc_etale_maps_agree_near_geom_point

  have hη := wc_et_poly_generic_germ_bijective K T _ A θ hcof hbij
  have hcη := Nat.card_eq_of_bijective _ hη
  obtain ⟨eη⟩ := hst (genericPoint (Spec (.of (MvPolynomial T K))))

  obtain ⟨e, he, hecomp⟩ := wc_spec_generic_geom_point_iso K Ω T ι hιinj hιalg
  haveI := he
  have ht : e ≫ (wcEtGeomPt (Spec (.of (MvPolynomial T K)))
      (genericPoint (Spec (.of (MvPolynomial T K)))) ≫
      Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K)))) = t := by
    rw [← Category.assoc, hecomp, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
      MvPolynomial.algebraMap_eq, hιC, hσ]
  subst ht
  obtain ⟨E1⟩ := wc_et_coh_iso_invariance (Limits.pullbackLeftPullbackSndIso f
    (wcEtGeomPt (Spec (.of (MvPolynomial T K))) (genericPoint (Spec (.of (MvPolynomial T K)))) ≫
      Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K)))) e).hom m q
  obtain ⟨E2⟩ := wc_et_coh_iso_invariance (Limits.pullback.fst (Limits.pullback.snd f
    (wcEtGeomPt (Spec (.of (MvPolynomial T K))) (genericPoint (Spec (.of (MvPolynomial T K)))) ≫
      Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K))))) e) m q
  rw [Nat.card_congr E1, ← Nat.card_congr E2, ← hfib, ← Nat.card_congr eη, ← hcη, hA]

theorem wc_et_proj_push_stalk_card : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsProper f] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (D1 : wcEtPullData (Limits.pullback.fst f f) ℓ) (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing (Limits.pullback f f) ℓ))) (n : ℕ) (y : Y), letI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst f f)) _ _ D1.cont D1.φ).Additive := @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D1.adj D1.additive; Finite ((wcEtStalk Y y).obj ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj ((((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst f f)) _ _ D1.cont D1.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology n))) ∧ Nat.card ((wcEtStalk Y y).obj ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj ((((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst f f)) _ _ D1.cont D1.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology n))) = Nat.card (wcEtZModExt Y ℓ n) :=
by
  intro K _ _ Y f _ ℓ _ hℓ D1 I n y

  haveI := D1.additive
  letI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst f f)) _ _
      D1.cont D1.φ).Additive :=
    @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D1.adj D1.additive
  have hℓpos : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos
  have hℓ0 : ℓ ≠ 0 := hℓpos.ne'
  haveI : Limits.PreservesFiniteColimits (SheafOfModules.toSheaf (wcEtZModRing Y ℓ)) :=
    sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.smallEtaleTopology Y) (wcEtZModRing Y ℓ)
  haveI := wc_et_enough_injectives (Limits.pullback f f)

  haveI : (SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).PreservesHomology :=
    Functor.preservesHomologyOfExact _
  have e₁ := (((((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst f f))
      _ _ D1.cont D1.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).sc n).mapHomologyIso
      (SheafOfModules.toSheaf (wcEtZModRing Y ℓ))).symm

  obtain ⟨α⟩ := wc_et_toSheaf_pushforward_iso (Limits.pullback.fst f f) ℓ D1
  have e₂ := ((Functor.mapHomologicalComplexCompIso
        (F := @SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst f f)) _ _
          D1.cont D1.φ)
        (G := SheafOfModules.toSheaf (wcEtZModRing Y ℓ))
        (Iso.refl _) (ComplexShape.up ℕ)) ≪≫
      NatIso.mapHomologicalComplex α (ComplexShape.up ℕ) ≪≫
      (Functor.mapHomologicalComplexCompIso
        (F := SheafOfModules.toSheaf (wcEtZModRing (Limits.pullback f f) ℓ))
        (G := wcEtPush (Limits.pullback.fst f f))
        (Iso.refl _) (ComplexShape.up ℕ)).symm).app I.cocomplex
  have eSt := (wcEtStalk Y y).mapIso (e₁ ≪≫ HomologicalComplex.homologyMapIso e₂ n)

  obtain ⟨A, _, _, _, Λ, _, _, W', φ, a, e, hinit, haff, hφ, ha, hlim, -, -⟩ :=
    wc_et_geom_strict_henselization y
  obtain ⟨E1⟩ := wc_et_stalk_push_homology (Limits.pullback.fst f f) y Λ W' hinit
    (((SheafOfModules.toSheaf (wcEtZModRing (Limits.pullback f f) ℓ)).mapHomologicalComplex
      (ComplexShape.up ℕ)).obj I.cocomplex) n
  obtain ⟨E2⟩ := wc_et_limit_push_homology_modres (Limits.pullback.fst f f) A Λ
    (W' ⋙ StructuredArrow.proj (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) φ a haff hφ ha
    hlim ℓ hℓpos I n
  obtain ⟨J⟩ : Nonempty (InjectiveResolution
      ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback f f)) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) := ⟨InjectiveResolution.of _⟩
  obtain ⟨E3⟩ := wc_et_stalk_push_homology (Limits.pullback.fst f f) y Λ W' hinit J.cocomplex n
  obtain ⟨E4⟩ := wc_et_limit_push_homology (Limits.pullback.fst f f) A Λ
    (W' ⋙ StructuredArrow.proj (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) φ a haff hφ ha
    hlim ℓ J n
  obtain ⟨E5⟩ := wc_et_proper_stalk_coh (Limits.pullback.fst f f) ℓ hℓ0
    wc_et_henselian_proper_vanishing J y n

  obtain ⟨E6⟩ := wc_et_coh_iso_invariance
    (Limits.pullbackSymmetry (Limits.pullback.fst f f) (wcEtGeomPt Y y) ≪≫
      Limits.pullbackRightPullbackFstIso f f (wcEtGeomPt Y y) ≪≫
      Limits.pullbackSymmetry (wcEtGeomPt Y y ≫ f) f).inv ℓ n

  have hF := wc_et_alg_closed_field_invariance_card K Y f (AlgebraicClosure (Y.residueField y))
    (wcEtGeomPt Y y ≫ f) ℓ hℓ n

  obtain ⟨eZ⟩ := wc_et_zmodext_coh_equiv Y ℓ n
  haveI := wc_etale_proper_finite K Y f ℓ hℓ n
  have eAll := ((forget AddCommGrpCat).mapIso eSt).toEquiv.trans
    ((E1.trans (E2.trans (E4.symm.trans (E3.symm.trans E5)))).trans E6)
  have hcard := (Nat.card_congr eAll).trans (hF.trans (Nat.card_congr eZ).symm)
  haveI : Finite (wcEtZModExt Y ℓ n) := Finite.of_equiv _ eZ.symm
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _
  haveI : Nonempty (wcEtZModExt Y ℓ n) := ⟨0⟩
  have hpos : Nat.card (wcEtZModExt Y ℓ n) ≠ 0 := Nat.card_pos.ne'
  exact ⟨Nat.finite_of_card_ne_zero (fun h => hpos (hcard.symm.trans h)), hcard⟩

theorem wc_alg_closed_lft_section : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [LocallyOfFiniteType f], Nonempty Y → ∃ y₀ : Spec (.of K) ⟶ Y, y₀ ≫ f = 𝟙 _ :=
by
  intro K _ _ Y f _ hY
  obtain ⟨y⟩ := hY
  obtain ⟨V, hV, hyV, -⟩ := exists_isAffineOpen_mem_and_subset (x := y) (U := ⊤) trivial
  have e : V ≤ f ⁻¹ᵁ ⊤ := by rw [Scheme.Hom.preimage_top]; exact le_top
  have hφ := Scheme.Hom.finiteType_appLE f (isAffineOpen_top _) hV e
  have : Nonempty V := ⟨⟨y, hyV⟩⟩
  have : Nontrivial Γ(Y, V) := Scheme.component_nontrivial Y V
  obtain ⟨m, hm⟩ := Ideal.exists_maximal Γ(Y, V)
  letI : Field (Γ(Y, V) ⧸ m) := Ideal.Quotient.field m
  let π : Γ(Y, V) →+* Γ(Y, V) ⧸ m := Ideal.Quotient.mk m
  let ι : K →+* Γ(Spec (.of K), ⊤) := (Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom
  have hι : Function.Surjective ι := by
    intro x
    refine ⟨(Scheme.ΓSpecIso (CommRingCat.of K)).hom.hom x, ?_⟩
    show ((Scheme.ΓSpecIso (CommRingCat.of K)).hom ≫ (Scheme.ΓSpecIso (CommRingCat.of K)).inv).hom x = x
    rw [Iso.hom_inv_id]; rfl
  let χ : K →+* Γ(Y, V) ⧸ m := π.comp ((f.appLE ⊤ V e).hom.comp ι)
  have hχ : χ.FiniteType :=
    (RingHom.FiniteType.of_surjective π Ideal.Quotient.mk_surjective).comp
      (hφ.comp (RingHom.FiniteType.of_surjective ι hι))
  letI : Algebra K (Γ(Y, V) ⧸ m) := χ.toAlgebra
  have : Algebra.FiniteType K (Γ(Y, V) ⧸ m) := hχ
  have : Module.Finite K (Γ(Y, V) ⧸ m) := finite_of_finite_type_of_isJacobsonRing K _
  have : Algebra.IsIntegral K (Γ(Y, V) ⧸ m) := Algebra.IsIntegral.of_finite K _
  have hbij : Function.Bijective χ := IsAlgClosed.algebraMap_bijective_of_isIntegral
  let ρ : Γ(Y, V) ⟶ CommRingCat.of K :=
    CommRingCat.ofHom ((RingEquiv.ofBijective χ hbij).symm.toRingHom.comp π)
  have key : (Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ f.appLE ⊤ V e ≫ ρ = 𝟙 _ := by
    ext k
    exact (RingEquiv.ofBijective χ hbij).symm_apply_apply k
  refine ⟨Spec.map ρ ≫ hV.fromSpec, ?_⟩
  rw [Category.assoc, ← IsAffineOpen.SpecMap_appLE_fromSpec f (isAffineOpen_top _) hV e,
    IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv, ← Spec.map_comp, ← Spec.map_comp,
    Category.assoc, key, Spec.map_id]

theorem wc_et_stalk_zero_kpoint : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [LocallyOfFiniteType f] (n : ℕ) (N : SheafOfModules.{u+1} (wcEtZModRing Y n)) (t : SheafOfModules.unit (wcEtZModRing Y n) ⟶ N) (y : Y), (wcEtStalk Y y).map ((SheafOfModules.toSheaf (wcEtZModRing Y n)).map t) = 0 → ∃ (V : Y.Etale) (v0 : Spec (.of K) ⟶ V.left), v0 ≫ V.hom ≫ f = 𝟙 _ ∧ (t.val.app (Opposite.op V)).hom (1 : (wcEtZModRing Y n).obj.obj (Opposite.op V)) = 0 :=
by
  intro K _ _ Y f _ n N t y ht
  have hcof : IsCofiltered (StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) :=
    wc_et_geomstalk_cofiltered Y y (fun e _ a₁ a₂ h Ω _ π hπ =>
      wc_etale_maps_agree_near_geom_point e a₁ a₂ h Ω π hπ)
  obtain ⟨-, hF2, hF3⟩ := wc_et_stalk_germ_facts Y y hcof
    ((SheafOfModules.toSheaf (wcEtZModRing Y n)).obj N)
  let A₀ : StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y) :=
    StructuredArrow.mk (Y := wcEtTop Y) (Over.homMk (wcEtGeomPt Y y) (by simp) :
      Over.mk (wcEtGeomPt Y y) ⟶ (Scheme.Etale.forget Y).obj (wcEtTop Y))
  have h3 := hF3 ((SheafOfModules.toSheaf (wcEtZModRing Y n)).obj
      (SheafOfModules.unit (wcEtZModRing Y n)))
    ((SheafOfModules.toSheaf (wcEtZModRing Y n)).map t) A₀
    (1 : (wcEtZModRing Y n).obj.obj (Opposite.op (wcEtTop Y)))
  obtain ⟨A'', f₁, f₂, hf⟩ := hF2 A₀ A₀
    ((t.val.app (Opposite.op (wcEtTop Y))).hom
      (1 : (wcEtZModRing Y n).obj.obj (Opposite.op (wcEtTop Y)))) 0 (by
      rw [map_zero]
      refine Eq.trans ?_ (h3.symm.trans ?_)
      · rfl
      · rw [ht]
        rfl)
  have hnat := PresheafOfModules.naturality_apply t.val f₁.right.op
    (1 : (wcEtZModRing Y n).obj.obj (Opposite.op (wcEtTop Y)))
  have hpt : Nonempty A''.right.left :=
    ⟨A''.hom.left (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))⟩
  haveI : Etale A''.right.hom := A''.right.prop
  obtain ⟨v0, hv0⟩ := wc_alg_closed_lft_section K A''.right.left (A''.right.hom ≫ f) hpt
  refine ⟨A''.right, v0, hv0, ?_⟩
  have h1 : ((SheafOfModules.unit (wcEtZModRing Y n)).val.map f₁.right.op).hom
      (1 : (wcEtZModRing Y n).obj.obj (Opposite.op (wcEtTop Y))) =
      (1 : (wcEtZModRing Y n).obj.obj (Opposite.op A''.right)) :=
    PresheafOfModules.unit_map_one _ _
  have key : (t.val.app (Opposite.op A''.right)).hom
        (1 : (wcEtZModRing Y n).obj.obj (Opposite.op A''.right)) =
      (N.val.map f₁.right.op).hom ((t.val.app (Opposite.op (wcEtTop Y))).hom
            (1 : (wcEtZModRing Y n).obj.obj (Opposite.op (wcEtTop Y)))) := by
    rw [← h1]
    exact hnat
  exact key.trans (hf.trans (map_zero _))

theorem wc_et_mod_homology_local_boundary : ∀ (Y : Scheme.{u}) (R : Sheaf (Scheme.smallEtaleTopology Y) RingCat.{u+1}) (Kc : CochainComplex (SheafOfModules.{u+1} R) ℕ) (n : ℕ) (k : SheafOfModules.unit R ⟶ Kc.X n) (hk : k ≫ Kc.d n (n + 1) = 0) (V : Y.Etale) (v : V.left), ((Kc.liftCycles k (n + 1) (by simp) hk ≫ Kc.homologyπ n).val.app (Opposite.op V)).hom (1 : R.obj.obj (Opposite.op V)) = 0 → ∃ (T : Y.Etale) (h : T ⟶ V) (t : T.left) (e : (Kc.X ((ComplexShape.up ℕ).prev n)).val.obj (Opposite.op T)), h.left t = v ∧ ((Kc.d ((ComplexShape.up ℕ).prev n) n).val.app (Opposite.op T)).hom e = (k.val.app (Opposite.op T)).hom (1 : R.obj.obj (Opposite.op T)) :=
by
  intro Y R Kc n k hk V v hV


  have hgen : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
      [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
      (R : Sheaf J RingCat.{u+1}), Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} R) := by
    intro C _ J _ _ R
    constructor
    intro I _ _
    constructor
    intro K
    let adj := PresheafOfModules.sheafificationAdjunction (J := J) (𝟙 R.obj)
    have : IsIso adj.counit := inferInstance
    have hP : Limits.PreservesColimitsOfShape I
        (PresheafOfModules.sheafification (J := J) (𝟙 R.obj) ⋙ SheafOfModules.toSheaf.{u+1} R) :=
      Limits.preservesColimitsOfShape_of_natIso
        (PresheafOfModules.sheafificationCompToSheaf (J := J) (𝟙 R.obj)).symm
    let K₀ := K ⋙ (SheafOfModules.forget R ⋙ PresheafOfModules.restrictScalars (𝟙 R.obj))
    let c₀ := Limits.colimit.cocone K₀
    let h₀ : Limits.IsColimit c₀ := Limits.colimit.isColimit K₀
    have ht : Limits.IsColimit
        ((PresheafOfModules.sheafification (J := J) (𝟙 R.obj)).mapCocone c₀) :=
      Limits.isColimitOfPreserves _ h₀
    have ht' : Limits.IsColimit ((SheafOfModules.toSheaf.{u+1} R).mapCocone
        ((PresheafOfModules.sheafification (J := J) (𝟙 R.obj)).mapCocone c₀)) :=
      Limits.IsColimit.ofIsoColimit
        (Limits.isColimitOfPreserves
          (PresheafOfModules.sheafification (J := J) (𝟙 R.obj) ⋙ SheafOfModules.toSheaf.{u+1} R) h₀)
        (Functor.mapCoconeMapCocone c₀).symm
    have : Limits.PreservesColimit (K₀ ⋙ PresheafOfModules.sheafification (J := J) (𝟙 R.obj))
        (SheafOfModules.toSheaf.{u+1} R) :=
      Limits.preservesColimit_of_preserves_colimit_cocone ht ht'
    let e : K₀ ⋙ PresheafOfModules.sheafification (J := J) (𝟙 R.obj) ≅ K :=
      Functor.associator _ _ _ ≪≫ Functor.isoWhiskerLeft K (asIso adj.counit) ≪≫ Functor.rightUnitor K
    exact Limits.preservesColimit_of_iso_diagram _ e
  have hfc : Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} R) :=
    hgen (Scheme.smallEtaleTopology Y) R
  have : Limits.PreservesColimitsOfShape Limits.WalkingSpan
      (SheafOfModules.toSheaf.{u+1} R) :=
    Limits.PreservesFiniteColimits.preservesFiniteColimits _
  have : (SheafOfModules.toSheaf.{u+1} R).PreservesEpimorphisms :=
    preservesEpimorphisms_of_preservesColimitsOfShape _

  let S := ShortComplex.mk (Kc.toCycles ((ComplexShape.up ℕ).prev n) n) (Kc.homologyπ n)
    (Kc.toCycles_comp_homologyπ _ n)
  have hS : S.Exact := S.exact_of_g_is_cokernel (Kc.homologyIsCokernel _ n rfl)
  obtain ⟨κ, hκι, hκ⟩ : ∃ κ : Kc.X ((ComplexShape.up ℕ).prev n) ⟶ Limits.kernel (Kc.homologyπ n),
      κ ≫ Limits.kernel.ι (Kc.homologyπ n) = Kc.toCycles ((ComplexShape.up ℕ).prev n) n ∧
        Epi κ :=
    ⟨_, Limits.kernel.lift_ι _ _ _, S.exact_iff_epi_kernel_lift.mp hS⟩
  have hEκ : Epi ((SheafOfModules.toSheaf.{u+1} R).map κ) := Functor.map_epi _ _
  have hloc : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y)
      ((SheafOfModules.toSheaf.{u+1} R).map κ).hom :=
    (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} _).mpr hEκ

  set c := ((Kc.liftCycles k (n + 1) (by simp) hk).val.app (Opposite.op V)).hom
    (1 : R.obj.obj (Opposite.op V)) with hc_def
  have hc : ((Kc.homologyπ n).val.app (Opposite.op V)).hom c = 0 := hV

  have hadd : (SheafOfModules.evaluation R (Opposite.op V)).Additive := by
    show (SheafOfModules.forget R ⋙ PresheafOfModules.evaluation R.obj (Opposite.op V)).Additive
    infer_instance
  let y := (ModuleCat.kernelIsoKer
      ((SheafOfModules.evaluation R (Opposite.op V)).map (Kc.homologyπ n))).inv.hom
    (⟨c, hc⟩ : LinearMap.ker
      ((SheafOfModules.evaluation R (Opposite.op V)).map (Kc.homologyπ n)).hom)
  let s : (Limits.kernel (Kc.homologyπ n)).val.obj (Opposite.op V) :=
    (Limits.PreservesKernel.iso (SheafOfModules.evaluation R (Opposite.op V))
      (Kc.homologyπ n)).inv.hom y
  have hs : ((Limits.kernel.ι (Kc.homologyπ n)).val.app (Opposite.op V)).hom s = c := by
    have e1 := ConcreteCategory.congr_hom
      (Limits.PreservesKernel.iso_inv_ι (SheafOfModules.evaluation R (Opposite.op V))
        (Kc.homologyπ n)) y
    have e2 := ConcreteCategory.congr_hom
      (ModuleCat.kernelIsoKer_inv_kernel_ι
        ((SheafOfModules.evaluation R (Opposite.op V)).map (Kc.homologyπ n)))
      (⟨c, hc⟩ : LinearMap.ker
        ((SheafOfModules.evaluation R (Opposite.op V)).map (Kc.homologyπ n)).hom)
    rw [ConcreteCategory.comp_apply] at e1 e2
    exact e1.trans e2

  have hR : Presheaf.imageSieve ((SheafOfModules.toSheaf.{u+1} R).map κ).hom s ∈
      Scheme.smallGrothendieckTopology @Etale Y V :=
    hloc.imageSieve_mem s
  have hpt := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V _).mp
    ((@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl) ▸ hR)
  obtain ⟨T, h, t, e, he', ht⟩ : ∃ (T : Y.Etale) (h : T ⟶ V) (t : T.left)
      (e : (Kc.X ((ComplexShape.up ℕ).prev n)).val.obj (Opposite.op T)),
      (κ.val.app (Opposite.op T)).hom e =
        ((Limits.kernel (Kc.homologyπ n)).val.map h.op).hom s ∧ h.left t = v := by
    obtain ⟨T, h, t, hmem, -, ht⟩ := hpt v
    obtain ⟨e, he⟩ := hmem
    exact ⟨T, h, t, e, he, ht⟩
  refine ⟨T, h, t, e, ht, ?_⟩
  have hd : Kc.d ((ComplexShape.up ℕ).prev n) n =
      κ ≫ Limits.kernel.ι (Kc.homologyπ n) ≫ Kc.iCycles n := by
    rw [← Category.assoc, hκι, HomologicalComplex.toCycles_i]
  have hl : ((Kc.iCycles n).val.app (Opposite.op V)).hom c =
      (k.val.app (Opposite.op V)).hom (1 : R.obj.obj (Opposite.op V)) := by
    have := congrArg (fun φ : SheafOfModules.unit R ⟶ Kc.X n =>
      (φ.val.app (Opposite.op V)).hom (1 : R.obj.obj (Opposite.op V)))
      (HomologicalComplex.liftCycles_i Kc k (n + 1) (by simp) hk)
    exact this
  have h1 : ((SheafOfModules.unit R).val.map h.op).hom (1 : R.obj.obj (Opposite.op V)) =
      (1 : R.obj.obj (Opposite.op T)) :=
    PresheafOfModules.unit_map_one _ _
  rw [hd]
  change ((Kc.iCycles n).val.app (Opposite.op T)).hom
    (((Limits.kernel.ι (Kc.homologyπ n)).val.app (Opposite.op T)).hom
      ((κ.val.app (Opposite.op T)).hom e)) = _
  rw [he', PresheafOfModules.naturality_apply, PresheafOfModules.naturality_apply, hs, hl]
  have h2 : (k.val.app (Opposite.op T)).hom
      (((SheafOfModules.unit R).val.map h.op).hom (1 : R.obj.obj (Opposite.op V))) =
      ((Kc.X n).val.map h.op).hom ((k.val.app (Opposite.op V)).hom
        (1 : R.obj.obj (Opposite.op V))) :=
    PresheafOfModules.naturality_apply k.val h.op _
  rw [h1] at h2
  exact h2.symm

theorem wc_et_mod_corep_etale : ∀ (Y : Scheme.{u}) (R : Sheaf (Scheme.smallEtaleTopology Y) RingCat.{u+1}) (W : Y.Etale), ∃ (Q : SheafOfModules.{u+1} R) (e : Q.val.obj (Opposite.op W)), ∀ M : SheafOfModules.{u+1} R, Function.Bijective (fun φ : Q ⟶ M => (φ.val.app (Opposite.op W)).hom e) :=
by
  intro Y R W
  let adj1 := PresheafOfModules.sheafificationAdjunction.{u+1} (𝟙 R.obj)
  let adj2 := PresheafOfModules.freeAdjunction.{u+1} R.obj
  let F0 := uliftYoneda.{u+1}.obj W
  let P := (PresheafOfModules.free.{u+1} R.obj).obj F0
  let Q : SheafOfModules.{u+1} R := (PresheafOfModules.sheafification.{u+1} (𝟙 R.obj)).obj P
  let B : ∀ M : SheafOfModules.{u+1} R, (Q ⟶ M) → M.val.obj (Opposite.op W) := fun M φ =>
    uliftYonedaEquiv (adj2.homEquiv F0 _ (adj1.homEquiv P M φ))
  have hB : ∀ M : SheafOfModules.{u+1} R, Function.Bijective (B M) := fun M =>
    uliftYonedaEquiv.bijective.comp ((adj2.homEquiv F0 _).bijective.comp
      (adj1.homEquiv P M).bijective)
  refine ⟨Q, B Q (𝟙 Q), fun M => ?_⟩
  have key : ∀ φ : Q ⟶ M, B M φ = (φ.val.app (Opposite.op W)).hom (B Q (𝟙 Q)) := by
    intro φ
    have h1 := adj1.homEquiv_naturality_right (𝟙 Q) φ
    rw [Category.id_comp] at h1
    have h2 := adj2.homEquiv_naturality_right (adj1.homEquiv P Q (𝟙 Q))
      ((SheafOfModules.forget R ⋙ PresheafOfModules.restrictScalars (𝟙 R.obj)).map φ)
    show uliftYonedaEquiv (adj2.homEquiv F0 _ (adj1.homEquiv P M φ)) = _
    rw [h1, h2, uliftYonedaEquiv_comp]
    rfl
  have hfun : (fun φ : Q ⟶ M => (φ.val.app (Opposite.op W)).hom (B Q (𝟙 Q))) = B M :=
    funext fun φ => (key φ).symm
  rw [hfun]
  exact hB M

theorem wc_et_corep_specialise_unit : ∀ {Y Z Y' : Scheme.{u}} (p : Z ⟶ Y) (j : Y' ⟶ Z) (n : ℕ) (D1 : wcEtPullData p n) (Dj : wcEtPullData j n) (W : Y.Etale) (Q : SheafOfModules.{u+1} (wcEtZModRing Y n)) (e : Q.val.obj (Opposite.op W)) (ρ : Q ⟶ SheafOfModules.unit (wcEtZModRing Y n)), (ρ.val.app (Opposite.op W)).hom e = (1 : (wcEtZModRing Y n).obj.obj (Opposite.op W)) → ∀ a : Y' ⟶ W.left, a ≫ W.hom = j ≫ p → ∃ s : SheafOfModules.unit (wcEtZModRing Y' n) ⟶ Dj.Φ.obj (D1.Φ.obj Q), IsIso (s ≫ Dj.Φ.map (D1.Φ.map ρ ≫ D1.μ.hom) ≫ Dj.μ.hom) :=
by
  classical
  intro Y Z Y' p j n D1 Dj W Q e ρ hρ a ha

  have s1 : ∀ (X : Scheme.{u}) (V : (X.Etale)ᵒᵖ) (a b : ↑((wcEtZModRing X n).obj.obj V)),
      a * b = b * a := by
    intro X V a b
    obtain ⟨α, hsurj⟩ : ∃ α : (Functor.const (X.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶
        (wcEtZModRing X n).obj, Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X) α :=
      ⟨toSheafify (Scheme.smallEtaleTopology X)
          ((Functor.const (X.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n)))),
        Presheaf.isLocallySurjective_toSheafify' (Scheme.smallEtaleTopology X) _⟩
    haveI := hsurj
    have hsep := Sheaf.isSeparated (wcEtZModRing X n)
    induction V using Opposite.rec with
    | op V =>
    refine hsep V _ (GrothendieckTopology.intersection_covering _
      (Presheaf.imageSieve_mem _ α a) (Presheaf.imageSieve_mem _ α b)) (a * b) (b * a) ?_
    intro W h hh
    have hh' : (Presheaf.imageSieve α a).arrows h ∧ (Presheaf.imageSieve α b).arrows h := hh
    obtain ⟨⟨t₁, ht₁⟩, ⟨t₂, ht₂⟩⟩ := hh'
    have hc : t₁ * t₂ = t₂ * t₁ := @mul_comm (ULift.{u+1} (ZMod n)) _ t₁ t₂
    rw [map_mul, map_mul, ← ht₁, ← ht₂, ← map_mul, ← map_mul]
    exact congrArg _ hc

  have s2 : ∀ {S S' : Scheme.{u}} {g : S' ⟶ S} (D : wcEtPullData g n),
      (∀ (V : (S'.Etale)ᵒᵖ) (a b : ↑((wcEtZModRing S' n).obj.obj V)), a * b = b * a) →
      ∀ (M : SheafOfModules.{u+1} (wcEtZModRing S n))
        (ψ : M ⟶ SheafOfModules.unit (wcEtZModRing S n)) (W : S.Etale)
        (e : M.val.obj (Opposite.op W)),
      (ψ.val.app (Opposite.op W)).hom e = (1 : (wcEtZModRing S n).obj.obj (Opposite.op W)) →
      ∃ e' : (D.Φ.obj M).val.obj (Opposite.op ((wcEtBaseChange g).obj W)),
        ((D.Φ.map ψ ≫ D.μ.hom).val.app (Opposite.op ((wcEtBaseChange g).obj W))).hom e' =
          (1 : (wcEtZModRing S' n).obj.obj (Opposite.op ((wcEtBaseChange g).obj W))) := by
    intro S S' g D hcomm M ψ W e he
    haveI := D.cont
    obtain ⟨t, ht⟩ : ∃ t : SheafOfModules.unit (wcEtZModRing S' n) ⟶
        SheafOfModules.unit (wcEtZModRing S' n),
        t = D.μ.inv ≫ (D.adj.homEquiv _ _).symm (SheafOfModules.unitToPushforwardObjUnit D.φ) :=
      ⟨_, rfl⟩
    have h1 : D.adj.homEquiv _ _ D.μ.hom ≫ (SheafOfModules.pushforward D.φ).map t =
        SheafOfModules.unitToPushforwardObjUnit D.φ := by
      rw [← Adjunction.homEquiv_naturality_right, ht, Iso.hom_inv_id_assoc, Equiv.apply_symm_apply]
    obtain ⟨z, hz⟩ : ∃ z : (wcEtZModRing S' n).obj.obj (Opposite.op ((wcEtBaseChange g).obj W)),
        z = ((D.adj.homEquiv _ _ D.μ.hom).val.app (Opposite.op W)).hom
          (1 : (wcEtZModRing S n).obj.obj (Opposite.op W)) := ⟨_, rfl⟩
    obtain ⟨x, hx⟩ : ∃ x : (wcEtZModRing S' n).obj.obj (Opposite.op ((wcEtBaseChange g).obj W)),
        x = (t.val.app (Opposite.op ((wcEtBaseChange g).obj W))).hom
          (1 : (wcEtZModRing S' n).obj.obj (Opposite.op ((wcEtBaseChange g).obj W))) := ⟨_, rfl⟩
    have hz1 : (t.val.app (Opposite.op ((wcEtBaseChange g).obj W))).hom z =
        (1 : (wcEtZModRing S' n).obj.obj (Opposite.op ((wcEtBaseChange g).obj W))) := by
      have h2 : ((D.adj.homEquiv _ _ D.μ.hom ≫ (SheafOfModules.pushforward D.φ).map t).val.app
          (Opposite.op W)).hom (1 : (wcEtZModRing S n).obj.obj (Opposite.op W)) =
          ((SheafOfModules.unitToPushforwardObjUnit D.φ).val.app (Opposite.op W)).hom
            (1 : (wcEtZModRing S n).obj.obj (Opposite.op W)) :=
        congrArg (fun f => (f.val.app (Opposite.op W)).hom
          (1 : (wcEtZModRing S n).obj.obj (Opposite.op W))) h1
      rw [hz]
      exact h2.trans ((SheafOfModules.unitToPushforwardObjUnit_val_app_apply D.φ _).trans
        (map_one (D.φ.hom.app (Opposite.op W)).hom))
    have hzx : z * x = 1 := by
      have e1 : (t.val.app (Opposite.op ((wcEtBaseChange g).obj W))).hom z =
          (t.val.app (Opposite.op ((wcEtBaseChange g).obj W))).hom
            (z • (1 : (wcEtZModRing S' n).obj.obj (Opposite.op ((wcEtBaseChange g).obj W)))) :=
        congrArg _ (mul_one z).symm
      rw [hx]
      exact ((t.val.app (Opposite.op ((wcEtBaseChange g).obj W))).hom.map_smul z _).symm.trans
        (e1.symm.trans hz1)
    have hk0 : D.adj.homEquiv _ _ (D.Φ.map ψ ≫ D.μ.hom) = ψ ≫ D.adj.homEquiv _ _ D.μ.hom :=
      Adjunction.homEquiv_naturality_left _ _ _
    have hk : D.adj.unit.app M ≫ (SheafOfModules.pushforward D.φ).map (D.Φ.map ψ ≫ D.μ.hom) =
        ψ ≫ D.adj.homEquiv _ _ D.μ.hom :=
      (Adjunction.homEquiv_unit D.adj _ _ _).symm.trans hk0
    obtain ⟨ε, hε⟩ : ∃ ε : (D.Φ.obj M).val.obj (Opposite.op ((wcEtBaseChange g).obj W)),
        ε = ((D.adj.unit.app M).val.app (Opposite.op W)).hom e := ⟨_, rfl⟩
    have hεz : ((D.Φ.map ψ ≫ D.μ.hom).val.app (Opposite.op ((wcEtBaseChange g).obj W))).hom ε =
        z := by
      have h2 : ((D.adj.unit.app M ≫ (SheafOfModules.pushforward D.φ).map
          (D.Φ.map ψ ≫ D.μ.hom)).val.app (Opposite.op W)).hom e =
          ((ψ ≫ D.adj.homEquiv _ _ D.μ.hom).val.app (Opposite.op W)).hom e :=
        congrArg (fun f => (f.val.app (Opposite.op W)).hom e) hk
      rw [hε, hz]
      exact h2.trans (congrArg ((D.adj.homEquiv _ _ D.μ.hom).val.app (Opposite.op W)).hom he)
    refine ⟨x • ε, ?_⟩
    exact ((((D.Φ.map ψ ≫ D.μ.hom).val.app
      (Opposite.op ((wcEtBaseChange g).obj W))).hom.map_smul x ε).trans
        (congrArg (x • ·) hεz)).trans ((hcomm _ x z).trans hzx)

  have s3 : ∀ {X : Scheme.{u}} (R : Sheaf (Scheme.smallEtaleTopology X) RingCat.{u+1})
      (N : SheafOfModules.{u+1} R) (φ0 : N ⟶ SheafOfModules.unit R) (T : X.Etale)
      (σ₀ : X ⟶ T.left), σ₀ ≫ T.hom = 𝟙 X → ∀ e : N.val.obj (Opposite.op T),
      (φ0.val.app (Opposite.op T)).hom e = (1 : R.obj.obj (Opposite.op T)) →
      ∃ s : SheafOfModules.unit R ⟶ N, s ≫ φ0 = 𝟙 (SheafOfModules.unit R) := by
    intro X R N φ0 T σ₀ hσ e he
    let k : ∀ U : X.Etale, U ⟶ T := fun U =>
      MorphismProperty.Over.homMk (U.hom ≫ σ₀)
        (by rw [Category.assoc, hσ]; exact Category.comp_id _) trivial
    have hk : ∀ {U U' : X.Etale} (f : U ⟶ U'), f ≫ k U' = k U := by
      intro U U' f
      apply MorphismProperty.Over.Hom.ext
      show f.left ≫ U'.hom ≫ σ₀ = U.hom ≫ σ₀
      rw [← Category.assoc, MorphismProperty.Over.w f]
    let m : ∀ V : (X.Etale)ᵒᵖ, N.val.obj V := fun V => (N.val.map (k V.unop).op).hom e
    have hcongr : ∀ {V' : (X.Etale)ᵒᵖ} (g h : Opposite.op T ⟶ V'), g = h →
        (N.val.map g).hom e = (N.val.map h).hom e := by
      rintro V' g _ rfl
      rfl
    have hm : ∀ ⦃V V' : (X.Etale)ᵒᵖ⦄ (f : V ⟶ V'), (N.val.map f).hom (m V) = m V' := by
      intro V V' f
      have e1 : (k V.unop).op ≫ f = (k V'.unop).op := by
        rw [← hk f.unop]
        rfl
      exact (PresheafOfModules.map_comp_apply N.val (k V.unop).op f e).symm.trans
        (hcongr _ _ e1)
    refine ⟨N.unitHomEquiv.symm (PresheafOfModules.sectionsMk (M := N.val) m hm), ?_⟩
    rw [SheafOfModules.unitHomEquiv_symm_comp, Equiv.symm_apply_eq]
    apply PresheafOfModules.sections_ext
    intro V
    rw [SheafOfModules.unitHomEquiv_apply_coe]
    change (φ0.val.app V).hom (m V) = (1 : R.obj.obj V)
    refine (PresheafOfModules.naturality_apply φ0.val (k V.unop).op e).trans ?_
    exact (congrArg ((SheafOfModules.unit R).val.map (k V.unop).op).hom he).trans
      (map_one (R.obj.map (k V.unop).op).hom)

  obtain ⟨e₁, he₁⟩ := s2 D1 (s1 Z) Q ρ W e hρ
  obtain ⟨e₂, he₂⟩ := s2 Dj (s1 Y') (D1.Φ.obj Q) (D1.Φ.map ρ ≫ D1.μ.hom)
    ((wcEtBaseChange p).obj W) e₁ he₁
  obtain ⟨x, hx⟩ : ∃ x : Y' ⟶ Limits.pullback W.hom p, x ≫ Limits.pullback.snd W.hom p = j :=
    ⟨Limits.pullback.lift a j ha, Limits.pullback.lift_snd _ _ _⟩
  obtain ⟨σ₀, hσ⟩ : ∃ σ₀ : Y' ⟶ ((wcEtBaseChange j).obj ((wcEtBaseChange p).obj W)).left,
      σ₀ ≫ ((wcEtBaseChange j).obj ((wcEtBaseChange p).obj W)).hom = 𝟙 Y' :=
    ⟨(Limits.pullback.lift x (𝟙 Y') (by rw [Category.id_comp]; exact hx) :
        Y' ⟶ Limits.pullback (Limits.pullback.snd W.hom p) j), Limits.pullback.lift_snd _ _ _⟩
  obtain ⟨s, hs⟩ := s3 (wcEtZModRing Y' n) (Dj.Φ.obj (D1.Φ.obj Q))
    (Dj.Φ.map (D1.Φ.map ρ ≫ D1.μ.hom) ≫ Dj.μ.hom)
    ((wcEtBaseChange j).obj ((wcEtBaseChange p).obj W)) σ₀ hσ e₂ he₂
  exact ⟨s, by rw [hs]; exact IsIso.id _⟩

theorem wc_et_proj_class_stalk_injective : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsProper f] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (D1 : wcEtPullData (Limits.pullback.fst f f) ℓ) (D2 : wcEtPullData (Limits.pullback.snd f f) ℓ) (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing (Limits.pullback f f) ℓ))) (n r : ℕ) (b : Fin r → wcEtZModExt Y ℓ n), (∀ z : wcEtZModExt Y ℓ n, ∃! c : Fin r → ZMod ℓ, z = ∑ i, (c i).val • b i) → ∀ (g : Fin r → (D1.Φ.obj (SheafOfModules.unit (wcEtZModRing Y ℓ)) ⟶ I.cocomplex.X n)) (hg : ∀ i, g i ≫ I.cocomplex.d n (n + 1) = 0), letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f f) ℓ)) := HasExt.standard _; letI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst f f)) _ _ D1.cont D1.φ).Additive := @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D1.adj D1.additive; (∀ i, I.extMk (g i) (n + 1) rfl (hg i) = (Abelian.Ext.mk₀ D1.μ.hom).comp (wcEtPull D2 n (b i)) (zero_add n)) → ∀ (hf : ∀ i, D1.adj.homEquiv _ _ (g i) ≫ (((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst f f)) _ _ D1.cont D1.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).d n (n + 1) = 0) (y : Y) (c : Fin r → ZMod ℓ), (wcEtStalk Y y).map ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).map (∑ i, (c i).val • ((((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst f f)) _ _ D1.cont D1.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).liftCycles (D1.adj.homEquiv _ _ (g i)) (n + 1) (by simp) (hf i) ≫ (((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst f f)) _ _ D1.cont D1.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homologyπ n))) = 0 → c = 0 :=
by
  classical
  intro K _ _ Y f _ ℓ _ hℓ D1 D2 I n r b hb g hg hgE hf y c hstalk
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f f) ℓ)) := HasExt.standard _
  letI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst f f)) _ _
      D1.cont D1.φ).Additive :=
    @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D1.adj D1.additive
  haveI := D1.additive
  haveI := D1.presLim
  haveI := D1.presColim
  set R1 := (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst f f)) _ _
    D1.cont D1.φ) with hR1
  set Kc := ((R1.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex) with hKc

  obtain ⟨gc, hgc_def⟩ : ∃ gc : D1.Φ.obj (SheafOfModules.unit (wcEtZModRing Y ℓ)) ⟶ I.cocomplex.X n,
      gc = ∑ i, (c i).val • g i := ⟨_, rfl⟩
  obtain ⟨β, hβ_def⟩ : ∃ β : wcEtZModExt Y ℓ n, β = ∑ i, (c i).val • b i := ⟨_, rfl⟩
  have hsumd : ∀ s : Finset (Fin r),
      (∑ i ∈ s, (c i).val • g i) ≫ I.cocomplex.d n (n + 1) = 0 := by
    intro s
    rw [Preadditive.sum_comp]
    exact Finset.sum_eq_zero (fun i _ => by rw [Preadditive.nsmul_comp, hg, smul_zero])
  have hgc : gc ≫ I.cocomplex.d n (n + 1) = 0 := by rw [hgc_def]; exact hsumd _
  obtain ⟨k, hk_def⟩ : ∃ k : SheafOfModules.unit (wcEtZModRing Y ℓ) ⟶ R1.obj (I.cocomplex.X n),
      k = D1.adj.homEquiv _ _ gc := ⟨_, rfl⟩
  have hk_sum : k = ∑ i, (c i).val • D1.adj.homEquiv _ _ (g i) := by
    rw [hk_def, hgc_def, ← Adjunction.homAddEquiv_apply, map_sum]
    simp only [map_nsmul, Adjunction.homAddEquiv_apply]
  have hkc : k ≫ Kc.d n (n + 1) = 0 := by
    rw [hk_sum, Preadditive.sum_comp]
    exact Finset.sum_eq_zero (fun i _ => by rw [Preadditive.nsmul_comp, hf i, smul_zero])
  have hι : (∑ i, (c i).val • (Kc.liftCycles (D1.adj.homEquiv _ _ (g i)) (n + 1) (by simp) (hf i) ≫
      Kc.homologyπ n)) = Kc.liftCycles k (n + 1) (by simp) hkc ≫ Kc.homologyπ n := by
    have hl : Kc.liftCycles k (n + 1) (by simp) hkc =
        ∑ i, (c i).val • Kc.liftCycles (D1.adj.homEquiv _ _ (g i)) (n + 1) (by simp) (hf i) := by
      rw [← cancel_mono (Kc.iCycles n), HomologicalComplex.liftCycles_i, Preadditive.sum_comp]
      simp only [Preadditive.nsmul_comp, HomologicalComplex.liftCycles_i]
      exact hk_sum
    rw [hl, Preadditive.sum_comp]
    simp only [Preadditive.nsmul_comp]
  have hcongr : ∀ (x x' : D1.Φ.obj (SheafOfModules.unit (wcEtZModRing Y ℓ)) ⟶ I.cocomplex.X n)
      (hxx : x = x') (hx : x ≫ I.cocomplex.d n (n + 1) = 0)
      (hx' : x' ≫ I.cocomplex.d n (n + 1) = 0),
      I.extMk x (n + 1) rfl hx = I.extMk x' (n + 1) rfl hx' := by
    rintro x _ rfl _ _
    rfl
  have hnsmul : ∀ (m : ℕ) (x : D1.Φ.obj (SheafOfModules.unit (wcEtZModRing Y ℓ)) ⟶ I.cocomplex.X n)
      (hx : x ≫ I.cocomplex.d n (n + 1) = 0) (hmx : (m • x) ≫ I.cocomplex.d n (n + 1) = 0),
      I.extMk (m • x) (n + 1) rfl hmx = m • I.extMk x (n + 1) rfl hx := by
    intro m x hx hmx
    induction m with
    | zero =>
      rw [hcongr _ 0 (zero_nsmul x) hmx Limits.zero_comp, zero_nsmul]
      exact I.extMk_zero (n + 1) rfl
    | succ m ih =>
      have h1 : (m • x) ≫ I.cocomplex.d n (n + 1) = 0 := by
        rw [Preadditive.nsmul_comp, hx, smul_zero]
      rw [hcongr _ (m • x + x) (succ_nsmul x m) hmx
          (by rw [Preadditive.add_comp, h1, hx, add_zero]),
        ← I.add_extMk (m • x) x (n + 1) rfl h1 hx, ih h1, succ_nsmul]
  have hsum : ∀ (s : Finset (Fin r)) (hs : (∑ i ∈ s, (c i).val • g i) ≫ I.cocomplex.d n (n + 1) = 0),
      I.extMk (∑ i ∈ s, (c i).val • g i) (n + 1) rfl hs =
        ∑ i ∈ s, (c i).val • I.extMk (g i) (n + 1) rfl (hg i) := by
    intro s
    induction s using Finset.induction_on with
    | empty =>
      intro hs
      rw [hcongr _ 0 Finset.sum_empty hs Limits.zero_comp, Finset.sum_empty]
      exact I.extMk_zero (n + 1) rfl
    | insert a s ha ih =>
      intro hs
      have h1 : ((c a).val • g a) ≫ I.cocomplex.d n (n + 1) = 0 := by
        rw [Preadditive.nsmul_comp, hg, smul_zero]
      rw [hcongr _ _ (Finset.sum_insert ha) hs
          (by rw [Preadditive.add_comp, h1, hsumd s, add_zero]),
        ← I.add_extMk _ _ (n + 1) rfl h1 (hsumd s), ih (hsumd s), hnsmul _ _ (hg a) h1,
        Finset.sum_insert ha]
  have hext : I.extMk gc (n + 1) rfl hgc =
      (Abelian.Ext.mk₀ D1.μ.hom).comp (wcEtPull D2 n β) (zero_add n) := by
    rw [hcongr gc _ hgc_def hgc (hsumd _), hsum Finset.univ (hsumd _)]
    simp only [hgE]
    have hl : ∀ x : wcEtZModExt (Limits.pullback f f) ℓ n,
        (Abelian.Ext.mk₀ D1.μ.hom).comp x (zero_add n) =
        (Abelian.Ext.mk₀ D1.μ.hom).precomp
          (SheafOfModules.unit (wcEtZModRing (Limits.pullback f f) ℓ)) (zero_add n) x :=
      fun _ => rfl
    rw [hβ_def]
    simp only [hl, map_sum, map_nsmul]

  have hbd : ∀ {A : SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f f) ℓ)} (m : ℕ)
      (x : A ⟶ I.cocomplex.X m) (hx : x ≫ I.cocomplex.d m (m + 1) = 0)
      (τ' : A ⟶ I.cocomplex.X ((ComplexShape.up ℕ).prev m)),
