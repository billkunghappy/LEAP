  exact (congrArg (μ ((wcEtBaseChange g).obj V')) (hnat V V' f c)).trans
    ((hD₀ (lam V c)).trans (hD _).symm)

theorem wc_r2gs_geom_hens_lifts : ∀ {B : Scheme.{u}} (b : B), ∃ (A : Type u) (_ : CommRing A) (_ : HenselianLocalRing A) (_ : IsSepClosed (IsLocalRing.ResidueField A)) (Λ : Type u) (_ : SmallCategory Λ) (_ : IsCofiltered Λ) (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ B) (e : IsLocalRing.ResidueField A →+* AlgebraicClosure (B.residueField b)), W'.Initial ∧ (∀ l, IsAffine (W'.obj l).right.left) ∧ (∀ {l l' : Λ} (t : l ⟶ l'), φ l ≫ (W'.map t).right.left = φ l') ∧ (∀ l, φ l ≫ (W'.obj l).right.hom = a) ∧ (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (W'.obj l).right.left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (W'.map t).right.left = z l') → ∃! z₀ : T ⟶ Spec (.of A), ∀ l, z₀ ≫ φ l = z l) ∧ e.IsIntegral ∧ Spec.map (CommRingCat.ofHom e) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) ≫ a = wcEtGeomPt B b ∧ (∀ l, Spec.map (CommRingCat.ofHom e) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) ≫ φ l = (W'.obj l).hom.left) :=
by
  classical

  have sFrac : ∀ {B : Scheme.{u}} (U : B.Opens) (hU : IsAffineOpen U) (b : B) (hb : b ∈ U) (x : B.residueField b), ∃ r s : Γ(B, U), (B.presheaf.germ U b hb ≫ B.residue b).hom s ≠ 0 ∧ x * (B.presheaf.germ U b hb ≫ B.residue b).hom s = (B.presheaf.germ U b hb ≫ B.residue b).hom r := by
    intro B U hU b hb x
    letI := TopCat.Presheaf.algebra_section_stalk B.presheaf (⟨b, hb⟩ : U)
    haveI := hU.isLocalization_stalk ⟨b, hb⟩
    obtain ⟨y, hy⟩ : ∃ y : B.presheaf.stalk b, IsLocalRing.residue _ y = x :=
      IsLocalRing.residue_surjective x
    obtain ⟨⟨r, s⟩, hrs⟩ :=
      IsLocalization.mk'_surjective (hU.primeIdealOf ⟨b, hb⟩).asIdeal.primeCompl y
    change IsLocalization.mk' (B.presheaf.stalk b) r s = y at hrs
    subst hy
    refine ⟨r, s, ?_, ?_⟩
    · show IsLocalRing.residue (B.presheaf.stalk b)
        (algebraMap Γ(B, U) (B.presheaf.stalk b) (s : Γ(B, U))) ≠ 0
      exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr
        (IsLocalization.map_units (B.presheaf.stalk b) s)
    · show IsLocalRing.residue (B.presheaf.stalk b) y *
          IsLocalRing.residue (B.presheaf.stalk b)
            (algebraMap Γ(B, U) (B.presheaf.stalk b) (s : Γ(B, U))) =
        IsLocalRing.residue (B.presheaf.stalk b) (algebraMap Γ(B, U) (B.presheaf.stalk b) r)
      rw [← map_mul, ← hrs, IsLocalization.mk'_spec]

  have sInt : ∀ (R A k Ω : Type u) [CommRing R] [CommRing A] [IsLocalRing A] [Field k] [Field Ω] [Algebra k Ω] [Algebra.IsAlgebraic k Ω] (σ : R →+* A) (ρ : A →+* Ω) [IsLocalHom ρ] (ev : R →+* k), ρ.comp σ = (algebraMap k Ω).comp ev → (∀ x : k, ∃ r s : R, ev s ≠ 0 ∧ x * ev s = ev r) → (IsLocalRing.ResidueField.lift ρ).IsIntegral := by
    intro R A k Ω _ _ _ _ _ _ _ σ ρ _ ev hρσ hfrac
    have he : ∀ a, IsLocalRing.ResidueField.lift ρ (IsLocalRing.residue A a) = ρ a :=
      fun a => IsLocalRing.ResidueField.lift_residue_apply ρ a
    have hρσ' : ∀ r, ρ (σ r) = algebraMap k Ω (ev r) := fun r => RingHom.congr_fun hρσ r
    have himg : ∀ x : k, algebraMap k Ω x ∈ Set.range (IsLocalRing.ResidueField.lift ρ) := by
      intro x
      obtain ⟨r, s, hs, hx⟩ := hfrac x
      refine ⟨IsLocalRing.residue A (σ r) * (IsLocalRing.residue A (σ s))⁻¹, ?_⟩
      have hs' : algebraMap k Ω (ev s) ≠ 0 := (map_ne_zero _).mpr hs
      rw [map_mul, map_inv₀, he, he, hρσ', hρσ', ← hx, map_mul, mul_assoc, mul_inv_cancel₀ hs',
        mul_one]
    intro y
    obtain ⟨P, hPm, hPy⟩ := (Algebra.IsAlgebraic.isAlgebraic (R := k) y).isIntegral
    have hlift : P.map (algebraMap k Ω) ∈ Polynomial.lifts (IsLocalRing.ResidueField.lift ρ) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      rw [Polynomial.coeff_map]
      exact himg _
    obtain ⟨Q, hQ, -, hQm⟩ := Polynomial.lifts_and_degree_eq_and_monic hlift (hPm.map _)
    refine ⟨Q, hQm, ?_⟩
    rw [Polynomial.eval₂_eq_eval_map, hQ, ← Polynomial.eval₂_eq_eval_map]
    exact hPy

  have sBasic : ∀ (D : Type u) [CommRing D] (Ω : Type u) [Field Ω] (π : D →+* Ω) {E : Scheme.{u}} (f f' : Spec (.of D) ⟶ E) (O : (Spec (.of D)).Opens), Spec.map (CommRingCat.ofHom π) (IsLocalRing.closedPoint Ω) ∈ O → O.ι ≫ f = O.ι ≫ f' → ∃ g : D, π g ≠ 0 ∧ Spec.map (CommRingCat.ofHom (algebraMap D (Localization.Away g))) ≫ f = Spec.map (CommRingCat.ofHom (algebraMap D (Localization.Away g))) ≫ f' := by
    intro D _ Ω _ π E f f' O hx hO
    have hx' : PrimeSpectrum.comap π (IsLocalRing.closedPoint Ω) ∈
        (@id (Set (PrimeSpectrum D)) O.1) := hx
    have hOo : IsOpen (@id (Set (PrimeSpectrum D)) O.1) := O.isOpen
    obtain ⟨_, ⟨g, rfl⟩, hxg, hgO⟩ :=
      PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hx' hOo
    refine ⟨g, ?_, ?_⟩
    · intro h0
      have hxg' := (PrimeSpectrum.mem_basicOpen g _).mp hxg
      apply hxg'
      rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap, h0]
      exact Ideal.zero_mem _
    · have hrange : Set.range (Spec.map (CommRingCat.ofHom (algebraMap D (Localization.Away g)))) ⊆
          Set.range O.ι := by
        rw [Scheme.Opens.range_ι]
        have h1 : Set.range (PrimeSpectrum.comap (algebraMap D (Localization.Away g))) ⊆
            @id (Set (PrimeSpectrum D)) O.1 := by
          rw [PrimeSpectrum.localization_away_comap_range (Localization.Away g) g]
          exact hgO
        exact h1
      rw [← IsOpenImmersion.lift_fac O.ι _ hrange, Category.assoc, Category.assoc, hO]

  have sRat : ∀ (k Ω : Type u) [Field k] [IsSepClosed k] [Field Ω] (ι : k →+* Ω) (E : Type u) [CommRing E] [Algebra k E], Algebra.Etale k E → ∀ ψ : E →+* Ω, ψ.comp (algebraMap k E) = ι → ∃ φ : E →ₐ[k] k, ι.comp (φ : E →+* k) = ψ := by
    intro k Ω _ _ _ ι E _ _ hE ψ hψ
    haveI : Module.Finite k E := Algebra.FormallyUnramified.finite_of_free k E
    haveI : IsArtinianRing E := IsArtinianRing.of_finite k E
    haveI hP : (RingHom.ker ψ).IsPrime := RingHom.ker_isPrime ψ
    haveI : (RingHom.ker ψ).IsMaximal := IsArtinianRing.isMaximal_of_isPrime _
    letI : Field (E ⧸ RingHom.ker ψ) := Ideal.Quotient.field _
    haveI : Algebra.FormallyUnramified k (E ⧸ RingHom.ker ψ) :=
      Algebra.FormallyUnramified.of_surjective (Ideal.Quotient.mkₐ k (RingHom.ker ψ))
        Ideal.Quotient.mk_surjective
    haveI : Algebra.FiniteType k (E ⧸ RingHom.ker ψ) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ k (RingHom.ker ψ))
        Ideal.Quotient.mk_surjective
    haveI : Algebra.IsSeparable k (E ⧸ RingHom.ker ψ) :=
      Algebra.FormallyUnramified.isSeparable k _
    have hsurj := IsSepClosed.algebraMap_surjective k (E ⧸ RingHom.ker ψ)
    let eL : k ≃ₐ[k] (E ⧸ RingHom.ker ψ) := AlgEquiv.ofBijective (Algebra.ofId k _)
      ⟨(algebraMap k (E ⧸ RingHom.ker ψ)).injective, hsurj⟩
    let ψbar : E ⧸ RingHom.ker ψ →+* Ω :=
      Ideal.Quotient.lift _ ψ (fun a ha => RingHom.mem_ker.mp ha)
    have h1 : ∀ c : k, ψbar (algebraMap k (E ⧸ RingHom.ker ψ) c) = ι c := by
      intro c
      show ψbar (Ideal.Quotient.mk _ (algebraMap k E c)) = ι c
      rw [Ideal.Quotient.lift_mk]
      exact RingHom.congr_fun hψ c
    have h2 : ∀ x : E, algebraMap k (E ⧸ RingHom.ker ψ) (eL.symm (Ideal.Quotient.mk _ x)) =
        Ideal.Quotient.mk _ x := by
      intro x
      exact eL.apply_symm_apply (Ideal.Quotient.mk _ x)
    refine ⟨eL.symm.toAlgHom.comp (Ideal.Quotient.mkₐ k (RingHom.ker ψ)), ?_⟩
    ext x
    show ι (eL.symm (Ideal.Quotient.mk _ x)) = ψ x
    rw [← h1, h2]
    exact Ideal.Quotient.lift_mk _ _ _

  have sChart : ∀ {B : Scheme.{u}} (U : B.Opens) (hU : IsAffineOpen U) (V : B.Etale) (Ω : Type u) [Field Ω] (t : Spec (.of Ω) ⟶ V.left) (τ : Γ(B, U) →+* Ω), t ≫ V.hom = Spec.map (CommRingCat.ofHom τ) ≫ hU.fromSpec → ∃ (C : Type u) (_ : CommRing C) (_ : Algebra Γ(B, U) C) (γ₀ : C →+* Ω) (w : Spec (.of C) ⟶ V.left), Algebra.Etale Γ(B, U) C ∧ γ₀.comp (algebraMap Γ(B, U) C) = τ ∧ Spec.map (CommRingCat.ofHom γ₀) ≫ w = t ∧ w ≫ V.hom = Spec.map (CommRingCat.ofHom (algebraMap Γ(B, U) C)) ≫ hU.fromSpec := by
    intro B U hU V Ω _ t τ ht
    have hv : t (IsLocalRing.closedPoint Ω) ∈ V.hom ⁻¹ᵁ U := by
      have e : V.hom (t (IsLocalRing.closedPoint Ω)) =
          hU.fromSpec (Spec.map (CommRingCat.ofHom τ) (IsLocalRing.closedPoint Ω)) :=
        (Scheme.Hom.comp_apply t V.hom _).symm.trans
          ((congrArg (fun k => k (IsLocalRing.closedPoint Ω)) ht).trans
            (Scheme.Hom.comp_apply _ _ _))
      have h := Set.mem_range_self (f := hU.fromSpec)
        (Spec.map (CommRingCat.ofHom τ) (IsLocalRing.closedPoint Ω))
      rw [hU.range_fromSpec] at h
      show V.hom (t (IsLocalRing.closedPoint Ω)) ∈ U
      exact (congrArg (fun y => y ∈ U) e).mpr h
    obtain ⟨V₀, hV₀, hvV₀, hle⟩ := exists_isAffineOpen_mem_and_subset hv
    have hle' : V₀ ≤ V.hom ⁻¹ᵁ U := hle
    let θ : Γ(B, U) ⟶ Γ(V.left, V₀) := V.hom.appLE U V₀ hle'
    letI : Algebra Γ(B, U) Γ(V.left, V₀) := θ.hom.toAlgebra
    have hθ : θ.hom.Etale :=
      HasRingHomProperty.appLE (P := @Etale) V.hom V.prop ⟨U, hU⟩ ⟨V₀, hV₀⟩ hle'
    haveI := hV₀.isOpenImmersion_fromSpec
    haveI := hU.isOpenImmersion_fromSpec
    have hrange : Set.range t ⊆ Set.range hV₀.fromSpec := by
      rw [hV₀.range_fromSpec]
      rintro _ ⟨z, rfl⟩
      obtain rfl : z = IsLocalRing.closedPoint Ω := Subsingleton.elim _ _
      exact hvV₀
    let t' := IsOpenImmersion.lift hV₀.fromSpec t hrange
    let γ₀ : Γ(V.left, V₀) →+* Ω := (Spec.preimage t').hom
    have hγ₀ : Spec.map (CommRingCat.ofHom γ₀) = t' := by
      rw [CommRingCat.ofHom_hom]; exact Spec.map_preimage t'
    have hSq : Spec.map θ ≫ hU.fromSpec = hV₀.fromSpec ≫ V.hom :=
      IsAffineOpen.SpecMap_appLE_fromSpec V.hom hU hV₀ hle'
    refine ⟨Γ(V.left, V₀), inferInstance, inferInstance, γ₀, hV₀.fromSpec,
      RingHom.etale_algebraMap.mp hθ, ?_, ?_, ?_⟩
    · have h1 : Spec.map (CommRingCat.ofHom (γ₀.comp (algebraMap Γ(B, U) Γ(V.left, V₀)))) ≫
          hU.fromSpec = Spec.map (CommRingCat.ofHom τ) ≫ hU.fromSpec := by
        rw [CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc, hγ₀]
        change t' ≫ Spec.map θ ≫ hU.fromSpec = _
        rw [hSq, ← Category.assoc, IsOpenImmersion.lift_fac, ht]
      have h2 := (cancel_mono hU.fromSpec).mp h1
      have h3 := congrArg CommRingCat.Hom.hom (Spec.map_injective h2)
      simpa only [CommRingCat.hom_ofHom] using h3
    · rw [hγ₀, IsOpenImmersion.lift_fac]
    · exact hSq.symm

  have sRet : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] (E : Type u) [CommRing E] [Algebra A E], Algebra.Etale A E → ∀ φ : E →ₐ[A] IsLocalRing.ResidueField A, ∃ τ : E →ₐ[A] A, (Algebra.ofId A (IsLocalRing.ResidueField A)).comp τ = φ := by
    intro A0 _ hHen
    have sstd : ∀ (S : Type u) [CommRing S] [Algebra A0 S], Algebra.IsStandardEtale A0 S →
        ∀ φ : S →ₐ[A0] IsLocalRing.ResidueField A0,
          ∃ τ : S →ₐ[A0] A0, (Algebra.ofId A0 (IsLocalRing.ResidueField A0)).comp τ = φ := by
      intro S _ _ hS φ
      obtain ⟨P⟩ := hS.nonempty_standardEtalePresentation
      have hm := P.hasMap
      have hf0 : Polynomial.aeval (φ P.x) P.f = 0 := by
        rw [Polynomial.aeval_algHom_apply, hm.1, map_zero]
      have hg0 : Polynomial.aeval (φ P.x) P.g ≠ 0 := by
        rw [Polynomial.aeval_algHom_apply]
        exact (hm.2.map φ).ne_zero
      have hd0 : Polynomial.aeval (φ P.x) (Polynomial.derivative P.f) ≠ 0 := by
        obtain ⟨p₁, p₂, N, hc⟩ := P.cond
        have h1 := congrArg (Polynomial.aeval (φ P.x)) hc
        rw [map_add, map_mul, map_mul, hf0, zero_mul, add_zero, map_pow] at h1
        intro h
        rw [h, zero_mul] at h1
        exact pow_ne_zero N hg0 h1.symm
      have key := (HenselianLocalRing.TFAE A0).out 1 2
      obtain ⟨a, ha, hres⟩ := key.mp hHen P.f P.monic_f (φ P.x) hf0 hd0
      have hA : P.HasMap a := by
        refine ⟨?_, ?_⟩
        · rw [Polynomial.aeval_def, Algebra.algebraMap_self, Polynomial.eval₂_id]
          exact ha
        · have key2 : (Algebra.ofId A0 (IsLocalRing.ResidueField A0)) (Polynomial.aeval a P.g) =
              Polynomial.aeval (φ P.x) P.g := by
            rw [← Polynomial.aeval_algHom_apply, Algebra.ofId_apply,
              IsLocalRing.ResidueField.algebraMap_eq, hres]
          rw [Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq] at key2
          exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mp (key2 ▸ hg0)
      refine ⟨(P.lift a hA).comp P.equivRing.toAlgHom, ?_⟩
      have h1 : (Algebra.ofId A0 (IsLocalRing.ResidueField A0)).comp (P.lift a hA) =
          φ.comp P.equivRing.symm.toAlgHom := by
        apply StandardEtalePair.hom_ext
        rw [AlgHom.comp_apply, AlgHom.comp_apply, StandardEtalePair.lift_X, Algebra.ofId_apply,
          IsLocalRing.ResidueField.algebraMap_eq, hres]
        have hx : P.equivRing.symm P.X = P.x :=
          (P.equivRing.symm_apply_eq).mpr P.equivRing_x.symm
        show φ P.x = φ (P.equivRing.symm P.X)
        rw [hx]
      ext s
      have h2 := congrArg (fun F => F (P.equivRing s)) h1
      simpa using h2
    intro E _ _ hE φ
    have : (RingHom.ker (φ : E →+* IsLocalRing.ResidueField A0)).IsPrime := RingHom.ker_isPrime _
    obtain ⟨s, hs, hst⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := A0)
      (RingHom.ker (φ : E →+* IsLocalRing.ResidueField A0))
    have hs0 : φ s ≠ 0 := fun h => hs (RingHom.mem_ker.mpr h)
    have hu : ∀ y : Submonoid.powers s, IsUnit (φ y) := by
      rintro ⟨y, k, rfl⟩
      simpa [map_pow] using (isUnit_iff_ne_zero.mpr hs0).pow k
    let φ' : Localization.Away s →ₐ[A0] IsLocalRing.ResidueField A0 :=
      IsLocalization.liftAlgHom (M := Submonoid.powers s) hu
    obtain ⟨τ', hτ'⟩ := sstd _ hst φ'
    refine ⟨τ'.comp (IsScalarTower.toAlgHom A0 E (Localization.Away s)), ?_⟩
    ext e
    have h1 := congrArg (fun F => F (algebraMap E (Localization.Away s) e)) hτ'
    simp only [AlgHom.comp_apply] at h1 ⊢
    rw [IsScalarTower.toAlgHom_apply, h1]
    simp [φ', IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]

  have sLift : ∀ (R A Ω : Type u) [CommRing R] [CommRing A] [IsLocalRing A] [Field Ω] (σ : R →+* A) (ρ : A →+* Ω) [IsLocalHom ρ], (∀ (E : Type u) [CommRing E] [Algebra A E], Algebra.Etale A E → ∀ φ : E →ₐ[A] IsLocalRing.ResidueField A, ∃ τ : E →ₐ[A] A, (Algebra.ofId A (IsLocalRing.ResidueField A)).comp τ = φ) → (∀ (E : Type u) [CommRing E] [Algebra (IsLocalRing.ResidueField A) E], Algebra.Etale (IsLocalRing.ResidueField A) E → ∀ ψ : E →+* Ω, ψ.comp (algebraMap (IsLocalRing.ResidueField A) E) = IsLocalRing.ResidueField.lift ρ → ∃ φ : E →ₐ[IsLocalRing.ResidueField A] IsLocalRing.ResidueField A, (IsLocalRing.ResidueField.lift ρ).comp (φ : E →+* IsLocalRing.ResidueField A) = ψ) → ∀ (C : Type u) [CommRing C] [Algebra R C], Algebra.Etale R C → ∀ γ₀ : C →+* Ω, γ₀.comp (algebraMap R C) = ρ.comp σ → ∃ γ : C →+* A, γ.comp (algebraMap R C) = σ ∧ ρ.comp γ = γ₀ := by
    intro R A Ω _ _ _ _ σ ρ _ hRET hRAT C _ _ hC γ₀ hγ₀
    letI : Algebra R A := σ.toAlgebra
    letI : Algebra R Ω := (ρ.comp σ).toAlgebra
    letI : Algebra A Ω := ρ.toAlgebra
    haveI : IsScalarTower R A Ω := IsScalarTower.of_algebraMap_eq (fun r => rfl)
    let γ₀ₐ : C →ₐ[R] Ω := { γ₀ with commutes' := fun r => RingHom.congr_fun hγ₀ r }
    haveI hEet : Algebra.Etale A (TensorProduct R A C) := Algebra.Etale.baseChange R C A
    let ψ : TensorProduct R A C →ₐ[A] Ω :=
      Algebra.TensorProduct.lift (Algebra.ofId A Ω) γ₀ₐ (fun _ _ => Commute.all _ _)
    letI : Algebra (IsLocalRing.ResidueField A) Ω := (IsLocalRing.ResidueField.lift ρ).toAlgebra
    haveI : IsScalarTower A (IsLocalRing.ResidueField A) Ω := IsScalarTower.of_algebraMap_eq
      (fun a => (IsLocalRing.ResidueField.lift_residue_apply ρ a).symm)
    let ψk : TensorProduct A (IsLocalRing.ResidueField A) (TensorProduct R A C) →ₐ[IsLocalRing.ResidueField A] Ω :=
      Algebra.TensorProduct.lift (Algebra.ofId (IsLocalRing.ResidueField A) Ω) ψ
        (fun _ _ => Commute.all _ _)
    obtain ⟨φk, hφk⟩ := hRAT (TensorProduct A (IsLocalRing.ResidueField A) (TensorProduct R A C))
      (Algebra.Etale.baseChange A (TensorProduct R A C) (IsLocalRing.ResidueField A))
      (ψk : _ →+* Ω) ψk.comp_algebraMap
    let φ : TensorProduct R A C →ₐ[A] IsLocalRing.ResidueField A :=
      (φk.restrictScalars A).comp Algebra.TensorProduct.includeRight
    obtain ⟨τ', hτ'⟩ := hRET (TensorProduct R A C) hEet φ
    have key : ∀ z : TensorProduct R A C, ρ (τ' z) = ψ z := by
      intro z
      have e1 : ρ (τ' z) = IsLocalRing.ResidueField.lift ρ (φ z) := by
        rw [← hτ']
        exact (IsLocalRing.ResidueField.lift_residue_apply ρ (τ' z)).symm
      rw [e1]
      have e2 : IsLocalRing.ResidueField.lift ρ (φk (Algebra.TensorProduct.includeRight z)) =
          ψk (Algebra.TensorProduct.includeRight z) := RingHom.congr_fun hφk _
      change IsLocalRing.ResidueField.lift ρ (φk (Algebra.TensorProduct.includeRight z)) = ψ z
      rw [e2]
      change ψk (1 ⊗ₜ z) = ψ z
      rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
    refine ⟨τ'.toRingHom.comp
      (Algebra.TensorProduct.includeRight : C →ₐ[R] TensorProduct R A C).toRingHom, ?_, ?_⟩
    · ext r
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom]
      rw [AlgHom.commutes, IsScalarTower.algebraMap_apply R A (TensorProduct R A C),
        AlgHom.commutes]
      rfl
    · ext c
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom]
      rw [key]
      change ψ (1 ⊗ₜ c) = γ₀ c
      rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
      rfl

  have hS1 : ∀ (R A : Type u) [CommRing R] [CommRing A] (σ : R →+* A), wcIndEtale σ → ∀ a : A, ∃ (E : Type u) (_ : CommRing E) (_ : Algebra R E) (β : E →+* A) (x : E), Algebra.Etale R E ∧ β.comp (algebraMap R E) = σ ∧ β x = a := by
    intro R A _ _ σ hσ a
    letI := σ.toAlgebra
    obtain ⟨E, _, _, hE, α, β, hαβ⟩ := hσ (Polynomial R) (Polynomial.aeval a)
    refine ⟨E, inferInstance, inferInstance, β.toRingHom, α Polynomial.X, hE, ?_, ?_⟩
    · ext r
      exact β.commutes r
    · have := congrArg (fun f => f Polynomial.X) hαβ
      simpa using this

  have hS2 : ∀ (R A : Type u) [CommRing R] [CommRing A] (σ : R →+* A), wcIndEtale σ → ∀ (E : Type u) [CommRing E] [Algebra R E], Algebra.Etale R E → ∀ (β : E →+* A), β.comp (algebraMap R E) = σ → ∀ (m : ℕ) (x y : Fin m → E), (∀ i, β (x i) = β (y i)) → ∃ (E' : Type u) (_ : CommRing E') (_ : Algebra R E') (q : E →ₐ[R] E') (β' : E' →+* A), Algebra.Etale R E' ∧ β'.comp (algebraMap R E') = σ ∧ β'.comp q.toRingHom = β ∧ ∀ i, q (x i) = q (y i) := by
