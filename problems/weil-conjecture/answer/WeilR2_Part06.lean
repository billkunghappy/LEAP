theorem sheafOfModules_torsion_injective_acyclic {C : Type (u+1)} [Category.{u} C]
    (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
    [HasExt (Sheaf J AddCommGrpCat.{u+1})] [EnoughInjectives (Sheaf J AddCommGrpCat.{u+1})]
    (R : Sheaf J RingCat.{u+1}) [(SheafOfModules.toSheaf.{u+1} R).Full] (n : ℕ) (hn : 0 < n)
    (hR : ∀ V, ((n : ℕ) : ↑(R.obj.obj V)) = 0)
    (hess : ∀ G : Sheaf J AddCommGrpCat.{u+1}, n • 𝟙 G = 0 → (SheafOfModules.toSheaf.{u+1} R).essImage G)
    (I : SheafOfModules.{u+1} R) [Injective I] (k : ℕ)
    (e : Abelian.Ext ((constantSheaf J AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      ((SheafOfModules.toSheaf.{u+1} R).obj I) (k + 1)) : e = 0 :=
by
  classical

  have s1 : ∀ (E : Sheaf J AddCommGrpCat.{u+1}) [Injective E], Epi (n • 𝟙 E) := by
    intro E _
    have hP : Injective ((sheafToPresheaf J AddCommGrpCat.{u+1}).obj E) :=
      Injective.injective_of_adjoint (sheafificationAdjunction J AddCommGrpCat.{u+1}) E
    have hdiv : ∀ (U : C) (s : ((sheafToPresheaf J AddCommGrpCat.{u+1}).obj E).obj (Opposite.op U)),
        ∃ t, n • t = s := by
      intro U s
      let P := (sheafToPresheaf J AddCommGrpCat.{u+1}).obj E
      let G : Cᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
        yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
      let φ : G ⟶ P :=
        { app := fun V => AddCommGrpCat.ofHom (FreeAbelianGroup.lift
            (fun f : ULift.{u+1} (V.unop ⟶ U) => (P.map f.down.op).hom s))
          naturality := by
            intro V W h
            apply AddCommGrpCat.hom_ext
            apply FreeAbelianGroup.lift_ext
            intro f
            show (FreeAbelianGroup.lift (fun f' : ULift.{u+1} (W.unop ⟶ U) => (P.map f'.down.op).hom s))
                ((G.map h).hom (FreeAbelianGroup.of f)) =
              (P.map h).hom ((FreeAbelianGroup.lift
                (fun f' : ULift.{u+1} (V.unop ⟶ U) => (P.map f'.down.op).hom s)) (FreeAbelianGroup.of f))
            have hG : (G.map h).hom (FreeAbelianGroup.of f) =
                FreeAbelianGroup.of (ULift.up (h.unop ≫ f.down)) := rfl
            rw [hG]
            erw [FreeAbelianGroup.lift_apply_of, FreeAbelianGroup.lift_apply_of]
            show (P.map (h.unop ≫ f.down).op).hom s = (P.map h).hom ((P.map f.down.op).hom s)
            rw [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp]
            rfl }
      have tf : ∀ (X : Type (u+1)) (a b : FreeAbelianGroup X), n • a = n • b → a = b := by
        intro X a b hab
        apply (FreeAbelianGroup.equivFinsupp X).injective
        ext x
        have hx := congrArg (fun z => FreeAbelianGroup.equivFinsupp X z x) hab
        simp only [map_nsmul, Finsupp.smul_apply, nsmul_eq_mul] at hx
        exact Int.eq_of_mul_eq_mul_left (by exact_mod_cast hn.ne') hx
      have hmono : Mono (n • 𝟙 G) := by
        have : ∀ V, Mono ((n • 𝟙 G).app V) := by
          intro V
          rw [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.mono_iff_injective]
          intro a b hab
          simp only [AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id, AddMonoidHom.nsmul_apply,
            AddMonoidHom.id_apply] at hab
          exact tf _ a b hab
        exact NatTrans.mono_of_mono_app _
      let g := Injective.factorThru φ (n • 𝟙 G)
      have hg : (n • 𝟙 G) ≫ g = φ := Injective.comp_factorThru φ (n • 𝟙 G)
      rw [Preadditive.nsmul_comp, Category.id_comp] at hg
      refine ⟨(g.app (Opposite.op U)).hom (FreeAbelianGroup.of (ULift.up (𝟙 U))), ?_⟩
      have h1 := congrArg (fun α : G ⟶ P =>
        (α.app (Opposite.op U)).hom (FreeAbelianGroup.of (ULift.up (𝟙 U)))) hg
      have h2 : (φ.app (Opposite.op U)).hom (FreeAbelianGroup.of (ULift.up (𝟙 U))) = s := by
        show (FreeAbelianGroup.lift (fun f : ULift.{u+1} (U ⟶ U) => (P.map f.down.op).hom s))
          (FreeAbelianGroup.of (ULift.up (𝟙 U))) = s
        rw [FreeAbelianGroup.lift_apply_of]
        simp
      rw [← h2, ← h1]
      simp only [NatTrans.app_nsmul, AddCommGrpCat.hom_nsmul]
      rfl
    have hmap : (sheafToPresheaf J AddCommGrpCat.{u+1}).map (n • 𝟙 E) =
        n • 𝟙 ((sheafToPresheaf J AddCommGrpCat.{u+1}).obj E) := by
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
    apply Functor.epi_of_epi_map (sheafToPresheaf J AddCommGrpCat.{u+1})
    rw [hmap]
    have : ∀ V, Epi ((n • 𝟙 ((sheafToPresheaf J AddCommGrpCat.{u+1}).obj E)).app V) := by
      intro V
      rw [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.epi_iff_surjective]
      intro s
      obtain ⟨t, ht⟩ := hdiv V.unop s
      exact ⟨t, by simpa using ht⟩
    exact NatTrans.epi_of_epi_app _

  have s2 : Mono (n • 𝟙 ((constantSheaf J AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ)))) := by
    have hB : Mono (n • 𝟙 (AddCommGrpCat.of (ULift.{u+1} ℤ))) := by
      rw [AddCommGrpCat.mono_iff_injective]
      intro a b hab
      simp at hab
      have h2 := congrArg ULift.down hab
      simp [hn.ne'] at h2
      exact h2
    have hc : Mono ((Functor.const Cᵒᵖ).map (n • 𝟙 (AddCommGrpCat.of (ULift.{u+1} ℤ)))) := by
      have : ∀ V, Mono (((Functor.const Cᵒᵖ).map (n • 𝟙 (AddCommGrpCat.of (ULift.{u+1} ℤ)))).app V) :=
        fun V => hB
      exact NatTrans.mono_of_mono_app _
    have := Functor.map_mono (presheafToSheaf J AddCommGrpCat.{u+1})
      ((Functor.const Cᵒᵖ).map (n • 𝟙 (AddCommGrpCat.of (ULift.{u+1} ℤ))))
    rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_nsmul,
      CategoryTheory.Functor.map_id, CategoryTheory.Functor.map_id] at this
    exact this

  have s3 : ∀ (E : Sheaf J AddCommGrpCat.{u+1}) [Injective E], Epi (n • 𝟙 E) →
      ∀ (X : Sheaf J AddCommGrpCat.{u+1}), Mono (n • 𝟙 X) →
      ∀ (x : Abelian.Ext X (Limits.kernel (n • 𝟙 E)) (k + 1)), x = 0 := by
    intro E _ hepi X hmono x
    let S := ShortComplex.mk (Limits.kernel.ι (n • 𝟙 E)) (n • 𝟙 E) (Limits.kernel.condition _)
    have hS : S.ShortExact := by
      refine ShortComplex.ShortExact.mk' ?_ (by dsimp [S]; infer_instance) hepi
      exact S.exact_of_f_is_kernel (Limits.kernelIsKernel (n • 𝟙 E))
    have h0 : x.comp (Abelian.Ext.mk₀ S.f) (add_zero _) = 0 := Abelian.Ext.eq_zero_of_injective _
    obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ X hS x h0 (n₀ := k) rfl
    have hx2 : ∀ (m : ℕ) (y : Abelian.Ext X E m),
        ∃ x₂ : Abelian.Ext X E m, y = x₂.comp (Abelian.Ext.mk₀ S.g) (add_zero m) := by
      intro m y
      cases m with
      | zero =>
        let f₃ := Abelian.Ext.addEquiv₀ y
        let g := Injective.factorThru f₃ (n • 𝟙 X)
        have hg : (n • 𝟙 X) ≫ g = f₃ := Injective.comp_factorThru _ _
        refine ⟨Abelian.Ext.mk₀ g, ?_⟩
        rw [Abelian.Ext.mk₀_comp_mk₀]
        have : g ≫ S.g = f₃ := by
          dsimp [S]
          rw [Preadditive.comp_nsmul, Category.comp_id, ← hg, Preadditive.nsmul_comp,
            Category.id_comp]
        rw [this]
        exact (Abelian.Ext.mk₀_addEquiv₀_apply y).symm
      | succ k' =>
        exact ⟨0, by rw [Abelian.Ext.eq_zero_of_injective y, Abelian.Ext.zero_comp]⟩
    obtain ⟨x₂, hx₂⟩ := hx2 k x₃
    rw [← hx₃, hx₂, Abelian.Ext.comp_assoc _ _ _ (add_zero k) (zero_add 1) (by omega),
      hS.comp_extClass, Abelian.Ext.comp_zero]

  let Φ := SheafOfModules.toSheaf.{u+1} R
  have hI0 : n • 𝟙 (Φ.obj I) = 0 := by
    apply (sheafToPresheaf J AddCommGrpCat.{u+1}).map_injective
    rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id,
      CategoryTheory.Functor.map_zero]
    ext X m
    have key : ∀ m' : (I.val.obj X : Type _), n • m' = 0 := fun m' => by
      rw [← Nat.cast_smul_eq_nsmul (R.obj.obj X) n m', hR X, zero_smul]
    simp only [NatTrans.app_nsmul, NatTrans.id_app, NatTrans.app_zero, AddCommGrpCat.hom_nsmul,
      AddCommGrpCat.hom_id, AddCommGrpCat.hom_zero, AddMonoidHom.nsmul_apply,
      AddMonoidHom.id_apply, AddMonoidHom.zero_apply]
    exact key m
  let E := Injective.under (Φ.obj I)
  let ι := Injective.ι (Φ.obj I)
  have hιn : ι ≫ (n • 𝟙 E) = 0 := by
    have h1 : n • ι = (n • 𝟙 (Φ.obj I)) ≫ ι := by
      rw [Preadditive.nsmul_comp, Category.id_comp]
    rw [Preadditive.comp_nsmul, Category.comp_id, h1, hI0, Limits.zero_comp]
  let j := Limits.kernel.lift (n • 𝟙 E) ι hιn
  have hj : j ≫ Limits.kernel.ι (n • 𝟙 E) = ι := Limits.kernel.lift_ι _ _ _
  have : Mono j := mono_of_mono_fac hj
  have hK0 : n • 𝟙 (Limits.kernel (n • 𝟙 E)) = 0 := by
    apply (cancel_mono (Limits.kernel.ι (n • 𝟙 E))).1
    have h1 : Limits.kernel.ι (n • 𝟙 E) ≫ (n • 𝟙 E) = n • Limits.kernel.ι (n • 𝟙 E) := by
      rw [Preadditive.comp_nsmul, Category.comp_id]
    rw [Preadditive.nsmul_comp, Category.id_comp, ← h1, Limits.kernel.condition, Limits.zero_comp]
  obtain ⟨M', ⟨α⟩⟩ := hess _ hK0
  let g := Φ.preimage (j ≫ α.inv)
  have hg : Φ.map g = j ≫ α.inv := Φ.map_preimage _
  have : Mono g := Φ.mono_of_mono_map (by rw [hg]; infer_instance)
  let r := Injective.factorThru (𝟙 I) g
  have hr : g ≫ r = 𝟙 I := Injective.comp_factorThru _ _
  let ρ := α.inv ≫ Φ.map r
  have hjρ : j ≫ ρ = 𝟙 _ := by
    calc j ≫ ρ = (j ≫ α.inv) ≫ Φ.map r := by simp only [ρ, Category.assoc]
      _ = Φ.map (g ≫ r) := by rw [Φ.map_comp, hg]
      _ = 𝟙 _ := by rw [hr, Φ.map_id]

  have h := s3 E (s1 E) _ s2 (e.comp (Abelian.Ext.mk₀ j) (add_zero _))
  calc e = e.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero _) := (Abelian.Ext.comp_mk₀_id e).symm
    _ = e.comp (Abelian.Ext.mk₀ (j ≫ ρ)) (add_zero _) := by rw [hjρ]
    _ = e.comp ((Abelian.Ext.mk₀ j).comp (Abelian.Ext.mk₀ ρ) (add_zero 0)) (add_zero _) := by
      rw [Abelian.Ext.mk₀_comp_mk₀]
    _ = (e.comp (Abelian.Ext.mk₀ j) (add_zero _)).comp (Abelian.Ext.mk₀ ρ) (add_zero _) :=
      (Abelian.Ext.comp_assoc _ _ _ (add_zero _) (add_zero 0) (by omega)).symm
    _ = 0 := by rw [h, Abelian.Ext.zero_comp]

theorem sheafOfModules_toSheaf_torsion_equiv {C : Type (u+1)} [Category.{u} C]
    (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
    (R : Sheaf J RingCat.{u+1}) (n : ℕ)
    (α : (Functor.const Cᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶ R.obj)
    (hinj : Presheaf.IsLocallyInjective J α) (hsurj : Presheaf.IsLocallySurjective J α) :
    (SheafOfModules.toSheaf.{u+1} R).Full ∧
      ∀ G : Sheaf J AddCommGrpCat.{u+1}, n • 𝟙 G = 0 → (SheafOfModules.toSheaf.{u+1} R).essImage G :=
by
  haveI := hinj
  haveI := hsurj
  have hint : ∀ (V : Cᵒᵖ) (t : ULift.{u+1} (ZMod n)), ∃ k : ℤ,
      ConcreteCategory.hom (α.app V) t = (k : R.obj.obj V) := by
    intro V t
    refine ⟨(t.down.cast : ℤ), ?_⟩
    have ht : t = (((t.down.cast : ℤ)) : ULift.{u+1} (ZMod n)) := by
      apply ULift.ext
      rw [ULift.down_intCast, ZMod.intCast_zmod_cast]
    conv_lhs => rw [ht]
    exact map_intCast (ConcreteCategory.hom (α.app V)) _
  constructor
  · constructor
    intro M M' φ
    refine ⟨⟨PresheafOfModules.homMk φ.hom ?_⟩, ?_⟩
    · intro X r m
      let φX : ∀ X, M.val.obj X → M'.val.obj X := fun X x => (φ.hom.app X).hom x
      have nat : ∀ (X Y : Cᵒᵖ) (f : X ⟶ Y) (x : M.val.obj X),
          M'.val.map f (φX X x) = φX Y (M.val.map f x) := by
        intro X Y f x
        exact (ConcreteCategory.congr_hom (φ.hom.naturality f) x).symm
      have hadd : ∀ X (k : ℤ) (x : M.val.obj X), φX X (k • x) = k • φX X x :=
        fun X k x => map_zsmul (φ.hom.app X).hom k x
