  obtain ⟨ε₀, hε₀⟩ := L1
  have hhom : ∀ M : SheafOfModules.{u+1} (wcEtZModRing Y ℓ),
      Function.Bijective (fun f : N ⟶ M =>
        (ε₀ ≫ eN.inv) ≫ (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y ℓ)).map f) := by
