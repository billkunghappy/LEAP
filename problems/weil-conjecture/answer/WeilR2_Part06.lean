    rw [← e2]
    exact e1
  have hFt : (ℓ ^ m) • 𝟙 ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj
      I.cocomplex).homology 2) = 0 := by
    rw [← natCast_zsmul]
