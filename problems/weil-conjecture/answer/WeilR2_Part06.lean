    obtain ⟨β, hβi, ρβ, Dβ, hβ, hρβ, rfl⟩ := (hT j k s).mp hs
    haveI := hαi
    haveI := hβi
    have Dαβ : wcEtPullData (α ≫ β) M := (wc_et_zmod_pull_data_exists (α ≫ β) M).some
    refine (hT i k _).mpr ⟨α ≫ β, inferInstance, ρα ≫ ρβ, Dαβ, ?_, ?_, ?_⟩
    · simp only [Category.assoc] at hα hβ ⊢
      rw [hβ, reassoc_of% hα]
    · rw [Category.assoc, hρβ, hρα]
    · refine AddMonoidHom.ext fun x => ?_
