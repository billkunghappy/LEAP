theorem wc_leray_ext_corner_card_ge : ∀ {C : Type*} {D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] [EnoughInjectives D] (L : D ⥤ C) (R : C ⥤ D) [R.Additive] (adj : L ⊣ R) [Limits.PreservesFiniteLimits L] (P : D) (A : C) (I : InjectiveResolution A) (N : ℕ), letI := HasExt.standard C; letI := HasExt.standard D; (∀ q : ℕ, 2 < q → Limits.IsZero (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q)) → (∀ p q : ℕ, q < 2 → N + 3 ≤ p + q → ∀ x : Abelian.Ext P (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) p, x = 0) → Finite (Abelian.Ext (L.obj P) A (N + 2)) → Finite (Abelian.Ext P (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 2) N) ∧ Nat.card (Abelian.Ext P (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 2) N) ≤ Nat.card (Abelian.Ext (L.obj P) A (N + 2)) :=
by
  intro C D _ _ _ _ _ L R _ adj _ P A I N hzero hlow hfin
  letI : HasExt C := HasExt.standard C
  letI : HasExt D := HasExt.standard D
  classical

  have s1 : ∀ (K : CochainComplex D ℕ) (j : ℕ), ∃ (B : D) (u : K.X j ⟶ B)
      (v : B ⟶ K.cycles (j + 1)) (h1 : K.iCycles j ≫ u = 0) (h2 : v ≫ K.homologyπ (j + 1) = 0),
      (ShortComplex.mk _ _ h1).ShortExact ∧ (ShortComplex.mk _ _ h2).ShortExact ∧
        u ≫ v ≫ K.iCycles (j + 1) = K.d j (j + 1) := by
    intro K j
    have hv : Limits.image.ι (K.d j (j + 1)) ≫ K.d (j + 1) (j + 1 + 1) = 0 := by
      rw [← cancel_epi (Limits.factorThruImage (K.d j (j + 1))), Limits.image.fac_assoc,
        K.d_comp_d, Limits.comp_zero]
    let v := K.liftCycles (Limits.image.ι (K.d j (j + 1))) (j + 1 + 1)
      (CochainComplex.next ℕ (j + 1)) hv
    have hvi : v ≫ K.iCycles (j + 1) = Limits.image.ι (K.d j (j + 1)) :=
      K.liftCycles_i _ _ _ _
    have huv : Limits.factorThruImage (K.d j (j + 1)) ≫ v = K.toCycles j (j + 1) := by
      rw [← cancel_mono (K.iCycles (j + 1)), Category.assoc, hvi, Limits.image.fac,
        K.toCycles_i]
    have h1 : K.iCycles j ≫ Limits.factorThruImage (K.d j (j + 1)) = 0 := by
      rw [← cancel_mono (Limits.image.ι (K.d j (j + 1))), Category.assoc, Limits.image.fac,
        Limits.zero_comp]
      exact K.iCycles_d j (j + 1)
    have h2 : v ≫ K.homologyπ (j + 1) = 0 := by
      rw [← cancel_epi (Limits.factorThruImage (K.d j (j + 1))), ← Category.assoc, huv,
        Limits.comp_zero]
      exact K.toCycles_comp_homologyπ j (j + 1)
    haveI : Mono v := mono_of_mono_fac hvi
    refine ⟨Limits.image (K.d j (j + 1)), Limits.factorThruImage (K.d j (j + 1)), v, h1, h2,
      ?_, ?_, ?_⟩
    · refine ShortComplex.ShortExact.mk' (ShortComplex.exact_of_f_is_kernel _
        (Limits.KernelFork.IsLimit.ofι _ _
          (fun g' hg' => K.liftCycles g' (j + 1) (CochainComplex.next ℕ j) (by
            rw [← Limits.image.fac (K.d j (j + 1)), ← Category.assoc,
              show g' ≫ Limits.factorThruImage (K.d j (j + 1)) = 0 from hg', Limits.zero_comp]))
          (fun g' hg' => K.liftCycles_i _ _ _ _)
          (fun g' hg' m hm => by
            rw [← cancel_mono (K.iCycles j), K.liftCycles_i]
            exact hm))) inferInstance inferInstance
    · have hprev : (ComplexShape.up ℕ).prev (j + 1) = j := by simp
      refine ShortComplex.ShortExact.mk' (ShortComplex.exact_of_g_is_cokernel _
        (Limits.CokernelCofork.IsColimit.ofπ _ _
          (fun g' hg' => (Limits.CokernelCofork.IsColimit.desc'
            (K.homologyIsCokernel j (j + 1) hprev) g' (by
              rw [← huv, Category.assoc, show v ≫ g' = 0 from hg', Limits.comp_zero])).1)
          (fun g' hg' => (Limits.CokernelCofork.IsColimit.desc'
            (K.homologyIsCokernel j (j + 1) hprev) g' (by
              rw [← huv, Category.assoc, show v ≫ g' = 0 from hg', Limits.comp_zero])).2)
          (fun g' hg' m hm => by
            rw [← cancel_epi (K.homologyπ (j + 1))]
            exact hm.trans (Limits.CokernelCofork.IsColimit.desc'
              (K.homologyIsCokernel j (j + 1) hprev) g' (by
                rw [← huv, Category.assoc, show v ≫ g' = 0 from hg', Limits.comp_zero])).2.symm)))
        inferInstance inferInstance
    · rw [hvi, Limits.image.fac]

  have core : ∀ (K : CochainComplex D ℕ), (∀ j, Injective (K.X j)) →
      (∀ q : ℕ, 2 < q → Limits.IsZero (K.homology q)) →
      (∀ p q : ℕ, q < 2 → N + 3 ≤ p + q → ∀ x : Abelian.Ext P (K.homology q) p, x = 0) →
      ∃ Φ : Abelian.Ext P (K.cycles (N + 1 + 1)) 0 →+ Abelian.Ext P (K.homology 2) N,
        Function.Surjective Φ ∧
        ∀ (c c' : P ⟶ K.X (N + 1 + 1)) (hc : c ≫ K.d (N + 1 + 1) (N + 1 + 1 + 1) = 0)
          (hc' : c' ≫ K.d (N + 1 + 1) (N + 1 + 1 + 1) = 0) (e : P ⟶ K.X (N + 1)),
          c - c' = e ≫ K.d (N + 1) (N + 1 + 1) →
          Φ (Abelian.Ext.mk₀ (K.liftCycles c (N + 1 + 1 + 1)
            (CochainComplex.next ℕ (N + 1 + 1)) hc)) =
          Φ (Abelian.Ext.mk₀ (K.liftCycles c' (N + 1 + 1 + 1)
            (CochainComplex.next ℕ (N + 1 + 1)) hc')) := by
    intro K hinj hzero hlow
    choose Bo u v h1 h2 hS1 hS2 hfac using s1 K

    have T1 : ∀ (b a : ℕ) (y : Abelian.Ext P (Bo b) (a + 1)),
        y.comp (hS1 b).extClass (rfl : a + 1 + 1 = a + 1 + 1) = 0 → y = 0 := by
      intro b a y hy
      haveI : Injective (ShortComplex.mk _ _ (h1 b)).X₂ := hinj b
      obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ P (hS1 b) y rfl hy
      rw [← hx₂, Abelian.Ext.eq_zero_of_injective x₂, Abelian.Ext.zero_comp]

    have hiso0 : IsIso (K.homologyπ 0) :=
      K.isIso_homologyπ 0 0 CochainComplex.prev_nat_zero (K.shape 0 0 (by simp))
    have hZ0 : ∀ x : Abelian.Ext P (K.cycles 0) (N + 1 + 1 + 1), x = 0 := by
      intro x
      have hl : (x.comp (Abelian.Ext.mk₀ (K.homologyπ 0)) (add_zero _)).comp
          (Abelian.Ext.mk₀ (inv (K.homologyπ 0))) (add_zero _) = x := by
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero _) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, IsIso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
      have h0 : x.comp (Abelian.Ext.mk₀ (K.homologyπ 0)) (add_zero _) = 0 :=
        hlow (N + 1 + 1 + 1) 0 (by omega) (by omega) _
      rw [← hl, h0, Abelian.Ext.zero_comp]
    have hZ1 : ∀ x : Abelian.Ext P (K.cycles 1) (N + 1 + 1), x = 0 := by
      intro x
      have h0 : x.comp (Abelian.Ext.mk₀ (K.homologyπ (0 + 1))) (add_zero _) = 0 :=
        hlow (N + 1 + 1) 1 (by omega) (by omega) _
      obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₂ P (hS2 0) x h0
      have hy0 : y = 0 := T1 0 (N + 1) y (hZ0 _)
      rw [← hy, hy0, Abelian.Ext.zero_comp]
    have hB1 : ∀ y : Abelian.Ext P (Bo 1) (N + 1), y = 0 := fun y => T1 1 N y (hZ1 _)

    have hπsurj : Function.Surjective
        ((Abelian.Ext.mk₀ (K.homologyπ 2)).postcomp P (add_zero N)) := by
      intro z
      have h0 : z.comp (hS2 1).extClass (rfl : N + 1 = N + 1) = 0 := hB1 _
      obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ P (hS2 1) z rfl h0
      exact ⟨x₂, hx₂⟩

    have step : ∀ b : ℕ, Limits.IsZero (K.homology (b + 1)) →
        ∃ S : ∀ a : ℕ, Abelian.Ext P (K.cycles (b + 1)) a →+ Abelian.Ext P (K.cycles b) (a + 1),
          (∀ a, Function.Surjective (S a)) ∧
            ∀ e : P ⟶ K.X b, S 0 (Abelian.Ext.mk₀ (e ≫ u b ≫ v b)) = 0 := by
      intro b hZ
      haveI : IsIso (v b) := (hS2 b).isIso_f_iff.mpr hZ
      refine ⟨fun a => ((hS1 b).extClass.postcomp P (rfl : a + 1 = a + 1)).comp
          ((Abelian.Ext.mk₀ (inv (v b))).postcomp P (add_zero a)), ?_, ?_⟩
      · intro a y
        have hy0 : y.comp (Abelian.Ext.mk₀ (K.iCycles b)) (add_zero _) = 0 := by
          haveI : Injective (K.X b) := hinj b
          exact Abelian.Ext.eq_zero_of_injective _
        obtain ⟨x₃, hx₃⟩ :=
          Abelian.Ext.covariant_sequence_exact₁ P (hS1 b) y hy0 (rfl : a + 1 = a + 1)
        refine ⟨x₃.comp (Abelian.Ext.mk₀ (v b)) (add_zero a), ?_⟩
        show ((x₃.comp (Abelian.Ext.mk₀ (v b)) (add_zero a)).comp
          (Abelian.Ext.mk₀ (inv (v b))) (add_zero a)).comp (hS1 b).extClass rfl = y
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero _) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, IsIso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
        exact hx₃
      · intro e
        show ((Abelian.Ext.mk₀ (e ≫ u b ≫ v b)).comp (Abelian.Ext.mk₀ (inv (v b)))
          (add_zero 0)).comp (hS1 b).extClass (rfl : 0 + 1 = 0 + 1) = 0
        have hk : (Abelian.Ext.mk₀ (u b)).comp (hS1 b).extClass (zero_add 1) = 0 :=
          (hS1 b).comp_extClass
        have he : (e ≫ u b ≫ v b) ≫ inv (v b) = e ≫ u b := by simp
        rw [Abelian.Ext.mk₀_comp_mk₀, he, ← Abelian.Ext.mk₀_comp_mk₀,
          Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add 1) (by omega), hk,
          Abelian.Ext.comp_zero]

    have hchain : ∀ j a d : ℕ, a + j = d →
        ∃ Ψ : Abelian.Ext P (K.cycles (j + 2)) a →+ Abelian.Ext P (K.cycles 2) d,
          Function.Surjective Ψ := by
      intro j
      induction j with
      | zero =>
        intro a d h
        obtain rfl : d = a := by omega
        exact ⟨AddMonoidHom.id _, Function.surjective_id⟩
