      rw [hv]; exact hgenpt
    obtain ⟨W, OY, εO, hvW, hWirr, hOY, hεO, hεc⟩ :=
      wc_r2gs_etale_chart_at_generic K B fB A₀.right _ hgen'
    refine ⟨A₀, s₀, wcEtOpen B A₀.right W, OY, εO,
      (F.obj.map (wcEtOpenι B A₀.right W).op).hom s₀, hA₀, hOY, hWirr, hεO, hεc, ?_⟩
    intro τ hτ
    have hpt : ∀ x y : Spec (.of (AlgebraicClosure (B.residueField η))), x = y :=
      fun x y => Subsingleton.elim x y
    have gen : ∀ (Y : Scheme.{u}) (W' : Y.Opens) (P : Scheme.{u}) (f : P ⟶ Y),
        (∀ p, f p ∈ (W' : Set Y)) → ∃ a : P ⟶ (W' : Scheme.{u}), a ≫ W'.ι = f := by
