  · exact AddMonoidHom.liftOfRightInverse_comp_apply E σ hσ ⟨ev.comp Ψ, hk⟩
      ⟨c, AddMonoidHom.mem_ker.mpr hc⟩

theorem wc_et_germ_zero_local : ∀ (B : Scheme.{u}) (b : B) (F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (s : F.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 B)))), wcEtGlobalGerm F b s = 0 → ∃ (W : B.Etale) (r : W ⟶ Scheme.Etale.mk (𝟙 B)) (w : W.left), W.hom w = b ∧ (F.obj.map r.op).hom s = 0 :=
by
  intro B b F s hs
  have hcof := wc_et_geomstalk_cofiltered B b wc_etale_maps_agree_near_geom_point
  obtain ⟨-, hinj, -⟩ := wc_et_stalk_germ_facts B b hcof F
  unfold wcEtGlobalGerm at hs
  let A₀ : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B) :=
    StructuredArrow.mk (Y := Scheme.Etale.mk (𝟙 B)) (Over.homMk (wcEtGeomPt B b) (by simp))
  obtain ⟨A'', f, f', hff⟩ := hinj A₀ A₀ s 0 (by rw [map_zero]; exact hs)
  refine ⟨A''.right, f.right, A''.hom.left (IsLocalRing.closedPoint _), ?_, ?_⟩
  · have hw := Over.w A''.hom
    change (A''.hom.left ≫ ((Scheme.Etale.forget B).obj A''.right).hom)
      (IsLocalRing.closedPoint _) = b
    rw [hw]
    simp only [Over.mk_hom, wcEtGeomPt]
    exact (Scheme.Hom.comp_apply _ _ _).trans (Scheme.fromSpecResidueField_apply _ _)
  · rw [hff, map_zero]

theorem wc_et_push_cycle_local_boundary : ∀ {X B : Scheme.{u}} (g : X ⟶ B) (I : CochainComplex (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) ℕ) (q : ℕ) (V W₁ : B.Etale) (r : W₁ ⟶ V) (κ : ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I).cycles q).obj.obj (Opposite.op V)) (c₁ : (I.X q).obj.obj (Opposite.op ((wcEtBaseChange g).obj V))), (((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I).homology q).obj.map r.op).hom ((((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I).homologyπ q).hom.app (Opposite.op V)).hom κ) = 0 → (((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I).iCycles q).hom.app (Opposite.op V)).hom κ = ((toSheafify (Scheme.smallEtaleTopology B) ((wcEtBaseChange g).op ⋙ (I.X q).obj)).app (Opposite.op V)).hom c₁ → ∀ w₁ : W₁.left, ∃ (W : B.Etale) (h : W ⟶ W₁) (w : W.left) (y : (I.X ((ComplexShape.up ℕ).prev q)).obj.obj (Opposite.op ((wcEtBaseChange g).obj W))), h.left w = w₁ ∧ ((I.d ((ComplexShape.up ℕ).prev q) q).hom.app (Opposite.op ((wcEtBaseChange g).obj W))).hom y = ((I.X q).obj.map ((wcEtBaseChange g).map (h ≫ r)).op).hom c₁ :=
by
  intro X B g I q V W₁ r κ c₁ hH1 hH2 w₁

  have hpt : ∀ {Z : Scheme.{u}} (T : Z.Etale) (S : Sieve T), S ∈ Scheme.smallEtaleTopology Z T →
      ∀ t : T.left, ∃ (T' : Z.Etale) (h : T' ⟶ T) (t' : T'.left), S.arrows h ∧ h.left t' = t := by
    intro Z T S hS t
    have hS' : S ∈ Scheme.smallGrothendieckTopology @Etale Z T := hS
    have hpt := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Z
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ T _).mp
      ((@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Z
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl) ▸ hS')
    obtain ⟨T', h, t', hmem, -, ht'⟩ := hpt t
    exact ⟨T', h, t', hmem, ht'⟩

  have hexl : ∀ {Z : Scheme.{u}}
      (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})), S.Exact →
      ∀ (T : Z.Etale) (b : S.X₂.obj.obj (Opposite.op T)), (S.g.hom.app (Opposite.op T)).hom b = 0 →
      ∀ t : T.left, ∃ (T' : Z.Etale) (h : T' ⟶ T) (t' : T'.left)
        (a : S.X₁.obj.obj (Opposite.op T')), h.left t' = t ∧
        (S.f.hom.app (Opposite.op T')).hom a = (S.X₂.obj.map h.op).hom b := by
    intro Z S hS T b hb t
    obtain ⟨κ', hκι, hκ⟩ : ∃ κ' : S.X₁ ⟶ Limits.kernel S.g,
        κ' ≫ Limits.kernel.ι S.g = S.f ∧ Epi κ' :=
      ⟨_, Limits.kernel.lift_ι _ _ _, S.exact_iff_epi_kernel_lift.mp hS⟩
    have hloc : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Z) κ'.hom :=
      (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} κ').mpr hκ
    let E := sheafToPresheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1} ⋙
      (evaluation _ _).obj (Opposite.op T)
    let y := (AddCommGrpCat.kernelIsoKer (S.g.hom.app (Opposite.op T))).inv.hom ⟨b, hb⟩
