    have htη' : Algebra.trdeg K (B.residueField (g ξ)) = dη := htη
    have hte' : Algebra.trdeg (B.residueField (g ξ)) (X.residueField ξ) = e := hte
    have h1 : Spec.preimage (X.fromSpecResidueField ξ ≫ g ≫ fB) =
        Spec.preimage (B.fromSpecResidueField (g ξ) ≫ fB) ≫ g.residueFieldMap ξ := by
      apply Spec.map_injective
      rw [Spec.map_preimage, Spec.map_comp, Spec.map_preimage,
        Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField_assoc]
    haveI hsc : IsScalarTower K (B.residueField (g ξ)) (X.residueField ξ) := by
      apply IsScalarTower.of_algebraMap_eq
      intro k
      show (Spec.preimage (X.fromSpecResidueField ξ ≫ g ≫ fB)).hom k =
        (g.residueFieldMap ξ).hom ((Spec.preimage (B.fromSpecResidueField (g ξ) ≫ fB)).hom k)
