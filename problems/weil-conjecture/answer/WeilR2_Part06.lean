        refine ⟨(Abelian.Ext.mk₀ (K.homologyπ 2)).postcomp P (add_zero 0), hπsurj, ?_⟩
        intro e
        show (Abelian.Ext.mk₀ (e ≫ u (0 + 1) ≫ v (0 + 1))).comp
          (Abelian.Ext.mk₀ (K.homologyπ 2)) (add_zero 0) = 0
        have hz : v (0 + 1) ≫ K.homologyπ 2 = 0 := h2 (0 + 1)
        rw [Abelian.Ext.mk₀_comp_mk₀, Category.assoc, Category.assoc, hz, Limits.comp_zero,
