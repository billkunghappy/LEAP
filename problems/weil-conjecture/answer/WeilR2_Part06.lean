theorem wc_zmodslice_proet_comparison (F : Type u) [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (n : ℕ) :
    ∃ Ψ : ∀ i : ℕ, wcZModSliceCoh F X h n i ≃+ wcZModProEtExt (wcGeomPoint F X h).left n i,
      ∀ (i j k : ℕ) (hk : i + j = k) (x : wcZModSliceCoh F X h n i) (y : wcZModSliceCoh F X h n j),
        Ψ k (wcZModSliceCup F X h n i j k hk x y) =
          wcZModProEtCup (wcGeomPoint F X h).left n i j k hk (Ψ i x) (Ψ j y) :=
by

  have hmem : ∀ (T : Scheme.{u}) (V : T.ProEt) (R : Sieve V),
      R ∈ Scheme.ProEt.topology T V ↔
        Sieve.functorPushforward (Scheme.ProEt.forget T ⋙ Over.forget T) R ∈
          Scheme.proetaleTopology V.left := by
    intro T V R
    letI := MorphismProperty.IsMultiplicative.toIsStableUnderComposition (W := @WeaklyEtale)
    have hT : Scheme.ProEt.topology T =
        (Scheme.ProEt.forget T).restrictedTopology (Scheme.proetaleTopology.over T) :=
      MorphismProperty.toGrothendieck_comap_forget_eq_restrictedTopology (S := T)
        (P := @WeaklyEtale) Scheme.proetalePrecoverage
        Scheme.proetalePrecoverage_le_precoverage_weaklyEtale
    rw [hT, Functor.mem_restrictedTopology_iff, GrothendieckTopology.mem_over_iff,
      Sieve.overEquiv_apply, ← Sieve.functorPushforward_comp]
    rfl

  have hequiv : ∀ (S : Scheme.{u}) (U : S.ProEt) (n : ℕ),
      ∃ E : SheafOfModules.{u+1} ((wcZModRingSheaf S n).over U) ≌
          SheafOfModules.{u+1} (wcZModRingSheaf U.left n),
        Nonempty (E.functor.obj (SheafOfModules.unit ((wcZModRingSheaf S n).over U)) ≅
          SheafOfModules.unit (wcZModRingSheaf U.left n)) := by
    intro S U n

    let εapp : ∀ V : Over U, (wcOverToSlice S U ⋙ wcSliceToOver S U).obj V ≅ V := fun V =>
      Over.isoMk (MorphismProperty.Over.isoMk (Iso.refl V.left.left)
          ((Category.id_comp _).trans (MorphismProperty.Over.w V.hom).symm))
        (MorphismProperty.Over.Hom.ext (Category.id_comp V.hom.left))
    let ε : wcOverToSlice S U ⋙ wcSliceToOver S U ≅ 𝟭 (Over U) :=
      NatIso.ofComponents εapp (fun {V V'} g => by
        apply Over.OverMorphism.ext
        apply MorphismProperty.Over.Hom.ext
        exact (Category.comp_id g.left.left).trans (Category.id_comp g.left.left).symm)

    have hmemD : ∀ (V : Over U) (R : Sieve V), R ∈ (Scheme.ProEt.topology S).over U V ↔
        Sieve.functorPushforward (Over.forget U ⋙ Scheme.ProEt.forget S ⋙ Over.forget S) R ∈
          Scheme.proetaleTopology V.left.left := by
      intro V R
      rw [GrothendieckTopology.mem_over_iff, Sieve.overEquiv_apply, hmem S V.left,
        ← Sieve.functorPushforward_comp]

    have hFc : (wcSliceToOver S U).IsCocontinuous (Scheme.ProEt.topology U.left)
        ((Scheme.ProEt.topology S).over U) := by
      constructor
      intro W T hT
      rw [hmem U.left W]
      rw [hmemD] at hT
      refine GrothendieckTopology.superset_covering _ ?_ hT
      rintro Z f ⟨V', t, a, ht, rfl⟩
      refine ⟨(wcOverToSlice S U).obj V', (wcOverToSlice S U).map t, a, ?_, rfl⟩
      show T.arrows ((wcSliceToOver S U).map ((wcOverToSlice S U).map t))
      have hft : (wcSliceToOver S U).map ((wcOverToSlice S U).map t) = (εapp V').hom ≫ t := by
        apply Over.OverMorphism.ext
        apply MorphismProperty.Over.Hom.ext
        exact (Category.id_comp t.left.left).symm
      exact (congrArg (fun g => T.arrows g) hft).mpr (T.downward_closed ht _)
    have hGc : (wcOverToSlice S U).IsCocontinuous ((Scheme.ProEt.topology S).over U)
        (Scheme.ProEt.topology U.left) := by
      constructor
      intro V T hT
      rw [hmemD]
      rw [hmem U.left] at hT
      refine GrothendieckTopology.superset_covering _ ?_ hT
      rintro Z f ⟨W', t, a, ht, rfl⟩
      refine ⟨(wcSliceToOver S U).obj W', (wcSliceToOver S U).map t ≫ (εapp V).hom, a, ?_, ?_⟩
      · show T.arrows ((wcOverToSlice S U).map ((wcSliceToOver S U).map t ≫ (εapp V).hom))
        have hgt : (wcOverToSlice S U).map ((wcSliceToOver S U).map t ≫ (εapp V).hom) = t := by
          apply MorphismProperty.Over.Hom.ext
          exact Category.comp_id t.left
        exact (congrArg (fun g => T.arrows g) hgt).mpr ht
      · exact (congrArg (a ≫ ·) (Category.comp_id t.left)).symm

    let eqv : U.left.ProEt ≌ Over U :=
      Equivalence.mk' (wcSliceToOver S U) (wcOverToSlice S U) (Iso.refl _) ε (fun W => by
        apply Over.OverMorphism.ext
        apply MorphismProperty.Over.Hom.ext
        exact Category.comp_id (𝟙 W.left))
    haveI : eqv.functor.IsCocontinuous (Scheme.ProEt.topology U.left)
        ((Scheme.ProEt.topology S).over U) := hFc
    haveI : eqv.inverse.IsCocontinuous ((Scheme.ProEt.topology S).over U)
        (Scheme.ProEt.topology U.left) := hGc
    haveI := Equivalence.isDenseSubsite_functor_of_isCocontinuous (Scheme.ProEt.topology U.left)
      ((Scheme.ProEt.topology S).over U) eqv
    haveI := Equivalence.isDenseSubsite_inverse_of_isCocontinuous (Scheme.ProEt.topology U.left)
      ((Scheme.ProEt.topology S).over U) eqv
    refine ⟨SheafOfModules.pushforwardPushforwardEquivalence eqv
      (S := wcZModRingSheaf U.left n) (R := (wcZModRingSheaf S n).over U) (𝟙 _) (𝟙 _) ?_ ?_,
      ⟨Iso.refl _⟩⟩
    · rfl
    · rfl

  obtain ⟨E, ⟨e⟩⟩ := hequiv X.left (wcGeomPoint F X h) n
  letI : HasExt (SheafOfModules.{u+1} (wcZModSliceRing F X h n)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf (wcGeomPoint F X h).left n)) :=
    HasExt.standard _
  haveI : E.functor.Additive := Functor.additive_of_preserves_binary_products _
  haveI : E.inverse.Additive := Functor.additive_of_preserves_binary_products _
  let adj : E.inverse ⊣ E.functor := E.symm.toAdjunction
  let θ : E.inverse.obj (SheafOfModules.unit (wcZModRingSheaf (wcGeomPoint F X h).left n)) ≅
      SheafOfModules.unit (wcZModSliceRing F X h n) :=
    E.fullyFaithfulFunctor.preimageIso
      (E.counitIso.app (SheafOfModules.unit (wcZModRingSheaf (wcGeomPoint F X h).left n)) ≪≫ e.symm)
  have hc : adj.unit.app (SheafOfModules.unit (wcZModRingSheaf (wcGeomPoint F X h).left n)) ≫
      E.functor.map θ.hom = e.inv := by
    have h1 : E.functor.map θ.hom =
        (E.counitIso.app (SheafOfModules.unit (wcZModRingSheaf (wcGeomPoint F X h).left n))).hom ≫
          e.inv :=
      E.fullyFaithfulFunctor.map_preimage _
    rw [h1]
    exact (E.counitIso.app _).inv_hom_id_assoc e.inv
  let P : ∀ i : ℕ, wcZModSliceCoh F X h n i ≃+
      Abelian.Ext (E.inverse.obj (SheafOfModules.unit (wcZModRingSheaf (wcGeomPoint F X h).left n)))
        (SheafOfModules.unit (wcZModSliceRing F X h n)) i := fun i =>
    { toFun := fun x => (Abelian.Ext.mk₀ θ.hom).comp x (zero_add i)
      invFun := fun y => (Abelian.Ext.mk₀ θ.inv).comp y (zero_add i)
      left_inv := fun x => by
        simp only
        rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
      right_inv := fun y => by
        simp only
        rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
      map_add' := fun x y => Abelian.Ext.comp_add _ _ _ _ }
  let Q : ∀ i : ℕ, Abelian.Ext (SheafOfModules.unit (wcZModRingSheaf (wcGeomPoint F X h).left n))
      (E.functor.obj (SheafOfModules.unit (wcZModSliceRing F X h n))) i ≃+
      wcZModProEtExt (wcGeomPoint F X h).left n i := fun i =>
    { toFun := fun y => y.comp (Abelian.Ext.mk₀ e.hom) (add_zero i)
      invFun := fun z => z.comp (Abelian.Ext.mk₀ e.inv) (add_zero i)
      left_inv := fun y => by
        simp only
        rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
          Abelian.Ext.comp_mk₀_id]
      right_inv := fun z => by
        simp only
        rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
          Abelian.Ext.comp_mk₀_id]
      map_add' := fun x y => Abelian.Ext.add_comp _ _ _ _ }
  let Ψ : ∀ i : ℕ, wcZModSliceCoh F X h n i ≃+ wcZModProEtExt (wcGeomPoint F X h).left n i :=
    fun i => (P i).trans ((adj.extEquiv (n := i)).trans (Q i))
  have hΨ : ∀ (i : ℕ) (x : wcZModSliceCoh F X h n i), Ψ i x =
      (Abelian.Ext.mk₀ e.inv).comp
        ((Abelian.Ext.mapExactFunctor E.functor x).comp (Abelian.Ext.mk₀ e.hom) (add_zero i))
        (zero_add i) := by
    intro i x
    show ((adj.extEquiv ((Abelian.Ext.mk₀ θ.hom).comp x (zero_add i))).comp
      (Abelian.Ext.mk₀ e.hom) (add_zero i)) = _
    rw [Adjunction.extEquiv_apply, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀_assoc, hc]
    exact Abelian.Ext.comp_assoc _ _ _ _ _ (show 0 + i + 0 = i by omega)
  refine ⟨Ψ, fun i j k hk x y => ?_⟩
  show Ψ k (x.comp y hk) = (Ψ i x).comp (Ψ j y) hk
  rw [hΨ, hΨ, hΨ, Abelian.Ext.mapExactFunctor_comp]
  conv_rhs =>
    rw [Abelian.Ext.comp_assoc _ _ _ (zero_add i) hk (show 0 + i + j = k by omega),
      Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id,
      Abelian.Ext.mk₀_id_comp, ← Abelian.Ext.comp_assoc_of_third_deg_zero]

theorem wc_proet_zmod_ring_locbij (Y : Scheme.{u}) (n : ℕ) (hn : 0 < n) :
    ∃ α : (Functor.const (Y.ProEt)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶ (wcZModRingSheaf Y n).obj,
      Presheaf.IsLocallyInjective (Scheme.ProEt.topology Y) α ∧
      Presheaf.IsLocallySurjective (Scheme.ProEt.topology Y) α ∧
      ∀ V, ((n : ℕ) : ↑((wcZModRingSheaf Y n).obj.obj V)) = 0 :=
by

  have s2 : ∀ (X : Scheme.{u}) (ι : Type) [Finite ι] (Z : ι → Scheme.{u}) (g : ∀ i, Z i ⟶ X),
      (∀ i, IsOpenImmersion (g i)) → (∀ i, IsClosed (Set.range (g i))) →
      (∀ x : X, ∃ i, x ∈ Set.range (g i)) →
      Presieve.ofArrows Z g ∈ Scheme.proetalePrecoverage.coverings X := by
    intro X ι _ Z g hO hclosed hcover
    refine ⟨?_, ?_⟩
    · rw [show Presieve.ofArrows Z g = (PreZeroHypercover.mk ι Z g).presieve₀ from rfl,
        Scheme.presieve₀_mem_qcPrecoverage_iff]
      constructor
      intro A hA
      have himg : ∀ k, (g k) '' ((g k ⁻¹ᵁ A : (Z k).Opens) : Set (Z k)) =
          (A : Set X) ∩ Set.range (g k) := by
        intro k
        rw [Scheme.Hom.coe_preimage, Set.image_preimage_eq_inter_range]
      refine IsCompactOpenCovered.of_finite id (fun k => g k ⁻¹ᵁ A) ?_ ?_
      · intro k
        have := hO k
        change IsCompact ((g k ⁻¹ᵁ A : (Z k).Opens) : Set (Z k))
        rw [(g k).isOpenEmbedding.isEmbedding.isCompact_iff, himg]
        exact hA.isCompact.inter_right (hclosed k)
      · apply Set.Subset.antisymm
        · intro x hx
          obtain ⟨k, hk⟩ := Set.mem_iUnion.mp hx
          change x ∈ (g k) '' ((g k ⁻¹ᵁ A : (Z k).Opens) : Set (Z k)) at hk
          rw [himg] at hk
          exact hk.1
        · intro x hx
          obtain ⟨i, hi⟩ := hcover x
          refine Set.mem_iUnion.mpr ⟨i, ?_⟩
          change x ∈ (g i) '' ((g i ⁻¹ᵁ A : (Z i).Opens) : Set (Z i))
          rw [himg]
          exact ⟨hx, hi⟩
    · exact (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale (f := g)).2
        ⟨hcover, fun i => by have := hO i; infer_instance⟩

  have s3 : ∀ (V : Y.ProEt) (ι : Type) (W : ι → Y.ProEt) (f : ∀ i, W i ⟶ V),
      Presieve.ofArrows (fun i => (W i).left) (fun i => (f i).left) ∈
        Scheme.proetalePrecoverage.coverings V.left →
      ∀ R : Sieve V, (∀ i, R.arrows (f i)) → R ∈ Scheme.ProEt.topology Y V := by
    intro V ι W f hcov R hR
    have hP : Presieve.ofArrows W f ∈ (Scheme.ProEt.precoverage Y).coverings V := by
      change Presieve.ofArrows W f ∈ (Precoverage.comap (Scheme.ProEt.forget Y ⋙ Over.forget Y)
        Scheme.proetalePrecoverage).coverings V
      rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
      exact hcov
    refine GrothendieckTopology.superset_covering _ ?_ (Precoverage.generate_mem_toGrothendieck hP)
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨i⟩
    exact hR i

  let c : ∀ V : (Y.ProEt)ᵒᵖ, ULift.{u+1} (ZMod n) →+* C(↥(V.unop.left), ULift.{u+1} (ZMod n)) :=
    fun V =>
      { toFun := fun a => ContinuousMap.const _ a
        map_one' := rfl, map_mul' := fun _ _ => rfl, map_zero' := rfl, map_add' := fun _ _ => rfl }
  let α : (Functor.const (Y.ProEt)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶
      (wcZModRingSheaf Y n).obj :=
    { app := fun V => RingCat.ofHom (c V)
      naturality := fun V V' h => by
        apply RingCat.hom_ext
        apply RingHom.ext
        intro a
        apply ContinuousMap.ext
        intro p
        rfl }
  refine ⟨α, ⟨?_⟩, ⟨?_⟩, ?_⟩
  ·
    intro V x y hxy
    rcases isEmpty_or_nonempty (V.unop.left) with hE | ⟨⟨p⟩⟩
    · let W : PEmpty.{1} → Y.ProEt := fun i => i.elim
      let f : ∀ i, W i ⟶ V.unop := fun i => i.elim
      exact s3 V.unop PEmpty W f
        (s2 _ PEmpty (fun i => (W i).left) (fun i => (f i).left) (fun i => i.elim)
          (fun i => i.elim) (fun x => isEmptyElim x)) _ (fun i => i.elim)
    · have hxy' : x = y :=
        congrArg (fun φ : C(↥V.unop.left, ULift.{u+1} (ZMod n)) => φ p) hxy
      subst hxy'
      exact GrothendieckTopology.superset_covering _ (fun W g _ => rfl)
        (GrothendieckTopology.top_mem _ _)
  ·
    intro V s
    have : NeZero n := NeZero.of_pos hn
    let s' : C(↥V.left, ULift.{u+1} (ZMod n)) := s
    let U : ZMod n → V.left.Opens := fun a =>
      ⟨s' ⁻¹' {ULift.up a}, (isOpen_discrete _).preimage s'.continuous⟩
    have := V.prop
    let W : ZMod n → Y.ProEt := fun a => Scheme.ProEt.mk ((U a).ι ≫ V.hom)
    let f : ∀ a, W a ⟶ V := fun a => MorphismProperty.Over.homMk (U a).ι rfl trivial
    apply s3 V (ZMod n) W f
    · apply s2 V.left (ZMod n) (fun a => (W a).left) (fun a => (f a).left)
      · intro a
        change IsOpenImmersion (U a).ι
        infer_instance
      · intro a
        change IsClosed (Set.range (U a).ι)
        rw [Scheme.Opens.range_ι]
        show IsClosed (s' ⁻¹' {ULift.up a})
        exact (isClosed_discrete _).preimage s'.continuous
      · intro x
        refine ⟨(s' x).down, ?_⟩
        change x ∈ Set.range (U (s' x).down).ι
        rw [Scheme.Opens.range_ι]
        exact (rfl : s' x = ULift.up (s' x).down)
    · intro a
      refine ⟨ULift.up a, ?_⟩
      change (ContinuousMap.const (↥(W a).left) (ULift.up a) : C(↥(W a).left, ULift.{u+1} (ZMod n))) =
        s'.comp (f a).left.base.hom
      refine ContinuousMap.ext (fun p => ?_)
      have hp : s' ((U a).ι (show ↥(U a) from p)) = ULift.up a := by
        rw [Scheme.Opens.ι_apply]
        exact (show ↥(U a) from p).2
      exact hp.symm
  ·
    intro V
    change ((n : ℕ) : C(↥(V.unop.left), ULift.{u+1} (ZMod n))) = 0
    ext p
    rw [ContinuousMap.natCast_apply, ← ULift.up_natCast, ZMod.natCast_self]
    rfl

theorem wc_zmod_mod_pullback (Y : Scheme.{u}) (n : ℕ) (hn : 0 < n) :
    ∃ N : SheafOfModules.{u+1} (wcEtZModRing Y n) ⥤ SheafOfModules.{u+1} (wcZModRingSheaf Y n),
      N.Additive ∧ Limits.PreservesFiniteLimits N ∧ Limits.PreservesFiniteColimits N ∧
      ∃ e : N.obj (SheafOfModules.unit (wcEtZModRing Y n)) ≅ SheafOfModules.unit (wcZModRingSheaf Y n),
        (∀ M : SheafOfModules.{u+1} (wcEtZModRing Y n),
          Function.Bijective (fun g : SheafOfModules.unit (wcEtZModRing Y n) ⟶ M => e.inv ≫ N.map g)) ∧
        ∀ M : SheafOfModules.{u+1} (wcEtZModRing Y n),
          Nonempty ((SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf Y n)).obj (N.obj M) ≅
            (wcEpsInv Y).obj ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).obj M)) :=
by
  classical

  have s1 : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
      (R : Sheaf J RingCat.{u+1}) (m : ℕ), (∀ V, ((m : ℕ) : ↑(R.obj.obj V)) = 0) →
      ∀ M : SheafOfModules.{u+1} R, m • 𝟙 ((SheafOfModules.toSheaf.{u+1} R).obj M) = 0 := by
    intro C _ J R m h M
    have key : ∀ (X : Cᵒᵖ) (x : M.val.obj X), m • x = 0 := fun X x => by
      rw [← Nat.cast_smul_eq_nsmul (R.obj.obj X), h X, zero_smul]
    apply (sheafToPresheaf J AddCommGrpCat.{u+1}).map_injective
    rw [Functor.map_nsmul, CategoryTheory.Functor.map_id, Functor.map_zero]
    ext X x
    simp only [NatTrans.app_nsmul, NatTrans.id_app, NatTrans.app_zero, AddCommGrpCat.hom_nsmul,
      AddCommGrpCat.hom_id, AddCommGrpCat.hom_zero, AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply,
      AddMonoidHom.zero_apply]
    exact key X x

  have s2 : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
      [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
      (R : Sheaf J RingCat.{u+1}) (m : ℕ)
      (α : (Functor.const Cᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod m))) ⟶ R.obj),
      Presheaf.IsLocallyInjective J α → Presheaf.IsLocallySurjective J α →
      Nonempty ((SheafOfModules.toSheaf.{u+1} R).obj (SheafOfModules.unit R) ≅
        (constantSheaf J AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) := by
    intro C _ J _ _ R m α hinj hsurj
    let P := ((SheafOfModules.toSheaf.{u+1} R).obj (SheafOfModules.unit R)).obj
    let α' : (Functor.const Cᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ⟶ P :=
      { app := fun X => AddCommGrpCat.ofHom (α.app X).hom.toAddMonoidHom
        naturality := fun X Y f => by
          ext t
          exact ConcreteCategory.congr_hom (α.naturality f) t }
    have hi : Presheaf.IsLocallyInjective J α' := by
      refine Presheaf.IsLocallyInjective.mk ?_
      intro X x y hxy
      exact hinj.equalizerSieve_mem x y hxy
    have hs : Presheaf.IsLocallySurjective J α' := by
      refine Presheaf.IsLocallySurjective.mk ?_
      intro U s
      exact hsurj.imageSieve_mem s
    have hW : J.W α' := (GrothendieckTopology.W_iff_isLocallyBijective J α').2 ⟨hi, hs⟩
    have : IsIso ((presheafToSheaf J AddCommGrpCat.{u+1}).map α') :=
      (GrothendieckTopology.W_iff J α').1 hW
    exact ⟨sheafificationIso _ ≪≫ (asIso ((presheafToSheaf J AddCommGrpCat.{u+1}).map α')).symm⟩

  obtain ⟨hlim, hcont⟩ := wc_etToProEt_flat_cont Y
  haveI := hlim
  haveI := hcont
  haveI hlan := wc_lan_preservesFiniteLimits (wcEtToProEt Y)
  let adj := Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt Y)
    AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)
  haveI hpl : Limits.PreservesFiniteLimits (wcEpsInv Y) := by
    haveI := Functor.sheafPullbackConstruction.preservesFiniteLimits (wcEtToProEt Y)
      AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)
    exact Limits.preservesFiniteLimits_of_natIso
      (Adjunction.leftAdjointUniq (Functor.sheafAdjunctionContinuous (wcEtToProEt Y)
        AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)) adj)
  haveI hladj : (wcEpsInv Y).IsLeftAdjoint := adj.isLeftAdjoint
  haveI hpc : Limits.PreservesFiniteColimits (wcEpsInv Y) := by
    haveI := adj.leftAdjoint_preservesColimits.{0, 0}
    exact Limits.PreservesColimitsOfSize.preservesFiniteColimits.{0, 0} _
  haveI : (wcEpsInv Y).PreservesZeroMorphisms :=
    Functor.preservesZeroMorphisms_of_isLeftAdjoint _
  haveI hadd : (wcEpsInv Y).Additive := Functor.additive_of_preserves_binary_products _
  have hunit := fun G => wc_epsInv_unit_iso Y G
  haveI : ∀ G, IsIso (adj.unit.app G) := hunit
  haveI : IsIso adj.unit := NatIso.isIso_of_isIso_app _
  let hεFF : (wcEpsInv Y).FullyFaithful := adj.fullyFaithfulLOfIsIsoUnit

  obtain ⟨αe, hαe1, hαe2, hαe3⟩ := wc_et_zmod_ring_locbij Y n
  obtain ⟨αp, hαp1, hαp2, hαp3⟩ := wc_proet_zmod_ring_locbij Y n hn
  obtain ⟨hFe, hEe⟩ := sheafOfModules_toSheaf_torsion_equiv (Scheme.smallEtaleTopology Y)
    (wcEtZModRing Y n) n αe hαe1 hαe2
  obtain ⟨hFp, hEp⟩ := sheafOfModules_toSheaf_torsion_equiv (Scheme.ProEt.topology Y)
    (wcZModRingSheaf Y n) n αp hαp1 hαp2
  haveI := hFe
  haveI := hFp
  haveI : Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)) :=
    sheafOfModules_toSheaf_preservesFiniteColimits _ _

  have hG : ∀ M : SheafOfModules.{u+1} (wcEtZModRing Y n),
      (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf Y n)).essImage
        ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n) ⋙ wcEpsInv Y).obj M) := by
    intro M
    apply hEp
    show n • 𝟙 ((wcEpsInv Y).obj ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).obj M)) = 0
    rw [← (wcEpsInv Y).map_id, ← (wcEpsInv Y).map_nsmul, s1 _ _ n hαe3 M, (wcEpsInv Y).map_zero]
  obtain ⟨N, ⟨θ⟩⟩ : ∃ N : SheafOfModules.{u+1} (wcEtZModRing Y n) ⥤
      SheafOfModules.{u+1} (wcZModRingSheaf Y n),
      Nonempty (N ⋙ SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf Y n) ≅
        SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n) ⋙ wcEpsInv Y) :=
    ⟨_, ⟨Functor.essImage.liftFunctorCompIso _ _ hG⟩⟩

  haveI : Limits.PreservesFiniteLimits (N ⋙ SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf Y n)) :=
    Limits.preservesFiniteLimits_of_natIso θ.symm
  haveI : Limits.PreservesFiniteColimits (N ⋙ SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf Y n)) :=
    Limits.preservesFiniteColimits_of_natIso θ.symm
  haveI hNl : Limits.PreservesFiniteLimits N :=
    Limits.preservesFiniteLimits_of_reflects_of_preserves N
      (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf Y n))
  haveI hNc : Limits.PreservesFiniteColimits N :=
    Limits.preservesFiniteColimits_of_reflects_of_preserves N
      (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf Y n))
  haveI : (N ⋙ SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf Y n)).Additive :=
    Functor.additive_of_iso θ.symm
  haveI hNa : N.Additive :=
    Functor.additive_of_comp_faithful N (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf Y n))

  let hUeFF := Functor.FullyFaithful.ofFullyFaithful
    (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n))
  let hNFF : N.FullyFaithful := ((hUeFF.comp hεFF).ofIso θ.symm).ofCompFaithful

  obtain ⟨κe⟩ := s2 (Scheme.smallEtaleTopology Y) (wcEtZModRing Y n) n αe hαe1 hαe2
  obtain ⟨κp⟩ := s2 (Scheme.ProEt.topology Y) (wcZModRingSheaf Y n) n αp hαp1 hαp2
  obtain ⟨ψ⟩ := wc_epsInv_const Y (AddCommGrpCat.of (ULift.{u+1} (ZMod n)))
  let e : N.obj (SheafOfModules.unit (wcEtZModRing Y n)) ≅
      SheafOfModules.unit (wcZModRingSheaf Y n) :=
    (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf Y n)).preimageIso
      (θ.app _ ≪≫ (wcEpsInv Y).mapIso κe ≪≫ ψ ≪≫ κp.symm)

  refine ⟨N, hNa, hNl, hNc, e, fun M => ?_, fun M => ⟨θ.app M⟩⟩
  have h1 := hNFF.map_bijective (SheafOfModules.unit (wcEtZModRing Y n)) M
  have h2 : Function.Bijective
      (fun h : N.obj (SheafOfModules.unit (wcEtZModRing Y n)) ⟶ N.obj M => e.inv ≫ h) := by
    refine Function.bijective_iff_has_inverse.mpr ⟨fun h' => e.hom ≫ h', fun h => ?_, fun h' => ?_⟩
    · exact Iso.hom_inv_id_assoc e h
    · exact Iso.inv_hom_id_assoc e h'
  exact h2.comp h1

theorem wc_zmod_proet_etale_mod_comparison (K : Type u) [Field K] (Y : Scheme.{u})
    (f : Y ⟶ Spec (.of K)) [IsProper f] (n : ℕ) (hn : 0 < n) :
    ∃ Ψ : ∀ i : ℕ, wcZModProEtExt Y n i ≃+ wcEtZModExt Y n i,
      ∀ (i j k : ℕ) (hk : i + j = k) (x : wcZModProEtExt Y n i) (y : wcZModProEtExt Y n j),
        Ψ k (wcZModProEtCup Y n i j k hk x y) = wcEtZModCup Y n i j k hk (Ψ i x) (Ψ j y) :=
by
  classical
  letI instEe : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y n)) := HasExt.standard _
  letI instEp : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf Y n)) := HasExt.standard _
  letI instEt : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _



  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace f
  haveI : IsSeparated (Limits.terminal.from Y) := by
    have e0 : Limits.terminal.from Y = f ≫ Limits.terminal.from (Spec (.of K)) :=
      Limits.terminal.hom_ext _ _
    rw [e0]; infer_instance
  obtain ⟨hlim, hcont⟩ := wc_etToProEt_flat_cont Y
  haveI := hlim
  haveI := hcont
  haveI hlan := wc_lan_preservesFiniteLimits (wcEtToProEt Y)
  let adj := Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt Y)
    AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)
  haveI hpl : Limits.PreservesFiniteLimits (wcEpsInv Y) := by
    haveI := Functor.sheafPullbackConstruction.preservesFiniteLimits (wcEtToProEt Y)
      AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)
    exact Limits.preservesFiniteLimits_of_natIso
      (Adjunction.leftAdjointUniq (Functor.sheafAdjunctionContinuous (wcEtToProEt Y)
        AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)) adj)
  haveI hladj : (wcEpsInv Y).IsLeftAdjoint := adj.isLeftAdjoint
  haveI hpc : Limits.PreservesFiniteColimits (wcEpsInv Y) := by
    haveI := adj.leftAdjoint_preservesColimits.{0, 0}
