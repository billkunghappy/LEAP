    have N2 : wcR2gsConstRes U' (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ≫ τ.app ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) =
        wcR2gsConstRes (MorphismProperty.Over.mk ⊤ h.left hk : U.left.Etale) (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ≫ ((wcEtSlice (MorphismProperty.Over.mk ⊤ h.left hk : U.left.Etale)).sheafPushforwardContinuous AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology (MorphismProperty.Over.mk ⊤ h.left hk : U.left.Etale).left) (Scheme.smallEtaleTopology U.left)).map (wcR2gsConstRes U (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) := by
