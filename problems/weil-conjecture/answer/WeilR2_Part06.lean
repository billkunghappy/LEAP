    ⟨fun n => (AddEquiv.ofBijective (Φ n) (hΦb n)).symm.toAddMonoidHom.comp (Ψ n),
      fun n a => AddEquiv.ofBijective_apply_symm_apply (Φ n) (hΦb n)⟩

  have K1 : ∀ n (y : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) (wcIntSheaf X.left ℓ) n),
      AQ n (y.comp (Abelian.Ext.mk₀ (wcIntToLadic X.left ℓ)) (add_zero n)) =
        (AZ n y).comp (Abelian.Ext.mk₀ (((Scheme.ProEt.topology X.left).overPullback
