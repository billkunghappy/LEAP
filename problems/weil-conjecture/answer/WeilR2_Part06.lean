theorem wc_et_zmod_ext_modell_unit_vanish : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsProper f] (d : ℕ) [SmoothOfRelativeDimension d f] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (m : ℕ), 1 ≤ m → ∀ y : @Abelian.Ext (SheafOfModules.{u+1} (wcEtZModRing Y (ℓ ^ m))) _ _ (HasExt.standard _) (Limits.cokernel ((ℓ ^ 1) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))))) (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))) (2 * d + 1), y = 0 :=
by
  intro K _ _ Y f _ d _ ℓ _ hℓ m hm y
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  have hℓpos : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos
  obtain ⟨α, _, _, hR⟩ := wc_et_zmod_ring_locbij Y ℓ

  have T : ∀ N : SheafOfModules.{u+1} (wcEtZModRing Y ℓ), ℓ • 𝟙 N = 0 := by
    intro N
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro V
    ext s
    have h0 : ((0 : N ⟶ N).val.app V).hom s = 0 := by
      first
        | rfl
        | simp
        | (rw [SheafOfModules.zero_val]; rfl)
    have hz : ∀ k : ℕ, ((k • 𝟙 N).val.app V).hom s = k • s := by
      intro k
      induction k with
      | zero => rw [zero_nsmul, zero_nsmul]; exact h0
      | succ k ih =>
        rw [succ_nsmul, SheafOfModules.add_val, PresheafOfModules.add_app, ModuleCat.hom_add,
          LinearMap.add_apply, ih, succ_nsmul]
        rfl
    rw [hz, ← Nat.cast_smul_eq_nsmul (R := ↑((wcEtZModRing Y ℓ).obj.obj V)), hR V,
      zero_smul, h0]

  have htor : ℓ • 𝟙 ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj
      (SheafOfModules.unit (wcEtZModRing Y ℓ))) = 0 := by
    rw [← (SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).map_id, ← Functor.map_nsmul, T,
      Functor.map_zero]

  obtain ⟨E1⟩ := wc_et_zmod_modell_unit_ext_equiv Y ℓ m hm (2 * d + 1)
