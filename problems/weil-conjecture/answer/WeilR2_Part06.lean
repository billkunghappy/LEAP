  obtain ⟨B'', π, Z'', iZ, e, hπ, hiZ, he, hrange, heπ, hB''irr, hB''le, hZ''⟩ :=
    wc_r2gc_cover_of_finite_chart K B fB n hB V OY hOY hVirr εO hεO hεc
  haveI := hπ
  haveI := hiZ
  haveI := he
