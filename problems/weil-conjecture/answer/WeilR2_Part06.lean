      let C : Set ↥S := Subtype.val ⁻¹' Wᶜ
      have hC : IsClosed C := hWo.isClosed_compl.preimage continuous_subtype_val
      have hdense : Dense Cᶜ := hC.isOpen_compl.dense ⟨⟨η, subset_closure rfl⟩, fun h => h hηW⟩
      have hS : topologicalKrullDim ↥S ≤ ((k + 1 : ℕ) : WithBot ℕ∞) :=
