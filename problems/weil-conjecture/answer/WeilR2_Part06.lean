    have N1 : a U' ≫ ((wcEtSlice U').sheafPushforwardContinuous AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology U'.left) (Scheme.smallEtaleTopology X)).map ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map (Functor.whiskerRight (yoneda.map h) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) ≫ τ.app ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) =
        wcR2gsConstRes (MorphismProperty.Over.mk ⊤ h.left hk : U.left.Etale) (AddCommGrpCat.of (ULift.{u+1} ℤ)) ≫ ((wcEtSlice (MorphismProperty.Over.mk ⊤ h.left hk : U.left.Etale)).sheafPushforwardContinuous AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology (MorphismProperty.Over.mk ⊤ h.left hk : U.left.Etale).left) (Scheme.smallEtaleTopology U.left)).map (a U) := by
      refine hcext (Y := U'.left) _ _ _ _ (fun V x => ?_)
      rw [hcst V x, map_zsmul, map_zsmul]
