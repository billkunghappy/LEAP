  obtain ⟨dξ, hdξ, htξ⟩ := wc_gpd_point_closure_dim_trdeg K X (g ≫ fB) ξ
  obtain ⟨dη, hdη, htη⟩ := wc_gpd_point_closure_dim_trdeg K B fB (g ξ)
  obtain ⟨e, hde, hte⟩ := wc_gpd_fibre_closure_dim_trdeg X B g ξ

  have htower : dη + e = dξ := by
    letI iA : Algebra K (B.residueField (g ξ)) :=
      (Spec.preimage (B.fromSpecResidueField (g ξ) ≫ fB)).hom.toAlgebra
    letI iB : Algebra K (X.residueField ξ) :=
      (Spec.preimage (X.fromSpecResidueField ξ ≫ g ≫ fB)).hom.toAlgebra
    letI iC : Algebra (B.residueField (g ξ)) (X.residueField ξ) :=
      (g.residueFieldMap ξ).hom.toAlgebra
