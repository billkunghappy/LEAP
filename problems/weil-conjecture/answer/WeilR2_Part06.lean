by
  intro K _ _ X B fB _ g _ M hM hMK hfib I η
  have hPBC := wc_et_henselian_proper_vanishing
  obtain ⟨μ, hfin, hzero, hinj, hsurj, hnat⟩ :=
    wc_r2gi_curve_h2_basis_pow K (AlgebraicClosure (B.residueField η))
      (wcEtGeomPt B η ≫ fB) (Limits.pullback g (wcEtGeomPt B η))
      (Limits.pullback.snd g (wcEtGeomPt B η)) M hM hMK
