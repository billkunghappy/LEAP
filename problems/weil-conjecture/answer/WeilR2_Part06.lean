    rw [← CategoryTheory.Functor.map_id, ← CategoryTheory.Functor.map_nsmul, hPre,
      CategoryTheory.Functor.map_zero]
  have hGt : ℓ • 𝟙 ((wcEtPush π).obj (wcEtExtZero B'' (Set.range iZ)ᶜ ℓ)) = 0 := by
    rw [← CategoryTheory.Functor.map_id, ← CategoryTheory.Functor.map_nsmul, hJt,
      CategoryTheory.Functor.map_zero]
  have hKt : ℓ • 𝟙 (Limits.kernel φ) = 0 := by
    have h : (ℓ • 𝟙 (Limits.kernel φ)) ≫ Limits.kernel.ι φ = 0 ≫ Limits.kernel.ι φ := by
      rw [Preadditive.nsmul_comp, Category.id_comp, Limits.zero_comp,
        ← Category.comp_id (Limits.kernel.ι φ), ← Preadditive.comp_nsmul, hGt, Limits.comp_zero]
    exact (cancel_mono _).mp h
  have hker := wc_et_cd_proper_torsion K B fB n hB ℓ hℓK (Limits.kernel φ) hKt (2 * n + 1)
    (by omega)

  have hCt : ℓ • 𝟙 (Limits.cokernel φ) = 0 := by
    have h : Limits.cokernel.π φ ≫ (ℓ • 𝟙 (Limits.cokernel φ)) = Limits.cokernel.π φ ≫ 0 := by
      rw [Preadditive.comp_nsmul, Category.comp_id, Limits.comp_zero,
        ← Category.id_comp (Limits.cokernel.π φ), ← Preadditive.nsmul_comp, hFt, Limits.zero_comp]
    exact (cancel_epi _).mp h
  have hcoker := wc_et_low_support_coh_vanish K B fB T hTc n hTd ℓ hℓK (Limits.cokernel φ) hCt
    hstalk (2 * n) (by omega)

  obtain ⟨hFfin, hFcard⟩ := wc_ext_card_le_of_coker_vanish
    ((constantSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ)))
    ((wcEtPush π).obj (wcEtExtZero B'' (Set.range iZ)ᶜ ℓ))
    ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 2)
    φ (2 * n) hker hcoker hGfin
  exact ⟨hFfin, hFcard.trans hGcard⟩

theorem wc_et_top_coh_step : ∀ (n : ℕ),
    (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : Scheme.{u}) (w : W ⟶ Spec (.of Ω))
      [IsProper w] [IrreducibleSpace W], topologicalKrullDim W ≤ (n : WithBot ℕ∞) →
      ∀ (ℓ : ℕ), ℓ.Prime → (ℓ : Ω) ≠ 0 →
        Finite (wcEtCoh W ℓ (2 * n)) ∧ Nat.card (wcEtCoh W ℓ (2 * n)) ≤ ℓ) →
    ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of Ω))
      [IsProper f] [IrreducibleSpace Y], topologicalKrullDim Y ≤ ((n + 1 : ℕ) : WithBot ℕ∞) →
      ∀ (ℓ : ℕ), ℓ.Prime → (ℓ : Ω) ≠ 0 →
        Finite (wcEtCoh Y ℓ (2 * (n + 1))) ∧ Nat.card (wcEtCoh Y ℓ (2 * (n + 1))) ≤ ℓ :=
by
  intro n IH Ω _ _ Y f _ _ hdim ℓ hℓ hℓΩ
  classical

  have hM : ∀ (S : Scheme.{u}), (ℓ : ℤ) • 𝟙 ((constantSheaf (Scheme.smallEtaleTopology S)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) = 0 := by
    intro S
    have h0 : (ℓ : ℤ) • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))) = 0 := by
      ext x
      simp
    rw [← CategoryTheory.Functor.map_id (constantSheaf (Scheme.smallEtaleTopology S)
      AddCommGrpCat.{u+1}), ← CategoryTheory.Functor.map_zsmul, h0,
      CategoryTheory.Functor.map_zero]
  have hMn : ∀ (S : Scheme.{u}), ℓ • 𝟙 ((constantSheaf (Scheme.smallEtaleTopology S)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) = 0 := by
    intro S
    rw [← natCast_zsmul]
    exact hM S

  have hcd : ∀ (S : Scheme.{u}) (fS : S ⟶ Spec (.of Ω)) [IsProper fS],
      topologicalKrullDim S ≤ (n : WithBot ℕ∞) → ∀ q : ℕ, 2 * n < q →
        Subsingleton (wcEtCoh S ℓ q) := by
    intro S fS _ hS q hq
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) := HasExt.standard _
    have h := wc_et_cd_proper_torsion Ω S fS n hS ℓ hℓΩ _ (hMn S) q hq
    show Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology S)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ((constantSheaf
        (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) q)
    exact ⟨fun a b => (h a).trans (h b).symm⟩
  rw [show 2 * (n + 1) = 2 * n + 2 by ring]

  by_cases hY : topologicalKrullDim Y ≤ (n : WithBot ℕ∞)
  · haveI := hcd Y f hY (2 * n + 2) (by omega)
    refine ⟨inferInstance, ?_⟩
    exact (Finite.card_le_one_iff_subsingleton.mpr this).trans hℓ.one_lt.le

  obtain ⟨X', b, Z, iZ, B, fB, g, hb, hiZ, hfB, hg, hiso, hB, hZ, hE, hfib⟩ :=
    wc_proper_curve_fibration_cover Ω Y f n hdim
  haveI := hb
  haveI := hiZ
  haveI := hfB
  haveI := hg
  have hT : Set.range iZ ≠ Set.univ := by
    intro hT
    apply hY
    have hsurj : Function.Surjective iZ := fun y => by
      have hy : y ∈ Set.range iZ := hT ▸ Set.mem_univ y
      exact hy
    have hh : IsHomeomorph iZ := isHomeomorph_iff_isEmbedding_surjective.mpr
      ⟨iZ.isClosedEmbedding.isEmbedding, hsurj⟩
    rw [← IsHomeomorph.topologicalKrullDim_eq _ hh]
    exact hZ

  have h5 := wc_et_abstract_blowup_card_le Y X' Z b iZ hiso ℓ hℓ.ne_zero (2 * n + 2)
    (wc_etale_proper_finite Ω X' (b ≫ f) ℓ hℓΩ _)
    (hcd Z (iZ ≫ f) hZ _ (by omega))
    (fun q' hq' => hcd (Limits.pullback b iZ) (Limits.pullback.snd b iZ ≫ iZ ≫ f) hE q'
      (by omega))
  obtain ⟨h5fin, h5card⟩ := h5

  haveI := wc_et_enough_injectives X'
  haveI := wc_et_enough_injectives B
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}) := HasExt.standard _
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) := HasExt.standard _

  have htors : ∀ (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology X')
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) (q' : ℕ),
      (ℓ : ℤ) • 𝟙 ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj
        I.cocomplex).homology q') = 0 := by
    intro I q'
    have h1 : I.ι ≫ ((ℓ : ℤ) • 𝟙 I.cocomplex) =
        (CochainComplex.single₀ _).map ((ℓ : ℤ) • 𝟙 _) ≫ I.ι := by
      rw [CategoryTheory.Functor.map_zsmul, CategoryTheory.Functor.map_id, Preadditive.zsmul_comp,
        Category.id_comp, Preadditive.comp_zsmul, Category.comp_id]
    have h2 : I.ι ≫ (0 : I.cocomplex ⟶ I.cocomplex) =
        (CochainComplex.single₀ _).map ((ℓ : ℤ) • 𝟙 _) ≫ I.ι := by
      rw [hM X', CategoryTheory.Functor.map_zero, Limits.comp_zero, Limits.zero_comp]
    have ho := (wcEtPush g).mapHomotopy (InjectiveResolution.descHomotopy _ _ _ h1 h2)
    have e1 := Homotopy.homologyMap_eq ho q'
    rw [CategoryTheory.Functor.map_zsmul, CategoryTheory.Functor.map_id,
      CategoryTheory.Functor.map_zero, HomologicalComplex.homologyMap_zero] at e1
    have e2 : HomologicalComplex.homologyMap ((ℓ : ℤ) • 𝟙 (((wcEtPush g).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj I.cocomplex)) q' = (ℓ : ℤ) • 𝟙 _ := by
      rw [← HomologicalComplex.homologyFunctor_map, CategoryTheory.Functor.map_zsmul,
        CategoryTheory.Functor.map_id]
      rfl
    rw [← e2]
    exact e1
  let I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology X')
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) := injectiveResolution _
  obtain ⟨L, ⟨adj⟩, hPFL, ⟨e⟩⟩ := wc_et_push_left_adjoint g
  haveI := hPFL
  have hstalk := wc_et_proper_stalk_coh g ℓ hℓ.ne_zero wc_et_henselian_proper_vanishing I

  have hzero : ∀ q' : ℕ, 2 < q' → Limits.IsZero
      ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q') := by
    intro q' hq'
    apply wc_et_stalks_zero
    intro b'
    obtain ⟨eb⟩ := hstalk b' q'
    have hΩ : ((ℓ : ℕ) : AlgebraicClosure (B.residueField b')) ≠ 0 := by
      intro h
      apply hℓΩ
      have hinj := (Spec.preimage (wcEtGeomPt B b' ≫ fB)).hom.injective
      apply hinj
      rw [map_natCast, map_zero]
      exact h
    haveI := wc_et_proper_curve_vanishing (AlgebraicClosure (B.residueField b'))
      (Limits.pullback g (wcEtGeomPt B b')) (Limits.pullback.snd g (wcEtGeomPt B b')) ℓ hℓ hΩ
      (hfib _ (wcEtGeomPt B b')) q' hq'
    exact eb.subsingleton

  have hEB : ∀ p q' : ℕ, q' ≠ 2 → 2 * n + 2 ≤ p + q' → ∀ x : Abelian.Ext
      ((constantSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q')
        p, x = 0 := by
    intro p q' hq2 hpq x
    by_cases h2 : 2 < q'
    · have hz := hzero q' h2
      calc x = x.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero p) := (Abelian.Ext.comp_mk₀_id x).symm
        _ = x.comp (Abelian.Ext.mk₀ 0) (add_zero p) := by rw [hz.eq_of_src (𝟙 _) 0]
        _ = 0 := by rw [Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    · have htN : ℓ • 𝟙 ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj
          I.cocomplex).homology q') = 0 := by
        rw [← natCast_zsmul]
        exact htors I q'
      exact wc_et_cd_proper_torsion Ω B fB n hB ℓ hℓΩ _ htN p (by omega) x

  have hTc : IsOpen (Set.range iZ)ᶜ := iZ.isClosedEmbedding.isClosed_range.isOpen_compl
  let UY : Y.Opens := ⟨(Set.range iZ)ᶜ, hTc⟩
  let U : X'.Opens := b ⁻¹ᵁ UY
  haveI hbU : IsIso (b ∣_ UY) := hiso UY rfl
  have hUYirr : IsIrreducible (UY : Set Y) :=
    ⟨Set.nonempty_compl.mpr hT, (IrreducibleSpace.isIrreducible_univ Y).isPreirreducible.open_subset
      hTc (Set.subset_univ _)⟩
  have hUYsp : IrreducibleSpace ↥UY := Subtype.irreducibleSpace hUYirr
  have hUirr : IrreducibleSpace ↥U := by
    have h := Scheme.homeoOfIso (asIso (b ∣_ UY))
    haveI : IrreducibleSpace ↥(UY : Scheme.{u}) := hUYsp
    exact Function.Surjective.irreducibleSpace h.symm.continuous h.symm.surjective
  have hUc_eq : ((U : Set X'))ᶜ = Set.range (Limits.pullback.fst b iZ) := by
    rw [Scheme.Pullback.range_fst]
    show (b ⁻¹' (Set.range iZ)ᶜ)ᶜ = b ⁻¹' Set.range iZ
    rw [Set.preimage_compl, compl_compl]
  have hUc : topologicalKrullDim ↥((U : Set X')ᶜ) ≤ (n : WithBot ℕ∞) := by
    rw [hUc_eq]
    have hφ := (Limits.pullback.fst b iZ).isClosedEmbedding.isEmbedding.toHomeomorph
    rw [← IsHomeomorph.topologicalKrullDim_eq _ hφ.isHomeomorph]
    exact hE

  obtain ⟨h8fin, h8card⟩ := wc_et_fibration_base_top_card_le Ω X' B fB g ℓ hℓ hℓΩ n hB hfib
    ⟨U, hUirr, hUc⟩ wc_et_curve_top_coh_card_le IH I

  obtain ⟨h6fin, h6card⟩ := wc_leray_ext_corner_card L (wcEtPush g) adj
    ((constantSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) _ I (2 * n) hEB h8fin
  haveI := h6fin

  have hinj : Function.Injective (fun z : Abelian.Ext ((constantSheaf
      (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      ((constantSheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) (2 * n + 2) =>
      (Abelian.Ext.mk₀ e.hom).comp z (zero_add (2 * n + 2))) := by
    intro z₁ z₂ h
    have h' := congrArg (fun w => (Abelian.Ext.mk₀ e.inv).comp w (zero_add (2 * n + 2))) h
    simpa only [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp] using h'
  have hX' : Nat.card (wcEtCoh X' ℓ (2 * n + 2)) ≤ Nat.card (Abelian.Ext (L.obj
      ((constantSheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))))
      ((constantSheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) (2 * n + 2)) :=
    Nat.card_le_card_of_injective _ hinj

  refine ⟨h5fin, ?_⟩
  calc Nat.card (wcEtCoh Y ℓ (2 * n + 2)) ≤ Nat.card (wcEtCoh X' ℓ (2 * n + 2)) := h5card
    _ ≤ _ := hX'
    _ ≤ _ := h6card
    _ ≤ ℓ := h8card

theorem wc_et_top_coh_card_le : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u})
    (f : Y ⟶ Spec (.of K)) [IsProper f] (d : ℕ) [SmoothOfRelativeDimension d f]
    [IrreducibleSpace Y] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 →
    Finite (wcEtCoh Y ℓ (2 * d)) ∧ Nat.card (wcEtCoh Y ℓ (2 * d)) ≤ ℓ :=
by
  intro K _ _ Y f _ d _ _ ℓ hℓ hℓK
  have P : ∀ n : ℕ, ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : Scheme.{u})
      (w : W ⟶ Spec (.of Ω)) [IsProper w] [IrreducibleSpace W],
      topologicalKrullDim W ≤ (n : WithBot ℕ∞) → ∀ (ℓ : ℕ), ℓ.Prime → (ℓ : Ω) ≠ 0 →
        Finite (wcEtCoh W ℓ (2 * n)) ∧ Nat.card (wcEtCoh W ℓ (2 * n)) ≤ ℓ := by
    intro n
    induction n with
    | zero =>
      intro Ω _ _ W w _ _ _ ℓ' hℓ' _
      exact wc_et_coh_zero_irreducible_card_le W ℓ' hℓ'.ne_zero
    | succ n ih => exact wc_et_top_coh_step n ih
  exact P d K Y f (wc_smooth_alg_closed_dim_le K Y f d) ℓ hℓ.out hℓK

theorem wc_top_coh_trace_injective (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))) :
    ∃ η : wcCoh F X h ℓ (2 * d) →+ ℚ_[ℓ],
      (∀ (c : ℚ_[ℓ]) (x : wcCoh F X h ℓ (2 * d)),
        η (wcCohScalar F X h ℓ (2 * d) c x) = c * η x) ∧
      Function.Injective η :=
by
  classical



  have hG : Finite (Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
        (Limits.cokernel (wcIntScalar X.left ℓ (ℓ : ℤ_[ℓ]))) (2 * d)) ∧
      Nat.card (Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
        (Limits.cokernel (wcIntScalar X.left ℓ (ℓ : ℤ_[ℓ]))) (2 * d)) ≤ ℓ := by
    have e0 := wc_int_coker_zmod X.left ℓ 1 (ℓ : ℤ_[ℓ]) (pow_one _).symm
    rw [pow_one] at e0
    obtain ⟨e⟩ := e0
    let E₁ : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
        (Limits.cokernel (wcIntScalar X.left ℓ (ℓ : ℤ_[ℓ]))) (2 * d) ≃
        Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) (wcZModSheaf X.left ℓ) (2 * d) :=
      { toFun := fun x => x.comp (Abelian.Ext.mk₀ e.hom) (add_zero (2 * d))
        invFun := fun y => y.comp (Abelian.Ext.mk₀ e.inv) (add_zero (2 * d))
        left_inv := fun x => by
          simp only
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero (2 * d)) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
        right_inv := fun y => by
          simp only
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero (2 * d)) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id] }
    obtain ⟨E₂⟩ := wc_ext_free_slice_zmod X.left (wcGeomPoint F X h) ℓ (2 * d)
    let fY : (wcGeomPoint F X h).left ⟶ Spec (.of (AlgebraicClosure F)) :=
      Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
    haveI hprop : IsProper fY :=
      (show IsProper (Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) :
          (wcGeomPoint F X h).left ⟶ Spec (.of (AlgebraicClosure F))) from inferInstance)
    haveI hsmooth : SmoothOfRelativeDimension d fY :=
      MorphismProperty.IsStableUnderBaseChange.of_isPullback (P := @SmoothOfRelativeDimension d)
        (IsPullback.of_hasPullback X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) ‹_›
    haveI hirr : IrreducibleSpace (wcGeomPoint F X h).left :=
      GeometricallyIrreducible.geometrically_irreducibleSpace (f := X.hom)
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
        (Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
        (Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
        (IsPullback.of_hasPullback _ _)
    obtain ⟨E₃⟩ := wc_proet_etale_comparison_zmod (AlgebraicClosure F) (wcGeomPoint F X h).left
      fY ℓ (2 * d)
    have hne : (ℓ : AlgebraicClosure F) ≠ 0 := by
      intro h0
      have hp : ringChar F ∣ ℓ :=
        (CharP.cast_eq_zero_iff (AlgebraicClosure F) (ringChar F) ℓ).mp h0
      have hpp : Nat.Prime (ringChar F) := CharP.char_is_prime F (ringChar F)
      have hpl : ringChar F = ℓ := (Nat.prime_dvd_prime_iff_eq hpp (Fact.out)).mp hp
      letI := Fintype.ofFinite F
      have hc : ((Nat.card F : ℕ) : F) = 0 := by
        rw [Nat.card_eq_fintype_card]; exact FiniteField.cast_card_eq_zero F
      have hdvd : ringChar F ∣ Nat.card F := (ringChar.spec F _).mp hc
      exact hℓ (hpl ▸ hdvd)
    obtain ⟨hfin, hcard⟩ := wc_et_top_coh_card_le (AlgebraicClosure F) (wcGeomPoint F X h).left
      fY d ℓ hne
    let E := E₁.trans (E₂.trans E₃)
    haveI := hfin
    refine ⟨Finite.of_equiv _ E.symm, ?_⟩
    rw [Nat.card_congr E]
    exact hcard
  generalize 2 * d = i at hG ⊢
  obtain ⟨hGfin, hGcard⟩ := hG
  haveI := hGfin



  have s4 : ∀ (R : Type) [Ring R] (G : Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1})
      (s : R → (G ⟶ G)), s 1 = 𝟙 G → (∀ a b, s (a * b) = s b ≫ s a) →
      (∀ a b, s (a + b) = s a + s b) →
      (∀ x : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) G i,
          x.comp (Abelian.Ext.mk₀ (s 1)) (add_zero i) = x) ∧
      (∀ a b (x : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) G i),
          x.comp (Abelian.Ext.mk₀ (s (a * b))) (add_zero i) =
          (x.comp (Abelian.Ext.mk₀ (s b)) (add_zero i)).comp (Abelian.Ext.mk₀ (s a)) (add_zero i)) ∧
      (∀ a b (x : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) G i),
          x.comp (Abelian.Ext.mk₀ (s (a + b))) (add_zero i) =
          x.comp (Abelian.Ext.mk₀ (s a)) (add_zero i) + x.comp (Abelian.Ext.mk₀ (s b)) (add_zero i)) := by
    intro R _ G s h1 hmul hadd
    refine ⟨fun x => ?_, fun a b x => ?_, fun a b x => ?_⟩
    · rw [h1, Abelian.Ext.comp_mk₀_id]
    · rw [hmul, ← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0)
        (by omega)]
    · rw [hadd, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add]
  obtain ⟨hs1, hsmul, hsadd, hscomm⟩ := wc_int_scalar_ring X.left ℓ
  obtain ⟨hq1, hqmul, hqadd⟩ := wc_ladic_scalar_ring X.left ℓ
  let M := Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) (wcIntSheaf X.left ℓ) i
  letI smulM : SMul ℤ_[ℓ] M :=
    ⟨fun a m => m.comp (Abelian.Ext.mk₀ (wcIntScalar X.left ℓ a)) (add_zero i)⟩
  obtain ⟨A1, Amul, Aadd⟩ := s4 ℤ_[ℓ] (wcIntSheaf X.left ℓ) (wcIntScalar X.left ℓ) hs1 hsmul hsadd
  letI modM : Module ℤ_[ℓ] M := Module.ofMinimalAxioms
    (fun a x y => Abelian.Ext.add_comp x y _ _)
    (fun a b x => Aadd a b x)
    (fun a b x => Amul a b x)
    (fun x => A1 x)
  let V := wcCoh F X h ℓ i
  letI smulV : SMul ℚ_[ℓ] V := ⟨fun c x => wcCohScalar F X h ℓ i c x⟩
  obtain ⟨B1, Bmul, Badd⟩ := s4 ℚ_[ℓ] (wcLadicSheaf X.left ℓ) (wcLadicScalar X.left ℓ) hq1 hqmul hqadd
  letI modV : Module ℚ_[ℓ] V := Module.ofMinimalAxioms
    (fun a x y => map_add (wcCohScalar F X h ℓ i a) x y)
    (fun a b x => Badd a b x)
    (fun a b x => Bmul a b x)
    (fun x => B1 x)

  haveI hmono : Mono (wcIntScalar X.left ℓ (ℓ : ℤ_[ℓ])) := wc_int_scalar_ell_mono X.left ℓ
  let f := wcIntScalar X.left ℓ (ℓ : ℤ_[ℓ])
  let S : ShortComplex (Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}) :=
    ShortComplex.mk f (Limits.cokernel.π f) (Limits.cokernel.condition f)
  have hS : S.ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel f) hmono inferInstance
  let β : M →+ Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) (Limits.cokernel f) i :=
    (Abelian.Ext.mk₀ (Limits.cokernel.π f)).postcomp
      (wcFreeSheaf X.left (wcGeomPoint F X h)) (add_zero i)

  have hβtors : ∀ m : M, ℓ • β m = 0 := by
    intro m
    rw [← map_nsmul, ← Nat.cast_smul_eq_nsmul ℤ_[ℓ] ℓ m]
    change ((m.comp (Abelian.Ext.mk₀ f) (add_zero i)).comp
      (Abelian.Ext.mk₀ (Limits.cokernel.π f)) (add_zero i)) = 0
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, Limits.cokernel.condition, Abelian.Ext.mk₀_zero,
      Abelian.Ext.comp_zero]



  obtain ⟨m₀, hm₀⟩ : ∃ m₀ : M, ∀ m, ∃ k : ℤ, β m = k • β m₀ := by
    by_cases hall : ∀ m, β m = 0
    · exact ⟨0, fun m => ⟨0, by rw [hall m, zero_zsmul]⟩⟩
    · push_neg at hall
      obtain ⟨m₀, hm₀⟩ := hall
      refine ⟨m₀, fun m => ?_⟩
      have hord : addOrderOf (β m₀) = ℓ := addOrderOf_eq_prime (hβtors m₀) hm₀
      have htop : AddSubgroup.zmultiples (β m₀) = ⊤ := by
        apply AddSubgroup.eq_top_of_le_card
        rw [Nat.card_zmultiples, hord]
        exact hGcard
      have hmem : β m ∈ AddSubgroup.zmultiples (β m₀) := by
        rw [htop]; exact AddSubgroup.mem_top _
      obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.mp hmem
      exact ⟨k, hk.symm⟩



  have hdecomp : ∀ m : M, ∃ (k : ℤ) (m' : M), m = k • m₀ + (ℓ : ℤ_[ℓ]) • m' := by
    intro m
    obtain ⟨k, hk⟩ := hm₀ m
    have h0 : (m - k • m₀).comp (Abelian.Ext.mk₀ S.g) (add_zero i) = 0 := by
      change β (m - k • m₀) = 0
      rw [map_sub, map_zsmul, hk, sub_self]
    obtain ⟨m', hm'⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hS (m - k • m₀) h0
    refine ⟨k, m', ?_⟩
    change m = k • m₀ + m'.comp (Abelian.Ext.mk₀ S.f) (add_zero i)
    rw [hm']
    abel



  have hT : ∃ T : Finset M, ∀ m : M, ∃ t ∈ T, ∃ m' : M, m = t + (ℓ : ℤ_[ℓ]) • m' := by
    have hfr : (Set.range β).Finite := Set.toFinite _
    let pre : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) (Limits.cokernel f) i → M :=
      fun y => if hy : ∃ m, β m = y then hy.choose else 0
    refine ⟨hfr.toFinset.image pre, fun m => ?_⟩
    refine ⟨pre (β m), Finset.mem_image_of_mem _ (hfr.mem_toFinset.mpr ⟨m, rfl⟩), ?_⟩
    have hpre : β (pre (β m)) = β m := by
      have hy : ∃ m', β m' = β m := ⟨m, rfl⟩
      simp only [pre, dif_pos hy]
      exact hy.choose_spec
    have h0 : (m - pre (β m)).comp (Abelian.Ext.mk₀ S.g) (add_zero i) = 0 := by
      change β (m - pre (β m)) = 0
      rw [map_sub, hpre, sub_self]
    obtain ⟨m', hm'⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hS (m - pre (β m)) h0
    refine ⟨m', ?_⟩
    change m = pre (β m) + m'.comp (Abelian.Ext.mk₀ S.f) (add_zero i)
    rw [hm']
    abel
  have hD : ∀ w : ℕ → M, (∀ n, w n = (ℓ : ℤ_[ℓ]) • w (n + 1)) → w 0 = 0 := by
    intro w hw
    have hpow : ∀ n : ℕ, w 0 = ((ℓ : ℤ_[ℓ]) ^ n) • w n := by
      intro n
      induction n with
      | zero => rw [pow_zero, one_smul]
      | succ n ih => rw [ih, hw n, ← mul_smul, ← pow_succ]
    apply wc_int_coh_separated F X d ℓ hℓ h i (w 0)
    intro n
    rw [hpow n]
    change ((w n).comp (Abelian.Ext.mk₀ (wcIntScalar X.left ℓ ((ℓ : ℤ_[ℓ]) ^ n))) (add_zero i)).comp
      (Abelian.Ext.mk₀ (Limits.cokernel.π (wcIntScalar X.left ℓ ((ℓ : ℤ_[ℓ]) ^ n)))) (add_zero i) = 0
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, Limits.cokernel.condition, Abelian.Ext.mk₀_zero,
      Abelian.Ext.comp_zero]
  haveI hMfin : Module.Finite ℤ_[ℓ] M := padic_fg_of_mod_ell_reps ℓ M hT hD



  have hcycM : ∀ m : M, ∃ a : ℤ_[ℓ], m = a • m₀ := by
    have hle : (⊤ : Submodule ℤ_[ℓ] M) ≤ Submodule.span ℤ_[ℓ] {m₀} := by
      apply Submodule.le_of_le_smul_of_le_jacobson_bot (I := IsLocalRing.maximalIdeal ℤ_[ℓ])
        Module.Finite.fg_top (IsLocalRing.maximalIdeal_le_jacobson ⊥)
      intro m _
      obtain ⟨k, m', hm⟩ := hdecomp m
      rw [hm]
      have h1 : k • m₀ ∈ Submodule.span ℤ_[ℓ] {m₀} := by
        rw [← Int.cast_smul_eq_zsmul ℤ_[ℓ] k m₀]
        exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self m₀)
      have h2 : (ℓ : ℤ_[ℓ]) • m' ∈ IsLocalRing.maximalIdeal ℤ_[ℓ] • (⊤ : Submodule ℤ_[ℓ] M) := by
        apply Submodule.smul_mem_smul
        · rw [PadicInt.maximalIdeal_eq_span_p]
          exact Ideal.mem_span_singleton_self _
        · exact Submodule.mem_top
      exact Submodule.mem_sup.mpr ⟨_, h1, _, h2, rfl⟩
    intro m
    obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp (hle Submodule.mem_top)
    exact ⟨a, ha.symm⟩



  let φ : M →+ V := (Abelian.Ext.mk₀ (wcIntToLadic X.left ℓ)).postcomp
    (wcFreeSheaf X.left (wcGeomPoint F X h)) (add_zero i)
  have hφ : ∀ (a : ℤ_[ℓ]) (m : M), φ (a • m) = (a : ℚ_[ℓ]) • φ m := by
    intro a m
    change ((m.comp (Abelian.Ext.mk₀ (wcIntScalar X.left ℓ a)) (add_zero i)).comp
        (Abelian.Ext.mk₀ (wcIntToLadic X.left ℓ)) (add_zero i)) =
      (m.comp (Abelian.Ext.mk₀ (wcIntToLadic X.left ℓ)) (add_zero i)).comp
        (Abelian.Ext.mk₀ (wcLadicScalar X.left ℓ (a : ℚ_[ℓ]))) (add_zero i)
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
      Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, hscomm]
  have hcycV : ∀ x : V, ∃ c : ℚ_[ℓ], x = c • φ m₀ := by
    intro x
    obtain ⟨n, y, hy⟩ := wc_ladic_coh_bounded_denominators F X d ℓ hℓ h i x
    have hy' : (ℓ : ℚ_[ℓ]) ^ n • x = φ y := hy
    obtain ⟨a, rfl⟩ := hcycM y
    have hl : (ℓ : ℚ_[ℓ]) ^ n ≠ 0 :=
      pow_ne_zero _ (Nat.cast_ne_zero.mpr (Fact.out : Nat.Prime ℓ).ne_zero)
    refine ⟨((ℓ : ℚ_[ℓ]) ^ n)⁻¹ * (a : ℚ_[ℓ]), ?_⟩
    rw [mul_smul, ← hφ, ← hy', inv_smul_smul₀ hl]



  by_cases hv : φ m₀ = 0
  · refine ⟨0, fun c x => by simp, fun x y _ => ?_⟩
    obtain ⟨c, hc⟩ := hcycV x
    obtain ⟨c', hc'⟩ := hcycV y
    rw [hc, hc', hv, smul_zero, smul_zero]
  · have huniq : ∀ c c' : ℚ_[ℓ], c • φ m₀ = c' • φ m₀ → c = c' := by
      intro c c' hcc
      by_contra hne
      have h1 : (c - c') • φ m₀ = 0 := by rw [sub_smul, hcc, sub_self]
      apply hv
      rw [← inv_smul_smul₀ (sub_ne_zero.mpr hne) (φ m₀), h1, smul_zero]
    choose γ hγ using hcycV
    refine ⟨AddMonoidHom.mk' γ (fun x y => huniq _ _ (by
        rw [add_smul, ← hγ x, ← hγ y, ← hγ (x + y)])), fun c x => ?_, fun x y hxy => ?_⟩
    · show γ (c • x) = c * γ x
      exact huniq _ _ (by rw [mul_smul, ← hγ x, ← hγ (c • x)])
    · have h' : γ x = γ y := hxy
      calc x = γ x • φ m₀ := hγ x
        _ = γ y • φ m₀ := by rw [h']
        _ = y := (hγ y).symm

theorem wc_modcoh_comparison (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    ∃ T : ∀ n : ℕ, wcCoh F X h ℓ n ≃+ wcModCoh F X h ℓ n,
      (∀ (n : ℕ) (c : ℚ_[ℓ]) (x : wcCoh F X h ℓ n),
        T n (wcCohScalar F X h ℓ n c x) = wcModScalar F X h ℓ n c (T n x)) ∧
      (∀ (i j k : ℕ) (hk : i + j = k) (x : wcCoh F X h ℓ i) (y : wcCoh F X h ℓ j),
        wcCohFrob F X h ℓ k ((T k).symm (wcModCup F X h ℓ i j k hk (T i x) (T j y))) =
          (T k).symm (wcModCup F X h ℓ i j k hk (T i (wcCohFrob F X h ℓ i x))
            (T j (wcCohFrob F X h ℓ j y)))) :=
by
  classical
  letI hD : HasExt (Sheaf ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h))
      AddCommGrpCat.{u+1}) := HasExt.standard _
  letI hM : HasExt (SheafOfModules.{u+1} (wcSliceRing F X h ℓ)) := HasExt.standard _

  obtain ⟨Z, ε₁, ε₂, ρ, H1, H2, F1, F2⟩ := wc_slice_free_data F X h ℓ
  obtain ⟨ι, I1, I2⟩ := wc_slice_ladic_unit_iso F X h ℓ

  obtain ⟨hjA, hjC⟩ := sheafPushforward_additive_finiteColimits
    ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h)) (Scheme.ProEt.topology X.left)
    (Over.forget (wcGeomPoint F X h))
  obtain ⟨hΦA, hΦC⟩ := sheafPushforward_additive_finiteColimits
    ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h))
    ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h)) (Over.map (wcGeomFrob F X h))
  have hGC := sheafOfModules_toSheaf_preservesFiniteColimits
    ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h)) (wcSliceRing F X h ℓ)
  let φ0 : wcSliceRing F X h ℓ ⟶ ((Over.map (wcGeomFrob F X h)).sheafPushforwardContinuous
      RingCat.{u+1} ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h))
      ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h))).obj (wcSliceRing F X h ℓ) :=
    𝟙 (wcSliceRing F X h ℓ)
  obtain ⟨hΨA, hΨL, hΨC⟩ := sheafOfModules_pushforward_exact (Over.map (wcGeomFrob F X h))
    (wcSliceRing F X h ℓ) (wcSliceRing F X h ℓ) φ0
  obtain ⟨L₁, adj₁, hL₁A, hL₁L, hL₁C⟩ :=
    proet_overPullback_exact_left_adjoint X.left (wcGeomPoint F X h)
  have hunit : ∀ (V : (Over (wcGeomPoint F X h))ᵒᵖ) (m : ℕ), m ≠ 0 →
      IsUnit (m : ↑((wcSliceRing F X h ℓ).obj.obj V)) := by
    intro V m hm
    have hm' : (m : ℚ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr hm
    change IsUnit (m : C(↥((Opposite.unop V).left.left), ULift.{u+1} ℚ_[ℓ]))
    refine isUnit_iff_exists_inv.mpr ⟨ContinuousMap.const _ (ULift.up ((m : ℚ_[ℓ])⁻¹)), ?_⟩
    refine ContinuousMap.ext fun t => ULift.ext _ _ ?_
    simp [hm']
  obtain ⟨L₂, adj₂, hL₂A, hL₂L, hL₂C⟩ := sheafOfModules_toSheaf_exact_left_adjoint
    ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h)) (wcSliceRing F X h ℓ) hunit

  obtain ⟨Am, hAm⟩ : ∃ Am : ∀ n, wcCoh F X h ℓ n →+ Abelian.Ext Z
      (((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)).obj
        (wcLadicSheaf X.left ℓ)) n,
      ∀ n x, Am n x = (Abelian.Ext.mk₀ ε₁).comp (Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)) x)
          (zero_add n) :=
    ⟨fun n => AddMonoidHom.mk' (fun x => (Abelian.Ext.mk₀ ε₁).comp (Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)) x)
          (zero_add n))
      (fun a b => by rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.comp_add]), fun _ _ => rfl⟩
  obtain ⟨Bm, hBm⟩ : ∃ Bm : ∀ n, wcModCoh F X h ℓ n →+ Abelian.Ext Z
      ((SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)).obj (SheafOfModules.unit (wcSliceRing F X h ℓ))) n,
      ∀ n β, Bm n β = (Abelian.Ext.mk₀ ε₂).comp (Abelian.Ext.mapExactFunctor
        (SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)) β) (zero_add n) :=
    ⟨fun n => AddMonoidHom.mk' (fun β => (Abelian.Ext.mk₀ ε₂).comp (Abelian.Ext.mapExactFunctor
        (SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)) β) (zero_add n))
      (fun a b => by rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.comp_add]), fun _ _ => rfl⟩
  obtain ⟨Pe, hPe⟩ : ∃ Pe : ∀ n, Abelian.Ext Z
      (((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)).obj
        (wcLadicSheaf X.left ℓ)) n ≃+ Abelian.Ext Z
      ((SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)).obj (SheafOfModules.unit (wcSliceRing F X h ℓ))) n,
      ∀ n z, Pe n z = z.comp (Abelian.Ext.mk₀ ι.inv) (add_zero n) :=
    ⟨fun n =>
      { toFun := fun z => z.comp (Abelian.Ext.mk₀ ι.inv) (add_zero n)
        invFun := fun z => z.comp (Abelian.Ext.mk₀ ι.hom) (add_zero n)
        left_inv := fun z => by
          change (z.comp (Abelian.Ext.mk₀ ι.inv) (add_zero n)).comp (Abelian.Ext.mk₀ ι.hom)
            (add_zero n) = z
          rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
            Abelian.Ext.comp_mk₀_id]
        right_inv := fun z => by
          change (z.comp (Abelian.Ext.mk₀ ι.hom) (add_zero n)).comp (Abelian.Ext.mk₀ ι.inv)
            (add_zero n) = z
          rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
            Abelian.Ext.comp_mk₀_id]
        map_add' := fun a b => Abelian.Ext.add_comp _ _ _ _ }, fun _ _ => rfl⟩
  have hA : ∀ n, Function.Bijective (Am n) := by
    intro n
    have e : (⇑(Am n)) = fun x => (Abelian.Ext.mk₀ ε₁).comp (Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)) x)
          (zero_add n) := funext (hAm n)
    rw [e]
    exact ext_transfer_of_hom_bijective L₁
      ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)) adj₁
      Z (wcFreeSheaf X.left (wcGeomPoint F X h)) ε₁ H1 (wcLadicSheaf X.left ℓ) n
  have hB : ∀ n, Function.Bijective (Bm n) := by
    intro n
    have e : (⇑(Bm n)) = fun β => (Abelian.Ext.mk₀ ε₂).comp (Abelian.Ext.mapExactFunctor
        (SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)) β) (zero_add n) := funext (hBm n)
    rw [e]
    exact ext_transfer_of_hom_bijective L₂ (SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)) adj₂
      Z (SheafOfModules.unit (wcSliceRing F X h ℓ)) ε₂ H2 (SheafOfModules.unit (wcSliceRing F X h ℓ)) n
  obtain ⟨T, hT⟩ : ∃ T : ∀ n, wcCoh F X h ℓ n ≃+ wcModCoh F X h ℓ n,
      ∀ n x, Bm n (T n x) = Pe n (Am n x) :=
    ⟨fun n => (AddEquiv.ofBijective (Am n) (hA n)).trans
        ((Pe n).trans (AddEquiv.ofBijective (Bm n) (hB n)).symm),
      fun n x => AddEquiv.ofBijective_apply_symm_apply (Bm n) (hB n)⟩

  obtain ⟨φ, hφ⟩ : ∃ φ : ∀ n, wcModCoh F X h ℓ n → wcModCoh F X h ℓ n,
      ∀ n β, φ n β = Abelian.Ext.mapExactFunctor
        (SheafOfModules.pushforward.{u+1} φ0) β :=
    ⟨fun n β => Abelian.Ext.mapExactFunctor
        (SheafOfModules.pushforward.{u+1} φ0) β,
      fun _ _ => rfl⟩
  have hΦj : ∀ n (x : wcCoh F X h ℓ n),
      Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology X.left).overMapPullback AddCommGrpCat.{u+1} (wcGeomFrob F X h))
        (Abelian.Ext.mapExactFunctor
          ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)) x) =
      Abelian.Ext.mapExactFunctor
          ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)) x := by
    intro n x
    rw [← Abelian.Ext.comp_mapExactFunctor]
    rfl
  have hGΨ : ∀ n (β : wcModCoh F X h ℓ n),
      Abelian.Ext.mapExactFunctor (SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ))
        (Abelian.Ext.mapExactFunctor
          (SheafOfModules.pushforward.{u+1} φ0) β) =
      Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology X.left).overMapPullback AddCommGrpCat.{u+1} (wcGeomFrob F X h))
        (Abelian.Ext.mapExactFunctor (SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)) β) := by
    intro n β
    rw [← Abelian.Ext.comp_mapExactFunctor, ← Abelian.Ext.comp_mapExactFunctor]
    rfl
  have hΦι : ((Scheme.ProEt.topology X.left).overMapPullback AddCommGrpCat.{u+1}
      (wcGeomFrob F X h)).map ι.inv = ι.inv :=
    congrArg Iso.inv (Iso.ext (α := ((Scheme.ProEt.topology X.left).overMapPullback
      AddCommGrpCat.{u+1} (wcGeomFrob F X h)).mapIso ι) (β := ι) I2)
  have hι : ∀ c : ℚ_[ℓ],
      ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)).map
        (wcLadicScalar X.left ℓ c) ≫ ι.inv =
      ι.inv ≫ (SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)).map (wcModConst F X h ℓ c) := by
    intro c
    rw [Iso.eq_inv_comp, ← Category.assoc, ← I1, Category.assoc, Iso.hom_inv_id, Category.comp_id]

  have hAF : ∀ n (x : wcCoh F X h ℓ n), Am n (wcCohFrob F X h ℓ n x) =
      (Abelian.Ext.mk₀ ρ).comp (Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology X.left).overMapPullback AddCommGrpCat.{u+1} (wcGeomFrob F X h))
        (Am n x)) (zero_add n) := by
    intro n x
    have hfx : wcCohFrob F X h ℓ n x =
        (Abelian.Ext.mk₀ (wcFreeSheafMap X.left (wcGeomFrob F X h))).comp x (zero_add n) := rfl
    have s1 : Am n (wcCohFrob F X h ℓ n x) = (Abelian.Ext.mk₀ (ε₁ ≫
        ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)).map
          (wcFreeSheafMap X.left (wcGeomFrob F X h)))).comp (Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)) x)
          (zero_add n) := by
      rw [hfx, hAm, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.mk₀_comp_mk₀_assoc]
    rw [F1] at s1
    rw [s1, hAm, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.mk₀_comp_mk₀_assoc]
    exact congrArg (fun y => (Abelian.Ext.mk₀ (ρ ≫ ((Scheme.ProEt.topology X.left).overMapPullback
      AddCommGrpCat.{u+1} (wcGeomFrob F X h)).map ε₁)).comp y (zero_add n)) (hΦj n x).symm
  have hBΨ : ∀ n (β : wcModCoh F X h ℓ n), Bm n (φ n β) =
      (Abelian.Ext.mk₀ ρ).comp (Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology X.left).overMapPullback AddCommGrpCat.{u+1} (wcGeomFrob F X h))
        (Bm n β)) (zero_add n) := by
    intro n β
    have hGφ := (congrArg (Abelian.Ext.mapExactFunctor
      (SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ))) (hφ n β)).trans (hGΨ n β)
    rw [hBm, hBm, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.mk₀_comp_mk₀_assoc, ← F2]
    exact congrArg (fun y => (Abelian.Ext.mk₀ ε₂).comp y (zero_add n)) hGφ
  have hAP : ∀ n (x : wcCoh F X h ℓ n), Pe n (Am n (wcCohFrob F X h ℓ n x)) =
      (Abelian.Ext.mk₀ ρ).comp (Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology X.left).overMapPullback AddCommGrpCat.{u+1} (wcGeomFrob F X h))
        (Pe n (Am n x))) (zero_add n) := by
    intro n x
    rw [hPe, hPe, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_assoc_of_third_deg_zero, hAF]
    exact congrArg (fun g => ((Abelian.Ext.mk₀ ρ).comp (Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology X.left).overMapPullback AddCommGrpCat.{u+1} (wcGeomFrob F X h))
        (Am n x)) (zero_add n)).comp (Abelian.Ext.mk₀ g) (add_zero n)) hΦι.symm
  have hTFr : ∀ n (x : wcCoh F X h ℓ n), T n (wcCohFrob F X h ℓ n x) = φ n (T n x) := by
    intro n x
    apply (hB n).1
    rw [hT, hBΨ, hT]
    exact hAP n x
  refine ⟨T, ?_, ?_⟩
  · intro n c x
    apply (hB n).1
    rw [hT]
    have e1 : Am n (wcCohScalar F X h ℓ n c x) = (Am n x).comp (Abelian.Ext.mk₀
        (((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)).map
          (wcLadicScalar X.left ℓ c))) (add_zero n) := by
      have hsc : wcCohScalar F X h ℓ n c x =
          x.comp (Abelian.Ext.mk₀ (wcLadicScalar X.left ℓ c)) (add_zero n) := rfl
      rw [hsc, hAm, hAm, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
      exact (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).symm
    have e2 : ∀ β : wcModCoh F X h ℓ n, Bm n (wcModScalar F X h ℓ n c β) =
        (Bm n β).comp (Abelian.Ext.mk₀
          ((SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)).map (wcModConst F X h ℓ c))) (add_zero n) := by
      intro β
      have hSc : wcModScalar F X h ℓ n c β =
          β.comp (Abelian.Ext.mk₀ (wcModConst F X h ℓ c)) (add_zero n) := rfl
      rw [hSc, hBm, hBm, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
      exact (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).symm
    rw [e1, e2, hT, hPe, hPe, Abelian.Ext.comp_assoc_of_third_deg_zero,
      Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀,
      hι]
  · intro i j k hk x y
    rw [AddEquiv.eq_symm_apply, hTFr k, AddEquiv.apply_symm_apply, hTFr i, hTFr j, hφ, hφ, hφ]
    exact Abelian.Ext.mapExactFunctor_comp _ (T i x) (T j y) hk

theorem wc_modcoh_ell_torsionfree (F : Type u) [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (n k : ℕ) (x : wcModCoh F X h ℓ n) :
    ℓ ^ k • x = 0 → x = 0 :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcSliceRing F X h ℓ)) := HasExt.standard _
  intro hx

  have hs1 : ∀ N : ℕ, x.comp (Abelian.Ext.mk₀
      (N • 𝟙 (SheafOfModules.unit (wcSliceRing F X h ℓ)))) (add_zero n) = N • x := by
    intro N
    induction N with
    | zero => simp only [zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    | succ N ih =>
      rw [succ_nsmul (𝟙 (SheafOfModules.unit (wcSliceRing F X h ℓ))) N, Abelian.Ext.mk₀_add,
        Abelian.Ext.comp_add, ih, Abelian.Ext.comp_mk₀_id, succ_nsmul x N]

  have hs2 : ∀ N : ℕ, N ≠ 0 →
      (N • 𝟙 (SheafOfModules.unit (wcSliceRing F X h ℓ))) ≫
        wcModConst F X h ℓ ((N : ℚ_[ℓ])⁻¹) = 𝟙 (SheafOfModules.unit (wcSliceRing F X h ℓ)) := by
    intro N hN
    obtain ⟨M, hM⟩ : ∃ M, N = M + 1 := ⟨N - 1, by omega⟩
    subst hM
    rw [Preadditive.nsmul_comp, Category.id_comp]
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext V
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    have hnapp : ∀ (K : ℕ) (f : SheafOfModules.unit (wcSliceRing F X h ℓ) ⟶
        SheafOfModules.unit (wcSliceRing F X h ℓ))
        (m : ↑((SheafOfModules.unit (wcSliceRing F X h ℓ)).val.obj V)),
        ConcreteCategory.hom (((K + 1) • f).val.app V) m =
          (K + 1) • ConcreteCategory.hom (f.val.app V) m := by
      intro K f m
      induction K with
      | zero => rw [zero_add, one_nsmul, one_nsmul]
      | succ K ih =>
        rw [succ_nsmul f (K + 1), succ_nsmul (ConcreteCategory.hom (f.val.app V) m) (K + 1), ← ih,
          SheafOfModules.add_val, PresheafOfModules.add_app]
        rfl
    have hgval : ((SheafOfModules.unitHomEquiv _)
        (wcModConst F X h ℓ (((M + 1 : ℕ) : ℚ_[ℓ])⁻¹))).val V =
        (ContinuousMap.const _ (ULift.up (((M + 1 : ℕ) : ℚ_[ℓ])⁻¹)) :
          C(↥((Opposite.unop V).left.left), ULift.{u+1} ℚ_[ℓ])) := by
      rw [wcModConst, Equiv.apply_symm_apply]
      rfl
    rw [SheafOfModules.unitHomEquiv_apply_coe] at hgval
    refine ((hnapp M _ _).trans (congrArg
      (fun s : ↑((SheafOfModules.unit (wcSliceRing F X h ℓ)).val.obj V) => (M + 1) • s)
      hgval)).trans ?_
    change ((M + 1) • (ContinuousMap.const _ (ULift.up (((M + 1 : ℕ) : ℚ_[ℓ])⁻¹)) :
          C(↥((Opposite.unop V).left.left), ULift.{u+1} ℚ_[ℓ]))) =
        (1 : C(↥((Opposite.unop V).left.left), ULift.{u+1} ℚ_[ℓ]))
    ext t
    rw [ContinuousMap.nsmul_apply, ContinuousMap.const_apply, ContinuousMap.one_apply]
    show (M + 1) • (((M + 1 : ℕ) : ℚ_[ℓ])⁻¹) = 1
    rw [nsmul_eq_mul]
    exact mul_inv_cancel₀ (Nat.cast_ne_zero.mpr hN)

  have hN : ℓ ^ k ≠ 0 := pow_ne_zero k (Fact.out : Nat.Prime ℓ).ne_zero
  have hg := hs2 (ℓ ^ k) hN
  calc x = x.comp (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcSliceRing F X h ℓ)))) (add_zero n) :=
        (Abelian.Ext.comp_mk₀_id x).symm
    _ = (x.comp (Abelian.Ext.mk₀ ((ℓ ^ k) • 𝟙 (SheafOfModules.unit (wcSliceRing F X h ℓ))))
          (add_zero n)).comp
          (Abelian.Ext.mk₀ (wcModConst F X h ℓ (((ℓ ^ k : ℕ) : ℚ_[ℓ])⁻¹))) (add_zero n) := by
        rw [Abelian.Ext.comp_assoc x _ _ (add_zero n) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, hg]
    _ = 0 := by rw [hs1, hx, Abelian.Ext.zero_comp]

theorem presheafOfModules_tensorInt_leftAdjoint_mono : ∀ {C : Type (u+1)} [Category.{u} C]
    (R₀ : Cᵒᵖ ⥤ RingCat.{u+1}),
    (∀ (V : Cᵒᵖ) (m : ℤ) (r : ↑(R₀.obj V)), m ≠ 0 → (m : ↑(R₀.obj V)) * r = 0 → r = 0) →
    ∃ (T : (Cᵒᵖ ⥤ AddCommGrpCat.{u+1}) ⥤ PresheafOfModules.{u+1} R₀)
      (_ : T ⊣ PresheafOfModules.toPresheaf.{u+1} R₀), T.PreservesMonomorphisms :=
by
  intro C _ R₀ hTF
  classical

  have s1 : ∀ (R : Type (u+1)) [Ring R],
      (∀ (m : ℤ) (r : R), m ≠ 0 → (m : R) * r = 0 → r = 0) →
      ∀ {M N : Type (u+1)} [AddCommGroup M] [AddCommGroup N] (f : M →+ N), Function.Injective f →
        Function.Injective (TensorProduct.map (LinearMap.id : R →ₗ[ℤ] R) f.toIntLinearMap) := by
    intro R _ hR M N _ _ f hf
    have htor : Submodule.torsion ℤ R = ⊥ := by
      rw [Submodule.eq_bot_iff]
      intro x hx
      obtain ⟨a, ha⟩ := (Submodule.mem_torsion_iff x).mp hx
      have ha0 : (a : ℤ) ≠ 0 := nonZeroDivisors.coe_ne_zero a
      apply hR a x ha0
      rw [← zsmul_eq_mul]
      exact ha
    haveI : Module.Flat ℤ R := IsDedekindDomain.flat_iff_torsion_eq_bot.mpr htor
    have h := Module.Flat.lTensor_preserves_injective_linearMap (M := R) f.toIntLinearMap
      (by simpa using hf)
    rwa [LinearMap.lTensor_def] at h

  have tsm : ∀ (R : Type (u+1)) [Ring R] (A : Type (u+1)) [AddCommGroup A] (r : R) (a : A),
      r ⊗ₜ[ℤ] a = r • ((1 : R) ⊗ₜ[ℤ] a) := by
    intro R _ A _ r a
    rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]

  have s2 : ∀ (P : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}),
      ∃ (M : PresheafOfModules.{u+1} R₀)
        (e : ∀ V : Cᵒᵖ, TensorProduct ℤ ↑(R₀.obj V) ↑(P.obj V) ≃ₗ[↑(R₀.obj V)] ↑(M.obj V)),
        ∀ ⦃V W : Cᵒᵖ⦄ (f : V ⟶ W) (r : ↑(R₀.obj V)) (p : ↑(P.obj V)),
          (M.map f).hom (e V (r ⊗ₜ[ℤ] p)) = e W ((R₀.map f).hom r ⊗ₜ[ℤ] (P.map f).hom p) := by
    intro P
    let tm : ∀ ⦃V W : Cᵒᵖ⦄ (_ : V ⟶ W), TensorProduct ℤ ↑(R₀.obj V) ↑(P.obj V) →ₗ[ℤ]
        TensorProduct ℤ ↑(R₀.obj W) ↑(P.obj W) :=
      fun V W f => TensorProduct.map (R₀.map f).hom.toAddMonoidHom.toIntLinearMap
        (P.map f).hom.toIntLinearMap
    have tm_tmul : ∀ ⦃V W : Cᵒᵖ⦄ (f : V ⟶ W) (r : ↑(R₀.obj V)) (p : ↑(P.obj V)),
        tm f (r ⊗ₜ[ℤ] p) = (R₀.map f).hom r ⊗ₜ[ℤ] (P.map f).hom p :=
      fun V W f r p => TensorProduct.map_tmul _ _ _ _
    let P' : Cᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
      { obj := fun V => AddCommGrpCat.of (TensorProduct ℤ ↑(R₀.obj V) ↑(P.obj V))
        map := fun {V W} f => AddCommGrpCat.ofHom (tm f).toAddMonoidHom
        map_id := fun V => by
          ext x
          change tm (𝟙 V) x = x
          induction x using TensorProduct.induction_on with
          | zero => simp
          | tmul r p => rw [tm_tmul]; simp
          | add a b ha hb => rw [map_add, ha, hb]
        map_comp := fun {V W X} f g => by
          ext x
          change tm (f ≫ g) x = tm g (tm f x)
          induction x using TensorProduct.induction_on with
          | zero => simp
          | tmul r p => rw [tm_tmul, tm_tmul, tm_tmul]; simp
          | add a b ha hb => rw [map_add, map_add, map_add, ha, hb] }
    letI inst : ∀ V, Module ↑(R₀.obj V) ↑(P'.obj V) := fun V =>
      (TensorProduct.leftModule : Module ↑(R₀.obj V) (TensorProduct ℤ ↑(R₀.obj V) ↑(P.obj V)))
    have hsmul : ∀ ⦃V W : Cᵒᵖ⦄ (f : V ⟶ W) (r : ↑(R₀.obj V))
        (m : TensorProduct ℤ ↑(R₀.obj V) ↑(P.obj V)),
        tm f (r • m) = (R₀.map f).hom r • tm f m := by
      intro V W f r m
      induction m using TensorProduct.induction_on with
      | zero => simp
      | tmul s p =>
        rw [TensorProduct.smul_tmul', tm_tmul, tm_tmul, TensorProduct.smul_tmul', smul_eq_mul,
          smul_eq_mul, map_mul]
      | add a b ha hb => rw [smul_add, map_add, ha, hb, map_add, smul_add]
    refine ⟨PresheafOfModules.ofPresheaf P' hsmul, fun V => LinearEquiv.refl _ _, ?_⟩
    intro V W f r p
    exact tm_tmul f r p

  have s3 : ∀ (P : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}) (M : PresheafOfModules.{u+1} R₀)
      (e : ∀ V : Cᵒᵖ, TensorProduct ℤ ↑(R₀.obj V) ↑(P.obj V) ≃ₗ[↑(R₀.obj V)] ↑(M.obj V)),
      (∀ ⦃V W : Cᵒᵖ⦄ (f : V ⟶ W) (r : ↑(R₀.obj V)) (p : ↑(P.obj V)),
          (M.map f).hom (e V (r ⊗ₜ[ℤ] p)) = e W ((R₀.map f).hom r ⊗ₜ[ℤ] (P.map f).hom p)) →
      ∃ η : P ⟶ (PresheafOfModules.toPresheaf.{u+1} R₀).obj M,
        (∀ (V : Cᵒᵖ) (p : ↑(P.obj V)), (η.app V).hom p = e V ((1 : ↑(R₀.obj V)) ⊗ₜ[ℤ] p)) ∧
        ∀ N : PresheafOfModules.{u+1} R₀,
          Function.Bijective (fun ψ : M ⟶ N => η ≫ (PresheafOfModules.toPresheaf.{u+1} R₀).map ψ) := by
    intro P M e hres
    let ηa : ∀ V, ↑(P.obj V) →+ ↑(M.obj V) := fun V =>
      { toFun := fun p => e V ((1 : ↑(R₀.obj V)) ⊗ₜ[ℤ] p)
        map_zero' := by rw [TensorProduct.tmul_zero, map_zero]
        map_add' := fun a b => by rw [TensorProduct.tmul_add, map_add] }
    let η : P ⟶ (PresheafOfModules.toPresheaf.{u+1} R₀).obj M :=
      { app := fun V => AddCommGrpCat.ofHom (ηa V)
        naturality := fun V W f => by
          ext p
          change e W ((1 : ↑(R₀.obj W)) ⊗ₜ[ℤ] (P.map f).hom p) =
            (M.map f).hom (e V ((1 : ↑(R₀.obj V)) ⊗ₜ[ℤ] p))
          rw [hres, map_one] }
    refine ⟨η, fun V p => rfl, fun N => ⟨?_, ?_⟩⟩
    · intro ψ ψ' h
      have h' : ∀ V p, (ψ.app V).hom (e V ((1 : ↑(R₀.obj V)) ⊗ₜ[ℤ] p)) =
          (ψ'.app V).hom (e V ((1 : ↑(R₀.obj V)) ⊗ₜ[ℤ] p)) := by
        intro V p
        exact congrArg (fun φ => (φ.app V).hom p) h
      apply PresheafOfModules.hom_ext
      intro V
      ext y
      obtain ⟨t, rfl⟩ := (e V).surjective y
      induction t using TensorProduct.induction_on with
      | zero => simp only [map_zero]
      | tmul r p =>
        rw [tsm _ _ r p, map_smul, map_smul, map_smul, h']
      | add a b ha hb => simp only [map_add, ha, hb]
    · intro g
      let gV : ∀ V, ↑(P.obj V) →+ ↑(N.obj V) := fun V => (g.app V).hom
      have hgnat : ∀ ⦃V W : Cᵒᵖ⦄ (f : V ⟶ W) (p : ↑(P.obj V)),
          (N.map f).hom (gV V p) = gV W ((P.map f).hom p) := by
        intro V W f p
        exact (congrArg (fun φ => φ.hom p) (g.naturality f)).symm
      let L : ∀ V, TensorProduct ℤ ↑(R₀.obj V) ↑(P.obj V) →ₗ[ℤ] ↑(N.obj V) := fun V =>
        TensorProduct.lift (LinearMap.mk₂ ℤ
          (fun (r : ↑(R₀.obj V)) (p : ↑(P.obj V)) => r • gV V p)
          (fun r₁ r₂ p => add_smul r₁ r₂ _)
          (fun c r p => by
            change ((c • r) • gV V p) = c • (r • gV V p)
            rw [zsmul_eq_mul, mul_smul, Int.cast_smul_eq_zsmul])
          (fun r p₁ p₂ => by
            rw [map_add, smul_add])
          (fun c r p => by
            change r • gV V (c • p) = c • (r • gV V p)
            rw [map_zsmul]
            exact map_zsmul (DistribSMul.toAddMonoidHom (↑(N.obj V)) r) c (gV V p)))
      have L_tmul : ∀ V (r : ↑(R₀.obj V)) (p : ↑(P.obj V)), L V (r ⊗ₜ[ℤ] p) = r • gV V p :=
        fun V r p => rfl
      have hLs : ∀ V (s : ↑(R₀.obj V)) (t : TensorProduct ℤ ↑(R₀.obj V) ↑(P.obj V)),
          L V (s • t) = s • L V t := by
        intro V s t
        induction t using TensorProduct.induction_on with
        | zero => simp only [smul_zero, map_zero]
        | tmul r p => rw [TensorProduct.smul_tmul', smul_eq_mul, L_tmul, L_tmul, mul_smul]
        | add a b ha hb => rw [smul_add, map_add, map_add, ha, hb, smul_add]
      have hnat : ∀ ⦃V W : Cᵒᵖ⦄ (f : V ⟶ W) (t : TensorProduct ℤ ↑(R₀.obj V) ↑(P.obj V)),
          L W ((e W).symm ((M.map f).hom (e V t))) = (N.map f).hom (L V t) := by
        intro V W f t
        induction t using TensorProduct.induction_on with
        | zero =>
          simp only [map_zero]
          erw [map_zero (e W).symm, map_zero]
          rfl
        | tmul r p =>
          rw [hres, LinearEquiv.symm_apply_apply, L_tmul, L_tmul, ← hgnat f p]
          exact (PresheafOfModules.map_smul N f r (gV V p)).symm
        | add a b ha hb =>
          rw [map_add (e V)]
          erw [map_add (M.map f).hom, map_add (e W).symm]
          rw [map_add (L W), ha, hb, map_add (L V)]
          erw [map_add (N.map f).hom]
          rfl
      let φa : ∀ V, ↑(M.obj V) →+ ↑(N.obj V) := fun V =>
        (L V).toAddMonoidHom.comp (e V).symm.toLinearMap.toAddMonoidHom
      let φ : M.presheaf ⟶ N.presheaf :=
        { app := fun V => AddCommGrpCat.ofHom (φa V)
          naturality := fun V W f => by
            ext y
            change L W ((e W).symm ((M.map f).hom y)) = (N.map f).hom (L V ((e V).symm y))
            obtain ⟨t, rfl⟩ := (e V).surjective y
            rw [LinearEquiv.symm_apply_apply]
            exact hnat f t }
      let ψ : M ⟶ N := PresheafOfModules.homMk φ (fun V s y => by
        change L V ((e V).symm (s • y)) = s • L V ((e V).symm y)
        rw [map_smul, hLs])
      refine ⟨ψ, ?_⟩
      ext V p
      change L V ((e V).symm (e V ((1 : ↑(R₀.obj V)) ⊗ₜ[ℤ] p))) = (g.app V).hom p
      rw [LinearEquiv.symm_apply_apply, L_tmul, one_smul]
      rfl

  choose Mo eo hres using s2
  choose η hη hbij using fun P => s3 P (Mo P) (eo P) (hres P)
  let G := PresheafOfModules.toPresheaf.{u+1} R₀
  let eqv : ∀ (P : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}) (N : PresheafOfModules.{u+1} R₀),
      (Mo P ⟶ N) ≃ (P ⟶ G.obj N) := fun P N => Equiv.ofBijective _ (hbij P N)
  have he : ∀ (P : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}) (N N' : PresheafOfModules.{u+1} R₀)
      (g : N ⟶ N') (h : Mo P ⟶ N), eqv P N' (h ≫ g) = eqv P N h ≫ G.map g := by
    intro P N N' g h
    show η P ≫ G.map (h ≫ g) = (η P ≫ G.map h) ≫ G.map g
    rw [Functor.map_comp, Category.assoc]
  let T := Adjunction.leftAdjointOfEquiv eqv he
  refine ⟨T, Adjunction.adjunctionOfEquivLeft eqv he, ?_⟩
  constructor
  intro P Q ι hι
  have h1 : eqv Q (Mo Q) (𝟙 (Mo Q)) = η Q := by
    show η Q ≫ G.map (𝟙 _) = η Q
    rw [G.map_id, Category.comp_id]
  have hF : η P ≫ G.map (T.map ι) = ι ≫ η Q := by
    have h2 : T.map ι = (eqv P (Mo Q)).symm (ι ≫ eqv Q (Mo Q) (𝟙 (Mo Q))) :=
      Adjunction.leftAdjointOfEquiv_map eqv he ι
    rw [h1] at h2
    have h3 := (eqv P (Mo Q)).apply_symm_apply (ι ≫ η Q)
    rw [← h2] at h3
    exact h3
  apply PresheafOfModules.mono_of_injective
  intro V
  have hj : Function.Injective (ι.app V).hom := by
    have : Mono (ι.app V) := (NatTrans.mono_iff_mono_app ι).mp hι V
    exact (AddCommGrpCat.mono_iff_injective _).mp this
  have hFV : ∀ p, ((T.map ι).app V).hom (((η P).app V).hom p) =
      ((η Q).app V).hom ((ι.app V).hom p) :=
    fun p => congrArg (fun φ => (φ.app V).hom p) hF
  have hD : ∀ t, ((T.map ι).app V).hom (eo P V t) =
      eo Q V (TensorProduct.map (LinearMap.id : ↑(R₀.obj V) →ₗ[ℤ] ↑(R₀.obj V))
        (ι.app V).hom.toIntLinearMap t) := by
    intro t
    induction t using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul r p =>
      rw [TensorProduct.map_tmul, LinearMap.id_apply, AddMonoidHom.coe_toIntLinearMap,
        tsm _ _ r p, tsm _ _ r ((ι.app V).hom p), map_smul, map_smul, map_smul, ← hη P V p, hFV,
        hη Q]
    | add a b ha hb => simp only [map_add, ha, hb]
  intro x y hxy
  obtain ⟨a, rfl⟩ := (eo P V).surjective x
  obtain ⟨b, rfl⟩ := (eo P V).surjective y
  have hab : eo Q V (TensorProduct.map (LinearMap.id : ↑(R₀.obj V) →ₗ[ℤ] ↑(R₀.obj V))
        (ι.app V).hom.toIntLinearMap a) =
      eo Q V (TensorProduct.map (LinearMap.id : ↑(R₀.obj V) →ₗ[ℤ] ↑(R₀.obj V))
        (ι.app V).hom.toIntLinearMap b) := by
    rw [← hD a, ← hD b]
    exact hxy
  rw [s1 _ (hTF V) _ hj ((eo Q V).injective hab)]

theorem sheafOfModules_toSheaf_exactLeftAdjoint_of_presheaf : ∀ {C : Type (u+1)} [Category.{u} C]
    (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
    (R : Sheaf J RingCat.{u+1})
    (T : (Cᵒᵖ ⥤ AddCommGrpCat.{u+1}) ⥤ PresheafOfModules.{u+1} R.obj),
    (T ⊣ PresheafOfModules.toPresheaf.{u+1} R.obj) → T.PreservesMonomorphisms →
    ∃ (L : Sheaf J AddCommGrpCat.{u+1} ⥤ SheafOfModules.{u+1} R) (_ : L ⊣ SheafOfModules.toSheaf.{u+1} R),
      L.Additive ∧ Limits.PreservesFiniteLimits L ∧ Limits.PreservesFiniteColimits L :=
by
  intro C _ J _ _ R T adjT hmono
  haveI : T.Additive := adjT.left_adjoint_additive
  haveI : T.PreservesMonomorphisms := hmono
  letI := adjT.leftAdjoint_preservesColimits.{0, 0}
  letI : T.PreservesHomology := Functor.preservesHomology_of_preservesMonos_and_cokernels T
  haveI : Limits.PreservesFiniteLimits T := Functor.preservesFiniteLimits_of_preservesHomology T
  let adj := Adjunction.restrictFullyFaithful (iC := sheafToPresheaf J AddCommGrpCat.{u+1})
    (iD := 𝟭 (SheafOfModules.{u+1} R))
    (L := sheafToPresheaf J AddCommGrpCat.{u+1} ⋙ T ⋙ PresheafOfModules.sheafification.{u+1} (𝟙 R.obj))
    (R := SheafOfModules.toSheaf.{u+1} R)
    (adjT.comp (PresheafOfModules.sheafificationAdjunction.{u+1} (𝟙 R.obj)))
    (fullyFaithfulSheafToPresheaf J AddCommGrpCat.{u+1}) (Functor.FullyFaithful.id _)
    (Iso.refl _) (Iso.refl _)
  have hPFL : Limits.PreservesFiniteLimits
      (sheafToPresheaf J AddCommGrpCat.{u+1} ⋙ T ⋙ PresheafOfModules.sheafification.{u+1} (𝟙 R.obj)) :=
    inferInstance
  letI := adj.leftAdjoint_preservesColimits.{0, 0}
  exact ⟨_, adj, adj.left_adjoint_additive, hPFL,
    Limits.PreservesColimitsOfSize.preservesFiniteColimits _⟩

theorem sheafOfModules_toSheaf_exact_left_adjoint_of_torsionFree : ∀ {C : Type (u+1)} [Category.{u} C]
    (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
    (R : Sheaf J RingCat.{u+1}),
    (∀ (V : Cᵒᵖ) (m : ℕ) (r : ↑(R.obj.obj V)), m ≠ 0 → m • r = 0 → r = 0) →
    ∃ (L : Sheaf J AddCommGrpCat.{u+1} ⥤ SheafOfModules.{u+1} R) (_ : L ⊣ SheafOfModules.toSheaf R),
      L.Additive ∧ Limits.PreservesFiniteLimits L ∧ Limits.PreservesFiniteColimits L :=
by
  intro C _ J _ _ R htf
  have hZ : ∀ (V : Cᵒᵖ) (m : ℤ) (r : ↑(R.obj.obj V)), m ≠ 0 →
      (m : ↑(R.obj.obj V)) * r = 0 → r = 0 := by
    intro V m r hm h
    obtain ⟨n, e | e⟩ := Int.eq_nat_or_neg m
    · subst e
      have hn : n ≠ 0 := by exact_mod_cast hm
      apply htf V n r hn
      rw [nsmul_eq_mul]
      rw [Int.cast_natCast] at h
      exact h
    · subst e
      have hn : n ≠ 0 := by
        intro h0
        apply hm
        rw [h0]
        simp
      apply htf V n r hn
      rw [nsmul_eq_mul]
      rw [Int.cast_neg, Int.cast_natCast, neg_mul, neg_eq_zero] at h
      exact h
  obtain ⟨T, adjT, hT⟩ := presheafOfModules_tensorInt_leftAdjoint_mono R.obj hZ
  exact sheafOfModules_toSheaf_exactLeftAdjoint_of_presheaf J R T adjT hT

theorem wc_int_slice_free_data : ∀ (F : Type u) [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)],
    ∃ (Z : Sheaf ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h)) AddCommGrpCat.{u+1})
      (ε₁ : Z ⟶ ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)).obj
        (wcFreeSheaf X.left (wcGeomPoint F X h)))
      (εΛ : Z ⟶ (SheafOfModules.toSheaf (wcIntSliceRing F X h ℓ)).obj
        (SheafOfModules.unit (wcIntSliceRing F X h ℓ))),
      (∀ Y : Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1},
        Function.Bijective (fun f : wcFreeSheaf X.left (wcGeomPoint F X h) ⟶ Y =>
          ε₁ ≫ ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)).map f)) ∧
      (∀ M : SheafOfModules.{u+1} (wcIntSliceRing F X h ℓ),
        Function.Bijective (fun f : SheafOfModules.unit (wcIntSliceRing F X h ℓ) ⟶ M =>
          εΛ ≫ (SheafOfModules.toSheaf (wcIntSliceRing F X h ℓ)).map f)) ∧
      (∀ M : SheafOfModules.{u+1} (wcSliceRing F X h ℓ),
        Function.Bijective (fun f : SheafOfModules.unit (wcSliceRing F X h ℓ) ⟶ M =>
          (εΛ ≫ (SheafOfModules.toSheaf (wcIntSliceRing F X h ℓ)).map
            (wcUnitRestrict (wcIntRatSliceMap F X h ℓ))) ≫
            (SheafOfModules.toSheaf (wcSliceRing F X h ℓ)).map f)) :=
by
  intro F _ X h ℓ _

  have s1 : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
      [HasWeakSheafify J AddCommGrpCat.{u+1}] (T : C) (Fs : Sheaf J AddCommGrpCat.{u+1}),
      Function.Bijective (fun φ : (presheafToSheaf J AddCommGrpCat.{u+1}).obj
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Fs =>
        φ.hom.app (Opposite.op T)
          ((toSheafify J (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
            (Opposite.op T) (FreeAbelianGroup.of (ULift.up (𝟙 T))))) := by
    intro C _ J _ T Fs
    let e2 : ∀ G : Cᵒᵖ ⥤ AddCommGrpCat.{u+1},
        (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ G) ≃ G.obj (Opposite.op T) :=
      fun G => ((Adjunction.whiskerRight Cᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u}) G).trans
          (uliftYonedaEquiv.{u+1} (X := T) (F := G ⋙ forget AddCommGrpCat.{u+1}))
    have he2 : ∀ (G : Cᵒᵖ ⥤ AddCommGrpCat.{u+1})
        (ψ : yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ G),
        e2 G ψ = ψ.app (Opposite.op T) (FreeAbelianGroup.of (ULift.up (𝟙 T))) := by
      intro G ψ
      rfl
    let e : ((presheafToSheaf J AddCommGrpCat.{u+1}).obj
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Fs) ≃
          Fs.obj.obj (Opposite.op T) :=
      ((sheafificationAdjunction J AddCommGrpCat.{u+1}).homEquiv
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) Fs).trans (e2 Fs.obj)
    have he : ∀ φ, e φ = φ.hom.app (Opposite.op T)
          ((toSheafify J (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
            (Opposite.op T) (FreeAbelianGroup.of (ULift.up (𝟙 T)))) := by
      intro φ
      show e2 Fs.obj ((sheafificationAdjunction J AddCommGrpCat.{u+1}).homEquiv
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) Fs φ) = _
      rw [he2, Adjunction.homEquiv_unit, sheafificationAdjunction_unit_app]
      rfl
    have hfun : (fun φ : (presheafToSheaf J AddCommGrpCat.{u+1}).obj
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Fs =>
        φ.hom.app (Opposite.op T)
          ((toSheafify J (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
            (Opposite.op T) (FreeAbelianGroup.of (ULift.up (𝟙 T))))) = ⇑e :=
      funext fun φ => (he φ).symm
    rw [hfun]
    exact e.bijective

  have s3 : ∀ {C : Type (u+1)} [Category.{u} C]
      (J : GrothendieckTopology C) (R : Sheaf J RingCat.{u+1}) (T : C), Limits.IsTerminal T →
      ∀ M : SheafOfModules.{u+1} R,
      Function.Bijective (fun f : SheafOfModules.unit R ⟶ M =>
        f.val.app (Opposite.op T) (1 : R.obj.obj (Opposite.op T))) := by
    intro C _ J R T hT M
    have hev : Function.Bijective (fun s : M.val.sections =>
        (show M.val.obj (Opposite.op T) from s.1 (Opposite.op T))) := by
      constructor
      · intro s s' hss
        apply Subtype.ext
        funext X
        have e1 := s.2 (hT.from X.unop).op
        have e2 := s'.2 (hT.from X.unop).op
        simp only at hss
        rw [← e1, ← e2, hss]
      · intro m
        refine ⟨PresheafOfModules.sectionsMk (fun X => M.val.map (hT.from X.unop).op m) ?_, ?_⟩
        · intro X Y f
          rw [← PresheafOfModules.map_comp_apply]
          exact PresheafOfModules.congr_map_apply M.val (Quiver.Hom.unop_inj (hT.hom_ext _ _)) m
        · change M.val.map (hT.from T).op m = m
          rw [show hT.from T = 𝟙 T from hT.hom_ext _ _]
          simp only [op_id, PresheafOfModules.map_id]
          rfl
    have hfun : (fun f : SheafOfModules.unit R ⟶ M =>
        f.val.app (Opposite.op T) (1 : R.obj.obj (Opposite.op T))) =
        (fun s : M.val.sections =>
          (show M.val.obj (Opposite.op T) from s.1 (Opposite.op T))) ∘
            ⇑(SheafOfModules.unitHomEquiv M) := by
      funext f
      simp [SheafOfModules.unitHomEquiv_apply_coe]
    rw [hfun]
    exact hev.comp (SheafOfModules.unitHomEquiv M).bijective

  have s4 : ∀ {C : Type (u+1)} [Category.{u} C] {J : GrothendieckTopology C}
      {R R' : Sheaf J RingCat.{u+1}} (α : R ⟶ R') (V : Cᵒᵖ),
      (wcUnitRestrict α).val.app V (1 : R.obj.obj V) =
        (show ((SheafOfModules.restrictScalars α).obj (SheafOfModules.unit R')).val.obj V from
          (1 : R'.obj.obj V)) := fun α V =>
    (SheafOfModules.unitHomEquiv_apply_coe _ (wcUnitRestrict α) V).symm.trans
      (congrArg (fun s => (s : PresheafOfModules.sections _).1 V)
        (Equiv.apply_symm_apply (SheafOfModules.unitHomEquiv _) _))

  have bij_help : ∀ {α β γ : Type (u+1)} (ev : β → γ) (Θ : α → β) (e : α → γ),
      Function.Bijective ev → Function.Bijective e → (∀ a, ev (Θ a) = e a) →
      Function.Bijective Θ := by
    intro α β γ ev Θ e hev he hc
    refine ⟨fun a b hab => he.1 ((hc a).symm.trans ((congrArg ev hab).trans (hc b))), fun b => ?_⟩
    obtain ⟨a, ha⟩ := he.2 (ev b)
    exact ⟨a, hev.1 ((hc a).trans ha)⟩

  have key : ∀ (S : Scheme.{u}) (U : S.ProEt)
      (R R' : Sheaf ((Scheme.ProEt.topology S).over U) RingCat.{u+1}) (α : R ⟶ R'),
      ∃ (Z : Sheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1})
        (ε₁ : Z ⟶ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj (wcFreeSheaf S U))
        (εΛ : Z ⟶ (SheafOfModules.toSheaf R).obj (SheafOfModules.unit R)),
        (∀ Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
          Function.Bijective (fun f : wcFreeSheaf S U ⟶ Y =>
            ε₁ ≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).map f)) ∧
        (∀ M : SheafOfModules.{u+1} R,
          Function.Bijective (fun f : SheafOfModules.unit R ⟶ M =>
            εΛ ≫ (SheafOfModules.toSheaf R).map f)) ∧
        (∀ M : SheafOfModules.{u+1} R',
          Function.Bijective (fun f : SheafOfModules.unit R' ⟶ M =>
            (εΛ ≫ (SheafOfModules.toSheaf R).map (wcUnitRestrict α)) ≫
              (SheafOfModules.toSheaf R').map f)) := by
    intro S U R R' α
    obtain ⟨Z, γ, hZ⟩ : ∃ (Z : Sheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1})
        (γ : Z.obj.obj (Opposite.op (Over.mk (𝟙 U)))),
        ∀ Fs : Sheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1},
          Function.Bijective (fun φ : Z ⟶ Fs => φ.hom.app (Opposite.op (Over.mk (𝟙 U))) γ) :=
      ⟨(presheafToSheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}).obj
          (yoneda.obj (Over.mk (𝟙 U)) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free),
        (toSheafify ((Scheme.ProEt.topology S).over U)
          (yoneda.obj (Over.mk (𝟙 U)) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
          (Opposite.op (Over.mk (𝟙 U))) (FreeAbelianGroup.of (ULift.up (𝟙 (Over.mk (𝟙 U))))),
        fun Fs => s1 ((Scheme.ProEt.topology S).over U) (Over.mk (𝟙 U)) Fs⟩
    obtain ⟨γU, hUb⟩ : ∃ γU : (wcFreeSheaf S U).obj.obj (Opposite.op U),
        ∀ Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
          Function.Bijective (fun f : wcFreeSheaf S U ⟶ Y => f.hom.app (Opposite.op U) γU) :=
      ⟨(toSheafify (Scheme.ProEt.topology S)
          (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
          (Opposite.op U) (FreeAbelianGroup.of (ULift.up (𝟙 U))),
        fun Y => s1 (Scheme.ProEt.topology S) U Y⟩
    have hT : Limits.IsTerminal (Over.mk (𝟙 U)) := Over.mkIdTerminal
    obtain ⟨ε₁, e1⟩ := (hZ (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj
      (wcFreeSheaf S U))).2 γU
    obtain ⟨εΛ, e2⟩ := (hZ ((SheafOfModules.toSheaf R).obj (SheafOfModules.unit R))).2
      (1 : R.obj.obj (Opposite.op (Over.mk (𝟙 U))))
    refine ⟨Z, ε₁, εΛ, ?_, ?_, ?_⟩
    · intro Y
      refine bij_help
        (fun φ : Z ⟶ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj Y =>
          φ.hom.app (Opposite.op (Over.mk (𝟙 U))) γ)
        (fun f : wcFreeSheaf S U ⟶ Y =>
          ε₁ ≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).map f)
        (fun f : wcFreeSheaf S U ⟶ Y => f.hom.app (Opposite.op U) γU)
        (hZ _) (hUb Y) (fun f => ?_)
      exact congrArg (fun x => (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).map
        f).hom.app (Opposite.op (Over.mk (𝟙 U))) x) e1
    · intro M
      refine bij_help
        (fun φ : Z ⟶ (SheafOfModules.toSheaf R).obj M =>
          φ.hom.app (Opposite.op (Over.mk (𝟙 U))) γ)
        (fun f : SheafOfModules.unit R ⟶ M => εΛ ≫ (SheafOfModules.toSheaf R).map f)
        (fun f : SheafOfModules.unit R ⟶ M =>
          f.val.app (Opposite.op (Over.mk (𝟙 U)))
            (1 : R.obj.obj (Opposite.op (Over.mk (𝟙 U)))))
        (hZ _) (s3 _ R (Over.mk (𝟙 U)) hT M) (fun f => ?_)
      exact congrArg (fun x => ((SheafOfModules.toSheaf R).map
        f).hom.app (Opposite.op (Over.mk (𝟙 U))) x) e2
    · intro M
      refine bij_help
        (fun φ : Z ⟶ (SheafOfModules.toSheaf R').obj M =>
          φ.hom.app (Opposite.op (Over.mk (𝟙 U))) γ)
        (fun f : SheafOfModules.unit R' ⟶ M =>
          (εΛ ≫ (SheafOfModules.toSheaf R).map (wcUnitRestrict α)) ≫
            (SheafOfModules.toSheaf R').map f)
        (fun f : SheafOfModules.unit R' ⟶ M =>
          f.val.app (Opposite.op (Over.mk (𝟙 U)))
            (1 : R'.obj.obj (Opposite.op (Over.mk (𝟙 U)))))
        (hZ _) (s3 _ R' (Over.mk (𝟙 U)) hT M) (fun f => ?_)
      show f.val.app (Opposite.op (Over.mk (𝟙 U)))
          ((wcUnitRestrict α).val.app (Opposite.op (Over.mk (𝟙 U)))
            (εΛ.hom.app (Opposite.op (Over.mk (𝟙 U))) γ)) = _
      exact (congrArg (fun x => f.val.app (Opposite.op (Over.mk (𝟙 U)))
          ((wcUnitRestrict α).val.app (Opposite.op (Over.mk (𝟙 U))) x)) e2).trans
        (congrArg (fun x => f.val.app (Opposite.op (Over.mk (𝟙 U))) x)
          (s4 α (Opposite.op (Over.mk (𝟙 U)))))
  exact key X.left (wcGeomPoint F X h) (wcIntSliceRing F X h ℓ) (wcSliceRing F X h ℓ)
    (wcIntRatSliceMap F X h ℓ)

theorem wc_int_slice_unit_isos : ∀ (F : Type u) [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)],
    ∃ (ιZ : (SheafOfModules.toSheaf (wcIntSliceRing F X h ℓ)).obj
          (SheafOfModules.unit (wcIntSliceRing F X h ℓ)) ≅
        ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)).obj
          (wcIntSheaf X.left ℓ))
      (ιQ : (SheafOfModules.toSheaf (wcSliceRing F X h ℓ)).obj
          (SheafOfModules.unit (wcSliceRing F X h ℓ)) ≅
        ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)).obj
          (wcLadicSheaf X.left ℓ)),
      (SheafOfModules.toSheaf (wcIntSliceRing F X h ℓ)).map
          (wcUnitRestrict (wcIntRatSliceMap F X h ℓ)) ≫ ιQ.hom =
        ιZ.hom ≫ ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1}
          (wcGeomPoint F X h)).map (wcIntToLadic X.left ℓ) :=
by
  intro F _ X h ℓ _
  let GZ := (SheafOfModules.toSheaf.{u+1} (wcIntSliceRing F X h ℓ)).obj
    (SheafOfModules.unit (wcIntSliceRing F X h ℓ))
  let jZ := ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1}
    (wcGeomPoint F X h)).obj (wcIntSheaf X.left ℓ)
  let eZ : ∀ V : (Over (wcGeomPoint F X h))ᵒᵖ, GZ.obj.obj V ≅ jZ.obj.obj V := fun V =>
    { hom := AddCommGrpCat.ofHom
        { toFun := fun r => (ULift.up ((ContinuousMap.mk ULift.down continuous_uliftDown).comp
              (r : C(↥V.unop.left.left, ULift.{u+1} ℤ_[ℓ]))) :
              ULift.{u+1} C(↥V.unop.left.left, ℤ_[ℓ]))
          map_zero' := ULift.ext _ _ (ContinuousMap.ext fun _ => rfl)
          map_add' := fun _ _ => ULift.ext _ _ (ContinuousMap.ext fun _ => rfl) }
      inv := AddCommGrpCat.ofHom
        { toFun := fun w => ((ContinuousMap.mk ULift.up continuous_uliftUp).comp
              (w.down : C(↥V.unop.left.left, ℤ_[ℓ])) : C(↥V.unop.left.left, ULift.{u+1} ℤ_[ℓ]))
          map_zero' := ContinuousMap.ext fun _ => rfl
          map_add' := fun _ _ => ContinuousMap.ext fun _ => rfl }
      hom_inv_id := by
        apply AddCommGrpCat.ext
        intro r
        rfl
      inv_hom_id := by
        apply AddCommGrpCat.ext
        intro w
        rfl }
  let NZ : GZ.obj ≅ jZ.obj := NatIso.ofComponents eZ (fun {V W} f => by
    apply AddCommGrpCat.ext
    intro r
    rfl)
  let ιZ : GZ ≅ jZ := ObjectProperty.isoMk _ NZ
  let G1 := (SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)).obj
    (SheafOfModules.unit (wcSliceRing F X h ℓ))
  let jQ := ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1}
    (wcGeomPoint F X h)).obj (wcLadicSheaf X.left ℓ)
  let e : ∀ V : (Over (wcGeomPoint F X h))ᵒᵖ, G1.obj.obj V ≅ jQ.obj.obj V := fun V =>
    { hom := AddCommGrpCat.ofHom
        { toFun := fun r => (ULift.up ((ContinuousMap.mk ULift.down continuous_uliftDown).comp
              (r : C(↥V.unop.left.left, ULift.{u+1} ℚ_[ℓ]))) :
              ULift.{u+1} C(↥V.unop.left.left, ℚ_[ℓ]))
          map_zero' := ULift.ext _ _ (ContinuousMap.ext fun _ => rfl)
          map_add' := fun _ _ => ULift.ext _ _ (ContinuousMap.ext fun _ => rfl) }
      inv := AddCommGrpCat.ofHom
        { toFun := fun w => ((ContinuousMap.mk ULift.up continuous_uliftUp).comp
              (w.down : C(↥V.unop.left.left, ℚ_[ℓ])) : C(↥V.unop.left.left, ULift.{u+1} ℚ_[ℓ]))
          map_zero' := ContinuousMap.ext fun _ => rfl
          map_add' := fun _ _ => ContinuousMap.ext fun _ => rfl }
      hom_inv_id := by
        apply AddCommGrpCat.ext
        intro r
        rfl
      inv_hom_id := by
        apply AddCommGrpCat.ext
        intro w
        rfl }
  let N : G1.obj ≅ jQ.obj := NatIso.ofComponents e (fun {V W} f => by
    apply AddCommGrpCat.ext
    intro r
    rfl)
  let ιQ : G1 ≅ jQ := ObjectProperty.isoMk _ N
  refine ⟨ιZ, ιQ, ?_⟩
  apply Sheaf.hom_ext
  apply NatTrans.ext
  funext V
  apply AddCommGrpCat.ext
  intro r
  change (_ : ULift.{u+1} C(↥V.unop.left.left, ℚ_[ℓ])) = _
  apply ULift.ext
  apply ContinuousMap.ext
  intro t
  show ((((@id C(↥V.unop.left.left, ULift.{u+1} ℤ_[ℓ]) r) t).down : ℤ_[ℓ]) : ℚ_[ℓ]) * 1 =
    ((((@id C(↥V.unop.left.left, ULift.{u+1} ℤ_[ℓ]) r) t).down : ℤ_[ℓ]) : ℚ_[ℓ])
  exact mul_one _

theorem proet_qcqs_ladic_rationalization : ∀ (S : Scheme.{u}) (U : S.ProEt) [CompactSpace U.left]
    [QuasiSeparatedSpace U.left] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (i : ℕ),
    (∀ x : Abelian.Ext (wcFreeSheaf S U) (wcLadicSheaf S ℓ) i, ∃ (n : ℕ)
      (y : Abelian.Ext (wcFreeSheaf S U) (wcIntSheaf S ℓ) i),
      ℓ ^ n • x = y.comp (Abelian.Ext.mk₀ (wcIntToLadic S ℓ)) (add_zero i)) ∧
    (∀ y : Abelian.Ext (wcFreeSheaf S U) (wcIntSheaf S ℓ) i,
      y.comp (Abelian.Ext.mk₀ (wcIntToLadic S ℓ)) (add_zero i) = 0 → ∃ r : ℕ, ℓ ^ r • y = 0) :=
by
  intro S U _ _ ℓ _ i
  classical

  haveI hex : HasExactColimitsOfShape ℕ (Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) :=
    @Sheaf.hasExactColimitsOfShape _ AddCommGrpCat.{u+1} ℕ _ _ _ (Scheme.ProEt.topology S) _ _ _
      (@HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1} _ _ _ _ _
        (ULiftHomULiftCategory.equiv.{u+1, u+1} ℕ).symm _ (AB5OfSize.ofShape _))

  have H0 : ∀ (G : ℕ ⥤ Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (c : Limits.Cocone G), Limits.IsColimit c →
      ∀ g : wcFreeSheaf S U ⟶ c.pt, ∃ (n : ℕ) (g' : wcFreeSheaf S U ⟶ G.obj n),
        g = g' ≫ c.ι.app n :=
    fun G c hc => (proet_free_hom_seq_colimit S U G c hc).1
  have H0' : ∀ (G : ℕ ⥤ Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (c : Limits.Cocone G), Limits.IsColimit c →
      ∀ (n : ℕ) (g' : wcFreeSheaf S U ⟶ G.obj n), g' ≫ c.ι.app n = 0 →
        ∃ (m : ℕ) (hnm : n ≤ m), g' ≫ G.map (homOfLE hnm) = 0 :=
    fun G c hc => (proet_free_hom_seq_colimit S U G c hc).2
  have H1 : ∀ G : ℕ ⥤ Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
      ∃ (I : ℕ ⥤ Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (α : G ⟶ I),
        Mono α ∧ (∀ n, Injective (I.obj n)) ∧ ∀ (c : Limits.Cocone I), Limits.IsColimit c →
          ∀ (k : ℕ) (x : Abelian.Ext (wcFreeSheaf S U) c.pt (k + 1)), x = 0 := by
    intro G
    obtain ⟨I, α, hα, hI⟩ := injective_tower_of_tower G
    exact ⟨I, α, hα, hI, fun c hc k x => proet_ext_colimit_injectives_vanish S U I hI c hc k x⟩
  have H1lift : ∀ G : ℕ ⥤ Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
      ∃ (I : ℕ ⥤ Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (α : G ⟶ I),
        Mono α ∧ ∀ (c : Limits.Cocone I), Limits.IsColimit c →
          ∀ (k : ℕ) (x : Abelian.Ext (wcFreeSheaf S U) c.pt (k + 1)), x = 0 := by
    intro G
    obtain ⟨I, α, hα, _, hv⟩ := H1 G
    exact ⟨I, α, hα, hv⟩

  have hinj0 : ∀ {A B : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (a b : A ⟶ B),
      (Abelian.Ext.mk₀ a : Abelian.Ext A B 0) = Abelian.Ext.mk₀ b → a = b := by
    intro A B a b h
    rw [← Abelian.Ext.homEquiv₀_symm_apply, ← Abelian.Ext.homEquiv₀_symm_apply] at h
    exact Abelian.Ext.homEquiv₀.symm.injective h

  have s7 : ∀ {X Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} {n : ℕ}
      (x : Abelian.Ext X Y n) (m : ℕ), x.comp (Abelian.Ext.mk₀ (m • 𝟙 Y)) (add_zero n) = m • x := by
    intro X Y n x m
    induction m with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    | succ m ih =>
      rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih,
        Abelian.Ext.comp_mk₀_id]

  have s6 : ∀ (X : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (R : Type)
      [AddMonoidWithOne R] (σ : R → (X ⟶ X)), σ 1 = 𝟙 X → (∀ a b : R, σ (a + b) = σ a + σ b) →
      ∀ k : ℕ, σ (k : R) = k • 𝟙 X := by
    intro X R _ σ h1 hadd k
    have h0 : σ 0 = 0 := by
      have h := hadd 0 0
      rw [add_zero] at h
      exact add_eq_left.mp h.symm
    induction k with
    | zero => rw [Nat.cast_zero, h0, zero_nsmul]
    | succ k ih => rw [Nat.cast_succ, hadd, ih, h1, succ_nsmul]

  have K : ∀ (j : ℕ) (G : ℕ ⥤ Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (n : ℕ)
      (y : Abelian.Ext (wcFreeSheaf S U) (G.obj n) j),
      y.comp (Abelian.Ext.mk₀ (Limits.colimit.ι G n)) (add_zero j) = 0 →
      ∃ (m : ℕ) (hnm : n ≤ m), y.comp (Abelian.Ext.mk₀ (G.map (homOfLE hnm))) (add_zero j) = 0 := by
    intro j
    induction j with
    | zero =>
      intro G n y hy
      have hg : Abelian.Ext.homEquiv₀ y ≫ Limits.colimit.ι G n = 0 := by
        rw [← Abelian.Ext.mk₀_eq_zero_iff, ← Abelian.Ext.mk₀_comp_mk₀,
          Abelian.Ext.mk₀_homEquiv₀_apply]
        exact hy
      obtain ⟨m, hnm, hm⟩ :=
        H0' G (Limits.colimit.cocone G) (Limits.colimit.isColimit G) n _ hg
      refine ⟨m, hnm, ?_⟩
      rw [← Abelian.Ext.mk₀_homEquiv₀_apply y, Abelian.Ext.mk₀_comp_mk₀, hm, Abelian.Ext.mk₀_zero]
    | succ j ih =>
      intro G n y hy
      obtain ⟨I, α, hα, hinj, hvan⟩ := H1 G
      let S' : ShortComplex (ℕ ⥤ Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) :=
        ShortComplex.mk α (Limits.cokernel.π α) (Limits.cokernel.condition α)
      have hS : S'.ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel α) hα inferInstance
      have hSc : (S'.map Limits.colim).ShortExact := hS.map_of_exact Limits.colim
      have hSn : (S'.map ((evaluation ℕ _).obj n)).ShortExact := hS.map_of_exact _

      have hyα : y.comp (Abelian.Ext.mk₀ (S'.map ((evaluation ℕ _).obj n)).f) (add_zero _) = 0 := by
        haveI : Injective (S'.map ((evaluation ℕ _).obj n)).X₂ := hinj n
        exact Abelian.Ext.eq_zero_of_injective _
      obtain ⟨z, hz⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hSn y hyα (n₀ := j) rfl

      let φ : S'.map ((evaluation ℕ _).obj n) ⟶ S'.map Limits.colim :=
        ShortComplex.homMk (Limits.colimit.ι G n) (Limits.colimit.ι I n)
          (Limits.colimit.ι (Limits.cokernel α) n)
          (Limits.colimit.ι_map α n) (Limits.colimit.ι_map _ n)
      have hnat : hSn.extClass.comp (Abelian.Ext.mk₀ (Limits.colimit.ι G n)) (add_zero 1) =
          (Abelian.Ext.mk₀ (Limits.colimit.ι (Limits.cokernel α) n)).comp hSc.extClass
            (zero_add 1) := hSn.extClass_naturality hSc φ
      have hz' : (z.comp (Abelian.Ext.mk₀ (Limits.colimit.ι (Limits.cokernel α) n))
          (add_zero j)).comp hSc.extClass rfl = 0 := by
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero j) (zero_add 1) (by omega), ← hnat,
          ← Abelian.Ext.comp_assoc _ _ _ rfl (add_zero 1) (by omega), hz]
        exact hy
      obtain ⟨w, hw⟩ := Abelian.Ext.covariant_sequence_exact₃ _ hSc _ rfl hz'

      have hD : ∃ (M : ℕ) (hnM : n ≤ M) (u : Abelian.Ext (wcFreeSheaf S U) (I.obj M) j),
          z.comp (Abelian.Ext.mk₀ ((Limits.cokernel α).map (homOfLE hnM))) (add_zero j) =
            u.comp (Abelian.Ext.mk₀ ((Limits.cokernel.π α).app M)) (add_zero j) := by
        cases j with
        | succ k =>
          have hw0 : w = 0 := hvan (Limits.colimit.cocone I) (Limits.colimit.isColimit I) k w
          have hz'0 : z.comp (Abelian.Ext.mk₀ (Limits.colimit.ι (Limits.cokernel α) n))
              (add_zero _) = 0 := by
            rw [← hw, hw0, Abelian.Ext.zero_comp]
          obtain ⟨M, hnM, hM⟩ := ih (Limits.cokernel α) n z hz'0
          exact ⟨M, hnM, 0, hM.trans (by rw [Abelian.Ext.zero_comp])⟩
        | zero =>
          obtain ⟨z₀, rfl⟩ : ∃ z₀, z = Abelian.Ext.mk₀ z₀ :=
            ⟨_, (Abelian.Ext.mk₀_homEquiv₀_apply z).symm⟩
          obtain ⟨w₀, rfl⟩ : ∃ w₀, w = Abelian.Ext.mk₀ w₀ :=
            ⟨_, (Abelian.Ext.mk₀_homEquiv₀_apply w).symm⟩
          rw [Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀] at hw
          have hE : w₀ ≫ Limits.colim.map (Limits.cokernel.π α) =
              z₀ ≫ Limits.colimit.ι (Limits.cokernel α) n := hinj0 _ _ hw
          obtain ⟨n', w', hw'⟩ := H0 I (Limits.colimit.cocone I) (Limits.colimit.isColimit I) w₀
          have hw'' : w₀ = w' ≫ Limits.colimit.ι I n' := hw'
          obtain ⟨N, hnN, hn'N⟩ : ∃ N, n ≤ N ∧ n' ≤ N :=
            ⟨max n n', le_max_left _ _, le_max_right _ _⟩
          have e1 : z₀ ≫ (Limits.cokernel α).map (homOfLE hnN) ≫
              Limits.colimit.ι (Limits.cokernel α) N =
              z₀ ≫ Limits.colimit.ι (Limits.cokernel α) n := by
            rw [Limits.colimit.w]
          have e2 : w' ≫ I.map (homOfLE hn'N) ≫ (Limits.cokernel.π α).app N ≫
              Limits.colimit.ι (Limits.cokernel α) N =
              w₀ ≫ Limits.colim.map (Limits.cokernel.π α) := by
            rw [← Limits.colimit.ι_map, Limits.colimit.w_assoc, hw'', Category.assoc]
          have hd : (z₀ ≫ (Limits.cokernel α).map (homOfLE hnN) -
              w' ≫ I.map (homOfLE hn'N) ≫ (Limits.cokernel.π α).app N) ≫
              Limits.colimit.ι (Limits.cokernel α) N = 0 := by
            simp only [Preadditive.sub_comp, Category.assoc]
            rw [e1, e2, hE, sub_self]
          obtain ⟨M, hNM, hM⟩ := H0' (Limits.cokernel α) (Limits.colimit.cocone _)
            (Limits.colimit.isColimit _) N _ hd
          refine ⟨M, hnN.trans hNM,
            Abelian.Ext.mk₀ (w' ≫ I.map (homOfLE (hn'N.trans hNM))), ?_⟩
          rw [Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀]
          congr 1
          have q1 : (Limits.cokernel α).map (homOfLE (hnN.trans hNM)) =
              (Limits.cokernel α).map (homOfLE hnN) ≫ (Limits.cokernel α).map (homOfLE hNM) := by
            rw [← Functor.map_comp, homOfLE_comp]
          have q2 : I.map (homOfLE (hn'N.trans hNM)) =
              I.map (homOfLE hn'N) ≫ I.map (homOfLE hNM) := by
            rw [← Functor.map_comp, homOfLE_comp]
          have q3 : (Limits.cokernel.π α).app N ≫ (Limits.cokernel α).map (homOfLE hNM) =
              I.map (homOfLE hNM) ≫ (Limits.cokernel.π α).app M :=
            ((Limits.cokernel.π α).naturality (homOfLE hNM)).symm
          rw [Preadditive.sub_comp, sub_eq_zero] at hM
          rw [q1, q2]
          simp only [Category.assoc] at hM ⊢
          rw [hM, q3]

      obtain ⟨M, hnM, u, hu⟩ := hD
      have hSM : (S'.map ((evaluation ℕ _).obj M)).ShortExact := hS.map_of_exact _
      let ψ : S'.map ((evaluation ℕ _).obj n) ⟶ S'.map ((evaluation ℕ _).obj M) :=
        ShortComplex.homMk (G.map (homOfLE hnM)) (I.map (homOfLE hnM))
          ((Limits.cokernel α).map (homOfLE hnM))
          (α.naturality (homOfLE hnM)) ((Limits.cokernel.π α).naturality (homOfLE hnM))
      have hnat' : hSn.extClass.comp (Abelian.Ext.mk₀ (G.map (homOfLE hnM))) (add_zero 1) =
          (Abelian.Ext.mk₀ ((Limits.cokernel α).map (homOfLE hnM))).comp hSM.extClass
            (zero_add 1) := hSn.extClass_naturality hSM ψ
      have h0 : (Abelian.Ext.mk₀ ((Limits.cokernel.π α).app M)).comp hSM.extClass (zero_add 1) = 0 :=
        hSM.comp_extClass
      refine ⟨M, hnM, ?_⟩
      rw [← hz, Abelian.Ext.comp_assoc _ _ _ rfl (add_zero 1) (by omega), hnat',
        ← Abelian.Ext.comp_assoc _ _ _ (add_zero j) (zero_add 1) (by omega), hu,
        Abelian.Ext.comp_assoc _ _ _ (add_zero j) (zero_add 1) (by omega), h0,
        Abelian.Ext.comp_zero]

  obtain ⟨κ, ⟨hκ⟩, hκapp⟩ := wc_ladic_tower_colimit S ℓ
  have hσ1 : wcLadicScalar S ℓ 1 = 𝟙 _ := (wc_ladic_scalar_ring S ℓ).1
  have hσadd := (wc_ladic_scalar_ring S ℓ).2.2
  have hZ1 : wcIntScalar S ℓ 1 = 𝟙 _ := (wc_int_scalar_ring S ℓ).1
  have hZadd := (wc_int_scalar_ring S ℓ).2.2.1
  refine ⟨?_, ?_⟩
  ·
    intro x
    obtain ⟨n, y, hy⟩ := ext_seq_colimit_lift_of_acyclic
      (wcFreeSheaf S U) H0 H1lift i _ (Limits.Cocone.mk _ κ) hκ x
    refine ⟨n, y, ?_⟩
    have hl : (ℓ : ℚ_[ℓ]) ^ n ≠ 0 :=
      pow_ne_zero _ (Nat.cast_ne_zero.mpr (Fact.out : Nat.Prime ℓ).ne_zero)
    let y' : Abelian.Ext (wcFreeSheaf S U) (wcIntSheaf S ℓ) i := y
    have hy' : x = y'.comp (Abelian.Ext.mk₀ (wcIntToLadic S ℓ ≫
        wcLadicScalar S ℓ (((ℓ : ℚ_[ℓ]) ^ n)⁻¹))) (add_zero i) := by
      rw [hy]
      exact congrArg (fun f => y.comp (Abelian.Ext.mk₀ f) (add_zero i)) (hκapp n)
    have hσℓ : wcLadicScalar S ℓ ((ℓ : ℚ_[ℓ]) ^ n) = (ℓ ^ n) • 𝟙 (wcLadicSheaf S ℓ) := by
      rw [← Nat.cast_pow]
      exact s6 _ ℚ_[ℓ] (wcLadicScalar S ℓ) hσ1 hσadd (ℓ ^ n)
    have hσmul : wcLadicScalar S ℓ (((ℓ : ℚ_[ℓ]) ^ n) * ((ℓ : ℚ_[ℓ]) ^ n)⁻¹) =
        wcLadicScalar S ℓ (((ℓ : ℚ_[ℓ]) ^ n)⁻¹) ≫ wcLadicScalar S ℓ ((ℓ : ℚ_[ℓ]) ^ n) :=
      (wc_ladic_scalar_ring S ℓ).2.1 _ _
    show ℓ ^ n • x = y'.comp (Abelian.Ext.mk₀ (wcIntToLadic S ℓ)) (add_zero i)
    rw [← s7 x (ℓ ^ n), ← hσℓ, hy',
      Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, Category.assoc, ← hσmul, mul_inv_cancel₀ hl, hσ1,
      Category.comp_id]
  ·
    intro y hy0
    let G : ℕ ⥤ Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} :=
      Functor.ofSequence (X := fun _ : ℕ => wcIntSheaf S ℓ) (fun _ => wcIntScalar S ℓ (ℓ : ℤ_[ℓ]))
    have hZℓ : wcIntScalar S ℓ (ℓ : ℤ_[ℓ]) = ℓ • 𝟙 (wcIntSheaf S ℓ) :=
      s6 _ ℤ_[ℓ] (wcIntScalar S ℓ) hZ1 hZadd ℓ
    have s8 : ∀ (m : ℕ) (h : 0 ≤ m), G.map (homOfLE h) = (ℓ ^ m) • 𝟙 (wcIntSheaf S ℓ) := by
      intro m
      induction m with
      | zero =>
        intro h
        have e : (homOfLE h : (0 : ℕ) ⟶ 0) = 𝟙 0 := Subsingleton.elim _ _
        rw [e, G.map_id, pow_zero, one_nsmul]
        rfl
      | succ m ih =>
        intro h
        have e : (homOfLE h : (0 : ℕ) ⟶ m + 1) =
            homOfLE (Nat.zero_le m) ≫ homOfLE (Nat.le_succ m) := Subsingleton.elim _ _
        have e2 : G.map (homOfLE (Nat.le_succ m)) = wcIntScalar S ℓ (ℓ : ℤ_[ℓ]) :=
          Functor.ofSequence_map_homOfLE_succ _ m
        rw [e, G.map_comp, ih, e2, hZℓ]
        have key : ((ℓ ^ m) • 𝟙 (wcIntSheaf S ℓ)) ≫ (ℓ • 𝟙 (wcIntSheaf S ℓ)) =
            ℓ ^ (m + 1) • 𝟙 (wcIntSheaf S ℓ) := by
          rw [Preadditive.nsmul_comp, Category.id_comp, ← mul_nsmul, ← pow_succ']
        exact key
    have hκ0 : κ.app 0 = wcIntToLadic S ℓ := by
      rw [hκapp 0, pow_zero, inv_one, hσ1, Category.comp_id]
    let e := hκ.coconePointUniqueUpToIso (Limits.colimit.isColimit G)
    have hι : κ.app 0 ≫ e.hom = Limits.colimit.ι G 0 :=
      Limits.IsColimit.comp_coconePointUniqueUpToIso_hom hκ (Limits.colimit.isColimit G) 0
    let y₀ : Abelian.Ext (wcFreeSheaf S U) (G.obj 0) i := y
    have h2 : y₀.comp (Abelian.Ext.mk₀ (κ.app 0)) (add_zero i) = 0 := by
      rw [hκ0]
      exact hy0
    have hy1 : y₀.comp (Abelian.Ext.mk₀ (Limits.colimit.ι G 0)) (add_zero i) = 0 := by
      rw [← hι, ← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.comp_assoc_of_third_deg_zero, h2,
        Abelian.Ext.zero_comp]
    obtain ⟨m, hm, hdead⟩ := K i G 0 y₀ hy1
    rw [s8 m hm] at hdead
    refine ⟨m, ?_⟩
    rw [← s7 y (ℓ ^ m)]
    exact hdead

theorem wc_intmodcoh_rationalization (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [IsProper X.hom]
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    ∃ ι : ∀ n : ℕ, wcIntModCoh F X h ℓ n →+ wcModCoh F X h ℓ n,
      (∀ (i j k : ℕ) (hk : i + j = k) (a : wcIntModCoh F X h ℓ i) (b : wcIntModCoh F X h ℓ j),
        ι k (wcIntModCup F X h ℓ i j k hk a b) = wcModCup F X h ℓ i j k hk (ι i a) (ι j b)) ∧
      (∀ (n : ℕ) (x : wcModCoh F X h ℓ n), ∃ (k : ℕ) (a : wcIntModCoh F X h ℓ n),
        ι n a = ℓ ^ k • x) ∧
      (∀ (n : ℕ) (a : wcIntModCoh F X h ℓ n), ι n a = 0 → ∃ r : ℕ, ℓ ^ r • a = 0) :=
by
  classical
  letI hD : HasExt (Sheaf ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h))
      AddCommGrpCat.{u+1}) := HasExt.standard _
  letI hΛ : HasExt (SheafOfModules.{u+1} (wcIntSliceRing F X h ℓ)) := HasExt.standard _
  letI hR : HasExt (SheafOfModules.{u+1} (wcSliceRing F X h ℓ)) := HasExt.standard _

  haveI : IsProper (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) := inferInstance
  have hqc : QuasiCompact (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) := inferInstance
  have hqs : QuasiSeparated (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) := inferInstance
  haveI : CompactSpace (wcGeomPoint F X h).left := by
    exact @QuasiCompact.compactSpace_of_compactSpace _ _ (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) hqc _
  haveI : QuasiSeparatedSpace (wcGeomPoint F X h).left := by
    exact @quasiSeparatedSpace_of_quasiSeparated _ _ (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) _ hqs

  have htfΛ : ∀ (V : (Over (wcGeomPoint F X h))ᵒᵖ) (m : ℕ)
      (r : ↑((wcIntSliceRing F X h ℓ).obj.obj V)), m ≠ 0 → m • r = 0 → r = 0 := by
    intro V m r hm hr
    have key : ∀ (T : Type u) [TopologicalSpace T] (s : C(T, ULift.{u+1} ℤ_[ℓ])),
        m • s = 0 → s = 0 := by
      intro T _ s hs
      refine ContinuousMap.ext fun t => ULift.ext _ _ ?_
      let g : C(T, ULift.{u+1} ℤ_[ℓ]) →+ ℤ_[ℓ] := AddEquiv.ulift.toAddMonoidHom.comp
        ((Pi.evalAddMonoidHom (fun _ : T => ULift.{u+1} ℤ_[ℓ]) t).comp
          ContinuousMap.coeFnAddMonoidHom)
      have h1 : m • g s = 0 := ((map_nsmul g m s).symm.trans (congrArg g hs)).trans (map_zero g)
      rw [nsmul_eq_mul] at h1
      exact (mul_eq_zero.mp h1).resolve_left (Nat.cast_ne_zero.mpr hm)
    exact key ↥((Opposite.unop V).left.left) r hr
  have htfR : ∀ (V : (Over (wcGeomPoint F X h))ᵒᵖ) (m : ℕ)
      (r : ↑((wcSliceRing F X h ℓ).obj.obj V)), m ≠ 0 → m • r = 0 → r = 0 := by
    intro V m r hm hr
    have key : ∀ (T : Type u) [TopologicalSpace T] (s : C(T, ULift.{u+1} ℚ_[ℓ])),
        m • s = 0 → s = 0 := by
      intro T _ s hs
      refine ContinuousMap.ext fun t => ULift.ext _ _ ?_
      let g : C(T, ULift.{u+1} ℚ_[ℓ]) →+ ℚ_[ℓ] := AddEquiv.ulift.toAddMonoidHom.comp
        ((Pi.evalAddMonoidHom (fun _ : T => ULift.{u+1} ℚ_[ℓ]) t).comp
          ContinuousMap.coeFnAddMonoidHom)
      have h1 : m • g s = 0 := ((map_nsmul g m s).symm.trans (congrArg g hs)).trans (map_zero g)
      rw [nsmul_eq_mul] at h1
      exact (mul_eq_zero.mp h1).resolve_left (Nat.cast_ne_zero.mpr hm)
    exact key ↥((Opposite.unop V).left.left) r hr

  obtain ⟨hjA, hjC⟩ := sheafPushforward_additive_finiteColimits
    ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h)) (Scheme.ProEt.topology X.left)
    (Over.forget (wcGeomPoint F X h))
  have hGΛC := sheafOfModules_toSheaf_preservesFiniteColimits
    ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h)) (wcIntSliceRing F X h ℓ)
  have hGRC := sheafOfModules_toSheaf_preservesFiniteColimits
    ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h)) (wcSliceRing F X h ℓ)
  haveI hρL : Limits.PreservesFiniteLimits (wcIntRatRestrict F X h ℓ) := by
