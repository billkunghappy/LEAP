  have e2 : ((sheafify (Scheme.smallEtaleTopology X)
        (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).map h.op).hom
        (((toSheafify (Scheme.smallEtaleTopology X)
