theorem wc_fibration_generic_point_dims : ∀ (K : Type u) [Field K] [IsAlgClosed K] (X B : Scheme.{u}) (fB : B ⟶ Spec (.of K)) [IsProper fB] (g : X ⟶ B) [IsProper g] (n : ℕ), topologicalKrullDim B ≤ (n : WithBot ℕ∞) → (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ B), topologicalKrullDim ↥(Limits.pullback g t) ≤ ((1 : ℕ) : WithBot ℕ∞)) → ∀ (U : X.Opens), IrreducibleSpace ↥U → topologicalKrullDim ↥(U : Set X) = ((n + 1 : ℕ) : WithBot ℕ∞) → ∃ η : B, closure ({η} : Set B) = closure (⇑g '' (U : Set X)) ∧ topologicalKrullDim ↥(closure ({η} : Set B)) = (n : WithBot ℕ∞) ∧ ¬ topologicalKrullDim ↥(⇑g ⁻¹' {η}) ≤ ((0 : ℕ) : WithBot ℕ∞) :=
