    obtain ⟨D, hD⟩ := he τ hτ

    have hτ' : τ ≫ Spec.map (CommRingCat.ofHom (algebraMap (B.residueField η)
        (AlgebraicClosure (B.residueField η)))) = Spec.map (CommRingCat.ofHom
