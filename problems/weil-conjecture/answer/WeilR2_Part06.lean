    obtain ⟨N, hN⟩ : ∃ N : IntermediateField k Ω, N = IntermediateField.normalClosure k L Ω :=
      ⟨_, rfl⟩
    haveI : FiniteDimensional k N := hN ▸ normalClosure.is_finiteDimensional k L Ω
    haveI : IsGalois k N := hN ▸ hGal0
    have hle : ∀ φ : L →ₐ[k] Ω, φ.fieldRange ≤ N := fun φ => hN ▸ φ.fieldRange_le_normalClosure
    let res : (L →ₐ[k] Ω) → (L →ₐ[k] N) := fun φ =>
      { toFun := fun x => ⟨φ x, hle φ (AlgHom.mem_fieldRange.mpr ⟨x, rfl⟩)⟩
        map_one' := Subtype.ext (map_one φ)
        map_mul' := fun x y => Subtype.ext (map_mul φ x y)
        map_zero' := Subtype.ext (map_zero φ)
        map_add' := fun x y => Subtype.ext (map_add φ x y)
