theorem wc_et_zariski_mv_card_le : ∀ (Y : Scheme.{u}) (V A B : Y.Opens), A ⊔ B = V → ∀ (m q : ℕ), Finite (wcEtCoh ((A ⊓ B : Y.Opens) : Scheme.{u}) m q) → Finite (wcEtCoh (A : Scheme.{u}) m (q + 1)) → Finite (wcEtCoh (B : Scheme.{u}) m (q + 1)) → Finite (wcEtCoh (V : Scheme.{u}) m (q + 1)) ∧ Nat.card (wcEtCoh (V : Scheme.{u}) m (q + 1)) ≤ Nat.card (wcEtCoh ((A ⊓ B : Y.Opens) : Scheme.{u}) m q) * (Nat.card (wcEtCoh (A : Scheme.{u}) m (q + 1)) * Nat.card (wcEtCoh (B : Scheme.{u}) m (q + 1))) :=
by
  classical
  intro Y V A B hAB m q hfAB hfA hfB



  have count : ∀ {G H P₁ P₂ : Type (u+2)} [AddCommGroup G] [AddCommGroup H] [AddCommGroup P₁]
      [AddCommGroup P₂] (δ : G →+ H) (ρ₁ : H →+ P₁) (ρ₂ : H →+ P₂),
      Finite G → Finite P₁ → Finite P₂ →
      (∀ x : H, ρ₁ x = 0 → ρ₂ x = 0 → ∃ y : G, δ y = x) →
      Finite H ∧ Nat.card H ≤ Nat.card G * (Nat.card P₁ * Nat.card P₂) := by
    intro G H P₁ P₂ _ _ _ _ δ ρ₁ ρ₂ hG hP₁ hP₂ hex
    let ρ : H →+ P₁ × P₂ := ρ₁.prod ρ₂
    have hK : ρ.ker ≤ δ.range := by
      intro x hx
      rw [AddMonoidHom.mem_ker, AddMonoidHom.prod_apply, Prod.mk_eq_zero] at hx
      obtain ⟨y, hy⟩ := hex x hx.1 hx.2
      exact ⟨y, hy⟩
    haveI : Finite δ.range := Finite.of_surjective _ δ.rangeRestrict_surjective
    have h1 : Nat.card δ.range ≤ Nat.card G :=
      Nat.card_le_card_of_surjective _ δ.rangeRestrict_surjective
    haveI : Finite ρ.ker := Finite.of_injective _ (AddSubgroup.inclusion_injective hK)
    have h2 : Nat.card ρ.ker ≤ Nat.card δ.range := AddSubgroup.card_le_of_le hK
    let e := QuotientAddGroup.quotientKerEquivRange ρ
    have hinj : Function.Injective (fun x : ρ.range => (x : P₁ × P₂)) := Subtype.val_injective
    haveI : Finite ρ.range := Finite.of_injective _ hinj
    haveI : Finite (H ⧸ ρ.ker) := Finite.of_equiv _ e.toEquiv.symm
    have h3 : Nat.card (H ⧸ ρ.ker) ≤ Nat.card P₁ * Nat.card P₂ := by
      rw [Nat.card_congr e.toEquiv, ← Nat.card_prod]
      exact Nat.card_le_card_of_injective _ hinj
    have hc := AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup ρ.ker
    have hp1 : 0 < Nat.card (H ⧸ ρ.ker) := Nat.card_pos
    have hp2 : 0 < Nat.card ρ.ker := Nat.card_pos
