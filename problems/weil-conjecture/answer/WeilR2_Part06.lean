  haveI : IsIso (κ ≫ L'.map ι) := hκ
  haveI : IsIso (ϑ.hom.app ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))) := inferInstance
  obtain ⟨G', hG'⟩ : ∃ G', G' ≫ ((κ ≫ L'.map ι) ≫ L'.map ε.inv ≫ ϑ.hom.app ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))) = 𝟙 _ :=
    ⟨inv _, IsIso.inv_hom_id _⟩
  calc x = (Abelian.Ext.mk₀ (G' ≫ ((κ ≫ L'.map ι) ≫ L'.map ε.inv ≫ ϑ.hom.app ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))))).comp x
        (zero_add q) := by rw [hG', Abelian.Ext.mk₀_id_comp]
    _ = (Abelian.Ext.mk₀ (G' ≫ κ ≫ L'.map ι ≫ L'.map ε.inv)).comp
          ((Abelian.Ext.mk₀ (ϑ.hom.app ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))))).comp x (zero_add q)) (zero_add q) := by
        rw [assoc0]; simp only [Category.assoc]
    _ = (Abelian.Ext.mk₀ (G' ≫ κ ≫ L'.map ι ≫ L'.map ε.inv)).comp
          (((Abelian.Ext.mapExactFunctor L' (Abelian.Ext.mapExactFunctor L x)).comp
            (Abelian.Ext.mk₀ (L'.map μ.hom)) (add_zero q)).comp
            (Abelian.Ext.mk₀ (L'.map μ.inv ≫ ϑ.hom.app ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))))) (add_zero q)) (zero_add q) := by
        rw [← hN, assocR, ← Functor.map_comp_assoc, Iso.hom_inv_id, CategoryTheory.Functor.map_id,
          Category.id_comp]
    _ = ((Abelian.Ext.mk₀ (G' ≫ κ)).comp ((Abelian.Ext.mk₀ (L'.map ι ≫ L'.map ε.inv)).comp
          ((Abelian.Ext.mapExactFunctor L' (Abelian.Ext.mapExactFunctor L x)).comp
            (Abelian.Ext.mk₀ (L'.map μ.hom)) (add_zero q)) (zero_add q)) (zero_add q)).comp
            (Abelian.Ext.mk₀ (L'.map μ.inv ≫ ϑ.hom.app ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))))) (add_zero q) := by
        rw [assoc0, assocM]; simp only [Category.assoc]
    _ = 0 := by rw [h1, Abelian.Ext.comp_zero, Abelian.Ext.zero_comp]

theorem wc_et_push_edge_map : ∀ {X B : Scheme.{u}} (g : X ⟶ B) (m : ℕ) (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) (q : ℕ), letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _; ∃ Θ : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) q →+ ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q).obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 B))), ∀ (c : (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ I.cocomplex.X q) (hc : c ≫ I.cocomplex.d q (q + 1) = 0), ∃ κ : ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).cycles q).obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 B))), (((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).iCycles q).hom.app (Opposite.op (Scheme.Etale.mk (𝟙 B)))).hom κ = ((toSheafify (Scheme.smallEtaleTopology B) ((wcEtBaseChange g).op ⋙ (I.cocomplex.X q).obj)).app (Opposite.op (Scheme.Etale.mk (𝟙 B)))).hom ((c.hom.app (Opposite.op ((wcEtBaseChange g).obj (Scheme.Etale.mk (𝟙 B))))).hom (wcConstSec X (ULift.{u+1} ℤ) ((wcEtBaseChange g).obj (Scheme.Etale.mk (𝟙 B))) (ULift.up 1))) ∧ Θ (I.extMk c (q + 1) rfl hc) = (((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homologyπ q).hom.app (Opposite.op (Scheme.Etale.mk (𝟙 B)))).hom κ :=
by
  intro X B g m I q
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _

  have hN : ∀ {A A' : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}} (φ : A ⟶ A')
      (V : B.Etale) (y : A.obj.obj (Opposite.op ((wcEtBaseChange g).obj V))),
      (((wcEtPush g).map φ).hom.app (Opposite.op V)).hom
        (((toSheafify (Scheme.smallEtaleTopology B) ((wcEtBaseChange g).op ⋙ A.obj)).app
          (Opposite.op V)).hom y) =
      ((toSheafify (Scheme.smallEtaleTopology B) ((wcEtBaseChange g).op ⋙ A'.obj)).app
          (Opposite.op V)).hom ((φ.hom.app (Opposite.op ((wcEtBaseChange g).obj V))).hom y) := by
    intro A A' φ V y
    have h := congrArg (fun f => (f.app (Opposite.op V)).hom y)
      (toSheafify_naturality (Scheme.smallEtaleTopology B)
        (Functor.whiskerLeft (wcEtBaseChange g).op φ.hom))
    exact h.symm

  have hPc : ∀ {A : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}} (n : ℕ)
      (c : A ⟶ I.cocomplex.X n), c ≫ I.cocomplex.d n (n + 1) = 0 →
      (wcEtPush g).map c ≫
        (((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).d n (n + 1) = 0 := by
    intro A n c hc
    rw [Functor.mapHomologicalComplex_obj_d, ← Functor.map_comp, hc, Functor.map_zero]

  have hdeg0 : ∀ {A : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}}
      (f : A ⟶ I.cocomplex.X 0) (hf : f ≫ I.cocomplex.d 0 (0 + 1) = 0),
      I.extMk f (0 + 1) rfl hf = 0 → f = 0 := by
    intro A f hf h
    rw [← I.extEquivCohomologyClass.apply_eq_iff_eq, InjectiveResolution.extEquivCohomologyClass_extMk,
      InjectiveResolution.extEquivCohomologyClass_zero,
      CochainComplex.HomComplex.CohomologyClass.mk_eq_zero_iff,
      CochainComplex.HomComplex.Cocycle.fromSingleMk_mem_coboundaries_iff _ _ _ _ _ (-1)
        (by norm_num)] at h
    obtain ⟨g0, hg0⟩ := h
    have hz : Limits.IsZero (I.cochainComplex.X (-1)) :=
      CochainComplex.isZero_of_isStrictlyGE I.cochainComplex 0 (-1) (by norm_num)
    rw [hz.eq_of_tgt g0 0, Limits.zero_comp] at hg0
    have h2 := congrArg (· ≫ (I.cochainComplexXIso _ 0 rfl).hom) hg0
    simpa using h2.symm

  have hker : ∀ (n : ℕ) (c : (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ I.cocomplex.X n) (hc : c ≫ I.cocomplex.d n (n + 1) = 0),
      I.extMk c (n + 1) rfl hc = 0 →
      (((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).liftCycles
        ((wcEtPush g).map c) (n + 1) (by simp) (hPc n c hc) ≫
        (((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homologyπ n = 0 := by
    intro n
    cases n with
    | zero =>
      intro c hc hE
      have hc0 : c = 0 := hdeg0 c hc hE
      have h0 : (((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).liftCycles
          ((wcEtPush g).map c) (0 + 1) (by simp) (hPc 0 c hc) = 0 := by
        rw [← cancel_mono ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj
          I.cocomplex).iCycles 0), HomologicalComplex.liftCycles_i, Limits.zero_comp, hc0,
          Functor.map_zero]
      rw [h0, Limits.zero_comp]
    | succ p =>
      intro c hc hE
      obtain ⟨h, rfl⟩ := (I.extMk_eq_zero_iff c (p + 1 + 1) rfl hc p rfl).1 hE
      have h1 : (((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).liftCycles
          ((wcEtPush g).map (h ≫ I.cocomplex.d p (p + 1))) (p + 1 + 1) (by simp) (hPc (p + 1) _ hc) =
          (wcEtPush g).map h ≫
            (((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).toCycles p (p + 1) := by
        rw [← cancel_mono ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj
          I.cocomplex).iCycles (p + 1)), HomologicalComplex.liftCycles_i, Category.assoc,
          HomologicalComplex.toCycles_i, Functor.map_comp, Functor.mapHomologicalComplex_obj_d]
      rw [h1, Category.assoc, HomologicalComplex.toCycles_comp_homologyπ, Limits.comp_zero]

  let Z := (Preadditive.rightComp ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) (I.cocomplex.d q (q + 1))).ker
  have hZ : ∀ c : Z, (c : (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ I.cocomplex.X q) ≫ I.cocomplex.d q (q + 1) = 0 :=
    fun c => AddMonoidHom.mem_ker.mp c.2
  let E : Z →+ Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) ((constantSheaf (Scheme.smallEtaleTopology X)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) q :=
    AddMonoidHom.mk' (fun c => I.extMk c.1 (q + 1) rfl (hZ c))
      (fun a b => (I.add_extMk a.1 b.1 (q + 1) rfl (hZ a) (hZ b)).symm)
  have hEs : ∀ z, ∃ c : Z, E c = z := by
    intro z
    obtain ⟨f, hf, hfz⟩ := I.extMk_surjective z (q + 1) rfl
    exact ⟨⟨f, AddMonoidHom.mem_ker.mpr hf⟩, hfz⟩
  choose σ hσ using hEs

  let Ψ : Z →+ ((wcEtPush g).obj ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) ⟶
        (((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) :=
    AddMonoidHom.mk' (fun c =>
      (((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).liftCycles
        ((wcEtPush g).map c.1) (q + 1) (by simp) (hPc q c.1 (hZ c)) ≫
        (((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homologyπ q)
      (fun a b => by
        rw [← Preadditive.add_comp]
        congr 1
        rw [← cancel_mono ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj
          I.cocomplex).iCycles q), Preadditive.add_comp, HomologicalComplex.liftCycles_i,
          HomologicalComplex.liftCycles_i, HomologicalComplex.liftCycles_i]
        exact Functor.map_add _)
  let one' : ((wcEtPush g).obj ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ)))).obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 B))) :=
    ((toSheafify (Scheme.smallEtaleTopology B) ((wcEtBaseChange g).op ⋙
      ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))).obj)).app (Opposite.op (Scheme.Etale.mk (𝟙 B)))).hom
      (wcConstSec X (ULift.{u+1} ℤ) ((wcEtBaseChange g).obj (Scheme.Etale.mk (𝟙 B))) (ULift.up 1))
  let ev : ((wcEtPush g).obj ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) ⟶
        (((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) →+
      ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q).obj.obj
        (Opposite.op (Scheme.Etale.mk (𝟙 B))) :=
    AddMonoidHom.mk' (fun φ => (φ.hom.app (Opposite.op (Scheme.Etale.mk (𝟙 B)))).hom one')
      (fun φ ψ => by
        rw [Sheaf.Hom.add_app, AddCommGrpCat.hom_add_apply])
  have hk : E.ker ≤ (ev.comp Ψ).ker := by
    intro c hc
