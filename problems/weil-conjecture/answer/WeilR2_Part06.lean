        α.app (Opposite.op A) b := by
    intro A B r b
    have h := congrArg (fun φ => φ.hom b) (α.naturality r.op)
    exact h.symm
  have hcomp : ∀ {A B C : X'.Etale} (f : A ⟶ B) (h : B ⟶ C)
      (z : ↑((wcEtZModRing X' n).obj.obj (Opposite.op C))),
      ((wcEtZModRing X' n).obj.map f.op).hom (((wcEtZModRing X' n).obj.map h.op).hom z) =
        ((wcEtZModRing X' n).obj.map (f ≫ h).op).hom z := by
    intro A B C f h z
    rw [op_comp, Functor.map_comp]
    rfl

  have hbc : ∀ {V W : Y'.Etale} (ι : W ⟶ V), ((wcEtBaseChange i').map ι).left ≫
      Limits.pullback.fst V.hom i' = Limits.pullback.fst W.hom i' ≫ ι.left := by
    intro V W ι
    exact Limits.pullback.lift_fst _ _ _

  have hres : ∀ (V : Y'.Etale) (v : V.left)
      (x : ↑((wcEtZModRing X' n).obj.obj (Opposite.op ((wcEtBaseChange i').obj V)))),
      ∃ (O : V.left.Opens) (_ : v ∈ O) (k : ℤ),
        ((wcEtZModRing X' n).obj.map ((wcEtBaseChange i').map (wcEtOpenι Y' V O)).op).hom x =
          (k : ↑((wcEtZModRing X' n).obj.obj
            (Opposite.op ((wcEtBaseChange i').obj (wcEtOpen Y' V O))))) := by
    intro V v x
    have hj : Topology.IsClosedEmbedding (Limits.pullback.fst V.hom i') :=
      IsClosedImmersion.isClosedEmbedding _
    have hjO : ∀ (O : V.left.Opens) (y : ((wcEtBaseChange i').obj (wcEtOpen Y' V O)).left),
        Limits.pullback.fst V.hom i' (((wcEtBaseChange i').map (wcEtOpenι Y' V O)).left y) ∈ O := by
      intro O y
      have h : Limits.pullback.fst V.hom i' (((wcEtBaseChange i').map (wcEtOpenι Y' V O)).left y) =
          O.ι (Limits.pullback.fst (wcEtOpen Y' V O).hom i' y) :=
        congrArg (fun φ => φ.base y) (hbc (wcEtOpenι Y' V O))
      rw [h]
      have hm := Set.mem_range_self (f := ⇑O.ι) (Limits.pullback.fst (wcEtOpen Y' V O).hom i' y)
      rw [Scheme.Opens.range_ι] at hm
      exact hm
    by_cases hv : ∃ u, Limits.pullback.fst V.hom i' u = v
    · obtain ⟨u, rfl⟩ := hv
      have hS := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology X') α
        (U := Opposite.op ((wcEtBaseChange i').obj V)) x
      obtain ⟨U₁, g, u₁, ⟨a, ha⟩, hEt, hu₁⟩ := hcov' X' _ _ hS u
      have hG : IsOpen (Set.range g.left) := g.left.isOpenMap.isOpen_range
      obtain ⟨O₁, hO₁, hpre⟩ := hj.isInducing.isOpen_iff.mp hG
      let O : V.left.Opens := ⟨O₁, hO₁⟩
      have hvO : Limits.pullback.fst V.hom i' u ∈ O := by
        show Limits.pullback.fst V.hom i' u ∈ O₁
        rw [← Set.mem_preimage, hpre]
        exact ⟨u₁, hu₁⟩
      refine ⟨O, hvO, ((a.down).cast : ℤ), ?_⟩
      have hak : (((a.down.cast : ℤ)) : ULift.{u+1} (ZMod n)) = a :=
        ULift.ext _ _ (by rw [ULift.down_intCast]; exact ZMod.intCast_zmod_cast _)
      rw [← map_intCast (α.app (Opposite.op ((wcEtBaseChange i').obj (wcEtOpen Y' V O)))).hom, hak]

      let T : Sieve ((wcEtBaseChange i').obj (wcEtOpen Y' V O)) :=
        { arrows := fun Q q => ∃ r : Q ⟶ U₁, r ≫ g = q ≫ (wcEtBaseChange i').map (wcEtOpenι Y' V O)
          downward_closed := fun {Q Q'} {q} hq h' => by
            obtain ⟨r, hr⟩ := hq
            exact ⟨h' ≫ r, by rw [Category.assoc, hr, Category.assoc]⟩ }
      have hT : T ∈ Scheme.smallEtaleTopology X' ((wcEtBaseChange i').obj (wcEtOpen Y' V O)) := by
        apply hcov
        intro y
        have hy : ((wcEtBaseChange i').map (wcEtOpenι Y' V O)).left y ∈ Set.range g.left := by
          rw [← hpre]
          exact hjO O y
        obtain ⟨u₂, hu₂⟩ := hy
        have hW : Etale ((wcEtBaseChange i').obj (wcEtOpen Y' V O)).hom :=
          ((wcEtBaseChange i').obj (wcEtOpen Y' V O)).prop
        let Q : X'.Etale := MorphismProperty.Over.mk ⊤
          (Limits.pullback.fst ((wcEtBaseChange i').map (wcEtOpenι Y' V O)).left g.left ≫
            ((wcEtBaseChange i').obj (wcEtOpen Y' V O)).hom) (by infer_instance)
        let q : Q ⟶ (wcEtBaseChange i').obj (wcEtOpen Y' V O) :=
          MorphismProperty.Over.homMk
            (Limits.pullback.fst ((wcEtBaseChange i').map (wcEtOpenι Y' V O)).left g.left) rfl trivial
        have hc : Limits.pullback.snd ((wcEtBaseChange i').map (wcEtOpenι Y' V O)).left g.left ≫
            U₁.hom = Q.hom := by
          change _ = Limits.pullback.fst _ _ ≫ ((wcEtBaseChange i').obj (wcEtOpen Y' V O)).hom
          rw [← MorphismProperty.Over.w g, ← MorphismProperty.Over.w
            ((wcEtBaseChange i').map (wcEtOpenι Y' V O)), ← Category.assoc, ← Category.assoc,
            Limits.pullback.condition]
        let r : Q ⟶ U₁ := MorphismProperty.Over.homMk
          (Limits.pullback.snd ((wcEtBaseChange i').map (wcEtOpenι Y' V O)).left g.left) hc trivial
        obtain ⟨z, hz₁, hz₂⟩ := Scheme.Pullback.exists_preimage_pullback
          (f := ((wcEtBaseChange i').map (wcEtOpenι Y' V O)).left) (g := g.left) y u₂ hu₂.symm
        refine ⟨Q, q, z, ⟨r, ?_⟩, ?_, hz₁⟩
        · apply MorphismProperty.Over.Hom.ext
          exact Limits.pullback.condition.symm
        · show Etale (Limits.pullback.fst ((wcEtBaseChange i').map (wcEtOpenι Y' V O)).left g.left)
          infer_instance
      refine hsep _ T hT _ _ (fun Q q hq => ?_)
      obtain ⟨r, hr⟩ := hq
      rw [hcomp, ← hr, ← hcomp, ← ha, hnat, hnat]
    · refine ⟨⟨(Set.range (Limits.pullback.fst V.hom i'))ᶜ, hj.isClosed_range.isOpen_compl⟩,
        fun h => hv h, 0, ?_⟩
      apply hempty
      refine ⟨fun y => ?_⟩
      exact hjO _ y ⟨_, rfl⟩

  let ρV : ∀ W : Y'.Etale, ↑((wcEtZModRing Y' n).obj.obj (Opposite.op W)) →+
      ↑((wcEtZModRing X' n).obj.obj (Opposite.op ((wcEtBaseChange i').obj W))) :=
    fun W => ((wcEtSuppUnitMap D').val.app (Opposite.op W)).hom.toAddMonoidHom

  have huntw : ∀ V : Y'.Etale, ∃ s t : ↑((wcEtZModRing X' n).obj.obj
      (Opposite.op ((wcEtBaseChange i').obj V))), ρV V 1 = s ∧ s * t = 1 := by
    intro V
    haveI := D'.cont
    let c := @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange i') _ _
      D'.cont D'.φ
    let e := D'.μ.inv ≫ (D'.adj.homEquiv _ _).symm c
    have h0 : wcEtSuppUnitMap D' = D'.adj.homEquiv _ _ D'.μ.hom :=
      (D'.adj.homEquiv_unit _ _ _).symm
    have h1 : (D'.adj.homEquiv _ _ D'.μ.hom) ≫ (@SheafOfModules.pushforward _ _ _ _ _ _
        (wcEtBaseChange i') _ _ D'.cont D'.φ).map e = c := by
      rw [← Adjunction.homEquiv_naturality_right, Iso.hom_inv_id_assoc,
        Equiv.apply_symm_apply]
    let eF : ↑((wcEtZModRing X' n).obj.obj (Opposite.op ((wcEtBaseChange i').obj V))) →
        ↑((wcEtZModRing X' n).obj.obj (Opposite.op ((wcEtBaseChange i').obj V))) :=
      fun y => (e.val.app (Opposite.op ((wcEtBaseChange i').obj V))).hom y
    let cV : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op V)) →
        ↑((wcEtZModRing X' n).obj.obj (Opposite.op ((wcEtBaseChange i').obj V))) :=
      fun y => (c.val.app (Opposite.op V)).hom y
    have h3 : cV 1 = 1 :=
      (SheafOfModules.unitToPushforwardObjUnit_val_app_apply D'.φ
        (1 : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op V)))).trans
        (map_one (D'.φ.hom.app (Opposite.op V)).hom)
    have h2' : eF (ρV V 1) = cV 1 := by
      have hA := congrArg (fun φ : SheafOfModules.unit (wcEtZModRing Y' n) ⟶ wcEtSuppObj D' =>
        ((φ ≫ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i') _ _ D'.cont
          D'.φ).map e).val.app (Opposite.op V)).hom
          (1 : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op V)))) h0
      have hB := congrArg (fun φ => (φ.val.app (Opposite.op V)).hom
        (1 : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op V)))) h1
      exact hA.trans hB
    have h2 : eF (ρV V 1) = 1 := h2'.trans h3
    have h4 : ∀ y, eF y = y * eF 1 := by
      intro y
      have h := (e.val.app (Opposite.op ((wcEtBaseChange i').obj V))).hom.map_smul y
        (1 : ↑((wcEtZModRing X' n).obj.obj (Opposite.op ((wcEtBaseChange i').obj V))))
      exact (congrArg eF (mul_one y).symm).trans h
    exact ⟨ρV V 1, eF 1, rfl, (h4 _).symm.trans h2⟩

  have hrefl : (SheafOfModules.toSheaf (wcEtZModRing Y' n)).ReflectsEpimorphisms :=
    Functor.reflectsEpimorphisms_of_faithful _
  apply Functor.epi_of_epi_map (SheafOfModules.toSheaf (wcEtZModRing Y' n))
  haveI : Sheaf.IsLocallySurjective
      ((SheafOfModules.toSheaf (wcEtZModRing Y' n)).map (wcEtSuppUnitMap D')) := by
    refine Presheaf.IsLocallySurjective.mk (fun {V} m => ?_)
    apply hcov
    intro v
    let m' : ↑((wcEtZModRing X' n).obj.obj (Opposite.op ((wcEtBaseChange i').obj V))) := m
    obtain ⟨s, t, hs, hst⟩ := huntw V
    obtain ⟨O, hvO, k, hk⟩ := hres V v (t * m')
    have hm : m' = s * (t * m') := by rw [← mul_assoc, hst, one_mul]
    refine ⟨wcEtOpen Y' V O, wcEtOpenι Y' V O, ⟨v, hvO⟩,
      ⟨(k : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op (wcEtOpen Y' V O)))), ?_⟩, ?_, rfl⟩
    · change ρV (wcEtOpen Y' V O)
          (k : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op (wcEtOpen Y' V O)))) =
        ((wcEtZModRing X' n).obj.map ((wcEtBaseChange i').map (wcEtOpenι Y' V O)).op).hom m'
      have e1 : ρV (wcEtOpen Y' V O)
          (k : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op (wcEtOpen Y' V O)))) =
          (k : ↑((wcEtZModRing X' n).obj.obj
            (Opposite.op ((wcEtBaseChange i').obj (wcEtOpen Y' V O))))) *
            ρV (wcEtOpen Y' V O) 1 := by
        have hk1 : (k : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op (wcEtOpen Y' V O)))) =
            k • (1 : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op (wcEtOpen Y' V O)))) :=
          (Int.smul_one_eq_cast k).symm
        rw [hk1, map_zsmul, zsmul_eq_mul]
      have e2 : ρV (wcEtOpen Y' V O) 1 =
          ((wcEtZModRing X' n).obj.map ((wcEtBaseChange i').map (wcEtOpenι Y' V O)).op).hom
            (ρV V 1) := by
        have h := PresheafOfModules.naturality_apply (wcEtSuppUnitMap D').val
          (wcEtOpenι Y' V O).op (1 : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op V)))
        have h1' : ((wcEtZModRing Y' n).obj.map (wcEtOpenι Y' V O).op).hom
            (1 : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op V))) = 1 := map_one _
        exact (congrArg (ρV (wcEtOpen Y' V O)) h1'.symm).trans h
      rw [e1, e2, hs, hm, map_mul, hk]
      exact Int.cast_comm _ _
    · show Etale O.ι
      infer_instance
  exact Sheaf.epi_of_isLocallySurjective _

theorem wc_et_finite_push_modules_exact : ∀ {X Y : Scheme.{u}} (i : X ⟶ Y) [IsFinite i] (n : ℕ) (D : wcEtPullData i n), Limits.PreservesFiniteColimits (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ) :=
by
  intro X Y i _ n D
  haveI := D.cont
  haveI hfin : Limits.PreservesFiniteColimits (wcEtPush i) := wc_et_finite_push_exact i
  let e : @Functor.sheafPushforwardContinuous _ _ _ _ (wcEtBaseChange i) AddCommGrpCat.{u+1} _
      (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology X) D.cont ≅
      (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⋙
        (Functor.whiskeringLeft (Y.Etale)ᵒᵖ (X.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj
          (@Functor.op Y.Etale _ X.Etale _ (wcEtBaseChange i)) ⋙
        presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
    (@Functor.sheafPushforwardContinuous _ _ _ _ (wcEtBaseChange i) AddCommGrpCat.{u+1} _
      (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology X) D.cont).rightUnitor.symm ≪≫
    Functor.isoWhiskerLeft (@Functor.sheafPushforwardContinuous _ _ _ _ (wcEtBaseChange i)
        AddCommGrpCat.{u+1} _ (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology X) D.cont)
      (asIso (sheafificationAdjunction (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).counit).symm ≪≫
    (Functor.associator _ _ _).symm ≪≫
    Functor.isoWhiskerRight (@Functor.sheafPushforwardContinuousCompSheafToPresheafIso _ _ _ _
        (wcEtBaseChange i) AddCommGrpCat.{u+1} _ (Scheme.smallEtaleTopology Y)
        (Scheme.smallEtaleTopology X) D.cont)
      (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) ≪≫
    Functor.associator _ _ _
  haveI hfin' : Limits.PreservesFiniteColimits
      (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⋙
        (Functor.whiskeringLeft (Y.Etale)ᵒᵖ (X.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj
          (@Functor.op Y.Etale _ X.Etale _ (wcEtBaseChange i)) ⋙
        presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := hfin
  haveI hc : Limits.PreservesFiniteColimits
      (@Functor.sheafPushforwardContinuous _ _ _ _ (wcEtBaseChange i) AddCommGrpCat.{u+1} _
        (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology X) D.cont) :=
    Limits.preservesFiniteColimits_of_natIso e.symm
  haveI hl : Limits.PreservesFiniteLimits
      (@Functor.sheafPushforwardContinuous _ _ _ _ (wcEtBaseChange i) AddCommGrpCat.{u+1} _
        (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology X) D.cont) := inferInstance
  haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.smallEtaleTopology Y)
    (wcEtZModRing Y n)
  haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.smallEtaleTopology X)
    (wcEtZModRing X n)
  exact (sheafOfModules_pushforward_exact (J := Scheme.smallEtaleTopology Y)
    (K := Scheme.smallEtaleTopology X) (wcEtBaseChange i) (wcEtZModRing Y n)
    (wcEtZModRing X n) D.φ).2.2

theorem sheafOfModules_unit_corepresented_by_free_terminal : ∀ {C : Type (u+1)} [Category.{u} C]
    (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
    (R : Sheaf J RingCat.{u+1}) (T : C), Limits.IsTerminal T →
    ∃ ε : (presheafToSheaf J AddCommGrpCat.{u+1}).obj
        (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶
        (SheafOfModules.toSheaf.{u+1} R).obj (SheafOfModules.unit R),
      ∀ M : SheafOfModules.{u+1} R,
        Function.Bijective (fun f : SheafOfModules.unit R ⟶ M =>
          ε ≫ (SheafOfModules.toSheaf.{u+1} R).map f) :=
by
  intro C _ J _ _ R T hT
  set P : Cᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
    yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free with hP
  let e : ∀ X : Cᵒᵖ, P.obj X := fun X => FreeAbelianGroup.of (ULift.up (hT.from X.unop))
  have hgen : ∀ (X : Cᵒᵖ) (x : ULift.{u+1} (X.unop ⟶ T)), x = ULift.up (hT.from X.unop) :=
    fun X x => ULift.ext _ _ (hT.hom_ext _ _)
  have hPmap : ∀ ⦃X Y : Cᵒᵖ⦄ (f : X ⟶ Y), P.map f (e X) = e Y := by
    intro X Y f
    exact (FreeAbelianGroup.map_of_apply _).trans (congrArg FreeAbelianGroup.of (hgen Y _))
  have huniq : ∀ (G : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}) (φ ψ : P ⟶ G),
      (∀ X : Cᵒᵖ, φ.app X (e X) = ψ.app X (e X)) → φ = ψ := by
    intro G φ ψ h
    apply NatTrans.ext
    funext X
    apply AddCommGrpCat.hom_ext
    apply FreeAbelianGroup.lift_ext
    intro x
    rw [hgen X x]
    exact h X
  let G0 : Cᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
    (PresheafOfModules.toPresheaf R.obj).obj (PresheafOfModules.unit R.obj)
  let η : P ⟶ G0 :=
    { app := fun X => AddCommGrpCat.ofHom
        (FreeAbelianGroup.lift (β := G0.obj X) (fun _ => show G0.obj X from (1 : R.obj.obj X)))
      naturality := by
        intro X Y f
        apply AddCommGrpCat.hom_ext
        apply FreeAbelianGroup.lift_ext
        intro x
        show FreeAbelianGroup.lift _ (FreeAbelianGroup.map _ (FreeAbelianGroup.of x)) =
          (G0.map f).hom (FreeAbelianGroup.lift _ (FreeAbelianGroup.of x))
        rw [FreeAbelianGroup.map_of_apply, FreeAbelianGroup.lift_apply_of,
          FreeAbelianGroup.lift_apply_of]
        exact ((PresheafOfModules.presheaf_map_apply_coe (PresheafOfModules.unit R.obj) f _).trans
          (PresheafOfModules.unit_map_one R.obj f)).symm }
  have hη : ∀ X : Cᵒᵖ, η.app X (e X) = (1 : R.obj.obj X) := by
    intro X
    exact FreeAbelianGroup.lift_apply_of _ _
  let adj := sheafificationAdjunction J AddCommGrpCat.{u+1}
  obtain ⟨ε, hε⟩ : ∃ ε : (presheafToSheaf J AddCommGrpCat.{u+1}).obj P ⟶
      (SheafOfModules.toSheaf.{u+1} R).obj (SheafOfModules.unit R),
      adj.homEquiv _ _ ε = η := ⟨(adj.homEquiv _ _).symm η, Equiv.apply_symm_apply _ _⟩
  refine ⟨ε, fun M => ?_⟩
  have key : ∀ f : SheafOfModules.unit R ⟶ M,
      adj.homEquiv P _ (ε ≫ (SheafOfModules.toSheaf R).map f) =
        η ≫ (PresheafOfModules.toPresheaf R.obj).map f.val := by
    intro f
    rw [Adjunction.homEquiv_naturality_right, hε]
    rfl
  have hev : ∀ (f : SheafOfModules.unit R ⟶ M) (X : Cᵒᵖ),
      (η ≫ (PresheafOfModules.toPresheaf R.obj).map f.val).app X (e X) =
        (M.unitHomEquiv f).val X := by
    intro f X
    rw [SheafOfModules.unitHomEquiv_apply_coe]
    show ((PresheafOfModules.toPresheaf R.obj).map f.val).app X (η.app X (e X)) = _
    rw [hη X]
    rfl
  constructor
  · intro f f' hff
    have h1 := congrArg (adj.homEquiv P _) hff
    simp only [key] at h1
    have h2 : M.unitHomEquiv f = M.unitHomEquiv f' := by
      apply Subtype.ext
      funext X
      exact (hev f X).symm.trans
        ((congrArg (fun φ => AddCommGrpCat.Hom.hom (φ.app X) (e X)) h1).trans (hev f' X))
    exact M.unitHomEquiv.injective h2
  · intro θ
    let ψ := adj.homEquiv P _ θ
    let s : ∀ X : Cᵒᵖ, M.val.obj X := fun X => ψ.app X (e X)
    have hs : ∀ ⦃X Y : Cᵒᵖ⦄ (f : X ⟶ Y), M.val.map f (s X) = s Y := by
      intro X Y f
      have h := congrArg (fun g => AddCommGrpCat.Hom.hom g (e X)) (ψ.naturality f)
      exact (PresheafOfModules.presheaf_map_apply_coe M.val f (s X)).symm.trans
        (h.symm.trans (congrArg (fun z => AddCommGrpCat.Hom.hom (ψ.app Y) z) (hPmap f)))
    refine ⟨M.unitHomEquiv.symm (PresheafOfModules.sectionsMk s hs), ?_⟩
    apply (adj.homEquiv P _).injective
    show adj.homEquiv P _ (ε ≫ _) = ψ
    rw [key]
    apply huniq
    intro X
    refine (hev _ X).trans ?_
    rw [Equiv.apply_symm_apply, PresheafOfModules.sectionsMk_coe]
    rfl

theorem wc_et_zmod_modext_toSheaf_equiv (Y : Scheme.{u}) (n : ℕ) (hn : 0 < n)
    (N : SheafOfModules.{u+1} (wcEtZModRing Y n)) (i : ℕ) :
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    Nonempty (@Abelian.Ext (SheafOfModules.{u+1} (wcEtZModRing Y n)) _ _ (HasExt.standard _)
        (SheafOfModules.unit (wcEtZModRing Y n)) N i ≃
      Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) ((SheafOfModules.toSheaf (wcEtZModRing Y n)).obj N) i) :=
by
  classical
  letI instEt : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  letI instEe : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y n)) := HasExt.standard _
  haveI : Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)) :=
    sheafOfModules_toSheaf_preservesFiniteColimits _ _
  haveI hEIme : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing Y n)) :=
    sheafOfModules_enoughInjectives _ _
  haveI : EssentiallySmall.{u+1} Y.Etale := inferInstance
  haveI : IsGrothendieckAbelian.{u+1} (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
    Sheaf.isGrothendieckAbelian_of_essentiallySmall _ _
  haveI hEIet : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
    IsGrothendieckAbelian.enoughInjectives
  obtain ⟨α, hα1, hα2, hR⟩ := wc_et_zmod_ring_locbij Y n
  obtain ⟨hFull, hess⟩ := sheafOfModules_toSheaf_torsion_equiv (Scheme.smallEtaleTopology Y)
    (wcEtZModRing Y n) n α hα1 hα2
  haveI := hFull
  have huniq : ∀ (V : Y.Etale) (f g : V ⟶ (wcZarToEt Y).obj ⊤), f = g := by
    intro V f g
    haveI : Mono ((wcZarToEt Y).obj ⊤).hom :=
      show Mono (⊤ : Y.Opens).ι from (inferInstance : Mono (⊤ : Y.Opens).ι)
    apply MorphismProperty.Over.Hom.ext
    rw [← cancel_mono ((wcZarToEt Y).obj ⊤).hom, MorphismProperty.Over.w f,
      MorphismProperty.Over.w g]
  have hT : Limits.IsTerminal ((wcZarToEt Y).obj ⊤) :=
    Limits.IsTerminal.ofUniqueHom
      (fun V => MorphismProperty.Over.homMk (V.hom ≫ Y.topIso.inv)
        (by
          change (V.hom ≫ Y.topIso.inv) ≫ (⊤ : Y.Opens).ι = V.hom
          rw [← Scheme.topIso_hom, Category.assoc, Iso.inv_hom_id, Category.comp_id]) trivial)
      (fun V g => huniq V g _)
  obtain ⟨ε, hε⟩ := sheafOfModules_unit_corepresented_by_free_terminal
    (Scheme.smallEtaleTopology Y) (wcEtZModRing Y n) _ hT
  let ψ := (wc_et_free_top_iso_const Y).some
  have hhom : ∀ M : SheafOfModules.{u+1} (wcEtZModRing Y n),
      Function.Bijective (fun f : SheafOfModules.unit (wcEtZModRing Y n) ⟶ M =>
        (ψ.inv ≫ ε) ≫ (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).map f) := by
    intro M
    constructor
    · intro f g hfg
      apply (hε M).1
      have h2 := congrArg (fun k => ψ.hom ≫ k) hfg
      simpa only [Category.assoc, Iso.hom_inv_id_assoc] using h2
    · intro h
      obtain ⟨f, hf⟩ := (hε M).2 (ψ.hom ≫ h)
      refine ⟨f, ?_⟩
      change (ψ.inv ≫ ε) ≫ _ = h
      rw [Category.assoc]
      have hf' : ε ≫ (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).map f = ψ.hom ≫ h := hf
      rw [hf', Iso.inv_hom_id_assoc]
  have hvan : ∀ (I : SheafOfModules.{u+1} (wcEtZModRing Y n)) [Injective I] (k : ℕ)
      (e : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)))
        ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).obj I) (k + 1)), e = 0 := by
    intro I _ k e
    exact sheafOfModules_torsion_injective_acyclic (Scheme.smallEtaleTopology Y)
      (wcEtZModRing Y n) n hn hR hess I k e
  have hB := ext_transfer_of_corep (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n))
    (SheafOfModules.unit (wcEtZModRing Y n))
    ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) (ψ.inv ≫ ε) hhom hvan N i
  exact ⟨Equiv.ofBijective _ hB⟩

theorem wc_ext_pull_bij_of_unit_post_bij : ∀ {C : Type*} [Category C] [Abelian C] [HasExt C] [EnoughInjectives C] {D : Type*} [Category D] [Abelian D] [HasExt D] [EnoughInjectives D] (L : C ⥤ D) (R : D ⥤ C) (adj : L ⊣ R) [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L] [R.Additive] [Limits.PreservesFiniteLimits R] [Limits.PreservesFiniteColimits R] (X : C) (Y : D) (μ : L.obj X ≅ Y) (n : ℕ), Function.Bijective (fun x : Abelian.Ext X X n => x.comp (Abelian.Ext.mk₀ (adj.unit.app X ≫ R.map μ.hom)) (add_zero n)) → Function.Bijective (fun x : Abelian.Ext X X n => (Abelian.Ext.mk₀ μ.inv).comp ((Abelian.Ext.mapExactFunctor L x).comp (Abelian.Ext.mk₀ μ.hom) (add_zero n)) (zero_add n)) :=
by
  intro C _ _ _ _ D _ _ _ _ L R adj _ _ _ _ _ _ X Y μ n hP
  let ψ : Abelian.Ext Y Y n → Abelian.Ext X (R.obj Y) n := fun e =>
    (Abelian.Ext.mk₀ (adj.unit.app X ≫ R.map μ.hom)).comp (Abelian.Ext.mapExactFunctor R e)
      (zero_add n)
  let χ : Abelian.Ext X (R.obj Y) n → Abelian.Ext Y Y n := fun f =>
    (Abelian.Ext.mk₀ μ.inv).comp ((Abelian.Ext.mapExactFunctor L f).comp
      (Abelian.Ext.mk₀ (adj.counit.app Y)) (add_zero n)) (zero_add n)
  have hη : ∀ x : Abelian.Ext X X n,
      (Abelian.Ext.mk₀ (adj.unit.app X)).comp
        (Abelian.Ext.mapExactFunctor R (Abelian.Ext.mapExactFunctor L x)) (zero_add n) =
      x.comp (Abelian.Ext.mk₀ (adj.unit.app X)) (add_zero n) := by
    intro x
    have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp x adj.unit
    rw [Abelian.Ext.comp_mapExactFunctor, Abelian.Ext.id_mapExactFunctor] at h
    exact h.symm
  have hε : ∀ e : Abelian.Ext Y Y n,
      (Abelian.Ext.mapExactFunctor L (Abelian.Ext.mapExactFunctor R e)).comp
        (Abelian.Ext.mk₀ (adj.counit.app Y)) (add_zero n) =
      (Abelian.Ext.mk₀ (adj.counit.app Y)).comp e (zero_add n) := by
    intro e
    have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp e adj.counit
    rw [Abelian.Ext.comp_mapExactFunctor, Abelian.Ext.id_mapExactFunctor] at h
    exact h
  have I1 : ∀ x : Abelian.Ext X X n,
      ψ ((Abelian.Ext.mk₀ μ.inv).comp ((Abelian.Ext.mapExactFunctor L x).comp
        (Abelian.Ext.mk₀ μ.hom) (add_zero n)) (zero_add n)) =
      x.comp (Abelian.Ext.mk₀ (adj.unit.app X ≫ R.map μ.hom)) (add_zero n) := by
    intro x
    simp only [ψ, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc]
    have hu : (adj.unit.app X ≫ R.map μ.hom) ≫ R.map μ.inv = adj.unit.app X := by
      simp [← Functor.map_comp]
    rw [hu, ← Abelian.Ext.comp_assoc _ _ _ (zero_add n) (add_zero n)
      (show 0 + n + 0 = n by omega), hη,
      Abelian.Ext.comp_assoc _ _ _ (add_zero n) (add_zero 0) (show n + 0 + 0 = n by omega),
      Abelian.Ext.mk₀_comp_mk₀]
  have I2 : ∀ e : Abelian.Ext Y Y n, χ (ψ e) = e := by
    intro e
    simp only [χ, ψ, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
    rw [Abelian.Ext.comp_assoc _ _ _ (zero_add n) (add_zero n) (show 0 + n + 0 = n by omega),
      hε, Abelian.Ext.mk₀_comp_mk₀_assoc, Abelian.Ext.mk₀_comp_mk₀_assoc]
    have hm : μ.inv ≫ L.map (adj.unit.app X ≫ R.map μ.hom) ≫ adj.counit.app Y = 𝟙 Y := by
      simp [Functor.map_comp]
    simp only [Category.assoc, hm, Abelian.Ext.mk₀_id_comp]
  constructor
  · intro x₁ x₂ h
    apply hP.1
    have h' := congrArg ψ h
    simp only at h'
    rw [I1, I1] at h'
    exact h'
  · intro e
    obtain ⟨x, hx⟩ := hP.2 (ψ e)
    refine ⟨x, ?_⟩
    calc _ = χ (ψ ((Abelian.Ext.mk₀ μ.inv).comp ((Abelian.Ext.mapExactFunctor L x).comp
          (Abelian.Ext.mk₀ μ.hom) (add_zero n)) (zero_add n))) := (I2 _).symm
      _ = χ (x.comp (Abelian.Ext.mk₀ (adj.unit.app X ≫ R.map μ.hom)) (add_zero n)) := by
          rw [I1]
      _ = χ (ψ e) := congrArg χ hx
      _ = e := I2 e

theorem wc_et_supp_unit_ker_suppIn : ∀ {Y ZY : Scheme.{u}} (iY : ZY ⟶ Y) [IsClosedImmersion iY] (n : ℕ) (DY : wcEtPullData iY n), wcSuppIn Y (Set.range iY)ᶜ ((SheafOfModules.toSheaf (wcEtZModRing Y n)).obj (Limits.kernel (wcEtSuppUnitMap DY))) :=
by
  intro Y ZY iY _ n DY

  have locbij : ∀ (S : Scheme.{u}) (n : ℕ),
      ∃ α : (Functor.const (S.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶ (wcEtZModRing S n).obj,
        Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology S) α ∧
        Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology S) α := by
    intro S n
    let P : (S.Etale)ᵒᵖ ⥤ RingCat.{u+1} :=
      (Functor.const (S.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n)))
    exact ⟨toSheafify (Scheme.smallEtaleTopology S) P,
      Presheaf.isLocallyInjective_toSheafify' (Scheme.smallEtaleTopology S) P,
      Presheaf.isLocallySurjective_toSheafify' (Scheme.smallEtaleTopology S) P⟩

  have covsurj : ∀ (S : Scheme.{u}) (V : S.Etale) (R : Sieve V),
      R ∈ Scheme.smallEtaleTopology S V → ∀ x : V.left,
      ∃ (Y : S.Etale) (f : Y ⟶ V) (y : Y.left), R.arrows f ∧ f.left y = x := by
    intro S V R h x
    haveI : MorphismProperty.IsStableUnderComposition (@Etale : MorphismProperty Scheme.{u}) :=
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have e := Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := (@Etale : MorphismProperty Scheme.{u})) (Q := (@Etale : MorphismProperty Scheme.{u})) S le_rfl
    have h' := (Scheme.mem_toGrothendieck_smallPretopology (P := @Etale) (Q := @Etale) V R).mp (e ▸ h)
    obtain ⟨Y, f, y, h1, _, h3⟩ := h' x
    exact ⟨Y, f, y, h1, h3⟩

  have twist : ∀ {S T : Scheme.{u}} {j : T ⟶ S} {n : ℕ} (E : wcEtPullData j n),
      ∃ e : SheafOfModules.unit (wcEtZModRing T n) ⟶ SheafOfModules.unit (wcEtZModRing T n),
        wcEtSuppUnitMap E ≫ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange j) _ _ E.cont E.φ).map e
          = @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange j) _ _ E.cont E.φ := by
    intro S T j n E
    refine ⟨E.μ.inv ≫ (E.adj.homEquiv _ _).symm
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange j) _ _ E.cont E.φ), ?_⟩
    dsimp only [wcEtSuppUnitMap, wcEtSuppObj]
    rw [Category.assoc, ← Functor.map_comp, Iso.hom_inv_id_assoc,
      ← Adjunction.homEquiv_unit, Equiv.apply_symm_apply]

  have intcast_eq : ∀ (S : Scheme.{u}) (n : ℕ) (V : S.Etale)
      (α : (Functor.const (S.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶ (wcEtZModRing S n).obj)
      (c : ULift.{u+1} (ZMod n)),
      (α.app (Opposite.op V)).hom c = (((c.down.cast : ℤ)) : ↑((wcEtZModRing S n).obj.obj (Opposite.op V))) := by
    intro S n V α c
    have hc : c = (((c.down.cast : ℤ)) : ULift.{u+1} (ZMod n)) := by
      apply ULift.ext
      rw [ULift.down_intCast, ZMod.intCast_zmod_cast]
    conv_lhs => rw [hc]
    exact map_intCast (α.app (Opposite.op V)).hom _

  have intzero : ∀ (S : Scheme.{u}) (n : ℕ) (V : S.Etale) (k : ℤ),
      (k : ↑((wcEtZModRing S n).obj.obj (Opposite.op V))) = 0 → (k : ZMod n) = 0 ∨ IsEmpty V.left := by
    intro S n V k hk
    by_cases hV : IsEmpty V.left
    · exact Or.inr hV
    · left
      obtain ⟨x⟩ := not_isEmpty_iff.mp hV
      obtain ⟨α, hinj, hsurj⟩ := locbij S n
      have h1 : (α.app (Opposite.op V)).hom ((k : ULift.{u+1} (ZMod n))) =
          (α.app (Opposite.op V)).hom (0 : ULift.{u+1} (ZMod n)) := by
        rw [map_intCast, map_zero]; exact hk
      have hmem := Presheaf.equalizerSieve_mem (Scheme.smallEtaleTopology S) α _ _ h1
      obtain ⟨Q, g, _, hg, _⟩ := covsurj S V _ hmem x
      have h2 : ((k : ULift.{u+1} (ZMod n))) = 0 := hg
      have h3 := congrArg ULift.down h2
      rw [ULift.down_intCast] at h3
      exact h3
  unfold wcSuppIn
  intro V s
  let k : ↑((wcEtZModRing Y n).obj.obj (Opposite.op V)) :=
    ((Limits.kernel.ι (wcEtSuppUnitMap DY)).val.app (Opposite.op V)).hom s
  have hρk : ((wcEtSuppUnitMap DY).val.app (Opposite.op V)).hom k = 0 := by
    have h := congrArg (fun h => (h.val.app (Opposite.op V)).hom s)
      (Limits.kernel.condition (wcEtSuppUnitMap DY))
    exact h
  have hφk : (DY.φ.hom.app (Opposite.op V)).hom k = 0 := by
    obtain ⟨e', he'⟩ := twist DY
    have h2 := congrArg (fun h => (h.val.app (Opposite.op V)).hom k) he'
    change (e'.val.app (Opposite.op ((wcEtBaseChange iY).obj V))).hom
      (((wcEtSuppUnitMap DY).val.app (Opposite.op V)).hom k) =
      (DY.φ.hom.app (Opposite.op V)).hom k at h2
    rw [hρk] at h2
    exact h2.symm.trans (LinearMap.map_zero _)
  obtain ⟨α, -, hsurj⟩ := locbij Y n
  refine GrothendieckTopology.superset_covering _ ?_
    (Presheaf.imageSieve_mem (Scheme.smallEtaleTopology Y) α k)
  intro V' g hg
  apply Sieve.le_generate
  obtain ⟨c, hc⟩ := hg
  have hk' : ((wcEtZModRing Y n).obj.map g.op).hom k =
      ((c.down.cast : ℤ) : ↑((wcEtZModRing Y n).obj.obj (Opposite.op V'))) :=
    hc.symm.trans (intcast_eq Y n V' α c)

  have hnat := congrArg (fun h => h.hom k) (DY.φ.hom.naturality g.op)
  simp only [RingCat.hom_comp, RingHom.comp_apply] at hnat
  rw [hφk, map_zero, hk', map_intCast] at hnat
  rcases intzero ZY n ((wcEtBaseChange iY).obj V') _ hnat with hk0 | hE
  · left
    rw [ZMod.intCast_zmod_cast] at hk0
    have hc0 : c = 0 := ULift.ext _ _ hk0
    have hk0' : ((wcEtZModRing Y n).obj.map g.op).hom k = 0 := by
      rw [← hc, hc0, map_zero]

    let G := SheafOfModules.toSheaf (wcEtZModRing Y n) ⋙
      sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} ⋙
      (evaluation _ AddCommGrpCat.{u+1}).obj (Opposite.op V')
    haveI : Limits.PreservesFiniteLimits G := inferInstance
    haveI : G.PreservesMonomorphisms := preservesMonomorphisms_of_preservesLimitsOfShape G
    have hm : Mono (G.map (Limits.kernel.ι (wcEtSuppUnitMap DY))) := inferInstance
    have hinjι := (AddCommGrpCat.mono_iff_injective _).mp hm
    have hn2 := PresheafOfModules.naturality_apply (Limits.kernel.ι (wcEtSuppUnitMap DY)).val g.op s
    apply hinjι
    refine hn2.trans ?_
    refine hk0'.trans ?_
    exact (map_zero _).symm
  · right
    intro x hx
    obtain ⟨z, hz⟩ := hx
    have hE' : IsEmpty ↥(Limits.pullback V'.hom iY) := hE
    obtain ⟨w, -, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := V'.hom) (g := iY) x z hz.symm
    exact hE'.false w

theorem wc_et_zmod_unit_toSheaf_iso (Y : Scheme.{u}) (n : ℕ) :
    Nonempty ((SheafOfModules.toSheaf (wcEtZModRing Y n)).obj
        (SheafOfModules.unit (wcEtZModRing Y n)) ≅
      (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod n)))) :=
by
  classical
  obtain ⟨α, hinj, hsurj, _hR⟩ := wc_et_zmod_ring_locbij Y n
  haveI := hinj
  haveI := hsurj
  let φ : (Functor.const (Y.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⋙
      forget₂ RingCat.{u+1} AddCommGrpCat.{u+1} ⟶
      ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).obj
        (SheafOfModules.unit (wcEtZModRing Y n))).obj :=
    Functor.whiskerRight α (forget₂ RingCat.{u+1} AddCommGrpCat.{u+1})
  haveI hφi : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology Y) φ := by
    rw [← Presheaf.isLocallyInjective_forget_iff]
    exact (Presheaf.isLocallyInjective_forget_iff _ α).mpr hinj
  haveI hφs : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) φ := by
    rw [Presheaf.isLocallySurjective_iff_whisker_forget]
    exact (Presheaf.isLocallySurjective_iff_whisker_forget _ α).mp hsurj
  let c : (Functor.const (Y.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod n))) ⟶
      ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).obj
        (SheafOfModules.unit (wcEtZModRing Y n))).obj :=
    (Functor.constComp (Y.Etale)ᵒᵖ (RingCat.of (ULift.{u+1} (ZMod n)))
      (forget₂ RingCat.{u+1} AddCommGrpCat.{u+1})).inv ≫ φ
  haveI : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology Y) c :=
    Presheaf.isLocallyInjective_comp _ _ _
  haveI : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) c :=
    Presheaf.isLocallySurjective_comp _ _ _
  haveI hiso : IsIso ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map c) :=
    (GrothendieckTopology.W_iff _ c).mp (GrothendieckTopology.W_of_isLocallyBijective _ c)
  exact ⟨sheafificationIso _ ≪≫
    (asIso ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map c)).symm⟩

theorem wc_et_closed_supp_obj_vanish : ∀ {X Z : Scheme.{u}} (i : Z ⟶ X) (ℓ : ℕ) (D : wcEtPullData i ℓ) (W : X.Etale), (∀ w : W.left, W.hom w ∉ Set.range i) → Subsingleton ↑((wcEtSuppObj D).val.obj (Opposite.op W)) :=
by
  intro X Z i ℓ D W hW
  have hEmpty : IsEmpty ↥(Limits.pullback W.hom i) :=
    Scheme.isEmpty_pullback W.hom i (Set.disjoint_left.2 (by rintro _ ⟨w, rfl⟩; exact hW w))
  have hE : IsEmpty ((wcEtBaseChange i).obj W).left := hEmpty
  have hBot : (⊥ : Sieve ((wcEtBaseChange i).obj W)) ∈
      Scheme.smallEtaleTopology Z ((wcEtBaseChange i).obj W) :=
    (congrArg (fun J : GrothendieckTopology Z.Etale =>
        (⊥ : Sieve ((wcEtBaseChange i).obj W)) ∈ J ((wcEtBaseChange i).obj W))
      (@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale
        Z MorphismProperty.IsMultiplicative.toIsStableUnderComposition
        _ _ _ _ le_rfl)).mpr
      ((@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Z
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _
        ((wcEtBaseChange i).obj W) (⊥ : Sieve ((wcEtBaseChange i).obj W))).2
          (fun x => isEmptyElim x))
  have hSub : Subsingleton ↑(((SheafOfModules.toSheaf (wcEtZModRing Z ℓ)).obj
      (SheafOfModules.unit (wcEtZModRing Z ℓ))).obj.obj
        (Opposite.op ((wcEtBaseChange i).obj W))) :=
    AddCommGrpCat.subsingleton_of_isZero
      (Sheaf.isTerminalOfBotCover ((SheafOfModules.toSheaf (wcEtZModRing Z ℓ)).obj
        (SheafOfModules.unit (wcEtZModRing Z ℓ))) _ hBot).isZero
  exact hSub

theorem wc_et_supp_unit_ker_extZero_iso : ∀ {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i] (n : ℕ) (D : wcEtPullData i n), Nonempty ((SheafOfModules.toSheaf (wcEtZModRing Y n)).obj (Limits.kernel (wcEtSuppUnitMap D)) ≅ wcEtExtZero Y (Set.range i)ᶜ n) :=
by
  intro Y Z i _ n D
  have hK := wc_et_supp_unit_ker_suppIn i n D
  obtain ⟨eY⟩ := wc_et_zmod_unit_toSheaf_iso Y n

  have hzero : ∀ (H : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (φ : H ⟶ (SheafOfModules.toSheaf (wcEtZModRing Y n)).obj (wcEtSuppObj D)),
      wcSuppIn Y (Set.range i)ᶜ H → φ = 0 := by
    intro H φ hH
    have hsec : ∀ (V : Y.Etale) (s : H.obj.obj (Opposite.op V)),
        (φ.hom.app (Opposite.op V)).hom s = 0 := by
      intro V s
      set x := (φ.hom.app (Opposite.op V)).hom s with hx
      let S : Sieve V :=
        { arrows := fun V' g =>
            (((SheafOfModules.toSheaf (wcEtZModRing Y n)).obj (wcEtSuppObj D)).obj.map g.op).hom x = 0
