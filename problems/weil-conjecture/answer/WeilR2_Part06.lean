    Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat _ _) hcov
  have hT : Limits.IsTerminal ((wcEtBaseChange σ).obj (⊤_ Y.Etale)) :=
    Limits.IsTerminal.isTerminalObj _ _ Limits.terminalIsTerminal
  let Rg : RingCat.{u+1} := RingCat.of (ULift.{u+1} (ZMod m))
  let P : (Y.Etale)ᵒᵖ ⥤ RingCat.{u+1} := (Functor.const (Y.Etale)ᵒᵖ).obj Rg
  let P' : (Z.Etale)ᵒᵖ ⥤ RingCat.{u+1} := (Functor.const (Z.Etale)ᵒᵖ).obj Rg
  let α : P ⟶ (wcEtZModRing Y m).obj := toSheafify (Scheme.smallEtaleTopology Y) P
  let α' : P' ⟶ (wcEtZModRing Z m).obj := toSheafify (Scheme.smallEtaleTopology Z) P'
  haveI hαs : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) α :=
    Presheaf.isLocallySurjective_toSheafify' _ P
  haveI hα's : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Z) α' :=
    Presheaf.isLocallySurjective_toSheafify' _ P'
  haveI hα'i : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology Z) α' :=
    Presheaf.isLocallyInjective_toSheafify' _ P'
  have hα'nat : ∀ {W₁ W₂ : Z.Etale} (h : W₁ ⟶ W₂) (t : ULift.{u+1} (ZMod m)),
      ((wcEtZModRing Z m).obj.map h.op).hom ((α'.app (Opposite.op W₂)).hom t) =
        (α'.app (Opposite.op W₁)).hom t := by
    intro W₁ W₂ h t
    have := congrArg (fun k => k.hom t) (α'.naturality h.op)
    exact this.symm
  let η : P ⟶ (wcEtBaseChange σ).op ⋙ (wcEtZModRing Z m).obj :=
    { app := fun V => α'.app (Opposite.op ((wcEtBaseChange σ).obj V.unop))
      naturality := fun V W f => by
        have := α'.naturality ((wcEtBaseChange σ).map f.unop).op
