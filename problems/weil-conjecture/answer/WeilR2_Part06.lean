  obtain ⟨e2⟩ := wc_et_pull_extZero_iso (Limits.pullback.fst π j) L' hL' S hS ℓ
  let E := e1 ≪≫ (wcEtPush (Limits.pullback.snd π j)).mapIso e2

  haveI h4 : Subsingleton (wcEtExt (Limits.pullback π j)
