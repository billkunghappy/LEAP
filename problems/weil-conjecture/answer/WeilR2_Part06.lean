        obtain ⟨Ψ, hΨ⟩ := ih (a + 1) d (by omega)
        exact ⟨Ψ.comp (S a), hΨ.comp (hS a)⟩

    have hΦ : ∃ Φ : Abelian.Ext P (K.cycles (N + 1 + 1)) 0 →+ Abelian.Ext P (K.homology 2) N,
