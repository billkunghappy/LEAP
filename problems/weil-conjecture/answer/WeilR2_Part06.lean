    rw [hμ Z ⟨h1, h2⟩, AddMonoidHom.comp_apply, hy Z h1 h2]
    simp only [dif_pos (And.intro h1 h2)]
    exact Function.surjInv_eq (hφbij ⟨Z, h1, h2⟩).2 (f Z)
  ·
    intro σ _ ρ hσ hρ D Z h1 h2 y
    obtain ⟨hσZ1, hσZ2, σZ, hσZiso, hσZfac⟩ := wc_pow_component_subscheme_transport C σ Z h1
    have hσZ2' := hσZ2 h2
    haveI := hσZiso
    rw [hμ Z ⟨h1, h2⟩, hμ (⇑σ '' Z) ⟨hσZ1, hσZ2'⟩, AddMonoidHom.comp_apply,
      AddMonoidHom.comp_apply]
    have E : wcEtPullData ((Scheme.IdealSheafData.vanishingIdeal
        (⟨closure Z, isClosed_closure⟩ : TopologicalSpace.Closeds C)).subschemeι ≫ σ) M :=
      (wc_et_zmod_pull_data_exists _ M).some
    have Dσ : wcEtPullData σZ M := (wc_et_zmod_pull_data_exists σZ M).some
    have e1 := wc_et_pull_comp σ _ _ rfl D (D₀ Z) E 2 y
    have e2 := wc_et_pull_comp _ σZ _ hσZfac (D₀ (⇑σ '' Z)) Dσ E 2 y
    rw [← e1, e2]
    have hfac : σZ ≫ ((Scheme.IdealSheafData.vanishingIdeal
        (⟨closure (⇑σ '' Z), isClosed_closure⟩ : TopologicalSpace.Closeds C)).subschemeι ≫ fC) =
        ((Scheme.IdealSheafData.vanishingIdeal
        (⟨closure Z, isClosed_closure⟩ : TopologicalSpace.Closeds C)).subschemeι ≫ fC) ≫ ρ := by
      rw [← Category.assoc, hσZfac]
      simp only [Category.assoc, hσ]
    have hTm : wcEtPull Dσ 2 ∈ T ⟨Z, h1, h2⟩ ⟨⇑σ '' Z, hσZ1, hσZ2'⟩ :=
      (hT _ _ _).mpr ⟨σZ, hσZiso, ρ, Dσ, hfac, hρ, rfl⟩
    exact DFunLike.congr_fun (hφcoh _ _ _ hTm) _

theorem wc_r2gs_curve_h2_component_basis : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ε : Spec (.of Ω) ⟶ Spec (.of K)) (C : Scheme.{u}) (fC : C ⟶ Spec (.of Ω)) [IsProper fC] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → topologicalKrullDim C ≤ ((1 : ℕ) : WithBot ℕ∞) → (∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Y₀ : Scheme.{u}) (f : Y₀ ⟶ Spec (.of A)) [IsProper f] (m' : ℕ), m' ≠ 0 → ∀ S : Set (Spec (.of A)), IsOpen S → S ≠ Set.univ → ∀ q' : ℕ, Subsingleton (wcEtExt Y₀ (wcEtExtZero Y₀ (f ⁻¹' S) m') q')) → ∃ μ : Set C → (wcEtZModExt C ℓ 2 →+ ZMod ℓ), Set.Finite {Z : Set C | Z ∈ irreducibleComponents C ∧ ¬ topologicalKrullDim ↥Z ≤ ((0 : ℕ) : WithBot ℕ∞)} ∧ (∀ Z : Set C, ¬ (Z ∈ irreducibleComponents C ∧ ¬ topologicalKrullDim ↥Z ≤ ((0 : ℕ) : WithBot ℕ∞)) → μ Z = 0) ∧ (∀ y, (∀ Z : Set C, Z ∈ irreducibleComponents C → ¬ topologicalKrullDim ↥Z ≤ ((0 : ℕ) : WithBot ℕ∞) → μ Z y = 0) → y = 0) ∧ (∀ f : Set C → ZMod ℓ, ∃ y, ∀ Z : Set C, Z ∈ irreducibleComponents C → ¬ topologicalKrullDim ↥Z ≤ ((0 : ℕ) : WithBot ℕ∞) → μ Z y = f Z) ∧ ∀ (σ : C ⟶ C) [IsIso σ] (ρ : Spec (.of Ω) ⟶ Spec (.of Ω)), σ ≫ fC = fC ≫ ρ → ρ ≫ ε = ε → ∀ (D : wcEtPullData σ ℓ) (Z : Set C), Z ∈ irreducibleComponents C → ¬ topologicalKrullDim ↥Z ≤ ((0 : ℕ) : WithBot ℕ∞) → ∀ y, μ Z (wcEtPull D 2 y) = μ (⇑σ '' Z) y :=
by
  intro K _ _ Ω _ _ ε C fC _ ℓ hℓ hℓK hdim hPBC
  exact wc_r2gi_curve_h2_basis_pow K Ω ε C fC ℓ hℓ.ne_zero hℓK hdim hPBC

