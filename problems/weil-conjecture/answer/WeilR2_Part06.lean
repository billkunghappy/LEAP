  have hcup : ∀ (a c : ℕ) (h : a + c = m) (x : wcEtZModExt (Limits.pullback f f) ℓ a)
      (y : wcEtZModExt (Limits.pullback f f) ℓ c),
      wcEtZModCup (Limits.pullback f f) ℓ a c m h x y = x.comp y h := fun _ _ _ _ _ => rfl
  have hstar : ∀ (a c : ℕ) (h : a + c = m) (x : wcEtZModExt Y ℓ a)
