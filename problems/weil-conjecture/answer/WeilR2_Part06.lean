        exact map_add _ _ _), ?_, ?_, ?_⟩
    · intro U α
      obtain ⟨φ, hφ, rfl⟩ := I.extMk_surjective α (q + 1) rfl
      have hmem : evH U _ φ ∈ ((I.cocomplex.d q (q + 1)).hom.app (Opposite.op U)).hom.ker := by
        show ((I.cocomplex.d q (q + 1)).hom.app (Opposite.op U)).hom (evH U _ φ) = 0
        rw [← hnatG, hφ, map_zero]
      refine ⟨⟨evH U _ φ, hmem⟩, ?_⟩
      show I.extMk (φx U _) (q + 1) rfl (hcoc U _) = I.extMk φ (q + 1) rfl hφ
      exact hext _ _ _ _ ((evE U _).symm_apply_apply φ)
    · intro U x
      show I.extMk (φx U x) (q + 1) rfl (hcoc U x) = 0 ↔ _
      rw [s2 q _ (φx U x) (hcoc U x)]
      constructor
      · rintro ⟨g, hg⟩
        refine ⟨evH U _ g, ?_⟩
        rw [← hnatG, hg, hφx]
      · rintro ⟨y, hy⟩
        refine ⟨(evE U _).symm y, ?_⟩
        apply (evE U _).injective
        show evH U _ ((evE U _).symm y ≫ I.cocomplex.d (q - 1) q) = evH U _ (φx U x)
        rw [hnatG, hφx]
        show ((I.cocomplex.d (q - 1) q).hom.app (Opposite.op U)).hom
          ((evE U _) ((evE U _).symm y)) = x.1
        rw [AddEquiv.apply_symm_apply]
        exact hy
    · intro U U' h x x' hx
      have hφ' : φx U' x' = Zm U U' h ≫ φx U x := by
        apply (evE U' _).injective
        show evH U' _ (φx U' x') = evH U' _ (Zm U U' h ≫ φx U x)
        rw [hφx, hnatU, hφx, hx]
      show I.extMk (φx U' x') (q + 1) rfl (hcoc U' x') =
        (Abelian.Ext.mk₀ (Zm U U' h)).comp (I.extMk (φx U x) (q + 1) rfl (hcoc U x)) (zero_add q)
      rw [I.mk₀_comp_extMk]
      exact hext _ _ _ _ hφ'

  obtain ⟨ψ, hψs, hψk, hψn⟩ := s4
  obtain ⟨π, hπs, hπk, hπn⟩ := s3 (((sheafToPresheaf (Scheme.smallEtaleTopology X)
    AddCommGrpCat.{u+1} ⋙ (Functor.whiskeringLeft 𝒞ᵒᵖ (X.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj
      Φ.op).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex)
  let ψ' : ∀ c : 𝒞, (((((sheafToPresheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1} ⋙ (Functor.whiskeringLeft 𝒞ᵒᵖ (X.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj
        Φ.op).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).d q (q + 1)).app
          (Opposite.op c)).hom.ker →+ Abelian.Ext (Zf (Φ.obj c)) A q := fun c => ψ (Φ.obj c)
  have hle : ∀ c : 𝒞, (π (Opposite.op c)).ker ≤ (ψ' c).ker := by
    intro c x hx
    rw [AddMonoidHom.mem_ker] at hx ⊢
    exact (hψk (Φ.obj c) x).2 ((hπk (Opposite.op c) x).1 hx)
  let lam := fun c : 𝒞 => (π (Opposite.op c)).liftOfRightInverse
    (Function.surjInv (hπs (Opposite.op c))) (Function.rightInverse_surjInv (hπs (Opposite.op c)))
      ⟨ψ' c, hle c⟩
  have hcomp : ∀ (c : 𝒞) x, lam c (π (Opposite.op c) x) = ψ (Φ.obj c) x := fun c x =>
    AddMonoidHom.liftOfRightInverse_comp_apply _ _ _ _ x
  refine ⟨lam, ?_, ?_⟩
  · intro c
    constructor
    · rw [injective_iff_map_eq_zero]
      intro y hy
      obtain ⟨x, rfl⟩ := hπs (Opposite.op c) y
      rw [hcomp] at hy
      exact (hπk (Opposite.op c) x).2 ((hψk (Φ.obj c) x).1 hy)
    · intro α
      obtain ⟨x, hx⟩ := hψs (Φ.obj c) α
      exact ⟨π (Opposite.op c) x, (hcomp c x).trans hx⟩
  · intro c c' f x
    obtain ⟨k, rfl⟩ := hπs (Opposite.op c) x
    have hk : ((I.cocomplex.d q (q + 1)).hom.app (Opposite.op (Φ.obj c))).hom k.1 = 0 := k.2
    have hmem : ((I.cocomplex.X q).obj.map (Φ.map f).op).hom k.1 ∈
        ((I.cocomplex.d q (q + 1)).hom.app (Opposite.op (Φ.obj c'))).hom.ker := by
      rw [AddMonoidHom.mem_ker]
      have hn := NatTrans.naturality_apply (I.cocomplex.d q (q + 1)).hom (Φ.map f).op k.1
      calc _ = ((I.cocomplex.X (q + 1)).obj.map (Φ.map f).op).hom
            (((I.cocomplex.d q (q + 1)).hom.app (Opposite.op (Φ.obj c))).hom k.1) := hn
        _ = 0 := by rw [hk, map_zero]
    let k' : (((((sheafToPresheaf (Scheme.smallEtaleTopology X)
        AddCommGrpCat.{u+1} ⋙ (Functor.whiskeringLeft 𝒞ᵒᵖ (X.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj
          Φ.op).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).d q (q + 1)).app
            (Opposite.op c')).hom.ker := ⟨((I.cocomplex.X q).obj.map (Φ.map f).op).hom k.1, hmem⟩
    refine (congrArg (lam c') (hπn (Opposite.op c) (Opposite.op c') f.op k k' rfl)).trans ?_
    refine (hcomp c' k').trans ?_
    refine (hψn (Φ.obj c) (Φ.obj c') (Φ.map f) k k' rfl).trans ?_
    rw [hcomp c k]

theorem ext_transfer_of_corep {C : Type*} [Category C] [Abelian C] [HasExt C] [EnoughInjectives C]
    {D : Type*} [Category D] [Abelian D] [HasExt D] (F : C ⥤ D) [F.Additive]
    [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F]
    (X : C) (P : D) (ε : P ⟶ F.obj X)
    (hhom : ∀ Y : C, Function.Bijective (fun f : X ⟶ Y => ε ≫ F.map f))
    (hvan : ∀ (I : C) [Injective I] (n : ℕ) (e : Abelian.Ext P (F.obj I) (n + 1)), e = 0)
    (Y : C) (n : ℕ) :
    Function.Bijective (fun β : Abelian.Ext X Y n =>
      (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor F β) (zero_add n)) :=
by
  have hcomp : ∀ {Z W : C} {a b c : ℕ} (w : Abelian.Ext X Z a) (γ : Abelian.Ext Z W b)
      (h : a + b = c),
      (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor F (w.comp γ h)) (zero_add c) =
        ((Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor F w) (zero_add a)).comp
          (Abelian.Ext.mapExactFunctor F γ) h := by
    intro Z W a b c w γ h
    rw [Abelian.Ext.mapExactFunctor_comp]
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add a) h (by omega)).symm
  have hadd : ∀ {Z : C} {m : ℕ} (a b : Abelian.Ext X Z m),
      (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor F (a + b)) (zero_add m) =
        (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor F a) (zero_add m) +
        (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor F b) (zero_add m) := by
    intro Z m a b
    rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.comp_add]
  have key : ∀ (n : ℕ) (Y : C), Function.Bijective (fun β : Abelian.Ext X Y n =>
      (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor F β) (zero_add n)) := by
    intro n
    induction n with
    | zero =>
      intro Y
      constructor
      · intro x₁ x₂ h
        change (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor F x₁) (zero_add 0) =
          (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor F x₂) (zero_add 0) at h
        have e1 := Abelian.Ext.mk₀_homEquiv₀_apply x₁
        have e2 := Abelian.Ext.mk₀_homEquiv₀_apply x₂
        rw [← e1, ← e2, Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
          Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀] at h
        have h1 := (Abelian.Ext.mk₀_bijective _ _).1 h
        have h2 : Abelian.Ext.homEquiv₀ x₁ = Abelian.Ext.homEquiv₀ x₂ := (hhom Y).1 h1
        rw [← e1, ← e2, h2]
      · intro z'
        obtain ⟨f, hf⟩ := (hhom Y).2 (Abelian.Ext.homEquiv₀ z')
        refine ⟨Abelian.Ext.mk₀ f, ?_⟩
        change ε ≫ F.map f = Abelian.Ext.homEquiv₀ z' at hf
        change (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor F (Abelian.Ext.mk₀ f))
          (zero_add 0) = z'
        rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀, hf,
          Abelian.Ext.mk₀_homEquiv₀_apply]
    | succ n ih =>
      intro Y
      let ι := Injective.ι Y
      let S : ShortComplex C :=
        ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)
      have hS : S.ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) inferInstance inferInstance
      have hFS : (S.map F).ShortExact := hS.map_of_exact F
      haveI : Injective S.X₂ := (inferInstance : Injective (Injective.under Y))
      have bridge : ∀ w : Abelian.Ext X S.X₃ n,
          (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor F (w.comp hS.extClass rfl))
            (zero_add (n + 1)) =
          ((Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor F w) (zero_add n)).comp
            hFS.extClass rfl := by
        intro w
        rw [hcomp, Abelian.Ext.mapExactFunctor_extClass]
      constructor
      · let Φ : Abelian.Ext X Y (n + 1) →+ Abelian.Ext P (F.obj Y) (n + 1) :=
          AddMonoidHom.mk' (fun β => (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor F β)
            (zero_add (n + 1))) hadd
        have hker : ∀ z : Abelian.Ext X Y (n + 1),
            (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor F z) (zero_add (n + 1)) = 0 →
            z = 0 := by
          intro z hz
          have h0 : z.comp (Abelian.Ext.mk₀ S.f) (add_zero _) = 0 :=
            Abelian.Ext.eq_zero_of_injective _
          obtain ⟨w, hw⟩ := Abelian.Ext.covariant_sequence_exact₁ X hS z h0 (n₀ := n) rfl
          have h1 : ((Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor F w)
              (zero_add n)).comp hFS.extClass rfl = 0 := by
            rw [← bridge, hw]; exact hz
          obtain ⟨v', hv'⟩ := Abelian.Ext.covariant_sequence_exact₃ P hFS _ rfl h1
          obtain ⟨v, hv⟩ := (ih S.X₂).2 v'
          change (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor F v) (zero_add n) = v'
            at hv
          have hw2 : w = v.comp (Abelian.Ext.mk₀ S.g) (add_zero n) := by
            apply (ih S.X₃).1
            change (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor F w) (zero_add n) =
              (Abelian.Ext.mk₀ ε).comp
                (Abelian.Ext.mapExactFunctor F (v.comp (Abelian.Ext.mk₀ S.g) (add_zero n)))
                (zero_add n)
            rw [hcomp, Abelian.Ext.mapExactFunctor_mk₀, hv]
            exact hv'.symm
          rw [← hw, hw2, Abelian.Ext.comp_assoc _ _ _ (add_zero n) (zero_add 1) (by omega),
            hS.comp_extClass, Abelian.Ext.comp_zero]
        intro z₁ z₂ h
        change (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor F z₁) (zero_add (n + 1)) =
          (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor F z₂) (zero_add (n + 1)) at h
        rw [← sub_eq_zero]
        apply hker
        have hsub := map_sub Φ z₁ z₂
        change (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor F (z₁ - z₂))
            (zero_add (n + 1)) =
          (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor F z₁) (zero_add (n + 1)) -
          (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor F z₂) (zero_add (n + 1)) at hsub
        rw [hsub, h, sub_self]
      · intro z'
        have h0 : z'.comp (Abelian.Ext.mk₀ (S.map F).f) (add_zero _) = 0 :=
          hvan (Injective.under Y) n _
        obtain ⟨w', hw'⟩ := Abelian.Ext.covariant_sequence_exact₁ P hFS z' h0 (n₀ := n) rfl
        obtain ⟨w, hw⟩ := (ih S.X₃).2 w'
        change (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor F w) (zero_add n) = w'
          at hw
        refine ⟨w.comp hS.extClass rfl, ?_⟩
        change (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor F (w.comp hS.extClass rfl))
          (zero_add (n + 1)) = z'
        rw [bridge, hw, hw']
  exact key n Y

theorem wc_r2gs_free_ext_coh_natural : ∀ {X : Scheme.{u}} (m q : ℕ), letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _; ∃ μ : ∀ U : X.Etale, Abelian.Ext ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) q →+ wcR2gsH U.left m q, (∀ U, Function.Bijective (μ U)) ∧ ∀ (U U' : X.Etale) (h : U' ⟶ U) (hk : Etale h.left) e, μ U' ((Abelian.Ext.mk₀ ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map (Functor.whiskerRight (yoneda.map h) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)))).comp e (zero_add q)) = wcR2gsRes (MorphismProperty.Over.mk ⊤ h.left hk : U.left.Etale) m q (μ U e) :=
by
  intro X m q
  letI hE : ∀ (Y : Scheme.{u}), HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
    fun Y => HasExt.standard _
  haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) :=
    wc_et_enough_injectives X
  haveI hcont : ∀ {S : Scheme.{u}} (T : S.Etale),
      (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology S) :=
    fun T => (wc_et_slice_continuous T).1

  have hexact : ∀ {Y : Scheme.{u}} (T : Y.Etale), ((wcEtSlice T).sheafPushforwardContinuous AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y)).Additive ∧ Limits.PreservesFiniteLimits ((wcEtSlice T).sheafPushforwardContinuous AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y)) ∧ Limits.PreservesFiniteColimits ((wcEtSlice T).sheafPushforwardContinuous AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y)) ∧ ∀ (I : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) [Injective I], Injective (((wcEtSlice T).sheafPushforwardContinuous AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y)).obj I) := by
    intro Y T
    obtain ⟨-, hcocont⟩ := wc_et_slice_continuous T
    haveI := hcocont
    haveI := wc_et_slice_lan_finite_limits T
    let Lf := (wcEtSlice T).sheafPullback AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology T.left)
      (Scheme.smallEtaleTopology Y)
    let Rf := (wcEtSlice T).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y)
    let adj : Lf ⊣ Rf := (wcEtSlice T).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y)
    let adj2 := (wcEtSlice T).sheafAdjunctionCocontinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y)
    haveI : Limits.PreservesLimitsOfSize.{0, 0} Rf := adj.rightAdjoint_preservesLimits
    haveI hl : Limits.PreservesFiniteLimits Rf :=
      Limits.PreservesLimitsOfSize.preservesFiniteLimits Rf
    haveI : Limits.PreservesColimitsOfSize.{0, 0} Rf := adj2.leftAdjoint_preservesColimits
    haveI hc : Limits.PreservesFiniteColimits Rf :=
      Limits.PreservesColimitsOfSize.preservesFiniteColimits Rf
    haveI : Rf.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isRightAdjoint Rf
    haveI ha : Rf.Additive := Functor.additive_of_preserves_binary_products Rf
    haveI : Limits.PreservesFiniteLimits Lf := inferInstance
    haveI : Lf.PreservesMonomorphisms := preservesMonomorphisms_of_preservesLimitsOfShape Lf
    exact ⟨ha, hl, hc, fun I _ => Injective.injective_of_adjoint adj I⟩
  haveI hadd : ∀ {S : Scheme.{u}} (T : S.Etale), ((wcEtSlice T).sheafPushforwardContinuous
      AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology S)).Additive :=
    fun T => (hexact T).1
  haveI hlim : ∀ {S : Scheme.{u}} (T : S.Etale), Limits.PreservesFiniteLimits
      ((wcEtSlice T).sheafPushforwardContinuous AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology T.left)
        (Scheme.smallEtaleTopology S)) :=
    fun T => (hexact T).2.1
  haveI hcolim : ∀ {S : Scheme.{u}} (T : S.Etale), Limits.PreservesFiniteColimits
      ((wcEtSlice T).sheafPushforwardContinuous AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology T.left)
        (Scheme.smallEtaleTopology S)) :=
    fun T => (hexact T).2.2.1

  have hcnat : ∀ {Y : Scheme.{u}} (A : Type (u+1)) [AddCommGroup A] {V W : Y.Etale} (d : W ⟶ V) (x : A),
      (((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of A)).obj.map d.op).hom (wcConstSec Y A V x) = wcConstSec Y A W x := by
    intro Y A _ V W d x
    have h := (toSheafify (Scheme.smallEtaleTopology Y)
      ((Functor.const (Y.Etale)ᵒᵖ).obj (AddCommGrpCat.of A))).naturality d.op
    have h2 := congrArg (fun φ => φ.hom x) h
    simp only [Functor.const_obj_map] at h2
    exact h2.symm
  have hcext : ∀ {Y : Scheme.{u}} (A : Type (u+1)) [AddCommGroup A]
      (M : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (f g : (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of A) ⟶ M),
      (∀ (V : Y.Etale) (x : A), (f.hom.app (Opposite.op V)).hom (wcConstSec Y A V x) = (g.hom.app (Opposite.op V)).hom (wcConstSec Y A V x)) → f = g := by
    intro Y A _ M f g h
    apply Sheaf.hom_ext
    refine sheafify_hom_ext (P := (Functor.const (Y.Etale)ᵒᵖ).obj (AddCommGrpCat.of A)) _ f.hom g.hom
      M.property ?_
    ext V x
    exact h V.unop x
  have hcst : ∀ {Y : Scheme.{u}} (V : Y.Etale) (x : ULift.{u+1} ℤ),
      wcConstSec Y (ULift.{u+1} ℤ) V x = x.down • wcConstSec Y (ULift.{u+1} ℤ) V (ULift.up 1) := by
    intro Y V x
    have hx : x = x.down • (ULift.up 1 : ULift.{u+1} ℤ) := by
      apply ULift.ext; simp
    conv_lhs => rw [hx]
    exact map_zsmul _ _ _

  have hres : ∀ {Y : Scheme.{u}} (T : Y.Etale) (A : Type (u+1)) [AddCommGroup A] (V : T.left.Etale) (x : A),
      ((wcR2gsConstRes T (AddCommGrpCat.of A)).hom.app (Opposite.op V)).hom (wcConstSec T.left A V x) = wcConstSec Y A ((wcEtSlice T).obj V) x := by
    intro Y T A _ V x
    have h := toSheafify_sheafifyLift (Scheme.smallEtaleTopology T.left)
      (Functor.whiskerLeft (wcEtSlice T).op
        (toSheafify (Scheme.smallEtaleTopology Y) ((Functor.const (Y.Etale)ᵒᵖ).obj (AddCommGrpCat.of A))) :
          (Functor.const (T.left.Etale)ᵒᵖ).obj (AddCommGrpCat.of A) ⟶ _)
      (((wcEtSlice T).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y)).obj
        ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of A))).property
    exact congrArg (fun φ => (φ.app (Opposite.op V)).hom x) h
  haveI hiso : ∀ {Y : Scheme.{u}} (T : Y.Etale) (A : Type (u+1)) [AddCommGroup A],
      IsIso (wcR2gsConstRes T (AddCommGrpCat.of A)) := by
    intro Y T A _
    haveI := (wc_et_slice_continuous T).2
    have e : wcR2gsConstRes T (AddCommGrpCat.of A) =
        ((wcEtSlice T).pushforwardContinuousSheafificationCompatibility AddCommGrpCat.{u+1}
          (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y)).hom.app
          ((Functor.const (Y.Etale)ᵒᵖ).obj (AddCommGrpCat.of A)) := by
      apply Sheaf.hom_ext
      rw [Functor.pushforwardContinuousSheafificationCompatibility_hom_app_hom]
      rfl
    rw [e]
    exact (((wcEtSlice T).pushforwardContinuousSheafificationCompatibility AddCommGrpCat.{u+1}
          (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y)).app
