  have sInd : ∀ (R A : Type u) [CommRing R] [CommRing A] (σ : R →+* A), wcIndEtale σ → ∃ (J : Type u) (_ : SmallCategory J) (_ : IsFiltered J) (D : J ⥤ CommRingCat.{u}) (s : ∀ j, R →+* D.obj j) (β : ∀ j, D.obj j ⟶ CommRingCat.of A), (∀ j, (s j).Etale) ∧ (∀ {j j' : J} (t : j ⟶ j'), (D.map t).hom.comp (s j) = s j') ∧ (∀ {j j' : J} (t : j ⟶ j'), D.map t ≫ β j' = β j) ∧ (∀ j, (β j).hom.comp (s j) = σ) ∧ (∀ a : A, ∃ (j : J) (x : D.obj j), (β j).hom x = a) ∧ (∀ (j j' : J) (x : D.obj j) (y : D.obj j'), (β j).hom x = (β j').hom y → ∃ (k : J) (t : j ⟶ k) (t' : j' ⟶ k), (D.map t).hom x = (D.map t').hom y) ∧ (∀ (C : Type u) [CommRing C] [Algebra R C], Algebra.FinitePresentation R C → ∀ γ : C →+* A, γ.comp (algebraMap R C) = σ → ∃ (j : J) (α : C →+* D.obj j), α.comp (algebraMap R C) = s j ∧ (β j).hom.comp α = γ) ∧ (∀ (j j' : J) (f : D.obj j →+* D.obj j'), f.comp (s j) = s j' → (β j').hom.comp f = (β j).hom → ∃ t : j ⟶ j', (D.map t).hom = f) := by
