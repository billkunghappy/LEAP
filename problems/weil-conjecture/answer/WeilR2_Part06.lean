theorem wc_r2gs_hens_closed_fibre_pull_bij : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Y₀ : Scheme.{u}) (f : Y₀ ⟶ Spec (.of A)) [IsProper f] (m : ℕ), m ≠ 0 → (∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Y₀ : Scheme.{u}) (f : Y₀ ⟶ Spec (.of A)) [IsProper f] (m' : ℕ), m' ≠ 0 → ∀ S : Set (Spec (.of A)), IsOpen S → S ≠ Set.univ → ∀ q' : ℕ, Subsingleton (wcEtExt Y₀ (wcEtExtZero Y₀ (f ⁻¹' S) m') q')) → ∀ (Z : Scheme.{u}) (i : Z ⟶ Y₀) (p : Z ⟶ Spec (.of (IsLocalRing.ResidueField A))), IsPullback i p f (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))) → ∀ (D : wcEtPullData i m) (q : ℕ), Function.Bijective (wcEtPull D q) :=
by
  intro A _ _ _ Y₀ f _ m hm hPBC Z i p hsq D q
  classical
  set r : Spec (.of (IsLocalRing.ResidueField A)) ⟶ Spec (.of A) :=
    Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) with hr
  haveI hrci : IsClosedImmersion r :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  haveI hici : IsClosedImmersion i :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq.flip hrci

