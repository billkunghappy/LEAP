    (fun V => ((((((sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⋙ (Functor.whiskeringLeft (B.Etale)ᵒᵖ (X.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj (@Functor.op B.Etale _ X.Etale _ (wcEtBaseChange g))).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q).obj (Opposite.op V) : AddCommGrpCat.{u+1}) : Type (u+1)))
    (fun V => (ρ.app (Opposite.op V)).hom)
    (fun {V V'} f => (((((sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⋙ (Functor.whiskeringLeft (B.Etale)ᵒᵖ (X.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj (@Functor.op B.Etale _ X.Etale _ (wcEtBaseChange g))).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q).map f.op).hom)
    (fun A => (wcEtPull (DA A) q).comp (κ A.right)) hcof
    (fun f x => (congrArg (fun φ => AddCommGrpCat.Hom.hom φ x) (ρ.naturality f.op)).symm)
    (fun f f' x => congrArg (fun φ => AddCommGrpCat.Hom.hom φ x)
      ((((((sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⋙ (Functor.whiskeringLeft (B.Etale)ᵒᵖ (X.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj (@Functor.op B.Etale _ X.Etale _ (wcEtBaseChange g))).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q).map_comp f.op f'.op)))
  obtain ⟨e, he⟩ := key
    (by
      intro A A' f x
      obtain ⟨Df, hDf⟩ := hκnat A.right A'.right f.right
      exact (wc_et_pull_comp _ _ _ (I1 A A' f) Df (DA A') (DA A) q (κ A.right x)).trans
        (congrArg (fun z => wcEtPull (DA A') q z) (hDf x).symm))
    hlocS hlocI
    (by
      intro y
      obtain ⟨A, x, D, hD⟩ := hgS y
      obtain ⟨c, hc⟩ := (hκbij A.right).2 x
      exact ⟨A, c, (congrArg (fun z => wcEtPull (DA A) q z) hc).trans
        ((indep D (DA A) q x).trans hD)⟩)
    (by
      intro A c hc
      obtain ⟨A', f, D', hD'⟩ := hgK A (κ A.right c) (DA A) hc
      obtain ⟨Df, hDf⟩ := hκnat A.right A'.right f.right
      refine ⟨A', f, (hκbij A'.right).1 ?_⟩
      exact (hDf c).trans ((indep D' Df q _).trans (hD'.trans (map_zero _).symm)))
  refine ⟨e, fun τ hτ => ?_⟩
  obtain ⟨D⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.map g (wcEtGeomPt B b) g
    (wcEtGeomPt B b) (𝟙 X) τ (𝟙 B) (by simp) (by rw [Category.comp_id, hτ])) m
  refine ⟨D, fun A s => ?_⟩
  let tA : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B) →
      StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B) := fun A =>
    StructuredArrow.mk (Over.homMk (τ ≫ A.hom.left) (by rw [Category.assoc, Over.w A.hom]; exact hτ) :
      Over.mk (wcEtGeomPt B b) ⟶ (Scheme.Etale.forget B).obj A.right)
  have I2 : ∀ A : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B),
      Limits.pullback.map g (wcEtGeomPt B b) g (wcEtGeomPt B b) (𝟙 X) τ (𝟙 B) (by simp)
        (by rw [Category.comp_id, hτ]) ≫ tt A = tt (tA A) := by
    intro A
    apply Limits.pullback.hom_ext
    · have e1 : Limits.pullback.map g (wcEtGeomPt B b) g (wcEtGeomPt B b) (𝟙 X) τ (𝟙 B) (by simp)
          (by rw [Category.comp_id, hτ]) ≫ Limits.pullback.snd g (wcEtGeomPt B b) =
          Limits.pullback.snd g (wcEtGeomPt B b) ≫ τ := Limits.pullback.lift_snd _ _ _
      have e2 : tt A ≫ Limits.pullback.fst A.right.hom g =
          Limits.pullback.snd g (wcEtGeomPt B b) ≫ A.hom.left := Limits.pullback.lift_fst _ _ _
      have e3 : tt (tA A) ≫ Limits.pullback.fst A.right.hom g =
          Limits.pullback.snd g (wcEtGeomPt B b) ≫ (τ ≫ A.hom.left) :=
        Limits.pullback.lift_fst _ _ _
      exact (Category.assoc _ _ _).trans ((whisker_eq _ e2).trans ((Category.assoc _ _ _).symm.trans
        ((eq_whisker e1 _).trans ((Category.assoc _ _ _).trans e3.symm))))
    · have e1 : Limits.pullback.map g (wcEtGeomPt B b) g (wcEtGeomPt B b) (𝟙 X) τ (𝟙 B) (by simp)
          (by rw [Category.comp_id, hτ]) ≫ Limits.pullback.fst g (wcEtGeomPt B b) =
          Limits.pullback.fst g (wcEtGeomPt B b) ≫ 𝟙 X := Limits.pullback.lift_fst _ _ _
      have e2 : tt A ≫ Limits.pullback.snd A.right.hom g =
          Limits.pullback.fst g (wcEtGeomPt B b) := Limits.pullback.lift_snd _ _ _
      have e3 : tt (tA A) ≫ Limits.pullback.snd A.right.hom g =
          Limits.pullback.fst g (wcEtGeomPt B b) := Limits.pullback.lift_snd _ _ _
      rw [Category.assoc, e2, e1, Category.comp_id, e3]
  obtain ⟨A', f, c, hfc⟩ := hlocS A s
  have hw : (tA A').hom ≫ (Scheme.Etale.forget B).map f.right = (tA A).hom := by
    apply Over.OverMorphism.ext
    show (τ ≫ A'.hom.left) ≫ f.right.left = τ ≫ A.hom.left
    exact (Category.assoc _ _ _).trans (whisker_eq τ (hw4 A A' f))
  let fτ : tA A' ⟶ tA A := StructuredArrow.homMk f.right hw
  let G := (StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙
    ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q).obj
  have hA : (Limits.colimit.ι G (Opposite.op A)).hom s =
      (Limits.colimit.ι G (Opposite.op A')).hom ((ρ.app (Opposite.op A'.right)).hom c) :=
    (congrArg (fun φ => AddCommGrpCat.Hom.hom φ s) (Limits.colimit.w G f.op)).symm.trans
      (congrArg (fun y => (Limits.colimit.ι G (Opposite.op A')).hom y) hfc)
  have hτA : (Limits.colimit.ι G (Opposite.op (tA A))).hom s =
      (Limits.colimit.ι G (Opposite.op (tA A'))).hom ((ρ.app (Opposite.op A'.right)).hom c) :=
    (congrArg (fun φ => AddCommGrpCat.Hom.hom φ s) (Limits.colimit.w G fτ.op)).symm.trans
      (congrArg (fun y => (Limits.colimit.ι G (Opposite.op (tA A'))).hom y) hfc)
  calc e ((Limits.colimit.ι G (Opposite.op (tA A))).hom s)
      = e ((Limits.colimit.ι G (Opposite.op (tA A'))).hom ((ρ.app (Opposite.op A'.right)).hom c)) :=
        congrArg (fun z => e z) hτA
    _ = wcEtPull (DA (tA A')) q (κ A'.right c) := he (tA A') c
    _ = wcEtPull D q (wcEtPull (DA A') q (κ A'.right c)) :=
        wc_et_pull_comp _ _ _ (I2 A') (DA A') D (DA (tA A')) q _
    _ = wcEtPull D q (e ((Limits.colimit.ι G (Opposite.op A')).hom
          ((ρ.app (Opposite.op A'.right)).hom c))) :=
        congrArg (fun z => wcEtPull D q z) (he A' c).symm
    _ = wcEtPull D q (e ((Limits.colimit.ι G (Opposite.op A)).hom s)) :=
        congrArg (fun z => wcEtPull D q (e z)) hA.symm

theorem wc_pcrb_curve_components_top : ∀ (X : Type u) [TopologicalSpace X] [T0Space X] [QuasiSober X], topologicalKrullDim X ≤ ((1 : ℕ) : WithBot ℕ∞) → Set.ncard {x : X | ¬ IsClosed ({x} : Set X)} = Set.ncard {Z : Set X | Z ∈ irreducibleComponents X ∧ ¬ topologicalKrullDim ↥Z ≤ ((0 : ℕ) : WithBot ℕ∞)} ∧ ∀ Z W : Set X, Z ∈ irreducibleComponents X → W ∈ irreducibleComponents X → Z ≠ W → topologicalKrullDim ↥(Z ∩ W) < ((1 : ℕ) : WithBot ℕ∞) :=
by
  intro X _ _ _ hdim
  classical

  have s4 : ∀ A B C : Set X, IsIrreducible A → IsClosed A → IsIrreducible B → IsClosed B →
      IsIrreducible C → IsClosed C → A ⊂ B → B ⊂ C → False := by
    intro A B C hAi hAc hBi hBc hCi hCc hAB hBC
    let a : TopologicalSpace.IrreducibleCloseds X := ⟨A, hAi, hAc⟩
    let b : TopologicalSpace.IrreducibleCloseds X := ⟨B, hBi, hBc⟩
    let c : TopologicalSpace.IrreducibleCloseds X := ⟨C, hCi, hCc⟩
    have hab : a < b := hAB
    have hbc : b < c := hBC
    have hmono : StrictMono (![a, b, c] : Fin 3 → TopologicalSpace.IrreducibleCloseds X) := by
      rw [Fin.strictMono_iff_lt_succ]
      intro i
      fin_cases i
      · exact hab
      · exact hbc
    let p : LTSeries (TopologicalSpace.IrreducibleCloseds X) := LTSeries.mk 2 ![a, b, c] hmono
    have h1 := Order.LTSeries.length_le_krullDim p
    have h2 : ((2 : ℕ) : WithBot ℕ∞) ≤ ((1 : ℕ) : WithBot ℕ∞) := le_trans h1 hdim
    norm_num at h2

  have s0 : ∀ x : X, ¬ IsClosed ({x} : Set X) →
      ∃ y : X, closure ({y} : Set X) ⊂ closure ({x} : Set X) := by
    intro x hx
    have h1 : ¬ closure ({x} : Set X) ⊆ {x} := fun h => hx (closure_subset_iff_isClosed.mp h)
    obtain ⟨y, hy, hyx⟩ := Set.not_subset.mp h1
    refine ⟨y, Set.ssubset_iff_subset_ne.mpr
      ⟨closure_minimal (Set.singleton_subset_iff.mpr hy) isClosed_closure, fun h => hyx ?_⟩⟩
    exact (inseparable_iff_closure_eq.mpr h).eq

  have s1 : ∀ S : Set X, ((1 : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim ↥S →
      ∃ A B : Set X, IsIrreducible A ∧ IsClosed A ∧ IsIrreducible B ∧ IsClosed B ∧
        A ⊂ B ∧ B ⊆ closure S := by
    intro S hS
    obtain ⟨l, hl⟩ := (Order.le_krullDim_iff).mp hS
    have h0 : (0 : Fin (l.length + 1)) < Fin.last l.length := by
      rw [Fin.lt_def]
      simp [hl]
    have hab : l 0 < l (Fin.last l.length) := l.strictMono h0
    set a := l 0
    set b := l (Fin.last l.length)
    have hsub : (a : Set S) ⊆ b := hab.le
    refine ⟨closure (Subtype.val '' (a : Set S)), closure (Subtype.val '' (b : Set S)),
      (a.isIrreducible.image Subtype.val continuous_subtype_val.continuousOn).closure,
      isClosed_closure,
      (b.isIrreducible.image Subtype.val continuous_subtype_val.continuousOn).closure,
      isClosed_closure, Set.ssubset_iff_subset_ne.mpr ⟨closure_mono (Set.image_mono hsub), ?_⟩,
      closure_mono (Subtype.coe_image_subset S b)⟩
    intro heq
    have ha := Topology.IsInducing.subtypeVal.closure_eq_preimage_closure_image (a : Set S)
    have hb := Topology.IsInducing.subtypeVal.closure_eq_preimage_closure_image (b : Set S)
    rw [a.isClosed.closure_eq] at ha
    rw [b.isClosed.closure_eq] at hb
    have hab' : (a : Set S) = b := by rw [ha, hb, heq]
    exact hab.ne (SetLike.coe_injective hab')

  have s2 : ∀ x y : X, closure ({y} : Set X) ⊂ closure ({x} : Set X) →
      ¬ topologicalKrullDim ↥(closure ({x} : Set X)) ≤ ((0 : ℕ) : WithBot ℕ∞) := by
    intro x y h hle
    have hyS : y ∈ closure ({x} : Set X) := h.1 (subset_closure rfl)
    have hxS : x ∈ closure ({x} : Set X) := subset_closure rfl
    let x' : closure ({x} : Set X) := ⟨x, hxS⟩
    let y' : closure ({x} : Set X) := ⟨y, hyS⟩
    let a : TopologicalSpace.IrreducibleCloseds (closure ({x} : Set X)) :=
      ⟨closure {y'}, isIrreducible_singleton.closure, isClosed_closure⟩
    let b : TopologicalSpace.IrreducibleCloseds (closure ({x} : Set X)) :=
      ⟨closure {x'}, isIrreducible_singleton.closure, isClosed_closure⟩
    have hle' : a ≤ b := by
      show closure {y'} ⊆ closure {x'}
      rw [← specializes_iff_closure_subset, ← Topology.IsInducing.subtypeVal.specializes_iff]
      exact specializes_iff_closure_subset.mpr h.1
    have hne : a ≠ b := by
      intro hab
      have h3 : closure {x'} ⊆ closure {y'} := by
        have := congrArg (fun t : TopologicalSpace.IrreducibleCloseds (closure ({x} : Set X)) =>
          (t : Set (closure ({x} : Set X)))) hab
        exact this.symm.subset
      rw [← specializes_iff_closure_subset, ← Topology.IsInducing.subtypeVal.specializes_iff] at h3
      exact h.2 (specializes_iff_closure_subset.mp h3)
    have hlt : a < b := lt_of_le_of_ne hle' hne
    rw [Nat.cast_zero] at hle
    have hmax := (Order.krullDim_nonpos_iff_forall_isMax.mp hle) a
    exact hmax.not_lt hlt

  have s3 : ∀ η : X, topologicalKrullDim ↥({η} : Set X) ≤ ((0 : ℕ) : WithBot ℕ∞) := by
    intro η
    rw [Nat.cast_zero]
    apply Order.krullDim_nonpos_iff_forall_isMax.mpr
    intro a b _
    have hne := a.isIrreducible.nonempty
    have hu : (a : Set ↥({η} : Set X)) = Set.univ := hne.eq_univ
    show (b : Set ↥({η} : Set X)) ⊆ a
    rw [hu]
    exact Set.subset_univ _
  refine ⟨?_, ?_⟩
  ·
    have s6 : ∀ x : X, ¬ IsClosed ({x} : Set X) → closure ({x} : Set X) ∈ irreducibleComponents X := by
      intro x hx
      obtain ⟨y, hy⟩ := s0 x hx
      refine ⟨isIrreducible_singleton.closure, fun T hT hxT => ?_⟩
      by_contra hTx
      have hne : closure ({x} : Set X) ⊂ closure T := Set.ssubset_iff_subset_ne.mpr
        ⟨hxT.trans subset_closure, fun heq => hTx (subset_closure.trans heq.symm.subset)⟩
      exact s4 _ _ _ isIrreducible_singleton.closure isClosed_closure
        isIrreducible_singleton.closure isClosed_closure hT.closure isClosed_closure hy hne
    apply Set.ncard_congr (fun x _ => closure ({x} : Set X))
    · intro x hx
      obtain ⟨y, hy⟩ := s0 x hx
      exact ⟨s6 x hx, s2 x y hy⟩
    · intro x x' _ _ h
      exact (inseparable_iff_closure_eq.mpr h).eq
    · rintro Z ⟨hZ, hZd⟩
      have hZm : Maximal IsIrreducible Z := hZ
      obtain ⟨η, hη⟩ := QuasiSober.sober hZm.1 (isClosed_of_mem_irreducibleComponents Z hZ)
      refine ⟨η, ?_, hη.def⟩
      intro hc
      apply hZd
      have hZη : Z = {η} := by rw [← hη.def, hc.closure_eq]
      rw [hZη]
      exact s3 η
  ·
    intro Z W hZ hW hZW
    by_contra hlt
    have h1 : ((1 : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim ↥(Z ∩ W) := not_lt.mp hlt
    obtain ⟨A, B, hAi, hAc, hBi, hBc, hAB, hBS⟩ := s1 _ h1
    have hZm : Maximal IsIrreducible Z := hZ
    have hWm : Maximal IsIrreducible W := hW
    have hZc := isClosed_of_mem_irreducibleComponents Z hZ
    have hWc := isClosed_of_mem_irreducibleComponents W hW
    rw [(hZc.inter hWc).closure_eq] at hBS
    have hBZ : B ⊂ Z := by
      refine Set.ssubset_iff_subset_ne.mpr ⟨fun z hz => (hBS hz).1, fun hBZ => hZW ?_⟩
      have hZW' : Z ⊆ W := fun z hz => (hBS (by rw [hBZ]; exact hz)).2
      exact le_antisymm hZW' (hZm.2 hWm.1 hZW')
    exact s4 A B Z hAi hAc hBi hBc hZm.1 hZc hAB hBZ

theorem wc_pcrb_pull_supp_transfer : ∀ {X Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i] (n : ℕ) (D : wcEtPullData i n) (k : ℕ), letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing X n)) := HasExt.standard _; ∃ T : wcEtZModExt Z n k → Abelian.Ext (SheafOfModules.unit (wcEtZModRing X n)) (wcEtSuppObj D) k, Function.Injective T ∧ ∀ y : wcEtZModExt X n k, T (wcEtPull D k y) = y.comp (Abelian.Ext.mk₀ (wcEtSuppUnitMap D)) (add_zero k) :=
by
  intro X Z i _ n D k
  letI hX : HasExt (SheafOfModules.{u+1} (wcEtZModRing X n)) := HasExt.standard _
  letI hZ : HasExt (SheafOfModules.{u+1} (wcEtZModRing Z n)) := HasExt.standard _
  haveI := D.additive
  haveI := D.presLim
  haveI := D.presColim
  haveI := D.cont
  let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ
  haveI : P.Additive := D.adj.right_adjoint_additive
  haveI : Limits.PreservesLimitsOfSize.{0, 0} P := D.adj.rightAdjoint_preservesLimits
  haveI : Limits.PreservesFiniteLimits P := inferInstance
  haveI : Limits.PreservesFiniteColimits P := wc_et_finite_push_modules_exact i n D
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing X n)) :=
    sheafOfModules_enoughInjectives _ _
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing Z n)) :=
    sheafOfModules_enoughInjectives _ _

  have hnat : ∀ (m : ℕ) (B : SheafOfModules.{u+1} (wcEtZModRing X n))
      (u : Abelian.Ext (SheafOfModules.unit (wcEtZModRing X n)) B m),
      u.comp (Abelian.Ext.mk₀ (D.adj.unit.app B)) (add_zero m) =
        (Abelian.Ext.mk₀ (D.adj.unit.app (SheafOfModules.unit (wcEtZModRing X n)))).comp
          (Abelian.Ext.mapExactFunctor P (Abelian.Ext.mapExactFunctor D.Φ u)) (zero_add m) := by
    intro m
    induction m with
    | zero =>
      intro B u
      obtain ⟨f, rfl⟩ : ∃ f, Abelian.Ext.mk₀ f = u := ⟨_, Abelian.Ext.mk₀_homEquiv₀_apply u⟩
      rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀]
      congr 1
      exact D.adj.unit.naturality f
    | succ m ih =>
      intro B u
      let j := Injective.ι B
      let S : ShortComplex (SheafOfModules.{u+1} (wcEtZModRing X n)) :=
        ShortComplex.mk j (Limits.cokernel.π j) (Limits.cokernel.condition j)
      have hS : S.ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel j) inferInstance inferInstance
      haveI : Injective S.X₂ := (inferInstance : Injective (Injective.under B))
      have h0 : u.comp (Abelian.Ext.mk₀ S.f) (add_zero _) = 0 :=
        Abelian.Ext.eq_zero_of_injective _
      obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hS u h0 (n₀ := m) rfl
      subst hx₃
      have hS1 : (S.map D.Φ).ShortExact := hS.map_of_exact D.Φ
      have hS2 : ((S.map D.Φ).map P).ShortExact := hS1.map_of_exact P
      let φ : S ⟶ (S.map D.Φ).map P :=
        ShortComplex.homMk (D.adj.unit.app S.X₁) (D.adj.unit.app S.X₂) (D.adj.unit.app S.X₃)
          (D.adj.unit.naturality S.f).symm (D.adj.unit.naturality S.g).symm
      have hnatS : hS.extClass.comp (Abelian.Ext.mk₀ (D.adj.unit.app S.X₁)) (add_zero 1) =
          (Abelian.Ext.mk₀ (D.adj.unit.app S.X₃)).comp hS2.extClass (zero_add 1) :=
        hS.extClass_naturality hS2 φ
      have hext : Abelian.Ext.mapExactFunctor P (Abelian.Ext.mapExactFunctor D.Φ hS.extClass) =
          hS2.extClass := by
        rw [Abelian.Ext.mapExactFunctor_extClass, Abelian.Ext.mapExactFunctor_extClass]
      calc (x₃.comp hS.extClass rfl).comp (Abelian.Ext.mk₀ (D.adj.unit.app B)) (add_zero (m + 1))
          = x₃.comp (hS.extClass.comp (Abelian.Ext.mk₀ (D.adj.unit.app S.X₁)) (add_zero 1))
              (by omega) :=
            Abelian.Ext.comp_assoc x₃ hS.extClass (Abelian.Ext.mk₀ (D.adj.unit.app S.X₁)) rfl
              (add_zero 1) (by omega)
        _ = x₃.comp ((Abelian.Ext.mk₀ (D.adj.unit.app S.X₃)).comp hS2.extClass (zero_add 1))
              (by omega) := by rw [hnatS]
        _ = (x₃.comp (Abelian.Ext.mk₀ (D.adj.unit.app S.X₃)) (add_zero m)).comp hS2.extClass rfl :=
            (Abelian.Ext.comp_assoc x₃ (Abelian.Ext.mk₀ (D.adj.unit.app S.X₃)) hS2.extClass
              (add_zero m) (zero_add 1) (by omega)).symm
        _ = ((Abelian.Ext.mk₀ (D.adj.unit.app (SheafOfModules.unit (wcEtZModRing X n)))).comp
              (Abelian.Ext.mapExactFunctor P (Abelian.Ext.mapExactFunctor D.Φ x₃)) (zero_add m)).comp
              hS2.extClass rfl := by rw [ih S.X₃ x₃]
        _ = (Abelian.Ext.mk₀ (D.adj.unit.app (SheafOfModules.unit (wcEtZModRing X n)))).comp
              ((Abelian.Ext.mapExactFunctor P (Abelian.Ext.mapExactFunctor D.Φ x₃)).comp
                hS2.extClass rfl) (by omega) :=
            Abelian.Ext.comp_assoc _ _ _ (zero_add m) rfl (by omega)
        _ = (Abelian.Ext.mk₀ (D.adj.unit.app (SheafOfModules.unit (wcEtZModRing X n)))).comp
              (Abelian.Ext.mapExactFunctor P (Abelian.Ext.mapExactFunctor D.Φ
                (x₃.comp hS.extClass rfl))) (zero_add (m + 1)) := by
            rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp, hext]

  have hΘ := (wc_ext_adjoint_transfer D.Φ P D.adj (SheafOfModules.unit (wcEtZModRing X n))
    (SheafOfModules.unit (wcEtZModRing Z n)) k).1
  have hfac : ∀ β : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Z n))
      (SheafOfModules.unit (wcEtZModRing Z n)) k,
      (Abelian.Ext.mk₀ (wcEtSuppUnitMap D)).comp (Abelian.Ext.mapExactFunctor P β) (zero_add k) =
      (Abelian.Ext.mk₀ (D.adj.unit.app (SheafOfModules.unit (wcEtZModRing X n)))).comp
        (Abelian.Ext.mapExactFunctor P ((Abelian.Ext.mk₀ D.μ.hom).comp β (zero_add k)))
        (zero_add k) := by
    intro β
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.mk₀_comp_mk₀_assoc]
    rfl
  refine ⟨fun β => (Abelian.Ext.mk₀ (wcEtSuppUnitMap D)).comp
    (Abelian.Ext.mapExactFunctor P β) (zero_add k), ?_, ?_⟩
  · intro β₁ β₂ h
    have h' : (Abelian.Ext.mk₀ D.μ.hom).comp β₁ (zero_add k) =
        (Abelian.Ext.mk₀ D.μ.hom).comp β₂ (zero_add k) :=
      hΘ ((hfac β₁).symm.trans (h.trans (hfac β₂)))
    have e : ∀ β : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Z n))
        (SheafOfModules.unit (wcEtZModRing Z n)) k,
        (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mk₀ D.μ.hom).comp β (zero_add k))
          (zero_add k) = β := by
      intro β
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
    rw [← e β₁, ← e β₂, h']
  · intro y
    have hpull : wcEtPull D k y = (Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero k))
        (zero_add k) := rfl
    show (Abelian.Ext.mk₀ (wcEtSuppUnitMap D)).comp
      (Abelian.Ext.mapExactFunctor P (wcEtPull D k y)) (zero_add k) = _
    rw [hpull, hfac, Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp,
      Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_assoc _ _ _ (zero_add k) (add_zero k) (show 0 + k + 0 = k by omega),
      ← hnat k _ y,
      Abelian.Ext.comp_assoc _ _ _ (add_zero k) (zero_add 0) (show k + 0 + 0 = k by omega),
      Abelian.Ext.mk₀_comp_mk₀]
    rfl

theorem wc_pcrb_ext_two_lift_of_ker_coker : ∀ {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] [HasExt 𝒜] {J : Type} [Fintype J] [DecidableEq J] (U : 𝒜) (G : J → 𝒜) [Limits.HasBiproduct G] (u : ∀ j, U ⟶ G j), (∀ x : Abelian.Ext U (Limits.kernel (Limits.biproduct.lift u)) 3, x = 0) → (∀ x : Abelian.Ext U (Limits.cokernel (Limits.biproduct.lift u)) 2, x = 0) → ∀ e : ∀ j, Abelian.Ext U (G j) 2, ∃ y : Abelian.Ext U U 2, ∀ j, y.comp (Abelian.Ext.mk₀ (u j)) (add_zero 2) = e j :=
by
  intro 𝒜 _ _ _ J _ _ U G _ u hker hcok e
  set ub := Limits.biproduct.lift u with hub
  let g := Abelian.factorThruImage ub
  let m := Abelian.image.ι ub
  have hfac : g ≫ m = ub := Abelian.image.fac ub

  let E : Abelian.Ext U (Limits.biproduct G) 2 :=
    ∑ j, (e j).comp (Abelian.Ext.mk₀ (Limits.biproduct.ι G j)) (add_zero 2)
  have hE : ∀ j, E.comp (Abelian.Ext.mk₀ (Limits.biproduct.π G j)) (add_zero 2) = e j := by
    intro j
    simp only [E, Abelian.Ext.sum_comp]
    rw [Fintype.sum_eq_single j]
    · rw [Abelian.Ext.comp_assoc (e j) (Abelian.Ext.mk₀ (Limits.biproduct.ι G j))
        (Abelian.Ext.mk₀ (Limits.biproduct.π G j)) (add_zero 2) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Limits.biproduct.ι_π_self, Abelian.Ext.comp_mk₀_id]
    · intro i hi
      rw [Abelian.Ext.comp_assoc (e i) (Abelian.Ext.mk₀ (Limits.biproduct.ι G i))
        (Abelian.Ext.mk₀ (Limits.biproduct.π G j)) (add_zero 2) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Limits.biproduct.ι_π_ne G hi, Abelian.Ext.mk₀_zero,
        Abelian.Ext.comp_zero]

  let S₂ : ShortComplex 𝒜 :=
    ShortComplex.mk (Limits.kernel.ι (Limits.cokernel.π ub)) (Limits.cokernel.π ub)
      (Limits.kernel.condition _)
  have hS₂ : S₂.ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel (Limits.cokernel.π ub))
      inferInstance inferInstance

  obtain ⟨x₁, hx₁⟩ : ∃ x₁ : Abelian.Ext U (Abelian.image ub) 2,
      x₁.comp (Abelian.Ext.mk₀ m) (add_zero 2) = E :=
    Abelian.Ext.covariant_sequence_exact₂ U hS₂ E (hcok _)

  have w₁ : Limits.kernel.ι ub ≫ g = 0 := by
    rw [← cancel_mono m, Category.assoc, hfac, Limits.kernel.condition, Limits.zero_comp]
  let S₁ : ShortComplex 𝒜 := ShortComplex.mk (Limits.kernel.ι ub) g w₁
  have hS₁ex : S₁.Exact := by
    apply ShortComplex.exact_of_f_is_kernel
    exact Limits.KernelFork.IsLimit.ofι _ w₁
      (fun g' hg' => Limits.kernel.lift ub g'
        (by rw [← hfac, ← Category.assoc, hg', Limits.zero_comp]))
      (fun g' hg' => Limits.kernel.lift_ι _ _ _)
      (fun g' hg' m' hm' => by
        rw [← cancel_mono (Limits.kernel.ι ub), hm', Limits.kernel.lift_ι])
  have hg_epi : Epi g := inferInstance
  have hS₁ : S₁.ShortExact := ShortComplex.ShortExact.mk' hS₁ex inferInstance hg_epi

  obtain ⟨y, hy⟩ : ∃ y : Abelian.Ext U U 2, y.comp (Abelian.Ext.mk₀ g) (add_zero 2) = x₁ :=
    Abelian.Ext.covariant_sequence_exact₃ U hS₁ x₁ (rfl : 2 + 1 = 3) (hker _)

  refine ⟨y, fun j => ?_⟩
  have hu : u j = g ≫ m ≫ Limits.biproduct.π G j := by
    rw [← Category.assoc, hfac]
    exact (Limits.biproduct.lift_π u j).symm
  have key : y.comp (Abelian.Ext.mk₀ (g ≫ m ≫ Limits.biproduct.π G j)) (add_zero 2)
      = ((y.comp (Abelian.Ext.mk₀ g) (add_zero 2)).comp (Abelian.Ext.mk₀ m) (add_zero 2)).comp
          (Abelian.Ext.mk₀ (Limits.biproduct.π G j)) (add_zero 2) := by
    rw [Abelian.Ext.comp_assoc (y.comp (Abelian.Ext.mk₀ g) (add_zero 2)) (Abelian.Ext.mk₀ m)
        (Abelian.Ext.mk₀ (Limits.biproduct.π G j)) (add_zero 2) (add_zero 0) (by omega),
      Abelian.Ext.comp_assoc y (Abelian.Ext.mk₀ g)
        ((Abelian.Ext.mk₀ m).comp (Abelian.Ext.mk₀ (Limits.biproduct.π G j)) (add_zero 0))
        (add_zero 2) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀]
  rw [hu, key, hy, hx₁, hE j]

theorem wc_pcrb_additive_biproduct_lift_surj : ∀ {𝒜 : Type*} [Category 𝒜] [Preadditive 𝒜] {J : Type} [Fintype J] [DecidableEq J] (G : J → 𝒜) [Limits.HasBiproduct G] (U : 𝒜) (u : ∀ j, U ⟶ G j) (S : 𝒜 ⥤ AddCommGrpCat.{u+1}) [S.Additive], (∀ j, Function.Surjective (S.map (u j)).hom) → (∀ j j', j ≠ j' → Subsingleton (S.obj (G j)) ∨ Subsingleton (S.obj (G j'))) → Function.Surjective (S.map (Limits.biproduct.lift u)).hom :=
by
  intro 𝒜 _ _ J _ _ G _ U u S _ hsurj hsub
  classical
  have hsumapp : ∀ {A B : AddCommGrpCat.{u+1}} (s : Finset J) (f : J → (A ⟶ B)) (a : A),
      (∑ j ∈ s, f j).hom a = ∑ j ∈ s, (f j).hom a := by
    intro A B s f a
    induction s using Finset.induction_on with
    | empty => simp
    | insert i s hi ih =>
      rw [Finset.sum_insert hi, Finset.sum_insert hi, AddCommGrpCat.hom_add,
        AddMonoidHom.add_apply, ih]
  have hdec : ∀ z : S.obj (Limits.biproduct G), z = ∑ j,
      (S.map (Limits.biproduct.ι G j)).hom ((S.map (Limits.biproduct.π G j)).hom z) := by
    intro z
    have h1 : (S.map (𝟙 (Limits.biproduct G))).hom z = z := by simp
    rw [← Limits.biproduct.total, Functor.map_sum, hsumapp] at h1
    refine h1.symm.trans (Finset.sum_congr rfl (fun j _ => ?_))
    rw [Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply]
  have hcomp : ∀ x j, (S.map (Limits.biproduct.π G j)).hom
      ((S.map (Limits.biproduct.lift u)).hom x) = (S.map (u j)).hom x := by
    intro x j
    rw [← AddMonoidHom.comp_apply, ← AddCommGrpCat.hom_comp, ← Functor.map_comp,
      Limits.biproduct.lift_π]
  intro y
  obtain ⟨x, hx⟩ : ∃ x, ∀ j, (S.map (u j)).hom x = (S.map (Limits.biproduct.π G j)).hom y := by
    by_cases hP : ∃ j0, ¬ Subsingleton (S.obj (G j0))
    · obtain ⟨j0, hj0⟩ := hP
      obtain ⟨x, hx⟩ := hsurj j0 ((S.map (Limits.biproduct.π G j0)).hom y)
      refine ⟨x, fun j => ?_⟩
      by_cases hj : j = j0
      · subst hj; exact hx
      · rcases hsub j0 j (Ne.symm hj) with h | h
        · exact absurd h hj0
        · exact @Subsingleton.elim _ h _ _
    · simp only [not_exists, not_not] at hP
      exact ⟨0, fun j => @Subsingleton.elim _ (hP j) _ _⟩
  refine ⟨x, ?_⟩
  rw [hdec ((S.map (Limits.biproduct.lift u)).hom x), hdec y]
  refine Finset.sum_congr rfl (fun j _ => ?_)
  rw [hcomp, hx]

theorem wc_pcrb_et_stalk_surj_of_epi : ∀ {B : Scheme.{u}} {F G : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}} (φ : F ⟶ G), Epi φ → ∀ b : B, Function.Surjective ((wcEtStalk B b).map φ).hom :=
by
  intro B F G φ hφ b
  classical
  have hlift : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] {V U : Scheme.{u}} (g : V ⟶ U) [Etale g]
      (s : Spec (.of Ω) ⟶ U) (v : V), g v = s (IsLocalRing.closedPoint Ω) →
      ∃ t : Spec (.of Ω) ⟶ V, t ≫ g = s := by
    intro Ω _ _ V U g _ s v hv
    have hs : s = Spec.map (Scheme.SpecToEquivOfField Ω U s).2 ≫
        U.fromSpecResidueField (Scheme.SpecToEquivOfField Ω U s).1 := by
      rw [← Scheme.SpecToEquivOfField_symm_apply, Equiv.symm_apply_apply]
    have h1 : (Scheme.SpecToEquivOfField Ω U s).1 = s (IsLocalRing.closedPoint Ω) := rfl
    generalize Scheme.SpecToEquivOfField Ω U s = p at hs h1
    obtain ⟨u', ψ⟩ := p
    simp only at hs h1
    rw [← h1] at hv
    subst hv
    letI : Algebra (U.residueField (g v)) (V.residueField v) := (g.residueFieldMap v).hom.toAlgebra
    haveI : Algebra.IsSeparable (U.residueField (g v)) (V.residueField v) := inferInstance
    haveI : Algebra.IsAlgebraic (U.residueField (g v)) (V.residueField v) :=
      Algebra.IsSeparable.isAlgebraic _ _
    letI : Algebra (U.residueField (g v)) Ω := ψ.hom.toAlgebra
    let χ₀ : V.residueField v →ₐ[U.residueField (g v)] Ω :=
      IsAlgClosed.lift (R := U.residueField (g v)) (S := V.residueField v) (M := Ω)
    let χ : V.residueField v ⟶ CommRingCat.of Ω := CommRingCat.ofHom χ₀.toRingHom
    have hχ : g.residueFieldMap v ≫ χ = ψ := by
      ext r
      exact χ₀.commutes r
    refine ⟨Spec.map χ ≫ V.fromSpecResidueField v, ?_⟩
    rw [Category.assoc, ← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField,
      ← Category.assoc, ← Spec.map_comp, hχ, hs]
  have hcov : ∀ (V : B.Etale) (R : Sieve V), R ∈ Scheme.smallEtaleTopology B V →
      ∀ x : V.left, ∃ (V₁ : B.Etale) (c : V₁ ⟶ V) (y : V₁.left), R.arrows c ∧ c.left y = x := by
    intro V R hR x
    change R ∈ Scheme.smallGrothendieckTopology @Etale B V at hR
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
    obtain ⟨V₁, c, y, hc, -, hy⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hR x
    exact ⟨V₁, c, y, hc, hy⟩
  let X₀ : Over B := Over.mk (wcEtGeomPt B b)
  haveI : IsCofiltered (StructuredArrow X₀ (Scheme.Etale.forget B)) :=
    IsCofiltered.of_hasFiniteLimits _
  haveI : Limits.PreservesFilteredColimitsOfSize.{u, u+1} (forget AddCommGrpCat.{u+1}) :=
    Limits.preservesFilteredColimitsOfSize_shrink.{u+1, u+1, u, u+1} (forget AddCommGrpCat.{u+1})
  haveI hls : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology B) φ.hom :=
    (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} φ).mpr hφ
  intro z
  let D := (StructuredArrow.proj X₀ (Scheme.Etale.forget B)).op ⋙ G.obj
  let DF := (StructuredArrow.proj X₀ (Scheme.Etale.forget B)).op ⋙ F.obj
  obtain ⟨j, t, ht⟩ := Limits.Concrete.colimit_exists_rep D z
  have hR : Presheaf.imageSieve φ.hom t ∈
      Scheme.smallEtaleTopology B j.unop.right :=
    Presheaf.imageSieve_mem (Scheme.smallEtaleTopology B) φ.hom
      (U := Opposite.op j.unop.right) t
  obtain ⟨V₁, c, y, hc, hy⟩ := hcov j.unop.right _ hR
    (j.unop.hom.left (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b))))
  obtain ⟨f, hf⟩ := hc
  have hw : c.left ≫ j.unop.right.hom = V₁.hom := MorphismProperty.Over.w c
  haveI : Etale c.left := by
    have h1 : Etale j.unop.right.hom := j.unop.right.prop
    have h2 : Etale (c.left ≫ j.unop.right.hom) := by rw [hw]; exact V₁.prop
    exact Etale.of_comp c.left j.unop.right.hom
  obtain ⟨a', ha'⟩ := hlift (AlgebraicClosure (B.residueField b))
    c.left j.unop.hom.left y hy
  have hA : j.unop.hom.left ≫ j.unop.right.hom = wcEtGeomPt B b := Over.w j.unop.hom
  have h : a' ≫ V₁.hom = wcEtGeomPt B b := by
    rw [← hw, ← Category.assoc, ha']
    exact hA
  let A' : StructuredArrow X₀ (Scheme.Etale.forget B) :=
    StructuredArrow.mk (Y := V₁) (Over.homMk (U := X₀) (V := (Scheme.Etale.forget B).obj V₁) a' h)
  let α : A' ⟶ j.unop := StructuredArrow.homMk c (Over.OverMorphism.ext ha')
  refine ⟨(Limits.colimit.ι DF (Opposite.op A')).hom f, ?_⟩
  have e1 := Limits.colimit.ι_map_apply
    (Functor.whiskerLeft (StructuredArrow.proj X₀ (Scheme.Etale.forget B)).op
      φ.hom) (Opposite.op A') f
  have e2 := Limits.colimit.w_apply D α.op t
  calc ((wcEtStalk B b).map φ).hom ((Limits.colimit.ι DF (Opposite.op A')).hom f)
      = (Limits.colimit.ι D (Opposite.op A')).hom
          ((φ.hom.app (Opposite.op V₁)).hom f) := e1
    _ = (Limits.colimit.ι D (Opposite.op A')).hom
          ((G.obj.map c.op).hom t) :=
        congrArg (fun w => (Limits.colimit.ι D (Opposite.op A')).hom w) hf
    _ = (Limits.colimit.ι D (Opposite.op A')).hom ((D.map α.op).hom t) := rfl
    _ = (Limits.colimit.ι D j).hom t := e2
    _ = z := ht

theorem wc_pcrb_supp_obj_stalk_vanish : ∀ {X Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i] (n : ℕ) (D : wcEtPullData i n) (b : X), b ∉ Set.range i → Subsingleton ((wcEtStalk X b).obj ((SheafOfModules.toSheaf (wcEtZModRing X n)).obj (wcEtSuppObj D))) :=
by
  intro X Z i _ n D b hb
  classical

  have hvan : ∀ (W : X.Etale), (∀ w : W.left, W.hom w ∉ Set.range i) →
      Subsingleton ↑((wcEtSuppObj D).val.obj (Opposite.op W)) := by
    intro W hW
    have hEmpty : IsEmpty ↥(Limits.pullback W.hom i) :=
      Scheme.isEmpty_pullback W.hom i (Set.disjoint_left.2 (by rintro _ ⟨w, rfl⟩; exact hW w))
    have hE : IsEmpty ((wcEtBaseChange i).obj W).left := hEmpty
    have hBot : (⊥ : Sieve ((wcEtBaseChange i).obj W)) ∈
        Scheme.smallEtaleTopology Z ((wcEtBaseChange i).obj W) :=
      (congrArg (fun J : GrothendieckTopology Z.Etale =>
          (⊥ : Sieve ((wcEtBaseChange i).obj W)) ∈ J ((wcEtBaseChange i).obj W))
        (@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale
          Z MorphismProperty.IsMultiplicative.toIsStableUnderComposition
          _ _ _ _ le_rfl)).mpr
        ((@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Z
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _
          ((wcEtBaseChange i).obj W) (⊥ : Sieve ((wcEtBaseChange i).obj W))).2
            (fun x => isEmptyElim x))
    have hSub : Subsingleton ↑(((SheafOfModules.toSheaf (wcEtZModRing Z n)).obj
        (SheafOfModules.unit (wcEtZModRing Z n))).obj.obj
          (Opposite.op ((wcEtBaseChange i).obj W))) :=
      AddCommGrpCat.subsingleton_of_isZero
        (Sheaf.isTerminalOfBotCover ((SheafOfModules.toSheaf (wcEtZModRing Z n)).obj
          (SheafOfModules.unit (wcEtZModRing Z n))) _ hBot).isZero
    exact hSub

  let O : X.Opens := ⟨(Set.range i)ᶜ, i.isClosedEmbedding.isClosed_range.isOpen_compl⟩
  have hbO : b ∈ O := hb
  have hg : ∀ s, wcEtGeomPt X b s = b := by
    intro s
    rw [Scheme.Hom.comp_apply]
    exact Scheme.fromSpecResidueField_apply _ _
  let X₀ : Over X := Over.mk (wcEtGeomPt X b)
  let Fd := (StructuredArrow.proj X₀ (Scheme.Etale.forget X)).op ⋙
    ((SheafOfModules.toSheaf (wcEtZModRing X n)).obj (wcEtSuppObj D)).obj

  have hrange : ∀ (Y : Scheme.{u}) (f : Y ⟶ X) (t : X₀.left ⟶ Y), t ≫ f = wcEtGeomPt X b →
      Set.range t ⊆ Set.range (f ⁻¹ᵁ O).ι := by
    intro Y f t ht
    rintro _ ⟨s, rfl⟩
    rw [Scheme.Opens.range_ι]
    show t s ∈ f ⁻¹ᵁ O
    rw [Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply, ht, hg]
    exact hbO
  have hlift : ∀ (Y : Scheme.{u}) (U : Y.Opens) (t : X₀.left ⟶ Y), Set.range t ⊆ Set.range U.ι →
      ∃ t' : X₀.left ⟶ (U : Scheme.{u}), t' ≫ U.ι = t :=
    fun Y U t h => ⟨IsOpenImmersion.lift U.ι t h, IsOpenImmersion.lift_fac _ _ h⟩
  have hcomp : ∀ (Y : Scheme.{u}) (f : Y ⟶ X) (U : Y.Opens) (t : X₀.left ⟶ Y)
      (t' : X₀.left ⟶ (U : Scheme.{u})), t' ≫ U.ι = t → t ≫ f = wcEtGeomPt X b →
      t' ≫ U.ι ≫ f = wcEtGeomPt X b := by
    intro Y f U t t' h1 h2
    rw [← Category.assoc, h1, h2]
  have hout : ∀ (Y : Scheme.{u}) (f : Y ⟶ X) (w : ((f ⁻¹ᵁ O : Y.Opens) : Scheme.{u})),
      ((f ⁻¹ᵁ O).ι ≫ f) w ∉ Set.range i := by
    intro Y f w
    rw [Scheme.Hom.comp_apply]
    have h1 : (f ⁻¹ᵁ O).ι w = w.1 := Scheme.Opens.ι_apply _ _
    rw [h1]
    exact (Scheme.Hom.mem_preimage _).mp w.2

  have key : ∀ (V : X.Etale) (t : X₀.left ⟶ V.left), t ≫ V.hom = wcEtGeomPt X b →
      ∃ (W : X.Etale) (c : W ⟶ V) (t' : X₀.left ⟶ W.left), t' ≫ c.left = t ∧
        t' ≫ W.hom = wcEtGeomPt X b ∧
        Subsingleton ↑((wcEtSuppObj D).val.obj (Opposite.op W)) := by
    intro V t ht
    obtain ⟨t', ht'⟩ := hlift V.left (V.hom ⁻¹ᵁ O) t (hrange V.left V.hom t ht)
    exact ⟨Scheme.Etale.mk ((V.hom ⁻¹ᵁ O).ι ≫ V.hom),
      MorphismProperty.Over.homMk (V.hom ⁻¹ᵁ O).ι rfl trivial, t', ht',
      hcomp V.left V.hom (V.hom ⁻¹ᵁ O) t t' ht' ht,
      hvan _ (fun w => hout V.left V.hom w)⟩

  have hι : ∀ j (x : Fd.obj j), (Limits.colimit.ι Fd j).hom x = 0 := by
    intro j x
    obtain ⟨W, c, t', hct, hW, hsub⟩ := key j.unop.right j.unop.hom.left (Over.w j.unop.hom)
    let A' : StructuredArrow X₀ (Scheme.Etale.forget X) :=
      StructuredArrow.mk (Y := W) (Over.homMk (U := X₀) (V := (Scheme.Etale.forget X).obj W) t' hW)
    let α : A' ⟶ j.unop := StructuredArrow.homMk c (Over.OverMorphism.ext hct)
    haveI hsub' : Subsingleton (Fd.obj (Opposite.op A')) := hsub
    have e := Limits.colimit.w_apply Fd α.op x
    refine e.symm.trans ?_
    rw [Subsingleton.elim ((Fd.map α.op).hom x) 0, map_zero]

  have hid : 𝟙 (Limits.colimit Fd) = 0 := by
    apply Limits.colimit.hom_ext
    intro j
    have h0 : Limits.colimit.ι Fd j = 0 := by
      ext x
      simpa using hι j x
    rw [h0, Limits.zero_comp, Limits.zero_comp]
  have hz : Limits.IsZero (Limits.colimit Fd) := (Limits.IsZero.iff_id_eq_zero _).mpr hid
  exact AddCommGrpCat.subsingleton_of_isZero hz

theorem wc_pcrb_module_ext_vanish : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (C : Scheme.{u}) (fC : C ⟶ Spec (.of Ω)) [IsProper fC] (M : ℕ), M ≠ 0 → (M : Ω) ≠ 0 → topologicalKrullDim C ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (N : SheafOfModules.{u+1} (wcEtZModRing C M)), (∀ q : ℕ, 2 < q → ∀ x : @Abelian.Ext (SheafOfModules.{u+1} (wcEtZModRing C M)) _ _ (HasExt.standard _) (SheafOfModules.unit (wcEtZModRing C M)) N q, x = 0) ∧ (∀ T : Set C, IsClosed T → topologicalKrullDim ↥T < ((1 : ℕ) : WithBot ℕ∞) → (∀ b : C, b ∉ T → Subsingleton ((wcEtStalk C b).obj ((SheafOfModules.toSheaf (wcEtZModRing C M)).obj N))) → ∀ q : ℕ, 0 < q → ∀ x : @Abelian.Ext (SheafOfModules.{u+1} (wcEtZModRing C M)) _ _ (HasExt.standard _) (SheafOfModules.unit (wcEtZModRing C M)) N q, x = 0) :=
by
  intro Ω _ _ C fC _ M hM hMΩ hdim N
  classical
  obtain ⟨α, -, -, hR⟩ := wc_et_zmod_ring_locbij C M
  have hT : M • 𝟙 N = 0 := by
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro V
    ext s
    have h0 : ((0 : N ⟶ N).val.app V).hom s = 0 := by first | rfl | simp
    have hz : ∀ k : ℕ, ((k • 𝟙 N).val.app V).hom s = k • s := by
      intro k
      induction k with
      | zero => rw [zero_nsmul, zero_nsmul]; exact h0
      | succ k ih =>
        rw [succ_nsmul, SheafOfModules.add_val, PresheafOfModules.add_app, ModuleCat.hom_add,
          LinearMap.add_apply, ih, succ_nsmul]; rfl
    rw [hz, ← Nat.cast_smul_eq_nsmul (R := ↑((wcEtZModRing C M).obj.obj V)), hR V, zero_smul, h0]
  have hTs : M • 𝟙 ((SheafOfModules.toSheaf (wcEtZModRing C M)).obj N) = 0 := by
    rw [← CategoryTheory.Functor.map_id, ← CategoryTheory.Functor.map_nsmul, hT,
      CategoryTheory.Functor.map_zero]
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology C) AddCommGrpCat.{u+1}) := HasExt.standard _
  have transfer : ∀ q : ℕ,
      (∀ y : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology C) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) ((SheafOfModules.toSheaf (wcEtZModRing C M)).obj N) q,
        y = 0) →
      ∀ x : @Abelian.Ext (SheafOfModules.{u+1} (wcEtZModRing C M)) _ _ (HasExt.standard _)
        (SheafOfModules.unit (wcEtZModRing C M)) N q, x = 0 := by
    intro q hv x
    obtain ⟨e⟩ := wc_et_zmod_modext_toSheaf_equiv C M (Nat.pos_of_ne_zero hM) N q
    exact e.injective ((hv (e x)).trans (hv (e 0)).symm)
  refine ⟨?_, ?_⟩
  · intro q hq x
    exact transfer q (wc_et_cd_proper_torsion Ω C fC 1 hdim M hMΩ
      ((SheafOfModules.toSheaf (wcEtZModRing C M)).obj N) hTs q (by omega)) x
  · intro T hTc hTd hst q hq x
    exact transfer q (wc_et_low_support_coh_vanish Ω C fC T hTc 1 hTd M hMΩ
      ((SheafOfModules.toSheaf (wcEtZModRing C M)).obj N) hTs hst q (by omega)) x

theorem wc_et_curve_h2_card_reduction_gen : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (M : ℕ), M ≠ 0 → (M : Ω) ≠ 0 → (∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Y₀ : Scheme.{u}) (f : Y₀ ⟶ Spec (.of A)) [IsProper f] (m' : ℕ), m' ≠ 0 → ∀ S : Set (Spec (.of A)), IsOpen S → S ≠ Set.univ → ∀ q' : ℕ, Subsingleton (wcEtExt Y₀ (wcEtExtZero Y₀ (f ⁻¹' S) m') q')) → (∀ (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX], IrreducibleSpace X → (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) → topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) → Nat.card (wcEtCoh X M 2) = M) → ∀ (C : Scheme.{u}) (fC : C ⟶ Spec (.of Ω)) [IsProper fC], topologicalKrullDim C ≤ ((1 : ℕ) : WithBot ℕ∞) → Nat.card (wcEtCoh C M 2) = M ^ Set.ncard {x : C | ¬ IsClosed ({x} : Set C)} :=
by
  intro Ω _ _ M hM0 hMΩ hPBC hnorm C fC _ hC
  classical

  have hne : ∀ (Y : Scheme.{u}) (q : ℕ), Nonempty (wcEtCoh Y M q) := by
    intro Y q
    unfold wcEtCoh
    exact ⟨0⟩
  have hcard1 : ∀ (Y : Scheme.{u}) (q : ℕ), Subsingleton (wcEtCoh Y M q) →
      Nat.card (wcEtCoh Y M q) = 1 := by
    intro Y q hs
    haveI := hs
    obtain ⟨a⟩ := hne Y q
    exact Nat.card_of_subsingleton a

  have s3 : ∀ x : WithBot ℕ∞, x ≤ ((1 : ℕ) : WithBot ℕ∞) → ¬ x ≤ ((0 : ℕ) : WithBot ℕ∞) →
      x = ((1 : ℕ) : WithBot ℕ∞) := by
    intro x h1 h0
    induction x using WithBot.recBotCoe with
    | bot => exact absurd bot_le h0
    | coe y =>
      induction y using ENat.recTopCoe with
      | top =>
        exfalso
        have : ((⊤ : ℕ∞) : WithBot ℕ∞) ≤ ((1 : ℕ∞) : WithBot ℕ∞) := by exact_mod_cast h1
        have h2 : (⊤ : ℕ∞) ≤ 1 := WithBot.coe_le_coe.mp this
        simp at h2
      | coe n =>
        have h1' : n ≤ 1 := by exact_mod_cast h1
        have h0' : ¬ n ≤ 0 := fun h => h0 (by exact_mod_cast h)
        have hn : n = 1 := by omega
        subst hn
        rfl

  have hc0 : ∀ (Y : Scheme.{u}), topologicalKrullDim Y ≤ ((0 : ℕ) : WithBot ℕ∞) →
      Set.ncard {x : Y | ¬ IsClosed ({x} : Set Y)} = 0 := by
    intro Y hY
    have h : {x : Y | ¬ IsClosed ({x} : Set Y)} = ∅ := by
      ext x
      simp only [Set.mem_setOf_eq, Set.mem_empty_iff_false, iff_false, not_not]
      exact wc_top_dim_nonpos_isClosed_singleton _ hY x
    rw [h, Set.ncard_empty]

  have hdimEmpty : ∀ (Y : Scheme.{u}), IsEmpty Y →
      topologicalKrullDim Y ≤ ((0 : ℕ) : WithBot ℕ∞) := by
    intro Y hY
    have h : topologicalKrullDim Y = ⊥ := by
      unfold topologicalKrullDim
      rw [Order.krullDim_eq_bot_iff]
      exact ⟨fun s => by
        obtain ⟨x, _⟩ := s.2.nonempty
        exact hY.false x⟩
    rw [h]
    exact bot_le

  have G1 : ∀ (n : ℕ) (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX],
      (irreducibleComponents X).ncard = n →
      (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
      topologicalKrullDim X ≤ ((1 : ℕ) : WithBot ℕ∞) →
      Nat.card (wcEtCoh X M 2) = M ^ Set.ncard {x : X | ¬ IsClosed ({x} : Set X)} := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n IH =>
      intro X fX _ hn hnormX hX
      by_cases hE : IsEmpty X
      · have h0 := hdimEmpty X hE
        rw [hcard1 X 2 (wc_et_zero_dim_vanishing Ω X fX h0 M hM0 2 (by norm_num)), hc0 X h0,
          pow_zero]
      · haveI : Nonempty X := not_isEmpty_iff.mp hE
        obtain ⟨Z, iZ, X', b, hiZ, hb, hiso, hdisj, hirr, hnZ, hnX', hdZ, hdX', hcard⟩ :=
          wc_normal_split_component Ω X fX hnormX inferInstance
        haveI := hiZ
        haveI := hb
        have hcov := wc_iso_over_compl_range_cover X X' Z b iZ hiso

        have hoU : IsOpen (Set.range iZ)ᶜ := iZ.isClosedEmbedding.isClosed_range.isOpen_compl
        have hoU' : IsOpen (Set.range b)ᶜ := b.isClosedEmbedding.isClosed_range.isOpen_compl
        have hdUU : Disjoint (Set.range iZ)ᶜ (Set.range b)ᶜ := by
          rw [Set.disjoint_left]
          intro x h1 h2
          rcases hcov x with h | h
          · exact h2 h
          · exact h1 h
        have hunion : (Set.range iZ)ᶜ ∪ (Set.range b)ᶜ = Set.univ := by
          apply Set.eq_univ_of_forall
          intro x
          by_cases h : x ∈ Set.range iZ
          · right
            intro hb'
            exact Set.disjoint_left.mp hdisj hb' h
          · left
            exact h

        have hiso2 := wc_et_extZero_clopen_biprod_iso X _ _ hoU hoU' hdUU hunion M
        have hsplit : Nat.card (wcEtCoh X M 2) =
            Nat.card (wcEtCoh X' M 2) * Nat.card (wcEtCoh Z M 2) := by
          have e1 : Nonempty (wcEtCoh X M 2 ≃
              wcEtExt X (Limits.cokernel (wcEtExtZeroι X (Set.range b)ᶜ M)) 2 ×
                wcEtExt X (Limits.cokernel (wcEtExtZeroι X (Set.range iZ)ᶜ M)) 2) := by
            unfold wcEtCoh wcEtExt Sheaf.H
            letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) :=
              HasExt.standard _
            exact wc_ext_biprod_desc_iso_prod _ _ _ _ _ _ hiso2 2
          obtain ⟨e1⟩ := e1
          obtain ⟨eb⟩ := wc_et_closed_complement_coh X X' b M 2
          obtain ⟨ez⟩ := wc_et_closed_complement_coh X Z iZ M 2
          rw [Nat.card_congr (e1.trans (eb.prodCongr ez)), Nat.card_prod]

        have hX' := IH _ (by omega) X' (b ≫ fX) rfl hnX' (hdX'.trans hX)

        have hZ : Nat.card (wcEtCoh Z M 2) = M ^ Set.ncard {x : Z | ¬ IsClosed ({x} : Set Z)} := by
          by_cases h0 : topologicalKrullDim Z ≤ ((0 : ℕ) : WithBot ℕ∞)
          · rw [hcard1 Z 2 (wc_et_zero_dim_vanishing Ω Z (iZ ≫ fX) h0 M hM0 2 (by norm_num)),
              hc0 Z h0, pow_zero]
          · have h1 : topologicalKrullDim Z = ((1 : ℕ) : WithBot ℕ∞) := s3 _ (hdZ.trans hX) h0
            haveI := hirr
            rw [hnorm Z (iZ ≫ fX) hirr hnZ h1, wc_top_irreducible_dim_one_ncard _ h1, pow_one]

        have hcount := wc_clopen_split_ncard_add X X' Z b iZ hcov hdisj
          (wc_proper_curve_nonclosed_finite Ω X' (b ≫ fX) (hdX'.trans hX))
          (wc_proper_curve_nonclosed_finite Ω Z (iZ ≫ fX) (hdZ.trans hX))
        rw [hsplit, hX', hZ, hcount, pow_add]

  have G2 : ∀ (R : Scheme.{u}) (fR : R ⟶ Spec (.of Ω)) [IsProper fR] [IsReduced R],
      topologicalKrullDim R ≤ ((1 : ℕ) : WithBot ℕ∞) →
      Nat.card (wcEtCoh R M 2) = M ^ Set.ncard {x : R | ¬ IsClosed ({x} : Set R)} := by
    intro R fR _ _ hR
    obtain ⟨X', b, Z, iZ, hb, hiZ, hiso, hn, hdX', hdZ, hdE⟩ :=
      wc_reduced_curve_normalization Ω R fR hR
    haveI := hb
    haveI := hiZ
    have hZv : ∀ q, 0 < q → Subsingleton (wcEtCoh Z M q) := fun q hq =>
      wc_et_zero_dim_vanishing Ω Z (iZ ≫ fR) hdZ M hM0 q hq
    have hEv : ∀ q, 0 < q → Subsingleton (wcEtCoh (Limits.pullback b iZ) M q) := fun q hq =>
      wc_et_zero_dim_vanishing Ω (Limits.pullback b iZ) (Limits.pullback.snd b iZ ≫ iZ ≫ fR)
        hdE M hM0 q hq
    obtain ⟨e⟩ := wc_et_abstract_blowup_coh_equiv R X' Z b iZ hiso M hM0 hPBC 2
      (fun q' hq' => hZv q' (by omega)) (hZv 2 (by norm_num))
      (fun q' hq' => hEv q' (by omega)) (hEv 2 (by norm_num))
    rw [Nat.card_congr e, G1 _ X' (b ≫ fR) rfl hn hdX',
      wc_blowup_ncard_nonclosed_eq R X' Z b iZ hiso (wc_iso_over_compl_range_cover R X' Z b iZ hiso)
        (wc_top_dim_nonpos_isClosed_singleton _ hdZ) (wc_top_dim_nonpos_isClosed_singleton _ hdE)]

  obtain ⟨R, r, hr, hsurj, hred⟩ := wc_reduced_subscheme_exists C
  haveI := hr
  haveI := hred
  have hdimR : topologicalKrullDim R = topologicalKrullDim C :=
    IsHomeomorph.topologicalKrullDim_eq r (isHomeomorph_iff_isEmbedding_surjective.mpr
      ⟨r.isClosedEmbedding.isEmbedding, Set.range_eq_univ.mp hsurj⟩)
  have hFR := G2 R (r ≫ fC) (by rw [hdimR]; exact hC)

  have hcoh : Nat.card (wcEtCoh C M 2) = Nat.card (wcEtCoh R M 2) := by
    obtain ⟨e1⟩ := wc_et_coh_iso_invariance (Limits.pullback.fst (𝟙 C) (𝟙 C)) M 2
    obtain ⟨e2⟩ := wc_et_coh_iso_invariance (Limits.pullback.fst (r ≫ 𝟙 C) (𝟙 C)) M 2
    rw [Nat.card_congr e1, Nat.card_congr e2]
    exact (wc_et_fibre_coh_reduced_invariance C C C R (𝟙 C) r hsurj (𝟙 C) M 2).symm

  have hcnt : Set.ncard {x : C | ¬ IsClosed ({x} : Set C)} =
      Set.ncard {x : R | ¬ IsClosed ({x} : Set R)} := by
    have hce := r.isClosedEmbedding
    have key : ∀ x : R, IsClosed ({x} : Set R) ↔ IsClosed ({r x} : Set C) := by
      intro x
      rw [hce.isClosed_iff_image_isClosed, Set.image_singleton]
    symm
    refine Set.ncard_congr (fun x _ => r x) ?_ ?_ ?_
    · intro x hx
      simp only [Set.mem_setOf_eq] at hx ⊢
      rwa [← key]
    · intro a a' _ _ haa
      exact hce.isEmbedding.injective haa
    · intro y hy
      obtain ⟨x, rfl⟩ : y ∈ Set.range r := by rw [hsurj]; trivial
      refine ⟨x, ?_, rfl⟩
      simp only [Set.mem_setOf_eq] at hy ⊢
      rwa [key]
  rw [hcoh, hFR, hcnt]

theorem wc_et_normal_curve_h2_card_gen : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (M : ℕ), (M : Ω) ≠ 0 → (∀ (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of Ω)), ∃ (ι : (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod M))) ⟶ wcEtGm Y) (h : ι ≫ (M • 𝟙 (wcEtGm Y)) = 0), (ShortComplex.mk ι (M • 𝟙 (wcEtGm Y)) h).ShortExact) → (∀ (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of Ω)) [IsProper fY] [IrreducibleSpace Y], (∀ x : Y, IsDomain (Y.presheaf.stalk x) ∧ IsIntegrallyClosed (Y.presheaf.stalk x)) → topologicalKrullDim Y = ((1 : ℕ) : WithBot ℕ∞) → ∀ (U : Y.Opens) [IsDedekindDomain Γ(Y, U)] (hU : IsAffineOpen U), ((U : Set Y)ᶜ).Finite → ∀ ord : Y → Additive (FractionRing Γ(Y, U))ˣ →+ ℤ, wcCurveOrdData Ω Y fY U hU ord → (∀ (m : Additive (FractionRing Γ(Y, U))ˣ) (E : Y →₀ ℤ), (∀ x, E x = ord x m) → E.sum (fun _ k => k) = 0) ∧ ∃ Q : Y, Q ≠ genericPoint Y ∧ ∀ x : Y, x ≠ genericPoint Y → ∃ (E : Y →₀ ℤ) (m : Additive (FractionRing Γ(Y, U))ˣ), E (genericPoint Y) = 0 ∧ ∀ y, Finsupp.single x 1 y - Finsupp.single Q 1 y = (M : ℤ) * E y + ord y m) → ∀ (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX], IrreducibleSpace X → (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) → topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) → Nat.card (wcEtCoh X M 2) = M :=
by
  intro Ω _ _ M hMΩ hKum hCong X fX _ hirr hnorm hdim
  classical
  haveI := hirr
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
  letI : HasExt (Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}) := HasExt.standard _
  haveI hNPic : (nsmulAddMonoidHom M : Abelian.Ext ((constantSheaf (Opens.grothendieckTopology X)
      AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ))) (wcZarGm X) 1 →+
      Abelian.Ext ((constantSheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ))) (wcZarGm X) 1).range.Normal :=
    ⟨fun n hn g => by rwa [add_comm g n, add_neg_cancel_right]⟩

  have hPic : Nat.card (Abelian.Ext ((constantSheaf (Opens.grothendieckTopology X)
      AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ))) (wcZarGm X) 1 ⧸
      (nsmulAddMonoidHom M : Abelian.Ext ((constantSheaf (Opens.grothendieckTopology X)
        AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ))) (wcZarGm X) 1 →+
        Abelian.Ext ((constantSheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ))) (wcZarGm X) 1).range) = M := by
    obtain ⟨U, hU, hfin, hDed⟩ := wc_curve_dedekind_affine_open Ω X fX hirr hnorm hdim
    haveI := hDed
    obtain ⟨ord, ι₀, hord, hι1, hι2, hι3⟩ := wc_curve_ord_units_full Ω X fX hnorm hdim U hU hfin
    obtain ⟨ρ, hρs, hρk⟩ := wc_zar_pic_divisor_presentation Ω X fX hdim
      (Additive (FractionRing Γ(X, U))ˣ) ord ι₀ hord.1 hord.2.2.1 hord.2.2.2.1 hι1 hι2 hι3
    obtain ⟨hdeg, Q, hQ, hcong⟩ := hCong X fX hnorm hdim U hU hfin ord hord
    set η := genericPoint X with hη
    set N := (nsmulAddMonoidHom M : Abelian.Ext ((constantSheaf (Opens.grothendieckTopology X)
        AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ))) (wcZarGm X) 1 →+
        Abelian.Ext ((constantSheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ))) (wcZarGm X) 1).range with hN
    letI instQ : AddCommGroup (_ ⧸ N) := QuotientAddGroup.Quotient.addCommGroup N
    let deg : (X →₀ ℤ) →+ ℤ := Finsupp.liftAddHom (fun _ : X => AddMonoidHom.id ℤ)
    have hdeg' : ∀ (m : Additive (FractionRing Γ(X, U))ˣ) (E : X →₀ ℤ),
        (∀ x, E x = ord x m) → deg E = 0 := by
      intro m E h
      have e : deg E = E.sum (fun _ k => k) := by simp [deg, Finsupp.liftAddHom_apply]; rfl
      rw [e]
      exact hdeg m E h
    have hdegs : ∀ (a : X) (b : ℤ), deg (Finsupp.single a b) = b := by
      intro a b
      simp [deg]
    have hR : ∀ n : X →₀ ℤ, ∃ (E : X →₀ ℤ) (m : Additive (FractionRing Γ(X, U))ˣ), E η = 0 ∧
        ∀ y, (n.erase η) y - deg (n.erase η) * Finsupp.single Q 1 y = (M : ℤ) * E y + ord y m := by
      intro n
      induction n using Finsupp.induction_linear with
      | zero => exact ⟨0, 0, rfl, fun y => by simp⟩
      | add f g hf hg =>
        obtain ⟨E1, m1, h1η, h1⟩ := hf
        obtain ⟨E2, m2, h2η, h2⟩ := hg
        refine ⟨E1 + E2, m1 + m2, by simp [h1η, h2η], fun y => ?_⟩
        simp only [Finsupp.erase_add, Finsupp.add_apply, map_add, add_mul]
        linarith [h1 y, h2 y]
      | single a b =>
        by_cases ha : a = η
        · refine ⟨0, 0, rfl, fun y => ?_⟩
          rw [ha, Finsupp.erase_single]
          simp
        · obtain ⟨E, m, hEη, hE⟩ := hcong a ha
          refine ⟨b • E, b • m, by simp [hEη], fun y => ?_⟩
          rw [Finsupp.erase_single_ne (Ne.symm ha), hdegs, Finsupp.smul_apply, map_zsmul,
            smul_eq_mul, smul_eq_mul]
          have hs : Finsupp.single a b y = b * Finsupp.single a 1 y := by
            simp only [Finsupp.single_apply]
            split_ifs <;> simp
          rw [hs]
          linear_combination b * hE y
    have herase : ∀ n : X →₀ ℤ, n η = 0 → n.erase η = n := by
      intro n hn
      ext y
      by_cases hy : y = η
      · rw [hy, Finsupp.erase_same, hn]
      · rw [Finsupp.erase_ne hy]
    set q : _ ⧸ N := QuotientAddGroup.mk (ρ (Finsupp.single Q 1)) with hq
    have hqM : ((M : ℤ) • q) = 0 := by
      rw [hq, ← QuotientAddGroup.mk_zsmul, QuotientAddGroup.eq_zero_iff, natCast_zsmul]
      exact AddMonoidHom.mem_range.mpr ⟨_, nsmulAddMonoidHom_apply _ _⟩
    let f : ZMod M →+ _ ⧸ N := ZMod.lift M ⟨zmultiplesHom (_ ⧸ N) q, by
      rw [zmultiplesHom_apply]; exact hqM⟩
    have hf : ∀ t : ℤ, f (t : ZMod M) = t • q := by
      intro t
      simp only [f, ZMod.lift_coe, zmultiplesHom_apply]
    have hsurj : Function.Surjective f := by
      intro z
      obtain ⟨y, rfl⟩ := QuotientAddGroup.mk_surjective z
      obtain ⟨n, hn, rfl⟩ := hρs y
      obtain ⟨E, m, hEη, hE⟩ := hR n
      rw [herase n hn] at hE
      refine ⟨((deg n : ℤ) : ZMod M), ?_⟩
      rw [hf]
      have h0 : ρ (n - M • E - deg n • Finsupp.single Q 1) = 0 := by
        refine (hρk _ ?_).mpr ⟨m, fun x => ?_⟩
        · simp [hn, hEη, Finsupp.single_apply, hQ]
        · have := hE x
          simp only [Finsupp.sub_apply, Finsupp.smul_apply, nsmul_eq_mul, smul_eq_mul]
          linarith
      rw [map_sub, map_sub, map_nsmul, map_zsmul, sub_sub, sub_eq_zero] at h0
      rw [h0, QuotientAddGroup.mk_add, hq, ← QuotientAddGroup.mk_zsmul]
      have : (QuotientAddGroup.mk (M • ρ E) : _ ⧸ N) = 0 := by
        rw [QuotientAddGroup.eq_zero_iff]
        exact AddMonoidHom.mem_range.mpr ⟨_, nsmulAddMonoidHom_apply _ _⟩
      rw [this, zero_add]
    have hinj : Function.Injective f := by
      rw [injective_iff_map_eq_zero]
      intro k hk
      obtain ⟨t, rfl⟩ := ZMod.intCast_surjective k
      rw [hf, hq, ← QuotientAddGroup.mk_zsmul, QuotientAddGroup.eq_zero_iff] at hk
      obtain ⟨z, hz⟩ := AddMonoidHom.mem_range.mp hk
      rw [nsmulAddMonoidHom_apply] at hz
      obtain ⟨nz, hnz, rfl⟩ := hρs z
      have h0 : ρ (t • Finsupp.single Q 1 - M • nz) = 0 := by
        rw [map_sub, map_zsmul, map_nsmul, hz, sub_self]
      obtain ⟨m, hm⟩ := (hρk _ (by simp [hnz, Finsupp.single_apply, hQ])).mp h0
      have hd := hdeg' m _ hm
      rw [map_sub, map_zsmul, map_nsmul, hdegs, smul_eq_mul, mul_one, nsmul_eq_mul,
        sub_eq_zero] at hd
      exact (ZMod.intCast_zmod_eq_zero_iff_dvd t M).mpr ⟨deg nz, hd⟩
    rw [← Nat.card_zmod M]
    exact (Nat.card_congr (AddEquiv.ofBijective f ⟨hinj, hsurj⟩).toEquiv).symm

  let P := (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} ℤ))
  let G := wcEtGm X
  have hA : ∀ (n k : ℕ) (x : Abelian.Ext P G n),
      x.comp (Abelian.Ext.mk₀ (k • 𝟙 G)) (add_zero n) = k • x := by
    intro n k x
    induction k with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    | succ k ih =>
      rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih,
        Abelian.Ext.comp_mk₀_id]
  obtain ⟨ι, h, hS⟩ := hKum X fX
  obtain ⟨e1⟩ := wc_et_gm_h1_zariski X
  have hV := wc_et_gm_tsen_vanishing Ω X fX hirr hnorm hdim
  let S := ShortComplex.mk ι (M • 𝟙 (wcEtGm X)) h
  change Nat.card (Abelian.Ext P S.X₁ 2) = M
  let δ : Abelian.Ext P G 1 →+ Abelian.Ext P S.X₁ 2 := hS.extClass.postcomp P rfl
  have hδs : Function.Surjective δ := by
    intro x
    have h0 : x.comp (Abelian.Ext.mk₀ S.f) (add_zero 2) = 0 := @Subsingleton.elim _ (hV 0) _ _
    obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₁ P hS x h0 rfl
    exact ⟨y, hy⟩
  have hker : δ.ker = (nsmulAddMonoidHom M : Abelian.Ext P G 1 →+ Abelian.Ext P G 1).range := by
    ext y
    rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_range]
    constructor
    · intro hy
      obtain ⟨z, hz⟩ := Abelian.Ext.covariant_sequence_exact₃ P hS y rfl hy
      refine ⟨z, ?_⟩
      rw [nsmulAddMonoidHom_apply, ← hA 1 M z]
      exact hz
    · rintro ⟨z, rfl⟩
      rw [nsmulAddMonoidHom_apply, ← hA 1 M z]
      change (z.comp (Abelian.Ext.mk₀ S.g) (add_zero 1)).comp hS.extClass rfl = 0
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (zero_add 1) (by omega),
        hS.comp_extClass, Abelian.Ext.comp_zero]
  have hδ's : Function.Surjective (δ.comp e1.symm.toAddMonoidHom) := by
    intro x
    obtain ⟨y, hy⟩ := hδs x
    refine ⟨e1 y, ?_⟩
    show δ (e1.symm (e1 y)) = x
    rw [AddEquiv.symm_apply_apply]
    exact hy
  have hker' : (δ.comp e1.symm.toAddMonoidHom).ker =
      (nsmulAddMonoidHom M : Abelian.Ext ((constantSheaf (Opens.grothendieckTopology X)
        AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ))) (wcZarGm X) 1 →+
        Abelian.Ext ((constantSheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ))) (wcZarGm X) 1).range := by
    ext w
    have hw : w ∈ (δ.comp e1.symm.toAddMonoidHom).ker ↔ e1.symm w ∈ δ.ker := by
      rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_ker]
      rfl
    rw [hw, hker, AddMonoidHom.mem_range, AddMonoidHom.mem_range]
    constructor
    · rintro ⟨z, hz⟩
      refine ⟨e1 z, ?_⟩
      rw [nsmulAddMonoidHom_apply] at hz ⊢
      rw [← map_nsmul e1, hz, AddEquiv.apply_symm_apply]
    · rintro ⟨z, hz⟩
      refine ⟨e1.symm z, ?_⟩
      rw [nsmulAddMonoidHom_apply] at hz ⊢
      rw [← map_nsmul e1.symm, hz]
  let eK := QuotientAddGroup.quotientKerEquivOfSurjective _ hδ's
  let eQ := QuotientAddGroup.quotientAddEquivOfEq hker'
  exact (Nat.card_congr (eK.symm.trans eQ).toEquiv).trans hPic

theorem wc_et_kummer_ses_gen : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) (M : ℕ), (M : Ω) ≠ 0 → ∃ (ι : (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod M))) ⟶ wcEtGm X) (h : ι ≫ (M • 𝟙 (wcEtGm X)) = 0), (ShortComplex.mk ι (M • 𝟙 (wcEtGm X)) h).ShortExact :=
by
  intro Ω _ _ X fX M hMΩ
  classical
  have hM0 : M ≠ 0 := fun h => hMΩ (by rw [h, Nat.cast_zero])

  have hkappa : ∃ κ : (Functor.const (Scheme.Etale X)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod M))) ⟶ wcEtGmPre X, κ ≫ (M • 𝟙 (wcEtGmPre X)) = 0 ∧ Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology X) κ ∧ ∀ (U : Scheme.Etale X) (s : ToType ((wcEtGmPre X).obj (Opposite.op U))), (M • 𝟙 (wcEtGmPre X)).app (Opposite.op U) s = 0 → Presheaf.imageSieve κ s ∈ Scheme.smallEtaleTopology X U := by
    haveI : NeZero M := ⟨hM0⟩
    haveI : NeZero (M : Ω) := ⟨hMΩ⟩
    haveI := IsSepClosed.hasEnoughRootsOfUnity Ω M
    obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot Ω M

    have s2 : ∀ (O : Type u) [CommRing O] [IsLocalRing O] (φ : Ω →+* O) (v : O),
        v ^ M = 1 → ∃ k : ℕ, v = φ ζ ^ k := by
      intro O _ _ φ v hv
      let π := IsLocalRing.residue O
      have hinj : Function.Injective (π.comp φ) := (π.comp φ).injective
      have hprim : IsPrimitiveRoot ((π.comp φ) ζ) M := hζ.map_of_injective hinj
      have hπv : π v ^ M = 1 := by rw [← map_pow, hv, map_one]
      obtain ⟨i, -, hiv⟩ := hprim.eq_pow_of_pow_eq_one hπv
      refine ⟨i, ?_⟩
      have hw : (φ ζ ^ i) ^ M = 1 := by
        rw [← pow_mul, mul_comm, pow_mul, ← map_pow, hζ.pow_eq_one, map_one, one_pow]
      have hπw : π (φ ζ ^ i) = π v := by rw [map_pow]; exact hiv
      have hS : (∑ j ∈ Finset.range M, v ^ j * (φ ζ ^ i) ^ (M - 1 - j)) * (v - φ ζ ^ i) = 0 := by
        rw [geom_sum₂_mul, hv, hw, sub_self]
      have hSu : IsUnit (∑ j ∈ Finset.range M, v ^ j * (φ ζ ^ i) ^ (M - 1 - j)) := by
        rw [← IsLocalRing.residue_ne_zero_iff_isUnit]
        have e : π (∑ j ∈ Finset.range M, v ^ j * (φ ζ ^ i) ^ (M - 1 - j)) =
            (M : IsLocalRing.ResidueField O) * π v ^ (M - 1) := by
          rw [map_sum, ← geom_sum₂_self]
          refine Finset.sum_congr rfl (fun j _ => ?_)
          rw [map_mul, map_pow, map_pow, hπw]
        rw [e]
        refine mul_ne_zero ?_ (pow_ne_zero _ ?_)
        · have h1 : (M : IsLocalRing.ResidueField O) = (π.comp φ) (M : Ω) := by rw [map_natCast]
          rw [h1]
          exact (map_ne_zero_iff _ hinj).mpr hMΩ
        · intro h0
          rw [h0, zero_pow hM0] at hπv
          exact zero_ne_one hπv
      exact sub_eq_zero.mp (hSu.mul_right_eq_zero.mp hS)

    have s3 : ∀ (Y : Scheme.{u}) (y : Y) (a b : Γ(Y, ⊤)),
        (Y.presheaf.germ ⊤ y trivial).hom a = (Y.presheaf.germ ⊤ y trivial).hom b →
        ∃ W : Y.Opens, y ∈ W ∧ W.ι.appTop.hom a = W.ι.appTop.hom b := by
      intro Y y a b h
      obtain ⟨W, hyW, iU, iV, e⟩ :=
        TopCat.Presheaf.germ_eq (U := ⊤) (V := ⊤) Y.presheaf y trivial trivial a b h
      refine ⟨W, hyW, ?_⟩
      obtain rfl : iV = iU := Subsingleton.elim _ _
      have e' : (Y.presheaf.map iV.op).hom a = (Y.presheaf.map iV.op).hom b := e
      have gen : ∀ (V : Y.Opens) (j : V ⟶ ⊤), V ≤ W →
          (Y.presheaf.map j.op).hom a = (Y.presheaf.map j.op).hom b := by
        intro V j hVW
        obtain rfl : j = homOfLE hVW ≫ iV := Subsingleton.elim _ _
        rw [op_comp, Functor.map_comp, CommRingCat.comp_apply, CommRingCat.comp_apply, e']
      rw [Scheme.Opens.ι_appTop]
      exact gen _ _ (by simp)

    have hcov : ∀ (V : X.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : X.Etale) (c : V₁ ⟶ V),
        S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology X V := by
      intro V S hS
      change S ∈ Scheme.smallGrothendieckTopology @Etale X V
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      obtain ⟨V₁, c, hc, y, hy⟩ := hS x
      have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
      have hEt : Etale c.left := by
        have h1 : Etale V.hom := V.prop
        have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
        exact Etale.of_comp c.left V.hom
      exact ⟨V₁, c, y, hc, hEt, hy⟩
    have hG3 : ∀ (U : X.Etale) (a b : ToType ((wcEtGmPre X).obj (Opposite.op U))),
        ((Additive.toMul a.down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)) =
          ((Additive.toMul b.down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)) → a = b :=
      fun U a b h => ULift.ext _ _ (Additive.toMul.injective (Units.ext h))
    let cX : Ω →+* Γ(X, ⊤) := fX.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom
    let ψ : ∀ U : X.Etale, Ω →+* Γ(U.left, ⊤) := fun U => U.hom.appTop.hom.comp cX
    have hψnat : ∀ (U V : X.Etale) (f : V ⟶ U) (a : Ω), f.left.appTop.hom (ψ U a) = ψ V a := by
      intro U V f a
      have hw : f.left ≫ U.hom = V.hom := MorphismProperty.Over.w f
      simp only [ψ, RingHom.comp_apply]
      rw [← hw, Scheme.Hom.comp_appTop]
      rfl
    have hζmod : ∀ (m : ℕ), ζ ^ m = ζ ^ (m % M) := fun m => by
      conv_lhs => rw [← Nat.div_add_mod m M, pow_add, pow_mul, hζ.pow_eq_one, one_pow, one_mul]
    have hζu : IsUnit ζ := hζ.isUnit hM0
    let zU : ∀ U : X.Etale, (Γ(U.left, ⊤))ˣ := fun U => Units.map (ψ U).toMonoidHom hζu.unit
    have hzU : ∀ U : X.Etale, ((zU U : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)) = ψ U ζ := fun U => by
      simp [zU]
    have hzpow : ∀ (U : X.Etale) (m : ℕ), ((zU U ^ m : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)) = ψ U ζ ^ m :=
      fun U m => by rw [Units.val_pow_eq_pow_val, hzU]
    have hψmod : ∀ (U : X.Etale) (m : ℕ), ψ U ζ ^ m = ψ U ζ ^ (m % M) := fun U m => by
      rw [← map_pow, ← map_pow, ← hζmod]
    have hzmod : ∀ (U : X.Etale) (m : ℕ), zU U ^ m = zU U ^ (m % M) := fun U m => by
      ext
      rw [hzpow, hzpow, ← hψmod]
    let κf : ∀ U : X.Etale, ULift.{u+1} (ZMod M) →+ ULift.{u+1} (Additive (Γ(U.left, ⊤))ˣ) :=
      fun U => AddMonoidHom.mk' (fun x => ULift.up (Additive.ofMul (zU U ^ x.down.val))) (by
        intro a b
        apply ULift.ext
        apply Additive.toMul.injective
        change zU U ^ (a.down + b.down).val = zU U ^ a.down.val * zU U ^ b.down.val
        rw [ZMod.val_add, ← hzmod, pow_add])
    let κ : (Functor.const (Scheme.Etale X)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod M))) ⟶
        wcEtGmPre X :=
      { app := fun U => AddCommGrpCat.ofHom (κf U.unop)
        naturality := by
          intro U V f
          ext x
          apply hG3 V.unop
          change ((zU V.unop ^ x.down.val : (Γ(V.unop.left, ⊤))ˣ) : Γ(V.unop.left, ⊤)) =
            f.unop.left.appTop.hom ((zU U.unop ^ x.down.val : (Γ(U.unop.left, ⊤))ˣ) : Γ(U.unop.left, ⊤))
          rw [hzpow, hzpow, map_pow, hψnat] }
    have hκv : ∀ (U : X.Etale) (x : ULift.{u+1} (ZMod M)),
        ((Additive.toMul (κ.app (Opposite.op U) x).down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)) =
          ψ U ζ ^ x.down.val := fun U x => hzpow U x.down.val
    refine ⟨κ, ?_, ?_, ?_⟩
    ·
      rw [Preadditive.comp_nsmul, Category.comp_id]
      ext U x
      simp only [NatTrans.app_nsmul, NatTrans.app_zero, AddCommGrpCat.hom_nsmul,
        AddCommGrpCat.hom_zero, AddMonoidHom.nsmul_apply, AddMonoidHom.zero_apply]
      apply ULift.ext
      apply Additive.toMul.injective
      change (zU U.unop ^ x.down.val) ^ M = 1
      rw [← pow_mul, mul_comm, pow_mul, hzmod U.unop M, Nat.mod_self, pow_zero, one_pow]
    ·
      refine ⟨fun {U'} x y hxy => ?_⟩
      obtain ⟨U⟩ := U'
      rcases isEmpty_or_nonempty U.left with hE | ⟨⟨y₀⟩⟩
      · exact hcov _ _ (fun v => isEmptyElim v)
      · haveI : Nontrivial Γ(U.left, ⊤) := @Scheme.component_nontrivial U.left ⊤ ⟨⟨y₀, trivial⟩⟩
        have hinj : Function.Injective (ψ U) := (ψ U).injective
        have hprim := hζ.map_of_injective hinj
        have h1 : ψ U ζ ^ x.down.val = ψ U ζ ^ y.down.val := by
          rw [← hκv U x, ← hκv U y]
          exact congrArg (fun t : ToType ((wcEtGmPre X).obj (Opposite.op U)) =>
            ((Additive.toMul t.down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤))) hxy
        have hval := hprim.pow_inj (ZMod.val_lt _) (ZMod.val_lt _) h1
        have hxy' : x = y := ULift.ext _ _ (ZMod.val_injective _ hval)
        subst hxy'
        rw [Presheaf.equalizerSieve_self_eq_top]
        exact (Scheme.smallEtaleTopology X).top_mem _
    ·
      intro U s hs
      have hs' : M • s = 0 := by
        first
          | exact hs
          | simpa using hs
      have hv : ((Additive.toMul s.down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)) ^ M = 1 :=
        congrArg (fun t : ToType ((wcEtGmPre X).obj (Opposite.op U)) =>
            ((Additive.toMul t.down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤))) hs'
      refine hcov U _ (fun y => ?_)
      obtain ⟨k, hk⟩ := s2 (U.left.presheaf.stalk y)
        ((U.left.presheaf.germ ⊤ y trivial).hom.comp (ψ U))
        ((U.left.presheaf.germ ⊤ y trivial).hom
          ((Additive.toMul s.down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)))
        (by rw [← map_pow, hv, map_one])
      rw [RingHom.comp_apply, ← map_pow] at hk
      obtain ⟨W, hyW, hW⟩ := s3 U.left y _ _ hk
      let V₁ : X.Etale := MorphismProperty.Over.mk ⊤ (W.ι ≫ U.hom) inferInstance
      let c : V₁ ⟶ U := MorphismProperty.Over.homMk W.ι rfl trivial
      refine ⟨V₁, c, ⟨ULift.up (k : ZMod M), ?_⟩, ?_⟩
      · apply hG3 V₁
        rw [hκv]
        change _ = W.ι.appTop.hom ((Additive.toMul s.down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤))
        rw [hW, map_pow, show W.ι.appTop.hom (ψ U ζ) = ψ V₁ ζ from hψnat U V₁ c ζ,
          ZMod.val_natCast]
        exact (hψmod V₁ k).symm
      · exact ⟨⟨y, hyW⟩, rfl⟩

  have hsurjM : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X) (M • 𝟙 (wcEtGmPre X)) := by

    have s2 : ∀ (R : Type u) [CommRing R], IsUnit (M : R) → ∀ a : R, IsUnit a →
        ∃ (B : Type u) (_ : CommRing B) (_ : Algebra R B), Algebra.Etale R B ∧
          Function.Surjective (PrimeSpectrum.comap (algebraMap R B)) ∧
          ∃ t : B, t ^ M = algebraMap R B a := by
      intro R _ hMR a ha
      set f : Polynomial R := Polynomial.X ^ M - Polynomial.C a with hf
      have hfm : f.Monic := Polynomial.monic_X_pow_sub_C a hM0
      obtain ⟨u, hu⟩ := (hMR.mul ha).exists_left_inv
      have hcert : ∃ (p₁ p₂ : Polynomial R) (n : ℕ),
          Polynomial.derivative f * p₁ + f * p₂ = (1 : Polynomial R) ^ n := by
        refine ⟨Polynomial.C u * Polynomial.X, -(Polynomial.C u * Polynomial.C (M : R)), 1, ?_⟩
        have hd : Polynomial.derivative f = Polynomial.C (M : R) * Polynomial.X ^ (M - 1) := by
          rw [hf, Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C,
            sub_zero]
        have hX : Polynomial.X ^ (M - 1) * Polynomial.X = (Polynomial.X : Polynomial R) ^ M :=
          pow_sub_one_mul hM0 Polynomial.X
        have hu' : Polynomial.C u * (Polynomial.C (M : R) * Polynomial.C a) = 1 := by
          rw [← map_mul, ← map_mul, hu, map_one]
        rw [hd, hf, pow_one]
        linear_combination hu' + (Polynomial.C u * Polynomial.C (M : R)) * hX
      let P : StandardEtalePair R := ⟨f, hfm, 1, hcert⟩
      have e₂ : AdjoinRoot f ≃ₐ[R] Localization.Away ((AdjoinRoot.mk f) 1) :=
        (IsLocalization.atUnit (AdjoinRoot f) (Localization.Away ((AdjoinRoot.mk f) 1))
          ((AdjoinRoot.mk f) 1) (by simp)).restrictScalars R
      have e : P.Ring ≃ₐ[R] AdjoinRoot f := P.equivAwayAdjoinRoot.trans e₂.symm
      have het : Algebra.Etale R (AdjoinRoot f) := Algebra.Etale.of_equiv e
      refine ⟨AdjoinRoot f, inferInstance, inferInstance, het, ?_, AdjoinRoot.root f, ?_⟩
      · rcases subsingleton_or_nontrivial R with hR | hR
        · have : IsEmpty (PrimeSpectrum R) := PrimeSpectrum.isEmpty_iff_subsingleton.mpr hR
          intro x
          exact isEmptyElim x
        · have : Module.Free R (AdjoinRoot f) := hfm.free_adjoinRoot
          let pb := AdjoinRoot.powerBasis' hfm
          have hdim : 0 < pb.dim := by
            rw [AdjoinRoot.powerBasis'_dim, hf, Polynomial.natDegree_X_pow_sub_C]
            exact Nat.pos_of_ne_zero hM0
          have : Nontrivial (AdjoinRoot f) := nontrivial_of_ne _ _ (pb.basis.ne_zero ⟨0, hdim⟩)
          exact PrimeSpectrum.comap_surjective_of_faithfullyFlat
      · have h1 : Polynomial.aeval (AdjoinRoot.root f) f = 0 := by
          rw [AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]
        rw [hf, map_sub, Polynomial.aeval_X_pow, Polynomial.aeval_C] at h1
        exact sub_eq_zero.mp h1

    have s3 : ∀ (Y : Scheme.{u}) (B : Type u) [CommRing B] [Algebra Γ(Y, ⊤) B],
        Algebra.Etale Γ(Y, ⊤) B → Function.Surjective (PrimeSpectrum.comap (algebraMap Γ(Y, ⊤) B)) →
        ∃ (V : Scheme.{u}) (p : V ⟶ Y) (ψ : B →+* Γ(V, ⊤)), Etale p ∧ Function.Surjective p ∧
          ∀ r : Γ(Y, ⊤), ψ (algebraMap Γ(Y, ⊤) B r) = p.appTop.hom r := by
      intro Y B _ _ hB hsurj
      let φ : CommRingCat.of Γ(Y, ⊤) ⟶ CommRingCat.of B := CommRingCat.ofHom (algebraMap Γ(Y, ⊤) B)
      let g : Spec (CommRingCat.of B) ⟶ Spec (CommRingCat.of Γ(Y, ⊤)) := Spec.map φ
      have hg : Etale g := by
        apply (HasRingHomProperty.Spec_iff (P := @Etale)).mpr
        rw [CommRingCat.hom_ofHom]
        exact RingHom.etale_algebraMap.mpr hB
      have hgs : Surjective g := by
        constructor
        exact hsurj
      let p := Limits.pullback.fst Y.toSpecΓ g
      let q := Limits.pullback.snd Y.toSpecΓ g
      refine ⟨Limits.pullback Y.toSpecΓ g, p,
        ((Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫ q.appTop).hom,
        inferInstance, p.surjective, fun r => ?_⟩
      have hc : Y.toSpecΓ.appTop ≫ p.appTop = g.appTop ≫ q.appTop := by
        rw [← Scheme.Hom.comp_appTop, ← Scheme.Hom.comp_appTop, Limits.pullback.condition]
      have hn := Scheme.ΓSpecIso_inv_naturality φ
      have key : φ ≫ (Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫ q.appTop = p.appTop := by
        rw [← Category.assoc, hn, Category.assoc, ← hc, Scheme.toSpecΓ_appTop]
        exact Iso.inv_hom_id_assoc _ _
      exact congrArg (fun h => h.hom r) key

    have hcov : ∀ (V : X.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : X.Etale) (c : V₁ ⟶ V),
        S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology X V := by
      intro V S hS
      change S ∈ Scheme.smallGrothendieckTopology @Etale X V
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      obtain ⟨V₁, c, hc, y, hy⟩ := hS x
      have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
      have hEt : Etale c.left := by
        have h1 : Etale V.hom := V.prop
        have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
        exact Etale.of_comp c.left V.hom
      exact ⟨V₁, c, y, hc, hEt, hy⟩
    refine Presheaf.IsLocallySurjective.mk (fun {U} s => ?_)
    let aU : (Γ(U.left, ⊤))ˣ := Additive.toMul s.down
    let cU : Ω →+* Γ(U.left, ⊤) :=
      ((U.hom ≫ fX).appTop).hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom
    have hMR : IsUnit (M : Γ(U.left, ⊤)) := by
      rw [← map_natCast cU]
      exact (Ne.isUnit hMΩ).map cU
    obtain ⟨B, _, _, hBet, hBsurj, t, ht⟩ := s2 Γ(U.left, ⊤) hMR (aU : Γ(U.left, ⊤)) aU.isUnit
    obtain ⟨V, p, ψ, hpet, hpsurj, hψ⟩ := s3 U.left B hBet hBsurj
    have hT : ψ t ^ M = p.appTop.hom (aU : Γ(U.left, ⊤)) := by rw [← map_pow, ht, hψ]
    have hTu : IsUnit (ψ t) := by
      have h1 : IsUnit (ψ t ^ M) := by rw [hT]; exact aU.isUnit.map _
      exact (isUnit_pow_iff hM0).mp h1
    haveI := hpet
    let V₁ : X.Etale := MorphismProperty.Over.mk ⊤ (p ≫ U.hom) inferInstance
    let c : V₁ ⟶ U := MorphismProperty.Over.homMk p rfl trivial
    have hc : (Presheaf.imageSieve (M • 𝟙 (wcEtGmPre X)) s).arrows c := by
      refine ⟨ULift.up (Additive.ofMul hTu.unit), ?_⟩
      simp only [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.hom_nsmul,
        AddMonoidHom.nsmul_apply, AddCommGrpCat.hom_id, AddMonoidHom.id_apply]
      apply ULift.ext
      apply Additive.toMul.injective
      apply Units.ext
      change ((hTu.unit ^ M : (Γ(V, ⊤))ˣ) : Γ(V, ⊤)) = p.appTop.hom (aU : Γ(U.left, ⊤))
      rw [Units.val_pow_eq_pow_val, IsUnit.unit_spec, hT]
    exact hcov U _ (fun v => ⟨V₁, c, hc, hpsurj v⟩)

  have hA : ∀ (P₁ P₂ P₃ : (Scheme.Etale X)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (f : P₁ ⟶ P₂) (g : P₂ ⟶ P₃),
      f ≫ g = 0 → Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology X) f →
      (∀ (U : Scheme.Etale X) (s : ToType (P₂.obj (Opposite.op U))),
        g.app (Opposite.op U) s = 0 → Presheaf.imageSieve f s ∈ Scheme.smallEtaleTopology X U) →
      Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X) g →
      ∀ (g' : (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj P₂ ⟶
          (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj P₃),
        (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map g = g' →
        ∃ h : (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f ≫ g' = 0,
          (ShortComplex.mk ((presheafToSheaf (Scheme.smallEtaleTopology X)
            AddCommGrpCat.{u+1}).map f) g' h).ShortExact := by
    intro P₁ P₂ P₃ f g hfg hinj hex hsurj g' hg'
    subst hg'
    have h : (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f ≫
        (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map g = 0 := by
      rw [← Functor.map_comp, hfg, Functor.map_zero]
    refine ⟨h, ?_⟩
    have hmono : Mono ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f) := by
      haveI : Sheaf.IsLocallyInjective
          ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f) :=
        (Presheaf.isLocallyInjective_presheafToSheaf_map_iff _ f).mpr hinj
      exact Sheaf.mono_of_isLocallyInjective _
    have hepi : Epi ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map g) := by
      rw [← Sheaf.isLocallySurjective_iff_epi']
      exact (Presheaf.isLocallySurjective_presheafToSheaf_map_iff _ g).mpr hsurj
    refine ShortComplex.ShortExact.mk' ?_ hmono hepi
    rw [ShortComplex.exact_iff_epi_kernel_lift]
    have hk : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X)
        (Limits.kernel.lift g f hfg) := by
      refine Presheaf.IsLocallySurjective.mk (fun {U} s => ?_)
      have ht : g.app (Opposite.op U) ((Limits.kernel.ι g).app (Opposite.op U) s) = 0 := by
        rw [← ConcreteCategory.comp_apply, ← NatTrans.comp_app, Limits.kernel.condition]
        rfl
      refine GrothendieckTopology.superset_covering _ ?_ (hex U _ ht)
      intro V φ hφ
      obtain ⟨r, hr⟩ := hφ
      refine ⟨r, ?_⟩
      have hm : Mono ((Limits.kernel.ι g).app (Opposite.op V)) :=
        (NatTrans.mono_iff_mono_app _).mp inferInstance _
      apply (AddCommGrpCat.mono_iff_injective _).mp hm
      rw [← ConcreteCategory.comp_apply, ← NatTrans.comp_app, Limits.kernel.lift_ι, hr,
        ← ConcreteCategory.comp_apply, ← ConcreteCategory.comp_apply, NatTrans.naturality]
    have hkF : Epi ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
        (Limits.kernel.lift g f hfg)) := by
      rw [← Sheaf.isLocallySurjective_iff_epi']
      exact (Presheaf.isLocallySurjective_presheafToSheaf_map_iff _ _).mpr hk
    have heq : Limits.kernel.lift
        ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map g)
        ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f) h =
        (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
          (Limits.kernel.lift g f hfg) ≫
        (Limits.PreservesKernel.iso
          (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) g).hom := by
      rw [Limits.PreservesKernel.iso_hom, Limits.map_lift_kernelComparison]
    change Epi (Limits.kernel.lift
        ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map g)
        ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f) h)
    rw [heq]
    exact epi_comp _ _

  have hmap : (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
      (M • 𝟙 (wcEtGmPre X)) = M • 𝟙 (wcEtGm X) := by
    rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
    rfl

  obtain ⟨κ, h0, hinj, hex⟩ := hkappa
  obtain ⟨h, hS⟩ := hA _ _ _ κ (M • 𝟙 (wcEtGmPre X)) h0 hinj hex
    hsurjM (M • 𝟙 (wcEtGm X)) hmap
  exact ⟨(presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map κ, h, hS⟩

theorem wc_curve_divisor_degree_point_congr_gen : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IrreducibleSpace X], (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) → topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) → ∀ (U : X.Opens) [IsDedekindDomain Γ(X, U)] (hU : IsAffineOpen U), ((U : Set X)ᶜ).Finite → ∀ M : ℕ, (M : Ω) ≠ 0 → ∀ ord : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ, wcCurveOrdData Ω X fX U hU ord → (∀ (m : Additive (FractionRing Γ(X, U))ˣ) (E : X →₀ ℤ), (∀ x, E x = ord x m) → E.sum (fun _ k => k) = 0) ∧ ∃ Q : X, Q ≠ genericPoint X ∧ ∀ x : X, x ≠ genericPoint X → ∃ (E : X →₀ ℤ) (m : Additive (FractionRing Γ(X, U))ˣ), E (genericPoint X) = 0 ∧ ∀ y, Finsupp.single x 1 y - Finsupp.single Q 1 y = (M : ℤ) * E y + ord y m :=
by
  intro Ω _ _ X fX _ _ hn hd U _ hU hfin M hMΩ ord ho
  classical

  obtain ⟨p₀, hp₀le, hp₀⟩ := Nat.exists_infinite_primes (ringChar Ω + 2)
  have hp₀Ω : (p₀ : Ω) ≠ 0 := by
    intro h
    have hdvd : ringChar Ω ∣ p₀ := ringChar.dvd h
    rcases hp₀.eq_one_or_self_of_dvd _ hdvd with h1 | h1
    · exact CharP.ringChar_ne_one h1
    · omega
  have hM0 : M ≠ 0 := by
    rintro rfl
    exact hMΩ (by simp)

  obtain ⟨hdeg, Q, hQ, -⟩ :=
    wc_curve_divisor_degree_point_congr Ω X fX hn hd U hU hfin p₀ hp₀ hp₀Ω ord ho

  have hdegHom : ∀ F : X →₀ ℤ, F.sum (fun _ k => k) =
      Finsupp.liftAddHom (fun _ => AddMonoidHom.id ℤ) F := by
    intro F
    rw [Finsupp.liftAddHom_apply]
    rfl

  have c1 : ∀ (Q' : X) (n : ℤ), (∀ x : X, x ≠ genericPoint X → ∃ (E : X →₀ ℤ)
      (m : Additive (FractionRing Γ(X, U))ˣ), E (genericPoint X) = 0 ∧
        ∀ y, Finsupp.single x 1 y - Finsupp.single Q' 1 y = n * E y + ord y m) →
      ∀ D : X →₀ ℤ, D (genericPoint X) = 0 → D.sum (fun _ k => k) = 0 →
        ∃ (E : X →₀ ℤ) (m : Additive (FractionRing Γ(X, U))ˣ), E (genericPoint X) = 0 ∧
          ∀ y, D y = n * E y + ord y m := by
    intro Q' n hpt
    have A : ∀ F : X →₀ ℤ, ∃ (E : X →₀ ℤ) (m : Additive (FractionRing Γ(X, U))ˣ),
        E (genericPoint X) = 0 ∧ ∀ y, (F.erase (genericPoint X)) y -
          (F.erase (genericPoint X)).sum (fun _ k => k) * Finsupp.single Q' 1 y =
            n * E y + ord y m := by
      intro F
      induction F using Finsupp.induction_linear with
      | zero => exact ⟨0, 0, by simp, fun y => by simp⟩
      | add f g ihf ihg =>
        obtain ⟨Ef, mf, hEf, hf⟩ := ihf
        obtain ⟨Eg, mg, hEg, hg⟩ := ihg
        refine ⟨Ef + Eg, mf + mg, by simp [hEf, hEg], fun y => ?_⟩
        rw [Finsupp.erase_add, Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl)]
        have h1 := hf y
        have h2 := hg y
        simp only [Finsupp.add_apply, map_add]
        linear_combination h1 + h2
      | single a b =>
        by_cases ha : a = genericPoint X
        · subst ha
          refine ⟨0, 0, by simp, fun y => ?_⟩
          rw [Finsupp.erase_single]
          simp
        · obtain ⟨Ea, ma, hEa, hEa'⟩ := hpt a ha
          refine ⟨b • Ea, b • ma, by simp [hEa], fun y => ?_⟩
          rw [Finsupp.erase_single_ne (Ne.symm ha), Finsupp.sum_single_index rfl]
          have h := hEa' y
          have hs : (Finsupp.single a b) y = b * Finsupp.single a 1 y := by
            rw [Finsupp.single_apply, Finsupp.single_apply]
            split_ifs <;> simp
          rw [hs]
          simp only [Finsupp.smul_apply, smul_eq_mul, map_zsmul]
          linear_combination b * h
    intro D hDη hDdeg
    obtain ⟨E, m, hEη, hE⟩ := A D
    have hDe : D.erase (genericPoint X) = D := by
      ext y
      by_cases hy : y = genericPoint X
      · subst hy
        rw [Finsupp.erase_same, hDη]
      · rw [Finsupp.erase_ne hy]
    refine ⟨E, m, hEη, fun y => ?_⟩
    have h := hE y
    rw [hDe, hDdeg, zero_mul, sub_zero] at h
    exact h

  have hprime : ∀ p : ℕ, p.Prime → p ∣ M → ∀ D : X →₀ ℤ, D (genericPoint X) = 0 →
      D.sum (fun _ k => k) = 0 → ∃ (E : X →₀ ℤ) (m : Additive (FractionRing Γ(X, U))ˣ),
        E (genericPoint X) = 0 ∧ ∀ y, D y = (p : ℤ) * E y + ord y m := by
    intro p hp hpM
    have hpΩ : (p : Ω) ≠ 0 := by
      intro h
      obtain ⟨k, hk⟩ := hpM
      apply hMΩ
      rw [hk, Nat.cast_mul, h, zero_mul]
    obtain ⟨-, Qp, -, hcp⟩ :=
      wc_curve_divisor_degree_point_congr Ω X fX hn hd U hU hfin p hp hpΩ ord ho
    exact c1 Qp (p : ℤ) hcp

  have hall : ∀ a : ℕ, a ∣ M → ∀ D : X →₀ ℤ, D (genericPoint X) = 0 →
      D.sum (fun _ k => k) = 0 → ∃ (E : X →₀ ℤ) (m : Additive (FractionRing Γ(X, U))ˣ),
        E (genericPoint X) = 0 ∧ ∀ y, D y = (a : ℤ) * E y + ord y m := by
    intro a
    induction a using Nat.strong_induction_on with
    | _ a ih =>
      intro haM
      rcases Nat.lt_trichotomy a 1 with h0 | h1 | h2
      · have ha0 : a = 0 := by omega
        subst ha0
        exact absurd (zero_dvd_iff.mp haM) hM0
      · subst h1
        intro D hDη _
        exact ⟨D, 0, hDη, fun y => by simp⟩
      · have ha1 : a ≠ 1 := by omega
        obtain ⟨p, hp_def⟩ : ∃ p, p = Nat.minFac a := ⟨_, rfl⟩
        have hp : p.Prime := hp_def ▸ Nat.minFac_prime ha1
        have hpa : p ∣ a := hp_def ▸ Nat.minFac_dvd a
        obtain ⟨a', ha'⟩ := hpa
        have ha'pos : 0 < a' := by
          rcases Nat.eq_zero_or_pos a' with h | h
          · rw [h, mul_zero] at ha'
            omega
          · exact h
        have hp1 := hp.one_lt
        have ha'lt : a' < a := by
          rw [ha']
          nlinarith
        have ha'M : a' ∣ M := dvd_trans (Dvd.intro_left p ha'.symm) haM
        have hpM : p ∣ M := dvd_trans (Dvd.intro a' ha'.symm) haM
        intro D hDη hDdeg
        obtain ⟨E₁, m₁, hE₁η, hE₁⟩ := ih a' ha'lt ha'M D hDη hDdeg
        have hdegE₁ : E₁.sum (fun _ k => k) = 0 := by
          have hR := hdeg m₁ (D - (a' : ℤ) • E₁) (fun x => by
            rw [Finsupp.sub_apply, Finsupp.smul_apply, smul_eq_mul, hE₁ x]
            ring)
          rw [hdegHom, map_sub, map_zsmul, ← hdegHom, ← hdegHom, hDdeg, smul_eq_mul] at hR
          have hne : (a' : ℤ) ≠ 0 := by exact_mod_cast ha'pos.ne'
          rcases mul_eq_zero.mp (by linarith : (a' : ℤ) * E₁.sum (fun _ k => k) = 0) with h | h
          · exact absurd h hne
          · exact h
        obtain ⟨E₂, m₂, hE₂η, hE₂⟩ := hprime p hp hpM E₁ hE₁η hdegE₁
        refine ⟨E₂, (a' : ℤ) • m₂ + m₁, hE₂η, fun y => ?_⟩
        rw [hE₁ y, hE₂ y, map_add, map_zsmul, smul_eq_mul, ha', Nat.cast_mul]
        ring

  refine ⟨hdeg, Q, hQ, fun x hx => ?_⟩
  have hDη : (Finsupp.single x 1 - Finsupp.single Q 1 : X →₀ ℤ) (genericPoint X) = 0 := by
    simp [Finsupp.single_apply, hx, hQ]
  have hDdeg : (Finsupp.single x 1 - Finsupp.single Q 1 : X →₀ ℤ).sum (fun _ k => k) = 0 := by
    rw [Finsupp.sum_sub_index (fun _ _ _ => rfl), Finsupp.sum_single_index rfl,
      Finsupp.sum_single_index rfl, sub_self]
  obtain ⟨E, m, hEη, hE⟩ := hall M dvd_rfl _ hDη hDdeg
  exact ⟨E, m, hEη, fun y => by rw [← Finsupp.sub_apply]; exact hE y⟩

theorem wc_et_zmodext_coh_equiv (Y : Scheme.{u}) (n i : ℕ) :
    Nonempty (wcEtZModExt Y n i ≃ wcEtCoh Y n i) :=
by
  classical
  letI hExtM : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y n)) := HasExt.standard _
  letI hExtS : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
    HasExt.standard _
  haveI hEIM : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing Y n)) :=
    sheafOfModules_enoughInjectives _ _
  haveI hEIS : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
    wc_et_enough_injectives Y
  haveI hPC : Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)) :=
    sheafOfModules_toSheaf_preservesFiniteColimits _ _

  obtain ⟨α, hinj, hsurj, hR⟩ := wc_et_zmod_ring_locbij Y n
  obtain ⟨hfull, hess⟩ := sheafOfModules_toSheaf_torsion_equiv (Scheme.smallEtaleTopology Y)
    (wcEtZModRing Y n) n α hinj hsurj
  haveI := hfull

  have hT : Limits.IsTerminal ((wcZarToEt Y).obj ⊤) := by
    have huniq : ∀ (V : Y.Etale) (f g : V ⟶ (wcZarToEt Y).obj ⊤), f = g := by
      intro V f g
      haveI : Mono ((wcZarToEt Y).obj ⊤).hom :=
        show Mono (⊤ : Y.Opens).ι from (inferInstance : Mono (⊤ : Y.Opens).ι)
      apply MorphismProperty.Over.Hom.ext
      rw [← cancel_mono ((wcZarToEt Y).obj ⊤).hom, MorphismProperty.Over.w f,
        MorphismProperty.Over.w g]
    exact Limits.IsTerminal.ofUniqueHom
      (fun V => MorphismProperty.Over.homMk (V.hom ≫ Y.topIso.inv)
        (by
          change (V.hom ≫ Y.topIso.inv) ≫ (⊤ : Y.Opens).ι = V.hom
          rw [← Scheme.topIso_hom, Category.assoc, Iso.inv_hom_id, Category.comp_id]) trivial)
      (fun V m => huniq V m _)
  obtain ⟨ε, hε⟩ := sheafOfModules_unit_corepresented_by_free_terminal
    (Scheme.smallEtaleTopology Y) (wcEtZModRing Y n) ((wcZarToEt Y).obj ⊤) hT
  obtain ⟨θ⟩ := wc_et_free_top_iso_const Y
  have hhom : ∀ M : SheafOfModules.{u+1} (wcEtZModRing Y n),
      Function.Bijective (fun f : SheafOfModules.unit (wcEtZModRing Y n) ⟶ M =>
        (θ.inv ≫ ε) ≫ (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).map f) := by
    intro M
    have hθ : Function.Bijective (fun g : _ ⟶ (SheafOfModules.toSheaf.{u+1}
        (wcEtZModRing Y n)).obj M => θ.inv ≫ g) :=
      ⟨fun g₁ g₂ h => (cancel_epi θ.inv).mp h,
        fun g => ⟨θ.hom ≫ g, Iso.inv_hom_id_assoc θ g⟩⟩
    have e : (fun f : SheafOfModules.unit (wcEtZModRing Y n) ⟶ M =>
        (θ.inv ≫ ε) ≫ (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).map f) =
        (fun g => θ.inv ≫ g) ∘ (fun f : SheafOfModules.unit (wcEtZModRing Y n) ⟶ M =>
          ε ≫ (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).map f) :=
      funext fun f => Category.assoc _ _ _
    rw [e]
    exact hθ.comp (hε M)

  have hev : ∀ {M M' : SheafOfModules.{u+1} (wcEtZModRing Y n)} (f : M ⟶ M')
      (V : (Y.Etale)ᵒᵖ), f.val.app V = (SheafOfModules.forget (wcEtZModRing Y n) ⋙
        PresheafOfModules.evaluation (wcEtZModRing Y n).obj V).map f :=
    fun _ _ => rfl
  have hnsmulApp : ∀ (M : SheafOfModules.{u+1} (wcEtZModRing Y n)) (V : (Y.Etale)ᵒᵖ),
      (n • 𝟙 M).val.app V = n • 𝟙 (M.val.obj V) := by
    intro M V
    rw [hev, CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
    rfl
  have hzeroApp : ∀ (M M' : SheafOfModules.{u+1} (wcEtZModRing Y n)) (V : (Y.Etale)ᵒᵖ),
      (0 : M ⟶ M').val.app V = 0 := by
    intro M M' V
    rw [hev, CategoryTheory.Functor.map_zero]
    rfl
  have hkillM : ∀ M : SheafOfModules.{u+1} (wcEtZModRing Y n), n • 𝟙 M = 0 := by
    intro M
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro V
    rw [hnsmulApp, hzeroApp]
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    rw [ModuleCat.hom_nsmul, ModuleCat.hom_id, ModuleCat.hom_zero, LinearMap.smul_apply,
      LinearMap.id_apply, LinearMap.zero_apply,
      ← Nat.cast_smul_eq_nsmul ((wcEtZModRing Y n).obj.obj V), hR V, zero_smul]

  have hvan : ∀ (I : SheafOfModules.{u+1} (wcEtZModRing Y n)) [Injective I] (k : ℕ)
      (e : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)))
        ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).obj I) (k + 1)), e = 0 := by
    intro I _ k e
    let ι := Injective.ι ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).obj I)
    let K := Injective.under ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).obj I)
    let ν : K ⟶ K := n • 𝟙 K
    have hιν : ι ≫ ν = 0 := by
      have e1 : ι ≫ ν = (n • 𝟙 _) ≫ ι := by
        show ι ≫ (n • 𝟙 _) = (n • 𝟙 _) ≫ ι
        rw [Preadditive.comp_nsmul, Preadditive.nsmul_comp, Category.comp_id, Category.id_comp]
      rw [e1, ← (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).map_id,
        ← Functor.map_nsmul, hkillM I, Functor.map_zero, Limits.zero_comp]
    let ι' : (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).obj I ⟶ Limits.kernel ν :=
      Limits.kernel.lift ν ι hιν
    have hι' : ι' ≫ Limits.kernel.ι ν = ι := Limits.kernel.lift_ι _ _ _
    haveI : Mono ι' := mono_of_mono_fac hι'
    have hker : n • 𝟙 (Limits.kernel ν) = 0 := by
      rw [← cancel_mono (Limits.kernel.ι ν), Limits.zero_comp, Preadditive.nsmul_comp,
        Category.id_comp]
      have := Limits.kernel.condition ν
      simp only [ν, Preadditive.comp_nsmul, Category.comp_id] at this
      exact this
    obtain ⟨M, ⟨eM⟩⟩ := hess _ hker
    let g : I ⟶ M := (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).preimage (ι' ≫ eM.inv)
    have hg : (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).map g = ι' ≫ eM.inv :=
      (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).map_preimage _
    haveI hmg : Mono ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).map g) := by
      rw [hg]; infer_instance
    haveI : Mono g := (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).mono_of_mono_map hmg
    let r : M ⟶ I := Injective.factorThru (𝟙 I) g
    have hr : g ≫ r = 𝟙 I := Injective.comp_factorThru _ _
    have hst : ι' ≫ (eM.inv ≫ (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).map r) =
        𝟙 ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).obj I) := by
      rw [← Category.assoc, ← hg, ← Functor.map_comp, hr,
        (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).map_id]
    have hz : e.comp (Abelian.Ext.mk₀ ι') (add_zero _) = 0 := by
      by_cases hn : n = 0
      · have hν : ν = 0 := (congrArg (fun m : ℕ => m • 𝟙 K) hn).trans (zero_nsmul _)
        let s : K ⟶ Limits.kernel ν := Limits.kernel.lift ν (𝟙 K) (by rw [hν, Limits.comp_zero])
        have hs1 : s ≫ Limits.kernel.ι ν = 𝟙 K := Limits.kernel.lift_ι _ _ _
        have hs2 : Limits.kernel.ι ν ≫ s = 𝟙 _ := by
          rw [← cancel_mono (Limits.kernel.ι ν), Category.assoc, hs1, Category.comp_id,
            Category.id_comp]
        haveI : Injective (Limits.kernel ν) :=
          Injective.of_iso ⟨s, Limits.kernel.ι ν, hs1, hs2⟩ inferInstance
        exact Abelian.Ext.eq_zero_of_injective _
      · have hsub := wc_et_injective_torsion_kernel_acyclic Y K n hn k
        haveI : Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
            AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
            (Limits.kernel ν) (k + 1)) := hsub
        exact Subsingleton.elim _ _
    have he : e = (e.comp (Abelian.Ext.mk₀ ι') (add_zero _)).comp
        (Abelian.Ext.mk₀ (eM.inv ≫ (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).map r))
        (add_zero _) := by
      calc e = e.comp (Abelian.Ext.mk₀ (ι' ≫ (eM.inv ≫
              (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).map r))) (add_zero _) := by
            rw [hst, Abelian.Ext.comp_mk₀_id]
        _ = e.comp ((Abelian.Ext.mk₀ ι').comp (Abelian.Ext.mk₀ (eM.inv ≫
              (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).map r)) (add_zero 0))
              (add_zero _) := by rw [Abelian.Ext.mk₀_comp_mk₀]
        _ = _ := (Abelian.Ext.comp_assoc _ _ _ (add_zero _) (add_zero 0) (by omega)).symm
    rw [he, hz, Abelian.Ext.zero_comp]

  have hΦ := ext_transfer_of_corep (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n))
    (SheafOfModules.unit (wcEtZModRing Y n))
    ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) (θ.inv ≫ ε) hhom hvan
    (SheafOfModules.unit (wcEtZModRing Y n)) i

  haveI := hinj
  haveI := hsurj
  let φ : (Functor.const (Y.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⋙
      forget₂ RingCat.{u+1} AddCommGrpCat.{u+1} ⟶
      ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).obj
        (SheafOfModules.unit (wcEtZModRing Y n))).obj :=
    Functor.whiskerRight α (forget₂ RingCat.{u+1} AddCommGrpCat.{u+1})
  haveI hφi : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology Y) φ := by
    rw [← Presheaf.isLocallyInjective_forget_iff]
    exact (Presheaf.isLocallyInjective_forget_iff _ α).mpr hinj
  haveI hφs : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) φ := by
    rw [Presheaf.isLocallySurjective_iff_whisker_forget]
    exact (Presheaf.isLocallySurjective_iff_whisker_forget _ α).mp hsurj
  let c : (Functor.const (Y.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod n))) ⟶
      ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).obj
        (SheafOfModules.unit (wcEtZModRing Y n))).obj :=
    (Functor.constComp (Y.Etale)ᵒᵖ (RingCat.of (ULift.{u+1} (ZMod n)))
      (forget₂ RingCat.{u+1} AddCommGrpCat.{u+1})).inv ≫ φ
  haveI : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology Y) c :=
    Presheaf.isLocallyInjective_comp _ _ _
  haveI : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) c :=
    Presheaf.isLocallySurjective_comp _ _ _
  haveI hiso : IsIso ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map c) :=
    (GrothendieckTopology.W_iff _ c).mp (GrothendieckTopology.W_of_isLocallyBijective _ c)
  let ιu : (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).obj
        (SheafOfModules.unit (wcEtZModRing Y n)) ≅
      (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod n))) :=
    sheafificationIso _ ≪≫
      (asIso ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map c)).symm
  have hΨ : Function.Bijective (fun y : Abelian.Ext
      ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).obj
        (SheafOfModules.unit (wcEtZModRing Y n))) i =>
      y.comp (Abelian.Ext.mk₀ ιu.hom) (add_zero i)) := by
    refine ⟨fun y₁ y₂ hy => ?_, fun z => ⟨z.comp (Abelian.Ext.mk₀ ιu.inv) (add_zero i), ?_⟩⟩
    · have hy' := congrArg (fun t => t.comp (Abelian.Ext.mk₀ ιu.inv) (add_zero i)) hy
      simp only at hy'
      rwa [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
        Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id,
        Abelian.Ext.comp_mk₀_id] at hy'
    · simp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
  exact ⟨Equiv.ofBijective _ (hΨ.comp hΦ)⟩

theorem wc_pow_curve_h2_irreducible_card : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : Scheme.{u}) (fW : W ⟶ Spec (.of Ω)) [IsProper fW] [IrreducibleSpace W] (M : ℕ), M ≠ 0 → (M : Ω) ≠ 0 → topologicalKrullDim W ≤ ((1 : ℕ) : WithBot ℕ∞) → ¬ topologicalKrullDim W ≤ ((0 : ℕ) : WithBot ℕ∞) → (∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Y₀ : Scheme.{u}) (f : Y₀ ⟶ Spec (.of A)) [IsProper f] (m' : ℕ), m' ≠ 0 → ∀ S : Set (Spec (.of A)), IsOpen S → S ≠ Set.univ → ∀ q' : ℕ, Subsingleton (wcEtExt Y₀ (wcEtExtZero Y₀ (f ⁻¹' S) m') q')) → Finite (wcEtZModExt W M 2) ∧ Nat.card (wcEtZModExt W M 2) = M :=
by
  intro Ω _ _ W fW _ _ M hM hMΩ hdim hdim0 hPBC
  have hdim1 : topologicalKrullDim W = ((1 : ℕ) : WithBot ℕ∞) := by
    generalize topologicalKrullDim W = x at hdim hdim0 ⊢
    induction x using WithBot.recBotCoe with
    | bot => exact absurd bot_le hdim0
    | coe y =>
      induction y using ENat.recTopCoe with
      | top =>
        exfalso
        have h1 : (⊤ : ℕ∞) ≤ ((1 : ℕ) : ℕ∞) := WithBot.coe_le_coe.mp hdim
        exact absurd h1 (not_le_of_gt (ENat.coe_lt_top 1))
      | coe j =>
        have h1 : ((j : ℕ) : ℕ∞) ≤ ((1 : ℕ) : ℕ∞) := WithBot.coe_le_coe.mp hdim
        have h0 : ¬ ((j : ℕ) : ℕ∞) ≤ ((0 : ℕ) : ℕ∞) := fun h => hdim0 (WithBot.coe_le_coe.mpr h)
        have h1' : j ≤ 1 := ENat.coe_le_coe.mp h1
        have h0' : ¬ j ≤ 0 := fun h => h0 (ENat.coe_le_coe.mpr h)
        have hj : j = 1 := by omega
        subst hj
        rfl
  have hnc : Set.ncard {x : W | ¬ IsClosed ({x} : Set W)} = 1 :=
    wc_top_irreducible_dim_one_ncard W hdim1
  have hKum := fun (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of Ω)) => wc_et_kummer_ses_gen Ω Y fY M hMΩ
  have hNorm := wc_et_normal_curve_h2_card_gen Ω M hMΩ hKum (by
    intro Y fY _ _ hn hd U _ hU hfin ord hord
    exact wc_curve_divisor_degree_point_congr_gen Ω Y fY hn hd U hU hfin M hMΩ ord hord)
  have hcard := wc_et_curve_h2_card_reduction_gen Ω M hM hMΩ hPBC hNorm W fW hdim
  rw [hnc, pow_one] at hcard
  obtain ⟨e⟩ := wc_et_zmodext_coh_equiv W M 2
  have hZ : Nat.card (wcEtZModExt W M 2) = M := (Nat.card_congr e).trans hcard
  exact ⟨Nat.finite_of_card_ne_zero (by rw [hZ]; exact hM), hZ⟩

theorem wc_pow_curve_h2_component_restrict_bijective : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (C : Scheme.{u}) (fC : C ⟶ Spec (.of Ω)) [IsProper fC] (M : ℕ), M ≠ 0 → (M : Ω) ≠ 0 → topologicalKrullDim C ≤ ((1 : ℕ) : WithBot ℕ∞) → (∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Y₀ : Scheme.{u}) (f : Y₀ ⟶ Spec (.of A)) [IsProper f] (m' : ℕ), m' ≠ 0 → ∀ S : Set (Spec (.of A)), IsOpen S → S ≠ Set.univ → ∀ q' : ℕ, Subsingleton (wcEtExt Y₀ (wcEtExtZero Y₀ (f ⁻¹' S) m') q')) → ∀ (D : ∀ Z : Set C, wcEtPullData (Scheme.IdealSheafData.vanishingIdeal (⟨closure Z, isClosed_closure⟩ : TopologicalSpace.Closeds C)).subschemeι M), (∀ y : wcEtZModExt C M 2, (∀ Z : Set C, Z ∈ irreducibleComponents C → ¬ topologicalKrullDim ↥Z ≤ ((0 : ℕ) : WithBot ℕ∞) → wcEtPull (D Z) 2 y = 0) → y = 0) ∧ (∀ w : ∀ Z : Set C, wcEtZModExt (Scheme.IdealSheafData.vanishingIdeal (⟨closure Z, isClosed_closure⟩ : TopologicalSpace.Closeds C)).subscheme M 2, ∃ y : wcEtZModExt C M 2, ∀ Z : Set C, Z ∈ irreducibleComponents C → ¬ topologicalKrullDim ↥Z ≤ ((0 : ℕ) : WithBot ℕ∞) → wcEtPull (D Z) 2 y = w Z) :=
by
  intro Ω _ _ C fC _ M hM hMΩ hdim hPBC D
  classical
  haveI : IsLocallyNoetherian C := LocallyOfFiniteType.isLocallyNoetherian fC
  haveI : CompactSpace C := QuasiCompact.compactSpace_of_compactSpace fC
  haveI : IsNoetherian C := ⟨⟩
  have hfin : Set.Finite {Z : Set C | Z ∈ irreducibleComponents C ∧
      ¬ topologicalKrullDim ↥Z ≤ ((0 : ℕ) : WithBot ℕ∞)} :=
    (TopologicalSpace.NoetherianSpace.finite_irreducibleComponents (α := C)).subset
      (fun Z hZ => hZ.1)
  haveI : Finite (wcCompIdx C) := hfin.to_subtype

  have hrange : ∀ Z : Set C, Z ∈ irreducibleComponents C →
      Set.range (Scheme.IdealSheafData.vanishingIdeal
        (⟨closure Z, isClosed_closure⟩ : TopologicalSpace.Closeds C)).subschemeι = Z := by
    intro Z h1
    rw [Scheme.IdealSheafData.range_subschemeι,
      Scheme.IdealSheafData.coe_support_vanishingIdeal]
    exact (isClosed_of_mem_irreducibleComponents Z h1).closure_eq
  have hsub : ∀ Z : Set C, Z ∈ irreducibleComponents C →
      ¬ topologicalKrullDim ↥Z ≤ ((0 : ℕ) : WithBot ℕ∞) →
      IrreducibleSpace (Scheme.IdealSheafData.vanishingIdeal
        (⟨closure Z, isClosed_closure⟩ : TopologicalSpace.Closeds C)).subscheme ∧
      Nonempty (Scheme.IdealSheafData.vanishingIdeal
        (⟨closure Z, isClosed_closure⟩ : TopologicalSpace.Closeds C)).subscheme ∧
      topologicalKrullDim (Scheme.IdealSheafData.vanishingIdeal
        (⟨closure Z, isClosed_closure⟩ : TopologicalSpace.Closeds C)).subscheme ≤
        ((1 : ℕ) : WithBot ℕ∞) ∧
      ¬ topologicalKrullDim (Scheme.IdealSheafData.vanishingIdeal
        (⟨closure Z, isClosed_closure⟩ : TopologicalSpace.Closeds C)).subscheme ≤
        ((0 : ℕ) : WithBot ℕ∞) := by
    intro Z h1 h2
    have hrZ := hrange Z h1
    have hemb : Topology.IsClosedEmbedding (Scheme.IdealSheafData.vanishingIdeal
        (⟨closure Z, isClosed_closure⟩ : TopologicalSpace.Closeds C)).subschemeι :=
      (Scheme.IdealSheafData.vanishingIdeal
        (⟨closure Z, isClosed_closure⟩ : TopologicalSpace.Closeds C)).subschemeι.isClosedEmbedding
    have hdimeq : topologicalKrullDim (Scheme.IdealSheafData.vanishingIdeal
        (⟨closure Z, isClosed_closure⟩ : TopologicalSpace.Closeds C)).subscheme =
        topologicalKrullDim ↥Z := by
      have h := IsHomeomorph.topologicalKrullDim_eq _ hemb.isEmbedding.toHomeomorph.isHomeomorph
      rw [hrZ] at h
      exact h
    have hirrR : IsIrreducible (Set.range (Scheme.IdealSheafData.vanishingIdeal
        (⟨closure Z, isClosed_closure⟩ : TopologicalSpace.Closeds C)).subschemeι) := by
      rw [hrZ]; exact h1.prop
    haveI : IrreducibleSpace ↥(Set.range (Scheme.IdealSheafData.vanishingIdeal
        (⟨closure Z, isClosed_closure⟩ : TopologicalSpace.Closeds C)).subschemeι) :=
      Subtype.irreducibleSpace hirrR
    have e := hemb.isEmbedding.toHomeomorph
    refine ⟨Function.Surjective.irreducibleSpace e.symm.continuous e.symm.surjective, ?_, ?_, ?_⟩
    · obtain ⟨z, hz⟩ := h1.prop.nonempty
      rw [← hrZ] at hz
      obtain ⟨p, _⟩ := hz
      exact ⟨p⟩
    · rw [hdimeq]
      exact (topologicalKrullDim_subspace_le _ _).trans hdim
    · rw [hdimeq]
      exact h2

  obtain ⟨hs1a, hs1b⟩ := wc_pcrb_curve_components_top C hdim

  have hKum := fun (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of Ω)) => wc_et_kummer_ses_gen Ω Y fY M hMΩ
  have hNorm := wc_et_normal_curve_h2_card_gen Ω M hMΩ hKum (by
    intro Y fY _ _ hn hd U _ hU hfU ord hord
    exact wc_curve_divisor_degree_point_congr_gen Ω Y fY hn hd U hU hfU M hMΩ ord hord)
  have hcard := wc_et_curve_h2_card_reduction_gen Ω M hM hMΩ hPBC hNorm C fC hdim
  obtain ⟨eC⟩ := wc_et_zmodext_coh_equiv C M 2
  have hcardC : Nat.card (wcEtZModExt C M 2) = M ^ Nat.card (wcCompIdx C) := by
    rw [Nat.card_congr eC, hcard, hs1a, ← Nat.card_coe_set_eq]
    rfl
  haveI hfinC : Finite (wcEtZModExt C M 2) :=
    Nat.finite_of_card_ne_zero (by rw [hcardC]; exact pow_ne_zero _ hM)

  let e := Finite.equivFin (wcCompIdx C)
  have hPj : ∀ j, Finite (wcEtZModExt (Scheme.IdealSheafData.vanishingIdeal
        (⟨closure (e.symm j).1, isClosed_closure⟩ : TopologicalSpace.Closeds C)).subscheme M 2) ∧
      Nat.card (wcEtZModExt (Scheme.IdealSheafData.vanishingIdeal
        (⟨closure (e.symm j).1, isClosed_closure⟩ : TopologicalSpace.Closeds C)).subscheme M 2) = M := by
    intro j
    obtain ⟨hirr, -, hd1, hd0⟩ := hsub (e.symm j).1 (e.symm j).2.1 (e.symm j).2.2
    haveI := hirr
    exact wc_pow_curve_h2_irreducible_card Ω _
      ((Scheme.IdealSheafData.vanishingIdeal
        (⟨closure (e.symm j).1, isClosed_closure⟩ : TopologicalSpace.Closeds C)).subschemeι ≫ fC)
      M hM hMΩ hd1 hd0 hPBC
  have hcardP : Nat.card (∀ j, wcEtZModExt (Scheme.IdealSheafData.vanishingIdeal
        (⟨closure (e.symm j).1, isClosed_closure⟩ : TopologicalSpace.Closeds C)).subscheme M 2) =
      M ^ Nat.card (wcCompIdx C) := by
    rw [Nat.card_pi, Finset.prod_congr rfl (fun j _ => (hPj j).2), Finset.prod_const,
      Finset.card_univ, Fintype.card_fin]

  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing C M)) := HasExt.standard _
  haveI : Limits.HasFiniteBiproducts (SheafOfModules.{u+1} (wcEtZModRing C M)) :=
    Abelian.hasFiniteBiproducts
  let G : Fin (Nat.card (wcCompIdx C)) → SheafOfModules.{u+1} (wcEtZModRing C M) :=
    fun j => wcEtSuppObj (D (e.symm j).1)
  let uu : ∀ j, SheafOfModules.unit (wcEtZModRing C M) ⟶ G j :=
    fun j => wcEtSuppUnitMap (D (e.symm j).1)

  have hker : ∀ x : Abelian.Ext (SheafOfModules.unit (wcEtZModRing C M))
      (Limits.kernel (Limits.biproduct.lift uu)) 3, x = 0 :=
    (wc_pcrb_module_ext_vanish Ω C fC M hM hMΩ hdim
      (Limits.kernel (Limits.biproduct.lift uu))).1 3 (by norm_num)

  let s : Finset (Fin (Nat.card (wcCompIdx C)) × Fin (Nat.card (wcCompIdx C))) :=
    Finset.univ.filter (fun p => p.1 ≠ p.2)
  let A : Fin (Nat.card (wcCompIdx C)) × Fin (Nat.card (wcCompIdx C)) → Set C :=
    fun p => (e.symm p.1).1 ∩ (e.symm p.2).1
  have hAc : ∀ p ∈ s, IsClosed (A p) := fun p _ =>
    (isClosed_of_mem_irreducibleComponents _ (e.symm p.1).2.1).inter
      (isClosed_of_mem_irreducibleComponents _ (e.symm p.2).2.1)
  have hTc : IsClosed (⋃ p ∈ s, A p) := isClosed_biUnion_finset hAc
  have hTd : topologicalKrullDim ↥(⋃ p ∈ s, A p) < ((1 : ℕ) : WithBot ℕ∞) :=
    wc_dim_finite_union_closed_lt C s A 1 hAc (fun p hp =>
      hs1b _ _ (e.symm p.1).2.1 (e.symm p.2).2.1
        (fun h => (Finset.mem_filter.mp hp).2 (e.symm.injective (Subtype.ext h))))

  have hstalk : ∀ b : C, b ∉ (⋃ p ∈ s, A p) →
      Subsingleton ((wcEtStalk C b).obj ((SheafOfModules.toSheaf (wcEtZModRing C M)).obj
        (Limits.cokernel (Limits.biproduct.lift uu)))) := by
    intro b hb
    haveI hpc := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.smallEtaleTopology C)
      (wcEtZModRing C M)
    haveI : (SheafOfModules.toSheaf (wcEtZModRing C M)).PreservesEpimorphisms :=
      preservesEpimorphisms_of_preservesColimitsOfShape _
    have hsurj : Function.Surjective ((SheafOfModules.toSheaf (wcEtZModRing C M) ⋙
        wcEtStalk C b).map (Limits.biproduct.lift uu)).hom := by
      apply wc_pcrb_additive_biproduct_lift_surj G _ uu
        (SheafOfModules.toSheaf (wcEtZModRing C M) ⋙ wcEtStalk C b)
      · intro j
        haveI := wc_et_supp_unit_epi _ (D (e.symm j).1)
        exact wc_pcrb_et_stalk_surj_of_epi ((SheafOfModules.toSheaf (wcEtZModRing C M)).map (uu j))
          inferInstance b
      · intro j j' hjj'
        by_cases hj : b ∈ (e.symm j).1
        · right
          have hj' : b ∉ (e.symm j').1 := fun hj' =>
            hb (Set.mem_iUnion₂.mpr ⟨(j, j'), Finset.mem_filter.mpr ⟨Finset.mem_univ _, hjj'⟩,
              ⟨hj, hj'⟩⟩)
          exact wc_pcrb_supp_obj_stalk_vanish _ M (D (e.symm j').1) b
            (by rw [hrange _ (e.symm j').2.1]; exact hj')
        · left
          exact wc_pcrb_supp_obj_stalk_vanish _ M (D (e.symm j).1) b
            (by rw [hrange _ (e.symm j).2.1]; exact hj)
    haveI hcs := wc_r2gc_stalk_coker_subsingleton _ _
      ((SheafOfModules.toSheaf (wcEtZModRing C M)).map (Limits.biproduct.lift uu)) b hsurj
    exact ((wcEtStalk C b).mapIso (Limits.PreservesCokernel.iso
      (SheafOfModules.toSheaf (wcEtZModRing C M)) (Limits.biproduct.lift uu))).addCommGroupIsoToAddEquiv.toEquiv.subsingleton

  have hcok : ∀ x : Abelian.Ext (SheafOfModules.unit (wcEtZModRing C M))
      (Limits.cokernel (Limits.biproduct.lift uu)) 2, x = 0 :=
    (wc_pcrb_module_ext_vanish Ω C fC M hM hMΩ hdim
      (Limits.cokernel (Limits.biproduct.lift uu))).2 _ hTc hTd hstalk 2 (by norm_num)

  have h2 : ∀ j, ∃ Tm : wcEtZModExt (Scheme.IdealSheafData.vanishingIdeal
        (⟨closure (e.symm j).1, isClosed_closure⟩ : TopologicalSpace.Closeds C)).subscheme M 2 →
        Abelian.Ext (SheafOfModules.unit (wcEtZModRing C M)) (G j) 2,
      Function.Injective Tm ∧ ∀ y : wcEtZModExt C M 2,
        Tm (wcEtPull (D (e.symm j).1) 2 y) = y.comp (Abelian.Ext.mk₀ (uu j)) (add_zero 2) :=
    fun j => wc_pcrb_pull_supp_transfer _ M (D (e.symm j).1) 2
  choose Tm hTinj hTcomp using h2
  have hsurjR : Function.Surjective
      (fun y : wcEtZModExt C M 2 => fun j => wcEtPull (D (e.symm j).1) 2 y) := by
    intro w
    obtain ⟨y, hy⟩ := wc_pcrb_ext_two_lift_of_ker_coker _ G uu hker hcok (fun j => Tm j (w j))
    refine ⟨y, funext fun j => hTinj j ?_⟩
    show Tm j (wcEtPull (D (e.symm j).1) 2 y) = Tm j (w j)
    rw [hTcomp j y]
    exact hy j

  have hbij := Function.Surjective.bijective_of_nat_card_le hsurjR (by rw [hcardC, hcardP])

  refine ⟨fun y hy => ?_, fun w => ?_⟩
  · apply hbij.1
    funext j
    show wcEtPull (D (e.symm j).1) 2 y = wcEtPull (D (e.symm j).1) 2 0
    rw [map_zero]
    exact hy _ (e.symm j).2.1 (e.symm j).2.2
  · obtain ⟨y, hy⟩ := hsurjR (fun j => w (e.symm j).1)
    refine ⟨y, fun Z h1 h2 => ?_⟩
    have key : ∀ i : wcCompIdx C, wcEtPull (D i.1) 2 y = w i.1 := by
      intro i
      obtain ⟨j, rfl⟩ := e.symm.surjective i
      exact congrFun hy j
    exact key ⟨Z, h1, h2⟩

theorem wc_pow_curve_h2_ptorsion_le : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : Scheme.{u}) (fW : W ⟶ Spec (.of Ω)) [IsProper fW] [IrreducibleSpace W] (M : ℕ), M ≠ 0 → (M : Ω) ≠ 0 → topologicalKrullDim W ≤ ((1 : ℕ) : WithBot ℕ∞) → Finite (wcEtZModExt W M 2) → ∀ p : ℕ, p.Prime → p ∣ M → Nat.card {x : wcEtZModExt W M 2 // p • x = 0} ≤ p :=
by
  intro Ω _ _ W fW _ _ M hM hMΩ hdim hfinG p hp hpM
  classical
  haveI := hfinG
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing W M)) := HasExt.standard _
  obtain ⟨α, _, _, hR⟩ := wc_et_zmod_ring_locbij W M

  have T : ∀ N : SheafOfModules.{u+1} (wcEtZModRing W M), M • 𝟙 N = 0 := by
    intro N
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro V
    ext s
    have h0 : ((0 : N ⟶ N).val.app V).hom s = 0 := by
      first
        | rfl
        | simp
        | (rw [SheafOfModules.zero_val]; rfl)
    have hz : ∀ k : ℕ, ((k • 𝟙 N).val.app V).hom s = k • s := by
      intro k
      induction k with
      | zero => rw [zero_nsmul, zero_nsmul]; exact h0
      | succ k ih =>
        rw [succ_nsmul, SheafOfModules.add_val, PresheafOfModules.add_app, ModuleCat.hom_add,
          LinearMap.add_apply, ih, succ_nsmul]
        rfl
    rw [hz, ← Nat.cast_smul_eq_nsmul (R := ↑((wcEtZModRing W M).obj.obj V)), hR V,
      zero_smul, h0]

  have s2 : ∀ {X Z : SheafOfModules.{u+1} (wcEtZModRing W M)} {k : ℕ}
      (x : Abelian.Ext X Z k) (n : ℕ), x.comp (Abelian.Ext.mk₀ (n • 𝟙 Z)) (add_zero k) = n • x := by
    intro X Z k x n
    induction n with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    | succ n ih =>
      rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih,
        Abelian.Ext.comp_mk₀_id]

  have s6 : ∀ (G A : Type (u+2)) [AddCommGroup G] [AddCommGroup A] [Finite G] [Finite A]
      (φ : G →+ A), Nat.card A ≤ p → (∀ x : G, φ x = 0 → ∃ y : G, x = p • y) →
      Nat.card {x : G // p • x = 0} ≤ p := by
    intro G A _ _ _ _ φ hA hker
    let ν : G →+ G := nsmulAddMonoidHom p
    have h1 : Nat.card G = Nat.card ν.range * Nat.card ν.ker := by
      rw [AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup ν.ker,
        Nat.card_congr (QuotientAddGroup.quotientKerEquivRange ν).toEquiv]
    have h2 : Nat.card G = Nat.card φ.range * Nat.card φ.ker := by
      rw [AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup φ.ker,
        Nat.card_congr (QuotientAddGroup.quotientKerEquivRange φ).toEquiv]
    have h3 : φ.ker ≤ ν.range := by
      intro x hx
      obtain ⟨y, hy⟩ := hker x (AddMonoidHom.mem_ker.mp hx)
      exact AddMonoidHom.mem_range.mpr ⟨y, hy.symm⟩
    have h4 : Nat.card φ.ker ≤ Nat.card ν.range := AddSubgroup.card_le_of_le h3
    have h5 : Nat.card φ.range ≤ p :=
      (Nat.card_le_card_of_injective Subtype.val Subtype.val_injective).trans hA
    have h6 : 0 < Nat.card ν.range := Nat.card_pos
    have h7 : Nat.card ν.range * Nat.card ν.ker ≤ Nat.card ν.range * p := by
      rw [← h1, h2, mul_comm (Nat.card ν.range) p]
      exact Nat.mul_le_mul h5 h4
    have h8 : Nat.card ν.ker ≤ p := Nat.le_of_mul_le_mul_left h7 h6
    have e : {x : G // p • x = 0} ≃ ν.ker :=
      Equiv.subtypeEquivRight (fun x => (AddMonoidHom.mem_ker (f := ν)).symm)
    rw [Nat.card_congr e]
    exact h8
  have hn : 0 < M := Nat.pos_of_ne_zero hM
  have hpΩ : (p : Ω) ≠ 0 := by
    intro h
    apply hMΩ
    obtain ⟨k, hk⟩ := hpM
    rw [hk, Nat.cast_mul, h, zero_mul]
  haveI hpres : Limits.PreservesFiniteColimits
      (SheafOfModules.toSheaf.{u+1} (wcEtZModRing W M)) :=
    sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.smallEtaleTopology W) _

  have s3 : ∀ {G H : SheafOfModules.{u+1} (wcEtZModRing W M)} (g : G ⟶ H) (N : ℕ),
      (∀ e : Abelian.Ext (SheafOfModules.unit (wcEtZModRing W M)) (Limits.kernel g) (N + 1),
        e = 0) →
      ∀ x : Abelian.Ext (SheafOfModules.unit (wcEtZModRing W M)) H N,
      x.comp (Abelian.Ext.mk₀ (Limits.cokernel.π g)) (add_zero N) = 0 →
      ∃ y : Abelian.Ext (SheafOfModules.unit (wcEtZModRing W M)) G N,
        x = y.comp (Abelian.Ext.mk₀ g) (add_zero N) := by
    intro G H g N hK x hx
    let S₁ : ShortComplex (SheafOfModules.{u+1} (wcEtZModRing W M)) :=
      ShortComplex.mk (Abelian.image.ι g) (Limits.cokernel.π g) (Limits.kernel.condition _)
    have hS₁ : S₁.ShortExact :=
      ShortComplex.ShortExact.mk' (S₁.exact_of_f_is_kernel (Limits.kernelIsKernel _))
        (by dsimp [S₁]; infer_instance) (by dsimp [S₁]; infer_instance)
    have w : Limits.kernel.ι g ≫ Abelian.factorThruImage g = 0 := by
      rw [← cancel_mono (Abelian.image.ι g), Category.assoc, Abelian.image.fac,
        Limits.kernel.condition, Limits.zero_comp]
    let S₂ : ShortComplex (SheafOfModules.{u+1} (wcEtZModRing W M)) :=
      ShortComplex.mk (Limits.kernel.ι g) (Abelian.factorThruImage g) w
    have hS₂ : S₂.ShortExact :=
      ShortComplex.ShortExact.mk'
        (S₂.exact_of_f_is_kernel
          (Limits.isKernelOfComp (Abelian.image.ι g) g (Limits.kernelIsKernel g) w
            (Abelian.image.fac g)))
        (by dsimp [S₂]; infer_instance) (by dsimp [S₂]; infer_instance)
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hS₁ x hx
    obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₃ _ hS₂ x₁ rfl (hK _)
    refine ⟨y, ?_⟩
    rw [← hx₁, ← hy]
    rw [Abelian.Ext.comp_assoc y (Abelian.Ext.mk₀ S₂.g) (Abelian.Ext.mk₀ S₁.f) (add_zero N)
      (add_zero 0) (by omega)]
    rw [Abelian.Ext.mk₀_comp_mk₀]
    dsimp [S₁, S₂]
    rw [Abelian.image.fac]

  have hK : ∀ e : Abelian.Ext (SheafOfModules.unit (wcEtZModRing W M))
      (Limits.kernel (p • 𝟙 (SheafOfModules.unit (wcEtZModRing W M)))) (2 + 1),
      e = 0 := by
    intro e
    obtain ⟨E⟩ := wc_et_zmod_modext_toSheaf_equiv W M hn
      (Limits.kernel (p • 𝟙 (SheafOfModules.unit (wcEtZModRing W M)))) (2 + 1)
    have htor : M • 𝟙 ((SheafOfModules.toSheaf (wcEtZModRing W M)).obj
        (Limits.kernel (p • 𝟙 (SheafOfModules.unit (wcEtZModRing W M))))) = 0 := by
      rw [← (SheafOfModules.toSheaf (wcEtZModRing W M)).map_id, ← Functor.map_nsmul, T,
        Functor.map_zero]
    have hv := wc_et_cd_proper_torsion Ω W fW 1 hdim M hMΩ _ htor (2 + 1) (by omega)
    apply E.injective
    rw [hv (E e), hv (E 0)]

  have hker : ∀ x : wcEtZModExt W M 2,
      (Abelian.Ext.mk₀ (Limits.cokernel.π
        (p • 𝟙 (SheafOfModules.unit (wcEtZModRing W M))))).postcomp
        (SheafOfModules.unit (wcEtZModRing W M)) (add_zero 2) x = 0 →
      ∃ y : wcEtZModExt W M 2, x = p • y := by
    intro x hx
    obtain ⟨y, hy⟩ := s3 (p • 𝟙 (SheafOfModules.unit (wcEtZModRing W M))) 2 hK x hx
    exact ⟨y, hy.trans (s2 y p)⟩

  letI : HasExt (Sheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}) := HasExt.standard _
  have s4 : ∀ {A B : Sheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}} (e : A ≅ B) (n : ℕ),
      Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) A n ≃
      Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) B n := fun {A B} e n =>
    { toFun := fun x => x.comp (Abelian.Ext.mk₀ e.hom) (add_zero n)
      invFun := fun y => y.comp (Abelian.Ext.mk₀ e.inv) (add_zero n)
      left_inv := fun x => by
        simp only
        rw [Abelian.Ext.comp_assoc x (Abelian.Ext.mk₀ e.hom) (Abelian.Ext.mk₀ e.inv) (add_zero n)
          (add_zero 0) (by omega), Abelian.Ext.mk₀_comp_mk₀, e.hom_inv_id,
          Abelian.Ext.comp_mk₀_id]
      right_inv := fun y => by
        simp only
        rw [Abelian.Ext.comp_assoc y (Abelian.Ext.mk₀ e.inv) (Abelian.Ext.mk₀ e.hom) (add_zero n)
          (add_zero 0) (by omega), Abelian.Ext.mk₀_comp_mk₀, e.inv_hom_id,
          Abelian.Ext.comp_mk₀_id] }
  obtain ⟨E1⟩ := wc_et_zmod_modext_toSheaf_equiv W M hn
    (Limits.cokernel (p • 𝟙 (SheafOfModules.unit (wcEtZModRing W M)))) 2
  obtain ⟨e7⟩ := wc_et_zmod_unit_toSheaf_iso W M

  have e8 : Nonempty (Limits.cokernel (p • 𝟙 ((SheafOfModules.toSheaf (wcEtZModRing W M)).obj
        (SheafOfModules.unit (wcEtZModRing W M)))) ≅
      (constantSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod p)))) := by
    have hd : p ∣ M := hpM
    haveI : NeZero M := ⟨hM⟩
    let c : ULift.{u+1} (ZMod M) →+ ULift.{u+1} (ZMod p) :=
      (AddEquiv.ulift.symm : ZMod p ≃+ ULift.{u+1} (ZMod p)).toAddMonoidHom.comp
        (((ZMod.castHom hd (ZMod p)).toAddMonoidHom).comp
          (AddEquiv.ulift : ULift.{u+1} (ZMod M) ≃+ ZMod M).toAddMonoidHom)
    have hc_apply : ∀ x, (c x).down = ZMod.castHom hd (ZMod p) x.down := fun x => rfl
    have hc : Function.Surjective c := by
      intro z
      obtain ⟨w, hw⟩ := ZMod.castHom_surjective hd z.down
      exact ⟨⟨w⟩, ULift.ext _ _ (by rw [hc_apply]; exact hw)⟩
    have hS : (AddCommGrpCat.Hom.hom
        (p • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod M))))).range = c.ker := by
      ext x
      rw [AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id, AddMonoidHom.mem_range,
        AddMonoidHom.mem_ker]
      constructor
      · rintro ⟨y, rfl⟩
        apply ULift.ext
        rw [hc_apply]
        show ZMod.castHom hd (ZMod p) (p • y.down) = 0
        rw [map_nsmul, nsmul_eq_mul, ZMod.natCast_self, zero_mul]
      · intro hx
        have hx' : ZMod.castHom hd (ZMod p) x.down = 0 := by
          rw [← hc_apply, hx]
          rfl
        rw [← ZMod.natCast_zmod_val x.down, map_natCast] at hx'
        obtain ⟨j, hj⟩ := (ZMod.natCast_eq_zero_iff _ p).mp hx'
        refine ⟨⟨(j : ZMod M)⟩, ?_⟩
        rw [AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply]
        apply ULift.ext
        show p • (j : ZMod M) = x.down
        rw [nsmul_eq_mul, ← Nat.cast_mul, ← hj, ZMod.natCast_zmod_val]
    let E := (QuotientAddGroup.quotientAddEquivOfEq hS).trans
      (QuotientAddGroup.quotientKerEquivOfSurjective c hc)
    let iso4 : Limits.cokernel (p • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod M)))) ≅
        AddCommGrpCat.of (ULift.{u+1} (ZMod p)) :=
      AddCommGrpCat.cokernelIsoQuotient _ ≪≫ E.toAddCommGrpIso
    have w : (p • 𝟙 ((SheafOfModules.toSheaf (wcEtZModRing W M)).obj
        (SheafOfModules.unit (wcEtZModRing W M)))) ≫ e7.hom = e7.hom ≫ (p • 𝟙 _) := by
      rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp, Category.comp_id]
    have h : p • 𝟙 ((constantSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod M)))) =
        (constantSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}).map
          (p • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod M)))) := by
      rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
    exact ⟨Limits.cokernel.mapIso _ _ e7 e7 w ≪≫ Limits.cokernelIsoOfEq h ≪≫
      (Limits.PreservesCokernel.iso
        (constantSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}) _).symm ≪≫
      (constantSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}).mapIso iso4⟩
  obtain ⟨e8⟩ := e8
  have hmap : (SheafOfModules.toSheaf (wcEtZModRing W M)).map
      (p • 𝟙 (SheafOfModules.unit (wcEtZModRing W M))) = p • 𝟙 _ := by
    rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
  have E2 := s4 (Limits.PreservesCokernel.iso (SheafOfModules.toSheaf (wcEtZModRing W M))
      (p • 𝟙 (SheafOfModules.unit (wcEtZModRing W M))) ≪≫
    Limits.cokernelIsoOfEq hmap ≪≫ e8) 2
  have Etot : Abelian.Ext (SheafOfModules.unit (wcEtZModRing W M))
      (Limits.cokernel (p • 𝟙 (SheafOfModules.unit (wcEtZModRing W M)))) 2 ≃
      wcEtCoh W p 2 := E1.trans (E2.trans (Equiv.refl _))
  obtain ⟨hfin, hcard⟩ := wc_et_curve_top_coh_card_le Ω W fW hdim p hp hpΩ
  haveI : Finite (Abelian.Ext (SheafOfModules.unit (wcEtZModRing W M))
      (Limits.cokernel (p • 𝟙 (SheafOfModules.unit (wcEtZModRing W M)))) 2) :=
    Finite.of_equiv _ Etot.symm
  have hA : Nat.card (Abelian.Ext (SheafOfModules.unit (wcEtZModRing W M))
      (Limits.cokernel (p • 𝟙 (SheafOfModules.unit (wcEtZModRing W M)))) 2) ≤ p :=
    (Nat.card_congr Etot).trans_le hcard
  exact s6 _ _ _ hA hker

theorem wc_semilinear_iso_base_iso : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W W' : Scheme.{u}) (fW : W ⟶ Spec (.of Ω)) (fW' : W' ⟶ Spec (.of Ω)) [LocallyOfFiniteType fW] [LocallyOfFiniteType fW'] [Nonempty W'] (α : W' ⟶ W) [IsIso α] (ρ : Spec (.of Ω) ⟶ Spec (.of Ω)), α ≫ fW = fW' ≫ ρ → IsIso ρ :=
by
  have lft_section : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [LocallyOfFiniteType f], Nonempty Y → ∃ y₀ : Spec (.of K) ⟶ Y, y₀ ≫ f = 𝟙 _ := by
    intro K _ _ Y f _ hY
    obtain ⟨y⟩ := hY
    obtain ⟨V, hV, hyV, -⟩ := exists_isAffineOpen_mem_and_subset (x := y) (U := ⊤) trivial
    have e : V ≤ f ⁻¹ᵁ ⊤ := by rw [Scheme.Hom.preimage_top]; exact le_top
    have hφ := Scheme.Hom.finiteType_appLE f (isAffineOpen_top _) hV e
    have : Nonempty V := ⟨⟨y, hyV⟩⟩
    have : Nontrivial Γ(Y, V) := Scheme.component_nontrivial Y V
    obtain ⟨m, hm⟩ := Ideal.exists_maximal Γ(Y, V)
    letI : Field (Γ(Y, V) ⧸ m) := Ideal.Quotient.field m
    let π : Γ(Y, V) →+* Γ(Y, V) ⧸ m := Ideal.Quotient.mk m
    let ι : K →+* Γ(Spec (.of K), ⊤) := (Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom
    have hι : Function.Surjective ι := by
      intro x
      refine ⟨(Scheme.ΓSpecIso (CommRingCat.of K)).hom.hom x, ?_⟩
      show ((Scheme.ΓSpecIso (CommRingCat.of K)).hom ≫ (Scheme.ΓSpecIso (CommRingCat.of K)).inv).hom x = x
      rw [Iso.hom_inv_id]; rfl
    let χ : K →+* Γ(Y, V) ⧸ m := π.comp ((f.appLE ⊤ V e).hom.comp ι)
    have hχ : χ.FiniteType :=
      (RingHom.FiniteType.of_surjective π Ideal.Quotient.mk_surjective).comp
        (hφ.comp (RingHom.FiniteType.of_surjective ι hι))
    letI : Algebra K (Γ(Y, V) ⧸ m) := χ.toAlgebra
    have : Algebra.FiniteType K (Γ(Y, V) ⧸ m) := hχ
    have : Module.Finite K (Γ(Y, V) ⧸ m) := finite_of_finite_type_of_isJacobsonRing K _
    have : Algebra.IsIntegral K (Γ(Y, V) ⧸ m) := Algebra.IsIntegral.of_finite K _
    have hbij : Function.Bijective χ := IsAlgClosed.algebraMap_bijective_of_isIntegral
    let ρ : Γ(Y, V) ⟶ CommRingCat.of K :=
      CommRingCat.ofHom ((RingEquiv.ofBijective χ hbij).symm.toRingHom.comp π)
    have key : (Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ f.appLE ⊤ V e ≫ ρ = 𝟙 _ := by
      ext k
      exact (RingEquiv.ofBijective χ hbij).symm_apply_apply k
    refine ⟨Spec.map ρ ≫ hV.fromSpec, ?_⟩
    rw [Category.assoc, ← IsAffineOpen.SpecMap_appLE_fromSpec f (isAffineOpen_top _) hV e,
      IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv, ← Spec.map_comp, ← Spec.map_comp,
      Category.assoc, key, Spec.map_id]
  intro Ω _ _ W W' fW fW' _ _ _ α _ ρ h
  haveI : Nonempty W := ⟨α.base (Classical.arbitrary W')⟩
  obtain ⟨x₀, hx₀⟩ := lft_section Ω W fW ‹Nonempty W›
  set t : Spec (.of Ω) ⟶ Spec (.of Ω) := x₀ ≫ inv α ≫ fW' with ht
  have htρ : t ≫ ρ = 𝟙 _ := by
    rw [ht, Category.assoc, Category.assoc, ← h, IsIso.inv_hom_id_assoc, hx₀]
  have hφψ : Spec.preimage ρ ≫ Spec.preimage t = 𝟙 _ := by
    apply Spec.map_injective
    rw [Spec.map_comp, Spec.map_preimage, Spec.map_preimage, htρ, Spec.map_id]
  have hsurj : Function.Surjective (Spec.preimage t).hom := by
    intro x
    refine ⟨(Spec.preimage ρ).hom x, ?_⟩
    have := congrArg (fun g => g.hom x) hφψ
    simpa using this
  have hinj : Function.Injective (Spec.preimage t).hom := (Spec.preimage t).hom.injective
  let E : Ω ≃+* Ω := RingEquiv.ofBijective (Spec.preimage t).hom ⟨hinj, hsurj⟩
  haveI hψ : IsIso (Spec.preimage t) := by
    have hE : Spec.preimage t = (RingEquiv.toCommRingCatIso E).hom := by
      ext x
      rfl
    rw [hE]
    infer_instance
  haveI : IsIso t := by
    rw [← Spec.map_preimage t]
    infer_instance
  haveI : IsIso (t ≫ ρ) := by
    rw [htρ]
    infer_instance
  exact IsIso.of_isIso_comp_left t ρ

theorem wc_pow_curve_normalization_lift : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : Scheme.{u}) (fW : W ⟶ Spec (.of Ω)) [IsProper fW] [IrreducibleSpace W], topologicalKrullDim W ≤ ((1 : ℕ) : WithBot ℕ∞) → ¬ topologicalKrullDim W ≤ ((0 : ℕ) : WithBot ℕ∞) → ∃ (R : Scheme.{u}) (r : R ⟶ W) (X : Scheme.{u}) (b : X ⟶ R) (Z : Scheme.{u}) (iZ : Z ⟶ R), IsClosedImmersion r ∧ Set.range r = Set.univ ∧ IrreducibleSpace R ∧ topologicalKrullDim R ≤ ((1 : ℕ) : WithBot ℕ∞) ∧ ¬ topologicalKrullDim R ≤ ((0 : ℕ) : WithBot ℕ∞) ∧ IsFinite b ∧ IsClosedImmersion iZ ∧ topologicalKrullDim Z ≤ ((0 : ℕ) : WithBot ℕ∞) ∧ (∀ U : R.Opens, (U : Set R) = (Set.range iZ)ᶜ → IsIso (b ∣_ U)) ∧ IrreducibleSpace X ∧ (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) ∧ topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) ∧ ∀ (τ : W ⟶ W), IsIso τ → ∃ (τR : R ⟶ R) (τX : X ⟶ X), IsIso τR ∧ IsIso τX ∧ τR ≫ r = r ≫ τ ∧ τX ≫ b = b ≫ τR :=
by

  have L1 : ∀ {R W : Scheme.{u}} (r : R ⟶ W) [IsClosedImmersion r] [IsReduced R],
      Set.range r = Set.univ → ∀ (τ : W ⟶ W), IsIso τ → ∃ τR : R ⟶ R, IsIso τR ∧ τR ≫ r = r ≫ τ := by
    intro R W r _ _ hrr τ hτ
    have hker : ∀ {Y : Scheme.{u}} (f : R ⟶ Y) [QuasiCompact f],
        f.ker = Scheme.IdealSheafData.vanishingIdeal ⟨closure (Set.range f), isClosed_closure⟩ := by
      intro Y f _
      have hrad : f.ker.radical = f.ker := by
        apply Scheme.IdealSheafData.ext
        funext U
        rw [Scheme.IdealSheafData.radical_ideal, Scheme.Hom.ker_apply]
        apply le_antisymm _ Ideal.le_radical
