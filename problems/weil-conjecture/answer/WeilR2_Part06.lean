          ((Abelian.Ext.mk₀ D1.μ.hom).comp y (zero_add c)) h := by
    intro a c h x y
    rw [hpull a x,
      Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ D1.μ.inv) ((Abelian.Ext.mapExactFunctor D1.Φ x).comp
        (Abelian.Ext.mk₀ D1.μ.hom) (add_zero a)) y (zero_add a) h (show 0 + a + c = m by omega),
      ← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ D1.μ.hom) (Abelian.Ext.mk₀ D1.μ.inv) _
        (add_zero 0) (zero_add m) (show 0 + 0 + m = m by omega),
      Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp,
      Abelian.Ext.comp_assoc (Abelian.Ext.mapExactFunctor D1.Φ x) (Abelian.Ext.mk₀ D1.μ.hom) y
        (add_zero a) (zero_add c) (show a + 0 + c = m by omega)]
  let τ : wcEtZModExt (Limits.pullback f f) ℓ m →+
      Abelian.Ext (D1.Φ.obj (SheafOfModules.unit (wcEtZModRing Y ℓ)))
        (SheafOfModules.unit (wcEtZModRing (Limits.pullback f f) ℓ)) m :=
    AddMonoidHom.mk' (fun z => (Abelian.Ext.mk₀ D1.μ.hom).comp z (zero_add m))
      (fun z w => Abelian.Ext.comp_add _ _ _ _)
  have hτ : ∀ z, τ z = (Abelian.Ext.mk₀ D1.μ.hom).comp z (zero_add m) := fun _ => rfl
  let σh : Abelian.Ext (D1.Φ.obj (SheafOfModules.unit (wcEtZModRing Y ℓ)))
        (SheafOfModules.unit (wcEtZModRing (Limits.pullback f f) ℓ)) m →+
      wcEtZModExt (Limits.pullback f f) ℓ m :=
    AddMonoidHom.mk' (fun w => (Abelian.Ext.mk₀ D1.μ.inv).comp w (zero_add m))
      (fun z w => Abelian.Ext.comp_add _ _ _ _)
  have hσ : ∀ w, σh w = (Abelian.Ext.mk₀ D1.μ.inv).comp w (zero_add m) := fun _ => rfl
  have hστ : ∀ z : wcEtZModExt (Limits.pullback f f) ℓ m,
      (Abelian.Ext.mk₀ D1.μ.inv).comp ((Abelian.Ext.mk₀ D1.μ.hom).comp z (zero_add m))
        (zero_add m) = z := by
    intro z
    rw [← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ D1.μ.inv) (Abelian.Ext.mk₀ D1.μ.hom) z
      (add_zero 0) (zero_add m) (show 0 + 0 + m = m by omega), Abelian.Ext.mk₀_comp_mk₀,
      Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
  refine ⟨?_, ?_⟩
  ·
    rw [eq_top_iff]
    intro z _
    have e : z = σh (τ z) := (hστ z).symm
    rw [e]
    have hmem := eq_top_iff.mp hSp (AddSubgroup.mem_top (τ z))
    generalize τ z = w at hmem ⊢
    refine AddSubgroup.closure_induction (fun w hw => ?_) ?_ (fun w₁ w₂ _ _ h₁ h₂ => ?_)
      (fun w _ h₁ => ?_) hmem
    · obtain ⟨a, n, h, i, x, rfl⟩ := hw
      rw [hσ, hgE n i, ← hstar a n h x (wcEtPull D2 n (b n i)), hστ]
      exact AddSubgroup.subset_closure ⟨a, n, h, x, b n i, rfl⟩
    · rw [map_zero]
      exact zero_mem _
    · rw [map_add]
      exact add_mem h₁ h₂
    · rw [map_neg]
      exact neg_mem h₁
  ·
    intro n β
    obtain ⟨κ', hκ'⟩ := hUP (wcEtZModExt Y ℓ n) (fun a c h i => (β a c h).flip (b c i))
    refine ⟨κ'.comp τ, ?_⟩
    intro a c h x b'
    obtain ⟨k, hk, -⟩ := hb c b'
    rw [hk]
    simp only [map_sum, map_nsmul]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    congr 1
    rw [AddMonoidHom.comp_apply, hτ, hcup, hstar, ← hgE c i]
    exact hκ' a c h i x

theorem wc_et_zmod_graded_comm : ∀ (S : Scheme.{u}) (n i j k : ℕ) (hk : i + j = k) (hk' : j + i = k) (x : wcEtZModExt S n i) (y : wcEtZModExt S n j), wcEtZModCup S n i j k hk x y = ((-1 : ℤ) ^ (i * j)) • wcEtZModCup S n j i k hk' y x :=
by
  classical
  intro S n i j k hk hk' x y

  have gen : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
      [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
      (R0 : Cᵒᵖ ⥤ CommRingCat.{u+1}) (hR : Presheaf.IsSheaf J (R0 ⋙ forget₂ CommRingCat RingCat)),
      ∃ Tns : SheafOfModules.{u+1} (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1}) ⥤
          SheafOfModules.{u+1} (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1}) ⥤
          SheafOfModules.{u+1} (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1}),
        (∀ K, (Tns.obj K).Additive ∧ Limits.PreservesFiniteColimits (Tns.obj K)) ∧
        (∀ N, (Tns.flip.obj N).Additive ∧ Limits.PreservesFiniteColimits (Tns.flip.obj N)) ∧
        Nonempty (Tns ≅ Tns.flip) ∧
        Nonempty (Tns.obj (SheafOfModules.unit
          (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1})) ≅ 𝟭 _) ∧
        ∀ N, ∃ (P : SheafOfModules.{u+1}
            (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1})) (π : P ⟶ N),
          Epi π ∧ Limits.PreservesFiniteLimits (Tns.obj P) := by
    intro C _ J _ _ R0 hR
    have hflat : ∀ M : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat),
        ∃ (F : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat)) (e : F ⟶ M),
          Epi e ∧ Limits.PreservesFiniteLimits (MonoidalCategory.tensorLeft F) := by
      intro M
      obtain ⟨F, L, i, e, -, hsurj, hF⟩ := wcst_flat_presentation R0 M
      obtain ⟨h1, h2⟩ := wcst_tensorLeft_rightExact R0 F
      exact ⟨F, e, PresheafOfModules.epi_of_surjective (fun X => hsurj X),
        @wcst_tensorLeft_flat_leftExact _ _ R0 F h1 h2 hF⟩
    obtain ⟨a, ι, adj, hcounit, hιadd, haadd, hafl, ⟨eU⟩, star⟩ :
        ∃ (a : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat) ⥤
            SheafOfModules.{u+1} (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1}))
          (ι : SheafOfModules.{u+1} (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1}) ⥤
            PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat))
          (adj : a ⊣ ι), IsIso adj.counit ∧ ι.Additive ∧ a.Additive ∧ Limits.PreservesFiniteLimits a ∧
          Nonempty (ι.obj (SheafOfModules.unit
              (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1})) ≅
            MonoidalCategoryStruct.tensorUnit (PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat))) ∧
          ∀ (M : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat))
            {P₁ P₂ : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat)} (φ : P₁ ⟶ P₂),
            IsIso (a.map φ) → IsIso (a.map (MonoidalCategoryStruct.whiskerLeft M φ)) := by
      haveI hιA : (SheafOfModules.forget.{u+1}
          (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1}) ⋙
          PresheafOfModules.restrictScalars (𝟙 (R0 ⋙ forget₂ CommRingCat RingCat))).Additive :=
        (fun (R : Sheaf J RingCat.{u+1}) => (inferInstance :
          (SheafOfModules.forget.{u+1} R ⋙ PresheafOfModules.restrictScalars.{u+1} (𝟙 R.obj)).Additive)) _
      refine ⟨_, _, PresheafOfModules.sheafificationAdjunction (𝟙 (R0 ⋙ forget₂ CommRingCat RingCat)),
        inferInstance, hιA, (PresheafOfModules.sheafificationAdjunction _).left_adjoint_additive,
        inferInstance, ⟨Iso.refl _⟩, ?_⟩
      intro M P₁ P₂ φ hφ
      have h := (wcst_sheafification_isIso_iff J
        (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1}) φ).1 hφ
      obtain ⟨F, L, i, e, hex, hsurj, hF⟩ := wcst_flat_presentation R0 M
      have hL := wcst_whiskerLeft_locallySurjective J R0 L φ h.2
      have hFi := wcst_whiskerLeft_locallyInjective_of_flat J R0 F φ hF h.1
      have hMi := wcst_whiskerLeft_locallyInjective_of_presentation J R0 i e hex hsurj φ hL hFi
      have hMs := wcst_whiskerLeft_locallySurjective J R0 M φ h.2
      exact (wcst_sheafification_isIso_iff J
        (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1})
        (MonoidalCategoryStruct.whiskerLeft M φ)).2 ⟨hMi, hMs⟩
    haveI := hcounit
    haveI := hιadd
    haveI := haadd
    haveI := hafl
    haveI : Limits.PreservesLimitsOfSize.{0, 0} ι := adj.rightAdjoint_preservesLimits
    haveI : Limits.PreservesColimitsOfSize.{0, 0} a := adj.leftAdjoint_preservesColimits
    haveI : a.IsLeftAdjoint := ⟨_, ⟨adj⟩⟩
    have starR : ∀ (M : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat))
        {P₁ P₂ : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat)} (φ : P₁ ⟶ P₂),
        IsIso (a.map φ) → IsIso (a.map (MonoidalCategoryStruct.whiskerRight φ M)) := by
      intro M P₁ P₂ φ hφ
      have e : MonoidalCategoryStruct.whiskerRight φ M = (BraidedCategory.braiding P₁ M).hom ≫
          MonoidalCategoryStruct.whiskerLeft M φ ≫ (BraidedCategory.braiding P₂ M).inv := by
        rw [← BraidedCategory.braiding_naturality_left_assoc, Iso.hom_inv_id, Category.comp_id]
      haveI := star M φ hφ
      rw [e, a.map_comp, a.map_comp]
      infer_instance
    have hTR : ∀ M : PresheafOfModules.{u+1} (R0 ⋙ forget₂ CommRingCat RingCat),
        (MonoidalCategory.tensorRight M).Additive ∧
          Limits.PreservesFiniteColimits (MonoidalCategory.tensorRight M) := by
      intro M
      obtain ⟨h1, h2⟩ := wcst_tensorLeft_rightExact R0 M
      let e : MonoidalCategory.tensorLeft M ≅ MonoidalCategory.tensorRight M :=
        NatIso.ofComponents (fun Y => BraidedCategory.braiding M Y)
          (fun f => BraidedCategory.braiding_naturality_right M f)
      exact ⟨Functor.additive_of_iso e, Limits.preservesFiniteColimits_of_natIso e⟩
    refine ⟨ι ⋙ MonoidalCategory.curriedTensor _ ⋙ (Functor.whiskeringLeft _ _ _).obj ι ⋙
      (Functor.whiskeringRight _ _ _).obj a, ?_, ?_, ⟨?_⟩, ⟨?_⟩, ?_⟩
    · intro K
      obtain ⟨h1, h2⟩ := wcst_tensorLeft_rightExact R0 (ι.obj K)
      haveI := h1
      haveI := h2
      haveI : Limits.PreservesFiniteColimits (ι ⋙ (MonoidalCategory.tensorLeft (ι.obj K) ⋙ a)) :=
        wcst_reflective_preservesFiniteColimits adj _ (fun φ hφ => star (ι.obj K) φ hφ)
      show (ι ⋙ (MonoidalCategory.tensorLeft (ι.obj K) ⋙ a)).Additive ∧
        Limits.PreservesFiniteColimits (ι ⋙ (MonoidalCategory.tensorLeft (ι.obj K) ⋙ a))
      exact ⟨inferInstance, inferInstance⟩
    · intro N
      obtain ⟨h1, h2⟩ := hTR (ι.obj N)
      haveI := h1
      haveI := h2
      haveI : Limits.PreservesFiniteColimits (ι ⋙ (MonoidalCategory.tensorRight (ι.obj N) ⋙ a)) :=
        wcst_reflective_preservesFiniteColimits adj _ (fun φ hφ => starR (ι.obj N) φ hφ)
      show (ι ⋙ (MonoidalCategory.tensorRight (ι.obj N) ⋙ a)).Additive ∧
        Limits.PreservesFiniteColimits (ι ⋙ (MonoidalCategory.tensorRight (ι.obj N) ⋙ a))
      exact ⟨inferInstance, inferInstance⟩
    · refine NatIso.ofComponents (fun K => NatIso.ofComponents
        (fun N => a.mapIso (BraidedCategory.braiding (ι.obj K) (ι.obj N))) ?_) ?_
      · intro N N' g
        show a.map (MonoidalCategoryStruct.whiskerLeft (ι.obj K) (ι.map g)) ≫
            a.map (BraidedCategory.braiding (ι.obj K) (ι.obj N')).hom =
          a.map (BraidedCategory.braiding (ι.obj K) (ι.obj N)).hom ≫
            a.map (MonoidalCategoryStruct.whiskerRight (ι.map g) (ι.obj K))
        rw [← a.map_comp, ← a.map_comp, BraidedCategory.braiding_naturality_right]
      · intro K K' f
        refine NatTrans.ext (funext fun N => ?_)
        show a.map (MonoidalCategoryStruct.whiskerRight (ι.map f) (ι.obj N)) ≫
            a.map (BraidedCategory.braiding (ι.obj K') (ι.obj N)).hom =
          a.map (BraidedCategory.braiding (ι.obj K) (ι.obj N)).hom ≫
            a.map (MonoidalCategoryStruct.whiskerLeft (ι.obj N) (ι.map f))
        rw [← a.map_comp, ← a.map_comp, BraidedCategory.braiding_naturality_left]
    · refine NatIso.ofComponents (fun N => a.mapIso (MonoidalCategory.whiskerRightIso eU (ι.obj N) ≪≫
        MonoidalCategoryStruct.leftUnitor (ι.obj N)) ≪≫ asIso (adj.counit.app N)) ?_
      intro N N' g
      show a.map (MonoidalCategoryStruct.whiskerLeft (ι.obj (SheafOfModules.unit
            (⟨R0 ⋙ forget₂ CommRingCat RingCat, hR⟩ : Sheaf J RingCat.{u+1}))) (ι.map g)) ≫
          (a.map (MonoidalCategoryStruct.whiskerRight eU.hom (ι.obj N') ≫
            (MonoidalCategoryStruct.leftUnitor (ι.obj N')).hom) ≫ adj.counit.app N') =
        (a.map (MonoidalCategoryStruct.whiskerRight eU.hom (ι.obj N) ≫
            (MonoidalCategoryStruct.leftUnitor (ι.obj N)).hom) ≫ adj.counit.app N) ≫ g
      rw [← a.map_comp_assoc, MonoidalCategory.whisker_exchange_assoc,
        MonoidalCategory.leftUnitor_naturality]
      have hn : a.map (ι.map g) ≫ adj.counit.app N' = adj.counit.app N ≫ g :=
        adj.counit_naturality g
      simp only [Functor.map_comp, Category.assoc]
      rw [hn]
    · intro N
      obtain ⟨F, e, he, hFfl⟩ := hflat (ι.obj N)
      haveI := he
      haveI := hFfl
      refine ⟨a.obj F, a.map e ≫ adj.counit.app N, inferInstance, ?_⟩
      have hη : IsIso (a.map (adj.unit.app F)) := by
        have h := adj.left_triangle_components F
        haveI : IsIso (a.map (adj.unit.app F) ≫ adj.counit.app (a.obj F)) := by
          rw [h]
          infer_instance
        exact IsIso.of_isIso_comp_right _ (adj.counit.app (a.obj F))
      let θ : ι ⋙ (MonoidalCategory.tensorLeft F ⋙ a) ≅
          ι ⋙ (MonoidalCategory.tensorLeft (ι.obj (a.obj F)) ⋙ a) :=
        NatIso.ofComponents (fun Y => @asIso _ _ _ _
            (a.map (MonoidalCategoryStruct.whiskerRight (adj.unit.app F) (ι.obj Y)))
            (starR (ι.obj Y) (adj.unit.app F) hη))
          (by
            intro Y Y' g
            show a.map (MonoidalCategoryStruct.whiskerLeft F (ι.map g)) ≫
                a.map (MonoidalCategoryStruct.whiskerRight (adj.unit.app F) (ι.obj Y')) =
              a.map (MonoidalCategoryStruct.whiskerRight (adj.unit.app F) (ι.obj Y)) ≫
                a.map (MonoidalCategoryStruct.whiskerLeft (ι.obj (a.obj F)) (ι.map g))
            rw [← a.map_comp, ← a.map_comp, MonoidalCategory.whisker_exchange]
            rfl)
      haveI : Limits.PreservesFiniteLimits (ι ⋙ (MonoidalCategory.tensorLeft F ⋙ a)) := inferInstance
      haveI : Limits.PreservesFiniteLimits
          (ι ⋙ (MonoidalCategory.tensorLeft (ι.obj (a.obj F)) ⋙ a)) :=
        Limits.preservesFiniteLimits_of_natIso θ
      show Limits.PreservesFiniteLimits (ι ⋙ (MonoidalCategory.tensorLeft (ι.obj (a.obj F)) ⋙ a))
      infer_instance

  have pkg : ∀ (R : Sheaf (Scheme.smallEtaleTopology S) RingCat.{u+1}),
      (∀ (X : (S.Etale)ᵒᵖ) (a b : R.obj.obj X), a * b = b * a) →
      ∃ Tns : SheafOfModules.{u+1} R ⥤ SheafOfModules.{u+1} R ⥤ SheafOfModules.{u+1} R,
        (∀ K, (Tns.obj K).Additive ∧ Limits.PreservesFiniteColimits (Tns.obj K)) ∧
        (∀ N, (Tns.flip.obj N).Additive ∧ Limits.PreservesFiniteColimits (Tns.flip.obj N)) ∧
        Nonempty (Tns ≅ Tns.flip) ∧
        Nonempty (Tns.obj (SheafOfModules.unit R) ≅ 𝟭 _) ∧
        ∀ N, ∃ (P : SheafOfModules.{u+1} R) (π : P ⟶ N),
          Epi π ∧ Limits.PreservesFiniteLimits (Tns.obj P) := by
    intro R hcomm
    obtain ⟨P, hP⟩ := R
    letI inst : ∀ X : (S.Etale)ᵒᵖ, CommRing (P.obj X) := fun X =>
      { (inferInstance : Ring (P.obj X)) with mul_comm := hcomm X }
    let R0 : (S.Etale)ᵒᵖ ⥤ CommRingCat.{u+1} :=
      { obj := fun X => CommRingCat.of (P.obj X)
        map := fun f => CommRingCat.ofHom (P.map f).hom
        map_id := fun X => by
          ext r
          exact congrArg (fun g => (RingCat.Hom.hom g) r) (P.map_id X)
        map_comp := fun f g => by
          ext r
          exact congrArg (fun h => (RingCat.Hom.hom h) r) (P.map_comp f g) }
    exact gen (Scheme.smallEtaleTopology S) R0 hP

  have hcomm : ∀ (X : (S.Etale)ᵒᵖ) (a b : (wcEtZModRing S n).obj.obj X), a * b = b * a := by
    rintro ⟨X⟩ a b
    obtain ⟨α, -, hsurj, -⟩ := wc_et_zmod_ring_locbij S n
    haveI := hsurj
    have hsep : Presheaf.IsSeparated (Scheme.smallEtaleTopology S) (wcEtZModRing S n).obj :=
      Sheaf.isSeparated _
    apply hsep X (Presheaf.imageSieve α a ⊓ Presheaf.imageSieve α b)
      (GrothendieckTopology.intersection_covering _ (Presheaf.imageSieve_mem _ α a)
        (Presheaf.imageSieve_mem _ α b))
    intro Y f hf
    obtain ⟨a', ha'⟩ := hf.1
    obtain ⟨b', hb'⟩ := hf.2
    have hc : a' * b' = b' * a' := @mul_comm (ULift.{u+1} (ZMod n)) _ a' b'
    rw [map_mul, map_mul, ← ha', ← hb', ← map_mul, ← map_mul, hc]

  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S n)) := HasExt.standard _
  have hcentral : ∀ (e : SheafOfModules.unit (wcEtZModRing S n) ⟶ SheafOfModules.unit (wcEtZModRing S n))
      (m : ℕ) (z : wcEtZModExt S n m),
      (Abelian.Ext.mk₀ e).comp z (zero_add m) = z.comp (Abelian.Ext.mk₀ e) (add_zero m) := by
    intro e m z
    have hext : ∃ μ : 𝟭 (SheafOfModules.{u+1} (wcEtZModRing S n)) ⟶
        𝟭 (SheafOfModules.{u+1} (wcEtZModRing S n)),
        μ.app (SheafOfModules.unit (wcEtZModRing S n)) = e := by
      let R := wcEtZModRing S n
      let s := (SheafOfModules.unit R).unitHomEquiv e
      let σ : ∀ X : (S.Etale)ᵒᵖ, R.obj.obj X := fun X => (s.1 X : R.obj.obj X)
      have hσ : ∀ {X Y : (S.Etale)ᵒᵖ} (f : X ⟶ Y), (R.obj.map f).hom (σ X) = σ Y :=
        fun f => PresheafOfModules.sections_property s f
      let L : ∀ (M : SheafOfModules.{u+1} R) (X : (S.Etale)ᵒᵖ), M.val.obj X ⟶ M.val.obj X :=
        fun M X => ModuleCat.ofHom
          { toFun := fun x => σ X • x
            map_add' := fun x y => smul_add _ _ _
            map_smul' := fun r x => by
              simp only [RingHom.id_apply, smul_smul]
              rw [hcomm X] }
      let mM : ∀ M : SheafOfModules.{u+1} R, M ⟶ M := fun M =>
        ⟨PresheafOfModules.Hom.mk (L M) (by
          intro X Y f
          ext x
          show σ Y • (M.val.map f).hom x = (M.val.map f).hom (σ X • x)
          rw [PresheafOfModules.map_smul, hσ])⟩
      refine ⟨{ app := mM, naturality := ?_ }, ?_⟩
      · intro M N g
        apply SheafOfModules.hom_ext
        apply PresheafOfModules.hom_ext
        intro X
        ext x
        show σ X • (g.val.app X).hom x = (g.val.app X).hom (σ X • x)
        exact ((g.val.app X).hom.map_smul _ _).symm
      · apply (SheafOfModules.unit R).unitHomEquiv.injective
        apply PresheafOfModules.sections_ext
        intro X
        rw [SheafOfModules.unitHomEquiv_apply_coe]
        show σ X • (1 : R.obj.obj X) = s.1 X
        rw [smul_eq_mul, mul_one]
    obtain ⟨μ, hμ⟩ := hext
    subst hμ
    have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp z μ
    simp only [Abelian.Ext.id_mapExactFunctor] at h
    exact h.symm

  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing S n)) :=
    sheafOfModules_enoughInjectives _ _
  obtain ⟨Tns, hT1, hT2, ⟨β⟩, ⟨lam⟩, hfl⟩ := pkg (wcEtZModRing S n) hcomm
  haveI i1 : ∀ K, (Tns.obj K).Additive := fun K => (hT1 K).1
  haveI i2 : ∀ K, Limits.PreservesFiniteColimits (Tns.obj K) := fun K => (hT1 K).2
  haveI i3 : ∀ N, (Tns.flip.obj N).Additive := fun N => (hT2 N).1
  haveI i4 : ∀ N, Limits.PreservesFiniteColimits (Tns.flip.obj N) := fun N => (hT2 N).2
  simp only [wcEtZModCup, Abelian.Ext.bilinearComp_apply_apply]
  set U := SheafOfModules.unit (wcEtZModRing S n) with hU
  have hsmulL : ∀ {X Y Z : SheafOfModules.{u+1} (wcEtZModRing S n)} {a b c : ℕ}
      (α : Abelian.Ext X Y a) (γ : Abelian.Ext Y Z b) (h : a + b = c) (m : ℤ),
      (m • α).comp γ h = m • α.comp γ h := by
    intro X Y Z a b c α γ h m
    rw [← Abelian.Ext.bilinearComp_apply_apply, map_zsmul, AddMonoidHom.zsmul_apply,
      Abelian.Ext.bilinearComp_apply_apply]
  have hsmulR : ∀ {X Y Z : SheafOfModules.{u+1} (wcEtZModRing S n)} {a b c : ℕ}
      (α : Abelian.Ext X Y a) (γ : Abelian.Ext Y Z b) (h : a + b = c) (m : ℤ),
      α.comp (m • γ) h = m • α.comp γ h := by
    intro X Y Z a b c α γ h m
    rw [← Abelian.Ext.bilinearComp_apply_apply, map_zsmul, Abelian.Ext.bilinearComp_apply_apply]
  obtain ⟨ρ, hρdef⟩ : ∃ ρ : ∀ K, (Tns.obj K).obj U ≅ K,
      ∀ K, ρ K = (β.app K).app U ≪≫ lam.app K := ⟨_, fun _ => rfl⟩
  have hρ : ∀ {K K' : SheafOfModules.{u+1} (wcEtZModRing S n)} (f : K ⟶ K'),
      (Tns.map f).app U ≫ (ρ K').hom = (ρ K).hom ≫ f := by
    intro K K' f
    have h1 := congrArg (fun t => t.app U) (β.hom.naturality f)
    have h2 := lam.hom.naturality f
    simp only [NatTrans.comp_app, Functor.flip_map_app, Functor.id_map] at h1 h2
    rw [hρdef, hρdef]
    simp only [Iso.trans_hom, Iso.app_hom]
    rw [← Category.assoc, h1, Category.assoc, Category.assoc, h2]
  have hρ' : ∀ {K K' : SheafOfModules.{u+1} (wcEtZModRing S n)} (f : K ⟶ K'),
      (ρ K).inv ≫ (Tns.map f).app U = f ≫ (ρ K').inv := by
    intro K K' f
    rw [Iso.inv_comp_eq, ← Category.assoc, Iso.eq_comp_inv]
    exact hρ f
  have hmk : ∀ {X Y Z W : SheafOfModules.{u+1} (wcEtZModRing S n)} (f : X ⟶ Y) (g : Y ⟶ Z) {m : ℕ}
      (z : Abelian.Ext Z W m),
      (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ g).comp z (zero_add m)) (zero_add m) =
        (Abelian.Ext.mk₀ (f ≫ g)).comp z (zero_add m) := by
    intro X Y Z W f g m z
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
  have hmk' : ∀ {X Y Z W : SheafOfModules.{u+1} (wcEtZModRing S n)} {m : ℕ}
      (z : Abelian.Ext X Y m) (f : Y ⟶ Z) (g : Z ⟶ W),
      (z.comp (Abelian.Ext.mk₀ f) (add_zero m)).comp (Abelian.Ext.mk₀ g) (add_zero m) =
        z.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero m) := by
    intro X Y Z W m z f g
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_third_deg_zero]
  have hA0 : ∀ {X Y Z W : SheafOfModules.{u+1} (wcEtZModRing S n)} {a b c : ℕ} (f : X ⟶ Y)
      (β' : Abelian.Ext Y Z a) (γ : Abelian.Ext Z W b) (h : a + b = c),
      ((Abelian.Ext.mk₀ f).comp β' (zero_add a)).comp γ h =
        (Abelian.Ext.mk₀ f).comp (β'.comp γ h) (zero_add c) := by
    intro X Y Z W a b c f β' γ h
    exact Abelian.Ext.comp_assoc _ _ _ _ _ (by omega)
  haveI hUfl : Limits.PreservesFiniteLimits (Tns.obj U) :=
    Limits.preservesFiniteLimits_of_natIso lam.symm
  have P1 : (Abelian.Ext.mk₀ (ρ U).inv).comp
      ((Abelian.Ext.mapExactFunctor (Tns.obj U) x).comp (Abelian.Ext.mk₀ (ρ U).hom) (add_zero i))
      (zero_add i) = x := by
    have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp x lam.hom
    simp only [Abelian.Ext.id_mapExactFunctor] at h
    have hc := hcentral ((lam.app U).inv ≫ (ρ U).hom) i x
    have hρU : (ρ U).hom = lam.hom.app U ≫ ((lam.app U).inv ≫ (ρ U).hom) := by
      rw [← Category.assoc, ← Iso.app_hom, Iso.hom_inv_id, Category.id_comp]
    conv_lhs => rw [hρU, ← hmk', h, Abelian.Ext.comp_assoc_of_third_deg_zero, ← hc,
      hmk (lam.hom.app U) ((lam.app U).inv ≫ (ρ U).hom) x, ← hρU, hmk, Iso.inv_hom_id,
      Abelian.Ext.mk₀_id_comp]
  have P2 : ∀ (K K' : SheafOfModules.{u+1} (wcEtZModRing S n))
      [Limits.PreservesFiniteLimits (Tns.obj K)] [Limits.PreservesFiniteLimits (Tns.obj K')]
      (f : K ⟶ K'),
      ((Abelian.Ext.mk₀ (ρ K).inv).comp
        ((Abelian.Ext.mapExactFunctor (Tns.obj K) x).comp (Abelian.Ext.mk₀ (ρ K).hom) (add_zero i))
        (zero_add i)).comp (Abelian.Ext.mk₀ f) (add_zero i) =
      (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ (ρ K').inv).comp
        ((Abelian.Ext.mapExactFunctor (Tns.obj K') x).comp (Abelian.Ext.mk₀ (ρ K').hom) (add_zero i))
        (zero_add i)) (zero_add i) := by
    intro K K' _ _ f
    have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp x (Tns.map f)
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, hmk', ← hρ f, ← hmk', h,
      Abelian.Ext.comp_assoc_of_third_deg_zero, hmk, hρ' f, ← hmk]
  have P3 : ∀ {X₁ X₂ X₃ : SheafOfModules.{u+1} (wcEtZModRing S n)} (f : X₁ ⟶ X₂) (g : X₂ ⟶ X₃)
      (hfg : f ≫ g = 0) (hT : (ShortComplex.mk f g hfg).ShortExact)
      [Limits.PreservesFiniteLimits (Tns.obj X₁)] [Limits.PreservesFiniteLimits (Tns.obj X₂)]
      [Limits.PreservesFiniteLimits (Tns.obj X₃)] (m : ℕ) (h₁ : i + 1 = m) (h₂ : 1 + i = m),
      ((Abelian.Ext.mk₀ (ρ X₃).inv).comp
        ((Abelian.Ext.mapExactFunctor (Tns.obj X₃) x).comp (Abelian.Ext.mk₀ (ρ X₃).hom) (add_zero i))
        (zero_add i)).comp hT.extClass h₁ =
      ((-1 : ℤ) ^ i) • hT.extClass.comp ((Abelian.Ext.mk₀ (ρ X₁).inv).comp
        ((Abelian.Ext.mapExactFunctor (Tns.obj X₁) x).comp (Abelian.Ext.mk₀ (ρ X₁).hom) (add_zero i))
        (zero_add i)) h₂ := by
    intro X₁ X₂ X₃ f g hfg hT _ _ _ m h₁ h₂
    have hzero : ∀ N, (Tns.map f).app N ≫ (Tns.map g).app N = 0 := by
      intro N
      rw [← Functor.flip_obj_map, ← Functor.flip_obj_map, ← Functor.map_comp, hfg,
        Functor.map_zero]
    have h5 := tensor_flat_two_of_three Tns ⟨β⟩ hfl (ShortComplex.mk f g hfg) hT
      (show Limits.PreservesFiniteLimits (Tns.obj X₃) from inferInstance)
    have hS : ∀ N, (ShortComplex.mk ((Tns.map f).app N) ((Tns.map g).app N)
        (hzero N)).ShortExact := fun N => h5.1 N
    have hs3 := ext_mapExact_ses_sign (Tns.obj X₁) (Tns.obj X₂) (Tns.obj X₃) (Tns.map f)
      (Tns.map g) hzero hS x h₁ h₂
    have hM : (hS U).extClass.comp (Abelian.Ext.mk₀ (ρ X₁).hom) (add_zero 1) =
        (Abelian.Ext.mk₀ (ρ X₃).hom).comp hT.extClass (zero_add 1) :=
      ShortComplex.ShortExact.extClass_naturality (hS U) hT
        (ShortComplex.homMk (ρ X₁).hom (ρ X₂).hom (ρ X₃).hom (hρ f).symm (hρ g).symm)
    have hN : hT.extClass.comp (Abelian.Ext.mk₀ (ρ X₁).inv) (add_zero 1) =
        (Abelian.Ext.mk₀ (ρ X₃).inv).comp (hS U).extClass (zero_add 1) :=
      ShortComplex.ShortExact.extClass_naturality hT (hS U)
        (ShortComplex.homMk (ρ X₁).inv (ρ X₂).inv (ρ X₃).inv (hρ' f) (hρ' g))
    conv_lhs => rw [hA0, Abelian.Ext.comp_assoc_of_second_deg_zero, ← hM,
      ← Abelian.Ext.comp_assoc_of_third_deg_zero, hs3, hsmulL,
      Abelian.Ext.comp_assoc_of_third_deg_zero, hsmulR, ← hA0, ← hN,
      Abelian.Ext.comp_assoc_of_second_deg_zero]
  have C : ∀ (j : ℕ) (K : SheafOfModules.{u+1} (wcEtZModRing S n))
      [Limits.PreservesFiniteLimits (Tns.obj K)] (z : Abelian.Ext K U j) (m : ℕ)
      (h₁ : i + j = m) (h₂ : j + i = m),
      ((Abelian.Ext.mk₀ (ρ K).inv).comp
        ((Abelian.Ext.mapExactFunctor (Tns.obj K) x).comp (Abelian.Ext.mk₀ (ρ K).hom) (add_zero i))
        (zero_add i)).comp z h₁ = ((-1 : ℤ) ^ (i * j)) • z.comp x h₂ := by
    intro j
    induction j with
    | zero =>
      intro K _ z m h₁ h₂
      obtain ⟨f, rfl⟩ := (Abelian.Ext.mk₀_bijective K U).2 z
      obtain rfl : m = i := by omega
      rw [P2 K U f, P1, mul_zero, pow_zero, one_smul]
    | succ j ih =>
      intro K _ z m h₁ h₂
      obtain ⟨E', π, hπ, hz⟩ := ext_epi_effaces z
      obtain ⟨P, q, hq, hP⟩ := hfl E'
      haveI := hπ
      haveI := hq
      haveI := hP
      have hpz : (Abelian.Ext.mk₀ (q ≫ π)).comp z (zero_add (j + 1)) = 0 := by
        rw [← hmk, hz, Abelian.Ext.comp_zero]
      have hT : (ShortComplex.mk (Limits.kernel.ι (q ≫ π)) (q ≫ π)
          (Limits.kernel.condition _)).ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.kernelSequence_exact (q ≫ π))
          (show Mono (Limits.kernel.ι (q ≫ π)) from inferInstance)
          (show Epi (q ≫ π) from inferInstance)
      have h5 := tensor_flat_two_of_three Tns ⟨β⟩ hfl _ hT
        (show Limits.PreservesFiniteLimits (Tns.obj K) from inferInstance)
      haveI hK' : Limits.PreservesFiniteLimits (Tns.obj (Limits.kernel (q ≫ π))) := h5.2 hP
      obtain ⟨z'', rfl⟩ := Abelian.Ext.contravariant_sequence_exact₃ hT U z hpz
        (show 1 + j = j + 1 by omega)
      rw [← Abelian.Ext.comp_assoc _ hT.extClass z'' (show i + 1 = i + 1 from rfl)
          (show 1 + j = j + 1 by omega) (show i + 1 + j = m by omega),
        P3 _ _ _ hT (i + 1) rfl (by omega), hsmulL,
        Abelian.Ext.comp_assoc hT.extClass _ z'' (show 1 + i = i + 1 by omega)
          (show i + j = j + i by omega) (show 1 + i + j = m by omega),
        ih _ z'' (j + i) (by omega) rfl, hsmulR, smul_smul,
        Abelian.Ext.comp_assoc hT.extClass z'' x (show 1 + j = j + 1 by omega)
          (show j + i = j + i from rfl) (show 1 + j + i = m by omega)]
      have hs : ((-1 : ℤ) ^ i * (-1) ^ (i * j)) = (-1) ^ (i * (j + 1)) := by ring
      rw [hs]
  have hfin := C j U y k hk hk'
  rw [P1] at hfin
  exact hfin

theorem wc_et_modell_slant_exists : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsProper f] (d : ℕ) [SmoothOfRelativeDimension d f] [IrreducibleSpace Y] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (D1 : wcEtPullData (Limits.pullback.fst f f) ℓ) (D2 : wcEtPullData (Limits.pullback.snd f f) ℓ) (ω : wcEtZModExt Y ℓ (2 * d)), ω ≠ 0 → ∃ κ : (n : ℕ) → wcEtZModExt (Limits.pullback f f) ℓ (2 * d + n) →+ wcEtZModExt Y ℓ n, (∀ (i n : ℕ) (v : wcEtZModExt Y ℓ i) (z : wcEtZModExt (Limits.pullback f f) ℓ (2 * d + n)), κ (i + n) (wcEtZModCup (Limits.pullback f f) ℓ i (2 * d + n) (2 * d + (i + n)) (by omega) (wcEtPull D2 i v) z) = wcEtZModCup Y ℓ i n (i + n) rfl v (κ n z)) ∧ (∀ (n a c : ℕ) (h : a + c = 2 * d + n) (x : wcEtZModExt Y ℓ a) (b : wcEtZModExt Y ℓ c), a ≠ 2 * d → κ n (wcEtZModCup (Limits.pullback f f) ℓ a c (2 * d + n) h (wcEtPull D1 a x) (wcEtPull D2 c b)) = 0) ∧ κ 0 (wcEtPull D1 (2 * d) ω) = @Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _ (𝟙 (SheafOfModules.unit (wcEtZModRing Y ℓ))) :=
by
  classical
  intro K _ _ Y f _ d _ _ ℓ _ hℓ D1 D2 ω hω
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _
  have hℓpos : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos

  have hmul : ∀ {S S' : Scheme.{u}} {g : S' ⟶ S} {n : ℕ} (D : wcEtPullData g n) (a b c : ℕ)
      (hc : a + b = c) (x : wcEtZModExt S n a) (y : wcEtZModExt S n b),
      wcEtPull D c (wcEtZModCup S n a b c hc x y) =
        wcEtZModCup S' n a b c hc (wcEtPull D a x) (wcEtPull D b y) := by
    intro S S' g n D a b c hc x y
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S n)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S' n)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    show (Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ (x.comp y hc)).comp (Abelian.Ext.mk₀ D.μ.hom)
          (add_zero c)) (zero_add c) =
      ((Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero a))
        (zero_add a)).comp
      ((Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
        (zero_add b)) hc
    rw [Abelian.Ext.mapExactFunctor_comp]
    have e1 : (Abelian.Ext.mk₀ D.μ.hom).comp ((Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
        (zero_add b)) (zero_add b) =
        (Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b) := by
      rw [← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ D.μ.hom) (Abelian.Ext.mk₀ D.μ.inv)
        ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
        (add_zero 0) (zero_add b) (by omega), Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
        Abelian.Ext.mk₀_id_comp]
    symm
    rw [Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ D.μ.inv)
        ((Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero a))
        ((Abelian.Ext.mk₀ D.μ.inv).comp
          ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
          (zero_add b)) (zero_add a) hc (by omega),
      Abelian.Ext.comp_assoc (Abelian.Ext.mapExactFunctor D.Φ x) (Abelian.Ext.mk₀ D.μ.hom)
        ((Abelian.Ext.mk₀ D.μ.inv).comp
          ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
          (zero_add b)) (add_zero a) (zero_add b) (by omega),
      e1,
      ← Abelian.Ext.comp_assoc (Abelian.Ext.mapExactFunctor D.Φ x)
        (Abelian.Ext.mapExactFunctor D.Φ y) (Abelian.Ext.mk₀ D.μ.hom) hc (add_zero b)
        (by omega)]

  have hone : ∀ {S S' : Scheme.{u}} {g : S' ⟶ S} {n : ℕ} (D : wcEtPullData g n),
      wcEtPull D 0 (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
        (𝟙 (SheafOfModules.unit (wcEtZModRing S n)))) =
        @Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
          (𝟙 (SheafOfModules.unit (wcEtZModRing S' n))) := by
    intro S S' g n D
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S n)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S' n)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    show (Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ
          (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing S n))))).comp
          (Abelian.Ext.mk₀ D.μ.hom) (add_zero 0)) (zero_add 0) =
      Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing S' n)))
    rw [Abelian.Ext.mapExactFunctor_mk₀, CategoryTheory.Functor.map_id, Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.mk₀_comp_mk₀, Category.id_comp, Iso.inv_hom_id]

  have hrunit : ∀ (S : Scheme.{u}) (n m : ℕ) (z : wcEtZModExt S n m),
      wcEtZModCup S n m 0 m rfl z (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
        (𝟙 (SheafOfModules.unit (wcEtZModRing S n)))) = z := by
    intro S n m z
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S n)) := HasExt.standard _
    simp only [wcEtZModCup, Abelian.Ext.bilinearComp_apply_apply]
    exact Abelian.Ext.comp_mk₀_id z

  have hassoc : ∀ (S : Scheme.{u}) (a1 a2 a3 a12 a23 m : ℕ) (h12 : a1 + a2 = a12)
      (h23 : a2 + a3 = a23) (h1 : a12 + a3 = m) (h2 : a1 + a23 = m)
      (x : wcEtZModExt S ℓ a1) (y : wcEtZModExt S ℓ a2) (z : wcEtZModExt S ℓ a3),
      wcEtZModCup S ℓ a12 a3 m h1 (wcEtZModCup S ℓ a1 a2 a12 h12 x y) z =
        wcEtZModCup S ℓ a1 a23 m h2 x (wcEtZModCup S ℓ a2 a3 a23 h23 y z) := by
    intro S a1 a2 a3 a12 a23 m h12 h23 h1 h2 x y z
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S ℓ)) := HasExt.standard _
    simp only [wcEtZModCup, Abelian.Ext.bilinearComp_apply_apply]
    exact Abelian.Ext.comp_assoc x y z h12 h23 (by omega)

  have htors : ∀ (k : ℕ) (y : wcEtZModExt Y ℓ k), ℓ • y = 0 := by
    intro k y
    have h := (wc_et_zmod_unit_pow_exact Y ℓ 1 hℓpos).1
    rw [pow_one] at h
    have hmk : ∀ m : ℕ, Abelian.Ext.mk₀ (m • 𝟙 (SheafOfModules.unit (wcEtZModRing Y ℓ))) =
        m • Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing Y ℓ))) := by
      intro m
      induction m with
      | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero]
      | succ m ih => rw [succ_nsmul, Abelian.Ext.mk₀_add, ih, succ_nsmul]
    have hlin := map_nsmul (Abelian.Ext.bilinearComp (SheafOfModules.unit (wcEtZModRing Y ℓ))
      (SheafOfModules.unit (wcEtZModRing Y ℓ)) (SheafOfModules.unit (wcEtZModRing Y ℓ))
      k 0 k (add_zero _) y) ℓ
      (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing Y ℓ))))
    simp only [Abelian.Ext.bilinearComp_apply_apply] at hlin
    rw [Abelian.Ext.comp_mk₀_id] at hlin
    rw [← hlin, ← hmk, h, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]

  obtain ⟨τ, hτ⟩ : ∃ τ : wcEtZModExt Y ℓ (2 * d) →+ wcEtZModExt Y ℓ 0,
      τ ω = @Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
        (𝟙 (SheafOfModules.unit (wcEtZModRing Y ℓ))) := by
    obtain ⟨instG⟩ : Nonempty (Module (ZMod ℓ) (wcEtZModExt Y ℓ (2 * d))) :=
      ⟨AddCommGroup.zmodModule (htors (2 * d))⟩
    obtain ⟨instH⟩ : Nonempty (Module (ZMod ℓ) (wcEtZModExt Y ℓ 0)) :=
      ⟨AddCommGroup.zmodModule (htors 0)⟩
    haveI hfree : Module.Free (ZMod ℓ) (wcEtZModExt Y ℓ (2 * d)) :=
      Module.Free.of_divisionRing (ZMod ℓ) _
    haveI : Module.Projective (ZMod ℓ) (wcEtZModExt Y ℓ (2 * d)) := Module.Projective.of_free
    obtain ⟨ψ, hψ⟩ : ∃ ψ : wcEtZModExt Y ℓ (2 * d) →ₗ[ZMod ℓ] ZMod ℓ, ψ ω ≠ 0 := by
      by_contra hcon
      push_neg at hcon
      exact hω ((Module.forall_dual_apply_eq_zero_iff (ZMod ℓ) ω).mp (fun φ => hcon φ))
    exact ⟨(LinearMap.smulRight ((ψ ω)⁻¹ • ψ)
      (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
        (𝟙 (SheafOfModules.unit (wcEtZModRing Y ℓ))))).toAddMonoidHom, by
      rw [LinearMap.toAddMonoidHom_coe, LinearMap.smulRight_apply, LinearMap.smul_apply,
        smul_eq_mul, inv_mul_cancel₀ hψ, one_smul]⟩

  obtain ⟨τf, hτf⟩ : ∃ τf : (a : ℕ) → wcEtZModExt Y ℓ a →+ wcEtZModExt Y ℓ 0,
      τf (2 * d) ω = @Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
        (𝟙 (SheafOfModules.unit (wcEtZModRing Y ℓ))) :=
    ⟨fun a => if ha : a = 2 * d then (by subst ha; exact τ) else 0, by
      beta_reduce
      rw [dif_pos rfl]
      exact hτ⟩

  obtain ⟨β, hβ0, hβ2⟩ : ∃ β : (n a c : ℕ) → a + c = 2 * d + n →
      wcEtZModExt Y ℓ a →+ wcEtZModExt Y ℓ c →+ wcEtZModExt Y ℓ n,
      (∀ (n a c : ℕ) (h : a + c = 2 * d + n) (x : wcEtZModExt Y ℓ a) (b : wcEtZModExt Y ℓ c),
        c ≠ n → β n a c h x b = 0) ∧
      (∀ (n a : ℕ) (h : a + n = 2 * d + n) (x : wcEtZModExt Y ℓ a) (b : wcEtZModExt Y ℓ n),
        β n a n h x b = wcEtZModCup Y ℓ n 0 n rfl b (τf a x)) := by
    refine ⟨fun n a c h => if hc : c = n then
      (wcEtZModCup Y ℓ c 0 n (by omega)).flip.comp (τf a) else 0, ?_, ?_⟩
    · intro n a c h x b hc
      beta_reduce
      rw [dif_neg hc]
      rfl
    · intro n a h x b
      beta_reduce
      rw [dif_pos rfl]
      rfl

  choose κ hκ using fun n : ℕ => (wc_et_modell_kunneth K Y f d ℓ hℓ D1 D2 (2 * d + n)).2 n (β n)
  refine ⟨κ, ?_, ?_, ?_⟩
  ·
    intro i n v
    have key : (κ (i + n)).comp (wcEtZModCup (Limits.pullback f f) ℓ i (2 * d + n)
        (2 * d + (i + n)) (by omega) (wcEtPull D2 i v)) =
        (wcEtZModCup Y ℓ i n (i + n) rfl v).comp (κ n) := by
      apply AddMonoidHom.eq_of_eqOn_dense (wc_et_modell_kunneth K Y f d ℓ hℓ D1 D2 (2 * d + n)).1
      rintro z ⟨a, c, h, x, b, rfl⟩
      rw [AddMonoidHom.comp_apply, AddMonoidHom.comp_apply]
      rw [← hassoc (Limits.pullback f f) i a c (i + a) (2 * d + n) (2 * d + (i + n)) rfl h
        (by omega) (by omega) (wcEtPull D2 i v) (wcEtPull D1 a x) (wcEtPull D2 c b)]
      rw [wc_et_zmod_graded_comm (Limits.pullback f f) ℓ i a (i + a) rfl (by omega)
        (wcEtPull D2 i v) (wcEtPull D1 a x)]
      rw [map_zsmul, AddMonoidHom.zsmul_apply]
      rw [hassoc (Limits.pullback f f) a i c (i + a) (i + c) (2 * d + (i + n)) (by omega) rfl
        (by omega) (by omega) (wcEtPull D1 a x) (wcEtPull D2 i v) (wcEtPull D2 c b)]
      rw [← hmul D2 i c (i + c) rfl v b]
      rw [map_zsmul, hκ (i + n) a (i + c) (by omega) x (wcEtZModCup Y ℓ i c (i + c) rfl v b),
        hκ n a c h x b]
      by_cases hc : c = n
      · subst hc
        obtain rfl : a = 2 * d := by omega
        rw [hβ2, hβ2]
        have hs : ((-1 : ℤ) ^ (i * (2 * d))) = 1 := Even.neg_one_pow ⟨i * d, by ring⟩
        rw [hs, one_smul]
        exact hassoc _ _ _ _ _ _ _ _ _ _ _ _ _ _
      · rw [hβ0 (i + n) a (i + c) _ x _ (by omega), hβ0 n a c h x b hc, smul_zero, map_zero]
    intro z
    exact DFunLike.congr_fun key z
  ·
    intro n a c h x b ha
    rw [hκ n a c h x b]
    exact hβ0 n a c h x b (by omega)
  ·
    have h1 := hκ 0 (2 * d) 0 rfl ω (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
      (𝟙 (SheafOfModules.unit (wcEtZModRing Y ℓ))))
    have h2 : wcEtZModCup (Limits.pullback f f) ℓ (2 * d) 0 (2 * d + 0) rfl (wcEtPull D1 (2 * d) ω)
        (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
          (𝟙 (SheafOfModules.unit (wcEtZModRing (Limits.pullback f f) ℓ)))) =
        wcEtPull D1 (2 * d) ω := hrunit _ _ _ _
    rw [hone D2, h2, hβ2, hτf] at h1
    exact h1.trans (hrunit _ _ _ _)

theorem wc_et_point_supp_unit_map_epi_ker : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsSeparated f] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (y₀ : Spec (.of K) ⟶ Y), y₀ ≫ f = 𝟙 _ → ∀ (Dy : wcEtPullData y₀ ℓ), Epi (wcEtSuppUnitMap Dy) ∧ Nonempty ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj (Limits.kernel (wcEtSuppUnitMap Dy)) ≅ wcEtExtZero Y (Set.range y₀)ᶜ ℓ) :=
by
  classical
  intro K _ _ Y f _ ℓ _ y₀ hy₀ Dy
  haveI := Dy.cont
  have hℓ : ℓ.Prime := Fact.out
  haveI : NeZero ℓ := ⟨hℓ.ne_zero⟩

  have s1 : ∀ {A B : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}},
      ℓ • 𝟙 A = 0 → Finite (A ⟶ B) → Nat.card (A ⟶ B) ≤ ℓ → ∀ (α β : A ⟶ B), α ≠ 0 → Epi β →
      Epi α ∧ Nonempty (Limits.kernel α ≅ Limits.kernel β) := by
    intro A B hA hfin hcard α β hα hβ
    have htor : ∀ g : A ⟶ B, ℓ • g = 0 := fun g => by
      rw [← Category.id_comp g, ← Preadditive.nsmul_comp, hA, Limits.zero_comp]
    have hord : addOrderOf α = ℓ := by
      rcases hℓ.eq_one_or_self_of_dvd _ (addOrderOf_dvd_of_nsmul_eq_zero (htor α)) with h | h
      · exact absurd (AddMonoid.addOrderOf_eq_one_iff.mp h) hα
      · exact h
    have htop : AddSubgroup.zmultiples α = ⊤ :=
      AddSubgroup.eq_top_of_le_card _ (by rw [Nat.card_zmultiples, hord]; exact hcard)
    have hmem : β ∈ AddSubgroup.zmultiples α := by rw [htop]; exact AddSubgroup.mem_top _
    obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.mp hmem
    have hβ0 : β ≠ 0 := by
      intro h0
      subst h0
      exact hα ((Limits.IsZero.of_epi_zero A B).eq_of_tgt _ _)
    have hndvd : ¬ (ℓ : ℤ) ∣ k := by
      rintro ⟨k', rfl⟩
      apply hβ0
      rw [← hk, mul_comm, mul_zsmul, natCast_zsmul, htor, zsmul_zero]
    have hcop : IsCoprime k (ℓ : ℤ) := by
      rw [Int.isCoprime_iff_gcd_eq_one]
      have hd : (Int.gcd k ℓ) ∣ ℓ := by
        have := Int.gcd_dvd_right (a := k) (b := (ℓ : ℤ))
        exact Int.natCast_dvd_natCast.mp (by simpa using this)
      rcases hℓ.eq_one_or_self_of_dvd _ hd with h | h
      · exact h
      · exfalso
        apply hndvd
        have := Int.gcd_dvd_left (a := k) (b := (ℓ : ℤ))
        rw [h] at this
        exact this
    obtain ⟨a, b, hab⟩ := hcop
    have hℓA : (ℓ : ℤ) • 𝟙 A = 0 := by rw [natCast_zsmul, hA]
    have hvu : (a • 𝟙 A) ≫ (k • 𝟙 A) = 𝟙 A := by
      simp only [Preadditive.zsmul_comp, Preadditive.comp_zsmul, Category.id_comp, smul_smul]
      have : k * a = 1 - b * ℓ := by linarith
      rw [this, sub_zsmul, one_zsmul, mul_zsmul, hℓA, zsmul_zero]
      simp
    have huv : (k • 𝟙 A) ≫ (a • 𝟙 A) = 𝟙 A := by
      simp only [Preadditive.zsmul_comp, Preadditive.comp_zsmul, Category.id_comp, smul_smul]
      have : a * k = 1 - b * ℓ := by linarith
      rw [this, sub_zsmul, one_zsmul, mul_zsmul, hℓA, zsmul_zero]
      simp
    haveI : IsIso (a • 𝟙 A) := ⟨⟨k • 𝟙 A, hvu, huv⟩⟩
    have hβu : β = (k • 𝟙 A) ≫ α := by
      rw [← hk, Preadditive.zsmul_comp, Category.id_comp]
    have hαv : α = (a • 𝟙 A) ≫ β := by
      rw [hβu, ← Category.assoc, hvu, Category.id_comp]
    refine ⟨?_, ⟨Limits.kernelIsoOfEq hαv ≪≫ Limits.kernelIsIsoComp (a • 𝟙 A) β⟩⟩
    rw [hαv]
    exact epi_comp _ β

  have hT₀ : Limits.IsTerminal (Scheme.Etale.mk (𝟙 Y)) :=
    Limits.IsTerminal.ofUniqueHom
      (fun V => MorphismProperty.Over.homMk V.hom (Category.comp_id _) trivial)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))

  have s2 : ∀ (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}),
      Finite (G.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y)))) →
      Finite ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))) ⟶ G) ∧
      Nat.card ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))) ⟶ G) ≤
        Nat.card (G.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y)))) := by
    intro G hG
    let adj := constantSheafAdj (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} hT₀
    let ev : ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))) ⟶ G) →
        G.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y))) := fun g =>
      (adj.homEquiv (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))) G g).hom (ULift.up 1)
    have hinj : Function.Injective ev := by
      intro g g' h
      apply (adj.homEquiv (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))) G).injective
      ext x
      obtain ⟨z, hz⟩ := ZMod.intCast_surjective x.down
      have hx : x = z • (ULift.up 1 : ULift.{u+1} (ZMod ℓ)) := by
        apply ULift.ext
        change x.down = z • (1 : ZMod ℓ)
        rw [zsmul_one, hz]
      rw [hx, map_zsmul, map_zsmul]
      exact congrArg (fun t => z • t) h
    exact ⟨Finite.of_injective ev hinj, Nat.card_le_card_of_injective ev hinj⟩

  obtain ⟨eLC, -⟩ := wc_et_const_zmod_sections_locallyConstant (Spec (.of K)) ℓ
    (fun V S hS x hx => wc_et_locallyConstant_glue (Spec (.of K)) V S hS ℓ x hx)
  haveI hIso : IsIso (Limits.pullback.snd (𝟙 Y) y₀) := Limits.pullback_snd_iso_of_left_iso _ _
  haveI hUn : Unique (Spec (.of K)) := inferInstanceAs (Unique (PrimeSpectrum K))
  have hpt : ∀ x y : ((wcEtBaseChange y₀).obj (Scheme.Etale.mk (𝟙 Y))).left, x = y := by
    intro x y
    exact (Scheme.Hom.homeomorph (Limits.pullback.snd (𝟙 Y) y₀)).injective (Subsingleton.elim _ _)
  obtain ⟨x₀⟩ : Nonempty ((wcEtBaseChange y₀).obj (Scheme.Etale.mk (𝟙 Y))).left :=
    ⟨(Scheme.Hom.homeomorph (Limits.pullback.snd (𝟙 Y) y₀)).symm default⟩
  let evpt : ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of K))) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))).obj.obj
        (Opposite.op ((wcEtBaseChange y₀).obj (Scheme.Etale.mk (𝟙 Y)))) → ZMod ℓ :=
    fun s => eLC _ s x₀
  have hbij : Function.Bijective evpt := by
    refine ⟨fun s s' h => (eLC _).injective (LocallyConstant.ext fun x => ?_), fun z => ?_⟩
    · rw [hpt x x₀]; exact h
    · refine ⟨(eLC _).symm (LocallyConstant.const _ z), ?_⟩
      simp only [evpt, AddEquiv.apply_symm_apply, LocallyConstant.coe_const, Function.const_apply]
  have hcardpt : Nat.card (((constantSheaf (Scheme.smallEtaleTopology (Spec (.of K)))
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))).obj.obj
        (Opposite.op ((wcEtBaseChange y₀).obj (Scheme.Etale.mk (𝟙 Y))))) = ℓ := by
    rw [Nat.card_eq_of_bijective evpt hbij, Nat.card_zmod]
  haveI hfinpt : Finite (((constantSheaf (Scheme.smallEtaleTopology (Spec (.of K)))
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))).obj.obj
        (Opposite.op ((wcEtBaseChange y₀).obj (Scheme.Etale.mk (𝟙 Y))))) :=
    Finite.of_injective evpt hbij.1
  have hntpt : Nontrivial (((constantSheaf (Scheme.smallEtaleTopology (Spec (.of K)))
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))).obj.obj
        (Opposite.op ((wcEtBaseChange y₀).obj (Scheme.Etale.mk (𝟙 Y))))) :=
    Finite.one_lt_card_iff_nontrivial.mp (by rw [hcardpt]; exact hℓ.one_lt)

  obtain ⟨eY⟩ := wc_et_zmod_unit_toSheaf_iso Y ℓ
  obtain ⟨ept⟩ := wc_et_zmod_unit_toSheaf_iso (Spec (.of K)) ℓ

  let eM : (SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj (wcEtSuppObj Dy) ≅
      ((wcEtBaseChange y₀).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology (Spec (.of K)))).obj
        ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of K))) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) :=
    (Iso.refl _ : (SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj (wcEtSuppObj Dy) ≅
      ((wcEtBaseChange y₀).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology (Spec (.of K)))).obj
        ((SheafOfModules.toSheaf (wcEtZModRing (Spec (.of K)) ℓ)).obj
          (SheafOfModules.unit (wcEtZModRing (Spec (.of K)) ℓ)))) ≪≫
    ((wcEtBaseChange y₀).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology (Spec (.of K)))).mapIso ept

  let α := eY.inv ≫ (SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).map (wcEtSuppUnitMap Dy) ≫ eM.hom
  have hTρeq : (SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).map (wcEtSuppUnitMap Dy) =
      eY.hom ≫ α ≫ eM.inv := by
    simp only [α, Category.assoc, Iso.hom_inv_id, Category.comp_id, Iso.hom_inv_id_assoc]
  have hw : (SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).map (wcEtSuppUnitMap Dy) ≫ eM.hom =
      eY.hom ≫ α := by
    simp only [α, Iso.hom_inv_id_assoc]

  have hρ0 : wcEtSuppUnitMap Dy ≠ 0 := by
    intro h0
    haveI := Dy.additive
    have hμ : Dy.μ.hom = 0 := by
      have h1' : Dy.adj.homEquiv _ _ Dy.μ.hom = 0 := (Dy.adj.homEquiv_unit _ _ _).trans h0
      calc Dy.μ.hom = (Dy.adj.homEquiv _ _).symm (Dy.adj.homEquiv _ _ Dy.μ.hom) :=
            (Equiv.symm_apply_apply _ _).symm
        _ = (Dy.adj.homEquiv _ _).symm 0 := by rw [h1']
        _ = 0 := by rw [Adjunction.homEquiv_counit, Functor.map_zero, Limits.zero_comp]
    have hz : Limits.IsZero (SheafOfModules.unit (wcEtZModRing (Spec (.of K)) ℓ)) := by
      rw [Limits.IsZero.iff_id_eq_zero, ← Dy.μ.inv_hom_id, hμ, Limits.comp_zero]
    have hz2 := (Functor.map_isZero (SheafOfModules.toSheaf _) hz).of_iso ept.symm
    have hz3 := Functor.map_isZero (sheafToPresheaf (Scheme.smallEtaleTopology (Spec (.of K)))
      AddCommGrpCat.{u+1} ⋙ (evaluation _ _).obj
        (Opposite.op ((wcEtBaseChange y₀).obj (Scheme.Etale.mk (𝟙 Y))))) hz2
    obtain ⟨s, s', hss'⟩ := hntpt.exists_pair_ne
    apply hss'
    have hid := (Limits.IsZero.iff_id_eq_zero _).mp hz3
    have e1 := ConcreteCategory.congr_hom hid s
    have e2 := ConcreteCategory.congr_hom hid s'
    simp only [ConcreteCategory.id_apply] at e1 e2
    exact e1.trans e2.symm

  haveI : IsClosedImmersion (y₀ ≫ f) := by rw [hy₀]; infer_instance
  haveI : IsClosedImmersion y₀ := IsClosedImmersion.of_comp y₀ f

  have hloc := wc_etBaseChange_locSurj y₀
    (wc_etale_lift_closed_immersion wc_etale_lift_quotient_alg)
  obtain ⟨c⟩ := wc_closed_coker_pushforward y₀ ℓ hloc
  let γ := Limits.cokernel.π (wcEtExtZeroι Y (Set.range y₀)ᶜ ℓ) ≫ c.hom
  have hγepi : Epi γ := epi_comp _ _

  haveI hιmono : Mono (wcEtExtZeroι Y (Set.range y₀)ᶜ ℓ) := by
    have key : ∀ {P Q : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (g : P ⟶ Q),
        (∀ V, Function.Injective (g.app V).hom) →
        Mono ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map g) := by
      intro P Q g hg
      haveI : ∀ V, Mono (g.app V) := fun V => (AddCommGrpCat.mono_iff_injective _).mpr (hg V)
      haveI : Mono g := NatTrans.mono_of_mono_app g
      infer_instance
    unfold wcEtExtZeroι
    exact key _ (fun V p q h => Subtype.ext h)

  have hκγ : Limits.kernel γ ≅ wcEtExtZero Y (Set.range y₀)ᶜ ℓ :=
    Limits.kernelCompMono _ _ ≪≫
      Limits.IsLimit.conePointUniqueUpToIso (Limits.kernelIsKernel _)
        (Abelian.monoIsKernelOfCokernel _ (Limits.cokernelIsCokernel
          (wcEtExtZeroι Y (Set.range y₀)ᶜ ℓ)))

  have hℓR : ℓ • 𝟙 (SheafOfModules.unit (wcEtZModRing Y ℓ)) = 0 := by
    have h := (wc_et_zmod_unit_pow_exact Y ℓ 1 hℓ.pos).1
    rw [pow_one] at h
    exact h
  have hℓC : ℓ • 𝟙 ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) = 0 := by
    have h1 : ℓ • 𝟙 ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj
        (SheafOfModules.unit (wcEtZModRing Y ℓ))) = 0 := by
      have h2 := congrArg (SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).map hℓR
      rw [Functor.map_nsmul, CategoryTheory.Functor.map_id, Functor.map_zero] at h2
      exact h2
    calc ℓ • 𝟙 ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))
        = eY.inv ≫ (ℓ • 𝟙 ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj
            (SheafOfModules.unit (wcEtZModRing Y ℓ)))) ≫ eY.hom := by
          rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp, eY.inv_hom_id]
      _ = 0 := by rw [h1, Limits.zero_comp, Limits.comp_zero]
  obtain ⟨hfinH, hcardH⟩ := s2 (((wcEtBaseChange y₀).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology (Spec (.of K)))).obj
        ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of K))) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) hfinpt
  have hcardH' := hcardH.trans hcardpt.le
  have hTρ : (SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).map (wcEtSuppUnitMap Dy) ≠ 0 := fun h =>
    hρ0 ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).map_injective
      (h.trans (Functor.map_zero _ _ _).symm))
  have hα0 : α ≠ 0 := by
    intro h
    apply hTρ
    rw [hTρeq, h, Limits.zero_comp, Limits.comp_zero]

  obtain ⟨hαepi, ⟨hκ⟩⟩ := s1 hℓC hfinH hcardH' α γ hα0 hγepi
  refine ⟨?_, ⟨Limits.PreservesKernel.iso (SheafOfModules.toSheaf (wcEtZModRing Y ℓ))
    (wcEtSuppUnitMap Dy) ≪≫ Limits.kernel.mapIso _ α eY eM hw ≪≫ hκ ≪≫ hκγ⟩⟩

  have hE : Epi ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).map (wcEtSuppUnitMap Dy)) := by
    rw [hTρeq]; infer_instance
  haveI := Functor.reflectsEpimorphisms_of_faithful (SheafOfModules.toSheaf (wcEtZModRing Y ℓ))
  exact Functor.epi_of_epi_map (SheafOfModules.toSheaf (wcEtZModRing Y ℓ)) hE

