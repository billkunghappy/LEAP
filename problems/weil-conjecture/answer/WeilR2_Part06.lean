theorem wc_r2gs_geom_components_transitive : ∀ (X B : Scheme.{u}) (g : X ⟶ B) [IsProper g] (U : X.Opens), IrreducibleSpace ↥U → ∀ (η : B), closure ({η} : Set B) = closure (⇑g '' (U : Set X)) → topologicalKrullDim ↥((U : Set X)ᶜ ∩ ⇑g ⁻¹' {η}) ≤ ((0 : ℕ) : WithBot ℕ∞) → ∀ (Z Z' : Set ↥(Limits.pullback g (wcEtGeomPt B η))), Z ∈ irreducibleComponents ↥(Limits.pullback g (wcEtGeomPt B η)) → ¬ topologicalKrullDim ↥Z ≤ ((0 : ℕ) : WithBot ℕ∞) → Z' ∈ irreducibleComponents ↥(Limits.pullback g (wcEtGeomPt B η)) → ¬ topologicalKrullDim ↥Z' ≤ ((0 : ℕ) : WithBot ℕ∞) → ∃ (τ : Spec (.of (AlgebraicClosure (B.residueField η))) ⟶ Spec (.of (AlgebraicClosure (B.residueField η)))) (hτ : τ ≫ wcEtGeomPt B η = wcEtGeomPt B η), Function.Injective ⇑(Limits.pullback.map g (wcEtGeomPt B η) g (wcEtGeomPt B η) (𝟙 X) τ (𝟙 B) (by simp) (by rw [Category.comp_id, hτ])) ∧ ⇑(Limits.pullback.map g (wcEtGeomPt B η) g (wcEtGeomPt B η) (𝟙 X) τ (𝟙 B) (by simp) (by rw [Category.comp_id, hτ])) '' Z = Z' :=
by
  classical

  have hL6 : ∀ (X B : Type u) [TopologicalSpace X] [TopologicalSpace B] [QuasiSober X] [T0Space B]
      (g : X → B), Continuous g → ∀ (U : Set X), IsOpen U → IsIrreducible U → ∀ η : B,
      closure ({η} : Set B) = closure (g '' U) →
      ∃ ξ : X, ξ ∈ U ∧ U ⊆ closure ({ξ} : Set X) ∧ g ξ = η := by
    intro X B _ _ _ _ g hg U hUo hU η h
    have hcl : closure ({hU.genericPoint} : Set X) = closure U :=
      isGenericPoint_def.mp hU.isGenericPoint_genericPoint_closure
    have hUsub : U ⊆ closure {hU.genericPoint} := hcl ▸ subset_closure
    have hξU : hU.genericPoint ∈ U := by
      by_contra hn
      obtain ⟨x, hx⟩ := hU.nonempty
      have : closure ({hU.genericPoint} : Set X) ⊆ Uᶜ :=
        closure_minimal (Set.singleton_subset_iff.mpr hn) hUo.isClosed_compl
      exact this (hUsub hx) hx
    refine ⟨hU.genericPoint, hξU, hUsub, ?_⟩
    apply Inseparable.eq
    rw [inseparable_iff_closure_eq]
    apply le_antisymm
    · apply closure_minimal _ isClosed_closure
      rw [Set.singleton_subset_iff, h]
      exact subset_closure ⟨_, hξU, rfl⟩
    · rw [h]
      apply closure_minimal _ isClosed_closure
      calc g '' U ⊆ g '' closure {hU.genericPoint} := Set.image_mono hUsub
        _ ⊆ closure (g '' {hU.genericPoint}) := image_closure_subset_closure_image hg
        _ = closure {g hU.genericPoint} := by rw [Set.image_singleton]

  have hL3 : ∀ (P X : Type u) [TopologicalSpace P] [QuasiSober P] [T0Space P] [TopologicalSpace X]
      [T0Space X] (p : P → X), Continuous p → (∀ z z' : P, z ⤳ z' → p z = p z' → z = z') →
      ∀ (F : Set X), (∀ z : P, p z ∈ F) →
      (∀ (z : P) (x : X), x ∈ F → x ⤳ p z → ∃ z' : P, z' ⤳ z ∧ p z' = x) →
      ∀ (U : Set X), IsOpen U → ∀ ξ : X, ξ ∈ F → U ⊆ closure ({ξ} : Set X) →
      topologicalKrullDim ↥(Uᶜ ∩ F) ≤ ((0 : ℕ) : WithBot ℕ∞) → ∀ (Z : Set P),
      Z ∈ irreducibleComponents P → ¬ topologicalKrullDim ↥Z ≤ ((0 : ℕ) : WithBot ℕ∞) →
      ∃ ζ : P, closure ({ζ} : Set P) = Z ∧ p ζ = ξ := by
    intro P X _ _ _ _ _ p hp hinc F hF hgd U hUo ξ hξF hUξ hdim Z hZ hZd
    have hZm : Maximal IsIrreducible Z := hZ
    have hZirr : IsIrreducible Z := hZm.prop
    have hZc : IsClosed Z := isClosed_of_mem_irreducibleComponents Z hZ
    have hζ : closure ({hZirr.genericPoint} : Set P) = Z := by
      rw [isGenericPoint_def.mp hZirr.isGenericPoint_genericPoint_closure, hZc.closure_eq]
    have dim0 : ∀ (T : Type u) [TopologicalSpace T] [T0Space T],
        topologicalKrullDim T ≤ ((0 : ℕ) : WithBot ℕ∞) → ∀ a b : T, a ⤳ b → a = b := by
      intro T _ _ hT a b hab
      have hT' : Order.krullDim (TopologicalSpace.IrreducibleCloseds T) ≤ 0 := by
        simpa [topologicalKrullDim] using hT
      rw [Order.krullDim_nonpos_iff_forall_isMax] at hT'
      let A : TopologicalSpace.IrreducibleCloseds T :=
        ⟨closure {a}, isIrreducible_singleton.closure, isClosed_closure⟩
      let Bc : TopologicalSpace.IrreducibleCloseds T :=
        ⟨closure {b}, isIrreducible_singleton.closure, isClosed_closure⟩
      have hle : Bc ≤ A := by
        show closure {b} ⊆ closure {a}
        exact specializes_iff_closure_subset.mp hab
      have hge : A ≤ Bc := hT' Bc hle
      have hba : b ⤳ a := specializes_iff_closure_subset.mpr hge
      exact (hab.antisymm hba).eq
    have hsecond : ∃ z ∈ Z, z ≠ hZirr.genericPoint := by
      by_contra hcon
      push_neg at hcon
      apply hZd
      have hsub : ∀ a b : ↥Z, a = b := fun a b =>
        Subtype.ext ((hcon a a.2).trans (hcon b b.2).symm)
      have : Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥Z) ≤ 0 := by
        rw [Order.krullDim_nonpos_iff_forall_isMax]
        intro s t _
        show (t : Set ↥Z) ⊆ s
        intro x _
        obtain ⟨y, hy⟩ := s.isIrreducible.nonempty
        rw [hsub x y]
        exact hy
      simpa [topologicalKrullDim] using this
    obtain ⟨z, hzZ, hzne⟩ := hsecond
    have hζz : hZirr.genericPoint ⤳ z := specializes_iff_mem_closure.mpr (by rw [hζ]; exact hzZ)
    have hpne : p hZirr.genericPoint ≠ p z := fun h => hzne (hinc _ z hζz h).symm
    have hpp : p hZirr.genericPoint ⤳ p z := hζz.map hp
    by_cases hU : p hZirr.genericPoint ∈ U
    · obtain ⟨ζ', hζ'ζ, hpζ'⟩ := hgd hZirr.genericPoint ξ hξF
        (specializes_iff_mem_closure.mpr (hUξ hU))
      have hZle : Z ⊆ closure {ζ'} := by
        rw [← hζ]
        exact closure_minimal (Set.singleton_subset_iff.mpr (specializes_iff_mem_closure.mp hζ'ζ))
          isClosed_closure
      have hZeq : Z = closure {ζ'} := hZm.eq_of_le isIrreducible_singleton.closure hZle
      have hζ'Z : ζ' ∈ Z := by rw [hZeq]; exact subset_closure rfl
      have hζζ' : hZirr.genericPoint ⤳ ζ' :=
        specializes_iff_mem_closure.mpr (by rw [hζ]; exact hζ'Z)
      have heq : hZirr.genericPoint = ζ' := (hζζ'.antisymm hζ'ζ).eq
      exact ⟨hZirr.genericPoint, hζ, heq ▸ hpζ'⟩
    · exfalso
      have hzU : p z ∉ U := fun h => hU (hpp.mem_open hUo h)
      let a : ↥(Uᶜ ∩ F) := ⟨p hZirr.genericPoint, hU, hF _⟩
      let b : ↥(Uᶜ ∩ F) := ⟨p z, hzU, hF z⟩
      have hab : a ⤳ b := (Topology.IsInducing.subtypeVal.specializes_iff (x := a) (y := b)).mp hpp
      exact hpne (congrArg Subtype.val (dim0 _ hdim a b hab))

  have hL4 : ∀ (κ Ω : Type u) [Field κ] [Field Ω] (j₁ j₂ : AlgebraicClosure κ →+* Ω),
      j₁.comp (algebraMap κ (AlgebraicClosure κ)) = j₂.comp (algebraMap κ (AlgebraicClosure κ)) →
      ∃ σ : AlgebraicClosure κ ≃ₐ[κ] AlgebraicClosure κ,
        j₁.comp (σ : AlgebraicClosure κ →+* AlgebraicClosure κ) = j₂ := by
    intro κ Ω _ _ j₁ j₂ hcomp
    have hrange : ∀ a : AlgebraicClosure κ, ∃ b, j₁ b = j₂ a := by
      intro a
      have hai : IsIntegral κ a := Algebra.IsIntegral.isIntegral a
      have hf0 : minpoly κ a ≠ 0 := minpoly.ne_zero hai
      have hf'0 : (minpoly κ a).map (algebraMap κ (AlgebraicClosure κ)) ≠ 0 :=
        Polynomial.map_ne_zero hf0
      have hspl := IsAlgClosed.splits ((minpoly κ a).map (algebraMap κ (AlgebraicClosure κ)))
      have hmap : ((minpoly κ a).map (algebraMap κ (AlgebraicClosure κ))).map j₁ =
          ((minpoly κ a).map (algebraMap κ (AlgebraicClosure κ))).map j₂ := by
        rw [Polynomial.map_map, Polynomial.map_map, hcomp]
      have hroot : (((minpoly κ a).map (algebraMap κ (AlgebraicClosure κ))).map j₁).IsRoot
          (j₂ a) := by
        rw [hmap, Polynomial.IsRoot, Polynomial.eval_map_apply, Polynomial.eval_map_algebraMap,
          minpoly.aeval, map_zero]
      obtain ⟨b, hb⟩ := Polynomial.Splits.mem_range_of_isRoot hspl hf'0 hroot
      exact ⟨b, hb⟩
    choose s hs using hrange
    have hj₁ : Function.Injective j₁ := j₁.injective
    let σ₀ : AlgebraicClosure κ →ₐ[κ] AlgebraicClosure κ :=
      { toFun := s
        map_one' := hj₁ (by rw [hs, map_one, map_one])
        map_mul' := fun x y => hj₁ (by rw [hs, map_mul, map_mul, hs, hs])
        map_zero' := hj₁ (by rw [hs, map_zero, map_zero])
        map_add' := fun x y => hj₁ (by rw [hs, map_add, map_add, hs, hs])
        commutes' := fun c => hj₁ (by rw [hs]; exact (RingHom.congr_fun hcomp c).symm) }
    have hbij : Function.Bijective σ₀ := Algebra.IsAlgebraic.algHom_bijective σ₀
    refine ⟨AlgEquiv.ofBijective σ₀ hbij, ?_⟩
    exact RingHom.ext fun a => hs a

  have hL2 : ∀ (Y X : Scheme.{u}) (f : Y ⟶ X), IsIntegralHom f → ∀ (x x' : Y), x ⤳ x' →
      f x = f x' → x = x' := by
    intro Y X f hfI x x' hxx' hfx
    haveI := hfI
    obtain ⟨V, hV, hyV, -⟩ :=
      exists_isAffineOpen_mem_and_subset (X := X) (x := f x') (U := ⊤) trivial
    have hU : IsAffineOpen (f ⁻¹ᵁ V) := hV.preimage f
    have hx'U : x' ∈ f ⁻¹ᵁ V := hyV
    have hxU : x ∈ f ⁻¹ᵁ V := hxx'.mem_open (f ⁻¹ᵁ V).isOpen hx'U
    have hcomm := IsAffineOpen.SpecMap_appLE_fromSpec f hV hU le_rfl
    have hpt : ∀ p, f (hU.fromSpec p) =
        hV.fromSpec (Spec.map (f.appLE V (f ⁻¹ᵁ V) le_rfl) p) := by
      intro p
      have := congrArg (fun g => g p) hcomm
      simp only [Scheme.Hom.comp_apply] at this
      exact this.symm
    obtain ⟨p, hp⟩ : x ∈ Set.range hU.fromSpec := by rw [hU.range_fromSpec]; exact hxU
    obtain ⟨p', hp'⟩ : x' ∈ Set.range hU.fromSpec := by rw [hU.range_fromSpec]; exact hx'U
    have hpp' : p ⤳ p' := by
      rw [← hU.fromSpec.isOpenEmbedding.isInducing.specializes_iff, hp, hp']; exact hxx'
    have hle : p.asIdeal ≤ p'.asIdeal := (PrimeSpectrum.le_iff_specializes p p').mpr hpp'
    have heq : Spec.map (f.appLE V (f ⁻¹ᵁ V) le_rfl) p =
        Spec.map (f.appLE V (f ⁻¹ᵁ V) le_rfl) p' := by
      apply hV.fromSpec.isOpenEmbedding.injective
      rw [← hpt, ← hpt, hp, hp', hfx]
    rw [Spec.map_apply, Spec.map_apply] at heq
    have heqI : Ideal.comap (f.appLE V (f ⁻¹ᵁ V) le_rfl).hom p.asIdeal =
        Ideal.comap (f.appLE V (f ⁻¹ᵁ V) le_rfl).hom p'.asIdeal :=
      congrArg PrimeSpectrum.asIdeal heq
    have hint : (f.appLE V (f ⁻¹ᵁ V) le_rfl).hom.IsIntegral := by
      rw [Scheme.Hom.appLE_eq_app]
      exact IsIntegralHom.isIntegral_app f V hV
    suffices hpe : p = p' by rw [← hp, ← hp', hpe]
    by_contra hne
    have hlt : p.asIdeal < p'.asIdeal := lt_of_le_of_ne hle (fun h => hne (PrimeSpectrum.ext h))
    letI := (f.appLE V (f ⁻¹ᵁ V) le_rfl).hom.toAlgebra
    haveI : Algebra.IsIntegral Γ(X, V) Γ(Y, f ⁻¹ᵁ V) := ⟨hint⟩
    haveI := p.isPrime
    have := Ideal.IsIntegral.under_lt_under (R := Γ(X, V)) hlt
    rw [Ideal.under_def, Ideal.under_def] at this
    exact this.ne heqI

  have hL1gen : ∀ (X B T W : Scheme.{u}) (g : X ⟶ B) (j : T ⟶ B) (π : W ⟶ T),
      IsIntegralHom π → Flat π →
      ∃ (q : Limits.pullback g (π ≫ j) ⟶ Limits.pullback g j),
        q ≫ Limits.pullback.fst g j = Limits.pullback.fst g (π ≫ j) ∧ IsIntegralHom q ∧
          Flat q := by
    intro X B T W g j π hπI hπF
    haveI hb1 : IsIntegralHom (Limits.pullback.fst (Limits.pullback.snd g j) π) :=
      MorphismProperty.of_isPullback (P := @IsIntegralHom) (IsPullback.of_hasPullback _ _).flip hπI
    haveI hb2 : Flat (Limits.pullback.fst (Limits.pullback.snd g j) π) :=
      MorphismProperty.of_isPullback (P := @Flat) (IsPullback.of_hasPullback _ _).flip hπF
    refine ⟨(Limits.pullbackLeftPullbackSndIso g j π).inv ≫
        Limits.pullback.fst (Limits.pullback.snd g j) π, ?_, inferInstance, inferInstance⟩
    rw [Category.assoc]
    exact Limits.pullbackLeftPullbackSndIso_inv_fst _ _ _
  have hL1 : ∀ (X B : Scheme.{u}) (g : X ⟶ B) (η : B)
      (ηb : Spec (.of (AlgebraicClosure (B.residueField η))) ⟶ B),
      ηb = Spec.map (CommRingCat.ofHom (algebraMap (B.residueField η)
        (AlgebraicClosure (B.residueField η)))) ≫ B.fromSpecResidueField η →
      ∃ (Y : Scheme.{u}) (q : Limits.pullback g ηb ⟶ Y) (ι : Y ⟶ X),
        q ≫ ι = Limits.pullback.fst g ηb ∧ IsIntegralHom q ∧ Flat q ∧
        Topology.IsEmbedding ⇑ι ∧ Set.range ⇑ι = ⇑g ⁻¹' {η} := by
    intro X B g η ηb hηb
    subst hηb
    have hiI : IsIntegralHom (Spec.map (CommRingCat.ofHom (algebraMap (B.residueField η)
        (AlgebraicClosure (B.residueField η))))) := by
      rw [IsIntegralHom.SpecMap_iff, CommRingCat.hom_ofHom]
      intro x
      exact Algebra.IsIntegral.isIntegral x
    have hiF : Flat (Spec.map (CommRingCat.ofHom (algebraMap (B.residueField η)
        (AlgebraicClosure (B.residueField η))))) := by
      rw [Flat.SpecMap_iff, CommRingCat.hom_ofHom, RingHom.flat_algebraMap_iff]
      infer_instance
    obtain ⟨q, hq, hqI, hqF⟩ := hL1gen X B _ _ g (B.fromSpecResidueField η) _ hiI hiF
    exact ⟨_, q, Limits.pullback.fst g (B.fromSpecResidueField η), hq, hqI, hqF,
      (Limits.pullback.fst g (B.fromSpecResidueField η)).isEmbedding, Scheme.Hom.range_fiberι g η⟩

  have hL5 : ∀ (X B : Scheme.{u}) (g : X ⟶ B) (η : B)
      (ηb : Spec (.of (AlgebraicClosure (B.residueField η))) ⟶ B),
      ηb = Spec.map (CommRingCat.ofHom (algebraMap (B.residueField η)
        (AlgebraicClosure (B.residueField η)))) ≫ B.fromSpecResidueField η →
      ∀ (z₁ z₂ : ↥(Limits.pullback g ηb)),
      Limits.pullback.fst g ηb z₁ = Limits.pullback.fst g ηb z₂ →
      ∃ (τ : Spec (.of (AlgebraicClosure (B.residueField η))) ⟶
          Spec (.of (AlgebraicClosure (B.residueField η)))) (hτ : τ ≫ ηb = ηb),
        IsIso (Limits.pullback.map g ηb g ηb (𝟙 X) τ (𝟙 B) (by simp)
          (by rw [Category.comp_id, hτ])) ∧
        (Limits.pullback.map g ηb g ηb (𝟙 X) τ (𝟙 B) (by simp)
          (by rw [Category.comp_id, hτ])) z₁ = z₂ := by
    intro X B g η ηb hηb z₁ z₂ h
    obtain ⟨w, hw1, hw2⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := Limits.pullback.fst g ηb) (g := Limits.pullback.fst g ηb) z₁ z₂ h
    let W := Limits.pullback (Limits.pullback.fst g ηb) (Limits.pullback.fst g ηb)
    let t₁ : Spec (W.residueField w) ⟶ Limits.pullback g ηb :=
      W.fromSpecResidueField w ≫ Limits.pullback.fst _ _
    let t₂ : Spec (W.residueField w) ⟶ Limits.pullback g ηb :=
      W.fromSpecResidueField w ≫ Limits.pullback.snd _ _
    have ht : t₁ ≫ Limits.pullback.fst g ηb = t₂ ≫ Limits.pullback.fst g ηb := by
      simp only [t₁, t₂, Category.assoc]
      rw [Limits.pullback.condition]
    have ht1 : ∀ s, t₁ s = z₁ := by
      intro s
      simp only [t₁]
      rw [Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply, hw1]
    have ht2 : ∀ s, t₂ s = z₂ := by
      intro s
      simp only [t₂]
      rw [Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply, hw2]
    have hcond := Limits.pullback.condition (f := g) (g := ηb)
    have hs : (t₁ ≫ Limits.pullback.snd g ηb) ≫ ηb = (t₂ ≫ Limits.pullback.snd g ηb) ≫ ηb := by
      calc (t₁ ≫ Limits.pullback.snd g ηb) ≫ ηb = t₁ ≫ (Limits.pullback.snd g ηb ≫ ηb) :=
            Category.assoc _ _ _
        _ = t₁ ≫ (Limits.pullback.fst g ηb ≫ g) := by rw [hcond]
        _ = (t₁ ≫ Limits.pullback.fst g ηb) ≫ g := (Category.assoc _ _ _).symm
        _ = (t₂ ≫ Limits.pullback.fst g ηb) ≫ g := by rw [ht]
        _ = t₂ ≫ (Limits.pullback.fst g ηb ≫ g) := Category.assoc _ _ _
        _ = t₂ ≫ (Limits.pullback.snd g ηb ≫ ηb) := by rw [hcond]
        _ = (t₂ ≫ Limits.pullback.snd g ηb) ≫ ηb := (Category.assoc _ _ _).symm
    let j₁ := Spec.preimage (t₁ ≫ Limits.pullback.snd g ηb)
    let j₂ := Spec.preimage (t₂ ≫ Limits.pullback.snd g ηb)
    have hj₁ : Spec.map j₁ = t₁ ≫ Limits.pullback.snd g ηb := Spec.map_preimage _
    have hj₂ : Spec.map j₂ = t₂ ≫ Limits.pullback.snd g ηb := Spec.map_preimage _
    subst hηb
    have hs' : Spec.map j₁ ≫ Spec.map (CommRingCat.ofHom (algebraMap (B.residueField η)
        (AlgebraicClosure (B.residueField η)))) = Spec.map j₂ ≫ Spec.map (CommRingCat.ofHom
          (algebraMap (B.residueField η) (AlgebraicClosure (B.residueField η)))) := by
      rw [hj₁, hj₂]
      apply (cancel_mono (B.fromSpecResidueField η)).mp
      simp only [Category.assoc] at hs ⊢
      exact hs
    rw [← Spec.map_comp, ← Spec.map_comp] at hs'
    have hc := congrArg CommRingCat.Hom.hom (Spec.map_injective hs')
    rw [CommRingCat.hom_comp, CommRingCat.hom_comp, CommRingCat.hom_ofHom] at hc
    obtain ⟨σ, hσ⟩ := hL4 (B.residueField η) (W.residueField w) j₁.hom j₂.hom hc
    have hiσ : CommRingCat.ofHom (algebraMap (B.residueField η)
          (AlgebraicClosure (B.residueField η))) ≫
        CommRingCat.ofHom
          (σ : AlgebraicClosure (B.residueField η) →+* AlgebraicClosure (B.residueField η)) =
        CommRingCat.ofHom (algebraMap (B.residueField η) (AlgebraicClosure (B.residueField η))) := by
      ext x
      exact σ.commutes x
    haveI hσiso : IsIso (CommRingCat.ofHom
        (σ : AlgebraicClosure (B.residueField η) →+* AlgebraicClosure (B.residueField η))) :=
      ⟨⟨CommRingCat.ofHom
        (σ.symm : AlgebraicClosure (B.residueField η) →+* AlgebraicClosure (B.residueField η)),
        by ext x; exact σ.symm_apply_apply x, by ext x; exact σ.apply_symm_apply x⟩⟩
    have hτ : Spec.map (CommRingCat.ofHom
        (σ : AlgebraicClosure (B.residueField η) →+* AlgebraicClosure (B.residueField η))) ≫
        (Spec.map (CommRingCat.ofHom (algebraMap (B.residueField η)
          (AlgebraicClosure (B.residueField η)))) ≫ B.fromSpecResidueField η) =
        Spec.map (CommRingCat.ofHom (algebraMap (B.residueField η)
          (AlgebraicClosure (B.residueField η)))) ≫ B.fromSpecResidueField η := by
      rw [← Category.assoc, ← Spec.map_comp, hiσ]
    refine ⟨_, hτ, inferInstance, ?_⟩
    have hσj : CommRingCat.ofHom
        (σ : AlgebraicClosure (B.residueField η) →+* AlgebraicClosure (B.residueField η)) ≫ j₁ =
          j₂ := by
      ext x
      exact RingHom.congr_fun hσ x
    have hfin : t₁ ≫ Limits.pullback.map g _ g _ (𝟙 X) _ (𝟙 B) (by simp)
        (by rw [Category.comp_id, hτ]) = t₂ := by
      apply Limits.pullback.hom_ext
      · simp only [Limits.pullback.map, Category.assoc, Limits.pullback.lift_fst, Category.comp_id]
        exact ht
      · simp only [Limits.pullback.map, Category.assoc, Limits.pullback.lift_snd]
        rw [← Category.assoc, ← hj₁, ← hj₂, ← Spec.map_comp, hσj]
    obtain ⟨s⟩ : Nonempty (Spec (W.residueField w)) := inferInstance
    rw [← ht1 s, ← Scheme.Hom.comp_apply, hfin, ht2]

  have hHomeo : ∀ (P : Scheme.{u}) (F : P ⟶ P), IsIso F → ∀ (ζ ζ' : P), F ζ = ζ' →
      Function.Injective ⇑F ∧ ⇑F '' closure ({ζ} : Set P) = closure {ζ'} := by
    intro P F hF ζ ζ' h
    haveI := hF
    let e := Scheme.homeoOfIso (asIso F)
    have hfun : ⇑e = ⇑F := funext fun a => Scheme.homeoOfIso_apply (asIso F) a
    refine ⟨hfun ▸ e.injective, ?_⟩
    rw [← hfun, e.image_closure, Set.image_singleton, hfun, h]

  intro X B g _ U hUirr η hgen hUc Z Z' hZ hZd hZ' hZ'd
  have hUirrS : IsIrreducible (U : Set X) := by
    have := (IrreducibleSpace.isIrreducible_univ (↥U)).image ((↑) : ↥U → X)
      continuous_subtype_val.continuousOn
    simpa [Set.image_univ] using this
  obtain ⟨ξ, -, hUξ, hgξ⟩ := hL6 X B g g.continuous (U : Set X) U.isOpen hUirrS η hgen
  obtain ⟨Y, q, ι, hqι, hqI, hqF, hιE, hιR⟩ := hL1 X B g η (wcEtGeomPt B η) rfl
  have hpq : ∀ z, Limits.pullback.fst g (wcEtGeomPt B η) z = ι (q z) := by
    intro z
    rw [← hqι, Scheme.Hom.comp_apply]
  have hin : ∀ z, Limits.pullback.fst g (wcEtGeomPt B η) z ∈ ⇑g ⁻¹' {η} := by
    intro z
    rw [hpq, ← hιR]
    exact ⟨_, rfl⟩
  have hinc : ∀ z z' : ↥(Limits.pullback g (wcEtGeomPt B η)), z ⤳ z' →
      Limits.pullback.fst g (wcEtGeomPt B η) z = Limits.pullback.fst g (wcEtGeomPt B η) z' →
      z = z' := by
    intro z z' hzz' hpz
    rw [hpq, hpq] at hpz
    exact hL2 _ _ q hqI z z' hzz' (hιE.injective hpz)
  have hgd : ∀ (z : ↥(Limits.pullback g (wcEtGeomPt B η))) (x : X), x ∈ ⇑g ⁻¹' {η} →
      x ⤳ Limits.pullback.fst g (wcEtGeomPt B η) z →
      ∃ z', z' ⤳ z ∧ Limits.pullback.fst g (wcEtGeomPt B η) z' = x := by
    intro z x hx hxz
    rw [← hιR] at hx
    obtain ⟨y, rfl⟩ := hx
    rw [hpq] at hxz
    have hyq : y ⤳ q z := hιE.isInducing.specializes_iff.mp hxz
    haveI := hqF
    obtain ⟨z', hz'z, hqz'⟩ := Flat.generalizingMap q hyq
    exact ⟨z', hz'z, by rw [hpq, hqz']⟩
  have hξF : ξ ∈ ⇑g ⁻¹' {η} := hgξ
  obtain ⟨ζ, hζ, hpζ⟩ := hL3 _ _ (Limits.pullback.fst g (wcEtGeomPt B η))
    (Limits.pullback.fst g (wcEtGeomPt B η)).continuous hinc (⇑g ⁻¹' {η}) hin hgd
    (U : Set X) U.isOpen ξ hξF hUξ hUc Z hZ hZd
  obtain ⟨ζ', hζ', hpζ'⟩ := hL3 _ _ (Limits.pullback.fst g (wcEtGeomPt B η))
    (Limits.pullback.fst g (wcEtGeomPt B η)).continuous hinc (⇑g ⁻¹' {η}) hin hgd
    (U : Set X) U.isOpen ξ hξF hUξ hUc Z' hZ' hZ'd
  obtain ⟨τ, hτ, hiso, hτζ⟩ :=
    hL5 X B g η (wcEtGeomPt B η) rfl ζ ζ' (hpζ.trans hpζ'.symm)
  refine ⟨τ, hτ, ?_⟩
  subst hζ hζ'
  exact hHomeo _ _ hiso ζ ζ' hτζ

theorem wc_r2gs_etale_finite_near_generic : ∀ (B X : Scheme.{u}) [IsLocallyNoetherian B] (φ : X ⟶ B) [Etale φ] (v : X), (∀ y : B, y ⤳ φ v → y = φ v) → ∃ (OY : B.Opens) (W : X.Opens) (e : W ≤ φ ⁻¹ᵁ OY), v ∈ W ∧ IsAffineOpen OY ∧ IsAffineOpen W ∧ IsFinite (φ.resLE OY W e) :=
by
  classical

  have c1d : ∀ (B : Scheme.{u}) (U : B.Opens) (hU : IsAffineOpen U) (x : U),
      (∀ y : B, y ⤳ (x : B) → y = (x : B)) →
      (hU.primeIdealOf x).asIdeal ∈ minimalPrimes Γ(B, U) := by
    intro B U hU x h
    rw [← PrimeSpectrum.isMin_iff]
    intro Q hQ
    have hs : Q ⤳ hU.primeIdealOf x := (PrimeSpectrum.le_iff_specializes _ _).mp hQ
    have h2 := hs.map hU.fromSpec.continuous
    rw [hU.fromSpec_primeIdealOf] at h2
    have h3 := h _ h2
    rw [← hU.fromSpec_primeIdealOf x] at h3
    have := hU.fromSpec.isOpenEmbedding.injective h3
    rw [this]

  have c1a : ∀ (R A : Type u) [CommRing R] [CommRing A] [Algebra R A] [IsNoetherianRing R]
      [Algebra.Etale R A] (p : Ideal R) [p.IsPrime], p ∈ minimalPrimes R →
      Module.Finite (Localization.AtPrime p) (TensorProduct R (Localization.AtPrime p) A) := by
    intro R A _ _ _ _ _ p _ hp
    haveI : Ring.KrullDimLE 0 (Localization.AtPrime p) :=
      Ring.KrullDimLE.of_isLocalization p hp _
    haveI : IsArtinianRing (Localization.AtPrime p) :=
      isArtinianRing_iff_isNoetherianRing_krullDimLE_zero.mpr ⟨inferInstance, inferInstance⟩
    haveI := Algebra.Etale.baseChange R A (Localization.AtPrime p)
    exact Algebra.QuasiFinite.iff_of_isArtinianRing.mp inferInstance

  have c1c : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (U : Y.Opens) (V : X.Opens) (e : V ≤ f ⁻¹ᵁ U),
      IsAffineOpen U → IsAffineOpen V → (f.appLE U V e).hom.Finite →
      IsFinite (f.resLE U V e) := by
    intro X Y f U V e hU hV hf
    haveI : IsAffine (U : Scheme.{u}) := hU
    haveI : IsAffine (V : Scheme.{u}) := hV
    have hnat := Scheme.isoSpec_hom_naturality (f.resLE U V e)
    have hfac : f.resLE U V e = (V : Scheme.{u}).isoSpec.hom ≫
        Spec.map (f.resLE U V e).appTop ≫ (U : Scheme.{u}).isoSpec.inv := by
      rw [← Category.assoc, hnat, Category.assoc, Iso.hom_inv_id, Category.comp_id]
    have happ : ((f.resLE U V e).appTop).hom.Finite := by
      have h1 : (f.resLE U V e).appTop = U.topIso.hom ≫ f.appLE U V e ≫ V.topIso.inv :=
        Scheme.Hom.resLE_app_top f e
      rw [h1, CommRingCat.hom_comp, CommRingCat.hom_comp]
      exact RingHom.Finite.comp
        (RingHom.Finite.comp
          (RingHom.Finite.of_surjective _ (ConcreteCategory.bijective_of_isIso V.topIso.inv).2) hf)
        (RingHom.Finite.of_surjective _ (ConcreteCategory.bijective_of_isIso U.topIso.hom).2)
    haveI : IsFinite (Spec.map (f.resLE U V e).appTop) := (IsFinite.SpecMap_iff _).mpr happ
    rw [hfac]
    infer_instance

  have c1b : ∀ (R A : Type u) [CommRing R] [CommRing A] [Algebra R A] [Algebra.FiniteType R A]
      (p : Ideal R) [p.IsPrime],
      Module.Finite (Localization.AtPrime p) (TensorProduct R (Localization.AtPrime p) A) →
      ∃ f ∉ p, ∀ (Rf Af : Type u) [CommRing Rf] [CommRing Af] [Algebra R Rf] [Algebra A Af]
        [IsLocalization.Away f Rf] [IsLocalization.Away (algebraMap R A f) Af],
        (IsLocalization.Away.map Rf Af (algebraMap R A) f).Finite := by
    intro R A _ _ _ _ p _ hfin
    have key : ∀ a : A, ∃ m : R, m ∉ p ∧ ∃ t : R, t ∉ p ∧ ∃ Q : Polynomial R, Q.Monic ∧
        t • Polynomial.aeval (m • a) Q = 0 := by
      intro a
      have hi : IsIntegral (Localization.AtPrime p) ((1 : Localization.AtPrime p) ⊗ₜ[R] a) :=
        IsIntegral.of_finite (Localization.AtPrime p) _
      obtain ⟨⟨m, hm⟩, hmi⟩ :=
        IsIntegral.exists_multiple_integral_of_isLocalization p.primeCompl _ hi
      obtain ⟨Q, hQm, hQ⟩ := hmi
      have e1 : (⟨m, hm⟩ : p.primeCompl) • ((1 : Localization.AtPrime p) ⊗ₜ[R] a) =
          Algebra.TensorProduct.includeRight (R := R) (A := Localization.AtPrime p) (m • a) := by
        rw [Algebra.TensorProduct.includeRight_apply, Submonoid.mk_smul, TensorProduct.tmul_smul]
      rw [e1, ← Polynomial.aeval_def, Polynomial.aeval_algHom_apply,
        Algebra.TensorProduct.includeRight_apply] at hQ
      have hQ' : TensorProduct.mk R (Localization.AtPrime p) A 1 (Polynomial.aeval (m • a) Q) =
          TensorProduct.mk R (Localization.AtPrime p) A 1 0 := by
        simp only [TensorProduct.mk_apply, TensorProduct.tmul_zero]
        exact hQ
      obtain ⟨⟨t, ht⟩, htQ⟩ := IsLocalizedModule.exists_of_eq (S := p.primeCompl) hQ'
      refine ⟨m, hm, t, ht, Q, hQm, ?_⟩
      rw [Submonoid.mk_smul, Submonoid.mk_smul, smul_zero] at htQ
      exact htQ
    obtain ⟨s, hs⟩ := Algebra.FiniteType.out (R := R) (A := A)
    choose m hm t ht Q hQm hQ using key
    refine ⟨∏ a ∈ s, m a * t a, ?_, ?_⟩
    · intro hmem
      obtain ⟨a, _, ha⟩ := (Ideal.IsPrime.prod_mem_iff).mp hmem
      rcases Ideal.IsPrime.mem_or_mem ‹_› ha with h | h
      exacts [hm a h, ht a h]
    intro Rf Af _ _ _ _ _ _
    set f := ∏ a ∈ s, m a * t a with hf
    set φ := IsLocalization.Away.map Rf Af (algebraMap R A) f with hφ
    have hcomp : ∀ r : R, φ (algebraMap R Rf r) = algebraMap A Af (algebraMap R A r) := by
      intro r
      exact IsLocalization.map_eq _ r
    have hcompR : φ.comp (algebraMap R Rf) = (algebraMap A Af).comp (algebraMap R A) :=
      RingHom.ext hcomp
    have hdvd : ∀ a ∈ s, m a ∣ f ∧ t a ∣ f := by
      intro a ha
      exact ⟨dvd_trans (dvd_mul_right (m a) (t a)) (Finset.dvd_prod_of_mem _ ha),
        dvd_trans (dvd_mul_left (t a) (m a)) (Finset.dvd_prod_of_mem _ ha)⟩
    have hgen : ∀ a ∈ s, φ.IsIntegralElem (algebraMap A Af a) := by
      intro a ha
      have hut : IsUnit (algebraMap A Af (algebraMap R A (t a))) :=
        IsLocalization.Away.isUnit_of_dvd (algebraMap R A f) (map_dvd _ (hdvd a ha).2)
      have hum : IsUnit (algebraMap R Rf (m a)) :=
        IsLocalization.Away.isUnit_of_dvd f (hdvd a ha).1
      have h0 : algebraMap A Af (Polynomial.aeval (m a • a) (Q a)) = 0 := by
        have := congrArg (algebraMap A Af) (hQ a)
        rw [Algebra.smul_def, map_mul, map_zero] at this
        exact (hut.mul_right_eq_zero).mp this
      have hI : φ.IsIntegralElem (algebraMap A Af (m a • a)) := by
        refine ⟨(Q a).map (algebraMap R Rf), (hQm a).map _, ?_⟩
        rw [Polynomial.eval₂_map, hcompR, ← Polynomial.hom_eval₂, ← Polynomial.aeval_def]
        exact h0
      have hma : algebraMap A Af (m a • a) = algebraMap A Af a * φ (algebraMap R Rf (m a)) := by
        rw [Algebra.smul_def, map_mul, hcomp, mul_comm]
      rw [hma] at hI
      refine RingHom.IsIntegralElem.of_mul_unit φ _ _ (↑hum.unit⁻¹) ?_ hI
      rw [← map_mul, IsUnit.val_inv_mul, map_one]
    have hall : ∀ b : A, φ.IsIntegralElem (algebraMap A Af b) := by
      intro b
      have hb : b ∈ Algebra.adjoin R (↑s : Set A) := hs ▸ Algebra.mem_top
      induction hb using Algebra.adjoin_induction with
      | mem x hx => exact hgen x hx
      | algebraMap r => rw [← hcomp]; exact φ.isIntegralElem_map
      | add x y _ _ hx hy => rw [map_add]; exact RingHom.IsIntegralElem.add φ hx hy
      | mul x y _ _ hx hy => rw [map_mul]; exact RingHom.IsIntegralElem.mul φ hx hy
    have hint : φ.IsIntegral := by
      intro z
      obtain ⟨n, b, hz⟩ := IsLocalization.Away.surj (algebraMap R A f) z
      have hw : algebraMap A Af (algebraMap R A f) ^ n *
          φ (IsLocalization.Away.invSelf (S := Rf) f ^ n) = 1 := by
        rw [map_pow, ← hcomp, ← mul_pow, ← map_mul, IsLocalization.Away.mul_invSelf, map_one,
          one_pow]
      have hz' : z = algebraMap A Af b * φ (IsLocalization.Away.invSelf (S := Rf) f ^ n) := by
        rw [← hz, mul_assoc, hw, mul_one]
      rw [hz']
      exact RingHom.IsIntegralElem.mul φ (hall b) φ.isIntegralElem_map
    have hft : φ.FiniteType :=
      RingHom.finiteType_localizationPreserves.away (algebraMap R A) f Rf Af
        (RingHom.finiteType_algebraMap.mpr inferInstance)
    exact RingHom.IsIntegral.to_finite hint hft

  intro B X _ φ _ v hgen
  obtain ⟨OY₀, hOY₀, hη, -⟩ :=
    exists_isAffineOpen_mem_and_subset (x := φ v) (U := (⊤ : B.Opens)) trivial
  obtain ⟨W₀, hW₀, hv₀, hW₀sub⟩ :=
    exists_isAffineOpen_mem_and_subset (x := v) (U := φ ⁻¹ᵁ OY₀) hη
  have e₀ : W₀ ≤ φ ⁻¹ᵁ OY₀ := hW₀sub
  haveI : IsNoetherianRing Γ(B, OY₀) := IsLocallyNoetherian.component_noetherian ⟨OY₀, hOY₀⟩
  have hg : (φ.appLE OY₀ W₀ e₀).hom.Etale :=
    HasRingHomProperty.appLE @Etale φ inferInstance ⟨OY₀, hOY₀⟩ ⟨W₀, hW₀⟩ e₀
  letI := (φ.appLE OY₀ W₀ e₀).hom.toAlgebra
  haveI : Algebra.Etale Γ(B, OY₀) Γ(X, W₀) := RingHom.Etale.toAlgebra hg
  have hmin := c1d B OY₀ hOY₀ ⟨φ v, hη⟩ hgen
  have hfinp := c1a Γ(B, OY₀) Γ(X, W₀) _ hmin
  obtain ⟨f, hfp, hfin⟩ := c1b Γ(B, OY₀) Γ(X, W₀) _ hfinp
  have e : X.basicOpen ((φ.appLE OY₀ W₀ e₀).hom f) ≤ φ ⁻¹ᵁ B.basicOpen f :=
    (Scheme.basicOpen_appLE φ W₀ OY₀ e₀ f).le.trans inf_le_right
  refine ⟨B.basicOpen f, X.basicOpen ((φ.appLE OY₀ W₀ e₀).hom f), e, ?_, hOY₀.basicOpen f,
    hW₀.basicOpen _, ?_⟩
  · have hb : X.basicOpen ((φ.appLE OY₀ W₀ e₀).hom f) = W₀ ⊓ φ ⁻¹ᵁ B.basicOpen f :=
      Scheme.basicOpen_appLE φ W₀ OY₀ e₀ f
    rw [hb]
    refine ⟨hv₀, ?_⟩
    show φ v ∈ B.basicOpen f
    have hmem : hOY₀.primeIdealOf ⟨φ v, hη⟩ ∈ hOY₀.fromSpec ⁻¹ᵁ B.basicOpen f := by
      rw [hOY₀.fromSpec_preimage_basicOpen]
