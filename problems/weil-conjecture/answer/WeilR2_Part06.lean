ght)), lam Z ((Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B)).op ⋙ ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 2).obj) (Opposite.op (StructuredArrow.mk (Over.homMk (τ ≫ A.hom.left) (by rw [Category.assoc, Over.w A.hom]; exact hτ) : Over.mk (wcEtGeomPt B η) ⟶ (Scheme.Etale.forget B).obj A.right)))).hom s) = u * lam (⇑(Limits.pullback.map g (wcEtGeomPt B η) g (wcEtGeomPt B η) (𝟙 X) τ (𝟙 B) (by simp) (by rw [Category.comp_id, hτ])) '' Z) ((Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B)).op ⋙ ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 2).obj) (Opposite.op A)).hom s) :=
