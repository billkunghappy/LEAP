  have hgen : ∀ y : B, y ⤳ η → y = η := by
    intro y hy
    by_contra hne
    have hsub : closure ({η} : Set B) ⊆ closure {y} := specializes_iff_closure_subset.mp hy
    have hne' : closure ({η} : Set B) ≠ closure {y} := by
