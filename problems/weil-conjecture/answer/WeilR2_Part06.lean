    have hx := hOY₀.fromSpec_primeIdealOf ⟨φ v, hη⟩
    have hP : hOY₀.fromSpec (hOY₀.primeIdealOf ⟨φ v, hη⟩) ∈ B.basicOpen f := hmem
    rw [hx] at hP
    exact hP
  · haveI := hOY₀.isLocalization_basicOpen f
    haveI : IsLocalization.Away (algebraMap Γ(B, OY₀) Γ(X, W₀) f)
        Γ(X, X.basicOpen ((φ.appLE OY₀ W₀ e₀).hom f)) :=
      hW₀.isLocalization_basicOpen _
    have h1 := hfin Γ(B, B.basicOpen f) Γ(X, X.basicOpen ((φ.appLE OY₀ W₀ e₀).hom f))
    have h2 := IsAffineOpen.appLE_eq_away_map φ hOY₀ hW₀ e₀ f
    apply c1c φ _ _ e (hOY₀.basicOpen f) (hW₀.basicOpen _)
    rw [h2, CommRingCat.hom_ofHom]
    exact h1

theorem wc_r2gs_etale_chart_at_generic : ∀ (K : Type u) [Field K] (B : Scheme.{u}) (fB : B ⟶ Spec (.of K)) [IsProper fB] (V₀ : B.Etale) (v : V₀.left), (∀ y : B, y ⤳ V₀.hom v → y = V₀.hom v) → ∃ (W : V₀.left.Opens) (OY : B.Opens) (εO : (W : Scheme.{u}) ⟶ (OY : Scheme.{u})), v ∈ W ∧ IrreducibleSpace ↥W ∧ IsAffineOpen OY ∧ IsFinite εO ∧ εO ≫ OY.ι = W.ι ≫ V₀.hom :=
by

  have c3 : ∀ (T S : Type u) [TopologicalSpace T] [TopologicalSpace S]
      [TopologicalSpace.NoetherianSpace T] [QuasiSober T] (p : T → S), IsClosedMap p →
      ∀ t₀ : T, (∀ x y : T, p x = p t₀ → y ⤳ x → y = x) →
      ∃ (O : Set S) (F G : Set T), IsOpen O ∧ p t₀ ∈ O ∧ IsClosed F ∧ IsIrreducible F ∧
        IsClosed G ∧ t₀ ∈ F ∧ t₀ ∉ G ∧ ∀ x : T, p x ∈ O → (x ∈ F ↔ x ∉ G) := by
    intro T S _ _ _ _ p hp t₀ hgen
    have hCfin : (irreducibleComponents T).Finite :=
      TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
    have hFC : irreducibleComponent t₀ ∈ irreducibleComponents T :=
      irreducibleComponent_mem_irreducibleComponents t₀
    have hGc : IsClosed (⋃₀ (irreducibleComponents T \ {irreducibleComponent t₀})) :=
      (hCfin.subset Set.diff_subset).isClosed_sUnion
        (fun t ht => isClosed_of_mem_irreducibleComponents t ht.1)
    have hFc : IsClosed (irreducibleComponent t₀) :=
      isClosed_of_mem_irreducibleComponents _ hFC
    have star : ∀ x, p x = p t₀ → ∀ Z₁ ∈ irreducibleComponents T, ∀ Z₂ ∈ irreducibleComponents T,
        x ∈ Z₁ → x ∈ Z₂ → Z₁ = Z₂ := by
      intro x hx Z₁ hZ₁ Z₂ hZ₂ hx₁ hx₂
      obtain ⟨ξ₁, hξ₁⟩ := QuasiSober.sober hZ₁.1
        (isClosed_of_mem_irreducibleComponents _ hZ₁)
      obtain ⟨ξ₂, hξ₂⟩ := QuasiSober.sober hZ₂.1
        (isClosed_of_mem_irreducibleComponents _ hZ₂)
      have e₁ := hgen x ξ₁ hx (hξ₁.specializes hx₁)
      have e₂ := hgen x ξ₂ hx (hξ₂.specializes hx₂)
      have h1 : closure {ξ₁} = Z₁ := hξ₁
      have h2 : closure {ξ₂} = Z₂ := hξ₂
      rw [← h1, ← h2, e₁, e₂]
    have hvG : t₀ ∉ ⋃₀ (irreducibleComponents T \ {irreducibleComponent t₀}) := by
      rintro ⟨Z, ⟨hZC, hZF⟩, ht₀Z⟩
      exact hZF (star t₀ rfl Z hZC _ hFC ht₀Z mem_irreducibleComponent)
    refine ⟨(p '' (irreducibleComponent t₀ ∩
        ⋃₀ (irreducibleComponents T \ {irreducibleComponent t₀})))ᶜ,
      irreducibleComponent t₀, ⋃₀ (irreducibleComponents T \ {irreducibleComponent t₀}),
      (hp _ (hFc.inter hGc)).isOpen_compl, ?_, hFc, isIrreducible_irreducibleComponent, hGc,
      mem_irreducibleComponent, hvG, ?_⟩
    · rintro ⟨x, ⟨hxF, Z, ⟨hZC, hZF⟩, hxZ⟩, hpx⟩
      exact hZF (star x hpx Z hZC _ hFC hxZ hxF)
    · intro x hx
      constructor
      · intro hxF hxG
        exact hx ⟨x, ⟨hxF, hxG⟩, rfl⟩
      · intro hxG
        by_contra hxF
        apply hxG
        refine ⟨irreducibleComponent x,
          ⟨irreducibleComponent_mem_irreducibleComponents x, ?_⟩, mem_irreducibleComponent⟩
        intro h
        rw [Set.mem_singleton_iff] at h
        exact hxF (h ▸ mem_irreducibleComponent)

  have c2 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (U U' : Y.Opens) (V W : X.Opens)
      (e : V ≤ f ⁻¹ᵁ U) (e' : W ≤ f ⁻¹ᵁ U'), U' ≤ U →
      (∃ C : Set ↥V, IsClosed C ∧ (W : Set X) = V.ι '' C ∩ f ⁻¹' (U' : Set Y)) →
      IsFinite (f.resLE U V e) → IsFinite (f.resLE U' W e') := by
    intro X Y f U U' V W e e' hU hCex hfin
    obtain ⟨C, hC, hW⟩ := hCex
    have hWV' : W ≤ V ⊓ f ⁻¹ᵁ U' := by
      intro z hz
      have hz' : z ∈ V.ι '' C ∩ f ⁻¹' (U' : Set Y) := by rw [← hW]; exact hz
      obtain ⟨⟨y, _, hy⟩, h2⟩ := hz'
      refine ⟨?_, h2⟩
      rw [← hy]
      exact y.2
    have hpb := Scheme.Hom.isPullback_resLE (IsPullback.id_horiz f) (US := U) (UT := U')
