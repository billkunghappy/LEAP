      intro Z
      have hirr : IsIrreducible (Subtype.val '' (Z : Set S)) :=
        Z.isIrreducible.image Subtype.val continuous_subtype_val.continuousOn
      obtain ⟨z, hz⟩ := QuasiSober.sober hirr.closure isClosed_closure
      have hzcl : closure ({z} : Set X) = closure (Subtype.val '' (Z : Set S)) := hz.def
      have hsubS : Subtype.val '' (Z : Set S) ⊆ S := by
