    · rintro ⟨⟨x, hxF, rfl⟩, hz⟩
      exact ⟨⟨x, (hFG x (hOYO x hz)).1 hxF, rfl⟩, hz⟩
  have hvW : v ∈ W := ⟨⟨⟨v, hv₁⟩, hvG, rfl⟩, hηr⟩
  have hfin : IsFinite (V₀.hom.resLE (B.basicOpen r) W inf_le_right) :=
    c2 V₀.hom OY₁ (B.basicOpen r) W₁ W e₁ inf_le_right (B.basicOpen_le r) ⟨F, hFc, hWset⟩ hπ₁
