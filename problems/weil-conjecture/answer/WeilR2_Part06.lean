        (wcIntRatRestrict F X h ℓ ⋙ SheafOfModules.toSheaf (wcIntSliceRing F X h ℓ)) :=
      inferInstanceAs (Limits.PreservesFiniteColimits (SheafOfModules.toSheaf (wcSliceRing F X h ℓ)))
    haveI : Limits.ReflectsFiniteColimits (SheafOfModules.toSheaf.{u+1} (wcIntSliceRing F X h ℓ)) :=
      { reflects := fun J _ _ => by
          haveI hfc : Limits.HasFiniteColimits (SheafOfModules.{u+1} (wcIntSliceRing F X h ℓ)) :=
            inferInstance
          haveI : Limits.HasColimitsOfShape J (SheafOfModules.{u+1} (wcIntSliceRing F X h ℓ)) :=
            Limits.HasFiniteColimits.out J
          haveI : Limits.PreservesColimitsOfShape J
              (SheafOfModules.toSheaf.{u+1} (wcIntSliceRing F X h ℓ)) :=
            Limits.PreservesFiniteColimits.preservesFiniteColimits J
          exact Limits.reflectsColimitsOfShape_of_reflectsIsomorphisms }
    exact Limits.preservesFiniteColimits_of_reflects_of_preserves _
      (SheafOfModules.toSheaf (wcIntSliceRing F X h ℓ))
  haveI hGΛL : Limits.PreservesFiniteLimits (SheafOfModules.toSheaf.{u+1} (wcIntSliceRing F X h ℓ)) :=
    inferInstance
  haveI hGRL : Limits.PreservesFiniteLimits (SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)) :=
