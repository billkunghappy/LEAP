      infer_instance
    haveI : IsIso (Limits.pullback.map g (wcEtGeomPt B η) g (wcEtGeomPt B η) (𝟙 X) τ (𝟙 B)
        (by simp) (by rw [Category.comp_id, hτ])) :=
      Limits.pullback.map_isIso _ _ _ _ _ _ _ _ _
    have hcommσ : Limits.pullback.map g (wcEtGeomPt B η) g (wcEtGeomPt B η) (𝟙 X) τ (𝟙 B)
