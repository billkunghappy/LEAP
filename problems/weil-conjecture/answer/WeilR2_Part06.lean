    rw [I.sub_extMk, I.extMk_eq_zero_iff _ _ _ _ (N + 1) rfl] at h0
    obtain ⟨h, hh⟩ := h0
    have hce : adj.homEquiv P _ (f α) -
        (show P ⟶ R.obj (I.cocomplex.X (N + 1 + 1)) from
          z ≫ ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).iCycles
            (N + 1 + 1)) =
        adj.homEquiv P _ h ≫ ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).d
          (N + 1) (N + 1 + 1) := by
      show _ = adj.homEquiv P _ h ≫ R.map (I.cocomplex.d (N + 1) (N + 1 + 1))
      rw [← adj.homEquiv_naturality_right, hh, hφsub, hgdef, Equiv.apply_symm_apply]
    show Φ _ = Φ x
    rw [hΦinv _ _ (hc α) hzd _ hce, hlz, hzdef, Abelian.Ext.mk₀_homEquiv₀_apply]
  haveI : Finite (Abelian.Ext (L.obj P) A (N + 1 + 1)) := hfin
  exact ⟨Finite.of_surjective _ hθ, Nat.card_le_card_of_surjective _ hθ⟩

