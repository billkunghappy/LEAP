  obtain ⟨hFfin, hconst⟩ := wc_r2gi_stalk_card_const K X B fB g (ℓ ^ m) hM0 hMK hfib I
  obtain ⟨W₁, hW₁o, hηW₁, hW₁⟩ := hconst η
  obtain ⟨W₂, hW₂o, hηW₂, hW₂⟩ :=
    wc_et_spread_stalk_surj_of_card_const B _ _ φ η hFfin ⟨W₁, hW₁o, hηW₁, hW₁⟩ hsurjη
  obtain ⟨W, hWdef⟩ : ∃ W : Set B, W = W₁ ∩ W₂ ∩ (OY : Set B) := ⟨_, rfl⟩
  have hWo : IsOpen W := by
    rw [hWdef]
    exact (hW₁o.inter hW₂o).inter OY.isOpen
  have hηW : η ∈ W := by
    rw [hWdef]
