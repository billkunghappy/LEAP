  have s3 : ∀ (k : ℕ) {X : D} (β : X ⟶ J.cocomplex.X (k + 1)),
      β ≫ J.cocomplex.d (k + 1) (k + 1 + 1) = 0 →
      ∃ (X₁ X₂ : D) (i : X₁ ⟶ X₂) (p : X₂ ⟶ X) (w : i ≫ p = 0) (f' : X₂ ⟶ J.cocomplex.X k),
        (ShortComplex.mk i p w).ShortExact ∧ p ≫ β = f' ≫ J.cocomplex.d k (k + 1) := by
    intro k X β hβ
    have hepi : Epi (Limits.kernel.lift (J.cocomplex.d (k + 1) (k + 2)) (J.cocomplex.d k (k + 1))
        (J.cocomplex.d_comp_d _ _ _)) := (J.exact_succ k).epi_kernelLift
    obtain ⟨X₂, π, hπ, x, hx⟩ := surjective_up_to_refinements_of_epi
      (Limits.kernel.lift (J.cocomplex.d (k + 1) (k + 2)) (J.cocomplex.d k (k + 1))
        (J.cocomplex.d_comp_d _ _ _))
      (Limits.kernel.lift (J.cocomplex.d (k + 1) (k + 2)) β hβ)
    refine ⟨Limits.kernel π, X₂, Limits.kernel.ι π, π, Limits.kernel.condition π, x, ?_, ?_⟩
    · exact ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel π) inferInstance hπ
    · have := congrArg (· ≫ Limits.kernel.ι (J.cocomplex.d (k + 1) (k + 2))) hx
      simpa using this

  have key : ∀ a : ℕ, ∃ s : ℤ, (s = 1 ∨ s = -1) ∧ ∀ (X : D) (c : ℕ) (h : a + n = c)
      (hc : n + a = c) (β : X ⟶ J.cocomplex.X a) (hβ : β ≫ J.cocomplex.d a (a + 1) = 0)
      (hf : ((adj.homEquiv _ _).symm (β ≫ ψ a) ≫ (I.cocomplex.XIsoOfEq hc).hom) ≫
        I.cocomplex.d c (c + 1) = 0),
      (Abelian.Ext.mapExactFunctor L (J.extMk β (a + 1) rfl hβ)).comp
        (I.extMk g (n + 1) rfl hg) h =
      s • I.extMk ((adj.homEquiv _ _).symm (β ≫ ψ a) ≫ (I.cocomplex.XIsoOfEq hc).hom)
        (c + 1) rfl hf := by
    intro a
    induction a with
    | zero =>
      refine ⟨1, Or.inl rfl, ?_⟩
      intro X c h hc β hβ hf
      have hι := J.ι_f_zero_comp_complex_d
      obtain ⟨β₀, hβ₀⟩ : ∃ β₀ : X ⟶ P, β₀ ≫ J.ι.f 0 = β :=
        ⟨(Limits.KernelFork.IsLimit.lift' J.isLimitKernelFork β hβ).1,
          (Limits.KernelFork.IsLimit.lift' J.isLimitKernelFork β hβ).2⟩
      subst hβ₀
      have e1 : J.extMk (β₀ ≫ J.ι.f 0) (0 + 1) rfl hβ = Abelian.Ext.mk₀ β₀ := by
        have := InjectiveResolution.mk₀_comp_extMk J (J.ι.f 0) 1 rfl hι β₀
        rw [s1 hι] at this
        exact this.symm.trans (Abelian.Ext.comp_mk₀_id _)
      rw [e1, Abelian.Ext.mapExactFunctor_mk₀]
      have hcn : n = c := hc
      subst hcn
      refine (InjectiveResolution.mk₀_comp_extMk I g _ rfl hg (L.map β₀)).trans ?_
      rw [one_smul]
      apply hcI
      have e2 : (adj.homEquiv X (I.cocomplex.X n)).symm (β₀ ≫ adj.homEquiv _ _ g) = L.map β₀ ≫ g := by
        rw [adj.homEquiv_naturality_left_symm, Equiv.symm_apply_apply]
      have e3 : (β₀ ≫ J.ι.f 0) ≫ ψ 0 = β₀ ≫ adj.homEquiv _ _ g :=
        (Category.assoc _ _ _).trans (congrArg (fun x => β₀ ≫ x) hψ0)
      calc L.map β₀ ≫ g = (adj.homEquiv X _).symm (β₀ ≫ adj.homEquiv _ _ g) := e2.symm
        _ = (adj.homEquiv X _).symm ((β₀ ≫ J.ι.f 0) ≫ ψ 0) := congrArg _ e3.symm
        _ = _ := (Category.comp_id _).symm
    | succ a ih =>
      obtain ⟨s, hs, H⟩ := ih
      obtain ⟨εJ, hεJ, HJ⟩ := extClass_comp_extMk_sign J a
      obtain ⟨εI, hεI, HI⟩ := extClass_comp_extMk_sign I (n + a)
      refine ⟨εJ * s * εI, ?_, ?_⟩
      · rcases hεJ with rfl | rfl <;> rcases hs with rfl | rfl <;> rcases hεI with rfl | rfl <;>
          norm_num
      intro X c h hc β hβ hf
      obtain rfl : c = n + (a + 1) := hc.symm
      obtain ⟨X₁, X₂, i, p, w, f', hS, hpβ⟩ := s3 a β hβ
      have hf0 : (i ≫ f') ≫ J.cocomplex.d a (a + 1) = 0 := by
        rw [Category.assoc, ← hpβ, ← Category.assoc, w, Limits.zero_comp]
      have hJ := HJ (ShortComplex.mk i p w) hS (i ≫ f') hf0 f' rfl β hpβ hβ
      have hJL : (hS.map_of_exact L).extClass.comp
          (Abelian.Ext.mapExactFunctor L (J.extMk (i ≫ f') (a + 1) rfl hf0)) (add_comm 1 a) =
          εJ • Abelian.Ext.mapExactFunctor L (J.extMk β (a + 2) rfl hβ) := by
        rw [← hLz, ← hJ, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass]
      obtain ⟨fI, hfI⟩ : ∃ x : L.obj X₁ ⟶ I.cocomplex.X (n + a),
          x = (adj.homEquiv _ _).symm ((i ≫ f') ≫ ψ a) := ⟨_, rfl⟩
      obtain ⟨f'I, hf'I⟩ : ∃ x : L.obj X₂ ⟶ I.cocomplex.X (n + a),
          x = (adj.homEquiv _ _).symm (f' ≫ ψ a) := ⟨_, rfl⟩
      obtain ⟨hI, hhI⟩ : ∃ x : L.obj X ⟶ I.cocomplex.X (n + a + 1),
          x = (adj.homEquiv _ _).symm (β ≫ ψ (a + 1)) := ⟨_, rfl⟩
      have hfI0 : fI ≫ I.cocomplex.d (n + a) (n + a + 1) = 0 := by
        rw [hfI, ← adj.homEquiv_naturality_right_symm, Category.assoc, hψ a, ← Category.assoc,
          hf0, Limits.zero_comp, hφs0]
      have hhI0 : hI ≫ I.cocomplex.d (n + a + 1) (n + a + 2) = 0 := by
        have h' := hf
        rw [HomologicalComplex.XIsoOfEq_rfl, Iso.refl_hom, Category.comp_id] at h'
        rw [hhI]
        exact h'
      have eq1 : ((ShortComplex.mk i p w).map L).f ≫ f'I = fI := by
        show L.map i ≫ f'I = fI
        rw [hfI, hf'I, Category.assoc]
        exact (adj.homEquiv_naturality_left_symm i (f' ≫ ψ a)).symm
      have eq2 : ((ShortComplex.mk i p w).map L).g ≫ hI = f'I ≫ I.cocomplex.d (n + a) (n + a + 1) := by
        show L.map p ≫ hI = _
        rw [hhI, hf'I]
        calc L.map p ≫ (adj.homEquiv _ _).symm (β ≫ ψ (a + 1))
            = (adj.homEquiv _ _).symm (p ≫ β ≫ ψ (a + 1)) :=
              (adj.homEquiv_naturality_left_symm p _).symm
          _ = (adj.homEquiv _ _).symm ((f' ≫ ψ a) ≫ R.map (I.cocomplex.d (n + a) (n + a + 1))) := by
              congr 1
              rw [← Category.assoc p, hpβ, Category.assoc, Category.assoc, hψ a]
          _ = _ := adj.homEquiv_naturality_right_symm _ _
      have HIX := HI ((ShortComplex.mk i p w).map L) (hS.map_of_exact L) fI hfI0 f'I eq1 hI eq2 hhI0
      have HIX' : (hS.map_of_exact L).extClass.comp (I.extMk fI (n + a + 1) rfl hfI0)
          (show 1 + (n + a) = n + (a + 1) by omega) = εI • I.extMk hI (n + a + 2) rfl hhI0 := HIX
      have HX := H X₁ (n + a) (add_comm a n) rfl (i ≫ f') hf0 (by
        rw [HomologicalComplex.XIsoOfEq_rfl, Iso.refl_hom, Category.comp_id, ← hfI]
        exact hfI0)
      have HX' : (Abelian.Ext.mapExactFunctor L (J.extMk (i ≫ f') (a + 1) rfl hf0)).comp
          (I.extMk g (n + 1) rfl hg) (add_comm a n) = s • I.extMk fI (n + a + 1) rfl hfI0 := by
        rw [HX]
        refine congrArg (s • ·) (hcI rfl _ _ _ _ ?_)
        rw [HomologicalComplex.XIsoOfEq_rfl, Iso.refl_hom, Category.comp_id, hfI]
      have hassoc := Abelian.Ext.comp_assoc (hS.map_of_exact L).extClass
        (Abelian.Ext.mapExactFunctor L (J.extMk (i ≫ f') (a + 1) rfl hf0))
        (I.extMk g (n + 1) rfl hg) (add_comm 1 a) (add_comm a n)
        (show 1 + a + n = n + (a + 1) by omega)
      rw [hJL, HX', hzc, hcz, HIX'] at hassoc
      have hfin : I.extMk ((adj.homEquiv _ _).symm (β ≫ ψ (a + 1)) ≫
          (I.cocomplex.XIsoOfEq hc).hom) (n + (a + 1) + 1) rfl hf =
          I.extMk hI (n + a + 2) rfl hhI0 := by
        apply hcI
        rw [HomologicalComplex.XIsoOfEq_rfl, Iso.refl_hom, Category.comp_id, hhI]
      rw [hfin]
      calc _ = εJ • (εJ • (Abelian.Ext.mapExactFunctor L (J.extMk β (a + 1 + 1) rfl hβ)).comp
            (I.extMk g (n + 1) rfl hg) h) := by rw [smul_smul, hsq εJ hεJ, one_smul]
        _ = εJ • (s • εI • I.extMk hI (n + a + 2) rfl hhI0) := congrArg (εJ • ·) hassoc
        _ = _ := by simp only [smul_smul, mul_assoc]
  intro a
  obtain ⟨s, hs, H⟩ := key a
  exact ⟨s, hs, fun c h hc β hβ hf => H P c h hc β hβ hf⟩

theorem wc_lh_sigma_iso_elementwise : ∀ {D : Type*} [Category D] [Abelian D] (K : CochainComplex D ℕ) (P : D) (k r : ℕ) (φ : Fin r → (P ⟶ K.X k)) (hφ : ∀ i, φ i ≫ K.d k (k + 1) = 0), IsIso (Limits.Sigma.desc (fun i : Fin r => K.liftCycles (φ i) (k + 1) (by simp) (hφ i) ≫ K.homologyπ k)) → (∀ (A : D) (a : Fin r → (A ⟶ P)) (x : A ⟶ K.X (k - 1)), ∑ i, a i ≫ φ i = x ≫ K.d (k - 1) k → ∀ i, a i = 0) ∧ (∀ (A : D) (y : A ⟶ K.X k), y ≫ K.d k (k + 1) = 0 → ∃ (A' : D) (π : A' ⟶ A) (_ : Epi π) (a : Fin r → (A' ⟶ P)) (x : A' ⟶ K.X (k - 1)), π ≫ y = ∑ i, a i ≫ φ i + x ≫ K.d (k - 1) k) :=
by
  classical
  intro D _ _ K P k r φ hφ hiso
  have hnext : (ComplexShape.up ℕ).next k = k + 1 := by simp
  have hιΦ : ∀ j, Limits.Sigma.ι (fun _ : Fin r => P) j ≫
      Limits.Sigma.desc (fun i : Fin r => K.liftCycles (φ i) (k + 1) (by simp) (hφ i) ≫ K.homologyπ k) =
      K.liftCycles (φ j) (k + 1) hnext (hφ j) ≫ K.homologyπ k :=
    fun j => Limits.Sigma.ι_comp_desc _ _
  revert hiso hιΦ
  generalize Limits.Sigma.desc (fun i : Fin r => K.liftCycles (φ i) (k + 1) (by simp) (hφ i) ≫ K.homologyπ k) = Φ
  intro hiso hιΦ
  have hw : ∀ {A : D} (a : Fin r → (A ⟶ P)), (∑ i, a i ≫ φ i) ≫ K.d k (k + 1) = 0 := by
    intro A a
    simp [Preadditive.sum_comp, Category.assoc, hφ]
  have hlin : ∀ {A : D} (a : Fin r → (A ⟶ P)),
      (∑ i, a i ≫ Limits.Sigma.ι (fun _ : Fin r => P) i) ≫ Φ =
        K.liftCycles (∑ i, a i ≫ φ i) (k + 1) hnext (hw a) ≫ K.homologyπ k := by
    intro A a
    have h1 : (∑ i, a i ≫ K.liftCycles (φ i) (k + 1) hnext (hφ i)) =
        K.liftCycles (∑ i, a i ≫ φ i) (k + 1) hnext (hw a) := by
      apply (cancel_mono (K.iCycles k)).mp
      simp [Preadditive.sum_comp]
    rw [Preadditive.sum_comp, ← h1, Preadditive.sum_comp]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [Category.assoc, hιΦ, Category.assoc]
  obtain ⟨p, hp⟩ : ∃ p : Fin r → ((∐ fun _ : Fin r => P) ⟶ P),
      ∀ i, p i = Limits.Sigma.desc (fun j => if j = i then 𝟙 P else 0) := ⟨_, fun _ => rfl⟩
  have hsp : ∀ {A : D} (a : Fin r → (A ⟶ P)) (i : Fin r),
      (∑ j, a j ≫ Limits.Sigma.ι (fun _ : Fin r => P) j) ≫ p i = a i := by
    intro A a i
    simp [hp, Preadditive.sum_comp, comp_ite]
  have hid : 𝟙 (∐ fun _ : Fin r => P) = ∑ i, p i ≫ Limits.Sigma.ι (fun _ : Fin r => P) i := by
    apply Limits.Sigma.hom_ext
    intro j
    simp [hp, Preadditive.comp_sum, ite_comp]
  have hdec : ∀ {A : D} (t : A ⟶ ∐ fun _ : Fin r => P),
      t = ∑ i, (t ≫ p i) ≫ Limits.Sigma.ι (fun _ : Fin r => P) i := by
    intro A t
    conv_lhs => rw [← Category.comp_id t, hid]
    rw [Preadditive.comp_sum]
    simp only [Category.assoc]
  refine ⟨?_, ?_⟩
  · intro A a x hax i
    have h0 : K.liftCycles (∑ i, a i ≫ φ i) (k + 1) hnext (hw a) ≫ K.homologyπ k = 0 :=
      K.liftCycles_homologyπ_eq_zero_of_boundary _ (k + 1) hnext x hax
    have hs : (∑ j, a j ≫ Limits.Sigma.ι (fun _ : Fin r => P) j) = 0 := by
      rw [← cancel_mono Φ, hlin, h0, Limits.zero_comp]
    rw [← hsp a i, hs, Limits.zero_comp]
  · intro A y hy
    obtain ⟨t, ht⟩ : ∃ t : A ⟶ ∐ fun _ : Fin r => P,
        t ≫ Φ = K.liftCycles y (k + 1) hnext hy ≫ K.homologyπ k :=
      ⟨(K.liftCycles y (k + 1) hnext hy ≫ K.homologyπ k) ≫ inv Φ, by simp⟩
    obtain ⟨a, ha⟩ : ∃ a : Fin r → (A ⟶ P), ∀ i, a i = t ≫ p i := ⟨_, fun _ => rfl⟩
    have htdec : t = ∑ i, a i ≫ Limits.Sigma.ι (fun _ : Fin r => P) i := by
      have := hdec t
      simp only [← ha] at this
      exact this
    have hz : K.liftCycles y (k + 1) hnext hy ≫ K.homologyπ k =
        K.liftCycles (∑ i, a i ≫ φ i) (k + 1) hnext (hw a) ≫ K.homologyπ k := by
      rw [← ht, ← hlin, ← htdec]
    have hdiff : (y - ∑ i, a i ≫ φ i) ≫ K.d k (k + 1) = 0 := by
      rw [Preadditive.sub_comp, hy, hw a, sub_zero]
    have hlc : K.liftCycles (y - ∑ i, a i ≫ φ i) (k + 1) hnext hdiff =
        K.liftCycles y (k + 1) hnext hy - K.liftCycles (∑ i, a i ≫ φ i) (k + 1) hnext (hw a) := by
      apply (cancel_mono (K.iCycles k)).mp
      simp [Preadditive.sub_comp]
    have h0 : K.liftCycles (y - ∑ i, a i ≫ φ i) (k + 1) hnext hdiff ≫ K.homologyπ k = 0 := by
      rw [hlc, Preadditive.sub_comp, hz, sub_self]
    have hprev : ∀ n : ℕ, (ComplexShape.up ℕ).prev n = n - 1 := by
      intro n
      cases n with
      | zero => simp [CochainComplex.prev_nat_zero]
      | succ n => simp [CochainComplex.prev_nat_succ]
    obtain ⟨A', π', hπ', x₁, hx₁⟩ :=
      (K.liftCycles_comp_homologyπ_eq_zero_iff_up_to_refinements (k - 1) k (k + 1) (hprev k) hnext
        (y - ∑ i, a i ≫ φ i) hdiff).mp h0
    refine ⟨A', π', hπ', fun i => π' ≫ a i, x₁, ?_⟩
    rw [Preadditive.comp_sub, sub_eq_iff_eq_add] at hx₁
    rw [hx₁, Preadditive.comp_sum]
    simp only [Category.assoc]
    rw [add_comm]

theorem wc_lh_cone_transfer : ∀ {D : Type*} [Category D] [Abelian D] (T K : CochainComplex D ℕ) (Ψ : T ⟶ K), (∀ j, Injective (T.X j)) → (∀ j, Injective (K.X j)) → ∀ (m : ℕ), (∀ k, k ≤ m + 1 → ∀ (A : D) (t : A ⟶ T.X k), t ≫ T.d k (k + 1) = 0 → ∀ x : A ⟶ K.X (k - 1), t ≫ Ψ.f k = x ≫ K.d (k - 1) k → ∃ (A' : D) (π : A' ⟶ A) (_ : Epi π) (u : A' ⟶ T.X (k - 1)), π ≫ t = u ≫ T.d (k - 1) k) → (∀ k, k ≤ m → ∀ (A : D) (y : A ⟶ K.X k), y ≫ K.d k (k + 1) = 0 → ∃ (A' : D) (π : A' ⟶ A) (_ : Epi π) (s : A' ⟶ T.X k) (x : A' ⟶ K.X (k - 1)), s ≫ T.d k (k + 1) = 0 ∧ π ≫ y = s ≫ Ψ.f k + x ≫ K.d (k - 1) k) → (∀ (A : D) (c : A ⟶ K.X m), c ≫ K.d m (m + 1) = 0 → ∃ t : A ⟶ T.X m, t ≫ T.d m (m + 1) = 0 ∧ ∃ e : A ⟶ K.X (m - 1), c - t ≫ Ψ.f m = e ≫ K.d (m - 1) m) ∧ (∀ (A : D) (t : A ⟶ T.X m), t ≫ T.d m (m + 1) = 0 → ∀ e : A ⟶ K.X (m - 1), t ≫ Ψ.f m = e ≫ K.d (m - 1) m → ∃ u : A ⟶ T.X (m - 1), u ≫ T.d (m - 1) m = t) :=
by
  intro D _ _ T K Ψ hT hK m hinj hsurj

  have liftInj : ∀ {X Y Z W : D} (f : X ⟶ Y) (g : Y ⟶ Z) (hfg : f ≫ g = 0),
      (∀ ⦃A : D⦄ (y : A ⟶ Y), y ≫ g = 0 →
        ∃ (A' : D) (π : A' ⟶ A) (_ : Epi π) (x : A' ⟶ X), π ≫ y = x ≫ f) →
      Injective W → ∀ (u : Y ⟶ W), f ≫ u = 0 → ∃ v : Z ⟶ W, g ≫ v = u := by
    intro X Y Z W f g hfg hex hW u hu
    have hex' : (ShortComplex.mk f g hfg).Exact :=
      (ShortComplex.exact_iff_exact_up_to_refinements _).mpr hex
    haveI : Mono (Limits.cokernel.desc f g hfg) := hex'.mono_cokernelDesc
    refine ⟨Injective.factorThru (Limits.cokernel.desc f u hu) (Limits.cokernel.desc f g hfg), ?_⟩
    calc g ≫ Injective.factorThru (Limits.cokernel.desc f u hu) (Limits.cokernel.desc f g hfg)
        = (Limits.cokernel.π f ≫ Limits.cokernel.desc f g hfg) ≫
            Injective.factorThru (Limits.cokernel.desc f u hu) (Limits.cokernel.desc f g hfg) := by
          rw [Limits.cokernel.π_desc]
      _ = u := by rw [Category.assoc, Injective.comp_factorThru, Limits.cokernel.π_desc]

  have hstep : ∀ {X Y Z : D} (f : X ⟶ Y) (g : Y ⟶ Z), f ≫ g = 0 →
      (∀ ⦃A : D⦄ (y : A ⟶ Y), y ≫ g = 0 →
        ∃ (A' : D) (π : A' ⟶ A) (_ : Epi π) (x : A' ⟶ X), π ≫ y = x ≫ f) →
      Injective Y → ∀ h : Y ⟶ X, f ≫ h ≫ f = f →
      (∃ v : Z ⟶ Y, g ≫ v ≫ g = g) ∧
        ∀ (A : D) (y : A ⟶ Y), y ≫ g = 0 → ∃ x : A ⟶ X, x ≫ f = y := by
    intro X Y Z f g hfg hex hY h hh
    obtain ⟨v, hv⟩ := liftInj f g hfg hex hY (𝟙 Y - h ≫ f)
      (by rw [Preadditive.comp_sub, Category.comp_id, hh, sub_self])
    refine ⟨⟨v, ?_⟩, fun A y hy => ⟨y ≫ h, ?_⟩⟩
    · rw [← Category.assoc, hv, Preadditive.sub_comp, Category.id_comp, Category.assoc, hfg,
        Limits.comp_zero, sub_zero]
    · have h1 : y ≫ (𝟙 Y - h ≫ f) = 0 := by
        rw [← hv, ← Category.assoc, hy, Limits.zero_comp]
      rw [Preadditive.comp_sub, Category.comp_id, sub_eq_zero] at h1
      rw [Category.assoc, ← h1]
  have hT0 : T.d (0 - 1) 0 = 0 := T.shape _ _ (by simp)
  have hK0 : K.d (0 - 1) 0 = 0 := K.shape _ _ (by simp)

  obtain ⟨dd, hddf, hdds⟩ : ∃ dd : ∀ j : ℕ, (T.X (j + 1) ⊞ K.X j ⟶ T.X (j + 1 + 1) ⊞ K.X (j + 1)),
      (∀ j, dd j ≫ Limits.biprod.fst = -(Limits.biprod.fst ≫ T.d (j + 1) (j + 1 + 1))) ∧
      (∀ j, dd j ≫ Limits.biprod.snd =
        Limits.biprod.fst ≫ Ψ.f (j + 1) + Limits.biprod.snd ≫ K.d j (j + 1)) :=
    ⟨fun j => Limits.biprod.lift (-(Limits.biprod.fst ≫ T.d (j + 1) (j + 1 + 1)))
        (Limits.biprod.fst ≫ Ψ.f (j + 1) + Limits.biprod.snd ≫ K.d j (j + 1)),
      fun j => Limits.biprod.lift_fst _ _, fun j => Limits.biprod.lift_snd _ _⟩
  obtain ⟨D0, hD0f, hD0s⟩ : ∃ D0 : T.X 0 ⟶ T.X (0 + 1) ⊞ K.X 0,
      D0 ≫ Limits.biprod.fst = -T.d 0 (0 + 1) ∧ D0 ≫ Limits.biprod.snd = Ψ.f 0 :=
    ⟨Limits.biprod.lift (-T.d 0 (0 + 1)) (Ψ.f 0), Limits.biprod.lift_fst _ _,
      Limits.biprod.lift_snd _ _⟩
  have cf : ∀ j {A : D} (x : A ⟶ T.X (j + 1) ⊞ K.X j), (x ≫ dd j) ≫ Limits.biprod.fst =
      -((x ≫ Limits.biprod.fst) ≫ T.d (j + 1) (j + 1 + 1)) := by
    intro j A x
    simp only [Category.assoc, hddf, Preadditive.comp_neg]
  have cs : ∀ j {A : D} (x : A ⟶ T.X (j + 1) ⊞ K.X j), (x ≫ dd j) ≫ Limits.biprod.snd =
      (x ≫ Limits.biprod.fst) ≫ Ψ.f (j + 1) + (x ≫ Limits.biprod.snd) ≫ K.d j (j + 1) := by
    intro j A x
    simp only [Category.assoc, hdds, Preadditive.comp_add]
  have c0f : ∀ {A : D} (x : A ⟶ T.X 0), (x ≫ D0) ≫ Limits.biprod.fst = -(x ≫ T.d 0 (0 + 1)) := by
    intro A x
    simp only [Category.assoc, hD0f, Preadditive.comp_neg]
  have c0s : ∀ {A : D} (x : A ⟶ T.X 0), (x ≫ D0) ≫ Limits.biprod.snd = x ≫ Ψ.f 0 := by
    intro A x
    simp only [Category.assoc, hD0s]
  have hDD : ∀ j, dd j ≫ dd (j + 1) = 0 := by
    intro j
    apply Limits.biprod.hom_ext
    · rw [cf, hddf, Preadditive.neg_comp, neg_neg, Category.assoc, HomologicalComplex.d_comp_d,
        Limits.comp_zero, Limits.zero_comp]
    · rw [cs, hddf, hdds, Limits.zero_comp, Preadditive.neg_comp, Preadditive.add_comp,
        Category.assoc, Category.assoc, Category.assoc, HomologicalComplex.d_comp_d,
        Limits.comp_zero, add_zero, HomologicalComplex.Hom.comm, neg_add_cancel]
  have hD0dd : D0 ≫ dd 0 = 0 := by
    apply Limits.biprod.hom_ext
    · rw [cf, hD0f, Preadditive.neg_comp, neg_neg, HomologicalComplex.d_comp_d, Limits.zero_comp]
    · rw [cs, hD0f, hD0s, Limits.zero_comp, Preadditive.neg_comp, HomologicalComplex.Hom.comm,
        neg_add_cancel]

  have hinjS : ∀ j, j ≤ m → ∀ (A : D) (t : A ⟶ T.X (j + 1)), t ≫ T.d (j + 1) (j + 1 + 1) = 0 →
      ∀ x : A ⟶ K.X j, t ≫ Ψ.f (j + 1) = x ≫ K.d j (j + 1) →
      ∃ (A' : D) (π : A' ⟶ A) (_ : Epi π) (u : A' ⟶ T.X j), π ≫ t = u ≫ T.d j (j + 1) :=
    fun j hj A t ht x hx => hinj (j + 1) (by omega) A t ht x hx
  have chase : ∀ j, j ≤ m → ∀ (A : D) (t : A ⟶ T.X (j + 1)) (x : A ⟶ K.X j),
      t ≫ T.d (j + 1) (j + 1 + 1) = 0 → t ≫ Ψ.f (j + 1) + x ≫ K.d j (j + 1) = 0 →
      ∃ (A' : D) (π : A' ⟶ A) (_ : Epi π) (w : A' ⟶ T.X j) (x' : A' ⟶ K.X (j - 1)),
        w ≫ T.d j (j + 1) = -(π ≫ t) ∧ w ≫ Ψ.f j + x' ≫ K.d (j - 1) j = π ≫ x := by
    intro j hj A t x ht h
    obtain ⟨A1, π1, hπ1, u, hu⟩ := hinjS j hj A t ht (-x) (by
      rw [Preadditive.neg_comp, eq_neg_iff_add_eq_zero]; exact h)
    have hk' : (π1 ≫ x + u ≫ Ψ.f j) ≫ K.d j (j + 1) = 0 := by
      have e1 : u ≫ Ψ.f j ≫ K.d j (j + 1) = π1 ≫ t ≫ Ψ.f (j + 1) := by
        rw [HomologicalComplex.Hom.comm, ← Category.assoc, ← hu, Category.assoc]
      have e2 : π1 ≫ (t ≫ Ψ.f (j + 1) + x ≫ K.d j (j + 1)) = 0 := by
        rw [h, Limits.comp_zero]
      rw [Preadditive.comp_add] at e2
      rw [Preadditive.add_comp, Category.assoc, Category.assoc, e1]
      exact (add_comm _ _).trans e2
    obtain ⟨A2, π2, hπ2, s, x', hs, hsy⟩ := hsurj j hj A1 _ hk'
    refine ⟨A2, π2 ≫ π1, epi_comp _ _, s - π2 ≫ u, x', ?_, ?_⟩
    · rw [Preadditive.sub_comp, hs, zero_sub]
      simp only [Category.assoc]
      rw [← hu]
    · rw [Preadditive.comp_add] at hsy
      rw [Preadditive.sub_comp, sub_add_eq_add_sub, ← hsy]
      simp only [Category.assoc]
      abel
  have chaseS : ∀ j, j + 1 ≤ m → ∀ (A : D) (t : A ⟶ T.X (j + 1 + 1)) (x : A ⟶ K.X (j + 1)),
      t ≫ T.d (j + 1 + 1) (j + 1 + 1 + 1) = 0 →
      t ≫ Ψ.f (j + 1 + 1) + x ≫ K.d (j + 1) (j + 1 + 1) = 0 →
      ∃ (A' : D) (π : A' ⟶ A) (_ : Epi π) (w : A' ⟶ T.X (j + 1)) (x' : A' ⟶ K.X j),
        w ≫ T.d (j + 1) (j + 1 + 1) = -(π ≫ t) ∧ w ≫ Ψ.f (j + 1) + x' ≫ K.d j (j + 1) = π ≫ x :=
    fun j hj => chase (j + 1) hj

  have E0 : ∀ (A : D) (y : A ⟶ T.X 0), y ≫ T.d 0 (0 + 1) = 0 → y ≫ Ψ.f 0 = 0 → y = 0 := by
    intro A y h1 h2
    obtain ⟨A', π, hπ, u, hu⟩ := hinj 0 (by omega) A y h1 0 (by rw [h2, Limits.zero_comp])
    rw [hT0, Limits.comp_zero] at hu
    exact (cancel_epi π).mp (by rw [hu, Limits.comp_zero])
  have E1 : ∀ ⦃A : D⦄ (y : A ⟶ T.X (0 + 1) ⊞ K.X 0), y ≫ dd 0 = 0 →
      ∃ (A' : D) (π : A' ⟶ A) (_ : Epi π) (x : A' ⟶ T.X 0), π ≫ y = x ≫ D0 := by
    intro A y hy
    have h1 : (y ≫ Limits.biprod.fst) ≫ T.d (0 + 1) (0 + 1 + 1) = 0 := by
      rw [← neg_eq_zero, ← cf 0 y, hy, Limits.zero_comp]
    have h2 : (y ≫ Limits.biprod.fst) ≫ Ψ.f (0 + 1) + (y ≫ Limits.biprod.snd) ≫ K.d 0 (0 + 1) = 0 := by
      rw [← cs 0 y, hy, Limits.zero_comp]
    obtain ⟨A', π, hπ, w, x', hw1, hw2⟩ := chase 0 (Nat.zero_le _) A _ _ h1 h2
    refine ⟨A', π, hπ, w, ?_⟩
    rw [hK0, Limits.comp_zero, add_zero] at hw2
    apply Limits.biprod.hom_ext
    · rw [c0f, hw1, neg_neg, Category.assoc]
    · rw [c0s, hw2, Category.assoc]
  have ES : ∀ j, j + 1 ≤ m → ∀ ⦃A : D⦄ (y : A ⟶ T.X (j + 1 + 1) ⊞ K.X (j + 1)), y ≫ dd (j + 1) = 0 →
      ∃ (A' : D) (π : A' ⟶ A) (_ : Epi π) (x : A' ⟶ T.X (j + 1) ⊞ K.X j), π ≫ y = x ≫ dd j := by
    intro j hj A y hy
    have h1 : (y ≫ Limits.biprod.fst) ≫ T.d (j + 1 + 1) (j + 1 + 1 + 1) = 0 := by
      rw [← neg_eq_zero, ← cf (j + 1) y, hy, Limits.zero_comp]
    have h2 : (y ≫ Limits.biprod.fst) ≫ Ψ.f (j + 1 + 1) +
        (y ≫ Limits.biprod.snd) ≫ K.d (j + 1) (j + 1 + 1) = 0 := by
      rw [← cs (j + 1) y, hy, Limits.zero_comp]
    obtain ⟨A', π, hπ, w, x', hw1, hw2⟩ := chaseS j hj A _ _ h1 h2
    refine ⟨A', π, hπ, Limits.biprod.lift w x', ?_⟩
    apply Limits.biprod.hom_ext
    · rw [cf, Limits.biprod.lift_fst, hw1, neg_neg, Category.assoc]
    · rw [cs, Limits.biprod.lift_fst, Limits.biprod.lift_snd, hw2, Category.assoc]

  have hInjB : ∀ j, Injective (T.X (j + 1) ⊞ K.X j) := fun j => by
    haveI := hT (j + 1); haveI := hK j; infer_instance
  haveI : Mono D0 := Preadditive.mono_of_cancel_zero _ (fun {A} y hy =>
    E0 A y (neg_eq_zero.mp (by rw [← c0f, hy, Limits.zero_comp]))
      (by rw [← c0s, hy, Limits.zero_comp]))
  haveI := hT 0
  obtain ⟨h0, hh0⟩ : ∃ h0 : T.X (0 + 1) ⊞ K.X 0 ⟶ T.X 0, D0 ≫ h0 = 𝟙 _ :=
    ⟨Injective.factorThru (𝟙 _) D0, Injective.comp_factorThru _ _⟩
  have hD0h0 : D0 ≫ h0 ≫ D0 = D0 := by rw [← Category.assoc, hh0, Category.id_comp]
  have hP : ∀ j, j ≤ m → ∃ v : T.X (j + 1 + 1) ⊞ K.X (j + 1) ⟶ T.X (j + 1) ⊞ K.X j,
      dd j ≫ v ≫ dd j = dd j := by
    intro j
    induction j with
    | zero =>
      intro _
      exact (hstep D0 (dd 0) hD0dd E1 (hInjB 0) h0 hD0h0).1
    | succ j ih =>
      intro hj
      obtain ⟨v, hv⟩ := ih (by omega)
      exact (hstep (dd j) (dd (j + 1)) (hDD j) (ES j hj) (hInjB (j + 1)) v hv).1
  have HB0 : ∀ (A : D) (y : A ⟶ T.X (0 + 1) ⊞ K.X 0), y ≫ dd 0 = 0 → ∃ x : A ⟶ T.X 0, x ≫ D0 = y :=
    (hstep D0 (dd 0) hD0dd E1 (hInjB 0) h0 hD0h0).2
  have HBS : ∀ j, j + 1 ≤ m → ∀ (A : D) (y : A ⟶ T.X (j + 1 + 1) ⊞ K.X (j + 1)),
      y ≫ dd (j + 1) = 0 → ∃ x : A ⟶ T.X (j + 1) ⊞ K.X j, x ≫ dd j = y := by
    intro j hj
    obtain ⟨v, hv⟩ := hP j (by omega)
    exact (hstep (dd j) (dd (j + 1)) (hDD j) (ES j hj) (hInjB (j + 1)) v hv).2

  refine ⟨fun A c hc => ?_, fun A t ht e he => ?_⟩
  · cases m with
    | zero =>
      obtain ⟨x, hx⟩ := HB0 A (Limits.biprod.lift 0 c) (by
        apply Limits.biprod.hom_ext
        · simp only [cf, Limits.biprod.lift_fst, Limits.zero_comp, neg_zero]
        · simp only [cs, Limits.biprod.lift_fst, Limits.biprod.lift_snd, Limits.zero_comp,
            zero_add, hc])
      have h1 := c0f x
      have h2 := c0s x
      rw [hx, Limits.biprod.lift_fst] at h1
      rw [hx, Limits.biprod.lift_snd] at h2
      refine ⟨x, neg_eq_zero.mp h1.symm, 0, ?_⟩
      rw [← h2, sub_self, Limits.zero_comp]
    | succ j =>
      obtain ⟨x, hx⟩ := HBS j le_rfl A (Limits.biprod.lift 0 c) (by
        apply Limits.biprod.hom_ext
        · simp only [cf, Limits.biprod.lift_fst, Limits.zero_comp, neg_zero]
        · simp only [cs, Limits.biprod.lift_fst, Limits.biprod.lift_snd, Limits.zero_comp,
            zero_add, hc])
      have h1 := cf j x
      have h2 := cs j x
      rw [hx, Limits.biprod.lift_fst] at h1
      rw [hx, Limits.biprod.lift_snd] at h2
      have key : c - (x ≫ Limits.biprod.fst) ≫ Ψ.f (j + 1) =
          (x ≫ Limits.biprod.snd) ≫ K.d j (j + 1) := by
        rw [h2]; abel
      exact ⟨x ≫ Limits.biprod.fst, neg_eq_zero.mp h1.symm, x ≫ Limits.biprod.snd, key⟩
  · cases m with
    | zero =>
      have h0' : t = 0 := E0 A t ht (by rw [he, hK0, Limits.comp_zero])
      exact ⟨0, by rw [Limits.zero_comp, h0']⟩
    | succ j =>
      obtain ⟨e₁, he₁⟩ : ∃ e₁ : A ⟶ K.X j, t ≫ Ψ.f (j + 1) = e₁ ≫ K.d j (j + 1) := ⟨e, he⟩
      have hy : Limits.biprod.lift t (-e₁) ≫ dd j = 0 := by
        apply Limits.biprod.hom_ext
        · rw [cf, Limits.biprod.lift_fst, ht, neg_zero, Limits.zero_comp]
        · rw [cs, Limits.biprod.lift_fst, Limits.biprod.lift_snd, he₁, Preadditive.neg_comp,
            add_neg_cancel, Limits.zero_comp]
      cases j with
      | zero =>
        obtain ⟨x, hx⟩ := HB0 A _ hy
        have h1 := c0f x
        rw [hx, Limits.biprod.lift_fst] at h1
        have key : (-x) ≫ T.d 0 (0 + 1) = t := by
          rw [Preadditive.neg_comp]; exact h1.symm
        exact ⟨-x, key⟩
      | succ i =>
        obtain ⟨x, hx⟩ := HBS i (by omega) A _ hy
        have h1 := cf i x
        rw [hx, Limits.biprod.lift_fst] at h1
        have key : (-(x ≫ Limits.biprod.fst)) ≫ T.d (i + 1) (i + 1 + 1) = t := by
          rw [Preadditive.neg_comp]; exact h1.symm
        exact ⟨-(x ≫ Limits.biprod.fst), key⟩

theorem wc_lh_shift_block_complex : ∀ {D : Type*} [Category D] [Abelian D] (P : D) (J : InjectiveResolution P) (n : ℕ), ∃ (C : CochainComplex D ℕ) (e : (k a : ℕ) → n + a = k → (C.X k ≅ J.cocomplex.X a)), (∀ j, Injective (C.X j)) ∧ (∀ k, k < n → Limits.IsZero (C.X k)) ∧ (∀ (k k' a a' : ℕ) (h : n + a = k) (h' : n + a' = k'), (e k a h).inv ≫ C.d k k' = J.cocomplex.d a a' ≫ (e k' a' h').inv) :=
by
  intro D _ _ P J n
  let C : CochainComplex D ℕ :=
    { X := fun k => J.cochainComplex.X ((k : ℤ) - n)
      d := fun k k' => J.cochainComplex.d ((k : ℤ) - n) ((k' : ℤ) - n)
      shape := fun i j hij => by
        apply J.cochainComplex.shape
        simp only [ComplexShape.up_Rel] at hij ⊢
        omega
      d_comp_d' := fun i j l _ _ => J.cochainComplex.d_comp_d _ _ _ }
  let e : (k a : ℕ) → n + a = k → (C.X k ≅ J.cocomplex.X a) := fun k a h =>
    J.cochainComplexXIso ((k : ℤ) - n) a (by omega)
  have hZ : ∀ k, k < n → Limits.IsZero (C.X k) := by
    intro k hk
    show Limits.IsZero (J.cochainComplex.X ((k : ℤ) - n))
    exact HomologicalComplex.isZero_extend_X _ _ _ (fun i hi => by
      have h' : ((i : ℕ) : ℤ) = (k : ℤ) - n := hi
      omega)
  have hI : ∀ j, Injective (C.X j) := by
    intro j
    by_cases hj : n ≤ j
    · obtain ⟨a, ha⟩ := Nat.exists_eq_add_of_le hj
      exact Injective.of_iso (e j a ha.symm).symm (J.injective a)
    · exact (hZ j (by omega)).injective
  refine ⟨C, e, hI, hZ, ?_⟩
  intro k k' a a' h h'
  show (J.cochainComplexXIso ((k : ℤ) - n) a (by omega)).inv ≫
      J.cochainComplex.d ((k : ℤ) - n) ((k' : ℤ) - n) =
    J.cocomplex.d a a' ≫ (J.cochainComplexXIso ((k' : ℤ) - n) a' (by omega)).inv
  rw [InjectiveResolution.cochainComplex_d J ((k : ℤ) - n) ((k' : ℤ) - n) a a' (by omega)
    (by omega), Iso.inv_hom_id_assoc]

theorem wc_lh_shift_block_chain_map : ∀ {D : Type*} [Category D] [Abelian D] (K : CochainComplex D ℕ) (P : D) (J : InjectiveResolution P) (n : ℕ) (ψ : (k : ℕ) → (J.cocomplex.X k ⟶ K.X (n + k))), (∀ k, ψ k ≫ K.d (n + k) (n + k + 1) = J.cocomplex.d k (k + 1) ≫ ψ (k + 1)) → ∀ (C : CochainComplex D ℕ) (e : (k a : ℕ) → n + a = k → (C.X k ≅ J.cocomplex.X a)), (∀ k, k < n → Limits.IsZero (C.X k)) → (∀ (k k' a a' : ℕ) (h : n + a = k) (h' : n + a' = k'), (e k a h).inv ≫ C.d k k' = J.cocomplex.d a a' ≫ (e k' a' h').inv) → ∃ f : C ⟶ K, ∀ (k a : ℕ) (h : n + a = k), (e k a h).inv ≫ f.f k = ψ a ≫ (K.XIsoOfEq h).hom :=
by
  intro D _ _ K P J n ψ hψ C e hz hCd
  classical
  obtain ⟨g, hgdef⟩ : ∃ g : (k : ℕ) → (C.X k ⟶ K.X k), ∀ (k : ℕ) (hk : n ≤ k),
      g k = (e k (k - n) (by omega)).hom ≫ ψ (k - n) ≫
        (K.XIsoOfEq (show n + (k - n) = k by omega)).hom :=
    ⟨fun k => if hk : n ≤ k then (e k (k - n) (by omega)).hom ≫ ψ (k - n) ≫
        (K.XIsoOfEq (show n + (k - n) = k by omega)).hom else 0,
      fun k hk => dif_pos hk⟩
  have aux : ∀ (k a a' : ℕ) (ha : a = a') (h : n + a = k) (h' : n + a' = k) (h'' : n + a' = k),
      (e k a h).inv ≫ (e k a' h').hom ≫ ψ a' ≫ (K.XIsoOfEq h'').hom =
        ψ a ≫ (K.XIsoOfEq h).hom := by
    intro k a a' ha h h' h''
    subst ha
    exact Iso.inv_hom_id_assoc _ _
  have hg : ∀ (k a : ℕ) (h : n + a = k), (e k a h).inv ≫ g k = ψ a ≫ (K.XIsoOfEq h).hom := by
    intro k a h
    have hk : n ≤ k := by omega
    rw [hgdef k hk]
    exact aux k a (k - n) (by omega) h _ _
  have comm : ∀ i j, (ComplexShape.up ℕ).Rel i j → g i ≫ K.d i j = C.d i j ≫ g j := by
    intro i j hij
    simp only [ComplexShape.up_Rel] at hij
    subst hij
    by_cases hi : i < n
    · exact (hz i hi).eq_of_src _ _
    · obtain ⟨a, rfl⟩ : ∃ a, i = n + a := ⟨i - n, by omega⟩
      have h' : n + (a + 1) = n + a + 1 := by omega
      rw [← cancel_epi (e (n + a) a rfl).inv, reassoc_of% (hg (n + a) a rfl),
        reassoc_of% (hCd (n + a) (n + a + 1) a (a + 1) rfl h'), hg (n + a + 1) (a + 1) h',
        HomologicalComplex.XIsoOfEq_rfl, Iso.refl_hom, Category.id_comp, hψ a]
      have hX : (K.XIsoOfEq h').hom = 𝟙 _ := rfl
      rw [hX, Category.comp_id]
  exact ⟨{ f := g, comm' := comm }, hg⟩

theorem wc_lh_finite_sum_complex : ∀ {D : Type*} [Category D] [Abelian D] {S : Type} [Fintype S] (C : S → CochainComplex D ℕ) (K : CochainComplex D ℕ) (f : (s : S) → (C s ⟶ K)), ∃ (T : CochainComplex D ℕ) (Ψ : T ⟶ K) (ι : (s : S) → (k : ℕ) → ((C s).X k ⟶ T.X k)) (p : (s : S) → (k : ℕ) → (T.X k ⟶ (C s).X k)), (∀ s k, ι s k ≫ p s k = 𝟙 _) ∧ (∀ s s' k, s ≠ s' → ι s k ≫ p s' k = 0) ∧ (∀ k, ∑ s, p s k ≫ ι s k = 𝟙 (T.X k)) ∧ (∀ s k k', ι s k ≫ T.d k k' = (C s).d k k' ≫ ι s k') ∧ (∀ s k k', T.d k k' ≫ p s k' = p s k ≫ (C s).d k k') ∧ (∀ s k, ι s k ≫ Ψ.f k = (f s).f k) ∧ ((∀ s j, Injective ((C s).X j)) → ∀ j, Injective (T.X j)) :=
by
  intro D _ _ S _ C K f
  haveI : Limits.HasFiniteBiproducts D := Abelian.hasFiniteBiproducts
  let T : CochainComplex D ℕ :=
    { X := fun k => Limits.biproduct (fun s => (C s).X k)
      d := fun k k' => Limits.biproduct.map (fun s => (C s).d k k')
      shape := fun k k' h => by
        apply Limits.biproduct.hom_ext
        intro j
        rw [Limits.biproduct.map_π, (C j).shape _ _ h, Limits.comp_zero, Limits.zero_comp]
      d_comp_d' := fun k k' k'' _ _ => by
        apply Limits.biproduct.hom_ext
        intro j
        rw [Category.assoc, Limits.biproduct.map_π, ← Category.assoc, Limits.biproduct.map_π,
          Category.assoc, HomologicalComplex.d_comp_d, Limits.comp_zero, Limits.zero_comp] }
  let Ψ : T ⟶ K :=
    { f := fun k => Limits.biproduct.desc (fun s => (f s).f k)
      comm' := fun i j _ => by
        show Limits.biproduct.desc (fun s => (f s).f i) ≫ K.d i j =
          Limits.biproduct.map (fun s => (C s).d i j) ≫ Limits.biproduct.desc (fun s => (f s).f j)
        apply Limits.biproduct.hom_ext'
        intro s
        rw [Limits.biproduct.ι_desc_assoc, Limits.biproduct.ι_map_assoc, Limits.biproduct.ι_desc,
          (f s).comm] }
  refine ⟨T, Ψ, fun s k => Limits.biproduct.ι (fun s => (C s).X k) s,
    fun s k => Limits.biproduct.π (fun s => (C s).X k) s, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro s k; exact Limits.biproduct.ι_π_self _ s
  · intro s s' k h; exact Limits.biproduct.ι_π_ne _ h
  · intro k; exact Limits.biproduct.total
  · intro s k k'; exact Limits.biproduct.ι_map (fun s => (C s).d k k') s
  · intro s k k'; exact Limits.biproduct.map_π (fun s => (C s).d k k') s
  · intro s k; exact Limits.biproduct.ι_desc _ s
  · intro h j
    haveI : ∀ s, Injective ((C s).X j) := fun s => h s j
    exact Injective.instBiproduct _

theorem wc_lh_model_T_cohomology : ∀ {D : Type*} [Category D] [Abelian D] (K : CochainComplex D ℕ) (P : D) (J : InjectiveResolution P) (m : ℕ) (r : ℕ → ℕ) (φ : (n : ℕ) → Fin (r n) → (P ⟶ K.X n)) (ψ : (n : ℕ) → Fin (r n) → (k : ℕ) → (J.cocomplex.X k ⟶ K.X (n + k))), (∀ n i, J.ι.f 0 ≫ ψ n i 0 = φ n i) → ∀ (C : ℕ → CochainComplex D ℕ) (e : (n k a : ℕ) → n + a = k → ((C n).X k ≅ J.cocomplex.X a)), (∀ n k, k < n → Limits.IsZero ((C n).X k)) → (∀ (n k k' a a' : ℕ) (h : n + a = k) (h' : n + a' = k'), (e n k a h).inv ≫ (C n).d k k' = J.cocomplex.d a a' ≫ (e n k' a' h').inv) → ∀ (T : CochainComplex D ℕ) (Ψ : T ⟶ K) (ι : (s : Σ n : Fin (m + 1), Fin (r n)) → (k : ℕ) → ((C s.1).X k ⟶ T.X k)) (p : (s : Σ n : Fin (m + 1), Fin (r n)) → (k : ℕ) → (T.X k ⟶ (C s.1).X k)), (∀ k, ∑ s, p s k ≫ ι s k = 𝟙 (T.X k)) → (∀ s k k', ι s k ≫ T.d k k' = (C s.1).d k k' ≫ ι s k') → (∀ s k k', T.d k k' ≫ p s k' = p s k ≫ (C s.1).d k k') → (∀ (s : Σ n : Fin (m + 1), Fin (r n)) (k a : ℕ) (h : (s.1 : ℕ) + a = k), (e s.1 k a h).inv ≫ ι s k ≫ Ψ.f k = ψ s.1 s.2 a ≫ (K.XIsoOfEq h).hom) → (∀ k, k ≤ m + 1 → ∀ (A : D) (a : Fin (r k) → (A ⟶ P)) (x : A ⟶ K.X (k - 1)), ∑ i, a i ≫ φ k i = x ≫ K.d (k - 1) k → ∀ i, a i = 0) → (∀ k, k ≤ m → ∀ (A : D) (y : A ⟶ K.X k), y ≫ K.d k (k + 1) = 0 → ∃ (A' : D) (π : A' ⟶ A) (_ : Epi π) (a : Fin (r k) → (A' ⟶ P)) (x : A' ⟶ K.X (k - 1)), π ≫ y = ∑ i, a i ≫ φ k i + x ≫ K.d (k - 1) k) → (∀ k, k ≤ m + 1 → ∀ (A : D) (t : A ⟶ T.X k), t ≫ T.d k (k + 1) = 0 → ∀ x : A ⟶ K.X (k - 1), t ≫ Ψ.f k = x ≫ K.d (k - 1) k → ∃ (A' : D) (π : A' ⟶ A) (_ : Epi π) (u : A' ⟶ T.X (k - 1)), π ≫ t = u ≫ T.d (k - 1) k) ∧ (∀ k, k ≤ m → ∀ (A : D) (y : A ⟶ K.X k), y ≫ K.d k (k + 1) = 0 → ∃ (A' : D) (π : A' ⟶ A) (_ : Epi π) (s : A' ⟶ T.X k) (x : A' ⟶ K.X (k - 1)), s ≫ T.d k (k + 1) = 0 ∧ π ≫ y = s ≫ Ψ.f k + x ≫ K.d (k - 1) k) :=
by
  intro D _ _ K P J m r φ ψ hψ0 C e hCzero hCd T Ψ ι p htot hιd hdp hΨ hinj hsurj
  classical

  obtain ⟨ι₀, hι₀⟩ : ∃ ι₀ : P ⟶ J.cocomplex.X 0, ι₀ = J.ι.f 0 := ⟨J.ι.f 0, rfl⟩
  have hψ0' : ∀ n i, ι₀ ≫ ψ n i 0 = φ n i := fun n i => by rw [hι₀]; exact hψ0 n i
  have hι₀d : ι₀ ≫ J.cocomplex.d 0 1 = 0 := by rw [hι₀]; exact J.ι_f_zero_comp_complex_d

  have hD1 : ∀ (n k k' a a' : ℕ) (h : n + a = k) (h' : n + a' = k'),
      (C n).d k k' ≫ (e n k' a' h').hom = (e n k a h).hom ≫ J.cocomplex.d a a' := by
    intro n k k' a a' h h'
    rw [← cancel_epi (e n k a h).inv, reassoc_of% (hCd n k k' a a' h h')]
    simp

  have hterm : ∀ (k : ℕ) (hk' : k < m + 1) (i : Fin (r k)),
      ι₀ ≫ (e k k 0 rfl).inv ≫ ι ⟨⟨k, hk'⟩, i⟩ k ≫ Ψ.f k = φ k i := by
    intro k hk' i
    have h : (e k k 0 rfl).inv ≫ ι ⟨⟨k, hk'⟩, i⟩ k ≫ Ψ.f k =
        ψ k i 0 ≫ (K.XIsoOfEq (rfl : k = k)).hom := hΨ ⟨⟨k, hk'⟩, i⟩ k 0 rfl
    rw [HomologicalComplex.XIsoOfEq_rfl, Iso.refl_hom] at h
    rw [h]
    exact (congrArg (fun z => ι₀ ≫ z) (Category.comp_id (ψ k i 0))).trans (hψ0' k i)

  have hblock : ∀ (n k : ℕ) (κ' : P ⟶ (C n).X k),
      (∀ h : n + 0 = k, κ' = ι₀ ≫ (e n k 0 h).inv) → (n ≠ k → κ' = 0) →
      ∀ (A : D) (t : A ⟶ (C n).X k), t ≫ (C n).d k (k + 1) = 0 →
      ∃ (A' : D) (π : A' ⟶ A) (_ : Epi π) (a : A' ⟶ P) (u : A' ⟶ (C n).X (k - 1)),
        π ≫ t = a ≫ κ' + u ≫ (C n).d (k - 1) k := by
    intro n k κ' hκ1 hκ0 A t ht
    rcases lt_trichotomy n k with hlt | heq | hgt
    · obtain ⟨b, rfl⟩ : ∃ b, k = n + (b + 1) := ⟨k - n - 1, by omega⟩
      have hb0 : n + b = n + (b + 1) - 1 := by omega
      have ht'c : (t ≫ (e n (n + (b + 1)) (b + 1) rfl).hom) ≫ J.cocomplex.d (b + 1) (b + 2) = 0 := by
        rw [Category.assoc, ← hD1 n (n + (b + 1)) (n + (b + 1) + 1) (b + 1) (b + 2) rfl (by omega),
          reassoc_of% ht, Limits.zero_comp]
      obtain ⟨A', π, hπ, x₁, hx₁⟩ := (J.exact_succ b).exact_up_to_refinements _ ht'c
      have hx₁' : π ≫ t ≫ (e n (n + (b + 1)) (b + 1) rfl).hom = x₁ ≫ J.cocomplex.d b (b + 1) := by
        exact hx₁
      refine ⟨A', π, hπ, 0, x₁ ≫ (e n (n + (b + 1) - 1) b hb0).inv, ?_⟩
      rw [hκ0 (by omega), Limits.zero_comp, zero_add, Category.assoc,
        hCd n (n + (b + 1) - 1) (n + (b + 1)) b (b + 1) hb0 rfl, ← Category.assoc, ← hx₁']
      simp
    · cases heq
      have ht'c : (t ≫ (e n n 0 rfl).hom) ≫ J.cocomplex.d 0 1 = 0 := by
        rw [Category.assoc, ← hD1 n n (n + 1) 0 1 rfl rfl, reassoc_of% ht, Limits.zero_comp]
      obtain ⟨A', π, hπ, x₁, hx₁⟩ := J.exact₀.exact_up_to_refinements _ ht'c
      obtain ⟨a, ha⟩ : ∃ a : A' ⟶ P, π ≫ t ≫ (e n n 0 rfl).hom = a ≫ ι₀ :=
        ⟨x₁, by rw [hι₀]; exact hx₁⟩
      refine ⟨A', π, hπ, a, 0, ?_⟩
      rw [hκ1 rfl, Limits.zero_comp, add_zero, ← Category.assoc, ← ha]
      simp
    · refine ⟨A, 𝟙 A, inferInstance, 0, 0, ?_⟩
      rw [(hCzero n k hgt).eq_of_tgt t 0]
      simp
  refine ⟨?_, ?_⟩
  ·
    intro k hk A t ht x hx
    obtain ⟨κ, hκ1, hκ0⟩ : ∃ κ : (s : Σ n : Fin (m + 1), Fin (r n)) → (P ⟶ (C s.1).X k),
        (∀ (s : Σ n : Fin (m + 1), Fin (r n)) (h : (s.1 : ℕ) + 0 = k),
          κ s = ι₀ ≫ (e s.1 k 0 h).inv) ∧
        (∀ s : Σ n : Fin (m + 1), Fin (r n), (s.1 : ℕ) ≠ k → κ s = 0) :=
      ⟨fun s => if h : (s.1 : ℕ) = k then ι₀ ≫ (e s.1 k 0 (by omega)).inv else 0,
        fun s h => dif_pos (show (s.1 : ℕ) = k by omega),
        fun s h => dif_neg h⟩

    have href : ∀ F : Finset (Σ n : Fin (m + 1), Fin (r n)), ∃ (A' : D) (π : A' ⟶ A) (_ : Epi π),
        ∀ s ∈ F, ∃ (a : A' ⟶ P) (U : A' ⟶ (C s.1).X (k - 1)),
          π ≫ t ≫ p s k = a ≫ κ s + U ≫ (C s.1).d (k - 1) k := by
      intro F
      induction F using Finset.induction_on with
      | empty => exact ⟨A, 𝟙 A, inferInstance, fun s hs => by simp at hs⟩
      | insert s₀ F hs₀ ih =>
        obtain ⟨A₁, π₁, hπ₁, H₁⟩ := ih
        have hc : (π₁ ≫ t ≫ p s₀ k) ≫ (C s₀.1).d k (k + 1) = 0 := by
          rw [Category.assoc, Category.assoc, ← hdp, reassoc_of% ht, Limits.zero_comp,
            Limits.comp_zero]
        obtain ⟨A₂, g, hg, a, U, hgU⟩ := hblock s₀.1 k (κ s₀) (hκ1 s₀) (hκ0 s₀) A₁ _ hc
        refine ⟨A₂, g ≫ π₁, epi_comp g π₁, fun s hs => ?_⟩
        rcases Finset.mem_insert.mp hs with rfl | hs
        · exact ⟨a, U, by rw [Category.assoc]; exact hgU⟩
        · obtain ⟨a', U', h'⟩ := H₁ s hs
          refine ⟨g ≫ a', g ≫ U', ?_⟩
          rw [Category.assoc, h']
          simp only [Preadditive.comp_add, Category.assoc]
    obtain ⟨A', π, hπ, H⟩ := href Finset.univ
    choose a U hU using fun s => H s (Finset.mem_univ s)

    have hexp : π ≫ t = ∑ s, a s ≫ κ s ≫ ι s k +
        (∑ s, U s ≫ ι s (k - 1)) ≫ T.d (k - 1) k := by
      calc π ≫ t = (π ≫ t) ≫ ∑ s, p s k ≫ ι s k := by rw [htot, Category.comp_id]
        _ = ∑ s, (π ≫ t ≫ p s k) ≫ ι s k := by
          rw [Preadditive.comp_sum]; simp only [Category.assoc]
        _ = ∑ s, (a s ≫ κ s + U s ≫ (C s.1).d (k - 1) k) ≫ ι s k := by simp only [hU]
        _ = _ := by
          simp only [Preadditive.add_comp, Finset.sum_add_distrib, Preadditive.sum_comp,
            Category.assoc, hιd]
    have hw : (∑ s, a s ≫ κ s ≫ ι s k) ≫ Ψ.f k =
        (π ≫ x - (∑ s, U s ≫ ι s (k - 1)) ≫ Ψ.f (k - 1)) ≫ K.d (k - 1) k := by
      have h1 : (π ≫ t) ≫ Ψ.f k = π ≫ x ≫ K.d (k - 1) k := by rw [Category.assoc, hx]
      rw [hexp, Preadditive.add_comp, Category.assoc _ (T.d (k - 1) k),
        ← HomologicalComplex.Hom.comm Ψ (k - 1) k] at h1
      rw [Preadditive.sub_comp, Category.assoc, Category.assoc, ← h1, add_sub_cancel_right]

    have hz : ∀ {Y : D} (h : (s : Σ n : Fin (m + 1), Fin (r n)) → ((C s.1).X k ⟶ Y))
        (s : Σ n : Fin (m + 1), Fin (r n)), (s.1 : ℕ) ≠ k → a s ≫ κ s ≫ h s = 0 := by
      intro Y h s hs
      rw [hκ0 s hs, Limits.zero_comp, Limits.comp_zero]
    have hw0 : ∑ s, a s ≫ κ s ≫ ι s k = 0 := by
      by_cases hkm : k ≤ m
      · have hk' : k < m + 1 := by omega
        have hfib : ∀ {X Y : D} (g : (Σ n : Fin (m + 1), Fin (r n)) → (X ⟶ Y)),
            (∀ s : (Σ n : Fin (m + 1), Fin (r n)), (s.1 : ℕ) ≠ k → g s = 0) →
            ∑ s, g s = ∑ i : Fin (r k), g ⟨⟨k, hk'⟩, i⟩ := by
          intro X Y g hg
          rw [Fintype.sum_sigma]
          refine (Finset.sum_eq_single (⟨k, hk'⟩ : Fin (m + 1)) ?_ ?_).trans rfl
          · intro n _ hn
            exact Finset.sum_eq_zero (fun i _ => hg ⟨n, i⟩ (fun h => hn (Fin.ext h)))
          · intro h
            exact absurd (Finset.mem_univ _) h
        have hw' : ∑ i : Fin (r k), a ⟨⟨k, hk'⟩, i⟩ ≫ φ k i =
            (π ≫ x - (∑ s, U s ≫ ι s (k - 1)) ≫ Ψ.f (k - 1)) ≫ K.d (k - 1) k := by
          rw [← hw, Preadditive.sum_comp,
            hfib (fun s => (a s ≫ κ s ≫ ι s k) ≫ Ψ.f k)
              (fun s hs => by simp only [Category.assoc]; exact hz (fun s => ι s k ≫ Ψ.f k) s hs)]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [hκ1 ⟨⟨k, hk'⟩, i⟩ rfl]
          simp only [Category.assoc]
          rw [hterm k hk' i]
        have ha0 := hinj k (by omega) A' (fun i => a ⟨⟨k, hk'⟩, i⟩) _ hw'
        rw [hfib (fun s => a s ≫ κ s ≫ ι s k) (fun s hs => hz (fun s => ι s k) s hs)]
        exact Finset.sum_eq_zero (fun i _ => by
          rw [show a ⟨⟨k, hk'⟩, i⟩ = 0 from ha0 i, Limits.zero_comp])
      · exact Finset.sum_eq_zero (fun s _ => hz (fun s => ι s k) s (by have := s.1.isLt; omega))
    exact ⟨A', π, hπ, ∑ s, U s ≫ ι s (k - 1), by rw [hexp, hw0, zero_add]⟩
  ·
    intro k hk A y hy
    obtain ⟨A', π, hπ, a, x, hxy⟩ := hsurj k hk A y hy
    have hk' : k < m + 1 := by omega
    refine ⟨A', π, hπ, ∑ i : Fin (r k), a i ≫ ι₀ ≫ (e k k 0 rfl).inv ≫ ι ⟨⟨k, hk'⟩, i⟩ k,
      x, ?_, ?_⟩
    · rw [Preadditive.sum_comp]
      refine Finset.sum_eq_zero (fun i _ => ?_)
      simp only [Category.assoc]
      rw [hιd ⟨⟨k, hk'⟩, i⟩ k (k + 1)]
      have h2 : (e k k 0 rfl).inv ≫ (C k).d k (k + 1) =
          J.cocomplex.d 0 1 ≫ (e k (k + 1) 1 rfl).inv := hCd k k (k + 1) 0 1 rfl rfl
      rw [reassoc_of% h2, reassoc_of% hι₀d, Limits.zero_comp, Limits.comp_zero]
    · rw [hxy, Preadditive.sum_comp]
      congr 1
      refine Finset.sum_congr rfl (fun i _ => ?_)
      simp only [Category.assoc]
      rw [hterm k hk' i]

theorem wc_lh_model_read_build : ∀ {D : Type*} [Category D] [Abelian D] (K : CochainComplex D ℕ) (P : D) (J : InjectiveResolution P) (m : ℕ) (r : ℕ → ℕ) (ψ : (n : ℕ) → Fin (r n) → (k : ℕ) → (J.cocomplex.X k ⟶ K.X (n + k))) (C : ℕ → CochainComplex D ℕ) (e : (n k a : ℕ) → n + a = k → ((C n).X k ≅ J.cocomplex.X a)), (∀ n k, k < n → Limits.IsZero ((C n).X k)) → (∀ (n k k' a a' : ℕ) (h : n + a = k) (h' : n + a' = k'), (e n k a h).inv ≫ (C n).d k k' = J.cocomplex.d a a' ≫ (e n k' a' h').inv) → ∀ (T : CochainComplex D ℕ) (Ψ : T ⟶ K) (ι : (s : Σ n : Fin (m + 1), Fin (r n)) → (k : ℕ) → ((C s.1).X k ⟶ T.X k)) (p : (s : Σ n : Fin (m + 1), Fin (r n)) → (k : ℕ) → (T.X k ⟶ (C s.1).X k)), (∀ s k, ι s k ≫ p s k = 𝟙 _) → (∀ s s' k, s ≠ s' → ι s k ≫ p s' k = 0) → (∀ k, ∑ s, p s k ≫ ι s k = 𝟙 (T.X k)) → (∀ s k k', ι s k ≫ T.d k k' = (C s.1).d k k' ≫ ι s k') → (∀ s k k', T.d k k' ≫ p s k' = p s k ≫ (C s.1).d k k') → (∀ (s : Σ n : Fin (m + 1), Fin (r n)) (k a : ℕ) (h : (s.1 : ℕ) + a = k), (e s.1 k a h).inv ≫ ι s k ≫ Ψ.f k = ψ s.1 s.2 a ≫ (K.XIsoOfEq h).hom) → (∀ t : P ⟶ T.X m, t ≫ T.d m (m + 1) = 0 → ∃ β : (n : Fin (m + 1)) → Fin (r n) → (P ⟶ J.cocomplex.X (m - n)), (∀ n i, β n i ≫ J.cocomplex.d (m - n) (m - n + 1) = 0) ∧ t ≫ Ψ.f m = ∑ n : Fin (m + 1), ∑ i : Fin (r n), β n i ≫ ψ n i (m - n) ≫ (K.XIsoOfEq (Nat.add_sub_cancel' (Nat.lt_succ_iff.mp n.isLt))).hom) ∧ (∀ β : (n : Fin (m + 1)) → Fin (r n) → (P ⟶ J.cocomplex.X (m - n)), (∀ n i, β n i ≫ J.cocomplex.d (m - n) (m - n + 1) = 0) → ∃ t : P ⟶ T.X m, t ≫ T.d m (m + 1) = 0 ∧ t ≫ Ψ.f m = ∑ n : Fin (m + 1), ∑ i : Fin (r n), β n i ≫ ψ n i (m - n) ≫ (K.XIsoOfEq (Nat.add_sub_cancel' (Nat.lt_succ_iff.mp n.isLt))).hom ∧ ∀ u : P ⟶ T.X (m - 1), u ≫ T.d (m - 1) m = t → ∀ (n : Fin (m + 1)) (i : Fin (r n)), ∃ γ : P ⟶ J.cocomplex.X (m - n - 1), γ ≫ J.cocomplex.d (m - n - 1) (m - n) = β n i) :=
by
  intro D _ _ K P J m r ψ C e hCzero hCd T Ψ ι p hιp hιp' htot hιd hdp hΨ
  have hnm : ∀ n : Fin (m + 1), (n : ℕ) + (m - n) = m := fun n =>
    Nat.add_sub_cancel' (Nat.lt_succ_iff.mp n.isLt)
  have hD1 : ∀ (n k k' a a' : ℕ) (h : n + a = k) (h' : n + a' = k'),
      (C n).d k k' ≫ (e n k' a' h').hom = (e n k a h).hom ≫ J.cocomplex.d a a' := by
    intro n k k' a a' h h'
    apply (cancel_epi (e n k a h).inv).mp
    rw [← Category.assoc, hCd n k k' a a' h h', Category.assoc, Iso.inv_hom_id, Category.comp_id,
      Iso.inv_hom_id_assoc]
  have hK1 : ∀ (s : Σ n : Fin (m + 1), Fin (r n)), ι s m ≫ Ψ.f m =
      (e s.1 m (m - s.1) (hnm s.1)).hom ≫ ψ s.1 s.2 (m - s.1) ≫ (K.XIsoOfEq (hnm s.1)).hom := by
    intro s
    rw [← hΨ s m (m - s.1) (hnm s.1), Iso.hom_inv_id_assoc]
  refine ⟨fun t ht => ?_, fun β hβ => ?_⟩
  ·
    have hcoc : ∀ s : (Σ n : Fin (m + 1), Fin (r n)),
        (t ≫ p s m ≫ (e s.1 m (m - s.1) (hnm s.1)).hom) ≫
          J.cocomplex.d (m - s.1) (m - s.1 + 1) = 0 := by
      intro s
      have h' : (s.1 : ℕ) + (m - s.1 + 1) = m + 1 := by have := s.1.isLt; omega
      rw [Category.assoc, Category.assoc,
        ← hD1 s.1 m (m + 1) (m - s.1) (m - s.1 + 1) (hnm s.1) h',
        ← Category.assoc (p s m), ← hdp]
      simp only [← Category.assoc, ht, Limits.zero_comp]
    refine ⟨fun n i => t ≫ p ⟨n, i⟩ m ≫ (e n m (m - n) (hnm n)).hom,
      fun n i => hcoc ⟨n, i⟩, ?_⟩
    calc t ≫ Ψ.f m = t ≫ (∑ s, p s m ≫ ι s m) ≫ Ψ.f m := by rw [htot, Category.id_comp]
      _ = ∑ s : (Σ n : Fin (m + 1), Fin (r n)), (t ≫ p s m ≫ (e s.1 m (m - s.1) (hnm s.1)).hom) ≫
            ψ s.1 s.2 (m - s.1) ≫ (K.XIsoOfEq (hnm s.1)).hom := by
          rw [Preadditive.sum_comp, Preadditive.comp_sum]
          refine Finset.sum_congr rfl (fun s _ => ?_)
          simp only [Category.assoc, hK1]
      _ = _ := Fintype.sum_sigma (fun s : (Σ n : Fin (m + 1), Fin (r n)) =>
            (t ≫ p s m ≫ (e s.1 m (m - s.1) (hnm s.1)).hom) ≫
              ψ s.1 s.2 (m - s.1) ≫ (K.XIsoOfEq (hnm s.1)).hom)
  ·
    obtain ⟨t, ht_def⟩ : ∃ t : P ⟶ T.X m, t = ∑ s : (Σ n : Fin (m + 1), Fin (r n)),
        β s.1 s.2 ≫ (e s.1 m (m - s.1) (hnm s.1)).inv ≫ ι s m := ⟨_, rfl⟩
    have hcomp : ∀ s0 : (Σ n : Fin (m + 1), Fin (r n)),
        t ≫ p s0 m ≫ (e s0.1 m (m - s0.1) (hnm s0.1)).hom = β s0.1 s0.2 := by
      intro s0
      rw [ht_def, Preadditive.sum_comp, Finset.sum_eq_single s0]
      · rw [Category.assoc, Category.assoc, ← Category.assoc (ι s0 m), hιp, Category.id_comp,
          Iso.inv_hom_id, Category.comp_id]
      · intro s _ hs
        rw [Category.assoc, Category.assoc, ← Category.assoc (ι s m), hιp' s s0 m hs,
          Limits.zero_comp, Limits.comp_zero, Limits.comp_zero]
      · intro h
        exact absurd (Finset.mem_univ _) h
    refine ⟨t, ?_, ?_, fun u hu n i => ?_⟩
    · rw [ht_def, Preadditive.sum_comp]
      refine Finset.sum_eq_zero (fun s _ => ?_)
      have h' : (s.1 : ℕ) + (m - s.1 + 1) = m + 1 := by have := s.1.isLt; omega
      rw [Category.assoc, Category.assoc, hιd, ← Category.assoc (e s.1 m (m - s.1) (hnm s.1)).inv,
        hCd s.1 m (m + 1) (m - s.1) (m - s.1 + 1) (hnm s.1) h']
      simp only [← Category.assoc, hβ, Limits.zero_comp]
    · rw [ht_def, Preadditive.sum_comp]
      refine (Finset.sum_congr rfl (fun s _ => ?_)).trans
        (Fintype.sum_sigma (fun s : (Σ n : Fin (m + 1), Fin (r n)) =>
          β s.1 s.2 ≫ ψ s.1 s.2 (m - s.1) ≫ (K.XIsoOfEq (hnm s.1)).hom))
      rw [Category.assoc, Category.assoc, hΨ]
    · have hb : ∀ s : (Σ n : Fin (m + 1), Fin (r n)), β s.1 s.2 =
          (u ≫ p s (m - 1)) ≫ (C s.1).d (m - 1) m ≫ (e s.1 m (m - s.1) (hnm s.1)).hom := by
        intro s
        rw [← hcomp s, ← hu]
        simp only [Category.assoc]
        rw [reassoc_of% (hdp s (m - 1) m)]
      have hγ : ∀ s : (Σ n : Fin (m + 1), Fin (r n)), ∃ γ : P ⟶ J.cocomplex.X (m - s.1 - 1),
          γ ≫ J.cocomplex.d (m - s.1 - 1) (m - s.1) = β s.1 s.2 := by
        intro s
        rw [hb s]
        have hle : (s.1 : ℕ) ≤ m := Nat.lt_succ_iff.mp s.1.isLt
        by_cases hlt : (s.1 : ℕ) < m
        · have h1 : (s.1 : ℕ) + (m - s.1 - 1) = m - 1 := by omega
          refine ⟨(u ≫ p s (m - 1)) ≫ (e s.1 (m - 1) (m - s.1 - 1) h1).hom, ?_⟩
          rw [Category.assoc, ← hD1 s.1 (m - 1) m (m - s.1 - 1) (m - s.1) h1 (hnm s.1)]
        · refine ⟨0, ?_⟩
          rw [Limits.zero_comp]
          rcases Nat.eq_zero_or_pos m with h0 | hpos
          · have hd : (C s.1).d (m - 1) m = 0 :=
              (C s.1).shape _ _ (by simp only [ComplexShape.up_Rel]; omega)
            rw [hd, Limits.zero_comp, Limits.comp_zero]
          · have hz : Limits.IsZero ((C s.1).X (m - 1)) := hCzero s.1 (m - 1) (by omega)
            rw [hz.eq_of_tgt (u ≫ p s (m - 1)) 0, Limits.zero_comp]
      exact hγ ⟨n, i⟩

theorem wc_lh_model_complex : ∀ {D : Type*} [Category D] [Abelian D] (K : CochainComplex D ℕ) (P : D) (J : InjectiveResolution P) (m : ℕ) (r : ℕ → ℕ) (φ : (n : ℕ) → Fin (r n) → (P ⟶ K.X n)) (ψ : (n : ℕ) → Fin (r n) → (k : ℕ) → (J.cocomplex.X k ⟶ K.X (n + k))), (∀ n i, J.ι.f 0 ≫ ψ n i 0 = φ n i) → (∀ n i k, ψ n i k ≫ K.d (n + k) (n + k + 1) = J.cocomplex.d k (k + 1) ≫ ψ n i (k + 1)) → (∀ k, k ≤ m + 1 → ∀ (A : D) (a : Fin (r k) → (A ⟶ P)) (x : A ⟶ K.X (k - 1)), ∑ i, a i ≫ φ k i = x ≫ K.d (k - 1) k → ∀ i, a i = 0) → (∀ k, k ≤ m → ∀ (A : D) (y : A ⟶ K.X k), y ≫ K.d k (k + 1) = 0 → ∃ (A' : D) (π : A' ⟶ A) (_ : Epi π) (a : Fin (r k) → (A' ⟶ P)) (x : A' ⟶ K.X (k - 1)), π ≫ y = ∑ i, a i ≫ φ k i + x ≫ K.d (k - 1) k) → ∃ (T : CochainComplex D ℕ) (Ψ : T ⟶ K), (∀ j, Injective (T.X j)) ∧ (∀ k, k ≤ m + 1 → ∀ (A : D) (t : A ⟶ T.X k), t ≫ T.d k (k + 1) = 0 → ∀ x : A ⟶ K.X (k - 1), t ≫ Ψ.f k = x ≫ K.d (k - 1) k → ∃ (A' : D) (π : A' ⟶ A) (_ : Epi π) (u : A' ⟶ T.X (k - 1)), π ≫ t = u ≫ T.d (k - 1) k) ∧ (∀ k, k ≤ m → ∀ (A : D) (y : A ⟶ K.X k), y ≫ K.d k (k + 1) = 0 → ∃ (A' : D) (π : A' ⟶ A) (_ : Epi π) (s : A' ⟶ T.X k) (x : A' ⟶ K.X (k - 1)), s ≫ T.d k (k + 1) = 0 ∧ π ≫ y = s ≫ Ψ.f k + x ≫ K.d (k - 1) k) ∧ (∀ t : P ⟶ T.X m, t ≫ T.d m (m + 1) = 0 → ∃ β : (n : Fin (m + 1)) → Fin (r n) → (P ⟶ J.cocomplex.X (m - n)), (∀ n i, β n i ≫ J.cocomplex.d (m - n) (m - n + 1) = 0) ∧ t ≫ Ψ.f m = ∑ n : Fin (m + 1), ∑ i : Fin (r n), β n i ≫ ψ n i (m - n) ≫ (K.XIsoOfEq (Nat.add_sub_cancel' (Nat.lt_succ_iff.mp n.isLt))).hom) ∧ (∀ β : (n : Fin (m + 1)) → Fin (r n) → (P ⟶ J.cocomplex.X (m - n)), (∀ n i, β n i ≫ J.cocomplex.d (m - n) (m - n + 1) = 0) → ∃ t : P ⟶ T.X m, t ≫ T.d m (m + 1) = 0 ∧ t ≫ Ψ.f m = ∑ n : Fin (m + 1), ∑ i : Fin (r n), β n i ≫ ψ n i (m - n) ≫ (K.XIsoOfEq (Nat.add_sub_cancel' (Nat.lt_succ_iff.mp n.isLt))).hom ∧ ∀ u : P ⟶ T.X (m - 1), u ≫ T.d (m - 1) m = t → ∀ (n : Fin (m + 1)) (i : Fin (r n)), ∃ γ : P ⟶ J.cocomplex.X (m - n - 1), γ ≫ J.cocomplex.d (m - n - 1) (m - n) = β n i) :=
by
  intro D _ _ K P J m r φ ψ hψ0 hψ hinj hsurj
  choose C e hCinj hCzero hCd using fun n => wc_lh_shift_block_complex P J n
  choose f hf using fun s : (Σ n : Fin (m + 1), Fin (r n)) =>
    wc_lh_shift_block_chain_map K P J s.1 (ψ s.1 s.2) (hψ s.1 s.2) (C s.1) (e s.1) (hCzero s.1) (hCd s.1)
  obtain ⟨T, Ψ, ι, p, hιp, hιp', htot, hιd, hdp, hιΨ, hTI⟩ :=
    wc_lh_finite_sum_complex (fun s : (Σ n : Fin (m + 1), Fin (r n)) => C s.1) K f
  have hΨ : ∀ (s : Σ n : Fin (m + 1), Fin (r n)) (k a : ℕ) (h : (s.1 : ℕ) + a = k),
      (e s.1 k a h).inv ≫ ι s k ≫ Ψ.f k = ψ s.1 s.2 a ≫ (K.XIsoOfEq h).hom := by
    intro s k a h
    rw [hιΨ]
    exact hf s k a h
  obtain ⟨hTi, hTs⟩ := wc_lh_model_T_cohomology K P J m r φ ψ hψ0 C e hCzero hCd T Ψ ι p
    htot hιd hdp hΨ hinj hsurj
  obtain ⟨hR, hB⟩ := wc_lh_model_read_build K P J m r ψ C e hCzero hCd T Ψ ι p hιp hιp' htot
    hιd hdp hΨ
  exact ⟨T, Ψ, hTI (fun s j => hCinj s.1 j), hTi, hTs, hR, hB⟩

theorem wc_lh_hom_complex_free : ∀ {D : Type*} [Category D] [Abelian D] (K : CochainComplex D ℕ), (∀ j, Injective (K.X j)) → ∀ (P : D) (J : InjectiveResolution P) (m : ℕ) (r : ℕ → ℕ) (φ : (n : ℕ) → Fin (r n) → (P ⟶ K.X n)) (hφ : ∀ n i, φ n i ≫ K.d n (n + 1) = 0) (ψ : (n : ℕ) → Fin (r n) → (k : ℕ) → (J.cocomplex.X k ⟶ K.X (n + k))), (∀ n i, J.ι.f 0 ≫ ψ n i 0 = φ n i) → (∀ n i k, ψ n i k ≫ K.d (n + k) (n + k + 1) = J.cocomplex.d k (k + 1) ≫ ψ n i (k + 1)) → (∀ n, n ≤ m + 1 → IsIso (Limits.Sigma.desc (fun i : Fin (r n) => K.liftCycles (φ n i) (n + 1) (by simp) (hφ n i) ≫ K.homologyπ n))) → (∀ c : P ⟶ K.X m, c ≫ K.d m (m + 1) = 0 → ∃ β : (n : Fin (m + 1)) → Fin (r n) → (P ⟶ J.cocomplex.X (m - n)), (∀ n i, β n i ≫ J.cocomplex.d (m - n) (m - n + 1) = 0) ∧ ∃ e : P ⟶ K.X (m - 1), c - ∑ n : Fin (m + 1), ∑ i : Fin (r n), β n i ≫ ψ n i (m - n) ≫ (K.XIsoOfEq (Nat.add_sub_cancel' (Nat.lt_succ_iff.mp n.isLt))).hom = e ≫ K.d (m - 1) m) ∧ (∀ β : (n : Fin (m + 1)) → Fin (r n) → (P ⟶ J.cocomplex.X (m - n)), (∀ n i, β n i ≫ J.cocomplex.d (m - n) (m - n + 1) = 0) → ∀ e : P ⟶ K.X (m - 1), ∑ n : Fin (m + 1), ∑ i : Fin (r n), β n i ≫ ψ n i (m - n) ≫ (K.XIsoOfEq (Nat.add_sub_cancel' (Nat.lt_succ_iff.mp n.isLt))).hom = e ≫ K.d (m - 1) m → ∀ (n : Fin (m + 1)) (i : Fin (r n)), ∃ γ : P ⟶ J.cocomplex.X (m - n - 1), γ ≫ J.cocomplex.d (m - n - 1) (m - n) = β n i) :=
by
  intro D _ _ K hK P J m r φ hφ ψ hψ0 hψ hiso
  obtain ⟨T, Ψ, hTI, hTinj, hTsurj, hRead, hBuild⟩ := wc_lh_model_complex K P J m r φ ψ hψ0 hψ
    (fun k hk => (wc_lh_sigma_iso_elementwise K P k (r k) (φ k) (hφ k) (hiso k hk)).1)
    (fun k hk => (wc_lh_sigma_iso_elementwise K P k (r k) (φ k) (hφ k) (hiso k (by omega))).2)
  obtain ⟨hCS, hCI⟩ := wc_lh_cone_transfer T K Ψ hTI hK m hTinj hTsurj
  refine ⟨?_, ?_⟩
  · intro c hc
    obtain ⟨t, ht, e, he⟩ := hCS P c hc
    obtain ⟨β, hβ, htΨ⟩ := hRead t ht
    exact ⟨β, hβ, e, by rw [← htΨ]; exact he⟩
  · intro β hβ e he n i
    obtain ⟨t, ht, htΨ, hγ⟩ := hBuild β hβ
    obtain ⟨u, hu⟩ := hCI P t ht e (htΨ.trans he)
    exact hγ u hu n i

theorem wc_ext_leray_hirsch : ∀ {C : Type*} {D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] [EnoughInjectives D] (L : D ⥤ C) (R : C ⥤ D) [L.Additive] [R.Additive] (adj : L ⊣ R) [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L] (P : D) (A : C) (I : InjectiveResolution A) (N : ℕ) (r : ℕ → ℕ) (g : (n : ℕ) → Fin (r n) → (L.obj P ⟶ I.cocomplex.X n)) (hg : ∀ (n : ℕ) (i : Fin (r n)), g n i ≫ I.cocomplex.d n (n + 1) = 0) (hf : ∀ (n : ℕ) (i : Fin (r n)), adj.homEquiv _ _ (g n i) ≫ ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).d n (n + 1) = 0), letI := HasExt.standard C; letI := HasExt.standard D; (∀ n : ℕ, n ≤ N → IsIso (Limits.Sigma.desc (fun i : Fin (r n) => ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).liftCycles (adj.homEquiv _ _ (g n i)) (n + 1) (by simp) (hf n i) ≫ ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homologyπ n))) → ∀ m : ℕ, m < N → AddSubgroup.closure {z : Abelian.Ext (L.obj P) A m | ∃ (a n : ℕ) (h : a + n = m) (i : Fin (r n)) (b : Abelian.Ext P P a), z = (Abelian.Ext.mapExactFunctor L b).comp (I.extMk (g n i) (n + 1) rfl (hg n i)) h} = ⊤ ∧ ∀ (G : Type*) [AddCommGroup G] (β : (a n : ℕ) → a + n = m → Fin (r n) → Abelian.Ext P P a →+ G), ∃ κ : Abelian.Ext (L.obj P) A m →+ G, ∀ (a n : ℕ) (h : a + n = m) (i : Fin (r n)) (b : Abelian.Ext P P a), κ ((Abelian.Ext.mapExactFunctor L b).comp (I.extMk (g n i) (n + 1) rfl (hg n i)) h) = β a n h i b :=
by
  intro C D _ _ _ _ _ L R _ _ adj _ _ P A I N r g hg hf hiso m hm
  letI : HasExt C := HasExt.standard C
  letI : HasExt D := HasExt.standard D
  classical

  let K := (R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex
  have hKd : ∀ i j, K.d i j = R.map (I.cocomplex.d i j) := fun _ _ => rfl
  have hKX : ∀ (a b : ℕ) (h : a = b), (K.XIsoOfEq h).hom = R.map (I.cocomplex.XIsoOfEq h).hom := by
    intro a b h
    subst h
    simp only [HomologicalComplex.XIsoOfEq_rfl, Iso.refl_hom, CategoryTheory.Functor.map_id]
    rfl
  have hK : ∀ j, Injective (K.X j) := fun j => by
    haveI := I.injective j
    exact Injective.injective_of_adjoint adj (I.cocomplex.X j)
  obtain ⟨J⟩ : Nonempty (InjectiveResolution P) := ⟨InjectiveResolution.of P⟩

  have liftInj : ∀ {X Y Z W : D} (f : X ⟶ Y) (g' : Y ⟶ Z) (hfg : f ≫ g' = 0),
      (ShortComplex.mk f g' hfg).Exact → Injective W → ∀ (u : Y ⟶ W), f ≫ u = 0 →
      ∃ v : Z ⟶ W, g' ≫ v = u := by
    intro X Y Z W f g' hfg hex hW u hu
    haveI : Mono (Limits.cokernel.desc f g' hfg) := hex.mono_cokernelDesc
    refine ⟨Injective.factorThru (Limits.cokernel.desc f u hu) (Limits.cokernel.desc f g' hfg), ?_⟩
    calc g' ≫ Injective.factorThru (Limits.cokernel.desc f u hu) (Limits.cokernel.desc f g' hfg)
        = (Limits.cokernel.π f ≫ Limits.cokernel.desc f g' hfg) ≫
            Injective.factorThru (Limits.cokernel.desc f u hu) (Limits.cokernel.desc f g' hfg) := by
          rw [Limits.cokernel.π_desc]
      _ = u := by rw [Category.assoc, Injective.comp_factorThru, Limits.cokernel.π_desc]
  have chainLift : ∀ (n : ℕ) (φ : P ⟶ K.X n), φ ≫ K.d n (n + 1) = 0 →
      ∃ ψ : (k : ℕ) → (J.cocomplex.X k ⟶ K.X (n + k)), J.ι.f 0 ≫ ψ 0 = φ ∧
        ∀ k, ψ k ≫ K.d (n + k) (n + k + 1) = J.cocomplex.d k (k + 1) ≫ ψ (k + 1) := by
    intro n φ hφ
    let T : ℕ → Type _ := fun k => {p : (J.cocomplex.X k ⟶ K.X (n + k)) ×
        (J.cocomplex.X (k + 1) ⟶ K.X (n + (k + 1))) //
      p.1 ≫ K.d (n + k) (n + (k + 1)) = J.cocomplex.d k (k + 1) ≫ p.2}
    have hstep : ∀ (k : ℕ) (p : T k), ∃ c : J.cocomplex.X (k + 2) ⟶ K.X (n + (k + 2)),
        J.cocomplex.d (k + 1) (k + 2) ≫ c = p.1.2 ≫ K.d (n + (k + 1)) (n + (k + 2)) := by
      intro k p
      have hu : J.cocomplex.d k (k + 1) ≫ (p.1.2 ≫ K.d (n + (k + 1)) (n + (k + 2))) = 0 := by
        rw [← Category.assoc, ← p.2, Category.assoc, K.d_comp_d, Limits.comp_zero]
      exact liftInj _ _ _ (J.exact_succ k) (hK _) _ hu
    choose c hc using hstep
    have hbase : ∃ p : T 0, J.ι.f 0 ≫ p.1.1 = φ := by
      let ι0 : P ⟶ J.cocomplex.X 0 := J.ι.f 0
      haveI : Mono ι0 := (inferInstance : Mono (J.ι.f 0))
      haveI := hK (n + 0)
      let ψ0 : J.cocomplex.X 0 ⟶ K.X (n + 0) := Injective.factorThru φ ι0
      have hψ0 : ι0 ≫ ψ0 = φ := Injective.comp_factorThru _ _
      have hu : J.ι.f 0 ≫ (ψ0 ≫ K.d (n + 0) (n + (0 + 1))) = 0 := by
        rw [← Category.assoc]
        exact (congrArg (· ≫ K.d (n + 0) (n + (0 + 1))) hψ0).trans hφ
      obtain ⟨v, hv⟩ := liftInj _ _ _ J.exact₀ (hK _) _ hu
      exact ⟨⟨(ψ0, v), hv.symm⟩, hψ0⟩
    obtain ⟨p0, hp0⟩ := hbase
    let F : (k : ℕ) → T k := fun k => Nat.rec (motive := T) p0
      (fun k p => ⟨(p.1.2, c k p), (hc k p).symm⟩) k
    refine ⟨fun k => (F k).1.1, hp0, fun k => ?_⟩
    have h1 := (F k).2
    have h2 : (F (k + 1)).1.1 = (F k).1.2 := by
      show (Nat.rec (motive := T) p0 (fun k p => ⟨(p.1.2, c k p), (hc k p).symm⟩) (k + 1)).1.1 = _
      rfl
    show (F k).1.1 ≫ K.d (n + k) (n + (k + 1)) = J.cocomplex.d k (k + 1) ≫ (F (k + 1)).1.1
    rw [h2]
    exact h1
  have hlift : ∀ (n : ℕ) (i : Fin (r n)), ∃ ψ : (k : ℕ) → (J.cocomplex.X k ⟶ R.obj (I.cocomplex.X (n + k))),
      J.ι.f 0 ≫ ψ 0 = adj.homEquiv _ _ (g n i) ∧
        ∀ k, ψ k ≫ R.map (I.cocomplex.d (n + k) (n + k + 1)) = J.cocomplex.d k (k + 1) ≫ ψ (k + 1) :=
    fun n i => chainLift n (adj.homEquiv _ _ (g n i)) (hf n i)
  choose ψ hψ0 hψ using hlift
  obtain ⟨hS4surj, hS4inj⟩ := wc_lh_hom_complex_free K hK P J m r (fun n i => adj.homEquiv _ _ (g n i))
    hf ψ hψ0 hψ (fun n hn => hiso n (by omega))
  choose s hs1 hs2 using fun (n : ℕ) (i : Fin (r n)) (a : ℕ) =>
    wc_lh_extMk_comp_transport L R adj P A I J n (g n i) (hg n i) (ψ n i) (hψ0 n i) (hψ n i) a
  have hsq : ∀ n i a, s n i a * s n i a = 1 := by
    intro n i a
    rcases hs1 n i a with h | h <;> rw [h] <;> norm_num

  have hφ0 : ∀ k, adj.homEquiv P (I.cocomplex.X k) 0 = 0 := fun k => by
    rw [Adjunction.homEquiv_unit, Functor.map_zero, Limits.comp_zero]
  have hφs0 : ∀ k, (adj.homEquiv P (I.cocomplex.X k)).symm 0 = 0 := fun k => by
    rw [Adjunction.homEquiv_counit, Functor.map_zero, Limits.zero_comp]
  let H : ∀ k, (P ⟶ R.obj (I.cocomplex.X k)) ≃+ (L.obj P ⟶ I.cocomplex.X k) := fun k =>
    { (adj.homEquiv P (I.cocomplex.X k)).symm with
      map_add' := fun x y => by
        simp only [Equiv.toFun_as_coe, Adjunction.homEquiv_counit, Functor.map_add,
          Preadditive.add_comp] }
  have hH : ∀ k u, H k u = (adj.homEquiv P (I.cocomplex.X k)).symm u := fun _ _ => rfl

  have hcongrI : ∀ (f f' : L.obj P ⟶ I.cocomplex.X m) (hf₁ : f ≫ I.cocomplex.d m (m + 1) = 0)
      (hf₂ : f' ≫ I.cocomplex.d m (m + 1) = 0), f = f' →
      I.extMk f (m + 1) rfl hf₁ = I.extMk f' (m + 1) rfl hf₂ := by
    rintro f f' hf₁ hf₂ rfl
    rfl
  have hd1 : ∀ {ι : Type} (S : Finset ι) (f : ι → (L.obj P ⟶ I.cocomplex.X m)),
      (∀ k, f k ≫ I.cocomplex.d m (m + 1) = 0) → (∑ k ∈ S, f k) ≫ I.cocomplex.d m (m + 1) = 0 := by
    intro ι S f hf'
    rw [Preadditive.sum_comp]
    exact Finset.sum_eq_zero (fun k _ => hf' k)
  have hsumI : ∀ {ι : Type} (S : Finset ι) (f : ι → (L.obj P ⟶ I.cocomplex.X m))
      (hf' : ∀ k, f k ≫ I.cocomplex.d m (m + 1) = 0) (hS : (∑ k ∈ S, f k) ≫ I.cocomplex.d m (m + 1) = 0),
      ∑ k ∈ S, I.extMk (f k) (m + 1) rfl (hf' k) = I.extMk (∑ k ∈ S, f k) (m + 1) rfl hS := by
    intro ι S f hf'
    induction S using Finset.induction_on with
    | empty =>
      intro hS
      rw [Finset.sum_empty]
      exact (I.extMk_zero (m + 1) rfl).symm.trans (hcongrI _ _ _ _ Finset.sum_empty.symm)
    | insert a S ha ih =>
      intro hS
      rw [Finset.sum_insert ha (f := fun k => I.extMk (f k) (m + 1) rfl (hf' k)),
        ih (hd1 S f hf'), I.add_extMk]
      exact hcongrI _ _ _ _ (Finset.sum_insert ha).symm
  have hsumI2 : ∀ (F : (n : Fin (m + 1)) → Fin (r n) → (L.obj P ⟶ I.cocomplex.X m))
      (hF : ∀ n i, F n i ≫ I.cocomplex.d m (m + 1) = 0),
      ∑ n : Fin (m + 1), ∑ i : Fin (r n), I.extMk (F n i) (m + 1) rfl (hF n i) =
        I.extMk (∑ n : Fin (m + 1), ∑ i : Fin (r n), F n i) (m + 1) rfl
          (hd1 Finset.univ _ (fun n => hd1 Finset.univ (F n) (hF n))) := by
    intro F hF
    rw [Finset.sum_congr rfl (fun n _ => hsumI Finset.univ (F n) (hF n)
      (hd1 Finset.univ (F n) (hF n)))]
    exact hsumI Finset.univ _ _ _
  have hzeroI : ∀ (f : L.obj P ⟶ I.cocomplex.X m) (hf₁ : f ≫ I.cocomplex.d m (m + 1) = 0)
      (e : L.obj P ⟶ I.cocomplex.X (m - 1)), e ≫ I.cocomplex.d (m - 1) m = f →
      I.extMk f (m + 1) rfl hf₁ = 0 := by
    intro f hf₁ e he
    rcases Nat.eq_zero_or_pos m with h0 | hpos
    · have hd : I.cocomplex.d (m - 1) m = 0 :=
        I.cocomplex.shape _ _ (by simp only [ComplexShape.up_Rel]; omega)
      rw [hd, Limits.comp_zero] at he
      subst he
      exact I.extMk_zero _ _
    · exact (I.extMk_eq_zero_iff f (m + 1) rfl hf₁ (m - 1) (by omega)).mpr ⟨e, he⟩
  have hzeroJ : ∀ (a : ℕ) (β : P ⟶ J.cocomplex.X a) (hβ : β ≫ J.cocomplex.d a (a + 1) = 0)
      (γ : P ⟶ J.cocomplex.X (a - 1)), γ ≫ J.cocomplex.d (a - 1) a = β →
      J.extMk β (a + 1) rfl hβ = 0 := by
    intro a β hβ γ hγ
    rcases Nat.eq_zero_or_pos a with h0 | hpos
    · have hd : J.cocomplex.d (a - 1) a = 0 :=
        J.cocomplex.shape _ _ (by simp only [ComplexShape.up_Rel]; omega)
      rw [hd, Limits.comp_zero] at hγ
      subst hγ
      exact J.extMk_zero _ _
    · exact (J.extMk_eq_zero_iff β (a + 1) rfl hβ (a - 1) (by omega)).mpr ⟨γ, hγ⟩
  have hI0 : ∀ (k : ℕ), k = 0 → ∀ (f : L.obj P ⟶ I.cocomplex.X k)
      (hf₁ : f ≫ I.cocomplex.d k (k + 1) = 0), I.extMk f (k + 1) rfl hf₁ = 0 → f = 0 := by
    intro k hk f hf₁ h
    subst hk
    unfold InjectiveResolution.extMk at h
    rw [Equiv.symm_apply_eq, InjectiveResolution.extEquivCohomologyClass_zero,
      CochainComplex.HomComplex.CohomologyClass.mk_eq_zero_iff] at h
    obtain ⟨g', hg'⟩ :=
      (CochainComplex.HomComplex.Cocycle.fromSingleMk_mem_coboundaries_iff _ _ _ _ _ (-1)
        (by norm_num)).mp h
    have hz : Limits.IsZero (I.cochainComplex.X (-1)) :=
      HomologicalComplex.isZero_extend_X _ _ _ (fun i hi => by
        have h' : ((i : ℕ) : ℤ) = -1 := hi
        omega)
    rw [hz.eq_of_tgt g' 0, Limits.zero_comp] at hg'
    have h3 := congrArg (· ≫ (I.cochainComplexXIso _ 0 rfl).hom) hg'
    simpa using h3.symm
  have hI0' : ∀ (f : L.obj P ⟶ I.cocomplex.X m) (hf₁ : f ≫ I.cocomplex.d m (m + 1) = 0),
      I.extMk f (m + 1) rfl hf₁ = 0 → ∃ e : L.obj P ⟶ I.cocomplex.X (m - 1),
        e ≫ I.cocomplex.d (m - 1) m = f := by
    intro f hf₁ h
    rcases Nat.eq_zero_or_pos m with h0 | hpos
    · refine ⟨0, ?_⟩
      rw [Limits.zero_comp]
      exact (hI0 m h0 f hf₁ h).symm
    · exact (I.extMk_eq_zero_iff f (m + 1) rfl hf₁ (m - 1) (by omega)).mp h

  have hnm : ∀ n : Fin (m + 1), (n : ℕ) + (m - n) = m := fun n =>
    Nat.add_sub_cancel' (Nat.lt_succ_iff.mp n.isLt)
  have hsub : ∀ n : Fin (m + 1), m - (n : ℕ) + n = m := fun n =>
    Nat.sub_add_cancel (Nat.lt_succ_iff.mp n.isLt)
  have hTd : ∀ (n : ℕ) (i : Fin (r n)) (a c : ℕ) (hc : n + a = c) (β : P ⟶ J.cocomplex.X a),
      β ≫ J.cocomplex.d a (a + 1) = 0 →
      ((adj.homEquiv _ _).symm (β ≫ ψ n i a) ≫ (I.cocomplex.XIsoOfEq hc).hom) ≫
        I.cocomplex.d c (c + 1) = 0 := by
    intro n i a c hc β hβ
    subst hc
    rw [HomologicalComplex.XIsoOfEq_rfl, Iso.refl_hom, Category.comp_id,
      ← adj.homEquiv_naturality_right_symm, Category.assoc, hψ n i a, ← Category.assoc, hβ,
      Limits.zero_comp, hφs0]
  obtain ⟨Tt, hTt⟩ : ∃ Tt : (n : Fin (m + 1)) → Fin (r n) → (P ⟶ J.cocomplex.X (m - n)) →
      (L.obj P ⟶ I.cocomplex.X m), ∀ n i β, Tt n i β =
        (adj.homEquiv _ _).symm (β ≫ ψ n i (m - n)) ≫ (I.cocomplex.XIsoOfEq (hnm n)).hom :=
    ⟨fun n i β => (adj.homEquiv _ _).symm (β ≫ ψ n i (m - n)) ≫ (I.cocomplex.XIsoOfEq (hnm n)).hom,
      fun _ _ _ => rfl⟩
  have hTtd : ∀ (n : Fin (m + 1)) (i : Fin (r n)) (β : P ⟶ J.cocomplex.X (m - n)),
      β ≫ J.cocomplex.d (m - n) (m - n + 1) = 0 →
      Tt n i β ≫ I.cocomplex.d m (m + 1) = 0 := by
    intro n i β hβ
    rw [hTt]
    exact hTd n i (m - n) m (hnm n) β hβ
  have hTK : ∀ (n : Fin (m + 1)) (i : Fin (r n)) (β : P ⟶ J.cocomplex.X (m - n)),
      (adj.homEquiv P (I.cocomplex.X m)).symm (β ≫ ψ n i (m - n) ≫ (K.XIsoOfEq (hnm n)).hom) =
        Tt n i β := by
    intro n i β
    rw [hKX, ← Category.assoc, adj.homEquiv_naturality_right_symm, hTt]

  let X : (n : ℕ) → (i : Fin (r n)) → (a : ℕ) → a + n = m →
      (Abelian.Ext P P a →+ Abelian.Ext (L.obj P) A m) := fun n i a h =>
    AddMonoidHom.mk' (fun b => (Abelian.Ext.mapExactFunctor L b).comp
        (I.extMk (g n i) (n + 1) rfl (hg n i)) h)
      (fun b b' => by
        rw [← Functor.mapExtAddHom_apply, map_add, Functor.mapExtAddHom_apply,
          Functor.mapExtAddHom_apply, Abelian.Ext.add_comp])
  have hX : ∀ n i a h b, X n i a h b =
      (Abelian.Ext.mapExactFunctor L b).comp (I.extMk (g n i) (n + 1) rfl (hg n i)) h :=
    fun _ _ _ _ _ => rfl
  have hKEY : ∀ (n : Fin (m + 1)) (i : Fin (r n)) (β : P ⟶ J.cocomplex.X (m - n))
      (hβ : β ≫ J.cocomplex.d (m - n) (m - n + 1) = 0),
      s n i (m - n) • X n i (m - n) (hsub n) (J.extMk β (m - n + 1) rfl hβ) =
        I.extMk (Tt n i β) (m + 1) rfl (hTtd n i β hβ) := by
    intro n i β hβ
    rw [hX, hs2 n i (m - n) m (hsub n) (hnm n) β hβ (hTd n i (m - n) m (hnm n) β hβ), smul_smul,
      hsq, one_smul]
    exact hcongrI _ _ _ _ (hTt n i β).symm

  let Φ : ((n : Fin (m + 1)) → (i : Fin (r n)) → Abelian.Ext P P (m - n)) →+
      Abelian.Ext (L.obj P) A m :=
    AddMonoidHom.mk' (fun b => ∑ n : Fin (m + 1), ∑ i : Fin (r n),
        s n i (m - n) • X n i (m - n) (hsub n) (b n i))
      (fun b b' => by simp only [Pi.add_apply, map_add, smul_add, Finset.sum_add_distrib])
  have hΦsurj : ∀ z, ∃ b, Φ b = z := by
    intro z
    obtain ⟨f, hf0, rfl⟩ := I.extMk_surjective z (m + 1) rfl
    have hu : adj.homEquiv _ _ f ≫ K.d m (m + 1) = 0 := by
      rw [hKd, ← adj.homEquiv_naturality_right, hf0, hφ0]
    obtain ⟨β, hβ, e, he⟩ := hS4surj (adj.homEquiv _ _ f) hu
    have he' : f - ∑ n : Fin (m + 1), ∑ i : Fin (r n), Tt n i (β n i) =
        (adj.homEquiv _ _).symm e ≫ I.cocomplex.d (m - 1) m := by
      have h1 := congrArg (H m) he
      rw [map_sub, map_sum] at h1
      simp only [map_sum] at h1
      simp only [hH, hTK, Equiv.symm_apply_apply] at h1
      rw [h1, hKd, adj.homEquiv_naturality_right_symm]
    refine ⟨fun n i => J.extMk (β n i) (m - n + 1) rfl (hβ n i), ?_⟩
    show ∑ n : Fin (m + 1), ∑ i : Fin (r n), s n i (m - n) • X n i (m - n) (hsub n)
      (J.extMk (β n i) (m - n + 1) rfl (hβ n i)) = _
    rw [Finset.sum_congr rfl (fun n _ => Finset.sum_congr rfl
      (fun i _ => hKEY n i (β n i) (hβ n i))),
      hsumI2 (fun n i => Tt n i (β n i)) (fun n i => hTtd n i (β n i) (hβ n i))]
    symm
    rw [← sub_eq_zero, I.sub_extMk]
    exact hzeroI _ _ _ he'.symm
  have hΦinj : ∀ b, Φ b = 0 → b = 0 := by
    intro b hb
    choose β hβ hβE using fun (n : Fin (m + 1)) (i : Fin (r n)) =>
      J.extMk_surjective (b n i) (m - n + 1) rfl
    have hbz : ∑ n : Fin (m + 1), ∑ i : Fin (r n),
        I.extMk (Tt n i (β n i)) (m + 1) rfl (hTtd n i (β n i) (hβ n i)) = 0 := by
      rw [← hb]
      show _ = ∑ n : Fin (m + 1), ∑ i : Fin (r n), s n i (m - n) • X n i (m - n) (hsub n) (b n i)
      refine Finset.sum_congr rfl (fun n _ => Finset.sum_congr rfl (fun i _ => ?_))
      rw [← hβE n i, hKEY]
    rw [hsumI2 (fun n i => Tt n i (β n i)) (fun n i => hTtd n i (β n i) (hβ n i))] at hbz
    obtain ⟨e, he⟩ := hI0' _ _ hbz
    have hK' : ∑ n : Fin (m + 1), ∑ i : Fin (r n), β n i ≫ ψ n i (m - n) ≫ (K.XIsoOfEq (hnm n)).hom =
        adj.homEquiv _ _ e ≫ K.d (m - 1) m := by
      apply (H m).injective
      rw [map_sum]
      simp only [map_sum]
      simp only [hH, hTK]
      rw [hKd, adj.homEquiv_naturality_right_symm, Equiv.symm_apply_apply, he]
    funext n i
    obtain ⟨γ, hγ⟩ := hS4inj β hβ (adj.homEquiv _ _ e) hK' n i
    rw [← hβE n i]
    exact hzeroJ _ _ _ γ hγ
  have hbij : Function.Bijective Φ :=
    ⟨(injective_iff_map_eq_zero Φ).mpr hΦinj, fun z => hΦsurj z⟩
  refine ⟨?_, ?_⟩
  ·
    rw [eq_top_iff]
    intro z _
    obtain ⟨b, rfl⟩ := hΦsurj z
    show ∑ n : Fin (m + 1), ∑ i : Fin (r n), s n i (m - n) • X n i (m - n) (hsub n) (b n i) ∈ _
    refine sum_mem (fun n _ => sum_mem (fun i _ => zsmul_mem (AddSubgroup.subset_closure ?_) _))
    exact ⟨m - n, n, hsub n, i, b n i, hX _ _ _ _ _⟩
  ·
    intro G _ β'
    let Λ : ((n : Fin (m + 1)) → (i : Fin (r n)) → Abelian.Ext P P (m - n)) →+ G :=
      AddMonoidHom.mk' (fun b => ∑ n : Fin (m + 1), ∑ i : Fin (r n),
          s n i (m - n) • β' (m - n) n (hsub n) i (b n i))
        (fun b b' => by simp only [Pi.add_apply, map_add, smul_add, Finset.sum_add_distrib])
    refine ⟨Λ.comp (AddEquiv.ofBijective Φ hbij).symm.toAddMonoidHom, ?_⟩
    intro a n h i b
    have hn : n < m + 1 := by omega
    obtain rfl : a = m - n := by omega
    let n' : Fin (m + 1) := ⟨n, hn⟩
    let bs : (n : Fin (m + 1)) → (i : Fin (r n)) → Abelian.Ext P P (m - n) :=
      Pi.single n' (Pi.single i b : (i' : Fin (r n)) → Abelian.Ext P P (m - n))
    have hΦs : Φ bs = s n i (m - n) • X n i (m - n) h b := by
      show ∑ n'' : Fin (m + 1), ∑ i'' : Fin (r n''),
        s n'' i'' (m - n'') • X n'' i'' (m - n'') (hsub n'') (bs n'' i'') = _
      rw [Finset.sum_eq_single n' (fun n'' _ hn'' => by simp [bs, Pi.single_eq_of_ne hn''])
        (fun h' => absurd (Finset.mem_univ _) h')]
      rw [Finset.sum_eq_single i (fun i'' _ hi'' => by simp [bs, Pi.single_eq_of_ne hi''])
        (fun h' => absurd (Finset.mem_univ _) h')]
      simp only [bs, Pi.single_eq_same]
      rfl
    have hΛs : Λ bs = s n i (m - n) • β' (m - n) n h i b := by
      show ∑ n'' : Fin (m + 1), ∑ i'' : Fin (r n''),
        s n'' i'' (m - n'') • β' (m - n'') n'' (hsub n'') i'' (bs n'' i'') = _
      rw [Finset.sum_eq_single n' (fun n'' _ hn'' => by simp [bs, Pi.single_eq_of_ne hn''])
        (fun h' => absurd (Finset.mem_univ _) h')]
      rw [Finset.sum_eq_single i (fun i'' _ hi'' => by simp [bs, Pi.single_eq_of_ne hi''])
        (fun h' => absurd (Finset.mem_univ _) h')]
      simp only [bs, Pi.single_eq_same]
      rfl
    have hEs : (AddEquiv.ofBijective Φ hbij).symm (X n i (m - n) h b) = s n i (m - n) • bs := by
      rw [AddEquiv.symm_apply_eq, AddEquiv.ofBijective_apply, map_zsmul, hΦs, smul_smul, hsq,
        one_smul]
    rw [← hX, AddMonoidHom.comp_apply, AddEquiv.coe_toAddMonoidHom, hEs, map_zsmul, hΛs,
      smul_smul, hsq, one_smul]

theorem wc_et_isIso_of_geom_stalks_bijective : ∀ (B : Scheme.{u}) {F G : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}} (ψ : F ⟶ G), (∀ b : B, Function.Bijective ((wcEtStalk B b).map ψ).hom) → IsIso ψ :=
by
  intro B F G ψ hψ
  have hcof : ∀ b : B,
      IsCofiltered (StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) :=
    fun b => IsCofiltered.of_hasFiniteLimits _

  have hpt : ∀ (V : B.Etale) (v : V.left), ∃ t, ∃ ht : t ≫ V.hom = wcEtGeomPt B (V.hom v),
      ∀ (A'' : StructuredArrow (Over.mk (wcEtGeomPt B (V.hom v))) (Scheme.Etale.forget B))
        (f : A'' ⟶ StructuredArrow.mk (Y := V)
          (Over.homMk (U := Over.mk (wcEtGeomPt B (V.hom v))) (V := (Scheme.Etale.forget B).obj V)
            t ht)),
        v ∈ Set.range f.right.left := by
    intro V v
    haveI : Etale V.hom := V.prop
    have hb : V.hom v = (wcEtGeomPt B (V.hom v))
        (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField (V.hom v)))) := by
      have e1 := Scheme.Hom.comp_apply (Spec.map (CommRingCat.ofHom (algebraMap
        (B.residueField (V.hom v)) (AlgebraicClosure (B.residueField (V.hom v))))))
        (B.fromSpecResidueField (V.hom v))
        (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField (V.hom v))))
      refine (e1.trans ?_).symm
      first
        | exact Scheme.fromSpecResidueField_apply _ _ _
        | exact Scheme.fromSpecResidueField_apply _ _
        | simp only [Scheme.fromSpecResidueField_apply]
    obtain ⟨t, ht, htv⟩ := wc_etale_lift_alg_closed_point
      (AlgebraicClosure (B.residueField (V.hom v))) V.hom (wcEtGeomPt B (V.hom v)) v hb
    refine ⟨t, ht, fun A'' f => ?_⟩
    have hw : A''.hom.left ≫ f.right.left = t :=
      congrArg (fun φ => φ.left) (StructuredArrow.w f)
    refine ⟨A''.hom.left (IsLocalRing.closedPoint _), ?_⟩
    have e2 := Scheme.Hom.comp_apply A''.hom.left f.right.left
      (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField (V.hom v))))
    have e3 : (A''.hom.left ≫ f.right.left)
        (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField (V.hom v)))) =
        t (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField (V.hom v)))) := by
      first
        | rw [hw]
        | simp only [hw]
        | exact congrArg (fun φ => φ (IsLocalRing.closedPoint _)) hw
    exact (e2.symm.trans e3).trans htv

  have hinj : Sheaf.IsLocallyInjective ψ := by
    constructor
    intro X x y hxy
    obtain ⟨V⟩ := X
    apply wc_etale_jointly_surjective_covers B V
    intro v
    obtain ⟨t, ht, hR⟩ := hpt V v
    let A : StructuredArrow (Over.mk (wcEtGeomPt B (V.hom v))) (Scheme.Etale.forget B) :=
      StructuredArrow.mk (Y := V)
        (Over.homMk (U := Over.mk (wcEtGeomPt B (V.hom v))) (V := (Scheme.Etale.forget B).obj V)
          t ht)
    obtain ⟨-, hC2, -⟩ := wc_et_stalk_germ_facts B (V.hom v) (hcof _) F
    obtain ⟨-, -, hNG⟩ := wc_et_stalk_germ_facts B (V.hom v) (hcof _) G
    have hxy' : (ψ.hom.app (Opposite.op V)).hom x = (ψ.hom.app (Opposite.op V)).hom y := hxy
    have hgerm : (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B (V.hom v)))
          (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op A)).hom (x - y) =
        (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B (V.hom v)))
          (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op A)).hom 0 := by
      apply (hψ (V.hom v)).1
      refine (hNG F ψ A (x - y)).trans (Eq.trans ?_ (hNG F ψ A 0).symm)
      congr 1
      change (ψ.hom.app (Opposite.op V)).hom (x - y) = (ψ.hom.app (Opposite.op V)).hom 0
      rw [map_sub, hxy', sub_self, map_zero]
    obtain ⟨A'', f, f', hff⟩ := hC2 A A (x - y) 0 hgerm
    refine ⟨A''.right, f.right, ?_, hR A'' f⟩
    rw [map_sub, map_zero, sub_eq_zero] at hff
    exact hff

  have hsurj : Sheaf.IsLocallySurjective ψ := by
    constructor
    intro V s
    apply wc_etale_jointly_surjective_covers B V
    intro v
    obtain ⟨t, ht, hR⟩ := hpt V v
    let A : StructuredArrow (Over.mk (wcEtGeomPt B (V.hom v))) (Scheme.Etale.forget B) :=
      StructuredArrow.mk (Y := V)
        (Over.homMk (U := Over.mk (wcEtGeomPt B (V.hom v))) (V := (Scheme.Etale.forget B).obj V)
          t ht)
    obtain ⟨hC1, -, -⟩ := wc_et_stalk_germ_facts B (V.hom v) (hcof _) F
    obtain ⟨-, hC2G, hNG⟩ := wc_et_stalk_germ_facts B (V.hom v) (hcof _) G
    obtain ⟨ξ, hξ⟩ := (hψ (V.hom v)).2
      ((Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B (V.hom v)))
          (Scheme.Etale.forget B)).op ⋙ G.obj) (Opposite.op A)).hom s)
    obtain ⟨A', t', rfl⟩ := hC1 ξ
    have hξ' := (hNG F ψ A' t').symm.trans hξ
    obtain ⟨A'', f, f', hff⟩ := hC2G A' A _ s hξ'
    refine ⟨A''.right, f'.right, ⟨(F.obj.map f.right.op).hom t', ?_⟩, hR A'' f'⟩
    have hnat := congrArg (fun φ => φ.hom t') (ψ.hom.naturality f.right.op)
    exact hnat.trans hff
  exact (Sheaf.isLocallyBijective_iff_isIso ψ).mp ⟨hinj, hsurj⟩

theorem wc_et_unit_sigma_stalk : ∀ (Y : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r : ℕ) (y : Y), ∃ u0 : (wcEtStalk Y y).obj ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj (SheafOfModules.unit (wcEtZModRing Y ℓ))), Function.Bijective (fun c : Fin r → ZMod ℓ => ((wcEtStalk Y y).map ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).map (∑ i, (c i).val • Limits.Sigma.ι (fun _ : Fin r => SheafOfModules.unit (wcEtZModRing Y ℓ)) i))).hom u0) ∧ ∀ (N : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) (t : SheafOfModules.unit (wcEtZModRing Y ℓ) ⟶ N), ((wcEtStalk Y y).map ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).map t)).hom u0 = 0 → (wcEtStalk Y y).map ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).map t) = 0 :=
by
  classical
  intro Y ℓ _ r y
  haveI : NeZero ℓ := ⟨(Fact.out : Nat.Prime ℓ).ne_zero⟩

  have gen : ∀ (F : SheafOfModules.{u+1} (wcEtZModRing Y ℓ) ⥤ AddCommGrpCat.{u+1}) [F.Additive]
      (u0 : F.obj (SheafOfModules.unit (wcEtZModRing Y ℓ))), ℓ • u0 = 0 → u0 ≠ 0 →
      (∀ x : F.obj (SheafOfModules.unit (wcEtZModRing Y ℓ)), ∃ k : ℕ, x = k • u0) →
      Function.Bijective (fun c : Fin r → ZMod ℓ => (F.map (∑ i, (c i).val •
        Limits.Sigma.ι (fun _ : Fin r => SheafOfModules.unit (wcEtZModRing Y ℓ)) i)).hom u0) ∧
      ∀ (N : SheafOfModules.{u+1} (wcEtZModRing Y ℓ))
        (t : SheafOfModules.unit (wcEtZModRing Y ℓ) ⟶ N), (F.map t).hom u0 = 0 → F.map t = 0 := by
    intro F _ u0 h0 h1 hgen
    have hord : addOrderOf u0 = ℓ := addOrderOf_eq_prime h0 h1
