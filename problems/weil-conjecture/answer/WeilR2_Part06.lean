        rw [specializes_iff_mem_closure]
        have hm : g z ∈ ⇑g '' closure (Subtype.val '' (Z : Set S)) := ⟨z, hz.mem, rfl⟩
        refine closure_mono ?_ (image_closure_subset_closure_image g.continuous hm)
        rintro _ ⟨y, hy, rfl⟩
        exact (hsubS hy).2
