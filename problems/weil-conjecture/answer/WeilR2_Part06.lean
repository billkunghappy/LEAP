  obtain ⟨L₁, adj₁, hL₁A, hL₁L, hL₁C⟩ :=
    proet_overPullback_exact_left_adjoint X.left (wcGeomPoint F X h)
  obtain ⟨LΛ, adjΛ, hLΛA, hLΛL, hLΛC⟩ :=
    sheafOfModules_toSheaf_exact_left_adjoint_of_torsionFree
      ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h)) (wcIntSliceRing F X h ℓ) htfΛ
  obtain ⟨LR, adjR, hLRA, hLRL, hLRC⟩ :=
    sheafOfModules_toSheaf_exact_left_adjoint_of_torsionFree
      ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h)) (wcSliceRing F X h ℓ) htfR

  obtain ⟨Z, ε₁, εΛ, H1, HΛ, HR⟩ := wc_int_slice_free_data F X h ℓ
  obtain ⟨ιZ, ιQ, hι⟩ := wc_int_slice_unit_isos F X h ℓ
  obtain ⟨ιQ', hι'⟩ : ∃ ιQ' : (SheafOfModules.toSheaf.{u+1} (wcIntSliceRing F X h ℓ)).obj
        ((SheafOfModules.restrictScalars (wcIntRatSliceMap F X h ℓ)).obj
          (SheafOfModules.unit (wcSliceRing F X h ℓ))) ≅
        ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)).obj
          (wcLadicSheaf X.left ℓ),
      (SheafOfModules.toSheaf.{u+1} (wcIntSliceRing F X h ℓ)).map
          (wcUnitRestrict (wcIntRatSliceMap F X h ℓ)) ≫ ιQ'.hom =
        ιZ.hom ≫ ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1}
          (wcGeomPoint F X h)).map (wcIntToLadic X.left ℓ) := ⟨ιQ, hι⟩

  obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : ∀ n, wcIntModCoh F X h ℓ n →+
      Abelian.Ext (SheafOfModules.unit (wcIntSliceRing F X h ℓ))
        ((SheafOfModules.restrictScalars (wcIntRatSliceMap F X h ℓ)).obj
          (SheafOfModules.unit (wcSliceRing F X h ℓ))) n,
      ∀ n a, Ψ n a = a.comp (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntRatSliceMap F X h ℓ)))
        (add_zero n) :=
    ⟨fun n => AddMonoidHom.mk' (fun a => a.comp
        (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntRatSliceMap F X h ℓ))) (add_zero n))
      (fun a b => Abelian.Ext.add_comp _ _ _ _), fun _ _ => rfl⟩
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : ∀ n, wcModCoh F X h ℓ n →+
      Abelian.Ext (SheafOfModules.unit (wcIntSliceRing F X h ℓ))
        ((SheafOfModules.restrictScalars (wcIntRatSliceMap F X h ℓ)).obj
          (SheafOfModules.unit (wcSliceRing F X h ℓ))) n,
      ∀ n x, Φ n x = (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntRatSliceMap F X h ℓ))).comp
        (Abelian.Ext.mapExactFunctor (wcIntRatRestrict F X h ℓ) x)
        (zero_add n) :=
    ⟨fun n => AddMonoidHom.mk' (fun x =>
        (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntRatSliceMap F X h ℓ))).comp
          (Abelian.Ext.mapExactFunctor (wcIntRatRestrict F X h ℓ) x)
          (zero_add n))
      (fun a b => by rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.comp_add]), fun _ _ => rfl⟩

  obtain ⟨BA, hBA⟩ : ∃ BA : ∀ n, wcIntModCoh F X h ℓ n →+ Abelian.Ext Z
      ((SheafOfModules.toSheaf.{u+1} (wcIntSliceRing F X h ℓ)).obj
        (SheafOfModules.unit (wcIntSliceRing F X h ℓ))) n,
      ∀ n a, BA n a = (Abelian.Ext.mk₀ εΛ).comp (Abelian.Ext.mapExactFunctor
        (SheafOfModules.toSheaf.{u+1} (wcIntSliceRing F X h ℓ)) a) (zero_add n) :=
    ⟨fun n => AddMonoidHom.mk' (fun a => (Abelian.Ext.mk₀ εΛ).comp (Abelian.Ext.mapExactFunctor
        (SheafOfModules.toSheaf.{u+1} (wcIntSliceRing F X h ℓ)) a) (zero_add n))
      (fun a b => by rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.comp_add]), fun _ _ => rfl⟩
  obtain ⟨BB, hBB⟩ : ∃ BB : ∀ n, Abelian.Ext (SheafOfModules.unit (wcIntSliceRing F X h ℓ))
        ((SheafOfModules.restrictScalars (wcIntRatSliceMap F X h ℓ)).obj
          (SheafOfModules.unit (wcSliceRing F X h ℓ))) n →+ Abelian.Ext Z
      ((SheafOfModules.toSheaf.{u+1} (wcIntSliceRing F X h ℓ)).obj
        ((SheafOfModules.restrictScalars (wcIntRatSliceMap F X h ℓ)).obj
          (SheafOfModules.unit (wcSliceRing F X h ℓ)))) n,
