      have hCd := wc_closed_dense_compl_dim_drop ↥S C k hC hdense hS
      let f : ↥(closure ({η} : Set B) ∩ Wᶜ) → ↥C := fun x => ⟨⟨x.1, x.2.1⟩, x.2.2⟩
      have hfc : Continuous f :=
        Continuous.subtype_mk (Continuous.subtype_mk continuous_subtype_val _) _
      have hgc : Topology.IsEmbedding (fun c : ↥C => ((c.1 : B))) :=
        Topology.IsEmbedding.subtypeVal.comp Topology.IsEmbedding.subtypeVal
      have hf : Topology.IsEmbedding f :=
        Topology.IsEmbedding.of_comp hfc hgc.continuous Topology.IsEmbedding.subtypeVal
      exact (h_emb_le f hf).trans hCd
  refine ⟨B'', π, Z'', iZ, T₁ ∪ (closure ({η} : Set B) ∩ Wᶜ), φ, hπ, hiZ, hB''irr, hB''dim, hZ'',
    hT₁c.union (isClosed_closure.inter hWo.isClosed_compl),
    h_union _ _ hT₁c (isClosed_closure.inter hWo.isClosed_compl) hT₁d hdimC, ?_⟩
  intro b hb
  have hb1 : b ∉ T₁ := fun h => hb (Or.inl h)
  have hbb : Function.Bijective ((wcEtStalk B b).map φ).hom := by
    by_cases hbB0 : b ∈ closure ({η} : Set B)
    · have hbW : b ∈ W := by
        by_contra h'
        exact hb (Or.inr ⟨hbB0, h'⟩)
      exact hbij b hbW (specializes_iff_mem_closure.mpr hbB0)
    · exact hoff b hb1 hbB0
  exact ⟨wc_et_stalk_kernel_subsingleton _ _ φ b hbb.1,
    wc_r2gc_stalk_coker_subsingleton _ _ φ b hbb.2⟩

theorem wc_et_generic_iso_card_le : ∀ (K : Type u) [Field K] [IsAlgClosed K] (S : Scheme.{u}) (fS : S ⟶ Spec (.of K)) [IsProper fS] (n : ℕ) (m : ℕ), (m : K) ≠ 0 → ∀ (G F : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) (φ : G ⟶ F), m • 𝟙 G = 0 → m • 𝟙 F = 0 → ∀ (T : Set S), IsClosed T → topologicalKrullDim ↥T < (n : WithBot ℕ∞) → (∀ b : S, b ∉ T → Subsingleton ((wcEtStalk S b).obj (Limits.kernel φ)) ∧ Subsingleton ((wcEtStalk S b).obj (Limits.cokernel φ))) → Finite (wcEtExt S F (2 * n)) → Finite (wcEtExt S G (2 * n)) ∧ Nat.card (wcEtExt S G (2 * n)) ≤ Nat.card (wcEtExt S F (2 * n)) :=
by
  intro K _ _ S fS _ n m hm G F φ hG hF T hT hTdim hstalk hFfin
  classical
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) := HasExt.standard _

  have hK : m • 𝟙 (Limits.kernel φ) = 0 := by
    rw [← cancel_mono (Limits.kernel.ι φ), Preadditive.nsmul_comp, Category.id_comp,
      Limits.zero_comp]
    have h : Limits.kernel.ι φ ≫ (m • 𝟙 G) = 0 := by rw [hG, Limits.comp_zero]
    rw [Preadditive.comp_nsmul, Category.comp_id] at h
    exact h
  have hQ : m • 𝟙 (Limits.cokernel φ) = 0 := by
    rw [← cancel_epi (Limits.cokernel.π φ), Preadditive.comp_nsmul, Category.comp_id,
      Limits.comp_zero]
    have h : (m • 𝟙 F) ≫ Limits.cokernel.π φ = 0 := by rw [hF, Limits.zero_comp]
    rw [Preadditive.nsmul_comp, Category.id_comp] at h
    exact h

  have v1 := wc_et_low_support_coh_vanish K S fS T hT n hTdim m hm (Limits.kernel φ) hK
    (fun b hb => (hstalk b hb).1) (2 * n) (by omega)
  have v2 : ∀ N₀ : ℕ, N₀ + 1 = 2 * n → ∀ x : Abelian.Ext ((constantSheaf
      (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      (Limits.cokernel φ) N₀, x = 0 := fun N₀ hN₀ =>
    wc_et_low_support_coh_vanish K S fS T hT n hTdim m hm (Limits.cokernel φ) hQ
      (fun b hb => (hstalk b hb).2) N₀ (by omega)

  let P := (constantSheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} ℤ))
  have hfac : Abelian.factorThruImage φ ≫ Abelian.image.ι φ = φ := Abelian.image.fac φ
  have w1 : Limits.kernel.ι φ ≫ Abelian.factorThruImage φ = 0 := by
    rw [← cancel_mono (Abelian.image.ι φ), Category.assoc, hfac, Limits.kernel.condition,
      Limits.zero_comp]
  have w2 : Abelian.image.ι φ ≫ Limits.cokernel.π φ = 0 := by
    rw [← cancel_epi (Abelian.factorThruImage φ), ← Category.assoc, hfac, Limits.cokernel.condition,
      Limits.comp_zero]
  let S1 := ShortComplex.mk (Limits.kernel.ι φ) (Abelian.factorThruImage φ) w1
  let Sk := ShortComplex.mk (Limits.kernel.ι φ) φ (Limits.kernel.condition φ)
  let ψ1 : S1 ⟶ Sk :=
    { τ₁ := 𝟙 _
      τ₂ := 𝟙 _
      τ₃ := Abelian.image.ι φ
      comm₁₂ := by simp [S1, Sk]
      comm₂₃ := by simp [S1, Sk, hfac] }
  haveI : Epi ψ1.τ₁ := by change Epi (𝟙 _); infer_instance
  haveI : IsIso ψ1.τ₂ := by change IsIso (𝟙 _); infer_instance
  haveI : Mono ψ1.τ₃ := by change Mono (Abelian.image.ι φ); infer_instance
  have hE1 : S1.Exact :=
    (ShortComplex.exact_iff_of_epi_of_isIso_of_mono ψ1).mpr (ShortComplex.exact_kernel φ)
  have hS1 : S1.ShortExact :=
    ShortComplex.ShortExact.mk' hE1 (inferInstance : Mono (Limits.kernel.ι φ))
      (inferInstance : Epi (Abelian.factorThruImage φ))
  let S2 := ShortComplex.mk (Abelian.image.ι φ) (Limits.cokernel.π φ) w2
  let Sc := ShortComplex.mk φ (Limits.cokernel.π φ) (Limits.cokernel.condition φ)
  let ψ2 : Sc ⟶ S2 :=
    { τ₁ := Abelian.factorThruImage φ
      τ₂ := 𝟙 _
      τ₃ := 𝟙 _
      comm₁₂ := by simp [S2, Sc, hfac]
      comm₂₃ := by simp [S2, Sc] }
  haveI : Epi ψ2.τ₁ := by change Epi (Abelian.factorThruImage φ); infer_instance
  haveI : IsIso ψ2.τ₂ := by change IsIso (𝟙 _); infer_instance
  haveI : Mono ψ2.τ₃ := by change Mono (𝟙 _); infer_instance
  have hE2 : S2.Exact :=
    (ShortComplex.exact_iff_of_epi_of_isIso_of_mono ψ2).mp (ShortComplex.exact_cokernel φ)
  have hS2 : S2.ShortExact :=
    ShortComplex.ShortExact.mk' hE2 (inferInstance : Mono (Abelian.image.ι φ))
      (inferInstance : Epi (Limits.cokernel.π φ))
  have key : ∀ N : ℕ, (∀ x : Abelian.Ext P (Limits.kernel φ) N, x = 0) →
      (∀ N₀ : ℕ, N₀ + 1 = N → ∀ x : Abelian.Ext P (Limits.cokernel φ) N₀, x = 0) →
      Function.Injective (fun x : Abelian.Ext P G N => x.comp (Abelian.Ext.mk₀ φ) (add_zero N)) := by
    intro N hKv hQv
    have hI : ∀ y : Abelian.Ext P (Abelian.image φ) N,
        y.comp (Abelian.Ext.mk₀ (Abelian.image.ι φ)) (add_zero N) = 0 → y = 0 := by
      cases N with
      | zero =>
        intro y hy
        obtain ⟨f, hf⟩ := (Abelian.Ext.mk₀_bijective P (Abelian.image φ)).2 y
        rw [← hf, Abelian.Ext.mk₀_comp_mk₀] at hy
        have h1 : f ≫ Abelian.image.ι φ = 0 := by
          have h2 : Abelian.Ext.mk₀ (f ≫ Abelian.image.ι φ) = Abelian.Ext.mk₀ (0 : P ⟶ F) := by
            rw [Abelian.Ext.mk₀_zero]; exact hy
          exact (Abelian.Ext.mk₀_bijective P F).1 h2
        have hf0 : f = 0 :=
          (cancel_mono (Abelian.image.ι φ)).mp (h1.trans Limits.zero_comp.symm)
        rw [← hf, hf0, Abelian.Ext.mk₀_zero]
      | succ N₀ =>
        intro y hy
        obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ P hS2 y hy rfl
        rw [← hx₃, hQv N₀ rfl x₃, Abelian.Ext.zero_comp]
    have hzero : ∀ x : Abelian.Ext P G N,
        x.comp (Abelian.Ext.mk₀ φ) (add_zero N) = 0 → x = 0 := by
      intro x hx
      have hy : (x.comp (Abelian.Ext.mk₀ (Abelian.factorThruImage φ)) (add_zero N)).comp
          (Abelian.Ext.mk₀ (Abelian.image.ι φ)) (add_zero N) = 0 := by
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero N) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, hfac]
        exact hx
      have hy0 := hI _ hy
      obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂ P hS1 x hy0
      rw [← hx₁, hKv x₁, Abelian.Ext.zero_comp]
    intro x x' hxx
    have hxx' : x.comp (Abelian.Ext.mk₀ φ) (add_zero N) =
        x'.comp (Abelian.Ext.mk₀ φ) (add_zero N) := hxx
    have h1 : (x - x').comp (Abelian.Ext.mk₀ φ) (add_zero N) = 0 := by
      rw [sub_eq_add_neg, Abelian.Ext.add_comp, Abelian.Ext.neg_comp, hxx', add_neg_cancel]
    exact sub_eq_zero.mp (hzero _ h1)
  have hinj := key (2 * n) v1 v2
  haveI hF' : Finite (Abelian.Ext P F (2 * n)) := hFfin
  show Finite (Abelian.Ext P G (2 * n)) ∧
    Nat.card (Abelian.Ext P G (2 * n)) ≤ Nat.card (Abelian.Ext P F (2 * n))
  exact ⟨Finite.of_injective _ hinj, Nat.card_le_card_of_injective _ hinj⟩

theorem wc_et_extZero_coh_card_ge : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y Z : Scheme.{u}) (fY : Y ⟶ Spec (.of K)) [IsProper fY] (iZ : Z ⟶ Y) [IsClosedImmersion iZ] (n : ℕ), topologicalKrullDim Y ≤ (n : WithBot ℕ∞) → topologicalKrullDim Z < (n : WithBot ℕ∞) → ∀ (m : ℕ), (m : K) ≠ 0 → Finite (wcEtExt Y (wcEtExtZero Y (Set.range iZ)ᶜ m) (2 * n)) → Finite (wcEtCoh Y m (2 * n)) ∧ Nat.card (wcEtCoh Y m (2 * n)) ≤ Nat.card (wcEtExt Y (wcEtExtZero Y (Set.range iZ)ᶜ m) (2 * n)) :=
by
  intro K _ _ Y Z fY _ iZ _ n _ hdim m hm hfin
  classical
  let α : wcEtExtZeroPre Y (Set.range iZ)ᶜ m ⟶
      (Functor.const _).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) :=
    { app := fun V => AddCommGrpCat.ofHom
        (wcSuppSub.{u} m (∀ x, V.unop.hom x ∈ (Set.range iZ)ᶜ)).subtype
      naturality := fun _ _ _ => rfl }
  have hmono : Mono (wcEtExtZeroι Y (Set.range iZ)ᶜ m) := by
    haveI : ∀ V, Mono (α.app V) := fun V =>
      (AddCommGrpCat.mono_iff_injective _).mpr (AddSubgroup.subtype_injective _)
    haveI : Mono α := NatTrans.mono_of_mono_app α
    exact Functor.map_mono (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) α
  let T := ShortComplex.mk (wcEtExtZeroι Y (Set.range iZ)ᶜ m) (Limits.cokernel.π _)
    (Limits.cokernel.condition _)
  have hTs : T.ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) hmono inferInstance
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  let P := (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} ℤ))

  have hsurjgen : ∀ q : ℕ, Subsingleton (Abelian.Ext P T.X₃ q) →
      Function.Surjective ((Abelian.Ext.mk₀ T.f).postcomp P (add_zero q)) := by
    intro q hq x₂
    have h0 : x₂.comp (Abelian.Ext.mk₀ T.g) (add_zero q) = 0 := Subsingleton.elim _ _
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂ P hTs x₂ h0
    exact ⟨x₁, hx₁⟩

  have hvan : Subsingleton (Abelian.Ext P T.X₃ (2 * n)) := by
    obtain _ | k := n
    ·
      have hZe : IsEmpty Z := by
        refine ⟨fun z => ?_⟩
        let c : TopologicalSpace.IrreducibleCloseds Z :=
          ⟨closure {z}, isIrreducible_singleton.closure, isClosed_closure⟩
        haveI : Nonempty (TopologicalSpace.IrreducibleCloseds Z) := ⟨c⟩
        have h0 : (0 : WithBot ℕ∞) ≤ topologicalKrullDim Z := by
          rw [topologicalKrullDim.eq_1]
          exact Order.krullDim_nonneg
        have h1 : topologicalKrullDim Z < 0 := by simpa using hdim
        exact lt_irrefl _ (lt_of_le_of_lt h0 h1)
      have hS : ∀ y : Y, y ∈ (Set.range iZ)ᶜ := by
        rintro y ⟨z, -⟩
        exact isEmptyElim z
      haveI : ∀ V, IsIso (α.app V) := by
        intro V
        apply (ConcreteCategory.isIso_iff_bijective _).mpr
        refine ⟨AddSubgroup.subtype_injective _, fun y => ?_⟩
        have hp : ∀ x, V.unop.hom x ∈ (Set.range iZ)ᶜ := fun x => hS _
        have hy : y ∈ wcSuppSub.{u} m (∀ x, V.unop.hom x ∈ (Set.range iZ)ᶜ) := by
          unfold wcSuppSub
          rw [iSup_pos hp]
          exact AddSubgroup.mem_top y
        exact ⟨⟨y, hy⟩, rfl⟩
      haveI : IsIso α := NatIso.isIso_of_isIso_app α
      haveI : IsIso (wcEtExtZeroι Y (Set.range iZ)ᶜ m) :=
        Functor.map_isIso (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) α
      have hZ : Limits.IsZero T.X₃ := Limits.isZero_cokernel_of_epi _
      haveI : Subsingleton (P ⟶ T.X₃) := ⟨fun f g => hZ.eq_of_tgt f g⟩
      exact (Abelian.Ext.homEquiv₀ (X := P) (Y := T.X₃)).subsingleton
    · have hdimZ : topologicalKrullDim Z ≤ (k : WithBot ℕ∞) := by
        rcases hd : topologicalKrullDim Z with _ | e
        · exact bot_le
        · rw [hd] at hdim
          have h1 : e < (((k + 1 : ℕ)) : ℕ∞) := WithBot.coe_lt_coe.mp hdim
          have h2 : e ≤ (k : ℕ∞) := by
            rw [Nat.cast_add, Nat.cast_one] at h1
            exact (ENat.lt_add_one_iff (ENat.coe_ne_top k)).mp h1
          exact WithBot.coe_le_coe.mpr h2
      have hMZ : m • 𝟙 ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) = 0 := by
        have h0 : (m : ℤ) • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) = 0 := by
          ext x
          simp
        rw [← natCast_zsmul, ← CategoryTheory.Functor.map_id (constantSheaf
          (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}), ← CategoryTheory.Functor.map_zsmul, h0,
          CategoryTheory.Functor.map_zero]
      letI : HasExt (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) := HasExt.standard _
      have h := wc_et_cd_proper_torsion K Z (iZ ≫ fY) k hdimZ m hm _ hMZ (2 * (k + 1)) (by omega)
      haveI : Subsingleton (wcEtCoh Z m (2 * (k + 1))) := by
        show Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Z)
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ((constantSheaf
            (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
              (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) (2 * (k + 1)))
        exact ⟨fun a b => (h a).trans (h b).symm⟩
      obtain ⟨e⟩ := wc_et_closed_complement_coh Y Z iZ m (2 * (k + 1))
      exact e.subsingleton
  change Finite (Abelian.Ext P T.X₂ (2 * n)) ∧
    Nat.card (Abelian.Ext P T.X₂ (2 * n)) ≤ Nat.card (Abelian.Ext P T.X₁ (2 * n))
  haveI h1 : Finite (Abelian.Ext P T.X₁ (2 * n)) := hfin
  have hsurj := hsurjgen (2 * n) hvan
  exact ⟨Finite.of_surjective _ hsurj, Nat.card_le_card_of_surjective _ hsurj⟩

theorem wcpa_dj_cf_sp_function_field_trdeg : ∀ (k : Type u) [Field k] (X : Scheme.{u}) [AlgebraicGeometry.IsIntegral X] (s : X ⟶ Spec (.of k)) [IsProper s], letI : Algebra k (X.presheaf.stalk (genericPoint X)) := ((Scheme.ΓSpecIso (.of k)).inv ≫ s.appTop ≫ X.presheaf.germ ⊤ (genericPoint X) trivial).hom.toAlgebra; (∃ S : Finset (X.presheaf.stalk (genericPoint X)), IntermediateField.adjoin k (S : Set (X.presheaf.stalk (genericPoint X))) = ⊤) ∧ ∃ (n : ℕ) (t : Fin n → X.presheaf.stalk (genericPoint X)), IsTranscendenceBasis k t ∧ topologicalKrullDim X = (n : WithBot ℕ∞) :=
by

  have s1 : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] [Algebra.IsIntegral R S],
      Function.Injective (algebraMap R S) → ringKrullDim S = ringKrullDim R := by
    intro R S _ _ _ _ hinj
    apply le_antisymm
    · apply Order.krullDim_le_of_strictMono (PrimeSpectrum.comap (algebraMap R S))
      intro p q hpq
      exact Ideal.IsIntegral.under_lt_under (R := R) (show p.asIdeal < q.asIdeal from hpq)
    · have key : ∀ p : LTSeries (PrimeSpectrum R), ∃ q : LTSeries (PrimeSpectrum S),
          q.length = p.length ∧ q.last.asIdeal.under R = p.last.asIdeal := by
        intro p
        induction p using RelSeries.inductionOn' with
        | singleton P =>
          obtain ⟨Q, -, hQ, hQP⟩ := Ideal.exists_ideal_over_prime_of_isIntegral P.asIdeal
            (⊥ : Ideal S) (by
              rw [Ideal.under, Ideal.comap_bot_of_injective _ hinj]; exact bot_le)
          exact ⟨RelSeries.singleton _ ⟨Q, hQ⟩, rfl, hQP⟩
        | snoc p P' hlt ih =>
          obtain ⟨q, hlen, hlast⟩ := ih
          obtain ⟨Q', hge, hQ', hQ'P⟩ := Ideal.exists_ideal_over_prime_of_isIntegral P'.asIdeal
            q.last.asIdeal (by rw [hlast]; exact le_of_lt hlt)
          have hlt' : q.last < (⟨Q', hQ'⟩ : PrimeSpectrum S) := by
            refine lt_of_le_of_ne hge ?_
            intro heq
            have h1 : q.last.asIdeal = Q' := congrArg PrimeSpectrum.asIdeal heq
            have h2 : p.last.asIdeal = P'.asIdeal := by rw [← hlast, ← hQ'P, h1]
            exact (ne_of_lt hlt) (PrimeSpectrum.ext h2)
          exact ⟨q.snoc ⟨Q', hQ'⟩ hlt', by simp [hlen], by simpa using hQ'P⟩
      unfold ringKrullDim Order.krullDim
      apply iSup_le
      intro p
      obtain ⟨q, hlen, -⟩ := key p
      rw [← hlen]
      exact Order.LTSeries.length_le_krullDim q

  have s2 : ∀ (k A : Type u) [Field k] [CommRing A] [IsDomain A] [Algebra k A] (s : ℕ)
      (g : MvPolynomial (Fin s) k →ₐ[k] A), Function.Injective g → g.Finite →
      Algebra.trdeg k A = s := by
    intro k A _ _ _ _ s g hg hfin
    letI : Algebra (MvPolynomial (Fin s) k) A := g.toRingHom.toAlgebra
    haveI : IsScalarTower k (MvPolynomial (Fin s) k) A :=
      IsScalarTower.of_algebraMap_eq' (g.comp_algebraMap).symm
    haveI : FaithfulSMul k (MvPolynomial (Fin s) k) :=
      (faithfulSMul_iff_algebraMap_injective _ _).mpr (MvPolynomial.C_injective _ _)
    haveI : FaithfulSMul (MvPolynomial (Fin s) k) A :=
      (faithfulSMul_iff_algebraMap_injective _ _).mpr hg
    haveI : Module.Finite (MvPolynomial (Fin s) k) A := hfin
    haveI : Algebra.IsIntegral (MvPolynomial (Fin s) k) A := Algebra.IsIntegral.of_finite _ _
    have h0 : Algebra.trdeg (MvPolynomial (Fin s) k) A = 0 :=
      trdeg_eq_zero_iff.mpr Algebra.IsIntegral.isAlgebraic
    have h1 := lift_trdeg_add_eq k (MvPolynomial (Fin s) k) A
    rw [Cardinal.lift_id, Cardinal.lift_id, Cardinal.lift_id, h0, add_zero,
      MvPolynomial.trdeg_of_isDomain, Cardinal.mk_fin, Cardinal.lift_natCast] at h1
    exact h1.symm

  have s7 : ∀ (k A : Type u) [Field k] [CommRing A] [IsDomain A] [Algebra k A]
      [Algebra.FiniteType k A],
      ∃ n : ℕ, ringKrullDim A = (n : WithBot ℕ∞) ∧ Algebra.trdeg k A = (n : Cardinal.{u}) := by
    intro k A _ _ _ _ _
    obtain ⟨s, g, hg, hfin⟩ := exists_finite_inj_algHom_of_fg k A
    refine ⟨s, ?_, s2 k A s g hg hfin⟩
    letI : Algebra (MvPolynomial (Fin s) k) A := g.toRingHom.toAlgebra
    haveI : Module.Finite (MvPolynomial (Fin s) k) A := hfin
    haveI : Algebra.IsIntegral (MvPolynomial (Fin s) k) A := Algebra.IsIntegral.of_finite _ _
    rw [s1 (MvPolynomial (Fin s) k) A hg, MvPolynomial.ringKrullDim_of_isNoetherianRing,
      ringKrullDim_eq_zero_of_field, ENat.card_eq_coe_fintype_card, Fintype.card_fin, zero_add]
    rfl

  have s4 : ∀ (T : Type u) [TopologicalSpace T] (n : WithBot ℕ∞),
      (∀ x : T, ∃ W : Set T, IsOpen W ∧ x ∈ W ∧ topologicalKrullDim W ≤ n) →
      topologicalKrullDim T ≤ n := by
    intro T _ n H
    unfold topologicalKrullDim Order.krullDim
    apply iSup_le
    intro p
    obtain ⟨x, hx⟩ := (p 0).isIrreducible.nonempty
    obtain ⟨W, hWo, hxW, hWd⟩ := H x
    have hmem : ∀ i, x ∈ (p i : Set T) := fun i =>
      (p.monotone (Fin.zero_le i)) hx
    let f : Fin (p.length + 1) → TopologicalSpace.IrreducibleCloseds W := fun i =>
      ⟨Subtype.val ⁻¹' (p i : Set T),
          (p i).isIrreducible.preimage (hWo.isOpenEmbedding_subtypeVal)
            ⟨x, hmem i, ⟨⟨x, hxW⟩, rfl⟩⟩,
          (p i).isClosed.preimage continuous_subtype_val⟩
    have hf : ∀ i, (f i : Set W) = Subtype.val ⁻¹' (p i : Set T) := fun i => rfl
    have hstep : ∀ i : Fin p.length, f i.castSucc < f i.succ := by
      intro i
      have hlt : p i.castSucc < p i.succ := p.step i
      have hle : (p i.castSucc : Set T) ⊆ (p i.succ : Set T) := le_of_lt hlt
      refine lt_of_le_of_ne ?_ ?_
      · show (f i.castSucc : Set W) ⊆ (f i.succ : Set W)
        rw [hf, hf]
        exact Set.preimage_mono hle
      · intro heq
        apply (ne_of_lt hlt)
        have heq' : (Subtype.val : W → T) ⁻¹' (p i.castSucc : Set T) =
            (Subtype.val : W → T) ⁻¹' (p i.succ : Set T) := by
          rw [← hf, ← hf, heq]
        apply le_antisymm (le_of_lt hlt)
        show (p i.succ : Set T) ⊆ (p i.castSucc : Set T)
        intro y hy
        have h1 : (p i.succ : Set T) ⊆ closure ((p i.succ : Set T) ∩ W) :=
          subset_closure_inter_of_isPreirreducible_of_isOpen
            (p i.succ).isIrreducible.isPreirreducible hWo ⟨x, hmem _, hxW⟩
        have h2 : (p i.succ : Set T) ∩ W ⊆ (p i.castSucc : Set T) := by
          rintro z ⟨hz1, hz2⟩
          have : (⟨z, hz2⟩ : W) ∈ Subtype.val ⁻¹' (p i.succ : Set T) := hz1
          rw [← heq'] at this
          exact this
        exact (closure_minimal h2 (p i.castSucc).isClosed) (h1 hy)
    let q : LTSeries (TopologicalSpace.IrreducibleCloseds W) :=
      { length := p.length
        toFun := f
        step := hstep }
    have := Order.LTSeries.length_le_krullDim q
    exact le_trans this hWd

  have s6 : ∀ (k : Type u) [Field k] (T : Scheme.{u}) (s : T ⟶ Spec (.of k))
      [LocallyOfFiniteType s] (U : T.Opens), IsAffineOpen U →
      ((Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ s.appTop ≫
        T.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.FiniteType := by
    intro k _ T s _ U hU
    have h := HasRingHomProperty.appLE @LocallyOfFiniteType s inferInstance
      ⟨⊤, isAffineOpen_top _⟩ ⟨U, hU⟩ (by simp)
    have e : s.appTop ≫ T.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op =
        s.appLE ⊤ U (by simp) := rfl
    rw [e, CommRingCat.hom_comp]
    refine RingHom.FiniteType.comp h (RingHom.FiniteType.of_surjective _ ?_)
    intro x
    refine ⟨(Scheme.ΓSpecIso (CommRingCat.of k)).hom x, ?_⟩
    rw [← CommRingCat.comp_apply, Iso.hom_inv_id, CommRingCat.id_apply]

  have stower : ∀ (F : Type u) [Field F] (W : Scheme.{u}) [AlgebraicGeometry.IsIntegral W]
      (s : W ⟶ Spec (.of F)) (U : W.Opens) [Nonempty U],
      ((Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫ s.appTop ≫
        W.presheaf.germ ⊤ (genericPoint W) trivial).hom =
        (W.germToFunctionField U).hom.comp ((Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫ s.appTop ≫
        W.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom := by
    intro F _ W _ s U _
    rw [← CommRingCat.hom_comp]
    congr 1
    rw [Category.assoc, Category.assoc, Scheme.germToFunctionField, TopCat.Presheaf.germ_res]

  have s3 : ∀ (F : Type u) [Field F] (W : Scheme.{u}) [AlgebraicGeometry.IsIntegral W]
      (s : W ⟶ Spec (.of F)) (U : W.Opens), IsAffineOpen U → U ≠ ⊥ →
      @Algebra.trdeg F Γ(W, U) _ _ ((Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫ s.appTop ≫
        W.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.toAlgebra =
      @Algebra.trdeg F W.functionField _ _ ((Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫ s.appTop ≫
        W.presheaf.germ ⊤ (genericPoint W) trivial).hom.toAlgebra := by
    intro F _ W _ s U hU hne
    haveI : Nonempty U := by
      obtain ⟨x, hx⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).mp hne
      exact ⟨⟨x, hx⟩⟩
    letI iA : Algebra F Γ(W, U) := ((Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫ s.appTop ≫
        W.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.toAlgebra
    letI iK : Algebra F W.functionField := ((Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫ s.appTop ≫
        W.presheaf.germ ⊤ (genericPoint W) trivial).hom.toAlgebra
    haveI : IsFractionRing Γ(W, U) W.functionField :=
      functionField_isFractionRing_of_isAffineOpen W U hU
    haveI : IsScalarTower F Γ(W, U) W.functionField :=
      IsScalarTower.of_algebraMap_eq' (stower F W s U)
    haveI : FaithfulSMul F Γ(W, U) :=
      (faithfulSMul_iff_algebraMap_injective _ _).mpr (RingHom.injective _)
    haveI : FaithfulSMul Γ(W, U) W.functionField :=
      (faithfulSMul_iff_algebraMap_injective _ _).mpr (IsFractionRing.injective _ _)
    have h0 : Algebra.trdeg Γ(W, U) W.functionField = 0 :=
      trdeg_eq_zero_iff.mpr (IsLocalization.isAlgebraic _ (nonZeroDivisors Γ(W, U)))
    have h1 := lift_trdeg_add_eq F Γ(W, U) W.functionField
    rw [Cardinal.lift_id, Cardinal.lift_id, Cardinal.lift_id, h0, add_zero] at h1
    exact h1

  intro k _ X _ s _
  letI iK : Algebra k X.functionField := ((Scheme.ΓSpecIso (.of k)).inv ≫ s.appTop ≫
    X.presheaf.germ ⊤ (genericPoint X) trivial).hom.toAlgebra
  obtain ⟨x₀⟩ := (AlgebraicGeometry.IsIntegral.nonempty : Nonempty X)
  obtain ⟨U₀, hU₀, hx₀, -⟩ :=
    exists_isAffineOpen_mem_and_subset (show x₀ ∈ (⊤ : X.Opens) from trivial)
  have hU₀ne : U₀ ≠ ⊥ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U₀).mpr ⟨x₀, hx₀⟩
  haveI hU₀n : Nonempty U₀ := ⟨⟨x₀, hx₀⟩⟩
  refine ⟨?_, ?_⟩
  ·
    letI iA : Algebra k Γ(X, U₀) := ((Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ s.appTop ≫
        X.presheaf.map (homOfLE (le_top : U₀ ≤ ⊤)).op).hom.toAlgebra
    haveI hft : Algebra.FiniteType k Γ(X, U₀) := s6 k X s U₀ hU₀
    haveI : IsFractionRing Γ(X, U₀) X.functionField :=
      functionField_isFractionRing_of_isAffineOpen X U₀ hU₀
    haveI : IsScalarTower k Γ(X, U₀) X.functionField :=
      IsScalarTower.of_algebraMap_eq' (stower k X s U₀)
    obtain ⟨T, hT⟩ := hft.out
    classical
    let φ : Γ(X, U₀) →ₐ[k] X.functionField := IsScalarTower.toAlgHom k Γ(X, U₀) X.functionField
    refine ⟨T.image φ, ?_⟩
    have hmem : ∀ r : Γ(X, U₀), algebraMap Γ(X, U₀) X.functionField r ∈
        IntermediateField.adjoin k ((T.image φ : Finset X.functionField) : Set X.functionField) := by
      intro r
      have hr : r ∈ Algebra.adjoin k (T : Set Γ(X, U₀)) := by rw [hT]; trivial
      have h1 : φ r ∈ (Algebra.adjoin k (T : Set Γ(X, U₀))).map φ :=
        Subalgebra.mem_map.mpr ⟨r, hr, rfl⟩
      rw [AlgHom.map_adjoin, ← Finset.coe_image] at h1
      exact IntermediateField.algebra_adjoin_le_adjoin k _ h1
    rw [eq_top_iff]
    intro z _
    obtain ⟨a, b, -, rfl⟩ := IsFractionRing.div_surjective (A := Γ(X, U₀)) z
    exact IntermediateField.div_mem _ (hmem a) (hmem b)
  ·
    have hnU : ∀ U : X.Opens, IsAffineOpen U → U ≠ ⊥ → ∃ m : ℕ,
        ringKrullDim Γ(X, U) = (m : WithBot ℕ∞) ∧
        @Algebra.trdeg k Γ(X, U) _ _ ((Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ s.appTop ≫
          X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.toAlgebra = (m : Cardinal.{u}) := by
      intro U hU hne
      haveI : Nonempty U := by
        obtain ⟨x, hx⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).mp hne
        exact ⟨⟨x, hx⟩⟩
      haveI : IsDomain Γ(X, U) := IsIntegral.component_integral U
      letI : Algebra k Γ(X, U) := ((Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ s.appTop ≫
          X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.toAlgebra
      haveI : Algebra.FiniteType k Γ(X, U) := s6 k X s U hU
      exact s7 k Γ(X, U)
    have hdimU : ∀ U : X.Opens, IsAffineOpen U →
        topologicalKrullDim (U : Set X) = ringKrullDim Γ(X, U) := fun U hU =>
      (IsHomeomorph.topologicalKrullDim_eq _ (Scheme.homeoOfIso hU.isoSpec).isHomeomorph).trans
        (PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim Γ(X, U))
    obtain ⟨n, hn1, hn2⟩ := hnU U₀ hU₀ hU₀ne
    have hall : ∀ U : X.Opens, IsAffineOpen U → U ≠ ⊥ →
        ringKrullDim Γ(X, U) = (n : WithBot ℕ∞) := by
      intro U hU hne
      obtain ⟨m, hm1, hm2⟩ := hnU U hU hne
      have h3 := (s3 k X s U hU hne).trans (s3 k X s U₀ hU₀ hU₀ne).symm
      rw [hm2, hn2] at h3
      have hmn : m = n := by exact_mod_cast h3
      rw [hm1, hmn]
    have hdim : topologicalKrullDim X = (n : WithBot ℕ∞) := by
      refine le_antisymm ?_ ?_
      · apply s4 X (n : WithBot ℕ∞)
        intro x
        obtain ⟨W, hW, hxW, -⟩ :=
          exists_isAffineOpen_mem_and_subset (show x ∈ (⊤ : X.Opens) from trivial)
        refine ⟨W, W.isOpen, hxW, ?_⟩
        rw [hdimU W hW, hall W hW ((TopologicalSpace.Opens.ne_bot_iff_nonempty W).mpr ⟨x, hxW⟩)]
      · rw [← hn1, ← hdimU U₀ hU₀]
        exact topologicalKrullDim_subspace_le X U₀
    have hK : Algebra.trdeg k X.functionField = (n : Cardinal.{u}) :=
      (s3 k X s U₀ hU₀ hU₀ne).symm.trans hn2
    haveI : FaithfulSMul k X.functionField :=
      (faithfulSMul_iff_algebraMap_injective _ _).mpr (RingHom.injective _)
    obtain ⟨B, hB⟩ := exists_isTranscendenceBasis k X.functionField
    have hcard : Cardinal.mk B = (n : Cardinal.{u}) := hB.cardinalMk_eq_trdeg.trans hK
    obtain ⟨e⟩ := Cardinal.mk_eq_nat_iff.mp hcard
    exact ⟨n, Subtype.val ∘ e.symm, hB.comp_equiv e.symm, hdim⟩

theorem wc_gpd_point_closure_dim_trdeg : ∀ (K : Type u) [Field K] (X : Scheme.{u}) (s : X ⟶ Spec (.of K)) [IsProper s] (x : X), ∃ d : ℕ, topologicalKrullDim ↥(closure ({x} : Set X)) = (d : WithBot ℕ∞) ∧ (letI : Algebra K (X.residueField x) := (Spec.preimage (X.fromSpecResidueField x ≫ s)).hom.toAlgebra; Algebra.trdeg K (X.residueField x) = d) :=
by
  intro K _ X s _ x
  classical

  let Z : TopologicalSpace.Closeds X := ⟨closure {x}, isClosed_closure⟩
  let I := Scheme.IdealSheafData.vanishingIdeal Z
  obtain ⟨Y, r, hr, hrr, hred⟩ := wc_reduced_subscheme_exists I.subscheme
  haveI := hr
  haveI := hred
  obtain ⟨ι, hιdef⟩ : ∃ ι : Y ⟶ X, ι = r ≫ I.subschemeι := ⟨_, rfl⟩
  haveI hι : IsClosedImmersion ι := by rw [hιdef]; infer_instance
  have hrange : Set.range ι = closure ({x} : Set X) := by
    have e : (⇑ι : Y → X) = ⇑I.subschemeι ∘ ⇑r := by rw [hιdef]; rfl
    rw [e, Set.range_comp, hrr, Set.image_univ, Scheme.IdealSheafData.range_subschemeι,
      Scheme.IdealSheafData.coe_support_vanishingIdeal]
    rfl
  have hemb : Topology.IsEmbedding ι := ι.isClosedEmbedding.isEmbedding
  have hirrX : IrreducibleSpace ↥(closure ({x} : Set X)) :=
    Subtype.irreducibleSpace isIrreducible_singleton.closure
  have hirrY : IrreducibleSpace Y := by
    let h : Y ≃ₜ ↥(closure ({x} : Set X)) := hemb.toHomeomorph.trans (Homeomorph.setCongr hrange)
    exact Function.Surjective.irreducibleSpace h.symm.continuous h.symm.surjective
  haveI : IrreducibleSpace Y := hirrY
  haveI : AlgebraicGeometry.IsIntegral Y := isIntegral_of_irreducibleSpace_of_isReduced Y
  obtain ⟨y, hy⟩ : x ∈ Set.range ι := by
    rw [hrange]; exact subset_closure (Set.mem_singleton x)
  have hcl : closure ({y} : Set Y) = Set.univ := by
    rw [hemb.isInducing.closure_eq_preimage_closure_image, Set.image_singleton, hy, ← hrange,
      Set.preimage_range]
  have hgen : y = genericPoint Y := (isGenericPoint_def.mpr hcl).eq (genericPoint_spec Y)
  subst hgen
  subst hy

  obtain ⟨-, n, t₀, hb, hdim⟩ := wcpa_dj_cf_sp_function_field_trdeg K Y (ι ≫ s)

  have htr1 : (letI : Algebra K (Y.presheaf.stalk (genericPoint Y)) :=
      ((Scheme.ΓSpecIso (.of K)).inv ≫ (ι ≫ s).appTop ≫
        Y.presheaf.germ ⊤ (genericPoint Y) trivial).hom.toAlgebra;
      Algebra.trdeg K (Y.presheaf.stalk (genericPoint Y))) = n := by
    letI i0 : Algebra K (Y.presheaf.stalk (genericPoint Y)) :=
      ((Scheme.ΓSpecIso (.of K)).inv ≫ (ι ≫ s).appTop ≫
        Y.presheaf.germ ⊤ (genericPoint Y) trivial).hom.toAlgebra
    have h := hb.lift_cardinalMk_eq_trdeg
    rw [Cardinal.mk_fin, Cardinal.lift_natCast, Cardinal.lift_uzero] at h
    exact h.symm

  have hρinj : Function.Injective (Y.residue (genericPoint Y)).hom := by
    have hF : IsField (Y.presheaf.stalk (genericPoint Y)) := Field.toIsField Y.functionField
    rw [RingHom.injective_iff_ker_eq_bot]
    show RingHom.ker (IsLocalRing.residue _) = ⊥
    rw [IsLocalRing.ker_residue, ← IsLocalRing.isField_iff_maximalIdeal_eq]
    exact hF
  have LE : ∀ (t : Y ⟶ Spec (.of K)),
      (letI : Algebra K (Y.presheaf.stalk (genericPoint Y)) :=
        ((Scheme.ΓSpecIso (.of K)).inv ≫ t.appTop ≫
          Y.presheaf.germ ⊤ (genericPoint Y) trivial).hom.toAlgebra;
        Algebra.trdeg K (Y.presheaf.stalk (genericPoint Y))) =
      (letI : Algebra K (Y.residueField (genericPoint Y)) :=
        (Spec.preimage (Y.fromSpecResidueField (genericPoint Y) ≫ t)).hom.toAlgebra;
        Algebra.trdeg K (Y.residueField (genericPoint Y))) := by
    intro t
    letI i1 : Algebra K (Y.presheaf.stalk (genericPoint Y)) :=
      ((Scheme.ΓSpecIso (.of K)).inv ≫ t.appTop ≫
        Y.presheaf.germ ⊤ (genericPoint Y) trivial).hom.toAlgebra
    letI i2 : Algebra K (Y.residueField (genericPoint Y)) :=
      (Spec.preimage (Y.fromSpecResidueField (genericPoint Y) ≫ t)).hom.toAlgebra
    have hD : Spec.preimage (Y.fromSpecResidueField (genericPoint Y) ≫ t) =
        (Scheme.ΓSpecIso (.of K)).inv ≫ t.appTop ≫ Y.presheaf.germ ⊤ (genericPoint Y) trivial ≫
          Y.residue (genericPoint Y) := by
      apply Spec.map_injective
      rw [Spec.map_preimage]
      simp only [Spec.map_comp, Category.assoc]
      rw [← Scheme.fromSpecStalk_toSpecΓ_assoc, ← Scheme.toSpecΓ_naturality_assoc,
        toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id, ← Category.assoc]
      rfl
    let f : Y.presheaf.stalk (genericPoint Y) →ₐ[K] Y.residueField (genericPoint Y) :=
      { (Y.residue (genericPoint Y)).hom with
        commutes' := fun k => by
          show (Y.residue (genericPoint Y)).hom
              (((Scheme.ΓSpecIso (.of K)).inv ≫ t.appTop ≫
                Y.presheaf.germ ⊤ (genericPoint Y) trivial).hom k) =
            (Spec.preimage (Y.fromSpecResidueField (genericPoint Y) ≫ t)).hom k
          rw [hD]
          rfl }
    exact (AlgEquiv.ofBijective f ⟨hρinj, Y.residue_surjective _⟩).trdeg_eq

  have LC : (letI : Algebra K (X.residueField (ι (genericPoint Y))) :=
        (Spec.preimage (X.fromSpecResidueField (ι (genericPoint Y)) ≫ s)).hom.toAlgebra;
        Algebra.trdeg K (X.residueField (ι (genericPoint Y)))) =
      (letI : Algebra K (Y.residueField (genericPoint Y)) :=
        (Spec.preimage (Y.fromSpecResidueField (genericPoint Y) ≫ ι ≫ s)).hom.toAlgebra;
        Algebra.trdeg K (Y.residueField (genericPoint Y))) := by
    letI i1 : Algebra K (X.residueField (ι (genericPoint Y))) :=
      (Spec.preimage (X.fromSpecResidueField (ι (genericPoint Y)) ≫ s)).hom.toAlgebra
    letI i2 : Algebra K (Y.residueField (genericPoint Y)) :=
      (Spec.preimage (Y.fromSpecResidueField (genericPoint Y) ≫ ι ≫ s)).hom.toAlgebra
    have h1 : Spec.preimage (Y.fromSpecResidueField (genericPoint Y) ≫ ι ≫ s) =
        Spec.preimage (X.fromSpecResidueField (ι (genericPoint Y)) ≫ s) ≫
          ι.residueFieldMap (genericPoint Y) := by
      apply Spec.map_injective
      rw [Spec.map_preimage, Spec.map_comp, Spec.map_preimage,
        Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField_assoc]
    have hinj : Function.Injective (ι.residueFieldMap (genericPoint Y)).hom := RingHom.injective _
    have hsurj : Function.Surjective (ι.residueFieldMap (genericPoint Y)).hom := by
      have hc := Scheme.residue_residueFieldMap ι (genericPoint Y)
      have hcomp : (ι.residueFieldMap (genericPoint Y)).hom ∘ (X.residue (ι (genericPoint Y))).hom =
          (Y.residue (genericPoint Y)).hom ∘ (ι.stalkMap (genericPoint Y)).hom := by
        funext a
        exact congrArg (fun φ => φ.hom a) hc
      have hs : Function.Surjective
          ((ι.residueFieldMap (genericPoint Y)).hom ∘ (X.residue (ι (genericPoint Y))).hom) := by
        rw [hcomp]
        exact (Y.residue_surjective _).comp (ι.stalkMap_surjective _)
      exact Function.Surjective.of_comp hs
    let f : X.residueField (ι (genericPoint Y)) →ₐ[K] Y.residueField (genericPoint Y) :=
      { (ι.residueFieldMap (genericPoint Y)).hom with
        commutes' := fun k => by
          show (ι.residueFieldMap (genericPoint Y)).hom
              ((Spec.preimage (X.fromSpecResidueField (ι (genericPoint Y)) ≫ s)).hom k) =
            (Spec.preimage (Y.fromSpecResidueField (genericPoint Y) ≫ ι ≫ s)).hom k
          rw [h1]
          rfl }
    exact (AlgEquiv.ofBijective f ⟨hinj, hsurj⟩).trdeg_eq
  refine ⟨n, ?_, ?_⟩
  · let h : Y ≃ₜ ↥(closure ({ι (genericPoint Y)} : Set X)) :=
      hemb.toHomeomorph.trans (Homeomorph.setCongr hrange)
    exact (IsHomeomorph.topologicalKrullDim_eq _ h.isHomeomorph).symm.trans hdim
  · exact LC.trans ((LE (ι ≫ s)).symm.trans htr1)

theorem wc_gpd_fibre_closure_dim_trdeg : ∀ (X B : Scheme.{u}) (g : X ⟶ B) [IsProper g] (x : X), ∃ e : ℕ, topologicalKrullDim ↥(closure ({x} : Set X) ∩ ⇑g ⁻¹' {g x}) = (e : WithBot ℕ∞) ∧ (letI : Algebra (B.residueField (g x)) (X.residueField x) := (g.residueFieldMap x).hom.toAlgebra; Algebra.trdeg (B.residueField (g x)) (X.residueField x) = e) :=
by
  intro X B g _ x
  classical

  have hT : ∀ (b : B) (x' : ↥(Limits.pullback g (B.fromSpecResidueField b))),
      topologicalKrullDim ↥(closure ({x'} : Set ↥(Limits.pullback g (B.fromSpecResidueField b)))) =
      topologicalKrullDim ↥(closure ({(Limits.pullback.fst g (B.fromSpecResidueField b)) x'} : Set X) ∩
        ⇑g ⁻¹' {b}) := by
    intro b x'
    have hE : Topology.IsEmbedding ⇑(Limits.pullback.fst g (B.fromSpecResidueField b)) :=
      (Limits.pullback.fst g (B.fromSpecResidueField b)).isEmbedding
    have hcl : closure ({x'} : Set ↥(Limits.pullback g (B.fromSpecResidueField b))) =
        ⇑(Limits.pullback.fst g (B.fromSpecResidueField b)) ⁻¹'
          closure {(Limits.pullback.fst g (B.fromSpecResidueField b)) x'} := by
      rw [hE.isInducing.closure_eq_preimage_closure_image, Set.image_singleton]
    have hrng : Set.range ⇑(Limits.pullback.fst g (B.fromSpecResidueField b)) = ⇑g ⁻¹' {b} := by
      rw [Scheme.Pullback.range_fst, Scheme.range_fromSpecResidueField]
    have hf : Topology.IsEmbedding (⇑(Limits.pullback.fst g (B.fromSpecResidueField b)) ∘
        (Subtype.val : closure ({x'} : Set ↥(Limits.pullback g (B.fromSpecResidueField b))) → _)) :=
      hE.comp Topology.IsEmbedding.subtypeVal
    have hrange : Set.range (⇑(Limits.pullback.fst g (B.fromSpecResidueField b)) ∘
        (Subtype.val : closure ({x'} : Set ↥(Limits.pullback g (B.fromSpecResidueField b))) → _)) =
        closure ({(Limits.pullback.fst g (B.fromSpecResidueField b)) x'} : Set X) ∩ ⇑g ⁻¹' {b} := by
      rw [Set.range_comp, Subtype.range_coe, hcl, Set.image_preimage_eq_inter_range, hrng]
    exact IsHomeomorph.topologicalKrullDim_eq _
      ((hf.toHomeomorph).trans (Homeomorph.setCongr hrange)).isHomeomorph

  have hxr : x ∈ Set.range ⇑(Limits.pullback.fst g (B.fromSpecResidueField (g x))) := by
    rw [Scheme.Pullback.range_fst, Scheme.range_fromSpecResidueField]
    rfl
  obtain ⟨x', hx'⟩ := hxr

  obtain ⟨e, hd, ht⟩ := wc_gpd_point_closure_dim_trdeg (↑(B.residueField (g x)) : Type u)
    (Limits.pullback g (B.fromSpecResidueField (g x)))
    (Limits.pullback.snd g (B.fromSpecResidueField (g x))) x'
  refine ⟨e, ?_, ?_⟩
  · have h := hT (g x) x'
    rw [hx'] at h
    rw [← h]
    exact hd
  · letI iL : Algebra (B.residueField (g x)) (X.residueField x) :=
      (g.residueFieldMap x).hom.toAlgebra
    letI iR : Algebra (B.residueField (g x))
        ((Limits.pullback g (B.fromSpecResidueField (g x))).residueField x') :=
      (Spec.preimage ((Limits.pullback g (B.fromSpecResidueField (g x))).fromSpecResidueField x' ≫
        Limits.pullback.snd g (B.fromSpecResidueField (g x)))).hom.toAlgebra
    have ht' : Algebra.trdeg (B.residueField (g x))
