  have hcof := wc_et_geomstalk_cofiltered B η wc_etale_maps_agree_near_geom_point

  have key : ∀ (F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1})
      (x₀ : (wcEtStalk B η).obj F),
      ∃ (A₀ : StructuredArrow (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B))
