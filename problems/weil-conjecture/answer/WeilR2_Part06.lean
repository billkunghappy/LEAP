theorem wc_et_modell_proj_leray_free : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsProper f] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (D1 : wcEtPullData (Limits.pullback.fst f f) ℓ) (D2 : wcEtPullData (Limits.pullback.snd f f) ℓ) (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing (Limits.pullback f f) ℓ))) (n r : ℕ) (b : Fin r → wcEtZModExt Y ℓ n), (∀ z : wcEtZModExt Y ℓ n, ∃! c : Fin r → ZMod ℓ, z = ∑ i, (c i).val • b i) → ∀ (g : Fin r → (D1.Φ.obj (SheafOfModules.unit (wcEtZModRing Y ℓ)) ⟶ I.cocomplex.X n)) (hg : ∀ i, g i ≫ I.cocomplex.d n (n + 1) = 0), letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f f) ℓ)) := HasExt.standard _; letI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst f f)) _ _ D1.cont D1.φ).Additive := @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D1.adj D1.additive; (∀ i, I.extMk (g i) (n + 1) rfl (hg i) = (Abelian.Ext.mk₀ D1.μ.hom).comp (wcEtPull D2 n (b i)) (zero_add n)) → ∀ (hf : ∀ i, D1.adj.homEquiv _ _ (g i) ≫ (((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst f f)) _ _ D1.cont D1.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).d n (n + 1) = 0), IsIso (Limits.Sigma.desc (fun i : Fin r => (((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst f f)) _ _ D1.cont D1.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).liftCycles (D1.adj.homEquiv _ _ (g i)) (n + 1) (by simp) (hf i) ≫ (((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst f f)) _ _ D1.cont D1.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homologyπ n)) :=
by
  intro K _ _ Y f _ ℓ _ hℓ D1 D2 I n r b hb g hg hgE hf

  have key : ∀ (N : SheafOfModules.{u+1} (wcEtZModRing Y ℓ))
      (ι' : Fin r → (SheafOfModules.unit (wcEtZModRing Y ℓ) ⟶ N)),
      (∀ (y : Y) (c : Fin r → ZMod ℓ), (wcEtStalk Y y).map
        ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).map (∑ i, (c i).val • ι' i)) = 0 → c = 0) →
