        NatTrans.ext (funext fun V =>
          ((toSheafify (Scheme.smallEtaleTopology X)
            ((Functor.const (X.Etale)ᵒᵖ).obj A)).naturality (β.hom.app V.unop).op).symm)
      have hfin := gen2 (wcR2gsConstRes (Scheme.Etale.mk σ) A).hom _ _ _ L1 key
      refine Eq.trans ?_ (hfin.trans rfl)
      exact congrArg (fun t => toSheafify (Scheme.smallEtaleTopology X)
        ((Functor.const (X.Etale)ᵒᵖ).obj A) ≫ (wcR2gsConstRes (Scheme.Etale.mk σ) A).hom ≫ t)
        (hθc ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj A))
  obtain ⟨θ, hθ⟩ := hs3
  haveI hGA : ((wcEtSlice (Scheme.Etale.mk σ)).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology (Scheme.Etale.mk σ).left) (Scheme.smallEtaleTopology X)).Additive :=
    @Functor.additive_of_iso _ _ _ _ _ _ _ hFA _ θ.symm
  haveI hGPFL : Limits.PreservesFiniteLimits
      ((wcEtSlice (Scheme.Etale.mk σ)).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology (Scheme.Etale.mk σ).left) (Scheme.smallEtaleTopology X)) :=
    @Limits.preservesFiniteLimits_of_natIso _ _ _ _ _ _ θ.symm hFL
  haveI hGPFC : Limits.PreservesFiniteColimits
      ((wcEtSlice (Scheme.Etale.mk σ)).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology (Scheme.Etale.mk σ).left) (Scheme.smallEtaleTopology X)) :=
    @Limits.preservesFiniteColimits_of_natIso _ _ _ _ _ _ θ.symm hFC
  haveI hIsoΛ : IsIso (wcR2gsConstRes (Scheme.Etale.mk σ)
      (AddCommGrpCat.of (ULift.{u+1} (ZMod M)))) := by
    have h := hθ (AddCommGrpCat.of (ULift.{u+1} (ZMod M)))
    haveI : IsIso (wcR2gsConstRes (Scheme.Etale.mk σ) (AddCommGrpCat.of (ULift.{u+1} (ZMod M))) ≫
        θ.hom.app ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod M))))) := by
      rw [h]
      exact hcanμ
    exact @IsIso.of_isIso_comp_right _ _ _ _ _ _ (θ.hom.app _) (Iso.isIso_hom (θ.app _)) this

  obtain ⟨μ, hμ, hnat⟩ := wc_r2gs_coh_zmodext_natural M hM n
  obtain ⟨D₀, hD₀⟩ := hnat (Scheme.Etale.mk σ)
  let e := AddEquiv.ofBijective (μ X) (hμ X)
  refine ⟨e.symm, e.symm.bijective, fun x => ?_⟩
  obtain ⟨y, rfl⟩ : ∃ y, μ X y = x := (hμ X).2 x
  have hy : e.symm (μ X y) = y := e.symm_apply_apply y
  have h1 : wcEtPull D n (μ X y) = μ X (wcR2gsRes (Scheme.Etale.mk σ) M n y) :=
    (hindep D₀ (μ X y)).symm.trans (hD₀ y).symm
  have h2 : e.symm (μ X (wcR2gsRes (Scheme.Etale.mk σ) M n y)) =
      wcR2gsRes (Scheme.Etale.mk σ) M n y :=
    e.symm_apply_apply _
  rw [h1, h2, hy, wcR2gsRes, dif_pos ⟨hcont, hGA, hGPFL, hGPFC, hIsoΛ⟩]
  exact (@s4 (wcEtPush (inv σ))
    ((wcEtSlice (Scheme.Etale.mk σ)).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology (Scheme.Etale.mk σ).left) (Scheme.smallEtaleTopology X))
    _ _ _ hGA hGPFL hGPFC θ _ _
    (wcR2gsConstRes (Scheme.Etale.mk σ) (AddCommGrpCat.of (ULift.{u+1} ℤ)))
    (wcR2gsConstRes (Scheme.Etale.mk σ) (AddCommGrpCat.of (ULift.{u+1} (ZMod M))))
    (wcEtCanConst (inv σ) (AddCommGrpCat.of (ULift.{u+1} ℤ)))
    (wcEtCanConst (inv σ) (AddCommGrpCat.of (ULift.{u+1} (ZMod M))))
    hIsoΛ hcanμ (hθ _) (hθ _) y).symm

theorem wc_ext_twist_extClass : ∀ {C : Type*} [Category C] [Abelian C] [HasExt C] (F : C ⥤ C) [F.Additive] [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F] {S : ShortComplex C} (hS : S.ShortExact) {P : C} (cP : P ⟶ F.obj P) (c₁ : S.X₁ ⟶ F.obj S.X₁) (c₂ : S.X₂ ⟶ F.obj S.X₂) (c₃ : S.X₃ ⟶ F.obj S.X₃) [IsIso c₁] [IsIso c₃], c₁ ≫ F.map S.f = S.f ≫ c₂ → c₂ ≫ F.map S.g = S.g ≫ c₃ → ∀ (n : ℕ) (h : Abelian.Ext P S.X₃ n), wcExtTwist F cP c₁ (n + 1) (h.comp hS.extClass rfl) = (wcExtTwist F cP c₃ n h).comp hS.extClass rfl :=
by
  intro C _ _ _ F _ _ _ S hS P cP c₁ c₂ c₃ _ _ hc1 hc2 n h
  have hSF : (S.map F).ShortExact := hS.map_of_exact F
  let φ : S ⟶ S.map F := ShortComplex.homMk c₁ c₂ c₃ hc1 hc2
  have hN : hS.extClass.comp (Abelian.Ext.mk₀ c₁) (add_zero 1) =
      (Abelian.Ext.mk₀ c₃).comp hSF.extClass (zero_add 1) :=
    hS.extClass_naturality hSF φ
  have hK : hSF.extClass.comp (Abelian.Ext.mk₀ (inv c₁)) (add_zero 1) =
      (Abelian.Ext.mk₀ (inv c₃)).comp hS.extClass (zero_add 1) := by
    have e1 : (Abelian.Ext.mk₀ (inv c₃)).comp
        ((hS.extClass.comp (Abelian.Ext.mk₀ c₁) (add_zero 1)).comp
          (Abelian.Ext.mk₀ (inv c₁)) (add_zero 1)) (zero_add 1)
        = (Abelian.Ext.mk₀ (inv c₃)).comp hS.extClass (zero_add 1) := by
      rw [Abelian.Ext.comp_assoc hS.extClass (Abelian.Ext.mk₀ c₁) (Abelian.Ext.mk₀ (inv c₁))
        (add_zero 1) (zero_add 0) (by omega), Abelian.Ext.mk₀_comp_mk₀, IsIso.hom_inv_id,
        Abelian.Ext.comp_mk₀_id]
    rw [← e1, hN, Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ c₃) hSF.extClass
        (Abelian.Ext.mk₀ (inv c₁)) (zero_add 1) (add_zero 1) (by omega),
      ← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (inv c₃)) (Abelian.Ext.mk₀ c₃)
        (hSF.extClass.comp (Abelian.Ext.mk₀ (inv c₁)) (add_zero 1)) (zero_add 0) (zero_add 1)
        (by omega),
      Abelian.Ext.mk₀_comp_mk₀, IsIso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
  show (Abelian.Ext.mk₀ cP).comp ((Abelian.Ext.mapExactFunctor F (h.comp hS.extClass rfl)).comp
      (Abelian.Ext.mk₀ (inv c₁)) (add_zero (n + 1))) (zero_add (n + 1)) =
    ((Abelian.Ext.mk₀ cP).comp ((Abelian.Ext.mapExactFunctor F h).comp
      (Abelian.Ext.mk₀ (inv c₃)) (add_zero n)) (zero_add n)).comp hS.extClass rfl
  rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass,
    Abelian.Ext.comp_assoc (Abelian.Ext.mapExactFunctor F h) hSF.extClass
      (Abelian.Ext.mk₀ (inv c₁)) rfl (add_zero 1) (by omega), hK,
    Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ cP)
      ((Abelian.Ext.mapExactFunctor F h).comp (Abelian.Ext.mk₀ (inv c₃)) (add_zero n))
      hS.extClass (zero_add n) rfl (by omega),
    Abelian.Ext.comp_assoc (Abelian.Ext.mapExactFunctor F h) (Abelian.Ext.mk₀ (inv c₃))
      hS.extClass (add_zero n) (zero_add 1) (by omega)]

theorem wc_pow_kummer_can_compat : ∀ (X : Scheme.{u}) (g : X ⟶ X) (M : ℕ) (z : Γ(X, ⊤)), g.appTop.hom z = z → ∀ κ : (Functor.const (Scheme.Etale X)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod M))) ⟶ wcEtGmPre X, (∀ (U : X.Etale) (x : ULift.{u+1} (ZMod M)), ((Additive.toMul (κ.app (Opposite.op U) x).down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)) = (U.hom.appTop.hom z) ^ x.down.val) → wcEtCanConst g (AddCommGrpCat.of (ULift.{u+1} (ZMod M))) ≫ (wcEtPush g).map ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map κ) = (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map κ ≫ wcEtCanGm g :=
by
  intro X g M z hz κ hκ
  have hpt : ∀ (U : X.Etale),
      (Limits.pullback.fst U.hom g).appTop.hom (U.hom.appTop.hom z) =
        ((wcEtBaseChange g).obj U).hom.appTop.hom z := by
    intro U
    have e1 : (Limits.pullback.fst U.hom g).appTop.hom (U.hom.appTop.hom z) =
        (Limits.pullback.fst U.hom g ≫ U.hom).appTop.hom z := by
      simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
    rw [e1, Limits.pullback.condition]
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
    rw [hz]
    rfl
  have hstar : ((({ app := fun _ => 𝟙 _, naturality := fun _ _ _ => rfl } :
        (Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod M))) ⟶
          (wcEtBaseChange g).op ⋙ (Functor.const (X.Etale)ᵒᵖ).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod M))))) ≫
        Functor.whiskerLeft (wcEtBaseChange g).op κ) =
      κ ≫ Functor.whiskerRight (NatTrans.op (wcEtBaseChangeFst g))
        (Scheme.Γ ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙
          CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}) := by
    apply NatTrans.ext
    funext V
    induction V using Opposite.rec with
    | op U =>
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    apply ULift.ext
    apply Additive.toMul.injective
    apply Units.ext
    change ((Additive.toMul (κ.app (Opposite.op ((wcEtBaseChange g).obj U)) x).down :
        (Γ(((wcEtBaseChange g).obj U).left, ⊤))ˣ) : Γ(((wcEtBaseChange g).obj U).left, ⊤)) =
      (Limits.pullback.fst U.hom g).appTop.hom
        ((Additive.toMul (κ.app (Opposite.op U) x).down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤))
    rw [hκ, hκ, map_pow, hpt]
    rfl
  have hpre : ((({ app := fun _ => 𝟙 _, naturality := fun _ _ _ => rfl } :
        (Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod M))) ⟶
          (wcEtBaseChange g).op ⋙ (Functor.const (X.Etale)ᵒᵖ).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod M))))) ≫
        Functor.whiskerLeft (wcEtBaseChange g).op
          (toSheafify (Scheme.smallEtaleTopology X) ((Functor.const (X.Etale)ᵒᵖ).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod M)))))) ≫
        Functor.whiskerLeft (wcEtBaseChange g).op
          (sheafifyMap (Scheme.smallEtaleTopology X) κ) =
      κ ≫ (Functor.whiskerRight (NatTrans.op (wcEtBaseChangeFst g))
        (Scheme.Γ ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙
          CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}) ≫
        Functor.whiskerLeft (wcEtBaseChange g).op
          (toSheafify (Scheme.smallEtaleTopology X) (wcEtGmPre X))) := by
    rw [Category.assoc, ← Functor.whiskerLeft_comp, ← toSheafify_naturality,
      Functor.whiskerLeft_comp, ← Category.assoc, hstar]
    exact Category.assoc _ _ _
  exact (Functor.map_comp _ _ _).symm.trans
    ((congrArg (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map hpre).trans
      (Functor.map_comp _ _ _))

theorem wc_et_aut_base_semilinear : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IsIntegral X] (σ : X ⟶ X) [IsIso σ], ∃ ρ : Spec (.of Ω) ⟶ Spec (.of Ω), IsIso ρ ∧ σ ≫ fX = fX ≫ ρ :=
by
  intro Ω _ _ X fX _ _ σ _
  have he1 : ∀ x, (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom
      ((Scheme.ΓSpecIso (CommRingCat.of Ω)).hom.hom x) = x := fun x => by
    rw [← CommRingCat.comp_apply, Iso.hom_inv_id]; rfl
  have he2 : ∀ y, (Scheme.ΓSpecIso (CommRingCat.of Ω)).hom.hom
      ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom y) = y := fun y => by
    rw [← CommRingCat.comp_apply, Iso.inv_hom_id]; rfl
  have hφint : fX.appTop.hom.IsIntegral := isIntegral_appTop_of_universallyClosed fX
  have h1 : ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom).IsIntegral :=
    RingHom.isIntegral_of_surjective _ (fun x => ⟨_, he1 x⟩)
  have hψ : (fX.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom).IsIntegral :=
    RingHom.IsIntegral.trans _ _ h1 hφint
  have hbij : Function.Bijective
      (fX.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom) :=
    IsAlgClosed.ringHom_bijective_of_isIntegral (k := Ω) _ hψ
  have hebij : Function.Bijective (Scheme.ΓSpecIso (CommRingCat.of Ω)).hom.hom :=
    Function.bijective_iff_has_inverse.mpr ⟨_, he1, he2⟩
  have hφbij : Function.Bijective fX.appTop.hom := by
    have hEq : (fX.appTop.hom : _ → _) =
        (fX.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom) ∘
          (Scheme.ΓSpecIso (CommRingCat.of Ω)).hom.hom := by
      funext x
      simp only [Function.comp_apply, RingHom.comp_apply, he1]
    rw [hEq]
    exact hbij.comp hebij
  haveI : IsIso fX.appTop := (ConcreteCategory.isIso_iff_bijective fX.appTop).mpr hφbij
  haveI : IsIso σ.appTop := inferInstanceAs (IsIso (σ.app ⊤))
  let r := fX.appTop ≫ σ.appTop ≫ inv fX.appTop
  let g := (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫ r ≫ (Scheme.ΓSpecIso (CommRingCat.of Ω)).hom
  refine ⟨Spec.map g, inferInstance, ?_⟩
  have hρ : (Spec.map g).appTop = r := by
    rw [← cancel_mono (Scheme.ΓSpecIso (CommRingCat.of Ω)).hom, Scheme.ΓSpecIso_naturality]
    simp only [g, Iso.hom_inv_id_assoc]
  apply ext_of_isAffine
  rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop, hρ]
  simp only [r, Category.assoc, IsIso.inv_hom_id, Category.comp_id]

theorem wc_et_divisor_ses_short_exact : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IsIntegral X], (∀ x : X, IsIntegrallyClosed (X.presheaf.stalk x)) → topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) → ∀ ord : wcEtGmAtPre X (genericPoint X) ⟶ wcEtDivPre Ω X fX, wcOrdChar Ω X fX ord → ∃ h : wcEtGmToAt X (genericPoint X) ≫ (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map ord = 0, (ShortComplex.mk (wcEtGmToAt X (genericPoint X)) ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map ord) h).ShortExact :=
by
  intro Ω _ _ X fX _ _ hnorm hdim ord hchar

  have hv0 : ∀ (R : Type u) [CommRing R] (r : R), IsUnit r → wcLocVal R r = 0 := by
    intro R _ r hr
    classical
    unfold wcLocVal
    split_ifs with h
    · rw [Nat.find_eq_zero]
      obtain ⟨n, w, ϖ, hϖ, _⟩ := h
      exact ⟨hr.unit, ϖ, hϖ, by simp⟩
    · rfl

  have hbridge : ∀ (U : X.Etale) (e : Γ(U.left, ⊤)),
      wcGenRestr X U ⊤ (wcGenRho X U e) = wcGenSigma X U ⊤ e := by
    intro U e
    have h1 : wcGenRho X U e =
        (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))).appTop.hom e := by
      (simp [wcGenRho, Over.mapPullbackAdj_counit_app, Scheme.Γ_map]) <;> rfl
    rw [h1]
    unfold wcGenRestr wcGenSigma
    have h2 : (homOfLE le_top : (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ ⊤ ⟶
        (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ ⊤) = 𝟙 _ :=
      Subsingleton.elim _ _
    erw [h2, op_id, CategoryTheory.Functor.map_id]
    rfl

  have hK : wcEtGmToAtPre X (genericPoint X) ≫ ord = 0 := by
    apply NatTrans.ext
    funext U
    induction U using Opposite.rec with
    | op U =>
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro a
    let a' : (Γ(U.left, ⊤))ˣ := Additive.toMul a.down
    let b : (Γ(wcGenPt X U, ⊤))ˣ := Units.map (wcGenRho X U).toMonoidHom a'
    have hb : (b : Γ(wcGenPt X U, ⊤)) = wcGenRho X U (a' : Γ(U.left, ⊤)) := rfl
    change ord.app (Opposite.op U) (ULift.up (Additive.ofMul b)) = 0
    apply ULift.ext
    apply Subtype.ext
    funext s
    change ((ord.app (Opposite.op U) (ULift.up (Additive.ofMul b))).down).1 s = (0 : ℤ)
    apply hchar U b s 0
    have hu : IsUnit (U.left.presheaf.germ ⊤ (s.1 (IsLocalRing.closedPoint Ω)) trivial
        (a' : Γ(U.left, ⊤))) :=
      a'.isUnit.map (U.left.presheaf.germ ⊤ (s.1 (IsLocalRing.closedPoint Ω)) trivial).hom
    refine ⟨⊤, trivial, 1, (a' : Γ(U.left, ⊤)), ?_, ?_, ?_, ?_, ?_⟩
    · rw [map_one]; exact isUnit_one
    · rw [map_one, one_mul, hb, hbridge]
    · rw [map_one]; exact one_ne_zero
    · exact hu.ne_zero
    · rw [hv0 _ _ hu, map_one, hv0 _ _ isUnit_one]
      rfl
  have hsurj := wc_ord_locally_surjective Ω X fX hnorm hdim ord hchar
  have hex := wc_ord_kernel_local Ω X fX hnorm hdim ord hchar
  have h : (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
      (wcEtGmToAtPre X (genericPoint X)) ≫
      (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map ord = 0 := by
    rw [← Functor.map_comp, hK, Functor.map_zero]
  have hepi : Epi ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map ord) := by
    rw [← Sheaf.isLocallySurjective_iff_epi']
    exact (Presheaf.isLocallySurjective_presheafToSheaf_map_iff _ ord).mpr hsurj
  have hk : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X)
      (Limits.kernel.lift ord (wcEtGmToAtPre X (genericPoint X)) hK) := by
    refine Presheaf.IsLocallySurjective.mk (fun {U} s => ?_)
    have ht : ord.app (Opposite.op U) ((Limits.kernel.ι ord).app (Opposite.op U) s) = 0 := by
      rw [← ConcreteCategory.comp_apply, ← NatTrans.comp_app, Limits.kernel.condition]
      rfl
    refine GrothendieckTopology.superset_covering _ ?_ (hex U _ ht)
    intro V φ hφ
    obtain ⟨r, hr⟩ := hφ
    refine ⟨r, ?_⟩
    have hm : Mono ((Limits.kernel.ι ord).app (Opposite.op V)) :=
      (NatTrans.mono_iff_mono_app _).mp inferInstance _
    apply (AddCommGrpCat.mono_iff_injective _).mp hm
    rw [← ConcreteCategory.comp_apply, ← NatTrans.comp_app, Limits.kernel.lift_ι, hr,
      ← ConcreteCategory.comp_apply, ← ConcreteCategory.comp_apply, NatTrans.naturality]
  have hkF : Epi ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
      (Limits.kernel.lift ord (wcEtGmToAtPre X (genericPoint X)) hK)) := by
    rw [← Sheaf.isLocallySurjective_iff_epi']
    exact (Presheaf.isLocallySurjective_presheafToSheaf_map_iff _ _).mpr hk
  have heq : Limits.kernel.lift
      ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map ord)
      ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
        (wcEtGmToAtPre X (genericPoint X))) h =
      (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
        (Limits.kernel.lift ord (wcEtGmToAtPre X (genericPoint X)) hK) ≫
      (Limits.PreservesKernel.iso
        (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) ord).hom := by
    rw [Limits.PreservesKernel.iso_hom, Limits.map_lift_kernelComparison]
  have hexact : (ShortComplex.mk ((presheafToSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).map (wcEtGmToAtPre X (genericPoint X)))
      ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map ord) h).Exact := by
    rw [ShortComplex.exact_iff_epi_kernel_lift]
    change Epi (Limits.kernel.lift
        ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map ord)
        ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
          (wcEtGmToAtPre X (genericPoint X))) h)
    rw [heq]
    exact epi_comp _ _
  have hmono : Mono ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
      (wcEtGmToAtPre X (genericPoint X))) := wc_et_gm_to_generic_mono X
  exact ⟨h, ShortComplex.ShortExact.mk' hexact hmono hepi⟩

theorem wc_ord_rep_transport_iso : ∀ (X : Scheme.{u}) [IsIntegral X] (U U' : X.Etale) (i : U'.left ⟶ U.left) [IsIso i] (Θ : wcGenPt X U' ⟶ wcGenPt X U), Θ ≫ Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X)) = Limits.pullback.fst U'.hom (X.fromSpecStalk (genericPoint X)) ≫ i → ∀ (b : Γ(wcGenPt X U, ⊤)) (x : U'.left) (n : ℤ), wcOrdRep X U b (i x) n → wcOrdRep X U' (Θ.appTop.hom b) x n :=
by
  intro X _ U U' i _ Θ hΘ b x n hR
  obtain ⟨W, hx, g, h, hu, he, hg, hh, hn⟩ := hR

  have locval : ∀ {R S : Type u} [CommRing R] [CommRing S] (e : R ≃+* S) (r : R),
      wcLocVal S (e r) = wcLocVal R r := by
    intro R S _ _ e r
    have key : ∀ k : ℕ, (∃ (v : Rˣ) (ϖ : R), Irreducible ϖ ∧ r = (v : R) * ϖ ^ k) ↔
        (∃ (v : Sˣ) (ϖ : S), Irreducible ϖ ∧ e r = (v : S) * ϖ ^ k) := by
      intro k
      constructor
      · rintro ⟨v, ϖ, hϖ, hr⟩
        refine ⟨Units.map (e : R →* S) v, e ϖ, hϖ.map e, ?_⟩
        rw [hr, map_mul, map_pow, Units.coe_map]
        rfl
      · rintro ⟨v, ϖ, hϖ, hr⟩
        refine ⟨Units.map (e.symm : S →* R) v, e.symm ϖ, hϖ.map e.symm, ?_⟩
        rw [← e.symm_apply_apply r, hr, map_mul, map_pow, Units.coe_map]
        rfl
    unfold wcLocVal
    split_ifs with h1 h2 h2
    · classical
      exact le_antisymm (Nat.find_min' h1 ((key _).1 (Nat.find_spec h2)))
        (Nat.find_min' h2 ((key _).2 (Nat.find_spec h1)))
    · exact absurd (let ⟨k, hk⟩ := h1; ⟨k, (key k).2 hk⟩) h2
    · exact absurd (let ⟨k, hk⟩ := h2; ⟨k, (key k).1 hk⟩) h1
    · rfl

  have appLE_eq : ∀ {S T : Scheme.{u}} {k k' : S ⟶ T} (e : k = k') (O : T.Opens) (O' : S.Opens)
      (h₁ : O' ≤ k ⁻¹ᵁ O) (h₂ : O' ≤ k' ⁻¹ᵁ O), k.appLE O O' h₁ = k'.appLE O O' h₂ := by
    intro S T k k' e O O' h₁ h₂
    subst e
    rfl
  have hle : (Limits.pullback.fst U'.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ (i ⁻¹ᵁ W) ≤
      Θ ⁻¹ᵁ ((Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ W) := by
    intro y hy
    have e : (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) (Θ y) =
        i ((Limits.pullback.fst U'.hom (X.fromSpecStalk (genericPoint X))) y) := by
      rw [← Scheme.Hom.comp_apply, hΘ, Scheme.Hom.comp_apply]
    show (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) (Θ y) ∈ W
    rw [e]
    exact hy
  let ψm := Θ.appLE ((Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ W)
    ((Limits.pullback.fst U'.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ (i ⁻¹ᵁ W)) hle
  have hσm : i.app W ≫
      (Limits.pullback.fst U'.hom (X.fromSpecStalk (genericPoint X))).app (i ⁻¹ᵁ W) =
      (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))).app W ≫ ψm := by
    rw [← Scheme.Hom.comp_app, Scheme.Hom.app_eq_appLE]
    exact (appLE_eq hΘ.symm W _ _ _).trans (Scheme.Hom.comp_appLE Θ _ W _ hle)
  have hσ : ∀ f : Γ(U.left, W), wcGenSigma X U' (i ⁻¹ᵁ W) ((i.app W).hom f) =
      ψm.hom (wcGenSigma X U W f) := fun f => congrArg (fun k => k.hom f) hσm
  have htopV : (Limits.pullback.fst U'.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ (i ⁻¹ᵁ W) ≤
      Θ ⁻¹ᵁ ⊤ := le_top
  have htopU : (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ W ≤ ⊤ := le_top
  have hrm : Θ.app ⊤ ≫ (wcGenPt X U').presheaf.map (homOfLE htopV).op =
      (wcGenPt X U).presheaf.map (homOfLE htopU).op ≫ ψm := by
    rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_map]
    show _ = _ ≫ Θ.appLE _ _ hle
    rw [Scheme.Hom.map_appLE]
  have hr : ∀ b : Γ(wcGenPt X U, ⊤), wcGenRestr X U' (i ⁻¹ᵁ W) (Θ.appTop.hom b) =
      ψm.hom (wcGenRestr X U W b) := fun b => congrArg (fun k => k.hom b) hrm

  let ε := (asIso (i.stalkMap x)).commRingCatIsoToRingEquiv
  have gsa := Scheme.Hom.germ_stalkMap_apply i W x hx
  have gsa' : ∀ c : Γ(U.left, W), U'.left.presheaf.germ (i ⁻¹ᵁ W) x hx ((i.app W).hom c) =
      ε (U.left.presheaf.germ W (i x) hx c) := fun c => (gsa c).symm
  refine ⟨i ⁻¹ᵁ W, hx, (i.app W).hom g, (i.app W).hom h, ?_, ?_, ?_, ?_, ?_⟩
  · rw [hσ]
    exact hu.map ψm.hom
  · rw [hσ g, hr b, hσ h, ← map_mul, he]
  · rw [gsa']
    exact (map_ne_zero_iff ε ε.injective).mpr hg
  · rw [gsa']
    exact (map_ne_zero_iff ε ε.injective).mpr hh
  · rw [gsa', gsa', locval ε, locval ε]
    exact hn

theorem wc_et_div_pull_exists : ∀ (Ω : Type u) [Field Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) (σ : X ⟶ X) [IsIso σ] (ρ : Spec (.of Ω) ⟶ Spec (.of Ω)) [IsIso ρ], σ ≫ fX = fX ≫ ρ → ∃ α : wcEtDivPre Ω X fX ⟶ (wcEtBaseChange σ).op ⋙ wcEtDivPre Ω X fX, wcEtDivPullProp Ω X fX σ ρ α :=
by
  intro Ω _ X fX σ _ ρ _ hρ
  classical
  have memeq : ∀ {α : Type u} {a b : α} {S : Set α}, a = b → b ∈ S → a ∈ S :=
    fun h hb => h ▸ hb
  have hpt : ∀ (f : Spec (.of Ω) ⟶ Spec (.of Ω)) (x : ↥(Spec (.of Ω))), f x = x :=
    fun _ _ => Subsingleton.elim _ _
  have hσinj : Function.Injective ⇑σ := by
    intro a b h
    exact (Scheme.hom_inv_apply (asIso σ) a).symm.trans
      ((congrArg (fun z => (asIso σ).inv z) h).trans (Scheme.hom_inv_apply (asIso σ) b))
  have hP1 : ∀ (V : X.Etale) (u : Spec (.of Ω) ⟶ Limits.pullback V.hom σ),
      u ≫ Limits.pullback.snd V.hom σ ≫ fX = 𝟙 _ →
      (inv ρ ≫ u ≫ Limits.pullback.fst V.hom σ) ≫ V.hom ≫ fX = 𝟙 _ := by
    intro V u hu
    calc (inv ρ ≫ u ≫ Limits.pullback.fst V.hom σ) ≫ V.hom ≫ fX
        = inv ρ ≫ (u ≫ Limits.pullback.snd V.hom σ ≫ fX) ≫ ρ := by
          simp only [Category.assoc, Limits.pullback.condition_assoc, hρ]
      _ = 𝟙 _ := by rw [hu, Category.id_comp, IsIso.inv_hom_id]
  have E1 : ∀ (V : X.Etale) (u : Spec (.of Ω) ⟶ Limits.pullback V.hom σ),
      (inv ρ ≫ u ≫ Limits.pullback.fst V.hom σ) (IsLocalRing.closedPoint Ω) =
        Limits.pullback.fst V.hom σ (u (IsLocalRing.closedPoint Ω)) := by
    intro V u
    exact (Scheme.Hom.comp_apply (inv ρ) (u ≫ Limits.pullback.fst V.hom σ) _).trans
      ((Scheme.Hom.comp_apply u (Limits.pullback.fst V.hom σ) _).trans
        (congrArg (fun z => Limits.pullback.fst V.hom σ (u z)) (hpt (inv ρ) _)))
  have E2 : ∀ (V : X.Etale) (u : Spec (.of Ω) ⟶ Limits.pullback V.hom σ),
      ((inv ρ ≫ u ≫ Limits.pullback.fst V.hom σ) ≫ V.hom) (IsLocalRing.closedPoint Ω) =
        σ ((u ≫ Limits.pullback.snd V.hom σ) (IsLocalRing.closedPoint Ω)) := by
    intro V u
    have e : (inv ρ ≫ u ≫ Limits.pullback.fst V.hom σ) ≫ V.hom =
        inv ρ ≫ (u ≫ Limits.pullback.snd V.hom σ) ≫ σ := by
      simp only [Category.assoc, Limits.pullback.condition]
    exact (congrArg (fun k : Spec (.of Ω) ⟶ X => k (IsLocalRing.closedPoint Ω)) e).trans
      ((Scheme.Hom.comp_apply (inv ρ) ((u ≫ Limits.pullback.snd V.hom σ) ≫ σ) _).trans
        ((Scheme.Hom.comp_apply (u ≫ Limits.pullback.snd V.hom σ) σ _).trans
          (congrArg (fun z => σ ((u ≫ Limits.pullback.snd V.hom σ) z)) (hpt (inv ρ) _))))
  have hlf : ∀ {V V' : X.Etale} (c : V' ⟶ V),
      ((wcEtBaseChange σ).map c).left ≫ Limits.pullback.fst V.hom σ =
        Limits.pullback.fst V'.hom σ ≫ c.left := by
    intro V V' c
    first
      | exact (wcEtBaseChangeFst σ).naturality c
      | exact Limits.pullback.lift_fst _ _ _
      | simp [wcEtBaseChange]
  let sOf : ∀ V : X.Etale, wcEtPts Ω X fX ((wcEtBaseChange σ).obj V) → wcEtPts Ω X fX V :=
    fun V t => ⟨inv ρ ≫ t.1 ≫ Limits.pullback.fst V.hom σ, hP1 V t.1 t.2⟩
  have memPull : ∀ (V : X.Etale) (a : wcEtDivSub Ω X fX V),
      (fun t => a.1 (sOf V t)) ∈ wcEtDivSub Ω X fX ((wcEtBaseChange σ).obj V) := by
    intro V a y
    obtain ⟨W₀, hW₀, hy, T₀, hT₀, h₀⟩ := a.2 (Limits.pullback.fst V.hom σ y)
    refine ⟨(Limits.pullback.fst V.hom σ) ⁻¹' W₀, hW₀.preimage (Scheme.Hom.continuous _), hy,
      σ ⁻¹' T₀, Set.Finite.preimage hσinj.injOn hT₀, fun t ht htW => ?_⟩
    have h1 := h₀ (sOf V t) ht (memeq (S := W₀) (E1 V t.1) htW)
    exact memeq (S := T₀) (E2 V t.1).symm h1
  let αapp : ∀ V : (X.Etale)ᵒᵖ, (wcEtDivPre Ω X fX).obj V ⟶
      ((wcEtBaseChange σ).op ⋙ wcEtDivPre Ω X fX).obj V := fun V =>
    AddCommGrpCat.ofHom (X := ULift.{u+1} (wcEtDivSub Ω X fX V.unop))
      (Y := ULift.{u+1} (wcEtDivSub Ω X fX ((wcEtBaseChange σ).obj V.unop)))
      { toFun := fun a => ULift.up ⟨fun t => a.down.1 (sOf V.unop t), memPull V.unop a.down⟩
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
  let α : wcEtDivPre Ω X fX ⟶ (wcEtBaseChange σ).op ⋙ wcEtDivPre Ω X fX :=
    { app := αapp
      naturality := by
        intro V V' g
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        intro a
        apply ULift.ext
        apply Subtype.ext
        funext t
        show (ULift.down a).1 _ = (ULift.down a).1 _
        refine congrArg (ULift.down a).1 (Subtype.ext ?_)
        show (inv ρ ≫ t.1 ≫ Limits.pullback.fst V'.unop.hom σ) ≫ g.unop.left =
          inv ρ ≫ (t.1 ≫ ((wcEtBaseChange σ).map g.unop).left) ≫
            Limits.pullback.fst V.unop.hom σ
        simp only [Category.assoc]
        exact congrArg (fun k => inv ρ ≫ t.1 ≫ k) (hlf g.unop).symm }
  have hαprop : wcEtDivPullProp Ω X fX σ ρ α := by
    intro V a t s hs
    show (ULift.down a).1 (sOf V t) = (ULift.down a).1 s
    exact congrArg (ULift.down a).1 (Subtype.ext hs.symm : sOf V t = s)
  exact ⟨α, hαprop⟩

theorem wc_et_div_can_squares : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IsIntegral X], (∀ x : X, IsIntegrallyClosed (X.presheaf.stalk x)) → topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) → ∀ ord : wcEtGmAtPre X (genericPoint X) ⟶ wcEtDivPre Ω X fX, wcOrdChar Ω X fX ord → ∀ (σ : X ⟶ X) [IsIso σ] (ρ : Spec (.of Ω) ⟶ Spec (.of Ω)) [IsIso ρ], σ ≫ fX = fX ≫ ρ → ∃ c₂ : wcEtGmAt X (genericPoint X) ⟶ (wcEtPush σ).obj (wcEtGmAt X (genericPoint X)), wcEtCanGm σ ≫ (wcEtPush σ).map (wcEtGmToAt X (genericPoint X)) = wcEtGmToAt X (genericPoint X) ≫ c₂ ∧ c₂ ≫ (wcEtPush σ).map ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map ord) = (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map ord ≫ wcEtCanDiv Ω X fX σ ρ :=
by
  intro Ω _ _ X fX _ _ _ _ ord hchar σ _ ρ _ hρ
  classical

  have s1 : ∀ {P P' Q Q' : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (f : Q ⟶ Q') (f₀ : P ⟶ P')
      (α : P ⟶ (wcEtBaseChange σ).op ⋙ Q) (α' : P' ⟶ (wcEtBaseChange σ).op ⋙ Q'),
      α ≫ Functor.whiskerLeft (wcEtBaseChange σ).op f = f₀ ≫ α' →
      (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
          (α ≫ Functor.whiskerLeft (wcEtBaseChange σ).op
            (toSheafify (Scheme.smallEtaleTopology X) Q)) ≫
        (wcEtPush σ).map ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f) =
      (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f₀ ≫
        (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
          (α' ≫ Functor.whiskerLeft (wcEtBaseChange σ).op
            (toSheafify (Scheme.smallEtaleTopology X) Q')) := by
    intro P P' Q Q' f f₀ α α' h
    have inner : (α ≫ Functor.whiskerLeft (wcEtBaseChange σ).op
          (toSheafify (Scheme.smallEtaleTopology X) Q)) ≫
        Functor.whiskerLeft (wcEtBaseChange σ).op (sheafifyMap (Scheme.smallEtaleTopology X) f) =
        f₀ ≫ (α' ≫ Functor.whiskerLeft (wcEtBaseChange σ).op
          (toSheafify (Scheme.smallEtaleTopology X) Q')) := by
      rw [Category.assoc, ← Functor.whiskerLeft_comp, ← toSheafify_naturality,
        Functor.whiskerLeft_comp, ← Category.assoc, h, Category.assoc]
    calc _ = (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
          ((α ≫ Functor.whiskerLeft (wcEtBaseChange σ).op
            (toSheafify (Scheme.smallEtaleTopology X) Q)) ≫
          Functor.whiskerLeft (wcEtBaseChange σ).op (sheafifyMap (Scheme.smallEtaleTopology X) f)) :=
          ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map_comp _ _).symm
      _ = (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
          (f₀ ≫ (α' ≫ Functor.whiskerLeft (wcEtBaseChange σ).op
            (toSheafify (Scheme.smallEtaleTopology X) Q'))) := by rw [inner]
      _ = _ := (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map_comp _ _

  have hη : σ (genericPoint X) = genericPoint X := by
    have h1 := (genericPoint_spec X).image σ.continuous
    rw [Set.image_univ_of_surjective σ.surjective, closure_univ] at h1
    exact h1.eq (genericPoint_spec X)
  have hsp : σ (genericPoint X) ⤳ genericPoint X := by rw [hη]
  obtain ⟨φ, hφ⟩ : ∃ φ : Spec (X.presheaf.stalk (genericPoint X)) ⟶
      Spec (X.presheaf.stalk (genericPoint X)),
      φ ≫ X.fromSpecStalk (genericPoint X) = X.fromSpecStalk (genericPoint X) ≫ σ :=
    ⟨Spec.map (σ.stalkMap (genericPoint X)) ≫ Spec.map (X.presheaf.stalkSpecializes hsp), by
      rw [Category.assoc, Scheme.SpecMap_stalkSpecializes_fromSpecStalk,
        Scheme.SpecMap_stalkMap_fromSpecStalk]⟩

  obtain ⟨Ψ, hΨfst, hΨsnd⟩ : ∃ Ψ : ∀ V : X.Etale,
      Limits.pullback ((wcEtBaseChange σ).obj V).hom (X.fromSpecStalk (genericPoint X)) ⟶
        Limits.pullback V.hom (X.fromSpecStalk (genericPoint X)),
      (∀ V, Ψ V ≫ Limits.pullback.fst V.hom (X.fromSpecStalk (genericPoint X)) =
        Limits.pullback.fst ((wcEtBaseChange σ).obj V).hom (X.fromSpecStalk (genericPoint X)) ≫
          Limits.pullback.fst V.hom σ) ∧
      (∀ V, Ψ V ≫ Limits.pullback.snd V.hom (X.fromSpecStalk (genericPoint X)) =
        Limits.pullback.snd ((wcEtBaseChange σ).obj V).hom (X.fromSpecStalk (genericPoint X)) ≫ φ) :=
    ⟨fun V => Limits.pullback.map _ _ _ _ (Limits.pullback.fst V.hom σ) φ σ
        (Limits.pullback.condition (f := V.hom) (g := σ)).symm hφ.symm,
      fun V => Limits.pullback.lift_fst _ _ _, fun V => Limits.pullback.lift_snd _ _ _⟩


  have gen : ∀ {A A' B B' : Scheme.{u}} (a : A ⟶ X) (a' : A' ⟶ X) (b : B ⟶ X) (b' : B' ⟶ X)
      (Ψ₁ : Limits.pullback b (X.fromSpecStalk (genericPoint X)) ⟶
        Limits.pullback a (X.fromSpecStalk (genericPoint X)))
      (Ψ₂ : Limits.pullback b' (X.fromSpecStalk (genericPoint X)) ⟶
        Limits.pullback a' (X.fromSpecStalk (genericPoint X)))
      (L : Limits.pullback a' (X.fromSpecStalk (genericPoint X)) ⟶
        Limits.pullback a (X.fromSpecStalk (genericPoint X)))
      (L' : Limits.pullback b' (X.fromSpecStalk (genericPoint X)) ⟶
        Limits.pullback b (X.fromSpecStalk (genericPoint X)))
      (kA : A' ⟶ A) (kB : B' ⟶ B) (p : B ⟶ A) (p' : B' ⟶ A'),
      L ≫ Limits.pullback.fst a (X.fromSpecStalk (genericPoint X)) =
        Limits.pullback.fst a' (X.fromSpecStalk (genericPoint X)) ≫ kA →
      L ≫ Limits.pullback.snd a (X.fromSpecStalk (genericPoint X)) =
        Limits.pullback.snd a' (X.fromSpecStalk (genericPoint X)) →
      L' ≫ Limits.pullback.fst b (X.fromSpecStalk (genericPoint X)) =
        Limits.pullback.fst b' (X.fromSpecStalk (genericPoint X)) ≫ kB →
      L' ≫ Limits.pullback.snd b (X.fromSpecStalk (genericPoint X)) =
        Limits.pullback.snd b' (X.fromSpecStalk (genericPoint X)) →
      Ψ₁ ≫ Limits.pullback.fst a (X.fromSpecStalk (genericPoint X)) =
        Limits.pullback.fst b (X.fromSpecStalk (genericPoint X)) ≫ p →
      Ψ₂ ≫ Limits.pullback.fst a' (X.fromSpecStalk (genericPoint X)) =
        Limits.pullback.fst b' (X.fromSpecStalk (genericPoint X)) ≫ p' →
      Ψ₁ ≫ Limits.pullback.snd a (X.fromSpecStalk (genericPoint X)) =
        Limits.pullback.snd b (X.fromSpecStalk (genericPoint X)) ≫ φ →
      Ψ₂ ≫ Limits.pullback.snd a' (X.fromSpecStalk (genericPoint X)) =
        Limits.pullback.snd b' (X.fromSpecStalk (genericPoint X)) ≫ φ →
      kB ≫ p = p' ≫ kA → Ψ₂ ≫ L = L' ≫ Ψ₁ := by
    intro A A' B B' a a' b b' Ψ₁ Ψ₂ L L' kA kB p p' hL1 hL2 hL'1 hL'2 h11 h21 h12 h22 hsq
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc, hL1, reassoc_of% h21, h11, reassoc_of% hL'1, hsq]
    · simp only [Category.assoc, hL2, h22, h12, reassoc_of% hL'2]
  have hLov : ∀ {A B : Over X} (k : A ⟶ B),
      ((Over.pullback (X.fromSpecStalk (genericPoint X))).map k).left ≫
          Limits.pullback.fst B.hom (X.fromSpecStalk (genericPoint X)) =
        Limits.pullback.fst A.hom (X.fromSpecStalk (genericPoint X)) ≫ k.left ∧
      ((Over.pullback (X.fromSpecStalk (genericPoint X))).map k).left ≫
          Limits.pullback.snd B.hom (X.fromSpecStalk (genericPoint X)) =
        Limits.pullback.snd A.hom (X.fromSpecStalk (genericPoint X)) := by
    intro A B k
    refine ⟨?_, ?_⟩
    · first
        | exact (eq_whisker (Over.pullback_map_left (X.fromSpecStalk (genericPoint X)) A (k := k))
            _).trans (Limits.pullback.lift_fst _ _ _)
        | (simp only [Over.pullback_map_left]; exact Limits.pullback.lift_fst _ _ _)
        | (simp only [Over.pullback_map_left]; erw [Limits.pullback.lift_fst])
    · first
        | exact (eq_whisker (Over.pullback_map_left (X.fromSpecStalk (genericPoint X)) A (k := k))
            _).trans (Limits.pullback.lift_snd _ _ _)
        | (simp only [Over.pullback_map_left]; exact Limits.pullback.lift_snd _ _ _)
        | (simp only [Over.pullback_map_left]; erw [Limits.pullback.lift_snd])
  have hnat : ∀ {V V' : X.Etale} (k : V' ⟶ V),
      Ψ V' ≫ ((Over.pullback (X.fromSpecStalk (genericPoint X))).map
        ((Scheme.Etale.forget X).map k)).left =
      ((Over.pullback (X.fromSpecStalk (genericPoint X))).map
        ((Scheme.Etale.forget X).map ((wcEtBaseChange σ).map k))).left ≫ Ψ V := by
    intro V V' k
    have hB : ((wcEtBaseChange σ).map k).left ≫ Limits.pullback.fst V.hom σ =
        Limits.pullback.fst V'.hom σ ≫ k.left := (wcEtBaseChangeFst σ).naturality k
    exact gen V.hom V'.hom ((wcEtBaseChange σ).obj V).hom ((wcEtBaseChange σ).obj V').hom
      (Ψ V) (Ψ V') _ _ k.left ((wcEtBaseChange σ).map k).left
      (Limits.pullback.fst V.hom σ) (Limits.pullback.fst V'.hom σ)
      (hLov ((Scheme.Etale.forget X).map k)).1 (hLov ((Scheme.Etale.forget X).map k)).2
      (hLov ((Scheme.Etale.forget X).map ((wcEtBaseChange σ).map k))).1
      (hLov ((Scheme.Etale.forget X).map ((wcEtBaseChange σ).map k))).2
      (hΨfst V) (hΨfst V') (hΨsnd V) (hΨsnd V') hB
  let Uₘ : Scheme.{u}ᵒᵖ ⥤ AddCommGrpCat.{u+1} := Scheme.Γ ⋙ forget₂ CommRingCat CommMonCat ⋙
    CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}
  have keyU : ∀ {A B C D : Scheme.{u}} (f : B ⟶ A) (g : C ⟶ B) (h : D ⟶ A) (k : C ⟶ D),
      g ≫ f = k ≫ h → Uₘ.map f.op ≫ Uₘ.map g.op = Uₘ.map h.op ≫ Uₘ.map k.op := by
    intro A B C D f g h k hyp
    rw [← Uₘ.map_comp, ← Uₘ.map_comp, ← op_comp, ← op_comp, hyp]
  let β : wcEtGmAtPre X (genericPoint X) ⟶
      (wcEtBaseChange σ).op ⋙ wcEtGmAtPre X (genericPoint X) :=
    { app := fun V => Uₘ.map (Ψ V.unop).op
      naturality := fun V V' k => keyU _ _ _ _ (hnat k.unop) }
  have hGm : Functor.whiskerRight (NatTrans.op (wcEtBaseChangeFst σ)) Uₘ ≫
      Functor.whiskerLeft (wcEtBaseChange σ).op (wcEtGmToAtPre X (genericPoint X)) =
      wcEtGmToAtPre X (genericPoint X) ≫ β := by
    apply NatTrans.ext
    funext V
    have e1 : (Functor.whiskerRight (NatTrans.op (wcEtBaseChangeFst σ)) Uₘ ≫
        Functor.whiskerLeft (wcEtBaseChange σ).op (wcEtGmToAtPre X (genericPoint X))).app V =
        Uₘ.map (Limits.pullback.fst V.unop.hom σ).op ≫
          Uₘ.map (Limits.pullback.fst ((wcEtBaseChange σ).obj V.unop).hom
            (X.fromSpecStalk (genericPoint X))).op := rfl
    have e2 : (wcEtGmToAtPre X (genericPoint X) ≫ β).app V =
        Uₘ.map (Limits.pullback.fst V.unop.hom (X.fromSpecStalk (genericPoint X))).op ≫
          Uₘ.map (Ψ V.unop).op := rfl
    exact e1.trans ((keyU _ _ _ _ (hΨfst V.unop).symm).trans e2.symm)

  obtain ⟨α₀, hα₀⟩ := wc_et_div_pull_exists Ω X fX σ ρ hρ
  have hex : ∃ α, wcEtDivPullProp Ω X fX σ ρ α := ⟨α₀, hα₀⟩
  have hc₃ : wcEtCanDiv Ω X fX σ ρ =
      (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
        (Classical.choose hex ≫ Functor.whiskerLeft (wcEtBaseChange σ).op
          (toSheafify (Scheme.smallEtaleTopology X) (wcEtDivPre Ω X fX))) := by
    unfold wcEtCanDiv
    rw [dif_pos hex]
  have keyPt : ∀ {A : Scheme.{u}} (a : A ⟶ X) (tt : Spec (.of Ω) ⟶ Limits.pullback a σ),
      tt ≫ Limits.pullback.snd a σ ≫ fX = 𝟙 _ →
      (inv ρ ≫ tt ≫ Limits.pullback.fst a σ) ≫ a ≫ fX = 𝟙 _ := by
    intro A a tt h
    simp only [Category.assoc]
    rw [Limits.pullback.condition_assoc, hρ, reassoc_of% h, IsIso.inv_hom_id]
  have keyAp : ∀ {A B : Scheme.{u}} (f : Spec (.of Ω) ⟶ A) (g : A ⟶ B) (x : Spec (.of Ω)),
      (inv ρ ≫ f ≫ g) x = g (f x) := by
    intro A B f g x
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, Subsingleton.elim ((inv ρ) x) x]

  have H : β ≫ Functor.whiskerLeft (wcEtBaseChange σ).op ord = ord ≫ Classical.choose hex := by
    apply NatTrans.ext
    funext V
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro a
    let b : (Γ(wcGenPt X V.unop, ⊤))ˣ :=
      Additive.toMul (ULift.down (a : ULift.{u+1} (Additive (Γ(wcGenPt X V.unop, ⊤))ˣ)))
    let b' : (Γ(wcGenPt X ((wcEtBaseChange σ).obj V.unop), ⊤))ˣ :=
      Units.map (Ψ V.unop).appTop.hom.toMonoidHom b
    refine ULift.ext _ _ (Subtype.ext (funext fun t => ?_))
    have ht2 : t.1 ≫ Limits.pullback.snd V.unop.hom σ ≫ fX = 𝟙 _ := t.2
    let s : wcEtPts Ω X fX V.unop := ⟨inv ρ ≫ t.1 ≫ Limits.pullback.fst V.unop.hom σ,
      keyPt V.unop.hom t.1 ht2⟩
    have hpt : s.1 (IsLocalRing.closedPoint Ω) =
        Limits.pullback.fst V.unop.hom σ (t.1 (IsLocalRing.closedPoint Ω)) :=
      keyAp t.1 (Limits.pullback.fst V.unop.hom σ) (IsLocalRing.closedPoint Ω)
    obtain ⟨n, hn⟩ := wc_ord_rep_exists X V.unop b (s.1 (IsLocalRing.closedPoint Ω))
    have hR : (ULift.down ((Classical.choose hex).app V (ord.app V a))).1 t = n := by
      rw [Classical.choose_spec hex V.unop (ord.app V a) t s rfl]
      exact hchar V.unop b s n hn
    rw [hpt] at hn
    have hn' := @wc_ord_rep_transport_iso X _ V.unop ((wcEtBaseChange σ).obj V.unop)
      (Limits.pullback.fst V.unop.hom σ) (Limits.pullback_fst_iso_of_right_iso _ _) (Ψ V.unop)
      (hΨfst V.unop) _ _ n hn
    have hL : (ULift.down (ord.app (Opposite.op ((wcEtBaseChange σ).obj V.unop))
        (ULift.up (Additive.ofMul b')))).1 t = n := hchar _ b' t n hn'
    exact hL.trans hR.symm

  have sq1 := s1 (wcEtGmToAtPre X (genericPoint X)) (wcEtGmToAtPre X (genericPoint X))
    (Functor.whiskerRight (NatTrans.op (wcEtBaseChangeFst σ)) Uₘ) β hGm
  have sq2 := s1 ord ord β (Classical.choose hex) H
  rw [← hc₃] at sq2
  exact ⟨(presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
    (β ≫ Functor.whiskerLeft (wcEtBaseChange σ).op
      (toSheafify (Scheme.smallEtaleTopology X) (wcEtGmAtPre X (genericPoint X)))), sq1, sq2⟩

theorem wc_et_can_div_iso : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) (σ : X ⟶ X) [IsIso σ] (ρ : Spec (.of Ω) ⟶ Spec (.of Ω)) [IsIso ρ], σ ≫ fX = fX ≫ ρ → IsIso (wcEtCanDiv Ω X fX σ ρ) :=
by
  intro Ω _ _ X fX σ _ ρ _ hρ
  classical

  have memeq : ∀ {α : Type u} {a b : α} {S : Set α}, a = b → b ∈ S → a ∈ S :=
    fun h hb => h ▸ hb
  have hpt : ∀ (f : Spec (.of Ω) ⟶ Spec (.of Ω)) (x : ↥(Spec (.of Ω))), f x = x :=
    fun _ _ => Subsingleton.elim _ _
  have hσinj : Function.Injective ⇑σ := by
    intro a b h
    exact (Scheme.hom_inv_apply (asIso σ) a).symm.trans
      ((congrArg (fun z => (asIso σ).inv z) h).trans (Scheme.hom_inv_apply (asIso σ) b))
  have k1 : ∀ V : X.Etale,
      inv (Limits.pullback.fst V.hom σ) ≫ Limits.pullback.snd V.hom σ ≫ σ = V.hom := by
    intro V
    rw [← Limits.pullback.condition, IsIso.inv_hom_id_assoc]

  have hP1 : ∀ (V : X.Etale) (u : Spec (.of Ω) ⟶ Limits.pullback V.hom σ),
      u ≫ Limits.pullback.snd V.hom σ ≫ fX = 𝟙 _ →
      (inv ρ ≫ u ≫ Limits.pullback.fst V.hom σ) ≫ V.hom ≫ fX = 𝟙 _ := by
    intro V u hu
    calc (inv ρ ≫ u ≫ Limits.pullback.fst V.hom σ) ≫ V.hom ≫ fX
        = inv ρ ≫ (u ≫ Limits.pullback.snd V.hom σ ≫ fX) ≫ ρ := by
          simp only [Category.assoc, Limits.pullback.condition_assoc, hρ]
      _ = 𝟙 _ := by rw [hu, Category.id_comp, IsIso.inv_hom_id]
  have hP2 : ∀ (V : X.Etale) (s : Spec (.of Ω) ⟶ V.left), s ≫ V.hom ≫ fX = 𝟙 _ →
      (ρ ≫ s ≫ inv (Limits.pullback.fst V.hom σ)) ≫ Limits.pullback.snd V.hom σ ≫ fX = 𝟙 _ := by
    intro V s hs
    have k2 : inv (Limits.pullback.fst V.hom σ) ≫ Limits.pullback.snd V.hom σ ≫ fX ≫ ρ =
        V.hom ≫ fX := by
      calc inv (Limits.pullback.fst V.hom σ) ≫ Limits.pullback.snd V.hom σ ≫ fX ≫ ρ
          = (inv (Limits.pullback.fst V.hom σ) ≫ Limits.pullback.snd V.hom σ ≫ σ) ≫ fX := by
            simp only [Category.assoc, ← hρ]
        _ = V.hom ≫ fX := by rw [k1 V]
    apply (cancel_mono ρ).mp
    calc ((ρ ≫ s ≫ inv (Limits.pullback.fst V.hom σ)) ≫ Limits.pullback.snd V.hom σ ≫ fX) ≫ ρ
        = ρ ≫ s ≫ (inv (Limits.pullback.fst V.hom σ) ≫ Limits.pullback.snd V.hom σ ≫ fX ≫ ρ) := by
          simp only [Category.assoc]
      _ = ρ ≫ (s ≫ V.hom ≫ fX) := by rw [k2]
      _ = 𝟙 _ ≫ ρ := by rw [hs, Category.comp_id, Category.id_comp]

  have hst : ∀ (V : X.Etale) (u : Spec (.of Ω) ⟶ Limits.pullback V.hom σ),
      ρ ≫ (inv ρ ≫ u ≫ Limits.pullback.fst V.hom σ) ≫ inv (Limits.pullback.fst V.hom σ) = u := by
    intro V u
    simp only [Category.assoc, IsIso.hom_inv_id, Category.comp_id, IsIso.hom_inv_id_assoc]
  have hts : ∀ (V : X.Etale) (s : Spec (.of Ω) ⟶ V.left),
      inv ρ ≫ (ρ ≫ s ≫ inv (Limits.pullback.fst V.hom σ)) ≫ Limits.pullback.fst V.hom σ = s := by
    intro V s
    simp only [Category.assoc, IsIso.inv_hom_id, Category.comp_id, IsIso.inv_hom_id_assoc]

  have E1 : ∀ (V : X.Etale) (u : Spec (.of Ω) ⟶ Limits.pullback V.hom σ),
      (inv ρ ≫ u ≫ Limits.pullback.fst V.hom σ) (IsLocalRing.closedPoint Ω) =
        Limits.pullback.fst V.hom σ (u (IsLocalRing.closedPoint Ω)) := by
    intro V u
    exact (Scheme.Hom.comp_apply (inv ρ) (u ≫ Limits.pullback.fst V.hom σ) _).trans
      ((Scheme.Hom.comp_apply u (Limits.pullback.fst V.hom σ) _).trans
        (congrArg (fun z => Limits.pullback.fst V.hom σ (u z)) (hpt (inv ρ) _)))
  have E2 : ∀ (V : X.Etale) (u : Spec (.of Ω) ⟶ Limits.pullback V.hom σ),
      ((inv ρ ≫ u ≫ Limits.pullback.fst V.hom σ) ≫ V.hom) (IsLocalRing.closedPoint Ω) =
        σ ((u ≫ Limits.pullback.snd V.hom σ) (IsLocalRing.closedPoint Ω)) := by
    intro V u
    have e : (inv ρ ≫ u ≫ Limits.pullback.fst V.hom σ) ≫ V.hom =
        inv ρ ≫ (u ≫ Limits.pullback.snd V.hom σ) ≫ σ := by
      simp only [Category.assoc, Limits.pullback.condition]
    exact (congrArg (fun k : Spec (.of Ω) ⟶ X => k (IsLocalRing.closedPoint Ω)) e).trans
      ((Scheme.Hom.comp_apply (inv ρ) ((u ≫ Limits.pullback.snd V.hom σ) ≫ σ) _).trans
        ((Scheme.Hom.comp_apply (u ≫ Limits.pullback.snd V.hom σ) σ _).trans
          (congrArg (fun z => σ ((u ≫ Limits.pullback.snd V.hom σ) z)) (hpt (inv ρ) _))))
  have E3 : ∀ (V : X.Etale) (s : Spec (.of Ω) ⟶ V.left),
      (ρ ≫ s ≫ inv (Limits.pullback.fst V.hom σ)) (IsLocalRing.closedPoint Ω) =
        inv (Limits.pullback.fst V.hom σ) (s (IsLocalRing.closedPoint Ω)) := by
    intro V s
    exact (Scheme.Hom.comp_apply ρ (s ≫ inv (Limits.pullback.fst V.hom σ)) _).trans
      ((Scheme.Hom.comp_apply s (inv (Limits.pullback.fst V.hom σ)) _).trans
        (congrArg (fun z => inv (Limits.pullback.fst V.hom σ) (s z)) (hpt ρ _)))
  have E4 : ∀ (V : X.Etale) (s : Spec (.of Ω) ⟶ V.left),
      σ (((ρ ≫ s ≫ inv (Limits.pullback.fst V.hom σ)) ≫ Limits.pullback.snd V.hom σ)
        (IsLocalRing.closedPoint Ω)) = (s ≫ V.hom) (IsLocalRing.closedPoint Ω) := by
    intro V s
    have e : ((ρ ≫ s ≫ inv (Limits.pullback.fst V.hom σ)) ≫ Limits.pullback.snd V.hom σ) ≫ σ =
        ρ ≫ s ≫ V.hom := by
      simp only [Category.assoc, k1 V]
    exact (Scheme.Hom.comp_apply
        ((ρ ≫ s ≫ inv (Limits.pullback.fst V.hom σ)) ≫ Limits.pullback.snd V.hom σ) σ _).symm.trans
      ((congrArg (fun k : Spec (.of Ω) ⟶ X => k (IsLocalRing.closedPoint Ω)) e).trans
        ((Scheme.Hom.comp_apply ρ (s ≫ V.hom) _).trans
          (congrArg (fun z => (s ≫ V.hom) z) (hpt ρ _))))
  have hlf : ∀ {V V' : X.Etale} (c : V' ⟶ V),
      ((wcEtBaseChange σ).map c).left ≫ Limits.pullback.fst V.hom σ =
        Limits.pullback.fst V'.hom σ ≫ c.left := by
    intro V V' c
    first
      | exact (wcEtBaseChangeFst σ).naturality c
      | exact Limits.pullback.lift_fst _ _ _
      | simp [wcEtBaseChange]

  let sOf : ∀ V : X.Etale, wcEtPts Ω X fX ((wcEtBaseChange σ).obj V) → wcEtPts Ω X fX V :=
    fun V t => ⟨inv ρ ≫ t.1 ≫ Limits.pullback.fst V.hom σ, hP1 V t.1 t.2⟩
  let tPt : ∀ V : X.Etale, (Spec (.of Ω) ⟶ V.left) → (Spec (.of Ω) ⟶ Limits.pullback V.hom σ) :=
    fun V s => ρ ≫ s ≫ inv (Limits.pullback.fst V.hom σ)
  let tOf : ∀ V : X.Etale, wcEtPts Ω X fX V → wcEtPts Ω X fX ((wcEtBaseChange σ).obj V) :=
    fun V s => ⟨tPt V s.1, hP2 V s.1 s.2⟩

  have memPull : ∀ (V : X.Etale) (a : wcEtDivSub Ω X fX V),
      (fun t => a.1 (sOf V t)) ∈ wcEtDivSub Ω X fX ((wcEtBaseChange σ).obj V) := by
    intro V a y
    obtain ⟨W₀, hW₀, hy, T₀, hT₀, h₀⟩ := a.2 (Limits.pullback.fst V.hom σ y)
    refine ⟨(Limits.pullback.fst V.hom σ) ⁻¹' W₀, hW₀.preimage (Scheme.Hom.continuous _), hy,
      σ ⁻¹' T₀, Set.Finite.preimage hσinj.injOn hT₀, fun t ht htW => ?_⟩
    have h1 := h₀ (sOf V t) ht (memeq (S := W₀) (E1 V t.1) htW)
    exact memeq (S := T₀) (E2 V t.1).symm h1
  have memPush : ∀ (V : X.Etale) (b : wcEtDivSub Ω X fX ((wcEtBaseChange σ).obj V)),
      (fun s => b.1 (tOf V s)) ∈ wcEtDivSub Ω X fX V := by
    intro V b x
    obtain ⟨W', hW', hx', T', hT', h'⟩ := b.2 (inv (Limits.pullback.fst V.hom σ) x)
    refine ⟨(inv (Limits.pullback.fst V.hom σ)) ⁻¹' W', hW'.preimage (Scheme.Hom.continuous _),
      hx', σ '' T', hT'.image σ, fun s hs hsW => ?_⟩
    have h1 := h' (tOf V s) hs (memeq (S := W') (E3 V s.1) hsW)
    exact ⟨_, h1, E4 V s.1⟩

  let αapp : ∀ V : (X.Etale)ᵒᵖ, (wcEtDivPre Ω X fX).obj V ⟶
      ((wcEtBaseChange σ).op ⋙ wcEtDivPre Ω X fX).obj V := fun V =>
    AddCommGrpCat.ofHom (X := ULift.{u+1} (wcEtDivSub Ω X fX V.unop))
      (Y := ULift.{u+1} (wcEtDivSub Ω X fX ((wcEtBaseChange σ).obj V.unop)))
      { toFun := fun a => ULift.up ⟨fun t => a.down.1 (sOf V.unop t), memPull V.unop a.down⟩
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
  let α : wcEtDivPre Ω X fX ⟶ (wcEtBaseChange σ).op ⋙ wcEtDivPre Ω X fX :=
    { app := αapp
      naturality := by
        intro V V' g
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        intro a
        apply ULift.ext
        apply Subtype.ext
        funext t
        show (ULift.down a).1 _ = (ULift.down a).1 _
        refine congrArg (ULift.down a).1 (Subtype.ext ?_)
        show (inv ρ ≫ t.1 ≫ Limits.pullback.fst V'.unop.hom σ) ≫ g.unop.left =
          inv ρ ≫ (t.1 ≫ ((wcEtBaseChange σ).map g.unop).left) ≫
            Limits.pullback.fst V.unop.hom σ
        simp only [Category.assoc]
        exact congrArg (fun k => inv ρ ≫ t.1 ≫ k) (hlf g.unop).symm }
  have hαprop : wcEtDivPullProp Ω X fX σ ρ α := by
    intro V a t s hs
    show (ULift.down a).1 (sOf V t) = (ULift.down a).1 s
    exact congrArg (ULift.down a).1 (Subtype.ext hs.symm : sOf V t = s)

  have hiso : ∀ α' : wcEtDivPre Ω X fX ⟶ (wcEtBaseChange σ).op ⋙ wcEtDivPre Ω X fX,
      wcEtDivPullProp Ω X fX σ ρ α' → IsIso α' := by
    intro α' hα'
    have happ : ∀ V : (X.Etale)ᵒᵖ, IsIso (α'.app V) := by
      intro V
      obtain ⟨V⟩ := V
      apply (ConcreteCategory.isIso_iff_bijective _).mpr
      constructor
      · intro a a' h
        apply ULift.ext
        apply Subtype.ext
        funext s
        have e1 := hα' V a (tOf V s) s (hts V s.1).symm
        have e2 := hα' V a' (tOf V s) s (hts V s.1).symm
        have h' := congrArg (fun z : ((wcEtBaseChange σ).op ⋙ wcEtDivPre Ω X fX).obj
          (Opposite.op V) => (ULift.down z).1 (tOf V s)) h
        exact e1.symm.trans (h'.trans e2)
      · intro b
        let a0 : (wcEtDivPre Ω X fX).obj (Opposite.op V) :=
          ULift.up (⟨fun s => (ULift.down b).1 (tOf V s), memPush V (ULift.down b)⟩ :
            wcEtDivSub Ω X fX V)
        refine ⟨a0, ?_⟩
        apply ULift.ext
        apply Subtype.ext
        funext t
        have e := hα' V a0 t (sOf V t) rfl
        exact e.trans (congrArg (ULift.down b).1
          (Subtype.ext (hst V t.1) : tOf V (sOf V t) = t))
    exact NatIso.isIso_of_isIso_app α'

  have hSurj : ∀ (Z : Scheme.{u}) (V : Z.Etale) (R : Sieve V), R ∈ Scheme.smallEtaleTopology Z V →
      ∀ y : V.left, ∃ (V₁ : Z.Etale) (c : V₁ ⟶ V) (w : V₁.left), R.arrows c ∧ c.left w = y := by
    intro Z V R hR y
    change R ∈ Scheme.smallGrothendieckTopology @Etale Z V at hR
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Z
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
    obtain ⟨V₁, c, w, hc, -, hw⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Z
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V R).mp hR y
    exact ⟨V₁, c, w, hc, hw⟩
  have hjs : ∀ (Z : Scheme.{u}) (V : Z.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Z.Etale)
      (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Z V := by
    intro Z V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale Z V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Z
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Z
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩
  haveI hcoc : (wcEtBaseChange σ).IsCocontinuous (Scheme.smallEtaleTopology X)
      (Scheme.smallEtaleTopology X) := by
    constructor
    intro U S hS
    apply hjs
    intro u
    obtain ⟨W, f, w, hf, hw⟩ := hSurj X _ S hS (inv (Limits.pullback.fst U.hom σ) u)
    have hfw : f.left ≫ Limits.pullback.snd U.hom σ = W.hom := MorphismProperty.Over.w f
    haveI hWet : Etale W.hom := W.prop
    let V : X.Etale := MorphismProperty.Over.mk ⊤ (W.hom ≫ σ) inferInstance
    have hcw : (f.left ≫ Limits.pullback.fst U.hom σ) ≫ U.hom = V.hom :=
      (Category.assoc _ _ _).trans
        ((congrArg (fun k => f.left ≫ k) Limits.pullback.condition).trans
          ((Category.assoc _ _ _).symm.trans (congrArg (fun k => k ≫ σ) hfw)))
    let c : V ⟶ U := MorphismProperty.Over.homMk (f.left ≫ Limits.pullback.fst U.hom σ) hcw trivial
    have hφw : Limits.pullback.fst V.hom σ ≫ W.hom = Limits.pullback.snd V.hom σ :=
      (cancel_mono σ).mp ((Category.assoc _ _ _).trans Limits.pullback.condition)
    let φ : (wcEtBaseChange σ).obj V ⟶ W :=
      MorphismProperty.Over.homMk (Limits.pullback.fst V.hom σ) hφw trivial
    have h0 : (Limits.pullback.fst V.hom σ ≫ c.left) ≫ U.hom = Limits.pullback.snd V.hom σ ≫ σ :=
      (Category.assoc _ _ _).trans
        ((congrArg (fun k => Limits.pullback.fst V.hom σ ≫ k) (MorphismProperty.Over.w c)).trans
          Limits.pullback.condition)
    let m : Limits.pullback V.hom σ ⟶ Limits.pullback U.hom σ :=
      Limits.pullback.lift (Limits.pullback.fst V.hom σ ≫ c.left) (Limits.pullback.snd V.hom σ) h0
    have hm : ((wcEtBaseChange σ).map c).left = m := rfl
    have hm' : m = Limits.pullback.fst V.hom σ ≫ f.left := by
      apply Limits.pullback.hom_ext
      · exact (Limits.pullback.lift_fst _ _ _).trans (Category.assoc _ _ _).symm
      · exact (Limits.pullback.lift_snd _ _ _).trans (hφw.symm.trans
          ((congrArg (fun k => Limits.pullback.fst V.hom σ ≫ k) hfw).symm.trans
            (Category.assoc _ _ _).symm))
    have hmap : (wcEtBaseChange σ).map c = φ ≫ f :=
      MorphismProperty.Over.Hom.ext (hm.trans hm')
    refine ⟨V, c, ?_, w, ?_⟩
    · show S.arrows ((wcEtBaseChange σ).map c)
      rw [hmap]
      exact S.downward_closed hf φ
    · show (f.left ≫ Limits.pullback.fst U.hom σ) w = u
      have hu : (inv (Limits.pullback.fst U.hom σ) ≫ Limits.pullback.fst U.hom σ) u = u := by
        first
          | exact (congrArg (fun h : U.left ⟶ U.left => h u) (IsIso.inv_hom_id _)).trans rfl
          | simp
          | (rw [IsIso.inv_hom_id]; rfl)
      exact (Scheme.Hom.comp_apply _ _ w).trans
        ((congrArg (fun z => (Limits.pullback.fst U.hom σ) z) hw).trans
          ((Scheme.Hom.comp_apply _ _ u).symm.trans hu))
  have hW : ∀ (P : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}),
      IsIso ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
        (Functor.whiskerLeft (wcEtBaseChange σ).op (toSheafify (Scheme.smallEtaleTopology X) P))) := by
    intro P
    haveI := Presheaf.isLocallyInjective_toSheafify' (Scheme.smallEtaleTopology X) P
    haveI := Presheaf.isLocallySurjective_toSheafify' (Scheme.smallEtaleTopology X) P
    haveI := Presheaf.isLocallyInjective_whisker (Scheme.smallEtaleTopology X)
      (Scheme.smallEtaleTopology X) (wcEtBaseChange σ) (toSheafify (Scheme.smallEtaleTopology X) P)
    haveI := Presheaf.isLocallySurjective_whisker (Scheme.smallEtaleTopology X)
      (Scheme.smallEtaleTopology X) (wcEtBaseChange σ) (toSheafify (Scheme.smallEtaleTopology X) P)
    exact (GrothendieckTopology.W_iff (Scheme.smallEtaleTopology X) _).mp
      (GrothendieckTopology.W_of_isLocallyBijective (Scheme.smallEtaleTopology X)
        (Functor.whiskerLeft (wcEtBaseChange σ).op (toSheafify (Scheme.smallEtaleTopology X) P)))

  have hex : ∃ α₀, wcEtDivPullProp Ω X fX σ ρ α₀ := ⟨α, hαprop⟩
  have hdef : wcEtCanDiv Ω X fX σ ρ =
      (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
        (Classical.choose hex ≫ Functor.whiskerLeft (wcEtBaseChange σ).op
          (toSheafify (Scheme.smallEtaleTopology X) (wcEtDivPre Ω X fX))) := by
    first
      | (unfold wcEtCanDiv; exact dif_pos hex)
      | (rw [wcEtCanDiv, dif_pos hex])
      | simp only [wcEtCanDiv, dif_pos hex]
  rw [hdef, Functor.map_comp]
  haveI := hiso _ (Classical.choose_spec hex)
  haveI := Functor.map_isIso (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
    (Classical.choose hex)
  haveI := hW (wcEtDivPre Ω X fX)
  exact IsIso.comp_isIso

theorem wc_fet_section_fibre_unique : ∀ {A B : Scheme.{u}} (q : A ⟶ B) (σ : B ⟶ A), σ ≫ q = 𝟙 B → ∀ (Ω : Type u) [Field Ω] (y : Spec (.of Ω) ⟶ B) (x : Spec (.of Ω) ⟶ A), x ≫ q = y → x (IsLocalRing.closedPoint Ω) ∈ Set.range σ → x = y ≫ σ :=
by
  intro A B q σ hσ Ω _ y x hxy hmem
  obtain ⟨b, hb⟩ := hmem
  have hidem : (q ≫ σ) ≫ (q ≫ σ) = q ≫ σ := by
    rw [Category.assoc, ← Category.assoc σ q σ, hσ, Category.id_comp]
  have hfix : (q ≫ σ) (x (IsLocalRing.closedPoint Ω)) = x (IsLocalRing.closedPoint Ω) := by
    rw [← hb, Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply σ q b, hσ]
    rfl
  have key : ∀ (e : A ⟶ A), e ≫ e = e → ∀ a : A, e a = a →
      A.fromSpecResidueField a ≫ e = A.fromSpecResidueField a := by
    intro e he a ha
    have h : a = e a := ha.symm
    obtain ⟨ρ, hstar⟩ : ∃ ρ : A.residueField a ⟶ A.residueField a,
        A.fromSpecResidueField a ≫ e = Spec.map ρ ≫ A.fromSpecResidueField a := by
      refine ⟨(Scheme.residueFieldCongr h).hom ≫ Scheme.Hom.residueFieldMap e a, ?_⟩
      have h1 : Spec.map (Scheme.Hom.residueFieldMap e a) ≫ A.fromSpecResidueField (e a) =
          A.fromSpecResidueField a ≫ e :=
        Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField e a
      have h2 : Spec.map (Scheme.residueFieldCongr h).hom ≫ A.fromSpecResidueField a =
          A.fromSpecResidueField (e a) :=
        Scheme.residueFieldCongr_fromSpecResidueField h
      rw [← h1, ← h2, Spec.map_comp, Category.assoc]
    have hρρ : ρ ≫ ρ = ρ := by
      apply Spec.map_injective
      rw [← cancel_mono (A.fromSpecResidueField a)]
      calc Spec.map (ρ ≫ ρ) ≫ A.fromSpecResidueField a
          = Spec.map ρ ≫ (Spec.map ρ ≫ A.fromSpecResidueField a) := by
            rw [Spec.map_comp, Category.assoc]
        _ = (A.fromSpecResidueField a ≫ e) ≫ e := by
            rw [← hstar, ← Category.assoc, ← hstar]
        _ = A.fromSpecResidueField a ≫ e := by rw [Category.assoc, he]
        _ = Spec.map ρ ≫ A.fromSpecResidueField a := hstar
    have hρid : ρ = 𝟙 _ := by
      ext t
      have h2 : ρ.hom (ρ.hom t) = ρ.hom t := by
        rw [← CommRingCat.comp_apply, hρρ]
      exact ρ.hom.injective (by simpa using h2)
    rw [hstar, hρid, Spec.map_id, Category.id_comp]
  obtain ⟨φ, hφ⟩ : ∃ φ, Spec.map φ ≫ A.fromSpecResidueField (x (IsLocalRing.closedPoint Ω)) = x :=
    ⟨_, Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField _ _ _⟩
  have hxe : x ≫ (q ≫ σ) = x := by
    conv_lhs => rw [← hφ]
    rw [Category.assoc, key (q ≫ σ) hidem _ hfix, hφ]
  rw [← hxy, Category.assoc, hxe]

theorem wc_et_div_twist_hom_level : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IsIntegral X] (M : ℕ) (ord : wcEtGmAtPre X (genericPoint X) ⟶ wcEtDivPre Ω X fX) (σ : X ⟶ X) [IsIso σ] (ρ : Spec (.of Ω) ⟶ Spec (.of Ω)) [IsIso ρ], σ ≫ fX = fX ≫ ρ → (∀ s₁ s₂ : wcEtPts Ω X fX (Scheme.Etale.mk (𝟙 X)), ∃ (E : wcEtDivSub Ω X fX (Scheme.Etale.mk (𝟙 X))) (m : (wcEtGmAtPre X (genericPoint X)).obj (Opposite.op (Scheme.Etale.mk (𝟙 X)))), ∀ t : wcEtPts Ω X fX (Scheme.Etale.mk (𝟙 X)), @ite ℤ (t = s₁) (Classical.dec _) 1 0 - @ite ℤ (t = s₂) (Classical.dec _) 1 0 = (M : ℤ) * E.1 t + ((ord.app (Opposite.op (Scheme.Etale.mk (𝟙 X))) m).down).1 t) → ∀ q₀ : (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (wcEtDivPre Ω X fX), ∃ (d₀ : (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (wcEtDivPre Ω X fX)) (m₀ : (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ wcEtGmAt X (genericPoint X)), wcEtCanConst σ (AddCommGrpCat.of (ULift.{u+1} ℤ)) ≫ (wcEtPush σ).map q₀ = (q₀ + M • d₀ + m₀ ≫ (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map ord) ≫ wcEtCanDiv Ω X fX σ ρ :=
by
  intro Ω _ _ X fX _ _ M ord σ _ ρ _ hρ hpt q₀
  classical

  have memeq : ∀ {α : Type u} {a b : α} {S : Set α}, a = b → b ∈ S → a ∈ S :=
    fun h hb => h ▸ hb
  have hpt1 : ∀ (f : Spec (.of Ω) ⟶ Spec (.of Ω)) (x : ↥(Spec (.of Ω))), f x = x :=
    fun _ _ => Subsingleton.elim _ _
  have hσinj : Function.Injective ⇑σ := by
    intro a b h
    exact (Scheme.hom_inv_apply (asIso σ) a).symm.trans
      ((congrArg (fun z => (asIso σ).inv z) h).trans (Scheme.hom_inv_apply (asIso σ) b))
  have hP1 : ∀ (V : X.Etale) (u : Spec (.of Ω) ⟶ Limits.pullback V.hom σ),
      u ≫ Limits.pullback.snd V.hom σ ≫ fX = 𝟙 _ →
      (inv ρ ≫ u ≫ Limits.pullback.fst V.hom σ) ≫ V.hom ≫ fX = 𝟙 _ := by
    intro V u hu
    calc (inv ρ ≫ u ≫ Limits.pullback.fst V.hom σ) ≫ V.hom ≫ fX
        = inv ρ ≫ (u ≫ Limits.pullback.snd V.hom σ ≫ fX) ≫ ρ := by
          simp only [Category.assoc, Limits.pullback.condition_assoc, hρ]
      _ = 𝟙 _ := by rw [hu, Category.id_comp, IsIso.inv_hom_id]
  have E1 : ∀ (V : X.Etale) (u : Spec (.of Ω) ⟶ Limits.pullback V.hom σ),
      (inv ρ ≫ u ≫ Limits.pullback.fst V.hom σ) (IsLocalRing.closedPoint Ω) =
        Limits.pullback.fst V.hom σ (u (IsLocalRing.closedPoint Ω)) := by
    intro V u
    exact (Scheme.Hom.comp_apply (inv ρ) (u ≫ Limits.pullback.fst V.hom σ) _).trans
      ((Scheme.Hom.comp_apply u (Limits.pullback.fst V.hom σ) _).trans
        (congrArg (fun z => Limits.pullback.fst V.hom σ (u z)) (hpt1 (inv ρ) _)))
  have E2 : ∀ (V : X.Etale) (u : Spec (.of Ω) ⟶ Limits.pullback V.hom σ),
      ((inv ρ ≫ u ≫ Limits.pullback.fst V.hom σ) ≫ V.hom) (IsLocalRing.closedPoint Ω) =
        σ ((u ≫ Limits.pullback.snd V.hom σ) (IsLocalRing.closedPoint Ω)) := by
    intro V u
    have e : (inv ρ ≫ u ≫ Limits.pullback.fst V.hom σ) ≫ V.hom =
        inv ρ ≫ (u ≫ Limits.pullback.snd V.hom σ) ≫ σ := by
      simp only [Category.assoc, Limits.pullback.condition]
    exact (congrArg (fun k : Spec (.of Ω) ⟶ X => k (IsLocalRing.closedPoint Ω)) e).trans
      ((Scheme.Hom.comp_apply (inv ρ) ((u ≫ Limits.pullback.snd V.hom σ) ≫ σ) _).trans
        ((Scheme.Hom.comp_apply (u ≫ Limits.pullback.snd V.hom σ) σ _).trans
          (congrArg (fun z => σ ((u ≫ Limits.pullback.snd V.hom σ) z)) (hpt1 (inv ρ) _))))
  have hlf : ∀ {V V' : X.Etale} (c : V' ⟶ V),
      ((wcEtBaseChange σ).map c).left ≫ Limits.pullback.fst V.hom σ =
        Limits.pullback.fst V'.hom σ ≫ c.left := by
    intro V V' c
    first
      | exact (wcEtBaseChangeFst σ).naturality c
      | exact Limits.pullback.lift_fst _ _ _
      | simp [wcEtBaseChange]
  let sOf : ∀ V : X.Etale, wcEtPts Ω X fX ((wcEtBaseChange σ).obj V) → wcEtPts Ω X fX V :=
    fun V t => ⟨inv ρ ≫ t.1 ≫ Limits.pullback.fst V.hom σ, hP1 V t.1 t.2⟩
  have memPull : ∀ (V : X.Etale) (a : wcEtDivSub Ω X fX V),
      (fun t => a.1 (sOf V t)) ∈ wcEtDivSub Ω X fX ((wcEtBaseChange σ).obj V) := by
    intro V a y
    obtain ⟨W₀, hW₀, hy, T₀, hT₀, h₀⟩ := a.2 (Limits.pullback.fst V.hom σ y)
    refine ⟨(Limits.pullback.fst V.hom σ) ⁻¹' W₀, hW₀.preimage (Scheme.Hom.continuous _), hy,
      σ ⁻¹' T₀, Set.Finite.preimage hσinj.injOn hT₀, fun t ht htW => ?_⟩
    have h1 := h₀ (sOf V t) ht (memeq (S := W₀) (E1 V t.1) htW)
    exact memeq (S := T₀) (E2 V t.1).symm h1
  let αapp : ∀ V : (X.Etale)ᵒᵖ, (wcEtDivPre Ω X fX).obj V ⟶
      ((wcEtBaseChange σ).op ⋙ wcEtDivPre Ω X fX).obj V := fun V =>
    AddCommGrpCat.ofHom (X := ULift.{u+1} (wcEtDivSub Ω X fX V.unop))
      (Y := ULift.{u+1} (wcEtDivSub Ω X fX ((wcEtBaseChange σ).obj V.unop)))
      { toFun := fun a => ULift.up ⟨fun t => a.down.1 (sOf V.unop t), memPull V.unop a.down⟩
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
  let α : wcEtDivPre Ω X fX ⟶ (wcEtBaseChange σ).op ⋙ wcEtDivPre Ω X fX :=
    { app := αapp
      naturality := by
        intro V V' g
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        intro a
        apply ULift.ext
        apply Subtype.ext
        funext t
        show (ULift.down a).1 _ = (ULift.down a).1 _
        refine congrArg (ULift.down a).1 (Subtype.ext ?_)
        show (inv ρ ≫ t.1 ≫ Limits.pullback.fst V'.unop.hom σ) ≫ g.unop.left =
          inv ρ ≫ (t.1 ≫ ((wcEtBaseChange σ).map g.unop).left) ≫
            Limits.pullback.fst V.unop.hom σ
        simp only [Category.assoc]
        exact congrArg (fun k => inv ρ ≫ t.1 ≫ k) (hlf g.unop).symm }
  have hαprop : wcEtDivPullProp Ω X fX σ ρ α := by
    intro V a t s hs
    show (ULift.down a).1 (sOf V t) = (ULift.down a).1 s
    exact congrArg (ULift.down a).1 (Subtype.ext hs.symm : sOf V t = s)
  have hex : ∃ α₀, wcEtDivPullProp Ω X fX σ ρ α₀ := ⟨α, hαprop⟩
  have hdef : wcEtCanDiv Ω X fX σ ρ =
      (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
        (Classical.choose hex ≫ Functor.whiskerLeft (wcEtBaseChange σ).op
          (toSheafify (Scheme.smallEtaleTopology X) (wcEtDivPre Ω X fX))) := by
    first
      | (unfold wcEtCanDiv; exact dif_pos hex)
      | (rw [wcEtCanDiv, dif_pos hex])
      | simp only [wcEtCanDiv, dif_pos hex]
  have hα₀ := Classical.choose_spec hex

  obtain ⟨φ₀, rfl⟩ : ∃ φ₀ : (Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶
      wcEtDivPre Ω X fX,
      q₀ = (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map φ₀ := by
    haveI := isIso_toSheafify (Scheme.smallEtaleTopology X) (wc_et_div_isSheaf Ω X fX)
    refine ⟨toSheafify (Scheme.smallEtaleTopology X)
        ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ≫ q₀.hom ≫
        inv (toSheafify (Scheme.smallEtaleTopology X) (wcEtDivPre Ω X fX)), ?_⟩
    apply Sheaf.hom_ext
    refine sheafify_hom_ext (Scheme.smallEtaleTopology X)
      (P := (Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) _ _
      ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (wcEtDivPre Ω X fX)).property ?_
    change _ = toSheafify (Scheme.smallEtaleTopology X) _ ≫
      sheafifyMap (Scheme.smallEtaleTopology X) _
    rw [← toSheafify_naturality]
    first
      | (rw [Category.assoc, Category.assoc, IsIso.inv_hom_id, Category.comp_id])
      | (erw [Category.assoc, Category.assoc, IsIso.inv_hom_id, Category.comp_id])
      | simp

  let r : ∀ V : X.Etale, V ⟶ Scheme.Etale.mk (𝟙 X) := fun V => MorphismProperty.Over.homMk V.hom
  have hr : ∀ {V : X.Etale} (g : V ⟶ Scheme.Etale.mk (𝟙 X)), g = r V := fun g =>
    MorphismProperty.Over.Hom.ext ((Category.comp_id g.left).symm.trans (MorphismProperty.Over.w g))
  have hkey : ∀ (Q : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1})
      (ψ : (Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ Q) (U : X.Etale)
      (n : ℤ), ψ.app (Opposite.op U) (ULift.up n) =
        n • Q.map (r U).op (ψ.app (Opposite.op (Scheme.Etale.mk (𝟙 X))) (ULift.up 1)) := by
    intro Q ψ U n
    have h2 := ConcreteCategory.congr_hom (ψ.naturality (r U).op) (ULift.up n)
    rw [CategoryTheory.comp_apply, CategoryTheory.comp_apply] at h2
    have e2 : ψ.app (Opposite.op (Scheme.Etale.mk (𝟙 X))) (ULift.up n) =
        n • ψ.app (Opposite.op (Scheme.Etale.mk (𝟙 X))) (ULift.up 1) := by
      have e1 : (ULift.up n : ULift.{u+1} ℤ) = n • (ULift.up 1 : ULift.{u+1} ℤ) := by
        apply ULift.ext; simp
      rw [e1, map_zsmul]
    refine h2.trans ?_
    rw [e2, map_zsmul]
  have huniq : ∀ (Q : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1})
      (ψ₁ ψ₂ : (Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ Q),
      ψ₁.app (Opposite.op (Scheme.Etale.mk (𝟙 X))) (ULift.up 1) =
        ψ₂.app (Opposite.op (Scheme.Etale.mk (𝟙 X))) (ULift.up 1) → ψ₁ = ψ₂ := by
    intro Q ψ₁ ψ₂ h
    apply NatTrans.ext
    funext U
    obtain ⟨U⟩ := U
    apply ConcreteCategory.hom_ext
    intro x
    obtain ⟨n⟩ := x
    rw [hkey Q ψ₁ U n, hkey Q ψ₂ U n, h]
  have hexist : ∀ (Q : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1})
      (x : Q.obj (Opposite.op (Scheme.Etale.mk (𝟙 X)))),
      ∃ ψ : (Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ Q,
        ψ.app (Opposite.op (Scheme.Etale.mk (𝟙 X))) (ULift.up 1) = x := by
    intro Q x
    refine ⟨{ app := fun U => AddCommGrpCat.ofHom ((zmultiplesHom _ (Q.map (r U.unop).op x)).comp
        (AddEquiv.ulift : ULift.{u+1} ℤ ≃+ ℤ).toAddMonoidHom), naturality := ?_ }, ?_⟩
    · intro U V f
      have hrr : (r U.unop).op ≫ f = (r V.unop).op := by
        change (f.unop ≫ r U.unop).op = (r V.unop).op
        rw [hr (f.unop ≫ r U.unop)]
      apply ConcreteCategory.hom_ext
      intro y
      rw [CategoryTheory.comp_apply, CategoryTheory.comp_apply]
      change (ULift.down y) • Q.map (r V.unop).op x =
        Q.map f ((ULift.down y) • Q.map (r U.unop).op x)
      rw [map_zsmul, ← CategoryTheory.comp_apply, ← Functor.map_comp, hrr]
    · change (1 : ℤ) • Q.map (r (Scheme.Etale.mk (𝟙 X))).op x = x
      rw [← hr (𝟙 (Scheme.Etale.mk (𝟙 X))), op_id, Q.map_id, one_smul, CategoryTheory.id_apply]

  have hsecI : ∀ f : Spec (.of Ω) ⟶ X, f ≫ (Scheme.Etale.mk (𝟙 X)).hom ≫ fX = 𝟙 _ →
      f ≫ fX = 𝟙 _ := fun f h =>
    (congrArg (fun k => f ≫ k) (Category.id_comp fX)).symm.trans h
  have hsecO : ∀ f : Spec (.of Ω) ⟶ X, f ≫ fX = 𝟙 _ →
      f ≫ (Scheme.Etale.mk (𝟙 X)).hom ≫ fX = 𝟙 _ := fun f h =>
    (congrArg (fun k => f ≫ k) (Category.id_comp fX)).trans h
  have hτgen : ∀ f : Spec (.of Ω) ⟶ X, f ≫ fX = 𝟙 _ → (inv ρ ≫ f ≫ σ) ≫ fX = 𝟙 _ := by
    intro f h
    simp only [Category.assoc]
    rw [hρ, ← Category.assoc f fX ρ, h, Category.id_comp, IsIso.inv_hom_id]
  have hτpt : ∀ v : wcEtPts Ω X fX (Scheme.Etale.mk (𝟙 X)),
      (inv ρ ≫ v.1 ≫ σ) ≫ (Scheme.Etale.mk (𝟙 X)).hom ≫ fX = 𝟙 _ := fun v =>
    hsecO _ (hτgen v.1 (hsecI v.1 v.2))
  let τ : wcEtPts Ω X fX (Scheme.Etale.mk (𝟙 X)) → wcEtPts Ω X fX (Scheme.Etale.mk (𝟙 X)) :=
    fun v => ⟨inv ρ ≫ v.1 ≫ σ, hτpt v⟩
  have hτinj : Function.Injective τ := by
    intro v v' h
    have h1 : inv ρ ≫ v.1 ≫ σ = inv ρ ≫ v'.1 ≫ σ := congrArg Subtype.val h
    exact Subtype.ext ((cancel_mono σ).mp ((cancel_epi (inv ρ)).mp h1))

  have hfin : ∀ b : wcEtDivSub Ω X fX (Scheme.Etale.mk (𝟙 X)), {s | b.1 s ≠ 0}.Finite := by
    intro b
    haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace fX
    have hb : ∀ x : X, ∃ W : Set X, IsOpen W ∧ x ∈ W ∧ ∃ T : Set X, T.Finite ∧
        ∀ s : wcEtPts Ω X fX (Scheme.Etale.mk (𝟙 X)), b.1 s ≠ 0 →
          s.1 (IsLocalRing.closedPoint Ω) ∈ W →
          (s.1 ≫ (Scheme.Etale.mk (𝟙 X)).hom) (IsLocalRing.closedPoint Ω) ∈ T := b.2
    choose W hW hxW T hT hWT using hb
    obtain ⟨I, hI⟩ := isCompact_univ.elim_finite_subcover W hW
      (fun x _ => Set.mem_iUnion.mpr ⟨x, hxW x⟩)
    have hTfin : (⋃ x ∈ I, T x).Finite := Set.Finite.biUnion I.finite_toSet (fun x _ => hT x)
    let ev : wcEtPts Ω X fX (Scheme.Etale.mk (𝟙 X)) → X := fun s => s.1 (IsLocalRing.closedPoint Ω)
    have hev : Function.Injective ev := by
      intro s s' h
      have h2 := wc_fet_section_fibre_unique fX s'.1 (hsecI s'.1 s'.2) Ω (𝟙 _) s.1
        (hsecI s.1 s.2) ⟨_, h.symm⟩
      exact Subtype.ext (h2.trans (Category.id_comp _))
    refine (Set.Finite.preimage hev.injOn hTfin).subset ?_
    intro s hs
    have hmem := hI (Set.mem_univ (ev s))
    rw [Set.mem_iUnion₂] at hmem
    obtain ⟨x, hx, hsx⟩ := hmem
    have h3 := hWT x s hs hsx
    have h4 : ∀ f : Spec (.of Ω) ⟶ X, f ≫ (Scheme.Etale.mk (𝟙 X)).hom = f :=
      fun f => Category.comp_id f
    exact Set.mem_biUnion hx
      (memeq (congrArg (fun k : Spec (.of Ω) ⟶ X => k (IsLocalRing.closedPoint Ω)) (h4 s.1)).symm h3)

  let A0 : (wcEtDivPre Ω X fX).obj (Opposite.op (Scheme.Etale.mk (𝟙 X))) :=
    φ₀.app (Opposite.op (Scheme.Etale.mk (𝟙 X))) (ULift.up 1)
  let a : wcEtPts Ω X fX (Scheme.Etale.mk (𝟙 X)) → ℤ := (ULift.down A0).1
  let S : Finset (wcEtPts Ω X fX (Scheme.Etale.mk (𝟙 X))) := (hfin (ULift.down A0)).toFinset
  have hS : ∀ v, v ∉ S → a v = 0 := fun v hv => by
    by_contra h
    exact hv ((hfin (ULift.down A0)).mem_toFinset.mpr h)
  choose E' m' hEm using hpt
  let gH : (wcEtGmAtPre X (genericPoint X)).obj (Opposite.op (Scheme.Etale.mk (𝟙 X))) →+
      (wcEtPts Ω X fX (Scheme.Etale.mk (𝟙 X)) → ℤ) :=
    (wcEtDivSub Ω X fX (Scheme.Etale.mk (𝟙 X))).subtype.comp
      ((AddEquiv.ulift : ULift.{u+1} (wcEtDivSub Ω X fX (Scheme.Etale.mk (𝟙 X))) ≃+ _).toAddMonoidHom.comp
        (ord.app (Opposite.op (Scheme.Etale.mk (𝟙 X)))).hom)
  have hEm' : ∀ s₁ s₂ t, @ite ℤ (t = s₁) (Classical.dec _) 1 0 - @ite ℤ (t = s₂) (Classical.dec _) 1 0 =
      (M : ℤ) * (E' s₁ s₂).1 t + gH (m' s₁ s₂) t := fun s₁ s₂ t => hEm s₁ s₂ t
  let EE : wcEtDivSub Ω X fX (Scheme.Etale.mk (𝟙 X)) := ∑ v ∈ S, a v • E' (τ v) v
  let mm : (wcEtGmAtPre X (genericPoint X)).obj (Opposite.op (Scheme.Etale.mk (𝟙 X))) :=
    ∑ v ∈ S, a v • m' (τ v) v
  have hcomb : ∀ w, (M : ℤ) * EE.1 w + gH mm w = ∑ v ∈ S, a v *
      (@ite ℤ (w = τ v) (Classical.dec _) 1 0 - @ite ℤ (w = v) (Classical.dec _) 1 0) := by
    intro w
    have h1 : (EE : wcEtPts Ω X fX (Scheme.Etale.mk (𝟙 X)) → ℤ) =
        ∑ v ∈ S, a v • ((E' (τ v) v : wcEtDivSub Ω X fX (Scheme.Etale.mk (𝟙 X))) :
          wcEtPts Ω X fX (Scheme.Etale.mk (𝟙 X)) → ℤ) := by
      simp only [EE, AddSubgroup.val_finsetSum, AddSubgroup.coe_zsmul]
    have h2 : gH mm = ∑ v ∈ S, a v • gH (m' (τ v) v) := by
      simp only [mm, map_sum, map_zsmul]
    rw [h1, h2, Finset.sum_apply, Finset.sum_apply, Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun v _ => ?_)
    rw [Pi.smul_apply, Pi.smul_apply, smul_eq_mul, smul_eq_mul, hEm' (τ v) v w]
    ring
  have hA : ∀ u, ∑ v ∈ S, a v * @ite ℤ (τ u = τ v) (Classical.dec _) 1 0 = a u := by
    intro u
    rw [Finset.sum_eq_single u]
    · rw [if_pos rfl, mul_one]
    · intro v _ hv
      rw [if_neg (fun h => hv (hτinj h).symm), mul_zero]
    · intro hu
      rw [if_pos rfl, mul_one, hS u hu]
  have hB : ∀ w, ∑ v ∈ S, a v * @ite ℤ (w = v) (Classical.dec _) 1 0 = a w := by
    intro w
    rw [Finset.sum_eq_single w]
    · rw [if_pos rfl, mul_one]
    · intro v _ hv
      rw [if_neg (fun h => hv h.symm), mul_zero]
    · intro hw
      rw [if_pos rfl, mul_one, hS w hw]
  have hkeyid : ∀ u, a u = a (τ u) + (M : ℤ) * EE.1 (τ u) + gH mm (τ u) := by
    intro u
    have h := hcomb (τ u)
    rw [Finset.sum_congr rfl (fun v _ => mul_sub _ _ _), Finset.sum_sub_distrib, hA u,
      hB (τ u)] at h
    linarith

  obtain ⟨δ₀, hδ₀⟩ := hexist (wcEtDivPre Ω X fX) (ULift.up EE)
  obtain ⟨μ₀, hμ₀⟩ := hexist (wcEtGmAtPre X (genericPoint X)) mm
  let κ : (Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶
      (wcEtBaseChange σ).op ⋙ (Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)) :=
    { app := fun _ => 𝟙 _, naturality := fun _ _ _ => rfl }
  have hfs : Limits.pullback.fst (Scheme.Etale.mk (𝟙 X)).hom σ =
      Limits.pullback.snd (Scheme.Etale.mk (𝟙 X)).hom σ ≫ σ :=
    (Category.comp_id (Limits.pullback.fst (Scheme.Etale.mk (𝟙 X)).hom σ)).symm.trans
      (Limits.pullback.condition (f := (Scheme.Etale.mk (𝟙 X)).hom) (g := σ))
  have hid : κ ≫ Functor.whiskerLeft (wcEtBaseChange σ).op φ₀ =
      (φ₀ + M • δ₀ + μ₀ ≫ ord) ≫ Classical.choose hex := by
    apply huniq
    apply ULift.ext
    apply Subtype.ext
    funext t
    let u : wcEtPts Ω X fX (Scheme.Etale.mk (𝟙 X)) :=
      wcEtPtsMap Ω X fX (r ((wcEtBaseChange σ).obj (Scheme.Etale.mk (𝟙 X)))) t
    have hs : (τ u).1 = inv ρ ≫ t.1 ≫ Limits.pullback.fst (Scheme.Etale.mk (𝟙 X)).hom σ := by
      show inv ρ ≫ (t.1 ≫ Limits.pullback.snd (Scheme.Etale.mk (𝟙 X)).hom σ) ≫ σ =
        inv ρ ≫ t.1 ≫ Limits.pullback.fst (Scheme.Etale.mk (𝟙 X)).hom σ
      exact congrArg (fun k => inv ρ ≫ k)
        ((Category.assoc _ _ _).trans (congrArg (fun k => t.1 ≫ k) hfs.symm))
    have eL : (κ ≫ Functor.whiskerLeft (wcEtBaseChange σ).op φ₀).app
        (Opposite.op (Scheme.Etale.mk (𝟙 X))) (ULift.up 1) =
        φ₀.app (Opposite.op ((wcEtBaseChange σ).obj (Scheme.Etale.mk (𝟙 X)))) (ULift.up 1) := rfl
    have eR : ((φ₀ + M • δ₀ + μ₀ ≫ ord) ≫ Classical.choose hex).app
        (Opposite.op (Scheme.Etale.mk (𝟙 X))) (ULift.up 1) =
        (Classical.choose hex).app (Opposite.op (Scheme.Etale.mk (𝟙 X)))
          (A0 + M • δ₀.app (Opposite.op (Scheme.Etale.mk (𝟙 X))) (ULift.up 1) +
            ord.app (Opposite.op (Scheme.Etale.mk (𝟙 X)))
              (μ₀.app (Opposite.op (Scheme.Etale.mk (𝟙 X))) (ULift.up 1))) := rfl
    rw [eL, eR, hkey (wcEtDivPre Ω X fX) φ₀ ((wcEtBaseChange σ).obj (Scheme.Etale.mk (𝟙 X))) 1,
      one_smul, hα₀ (Scheme.Etale.mk (𝟙 X)) _ t (τ u) hs, hδ₀, hμ₀]
    change a u = (ULift.down A0).1 (τ u) + (M • EE.1) (τ u) + gH mm (τ u)
    rw [Pi.smul_apply, nsmul_eq_mul]
    exact hkeyid u

  have hL : wcEtCanConst σ (AddCommGrpCat.of (ULift.{u+1} ℤ)) ≫
      (wcEtPush σ).map ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map φ₀) =
      (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
        (κ ≫ Functor.whiskerLeft (wcEtBaseChange σ).op
          (φ₀ ≫ toSheafify (Scheme.smallEtaleTopology X) (wcEtDivPre Ω X fX))) := by
    have e1 : wcEtCanConst σ (AddCommGrpCat.of (ULift.{u+1} ℤ)) =
        (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
          (κ ≫ Functor.whiskerLeft (wcEtBaseChange σ).op (toSheafify (Scheme.smallEtaleTopology X)
            ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))))) := rfl
    have e2 : (wcEtPush σ).map
        ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map φ₀) =
        (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
          (Functor.whiskerLeft (wcEtBaseChange σ).op
            (sheafifyMap (Scheme.smallEtaleTopology X) φ₀)) := rfl
    show (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
          (κ ≫ Functor.whiskerLeft (wcEtBaseChange σ).op (toSheafify (Scheme.smallEtaleTopology X)
            ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))))) ≫
        (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
          (Functor.whiskerLeft (wcEtBaseChange σ).op
            (sheafifyMap (Scheme.smallEtaleTopology X) φ₀)) = _
    rw [← Functor.map_comp, Category.assoc, ← Functor.whiskerLeft_comp,
      ← toSheafify_naturality]
  refine ⟨(presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map δ₀,
    (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map μ₀, ?_⟩
  rw [hL, hdef]
  show (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
      (κ ≫ Functor.whiskerLeft (wcEtBaseChange σ).op
        (φ₀ ≫ toSheafify (Scheme.smallEtaleTopology X) (wcEtDivPre Ω X fX))) =
    ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map φ₀ +
      M • (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map δ₀ +
      (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map μ₀ ≫
        (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map ord) ≫
    (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
      (Classical.choose hex ≫ Functor.whiskerLeft (wcEtBaseChange σ).op
        (toSheafify (Scheme.smallEtaleTopology X) (wcEtDivPre Ω X fX)))
  rw [← Functor.map_comp (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) μ₀ ord,
    ← Functor.map_nsmul, ← Functor.map_add, ← Functor.map_add, ← Functor.map_comp]
  congr 1
  rw [Functor.whiskerLeft_comp, ← Category.assoc, hid, Category.assoc]

theorem wc_omega_section_eq_of_closedPoint : ∀ (Ω : Type u) [Field Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) (s t : Spec (.of Ω) ⟶ X), s ≫ fX = 𝟙 _ → t ≫ fX = 𝟙 _ → s (IsLocalRing.closedPoint Ω) = t (IsLocalRing.closedPoint Ω) → s = t :=
by
  intro Ω _ X fX s t hsf htf h
  have hs := Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField Ω X s
  have ht := Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField Ω X t
  rw [← Scheme.residueFieldCongr_fromSpecResidueField h, ← Category.assoc, ← Spec.map_comp] at ht
  generalize Scheme.descResidueField (Scheme.stalkClosedPointTo s) = a at hs
  generalize (X.residueFieldCongr h).hom ≫ Scheme.descResidueField (Scheme.stalkClosedPointTo t) = b at ht
  have hφ' := Spec.map_preimage (X.fromSpecResidueField (s (IsLocalRing.closedPoint Ω)) ≫ fX)
  generalize Spec.preimage (X.fromSpecResidueField (s (IsLocalRing.closedPoint Ω)) ≫ fX) = φ at hφ'
  have ea : φ ≫ a = 𝟙 _ := by
    apply Spec.map_injective
    rw [Spec.map_comp, hφ', ← Category.assoc, hs, hsf, Spec.map_id]
  have eb : φ ≫ b = 𝟙 _ := by
    apply Spec.map_injective
    rw [Spec.map_comp, hφ', ← Category.assoc, ht, htf, Spec.map_id]
  have Ea : ∀ w, a.hom (φ.hom w) = w := fun w => by
    have := congrArg (fun f => f.hom w) ea
    simpa using this
  have Eb : ∀ w, b.hom (φ.hom w) = w := fun w => by
    have := congrArg (fun f => f.hom w) eb
    simpa using this
  have hinj : Function.Injective a.hom := a.hom.injective
  have hab : a = b := by
    ext z
    have h1 : φ.hom (a.hom z) = z := hinj (Ea (a.hom z))
    calc a.hom z = b.hom (φ.hom (a.hom z)) := (Eb _).symm
      _ = b.hom z := by rw [h1]
  rw [← hs, ← ht, hab]

theorem wc_dvr_locval_presentation : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (K : Type u) [Field K] [Algebra R K] [IsFractionRing R K], (∀ (g h g' h' : R) (f : K), g ≠ 0 → h ≠ 0 → g' ≠ 0 → h' ≠ 0 → algebraMap R K g * f = algebraMap R K h → algebraMap R K g' * f = algebraMap R K h' → (wcLocVal R h : ℤ) - wcLocVal R g = (wcLocVal R h' : ℤ) - wcLocVal R g') ∧ (∀ (g h : R) (f : K), g ≠ 0 → h ≠ 0 → algebraMap R K g * f = algebraMap R K h → (0 ≤ (wcLocVal R h : ℤ) - wcLocVal R g ↔ ∃ r : R, algebraMap R K r = f)) ∧ ∃ ϖ : R, ϖ ≠ 0 ∧ (wcLocVal R ϖ : ℤ) - wcLocVal R 1 = 1 :=
by
  intro R _ _ _ K _ _ _
  have stepA : ∀ (ϖ : R), Irreducible ϖ → ∀ (w : Rˣ) (k : ℕ), wcLocVal R ((w : R) * ϖ ^ k) = k := by
    intro ϖ hϖ w k
    unfold wcLocVal
    split_ifs with h
    · classical
      obtain ⟨v, ϖ', hϖ', hv⟩ := Nat.find_spec h
      exact (IsDiscreteValuationRing.unit_mul_pow_congr_pow hϖ hϖ' w v k _ hv).symm
    · exact absurd ⟨k, w, ϖ, hϖ, rfl⟩ h
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
  have locMul : ∀ r s : R, r ≠ 0 → s ≠ 0 → wcLocVal R (r * s) = wcLocVal R r + wcLocVal R s := by
    intro r s hr hs
    obtain ⟨a, u₁, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hr hϖ
    obtain ⟨c, u₂, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hs hϖ
    have e : (u₁ : R) * ϖ ^ a * ((u₂ : R) * ϖ ^ c) = ((u₁ * u₂ : Rˣ) : R) * ϖ ^ (a + c) := by
      rw [Units.val_mul, pow_add]; ring
    rw [e, stepA ϖ hϖ, stepA ϖ hϖ, stepA ϖ hϖ]
  have inj := IsFractionRing.injective R K
  refine ⟨?_, ?_, ?_⟩
  · intro g h g' h' f hg hh hg' hh' e₁ e₂
    have hR : g * h' = g' * h := by
      apply inj
      rw [map_mul, map_mul, ← e₁, ← e₂]; ring
    have := congrArg (wcLocVal R) hR
    rw [locMul g h' hg hh', locMul g' h hg' hh] at this
    omega
  · intro g h f hg hh e
    constructor
    · intro hle
      obtain ⟨c, w, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hg hϖ
      obtain ⟨a, u, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hh hϖ
      rw [stepA ϖ hϖ, stepA ϖ hϖ] at hle
      have hca : c ≤ a := by omega
      obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hca
      refine ⟨((u * w⁻¹ : Rˣ) : R) * ϖ ^ d, ?_⟩
      have hrg : ((u * w⁻¹ : Rˣ) : R) * ϖ ^ d * ((w : R) * ϖ ^ c) = (u : R) * ϖ ^ (c + d) := by
        have hw : ((w⁻¹ : Rˣ) : R) * (w : R) = 1 := Units.inv_mul w
        rw [Units.val_mul, pow_add]
        calc (u : R) * ((w⁻¹ : Rˣ) : R) * ϖ ^ d * ((w : R) * ϖ ^ c)
            = (u : R) * (((w⁻¹ : Rˣ) : R) * (w : R)) * (ϖ ^ c * ϖ ^ d) := by ring
          _ = (u : R) * (ϖ ^ c * ϖ ^ d) := by rw [hw, mul_one]
      have hgK : algebraMap R K ((w : R) * ϖ ^ c) ≠ 0 := by
        intro h0
        exact hg (inj (by rw [h0, map_zero]))
      apply mul_right_cancel₀ hgK
      rw [← map_mul, hrg, ← e, mul_comm]
    · rintro ⟨r, hr⟩
      have hgr : g * r = h := by
        apply inj
        rw [map_mul, hr, e]
      have hr0 : r ≠ 0 := by
        rintro rfl
        exact hh (by rw [← hgr, mul_zero])
      rw [← hgr, locMul g r hg hr0]
      omega
  · refine ⟨ϖ, hϖ.ne_zero, ?_⟩
    have h1 : wcLocVal R ϖ = 1 := by
      have := stepA ϖ hϖ 1 1
      rwa [Units.val_one, one_mul, pow_one] at this
    have h0 : wcLocVal R 1 = 0 := by
      have := stepA ϖ hϖ 1 0
      rwa [Units.val_one, one_mul, pow_zero] at this
    rw [h1, h0]; norm_num

theorem wc_stalk_reg_iff_stalk_range : ∀ (X : Scheme.{u}) [IsIntegral X] (U : X.Opens) (hU : IsAffineOpen U) [Nonempty U] (x : X) (f : (FractionRing Γ(X, U))ˣ), wcStalkReg X U x f ↔ ∃ r : X.presheaf.stalk x, algebraMap (X.presheaf.stalk x) X.functionField r = @FractionRing.algEquiv Γ(X, U) _ X.functionField _ _ (functionField_isFractionRing_of_isAffineOpen X U hU) (f : FractionRing Γ(X, U)) :=
by
  intro X _ U hU _ x f
  have hηmem : ∀ (W : X.Opens) (y : X), y ∈ W → genericPoint X ∈ W := fun W y hy =>
    (genericPoint_specializes y).mem_open W.isOpen hy
  have hηU : genericPoint X ∈ U := by
    obtain ⟨y0⟩ := ‹Nonempty U›
    exact hηmem U y0.1 y0.2
  have hΦa : ∀ a : Γ(X, U),
      @FractionRing.algEquiv Γ(X, U) _ X.functionField _ _
        (functionField_isFractionRing_of_isAffineOpen X U hU)
        (algebraMap Γ(X, U) (FractionRing Γ(X, U)) a) =
      (X.presheaf.germ U (genericPoint X) hηU).hom a := fun a =>
    (@FractionRing.algEquiv Γ(X, U) _ X.functionField _ _
      (functionField_isFractionRing_of_isAffineOpen X U hU)).commutes a
  have hsp : ∀ (V : X.Opens) (hxV : x ∈ V) (hηV : genericPoint X ∈ V) (s : Γ(X, V)),
      (X.presheaf.germ V (genericPoint X) hηV).hom s =
        algebraMap (X.presheaf.stalk x) X.functionField ((X.presheaf.germ V x hxV).hom s) :=
    fun V hxV hηV s =>
      (TopCat.Presheaf.germ_stalkSpecializes_apply X.presheaf hxV
        (genericPoint_specializes x) s).symm
  have hgU0 : ∀ b : Γ(X, U), algebraMap Γ(X, U) (FractionRing Γ(X, U)) b ≠ 0 →
      (X.presheaf.germ U (genericPoint X) hηU).hom b ≠ 0 := by
    intro b hb h0
    apply hb
    have hb' : b = 0 := germ_injective_of_isIntegral X (genericPoint X) hηU
      (h0.trans (map_zero (X.presheaf.germ U (genericPoint X) hηU).hom).symm)
    rw [hb', map_zero]
  unfold wcStalkReg
  constructor
  · rintro ⟨V, hxV, s, a, b, hb, hfa, hR3⟩
    have hηV : genericPoint X ∈ V := hηmem V x hxV
    have hηVU : genericPoint X ∈ V ⊓ U := by
      first
        | exact TopologicalSpace.Opens.mem_inf.mpr ⟨hηV, hηU⟩
        | exact ⟨hηV, hηU⟩
    have hres1 : ∀ t : Γ(X, V),
        (X.presheaf.germ (V ⊓ U) (genericPoint X) hηVU).hom
          ((X.presheaf.map (homOfLE (inf_le_left : V ⊓ U ≤ V)).op).hom t) =
        (X.presheaf.germ V (genericPoint X) hηV).hom t := fun t =>
      TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE (inf_le_left : V ⊓ U ≤ V))
        (genericPoint X) hηVU t
    have hres2 : ∀ t : Γ(X, U),
        (X.presheaf.germ (V ⊓ U) (genericPoint X) hηVU).hom
          ((X.presheaf.map (homOfLE (inf_le_right : V ⊓ U ≤ U)).op).hom t) =
        (X.presheaf.germ U (genericPoint X) hηU).hom t := fun t =>
      TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE (inf_le_right : V ⊓ U ≤ U))
        (genericPoint X) hηVU t
    have hR3' : (X.presheaf.map (homOfLE (inf_le_left : V ⊓ U ≤ V)).op).hom s *
        (X.presheaf.map (homOfLE (inf_le_right : V ⊓ U ≤ U)).op).hom b =
        (X.presheaf.map (homOfLE (inf_le_right : V ⊓ U ≤ U)).op).hom a := hR3
    have E1 : (X.presheaf.germ V (genericPoint X) hηV).hom s *
        (X.presheaf.germ U (genericPoint X) hηU).hom b =
        (X.presheaf.germ U (genericPoint X) hηU).hom a := by
      have h := congrArg (X.presheaf.germ (V ⊓ U) (genericPoint X) hηVU).hom hR3'
      rw [map_mul, hres1, hres2, hres2] at h
      exact h
    have E2 : @FractionRing.algEquiv Γ(X, U) _ X.functionField _ _
          (functionField_isFractionRing_of_isAffineOpen X U hU) (f : FractionRing Γ(X, U)) *
        (X.presheaf.germ U (genericPoint X) hηU).hom b =
        (X.presheaf.germ U (genericPoint X) hηU).hom a := by
      rw [← hΦa b, ← hΦa a, ← hfa, map_mul]
    refine ⟨(X.presheaf.germ V x hxV).hom s, ?_⟩
    rw [← hsp V hxV hηV s]
    exact (mul_right_cancel₀ (hgU0 b hb) (E2.trans E1.symm)).symm
  · rintro ⟨r, hr⟩
    obtain ⟨V, hxV, s, hs⟩ := TopCat.Presheaf.exists_germ_eq X.presheaf r
    have hs' : (X.presheaf.germ V x hxV).hom s = r := hs
    obtain ⟨a, b, hbmem, hab⟩ :=
      IsFractionRing.div_surjective (A := Γ(X, U)) (f : FractionRing Γ(X, U))
    have hb : algebraMap Γ(X, U) (FractionRing Γ(X, U)) b ≠ 0 :=
      IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hbmem
    have hfa : (f : FractionRing Γ(X, U)) * algebraMap Γ(X, U) (FractionRing Γ(X, U)) b =
        algebraMap Γ(X, U) (FractionRing Γ(X, U)) a := by
      rw [← hab, div_mul_cancel₀ _ hb]
    have hηV : genericPoint X ∈ V := hηmem V x hxV
    have hηVU : genericPoint X ∈ V ⊓ U := by
      first
        | exact TopologicalSpace.Opens.mem_inf.mpr ⟨hηV, hηU⟩
        | exact ⟨hηV, hηU⟩
    have hres1 : ∀ t : Γ(X, V),
        (X.presheaf.germ (V ⊓ U) (genericPoint X) hηVU).hom
          ((X.presheaf.map (homOfLE (inf_le_left : V ⊓ U ≤ V)).op).hom t) =
        (X.presheaf.germ V (genericPoint X) hηV).hom t := fun t =>
      TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE (inf_le_left : V ⊓ U ≤ V))
        (genericPoint X) hηVU t
    have hres2 : ∀ t : Γ(X, U),
        (X.presheaf.germ (V ⊓ U) (genericPoint X) hηVU).hom
          ((X.presheaf.map (homOfLE (inf_le_right : V ⊓ U ≤ U)).op).hom t) =
        (X.presheaf.germ U (genericPoint X) hηU).hom t := fun t =>
      TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE (inf_le_right : V ⊓ U ≤ U))
        (genericPoint X) hηVU t
    have key : (X.presheaf.germ (V ⊓ U) (genericPoint X) hηVU).hom
        ((X.presheaf.map (homOfLE (inf_le_left : V ⊓ U ≤ V)).op).hom s *
          (X.presheaf.map (homOfLE (inf_le_right : V ⊓ U ≤ U)).op).hom b) =
        (X.presheaf.germ (V ⊓ U) (genericPoint X) hηVU).hom
          ((X.presheaf.map (homOfLE (inf_le_right : V ⊓ U ≤ U)).op).hom a) := by
      rw [map_mul, hres1, hres2, hres2, hsp V hxV hηV s, hs', hr, ← hΦa b, ← hΦa a, ← hfa,
        map_mul]
    exact ⟨V, hxV, s, a, b, hb, hfa, germ_injective_of_isIntegral X (genericPoint X) hηVU key⟩

theorem wc_et_ord_top_generic_formula : ∀ (Ω : Type u) [Field Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsIntegral X] (ord : wcEtGmAtPre X (genericPoint X) ⟶ wcEtDivPre Ω X fX), wcOrdChar Ω X fX ord → ∃ θ : X.functionField ≃+* Γ(wcGenPt X (Scheme.Etale.mk (𝟙 X)), ⊤), ∀ (t : wcEtPts Ω X fX (Scheme.Etale.mk (𝟙 X))) (x : X), t.1 (IsLocalRing.closedPoint Ω) = x → ∀ b : (Γ(wcGenPt X (Scheme.Etale.mk (𝟙 X)), ⊤))ˣ, ∃ g h : X.presheaf.stalk x, g ≠ 0 ∧ h ≠ 0 ∧ algebraMap (X.presheaf.stalk x) X.functionField g * θ.symm (b : Γ(wcGenPt X (Scheme.Etale.mk (𝟙 X)), ⊤)) = algebraMap (X.presheaf.stalk x) X.functionField h ∧ ((ord.app (Opposite.op (Scheme.Etale.mk (𝟙 X))) (ULift.up (Additive.ofMul b))).down).1 t = (wcLocVal _ h : ℤ) - wcLocVal _ g :=
by
  intro Ω _ X fX _ ord hord

  haveI hsnd : IsIso (Limits.pullback.snd (Scheme.Etale.mk (𝟙 X)).hom
      (X.fromSpecStalk (genericPoint X))) :=
    @Limits.pullback_snd_iso_of_left_iso _ _ _ _ _ (Scheme.Etale.mk (𝟙 X)).hom
      (X.fromSpecStalk (genericPoint X)) (inferInstanceAs (IsIso (𝟙 X)))

  let θ : X.functionField ≃+* Γ(wcGenPt X (Scheme.Etale.mk (𝟙 X)), ⊤) :=
    ((Scheme.ΓSpecIso (X.presheaf.stalk (genericPoint X))).symm ≪≫
      Scheme.Γ.mapIso (asIso (Limits.pullback.snd (Scheme.Etale.mk (𝟙 X)).hom
        (X.fromSpecStalk (genericPoint X)))).op).commRingCatIsoToRingEquiv

  have e : Limits.pullback.fst (Scheme.Etale.mk (𝟙 X)).hom (X.fromSpecStalk (genericPoint X)) =
      Limits.pullback.snd (Scheme.Etale.mk (𝟙 X)).hom (X.fromSpecStalk (genericPoint X)) ≫
        X.fromSpecStalk (genericPoint X) := by
    rw [← Limits.pullback.condition]
    exact (Category.comp_id _).symm

  have hpre : ∀ (W : (Scheme.Etale.mk (𝟙 X)).left.Opens), genericPoint X ∈ W →
      ∀ p, p ∈ (Limits.pullback.fst (Scheme.Etale.mk (𝟙 X)).hom
        (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ W := by
    intro W hη p
    have hp : (Limits.pullback.fst (Scheme.Etale.mk (𝟙 X)).hom
        (X.fromSpecStalk (genericPoint X))) p =
        (X.fromSpecStalk (genericPoint X)) ((Limits.pullback.snd (Scheme.Etale.mk (𝟙 X)).hom
          (X.fromSpecStalk (genericPoint X))) p) := by
      rw [e]
      exact rfl
    have hr : (X.fromSpecStalk (genericPoint X)) ((Limits.pullback.snd (Scheme.Etale.mk (𝟙 X)).hom
        (X.fromSpecStalk (genericPoint X))) p) ∈ Set.range (X.fromSpecStalk (genericPoint X)) :=
      ⟨_, rfl⟩
    rw [Scheme.range_fromSpecStalk] at hr
    show (Limits.pullback.fst (Scheme.Etale.mk (𝟙 X)).hom
        (X.fromSpecStalk (genericPoint X))) p ∈ W
    rw [hp]
    exact Specializes.mem_open hr W.isOpen hη

  have hinj : ∀ (W : (Scheme.Etale.mk (𝟙 X)).left.Opens), genericPoint X ∈ W →
      Function.Injective (wcGenRestr X (Scheme.Etale.mk (𝟙 X)) W) := by
    intro W hη
    have hle : (⊤ : (wcGenPt X (Scheme.Etale.mk (𝟙 X))).Opens) ≤
        (Limits.pullback.fst (Scheme.Etale.mk (𝟙 X)).hom
          (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ W := fun p _ => hpre W hη p
    apply Function.LeftInverse.injective
      (g := ((wcGenPt X (Scheme.Etale.mk (𝟙 X))).presheaf.map (homOfLE hle).op).hom)
    intro y
    show ((wcGenPt X (Scheme.Etale.mk (𝟙 X))).presheaf.map (homOfLE le_top).op ≫
      (wcGenPt X (Scheme.Etale.mk (𝟙 X))).presheaf.map (homOfLE hle).op).hom y = y
    rw [← Functor.map_comp]
    have hid : ((homOfLE (le_top : (Limits.pullback.fst (Scheme.Etale.mk (𝟙 X)).hom
          (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ W ≤ ⊤)).op ≫ (homOfLE hle).op :
        Opposite.op (⊤ : (wcGenPt X (Scheme.Etale.mk (𝟙 X))).Opens) ⟶ Opposite.op ⊤) = 𝟙 _ :=
      Subsingleton.elim _ _
    rw [hid, CategoryTheory.Functor.map_id]
    rfl

  have L : ∀ {P Y : Scheme.{u}} (y : Y) (f : P ⟶ Y) (s : P ⟶ Spec (Y.presheaf.stalk y)),
      f = s ≫ Y.fromSpecStalk y → ∀ (W : Y.Opens) (hy : y ∈ W),
      f.app W = Y.presheaf.germ W y hy ≫ (Scheme.ΓSpecIso (Y.presheaf.stalk y)).inv ≫
        s.appLE ⊤ (f ⁻¹ᵁ W) le_top := by
    intro P Y y f s he W hy
    subst he
    rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.comp_appLE, Scheme.fromSpecStalk_app hy,
      Category.assoc, Category.assoc]
    exact congrArg (fun k => Y.presheaf.germ W y hy ≫ (Scheme.ΓSpecIso _).inv ≫ k)
      (Scheme.Hom.map_appLE s _ _)
  have hgerm : ∀ (W : (Scheme.Etale.mk (𝟙 X)).left.Opens) (hη : genericPoint X ∈ W)
      (a : Γ(X, W)), wcGenSigma X (Scheme.Etale.mk (𝟙 X)) W a =
        wcGenRestr X (Scheme.Etale.mk (𝟙 X)) W (θ ((X.presheaf.germ W (genericPoint X) hη).hom a)) := by
    intro W hη a
    have key := L (Y := X) (genericPoint X)
      (Limits.pullback.fst (Scheme.Etale.mk (𝟙 X)).hom (X.fromSpecStalk (genericPoint X)))
      (Limits.pullback.snd (Scheme.Etale.mk (𝟙 X)).hom (X.fromSpecStalk (genericPoint X))) e W hη
    exact congrArg (fun ψ => ψ.hom a) key
  refine ⟨θ, ?_⟩
  intro t x hx b
  obtain ⟨n, hrep⟩ := wc_ord_rep_exists X (Scheme.Etale.mk (𝟙 X)) b x
  have hval := hord (Scheme.Etale.mk (𝟙 X)) b t n (by rw [hx]; exact hrep)
  obtain ⟨W, hxW, g₀, h₀, -, heq, hg0, hh0, hn⟩ := hrep
  have hη : genericPoint X ∈ W :=
    Specializes.mem_open ((genericPoint_spec X).specializes trivial) W.isOpen hxW
  have hF3 : ∀ a : Γ(X, W), algebraMap (X.presheaf.stalk x) X.functionField
      ((X.presheaf.germ W x hxW).hom a) = (X.presheaf.germ W (genericPoint X) hη).hom a := by
    intro a
    exact TopCat.Presheaf.germ_stalkSpecializes_apply X.presheaf hxW
      ((genericPoint_spec X).specializes trivial) a
  rw [hgerm W hη g₀, hgerm W hη h₀, ← map_mul] at heq
  have h2 := hinj W hη heq
  have h3 : (X.presheaf.germ W (genericPoint X) hη).hom g₀ *
      θ.symm (b : Γ(wcGenPt X (Scheme.Etale.mk (𝟙 X)), ⊤)) =
      (X.presheaf.germ W (genericPoint X) hη).hom h₀ := by
    have h4 := congrArg θ.symm h2
    rwa [map_mul, RingEquiv.symm_apply_apply, RingEquiv.symm_apply_apply] at h4
  refine ⟨(X.presheaf.germ W x hxW).hom g₀, (X.presheaf.germ W x hxW).hom h₀, hg0, hh0, ?_, ?_⟩
  · exact (congrArg (· * θ.symm (b : Γ(wcGenPt X (Scheme.Etale.mk (𝟙 X)), ⊤))) (hF3 g₀)).trans
      (h3.trans (hF3 h₀).symm)
  · exact hval.trans hn

theorem wc_et_div_point_congr : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IsIntegral X], (∀ x : X, IsIntegrallyClosed (X.presheaf.stalk x)) → topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) → ∀ (M : ℕ), (M : Ω) ≠ 0 → ∀ ord : wcEtGmAtPre X (genericPoint X) ⟶ wcEtDivPre Ω X fX, wcOrdChar Ω X fX ord → ∀ s₁ s₂ : wcEtPts Ω X fX (Scheme.Etale.mk (𝟙 X)), ∃ (E : wcEtDivSub Ω X fX (Scheme.Etale.mk (𝟙 X))) (m : (wcEtGmAtPre X (genericPoint X)).obj (Opposite.op (Scheme.Etale.mk (𝟙 X)))), ∀ t : wcEtPts Ω X fX (Scheme.Etale.mk (𝟙 X)), @ite ℤ (t = s₁) (Classical.dec _) 1 0 - @ite ℤ (t = s₂) (Classical.dec _) 1 0 = (M : ℤ) * E.1 t + ((ord.app (Opposite.op (Scheme.Etale.mk (𝟙 X))) m).down).1 t :=
by
  classical
  intro Ω _ _ X fX _ _ hnorm hdim M hM ord hord s₁ s₂
  have hstalk : ∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x) :=
    fun x => ⟨inferInstance, hnorm x⟩

  obtain ⟨U, hU, hfin, hDD⟩ := wc_curve_dedekind_affine_open Ω X fX inferInstance hstalk hdim
  haveI := hDD
  have hηU := (wc_dedekind_affine_points X U hU).1
  haveI : Nonempty U := ⟨⟨genericPoint X, hηU⟩⟩
  obtain ⟨ord₀, hord₀⟩ := wc_curve_ord_data_exists Ω X fX hstalk hdim U hU hfin
  obtain ⟨g, c, hRR⟩ := wc_curve_riemann_roch_large_degree Ω X fX hstalk hdim U hU hfin ord₀ hord₀
  obtain ⟨-, ordT, -, -, hT, hTr⟩ :=
    wc_curve_ord_transport Ω X fX hstalk hdim U hU hfin ord₀ hord₀ g c hRR
  obtain ⟨-, Q, -, hcong⟩ :=
    wc_curve_divisor_degree_point_congr_gen Ω X fX hstalk hdim U hU hfin M hM ordT hT

  obtain ⟨θ, hθ⟩ := wc_et_ord_top_generic_formula Ω X fX ord hord
  letI : IsFractionRing Γ(X, U) X.functionField :=
    functionField_isFractionRing_of_isAffineOpen X U hU
  let Φ : FractionRing Γ(X, U) ≃ₐ[Γ(X, U)] X.functionField :=
    FractionRing.algEquiv Γ(X, U) X.functionField
  let φ : FractionRing Γ(X, U) →+* Γ(wcGenPt X (Scheme.Etale.mk (𝟙 X)), ⊤) :=
    θ.toRingHom.comp Φ.toRingEquiv.toRingHom
  let mF : Additive (FractionRing Γ(X, U))ˣ →
      (wcEtGmAtPre X (genericPoint X)).obj (Opposite.op (Scheme.Etale.mk (𝟙 X))) :=
    fun F => ULift.up (Additive.ofMul (Units.map φ.toMonoidHom (Additive.toMul F)))
  have hmF_add : ∀ F G, mF (F + G) = mF F + mF G := by
    intro F G
    show ULift.up (Additive.ofMul (Units.map φ.toMonoidHom
      (Additive.toMul F * Additive.toMul G))) = mF F + mF G
    rw [map_mul]
    rfl
  have hΦθ : ∀ F : Additive (FractionRing Γ(X, U))ˣ,
      θ.symm ((Units.map φ.toMonoidHom (Additive.toMul F) :
        (Γ(wcGenPt X (Scheme.Etale.mk (𝟙 X)), ⊤))ˣ) : Γ(wcGenPt X (Scheme.Etale.mk (𝟙 X)), ⊤)) =
        Φ ((Additive.toMul F : (FractionRing Γ(X, U))ˣ) : FractionRing Γ(X, U)) :=
    fun F => θ.symm_apply_apply _

  have hne : ∀ (s : wcEtPts Ω X fX (Scheme.Etale.mk (𝟙 X))) (x : X),
      s.1 (IsLocalRing.closedPoint Ω) = x → x ≠ genericPoint X := by
    intro s x hx hxη
    apply (wc_rational_point_stalk_dvr' Ω X fX hnorm hdim (Scheme.Etale.mk (𝟙 X)) s).2.2
    exact hx.trans hxη

  have huniq : ∀ (a b : Additive (FractionRing Γ(X, U))ˣ →+ ℤ), (∀ F, 0 ≤ a F ↔ 0 ≤ b F) →
      (∃ F, a F = 1) → (∃ F, b F = 1) → a = b := by
    intro a b hab ⟨g₁, hg₁⟩ ⟨g₂, hg₂⟩
    have hb : ∀ F, b F = a F * b g₁ := by
      intro F
      have h1 := (hab (F - a F • g₁)).mp (by
        rw [map_sub, map_zsmul, hg₁, smul_eq_mul, mul_one, sub_self])
      have h2 := (hab (a F • g₁ - F)).mp (by
        rw [map_sub, map_zsmul, hg₁, smul_eq_mul, mul_one, sub_self])
      rw [map_sub, map_zsmul, smul_eq_mul] at h1 h2
      linarith
    have e : b g₁ * a g₂ = 1 := by rw [mul_comm, ← hb g₂, hg₂]
    have hnn : 0 ≤ b g₁ := (hab g₁).mp (by rw [hg₁]; norm_num)
    have hc : b g₁ = 1 := by
      rcases Int.eq_one_or_neg_one_of_mul_eq_one e with h | h
      · exact h
      · omega
    apply AddMonoidHom.ext
    intro F
    rw [hb F, hc, mul_one]

  have hkey : ∀ (t : wcEtPts Ω X fX (Scheme.Etale.mk (𝟙 X))) (y : X),
      t.1 (IsLocalRing.closedPoint Ω) = y → ∀ F : Additive (FractionRing Γ(X, U))ˣ,
      ((ord.app (Opposite.op (Scheme.Etale.mk (𝟙 X))) (mF F)).down).1 t = ordT y F := by
    intro t y hy
    have hyη : y ≠ genericPoint X := hne t y hy
    obtain ⟨_, hD⟩ := (wc_rational_point_stalk_dvr' Ω X fX hnorm hdim (Scheme.Etale.mk (𝟙 X)) t).1
    haveI : IsDiscreteValuationRing (X.presheaf.stalk y) := by
      subst hy
      exact hD
    obtain ⟨hA, hB, ϖ, hϖ0, hϖ1⟩ := wc_dvr_locval_presentation (X.presheaf.stalk y) X.functionField
    let v₁ : Additive (FractionRing Γ(X, U))ˣ →+ ℤ := AddMonoidHom.mk'
      (fun F => ((ord.app (Opposite.op (Scheme.Etale.mk (𝟙 X))) (mF F)).down).1 t)
      (fun F G => by
        show ((ord.app (Opposite.op (Scheme.Etale.mk (𝟙 X))) (mF (F + G))).down).1 t = _
        rw [hmF_add, map_add]
        rfl)
    have hsign : ∀ F, 0 ≤ v₁ F ↔ 0 ≤ ordT y F := by
      intro F
      obtain ⟨g₀, h₀, hg0, hh0, heq, hval⟩ :=
        hθ t y hy (Units.map φ.toMonoidHom (Additive.toMul F))
      rw [hΦθ] at heq
      have hv : v₁ F = (wcLocVal _ h₀ : ℤ) - wcLocVal _ g₀ := hval
      rw [hv]
      exact (hB g₀ h₀ _ hg0 hh0 heq).trans
        ((wc_stalk_reg_iff_stalk_range X U hU y (Additive.toMul F)).symm.trans
          (hTr y hyη (Additive.toMul F)).symm)
    have hϖK : algebraMap (X.presheaf.stalk y) X.functionField ϖ ≠ 0 := by
      intro h
      apply hϖ0
      exact IsFractionRing.injective (X.presheaf.stalk y) X.functionField
        (h.trans (map_zero _).symm)
    have hϖK' : Φ.symm (algebraMap (X.presheaf.stalk y) X.functionField ϖ) ≠ 0 := by
      intro h
      apply hϖK
      have := congrArg Φ h
      rw [AlgEquiv.apply_symm_apply, map_zero] at this
      exact this
    let F₀ : Additive (FractionRing Γ(X, U))ˣ := Additive.ofMul (Units.mk0 _ hϖK')
    have hv1 : v₁ F₀ = 1 := by
      obtain ⟨g₀, h₀, hg0, hh0, heq, hval⟩ :=
        hθ t y hy (Units.map φ.toMonoidHom (Additive.toMul F₀))
      have e1 : θ.symm ((Units.map φ.toMonoidHom (Additive.toMul F₀) :
          (Γ(wcGenPt X (Scheme.Etale.mk (𝟙 X)), ⊤))ˣ) : Γ(wcGenPt X (Scheme.Etale.mk (𝟙 X)), ⊤)) =
          algebraMap (X.presheaf.stalk y) X.functionField ϖ := by
        rw [hΦθ]
        exact Φ.apply_symm_apply _
      rw [e1] at heq
      have hv : v₁ F₀ = (wcLocVal _ h₀ : ℤ) - wcLocVal _ g₀ := hval
      rw [hv, hA g₀ h₀ 1 ϖ _ hg0 hh0 one_ne_zero hϖ0 heq (by rw [map_one, one_mul]), hϖ1]
    have hv := huniq v₁ (ordT y) hsign ⟨F₀, hv1⟩ (hT.2.2.2.1 y hyη)
    intro F
    exact DFunLike.congr_fun hv F

  have hsec : ∀ s : wcEtPts Ω X fX (Scheme.Etale.mk (𝟙 X)),
      (s.1 : Spec (.of Ω) ⟶ X) ≫ fX = 𝟙 _ := by
    intro s
    exact (congrArg (fun k => s.1 ≫ k) (Category.id_comp fX)).symm.trans s.2
  have hind : ∀ (s t : wcEtPts Ω X fX (Scheme.Etale.mk (𝟙 X))) (a b : X),
      s.1 (IsLocalRing.closedPoint Ω) = a → t.1 (IsLocalRing.closedPoint Ω) = b →
      @ite ℤ (t = s) (Classical.dec _) 1 0 = Finsupp.single a 1 b := by
    intro s t a b ha hb
    rw [Finsupp.single_apply]
    by_cases h : t = s
    · rw [if_pos h, if_pos]
      subst h
      exact ha.symm.trans hb
    · rw [if_neg h, if_neg]
      intro hab
      apply h
      exact Subtype.ext (wc_omega_section_eq_of_closedPoint Ω X fX t.1 s.1 (hsec t) (hsec s)
        (hb.trans (hab.symm.trans ha.symm)))

  obtain ⟨x₁, hx₁⟩ : ∃ x : X, s₁.1 (IsLocalRing.closedPoint Ω) = x := ⟨_, rfl⟩
  obtain ⟨x₂, hx₂⟩ : ∃ x : X, s₂.1 (IsLocalRing.closedPoint Ω) = x := ⟨_, rfl⟩
  obtain ⟨E₁, m₁, -, h₁⟩ := hcong x₁ (hne s₁ x₁ hx₁)
  obtain ⟨E₂, m₂, -, h₂⟩ := hcong x₂ (hne s₂ x₂ hx₂)
  refine ⟨⟨fun t => (E₁ - E₂) (t.1 (IsLocalRing.closedPoint Ω)), ?_⟩, mF (m₁ - m₂), ?_⟩
  · intro x
    refine ⟨Set.univ, isOpen_univ, Set.mem_univ _, ↑(E₁ - E₂).support,
      Finset.finite_toSet _, ?_⟩
    intro s hs _
    exact Finset.mem_coe.mpr (Finsupp.mem_support_iff.mpr hs)
  · intro t
    have e1 := h₁ (t.1 (IsLocalRing.closedPoint Ω))
    have e2 := h₂ (t.1 (IsLocalRing.closedPoint Ω))
    have e3 := hkey t (t.1 (IsLocalRing.closedPoint Ω)) rfl (m₁ - m₂)
    rw [map_sub] at e3
    rw [hind s₁ t x₁ _ hx₁ rfl, hind s₂ t x₂ _ hx₂ rfl, e3]
    show _ = (M : ℤ) * (E₁ - E₂) (t.1 (IsLocalRing.closedPoint Ω)) + _
    have e4 : (E₁ - E₂) (t.1 (IsLocalRing.closedPoint Ω)) =
        E₁ (t.1 (IsLocalRing.closedPoint Ω)) - E₂ (t.1 (IsLocalRing.closedPoint Ω)) :=
      Finsupp.sub_apply _ _ _
    linear_combination e1 - e2 - (M : ℤ) * e4

theorem wc_pow_normal_curve_gm_twist_mod : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IrreducibleSpace X], (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) → topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) → ∀ (M : ℕ), (M : Ω) ≠ 0 → ∀ (σ : X ⟶ X) [IsIso σ] [(wcEtPush σ).Additive] [Limits.PreservesFiniteLimits (wcEtPush σ)] [Limits.PreservesFiniteColimits (wcEtPush σ)] [IsIso (wcEtCanGm σ)], letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _; ∀ c : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (wcEtGm X) 1, ∃ d, wcExtTwist (wcEtPush σ) (wcEtCanConst σ (AddCommGrpCat.of (ULift.{u+1} ℤ))) (wcEtCanGm σ) 1 c = c + M • d :=
by
  intro Ω _ _ X fX _ _ hnorm hdim M hMΩ σ _ _ _ _ _
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
  intro c

  haveI : ∀ x : X, _root_.IsReduced (X.presheaf.stalk x) := fun x => by
    haveI := (hnorm x).1
    infer_instance
  haveI : AlgebraicGeometry.IsReduced X := isReduced_of_isReduced_stalk X
  haveI : AlgebraicGeometry.IsIntegral X := isIntegral_of_irreducibleSpace_of_isReduced X
  have hnorm' : ∀ x : X, IsIntegrallyClosed (X.presheaf.stalk x) := fun x => (hnorm x).2

  obtain ⟨φ, t, ht⟩ := wc_curve_function_field_trdeg_one Ω X fX hdim
  letI := φ.toAlgebra
  have hL : ∀ (L : Type u) [Field L] [Algebra X.functionField L],
      Algebra.IsAlgebraic X.functionField L →
      letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of L))) AddCommGrpCat.{u+1}) :=
        HasExt.standard _
      ∀ q : ℕ, Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of L)))
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (wcEtGm (Spec (.of L)))
        (q + 1)) := by
    intro L _ _ hKL
    refine wc_et_gm_field_vanishing_of_norm_surj L ?_
    intro E _ _ hLE F _ _ _
    letI : Algebra X.functionField E :=
      ((algebraMap L E).comp (algebraMap X.functionField L)).toAlgebra
    haveI : IsScalarTower X.functionField L E := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI := hKL
    haveI := hLE
    exact wc_c1_norm_surjective E (wc_tsen_algebraic_c1 Ω X.functionField t ht E
      (Algebra.IsAlgebraic.trans X.functionField L E)) F
  have hj := wc_et_gm_generic_push_acyclic Ω X fX hnorm' hdim hL

  obtain ⟨ord, hord⟩ := wc_ord_construct Ω X fX hnorm' hdim
  obtain ⟨h₀, hS⟩ := wc_et_divisor_ses_short_exact Ω X fX hnorm' hdim ord hord
  obtain ⟨ρ, hρi, hρ⟩ := wc_et_aut_base_semilinear Ω X fX σ
  haveI := hρi
  obtain ⟨c₂, sq1, sq2⟩ := wc_et_div_can_squares Ω X fX hnorm' hdim ord hord σ ρ hρ
  haveI := wc_et_can_div_iso Ω X fX σ ρ hρ
  have hpt := wc_et_div_point_congr Ω X fX hnorm' hdim M hMΩ ord hord
  have hhom := wc_et_div_twist_hom_level Ω X fX M ord σ ρ hρ hpt
  have hE := wc_ext_twist_extClass (wcEtPush σ) hS
    (wcEtCanConst σ (AddCommGrpCat.of (ULift.{u+1} ℤ))) (wcEtCanGm σ) c₂
    (wcEtCanDiv Ω X fX σ ρ) sq1 sq2 0

  have hc0 : c.comp (Abelian.Ext.mk₀ (wcEtGmToAt X (genericPoint X))) (add_zero 1) = 0 :=
    @Subsingleton.elim _ (hj 0) _ 0
  obtain ⟨h, hh⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hS c hc0 (n₀ := 0) rfl
  subst hh
  have hhq : h = Abelian.Ext.mk₀ (Abelian.Ext.addEquiv₀ h) :=
    (Abelian.Ext.mk₀_addEquiv₀_apply h).symm
  generalize Abelian.Ext.addEquiv₀ h = q₀ at hhq
  subst hhq
  obtain ⟨d₀, m₀, hdm⟩ := hhom q₀
  have hq : wcEtCanConst σ (AddCommGrpCat.of (ULift.{u+1} ℤ)) ≫ (wcEtPush σ).map q₀ ≫
      inv (wcEtCanDiv Ω X fX σ ρ) = q₀ + M • d₀ +
        m₀ ≫ (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map ord := by
    rw [← Category.assoc, IsIso.comp_inv_eq]
    exact hdm
  have htw : wcExtTwist (wcEtPush σ) (wcEtCanConst σ (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      (wcEtCanDiv Ω X fX σ ρ) 0 (Abelian.Ext.mk₀ q₀) =
      Abelian.Ext.mk₀ (wcEtCanConst σ (AddCommGrpCat.of (ULift.{u+1} ℤ)) ≫
        (wcEtPush σ).map q₀ ≫ inv (wcEtCanDiv Ω X fX σ ρ)) := by
    simp only [wcExtTwist, Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀]
  have hns : ∀ (k : ℕ) (f : (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶
      (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (wcEtDivPre Ω X fX)),
      Abelian.Ext.mk₀ (k • f) = k • Abelian.Ext.mk₀ f := by
    intro k f
    induction k with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero]
    | succ k ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, ih]
  have hnc : ∀ (k : ℕ) (x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (wcEtDivPre Ω X fX)) 0),
      (k • x).comp hS.extClass (zero_add 1) = k • (x.comp hS.extClass (zero_add 1)) := by
    intro k x
    induction k with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.zero_comp]
    | succ k ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.add_comp, ih]
  have hm0 : (Abelian.Ext.mk₀ (m₀ ≫
      (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map ord)).comp
      hS.extClass (zero_add 1) = 0 := by
    have e0 : (Abelian.Ext.mk₀ ((presheafToSheaf (Scheme.smallEtaleTopology X)
        AddCommGrpCat.{u+1}).map ord)).comp hS.extClass (zero_add 1) = 0 := hS.comp_extClass
    have e1 : (Abelian.Ext.mk₀ m₀).comp ((Abelian.Ext.mk₀ ((presheafToSheaf
        (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map ord)).comp hS.extClass
        (zero_add 1)) (zero_add 1) = 0 := by
      rw [e0]
      exact Abelian.Ext.comp_zero _ _ _ _ _
    have e2 := Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ m₀)
      (Abelian.Ext.mk₀ ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map ord))
      hS.extClass (zero_add 0) (zero_add 1) (show 0 + 0 + 1 = 1 from rfl)
    rw [← Abelian.Ext.mk₀_comp_mk₀ m₀
      ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map ord)]
    exact e2.trans e1
  refine ⟨(Abelian.Ext.mk₀ d₀).comp hS.extClass (zero_add 1), ?_⟩
  refine (hE (Abelian.Ext.mk₀ q₀)).trans ?_
  rw [htw, hq, Abelian.Ext.mk₀_add, Abelian.Ext.mk₀_add, hns, Abelian.Ext.add_comp,
    Abelian.Ext.add_comp, hm0, hnc, add_zero]

theorem wc_pow_normal_curve_h2_aut_pull_trivial : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ε : Spec (.of Ω) ⟶ Spec (.of K)) (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IrreducibleSpace X], (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) → topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) → ∀ (M : ℕ), M ≠ 0 → (M : K) ≠ 0 → ∀ (τ : X ⟶ X) [IsIso τ] (ρ : Spec (.of Ω) ⟶ Spec (.of Ω)), τ ≫ fX = fX ≫ ρ → ρ ≫ ε = ε → ∀ (D : wcEtPullData τ M) (x : wcEtZModExt X M 2), wcEtPull D 2 x = x :=
by
  intro K _ _ Ω _ _ ε X fX _ hirr hnorm hdim M hM hMK τ _ ρ hτ hρ D y
  classical
  have hMΩ : (M : Ω) ≠ 0 := by
    intro h
    apply hMK
    apply (Spec.preimage ε).hom.injective
    rw [map_natCast, map_zero]
    exact h
  obtain ⟨ζ, hprim, hfix⟩ := wc_pow_aut_kummer_root_fixed K Ω ε X fX M hM hMK τ ρ hτ hρ
  have hfix' : (inv τ).appTop.hom (fX.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom ζ)) =
      fX.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom ζ) := by
    have h1 := congrArg (fun f : X ⟶ X =>
      f.appTop.hom (fX.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom ζ)))
      (IsIso.inv_hom_id τ)
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at h1
    rw [hfix] at h1
    rw [h1]
    simp
  obtain ⟨hAdd, hLim, hColim, hConst, hGm⟩ := wc_et_push_iso_exact_can (inv τ)
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
  haveI := hAdd
  haveI := hLim
  haveI := hColim
  haveI := hGm
  haveI hZ := hConst (AddCommGrpCat.of (ULift.{u+1} ℤ))
  haveI hμ := hConst (AddCommGrpCat.of (ULift.{u+1} (ZMod M)))
  obtain ⟨κ, hκ, h, hS⟩ := wc_et_kummer_ses_explicit Ω X fX M hMΩ ζ hprim
  have sq1 := wc_pow_kummer_can_compat X (inv τ) M _ hfix' κ hκ
  have sq2 : wcEtCanGm (inv τ) ≫ (wcEtPush (inv τ)).map (M • 𝟙 (wcEtGm X)) =
      (M • 𝟙 (wcEtGm X)) ≫ wcEtCanGm (inv τ) := by
    rw [Functor.map_nsmul, CategoryTheory.Functor.map_id, Preadditive.comp_nsmul,
      Preadditive.nsmul_comp, Category.comp_id, Category.id_comp]
  have hE := @wc_ext_twist_extClass _ _ _ _ (wcEtPush (inv τ)) _ _ _ _ hS _
    (wcEtCanConst (inv τ) (AddCommGrpCat.of (ULift.{u+1} ℤ)))
    (wcEtCanConst (inv τ) (AddCommGrpCat.of (ULift.{u+1} (ZMod M))))
    (wcEtCanGm (inv τ)) (wcEtCanGm (inv τ)) hμ hGm sq1 sq2 1
  obtain ⟨B, hBbij, hB⟩ := wc_pow_aut_pull_ext_bridge X M hM τ D 2
  have hV := wc_et_gm_tsen_vanishing Ω X fX hirr hnorm hdim 0
  have h0 : (B y).comp (Abelian.Ext.mk₀
      ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map κ)) (add_zero 2) = 0 :=
    @Subsingleton.elim _ hV _ _
  obtain ⟨c, hc⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hS (B y) h0 rfl
  obtain ⟨d, hd⟩ := wc_pow_normal_curve_gm_twist_mod Ω X fX hnorm hdim M hMΩ (inv τ) c
  have hA : ∀ (k : ℕ) (x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (wcEtGm X) 1),
      x.comp (Abelian.Ext.mk₀ (k • 𝟙 (wcEtGm X))) (add_zero 1) = k • x := by
    intro k x
    induction k with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    | succ k ih =>
      rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih,
        Abelian.Ext.comp_mk₀_id]
  have hMd : (M • d).comp hS.extClass rfl = 0 := by
    rw [← hA M d, Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (zero_add 1) (by omega)]
    have e : (Abelian.Ext.mk₀ (M • 𝟙 (wcEtGm X))).comp hS.extClass (zero_add 1) = 0 :=
      hS.comp_extClass
    rw [e, Abelian.Ext.comp_zero]
  apply hBbij.1
  rw [hB, ← hc]
  exact (hE c).trans (by rw [hd, Abelian.Ext.add_comp, hMd, add_zero])

theorem wc_pow_curve_h2_admissible_pull_rigid : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ε : Spec (.of Ω) ⟶ Spec (.of K)) (W : Scheme.{u}) (fW : W ⟶ Spec (.of Ω)) [IsProper fW] [IrreducibleSpace W] (M : ℕ), M ≠ 0 → (M : K) ≠ 0 → topologicalKrullDim W ≤ ((1 : ℕ) : WithBot ℕ∞) → ¬ topologicalKrullDim W ≤ ((0 : ℕ) : WithBot ℕ∞) → ∀ (W' : Scheme.{u}) (fW' : W' ⟶ Spec (.of Ω)) [IsProper fW'] (α β : W' ⟶ W) [IsIso α] [IsIso β] (ρα ρβ : Spec (.of Ω) ⟶ Spec (.of Ω)), α ≫ fW = fW' ≫ ρα → β ≫ fW = fW' ≫ ρβ → ρα ≫ ε = ε → ρβ ≫ ε = ε → ∀ (Dα : wcEtPullData α M) (Dβ : wcEtPullData β M) (x : wcEtZModExt W M 2), wcEtPull Dα 2 x = wcEtPull Dβ 2 x :=
by
  intro K _ _ Ω _ _ ε W fW _ _ M hM hMK hd1 hd0 W' fW' _ α β _ _ ρα ρβ hα hβ hρα hρβ Dα Dβ x
  classical

  have hMΩ : (M : Ω) ≠ 0 := by
    intro h
    apply hMK
    apply (Spec.preimage ε).hom.injective
    rw [map_natCast, map_zero]
    exact h

  have key : ∀ (τ : W ⟶ W) [IsIso τ] (ρ : Spec (.of Ω) ⟶ Spec (.of Ω)),
      τ ≫ fW = fW ≫ ρ → ρ ≫ ε = ε →
      ∀ (Dτ : wcEtPullData τ M) (y : wcEtZModExt W M 2), wcEtPull Dτ 2 y = y := by
    intro τ _ ρ hτ hρ Dτ y
    obtain ⟨R, r, X, b, Z, iZ, hr, hrr, hRirr, hR1, hR0, hb, hiZ, hZ0, hbU, hXirr, hXnorm,
      hX1, hlift⟩ := wc_pow_curve_normalization_lift Ω W fW hd1 hd0
    obtain ⟨τR, τX, hτR, hτX, hR, hX⟩ := hlift τ inferInstance
    haveI := hr
    haveI := hb
    haveI := hXirr
    haveI := hRirr
    haveI := hτX
    haveI := hiZ
    haveI : IsProper (r ≫ fW) := inferInstance
    haveI : IsProper (b ≫ r ≫ fW) := inferInstance
    have hτX' : τX ≫ (b ≫ r ≫ fW) = (b ≫ r ≫ fW) ≫ ρ := by
      simp only [Category.assoc]
      rw [reassoc_of% hX, reassoc_of% hR, hτ]
    have hcomm : τX ≫ (b ≫ r) = (b ≫ r) ≫ τ := by
      simp only [Category.assoc]
      rw [reassoc_of% hX, hR]
    have Dr : wcEtPullData r M := (wc_et_zmod_pull_data_exists r M).some
    have Db : wcEtPullData b M := (wc_et_zmod_pull_data_exists b M).some
    have Dπ : wcEtPullData (b ≫ r) M := (wc_et_zmod_pull_data_exists (b ≫ r) M).some
    have Dπτ : wcEtPullData ((b ≫ r) ≫ τ) M :=
      (wc_et_zmod_pull_data_exists ((b ≫ r) ≫ τ) M).some
    have DτX : wcEtPullData τX M := (wc_et_zmod_pull_data_exists τX M).some
    have e1 := wc_et_pull_comp τ (b ≫ r) ((b ≫ r) ≫ τ) rfl Dτ Dπ Dπτ 2 y
    have e2 := wc_et_pull_comp (b ≫ r) τX ((b ≫ r) ≫ τ) hcomm Dπ DτX Dπτ 2 y
    have e3 : ∀ z, wcEtPull Dπ 2 z = wcEtPull Db 2 (wcEtPull Dr 2 z) :=
      fun z => wc_et_pull_comp r b (b ≫ r) rfl Dr Db Dπ 2 z
    have h6 := wc_pow_normal_curve_h2_aut_pull_trivial K Ω ε X (b ≫ r ≫ fW) hXnorm hX1 M hM hMK
      τX ρ hτX' hρ DτX (wcEtPull Dπ 2 y)
    have hinjb := wc_pow_curve_h2_birational_finite_pull_injective Ω R (r ≫ fW) hR1 hR0 X b Z iZ
      hb hiZ hZ0 hbU M hM hMΩ Db
    have hinjr := wc_et_pull_surj_closed_immersion_injective r hrr M Dr 2
    apply hinjr
    apply hinjb
    rw [← e3, ← e3, ← e1, e2, h6]

  haveI : Nonempty W' := ⟨(inv β) (Classical.arbitrary W)⟩
  haveI : IsIso ρβ := wc_semilinear_iso_base_iso Ω W W' fW fW' β ρβ hβ
  have h1 : inv β ≫ fW' = fW ≫ inv ρβ := by
    rw [IsIso.eq_comp_inv, Category.assoc, ← hβ, IsIso.inv_hom_id_assoc]
  have hτ : (inv β ≫ α) ≫ fW = fW ≫ (inv ρβ ≫ ρα) := by
    simp only [Category.assoc]
    rw [hα, reassoc_of% h1]
  have hρ : (inv ρβ ≫ ρα) ≫ ε = ε := by
    rw [Category.assoc, hρα, IsIso.inv_comp_eq]
    exact hρβ.symm
  have hβτ : β ≫ (inv β ≫ α) = α := IsIso.hom_inv_id_assoc β α
  have Dτ : wcEtPullData (inv β ≫ α) M := (wc_et_zmod_pull_data_exists (inv β ≫ α) M).some
  have e0 := wc_et_pull_comp (inv β ≫ α) β α hβτ Dτ Dβ Dα 2 x
  rw [e0, key (inv β ≫ α) (inv ρβ ≫ ρα) hτ hρ Dτ x]

theorem wc_pow_component_subscheme_transport : ∀ (C : Scheme.{u}) (σ : C ⟶ C) [IsIso σ] (Z : Set C), Z ∈ irreducibleComponents C → ⇑σ '' Z ∈ irreducibleComponents C ∧ (¬ topologicalKrullDim ↥Z ≤ ((0 : ℕ) : WithBot ℕ∞) → ¬ topologicalKrullDim ↥(⇑σ '' Z) ≤ ((0 : ℕ) : WithBot ℕ∞)) ∧ ∃ σZ : (Scheme.IdealSheafData.vanishingIdeal (⟨closure Z, isClosed_closure⟩ : TopologicalSpace.Closeds C)).subscheme ⟶ (Scheme.IdealSheafData.vanishingIdeal (⟨closure (⇑σ '' Z), isClosed_closure⟩ : TopologicalSpace.Closeds C)).subscheme, IsIso σZ ∧ σZ ≫ (Scheme.IdealSheafData.vanishingIdeal (⟨closure (⇑σ '' Z), isClosed_closure⟩ : TopologicalSpace.Closeds C)).subschemeι = (Scheme.IdealSheafData.vanishingIdeal (⟨closure Z, isClosed_closure⟩ : TopologicalSpace.Closeds C)).subschemeι ≫ σ :=
by
  intro C σ _ Z hZ
  have hcoe : ⇑(Scheme.Hom.homeomorph σ) = ⇑σ := funext (Scheme.Hom.homeomorph_apply σ)
  have hker : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (W : Set X),
      Scheme.Hom.ker ((Scheme.IdealSheafData.vanishingIdeal
        (⟨closure W, isClosed_closure⟩ : TopologicalSpace.Closeds X)).subschemeι ≫ f) =
      Scheme.IdealSheafData.vanishingIdeal
        (⟨closure (⇑f '' W), isClosed_closure⟩ : TopologicalSpace.Closeds Y) := by
    intro X Y f W
    rw [← Scheme.IdealSheafData.map_ker, Scheme.IdealSheafData.ker_subschemeι,
      Scheme.IdealSheafData.map_vanishingIdeal]
    congr 1
    apply TopologicalSpace.Closeds.ext
    rw [TopologicalSpace.Closeds.coe_closure]
    exact closure_image_closure f.continuous
  refine ⟨?_, ?_, ?_⟩
  · refine image_mem_irreducibleComponents_of_isPreirreducible_fiber ⇑σ σ.continuous ?_ ?_ ?_ hZ
    · rw [← hcoe]; exact (Scheme.Hom.homeomorph σ).isOpenMap
    · intro y
      apply Set.Subsingleton.isPreirreducible
      intro a ha b hb
      apply (Scheme.Hom.homeomorph σ).injective
      simp only [Set.mem_preimage, Set.mem_singleton_iff] at ha hb
      rw [hcoe, ha, hb]
    · rw [← hcoe]; exact (Scheme.Hom.homeomorph σ).surjective
  · intro h hle
    apply h
    have hd := IsHomeomorph.topologicalKrullDim_eq _
      (Homeomorph.image (Scheme.Hom.homeomorph σ) Z).isHomeomorph
    rw [← hcoe] at hle
    rw [hd]
    exact hle
  · have himg : ⇑(inv σ) '' (⇑σ '' Z) = Z := by
      rw [Set.image_image]
      conv_rhs => rw [← Set.image_id Z]
      apply Set.image_congr
      intro x _
      rw [← Scheme.Hom.comp_apply, IsIso.hom_inv_id]
      rfl
    have h1 := hker σ Z
    have h2 := hker (inv σ) (⇑σ '' Z)
    rw [himg] at h2
    have H1 : Scheme.Hom.ker (Scheme.IdealSheafData.vanishingIdeal
        (⟨closure (⇑σ '' Z), isClosed_closure⟩ : TopologicalSpace.Closeds C)).subschemeι ≤
        Scheme.Hom.ker ((Scheme.IdealSheafData.vanishingIdeal
        (⟨closure Z, isClosed_closure⟩ : TopologicalSpace.Closeds C)).subschemeι ≫ σ) := by
      rw [Scheme.IdealSheafData.ker_subschemeι, h1]
    have H2 : Scheme.Hom.ker (Scheme.IdealSheafData.vanishingIdeal
        (⟨closure Z, isClosed_closure⟩ : TopologicalSpace.Closeds C)).subschemeι ≤
        Scheme.Hom.ker ((Scheme.IdealSheafData.vanishingIdeal
        (⟨closure (⇑σ '' Z), isClosed_closure⟩ : TopologicalSpace.Closeds C)).subschemeι ≫ inv σ) := by
      rw [Scheme.IdealSheafData.ker_subschemeι, h2]
    have hφ := IsClosedImmersion.lift_fac _ _ H1
    have hψ := IsClosedImmersion.lift_fac _ _ H2
    refine ⟨IsClosedImmersion.lift _ _ H1, ⟨⟨IsClosedImmersion.lift _ _ H2, ?_, ?_⟩⟩, hφ⟩
    · rw [← cancel_mono (Scheme.IdealSheafData.vanishingIdeal
        (⟨closure Z, isClosed_closure⟩ : TopologicalSpace.Closeds C)).subschemeι,
        Category.assoc, hψ, reassoc_of% hφ, IsIso.hom_inv_id, Category.comp_id, Category.id_comp]
    · rw [← cancel_mono (Scheme.IdealSheafData.vanishingIdeal
        (⟨closure (⇑σ '' Z), isClosed_closure⟩ : TopologicalSpace.Closeds C)).subschemeι,
        Category.assoc, hφ, reassoc_of% hψ, IsIso.inv_hom_id, Category.comp_id, Category.id_comp]

theorem wc_coherent_zmod_trivialization : ∀ (I : Type u) (H : I → Type v) [∀ i, AddCommGroup (H i)] (M : ℕ), (∀ i, Nonempty (H i ≃+ ZMod M)) → ∀ (T : ∀ i j : I, Set (H j →+ H i)), (∀ i j k, ∀ t ∈ T i j, ∀ s ∈ T j k, t.comp s ∈ T i k) → (∀ i j, ∀ t ∈ T i j, Function.Injective t) → (∀ i j, ∀ t ∈ T i j, ∀ t' ∈ T i j, t = t') → (∀ i j, (T i j).Nonempty → (T j i).Nonempty) → ∃ φ : ∀ i, H i →+ ZMod M, (∀ i, Function.Bijective (φ i)) ∧ ∀ i j, ∀ t ∈ T i j, (φ i).comp t = φ j :=
by
  classical
  intro I H _ M hH T hcomp hinj hrig hsym
  have hid : ∀ a, ∀ u ∈ T a a, ∀ x, u x = x := by
    intro a u hu x
    have h2 : u.comp u = u := hrig a a _ (hcomp a a a u hu u hu) u hu
    apply hinj a a u hu
    have h3 := DFunLike.congr_fun h2 x
    simpa using h3
  have hbij : ∀ i j, ∀ t ∈ T i j, Function.Bijective t := by
    intro i j t ht
    obtain ⟨σ, hσ⟩ := hsym i j ⟨t, ht⟩
    refine ⟨hinj i j t ht, fun y => ⟨σ y, ?_⟩⟩
    have h3 := hid i (t.comp σ) (hcomp i j i t ht σ hσ) y
    simpa using h3
  obtain ⟨rep, hrep, hsame⟩ : ∃ rep : I → I, (∀ j, rep j = j ∨ (T (rep j) j).Nonempty) ∧
      ∀ i j, (T i j).Nonempty → rep i = rep j := by
    let S : Setoid I := ⟨fun a b => a = b ∨ (T a b).Nonempty,
      ⟨fun _ => Or.inl rfl,
       fun {a b} h => h.elim (fun hab => Or.inl hab.symm) (fun hn => Or.inr (hsym a b hn)),
       fun {a b c} h1 h2 => by
        rcases h1 with rfl | ⟨t, ht⟩ <;> rcases h2 with rfl | ⟨s, hs⟩
        · exact Or.inl rfl
        · exact Or.inr ⟨s, hs⟩
        · exact Or.inr ⟨t, ht⟩
        · exact Or.inr ⟨t.comp s, hcomp _ _ _ t ht s hs⟩⟩⟩
    refine ⟨fun j => (Quotient.mk S j).out, fun j => Quotient.mk_out (s := S) j, fun i j h => ?_⟩
    exact congrArg Quotient.out (Quotient.sound (s := S) (Or.inr h))
  have e : ∀ i, H i ≃+ ZMod M := fun i => (hH i).some
  obtain ⟨φ, hφ1, hφ2⟩ : ∃ φ : ∀ i, H i →+ ZMod M,
      (∀ k, ∀ τ ∈ T (rep k) k, φ k = (e (rep k)).toAddMonoidHom.comp τ) ∧
      (∀ k, ¬ (T (rep k) k).Nonempty → φ k = (e k).toAddMonoidHom) := by
    refine ⟨fun k => if h : (T (rep k) k).Nonempty then (e (rep k)).toAddMonoidHom.comp h.some
        else (e k).toAddMonoidHom, fun k τ hτ => ?_, fun k h => ?_⟩
    · have h : (T (rep k) k).Nonempty := ⟨τ, hτ⟩
      simp only [dif_pos h]
      rw [hrig _ _ _ h.some_mem τ hτ]
    · simp only [dif_neg h]
  refine ⟨φ, fun k => ?_, ?_⟩
  · by_cases h : (T (rep k) k).Nonempty
    · obtain ⟨τ, hτ⟩ := h
      rw [hφ1 k τ hτ, AddMonoidHom.coe_comp]
      exact (e (rep k)).bijective.comp (hbij _ _ τ hτ)
    · rw [hφ2 k h]
      exact (e k).bijective
  · intro i j t ht
    have hr : rep i = rep j := hsame i j ⟨t, ht⟩
    obtain ⟨σ, hσ⟩ := hsym i j ⟨t, ht⟩
    have key : ∀ r k, rep k = r → ∀ τ ∈ T r k, φ k = (e r).toAddMonoidHom.comp τ := by
      intro r k hrk τ hτ
      subst hrk
      exact hφ1 k τ hτ
    obtain ⟨τj, hτj⟩ : (T (rep j) j).Nonempty := by
      rcases hrep j with h | h
      · rw [h]; exact ⟨σ.comp t, hcomp j i j σ hσ t ht⟩
      · exact h
    obtain ⟨τi, hτi⟩ : (T (rep j) i).Nonempty := by
      rcases hrep i with h | h
      · rw [← hr, h]; exact ⟨t.comp σ, hcomp i j i t ht σ hσ⟩
      · rw [← hr]; exact h
    rw [key (rep j) i hr τi hτi, key (rep j) j rfl τj hτj, AddMonoidHom.comp_assoc,
      hrig _ _ _ (hcomp _ i j τi hτi t ht) τj hτj]

theorem wc_zmod_equiv_of_ptorsion_le : ∀ (G : Type v) [AddCommGroup G] [Finite G] (M : ℕ), Nat.card G = M → (∀ p : ℕ, p.Prime → p ∣ M → Nat.card {x : G // p • x = 0} ≤ p) → Nonempty (G ≃+ ZMod M) :=
by
  intro G _ _ M hM hp
  subst hM
  classical
  haveI : Fintype G := Fintype.ofFinite G
  have hprime : ∀ p : ℕ, p.Prime → (Finset.univ.filter (fun x : G => p • x = 0)).card ≤ p := by
    intro p hpp
    by_cases hd : p ∣ Nat.card G
    · have := hp p hpp hd
      rw [Nat.card_eq_fintype_card, Fintype.card_subtype] at this
      exact this
    · have hsub : (Finset.univ.filter (fun x : G => p • x = 0)) ⊆ {0} := by
        intro x hx
        simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hx
        have h1 : addOrderOf x ∣ p := addOrderOf_dvd_of_nsmul_eq_zero hx
        rcases hpp.eq_one_or_self_of_dvd _ h1 with h | h
        · simp [AddMonoid.addOrderOf_eq_one_iff.mp h]
        · exact absurd (h ▸ addOrderOf_dvd_natCard x) hd
      calc _ ≤ ({0} : Finset G).card := Finset.card_le_card hsub
        _ = 1 := Finset.card_singleton _
        _ ≤ p := hpp.one_lt.le
  have hall : ∀ n : ℕ, 0 < n → (Finset.univ.filter (fun x : G => n • x = 0)).card ≤ n := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      intro hn
      by_cases h1 : n = 1
      · subst h1
        calc _ ≤ ({0} : Finset G).card := Finset.card_le_card (by
              intro x hx
              simp only [Finset.mem_filter, Finset.mem_univ, true_and, one_nsmul] at hx
              simp [hx])
          _ = 1 := Finset.card_singleton _
      · obtain ⟨p, hpp, hpn⟩ := Nat.exists_prime_and_dvd h1
        obtain ⟨n', rfl⟩ := hpn
        have hn' : 0 < n' := Nat.pos_of_ne_zero (by rintro rfl; simp at hn)
        have hlt : n' < p * n' := by
          have := hpp.two_le
          nlinarith
        have ih' := ih n' hlt hn'
        have key : (Finset.univ.filter (fun x : G => (p * n') • x = 0)).card ≤
            p * (Finset.univ.filter (fun x : G => n' • x = 0)).card := by
          apply Finset.card_le_mul_card_image_of_maps_to (f := fun a => p • a)
          · intro a ha
            simp only [Finset.mem_filter, Finset.mem_univ, true_and] at ha ⊢
            rw [smul_smul, mul_comm]
            exact ha
          · intro b _
            by_cases hne : ({a ∈ Finset.univ.filter (fun x : G => (p * n') • x = 0) |
                p • a = b}).Nonempty
            · obtain ⟨a₀, ha₀⟩ := hne
              simp only [Finset.mem_filter, Finset.mem_univ, true_and] at ha₀
              calc _ ≤ (Finset.univ.filter (fun x : G => p • x = 0)).card := by
                    apply Finset.card_le_card_of_injOn (fun a => a - a₀)
                    · intro a ha
                      simp only [Finset.coe_filter, Finset.mem_filter, Finset.mem_univ,
                        true_and, Set.mem_setOf_eq] at ha ⊢
                      rw [nsmul_sub, ha.2, ha₀.2, sub_self]
                    · intro a _ c _ hac
                      exact sub_left_injective hac
                _ ≤ p := hprime p hpp
            · rw [Finset.not_nonempty_iff_eq_empty.mp hne, Finset.card_empty]
              exact Nat.zero_le _
        calc _ ≤ _ := key
          _ ≤ p * n' := Nat.mul_le_mul_left _ ih'
  exact ⟨(zmodAddCyclicAddEquiv (isAddCyclic_of_card_nsmul_eq_zero_le hall)).symm⟩

