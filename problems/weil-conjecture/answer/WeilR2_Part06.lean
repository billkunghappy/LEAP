  refine ⟨E.liftOfRightInverse σ hσ ⟨ev.comp Ψ, hk⟩, ?_⟩
  intro c hc
  refine ⟨(((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).liftCycles
