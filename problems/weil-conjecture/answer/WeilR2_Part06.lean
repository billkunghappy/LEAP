    have hpre : ((wcEtBaseChange π).map g).left ⁻¹' Set.range (wcR2Graph π V e heπ (𝟙 V)) =
        Set.range (wcR2Graph π V e heπ g) := by
      have := (wc_r2gc_graph_basic π V e he heπ V T (𝟙 V) g).2.2.2
      rwa [Category.comp_id] at this
    have hmap : ∀ y, ((wcEtExtZero B'' (Set.range iZ)ᶜ M).obj.map h.op).hom
        (((wcEtExtZero B'' (Set.range iZ)ᶜ M).obj.map ((wcEtBaseChange π).map g).op).hom y) =
        ((wcEtExtZero B'' (Set.range iZ)ᶜ M).obj.map (h ≫ (wcEtBaseChange π).map g).op).hom y := by
      intro y
      rw [op_comp, Functor.map_comp]
      rfl
    have hrng : ∀ (D : Set ((wcEtBaseChange π).obj V).left),
        Set.range h.left ⊆ ((wcEtBaseChange π).map g).left ⁻¹' D →
        Set.range (h ≫ (wcEtBaseChange π).map g).left ⊆ D := by
      rintro D hD _ ⟨x, rfl⟩
      exact hD ⟨x, rfl⟩
    refine ⟨fun hsub => ?_, fun hsub => ?_⟩
    · rw [← hpre] at hsub
      obtain ⟨y, hy1, hy2⟩ := hγ1 W _ (hrng _ hsub)
      exact ⟨y, hy1, (hmap γ0).trans hy2⟩
    · rw [← hpre, ← Set.preimage_compl] at hsub
      rw [hmap γ0]
      exact hγ2 W _ (hrng _ hsub)

  let Q : (B.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
    (wcEtBaseChange π).op ⋙ (wcEtExtZero B'' (Set.range iZ)ᶜ M).obj
  let G := (wcEtPush π).obj (wcEtExtZero B'' (Set.range iZ)ᶜ M)
  let σ : G.obj.obj (Opposite.op V) :=
    ((toSheafify (Scheme.smallEtaleTopology B) Q).app (Opposite.op V)).hom γ0

  have hJpre : M • 𝟙 (wcEtExtZeroPre B'' (Set.range iZ)ᶜ M) = 0 := by
    have h : ∀ a : ULift.{u+1} (ZMod M), M • a = 0 := fun a => by
      apply ULift.ext
      simp [nsmul_eq_mul]
    ext W x
    apply Subtype.ext
    simp
    try exact h _
  have hJtors : M • 𝟙 (wcEtExtZero B'' (Set.range iZ)ᶜ M) = 0 := by
    show M • 𝟙 ((presheafToSheaf (Scheme.smallEtaleTopology B'') AddCommGrpCat.{u+1}).obj
      (wcEtExtZeroPre B'' (Set.range iZ)ᶜ M)) = 0
    rw [← CategoryTheory.Functor.map_id, ← CategoryTheory.Functor.map_nsmul, hJpre,
      CategoryTheory.Functor.map_zero]
  have hGtors : M • 𝟙 G = 0 := by
    show M • 𝟙 ((wcEtPush π).obj (wcEtExtZero B'' (Set.range iZ)ᶜ M)) = 0
    rw [← CategoryTheory.Functor.map_id, ← CategoryTheory.Functor.map_nsmul, hJtors,
      CategoryTheory.Functor.map_zero]
  have htorsG : ∀ (T : B.Etale) (z : G.obj.obj (Opposite.op T)), M • z = 0 := by
    intro T z
    have h1 : (sheafToPresheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).map
        (M • 𝟙 G) = 0 := by rw [hGtors, Functor.map_zero]
    rw [Functor.map_nsmul, CategoryTheory.Functor.map_id] at h1
    have h2 := congrArg (fun f => (f.app (Opposite.op T)).hom z) h1
    simpa using h2

  have hFreeNT : ∀ T : B.Etale, (wcR2FreeMap V G.obj σ).app (Opposite.op T) =
      (wcR2FreeMap V Q γ0).app (Opposite.op T) ≫
        (toSheafify (Scheme.smallEtaleTopology B) Q).app (Opposite.op T) := by
    intro T
    apply AddCommGrpCat.hom_ext
    apply FreeAbelianGroup.lift_ext
    intro g
    have h1 : ((wcR2FreeMap V G.obj σ).app (Opposite.op T)).hom (FreeAbelianGroup.of g) =
        (G.obj.map g.down.op).hom σ :=
      FreeAbelianGroup.lift_apply_of (fun g : ULift.{u+1} (T ⟶ V) => (G.obj.map g.down.op).hom σ) g
    have h2 : ((wcR2FreeMap V Q γ0).app (Opposite.op T)).hom (FreeAbelianGroup.of g) =
        (Q.map g.down.op).hom γ0 :=
      FreeAbelianGroup.lift_apply_of (fun g : ULift.{u+1} (T ⟶ V) => (Q.map g.down.op).hom γ0) g
    change ((wcR2FreeMap V G.obj σ).app (Opposite.op T)).hom (FreeAbelianGroup.of g) =
      ((toSheafify (Scheme.smallEtaleTopology B) Q).app (Opposite.op T)).hom
        (((wcR2FreeMap V Q γ0).app (Opposite.op T)).hom (FreeAbelianGroup.of g))
    rw [h1, h2]
    exact (NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology B) Q) g.down.op γ0).symm
  have hFree : ∀ (T : B.Etale) (r : (wcFTKU V).obj (Opposite.op T)),
      ((wcR2FreeMap V G.obj σ).app (Opposite.op T)).hom r =
      ((toSheafify (Scheme.smallEtaleTopology B) Q).app (Opposite.op T)).hom
        (((wcR2FreeMap V Q γ0).app (Opposite.op T)).hom r) := by
    intro T r
    rw [hFreeNT T]
    rfl

  have hloc : ∀ (T : B.Etale) (s : G.obj.obj (Opposite.op T)) (t : T.left),
      ∃ (T' : B.Etale) (c : T' ⟶ T) (t' : T'.left) (r : (wcFTKU V).obj (Opposite.op T')),
        c.left t' = t ∧ ((wcR2FreeMap V G.obj σ).app (Opposite.op T')).hom r = (G.obj.map c.op).hom s := by
    intro T s t
    obtain ⟨T₁, c₁, t₁, ⟨q₁, hq₁⟩, ht₁⟩ := hcov T _
      (Presheaf.imageSieve_mem (Scheme.smallEtaleTopology B)
        (toSheafify (Scheme.smallEtaleTopology B) Q) (U := Opposite.op T) s) t
    have hq₁' : ((toSheafify (Scheme.smallEtaleTopology B) Q).app (Opposite.op T₁)).hom q₁ =
        (G.obj.map c₁.op).hom s := hq₁
    obtain ⟨T₂, c₂, t₂, r, ht₂, hr⟩ :=
      wc_r2gc_local_surj π V e he heπ (Set.range iZ)ᶜ hrange M γ0 hγ T₁ q₁ t₁
    refine ⟨T₂, c₂ ≫ c₁, t₂, r, ?_, ?_⟩
    · change c₁.left (c₂.left t₂) = t
      rw [ht₂, ht₁]
    · calc ((wcR2FreeMap V G.obj σ).app (Opposite.op T₂)).hom r
          = ((toSheafify (Scheme.smallEtaleTopology B) Q).app (Opposite.op T₂)).hom
              ((Q.map c₂.op).hom q₁) := by rw [hFree, hr]
        _ = (G.obj.map c₂.op).hom
              (((toSheafify (Scheme.smallEtaleTopology B) Q).app (Opposite.op T₁)).hom q₁) :=
            NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology B) Q) c₂.op q₁
        _ = (G.obj.map c₂.op).hom ((G.obj.map c₁.op).hom s) := by rw [hq₁']
        _ = (G.obj.map (c₂ ≫ c₁).op).hom s := by rw [op_comp, Functor.map_comp]; rfl

  have hcof : IsCofiltered (StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) :=
    wc_et_geomstalk_cofiltered B b @wc_etale_maps_agree_near_geom_point
  obtain ⟨hrep, -, -⟩ := wc_et_stalk_germ_facts B b hcof G
  let germ : ∀ A : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B),
      G.obj.obj (Opposite.op A.right) →+ (wcEtStalk B b).obj G := fun A =>
    (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b))
      (Scheme.Etale.forget B)).op ⋙ G.obj) (Opposite.op A)).hom
  let γ : {t : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ V.left // t ≫ V.hom = wcEtGeomPt B b} →
      (wcEtStalk B b).obj G := fun w =>
    germ (StructuredArrow.mk (Over.homMk w.1 w.2 :
      Over.mk (wcEtGeomPt B b) ⟶ (Scheme.Etale.forget B).obj V)) σ
  have hgen : AddSubgroup.closure (Set.range γ) = ⊤ := by
    rw [eq_top_iff]
    intro x _
    obtain ⟨A, s, rfl⟩ := hrep x
    show germ A s ∈ AddSubgroup.closure (Set.range γ)
    have ha : A.hom.left ≫ A.right.hom = wcEtGeomPt B b := Over.w A.hom
    obtain ⟨T', c, t', r, hct, hr⟩ :=
      hloc A.right s (A.hom.left (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b))))
    have hEt : Etale c.left := by
      have hw : c.left ≫ A.right.hom = T'.hom := MorphismProperty.Over.w c
      have h1 : Etale A.right.hom := A.right.prop
      have h2 : Etale (c.left ≫ A.right.hom) := by rw [hw]; exact T'.prop
      exact Etale.of_comp c.left A.right.hom
    obtain ⟨a', ha', -⟩ :=
      wc_etale_lift_alg_closed_point (AlgebraicClosure (B.residueField b)) c.left A.hom.left t' hct
    have h' : a' ≫ T'.hom = wcEtGeomPt B b := by
      rw [← MorphismProperty.Over.w c, ← Category.assoc, ha']
      exact ha
    let A' : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B) :=
      StructuredArrow.mk (Over.homMk a' h' : Over.mk (wcEtGeomPt B b) ⟶ (Scheme.Etale.forget B).obj T')
    let f : A' ⟶ A := StructuredArrow.homMk c (Over.OverMorphism.ext ha')
    have hmove : germ A s = germ A' ((G.obj.map c.op).hom s) := by
      have hw := Limits.colimit.w ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b))
        (Scheme.Etale.forget B)).op ⋙ G.obj) f.op
      exact (congrArg (fun φ => φ.hom s) hw).symm
    rw [hmove, ← hr]
    clear hr
    let Ψ : FreeAbelianGroup (ULift.{u+1} (T' ⟶ V)) →+ (wcEtStalk B b).obj G :=
      AddMonoidHom.comp (germ A') ((wcR2FreeMap V G.obj σ).app (Opposite.op T')).hom
    have key2 : ∀ r : FreeAbelianGroup (ULift.{u+1} (T' ⟶ V)),
        r ∈ (AddSubgroup.closure (Set.range γ)).comap Ψ := by
      intro r
      induction r using FreeAbelianGroup.induction_on with
      | zero => exact zero_mem _
      | of g =>
        show germ A' (((wcR2FreeMap V G.obj σ).app (Opposite.op T')).hom (FreeAbelianGroup.of g)) ∈
          AddSubgroup.closure (Set.range γ)
        have h1 : ((wcR2FreeMap V G.obj σ).app (Opposite.op T')).hom (FreeAbelianGroup.of g) =
            (G.obj.map g.down.op).hom σ :=
          FreeAbelianGroup.lift_apply_of (fun g : ULift.{u+1} (T' ⟶ V) => (G.obj.map g.down.op).hom σ) g
        rw [h1]
        have hw : (a' ≫ g.down.left) ≫ V.hom = wcEtGeomPt B b := by
          rw [Category.assoc, MorphismProperty.Over.w g.down]
          exact h'
        let k : A' ⟶ StructuredArrow.mk (Over.homMk (a' ≫ g.down.left) hw :
            Over.mk (wcEtGeomPt B b) ⟶ (Scheme.Etale.forget B).obj V) :=
          StructuredArrow.homMk g.down (Over.OverMorphism.ext rfl)
        have hk := Limits.colimit.w ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b))
          (Scheme.Etale.forget B)).op ⋙ G.obj) k.op
        have hgk : germ A' ((G.obj.map g.down.op).hom σ) = γ ⟨a' ≫ g.down.left, hw⟩ :=
          congrArg (fun φ => φ.hom σ) hk
        rw [hgk]
        exact AddSubgroup.subset_closure ⟨_, rfl⟩
      | neg g ih => exact neg_mem ih
      | add x y hx hy => exact add_mem hx hy
    exact key2 r

  have hγtors : ∀ w, M • γ w = 0 := by
    intro w
    let X : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B) :=
      StructuredArrow.mk (Over.homMk w.1 w.2 :
        Over.mk (wcEtGeomPt B b) ⟶ (Scheme.Etale.forget B).obj V)
    calc M • γ w = germ X (M • σ) := (map_nsmul (germ X) M σ).symm
      _ = germ X 0 := congrArg (germ X) (htorsG V σ)
      _ = 0 := map_zero _

  have hLfin : Finite {t : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ V.left //
      t ≫ V.hom = wcEtGeomPt B b} := by
    haveI := wc_finite_geom_fibre_finite π (AlgebraicClosure (B.residueField b)) (wcEtGeomPt B b)
    refine Finite.of_injective
      (β := {yb : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ B'' // yb ≫ π = wcEtGeomPt B b})
      (fun w => ⟨w.1 ≫ e, by rw [Category.assoc, heπ, w.2]⟩) ?_
    intro w w' hww
    apply Subtype.ext
    have h2 : w.1 ≫ e = w'.1 ≫ e := congrArg Subtype.val hww
    exact (cancel_mono e).mp h2
  haveI := hLfin
  exact key _ _ M hM γ hγtors hgen

theorem wc_r2gi_stalk_card_const : ∀ (K : Type u) [Field K] [IsAlgClosed K] (X B : Scheme.{u}) (fB : B ⟶ Spec (.of K)) [IsProper fB] (g : X ⟶ B) [IsProper g] (M : ℕ), M ≠ 0 → (M : K) ≠ 0 → (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ B), topologicalKrullDim ↥(Limits.pullback g t) ≤ ((1 : ℕ) : WithBot ℕ∞)) → ∀ (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod M))))), (∀ b : B, Finite ((wcEtStalk B b).obj ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 2))) ∧ ∀ η : B, ∃ W : Set B, IsOpen W ∧ η ∈ W ∧ ∀ y ∈ W, η ⤳ y → Nat.card ((wcEtStalk B y).obj ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 2)) = Nat.card ((wcEtStalk B η).obj ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 2)) :=
by
  intro K _ _ X B fB _ g _ M hM hMK hfib I
  classical

  have hMΩ : ∀ (S : Scheme.{u}) (fS : S ⟶ Spec (.of K)) (y : S),
      (M : AlgebraicClosure (S.residueField y)) ≠ 0 := by
    intro S fS y
    let ψ : K →+* AlgebraicClosure (S.residueField y) :=
      (algebraMap (S.residueField y) (AlgebraicClosure (S.residueField y))).comp
        ((S.evaluation ⊤ y trivial).hom.comp
          (fS.appTop.hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom))
    rw [← map_natCast ψ M]
    exact (map_ne_zero ψ).mpr hMK

  have hcurve : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω], (M : Ω) ≠ 0 →
      ∀ (C : Scheme.{u}) (fC : C ⟶ Spec (.of Ω)) [IsProper fC],
      topologicalKrullDim C ≤ ((1 : ℕ) : WithBot ℕ∞) →
      Nat.card (wcEtCoh C M 2) = M ^ Set.ncard {x : C | ¬ IsClosed ({x} : Set C)} := by
    intro Ω _ _ hMΩ' C fC _ hC
    have hnorm : ∀ (X₁ : Scheme.{u}) (fX₁ : X₁ ⟶ Spec (.of Ω)) [IsProper fX₁],
        IrreducibleSpace X₁ → (∀ x : X₁, IsDomain (X₁.presheaf.stalk x) ∧
          IsIntegrallyClosed (X₁.presheaf.stalk x)) →
        topologicalKrullDim X₁ = ((1 : ℕ) : WithBot ℕ∞) → Nat.card (wcEtCoh X₁ M 2) = M := by
      apply wc_et_normal_curve_h2_card_gen Ω M hMΩ'
      · intro Y fY
        exact wc_et_kummer_ses_gen Ω Y fY M hMΩ'
      · intro Y fY _ _ hn hd U _ hU hf ord ho
        exact wc_curve_divisor_degree_point_congr_gen Ω Y fY hn hd U hU hf M hMΩ' ord ho
    exact wc_et_curve_h2_card_reduction_gen Ω M hM hMΩ' wc_et_henselian_proper_vanishing
      hnorm C fC hC

  have hInt : ∀ (S X' : Scheme.{u}) (fS : S ⟶ Spec (.of K)) [IsProper fS] [IsIntegral S]
      (g' : X' ⟶ S) [IsProper g'], (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (t : Spec (.of Ω) ⟶ S), topologicalKrullDim ↥(Limits.pullback g' t) ≤
          ((1 : ℕ) : WithBot ℕ∞)) →
      ∃ W : Set S, IsOpen W ∧ genericPoint S ∈ W ∧ ∀ y ∈ W,
        Nat.card (wcEtCoh (Limits.pullback g' (wcEtGeomPt S y)) M 2) =
          Nat.card (wcEtCoh (Limits.pullback g' (wcEtGeomPt S (genericPoint S))) M 2) := by
    intro S X' fS _ _ g' _ hdim'
    obtain ⟨W, hWo, hηW, hW⟩ := wc_fibre_curve_components_generic_const K S X' fS g' hdim'
    refine ⟨W, hWo, hηW, fun y hy => ?_⟩
    rw [hcurve _ (hMΩ S fS y) (Limits.pullback g' (wcEtGeomPt S y))
        (Limits.pullback.snd g' (wcEtGeomPt S y)) (hdim' _ _),
      hcurve _ (hMΩ S fS (genericPoint S)) (Limits.pullback g' (wcEtGeomPt S (genericPoint S)))
        (Limits.pullback.snd g' (wcEtGeomPt S (genericPoint S))) (hdim' _ _),
      hW y hy]

  have hR := wc_et_fibre_card_reduce_to_integral K X B fB g M 2
    (fun i _ m q => wc_et_coh_iso_invariance i m q) wc_closed_immersion_geomPt_compat
    wc_reduced_subscheme_exists hfib hInt

  refine ⟨fun b => ?_, fun η => ?_⟩
  · obtain ⟨e⟩ := wc_et_proper_stalk_coh g M hM wc_et_henselian_proper_vanishing I b 2
    haveI := wc_etale_proper_finite (AlgebraicClosure (B.residueField b))
      (Limits.pullback g (wcEtGeomPt B b)) (Limits.pullback.snd g (wcEtGeomPt B b)) M
      (hMΩ B fB b) 2
    exact Finite.of_equiv _ e.symm
  · obtain ⟨W, hWo, hηW, hW⟩ := hR η
    refine ⟨W, hWo, hηW, fun y hy hηy => ?_⟩
    obtain ⟨ey⟩ := wc_et_proper_stalk_coh g M hM wc_et_henselian_proper_vanishing I y 2
    obtain ⟨eη⟩ := wc_et_proper_stalk_coh g M hM wc_et_henselian_proper_vanishing I η 2
    rw [Nat.card_congr ey, Nat.card_congr eη]
    exact hW y hy hηy

theorem wc_et_spread_stalk_surj_of_card_const : ∀ (B : Scheme.{u}) [IsNoetherian B] (F G : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (φ : G ⟶ F) (η : B), (∀ b : B, Finite ((wcEtStalk B b).obj F)) → (∃ W : Set B, IsOpen W ∧ η ∈ W ∧ ∀ y ∈ W, η ⤳ y → Nat.card ((wcEtStalk B y).obj F) = Nat.card ((wcEtStalk B η).obj F)) → Function.Surjective ((wcEtStalk B η).map φ).hom → ∃ W : Set B, IsOpen W ∧ η ∈ W ∧ ∀ y ∈ W, η ⤳ y → Function.Surjective ((wcEtStalk B y).map φ).hom :=
by
  intro B _ F G φ η hfin hcard hsurj
  have hcof : ∀ b : B, IsCofiltered (StructuredArrow (Over.mk (wcEtGeomPt B b))
      (Scheme.Etale.forget B)) := fun b =>
    wc_et_geomstalk_cofiltered B b (fun e _ a₁ a₂ h Ω _ π hπ =>
      wc_etale_maps_agree_near_geom_point e a₁ a₂ h Ω π hπ)
  obtain ⟨U, hUo, hηU, hU⟩ := wc_et_stalk_range_local_uniform B F hcof
    wc_etale_lift_alg_closed_point wc_etale_fibre_point_isolated wc_etale_section_vanishing_open
    hfin η hcard G φ
  refine ⟨U, hUo, hηU, fun y hy hsp => ?_⟩
  have hincl : Set.range ((wcEtStalk B η).map (𝟙 F)) ⊆ Set.range ((wcEtStalk B η).map φ) := by
    rintro x -
    obtain ⟨z, hz⟩ := hsurj x
    exact ⟨z, hz⟩
  have h := hU y hy hsp F (𝟙 F) hincl
  intro x
  have hx : x ∈ Set.range ((wcEtStalk B y).map (𝟙 F)) :=
    ⟨x, by rw [CategoryTheory.Functor.map_id]; rfl⟩
  obtain ⟨z, hz⟩ := h hx
  exact ⟨z, hz⟩

theorem wc_r2gi_chart_lift_card_specialize : ∀ (B : Scheme.{u}) (V : B.Etale) (OY : B.Opens) (εO : V.left ⟶ (OY : Scheme.{u})), IsFinite εO → εO ≫ OY.ι = V.hom → ∀ (η y : B), η ⤳ y → y ∈ (OY : Set B) → Nat.card {t : Spec (.of (AlgebraicClosure (B.residueField y))) ⟶ V.left // t ≫ V.hom = wcEtGeomPt B y} ≤ Nat.card {t : Spec (.of (AlgebraicClosure (B.residueField η))) ⟶ V.left // t ≫ V.hom = wcEtGeomPt B η} :=
by
  classical

  have c5 : ∀ (k : Type u) [CommRing k] (I : Type u) [Fintype I] [DecidableEq I] (A : I → Type u)
      [∀ i, CommRing (A i)] [∀ i, Algebra k (A i)] (Ω : Type u) [Field Ω] [Algebra k Ω],
      Function.Bijective (fun x : Σ i, (A i →ₐ[k] Ω) => x.2.comp (Pi.evalAlgHom k A x.1)) := by
    intro k _ I _ _ A _ _ Ω _ _
    constructor
    · rintro ⟨i, g⟩ ⟨j, g'⟩ h
      have hij : i = j := by
        by_contra hne
        have h1 := congrArg (fun f : ((i : I) → A i) →ₐ[k] Ω => f (Pi.single i 1)) h
        simp [Ne.symm hne] at h1
      subst hij
      have : g = g' := by
        ext a
        have h1 := congrArg (fun f : ((i : I) → A i) →ₐ[k] Ω => f (Pi.single i a)) h
        simpa using h1
      subst this
      rfl
    · intro h
      have hsum : ∑ i, h (Pi.single i 1) = 1 := by
        rw [← map_sum]
        have : ∑ i, (Pi.single i 1 : (i : I) → A i) = 1 := by
          have := Finset.univ_sum_single (1 : (i : I) → A i)
          simpa using this
        rw [this, map_one]
      obtain ⟨i, hi⟩ : ∃ i, h (Pi.single i 1) = 1 := by
        by_contra hne
        have h0 : ∀ i, h (Pi.single i 1) = 0 := by
          intro i
          have hid : IsIdempotentElem (h (Pi.single i 1)) := by
            rw [IsIdempotentElem, ← map_mul, ← Pi.single_mul, mul_one]
          rcases IsIdempotentElem.iff_eq_zero_or_one.mp hid with h' | h'
          · exact h'
          · exact absurd ⟨i, h'⟩ hne
        rw [Finset.sum_eq_zero (fun i _ => h0 i)] at hsum
        exact zero_ne_one hsum
      let g : A i →ₐ[k] Ω :=
        { toFun := fun a => h (Pi.single i a)
          map_one' := hi
          map_mul' := fun a b => by simp only [Pi.single_mul, map_mul]
          map_zero' := by simp only [Pi.single_zero, map_zero]
          map_add' := fun a b => by simp only [Pi.single_add, map_add]
          commutes' := fun c => by
            have : (Pi.single i (algebraMap k (A i) c) : (i : I) → A i) =
                algebraMap k ((i : I) → A i) c * Pi.single i 1 := by
              funext j
              rcases eq_or_ne j i with rfl | hj
              · simp
              · simp [hj]
            rw [this, map_mul, hi, mul_one, AlgHom.commutes] }
      refine ⟨⟨i, g⟩, ?_⟩
      ext x
      simp only [AlgHom.comp_apply, Pi.evalAlgHom_apply]
      show h (Pi.single i (x i)) = h x
      have : (Pi.single i (x i) : (i : I) → A i) = x * Pi.single i 1 := by
        funext j
        rcases eq_or_ne j i with rfl | hj
        · simp
        · simp [hj]
      rw [this, map_mul, hi, mul_one]

  have c3a : ∀ (k A Ω : Type u) [Field k] [CommRing A] [Algebra k A] [Algebra.Etale k A] [Field Ω]
      [IsAlgClosed Ω] [Algebra k Ω], Nat.card (A →ₐ[k] Ω) = Module.finrank k A := by
    intro k A Ω _ _ _ _ _ _ _
    obtain ⟨I, hI, Ai, _, _, e, hAi⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod k A).mp inferInstance
    haveI := Fintype.ofFinite I
    haveI : ∀ i, Module.Finite k (Ai i) := fun i => (hAi i).1
    haveI : ∀ i, Algebra.IsSeparable k (Ai i) := fun i => (hAi i).2
    rw [Nat.card_congr (AlgEquiv.arrowCongr e (AlgEquiv.refl : Ω ≃ₐ[k] Ω)),
      ← Nat.card_congr (Equiv.ofBijective _ (c5 k I Ai Ω)), Nat.card_sigma,
      LinearEquiv.finrank_eq e.toLinearEquiv, Module.finrank_pi_fintype]
    refine Finset.sum_congr rfl fun i _ => ?_
    exact AlgHom.natCard_of_splits k (Ai i) Ω (fun x => IsAlgClosed.splits _)

  have c4 : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] [Module.Finite R S]
      [Algebra.Etale R S] (p q : PrimeSpectrum R), p ⤳ q →
      Module.rankAtStalk (R := R) S p = Module.rankAtStalk (R := R) S q := by
    intro R S _ _ _ _ _ p q h
    haveI := Module.FinitePresentation.of_finite_of_finitePresentation R S
    have hlc := Module.isLocallyConstant_rankAtStalk (R := R) (M := S)
    exact h.mem_open (hlc.isOpen_fiber _) rfl

  have c3 : ∀ (R S : CommRingCat.{u}) (φ : R ⟶ S), φ.hom.Etale → φ.hom.Finite →
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (χ : R ⟶ CommRingCat.of Ω),
      letI := φ.hom.toAlgebra
      Nat.card {ψ : S ⟶ CommRingCat.of Ω // φ ≫ ψ = χ} =
        Module.rankAtStalk (R := R) S ((Spec.map χ) (IsLocalRing.closedPoint Ω)) := by
    intro R S φ het hfin Ω _ _ χ
    letI := φ.hom.toAlgebra
    haveI : Algebra.Etale R S := het
    haveI : Module.Finite R S := hfin
    set p : PrimeSpectrum R := (Spec.map χ) (IsLocalRing.closedPoint Ω) with hp
    have hpker : p.asIdeal = RingHom.ker χ.hom := by
      have h1 : p.asIdeal = Ideal.comap χ.hom (IsLocalRing.closedPoint Ω).asIdeal := by
        rw [hp]; rfl
      rw [h1, RingHom.ker_eq_comap_bot]
      congr 1
      exact IsLocalRing.maximalIdeal_eq_bot
    have hl1 : p.asIdeal ≤ RingHom.ker χ.hom := hpker.le
    have hl2 : p.asIdeal.primeCompl ≤ Submonoid.comap χ.hom (IsUnit.submonoid Ω) := by
      intro r hr
      simp only [Submonoid.mem_comap, IsUnit.mem_submonoid_iff]
      refine isUnit_iff_ne_zero.mpr fun h0 => hr ?_
      show r ∈ p.asIdeal
      rw [hpker]
      exact h0
    let χb := Ideal.ResidueField.lift p.asIdeal χ.hom hl1 hl2
    letI : Algebra p.asIdeal.ResidueField Ω := χb.toAlgebra
    letI : Algebra R Ω := (χb.comp (algebraMap R p.asIdeal.ResidueField)).toAlgebra
    haveI : IsScalarTower R p.asIdeal.ResidueField Ω :=
      IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    have hχb : ∀ r : R, algebraMap R Ω r = χ.hom r := fun r =>
      Ideal.ResidueField.lift_algebraMap p.asIdeal χ.hom hl1 hl2 r
    let e1 : {ψ : S ⟶ CommRingCat.of Ω // φ ≫ ψ = χ} ≃ (S →ₐ[R] Ω) :=
      { toFun := fun ψ => ⟨ψ.1.hom, fun r => by
          rw [hχb]; exact congrArg (fun f : R ⟶ CommRingCat.of Ω => f.hom r) ψ.2⟩
        invFun := fun g => ⟨CommRingCat.ofHom g.toRingHom, by
          ext r
          rw [← hχb]
          exact g.commutes r⟩
        left_inv := fun ψ => rfl
        right_inv := fun g => rfl }
    let e2 : (S →ₐ[R] Ω) ≃
        {fg : (p.asIdeal.ResidueField →ₐ[p.asIdeal.ResidueField] Ω) × (S →ₐ[R] Ω) //
          ∀ x y, Commute (fg.1 x) (fg.2 y)} :=
      { toFun := fun g => ⟨(Algebra.ofId _ Ω, g), fun _ _ => Commute.all _ _⟩
        invFun := fun fg => fg.1.2
        left_inv := fun g => rfl
        right_inv := fun fg => Subtype.ext (Prod.ext (Subsingleton.elim _ _) rfl) }
    rw [Nat.card_congr (e1.trans (e2.trans Algebra.TensorProduct.liftEquiv)),
      Module.rankAtStalk_eq]
    exact c3a _ _ _

  have c1 : ∀ (B X : Scheme.{u}) (OY : B.Opens) (εO : X ⟶ (OY : Scheme.{u})) (b : B)
      (hb : b ∈ (OY : Set B)),
      ∃ c : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ (OY : Scheme.{u}),
        c (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b))) = ⟨b, hb⟩ ∧
        Nat.card {t : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ X //
          t ≫ (εO ≫ OY.ι) = wcEtGeomPt B b} =
        Nat.card {t : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ X // t ≫ εO = c} := by
    intro B X OY εO b hb
    have hgp : ∀ p, (wcEtGeomPt B b) p = b := by
      intro p
      simp only [wcEtGeomPt, Scheme.Hom.comp_apply]
      exact Scheme.fromSpecResidueField_apply b _
    have hrange : Set.range (wcEtGeomPt B b) ⊆ Set.range OY.ι := by
      rintro _ ⟨p, rfl⟩
      rw [Scheme.Opens.range_ι, hgp]
      exact hb
    have hfac := IsOpenImmersion.lift_fac OY.ι _ hrange
    refine ⟨IsOpenImmersion.lift OY.ι _ hrange, ?_, ?_⟩
    · apply Subtype.ext
      have h1 : ∀ x, OY.ι (IsOpenImmersion.lift OY.ι _ hrange x) = b := fun x => by
        rw [← Scheme.Hom.comp_apply, hfac, hgp]
      have h2 := h1 (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b)))
      have h3 : ∀ z : (OY : Scheme.{u}), OY.ι z = z.1 := fun z => Scheme.Opens.ι_apply _ _
      rw [h3] at h2
      exact h2
    · apply Nat.card_congr
      apply Equiv.subtypeEquivRight
      intro t
      constructor
      · intro h
        rw [← cancel_mono OY.ι, Category.assoc, h, hfac]
      · intro h
        rw [← Category.assoc, h, hfac]

  have c2 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (W : Y.Opens) (hW : IsAffineOpen W),
      IsAffineOpen (f ⁻¹ᵁ W) → ∀ (Ω : Type u) [Field Ω] (c : Spec (.of Ω) ⟶ Y),
      c (IsLocalRing.closedPoint Ω) ∈ W →
      ∃ χ : Γ(Y, W) ⟶ CommRingCat.of Ω, Spec.map χ ≫ hW.fromSpec = c ∧
        Nat.card {t : Spec (.of Ω) ⟶ X // t ≫ f = c} =
        Nat.card {ψ : Γ(X, f ⁻¹ᵁ W) ⟶ CommRingCat.of Ω //
          f.appLE W (f ⁻¹ᵁ W) le_rfl ≫ ψ = χ} := by
    intro X Y f W hW hV Ω _ c hc
    have hpt : ∀ x : Spec (.of Ω), x = IsLocalRing.closedPoint Ω := fun x => Subsingleton.elim _ _
    have hcr : Set.range c ⊆ Set.range hW.fromSpec := by
      rintro _ ⟨x, rfl⟩
      rw [hW.range_fromSpec, hpt x]
      exact hc
    have hc'fac := IsOpenImmersion.lift_fac hW.fromSpec c hcr
    refine ⟨Spec.preimage (IsOpenImmersion.lift hW.fromSpec c hcr),
      by rw [Spec.map_preimage, hc'fac], ?_⟩
    have hkey := IsAffineOpen.SpecMap_appLE_fromSpec f hW hV le_rfl
    have htr : ∀ t : Spec (.of Ω) ⟶ X, t ≫ f = c → Set.range t ⊆ Set.range hV.fromSpec := by
      intro t ht
      rintro _ ⟨x, rfl⟩
      rw [hV.range_fromSpec]
      show f (t x) ∈ W
      rw [← Scheme.Hom.comp_apply, ht, hpt x]
      exact hc
    refine Nat.card_congr
      { toFun := fun t => ⟨Spec.preimage (IsOpenImmersion.lift hV.fromSpec t.1 (htr t.1 t.2)), ?_⟩
        invFun := fun ψ => ⟨Spec.map ψ.1 ≫ hV.fromSpec, ?_⟩
        left_inv := ?_
        right_inv := ?_ }
    · apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_preimage, Spec.map_preimage, ← cancel_mono hW.fromSpec,
        Category.assoc, hkey, ← Category.assoc, IsOpenImmersion.lift_fac, t.2, hc'fac]
    · rw [Category.assoc, ← hkey, ← Category.assoc, ← Spec.map_comp, ψ.2, Spec.map_preimage,
        hc'fac]
    · intro t
      apply Subtype.ext
      show Spec.map (Spec.preimage _) ≫ _ = _
      rw [Spec.map_preimage, IsOpenImmersion.lift_fac]
    · intro ψ
      apply Subtype.ext
      apply Spec.map_injective
      show Spec.map (Spec.preimage _) = _
      rw [Spec.map_preimage]
      exact (IsOpenImmersion.lift_uniq _ _ _ (Spec.map ψ.1) rfl).symm

  intro B V OY εO hεfin hεc η y hηy hyOY
  have hηOY : η ∈ (OY : Set B) := hηy.mem_open OY.isOpen hyOY
  haveI : Etale (εO ≫ OY.ι) := hεc ▸ V.prop
  haveI : Etale εO := Etale.of_comp εO OY.ι
  rw [← hεc]
  have h3 : ∀ z : (OY : Scheme.{u}), OY.ι z = z.1 := fun z => Scheme.Opens.ι_apply _ _
  let y' : (OY : Scheme.{u}) := ⟨y, hyOY⟩
  let η' : (OY : Scheme.{u}) := ⟨η, hηOY⟩
  have hsp : η' ⤳ y' := by
    rw [← OY.ι.isOpenEmbedding.isInducing.specializes_iff, h3, h3]
    exact hηy
  obtain ⟨W', hW', hyW', -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := y') trivial
  have hηW' : η' ∈ W' := hsp.mem_open W'.isOpen hyW'
  have hV' : IsAffineOpen (εO ⁻¹ᵁ W') := hW'.preimage εO
  have hφet : (εO.appLE W' (εO ⁻¹ᵁ W') le_rfl).hom.Etale :=
    HasRingHomProperty.appLE @Etale εO inferInstance ⟨W', hW'⟩ ⟨_, hV'⟩ le_rfl
  have hφfin : (εO.appLE W' (εO ⁻¹ᵁ W') le_rfl).hom.Finite :=
    εO.appLE_eq_app ▸ εO.finite_app W' hW'
  letI := (εO.appLE W' (εO ⁻¹ᵁ W') le_rfl).hom.toAlgebra
  have key : ∀ (b : B) (hb : b ∈ (OY : Set B)), (⟨b, hb⟩ : (OY : Scheme.{u})) ∈ W' →
      ∃ p : PrimeSpectrum Γ(OY, W'), hW'.fromSpec p = ⟨b, hb⟩ ∧
        Nat.card {t : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ V.left //
          t ≫ (εO ≫ OY.ι) = wcEtGeomPt B b} =
        Module.rankAtStalk (R := Γ(OY, W')) Γ(V.left, εO ⁻¹ᵁ W') p := by
    intro b hb hbW
    obtain ⟨c, hc, h1⟩ := c1 B V.left OY εO b hb
    obtain ⟨χ, hχ, h2⟩ := c2 εO W' hW' hV' _ c (by rw [hc]; exact hbW)
    refine ⟨Spec.map χ (IsLocalRing.closedPoint _), ?_, ?_⟩
    · have h4 : ∀ x, hW'.fromSpec (Spec.map χ x) = c x := fun x => by
        rw [← Scheme.Hom.comp_apply, hχ]
      exact (h4 _).trans hc
    · rw [h1, h2]
      exact c3 _ _ _ hφet hφfin _ χ
  obtain ⟨py, hpy, hNy⟩ := key y hyOY hyW'
  obtain ⟨pη, hpη, hNη⟩ := key η hηOY hηW'
  rw [hNy, hNη]
  have hsp' : pη ⤳ py := by
    have h6 : hW'.fromSpec pη ⤳ hW'.fromSpec py := by rw [hpy, hpη]; exact hsp
    exact hW'.fromSpec.isOpenEmbedding.isInducing.specializes_iff.mp h6
  haveI : Module.Finite Γ(OY, W') Γ(V.left, εO ⁻¹ᵁ W') := hφfin
  haveI : Algebra.Etale Γ(OY, W') Γ(V.left, εO ⁻¹ᵁ W') := hφet
  exact (c4 _ _ pη py hsp').symm.le

theorem wc_r2gi_stalk_zero_of_fibre_dim_zero : ∀ (X B : Scheme.{u}) (g : X ⟶ B) [IsProper g] (M : ℕ), M ≠ 0 → ∀ (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod M))))) (b : B), topologicalKrullDim ↥(⇑g ⁻¹' {b}) ≤ ((0 : ℕ) : WithBot ℕ∞) → Subsingleton ((wcEtStalk B b).obj ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 2)) :=
by
  intro X B g _ M hM I b hb

  obtain ⟨e⟩ := wc_et_proper_stalk_coh g M hM wc_et_henselian_proper_vanishing I b 2

  have L3 : ∀ (T : Type u) [TopologicalSpace T] [QuasiSober T] [T0Space T],
      topologicalKrullDim T ≤ ((0 : ℕ) : WithBot ℕ∞) ↔ ∀ x y : T, x ⤳ y → x = y := by
    intro T _ _ _
    rw [Nat.cast_zero]
    unfold topologicalKrullDim
    rw [Order.krullDim_nonpos_iff_forall_isMax]
    constructor
    · intro h x y hxy
      let Cx : TopologicalSpace.IrreducibleCloseds T :=
        ⟨closure {x}, isIrreducible_singleton.closure, isClosed_closure⟩
      let Cy : TopologicalSpace.IrreducibleCloseds T :=
        ⟨closure {y}, isIrreducible_singleton.closure, isClosed_closure⟩
      have h1 : Cy ≤ Cx := by
        show closure {y} ⊆ closure {x}
        exact specializes_iff_closure_subset.mp hxy
      have h2 : Cx ≤ Cy := h Cy h1
      have h3 : y ⤳ x := specializes_iff_closure_subset.mpr h2
      exact (hxy.antisymm h3).eq
    · intro h Z Z' hZZ'
      obtain ⟨z, hz⟩ := QuasiSober.sober Z.isIrreducible Z.isClosed
      obtain ⟨z', hz'⟩ := QuasiSober.sober Z'.isIrreducible Z'.isClosed
      have hzZ' : z ∈ (Z' : Set T) := hZZ' hz.mem
      have hsp : z' ⤳ z := hz'.specializes hzZ'
      have heq := h z' z hsp
      show (Z' : Set T) ⊆ Z
      rw [← hz'.def, ← hz.def, heq]

  have L4 : ∀ {P Y : Scheme.{u}} (p : P ⟶ Y) [IsIntegralHom p] (x y : P),
      x ⤳ y → p x = p y → x = y := by
    intro P Y p _ x y hxy hpxy
    obtain ⟨V, hV, hyV, -⟩ := exists_isAffineOpen_mem_and_subset (x := p y) (U := ⊤) trivial
    have hU : IsAffineOpen (p ⁻¹ᵁ V) := hV.preimage p
    have hyU : y ∈ p ⁻¹ᵁ V := hyV
    have hxU : x ∈ p ⁻¹ᵁ V := hxy.mem_open (p ⁻¹ᵁ V).isOpen hyU
    haveI := hU.isOpenImmersion_fromSpec
    haveI := hV.isOpenImmersion_fromSpec
    obtain ⟨a, rfl⟩ : ∃ a, hU.fromSpec a = x := by
      rw [← Set.mem_range, hU.range_fromSpec]; exact hxU
    obtain ⟨c, rfl⟩ : ∃ c, hU.fromSpec c = y := by
      rw [← Set.mem_range, hU.range_fromSpec]; exact hyU
    have hac : a.asIdeal ≤ c.asIdeal := by
      have h1 : a ⤳ c := (hU.fromSpec.isOpenEmbedding.isInducing).specializes_iff.mp hxy
      exact (PrimeSpectrum.le_iff_specializes (R := Γ(P, p ⁻¹ᵁ V)) a c).mpr h1
    have hsq := hV.SpecMap_appLE_fromSpec p hU (le_refl _)
    rw [Scheme.Hom.appLE_eq_app] at hsq
    have hcomp : ∀ z, hV.fromSpec (Spec.map (p.app V) z) = p (hU.fromSpec z) := by
      intro z
      rw [← Scheme.Hom.comp_apply, hsq, Scheme.Hom.comp_apply]
    have hcomap : Spec.map (p.app V) a = Spec.map (p.app V) c :=
      hV.fromSpec.isOpenEmbedding.injective (by rw [hcomp, hcomp, hpxy])
    letI := (p.app V).hom.toAlgebra
    haveI : Algebra.IsIntegral Γ(Y, V) Γ(P, p ⁻¹ᵁ V) :=
      algebraMap_isIntegral_iff.mp (IsIntegralHom.isIntegral_app p V hV)
    have hund : Ideal.under Γ(Y, V) a.asIdeal = Ideal.under Γ(Y, V) c.asIdeal := by
      have h := congrArg PrimeSpectrum.asIdeal hcomap
      simp only [Spec.map_base] at h
      exact h
    haveI : a.asIdeal.IsPrime := a.isPrime
    by_contra hne
    have hlt : a.asIdeal < c.asIdeal :=
      lt_of_le_of_ne hac (fun h => hne (congrArg hU.fromSpec (PrimeSpectrum.ext h)))
    exact (Ideal.IsIntegral.under_lt_under hlt).ne hund

  have hs : IsIntegralHom (Spec.map (CommRingCat.ofHom (algebraMap (B.residueField b)
      (AlgebraicClosure (B.residueField b))))) :=
    IsIntegralHom.SpecMap_iff.mpr (fun x => Algebra.IsIntegral.isIntegral (R := B.residueField b) x)
  haveI hp : IsIntegralHom (Limits.pullback.fst (Limits.pullback.snd g (B.fromSpecResidueField b))
      (Spec.map (CommRingCat.ofHom (algebraMap (B.residueField b)
        (AlgebraicClosure (B.residueField b)))))) :=
    MorphismProperty.of_isPullback (P := @IsIntegralHom)
      (IsPullback.of_hasPullback (Limits.pullback.snd g (B.fromSpecResidueField b))
        (Spec.map (CommRingCat.ofHom (algebraMap (B.residueField b)
          (AlgebraicClosure (B.residueField b)))))).flip hs

  have hfib : topologicalKrullDim ↥(Limits.pullback g (B.fromSpecResidueField b)) ≤
      ((0 : ℕ) : WithBot ℕ∞) :=
    (IsHomeomorph.topologicalKrullDim_eq _ (Scheme.Hom.fiberHomeo g b).isHomeomorph).trans_le hb

  have hP : topologicalKrullDim ↥(Limits.pullback (Limits.pullback.snd g (B.fromSpecResidueField b))
      (Spec.map (CommRingCat.ofHom (algebraMap (B.residueField b)
        (AlgebraicClosure (B.residueField b)))))) ≤ ((0 : ℕ) : WithBot ℕ∞) := by
    apply (L3 _).mpr
    intro x y hxy
    apply L4 (Limits.pullback.fst (Limits.pullback.snd g (B.fromSpecResidueField b))
      (Spec.map (CommRingCat.ofHom (algebraMap (B.residueField b)
        (AlgebraicClosure (B.residueField b)))))) x y hxy
    exact (L3 _).mp hfib _ _ (hxy.map (Scheme.Hom.continuous _))

  have hW : topologicalKrullDim ↥(Limits.pullback g (wcEtGeomPt B b)) ≤ ((0 : ℕ) : WithBot ℕ∞) :=
    (IsHomeomorph.topologicalKrullDim_eq _ (Scheme.homeoOfIso
      (Limits.pullbackLeftPullbackSndIso g (B.fromSpecResidueField b)
        (Spec.map (CommRingCat.ofHom (algebraMap (B.residueField b)
          (AlgebraicClosure (B.residueField b))))))).isHomeomorph).symm.trans_le hP

  haveI := wc_et_zero_dim_vanishing (AlgebraicClosure (B.residueField b))
    (Limits.pullback g (wcEtGeomPt B b)) (Limits.pullback.snd g (wcEtGeomPt B b)) hW M
    hM 2 (by norm_num)
  exact e.subsingleton

theorem wc_et_stalk_kernel_subsingleton : ∀ {B : Scheme.{u}} (G F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (φ : G ⟶ F) (b : B), Function.Injective ((wcEtStalk B b).map φ).hom → Subsingleton ((wcEtStalk B b).obj (Limits.kernel φ)) :=
by
  intro B G F φ b hinj
  classical
  let X₀ : Over B := Over.mk (wcEtGeomPt B b)
  haveI : IsCofiltered (StructuredArrow X₀ (Scheme.Etale.forget B)) :=
    IsCofiltered.of_hasFiniteLimits _
  haveI : Limits.PreservesFilteredColimitsOfSize.{u, u+1} (forget AddCommGrpCat.{u+1}) :=
    Limits.preservesFilteredColimitsOfSize_shrink.{u+1, u+1, u, u+1} (forget AddCommGrpCat.{u+1})

  have hsec : ∀ U, Function.Injective ((Limits.kernel.ι φ).hom.app U).hom := fun U =>
    (AddCommGrpCat.mono_iff_injective _).mp
      ((NatTrans.mono_iff_mono_app (Limits.kernel.ι φ).hom).mp
        (Functor.map_mono (sheafToPresheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1})
          (Limits.kernel.ι φ)) U)

  have hι : ∀ z, ((wcEtStalk B b).map (Limits.kernel.ι φ)).hom z = 0 → z = 0 := by
    intro z hz
    let DK := (StructuredArrow.proj X₀ (Scheme.Etale.forget B)).op ⋙ (Limits.kernel φ).obj
    let DG := (StructuredArrow.proj X₀ (Scheme.Etale.forget B)).op ⋙ G.obj
    let α := Functor.whiskerLeft (StructuredArrow.proj X₀ (Scheme.Etale.forget B)).op
      (Limits.kernel.ι φ).hom
    obtain ⟨j, t, rfl⟩ := Limits.Concrete.colimit_exists_rep DK z
    have e1 := Limits.colimit.ι_map_apply α j t
    have h1 : (Limits.colimit.ι DG j).hom ((α.app j).hom t) = (Limits.colimit.ι DG j).hom 0 := by
      rw [map_zero]
      exact e1.symm.trans hz
    obtain ⟨k, f, g, hfg⟩ := Limits.Concrete.colimit_exists_of_rep_eq DG _ _ h1
    rw [map_zero] at hfg
    have e2 := NatTrans.naturality_apply α f t
    have h2 : (DK.map f).hom t = 0 := by
      apply hsec (Opposite.op k.unop.right)
      rw [map_zero]
      exact e2.trans hfg
    rw [← Limits.colimit.w_apply DK f t, h2, map_zero]

  have hzero : ∀ z, ((wcEtStalk B b).map φ).hom
      (((wcEtStalk B b).map (Limits.kernel.ι φ)).hom z) = 0 := by
    intro z
    have h0 : (wcEtStalk B b).map (Limits.kernel.ι φ) ≫ (wcEtStalk B b).map φ = 0 := by
      rw [← Functor.map_comp, Limits.kernel.condition, Functor.map_zero]
    have := congrArg (fun h => h.hom z) h0
    simpa using this

  have key : ∀ z, z = (0 : (wcEtStalk B b).obj (Limits.kernel φ)) := by
    intro z
