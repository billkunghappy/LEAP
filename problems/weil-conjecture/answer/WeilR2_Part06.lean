    (SheafOfModules.unit (wcEtZModRing Y ℓ)) (2 * d + 1)
  have hv := wc_et_cd_proper_torsion K Y f d (wc_smooth_alg_closed_dim_le K Y f d) ℓ
    hℓ _ htor (2 * d + 1) (by omega)
  apply (E1.trans E2).injective
  rw [hv ((E1.trans E2) y), hv ((E1.trans E2) 0)]

