            (⟨closure j.1, isClosed_closure⟩ : TopologicalSpace.Closeds C)).subscheme)
        (_ : IsIso α) (ρ : Spec (.of Ω) ⟶ Spec (.of Ω)) (Dα : wcEtPullData α M),
        α ≫ ((Scheme.IdealSheafData.vanishingIdeal
            (⟨closure j.1, isClosed_closure⟩ : TopologicalSpace.Closeds C)).subschemeι ≫ fC) =
          ((Scheme.IdealSheafData.vanishingIdeal
            (⟨closure i.1, isClosed_closure⟩ : TopologicalSpace.Closeds C)).subschemeι ≫ fC) ≫ ρ ∧
          ρ ≫ ε = ε ∧ f = wcEtPull Dα 2}, fun _ _ _ => Iff.rfl⟩

  have hequiv : ∀ i : {Z : Set C // Z ∈ irreducibleComponents C ∧
      ¬ topologicalKrullDim ↥Z ≤ ((0 : ℕ) : WithBot ℕ∞)},
