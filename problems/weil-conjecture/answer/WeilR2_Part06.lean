              (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op A)).hom ((F.obj.map c.op).hom s) := by
    intro F x₀
    obtain ⟨A₀, s₀, hA₀⟩ := (wc_et_stalk_germ_facts B η hcof F).1 x₀
    have aux2 : ∀ {P R : Scheme.{u}} (f f' : P ⟶ R), f = f' → ∀ x : P, f x = f' x := by
      intro P R f f' h x; subst h; rfl
    have h1 : A₀.hom.left ≫ A₀.right.hom = wcEtGeomPt B η := Over.w A₀.hom
