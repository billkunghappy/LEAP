    refine ⟨σ0.toRingEquiv, fun k => ?_⟩
    have hTk : T (⟨2 * k.val, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1)) =
        (⟨2 * k.val + 1, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1)) := by
      rw [hT]
      apply Fin.ext
      rw [hτ]
