  have hWg : WeaklyEtale (inv c ≫ Limits.pullback.snd a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) :=
    (MorphismProperty.cancel_left_of_respectsIso @WeaklyEtale (inv c) _).mpr hWs

  have hWθ : WeaklyEtale (Spec.map (Scheme.stalkClosedPointTo (inv c ≫ Limits.pullback.snd a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))))) :=
    MorphismProperty.of_postcomp @WeaklyEtale (W' := @WeaklyEtale) _ _
      (wc_lfi_fromSpecStalk_weaklyEtale _ _)
      (by rw [Scheme.Spec_stalkClosedPointTo_fromSpecStalk]; exact hWg)
  let φs := (Scheme.stalkClosedPointTo (inv c ≫ Limits.pullback.snd a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)))).hom
  have hφl : IsLocalHom φs := inferInstance
  have hAlg := wc_lpkt_specMap_weaklyEtale_ring _ _ φs hWθ
  have hφf : φs.Flat := by
    letI := φs.toAlgebra
    haveI := hAlg
    rw [RingHom.Flat.eq_1]
    exact Algebra.WeaklyEtale.flat
  obtain ⟨hCn, hφm⟩ := wc_tla_shens_noeth_unram _ (B ⧸ J) φs hφl hAlg
  haveI := hCn

  let π : R →+* ((Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)).presheaf.stalk ((inv c ≫ Limits.pullback.snd a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (IsLocalRing.closedPoint (B ⧸ J)))) :=
    ψ.symm.toRingHom.comp (Ideal.Quotient.mk (Ideal.span {h}))
  have hπ : Function.Surjective π :=
    ψ.symm.surjective.comp Ideal.Quotient.mk_surjective
  have hker : RingHom.ker π = Ideal.span {h} := by
    show RingHom.ker (ψ.symm.toRingHom.comp (Ideal.Quotient.mk (Ideal.span {h}))) = _
    rw [RingHom.ker_comp_of_injective _ ψ.symm.injective, Ideal.mk_ker]
  obtain ⟨ℓ₁, ℓ₂, hsp, hq⟩ := wc_local_binary_quadric_split R _ π hπ t hm M hdet
  have hh : h - ℓ₁ * ℓ₂ ∈ IsLocalRing.maximalIdeal R ^ 3 := by
    have h3 := Ideal.add_mem _ hcub hq
    convert h3 using 1
    ring
  have h₁ := wc_reg2_node_branch_pow_not_mem R ℓ₁ ℓ₂ h hsp hdim hh
  have h₂ := wc_reg2_node_branch_pow_not_mem R ℓ₂ ℓ₁ h
    (by rw [Set.pair_comm]; exact hsp) hdim (by rw [mul_comm ℓ₂ ℓ₁]; exact hh)
  obtain ⟨hspB, hxyB, hxB, hyB⟩ :=
    @wc_flat_local_node_transfer R _ (B ⧸ J) _ _ _ _ _ _ π hπ h ℓ₁ ℓ₂ hker hsp hh h₁ h₂ φs hφl hφf hφm
  obtain ⟨s, t', hst, hspst, hs0', ht0'⟩ := wc_henselian_node_split (B ⧸ J) _ _ hspB hxyB hxB hyB
  have hs0 : ∀ n : ℕ, s ^ n ≠ 0 := by
    intro n h0
    apply hs0' n
    rw [h0]
    exact Ideal.zero_mem _
  have ht0 : ∀ n : ℕ, t' ^ n ≠ 0 := by
    intro n h0
    apply ht0' n
    rw [h0]
    exact Ideal.zero_mem _

  obtain ⟨K₁, fK₁, aK₁, hloc₁⟩ := c2 (B ⧸ J) s t' hst hspst ht0
  obtain ⟨K₂, fK₂, aK₂, hloc₂⟩ := c2 (B ⧸ J) t' s (by rw [mul_comm]; exact hst)
    (by rw [Set.pair_comm]; exact hspst) hs0
  exact kc (B ⧸ J) inferInstance inferInstance (asIso c) s t' hst hspst K₁ K₂ fK₁ fK₂ aK₁ aK₂
    hloc₁ hloc₂

theorem wc_et_dnb_branch_ses (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (k : ℕ) (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left
      (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left))
    (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left)
    (hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a)
    (x : ↥(Limits.pullback D.f a)) (hx : Limits.pullback.fst D.f a x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Limits.pullback D.f a) x))
      (Scheme.Etale.forget (Limits.pullback D.f a)))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ Limits.pullback D.f a)
    (hsh : wcHalShData x B Λ' W'' φ' a')
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)))
    (hxs : Limits.pullback.fst (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A) xs = x)
    (Dx : wcEtPullData (wcEtGeomPt (Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)) xs) (ℓ ^ k))
    (Dw : wcEtPullData (Limits.pullback.snd a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (ℓ ^ k))
    (h2 : n = 2) (C : Type u) [CommRing C] [IsLocalRing C]
    (eC : Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) ≅ Spec (.of C))
    (s t : C) (hst : s * t = 0) (hspan : Ideal.span {s, t} = IsLocalRing.maximalIdeal C)
    (K₁ K₂ : Type u) [Field K₁] [Field K₂] [Algebra C K₁] [Algebra C K₂]
    [IsLocalization.Away t K₁] [IsLocalization.Away s K₂] (G : Prop)
    (kc : ∀ (U₁ U₂ : (Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))).Etale)
      (eU₁ : U₁.left ≅ Spec (.of K₁)) (eU₂ : U₂.left ≅ Spec (.of K₂)),
      eU₁.inv ≫ U₁.hom ≫ eC.hom = Spec.map (CommRingCat.ofHom (algebraMap C K₁)) →
      eU₂.inv ≫ U₂.hom ≫ eC.hom = Spec.map (CommRingCat.ofHom (algebraMap C K₂)) →
      ∀ (P₁ P₂ : SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (ℓ ^ k)))
        (ev₁ : ∀ M : SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (ℓ ^ k)),
          (P₁ ⟶ M) ≃ M.val.obj (Opposite.op U₁))
        (ev₂ : ∀ M : SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (ℓ ^ k)),
          (P₂ ⟶ M) ≃ M.val.obj (Opposite.op U₂)),
        (∀ (M N : SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (ℓ ^ k)))
            (ψ : M ⟶ N) (g : P₁ ⟶ M),
          ev₁ N (g ≫ ψ) = (ψ.val.app (Opposite.op U₁)).hom (ev₁ M g)) →
        (∀ (M : SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (ℓ ^ k)))
            (g g' : P₁ ⟶ M), ev₁ M (g + g') = ev₁ M g + ev₁ M g') →
        (∀ (M N : SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (ℓ ^ k)))
            (ψ : M ⟶ N) (g : P₂ ⟶ M),
          ev₂ N (g ≫ ψ) = (ψ.val.app (Opposite.op U₂)).hom (ev₂ M g)) →
        (∀ (M : SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (ℓ ^ k)))
            (g g' : P₂ ⟶ M), ev₂ M (g + g') = ev₂ M g + ev₂ M g') →
        ∀ hz : Limits.biprod.desc
            ((ev₁ (SheafOfModules.unit _)).symm (wcModUnitOne _ U₁))
            ((ev₂ (SheafOfModules.unit _)).symm (wcModUnitOne _ U₂)) ≫
            (Dw.μ.inv ≫ Dw.Φ.map (wcEtSuppUnitMap Dx)) = 0,
          (ShortComplex.mk _ _ hz).ShortExact → G) : G :=
by
  classical
  have hm : 0 < ℓ ^ k := pow_pos (Fact.out : ℓ.Prime).pos k
  haveI hxb : IsClosedImmersion (wcEtGeomPt (Limits.pullback (C := Scheme.{u})
      (Limits.pullback.snd D.f a) (wcQmSp A)) xs) :=
    wc_et_tpl_sfu_geom_pt_closed_immersion F' F'' Y n D i A Λ W' φ a hA x hx xs hxs
  haveI hqA : IsClosedImmersion (wcQmSp A) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective


  have hpunct : ∀ {X : Scheme.{u}} (eX : X ≅ Spec (.of C)),
      (eX.hom ⁻¹ᵁ PrimeSpectrum.basicOpen t) ⊓ (eX.hom ⁻¹ᵁ PrimeSpectrum.basicOpen s) = ⊥ ∧
      ∀ z : X, z ∈ (eX.hom ⁻¹ᵁ PrimeSpectrum.basicOpen t) ⊔ (eX.hom ⁻¹ᵁ PrimeSpectrum.basicOpen s) ↔
        z ≠ eX.inv (IsLocalRing.closedPoint C) := by
    intro X eX
    have hs : s ∈ IsLocalRing.maximalIdeal C := hspan ▸ Ideal.subset_span (by simp)
    have ht : t ∈ IsLocalRing.maximalIdeal C := hspan ▸ Ideal.subset_span (by simp)
    refine ⟨?_, ?_⟩
    · apply le_antisymm _ bot_le
      intro z hz
      exfalso
      have h1 : t ∉ (eX.hom z).asIdeal := hz.1
      have h2 : s ∉ (eX.hom z).asIdeal := hz.2
      have hmem : s * t ∈ (eX.hom z).asIdeal := hst ▸ Ideal.zero_mem _
      rcases (eX.hom z).isPrime.mem_or_mem hmem with h | h
      · exact h2 h
      · exact h1 h
    · intro z
      rw [TopologicalSpace.Opens.mem_sup]
      constructor
      · intro h hz
        have hQ : eX.hom z = IsLocalRing.closedPoint C := by
          subst hz
          exact Scheme.inv_hom_apply eX _
        rcases h with h | h
        · have h' : t ∉ (eX.hom z).asIdeal := h
          rw [hQ] at h'
          exact h' ht
        · have h' : s ∉ (eX.hom z).asIdeal := h
          rw [hQ] at h'
          exact h' hs
      · intro hz
        by_contra hcon
        rw [not_or] at hcon
        obtain ⟨hc1, hc2⟩ := hcon
        have h1 : t ∈ (eX.hom z).asIdeal := by
          by_contra h
          exact hc1 h
        have h2 : s ∈ (eX.hom z).asIdeal := by
          by_contra h
          exact hc2 h
        have hle : IsLocalRing.maximalIdeal C ≤ (eX.hom z).asIdeal := by
          rw [← hspan, Ideal.span_le]
          exact Set.insert_subset_iff.mpr ⟨h2, Set.singleton_subset_iff.mpr h1⟩
        have hQ : eX.hom z = IsLocalRing.closedPoint C :=
          PrimeSpectrum.ext (le_antisymm (IsLocalRing.le_maximalIdeal (eX.hom z).isPrime.ne_top) hle)
        apply hz
        rw [← hQ, Scheme.hom_inv_apply]


  have hfib : ∀ {Xs XA : Scheme.{u}} (q : Xs ⟶ XA) [IsClosedImmersion q] (x₀ : XA) (xs₀ : Xs),
      q xs₀ = x₀ → ∀ (B₀ : Type u) [CommRing B₀] [IsLocalRing B₀] (Λ₀ : Type u) [SmallCategory Λ₀]
      [IsCofiltered Λ₀]
      (W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt XA x₀)) (Scheme.Etale.forget XA))
      (φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left) (a₀ : Spec (.of B₀) ⟶ XA),
      wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀ → ∀ (e₀ : Limits.pullback a₀ q ≅ Spec (.of C))
      (z : ↥(Limits.pullback a₀ q)),
      Limits.pullback.snd a₀ q z = xs₀ ↔ z = e₀.inv (IsLocalRing.closedPoint C) := by
    intro Xs XA q _ x₀ xs₀ hxs₀ B₀ _ _ Λ₀ _ _ W₀ φ₀ a₀ hsh₀ e₀ z
    have hinj : Function.Injective (Limits.pullback.fst a₀ q) :=
      (Scheme.Hom.isClosedEmbedding (Limits.pullback.fst a₀ q)).isEmbedding.injective
    have hfc : ∀ p : ↥(Spec (.of B₀)), a₀ p = x₀ → p = IsLocalRing.closedPoint B₀ :=
      wc_shdata_fibre_closed_point x₀ B₀ Λ₀ W₀ φ₀ a₀ hsh₀
    have ha' : a₀ (IsLocalRing.closedPoint B₀) = x₀ := by
      obtain ⟨-, -, -, -, -, e, -, he⟩ := hsh₀
      have ω : ↥(Spec (.of (AlgebraicClosure (XA.residueField x₀)))) := IsLocalRing.closedPoint _
      have h1 : a₀ ((Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀)))
          ((Spec.map (CommRingCat.ofHom e)) ω)) = x₀ := by
        have h2 := congrArg (fun f : Spec (.of (AlgebraicClosure (XA.residueField x₀))) ⟶ XA => f ω) he
        simp only [wcEtGeomPt, Scheme.Hom.comp_apply] at h2
        exact h2.trans (Scheme.fromSpecResidueField_apply _ _)
      rw [← hfc _ h1]
      exact h1
    obtain ⟨z₀, hz₀1, hz₀2⟩ := Scheme.Pullback.exists_preimage_pullback (f := a₀) (g := q)
      (IsLocalRing.closedPoint B₀) xs₀ (ha'.trans hxs₀.symm)
    have hspec : ∀ w : ↥(Limits.pullback a₀ q), w ⤳ e₀.inv (IsLocalRing.closedPoint C) := by
      intro w
      have h1 := (IsLocalRing.specializes_closedPoint (e₀.hom w)).map (Scheme.Hom.continuous e₀.inv)
      rwa [Scheme.hom_inv_apply] at h1
    have hc0 : Limits.pullback.fst a₀ q (e₀.inv (IsLocalRing.closedPoint C)) =
        IsLocalRing.closedPoint B₀ := by
      have h1 := (hspec z₀).map (Scheme.Hom.continuous (Limits.pullback.fst a₀ q))
      rw [hz₀1] at h1
      exact Set.mem_singleton_iff.mp
        (h1.mem_closed (IsLocalRing.isClosed_singleton_closedPoint B₀) (Set.mem_singleton _))
    constructor
    · intro hz
      apply hinj
      rw [hc0]
      apply hfc
      have hcond : a₀ (Limits.pullback.fst a₀ q z) = q (Limits.pullback.snd a₀ q z) := by
        rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
      rw [hcond, hz, hxs₀]
    · rintro rfl
      have h1 : z₀ = e₀.inv (IsLocalRing.closedPoint C) := hinj (hz₀1.trans hc0.symm)
      rw [← h1, hz₀2]


  have hiso : ∀ {S : Scheme.{u}} (N : ℕ) (O₁ O₂ : S.Opens), O₁ ⊓ O₂ = ⊥ →
      ∀ (K : SheafOfModules.{u+1} (wcEtZModRing S N))
        (ι : K ⟶ SheafOfModules.unit (wcEtZModRing S N))
        (κ : K.val.obj (Opposite.op (Scheme.Etale.mk (O₁ ⊔ O₂).ι))),
        (ι.val.app (Opposite.op (Scheme.Etale.mk (O₁ ⊔ O₂).ι))).hom κ =
          (1 : (wcEtZModRing S N).obj.obj (Opposite.op (Scheme.Etale.mk (O₁ ⊔ O₂).ι))) →
        (∀ M : SheafOfModules.{u+1} (wcEtZModRing S N), Function.Bijective
          (fun f : K ⟶ M => (f.val.app (Opposite.op (Scheme.Etale.mk (O₁ ⊔ O₂).ι))).hom κ)) →
        ∀ (P₁ P₂ : SheafOfModules.{u+1} (wcEtZModRing S N))
          (ev₁ : ∀ M : SheafOfModules.{u+1} (wcEtZModRing S N),
            (P₁ ⟶ M) ≃ M.val.obj (Opposite.op (Scheme.Etale.mk O₁.ι)))
          (ev₂ : ∀ M : SheafOfModules.{u+1} (wcEtZModRing S N),
            (P₂ ⟶ M) ≃ M.val.obj (Opposite.op (Scheme.Etale.mk O₂.ι))),
          (∀ (M M' : SheafOfModules.{u+1} (wcEtZModRing S N)) (ψ : M ⟶ M') (g : P₁ ⟶ M),
            ev₁ M' (g ≫ ψ) = (ψ.val.app (Opposite.op (Scheme.Etale.mk O₁.ι))).hom (ev₁ M g)) →
          (∀ (M M' : SheafOfModules.{u+1} (wcEtZModRing S N)) (ψ : M ⟶ M') (g : P₂ ⟶ M),
            ev₂ M' (g ≫ ψ) = (ψ.val.app (Opposite.op (Scheme.Etale.mk O₂.ι))).hom (ev₂ M g)) →
          ∃ j : P₁ ⊞ P₂ ⟶ K, IsIso j ∧ j ≫ ι = Limits.biprod.desc
            ((ev₁ (SheafOfModules.unit _)).symm (wcModUnitOne _ (Scheme.Etale.mk O₁.ι)))
            ((ev₂ (SheafOfModules.unit _)).symm (wcModUnitOne _ (Scheme.Etale.mk O₂.ι))) := by
    intro S N O₁ O₂ hO K ι κ hκ hcorep P₁ P₂ ev₁ ev₂ hnat₁ hnat₂
    have h₁ : O₁ ≤ O₁ ⊔ O₂ := le_sup_left
    have h₂ : O₂ ≤ O₁ ⊔ O₂ := le_sup_right
    obtain ⟨t₁, ht₁⟩ : ∃ t₁ : (Scheme.Etale.mk O₁.ι : S.Etale) ⟶ Scheme.Etale.mk (O₁ ⊔ O₂).ι,
        t₁.left = S.homOfLE h₁ := ⟨MorphismProperty.Over.homMk (S.homOfLE h₁) (S.homOfLE_ι h₁), rfl⟩
    obtain ⟨t₂, ht₂⟩ : ∃ t₂ : (Scheme.Etale.mk O₂.ι : S.Etale) ⟶ Scheme.Etale.mk (O₁ ⊔ O₂).ι,
        t₂.left = S.homOfLE h₂ := ⟨MorphismProperty.Over.homMk (S.homOfLE h₂) (S.homOfLE_ι h₂), rfl⟩
    obtain ⟨j₁, hj₁⟩ : ∃ j₁ : P₁ ⟶ K, ev₁ K j₁ = (K.val.map t₁.op).hom κ :=
      ⟨_, Equiv.apply_symm_apply _ _⟩
    obtain ⟨j₂, hj₂⟩ : ∃ j₂ : P₂ ⟶ K, ev₂ K j₂ = (K.val.map t₂.op).hom κ :=
      ⟨_, Equiv.apply_symm_apply _ _⟩
    have hr : ∀ (O : S.Opens) (h : O ≤ O₁ ⊔ O₂) (y : ↥(O₁ ⊔ O₂)),
        y ∈ Set.range (S.homOfLE h) ↔ y.1 ∈ O := by
      intro O h y
      constructor
      · rintro ⟨z, rfl⟩
        exact Eq.mpr (congrArg (fun b => b ∈ O) (Scheme.homOfLE_apply h z)) z.2
      · intro hy
        exact ⟨⟨y.1, hy⟩, Subtype.ext (Scheme.homOfLE_apply h _)⟩
    have hoi : ∀ (O : S.Opens) (h : O ≤ O₁ ⊔ O₂), IsOpenImmersion (S.homOfLE h) := by
      intro O h
      haveI : IsOpenImmersion (S.homOfLE h ≫ (O₁ ⊔ O₂).ι) := by
        rw [S.homOfLE_ι]; infer_instance
      exact IsOpenImmersion.of_comp _ (O₁ ⊔ O₂).ι
    refine ⟨Limits.biprod.desc j₁ j₂, ?_, ?_⟩
    · apply isIso_of_coyoneda_map_bijective
      intro M
      let Ti : Fin 2 → S.Etale := Fin.cases (Scheme.Etale.mk O₁.ι) (fun _ => Scheme.Etale.mk O₂.ι)
      let tt : ∀ i, Ti i ⟶ Scheme.Etale.mk (O₁ ⊔ O₂).ι :=
        @Fin.cases 1 (fun i => Ti i ⟶ Scheme.Etale.mk (O₁ ⊔ O₂).ι) t₁ (fun _ => t₂)
      have hρ := wc_et_disjoint_cover_bijective (Scheme.Etale.mk (O₁ ⊔ O₂).ι) 2 Ti tt
        (by
          intro i
          induction i using Fin.cases with
          | zero =>
            show IsOpenImmersion t₁.left
            rw [ht₁]
            exact hoi O₁ h₁
          | succ j =>
            show IsOpenImmersion t₂.left
            rw [ht₂]
            exact hoi O₂ h₂)
        (by
          have hd : Disjoint (Set.range t₁.left) (Set.range t₂.left) := by
            rw [ht₁, ht₂]
            refine Set.disjoint_left.mpr (fun y hy1 hy2 => ?_)
            have hy : y.1 ∈ O₁ ⊓ O₂ := ⟨(hr O₁ h₁ y).1 hy1, (hr O₂ h₂ y).1 hy2⟩
            rw [hO] at hy
            simpa using hy
          intro i j hij
          induction i using Fin.cases with
          | zero =>
            induction j using Fin.cases with
            | zero => exact absurd rfl hij
            | succ j => exact hd
          | succ i =>
            induction j using Fin.cases with
            | zero => exact hd.symm
            | succ j => exact absurd (by rw [Subsingleton.elim i j]) hij)
        (by
          intro y
          rcases TopologicalSpace.Opens.mem_sup.mp y.2 with h | h
          · refine ⟨0, ?_⟩
