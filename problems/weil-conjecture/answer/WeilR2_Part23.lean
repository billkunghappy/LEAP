      (Opposite.op ((wcEtBaseChange (Limits.pullback.fst fZ ξ)).obj (W'.obj l).right)) :=
    ((T.f (n : ℤ)).val.app (Opposite.op (W'.obj l).right)).hom c1
  have hTx : ((I.cochainComplex.d (n : ℤ) ((n : ℤ) + 1)).val.app
      (Opposite.op ((wcEtBaseChange (Limits.pullback.fst fZ ξ)).obj (W'.obj l).right))).hom Tx = 0 := by
    have h1 := congrArg (fun φ => (φ.val.app (Opposite.op (W'.obj l).right)).hom c1)
