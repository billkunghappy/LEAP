theorem wc_etqm_sr_ss_milnor_pull_fixed (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) (k : ℕ) (hk : 1 ≤ k) (π : A)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    (Z : Scheme.{u}) (fZ : Z ⟶ Spec (.of A))
    (hcov : ∀ z : Z, ∃ (U : Z.Opens) (r : ℕ)
      (g : U.toScheme ⟶ Spec (.of (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))),
      z ∈ U ∧ Etale g ∧
      g ≫ wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) = U.ι ≫ fZ)
    (x : Z) (hx : fZ x = IsLocalRing.closedPoint A)
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Z x)) (Scheme.Etale.forget Z))
    (φl : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Z)
    (hsh : wcHalShData x B Λ W' φl a)
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A))
    (hφπ : (Spec.preimage ξ).hom π ≠ 0)
    (σ : Spec (.of Ω) ⟶ Spec (.of Ω)) (hσ : σ ≫ ξ = ξ)
    (E : wcEtPullData (Limits.pullback.lift (Limits.pullback.fst (a ≫ fZ) ξ)
          (Limits.pullback.snd (a ≫ fZ) ξ ≫ σ)
          (by rw [Category.assoc, hσ]; exact Limits.pullback.condition)) (ℓ ^ k))
    (y : wcEtZModExt (Limits.pullback (a ≫ fZ) ξ) (ℓ ^ k) 1) :
    wcEtPull E 1 y = y :=
by
  classical
  have hp : Nat.Prime ℓ := Fact.out

  obtain ⟨φ, hφdef⟩ : ∃ φ : A →+* Ω, φ = (Spec.preimage ξ).hom := ⟨_, rfl⟩
  have hφπ' : φ π ≠ 0 := by rw [hφdef]; exact hφπ
  have hirr : Irreducible π := (IsDiscreteValuationRing.irreducible_iff_uniformizer π).mpr hπ
  have hinj : Function.Injective φ := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    by_contra hx0
    obtain ⟨n, v, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hx0 hirr
    rw [map_mul, map_pow] at hx
    exact mul_ne_zero (v.isUnit.map φ).ne_zero (pow_ne_zero n hφπ') hx
  have hξ : Spec.map (CommRingCat.ofHom φ) = ξ := by
    rw [hφdef]; exact Spec.map_preimage ξ

  obtain ⟨r, c, hWc, hcf, hcase⟩ :=
    wc_etqm_mpf_milnor_h1_shape A ℓ hℓ k hk π hπ Z fZ hcov x hx B Λ W' φl a hsh Ω ξ hφπ
  rcases hcase with ⟨hx0, hx1, hfin, hcard⟩ | hsub
  swap
  · exact Subsingleton.elim _ _

  have hMA : IsUnit ((ℓ ^ k : ℕ) : A) := by rw [Nat.cast_pow]; exact hℓ.pow k
  have hℓΩ : IsUnit ((ℓ : ℕ) : Ω) := by rw [← map_natCast φ]; exact hℓ.map φ
  have hMΩ : ((ℓ ^ k : ℕ) : Ω) ≠ 0 := by rw [Nat.cast_pow]; exact (hℓΩ.pow k).ne_zero
  have hℓX : IsUnit ((ℓ : ℕ) : Γ(Limits.pullback (a ≫ fZ) ξ, ⊤)) := by
    have h := hℓΩ.map ((Limits.pullback.snd (a ≫ fZ) ξ).appTop.hom.comp
      (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom)
    rwa [map_natCast] at h

  have hT : IsPullback (Limits.pullback.fst (a ≫ fZ) ξ) (Limits.pullback.snd (a ≫ fZ) ξ)
      (c ≫ wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
      (Spec.map (CommRingCat.ofHom φ)) :=
    (IsPullback.of_hasPullback (a ≫ fZ) ξ).of_iso (Iso.refl _) (Iso.refl _) (Iso.refl _)
      (Iso.refl _) (by simp) (by simp) (by simp [hcf]) (by simp [hξ])

  obtain ⟨U, hU⟩ := wc_qsfx_uq_isUnit A π hπ r B c Ω φ hinj _ _ _ hT
  obtain ⟨ζ, hζ⟩ := wc_qsfx_prim_root_A A (ℓ ^ k) (pow_pos hp.pos k) hMA
  have hζΩ : IsPrimitiveRoot (φ ζ) (ℓ ^ k) := hζ.map_of_injective hinj
  obtain ⟨zX, hzX⟩ : ∃ z : Γ(Limits.pullback (a ≫ fZ) ξ, ⊤),
      z = (Limits.pullback.snd (a ≫ fZ) ξ).appTop.hom
        ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom (φ ζ)) := ⟨_, rfl⟩
  have hzXM : zX ^ (ℓ ^ k) = 1 := by
    rw [hzX, ← map_pow, ← map_pow, hζΩ.pow_eq_one, map_one, map_one]
  have hzXu : ∀ i : ℕ, 0 < i → i < ℓ ^ k → IsUnit (1 - zX ^ i) := by
    intro i hi0 hiM
    have h1 : (φ ζ) ^ i ≠ 1 := hζΩ.pow_ne_one_of_pos_of_lt hi0.ne' hiM
    have h2 : IsUnit (1 - (φ ζ) ^ i) := (sub_ne_zero.mpr (Ne.symm h1)).isUnit
    have h3 := h2.map ((Limits.pullback.snd (a ≫ fZ) ξ).appTop.hom.comp
      (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom)
    rw [map_sub, map_one, map_pow, RingHom.comp_apply] at h3
    rw [hzX]
    exact h3

  set w := Limits.pullback.lift (Limits.pullback.fst (a ≫ fZ) ξ)
          (Limits.pullback.snd (a ≫ fZ) ξ ≫ σ)
          (by rw [Category.assoc, hσ]; exact Limits.pullback.condition) with hwdef
  have hw1 : w ≫ Limits.pullback.fst (a ≫ fZ) ξ = Limits.pullback.fst (a ≫ fZ) ξ :=
    Limits.pullback.lift_fst _ _ _
  have hw2 : w ≫ Limits.pullback.snd (a ≫ fZ) ξ = Limits.pullback.snd (a ≫ fZ) ξ ≫ σ :=
    Limits.pullback.lift_snd _ _ _
  have hwq_fix : ∀ t, w.appTop.hom ((Limits.pullback.fst (a ≫ fZ) ξ).appTop.hom t) =
      (Limits.pullback.fst (a ≫ fZ) ξ).appTop.hom t := by
    intro t
    have h1 := congrArg (fun f : Limits.pullback (a ≫ fZ) ξ ⟶ Spec (.of B) => f.appTop.hom t) hw1
    simpa only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] using h1
  have hwu : w.appTop.hom (U : Γ(Limits.pullback (a ≫ fZ) ξ, ⊤)) = U := by
    rw [hU]; exact hwq_fix _
  obtain ⟨σ', hσ'def⟩ : ∃ σ' : Ω →+* Ω, σ' = (Spec.preimage σ).hom := ⟨_, rfl⟩
  have hσmap : Spec.map (CommRingCat.ofHom σ') = σ := by
    rw [hσ'def]; exact Spec.map_preimage σ
  have hσφ : σ'.comp φ = φ := by
    have h1 : Spec.map (CommRingCat.ofHom φ ≫ CommRingCat.ofHom σ') =
        Spec.map (CommRingCat.ofHom φ) := by
      rw [Spec.map_comp, hσmap, hξ, hσ]
    have h3 := congrArg CommRingCat.Hom.hom (Spec.map_injective h1)
    simpa only [CommRingCat.hom_comp, CommRingCat.hom_ofHom] using h3
  have hwz : (w ≫ Limits.pullback.snd (a ≫ fZ) ξ).appTop.hom
        ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom (φ ζ)) =
      (Limits.pullback.snd (a ≫ fZ) ξ).appTop.hom
        ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom (φ ζ)) := by
    rw [hw2, ← hσmap]
    have e2 := congrArg (fun f => f.hom (φ ζ))
      (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom σ'))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at e2
    have e3 : σ' (φ ζ) = φ ζ := congrArg (fun f => f ζ) hσφ
    rw [e3] at e2
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
    rw [← e2]

  obtain ⟨κ, hκa, hκb⟩ := wc_etqm_mpf_kummer_class_fixed Ω _ (Limits.pullback.snd (a ≫ fZ) ξ) w
    (ℓ ^ k) hMΩ (φ ζ) hζΩ hwz U hwu

  have hne : (ℓ ^ (k - 1)) • κ ≠ 0 := by
    intro h0
    obtain ⟨t, ht⟩ := hκa _ h0
    obtain ⟨w₀, hw₀⟩ := wc_qsfx_root_of_pow _ ℓ hp hℓX k hk zX hzXM hzXu U t ht.symm
    exact wc_etqm_mpf_x0_not_pow A ℓ hℓ π hπ r B c hWc hx0 hx1 Ω φ hinj _ _ _ hT
      ⟨w₀, hw₀.trans hU⟩

  haveI := hfin
  have hdvd : addOrderOf κ ∣ ℓ ^ k := by
    have h := addOrderOf_dvd_natCard κ
    rw [hcard] at h
    exact h
  obtain ⟨j, hj, hj'⟩ := (Nat.dvd_prime_pow hp).mp hdvd
  have hjk : j = k := by
    by_contra hne'
    apply hne
    apply addOrderOf_dvd_iff_nsmul_eq_zero.mp
    rw [hj']
    exact pow_dvd_pow ℓ (by omega)
  have hord : addOrderOf κ = ℓ ^ k := by rw [hj', hjk]
  have htop : AddSubgroup.zmultiples κ = ⊤ :=
    AddSubgroup.eq_top_of_card_eq _ (by rw [Nat.card_zmultiples, hord, hcard])
  obtain ⟨n, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp (htop ▸ AddSubgroup.mem_top y)
  rw [map_zsmul]
  exact congrArg (fun z => n • z) (hκb _)

