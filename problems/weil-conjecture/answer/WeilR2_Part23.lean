theorem wc_etqmt_pull_map_zero_of_stalks : ∀ {S S' : Scheme.{u}} (g : S' ⟶ S) (n : ℕ)
    (D : wcEtPullData g n) {F G : SheafOfModules.{u+1} (wcEtZModRing S n)} (f : F ⟶ G),
    (∀ s' : S', (wcEtStalk S (g s')).map ((SheafOfModules.toSheaf (wcEtZModRing S n)).map f) = 0) →
    D.Φ.map f = 0 :=
by
  intro S S' g n D F G f hstk
  haveI : Limits.PreservesFiniteColimits (SheafOfModules.toSheaf (wcEtZModRing S n)) :=
    sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.smallEtaleTopology S)
      (wcEtZModRing S n)
  have hI : ∀ s : S', Limits.IsZero ((wcEtStalk S (g s)).obj
      ((SheafOfModules.toSheaf (wcEtZModRing S n)).obj (Limits.image f))) := by
    intro s
