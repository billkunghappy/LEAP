      intro c b
      rw [hsmulT, hsmulL, map_nsmul, AddMonoidHom.nsmul_apply, hy₀, AddEquiv.apply_symm_apply]
    have hk : ∀ b, r₀ b = 0 ↔ y₀ b = 0 := by
      intro b
