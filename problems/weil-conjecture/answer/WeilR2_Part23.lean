    (hℓ : IsUnit ((ℓ : ℕ) : A)) (k : ℕ) (hk : 1 ≤ k) (n : ℕ) (hn : Even n) (hn4 : 4 ≤ n) (π : A)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
