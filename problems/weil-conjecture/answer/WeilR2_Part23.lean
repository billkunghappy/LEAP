    congr 1
    rw [← cancel_mono (L.iCycles 0), Category.assoc, HomologicalComplex.cyclesMap_i,
      HomologicalComplex.singleObjCyclesSelfIso_inv_iCycles_assoc, ha, Iso.inv_hom_id_assoc,
      Category.assoc, hγ, hkk]

  let u := @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
    (wcEtBaseChange (Limits.pullback.fst (wcQuadModelStr A n π c) ξ)) _ _ Dh.cont Dh.φ
  let w := Dg.μ.inv ≫ Dg.Φ.map u

  have hf : eΨ.f 0 = (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 _).hom ≫ w ≫
      (P ⋙ Dg.Φ).map ((HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 _).inv ≫
