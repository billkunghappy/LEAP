    rw [Iso.refl_hom, Category.id_comp, he]
  obtain ⟨Ψ⟩ := s2 (AddMonoidAlgebra.mapDomainRingHom L
    (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom) ap T.πi T.gi T.g₀ T.hT
    (Iso.refl _) e he'
  obtain ⟨E0⟩ := wc_et_coh_iso_invariance ((Limits.pullbackSymmetry T.πi ap) ≪≫ Ψ).hom ℓ (j + 1)
  refine @Equiv.subsingleton _ _ E0.symm
    (wc_qmtm_kummer_ring_tower_coh ℓ hℓL e (e (LaurentPolynomial.T 1)) rfl j ?_)
  intro k' x
  refine ⟨0, fun β _ _ E' => ?_⟩
  have hS := stage C e k' j
  obtain ⟨Eq⟩ := wc_et_zmodext_coh_equiv (Spec (.of (AdjoinRoot (Polynomial.X ^ (ℓ ^ k') -
    Polynomial.C (e (LaurentPolynomial.T 1)))))) ℓ (j + 1)
  haveI := @Equiv.subsingleton _ _ Eq hS
  rw [Subsingleton.elim x 0, map_zero]

