    refine ⟨?_, ?_⟩
    ·
      rw [Ideal.map_span, hGen0, hφ0]
      apply le_antisymm
      · rw [Ideal.span_le]
        rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
        rw [hGen]
        set p : Fin (r + 2) := ⟨2 * (i.val / 2), lt_of_le_of_lt (Nat.mul_div_le i.val 2) i.isLt⟩
