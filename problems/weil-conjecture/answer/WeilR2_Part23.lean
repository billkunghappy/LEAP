    refine ⟨HomologicalComplex.singleObjHomologySelfIso (ComplexShape.up ℤ) 0 M,
      (asIso (γ ≫ L.homologyπ 0)).symm, ?_⟩
    rw [Iso.symm_hom, asIso_inv, IsIso.comp_inv_eq, Category.assoc, ← Iso.inv_comp_eq,
      ← HomologicalComplex.singleObjCyclesSelfIso_inv_homologyπ, Category.assoc,
