theorem wc_etqmt_tower_push_acyclic {A B L : Type u} [CommRing A] [CommRing B] [Field L] [IsSepClosed L] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓL : IsUnit ((ℓ : ℕ) : L)) (φA : A →+* L) (σ : L →+* L) {XE : Scheme.{u}} (p : XE ⟶ Spec (.of B)) (q : XE ⟶ Spec (.of L)) (w : XE ⟶ XE) (x₀ : B) (T : wcQmtmTower ℓ φA σ p q w x₀) (k : ℕ) (hk : 1 ≤ k) (Dπ : wcEtPullData T.πi (ℓ ^ k)) (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing T.XEi (ℓ ^ k)))) :
    haveI := Dπ.additive
    haveI : (wcEtqmtP Dπ).Additive := Adjunction.right_adjoint_additive Dπ.adj
    ∀ m : ℕ, Limits.IsZero ((((wcEtqmtP Dπ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology (m + 1)) :=
by
  intro m
  classical
  have hℓpos : 0 < ℓ := (Fact.out : ℓ.Prime).pos
  have hn0 : ℓ ^ k ≠ 0 := pow_ne_zero k (Fact.out : ℓ.Prime).ne_zero
  haveI hπaff : IsAffineHom T.πi :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) T.hT.flip (isAffineHom_of_isAffine _)

  have stage : ∀ (C : Type u) [CommRing C] [HenselianLocalRing C]
      [IsSepClosed (IsLocalRing.ResidueField C)] (e : LaurentPolynomial L →+* C) (k' j : ℕ),
      Subsingleton (wcEtCoh (Spec (.of (AdjoinRoot (Polynomial.X ^ (ℓ ^ k') -
        Polynomial.C (e (LaurentPolynomial.T 1)))))) ℓ (j + 1)) := by
    intro C _ _ _ e k' j
    have hN : 0 < ℓ ^ k' := pow_pos hℓpos k'
    have hℓC : IsUnit ((ℓ : ℕ) : C) := by
      have h := hℓL.map (e.comp LaurentPolynomial.C)
      rwa [map_natCast] at h
    have hNC : IsUnit (((ℓ ^ k' : ℕ)) : C) := by
      rw [Nat.cast_pow]; exact hℓC.pow k'
    have ha : IsUnit (e (LaurentPolynomial.T 1)) := (LaurentPolynomial.isUnit_T 1).map e
    obtain ⟨v, hv⟩ := wc_henselian_sepclosed_unit_pow_root C (ℓ ^ k') hN hNC _ ha
    have hvu : IsUnit v := (isUnit_pow_iff hN.ne').mp (by rw [hv]; exact ha)
    have hNL : (((ℓ ^ k' : ℕ)) : L) ≠ 0 := by
      rw [Nat.cast_pow]; exact (hℓL.pow k').ne_zero
    haveI : NeZero (((ℓ ^ k' : ℕ)) : L) := ⟨hNL⟩
    haveI := IsSepClosed.hasEnoughRootsOfUnity L (ℓ ^ k')
    obtain ⟨ζL, hζL⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot L (ℓ ^ k')
    have hζN : (e.comp LaurentPolynomial.C) ζL ^ (ℓ ^ k') = 1 := by
      rw [← map_pow, hζL.pow_eq_one, map_one]
    have hdiff : ∀ i j : ℕ, i < ℓ ^ k' → j < ℓ ^ k' → i ≠ j →
        IsUnit ((e.comp LaurentPolynomial.C) ζL ^ i - (e.comp LaurentPolynomial.C) ζL ^ j) := by
      intro i j hi hj hij
      have hne : ζL ^ i - ζL ^ j ≠ 0 := sub_ne_zero.mpr (fun h => hij (hζL.pow_inj hi hj h))
      have h1 := (Ne.isUnit hne).map (e.comp LaurentPolynomial.C)
      rw [map_sub, map_pow, map_pow] at h1
      exact h1
    obtain ⟨Φ⟩ := wc_adjoinRoot_X_pow_sub_C_pow_split C (ℓ ^ k') hN
      ((e.comp LaurentPolynomial.C) ζL) v hζN hdiff hvu
    rw [← hv]
    have hC : Subsingleton (wcEtCoh (Spec (.of C)) ℓ (j + 1)) :=
      wc_et_strictly_local_ext_vanishing C
        ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of C))) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) j
    have H := wc_et_coh_pi_fin_of_prod ℓ (j + 1)
      (fun S S' _ _ h₁ h₂ => wc_et_coh_prod_ring_subsingleton S S' ℓ (j + 1) hℓpos h₁ h₂)
      C hC (ℓ ^ k') (Nat.one_le_iff_ne_zero.mpr hN.ne')
    obtain ⟨E⟩ := wc_et_coh_iso_invariance (Spec.map Φ.toCommRingCatIso.hom) ℓ (j + 1)
    exact @Equiv.subsingleton _ _ E H

  have s2 : ∀ {G₀ G M : Type u} [CommRing G₀] [CommRing G] [CommRing M]
      (ι : G₀ →+* G) {P XE XEi : Scheme.{u}} (s : P ⟶ XE) (πi : XEi ⟶ XE)
