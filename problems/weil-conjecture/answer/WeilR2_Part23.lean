  refine ⟨(Abelian.Ext.mk₀ c').comp ((Abelian.Ext.mapExactFunctor Dg'.Φ x').comp
    (Abelian.Ext.mk₀ Dg'.μ.hom) (add_zero M)) (zero_add M), ?_⟩
  intro V ZV YOV iV _ gOV _ hrV f w hw DV Ef γ hγ Dw b hb
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing V m)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing YOV m)) := HasExt.standard _
