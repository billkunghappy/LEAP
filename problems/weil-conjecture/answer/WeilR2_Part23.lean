      rfl
    refine ⟨(e k0).opensRange, r, (e k0).isoOpensRange.inv, (e k0).isoOpensRange.hom y0,
      inferInstance, ?_, ?_, ?_⟩
    · rw [hι k0, Category.assoc, ← Category.assoc (e k0), he_comp k0, KE k0]
    · rw [hy0]
      exact Ideal.subset_span ⟨⟨0, by omega⟩, rfl⟩
    · rw [hy0]
      exact Ideal.subset_span ⟨⟨1, by omega⟩, rfl⟩

theorem wc_etqm_sr_ss_cone_ge_one (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) (k : ℕ) (π : A) (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    (Z : Scheme.{u}) (fZ : Z ⟶ Spec (.of A))
    (hcov : ∀ z : Z, ∃ (U : Z.Opens) (r : ℕ)
      (g : U.toScheme ⟶ Spec (.of (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))),
      z ∈ U ∧ Etale g ∧
      g ≫ wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) = U.ι ≫ fZ)
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A))
    (hφπ : (Spec.preimage ξ).hom π ≠ 0)
    (Dh : wcEtPullData (Limits.pullback.fst fZ ξ) (ℓ ^ k))
    (Dg : wcEtPullData (Limits.pullback.fst fZ (wcQmSp A)) (ℓ ^ k))
    (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing (Limits.pullback fZ ξ) (ℓ ^ k)))) :
    haveI := Dg.additive
    haveI := Dh.additive
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst fZ ξ)) _ _ Dh.cont Dh.φ
    haveI : P.Additive := Adjunction.right_adjoint_additive Dh.adj
    let eK := (HomologicalComplex.single (SheafOfModules.{u+1} (wcEtZModRing Z (ℓ ^ k))) (ComplexShape.up ℤ) 0).map
          (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst fZ ξ)) _ _ Dh.cont Dh.φ) ≫
        (HomologicalComplex.singleMapHomologicalComplex P (ComplexShape.up ℤ) 0).inv.app
          (SheafOfModules.unit (wcEtZModRing (Limits.pullback fZ ξ) (ℓ ^ k))) ≫
        (P.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι'
    let eΨ := (HomologicalComplex.single (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback fZ (wcQmSp A)) (ℓ ^ k))) (ComplexShape.up ℤ) 0).map
          Dg.μ.inv ≫
        (HomologicalComplex.singleMapHomologicalComplex Dg.Φ (ComplexShape.up ℤ) 0).inv.app
          (SheafOfModules.unit (wcEtZModRing Z (ℓ ^ k))) ≫
        (Dg.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map eK
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback fZ (wcQmSp A)) (ℓ ^ k)))
    (DerivedCategory.Q.obj (CochainComplex.mappingCone eΨ)).IsGE 1 :=
by
  classical

  have cone_ge_one : ∀ {𝒞 : Type (u+2)} [Category.{u+1} 𝒞] [Abelian 𝒞] [HasDerivedCategory 𝒞]
      (O : 𝒞) (Ψ : CochainComplex 𝒞 ℤ)
      (e : (HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj O ⟶ Ψ)
      (_h0 : IsIso (HomologicalComplex.homologyMap e 0))
      (_hq : ∀ q : ℤ, q < 0 → Limits.IsZero (Ψ.homology q)),
      (DerivedCategory.Q.obj (CochainComplex.mappingCone e)).IsGE 1 := by
    intro 𝒞 _ _ _ O Ψ e h0 hq
    let T := DerivedCategory.Q.mapTriangle.obj (CochainComplex.mappingCone.triangle e)
    have hT : T ∈ Pretriangulated.distinguishedTriangles :=
      DerivedCategory.mappingCone_triangle_distinguished e
    have hA : ∀ q : ℤ, q ≠ 0 →
        Limits.IsZero ((DerivedCategory.homologyFunctor 𝒞 q).obj T.obj₁) := by
      intro q hq0
      exact Limits.IsZero.of_iso
        (HomologicalComplex.isZero_single_obj_homology _ _ _ _ hq0)
        ((DerivedCategory.homologyFunctorFactors 𝒞 q).app _)
    have hΨ : ∀ q : ℤ, q < 0 →
        Limits.IsZero ((DerivedCategory.homologyFunctor 𝒞 q).obj T.obj₂) := by
      intro q hqn
      exact Limits.IsZero.of_iso (hq q hqn)
        ((DerivedCategory.homologyFunctorFactors 𝒞 q).app _)
    have hm0 : IsIso ((DerivedCategory.homologyFunctor 𝒞 0).map T.mor₁) := by
      have hnat := (DerivedCategory.homologyFunctorFactors 𝒞 0).hom.naturality e
      have h0' : IsIso ((HomologicalComplex.homologyFunctor 𝒞 (ComplexShape.up ℤ) 0).map e) := h0
      have h2 : IsIso ((DerivedCategory.Q ⋙ DerivedCategory.homologyFunctor 𝒞 0).map e ≫
          (DerivedCategory.homologyFunctorFactors 𝒞 0).hom.app Ψ) := by
        rw [hnat]; infer_instance
      have h3 : IsIso ((DerivedCategory.Q ⋙ DerivedCategory.homologyFunctor 𝒞 0).map e) :=
        IsIso.of_isIso_comp_right _ ((DerivedCategory.homologyFunctorFactors 𝒞 0).hom.app Ψ)
      exact h3
    have hX : ∀ q : ℤ, q < 1 →
        Limits.IsZero ((DerivedCategory.homologyFunctor 𝒞 q).obj T.obj₃) := by
      intro q hq1
      have E3 := DerivedCategory.HomologySequence.exact₃ T hT q (q + 1) rfl
      by_cases hq0 : q = 0
      · subst hq0
        have E2 := DerivedCategory.HomologySequence.exact₂ T hT 0
        apply E3.isZero_of_both_zeros
        · exact E2.epi_f_iff.mp
            (inferInstance : Epi ((DerivedCategory.homologyFunctor 𝒞 0).map T.mor₁))
        · exact (hA 1 (by norm_num)).eq_of_tgt _ _
      by_cases hqm : q = -1
      · subst hqm
        have E1 := DerivedCategory.HomologySequence.exact₁ T hT (-1) 0 (by norm_num)
        apply E3.isZero_of_both_zeros
        · exact (hΨ (-1) (by norm_num)).eq_of_src _ _
        · exact E1.mono_g_iff.mp
            (inferInstance : Mono ((DerivedCategory.homologyFunctor 𝒞 0).map T.mor₁))
      · apply E3.isZero_of_both_zeros
        · exact (hΨ q (by omega)).eq_of_src _ _
        · exact (hA (q + 1) (by omega)).eq_of_tgt _ _
    have hGE : T.obj₃.IsGE 1 := by
      rw [DerivedCategory.isGE_iff]
      intro q hq
      exact hX q hq
    exact hGE

  have homology_transfer : ∀ {𝒜 𝒜' ℬ : Type (u+2)} [Category.{u+1} 𝒜] [Category.{u+1} 𝒜']
      [Category.{u+1} ℬ] [Abelian 𝒜] [Abelian 𝒜'] [Abelian ℬ]
      (P : 𝒜' ⥤ 𝒜) [P.Additive] [Limits.PreservesFiniteLimits P]
      (G : 𝒜 ⥤ ℬ) [G.Additive] [Limits.PreservesFiniteLimits G]
      [Limits.PreservesFiniteColimits G]
      {O : 𝒜} {O' : 𝒜'} {Os : ℬ} (u : O ⟶ P.obj O') (μ : G.obj O ≅ Os)
      (I : InjectiveResolution O'),
      let eK := (HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map u ≫
        (HomologicalComplex.singleMapHomologicalComplex P (ComplexShape.up ℤ) 0).inv.app O' ≫
        (P.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι'
      let eΨ := (HomologicalComplex.single ℬ (ComplexShape.up ℤ) 0).map μ.inv ≫
        (HomologicalComplex.singleMapHomologicalComplex G (ComplexShape.up ℤ) 0).inv.app O ≫
        (G.mapHomologicalComplex (ComplexShape.up ℤ)).map eK
      let Ψ := (G.mapHomologicalComplex (ComplexShape.up ℤ)).obj
        ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex)
      (∀ q : ℤ, q < 0 → Limits.IsZero (Ψ.homology q)) ∧
      (IsIso (G.map u) → IsIso (HomologicalComplex.homologyMap eΨ 0)) := by
    intro 𝒜 𝒜' ℬ _ _ _ _ _ _ P _ _ G _ _ _ O O' Os u μ I eK eΨ Ψ
    have hneg : ∀ q : ℤ, q < 0 → Limits.IsZero (Ψ.X q) := by
      intro q hq
      exact G.map_isZero
        (P.map_isZero (CochainComplex.isZero_of_isStrictlyGE I.cochainComplex 0 q hq))
    refine ⟨?_, ?_⟩
    · intro q hq
      exact (Ψ.sc q).isZero_homology_of_isZero_X₂ (hneg q hq)
    · intro hu
      let S := (HomologicalComplex.single ℬ (ComplexShape.up ℤ) 0).obj Os
      have hnext : (ComplexShape.up ℤ).next 0 = 1 := by simp
      have hprev : (ComplexShape.up ℤ).prev 0 = -1 := by simp
      let F := P ⋙ G
      have hk := I.exact₀.fIsKernel
      have hkF := Limits.KernelFork.mapIsLimit _ hk F
      let cXI0 := I.cochainComplexXIso 0 0 rfl
      let cXI1 := I.cochainComplexXIso 1 1 rfl
      have hd : Ψ.d 0 1 = F.map (cXI0.hom ≫ I.cocomplex.d 0 1 ≫ cXI1.inv) := by
        show G.map (P.map (I.cochainComplex.d 0 1)) = _
        rw [I.cochainComplex_d 0 1 0 1 rfl rfl]
        rfl
      have hlim := Limits.KernelFork.isLimitOfIsLimitOfIff hkF (Ψ.d 0 1) (F.mapIso cXI0.symm)
        (by
          intro W f
          rw [hd, F.map_comp, F.map_comp]
          simp only [Functor.mapIso_hom, Iso.symm_hom]
          rw [← F.map_comp_assoc, cXI0.inv_hom_id, F.map_id, Category.id_comp]
          constructor
          · intro h; simp [reassoc_of% h]
          · intro h
            rw [← cancel_mono (F.map cXI1.inv), Category.assoc, h, Limits.zero_comp])
      let κ : G.obj (P.obj O') ⟶ Ψ.X 0 := G.map (P.map (I.ι.f 0 ≫ cXI0.inv))
      have hf : eΨ.f 0 = (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 Os).hom ≫
          μ.inv ≫ G.map u ≫ κ := by
        simp [eΨ, eK, κ, HomologicalComplex.single_map_f_self,
          HomologicalComplex.singleMapHomologicalComplex_inv_app_self,
          InjectiveResolution.ι'_f_zero]
        rfl
      let c := (Ψ.cyclesIsKernel 0 1 hnext).conePointUniqueUpToIso hlim
      let ci : G.obj (P.obj O') ⟶ Ψ.cycles 0 := c.inv
      haveI : IsIso ci := (inferInstance : IsIso c.inv)
      have hc : ci ≫ Ψ.iCycles 0 = κ := by
        have h1 := Limits.IsLimit.conePointUniqueUpToIso_inv_comp
          (Ψ.cyclesIsKernel 0 1 hnext) hlim Limits.WalkingParallelPair.zero
        refine h1.trans ?_
        change F.map (I.ι.f 0) ≫ F.map cXI0.inv = _
        exact ((congrArg G.map (P.map_comp _ _)).trans (G.map_comp _ _)).symm
      have hcyc : HomologicalComplex.cyclesMap eΨ 0 = S.iCycles 0 ≫
          ((HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 Os).hom ≫ μ.inv ≫
            G.map u ≫ ci) := by
        rw [← cancel_mono (Ψ.iCycles 0), HomologicalComplex.cyclesMap_i, hf]
        simp only [Category.assoc, hc]
        rfl
      have hS1 : S.d 0 1 = 0 :=
        (HomologicalComplex.isZero_single_obj_X _ _ _ 1 (by decide)).eq_of_tgt _ _
      have hSm : S.d (-1) 0 = 0 :=
        (HomologicalComplex.isZero_single_obj_X _ _ _ (-1) (by decide)).eq_of_src _ _
      haveI : IsIso (S.iCycles 0) := HomologicalComplex.isIso_iCycles S 0 1 hnext hS1
      haveI : IsIso (S.homologyπ 0) := HomologicalComplex.isIso_homologyπ S (-1) 0 hprev hSm
      haveI : IsIso (Ψ.homologyπ 0) := HomologicalComplex.isIso_homologyπ Ψ (-1) 0 hprev
        ((hneg (-1) (by norm_num)).eq_of_src _ _)
      haveI : IsIso (G.map u) := hu
      haveI : IsIso (HomologicalComplex.cyclesMap eΨ 0) := by
        rw [hcyc]
        infer_instance
      have h2 : IsIso (S.homologyπ 0 ≫ HomologicalComplex.homologyMap eΨ 0) := by
        rw [HomologicalComplex.homologyπ_naturality]; infer_instance
      exact IsIso.of_isIso_comp_left (S.homologyπ 0) _

  have hresG : ∀ (R : Type u) [CommRing R] [IsLocalRing R]
      (x : Spec (.of (IsLocalRing.ResidueField R))),
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)) x = IsLocalRing.closedPoint R := by
    intro R _ _ x
    rw [Spec.map_apply]
    exact (congrArg (PrimeSpectrum.comap (IsLocalRing.residue R))
      (Subsingleton.elim (α := PrimeSpectrum (IsLocalRing.ResidueField R)) x _)).trans
      ((IsLocalRing.isLocalHom_iff_comap_closedPoint (IsLocalRing.residue R)).mp inferInstance)

  obtain ⟨φ, hφdef⟩ : ∃ φ : A →+* Ω, φ = (Spec.preimage ξ).hom := ⟨_, rfl⟩
  have hφπ' : φ π ≠ 0 := by rw [hφdef]; exact hφπ
  have hirr : Irreducible π := (IsDiscreteValuationRing.irreducible_iff_uniformizer π).mpr hπ
  have hinj : Function.Injective φ := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    by_contra hx0
    obtain ⟨n, v, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hx0 hirr
    rw [map_mul, map_pow] at hx
    exact mul_ne_zero (v.isUnit.map φ).ne_zero (pow_ne_zero n hφπ') hx
  have hξ : Spec.map (CommRingCat.ofHom φ) = ξ := by
    rw [hφdef]; exact Spec.map_preimage ξ

  have hmilnor : ∀ (x : Z), fZ x = IsLocalRing.closedPoint A →
      ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
        (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
        (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Z x)) (Scheme.Etale.forget Z))
        (φl : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Z),
        wcHalShData x B Λ W' φl a → ConnectedSpace ↥(Limits.pullback (a ≫ fZ) ξ) := by
    intro x hx B _ _ _ Λ _ _ W' φl a hsh

    have ha0 : a (IsLocalRing.closedPoint B) = x := by
      obtain ⟨-, -, -, -, -, e, -, he⟩ := hsh
      have h2 : (Spec.map (CommRingCat.ofHom e) ≫
          Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)) ≫ a)
            (IsLocalRing.closedPoint (AlgebraicClosure (Z.residueField x))) =
          a (IsLocalRing.closedPoint B) :=
        (Scheme.Hom.comp_apply _ _ _).trans ((Scheme.Hom.comp_apply _ _ _).trans
          (congrArg a (hresG B _)))
      have h3 : wcEtGeomPt Z x (IsLocalRing.closedPoint (AlgebraicClosure (Z.residueField x))) = x :=
        (Scheme.Hom.comp_apply _ _ _).trans (Scheme.fromSpecResidueField_apply x _)
      have h4 := congrArg (fun m : Spec (.of (AlgebraicClosure (Z.residueField x))) ⟶ Z =>
        m (IsLocalRing.closedPoint (AlgebraicClosure (Z.residueField x)))) he
      exact h2.symm.trans (h4.trans h3)

    have hWa : WeaklyEtale a := wc_shdata_weaklyEtale x B Λ W' φl a hsh

    obtain ⟨U, r, g, hxU, hg, hgf⟩ := hcov x
    have hrange : Set.range a ⊆ Set.range U.ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨t, rfl⟩
      have h1 : a t ⤳ a (IsLocalRing.closedPoint B) :=
        (IsLocalRing.specializes_closedPoint t).map a.continuous
      rw [ha0] at h1
      exact h1.mem_open U.isOpen hxU
    obtain ⟨c'', hfac⟩ : ∃ c'' : Spec (.of B) ⟶ U.toScheme, c'' ≫ U.ι = a :=
      ⟨_, IsOpenImmersion.lift_fac _ _ hrange⟩
    have hWc'' : WeaklyEtale c'' :=
      MorphismProperty.of_postcomp (W := (@WeaklyEtale : MorphismProperty Scheme.{u}))
        (W' := (@WeaklyEtale : MorphismProperty Scheme.{u})) c'' U.ι
        (show WeaklyEtale U.ι from inferInstance) (by rw [hfac]; exact hWa)
    obtain ⟨c, hcdef⟩ : ∃ c : Spec (.of B) ⟶
        Spec (.of (wcQuadModelRing A (r + 2) π
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))),
        c'' ≫ g = c := ⟨_, rfl⟩
    have hWc : WeaklyEtale c := by
      rw [← hcdef]
      haveI := hWc''
      haveI := hg
      haveI : WeaklyEtale g := inferInstance
      infer_instance
    have hcf : a ≫ fZ = c ≫ wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) := by
      rw [← hcdef, ← hfac]
      simp only [Category.assoc, hgf]
    obtain ⟨y, hc0⟩ : ∃ y, c (IsLocalRing.closedPoint B) = y := ⟨_, rfl⟩
    have hy : wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)
        y = IsLocalRing.closedPoint A := by
      have h3 := Scheme.Hom.comp_apply c (wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
        (IsLocalRing.closedPoint B)
      have h5 := congrArg (fun m : Spec (.of B) ⟶ Spec (.of A) =>
        m (IsLocalRing.closedPoint B)) hcf
      have h4 : (a ≫ fZ) (IsLocalRing.closedPoint B) = IsLocalRing.closedPoint A :=
        (Scheme.Hom.comp_apply a fZ _).trans ((congrArg fZ ha0).trans hx)
      rw [← hc0]
      exact h3.symm.trans (h5.symm.trans h4)

    obtain ⟨B₁, _, _, _, Λ₁, _, _, W₁, φ₁, a₁, e₁, hI, haff, hcomp, hφa, hlim, hint, heq⟩ :=
      wc_et_geom_strict_henselization y
    have hsh₁ : wcHalShData y B₁ Λ₁ W₁ φ₁ a₁ :=
      ⟨hI, haff, hcomp, hφa, hlim, e₁, hint, heq⟩
    obtain ⟨ε, -, hε⟩ := wc_pltr_wet_residue_geom_point y B c hWc hc0
    obtain ⟨δ, hδ, -⟩ := wc_shdata_lift_geom_point y B₁ Λ₁ W₁ φ₁ a₁ hsh₁ B c
      (Spec.map (CommRingCat.ofHom ε) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)))
      ((Scheme.Hom.comp_apply _ _ _).trans (hresG B _)) ((Category.assoc _ _ _).trans hε)
    haveI hδiso : IsIso δ := wc_pltr_shens_lift_iso y B₁ Λ₁ W₁ φ₁ a₁ hsh₁ B c hWc hc0 δ hδ

    have hconn₁ : ConnectedSpace ↥(Limits.pullback (a₁ ≫ wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
        (Spec.map (CommRingCat.ofHom φ))) := by
      by_cases hd : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
            (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
            (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal y ∧
          Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
            (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
            (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal y
      · exact wc_qmssl_mfc_double A ℓ hℓ π hπ r y hy hd.1 hd.2 B₁ Λ₁ W₁ φ₁ a₁ hsh₁ Ω φ hinj
      · obtain ⟨U₀, hyU₀, hsm⟩ := wc_qmssl_offdouble_smooth A r π y (not_and_or.mp hd)
        exact wc_smooth_open_shens_milnor_fibre_conn A _ _ U₀ hsm ℓ Fact.out hℓ y hyU₀
          hy B₁ Λ₁ W₁ φ₁ a₁ hsh₁ Ω (Spec.map (CommRingCat.ofHom φ))

    have eq₁ : (a ≫ fZ) ≫ 𝟙 _ = δ ≫ (a₁ ≫ wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) := by
      rw [Category.comp_id, hcf, ← hδ, Category.assoc]
    have eq₂ : ξ ≫ 𝟙 _ = 𝟙 _ ≫ Spec.map (CommRingCat.ofHom φ) := by
      rw [Category.comp_id, Category.id_comp, hξ]
    haveI := Limits.pullback.map_isIso (a ≫ fZ) ξ
      (a₁ ≫ wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
      (Spec.map (CommRingCat.ofHom φ)) δ (𝟙 _) (𝟙 _) eq₁ eq₂
    let eT := asIso (Limits.pullback.map (a ≫ fZ) ξ
      (a₁ ≫ wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
      (Spec.map (CommRingCat.ofHom φ)) δ (𝟙 _) (𝟙 _) eq₁ eq₂)
    exact @Function.Surjective.connectedSpace _ _ _ hconn₁ _ _
      (Scheme.homeoOfIso eT.symm).surjective (Scheme.homeoOfIso eT.symm).continuous

  have hm : 0 < ℓ ^ k := pow_pos (Fact.out : ℓ.Prime).pos k
  have hunit : IsIso (Dg.Φ.map (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
      (wcEtBaseChange (Limits.pullback.fst fZ ξ)) _ _ Dh.cont Dh.φ)) := by

    have hfinal : ∀ {S S' : Scheme.{u}} (g : S' ⟶ S), (wcEtBaseChange g).Final := by
      intro S S' g
      let F := wcEtBaseChange g
      let T : S.Etale := MorphismProperty.Over.mk ⊤ (𝟙 S) (inferInstance : Etale (𝟙 S))
      have hT : Limits.IsTerminal T := Limits.IsTerminal.ofUniqueHom
        (fun V => MorphismProperty.Over.homMk V.hom (Category.comp_id _) trivial)
        (fun V m => by
          apply MorphismProperty.Over.Hom.ext
          exact (Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m))
      have hFT : Limits.IsTerminal (F.obj T) := Limits.IsTerminal.ofUniqueHom
        (fun V => MorphismProperty.Over.homMk
          (Limits.pullback.lift (V.hom ≫ g) V.hom (by simp) : V.left ⟶ Limits.pullback (𝟙 S) g)
          (Limits.pullback.lift_snd _ _ _) trivial)
        (fun V m => by
          apply MorphismProperty.Over.Hom.ext
          have hw : m.left ≫ Limits.pullback.snd (𝟙 S) g = V.hom := MorphismProperty.Over.w m
          show @Eq (V.left ⟶ Limits.pullback (𝟙 S) g) m.left
            (Limits.pullback.lift (V.hom ≫ g) V.hom (by simp))
          apply Limits.pullback.hom_ext
          · have hl1 := Limits.pullback.lift_fst (f := 𝟙 S) (g := g) (V.hom ≫ g) V.hom (by simp)
            have hc := Limits.pullback.condition (f := 𝟙 S) (g := g)
            rw [Category.comp_id] at hc
            have h2 : m.left ≫ Limits.pullback.fst (𝟙 S) g = V.hom ≫ g := by
              rw [hc]
              exact (Category.assoc _ _ _).symm.trans (congrArg (fun t => t ≫ g) hw)
            exact h2.trans hl1.symm
          · have hl2 := Limits.pullback.lift_snd (f := 𝟙 S) (g := g) (V.hom ≫ g) V.hom (by simp)
            exact hw.trans hl2.symm)
      refine Functor.Final.mk (fun d => ?_)
      have hterm : Limits.IsTerminal (StructuredArrow.mk (hFT.from d) : StructuredArrow d F) :=
        Limits.IsTerminal.ofUniqueHom
          (fun X => StructuredArrow.homMk (hT.from X.right) (hFT.hom_ext _ _))
          (fun X m => StructuredArrow.hom_ext _ _ (hT.hom_ext _ _))
      haveI := hterm.hasTerminal
      exact isConnected_of_hasTerminal _

    have htrans : ∀ {S S' : Scheme.{u}} {g : S' ⟶ S} {m : ℕ} (E : wcEtPullData g m),
        IsIso ((E.adj.homEquiv _ _).symm
          (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange g) _ _ E.cont E.φ)) := by
      intro S S' g m E
      haveI := E.cont
      haveI : (wcEtBaseChange g).Final := hfinal g
      haveI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange g) _ _ E.cont E.φ).IsRightAdjoint :=
        ⟨_, ⟨E.adj⟩⟩
      let pPA := SheafOfModules.pullbackPushforwardAdjunction E.φ
      let e := E.adj.leftAdjointUniq pPA
      have h1 : (E.adj.homEquiv _ _).symm (SheafOfModules.unitToPushforwardObjUnit E.φ) =
          e.hom.app _ ≫ (pPA.homEquiv _ _).symm (SheafOfModules.unitToPushforwardObjUnit E.φ) := by
        rw [Adjunction.homEquiv_counit, Adjunction.homEquiv_counit,
          ← Adjunction.leftAdjointUniq_hom_app_counit E.adj pPA]
        rw [← Category.assoc, NatTrans.naturality, Category.assoc]
      rw [h1, SheafOfModules.pullbackPushforwardAdjunction_homEquiv_symm_unitToPushforwardObjUnit]
      infer_instance

    haveI := Dh.cont
    let u := @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
      (wcEtBaseChange (Limits.pullback.fst fZ ξ)) _ _ Dh.cont Dh.φ
    let P := @SheafOfModules.pushforward _ _ _ _ _ _
      (wcEtBaseChange (Limits.pullback.fst fZ ξ)) _ _ Dh.cont Dh.φ
    let ψ := (Dh.adj.homEquiv _ _).symm u
    haveI hψ : IsIso ψ := htrans Dh
    let c := Dh.μ.inv ≫ ψ
    have hfac : u = wcEtSuppUnitMap Dh ≫ P.map c := by
      have e1 : Dh.μ.hom ≫ c = ψ := Iso.hom_inv_id_assoc _ _
      calc u = Dh.adj.homEquiv _ _ ψ := (Equiv.apply_symm_apply _ _).symm
        _ = Dh.adj.homEquiv _ _ (Dh.μ.hom ≫ c) := by rw [e1]
        _ = Dh.adj.homEquiv _ _ Dh.μ.hom ≫ P.map c := Adjunction.homEquiv_naturality_right _ _ _
        _ = wcEtSuppUnitMap Dh ≫ P.map c := by rw [Adjunction.homEquiv_unit]; rfl

    haveI : IsClosedImmersion (wcQmSp A) :=
      IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom (IsLocalRing.residue A))
        Ideal.Quotient.mk_surjective
    have hclosed : IsClosed (Set.range (Limits.pullback.fst fZ (wcQmSp A))) :=
      (IsClosedImmersion.isClosedEmbedding _).isClosed_range
    have hpt : ∀ z : ↥(Limits.pullback fZ (wcQmSp A)),
        fZ (Limits.pullback.fst fZ (wcQmSp A) z) = IsLocalRing.closedPoint A := by
      intro z
      have e1 : fZ (Limits.pullback.fst fZ (wcQmSp A) z) =
          wcQmSp A (Limits.pullback.snd fZ (wcQmSp A) z) := by
        rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
      rw [e1, Subsingleton.elim (Limits.pullback.snd fZ (wcQmSp A) z)
        (IsLocalRing.closedPoint _)]
      haveI : IsLocalHom (CommRingCat.Hom.hom (CommRingCat.ofHom (IsLocalRing.residue A))) :=
        (inferInstance : IsLocalHom (IsLocalRing.residue A))
      exact AlgebraicGeometry.Spec_closedPoint

    have hstalk := fun z => wc_et_supp_unit_ker_coker_stalks_of_milnor_h0 A Z fZ (ℓ ^ k) hm
      Ω ξ Dh (Limits.pullback.fst fZ (wcQmSp A) z)
      (fun B _ _ _ Λ' _ _ W'' φ' a' hsh => by
        haveI := hmilnor _ (hpt z) B Λ' W'' φ' a' hsh
        exact wc_et_coh_zero_connected_card _ (ℓ ^ k) hm.ne')

    have hK := wc_et_pull_isZero_of_range_stalks _ (ℓ ^ k) Dg
      (Limits.kernel (wcEtSuppUnitMap Dh)) hclosed (fun z => (hstalk z).1)
    have hC := wc_et_pull_isZero_of_range_stalks _ (ℓ ^ k) Dg
      (Limits.cokernel (wcEtSuppUnitMap Dh)) hclosed (fun z => (hstalk z).2)

    haveI := Dg.additive
    haveI := Dg.presLim
    haveI := Dg.presColim
    have hK' : Limits.IsZero (Limits.kernel (Dg.Φ.map (wcEtSuppUnitMap Dh))) :=
      hK.of_iso (Limits.PreservesKernel.iso Dg.Φ (wcEtSuppUnitMap Dh)).symm
    have hC' : Limits.IsZero (Limits.cokernel (Dg.Φ.map (wcEtSuppUnitMap Dh))) :=
      hC.of_iso (Limits.PreservesCokernel.iso Dg.Φ (wcEtSuppUnitMap Dh)).symm
    haveI : Mono (Dg.Φ.map (wcEtSuppUnitMap Dh)) :=
      Preadditive.mono_of_isZero_kernel' _ (Limits.kernelIsKernel _) hK'
    haveI : Epi (Dg.Φ.map (wcEtSuppUnitMap Dh)) :=
      Preadditive.epi_of_isZero_cokernel' _ (Limits.cokernelIsCokernel _) hC'
    have hs : IsIso (Dg.Φ.map (wcEtSuppUnitMap Dh)) := isIso_of_mono_of_epi _
    have hc : IsIso c := IsIso.comp_isIso' inferInstance hψ
    have hPc : IsIso (P.map c) := @Functor.map_isIso _ _ _ _ _ _ P c hc
    have hΦPc : IsIso (Dg.Φ.map (P.map c)) := @Functor.map_isIso _ _ _ _ _ _ Dg.Φ (P.map c) hPc
    have key : IsIso (Dg.Φ.map (wcEtSuppUnitMap Dh) ≫ Dg.Φ.map (P.map c)) :=
      IsIso.comp_isIso' hs hΦPc
    have hmap : Dg.Φ.map u = Dg.Φ.map (wcEtSuppUnitMap Dh) ≫ Dg.Φ.map (P.map c) :=
      (congrArg Dg.Φ.map hfac).trans (Dg.Φ.map_comp _ _)
    show IsIso (Dg.Φ.map u)
    exact cast (congrArg (fun t => IsIso t) hmap).symm key

  intro P eK eΨ
  haveI := Dh.additive
  haveI := Dg.additive
  haveI : P.Additive := Adjunction.right_adjoint_additive Dh.adj
  haveI := Dg.presLim
  haveI := Dg.presColim
  haveI : Limits.PreservesFiniteLimits P := by
    haveI := Dh.adj.rightAdjoint_preservesLimits
    infer_instance
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback fZ (wcQmSp A)) (ℓ ^ k)))
  obtain ⟨hb, hc⟩ := homology_transfer P Dg.Φ
    (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst fZ ξ)) _ _ Dh.cont Dh.φ)
    Dg.μ I
  exact cone_ge_one _ _ eΨ (hc hunit) hb

theorem wc_etqm_sr_ss_restr_higher_vanish (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) (k : ℕ) (hk : 1 ≤ k) (π : A)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    (Z : Scheme.{u}) (fZ : Z ⟶ Spec (.of A))
    (hcov : ∀ z : Z, ∃ (U : Z.Opens) (r : ℕ)
      (g : U.toScheme ⟶ Spec (.of (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))),
      z ∈ U ∧ Etale g ∧
      g ≫ wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) = U.ι ≫ fZ)
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A))
    (hφπ : (Spec.preimage ξ).hom π ≠ 0)
    (Dh : wcEtPullData (Limits.pullback.fst fZ ξ) (ℓ ^ k))
    (Dg : wcEtPullData (Limits.pullback.fst fZ (wcQmSp A)) (ℓ ^ k))
    (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing (Limits.pullback fZ ξ) (ℓ ^ k))))
    (q : ℕ) (hq : 2 ≤ q) :
    haveI := Dh.additive
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst fZ ξ)) _ _ Dh.cont Dh.φ
    haveI : P.Additive := Adjunction.right_adjoint_additive Dh.adj
    Limits.IsZero (Dg.Φ.obj (((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q)) :=
by
  intro P

  have hresG : ∀ (R : Type u) [CommRing R] [IsLocalRing R]
      (x : Spec (.of (IsLocalRing.ResidueField R))),
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)) x = IsLocalRing.closedPoint R := by
    intro R _ _ x
    rw [Spec.map_apply]
    exact (congrArg (PrimeSpectrum.comap (IsLocalRing.residue R))
      (Subsingleton.elim (α := PrimeSpectrum (IsLocalRing.ResidueField R)) x _)).trans
      ((IsLocalRing.isLocalHom_iff_comap_closedPoint (IsLocalRing.residue R)).mp inferInstance)

  have hξcl : ξ (IsLocalRing.closedPoint Ω) ≠ IsLocalRing.closedPoint A := by
    intro H
    obtain ⟨φ, hφdef⟩ : ∃ φ : A →+* Ω, φ = (Spec.preimage ξ).hom := ⟨_, rfl⟩
    have hξ : Spec.map (CommRingCat.ofHom φ) = ξ := by
      rw [hφdef]; exact Spec.map_preimage ξ
    have H2 : PrimeSpectrum.comap φ (IsLocalRing.closedPoint Ω) = IsLocalRing.closedPoint A := by
      rw [← hξ] at H
      exact H
    have H3 := congrArg PrimeSpectrum.asIdeal H2
    rw [PrimeSpectrum.comap_asIdeal] at H3
    have hmem : π ∈ (IsLocalRing.closedPoint A).asIdeal := by
      show π ∈ IsLocalRing.maximalIdeal A
      rw [hπ]; exact Ideal.mem_span_singleton_self π
    rw [← H3, Ideal.mem_comap] at hmem
    have h0 : (IsLocalRing.closedPoint Ω).asIdeal = ⊥ := IsLocalRing.maximalIdeal_eq_bot
    rw [h0, Ideal.mem_bot] at hmem
    exact hφπ (hφdef ▸ hmem)

  have hmilnor : ∀ (x : Z), fZ x = IsLocalRing.closedPoint A →
      ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
        (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
        (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Z x)) (Scheme.Etale.forget Z))
        (φl : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Z),
        wcHalShData x B Λ W' φl a → Subsingleton (wcEtCoh (Limits.pullback (a ≫ fZ) ξ) (ℓ ^ k) q) := by
    intro x hx B _ _ _ Λ _ _ W' φl a hsh

    have ha0 : a (IsLocalRing.closedPoint B) = x := by
      obtain ⟨-, -, -, -, -, e, -, he⟩ := hsh
      have h2 : (Spec.map (CommRingCat.ofHom e) ≫
          Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)) ≫ a)
            (IsLocalRing.closedPoint (AlgebraicClosure (Z.residueField x))) =
          a (IsLocalRing.closedPoint B) :=
        (Scheme.Hom.comp_apply _ _ _).trans ((Scheme.Hom.comp_apply _ _ _).trans
          (congrArg a (hresG B _)))
      have h3 : wcEtGeomPt Z x (IsLocalRing.closedPoint (AlgebraicClosure (Z.residueField x))) = x :=
        (Scheme.Hom.comp_apply _ _ _).trans (Scheme.fromSpecResidueField_apply x _)
      have h4 := congrArg (fun m : Spec (.of (AlgebraicClosure (Z.residueField x))) ⟶ Z =>
        m (IsLocalRing.closedPoint (AlgebraicClosure (Z.residueField x)))) he
      exact h2.symm.trans (h4.trans h3)

    have hWa : WeaklyEtale a := wc_shdata_weaklyEtale x B Λ W' φl a hsh

    obtain ⟨U, r, g, hxU, hg, hgf⟩ := hcov x
    have hrange : Set.range a ⊆ Set.range U.ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨t, rfl⟩
      have h1 : a t ⤳ a (IsLocalRing.closedPoint B) :=
        (IsLocalRing.specializes_closedPoint t).map a.continuous
      rw [ha0] at h1
      exact h1.mem_open U.isOpen hxU
    obtain ⟨c'', hfac⟩ : ∃ c'' : Spec (.of B) ⟶ U.toScheme, c'' ≫ U.ι = a :=
      ⟨_, IsOpenImmersion.lift_fac _ _ hrange⟩
    have hWc'' : WeaklyEtale c'' :=
      MorphismProperty.of_postcomp (W := (@WeaklyEtale : MorphismProperty Scheme.{u}))
        (W' := (@WeaklyEtale : MorphismProperty Scheme.{u})) c'' U.ι
        (show WeaklyEtale U.ι from inferInstance) (by rw [hfac]; exact hWa)
    obtain ⟨c, hcdef⟩ : ∃ c : Spec (.of B) ⟶
        Spec (.of (wcQuadModelRing A (r + 2) π
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))),
        c'' ≫ g = c := ⟨_, rfl⟩
    have hWc : WeaklyEtale c := by
      rw [← hcdef]
      haveI := hWc''
      haveI := hg
      haveI : WeaklyEtale g := inferInstance
      infer_instance
    have hcf : a ≫ fZ = c ≫ wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) := by
      rw [← hcdef, ← hfac]
      simp only [Category.assoc, hgf]
    obtain ⟨y, hc0⟩ : ∃ y, c (IsLocalRing.closedPoint B) = y := ⟨_, rfl⟩
    have hy : wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)
        y = IsLocalRing.closedPoint A := by
      have h3 := Scheme.Hom.comp_apply c (wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
        (IsLocalRing.closedPoint B)
      have h5 := congrArg (fun m : Spec (.of B) ⟶ Spec (.of A) =>
        m (IsLocalRing.closedPoint B)) hcf
      have h4 : (a ≫ fZ) (IsLocalRing.closedPoint B) = IsLocalRing.closedPoint A :=
        (Scheme.Hom.comp_apply a fZ _).trans ((congrArg fZ ha0).trans hx)
      rw [← hc0]
      exact h3.symm.trans (h5.symm.trans h4)

    obtain ⟨B₁, _, _, _, Λ₁, _, _, W₁, φ₁, a₁, e₁, hI, haff, hcomp, hφa, hlim, hint, heq⟩ :=
      wc_et_geom_strict_henselization y
    have hsh₁ : wcHalShData y B₁ Λ₁ W₁ φ₁ a₁ :=
      ⟨hI, haff, hcomp, hφa, hlim, e₁, hint, heq⟩
    obtain ⟨ε, -, hε⟩ := wc_pltr_wet_residue_geom_point y B c hWc hc0
    obtain ⟨δ, hδ, -⟩ := wc_shdata_lift_geom_point y B₁ Λ₁ W₁ φ₁ a₁ hsh₁ B c
      (Spec.map (CommRingCat.ofHom ε) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)))
      ((Scheme.Hom.comp_apply _ _ _).trans (hresG B _)) ((Category.assoc _ _ _).trans hε)
    haveI hδiso : IsIso δ := wc_pltr_shens_lift_iso y B₁ Λ₁ W₁ φ₁ a₁ hsh₁ B c hWc hc0 δ hδ

    have hacyc₁ : Subsingleton (wcEtCoh (Limits.pullback (a₁ ≫ wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) ξ)
        (ℓ ^ k) q) := by
      by_cases hd : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
            (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
            (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal y ∧
          Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
            (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
            (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal y
      · have h1 := wc_qmssl_hv_milnor_double A ℓ hℓ π hπ r y hy hd.1 hd.2 B₁ Λ₁ W₁ φ₁ a₁ hsh₁
          Ω ξ hξcl q hq
        have h2 := wc_et_coh_zmod_prime_pow_of_prime _ ℓ Fact.out q h1 (k - 1)
        rw [Nat.sub_add_cancel hk] at h2
        exact h2
      · obtain ⟨U₀, hyU₀, hsm⟩ := wc_qmssl_offdouble_smooth A r π y (not_and_or.mp hd)
        have hu : IsUnit (((ℓ ^ k : ℕ)) : A) := by rw [Nat.cast_pow]; exact hℓ.pow k
        exact (wc_smooth_open_shens_milnor_fibre_acyclic A _ _ U₀ hsm (ℓ ^ k) hu y hyU₀
          hy B₁ Λ₁ W₁ φ₁ a₁ hsh₁ Ω ξ).2 q (by omega)

    have eq₁ : (a ≫ fZ) ≫ 𝟙 _ = δ ≫ (a₁ ≫ wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) := by
      rw [Category.comp_id, hcf, ← hδ, Category.assoc]
    have eq₂ : ξ ≫ 𝟙 _ = 𝟙 _ ≫ ξ := by
      rw [Category.comp_id, Category.id_comp]
    haveI := Limits.pullback.map_isIso (a ≫ fZ) ξ
      (a₁ ≫ wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
      ξ δ (𝟙 _) (𝟙 _) eq₁ eq₂
    obtain ⟨e⟩ := wc_et_coh_iso_invariance (Limits.pullback.map (a ≫ fZ) ξ
      (a₁ ≫ wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
      ξ δ (𝟙 _) (𝟙 _) eq₁ eq₂) (ℓ ^ k) q
    exact e.symm.subsingleton

  haveI : IsClosedImmersion (wcQmSp A) :=
    IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom (IsLocalRing.residue A))
      Ideal.Quotient.mk_surjective
  have hclosed : IsClosed (Set.range (Limits.pullback.fst fZ (wcQmSp A))) :=
    (IsClosedImmersion.isClosedEmbedding _).isClosed_range
  have hpt : ∀ z : ↥(Limits.pullback fZ (wcQmSp A)),
      fZ (Limits.pullback.fst fZ (wcQmSp A) z) = IsLocalRing.closedPoint A := by
    intro z
    have e1 : fZ (Limits.pullback.fst fZ (wcQmSp A) z) =
        wcQmSp A (Limits.pullback.snd fZ (wcQmSp A) z) := by
      rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
    rw [e1, Subsingleton.elim (Limits.pullback.snd fZ (wcQmSp A) z)
      (IsLocalRing.closedPoint _)]
    haveI : IsLocalHom (CommRingCat.Hom.hom (CommRingCat.ofHom (IsLocalRing.residue A))) :=
      (inferInstance : IsLocalHom (IsLocalRing.residue A))
    exact AlgebraicGeometry.Spec_closedPoint

  have hm : 0 < ℓ ^ k := pow_pos (Fact.out : ℓ.Prime).pos k
  apply wc_et_pull_isZero_of_range_stalks (Limits.pullback.fst fZ (wcQmSp A)) (ℓ ^ k) Dg _ hclosed
  intro z
  exact wc_et_module_push_stalk_vanish_of_milnor_deg A Z fZ (ℓ ^ k) hm Ω ξ Dh I
    (Limits.pullback.fst fZ (wcQmSp A) z) q (hmilnor _ (hpt z))

theorem wc_etqm_sr_pull_map_zero_of_stalks : ∀ {S S' : Scheme.{u}} (g : S' ⟶ S) (n : ℕ)
    (D : wcEtPullData g n) {M N : SheafOfModules.{u+1} (wcEtZModRing S n)} (ψ : M ⟶ N),
    IsClosed (Set.range g) →
    (∀ s' : S', (wcEtStalk S (g s')).map ((SheafOfModules.toSheaf (wcEtZModRing S n)).map ψ) = 0) →
    D.Φ.map ψ = 0 :=
by
  intro S S' g n D M N ψ hclosed hst
  have hfac : Abelian.factorThruImage ψ ≫ Abelian.image.ι ψ = ψ := Abelian.image.fac ψ
  have hsub : ∀ s' : S', Subsingleton ((wcEtStalk S (g s')).obj
      ((SheafOfModules.toSheaf (wcEtZModRing S n)).obj (Abelian.image ψ))) := by
    intro s'
    haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.smallEtaleTopology S)
      (wcEtZModRing S n)
    haveI : Limits.PreservesFiniteLimits (SheafOfModules.toSheaf (wcEtZModRing S n)) :=
      inferInstance
    obtain ⟨hL, hC⟩ := wc_et_stalk_exact S (g s')
    haveI := hL
    haveI := hC
    have hepi : Epi ((wcEtStalk S (g s')).map ((SheafOfModules.toSheaf (wcEtZModRing S n)).map
        (Abelian.factorThruImage ψ))) := inferInstance
    have hmono : Mono ((wcEtStalk S (g s')).map ((SheafOfModules.toSheaf (wcEtZModRing S n)).map
        (Abelian.image.ι ψ))) := inferInstance
    have h0 : (wcEtStalk S (g s')).map ((SheafOfModules.toSheaf (wcEtZModRing S n)).map
        (Abelian.image.ι ψ)) = 0 := by
      rw [← cancel_epi ((wcEtStalk S (g s')).map ((SheafOfModules.toSheaf (wcEtZModRing S n)).map
        (Abelian.factorThruImage ψ))), ← Functor.map_comp, ← Functor.map_comp, hfac, hst s',
        Limits.comp_zero]
    exact AddCommGrpCat.isZero_iff_subsingleton.mp (Limits.IsZero.of_mono_eq_zero _ h0)
  have hI : Limits.IsZero (D.Φ.obj (Abelian.image ψ)) :=
    wc_et_pull_isZero_of_range_stalks g n D (Abelian.image ψ) hclosed hsub
  rw [← hfac, Functor.map_comp, hI.eq_of_src (D.Φ.map (Abelian.image.ι ψ)) 0, Limits.comp_zero]

theorem wc_etsm_stalk_of_local_bdry {Y : Scheme.{u}} (m : ℕ) (y : Y)
    {K L : CochainComplex (SheafOfModules.{u+1} (wcEtZModRing Y m)) ℤ} (φ : K ⟶ L) (n : ℤ)
    (hloc : ∀ (A : StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y))
      (c : (K.X n).val.obj (Opposite.op A.right)),
      ((K.d n (n + 1)).val.app (Opposite.op A.right)).hom c = 0 →
      ∃ (A' : StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) (f : A' ⟶ A)
        (e : (L.X (n - 1)).val.obj (Opposite.op A'.right)),
        ((L.d (n - 1) n).val.app (Opposite.op A'.right)).hom e =
          ((L.X n).val.map f.right.op).hom (((φ.f n).val.app (Opposite.op A.right)).hom c)) :
    (wcEtStalk Y y).map ((SheafOfModules.toSheaf (wcEtZModRing Y m)).map
      (HomologicalComplex.homologyMap φ n)) = 0 :=
by
  classical

  have hcomp : ∀ {M N P : SheafOfModules.{u+1} (wcEtZModRing Y m)} (f : M ⟶ N) (g : N ⟶ P)
      (U : Y.Etale) (x : M.val.obj (Opposite.op U)),
      ((f ≫ g).val.app (Opposite.op U)).hom x =
        (g.val.app (Opposite.op U)).hom ((f.val.app (Opposite.op U)).hom x) := by
    intro M N P f g U x
    simp only [SheafOfModules.comp_val, PresheafOfModules.comp_app, ModuleCat.hom_comp,
      LinearMap.comp_apply]
  have hzero : ∀ {M N : SheafOfModules.{u+1} (wcEtZModRing Y m)} (U : Y.Etale)
      (x : M.val.obj (Opposite.op U)), (((0 : M ⟶ N)).val.app (Opposite.op U)).hom x = 0 := by
    intro M N U x
    first
    | rfl
    | simp

  have s1 : ∀ {M N : SheafOfModules.{u+1} (wcEtZModRing Y m)} (f : M ⟶ N) [Mono f] (U : Y.Etale),
      Function.Injective (f.val.app (Opposite.op U)).hom := by
    intro M N f _ U
    have h1 : Mono ((SheafOfModules.forget (wcEtZModRing Y m)).map f) := inferInstance
    have h3 : Mono (((SheafOfModules.forget (wcEtZModRing Y m)).map f).app (Opposite.op U)) :=
      inferInstance
    rw [ModuleCat.mono_iff_injective] at h3
    exact h3
  have hinj : ∀ U : Y.Etale, Function.Injective ((L.iCycles n).val.app (Opposite.op U)).hom :=
    fun U => s1 (L.iCycles n) U

  have s4 : ∀ (A : StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y))
      (z : (K.cycles n).val.obj (Opposite.op A.right)),
      ∃ (A' : StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) (f : A' ⟶ A),
        ((L.homology n).val.map f.right.op).hom
          (((HomologicalComplex.cyclesMap φ n ≫ L.homologyπ n).val.app
            (Opposite.op A.right)).hom z) = 0 := by
    intro A z
    have hdc : ((K.d n (n + 1)).val.app (Opposite.op A.right)).hom
        (((K.iCycles n).val.app (Opposite.op A.right)).hom z) = 0 := by
      rw [← hcomp, HomologicalComplex.iCycles_d, hzero]
    obtain ⟨A', f, e, he⟩ := hloc A _ hdc
    refine ⟨A', f, ?_⟩
    obtain ⟨z', hz'⟩ : ∃ z' : (K.cycles n).val.obj (Opposite.op A'.right),
        z' = ((K.cycles n).val.map f.right.op).hom z := ⟨_, rfl⟩
    have nat1 : ((K.iCycles n).val.app (Opposite.op A'.right)).hom z' =
        ((K.X n).val.map f.right.op).hom (((K.iCycles n).val.app (Opposite.op A.right)).hom z) := by
      rw [hz']
      exact PresheafOfModules.naturality_apply (K.iCycles n).val f.right.op z
    have nat2 : ((φ.f n).val.app (Opposite.op A'.right)).hom
        (((K.X n).val.map f.right.op).hom (((K.iCycles n).val.app (Opposite.op A.right)).hom z)) =
        ((L.X n).val.map f.right.op).hom (((φ.f n).val.app (Opposite.op A.right)).hom
          (((K.iCycles n).val.app (Opposite.op A.right)).hom z)) :=
      PresheafOfModules.naturality_apply (φ.f n).val f.right.op _
    have hw : ((HomologicalComplex.cyclesMap φ n).val.app (Opposite.op A'.right)).hom z' =
        ((L.toCycles (n - 1) n).val.app (Opposite.op A'.right)).hom e := by
      apply hinj A'.right
      calc ((L.iCycles n).val.app (Opposite.op A'.right)).hom
            (((HomologicalComplex.cyclesMap φ n).val.app (Opposite.op A'.right)).hom z')
          = ((HomologicalComplex.cyclesMap φ n ≫ L.iCycles n).val.app
              (Opposite.op A'.right)).hom z' := (hcomp _ _ _ _).symm
        _ = ((K.iCycles n ≫ φ.f n).val.app (Opposite.op A'.right)).hom z' := by
              rw [HomologicalComplex.cyclesMap_i]
        _ = ((φ.f n).val.app (Opposite.op A'.right)).hom
              (((K.iCycles n).val.app (Opposite.op A'.right)).hom z') := hcomp _ _ _ _
        _ = ((φ.f n).val.app (Opposite.op A'.right)).hom
              (((K.X n).val.map f.right.op).hom
                (((K.iCycles n).val.app (Opposite.op A.right)).hom z)) := by rw [nat1]
        _ = ((L.d (n - 1) n).val.app (Opposite.op A'.right)).hom e := nat2.trans he.symm
        _ = ((L.toCycles (n - 1) n ≫ L.iCycles n).val.app (Opposite.op A'.right)).hom e := by
              rw [HomologicalComplex.toCycles_i]
        _ = ((L.iCycles n).val.app (Opposite.op A'.right)).hom
              (((L.toCycles (n - 1) n).val.app (Opposite.op A'.right)).hom e) := hcomp _ _ _ _
    have nat3 : ((L.homology n).val.map f.right.op).hom
          (((HomologicalComplex.cyclesMap φ n ≫ L.homologyπ n).val.app
            (Opposite.op A.right)).hom z) =
        ((HomologicalComplex.cyclesMap φ n ≫ L.homologyπ n).val.app
            (Opposite.op A'.right)).hom z' := by
      rw [hz']
      exact (PresheafOfModules.naturality_apply
        (HomologicalComplex.cyclesMap φ n ≫ L.homologyπ n).val f.right.op z).symm
    rw [nat3, hcomp, hw, ← hcomp, HomologicalComplex.toCycles_comp_homologyπ, hzero]
    first
    | rfl
    | exact (map_zero _)
    | simp

  have s2 : ∀ {M N : SheafOfModules.{u+1} (wcEtZModRing Y m)} (g : M ⟶ N),
      (∀ (A : StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y))
        (s : M.val.obj (Opposite.op A.right)),
        ∃ (A' : StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) (f : A' ⟶ A),
          (N.val.map f.right.op).hom ((g.val.app (Opposite.op A.right)).hom s) = 0) →
      (wcEtStalk Y y).map ((SheafOfModules.toSheaf (wcEtZModRing Y m)).map g) = 0 := by
    intro M N g h
    dsimp only [wcEtStalk, Functor.comp_map, Functor.comp_obj]
    rw [Limits.colim_map]
    apply Limits.colimit.hom_ext
    intro j
    rw [Limits.ι_colimMap, Limits.comp_zero]
    obtain ⟨A⟩ := j
    ext s
    obtain ⟨A', f, hf⟩ := h A s
    rw [ConcreteCategory.comp_apply]
    have e1 := Limits.colimit.w_apply ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y))
      (Scheme.Etale.forget Y)).op ⋙ ((SheafOfModules.toSheaf (wcEtZModRing Y m)).obj N).obj) f.op
      ((g.val.app (Opposite.op A.right)).hom s)
    have e2 : ConcreteCategory.hom (((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y))
        (Scheme.Etale.forget Y)).op ⋙
          ((SheafOfModules.toSheaf (wcEtZModRing Y m)).obj N).obj).map f.op)
        ((g.val.app (Opposite.op A.right)).hom s) = 0 := hf
    rw [e2, map_zero] at e1
    refine e1.symm.trans ?_
    simp

  have hexact : Limits.PreservesFiniteLimits (wcEtStalk Y y) ∧
      Limits.PreservesFiniteColimits (wcEtStalk Y y) := by
    haveI : AB5OfSize.{u, u} AddCommGrpCat.{u+1} :=
      AB5OfSize_shrink.{u, u, u+1, u+1} AddCommGrpCat.{u+1}
    let Φ := Scheme.pointSmallEtale (wcEtGeomPt Y y)
    let E : StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y) ⥤
        Φ.fiber.Elements :=
      { obj := fun A => Φ.fiber.elementsMk A.right A.hom
        map := fun {A A'} g => ⟨g.right, StructuredArrow.w g⟩
        map_id := fun A => rfl
        map_comp := fun f g => rfl }
    let Einv : Φ.fiber.Elements ⥤
        StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y) :=
      { obj := fun x => StructuredArrow.mk (T := Scheme.Etale.forget Y) (Y := x.1) x.2
        map := fun {x y} φ => StructuredArrow.homMk φ.1 φ.2
        map_id := fun x => rfl
        map_comp := fun f g => rfl }
    let eqv : StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y) ≌
        Φ.fiber.Elements :=
      CategoryTheory.Equivalence.mk E Einv
        (NatIso.ofComponents (fun A => Iso.refl _) (by intros; rfl))
        (NatIso.ofComponents (fun x => Iso.refl _) (by intros; rfl))
    haveI : E.IsEquivalence := eqv.isEquivalence_functor
    haveI : E.IsLeftAdjoint := Functor.isLeftAdjoint_of_isEquivalence
    haveI : E.Initial := Functor.initial_of_isLeftAdjoint E
    haveI : E.op.Final := Functor.final_op_of_initial E
    let i0 := Functor.Final.colimIso (E := AddCommGrpCat.{u+1}) E.op
    let i1 : (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj
        (StructuredArrow.proj (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)).op ⋙
          Limits.colim ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (Functor.Elements.π Φ.fiber).op ⋙
          Limits.colim :=
      Functor.isoWhiskerLeft ((Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj
        (Functor.Elements.π Φ.fiber).op) i0
    let j : Φ.sheafFiber (A := AddCommGrpCat.{u+1}) ≅ wcEtStalk Y y :=
      Functor.isoWhiskerLeft (sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
        i1.symm
    exact ⟨Limits.preservesFiniteLimits_of_natIso j, Limits.preservesFiniteColimits_of_natIso j⟩
  obtain ⟨_, hcolim⟩ := hexact
  haveI := hcolim
  have htoSheaf : Limits.PreservesFiniteColimits
      (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y m)) := by
    have s2' : ∀ {C : Type (u+1)} [Category.{u} C]
        (J : GrothendieckTopology C)
        [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
        (R : Sheaf J RingCat.{u+1}), Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} R) := by
      intro C _ J _ _ R
      constructor
      intro I _ _
      constructor
      intro K
      let adj := PresheafOfModules.sheafificationAdjunction (J := J) (𝟙 R.obj)
      haveI : IsIso adj.counit := inferInstance
      haveI hP : Limits.PreservesColimitsOfShape I
          (PresheafOfModules.sheafification (J := J) (𝟙 R.obj) ⋙ SheafOfModules.toSheaf.{u+1} R) :=
        Limits.preservesColimitsOfShape_of_natIso
          (PresheafOfModules.sheafificationCompToSheaf (J := J) (𝟙 R.obj)).symm
      let K₀ := K ⋙ (SheafOfModules.forget R ⋙ PresheafOfModules.restrictScalars (𝟙 R.obj))
      let c₀ := Limits.colimit.cocone K₀
      let h₀ : Limits.IsColimit c₀ := Limits.colimit.isColimit K₀
      have ht : Limits.IsColimit
          ((PresheafOfModules.sheafification (J := J) (𝟙 R.obj)).mapCocone c₀) :=
        Limits.isColimitOfPreserves _ h₀
      have ht' : Limits.IsColimit ((SheafOfModules.toSheaf.{u+1} R).mapCocone
          ((PresheafOfModules.sheafification (J := J) (𝟙 R.obj)).mapCocone c₀)) :=
        Limits.IsColimit.ofIsoColimit
          (Limits.isColimitOfPreserves
            (PresheafOfModules.sheafification (J := J) (𝟙 R.obj) ⋙ SheafOfModules.toSheaf.{u+1} R) h₀)
          (Functor.mapCoconeMapCocone c₀).symm
      haveI : Limits.PreservesColimit (K₀ ⋙ PresheafOfModules.sheafification (J := J) (𝟙 R.obj))
          (SheafOfModules.toSheaf.{u+1} R) :=
        Limits.preservesColimit_of_preserves_colimit_cocone ht ht'
      let e : K₀ ⋙ PresheafOfModules.sheafification (J := J) (𝟙 R.obj) ≅ K :=
        Functor.associator _ _ _ ≪≫ Functor.isoWhiskerLeft K (asIso adj.counit) ≪≫
          Functor.rightUnitor K
      exact Limits.preservesColimit_of_iso_diagram _ e
    exact s2' (Scheme.smallEtaleTopology Y) (wcEtZModRing Y m)
  haveI := htoSheaf
  let G := SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y m) ⋙ wcEtStalk Y y
  haveI : Limits.PreservesFiniteColimits G := Limits.comp_preservesFiniteColimits _ _
  haveI : G.PreservesEpimorphisms := inferInstance
  have hepi : Epi (G.map (K.homologyπ n)) := inferInstance
  have hg0 : G.map (HomologicalComplex.cyclesMap φ n ≫ L.homologyπ n) = 0 :=
    s2 _ (fun A z => s4 A z)
  show G.map (HomologicalComplex.homologyMap φ n) = 0
  rw [← cancel_epi (G.map (K.homologyπ n)), ← G.map_comp,
    HomologicalComplex.homologyπ_naturality, hg0, Limits.comp_zero]

theorem wc_etsm_T_section_formula {S S' : Scheme.{u}} {f : S' ⟶ S} {w : S' ⟶ S'} {m : ℕ}
