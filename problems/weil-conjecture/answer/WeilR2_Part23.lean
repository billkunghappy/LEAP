        (Limits.pullback.snd (e j) (Limits.pullback.fst f' ξ) ≫ Limits.pullback.snd f' ξ)
        (𝟙 _ ≫ wcQuadModelStr A (r + 2) π (wcR1sC0 A r))
        (Spec.map (CommRingCat.ofHom (Spec.preimage ξ).hom)) := by
