  obtain ⟨eS⟩ := wc_et_zmod_unit_toSheaf_iso (Limits.pullback f' (wcQmSp A)) (ℓ ^ k)
  let ψab := eS.inv ≫ (SheafOfModules.toSheaf (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k))).map
    (Dg'.μ.inv ≫ Dg'.Φ.map ψ)

  have hbij : ∀ w : Y, Function.Bijective
      ((wcEtStalk (Limits.pullback f' (wcQmSp A)) (iY w)).map ψab).hom := by
    intro w
    have hz : iY w ∈ closure (wcSrhlExc A n π c β f')ᶜ ∩ wcSrhlExc A n π c β f' := by
      rw [← hYset]; exact ⟨w, rfl⟩
    obtain ⟨θ⟩ := θnat (iY w)
