      Spec.map (CommRingCat.ofHom (σ k : wcQuadModelRing A (r + 2) π (wcSrmCh A r) →+*
        wcQuadModelRing A (r + 2) π (wcSrmCh A r)) ≫ CommRingCat.ofHom φ0) ≫
        wcQuadModelStr A (r + 2) π
          (Matrix.of fun p q : Fin (r + 2) =>
            if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0) =
      wcQuadModelStr A (r + 2) π
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) := by
    intro k
    have hk : φ0.comp ((σ k : wcQuadModelRing A (r + 2) π (wcSrmCh A r) →+*
