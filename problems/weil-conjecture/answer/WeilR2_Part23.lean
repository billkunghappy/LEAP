  refine ⟨hSV.extClass.comp xV (add_comm 1 M), ?_⟩
  obtain ⟨κ, hκ, hK⟩ := wc_et_supp_restr_extclass_kernel iV iW' f DV Ef D' γ hγ
  have E1 := hK hSV hS' M xV
  have NAT := wc_et_open_compl_transfer_natural gOV gO' f w hw m DV D' Ef DgV Dg' Dw κ cV c'
    hκ hcV hc' M xV
