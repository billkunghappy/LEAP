      Finite.of_surjective _ hτ
    have hH := Nat.card_le_card_of_surjective _ hτ
    exact ⟨Finite.of_injective βf hβi,
      (Nat.card_le_card_of_injective βf hβi).trans (hH.trans hcard)⟩

  have b1 : ∀ {C D : Type (u+2)} [Category.{u+1} C] [Abelian C] [Category.{u+1} D] [Abelian D]
      [HasExt C] [HasExt D] [HasDerivedCategory C] [HasDerivedCategory D]
      (F : C ⥤ D) [F.Additive] [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F]
      (X Y : C) (n : ℕ),
      Function.Surjective (fun β : Abelian.Ext X Y n => Abelian.Ext.mapExactFunctor F β) →
      Function.Surjective (fun g : ShiftedHom ((DerivedCategory.singleFunctor C 0).obj X)
          ((DerivedCategory.singleFunctor C 0).obj Y) (n : ℤ) => g.map F.mapDerivedCategory) := by
    intro C D _ _ _ _ _ _ _ _ F _ _ _ X Y n h
    let α := F.mapDerivedCategorySingleFunctor 0
    let E₁ : Abelian.Ext X Y n ≃ _ := Abelian.Ext.homEquiv
    let E₂ : Abelian.Ext (F.obj X) (F.obj Y) n ≃ _ := Abelian.Ext.homEquiv
    let H := (α.app X).homCongr ((shiftFunctor (DerivedCategory D) (n : ℤ)).mapIso (α.app Y))
    have hK : ∀ β : Abelian.Ext X Y n,
        E₂ (Abelian.Ext.mapExactFunctor F β) = H ((E₁ β).map F.mapDerivedCategory) := by
      intro β
      show (Abelian.Ext.mapExactFunctor F β).hom = H (β.hom.map F.mapDerivedCategory)
      rw [Abelian.Ext.mapExactFunctor_hom, Iso.homCongr_apply, Functor.mapIso_hom, Iso.app_hom,
        Iso.app_inv]
    have hfac : (fun g : ShiftedHom ((DerivedCategory.singleFunctor C 0).obj X)
          ((DerivedCategory.singleFunctor C 0).obj Y) (n : ℤ) => g.map F.mapDerivedCategory) =
        H.symm ∘ E₂ ∘ (fun β : Abelian.Ext X Y n => Abelian.Ext.mapExactFunctor F β) ∘ E₁.symm := by
      funext g
      simp only [Function.comp_apply]
      rw [hK, Equiv.apply_symm_apply, Equiv.symm_apply_apply]
    rw [hfac]
    exact H.symm.surjective.comp (E₂.surjective.comp (h.comp E₁.symm.surjective))

  have b2 : ∀ {C D : Type (u+2)} [Category.{u+2} C] [Category.{u+2} D]
      [HasShift C ℤ] [HasShift D ℤ] (R : C ⥤ D) [R.CommShift ℤ]
      {X X' Y Y' : C} (eX : X ≅ X') (eY : Y ≅ Y') (a : ℤ),
      Function.Surjective (fun g : X ⟶ Y⟦a⟧ => R.map g ≫ (R.commShiftIso a).hom.app Y) →
      Function.Surjective (fun f : X' ⟶ Y'⟦a⟧ => R.map f ≫ (R.commShiftIso a).hom.app Y') := by
    intro C D _ _ _ _ R _ X X' Y Y' eX eY a h
    let H₁ := eX.homCongr ((shiftFunctor C a).mapIso eY)
    let H₂ := (R.mapIso eX).homCongr ((shiftFunctor D a).mapIso (R.mapIso eY))
    have hN : ∀ g : X ⟶ Y⟦a⟧, R.map (H₁ g) ≫ (R.commShiftIso a).hom.app Y' =
        H₂ (R.map g ≫ (R.commShiftIso a).hom.app Y) := by
      intro g
      simp only [H₁, H₂, Iso.homCongr_apply, Functor.mapIso_hom, Functor.mapIso_inv,
        Functor.map_comp, Category.assoc]
      rw [Functor.commShiftIso_hom_naturality]
    have hfac : (fun f : X' ⟶ Y'⟦a⟧ => R.map f ≫ (R.commShiftIso a).hom.app Y') =
        H₂ ∘ (fun g : X ⟶ Y⟦a⟧ => R.map g ≫ (R.commShiftIso a).hom.app Y) ∘ H₁.symm := by
      funext f
      simp only [Function.comp_apply]
      rw [← hN, Equiv.apply_symm_apply]
    rw [hfac]
    exact H₂.surjective.comp (h.comp H₁.symm.surjective)

  have cancelL : ∀ {C : Type (u+2)} [Category.{u+1} C] [Abelian C] [HasExt C] {X X' Y : C}
      (f : X ⟶ X') [IsIso f] {N : ℕ} (z z' : Abelian.Ext X' Y N),
      (Abelian.Ext.mk₀ f).comp z (zero_add N) = (Abelian.Ext.mk₀ f).comp z' (zero_add N) →
        z = z' := by
    intro C _ _ _ X X' Y f _ N z z' h
    have e1 := Abelian.Ext.comp_assoc_of_second_deg_zero (Abelian.Ext.mk₀ (inv f))
      (Abelian.Ext.mk₀ f) z (zero_add N)
    have e2 := Abelian.Ext.comp_assoc_of_second_deg_zero (Abelian.Ext.mk₀ (inv f))
      (Abelian.Ext.mk₀ f) z' (zero_add N)
    rw [Abelian.Ext.mk₀_comp_mk₀, IsIso.inv_hom_id, Abelian.Ext.mk₀_id_comp] at e1 e2
    rw [e1, e2, h]
  have cancelR : ∀ {C : Type (u+2)} [Category.{u+1} C] [Abelian C] [HasExt C] {X Y Y' : C}
      (g : Y ⟶ Y') [IsIso g] {N : ℕ} (z z' : Abelian.Ext X Y N),
      z.comp (Abelian.Ext.mk₀ g) (add_zero N) = z'.comp (Abelian.Ext.mk₀ g) (add_zero N) →
        z = z' := by
    intro C _ _ _ X Y Y' g _ N z z' h
    have e1 := Abelian.Ext.comp_assoc_of_third_deg_zero z (Abelian.Ext.mk₀ g)
      (Abelian.Ext.mk₀ (inv g)) (add_zero N)
    have e2 := Abelian.Ext.comp_assoc_of_third_deg_zero z' (Abelian.Ext.mk₀ g)
      (Abelian.Ext.mk₀ (inv g)) (add_zero N)
    rw [Abelian.Ext.mk₀_comp_mk₀, IsIso.hom_inv_id, Abelian.Ext.comp_mk₀_id] at e1 e2
    rw [← e1, ← e2, h]

  intro P K Ψ R Lb Sb ub Kp ι δ hT
  haveI := Dh.additive
  haveI := Dg.additive
  haveI := Dw.additive
  haveI := Dw.presLim
  haveI := Dw.presColim
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k)))
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (ℓ ^ k)))
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k))) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (ℓ ^ k))) := HasExt.standard _

  have hproj : Projective (SheafOfModules.unit (wcEtZModRing (Limits.pullback a'
      (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (ℓ ^ k))) := by
    obtain ⟨J, c, hpb, hJ⟩ := wc_et_dsl_shens_closed_fibre_square A (Limits.pullback.snd D.f a)
      x xs hxs B Λ' W'' φ' a' hsh
    haveI : IsIso c := hpb.isIso_snd_of_isIso
    obtain ⟨hh, hsep⟩ := wc_quot_strictly_henselian_of_ne_top B J hJ
    exact @wc_et_zmod_unit_projective_of_strictly_local _ (B ⧸ J) _ hh hsep (asIso c) (ℓ ^ k)

  haveI := wc_et_tpl_sfu_geom_pt_closed_immersion F' F'' Y n D i A Λ W' φ a hA x hx xs hxs
  have sq := IsPullback.of_hasPullback
    (wcEtGeomPt (Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)) xs)
    (Limits.pullback.snd a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)))
  obtain ⟨D'⟩ := wc_et_zmod_pull_data_exists
    (Limits.pullback.snd
      (wcEtGeomPt (Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)) xs)
      (Limits.pullback.snd a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))))
    (ℓ ^ k)
  obtain ⟨γ, hγ, -⟩ := wc_et_closed_supp_base_change _ _ _ _ sq Dx Dw D'
  have hiso : IsIso γ := wc_et_closed_supp_bc_gamma_isIso _ _ _ _ sq Dx Dw D' γ hγ
  have hac := wc_et_tpl_det_shens_closed_fibre_acyclic F' F'' Y n hn hn2 D ℓ hℓ k i A Λ W' φ a hA
    x hx B Λ' W'' φ' a' hsh xs hxs
  have hsurj := wc_et_tpl_dsl_supp_restr_surj_all F' F'' Y n hn hn2 D ℓ hℓ k i A Λ W' φ a hA
    x hx B Λ' W'' φ' a' hsh xs hxs Dx Dw D' γ hγ hac (n - 1 + 1) (by omega)
  have hE : Function.Surjective (fun β : Abelian.Ext (wcEtSuppObj Dx)
      (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k)))
      (n - 1 + 1) => Abelian.Ext.mapExactFunctor Dw.Φ β) := by
    intro e
    obtain ⟨θ, hθ⟩ := hsurj ((Abelian.Ext.mk₀ γ).comp
      (e.comp (Abelian.Ext.mk₀ Dw.μ.hom) (add_zero (n - 1 + 1))) (zero_add (n - 1 + 1)))
    refine ⟨θ, ?_⟩
    show Abelian.Ext.mapExactFunctor Dw.Φ θ = e
    apply cancelR Dw.μ.hom
    apply cancelL γ
    exact hθ
  have h3 := b1 Dw.Φ (wcEtSuppObj Dx)
    (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k)))
    (n - 1 + 1) hE
  have hτ' := b2 Dw.Φ.mapDerivedCategory
    ((DerivedCategory.singleFunctorIsoCompQ (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k))) 0).app
      (wcEtSuppObj Dx))
    ((DerivedCategory.singleFunctorIsoCompQ (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k))) 0).app
      (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k))))
    (((n - 1 + 1) : ℕ) : ℤ) h3

  obtain ⟨hfin, hcard⟩ := wc_et_tpl_sfu_lam_supp_succ_card_le F' F'' Y n hn hn2 D ℓ hℓ k i A Λ W'
    φ a hA η hηb hηne ξ hξ x hx B Λ' W'' φ' a' hsh Dh Dg I xs hxs Dx h4
  exact gen Dw.Φ _ (wcEtSuppObj Dx) _ Dw.μ hproj (((n - 1) : ℕ) : ℤ) (by omega)
    ((((n - 1) : ℕ) : ℤ) + 1) rfl (((n - 1 + 1) : ℕ) : ℤ) (by omega) (ℓ ^ k)
    hfin hcard hτ' Kp ι ub δ hT

theorem wc_et_dsl_lw_cone_chart (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left
      (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left))
    (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left)
    (hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a)
    (x : ↥(Limits.pullback D.f a)) (hx : Limits.pullback.fst D.f a x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Limits.pullback D.f a) x))
      (Scheme.Etale.forget (Limits.pullback D.f a)))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ Limits.pullback D.f a)
    (hsh : wcHalShData x B Λ' W'' φ' a')
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)))
    (hxs : Limits.pullback.fst (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A) xs = x) :
    ∃ (Oc : (Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A) n 0
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1
            then (1 : IsLocalRing.ResidueField A) else 0)))).Opens)
      (O : (Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))).Opens)
      (κ : Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) ⟶
        Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A) n 0
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1
            then (1 : IsLocalRing.ResidueField A) else 0)))),
      (Oc : Set ↥(Spec (.of (wcQuadModelRing (IsLocalRing.ResidueField A) n 0
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1
            then (1 : IsLocalRing.ResidueField A) else 0))))) =
        {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal (IsLocalRing.ResidueField A) n 0
          (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1
            then (1 : IsLocalRing.ResidueField A) else 0)) (MvPolynomial.X p) ∉ y.asIdeal} ∧
      (O : Set ↥(Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)))) =
        {w | Limits.pullback.snd a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) w ≠ xs} ∧
      WeaklyEtale κ ∧ κ ⁻¹ᵁ Oc = O ∧ IsAlgClosed (IsLocalRing.ResidueField A) ∧
      ((ℓ : ℕ) : IsLocalRing.ResidueField A) ≠ 0 :=
by
  classical

  have s2 : ∀ (k : Type u) [Field k] [IsAlgClosed k] (m : ℕ), Even m → 2 ≤ m →
      ∀ (c : Matrix (Fin m) (Fin m) k), (c + c.transpose).det ≠ 0 →
      ∃ θ : wcQuadModelRing k m 0 c ≃+* wcQuadModelRing k m 0
          (Matrix.of fun p q : Fin m => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : k) else 0),
        ∀ r : Fin m, θ.symm (Ideal.Quotient.mk (wcQuadModelIdeal k m 0
            (Matrix.of fun p q : Fin m => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : k) else 0))
            (MvPolynomial.X r)) ∈
          Ideal.span (Set.range fun q : Fin m =>
            Ideal.Quotient.mk (wcQuadModelIdeal k m 0 c) (MvPolynomial.X q)) := by
    intro k _ _ m hm hm2 c hc
    obtain ⟨d, rfl⟩ : ∃ d, m = d + 1 + 1 := ⟨m - 2, by omega⟩
    have hd : Even d := by
      obtain ⟨t, ht⟩ := hm
      exact ⟨t - 1, by omega⟩
    obtain ⟨P, hP, hform⟩ := wc_quadric_split_normal_form_alg_closed k d hd c hc
    have hval' : ∑ p, ∑ q, MvPolynomial.C ((P.transpose * c * P) p q) *
          (MvPolynomial.X p * MvPolynomial.X q) =
        ∑ p, ∑ q, MvPolynomial.C (if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : k) else 0) *
          (MvPolynomial.X p * MvPolynomial.X q : MvPolynomial (Fin (d + 1 + 1)) k) :=
      congrArg Subtype.val hform
    let Φ : ∀ M : Matrix (Fin (d + 1 + 1)) (Fin (d + 1 + 1)) k,
        MvPolynomial (Fin (d + 1 + 1)) k →ₐ[k] MvPolynomial (Fin (d + 1 + 1)) k :=
      fun M => MvPolynomial.aeval (fun i => ∑ j, MvPolynomial.C (M i j) * MvPolynomial.X j)
    have hΦX : ∀ M i, Φ M (MvPolynomial.X i) = ∑ j, MvPolynomial.C (M i j) * MvPolynomial.X j :=
      fun M i => MvPolynomial.aeval_X _ _
    have hcomp : ∀ M N : Matrix (Fin (d + 1 + 1)) (Fin (d + 1 + 1)) k,
        (Φ M).comp (Φ N) = Φ (N * M) := by
      intro M N
      apply MvPolynomial.algHom_ext
      intro i
      rw [AlgHom.comp_apply, hΦX, hΦX, map_sum]
      simp_rw [map_mul, hΦX, Φ, MvPolynomial.aeval_C, Finset.mul_sum, Matrix.mul_apply, map_sum,
        Finset.sum_mul]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun l _ => Finset.sum_congr rfl (fun j _ => ?_))
      rw [MvPolynomial.algebraMap_eq, map_mul]
      ring
    have hone : Φ 1 = AlgHom.id k _ := by
      apply MvPolynomial.algHom_ext
      intro i
      rw [hΦX, AlgHom.id_apply, Finset.sum_eq_single i]
      · simp
      · intro b _ hb
        rw [Matrix.one_apply_ne (Ne.symm hb), map_zero, zero_mul]
      · intro hi
        exact absurd (Finset.mem_univ i) hi
    have hPi : P⁻¹ * P = 1 := Matrix.nonsing_inv_mul P hP
    have hiP : P * P⁻¹ = 1 := Matrix.mul_nonsing_inv P hP
    let Φe : MvPolynomial (Fin (d + 1 + 1)) k ≃+* MvPolynomial (Fin (d + 1 + 1)) k :=
      (AlgEquiv.ofAlgHom (Φ P) (Φ P⁻¹) (by rw [hcomp, hPi, hone])
        (by rw [hcomp, hiP, hone])).toRingEquiv
    have hΦeX : ∀ x, Φe x = Φ P x := fun x => rfl
    have hΦesymm : ∀ x, Φe.symm x = Φ P⁻¹ x := fun x => rfl
    have hkey : ∀ M : Matrix (Fin (d + 1 + 1)) (Fin (d + 1 + 1)) k,
        Φ P (∑ p, ∑ q, MvPolynomial.C (M p q) * MvPolynomial.X p * MvPolynomial.X q) =
          ∑ p, ∑ q, MvPolynomial.C ((P.transpose * M * P) p q) * MvPolynomial.X p *
            MvPolynomial.X q := by
      intro M
      have hdot : ∀ N : Matrix (Fin (d + 1 + 1)) (Fin (d + 1 + 1)) k,
          ∑ p, ∑ q, MvPolynomial.C (N p q) * MvPolynomial.X p * MvPolynomial.X q =
            dotProduct (MvPolynomial.X : Fin (d + 1 + 1) → MvPolynomial (Fin (d + 1 + 1)) k)
              (Matrix.mulVec (N.map MvPolynomial.C) MvPolynomial.X) := by
        intro N
        simp only [dotProduct, Matrix.mulVec, Matrix.map_apply, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl (fun q _ => ?_))
        ring
      rw [hdot, hdot]
      have hcomp' : (fun i => Φ P (MvPolynomial.X i)) =
          Matrix.mulVec (P.map MvPolynomial.C) MvPolynomial.X := by
        funext i
        rw [hΦX]
        rfl
      have hmap : ∀ v w : Fin (d + 1 + 1) → MvPolynomial (Fin (d + 1 + 1)) k,
          Φ P (dotProduct v w) = dotProduct (fun i => Φ P (v i)) (fun i => Φ P (w i)) := by
        intro v w
        simp only [dotProduct, map_sum, map_mul]
      have hmv : (fun i => Φ P (Matrix.mulVec (M.map MvPolynomial.C) MvPolynomial.X i)) =
          Matrix.mulVec (M.map MvPolynomial.C) (fun i => Φ P (MvPolynomial.X i)) := by
        funext i
        simp only [Matrix.mulVec, dotProduct, map_sum, map_mul, Matrix.map_apply, Φ,
          MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
      rw [hmap, hmv, hcomp', Matrix.mulVec_mulVec, Matrix.dotProduct_mulVec,
        ← Matrix.vecMul_transpose, Matrix.vecMul_vecMul, ← Matrix.dotProduct_mulVec,
        ← Matrix.transpose_map, ← Matrix.map_mul, ← Matrix.map_mul, Matrix.mul_assoc]
    have hQ : Φe (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
          MvPolynomial.C 0) =
        ∑ p, ∑ q, MvPolynomial.C ((Matrix.of fun p q : Fin (d + 1 + 1) =>
            if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : k) else 0) p q) *
          MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C 0 := by
      rw [map_zero MvPolynomial.C, sub_zero, sub_zero, hΦeX, hkey]
      refine Eq.trans (Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl
        (fun q _ => mul_assoc _ _ _))) (Eq.trans hval' (Finset.sum_congr rfl (fun p _ =>
          Finset.sum_congr rfl (fun q _ => ?_))))
      rw [Matrix.of_apply, mul_assoc]
    have hIJ : wcQuadModelIdeal k (d + 1 + 1) 0
        (Matrix.of fun p q : Fin (d + 1 + 1) =>
          if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : k) else 0) =
        Ideal.map (Φe : MvPolynomial (Fin (d + 1 + 1)) k →+* MvPolynomial (Fin (d + 1 + 1)) k)
          (wcQuadModelIdeal k (d + 1 + 1) 0 c) := by
      show Ideal.span {_} = Ideal.map _ (Ideal.span {_})
      rw [Ideal.map_span, Set.image_singleton]
      exact congrArg (fun z => Ideal.span {z}) hQ.symm
    refine ⟨Ideal.quotientEquiv _ _ Φe hIJ, fun r => ?_⟩
    have e : (Ideal.quotientEquiv _ _ Φe hIJ).symm (Ideal.Quotient.mk _ (MvPolynomial.X r)) =
        Ideal.Quotient.mk (wcQuadModelIdeal k (d + 1 + 1) 0 c) (Φe.symm (MvPolynomial.X r)) :=
      Ideal.quotientEquiv_symm_mk _ _ Φe hIJ _
