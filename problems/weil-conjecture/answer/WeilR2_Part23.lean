  obtain ⟨c, hc, hcx⟩ : ∃ c : Bh, IsUnit c ∧ c * x1b = 1 :=
    ⟨↑hx1b.unit⁻¹, Units.isUnit _, IsUnit.val_inv_mul hx1b⟩
  choose rt hrt using fun s : {b : Bh // IsUnit b} => hroot s.1 s.2
  let rt' : {b : Bh // IsUnit b} → {b : Bh // IsUnit b} := fun s => ⟨rt s, (hrt s).2⟩
  obtain ⟨y, hy0, hy, hyu⟩ : ∃ y : ℕ → Bh, y 0 = c ∧ (∀ j, y (j + 1) ^ ℓ = y j) ∧
      ∀ j, IsUnit (y j) := by
