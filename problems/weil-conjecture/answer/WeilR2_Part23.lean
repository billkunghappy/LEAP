      intro p h0 h2
      show φ (Ideal.Quotient.mk IR _) = _
      rw [hφX, hFev p h0 h2, map_mul]
    have hφodd : ∀ p : Fin (r + 2), p.val ≠ 1 → p.val % 2 ≠ 0 → φ (x p) = y p := by
      intro p h1 h2
      show φ (Ideal.Quotient.mk IR _) = _
      rw [hφX, hFodd p h1 h2]

    have hrelR : ∑ a, ∑ b, (algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmCh A r))
        (wcSrmCh A r a b)) * x a * x b =
        algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmCh A r)) π := by
      have h : Ideal.Quotient.mk IR (∑ p, ∑ q, MvPolynomial.C (wcSrmCh A r p q) *
          MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C π) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      rw [map_sub, sub_eq_zero] at h
      simpa only [map_sum, map_mul, ← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap] using h
    refine ⟨?_, ?_⟩
    ·
      rw [Ideal.map_span, hGen0, hφ0]
      apply le_antisymm
      · rw [Ideal.span_le]
        rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
        rw [hGen]
        set p : Fin (r + 2) := ⟨2 * (i.val / 2), lt_of_le_of_lt (Nat.mul_div_le i.val 2) i.isLt⟩
        by_cases h0 : p.val = 0
        · have : p = p0 := Fin.ext (by rw [h0])
          rw [this, hφ0]
          exact Ideal.subset_span rfl
        · rw [hφev p h0 (by simp only [p]; omega)]
          exact Ideal.mul_mem_right _ _ (Ideal.subset_span rfl)
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        exact Ideal.subset_span ⟨x p0, ⟨p0, hGen0⟩, hφ0⟩
    ·
      intro B ρ hnzd hgen
      rw [hGen0] at hnzd hgen
      set ξ := ρ.hom (x p0) with hξ
      let g : A →+* B := ρ.hom.comp (algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmCh A r)))
      have hβex : ∀ p : Fin (r + 2), ∃ c : B, p.val % 2 = 0 → c * ξ = ρ.hom (x p) := by
        intro p
        by_cases hp : p.val % 2 = 0
        · have hmem : ρ.hom (x p) ∈ Ideal.map ρ.hom (Ideal.span (Set.range (wcSrmGen A r π))) :=
            Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨p, hGenEven p hp⟩)
          rw [hgen] at hmem
          obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hmem
          exact ⟨c, fun _ => hc⟩
        · exact ⟨0, fun h => absurd h hp⟩
      choose β hβ using hβex
      let w : Fin (r + 2) → B := fun p =>
        if p.val = 0 then ξ else if p.val % 2 = 0 then β p else ρ.hom (x p)
      let S : B := ∑ i : Fin (r + 1), ∑ b, g (wcSrmCh A r i.succ b) * w i.succ * w b
      let v : Fin (r + 2) → B := fun p => if p.val = 1 then ρ.hom (x p1) + S else w p
      have hv0 : v p0 = ξ := by simp [v, w, hp0]
      have hv1 : v p1 = ρ.hom (x p1) + S := by simp [v, hp1]
      have hvev : ∀ p : Fin (r + 2), p.val ≠ 0 → p.val % 2 = 0 → v p = β p := by
        intro p h0 h2
        have h1 : p.val ≠ 1 := by omega
        simp only [v, w]
        rw [if_neg h1, if_neg h0, if_pos h2]
      have hvodd : ∀ p : Fin (r + 2), p.val ≠ 1 → p.val % 2 ≠ 0 → v p = ρ.hom (x p) := by
        intro p h1 h2
        have h0 : p.val ≠ 0 := by omega
        simp only [v, w]
        rw [if_neg h1, if_neg h0, if_neg h2]

      have htail : ∀ f : Fin (r + 2) → B,
          (∀ p : Fin (r + 2), p.val ≠ 0 → p.val % 2 = 0 → f p = β p) →
          (∀ p : Fin (r + 2), p.val ≠ 1 → p.val % 2 ≠ 0 → f p = ρ.hom (x p)) →
          ∑ i : Fin (r + 1), ∑ b, g (wcSrmCh A r i.succ b) * f i.succ * f b = S := by
        intro f hfe hfo
        refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun b _ => ?_))
        by_cases h : (Fin.succ i).val % 2 = 0 ∧ b.val = (Fin.succ i).val + 1
        · have h1 : (Fin.succ i).val ≠ 0 := by simp
          have h3 : b.val ≠ 1 := by omega
          have h4 : b.val % 2 ≠ 0 := by omega
          have h5 : b.val ≠ 0 := by omega
          have hw1 : w i.succ = β i.succ := by simp only [w]; rw [if_neg h1, if_pos h.1]
          have hw2 : w b = ρ.hom (x b) := by simp only [w]; rw [if_neg h5, if_neg h4]
          rw [hfe _ h1 h.1, hfo _ h3 h4, hw1, hw2]
        · simp only [wcSrmCh, Matrix.of_apply, if_neg h, map_zero, zero_mul]

      have hξS : ξ * S = ∑ i : Fin (r + 1), ∑ b, g (wcSrmCh A r i.succ b) *
          ρ.hom (x i.succ) * ρ.hom (x b) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun b _ => ?_)
        by_cases h : (Fin.succ i).val % 2 = 0 ∧ b.val = (Fin.succ i).val + 1
        · have h1 : (Fin.succ i).val ≠ 0 := by simp
          have h4 : b.val % 2 ≠ 0 := by omega
          have h5 : b.val ≠ 0 := by omega
          have hw1 : w i.succ = β i.succ := by simp only [w]; rw [if_neg h1, if_pos h.1]
          have hw2 : w b = ρ.hom (x b) := by simp only [w]; rw [if_neg h5, if_neg h4]
          rw [hw1, hw2, ← hβ _ h.1]
          ring
        · simp only [wcSrmCh, Matrix.of_apply, if_neg h, map_zero, zero_mul, mul_zero]
      have hrelB : ξ * ρ.hom (x p1) + ξ * S = g π := by
        have h := congrArg ρ.hom hrelR
        simp only [map_sum, map_mul] at h
        have h2 := Lch g (fun p => ρ.hom (x p))
        simp only at h2
        rw [hξS]
        change ∑ a, ∑ b, g (wcSrmCh A r a b) * ρ.hom (x a) * ρ.hom (x b) = g π at h
        rw [h2] at h
        exact h

      let ψt : MvPolynomial (Fin (r + 2)) A →+* B := MvPolynomial.eval₂Hom g v
      have hψt : ∀ a ∈ IM, ψt a = 0 := by
        intro a ha
        obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
        rw [map_mul]
        convert mul_zero (ψt c)
        simp only [ψt, map_sub, map_sum, map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X']
        rw [Lc0 g v, hv0, hv1, mul_add, hrelB, sub_self]
      let ψ : wcQuadModelRing A (r + 2) π (wcSrmC0 A r) →+* B := Ideal.Quotient.lift IM ψt hψt
      have hψy : ∀ p, ψ (y p) = v p := by
        intro p
        show Ideal.Quotient.lift IM ψt hψt (Ideal.Quotient.mk IM _) = _
        rw [Ideal.Quotient.lift_mk]
        exact MvPolynomial.eval₂Hom_X' g v p
      have hψalg : ∀ a, ψ (algebraMap A _ a) = g a := by
        intro a
        rw [← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq]
        show Ideal.Quotient.lift IM ψt hψt (Ideal.Quotient.mk IM _) = _
        rw [Ideal.Quotient.lift_mk]
        exact MvPolynomial.eval₂Hom_C g v a

      have hval : ∀ ψ' : wcQuadModelRing A (r + 2) π (wcSrmC0 A r) →+* B,
          ψ'.comp φ = ρ.hom → ∀ p, ψ' (y p) = v p := by
        intro ψ' hψ'
        have hc : ∀ z, ψ' (φ z) = ρ.hom z := fun z => RingHom.congr_fun hψ' z
        have hy0 : ψ' (y p0) = ξ := by rw [← hφ0, hc]
        have hyodd : ∀ p : Fin (r + 2), p.val ≠ 1 → p.val % 2 ≠ 0 → ψ' (y p) = ρ.hom (x p) := by
          intro p h1 h2
          rw [← hφodd p h1 h2, hc]
        have hyev : ∀ p : Fin (r + 2), p.val ≠ 0 → p.val % 2 = 0 → ψ' (y p) = β p := by
          intro p h0 h2
          have e1 : ξ * ψ' (y p) = ρ.hom (x p) := by
            rw [← hy0, ← map_mul, ← hφev p h0 h2, hc]
          have e2 : (ψ' (y p) - β p) * ξ = 0 := by
            rw [sub_mul, mul_comm, e1, hβ p h2, sub_self]
          exact sub_eq_zero.mp (mul_right_mem_nonZeroDivisors_eq_zero_iff hnzd |>.mp e2)
        have hga : ∀ a, ψ' (algebraMap A _ a) = g a := by
          intro a
          rw [← hφA, RingHom.comp_apply, hc]
          rfl
        have hy1 : ψ' (y p1) = ρ.hom (x p1) + S := by
          have e1 := hc (x p1)
          have hx1 : φ (x p1) = y p1 + y p0 * y p1 -
              ∑ a, ∑ b, algebraMap A _ (wcSrmCh A r a b) * y a * y b := by
            show φ (Ideal.Quotient.mk IR _) = _
            rw [hφX, hF1]
            simp only [map_sub, map_add, map_mul, map_sum, ← MvPolynomial.algebraMap_eq,
              Ideal.Quotient.mk_algebraMap]
            rfl
          rw [hx1] at e1
          simp only [map_sub, map_add, map_mul, map_sum, hga] at e1
          rw [Lch g (fun p => ψ' (y p))] at e1
          rw [htail (fun p => ψ' (y p)) hyev hyodd] at e1
          rw [← e1]
          ring
        intro p
        by_cases h0 : p.val = 0
        · have : p = p0 := Fin.ext h0
          rw [this, hy0, hv0]
        by_cases h1 : p.val = 1
        · have : p = p1 := Fin.ext h1
          rw [this, hy1, hv1]
        by_cases h2 : p.val % 2 = 0
        · rw [hyev p h0 h2, hvev p h0 h2]
        · rw [hyodd p h1 h2, hvodd p h1 h2]

      have hex : ψ.comp φ = ρ.hom := by
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext
        · intro a
          simp only [RingHom.comp_apply]
          rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
          rw [← RingHom.comp_apply φ, hφA, hψalg]
          rfl
        · intro p
          simp only [RingHom.comp_apply]
          change ψ (φ (x p)) = ρ.hom (x p)
          by_cases h0 : p.val = 0
          · have : p = p0 := Fin.ext h0
            rw [this, hφ0, hψy, hv0]
          by_cases h1 : p.val = 1
          · have : p = p1 := Fin.ext h1
            rw [this]
            have hx1 : φ (x p1) = y p1 + y p0 * y p1 -
                ∑ a, ∑ b, algebraMap A _ (wcSrmCh A r a b) * y a * y b := by
              show φ (Ideal.Quotient.mk IR _) = _
              rw [hφX, hF1]
              simp only [map_sub, map_add, map_mul, map_sum, ← MvPolynomial.algebraMap_eq,
                Ideal.Quotient.mk_algebraMap]
              rfl
            rw [hx1]
            simp only [map_sub, map_add, map_mul, map_sum, hψalg, hψy]
            rw [Lch g v, htail v hvev hvodd, hv1]
            ring
          by_cases h2 : p.val % 2 = 0
          · rw [hφev p h0 h2, map_mul, hψy, hψy, hv0, hvev p h0 h2, mul_comm, hβ p h2]
          · rw [hφodd p h1 h2, hψy, hvodd p h1 h2]
      refine ⟨CommRingCat.ofHom ψ, ?_, ?_⟩
      · apply CommRingCat.hom_ext
        rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom]
        exact hex
      · intro ψ₂ hψ₂
        have h2 : ψ₂.hom.comp φ = ρ.hom := by
          rw [← hψ₂, CommRingCat.hom_comp, CommRingCat.hom_ofHom]
        apply CommRingCat.hom_ext
        rw [CommRingCat.hom_ofHom]
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext
        · intro a
          simp only [RingHom.comp_apply]
          rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap, hψalg]
          rw [← hφA, RingHom.comp_apply, ← RingHom.comp_apply ψ₂.hom, h2]
          rfl
        · intro p
          simp only [RingHom.comp_apply]
          change ψ₂.hom (y p) = ψ (y p)
          rw [hval _ h2 p, hψy]

  obtain ⟨φ0, hφX, hφA⟩ := s3
  have hnzd0 := s6
  obtain ⟨hgen0, hup0⟩ := s7 φ0 hφX hφA
  have e0 : wcSrmGen A r π ⟨0, by omega⟩ =
      Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmCh A r))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) := by
    have hf : (⟨2 * ((⟨0, by omega⟩ : Fin (r + 2)).val / 2),
        lt_of_le_of_lt (Nat.mul_div_le _ 2) (⟨0, by omega⟩ : Fin (r + 2)).isLt⟩ : Fin (r + 2)) =
        ⟨0, by omega⟩ := Fin.ext (by simp)
    unfold wcSrmGen
    rw [hf]
  have hb0 : φ0 (wcSrmGen A r π ⟨0, by omega⟩) =
      Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) := by
    rw [e0, hφX]
    simp [wcSrmFimg]
  choose σ hσA hσb hσJ hσ0 using s4
  have hT := fun k : Fin (r + 2) =>
    s5 (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmCh A r)))
      (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmC0 A r)))
      (wcSrmGen A r π) ⟨0, by omega⟩ k (σ k) (CommRingCat.ofHom φ0) (hσb k) (hσJ k)
      (by rw [CommRingCat.hom_ofHom, hb0]; exact hnzd0)
      (by rw [CommRingCat.hom_ofHom]; exact hgen0)
      (fun B ρ h1 h2 => hup0 B ρ h1 h2)
  obtain ⟨e, -, he_comp, he_cov⟩ := wc_qmbt_bm_blowup_charts
    (R := CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmCh A r))) (wcSrmGen A r π) β hbl
    (fun _ => CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmC0 A r)))
    (fun k => CommRingCat.ofHom (σ k : wcQuadModelRing A (r + 2) π (wcSrmCh A r) →+*
      wcQuadModelRing A (r + 2) π (wcSrmCh A r)) ≫ CommRingCat.ofHom φ0)
    (fun k => (hT k).1) (fun k => (hT k).2.1) (fun k => (hT k).2.2)
  have hΦb : ∀ k : Fin (r + 2), (CommRingCat.ofHom (σ k : wcQuadModelRing A (r + 2) π (wcSrmCh A r) →+*
      wcQuadModelRing A (r + 2) π (wcSrmCh A r)) ≫ CommRingCat.ofHom φ0).hom (wcSrmGen A r π k) =
      Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) := by
    intro k
    show φ0 (σ k (wcSrmGen A r π k)) = _
    rw [hσb k, hb0]

  have hcrit : ∀ (k : Fin (r + 2)) (y : Spec (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmC0 A r)))),
      β (e k y) ∈ PrimeSpectrum.zeroLocus (Set.range (wcSrmGen A r π)) ↔
        Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ y.asIdeal := by
    intro k y
    have h1 : β (e k y) = Spec.map (CommRingCat.ofHom (σ k : wcQuadModelRing A (r + 2) π (wcSrmCh A r) →+*
        wcQuadModelRing A (r + 2) π (wcSrmCh A r)) ≫ CommRingCat.ofHom φ0) y := by
      rw [← he_comp k, Scheme.Hom.comp_apply]
    have h2 : (Spec.map (CommRingCat.ofHom (σ k : wcQuadModelRing A (r + 2) π (wcSrmCh A r) →+*
        wcQuadModelRing A (r + 2) π (wcSrmCh A r)) ≫ CommRingCat.ofHom φ0) y).asIdeal =
        Ideal.comap (CommRingCat.ofHom (σ k : wcQuadModelRing A (r + 2) π (wcSrmCh A r) →+*
          wcQuadModelRing A (r + 2) π (wcSrmCh A r)) ≫ CommRingCat.ofHom φ0).hom y.asIdeal := rfl
    rw [h1]
    refine (PrimeSpectrum.mem_zeroLocus _ _).trans ?_
    rw [h2, ← Ideal.span_le, ← Ideal.map_le_iff_le_comap,
      (hT k).2.1, hΦb k, Ideal.span_singleton_le_iff_mem]

  have hy0 : (Ideal.span {Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))}).IsPrime ∧
      ∀ p : Fin (r + 2), p.val ≠ 0 →
        Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r)) (MvPolynomial.X p) ∉
          Ideal.span {Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r))
            (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))} := by
    set IM := wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r) with hIM
    set Y0 := Ideal.Quotient.mk IM (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) with hY0
    let vA : Fin (r + 2) → MvPolynomial (Fin (r + 2)) A := fun p =>
      if p.val = 0 then 0 else MvPolynomial.X p
    let τ : MvPolynomial (Fin (r + 2)) A →+* MvPolynomial (Fin (r + 2)) A :=
      MvPolynomial.eval₂Hom MvPolynomial.C vA
    let θ : MvPolynomial (Fin (r + 2)) A →+* MvPolynomial (Fin (r + 2)) (IsLocalRing.ResidueField A) :=
      (MvPolynomial.map (IsLocalRing.residue A)).comp τ
    have hτX : ∀ p, τ (MvPolynomial.X p) = vA p := fun p => MvPolynomial.eval₂Hom_X' _ _ p
    have hτC : ∀ a, τ (MvPolynomial.C a) = MvPolynomial.C a := fun a => MvPolynomial.eval₂Hom_C _ _ a
    have hres : IsLocalRing.residue A π = 0 := by
      rw [IsLocalRing.residue_eq_zero_iff, hπ]; exact Ideal.mem_span_singleton_self π
    have hgenIM : IM = Ideal.span {MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) *
        MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) - MvPolynomial.C π} := by
      rw [hIM, wcQuadModelIdeal, Lc0 MvPolynomial.C MvPolynomial.X]
    have hθgen : θ (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) *
        MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) - MvPolynomial.C π) = 0 := by
      simp [θ, hτX, hτC, vA, hres]
    have hker : ∀ a ∈ IM, θ a = 0 := by
      intro a ha
      rw [hgenIM] at ha
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      rw [map_mul, hθgen, mul_zero]
    let θb : wcQuadModelRing A (r + 2) π (wcSrmC0 A r) →+*
        MvPolynomial (Fin (r + 2)) (IsLocalRing.ResidueField A) := Ideal.Quotient.lift IM θ hker
    have hθb : ∀ f, θb (Ideal.Quotient.mk IM f) = θ f := fun f => Ideal.Quotient.lift_mk _ _ _
    have hdec : ∀ f : MvPolynomial (Fin (r + 2)) A,
        Ideal.Quotient.mk IM f - Ideal.Quotient.mk IM (τ f) ∈ Ideal.span {Y0} := by
      intro f
      induction f using MvPolynomial.induction_on
      next a =>
        rw [hτC, sub_self]
        exact Ideal.zero_mem _
      next p q hp hq =>
        have := Ideal.add_mem _ hp hq
        simp only [map_add]
        convert this using 1
        ring
      next p i hp =>
        simp only [map_mul, hτX]
        have hXi : Ideal.Quotient.mk IM (MvPolynomial.X i) - Ideal.Quotient.mk IM (vA i) ∈
            Ideal.span {Y0} := by
          by_cases hi : i.val = 0
          · have hi0 : i = ⟨0, by omega⟩ := Fin.ext hi
            simp only [vA, if_pos hi, map_zero, sub_zero]
            rw [hi0]
            exact Ideal.mem_span_singleton_self _
          · simp only [vA, if_neg hi, sub_self]
            exact Ideal.zero_mem _
        have e : Ideal.Quotient.mk IM p * Ideal.Quotient.mk IM (MvPolynomial.X i) -
            Ideal.Quotient.mk IM (τ p) * Ideal.Quotient.mk IM (vA i) =
            (Ideal.Quotient.mk IM p - Ideal.Quotient.mk IM (τ p)) * Ideal.Quotient.mk IM (MvPolynomial.X i) +
            Ideal.Quotient.mk IM (τ p) * (Ideal.Quotient.mk IM (MvPolynomial.X i) -
              Ideal.Quotient.mk IM (vA i)) := by ring
        rw [e]
        exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hp) (Ideal.mul_mem_left _ _ hXi)
    have hkerle : RingHom.ker θb ≤ Ideal.span {Y0} := by
      intro x hx
      obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
      rw [RingHom.mem_ker, hθb] at hx
      have h1 : τ f ∈ RingHom.ker (MvPolynomial.map (IsLocalRing.residue A) :
          MvPolynomial (Fin (r + 2)) A →+* MvPolynomial (Fin (r + 2)) (IsLocalRing.ResidueField A)) :=
        RingHom.mem_ker.mpr hx
      rw [MvPolynomial.ker_map, IsLocalRing.ker_residue, hπ, Ideal.map_span, Set.image_singleton,
        Ideal.mem_span_singleton'] at h1
      obtain ⟨u, hu⟩ := h1
      have hrel : Ideal.Quotient.mk IM (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) *
          MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) = Ideal.Quotient.mk IM (MvPolynomial.C π) := by
        rw [Ideal.Quotient.eq, hgenIM]
        exact Ideal.subset_span rfl
      have h2 : Ideal.Quotient.mk IM (τ f) ∈ Ideal.span {Y0} := by
        rw [← hu, map_mul]
        apply Ideal.mul_mem_left
        rw [← hrel, map_mul]
        exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
      have := Ideal.add_mem _ (hdec f) h2
      rwa [sub_add_cancel] at this
    have hkereq : RingHom.ker θb = Ideal.span {Y0} := by
      apply le_antisymm hkerle
      rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker, hY0, hθb]
      simp [θ, hτX, vA]
    refine ⟨?_, ?_⟩
    · rw [← hkereq]
      exact RingHom.ker_isPrime θb
    · intro p hp hmem
      rw [← hkereq, RingHom.mem_ker, hθb] at hmem
      have hp' : p ≠ 0 := fun h => hp (by rw [h]; rfl)
      simp [θ, hτX, vA, hp, hp'] at hmem
      try exact MvPolynomial.X_ne_zero _ hmem
  obtain ⟨hP, hYp⟩ := hy0
  let P : Spec (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmC0 A r))) :=
    (⟨_, hP⟩ : PrimeSpectrum (wcQuadModelRing A (r + 2) π (wcSrmC0 A r)))

  have hspec_in : ∀ (k : Fin (r + 2)) (y : Spec (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmC0 A r)))),
      β (e k y) ∈ PrimeSpectrum.zeroLocus (Set.range (wcSrmGen A r π)) → e k P ⤳ e k y := by
    intro k y hy
    have hy' := (hcrit k y).mp hy
    have hle : P.asIdeal ≤ y.asIdeal := Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hy')
    exact ((PrimeSpectrum.le_iff_specializes P y).mp hle).map (e k).continuous
  have hPE : ∀ k : Fin (r + 2), β (e k P) ∈ PrimeSpectrum.zeroLocus (Set.range (wcSrmGen A r π)) :=
    fun k => (hcrit k P).mpr (Ideal.mem_span_singleton_self _)

  let sk : Fin (r + 2) → wcQuadModelRing A (r + 2) π (wcSrmC0 A r) := fun k =>
    if k.val / 2 = 0 then 1 else Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r))
      (MvPolynomial.X (⟨2 * (k.val / 2), lt_of_le_of_lt (Nat.mul_div_le k.val 2) k.isLt⟩ : Fin (r + 2)))
  have hs : ∀ k : Fin (r + 2), φ0 (σ k (wcSrmGen A r π ⟨0, by omega⟩)) =
      Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) * sk k := by
    intro k
    rw [e0, hσ0 k, hφX]
    by_cases ht : k.val / 2 = 0
    · have hfin : (⟨2 * (k.val / 2), lt_of_le_of_lt (Nat.mul_div_le k.val 2) k.isLt⟩ : Fin (r + 2)) =
          ⟨0, by omega⟩ := Fin.ext (by simp only; omega)
      rw [hfin]
      simp only [sk, if_pos ht, mul_one]
      simp [wcSrmFimg]
    · have h0 : 2 * (k.val / 2) ≠ 0 := by omega
      have h1 : 2 * (k.val / 2) ≠ 1 := by omega
      have h2 : 2 * (k.val / 2) % 2 = 0 := by omega
      simp only [sk, if_neg ht]
      simp [wcSrmFimg, h0, h1, h2]
  have hsP : ∀ k : Fin (r + 2), sk k ∉ P.asIdeal := by
    intro k
    by_cases ht : k.val / 2 = 0
    · simp only [sk, if_pos ht]
      exact (Ideal.ne_top_iff_one _).mp hP.ne_top
    · simp only [sk, if_neg ht]
      exact hYp _ (by simp only; omega)
  have hover : ∀ k : Fin (r + 2), ∃ y0' : Spec (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmC0 A r))),
      e ⟨0, by omega⟩ y0' = e k P := by
    intro k
    let s := sk k
    let D := Localization.Away s
    let α : wcQuadModelRing A (r + 2) π (wcSrmC0 A r) →+* D := algebraMap _ D
    let ρ : CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmCh A r)) ⟶ CommRingCat.of D :=
      (CommRingCat.ofHom (σ k : wcQuadModelRing A (r + 2) π (wcSrmCh A r) →+*
        wcQuadModelRing A (r + 2) π (wcSrmCh A r)) ≫ CommRingCat.ofHom φ0) ≫ CommRingCat.ofHom α
    have hαs : IsUnit (α s) := IsLocalization.Away.algebraMap_isUnit s
    have hαx : α (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) ∈ nonZeroDivisors D :=
      IsLocalization.nonZeroDivisors_le_comap (Submonoid.powers s) D hnzd0
    have hρb : ρ.hom (wcSrmGen A r π ⟨0, by omega⟩) = α (Ideal.Quotient.mk
        (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) *
        α s := by
      show α (φ0 (σ k (wcSrmGen A r π ⟨0, by omega⟩))) = _
      rw [hs k, map_mul]
    have hnzd : ρ.hom (wcSrmGen A r π ⟨0, by omega⟩) ∈ nonZeroDivisors D := by
      rw [hρb]
      exact mul_mem_nonZeroDivisors.mpr ⟨hαx, hαs.mem_nonZeroDivisors⟩
    have hgen : Ideal.map ρ.hom (Ideal.span (Set.range (wcSrmGen A r π))) =
        Ideal.span {ρ.hom (wcSrmGen A r π ⟨0, by omega⟩)} := by
      rw [hρb, Ideal.span_singleton_mul_right_unit hαs]
      show Ideal.map (α.comp (φ0.comp (σ k : wcQuadModelRing A (r + 2) π (wcSrmCh A r) →+*
        wcQuadModelRing A (r + 2) π (wcSrmCh A r)))) _ = _
      rw [← Ideal.map_map, ← Ideal.map_map, hσJ k, hgen0, Ideal.map_span, Set.image_singleton, hb0]
    obtain ⟨ψ, hψ, -⟩ := (hT ⟨0, by omega⟩).2.2 (CommRingCat.of D) ρ hnzd hgen

    have hInv : wcCsdInvPull (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
        (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmCh A r)))).inv.hom
          (wcSrmGen A r π k)))) (Spec.map ρ) := by
      have e : (⊤ : (Spec (CommRingCat.of D)).Opens) ≤ Spec.map ρ ⁻¹ᵁ ⊤ := fun _ _ => trivial
      have hcomp : (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmCh A r)))).inv ≫
          (Spec.map ρ).appLE ⊤ ⊤ e = ρ ≫ (Scheme.ΓSpecIso (CommRingCat.of D)).inv := by
        rw [Scheme.ΓSpecIso_inv_naturality]
        congr 1
      have hval : ∀ z, ((Spec.map ρ).appLE ⊤ ⊤ e).hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmCh A r)))).inv.hom z) =
          (Scheme.ΓSpecIso (CommRingCat.of D)).inv.hom (ρ.hom z) := by
        intro z
        show ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmCh A r)))).inv ≫
          (Spec.map ρ).appLE ⊤ ⊤ e).hom z = (ρ ≫ (Scheme.ΓSpecIso (CommRingCat.of D)).inv).hom z
        rw [hcomp]
      have hIU : (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
          (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmCh A r)))).inv.hom
            (wcSrmGen A r π k)))).ideal ⟨⊤, isAffineOpen_top _⟩ =
          Ideal.span (Set.range fun k =>
            (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmCh A r)))).inv.hom
              (wcSrmGen A r π k)) := by
        rw [Scheme.IdealSheafData.ofIdealTop_ideal]
        have key : ∀ (h : (⊤ : (Spec (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmCh A r)))).Opens) ≤ ⊤)
            (J : Ideal Γ(Spec (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmCh A r))), ⊤)),
            Ideal.map ((Spec (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmCh A r)))).presheaf.map
              (homOfLE h).op).hom J = J := by
          intro h J
          rw [show (homOfLE h).op = 𝟙 _ from rfl, CategoryTheory.Functor.map_id, CommRingCat.hom_id,
            Ideal.map_id]
        exact key _ _
      have hmapb : Ideal.map (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmCh A r)))).inv.hom
          (Ideal.span (Set.range (wcSrmGen A r π))) =
          Ideal.span (Set.range fun k =>
            (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmCh A r)))).inv.hom
              (wcSrmGen A r π k)) := by
        rw [Ideal.map_span, ← Set.range_comp]
        try rfl
      have hisoNZD : ∀ {B C : CommRingCat.{u}} (ε : B ≅ C) (y : B), y ∈ nonZeroDivisors B →
          ε.hom.hom y ∈ nonZeroDivisors C := by
        intro B C ε y hy
        rw [← MulEquivClass.map_nonZeroDivisors ε.commRingCatIsoToRingEquiv]
        exact ⟨y, hy, rfl⟩
      intro t
      refine ⟨⟨⊤, isAffineOpen_top _⟩, ⟨⊤, isAffineOpen_top _⟩, e,
        (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmCh A r)))).inv.hom
          (wcSrmGen A r π ⟨0, by omega⟩), trivial, ?_, ?_, ?_⟩
      · rw [hIU]
        exact Ideal.subset_span ⟨⟨0, by omega⟩, rfl⟩
      · rw [hval]
        exact hisoNZD (Scheme.ΓSpecIso (CommRingCat.of D)).symm _ hnzd
      · rw [hIU, hval, ← hmapb, Ideal.map_map, ← CommRingCat.hom_comp, hcomp, CommRingCat.hom_comp,
          ← Ideal.map_map, hgen, Ideal.map_span, Set.image_singleton]
    have hL1 : (Spec.map (CommRingCat.ofHom α) ≫ e k) ≫ β = Spec.map ρ := by
      rw [Category.assoc, he_comp k, ← Spec.map_comp]
    have hL2 : (Spec.map ψ ≫ e ⟨0, by omega⟩) ≫ β = Spec.map ρ := by
      rw [Category.assoc, he_comp ⟨0, by omega⟩, ← Spec.map_comp, hψ]
    have hEq : Spec.map (CommRingCat.ofHom α) ≫ e k = Spec.map ψ ≫ e ⟨0, by omega⟩ :=
      (hbl.2 _ (Spec.map ρ) hInv).unique hL1 hL2
    have hmem : (show PrimeSpectrum (wcQuadModelRing A (r + 2) π (wcSrmC0 A r)) from P) ∈
        PrimeSpectrum.basicOpen s := (PrimeSpectrum.mem_basicOpen _ _).mpr (hsP k)
    rw [← SetLike.mem_coe, ← PrimeSpectrum.localization_away_comap_range D s] at hmem
    obtain ⟨q, hq⟩ := hmem
    refine ⟨Spec.map ψ q, ?_⟩
    have hℓq : Spec.map (CommRingCat.ofHom α) q = P := hq
    have hc := congrArg (fun f : Spec (CommRingCat.of D) ⟶ X' => f q) hEq
    simp only [Scheme.Hom.comp_apply] at hc
    rw [← hℓq]
    exact hc.symm

  have hspec : ∀ x : X', β x ∈ PrimeSpectrum.zeroLocus (Set.range (wcSrmGen A r π)) →
      e ⟨0, by omega⟩ P ⤳ x := by
    intro x hx
    obtain ⟨k, y, rfl⟩ := he_cov x
    have h1 := hspec_in k y hx
    obtain ⟨y0', hy0'⟩ := hover k
    have h2 : β (e ⟨0, by omega⟩ y0') ∈ PrimeSpectrum.zeroLocus (Set.range (wcSrmGen A r π)) := by
      rw [hy0']; exact hPE k
    exact ((hspec_in ⟨0, by omega⟩ y0' h2).trans (specializes_of_eq hy0')).trans h1

  have hπJ : algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmCh A r)) π ∈
      Ideal.span (Set.range (wcSrmGen A r π)) := by
    have h : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmCh A r))
        (∑ p, ∑ q, MvPolynomial.C (wcSrmCh A r p q) * MvPolynomial.X p * MvPolynomial.X q -
          MvPolynomial.C π) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    rw [map_sub, sub_eq_zero] at h
    rw [← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq, ← h, map_sum]
    refine Ideal.sum_mem _ (fun p _ => ?_)
    rw [map_sum]
    refine Ideal.sum_mem _ (fun q _ => ?_)
    by_cases hpq : p.val % 2 = 0 ∧ q.val = p.val + 1
    · rw [map_mul, map_mul]
      apply Ideal.mul_mem_right
      apply Ideal.mul_mem_left
      have hfin : (⟨2 * (p.val / 2), lt_of_le_of_lt (Nat.mul_div_le p.val 2) p.isLt⟩ : Fin (r + 2)) = p :=
        Fin.ext (by simp only; omega)
      refine Ideal.subset_span ⟨p, ?_⟩
      show Ideal.Quotient.mk _ (MvPolynomial.X (⟨2 * (p.val / 2),
        lt_of_le_of_lt (Nat.mul_div_le p.val 2) p.isLt⟩ : Fin (r + 2))) = _
      rw [hfin]
    · simp only [wcSrmCh, Matrix.of_apply, if_neg hpq, map_zero, zero_mul, Ideal.zero_mem]
  haveI : IsClosedImmersion (wcQmSp A) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  have hind : Topology.IsInducing (Limits.pullback.fst f' (wcQmSp A)) :=
    (Scheme.Hom.isClosedEmbedding _).isInducing
  have hlift : ∀ x : X', β x ∈ PrimeSpectrum.zeroLocus (Set.range (wcSrmGen A r π)) →
      ∃ z, Limits.pullback.fst f' (wcQmSp A) z = x := by
    intro x hx
    have hJ : Ideal.span (Set.range (wcSrmGen A r π)) ≤ (β x).asIdeal :=
      Ideal.span_le.mpr ((PrimeSpectrum.mem_zeroLocus _ _).mp hx)
    have hfx : f' x = wcQuadModelStr A (r + 2) π (wcSrmCh A r) (β x) := by
      rw [← hf', Scheme.Hom.comp_apply]
    have hπx : π ∈ (f' x).asIdeal := by
      rw [hfx]
      show algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmCh A r)) π ∈ (β x).asIdeal
      exact hJ hπJ
    have hmx : (f' x).asIdeal = IsLocalRing.maximalIdeal A := by
      apply le_antisymm (IsLocalRing.le_maximalIdeal (PrimeSpectrum.isPrime _).ne_top)
      rw [hπ, Ideal.span_le, Set.singleton_subset_iff]
      exact hπx
    let pt : Spec (CommRingCat.of (IsLocalRing.ResidueField A)) :=
      (⟨⊥, inferInstance⟩ : PrimeSpectrum (IsLocalRing.ResidueField A))
    have hpt : f' x = wcQmSp A pt := by
      apply PrimeSpectrum.ext
      rw [hmx]
      show IsLocalRing.maximalIdeal A = Ideal.comap (IsLocalRing.residue A) ⊥
      rw [← RingHom.ker_eq_comap_bot, IsLocalRing.ker_residue]
    obtain ⟨z, hz, -⟩ := Scheme.Pullback.exists_preimage_pullback x pt hpt
    exact ⟨z, hz⟩

  have hZ2 : ∀ z, z ∈ wcSrhlExc A (r + 2) π _ β f' ↔
      β (Limits.pullback.fst f' (wcQmSp A) z) ∈ PrimeSpectrum.zeroLocus (Set.range (wcSrmGen A r π)) := by
    intro z
    change (fun x => (Limits.pullback.fst f' (wcQmSp A) ≫ β) x) z ∈
      PrimeSpectrum.zeroLocus (Set.range (wcSrmGen A r π)) ↔ _
    simp only [Scheme.Hom.comp_apply]
  obtain ⟨η, hη⟩ := hlift _ (hPE ⟨0, by omega⟩)
  have hηZ : η ∈ wcSrhlExc A (r + 2) π _ β f' := by
    rw [hZ2, hη]; exact hPE ⟨0, by omega⟩
  have hspec2 : ∀ z ∈ wcSrhlExc A (r + 2) π _ β f', η ⤳ z := by
    intro z hz
    rw [← hind.specializes_iff, hη]
    exact hspec _ ((hZ2 z).mp hz)
  intro U V hU hV hUne hVne
  obtain ⟨u, huE, huU⟩ := hUne
  obtain ⟨v, hvE, hvV⟩ := hVne
  exact ⟨η, hηZ, (hspec2 u huE).mem_open hU huU, (hspec2 v hvE).mem_open hV hvV⟩

theorem wc_etqm_srhl_open_irred (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (n : ℕ) (hn : Even n)
    (hn4 : 4 ≤ n) (π : A) (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    (c : Matrix (Fin n) (Fin n) A)
    (hc : c = Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0)
    (X' : Scheme.{u}) (β : X' ⟶ Spec (.of (wcQuadModelRing A n π c)))
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun i : Fin n =>
        (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
          (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
            (MvPolynomial.X (⟨2 * (i.val / 2), lt_of_le_of_lt (Nat.mul_div_le i.val 2) i.isLt⟩ :
              Fin n)))))) β)
    (hprop : IsProper β) (f' : X' ⟶ Spec (.of A)) (hf' : β ≫ wcQuadModelStr A n π c = f')
    (hcov : ∀ x : X', ∃ (U : X'.Opens) (r : ℕ)
      (g : U.toScheme ⟶ Spec (.of (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))),
      x ∈ U ∧ Etale g ∧
      g ≫ wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) = U.ι ≫ f') :
    IsPreirreducible (wcSrhlExc A n π c β f')ᶜ :=
by
  classical

  suffices key : ∀ (I : (Spec (.of (wcQuadModelRing A n π c))).IdealSheafData),
      wcCsdIsBlowup I β →
      (∀ y : Spec (.of (wcQuadModelRing A n π c)), y ∈ (I.support : Set _) → ∀ i : Fin n,
        Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (MvPolynomial.X (⟨2 * (i.val / 2), lt_of_le_of_lt (Nat.mul_div_le i.val 2) i.isLt⟩ :
            Fin n)) ∈ y.asIdeal) →
      IsPreirreducible (wcSrhlExc A n π c β f')ᶜ by
    refine key _ hbl ?_
    intro y hy i
    rw [Scheme.IdealSheafData.coe_support_ofIdealTop, Scheme.mem_zeroLocus_iff] at hy
    have h3 := hy _ (Ideal.subset_span ⟨i, rfl⟩)
    rw [basicOpen_eq_of_affine] at h3
    by_contra hcon
    exact h3 ((PrimeSpectrum.mem_basicOpen _ _).mpr hcon)
  intro I hbl hG3

  have hρπ : IsLocalRing.residue A π = 0 := by
    rw [IsLocalRing.residue_eq_zero_iff, hπ]; exact Ideal.mem_span_singleton_self π

  have hquad : ∀ (K : Type u) [Field K] (m : ℕ), Even m → 4 ≤ m →
      Prime (∑ p : Fin m, ∑ q : Fin m, MvPolynomial.C (if p.val % 2 = 0 ∧ q.val = p.val + 1 then
        (1 : K) else 0) * MvPolynomial.X p * MvPolynomial.X q) ∧
      ∀ i0 : Fin m, i0.val = 0 → (MvPolynomial.X i0 : MvPolynomial (Fin m) K) ∉ Ideal.span
        {∑ p : Fin m, ∑ q : Fin m, MvPolynomial.C (if p.val % 2 = 0 ∧ q.val = p.val + 1 then
          (1 : K) else 0) * MvPolynomial.X p * MvPolynomial.X q} := by
    intro K _ m hm hm4
    obtain ⟨k, hk⟩ := hm
    obtain ⟨d, rfl⟩ : ∃ d, m = d + 1 + 1 := ⟨m - 2, by omega⟩
    refine ⟨?_, ?_⟩
    · obtain ⟨a, ha⟩ : ∃ a : Fin (d + 1 + 1) → Fin (d + 1 + 1) → K,
          a = fun (p q : Fin (d + 1 + 1)) =>
            if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0 := ⟨_, rfl⟩
      have hσlt : ∀ p : Fin (d + 1 + 1),
          (if p.val % 2 = 0 then p.val + 1 else p.val - 1) < d + 1 + 1 := by
        intro p; have := p.isLt; split_ifs <;> omega
      let σ : Fin (d + 1 + 1) → Fin (d + 1 + 1) := fun p => ⟨_, hσlt p⟩
      have hσσ : ∀ p, σ (σ p) = p := by
        intro p; apply Fin.ext; dsimp only [σ]; have := p.isLt; split_ifs <;> omega
      have hM : ∀ p q : Fin (d + 1 + 1),
          (Matrix.of a + (Matrix.of a).transpose) p q = if q = σ p then 1 else 0 := by
        intro p q
        have hq : q = σ p ↔ q.val = (if p.val % 2 = 0 then p.val + 1 else p.val - 1) :=
          Fin.ext_iff
        rw [Matrix.add_apply, Matrix.transpose_apply, Matrix.of_apply, Matrix.of_apply, ha]
        simp only [hq]
        have := p.isLt; have := q.isLt
        split_ifs <;> first | omega | simp
      have hMM : (Matrix.of a + (Matrix.of a).transpose) *
          (Matrix.of a + (Matrix.of a).transpose) = 1 := by
        ext p r
        rw [Matrix.mul_apply, Matrix.one_apply]
        simp only [hM, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq', Finset.sum_ite_eq,
          Finset.mem_univ, if_true, hσσ]
        rcases eq_or_ne p r with h | h
        · simp [h]
        · simp [h, Ne.symm h]
      have hdet : (Matrix.of a + (Matrix.of a).transpose).det ≠ 0 := by
        intro h0
        have h1 := congrArg Matrix.det hMM
        rw [Matrix.det_mul, h0, mul_zero, Matrix.det_one] at h1
        exact zero_ne_one h1
      have hP := wc_qsf_quad_prime K d (by omega) a hdet
      have e : (wcLdpQuad K (d + 1) a : MvPolynomial (Fin (d + 1 + 1)) K) =
          ∑ p : Fin (d + 1 + 1), ∑ q : Fin (d + 1 + 1), MvPolynomial.C
            (if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0) *
              MvPolynomial.X p * MvPolynomial.X q := by
        show (∑ p : Fin (d + 1 + 1), ∑ q : Fin (d + 1 + 1),
          MvPolynomial.C (a p q) * (MvPolynomial.X p * MvPolynomial.X q)) = _
        rw [ha]
        simp only [mul_assoc]
      rw [e] at hP
      exact hP
    · intro i0 hi0 hmem
      obtain ⟨G, hG⟩ := Ideal.mem_span_singleton'.mp hmem
      have hz0 : MvPolynomial.eval (fun p : Fin (d + 1 + 1) => if p.val = 0 then (1 : K) else 0)
          (∑ p : Fin (d + 1 + 1), ∑ q : Fin (d + 1 + 1), MvPolynomial.C
            (if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0) *
              MvPolynomial.X p * MvPolynomial.X q) = 0 := by
        rw [map_sum]
        refine Finset.sum_eq_zero fun p _ => ?_
        rw [map_sum]
        refine Finset.sum_eq_zero fun q _ => ?_
        simp only [map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X]
        split_ifs <;> first | omega | simp
      have hx1 : MvPolynomial.eval (fun p : Fin (d + 1 + 1) => if p.val = 0 then (1 : K) else 0)
          (MvPolynomial.X i0) = 1 := by
        rw [MvPolynomial.eval_X, if_pos hi0]
      have h1 := congrArg
        (MvPolynomial.eval (fun p : Fin (d + 1 + 1) => if p.val = 0 then (1 : K) else 0)) hG
      rw [map_mul, hz0, mul_zero, hx1] at h1
      exact zero_ne_one h1
  obtain ⟨hQprime, hX0⟩ := hquad (IsLocalRing.ResidueField A) n hn hn4
  obtain ⟨Qκ, hQκ⟩ : ∃ Q : MvPolynomial (Fin n) (IsLocalRing.ResidueField A),
      Q = ∑ p : Fin n, ∑ q : Fin n, MvPolynomial.C (if p.val % 2 = 0 ∧ q.val = p.val + 1 then
        (1 : IsLocalRing.ResidueField A) else 0) * MvPolynomial.X p * MvPolynomial.X q :=
    ⟨_, rfl⟩
  rw [← hQκ] at hQprime hX0

  have hmapF : MvPolynomial.map (IsLocalRing.residue A)
      (∑ p : Fin n, ∑ q : Fin n, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
        MvPolynomial.C π) = Qκ := by
    rw [hQκ, map_sub, MvPolynomial.map_C, hρπ, MvPolynomial.C_0, sub_zero, map_sum]
    refine Finset.sum_congr rfl fun p _ => ?_
    rw [map_sum]
    refine Finset.sum_congr rfl fun q _ => ?_
    rw [map_mul, map_mul, MvPolynomial.map_C, MvPolynomial.map_X, MvPolynomial.map_X]
    simp only [hc, Matrix.of_apply]
    split_ifs <;> simp
  have hπbar : algebraMap A (wcQuadModelRing A n π c) π =
      Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.C π) :=
    (Ideal.Quotient.mk_algebraMap A _ π).symm
  have hΨ : ∀ a ∈ wcQuadModelIdeal A n π c,
      ((Ideal.Quotient.mk (Ideal.span {Qκ})).comp
        (MvPolynomial.map (IsLocalRing.residue A))) a = 0 := by
    intro a ha
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [RingHom.comp_apply, map_mul, hmapF, map_mul,
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self Qκ), mul_zero]
  obtain ⟨Φ, hΦdef⟩ : ∃ Φ : wcQuadModelRing A n π c →+*
      MvPolynomial (Fin n) (IsLocalRing.ResidueField A) ⧸ Ideal.span {Qκ},
      Φ = Ideal.Quotient.lift (wcQuadModelIdeal A n π c) _ hΨ := ⟨_, rfl⟩
  have hΦmk : ∀ F₀, Φ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) F₀) =
      Ideal.Quotient.mk (Ideal.span {Qκ}) (MvPolynomial.map (IsLocalRing.residue A) F₀) := by
    intro F₀; rw [hΦdef, Ideal.Quotient.lift_mk]; rfl
  have hΦπ : Φ (algebraMap A (wcQuadModelRing A n π c) π) = 0 := by
    rw [hπbar, hΦmk, MvPolynomial.map_C, hρπ, MvPolynomial.C_0, map_zero]
  have hΦker : ∀ r, Φ r = 0 ↔ r ∈ Ideal.span {algebraMap A (wcQuadModelRing A n π c) π} := by
    intro r
    constructor
    · intro h0
      obtain ⟨F₀, rfl⟩ := Ideal.Quotient.mk_surjective r
      rw [hΦmk, Ideal.Quotient.eq_zero_iff_mem] at h0
      obtain ⟨G, hG⟩ := Ideal.mem_span_singleton'.mp h0
      obtain ⟨G', hG'⟩ := MvPolynomial.map_surjective _ IsLocalRing.residue_surjective G
      have hker : F₀ - G' * (∑ p : Fin n, ∑ q : Fin n, MvPolynomial.C (c p q) *
          MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C π) ∈
          RingHom.ker (MvPolynomial.map (IsLocalRing.residue A)) := by
        rw [RingHom.mem_ker, map_sub, map_mul, hG', hmapF, hG, sub_self]
      rw [MvPolynomial.ker_map, IsLocalRing.ker_residue, hπ, Ideal.map_span,
        Set.image_singleton] at hker
      obtain ⟨H, hH⟩ := Ideal.mem_span_singleton'.mp hker
      rw [hπbar]
      refine Ideal.mem_span_singleton'.mpr ⟨Ideal.Quotient.mk _ H, ?_⟩
      rw [← map_mul, Ideal.Quotient.eq]
      exact Ideal.mem_span_singleton'.mpr ⟨-G', by rw [hH]; ring⟩
    · intro hmem
      obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hmem
      rw [map_mul, hΦπ, mul_zero]

  haveI hJprime : (Ideal.span {Qκ}).IsPrime :=
    (Ideal.span_singleton_prime hQprime.ne_zero).mpr hQprime
  have hP : (Ideal.span {algebraMap A (wcQuadModelRing A n π c) π}).IsPrime := by
    have heq : Ideal.span {algebraMap A (wcQuadModelRing A n π c) π} = RingHom.ker Φ := by
      ext r; rw [RingHom.mem_ker, hΦker]
    rw [heq]; exact RingHom.ker_isPrime Φ
  let η : PrimeSpectrum (wcQuadModelRing A n π c) :=
    ⟨Ideal.span {algebraMap A (wcQuadModelRing A n π c) π}, hP⟩
  have hηΛ : ¬ ∀ i : Fin n, Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
      (MvPolynomial.X (⟨2 * (i.val / 2), lt_of_le_of_lt (Nat.mul_div_le i.val 2) i.isLt⟩ :
        Fin n)) ∈ η.asIdeal := by
    intro h
    have h0 := (hΦker _).mpr (h ⟨0, by omega⟩)
    rw [hΦmk, MvPolynomial.map_X, Ideal.Quotient.eq_zero_iff_mem] at h0
    exact hX0 _ (by simp) h0

  let W : (Spec (.of (wcQuadModelRing A n π c))).Opens :=
    ⟨(I.support : Set _)ᶜ, I.support.isClosed.isOpen_compl⟩
  have hW0 : ∀ p, p ∈ W → p ∉ (I.support : Set _) := fun p h => h
  have hW0' : ∀ p, p ∉ (I.support : Set _) → p ∈ W := fun p h => h
  have hW : IsIso (β ∣_ W) := wc_csd_blowup_iso_off_center _ _ I β W hbl
    (Set.eq_empty_iff_forall_notMem.mpr (fun p hp => hW0 p hp.2 hp.1))
  haveI := hW

  have hQmCI : IsClosedImmersion (wcQmSp A) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  have hι : IsClosedImmersion (Limits.pullback.fst f' (wcQmSp A)) :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion)
      (IsPullback.of_hasPullback f' (wcQmSp A)).flip hQmCI
  have hιi : Topology.IsInducing ⇑(Limits.pullback.fst f' (wcQmSp A)) := by
    haveI := hι; exact (Scheme.Hom.isClosedEmbedding _).isInducing
  have hmemZ : ∀ x, x ∈ (wcSrhlExc A n π c β f')ᶜ ↔ ¬ ∀ i : Fin n,
      Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
        (MvPolynomial.X (⟨2 * (i.val / 2), lt_of_le_of_lt (Nat.mul_div_le i.val 2) i.isLt⟩ :
          Fin n)) ∈ (β (Limits.pullback.fst f' (wcQmSp A) x)).asIdeal := by
    intro x
    refine not_congr ⟨fun h i => ?_, fun h => ?_⟩
    · exact h ⟨i, rfl⟩
    · rintro _ ⟨i, rfl⟩
      exact h i
  have hZW : ∀ x ∈ (wcSrhlExc A n π c β f')ᶜ, β (Limits.pullback.fst f' (wcQmSp A) x) ∈ W :=
    fun x hx => hW0' _ (fun hsupp => (hmemZ x).mp hx (hG3 _ hsupp))
  have hηW : (η : Spec (.of (wcQuadModelRing A n π c))) ∈ W :=
    hW0' _ (fun hs => hηΛ (hG3 _ hs))

  have hsπ : ∀ ω : Spec (.of (IsLocalRing.ResidueField A)), π ∈ (wcQmSp A ω).asIdeal := by
    intro ω
    show IsLocalRing.residue A π ∈ ω.asIdeal
    rw [hρπ]; exact ω.asIdeal.zero_mem
  have s3 : ∀ P : PrimeSpectrum A, π ∈ P.asIdeal → P.asIdeal = IsLocalRing.maximalIdeal A := by
    intro P hP
    have hle : IsLocalRing.maximalIdeal A ≤ P.asIdeal := by
      rw [hπ, Ideal.span_singleton_le_iff_mem]; exact hP
    exact ((IsLocalRing.maximalIdeal.isMaximal A).eq_of_le P.isPrime.ne_top hle).symm
  have hstr : ∀ y : Spec (.of (wcQuadModelRing A n π c)),
      π ∈ (wcQuadModelStr A n π c y).asIdeal ↔
        algebraMap A (wcQuadModelRing A n π c) π ∈ y.asIdeal := fun y => Iff.rfl
  have hcond : (Limits.pullback.fst f' (wcQmSp A) ≫ β) ≫ wcQuadModelStr A n π c =
      Limits.pullback.snd f' (wcQmSp A) ≫ wcQmSp A := by
    rw [Category.assoc, hf', Limits.pullback.condition]
  have hall : ∀ x, algebraMap A (wcQuadModelRing A n π c) π ∈
      (β (Limits.pullback.fst f' (wcQmSp A) x)).asIdeal := by
    intro x
    apply (hstr _).mp
    have hx := congrArg (fun φ : Limits.pullback f' (wcQmSp A) ⟶ Spec (.of A) => φ x) hcond
    simp only [Scheme.Hom.comp_apply] at hx
    rw [hx]
    exact hsπ _
  have hηstr : wcQuadModelStr A n π c η =
      wcQmSp A (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) := by
    apply PrimeSpectrum.ext
    exact (s3 _ ((hstr η).mpr
      (Ideal.mem_span_singleton_self (algebraMap A (wcQuadModelRing A n π c) π)))).trans
        (s3 _ (hsπ _)).symm

  obtain ⟨z, hz⟩ := (β ∣_ W).surjective ⟨η, hηW⟩
  have hz0 : β z.1 = η := by
    have := congrArg Subtype.val hz
    rw [morphismRestrict_base_coe] at this
    exact this
  have hcompat : f' z.1 = wcQmSp A (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) := by
    rw [← hf', Scheme.Hom.comp_apply, hz0, hηstr]
  obtain ⟨xη, hxη1, -⟩ := Scheme.Pullback.exists_preimage_pullback
    (f := f') (g := wcQmSp A) z.1 _ hcompat
  have hxη : β (Limits.pullback.fst f' (wcQmSp A) xη) = η := by rw [hxη1, hz0]
  have hxηU : xη ∈ (wcSrhlExc A n π c β f')ᶜ := (hmemZ xη).mpr (by rw [hxη]; exact hηΛ)

  have hψ : Topology.IsOpenEmbedding ⇑((β ⁻¹ᵁ W).ι ≫ β) := by
    rw [← morphismRestrict_ι]
    exact Scheme.Hom.isOpenEmbedding _
  let h₁ : ↥((wcSrhlExc A n π c β f')ᶜ) → (β ⁻¹ᵁ W).toScheme := fun x =>
    ⟨Limits.pullback.fst f' (wcQmSp A) x.1, (Scheme.Hom.mem_preimage β).mpr (hZW x.1 x.2)⟩
  have hh₁ : Topology.IsInducing h₁ := by
    have e1 : ⇑(β ⁻¹ᵁ W).ι ∘ h₁ = ⇑(Limits.pullback.fst f' (wcQmSp A)) ∘ Subtype.val := by
      funext x; rfl
    rw [← (Topology.IsInducing.of_comp_iff
      (Scheme.Hom.isOpenEmbedding (β ⁻¹ᵁ W).ι).isInducing), e1]
    exact hιi.comp Topology.IsInducing.subtypeVal
  have hind : Topology.IsInducing (fun x : ↥((wcSrhlExc A n π c β f')ᶜ) =>
      β (Limits.pullback.fst f' (wcQmSp A) x.1)) := by
    have e2 : (fun x : ↥((wcSrhlExc A n π c β f')ᶜ) =>
        β (Limits.pullback.fst f' (wcQmSp A) x.1)) = ⇑((β ⁻¹ᵁ W).ι ≫ β) ∘ h₁ := by
      funext x
      rw [Function.comp_apply, Scheme.Hom.comp_apply]
      rfl
    rw [e2]
    exact hψ.isInducing.comp hh₁

  have hspec : ∀ x ∈ (wcSrhlExc A n π c β f')ᶜ, xη ⤳ x := by
    intro x hx
    have h1 : (η : Spec (.of (wcQuadModelRing A n π c))) ⤳
        β (Limits.pullback.fst f' (wcQmSp A) x) :=
      (PrimeSpectrum.le_iff_specializes η (β (Limits.pullback.fst f' (wcQmSp A) x))).mp
        ((PrimeSpectrum.asIdeal_le_asIdeal η (β (Limits.pullback.fst f' (wcQmSp A) x))).mp
          ((Ideal.span_singleton_le_iff_mem _).mpr (hall x)))
    have h2 : (⟨xη, hxηU⟩ : ↥((wcSrhlExc A n π c β f')ᶜ)) ⤳ ⟨x, hx⟩ := by
      rw [← hind.specializes_iff]
      show β (Limits.pullback.fst f' (wcQmSp A) xη) ⤳ β (Limits.pullback.fst f' (wcQmSp A) x)
      rw [hxη]; exact h1
    exact h2.map continuous_subtype_val

  unfold IsPreirreducible
  rintro u v hu hv ⟨x, hxs, hxu⟩ ⟨y, hys, hyv⟩
  exact ⟨xη, hxηU, (hspec x hxs).mem_open hu hxu, (hspec y hys).mem_open hv hyv⟩

theorem wc_etqm_sr_hom_line (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) (k : ℕ) (n : ℕ) (hn : Even n) (hn4 : 4 ≤ n) (π : A)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    (c : Matrix (Fin n) (Fin n) A)
    (hc : c = Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0)
    (X' : Scheme.{u}) (β : X' ⟶ Spec (.of (wcQuadModelRing A n π c)))
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun i : Fin n =>
        (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
          (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
            (MvPolynomial.X (⟨2 * (i.val / 2), lt_of_le_of_lt (Nat.mul_div_le i.val 2) i.isLt⟩ :
              Fin n)))))) β)
    (hprop : IsProper β) (f' : X' ⟶ Spec (.of A)) (hf' : β ≫ wcQuadModelStr A n π c = f')
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A))
    (hφπ : (Spec.preimage ξ).hom π ≠ 0)
    (Dh' : wcEtPullData (Limits.pullback.fst f' ξ) (ℓ ^ k))
    (Dg' : wcEtPullData (Limits.pullback.fst f' (wcQmSp A)) (ℓ ^ k))
    (I' : InjectiveResolution (SheafOfModules.unit (wcEtZModRing (Limits.pullback f' ξ) (ℓ ^ k)))) :
    haveI := Dg'.additive
    haveI := Dh'.additive
    let P' := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst f' ξ)) _ _ Dh'.cont Dh'.φ
    haveI : P'.Additive := Adjunction.right_adjoint_additive Dh'.adj
    let eK' := (HomologicalComplex.single (SheafOfModules.{u+1} (wcEtZModRing X' (ℓ ^ k))) (ComplexShape.up ℤ) 0).map
          (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst f' ξ)) _ _ Dh'.cont Dh'.φ) ≫
        (HomologicalComplex.singleMapHomologicalComplex P' (ComplexShape.up ℤ) 0).inv.app
          (SheafOfModules.unit (wcEtZModRing (Limits.pullback f' ξ) (ℓ ^ k))) ≫
        (P'.mapHomologicalComplex (ComplexShape.up ℤ)).map I'.ι'
    let eΨ' := (HomologicalComplex.single (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k))) (ComplexShape.up ℤ) 0).map
          Dg'.μ.inv ≫
        (HomologicalComplex.singleMapHomologicalComplex Dg'.Φ (ComplexShape.up ℤ) 0).inv.app
          (SheafOfModules.unit (wcEtZModRing X' (ℓ ^ k))) ≫
        (Dg'.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map eK'
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k)))
    ∃ ν : DerivedCategory.Q.obj (CochainComplex.mappingCone eΨ') ⟶
        DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
          (SheafOfModules.unit (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k)))),
      ∀ g : DerivedCategory.Q.obj (CochainComplex.mappingCone eΨ') ⟶
        DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
          (SheafOfModules.unit (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k)))),
        ∃ a : ℕ, g = a • ν :=
by
  intro P' eK' eΨ'
  haveI := Dh'.additive
  haveI := Dg'.additive
  haveI : P'.Additive := Adjunction.right_adjoint_additive Dh'.adj
  letI := HasDerivedCategory.standard
    (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k)))
  rcases Nat.eq_zero_or_pos k with hk0 | hkpos
  ·
    have hz : ∀ G : SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k)),
        Limits.IsZero G := by
      intro G
      have h := wc_et_zmod_toSheaf_nsmul_zero (Limits.pullback f' (wcQmSp A)) (ℓ ^ k) G
      have hone : ℓ ^ k = 1 := by rw [hk0, pow_zero]
      rw [Limits.IsZero.iff_id_eq_zero]
      apply (SheafOfModules.toSheaf _).map_injective
      rw [CategoryTheory.Functor.map_id, CategoryTheory.Functor.map_zero]
      exact (fun {M : Type _} [AddMonoid M] (x : M) (hx : (ℓ ^ k) • x = 0) =>
        (by rwa [hone, one_smul] at hx : x = 0)) _ h
    have hC : Limits.IsZero (CochainComplex.mappingCone eΨ') := by
      rw [Limits.IsZero.iff_id_eq_zero]
      ext i : 1
      exact (hz _).eq_of_src _ _
    refine ⟨0, fun g => ⟨0, ?_⟩⟩
    rw [zero_smul]
    exact (DerivedCategory.Q.map_isZero hC).eq_of_src _ _
  have hk : 1 ≤ k := hkpos
  haveI := Dg'.presLim
  haveI := Dg'.presColim
  haveI : Limits.PreservesFiniteLimits P' := by
    haveI := Dh'.adj.rightAdjoint_preservesLimits
    infer_instance
  have homology_transfer : ∀ {𝒜 𝒜' ℬ : Type (u+2)} [Category.{u+1} 𝒜] [Category.{u+1} 𝒜']
      [Category.{u+1} ℬ] [Abelian 𝒜] [Abelian 𝒜'] [Abelian ℬ]
      (P : 𝒜' ⥤ 𝒜) [P.Additive] [Limits.PreservesFiniteLimits P]
      (G : 𝒜 ⥤ ℬ) [G.Additive] [Limits.PreservesFiniteLimits G]
      [Limits.PreservesFiniteColimits G]
      {O : 𝒜} {O' : 𝒜'} {Os : ℬ} (u : O ⟶ P.obj O') (μ : G.obj O ≅ Os)
      (I : InjectiveResolution O'),
      let Ψ := (G.mapHomologicalComplex (ComplexShape.up ℤ)).obj
        ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex)
      (∀ q : ℕ, Nonempty (Ψ.homology (q : ℤ) ≅
          G.obj (((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q))) := by
    intro 𝒜 𝒜' ℬ _ _ _ _ _ _ P _ _ G _ _ _ O O' Os u μ I Ψ
    intro q
    let Kn := (P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex
    let L := (G.mapHomologicalComplex (ComplexShape.up ℕ)).obj Kn
    let φ : ∀ a : Option ℕ, G.obj (P.obj (HomologicalComplex.extend.X I.cocomplex a)) ≅
        HomologicalComplex.extend.X L a := fun a =>
      match a with
      | some k => Iso.refl _
      | none => Limits.IsZero.iso (G.map_isZero (P.map_isZero (Limits.isZero_zero _)))
          (Limits.isZero_zero _)
    have hφ : ∀ a b : Option ℕ,
        (φ a).hom ≫ HomologicalComplex.extend.d L a b =
          G.map (P.map (HomologicalComplex.extend.d I.cocomplex a b)) ≫ (φ b).hom := by
      intro a b
      cases a with
      | none => exact (G.map_isZero (P.map_isZero (Limits.isZero_zero _))).eq_of_src _ _
      | some i =>
        cases b with
        | none => exact (Limits.isZero_zero _).eq_of_tgt _ _
        | some j => exact (Category.id_comp _).trans (Category.comp_id _).symm
    let isoΨ : Ψ ≅ L.extend ComplexShape.embeddingUpNat :=
      HomologicalComplex.Hom.isoOfComponents
        (fun i => φ (ComplexShape.embeddingUpNat.r i))
        (fun i j _ => hφ _ _)
    exact ⟨HomologicalComplex.homologyMapIso isoΨ (q : ℤ) ≪≫
      L.extendHomologyIso ComplexShape.embeddingUpNat (j := q) rfl ≪≫
      (Kn.sc q).mapHomologyIso G⟩

  have hcov : ∀ x : X', ∃ (U : X'.Opens) (r : ℕ)
      (g : U.toScheme ⟶ Spec (.of (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))),
      x ∈ U ∧ Etale g ∧
      g ≫ wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) =
        U.ι ≫ f' := by
    obtain ⟨X₀, β₀, hbl₀, -, hcov₀, -⟩ := wc_etqm_sr_model A n hn hn4 π hπ c hc
    obtain ⟨φ, hφ, -⟩ := hbl₀.2 X' β hbl.1
    obtain ⟨ψ, hψ, -⟩ := hbl.2 X₀ β₀ hbl₀.1
    have h1 : φ ≫ ψ = 𝟙 X' := by
      apply (hbl.2 X' β hbl.1).unique
      · simp only [Category.assoc, hψ, hφ]
      · simp only [Category.id_comp]
    have h2 : ψ ≫ φ = 𝟙 X₀ := by
      apply (hbl₀.2 X₀ β₀ hbl₀.1).unique
      · simp only [Category.assoc, hφ, hψ]
      · simp only [Category.id_comp]
    haveI : IsIso φ := ⟨⟨ψ, h1, h2⟩⟩
    have hf : φ ≫ β₀ ≫ wcQuadModelStr A n π c = f' := by
      rw [← Category.assoc, hφ, hf']
    intro x
    obtain ⟨U₀, r, g₀, hx, hg₀, heq⟩ := hcov₀ (φ x)
    haveI := hg₀
    refine ⟨φ ⁻¹ᵁ U₀, r, (φ ∣_ U₀) ≫ g₀, ?_, ?_, ?_⟩
    · exact (Scheme.Hom.mem_preimage φ).mpr hx
    · infer_instance
    · rw [Category.assoc, heq, ← Category.assoc, morphismRestrict_ι, Category.assoc, hf]

  let Z₂ : Set ↥(Limits.pullback f' (wcQmSp A)) := wcSrhlExc A n π c β f'
  have hZ₂ : IsClosed Z₂ :=
    IsClosed.preimage (Scheme.Hom.continuous _) (PrimeSpectrum.isClosed_zeroLocus _)
  let Z₁ : Set ↥(Limits.pullback f' (wcQmSp A)) := closure Z₂ᶜ
  have hZ₁ : IsClosed Z₁ := isClosed_closure
  let ZY : Set ↥(Limits.pullback f' (wcQmSp A)) := Z₁ ∩ Z₂
  have hZY : IsClosed ZY := hZ₁.inter hZ₂
  let I₁ := Scheme.IdealSheafData.vanishingIdeal
    (⟨Z₁, hZ₁⟩ : TopologicalSpace.Closeds ↥(Limits.pullback f' (wcQmSp A)))
  let I₂ := Scheme.IdealSheafData.vanishingIdeal
    (⟨Z₂, hZ₂⟩ : TopologicalSpace.Closeds ↥(Limits.pullback f' (wcQmSp A)))
  let IY := Scheme.IdealSheafData.vanishingIdeal
    (⟨ZY, hZY⟩ : TopologicalSpace.Closeds ↥(Limits.pullback f' (wcQmSp A)))
  have hr₁ : Set.range I₁.subschemeι = Z₁ :=
    (Scheme.IdealSheafData.range_subschemeι _).trans
      (Scheme.IdealSheafData.coe_support_vanishingIdeal _)
  have hr₂ : Set.range I₂.subschemeι = Z₂ :=
    (Scheme.IdealSheafData.range_subschemeι _).trans
      (Scheme.IdealSheafData.coe_support_vanishingIdeal _)
  have hrY : Set.range IY.subschemeι = ZY :=
    (Scheme.IdealSheafData.range_subschemeι _).trans
      (Scheme.IdealSheafData.coe_support_vanishingIdeal _)
  obtain ⟨E₁⟩ := wc_et_zmod_pull_data_exists I₁.subschemeι (ℓ ^ k)
  obtain ⟨E₂⟩ := wc_et_zmod_pull_data_exists I₂.subschemeι (ℓ ^ k)
  obtain ⟨EY⟩ := wc_et_zmod_pull_data_exists IY.subschemeι (ℓ ^ k)
  have hcover : Set.range I₁.subschemeι ∪ Set.range I₂.subschemeι = Set.univ := by
    rw [hr₁, hr₂]
    apply Set.eq_univ_of_forall
    intro x
    by_cases hx : x ∈ Z₂
    · exact Or.inr hx
    · exact Or.inl (subset_closure hx)
  have hinter : Set.range IY.subschemeι =
      Set.range I₁.subschemeι ∩ Set.range I₂.subschemeι := by
    rw [hr₁, hr₂, hrY]

  obtain ⟨ρ₁, ρ₂, hz, hS⟩ := wc_etqm_srhl_mv I₁.subschemeι I₂.subschemeι
    IY.subschemeι (ℓ ^ k) hcover hinter E₁ E₂ EY

  obtain ⟨hpc, hH1⟩ := wc_etqm_srhl_special_fibre_h1 A ℓ hℓ k hk n hn hn4 π hπ c hc X' β hbl
    hprop f' hf' hcov
  haveI := hpc
  have hm : ℓ ^ k ≠ 0 := pow_ne_zero _ (Fact.out : Nat.Prime ℓ).ne_zero

  have hconn₁ : IsPreconnected (Set.range I₁.subschemeι)ᶜ := by
    rw [hr₁]
    have hirr := wc_etqm_srhl_exc_irred A n hn hn4 π hπ c hc X' β hbl hprop f' hf' hcov
    refine (hirr.open_subset isClosed_closure.isOpen_compl ?_).isPreconnected
    intro x hx
    by_contra h
    exact hx (subset_closure h)
  have hconn₂ : IsPreconnected (Set.range I₂.subschemeι)ᶜ := by
    rw [hr₂]
    exact (wc_etqm_srhl_open_irred A n hn hn4 π hπ c hc X' β hbl hprop f' hf' hcov).isPreconnected

  have van : ∀ {Z : Scheme.{u}} (i : Z ⟶ Limits.pullback f' (wcQmSp A)) [IsClosedImmersion i]
      (E : wcEtPullData i (ℓ ^ k)), IsPreconnected (Set.range i)ᶜ →
      ∀ g : (DerivedCategory.singleFunctor
            (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k))) 0).obj
          (wcEtSuppObj E) ⟶
        ((DerivedCategory.singleFunctor
            (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k))) 0).obj
          (SheafOfModules.unit (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k))))⟦(1 : ℤ)⟧,
        g = 0 := by
    intro Z i _ E hconn g
    haveI hepi : Epi (wcEtSuppUnitMap E) := wc_et_supp_unit_epi i E
    let Sk := ShortComplex.mk (Limits.kernel.ι (wcEtSuppUnitMap E)) (wcEtSuppUnitMap E)
      (Limits.kernel.condition _)
    have hex : Sk.Exact := ShortComplex.exact_of_f_is_kernel Sk (Limits.kernelIsKernel _)
    have hSk : Sk.ShortExact := ShortComplex.ShortExact.mk' hex inferInstance hepi
    have hT := hSk.singleTriangle_distinguished
    obtain ⟨h, hh⟩ := Pretriangulated.Triangle.yoneda_exact₃ _ hT g (hH1 _)
    obtain ⟨k', hk'⟩ := (shiftFunctor (DerivedCategory
      (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k))))
      (1 : ℤ)).map_surjective h
    obtain ⟨φ, hφ⟩ := (DerivedCategory.singleFunctor
      (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k))) 0).map_surjective k'
    obtain ⟨c', hc'⟩ := wc_etqm_srhl_ker_hom_const i (ℓ ^ k) hm E hconn φ
    have h0 := Pretriangulated.comp_distTriang_mor_zero₃₁ _ hT
    rw [hh, ← hk', ← hφ, hc', Functor.map_comp, Functor.map_comp, ← Category.assoc]
    erw [h0, Limits.zero_comp]
  have van₁ := van I₁.subschemeι E₁ hconn₁
  have van₂ := van I₂.subschemeι E₂ hconn₂

  have hGE := wc_etqm_sr_ss_cone_ge_one A ℓ hℓ k π hπ X' f' hcov Ω ξ hφπ Dh' Dg' I'
  have ha := homology_transfer P' Dg'.Φ
    (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
      (wcEtBaseChange (Limits.pullback.fst f' ξ)) _ _ Dh'.cont Dh'.φ)
    Dg'.μ I'
  have hΨ : ∀ q : ℤ, 2 ≤ q → Limits.IsZero
      (((Dg'.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj
        ((P'.mapHomologicalComplex (ComplexShape.up ℤ)).obj I'.cochainComplex)).homology q) := by
    intro q hq
    obtain ⟨m, rfl⟩ := Int.eq_ofNat_of_zero_le (by omega : (0 : ℤ) ≤ q)
    obtain ⟨iso⟩ := ha m
    exact Limits.IsZero.of_iso (wc_etqm_sr_ss_restr_higher_vanish A ℓ hℓ k hk π hπ X' f' hcov
      Ω ξ hφπ Dh' Dg' I' m (by omega)) iso
  have hR1 := wc_etqm_srhl_R1_supp A ℓ hℓ k hk n hn hn4 π hπ c hc X' β hbl hprop f' hf' hcov
    Ω ξ hφπ Dh' Dg' I' IY.subschemeι hrY EY
  have h1 : Nonempty (((Dg'.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj
        ((P'.mapHomologicalComplex (ComplexShape.up ℤ)).obj I'.cochainComplex)).homology 1 ≅
      wcEtSuppObj EY) := by
    obtain ⟨i1⟩ := ha 1
    obtain ⟨i2⟩ := hR1
    exact ⟨i1 ≪≫ i2⟩
  obtain ⟨θ⟩ := wc_qmbt_hl_cone_single _ (wcEtSuppObj EY) _ eΨ' hGE hΨ h1

  have hT := hS.singleTriangle_distinguished
  let ε := (DerivedCategory.singleFunctorIsoCompQ
    (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k))) 0).app
    (SheafOfModules.unit (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k)))
  refine ⟨(shiftFunctor (DerivedCategory
      (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k)))) (1 : ℤ)).preimage
      (θ.hom ≫ hS.singleTriangle.mor₃ ≫
        (shiftFunctor (DerivedCategory
          (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k)))) (1 : ℤ)).map
          ε.hom), fun g => ?_⟩
  let G : (DerivedCategory.singleFunctor
      (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k))) 0).obj
      (wcEtSuppObj EY) ⟶
      ((DerivedCategory.singleFunctor
        (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k))) 0).obj
        (SheafOfModules.unit (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k))))⟦(1 : ℤ)⟧ :=
    θ.inv ≫ (shiftFunctor (DerivedCategory
        (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k)))) (1 : ℤ)).map g ≫
      (shiftFunctor (DerivedCategory
        (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k)))) (1 : ℤ)).map
        ε.inv
  have hG0 : hS.singleTriangle.mor₂ ≫ G = 0 := by
    show (DerivedCategory.singleFunctor
      (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k))) 0).map
      (Limits.biprod.desc ρ₁ (-ρ₂)) ≫ G = 0
    have e1 := van₁ ((DerivedCategory.singleFunctor
      (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k))) 0).map ρ₁ ≫ G)
    have e2 := van₂ ((DerivedCategory.singleFunctor
      (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k))) 0).map
      (-ρ₂) ≫ G)
    rw [Limits.biprod.desc_eq, Functor.map_add, Preadditive.add_comp, Functor.map_comp,
      Functor.map_comp, Category.assoc, Category.assoc, e1, e2, Limits.comp_zero,
      Limits.comp_zero, add_zero]
  obtain ⟨h, hh⟩ := Pretriangulated.Triangle.yoneda_exact₃ _ hT G hG0
  obtain ⟨k', hk'⟩ : ∃ k', (shiftFunctor (DerivedCategory
      (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k))))
      (1 : ℤ)).map k' = h := ⟨_, Functor.map_preimage _ _⟩
  obtain ⟨e, he⟩ : ∃ e, (DerivedCategory.singleFunctor
      (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k))) 0).map e = k' :=
    ⟨_, Functor.map_preimage _ _⟩
  obtain ⟨a, ha'⟩ := wc_etqm_srhl_unit_end_const (Limits.pullback f' (wcQmSp A)) (ℓ ^ k) hm e
  refine ⟨a, ?_⟩
  have key : (shiftFunctor (DerivedCategory
      (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k)))) (1 : ℤ)).map g =
      θ.hom ≫ G ≫
        (shiftFunctor (DerivedCategory
          (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k)))) (1 : ℤ)).map
          ε.hom := by
    simp only [G, Category.assoc, Iso.hom_inv_id_assoc, Iso.map_inv_hom_id, Category.comp_id]
  apply (shiftFunctor (DerivedCategory
    (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k)))) (1 : ℤ)).map_injective
  rw [Functor.map_nsmul, Functor.map_preimage, key, hh, ← hk', ← he, ha']
  simp only [Functor.map_nsmul, CategoryTheory.Functor.map_id, Preadditive.comp_nsmul,
    Preadditive.nsmul_comp, Category.comp_id, Category.id_comp, Category.assoc]
  erw [CategoryTheory.Functor.map_id, Category.id_comp]

theorem wc_etqm_srd_origin (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    (n : ℕ) (π : A) (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    (c : Matrix (Fin n) (Fin n) A) :
    ∃ (Z₀ : Scheme.{u}) (i₀ : Z₀ ⟶ Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A)),
      IsClosedImmersion i₀ ∧ Nonempty Z₀ ∧
      ∀ (z : Z₀) (p : Fin n), Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
        PrimeSpectrum.asIdeal ((i₀ ≫ Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A)) z) :=
by
  classical
  have hπm : π ∈ IsLocalRing.maximalIdeal A := by
    rw [hπ]; exact Ideal.mem_span_singleton_self π
  have hres : IsLocalRing.residue A π = 0 := (IsLocalRing.residue_eq_zero_iff π).mpr hπm
  let e : MvPolynomial (Fin n) A →+* IsLocalRing.ResidueField A :=
    MvPolynomial.eval₂Hom (IsLocalRing.residue A) (fun _ => 0)
  have hker : ∀ a ∈ wcQuadModelIdeal A n π c, e a = 0 := by
    intro a ha
    unfold wcQuadModelIdeal at ha
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul]
    apply mul_eq_zero_of_right
    simp [e, hres]
  let φ₀ : wcQuadModelRing A n π c →+* IsLocalRing.ResidueField A :=
    Ideal.Quotient.lift (wcQuadModelIdeal A n π c) e hker
  have hφX : ∀ p : Fin n,
      φ₀ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) = 0 := by
    intro p
    simp [φ₀, e]
  have hcomp : φ₀.comp (algebraMap A (wcQuadModelRing A n π c)) = IsLocalRing.residue A := by
    ext a
    show φ₀ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.C a)) = _
    simp [φ₀, e]
  have w : Spec.map (CommRingCat.ofHom φ₀) ≫ wcQuadModelStr A n π c = 𝟙 _ ≫ wcQmSp A := by
    rw [Category.id_comp]
    unfold wcQuadModelStr wcQmSp
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hcomp]
  let i₀ := Limits.pullback.lift (Spec.map (CommRingCat.ofHom φ₀)) (𝟙 _) w
  refine ⟨Spec (.of (IsLocalRing.ResidueField A)), i₀, ?_, inferInstance, ?_⟩
  · have h1 : IsClosedImmersion
        (i₀ ≫ Limits.pullback.snd (wcQuadModelStr A n π c) (wcQmSp A)) := by
      rw [Limits.pullback.lift_snd]; infer_instance
    exact IsClosedImmersion.of_comp i₀ (Limits.pullback.snd _ _)
  · intro z p
    rw [Limits.pullback.lift_fst, Spec.map_apply]
    show φ₀ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) ∈ z.asIdeal
    rw [hφX]
    exact Ideal.zero_mem _

theorem wc_etqm_srd_fibre_supp {S S' Z₀ P : Scheme.{u}} (i₀ : Z₀ ⟶ S) [IsClosedImmersion i₀]
    (b : S' ⟶ S) (iP : P ⟶ S') (p : P ⟶ Z₀) (hP : IsPullback p iP i₀ b) (m : ℕ)
    (D₀ : wcEtPullData i₀ m) (Db : wcEtPullData b m) (DP : wcEtPullData iP m) :
    Nonempty (Db.Φ.obj (wcEtSuppObj D₀) ≅ wcEtSuppObj DP) :=
by
  obtain ⟨γ, hγ, -⟩ := wc_et_closed_supp_base_change i₀ b iP p hP D₀ Db DP
  haveI : IsIso γ := wc_et_closed_supp_bc_gamma_isIso i₀ b iP p hP D₀ Db DP γ hγ
  exact ⟨(asIso γ).symm⟩

theorem wc_etqm_srd_derived_adj {S S' : Scheme.{u}} (b : S' ⟶ S) (m : ℕ) (Db : wcEtPullData b m)
    [EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing S' m))]
    (M : SheafOfModules.{u+1} (wcEtZModRing S m)) (q : ℤ) :
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing S m))
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing S' m))
    haveI := Db.additive
    let Pb := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange b) _ _ Db.cont Db.φ
    haveI : Pb.Additive := Adjunction.right_adjoint_additive Db.adj
    ∃ Θ : ∀ K : DerivedCategory.Plus (SheafOfModules.{u+1} (wcEtZModRing S' m)),
        (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj M) ⟶
          ((Pb.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).obj K)⟦q⟧) ≃+
        (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj (Db.Φ.obj M)) ⟶
          (DerivedCategory.Plus.ι.obj K)⟦q⟧),
      ∀ (K₁ K₂ : DerivedCategory.Plus (SheafOfModules.{u+1} (wcEtZModRing S' m))) (f : K₁ ⟶ K₂)
        (x : DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj M) ⟶
          ((Pb.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).obj K₁)⟦q⟧),
        Θ K₂ (x ≫ (shiftFunctor _ q).map ((Pb.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).map f)) =
          Θ K₁ x ≫ (shiftFunctor _ q).map (DerivedCategory.Plus.ι.map f) :=
by
  have key : ∀ {C D : Type (u+2)} [Category.{u+1} C] [Category.{u+1} D] [Abelian C] [Abelian D]
      [EnoughInjectives D]
      (Φ : C ⥤ D) [Φ.Additive] [Limits.PreservesFiniteLimits Φ] [Limits.PreservesFiniteColimits Φ]
      (P : D ⥤ C) [P.Additive] (adj : Φ ⊣ P) (M : C) (q : ℤ),
      letI := HasDerivedCategory.standard C
      letI := HasDerivedCategory.standard D
      ∃ Θ : ∀ K : DerivedCategory.Plus D,
          (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj M) ⟶
            ((P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).obj K)⟦q⟧) ≃+
          (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj (Φ.obj M)) ⟶
            (DerivedCategory.Plus.ι.obj K)⟦q⟧),
        ∀ (K₁ K₂ : DerivedCategory.Plus D) (f : K₁ ⟶ K₂)
          (x : DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj M) ⟶
            ((P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).obj K₁)⟦q⟧),
          Θ K₂ (x ≫ (shiftFunctor _ q).map ((P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).map f)) =
            Θ K₁ x ≫ (shiftFunctor _ q).map (DerivedCategory.Plus.ι.map f) := by
    intro C D _ _ _ _ _ Φ _ _ _ P _ adj M q
    letI := HasDerivedCategory.standard C
    letI := HasDerivedCategory.standard D

    let adjHC : Φ.mapHomologicalComplex (ComplexShape.up ℤ) ⊣ P.mapHomologicalComplex (ComplexShape.up ℤ) :=
      Adjunction.mkOfHomEquiv
        { homEquiv := fun K L =>
            { toFun := fun f =>
                { f := fun i => adj.homEquiv _ _ (f.f i)
                  comm' := by
                    intro i j _
                    rw [Functor.mapHomologicalComplex_obj_d, ← adj.homEquiv_naturality_right,
                      f.comm, Functor.mapHomologicalComplex_obj_d, adj.homEquiv_naturality_left] }
              invFun := fun g =>
                { f := fun i => (adj.homEquiv _ _).symm (g.f i)
                  comm' := by
                    intro i j _
                    rw [Functor.mapHomologicalComplex_obj_d, ← adj.homEquiv_naturality_left_symm,
                      ← g.comm, Functor.mapHomologicalComplex_obj_d,
                      adj.homEquiv_naturality_right_symm] }
              left_inv := fun f => by ext i; simp
              right_inv := fun g => by ext i; simp }
          homEquiv_naturality_left_symm := by
            intro X' X Y f g
            ext i
            simp [adj.homEquiv_naturality_left_symm]
          homEquiv_naturality_right := by
            intro X Y Y' f g
            ext i
            simp [adj.homEquiv_naturality_right] }
    let adjC : Φ.mapCochainComplexPlus ⊣ P.mapCochainComplexPlus :=
      adjHC.restrictFullyFaithful (CochainComplex.Plus.fullyFaithfulι C)
        (CochainComplex.Plus.fullyFaithfulι D) Φ.mapCochainComplexPlusCompι.symm
        P.mapCochainComplexPlusCompι.symm

    have hinv : (CochainComplex.Plus.quasiIso C).IsInvertedBy
        (Φ.mapCochainComplexPlus ⋙ DerivedCategory.Plus.Q) := by
      intro X Y f hf
      rw [CochainComplex.Plus.quasiIso_iff] at hf
      have h2 : CochainComplex.Plus.quasiIso D (Φ.mapCochainComplexPlus.map f) := by
        rw [CochainComplex.Plus.quasiIso_iff]
        exact HomologicalComplex.quasiIso_map_of_preservesHomology f.hom Φ
      exact Localization.inverts DerivedCategory.Plus.Q (CochainComplex.Plus.quasiIso D) _ h2
    let G' := Localization.lift _ hinv DerivedCategory.Plus.Q
    let α : DerivedCategory.Plus.Q ⋙ G' ≅ Φ.mapCochainComplexPlus ⋙ DerivedCategory.Plus.Q :=
      Localization.fac _ hinv DerivedCategory.Plus.Q
    let R := P.rightDerivedFunctorPlus
    haveI h1 : G'.IsLeftDerivedFunctor α.hom (CochainComplex.Plus.quasiIso C) :=
       Functor.isLeftDerivedFunctor_of_inverts _ G' α
    haveI h2 : (G' ⋙ R).IsLeftDerivedFunctor
         ((Functor.associator _ _ _).inv ≫ Functor.whiskerRight α.hom R)
         (CochainComplex.Plus.quasiIso C) :=
       Functor.isLeftDerivedFunctor_of_inverts _ (G' ⋙ R)
         ((Functor.associator _ _ _).symm ≪≫ Functor.isoWhiskerRight α R)
    have hd : (CochainComplex.Plus.localizerMorphism D).Derives
        ((P.mapCochainComplexPlus ⋙ DerivedCategory.Plus.Q) ⋙ G') :=
      MorphismProperty.IsInvertedBy.of_comp _ _
          (CochainComplex.Plus.localizerMorphism_derives_mapCochainComplexPlus P) G'
    haveI h3 : (R ⋙ G').IsRightDerivedFunctor
         (Functor.whiskerRight P.rightDerivedFunctorPlusUnit G' ≫ (Functor.associator _ _ _).hom)
         (CochainComplex.Plus.quasiIso D) :=
       hd.isRightDerivedFunctor_of_isIso _ (fun X₁ => by dsimp; infer_instance)
    let adjD : G' ⊣ R := adjC.derived (CochainComplex.Plus.quasiIso C) (CochainComplex.Plus.quasiIso D) α.hom
       P.rightDerivedFunctorPlusUnit

    let M0 : CochainComplex.Plus C := ⟨(HomologicalComplex.single C (ComplexShape.up ℤ) 0).obj M, ⟨0, inferInstance⟩⟩
    let N0 : CochainComplex.Plus D := ⟨(HomologicalComplex.single D (ComplexShape.up ℤ) 0).obj (Φ.obj M), ⟨0, inferInstance⟩⟩
    let X := DerivedCategory.Plus.Q.obj M0
    let Y := DerivedCategory.Plus.Q.obj N0
    let e : Φ.mapCochainComplexPlus.obj M0 ≅ N0 :=
      ObjectProperty.isoMk _ ((HomologicalComplex.singleMapHomologicalComplex Φ (ComplexShape.up ℤ) 0).app M)
    let t : G'.obj X ≅ Y := α.app M0 ≪≫ DerivedCategory.Plus.Q.mapIso e
    haveI : G'.Additive := adjD.left_adjoint_additive
    let cιC := (DerivedCategory.Plus.ι : DerivedCategory.Plus C ⥤ DerivedCategory C).commShiftIso q
    let cιD := (DerivedCategory.Plus.ι : DerivedCategory.Plus D ⥤ DerivedCategory D).commShiftIso q
    let cR := R.commShiftIso q
    let ffC : (DerivedCategory.Plus.ι : DerivedCategory.Plus C ⥤ DerivedCategory C).FullyFaithful :=
      ObjectProperty.fullyFaithfulι _
    let ffD : (DerivedCategory.Plus.ι : DerivedCategory.Plus D ⥤ DerivedCategory D).FullyFaithful :=
      ObjectProperty.fullyFaithfulι _
    have hpre : ∀ {Z₁ Z₂ : DerivedCategory.Plus C}
        (a : DerivedCategory.Plus.ι.obj X ⟶ DerivedCategory.Plus.ι.obj Z₁) (g : Z₁ ⟶ Z₂),
        ffC.preimage (a ≫ DerivedCategory.Plus.ι.map g) = ffC.preimage a ≫ g := by
      intro Z₁ Z₂ a g
      apply ffC.map_injective
      rw [Functor.map_comp, ffC.map_preimage, ffC.map_preimage]
    refine ⟨fun K =>
      ((AddEquiv.mk' ((cιC.app (R.obj K)).symm.homToEquiv) (fun a b => Preadditive.add_comp _ _ _ a b (cιC.app (R.obj K)).inv)).trans
        (AddEquiv.mk' ffC.homEquiv (fun a b => DerivedCategory.Plus.ι.map_add)).symm).trans
      (((AddEquiv.mk' ((cR.app K).symm.homToEquiv) (fun a b => Preadditive.add_comp _ _ _ a b (cR.app K).inv)).trans
        (adjD.homAddEquiv X ((shiftFunctor _ q).obj K)).symm).trans
      (((AddEquiv.mk' (t.homFromEquiv) (fun a b => Preadditive.comp_add _ _ _ t.inv a b)).trans
        (AddEquiv.mk' ffD.homEquiv (fun a b => DerivedCategory.Plus.ι.map_add))).trans
        (AddEquiv.mk' ((cιD.app K).homToEquiv) (fun a b => Preadditive.add_comp _ _ _ a b (cιD.app K).hom)))), ?_⟩
    intro K₁ K₂ f x
    show DerivedCategory.Plus.ι.map (t.inv ≫ (adjD.homEquiv _ _).symm
        (ffC.preimage ((x ≫ (shiftFunctor _ q).map (DerivedCategory.Plus.ι.map (R.map f))) ≫
          (cιC.app (R.obj K₂)).inv) ≫ (cR.app K₂).inv)) ≫ (cιD.app K₂).hom =
      (DerivedCategory.Plus.ι.map (t.inv ≫ (adjD.homEquiv _ _).symm
        (ffC.preimage (x ≫ (cιC.app (R.obj K₁)).inv) ≫ (cR.app K₁).inv)) ≫ (cιD.app K₁).hom) ≫
        (shiftFunctor _ q).map (DerivedCategory.Plus.ι.map f)
    have n1 : (shiftFunctor (DerivedCategory C) q).map (DerivedCategory.Plus.ι.map (R.map f)) ≫
        (cιC.app (R.obj K₂)).inv = (cιC.app (R.obj K₁)).inv ≫
          DerivedCategory.Plus.ι.map ((shiftFunctor _ q).map (R.map f)) :=
      Functor.commShiftIso_inv_naturality _ _ _
    have n2 : (shiftFunctor _ q).map (R.map f) ≫ (cR.app K₂).inv =
        (cR.app K₁).inv ≫ R.map ((shiftFunctor _ q).map f) :=
      Functor.commShiftIso_inv_naturality _ _ _
    have n3 : DerivedCategory.Plus.ι.map ((shiftFunctor _ q).map f) ≫ (cιD.app K₂).hom =
        (cιD.app K₁).hom ≫ (shiftFunctor _ q).map (DerivedCategory.Plus.ι.map f) :=
      Functor.commShiftIso_hom_naturality _ _ _
    have e1 : ffC.preimage (X := X) ((x ≫ (shiftFunctor (DerivedCategory C) q).map
        (DerivedCategory.Plus.ι.map (R.map f))) ≫ (cιC.app (R.obj K₂)).inv) =
        ffC.preimage (X := X) (x ≫ (cιC.app (R.obj K₁)).inv) ≫ (shiftFunctor _ q).map (R.map f) := by
      rw [Category.assoc, n1, ← Category.assoc, hpre]
    have e2 : (ffC.preimage (X := X) (x ≫ (cιC.app (R.obj K₁)).inv) ≫ (shiftFunctor _ q).map (R.map f)) ≫
        (cR.app K₂).inv = (ffC.preimage (X := X) (x ≫ (cιC.app (R.obj K₁)).inv) ≫ (cR.app K₁).inv) ≫
          R.map ((shiftFunctor _ q).map f) := by
      rw [Category.assoc, n2, Category.assoc]
    rw [e1, e2, adjD.homEquiv_naturality_right_symm, ← Category.assoc t.inv, Functor.map_comp,
      Category.assoc, n3]
    simp only [Category.assoc]
  haveI := Db.additive
  haveI := Db.presLim
  haveI := Db.presColim
  haveI : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange b) _ _ Db.cont Db.φ).Additive :=
    Adjunction.right_adjoint_additive Db.adj
  exact key Db.Φ _ Db.adj M q

theorem wc_srdci_charts (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    (r : ℕ) (hn : Even (r + 2)) (hn4 : 4 ≤ r + 2) (π : A)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    (c : Matrix (Fin (r + 2)) (Fin (r + 2)) A)
    (hc : c = Matrix.of fun p q : Fin (r + 2) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0)
    (X' : Scheme.{u}) (β : X' ⟶ Spec (.of (wcQuadModelRing A (r + 2) π c)))
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun i : Fin (r + 2) =>
        (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A (r + 2) π c))).inv.hom
          (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π c)
            (MvPolynomial.X (⟨2 * (i.val / 2), lt_of_le_of_lt (Nat.mul_div_le i.val 2) i.isLt⟩ :
              Fin (r + 2))))))) β) :
    ∃ e : Fin (r + 2) → (Spec (.of (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))) ⟶ X'),
      (∀ j, IsOpenImmersion (e j)) ∧
      (∀ j, e j ≫ β ≫ wcQuadModelStr A (r + 2) π c = wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) ∧
      (∀ x : X', ∃ j, ∃ y, e j y = x) ∧
      ∀ j y, (β (e j y) ∈ PrimeSpectrum.zeroLocus (Set.range fun i : Fin (r + 2) =>
          Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π c)
            (MvPolynomial.X (⟨2 * (i.val / 2), lt_of_le_of_lt (Nat.mul_div_le i.val 2) i.isLt⟩ :
              Fin (r + 2)))) ↔
        Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal y) :=
by
  subst hc
  have hπ0 : π ≠ 0 := by
    intro h0
    apply IsDiscreteValuationRing.not_a_field A
    rw [hπ, h0, Ideal.span_singleton_eq_bot]
  have Lc0 : ∀ {S : Type u} [CommRing S] (g : A →+* S) (f : Fin (r + 2) → S),
      ∑ a, ∑ b, g (wcSrmC0 A r a b) * f a * f b = f ⟨0, by omega⟩ * f ⟨1, by omega⟩ := by
    intro S _ g f
    rw [Finset.sum_eq_single (⟨0, by omega⟩ : Fin (r + 2))]
    · rw [Finset.sum_eq_single (⟨1, by omega⟩ : Fin (r + 2))]
      · simp
      · intro b _ hb
        have : b.val ≠ 1 := fun h => hb (Fin.ext h)
        simp [this]
      · simp
    · intro a _ ha
      have : a.val ≠ 0 := fun h => ha (Fin.ext h)
      simp [this]
    · simp
  have Lch : ∀ {S : Type u} [CommRing S] (g : A →+* S) (f : Fin (r + 2) → S),
      ∑ a, ∑ b, g (wcSrmCh A r a b) * f a * f b = f ⟨0, by omega⟩ * f ⟨1, by omega⟩ +
        ∑ i : Fin (r + 1), ∑ b, g (wcSrmCh A r i.succ b) * f i.succ * f b := by
    intro S _ g f
    rw [Fin.sum_univ_succ]
    congr 1
    rw [Finset.sum_eq_single (⟨1, by omega⟩ : Fin (r + 2))]
    · simp
    · intro b _ hb
      have : b.val ≠ 1 := fun h => hb (Fin.ext h)
      simp [this]
    · simp
  have s3core : ∑ a, ∑ b, MvPolynomial.C (wcSrmCh A r a b) * wcSrmFimg A r a * wcSrmFimg A r b =
      MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) * MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) := by
    rw [Lch MvPolynomial.C (wcSrmFimg A r)]
    have hQ := Lch (MvPolynomial.C)
      (MvPolynomial.X : Fin (r + 2) → MvPolynomial (Fin (r + 2)) A)
    have hT : ∑ i : Fin (r + 1), ∑ b, MvPolynomial.C (wcSrmCh A r i.succ b) *
        wcSrmFimg A r i.succ * wcSrmFimg A r b =
        MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) * ∑ i : Fin (r + 1), ∑ b,
          MvPolynomial.C (wcSrmCh A r i.succ b) * MvPolynomial.X i.succ * MvPolynomial.X b := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun b _ => ?_)
      by_cases h : (Fin.succ i).val % 2 = 0 ∧ b.val = (Fin.succ i).val + 1
      · have h1 : (Fin.succ i).val ≠ 0 := by simp
        have h2 : (Fin.succ i).val ≠ 1 := by omega
        have h3 : b.val ≠ 0 := by omega
        have h4 : b.val ≠ 1 := by omega
        have h5 : ¬ (b.val % 2 = 0) := by omega
        simp only [wcSrmFimg, wcSrmCh, Matrix.of_apply, if_pos h, if_neg h1, if_neg h2, if_pos h.1,
          if_neg h3, if_neg h4, if_neg h5]
        ring
      · simp only [wcSrmCh, Matrix.of_apply, if_neg h, map_zero, zero_mul, mul_zero]
    have h0 : wcSrmFimg A r ⟨0, by omega⟩ = MvPolynomial.X ⟨0, by omega⟩ := by
      simp [wcSrmFimg]
    have h1 : wcSrmFimg A r ⟨1, by omega⟩ = MvPolynomial.X ⟨1, by omega⟩ +
        MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) * MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) -
        ∑ a, ∑ b, MvPolynomial.C (wcSrmCh A r a b) * MvPolynomial.X a * MvPolynomial.X b := by
      simp only [wcSrmFimg]
      simp
    rw [hT, h0, h1, hQ]
    ring
  have s3 : ∃ φ : wcQuadModelRing A (r + 2) π (wcSrmCh A r) →+* wcQuadModelRing A (r + 2) π (wcSrmC0 A r),
      (∀ p : Fin (r + 2), φ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmCh A r))
          (MvPolynomial.X p)) =
        Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r)) (wcSrmFimg A r p)) ∧
      φ.comp (algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmCh A r))) =
        algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmC0 A r)) := by
    let φt : MvPolynomial (Fin (r + 2)) A →+* wcQuadModelRing A (r + 2) π (wcSrmC0 A r) :=
      (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r))).comp
        (MvPolynomial.aeval (wcSrmFimg A r)).toRingHom
    have hP0 := Lc0 (MvPolynomial.C)
      (MvPolynomial.X : Fin (r + 2) → MvPolynomial (Fin (r + 2)) A)
    have haev : MvPolynomial.aeval (wcSrmFimg A r) (∑ p, ∑ q, MvPolynomial.C (wcSrmCh A r p q) *
        MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C π) =
        MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) * MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) -
          MvPolynomial.C π := by
      rw [← s3core]
      simp only [map_sub, map_sum, map_mul, MvPolynomial.aeval_X, MvPolynomial.aeval_C,
        MvPolynomial.algebraMap_eq]
    have hkey : φt (∑ p, ∑ q, MvPolynomial.C (wcSrmCh A r p q) * MvPolynomial.X p *
        MvPolynomial.X q - MvPolynomial.C π) = 0 := by
      show Ideal.Quotient.mk _ (MvPolynomial.aeval (wcSrmFimg A r) _) = 0
      rw [haev, Ideal.Quotient.eq_zero_iff_mem, ← hP0]
      exact Ideal.subset_span rfl
    have hker : ∀ a ∈ wcQuadModelIdeal A (r + 2) π (wcSrmCh A r), φt a = 0 := by
      intro a ha
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      rw [map_mul, hkey, mul_zero]
    refine ⟨Ideal.Quotient.lift _ φt hker, ?_, ?_⟩
    · intro p
      rw [Ideal.Quotient.lift_mk]
      simp [φt]
    · ext a
      show Ideal.Quotient.lift _ φt hker (Ideal.Quotient.mk _ (MvPolynomial.C a)) =
        Ideal.Quotient.mk _ (MvPolynomial.C a)
      rw [Ideal.Quotient.lift_mk]
      simp [φt]
  have s6 : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈
      nonZeroDivisors (wcQuadModelRing A (r + 2) π (wcSrmC0 A r)) := by
    have hπ := hπ0
    have hP : ∑ a, ∑ b, MvPolynomial.C (wcSrmC0 A r a b) * MvPolynomial.X a * MvPolynomial.X b =
        MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) *
          (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) : MvPolynomial (Fin (r + 2)) A) :=
      Lc0 MvPolynomial.C MvPolynomial.X
    rw [mem_nonZeroDivisors_iff_right]
    intro y hy
    obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective y
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem, wcQuadModelIdeal, hP,
      Ideal.mem_span_singleton'] at hy
    obtain ⟨h, hh⟩ := hy
    rw [Ideal.Quotient.eq_zero_iff_mem, wcQuadModelIdeal, hP]
    let e := MvPolynomial.finSuccEquiv A (r + 1)
    have f0 : (⟨0, by omega⟩ : Fin (r + 2)) = 0 := Fin.ext (by simp)
    have f1 : (⟨1, by omega⟩ : Fin (r + 2)) = (0 : Fin (r + 1)).succ := Fin.ext (by simp)
    have e0 : e (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) = Polynomial.X := by
      rw [f0]; exact MvPolynomial.finSuccEquiv_X_zero
    have e1 : e (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) =
        Polynomial.C (MvPolynomial.X 0) := by
      rw [f1]; exact MvPolynomial.finSuccEquiv_X_succ
    have eπ : e (MvPolynomial.C π) = Polynomial.C (MvPolynomial.C π) := by
      have := e.commutes π
      simpa using this
    have he := congrArg e hh
    simp only [map_mul, map_sub, e0, e1, eπ] at he
    have hc : (e h * (Polynomial.X * Polynomial.C (MvPolynomial.X 0) -
        Polynomial.C (MvPolynomial.C π))).coeff 0 = (e g * Polynomial.X).coeff 0 := by rw [he]
    rw [Polynomial.mul_coeff_zero, Polynomial.mul_coeff_zero, Polynomial.coeff_X_zero, mul_zero,
      Polynomial.coeff_sub, Polynomial.mul_coeff_zero, Polynomial.coeff_X_zero, zero_mul,
      Polynomial.coeff_C_zero, zero_sub, mul_neg, neg_eq_zero] at hc
    have hc0 : (e h).coeff 0 = 0 := by
      have hCπ : (MvPolynomial.C π : MvPolynomial (Fin (r + 1)) A) ≠ 0 := by
        rwa [Ne, MvPolynomial.C_eq_zero]
      exact (mul_eq_zero.mp hc).resolve_right hCπ
    obtain ⟨q, hq⟩ := Polynomial.X_dvd_iff.mpr hc0
    have hh1 : h = MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) * e.symm q := by
      apply e.injective
      rw [map_mul, e0, AlgEquiv.apply_symm_apply, hq]
    have hX0 : (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) : MvPolynomial (Fin (r + 2)) A) ≠ 0 :=
      MvPolynomial.X_ne_zero _
    refine Ideal.mem_span_singleton'.mpr ⟨e.symm q, ?_⟩
    apply mul_left_cancel₀ hX0
    rw [← mul_assoc, ← hh1, hh]
    ring
  have s5 : ∀ (R C : CommRingCat.{u}) {ι : Type} (b : ι → R) (k₀ k : ι)
      (σ : R ≃+* R) (φ : R ⟶ C), σ (b k) = b k₀ →
      Ideal.map (σ : R →+* R) (Ideal.span (Set.range b)) = Ideal.span (Set.range b) →
      φ.hom (b k₀) ∈ nonZeroDivisors C →
      Ideal.map φ.hom (Ideal.span (Set.range b)) = Ideal.span {φ.hom (b k₀)} →
      (∀ (B : CommRingCat.{u}) (ρ : R ⟶ B), ρ.hom (b k₀) ∈ nonZeroDivisors B →
        Ideal.map ρ.hom (Ideal.span (Set.range b)) = Ideal.span {ρ.hom (b k₀)} →
        ∃! ψ : C ⟶ B, φ ≫ ψ = ρ) →
      (CommRingCat.ofHom (σ : R →+* R) ≫ φ).hom (b k) ∈ nonZeroDivisors C ∧
      Ideal.map (CommRingCat.ofHom (σ : R →+* R) ≫ φ).hom (Ideal.span (Set.range b)) =
        Ideal.span {(CommRingCat.ofHom (σ : R →+* R) ≫ φ).hom (b k)} ∧
      ∀ (B : CommRingCat.{u}) (ρ : R ⟶ B), ρ.hom (b k) ∈ nonZeroDivisors B →
        Ideal.map ρ.hom (Ideal.span (Set.range b)) = Ideal.span {ρ.hom (b k)} →
        ∃! ψ : C ⟶ B, (CommRingCat.ofHom (σ : R →+* R) ≫ φ) ≫ ψ = ρ := by
    intro R C ι b k₀ k σ φ hσb hσJ hnzd hgen hup
    have hφ' : (CommRingCat.ofHom (σ : R →+* R) ≫ φ).hom = φ.hom.comp (σ : R →+* R) := by
      rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom]
    have hφk : (CommRingCat.ofHom (σ : R →+* R) ≫ φ).hom (b k) = φ.hom (b k₀) := by
      rw [hφ', RingHom.comp_apply, RingHom.coe_coe, hσb]
    have hσs : (σ.symm : R →+* R).comp (σ : R →+* R) = RingHom.id R := by
      ext x; simp
    have hσJ' : Ideal.map (σ.symm : R →+* R) (Ideal.span (Set.range b)) =
        Ideal.span (Set.range b) := by
      conv_lhs => rw [← hσJ]
