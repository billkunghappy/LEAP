    hcov Ω ξ hφπ Dh' I'
  obtain ⟨ψ, hψ⟩ := wc_etqm_r1s_kummer_section A ℓ hℓ k hk n hn hn4 π hπ c hc X' β hbl hprop f'
    hf' hcov Ω ξ hφπ Dh' I'

  have isoinj : ∀ {G H : AddCommGrpCat.{u+1}} (e : G ≅ H), Function.Injective e.hom.hom := by
    intro G H e a b h
    have h2 : (e.hom ≫ e.inv).hom a = (e.hom ≫ e.inv).hom b := by
      simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply, h]
