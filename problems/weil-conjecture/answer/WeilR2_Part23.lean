    classical
    haveI : IsAddCyclic r.range := AddSubgroup.isAddCyclic _
    obtain ⟨g, hg⟩ := IsAddCyclic.exists_generator (α := r.range)
    obtain ⟨b₀, hb₀⟩ := AddMonoidHom.mem_range.mp g.2
    have hrep : ∀ b, ∃ j : ℤ, r b = j • r b₀ := by
      intro b
      obtain ⟨j, hj⟩ := AddSubgroup.mem_zmultiples_iff.mp (hg ⟨r b, b, rfl⟩)
      refine ⟨j, ?_⟩
      have := congrArg Subtype.val hj
      rw [AddSubgroup.coe_zsmul, ← hb₀] at this
      exact this.symm
    have hy : ∀ b (j : ℤ), r b = j • r b₀ → y b = j • y b₀ := by
      intro b j hj
      have h0 : r (b - j • b₀) = 0 := by rw [map_sub, map_zsmul, hj, sub_self]
      have h1 := (h _).1 h0
      rw [map_sub, map_zsmul, sub_eq_zero] at h1
      exact h1
    obtain ⟨u, hu⟩ := unitlem m (r b₀) (y b₀) (fun n => by rw [← map_nsmul, ← map_nsmul]; exact h _)
    refine ⟨u, fun b => ?_⟩
    obtain ⟨j, hj⟩ := hrep b
