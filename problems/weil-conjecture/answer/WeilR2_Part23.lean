    rw [map_zero, zero_mul] at hp
    exact hp.ne_zero (pow_ne_zero 1 hℓ0) rfl

  have hsum : (∑ i : Fin (r + 2), ∑ j : Fin (r + 2), MvPolynomial.C (wcQmtmC A r i j) *
      MvPolynomial.X i * MvPolynomial.X j : MvPolynomial (Fin (r + 2)) A) =
