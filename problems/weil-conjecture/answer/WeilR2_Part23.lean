  have hpo := wc_xnp_gamma_pushout A C L
    (ρ.comp (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))) φ Pq q1 qL hT'
  have hw : CommRingCat.ofHom (ρ.comp (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))) ≫
