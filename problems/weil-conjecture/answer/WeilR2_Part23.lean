  have extG : ∀ {R : Type u} [CommRing R]
      (α β : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) →+* R),
      (∀ (m k : ℕ) (c : L),
        α (AddMonoidAlgebra.single
          (Localization.mk (m : ℤ) ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) c) =
        β (AddMonoidAlgebra.single
          (Localization.mk (m : ℤ) ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) c)) →
