  have hθ' : (Abelian.Ext.mk₀ (wcEtSuppUnitMap D')).comp θ' (zero_add (M + 1)) = 0 := hθ
  obtain ⟨x', hx'⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS'
    (SheafOfModules.unit (wcEtZModRing W' m)) θ' hθ' (add_comm 1 M)
  obtain ⟨Dg'⟩ := wc_et_zmod_pull_data_exists gO' m
