theorem wc_etqm_sr_T_stalk_of_milnor (A : Type u) [CommRing A] (Z : Scheme.{u}) (fZ : Z ⟶ Spec (.of A))
    (m : ℕ) (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A))
    (σ : Spec (.of Ω) ⟶ Spec (.of Ω)) (hσ : σ ≫ ξ = ξ)
    (σQ : Limits.pullback fZ ξ ⟶ Limits.pullback fZ ξ)
    (hσQ1 : σQ ≫ Limits.pullback.fst fZ ξ = Limits.pullback.fst fZ ξ)
    (hσQ2 : σQ ≫ Limits.pullback.snd fZ ξ = Limits.pullback.snd fZ ξ ≫ σ)
    (Dh : wcEtPullData (Limits.pullback.fst fZ ξ) m)
    (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing (Limits.pullback fZ ξ) m)))
    (DσQ : wcEtPullData σQ m) (n : ℕ) (x : Z)
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Z x)) (Scheme.Etale.forget Z))
    (φl : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Z)
    (hsh : wcHalShData x B Λ W' φl a) :
    haveI := Dh.cont
    haveI := DσQ.cont
    haveI : (wcEtBaseChange (Limits.pullback.fst fZ ξ) ⋙ wcEtBaseChange σQ).IsContinuous (Scheme.smallEtaleTopology Z)
        (Scheme.smallEtaleTopology (Limits.pullback fZ ξ)) :=
      Functor.isContinuous_comp (wcEtBaseChange (Limits.pullback.fst fZ ξ)) (wcEtBaseChange σQ) (Scheme.smallEtaleTopology Z)
        (Scheme.smallEtaleTopology (Limits.pullback fZ ξ)) (Scheme.smallEtaleTopology (Limits.pullback fZ ξ))
    let α : wcEtBaseChange (Limits.pullback.fst fZ ξ) ⟶ wcEtBaseChange (Limits.pullback.fst fZ ξ) ⋙ wcEtBaseChange σQ :=
      letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) (Limits.pullback.fst fZ ξ) :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) (Limits.pullback.fst fZ ξ) :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong (Limits.pullback.fst fZ ξ))) (@Etale : MorphismProperty Scheme.{u})
      letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) σQ :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) σQ :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong σQ)) (@Etale : MorphismProperty Scheme.{u})
      (MorphismProperty.Over.pullbackComp (P := (@Etale : MorphismProperty Scheme.{u}))
        (Q := ⊤) σQ (Limits.pullback.fst fZ ξ) (Limits.pullback.fst fZ ξ) hσQ1.symm).hom
    haveI := Dh.additive
    haveI := DσQ.additive
    ∀ (hφ : (Dh.φ ≫ ((wcEtBaseChange (Limits.pullback.fst fZ ξ)).sheafPushforwardContinuous RingCat.{u+1}
          (Scheme.smallEtaleTopology Z) (Scheme.smallEtaleTopology (Limits.pullback fZ ξ))).map DσQ.φ) ≫
        (Functor.sheafPushforwardContinuousNatTrans α RingCat.{u+1}
          (Scheme.smallEtaleTopology Z) (Scheme.smallEtaleTopology (Limits.pullback fZ ξ))).app (wcEtZModRing (Limits.pullback fZ ξ) m) = Dh.φ)
      (t : (DσQ.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex ⟶ I.cochainComplex),
      (DσQ.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι' ≫ t =
        (HomologicalComplex.singleMapHomologicalComplex DσQ.Φ (ComplexShape.up ℤ) 0).hom.app
          (SheafOfModules.unit (wcEtZModRing (Limits.pullback fZ ξ) m)) ≫
        (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map
          ((DσQ.adj.homEquiv _ _).symm
            (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange σQ) _ _ DσQ.cont DσQ.φ)) ≫
        I.ι' →
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst fZ ξ)) _ _ Dh.cont Dh.φ
    haveI : P.Additive := Adjunction.right_adjoint_additive Dh.adj
    let K := (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex
    let Pw := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange σQ) _ _ DσQ.cont DσQ.φ
    haveI : Pw.Additive := Adjunction.right_adjoint_additive DσQ.adj
    let γ : Pw ⋙ P ⟶ P := (SheafOfModules.pushforwardComp Dh.φ DσQ.φ).hom ≫
        SheafOfModules.pushforwardNatTrans _ α ≫ (SheafOfModules.pushforwardCongr hφ).hom
    let Tflat := (Functor.mapHomologicalComplexIdIso _ (ComplexShape.up ℤ)).inv.app I.cochainComplex ≫
        (NatTrans.mapHomologicalComplex (show 𝟭 _ ⟶ DσQ.Φ ⋙ Pw from DσQ.adj.unit)
          (ComplexShape.up ℤ)).app I.cochainComplex ≫
        (Functor.mapHomologicalComplexCompIso (Iso.refl (DσQ.Φ ⋙ Pw))
          (ComplexShape.up ℤ)).inv.app I.cochainComplex ≫
        (Pw.mapHomologicalComplex (ComplexShape.up ℤ)).map t
    let T : K ⟶ K := (P.mapHomologicalComplex (ComplexShape.up ℤ)).map Tflat ≫
        (Functor.mapHomologicalComplexCompIso (Iso.refl (Pw ⋙ P))
          (ComplexShape.up ℤ)).hom.app I.cochainComplex ≫
        (NatTrans.mapHomologicalComplex γ (ComplexShape.up ℤ)).app I.cochainComplex
    (∀ (E : wcEtPullData (Limits.pullback.lift (Limits.pullback.fst (a ≫ fZ) ξ)
          (Limits.pullback.snd (a ≫ fZ) ξ ≫ σ)
          (by rw [Category.assoc, hσ]; exact Limits.pullback.condition)) m)
        (y : wcEtZModExt (Limits.pullback (a ≫ fZ) ξ) m n), wcEtPull E n y = y) →
    (wcEtStalk Z x).map ((SheafOfModules.toSheaf (wcEtZModRing Z m)).map
      (HomologicalComplex.homologyMap T (n : ℤ) - 𝟙 (K.homology (n : ℤ)))) = 0 :=
by
  intro α hφ t ht P K Pw γ Tflat T hfix
  haveI := Dh.additive
  haveI := DσQ.additive
  haveI := DσQ.presLim
  haveI := DσQ.presColim
  haveI : P.Additive := Adjunction.right_adjoint_additive Dh.adj
  letI hE : HasExt (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback fZ ξ) m)) :=
    HasExt.standard _

  have hk : ∀ V : Z.Etale, (α.app V).left ≫
      Limits.pullback.fst ((wcEtBaseChange (Limits.pullback.fst fZ ξ)).obj V).hom σQ =
      Limits.pullback.lift (Limits.pullback.fst V.hom (Limits.pullback.fst fZ ξ))
        (Limits.pullback.snd V.hom (Limits.pullback.fst fZ ξ) ≫ σQ)
        (by rw [Category.assoc, hσQ1]; exact Limits.pullback.condition) := by
    intro V
    letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u})
        (Limits.pullback.fst fZ ξ) := ⟨fun _ _ => inferInstance⟩
    letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u})
        (Limits.pullback.fst fZ ξ) :=
      (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
        (inferInstance : Pr.IsStableUnderBaseChangeAlong (Limits.pullback.fst fZ ξ)))
        (@Etale : MorphismProperty Scheme.{u})
    letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) σQ :=
      ⟨fun _ _ => inferInstance⟩
    letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) σQ :=
      (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
        (inferInstance : Pr.IsStableUnderBaseChangeAlong σQ)) (@Etale : MorphismProperty Scheme.{u})
    have hα := MorphismProperty.Over.pullbackComp_hom_app_left
      (P := (@Etale : MorphismProperty Scheme.{u})) (Q := ⊤) σQ (Limits.pullback.fst fZ ξ)
      (Limits.pullback.fst fZ ξ) hσQ1.symm V
    have hαW : (α.app V).left = Limits.pullback.map V.hom (Limits.pullback.fst fZ ξ) V.hom
        (σQ ≫ Limits.pullback.fst fZ ξ) (𝟙 V.left) (𝟙 _) (𝟙 Z) (by simp) (by simp [hσQ1]) ≫
        (Limits.pullbackLeftPullbackSndIso V.hom (Limits.pullback.fst fZ ξ) σQ).inv := by
      first
        | exact hα
        | (dsimp only [α]; exact hα)
    apply Limits.pullback.hom_ext
    · refine Eq.trans ?_ (Limits.pullback.lift_fst _ _ _).symm
      refine (Category.assoc _ _ _).trans ?_
      change (α.app V).left ≫ Limits.pullback.fst (Limits.pullback.snd V.hom (Limits.pullback.fst fZ ξ)) σQ ≫
        Limits.pullback.fst V.hom (Limits.pullback.fst fZ ξ) =
          Limits.pullback.fst V.hom (Limits.pullback.fst fZ ξ)
      rw [hαW]
      refine (Category.assoc _ _ _).trans ?_
      refine (whisker_eq _ (Limits.pullbackLeftPullbackSndIso_inv_fst V.hom
        (Limits.pullback.fst fZ ξ) σQ)).trans ?_
      exact (Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _)
    · refine Eq.trans ?_ (Limits.pullback.lift_snd _ _ _).symm
      refine (Category.assoc _ _ _).trans ?_
      change (α.app V).left ≫ Limits.pullback.fst (Limits.pullback.snd V.hom (Limits.pullback.fst fZ ξ)) σQ ≫
        Limits.pullback.snd V.hom (Limits.pullback.fst fZ ξ) =
