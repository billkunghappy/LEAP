      (IsLocalRing.residue_ne_zero_iff_isUnit c).mpr hc
    have hNres : ((ℓ : ℕ) : IsLocalRing.ResidueField Bh) ≠ 0 := by
      have h := (IsLocalRing.residue_ne_zero_iff_isUnit ((ℓ : ℕ) : Bh)).mpr hℓB
      rwa [map_natCast] at h
    haveI : NeZero ((ℓ : ℕ) : IsLocalRing.ResidueField Bh) := ⟨hNres⟩
    obtain ⟨zr, hzr⟩ := IsSepClosed.exists_pow_nat_eq (IsLocalRing.residue Bh c) ℓ
    have hzr0 : zr ≠ 0 := by
      rintro rfl
      rw [zero_pow hℓ0] at hzr
      exact hcres hzr.symm
    obtain ⟨a₀, ha₀⟩ := IsLocalRing.residue_surjective zr
    have ha₀u : IsUnit a₀ :=
      (IsLocalRing.residue_ne_zero_iff_isUnit a₀).mp (by rw [ha₀]; exact hzr0)
    have hmon : (Polynomial.X ^ ℓ - Polynomial.C c : Polynomial Bh).Monic :=
      Polynomial.monic_X_pow_sub_C c hℓ0
    have hev : Polynomial.eval a₀ (Polynomial.X ^ ℓ - Polynomial.C c : Polynomial Bh) =
        a₀ ^ ℓ - c := by
      simp
    have hmem : Polynomial.eval a₀ (Polynomial.X ^ ℓ - Polynomial.C c : Polynomial Bh) ∈
        IsLocalRing.maximalIdeal Bh := by
      rw [hev, ← IsLocalRing.residue_eq_zero_iff, map_sub, map_pow, ha₀, hzr, sub_self]
    have hder : Polynomial.eval a₀
        (Polynomial.derivative (Polynomial.X ^ ℓ - Polynomial.C c : Polynomial Bh)) =
        ((ℓ : ℕ) : Bh) * a₀ ^ (ℓ - 1) := by
      simp [Polynomial.derivative_X_pow]
    have hderu : IsUnit (Polynomial.eval a₀
        (Polynomial.derivative (Polynomial.X ^ ℓ - Polynomial.C c : Polynomial Bh))) := by
      rw [hder]
      exact hℓB.mul (ha₀u.pow _)
    obtain ⟨a₁, ha₁, -⟩ := HenselianLocalRing.is_henselian _ hmon a₀ hmem hderu
    have h := ha₁.eq_zero
    simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
      Polynomial.eval_C] at h
    have hpow : a₁ ^ ℓ = c := sub_eq_zero.mp h
    refine ⟨a₁, hpow, ?_⟩
    rw [← isUnit_pow_iff hℓ0, hpow]
    exact hc

  obtain ⟨x1b, hx1b, hx1beq⟩ : ∃ b : Bh, IsUnit b ∧
      a.appTop.hom (wcEtqmtX g ⟨1, by omega⟩) = (Scheme.ΓSpecIso (.of Bh)).inv.hom b := by
    refine ⟨(Scheme.ΓSpecIso (.of Bh)).hom.hom (a.appTop.hom (wcEtqmtX g ⟨1, by omega⟩)), ?_,
      (Iso.hom_inv_id_apply _ _).symm⟩
    have h1 : IsLocalRing.closedPoint Bh ∈ a ⁻¹ᵁ U.basicOpen (wcEtqmtX g ⟨1, by omega⟩) := ha
    rw [Scheme.Hom.preimage_basicOpen_top] at h1
    have e : a.appTop.hom (wcEtqmtX g ⟨1, by omega⟩) = (Scheme.ΓSpecIso (.of Bh)).inv.hom
        ((Scheme.ΓSpecIso (.of Bh)).hom.hom (a.appTop.hom (wcEtqmtX g ⟨1, by omega⟩))) :=
      (Iso.hom_inv_id_apply _ _).symm
    rw [e, basicOpen_eq_of_affine] at h1
