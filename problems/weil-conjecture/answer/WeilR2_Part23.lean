theorem wc_etqmtx1_shens_root_system (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) (π : A)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (r : ℕ)
    (U : Scheme.{u}) (g : U ⟶ Spec (.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r))))
    (fX : U ⟶ Spec (.of A)) (hfX : fX = g ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r))
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A))
    (σ : Spec (.of Ω) ⟶ Spec (.of Ω)) (hσ : σ ≫ ξ = ξ)
    (htame : wcMntTame ℓ (Spec.preimage ξ).hom (Spec.preimage σ).hom π)
    (σQ : Limits.pullback fX ξ ⟶ Limits.pullback fX ξ)
    (hσQ1 : σQ ≫ Limits.pullback.fst fX ξ = Limits.pullback.fst fX ξ)
    (hσQ2 : σQ ≫ Limits.pullback.snd fX ξ = Limits.pullback.snd fX ξ ≫ σ)
    (T : wcEtqmtTower ℓ g fX ξ σ σQ ⟨0, by omega⟩)
    (t : ℤ_[ℓ]) (z : ℕ → Ω) (hz1 : ∀ j : ℕ, z j ^ (ℓ ^ j) = (Spec.preimage ξ).hom π)
    (hz2 : ∀ j : ℕ, z (j + 1) ^ ℓ = z j)
    (hz3 : ∀ j : ℕ, (Spec.preimage σ).hom (z j) = T.ζ j ^ (PadicInt.toZModPow j t).val * z j)
    (Bh : Type u) [CommRing Bh] [HenselianLocalRing Bh] [IsSepClosed (IsLocalRing.ResidueField Bh)]
    (a : Spec (.of Bh) ⟶ U)
    (ha : a (IsLocalRing.closedPoint Bh) ∈ U.basicOpen (wcEtqmtX g ⟨1, by omega⟩)) :
    ∃ v : ℕ → Γ(Limits.pullback a (Limits.pullback.fst fX ξ), ⊤),
      (∀ k, v (k + 1) ^ ℓ = v k) ∧ IsUnit (v 0) ∧
      v 0 = (Limits.pullback.snd a (Limits.pullback.fst fX ξ)).appTop.hom
        ((Limits.pullback.fst fX ξ ≫ U.toSpecΓ).appTop.hom
          ((Scheme.ΓSpecIso (.of Γ(U, ⊤))).inv.hom (wcEtqmtX g ⟨0, by omega⟩))) ∧
      ∀ k, (Limits.pullback.lift (Limits.pullback.fst a (Limits.pullback.fst fX ξ))
          (Limits.pullback.snd a (Limits.pullback.fst fX ξ) ≫ σQ)
          (by rw [Category.assoc, hσQ1]; exact Limits.pullback.condition)).appTop.hom (v k) =
        (Limits.pullback.snd a (Limits.pullback.fst fX ξ) ≫ Limits.pullback.snd fX ξ).appTop.hom
            ((Scheme.ΓSpecIso (.of Ω)).inv.hom (T.ζ k)) ^ (PadicInt.toZModPow k t).val * v k :=
by
  classical
  have hnat : ∀ {R S : CommRingCat.{u}} (f : R ⟶ S) (y : R),
      (Spec.map f).appTop.hom ((Scheme.ΓSpecIso R).inv.hom y) =
        (Scheme.ΓSpecIso S).inv.hom (f.hom y) := by
    intro R S f y
    have h2 := congrArg (fun k => k.hom y) (Scheme.ΓSpecIso_inv_naturality f)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h2
    exact h2.symm
  have hcomp : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (x : Γ(Z, ⊤)),
      (f ≫ g).appTop.hom x = f.appTop.hom (g.appTop.hom x) := by
    intro X Y Z f g x
    rw [Scheme.Hom.comp_appTop]
