        (f := Limits.pullback.snd V.hom (Limits.pullback.fst fZ ξ)) (g := σQ))).trans ?_
      refine (Category.assoc _ _ _).symm.trans ?_
      refine eq_whisker ?_ σQ
      rw [hαW]
      refine (Category.assoc _ _ _).trans ?_
      refine (whisker_eq _ (Limits.pullbackLeftPullbackSndIso_inv_snd_snd V.hom
        (Limits.pullback.fst fZ ξ) σQ)).trans ?_
      exact (Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _)

  choose Pf ev hnat hadd using fun V : (Limits.pullback fZ ξ).Etale =>
    sheafOfModules_free_yoneda (Scheme.smallEtaleTopology (Limits.pullback fZ ξ))
      (wcEtZModRing (Limits.pullback fZ ξ) m) V
  let Pm : ∀ (V V' : (Limits.pullback fZ ξ).Etale), (V' ⟶ V) → (Pf V' ⟶ Pf V) := fun V V' b =>
    (ev V' (Pf V)).symm (((Pf V).val.map b.op).hom (ev V (Pf V) (𝟙 _)))
  have hpre : ∀ (V V' : (Limits.pullback fZ ξ).Etale) (b : V' ⟶ V)
      (M : SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback fZ ξ) m))
      (g : Pf V ⟶ M), ev V' M (Pm V V' b ≫ g) = (M.val.map b.op).hom (ev V M g) := by
