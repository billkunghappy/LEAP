  have hA : ∀ {C D : Type (u+2)} [Category.{u+1} C] [Abelian C] [Category.{u+1} D] [Abelian D]
      (R : C ⥤ D) [R.PreservesZeroMorphisms] [Limits.PreservesFiniteLimits R] (N : C)
      (I : InjectiveResolution N) (M : D) (w : M ⟶ R.obj N)
      (a : (HomologicalComplex.single D (ComplexShape.up ℤ) 0).obj M ⟶
        (R.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex),
      a.f 0 = (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 M).hom ≫ w ≫
        R.map ((HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 N).inv ≫ I.ι'.f 0) →
      ∃ (α : ((HomologicalComplex.single D (ComplexShape.up ℤ) 0).obj M).homology 0 ≅ M)
        (β : ((R.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex).homology 0 ≅
          R.obj N),
