    obtain ⟨hfin, hcard⟩ := hc1
    obtain ⟨a₁, hord⟩ := hc2
    have hφ : ∀ (j : ℕ) (a : X ⟶ T), g ≫ (j • a) = j • (g ≫ a) := by
      intro j a
      rw [Preadditive.comp_nsmul]
    let f : Fin m → (X ⟶ T) := fun i => i.val • a₁
    have hle : ∀ i i' : Fin m, i.val ≤ i'.val → f i = f i' → i = i' := by
      intro i i' hii heq
      have h0' : (i'.val - i.val) • a₁ = 0 := by
        rw [sub_nsmul a₁ hii]
        change i.val • a₁ = i'.val • a₁ at heq
        rw [← heq, add_neg_cancel]
      have h1 : (i'.val - i.val) • (g ≫ a₁) = 0 := by
        rw [← hφ, h0', Limits.comp_zero]
      have h3 : i'.val - i.val = 0 := Nat.eq_zero_of_dvd_of_lt (hord _ h1) (by omega)
      exact Fin.ext (by omega)
    have hinj : Function.Injective f := by
      intro i i' heq
      rcases le_total i.val i'.val with h | h
      · exact hle i i' h heq
      · exact (hle i' i h heq.symm).symm
    have hbij : Function.Bijective f :=
      hinj.bijective_of_nat_card_le (by rw [Nat.card_fin]; exact hcard)
    obtain ⟨i, hi⟩ := hbij.2 h0
    change i.val • a₁ = h0 at hi
    have h1 : i.val • (g ≫ a₁) = 0 := by rw [← hφ, hi]; exact hh0
    have h3 : i.val = 0 := Nat.eq_zero_of_dvd_of_lt (hord _ h1) i.isLt
    rw [← hi, h3, zero_nsmul]
  intro P K Ψ R Lb Sb ub Kp ι δ hT b' hb'
  haveI := Dh.additive
  haveI := Dg.additive
  haveI := Dw.additive
  haveI := Dw.presLim
  haveI := Dw.presColim
  haveI : P.Additive := Adjunction.right_adjoint_additive Dh.adj
  have hcard := wc_et_dnb_psi_top_card F' F'' Y n hn hn2 D ℓ hℓ k i A Λ W' φ a hA η hηb hηne ξ hξ
    x hx B Λ' W'' φ' a' hsh Dh Dg I xs hxs Dx Dw
  have hM : ((n - 2 : ℕ) : ℤ) = 0 := by subst h2; rfl
  refine wc_et_dnb_node_coords F' F'' Y n hn hn2 D ℓ hℓ i A Λ W' φ a hA x hx B Λ' W'' φ' a' hsh
