          (HomologicalComplex.single (SheafOfModules.{u+1} (wcEtZModRing Xs (ℓ ^ k))) (ComplexShape.up ℤ) 0).map uM := by
    rw [hw'']
    simp only [CategoryTheory.Functor.map_add, CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_sub, CategoryTheory.Functor.map_id,
      Preadditive.comp_add, Preadditive.add_comp, Preadditive.comp_nsmul, Preadditive.nsmul_comp,
      Preadditive.comp_sub, Preadditive.sub_comp, Category.comp_id, Category.id_comp, hc]

  have haff : CochainComplex.mappingCone.map _ _ _ _ hc'' =
      𝟙 _ + ℓ ^ (k - 1) • (CochainComplex.mappingCone.map _ _ _ _ hc - 𝟙 _) := by
    refine HomologicalComplex.hom_ext _ _ (fun j => ?_)
    apply CochainComplex.mappingCone.ext_from _ (j + 1) j rfl
    · rw [hinl w'' hc'']
      simp only [hw'', CategoryTheory.Functor.map_add, CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_sub, CategoryTheory.Functor.map_id,
        HomologicalComplex.add_f_apply, HomologicalComplex.sub_f_apply,
        HomologicalComplex.nsmul_f_apply, HomologicalComplex.id_f,
        Preadditive.comp_add, Preadditive.add_comp, Preadditive.comp_nsmul, Preadditive.nsmul_comp,
        Preadditive.comp_sub, Preadditive.sub_comp, Category.comp_id, Category.id_comp, hinl wM hc]
    · rw [hinr w'' hc'']
      simp only [hw'', CategoryTheory.Functor.map_add, CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_sub, CategoryTheory.Functor.map_id,
        HomologicalComplex.add_f_apply, HomologicalComplex.sub_f_apply,
        HomologicalComplex.nsmul_f_apply, HomologicalComplex.id_f,
        Preadditive.comp_add, Preadditive.add_comp, Preadditive.comp_nsmul, Preadditive.nsmul_comp,
        Preadditive.comp_sub, Preadditive.sub_comp, Category.comp_id, Category.id_comp, hinr wM hc]

  have hQ : DerivedCategory.Q.map (CochainComplex.mappingCone.map _ _ _ _ hc'') =
      DerivedCategory.Q.map (𝟙 _) := by
    rw [haff, CategoryTheory.Functor.map_add, CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_sub, CategoryTheory.Functor.map_id, hzero, add_zero]

  obtain ⟨Z, s, hs, hZ, ⟨hm₀⟩⟩ := wc_qmmv_derived_eq_homotopy
    (CochainComplex.mappingCone.map _ _ _ _ hc'') (𝟙 _) (-1) hcone0 hQ
  have hm : Homotopy (CochainComplex.mappingCone.map _ _ _ _ hc'' ≫ s) s :=
    hm₀.trans (Homotopy.ofEq (Category.id_comp s))
  have hZ2 : Limits.IsZero (Z.X (-2)) := hZ (-2) (by norm_num)

  obtain ⟨H, hE1, hE2⟩ := wc_qmmv_cone_homotopy_components uM w'' hc'' Z s hZ2 hm

  obtain ⟨hmonoσ, hker⟩ := wc_qmmv_cone_kernel uM ιM hι hmono hex Z s hs hZ2
  obtain ⟨σ, hσ⟩ : ∃ σ : M ⟶ Z.X (-1), σ =
      (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 M).inv ≫
        (CochainComplex.mappingCone.inl ((HomologicalComplex.single
          (SheafOfModules.{u+1} (wcEtZModRing Xs (ℓ ^ k))) (ComplexShape.up ℤ) 0).map uM)).v
          0 (-1) (by omega) ≫ s.f (-1) := ⟨_, rfl⟩
  rw [← hσ] at hE1 hmonoσ hker
  have hE1' : (ℓ ^ (k - 1) • (wM - 𝟙 M)) ≫ σ = uM ≫ H := by
    rw [hw'', add_sub_cancel_left] at hE1
    exact hE1
  have hg : (ιM ≫ H) ≫ Z.d (-1) 0 = 0 := by
    rw [Category.assoc, hE2, hw'', add_sub_cancel_left, ← Category.assoc ιM,
      Preadditive.comp_nsmul, Preadditive.comp_sub, hιw, Category.comp_id, sub_self, smul_zero,
      Limits.zero_comp]
  obtain ⟨e, he⟩ := hker (ιM ≫ H) hg

  have htube : ∀ (O : Xs.Opens) (D : wcEtPullData O.ι (ℓ ^ k)) (t : ℕ), Epi (D.Φ.map uM) →
      (∃ hh : D.Φ.obj M ⟶ D.Φ.obj M, D.Φ.map (wM - 𝟙 M) = D.Φ.map uM ≫ hh ∧
        D.Φ.map ιM ≫ hh = D.Φ.map (t • ιM)) →
      D.Φ.map e = D.Φ.map ((ℓ ^ (k - 1) * t) • 𝟙 (SheafOfModules.unit (wcEtZModRing Xs (ℓ ^ k)))) := by
    intro O D t hepi hhh
    obtain ⟨hh, h1, h2⟩ := hhh
    haveI := D.additive
    haveI := D.presLim
    have hH : D.Φ.map H = ℓ ^ (k - 1) • (hh ≫ D.Φ.map σ) := by
      rw [← cancel_epi (D.Φ.map uM), ← D.Φ.map_comp, ← hE1', D.Φ.map_comp, CategoryTheory.Functor.map_nsmul,
        Preadditive.nsmul_comp, h1, Preadditive.comp_nsmul, Category.assoc]
    haveI : Mono (D.Φ.map (ιM ≫ σ)) := Functor.map_mono _ _
    rw [← cancel_mono (D.Φ.map (ιM ≫ σ)), ← D.Φ.map_comp, ← he, D.Φ.map_comp, hH,
      Preadditive.comp_nsmul, ← Category.assoc, h2]
    simp only [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id,
      Preadditive.nsmul_comp, Category.id_comp, CategoryTheory.Functor.map_comp, smul_smul]
  obtain ⟨D₁⟩ := wc_et_zmod_pull_data_exists O₁.ι (ℓ ^ k)
  obtain ⟨D₂⟩ := wc_et_zmod_pull_data_exists O₂.ι (ℓ ^ k)
  obtain ⟨hepi1, hh1⟩ := htb1 D₁
  obtain ⟨hepi2, hh2⟩ := htb2 D₂
  have he1 := htube O₁ D₁ t₁ hepi1 hh1
  have he2 := htube O₂ D₂ t₂ hepi2 hh2

  have hz := wc_et_unit_end_specialize Xs (ℓ ^ k) e O₁ O₂ D₁ D₂ _ _ he1 he2 v₁ v₂ z hv₁ hv₂
    hv₁z hv₂z

  apply hℓt
  rw [ZMod.natCast_eq_natCast_iff, Nat.modEq_iff_dvd] at hz
  push_cast at hz
  have hpos : (ℓ : ℤ) ^ (k - 1) ≠ 0 :=
    pow_ne_zero _ (by exact_mod_cast (Fact.out : ℓ.Prime).ne_zero)
  have h2 : (ℓ : ℤ) ^ (k - 1) * ℓ ∣ (ℓ : ℤ) ^ (k - 1) * ((t₂ : ℤ) - t₁) := by
    have e1 : (ℓ : ℤ) ^ (k - 1) * ℓ = (ℓ : ℤ) ^ k := by
      rw [← pow_succ, Nat.sub_add_cancel hk]
    rw [e1, mul_sub]
    exact hz
  have h3 := (mul_dvd_mul_iff_left hpos).mp h2
  rw [← dvd_neg, neg_sub]
  exact h3

theorem wc_etqm_tubes_specialize : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (π : A),
    IsLocalRing.maximalIdeal A = Ideal.span {π} →
    ∀ (r : ℕ) (U : Scheme.{u}) (g : U ⟶ Spec (.of (wcQuadModelRing A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))),
    Etale g → ∀ (fX : U ⟶ Spec (.of A)),
    fX = g ≫ wcQuadModelStr A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) →
    ∀ (u : U),
    Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (g u) →
    Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (g u) →
    ∃ v₁ v₂ z : ↥(Limits.pullback fX (wcQmSp A)),
      v₁ ∈ wcEtqmTube g fX ⟨1, by omega⟩ ∧ v₂ ∈ wcEtqmTube g fX ⟨0, by omega⟩ ∧ v₁ ⤳ z ∧ v₂ ⤳ z :=
by
  intro A _ _ _ _ _ π hπ r U g hg fX hfX u h0 h1
  classical

  have quad : ∀ (c₀ : Matrix (Fin (r + 2)) (Fin (r + 2)) A),
      c₀ = (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) →
      wcQuadModelIdeal A (r + 2) π c₀ = Ideal.span {MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) *
        MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) - MvPolynomial.C π} := by
    intro c₀ hc₀
    have hsum : (∑ p, ∑ q, MvPolynomial.C (c₀ p q) * MvPolynomial.X p * MvPolynomial.X q :
        MvPolynomial (Fin (r + 2)) A) =
        MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) *
          MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) := by
      rw [Fintype.sum_eq_single (⟨0, by omega⟩ : Fin (r + 2))]
      · rw [Fintype.sum_eq_single (⟨1, by omega⟩ : Fin (r + 2))]
        · rw [hc₀, Matrix.of_apply, if_pos ⟨rfl, rfl⟩, map_one, one_mul]
        · intro q hq
          have : ¬ (q.val = 1) := fun h => hq (Fin.ext h)
          rw [hc₀, Matrix.of_apply, if_neg (fun h => this h.2), map_zero, zero_mul, zero_mul]
      · intro p hp
        apply Finset.sum_eq_zero
        intro q _
        have : ¬ (p.val = 0) := fun h => hp (Fin.ext h)
        rw [hc₀, Matrix.of_apply, if_neg (fun h => this h.1), map_zero, zero_mul, zero_mul]
    show Ideal.span {_ - _} = _
    rw [hsum]
  have hIeq := quad _ rfl
  have hrel : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) *
      Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
        (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) =
      algebraMap A (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) π := by
    have hmem : (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) *
        MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) - MvPolynomial.C π :
          MvPolynomial (Fin (r + 2)) A) ∈ wcQuadModelIdeal A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) := by
      rw [hIeq]; exact Ideal.mem_span_singleton_self _
    have hal : algebraMap A (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) π =
        Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
          (MvPolynomial.C π) := by
      rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
    rw [hal, ← map_mul, ← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
    exact hmem

  have branch : ∀ {σ' : Type} (I : Ideal (MvPolynomial σ' A)) (a b : σ'), a ≠ b →
      (MvPolynomial.X a * MvPolynomial.X b - MvPolynomial.C π) ∈ I →
      I ≤ Ideal.span {MvPolynomial.X a * MvPolynomial.X b - MvPolynomial.C π} →
      ∀ (𝔮 : Ideal (MvPolynomial σ' A ⧸ I)) [𝔮.IsPrime],
      Ideal.Quotient.mk I (MvPolynomial.X a) ∈ 𝔮 → Ideal.Quotient.mk I (MvPolynomial.X b) ∈ 𝔮 →
      ∃ 𝔭 : Ideal (MvPolynomial σ' A ⧸ I), 𝔭.IsPrime ∧ 𝔭 ≤ 𝔮 ∧
        Ideal.Quotient.mk I (MvPolynomial.X a) ∉ 𝔭 ∧ Ideal.Quotient.mk I (MvPolynomial.X b) ∈ 𝔭 := by
    intro σ' I a b hab hmem hle 𝔮 _ ha hb
    letI : CommRing ((MvPolynomial σ' A ⧸ I) ⧸ 𝔮) := Ideal.Quotient.commRing 𝔮
    haveI : IsDomain ((MvPolynomial σ' A ⧸ I) ⧸ 𝔮) := Ideal.Quotient.isDomain 𝔮
    letI : CommRing (Polynomial ((MvPolynomial σ' A ⧸ I) ⧸ 𝔮)) := Polynomial.commRing
    let q : MvPolynomial σ' A →+* ((MvPolynomial σ' A ⧸ I) ⧸ 𝔮) := (Ideal.Quotient.mk 𝔮).comp (Ideal.Quotient.mk I)
    let v : σ' → Polynomial ((MvPolynomial σ' A ⧸ I) ⧸ 𝔮) := fun i => if i = a then Polynomial.X else if i = b then 0
      else Polynomial.C (q (MvPolynomial.X i))
    let Ψt : MvPolynomial σ' A →+* Polynomial ((MvPolynomial σ' A ⧸ I) ⧸ 𝔮) :=
      MvPolynomial.eval₂Hom (Polynomial.C.comp (q.comp MvPolynomial.C)) v
    have hqa : q (MvPolynomial.X a) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr ha
    have hqb : q (MvPolynomial.X b) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hb
    have hπq : q (MvPolynomial.C π) = 0 := by
      have h1 : q (MvPolynomial.X a * MvPolynomial.X b - MvPolynomial.C π) = 0 := by
        show Ideal.Quotient.mk 𝔮 (Ideal.Quotient.mk I _) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr hmem, map_zero]
      rw [map_sub, map_mul, hqa, zero_mul, zero_sub, neg_eq_zero] at h1
      exact h1
    have hva : v a = Polynomial.X := if_pos rfl
    have hvb : v b = 0 := by
      show (if b = a then Polynomial.X else if b = b then 0 else _) = 0
      rw [if_neg hab.symm, if_pos rfl]
    have hG : Ψt (MvPolynomial.X a * MvPolynomial.X b - MvPolynomial.C π) = 0 := by
      rw [map_sub, map_mul]
      simp only [Ψt, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
      rw [hva, hvb, hπq, mul_zero, map_zero, sub_zero]
    let Ψ : (MvPolynomial σ' A ⧸ I) →+* Polynomial ((MvPolynomial σ' A ⧸ I) ⧸ 𝔮) := Ideal.Quotient.lift I Ψt (fun z hz => by
      obtain ⟨t, rfl⟩ := Ideal.mem_span_singleton'.mp (hle hz)
      rw [map_mul, hG, mul_zero])
    have hΨX : ∀ i, Ψ (Ideal.Quotient.mk I (MvPolynomial.X i)) = v i := fun i => by
      simp only [Ψ, Ideal.Quotient.lift_mk, Ψt, MvPolynomial.eval₂Hom_X']
    have hev : (Polynomial.evalRingHom (0 : ((MvPolynomial σ' A ⧸ I) ⧸ 𝔮))).comp Ψ = Ideal.Quotient.mk 𝔮 := by
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro c
        simp only [RingHom.comp_apply, Ψ, Ideal.Quotient.lift_mk, Ψt, MvPolynomial.eval₂Hom_C,
          Polynomial.coe_evalRingHom, Polynomial.eval_C]
        rfl
      · intro i
        simp only [RingHom.comp_apply]
        rw [hΨX, Polynomial.coe_evalRingHom]
        by_cases hia : i = a
        · rw [hia, hva, Polynomial.eval_X]
          exact hqa.symm
        · by_cases hib : i = b
          · rw [hib, hvb, Polynomial.eval_zero]
            exact hqb.symm
          · have : v i = Polynomial.C (q (MvPolynomial.X i)) := by
              show (if i = a then _ else if i = b then _ else _) = _
              rw [if_neg hia, if_neg hib]
            rw [this, Polynomial.eval_C]
            rfl
    refine ⟨RingHom.ker Ψ, RingHom.ker_isPrime Ψ, ?_, ?_, ?_⟩
    · intro z hz
      have h1 : Ψ z = 0 := RingHom.mem_ker.mp hz
      have h2 := congrArg (fun f : (MvPolynomial σ' A ⧸ I) →+* ((MvPolynomial σ' A ⧸ I) ⧸ 𝔮) => f z) hev
      simp only [RingHom.comp_apply, h1, map_zero] at h2
      exact Ideal.Quotient.eq_zero_iff_mem.mp h2.symm
    · intro h
      have h1 := RingHom.mem_ker.mp h
      rw [hΨX, hva] at h1
      exact Polynomial.X_ne_zero h1
    · exact RingHom.mem_ker.mpr ((hΨX b).trans hvb)
  have h01 : (⟨0, by omega⟩ : Fin (r + 2)) ≠ ⟨1, by omega⟩ := by
    intro h; have := congrArg Fin.val h; simp at this
  have hcomm : (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) *
      MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) - MvPolynomial.C π :
        MvPolynomial (Fin (r + 2)) A) =
      MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) *
      MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) - MvPolynomial.C π := by ring
  have hmemI : (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) *
      MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) - MvPolynomial.C π :
        MvPolynomial (Fin (r + 2)) A) ∈ wcQuadModelIdeal A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) := by
    rw [hIeq]; exact Ideal.mem_span_singleton_self _
  have hmemI' : (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) *
      MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) - MvPolynomial.C π :
        MvPolynomial (Fin (r + 2)) A) ∈ wcQuadModelIdeal A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) := by
    rw [hcomm]; exact hmemI

  haveI h𝔮 : (g u).asIdeal.IsPrime := (g u).isPrime
  obtain ⟨𝔭₁, h𝔭₁, hle₁, hn₁, hy₁⟩ := @branch (Fin (r + 2))
    (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
    ⟨1, by omega⟩ ⟨0, by omega⟩ (Ne.symm h01) hmemI' (by rw [hcomm]; exact hIeq.le)
    (g u).asIdeal h𝔮 h1 h0
  obtain ⟨𝔭₀, h𝔭₀, hle₀, hn₀, hy₀⟩ := @branch (Fin (r + 2))
    (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
    ⟨0, by omega⟩ ⟨1, by omega⟩ h01 hmemI hIeq.le
    (g u).asIdeal h𝔮 h0 h1

  have hgen := Flat.generalizingMap g
  have hsp₁ := (PrimeSpectrum.le_iff_specializes ⟨𝔭₁, h𝔭₁⟩ (g u)).mp hle₁
  have hsp₀ := (PrimeSpectrum.le_iff_specializes ⟨𝔭₀, h𝔭₀⟩ (g u)).mp hle₀
  obtain ⟨w₁, hw₁, hgw₁⟩ := hgen hsp₁
  obtain ⟨w₀, hw₀, hgw₀⟩ := hgen hsp₀
  have hgw₁' : (g w₁).asIdeal = 𝔭₁ := by rw [hgw₁]
  have hgw₀' : (g w₀).asIdeal = 𝔭₀ := by rw [hgw₀]

  have hfXy : ∀ y : U, (fX y).asIdeal = Ideal.comap (algebraMap A (wcQuadModelRing A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))) (g y).asIdeal := by
    intro y
    rw [hfX]
    rfl
  have hlift : ∀ y : U, algebraMap A (wcQuadModelRing A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) π ∈ (g y).asIdeal →
      ∃ v : ↥(Limits.pullback fX (wcQmSp A)), Limits.pullback.fst fX (wcQmSp A) v = y := by
    intro y hy
    let z : Spec (.of (IsLocalRing.ResidueField A)) := IsLocalRing.closedPoint _
    have heq : fX y = wcQmSp A z := by
      apply PrimeSpectrum.ext
      rw [hfXy y]
      show _ = Ideal.comap (IsLocalRing.residue A) z.asIdeal
      haveI := z.isPrime
      rw [Ideal.eq_bot_of_prime z.asIdeal, ← RingHom.ker_eq_comap_bot, IsLocalRing.ker_residue]
      haveI := (g y).isPrime
      symm
      refine (IsLocalRing.maximalIdeal.isMaximal A).eq_of_le (Ideal.comap_isPrime _ _).ne_top ?_
      rw [hπ, Ideal.span_singleton_le_iff_mem, Ideal.mem_comap]
      exact hy
    obtain ⟨w, hw1, -⟩ := Scheme.Pullback.exists_preimage_pullback y z heq
    exact ⟨w, hw1⟩

  haveI : IsClosedImmersion (wcQmSp A) :=
    IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom (IsLocalRing.residue A))
      IsLocalRing.residue_surjective
  have hind := (Limits.pullback.fst fX (wcQmSp A)).isClosedEmbedding.isInducing

  have htube : ∀ (a : Fin (r + 2)) (v : ↥(Limits.pullback fX (wcQmSp A))),
      Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
        (MvPolynomial.X a) ∉ (g (Limits.pullback.fst fX (wcQmSp A) v)).asIdeal →
      v ∈ wcEtqmTube g fX a := by
    intro a v hv
    unfold wcEtqmTube
    rw [← Scheme.Hom.preimage_basicOpen_top, Scheme.Hom.mem_preimage, basicOpen_eq_of_affine,
      Scheme.Hom.comp_apply]
    exact (PrimeSpectrum.mem_basicOpen _ _).mpr hv

  have hπ₁ : algebraMap A (wcQuadModelRing A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) π ∈ (g w₁).asIdeal := by
    rw [hgw₁', ← hrel]; exact Ideal.mul_mem_right _ _ hy₁
  have hπ₀ : algebraMap A (wcQuadModelRing A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) π ∈ (g w₀).asIdeal := by
    rw [hgw₀', ← hrel]; exact Ideal.mul_mem_left _ _ hy₀
  have hπu : algebraMap A (wcQuadModelRing A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) π ∈ (g u).asIdeal := by
    rw [← hrel]; exact Ideal.mul_mem_right _ _ h0
  obtain ⟨v₁, hv₁⟩ := hlift w₁ hπ₁
  obtain ⟨v₂, hv₂⟩ := hlift w₀ hπ₀
  obtain ⟨z, hz⟩ := hlift u hπu
  refine ⟨v₁, v₂, z, ?_, ?_, ?_, ?_⟩
  · apply htube
    rw [hv₁, hgw₁']
    exact hn₁
  · apply htube
    rw [hv₂, hgw₀']
    exact hn₀
  · apply hind.specializes_iff.mp
    rw [hv₁, hz]
    exact hw₁
  · apply hind.specializes_iff.mp
    rw [hv₂, hz]
    exact hw₀

theorem wc_etqm_ss_etale_chart_star : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)],
    IsUnit ((ℓ : ℕ) : A) → ∀ (k : ℕ), 1 ≤ k → ∀ (π : A), IsLocalRing.maximalIdeal A = Ideal.span {π} →
    ∀ (r : ℕ) (U : Scheme.{u}) (g : U ⟶ Spec (.of (wcQuadModelRing A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))),
    Etale g → ∀ (u : U),
    Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (g u) →
    Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (g u) →
    ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A)) (σ : Spec (.of Ω) ⟶ Spec (.of Ω)),
    σ ≫ ξ = ξ → wcMntTame ℓ (Spec.preimage ξ).hom (Spec.preimage σ).hom π →
    wcEtTplStar (g ≫ wcQuadModelStr A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) ξ σ ℓ k :=
by
  have abs : ∀ {𝒞 : Type _} [Category 𝒞] [Abelian 𝒞] [HasDerivedCategory 𝒞]
      (X Y : DerivedCategory 𝒞) (e : X⟦(1 : ℤ)⟧ ≅ Y) (a : X ⟶ X) (b : Y ⟶ Y) (m : ℕ),
      a⟦(1 : ℤ)⟧' ≫ e.hom = e.hom ≫ b → m • (a - 𝟙 X) = 0 → m • (b - 𝟙 Y) = 0 := by
    intro 𝒞 _ _ _ X Y e a b m h h0
    have hb : b = e.inv ≫ a⟦(1 : ℤ)⟧' ≫ e.hom := by rw [h, Iso.inv_hom_id_assoc]
    have h2 : (shiftFunctor (DerivedCategory 𝒞) (1 : ℤ)).map (m • (a - 𝟙 X)) = 0 := by
      rw [h0, CategoryTheory.Functor.map_zero]
    rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_sub,
      CategoryTheory.Functor.map_id] at h2
    rw [hb]
    calc m • (e.inv ≫ a⟦(1 : ℤ)⟧' ≫ e.hom - 𝟙 Y)
        = e.inv ≫ (m • (a⟦(1 : ℤ)⟧' - 𝟙 (X⟦(1 : ℤ)⟧))) ≫ e.hom := by
          simp only [Preadditive.comp_nsmul, Preadditive.nsmul_comp, Preadditive.sub_comp,
            Preadditive.comp_sub, Category.id_comp, Iso.inv_hom_id]
      _ = 0 := by rw [h2, Limits.zero_comp, Limits.comp_zero]
  intro A _ _ _ _ _ ℓ _ hℓ k hk π hπ r U g hg u h0 h1 Ω _ _ ξ σ hσ htame
  unfold wcEtTplStar
  intro σQ hσQ1 hσQ2 Dh Dg I DσQ α hφ t ht P K Ψ Pw γ Tflat T TΨ
  obtain ⟨M, uM, wM, ιM, t₁, t₂, hc, hι, eφ, hℓt, hιw, hmono, hex, htb1, htb2, hconj⟩ :=
    wc_etqm_ss_tower_model A ℓ hℓ k hk π hπ r U g hg _ rfl Ω ξ σ hσ htame σQ hσQ1 hσQ2 Dh Dg I DσQ
      hφ t ht
  obtain ⟨v₁, v₂, z, hv₁, hv₂, hv₁z, hv₂z⟩ :=
    wc_etqm_tubes_specialize A π hπ r U g hg _ rfl u h0 h1
  have hvar := wc_etqm_model_variation_pow _ ℓ k hk M uM wM ιM t₁ t₂ hc hι hℓt hιw hmono hex
    _ _ htb1 htb2 ⟨v₁, v₂, z, hv₁, hv₂, hv₁z, hv₂z⟩
  exact fun hzero => hvar (@abs _ _ _ (HasDerivedCategory.standard _) _ _ eφ _ _ _ hconj hzero)

theorem wc_etqmh_transport_iso : ∀ (A : Type u) [CommRing A] (n : ℕ) (π : A) (c d L L' S : Matrix (Fin n) (Fin n) A), L * L' = 1 → L' * L = 1 → L.transpose * c * L = d + S - S.transpose → Nonempty (wcQuadModelRing A n π d ≃ₐ[A] wcQuadModelRing A n π c) :=
by
  intro A _ n π c d L L' S hLL' hL'L h
  classical
  let σ : Matrix (Fin n) (Fin n) A → (MvPolynomial (Fin n) A →ₐ[A] MvPolynomial (Fin n) A) :=
    fun N => MvPolynomial.aeval
      (fun i : Fin n => ∑ j, MvPolynomial.C (N i j) * MvPolynomial.X j)
  let Q : Matrix (Fin n) (Fin n) A → MvPolynomial (Fin n) A :=
    fun M => ∑ p, ∑ q, MvPolynomial.C (M p q) * MvPolynomial.X p * MvPolynomial.X q
  have hσX : ∀ N i, σ N (MvPolynomial.X i) =
      ∑ j, MvPolynomial.C (N i j) * MvPolynomial.X j := by
    intro N i
    simp only [σ, MvPolynomial.aeval_X]
  have hσC : ∀ N r, σ N (MvPolynomial.C r) = MvPolynomial.C r := by
    intro N r
    simp only [σ, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]

  have reorder : ∀ (f : Fin n → Fin n → Fin n → Fin n → MvPolynomial (Fin n) A),
      ∑ a, ∑ b, ∑ q, ∑ p, f p q a b = ∑ p, ∑ q, ∑ a, ∑ b, f p q a b := by
    intro f
    calc ∑ a, ∑ b, ∑ q, ∑ p, f p q a b = ∑ a, ∑ b, ∑ p, ∑ q, f p q a b :=
          Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => Finset.sum_comm
      _ = ∑ a, ∑ p, ∑ b, ∑ q, f p q a b := Finset.sum_congr rfl fun a _ => Finset.sum_comm
      _ = ∑ p, ∑ a, ∑ b, ∑ q, f p q a b := Finset.sum_comm
      _ = ∑ p, ∑ a, ∑ q, ∑ b, f p q a b :=
          Finset.sum_congr rfl fun p _ => Finset.sum_congr rfl fun a _ => Finset.sum_comm
      _ = ∑ p, ∑ q, ∑ a, ∑ b, f p q a b := Finset.sum_congr rfl fun p _ => Finset.sum_comm

  have s1 : ∀ M N : Matrix (Fin n) (Fin n) A, σ N (Q M) = Q (N.transpose * M * N) := by
    intro M N
    have lhs : σ N (Q M) = ∑ p, ∑ q, ∑ a, ∑ b,
        MvPolynomial.C (N p a * M p q * N q b) * (MvPolynomial.X a * MvPolynomial.X b) := by
      simp only [Q, map_sum, map_mul, hσC, hσX]
      refine Finset.sum_congr rfl fun p _ => Finset.sum_congr rfl fun q _ => ?_
      rw [mul_assoc, Finset.sum_mul_sum]
      simp only [Finset.mul_sum]
      refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
      ring
    have rhs : Q (N.transpose * M * N) = ∑ a, ∑ b, ∑ q, ∑ p,
        MvPolynomial.C (N p a * M p q * N q b) * (MvPolynomial.X a * MvPolynomial.X b) := by
      simp only [Q]
      refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
      simp only [Matrix.mul_apply, Matrix.transpose_apply, Finset.sum_mul, map_sum]
      refine Finset.sum_congr rfl fun q _ => Finset.sum_congr rfl fun p _ => ?_
      ring
    rw [lhs, rhs]
    exact (reorder (fun p q a b => MvPolynomial.C (N p a * M p q * N q b) *
      (MvPolynomial.X a * MvPolynomial.X b))).symm

  have s2 : ∀ M T : Matrix (Fin n) (Fin n) A, Q (M + T - T.transpose) = Q M := by
    intro M T
    simp only [Q, Matrix.sub_apply, Matrix.add_apply, Matrix.transpose_apply, map_sub, map_add,
      sub_mul, add_mul, Finset.sum_sub_distrib, Finset.sum_add_distrib]
    have hswap : ∑ p, ∑ q, MvPolynomial.C (T q p) * MvPolynomial.X p * MvPolynomial.X q =
        ∑ p, ∑ q, (MvPolynomial.C (T p q) * MvPolynomial.X p * MvPolynomial.X q :
          MvPolynomial (Fin n) A) := by
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun p _ => Finset.sum_congr rfl fun q _ => ?_
      ring
    rw [hswap, add_sub_cancel_right]

  have s3 : ∀ N N' : Matrix (Fin n) (Fin n) A, N * N' = 1 →
      (σ N').comp (σ N) = AlgHom.id A (MvPolynomial (Fin n) A) := by
    intro N N' hNN'
    apply MvPolynomial.algHom_ext
    intro i
    rw [AlgHom.comp_apply, hσX, AlgHom.id_apply, map_sum]
    simp only [map_mul, hσC, hσX, Finset.mul_sum]
    rw [Finset.sum_comm]
    have key : ∀ l, ∑ j, MvPolynomial.C (N i j) * (MvPolynomial.C (N' j l) * MvPolynomial.X l) =
        (MvPolynomial.C ((N * N') i l) * MvPolynomial.X l : MvPolynomial (Fin n) A) := by
      intro l
      rw [Matrix.mul_apply, map_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_mul]
      ring
    simp only [key, hNN', Matrix.one_apply]
    simp

  have s4 : L'.transpose * d * L' =
      c + (-(L'.transpose * S * L')) - (-(L'.transpose * S * L')).transpose := by
    have hd : d = L.transpose * c * L - S + S.transpose := by rw [h]; abel
    have hT : L'.transpose * L.transpose = 1 := by
      rw [← Matrix.transpose_mul, hLL', Matrix.transpose_one]
    have e1 : L'.transpose * (L.transpose * c * L) * L' = c := by
      calc L'.transpose * (L.transpose * c * L) * L'
          = (L'.transpose * L.transpose) * c * (L * L') := by simp only [Matrix.mul_assoc]
        _ = c := by rw [hT, hLL', Matrix.one_mul, Matrix.mul_one]
    have e2 : L'.transpose * S.transpose * L' = (L'.transpose * S * L').transpose := by
      rw [Matrix.transpose_mul, Matrix.transpose_mul, Matrix.transpose_transpose, Matrix.mul_assoc]
    rw [hd, Matrix.mul_add, Matrix.mul_sub, Matrix.add_mul, Matrix.sub_mul, e1, e2,
      Matrix.transpose_neg]
    abel

  have hfg := s3 L L' hLL'
  have hgf := s3 L' L hL'L
  let φ := AlgEquiv.ofAlgHom (σ L') (σ L) hfg hgf
  have hgen : σ L' (Q d - MvPolynomial.C π) = Q c - MvPolynomial.C π := by
    rw [map_sub, hσC, s1, s4, s2]
  refine ⟨Ideal.quotientEquivAlg (wcQuadModelIdeal A n π d) (wcQuadModelIdeal A n π c) φ ?_⟩
  show Ideal.span {Q c - MvPolynomial.C π} =
    Ideal.map (φ : MvPolynomial (Fin n) A →+* MvPolynomial (Fin n) A)
      (Ideal.span {Q d - MvPolynomial.C π})
  rw [Ideal.map_span, Set.image_singleton]
  exact congrArg (fun y => Ideal.span {y}) hgen.symm

theorem wc_etqmh_residue_isotropic : ∀ (K : Type u) [Field K] [IsSepClosed K] (N : ℕ), 2 ≤ N → ∀ (c : Matrix (Fin N) (Fin N) K), (c + c.transpose).det ≠ 0 → ∃ v w : Fin N → K, dotProduct v (c.mulVec v) = 0 ∧ dotProduct v ((c + c.transpose).mulVec w) = 1 :=
by
  intro K _ _ N hN c hdet
  classical
  set i0 : Fin N := ⟨0, by omega⟩ with hi0
  set i1 : Fin N := ⟨1, by omega⟩ with hi1
  have h01 : i1 ≠ i0 := by simp [hi0, hi1, Fin.ext_iff]
  have hmv : ∀ (k : Fin N) (y : K) (i : Fin N), (c.mulVec (Pi.single k y)) i = c i k * y := by
    intro k y i
    simp [Matrix.mulVec, dotProduct_single]
  have plane : ∀ j : Fin N, j ≠ i0 → ∀ t : K,
      dotProduct (Pi.single i0 t + Pi.single j 1) (c.mulVec (Pi.single i0 t + Pi.single j 1))
        = c i0 i0 * t ^ 2 + (c i0 j + c j i0) * t + c j j := by
    intro j hj t
    rw [Matrix.mulVec_add, dotProduct_add, add_dotProduct, add_dotProduct,
      single_dotProduct, single_dotProduct, single_dotProduct, single_dotProduct,
      hmv, hmv, hmv, hmv]
    ring
  have hiso : ∃ v : Fin N → K, v ≠ 0 ∧ dotProduct v (c.mulVec v) = 0 := by
    by_cases h2 : (2 : K) = 0
    · have hrow : ∃ j, (c + c.transpose) i0 j ≠ 0 := by
        by_contra hcon
        push_neg at hcon
        exact hdet (Matrix.det_eq_zero_of_row_eq_zero i0 hcon)
      obtain ⟨j, hj⟩ := hrow
      have hjne : j ≠ i0 := by
        rintro rfl
        apply hj
        simp only [Matrix.add_apply, Matrix.transpose_apply]
        rw [← two_mul, h2, zero_mul]
      have hβ : c i0 j + c j i0 ≠ 0 := by
        simpa [Matrix.add_apply, Matrix.transpose_apply] using hj
      obtain ⟨t, ht⟩ := IsSepClosed.exists_root_C_mul_X_pow_add_C_mul_X_add_C (n := 2)
        (c i0 i0) (c i0 j + c j i0) (c j j) (by exact_mod_cast h2) le_rfl hβ
      refine ⟨Pi.single i0 t + Pi.single j 1, ?_, ?_⟩
      · intro h
        have := congrFun h j
        simp [Pi.single_eq_of_ne hjne] at this
      · rw [plane j hjne t]; exact ht
    · by_cases ha : c i0 i0 = 0
      · refine ⟨Pi.single i0 1, ?_, ?_⟩
        · intro h
          have := congrFun h i0
          simp at this
        · rw [single_dotProduct, hmv, ha]; ring
      · haveI : NeZero (2 : K) := ⟨h2⟩
        obtain ⟨s, hs⟩ := IsSepClosed.exists_eq_mul_self
          (discrim (c i0 i0) (c i0 i1 + c i1 i0) (c i1 i1))
        obtain ⟨t, ht⟩ := exists_quadratic_eq_zero ha ⟨s, hs⟩
        refine ⟨Pi.single i0 t + Pi.single i1 1, ?_, ?_⟩
        · intro h
          have := congrFun h i1
          simp [Pi.single_eq_of_ne h01] at this
        · rw [plane i1 h01 t, sq]; exact ht
  obtain ⟨v, hv, hQ⟩ := hiso
  set r := Matrix.vecMul v (c + c.transpose) with hr
  have hr0 : r ≠ 0 := by
    intro h
    exact hdet (Matrix.exists_vecMul_eq_zero_iff.mp ⟨v, hv, h⟩)
  obtain ⟨k, hk⟩ := Function.ne_iff.mp hr0
  refine ⟨v, Pi.single k (r k)⁻¹, hQ, ?_⟩
  rw [Matrix.dotProduct_mulVec, ← hr, dotProduct_single]
  exact mul_inv_cancel₀ hk

theorem wc_etqmh_hensel_pair : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] (N : ℕ) (c : Matrix (Fin N) (Fin N) A) (vb wb : Fin N → IsLocalRing.ResidueField A), dotProduct vb ((c.map (IsLocalRing.residue A)).mulVec vb) = 0 → dotProduct vb (((c.map (IsLocalRing.residue A)) + (c.map (IsLocalRing.residue A)).transpose).mulVec wb) = 1 → ∃ v w : Fin N → A, dotProduct v (c.mulVec v) = 0 ∧ dotProduct w (c.mulVec w) = 0 ∧ dotProduct v ((c + c.transpose).mulVec w) = 1 :=
by
  intro A _ _ N c vb wb h1 h2
  classical
  have hBgen : ∀ {R : Type u} [CommRing R] (M : Matrix (Fin N) (Fin N) R) (x y : Fin N → R),
      dotProduct x ((M + M.transpose).mulVec y) = dotProduct x (M.mulVec y) + dotProduct y (M.mulVec x) := by
    intro R _ M x y
    rw [Matrix.add_mulVec, dotProduct_add, Matrix.mulVec_transpose, dotProduct_comm x (Matrix.vecMul y M),
      ← Matrix.dotProduct_mulVec]
  have hmap : ∀ x y : Fin N → A, IsLocalRing.residue A (dotProduct x (c.mulVec y)) =
      dotProduct (IsLocalRing.residue A ∘ x) ((c.map (IsLocalRing.residue A)).mulVec (IsLocalRing.residue A ∘ y)) := by
    intro x y
    rw [RingHom.map_dotProduct]
    congr 1
    funext i
    exact RingHom.map_mulVec (IsLocalRing.residue A) c y i
  obtain ⟨v₀, hv₀⟩ : ∃ v₀ : Fin N → A, IsLocalRing.residue A ∘ v₀ = vb :=
    ⟨fun i => Function.surjInv IsLocalRing.residue_surjective (vb i),
      funext fun i => Function.surjInv_eq IsLocalRing.residue_surjective (vb i)⟩
  obtain ⟨w₀, hw₀⟩ : ∃ w₀ : Fin N → A, IsLocalRing.residue A ∘ w₀ = wb :=
    ⟨fun i => Function.surjInv IsLocalRing.residue_surjective (wb i),
      funext fun i => Function.surjInv_eq IsLocalRing.residue_surjective (wb i)⟩
  rw [hBgen] at h2
  have hre : IsLocalRing.residue A (dotProduct v₀ (c.mulVec v₀)) = 0 := by
    rw [hmap, hv₀]; exact h1
  have hrb : IsLocalRing.residue A (dotProduct v₀ (c.mulVec w₀) + dotProduct w₀ (c.mulVec v₀)) = 1 := by
    rw [map_add, hmap, hmap, hv₀, hw₀]; exact h2
  have hem : dotProduct v₀ (c.mulVec v₀) ∈ IsLocalRing.maximalIdeal A :=
    (IsLocalRing.residue_eq_zero_iff _).mp hre
  have hbu : IsUnit (dotProduct v₀ (c.mulVec w₀) + dotProduct w₀ (c.mulVec v₀)) :=
    (IsLocalRing.residue_ne_zero_iff_isUnit _).mp (by rw [hrb]; exact one_ne_zero)

  have hens : ∀ (a b e : A), IsUnit b → e ∈ IsLocalRing.maximalIdeal A →
      ∃ t ∈ IsLocalRing.maximalIdeal A, a * t ^ 2 + b * t + e = 0 := by
    intro a b e hb he
    let f : Polynomial A := Polynomial.X ^ 2 + (Polynomial.C b * Polynomial.X + Polynomial.C (a * e))
    have hmon : f.Monic := by
      apply Polynomial.monic_X_pow_add
      exact lt_of_le_of_lt Polynomial.degree_linear_le (by exact_mod_cast (show (1:ℕ) < 2 by norm_num))
    have hf1 : Polynomial.eval (-b) f = a * e := by simp [f] <;> ring
    have hf2 : Polynomial.eval (-b) (Polynomial.derivative f) = -b := by simp [f] <;> ring
    obtain ⟨s, hsroot, hsm⟩ := HenselianLocalRing.is_henselian f hmon (-b)
      (by rw [hf1]; exact Ideal.mul_mem_left _ a he) (by rw [hf2]; exact hb.neg)
    have hs : s ^ 2 + b * s + a * e = 0 := by
      have h := hsroot.eq_zero
      simp [f] at h
      linear_combination h
    have hsu : IsUnit s := by
      by_contra hns
      have hs_m : s ∈ IsLocalRing.maximalIdeal A := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]; exact hns
      have hbm : b ∈ IsLocalRing.maximalIdeal A := by
        have h3 := Ideal.sub_mem _ hsm hs_m
        have h4 : b = s - -b - s := by ring
        rw [h4]; exact h3
      exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hbm) hb
    refine ⟨e * ↑(hsu.unit⁻¹), Ideal.mul_mem_right _ _ he, ?_⟩
    have hts : e * ↑(hsu.unit⁻¹) * s = e := by
      rw [mul_assoc, hsu.val_inv_mul, mul_one]
    have key : (a * (e * ↑(hsu.unit⁻¹)) ^ 2 + b * (e * ↑(hsu.unit⁻¹)) + e) * (s * s) = 0 := by
      linear_combination (a * (e * ↑(hsu.unit⁻¹) * s + e) + b * s) * hts + e * hs
    exact (hsu.mul hsu).mul_left_eq_zero.mp key
  obtain ⟨t, htm, ht⟩ := hens (dotProduct w₀ (c.mulVec w₀))
    (dotProduct v₀ (c.mulVec w₀) + dotProduct w₀ (c.mulVec v₀)) (dotProduct v₀ (c.mulVec v₀)) hbu hem
  obtain ⟨v, hv⟩ : ∃ v : Fin N → A, v = v₀ + t • w₀ := ⟨_, rfl⟩
  have hPv : dotProduct v (c.mulVec v) = 0 := by
    rw [hv]
    simp only [Matrix.mulVec_add, Matrix.mulVec_smul, add_dotProduct, dotProduct_add, smul_dotProduct,
      dotProduct_smul, smul_eq_mul]
    linear_combination ht
  have hβeq : dotProduct v (c.mulVec w₀) + dotProduct w₀ (c.mulVec v) =
      (dotProduct v₀ (c.mulVec w₀) + dotProduct w₀ (c.mulVec v₀)) + t * (2 * dotProduct w₀ (c.mulVec w₀)) := by
    rw [hv]
    simp only [Matrix.mulVec_add, Matrix.mulVec_smul, add_dotProduct, dotProduct_add, smul_dotProduct,
      dotProduct_smul, smul_eq_mul]
    ring
  have hrt : IsLocalRing.residue A t = 0 := (IsLocalRing.residue_eq_zero_iff _).mpr htm
  have hβu : IsUnit (dotProduct v (c.mulVec w₀) + dotProduct w₀ (c.mulVec v)) := by
    apply (IsLocalRing.residue_ne_zero_iff_isUnit _).mp
    rw [hβeq, map_add, map_mul, hrb, hrt, zero_mul, add_zero]
    exact one_ne_zero
  obtain ⟨w₁, hw₁⟩ : ∃ w₁ : Fin N → A, w₁ = (↑(hβu.unit⁻¹) : A) • w₀ := ⟨_, rfl⟩
  have hγ : (↑(hβu.unit⁻¹) : A) * (dotProduct v (c.mulVec w₀) + dotProduct w₀ (c.mulVec v)) = 1 :=
    hβu.val_inv_mul
  have hS : dotProduct v (c.mulVec w₁) + dotProduct w₁ (c.mulVec v) = 1 := by
    rw [hw₁]
    simp only [Matrix.mulVec_smul, smul_dotProduct, dotProduct_smul, smul_eq_mul]
    linear_combination hγ
  refine ⟨v, w₁ + (-(dotProduct w₁ (c.mulVec w₁))) • v, hPv, ?_, ?_⟩
  · simp only [Matrix.mulVec_add, Matrix.mulVec_smul, add_dotProduct, dotProduct_add, smul_dotProduct,
      dotProduct_smul, smul_eq_mul]
    linear_combination (-(dotProduct w₁ (c.mulVec w₁))) * hS + (dotProduct w₁ (c.mulVec w₁)) ^ 2 * hPv
  · rw [hBgen]
    simp only [Matrix.mulVec_add, Matrix.mulVec_smul, add_dotProduct, dotProduct_add, smul_dotProduct,
      dotProduct_smul, smul_eq_mul]
    linear_combination hS + 2 * (-(dotProduct w₁ (c.mulVec w₁))) * hPv

theorem wc_etqmh_complete_basis : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (k : ℕ) (c : Matrix (Fin (k + 2)) (Fin (k + 2)) A) (v w : Fin (k + 2) → A), dotProduct v (c.mulVec v) = 0 → dotProduct w (c.mulVec w) = 0 → dotProduct v ((c + c.transpose).mulVec w) = 1 → ∃ P P' : Matrix (Fin (k + 2)) (Fin (k + 2)) A, P * P' = 1 ∧ P' * P = 1 ∧ (P.transpose * c * P) 0 0 = 0 ∧ (P.transpose * c * P) 1 1 = 0 ∧ (P.transpose * c * P) 0 1 + (P.transpose * c * P) 1 0 = 1 :=
by
  intro A _ _ k c v w hv hw hvw
  classical

  have det_tail : ∀ (n : ℕ) (M : Matrix (Fin (n + 2)) (Fin (n + 2)) A),
      (∀ r l : Fin (n + 2), 2 ≤ l.val → M r l = if r = l then 1 else 0) →
      M.det = M 0 0 * M 1 1 - M 0 1 * M 1 0 := by
    intro n
    induction n with
    | zero => intro M _; exact Matrix.det_fin_two M
    | succ n ih =>
      intro M hM
      rw [Matrix.det_succ_column M (Fin.last (n + 2))]
      rw [Finset.sum_eq_single (Fin.last (n + 2))]
      · have h1 : M (Fin.last (n + 2)) (Fin.last (n + 2)) = 1 := by
          rw [hM _ _ (by simp)]; simp
        rw [h1, Fin.succAbove_last]
        have hsign : ((-1 : A) ^ ((Fin.last (n + 2) : ℕ) + (Fin.last (n + 2) : ℕ))) = 1 := by
          rw [← two_mul, pow_mul]; simp
        rw [hsign, one_mul, one_mul]
        rw [ih (M.submatrix Fin.castSucc Fin.castSucc)]
        · simp [Matrix.submatrix_apply]
        · intro r l hl
          simp only [Matrix.submatrix_apply]
          rw [hM _ _ (by simpa using hl)]
          simp [Fin.castSucc_inj]
      · intro b _ hb
        rw [hM _ _ (by simp)]
        simp [hb]
      · intro h; exact absurd (Finset.mem_univ _) h

  have polar : ∀ x y : Fin (k + 2) → A, dotProduct x ((c + c.transpose).mulVec y) =
      dotProduct x (c.mulVec y) + dotProduct y (c.mulVec x) := by
    intro x y
    rw [Matrix.add_mulVec, dotProduct_add, Matrix.mulVec_transpose, dotProduct_comm x (Matrix.vecMul y c),
      ← Matrix.dotProduct_mulVec]

  have gram : ∀ (P : Matrix (Fin (k + 2)) (Fin (k + 2)) A) (a b : Fin (k + 2)),
      (P.transpose * c * P) a b = dotProduct (fun r => P r a) (c.mulVec (fun s => P s b)) := by
    intro P a b
    simp only [Matrix.mul_apply, Matrix.transpose_apply, dotProduct, Matrix.mulVec, Finset.sum_mul,
      Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun s _ => Finset.sum_congr rfl (fun r _ => ?_))
    ring

  set r : Fin (k + 2) → A := Matrix.vecMul v (c + c.transpose) with hr
  have hrw : ∑ q, r q * w q = 1 := by
    rw [← hvw, Matrix.dotProduct_mulVec]; rfl
  have hrv : ∑ q, r q * v q = 0 := by
    have : dotProduct v ((c + c.transpose).mulVec v) = 0 := by
      rw [polar, hv, add_zero]
    rw [← this, Matrix.dotProduct_mulVec]; rfl
  have key : ∀ i, v i = ∑ q, r q * (v i * w q - w i * v q) := by
    intro i
    have : ∑ q, r q * (v i * w q - w i * v q) = v i * (∑ q, r q * w q) - w i * (∑ q, r q * v q) := by
      rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_sub_distrib]
      exact Finset.sum_congr rfl (fun q _ => by ring)
    rw [this, hrw, hrv]; ring
  have hunit : ∃ i j : Fin (k + 2), i ≠ j ∧ IsUnit (v i * w j - w i * v j) := by
    by_contra hcon
    push_neg at hcon
    have hm : ∀ i j, v i * w j - w i * v j ∈ IsLocalRing.maximalIdeal A := by
      intro i j
      by_cases hij : i = j
      · subst hij
        rw [show v i * w i - w i * v i = 0 by ring]
        exact Ideal.zero_mem _
      · exact (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr (hcon i j hij))
    have hvm : ∀ i, v i ∈ IsLocalRing.maximalIdeal A := by
      intro i
      rw [key i]
      exact Ideal.sum_mem _ (fun q _ => Ideal.mul_mem_left _ _ (hm i q))
    have hrm : ∀ q, r q ∈ IsLocalRing.maximalIdeal A := by
      intro q
      simp only [hr, Matrix.vecMul, dotProduct]
      exact Ideal.sum_mem _ (fun p _ => Ideal.mul_mem_right _ _ (hvm p))
    have h1 : (1 : A) ∈ IsLocalRing.maximalIdeal A := by
      rw [← hrw]
      exact Ideal.sum_mem _ (fun q _ => Ideal.mul_mem_right _ _ (hrm q))
    exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp h1)) isUnit_one
  obtain ⟨i, j, hij, hmin⟩ := hunit

  have h01 : (0 : Fin (k + 2)) ≠ 1 := by
    intro h; have := congrArg Fin.val h; simp at this
  set τ : Equiv.Perm (Fin (k + 2)) := Equiv.swap 0 i with hτ
  set j₁ := τ j with hj₁
  have hj₁0 : j₁ ≠ 0 := by
    intro h
    apply hij
    have : τ j₁ = τ 0 := by rw [h]
    rw [hj₁, hτ, Equiv.swap_apply_self, Equiv.swap_apply_left] at this
    exact this.symm
  set σ : Equiv.Perm (Fin (k + 2)) := (Equiv.swap 1 j₁).trans τ with hσ
  have hσ0 : σ 0 = i := by
    rw [hσ, Equiv.trans_apply, Equiv.swap_apply_of_ne_of_ne h01 hj₁0.symm, hτ, Equiv.swap_apply_left]
  have hσ1 : σ 1 = j := by
    rw [hσ, Equiv.trans_apply, Equiv.swap_apply_left, hj₁, hτ, Equiv.swap_apply_self]

  set P : Matrix (Fin (k + 2)) (Fin (k + 2)) A := Matrix.of fun r l =>
    if l = 0 then v r else if l = 1 then w r else (if r = σ l then 1 else 0) with hP
  have hP0 : (fun r => P r 0) = v := by funext r; simp [hP]
  have hP1 : (fun r => P r 1) = w := by funext r; simp [hP, h01.symm]
  have hdet : IsUnit P.det := by
    set M := P.submatrix σ id with hM
    have hMt : ∀ r l : Fin (k + 2), 2 ≤ l.val → M r l = if r = l then 1 else 0 := by
      intro r l hl
      have hl0 : l ≠ 0 := by intro h; subst h; simp at hl
      have hl1 : l ≠ 1 := by intro h; subst h; simp at hl
      simp [hM, hP, hl0, hl1]
    have hdM := det_tail k M hMt
    have hval : M.det = v i * w j - w i * v j := by
      rw [hdM]
      simp [hM, hP, h01.symm, hσ0, hσ1]
    have hperm := Matrix.det_permute σ P
    rw [← hM, hval] at hperm
    rw [hperm] at hmin
    exact isUnit_of_mul_isUnit_right hmin
  refine ⟨P, P⁻¹, Matrix.mul_nonsing_inv P hdet, Matrix.nonsing_inv_mul P hdet, ?_, ?_, ?_⟩
  · rw [gram, hP0, hv]
  · rw [gram, hP1, hw]
  · rw [gram, gram, hP0, hP1, ← polar, hvw]

theorem wc_etqmh_orthogonalize : ∀ (A : Type u) [CommRing A] (k : ℕ) (c₁ : Matrix (Fin (k + 2)) (Fin (k + 2)) A), c₁ 0 0 = 0 → c₁ 1 1 = 0 → c₁ 0 1 + c₁ 1 0 = 1 → ∃ (U U' S : Matrix (Fin (k + 2)) (Fin (k + 2)) A) (c'' : Matrix (Fin k) (Fin k) A), U * U' = 1 ∧ U' * U = 1 ∧ U.transpose * c₁ * U = (Matrix.of fun p q : Fin (k + 2) => if p.val = 0 ∧ q.val = 1 then (1 : A) else if h : 2 ≤ p.val ∧ 2 ≤ q.val then c'' ⟨p.val - 2, by omega⟩ ⟨q.val - 2, by omega⟩ else 0) + S - S.transpose :=
by
  intro A _ k c₁ h00 h11 h01
  classical
  obtain ⟨x, hx⟩ : ∃ x : Fin (k + 2) → A, ∀ s, x s = -(c₁ 1 s + c₁ s 1) := ⟨_, fun _ => rfl⟩
  obtain ⟨y, hy⟩ : ∃ y : Fin (k + 2) → A, ∀ s, y s = -(c₁ 0 s + c₁ s 0) := ⟨_, fun _ => rfl⟩
  obtain ⟨N, hN⟩ : ∃ N : Matrix (Fin (k + 2)) (Fin (k + 2)) A, ∀ r s, N r s =
      if 2 ≤ s.val then (if r.val = 0 then x s else if r.val = 1 then y s else 0) else 0 :=
    ⟨Matrix.of fun r s => if 2 ≤ s.val then (if r.val = 0 then x s else if r.val = 1 then y s else 0) else 0,
      fun _ _ => rfl⟩
  have hNN : N * N = 0 := by
    ext r s
    rw [Matrix.mul_apply, Matrix.zero_apply]
    apply Finset.sum_eq_zero
    intro t _
    rw [hN r t, hN t s]
    split_ifs <;> first | simp | (exfalso; omega)
  have hUU' : (1 + N) * (1 - N) = 1 := by
    rw [Matrix.add_mul, Matrix.one_mul, Matrix.mul_sub, Matrix.mul_one, hNN]; abel
  have hU'U : (1 - N) * (1 + N) = 1 := by
    rw [Matrix.sub_mul, Matrix.one_mul, Matrix.mul_add, Matrix.mul_one, hNN]; abel
  have hcases : ∀ p : Fin (k + 2), p = 0 ∨ p = 1 ∨ 2 ≤ p.val := by
    intro p
    by_cases h0 : p.val = 0
    · left; exact Fin.ext (by simp [h0])
    by_cases h1 : p.val = 1
    · right; left; exact Fin.ext (by simp [h1])
    right; right; omega
  have hNt : ∀ p q, (N.transpose * c₁) p q =
      if 2 ≤ p.val then x p * c₁ 0 q + y p * c₁ 1 q else 0 := by
    intro p q
    rw [Matrix.mul_apply, Fin.sum_univ_succ, Fin.sum_univ_succ]
    by_cases hp : 2 ≤ p.val <;> simp [Matrix.transpose_apply, hN, hp]
  have hcN : ∀ p q, (c₁ * N) p q =
      if 2 ≤ q.val then c₁ p 0 * x q + c₁ p 1 * y q else 0 := by
    intro p q
    rw [Matrix.mul_apply, Fin.sum_univ_succ, Fin.sum_univ_succ]
    by_cases hq : 2 ≤ q.val <;> simp [hN, hq]
  have hNcN : ∀ p q, (p.val < 2 ∨ q.val < 2) → (N.transpose * c₁ * N) p q = 0 := by
    intro p q h
    rw [Matrix.mul_apply]
    apply Finset.sum_eq_zero
    intro s _
    rcases h with h | h
    · rw [hNt, if_neg (by omega), zero_mul]
    · rw [hN s q, if_neg (by omega), mul_zero]
  have hF : ∀ p q, (p.val < 2 ∨ q.val < 2) → ((1 + N).transpose * c₁ * (1 + N)) p q =
      c₁ p q + (if 2 ≤ p.val then x p * c₁ 0 q + y p * c₁ 1 q else 0) +
        (if 2 ≤ q.val then c₁ p 0 * x q + c₁ p 1 * y q else 0) := by
    intro p q h
    have e : (1 + N).transpose * c₁ * (1 + N) =
        c₁ + N.transpose * c₁ + (c₁ * N + N.transpose * c₁ * N) := by
      rw [Matrix.transpose_add, Matrix.transpose_one]
      simp only [Matrix.add_mul, Matrix.mul_add, Matrix.one_mul, Matrix.mul_one]
    rw [e, Matrix.add_apply, Matrix.add_apply, Matrix.add_apply, hNt, hcN, hNcN p q h, add_zero,
      add_assoc]
  obtain ⟨c₂, hc₂⟩ : ∃ c₂, (1 + N).transpose * c₁ * (1 + N) = c₂ := ⟨_, rfl⟩
  rw [hc₂] at hF
  obtain ⟨c'', hc''⟩ : ∃ c'' : Matrix (Fin k) (Fin k) A, ∀ r s,
      c'' r s = c₂ ⟨r.val + 2, by omega⟩ ⟨s.val + 2, by omega⟩ :=
    ⟨Matrix.of fun r s => c₂ ⟨r.val + 2, by omega⟩ ⟨s.val + 2, by omega⟩, fun _ _ => rfl⟩
  obtain ⟨ε, hε⟩ : ∃ ε : Fin (k + 2) → Fin (k + 2) → A, ∀ p q, ε p q =
      if p.val = 0 ∧ q.val = 1 then 1 else if 2 ≤ p.val ∧ 2 ≤ q.val then c₂ p q else 0 :=
    ⟨_, fun _ _ => rfl⟩
  have hEe : ∀ p q, (Matrix.of fun p q : Fin (k + 2) => if p.val = 0 ∧ q.val = 1 then (1 : A) else if h : 2 ≤ p.val ∧ 2 ≤ q.val then c'' ⟨p.val - 2, by omega⟩ ⟨q.val - 2, by omega⟩ else 0) p q = ε p q := by
    intro p q
    rw [Matrix.of_apply, hε]
    split_ifs with h1 h2
    · rfl
    · rw [hc'']
      congr 1 <;> exact Fin.ext (by simp only; omega)
    · rfl
  have hdiag : ∀ p, c₂ p p = ε p p := by
    intro p
    rcases hcases p with rfl | rfl | hp
    · rw [hF 0 0 (by simp), hε]; simp [h00]
    · rw [hF 1 1 (by simp), hε]; simp [h11]
    · rw [hε, if_neg (by omega), if_pos ⟨hp, hp⟩]
  have hanti : ∀ p q, (c₂ p q - ε p q) + (c₂ q p - ε q p) = 0 := by
    intro p q
    rcases hcases p with rfl | rfl | hp <;> rcases hcases q with rfl | rfl | hq
    · rw [hdiag 0]; ring
    · rw [hF 0 1 (by simp), hF 1 0 (by simp), hε, hε]
      simp
      linear_combination h01
    · rw [hF 0 q (by simp), hF q 0 (by simp), hε, hε]
      simp [hq, show q.val ≠ 0 by omega, show q.val ≠ 1 by omega]
      linear_combination (2 * x q) * h00 + (y q) * h01 + hy q
    · rw [hF 1 0 (by simp), hF 0 1 (by simp), hε, hε]
      simp
      linear_combination h01
    · rw [hdiag 1]; ring
    · rw [hF 1 q (by simp), hF q 1 (by simp), hε, hε]
      simp [hq, show q.val ≠ 0 by omega, show q.val ≠ 1 by omega]
      linear_combination (x q) * h01 + (2 * y q) * h11 + hx q
    · rw [hF p 0 (by simp), hF 0 p (by simp), hε, hε]
      simp [hp, show p.val ≠ 0 by omega, show p.val ≠ 1 by omega]
      linear_combination (2 * x p) * h00 + (y p) * h01 + hy p
    · rw [hF p 1 (by simp), hF 1 p (by simp), hε, hε]
      simp [hp, show p.val ≠ 0 by omega, show p.val ≠ 1 by omega]
      linear_combination (x p) * h01 + (2 * y p) * h11 + hx p
    · rw [hε, hε, if_neg (by omega), if_pos ⟨hp, hq⟩, if_neg (by omega), if_pos ⟨hq, hp⟩]
      ring
  refine ⟨1 + N, 1 - N, Matrix.of fun p q => if p < q then c₂ p q - ε p q else 0, c'', hUU', hU'U, ?_⟩
  rw [hc₂]
  ext p q
  rw [Matrix.sub_apply, Matrix.add_apply, hEe p q, Matrix.transpose_apply, Matrix.of_apply,
    Matrix.of_apply]
  rcases lt_trichotomy p q with h | rfl | h
  · rw [if_pos h, if_neg (not_lt.mpr h.le)]; ring
  · rw [if_neg (lt_irrefl _), hdiag]; ring
  · rw [if_neg (not_lt.mpr h.le), if_pos h]
    linear_combination hanti p q

theorem wc_etqmh_ext_det : ∀ (A : Type u) [CommRing A] (k : ℕ) (D : Matrix (Fin k) (Fin k) A), ((Matrix.of fun p q : Fin (k + 2) => if p.val = 0 ∧ q.val = 1 then (1 : A) else if h : 2 ≤ p.val ∧ 2 ≤ q.val then D ⟨p.val - 2, by omega⟩ ⟨q.val - 2, by omega⟩ else 0) + (Matrix.of fun p q : Fin (k + 2) => if p.val = 0 ∧ q.val = 1 then (1 : A) else if h : 2 ≤ p.val ∧ 2 ≤ q.val then D ⟨p.val - 2, by omega⟩ ⟨q.val - 2, by omega⟩ else 0).transpose).det = -(D + D.transpose).det :=
by
  intro A _ k D
  have key : ∀ M : Matrix (Fin (k + 2)) (Fin (k + 2)) A, M 0 0 = 0 → M 0 1 = 1 →
      (∀ j : Fin k, M 0 j.succ.succ = 0) → M 1 0 = 1 → (∀ j : Fin k, M 1 j.succ.succ = 0) →
      (∀ i j : Fin k, M i.succ.succ j.succ.succ = D i j + D j i) →
      M.det = -(D + D.transpose).det := by
    intro M h00 h01 h0s h10 h1s hss
    rw [Matrix.det_succ_row_zero, Fin.sum_univ_succ, Fin.sum_univ_succ]
    rw [Fin.succ_zero_eq_one, h00, h01]
    simp only [h0s, mul_zero, zero_mul, Finset.sum_const_zero, add_zero, zero_add, Fin.val_one,
      pow_one, mul_one, neg_one_mul]
    congr 1
    rw [Matrix.det_succ_row_zero, Fin.sum_univ_succ]
    simp only [Matrix.submatrix_apply, Fin.one_succAbove_zero, Fin.succ_zero_eq_one, h10,
      Fin.one_succAbove_succ, h1s, mul_zero, zero_mul, Finset.sum_const_zero, add_zero,
      Fin.val_zero, pow_zero, one_mul, Fin.succAbove_zero]
    congr 1
    ext i j
    simp only [Matrix.submatrix_apply, Fin.one_succAbove_succ, hss, Matrix.add_apply,
      Matrix.transpose_apply]
  apply key
  · simp
  · simp
  · intro j; simp
  · simp
  · intro j; simp
  · intro i j
    simp [Matrix.add_apply, Fin.val_succ]

theorem wc_etqmh_block_extend : ∀ (A : Type u) [CommRing A] (k : ℕ) (D L₂ L₂' S₂ : Matrix (Fin k) (Fin k) A), L₂ * L₂' = 1 → L₂' * L₂ = 1 → L₂.transpose * D * L₂ = (Matrix.of fun p q : Fin k => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0) + S₂ - S₂.transpose → ∃ L L' S : Matrix (Fin (k + 2)) (Fin (k + 2)) A, L * L' = 1 ∧ L' * L = 1 ∧ L.transpose * (Matrix.of fun p q : Fin (k + 2) => if p.val = 0 ∧ q.val = 1 then (1 : A) else if h : 2 ≤ p.val ∧ 2 ≤ q.val then D ⟨p.val - 2, by omega⟩ ⟨q.val - 2, by omega⟩ else 0) * L = (Matrix.of fun p q : Fin (k + 2) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0) + S - S.transpose :=
by
  intro A _ k D L₂ L₂' S₂ h1 h2 h3
  let e : Fin 2 ⊕ Fin k ≃ Fin (k + 2) := finSumFinEquiv.trans (finCongr (Nat.add_comm 2 k))
  have he1 : ∀ i : Fin 2, (e (Sum.inl i)).val = i.val := by
    intro i; simp [e]
  have he2 : ∀ j : Fin k, (e (Sum.inr j)).val = 2 + j.val := by
    intro j; simp [e]; omega
  let J : Matrix (Fin 2) (Fin 2) A := Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0
  let Hk : Matrix (Fin k) (Fin k) A :=
    Matrix.of fun p q : Fin k => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0
  have hP : ∀ (X : Matrix (Fin (k + 2)) (Fin (k + 2)) A) (Y : Matrix (Fin 2 ⊕ Fin k) (Fin 2 ⊕ Fin k) A),
      X.submatrix e e = Y → X = Y.submatrix e.symm e.symm := by
    intro X Y hXY
    rw [← hXY, Matrix.submatrix_submatrix]
    ext p q
    simp
  refine ⟨(Matrix.fromBlocks 1 0 0 L₂).submatrix e.symm e.symm,
    (Matrix.fromBlocks 1 0 0 L₂').submatrix e.symm e.symm,
    (Matrix.fromBlocks 0 0 0 S₂).submatrix e.symm e.symm, ?_, ?_, ?_⟩
  · rw [Matrix.submatrix_mul_equiv, Matrix.fromBlocks_multiply]
    simp [h1, Matrix.fromBlocks_one]
  · rw [Matrix.submatrix_mul_equiv, Matrix.fromBlocks_multiply]
    simp [h2, Matrix.fromBlocks_one]
  · have hC : (Matrix.of fun p q : Fin (k + 2) => if p.val = 0 ∧ q.val = 1 then (1 : A) else if h : 2 ≤ p.val ∧ 2 ≤ q.val then D ⟨p.val - 2, by omega⟩ ⟨q.val - 2, by omega⟩ else 0)
        = (Matrix.fromBlocks J 0 0 D).submatrix e.symm e.symm := by
      apply hP
      ext (i | i) (j | j)
      · simp only [Matrix.submatrix_apply, Matrix.of_apply, Matrix.fromBlocks_apply₁₁, he1, J]
        have hi := i.isLt
        have hj := j.isLt
        split_ifs <;> first | rfl | omega
      · simp only [Matrix.submatrix_apply, Matrix.of_apply, Matrix.fromBlocks_apply₁₂, he1, he2,
          Matrix.zero_apply]
        have hi := i.isLt
        split_ifs <;> first | rfl | omega
      · simp only [Matrix.submatrix_apply, Matrix.of_apply, Matrix.fromBlocks_apply₂₁, he1, he2,
          Matrix.zero_apply]
        have hj := j.isLt
        split_ifs <;> first | rfl | omega
      · simp only [Matrix.submatrix_apply, Matrix.of_apply, Matrix.fromBlocks_apply₂₂, he2]
        split_ifs with h0 h0'
        · omega
        · congr 1 <;> ext <;> simp
        · omega
    have hR : (Matrix.of fun p q : Fin (k + 2) => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0)
        + (Matrix.fromBlocks 0 0 0 S₂).submatrix e.symm e.symm
        - ((Matrix.fromBlocks 0 0 0 S₂).submatrix e.symm e.symm).transpose
        = (Matrix.fromBlocks J 0 0 (Hk + S₂ - S₂.transpose)).submatrix e.symm e.symm := by
      apply hP
      ext (i | i) (j | j)
      · simp only [Matrix.submatrix_apply, Matrix.of_apply, Matrix.fromBlocks_apply₁₁, he1, J,
          Matrix.sub_apply, Matrix.add_apply, Matrix.transpose_apply, Equiv.symm_apply_apply,
          Matrix.zero_apply]
        have hi := i.isLt
        have hj := j.isLt
        split_ifs <;> first | omega | simp
      · simp only [Matrix.submatrix_apply, Matrix.of_apply, Matrix.fromBlocks_apply₁₂, he1, he2,
          Matrix.zero_apply, Matrix.sub_apply, Matrix.add_apply, Matrix.transpose_apply,
          Equiv.symm_apply_apply, Matrix.fromBlocks_apply₂₁]
        have hi := i.isLt
        split_ifs <;> first | omega | simp
      · simp only [Matrix.submatrix_apply, Matrix.of_apply, Matrix.fromBlocks_apply₂₁, he1, he2,
          Matrix.zero_apply, Matrix.sub_apply, Matrix.add_apply, Matrix.transpose_apply,
          Equiv.symm_apply_apply, Matrix.fromBlocks_apply₁₂]
        have hj := j.isLt
        split_ifs <;> first | omega | simp
      · simp only [Matrix.submatrix_apply, Matrix.of_apply, Matrix.fromBlocks_apply₂₂, he2,
          Matrix.sub_apply, Matrix.add_apply, Matrix.transpose_apply, Equiv.symm_apply_apply, Hk]
        congr 2
        apply if_congr _ rfl rfl
        omega
    rw [hC, hR, Matrix.transpose_submatrix, Matrix.submatrix_mul_equiv, Matrix.submatrix_mul_equiv,
      Matrix.fromBlocks_transpose, Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply]
    congr 1
    simp only [Matrix.transpose_one, Matrix.transpose_zero, Matrix.mul_zero, Matrix.zero_mul,
      Matrix.one_mul, Matrix.mul_one, add_zero, zero_add, h3, Hk]

theorem wc_etqm_hyperbolic_iso : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (n : ℕ), Even n → ∀ (π : A) (c : Matrix (Fin n) (Fin n) A),
    IsUnit (c + c.transpose).det →
    Nonempty (wcQuadModelRing A n π (Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0) ≃ₐ[A]
      wcQuadModelRing A n π c) :=
by
  intro A _ _ _ n hn π c hc

  have comp : ∀ {N : ℕ} (c c₁ d P P' S₁ X X' S₂ : Matrix (Fin N) (Fin N) A),
      P * P' = 1 → P' * P = 1 → P.transpose * c * P = c₁ + S₁ - S₁.transpose →
      X * X' = 1 → X' * X = 1 → X.transpose * c₁ * X = d + S₂ - S₂.transpose →
      ∃ M M' S : Matrix (Fin N) (Fin N) A, M * M' = 1 ∧ M' * M = 1 ∧
        M.transpose * c * M = d + S - S.transpose := by
    intro N c c₁ d P P' S₁ X X' S₂ h1 h2 h3 h4 h5 h6
    refine ⟨P * X, X' * P', X.transpose * S₁ * X + S₂, ?_, ?_, ?_⟩
    · rw [Matrix.mul_assoc, ← Matrix.mul_assoc X, h4, Matrix.one_mul, h1]
    · rw [Matrix.mul_assoc, ← Matrix.mul_assoc P', h2, Matrix.one_mul, h5]
    · have e : (P * X).transpose * c * (P * X) = X.transpose * (P.transpose * c * P) * X := by
        rw [Matrix.transpose_mul]
        simp only [Matrix.mul_assoc]
      rw [e, h3]
      have e2 : X.transpose * (c₁ + S₁ - S₁.transpose) * X =
          X.transpose * c₁ * X + X.transpose * S₁ * X - (X.transpose * S₁ * X).transpose := by
        simp only [Matrix.transpose_mul, Matrix.transpose_transpose, Matrix.mul_sub, Matrix.mul_add,
          Matrix.sub_mul, Matrix.add_mul, Matrix.mul_assoc]
      rw [e2, h6, Matrix.transpose_add]
      abel

  have transfer : ∀ {N : ℕ} (c d L L' S : Matrix (Fin N) (Fin N) A), L' * L = 1 →
      L.transpose * c * L = d + S - S.transpose → IsUnit (c + c.transpose).det →
      IsUnit (d + d.transpose).det := by
    intro N c d L L' S h1 h2 h3
    have hd : d = L.transpose * c * L - (S - S.transpose) := by rw [h2]; abel
    have e : d + d.transpose = L.transpose * (c + c.transpose) * L := by
      rw [hd]
      simp only [Matrix.transpose_sub, Matrix.transpose_add, Matrix.transpose_mul,
        Matrix.transpose_transpose, Matrix.mul_add, Matrix.add_mul, Matrix.mul_assoc]
      abel
    rw [e, Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose]
    have hL := Matrix.isUnit_det_of_left_inverse h1
    exact (hL.mul h3).mul hL

  have NF : ∀ k : ℕ, ∀ c : Matrix (Fin k) (Fin k) A, Even k → IsUnit (c + c.transpose).det →
      ∃ L L' S : Matrix (Fin k) (Fin k) A, L * L' = 1 ∧ L' * L = 1 ∧
        L.transpose * c * L = (Matrix.of fun p q : Fin k =>
          if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0) + S - S.transpose := by
    intro k
    induction k using Nat.strong_induction_on with
    | _ k ih =>
    intro c hk hc
    match k, ih, c, hk, hc with
    | 0, _, c, _, _ =>
      exact ⟨1, 1, 0, Matrix.one_mul 1, Matrix.one_mul 1, by ext i j; exact i.elim0⟩
    | 1, _, _, hk, _ => exact absurd hk Nat.not_even_one
    | j + 2, ih, c, hk, hc =>
      have hj : Even j := (Nat.even_add.mp hk).mpr even_two
      have hres : ((c.map (IsLocalRing.residue A)) +
          (c.map (IsLocalRing.residue A)).transpose).det ≠ 0 := by
        have e : ((c.map (IsLocalRing.residue A)) + (c.map (IsLocalRing.residue A)).transpose) =
            (c + c.transpose).map (IsLocalRing.residue A) := by
          rw [Matrix.map_add _ (map_add (IsLocalRing.residue A)), Matrix.transpose_map]
        rw [e, show ((c + c.transpose).map (IsLocalRing.residue A)).det =
          IsLocalRing.residue A (c + c.transpose).det from
            (RingHom.map_det (IsLocalRing.residue A) (c + c.transpose)).symm]
        exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hc
      obtain ⟨vb, wb, hvb, hwb⟩ := wc_etqmh_residue_isotropic (IsLocalRing.ResidueField A) (j + 2)
        (by omega) (c.map (IsLocalRing.residue A)) hres
      obtain ⟨v, w, hv, hw, hvw⟩ := wc_etqmh_hensel_pair A (j + 2) c vb wb hvb hwb
      obtain ⟨P, P', hPP', hP'P, h00, h11, h01⟩ := wc_etqmh_complete_basis A j c v w hv hw hvw
      obtain ⟨U, U', S₁, c'', hUU', hU'U, hU⟩ :=
        wc_etqmh_orthogonalize A j (P.transpose * c * P) h00 h11 h01
      obtain ⟨M, M', S', hMM', hM'M, hM⟩ := comp c (P.transpose * c * P) _ P P' 0 U U' S₁
        hPP' hP'P (by simp) hUU' hU'U hU
      have hE := transfer c _ M M' S' hM'M hM hc
      rw [wc_etqmh_ext_det A j c''] at hE
      have hc'' : IsUnit (c'' + c''.transpose).det := by simpa using hE.neg
      obtain ⟨L₂, L₂', S₂, h1, h2, h3⟩ := ih j (by omega) c'' hj hc''
      obtain ⟨X, X', T, hX1, hX2, hX3⟩ := wc_etqmh_block_extend A j c'' L₂ L₂' S₂ h1 h2 h3
      exact comp c _ _ M M' S' X X' T hMM' hM'M hM hX1 hX2 hX3

  obtain ⟨L, L', S, h1, h2, h3⟩ := NF n c hn hc
  exact wc_etqmh_transport_iso A n π c _ L L' S h1 h2 h3

theorem wc_etqm_sr_model (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (n : ℕ) (hn : Even n)
    (hn4 : 4 ≤ n) (π : A) (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    (c : Matrix (Fin n) (Fin n) A)
    (hc : c = Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0) :
    ∃ (X' : Scheme.{u}) (β : X' ⟶ Spec (.of (wcQuadModelRing A n π c))),
      wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun i : Fin n =>
        (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
          (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
            (MvPolynomial.X (⟨2 * (i.val / 2), lt_of_le_of_lt (Nat.mul_div_le i.val 2) i.isLt⟩ :
              Fin n)))))) β ∧
      IsProper β ∧
      (∀ x : X', ∃ (U : X'.Opens) (r : ℕ)
        (g : U.toScheme ⟶ Spec (.of (wcQuadModelRing A (r + 2) π
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))),
        x ∈ U ∧ Etale g ∧
        g ≫ wcQuadModelStr A (r + 2) π
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) =
          U.ι ≫ β ≫ wcQuadModelStr A n π c) ∧
      ∃ (U : X'.Opens) (r : ℕ)
        (g : U.toScheme ⟶ Spec (.of (wcQuadModelRing A (r + 2) π
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))))
        (y : U.toScheme),
        Etale g ∧
        g ≫ wcQuadModelStr A (r + 2) π
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) =
          U.ι ≫ β ≫ wcQuadModelStr A n π c ∧
        Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (g y) ∧
        Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (g y) :=
by
  obtain ⟨r, rfl⟩ : ∃ r, n = r + 2 := ⟨n - 2, by omega⟩
  subst hc
  have hπ0 : π ≠ 0 := by
    intro h0
    apply IsDiscreteValuationRing.not_a_field A
    rw [hπ, h0, Ideal.span_singleton_eq_bot]
  have Lc0 : ∀ {S : Type u} [CommRing S] (g : A →+* S) (f : Fin (r + 2) → S),
      ∑ a, ∑ b, g (wcSrmC0 A r a b) * f a * f b = f ⟨0, by omega⟩ * f ⟨1, by omega⟩ := by
    intro S _ g f
    rw [Finset.sum_eq_single (⟨0, by omega⟩ : Fin (r + 2))]
    · rw [Finset.sum_eq_single (⟨1, by omega⟩ : Fin (r + 2))]
      · simp
      · intro b _ hb
        have : b.val ≠ 1 := fun h => hb (Fin.ext h)
        simp [this]
      · simp
    · intro a _ ha
      have : a.val ≠ 0 := fun h => ha (Fin.ext h)
      simp [this]
    · simp
  have Lch : ∀ {S : Type u} [CommRing S] (g : A →+* S) (f : Fin (r + 2) → S),
      ∑ a, ∑ b, g (wcSrmCh A r a b) * f a * f b = f ⟨0, by omega⟩ * f ⟨1, by omega⟩ +
        ∑ i : Fin (r + 1), ∑ b, g (wcSrmCh A r i.succ b) * f i.succ * f b := by
    intro S _ g f
    rw [Fin.sum_univ_succ]
    congr 1
    rw [Finset.sum_eq_single (⟨1, by omega⟩ : Fin (r + 2))]
    · simp
    · intro b _ hb
      have : b.val ≠ 1 := fun h => hb (Fin.ext h)
      simp [this]
    · simp
  have s3core : ∑ a, ∑ b, MvPolynomial.C (wcSrmCh A r a b) * wcSrmFimg A r a * wcSrmFimg A r b =
      MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) * MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) := by
    rw [Lch MvPolynomial.C (wcSrmFimg A r)]
    have hQ := Lch (MvPolynomial.C)
      (MvPolynomial.X : Fin (r + 2) → MvPolynomial (Fin (r + 2)) A)
    have hT : ∑ i : Fin (r + 1), ∑ b, MvPolynomial.C (wcSrmCh A r i.succ b) *
        wcSrmFimg A r i.succ * wcSrmFimg A r b =
        MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) * ∑ i : Fin (r + 1), ∑ b,
          MvPolynomial.C (wcSrmCh A r i.succ b) * MvPolynomial.X i.succ * MvPolynomial.X b := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun b _ => ?_)
      by_cases h : (Fin.succ i).val % 2 = 0 ∧ b.val = (Fin.succ i).val + 1
      · have h1 : (Fin.succ i).val ≠ 0 := by simp
        have h2 : (Fin.succ i).val ≠ 1 := by omega
        have h3 : b.val ≠ 0 := by omega
        have h4 : b.val ≠ 1 := by omega
        have h5 : ¬ (b.val % 2 = 0) := by omega
        simp only [wcSrmFimg, wcSrmCh, Matrix.of_apply, if_pos h, if_neg h1, if_neg h2, if_pos h.1,
          if_neg h3, if_neg h4, if_neg h5]
        ring
      · simp only [wcSrmCh, Matrix.of_apply, if_neg h, map_zero, zero_mul, mul_zero]
    have h0 : wcSrmFimg A r ⟨0, by omega⟩ = MvPolynomial.X ⟨0, by omega⟩ := by
      simp [wcSrmFimg]
    have h1 : wcSrmFimg A r ⟨1, by omega⟩ = MvPolynomial.X ⟨1, by omega⟩ +
        MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) * MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) -
        ∑ a, ∑ b, MvPolynomial.C (wcSrmCh A r a b) * MvPolynomial.X a * MvPolynomial.X b := by
      simp only [wcSrmFimg]
      simp
    rw [hT, h0, h1, hQ]
    ring
  have s3 : ∃ φ : wcQuadModelRing A (r + 2) π (wcSrmCh A r) →+* wcQuadModelRing A (r + 2) π (wcSrmC0 A r),
      (∀ p : Fin (r + 2), φ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmCh A r))
          (MvPolynomial.X p)) =
        Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r)) (wcSrmFimg A r p)) ∧
      φ.comp (algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmCh A r))) =
        algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmC0 A r)) := by
    let φt : MvPolynomial (Fin (r + 2)) A →+* wcQuadModelRing A (r + 2) π (wcSrmC0 A r) :=
      (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r))).comp
        (MvPolynomial.aeval (wcSrmFimg A r)).toRingHom
    have hP0 := Lc0 (MvPolynomial.C)
      (MvPolynomial.X : Fin (r + 2) → MvPolynomial (Fin (r + 2)) A)
    have haev : MvPolynomial.aeval (wcSrmFimg A r) (∑ p, ∑ q, MvPolynomial.C (wcSrmCh A r p q) *
        MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C π) =
        MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) * MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) -
          MvPolynomial.C π := by
      rw [← s3core]
      simp only [map_sub, map_sum, map_mul, MvPolynomial.aeval_X, MvPolynomial.aeval_C,
        MvPolynomial.algebraMap_eq]
    have hkey : φt (∑ p, ∑ q, MvPolynomial.C (wcSrmCh A r p q) * MvPolynomial.X p *
        MvPolynomial.X q - MvPolynomial.C π) = 0 := by
      show Ideal.Quotient.mk _ (MvPolynomial.aeval (wcSrmFimg A r) _) = 0
      rw [haev, Ideal.Quotient.eq_zero_iff_mem, ← hP0]
      exact Ideal.subset_span rfl
    have hker : ∀ a ∈ wcQuadModelIdeal A (r + 2) π (wcSrmCh A r), φt a = 0 := by
      intro a ha
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      rw [map_mul, hkey, mul_zero]
    refine ⟨Ideal.Quotient.lift _ φt hker, ?_, ?_⟩
    · intro p
      rw [Ideal.Quotient.lift_mk]
      simp [φt]
    · ext a
      show Ideal.Quotient.lift _ φt hker (Ideal.Quotient.mk _ (MvPolynomial.C a)) =
        Ideal.Quotient.mk _ (MvPolynomial.C a)
      rw [Ideal.Quotient.lift_mk]
      simp [φt]
  have s6 : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈
      nonZeroDivisors (wcQuadModelRing A (r + 2) π (wcSrmC0 A r)) := by
    have hπ := hπ0
    have hP : ∑ a, ∑ b, MvPolynomial.C (wcSrmC0 A r a b) * MvPolynomial.X a * MvPolynomial.X b =
        MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) *
          (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) : MvPolynomial (Fin (r + 2)) A) :=
      Lc0 MvPolynomial.C MvPolynomial.X
    rw [mem_nonZeroDivisors_iff_right]
    intro y hy
    obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective y
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem, wcQuadModelIdeal, hP,
      Ideal.mem_span_singleton'] at hy
    obtain ⟨h, hh⟩ := hy
    rw [Ideal.Quotient.eq_zero_iff_mem, wcQuadModelIdeal, hP]
    let e := MvPolynomial.finSuccEquiv A (r + 1)
    have f0 : (⟨0, by omega⟩ : Fin (r + 2)) = 0 := Fin.ext (by simp)
    have f1 : (⟨1, by omega⟩ : Fin (r + 2)) = (0 : Fin (r + 1)).succ := Fin.ext (by simp)
    have e0 : e (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) = Polynomial.X := by
      rw [f0]; exact MvPolynomial.finSuccEquiv_X_zero
    have e1 : e (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) =
        Polynomial.C (MvPolynomial.X 0) := by
      rw [f1]; exact MvPolynomial.finSuccEquiv_X_succ
    have eπ : e (MvPolynomial.C π) = Polynomial.C (MvPolynomial.C π) := by
      have := e.commutes π
      simpa using this
    have he := congrArg e hh
    simp only [map_mul, map_sub, e0, e1, eπ] at he
    have hc : (e h * (Polynomial.X * Polynomial.C (MvPolynomial.X 0) -
        Polynomial.C (MvPolynomial.C π))).coeff 0 = (e g * Polynomial.X).coeff 0 := by rw [he]
    rw [Polynomial.mul_coeff_zero, Polynomial.mul_coeff_zero, Polynomial.coeff_X_zero, mul_zero,
      Polynomial.coeff_sub, Polynomial.mul_coeff_zero, Polynomial.coeff_X_zero, zero_mul,
      Polynomial.coeff_C_zero, zero_sub, mul_neg, neg_eq_zero] at hc
    have hc0 : (e h).coeff 0 = 0 := by
      have hCπ : (MvPolynomial.C π : MvPolynomial (Fin (r + 1)) A) ≠ 0 := by
        rwa [Ne, MvPolynomial.C_eq_zero]
      exact (mul_eq_zero.mp hc).resolve_right hCπ
    obtain ⟨q, hq⟩ := Polynomial.X_dvd_iff.mpr hc0
    have hh1 : h = MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) * e.symm q := by
      apply e.injective
      rw [map_mul, e0, AlgEquiv.apply_symm_apply, hq]
    have hX0 : (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) : MvPolynomial (Fin (r + 2)) A) ≠ 0 :=
      MvPolynomial.X_ne_zero _
    refine Ideal.mem_span_singleton'.mpr ⟨e.symm q, ?_⟩
    apply mul_left_cancel₀ hX0
    rw [← mul_assoc, ← hh1, hh]
    ring
