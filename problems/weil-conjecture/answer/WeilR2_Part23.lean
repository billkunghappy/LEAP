  haveI hjsEt : Etale (wcEtxcJs (wcQuadModelStr A n π c) (U'.ι ≫ e)) :=
    MorphismProperty.of_isPullback (P := @Etale) hP hEt



  have hfst'inj : Function.Injective
      (Limits.pullback.fst ((U'.ι ≫ e) ≫ wcQuadModelStr A n π c) (wcQmSp A)) :=
    (Limits.pullback.fst ((U'.ι ≫ e) ≫ wcQuadModelStr A n π c)
