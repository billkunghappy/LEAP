  have hm : 0 < ℓ ^ k := pow_pos (Fact.out : Nat.Prime ℓ).pos k
  have hoffX := wc_etqm_r1s_offY_stalk A ℓ hℓ k n hn hn4 π hπ c hc X' β hbl hprop f' hf' hcov
