            DerivedCategory.Q.map ((G.mapHomologicalComplex (ComplexShape.up ℤ)).map T' ≫
              nh.hom.app K') := by
            simp only [CategoryTheory.Functor.map_comp, Category.assoc]
        _ = DerivedCategory.Q.map χ ≫
            DerivedCategory.Q.map ((G'.mapHomologicalComplex (ComplexShape.up ℤ)).map T') := by
            rw [hnat]; simp only [χ, CategoryTheory.Functor.map_comp, Category.assoc]
    exact ⟨⟨DerivedCategory.Q.map χ, DerivedCategory.Q.map χ', h1, h2⟩, hc⟩

  have t_s4 : ∀ {𝒜 ℬ 𝒞 : Type _} [Category 𝒜] [Abelian 𝒜] [Category ℬ] [Abelian ℬ]
      [Category 𝒞] [Abelian 𝒞] [HasDerivedCategory 𝒞]
      (One : 𝒜) (P : 𝒜 ⥤ ℬ) [P.Additive] (Pw : 𝒜 ⥤ 𝒜) [Pw.Additive] (γ : Pw ⋙ P ⟶ P)
      (u : One ⟶ Pw.obj One) (G G' : ℬ ⥤ 𝒞) [G.Additive] [G'.Additive] (ν : G ≅ G')
      (I I' : InjectiveResolution One) (c : I.cochainComplex ⟶ I'.cochainComplex)
      (c' : I'.cochainComplex ⟶ I.cochainComplex), Homotopy (I.ι' ≫ c) I'.ι' →
      Homotopy (c ≫ c') (𝟙 _) → Homotopy (c' ≫ c) (𝟙 _) →
      (∀ f₁ f₂ : I.cochainComplex ⟶
          (Pw.mapHomologicalComplex (ComplexShape.up ℤ)).obj I'.cochainComplex,
        Nonempty (Homotopy (I.ι' ≫ f₁) (I.ι' ≫ f₂)) → Nonempty (Homotopy f₁ f₂)) →
      ∀ (F : I.cochainComplex ⟶
          (Pw.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex)
        (F' : I'.cochainComplex ⟶
          (Pw.mapHomologicalComplex (ComplexShape.up ℤ)).obj I'.cochainComplex),
      I.ι' ≫ F = (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map u ≫
        (HomologicalComplex.singleMapHomologicalComplex Pw (ComplexShape.up ℤ) 0).inv.app One ≫
        (Pw.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι' →
      I'.ι' ≫ F' = (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map u ≫
        (HomologicalComplex.singleMapHomologicalComplex Pw (ComplexShape.up ℤ) 0).inv.app One ≫
        (Pw.mapHomologicalComplex (ComplexShape.up ℤ)).map I'.ι' →
      ∃ e : DerivedCategory.Q.obj ((G.mapHomologicalComplex (ComplexShape.up ℤ)).obj
            ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex)) ≅
          DerivedCategory.Q.obj ((G'.mapHomologicalComplex (ComplexShape.up ℤ)).obj
            ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I'.cochainComplex)),
        DerivedCategory.Q.map ((G.mapHomologicalComplex (ComplexShape.up ℤ)).map
            ((P.mapHomologicalComplex (ComplexShape.up ℤ)).map F ≫
              (Functor.mapHomologicalComplexCompIso (Iso.refl (Pw ⋙ P))
                (ComplexShape.up ℤ)).hom.app I.cochainComplex ≫
              (NatTrans.mapHomologicalComplex γ (ComplexShape.up ℤ)).app I.cochainComplex)) ≫
            e.hom =
          e.hom ≫ DerivedCategory.Q.map ((G'.mapHomologicalComplex (ComplexShape.up ℤ)).map
            ((P.mapHomologicalComplex (ComplexShape.up ℤ)).map F' ≫
              (Functor.mapHomologicalComplexCompIso (Iso.refl (Pw ⋙ P))
                (ComplexShape.up ℤ)).hom.app I'.cochainComplex ≫
              (NatTrans.mapHomologicalComplex γ (ComplexShape.up ℤ)).app I'.cochainComplex)) := by
    intro 𝒜 ℬ 𝒞 _ _ _ _ _ _ _ One P _ Pw _ γ u G G' _ _ ν I I' c c' hc hcc' hc'c huniq F F' hF hF'
    have h1 : Homotopy (I.ι' ≫ c ≫ F')
        ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map u ≫
          (HomologicalComplex.singleMapHomologicalComplex Pw (ComplexShape.up ℤ) 0).inv.app One ≫
          (Pw.mapHomologicalComplex (ComplexShape.up ℤ)).map I'.ι') :=
      (Homotopy.ofEq (Category.assoc _ _ _).symm).trans
        ((hc.compRight F').trans (Homotopy.ofEq hF'))
    have e2 : I.ι' ≫ F ≫ (Pw.mapHomologicalComplex (ComplexShape.up ℤ)).map c =
        ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map u ≫
          (HomologicalComplex.singleMapHomologicalComplex Pw (ComplexShape.up ℤ) 0).inv.app One) ≫
          (Pw.mapHomologicalComplex (ComplexShape.up ℤ)).map (I.ι' ≫ c) := by
      rw [← Category.assoc, hF, CategoryTheory.Functor.map_comp]
      simp only [Category.assoc]
    have h2 : Homotopy (I.ι' ≫ F ≫ (Pw.mapHomologicalComplex (ComplexShape.up ℤ)).map c)
        ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map u ≫
          (HomologicalComplex.singleMapHomologicalComplex Pw (ComplexShape.up ℤ) 0).inv.app One ≫
          (Pw.mapHomologicalComplex (ComplexShape.up ℤ)).map I'.ι') :=
      (Homotopy.ofEq e2).trans (((Pw.mapHomotopy hc).compLeft _).trans
        (Homotopy.ofEq (Category.assoc _ _ _)))
    obtain ⟨H₁⟩ := huniq (c ≫ F') (F ≫ (Pw.mapHomologicalComplex (ComplexShape.up ℤ)).map c)
      ⟨h1.trans h2.symm⟩
    have hNat : (P.mapHomologicalComplex (ComplexShape.up ℤ)).map
          ((Pw.mapHomologicalComplex (ComplexShape.up ℤ)).map c) ≫
        (Functor.mapHomologicalComplexCompIso (Iso.refl (Pw ⋙ P))
          (ComplexShape.up ℤ)).hom.app I'.cochainComplex ≫
        (NatTrans.mapHomologicalComplex γ (ComplexShape.up ℤ)).app I'.cochainComplex =
        (Functor.mapHomologicalComplexCompIso (Iso.refl (Pw ⋙ P))
          (ComplexShape.up ℤ)).hom.app I.cochainComplex ≫
        (NatTrans.mapHomologicalComplex γ (ComplexShape.up ℤ)).app I.cochainComplex ≫
        (P.mapHomologicalComplex (ComplexShape.up ℤ)).map c := by
      ext n
      simp only [HomologicalComplex.comp_f, Functor.mapHomologicalComplex_map_f,
        Functor.mapHomologicalComplexCompIso_hom_app_f, NatTrans.mapHomologicalComplex_app_f,
        Iso.refl_hom, NatTrans.id_app, Functor.comp_obj]
      erw [Category.id_comp, Category.id_comp]
      exact γ.naturality (c.f n)
    have H₂ : Homotopy ((P.mapHomologicalComplex (ComplexShape.up ℤ)).map c ≫
        ((P.mapHomologicalComplex (ComplexShape.up ℤ)).map F' ≫
          (Functor.mapHomologicalComplexCompIso (Iso.refl (Pw ⋙ P))
            (ComplexShape.up ℤ)).hom.app I'.cochainComplex ≫
          (NatTrans.mapHomologicalComplex γ (ComplexShape.up ℤ)).app I'.cochainComplex))
        (((P.mapHomologicalComplex (ComplexShape.up ℤ)).map F ≫
          (Functor.mapHomologicalComplexCompIso (Iso.refl (Pw ⋙ P))
            (ComplexShape.up ℤ)).hom.app I.cochainComplex ≫
          (NatTrans.mapHomologicalComplex γ (ComplexShape.up ℤ)).app I.cochainComplex) ≫
          (P.mapHomologicalComplex (ComplexShape.up ℤ)).map c) :=
      (Homotopy.ofEq (by simp only [CategoryTheory.Functor.map_comp, Category.assoc])).trans
        (((P.mapHomotopy H₁).compRight ((Functor.mapHomologicalComplexCompIso
            (Iso.refl (Pw ⋙ P)) (ComplexShape.up ℤ)).hom.app I'.cochainComplex ≫
          (NatTrans.mapHomologicalComplex γ (ComplexShape.up ℤ)).app I'.cochainComplex)).trans
          (Homotopy.ofEq (by simp only [CategoryTheory.Functor.map_comp, Category.assoc, hNat])))
    have hpp : Homotopy ((P.mapHomologicalComplex (ComplexShape.up ℤ)).map c ≫
        (P.mapHomologicalComplex (ComplexShape.up ℤ)).map c') (𝟙 _) := by
      refine (Homotopy.ofEq ?_).trans ((P.mapHomotopy hcc').trans (Homotopy.ofEq ?_))
      · rw [CategoryTheory.Functor.map_comp]
      · rw [CategoryTheory.Functor.map_id]
    have hp'p : Homotopy ((P.mapHomologicalComplex (ComplexShape.up ℤ)).map c' ≫
        (P.mapHomologicalComplex (ComplexShape.up ℤ)).map c) (𝟙 _) := by
      refine (Homotopy.ofEq ?_).trans ((P.mapHomotopy hc'c).trans (Homotopy.ofEq ?_))
      · rw [CategoryTheory.Functor.map_comp]
      · rw [CategoryTheory.Functor.map_id]
    exact t_conjD G G' ν _ _ _ _ H₂ hpp hp'p

  have t_main : ∀ {𝒜 ℬ 𝒞 : Type _} [Category 𝒜] [Abelian 𝒜] [Category ℬ] [Abelian ℬ]
      [Category 𝒞] [Abelian 𝒞] [HasDerivedCategory 𝒞]
      (One : 𝒜) (P : 𝒜 ⥤ ℬ) [hP : P.Additive] (Pw : 𝒜 ⥤ 𝒜) [hPw : Pw.Additive]
      (γ : Pw ⋙ P ⟶ P)
      (u : One ⟶ Pw.obj One) (Φ Φ' : 𝒜 ⥤ 𝒜) [Φ.Additive] [Φ'.Additive]
      [Limits.PreservesFiniteLimits Φ] (adj : Φ ⊣ Pw) (adj' : Φ' ⊣ Pw)
      (G G' : ℬ ⥤ 𝒞) [G.Additive] [G'.Additive] (ν : G ≅ G')
      (I I' : InjectiveResolution One)
      (t : (Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex ⟶ I.cochainComplex)
      (t' : (Φ'.mapHomologicalComplex (ComplexShape.up ℤ)).obj I'.cochainComplex ⟶
        I'.cochainComplex),
      (Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι' ≫ t =
        (HomologicalComplex.singleMapHomologicalComplex Φ (ComplexShape.up ℤ) 0).hom.app One ≫
          (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map ((adj.homEquiv _ _).symm u) ≫
            I.ι' →
      (Φ'.mapHomologicalComplex (ComplexShape.up ℤ)).map I'.ι' ≫ t' =
        (HomologicalComplex.singleMapHomologicalComplex Φ' (ComplexShape.up ℤ) 0).hom.app One ≫
          (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map ((adj'.homEquiv _ _).symm u) ≫
            I'.ι' →
      ∀ (N : ℕ),
      N • (DerivedCategory.Q.map ((G'.mapHomologicalComplex (ComplexShape.up ℤ)).map
          (show (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I'.cochainComplex ⟶
            (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I'.cochainComplex from
          (P.mapHomologicalComplex (ComplexShape.up ℤ)).map
            ((Functor.mapHomologicalComplexIdIso _ (ComplexShape.up ℤ)).inv.app I'.cochainComplex ≫
              (NatTrans.mapHomologicalComplex (show 𝟭 _ ⟶ Φ' ⋙ Pw from adj'.unit)
                (ComplexShape.up ℤ)).app I'.cochainComplex ≫
              (Functor.mapHomologicalComplexCompIso (Iso.refl (Φ' ⋙ Pw))
                (ComplexShape.up ℤ)).inv.app I'.cochainComplex ≫
              (Pw.mapHomologicalComplex (ComplexShape.up ℤ)).map t') ≫
            (Functor.mapHomologicalComplexCompIso (Iso.refl (Pw ⋙ P))
              (ComplexShape.up ℤ)).hom.app I'.cochainComplex ≫
            (NatTrans.mapHomologicalComplex γ (ComplexShape.up ℤ)).app I'.cochainComplex)) -
          𝟙 _) = 0 →
      N • (DerivedCategory.Q.map ((G.mapHomologicalComplex (ComplexShape.up ℤ)).map
          (show (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex ⟶
            (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex from
          (P.mapHomologicalComplex (ComplexShape.up ℤ)).map
            ((Functor.mapHomologicalComplexIdIso _ (ComplexShape.up ℤ)).inv.app I.cochainComplex ≫
              (NatTrans.mapHomologicalComplex (show 𝟭 _ ⟶ Φ ⋙ Pw from adj.unit)
                (ComplexShape.up ℤ)).app I.cochainComplex ≫
              (Functor.mapHomologicalComplexCompIso (Iso.refl (Φ ⋙ Pw))
                (ComplexShape.up ℤ)).inv.app I.cochainComplex ≫
              (Pw.mapHomologicalComplex (ComplexShape.up ℤ)).map t) ≫
            (Functor.mapHomologicalComplexCompIso (Iso.refl (Pw ⋙ P))
              (ComplexShape.up ℤ)).hom.app I.cochainComplex ≫
            (NatTrans.mapHomologicalComplex γ (ComplexShape.up ℤ)).app I.cochainComplex)) -
          𝟙 _) = 0 := by
    intro 𝒜 ℬ 𝒞 _ _ _ _ _ _ _ One P _ Pw _ γ u Φ Φ' _ _ _ adj adj' G G' _ _ ν I I' t t' ht ht'
      N h0
    have hF := t_s2 Φ Pw adj One u I t ht
    have hF' := t_s2 Φ' Pw adj' One u I' t' ht'
    have hcE := (t_s1 I I'.cochainComplex).1 I'.ι'
    obtain ⟨c, hc⟩ := hcE
    obtain ⟨hc⟩ := hc
    have hc'E := (t_s1 I' I.cochainComplex).1 I.ι'
    obtain ⟨c', hc'⟩ := hc'E
    obtain ⟨hc'⟩ := hc'
    have hcc' : Homotopy (c ≫ c') (𝟙 _) := Classical.choice ((t_s1 I I.cochainComplex).2 _ _
      ⟨(Homotopy.ofEq (Category.assoc _ _ _).symm).trans ((hc.compRight c').trans
        (hc'.trans (Homotopy.ofEq (Category.comp_id _).symm)))⟩)
    have hc'c : Homotopy (c' ≫ c) (𝟙 _) := Classical.choice ((t_s1 I' I'.cochainComplex).2 _ _
      ⟨(Homotopy.ofEq (Category.assoc _ _ _).symm).trans ((hc'.compRight c).trans
        (hc.trans (Homotopy.ofEq (Category.comp_id _).symm)))⟩)
    haveI := t_s3 Φ Pw adj I'
    obtain ⟨e, he⟩ := t_s4 One P Pw γ u G G' ν I I' c c' hc hcc' hc'c
      ((t_s1 I ((Pw.mapHomologicalComplex (ComplexShape.up ℤ)).obj I'.cochainComplex)).2)
      _ _ hF hF'
    have conj : ∀ {X Y : DerivedCategory 𝒞} (a : X ⟶ X) (b : Y ⟶ Y) (χ : X ≅ Y),
        a ≫ χ.hom = χ.hom ≫ b → N • (b - 𝟙 Y) = 0 → N • (a - 𝟙 X) = 0 := by
      intro X Y a b χ h hb
      have hd : a - 𝟙 X = χ.hom ≫ (b - 𝟙 Y) ≫ χ.inv := by
        rw [Preadditive.sub_comp, Preadditive.comp_sub, Category.id_comp, Iso.hom_inv_id,
          ← reassoc_of% h, Iso.hom_inv_id, Category.comp_id]
      rw [hd, ← Preadditive.comp_nsmul, ← Preadditive.nsmul_comp, hb, Limits.zero_comp,
        Limits.comp_zero]
    exact conj _ _ e he h0

  have wc_et_zmod_ring_hom_ext : ∀ (Y : Scheme.{u}) (m : ℕ)
      (R : Sheaf (Scheme.smallEtaleTopology Y) RingCat.{u+1}) (φ ψ : wcEtZModRing Y m ⟶ R),
      φ = ψ := by
    intro Y m R φ ψ
    have key : ∀ (T : Type (u+1)) [Semiring T] (f g : ULift.{u+1} (ZMod m) →+* T), f = g := by
      intro T _ f g
      have h : f.comp (ULift.ringEquiv : ULift.{u+1} (ZMod m) ≃+* ZMod m).symm.toRingHom =
          g.comp (ULift.ringEquiv : ULift.{u+1} (ZMod m) ≃+* ZMod m).symm.toRingHom :=
        Subsingleton.elim _ _
      ext x
      exact RingHom.congr_fun h x.down
    apply ((sheafificationAdjunction (Scheme.smallEtaleTopology Y) RingCat.{u+1}).homEquiv _ R).injective
    apply NatTrans.ext
    funext U
    apply RingCat.hom_ext
    exact key _ _ _
  have key : ∀ D D' : wcEtxcDatum fX ξ σ ℓ k, D.VarNZ → D'.VarNZ := by
    intro D D' hD
    obtain ⟨σQ, hσQ1, hσQ2, Dh, Dg, I, DσQ, hφ, t, ht⟩ := D
    obtain ⟨σQ', hσQ1', hσQ2', Dh', Dg', I', DσQ', hφ', t', ht'⟩ := D'
    obtain rfl : σQ' = σQ :=
      Limits.pullback.hom_ext (hσQ1'.trans hσQ1.symm) (hσQ2'.trans hσQ2.symm)
    obtain ⟨ch, φh, Φh, adjh, addh, plh, pch, μh⟩ := Dh
    obtain ⟨ch', φh', Φh', adjh', addh', plh', pch', μh'⟩ := Dh'
    obtain rfl : ch' = ch := rfl
    obtain rfl : φh' = φh := wc_et_zmod_ring_hom_ext _ _ _ _ _
    obtain ⟨cg, φg, Φg, adjg, addg, plg, pcg, μg⟩ := Dg
    obtain ⟨cg', φg', Φg', adjg', addg', plg', pcg', μg'⟩ := Dg'
    obtain rfl : cg' = cg := rfl
    obtain rfl : φg' = φg := wc_et_zmod_ring_hom_ext _ _ _ _ _
    obtain ⟨cs, φs, Φs, adjs, adds, pls, pcs, μs⟩ := DσQ
    obtain ⟨cs', φs', Φs', adjs', adds', pls', pcs', μs'⟩ := DσQ'
    obtain rfl : cs' = cs := rfl
    obtain rfl : φs' = φs := wc_et_zmod_ring_hom_ext _ _ _ _ _
    letI := HasDerivedCategory.standard
      (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback fX (wcQmSp A)) (ℓ ^ k)))
    haveI := adds
    haveI := adds'
    haveI := pls
    haveI := addg
    haveI := addg'
    intro h0'
    apply hD
    exact t_main _ _ (hP := Adjunction.right_adjoint_additive adjh) _
      (hPw := Adjunction.right_adjoint_additive adjs) _ _ Φs Φs' adjs adjs' Φg Φg'
      (Adjunction.leftAdjointUniq adjg adjg') I I' t t' ht ht' _ h0'
  intro hD
  exact fun σQ' hσQ1' hσQ2' Dh' Dg' I' DσQ' hφ' t' ht' =>
    key D ⟨σQ', hσQ1', hσQ2', Dh', Dg', I', DσQ', hφ', t', ht'⟩ hD

theorem wc_et_tpl_excision_transport {A : Type u} [CommRing A] [IsLocalRing A] {X U : Scheme.{u}}
    (fX : X ⟶ Spec (.of A)) (j : U ⟶ X) (hj : Etale j) {Ω : Type u} [Field Ω]
    (ξ : Spec (.of Ω) ⟶ Spec (.of A)) (σ : Spec (.of Ω) ⟶ Spec (.of Ω)) (ℓ k : ℕ)
    (DX : wcEtxcDatum fX ξ σ ℓ k) :
    ∃ (DU : wcEtxcDatum (j ≫ fX) ξ σ ℓ k) (DjZ : wcEtPullData (wcEtxcJs fX j) (ℓ ^ k)),
      haveI := DjZ.additive
      ∃ χ : (DjZ.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj DX.Psi ≅ DU.Psi,
        (DjZ.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map DX.TPsi ≫ χ.hom = χ.hom ≫ DU.TPsi :=
by
  classical
  obtain ⟨σQ, hσQ1, hσQ2, Dh, Dg, I, DσQ, hφ, t, ht⟩ := DX
  haveI := Dh.cont
  haveI := DσQ.cont
  haveI : (wcEtBaseChange (Limits.pullback.fst fX ξ) ⋙ wcEtBaseChange σQ).IsContinuous
      (Scheme.smallEtaleTopology X) (Scheme.smallEtaleTopology (Limits.pullback fX ξ)) :=
    Functor.isContinuous_comp (wcEtBaseChange (Limits.pullback.fst fX ξ)) (wcEtBaseChange σQ)
      (Scheme.smallEtaleTopology X) (Scheme.smallEtaleTopology (Limits.pullback fX ξ))
      (Scheme.smallEtaleTopology (Limits.pullback fX ξ))
  let α : wcEtBaseChange (Limits.pullback.fst fX ξ) ⟶
      wcEtBaseChange (Limits.pullback.fst fX ξ) ⋙ wcEtBaseChange σQ :=
    letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u})
        (Limits.pullback.fst fX ξ) := ⟨fun _ _ => inferInstance⟩
    letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u})
        (Limits.pullback.fst fX ξ) :=
      (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
        (inferInstance : Pr.IsStableUnderBaseChangeAlong (Limits.pullback.fst fX ξ)))
        (@Etale : MorphismProperty Scheme.{u})
    letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) σQ :=
      ⟨fun _ _ => inferInstance⟩
    letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) σQ :=
      (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
        (inferInstance : Pr.IsStableUnderBaseChangeAlong σQ)) (@Etale : MorphismProperty Scheme.{u})
    (MorphismProperty.Over.pullbackComp (P := (@Etale : MorphismProperty Scheme.{u}))
      (Q := ⊤) σQ (Limits.pullback.fst fX ξ) (Limits.pullback.fst fX ξ) hσQ1.symm).hom
  haveI := Dh.additive
  haveI := DσQ.additive
  haveI := Dg.additive
  let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst fX ξ))
    _ _ Dh.cont Dh.φ
  haveI hPadd : P.Additive := Adjunction.right_adjoint_additive Dh.adj
  let Pw := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange σQ) _ _ DσQ.cont DσQ.φ
  haveI hPwadd : Pw.Additive := Adjunction.right_adjoint_additive DσQ.adj
  let γ : Pw ⋙ P ⟶ P := (SheafOfModules.pushforwardComp Dh.φ DσQ.φ).hom ≫
      SheafOfModules.pushforwardNatTrans _ α ≫ (SheafOfModules.pushforwardCongr hφ).hom
  let Tflat := (Functor.mapHomologicalComplexIdIso _ (ComplexShape.up ℤ)).inv.app I.cochainComplex ≫
      (NatTrans.mapHomologicalComplex (show 𝟭 _ ⟶ DσQ.Φ ⋙ Pw from DσQ.adj.unit)
        (ComplexShape.up ℤ)).app I.cochainComplex ≫
      (Functor.mapHomologicalComplexCompIso (Iso.refl (DσQ.Φ ⋙ Pw))
        (ComplexShape.up ℤ)).inv.app I.cochainComplex ≫
      (Pw.mapHomologicalComplex (ComplexShape.up ℤ)).map t
  let T : (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex ⟶
      (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex :=
    (P.mapHomologicalComplex (ComplexShape.up ℤ)).map Tflat ≫
      (Functor.mapHomologicalComplexCompIso (Iso.refl (Pw ⋙ P))
        (ComplexShape.up ℤ)).hom.app I.cochainComplex ≫
      (NatTrans.mapHomologicalComplex γ (ComplexShape.up ℤ)).app I.cochainComplex

  have hw1 : (Limits.pullback.fst (j ≫ fX) ξ ≫ j) ≫ fX = Limits.pullback.snd (j ≫ fX) ξ ≫ ξ := by
    rw [Category.assoc]; exact Limits.pullback.condition
  obtain ⟨j', hj'1, hj'2⟩ : ∃ j' : Limits.pullback (j ≫ fX) ξ ⟶ Limits.pullback fX ξ,
      j' ≫ Limits.pullback.fst fX ξ = Limits.pullback.fst (j ≫ fX) ξ ≫ j ∧
      j' ≫ Limits.pullback.snd fX ξ = Limits.pullback.snd (j ≫ fX) ξ :=
    ⟨Limits.pullback.lift _ _ hw1, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hpb : IsPullback j' (Limits.pullback.fst (j ≫ fX) ξ) (Limits.pullback.fst fX ξ) j := by
    have hout : IsPullback (j' ≫ Limits.pullback.snd fX ξ) (Limits.pullback.fst (j ≫ fX) ξ) ξ
        (j ≫ fX) := by
      rw [hj'2]; exact (IsPullback.of_hasPullback (j ≫ fX) ξ).flip
    exact IsPullback.of_right hout hj'1 (IsPullback.of_hasPullback fX ξ).flip
  have hj' : Etale j' := MorphismProperty.of_isPullback (P := @Etale) hpb.flip hj
  have hw2 : (j' ≫ σQ) ≫ Limits.pullback.fst fX ξ = Limits.pullback.fst (j ≫ fX) ξ ≫ j := by
    rw [Category.assoc, hσQ1, hj'1]
  obtain ⟨σQU, hσQj, hσQ1U⟩ : ∃ σQU : Limits.pullback (j ≫ fX) ξ ⟶ Limits.pullback (j ≫ fX) ξ,
      σQU ≫ j' = j' ≫ σQ ∧
      σQU ≫ Limits.pullback.fst (j ≫ fX) ξ = Limits.pullback.fst (j ≫ fX) ξ :=
    ⟨hpb.lift (j' ≫ σQ) (Limits.pullback.fst (j ≫ fX) ξ) hw2, hpb.lift_fst _ _ _,
      hpb.lift_snd _ _ _⟩
  have hσQ2U : σQU ≫ Limits.pullback.snd (j ≫ fX) ξ = Limits.pullback.snd (j ≫ fX) ξ ≫ σ := by
    calc σQU ≫ Limits.pullback.snd (j ≫ fX) ξ = σQU ≫ j' ≫ Limits.pullback.snd fX ξ := by
          rw [hj'2]
      _ = j' ≫ σQ ≫ Limits.pullback.snd fX ξ := by
          rw [← Category.assoc, hσQj, Category.assoc]
      _ = Limits.pullback.snd (j ≫ fX) ξ ≫ σ := by
          rw [hσQ2, ← Category.assoc, hj'2]
  have hs : IsPullback j' (σQU ≫ Limits.pullback.fst (j ≫ fX) ξ)
      (σQ ≫ Limits.pullback.fst fX ξ) j := by
    rw [hσQ1U, hσQ1]; exact hpb
  have hpbw : IsPullback j' σQU σQ j' := IsPullback.of_bot hs hσQj.symm hpb
  have hjs : wcEtxcJs fX j ≫ Limits.pullback.fst fX (wcQmSp A) =
      Limits.pullback.fst (j ≫ fX) (wcQmSp A) ≫ j := by
    unfold wcEtxcJs
    exact Limits.pullback.lift_fst _ _ _

  obtain ⟨DhU⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.fst (j ≫ fX) ξ) (ℓ ^ k)
  obtain ⟨DgU⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.fst (j ≫ fX) (wcQmSp A)) (ℓ ^ k)
  obtain ⟨DσQU⟩ := wc_et_zmod_pull_data_exists σQU (ℓ ^ k)
  obtain ⟨DjZ⟩ := wc_et_zmod_pull_data_exists (wcEtxcJs fX j) (ℓ ^ k)
  obtain ⟨Dk⟩ := wc_et_zmod_pull_data_exists
    (Limits.pullback.fst (j ≫ fX) (wcQmSp A) ≫ j) (ℓ ^ k)
  obtain ⟨Dj⟩ : Nonempty (wcEtPullData (S := X)
      (S' := (MorphismProperty.Over.mk ⊤ j hj : X.Etale).left)
      (MorphismProperty.Over.mk ⊤ j hj : X.Etale).hom (ℓ ^ k)) :=
    wc_et_zmod_pull_data_exists _ _
  obtain ⟨Dj'⟩ : Nonempty (wcEtPullData (S := Limits.pullback fX ξ)
      (S' := (MorphismProperty.Over.mk ⊤ j' hj' : (Limits.pullback fX ξ).Etale).left)
      (MorphismProperty.Over.mk ⊤ j' hj' : (Limits.pullback fX ξ).Etale).hom (ℓ ^ k)) :=
    wc_et_zmod_pull_data_exists _ _
  haveI := DhU.cont
  haveI := DσQU.cont
  haveI := DhU.additive
  haveI := DσQU.additive
  haveI := DgU.additive
  haveI := DjZ.additive
  haveI := DjZ.presLim
  haveI := DjZ.presColim

  obtain ⟨hcj, hccj⟩ := wc_et_slice_continuous (MorphismProperty.Over.mk ⊤ j hj : X.Etale)
  obtain ⟨hcj', hccj'⟩ := wc_et_slice_continuous
    (MorphismProperty.Over.mk ⊤ j' hj' : (Limits.pullback fX ξ).Etale)
  haveI := hcj
  haveI := hccj
  haveI := hcj'
  haveI := hccj'
  obtain ⟨ψ, ⟨σj⟩⟩ := wc_et_etale_pull_restrict_iso
    (MorphismProperty.Over.mk ⊤ j hj : X.Etale) (ℓ ^ k) Dj
  obtain ⟨ψ', -⟩ := wc_et_etale_pull_restrict_iso
    (MorphismProperty.Over.mk ⊤ j' hj' : (Limits.pullback fX ξ).Etale) (ℓ ^ k) Dj'
  obtain ⟨ρ, hρ⟩ : ∃ ρ : SheafOfModules.{u+1} (wcEtZModRing X (ℓ ^ k)) ⥤
      SheafOfModules.{u+1} (wcEtZModRing U (ℓ ^ k)),
      ρ = @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
        (wcEtSlice (MorphismProperty.Over.mk ⊤ j hj : X.Etale)) _ _ hcj ψ := ⟨_, rfl⟩
  obtain ⟨ρ', hρ'⟩ : ∃ ρ' : SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback fX ξ) (ℓ ^ k)) ⥤
      SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (j ≫ fX) ξ) (ℓ ^ k)),
      ρ' = @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
        (wcEtSlice (MorphismProperty.Over.mk ⊤ j' hj' : (Limits.pullback fX ξ).Etale)) _ _ hcj' ψ' :=
    ⟨_, rfl⟩
  obtain ⟨hρadd, -, -⟩ : ρ.Additive ∧ Limits.PreservesFiniteLimits ρ ∧
      Limits.PreservesFiniteColimits ρ := by
    rw [hρ]; exact wc_et_slice_module_restrict_exact
      (MorphismProperty.Over.mk ⊤ j hj : X.Etale) (ℓ ^ k) ψ
  obtain ⟨hρ'add, hρ'lim, hρ'colim⟩ : ρ'.Additive ∧ Limits.PreservesFiniteLimits ρ' ∧
      Limits.PreservesFiniteColimits ρ' := by
    rw [hρ']; exact wc_et_slice_module_restrict_exact
      (MorphismProperty.Over.mk ⊤ j' hj' : (Limits.pullback fX ξ).Etale) (ℓ ^ k) ψ'
  let PU := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
    (wcEtBaseChange (Limits.pullback.fst (j ≫ fX) ξ)) _ _ DhU.cont DhU.φ
  let PwU := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange σQU) _ _ DσQU.cont DσQU.φ
  haveI hPUadd : PU.Additive := Adjunction.right_adjoint_additive DhU.adj
  haveI hPwUadd : PwU.Additive := Adjunction.right_adjoint_additive DσQU.adj

  obtain ⟨β, βw, μ', hBC4, hBC6'⟩ := wc_et_tpl_slice_push_bc hσQ1 j hj j' hj'
    (Limits.pullback.fst (j ≫ fX) ξ) hpb σQU hσQ1U hσQj hpbw Dh DσQ DhU DσQU
    hcj hccj hcj' hccj' ψ ψ' ρ hρ ρ' hρ' hφ (wc_et_zmod_ring_hom_ext _ _ _ _ _)

  obtain ⟨α', hBC3, hBC6⟩ := wc_pltr_abs_mate DσQ.adj DσQU.adj ρ' βw _ _ μ' _ _ hBC6'

  obtain ⟨IU, θ, hθ⟩ := wc_pltr_exact_injres ρ'
    (fun J hJ => by
      haveI := hJ
      rw [hρ']
      exact wc_et_slice_restrict_preserves_injective
        (MorphismProperty.Over.mk ⊤ j' hj' : (Limits.pullback fX ξ).Etale) (ℓ ^ k) ψ' J)
    _ _ μ' I

  let tU : (DσQU.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj IU.cochainComplex ⟶
      IU.cochainComplex :=
    (DσQU.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map θ.inv ≫
      (Functor.mapHomologicalComplexCompIso (Iso.refl (ρ' ⋙ DσQU.Φ))
        (ComplexShape.up ℤ)).hom.app I.cochainComplex ≫
      (NatTrans.mapHomologicalComplex α' (ComplexShape.up ℤ)).app I.cochainComplex ≫
      (Functor.mapHomologicalComplexCompIso (Iso.refl (DσQ.Φ ⋙ ρ'))
        (ComplexShape.up ℤ)).inv.app I.cochainComplex ≫
      (ρ'.mapHomologicalComplex (ComplexShape.up ℤ)).map t ≫ θ.hom
  have hLPU := wc_pltr_abs_lift DσQ.Φ DσQU.Φ ρ' α' _ _ μ' _ _ hBC6 I.cochainComplex I.ι'
    IU.cochainComplex IU.ι' θ hθ t ht tU rfl

  let δ : Dg.Φ ⋙ DjZ.Φ ≅ ρ ⋙ DgU.Φ :=
    (wc_et_pull_data_comp_iso (Limits.pullback.fst fX (wcQmSp A)) (wcEtxcJs fX j)
        (Limits.pullback.fst (j ≫ fX) (wcQmSp A) ≫ j) hjs Dg DjZ Dk).some.symm ≪≫
      (wc_et_pull_data_comp_iso (MorphismProperty.Over.mk ⊤ j hj : X.Etale).hom
        (Limits.pullback.fst (j ≫ fX) (wcQmSp A))
        (Limits.pullback.fst (j ≫ fX) (wcQmSp A) ≫ j) rfl Dj DgU Dk).some ≪≫
      Functor.isoWhiskerRight (σj ≪≫ eqToIso hρ.symm) DgU.Φ

  obtain ⟨χ, hχ⟩ := wc_pltr_abs_conj P Pw DσQ.Φ Dg.Φ DσQ.adj γ PU PwU DσQU.Φ DgU.Φ DσQU.adj _
    ρ' ρ DjZ.Φ β βw α' δ hBC3 hBC4 I.cochainComplex IU.cochainComplex θ t tU rfl T rfl _ rfl

  exact ⟨⟨σQU, hσQ1U, hσQ2U, DhU, DgU, IU, DσQU, wc_et_zmod_ring_hom_ext _ _ _ _ _, tU, hLPU⟩,
    DjZ, χ, hχ⟩

theorem wc_dcat_kill_through_cone_ge {C₁ C₂ : Type*} [Category C₁] [Category C₂] [Abelian C₁]
    [Abelian C₂] [HasDerivedCategory C₁] [HasDerivedCategory C₂] (ρ : C₁ ⥤ C₂) [ρ.Additive]
    [Limits.PreservesFiniteLimits ρ] [Limits.PreservesFiniteColimits ρ] (One : C₁)
    (Ψ : CochainComplex C₁ ℤ) [Ψ.IsStrictlyGE 0]
    (eΨ : (HomologicalComplex.single C₁ (ComplexShape.up ℤ) 0).obj One ⟶ Ψ)
    (W : DerivedCategory.Q.obj (CochainComplex.mappingCone eΨ) ⟶ DerivedCategory.Q.obj Ψ) :
    ρ.mapDerivedCategory.map (DerivedCategory.Q.map (CochainComplex.mappingCone.inr eΨ) ≫ W) = 0 →
      ρ.mapDerivedCategory.map W = 0 :=
by
  intro h
  have hT := ρ.mapDerivedCategory.map_distinguished _
    (DerivedCategory.mappingCone_triangle_distinguished eΨ)
  have h2 : (ρ.mapDerivedCategory.mapTriangle.obj (DerivedCategory.Q.mapTriangle.obj
      (CochainComplex.mappingCone.triangle eΨ))).mor₂ ≫ ρ.mapDerivedCategory.map W = 0 := by
    rw [Functor.map_comp] at h
    exact h
  obtain ⟨g, hg⟩ := Pretriangulated.Triangle.yoneda_exact₃ _ hT _ h2
  have hLE : DerivedCategory.TStructure.t.IsLE ((shiftFunctor (DerivedCategory C₂) (1 : ℤ)).obj
      (ρ.mapDerivedCategory.obj (DerivedCategory.Q.obj
        ((HomologicalComplex.single C₁ (ComplexShape.up ℤ) 0).obj One)))) (-1) := by
    let e : ρ.mapDerivedCategory.obj (DerivedCategory.Q.obj
        ((HomologicalComplex.single C₁ (ComplexShape.up ℤ) 0).obj One)) ≅
        DerivedCategory.Q.obj ((HomologicalComplex.single C₂ (ComplexShape.up ℤ) 0).obj (ρ.obj One)) :=
      ρ.mapDerivedCategoryFactors.app _ ≪≫
        DerivedCategory.Q.mapIso ((HomologicalComplex.singleMapHomologicalComplex ρ
          (ComplexShape.up ℤ) 0).app One)
    have : DerivedCategory.TStructure.t.IsLE (ρ.mapDerivedCategory.obj (DerivedCategory.Q.obj
        ((HomologicalComplex.single C₁ (ComplexShape.up ℤ) 0).obj One))) 0 :=
      DerivedCategory.TStructure.t.isLE_of_iso e.symm 0
    exact DerivedCategory.TStructure.t.isLE_shift _ 0 1 (-1)
  have hGE : DerivedCategory.TStructure.t.IsGE (ρ.mapDerivedCategory.obj
      (DerivedCategory.Q.obj Ψ)) 0 := by
    have : CochainComplex.IsStrictlyGE ((ρ.mapHomologicalComplex (ComplexShape.up ℤ)).obj Ψ) 0 := by
      rw [CochainComplex.isStrictlyGE_iff]
      intro i hi
      exact ρ.map_isZero ((CochainComplex.isStrictlyGE_iff Ψ 0).mp inferInstance i hi)
    have h3 : DerivedCategory.TStructure.t.IsGE
        ((ρ.mapHomologicalComplex (ComplexShape.up ℤ) ⋙ DerivedCategory.Q).obj Ψ) 0 :=
      (inferInstance : DerivedCategory.TStructure.t.IsGE
        (DerivedCategory.Q.obj ((ρ.mapHomologicalComplex (ComplexShape.up ℤ)).obj Ψ)) 0)
    exact DerivedCategory.TStructure.t.isGE_of_iso (ρ.mapDerivedCategoryFactors.app Ψ).symm 0
  have hLE' : DerivedCategory.TStructure.t.IsLE ((shiftFunctor (DerivedCategory C₂) (1 : ℤ)).obj
      (ρ.mapDerivedCategory.mapTriangle.obj (DerivedCategory.Q.mapTriangle.obj
        (CochainComplex.mappingCone.triangle eΨ))).obj₁) (-1) := hLE
  have hg0 : g = 0 := DerivedCategory.TStructure.t.zero g (-1) 0 (by norm_num)
  exact hg.trans (by rw [hg0]; exact Limits.comp_zero)

theorem wc_dcat_faithful_of_counit_iso {C₁ C₂ : Type*} [Category C₁] [Category C₂] [Abelian C₁]
    [Abelian C₂] [HasDerivedCategory C₁] [HasDerivedCategory C₂] (ρ : C₁ ⥤ C₂) (L : C₂ ⥤ C₁)
    [ρ.Additive] [Limits.PreservesFiniteLimits ρ] [Limits.PreservesFiniteColimits ρ]
    [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L]
    (adj : L ⊣ ρ) (K : CochainComplex C₁ ℤ) :
    (∀ q : ℤ, IsIso (adj.counit.app (K.homology q))) →
      ∀ (Y : DerivedCategory C₁) (f : DerivedCategory.Q.obj K ⟶ Y),
        ρ.mapDerivedCategory.map f = 0 → f = 0 :=
by
  intro hK Y f hf
  let e := DerivedCategory.Q.objObjPreimageIso Y
  obtain ⟨M, g, s, hs, hfac⟩ := DerivedCategory.left_fac (f ≫ e.inv)
  have hfu : f ≫ e.inv ≫ DerivedCategory.Q.map s = DerivedCategory.Q.map g := by
    rw [← Category.assoc, hfac, Category.assoc, IsIso.inv_hom_id, Category.comp_id]
  have hρg : ρ.mapDerivedCategory.map (DerivedCategory.Q.map g) = 0 := by
    rw [← hfu, Functor.map_comp, hf, Limits.zero_comp]
  have hρCg : DerivedCategory.Q.map ((ρ.mapHomologicalComplex (ComplexShape.up ℤ)).map g) = 0 := by
    have h := ρ.mapDerivedCategoryFactors_hom_naturality g
    rw [hρg, Limits.zero_comp] at h
    exact (Preadditive.IsIso.comp_left_eq_zero _ _).mp h.symm
  have hLCg : DerivedCategory.Q.map ((L.mapHomologicalComplex (ComplexShape.up ℤ)).map
      ((ρ.mapHomologicalComplex (ComplexShape.up ℤ)).map g)) = 0 := by
    have h := L.mapDerivedCategoryFactors_hom_naturality
      ((ρ.mapHomologicalComplex (ComplexShape.up ℤ)).map g)
    rw [hρCg, Functor.map_zero, Limits.zero_comp] at h
    exact (Preadditive.IsIso.comp_left_eq_zero _ _).mp h.symm
  let φ : ∀ Z : CochainComplex C₁ ℤ, (L.mapHomologicalComplex (ComplexShape.up ℤ)).obj
      ((ρ.mapHomologicalComplex (ComplexShape.up ℤ)).obj Z) ⟶ Z := fun Z =>
    { f := fun n => adj.counit.app (Z.X n)
      comm' := fun i j _ => (adj.counit_naturality (Z.d i j)).symm }
  have hnat : (L.mapHomologicalComplex (ComplexShape.up ℤ)).map
      ((ρ.mapHomologicalComplex (ComplexShape.up ℤ)).map g) ≫ φ M = φ K ≫ g := by
    ext n
    exact adj.counit_naturality (g.f n)
  have hq : QuasiIso (φ K) := by
    rw [quasiIso_iff]
    intro q
    rw [quasiIsoAt_iff_isIso_homologyMap]
    have h2 : IsIso (ShortComplex.homologyMap ((K.sc q).mapNatTrans adj.counit)) := by
      rw [ShortComplex.homologyMap_mapNatTrans]
      have : IsIso (adj.counit.app (K.sc q).homology) := hK q
      infer_instance
    have e1 : (HomologicalComplex.shortComplexFunctor C₁ (ComplexShape.up ℤ) q).map (φ K) =
        (K.sc q).mapNatTrans adj.counit := by
      ext <;> rfl
    change IsIso (ShortComplex.homologyMap
      ((HomologicalComplex.shortComplexFunctor C₁ (ComplexShape.up ℤ) q).map (φ K)))
    rw [e1]
    exact h2
  have hQφg : DerivedCategory.Q.map (φ K) ≫ DerivedCategory.Q.map g = 0 := by
    rw [← Functor.map_comp, ← hnat, Functor.map_comp, hLCg, Limits.zero_comp]
  have hQg : DerivedCategory.Q.map g = 0 := (Preadditive.IsIso.comp_left_eq_zero _ _).mp hQφg
  have h0 : f ≫ (e.inv ≫ DerivedCategory.Q.map s) = 0 := by rw [hfu, hQg]
  exact (Preadditive.IsIso.comp_right_eq_zero _ _).mp h0

theorem wc_et_etale_slice_exact_left_adjoint : ∀ {X : Scheme.{u}} (T : X.Etale) (n : ℕ)
    (E : wcEtPullData T.hom n),
    ∃ (L : SheafOfModules.{u+1} (wcEtZModRing T.left n) ⥤ SheafOfModules.{u+1} (wcEtZModRing X n))
      (_ : L ⊣ E.Φ), L.Additive ∧ Limits.PreservesFiniteLimits L ∧ Limits.PreservesFiniteColimits L :=
by
  intro X T n E
  obtain ⟨hc, -⟩ := wc_et_slice_continuous T
  haveI hc' : (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left)
      (Scheme.smallEtaleTopology X) := hc
  haveI := wc_et_slice_lan_finite_limits T
  obtain ⟨ψ, ⟨θ⟩⟩ := wc_et_etale_pull_restrict_iso T n E
  let Lab := (wcEtSlice T).sheafPullback AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology T.left)
    (Scheme.smallEtaleTopology X)
  let adjab : Lab ⊣ (wcEtSlice T).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X) :=
    (wcEtSlice T).sheafAdjunctionContinuous AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology T.left)
      (Scheme.smallEtaleTopology X)
  haveI pflab : Limits.PreservesFiniteLimits Lab :=
    Functor.sheafPullbackConstruction.preservesFiniteLimits (wcEtSlice T) AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)
  let tX := SheafOfModules.toSheaf.{u+1} (wcEtZModRing X n)
  let tU := SheafOfModules.toSheaf.{u+1} (wcEtZModRing T.left n)
  let P := (wcEtSlice T).sheafPushforwardContinuous AddCommGrpCat.{u+1}
    (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)
  obtain ⟨αX, hiX, hsX, -⟩ := wc_et_zmod_ring_locbij X n
  obtain ⟨hFullX, hessX⟩ := sheafOfModules_toSheaf_torsion_equiv (Scheme.smallEtaleTopology X)
    (wcEtZModRing X n) n αX hiX hsX
  obtain ⟨αU, hiU, hsU, hnU⟩ := wc_et_zmod_ring_locbij T.left n
  obtain ⟨hFullU, -⟩ := sheafOfModules_toSheaf_torsion_equiv
    (Scheme.smallEtaleTopology T.left) (wcEtZModRing T.left n) n αU hiU hsU
  haveI := hFullX
  haveI := hFullU
  haveI : Lab.IsLeftAdjoint := adjab.isLeftAdjoint
  haveI : Lab.Additive := Functor.additive_of_preserves_binary_products Lab
  let comm2 : tX ⋙ P ≅ E.Φ ⋙ tU :=
    NatIso.ofComponents (fun M => tU.mapIso (θ.app M).symm) (fun {M N} f => by
      have h := congrArg tU.map (θ.inv.naturality f)
      rw [tU.map_comp, tU.map_comp] at h
      exact h)
  have htorsU : ∀ A : SheafOfModules.{u+1} (wcEtZModRing T.left n),
      n • 𝟙 (tU.obj A) = 0 := by
    intro A
    have hx : ∀ (k : ℕ) (W : (T.left.Etale)ᵒᵖ) (x : (tU.obj A).obj.obj W),
        ((((k + 1) • 𝟙 (tU.obj A)).hom.app W).hom x) = (k + 1) • x := by
      intro k W x
      induction k with
      | zero => simp
      | succ k ih =>
        rw [succ_nsmul, Sheaf.Hom.add_app, AddCommGrpCat.hom_add, AddMonoidHom.add_apply, ih,
          succ_nsmul (n := k + 1)]
        simp
    have hn0 : ∀ (W : (T.left.Etale)ᵒᵖ) (x : (tU.obj A).obj.obj W), n • x = 0 := by
      intro W x
      let y : A.val.obj W := x
      have h1 : ((n : ↑((wcEtZModRing T.left n).obj.obj W)) • y) = n • y :=
        Nat.cast_smul_eq_nsmul _ n y
      rw [hnU W, zero_smul] at h1
      exact h1.symm
    have hff : n • 𝟙 (tU.obj A) + 𝟙 (tU.obj A) = 𝟙 (tU.obj A) := by
      rw [← succ_nsmul]
      apply Sheaf.hom_ext
      ext W x
      rw [hx, succ_nsmul, hn0, zero_add]
      all_goals first | rfl | simp
    exact add_eq_right.mp hff
  have hess : ∀ A : SheafOfModules.{u+1} (wcEtZModRing T.left n),
      tX.essImage (Lab.obj (tU.obj A)) := by
    intro A
    apply hessX
    rw [← Lab.map_id, ← Functor.map_nsmul, htorsU, Functor.map_zero]
  let hffU := Functor.FullyFaithful.ofFullyFaithful tU
  let hffX := Functor.FullyFaithful.ofFullyFaithful tX
  let L := Functor.essImage.liftFunctor (tU ⋙ Lab) tX hess
  let comm1 : tU ⋙ Lab ≅ L ⋙ tX := (Functor.essImage.liftFunctorCompIso (tU ⋙ Lab) tX hess).symm
  let adj : L ⊣ E.Φ := adjab.restrictFullyFaithful hffU hffX comm1 comm2
  haveI := E.additive
  refine ⟨L, adj, Adjunction.left_adjoint_additive adj, ?_, ?_⟩
  · haveI : Limits.PreservesFiniteLimits (tU ⋙ Lab) := Limits.comp_preservesFiniteLimits _ _
    haveI : Limits.PreservesFiniteLimits (L ⋙ tX) := Limits.preservesFiniteLimits_of_natIso comm1
    exact Limits.preservesFiniteLimits_of_reflects_of_preserves L tX
  · haveI : Limits.PreservesColimitsOfSize.{0, 0} L := adj.leftAdjoint_preservesColimits
    infer_instance

theorem wc_et_point_supp_counit_isIso : ∀ {K : Type u} [Field K] {X : Scheme.{u}}
    (x₀ : Spec (.of K) ⟶ X) [IsClosedImmersion x₀] (T : X.Etale) (v₀ : Spec (.of K) ⟶ T.left),
    IsPullback (𝟙 (Spec (.of K))) v₀ x₀ T.hom →
    ∀ (n : ℕ) (E : wcEtPullData T.hom n)
      (L : SheafOfModules.{u+1} (wcEtZModRing T.left n) ⥤ SheafOfModules.{u+1} (wcEtZModRing X n))
      (adj : L ⊣ E.Φ) (N : SheafOfModules.{u+1} (wcEtZModRing X n)),
      (∀ W : X.Etale, (∀ w : W.left, W.hom w ∉ Set.range x₀) →
        Subsingleton ↑(N.val.obj (Opposite.op W))) →
      IsIso (adj.counit.app N) :=
by
  intro K _ X x₀ _ T v₀ hpb n E L adj N hsupp
  haveI hc := (wc_et_slice_continuous T).1
  obtain ⟨ψ, ⟨α⟩⟩ := wc_et_etale_pull_restrict_iso T n E
  have hv : v₀ ≫ T.hom = x₀ := by
    have h := hpb.toCommSq.w
    rw [Category.id_comp] at h
    exact h.symm
  have hcov := wc_et_point_two_piece_cover T x₀ v₀ hv
  have hagree := wc_et_point_lifts_agree_locally T x₀ v₀ hpb

  have hR : ∀ Y : SheafOfModules.{u+1} (wcEtZModRing X n),
      Function.Bijective (fun f : N ⟶ Y => (SheafOfModules.pushforward.{u+1} ψ).map f) :=
    fun Y => ⟨wc_et_supp_restrict_hom_injective T n ψ (Set.range x₀) N Y hsupp hcov,
      wc_et_supp_restrict_hom_surjective T n ψ (Set.range x₀) N Y hsupp hcov hagree⟩

  have hΦ : ∀ Y : SheafOfModules.{u+1} (wcEtZModRing X n),
      Function.Bijective (fun f : N ⟶ Y => E.Φ.map f) := by
    intro Y
    have hstar : ∀ f : N ⟶ Y,
        E.Φ.map f = α.hom.app N ≫ (SheafOfModules.pushforward.{u+1} ψ).map f ≫ α.inv.app Y := by
      intro f
      rw [← Category.assoc, ← α.hom.naturality f, Category.assoc, Iso.hom_inv_id_app,
        Category.comp_id]
    constructor
    · intro f g hfg
      apply (hR Y).1
      have h1 := congrArg (fun h => α.inv.app N ≫ h ≫ α.hom.app Y) hfg
      simp only [hstar, Category.assoc, Iso.hom_inv_id_app, Iso.inv_hom_id_app_assoc,
        Iso.inv_hom_id_app, Category.comp_id] at h1
      exact h1
    · intro h
      obtain ⟨f, hf⟩ := (hR Y).2 (α.inv.app N ≫ h ≫ α.hom.app Y)
      refine ⟨f, ?_⟩
      show E.Φ.map f = h
      rw [hstar f]
      have hf' : (SheafOfModules.pushforward.{u+1} ψ).map f = α.inv.app N ≫ h ≫ α.hom.app Y := hf
      rw [hf']
      simp only [Category.assoc, Iso.hom_inv_id_app, Iso.hom_inv_id_app_assoc, Category.comp_id]

  apply isIso_of_coyoneda_map_bijective
  intro Y
  have heq : (fun f : N ⟶ Y => adj.counit.app N ≫ f) =
      (adj.homEquiv (E.Φ.obj N) Y).symm ∘ (fun f : N ⟶ Y => E.Φ.map f) := by
    funext f
    simp only [Function.comp_apply, Adjunction.homEquiv_counit]
    exact (adj.counit.naturality f).symm
  have hb := (Equiv.bijective (adj.homEquiv (E.Φ.obj N) Y).symm).comp (hΦ Y)
  rw [← heq] at hb
  exact hb

theorem wc_et_module_sections_subsingleton_of_stalks : ∀ {B : Scheme.{u}} (m : ℕ)
