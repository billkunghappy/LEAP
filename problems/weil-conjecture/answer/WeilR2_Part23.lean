    simp only [Scheme.Hom.comp_appTop (sE ≫ q),
      Scheme.Hom.comp_appTop wE, CommRingCat.hom_comp, RingHom.comp_apply] at h
    rw [h, s0]
  refine ⟨fun κ hκ1 hκ2 a => ?_, fun Ξ hΞ1 hΞ2 a => ?_⟩
  · apply s1
    · rw [Category.assoc, hκ1, hsc1, hsc1]
    · intro m k c
      have hm : (sc a ≫ κ) ≫ Limits.pullback.snd sE T.πi ≫ T.gi =
