        β.comp (AdjoinRoot.of (Polynomial.X ^ (ℓ ^ k) - Polynomial.C ((1 : L) ⊗ₜ[A] ρ
            (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
              (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) : TensorProduct A L R))) =
          AdjoinRoot.of (Polynomial.X ^ (ℓ ^ (k + 1)) - Polynomial.C ((1 : L) ⊗ₜ[A] ρ
            (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
              (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) : TensorProduct A L R)) →
        β (AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) - Polynomial.C ((1 : L) ⊗ₜ[A] ρ
            (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
              (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) : TensorProduct A L R))) =
          (@AdjoinRoot.root (TensorProduct A L R) _ (Polynomial.X ^ (ℓ ^ (k + 1)) - Polynomial.C ((1 : L) ⊗ₜ[A] ρ
            (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
              (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) : TensorProduct A L R))) ^ ℓ →
        ∀ (E : wcEtPullData (Spec.map (CommRingCat.ofHom β)) ℓ)
          (x : wcEtZModExt (Spec (.of (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C ((1 : L) ⊗ₜ[A] ρ
            (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
              (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) : TensorProduct A L R))))) ℓ 1),
          wcEtPull E 1 x = 0 :=
by
  intro A _ _ _ _ _ ℓ _ hℓ π hπ r R _ _ _ ρ hWE h0 h1 L _ _ φA hφA k
  have hℓL : IsUnit ((ℓ : ℕ) : L) := by
    have h := hℓ.map φA
    rwa [map_natCast] at h
  have hℓ0 : ℓ ≠ 0 := (Fact.out : ℓ.Prime).ne_zero
  have generic : ∀ (M : Type u) [CommRing M] (ι : L →+* M) (xM : M),
      Nat.card (wcEtZModExt (Spec (.of (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C xM)))) ℓ 1)
        = ℓ →
      IsUnit xM → IsUnit ((ℓ : ℕ) : M) →
      ConnectedSpace (PrimeSpectrum (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C xM))) →
      ConnectedSpace (PrimeSpectrum (AdjoinRoot (Polynomial.X ^ (ℓ ^ (k + 1)) - Polynomial.C xM))) →
      ∀ (β : AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C xM) →+*
          AdjoinRoot (Polynomial.X ^ (ℓ ^ (k + 1)) - Polynomial.C xM)),
      β (AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) - Polynomial.C xM)) =
          (AdjoinRoot.root (Polynomial.X ^ (ℓ ^ (k + 1)) - Polynomial.C xM)) ^ ℓ →
      ∀ (E : wcEtPullData (Spec.map (CommRingCat.ofHom β)) ℓ)
        (x : wcEtZModExt (Spec (.of (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C xM)))) ℓ 1),
        wcEtPull E 1 x = 0 := by
    intro M _ ι xM hcard hx hℓM hc0 hc1 β hβ2 E x
    have hrootpow : AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) - Polynomial.C xM) ^ (ℓ ^ k) =
        AdjoinRoot.of (Polynomial.X ^ (ℓ ^ k) - Polynomial.C xM) xM := by
      have h := AdjoinRoot.eval₂_root (Polynomial.X ^ (ℓ ^ k) - Polynomial.C xM)
      rwa [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, sub_eq_zero] at h
    have hroot : IsUnit (AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) - Polynomial.C xM)) := by
      have h2 : IsUnit (AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) - Polynomial.C xM) ^ (ℓ ^ k)) := by
        rw [hrootpow]; exact hx.map _
      exact (isUnit_pow_iff (pow_ne_zero k hℓ0)).mp h2
    have hnp := wc_qmtm_h1k_root_not_pow M ℓ Fact.out hℓM k xM hc0 hc1 hroot
    haveI : NeZero ((ℓ : ℕ) : L) := ⟨hℓL.ne_zero⟩
    haveI := IsSepClosed.hasEnoughRootsOfUnity L ℓ
    obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot L ℓ
    have hv₀ : IsUnit ((Scheme.ΓSpecIso (.of (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) -
        Polynomial.C xM)))).inv.hom (AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) - Polynomial.C xM))) :=
      hroot.map _
    have hnat : ((CommRingCat.ofHom β) ≫ (Scheme.ΓSpecIso (.of (AdjoinRoot (Polynomial.X ^ (ℓ ^ (k + 1)) -
        Polynomial.C xM)))).inv).hom (AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) - Polynomial.C xM)) =
        ((Scheme.ΓSpecIso (.of (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C xM)))).inv ≫
          (Spec.map (CommRingCat.ofHom β)).appTop).hom
          (AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) - Polynomial.C xM)) := by
      rw [Scheme.ΓSpecIso_inv_naturality]
    rw [CommRingCat.hom_comp, CommRingCat.hom_comp, RingHom.comp_apply, RingHom.comp_apply,
      CommRingCat.hom_ofHom, hβ2, map_pow] at hnat
    have hw : ((Scheme.ΓSpecIso (.of (AdjoinRoot (Polynomial.X ^ (ℓ ^ (k + 1)) -
        Polynomial.C xM)))).inv.hom (AdjoinRoot.root (Polynomial.X ^ (ℓ ^ (k + 1)) - Polynomial.C xM))) ^ ℓ =
        (Spec.map (CommRingCat.ofHom β)).appTop.hom (hv₀.unit : _) := by
      rw [IsUnit.unit_spec]; exact hnat
    obtain ⟨κ, hκ0, hκkill⟩ := wc_qmtm_h1k_kummer_kill L _ _
      (Spec.map (CommRingCat.ofHom
        ((AdjoinRoot.of (Polynomial.X ^ (ℓ ^ k) - Polynomial.C xM)).comp ι)))
      (Spec.map (CommRingCat.ofHom β)) ℓ hℓL.ne_zero ζ hζ hv₀.unit _ hw
    have hκne : κ ≠ 0 := by
      intro hk0
      obtain ⟨u, hu⟩ := hκ0 hk0
      apply hnp
      refine ⟨(Scheme.ΓSpecIso (.of (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) -
        Polynomial.C xM)))).hom.hom u, ?_⟩
      rw [← map_pow, hu, IsUnit.unit_spec]
      exact CommRingCat.hom_inv_apply (Scheme.ΓSpecIso (.of (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) -
        Polynomial.C xM)))) (AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) - Polynomial.C xM))
    have hmem := mem_zmultiples_of_prime_card hcard hκne (g' := x)
    obtain ⟨n, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp hmem
    rw [map_zsmul, hκkill E, smul_zero]
  intro β _ hβ2 E x
  letI : Algebra A R := (ρ.comp (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).toAlgebra
  letI : Algebra A L := φA.toAlgebra
  have hℓM : IsUnit ((ℓ : ℕ) : TensorProduct A L R) := by
    have h := hℓL.map (Algebra.TensorProduct.includeLeftRingHom : L →+* TensorProduct A L R)
    rwa [map_natCast] at h
  have collapse :
      (∑ p : Fin (r + 2), ∑ q : Fin (r + 2), MvPolynomial.C (wcQmtmC A r p q) * MvPolynomial.X p *
          MvPolynomial.X q : MvPolynomial (Fin (r + 2)) A) =
        MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) * MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) := by
    rw [Finset.sum_eq_single (⟨0, by omega⟩ : Fin (r + 2))]
    · rw [Finset.sum_eq_single (⟨1, by omega⟩ : Fin (r + 2))]
      · simp [wcQmtmC, Matrix.of_apply]
      · intro q _ hq
        have hq' : q.val ≠ 1 := fun h => hq (Fin.ext h)
        simp [wcQmtmC, Matrix.of_apply, hq']
      · intro h; exact absurd (Finset.mem_univ _) h
    · intro p _ hp
      have hp' : p.val ≠ 0 := fun h => hp (Fin.ext h)
      apply Finset.sum_eq_zero
      intro q _
      simp only [wcQmtmC, Matrix.of_apply, hp', false_and, if_false, map_zero, zero_mul]
    · intro h; exact absurd (Finset.mem_univ _) h
