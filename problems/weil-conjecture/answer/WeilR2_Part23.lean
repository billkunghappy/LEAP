  have hπ0 : π ≠ 0 := by
    intro h
    apply IsDiscreteValuationRing.not_a_field A
    rw [hπ, h, Ideal.span_singleton_eq_bot.mpr rfl]
  have hφπ : φA π ≠ 0 := by
    intro h; apply hπ0; apply hφA; rw [h, map_zero]
  have hprod : ((1 : L) ⊗ₜ[A] ρ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) : TensorProduct A L R) *
        ((1 : L) ⊗ₜ[A] ρ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
          (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)))) : TensorProduct A L R) =
        Algebra.TensorProduct.includeLeftRingHom (φA π) := by
    rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, ← map_mul, hrel]
    change _ = (algebraMap A L π) ⊗ₜ[A] (1 : R)
    rw [Algebra.TensorProduct.tmul_one_eq_one_tmul]
    rfl
  have hxunit : IsUnit ((1 : L) ⊗ₜ[A] ρ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) : TensorProduct A L R) := by
    have hu : IsUnit (Algebra.TensorProduct.includeLeftRingHom (φA π) : TensorProduct A L R) :=
      (Ne.isUnit hφπ).map _
    rw [← hprod] at hu
    exact isUnit_of_mul_isUnit_left hu
  exact generic (TensorProduct A L R) Algebra.TensorProduct.includeLeftRingHom _
    (wc_qmtm_h1k_card A ℓ hℓ π hπ r R ρ hWE h0 h1 L φA hφA k)
    hxunit hℓM
    (wc_qmtm_level_milnor_conn A ℓ hℓ π hπ r R ρ hWE h0 h1 L φA hφA k)
    (wc_qmtm_level_milnor_conn A ℓ hℓ π hπ r R ρ hWE h0 h1 L φA hφA (k + 1)) β hβ2 E x

theorem wc_etqmt_tower_milnor_acyclic (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) (π : A) (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (r : ℕ)
    (U : Scheme.{u}) (g : U ⟶ Spec (.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))) (hg : Etale g)
    (fX : U ⟶ Spec (.of A)) (hfX : fX = g ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r))
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A))
    (hφA : Function.Injective (Spec.preimage ξ).hom)
    (σ : Spec (.of Ω) ⟶ Spec (.of Ω)) (σQ : Limits.pullback fX ξ ⟶ Limits.pullback fX ξ)
    (T : wcEtqmtTower ℓ g fX ξ σ σQ ⟨0, by omega⟩)
    (C : Type u) [CommRing C] [HenselianLocalRing C] [IsSepClosed (IsLocalRing.ResidueField C)]
    (a : Spec (.of C) ⟶ U) (ha : WeaklyEtale a)
    (hcl : fX (a (IsLocalRing.closedPoint C)) = IsLocalRing.closedPoint A) (j : ℕ) :
    Subsingleton (wcEtCoh (Limits.pullback (T.πi ≫ Limits.pullback.fst fX ξ) a) ℓ (j + 1)) :=
by
  classical

  have s1 : ∀ {A L R : Type u} [CommRing A] [CommRing L] [CommRing R]
      [Algebra A L] [Algebra A R] {Y XE : Scheme.{u}} (p : XE ⟶ Y) (q : XE ⟶ Spec (.of L))
      (s : Y ⟶ Spec (.of A))
      (hpb : IsPullback p q s (Spec.map (CommRingCat.ofHom (algebraMap A L))))
      (c : Spec (.of R) ⟶ Y) (hc : c ≫ s = Spec.map (CommRingCat.ofHom (algebraMap A R))),
      ∃ E : Limits.pullback c p ≅ Spec (.of (TensorProduct A L R)),
        E.hom ≫ Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight : R →ₐ[A] TensorProduct A L R).toRingHom) =
        Limits.pullback.fst c p := by
    intro A L R _ _ _ _ _ Y XE p q s hpb c hc
    have H3 := IsPullback.paste_horiz (IsPullback.of_hasPullback c p).flip hpb.flip
    rw [hc] at H3
    refine ⟨H3.isoPullback ≪≫ pullbackSpecIso A L R, ?_⟩
    rw [Iso.trans_hom, Category.assoc]
    erw [pullbackSpecIso_hom_snd]
    exact H3.isoPullback_hom_snd

  have s2 : ∀ {G₀ G M : Type u} [CommRing G₀] [CommRing G] [CommRing M]
      (ι : G₀ →+* G) {P XE XEi : Scheme.{u}} (s : P ⟶ XE) (πi : XEi ⟶ XE)
      (gi : XEi ⟶ Spec (.of G)) (g₀ : XE ⟶ Spec (.of G₀))
      (hT : IsPullback πi gi g₀ (Spec.map (CommRingCat.ofHom ι)))
      (E : P ≅ Spec (.of M)) (e : G₀ →+* M)
      (he : E.hom ≫ Spec.map (CommRingCat.ofHom e) = s ≫ g₀),
      letI := e.toAlgebra
      letI := ι.toAlgebra
      Nonempty (Limits.pullback s πi ≅ Spec (.of (TensorProduct G₀ M G))) := by
    intro G₀ G M _ _ _ ι P XE XEi s πi gi g₀ hT E e he
    letI := e.toAlgebra
    letI := ι.toAlgebra
    have HB := IsPullback.paste_vert (IsPullback.of_hasPullback s πi) hT
    have HC : IsPullback (Limits.pullback.fst s πi ≫ E.hom) (Limits.pullback.snd s πi ≫ gi)
        (Spec.map (CommRingCat.ofHom (algebraMap G₀ M)))
        (Spec.map (CommRingCat.ofHom (algebraMap G₀ G))) :=
      IsPullback.of_iso HB (Iso.refl _) E (Iso.refl _) (Iso.refl _) (by simp) (by simp)
        (by simp only [Iso.refl_hom, Category.comp_id]; exact he.symm) (by simp)
    exact ⟨HC.isoPullback ≪≫ pullbackSpecIso G₀ M G⟩

  have hα : ∀ {S R' : CommRingCat.{u}} (h : Spec S ⟶ Spec R') (r : R'),
      (Spec.preimage h).hom r =
        (Scheme.ΓSpecIso S).hom.hom (h.appTop.hom ((Scheme.ΓSpecIso R').inv.hom r)) := by
    intro S R' h r
    obtain ⟨f, rfl⟩ : ∃ f, Spec.map f = h := ⟨_, Spec.map_preimage h⟩
    rw [Spec.preimage_map]
    have := congrArg (fun φ => φ.hom ((Scheme.ΓSpecIso R').inv.hom r))
      (Scheme.ΓSpecIso_naturality f)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
    rw [this]
    simp

  have s3' : ∀ {Y : Scheme.{u}} {R M G₀ : CommRingCat.{u}} {XE : Scheme.{u}}
      (c : Spec R ⟶ Y) (p : XE ⟶ Y) (g₀ : XE ⟶ Spec G₀)
      (E : Limits.pullback c p ≅ Spec M) (j : R ⟶ M)
      (hE : E.hom ≫ Spec.map j = Limits.pullback.fst c p) (t : G₀) (x : Γ(Y, ⊤))
      (hg : g₀.appTop.hom ((Scheme.ΓSpecIso G₀).inv.hom t) = p.appTop.hom x),
      (Spec.preimage (E.inv ≫ Limits.pullback.snd c p ≫ g₀)).hom t =
        j.hom ((Scheme.ΓSpecIso R).hom.hom (c.appTop.hom x)) := by
    intro Y R M G₀ XE c p g₀ E j hE t x hg
    have hj' : Spec.map j = E.inv ≫ Limits.pullback.fst c p := (Iso.eq_inv_comp E).mpr hE
    have hcomp : E.inv ≫ Limits.pullback.snd c p ≫ p = Spec.map j ≫ c := by
      rw [← Limits.pullback.condition, hj', Category.assoc]
    have h2 : (E.inv ≫ Limits.pullback.snd c p ≫ g₀).appTop.hom ((Scheme.ΓSpecIso G₀).inv.hom t)
        = (E.inv ≫ Limits.pullback.snd c p ≫ p).appTop.hom x := by
      simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply, hg]
    rw [hα, h2, hcomp]
    have hn := congrArg (fun φ => φ.hom (c.appTop.hom x)) (Scheme.ΓSpecIso_naturality j)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at hn
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
    exact hn

  letI iAC : Algebra A C := ((Spec.preimage (a ≫ g)).hom.comp
      (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).toAlgebra
  letI iAL : Algebra A Ω := (Spec.preimage ξ).hom.toAlgebra
  have hcs : a ≫ fX = Spec.map (CommRingCat.ofHom (algebraMap A C)) := by
    rw [hfX, show algebraMap A C = (Spec.preimage (a ≫ g)).hom.comp
        (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r))) from rfl,
      CommRingCat.ofHom_comp, CommRingCat.ofHom_hom, Spec.map_comp, Spec.map_preimage,
      Category.assoc]
  have hξ' : Spec.map (CommRingCat.ofHom (algebraMap A Ω)) = ξ := by
    show Spec.map (CommRingCat.ofHom (Spec.preimage ξ).hom) = ξ
    rw [CommRingCat.ofHom_hom, Spec.map_preimage]
  have hpb' : IsPullback (Limits.pullback.fst fX ξ) (Limits.pullback.snd fX ξ) fX
      (Spec.map (CommRingCat.ofHom (algebraMap A Ω))) := by
    rw [hξ']
    exact IsPullback.of_hasPullback fX ξ
  obtain ⟨E, hE⟩ := s1 (Limits.pullback.fst fX ξ) (Limits.pullback.snd fX ξ) fX hpb' a hcs
  have he : E.hom ≫ Spec.map (CommRingCat.ofHom
      (Spec.preimage (E.inv ≫ Limits.pullback.snd a (Limits.pullback.fst fX ξ) ≫ T.g₀)).hom) =
      Limits.pullback.snd a (Limits.pullback.fst fX ξ) ≫ T.g₀ := by
    rw [CommRingCat.ofHom_hom, Spec.map_preimage, Iso.hom_inv_id_assoc]
  have hg0 : T.g₀.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of (LaurentPolynomial Ω))).inv.hom
      (LaurentPolynomial.T 1)) =
      (Limits.pullback.fst fX ξ).appTop.hom (wcEtqmtX g ⟨0, by omega⟩) := by
    refine T.hg₀T.trans ?_
    rw [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
    congr 1
    rw [Scheme.toSpecΓ_appTop]
    exact Iso.inv_hom_id_apply _ _
  have hT1 : (Spec.preimage (E.inv ≫ Limits.pullback.snd a (Limits.pullback.fst fX ξ) ≫ T.g₀)).hom
      (LaurentPolynomial.T 1) = (1 : Ω) ⊗ₜ[A] (Spec.preimage (a ≫ g)).hom
        (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) := by
    have h3 := s3' a (Limits.pullback.fst fX ξ) T.g₀ E (CommRingCat.ofHom
      (Algebra.TensorProduct.includeRight : C →ₐ[A] TensorProduct A Ω C).toRingHom) hE
      (LaurentPolynomial.T 1) _ hg0
    have h4 : (Scheme.ΓSpecIso (CommRingCat.of C)).hom.hom
        (a.appTop.hom (wcEtqmtX g ⟨0, by omega⟩)) =
        (Spec.preimage (a ≫ g)).hom (Ideal.Quotient.mk
          (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) := by
      rw [hα (a ≫ g), Scheme.Hom.comp_appTop]
      rfl
    rw [h3, h4]
    rfl
  obtain ⟨Ψ⟩ := s2 (AddMonoidAlgebra.mapDomainRingHom Ω
    (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom)
    (Limits.pullback.snd a (Limits.pullback.fst fX ξ)) T.πi T.gi T.g₀ T.hT E _ he
  obtain ⟨E0⟩ := wc_et_coh_iso_invariance
    (Limits.pullbackSymmetry (T.πi ≫ Limits.pullback.fst fX ξ) a ≪≫
      (Limits.pullbackLeftPullbackSndIso a (Limits.pullback.fst fX ξ) T.πi).symm ≪≫ Ψ).hom
    ℓ (j + 1)

  have hℓL : IsUnit ((ℓ : ℕ) : Ω) := by
    have h := hℓ.map (Spec.preimage ξ).hom
    rwa [map_natCast] at h
  have hSpec : Spec.map (CommRingCat.ofHom (Spec.preimage (a ≫ g)).hom) = a ≫ g := by
    rw [CommRingCat.ofHom_hom, Spec.map_preimage]
  have hWE : WeaklyEtale (Spec.map (CommRingCat.ofHom (Spec.preimage (a ≫ g)).hom)) := by
    rw [hSpec]
    haveI := ha
    haveI : WeaklyEtale g := etale_le_weaklyEtale _ _ _ hg
    infer_instance
  have hπC : (Spec.preimage (a ≫ g)).hom
      (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r)) π) ∈
        IsLocalRing.maximalIdeal C := by
    have h1 : (IsLocalRing.closedPoint A).asIdeal = IsLocalRing.maximalIdeal A := rfl
    have hcl' : wcQuadModelStr A (r + 2) π (wcQmtmC A r) (g (a (IsLocalRing.closedPoint C))) =
        IsLocalRing.closedPoint A := by
      rw [hfX] at hcl
      exact (Scheme.Hom.comp_apply g _ _).symm.trans hcl
    have h2 : π ∈ (wcQuadModelStr A (r + 2) π (wcQmtmC A r)
        (g (a (IsLocalRing.closedPoint C)))).asIdeal := by
      rw [hcl', h1, hπ]
      exact Ideal.mem_span_singleton_self π
    have h3 : g (a (IsLocalRing.closedPoint C)) =
        (Spec.map (CommRingCat.ofHom (Spec.preimage (a ≫ g)).hom))
          (IsLocalRing.closedPoint C) := by
      rw [hSpec]
      exact (Scheme.Hom.comp_apply a g _).symm
    rw [h3] at h2
    exact h2

  refine @Equiv.subsingleton _ _ E0.symm
    (wc_qmtm_kummer_ring_tower_coh ℓ hℓL _ _ hT1 j ?_)
  intro k x
  by_cases hdbl : (Spec.preimage (a ≫ g)).hom (Ideal.Quotient.mk
        (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) ∈ IsLocalRing.maximalIdeal C ∧
      (Spec.preimage (a ≫ g)).hom (Ideal.Quotient.mk
        (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
        (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)))) ∈ IsLocalRing.maximalIdeal C
  · rcases j with _ | j'
    ·
      refine ⟨1, fun β hβ1 hβ2 E' => ?_⟩
      rw [pow_one] at hβ2
      exact wc_etqmt_level_h1_kill A ℓ hℓ π hπ r C (Spec.preimage (a ≫ g)).hom hWE
        hdbl.1 hdbl.2 Ω (Spec.preimage ξ).hom hφA k β hβ1 hβ2 E' x
    ·
      refine ⟨0, fun β _ _ E' => ?_⟩
      have hS := wc_etqmt_level_double_higher_vanish A ℓ hℓ π hπ r C
        (Spec.preimage (a ≫ g)).hom hWE hdbl.1 hdbl.2 Ω (Spec.preimage ξ).hom hφA k
        (j' + 1 + 1) (by omega)
      obtain ⟨Eq⟩ := wc_et_zmodext_coh_equiv (Spec (.of (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) -
        Polynomial.C ((1 : Ω) ⊗ₜ[A] (Spec.preimage (a ≫ g)).hom
          (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
            (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) : TensorProduct A Ω C))))) ℓ
        (j' + 1 + 1)
      haveI := @Equiv.subsingleton _ _ Eq hS
      rw [Subsingleton.elim x 0, map_zero]
  ·
    refine ⟨0, fun β _ _ E' => ?_⟩
    have hS := wc_etqmt_level_offdouble_acyclic A ℓ hℓ π hπ r C (Spec.preimage (a ≫ g)).hom
      hWE hπC hdbl Ω (Spec.preimage ξ).hom hφA k (j + 1) (by omega)
    obtain ⟨Eq⟩ := wc_et_zmodext_coh_equiv (Spec (.of (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) -
      Polynomial.C ((1 : Ω) ⊗ₜ[A] (Spec.preimage (a ≫ g)).hom
        (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) : TensorProduct A Ω C))))) ℓ (j + 1)
    haveI := @Equiv.subsingleton _ _ Eq hS
    rw [Subsingleton.elim x 0, map_zero]

theorem wc_etqmt_tower_acyclic (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) (k : ℕ) (hk : 1 ≤ k) (π : A)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (r : ℕ)
    (U : Scheme.{u}) (g : U ⟶ Spec (.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))) (hg : Etale g)
    (fX : U ⟶ Spec (.of A)) (hfX : fX = g ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r))
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A))
    (σ : Spec (.of Ω) ⟶ Spec (.of Ω)) (hσ : σ ≫ ξ = ξ)
    (htame : wcMntTame ℓ (Spec.preimage ξ).hom (Spec.preimage σ).hom π)
    (σQ : Limits.pullback fX ξ ⟶ Limits.pullback fX ξ)
    (T : wcEtqmtTower ℓ g fX ξ σ σQ ⟨0, by omega⟩)
    (Dπ : wcEtPullData T.πi (ℓ ^ k))
    (Dh : wcEtPullData (Limits.pullback.fst fX ξ) (ℓ ^ k))
    (Dg : wcEtPullData (Limits.pullback.fst fX (wcQmSp A)) (ℓ ^ k)) :
    haveI := Dg.additive
    haveI := Dh.additive
    haveI : (wcEtqmtP Dh).Additive := Adjunction.right_adjoint_additive Dh.adj
    ∀ (J : InjectiveResolution (wcEtSuppObj Dπ)) (m : ℕ), 1 ≤ m →
      Limits.IsZero (Dg.Φ.obj ((((wcEtqmtP Dh).mapHomologicalComplex (ComplexShape.up ℕ)).obj
        J.cocomplex).homology m)) :=
by
  intro J m hm
  classical
  haveI := Dg.additive
  haveI := Dh.additive
  haveI hPhadd : (wcEtqmtP Dh).Additive := Adjunction.right_adjoint_additive Dh.adj
  have comp_ap : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (x : X), (f ≫ g) x = g (f x) := by
    intro X Y Z f g x
    first
    | rfl
    | simp
  have hγ : ∀ (B : Scheme.{u}) (c : B) (x : Spec (.of (AlgebraicClosure (B.residueField c)))),
      wcEtGeomPt B c x = c := by
    intro B c x
    first
    | exact Scheme.fromSpecResidueField_apply c _
    | (unfold wcEtGeomPt; rw [comp_ap]; exact Scheme.fromSpecResidueField_apply c _)
    | (simp only [wcEtGeomPt, comp_ap, Scheme.fromSpecResidueField_apply])
    | (simp [wcEtGeomPt])
  have hℓpos : 0 < ℓ := (Fact.out : ℓ.Prime).pos
  have hn : 0 < ℓ ^ k := pow_pos hℓpos k

  have htame' : ∀ k' : ℕ, 1 ≤ k' → ∀ z : Ω, z ^ (ℓ ^ k') = (Spec.preimage ξ).hom π →
      IsPrimitiveRoot ((Spec.preimage σ).hom z * z⁻¹) (ℓ ^ k') := htame
  have hφπ : (Spec.preimage ξ).hom π ≠ 0 := by
    intro h0
    have h1 := htame' 1 le_rfl 0 (by rw [h0]; exact zero_pow (pow_ne_zero _ hℓpos.ne'))
    rw [map_zero, zero_mul] at h1
    exact h1.ne_zero (pow_ne_zero _ hℓpos.ne') rfl
  have hirr : Irreducible π := (IsDiscreteValuationRing.irreducible_iff_uniformizer π).mpr hπ
  have hφA : Function.Injective (Spec.preimage ξ).hom := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    by_contra hx0
    obtain ⟨e, v, hv⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hx0 hirr
    rw [hv, map_mul, map_pow] at hx
    have hv' : (Spec.preimage ξ).hom (v : A) ≠ 0 := ((v.isUnit).map (Spec.preimage ξ).hom).ne_zero
    exact mul_ne_zero hv' (pow_ne_zero _ hφπ) hx
  have hℓL : IsUnit ((ℓ : ℕ) : Ω) := by
    have h1 := hℓ.map (Spec.preimage ξ).hom
    rwa [map_natCast] at h1

  obtain ⟨Dk⟩ := wc_et_zmod_pull_data_exists (T.πi ≫ Limits.pullback.fst fX ξ) (ℓ ^ k)
  haveI := sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology T.XEi)
    (wcEtZModRing T.XEi (ℓ ^ k))
  let I := InjectiveResolution.of (SheafOfModules.unit (wcEtZModRing T.XEi (ℓ ^ k)))
  haveI := Dπ.additive
  haveI hPπadd : (wcEtqmtP Dπ).Additive := Adjunction.right_adjoint_additive Dπ.adj
  haveI := Dk.additive
  haveI hPkadd : (wcEtqmtP Dk).Additive := Adjunction.right_adjoint_additive Dk.adj
  haveI := Dπ.presLim

  have hacyc := wc_etqmt_tower_push_acyclic ℓ hℓL (Spec.preimage ξ).hom (Spec.preimage σ).hom
    _ _ σQ _ T k hk Dπ I

  have hiso : Nonempty ((((wcEtqmtP Dh).mapHomologicalComplex (ComplexShape.up ℕ)).obj
      J.cocomplex).homology m ≅
      (((wcEtqmtP Dk).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology m) := by
    let R := wcEtqmtP Dπ
    let Z := SheafOfModules.unit (wcEtZModRing T.XEi (ℓ ^ k))
    let K := (R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex
    have hinj : ∀ n, Injective (K.X n) := fun n => Dπ.adj.map_injective _ (I.injective n)
    have hz : R.map (I.ι.f 0) ≫ K.d 0 1 = 0 := by
      show R.map (I.ι.f 0) ≫ R.map (I.cocomplex.d 0 1) = 0
      rw [← R.map_comp, I.ι_f_zero_comp_complex_d, R.map_zero]
    let ι : (CochainComplex.single₀ _).obj (R.obj Z) ⟶ K :=
      (CochainComplex.fromSingle₀Equiv K (R.obj Z)).symm ⟨R.map (I.ι.f 0), hz⟩
    have hι0 : ι.f 0 = R.map (I.ι.f 0) :=
      CochainComplex.fromSingle₀Equiv_symm_apply_f_zero _ _
    have hqi : QuasiIso ι := by
      rw [quasiIso_iff]
      intro i
      rcases i with _ | n
      · rw [CochainComplex.quasiIsoAt₀_iff, ShortComplex.quasiIso_iff_of_zeros]
        · have : Limits.PreservesLimitsOfSize.{0, 0} R := Dπ.adj.rightAdjoint_preservesLimits
          have : R.IsRightAdjoint := ⟨_, ⟨Dπ.adj⟩⟩
          constructor
          · have e1 := I.exact₀.map_of_mono_of_preservesKernel R inferInstance inferInstance
            refine ShortComplex.exact_of_iso ?_ e1
            refine ShortComplex.isoMk (Iso.refl _) (Iso.refl _) (Iso.refl _) ?_ ?_
            · first
                | exact (Category.id_comp _).trans (hι0.trans (Category.comp_id _).symm)
                | (dsimp; erw [Category.id_comp, Category.comp_id]; exact hι0)
                | (simp only [Iso.refl_hom, Category.id_comp, Category.comp_id]; exact hι0)
            · first
                | exact (Category.id_comp _).trans (Category.comp_id _).symm
                | (dsimp; erw [Category.id_comp, Category.comp_id]; rfl)
                | (simp only [Iso.refl_hom, Category.id_comp, Category.comp_id]; rfl)
          · show Mono (ι.f 0)
            rw [hι0]
            exact @Functor.map_mono _ _ _ _ R (Functor.preservesMonomorphisms_of_isRightAdjoint R)
              _ _ _ inferInstance
        · first
            | rfl
            | exact HomologicalComplex.single_obj_d _ _ _ _ _
            | (dsimp; rfl)
        · first
            | rfl
            | exact HomologicalComplex.single_obj_d _ _ _ _ _
            | (dsimp; rfl)
        · exact K.shape 0 0 (by simp)
      · rw [quasiIsoAt_iff_exactAt ι (n + 1)]
        · exact (HomologicalComplex.exactAt_iff_isZero_homology K (n + 1)).2 (hacyc n)
        · exact HomologicalComplex.exactAt_single_obj _ 0 _ (n + 1) (by omega)
    let J' : InjectiveResolution (wcEtSuppObj Dπ) :=
      { cocomplex := K, injective := hinj, ι := ι, quasiIso := hqi }
    let E := InjectiveResolution.homotopyEquiv J J'
    let e1 := ((wcEtqmtP Dh).mapHomotopyEquiv E).toHomologyIso m
    obtain ⟨γ⟩ := wc_et_pull_data_comp_iso (Limits.pullback.fst fX ξ) T.πi
      (T.πi ≫ Limits.pullback.fst fX ξ) rfl Dh Dπ Dk
    let adj' : Dk.Φ ⊣ wcEtqmtP Dπ ⋙ wcEtqmtP Dh := (Dh.adj.comp Dπ.adj).ofNatIsoLeft γ.symm
    let θ : wcEtqmtP Dk ≅ wcEtqmtP Dπ ⋙ wcEtqmtP Dh := Dk.adj.rightAdjointUniq adj'
    let ψ := (NatIso.mapHomologicalComplex θ (ComplexShape.up ℕ)).app I.cocomplex ≪≫
      ((Functor.mapHomologicalComplexCompIso (Iso.refl (wcEtqmtP Dπ ⋙ wcEtqmtP Dh))
        (ComplexShape.up ℕ)).app I.cocomplex).symm
    exact ⟨e1 ≪≫ HomologicalComplex.homologyMapIso ψ.symm m⟩
  obtain ⟨e⟩ := hiso
  refine Limits.IsZero.of_iso ?_ (Dg.Φ.mapIso e)

  haveI : IsClosedImmersion (wcQmSp A) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  have hclosed : IsClosed (Set.range (Limits.pullback.fst fX (wcQmSp A))) :=
    (Scheme.Hom.isClosedEmbedding _).isClosed_range
  have hzA : ∀ z, fX (Limits.pullback.fst fX (wcQmSp A) z) = IsLocalRing.closedPoint A := by
    intro z
    have e1 := congrArg (fun g => g z)
      (Limits.pullback.condition (f := fX) (g := wcQmSp A))
    refine ((comp_ap _ _ _).symm.trans e1).trans ?_
    refine (comp_ap _ _ _).trans ?_
    have hu : Limits.pullback.snd fX (wcQmSp A) z =
        IsLocalRing.closedPoint (IsLocalRing.ResidueField A) :=
      @Subsingleton.elim (PrimeSpectrum (IsLocalRing.ResidueField A)) _ _ _
    rw [hu]
    exact IsLocalRing.comap_closedPoint (IsLocalRing.residue A)

  haveI hhaff : IsAffineHom (Limits.pullback.fst fX ξ) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom)
      (IsPullback.of_hasPullback fX ξ).flip inferInstance
  haveI hπaff : IsAffineHom T.πi :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) T.hT.flip (isAffineHom_of_isAffine _)
  haveI hkaff : IsAffineHom (T.πi ≫ Limits.pullback.fst fX ξ) := inferInstance
  refine wc_et_pull_isZero_of_range_stalks _ (ℓ ^ k) Dg _ hclosed ?_
  intro z
  refine wc_etqmt_affine_push_stalk_vanish (T.πi ≫ Limits.pullback.fst fX ξ) (ℓ ^ k) hn Dk I
    (Limits.pullback.fst fX (wcQmSp A) z) m ?_
  intro B _ _ _ Λ' _ _ W'' φ' a hsh

  have ha : WeaklyEtale a := wc_shdata_weaklyEtale _ B Λ' W'' φ' a hsh
  obtain ⟨l⟩ : Nonempty Λ' := by
    first
    | exact inferInstance
    | exact IsCofiltered.nonempty
  have hpt : a (IsLocalRing.closedPoint B) = Limits.pullback.fst fX (wcQmSp A) z := by
    have h1 := wc_shdata_closed_point_compat _ B Λ' W'' φ' a hsh l
    have h2 : (W''.obj l).hom.left ≫ (W''.obj l).right.hom =
        wcEtGeomPt U (Limits.pullback.fst fX (wcQmSp A) z) := Over.w (W''.obj l).hom
    exact (congrArg (fun g => g (IsLocalRing.closedPoint B)) (hsh.2.2.2.1 l).symm).trans
      ((comp_ap _ _ _).trans ((congrArg (W''.obj l).right.hom h1).trans
        ((comp_ap _ _ _).symm.trans ((congrArg (fun g => g (IsLocalRing.closedPoint
          (AlgebraicClosure (U.residueField (Limits.pullback.fst fX (wcQmSp A) z))))) h2).trans
            (hγ _ _ _)))))
  have hcl : fX (a (IsLocalRing.closedPoint B)) = IsLocalRing.closedPoint A :=
    (congrArg fX hpt).trans (hzA z)
  obtain ⟨j, hj⟩ : ∃ j, m = j + 1 := ⟨m - 1, by omega⟩
  subst hj
  have h1 := wc_etqmt_tower_milnor_acyclic A ℓ hℓ π hπ r U g hg fX hfX Ω ξ hφA σ σQ T B a ha hcl j
  have h2 := wc_et_coh_zmod_prime_pow_of_prime _ ℓ Fact.out (j + 1) h1 (k - 1)
  rwa [Nat.sub_add_cancel hk] at h2

theorem wc_etqmt_unit_restr_iso (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) (k : ℕ) (hk : 1 ≤ k) (π : A)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (r : ℕ)
    (U : Scheme.{u}) (g : U ⟶ Spec (.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))) (hg : Etale g)
    (fX : U ⟶ Spec (.of A)) (hfX : fX = g ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r))
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A))
    (σ : Spec (.of Ω) ⟶ Spec (.of Ω)) (hσ : σ ≫ ξ = ξ)
    (htame : wcMntTame ℓ (Spec.preimage ξ).hom (Spec.preimage σ).hom π)
    (Dh : wcEtPullData (Limits.pullback.fst fX ξ) (ℓ ^ k))
    (Dg : wcEtPullData (Limits.pullback.fst fX (wcQmSp A)) (ℓ ^ k)) :
    IsIso (Dg.Φ.map (wcEtqmtU Dh)) :=
by
  classical

  have hfinal : ∀ {S S' : Scheme.{u}} (g : S' ⟶ S), (wcEtBaseChange g).Final := by
    intro S S' g
    let F := wcEtBaseChange g
    let T : S.Etale := MorphismProperty.Over.mk ⊤ (𝟙 S) (inferInstance : Etale (𝟙 S))
    have hT : Limits.IsTerminal T := Limits.IsTerminal.ofUniqueHom
      (fun V => MorphismProperty.Over.homMk V.hom (Category.comp_id _) trivial)
      (fun V m => by
        apply MorphismProperty.Over.Hom.ext
        exact (Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m))
    have hFT : Limits.IsTerminal (F.obj T) := Limits.IsTerminal.ofUniqueHom
      (fun V => MorphismProperty.Over.homMk
        (Limits.pullback.lift (V.hom ≫ g) V.hom (by simp) : V.left ⟶ Limits.pullback (𝟙 S) g)
        (Limits.pullback.lift_snd _ _ _) trivial)
      (fun V m => by
        apply MorphismProperty.Over.Hom.ext
        have hw : m.left ≫ Limits.pullback.snd (𝟙 S) g = V.hom := MorphismProperty.Over.w m
        show @Eq (V.left ⟶ Limits.pullback (𝟙 S) g) m.left
          (Limits.pullback.lift (V.hom ≫ g) V.hom (by simp))
        apply Limits.pullback.hom_ext
        · have hl1 := Limits.pullback.lift_fst (f := 𝟙 S) (g := g) (V.hom ≫ g) V.hom (by simp)
          have hc := Limits.pullback.condition (f := 𝟙 S) (g := g)
          rw [Category.comp_id] at hc
          have h2 : m.left ≫ Limits.pullback.fst (𝟙 S) g = V.hom ≫ g := by
            rw [hc]
            exact (Category.assoc _ _ _).symm.trans (congrArg (fun t => t ≫ g) hw)
          exact h2.trans hl1.symm
        · have hl2 := Limits.pullback.lift_snd (f := 𝟙 S) (g := g) (V.hom ≫ g) V.hom (by simp)
          exact hw.trans hl2.symm)
    refine Functor.Final.mk (fun d => ?_)
    have hterm : Limits.IsTerminal (StructuredArrow.mk (hFT.from d) : StructuredArrow d F) :=
      Limits.IsTerminal.ofUniqueHom
        (fun X => StructuredArrow.homMk (hT.from X.right) (hFT.hom_ext _ _))
        (fun X m => StructuredArrow.hom_ext _ _ (hT.hom_ext _ _))
    haveI := hterm.hasTerminal
    exact isConnected_of_hasTerminal _

  have htrans : ∀ {S S' : Scheme.{u}} {g : S' ⟶ S} {m : ℕ} (E : wcEtPullData g m),
      IsIso ((E.adj.homEquiv _ _).symm
        (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange g) _ _ E.cont E.φ)) := by
    intro S S' g m E
    haveI := E.cont
    haveI : (wcEtBaseChange g).Final := hfinal g
    haveI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange g) _ _ E.cont E.φ).IsRightAdjoint :=
      ⟨_, ⟨E.adj⟩⟩
    let pPA := SheafOfModules.pullbackPushforwardAdjunction E.φ
    let e := E.adj.leftAdjointUniq pPA
    have h1 : (E.adj.homEquiv _ _).symm (SheafOfModules.unitToPushforwardObjUnit E.φ) =
        e.hom.app _ ≫ (pPA.homEquiv _ _).symm (SheafOfModules.unitToPushforwardObjUnit E.φ) := by
      rw [Adjunction.homEquiv_counit, Adjunction.homEquiv_counit,
        ← Adjunction.leftAdjointUniq_hom_app_counit E.adj pPA]
      rw [← Category.assoc, NatTrans.naturality, Category.assoc]
    rw [h1, SheafOfModules.pullbackPushforwardAdjunction_homEquiv_symm_unitToPushforwardObjUnit]
    infer_instance

  haveI := Dh.cont
  let u := @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
    (wcEtBaseChange (Limits.pullback.fst fX ξ)) _ _ Dh.cont Dh.φ
  let P := @SheafOfModules.pushforward _ _ _ _ _ _
    (wcEtBaseChange (Limits.pullback.fst fX ξ)) _ _ Dh.cont Dh.φ
  let ψ := (Dh.adj.homEquiv _ _).symm u
  haveI hψ : IsIso ψ := htrans Dh
  let c := Dh.μ.inv ≫ ψ
  have hfac : u = wcEtSuppUnitMap Dh ≫ P.map c := by
    have e1 : Dh.μ.hom ≫ c = ψ := Iso.hom_inv_id_assoc _ _
    calc u = Dh.adj.homEquiv _ _ ψ := (Equiv.apply_symm_apply _ _).symm
      _ = Dh.adj.homEquiv _ _ (Dh.μ.hom ≫ c) := by rw [e1]
      _ = Dh.adj.homEquiv _ _ Dh.μ.hom ≫ P.map c := Adjunction.homEquiv_naturality_right _ _ _
      _ = wcEtSuppUnitMap Dh ≫ P.map c := by rw [Adjunction.homEquiv_unit]; rfl

  haveI : IsClosedImmersion (wcQmSp A) :=
    IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom (IsLocalRing.residue A))
      Ideal.Quotient.mk_surjective
  have hclosed : IsClosed (Set.range (Limits.pullback.fst fX (wcQmSp A))) :=
    (IsClosedImmersion.isClosedEmbedding _).isClosed_range
  have hpt : ∀ z : ↥(Limits.pullback fX (wcQmSp A)),
      fX (Limits.pullback.fst fX (wcQmSp A) z) = IsLocalRing.closedPoint A := by
    intro z
    have e1 : fX (Limits.pullback.fst fX (wcQmSp A) z) =
        wcQmSp A (Limits.pullback.snd fX (wcQmSp A) z) := by
      rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
    rw [e1, Subsingleton.elim (Limits.pullback.snd fX (wcQmSp A) z)
      (IsLocalRing.closedPoint _)]
    haveI : IsLocalHom (CommRingCat.Hom.hom (CommRingCat.ofHom (IsLocalRing.residue A))) :=
      (inferInstance : IsLocalHom (IsLocalRing.residue A))
    exact AlgebraicGeometry.Spec_closedPoint

  have hξinj : Function.Injective (Spec.preimage ξ).hom := by
    have hℓ0 : ℓ ^ 1 ≠ 0 := pow_ne_zero _ (Fact.out : ℓ.Prime).ne_zero
    have hφπ : (Spec.preimage ξ).hom π ≠ 0 := by
      intro h0
      have h1 := htame 1 le_rfl 0 (by rw [zero_pow hℓ0, h0])
      rw [map_zero, zero_mul] at h1
      have h2 := h1.pow_eq_one
      rw [zero_pow hℓ0] at h2
      exact zero_ne_one h2
    have hπ0 : π ≠ 0 := fun h => hφπ (by rw [h, map_zero])
    have hirr := IsDiscreteValuationRing.irreducible_of_span_eq_maximalIdeal π hπ0 hπ
    rw [injective_iff_map_eq_zero]
    intro x hx
    by_contra hx0
    obtain ⟨n, v, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hx0 hirr
    rw [map_mul, map_pow] at hx
    exact mul_ne_zero ((v.isUnit.map (Spec.preimage ξ).hom).ne_zero) (pow_ne_zero n hφπ) hx

  have hm0 : ℓ ^ k ≠ 0 := pow_ne_zero k (Fact.out : ℓ.Prime).ne_zero
  have hmu : IsUnit (((ℓ ^ k : ℕ)) : A) := by rw [Nat.cast_pow]; exact hℓ.pow k
  have hξ' : Spec.map (CommRingCat.ofHom (Spec.preimage ξ).hom) = ξ := by
    rw [CommRingCat.ofHom_hom, Spec.map_preimage]
  have hmodel : ∀ (y : Spec (.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))),
      wcQuadModelStr A (r + 2) π (wcQmtmC A r) y = IsLocalRing.closedPoint A →
      ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
        (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
        (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt
          (Spec (.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))) y))
          (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r))))))
        (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left)
        (a : Spec (.of B) ⟶ Spec (.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))),
        wcHalShData y B Λ W' φ a →
        Nat.card (wcEtCoh (Limits.pullback (a ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r)) ξ)
          (ℓ ^ k) 0) = ℓ ^ k := by
    intro y hy B _ _ _ Λ _ _ W' φ a hB
    by_cases hd : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal y ∧
      Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
        (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal y
    · have hc := wc_qmssl_mfc_double A ℓ hℓ π hπ r y hy hd.1 hd.2 B Λ W' φ a hB Ω
        (Spec.preimage ξ).hom hξinj
      rw [hξ'] at hc
      exact @wc_et_coh_zero_connected_card _ hc (ℓ ^ k) hm0
    · obtain ⟨V, hyV, hsm⟩ := wc_qmssl_offdouble_smooth A r π y (not_and_or.mp hd)
      exact (wc_smooth_open_shens_milnor_fibre_acyclic A _ _ V hsm (ℓ ^ k) hmu y hyV hy
        B Λ W' φ a hB Ω ξ).1

  have hMH : ∀ z : ↥(Limits.pullback fX (wcQmSp A)),
      ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
        (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
        (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt U (Limits.pullback.fst fX (wcQmSp A) z)))
          (Scheme.Etale.forget U))
        (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ U),
        wcHalShData (Limits.pullback.fst fX (wcQmSp A) z) B Λ W' φ a →
        Nat.card (wcEtCoh (Limits.pullback (a ≫ fX) ξ) (ℓ ^ k) 0) = ℓ ^ k := by
    intro z B _ _ _ Λ _ _ W' φ a hB
    have hy : wcQuadModelStr A (r + 2) π (wcQmtmC A r) (g (Limits.pullback.fst fX (wcQmSp A) z)) =
        IsLocalRing.closedPoint A := by
      rw [← Scheme.Hom.comp_apply, ← hfX]
      exact hpt z
    obtain ⟨B₀, _, _, _, Λ₀, _, _, W₀, φ₀, a₀, e₀, hinit, haff, hφ, hφa, hlim, heint, hpt₀⟩ :=
      wc_et_geom_strict_henselization (g (Limits.pullback.fst fX (wcQmSp A) z))
    have hB₀ : wcHalShData (g (Limits.pullback.fst fX (wcQmSp A) z)) B₀ Λ₀ W₀ φ₀ a₀ := by
      first
      | exact ⟨hinit, haff, hφ, hφa, hlim, e₀, heint, hpt₀⟩
      | exact ⟨hinit, haff, hφ, hφa, hlim, ⟨e₀, heint, hpt₀⟩⟩
      | exact ⟨hinit, haff, @hφ, hφa, hlim, e₀, heint, hpt₀⟩
    haveI := hg
    obtain ⟨ι', hι'⟩ := wc_etale_geom_point_residue_iso g (Limits.pullback.fst fX (wcQmSp A) z)
      (g (Limits.pullback.fst fX (wcQmSp A) z)) rfl
    obtain ⟨θ, hθ⟩ := wc_shdata_etale_iso g (Limits.pullback.fst fX (wcQmSp A) z)
      (g (Limits.pullback.fst fX (wcQmSp A) z)) ι' hι' B Λ W' φ a hB B₀ Λ₀ W₀ φ₀ a₀ hB₀
    have h0 := hmodel (g (Limits.pullback.fst fX (wcQmSp A) z)) hy B₀ Λ₀ W₀ φ₀ a₀ hB₀
    have eq₁ : (a ≫ fX) ≫ 𝟙 _ = θ.hom ≫ a₀ ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r) := by
      rw [Category.comp_id, ← Category.assoc, hθ, Category.assoc, hfX]
    have eq₂ : ξ ≫ 𝟙 _ = 𝟙 _ ≫ ξ := by simp
    haveI hiso : IsIso (Limits.pullback.map (a ≫ fX) ξ
        (a₀ ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r)) ξ θ.hom (𝟙 _) (𝟙 _) eq₁ eq₂) :=
      Limits.pullback.map_isIso _ _ _ _ _ _ _ eq₁ eq₂
    obtain ⟨E⟩ := wc_et_coh_iso_invariance (Limits.pullback.map (a ≫ fX) ξ
        (a₀ ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r)) ξ θ.hom (𝟙 _) (𝟙 _) eq₁ eq₂) (ℓ ^ k) 0
    exact (Nat.card_congr E.symm).trans h0

  have hstalk := fun z => wc_et_supp_unit_ker_coker_stalks_of_milnor_h0 A U fX (ℓ ^ k)
    (pow_pos (Fact.out : ℓ.Prime).pos k) Ω ξ Dh (Limits.pullback.fst fX (wcQmSp A) z) (hMH z)

  have hK := wc_et_pull_isZero_of_range_stalks _ (ℓ ^ k) Dg
    (Limits.kernel (wcEtSuppUnitMap Dh)) hclosed (fun z => (hstalk z).1)
  have hC := wc_et_pull_isZero_of_range_stalks _ (ℓ ^ k) Dg
    (Limits.cokernel (wcEtSuppUnitMap Dh)) hclosed (fun z => (hstalk z).2)

  haveI := Dg.additive
  haveI := Dg.presLim
  haveI := Dg.presColim
  have hK' : Limits.IsZero (Limits.kernel (Dg.Φ.map (wcEtSuppUnitMap Dh))) :=
    hK.of_iso (Limits.PreservesKernel.iso Dg.Φ (wcEtSuppUnitMap Dh)).symm
  have hC' : Limits.IsZero (Limits.cokernel (Dg.Φ.map (wcEtSuppUnitMap Dh))) :=
    hC.of_iso (Limits.PreservesCokernel.iso Dg.Φ (wcEtSuppUnitMap Dh)).symm
  haveI : Mono (Dg.Φ.map (wcEtSuppUnitMap Dh)) :=
    Preadditive.mono_of_isZero_kernel' _ (Limits.kernelIsKernel _) hK'
  haveI : Epi (Dg.Φ.map (wcEtSuppUnitMap Dh)) :=
    Preadditive.epi_of_isZero_cokernel' _ (Limits.cokernelIsCokernel _) hC'
  have hs : IsIso (Dg.Φ.map (wcEtSuppUnitMap Dh)) := isIso_of_mono_of_epi _
  have hc : IsIso c := IsIso.comp_isIso' inferInstance hψ
  have hPc : IsIso (P.map c) := @Functor.map_isIso _ _ _ _ _ _ P c hc
  have hΦPc : IsIso (Dg.Φ.map (P.map c)) := @Functor.map_isIso _ _ _ _ _ _ Dg.Φ (P.map c) hPc
  have key : IsIso (Dg.Φ.map (wcEtSuppUnitMap Dh) ≫ Dg.Φ.map (P.map c)) :=
    IsIso.comp_isIso' hs hΦPc
  have hmap : Dg.Φ.map u = Dg.Φ.map (wcEtSuppUnitMap Dh) ≫ Dg.Φ.map (P.map c) :=
    (congrArg Dg.Φ.map hfac).trans (Dg.Φ.map_comp _ _)
  show IsIso (Dg.Φ.map u)
  exact cast (congrArg (fun t => IsIso t) hmap).symm key

theorem wc_etqmt_tube_epi (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) (k : ℕ) (hk : 1 ≤ k) (π : A)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (r : ℕ)
    (U : Scheme.{u}) (g : U ⟶ Spec (.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))) (hg : Etale g)
    (fX : U ⟶ Spec (.of A)) (hfX : fX = g ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r))
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A))
    (σ : Spec (.of Ω) ⟶ Spec (.of Ω)) (hσ : σ ≫ ξ = ξ)
    (htame : wcMntTame ℓ (Spec.preimage ξ).hom (Spec.preimage σ).hom π)
    (σQ : Limits.pullback fX ξ ⟶ Limits.pullback fX ξ)
    (T : wcEtqmtTower ℓ g fX ξ σ σQ ⟨0, by omega⟩)
    (Dπ : wcEtPullData T.πi (ℓ ^ k)) (Dγ : wcEtPullData T.γi (ℓ ^ k))
    (hφγ : wcEtqmtHPhi T.hγπ Dπ Dγ)
    (Dh : wcEtPullData (Limits.pullback.fst fX ξ) (ℓ ^ k))
    (Dg : wcEtPullData (Limits.pullback.fst fX (wcQmSp A)) (ℓ ^ k)) :
    ∀ (a : Fin (r + 2)), a.val < 2 → ∀ D : wcEtPullData (wcEtqmTube g fX a).ι (ℓ ^ k),
      Epi (D.Φ.map (Dg.Φ.map ((wcEtqmtP Dh).map
        (wcEtqmtGammaN T.hγπ Dπ Dγ hφγ - 𝟙 (wcEtSuppObj Dπ))))) :=
by
  classical
  intro a ha D
  haveI := Dh.cont
  haveI := Dh.additive
  haveI := Dg.additive
  haveI := Dg.presLim
  haveI := Dg.presColim
  haveI := D.additive
  haveI := D.presLim
  haveI := D.presColim
  haveI := sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology (Limits.pullback fX ξ))
    (wcEtZModRing (Limits.pullback fX ξ) (ℓ ^ k))
  haveI hPadd : (wcEtqmtP Dh).Additive := Adjunction.right_adjoint_additive Dh.adj
  haveI hPlim : Limits.PreservesFiniteLimits (wcEtqmtP Dh) := by
    haveI := Dh.adj.rightAdjoint_preservesLimits
    infer_instance

  have h1 : wcEtqmtU Dπ ≫ wcEtqmtGammaN T.hγπ Dπ Dγ hφγ = wcEtqmtU Dπ :=
    wc_etqmt_unit_fix T.hγπ Dπ Dγ hφγ
  have hz : wcEtqmtU Dπ ≫ (wcEtqmtGammaN T.hγπ Dπ Dγ hφγ - 𝟙 (wcEtSuppObj Dπ)) = 0 := by
    rw [Preadditive.comp_sub, h1, Category.comp_id, sub_self]

  have hS := wc_etqmt_torsor_ses T k Dπ Dγ hφγ hz

  have hpos : 0 < ℓ ^ k := pow_pos (Fact.out : ℓ.Prime).pos k
  have hmu : IsUnit (((ℓ ^ k : ℕ)) : A) := by rw [Nat.cast_pow]; exact hℓ.pow k

  have hpt : ∀ s : (wcEtqmTube g fX a).toScheme,
      fX (Limits.pullback.fst fX (wcQmSp A) ((wcEtqmTube g fX a).ι s)) =
        IsLocalRing.closedPoint A ∧
      ∃ U' : U.Opens, Limits.pullback.fst fX (wcQmSp A) ((wcEtqmTube g fX a).ι s) ∈ U' ∧
        Smooth (U'.ι ≫ fX) := by
    intro s
    set z := (wcEtqmTube g fX a).ι s with hzdef
    refine ⟨?_, ?_⟩
    · have e1 : fX (Limits.pullback.fst fX (wcQmSp A) z) =
          wcQmSp A (Limits.pullback.snd fX (wcQmSp A) z) := by
        rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
      rw [e1, Subsingleton.elim (Limits.pullback.snd fX (wcQmSp A) z)
        (IsLocalRing.closedPoint _)]
      haveI : IsLocalHom (CommRingCat.Hom.hom (CommRingCat.ofHom (IsLocalRing.residue A))) :=
        (inferInstance : IsLocalHom (IsLocalRing.residue A))
      exact AlgebraicGeometry.Spec_closedPoint
    · have h2 : z ∈ wcEtqmTube g fX a := by
        have hr : z ∈ Set.range (wcEtqmTube g fX a).ι := ⟨s, hzdef.symm⟩
        rwa [Scheme.Opens.range_ι] at hr
      have h3 : z ∈ (Limits.pullback.fst fX (wcQmSp A) ≫ g) ⁻¹ᵁ
          (Spec (.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).basicOpen
            ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).inv.hom
              (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r)) (MvPolynomial.X a))) := by
        rw [Scheme.preimage_basicOpen_top]; exact h2
      have h4 : (Limits.pullback.fst fX (wcQmSp A) ≫ g) z ∈
          (Spec (.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).basicOpen
            ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).inv.hom
              (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r)) (MvPolynomial.X a))) := h3
      have h5 : g (Limits.pullback.fst fX (wcQmSp A) z) ∈ PrimeSpectrum.basicOpen
          (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r)) (MvPolynomial.X a)) := by
        have e := basicOpen_eq_of_affine
          (R := CommRingCat.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))
          (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r)) (MvPolynomial.X a))
        rw [← e, ← Scheme.Hom.comp_apply]; exact h4
      have h6 := (PrimeSpectrum.mem_basicOpen _ _).mp h5
      have hdisj : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
            (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∉
            PrimeSpectrum.asIdeal (g (Limits.pullback.fst fX (wcQmSp A) z)) ∨
          Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
            (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∉
            PrimeSpectrum.asIdeal (g (Limits.pullback.fst fX (wcQmSp A) z)) := by
        have hcase : a.val = 0 ∨ a.val = 1 := by omega
        rcases hcase with h | h
        · left
          have ha0 : a = ⟨0, by omega⟩ := Fin.ext h
          rw [← ha0]; exact h6
        · right
          have ha1 : a = ⟨1, by omega⟩ := Fin.ext h
          rw [← ha1]; exact h6
      obtain ⟨V, hyV, hsm⟩ := wc_qmssl_offdouble_smooth A r π
        (g (Limits.pullback.fst fX (wcQmSp A) z)) hdisj
      refine ⟨g ⁻¹ᵁ V, hyV, ?_⟩
      have e2 : (g ⁻¹ᵁ V).ι ≫ fX = g ∣_ V ≫ (V.ι ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r)) := by
        rw [hfX, ← Category.assoc, ← morphismRestrict_ι, Category.assoc]
      rw [e2]
      haveI := hg
      haveI : Smooth (V.ι ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r)) := hsm
      infer_instance

  have hR1 : ∀ I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing (Limits.pullback fX ξ) (ℓ ^ k))),
      Limits.IsZero ((Dg.Φ ⋙ D.Φ).obj
        ((((wcEtqmtP Dh).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 1)) := by
    intro I
    have hstalk : ∀ s : (wcEtqmTube g fX a).toScheme,
        Subsingleton ((wcEtStalk (wcEtqmTube g fX a).toScheme s).obj
          ((SheafOfModules.toSheaf (wcEtZModRing (wcEtqmTube g fX a).toScheme (ℓ ^ k))).obj
            (D.Φ.obj (Dg.Φ.obj
              ((((wcEtqmtP Dh).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 1))))) := by
      intro s
      obtain ⟨hx1, U', hxU, hsm⟩ := hpt s
      have hsub := wc_et_module_push_higher_stalk_vanish_of_milnor A U fX (ℓ ^ k) hpos Ω ξ Dh I
        (Limits.pullback.fst fX (wcQmSp A) ((wcEtqmTube g fX a).ι s))
        (by
          intro B _ _ _ Λ _ _ W' φ a' hB q hq
          exact (wc_smooth_open_shens_milnor_fibre_acyclic A U fX U' hsm (ℓ ^ k) hmu _ hxU hx1
            B Λ W' φ a' hB Ω ξ).2 q hq) 1 le_rfl
      obtain ⟨e1⟩ := wc_et_pull_data_stalk_iso (wcEtqmTube g fX a).ι (ℓ ^ k) D
        (Dg.Φ.obj ((((wcEtqmtP Dh).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 1)) s
      obtain ⟨e2⟩ := wc_et_pull_data_stalk_iso (Limits.pullback.fst fX (wcQmSp A)) (ℓ ^ k) Dg
