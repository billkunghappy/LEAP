    have hid : ∀ y, (Spec.preimage (𝟙 (Spec (CommRingCat.of (wcR1sM A r π))))).hom y = y := by
      intro y; rw [Spec.preimage_id]; rfl
    have := wc_qsfx_uq_isUnit A π hπ r (wcR1sM A r π) (𝟙 _) Ω (Spec.preimage ξ).hom hinj _ _ _ hp
    rw [hid] at this
