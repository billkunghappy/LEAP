        (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))))) := by
    have h := congrArg (fun f => f.hom (wcR1sY0 A r π))
