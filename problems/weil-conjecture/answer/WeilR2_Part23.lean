        apply MvPolynomial.ringHom_ext
        · intro a
          simp only [RingHom.comp_apply]
          rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
          rw [← RingHom.comp_apply φ, hφA, hψalg]
          rfl
        · intro p
          simp only [RingHom.comp_apply]
          change ψ (φ (x p)) = ρ.hom (x p)
          by_cases h0 : p.val = 0
          · have : p = p0 := Fin.ext h0
            rw [this, hφ0, hψy, hv0]
          by_cases h1 : p.val = 1
          · have : p = p1 := Fin.ext h1
            rw [this]
            have hx1 : φ (x p1) = y p1 + y p0 * y p1 -
                ∑ a, ∑ b, algebraMap A _ (wcSrmCh A r a b) * y a * y b := by
              show φ (Ideal.Quotient.mk IR _) = _
              rw [hφX, hF1]
              simp only [map_sub, map_add, map_mul, map_sum, ← MvPolynomial.algebraMap_eq,
                Ideal.Quotient.mk_algebraMap]
              rfl
            rw [hx1]
            simp only [map_sub, map_add, map_mul, map_sum, hψalg, hψy]
            rw [Lch g v, htail v hvev hvodd, hv1]
            ring
          by_cases h2 : p.val % 2 = 0
          · rw [hφev p h0 h2, map_mul, hψy, hψy, hv0, hvev p h0 h2, mul_comm, hβ p h2]
          · rw [hφodd p h1 h2, hψy, hvodd p h1 h2]
      refine ⟨CommRingCat.ofHom ψ, ?_, ?_⟩
      · apply CommRingCat.hom_ext
        rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom]
        exact hex
      · intro ψ₂ hψ₂
        have h2 : ψ₂.hom.comp φ = ρ.hom := by
          rw [← hψ₂, CommRingCat.hom_comp, CommRingCat.hom_ofHom]
        apply CommRingCat.hom_ext
        rw [CommRingCat.hom_ofHom]
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext
        · intro a
          simp only [RingHom.comp_apply]
          rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap, hψalg]
          rw [← hφA, RingHom.comp_apply, ← RingHom.comp_apply ψ₂.hom, h2]
          rfl
        · intro p
          simp only [RingHom.comp_apply]
          change ψ₂.hom (y p) = ψ (y p)
          rw [hval _ h2 p, hψy]

  obtain ⟨φ0, hφX, hφA⟩ := s3
  have hnzd0 := s6
  obtain ⟨hgen0, hup0⟩ := s7 φ0 hφX hφA
  have e0 : wcSrmGen A r π ⟨0, by omega⟩ =
      Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmCh A r))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) := by
    have hf : (⟨2 * ((⟨0, by omega⟩ : Fin (r + 2)).val / 2),
        lt_of_le_of_lt (Nat.mul_div_le _ 2) (⟨0, by omega⟩ : Fin (r + 2)).isLt⟩ : Fin (r + 2)) =
        ⟨0, by omega⟩ := Fin.ext (by simp)
    unfold wcSrmGen
    rw [hf]
  have hb0 : φ0 (wcSrmGen A r π ⟨0, by omega⟩) =
      Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) := by
    rw [e0, hφX]
    simp [wcSrmFimg]

  choose σ hσA hσb hσJ using s4
  have hT := fun k : Fin (r + 2) =>
    s5 (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmCh A r)))
      (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmC0 A r)))
      (wcSrmGen A r π) ⟨0, by omega⟩ k (σ k) (CommRingCat.ofHom φ0) (hσb k) (hσJ k)
      (by rw [CommRingCat.hom_ofHom, hb0]; exact hnzd0)
      (by rw [CommRingCat.hom_ofHom]; exact hgen0)
      (fun B ρ h1 h2 => hup0 B ρ h1 h2)

  obtain ⟨e, he_open, he_comp, he_cov⟩ := wc_qmbt_bm_blowup_charts
    (R := CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmCh A r))) (wcSrmGen A r π) β hbl
    (fun _ => CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmC0 A r)))
    (fun k => CommRingCat.ofHom (σ k : wcQuadModelRing A (r + 2) π (wcSrmCh A r) →+*
      wcQuadModelRing A (r + 2) π (wcSrmCh A r)) ≫ CommRingCat.ofHom φ0)
    (fun k => (hT k).1) (fun k => (hT k).2.1) (fun k => (hT k).2.2)

  have KE : ∀ k : Fin (r + 2),
      Spec.map (CommRingCat.ofHom (σ k : wcQuadModelRing A (r + 2) π (wcSrmCh A r) →+*
        wcQuadModelRing A (r + 2) π (wcSrmCh A r)) ≫ CommRingCat.ofHom φ0) ≫
        wcQuadModelStr A (r + 2) π
          (Matrix.of fun p q : Fin (r + 2) =>
            if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0) =
      wcQuadModelStr A (r + 2) π
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) := by
    intro k
    have hk : φ0.comp ((σ k : wcQuadModelRing A (r + 2) π (wcSrmCh A r) →+*
        wcQuadModelRing A (r + 2) π (wcSrmCh A r)).comp
          (algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmCh A r)))) =
        algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmC0 A r)) := by
      rw [hσA k, hφA]
    simp only [wcQuadModelStr, ← Spec.map_comp]
    congr 1
    ext x
    exact RingHom.congr_fun hk x
  have hΦb : ∀ k : Fin (r + 2), (CommRingCat.ofHom (σ k : wcQuadModelRing A (r + 2) π (wcSrmCh A r) →+*
      wcQuadModelRing A (r + 2) π (wcSrmCh A r)) ≫ CommRingCat.ofHom φ0).hom (wcSrmGen A r π k) =
      Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) := by
    intro k
    show φ0 (σ k (wcSrmGen A r π k)) = _
    rw [hσb k, hb0]

  have hcrit : ∀ (k : Fin (r + 2)) (y : Spec (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmC0 A r)))),
      β (e k y) ∈ PrimeSpectrum.zeroLocus (Set.range (wcSrmGen A r π)) ↔
        Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ y.asIdeal := by
    intro k y
    have h1 : β (e k y) = Spec.map (CommRingCat.ofHom (σ k : wcQuadModelRing A (r + 2) π (wcSrmCh A r) →+*
        wcQuadModelRing A (r + 2) π (wcSrmCh A r)) ≫ CommRingCat.ofHom φ0) y := by
      rw [← he_comp k, Scheme.Hom.comp_apply]
    have h2 : (Spec.map (CommRingCat.ofHom (σ k : wcQuadModelRing A (r + 2) π (wcSrmCh A r) →+*
        wcQuadModelRing A (r + 2) π (wcSrmCh A r)) ≫ CommRingCat.ofHom φ0) y).asIdeal =
        Ideal.comap (CommRingCat.ofHom (σ k : wcQuadModelRing A (r + 2) π (wcSrmCh A r) →+*
          wcQuadModelRing A (r + 2) π (wcSrmCh A r)) ≫ CommRingCat.ofHom φ0).hom y.asIdeal := rfl
    rw [h1]
    refine (PrimeSpectrum.mem_zeroLocus _ _).trans ?_
    rw [h2, ← Ideal.span_le, ← Ideal.map_le_iff_le_comap,
      (hT k).2.1, hΦb k, Ideal.span_singleton_le_iff_mem]

  refine ⟨e, he_open, ?_, he_cov, ?_⟩
  · intro k
    rw [← Category.assoc, he_comp k, KE k]
  · intro k y
    exact hcrit k y

theorem wc_srdci_offdouble_fibre_smooth (A : Type u) [CommRing A] [IsLocalRing A] (r : ℕ) (π : A)
    (X' : Scheme.{u}) (f' : X' ⟶ Spec (.of A))
    (e : Spec (.of (wcQuadModelRing A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))) ⟶ X')
    [IsOpenImmersion e]
    (he : e ≫ f' = wcQuadModelStr A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
    (z : ↥(Limits.pullback f' (wcQmSp A)))
    (y : Spec (.of (wcQuadModelRing A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))))
    (hz : Limits.pullback.fst f' (wcQmSp A) z = e y)
    (hy : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∉ PrimeSpectrum.asIdeal y ∨
        Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
          (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∉ PrimeSpectrum.asIdeal y) :
    ∃ U : (Limits.pullback f' (wcQmSp A)).Opens, z ∈ U ∧
      Smooth (U.ι ≫ Limits.pullback.snd f' (wcQmSp A)) :=
by
  obtain ⟨O, hyO, hO⟩ := wc_qmssl_offdouble_smooth A r π y hy
  set W : X'.Opens := e ''ᵁ O with hWdef
  have hzW : Limits.pullback.fst f' (wcQmSp A) z ∈ W := by
    rw [hz]
    exact ⟨y, hyO, rfl⟩
  have hWeq : W.ι ≫ f' = (e.isoImage O).inv ≫ (O.ι ≫ wcQuadModelStr A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) := by
    rw [← he, ← Category.assoc O.ι e f', ← Scheme.Hom.isoImage_hom_ι e O, Category.assoc,
      Iso.inv_hom_id_assoc]
  have hW : Smooth (W.ι ≫ f') := by
    rw [hWeq]
    infer_instance
  set U : (Limits.pullback f' (wcQmSp A)).Opens :=
    Limits.pullback.fst f' (wcQmSp A) ⁻¹ᵁ W with hUdef
  have hzU : z ∈ U := (Scheme.Hom.mem_preimage _).mpr hzW
  have hP : IsPullback (Limits.pullback.fst f' (wcQmSp A) ∣_ W)
      (U.ι ≫ Limits.pullback.snd f' (wcQmSp A)) (W.ι ≫ f') (wcQmSp A) :=
    IsPullback.paste_vert (isPullback_morphismRestrict (Limits.pullback.fst f' (wcQmSp A)) W)
      (IsPullback.of_hasPullback f' (wcQmSp A))
  exact ⟨U, hzU, MorphismProperty.of_isPullback (P := @Smooth) hP hW⟩

theorem wc_srdci_double_fibre_not_smooth (A : Type u) [CommRing A] [IsLocalRing A] (r : ℕ) (π : A)
    (X' : Scheme.{u}) (f' : X' ⟶ Spec (.of A))
    (e : Spec (.of (wcQuadModelRing A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))) ⟶ X')
    [IsOpenImmersion e]
    (he : e ≫ f' = wcQuadModelStr A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
    (z : ↥(Limits.pullback f' (wcQmSp A)))
    (y : Spec (.of (wcQuadModelRing A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))))
    (hz : Limits.pullback.fst f' (wcQmSp A) z = e y)
    (h0 : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal y)
    (h1 : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
          (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal y) :
    ¬ ∃ U : (Limits.pullback f' (wcQmSp A)).Opens, z ∈ U ∧
      Smooth (U.ι ≫ Limits.pullback.snd f' (wcQmSp A)) :=
by
  classical

  have sLift : ∀ {P Q : Type u} [CommRing P] [CommRing Q] (f : P →+* Q), f.FormallySmooth →
      ∀ (C E : Type u) [CommRing C] [CommRing E] (u : Q →+* C) (v : P →+* E) (w : E →+* C),
      Function.Surjective w → (∀ z₁ z₂ : E, w z₁ = 0 → w z₂ = 0 → z₁ * z₂ = 0) →
      w.comp v = u.comp f → ∃ L : Q →+* E, w.comp L = u ∧ L.comp f = v := by
    intro P Q _ _ f hf C E _ _ u v w hw hsq hc
    letI := f.toAlgebra
    letI := v.toAlgebra
    letI := (u.comp f).toAlgebra
    haveI : Algebra.FormallySmooth P Q := hf
    let g : E →ₐ[P] C := { w with commutes' := fun a => RingHom.congr_fun hc a }
    let u' : Q →ₐ[P] C := { u with commutes' := fun a => rfl }
    have hnil : IsNilpotent (RingHom.ker (g : E →+* C)) := by
      refine ⟨2, ?_⟩
      rw [pow_two, Ideal.zero_eq_bot, eq_bot_iff]
      apply Ideal.mul_le.mpr
      intro z₁ h₁ z₂ h₂
      rw [Ideal.mem_bot]
      exact hsq z₁ z₂ (RingHom.mem_ker.mp h₁) (RingHom.mem_ker.mp h₂)
    let L₀ := Algebra.FormallySmooth.liftOfSurjective u' g hw hnil
    refine ⟨L₀.toRingHom, ?_, ?_⟩
    · ext b
      exact Algebra.FormallySmooth.liftOfSurjective_apply u' g hw hnil b
    · ext a
      exact L₀.commutes a

  have sChart : ∀ (K : Type u) [CommRing K] (n : ℕ) (g : K) (c : Matrix (Fin n) (Fin n) K)
      {U : Scheme.{u}} (φ : U ⟶ Spec (.of (wcQuadModelRing K n g c))) [Etale φ]
      (x : U) (V : U.Opens), x ∈ V →
      Smooth (V.ι ≫ φ ≫ wcQuadModelStr K n g c) →
      ∃ (S : Type u) (_ : CommRing S) (β : wcQuadModelRing K n g c →+* S) (𝔮 : Ideal S),
        𝔮.IsPrime ∧ β.FormallySmooth ∧
        (β.comp (algebraMap K (wcQuadModelRing K n g c))).FormallySmooth ∧
        ∀ F, F ∈ (φ x).asIdeal → β F ∈ 𝔮 := by
    intro K _ n g c U φ _ x V hxV hf₀s
    obtain ⟨x', hx'⟩ : x ∈ Set.range V.ι := by rw [Scheme.Opens.range_ι]; exact hxV
    obtain ⟨W, hW, hxW, -⟩ := exists_isAffineOpen_mem_and_subset (X := V.toScheme)
      (x := x') (U := ⊤) (Set.mem_univ _)
    let ψ : Spec Γ(V.toScheme, W) ⟶ Spec (.of (wcQuadModelRing K n g c)) :=
      hW.fromSpec ≫ V.ι ≫ φ
    haveI : Etale ψ := by dsimp only [ψ]; infer_instance
    let β' := Spec.preimage ψ
    have hβ' : Spec.map β' = ψ := Spec.map_preimage ψ
    have hβet : β'.hom.Etale := by
      apply (HasRingHomProperty.Spec_iff (P := @Etale)).mp
      rw [hβ']
      infer_instance
    have hβfs : β'.hom.FormallySmooth := by
      letI := β'.hom.toAlgebra
      haveI : Algebra.Etale (wcQuadModelRing K n g c) Γ(V.toScheme, W) := hβet
      show Algebra.FormallySmooth (wcQuadModelRing K n g c) Γ(V.toScheme, W)
      infer_instance
    have hαsm : Smooth (Spec.map
        (CommRingCat.ofHom (algebraMap K (wcQuadModelRing K n g c)) ≫ β')) := by
      rw [Spec.map_comp, hβ']
      show Smooth ((hW.fromSpec ≫ V.ι ≫ φ) ≫ wcQuadModelStr K n g c)
      rw [Category.assoc, Category.assoc]
      haveI := hf₀s
      infer_instance
    have hαfs : (β'.hom.comp (algebraMap K (wcQuadModelRing K n g c))).FormallySmooth := by
      have := (HasRingHomProperty.Spec_iff (P := @Smooth)).mp hαsm
      exact RingHom.Smooth.formallySmooth this
    obtain ⟨y, hy⟩ : x' ∈ Set.range hW.fromSpec := by
      rw [hW.range_fromSpec]; exact hxW
    refine ⟨Γ(V.toScheme, W), inferInstance, β'.hom, y.asIdeal, y.isPrime, hβfs, hαfs, ?_⟩
    intro F hF
    have h1 : ψ y = φ x := by
      show φ (V.ι (hW.fromSpec y)) = φ x
      rw [hy, hx']
    have h2 : (Spec.map β' y).asIdeal = Ideal.comap β'.hom y.asIdeal := rfl
    rw [hβ', h1] at h2
    rw [h2] at hF
    exact hF

  have sJet : ∀ (K S : Type u) [CommRing K] [CommRing S] (r : ℕ) (g : K)
      (c : Matrix (Fin (r + 2)) (Fin (r + 2)) K),
      c = (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : K) else 0) →
      ∀ (β : wcQuadModelRing K (r + 2) g c →+* S),
      (∀ (C E : Type u) [CommRing C] [CommRing E] (u : S →+* C)
        (v : wcQuadModelRing K (r + 2) g c →+* E) (w : E →+* C), Function.Surjective w →
        (∀ z₁ z₂ : E, w z₁ = 0 → w z₂ = 0 → z₁ * z₂ = 0) → w.comp v = u.comp β →
        ∃ L : S →+* E, w.comp L = u ∧ L.comp β = v) →
      (∀ (C E : Type u) [CommRing C] [CommRing E] (u : S →+* C)
        (v : K →+* E) (w : E →+* C), Function.Surjective w →
        (∀ z₁ z₂ : E, w z₁ = 0 → w z₂ = 0 → z₁ * z₂ = 0) →
        w.comp v = u.comp (β.comp (algebraMap K (wcQuadModelRing K (r + 2) g c))) →
        ∃ L : S →+* E, w.comp L = u ∧
          L.comp (β.comp (algebraMap K (wcQuadModelRing K (r + 2) g c))) = v) →
      ∀ (𝔮 : Ideal S), 𝔮.IsPrime →
      β (Ideal.Quotient.mk (wcQuadModelIdeal K (r + 2) g c)
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) ∈ 𝔮 →
      β (Ideal.Quotient.mk (wcQuadModelIdeal K (r + 2) g c)
        (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)))) ∈ 𝔮 → False := by
    intro K S _ _ r g c hc β hβL hαL 𝔮 h𝔮 hT0 hT1
    haveI := h𝔮
    set M := wcQuadModelRing K (r + 2) g c with hMdef
    set I := wcQuadModelIdeal K (r + 2) g c with hIdef
    set alg : K →+* M := algebraMap K M with halg
    set κ : K →+* S ⧸ 𝔮 := (Ideal.Quotient.mk 𝔮).comp (β.comp alg) with hκ
    have hκa : ∀ k, κ k = Ideal.Quotient.mk 𝔮 (β (alg k)) := fun k => rfl
    have halgC : ∀ k, alg k = Ideal.Quotient.mk I (MvPolynomial.C k) := by
      intro k
      rw [halg, ← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq]
    let i₀ : Fin (r + 2) := ⟨0, by omega⟩
    let i₁ : Fin (r + 2) := ⟨1, by omega⟩
    have hJ0 : (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q :
        MvPolynomial (Fin (r + 2)) K) = MvPolynomial.X i₀ * MvPolynomial.X i₁ := by
      rw [Finset.sum_eq_single i₀]
      · rw [Finset.sum_eq_single i₁]
        · rw [hc]
          simp [i₀, i₁]
        · intro q _ hq
          rw [hc]
          have hne : ¬ (i₀.val = 0 ∧ q.val = 1) := by
            rintro ⟨-, h⟩
            exact hq (Fin.ext h)
          simp only [Matrix.of_apply, if_neg hne, map_zero, zero_mul]
        · intro h
          exact absurd (Finset.mem_univ _) h
      · intro p _ hp
        apply Finset.sum_eq_zero
        intro q _
        rw [hc]
        have hne : ¬ (p.val = 0 ∧ q.val = 1) := by
          rintro ⟨h, -⟩
          exact hp (Fin.ext h)
        simp only [Matrix.of_apply, if_neg hne, map_zero, zero_mul]
      · intro h
        exact absurd (Finset.mem_univ _) h
    have hrel : Ideal.Quotient.mk I (MvPolynomial.X i₀) * Ideal.Quotient.mk I (MvPolynomial.X i₁)
        = alg g := by
      have h0 : Ideal.Quotient.mk I
          (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
            MvPolynomial.C g) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      rw [hJ0, map_sub, map_mul, ← halgC, sub_eq_zero] at h0
      exact h0
    have hg : κ g = 0 := by
      rw [hκa, ← hrel, map_mul, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mul_mem_right _ _ hT0
    have hd0 : Ideal.Quotient.mk 𝔮 (β (Ideal.Quotient.mk I (MvPolynomial.X i₀))) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr hT0
    have hd1 : Ideal.Quotient.mk 𝔮 (β (Ideal.Quotient.mk I (MvPolynomial.X i₁))) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr hT1
    set I2 : Ideal (Polynomial (S ⧸ 𝔮)) := Ideal.span {Polynomial.X ^ 2} with hI2
    set I3 : Ideal (Polynomial (S ⧸ 𝔮)) := Ideal.span {Polynomial.X ^ 3} with hI3
    obtain ⟨ev, hev⟩ : ∃ ev : Polynomial (S ⧸ 𝔮) ⧸ I2 →+* (S ⧸ 𝔮),
