  have s8 : ∀ {G : Type (u+2)} [AddCommGroup G] (m : ℕ) [NeZero m] (r y : G →+ ZMod m)
      (h : ∀ b, r b = 0 ↔ y b = 0),
        ∃ u : (ZMod m)ˣ, ∀ b, y b = (u : ZMod m) * r b := by
