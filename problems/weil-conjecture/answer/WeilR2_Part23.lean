      Functor.isContinuous_comp (wcEtBaseChange f) (wcEtBaseChange w) (Scheme.smallEtaleTopology S)
        (Scheme.smallEtaleTopology S') (Scheme.smallEtaleTopology S')
    let α : wcEtBaseChange f ⟶ wcEtBaseChange f ⋙ wcEtBaseChange w :=
