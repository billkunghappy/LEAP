    apply T.hT.hom_ext
    · rw [Category.assoc, Category.assoc, ← Limits.pullback.condition, ← Category.assoc, h1,
        Category.assoc]
    · rw [Category.assoc, Category.assoc]
      apply ext_of_isAffine
      rw [← Iso.cancel_iso_inv_left (Scheme.ΓSpecIso _)]
      apply CommRingCat.hom_ext
      rw [CommRingCat.hom_comp, CommRingCat.hom_comp]
      apply extG
      intro m k c
