  obtain ⟨r, rfl⟩ : ∃ r, n = r + 2 := ⟨n - 2, by omega⟩
  subst hc
  haveI := Dh'.additive
  haveI : P'.Additive := Adjunction.right_adjoint_additive Dh'.adj
  have appc : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (s : Γ(Z, ⊤)),
      (f ≫ g).appTop.hom s = f.appTop.hom (g.appTop.hom s) := by
    intro X Y Z f g s; rw [Scheme.Hom.comp_appTop]; rfl
  have bcnat : ∀ {V W : X'.Etale} (c : W ⟶ V),
      ((wcEtBaseChange (Limits.pullback.fst f' ξ)).map c).left ≫
        (Limits.pullback.fst V.hom (Limits.pullback.fst f' ξ) :
          ((wcEtBaseChange (Limits.pullback.fst f' ξ)).obj V).left ⟶ V.left) =
      (Limits.pullback.fst W.hom (Limits.pullback.fst f' ξ) :
