    have hnat : (G.mapHomologicalComplex (ComplexShape.up ℤ)).map T' ≫ nh.hom.app K' =
        nh.hom.app K' ≫ (G'.mapHomologicalComplex (ComplexShape.up ℤ)).map T' :=
      nh.hom.naturality T'
    have e3 := hQ H
    have hc : DerivedCategory.Q.map ((G.mapHomologicalComplex (ComplexShape.up ℤ)).map T) ≫
        DerivedCategory.Q.map χ =
        DerivedCategory.Q.map χ ≫
          DerivedCategory.Q.map ((G'.mapHomologicalComplex (ComplexShape.up ℤ)).map T') := by
      calc DerivedCategory.Q.map ((G.mapHomologicalComplex (ComplexShape.up ℤ)).map T) ≫
            DerivedCategory.Q.map χ
          = DerivedCategory.Q.map ((G.mapHomologicalComplex (ComplexShape.up ℤ)).map (T ≫ p)) ≫
            DerivedCategory.Q.map (nh.hom.app K') := by
            simp only [χ, CategoryTheory.Functor.map_comp, Category.assoc]
        _ = DerivedCategory.Q.map ((G.mapHomologicalComplex (ComplexShape.up ℤ)).map (p ≫ T')) ≫
