    (a₁ ≫ wcQuadModelStr A (r + 2) π (wcSrmC0 A r))
    (Spec.map (CommRingCat.ofHom φ)) δ (𝟙 _) (𝟙 _) eq₁ eq₂
  obtain ⟨e₁'⟩ := wc_et_coh_iso_invariance (Limits.pullback.map (a ≫ f') ξ
    (a₁ ≫ wcQuadModelStr A (r + 2) π (wcSrmC0 A r))
    (Spec.map (CommRingCat.ofHom φ)) δ (𝟙 _) (𝟙 _) eq₁ eq₂) (ℓ ^ k) 1
  obtain ⟨hfin, hcard, -⟩ := wc_qmssl_double_milnor_et_counts A ℓ hℓ π hπ r y hyc h0 h1
    B₁ Λ₁ W₁ φ₁ a₁ hsh₁ Ω φ hinj
  haveI hF : Finite (wcEtCoh (Limits.pullback (a ≫ f') ξ) (ℓ ^ k) 1) :=
    @Finite.of_equiv _ _ (hfin k 1 hk) e₁'
  exact ⟨Finite.of_equiv _ EL.symm,
    (Nat.card_congr EL).trans ((Nat.card_congr e₁').symm.trans (hcard k hk))⟩

theorem wc_etqm_r1s_charts (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    (r : ℕ) (hn : Even (r + 2)) (hn4 : 4 ≤ r + 2) (π : A)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    (X' : Scheme.{u}) (β : X' ⟶ Spec (.of (wcR1sR A r π)))
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun i : Fin (r + 2) =>
        (Scheme.ΓSpecIso (CommRingCat.of (wcR1sR A r π))).inv.hom
          (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcR1sCH A r))
            (MvPolynomial.X (⟨2 * (i.val / 2), lt_of_le_of_lt (Nat.mul_div_le i.val 2) i.isLt⟩ :
              Fin (r + 2))))))) β) :
    ∃ (φ : Fin (r + 2) → (wcR1sR A r π →+* wcR1sM A r π))
      (e : Fin (r + 2) → (Spec (.of (wcR1sM A r π)) ⟶ X')),
      (∀ j, IsOpenImmersion (e j)) ∧
      (∀ j, e j ≫ β = Spec.map (CommRingCat.ofHom (φ j))) ∧
      (∀ x : X', ∃ j, ∃ y, e j y = x) ∧
      (∀ j, (φ j).comp (algebraMap A (wcR1sR A r π)) = algebraMap A (wcR1sM A r π)) ∧
      (∀ j, e j ≫ β ≫ wcQuadModelStr A (r + 2) π (wcR1sCH A r) =
        wcQuadModelStr A (r + 2) π (wcR1sC0 A r)) ∧
      (∀ j, Ideal.map (φ j) (wcR1sJ A r π) = Ideal.span {wcR1sY0 A r π}) ∧
      wcR1sY0 A r π ∈ nonZeroDivisors (wcR1sM A r π) :=
by
  have hπ0 : π ≠ 0 := by
    intro h0
    apply IsDiscreteValuationRing.not_a_field A
    rw [hπ, h0, Ideal.span_singleton_eq_bot]
  have Lc0 : ∀ {S : Type u} [CommRing S] (g : A →+* S) (f : Fin (r + 2) → S),
      ∑ a, ∑ b, g (wcSrmC0 A r a b) * f a * f b = f ⟨0, by omega⟩ * f ⟨1, by omega⟩ := by
    intro S _ g f
    rw [Finset.sum_eq_single (⟨0, by omega⟩ : Fin (r + 2))]
    · rw [Finset.sum_eq_single (⟨1, by omega⟩ : Fin (r + 2))]
      · simp
      · intro b _ hb
        have : b.val ≠ 1 := fun h => hb (Fin.ext h)
        simp [this]
      · simp
    · intro a _ ha
      have : a.val ≠ 0 := fun h => ha (Fin.ext h)
      simp [this]
    · simp
  have Lch : ∀ {S : Type u} [CommRing S] (g : A →+* S) (f : Fin (r + 2) → S),
      ∑ a, ∑ b, g (wcSrmCh A r a b) * f a * f b = f ⟨0, by omega⟩ * f ⟨1, by omega⟩ +
        ∑ i : Fin (r + 1), ∑ b, g (wcSrmCh A r i.succ b) * f i.succ * f b := by
    intro S _ g f
    rw [Fin.sum_univ_succ]
    congr 1
    rw [Finset.sum_eq_single (⟨1, by omega⟩ : Fin (r + 2))]
    · simp
    · intro b _ hb
      have : b.val ≠ 1 := fun h => hb (Fin.ext h)
      simp [this]
    · simp
  have s3core : ∑ a, ∑ b, MvPolynomial.C (wcSrmCh A r a b) * wcSrmFimg A r a * wcSrmFimg A r b =
      MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) * MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) := by
    rw [Lch MvPolynomial.C (wcSrmFimg A r)]
    have hQ := Lch (MvPolynomial.C)
      (MvPolynomial.X : Fin (r + 2) → MvPolynomial (Fin (r + 2)) A)
    have hT : ∑ i : Fin (r + 1), ∑ b, MvPolynomial.C (wcSrmCh A r i.succ b) *
        wcSrmFimg A r i.succ * wcSrmFimg A r b =
        MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) * ∑ i : Fin (r + 1), ∑ b,
          MvPolynomial.C (wcSrmCh A r i.succ b) * MvPolynomial.X i.succ * MvPolynomial.X b := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun b _ => ?_)
      by_cases h : (Fin.succ i).val % 2 = 0 ∧ b.val = (Fin.succ i).val + 1
      · have h1 : (Fin.succ i).val ≠ 0 := by simp
        have h2 : (Fin.succ i).val ≠ 1 := by omega
        have h3 : b.val ≠ 0 := by omega
        have h4 : b.val ≠ 1 := by omega
        have h5 : ¬ (b.val % 2 = 0) := by omega
        simp only [wcSrmFimg, wcSrmCh, Matrix.of_apply, if_pos h, if_neg h1, if_neg h2, if_pos h.1,
          if_neg h3, if_neg h4, if_neg h5]
        ring
      · simp only [wcSrmCh, Matrix.of_apply, if_neg h, map_zero, zero_mul, mul_zero]
    have h0 : wcSrmFimg A r ⟨0, by omega⟩ = MvPolynomial.X ⟨0, by omega⟩ := by
      simp [wcSrmFimg]
    have h1 : wcSrmFimg A r ⟨1, by omega⟩ = MvPolynomial.X ⟨1, by omega⟩ +
        MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) * MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) -
        ∑ a, ∑ b, MvPolynomial.C (wcSrmCh A r a b) * MvPolynomial.X a * MvPolynomial.X b := by
      simp only [wcSrmFimg]
      simp
    rw [hT, h0, h1, hQ]
    ring
  have s3 : ∃ φ : wcQuadModelRing A (r + 2) π (wcSrmCh A r) →+* wcQuadModelRing A (r + 2) π (wcSrmC0 A r),
      (∀ p : Fin (r + 2), φ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmCh A r))
          (MvPolynomial.X p)) =
        Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r)) (wcSrmFimg A r p)) ∧
      φ.comp (algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmCh A r))) =
        algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmC0 A r)) := by
    let φt : MvPolynomial (Fin (r + 2)) A →+* wcQuadModelRing A (r + 2) π (wcSrmC0 A r) :=
      (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r))).comp
        (MvPolynomial.aeval (wcSrmFimg A r)).toRingHom
    have hP0 := Lc0 (MvPolynomial.C)
      (MvPolynomial.X : Fin (r + 2) → MvPolynomial (Fin (r + 2)) A)
    have haev : MvPolynomial.aeval (wcSrmFimg A r) (∑ p, ∑ q, MvPolynomial.C (wcSrmCh A r p q) *
        MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C π) =
        MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) * MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) -
          MvPolynomial.C π := by
      rw [← s3core]
      simp only [map_sub, map_sum, map_mul, MvPolynomial.aeval_X, MvPolynomial.aeval_C,
        MvPolynomial.algebraMap_eq]
    have hkey : φt (∑ p, ∑ q, MvPolynomial.C (wcSrmCh A r p q) * MvPolynomial.X p *
        MvPolynomial.X q - MvPolynomial.C π) = 0 := by
      show Ideal.Quotient.mk _ (MvPolynomial.aeval (wcSrmFimg A r) _) = 0
      rw [haev, Ideal.Quotient.eq_zero_iff_mem, ← hP0]
      exact Ideal.subset_span rfl
    have hker : ∀ a ∈ wcQuadModelIdeal A (r + 2) π (wcSrmCh A r), φt a = 0 := by
      intro a ha
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      rw [map_mul, hkey, mul_zero]
    refine ⟨Ideal.Quotient.lift _ φt hker, ?_, ?_⟩
    · intro p
      rw [Ideal.Quotient.lift_mk]
      simp [φt]
    · ext a
      show Ideal.Quotient.lift _ φt hker (Ideal.Quotient.mk _ (MvPolynomial.C a)) =
        Ideal.Quotient.mk _ (MvPolynomial.C a)
      rw [Ideal.Quotient.lift_mk]
      simp [φt]
  have s6 : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈
      nonZeroDivisors (wcQuadModelRing A (r + 2) π (wcSrmC0 A r)) := by
    have hπ := hπ0
    have hP : ∑ a, ∑ b, MvPolynomial.C (wcSrmC0 A r a b) * MvPolynomial.X a * MvPolynomial.X b =
        MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) *
          (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) : MvPolynomial (Fin (r + 2)) A) :=
      Lc0 MvPolynomial.C MvPolynomial.X
    rw [mem_nonZeroDivisors_iff_right]
    intro y hy
    obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective y
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem, wcQuadModelIdeal, hP,
      Ideal.mem_span_singleton'] at hy
    obtain ⟨h, hh⟩ := hy
    rw [Ideal.Quotient.eq_zero_iff_mem, wcQuadModelIdeal, hP]
    let e := MvPolynomial.finSuccEquiv A (r + 1)
    have f0 : (⟨0, by omega⟩ : Fin (r + 2)) = 0 := Fin.ext (by simp)
    have f1 : (⟨1, by omega⟩ : Fin (r + 2)) = (0 : Fin (r + 1)).succ := Fin.ext (by simp)
    have e0 : e (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) = Polynomial.X := by
      rw [f0]; exact MvPolynomial.finSuccEquiv_X_zero
    have e1 : e (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) =
        Polynomial.C (MvPolynomial.X 0) := by
      rw [f1]; exact MvPolynomial.finSuccEquiv_X_succ
    have eπ : e (MvPolynomial.C π) = Polynomial.C (MvPolynomial.C π) := by
      have := e.commutes π
      simpa using this
    have he := congrArg e hh
    simp only [map_mul, map_sub, e0, e1, eπ] at he
    have hc : (e h * (Polynomial.X * Polynomial.C (MvPolynomial.X 0) -
        Polynomial.C (MvPolynomial.C π))).coeff 0 = (e g * Polynomial.X).coeff 0 := by rw [he]
    rw [Polynomial.mul_coeff_zero, Polynomial.mul_coeff_zero, Polynomial.coeff_X_zero, mul_zero,
      Polynomial.coeff_sub, Polynomial.mul_coeff_zero, Polynomial.coeff_X_zero, zero_mul,
      Polynomial.coeff_C_zero, zero_sub, mul_neg, neg_eq_zero] at hc
    have hc0 : (e h).coeff 0 = 0 := by
      have hCπ : (MvPolynomial.C π : MvPolynomial (Fin (r + 1)) A) ≠ 0 := by
        rwa [Ne, MvPolynomial.C_eq_zero]
      exact (mul_eq_zero.mp hc).resolve_right hCπ
    obtain ⟨q, hq⟩ := Polynomial.X_dvd_iff.mpr hc0
    have hh1 : h = MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) * e.symm q := by
      apply e.injective
      rw [map_mul, e0, AlgEquiv.apply_symm_apply, hq]
    have hX0 : (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) : MvPolynomial (Fin (r + 2)) A) ≠ 0 :=
      MvPolynomial.X_ne_zero _
    refine Ideal.mem_span_singleton'.mpr ⟨e.symm q, ?_⟩
    apply mul_left_cancel₀ hX0
    rw [← mul_assoc, ← hh1, hh]
    ring
  have s5 : ∀ (R C : CommRingCat.{u}) {ι : Type} (b : ι → R) (k₀ k : ι)
      (σ : R ≃+* R) (φ : R ⟶ C), σ (b k) = b k₀ →
      Ideal.map (σ : R →+* R) (Ideal.span (Set.range b)) = Ideal.span (Set.range b) →
      φ.hom (b k₀) ∈ nonZeroDivisors C →
      Ideal.map φ.hom (Ideal.span (Set.range b)) = Ideal.span {φ.hom (b k₀)} →
      (∀ (B : CommRingCat.{u}) (ρ : R ⟶ B), ρ.hom (b k₀) ∈ nonZeroDivisors B →
        Ideal.map ρ.hom (Ideal.span (Set.range b)) = Ideal.span {ρ.hom (b k₀)} →
        ∃! ψ : C ⟶ B, φ ≫ ψ = ρ) →
      (CommRingCat.ofHom (σ : R →+* R) ≫ φ).hom (b k) ∈ nonZeroDivisors C ∧
      Ideal.map (CommRingCat.ofHom (σ : R →+* R) ≫ φ).hom (Ideal.span (Set.range b)) =
        Ideal.span {(CommRingCat.ofHom (σ : R →+* R) ≫ φ).hom (b k)} ∧
      ∀ (B : CommRingCat.{u}) (ρ : R ⟶ B), ρ.hom (b k) ∈ nonZeroDivisors B →
        Ideal.map ρ.hom (Ideal.span (Set.range b)) = Ideal.span {ρ.hom (b k)} →
        ∃! ψ : C ⟶ B, (CommRingCat.ofHom (σ : R →+* R) ≫ φ) ≫ ψ = ρ := by
    intro R C ι b k₀ k σ φ hσb hσJ hnzd hgen hup
    have hφ' : (CommRingCat.ofHom (σ : R →+* R) ≫ φ).hom = φ.hom.comp (σ : R →+* R) := by
      rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom]
    have hφk : (CommRingCat.ofHom (σ : R →+* R) ≫ φ).hom (b k) = φ.hom (b k₀) := by
      rw [hφ', RingHom.comp_apply, RingHom.coe_coe, hσb]
    have hσs : (σ.symm : R →+* R).comp (σ : R →+* R) = RingHom.id R := by
      ext x; simp
    have hσJ' : Ideal.map (σ.symm : R →+* R) (Ideal.span (Set.range b)) =
        Ideal.span (Set.range b) := by
      conv_lhs => rw [← hσJ]
      rw [Ideal.map_map, hσs, Ideal.map_id]
    have hσb' : σ.symm (b k₀) = b k := by rw [← hσb, RingEquiv.symm_apply_apply]
    refine ⟨by rw [hφk]; exact hnzd, ?_, ?_⟩
    · rw [hφk, hφ', ← Ideal.map_map, hσJ, hgen]
    · intro B ρ h1 h2
      let ρ' : R ⟶ B := CommRingCat.ofHom (σ.symm : R →+* R) ≫ ρ
      have hρ' : ρ'.hom = ρ.hom.comp (σ.symm : R →+* R) := by
        simp only [ρ', CommRingCat.hom_comp, CommRingCat.hom_ofHom]
      have hρ'k : ρ'.hom (b k₀) = ρ.hom (b k) := by
        rw [hρ', RingHom.comp_apply, RingHom.coe_coe, hσb']
      have h1' : ρ'.hom (b k₀) ∈ nonZeroDivisors B := by rw [hρ'k]; exact h1
      have h2' : Ideal.map ρ'.hom (Ideal.span (Set.range b)) = Ideal.span {ρ'.hom (b k₀)} := by
        rw [hρ'k, hρ', ← Ideal.map_map, hσJ', h2]
      obtain ⟨ψ, hψ, huniq⟩ := hup B ρ' h1' h2'
      have hσρ : CommRingCat.ofHom (σ : R →+* R) ≫ ρ' = ρ := by
        apply CommRingCat.hom_ext
        ext x
        simp [ρ']
      refine ⟨ψ, ?_, ?_⟩
      · show (CommRingCat.ofHom (σ : R →+* R) ≫ φ) ≫ ψ = ρ
        rw [Category.assoc, hψ, hσρ]
      · intro ψ₂ hψ₂
        apply huniq
        show φ ≫ ψ₂ = ρ'
        have : ρ' = CommRingCat.ofHom (σ.symm : R →+* R) ≫ (CommRingCat.ofHom (σ : R →+* R) ≫ φ) ≫ ψ₂ := by
          rw [hψ₂]
        rw [this]
        apply CommRingCat.hom_ext
        ext x
        simp
  have s4 : ∀ k : Fin (r + 2),
      ∃ σ : wcQuadModelRing A (r + 2) π (wcSrmCh A r) ≃+* wcQuadModelRing A (r + 2) π (wcSrmCh A r),
        (σ : wcQuadModelRing A (r + 2) π (wcSrmCh A r) →+* wcQuadModelRing A (r + 2) π (wcSrmCh A r)).comp
            (algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmCh A r))) =
          algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmCh A r)) ∧
        σ (wcSrmGen A r π k) = wcSrmGen A r π ⟨0, by omega⟩ ∧
        Ideal.map (σ : wcQuadModelRing A (r + 2) π (wcSrmCh A r) →+*
            wcQuadModelRing A (r + 2) π (wcSrmCh A r)) (Ideal.span (Set.range (wcSrmGen A r π))) =
          Ideal.span (Set.range (wcSrmGen A r π)) := by
    intro k
    obtain ⟨m, hm⟩ := hn
    have hk := k.isLt
    set t := k.val / 2 with ht
    have ht1 : 2 * t + 1 < r + 2 := by omega
    let ε : ℕ → ℕ := fun x => if x / 2 = 0 then 2 * t + x % 2 else if x / 2 = t then x % 2 else x
    have hεlt : ∀ x, x < r + 2 → ε x < r + 2 := by
      intro x hx
      simp only [ε]
      split_ifs <;> omega
    have hεε : ∀ x, ε (ε x) = x := by
      intro x
      simp only [ε]
      split_ifs <;> omega
    let f : Fin (r + 2) → Fin (r + 2) := fun p => ⟨ε p.val, hεlt p.val p.isLt⟩
    have hf : Function.Involutive f := fun p => Fin.ext (hεε p.val)
    let e : Equiv.Perm (Fin (r + 2)) := Function.Involutive.toPerm f hf
    have he : ∀ p, (e p).val = ε p.val := fun p => rfl
    have hch : ∀ p q, wcSrmCh A r (e p) (e q) = wcSrmCh A r p q := by
      intro p q
      have hq := q.isLt
      have hp := p.isLt
      have key : ((e p).val % 2 = 0 ∧ (e q).val = (e p).val + 1) ↔
          (p.val % 2 = 0 ∧ q.val = p.val + 1) := by
        rw [he, he]
        simp only [ε]
        split_ifs <;> omega
      simp only [wcSrmCh, Matrix.of_apply]
      exact if_congr key rfl rfl
    let ρe := (MvPolynomial.renameEquiv A e).toRingEquiv
    have hρe : ∀ x, ρe x = MvPolynomial.rename e x := fun x => rfl
    have hP : ρe (∑ p, ∑ q, MvPolynomial.C (wcSrmCh A r p q) * MvPolynomial.X p *
        MvPolynomial.X q - MvPolynomial.C π) =
        ∑ p, ∑ q, MvPolynomial.C (wcSrmCh A r p q) * MvPolynomial.X p *
        MvPolynomial.X q - MvPolynomial.C π := by
      rw [hρe]
      simp only [map_sub, map_sum, map_mul, MvPolynomial.rename_X, MvPolynomial.rename_C]
      congr 1
      symm
      rw [← Equiv.sum_comp e]
      refine Finset.sum_congr rfl (fun p _ => ?_)
      rw [← Equiv.sum_comp e]
      refine Finset.sum_congr rfl (fun q _ => ?_)
      rw [hch]
    have hI : wcQuadModelIdeal A (r + 2) π (wcSrmCh A r) =
        Ideal.map (ρe : MvPolynomial (Fin (r + 2)) A →+* MvPolynomial (Fin (r + 2)) A)
          (wcQuadModelIdeal A (r + 2) π (wcSrmCh A r)) := by
      have hP' : (ρe : MvPolynomial (Fin (r + 2)) A →+* MvPolynomial (Fin (r + 2)) A)
          (∑ p, ∑ q, MvPolynomial.C (wcSrmCh A r p q) * MvPolynomial.X p *
            MvPolynomial.X q - MvPolynomial.C π) =
          ∑ p, ∑ q, MvPolynomial.C (wcSrmCh A r p q) * MvPolynomial.X p *
            MvPolynomial.X q - MvPolynomial.C π := hP
      rw [wcQuadModelIdeal, Ideal.map_span, Set.image_singleton, hP']
    let σ := Ideal.quotientEquiv _ _ ρe hI
    have hσ : ∀ x, σ (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ (MvPolynomial.rename e x) :=
      fun x => Ideal.quotientEquiv_mk _ _ ρe hI x
    have hσX : ∀ p, σ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmCh A r))
        (MvPolynomial.X p)) = Ideal.Quotient.mk _ (MvPolynomial.X (e p)) := by
      intro p; rw [hσ, MvPolynomial.rename_X]
    have hgen : ∀ i : Fin (r + 2), ∃ j : Fin (r + 2), σ (wcSrmGen A r π i) = wcSrmGen A r π j ∧
        σ (wcSrmGen A r π j) = wcSrmGen A r π i := by
      intro i
      refine ⟨e ⟨2 * (i.val / 2), lt_of_le_of_lt (Nat.mul_div_le i.val 2) i.isLt⟩, ?_, ?_⟩
      · simp only [wcSrmGen]
        rw [hσX]
        congr 2
        apply Fin.ext
        simp only [he, ε]
        split_ifs <;> omega
      · simp only [wcSrmGen]
        rw [hσX]
        congr 2
        apply Fin.ext
