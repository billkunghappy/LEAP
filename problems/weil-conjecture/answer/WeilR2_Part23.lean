    rw [map_add, ZMod.val_add]
    exact pow_eq_pow_mod _ hζ
  have hζ' : ∀ k, (sE ≫ q).appTop.hom
      ((Scheme.ΓSpecIso (.of L)).inv.hom (T.ζ k)) ^ (ℓ ^ k) = 1 := by
    intro k
    have h : (sE ≫ q).appTop.hom
        ((Scheme.ΓSpecIso (.of L)).inv.hom (T.ζ k ^ (ℓ ^ k))) = 1 := by
      rw [(T.hζ k).pow_eq_one, map_one, map_one]
    simpa only [map_pow] using h

  have hwE' : wE ≫ (sE ≫ q) = (sE ≫ q) ≫ Spec.map (CommRingCat.ofHom σ) := by
    rw [← Category.assoc, hwE, Category.assoc, hw₂, Category.assoc]
