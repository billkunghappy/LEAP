theorem wc_r1s_push_kummer_delta : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] {Q T : Scheme.{u}} (h : Q ⟶ T) (fQ : Q ⟶ Spec (.of Ω)) (m : ℕ), (m : Ω) ≠ 0 → ∀ (J : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology Q) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))), ∃ (κ : (wcEtPush h).obj (wcEtGm Q) ⟶ (((wcEtPush h).mapHomologicalComplex (ComplexShape.up ℕ)).obj J.cocomplex).homology 1) (w : (m • 𝟙 ((wcEtPush h).obj (wcEtGm Q))) ≫ κ = 0), (ShortComplex.mk _ _ w).Exact :=
