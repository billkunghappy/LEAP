    have hP₀' : P₀ = Polynomial.X + Polynomial.X ^ 2 * u₀ := by rw [← hu₀]; ring
    have hP₁' : P₁ = Polynomial.X + Polynomial.X ^ 2 * u₁ := by rw [← hu₁]; ring
    have hprod : P₀ * P₁ = Polynomial.X ^ 2 +
