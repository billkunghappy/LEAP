        Limits.pullback.fst a (Limits.pullback.fst fX ξ) →
      wE ≫ Limits.pullback.snd a (Limits.pullback.fst fX ξ) =
        Limits.pullback.snd a (Limits.pullback.fst fX ξ) ≫ σQ →
      ∀ k, wE.appTop.hom (cE (z k) * bE (y k)) =
        cE (T.ζ k) ^ (PadicInt.toZModPow k t).val * (cE (z k) * bE (y k)) := by
    intro wE h1 h2 k
    have e1 : wE.appTop.hom (bE (y k)) = bE (y k) := by
      rw [hbE, ← hcomp, h1]
    have e2 : wE.appTop.hom (cE (z k)) = cE ((Spec.preimage σ).hom (z k)) := by
      rw [hcE, hcE, ← hcomp, ← Category.assoc, h2, Category.assoc, hσQ2', ← Category.assoc,
        hcomp _ (Spec.map _), hnat]
    rw [map_mul, e1, e2, hz3, map_mul, map_pow, mul_assoc]

  have hR : (Limits.pullback.fst fX ξ ≫ U.toSpecΓ).appTop.hom
      ((Scheme.ΓSpecIso (.of Γ(U, ⊤))).inv.hom (wcEtqmtX g ⟨0, by omega⟩)) =
      (Limits.pullback.fst fX ξ).appTop.hom (wcEtqmtX g ⟨0, by omega⟩) := by
    rw [hcomp]
    congr 1
    rw [Scheme.toSpecΓ_appTop]
    first
      | exact Iso.inv_hom_id_apply _ _
      | simp
  have hq1 : (Limits.pullback.snd a (Limits.pullback.fst fX ξ)).appTop.hom
      ((Limits.pullback.fst fX ξ).appTop.hom (wcEtqmtX g ⟨1, by omega⟩)) = bE x1b := by
    rw [hbE, ← hx1beq, ← hcomp (Limits.pullback.snd a (Limits.pullback.fst fX ξ))
      (Limits.pullback.fst fX ξ), ← hcomp (Limits.pullback.fst a (Limits.pullback.fst fX ξ)) a,
      Limits.pullback.condition]
  have hq2 : (Limits.pullback.snd a (Limits.pullback.fst fX ξ)).appTop.hom
      ((Limits.pullback.fst fX ξ).appTop.hom
        (fX.appTop.hom ((Scheme.ΓSpecIso (.of A)).inv.hom π))) =
      cE ((Spec.preimage ξ).hom π) := by
    rw [← hcomp (Limits.pullback.fst fX ξ) fX, Limits.pullback.condition,
      hcomp (Limits.pullback.snd fX ξ) ξ, hξ, hcE, hcomp]
  have hq3 := congrArg (fun x => (Limits.pullback.snd a (Limits.pullback.fst fX ξ)).appTop.hom
    ((Limits.pullback.fst fX ξ).appTop.hom x)) hquadU
  simp only [map_mul] at hq3
  rw [hq1, hq2] at hq3
  refine ⟨fun k => cE (z k) * bE (y k), ?_, ?_, ?_, ?_⟩
  · intro k
    show (cE (z (k + 1)) * bE (y (k + 1))) ^ ℓ = cE (z k) * bE (y k)
    rw [mul_pow, ← map_pow, ← map_pow, hz2, hy]
  · show IsUnit (cE (z 0) * bE (y 0))
    rw [hz0]
    exact (hφπ.map cE).mul ((hyu 0).map bE)
  · show cE (z 0) * bE (y 0) = _
    rw [hR, hz0, ← hq3, mul_assoc, ← map_mul, hxy, map_one, mul_one]
  · intro k
    exact key _ (Limits.pullback.lift_fst _ _ _) (Limits.pullback.lift_snd _ _ _) k

theorem wc_etqmtx1_milnor_conn (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) (π : A)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (r : ℕ)
    (U : Scheme.{u}) (g : U ⟶ Spec (.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))) (hg : Etale g)
    (fX : U ⟶ Spec (.of A)) (hfX : fX = g ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r))
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A))
    (x : ↥(Limits.pullback fX (wcQmSp A))) (hx : x ∈ wcEtqmTube g fX ⟨1, by omega⟩)
    (Bh : Type u) [CommRing Bh] [HenselianLocalRing Bh] [IsSepClosed (IsLocalRing.ResidueField Bh)]
    (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt U (Limits.pullback.fst fX (wcQmSp A) x)))
      (Scheme.Etale.forget U))
    (φ : ∀ l, Spec (.of Bh) ⟶ (W'.obj l).right.left) (a : Spec (.of Bh) ⟶ U)
    (hd : wcHalShData (Limits.pullback.fst fX (wcQmSp A) x) Bh Λ W' φ a) :
    ConnectedSpace ↥(Limits.pullback a (Limits.pullback.fst fX ξ)) :=
by
  classical

  have hxc : fX (Limits.pullback.fst fX (wcQmSp A) x) = IsLocalRing.closedPoint A := by
    have e1 : fX (Limits.pullback.fst fX (wcQmSp A) x) =
        wcQmSp A (Limits.pullback.snd fX (wcQmSp A) x) := by
      rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
    rw [e1, Subsingleton.elim (Limits.pullback.snd fX (wcQmSp A) x) (IsLocalRing.closedPoint _)]
    haveI : IsLocalHom (CommRingCat.Hom.hom (CommRingCat.ofHom (IsLocalRing.residue A))) :=
      (inferInstance : IsLocalHom (IsLocalRing.residue A))
    exact AlgebraicGeometry.Spec_closedPoint

  have hq : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
      (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∉
        PrimeSpectrum.asIdeal (g (Limits.pullback.fst fX (wcQmSp A) x)) := by
    have e1 := Scheme.Hom.preimage_basicOpen_top (Limits.pullback.fst fX (wcQmSp A) ≫ g)
      ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).inv.hom
        (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
          (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)))))
    have hx2 : x ∈ (Limits.pullback fX (wcQmSp A)).basicOpen
        ((Limits.pullback.fst fX (wcQmSp A) ≫ g).appTop.hom
        ((Scheme.ΓSpecIso (.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).inv.hom
          (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
            (MvPolynomial.X ⟨1, by omega⟩)))) := hx
    have h1 : x ∈ (TopologicalSpace.Opens.map (Limits.pullback.fst fX (wcQmSp A) ≫ g).base).obj
        ((Spec (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).basicOpen
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
              (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)))))) := by
      rw [e1]; exact hx2
    have h2 : (Limits.pullback.fst fX (wcQmSp A) ≫ g) x ∈
        (Spec (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).basicOpen
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
              (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))))) := h1
    rw [Scheme.Hom.comp_apply] at h2
    have h3 := basicOpen_eq_of_affine
      (R := CommRingCat.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))
      (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
        (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))))
    rw [h3] at h2
    exact (PrimeSpectrum.mem_basicOpen _ _).mp h2

  obtain ⟨V, hgV, hsmV⟩ := wc_qmssl_offdouble_smooth A r π
    (g (Limits.pullback.fst fX (wcQmSp A) x)) (Or.inr hq)

  have hxU' : Limits.pullback.fst fX (wcQmSp A) x ∈ g ⁻¹ᵁ V := hgV
  haveI hgE : Etale g := hg
  haveI hEr : Etale (g ∣_ V) := by
    first
    | exact MorphismProperty.of_isPullback (P := @Etale) (isPullback_morphismRestrict g V) hg
    | exact MorphismProperty.of_isPullback (P := @Etale) (isPullback_morphismRestrict g V).flip hg
  haveI hSr : Smooth (g ∣_ V) := by
    first
    | infer_instance
    | exact Etale.instSmooth (g ∣_ V)
  haveI hSV : Smooth (V.ι ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r)) := hsmV
  have hSc : Smooth ((g ∣_ V) ≫ V.ι ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r)) := by
    first
    | infer_instance
    | exact smooth_comp _ _
  have heq : (g ⁻¹ᵁ V).ι ≫ fX = (g ∣_ V) ≫ V.ι ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r) := by
    rw [hfX, ← Category.assoc, ← Category.assoc, morphismRestrict_ι]
  have hsm : Smooth ((g ⁻¹ᵁ V).ι ≫ fX) := by rw [heq]; exact hSc

  haveI hconn : ConnectedSpace ↥(Limits.pullback (a ≫ fX) ξ) :=
    wc_smooth_open_shens_milnor_fibre_conn A U fX (g ⁻¹ᵁ V) hsm ℓ (Fact.out) hℓ
      (Limits.pullback.fst fX (wcQmSp A) x) hxU' hxc Bh Λ W' φ a hd Ω ξ

  let e := Limits.pullbackRightPullbackFstIso fX ξ a
  have hsurj : Function.Surjective e.inv := by
    intro y
    exact ⟨e.hom y, Scheme.hom_inv_apply e y⟩
  exact hsurj.connectedSpace (Scheme.Hom.continuous e.inv)

theorem wc_etqmtx1_tower_limit {U XE XEi : Scheme.{u}} (h : XE ⟶ U) (πi : XEi ⟶ XE)
    (Bh : Type u) [CommRing Bh] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W : Λ ⥤ U.Etale)
    (φ : ∀ l, Spec (.of Bh) ⟶ (W.obj l).left) (a : Spec (.of Bh) ⟶ U)
    (hφ : ∀ {l l' : Λ} (t : l ⟶ l'), φ l ≫ (W.map t).left = φ l')
    (hφa : ∀ l, φ l ≫ (W.obj l).hom = a)
    (hlim : ∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (W.obj l).left),
      (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (W.map t).left = z l') →
        ∃! z₀ : T ⟶ Spec (.of Bh), ∀ l, z₀ ≫ φ l = z l) :
    ∃ (ε : ∀ l, Limits.pullback a h ⟶ Limits.pullback (W.obj l).hom h)
      (ρ : ∀ l, Limits.pullback (Limits.pullback.snd a h) πi ⟶
        Limits.pullback (Limits.pullback.snd (W.obj l).hom h) πi),
      (∀ l, ε l ≫ Limits.pullback.fst (W.obj l).hom h = Limits.pullback.fst a h ≫ φ l) ∧
      (∀ l, ε l ≫ Limits.pullback.snd (W.obj l).hom h = Limits.pullback.snd a h) ∧
      (∀ l, ρ l ≫ Limits.pullback.fst (Limits.pullback.snd (W.obj l).hom h) πi =
        Limits.pullback.fst (Limits.pullback.snd a h) πi ≫ ε l) ∧
      (∀ l, ρ l ≫ Limits.pullback.snd (Limits.pullback.snd (W.obj l).hom h) πi =
        Limits.pullback.snd (Limits.pullback.snd a h) πi) ∧
      (∀ {l l' : Λ} (t : l ⟶ l'),
        ρ l ≫ ((wcEtBaseChange πi).map ((wcEtBaseChange h).map (W.map t))).left = ρ l') ∧
      (∀ (T : Scheme.{u}) (y : ∀ l, T ⟶ Limits.pullback (Limits.pullback.snd (W.obj l).hom h) πi),
        (∀ {l l' : Λ} (t : l ⟶ l'),
          y l ≫ ((wcEtBaseChange πi).map ((wcEtBaseChange h).map (W.map t))).left = y l') →
        ∃! y₀ : T ⟶ Limits.pullback (Limits.pullback.snd a h) πi, ∀ l, y₀ ≫ ρ l = y l) :=
by

  have s1 : ∀ {Y Z : Scheme.{u}} (g : Z ⟶ Y) {V V' : Y.Etale} (f : V ⟶ V'),
      ((wcEtBaseChange g).map f).left ≫ Limits.pullback.fst V'.hom g =
        Limits.pullback.fst V.hom g ≫ f.left ∧
      ((wcEtBaseChange g).map f).left ≫ Limits.pullback.snd V'.hom g =
        Limits.pullback.snd V.hom g := by
    intro Y Z g V V' f
    constructor
    · first
        | exact Limits.pullback.lift_fst _ _ _
        | (unfold wcEtBaseChange; exact Limits.pullback.lift_fst _ _ _)
        | (erw [MorphismProperty.Over.pullback_map_left]; exact Limits.pullback.lift_fst _ _ _)
    · first
        | exact Limits.pullback.lift_snd _ _ _
        | (unfold wcEtBaseChange; exact Limits.pullback.lift_snd _ _ _)
        | (erw [MorphismProperty.Over.pullback_map_left]; exact Limits.pullback.lift_snd _ _ _)
  have hw : ∀ {l l' : Λ} (t : l ⟶ l'), (W.map t).left ≫ (W.obj l').hom = (W.obj l).hom := by
    intro l l' t
    first
      | exact MorphismProperty.Over.w (W.map t)
      | exact Over.w (W.map t).hom
      | simpa using (W.map t).w

  choose bh hbh1 hbh2 using (fun (l l' : Λ) (t : l ⟶ l') =>
    (⟨Limits.pullback.lift (Limits.pullback.fst (W.obj l).hom h ≫ (W.map t).left)
        (Limits.pullback.snd (W.obj l).hom h)
        (by rw [Category.assoc, hw t]; exact Limits.pullback.condition),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩ :
      ∃ b : Limits.pullback (W.obj l).hom h ⟶ Limits.pullback (W.obj l').hom h,
        b ≫ Limits.pullback.fst (W.obj l').hom h =
          Limits.pullback.fst (W.obj l).hom h ≫ (W.map t).left ∧
        b ≫ Limits.pullback.snd (W.obj l').hom h = Limits.pullback.snd (W.obj l).hom h))
  choose mt hmt1 hmt2 using (fun (l l' : Λ) (t : l ⟶ l') =>
    (⟨Limits.pullback.lift
        (Limits.pullback.fst (Limits.pullback.snd (W.obj l).hom h) πi ≫ bh l l' t)
        (Limits.pullback.snd (Limits.pullback.snd (W.obj l).hom h) πi)
        (by rw [Category.assoc, hbh2 l l' t]; exact Limits.pullback.condition),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩ :
      ∃ m : Limits.pullback (Limits.pullback.snd (W.obj l).hom h) πi ⟶
          Limits.pullback (Limits.pullback.snd (W.obj l').hom h) πi,
        m ≫ Limits.pullback.fst (Limits.pullback.snd (W.obj l').hom h) πi =
          Limits.pullback.fst (Limits.pullback.snd (W.obj l).hom h) πi ≫ bh l l' t ∧
        m ≫ Limits.pullback.snd (Limits.pullback.snd (W.obj l').hom h) πi =
          Limits.pullback.snd (Limits.pullback.snd (W.obj l).hom h) πi))
  have hBh : ∀ {l l' : Λ} (t : l ⟶ l'), bh l l' t = ((wcEtBaseChange h).map (W.map t)).left := by
    intro l l' t
    apply Limits.pullback.hom_ext
    · exact (hbh1 l l' t).trans (s1 h (W.map t)).1.symm
    · exact (hbh2 l l' t).trans (s1 h (W.map t)).2.symm
  have hM : ∀ {l l' : Λ} (t : l ⟶ l'),
      mt l l' t = ((wcEtBaseChange πi).map ((wcEtBaseChange h).map (W.map t))).left := by
    intro l l' t
    apply Limits.pullback.hom_ext
    · rw [hmt1 l l' t, hBh t]
      exact (s1 πi ((wcEtBaseChange h).map (W.map t))).1.symm
    · rw [hmt2 l l' t]
      exact (s1 πi ((wcEtBaseChange h).map (W.map t))).2.symm

  obtain ⟨ε, hε1, hε2⟩ : ∃ ε : ∀ l, Limits.pullback a h ⟶ Limits.pullback (W.obj l).hom h,
      (∀ l, ε l ≫ Limits.pullback.fst (W.obj l).hom h = Limits.pullback.fst a h ≫ φ l) ∧
      (∀ l, ε l ≫ Limits.pullback.snd (W.obj l).hom h = Limits.pullback.snd a h) :=
    ⟨fun l => Limits.pullback.lift (Limits.pullback.fst a h ≫ φ l) (Limits.pullback.snd a h)
        (by rw [Category.assoc, hφa l]; exact Limits.pullback.condition),
      fun l => Limits.pullback.lift_fst _ _ _, fun l => Limits.pullback.lift_snd _ _ _⟩
  obtain ⟨ρ, hρ1, hρ2⟩ : ∃ ρ : ∀ l, Limits.pullback (Limits.pullback.snd a h) πi ⟶
        Limits.pullback (Limits.pullback.snd (W.obj l).hom h) πi,
      (∀ l, ρ l ≫ Limits.pullback.fst (Limits.pullback.snd (W.obj l).hom h) πi =
        Limits.pullback.fst (Limits.pullback.snd a h) πi ≫ ε l) ∧
      (∀ l, ρ l ≫ Limits.pullback.snd (Limits.pullback.snd (W.obj l).hom h) πi =
        Limits.pullback.snd (Limits.pullback.snd a h) πi) :=
    ⟨fun l => Limits.pullback.lift (Limits.pullback.fst (Limits.pullback.snd a h) πi ≫ ε l)
        (Limits.pullback.snd (Limits.pullback.snd a h) πi)
        (by rw [Category.assoc, hε2 l]; exact Limits.pullback.condition),
      fun l => Limits.pullback.lift_fst _ _ _, fun l => Limits.pullback.lift_snd _ _ _⟩

  have hεbh : ∀ {l l' : Λ} (t : l ⟶ l'), ε l ≫ bh l l' t = ε l' := by
    intro l l' t
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc]
      rw [hbh1 l l' t, reassoc_of% (hε1 l), hφ t, hε1 l']
    · simp only [Category.assoc]
      rw [hbh2 l l' t, hε2 l, hε2 l']

  have hρmt : ∀ {l l' : Λ} (t : l ⟶ l'), ρ l ≫ mt l l' t = ρ l' := by
    intro l l' t
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc]
      rw [hmt1 l l' t, reassoc_of% (hρ1 l), hεbh t, hρ1 l']
    · simp only [Category.assoc]
      rw [hmt2 l l' t, hρ2 l, hρ2 l']
  refine ⟨ε, ρ, hε1, hε2, hρ1, hρ2, ?_, ?_⟩
  · intro l l' t
    rw [← hM t]
    exact hρmt t
  · intro T y hy
    have hy' : ∀ {l l' : Λ} (t : l ⟶ l'), y l ≫ mt l l' t = y l' := by
      intro l l' t
      rw [hM t]
      exact hy t

    have hc : ∀ {l l' : Λ} (t : l ⟶ l'),
        (y l ≫ Limits.pullback.fst (Limits.pullback.snd (W.obj l).hom h) πi ≫
          Limits.pullback.fst (W.obj l).hom h) ≫ (W.map t).left =
        y l' ≫ Limits.pullback.fst (Limits.pullback.snd (W.obj l').hom h) πi ≫
          Limits.pullback.fst (W.obj l').hom h := by
      intro l l' t
      rw [← hy' t]
      simp only [Category.assoc]
      rw [reassoc_of% (hmt1 l l' t), hbh1 l l' t]

    have hX : ∀ {l l' : Λ} (t : l ⟶ l'),
        y l ≫ Limits.pullback.fst (Limits.pullback.snd (W.obj l).hom h) πi ≫
          Limits.pullback.snd (W.obj l).hom h =
        y l' ≫ Limits.pullback.fst (Limits.pullback.snd (W.obj l').hom h) πi ≫
          Limits.pullback.snd (W.obj l').hom h := by
      intro l l' t
      rw [← hy' t]
      simp only [Category.assoc]
      rw [reassoc_of% (hmt1 l l' t), hbh2 l l' t]
    have hI : ∀ {l l' : Λ} (t : l ⟶ l'),
        y l ≫ Limits.pullback.snd (Limits.pullback.snd (W.obj l).hom h) πi =
        y l' ≫ Limits.pullback.snd (Limits.pullback.snd (W.obj l').hom h) πi := by
      intro l l' t
      rw [← hy' t]
      simp only [Category.assoc]
      rw [hmt2 l l' t]

    obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
    have hX0 : ∀ l : Λ,
        y l ≫ Limits.pullback.fst (Limits.pullback.snd (W.obj l).hom h) πi ≫
          Limits.pullback.snd (W.obj l).hom h =
        y l₀ ≫ Limits.pullback.fst (Limits.pullback.snd (W.obj l₀).hom h) πi ≫
          Limits.pullback.snd (W.obj l₀).hom h := fun l =>
      (hX (IsCofiltered.minToLeft l l₀)).symm.trans (hX (IsCofiltered.minToRight l l₀))
    have hI0 : ∀ l : Λ,
        y l ≫ Limits.pullback.snd (Limits.pullback.snd (W.obj l).hom h) πi =
        y l₀ ≫ Limits.pullback.snd (Limits.pullback.snd (W.obj l₀).hom h) πi := fun l =>
      (hI (IsCofiltered.minToLeft l l₀)).symm.trans (hI (IsCofiltered.minToRight l l₀))

    obtain ⟨z₀, hz₀, huniq⟩ := hlim T (fun l => y l ≫
      Limits.pullback.fst (Limits.pullback.snd (W.obj l).hom h) πi ≫
        Limits.pullback.fst (W.obj l).hom h) (fun t => hc t)
    have hz₀' : ∀ l, z₀ ≫ φ l = y l ≫
        Limits.pullback.fst (Limits.pullback.snd (W.obj l).hom h) πi ≫
          Limits.pullback.fst (W.obj l).hom h := hz₀

    obtain ⟨e₀, he1, he2⟩ : ∃ e : T ⟶ Limits.pullback a h,
        e ≫ Limits.pullback.fst a h = z₀ ∧
        e ≫ Limits.pullback.snd a h = y l₀ ≫
          Limits.pullback.fst (Limits.pullback.snd (W.obj l₀).hom h) πi ≫
            Limits.pullback.snd (W.obj l₀).hom h :=
