    rw [Polynomial.coeff_X_pow_self] at hcoeff
    exact one_ne_zero hcoeff


  have wcBC : ∀ (R A : Type u) [CommRing R] [CommRing A] (n : ℕ) (g : R) (c : Matrix (Fin n) (Fin n) R) (ρ : R →+* A), ∃ m : Spec (.of (wcQuadModelRing A n (ρ g) (c.map ρ))) ⟶ Spec (.of (wcQuadModelRing R n g c)), IsPullback m (wcQuadModelStr A n (ρ g) (c.map ρ)) (wcQuadModelStr R n g c) (Spec.map (CommRingCat.ofHom ρ)) ∧ ∀ (x : Spec (.of (wcQuadModelRing A n (ρ g) (c.map ρ)))) (q : Fin n), Ideal.Quotient.mk (wcQuadModelIdeal R n g c) (MvPolynomial.X q) ∈ (m x).asIdeal → Ideal.Quotient.mk (wcQuadModelIdeal A n (ρ g) (c.map ρ)) (MvPolynomial.X q) ∈ x.asIdeal := by
