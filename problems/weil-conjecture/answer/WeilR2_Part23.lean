    simp only [eΨ, eK, w, u, P, HomologicalComplex.comp_f, HomologicalComplex.single_map_f_self,
      HomologicalComplex.singleMapHomologicalComplex_inv_app_self,
      Functor.mapHomologicalComplex_map_f, Functor.map_comp, Functor.comp_map, Category.assoc,
      Iso.inv_hom_id_assoc, Iso.map_inv_hom_id_assoc]

  obtain ⟨α, β, hαβ⟩ := hA (P ⋙ Dg.Φ) _ I _ w eΨ hf
