    rw [hnat, CommRingCat.hom_ofHom, ← hquot, map_mul, map_mul]

  let cE : Ω →+* Γ(Limits.pullback a (Limits.pullback.fst fX ξ), ⊤) :=
    (Limits.pullback.snd a (Limits.pullback.fst fX ξ) ≫ Limits.pullback.snd fX ξ).appTop.hom.comp
