    have r2 : ∀ y, ConcreteCategory.hom ((PU.map (βw.app M)).val.app (Opposite.op T)) y =
        ConcreteCategory.hom (M.val.map (zw.app ((wcEtBaseChange fU).obj T)).op) y :=
      fun y => (pfMapEval DfU.φ (βw.app M) T y).trans (hβw M ((wcEtBaseChange fU).obj T) y)
    have r3 : ∀ y, ConcreteCategory.hom ((γU.app ((SheafOfModules.pushforward.{u+1} ψ').obj
        M)).val.app (Opposite.op T)) y =
        ConcreteCategory.hom (M.val.map ((wcEtSlice V').map (aU.app T)).op) y :=
      fun y => (gammaEval DfU.φ DwU.φ DfU.φ aU hφU ((SheafOfModules.pushforward.{u+1} ψ').obj M)
        T y).trans (pfObjMapEval ψ' M (aU.app T) y)
    let D := (wcEtSlice V').obj ((wcEtBaseChange wU).obj ((wcEtBaseChange fU).obj T))
    let E := (wcEtBaseChange w).obj C
    have m1 := @PresheafOfModules.map_comp_apply _ _ _ M.val (Opposite.op A) (Opposite.op E)
      (Opposite.op D) ((wcEtBaseChange w).map (z.app T)).op
      (zw.app ((wcEtBaseChange fU).obj T)).op x'
    have m2 := @PresheafOfModules.map_comp_apply _ _ _ M.val (Opposite.op A) (Opposite.op D)
      (Opposite.op C) (zw.app ((wcEtBaseChange fU).obj T) ≫ (wcEtBaseChange w).map (z.app T)).op
      ((wcEtSlice V').map (aU.app T)).op x'
    have hR : ConcreteCategory.hom ((β.hom.app (Pw.obj M) ≫ PU.map (βw.app M) ≫
        γU.app ((SheafOfModules.pushforward.{u+1} ψ').obj M)).val.app (Opposite.op T)) x =
        ConcreteCategory.hom (M.val.map ((wcEtSlice V').map (aU.app T) ≫
          zw.app ((wcEtBaseChange fU).obj T) ≫ (wcEtBaseChange w).map (z.app T)).op) x' :=
      (compEval _ _ _ x).trans ((compEval _ _ _ _).trans ((r3 _).trans
        ((congrArg _ ((r2 _).trans ((congrArg _ r1).trans m1.symm))).trans m2.symm)))
    exact hL.trans ((congrArg (fun g : C ⟶ A => ConcreteCategory.hom (M.val.map g.op) x')
      (hsite T)).trans hR.symm)

  have s5 : ∀ {S' : Scheme.{u}} {w : S' ⟶ S'} {m : ℕ} (V' : S'.Etale) {wU : V'.left ⟶ V'.left}
      [hcV' : (wcEtSlice V').IsContinuous (Scheme.smallEtaleTopology V'.left)
        (Scheme.smallEtaleTopology S')]
      (ψ' : wcEtZModRing V'.left m ⟶ ((wcEtSlice V').sheafPushforwardContinuous RingCat.{u+1}
        (Scheme.smallEtaleTopology V'.left) (Scheme.smallEtaleTopology S')).obj
          (wcEtZModRing S' m))
      (Dw : wcEtPullData w m) (DwU : wcEtPullData wU m)
      (zw : wcEtBaseChange wU ⋙ wcEtSlice V' ⟶ wcEtSlice V' ⋙ wcEtBaseChange w)
      (βw : @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange w) _ _ Dw.cont Dw.φ ⋙
        SheafOfModules.pushforward.{u+1} ψ' ⟶ SheafOfModules.pushforward.{u+1} ψ' ⋙
        @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange wU) _ _ DwU.cont DwU.φ)
      (hβw : ∀ (M : SheafOfModules.{u+1} (wcEtZModRing S' m)) (T : V'.left.Etale)
        (x : ((SheafOfModules.pushforward.{u+1} ψ').obj ((@SheafOfModules.pushforward.{u+1}
          _ _ _ _ _ _ (wcEtBaseChange w) _ _ Dw.cont Dw.φ).obj M)).val.obj (Opposite.op T)),
        (ConcreteCategory.hom ((βw.app M).val.app (Opposite.op T))) x =
          (ConcreteCategory.hom (M.val.map (zw.app T).op)) x),
      SheafOfModules.unitToPushforwardObjUnit ψ' ≫ (SheafOfModules.pushforward.{u+1} ψ').map
          (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange w) _ _
            Dw.cont Dw.φ) ≫
        βw.app (SheafOfModules.unit (wcEtZModRing S' m)) =
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange wU) _ _
          DwU.cont DwU.φ) ≫
        (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange wU) _ _ DwU.cont DwU.φ).map
          (SheafOfModules.unitToPushforwardObjUnit ψ') := by
    intro S' w m V' wU hcV' ψ' Dw DwU zw βw hβw
    haveI := Dw.cont
    haveI := DwU.cont
    apply unitExt
    intro T
    have e1 : ∀ T' : V'.left.Etale,
        ConcreteCategory.hom ((SheafOfModules.unitToPushforwardObjUnit ψ').val.app
          (Opposite.op T')) (1 : (wcEtZModRing V'.left m).obj.obj (Opposite.op T')) =
        (1 : (wcEtZModRing S' m).obj.obj (Opposite.op ((wcEtSlice V').obj T'))) :=
      fun T' => (SheafOfModules.unitToPushforwardObjUnit_val_app_apply ψ' (X := Opposite.op T')
          (1 : (wcEtZModRing V'.left m).obj.obj (Opposite.op T'))).trans
        (map_one (ConcreteCategory.hom (ψ'.hom.app (Opposite.op T'))))
    have e2 : ConcreteCategory.hom (((SheafOfModules.pushforward.{u+1} ψ').map
        (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
          (wcEtBaseChange w) _ _ Dw.cont Dw.φ)).val.app (Opposite.op T))
        (1 : (wcEtZModRing S' m).obj.obj (Opposite.op ((wcEtSlice V').obj T))) =
        (1 : (wcEtZModRing S' m).obj.obj
          (Opposite.op ((wcEtBaseChange w).obj ((wcEtSlice V').obj T)))) :=
      (pfMapEval ψ' _ T _).trans
        ((SheafOfModules.unitToPushforwardObjUnit_val_app_apply Dw.φ
          (X := Opposite.op ((wcEtSlice V').obj T))
          (1 : (wcEtZModRing S' m).obj.obj (Opposite.op ((wcEtSlice V').obj T)))).trans
          (map_one (ConcreteCategory.hom (Dw.φ.hom.app (Opposite.op ((wcEtSlice V').obj T))))))
    have e3 := hβw (SheafOfModules.unit (wcEtZModRing S' m)) T
      (1 : (wcEtZModRing S' m).obj.obj
          (Opposite.op ((wcEtBaseChange w).obj ((wcEtSlice V').obj T))))
    have e4 : ConcreteCategory.hom ((SheafOfModules.unit (wcEtZModRing S' m)).val.map
        (zw.app T).op) (1 : (wcEtZModRing S' m).obj.obj
          (Opposite.op ((wcEtBaseChange w).obj ((wcEtSlice V').obj T)))) =
        (1 : (wcEtZModRing S' m).obj.obj
          (Opposite.op ((wcEtSlice V').obj ((wcEtBaseChange wU).obj T)))) :=
      PresheafOfModules.unit_map_one _ _
    have e5 : ConcreteCategory.hom ((@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
          (wcEtBaseChange wU) _ _ DwU.cont DwU.φ).val.app (Opposite.op T))
        (1 : (wcEtZModRing V'.left m).obj.obj (Opposite.op T)) =
        (1 : (wcEtZModRing V'.left m).obj.obj (Opposite.op ((wcEtBaseChange wU).obj T))) :=
      (SheafOfModules.unitToPushforwardObjUnit_val_app_apply DwU.φ (X := Opposite.op T)
        (1 : (wcEtZModRing V'.left m).obj.obj (Opposite.op T))).trans
        (map_one (ConcreteCategory.hom (DwU.φ.hom.app (Opposite.op T))))
    have e6 := pfMapEval DwU.φ (SheafOfModules.unitToPushforwardObjUnit ψ') T
      (1 : (wcEtZModRing V'.left m).obj.obj (Opposite.op ((wcEtBaseChange wU).obj T)))
    refine (compEval _ _ _ _).trans ((compEval _ _ _ _).trans ?_)
    refine Eq.trans ?_ (compEval _ _ _ _).symm
    refine (congrArg _ ((congrArg _ (e1 T)).trans e2)).trans (e3.trans (e4.trans ?_))
    exact ((congrArg _ e5).trans (e6.trans (e1 _))).symm

  intro α αU hφ hφU P Pw PU PwU γ γU
  subst hρ hρ'
  haveI := Df.cont
  haveI := Dw.cont
  haveI := DfU.cont
  haveI := DwU.cont
  obtain ⟨ζ, hζ⟩ := s1 f (MorphismProperty.Over.mk ⊤ u hu : S.Etale)
    (MorphismProperty.Over.mk ⊤ u' hu' : S'.Etale) fU hpbf
  obtain ⟨ζw, hζw⟩ := s1 w (MorphismProperty.Over.mk ⊤ u' hu' : S'.Etale)
    (MorphismProperty.Over.mk ⊤ u' hu' : S'.Etale) wU hpbw
  obtain ⟨β, hβ⟩ := s2 (hc := hc) (hc' := hc') f (MorphismProperty.Over.mk ⊤ u hu : S.Etale)
    (MorphismProperty.Over.mk ⊤ u' hu' : S'.Etale) fU ψ ψ' Df DfU ζ
  obtain ⟨β₀, hβ₀⟩ := s2 (hc := hc') (hc' := hc') w (MorphismProperty.Over.mk ⊤ u' hu' : S'.Etale)
    (MorphismProperty.Over.mk ⊤ u' hu' : S'.Etale) wU ψ' ψ' Dw DwU ζw
  obtain ⟨μ', hμ'⟩ := muAux (MorphismProperty.Over.mk ⊤ u' hu' : S'.Etale) hc' hcc' m ψ'
  refine ⟨β, β₀.hom, μ', ?_, ?_⟩
  · exact s4 (hcV := hc) (hcV' := hc') (MorphismProperty.Over.mk ⊤ u hu : S.Etale)
      (MorphismProperty.Over.mk ⊤ u' hu' : S'.Etale) ψ ψ' Df Dw DfU DwU α αU hφ hφU
      ζ.hom ζw.hom β β₀.hom hβ hβ₀
      (s3 (MorphismProperty.Over.mk ⊤ u hu : S.Etale) (MorphismProperty.Over.mk ⊤ u' hu' : S'.Etale)
        hwU α (alphaEval hcomp) αU (alphaEval hcompU) ζ.hom hζ ζw.hom hζw)
  · rw [hμ']
    exact s5 (hcV' := hc') (MorphismProperty.Over.mk ⊤ u' hu' : S'.Etale) ψ' Dw DwU ζw.hom
      β₀.hom hβ₀

theorem wc_et_tpl_var_etale_reflect (A : Type u) [CommRing A] [IsLocalRing A] (X U : Scheme.{u})
    (fX : X ⟶ Spec (.of A)) (j : U ⟶ X) (hj : Etale j) (Ω : Type u) [Field Ω]
    (ξ : Spec (.of Ω) ⟶ Spec (.of A)) (σ : Spec (.of Ω) ⟶ Spec (.of Ω)) (ℓ k : ℕ) :
    wcEtTplStar (j ≫ fX) ξ σ ℓ k → wcEtTplStar fX ξ σ ℓ k :=
by
  classical
  intro hU
  unfold wcEtTplStar
  intro σQ hσQ1 hσQ2 Dh Dg I DσQ α hφ t ht P K Ψ Pw γ Tflat T TΨ hzero
  haveI := Dh.cont
  haveI := DσQ.cont
  haveI := Dh.additive
  haveI := DσQ.additive
  haveI := Dg.additive
  haveI hPadd : P.Additive := Adjunction.right_adjoint_additive Dh.adj
  haveI hPwadd : Pw.Additive := Adjunction.right_adjoint_additive DσQ.adj

  have hw1 : (Limits.pullback.fst (j ≫ fX) ξ ≫ j) ≫ fX = Limits.pullback.snd (j ≫ fX) ξ ≫ ξ := by
    rw [Category.assoc]; exact Limits.pullback.condition
  obtain ⟨j', hj'1, hj'2⟩ : ∃ j' : Limits.pullback (j ≫ fX) ξ ⟶ Limits.pullback fX ξ,
      j' ≫ Limits.pullback.fst fX ξ = Limits.pullback.fst (j ≫ fX) ξ ≫ j ∧
      j' ≫ Limits.pullback.snd fX ξ = Limits.pullback.snd (j ≫ fX) ξ :=
    ⟨Limits.pullback.lift _ _ hw1, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hpb : IsPullback j' (Limits.pullback.fst (j ≫ fX) ξ) (Limits.pullback.fst fX ξ) j := by
    have hout : IsPullback (j' ≫ Limits.pullback.snd fX ξ) (Limits.pullback.fst (j ≫ fX) ξ) ξ
        (j ≫ fX) := by
      rw [hj'2]; exact (IsPullback.of_hasPullback (j ≫ fX) ξ).flip
    exact IsPullback.of_right hout hj'1 (IsPullback.of_hasPullback fX ξ).flip
  have hj' : Etale j' := MorphismProperty.of_isPullback (P := @Etale) hpb.flip hj
  have hw2 : (j' ≫ σQ) ≫ Limits.pullback.fst fX ξ = Limits.pullback.fst (j ≫ fX) ξ ≫ j := by
    rw [Category.assoc, hσQ1, hj'1]
  obtain ⟨σQU, hσQj, hσQ1U⟩ : ∃ σQU : Limits.pullback (j ≫ fX) ξ ⟶ Limits.pullback (j ≫ fX) ξ,
      σQU ≫ j' = j' ≫ σQ ∧
      σQU ≫ Limits.pullback.fst (j ≫ fX) ξ = Limits.pullback.fst (j ≫ fX) ξ :=
    ⟨hpb.lift (j' ≫ σQ) (Limits.pullback.fst (j ≫ fX) ξ) hw2, hpb.lift_fst _ _ _,
      hpb.lift_snd _ _ _⟩
  have hσQ2U : σQU ≫ Limits.pullback.snd (j ≫ fX) ξ = Limits.pullback.snd (j ≫ fX) ξ ≫ σ := by
    calc σQU ≫ Limits.pullback.snd (j ≫ fX) ξ = σQU ≫ j' ≫ Limits.pullback.snd fX ξ := by
          rw [hj'2]
      _ = j' ≫ σQ ≫ Limits.pullback.snd fX ξ := by
          rw [← Category.assoc, hσQj, Category.assoc]
      _ = Limits.pullback.snd (j ≫ fX) ξ ≫ σ := by
          rw [hσQ2, ← Category.assoc, hj'2]
  have hs : IsPullback j' (σQU ≫ Limits.pullback.fst (j ≫ fX) ξ)
      (σQ ≫ Limits.pullback.fst fX ξ) j := by
    rw [hσQ1U, hσQ1]; exact hpb
  have hpbw : IsPullback j' σQU σQ j' := IsPullback.of_bot hs hσQj.symm hpb
  have hw3 : (Limits.pullback.fst (j ≫ fX) (wcQmSp A) ≫ j) ≫ fX =
      Limits.pullback.snd (j ≫ fX) (wcQmSp A) ≫ wcQmSp A := by
    rw [Category.assoc]; exact Limits.pullback.condition
  obtain ⟨js, hjs⟩ : ∃ js : Limits.pullback (j ≫ fX) (wcQmSp A) ⟶ Limits.pullback fX (wcQmSp A),
      js ≫ Limits.pullback.fst fX (wcQmSp A) = Limits.pullback.fst (j ≫ fX) (wcQmSp A) ≫ j :=
    ⟨Limits.pullback.lift _ _ hw3, Limits.pullback.lift_fst _ _ _⟩

  obtain ⟨DhU⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.fst (j ≫ fX) ξ) (ℓ ^ k)
  obtain ⟨DgU⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.fst (j ≫ fX) (wcQmSp A)) (ℓ ^ k)
  obtain ⟨DσQU⟩ := wc_et_zmod_pull_data_exists σQU (ℓ ^ k)
  obtain ⟨DjZ⟩ := wc_et_zmod_pull_data_exists js (ℓ ^ k)
  obtain ⟨Dk⟩ := wc_et_zmod_pull_data_exists
    (Limits.pullback.fst (j ≫ fX) (wcQmSp A) ≫ j) (ℓ ^ k)
  obtain ⟨Dj⟩ : Nonempty (wcEtPullData (S := X)
      (S' := (MorphismProperty.Over.mk ⊤ j hj : X.Etale).left)
      (MorphismProperty.Over.mk ⊤ j hj : X.Etale).hom (ℓ ^ k)) :=
    wc_et_zmod_pull_data_exists _ _
  obtain ⟨Dj'⟩ : Nonempty (wcEtPullData (S := Limits.pullback fX ξ)
      (S' := (MorphismProperty.Over.mk ⊤ j' hj' : (Limits.pullback fX ξ).Etale).left)
      (MorphismProperty.Over.mk ⊤ j' hj' : (Limits.pullback fX ξ).Etale).hom (ℓ ^ k)) :=
    wc_et_zmod_pull_data_exists _ _
  haveI := DhU.cont
  haveI := DσQU.cont
  haveI := DhU.additive
  haveI := DσQU.additive
  haveI := DgU.additive
  haveI := DjZ.additive
  haveI := DjZ.presLim
  haveI := DjZ.presColim

  obtain ⟨hcj, hccj⟩ := wc_et_slice_continuous (MorphismProperty.Over.mk ⊤ j hj : X.Etale)
  obtain ⟨hcj', hccj'⟩ := wc_et_slice_continuous
    (MorphismProperty.Over.mk ⊤ j' hj' : (Limits.pullback fX ξ).Etale)
  haveI := hcj
  haveI := hccj
  haveI := hcj'
  haveI := hccj'
  obtain ⟨ψ, ⟨σj⟩⟩ := wc_et_etale_pull_restrict_iso
    (MorphismProperty.Over.mk ⊤ j hj : X.Etale) (ℓ ^ k) Dj
  obtain ⟨ψ', -⟩ := wc_et_etale_pull_restrict_iso
    (MorphismProperty.Over.mk ⊤ j' hj' : (Limits.pullback fX ξ).Etale) (ℓ ^ k) Dj'
  obtain ⟨ρ, hρ⟩ : ∃ ρ : SheafOfModules.{u+1} (wcEtZModRing X (ℓ ^ k)) ⥤
      SheafOfModules.{u+1} (wcEtZModRing U (ℓ ^ k)),
      ρ = @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
        (wcEtSlice (MorphismProperty.Over.mk ⊤ j hj : X.Etale)) _ _ hcj ψ := ⟨_, rfl⟩
  obtain ⟨ρ', hρ'⟩ : ∃ ρ' : SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback fX ξ) (ℓ ^ k)) ⥤
      SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (j ≫ fX) ξ) (ℓ ^ k)),
      ρ' = @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
        (wcEtSlice (MorphismProperty.Over.mk ⊤ j' hj' : (Limits.pullback fX ξ).Etale)) _ _ hcj' ψ' :=
    ⟨_, rfl⟩
  obtain ⟨hρadd, -, -⟩ : ρ.Additive ∧ Limits.PreservesFiniteLimits ρ ∧
      Limits.PreservesFiniteColimits ρ := by
    rw [hρ]; exact wc_et_slice_module_restrict_exact
      (MorphismProperty.Over.mk ⊤ j hj : X.Etale) (ℓ ^ k) ψ
  obtain ⟨hρ'add, hρ'lim, hρ'colim⟩ : ρ'.Additive ∧ Limits.PreservesFiniteLimits ρ' ∧
      Limits.PreservesFiniteColimits ρ' := by
    rw [hρ']; exact wc_et_slice_module_restrict_exact
      (MorphismProperty.Over.mk ⊤ j' hj' : (Limits.pullback fX ξ).Etale) (ℓ ^ k) ψ'
  let PU := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
    (wcEtBaseChange (Limits.pullback.fst (j ≫ fX) ξ)) _ _ DhU.cont DhU.φ
  let PwU := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange σQU) _ _ DσQU.cont DσQU.φ
  haveI hPUadd : PU.Additive := Adjunction.right_adjoint_additive DhU.adj
  haveI hPwUadd : PwU.Additive := Adjunction.right_adjoint_additive DσQU.adj

  obtain ⟨β, βw, μ', hBC4, hBC6'⟩ := wc_et_tpl_slice_push_bc hσQ1 j hj j' hj'
    (Limits.pullback.fst (j ≫ fX) ξ) hpb σQU hσQ1U hσQj hpbw Dh DσQ DhU DσQU
    hcj hccj hcj' hccj' ψ ψ' ρ hρ ρ' hρ' hφ (wc_et_zmod_ring_hom_ext _ _ _ _ _)

  obtain ⟨α', hBC3, hBC6⟩ := wc_pltr_abs_mate DσQ.adj DσQU.adj ρ' βw _ _ μ' _ _ hBC6'

  obtain ⟨IU, θ, hθ⟩ := wc_pltr_exact_injres ρ'
    (fun J hJ => by
      haveI := hJ
      rw [hρ']
      exact wc_et_slice_restrict_preserves_injective
        (MorphismProperty.Over.mk ⊤ j' hj' : (Limits.pullback fX ξ).Etale) (ℓ ^ k) ψ' J)
    _ _ μ' I

  let tU : (DσQU.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj IU.cochainComplex ⟶
      IU.cochainComplex :=
    (DσQU.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map θ.inv ≫
      (Functor.mapHomologicalComplexCompIso (Iso.refl (ρ' ⋙ DσQU.Φ))
        (ComplexShape.up ℤ)).hom.app I.cochainComplex ≫
      (NatTrans.mapHomologicalComplex α' (ComplexShape.up ℤ)).app I.cochainComplex ≫
      (Functor.mapHomologicalComplexCompIso (Iso.refl (DσQ.Φ ⋙ ρ'))
        (ComplexShape.up ℤ)).inv.app I.cochainComplex ≫
      (ρ'.mapHomologicalComplex (ComplexShape.up ℤ)).map t ≫ θ.hom
  have hLPU := wc_pltr_abs_lift DσQ.Φ DσQU.Φ ρ' α' _ _ μ' _ _ hBC6 I.cochainComplex I.ι'
    IU.cochainComplex IU.ι' θ hθ t ht tU rfl

  let δ : Dg.Φ ⋙ DjZ.Φ ≅ ρ ⋙ DgU.Φ :=
    (wc_et_pull_data_comp_iso (Limits.pullback.fst fX (wcQmSp A)) js
        (Limits.pullback.fst (j ≫ fX) (wcQmSp A) ≫ j) hjs Dg DjZ Dk).some.symm ≪≫
      (wc_et_pull_data_comp_iso (MorphismProperty.Over.mk ⊤ j hj : X.Etale).hom
        (Limits.pullback.fst (j ≫ fX) (wcQmSp A))
        (Limits.pullback.fst (j ≫ fX) (wcQmSp A) ≫ j) rfl Dj DgU Dk).some ≪≫
      Functor.isoWhiskerRight (σj ≪≫ eqToIso hρ.symm) DgU.Φ

  obtain ⟨χ, hχ⟩ := wc_pltr_abs_conj P Pw DσQ.Φ Dg.Φ DσQ.adj γ PU PwU DσQU.Φ DgU.Φ DσQU.adj _
    ρ' ρ DjZ.Φ β βw α' δ hBC3 hBC4 I.cochainComplex IU.cochainComplex θ t tU rfl T rfl _ rfl

  have key : ∀ {C₁ : Type (u+2)} {C₂ : Type (u+2)} [Category.{u+1} C₁] [Abelian C₁]
      [HasDerivedCategory.{u+2} C₁] [Category.{u+1} C₂] [Abelian C₂] [HasDerivedCategory.{u+2} C₂]
      (F : C₁ ⥤ C₂) [F.Additive] [Limits.PreservesFiniteLimits F]
      [Limits.PreservesFiniteColimits F] (n : ℕ)
      (K : CochainComplex C₁ ℤ) (φ : K ⟶ K), n • (DerivedCategory.Q.map φ - 𝟙 _) = 0 →
      ∀ (L : CochainComplex C₂ ℤ) (ψ : L ⟶ L)
        (χ : (F.mapHomologicalComplex (ComplexShape.up ℤ)).obj K ≅ L),
        (F.mapHomologicalComplex (ComplexShape.up ℤ)).map φ ≫ χ.hom = χ.hom ≫ ψ →
        n • (DerivedCategory.Q.map ψ - 𝟙 _) = 0 := by
    intro C₁ C₂ _ _ _ _ _ _ F _ _ _ n K φ hφ0 L ψ χ hχ0
    have h := F.mapDerivedCategoryFactors_hom_naturality φ
    have e1 : F.mapDerivedCategoryFactors.hom.app K ≫
          (DerivedCategory.Q.map ((F.mapHomologicalComplex (ComplexShape.up ℤ)).map φ) - 𝟙 _) =
        F.mapDerivedCategory.map (DerivedCategory.Q.map φ - 𝟙 _) ≫
          F.mapDerivedCategoryFactors.hom.app K := by
      rw [Preadditive.comp_sub, ← h, CategoryTheory.Functor.map_sub, Preadditive.sub_comp,
        CategoryTheory.Functor.map_id]
      erw [Category.comp_id, Category.id_comp]
    have h2 : n • (DerivedCategory.Q.map
        ((F.mapHomologicalComplex (ComplexShape.up ℤ)).map φ) - 𝟙 _) = 0 := by
      rw [← cancel_epi (F.mapDerivedCategoryFactors.hom.app K), Limits.comp_zero,
        Preadditive.comp_nsmul, e1, ← Preadditive.nsmul_comp, ← CategoryTheory.Functor.map_nsmul,
        hφ0, CategoryTheory.Functor.map_zero, Limits.zero_comp]
    have e2 : DerivedCategory.Q.map χ.hom ≫ (DerivedCategory.Q.map ψ - 𝟙 _) =
        (DerivedCategory.Q.map ((F.mapHomologicalComplex (ComplexShape.up ℤ)).map φ) - 𝟙 _) ≫
          DerivedCategory.Q.map χ.hom := by
      rw [Preadditive.comp_sub, Preadditive.sub_comp, ← CategoryTheory.Functor.map_comp,
        ← CategoryTheory.Functor.map_comp, hχ0]
      erw [Category.comp_id, Category.id_comp]
    rw [← cancel_epi (DerivedCategory.Q.map χ.hom), Limits.comp_zero, Preadditive.comp_nsmul,
      e2, ← Preadditive.nsmul_comp, h2, Limits.zero_comp]
  letI := HasDerivedCategory.standard
    (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback fX (wcQmSp A)) (ℓ ^ k)))
  letI := HasDerivedCategory.standard
    (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (j ≫ fX) (wcQmSp A)) (ℓ ^ k)))
  have hzeroU := key DjZ.Φ (ℓ ^ (k - 1)) _ TΨ hzero _ _ χ hχ

  exact hU σQU hσQ1U hσQ2U DhU DgU IU DσQU (wc_et_zmod_ring_hom_ext _ _ _ _ _) tU hLPU hzeroU

theorem wc_et_tpl_excision_isolate (A : Type u) [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (n : ℕ) (π : A) (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (c : Matrix (Fin n) (Fin n) A)
    (hc : IsUnit (c + c.transpose).det)
    (U : Scheme.{u}) (e : U ⟶ Spec (.of (wcQuadModelRing A n π c))) (he : Etale e) (u : U)
    (hu : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal (e u)) :
    ∃ U' : U.Opens, u ∈ U' ∧
      ∃ (x₀ : Spec (.of (IsLocalRing.ResidueField A)) ⟶
          Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A))
        (v₀ : Spec (.of (IsLocalRing.ResidueField A)) ⟶
          Limits.pullback ((U'.ι ≫ e) ≫ wcQuadModelStr A n π c) (wcQmSp A)),
        IsClosedImmersion x₀ ∧ IsClosedImmersion v₀ ∧
        IsPullback (𝟙 _) v₀ x₀ (wcEtxcJs (wcQuadModelStr A n π c) (U'.ι ≫ e)) ∧
        ∀ y : ↥(Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A)), y ∈ Set.range x₀ ↔
          ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
            PrimeSpectrum.asIdeal (Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A) y) :=
by
  classical





  have isolated : ∀ {V B : Scheme.{u}} (φ : V ⟶ B) [Etale φ] (v : V),
      ∃ U : V.Opens, v ∈ U ∧ ∀ w ∈ U, φ w = φ v → w = v := by
    intro V B φ _ v
    haveI hlqf : LocallyQuasiFinite φ := by
      rw [HasRingHomProperty.iff_appLE (P := @LocallyQuasiFinite)]
      intro U W e
      have h := HasRingHomProperty.appLE @Etale φ ‹Etale φ› U W e
      letI := (φ.appLE U W e).hom.toAlgebra
      haveI : Algebra.Etale _ _ := RingHom.Etale.toAlgebra h
      exact RingHom.quasiFinite_algebraMap.mpr inferInstance
    haveI hd : DiscreteTopology ↑(φ ⁻¹' {φ v}) := (φ.fiberHomeo (φ v)).discreteTopology
    have hv : φ v ∈ ({φ v} : Set B) := Set.mem_singleton _
    have hopen : IsOpen ({⟨v, hv⟩} : Set ↑(φ ⁻¹' {φ v})) := isOpen_discrete _
    obtain ⟨t, ht, hteq⟩ := isOpen_induced_iff.mp hopen
    refine ⟨⟨t, ht⟩, ?_, ?_⟩
    · have : (⟨v, hv⟩ : ↑(φ ⁻¹' {φ v})) ∈ Subtype.val ⁻¹' t := by
        rw [hteq]; exact Set.mem_singleton _
      exact this
    · intro w hwU hw
      have hw' : w ∈ φ ⁻¹' {φ v} := by
        simp only [Set.mem_preimage, Set.mem_singleton_iff]; exact hw
      have : (⟨w, hw'⟩ : ↑(φ ⁻¹' {φ v})) ∈ Subtype.val ⁻¹' t := hwU
      rw [hteq, Set.mem_singleton_iff] at this
      exact congrArg Subtype.val this
  have fibrePB : ∀ (K : Type u) [Field K] (X V : Scheme.{u}) (φ : V ⟶ X) [Etale φ]
      (x₀ : Spec (.of K) ⟶ X) (v₀ : Spec (.of K) ⟶ V) [IsClosedImmersion x₀]
      [IsClosedImmersion v₀], v₀ ≫ φ = x₀ →
      (∀ v : V, φ v = x₀ (IsLocalRing.closedPoint K) → v = v₀ (IsLocalRing.closedPoint K)) →
      IsPullback (𝟙 (Spec (.of K))) v₀ x₀ φ := by
    intro K _ X V φ _ x₀ v₀ _ _ h hfib
    have hsq : 𝟙 (Spec (.of K)) ≫ x₀ = v₀ ≫ φ := by rw [Category.id_comp, h]
    let s : Spec (.of K) ⟶ Limits.pullback x₀ φ := Limits.pullback.lift (𝟙 _) v₀ hsq
    have hs1 : s ≫ Limits.pullback.fst x₀ φ = 𝟙 _ := Limits.pullback.lift_fst _ _ _
    have hs2 : s ≫ Limits.pullback.snd x₀ φ = v₀ := Limits.pullback.lift_snd _ _ _
    haveI hp : Etale (Limits.pullback.fst x₀ φ) := inferInstance
    have hle : @Etale ≤ (@IsOpenImmersion).diagonal := by
      intro A B f hf
      rw [MorphismProperty.diagonal_iff]
      haveI := hf
      infer_instance
    haveI hpost : (@IsOpenImmersion).HasOfPostcompProperty @Etale :=
      (MorphismProperty.hasOfPostcompProperty_iff_le_diagonal).mpr hle
    have hso : IsOpenImmersion s := by
      apply MorphismProperty.of_postcomp (W := @IsOpenImmersion) (W' := @Etale) s
        (Limits.pullback.fst x₀ φ) hp
      rw [hs1]; infer_instance
    have hss : Surjective s := by
      constructor
      intro z
      let pt : ↥(Spec (.of K)) := IsLocalRing.closedPoint K
      refine ⟨pt, ?_⟩
      apply (Limits.pullback.snd x₀ φ).isClosedEmbedding.injective
      have e1 : (Limits.pullback.snd x₀ φ) (s pt) = v₀ pt := by
        rw [← Scheme.Hom.comp_apply, hs2]
      have e2 : φ ((Limits.pullback.snd x₀ φ) z) = x₀ pt := by
        rw [← Scheme.Hom.comp_apply, ← Limits.pullback.condition, Scheme.Hom.comp_apply]
        congr 1
        exact Subsingleton.elim _ _
      rw [e1]
      exact (hfib _ e2).symm
    haveI : IsIso s := (isIso_iff_isOpenImmersion_and_surjective s).mpr ⟨hso, hss⟩
    exact IsPullback.of_iso_pullback ⟨hsq⟩ (asIso s) hs1 hs2
  have resSurj : ∀ {E S : Scheme.{u}} (e : E ⟶ S) [Etale e] (x : E),
      IsSepClosed (S.residueField (e x)) → Function.Surjective (e.residueFieldMap x).hom := by
    intro E S e _ x hsep
    letI : Algebra (S.presheaf.stalk (e x)) (E.presheaf.stalk x) := (e.stalkMap x).hom.toAlgebra
    haveI : IsLocalHom (algebraMap (S.presheaf.stalk (e x)) (E.presheaf.stalk x)) :=
      (inferInstance : IsLocalHom (e.stalkMap x).hom)
    haveI : Algebra.FormallyUnramified (S.presheaf.stalk (e x)) (E.presheaf.stalk x) :=
      FormallyUnramified.stalkMap e x
    haveI : Algebra.EssFiniteType (S.presheaf.stalk (e x)) (E.presheaf.stalk x) :=
      LocallyOfFiniteType.stalkMap e x
    haveI : Algebra.IsSeparable (IsLocalRing.ResidueField (S.presheaf.stalk (e x)))
        (IsLocalRing.ResidueField (E.presheaf.stalk x)) :=
      Algebra.instIsSeparableResidueFieldOfFormallyUnramified
    haveI : IsSepClosed (IsLocalRing.ResidueField (S.presheaf.stalk (e x))) := hsep
    have hs : Function.Surjective (algebraMap (IsLocalRing.ResidueField (S.presheaf.stalk (e x)))
        (IsLocalRing.ResidueField (E.presheaf.stalk x))) := IsSepClosed.algebraMap_surjective _ _
    exact hs



  haveI : Etale e := he
  have hπm : π ∈ IsLocalRing.maximalIdeal A := by
    rw [hπ]; exact Ideal.mem_span_singleton_self π
  have hε₀ : ∀ a ∈ wcQuadModelIdeal A n π c,
      ((IsLocalRing.residue A).comp MvPolynomial.constantCoeff) a = 0 := by
    intro a ha
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    have hg : MvPolynomial.constantCoeff (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p *
        MvPolynomial.X q - MvPolynomial.C π : MvPolynomial (Fin n) A) = -π := by
      simp
    rw [map_mul, RingHom.comp_apply, RingHom.comp_apply, hg, map_neg,
      (IsLocalRing.residue_eq_zero_iff π).mpr hπm, neg_zero, mul_zero]
  obtain ⟨ε, hεmk⟩ : ∃ ε : wcQuadModelRing A n π c →+* IsLocalRing.ResidueField A,
      ∀ F, ε (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) F) =
        IsLocalRing.residue A (MvPolynomial.constantCoeff F) :=
    ⟨Ideal.Quotient.lift _ _ hε₀, fun F => Ideal.Quotient.lift_mk _ _ _⟩
  have hεalg : ε.comp (algebraMap A (wcQuadModelRing A n π c)) = IsLocalRing.residue A := by
    ext a
    rw [RingHom.comp_apply, ← Ideal.Quotient.mk_algebraMap, hεmk, MvPolynomial.algebraMap_eq,
      MvPolynomial.constantCoeff_C]



  have hker : ∀ P : Spec (.of (wcQuadModelRing A n π c)),
      (∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
        PrimeSpectrum.asIdeal P) → PrimeSpectrum.asIdeal P = RingHom.ker ε := by
    intro x₀ hX
    have hQ : Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (∑ p, ∑ q, MvPolynomial.C (c p q) *
        MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C π) = 0 := by
      rw [Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.subset_span (Set.mem_singleton _)
    have ha : Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.C π) ∈
        PrimeSpectrum.asIdeal x₀ := by
      have e : Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.C π) =
          Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (∑ p, ∑ q, MvPolynomial.C (c p q) *
            MvPolynomial.X p * MvPolynomial.X q) := by
        rw [map_sub, sub_eq_zero] at hQ
        exact hQ.symm
      rw [e, map_sum]
      refine Ideal.sum_mem _ (fun p _ => ?_)
      rw [map_sum]
      refine Ideal.sum_mem _ (fun q _ => ?_)
      rw [map_mul]
      exact Ideal.mul_mem_left _ _ (hX q)
    have hb : ∀ a ∈ IsLocalRing.maximalIdeal A,
        Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.C a) ∈
          PrimeSpectrum.asIdeal x₀ := by
      intro a ha'
      rw [hπ, Ideal.mem_span_singleton'] at ha'
      obtain ⟨b, rfl⟩ := ha'
      rw [MvPolynomial.C_mul, map_mul]
      exact Ideal.mul_mem_left _ _ ha
    have hc : ∀ f : MvPolynomial (Fin n) A, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) f -
        Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (MvPolynomial.C (MvPolynomial.constantCoeff f)) ∈ PrimeSpectrum.asIdeal x₀ := by
      intro f
      induction f using MvPolynomial.induction_on
      · rename_i a
        rw [MvPolynomial.constantCoeff_C, sub_self]
        exact Ideal.zero_mem _
      · rename_i p q hp hq
        have e : Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (p + q) -
            Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
              (MvPolynomial.C (MvPolynomial.constantCoeff (p + q))) =
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) p -
              Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
                (MvPolynomial.C (MvPolynomial.constantCoeff p))) +
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) q -
              Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
                (MvPolynomial.C (MvPolynomial.constantCoeff q))) := by
          simp only [map_add]
          ring
        rw [e]
        exact Ideal.add_mem _ hp hq
      · rename_i p i _
        have e : Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (p * MvPolynomial.X i) -
            Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
              (MvPolynomial.C (MvPolynomial.constantCoeff (p * MvPolynomial.X i))) =
            Ideal.Quotient.mk (wcQuadModelIdeal A n π c) p *
              Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X i) := by
          rw [map_mul MvPolynomial.constantCoeff, MvPolynomial.constantCoeff_X, mul_zero,
            map_zero, map_zero, sub_zero, map_mul]
        rw [e]
        exact Ideal.mul_mem_left _ _ (hX i)
    apply le_antisymm
    · intro r hr
      obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective r
      rw [RingHom.mem_ker, hεmk, IsLocalRing.residue_eq_zero_iff]
      by_contra hnm
      have hu' : IsUnit (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (MvPolynomial.C (MvPolynomial.constantCoeff f))) :=
        ((IsLocalRing.notMem_maximalIdeal.mp hnm).map MvPolynomial.C).map _
      have hJ : Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (MvPolynomial.C (MvPolynomial.constantCoeff f)) ∈ PrimeSpectrum.asIdeal x₀ := by
        have h2 := Ideal.sub_mem _ hr (hc f)
        rwa [sub_sub_cancel] at h2
      exact x₀.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hJ hu')
    · intro r hr
      obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective r
      rw [RingHom.mem_ker, hεmk, IsLocalRing.residue_eq_zero_iff] at hr
      have h2 := Ideal.add_mem _ (hc f) (hb _ hr)
      rwa [sub_add_cancel] at h2



  haveI hsp : IsClosedImmersion (wcQmSp A) :=
    IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom (IsLocalRing.residue A))
      IsLocalRing.residue_surjective
  have hfstinj : Function.Injective
      (Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A)) :=
    (Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A)).isClosedEmbedding.isEmbedding.injective
  have hw : Spec.map (CommRingCat.ofHom ε) ≫ wcQuadModelStr A n π c = 𝟙 _ ≫ wcQmSp A := by
    show Spec.map (CommRingCat.ofHom ε) ≫
        Spec.map (CommRingCat.ofHom (algebraMap A (wcQuadModelRing A n π c))) =
      𝟙 _ ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))
    rw [Category.id_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hεalg]
  obtain ⟨x₀, hx₀fst, hx₀snd⟩ : ∃ x₀ : Spec (.of (IsLocalRing.ResidueField A)) ⟶
      Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A),
      x₀ ≫ Limits.pullback.fst _ _ = Spec.map (CommRingCat.ofHom ε) ∧
      x₀ ≫ Limits.pullback.snd _ _ = 𝟙 _ :=
    ⟨Limits.pullback.lift _ _ hw, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hx₀ci : IsClosedImmersion x₀ := by
    haveI : IsClosedImmersion (x₀ ≫ Limits.pullback.snd (wcQuadModelStr A n π c) (wcQmSp A)) := by
      rw [hx₀snd]; infer_instance
    exact IsClosedImmersion.of_comp x₀ (Limits.pullback.snd _ _)
  have hz₀ : PrimeSpectrum.asIdeal (Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A)
      (x₀ (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)))) = RingHom.ker ε := by
    have key : ∀ t : ↥(Spec (.of (IsLocalRing.ResidueField A))),
        PrimeSpectrum.asIdeal (Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A) (x₀ t)) =
          RingHom.ker ε := by
      intro t
      rw [← Scheme.Hom.comp_apply, hx₀fst, Spec.map_apply]
      change Ideal.comap (CommRingCat.Hom.hom (CommRingCat.ofHom ε)) (PrimeSpectrum.asIdeal t) = _
      have ht : PrimeSpectrum.asIdeal t = ⊥ :=
        (Ideal.eq_bot_or_top (PrimeSpectrum.asIdeal t)).resolve_right t.isPrime.ne_top
      rw [ht, CommRingCat.hom_ofHom, ← RingHom.ker_eq_comap_bot]
    exact key _
  have huniq : ∀ P : Spec (.of (wcQuadModelRing A n π c)),
      (∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
        PrimeSpectrum.asIdeal P) →
      P = Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A)
        (x₀ (IsLocalRing.closedPoint (IsLocalRing.ResidueField A))) :=
    fun P hP => PrimeSpectrum.ext ((hker P hP).trans hz₀.symm)
  have hrange : ∀ y : ↥(Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A)),
      y ∈ Set.range x₀ ↔
        ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
          PrimeSpectrum.asIdeal (Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A) y) := by
    intro y
    constructor
    · rintro ⟨t, rfl⟩ p
      have ht : t = IsLocalRing.closedPoint (IsLocalRing.ResidueField A) := Subsingleton.elim _ _
      rw [ht, hz₀, RingHom.mem_ker, hεmk, MvPolynomial.constantCoeff_X, map_zero]
    · intro h
      exact ⟨IsLocalRing.closedPoint (IsLocalRing.ResidueField A), hfstinj (huniq _ h).symm⟩
  have hz₀cl : IsClosed ({x₀ (IsLocalRing.closedPoint (IsLocalRing.ResidueField A))} :
      Set ↥(Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A))) := by
    have h1 : Set.range x₀ = {x₀ (IsLocalRing.closedPoint (IsLocalRing.ResidueField A))} := by
      ext y
      constructor
      · rintro ⟨t, rfl⟩
        rw [Set.mem_singleton_iff]
        congr 1
        exact Subsingleton.elim _ _
      · intro hy
        rw [Set.mem_singleton_iff] at hy
        exact ⟨_, hy.symm⟩
    rw [← h1]
    exact x₀.isClosedEmbedding.isClosed_range



  haveI : LocallyOfFiniteType (wcQuadModelStr A n π c) :=
    HasRingHomProperty.Spec_iff.mpr (RingHom.finiteType_algebraMap.mpr inferInstance)
  have hsep : IsSepClosed ((Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A)).residueField
      (x₀ (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)))) := by
    haveI : JacobsonSpace ↥(Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A)) :=
      LocallyOfFiniteType.jacobsonSpace (Limits.pullback.snd (wcQuadModelStr A n π c) (wcQmSp A))
    haveI : LocallyOfFiniteType ((Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A)).fromSpecResidueField
        (x₀ (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)))) :=
      isClosed_singleton_iff_locallyOfFiniteType.mp hz₀cl
    have hg : LocallyOfFiniteType ((Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A)).fromSpecResidueField
        (x₀ (IsLocalRing.closedPoint (IsLocalRing.ResidueField A))) ≫
        Limits.pullback.snd (wcQuadModelStr A n π c) (wcQmSp A)) := inferInstance
    have hg' : LocallyOfFiniteType (Spec.map (Spec.preimage
        ((Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A)).fromSpecResidueField
          (x₀ (IsLocalRing.closedPoint (IsLocalRing.ResidueField A))) ≫
          Limits.pullback.snd (wcQuadModelStr A n π c) (wcQmSp A)))) := by
      rwa [Spec.map_preimage]
    have hft := HasRingHomProperty.Spec_iff.mp hg'
    letI : Algebra (IsLocalRing.ResidueField A)
        ((Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A)).residueField
          (x₀ (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)))) :=
      (Spec.preimage ((Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A)).fromSpecResidueField
          (x₀ (IsLocalRing.closedPoint (IsLocalRing.ResidueField A))) ≫
          Limits.pullback.snd (wcQuadModelStr A n π c) (wcQmSp A))).hom.toAlgebra
    haveI : Algebra.FiniteType (IsLocalRing.ResidueField A)
        ((Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A)).residueField
          (x₀ (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)))) := hft
    haveI : Module.Finite (IsLocalRing.ResidueField A)
        ((Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A)).residueField
          (x₀ (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)))) :=
      finite_of_finite_type_of_isJacobsonRing _ _
    haveI : Algebra.IsAlgebraic (IsLocalRing.ResidueField A)
        ((Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A)).residueField
          (x₀ (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)))) :=
      Algebra.IsAlgebraic.of_finite _ _
    exact Algebra.IsAlgebraic.isSepClosed (F := IsLocalRing.ResidueField A)



  obtain ⟨U', huU', hiso⟩ := isolated e u
  refine ⟨U', huU', x₀, ?_⟩
  haveI hEt : Etale (U'.ι ≫ e) := inferInstance



  have hjs2 : wcEtxcJs (wcQuadModelStr A n π c) (U'.ι ≫ e) ≫
