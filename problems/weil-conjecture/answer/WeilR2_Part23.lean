theorem wc_et_qcl_plane_supp_vanish_pow (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (hℓ : ((ℓ : ℕ) : K) ≠ 0) (k : ℕ) (hk : 1 ≤ k) (e : ℕ) (he : 1 ≤ e)
    (Oh : (Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
      if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)))).Opens)
    (hOh : (Oh : Set ↥(Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
      if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0))))) =
      {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X p) ∉ y.asIdeal})
    (W : (Spec (.of (MvPolynomial (Fin (e + 1)) K))).Opens)
    (hW : (W : Set ↥(Spec (.of (MvPolynomial (Fin (e + 1)) K)))) =
        (Set.range (Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin (e + 1)) K →+* K))))ᶜ)
    (i : (W : Scheme.{u}) ⟶ (Oh : Scheme.{u})) [IsClosedImmersion i]
    (hiK : i ≫ Oh.ι ≫ wcQuadModelStr K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
          if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0) =
        W.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (e + 1)) K))))
    (D : wcEtPullData i (ℓ ^ k)) :
    Subsingleton (wcEtSuppExt D (2 * e + 1 + 1)) :=
by
  obtain ⟨hsm, hcpt, hsep⟩ := wc_hyp_quad_cone_punct_smooth_qcsep K e Oh hOh
  haveI := hsm
  haveI := hcpt
  haveI := hsep
  haveI := wc_mvpoly_spec_smooth_reldim K (e + 1)
  have hcomp : SmoothOfRelativeDimension (0 + (e + 1))
      (W.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (e + 1)) K)))) :=
    smoothOfRelativeDimension_comp 0 (e + 1) W.ι _
  rw [Nat.zero_add, ← hiK] at hcomp
  haveI := hcomp
  have hne : Nonempty ↥(W : Scheme.{u}) := by
    let x : Spec (.of (MvPolynomial (Fin (e + 1)) K)) := ⟨⊥, Ideal.isPrime_bot⟩
    have hx : x ∈ (W : Set ↥(Spec (.of (MvPolynomial (Fin (e + 1)) K)))) := by
      rw [hW]
      intro hr
      have h0 := ((wc_affine_origin_range_iff K (e + 1) x).mp hr) 0
      exact MvPolynomial.X_ne_zero (0 : Fin (e + 1)) h0
    exact ⟨⟨x, hx⟩⟩
  have s4 : ∀ D₁ : wcEtPullData i ℓ, Finite (wcEtSuppExt D₁ (2 * e + 1 + 1)) ∧
      Nat.card (wcEtSuppExt D₁ (2 * e + 1 + 1)) ≤ 1 := by
    intro D₁
    obtain ⟨φ⟩ := wc_et_smooth_pair_purity_ext_equiv K
      (Oh.ι ≫ wcQuadModelStr K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
          if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0))
      (2 * e + 1) (e + 1) e (by omega) i ℓ hℓ hne D₁ 2
    haveI h2 := wc_rpss_punct_affine_low_vanishing K (e + 1) ℓ hℓ W hW 2 (by norm_num) (by omega)
    obtain ⟨ψ⟩ := wc_et_zmodext_coh_equiv (W : Scheme.{u}) ℓ 2
    haveI := ψ.subsingleton
    have hs : Subsingleton (wcEtSuppExt D₁ (2 + 2 * e)) := φ.symm.subsingleton
    have hidx : 2 + 2 * e = 2 * e + 1 + 1 := by omega
    rw [hidx] at hs
    exact ⟨Finite.of_subsingleton, Finite.card_le_one_iff_subsingleton.mpr hs⟩
  obtain ⟨hfin, hcard⟩ := wc_et_supp_ext_card_pow_of_prime i ℓ k hk (2 * e + 1 + 1) 1 s4 D
  rw [one_pow] at hcard
  exact Finite.card_le_one_iff_subsingleton.mp hcard

theorem wc_et_qcl_odd_open_zmod_vanish_pow (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (hℓ : ((ℓ : ℕ) : K) ≠ 0) (e : ℕ) (he : 1 ≤ e)
    (Oh : (Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
      if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)))).Opens)
    (hOh : (Oh : Set ↥(Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
      if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0))))) =
      {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
        if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0)) (MvPolynomial.X p) ∉ y.asIdeal})
    (Uodd : (Oh : Scheme.{u}).Opens)
    (hU : ∀ y : ↥(Oh : Scheme.{u}), y ∈ Uodd ↔ ∃ k : Fin (e + 1),
        Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
          if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0))
          (MvPolynomial.X (⟨2 * k.val + 1, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1))) ∉
          (Oh.ι y).asIdeal) :
    ∀ k : ℕ, 1 ≤ k → Subsingleton (wcEtZModExt (Uodd : Scheme.{u}) (ℓ ^ k) (4 * e)) :=
by
  classical
  have hE1 := wc_hyp_quad_cone_even_open_coh_equiv K ℓ hℓ e
  revert Oh hOh Uodd hU hE1
  generalize hMAT : (Matrix.of fun p q : Fin (2 * e + 1 + 1) =>
    if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0) = MAT
  intro Oh hOh Uodd hU hE1
  have hMATpq : ∀ p q : Fin (2 * e + 1 + 1),
      MAT p q = if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : K) else 0 := by
    intro p q; rw [← hMAT]; rfl
  have hSpecI : ∀ {A B : Type u} [CommRing A] [CommRing B] (f : A →+* B) (y : Spec (.of B)),
      (Spec.map (CommRingCat.ofHom f) y).asIdeal = Ideal.comap f y.asIdeal := by
    intro A B _ _ f y
    rw [Spec.map_apply]
    rfl

  have hsurjc : Function.Surjective
      (MvPolynomial.constantCoeff : MvPolynomial (Fin (e + 1)) K →+* K) :=
    fun r => ⟨MvPolynomial.C r, MvPolynomial.constantCoeff_C _ r⟩
  haveI hcc : IsClosedImmersion (Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff : MvPolynomial (Fin (e + 1)) K →+* K))) :=
    IsClosedImmersion.spec_of_surjective _ hsurjc
  obtain ⟨W, hW⟩ : ∃ W : (Spec (.of (MvPolynomial (Fin (e + 1)) K))).Opens,
      (W : Set ↥(Spec (.of (MvPolynomial (Fin (e + 1)) K)))) =
        (Set.range (Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin (e + 1)) K →+* K))))ᶜ :=
    ⟨⟨_, (Scheme.Hom.isClosedEmbedding _).isClosed_range.isOpen_compl⟩, rfl⟩
  have hE : (W : Set (Spec (.of (MvPolynomial (Fin (e + 1)) K)))) =
      {x | ∃ j : Fin (e + 1), j.val < e + 1 ∧
        (MvPolynomial.X j : MvPolynomial (Fin (e + 1)) K) ∉ x.asIdeal} := by
    rw [hW]
    ext x
    rw [Set.mem_compl_iff, wc_affine_origin_range_iff K (e + 1) x, not_forall]
    exact ⟨fun ⟨j, hj⟩ => ⟨j, j.isLt, hj⟩, fun ⟨j, _, hj⟩ => ⟨j, hj⟩⟩
  have hW0 : Subsingleton (wcEtCoh (W : Scheme.{u}) ℓ (4 * e)) :=
    wc_et_affine_partial_punct_vanishing K ℓ Fact.out hℓ (e + 1) (e + 1) le_rfl W hE (4 * e)
      (by omega)

  obtain ⟨Ou, hOu⟩ : ∃ Ou : (Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 MAT))).Opens,
      (Ou : Set (Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 MAT)))) =
        {y | ∃ k : Fin (e + 1), Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
          (MvPolynomial.X (⟨2 * k.val, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1))) ∉
            y.asIdeal} := by
    have heq : {y : Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 MAT)) | ∃ k : Fin (e + 1),
        Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
          (MvPolynomial.X (⟨2 * k.val, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1))) ∉
            y.asIdeal} =
        (PrimeSpectrum.zeroLocus (Set.range fun k : Fin (e + 1) =>
          Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
            (MvPolynomial.X (⟨2 * k.val, by have := k.isLt; omega⟩ : Fin (2 * e + 1 + 1)))))ᶜ := by
      ext y
      constructor
      · rintro ⟨k, hk⟩ h
        exact hk ((PrimeSpectrum.mem_zeroLocus _ _).mp h ⟨k, rfl⟩)
      · intro h
        by_contra hc
        apply h
        refine (PrimeSpectrum.mem_zeroLocus _ _).mpr ?_
        rintro _ ⟨k, rfl⟩
        by_contra hk
        exact hc ⟨k, hk⟩
    exact ⟨⟨{y : Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 MAT)) | ∃ k : Fin (e + 1),
        Ideal.Quotient.mk (wcQuadModelIdeal K (2 * e + 1 + 1) 0 MAT)
