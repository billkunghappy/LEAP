  have hC2 := wc_etsm_T_section_formula hσQ1 Dh DσQ I Pf ev hnat Pm hpre hφ t ht
    (W'.obj l).right (n : ℤ) c1

  have hcl1 := hconj DσQ.Φ ((DσQ.adj.homEquiv _ _).symm
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange σQ) _ _ DσQ.cont DσQ.φ))
    t ht ((wcEtBaseChange (Limits.pullback.fst fZ ξ)).obj (W'.obj l).right) _ c1 Tx hc1 hC2

  obtain ⟨Dα⟩ := wc_et_zmod_pull_data_exists (α.app (W'.obj l).right).left m
  obtain ⟨Dfst⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.fst
    ((wcEtBaseChange (Limits.pullback.fst fZ ξ)).obj (W'.obj l).right).hom σQ) m
  obtain ⟨Dτ⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.lift
    (Limits.pullback.fst (W'.obj l).right.hom (Limits.pullback.fst fZ ξ))
    (Limits.pullback.snd (W'.obj l).right.hom (Limits.pullback.fst fZ ξ) ≫ σQ)
