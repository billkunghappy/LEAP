            (h n k 1)
      intro x
      induction x using Localization.induction_on with
      | H y =>
        obtain ⟨a, s, hs⟩ := y
        obtain ⟨k, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hs
        exact key a k

  have s1 : ∀ (f g : E ⟶ Limits.pullback sE T.πi),
      f ≫ Limits.pullback.fst sE T.πi = g ≫ Limits.pullback.fst sE T.πi →
      (∀ (m k : ℕ) (c : L),
        (f ≫ Limits.pullback.snd sE T.πi ≫ T.gi).appTop.hom
          ((Scheme.ΓSpecIso (.of (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))).inv.hom
