theorem wc_et_supp_boundary_lift_pos : ∀ {Y' Z' O' : Scheme.{u}} (i' : Z' ⟶ Y') [IsClosedImmersion i'] (j' : O' ⟶ Y') [IsOpenImmersion j'], Set.range j' = (Set.range i')ᶜ → ∀ (m : ℕ), 0 < m → ∀ (D' : wcEtPullData i' m) (Dj' : wcEtPullData j' m) (s : ℕ) (y : wcEtSuppExt D' (s + 1)), wcEtSuppClass D' (s + 1) y = 0 → ∃ a' : wcEtZModExt O' m s, ∀ {Y Z O : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i] (j : O ⟶ Y) [IsOpenImmersion j], Set.range j = (Set.range i)ᶜ → ∀ (f : Y' ⟶ Y) (w : O' ⟶ O), w ≫ j = j' ≫ f → ∀ (D : wcEtPullData i m) (Ef : wcEtPullData f m) (γ : wcEtSuppObj D' ⟶ Ef.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap D' ≫ γ = Ef.μ.inv ≫ Ef.Φ.map (wcEtSuppUnitMap D) → ∀ (Dw : wcEtPullData w m) (b : wcEtZModExt O m s), wcEtPull Dw s b = a' → ∃ θ : wcEtSuppExt D (s + 1), wcEtSuppRestr D Ef D' γ (s + 1) θ = y :=
