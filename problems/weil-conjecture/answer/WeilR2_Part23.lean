      Scheme.Hom.comp_apply]
    congr 1
    exact Subsingleton.elim _ _
  obtain ⟨v, hv1, -⟩ := Scheme.Pullback.exists_preimage_pullback u' _ hlift



  have hjsv : wcEtxcJs (wcQuadModelStr A n π c) (U'.ι ≫ e) v =
      x₀ (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) := by
    apply hfstinj
    rw [← Scheme.Hom.comp_apply, hjs1, Scheme.Hom.comp_apply, hv1, hu'e, heu]
  have hfib : ∀ w, wcEtxcJs (wcQuadModelStr A n π c) (U'.ι ≫ e) w =
      x₀ (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) → w = v := by
    intro w hw
    have h1 : e (U'.ι (Limits.pullback.fst ((U'.ι ≫ e) ≫ wcQuadModelStr A n π c) (wcQmSp A) w)) =
