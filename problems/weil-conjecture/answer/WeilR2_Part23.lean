theorem wc_etsm_push_slice_bc {S' : Scheme.{u}} {w : S' ⟶ S'} {m : ℕ} (Dw : wcEtPullData w m)
    (V V' : S'.Etale) (fU : V'.left ⟶ V.left) (hpb : IsPullback V'.hom fU w V.hom)
    [(wcEtSlice V).IsContinuous (Scheme.smallEtaleTopology V.left) (Scheme.smallEtaleTopology S')]
    [(wcEtSlice V').IsContinuous (Scheme.smallEtaleTopology V'.left) (Scheme.smallEtaleTopology S')]
    (ψ : wcEtZModRing V.left m ⟶ ((wcEtSlice V).sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.smallEtaleTopology V.left) (Scheme.smallEtaleTopology S')).obj (wcEtZModRing S' m))
    (ψ' : wcEtZModRing V'.left m ⟶ ((wcEtSlice V').sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.smallEtaleTopology V'.left) (Scheme.smallEtaleTopology S')).obj (wcEtZModRing S' m))
    (D : wcEtPullData fU m) :
    ∃ β : @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange w) _ _ Dw.cont Dw.φ ⋙
          SheafOfModules.pushforward.{u+1} ψ ≅
        SheafOfModules.pushforward.{u+1} ψ' ⋙
          @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange fU) _ _ D.cont D.φ,
      ∀ (M : SheafOfModules.{u+1} (wcEtZModRing S' m)) (T : V.left.Etale)
        (ζ : (wcEtSlice V').obj ((wcEtBaseChange fU).obj T) ⟶
          (wcEtBaseChange w).obj ((wcEtSlice V).obj T)),
        ζ.left ≫ Limits.pullback.fst (T.hom ≫ V.hom) w = Limits.pullback.fst T.hom fU →
        ζ.left ≫ Limits.pullback.snd (T.hom ≫ V.hom) w = Limits.pullback.snd T.hom fU ≫ V'.hom →
        ∀ x : ((SheafOfModules.pushforward.{u+1} ψ).obj
            ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange w) _ _ Dw.cont Dw.φ).obj
              M)).val.obj (Opposite.op T),
          ((β.hom.app M).val.app (Opposite.op T)).hom x = (M.val.map ζ.op).hom x :=
by
  classical
  have zmodExt : ∀ (Y : Scheme.{u}) (m : ℕ)
      (R : Sheaf (Scheme.smallEtaleTopology Y) RingCat.{u+1}) (φ ψ : wcEtZModRing Y m ⟶ R),
      φ = ψ := by
    intro Y m R φ ψ
    have key : ∀ (T : Type (u+1)) [Semiring T] (f g : ULift.{u+1} (ZMod m) →+* T), f = g := by
      intro T _ f g
      have h : f.comp (ULift.ringEquiv : ULift.{u+1} (ZMod m) ≃+* ZMod m).symm.toRingHom =
          g.comp (ULift.ringEquiv : ULift.{u+1} (ZMod m) ≃+* ZMod m).symm.toRingHom :=
        Subsingleton.elim _ _
      ext x
      exact RingHom.congr_fun h x.down
    apply ((sheafificationAdjunction (Scheme.smallEtaleTopology Y) RingCat.{u+1}).homEquiv _
      R).injective
    apply NatTrans.ext
    funext U
    apply RingCat.hom_ext
    exact key _ _ _
  have hBCfst : ∀ {X Y : Scheme.{u}} (h : X ⟶ Y) {A B : Y.Etale} (g : A ⟶ B),
      ((wcEtBaseChange h).map g).left ≫ Limits.pullback.fst B.hom h =
        Limits.pullback.fst A.hom h ≫ g.left := by
    intro X Y h A B g
    exact Limits.pullback.lift_fst _ _ _
  have hBCsnd : ∀ {X Y : Scheme.{u}} (h : X ⟶ Y) {A B : Y.Etale} (g : A ⟶ B),
      ((wcEtBaseChange h).map g).left ≫ Limits.pullback.snd B.hom h =
        Limits.pullback.snd A.hom h := by
    intro X Y h A B g
    exact Limits.pullback.lift_snd _ _ _
  have sqAux : ∀ {P₁ P₂ Q₁ Q₂ A₁ A₂ B₁ B₂ Z : Scheme.{u}} (a : P₁ ⟶ P₂) (b : Q₁ ⟶ Q₂)
      (e₁ : P₁ ⟶ Q₁) (e₂ : P₂ ⟶ Q₂) (x₁ : P₁ ⟶ A₁) (x₂ : P₂ ⟶ A₂) (y₁ : P₁ ⟶ B₁) (y₂ : P₂ ⟶ B₂)
      (p₁ : Q₁ ⟶ A₁) (p₂ : Q₂ ⟶ A₂) (q₁ : Q₁ ⟶ Z) (q₂ : Q₂ ⟶ Z) (gA : A₁ ⟶ A₂) (v₁ : B₁ ⟶ Z)
      (v₂ : B₂ ⟶ Z)
      (hext : ∀ φ ψ : P₁ ⟶ Q₂, φ ≫ p₂ = ψ ≫ p₂ → φ ≫ q₂ = ψ ≫ q₂ → φ = ψ)
      (h1 : e₁ ≫ p₁ = x₁) (h2 : e₂ ≫ p₂ = x₂) (h3 : e₁ ≫ q₁ = y₁ ≫ v₁) (h4 : e₂ ≫ q₂ = y₂ ≫ v₂)
      (ha1 : a ≫ x₂ = x₁ ≫ gA) (ha2 : a ≫ y₂ ≫ v₂ = y₁ ≫ v₁) (hb1 : b ≫ p₂ = p₁ ≫ gA)
      (hb2 : b ≫ q₂ = q₁),
      a ≫ e₂ = e₁ ≫ b := by
    intro P₁ P₂ Q₁ Q₂ A₁ A₂ B₁ B₂ Z a b e₁ e₂ x₁ x₂ y₁ y₂ p₁ p₂ q₁ q₂ gA v₁ v₂ hext h1 h2 h3 h4
      ha1 ha2 hb1 hb2
    apply hext
    · rw [Category.assoc, Category.assoc, h2, ha1, hb1, ← Category.assoc, h1]
    · rw [Category.assoc, Category.assoc, h4, ha2, hb2, h3]

  have s1 : ∀ {S S' : Scheme.{u}} (f : S' ⟶ S) (V : S.Etale) (V' : S'.Etale)
      (fU : V'.left ⟶ V.left) (hpb : IsPullback V'.hom fU f V.hom),
      ∃ ζ : wcEtBaseChange fU ⋙ wcEtSlice V' ≅ wcEtSlice V ⋙ wcEtBaseChange f,
        ∀ T : V.left.Etale,
          (ζ.hom.app T).left ≫ Limits.pullback.fst (T.hom ≫ V.hom) f =
            Limits.pullback.fst T.hom fU ∧
          (ζ.hom.app T).left ≫ Limits.pullback.snd (T.hom ≫ V.hom) f =
            Limits.pullback.snd T.hom fU ≫ V'.hom := by
    intro S S' f V V' fU hpb
    have hT : ∀ T : V.left.Etale, IsPullback (Limits.pullback.fst T.hom fU)
        (Limits.pullback.snd T.hom fU ≫ V'.hom) (T.hom ≫ V.hom) f :=
      fun T => (IsPullback.paste_horiz (IsPullback.of_hasPullback T.hom fU).flip hpb).flip
    let e : ∀ T : V.left.Etale, ((wcEtBaseChange fU ⋙ wcEtSlice V').obj T) ≅
        ((wcEtSlice V ⋙ wcEtBaseChange f).obj T) :=
      fun T => MorphismProperty.Over.isoMk (hT T).isoPullback (hT T).isoPullback_hom_snd
    refine ⟨NatIso.ofComponents e ?_,
      fun T => ⟨(hT T).isoPullback_hom_fst, (hT T).isoPullback_hom_snd⟩⟩
    intro T₁ T₂ g
    apply MorphismProperty.Over.Hom.ext
    exact sqAux ((wcEtBaseChange fU).map g).left ((wcEtBaseChange f).map ((wcEtSlice V).map g)).left
      (hT T₁).isoPullback.hom (hT T₂).isoPullback.hom
      (Limits.pullback.fst T₁.hom fU) (Limits.pullback.fst T₂.hom fU)
      (Limits.pullback.snd T₁.hom fU) (Limits.pullback.snd T₂.hom fU)
      (Limits.pullback.fst (T₁.hom ≫ V.hom) f) (Limits.pullback.fst (T₂.hom ≫ V.hom) f)
      (Limits.pullback.snd (T₁.hom ≫ V.hom) f) (Limits.pullback.snd (T₂.hom ≫ V.hom) f)
      g.left V'.hom V'.hom
      (fun φ ψ h₁ h₂ => Limits.pullback.hom_ext h₁ h₂)
      (hT T₁).isoPullback_hom_fst (hT T₂).isoPullback_hom_fst
      (hT T₁).isoPullback_hom_snd (hT T₂).isoPullback_hom_snd
      (hBCfst fU g) ((Category.assoc _ _ _).symm.trans (congrArg (· ≫ V'.hom) (hBCsnd fU g)))
      (hBCfst f ((wcEtSlice V).map g)) (hBCsnd f ((wcEtSlice V).map g))

  have s2 : ∀ {S S' : Scheme.{u}} {m : ℕ} (f : S' ⟶ S) (V : S.Etale) (V' : S'.Etale)
      (fU : V'.left ⟶ V.left)
      [hc : (wcEtSlice V).IsContinuous (Scheme.smallEtaleTopology V.left)
        (Scheme.smallEtaleTopology S)]
      [hc' : (wcEtSlice V').IsContinuous (Scheme.smallEtaleTopology V'.left)
        (Scheme.smallEtaleTopology S')]
      (ψ : wcEtZModRing V.left m ⟶ ((wcEtSlice V).sheafPushforwardContinuous RingCat.{u+1}
        (Scheme.smallEtaleTopology V.left) (Scheme.smallEtaleTopology S)).obj (wcEtZModRing S m))
      (ψ' : wcEtZModRing V'.left m ⟶ ((wcEtSlice V').sheafPushforwardContinuous RingCat.{u+1}
        (Scheme.smallEtaleTopology V'.left) (Scheme.smallEtaleTopology S')).obj
          (wcEtZModRing S' m))
      (Df : wcEtPullData f m) (DfU : wcEtPullData fU m)
      (ζ : wcEtBaseChange fU ⋙ wcEtSlice V' ≅ wcEtSlice V ⋙ wcEtBaseChange f),
      ∃ β : @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange f) _ _ Df.cont Df.φ ⋙
            SheafOfModules.pushforward.{u+1} ψ ≅
          SheafOfModules.pushforward.{u+1} ψ' ⋙
            @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange fU) _ _ DfU.cont DfU.φ,
        ∀ (M : SheafOfModules.{u+1} (wcEtZModRing S' m)) (T : V.left.Etale)
          (x : ((SheafOfModules.pushforward.{u+1} ψ).obj ((@SheafOfModules.pushforward.{u+1}
              _ _ _ _ _ _ (wcEtBaseChange f) _ _ Df.cont Df.φ).obj M)).val.obj (Opposite.op T)),
          (ConcreteCategory.hom ((β.hom.app M).val.app (Opposite.op T))) x =
            (ConcreteCategory.hom (M.val.map (ζ.hom.app T).op)) x := by
    intro S S' m f V V' fU hc hc' ψ ψ' Df DfU ζ
    haveI := Df.cont
    haveI := DfU.cont
    haveI : (wcEtSlice V ⋙ wcEtBaseChange f).IsContinuous (Scheme.smallEtaleTopology V.left)
        (Scheme.smallEtaleTopology S') :=
      Functor.isContinuous_comp _ _ _ (Scheme.smallEtaleTopology S) _
    haveI : (wcEtBaseChange fU ⋙ wcEtSlice V').IsContinuous (Scheme.smallEtaleTopology V.left)
        (Scheme.smallEtaleTopology S') :=
      Functor.isContinuous_comp _ _ _ (Scheme.smallEtaleTopology V'.left) _
    let φ₁ : wcEtZModRing V.left m ⟶ ((wcEtSlice V ⋙ wcEtBaseChange f).sheafPushforwardContinuous
        RingCat.{u+1} (Scheme.smallEtaleTopology V.left) (Scheme.smallEtaleTopology S')).obj
          (wcEtZModRing S' m) :=
      ψ ≫ ((wcEtSlice V).sheafPushforwardContinuous
      RingCat.{u+1} (Scheme.smallEtaleTopology V.left) (Scheme.smallEtaleTopology S)).map Df.φ
    let φ₂ : wcEtZModRing V.left m ⟶ ((wcEtBaseChange fU ⋙ wcEtSlice V').sheafPushforwardContinuous
        RingCat.{u+1} (Scheme.smallEtaleTopology V.left) (Scheme.smallEtaleTopology S')).obj
          (wcEtZModRing S' m) :=
      DfU.φ ≫ ((wcEtBaseChange fU).sheafPushforwardContinuous
      RingCat.{u+1} (Scheme.smallEtaleTopology V.left) (Scheme.smallEtaleTopology V'.left)).map ψ'
    have h : φ₁ ≫ (Functor.sheafPushforwardContinuousNatTrans ζ.hom RingCat.{u+1}
        (Scheme.smallEtaleTopology V.left) (Scheme.smallEtaleTopology S')).app
          (wcEtZModRing S' m) = φ₂ :=
      zmodExt _ _ _ _ _
    refine ⟨SheafOfModules.pushforwardComp (F := wcEtSlice V) (G := wcEtBaseChange f)
        ψ Df.φ ≪≫
      SheafOfModules.pushforwardNatIso φ₁ ζ ≪≫ SheafOfModules.pushforwardCongr h ≪≫
      (SheafOfModules.pushforwardComp (F := wcEtBaseChange fU) (G := wcEtSlice V')
        DfU.φ ψ').symm, ?_⟩
    intro M T x
    exact SheafOfModules.pushforwardNatTrans_app_val_app φ₁ ζ.hom M (Opposite.op T) x

  obtain ⟨ζ₀, hζ₀⟩ := s1 w V V' fU hpb
  obtain ⟨β, hsec⟩ := s2 w V V' fU ψ ψ' Dw D ζ₀
  refine ⟨β, ?_⟩
  intro M T ζ h1 h2 x
  have hclaim : ζ = ζ₀.hom.app T := by
    apply MorphismProperty.Over.Hom.ext
    exact Limits.pullback.hom_ext (h1.trans (hζ₀ T).1.symm) (h2.trans (hζ₀ T).2.symm)
  subst hclaim
  exact hsec M T x

theorem wc_etsm_bc_unit_compat {S' : Scheme.{u}} {w : S' ⟶ S'} {m : ℕ} (Dw : wcEtPullData w m)
    (Pf : S'.Etale → SheafOfModules.{u+1} (wcEtZModRing S' m))
    (ev : ∀ (V : S'.Etale) (M : SheafOfModules.{u+1} (wcEtZModRing S' m)),
      (Pf V ⟶ M) ≃ M.val.obj (Opposite.op V))
    (hnat : ∀ (V : S'.Etale) (M N : SheafOfModules.{u+1} (wcEtZModRing S' m)) (ψ : M ⟶ N)
      (g : Pf V ⟶ M), ev V N (g ≫ ψ) = (ψ.val.app (Opposite.op V)).hom (ev V M g))
    (V : S'.Etale)
    [(wcEtSlice V).IsContinuous (Scheme.smallEtaleTopology V.left) (Scheme.smallEtaleTopology S')]
    [(wcEtSlice ((wcEtBaseChange w).obj V)).IsContinuous
      (Scheme.smallEtaleTopology ((wcEtBaseChange w).obj V).left) (Scheme.smallEtaleTopology S')]
    (ψ : wcEtZModRing V.left m ⟶ ((wcEtSlice V).sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.smallEtaleTopology V.left) (Scheme.smallEtaleTopology S')).obj (wcEtZModRing S' m))
    (ψ' : wcEtZModRing ((wcEtBaseChange w).obj V).left m ⟶
      ((wcEtSlice ((wcEtBaseChange w).obj V)).sheafPushforwardContinuous RingCat.{u+1}
        (Scheme.smallEtaleTopology ((wcEtBaseChange w).obj V).left)
        (Scheme.smallEtaleTopology S')).obj (wcEtZModRing S' m))
    (D : wcEtPullData (Limits.pullback.fst V.hom w) m)
    (β : @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange w) _ _ Dw.cont Dw.φ ⋙
        SheafOfModules.pushforward.{u+1} ψ ⟶
      SheafOfModules.pushforward.{u+1} ψ' ⋙
        @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
          (wcEtBaseChange (Limits.pullback.fst V.hom w)) _ _ D.cont D.φ)
    (hβ : ∀ (M : SheafOfModules.{u+1} (wcEtZModRing S' m)) (T : V.left.Etale)
      (ζ : (wcEtSlice ((wcEtBaseChange w).obj V)).obj
          ((wcEtBaseChange (Limits.pullback.fst V.hom w)).obj T) ⟶
        (wcEtBaseChange w).obj ((wcEtSlice V).obj T)),
      ζ.left ≫ Limits.pullback.fst (T.hom ≫ V.hom) w =
        Limits.pullback.fst T.hom (Limits.pullback.fst V.hom w) →
      ζ.left ≫ Limits.pullback.snd (T.hom ≫ V.hom) w =
        Limits.pullback.snd T.hom (Limits.pullback.fst V.hom w) ≫ ((wcEtBaseChange w).obj V).hom →
      ∀ x : ((SheafOfModules.pushforward.{u+1} ψ).obj
          ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange w) _ _ Dw.cont Dw.φ).obj
            M)).val.obj (Opposite.op T),
        ((β.app M).val.app (Opposite.op T)).hom x = (M.val.map ζ.op).hom x)
    (ι : (wcEtSlice V).obj (wcEtTop V.left) ⟶ V) (hι : ι.left = 𝟙 V.left)
    (ι' : (wcEtSlice ((wcEtBaseChange w).obj V)).obj (wcEtTop ((wcEtBaseChange w).obj V).left) ⟶
      (wcEtBaseChange w).obj V) (hι' : ι'.left = 𝟙 ((wcEtBaseChange w).obj V).left)
    (εV : SheafOfModules.unit (wcEtZModRing V.left m) ⟶
      (SheafOfModules.pushforward.{u+1} ψ).obj (Pf V))
    (hεV : (εV.val.app (Opposite.op (wcEtTop V.left))).hom
        (1 : (wcEtZModRing V.left m).obj.obj (Opposite.op (wcEtTop V.left))) =
      ((Pf V).val.map ι.op).hom (ev V (Pf V) (𝟙 (Pf V))))
    (εV' : SheafOfModules.unit (wcEtZModRing ((wcEtBaseChange w).obj V).left m) ⟶
      (SheafOfModules.pushforward.{u+1} ψ').obj (Pf ((wcEtBaseChange w).obj V)))
    (hεV' : (εV'.val.app (Opposite.op (wcEtTop ((wcEtBaseChange w).obj V).left))).hom
        (1 : (wcEtZModRing ((wcEtBaseChange w).obj V).left m).obj.obj
          (Opposite.op (wcEtTop ((wcEtBaseChange w).obj V).left))) =
      ((Pf ((wcEtBaseChange w).obj V)).val.map ι'.op).hom
        (ev ((wcEtBaseChange w).obj V) (Pf ((wcEtBaseChange w).obj V)) (𝟙 _))) :
    εV ≫ (SheafOfModules.pushforward.{u+1} ψ).map (Dw.adj.unit.app (Pf V)) ≫
        β.app (Dw.Φ.obj (Pf V)) =
      @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
          (wcEtBaseChange (Limits.pullback.fst V.hom w)) _ _ D.cont D.φ ≫
        (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
          (wcEtBaseChange (Limits.pullback.fst V.hom w)) _ _ D.cont D.φ).map
          (εV' ≫ (SheafOfModules.pushforward.{u+1} ψ').map (wcEtsmKappa Dw Pf ev V)) ∧
    SheafOfModules.unitToPushforwardObjUnit ψ ≫ (SheafOfModules.pushforward.{u+1} ψ).map
        (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange w) _ _ Dw.cont Dw.φ) ≫
        β.app (SheafOfModules.unit (wcEtZModRing S' m)) =
      @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
          (wcEtBaseChange (Limits.pullback.fst V.hom w)) _ _ D.cont D.φ ≫
        (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
          (wcEtBaseChange (Limits.pullback.fst V.hom w)) _ _ D.cont D.φ).map
          (SheafOfModules.unitToPushforwardObjUnit ψ') :=
by
  classical
  haveI := Dw.cont
  haveI := D.cont
  have red : ∀ {Y : Scheme.{u}} {M : SheafOfModules.{u+1} (wcEtZModRing Y m)}
      (f g : SheafOfModules.unit (wcEtZModRing Y m) ⟶ M),
      (∀ T : Y.Etale,
        (f.val.app (Opposite.op T)).hom (1 : (wcEtZModRing Y m).obj.obj (Opposite.op T)) =
        (g.val.app (Opposite.op T)).hom (1 : (wcEtZModRing Y m).obj.obj (Opposite.op T))) →
      f = g := by
    intro Y M f g H
    apply M.unitHomEquiv.injective
    apply PresheafOfModules.sections_ext
    intro X
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    exact H X.unop

  have s1 : ∀ (W : S'.Etale)
      [(wcEtSlice W).IsContinuous (Scheme.smallEtaleTopology W.left) (Scheme.smallEtaleTopology S')]
      (φ : wcEtZModRing W.left m ⟶ ((wcEtSlice W).sheafPushforwardContinuous RingCat.{u+1}
        (Scheme.smallEtaleTopology W.left) (Scheme.smallEtaleTopology S')).obj (wcEtZModRing S' m))
      (Q : SheafOfModules.{u+1} (wcEtZModRing S' m)) (e : Q.val.obj (Opposite.op W))
      (ι₀ : (wcEtSlice W).obj (wcEtTop W.left) ⟶ W) (_ : ι₀.left = 𝟙 W.left)
      (ε : SheafOfModules.unit (wcEtZModRing W.left m) ⟶ (SheafOfModules.pushforward.{u+1} φ).obj Q)
      (_ : (ε.val.app (Opposite.op (wcEtTop W.left))).hom
          (1 : (wcEtZModRing W.left m).obj.obj (Opposite.op (wcEtTop W.left))) =
        (Q.val.map ι₀.op).hom e)
      (T : W.left.Etale) (h : (wcEtSlice W).obj T ⟶ W) (_ : h.left = T.hom),
      (ε.val.app (Opposite.op T)).hom (1 : (wcEtZModRing W.left m).obj.obj (Opposite.op T)) =
        (Q.val.map h.op).hom e := by
    intro W _ φ Q e ι₀ hι₀ ε hε T h hh
    let τ : T ⟶ wcEtTop W.left := MorphismProperty.Over.homMk T.hom (Category.comp_id _) trivial
    have hfac : (wcEtSlice W).map τ ≫ ι₀ = h := by
      apply MorphismProperty.Over.Hom.ext
      show T.hom ≫ ι₀.left = h.left
      rw [hι₀, hh]
      exact Category.comp_id _
    have h1 : ((SheafOfModules.unit (wcEtZModRing W.left m)).val.map τ.op).hom
        (1 : (wcEtZModRing W.left m).obj.obj (Opposite.op (wcEtTop W.left))) =
        (1 : (wcEtZModRing W.left m).obj.obj (Opposite.op T)) :=
      PresheafOfModules.unit_map_one _ τ.op
    refine (congrArg (fun x => (ε.val.app (Opposite.op T)).hom x) h1.symm).trans ?_
    refine (PresheafOfModules.naturality_apply ε.val τ.op _).trans ?_
    show (Q.val.map ((wcEtSlice W).map τ).op).hom
      ((ε.val.app (Opposite.op (wcEtTop W.left))).hom
        (1 : (wcEtZModRing W.left m).obj.obj (Opposite.op (wcEtTop W.left)))) = _
    rw [hε, ← PresheafOfModules.map_comp_apply, ← op_comp, hfac]
  have hBCfst : ∀ {X Y : Scheme.{u}} (hh : X ⟶ Y) {A B : Y.Etale} (g : A ⟶ B),
      ((wcEtBaseChange hh).map g).left ≫ Limits.pullback.fst B.hom hh =
        Limits.pullback.fst A.hom hh ≫ g.left := by
    intro X Y hh A B g
    exact Limits.pullback.lift_fst _ _ _
  have hBCsnd : ∀ {X Y : Scheme.{u}} (hh : X ⟶ Y) {A B : Y.Etale} (g : A ⟶ B),
      ((wcEtBaseChange hh).map g).left ≫ Limits.pullback.snd B.hom hh =
        Limits.pullback.snd A.hom hh := by
    intro X Y hh A B g
    exact Limits.pullback.lift_snd _ _ _
  obtain ⟨k, hk⟩ : ∃ k : (Dw.Φ.obj (Pf V)).val.obj (Opposite.op ((wcEtBaseChange w).obj V)),
      ((Dw.adj.unit.app (Pf V)).val.app (Opposite.op V)).hom (ev V (Pf V) (𝟙 (Pf V))) = k :=
    ⟨_, rfl⟩
  have s3 : ((wcEtsmKappa Dw Pf ev V).val.app (Opposite.op ((wcEtBaseChange w).obj V))).hom
      (ev ((wcEtBaseChange w).obj V) (Pf ((wcEtBaseChange w).obj V))
        (𝟙 (Pf ((wcEtBaseChange w).obj V)))) = k := by
    have h1 := hnat ((wcEtBaseChange w).obj V) (Pf ((wcEtBaseChange w).obj V)) (Dw.Φ.obj (Pf V))
      (wcEtsmKappa Dw Pf ev V) (𝟙 (Pf ((wcEtBaseChange w).obj V)))
    rw [Category.id_comp] at h1
    rw [← h1, ← hk]
    exact Equiv.apply_symm_apply _ _

  have key : ∀ T : V.left.Etale, ∃ (h : (wcEtSlice V).obj T ⟶ V)
      (h' : (wcEtSlice ((wcEtBaseChange w).obj V)).obj
          ((wcEtBaseChange (Limits.pullback.fst V.hom w)).obj T) ⟶ (wcEtBaseChange w).obj V)
      (ζ : (wcEtSlice ((wcEtBaseChange w).obj V)).obj
          ((wcEtBaseChange (Limits.pullback.fst V.hom w)).obj T) ⟶
        (wcEtBaseChange w).obj ((wcEtSlice V).obj T)),
      h.left = T.hom ∧ h'.left = ((wcEtBaseChange (Limits.pullback.fst V.hom w)).obj T).hom ∧
      ζ.left ≫ Limits.pullback.fst (T.hom ≫ V.hom) w =
        Limits.pullback.fst T.hom (Limits.pullback.fst V.hom w) ∧
      ζ.left ≫ Limits.pullback.snd (T.hom ≫ V.hom) w =
        Limits.pullback.snd T.hom (Limits.pullback.fst V.hom w) ≫ ((wcEtBaseChange w).obj V).hom ∧
      ζ ≫ (wcEtBaseChange w).map h = h' := by
    intro T
    have hT : Limits.pullback.fst T.hom (Limits.pullback.fst V.hom w) ≫ (T.hom ≫ V.hom) =
        (Limits.pullback.snd T.hom (Limits.pullback.fst V.hom w) ≫
          Limits.pullback.snd V.hom w) ≫ w := by
      simp only [Category.assoc]
      rw [Limits.pullback.condition_assoc, Limits.pullback.condition]
    refine ⟨MorphismProperty.Over.homMk T.hom rfl trivial,
      MorphismProperty.Over.homMk ((wcEtBaseChange (Limits.pullback.fst V.hom w)).obj T).hom
        rfl trivial,
      MorphismProperty.Over.homMk (Limits.pullback.lift _ _ hT)
        (Limits.pullback.lift_snd _ _ hT) trivial, rfl, rfl,
      Limits.pullback.lift_fst _ _ hT, Limits.pullback.lift_snd _ _ hT, ?_⟩
    apply MorphismProperty.Over.Hom.ext
    show Limits.pullback.lift _ _ hT ≫ ((wcEtBaseChange w).map
        (MorphismProperty.Over.homMk T.hom rfl trivial :
          (wcEtSlice V).obj T ⟶ V)).left =
      Limits.pullback.snd T.hom (Limits.pullback.fst V.hom w)
    refine Limits.pullback.hom_ext (f := V.hom) (g := w) ?_ ?_
    · refine (Category.assoc _ _ _).trans ?_
      refine (whisker_eq (Limits.pullback.lift _ _ hT) (hBCfst w
        (MorphismProperty.Over.homMk T.hom rfl trivial :
          (wcEtSlice V).obj T ⟶ V))).trans ?_
      refine (Category.assoc _ _ _).symm.trans ?_
      refine (eq_whisker (Limits.pullback.lift_fst _ _ hT) T.hom).trans ?_
      exact Limits.pullback.condition
    · refine (Category.assoc _ _ _).trans ?_
      refine (whisker_eq (Limits.pullback.lift _ _ hT) (hBCsnd w
        (MorphismProperty.Over.homMk T.hom rfl trivial :
          (wcEtSlice V).obj T ⟶ V))).trans ?_
      exact Limits.pullback.lift_snd _ _ hT
  have e5 : ∀ T : V.left.Etale,
      ((@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
        (wcEtBaseChange (Limits.pullback.fst V.hom w)) _ _ D.cont D.φ).val.app (Opposite.op T)).hom
          (1 : (wcEtZModRing V.left m).obj.obj (Opposite.op T)) =
        (1 : (wcEtZModRing ((wcEtBaseChange w).obj V).left m).obj.obj
          (Opposite.op ((wcEtBaseChange (Limits.pullback.fst V.hom w)).obj T))) :=
    fun T => (SheafOfModules.unitToPushforwardObjUnit_val_app_apply D.φ (X := Opposite.op T)
      _).trans (map_one (ConcreteCategory.hom (D.φ.hom.app (Opposite.op T))))
  have hεV_all := s1 V ψ (Pf V) (ev V (Pf V) (𝟙 (Pf V))) ι hι εV hεV
  have hεV'_all := s1 ((wcEtBaseChange w).obj V) ψ' (Pf ((wcEtBaseChange w).obj V))
    (ev ((wcEtBaseChange w).obj V) (Pf ((wcEtBaseChange w).obj V)) (𝟙 _)) ι' hι' εV' hεV'
  refine ⟨red _ _ (fun T => ?_), red _ _ (fun T => ?_)⟩
  · obtain ⟨h, h', ζ, hh, hh', hζf, hζs, hK⟩ := key T
    refine Eq.trans (b := ((Dw.Φ.obj (Pf V)).val.map (ζ ≫ (wcEtBaseChange w).map h).op).hom k) ?_ ?_
    · have n1 := PresheafOfModules.naturality_apply (Dw.adj.unit.app (Pf V)).val h.op
        (ev V (Pf V) (𝟙 (Pf V)))
      have n1' := n1.trans (congrArg
        (fun y : (Dw.Φ.obj (Pf V)).val.obj (Opposite.op ((wcEtBaseChange w).obj V)) =>
          ((Dw.Φ.obj (Pf V)).val.map ((wcEtBaseChange w).map h).op).hom y) hk)
      show ((β.app (Dw.Φ.obj (Pf V))).val.app (Opposite.op T)).hom
        (((Dw.adj.unit.app (Pf V)).val.app (Opposite.op ((wcEtSlice V).obj T))).hom
          ((εV.val.app (Opposite.op T)).hom
            (1 : (wcEtZModRing V.left m).obj.obj (Opposite.op T)))) = _
      rw [hεV_all T h hh]
      refine (congrArg (fun x => ((β.app (Dw.Φ.obj (Pf V))).val.app (Opposite.op T)).hom x)
        n1').trans ?_
      refine (hβ (Dw.Φ.obj (Pf V)) T ζ hζf hζs _).trans ?_
      exact ((Dw.Φ.obj (Pf V)).val.map_comp_apply ((wcEtBaseChange w).map h).op ζ.op k).symm
    · rw [hK]
      have n2 := PresheafOfModules.naturality_apply (wcEtsmKappa Dw Pf ev V).val h'.op
        (ev ((wcEtBaseChange w).obj V) (Pf ((wcEtBaseChange w).obj V))
          (𝟙 (Pf ((wcEtBaseChange w).obj V))))
      have n2' := n2.trans (congrArg
        (fun y : (Dw.Φ.obj (Pf V)).val.obj (Opposite.op ((wcEtBaseChange w).obj V)) =>
          ((Dw.Φ.obj (Pf V)).val.map h'.op).hom y) s3)
      show _ = ((wcEtsmKappa Dw Pf ev V).val.app (Opposite.op ((wcEtSlice
          ((wcEtBaseChange w).obj V)).obj ((wcEtBaseChange (Limits.pullback.fst V.hom w)).obj T)))).hom
        ((εV'.val.app (Opposite.op ((wcEtBaseChange (Limits.pullback.fst V.hom w)).obj T))).hom
          (((@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
            (wcEtBaseChange (Limits.pullback.fst V.hom w)) _ _ D.cont D.φ).val.app
              (Opposite.op T)).hom (1 : (wcEtZModRing V.left m).obj.obj (Opposite.op T))))
      rw [e5 T, hεV'_all ((wcEtBaseChange (Limits.pullback.fst V.hom w)).obj T) h' hh']
      exact n2'.symm
  · obtain ⟨h, h', ζ, hh, hh', hζf, hζs, hK⟩ := key T
    have e1 : ((SheafOfModules.unitToPushforwardObjUnit ψ).val.app (Opposite.op T)).hom
