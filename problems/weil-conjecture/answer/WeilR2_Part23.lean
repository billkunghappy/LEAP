        (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
          (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k)))) ⟶
          (DerivedCategory.Q.obj (CochainComplex.mappingCone eΨ))⟦(((n - 1) : ℕ) : ℤ)⟧) →+
        (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj (wcEtSuppObj Dx)) ⟶
          (DerivedCategory.Q.obj Ψ)⟦(((2 * (n - 1)) : ℕ) : ℤ)⟧))
      (χ : (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj (wcEtSuppObj Dx)) ⟶
          (DerivedCategory.Q.obj Ψ)⟦(((2 * (n - 1)) : ℕ) : ℤ)⟧) →+ AddCircle (1 : ℚ)),
      (∀ w, (∀ φ, χ (Pr w φ) = 0) → w = 0) ∧
      ∀ (w' : DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj (wcEtSuppObj Dx)) ⟶
            (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
              (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k)))))⟦(((n - 1) : ℕ) : ℤ)⟧)
        (b : DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
              (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k)))) ⟶
            (DerivedCategory.Q.obj Ψ)⟦(((n - 1) : ℕ) : ℤ)⟧),
        w' ≫ b⟦(((n - 1) : ℕ) : ℤ)⟧' ≫
            (shiftFunctorAdd' (DerivedCategory (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k))))
              (((n - 1) : ℕ) : ℤ) (((n - 1) : ℕ) : ℤ) (((2 * (n - 1)) : ℕ) : ℤ) (by omega)).inv.app
