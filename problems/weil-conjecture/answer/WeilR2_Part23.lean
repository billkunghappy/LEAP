    obtain ⟨w', hw'⟩ := hs9 _ hb'
    obtain ⟨w₁, hw₁⟩ := hs5 w'
    refine ⟨w₁, fun h0 => hw' ?_⟩

    have hcomm : Φ.mapDerivedCategory.map (w₁ ≫ b⟦N⟧' ≫
        (shiftFunctorAdd' _ N N Rr hNR).inv.app (DerivedCategory.Q.obj Ψ)) ≫
        (Φ.mapDerivedCategory.commShiftIso Rr).hom.app (DerivedCategory.Q.obj Ψ) =
