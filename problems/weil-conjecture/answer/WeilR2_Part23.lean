  have key : Θ n ((wcEtBaseChange (Limits.pullback.fst fZ ξ)).obj (W'.obj l).right)
      (cls ((wcEtBaseChange (Limits.pullback.fst fZ ξ)).obj (W'.obj l).right) Tx) =
      wcEtPull Dτ n (Θ n ((wcEtBaseChange (Limits.pullback.fst fZ ξ)).obj (W'.obj l).right)
