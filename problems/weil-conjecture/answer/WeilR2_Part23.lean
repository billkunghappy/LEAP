  have hσQ2' : σQ ≫ Limits.pullback.snd fX ξ =
      Limits.pullback.snd fX ξ ≫ Spec.map (Spec.preimage σ) := by
    rw [Spec.map_preimage]; exact hσQ2

  have key : ∀ (wE : Limits.pullback a (Limits.pullback.fst fX ξ) ⟶
