    · ext a
      show σ (Ideal.Quotient.mk _ (MvPolynomial.C a)) = Ideal.Quotient.mk _ (MvPolynomial.C a)
      rw [hσ, MvPolynomial.rename_C]
    · simp only [wcSrmGen]
      rw [hσX]
      congr 2
      apply Fin.ext
      simp only [he, ε]
      split_ifs <;> omega
    · rw [Ideal.map_span]
      apply le_antisymm
      · rw [Ideal.span_le]
        rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
        obtain ⟨j, hj, -⟩ := hgen i
        exact Ideal.subset_span ⟨j, hj.symm⟩
      · rw [Ideal.span_le]
        rintro _ ⟨i, rfl⟩
        obtain ⟨j, -, hj⟩ := hgen i
        exact Ideal.subset_span ⟨wcSrmGen A r π j, ⟨j, rfl⟩, hj⟩
    · rw [hσX]
      congr 2
      apply Fin.ext
      simp only [he, ε]
      first | omega | (split_ifs <;> omega)
  have s7 : ∀ (φ : wcQuadModelRing A (r + 2) π (wcSrmCh A r) →+* wcQuadModelRing A (r + 2) π (wcSrmC0 A r)),
      (∀ p : Fin (r + 2), φ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmCh A r))
          (MvPolynomial.X p)) =
        Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r)) (wcSrmFimg A r p)) →
      φ.comp (algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmCh A r))) =
        algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmC0 A r)) →
      Ideal.map φ (Ideal.span (Set.range (wcSrmGen A r π))) =
          Ideal.span {φ (wcSrmGen A r π ⟨0, by omega⟩)} ∧
        ∀ (B : CommRingCat.{u}) (ρ : CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmCh A r)) ⟶ B),
          ρ.hom (wcSrmGen A r π ⟨0, by omega⟩) ∈ nonZeroDivisors B →
          Ideal.map ρ.hom (Ideal.span (Set.range (wcSrmGen A r π))) =
            Ideal.span {ρ.hom (wcSrmGen A r π ⟨0, by omega⟩)} →
          ∃! ψ : CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmC0 A r)) ⟶ B,
            CommRingCat.ofHom φ ≫ ψ = ρ := by
    intro φ hφX hφA

    set IR := wcQuadModelIdeal A (r + 2) π (wcSrmCh A r) with hIR
    set IM := wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r) with hIM
    let x : Fin (r + 2) → wcQuadModelRing A (r + 2) π (wcSrmCh A r) :=
      fun p => Ideal.Quotient.mk IR (MvPolynomial.X p)
    let y : Fin (r + 2) → wcQuadModelRing A (r + 2) π (wcSrmC0 A r) :=
      fun p => Ideal.Quotient.mk IM (MvPolynomial.X p)
    set p0 : Fin (r + 2) := ⟨0, by omega⟩ with hp0
    set p1 : Fin (r + 2) := ⟨1, by omega⟩ with hp1

    have hGen : ∀ i : Fin (r + 2), wcSrmGen A r π i =
        x ⟨2 * (i.val / 2), lt_of_le_of_lt (Nat.mul_div_le i.val 2) i.isLt⟩ := fun i => rfl
    have hGenEven : ∀ p : Fin (r + 2), p.val % 2 = 0 → wcSrmGen A r π p = x p := by
      intro p hp
      rw [hGen]
      congr 1
      exact Fin.ext (by simp only; omega)
    have hGen0 : wcSrmGen A r π p0 = x p0 := hGenEven p0 (by simp [hp0])

    have hF0 : wcSrmFimg A r p0 = MvPolynomial.X p0 := by simp [wcSrmFimg, hp0]
    have hF1 : wcSrmFimg A r p1 = MvPolynomial.X p1 + MvPolynomial.X p0 * MvPolynomial.X p1 -
        ∑ a, ∑ b, MvPolynomial.C (wcSrmCh A r a b) * MvPolynomial.X a * MvPolynomial.X b := by
      simp [wcSrmFimg, hp0, hp1]
    have hFev : ∀ p : Fin (r + 2), p.val ≠ 0 → p.val % 2 = 0 →
        wcSrmFimg A r p = MvPolynomial.X p0 * MvPolynomial.X p := by
      intro p h0 h2
      have h1 : p.val ≠ 1 := by omega
      simp [wcSrmFimg, h0, h1, h2, hp0]
    have hFodd : ∀ p : Fin (r + 2), p.val ≠ 1 → p.val % 2 ≠ 0 → wcSrmFimg A r p = MvPolynomial.X p := by
      intro p h1 h2
      have h0 : p.val ≠ 0 := by omega
      simp [wcSrmFimg, h0, h1, h2]
    have hφ0 : φ (x p0) = y p0 := by
      show φ (Ideal.Quotient.mk IR _) = _
      rw [hφX, hF0]
    have hφev : ∀ p : Fin (r + 2), p.val ≠ 0 → p.val % 2 = 0 → φ (x p) = y p0 * y p := by
      intro p h0 h2
      show φ (Ideal.Quotient.mk IR _) = _
      rw [hφX, hFev p h0 h2, map_mul]
    have hφodd : ∀ p : Fin (r + 2), p.val ≠ 1 → p.val % 2 ≠ 0 → φ (x p) = y p := by
      intro p h1 h2
      show φ (Ideal.Quotient.mk IR _) = _
      rw [hφX, hFodd p h1 h2]

    have hrelR : ∑ a, ∑ b, (algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmCh A r))
        (wcSrmCh A r a b)) * x a * x b =
        algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmCh A r)) π := by
      have h : Ideal.Quotient.mk IR (∑ p, ∑ q, MvPolynomial.C (wcSrmCh A r p q) *
          MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C π) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      rw [map_sub, sub_eq_zero] at h
      simpa only [map_sum, map_mul, ← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap] using h
    refine ⟨?_, ?_⟩
    ·
      rw [Ideal.map_span, hGen0, hφ0]
      apply le_antisymm
      · rw [Ideal.span_le]
        rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
        rw [hGen]
        set p : Fin (r + 2) := ⟨2 * (i.val / 2), lt_of_le_of_lt (Nat.mul_div_le i.val 2) i.isLt⟩
        by_cases h0 : p.val = 0
        · have : p = p0 := Fin.ext (by rw [h0])
          rw [this, hφ0]
          exact Ideal.subset_span rfl
        · rw [hφev p h0 (by simp only [p]; omega)]
          exact Ideal.mul_mem_right _ _ (Ideal.subset_span rfl)
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        exact Ideal.subset_span ⟨x p0, ⟨p0, hGen0⟩, hφ0⟩
    ·
      intro B ρ hnzd hgen
      rw [hGen0] at hnzd hgen
      set ξ := ρ.hom (x p0) with hξ
      let g : A →+* B := ρ.hom.comp (algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmCh A r)))
      have hβex : ∀ p : Fin (r + 2), ∃ c : B, p.val % 2 = 0 → c * ξ = ρ.hom (x p) := by
        intro p
        by_cases hp : p.val % 2 = 0
        · have hmem : ρ.hom (x p) ∈ Ideal.map ρ.hom (Ideal.span (Set.range (wcSrmGen A r π))) :=
