    (hκ : WeaklyEtale κ) (hpre : κ ⁻¹ᵁ Oc = O)
    (κo : (O : Scheme.{u}) ⟶ (Oc : Scheme.{u})) (hκo : κo ≫ Oc.ι = O.ι ≫ κ)
    (Dκ : wcEtPullData κo (ℓ ^ k)) :
    Function.Injective (wcEtPull Dκ (2 * n - 3)) :=
by
  classical

  have hvanC : ∀ (K : Type u) [Field K] [IsSepClosed K], ((ℓ : ℕ) : K) ≠ 0 →
      ∀ (m : ℕ) (c : Matrix (Fin m) (Fin m) K) (j q : ℕ), 1 ≤ q →
      ∀ z : wcEtZModExt (Spec (.of (wcQuadModelRing K m 0 c))) (ℓ ^ j) q, z = 0 := by
    intro K _ _ hℓK m c j q hq z
    cases j with
    | zero =>
      have hgen : ∀ (T : Scheme.{u}) (m' : ℕ), m' = 1 → ∀ (q' : ℕ) (z' : wcEtZModExt T m' q'),
          z' = 0 := by
        intro T m' hm' q' z'
        subst hm'
        letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing T 1)) := HasExt.standard _
        have h1 := wc_et_zmod_toSheaf_nsmul_zero T 1 (SheafOfModules.unit (wcEtZModRing T 1))
        rw [one_nsmul] at h1
        have h2 : 𝟙 (SheafOfModules.unit (wcEtZModRing T 1)) = 0 := by
          apply (SheafOfModules.toSheaf (wcEtZModRing T 1)).map_injective
          rw [CategoryTheory.Functor.map_id, CategoryTheory.Functor.map_zero]
          exact h1
        have h3 := Abelian.Ext.mk₀_id_comp z'
        rw [h2, Abelian.Ext.mk₀_zero, Abelian.Ext.zero_comp] at h3
        exact h3.symm
      exact hgen _ _ (pow_zero ℓ) q z
    | succ j' =>
      obtain ⟨-, hsub⟩ := wc_et_quadric_cone_acyclic K ℓ Fact.out hℓK m c
      haveI h1 := wc_et_coh_zmod_prime_pow_of_prime _ ℓ Fact.out q (hsub q hq) j'
      obtain ⟨e⟩ := wc_et_zmodext_coh_equiv (Spec (.of (wcQuadModelRing K m 0 c))) (ℓ ^ (j' + 1)) q
      haveI := e.subsingleton
      exact Subsingleton.elim _ _

  have hc1a : ∀ {W ZW YO : Scheme.{u}} (iW : ZW ⟶ W) [IsClosedImmersion iW] (gO : YO ⟶ W) [IsOpenImmersion gO], Set.range gO = (Set.range iW)ᶜ → ∀ (m : ℕ), 0 < m → ∀ (D : wcEtPullData iW m) (Dg : wcEtPullData gO m), ∃ c : SheafOfModules.unit (wcEtZModRing YO m) ⟶ Dg.Φ.obj (Limits.kernel (wcEtSuppUnitMap D)), c ≫ Dg.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D)) = Dg.μ.inv ∧ ∀ q : ℕ, letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing W m)) := HasExt.standard _; letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing YO m)) := HasExt.standard _; letI : Dg.Φ.Additive := Dg.additive; letI : Limits.PreservesFiniteLimits Dg.Φ := Dg.presLim; letI : Limits.PreservesFiniteColimits Dg.Φ := Dg.presColim; Function.Bijective (fun x : Abelian.Ext (Limits.kernel (wcEtSuppUnitMap D)) (SheafOfModules.unit (wcEtZModRing W m)) q => (Abelian.Ext.mk₀ c).comp ((Abelian.Ext.mapExactFunctor Dg.Φ x).comp (Abelian.Ext.mk₀ Dg.μ.hom) (add_zero q)) (zero_add q)) := by
    intro W ZW YO iW _ gO _ hrange m hm D Dg
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing W m)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing YO m)) := HasExt.standard _
    letI : Dg.Φ.Additive := Dg.additive
    letI : Limits.PreservesFiniteLimits Dg.Φ := Dg.presLim
    letI : Limits.PreservesFiniteColimits Dg.Φ := Dg.presColim
    haveI hπ : Epi (wcEtSuppUnitMap D) := wc_et_supp_unit_epi iW D
    have hS : (ShortComplex.mk (Limits.kernel.ι (wcEtSuppUnitMap D)) (wcEtSuppUnitMap D)
        (Limits.kernel.condition (wcEtSuppUnitMap D))).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel (wcEtSuppUnitMap D)) inferInstance hπ
    have hB0 : Limits.IsZero (Dg.Φ.obj (wcEtSuppObj D)) := by
      have hsq := IsPullback.of_hasPullback iW gO
      haveI : IsClosedImmersion (Limits.pullback.snd iW gO) :=
        MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq inferInstance
      have hE : IsEmpty ↥(Limits.pullback iW gO : Scheme.{u}) := by
        apply Scheme.isEmpty_of_commSq hsq.toCommSq
        rw [hrange]
        exact disjoint_compl_right
      obtain ⟨D'⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.snd iW gO) m
      obtain ⟨γ, hγ, _⟩ := wc_et_closed_supp_base_change iW gO (Limits.pullback.snd iW gO)
        (Limits.pullback.fst iW gO) hsq D Dg D'
      have hZ' : Limits.IsZero (wcEtSuppObj D') := by
        rw [Limits.IsZero.iff_id_eq_zero]
        apply SheafOfModules.hom_ext
        apply PresheafOfModules.hom_ext
        intro V
        haveI := wc_et_closed_supp_obj_vanish (Limits.pullback.snd iW gO) m D' V.unop
          (fun _ ⟨p, _⟩ => hE.false p)
        exact (ModuleCat.isZero_of_subsingleton _).eq_of_src _ _
      have h0 : Dg.μ.inv ≫ Dg.Φ.map (wcEtSuppUnitMap D) = 0 := by
        rw [← hγ, hZ'.eq_of_src γ 0, Limits.comp_zero]
      haveI : Dg.Φ.IsLeftAdjoint := Dg.adj.isLeftAdjoint
      haveI : Epi (Dg.Φ.map (wcEtSuppUnitMap D)) := Dg.Φ.map_epi _
      exact Limits.IsZero.of_epi_eq_zero _ h0
    have hSΦ := hS.map_of_exact Dg.Φ
    haveI hιiso : IsIso (Dg.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D))) :=
      hSΦ.isIso_f_iff.mpr hB0
    obtain ⟨c, hcdef⟩ : ∃ c, c = Dg.μ.inv ≫ inv (Dg.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D))) :=
      ⟨_, rfl⟩
    haveI hciso : IsIso c := by rw [hcdef]; infer_instance
    have hc : c ≫ Dg.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D)) = Dg.μ.inv := by
      rw [hcdef, Category.assoc, IsIso.inv_hom_id, Category.comp_id]
    refine ⟨c, hc, fun q => ?_⟩
    haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing W m)) :=
      sheafOfModules_enoughInjectives _ _
    have hA : Function.Bijective (fun x : Abelian.Ext (Limits.kernel (wcEtSuppUnitMap D))
        (SheafOfModules.unit (wcEtZModRing W m)) q => Abelian.Ext.mapExactFunctor Dg.Φ x) := by
      have h := ext_transfer_of_corep Dg.Φ (Limits.kernel (wcEtSuppUnitMap D))
        (Dg.Φ.obj (Limits.kernel (wcEtSuppUnitMap D))) (𝟙 _)
        (fun Y => wc_et_open_restr_ker_corep iW gO hrange m hm D Dg Y)
        (fun I _ m' e => by
          haveI : Injective (Dg.Φ.obj I) :=
            wc_et_open_pull_preserves_injective gO m Dg I inferInstance
          exact Abelian.Ext.eq_zero_of_injective e)
        (SheafOfModules.unit (wcEtZModRing W m)) q
      have e : (fun β : Abelian.Ext (Limits.kernel (wcEtSuppUnitMap D))
          (SheafOfModules.unit (wcEtZModRing W m)) q =>
          (Abelian.Ext.mk₀ (𝟙 (Dg.Φ.obj (Limits.kernel (wcEtSuppUnitMap D))))).comp
            (Abelian.Ext.mapExactFunctor Dg.Φ β) (zero_add q)) =
          fun β => Abelian.Ext.mapExactFunctor Dg.Φ β :=
        funext fun β => Abelian.Ext.mk₀_id_comp _
      rw [e] at h
      exact h
    have hB : Function.Bijective (fun y : Abelian.Ext (Dg.Φ.obj (Limits.kernel (wcEtSuppUnitMap D)))
        (Dg.Φ.obj (SheafOfModules.unit (wcEtZModRing W m))) q =>
        (Abelian.Ext.mk₀ c).comp (y.comp (Abelian.Ext.mk₀ Dg.μ.hom) (add_zero q)) (zero_add q)) := by
      rw [Function.bijective_iff_has_inverse]
      refine ⟨fun z => ((Abelian.Ext.mk₀ (inv c)).comp z (zero_add q)).comp
        (Abelian.Ext.mk₀ Dg.μ.inv) (add_zero q), ?_, ?_⟩
      · intro y
        simp only
        rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
          IsIso.inv_hom_id, Abelian.Ext.mk₀_id_comp, Abelian.Ext.comp_assoc_of_third_deg_zero,
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
      · intro z
        simp only
        rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
          Abelian.Ext.comp_mk₀_id, ← Abelian.Ext.comp_assoc_of_second_deg_zero,
          Abelian.Ext.mk₀_comp_mk₀, IsIso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    exact hB.comp hA

  have hchase : ∀ {X Z V Z' : Scheme.{u}} (iZ : Z ⟶ X) [IsClosedImmersion iZ] (φV : V ⟶ X)
      [Etale φV] (i' : Z' ⟶ V) (g : Z' ⟶ Z), IsPullback g i' iZ φV → IsIso g →
      ∀ (U : X.Opens), (U : Set X) = (Set.range iZ)ᶜ → ∀ (U' : V.Opens),
      (U' : Set V) = (Set.range i')ᶜ →
      ∀ (φo : (U' : Scheme.{u}) ⟶ (U : Scheme.{u})), φo ≫ U.ι = U'.ι ≫ φV →
      ∀ (m : ℕ), 0 < m → ∀ (N : ℕ), (∀ z : wcEtZModExt X m N, z = 0) →
      ∀ (Do : wcEtPullData φo m), Function.Injective (wcEtPull Do N) := by
    intro X Z V Z' iZ _ φV _ i' g hP hg U hU U' hU' φo hφo m hm N hvan Do
    haveI : IsClosedImmersion i' :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hP inferInstance
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing X m)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing V m)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (U : Scheme.{u}) m)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (U' : Scheme.{u}) m)) := HasExt.standard _
    have hr : Set.range U.ι = (Set.range iZ)ᶜ := by rw [Scheme.Opens.range_ι, hU]
    have hr' : Set.range U'.ι = (Set.range i')ᶜ := by rw [Scheme.Opens.range_ι, hU']
    obtain ⟨D⟩ := wc_et_zmod_pull_data_exists iZ m
    obtain ⟨D'⟩ := wc_et_zmod_pull_data_exists i' m
    obtain ⟨E⟩ := wc_et_zmod_pull_data_exists φV m
    obtain ⟨Dg⟩ := wc_et_zmod_pull_data_exists U.ι m
    obtain ⟨Dg'⟩ := wc_et_zmod_pull_data_exists U'.ι m
    obtain ⟨γ, hγ, -⟩ := wc_et_closed_supp_base_change iZ φV i' g hP D E D'
    obtain ⟨c, hc, hT⟩ := hc1a iZ U.ι hr m hm D Dg
    obtain ⟨c', hc', hT'⟩ := hc1a i' U'.ι hr' m hm D' Dg'
    haveI := E.additive
    haveI := E.presLim
    haveI := E.presColim
    haveI := Dg.additive
    haveI := Dg.presLim
    haveI := Dg.presColim
    haveI := Dg'.additive
    haveI := Dg'.presLim
    haveI := Dg'.presColim
    haveI hπ : Epi (wcEtSuppUnitMap D) := wc_et_supp_unit_epi iZ D
    have hS : (ShortComplex.mk (Limits.kernel.ι (wcEtSuppUnitMap D)) (wcEtSuppUnitMap D)
        (Limits.kernel.condition (wcEtSuppUnitMap D))).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel (wcEtSuppUnitMap D)) inferInstance hπ
    haveI hπ' : Epi (wcEtSuppUnitMap D') := wc_et_supp_unit_epi i' D'
    have hS' : (ShortComplex.mk (Limits.kernel.ι (wcEtSuppUnitMap D')) (wcEtSuppUnitMap D')
        (Limits.kernel.condition _)).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel _) inferInstance hπ'
    obtain ⟨κ, hκ, hK⟩ := wc_et_supp_restr_extclass_kernel iZ i' φV D E D' γ hγ
    let Ψ : Abelian.Ext (Limits.kernel (wcEtSuppUnitMap D))
        (SheafOfModules.unit (wcEtZModRing X m)) N →+ wcEtZModExt (U : Scheme.{u}) m N :=
      ((Abelian.Ext.mk₀ c).precomp (SheafOfModules.unit (wcEtZModRing (U : Scheme.{u}) m))
        (zero_add N)).comp
        (((Abelian.Ext.mk₀ Dg.μ.hom).postcomp (Dg.Φ.obj (Limits.kernel (wcEtSuppUnitMap D)))
          (add_zero N)).comp
          (Dg.Φ.mapExtAddHom (Limits.kernel (wcEtSuppUnitMap D))
            (SheafOfModules.unit (wcEtZModRing X m)) N))
    have hΨ : ∀ y, Ψ y = (Abelian.Ext.mk₀ c).comp ((Abelian.Ext.mapExactFunctor Dg.Φ y).comp
        (Abelian.Ext.mk₀ Dg.μ.hom) (add_zero N)) (zero_add N) := fun y => rfl
    let Ψ' : Abelian.Ext (Limits.kernel (wcEtSuppUnitMap D'))
        (SheafOfModules.unit (wcEtZModRing V m)) N →+ wcEtZModExt (U' : Scheme.{u}) m N :=
      ((Abelian.Ext.mk₀ c').precomp (SheafOfModules.unit (wcEtZModRing (U' : Scheme.{u}) m))
        (zero_add N)).comp
        (((Abelian.Ext.mk₀ Dg'.μ.hom).postcomp (Dg'.Φ.obj (Limits.kernel (wcEtSuppUnitMap D')))
          (add_zero N)).comp
          (Dg'.Φ.mapExtAddHom (Limits.kernel (wcEtSuppUnitMap D'))
            (SheafOfModules.unit (wcEtZModRing V m)) N))
    have hΨ' : ∀ y, Ψ' y = (Abelian.Ext.mk₀ c').comp ((Abelian.Ext.mapExactFunctor Dg'.Φ y).comp
        (Abelian.Ext.mk₀ Dg'.μ.hom) (add_zero N)) (zero_add N) := fun y => rfl
    have hΨ'inj : Function.Injective Ψ' := by
      intro y₁ y₂ h
      rw [hΨ', hΨ'] at h
      exact (hT' N).1 h
    rw [injective_iff_map_eq_zero]
    intro α hα
    obtain ⟨x, hx⟩ := (hT N).2 α
    have hxΨ : Ψ x = α := hx
    have hx'' : (Abelian.Ext.mk₀ c).comp ((Abelian.Ext.mapExactFunctor Dg.Φ x).comp
        (Abelian.Ext.mk₀ Dg.μ.hom) (add_zero N)) (zero_add N) = α := hx
    have NAT := wc_et_open_compl_transfer_natural U.ι U'.ι φV φo hφo m D D' E Dg Dg' Do κ c c'
      hκ hc hc' N x
    rw [hx'', hα] at NAT
    have hκx : (Abelian.Ext.mk₀ κ).comp ((Abelian.Ext.mapExactFunctor E.Φ x).comp
        (Abelian.Ext.mk₀ E.μ.hom) (add_zero N)) (zero_add N) = 0 := by
      apply (injective_iff_map_eq_zero Ψ').mp hΨ'inj
      rw [hΨ']
      exact NAT
    have E1 := hK hS hS' N x
    rw [hκx] at E1
    have hδ : hS.extClass.comp x (add_comm 1 N) = 0 := by
      apply (injective_iff_map_eq_zero (wcEtSuppRestr D E D' γ (N + 1))).mp
        (wc_et_supp_restr_etale_excision_injective φV iZ i' g hP hg D E D' γ hγ (N + 1))
      rw [E1]
      first
        | exact Abelian.Ext.comp_zero _ _ _ _ _
        | exact Abelian.Ext.comp_zero _ _ _ _
        | simp
    obtain ⟨v, hv⟩ := Abelian.Ext.contravariant_sequence_exact₁ hS
      (SheafOfModules.unit (wcEtZModRing X m)) x (add_comm 1 N) hδ
    have hx0 : x = 0 := by
      rw [← hv, hvan v]
      first
        | exact Abelian.Ext.comp_zero _ _ _ _ _
        | exact Abelian.Ext.comp_zero _ _ _ _
        | simp
    rw [← hxΨ, hx0, map_zero]

  have sepAff : ∀ {X U : Scheme.{u}} (f : U ⟶ X), IsAffine U → IsSeparated f := by
    intro X U f hU
    haveI := hU
    have h1 : f ≫ Limits.terminal.from X = Limits.terminal.from U := Limits.terminal.hom_ext _ _
    haveI : IsSeparated (f ≫ Limits.terminal.from X) := by rw [h1]; infer_instance
    exact IsSeparated.of_comp f (Limits.terminal.from X)

  have main : ∀ (K : Type u) [Field K] [IsAlgClosed K], ((ℓ : ℕ) : K) ≠ 0 →
      ∀ (m : ℕ) (c : Matrix (Fin m) (Fin m) K) (Oc : (Spec (.of (wcQuadModelRing K m 0 c))).Opens),
      (Oc : Set ↥(Spec (.of (wcQuadModelRing K m 0 c)))) =
        {y | ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal K m 0 c) (MvPolynomial.X p) ∉ y.asIdeal} →
      ∀ {Ws : Scheme.{u}} (R : Type u) [CommRing R] [HenselianLocalRing R]
        [IsSepClosed (IsLocalRing.ResidueField R)] (e : Ws ⟶ Spec (.of R)), IsIso e →
      ∀ (κ : Ws ⟶ Spec (.of (wcQuadModelRing K m 0 c))), WeaklyEtale κ →
      ∀ (O : Ws.Opens), κ ⁻¹ᵁ Oc = O → (∃ w : Ws, w ∉ O) →
      ∀ (κo : (O : Scheme.{u}) ⟶ (Oc : Scheme.{u})), κo ≫ Oc.ι = O.ι ≫ κ →
      ∀ (j N : ℕ), 1 ≤ N → ∀ (Dκ : wcEtPullData κo (ℓ ^ j)),
      Function.Injective (wcEtPull Dκ N) := by
    intro K _ _ hℓK m c Oc hOc Ws R _ _ _ e he κ hκ O hpre hex κo hκo j N hN Dκ
    haveI := he
    haveI := hκ
    haveI : IsAffine Ws := IsAffine.of_isIso e
    subst hpre

    obtain ⟨huV, v₀, hv₀s, hv₀X⟩ := wc_lup_quad_cone_vertex K m c
    haveI := sepAff (wcQuadModelStr K m 0 c) inferInstance
    haveI : IsClosedImmersion (v₀ ≫ wcQuadModelStr K m 0 c) := by rw [hv₀s]; infer_instance
    haveI : IsClosedImmersion v₀ := IsClosedImmersion.of_comp v₀ (wcQuadModelStr K m 0 c)
    haveI : IsLocallyNoetherian (Spec (.of (wcQuadModelRing K m 0 c))) := by
      first
        | infer_instance
        | (unfold wcQuadModelRing; infer_instance)
    have hmemv : ∀ y : ↥(Spec (.of (wcQuadModelRing K m 0 c))), y ∈ Set.range v₀ ↔
        ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal K m 0 c) (MvPolynomial.X p) ∈ y.asIdeal := by
      intro y
      constructor
      · rintro ⟨t, rfl⟩
        have ht : t = IsLocalRing.closedPoint K := @Subsingleton.elim (PrimeSpectrum K) _ t _
        rw [ht]
        exact hv₀X
      · intro h
        exact ⟨IsLocalRing.closedPoint K, (huV y _ h hv₀X).symm⟩
    have hOcv : (Oc : Set ↥(Spec (.of (wcQuadModelRing K m 0 c)))) = (Set.range v₀)ᶜ := by
      ext y
      rw [hOc, Set.mem_compl_iff, hmemv]
      simp only [Set.mem_setOf_eq, not_forall]
    have hsing : ∀ a b : ↥(Spec (.of (wcQuadModelRing K m 0 c))), a ∈ Set.range v₀ →
        b ∈ Set.range v₀ → a = b := by
      rintro _ _ ⟨s, rfl⟩ ⟨s', rfl⟩
      rw [@Subsingleton.elim (PrimeSpectrum K) _ s s']
    have hmemO : ∀ w : Ws, w ∈ κ ⁻¹ᵁ Oc ↔ κ w ∉ Set.range v₀ := by
      intro w
      rw [Scheme.Hom.mem_preimage]
      show κ w ∈ (Oc : Set ↥(Spec (.of (wcQuadModelRing K m 0 c)))) ↔ _
      rw [hOcv]
      exact Iff.rfl

    have hκo' : κo = κ ∣_ Oc := by
      rw [← cancel_mono Oc.ι, hκo, morphismRestrict_ι]
    have hP : IsPullback κo (κ ⁻¹ᵁ Oc).ι Oc.ι κ := by
      rw [hκo']
      exact isPullback_morphismRestrict κ Oc
    have hP2 : IsPullback κo ((κ ⁻¹ᵁ Oc).ι ≫ e) Oc.ι (inv e ≫ κ) :=
      IsPullback.of_iso hP (Iso.refl _) (Iso.refl _) (asIso e) (Iso.refl _)
        (by simp) (by simp) (by simp) (by simp)

    obtain ⟨Λ₀, _, _, D₀, φ₀, hAff, hφc, hφa, hlim⟩ :=
      wc_weaklyEtale_strictHensel_prosystem R (inv e ≫ κ) inferInstance
    obtain ⟨π, hπ1, hπ2, hπ3, hπ4⟩ :=
      wc_et_baseChange_limit_cone Oc.ι R Λ₀ D₀ φ₀ (inv e ≫ κ) hφc hφa hlim _ κo
        ((κ ⁻¹ᵁ Oc).ι ≫ e) hP2

    haveI : QuasiCompact Oc.ι := inferInstance
    have hfstQC : ∀ l, QuasiCompact (Limits.pullback.fst (D₀.obj l).hom Oc.ι) := fun l =>
      MorphismProperty.of_isPullback (P := @QuasiCompact)
        (IsPullback.of_hasPullback (D₀.obj l).hom Oc.ι).flip inferInstance
    have hfstQS : ∀ l, QuasiSeparated (Limits.pullback.fst (D₀.obj l).hom Oc.ι) := fun l =>
      MorphismProperty.of_isPullback (P := @QuasiSeparated)
        (IsPullback.of_hasPullback (D₀.obj l).hom Oc.ι).flip inferInstance
    have hLc : ∀ l, CompactSpace ((D₀ ⋙ wcEtBaseChange Oc.ι).obj l).left := fun l => by
      haveI : IsAffine ((𝟭 Scheme.{u}).obj (D₀.obj l).left) := hAff l
      haveI : IsAffine (D₀.obj l).left := hAff l
      exact @QuasiCompact.compactSpace_of_compactSpace _ _
        (Limits.pullback.fst (D₀.obj l).hom Oc.ι) (hfstQC l) inferInstance
    have hLq : ∀ l, QuasiSeparatedSpace ((D₀ ⋙ wcEtBaseChange Oc.ι).obj l).left := fun l => by
      haveI : IsAffine ((𝟭 Scheme.{u}).obj (D₀.obj l).left) := hAff l
      haveI : IsAffine (D₀.obj l).left := hAff l
      exact @quasiSeparatedSpace_of_quasiSeparated _ _
        (Limits.pullback.fst (D₀.obj l).hom Oc.ι) inferInstance (hfstQS l)
