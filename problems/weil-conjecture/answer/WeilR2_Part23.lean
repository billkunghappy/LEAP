import WeilR2_Part22
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem wc_et_tpl_lp_local_global (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (k : ℕ) (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left
      (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left))
    (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left)
    (hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a)
    (η : (wcP1Over F'').left) (hηb : η ⤳ D.S i (IsLocalRing.closedPoint F''))
    (hηne : η ≠ D.S i (IsLocalRing.closedPoint F''))
    (ξ : Spec (.of (AlgebraicClosure ((wcP1Over F'').left.residueField η))) ⟶ Spec (.of A))
    (hξ : ξ ≫ a = wcEtGeomPt (wcP1Over F'').left η)
    (x : ↥(Limits.pullback D.f a)) (hx : Limits.pullback.fst D.f a x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Limits.pullback D.f a) x))
      (Scheme.Etale.forget (Limits.pullback D.f a)))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ Limits.pullback D.f a)
    (hsh : wcHalShData x B Λ' W'' φ' a')
    (Dh : wcEtPullData (Limits.pullback.fst (Limits.pullback.snd D.f a) ξ) (ℓ ^ k)) (Dg : wcEtPullData (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k))
    (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) ξ) (ℓ ^ k))))
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)))
    (hxs : Limits.pullback.fst (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A) xs = x)
    (Dx : wcEtPullData (wcEtGeomPt (Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)) xs) (ℓ ^ k)) :
    haveI := Dh.additive
    haveI := Dg.additive
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst (Limits.pullback.snd D.f a) ξ)) _ _ Dh.cont Dh.φ
    haveI : P.Additive := Adjunction.right_adjoint_additive Dh.adj
    let K := (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex
    let eK := (HomologicalComplex.single (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback D.f a) (ℓ ^ k))) (ComplexShape.up ℤ) 0).map
          (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst (Limits.pullback.snd D.f a) ξ)) _ _ Dh.cont Dh.φ) ≫
        (HomologicalComplex.singleMapHomologicalComplex P (ComplexShape.up ℤ) 0).inv.app
          (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) ξ) (ℓ ^ k))) ≫
        (P.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι'
    let eΨ := (HomologicalComplex.single (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k))) (ComplexShape.up ℤ) 0).map
          Dg.μ.inv ≫
        (HomologicalComplex.singleMapHomologicalComplex Dg.Φ (ComplexShape.up ℤ) 0).inv.app
          (SheafOfModules.unit (wcEtZModRing (Limits.pullback D.f a) (ℓ ^ k))) ≫
        (Dg.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map eK
    let Ψ := (Dg.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k)))
    ∀ (w' : DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj (wcEtSuppObj Dx)) ⟶
        (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k)))))⟦(((n - 1) : ℕ) : ℤ)⟧)
      (a₁ : DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k)))) ⟶
        (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k)))))⟦(((n - 1) : ℕ) : ℤ)⟧),
      w' ≫ a₁⟦(((n - 1) : ℕ) : ℤ)⟧' = 0 :=
by
  intro P K eK eΨ Ψ w' a₁

  have key : ∀ (X : Scheme.{u}) (K₀ : Type u) [Field K₀] [IsAlgClosed K₀]
      (x₀ : Spec (.of K₀) ⟶ X) [IsClosedImmersion x₀] (m : ℕ), m ≠ 0 →
      ∀ (Dx : wcEtPullData x₀ m) (p q r : ℕ) (h : p + q = r), 1 ≤ q →
      ∀ (α : wcEtSuppExt Dx p) (β : wcEtZModExt X m q),
        (letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing X m)) := HasExt.standard _
         α.comp β h = 0) := by
    intro X K₀ _ _ x₀ _ m hm Dx p q r h hq α β
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing X m)) := HasExt.standard _

    haveI : IsAlgClosed (IsLocalRing.ResidueField K₀) :=
      IsAlgClosed.of_ringEquiv K₀ _ (RingEquiv.ofBijective (IsLocalRing.residue K₀)
        ⟨RingHom.injective _, IsLocalRing.residue_surjective⟩)
    obtain ⟨S', s', hs', ⟨v, hv⟩, hkill⟩ :=
      wc_et_zmodext_pos_locally_zero X m hm q hq β (x₀ (IsLocalRing.closedPoint K₀))
    let V : X.Etale := MorphismProperty.Over.mk ⊤ s' hs'
    obtain ⟨T, c₁, v₁, v₀, -, -, hpb⟩ := wc_cpt_th_strict_closed_etale_tube K₀ x₀ V v hv
    have hkillT : ∀ D : wcEtPullData T.hom m, wcEtPull D q β = 0 := by
      intro D
      obtain ⟨Df⟩ := wc_et_zmod_pull_data_exists s' m
      obtain ⟨Dg⟩ := wc_et_zmod_pull_data_exists c₁.left m
      rw [wc_et_pull_comp s' c₁.left T.hom (MorphismProperty.Over.w c₁) Df Dg D q β, hkill Df,
        map_zero]

    obtain ⟨hc, hcc⟩ := wc_et_slice_continuous T
    haveI := hc
    haveI := hcc
    obtain ⟨ψ, -⟩ := wc_et_slice_zmod_restrict_unit T m
    obtain ⟨hadd, hlim, hcolim⟩ := wc_et_slice_module_restrict_exact T m ψ
    haveI := hadd
    haveI := hlim
    haveI := hcolim
    haveI hiso := wc_et_slice_unitToPushforward_isIso T hc hcc m ψ
    obtain ⟨D₁, hD₁⟩ := wc_et_pull_data_slice_normalized m T ψ
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing T.left m)) := HasExt.standard _
    have h0 : (Abelian.Ext.mk₀ (SheafOfModules.unitToPushforwardObjUnit ψ)).comp
        ((Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} ψ) β).comp
          (Abelian.Ext.mk₀ (inv (SheafOfModules.unitToPushforwardObjUnit ψ))) (add_zero q))
        (zero_add q) = 0 := by
      rw [← hD₁ q β]
      exact hkillT D₁
    have hδ : (Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} ψ) β).comp
          (Abelian.Ext.mk₀ (inv (SheafOfModules.unitToPushforwardObjUnit ψ))) (add_zero q) = 0 := by
      have e := congrArg (fun z => (Abelian.Ext.mk₀ (inv (SheafOfModules.unitToPushforwardObjUnit ψ))).comp
        z (zero_add q)) h0
      simp only [Abelian.Ext.mk₀_comp_mk₀_assoc, IsIso.inv_hom_id, Abelian.Ext.mk₀_id_comp,
        Abelian.Ext.comp_zero] at e
      exact e
    have e3 : ((Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} ψ) β).comp
          (Abelian.Ext.mk₀ (inv (SheafOfModules.unitToPushforwardObjUnit ψ))) (add_zero q)).comp
          (Abelian.Ext.mk₀ (SheafOfModules.unitToPushforwardObjUnit ψ)) (add_zero q) =
        Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} ψ) β := by
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, IsIso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
    have hRβ : Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} ψ) β = 0 := by
      rw [← e3, hδ, Abelian.Ext.zero_comp]
    have hR : Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} ψ) (α.comp β h) = 0 := by
      rw [Abelian.Ext.mapExactFunctor_comp, hRβ, Abelian.Ext.comp_zero]
    have hsupp : ∀ W : X.Etale, (∀ w : W.left, W.hom w ∉ Set.range x₀) →
        Subsingleton ↑((wcEtSuppObj Dx).val.obj (Opposite.op W)) :=
      fun W hW => wc_et_closed_supp_obj_vanish x₀ m Dx W hW
    have hbij := wc_et_supp_ext_restrict_bijective T hc hcc x₀ v₀ hpb m ψ (wcEtSuppObj Dx)
      (SheafOfModules.unit (wcEtZModRing X m)) hsupp r
    apply hbij.1
    show Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} ψ) (α.comp β h) =
      Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} ψ) 0
    rw [hR, Abelian.Ext.mapExactFunctor_zero]

  have hN : 1 ≤ n - 1 := by omega
  have hNN : (n - 1) + (n - 1) = 2 * (n - 1) := by omega
  have hm : ℓ ^ k ≠ 0 := pow_ne_zero k (Fact.out : ℓ.Prime).ne_zero
  haveI hci := wc_et_tpl_sfu_geom_pt_closed_immersion F' F'' Y n D i A Λ W' φ a hA x hx xs hxs
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k)))
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k))) := HasExt.standard _
  have H : ∀ (α : wcEtSuppExt Dx (n - 1))
      (β : wcEtZModExt (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k) (n - 1)),
      α.comp β hNN = 0 :=
    fun α β => key _ _ _ (ℓ ^ k) hm Dx (n - 1) (n - 1) (2 * (n - 1)) hNN hN α β

  let σ := DerivedCategory.singleFunctorIsoCompQ (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k))) 0
  let f' : ShiftedHom ((DerivedCategory.singleFunctor _ 0).obj (wcEtSuppObj Dx))
      ((DerivedCategory.singleFunctor _ 0).obj (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k))))
      (((n - 1 : ℕ)) : ℤ) :=
    σ.hom.app _ ≫ w' ≫ (σ.inv.app _)⟦(((n - 1 : ℕ)) : ℤ)⟧'
  let g' : ShiftedHom ((DerivedCategory.singleFunctor _ 0).obj (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k))))
      ((DerivedCategory.singleFunctor _ 0).obj (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k))))
      (((n - 1 : ℕ)) : ℤ) :=
    σ.hom.app _ ≫ a₁ ≫ (σ.inv.app _)⟦(((n - 1 : ℕ)) : ℤ)⟧'
  have h1 := H (Abelian.Ext.homEquiv.symm f') (Abelian.Ext.homEquiv.symm g')
  have h2 := congrArg Abelian.Ext.hom h1
  rw [Abelian.Ext.comp_hom, Abelian.Ext.zero_hom] at h2
  have e1 : (Abelian.Ext.homEquiv.symm f').hom = f' := Abelian.Ext.homEquiv.apply_symm_apply f'
  have e2 : (Abelian.Ext.homEquiv.symm g').hom = g' := Abelian.Ext.homEquiv.apply_symm_apply g'
  rw [e1, e2] at h2
  have hpq : (((n - 1 : ℕ)) : ℤ) + (((n - 1 : ℕ)) : ℤ) = (((2 * (n - 1) : ℕ)) : ℤ) := by omega
  change f' ≫ g'⟦(((n - 1 : ℕ)) : ℤ)⟧' ≫ (shiftFunctorAdd' _ _ _ _ hpq).inv.app _ = 0 at h2
  simp only [f', g', Functor.map_comp, Category.assoc] at h2
  rw [← Functor.map_comp_assoc (shiftFunctor _ (((n - 1 : ℕ)) : ℤ)) (σ.inv.app _) (σ.hom.app _),
    Iso.inv_hom_id_app, CategoryTheory.Functor.map_id, Category.id_comp,
    Preadditive.IsIso.comp_left_eq_zero, ← Category.assoc, ← Category.assoc,
    Preadditive.IsIso.comp_right_eq_zero, Preadditive.IsIso.comp_right_eq_zero] at h2
  exact h2

theorem wc_et_tpl_det_shens_supp_unit_order (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (k : ℕ) (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left
      (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left))
    (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left)
    (hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a)
    (x : ↥(Limits.pullback D.f a)) (hx : Limits.pullback.fst D.f a x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Limits.pullback D.f a) x))
      (Scheme.Etale.forget (Limits.pullback D.f a)))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ Limits.pullback D.f a)
    (hsh : wcHalShData x B Λ' W'' φ' a')
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)))
    (hxs : Limits.pullback.fst (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A) xs = x)
    (Dx : wcEtPullData (wcEtGeomPt (Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)) xs) (ℓ ^ k))
    (Dw : wcEtPullData (Limits.pullback.snd a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (ℓ ^ k)) :
    ∀ j : ℕ, j • Dw.Φ.map (wcEtSuppUnitMap Dx) = 0 → ℓ ^ k ∣ j :=
by
  classical
  intro j hj

  have hcl : a' (IsLocalRing.closedPoint B) = x := by
    obtain ⟨-, -, -, -, -, e, -, he⟩ := hsh
    obtain ⟨pt⟩ : Nonempty ↥(Spec (.of (AlgebraicClosure ((Limits.pullback D.f a).residueField x)))) :=
      ⟨IsLocalRing.closedPoint _⟩
    have hL : (Spec.map (CommRingCat.ofHom e) ≫ Spec.map (CommRingCat.ofHom
        (IsLocalRing.residue B)) ≫ a') pt = a' (IsLocalRing.closedPoint B) := by
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply,
        Spec.map_apply (CommRingCat.ofHom (IsLocalRing.residue B))]
      congr 1
      exact IsLocalRing.PrimeSpectrum.comap_residue B _
    have hR : (wcEtGeomPt (Limits.pullback D.f a) x) pt = x := by
      show (Spec.map (CommRingCat.ofHom (algebraMap ((Limits.pullback D.f a).residueField x)
        (AlgebraicClosure ((Limits.pullback D.f a).residueField x)))) ≫
          (Limits.pullback D.f a).fromSpecResidueField x) pt = x
      rw [Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]
    rw [← hL, he, hR]

  obtain ⟨p₀, -, hp⟩ := Scheme.Pullback.exists_preimage_pullback (f := a')
    (g := Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))
    (IsLocalRing.closedPoint B) xs (hcl.trans hxs.symm)
  subst hp

  have hfac : ∀ {X W : Scheme.{u}} (w : W ⟶ X) (p : W),
      ∃ g : Spec (.of (AlgebraicClosure (W.residueField p))) ⟶
        Spec (.of (AlgebraicClosure (X.residueField (w p)))),
        wcEtGeomPt W p ≫ w = g ≫ wcEtGeomPt X (w p) := by
    intro X W w p
    letI : Algebra (X.residueField (w p)) (AlgebraicClosure (W.residueField p)) :=
      ((algebraMap (W.residueField p) (AlgebraicClosure (W.residueField p))).comp
        (w.residueFieldMap p).hom).toAlgebra
    let σ : AlgebraicClosure (X.residueField (w p)) →ₐ[X.residueField (w p)]
        AlgebraicClosure (W.residueField p) := IsAlgClosed.lift
    refine ⟨Spec.map (CommRingCat.ofHom σ.toRingHom), ?_⟩
    have e1 : Spec.map (CommRingCat.ofHom σ.toRingHom) ≫
        Spec.map (CommRingCat.ofHom (algebraMap (X.residueField (w p))
          (AlgebraicClosure (X.residueField (w p))))) =
        Spec.map (CommRingCat.ofHom (algebraMap (W.residueField p)
          (AlgebraicClosure (W.residueField p)))) ≫ Spec.map (w.residueFieldMap p) := by
      rw [← Spec.map_comp, ← Spec.map_comp]
      congr 1
      ext t
      change σ (algebraMap _ _ t) =
        algebraMap (W.residueField p) _ ((w.residueFieldMap p).hom t)
      rw [σ.commutes]
      rfl
    dsimp only [wcEtGeomPt]
    rw [← Category.assoc (Spec.map (CommRingCat.ofHom σ.toRingHom)), e1]
    simp only [Category.assoc]
    rw [Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField]

  have key : ∀ {X W : Scheme.{u}} (w : W ⟶ X) (Ω Ω' : Type u) [Field Ω] [Field Ω']
      (xb : Spec (.of Ω) ⟶ X) (xb' : Spec (.of Ω') ⟶ W) (g : Spec (.of Ω') ⟶ Spec (.of Ω))
      (_hsq : xb' ≫ w = g ≫ xb) (m : ℕ) (Dx : wcEtPullData xb m) (Dw : wcEtPullData w m)
      (j : ℕ), j • Dw.Φ.map (wcEtSuppUnitMap Dx) = 0 → m ∣ j := by
    intro X W w Ω Ω' _ _ xb xb' g hsq m Dx Dw j hj
    obtain ⟨D'⟩ := wc_et_zmod_pull_data_exists xb' m
    obtain ⟨Dg⟩ := wc_et_zmod_pull_data_exists g m
    obtain ⟨Dk⟩ := wc_et_zmod_pull_data_exists (xb' ≫ w) m
    obtain ⟨Did⟩ := wc_et_zmod_pull_data_exists (𝟙 (Spec (.of Ω'))) m
    haveI := D'.additive
    haveI := Dg.additive
    haveI := Dk.additive
    haveI := Dx.additive
    haveI := Dw.additive
    obtain ⟨α⟩ := wc_et_pull_data_comp_iso w xb' (xb' ≫ w) rfl Dw D' Dk
    obtain ⟨β⟩ := wc_et_pull_data_comp_iso xb g (xb' ≫ w) hsq.symm Dx Dg Dk
    have h0 : j • Dk.Φ.map (wcEtSuppUnitMap Dx) = 0 := by
      rw [← NatIso.naturality_2 α (wcEtSuppUnitMap Dx), ← Preadditive.comp_nsmul,
        ← Preadditive.nsmul_comp, Functor.comp_map, ← Functor.map_nsmul, hj, Functor.map_zero,
        Limits.zero_comp, Limits.comp_zero]
    have h1 : j • Dg.Φ.map (Dx.Φ.map (wcEtSuppUnitMap Dx)) = 0 := by
      rw [← Functor.comp_map, ← NatIso.naturality_1 β (wcEtSuppUnitMap Dx),
        ← Preadditive.comp_nsmul, ← Preadditive.nsmul_comp, h0, Limits.zero_comp,
        Limits.comp_zero]
    haveI := Dx.cont
    have hu : (Dx.adj.homEquiv (SheafOfModules.unit (wcEtZModRing X m))
        (SheafOfModules.unit (wcEtZModRing (Spec (.of Ω)) m))) Dx.μ.hom =
        Dx.adj.unit.app (SheafOfModules.unit (wcEtZModRing X m)) ≫
          (SheafOfModules.pushforward Dx.φ).map Dx.μ.hom := by
      rw [Adjunction.homEquiv_unit]
    have h1' : j • Dg.Φ.map (Dx.Φ.map ((Dx.adj.homEquiv (SheafOfModules.unit (wcEtZModRing X m))
        (SheafOfModules.unit (wcEtZModRing (Spec (.of Ω)) m))) Dx.μ.hom)) = 0 := by
      rw [hu]
      exact h1
    have hret : Dx.Φ.map ((Dx.adj.homEquiv (SheafOfModules.unit (wcEtZModRing X m))
        (SheafOfModules.unit (wcEtZModRing (Spec (.of Ω)) m))) Dx.μ.hom) ≫
          Dx.adj.counit.app (SheafOfModules.unit (wcEtZModRing (Spec (.of Ω)) m)) = Dx.μ.hom := by
      have hc := Dx.adj.homEquiv_counit (g := (Dx.adj.homEquiv
        (SheafOfModules.unit (wcEtZModRing X m))
        (SheafOfModules.unit (wcEtZModRing (Spec (.of Ω)) m))) Dx.μ.hom)
      rw [Equiv.symm_apply_apply] at hc
      exact hc.symm
    have h2 : j • 𝟙 (Dg.Φ.obj (Dx.Φ.obj (SheafOfModules.unit (wcEtZModRing X m)))) = 0 := by
      have hid : 𝟙 (Dg.Φ.obj (Dx.Φ.obj (SheafOfModules.unit (wcEtZModRing X m)))) =
          Dg.Φ.map (Dx.Φ.map ((Dx.adj.homEquiv (SheafOfModules.unit (wcEtZModRing X m))
            (SheafOfModules.unit (wcEtZModRing (Spec (.of Ω)) m))) Dx.μ.hom)) ≫
            Dg.Φ.map (Dx.adj.counit.app (SheafOfModules.unit (wcEtZModRing (Spec (.of Ω)) m)) ≫
              Dx.μ.inv) := by
        rw [← Functor.map_comp, ← Category.assoc, hret, Iso.hom_inv_id,
          CategoryTheory.Functor.map_id]
      rw [hid, ← Preadditive.nsmul_comp, h1', Limits.zero_comp]
    let ψ := Dg.Φ.mapIso Dx.μ ≪≫ Dg.μ
    have h3 : j • 𝟙 (SheafOfModules.unit (wcEtZModRing (Spec (.of Ω')) m)) = 0 := by
      have hid : 𝟙 (SheafOfModules.unit (wcEtZModRing (Spec (.of Ω')) m)) =
          ψ.inv ≫ 𝟙 (Dg.Φ.obj (Dx.Φ.obj (SheafOfModules.unit (wcEtZModRing X m)))) ≫ ψ.hom := by
        rw [Category.id_comp, Iso.inv_hom_id]
      rw [hid, ← Preadditive.comp_nsmul, ← Preadditive.nsmul_comp, h2, Limits.zero_comp,
        Limits.comp_zero]
    obtain ⟨e, he⟩ := wc_et_supp_unit_line Ω' (𝟙 (Spec (.of Ω'))) m Did
    have h4 : e (j : ZMod m) = 0 := by
      rw [← nsmul_one, map_nsmul, he, ← Category.id_comp (wcEtSuppUnitMap Did),
        ← Preadditive.nsmul_comp, h3, Limits.zero_comp]
    have h5 : ((j : ℕ) : ZMod m) = 0 := (AddEquiv.map_eq_zero_iff e).mp h4
    exact (CharP.cast_eq_zero_iff (ZMod m) m j).mp h5
  obtain ⟨g, hg⟩ := hfac (Limits.pullback.snd a'
    (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) p₀
  exact key _ _ _ _ _ g hg (ℓ ^ k) Dx Dw j hj

theorem wc_et_closed_supp_bc_gamma_isIso : ∀ {X Y Y' X' : Scheme.{u}} {n : ℕ} (i : X ⟶ Y) [IsClosedImmersion i] (f : Y' ⟶ Y) (i' : X' ⟶ Y') (g : X' ⟶ X), IsPullback g i' i f → ∀ (D : wcEtPullData i n) (Df : wcEtPullData f n) (D' : wcEtPullData i' n) (γ : wcEtSuppObj D' ⟶ Df.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap D' ≫ γ = Df.μ.inv ≫ Df.Φ.map (wcEtSuppUnitMap D) → IsIso γ :=
by
  intro X Y Y' X' n i _ f i' g hsq D Df D' γ hγ
  haveI : IsClosedImmersion i' := MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq ‹_›
  haveI hE' : Epi (wcEtSuppUnitMap D') := wc_et_supp_unit_epi i' D'
  haveI hE : Epi (wcEtSuppUnitMap D) := wc_et_supp_unit_epi i D

  have hV : ∀ U : Y.Etale, IsEmpty ((wcEtBaseChange i).obj U).left →
      Subsingleton ↑((wcEtSuppObj D').val.obj (Opposite.op ((wcEtBaseChange f).obj U))) := by
    intro U hU
    apply wc_et_closed_supp_obj_vanish i' n D'
    intro w hw
    obtain ⟨x', hx'⟩ := hw
    let w' : ↥(Limits.pullback U.hom f) := w
    have hw' : Limits.pullback.snd U.hom f w' = i' x' := hx'.symm
    have c1 : (Limits.pullback.fst U.hom f ≫ U.hom) w' = (Limits.pullback.snd U.hom f ≫ f) w' := by
      rw [Limits.pullback.condition]
    have c2 : (g ≫ i) x' = (i' ≫ f) x' := by rw [hsq.toCommSq.w]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at c1 c2
    rw [hw'] at c1
    have h1 : U.hom (Limits.pullback.fst U.hom f w') = i (g x') := c1.trans c2.symm
    obtain ⟨z, -, -⟩ := Scheme.Pullback.exists_preimage_pullback _ _ h1
    exact (show IsEmpty ↥(Limits.pullback U.hom i) from hU).false z
  obtain ⟨c, hc⟩ : ∃ c, (Df.adj.homEquiv (SheafOfModules.unit (wcEtZModRing Y n)) (wcEtSuppObj D'))
      (Df.μ.hom ≫ wcEtSuppUnitMap D') = c := ⟨_, rfl⟩
  have hK : Limits.kernel.ι (wcEtSuppUnitMap D) ≫ c = 0 := by
    apply wc_et_supp_unit_ker_kill_of_vanish i D
    intro U hU
    exact @Subsingleton.elim _ (hV U hU) _ _
  obtain ⟨δb, hδb⟩ : ∃ δb, wcEtSuppUnitMap D ≫ δb = c := ⟨_, Abelian.comp_epiDesc _ _ hK⟩
  obtain ⟨δ, hδ⟩ : ∃ δ, Df.adj.homEquiv (wcEtSuppObj D) (wcEtSuppObj D') δ = δb :=
    ⟨_, Equiv.apply_symm_apply _ _⟩
  have h7a : Df.Φ.map (wcEtSuppUnitMap D) ≫ δ = Df.μ.hom ≫ wcEtSuppUnitMap D' := by
    apply (Df.adj.homEquiv _ _).injective
    rw [Adjunction.homEquiv_naturality_left, hδ, hδb, hc]
  have h7 : (Df.μ.inv ≫ Df.Φ.map (wcEtSuppUnitMap D)) ≫ δ = wcEtSuppUnitMap D' := by
    rw [Category.assoc, h7a, Iso.inv_hom_id_assoc]
  have h8 : γ ≫ δ = 𝟙 _ := by
    rw [← cancel_epi (wcEtSuppUnitMap D'), ← Category.assoc, hγ, h7, Category.comp_id]
  haveI := Functor.preservesEpimorphisms_of_adjunction Df.adj
  haveI : Epi (Df.μ.inv ≫ Df.Φ.map (wcEtSuppUnitMap D)) := epi_comp _ _
  have h9 : δ ≫ γ = 𝟙 _ := by
    rw [← cancel_epi (Df.μ.inv ≫ Df.Φ.map (wcEtSuppUnitMap D)), ← Category.assoc, h7, hγ,
      Category.comp_id]
  exact ⟨⟨δ, h8, h9⟩⟩

theorem wc_et_dsl_shens_closed_fibre_square {X : Scheme.{u}} (A : Type u) [CommRing A] [IsLocalRing A]
    (g : X ⟶ Spec (.of A)) (x : X)
    (xs : ↥(Limits.pullback g (wcQmSp A))) (hxs : Limits.pullback.fst g (wcQmSp A) xs = x)
    (B : Type u) [CommRing B] [IsLocalRing B]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt X x)) (Scheme.Etale.forget X))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ X)
    (hsh : wcHalShData x B Λ' W'' φ' a') :
    ∃ (J : Ideal B) (c : Limits.pullback a' (Limits.pullback.fst g (wcQmSp A)) ⟶ Spec (.of (B ⧸ J))),
      IsPullback (Limits.pullback.fst a' (Limits.pullback.fst g (wcQmSp A))) c
        (𝟙 (Spec (.of B))) (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))) ∧ J ≠ ⊤ :=
by
  classical

  let φ : A →+* B := (Spec.preimage (a' ≫ g)).hom
  have hφ : Spec.map (CommRingCat.ofHom φ) = a' ≫ g := by
    rw [CommRingCat.ofHom_hom]; exact Spec.map_preimage _
  let J : Ideal B := Ideal.map φ (IsLocalRing.maximalIdeal A)

  obtain ⟨-, -, -, -, -, ε, -, he⟩ := hsh
  have hgeom : ∀ z, wcEtGeomPt X x z = x := by
    intro z
    rw [wcEtGeomPt, Scheme.Hom.comp_apply]
    exact Scheme.fromSpecResidueField_apply x _
  have hres : ∀ z, (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) z =
      IsLocalRing.closedPoint B :=
    fun z => IsLocalRing.PrimeSpectrum.comap_residue B z
  have ha : a' (IsLocalRing.closedPoint B) = x := by
    have h1 := congrArg (fun f => f (IsLocalRing.closedPoint
      (AlgebraicClosure (X.residueField x)))) he
    have h1' := (Scheme.Hom.comp_apply _ _ _).symm.trans
      ((Scheme.Hom.comp_apply _ _ _).symm.trans (h1.trans (hgeom _)))
    rw [hres] at h1'
    exact h1'

  have hgx : g x = IsLocalRing.closedPoint A := by
    rw [← hxs]
    exact (Scheme.Hom.comp_apply _ _ xs).symm.trans
      ((congrArg (fun f => f xs) (Limits.pullback.condition (f := g) (g := wcQmSp A))).trans
        ((Scheme.Hom.comp_apply _ _ xs).trans (IsLocalRing.PrimeSpectrum.comap_residue A _)))

  have hclosed : (Spec.map (CommRingCat.ofHom φ)) (IsLocalRing.closedPoint B) =
      IsLocalRing.closedPoint A := by
    rw [hφ]
    exact (Scheme.Hom.comp_apply a' g _).trans ((congrArg g ha).trans hgx)
  have hcomap : Ideal.comap φ (IsLocalRing.maximalIdeal B) = IsLocalRing.maximalIdeal A := by
    have := congrArg PrimeSpectrum.asIdeal hclosed
    exact this

  have hJ : J ≠ ⊤ := by
    intro hJt
    have hle : J ≤ IsLocalRing.maximalIdeal B := by
      rw [Ideal.map_le_iff_le_comap, hcomap]
    rw [hJt, top_le_iff] at hle
    exact (IsLocalRing.maximalIdeal.isMaximal B).ne_top hle

  have h2 : IsPullback (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)))
      (Spec.map (CommRingCat.ofHom (Ideal.quotientMap J φ
        (Ideal.le_comap_map (I := IsLocalRing.maximalIdeal A)))))
      (Spec.map (CommRingCat.ofHom φ))
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal A)))) := by
    set I := IsLocalRing.maximalIdeal A
    apply AlgebraicGeometry.isPullback_SpecMap_of_isPushout
    have hcomm : ∀ r : A, Ideal.quotientMap J φ (Ideal.le_comap_map (I := I))
        (Ideal.Quotient.mk I r) = Ideal.Quotient.mk J (φ r) := fun r =>
      Ideal.quotientMap_mk
    have w : CommRingCat.ofHom φ ≫ CommRingCat.ofHom (Ideal.Quotient.mk J) =
        CommRingCat.ofHom (Ideal.Quotient.mk I) ≫
        CommRingCat.ofHom (Ideal.quotientMap J φ (Ideal.le_comap_map (I := I))) := by
      ext r
      exact (hcomm r).symm
    have key : ∀ (s : Limits.PushoutCocone (CommRingCat.ofHom φ)
        (CommRingCat.ofHom (Ideal.Quotient.mk I))) (r : A),
        s.inl.hom (φ r) = s.inr.hom (Ideal.Quotient.mk I r) := by
      intro s r
      have := congrArg (fun ψ => ψ.hom r) s.condition
      simpa using this
    have H : ∀ (s : Limits.PushoutCocone (CommRingCat.ofHom φ)
        (CommRingCat.ofHom (Ideal.Quotient.mk I))), J ≤ RingHom.ker s.inl.hom := by
      intro s
      rw [Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap, RingHom.mem_ker, key s x, Ideal.Quotient.eq_zero_iff_mem.mpr hx,
        map_zero]
    refine IsPushout.of_isColimit' ⟨w⟩ (Limits.PushoutCocone.IsColimit.mk w
      (fun s => CommRingCat.ofHom (Ideal.Quotient.lift _ s.inl.hom (fun a ha => H s ha)))
      ?_ ?_ ?_)
    · intro s
      ext x
      exact Ideal.Quotient.lift_mk J s.inl.hom (fun a ha => H s ha)
    · intro s
      ext x
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.coe_comp,
        Function.comp_apply, hcomm, Ideal.Quotient.lift_mk]
      exact key s x
    · intro s m h1 _
      ext x
      have := congrArg (fun ψ => ψ.hom x) h1
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.coe_comp,
        Function.comp_apply] at this
      simp only [CommRingCat.hom_ofHom, Ideal.Quotient.lift_mk]
      exact this

  have h1 : IsPullback (Limits.pullback.fst a' (Limits.pullback.fst g (wcQmSp A)))
      (Limits.pullback.snd a' (Limits.pullback.fst g (wcQmSp A)) ≫
        Limits.pullback.snd g (wcQmSp A))
      (Spec.map (CommRingCat.ofHom φ))
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal A)))) := by
    rw [hφ]
    exact (IsPullback.paste_horiz
      (IsPullback.of_hasPullback a' (Limits.pullback.fst g (wcQmSp A))).flip
      (IsPullback.of_hasPullback g (wcQmSp A)).flip).flip

  let E := IsPullback.isoIsPullback _ _ h1 h2
  have hfst : E.hom ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)) =
      Limits.pullback.fst a' (Limits.pullback.fst g (wcQmSp A)) :=
    IsPullback.isoIsPullback_hom_fst _ _ _ _
  refine ⟨J, E.hom, ?_, hJ⟩
  exact IsPullback.of_vert_isIso ⟨by rw [Category.comp_id, hfst]⟩

theorem wc_et_tpl_det_shens_closed_fibre_acyclic (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (k : ℕ) (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left
      (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left))
    (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left)
    (hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a)
    (x : ↥(Limits.pullback D.f a)) (hx : Limits.pullback.fst D.f a x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Limits.pullback D.f a) x))
      (Scheme.Etale.forget (Limits.pullback D.f a)))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ Limits.pullback D.f a)
    (hsh : wcHalShData x B Λ' W'' φ' a')
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)))
    (hxs : Limits.pullback.fst (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A) xs = x) :
    ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtZModExt (Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (ℓ ^ k) q) :=
by
  intro q hq
  obtain ⟨J, c, hsq, hJ⟩ := wc_et_dsl_shens_closed_fibre_square A (Limits.pullback.snd D.f a)
    x xs hxs B Λ' W'' φ' a' hsh
  haveI : IsIso c := hsq.isIso_snd_of_isIso
  obtain ⟨hH, hS⟩ := wc_quot_strictly_henselian_of_ne_top B J hJ
  obtain ⟨q', rfl⟩ : ∃ q', q = q' + 1 := ⟨q - 1, by omega⟩
  have hvan : Subsingleton (wcEtZModExt (Spec (.of (B ⧸ J))) (ℓ ^ k) (q' + 1)) := by
    obtain ⟨e⟩ := wc_et_zmodext_coh_equiv (Spec (.of (B ⧸ J))) (ℓ ^ k) (q' + 1)
    haveI : Subsingleton (wcEtCoh (Spec (.of (B ⧸ J))) (ℓ ^ k) (q' + 1)) := by
      unfold wcEtCoh
      exact @wc_et_strictly_local_ext_vanishing (B ⧸ J) _ hH hS _ q'
    exact e.subsingleton
  have h0 : ∀ z : wcEtZModExt (Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a)
      (wcQmSp A))) (ℓ ^ k) (q' + 1), z = 0 := by
    intro z
    obtain ⟨Dc⟩ := wc_et_zmod_pull_data_exists c (ℓ ^ k)
    obtain ⟨Di⟩ := wc_et_zmod_pull_data_exists (inv c) (ℓ ^ k)
    obtain ⟨D1⟩ := wc_et_zmod_pull_data_exists
      (𝟙 (Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)))) (ℓ ^ k)
    apply wc_et_pull_id_injective D1 (q' + 1) z
    rw [wc_et_pull_comp (inv c) c _ (IsIso.hom_inv_id c) Di Dc D1 (q' + 1) z,
      Subsingleton.elim (wcEtPull Di (q' + 1) z) 0, map_zero]
  exact ⟨fun y z => by rw [h0 y, h0 z]⟩

theorem wc_et_supp_open_boundary_lift_any : ∀ {W' Z' YO' : Scheme.{u}} (iW' : Z' ⟶ W') [IsClosedImmersion iW'] (gO' : YO' ⟶ W') [IsOpenImmersion gO'], Set.range gO' = (Set.range iW')ᶜ → ∀ (m : ℕ), 0 < m → ∀ (D' : wcEtPullData iW' m) (M : ℕ) (θ' : wcEtSuppExt D' (M + 1)), wcEtSuppClass D' (M + 1) θ' = 0 → ∃ a' : wcEtZModExt YO' m M, ∀ (V ZV YOV : Scheme.{u}) (iV : ZV ⟶ V) [IsClosedImmersion iV] (gOV : YOV ⟶ V) [IsOpenImmersion gOV], Set.range gOV = (Set.range iV)ᶜ → ∀ (f : W' ⟶ V) (w : YO' ⟶ YOV), w ≫ gOV = gO' ≫ f → ∀ (DV : wcEtPullData iV m) (Ef : wcEtPullData f m) (γ : wcEtSuppObj D' ⟶ Ef.Φ.obj (wcEtSuppObj DV)), wcEtSuppUnitMap D' ≫ γ = Ef.μ.inv ≫ Ef.Φ.map (wcEtSuppUnitMap DV) → ∀ (Dw : wcEtPullData w m) (b : wcEtZModExt YOV m M), wcEtPull Dw M b = a' → ∃ θV : wcEtSuppExt DV (M + 1), wcEtSuppRestr DV Ef D' γ (M + 1) θV = θ' :=
by
  classical


  have L0 : ∀ {W ZW YO : Scheme.{u}} (iW : ZW ⟶ W) [IsClosedImmersion iW] (gO : YO ⟶ W) [IsOpenImmersion gO], Set.range gO = (Set.range iW)ᶜ → ∀ (ℓ : ℕ), 0 < ℓ → ∀ (D : wcEtPullData iW ℓ) (Dg : wcEtPullData gO ℓ), ∃ c : SheafOfModules.unit (wcEtZModRing YO ℓ) ⟶ Dg.Φ.obj (Limits.kernel (wcEtSuppUnitMap D)), c ≫ Dg.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D)) = Dg.μ.inv ∧ ∀ k : ℕ, letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing W ℓ)) := HasExt.standard _; letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing YO ℓ)) := HasExt.standard _; letI : Dg.Φ.Additive := Dg.additive; letI : Limits.PreservesFiniteLimits Dg.Φ := Dg.presLim; letI : Limits.PreservesFiniteColimits Dg.Φ := Dg.presColim; Function.Bijective (fun x : Abelian.Ext (Limits.kernel (wcEtSuppUnitMap D)) (SheafOfModules.unit (wcEtZModRing W ℓ)) k => (Abelian.Ext.mk₀ c).comp ((Abelian.Ext.mapExactFunctor Dg.Φ x).comp (Abelian.Ext.mk₀ Dg.μ.hom) (add_zero k)) (zero_add k)) := by
    intro W ZW YO iW _ gO _ hrange ℓ hℓ D Dg
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing W ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing YO ℓ)) := HasExt.standard _
    letI : Dg.Φ.Additive := Dg.additive
    letI : Limits.PreservesFiniteLimits Dg.Φ := Dg.presLim
    letI : Limits.PreservesFiniteColimits Dg.Φ := Dg.presColim
    haveI hπ : Epi (wcEtSuppUnitMap D) := wc_et_supp_unit_epi iW D
    have hS : (ShortComplex.mk (Limits.kernel.ι (wcEtSuppUnitMap D)) (wcEtSuppUnitMap D)
        (Limits.kernel.condition (wcEtSuppUnitMap D))).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel (wcEtSuppUnitMap D)) inferInstance hπ
    have hB0 : Limits.IsZero (Dg.Φ.obj (wcEtSuppObj D)) := by
      have hsq := IsPullback.of_hasPullback iW gO
      haveI : IsClosedImmersion (Limits.pullback.snd iW gO) :=
        MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq inferInstance
      have hE : IsEmpty ↥(Limits.pullback iW gO : Scheme.{u}) := by
        apply Scheme.isEmpty_of_commSq hsq.toCommSq
        rw [hrange]
        exact disjoint_compl_right
      obtain ⟨D'⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.snd iW gO) ℓ
      obtain ⟨γ, hγ, _⟩ := wc_et_closed_supp_base_change iW gO (Limits.pullback.snd iW gO)
        (Limits.pullback.fst iW gO) hsq D Dg D'
      have hZ' : Limits.IsZero (wcEtSuppObj D') := by
        rw [Limits.IsZero.iff_id_eq_zero]
        apply SheafOfModules.hom_ext
        apply PresheafOfModules.hom_ext
        intro V
        haveI := wc_et_closed_supp_obj_vanish (Limits.pullback.snd iW gO) ℓ D' V.unop
          (fun _ ⟨p, _⟩ => hE.false p)
        exact (ModuleCat.isZero_of_subsingleton _).eq_of_src _ _
      have h0 : Dg.μ.inv ≫ Dg.Φ.map (wcEtSuppUnitMap D) = 0 := by
        rw [← hγ, hZ'.eq_of_src γ 0, Limits.comp_zero]
      haveI : Dg.Φ.IsLeftAdjoint := Dg.adj.isLeftAdjoint
      haveI : Epi (Dg.Φ.map (wcEtSuppUnitMap D)) := Dg.Φ.map_epi _
      exact Limits.IsZero.of_epi_eq_zero _ h0
    have hSΦ := hS.map_of_exact Dg.Φ
    haveI hιiso : IsIso (Dg.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D))) :=
      hSΦ.isIso_f_iff.mpr hB0
    obtain ⟨c, hcdef⟩ : ∃ c, c = Dg.μ.inv ≫ inv (Dg.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D))) :=
      ⟨_, rfl⟩
    haveI hciso : IsIso c := by rw [hcdef]; infer_instance
    have hc : c ≫ Dg.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D)) = Dg.μ.inv := by
      rw [hcdef, Category.assoc, IsIso.inv_hom_id, Category.comp_id]
    refine ⟨c, hc, fun k => ?_⟩
    haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing W ℓ)) :=
      sheafOfModules_enoughInjectives _ _
    have hA : Function.Bijective (fun x : Abelian.Ext (Limits.kernel (wcEtSuppUnitMap D))
        (SheafOfModules.unit (wcEtZModRing W ℓ)) k => Abelian.Ext.mapExactFunctor Dg.Φ x) := by
      have h := ext_transfer_of_corep Dg.Φ (Limits.kernel (wcEtSuppUnitMap D))
        (Dg.Φ.obj (Limits.kernel (wcEtSuppUnitMap D))) (𝟙 _)
        (fun Y => wc_et_open_restr_ker_corep iW gO hrange ℓ hℓ D Dg Y)
        (fun I _ m e => by
          haveI : Injective (Dg.Φ.obj I) :=
            wc_et_open_pull_preserves_injective gO ℓ Dg I inferInstance
          exact Abelian.Ext.eq_zero_of_injective e)
        (SheafOfModules.unit (wcEtZModRing W ℓ)) k
      have e : (fun β : Abelian.Ext (Limits.kernel (wcEtSuppUnitMap D))
          (SheafOfModules.unit (wcEtZModRing W ℓ)) k =>
          (Abelian.Ext.mk₀ (𝟙 (Dg.Φ.obj (Limits.kernel (wcEtSuppUnitMap D))))).comp
            (Abelian.Ext.mapExactFunctor Dg.Φ β) (zero_add k)) =
          fun β => Abelian.Ext.mapExactFunctor Dg.Φ β :=
        funext fun β => Abelian.Ext.mk₀_id_comp _
      rw [e] at h
      exact h
    have hB : Function.Bijective (fun y : Abelian.Ext (Dg.Φ.obj (Limits.kernel (wcEtSuppUnitMap D)))
        (Dg.Φ.obj (SheafOfModules.unit (wcEtZModRing W ℓ))) k =>
        (Abelian.Ext.mk₀ c).comp (y.comp (Abelian.Ext.mk₀ Dg.μ.hom) (add_zero k)) (zero_add k)) := by
      rw [Function.bijective_iff_has_inverse]
      refine ⟨fun z => ((Abelian.Ext.mk₀ (inv c)).comp z (zero_add k)).comp
        (Abelian.Ext.mk₀ Dg.μ.inv) (add_zero k), ?_, ?_⟩
      · intro y
        simp only
        rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
          IsIso.inv_hom_id, Abelian.Ext.mk₀_id_comp, Abelian.Ext.comp_assoc_of_third_deg_zero,
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
      · intro z
        simp only
        rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
          Abelian.Ext.comp_mk₀_id, ← Abelian.Ext.comp_assoc_of_second_deg_zero,
          Abelian.Ext.mk₀_comp_mk₀, IsIso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    exact hB.comp hA

  intro W' Z' YO' iW' _ gO' _ hr' m hm D' M θ' hθ
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing W' m)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing YO' m)) := HasExt.standard _
  haveI hπ' : Epi (wcEtSuppUnitMap D') := wc_et_supp_unit_epi iW' D'
  have hS' : (ShortComplex.mk (Limits.kernel.ι (wcEtSuppUnitMap D')) (wcEtSuppUnitMap D')
