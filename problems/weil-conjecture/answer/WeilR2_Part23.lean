          DerivedCategory.Q.map ((HomologicalComplex.single (SheafOfModules.{u+1} (wcEtZModRing Y m))
            (ComplexShape.up ℤ) 0).map c) ≫
          DerivedCategory.Q.map
            ((HomologicalComplex.singleMapHomologicalComplex Φ (ComplexShape.up ℤ) 0).inv.app X) ≫
          DerivedCategory.Q.map ((Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map φ) ≫
          DerivedCategory.Q.map (((Φ.mapHomologicalComplex (ComplexShape.up ℤ)).commShiftIso
            (n : ℤ)).hom.app I.cochainComplex) ≫
          (DerivedCategory.Q.commShiftIso (n : ℤ)).hom.app
            ((Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex) ≫
          (DerivedCategory.Q.map t)⟦(n : ℤ)⟧' := by
        simp only [Functor.map_comp, Category.assoc]
        rw [Functor.commShiftIso_hom_naturality]
      rw [s2]
      apply Abelian.Ext.ext
      rw [F0, Abelian.Ext.comp_hom, Abelian.Ext.comp_hom, Abelian.Ext.mk₀_hom, Abelian.Ext.mk₀_hom,
