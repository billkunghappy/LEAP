  have alg : ∀ {L Lc G Md Tp : Type (u+2)} [AddCommGroup L] [AddCommGroup Lc] [AddCommGroup G]
      [AddCommGroup Md] [AddCommGroup Tp]
      (m : ℕ) [NeZero m] (ε : L →+ Lc) (hεi : Function.Injective ε) (hεs : Function.Surjective ε)
      (r : G →+ Md) (Y : L →+ G →+ Tp) (eL : ZMod m ≃+ L) (eM : ZMod m ≃+ Md) (eT : ZMod m ≃+ Tp)
      (η : ZMod m →+ AddCircle (1:ℚ)) (hη : Function.Injective η)
      (hker : ∀ b, r b = 0 ↔ ∀ w, Y w b = 0),
        ∃ (Pr : Lc →+ Md →+ Tp) (χ : Tp →+ AddCircle (1:ℚ)),
        (∀ w, (∀ φ, χ (Pr w φ) = 0) → w = 0) ∧ ∀ w' b, Y w' b = Pr (ε w') (r b) := by
    intro L Lc G Md Tp _ _ _ _ _ m _ ε hεi hεs r Y eL eM eT η hη hker
    classical
