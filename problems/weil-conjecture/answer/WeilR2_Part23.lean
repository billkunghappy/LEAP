    let y : Fin (r + 2) → wcQuadModelRing A (r + 2) π (wcSrmC0 A r) :=
      fun p => Ideal.Quotient.mk IM (MvPolynomial.X p)
    set p0 : Fin (r + 2) := ⟨0, by omega⟩ with hp0
    set p1 : Fin (r + 2) := ⟨1, by omega⟩ with hp1

    have hGen : ∀ i : Fin (r + 2), wcSrmGen A r π i =
        x ⟨2 * (i.val / 2), lt_of_le_of_lt (Nat.mul_div_le i.val 2) i.isLt⟩ := fun i => rfl
