theorem wc_et_isolated_geom_point_nbhd : ∀ {X V T : Scheme.{u}} (φ : V ⟶ X) [Etale φ] [IsSeparated φ] (x : X), IsClosedImmersion (wcEtGeomPt X x) → ∀ (π : T ⟶ V) (c : T), (∀ t : T, t ⤳ c) → φ (π c) = x → ∃ (V' : V.Opens) (π' : T ⟶ (V' : Scheme.{u})) (v₀ : Spec (.of (AlgebraicClosure (X.residueField x))) ⟶ (V' : Scheme.{u})), π' ≫ V'.ι = π ∧ IsClosedImmersion v₀ ∧ v₀ ≫ V'.ι ≫ φ = wcEtGeomPt X x ∧ ∀ v : (V' : Scheme.{u}), φ (V'.ι v) = x → v = v₀ (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x))) :=
by
  intro X V T φ _ _ x hx π c hc hz
  obtain ⟨U, hzU, hiso⟩ := wc_etale_fibre_point_isolated φ (π c)
  have hsub : Set.range π ⊆ Set.range U.ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨t, rfl⟩
    exact ((hc t).map π.continuous).mem_open U.isOpen hzU
  refine ⟨U, IsOpenImmersion.lift U.ι π hsub, ?_⟩
  set z' : (U : Scheme.{u}) := ⟨π c, hzU⟩ with hz'
  have hε : (U.ι ≫ φ) z' = x := by
    rw [Scheme.Hom.comp_apply]
    exact hz
  obtain ⟨ι, hι⟩ := wc_etale_geom_point_residue_iso (U.ι ≫ φ) z' x hε
  have h5 : (ι.inv ≫ wcEtGeomPt (U : Scheme.{u}) z') ≫ U.ι ≫ φ = wcEtGeomPt X x := by
    rw [Category.assoc, ← hι, Iso.inv_hom_id_assoc]
  have hci : IsClosedImmersion (ι.inv ≫ wcEtGeomPt (U : Scheme.{u}) z') := by
    have : IsClosedImmersion ((ι.inv ≫ wcEtGeomPt (U : Scheme.{u}) z') ≫ (U.ι ≫ φ)) := by
      rw [h5]; exact hx
    exact IsClosedImmersion.of_comp _ (U.ι ≫ φ)
  have hpt : ∀ q, (wcEtGeomPt (U : Scheme.{u}) z') q = z' := fun q => by
    rw [Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]
  refine ⟨ι.inv ≫ wcEtGeomPt (U : Scheme.{u}) z', IsOpenImmersion.lift_fac _ _ _, hci, h5, ?_⟩
  intro v hv
  have hmem : U.ι v ∈ U := by
    have h0 : U.ι v ∈ Set.range U.ι := ⟨v, rfl⟩
    rwa [Scheme.Opens.range_ι] at h0
  have h1 : U.ι v = π c := hiso _ hmem (hv.trans hz.symm)
  have h2 : U.ι z' = π c := rfl
  have hvz : v = z' := U.ι.isOpenEmbedding.injective (h1.trans h2.symm)
  exact hvz.trans ((Scheme.Hom.comp_apply _ _ _).trans (hpt _)).symm

theorem wc_shdata_closed_fibre_center : ∀ {Y Z : Scheme.{u}} (y : Y) (B : Type u) [CommRing B] [IsLocalRing B] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Y), wcHalShData y B Λ W' φ a → ∀ (ι : Z ⟶ Y) [IsClosedImmersion ι] (z : Z), ι z = y → ∃ c : ↥(Limits.pullback a ι), Limits.pullback.snd a ι c = z ∧ ∀ t : ↥(Limits.pullback a ι), t ⤳ c :=
by
  intro Y Z y B _ _ Λ _ _ W' φ a h ι _ z hz
  obtain ⟨e, -, he⟩ := h.2.2.2.2.2
  have ha : a (IsLocalRing.closedPoint B) = y := by
    set p₀ : ↥(Spec (.of (AlgebraicClosure (Y.residueField y)))) :=
      IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)) with hp₀
    have h1 : (Spec.map (CommRingCat.ofHom e) ≫ Spec.map (CommRingCat.ofHom
        (IsLocalRing.residue B)) ≫ a) p₀ = (wcEtGeomPt Y y) p₀ := by rw [he]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h1
    have h2 : (wcEtGeomPt Y y) p₀ = y := by
      first
        | rw [Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]
        | simp only [wcEtGeomPt, Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]
        | exact Scheme.fromSpecResidueField_apply y _
    rw [h2] at h1
    rw [← h1]
    congr 1
    exact (IsLocalRing.PrimeSpectrum.comap_residue B _).symm
  obtain ⟨c, hc1, hc2⟩ := Scheme.Pullback.exists_preimage_pullback (f := a) (g := ι)
    (IsLocalRing.closedPoint B) z (ha.trans hz.symm)
  refine ⟨c, hc2, fun t => ?_⟩
  have hind := (Limits.pullback.fst a ι).isClosedEmbedding.isInducing
  apply hind.specializes_iff.mp
  rw [hc1]
  exact IsLocalRing.specializes_closedPoint _

theorem wc_shdata_baseChange_pull_surj : ∀ {Y Z : Scheme.{u}} (y : Y) (B : Type u) [CommRing B] [IsLocalRing B] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Y), wcHalShData y B Λ W' φ a → ∀ (h : Z ⟶ Y) [QuasiCompact h] [QuasiSeparated h] (OZ : Scheme.{u}) (p : OZ ⟶ Z) (hZ : OZ ⟶ Spec (.of B)), IsPullback p hZ h a → ∀ (m q : ℕ) (y' : wcEtZModExt OZ m q), ∃ (l : Λ) (x : wcEtZModExt (Limits.pullback (W'.obj l).right.hom h) m q), ∀ (πl : OZ ⟶ Limits.pullback (W'.obj l).right.hom h), πl ≫ Limits.pullback.fst (W'.obj l).right.hom h = hZ ≫ φ l → πl ≫ Limits.pullback.snd (W'.obj l).right.hom h = p → ∀ E : wcEtPullData πl m, wcEtPull E q x = y' :=
by
  intro Y Z y B _ _ Λ _ _ W' φ a hsh h _ _ OZ p hZ hpb m q y'
  obtain ⟨-, hAff, hcompat, hφa, hlim, -⟩ := hsh
  let W₀ : Λ ⥤ Y.Etale :=
    W' ⋙ StructuredArrow.proj (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)
  obtain ⟨π, hπ1, hπ2, hπ3, hπ4⟩ :=
    wc_et_baseChange_limit_cone h B Λ W₀ φ a hcompat hφa hlim OZ p hZ hpb
  have hfstQC : ∀ l, QuasiCompact (Limits.pullback.fst (W₀.obj l).hom h) := fun l =>
    MorphismProperty.of_isPullback (P := @QuasiCompact)
      (IsPullback.of_hasPullback (W₀.obj l).hom h).flip inferInstance
  have hfstQS : ∀ l, QuasiSeparated (Limits.pullback.fst (W₀.obj l).hom h) := fun l =>
    MorphismProperty.of_isPullback (P := @QuasiSeparated)
      (IsPullback.of_hasPullback (W₀.obj l).hom h).flip inferInstance
  have hLc : ∀ l, CompactSpace ((W₀ ⋙ wcEtBaseChange h).obj l).left := fun l => by
    haveI : IsAffine ((𝟭 Scheme.{u}).obj (W₀.obj l).left) := hAff l
    haveI : IsAffine (W₀.obj l).left := hAff l
    exact @QuasiCompact.compactSpace_of_compactSpace _ _
      (Limits.pullback.fst (W₀.obj l).hom h) (hfstQC l) inferInstance
  have hLq : ∀ l, QuasiSeparatedSpace ((W₀ ⋙ wcEtBaseChange h).obj l).left := fun l => by
    haveI : IsAffine ((𝟭 Scheme.{u}).obj (W₀.obj l).left) := hAff l
    haveI : IsAffine (W₀.obj l).left := hAff l
    exact @quasiSeparatedSpace_of_quasiSeparated _ _
      (Limits.pullback.fst (W₀.obj l).hom h) inferInstance (hfstQS l)
  have M1 : ∀ {l l' : Λ} (t' : l ⟶ l'),
      ((W₀ ⋙ wcEtBaseChange h).map t').left ≫ Limits.pullback.fst (W₀.obj l').hom h =
        Limits.pullback.fst (W₀.obj l).hom h ≫ (W₀.map t').left := by
    intro l l' t'
    exact Limits.pullback.lift_fst _ _ _
  have M2 : ∀ {l l' : Λ} (t' : l ⟶ l'),
      ((W₀ ⋙ wcEtBaseChange h).map t').left ≫ Limits.pullback.snd (W₀.obj l').hom h =
        Limits.pullback.snd (W₀.obj l).hom h := by
    intro l l' t'
    exact Limits.pullback.lift_snd _ _ _
  have C6 : ∀ {l l' : Λ} (t' : l ⟶ l'), IsAffineHom ((W₀ ⋙ wcEtBaseChange h).map t').left := by
    intro l l' t'
    have := hAff l
    have := hAff l'
    have Rr : IsPullback (Limits.pullback.snd (W₀.obj l').hom h)
        (Limits.pullback.fst (W₀.obj l').hom h) h (W₀.obj l').hom :=
      (IsPullback.of_hasPullback (W₀.obj l').hom h).flip
    have O : IsPullback (((W₀ ⋙ wcEtBaseChange h).map t').left ≫
        Limits.pullback.snd (W₀.obj l').hom h) (Limits.pullback.fst (W₀.obj l).hom h) h
        ((W₀.map t').left ≫ (W₀.obj l').hom) := by
      rw [M2 t', MorphismProperty.Over.w (W₀.map t')]
      exact (IsPullback.of_hasPullback (W₀.obj l).hom h).flip
    have L : IsPullback ((W₀ ⋙ wcEtBaseChange h).map t').left
        (Limits.pullback.fst (W₀.obj l).hom h) (Limits.pullback.fst (W₀.obj l').hom h)
        (W₀.map t').left :=
      IsPullback.of_right O (M1 t') Rr
    haveI : IsAffine (W₀.obj l).left := hAff l
    haveI : IsAffine (W₀.obj l').left := hAff l'
    exact MorphismProperty.of_isPullback (P := @IsAffineHom) L.flip
      (isAffineHom_of_isAffine (W₀.map t').left)
  haveI : QuasiCompact hZ :=
    MorphismProperty.of_isPullback (P := @QuasiCompact) hpb inferInstance
  haveI : QuasiSeparated hZ :=
    MorphismProperty.of_isPullback (P := @QuasiSeparated) hpb inferInstance
  have hPc : CompactSpace OZ := QuasiCompact.compactSpace_of_compactSpace hZ
  have hPs : QuasiSeparatedSpace OZ := quasiSeparatedSpace_of_quasiSeparated hZ
  obtain ⟨l, x, hx⟩ := wc_et_limit_pull_surj_qcqs_all p Λ (W₀ ⋙ wcEtBaseChange h) π hπ1 hπ3 hπ4
    hLc hLq C6 hPc hPs m q y'
  refine ⟨l, x, ?_⟩
  intro πl h1 h2
  have heq : πl = π l := by
    apply Limits.pullback.hom_ext
    · rw [h1]; exact (hπ2 l).symm
    · rw [h2]; exact (hπ1 l).symm
  subst heq
  exact hx

theorem wc_et_tpl_det_shens_supp_restr_surj (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (k : ℕ) (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left
      (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left))
    (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left)
    (hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a)
    (x : ↥(Limits.pullback D.f a)) (hx : Limits.pullback.fst D.f a x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Limits.pullback D.f a) x))
      (Scheme.Etale.forget (Limits.pullback D.f a)))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ Limits.pullback D.f a)
    (hsh : wcHalShData x B Λ' W'' φ' a')
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)))
    (hxs : Limits.pullback.fst (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A) xs = x)
    (Dx : wcEtPullData (wcEtGeomPt (Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)) xs) (ℓ ^ k))
    (Dw : wcEtPullData (Limits.pullback.snd a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (ℓ ^ k))
    (D' : wcEtPullData (Limits.pullback.snd (wcEtGeomPt (Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)) xs) (Limits.pullback.snd a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)))) (ℓ ^ k))
    (γ : wcEtSuppObj D' ⟶ Dw.Φ.obj (wcEtSuppObj Dx))
    (hγ : wcEtSuppUnitMap D' ≫ γ = Dw.μ.inv ≫ Dw.Φ.map (wcEtSuppUnitMap Dx))
    (hac : ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtZModExt (Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (ℓ ^ k) q)) :
    Function.Surjective (wcEtSuppRestr Dx Dw D' γ (n - 1)) :=
by
  classical

  have finish : ∀ {XA Xs WS Vl : Scheme.{u}} (ιs : Xs ⟶ XA) [IsClosedImmersion ιs] (xs : Xs)
      [IsClosedImmersion (wcEtGeomPt Xs xs)] (U : Xs.Opens) (_hU : (U : Set Xs) = {xs}ᶜ)
