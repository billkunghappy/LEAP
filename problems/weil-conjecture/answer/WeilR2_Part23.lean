    refine h1.trans ?_
    show ((T.f ((n : ℤ) + 1)).val.app (Opposite.op (W'.obj l).right)).hom
      (((K.d (n : ℤ) ((n : ℤ) + 1)).val.app (Opposite.op (W'.obj l).right)).hom c1) = 0
    rw [show ((K.d (n : ℤ) ((n : ℤ) + 1)).val.app (Opposite.op (W'.obj l).right)).hom c1 = 0
