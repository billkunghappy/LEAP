  have hxy : x1b * y 0 = 1 := by rw [hy0, mul_comm]; exact hcx

  have hz0 : z 0 = (Spec.preimage ξ).hom π := by simpa using hz1 0
  have hφπ : IsUnit ((Spec.preimage ξ).hom π) := by
