    refine (hσ0 _).trans ?_
    rw [MvPolynomial.renameEquiv_apply, MvPolynomial.rename_X, hTk]

  obtain ⟨Φ, hΦ⟩ : ∃ Φ : Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 MAT)) ⟶
      Spec (.of (wcQuadModelRing K (2 * e + 1 + 1) 0 MAT)),
      Φ = Spec.map (CommRingCat.ofHom (σ : wcQuadModelRing K (2 * e + 1 + 1) 0 MAT →+*
