    · have key : ∀ (a : ℤ) (k : ℕ),
          α (AddMonoidAlgebra.single
            (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) (1 : L)) =
          β (AddMonoidAlgebra.single
            (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) (1 : L)) := by
        intro a k
        obtain ⟨n, rfl | rfl⟩ := Int.eq_nat_or_neg a
        · exact h n k 1
        · have hinv : AddMonoidAlgebra.single
              (Localization.mk (-(n : ℤ)) ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ))
              (1 : L) *
              AddMonoidAlgebra.single
              (Localization.mk (n : ℤ) ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ))
