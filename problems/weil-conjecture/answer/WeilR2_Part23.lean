      (P : (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj (wcEtSuppObj Dx)) ⟶ (DerivedCategory.Q.obj Ψ)⟦(((n - 1) : ℕ) : ℤ)⟧) →+ (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k)))) ⟶ (DerivedCategory.Q.obj (CochainComplex.mappingCone eΨ))⟦(((n - 1) : ℕ) : ℤ)⟧) →+ AddCircle (1 : ℚ)),
      (∀ w, (∀ φ, P w φ = 0) → w = 0) ∧
      ∀ w δ, β δ = DerivedCategory.Q.map ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map (wcEtSuppUnitMap Dx)) ≫ w →
        ∀ z, tr₀ (wcEtZModCup (Limits.pullback (Limits.pullback.snd D.f a) ξ) (ℓ ^ k) (n - 1) (n - 1) (2 * (n - 1)) (two_mul (n - 1)).symm δ z) = P w (β z ≫ (DerivedCategory.Q.map (CochainComplex.mappingCone.inr eΨ))⟦(((n - 1) : ℕ) : ℤ)⟧') :=
by
  have key : ∀ {𝒞 : Type _} [Category 𝒞] [Preadditive 𝒞] [HasShift 𝒞 ℤ]
      {H1 H2 : Type _} [AddCommGroup H1] [AddCommGroup H2]
      (L S Ψo Co : 𝒞) (N R : ℤ) (hNR : N + N = R)
      (e : L ⟶ Ψo) (inr : Ψo ⟶ Co) (ιs : L ⟶ S)
      (β : H1 → (L ⟶ Ψo⟦N⟧)) (cup : H1 →+ H1 →+ H2)
      (_h1 : ∃ β₂ : H2 →+ (L ⟶ Ψo⟦R⟧), ∀ z, ∃ M : Ψo ⟶ Ψo⟦N⟧, e ≫ M = β z ∧
        ∀ δ, β₂ (cup δ z) = β δ ≫ M⟦N⟧' ≫ (shiftFunctorAdd' 𝒞 N N R hNR).inv.app Ψo)
      (_h2 : ∀ w : S ⟶ Ψo⟦N⟧, ∃ w' : S ⟶ L⟦N⟧, w = w' ≫ e⟦N⟧')
      (_h3 : (∃ b : L ⟶ Ψo⟦N⟧, b ≫ inr⟦N⟧' ≠ 0) → ∀ v : S ⟶ Ψo⟦R⟧, ιs ≫ v = 0 → v = 0)
      (_h4 : ∃ (Pr : (S ⟶ Ψo⟦N⟧) →+ (L ⟶ Co⟦N⟧) →+ (S ⟶ Ψo⟦R⟧))
          (χ : (S ⟶ Ψo⟦R⟧) →+ AddCircle (1 : ℚ)),
        (∀ w, (∀ φ, χ (Pr w φ) = 0) → w = 0) ∧
        ∀ (w' : S ⟶ L⟦N⟧) (b : L ⟶ Ψo⟦N⟧),
          w' ≫ b⟦N⟧' ≫ (shiftFunctorAdd' 𝒞 N N R hNR).inv.app Ψo = Pr (w' ≫ e⟦N⟧') (b ≫ inr⟦N⟧')),
      ∃ (tr₀ : H2 →+ AddCircle (1 : ℚ)) (P : (S ⟶ Ψo⟦N⟧) →+ (L ⟶ Co⟦N⟧) →+ AddCircle (1 : ℚ)),
        (∀ w, (∀ φ, P w φ = 0) → w = 0) ∧
        ∀ w δ, β δ = ιs ≫ w → ∀ z, tr₀ (cup δ z) = P w (β z ≫ inr⟦N⟧') := by
    intro 𝒞 _ _ _ H1 H2 _ _ L S Ψo Co N R hNR e inr ιs β cup h1 h2 h3 h4
    obtain ⟨Pr, χ, hnd, hcomp⟩ := h4
    by_cases h0 : ∃ z, β z ≫ inr⟦N⟧' ≠ 0
    · obtain ⟨z₀, hz₀⟩ := h0
      obtain ⟨β₂, hβ₂⟩ := h1
      have hl : ∀ v : S ⟶ Ψo⟦R⟧, Preadditive.leftComp (Ψo⟦R⟧) ιs v = ιs ≫ v := fun v => rfl
      have hinj : Function.Injective (Preadditive.leftComp (Ψo⟦R⟧) ιs) := by
        intro v v' hvv
        rw [hl, hl] at hvv
        have h := h3 ⟨β z₀, hz₀⟩ (v - v') (by rw [Preadditive.comp_sub, sub_eq_zero]; exact hvv)
        exact sub_eq_zero.mp h
      obtain ⟨χt, hχt⟩ : ∃ χt : (L ⟶ Ψo⟦R⟧) →+ AddCircle (1 : ℚ),
          ∀ v, χt (Preadditive.leftComp (Ψo⟦R⟧) ιs v) = χ v := by
        obtain ⟨c, hc⟩ := CharacterModule.dual_surjective_of_injective
          (Preadditive.leftComp (Ψo⟦R⟧) ιs).toIntLinearMap hinj (χ : CharacterModule (S ⟶ Ψo⟦R⟧))
        refine ⟨c, fun v => ?_⟩
        have := congrArg (fun g : CharacterModule (S ⟶ Ψo⟦R⟧) => g v) hc
        rw [CharacterModule.dual_apply] at this
        exact this
      refine ⟨χt.comp β₂, Pr.compr₂ χ, fun w hw => hnd w hw, ?_⟩
      intro w δ hδ z
      obtain ⟨M, hM, hcup⟩ := hβ₂ z
      obtain ⟨w', rfl⟩ := h2 w
      rw [AddMonoidHom.comp_apply, hcup δ, hδ, AddMonoidHom.compr₂_apply, ← hcomp, ← hχt, hl, ← hM,
        Functor.map_comp]
      simp only [Category.assoc]
    · push_neg at h0
      refine ⟨0, Pr.compr₂ χ, fun w hw => hnd w hw, ?_⟩
      intro w δ _ z
      rw [h0 z, map_zero, AddMonoidHom.zero_apply]
  intro P' K eK eΨ Ψ F Hq Hq' c β
  have h1 := wc_et_beta_cup_endo Dh Dg I (n - 1) (2 * (n - 1)) (two_mul (n - 1)).symm
  have h2 := wc_et_tpl_supp_factor_unit F' F'' Y n hn hn2 D ℓ hℓ k i A Λ W' φ a hA η hηb hηne ξ hξ
    x hx B Λ' W'' φ' a' hsh Dh Dg I xs hxs Dx
  have h3 := wc_et_tpl_top_supp_injective F' F'' Y n hn hn2 D ℓ hℓ k i A Λ W' φ a hA η hηb hηne ξ hξ
    x hx B Λ' W'' φ' a' hsh Dh Dg I xs hxs Dx
  have h4 := wc_et_tpl_local_pairing F' F'' Y n hn hn2 D ℓ hℓ k i A Λ W' φ a hA η hηb hηne ξ hξ
    x hx B Λ' W'' φ' a' hsh Dh Dg I xs hxs Dx
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k)))
  exact key
    (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
      (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k)))))
    (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj (wcEtSuppObj Dx)))
    (DerivedCategory.Q.obj Ψ) (DerivedCategory.Q.obj (CochainComplex.mappingCone eΨ))
    (((n - 1) : ℕ) : ℤ) (((2 * (n - 1)) : ℕ) : ℤ) (by omega)
    (DerivedCategory.Q.map eΨ) (DerivedCategory.Q.map (CochainComplex.mappingCone.inr eΨ))
    (DerivedCategory.Q.map ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map (wcEtSuppUnitMap Dx)))
    β (wcEtZModCup (Limits.pullback (Limits.pullback.snd D.f a) ξ) (ℓ ^ k) (n - 1) (n - 1) (2 * (n - 1))
      (two_mul (n - 1)).symm) h1 h2 h3 h4

theorem wc_et_tpl_morse_chart_A (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left
      (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left))
    (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left)
    (hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a)
    (x : ↥(Limits.pullback D.f a)) (hx : Limits.pullback.fst D.f a x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Limits.pullback D.f a) x))
      (Scheme.Etale.forget (Limits.pullback D.f a)))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ Limits.pullback D.f a)
    (hsh : wcHalShData x B Λ' W'' φ' a') :
    ∃ (_ : IsDomain A), IsDiscreteValuationRing A ∧ IsUnit ((ℓ : ℕ) : A) ∧
      ∃ (π : A) (c : Matrix (Fin n) (Fin n) A), IsLocalRing.maximalIdeal A = Ideal.span {π} ∧
        IsUnit (c + c.transpose).det ∧
        ∃ (U : Scheme.{u}) (jU : U ⟶ Limits.pullback D.f a)
          (eU : U ⟶ Spec (.of (wcQuadModelRing A n π c))),
          Etale jU ∧ Etale eU ∧ jU ≫ Limits.pullback.snd D.f a = eU ≫ wcQuadModelStr A n π c ∧
          ∃ u : U, ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
            PrimeSpectrum.asIdeal (eU u) :=
by
  classical
  have comp_ap : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (x : X), (f ≫ g) x = g (f x) :=
    fun _ _ _ => rfl

  have hγ : ∀ (c : (wcP1Over F'').left)
      (x : Spec (.of (AlgebraicClosure ((wcP1Over F'').left.residueField c)))),
      wcEtGeomPt (wcP1Over F'').left c x = c := by
    intro c x
    first
    | exact Scheme.fromSpecResidueField_apply c _
    | (unfold wcEtGeomPt; rw [comp_ap]; exact Scheme.fromSpecResidueField_apply c _)
    | (simp only [wcEtGeomPt, comp_ap, Scheme.fromSpecResidueField_apply])
    | (simp [wcEtGeomPt])
  have hwN : ∀ (c : (wcP1Over F'').left)
      (N : StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left c))
        (Scheme.Etale.forget (wcP1Over F'').left)),
      N.hom.left ≫ N.right.hom = wcEtGeomPt (wcP1Over F'').left c := fun c N => Over.w N.hom
  obtain ⟨l₁⟩ : Nonempty Λ := IsCofiltered.nonempty
  have hφa : ∀ l, φ l ≫ (W'.obj l).right.hom = a := hA.2.2.2.1
  have hcl := wc_shdata_closed_point_compat _ A Λ W' φ a hA l₁
  have ha_cl : a (IsLocalRing.closedPoint A) = D.S i (IsLocalRing.closedPoint F'') := by
    calc a (IsLocalRing.closedPoint A)
        = (φ l₁ ≫ (W'.obj l₁).right.hom) (IsLocalRing.closedPoint A) := by rw [hφa l₁]
      _ = (W'.obj l₁).right.hom (φ l₁ (IsLocalRing.closedPoint A)) := comp_ap _ _ _
      _ = (W'.obj l₁).right.hom ((W'.obj l₁).hom.left (IsLocalRing.closedPoint
            (AlgebraicClosure ((wcP1Over F'').left.residueField
              (D.S i (IsLocalRing.closedPoint F'')))))) := by rw [hcl]
      _ = ((W'.obj l₁).hom.left ≫ (W'.obj l₁).right.hom) (IsLocalRing.closedPoint
            (AlgebraicClosure ((wcP1Over F'').left.residueField
              (D.S i (IsLocalRing.closedPoint F''))))) := (comp_ap _ _ _).symm
      _ = D.S i (IsLocalRing.closedPoint F'') := by rw [hwN _ (W'.obj l₁)]; exact hγ _ _

  obtain ⟨j, β, hj, hjK, hjb⟩ := wc_morse_p1_rational_chart F'' (D.S i) (D.hS i)
  haveI := hj
  have hb : D.S i (IsLocalRing.closedPoint F'') =
      j (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom β)) (IsLocalRing.closedPoint F'')) := by
    exact (congrArg (fun g => g (IsLocalRing.closedPoint F'')) hjb).symm

  have hrange : Set.range a ⊆ Set.range j := by
    rintro _ ⟨p, rfl⟩
    have h1 : a p ⤳ a (IsLocalRing.closedPoint A) :=
      (IsLocalRing.specializes_closedPoint p).map a.continuous
    rw [ha_cl, hb] at h1
    exact h1.mem_open (IsOpenImmersion.isOpen_range j) ⟨_, rfl⟩
  obtain ⟨aV, haV⟩ : ∃ aV : Spec (.of A) ⟶ Spec (.of (Polynomial F'')), aV ≫ j = a :=
    ⟨_, IsOpenImmersion.lift_fac j a hrange⟩

  obtain ⟨hdom, hdvr, hmax⟩ := wc_morse_shens_chart_dvr F'' j β hj _ hb A Λ W' φ a hA aV haV
  obtain ⟨ρ, rfl⟩ : ∃ ρ : Polynomial F'' →+* A, Spec.map (CommRingCat.ofHom ρ) = aV :=
    ⟨_, Spec.map_preimage aV⟩
  rw [Spec.preimage_map, CommRingCat.hom_ofHom] at hmax

  obtain ⟨U, u, φU, c, σ, hu, hφU, hc, hcomm, hσ, hT⟩ :=
    wc_morse_odp_etale_chart F' F'' Y n hn2 D i j β hj hjK hjb
  haveI : Etale u := hu
  haveI : Etale φU := hφU

  have hM := wc_morse_quad_model_isPullback F'' A n β c ρ
  have Lbc : ∀ {U Y P S M T V : Scheme.{u}} (u : U ⟶ Y) (f : Y ⟶ P) (a : S ⟶ P) (φ : U ⟶ T)
      (m1 : M ⟶ T) (m2 : M ⟶ S) (q : T ⟶ V) (aV : S ⟶ V) (j : V ⟶ P), u ≫ f = φ ≫ q ≫ j →
      aV ≫ j = a → IsPullback m1 m2 q aV →
      ∀ ψ : Limits.pullback u (Limits.pullback.fst f a) ⟶ M,
      ψ ≫ m1 = Limits.pullback.fst u (Limits.pullback.fst f a) ≫ φ →
      ψ ≫ m2 = Limits.pullback.snd u (Limits.pullback.fst f a) ≫ Limits.pullback.snd f a →
      IsPullback (Limits.pullback.fst u (Limits.pullback.fst f a)) ψ φ m1 := by
    intro U Y P S M T V u f a φ m1 m2 q aV j hc haV hM ψ h1 h2
    have hw : ∀ s : Limits.PullbackCone φ m1, (s.fst ≫ u) ≫ f = (s.snd ≫ m2) ≫ a := by
      intro s
      calc (s.fst ≫ u) ≫ f = s.fst ≫ φ ≫ q ≫ j := by rw [Category.assoc, hc]
        _ = (s.fst ≫ φ) ≫ q ≫ j := by rw [Category.assoc]
        _ = (s.snd ≫ m1) ≫ q ≫ j := by rw [s.condition]
        _ = s.snd ≫ (m1 ≫ q) ≫ j := by simp only [Category.assoc]
        _ = s.snd ≫ (m2 ≫ aV) ≫ j := by rw [hM.w]
        _ = (s.snd ≫ m2) ≫ aV ≫ j := by simp only [Category.assoc]
        _ = (s.snd ≫ m2) ≫ a := by rw [haV]
    refine IsPullback.of_isLimit (Limits.PullbackCone.IsLimit.mk h1.symm
      (fun s => Limits.pullback.lift s.fst
        (Limits.pullback.lift (s.fst ≫ u) (s.snd ≫ m2) (hw s))
        (Limits.pullback.lift_fst _ _ _).symm) ?_ ?_ ?_)
    · intro s
      exact Limits.pullback.lift_fst _ _ _
    · intro s
      try dsimp only
      apply hM.hom_ext
      · rw [Category.assoc, h1, ← Category.assoc, Limits.pullback.lift_fst, s.condition]
      · rw [Category.assoc, h2, ← Category.assoc, Limits.pullback.lift_snd,
          Limits.pullback.lift_snd]
    · intro s m' hm1 hm2
      try dsimp only
      apply Limits.pullback.hom_ext
      · rw [hm1, Limits.pullback.lift_fst]
      · rw [Limits.pullback.lift_snd]
        apply Limits.pullback.hom_ext
        · rw [Limits.pullback.lift_fst, Category.assoc, ← Limits.pullback.condition,
            ← Category.assoc, hm1]
        · rw [Limits.pullback.lift_snd, Category.assoc, ← h2, ← Category.assoc, hm2]
  have hw' : (Limits.pullback.fst u (Limits.pullback.fst D.f a) ≫ φU) ≫
      Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.C β +
        ∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q))) =
      (Limits.pullback.snd u (Limits.pullback.fst D.f a) ≫ Limits.pullback.snd D.f a) ≫
        Spec.map (CommRingCat.ofHom ρ) := by
    rw [← cancel_mono j]
    simp only [Category.assoc]
    rw [haV, ← hcomm, Limits.pullback.condition_assoc, Limits.pullback.condition]
  obtain ⟨ψ, hψ1, hψ2⟩ : ∃ ψ : Limits.pullback u (Limits.pullback.fst D.f a) ⟶
      Spec (.of (wcQuadModelRing A n (ρ (Polynomial.X - Polynomial.C β))
        (c.map (ρ.comp Polynomial.C)))),
      ψ ≫ Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk (wcQuadModelIdeal A n
          (ρ (Polynomial.X - Polynomial.C β)) (c.map (ρ.comp Polynomial.C)))).comp
          (MvPolynomial.map (ρ.comp Polynomial.C)))) =
        Limits.pullback.fst u (Limits.pullback.fst D.f a) ≫ φU ∧
      ψ ≫ wcQuadModelStr A n (ρ (Polynomial.X - Polynomial.C β)) (c.map (ρ.comp Polynomial.C)) =
        Limits.pullback.snd u (Limits.pullback.fst D.f a) ≫ Limits.pullback.snd D.f a :=
    ⟨hM.lift _ _ hw', hM.lift_fst _ _ _, hM.lift_snd _ _ _⟩
  have hP := Lbc u D.f a φU _ _ _ _ j hcomm haV hM ψ hψ1 hψ2
  have hψet : Etale ψ := MorphismProperty.of_isPullback (P := @Etale) hP hφU
  have hjU : Etale (Limits.pullback.snd u (Limits.pullback.fst D.f a)) :=
    MorphismProperty.of_isPullback (P := @Etale)
      (IsPullback.of_hasPullback u (Limits.pullback.fst D.f a)) hu

  have hux : u (σ (IsLocalRing.closedPoint F'')) = Limits.pullback.fst D.f a x := by
    rw [hx]
    exact congrArg (fun g => g (IsLocalRing.closedPoint F'')) hσ
  obtain ⟨x', hx'1, hx'2⟩ :=
    Scheme.Pullback.exists_preimage_pullback (σ (IsLocalRing.closedPoint F'')) x hux
  have hm1x : (Spec.map (CommRingCat.ofHom ((Ideal.Quotient.mk (wcQuadModelIdeal A n
      (ρ (Polynomial.X - Polynomial.C β)) (c.map (ρ.comp Polynomial.C)))).comp
      (MvPolynomial.map (ρ.comp Polynomial.C))))) (ψ x') =
      φU (σ (IsLocalRing.closedPoint F'')) := by
    rw [← hx'1]
    exact congrArg (fun g => g x') hψ1
  have hTp : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n (ρ (Polynomial.X - Polynomial.C β))
      (c.map (ρ.comp Polynomial.C))) (MvPolynomial.X p) ∈ PrimeSpectrum.asIdeal (ψ x') := by
    intro p
    have h1 := hT p
    rw [← hm1x] at h1
    have h2 : Ideal.Quotient.mk (wcQuadModelIdeal A n (ρ (Polynomial.X - Polynomial.C β))
        (c.map (ρ.comp Polynomial.C))) (MvPolynomial.map (ρ.comp Polynomial.C)
          (MvPolynomial.X p)) ∈ PrimeSpectrum.asIdeal (ψ x') := h1
    rwa [MvPolynomial.map_X] at h2

  have hℓF : ((ℓ : ℕ) : F'') ≠ 0 := by
    intro h0
    haveI := Fintype.ofFinite F''
    have hq : ((Nat.card F'' : ℕ) : F'') = 0 := by
      rw [Nat.card_eq_fintype_card]
      exact FiniteField.cast_card_eq_zero F''
    have hcop : Nat.Coprime ℓ (Nat.card F'') :=
      (Nat.Prime.coprime_iff_not_dvd (Fact.out : ℓ.Prime)).mpr hℓ
    have hbez := Nat.gcd_eq_gcd_ab ℓ (Nat.card F'')
    rw [hcop.gcd_eq_one] at hbez
    have h3 := congrArg (fun z : ℤ => (z : F'')) hbez
    push_cast at h3
    rw [h0, hq] at h3
    simp at h3
  have hℓA : IsUnit ((ℓ : ℕ) : A) := by
    have h1 : IsUnit ((ρ.comp Polynomial.C) ((ℓ : ℕ) : F'')) :=
      (isUnit_iff_ne_zero.mpr hℓF).map _
    rwa [map_natCast] at h1

  have hc' : IsUnit ((c.map (ρ.comp Polynomial.C)) +
      (c.map (ρ.comp Polynomial.C)).transpose).det := by
    have h1 : (c.map (ρ.comp Polynomial.C)) + (c.map (ρ.comp Polynomial.C)).transpose =
        (ρ.comp Polynomial.C).mapMatrix (c + c.transpose) := by
      ext p q
      simp
    rw [h1, ← RingHom.map_det]
    exact (isUnit_iff_ne_zero.mpr hc).map _
  exact ⟨hdom, hdvr, hℓA, ρ (Polynomial.X - Polynomial.C β), c.map (ρ.comp Polynomial.C), hmax,
    hc', Limits.pullback u (Limits.pullback.fst D.f a),
    Limits.pullback.snd u (Limits.pullback.fst D.f a), ψ, hjU, hψet, hψ2.symm, x', hTp⟩

theorem wc_et_tpl_slice_push_bc {S S' U S'U : Scheme.{u}} {f : S' ⟶ S} {w : S' ⟶ S'} {m : ℕ}
    (hcomp : w ≫ f = f)
    (u : U ⟶ S) (hu : Etale u) (u' : S'U ⟶ S') (hu' : Etale u') (fU : S'U ⟶ U)
    (hpbf : IsPullback u' fU f u)
    (wU : S'U ⟶ S'U) (hcompU : wU ≫ fU = fU) (hwU : wU ≫ u' = u' ≫ w)
    (hpbw : IsPullback u' wU w u')
    (Df : wcEtPullData f m) (Dw : wcEtPullData w m)
    (DfU : wcEtPullData fU m) (DwU : wcEtPullData wU m)
    (hc : (wcEtSlice (MorphismProperty.Over.mk ⊤ u hu : S.Etale)).IsContinuous
      (Scheme.smallEtaleTopology U) (Scheme.smallEtaleTopology S))
    (hcc : (wcEtSlice (MorphismProperty.Over.mk ⊤ u hu : S.Etale)).IsCocontinuous
      (Scheme.smallEtaleTopology U) (Scheme.smallEtaleTopology S))
    (hc' : (wcEtSlice (MorphismProperty.Over.mk ⊤ u' hu' : S'.Etale)).IsContinuous
      (Scheme.smallEtaleTopology S'U) (Scheme.smallEtaleTopology S'))
    (hcc' : (wcEtSlice (MorphismProperty.Over.mk ⊤ u' hu' : S'.Etale)).IsCocontinuous
      (Scheme.smallEtaleTopology S'U) (Scheme.smallEtaleTopology S'))
    (ψ : wcEtZModRing U m ⟶ (@Functor.sheafPushforwardContinuous _ _ _ _
      (wcEtSlice (MorphismProperty.Over.mk ⊤ u hu : S.Etale)) RingCat.{u+1} _
      (Scheme.smallEtaleTopology U) (Scheme.smallEtaleTopology S) hc).obj (wcEtZModRing S m))
    (ψ' : wcEtZModRing S'U m ⟶ (@Functor.sheafPushforwardContinuous _ _ _ _
      (wcEtSlice (MorphismProperty.Over.mk ⊤ u' hu' : S'.Etale)) RingCat.{u+1} _
      (Scheme.smallEtaleTopology S'U) (Scheme.smallEtaleTopology S') hc').obj (wcEtZModRing S' m))
    (ρ : SheafOfModules.{u+1} (wcEtZModRing S m) ⥤ SheafOfModules.{u+1} (wcEtZModRing U m))
    (hρ : ρ = @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcEtSlice (MorphismProperty.Over.mk ⊤ u hu : S.Etale)) _ _ hc ψ)
    (ρ' : SheafOfModules.{u+1} (wcEtZModRing S' m) ⥤ SheafOfModules.{u+1} (wcEtZModRing S'U m))
    (hρ' : ρ' = @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcEtSlice (MorphismProperty.Over.mk ⊤ u' hu' : S'.Etale)) _ _ hc' ψ') :
    haveI := Df.cont
    haveI := Dw.cont
    haveI := DfU.cont
    haveI := DwU.cont
    haveI : (wcEtBaseChange f ⋙ wcEtBaseChange w).IsContinuous (Scheme.smallEtaleTopology S)
        (Scheme.smallEtaleTopology S') :=
      Functor.isContinuous_comp (wcEtBaseChange f) (wcEtBaseChange w) (Scheme.smallEtaleTopology S)
        (Scheme.smallEtaleTopology S') (Scheme.smallEtaleTopology S')
    haveI : (wcEtBaseChange fU ⋙ wcEtBaseChange wU).IsContinuous (Scheme.smallEtaleTopology U)
        (Scheme.smallEtaleTopology S'U) :=
      Functor.isContinuous_comp (wcEtBaseChange fU) (wcEtBaseChange wU) (Scheme.smallEtaleTopology U)
        (Scheme.smallEtaleTopology S'U) (Scheme.smallEtaleTopology S'U)
    let α : wcEtBaseChange f ⟶ wcEtBaseChange f ⋙ wcEtBaseChange w :=
      letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) f :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) f :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong f)) (@Etale : MorphismProperty Scheme.{u})
      letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) w :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) w :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong w)) (@Etale : MorphismProperty Scheme.{u})
      (MorphismProperty.Over.pullbackComp (P := (@Etale : MorphismProperty Scheme.{u}))
        (Q := ⊤) w f f hcomp.symm).hom
    let αU : wcEtBaseChange fU ⟶ wcEtBaseChange fU ⋙ wcEtBaseChange wU :=
      letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) fU :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) fU :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong fU)) (@Etale : MorphismProperty Scheme.{u})
      letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) wU :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) wU :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong wU)) (@Etale : MorphismProperty Scheme.{u})
      (MorphismProperty.Over.pullbackComp (P := (@Etale : MorphismProperty Scheme.{u}))
        (Q := ⊤) wU fU fU hcompU.symm).hom
    ∀ (hφ : (Df.φ ≫ ((wcEtBaseChange f).sheafPushforwardContinuous RingCat.{u+1}
          (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S')).map Dw.φ) ≫
        (Functor.sheafPushforwardContinuousNatTrans α RingCat.{u+1}
          (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S')).app (wcEtZModRing S' m) = Df.φ)
      (hφU : (DfU.φ ≫ ((wcEtBaseChange fU).sheafPushforwardContinuous RingCat.{u+1}
          (Scheme.smallEtaleTopology U) (Scheme.smallEtaleTopology S'U)).map DwU.φ) ≫
        (Functor.sheafPushforwardContinuousNatTrans αU RingCat.{u+1}
          (Scheme.smallEtaleTopology U) (Scheme.smallEtaleTopology S'U)).app (wcEtZModRing S'U m) = DfU.φ),
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange f) _ _ Df.cont Df.φ
    let Pw := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange w) _ _ Dw.cont Dw.φ
    let PU := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange fU) _ _ DfU.cont DfU.φ
    let PwU := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange wU) _ _ DwU.cont DwU.φ
    let γ : Pw ⋙ P ⟶ P := (SheafOfModules.pushforwardComp Df.φ Dw.φ).hom ≫
        SheafOfModules.pushforwardNatTrans _ α ≫ (SheafOfModules.pushforwardCongr hφ).hom
    let γU : PwU ⋙ PU ⟶ PU := (SheafOfModules.pushforwardComp DfU.φ DwU.φ).hom ≫
        SheafOfModules.pushforwardNatTrans _ αU ≫ (SheafOfModules.pushforwardCongr hφU).hom
    ∃ (β : P ⋙ ρ ≅ ρ' ⋙ PU) (βw : Pw ⋙ ρ' ⟶ ρ' ⋙ PwU)
      (μ' : ρ'.obj (SheafOfModules.unit (wcEtZModRing S' m)) ≅
        SheafOfModules.unit (wcEtZModRing S'U m)),
      (∀ M, ρ.map (γ.app M) ≫ β.hom.app M =
        β.hom.app (Pw.obj M) ≫ PU.map (βw.app M) ≫ γU.app (ρ'.obj M)) ∧
      μ'.inv ≫ ρ'.map (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
          (wcEtBaseChange w) _ _ Dw.cont Dw.φ) ≫ βw.app (SheafOfModules.unit (wcEtZModRing S' m)) =
        (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
          (wcEtBaseChange wU) _ _ DwU.cont DwU.φ) ≫ PwU.map μ'.inv :=
by
  have zmodExt : ∀ (Y : Scheme.{u}) (m : ℕ)
      (R : Sheaf (Scheme.smallEtaleTopology Y) RingCat.{u+1}) (φ ψ : wcEtZModRing Y m ⟶ R),
      φ = ψ := by
    intro Y m R φ ψ
    have key : ∀ (T : Type (u+1)) [Semiring T] (f g : ULift.{u+1} (ZMod m) →+* T), f = g := by
      intro T _ f g
      have h : f.comp (ULift.ringEquiv : ULift.{u+1} (ZMod m) ≃+* ZMod m).symm.toRingHom =
          g.comp (ULift.ringEquiv : ULift.{u+1} (ZMod m) ≃+* ZMod m).symm.toRingHom :=
        Subsingleton.elim _ _
      ext x
      exact RingHom.congr_fun h x.down
    apply ((sheafificationAdjunction (Scheme.smallEtaleTopology Y) RingCat.{u+1}).homEquiv _
      R).injective
    apply NatTrans.ext
    funext U
    apply RingCat.hom_ext
    exact key _ _ _
  have unitIsoAux : ∀ {X : Scheme.{u}} (T : X.Etale)
      (hc : (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left)
        (Scheme.smallEtaleTopology X))
      (hcc : (wcEtSlice T).IsCocontinuous (Scheme.smallEtaleTopology T.left)
        (Scheme.smallEtaleTopology X)) (ℓ : ℕ)
      (ψ : wcEtZModRing T.left ℓ ⟶ (@Functor.sheafPushforwardContinuous _ _ _ _ (wcEtSlice T)
        RingCat.{u+1} _ (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X) hc).obj
          (wcEtZModRing X ℓ)),
      IsIso (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtSlice T) _ _ hc ψ) := by
    intro X T hc hcc ℓ ψ
    haveI := hc
    haveI := hcc
    let γ : wcEtZModRing T.left ℓ ≅ (@Functor.sheafPushforwardContinuous _ _ _ _ (wcEtSlice T)
        RingCat.{u+1} _ (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X) hc).obj
        (wcEtZModRing X ℓ) :=
      (Functor.pushforwardContinuousSheafificationCompatibility (wcEtSlice T) RingCat.{u+1}
        (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)).app
        ((Functor.const _).obj (RingCat.of (ULift.{u+1} (ZMod ℓ))))
    have hψ : ψ = γ.hom := zmodExt _ _ _ _ _
    rw [hψ]
    let u := SheafOfModules.unitToPushforwardObjUnit γ.hom
    show IsIso u
    have hU : ∀ U, IsIso (((PresheafOfModules.toPresheaf _).map
        ((SheafOfModules.forget _).map u)).app U) := by
      intro U
      have hb : Function.Bijective
          (ConcreteCategory.hom (((PresheafOfModules.toPresheaf _).map
            ((SheafOfModules.forget _).map u)).app U)) :=
        ConcreteCategory.bijective_of_isIso (γ.hom.hom.app U)
      have h2 : IsIso ((forget AddCommGrpCat.{u+1}).map (((PresheafOfModules.toPresheaf _).map
            ((SheafOfModules.forget _).map u)).app U)) :=
        (isIso_iff_bijective _).mpr hb
      exact isIso_of_reflects_iso _ (forget AddCommGrpCat.{u+1})
    have h3 : IsIso ((PresheafOfModules.toPresheaf _).map
        ((SheafOfModules.forget _).map u)) := NatIso.isIso_of_isIso_app _
    have h4 : IsIso ((SheafOfModules.forget _).map u) :=
      isIso_of_reflects_iso _ (PresheafOfModules.toPresheaf _)
    exact isIso_of_reflects_iso u (SheafOfModules.forget _)
  have muAux : ∀ {X : Scheme.{u}} (T : X.Etale)
      (hc : (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left)
        (Scheme.smallEtaleTopology X))
      (hcc : (wcEtSlice T).IsCocontinuous (Scheme.smallEtaleTopology T.left)
        (Scheme.smallEtaleTopology X)) (ℓ : ℕ)
      (ψ : wcEtZModRing T.left ℓ ⟶ (@Functor.sheafPushforwardContinuous _ _ _ _ (wcEtSlice T)
        RingCat.{u+1} _ (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X) hc).obj
          (wcEtZModRing X ℓ)),
      ∃ μ : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtSlice T) _ _ hc ψ).obj
          (SheafOfModules.unit (wcEtZModRing X ℓ)) ≅ SheafOfModules.unit (wcEtZModRing T.left ℓ),
        μ.inv = @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtSlice T) _ _ hc ψ := by
    intro X T hc hcc ℓ ψ
    exact ⟨(@asIso _ _ _ _ (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtSlice T) _ _
      hc ψ) (unitIsoAux T hc hcc ℓ ψ)).symm, rfl⟩
  have hBCfst : ∀ {X Y : Scheme.{u}} (h : X ⟶ Y) {A B : Y.Etale} (g : A ⟶ B),
      ((wcEtBaseChange h).map g).left ≫ Limits.pullback.fst B.hom h =
        Limits.pullback.fst A.hom h ≫ g.left := by
    intro X Y h A B g
    exact Limits.pullback.lift_fst _ _ _
  have hBCsnd : ∀ {X Y : Scheme.{u}} (h : X ⟶ Y) {A B : Y.Etale} (g : A ⟶ B),
      ((wcEtBaseChange h).map g).left ≫ Limits.pullback.snd B.hom h =
        Limits.pullback.snd A.hom h := by
    intro X Y h A B g
    exact Limits.pullback.lift_snd _ _ _
  have sqAux : ∀ {P₁ P₂ Q₁ Q₂ A₁ A₂ B₁ B₂ Z : Scheme.{u}} (a : P₁ ⟶ P₂) (b : Q₁ ⟶ Q₂)
      (e₁ : P₁ ⟶ Q₁) (e₂ : P₂ ⟶ Q₂) (x₁ : P₁ ⟶ A₁) (x₂ : P₂ ⟶ A₂) (y₁ : P₁ ⟶ B₁) (y₂ : P₂ ⟶ B₂)
      (p₁ : Q₁ ⟶ A₁) (p₂ : Q₂ ⟶ A₂) (q₁ : Q₁ ⟶ Z) (q₂ : Q₂ ⟶ Z) (gA : A₁ ⟶ A₂) (v₁ : B₁ ⟶ Z)
      (v₂ : B₂ ⟶ Z)
      (hext : ∀ φ ψ : P₁ ⟶ Q₂, φ ≫ p₂ = ψ ≫ p₂ → φ ≫ q₂ = ψ ≫ q₂ → φ = ψ)
      (h1 : e₁ ≫ p₁ = x₁) (h2 : e₂ ≫ p₂ = x₂) (h3 : e₁ ≫ q₁ = y₁ ≫ v₁) (h4 : e₂ ≫ q₂ = y₂ ≫ v₂)
      (ha1 : a ≫ x₂ = x₁ ≫ gA) (ha2 : a ≫ y₂ ≫ v₂ = y₁ ≫ v₁) (hb1 : b ≫ p₂ = p₁ ≫ gA)
      (hb2 : b ≫ q₂ = q₁),
      a ≫ e₂ = e₁ ≫ b := by
    intro P₁ P₂ Q₁ Q₂ A₁ A₂ B₁ B₂ Z a b e₁ e₂ x₁ x₂ y₁ y₂ p₁ p₂ q₁ q₂ gA v₁ v₂ hext h1 h2 h3 h4
      ha1 ha2 hb1 hb2
    apply hext
    · rw [Category.assoc, Category.assoc, h2, ha1, hb1, ← Category.assoc, h1]
    · rw [Category.assoc, Category.assoc, h4, ha2, hb2, h3]

  have s1 : ∀ {S S' : Scheme.{u}} (f : S' ⟶ S) (V : S.Etale) (V' : S'.Etale)
      (fU : V'.left ⟶ V.left) (hpb : IsPullback V'.hom fU f V.hom),
      ∃ ζ : wcEtBaseChange fU ⋙ wcEtSlice V' ≅ wcEtSlice V ⋙ wcEtBaseChange f,
        ∀ T : V.left.Etale,
          (ζ.hom.app T).left ≫ Limits.pullback.fst (T.hom ≫ V.hom) f =
            Limits.pullback.fst T.hom fU ∧
          (ζ.hom.app T).left ≫ Limits.pullback.snd (T.hom ≫ V.hom) f =
            Limits.pullback.snd T.hom fU ≫ V'.hom := by
    intro S S' f V V' fU hpb
    have hT : ∀ T : V.left.Etale, IsPullback (Limits.pullback.fst T.hom fU)
        (Limits.pullback.snd T.hom fU ≫ V'.hom) (T.hom ≫ V.hom) f :=
      fun T => (IsPullback.paste_horiz (IsPullback.of_hasPullback T.hom fU).flip hpb).flip
    let e : ∀ T : V.left.Etale, ((wcEtBaseChange fU ⋙ wcEtSlice V').obj T) ≅
        ((wcEtSlice V ⋙ wcEtBaseChange f).obj T) :=
      fun T => MorphismProperty.Over.isoMk (hT T).isoPullback (hT T).isoPullback_hom_snd
    refine ⟨NatIso.ofComponents e ?_,
      fun T => ⟨(hT T).isoPullback_hom_fst, (hT T).isoPullback_hom_snd⟩⟩
    intro T₁ T₂ g
    apply MorphismProperty.Over.Hom.ext
    exact sqAux ((wcEtBaseChange fU).map g).left ((wcEtBaseChange f).map ((wcEtSlice V).map g)).left
      (hT T₁).isoPullback.hom (hT T₂).isoPullback.hom
      (Limits.pullback.fst T₁.hom fU) (Limits.pullback.fst T₂.hom fU)
      (Limits.pullback.snd T₁.hom fU) (Limits.pullback.snd T₂.hom fU)
      (Limits.pullback.fst (T₁.hom ≫ V.hom) f) (Limits.pullback.fst (T₂.hom ≫ V.hom) f)
      (Limits.pullback.snd (T₁.hom ≫ V.hom) f) (Limits.pullback.snd (T₂.hom ≫ V.hom) f)
      g.left V'.hom V'.hom
      (fun φ ψ h₁ h₂ => Limits.pullback.hom_ext h₁ h₂)
      (hT T₁).isoPullback_hom_fst (hT T₂).isoPullback_hom_fst
      (hT T₁).isoPullback_hom_snd (hT T₂).isoPullback_hom_snd
      (hBCfst fU g) ((Category.assoc _ _ _).symm.trans (congrArg (· ≫ V'.hom) (hBCsnd fU g)))
      (hBCfst f ((wcEtSlice V).map g)) (hBCsnd f ((wcEtSlice V).map g))

  have s2 : ∀ {S S' : Scheme.{u}} {m : ℕ} (f : S' ⟶ S) (V : S.Etale) (V' : S'.Etale)
      (fU : V'.left ⟶ V.left)
      [hc : (wcEtSlice V).IsContinuous (Scheme.smallEtaleTopology V.left)
        (Scheme.smallEtaleTopology S)]
      [hc' : (wcEtSlice V').IsContinuous (Scheme.smallEtaleTopology V'.left)
        (Scheme.smallEtaleTopology S')]
      (ψ : wcEtZModRing V.left m ⟶ ((wcEtSlice V).sheafPushforwardContinuous RingCat.{u+1}
        (Scheme.smallEtaleTopology V.left) (Scheme.smallEtaleTopology S)).obj (wcEtZModRing S m))
      (ψ' : wcEtZModRing V'.left m ⟶ ((wcEtSlice V').sheafPushforwardContinuous RingCat.{u+1}
        (Scheme.smallEtaleTopology V'.left) (Scheme.smallEtaleTopology S')).obj
          (wcEtZModRing S' m))
      (Df : wcEtPullData f m) (DfU : wcEtPullData fU m)
      (ζ : wcEtBaseChange fU ⋙ wcEtSlice V' ≅ wcEtSlice V ⋙ wcEtBaseChange f),
      ∃ β : @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange f) _ _ Df.cont Df.φ ⋙
            SheafOfModules.pushforward.{u+1} ψ ≅
          SheafOfModules.pushforward.{u+1} ψ' ⋙
            @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange fU) _ _ DfU.cont DfU.φ,
        ∀ (M : SheafOfModules.{u+1} (wcEtZModRing S' m)) (T : V.left.Etale)
          (x : ((SheafOfModules.pushforward.{u+1} ψ).obj ((@SheafOfModules.pushforward.{u+1}
              _ _ _ _ _ _ (wcEtBaseChange f) _ _ Df.cont Df.φ).obj M)).val.obj (Opposite.op T)),
          (ConcreteCategory.hom ((β.hom.app M).val.app (Opposite.op T))) x =
            (ConcreteCategory.hom (M.val.map (ζ.hom.app T).op)) x := by
    intro S S' m f V V' fU hc hc' ψ ψ' Df DfU ζ
    haveI := Df.cont
    haveI := DfU.cont
    haveI : (wcEtSlice V ⋙ wcEtBaseChange f).IsContinuous (Scheme.smallEtaleTopology V.left)
        (Scheme.smallEtaleTopology S') :=
      Functor.isContinuous_comp _ _ _ (Scheme.smallEtaleTopology S) _
    haveI : (wcEtBaseChange fU ⋙ wcEtSlice V').IsContinuous (Scheme.smallEtaleTopology V.left)
        (Scheme.smallEtaleTopology S') :=
      Functor.isContinuous_comp _ _ _ (Scheme.smallEtaleTopology V'.left) _
    let φ₁ : wcEtZModRing V.left m ⟶ ((wcEtSlice V ⋙ wcEtBaseChange f).sheafPushforwardContinuous
        RingCat.{u+1} (Scheme.smallEtaleTopology V.left) (Scheme.smallEtaleTopology S')).obj
          (wcEtZModRing S' m) :=
      ψ ≫ ((wcEtSlice V).sheafPushforwardContinuous
      RingCat.{u+1} (Scheme.smallEtaleTopology V.left) (Scheme.smallEtaleTopology S)).map Df.φ
    let φ₂ : wcEtZModRing V.left m ⟶ ((wcEtBaseChange fU ⋙ wcEtSlice V').sheafPushforwardContinuous
        RingCat.{u+1} (Scheme.smallEtaleTopology V.left) (Scheme.smallEtaleTopology S')).obj
          (wcEtZModRing S' m) :=
      DfU.φ ≫ ((wcEtBaseChange fU).sheafPushforwardContinuous
      RingCat.{u+1} (Scheme.smallEtaleTopology V.left) (Scheme.smallEtaleTopology V'.left)).map ψ'
    have h : φ₁ ≫ (Functor.sheafPushforwardContinuousNatTrans ζ.hom RingCat.{u+1}
        (Scheme.smallEtaleTopology V.left) (Scheme.smallEtaleTopology S')).app
          (wcEtZModRing S' m) = φ₂ :=
      zmodExt _ _ _ _ _
    refine ⟨SheafOfModules.pushforwardComp (F := wcEtSlice V) (G := wcEtBaseChange f)
        ψ Df.φ ≪≫
      SheafOfModules.pushforwardNatIso φ₁ ζ ≪≫ SheafOfModules.pushforwardCongr h ≪≫
      (SheafOfModules.pushforwardComp (F := wcEtBaseChange fU) (G := wcEtSlice V')
        DfU.φ ψ').symm, ?_⟩
    intro M T x
    exact SheafOfModules.pushforwardNatTrans_app_val_app φ₁ ζ.hom M (Opposite.op T) x

  have alphaGen : ∀ {X Y Z : Scheme.{u}} (h : X ⟶ Z) (f : Y ⟶ Z) (w : Y ⟶ Y) (hc : f = w ≫ f)
      (m : Limits.pullback h f ⟶ Limits.pullback (Limits.pullback.snd h f) w)
      (hm : m = Limits.pullback.map h f h (w ≫ f) (𝟙 X) (𝟙 Y) (𝟙 Z) (by simp) (by simp [← hc]) ≫
        (Limits.pullbackLeftPullbackSndIso h f w).inv),
      m ≫ Limits.pullback.fst _ _ ≫ Limits.pullback.fst h f = Limits.pullback.fst h f ∧
      m ≫ Limits.pullback.fst _ _ ≫ Limits.pullback.snd h f = Limits.pullback.snd h f ≫ w ∧
      m ≫ Limits.pullback.snd _ _ = Limits.pullback.snd h f := by
    intro X Y Z h f w hc m hm
    subst hm
    refine ⟨?_, ?_, ?_⟩
    · rw [Category.assoc, Limits.pullbackLeftPullbackSndIso_inv_fst]
      simp only [Limits.pullback.map]
