    intro C D _ _ _ _ R _ _ N I M w a ha
    let k' := I.ι.f 0 ≫ (I.cochainComplexXIso 0 0 rfl).inv
    have hd01 : I.cochainComplex.d 0 1 = (I.cochainComplexXIso 0 0 rfl).hom ≫
