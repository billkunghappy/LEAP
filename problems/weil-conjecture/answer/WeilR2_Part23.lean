    have hI := I.exact₀.fIsKernel
    have hK : Limits.IsLimit (Limits.KernelFork.ofι k' hk0) := Limits.KernelFork.IsLimit.ofι' k' hk0
      (fun {W'} g' hg' =>
        let l := Limits.KernelFork.IsLimit.lift' hI (g' ≫ (I.cochainComplexXIso 0 0 rfl).hom) (by
