      have hFlc : IsLocallyConstant F := by
        rw [IsLocallyConstant.iff_isOpen_fiber]
        intro a
        have hfib : F ⁻¹' {a} = ⋃ (i : Σ V' : Y.Etale, {g : V' ⟶ V // S.arrows g}),
            i.2.1.left '' {z | x i.1 i.2.1 i.2.2 z = a} := by
          ext v
          constructor
          · intro hv
            exact Set.mem_iUnion.2 ⟨⟨V₀ v, g₀ v, hg₀ v⟩, z₀ v, hv, hz₀ v⟩
          · intro hv
            obtain ⟨⟨V', g, hg⟩, z, hz, hzv⟩ := Set.mem_iUnion.1 hv
            subst hzv
            exact (hF V' g hg z).trans hz
        rw [hfib]
        apply isOpen_iUnion
        intro i
        exact hOpen _ _ i.2.1 _ (IsLocallyConstant.isOpen_fiber (x i.1 i.2.1 i.2.2).isLocallyConstant a)
      refine ⟨⟨F, hFlc⟩, fun V' g hg v => hF V' g hg v, ?_⟩
      intro f' hf'
      ext v
      change f' v = F v
      exact (congrArg f' (hz₀ v)).symm.trans (hf' _ _ _ _)

    let L : (Y.Etale)ᵒᵖ ⥤ RingCat.{u+1} :=
      { obj := fun V => RingCat.of (LocallyConstant V.unop.left (ULift.{u+1} (ZMod n)))
        map := fun g => RingCat.ofHom (LocallyConstant.comapRingHom
          ⟨g.unop.left, g.unop.left.continuous⟩)
        map_id := fun _ => rfl
        map_comp := fun _ _ => rfl }
    let eL : ∀ V : Y.Etale, (L.obj (Opposite.op V)) ≃+* LocallyConstant V.left (ZMod n) := fun V =>
      { toFun := fun f => (show LocallyConstant V.left (ULift.{u+1} (ZMod n)) from f).map ULift.down
        invFun := fun g => (show L.obj (Opposite.op V) from g.map ULift.up)
        left_inv := fun f => rfl
        right_inv := fun g => rfl
        map_mul' := fun f g => rfl
        map_add' := fun f g => rfl }

    have hL : Presheaf.IsSheaf (Scheme.smallEtaleTopology Y) L := by
      rw [Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology Y) L
        (forget RingCat.{u+1}), isSheaf_iff_isSheaf_of_type]
      intro V S hS x hx
      have hx' := hx.to_sieveCompatible
      obtain ⟨f, hf, huniq⟩ := wcGlue V S hS n
        (fun V' g hg => eL V' (x g hg)) (by
        intro V' V'' g hg h w
        exact (congrArg (fun t => (eL V'' t) w) (hx' g h hg)).trans rfl)
      refine ⟨(eL V).symm f, ?_, ?_⟩
      · intro V' g hg
        apply (eL V').injective
        ext v
        exact hf V' g hg v
      · intro t ht
        have : eL V t = f := by
          apply huniq
          intro V' g hg v
          rw [← ht g hg]
          rfl
        exact (eL V).eq_symm_apply.mpr this

    let P := (Functor.const (Y.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n)))
    let α : P ⟶ L :=
      { app := fun V => RingCat.ofHom (LocallyConstant.constRingHom :
          ULift.{u+1} (ZMod n) →+* LocallyConstant V.unop.left (ULift.{u+1} (ZMod n)))
        naturality := fun _ _ _ => rfl }
    have hinj : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology Y) α := by
      constructor
      intro X a b hab
      apply hcov
      intro v
      have hab' : a = b :=
        congrArg (fun f : LocallyConstant X.unop.left (ULift.{u+1} (ZMod n)) => f v) hab
      refine ⟨X.unop, 𝟙 _, ?_, ⟨v, rfl⟩⟩
      rw [Presheaf.equalizerSieve_apply, hab']
    have hsurj : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) α := by
      constructor
      intro V s
      apply hcov
      intro v
      let f : LocallyConstant V.left (ULift.{u+1} (ZMod n)) := s
      let O : V.left.Opens := ⟨{x | f x = f v}, f.isLocallyConstant.isOpen_fiber (f v)⟩
      let V₁ : Y.Etale := MorphismProperty.Over.mk ⊤ (O.ι ≫ V.hom) (by infer_instance)
      let c : V₁ ⟶ V := MorphismProperty.Over.homMk O.ι rfl trivial
      have hv : v ∈ Set.range O.ι := by
        rw [Scheme.Opens.range_ι]
        exact (rfl : f v = f v)
      refine ⟨V₁, c, ?_, hv⟩
      rw [Presheaf.imageSieve_apply]
      refine ⟨f v, ?_⟩
      apply LocallyConstant.ext
      intro x
      have hx : O.ι x ∈ (O : Set V.left) := by
        rw [← Scheme.Opens.range_ι]
        exact ⟨x, rfl⟩
      exact (show f (O.ι x) = f v from hx).symm

    let φ := sheafifyLift (Scheme.smallEtaleTopology Y) α hL
    have hfac : toSheafify (Scheme.smallEtaleTopology Y) P ≫ φ = α :=
      toSheafify_sheafifyLift _ α hL
    have := hinj
    have := hsurj
    have : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y)
        (toSheafify (Scheme.smallEtaleTopology Y) P) :=
      Presheaf.isLocallySurjective_toSheafify' _ P
    have h1 : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) φ :=
      Presheaf.isLocallySurjective_of_isLocallySurjective_fac _ hfac
    have h2 : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology Y) φ :=
      Presheaf.isLocallyInjective_of_isLocallyInjective_of_isLocallySurjective_fac _ α hfac
    let Φ : (constantSheaf (Scheme.smallEtaleTopology Y) RingCat.{u+1}).obj
        (RingCat.of (ULift.{u+1} (ZMod n))) ⟶
        (⟨L, hL⟩ : Sheaf (Scheme.smallEtaleTopology Y) RingCat.{u+1}) :=
      ObjectProperty.homMk φ
    have hΦ : IsIso Φ := (Sheaf.isLocallyBijective_iff_isIso Φ).mp ⟨h2, h1⟩
    have hφ : IsIso φ := by
      have : IsIso ((sheafToPresheaf (Scheme.smallEtaleTopology Y) RingCat.{u+1}).map Φ) :=
        Functor.map_isIso _ Φ
      exact this
    have hV : ∀ V, IsIso (φ.app V) := fun V => NatIso.isIso_app_of_isIso φ V
    refine ⟨fun V => (asIso (φ.app (Opposite.op V))).ringCatIsoToRingEquiv.trans (eL V), ?_⟩
    intro V V' g s x
    have key := NatTrans.naturality_apply φ g.op s
    exact (congrArg (fun t => (eL V' t) x) key).trans rfl
  obtain ⟨e', he'⟩ := dict T.XEi n
  refine ⟨fun V => (e' ((wcEtBaseChange T.πi).obj ((wcEtBaseChange f).obj V))).toAddEquiv,
    ?_, ?_⟩
  · intro V V' k s z
    exact he' _ _ ((wcEtBaseChange T.πi).map ((wcEtBaseChange f).map k)) s z
  · intro V s Ξ h1 h2 z
    have hz : Limits.pullback.fst (Limits.pullback.snd (Limits.pullback.snd V.hom f) T.πi) T.wi
        (((wcEtqmtBeta T.πi T.wi w T.hwπ).app ((wcEtBaseChange f).obj V)).left
          (((wcEtBaseChange T.πi).map ((wcEtqmtAlpha f w hw).app V)).left z)) = Ξ z := by
      have h := congrArg (fun φ => φ z) (chase V Ξ h1 h2)
      simp only [Scheme.Hom.comp_apply] at h
      exact h
    show e' ((wcEtBaseChange T.πi).obj ((wcEtBaseChange f).obj V))
        ((((wcEtqmtP Df).map (wcEtqmtActN T.hwπ Dπ Dwi Dw hφa) ≫
          (wcEtqmtGamma hw Df Dw hφ).app (wcEtSuppObj Dπ)).val.app (Opposite.op V)).hom s) z =
      e' ((wcEtBaseChange T.πi).obj ((wcEtBaseChange f).obj V)) s (Ξ z)
    rw [hform V s]
    refine (he' _ _ ((wcEtBaseChange T.πi).map ((wcEtqmtAlpha f w hw).app V)) _ z).trans ?_
    refine (he' _ _ ((wcEtqmtBeta T.πi T.wi w T.hwπ).app ((wcEtBaseChange f).obj V)) _ _).trans ?_
    refine (L1 Dwi e' he' e' he' ((wcEtBaseChange T.πi).obj ((wcEtBaseChange f).obj V)) s _).trans ?_
    exact congrArg (e' ((wcEtBaseChange T.πi).obj ((wcEtBaseChange f).obj V)) s) hz

theorem wc_kummer_index_lc {P : Scheme.{u}} {K : Type*} [Field K] (N : ℕ) (hN : 0 < N)
    (lam : K →+* Γ(P, ⊤)) (ζ : K) (hζ : IsPrimitiveRoot ζ N) (y₁ y₂ : Γ(P, ⊤))
    (hy₁ : IsUnit y₁) (hy : y₂ ^ N = y₁ ^ N) :
    ∃ c : LocallyConstant ↥P (ZMod N),
      ∀ {Q : Scheme.{u}} (φ₁ φ₂ : Q ⟶ P) (a : ℕ),
        φ₁.appTop.hom y₁ = φ₂.appTop.hom y₁ →
        φ₁.appTop.hom y₂ = φ₂.appTop.hom (lam ζ ^ a * y₂) →
        φ₁.appTop.hom (lam ζ) = φ₂.appTop.hom (lam ζ) →
        ∀ x, c (φ₁ x) = c (φ₂ x) + (a : ZMod N) :=
by
  classical
  have : NeZero N := ⟨hN.ne'⟩
  obtain ⟨f, hf⟩ : ∃ f : ℕ → Γ(P, ⊤), ∀ j, f j = y₂ - lam ζ ^ j * y₁ := ⟨_, fun j => rfl⟩
  have hζN : lam ζ ^ N = 1 := by rw [← map_pow, hζ.pow_eq_one, map_one]
  have hpowmod : ∀ j, lam ζ ^ j = lam ζ ^ (j % N) := by
    intro j
    conv_lhs => rw [← Nat.mod_add_div j N, pow_add, pow_mul, hζN, one_pow, mul_one]
  have hunit : IsUnit (lam ζ) := (hζ.isUnit hN.ne').map lam
  have hev : ∀ (x : P) (g : Γ(P, ⊤)), (P.evaluation ⊤ x trivial).hom g ≠ 0 ↔ x ∈ P.basicOpen g :=
    fun x g => P.evaluation_ne_zero_iff_mem_basicOpen (U := ⊤) x trivial g
  have hprim : ∀ x : P, IsPrimitiveRoot ((P.evaluation ⊤ x trivial).hom (lam ζ)) N := fun x =>
    hζ.map_of_injective (f := ((P.evaluation ⊤ x trivial).hom).comp lam) (RingHom.injective _)
  have ha : ∀ x : P, (P.evaluation ⊤ x trivial).hom y₁ ≠ 0 := fun x =>
    (hy₁.map (P.evaluation ⊤ x trivial).hom).ne_zero
  have hzero : ∀ (x : P) (j : ℕ), x ∉ P.basicOpen (f j) ↔
      (P.evaluation ⊤ x trivial).hom y₂ =
        (P.evaluation ⊤ x trivial).hom (lam ζ) ^ j * (P.evaluation ⊤ x trivial).hom y₁ := by
    intro x j
    rw [← hev, not_not, hf, map_sub, map_mul, map_pow, sub_eq_zero]
  have hex : ∀ x : P, ∃ i : ℕ, x ∉ P.basicOpen (f i) := by
    intro x
    have e := congrArg (P.evaluation ⊤ x trivial).hom hy
    rw [map_pow, map_pow] at e
    have h1 : ((P.evaluation ⊤ x trivial).hom y₂ * ((P.evaluation ⊤ x trivial).hom y₁)⁻¹) ^ N
        = 1 := by
      rw [mul_pow, inv_pow, e, mul_inv_cancel₀ (pow_ne_zero _ (ha x))]
    obtain ⟨i, -, hzi⟩ := (hprim x).eq_pow_of_pow_eq_one h1
    refine ⟨i, (hzero x i).2 ?_⟩
    rw [hzi, inv_mul_cancel_right₀ (ha x)]
  have huniq : ∀ (x : P) (i j : ℕ), x ∉ P.basicOpen (f i) → x ∉ P.basicOpen (f j) →
      (i : ZMod N) = j := by
    intro x i j hi hj
    rw [hzero] at hi hj
    have h := mul_right_cancel₀ (ha x) (hi.symm.trans hj)
    have hm : ∀ k, (P.evaluation ⊤ x trivial).hom (lam ζ) ^ k =
        (P.evaluation ⊤ x trivial).hom (lam ζ) ^ (k % N) := by
      intro k
      simpa only [map_pow] using congrArg (P.evaluation ⊤ x trivial).hom (hpowmod k)
    rw [hm i, hm j] at h
    rw [ZMod.natCast_eq_natCast_iff]
    exact (hprim x).pow_inj (Nat.mod_lt _ hN) (Nat.mod_lt _ hN) h
  choose idx hidx using hex
  have H : ∀ (x : P) (j : ℕ), x ∉ P.basicOpen (f j) → ((idx x : ℕ) : ZMod N) = j :=
    fun x j hj => huniq x _ _ (hidx x) hj
  have hlc : IsLocallyConstant (fun x : P => ((idx x : ℕ) : ZMod N)) := by
    rw [IsLocallyConstant.iff_exists_open]
    intro x
    refine ⟨⋂ i ∈ ((Finset.range N).filter
        (fun i : ℕ => ((i : ℕ) : ZMod N) ≠ ((idx x : ℕ) : ZMod N)) : Finset ℕ),
      (P.basicOpen (f i) : Set P), ?_, ?_, ?_⟩
    · exact isOpen_biInter_finset (fun i _ => (P.basicOpen (f i)).isOpen)
    · refine Set.mem_iInter₂.2 (fun i hi => ?_)
      by_contra hc
      exact (Finset.mem_filter.1 hi).2 (H x i hc).symm
    · intro x' hx'
      by_contra hne
      have hlt : idx x' % N < N := Nat.mod_lt _ hN
      have hcast : ((idx x' % N : ℕ) : ZMod N) = ((idx x' : ℕ) : ZMod N) := ZMod.natCast_mod _ _
      have hmem := Set.mem_iInter₂.1 hx' (idx x' % N)
        (Finset.mem_filter.2 ⟨Finset.mem_range.2 hlt, by rw [hcast]; exact hne⟩)
      have hfm : f (idx x' % N) = f (idx x') := by rw [hf, hf, ← hpowmod]
      rw [hfm] at hmem
      exact hidx x' hmem
  refine ⟨⟨fun x => ((idx x : ℕ) : ZMod N), hlc⟩, ?_⟩
  intro Q φ₁ φ₂ a h1 h2 h3 x
  show ((idx (φ₁ x) : ℕ) : ZMod N) = ((idx (φ₂ x) : ℕ) : ZMod N) + (a : ZMod N)
  have hφf : φ₁.appTop.hom (f (idx (φ₂ x) + a)) =
      φ₂.appTop.hom (lam ζ) ^ a * φ₂.appTop.hom (f (idx (φ₂ x))) := by
    simp only [hf, map_sub, map_mul, map_pow, h1, h2, h3]
    ring
  have hmem : φ₁ x ∉ P.basicOpen (f (idx (φ₂ x) + a)) := by
    intro hk
    have hx : x ∈ φ₁ ⁻¹ᵁ P.basicOpen (f (idx (φ₂ x) + a)) := (Scheme.Hom.mem_preimage φ₁).2 hk
    rw [Scheme.preimage_basicOpen_top, hφf, Scheme.basicOpen_mul,
      Scheme.basicOpen_of_isUnit _ ((hunit.map φ₂.appTop.hom).pow a), top_inf_eq,
      ← Scheme.preimage_basicOpen_top] at hx
    exact hidx (φ₂ x) ((Scheme.Hom.mem_preimage φ₂).1 hx)
  rw [H (φ₁ x) _ hmem, Nat.cast_add]

theorem wc_etqmt_lc_descend_zmod {A B L : Type u} [CommRing A] [CommRing B] [Field L] {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)] {φA : A →+* L} {σ : L →+* L} {XE : Scheme.{u}}
    {p : XE ⟶ Spec (.of B)} {q : XE ⟶ Spec (.of L)} {w : XE ⟶ XE} {x₀ : B}
    (T : wcQmtmTower ℓ φA σ p q w x₀) {V : Scheme.{u}} (v : V ⟶ XE) (m : ℕ)
    (F : LocallyConstant ↥(Limits.pullback v T.πi) (ZMod m))
    (hF : ∀ κ : Limits.pullback v T.πi ⟶ Limits.pullback v T.πi,
      κ ≫ Limits.pullback.fst v T.πi = Limits.pullback.fst v T.πi →
      κ ≫ Limits.pullback.snd v T.πi = Limits.pullback.snd v T.πi ≫ T.γi →
      ∀ x, F (κ x) = F x) :
    ∃ f : LocallyConstant ↥V (ZMod m), ∀ x, F x = f (Limits.pullback.fst v T.πi x) :=
by
  classical
  set fst := Limits.pullback.fst v T.πi with hfstdef

  obtain ⟨_, hsurj, _, _⟩ := wc_qmtm_tower_pi_props T
  have hpb := (IsPullback.of_hasPullback v T.πi).flip
  haveI hsf : Surjective fst := MorphismProperty.of_isPullback (P := @Surjective) hpb hsurj
  have hs : Function.Surjective fst := fst.surjective

  let χ : ZMod m → LocallyConstant ↥(Limits.pullback v T.πi) (ZMod 2) := fun e =>
    F.map (fun t => if t = e then (1 : ZMod 2) else 0)
  have hχ : ∀ e x, χ e x = if F x = e then (1 : ZMod 2) else 0 := fun e x => rfl
  have hinv : ∀ e, ∀ κ : Limits.pullback v T.πi ⟶ Limits.pullback v T.πi,
      κ ≫ Limits.pullback.fst v T.πi = Limits.pullback.fst v T.πi →
      κ ≫ Limits.pullback.snd v T.πi = Limits.pullback.snd v T.πi ≫ T.γi →
      ∀ x, χ e (κ x) = χ e x := by
    intro e κ h1 h2 x
    rw [hχ, hχ, hF κ h1 h2 x]
  choose g hg using fun e => wc_etqmt_lc_invariant_factor T v 2 (χ e) (hinv e)

  have h10 : (0 : ZMod 2) ≠ 1 := by decide
  have key : ∀ x e, F x = e ↔ g e (fst x) = 1 := by
    intro x e
    constructor
    · intro h
      rw [← hg e x, hχ, if_pos h]
    · intro h
      rw [← hg e x, hχ] at h
      by_contra hne
      rw [if_neg hne] at h
      exact h10 h

  let sec := Function.surjInv hs
  have hsec : ∀ y, fst (sec y) = y := Function.surjInv_eq hs
  let f₀ : V → ZMod m := fun y => F (sec y)
  have hf₀ : ∀ x, F x = f₀ (fst x) := by
    intro x
    have h1 : g (F (sec (fst x))) (fst (sec (fst x))) = 1 := (key _ _).mp rfl
    rw [hsec] at h1
    exact (key x _).mpr h1

  have hlc : IsLocallyConstant f₀ := by
    rw [IsLocallyConstant.iff_isOpen_fiber]
    intro e
    have : f₀ ⁻¹' {e} = {y | g e y = 1} := by
      ext y
      simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_setOf_eq]
      rw [show f₀ y = F (sec y) from rfl, key, hsec]
    rw [this]
    exact (g e).isLocallyConstant.isOpen_fiber 1
  exact ⟨⟨f₀, hlc⟩, fun x => hf₀ x⟩

theorem wc_etqmt_x0_kummer_root_data {A B L : Type u} [CommRing A] [CommRing B] [Field L]
    {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {φA : A →+* L} {σ : L →+* L} {XE : Scheme.{u}}
    {p : XE ⟶ Spec (.of B)} {q : XE ⟶ Spec (.of L)} {w : XE ⟶ XE} {x₀ : B}
    (T : wcQmtmTower ℓ φA σ p q w x₀) (hσ : σ.comp φA = φA)
    {V : Scheme.{u}} (v : V ⟶ XE) (M : ℕ) (y : Γ(V, ⊤))
    (hy : y ^ (ℓ ^ M) = (v ≫ p).appTop.hom ((Scheme.ΓSpecIso (.of B)).inv.hom x₀)) :
    ∃ (lam : L →+* Γ(Limits.pullback v T.πi, ⊤)) (y₂ : Γ(Limits.pullback v T.πi, ⊤)),
      IsUnit ((Limits.pullback.fst v T.πi).appTop.hom y) ∧
      y₂ ^ (ℓ ^ M) = ((Limits.pullback.fst v T.πi).appTop.hom y) ^ (ℓ ^ M) ∧
      (∀ {Q : Scheme.{u}} (φ₁ φ₂ : Q ⟶ Limits.pullback v T.πi),
        φ₁ ≫ Limits.pullback.snd v T.πi = φ₂ ≫ Limits.pullback.snd v T.πi ≫ T.γi →
        φ₁.appTop.hom (lam (T.ζ M)) = φ₂.appTop.hom (lam (T.ζ M)) ∧
        φ₁.appTop.hom y₂ = φ₂.appTop.hom (lam (T.ζ M) * y₂)) ∧
      (∀ {Q : Scheme.{u}} (φ₁ φ₂ : Q ⟶ Limits.pullback v T.πi),
        φ₁ ≫ Limits.pullback.snd v T.πi = φ₂ ≫ Limits.pullback.snd v T.πi ≫ T.wi →
        φ₁.appTop.hom (lam (T.ζ M)) = φ₂.appTop.hom (lam (T.ζ M)) ∧
        φ₁.appTop.hom y₂ = φ₂.appTop.hom y₂) :=
by
  classical

  have htr : ∀ {X : Scheme.{u}} {R R' : CommRingCat.{u}} (u : X ⟶ Spec R) (φ : R' ⟶ R) (t : R'),
      u.appTop.hom ((Scheme.ΓSpecIso R).inv.hom (φ.hom t)) =
        (u ≫ Spec.map φ).appTop.hom ((Scheme.ΓSpecIso R').inv.hom t) := by
    intro X R R' u φ t
    have e := congrArg (fun h => h.hom t) (Scheme.ΓSpecIso_inv_naturality φ)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e
    rw [e, Scheme.Hom.comp_appTop]
    rfl
  have hcomp : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (a : Γ(Z, ⊤)),
      (f ≫ g).appTop.hom a = f.appTop.hom (g.appTop.hom a) := by
    intro X Y Z f g a
    rw [Scheme.Hom.comp_appTop]; rfl
  set s₀ := Limits.pullback.snd v T.πi ≫ T.gi with hs₀
  set Θ : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) →+* Γ(Limits.pullback v T.πi, ⊤) :=
    s₀.appTop.hom.comp (Scheme.ΓSpecIso
      (CommRingCat.of (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))).inv.hom with hΘ
  set e : Localization.Away (ℓ : ℤ) := Localization.mk (1 : ℤ) ⟨(ℓ : ℤ) ^ M, M, rfl⟩ with he
  set t₀ := (Scheme.ΓSpecIso (CommRingCat.of (LaurentPolynomial L))).inv.hom
    (LaurentPolynomial.T 1) with ht₀
  have hNe : (ℓ ^ M : ℕ) • e = 1 := by
    rw [he, nsmul_eq_mul, Localization.mk_eq_mk',
      ← map_natCast (algebraMap ℤ (Localization.Away (ℓ:ℤ))), mul_comm]
    have := IsLocalization.mk'_spec (Localization.Away (ℓ:ℤ)) (1 : ℤ)
      (⟨(ℓ : ℤ) ^ M, M, rfl⟩ : Submonoid.powers (ℓ : ℤ))
    rw [map_one] at this
    convert this using 3
    push_cast; rfl
  have hψ : (AddMonoidAlgebra.single (1 : Localization.Away (ℓ : ℤ)) (1 : L)) =
      (CommRingCat.ofHom (AddMonoidAlgebra.mapDomainRingHom L
        (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom)).hom
        (LaurentPolynomial.T 1) := by
    rw [CommRingCat.hom_ofHom, AddMonoidAlgebra.mapDomainRingHom_apply]
    show _ = AddMonoidAlgebra.mapDomain _ (AddMonoidAlgebra.single (1 : ℤ) (1 : L))
    rw [AddMonoidAlgebra.mapDomain_single]
    simp
  have hsq0 : s₀ ≫ Spec.map (CommRingCat.ofHom (AddMonoidAlgebra.mapDomainRingHom L
        (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom)) =
      Limits.pullback.fst v T.πi ≫ v ≫ T.g₀ := by
    rw [hs₀, Category.assoc, ← T.hT.w, ← Category.assoc, ← Limits.pullback.condition,
      Category.assoc]
  have hpow0 : (Θ (AddMonoidAlgebra.single e 1)) ^ (ℓ ^ M) =
      (Limits.pullback.fst v T.πi ≫ v ≫ T.g₀).appTop.hom t₀ := by
    rw [← map_pow, AddMonoidAlgebra.single_pow, one_pow, hNe, hψ, hΘ, RingHom.comp_apply, htr,
      hsq0]
  have hfst : ((Limits.pullback.fst v T.πi).appTop.hom y) ^ (ℓ ^ M) =
      (Limits.pullback.fst v T.πi ≫ v ≫ T.g₀).appTop.hom t₀ := by
    rw [← map_pow, hy, hcomp, hcomp, hcomp, ht₀, ← T.hg₀T]
  have htrans : ∀ (ρ : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) →+*
        AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))) {Q : Scheme.{u}}
      (φ₁ φ₂ : Q ⟶ Limits.pullback v T.πi),
      φ₁ ≫ s₀ = φ₂ ≫ s₀ ≫ Spec.map (CommRingCat.ofHom ρ) →
      ∀ g, φ₁.appTop.hom (Θ g) = φ₂.appTop.hom (Θ (ρ g)) := by
    intro ρ Q φ₁ φ₂ h g
    rw [hΘ, RingHom.comp_apply, RingHom.comp_apply, ← hcomp, h,
      show ρ g = (CommRingCat.ofHom ρ).hom g from rfl, htr]
    simp only [hcomp]
  have hσζ : σ (T.ζ M) = T.ζ M := by
    obtain ⟨a, ha⟩ := T.hζA M
    rw [← ha]
    exact RingHom.congr_fun hσ a
  refine ⟨Θ.comp AddMonoidAlgebra.singleZeroRingHom, Θ (AddMonoidAlgebra.single e 1),
    ?_, ?_, ?_, ?_⟩
  ·
    have hN0 : ℓ ^ M ≠ 0 := pow_ne_zero _ (Nat.Prime.ne_zero Fact.out)
    have h1 : IsUnit (((Limits.pullback.fst v T.πi).appTop.hom y) ^ (ℓ ^ M)) := by
      rw [hfst, ht₀]
      exact ((LaurentPolynomial.isUnit_T 1).map _).map _
    exact (isUnit_pow_iff hN0).1 h1
  ·
    rw [hpow0, hfst]
  ·
    intro Q φ₁ φ₂ hφ
    have hsq : φ₁ ≫ s₀ = φ₂ ≫ s₀ ≫ Spec.map (CommRingCat.ofHom T.γR) := by
      rw [hs₀, ← Category.assoc, hφ, Category.assoc, Category.assoc, T.hγg]
      simp only [Category.assoc]
    have hfix : T.γR (AddMonoidAlgebra.single 0 (T.ζ M)) = AddMonoidAlgebra.single 0 (T.ζ M) := by
      rw [T.hγR, ofAdd_zero, map_one, Units.val_one, one_mul]
    have hγe : T.γR (AddMonoidAlgebra.single e 1) =
        AddMonoidAlgebra.single 0 (T.ζ M) * AddMonoidAlgebra.single e 1 := by
      rw [T.hγR, mul_one, AddMonoidAlgebra.single_mul_single, zero_add, mul_one, he, T.hχ 1 M,
        zpow_one]
    refine ⟨?_, ?_⟩
    · show φ₁.appTop.hom (Θ (AddMonoidAlgebra.single 0 (T.ζ M))) =
        φ₂.appTop.hom (Θ (AddMonoidAlgebra.single 0 (T.ζ M)))
      rw [htrans _ φ₁ φ₂ hsq, hfix]
    · show φ₁.appTop.hom (Θ (AddMonoidAlgebra.single e 1)) =
        φ₂.appTop.hom (Θ (AddMonoidAlgebra.single 0 (T.ζ M)) * Θ (AddMonoidAlgebra.single e 1))
      rw [htrans _ φ₁ φ₂ hsq, hγe, map_mul Θ]
  ·
    intro Q φ₁ φ₂ hφ
    have hsq : φ₁ ≫ s₀ = φ₂ ≫ s₀ ≫ Spec.map (CommRingCat.ofHom T.σG) := by
      rw [hs₀, ← Category.assoc, hφ, Category.assoc, Category.assoc, T.hwg]
      simp only [Category.assoc]
    have hfix : T.σG (AddMonoidAlgebra.single 0 (T.ζ M)) = AddMonoidAlgebra.single 0 (T.ζ M) := by
      rw [T.hσG, hσζ]
    have hσe : T.σG (AddMonoidAlgebra.single e 1) = AddMonoidAlgebra.single e 1 := by
      rw [T.hσG, map_one]
    refine ⟨?_, ?_⟩
    · show φ₁.appTop.hom (Θ (AddMonoidAlgebra.single 0 (T.ζ M))) =
        φ₂.appTop.hom (Θ (AddMonoidAlgebra.single 0 (T.ζ M)))
      rw [htrans _ φ₁ φ₂ hsq, hfix]
    · rw [htrans _ φ₁ φ₂ hsq, hσe]

theorem wc_lc_slice_descent_comb {X : Type*} [TopologicalSpace X] {Y : Type*} (N : ℕ)
    (hN : 0 < N) (κ : X → X) (hκ : Continuous κ) (S : LocallyConstant X Y)
    (hS : ∀ x, S (κ^[N] x) = S x) (c : LocallyConstant X (ZMod N))
    (hc : ∀ x, c (κ x) = c x + 1) (b : ZMod N) :
    ∃ G : LocallyConstant X Y, (∀ x, G (κ x) = G x) ∧ ∀ x, c x = b → G x = S x :=
by
  classical
  have : NeZero N := ⟨by omega⟩
  have hmod : ∀ (m : ℕ) (x : X), S (κ^[m] x) = S (κ^[m % N] x) := by
    intro m x
    induction m using Nat.strong_induction_on with
    | _ m ih =>
      by_cases hm : m < N
      · rw [Nat.mod_eq_of_lt hm]
      · obtain ⟨t, rfl⟩ : ∃ t, m = N + t := ⟨m - N, by omega⟩
        have e : (N + t) % N = t % N := by simp
        rw [Function.iterate_add_apply, hS, ih t (by omega), e]
  have hP : ∀ (m₁ m₂ : ℕ) (x : X), (m₁ : ZMod N) = m₂ → S (κ^[m₁] x) = S (κ^[m₂] x) := by
    intro m₁ m₂ x h
    rw [hmod m₁, hmod m₂, (ZMod.natCast_eq_natCast_iff' m₁ m₂ N).mp h]
  have hlc : IsLocallyConstant (fun x => S (κ^[(b - c x).val] x)) := by
    rw [IsLocallyConstant.iff_exists_open]
    intro x
    refine ⟨{y | c y = c x ∧ S (κ^[(b - c x).val] y) = S (κ^[(b - c x).val] x)}, ?_, ⟨rfl, rfl⟩, ?_⟩
    · exact IsOpen.inter (c.isLocallyConstant.isOpen_fiber _)
        ((S.isLocallyConstant.comp_continuous (hκ.iterate _)).isOpen_fiber _)
    · rintro y ⟨h1, h2⟩
      show S (κ^[(b - c y).val] y) = _
      rw [h1]
      exact h2
  refine ⟨⟨fun x => S (κ^[(b - c x).val] x), hlc⟩, ?_, ?_⟩
  · intro x
    show S (κ^[(b - c (κ x)).val] (κ x)) = S (κ^[(b - c x).val] x)
    rw [← Function.iterate_succ_apply, hc]
    apply hP
    push_cast
    rw [ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
    ring
  · intro x hx
    show S (κ^[(b - c x).val] x) = S x
    rw [hx, sub_self, ZMod.val_zero]
    rfl

theorem wc_etqmt_x0_kummer_split {A B L : Type u} [CommRing A] [CommRing B] [Field L] {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)] {φA : A →+* L} {σ : L →+* L} {XE : Scheme.{u}}
    {p : XE ⟶ Spec (.of B)} {q : XE ⟶ Spec (.of L)} {w : XE ⟶ XE} {x₀ : B}
    (T : wcQmtmTower ℓ φA σ p q w x₀) (hσ : σ.comp φA = φA)
    {W : Scheme.{u}} [IsAffine W] (ω : W ⟶ XE) (m : ℕ)
    (s : LocallyConstant ↥(Limits.pullback ω T.πi) (ZMod m)) :
    ∃ j : ℕ, ∀ (W' : Scheme.{u}) (r : W' ⟶ W) (ω' : W' ⟶ XE) (hr : r ≫ ω = ω') (y : Γ(W', ⊤)),
      y ^ (ℓ ^ j) = (ω' ≫ p).appTop.hom ((Scheme.ΓSpecIso (.of B)).inv.hom x₀) →
      ∃ F : ZMod (ℓ ^ j) → LocallyConstant ↥W' (ZMod m),
        ∀ (W'' : Scheme.{u}) (r₂ : W'' ⟶ W') (ω'' : W'' ⟶ XE) (hr₂ : r₂ ≫ ω' = ω'')
          (ε : W'' ⟶ W'') (ρ : Limits.pullback ω'' T.πi ⟶ Limits.pullback ω T.πi)
          (Ξ : Limits.pullback ω'' T.πi ⟶ Limits.pullback ω'' T.πi),
          ρ ≫ Limits.pullback.fst ω T.πi = Limits.pullback.fst ω'' T.πi ≫ r₂ ≫ r →
          ρ ≫ Limits.pullback.snd ω T.πi = Limits.pullback.snd ω'' T.πi →
          Ξ ≫ Limits.pullback.fst ω'' T.πi = Limits.pullback.fst ω'' T.πi ≫ ε →
          Ξ ≫ Limits.pullback.snd ω'' T.πi = Limits.pullback.snd ω'' T.πi ≫ T.wi →
          ε.appTop.hom (r₂.appTop.hom y) = r₂.appTop.hom y →
          (∀ (b : ZMod (ℓ ^ j)) (w'' : W''), F b (r₂ (ε w'')) = F b (r₂ w'')) →
          ∀ z, s (ρ (Ξ z)) = s (ρ z) :=
by
  classical
  have appc : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (t : Γ(Z, ⊤)),
      f.appTop.hom (g.appTop.hom t) = (f ≫ g).appTop.hom t := by
    intro X Y Z f g t
    rw [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
  have appid : ∀ {X : Scheme.{u}} (t : Γ(X, ⊤)), (𝟙 X : X ⟶ X).appTop.hom t = t := by
    intro X t
    rw [Scheme.Hom.id_appTop, CommRingCat.hom_id, RingHom.id_apply]

  let κ : Limits.pullback ω T.πi ⟶ Limits.pullback ω T.πi :=
    Limits.pullback.lift (Limits.pullback.fst ω T.πi) (Limits.pullback.snd ω T.πi ≫ T.γi)
      (by rw [Category.assoc, T.hγπ]; exact Limits.pullback.condition)
  have hκ1 : κ ≫ Limits.pullback.fst ω T.πi = Limits.pullback.fst ω T.πi :=
    Limits.pullback.lift_fst _ _ _
  have hκ2 : κ ≫ Limits.pullback.snd ω T.πi = Limits.pullback.snd ω T.πi ≫ T.γi :=
    Limits.pullback.lift_snd _ _ _
  obtain ⟨j, hper⟩ := wc_etqmt_lc_period T ω m s κ hκ1 hκ2
  have hN : 0 < ℓ ^ j := pow_pos (Fact.out : ℓ.Prime).pos j
  refine ⟨j, ?_⟩
  intro W' r ω' hr y hy

  let rt : Limits.pullback ω' T.πi ⟶ Limits.pullback ω T.πi :=
    Limits.pullback.lift (Limits.pullback.fst ω' T.πi ≫ r) (Limits.pullback.snd ω' T.πi)
      (by rw [Category.assoc, hr]; exact Limits.pullback.condition)
  have hrt1 : rt ≫ Limits.pullback.fst ω T.πi = Limits.pullback.fst ω' T.πi ≫ r :=
    Limits.pullback.lift_fst _ _ _
  have hrt2 : rt ≫ Limits.pullback.snd ω T.πi = Limits.pullback.snd ω' T.πi :=
    Limits.pullback.lift_snd _ _ _
  let κ' : Limits.pullback ω' T.πi ⟶ Limits.pullback ω' T.πi :=
    Limits.pullback.lift (Limits.pullback.fst ω' T.πi) (Limits.pullback.snd ω' T.πi ≫ T.γi)
      (by rw [Category.assoc, T.hγπ]; exact Limits.pullback.condition)
  have hκ'1 : κ' ≫ Limits.pullback.fst ω' T.πi = Limits.pullback.fst ω' T.πi :=
    Limits.pullback.lift_fst _ _ _
  have hκ'2 : κ' ≫ Limits.pullback.snd ω' T.πi = Limits.pullback.snd ω' T.πi ≫ T.γi :=
    Limits.pullback.lift_snd _ _ _
  have hsemi : κ' ≫ rt = rt ≫ κ := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hrt1, ← Category.assoc, hκ'1, Category.assoc, hκ1, hrt1]
    · rw [Category.assoc, hrt2, hκ'2, Category.assoc, hκ2, ← Category.assoc, hrt2]
  have hsemi' : ∀ x, rt (κ' x) = κ (rt x) := by
    intro x
    have h := congrArg (fun φ : Limits.pullback ω' T.πi ⟶ Limits.pullback ω T.πi => φ x) hsemi
    simpa only [Scheme.Hom.comp_apply] using h
  have hiter : ∀ (n : ℕ) x, rt ((⇑κ')^[n] x) = (⇑κ)^[n] (rt x) := by
    intro n
    induction n with
    | zero => intro x; rfl
    | succ n ih =>
      intro x
      rw [Function.iterate_succ_apply, Function.iterate_succ_apply, ih, hsemi']
  let S' : LocallyConstant ↥(Limits.pullback ω' T.πi) (ZMod m) :=
    { toFun := fun x => s (rt x)
      isLocallyConstant := by
        exact s.isLocallyConstant.comp_continuous rt.continuous }
  have hS'v : ∀ x, S' x = s (rt x) := fun x => rfl
  have hS' : ∀ x, S' ((⇑κ')^[ℓ ^ j] x) = S' x := by
    intro x
    rw [hS'v, hS'v, hiter, hper]
  obtain ⟨lam, y₂, hu, hpow, hγ, hw⟩ := wc_etqmt_x0_kummer_root_data T hσ ω' j y hy
  obtain ⟨c, htr⟩ := wc_kummer_index_lc (ℓ ^ j) hN lam (T.ζ j) (T.hζ j) _ y₂ hu hpow
  have hc : ∀ x, c (κ' x) = c x + 1 := by
    obtain ⟨hγl, hγy⟩ := hγ κ' (𝟙 _) (by rw [hκ'2, Category.id_comp])
    have h := htr κ' (𝟙 _) 1
      (by rw [appc κ' (Limits.pullback.fst ω' T.πi) y, hκ'1, appid])
      (by rw [pow_one]; exact hγy) hγl
    intro x
    have hx := h x
    rw [Nat.cast_one] at hx
    exact hx

  have hG : ∀ b : ZMod (ℓ ^ j), ∃ f : LocallyConstant ↥W' (ZMod m),
      ∀ x, c x = b → s (rt x) = f (Limits.pullback.fst ω' T.πi x) := by
    intro b
    obtain ⟨G, hGinv, hGS⟩ :=
      wc_lc_slice_descent_comb (ℓ ^ j) hN (⇑κ') κ'.continuous S' hS' c hc b
    obtain ⟨f, hf⟩ := wc_etqmt_lc_descend_zmod T ω' m G (by
      intro κh h1 h2 x
      have hκh : κh = κ' := by
        apply Limits.pullback.hom_ext
        · rw [h1, hκ'1]
        · rw [h2, hκ'2]
      rw [hκh]
      exact hGinv x)
    exact ⟨f, fun x hx => (hGS x hx).symm.trans (hf x)⟩
  choose F hF using hG
  refine ⟨F, ?_⟩

  intro W'' r₂ ω'' hr₂ ε ρ Ξ hρ1 hρ2 hΞ1 hΞ2 hε hFinv z
  let ρ' : Limits.pullback ω'' T.πi ⟶ Limits.pullback ω' T.πi :=
    Limits.pullback.lift (Limits.pullback.fst ω'' T.πi ≫ r₂) (Limits.pullback.snd ω'' T.πi)
      (by rw [Category.assoc, hr₂]; exact Limits.pullback.condition)
  have hρ'1 : ρ' ≫ Limits.pullback.fst ω' T.πi = Limits.pullback.fst ω'' T.πi ≫ r₂ :=
    Limits.pullback.lift_fst _ _ _
  have hρ'2 : ρ' ≫ Limits.pullback.snd ω' T.πi = Limits.pullback.snd ω'' T.πi :=
    Limits.pullback.lift_snd _ _ _
  have hρfac : ρ = ρ' ≫ rt := by
    apply Limits.pullback.hom_ext
    · rw [hρ1, Category.assoc, hrt1, ← Category.assoc ρ', hρ'1, Category.assoc]
    · rw [hρ2, Category.assoc, hrt2, hρ'2]
  have hsρ : ∀ u, s (ρ u) = s (rt (ρ' u)) := by
    intro u
    rw [hρfac, Scheme.Hom.comp_apply]
  have e1 : (Ξ ≫ ρ') ≫ Limits.pullback.fst ω' T.πi = Limits.pullback.fst ω'' T.πi ≫ ε ≫ r₂ := by
    rw [Category.assoc, hρ'1, ← Category.assoc, hΞ1, Category.assoc]
  have hy1 : (Ξ ≫ ρ').appTop.hom ((Limits.pullback.fst ω' T.πi).appTop.hom y) =
      ρ'.appTop.hom ((Limits.pullback.fst ω' T.πi).appTop.hom y) := by
    rw [appc (Ξ ≫ ρ') (Limits.pullback.fst ω' T.πi) y, appc ρ' (Limits.pullback.fst ω' T.πi) y,
      e1, hρ'1, ← appc (Limits.pullback.fst ω'' T.πi) (ε ≫ r₂) y, ← appc ε r₂ y, hε,
      appc (Limits.pullback.fst ω'' T.πi) r₂ y]
  obtain ⟨hwl, hwy⟩ := hw (Ξ ≫ ρ') ρ' (by
    rw [Category.assoc, hρ'2, hΞ2, ← Category.assoc, hρ'2])
  have hcz := htr (Ξ ≫ ρ') ρ' 0 hy1 (by rw [pow_zero, one_mul]; exact hwy) hwl z
  rw [Nat.cast_zero, add_zero, Scheme.Hom.comp_apply] at hcz
  have p1 : Limits.pullback.fst ω' T.πi (ρ' (Ξ z)) = r₂ (ε (Limits.pullback.fst ω'' T.πi z)) := by
    have h := congrArg (fun φ : Limits.pullback ω'' T.πi ⟶ W' => φ z) e1
    simpa only [Scheme.Hom.comp_apply] using h
  have p2 : Limits.pullback.fst ω' T.πi (ρ' z) = r₂ (Limits.pullback.fst ω'' T.πi z) := by
    have h := congrArg (fun φ : Limits.pullback ω'' T.πi ⟶ W' => φ z) hρ'1
    simpa only [Scheme.Hom.comp_apply] using h
  rw [hsρ, hsρ, hF (c (ρ' z)) (ρ' (Ξ z)) hcz, hF (c (ρ' z)) (ρ' z) rfl, p1, p2, hFinv]

theorem wc_etqmt_x0_stalk_fix (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) (k : ℕ) (hk : 1 ≤ k) (π : A)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (r : ℕ)
    (U : Scheme.{u}) (g : U ⟶ Spec (.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))) (hg : Etale g)
    (fX : U ⟶ Spec (.of A)) (hfX : fX = g ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r))
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A))
    (σ : Spec (.of Ω) ⟶ Spec (.of Ω)) (hσ : σ ≫ ξ = ξ)
    (htame : wcMntTame ℓ (Spec.preimage ξ).hom (Spec.preimage σ).hom π)
    (σQ : Limits.pullback fX ξ ⟶ Limits.pullback fX ξ)
    (hσQ1 : σQ ≫ Limits.pullback.fst fX ξ = Limits.pullback.fst fX ξ)
    (hσQ2 : σQ ≫ Limits.pullback.snd fX ξ = Limits.pullback.snd fX ξ ≫ σ)
    (T : wcEtqmtTower ℓ g fX ξ σ σQ ⟨0, by omega⟩)
    (Dπ : wcEtPullData T.πi (ℓ ^ k)) (Dwi : wcEtPullData T.wi (ℓ ^ k))
    (DσQ : wcEtPullData σQ (ℓ ^ k)) (hφa : wcEtqmtSqPhi T.hwπ Dπ Dwi DσQ)
    (Dh : wcEtPullData (Limits.pullback.fst fX ξ) (ℓ ^ k)) (hφ : wcEtqmtHPhi hσQ1 Dh DσQ)
    (x : U) (hx0 : x ∈ U.basicOpen (wcEtqmtX g ⟨0, by omega⟩))
    (hunit : Function.Bijective ((wcEtStalk U x).map
      ((SheafOfModules.toSheaf (wcEtZModRing U (ℓ ^ k))).map (wcEtqmtU Dh))).hom) :
    (wcEtStalk U x).map ((SheafOfModules.toSheaf (wcEtZModRing U (ℓ ^ k))).map
      ((wcEtqmtP Dh).map (wcEtqmtActN T.hwπ Dπ Dwi DσQ hφa) ≫
        (wcEtqmtGamma hσQ1 Dh DσQ hφ).app (wcEtSuppObj Dπ))) = 𝟙 _ :=
by
  classical

  have hσ' : (Spec.preimage σ).hom.comp (Spec.preimage ξ).hom = (Spec.preimage ξ).hom := by
    have h := congrArg (fun f => (Spec.preimage f).hom) hσ
    simp only [Spec.preimage_comp, CommRingCat.hom_comp] at h
    exact h

  have bcfst : ∀ {S S' : Scheme.{u}} (f : S' ⟶ S) {V V' : S.Etale} (k : V' ⟶ V),
      ((wcEtBaseChange f).map k).left ≫ Limits.pullback.fst V.hom f =
        Limits.pullback.fst V'.hom f ≫ k.left := by
    intro S S' f V V' k
    erw [MorphismProperty.Over.pullback_map_left]; exact Limits.pullback.lift_fst _ _ _
  have bcsnd : ∀ {S S' : Scheme.{u}} (f : S' ⟶ S) {V V' : S.Etale} (k : V' ⟶ V),
      ((wcEtBaseChange f).map k).left ≫ Limits.pullback.snd V.hom f =
        Limits.pullback.snd V'.hom f := by
    intro S S' f V V' k
    erw [MorphismProperty.Over.pullback_map_left]; exact Limits.pullback.lift_snd _ _ _

  apply wc_etqmt_x0_stalk_id_of_local
  intro A₀ s

  obtain ⟨A₁, k₁, hA₁, hu₁⟩ :=
    wc_etqmt_x0_affine_unit_nbhd U x (wcEtqmtX g ⟨0, by omega⟩) hx0 A₀
  haveI : IsAffine A₁.right.left := hA₁
  haveI : IsAffine ((𝟭 Scheme.{u}).obj A₁.right.left) := hA₁
  haveI : IsAffine (Limits.pullback (A₁.right.hom ≫ fX) ξ) := inferInstance
  haveI : IsAffine (Limits.pullback A₁.right.hom (Limits.pullback.fst fX ξ)) :=
    IsAffine.of_isIso (Limits.pullbackRightPullbackFstIso fX ξ A₁.right.hom).hom

