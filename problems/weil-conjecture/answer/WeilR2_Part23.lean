        (m • 𝟙 ((wcEtPush h).obj (wcEtGm Q))) ≫
        (sheafToPresheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}).map κ = 0 := by
      rw [← CategoryTheory.Functor.map_comp, w, CategoryTheory.Functor.map_zero]
    have h4 := congrArg (fun f : ((wcEtPush h).obj (wcEtGm Q)).obj ⟶ H.obj =>
      (NatTrans.app f (Opposite.op W)).hom x) h3
    simp only [NatTrans.comp_app, NatTrans.app_zero, AddCommGrpCat.hom_comp, AddCommGrpCat.hom_zero,
      AddMonoidHom.coe_comp, Function.comp_apply, AddMonoidHom.zero_apply] at h4
    rw [← nsmulS]
    exact h4

  have θinvinj : ∀ (V : T.Etale) (y : H.obj.obj (Opposite.op V)),
      (θ.inv.hom.app (Opposite.op V)).hom y = 0 → y = 0 := by
    intro V y hy
    have e : (θ.inv ≫ θ.hom).hom.app (Opposite.op V) = 𝟙 _ := by rw [Iso.inv_hom_id]; rfl
    have e2 := congrArg (fun f => AddCommGrpCat.Hom.hom f y) e
    change (θ.hom.hom.app _).hom ((θ.inv.hom.app _).hom y) = y at e2
    rw [hy, map_zero] at e2
    exact e2.symm

  have appc : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (s : Γ(Z, ⊤)),
      (f ≫ g).appTop.hom s = f.appTop.hom (g.appTop.hom s) := by
    intro X Y Z f g s; rw [Scheme.Hom.comp_appTop]; rfl
  have bcc : ∀ {V₁ V₂ V₃ : T.Etale} (c : V₂ ⟶ V₁) (c' : V₃ ⟶ V₂)
      (s : Γ(((wcEtBaseChange h).obj V₁).left, ⊤)),
      ((wcEtBaseChange h).map (c' ≫ c)).left.appTop.hom s =
        ((wcEtBaseChange h).map c').left.appTop.hom (((wcEtBaseChange h).map c).left.appTop.hom s) := by
    intro V₁ V₂ V₃ c c' s
    rw [CategoryTheory.Functor.map_comp]
    exact appc _ _ s

  let K : ∀ V : T.Etale, Additive (Γ(((wcEtBaseChange h).obj V).left, ⊤))ˣ →+
      R.obj.obj (Opposite.op V) :=
    fun V => (θ.inv.hom.app (Opposite.op V)).hom.comp ((κ.hom.app (Opposite.op V)).hom.comp (τ V))
  have hKdef : ∀ (V : T.Etale) (x : Additive (Γ(((wcEtBaseChange h).obj V).left, ⊤))ˣ),
      K V x = (θ.inv.hom.app (Opposite.op V)).hom ((κ.hom.app (Opposite.op V)).hom (τ V x)) :=
    fun V x => rfl
  have hKn : ∀ {V W : T.Etale} (c : W ⟶ V) (a : (Γ(((wcEtBaseChange h).obj V).left, ⊤))ˣ),
      (R.obj.map c.op).hom (K V (Additive.ofMul a)) =
        K W (Additive.ofMul (Units.map ((wcEtBaseChange h).map c).left.appTop.hom.toMonoidHom a)) := by
    intro V W c a
    rw [hKdef, hKdef]
    exact (natS θ.inv c _).trans (congrArg _ ((natS κ c _).trans (congrArg _ (hτn c a))))
  refine ⟨K, hKn, ?_⟩
  intro V a
  constructor
  ·
    intro h0 v
    rw [hKdef] at h0
    have h1 := θinvinj V _ h0
    obtain ⟨W₁, c₁, w₁, σ, hc₁, hσ⟩ := wc_r1s_sheaf_exact_local_lift T
      (m • 𝟙 ((wcEtPush h).obj (wcEtGm Q))) κ w hex V (τ V (Additive.ofMul a)) h1 v
    rw [nsmulS, hτn] at hσ
    obtain ⟨W₂, c₂, w₂, b, hc₂, hb⟩ := hτs W₁ σ w₁
    have h2 : τ W₂ (Additive.ofMul
        (Units.map ((wcEtBaseChange h).map c₂).left.appTop.hom.toMonoidHom
          (Units.map ((wcEtBaseChange h).map c₁).left.appTop.hom.toMonoidHom a) * (b ^ m)⁻¹)) = 0 := by
      rw [ofMul_mul, ofMul_inv, map_add, map_neg, ← hτn c₂, ← hσ, map_nsmul, hb, ofMul_pow,
        map_nsmul, add_neg_cancel]
    obtain ⟨W₃, c₃, w₃, hc₃, h3⟩ := hτi W₂ _ h2 w₂
    rw [map_mul, map_inv, mul_inv_eq_one, map_pow] at h3
    refine ⟨W₃, c₃ ≫ c₂ ≫ c₁, w₃,
      ((Units.map ((wcEtBaseChange h).map c₃).left.appTop.hom.toMonoidHom b :
        (Γ(((wcEtBaseChange h).obj W₃).left, ⊤))ˣ) : Γ(((wcEtBaseChange h).obj W₃).left, ⊤)), ?_, ?_⟩
    · show c₁.left (c₂.left (c₃.left w₃)) = v
      rw [hc₃, hc₂, hc₁]
    · rw [← Units.val_pow_eq_pow_val, ← h3, bcc, bcc]
      rfl
  ·
    intro hloc
    have hall := (wc_etale_section_vanishing_open T R V (K V (Additive.ofMul a))).2 V (𝟙 V) (by
      rintro _ ⟨x, rfl⟩
      obtain ⟨W, c, w', b, hcw, hb⟩ := hloc ((𝟙 V : V ⟶ V).left x)
      rw [Set.mem_setOf_eq]
      refine ⟨W, c, ⟨w', hcw⟩, ?_⟩
      have hu : IsUnit (b ^ m) := by
        rw [hb]
        exact (Units.map ((wcEtBaseChange h).map c).left.appTop.hom.toMonoidHom a).isUnit
      have hb' : IsUnit b := (isUnit_pow_iff hm0.ne').mp hu
      have hcu : Units.map ((wcEtBaseChange h).map c).left.appTop.hom.toMonoidHom a = hb'.unit ^ m := by
        apply Units.ext
        rw [Units.val_pow_eq_pow_val, IsUnit.unit_spec, hb]
        rfl
      show (R.obj.map c.op).hom (K V (Additive.ofMul a)) = 0
      rw [hKn c a, hcu, ofMul_pow, hKdef, map_nsmul (τ W), star, map_zero])
    have e : R.obj.map (𝟙 V).op = 𝟙 _ := by rw [op_id, CategoryTheory.Functor.map_id]
    rw [e] at hall
    exact hall

theorem wc_et_unit_locally_pow (X : Scheme.{u}) (m : ℕ) (hm0 : 0 < m)
    (hm : IsUnit ((m : ℕ) : Γ(X, ⊤))) (W : X.Etale) (u : (Γ(W.left, ⊤))ˣ) (w : W.left) :
    ∃ (W' : X.Etale) (c : W' ⟶ W) (w' : W'.left) (x : Γ(W'.left, ⊤)),
      c.left w' = w ∧ x ^ m = c.left.appTop.hom (u : Γ(W.left, ⊤)) :=
by
  classical

  have kummer : ∀ (R : Type u) [CommRing R], IsUnit ((m : ℕ) : R) →
      ∀ y : Rˣ, ∃ (B : Type u) (_ : CommRing B) (_ : Algebra R B), Algebra.Etale R B ∧
        Function.Surjective (PrimeSpectrum.comap (algebraMap R B)) ∧
        ∃ x : B, x ^ m = algebraMap R B (y : R) := by
    intro R _ hmR y
    have hm0' : m ≠ 0 := Nat.pos_iff_ne_zero.mp hm0
    set f : Polynomial R := Polynomial.X ^ m - Polynomial.C (y : R) with hf
    have hfm : f.Monic := Polynomial.monic_X_pow_sub_C (y : R) hm0'
    obtain ⟨v, hv⟩ := (hmR.mul y.isUnit).exists_left_inv
    have hcert : ∃ (p₁ p₂ : Polynomial R) (n : ℕ),
        Polynomial.derivative f * p₁ + f * p₂ = (1 : Polynomial R) ^ n := by
      refine ⟨Polynomial.C v * Polynomial.X, -(Polynomial.C v * Polynomial.C (m : R)), 1, ?_⟩
      have hd : Polynomial.derivative f = Polynomial.C (m : R) * Polynomial.X ^ (m - 1) := by
        rw [hf, Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C,
          sub_zero]
      have hX : Polynomial.X ^ (m - 1) * Polynomial.X = (Polynomial.X : Polynomial R) ^ m :=
        pow_sub_one_mul hm0' Polynomial.X
      have hv' : Polynomial.C v * (Polynomial.C (m : R) * Polynomial.C (y : R)) = 1 := by
        rw [← map_mul, ← map_mul, hv, map_one]
      rw [hd, hf, pow_one]
      linear_combination hv' + (Polynomial.C v * Polynomial.C (m : R)) * hX
    let P : StandardEtalePair R := ⟨f, hfm, 1, hcert⟩
    have e₂ : AdjoinRoot f ≃ₐ[R] Localization.Away ((AdjoinRoot.mk f) 1) :=
      (IsLocalization.atUnit (AdjoinRoot f) (Localization.Away ((AdjoinRoot.mk f) 1))
        ((AdjoinRoot.mk f) 1) (by simp)).restrictScalars R
    have e : P.Ring ≃ₐ[R] AdjoinRoot f := P.equivAwayAdjoinRoot.trans e₂.symm
    have het : Algebra.Etale R (AdjoinRoot f) := Algebra.Etale.of_equiv e
    refine ⟨AdjoinRoot f, inferInstance, inferInstance, het, ?_, AdjoinRoot.root f, ?_⟩
    · rcases subsingleton_or_nontrivial R with hR | hR
      · have : IsEmpty (PrimeSpectrum R) := PrimeSpectrum.isEmpty_iff_subsingleton.mpr hR
        intro x
        exact isEmptyElim x
      · have : Module.Free R (AdjoinRoot f) := hfm.free_adjoinRoot
        let pb := AdjoinRoot.powerBasis' hfm
        have hdim : 0 < pb.dim := by
          rw [AdjoinRoot.powerBasis'_dim, hf, Polynomial.natDegree_X_pow_sub_C]
          exact hm0
        have : Nontrivial (AdjoinRoot f) := nontrivial_of_ne _ _ (pb.basis.ne_zero ⟨0, hdim⟩)
        exact PrimeSpectrum.comap_surjective_of_faithfullyFlat
    · have h1 : Polynomial.aeval (AdjoinRoot.root f) f = 0 := by
        rw [AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]
      rw [hf, map_sub, Polynomial.aeval_X_pow, Polynomial.aeval_C] at h1
      exact sub_eq_zero.mp h1

  obtain ⟨p, hp⟩ := W.left.affineCover.covers w
  let R : CommRingCat.{u} := W.left.affineOpenCover.X (W.left.affineCover.idx w)
  let fj : Spec R ⟶ W.left := W.left.affineCover.f (W.left.affineCover.idx w)
  haveI hfj : Etale fj := by
    show Etale (W.left.affineCover.f (W.left.affineCover.idx w))
    infer_instance

  have hmR : IsUnit ((m : ℕ) : R) := by
    have h := hm.map (W.hom.appTop ≫ fj.appTop ≫ (Scheme.ΓSpecIso R).hom).hom
    rwa [map_natCast] at h
  let y : (R : Type u)ˣ := Units.map (fj.appTop ≫ (Scheme.ΓSpecIso R).hom).hom.toMonoidHom u
  obtain ⟨B, _, _, hét, hsurj, x₀, hx₀⟩ := kummer R hmR y

  let g : Spec (CommRingCat.of B) ⟶ Spec R := Spec.map (CommRingCat.ofHom (algebraMap R B))
  haveI hg : Etale g :=
    (HasRingHomProperty.Spec_iff (P := @Etale)).mpr (RingHom.etale_algebraMap.mpr hét)
  let f : Spec (CommRingCat.of B) ⟶ W.left := g ≫ fj
  haveI : Etale f := by
    show Etale (g ≫ fj)
    infer_instance
  haveI : Etale W.hom := W.prop
  haveI : Etale (f ≫ W.hom) := inferInstance
  let W' : X.Etale := Scheme.Etale.mk (f ≫ W.hom)
  let c : W' ⟶ W := MorphismProperty.Over.homMk f rfl trivial
  obtain ⟨q, hq⟩ := hsurj p
  refine ⟨W', c, q, (Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom x₀, ?_, ?_⟩
  · show (g ≫ fj) q = w
    refine (Scheme.Hom.comp_apply g fj q).trans ?_
    have hgq : g q = p := by rw [← hq]; rfl
    rw [hgq]
    exact hp
  · show ((Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom x₀) ^ m = (g ≫ fj).appTop.hom u
    have hinj : Function.Injective (Scheme.ΓSpecIso (CommRingCat.of B)).hom.hom := by
      intro a b h
      have := congrArg (Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom h
      simpa using this
    apply hinj
    have e1 : (Scheme.ΓSpecIso (CommRingCat.of B)).hom.hom
        ((Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom x₀) = x₀ := by simp
    have nat : g.appTop ≫ (Scheme.ΓSpecIso (CommRingCat.of B)).hom =
        (Scheme.ΓSpecIso R).hom ≫ CommRingCat.ofHom (algebraMap R B) :=
      Scheme.ΓSpecIso_naturality (CommRingCat.ofHom (algebraMap R B))
    have nat' := congrArg (fun h => h.hom (fj.appTop.hom u)) nat
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at nat'
    rw [map_pow, e1, Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
    exact hx₀.trans nat'.symm

theorem wc_r1s_double_no_root (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) (k : ℕ) (hk : 1 ≤ k) (π : A)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (r : ℕ)
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A))
    (hφπ : (Spec.preimage ξ).hom π ≠ 0)
    (W : Scheme.{u}) (a : W ⟶ Spec (.of (wcR1sM A r π))) [Etale a] (w : W)
    (h0 : wcR1sY0 A r π ∈ (a w).asIdeal) (h1 : wcR1sY1 A r π ∈ (a w).asIdeal)
    (Pq : Scheme.{u}) (q1 : Pq ⟶ W) (qL : Pq ⟶ Spec (.of Ω))
    (hpb : IsPullback q1 qL (a ≫ wcQuadModelStr A (r + 2) π (wcR1sC0 A r)) ξ) :
    ¬ ∃ b : Γ(Pq, ⊤), b ^ (ℓ ^ k) =
      ((q1 ≫ a).appTop.hom ((Scheme.ΓSpecIso (.of (wcR1sM A r π))).inv.hom (wcR1sY0 A r π))) ^
        (ℓ ^ (k - 1)) :=
by
  classical
  have hℓp : ℓ.Prime := Fact.out

  have L2 : ∀ (S : Type u) [CommRing S] (_ : Algebra Ω S) (_ : ConnectedSpace (PrimeSpectrum S))
      (U B : S), IsUnit U → B ^ (ℓ ^ k) = U ^ (ℓ ^ (k - 1)) → ((ℓ : ℕ) : Ω) ≠ 0 →
      ∃ s : S, s ^ ℓ = U := by
    intro S _ _ _ U B hU hBU hℓΩ
    set N := ℓ ^ (k - 1) with hNdef
    have hNΩ : ((N : ℕ) : Ω) ≠ 0 := by rw [hNdef, Nat.cast_pow]; exact pow_ne_zero _ hℓΩ
    have hNpos : 0 < N := pow_pos hℓp.pos _
    have : Nontrivial S := PrimeSpectrum.nonempty_iff_nontrivial.mp inferInstance
    set u := hU.unit with hudef
    set w : S := B ^ ℓ * ((u⁻¹ : Sˣ) : S) with hwdef
    have hUu : U * ((u⁻¹ : Sˣ) : S) = 1 := by
      rw [hudef]; exact hU.mul_val_inv
    have hwN : w ^ N = 1 := by
      have hk' : ℓ ^ k = ℓ * N := by
        rw [hNdef, ← pow_succ']; congr 1; omega
      rw [hwdef, mul_pow, ← pow_mul, ← hk', hBU, ← mul_pow, hUu, one_pow]
    have hBw : B ^ ℓ = w * U := by
      rw [hwdef, mul_assoc, mul_comm _ U, hUu, mul_one]
    set p : Polynomial Ω := Polynomial.X ^ N - Polynomial.C 1 with hpdef
    have hpmon : p.Monic := Polynomial.monic_X_pow_sub_C 1 hNpos.ne'
    have hcard : Multiset.card p.roots = p.natDegree := IsAlgClosed.card_roots_eq_natDegree
    have hsep : p.Separable := Polynomial.separable_X_pow_sub_C 1 hNΩ one_ne_zero
    have hnd : p.roots.Nodup := Polynomial.nodup_roots hsep
    set s : Finset Ω := p.roots.toFinset with hsdef
    have hsval : s.val = p.roots := by
      rw [hsdef, Multiset.toFinset_val, Multiset.dedup_eq_self.mpr hnd]
    have hprod : ∏ z ∈ s, (Polynomial.X - Polynomial.C z) = p := by
      rw [Finset.prod_eq_multiset_prod, hsval]
      exact Polynomial.prod_multiset_X_sub_C_of_monic_of_roots_card_eq hpmon hcard
    have hpw : Polynomial.aeval w p = 0 := by
      rw [hpdef, map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C, map_one, hwN, sub_self]
    have hmem : ∀ z ∈ s, z ^ N = 1 := by
      intro z hz
      rw [hsdef, Multiset.mem_toFinset, Polynomial.mem_roots hpmon.ne_zero] at hz
      have := hz.eq_zero
      rw [hpdef, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_C,
        sub_eq_zero] at this
      exact this
    have h1s : (1 : Ω) ∈ s := by
      rw [hsdef, Multiset.mem_toFinset, Polynomial.mem_roots hpmon.ne_zero]
      simp [hpdef, Polynomial.IsRoot]
    have hsne : s.Nonempty := ⟨1, h1s⟩
    have hinj : Set.InjOn (id : Ω → Ω) s := fun a _ b _ h => h
    let e : Ω → S := fun z => Polynomial.aeval w (Lagrange.basis s id z)
    have hkill : ∀ z ∈ s, (w - algebraMap Ω S z) * e z = 0 := by
      intro z hz
      have hdiv : (Polynomial.X - Polynomial.C z) * Lagrange.basis s id z =
          Polynomial.C (∏ j ∈ s.erase z, (z - j)⁻¹) * p := by
        rw [← hprod, ← Finset.mul_prod_erase s (fun j => Polynomial.X - Polynomial.C j) hz]
        simp only [Lagrange.basis, Lagrange.basisDivisor, id]
        rw [Finset.prod_mul_distrib, map_prod]
        ring
      have := congrArg (Polynomial.aeval w) hdiv
      rw [map_mul, map_mul, hpw, mul_zero, map_sub, Polynomial.aeval_X, Polynomial.aeval_C] at this
      exact this
    have hev : ∀ z ∈ s, ∀ q : Polynomial Ω,
        Polynomial.aeval w q * e z = algebraMap Ω S (q.eval z) * e z := by
      intro z hz q
      obtain ⟨q', hq'⟩ := Polynomial.X_sub_C_dvd_sub_C_eval (a := z) (p := q)
      have h := congrArg (Polynomial.aeval w) hq'
      rw [map_sub, Polynomial.aeval_C, map_mul, map_sub, Polynomial.aeval_X,
        Polynomial.aeval_C] at h
      have h2 : (Polynomial.aeval w q - algebraMap Ω S (q.eval z)) * e z = 0 := by
        rw [h, mul_comm (w - _) _, mul_assoc, hkill z hz, mul_zero]
      rw [sub_mul, sub_eq_zero] at h2
      exact h2
    have hidem : ∀ z ∈ s, IsIdempotentElem (e z) := by
      intro z hz
      show e z * e z = e z
      have := hev z hz (Lagrange.basis s id z)
      rw [this, show Polynomial.eval z (Lagrange.basis s id z) = 1 from
        Lagrange.eval_basis_self hinj hz, map_one, one_mul]
    have hsum : ∑ z ∈ s, e z = 1 := by
      show ∑ z ∈ s, Polynomial.aeval w (Lagrange.basis s id z) = 1
      rw [← map_sum, Lagrange.sum_basis hinj hsne, map_one]
    have h01 : ∀ x : S, IsIdempotentElem x → x = 0 ∨ x = 1 := by
      intro x hx
      have hx' : IsIdempotentElem (1 - x) := hx.one_sub
      have hcl : IsClopen (PrimeSpectrum.zeroLocus ({x} : Set S)) := by
        refine ⟨PrimeSpectrum.isClosed_zeroLocus _, ?_⟩
        have hc : (PrimeSpectrum.zeroLocus ({x} : Set S))ᶜ = PrimeSpectrum.zeroLocus {1 - x} := by
          ext P
          simp only [Set.mem_compl_iff, PrimeSpectrum.mem_zeroLocus, Set.singleton_subset_iff,
            SetLike.mem_coe]
          constructor
          · intro hP
            have h0 : x * (1 - x) ∈ P.asIdeal := by
              rw [mul_sub, mul_one, hx.eq, sub_self]; exact P.asIdeal.zero_mem
            exact (P.isPrime.mem_or_mem h0).resolve_left hP
          · intro hP hxP
            have : x + (1 - x) ∈ P.asIdeal := P.asIdeal.add_mem hxP hP
            rw [add_sub_cancel] at this
            exact P.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr this)
        rw [← isClosed_compl_iff, hc]
        exact PrimeSpectrum.isClosed_zeroLocus _
      rcases isClopen_iff.mp hcl with h | h
      · right
        have hnil : IsNilpotent (1 - x) := by
          rw [nilpotent_iff_mem_prime]
          intro J hJ
          have hmem : (⟨J, hJ⟩ : PrimeSpectrum S) ∉ PrimeSpectrum.zeroLocus ({x} : Set S) := by
            rw [h]; exact Set.notMem_empty _
          simp only [PrimeSpectrum.mem_zeroLocus, Set.singleton_subset_iff,
            SetLike.mem_coe] at hmem
          have h0 : x * (1 - x) ∈ J := by
            rw [mul_sub, mul_one, hx.eq, sub_self]; exact J.zero_mem
          exact (hJ.mem_or_mem h0).resolve_left hmem
        have := hx'.eq_zero_of_isNilpotent hnil
        exact (sub_eq_zero.mp this).symm
      · left
        have hnil : IsNilpotent x := by
          rw [nilpotent_iff_mem_prime]
          intro J hJ
          have hmem : (⟨J, hJ⟩ : PrimeSpectrum S) ∈ PrimeSpectrum.zeroLocus ({x} : Set S) := by
            rw [h]; exact Set.mem_univ _
          simpa only [PrimeSpectrum.mem_zeroLocus, Set.singleton_subset_iff,
            SetLike.mem_coe] using hmem
        exact hx.eq_zero_of_isNilpotent hnil
    have hsum0 : ∑ z ∈ s, e z ≠ 0 := by rw [hsum]; exact one_ne_zero
    obtain ⟨ζ, hζs, hζ0⟩ := Finset.exists_ne_zero_of_sum_ne_zero hsum0
    have hζ1 : e ζ = 1 := (h01 _ (hidem ζ hζs)).resolve_left hζ0
    have hwζ : w = algebraMap Ω S ζ := by
      have := hkill ζ hζs
      rw [hζ1, mul_one, sub_eq_zero] at this
      exact this
    have hζne : ζ ≠ 0 := by
      intro h0
      have := hmem ζ hζs
      rw [h0, zero_pow hNpos.ne'] at this
      exact zero_ne_one this
    obtain ⟨η, hη⟩ := IsAlgClosed.exists_pow_nat_eq ζ hℓp.pos
    refine ⟨B * algebraMap Ω S η⁻¹, ?_⟩
    rw [mul_pow, ← map_pow, inv_pow, hη, hBw, hwζ, mul_comm (algebraMap Ω S ζ) U, mul_assoc,
      ← map_mul, mul_inv_cancel₀ hζne, map_one, mul_one]

  rintro ⟨b, hb⟩
  set φ := (Spec.preimage ξ).hom with hφdef
  have hξ' : Spec.map (CommRingCat.ofHom φ) = ξ := by
