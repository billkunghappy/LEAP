    obtain ⟨zt, hzt⟩ := h4 a₀ ha₀0
    refine ⟨zt ≫ ι⟦M⟧', fun g₀ hg₀ => ?_⟩
    have hg0 : ι ≫ g₀ = 0 := by rw [h3 g₀, Limits.comp_zero]
    have hcomp : (zt ≫ ι⟦M⟧') ≫ b'⟦M⟧' = (zt ≫ a₀⟦M⟧') ≫ (N.negOnePow • e⟦N⟧')⟦M⟧' := by
      rw [Category.assoc, ← Functor.map_comp, ha₀, Functor.map_comp, Category.assoc]
    rw [hcomp, hg0] at hg₀
    let TNM := (shiftFunctor (Pretriangulated.Triangle (DerivedCategory 𝒞)) M).obj TN
    have hTNM : TNM ∈ distTriang _ := Pretriangulated.Triangle.shift_distinguished TN hTN M
    have h5 : (zt ≫ a₀⟦M⟧') ≫ (M.negOnePow • (N.negOnePow • e⟦N⟧')⟦M⟧') = 0 := by
      rw [Units.smul_def, Preadditive.comp_zsmul, hg₀, smul_zero]
    obtain ⟨g, hg⟩ : ∃ g : Kp ⟶ (((C⟦N⟧)⟦M⟧)⟦(-1 : ℤ)⟧),
        zt ≫ a₀⟦M⟧' = g ≫ TNM.invRotate.mor₁ :=
      Pretriangulated.Triangle.coyoneda_exact₂ _ (Pretriangulated.inv_rot_of_distTriang _ hTNM) (zt ≫ a₀⟦M⟧') h5
    apply hzt
    rw [hg, hv2 M (-1) g]
    exact Limits.zero_comp

  have t4 : ∀ {𝒞 : Type (u+2)} [Category.{u+1} 𝒞] [Abelian 𝒞] {_hD : HasDerivedCategory.{u+2} 𝒞}
      (m : ℕ) (N M : ℤ) (Kp L : DerivedCategory 𝒞),
      (Finite (Kp ⟶ L⟦N⟧) ∧ Nat.card (Kp ⟶ L⟦N⟧) ≤ m) →
      (∃ (zt : Kp ⟶ Kp⟦M⟧) (a₁ : Kp ⟶ L⟦N⟧), ∀ j : ℕ, j • (zt ≫ a₁⟦M⟧') = 0 → m ∣ j) →
      ∀ a₀ : Kp ⟶ L⟦N⟧, a₀ ≠ 0 → ∃ zt : Kp ⟶ Kp⟦M⟧, zt ≫ a₀⟦M⟧' ≠ 0 := by
    intro 𝒞 _ _ _ m N M Kp L hc1 hc2 a₀ ha₀
    obtain ⟨hfin, hcard⟩ := hc1
    obtain ⟨zt, a₁, hord⟩ := hc2
    have hφ : ∀ (j : ℕ) (a : Kp ⟶ L⟦N⟧), zt ≫ (j • a)⟦M⟧' = j • (zt ≫ a⟦M⟧') := by
      intro j a
      rw [Functor.map_nsmul, Preadditive.comp_nsmul]
    let f : Fin m → (Kp ⟶ L⟦N⟧) := fun i => i.val • a₁
    have hle : ∀ i i' : Fin m, i.val ≤ i'.val → f i = f i' → i = i' := by
      intro i i' hii heq
      have h0 : (i'.val - i.val) • a₁ = 0 := by
        rw [sub_nsmul a₁ hii]
        change i.val • a₁ = i'.val • a₁ at heq
        rw [← heq, add_neg_cancel]
      have h1 : (i'.val - i.val) • (zt ≫ a₁⟦M⟧') = 0 := by
        rw [← hφ, h0, Functor.map_zero, Limits.comp_zero]
      have h3 : i'.val - i.val = 0 := Nat.eq_zero_of_dvd_of_lt (hord _ h1) (by omega)
      exact Fin.ext (by omega)
    have hinj : Function.Injective f := by
      intro i i' heq
      rcases le_total i.val i'.val with h | h
      · exact hle i i' h heq
      · exact (hle i' i h heq.symm).symm
    have hbij : Function.Bijective f :=
      hinj.bijective_of_nat_card_le (by rw [Nat.card_fin]; exact hcard)
    obtain ⟨i, hi⟩ := hbij.2 a₀
    change i.val • a₁ = a₀ at hi
    refine ⟨zt, fun h0 => ha₀ ?_⟩
    have h1 : i.val • (zt ≫ a₁⟦M⟧') = 0 := by rw [← hφ, hi]; exact h0
    have h3 : i.val = 0 := Nat.eq_zero_of_dvd_of_lt (hord _ h1) i.isLt
    rw [← hi, h3, zero_nsmul]

  have key : ∀ {𝒞 𝒞W : Type (u+2)} [Category.{u+1} 𝒞] [Category.{u+1} 𝒞W] [Abelian 𝒞] [Abelian 𝒞W]
