theorem wc_et_tpl_det_shens_local_duality (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (k : ℕ) (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left
      (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left))
    (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left)
    (hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a)
    (η : (wcP1Over F'').left) (hηb : η ⤳ D.S i (IsLocalRing.closedPoint F''))
    (hηne : η ≠ D.S i (IsLocalRing.closedPoint F''))
    (ξ : Spec (.of (AlgebraicClosure ((wcP1Over F'').left.residueField η))) ⟶ Spec (.of A))
    (hξ : ξ ≫ a = wcEtGeomPt (wcP1Over F'').left η)
    (x : ↥(Limits.pullback D.f a)) (hx : Limits.pullback.fst D.f a x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Limits.pullback D.f a) x))
      (Scheme.Etale.forget (Limits.pullback D.f a)))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ Limits.pullback D.f a)
    (hsh : wcHalShData x B Λ' W'' φ' a')
    (Dh : wcEtPullData (Limits.pullback.fst (Limits.pullback.snd D.f a) ξ) (ℓ ^ k)) (Dg : wcEtPullData (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k))
    (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) ξ) (ℓ ^ k))))
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)))
    (hxs : Limits.pullback.fst (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A) xs = x)
    (Dx : wcEtPullData (wcEtGeomPt (Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)) xs) (ℓ ^ k))
    (Dw : wcEtPullData (Limits.pullback.snd a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (ℓ ^ k)) :
    haveI := Dh.additive
    haveI := Dg.additive
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst (Limits.pullback.snd D.f a) ξ)) _ _ Dh.cont Dh.φ
    haveI : P.Additive := Adjunction.right_adjoint_additive Dh.adj
    let K := (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex
    let Ψ := (Dg.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k)))
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (ℓ ^ k)))
    haveI := Dw.additive
    haveI := Dw.presLim
    haveI := Dw.presColim
    let R := Dw.Φ.mapDerivedCategory
    ∀ b' : R.obj (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
          (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k))))) ⟶
          (R.obj (DerivedCategory.Q.obj Ψ))⟦(((n - 1) : ℕ) : ℤ)⟧,
      b' ≠ 0 →
      ∃ w' : R.obj (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj (wcEtSuppObj Dx))) ⟶
          (R.obj (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
            (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k))))))⟦(((n - 1) : ℕ) : ℤ)⟧,
        w' ≫ b'⟦(((n - 1) : ℕ) : ℤ)⟧' ≫
          (shiftFunctorAdd' (DerivedCategory (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (ℓ ^ k))))
            (((n - 1) : ℕ) : ℤ) (((n - 1) : ℕ) : ℤ) (((2 * (n - 1)) : ℕ) : ℤ) (by omega)).inv.app
            (R.obj (DerivedCategory.Q.obj Ψ)) ≠ 0 :=
by
  intro P K Ψ R b' hb'
  haveI := Dh.additive
  haveI := Dg.additive
  haveI := Dw.additive
  haveI := Dw.presLim
  haveI := Dw.presColim
  haveI : P.Additive := Adjunction.right_adjoint_additive Dh.adj
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k)))
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (ℓ ^ k)))

  have t1 : ∀ {𝒞 : Type (u+2)} [Category.{u+1} 𝒞] [Abelian 𝒞] {_hD : HasDerivedCategory.{u+2} 𝒞}
      (N M Rr : ℤ) (hNM : M + 1 = N) (hNR : N + N = Rr) {L S Ψ Kp : DerivedCategory 𝒞} (u : L ⟶ S)
      (ι : Kp ⟶ L) (δ : S ⟶ Kp⟦(1 : ℤ)⟧)
      (hT : Pretriangulated.Triangle.mk ι u δ ∈ distTriang _) (b' : L ⟶ Ψ⟦N⟧)
      (hL : ∃ z : Kp ⟶ L⟦M⟧, ∀ g₀ : L ⟶ (Ψ⟦N⟧)⟦M⟧, z ≫ b'⟦M⟧' ≠ ι ≫ g₀),
      ∃ w' : S ⟶ L⟦N⟧, w' ≫ b'⟦N⟧' ≫ (shiftFunctorAdd' (DerivedCategory 𝒞) N N Rr hNR).inv.app Ψ ≠ 0 := by
    intro 𝒞 _ _ _ N M Rr hNM hNR L S Ψ Kp u ι δ hT b' hL
    obtain ⟨z, hz⟩ := hL
    let α := (shiftFunctorAdd' (DerivedCategory 𝒞) M 1 N hNM).inv
    refine ⟨δ ≫ z⟦(1:ℤ)⟧' ≫ α.app L, fun h0 => ?_⟩
    have hnat : (b'⟦M⟧')⟦(1:ℤ)⟧' ≫ α.app (Ψ⟦N⟧) = α.app L ≫ b'⟦N⟧' := α.naturality b'
    have h1 : δ ≫ (z ≫ b'⟦M⟧')⟦(1:ℤ)⟧' ≫ (α.app (Ψ⟦N⟧) ≫
        (shiftFunctorAdd' (DerivedCategory 𝒞) N N Rr hNR).inv.app Ψ) = 0 := by
      rw [Functor.map_comp, Category.assoc, reassoc_of% hnat]
      simpa [Category.assoc] using h0
    have h2 : δ ≫ (z ≫ b'⟦M⟧')⟦(1:ℤ)⟧' = 0 := by
      rw [← cancel_mono (α.app (Ψ⟦N⟧) ≫ (shiftFunctorAdd' (DerivedCategory 𝒞) N N Rr hNR).inv.app Ψ),
        Category.assoc, h1, Limits.zero_comp]
    have hrot := Pretriangulated.rot_of_distTriang _ hT
    obtain ⟨g, hg2⟩ : ∃ g : L⟦(1:ℤ)⟧ ⟶ ((Ψ⟦N⟧)⟦M⟧)⟦(1:ℤ)⟧,
        (z ≫ b'⟦M⟧')⟦(1:ℤ)⟧' = (-(ι⟦(1:ℤ)⟧')) ≫ g :=
      Pretriangulated.Triangle.yoneda_exact₃ _ hrot ((z ≫ b'⟦M⟧')⟦(1:ℤ)⟧') h2
    have hg' : (z ≫ b'⟦M⟧')⟦(1:ℤ)⟧' =
        (ι ≫ (-((shiftFunctor (DerivedCategory 𝒞) (1:ℤ)).preimage g)))⟦(1:ℤ)⟧' := by
      rw [hg2, Functor.map_comp, Functor.map_neg, Functor.map_preimage, Preadditive.comp_neg,
        Preadditive.neg_comp]
    exact hz _ ((shiftFunctor (DerivedCategory 𝒞) (1:ℤ)).map_injective hg')

  have t2 : ∀ {𝒞 : Type (u+2)} [Category.{u+1} 𝒞] [Abelian 𝒞] {_hD : HasDerivedCategory.{u+2} 𝒞}
    (N M : ℤ) (hNM : M + 1 = N) {L S Ψ Kp C : DerivedCategory 𝒞} (u : L ⟶ S) (ι : Kp ⟶ L) (δ : S ⟶ Kp⟦(1 : ℤ)⟧)
    (hT : Pretriangulated.Triangle.mk ι u δ ∈ distTriang _)
    (e : L ⟶ Ψ) (r : Ψ ⟶ C) (d : C ⟶ L⟦(1 : ℤ)⟧)
    (hTe : Pretriangulated.Triangle.mk e r d ∈ distTriang _) (σ : C⟦N⟧ ≅ S)
    (h1 : ∀ (k : ℤ) (f : Kp ⟶ S⟦k⟧), f = 0)
    (h2 : ∀ g : S ⟶ Ψ⟦N⟧, u ≫ g = 0)
    (h3 : ∀ g : L ⟶ (Ψ⟦N⟧)⟦M⟧, g = 0)
    (h4 : ∀ a₀ : Kp ⟶ L⟦N⟧, a₀ ≠ 0 → ∃ zt : Kp ⟶ Kp⟦M⟧, zt ≫ a₀⟦M⟧' ≠ 0),
    ∀ b' : L ⟶ Ψ⟦N⟧, b' ≠ 0 →
    ∃ z : Kp ⟶ L⟦M⟧, ∀ g₀ : L ⟶ (Ψ⟦N⟧)⟦M⟧, z ≫ b'⟦M⟧' ≠ ι ≫ g₀ := by
    intro 𝒞 _ _ _ N M hNM L S Ψ Kp C u ι δ hT e r d hTe σ h1 h2 h3 h4
    intro b' hb'
    have hv : ∀ (j : ℤ) (f : Kp ⟶ (C⟦N⟧)⟦j⟧), f = 0 := by
      intro j f
      have h := h1 j (f ≫ (shiftFunctor (DerivedCategory 𝒞) j).map σ.hom)
      rw [← cancel_mono ((shiftFunctor (DerivedCategory 𝒞) j).map σ.hom), h, Limits.zero_comp]
    have hv0 : ∀ f : Kp ⟶ C⟦N⟧, f = 0 := by
      intro f
      have h := hv 0 (f ≫ (shiftFunctorZero (DerivedCategory 𝒞) ℤ).inv.app (C⟦N⟧))
      rw [← cancel_mono ((shiftFunctorZero (DerivedCategory 𝒞) ℤ).inv.app (C⟦N⟧)), h, Limits.zero_comp]
    have hv2 : ∀ (j k : ℤ) (f : Kp ⟶ ((C⟦N⟧)⟦j⟧)⟦k⟧), f = 0 := by
      intro j k f
      have h := hv (j + k) (f ≫ (shiftFunctorAdd' (DerivedCategory 𝒞) j k (j + k) rfl).inv.app (C⟦N⟧))
      rw [← cancel_mono ((shiftFunctorAdd' (DerivedCategory 𝒞) j k (j + k) rfl).inv.app (C⟦N⟧)), h, Limits.zero_comp]
    have ha : ι ≫ b' ≠ 0 := by
      intro h0
      obtain ⟨g, hg⟩ := Pretriangulated.Triangle.yoneda_exact₂ _ hT b' h0
      exact hb' (hg.trans (h2 g))
    let T := Pretriangulated.Triangle.mk e r d
    let TN := (shiftFunctor (Pretriangulated.Triangle (DerivedCategory 𝒞)) N).obj T
    have hTN : TN ∈ distTriang _ := Pretriangulated.Triangle.shift_distinguished T hTe N
    obtain ⟨a₀, ha₀⟩ : ∃ a₀ : Kp ⟶ L⟦N⟧, ι ≫ b' = a₀ ≫ (N.negOnePow • e⟦N⟧') :=
      Pretriangulated.Triangle.coyoneda_exact₂ TN hTN (ι ≫ b') (hv0 _)
    have ha₀0 : a₀ ≠ 0 := by
      intro h0
      apply ha
      rw [ha₀, h0]
