        _ hxV hfx B Λ W' φ a hB Ω ξ).1)

  let F := SheafOfModules.toSheaf (wcEtZModRing (Limits.pullback (wcQuadModelStr A n π c)
    (wcQmSp A)) (ℓ ^ k)) ⋙ wcEtStalk _ y
  haveI : Limits.PreservesFiniteLimits (wcEtStalk (Limits.pullback (wcQuadModelStr A n π c)
    (wcQmSp A)) y) := (wc_et_stalk_exact _ y).1
  haveI : Limits.PreservesFiniteColimits (wcEtStalk (Limits.pullback (wcQuadModelStr A n π c)
    (wcQmSp A)) y) := (wc_et_stalk_exact _ y).2
  haveI : Limits.PreservesFiniteColimits (SheafOfModules.toSheaf (wcEtZModRing
      (Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A)) (ℓ ^ k))) :=
    sheafOfModules_toSheaf_preservesFiniteColimits _ _
  haveI : Limits.PreservesFiniteLimits F := Limits.comp_preservesFiniteLimits _ _
  haveI : Limits.PreservesFiniteColimits F := Limits.comp_preservesFiniteColimits _ _
  haveI : F.PreservesZeroMorphisms := by
    first
    | infer_instance
    | exact Functor.preservesZeroMorphisms_of_preserves_terminal_object F
  obtain ⟨θK⟩ := wc_et_pull_data_stalk_iso
    (Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A)) (ℓ ^ k) Dg
    (Limits.kernel (wcEtSuppUnitMap Dh)) y
  obtain ⟨θC⟩ := wc_et_pull_data_stalk_iso
    (Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A)) (ℓ ^ k) Dg
    (Limits.cokernel (wcEtSuppUnitMap Dh)) y
  have hK0 : Limits.IsZero (F.obj (Dg.Φ.obj (Limits.kernel (wcEtSuppUnitMap Dh)))) :=
