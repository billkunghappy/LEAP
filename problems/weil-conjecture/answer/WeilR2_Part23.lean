    let eΨ := (HomologicalComplex.single (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k))) (ComplexShape.up ℤ) 0).map
