  have hP : IsPullback (Limits.pullback.fst ((U'.ι ≫ e) ≫ wcQuadModelStr A n π c) (wcQmSp A))
      (wcEtxcJs (wcQuadModelStr A n π c) (U'.ι ≫ e)) (U'.ι ≫ e)
      (Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A)) := by
    have hbig : IsPullback (wcEtxcJs (wcQuadModelStr A n π c) (U'.ι ≫ e) ≫
