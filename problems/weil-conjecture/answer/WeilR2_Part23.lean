      ((Units.map ((wcEtBaseChange (Limits.pullback.fst f' ξ)).map a).left.appTop.hom.toMonoidHom
        (tU j) : (Γ(((wcEtBaseChange (Limits.pullback.fst f' ξ)).obj W).left, ⊤))ˣ) :
