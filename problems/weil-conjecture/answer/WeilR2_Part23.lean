        ((AddMonoidHom.mulLeft (u : ZMod m)).comp eM.symm.toAddMonoidHom)).comp
        (eL.symm.toAddMonoidHom.comp εe.symm.toAddMonoidHom)
    have hPr : ∀ w φ, Pr w φ = eT (eL.symm (εe.symm w) * ((u : ZMod m) * eM.symm φ)) :=
      fun w φ => rfl
    refine ⟨Pr, η.comp eT.symm.toAddMonoidHom, ?_, ?_⟩
    · intro w hw
      have h1 : η (eL.symm (εe.symm w) * ((u : ZMod m) * 1)) = 0 := by
        have := hw (eM 1)
        rw [hPr] at this
        simpa only [AddMonoidHom.comp_apply, AddEquiv.coe_toAddMonoidHom,
          AddEquiv.symm_apply_apply] using this
      have h2 : eL.symm (εe.symm w) * ((u : ZMod m) * 1) = 0 := hη (h1.trans (map_zero η).symm)
      rw [mul_one] at h2
      have h3 : eL.symm (εe.symm w) = 0 := by
        rw [← Units.mul_inv_cancel_right (eL.symm (εe.symm w)) u, h2, zero_mul]
      rw [AddEquiv.map_eq_zero_iff, AddEquiv.map_eq_zero_iff] at h3
