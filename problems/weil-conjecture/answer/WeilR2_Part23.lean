theorem wc_srdcbu_lc_comap_bij : ∀ {S S' W : Scheme.{u}} (g : S' ⟶ S) [IsProper g], (∀ (K : Type u) [Field K] (t : Spec (.of K) ⟶ S), ConnectedSpace ↥(Limits.pullback t g)) → ∀ (h : W ⟶ S) (M : Type), Function.Bijective (LocallyConstant.comap ⟨Limits.pullback.fst h g, (Limits.pullback.fst h g).continuous⟩ : LocallyConstant W M → LocallyConstant ↥(Limits.pullback h g) M) :=
by
  intro S S' W g _ hconn h M
  classical
  have : IsProper (Limits.pullback.fst h g) :=
    MorphismProperty.of_isPullback (P := @IsProper) (IsPullback.of_hasPullback h g).flip ‹IsProper g›
  have hcl : IsClosedMap (Limits.pullback.fst h g) := (Limits.pullback.fst h g).isClosedMap
  have hfib : ∀ w : W, _root_.IsPreconnected ((Limits.pullback.fst h g) ⁻¹' {w}) ∧
      ∃ p, (Limits.pullback.fst h g) p = w := by
    intro w
    have hr : Set.range (Limits.pullback.snd (W.fromSpecResidueField w) (Limits.pullback.fst h g))
        = (Limits.pullback.fst h g) ⁻¹' {w} := by
      rw [Scheme.Pullback.range_snd, Scheme.range_fromSpecResidueField]
    haveI := hconn _ (W.fromSpecResidueField w ≫ h)
    let I := Limits.pullbackRightPullbackFstIso h g (W.fromSpecResidueField w)
    haveI : ConnectedSpace ↥(Limits.pullback (W.fromSpecResidueField w) (Limits.pullback.fst h g)) :=
      (Scheme.homeoOfIso I.symm).surjective.connectedSpace (Scheme.homeoOfIso I.symm).continuous
    refine ⟨hr ▸ isPreconnected_range
      (Limits.pullback.snd (W.fromSpecResidueField w) (Limits.pullback.fst h g)).continuous, ?_⟩
    obtain ⟨p₀⟩ := ConnectedSpace.toNonempty
      (α := ↥(Limits.pullback (W.fromSpecResidueField w) (Limits.pullback.fst h g)))
    have hp : Limits.pullback.snd (W.fromSpecResidueField w) (Limits.pullback.fst h g) p₀ ∈
        (Limits.pullback.fst h g) ⁻¹' {w} := hr ▸ ⟨p₀, rfl⟩
    exact ⟨_, hp⟩
  have hsurj : Function.Surjective (Limits.pullback.fst h g) := fun w => (hfib w).2
  let f : C(↥(Limits.pullback h g), W) :=
    ⟨Limits.pullback.fst h g, (Limits.pullback.fst h g).continuous⟩
  have hq : Topology.IsQuotientMap f := IsClosedMap.isQuotientMap hcl f.continuous hsurj
  refine ⟨LocallyConstant.comap_injective f hsurj, ?_⟩
  intro φ
  have hconst : ∀ x x', f x = f x' → φ x = φ x' := by
    intro x x' hxx'
    exact φ.apply_eq_of_isPreconnected (hfib (f x)).1 rfl hxx'.symm
  let ψ₀ : W → M := fun y => φ (Function.surjInv hsurj y)
  have hcomp : ∀ x, ψ₀ (f x) = φ x := fun x => hconst _ _ (Function.surjInv_eq hsurj (f x))
  have hloc : IsLocallyConstant ψ₀ := by
    rw [IsLocallyConstant.iff_isOpen_fiber]
    intro m
    have hpre : f ⁻¹' (ψ₀ ⁻¹' {m}) = φ ⁻¹' {m} := by
      ext x
      simp only [Set.mem_preimage, Set.mem_singleton_iff, hcomp]
    exact (hq.isClopen_preimage.mp (hpre ▸ φ.isLocallyConstant.isClopen_fiber m)).isOpen
  refine ⟨⟨ψ₀, hloc⟩, ?_⟩
  ext x
