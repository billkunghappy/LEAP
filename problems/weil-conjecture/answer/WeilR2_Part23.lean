        ((wcEtZModRing T.XEi n).obj.map ((wcEtBaseChange g).map f).op).hom
          ((Dg.φ.hom.app (Opposite.op W2)).hom z) := by
    intro g Dg W1 W2 f z
    exact congrArg (fun k => RingCat.Hom.hom k z) (Dg.φ.hom.naturality f.op)
  have hρc : ∀ {W1 W2 W3 : T.XEi.Etale} (f : W1 ⟶ W2) (g : W2 ⟶ W3)
      (z : ↑((wcEtZModRing T.XEi n).obj.obj (Opposite.op W3))),
      ((wcEtZModRing T.XEi n).obj.map (f ≫ g).op).hom z =
        ((wcEtZModRing T.XEi n).obj.map f.op).hom (((wcEtZModRing T.XEi n).obj.map g.op).hom z) := by
    intro W1 W2 W3 f g z
    rw [op_comp, Functor.map_comp]
    rfl

  have main : ∀ (V : XE.Etale)
      (x : ↑((wcEtZModRing T.XEi n).obj.obj (Opposite.op ((wcEtBaseChange T.πi).obj V)))),
      ((wcEtqmtActN T.hwπ Dπ Dwi Dw hφa).val.app (Opposite.op V)).hom
          (((wcEtqmtGammaN T.hγπ Dπ Dγ hφγ).val.app (Opposite.op V)).hom x) =
        ((wcEtqmtGammaN T.hγπ Dπ Dγ hφγ).val.app (Opposite.op ((wcEtBaseChange w).obj V))).hom
          (((wcEtqmtActN T.hwπ Dπ Dwi Dw hφa).val.app (Opposite.op V)).hom x) := by
    intro V x
    refine (haN V _).trans ?_
    refine (congrArg (fun y => ((wcEtZModRing T.XEi n).obj.map
      ((wcEtqmtBeta T.πi T.wi w T.hwπ).app V).op).hom
        ((Dwi.φ.hom.app (Opposite.op ((wcEtBaseChange T.πi).obj V))).hom y)) (hγN V x)).trans ?_
    refine (congrArg (fun y => ((wcEtZModRing T.XEi n).obj.map
      ((wcEtqmtBeta T.πi T.wi w T.hwπ).app V).op).hom y)
        (hnat Dwi ((wcEtqmtAlpha T.πi T.γi T.hγπ).app V) _)).trans ?_
    refine (congrArg (fun y => ((wcEtZModRing T.XEi n).obj.map
      ((wcEtqmtBeta T.πi T.wi w T.hwπ).app V).op).hom
        (((wcEtZModRing T.XEi n).obj.map
          ((wcEtBaseChange T.wi).map ((wcEtqmtAlpha T.πi T.γi T.hγπ).app V)).op).hom y))
        (hswap ((wcEtBaseChange T.πi).obj V) _)).trans ?_
    refine ((congrArg (fun y => ((wcEtZModRing T.XEi n).obj.map
      ((wcEtqmtBeta T.πi T.wi w T.hwπ).app V).op).hom y)
        (hρc ((wcEtBaseChange T.wi).map ((wcEtqmtAlpha T.πi T.γi T.hγπ).app V))
          ((wcEtqmtBeta T.wi T.γi T.γi hcomm).app ((wcEtBaseChange T.πi).obj V)) _)).symm.trans
        (hρc ((wcEtqmtBeta T.πi T.wi w T.hwπ).app V)
          ((wcEtBaseChange T.wi).map ((wcEtqmtAlpha T.πi T.γi T.hγπ).app V) ≫
            (wcEtqmtBeta T.wi T.γi T.γi hcomm).app ((wcEtBaseChange T.πi).obj V)) _).symm).trans ?_
    refine (congrArg (fun f => ((wcEtZModRing T.XEi n).obj.map (Quiver.Hom.op f)).hom
      ((Dγ.φ.hom.app (Opposite.op ((wcEtBaseChange T.wi).obj ((wcEtBaseChange T.πi).obj V)))).hom
        ((Dwi.φ.hom.app (Opposite.op ((wcEtBaseChange T.πi).obj V))).hom x))) (hex V)).trans ?_
    refine (hρc ((wcEtqmtAlpha T.πi T.γi T.hγπ).app ((wcEtBaseChange w).obj V))
      ((wcEtBaseChange T.γi).map ((wcEtqmtBeta T.πi T.wi w T.hwπ).app V)) _).trans ?_
    refine (congrArg (fun y => ((wcEtZModRing T.XEi n).obj.map
      ((wcEtqmtAlpha T.πi T.γi T.hγπ).app ((wcEtBaseChange w).obj V)).op).hom y)
        (hnat Dγ ((wcEtqmtBeta T.πi T.wi w T.hwπ).app V) _).symm).trans ?_
    refine (congrArg (fun y => ((wcEtZModRing T.XEi n).obj.map
      ((wcEtqmtAlpha T.πi T.γi T.hγπ).app ((wcEtBaseChange w).obj V)).op).hom
        ((Dγ.φ.hom.app (Opposite.op ((wcEtBaseChange T.πi).obj ((wcEtBaseChange w).obj V)))).hom y))
        (haN V x).symm).trans ?_
    exact (hγN ((wcEtBaseChange w).obj V) _).symm
  apply SheafOfModules.hom_ext
  apply PresheafOfModules.hom_ext
  intro X0
  obtain ⟨V⟩ := X0
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  exact main V x

theorem wc_etqmt_sections_dict {A B L : Type u} [CommRing A] [CommRing B] [Field L] {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)] {φA : A →+* L} {σ : L →+* L} {XE : Scheme.{u}}
    {p : XE ⟶ Spec (.of B)} {q : XE ⟶ Spec (.of L)} {w : XE ⟶ XE} {x₀ : B}
    (T : wcQmtmTower ℓ φA σ p q w x₀) (k : ℕ)
    (Dπ : wcEtPullData T.πi (ℓ ^ k)) (Dγ : wcEtPullData T.γi (ℓ ^ k))
    (hφγ : wcEtqmtHPhi T.hγπ Dπ Dγ) :
    ∃ (E0 : ∀ W : XE.Etale, (SheafOfModules.unit (wcEtZModRing XE (ℓ ^ k))).val.obj
          (Opposite.op W) ≃+ LocallyConstant ↥W.left (ZMod (ℓ ^ k)))
      (E : ∀ W : XE.Etale, (wcEtSuppObj Dπ).val.obj (Opposite.op W) ≃+
          LocallyConstant ↥(Limits.pullback W.hom T.πi) (ZMod (ℓ ^ k))),
      (∀ (W W' : XE.Etale) (h : W' ⟶ W) (s : (wcEtSuppObj Dπ).val.obj (Opposite.op W))
          (x : ↥(Limits.pullback W'.hom T.πi)),
        E W' (((wcEtSuppObj Dπ).val.map h.op).hom s) x =
          E W s (((wcEtBaseChange T.πi).map h).left x)) ∧
      (∀ (W : XE.Etale) (t : (SheafOfModules.unit (wcEtZModRing XE (ℓ ^ k))).val.obj
          (Opposite.op W)) (x : ↥(Limits.pullback W.hom T.πi)),
        E W (((wcEtqmtU Dπ).val.app (Opposite.op W)).hom t) x =
          E0 W t (Limits.pullback.fst W.hom T.πi x)) ∧
      (∀ (W : XE.Etale) (s : (wcEtSuppObj Dπ).val.obj (Opposite.op W))
          (κ : Limits.pullback W.hom T.πi ⟶ Limits.pullback W.hom T.πi),
        κ ≫ Limits.pullback.fst W.hom T.πi = Limits.pullback.fst W.hom T.πi →
        κ ≫ Limits.pullback.snd W.hom T.πi = Limits.pullback.snd W.hom T.πi ≫ T.γi →
        ∀ x : ↥(Limits.pullback W.hom T.πi),
          E W (((wcEtqmtGammaN T.hγπ Dπ Dγ hφγ).val.app (Opposite.op W)).hom s) x =
            E W s (κ x)) :=
by
  classical

  have L1 : ∀ {S S' : Scheme.{u}} {g : S' ⟶ S} {n : ℕ} (D : wcEtPullData g n)
      (eS : ∀ V : S.Etale, (wcEtZModRing S n).obj.obj (Opposite.op V) ≃+*
        LocallyConstant V.left (ZMod n))
      (heS : ∀ (V V' : S.Etale) (h : V' ⟶ V) (x : (wcEtZModRing S n).obj.obj (Opposite.op V))
        (y : V'.left), eS V' (((wcEtZModRing S n).obj.map h.op).hom x) y = eS V x (h.left y))
      (eS' : ∀ V : S'.Etale, (wcEtZModRing S' n).obj.obj (Opposite.op V) ≃+*
        LocallyConstant V.left (ZMod n))
      (heS' : ∀ (V V' : S'.Etale) (h : V' ⟶ V) (x : (wcEtZModRing S' n).obj.obj (Opposite.op V))
        (y : V'.left), eS' V' (((wcEtZModRing S' n).obj.map h.op).hom x) y = eS' V x (h.left y))
      (W : S.Etale) (t : (wcEtZModRing S n).obj.obj (Opposite.op W))
      (x : ↥(Limits.pullback W.hom g)),
      eS' ((wcEtBaseChange g).obj W) ((D.φ.hom.app (Opposite.op W)).hom t) x =
        eS W t (Limits.pullback.fst W.hom g x) := by
    intro S S' g n D eS heS eS' heS' W t x
    haveI := D.cont
    have hfst : ∀ (V V' : S.Etale) (h : V' ⟶ V),
        ((wcEtBaseChange g).map h).left ≫ Limits.pullback.fst V.hom g =
          Limits.pullback.fst V'.hom g ≫ h.left := by
      intro V V' h
      unfold wcEtBaseChange
      exact Limits.pullback.lift_fst _ _ _
    let ψ : (wcEtZModRing S n).obj ⟶ (((wcEtBaseChange g).sheafPushforwardContinuous RingCat.{u+1}
        (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S')).obj (wcEtZModRing S' n)).obj :=
      { app := fun V => RingCat.ofHom ((eS' ((wcEtBaseChange g).obj V.unop)).symm.toRingHom.comp
            ((LocallyConstant.comapRingHom ⟨_, (Limits.pullback.fst V.unop.hom g).continuous⟩).comp
              (eS V.unop).toRingHom))
        naturality := by
          rintro ⟨V⟩ ⟨V'⟩ ⟨h⟩
          ext a
          apply (eS' ((wcEtBaseChange g).obj V')).injective
          ext y
          change eS' ((wcEtBaseChange g).obj V') ((eS' ((wcEtBaseChange g).obj V')).symm
              (LocallyConstant.comapRingHom ⟨_, (Limits.pullback.fst V'.hom g).continuous⟩
                (eS V' (((wcEtZModRing S n).obj.map h.op).hom a)))) y =
            eS' ((wcEtBaseChange g).obj V') (((wcEtZModRing S' n).obj.map
              ((wcEtBaseChange g).map h).op).hom ((eS' ((wcEtBaseChange g).obj V)).symm
              (LocallyConstant.comapRingHom ⟨_, (Limits.pullback.fst V.hom g).continuous⟩
                (eS V a)))) y
          rw [heS' ((wcEtBaseChange g).obj V) ((wcEtBaseChange g).obj V') ((wcEtBaseChange g).map h)]
          have k1 := RingEquiv.apply_symm_apply (eS' ((wcEtBaseChange g).obj V'))
            (LocallyConstant.comapRingHom ⟨_, (Limits.pullback.fst V'.hom g).continuous⟩
              (eS V' (((wcEtZModRing S n).obj.map h.op).hom a)))
          have k2 := RingEquiv.apply_symm_apply (eS' ((wcEtBaseChange g).obj V))
            (LocallyConstant.comapRingHom ⟨_, (Limits.pullback.fst V.hom g).continuous⟩ (eS V a))
          refine (DFunLike.congr_fun k1 y).trans (Eq.trans ?_ (DFunLike.congr_fun k2 _).symm)
          change eS V' (((wcEtZModRing S n).obj.map h.op).hom a) (Limits.pullback.fst V'.hom g y) =
            eS V a (Limits.pullback.fst V.hom g (((wcEtBaseChange g).map h).left y))
          rw [heS V V' h]
          congr 1
          exact (Scheme.Hom.comp_apply (Limits.pullback.fst V'.hom g) h.left y).symm.trans
            ((congrArg (fun f => f y) (hfst V V' h)).symm.trans
              (Scheme.Hom.comp_apply ((wcEtBaseChange g).map h).left
                (Limits.pullback.fst V.hom g) y)) }
    have hD : D.φ = ObjectProperty.homMk ψ := wc_et_zmod_ring_hom_ext S n _ _ _
    rw [hD]
    show eS' ((wcEtBaseChange g).obj W) ((eS' ((wcEtBaseChange g).obj W)).symm _) x = _
    rw [RingEquiv.apply_symm_apply]
    rfl

  have L2 : ∀ (W : XE.Etale) (κ : Limits.pullback W.hom T.πi ⟶ Limits.pullback W.hom T.πi),
      κ ≫ Limits.pullback.fst W.hom T.πi = Limits.pullback.fst W.hom T.πi →
      κ ≫ Limits.pullback.snd W.hom T.πi = Limits.pullback.snd W.hom T.πi ≫ T.γi →
      ((wcEtqmtAlpha T.πi T.γi T.hγπ).app W).left ≫
        Limits.pullback.fst (Limits.pullback.snd W.hom T.πi) T.γi = κ := by
    intro W κ h1 h2
    have hα' : ((wcEtqmtAlpha T.πi T.γi T.hγπ).app W).left =
        Limits.pullback.map W.hom T.πi W.hom (T.γi ≫ T.πi) (𝟙 W.left) (𝟙 T.XEi) (𝟙 XE)
          (by simp) (by simp [T.hγπ]) ≫
          (Limits.pullbackLeftPullbackSndIso W.hom T.πi T.γi).inv := by
      letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) T.πi :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) T.πi :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong T.πi)) (@Etale : MorphismProperty Scheme.{u})
      letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) T.γi :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) T.γi :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong T.γi)) (@Etale : MorphismProperty Scheme.{u})
      exact MorphismProperty.Over.pullbackComp_hom_app_left (P := (@Etale : MorphismProperty Scheme.{u}))
        (Q := ⊤) T.γi T.πi T.πi T.hγπ.symm W
    have gen2 : ∀ {P X Z : Scheme.{u}} (a : P ⟶ Z) (f : X ⟶ Z) (γ : X ⟶ X)
        (κ : Limits.pullback a f ⟶ Limits.pullback a f)
        (m : Limits.pullback a f ⟶ Limits.pullback a (γ ≫ f)),
        m ≫ Limits.pullback.fst a (γ ≫ f) = Limits.pullback.fst a f →
        m ≫ Limits.pullback.snd a (γ ≫ f) = Limits.pullback.snd a f →
        κ ≫ Limits.pullback.fst a f = Limits.pullback.fst a f →
        κ ≫ Limits.pullback.snd a f = Limits.pullback.snd a f ≫ γ →
        (m ≫ (Limits.pullbackLeftPullbackSndIso a f γ).inv) ≫
          Limits.pullback.fst (Limits.pullback.snd a f) γ = κ := by
      intro P X Z a f γ κ m hm1 hm2 h1 h2
      apply Limits.pullback.hom_ext
      · rw [h1, Category.assoc, Category.assoc, Limits.pullbackLeftPullbackSndIso_inv_fst, hm1]
      · rw [h2, Category.assoc, Category.assoc, Limits.pullback.condition, ← Category.assoc
          (Limits.pullbackLeftPullbackSndIso a f γ).inv, Limits.pullbackLeftPullbackSndIso_inv_snd_snd,
          ← Category.assoc, hm2]
    rw [hα']
    exact gen2 W.hom T.πi T.γi κ _
      ((Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _))
      ((Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _)) h1 h2

  have L3 : ∀ (W : XE.Etale) (s : (wcEtSuppObj Dπ).val.obj (Opposite.op W)),
      ((wcEtqmtGammaN T.hγπ Dπ Dγ hφγ).val.app (Opposite.op W)).hom s =
        ((wcEtZModRing T.XEi (ℓ ^ k)).obj.map ((wcEtqmtAlpha T.πi T.γi T.hγπ).app W).op).hom
          ((Dγ.φ.hom.app (Opposite.op ((wcEtBaseChange T.πi).obj W))).hom s) := by
    intro W s
    haveI := Dπ.cont
    haveI := Dγ.cont
    simp only [wcEtqmtGammaN, wcEtqmtGamma, SheafOfModules.comp_val, PresheafOfModules.comp_app,
      NatTrans.comp_app]
    erw [ConcreteCategory.comp_apply]

  obtain ⟨eX, heX⟩ := wc_et_zmod_ring_sections_lc_equiv XE (ℓ ^ k)
  obtain ⟨eX', heX'⟩ := wc_et_zmod_ring_sections_lc_equiv T.XEi (ℓ ^ k)
  refine ⟨fun W => (eX W).toAddEquiv,
    fun W => (eX' ((wcEtBaseChange T.πi).obj W)).toAddEquiv, ?_, ?_, ?_⟩
  · intro W W' h s x
    exact heX' _ _ ((wcEtBaseChange T.πi).map h) s x
  · intro W t x
    exact L1 Dπ eX heX eX' heX' W t x
  · intro W s κ h1 h2 x
    show eX' ((wcEtBaseChange T.πi).obj W)
        (((wcEtqmtGammaN T.hγπ Dπ Dγ hφγ).val.app (Opposite.op W)).hom s) x =
      eX' ((wcEtBaseChange T.πi).obj W) s (κ x)
    rw [L3 W s]
    erw [heX' _ _ ((wcEtqmtAlpha T.πi T.γi T.hγπ).app W)]
    erw [L1 Dγ eX' heX' eX' heX' ((wcEtBaseChange T.πi).obj W) s]
    rw [← L2 W κ h1 h2]
    exact congrArg (eX' ((wcEtBaseChange T.πi).obj W) s) (Scheme.Hom.comp_apply _ _ x).symm

theorem wc_etqmt_lc_invariant_factor {A B L : Type u} [CommRing A] [CommRing B] [Field L] {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)] {φA : A →+* L} {σ : L →+* L} {XE : Scheme.{u}}
    {p : XE ⟶ Spec (.of B)} {q : XE ⟶ Spec (.of L)} {w : XE ⟶ XE} {x₀ : B}
    (T : wcQmtmTower ℓ φA σ p q w x₀) {V : Scheme.{u}} (v : V ⟶ XE) (m : ℕ) [NeZero m]
    (F : LocallyConstant ↥(Limits.pullback v T.πi) (ZMod m))
    (hF : ∀ κ : Limits.pullback v T.πi ⟶ Limits.pullback v T.πi,
      κ ≫ Limits.pullback.fst v T.πi = Limits.pullback.fst v T.πi →
      κ ≫ Limits.pullback.snd v T.πi = Limits.pullback.snd v T.πi ≫ T.γi →
      ∀ x, F (κ x) = F x) :
    ∃ f : LocallyConstant ↥V (ZMod m), ∀ x, F x = f (Limits.pullback.fst v T.πi x) :=
by
  classical
  set fst := Limits.pullback.fst v T.πi with hfstdef

  let ι : ZMod m → ULift.{u+1} ℚ_[ℓ] := fun a => ULift.up ((a.val : ℕ) : ℚ_[ℓ])
  have hι : Function.Injective ι := by
    intro a b hab
    have h1 : ((a.val : ℕ) : ℚ_[ℓ]) = ((b.val : ℕ) : ℚ_[ℓ]) := congrArg ULift.down hab
    exact ZMod.val_injective m (Nat.cast_injective h1)
  let s : C(↥(Limits.pullback v T.πi), ULift.{u+1} ℚ_[ℓ]) := (F.map ι).toContinuousMap

  have hs : ∀ κ : Limits.pullback v T.πi ⟶ Limits.pullback v T.πi,
      κ ≫ Limits.pullback.fst v T.πi = Limits.pullback.fst v T.πi →
      κ ≫ Limits.pullback.snd v T.πi = Limits.pullback.snd v T.πi ≫ T.γi →
      s.comp κ.base.hom = s := by
    intro κ h1 h2
    ext1 x
    show ι (F (κ x)) = ι (F x)
    rw [hF κ h1 h2 x]

  obtain ⟨t, hst⟩ := wc_qmtm_invariant_factor T v s hs
  have hpt : ∀ x, ι (F x) = t (fst x) := fun x => by
    have := congrArg (fun g => g x) hst
    exact this

  obtain ⟨_, hsurj, hcl, _⟩ := wc_qmtm_tower_pi_props T
  have hpb := (IsPullback.of_hasPullback v T.πi).flip
  haveI hsf : Surjective fst := MorphismProperty.of_isPullback (P := @Surjective) hpb hsurj
  haveI hcf : UniversallyClosed fst :=
    MorphismProperty.of_isPullback (P := @UniversallyClosed) hpb hcl
  have hsurj' : Function.Surjective fst := fst.surjective
  have hq : Topology.IsQuotientMap fst :=
    IsClosedMap.isQuotientMap fst.isClosedMap fst.continuous hsurj'

  let sec := Function.surjInv hsurj'
  let f₀ : V → ZMod m := fun y => F (sec y)
  have hf₀ : ∀ x, F x = f₀ (fst x) := by
    intro x
    apply hι
    show ι (F x) = ι (F (sec (fst x)))
    rw [hpt, hpt, Function.surjInv_eq hsurj' (fst x)]

  have hlc : IsLocallyConstant f₀ := by
    rw [IsLocallyConstant.iff_isOpen_fiber]
    intro a
    have hco := ((Topology.isQuotientMap_iff _).mp hq).1
    rw [← hco.isOpen_preimage]
    have : (fst : _ → _) ⁻¹' (f₀ ⁻¹' {a}) = F ⁻¹' {a} := by
      ext x
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      rw [hf₀ x]
    rw [this]
    exact F.isLocallyConstant.isOpen_fiber a
  exact ⟨⟨f₀, hlc⟩, fun x => hf₀ x⟩

theorem wc_etqmt_lc_period {A B L : Type u} [CommRing A] [CommRing B] [Field L] {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)] {φA : A →+* L} {σ : L →+* L} {XE : Scheme.{u}}
    {p : XE ⟶ Spec (.of B)} {q : XE ⟶ Spec (.of L)} {w : XE ⟶ XE} {x₀ : B}
    (T : wcQmtmTower ℓ φA σ p q w x₀) {V : Scheme.{u}} [IsAffine V] (v : V ⟶ XE) (m : ℕ)
    (F : LocallyConstant ↥(Limits.pullback v T.πi) (ZMod m))
    (κ : Limits.pullback v T.πi ⟶ Limits.pullback v T.πi)
    (h1 : κ ≫ Limits.pullback.fst v T.πi = Limits.pullback.fst v T.πi)
    (h2 : κ ≫ Limits.pullback.snd v T.πi = Limits.pullback.snd v T.πi ≫ T.γi) :
    ∃ j : ℕ, ∀ x, F ((⇑κ)^[ℓ ^ j] x) = F x :=
by
  classical

  have mono : ∀ {α : Type u} (f : α → α) (x : α) (j j' : ℕ), j ≤ j' →
      f^[ℓ ^ j] x = x → f^[ℓ ^ j'] x = x := fun f x j j' hjj h =>
    Function.IsPeriodicPt.trans_dvd (f := f) (x := x) h (pow_dvd_pow ℓ hjj)

  have L4 : ∀ (X : Scheme.{u}) [IsAffine X] (κ : X ⟶ X) (F : LocallyConstant ↥X (ZMod m)),
      (∀ s : Γ(X, ⊤), ∃ j : ℕ, (⇑κ.appTop.hom)^[ℓ ^ j] s = s) →
      ∃ j : ℕ, ∀ x, F ((⇑κ)^[ℓ ^ j] x) = F x := by
    intro X _ κ F H
    have hclopen : ∀ U : Set X, IsClopen U → ∃ e : Γ(X, ⊤), (X.basicOpen e : Set X) = U := by
      intro U hU
      have hU' : IsClopen ((⇑X.isoSpec.inv) ⁻¹' U) := hU.preimage X.isoSpec.inv.continuous
      obtain ⟨e, -, he⟩ := PrimeSpectrum.isClopen_iff.mp hU'
      refine ⟨e, ?_⟩
      ext x
      have h1 : x ∈ X.basicOpen e ↔ X.toSpecΓ x ∈ PrimeSpectrum.basicOpen e := by
        rw [← Scheme.toSpecΓ_preimage_basicOpen]; rfl
      have h2 : X.isoSpec.inv (X.toSpecΓ x) = x := by
        rw [← Scheme.isoSpec_hom, ← Scheme.Hom.comp_apply, Iso.hom_inv_id]; rfl
      change x ∈ X.basicOpen e ↔ x ∈ U
      rw [h1]
      constructor
      · intro hx
        have h3 : X.toSpecΓ x ∈ (⇑X.isoSpec.inv) ⁻¹' U := by rw [he]; exact hx
        rw [Set.mem_preimage, h2] at h3
        exact h3
      · intro hx
        have h3 : X.toSpecΓ x ∈ (⇑X.isoSpec.inv) ⁻¹' U := by rw [Set.mem_preimage, h2]; exact hx
        rw [he] at h3
        exact h3
    have hstep : ∀ (y : X) (e : Γ(X, ⊤)),
        y ∈ X.basicOpen (κ.appTop.hom e) ↔ κ y ∈ X.basicOpen e := by
      intro y e
      rw [← Scheme.Hom.mem_preimage, Scheme.preimage_basicOpen_top]
    have hiter : ∀ (n : ℕ) (e : Γ(X, ⊤)) (x : X),
        x ∈ X.basicOpen ((⇑κ.appTop.hom)^[n] e) ↔ (⇑κ)^[n] x ∈ X.basicOpen e := by
      intro n
      induction n with
      | zero => intro e x; rfl
      | succ n ih =>
        intro e x
        rw [Function.iterate_succ_apply, ih, hstep, Function.iterate_succ_apply']
    have hfib : ∀ y : ZMod m, ∃ e : Γ(X, ⊤), (X.basicOpen e : Set X) = {x | F x = y} := fun y =>
      hclopen _ (IsLocallyConstant.isClopen_fiber F.isLocallyConstant y)
    choose e he using hfib
    choose j hj using fun y => H (e y)
    have hfin := F.range_finite
    refine ⟨hfin.toFinset.sup j, fun x => ?_⟩
    have hper : (⇑κ.appTop.hom)^[ℓ ^ (hfin.toFinset.sup j)] (e (F x)) = e (F x) :=
      Function.IsPeriodicPt.trans_dvd (hj (F x))
        (pow_dvd_pow ℓ (Finset.le_sup (hfin.mem_toFinset.mpr ⟨x, rfl⟩)))
    have hx : x ∈ (X.basicOpen (e (F x)) : Set X) := by rw [he]; rfl
    have hx' : x ∈ X.basicOpen ((⇑κ.appTop.hom)^[ℓ ^ (hfin.toFinset.sup j)] (e (F x))) := by
      rw [hper]; exact hx
    rw [hiter] at hx'
    have hx'' : (⇑κ)^[ℓ ^ (hfin.toFinset.sup j)] x ∈ (X.basicOpen (e (F x)) : Set X) := hx'
    rw [he] at hx''
    exact hx''

  have GEN : ∀ {X V Y S : Scheme.{u}} [IsAffine V] [IsAffine Y] [IsAffine S] {a : X ⟶ V}
      {b : X ⟶ Y} {f : V ⟶ S} {g : Y ⟶ S}, IsPullback a b f g → ∀ (C : Subring Γ(X, ⊤)),
      (∀ z, a.appTop.hom z ∈ C) → (∀ z, b.appTop.hom z ∈ C) → ∀ s, s ∈ C := by
    intro X V Y S _ _ _ a b f g h C ha hb s
    let α : Γ(V, ⊤) ⟶ CommRingCat.of C := CommRingCat.ofHom (a.appTop.hom.codRestrict C ha)
    let β : Γ(Y, ⊤) ⟶ CommRingCat.of C := CommRingCat.ofHom (b.appTop.hom.codRestrict C hb)
    let ι : CommRingCat.of C ⟶ Γ(X, ⊤) := CommRingCat.ofHom C.subtype
    have hαι : α ≫ ι = a.appTop := by ext z; rfl
    have hβι : β ≫ ι = b.appTop := by ext z; rfl
    have hfg : f.appTop ≫ α = g.appTop ≫ β := by
      ext z
      change (f.appTop ≫ a.appTop).hom z = (g.appTop ≫ b.appTop).hom z
      rw [← Scheme.Hom.comp_appTop, ← Scheme.Hom.comp_appTop, h.w]
    have w : (Spec.map α ≫ V.isoSpec.inv) ≫ f = (Spec.map β ≫ Y.isoSpec.inv) ≫ g := by
      rw [Category.assoc, Category.assoc, ← Scheme.isoSpec_inv_naturality,
        ← Scheme.isoSpec_inv_naturality, ← Category.assoc, ← Category.assoc, ← Spec.map_comp,
        ← Spec.map_comp, hfg]
    let Lf := h.lift _ _ w
    have hid : X.toSpecΓ ≫ Spec.map ι ≫ Lf = 𝟙 X := by
      apply h.hom_ext
      · rw [Category.assoc, Category.assoc, h.lift_fst, ← Category.assoc (Spec.map ι),
          ← Spec.map_comp, hαι, ← Category.assoc, ← Scheme.toSpecΓ_naturality, Category.assoc,
          ← Scheme.isoSpec_hom, Iso.hom_inv_id, Category.comp_id, Category.id_comp]
      · rw [Category.assoc, Category.assoc, h.lift_snd, ← Category.assoc (Spec.map ι),
          ← Spec.map_comp, hβι, ← Category.assoc, ← Scheme.toSpecΓ_naturality, Category.assoc,
          ← Scheme.isoSpec_hom, Iso.hom_inv_id, Category.comp_id, Category.id_comp]
    have key : (Lf.appTop ≫ (Scheme.ΓSpecIso (CommRingCat.of C)).hom) ≫ ι = 𝟙 Γ(X, ⊤) := by
      have e := congrArg Scheme.Hom.appTop hid
      rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop, Scheme.toSpecΓ_appTop,
        Scheme.Hom.id_appTop, Category.assoc, Scheme.ΓSpecIso_naturality] at e
      rw [Category.assoc]
      exact e
    have hs : (((Lf.appTop ≫ (Scheme.ΓSpecIso (CommRingCat.of C)).hom).hom s : C) :
        Γ(X, ⊤)) = s := by
      have := congrArg (fun φ => φ.hom s) key
      exact this
    rw [← hs]
    exact Subtype.prop _

  have hpb := IsPullback.paste_vert (IsPullback.of_hasPullback v T.πi) T.hT
  haveI : IsAffineHom (Limits.pullback.fst v T.πi) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) hpb.flip inferInstance
  haveI : IsAffine (Limits.pullback v T.πi) :=
    isAffine_of_isAffineHom (Limits.pullback.fst v T.πi)

  let Per : Subring Γ(Limits.pullback v T.πi, ⊤) :=
    { carrier := {x | ∃ j : ℕ, (⇑κ.appTop.hom)^[ℓ ^ j] x = x}
      mul_mem' := fun {a b} ha hb => by
        obtain ⟨ja, hja⟩ := ha
        obtain ⟨jb, hjb⟩ := hb
        exact ⟨max ja jb, by
          rw [iterate_map_mul, mono _ a ja _ (le_max_left _ _) hja,
            mono _ b jb _ (le_max_right _ _) hjb]⟩
      one_mem' := ⟨0, iterate_map_one _ _⟩
      add_mem' := fun {a b} ha hb => by
        obtain ⟨ja, hja⟩ := ha
        obtain ⟨jb, hjb⟩ := hb
        exact ⟨max ja jb, by
          rw [iterate_map_add, mono _ a ja _ (le_max_left _ _) hja,
            mono _ b jb _ (le_max_right _ _) hjb]⟩
      zero_mem' := ⟨0, iterate_map_zero _ _⟩
      neg_mem' := fun {a} ha => by
        obtain ⟨j, hj⟩ := ha
        exact ⟨j, by rw [iterate_map_neg, hj]⟩ }

  have ha : ∀ z, (Limits.pullback.fst v T.πi).appTop.hom z ∈ Per := by
    intro z
    refine ⟨0, ?_⟩
    rw [pow_zero, Function.iterate_one]
    change ((Limits.pullback.fst v T.πi).appTop ≫ κ.appTop).hom z = _
    rw [← Scheme.Hom.comp_appTop, h1]

  have hγper : ∀ g : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)),
      ∃ k : ℕ, (⇑T.γR)^[ℓ ^ k] g = g := by
    intro g
    induction g using AddMonoidAlgebra.induction_linear with
    | zero => exact ⟨0, iterate_map_zero _ _⟩
    | add g₁ g₂ ih₁ ih₂ =>
      obtain ⟨k₁, hk₁⟩ := ih₁
      obtain ⟨k₂, hk₂⟩ := ih₂
      exact ⟨max k₁ k₂, by
        rw [iterate_map_add, mono _ g₁ k₁ _ (le_max_left _ _) hk₁,
          mono _ g₂ k₂ _ (le_max_right _ _) hk₂]⟩
    | single y c =>
      have hit : ∀ n : ℕ, (⇑T.γR)^[n] (AddMonoidAlgebra.single y c) =
          AddMonoidAlgebra.single y (((T.χ (Multiplicative.ofAdd y) : Lˣ) : L) ^ n * c) := by
        intro n
        induction n with
        | zero => rw [Function.iterate_zero_apply, pow_zero, one_mul]
        | succ n ih => rw [Function.iterate_succ_apply', ih, T.hγR, pow_succ', mul_assoc]
      induction y using Localization.induction_on with
      | H y =>
        obtain ⟨a, s⟩ := y
        obtain ⟨k, hk⟩ := s.2
        have hs : s = ⟨(ℓ : ℤ) ^ k, k, rfl⟩ := Subtype.ext hk.symm
        subst hs
        refine ⟨k, ?_⟩
        rw [hit, T.hχ]
        have hone : (T.ζ k ^ a) ^ (ℓ ^ k) = 1 := by
          rw [← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul, zpow_natCast,
            (T.hζ k).pow_eq_one, one_zpow]
        rw [hone, one_mul]
  have hsq : κ ≫ (Limits.pullback.snd v T.πi ≫ T.gi) =
      (Limits.pullback.snd v T.πi ≫ T.gi) ≫ Spec.map (CommRingCat.ofHom T.γR) := by
    rw [← Category.assoc, h2, Category.assoc, T.hγg, Category.assoc]
  have hsemi1 : ∀ y, κ.appTop.hom ((Limits.pullback.snd v T.πi ≫ T.gi).appTop.hom y) =
      (Limits.pullback.snd v T.πi ≫ T.gi).appTop.hom
        ((Spec.map (CommRingCat.ofHom T.γR)).appTop.hom y) := by
    intro y
    change ((Limits.pullback.snd v T.πi ≫ T.gi).appTop ≫ κ.appTop).hom y =
      ((Spec.map (CommRingCat.ofHom T.γR)).appTop ≫
        (Limits.pullback.snd v T.πi ≫ T.gi).appTop).hom y
    rw [← Scheme.Hom.comp_appTop, ← Scheme.Hom.comp_appTop, hsq]
  have hnat : ∀ g : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)),
      (Spec.map (CommRingCat.ofHom T.γR)).appTop.hom
        ((Scheme.ΓSpecIso (CommRingCat.of (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))).inv.hom g) =
      (Scheme.ΓSpecIso (CommRingCat.of (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))).inv.hom
        (T.γR g) := by
    intro g
    have := congrArg (fun φ => φ.hom g) (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom T.γR))
    exact this.symm
  have hΨ : Function.Semiconj
      (fun g => (Limits.pullback.snd v T.πi ≫ T.gi).appTop.hom
        ((Scheme.ΓSpecIso (CommRingCat.of (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))).inv.hom g))
      T.γR κ.appTop.hom := by
    intro g
    show _ = κ.appTop.hom _
    rw [hsemi1, hnat]
  have hb : ∀ z, (Limits.pullback.snd v T.πi ≫ T.gi).appTop.hom z ∈ Per := by
    intro z
    have hz : (Scheme.ΓSpecIso (CommRingCat.of (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))).inv.hom
        ((Scheme.ΓSpecIso (CommRingCat.of (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))).hom.hom z)
        = z := by
      have := congrArg (fun φ => φ.hom z)
        (Scheme.ΓSpecIso (CommRingCat.of (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))).hom_inv_id
      exact this
    obtain ⟨k, hk⟩ := hγper
      ((Scheme.ΓSpecIso (CommRingCat.of (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))).hom.hom z)
    refine ⟨k, ?_⟩
    rw [← hz]
    have e := hΨ.iterate_right (ℓ ^ k)
      ((Scheme.ΓSpecIso (CommRingCat.of (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))).hom.hom z)
    simp only at e
    rw [← e, hk]
  have hall := GEN hpb Per ha hb
  exact L4 _ κ F hall

theorem wc_etqmt_kummer_root_cover {A B L : Type u} [CommRing A] [CommRing B] [Field L] {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)] {φA : A →+* L} {σ : L →+* L} {XE : Scheme.{u}}
    {p : XE ⟶ Spec (.of B)} {q : XE ⟶ Spec (.of L)} {w : XE ⟶ XE} {x₀ : B}
    (T : wcQmtmTower ℓ φA σ p q w x₀) {V : Scheme.{u}} [IsAffine V] (v : V ⟶ XE) (M : ℕ) :
    ∃ (V' : Scheme.{u}) (e : V' ⟶ V), Etale e ∧ Surjective e ∧
      ∃ r : Γ(V', ⊤), r ^ (ℓ ^ M) = (e ≫ v ≫ T.g₀).appTop.hom
        ((Scheme.ΓSpecIso (CommRingCat.of (LaurentPolynomial L))).inv.hom
          (LaurentPolynomial.T 1)) :=
by
  classical

  have hN : 0 < ℓ ^ M := pow_pos (Fact.out : ℓ.Prime).pos M
  haveI : NeZero (ℓ ^ M) := ⟨pow_ne_zero _ (Fact.out : ℓ.Prime).ne_zero⟩
  have hNL : ((ℓ ^ M : ℕ) : L) ≠ 0 := ((T.hζ M).neZero').out
  let cL : L →+* Γ(V, ⊤) :=
    ((v ≫ q).appTop).hom.comp (Scheme.ΓSpecIso (CommRingCat.of L)).inv.hom
  have hNR : IsUnit ((ℓ ^ M : ℕ) : Γ(V, ⊤)) := by
    rw [← map_natCast cL]; exact (Ne.isUnit hNL).map cL
  set y : Γ(V, ⊤) := (v ≫ T.g₀).appTop.hom
    ((Scheme.ΓSpecIso (CommRingCat.of (LaurentPolynomial L))).inv.hom
      (LaurentPolynomial.T 1)) with hydef
  have hy : IsUnit y :=
    ((LaurentPolynomial.isUnit_T 1).map
      (Scheme.ΓSpecIso (CommRingCat.of (LaurentPolynomial L))).inv.hom).map
      (v ≫ T.g₀).appTop.hom

  have kummer : ∀ (m : ℕ), 0 < m → ∀ (R : Type u) [CommRing R], IsUnit ((m : ℕ) : R) →
      ∀ y : Rˣ, ∃ (Bk : Type u) (_ : CommRing Bk) (_ : Algebra R Bk), Algebra.Etale R Bk ∧
        Function.Surjective (PrimeSpectrum.comap (algebraMap R Bk)) ∧
        ∃ x : Bk, x ^ m = algebraMap R Bk (y : R) := by
    intro m hm R _ hmR y
    have hm0 : m ≠ 0 := Nat.pos_iff_ne_zero.mp hm
    set f : Polynomial R := Polynomial.X ^ m - Polynomial.C (y : R) with hf
    have hfm : f.Monic := Polynomial.monic_X_pow_sub_C (y : R) hm0
    obtain ⟨u, hu⟩ := (hmR.mul y.isUnit).exists_left_inv
    have hcert : ∃ (p₁ p₂ : Polynomial R) (n : ℕ),
        Polynomial.derivative f * p₁ + f * p₂ = (1 : Polynomial R) ^ n := by
      refine ⟨Polynomial.C u * Polynomial.X, -(Polynomial.C u * Polynomial.C (m : R)), 1, ?_⟩
      have hd : Polynomial.derivative f = Polynomial.C (m : R) * Polynomial.X ^ (m - 1) := by
        rw [hf, Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C,
          sub_zero]
      have hX : Polynomial.X ^ (m - 1) * Polynomial.X = (Polynomial.X : Polynomial R) ^ m :=
        pow_sub_one_mul hm0 Polynomial.X
      have hu' : Polynomial.C u * (Polynomial.C (m : R) * Polynomial.C (y : R)) = 1 := by
        rw [← map_mul, ← map_mul, hu, map_one]
      rw [hd, hf, pow_one]
      linear_combination hu' + (Polynomial.C u * Polynomial.C (m : R)) * hX
    let P : StandardEtalePair R := ⟨f, hfm, 1, hcert⟩
    have e₂ : AdjoinRoot f ≃ₐ[R] Localization.Away ((AdjoinRoot.mk f) 1) :=
      (IsLocalization.atUnit (AdjoinRoot f) (Localization.Away ((AdjoinRoot.mk f) 1))
        ((AdjoinRoot.mk f) 1) (by simp)).restrictScalars R
    have e : P.Ring ≃ₐ[R] AdjoinRoot f := P.equivAwayAdjoinRoot.trans e₂.symm
    have het : Algebra.Etale R (AdjoinRoot f) := Algebra.Etale.of_equiv e
    refine ⟨AdjoinRoot f, inferInstance, inferInstance, het, ?_, AdjoinRoot.root f, ?_⟩
    · rcases subsingleton_or_nontrivial R with hR | hR
      · have : IsEmpty (PrimeSpectrum R) := PrimeSpectrum.isEmpty_iff_subsingleton.mpr hR
        intro x
        exact isEmptyElim x
      · have : Module.Free R (AdjoinRoot f) := hfm.free_adjoinRoot
        let pb := AdjoinRoot.powerBasis' hfm
        have hdim : 0 < pb.dim := by
          rw [AdjoinRoot.powerBasis'_dim, hf, Polynomial.natDegree_X_pow_sub_C]
          exact hm
        have : Nontrivial (AdjoinRoot f) := nontrivial_of_ne _ _ (pb.basis.ne_zero ⟨0, hdim⟩)
        exact PrimeSpectrum.comap_surjective_of_faithfullyFlat
    · have h1 : Polynomial.aeval (AdjoinRoot.root f) f = 0 := by
        rw [AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]
      rw [hf, map_sub, Polynomial.aeval_X_pow, Polynomial.aeval_C] at h1
      exact sub_eq_zero.mp h1
  obtain ⟨Bk, _, _, hBet, hBsurj, x, hx⟩ := kummer (ℓ ^ M) hN Γ(V, ⊤) hNR hy.unit
  rw [IsUnit.unit_spec] at hx

  let φ : CommRingCat.of Γ(V, ⊤) ⟶ CommRingCat.of Bk :=
    CommRingCat.ofHom (algebraMap Γ(V, ⊤) Bk)
  let g : Spec (CommRingCat.of Bk) ⟶ Spec (CommRingCat.of Γ(V, ⊤)) := Spec.map φ
  haveI hgE : Etale g := by
    apply (HasRingHomProperty.Spec_iff (P := @Etale)).mpr
    rw [CommRingCat.hom_ofHom]
    exact RingHom.etale_algebraMap.mpr hBet
  haveI hgS : Surjective g := by
    constructor
    exact hBsurj
  refine ⟨Limits.pullback V.toSpecΓ g, Limits.pullback.fst V.toSpecΓ g, inferInstance,
    inferInstance, ((Scheme.ΓSpecIso (CommRingCat.of Bk)).inv ≫
      (Limits.pullback.snd V.toSpecΓ g).appTop).hom x, ?_⟩
  have hc : V.toSpecΓ.appTop ≫ (Limits.pullback.fst V.toSpecΓ g).appTop =
      g.appTop ≫ (Limits.pullback.snd V.toSpecΓ g).appTop := by
    rw [← Scheme.Hom.comp_appTop, ← Scheme.Hom.comp_appTop, Limits.pullback.condition]
  have hn := Scheme.ΓSpecIso_inv_naturality φ
  have key : φ ≫ (Scheme.ΓSpecIso (CommRingCat.of Bk)).inv ≫
      (Limits.pullback.snd V.toSpecΓ g).appTop = (Limits.pullback.fst V.toSpecΓ g).appTop := by
    rw [← Category.assoc, hn, Category.assoc, ← hc, Scheme.toSpecΓ_appTop]
    exact Iso.inv_hom_id_assoc _ _
  have hψ : ∀ r : Γ(V, ⊤), ((Scheme.ΓSpecIso (CommRingCat.of Bk)).inv ≫
      (Limits.pullback.snd V.toSpecΓ g).appTop).hom (algebraMap Γ(V, ⊤) Bk r) =
      (Limits.pullback.fst V.toSpecΓ g).appTop.hom r :=
    fun r => congrArg (fun h => h.hom r) key
  rw [← map_pow, hx, hψ y, hydef, Scheme.Hom.comp_appTop]
  rfl

theorem wc_etqmt_level_coordinate_of_root {A B L : Type u} [CommRing A] [CommRing B] [Field L]
    {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {φA : A →+* L} {σ : L →+* L} {XE : Scheme.{u}}
    {p : XE ⟶ Spec (.of B)} {q : XE ⟶ Spec (.of L)} {w : XE ⟶ XE} {x₀ : B}
    (T : wcQmtmTower ℓ φA σ p q w x₀) {V : Scheme.{u}} (v : V ⟶ XE) (M : ℕ) (r : Γ(V, ⊤))
    (hr : r ^ (ℓ ^ M) = (v ≫ T.g₀).appTop.hom
      ((Scheme.ΓSpecIso (CommRingCat.of (LaurentPolynomial L))).inv.hom
        (LaurentPolynomial.T 1))) :
    ∃ c : LocallyConstant ↥(Limits.pullback v T.πi) (ZMod (ℓ ^ M)),
      ∀ κ : Limits.pullback v T.πi ⟶ Limits.pullback v T.πi,
        κ ≫ Limits.pullback.fst v T.πi = Limits.pullback.fst v T.πi →
        κ ≫ Limits.pullback.snd v T.πi = Limits.pullback.snd v T.πi ≫ T.γi →
        ∀ x, c (κ x) = c x + 1 :=
by
  classical
  have hk1 : ∀ {P : Scheme.{u}} (N : ℕ) (hN : 0 < N) (lam : L →+* Γ(P, ⊤))
      (ζ : L) (hζ : IsPrimitiveRoot ζ N) (y₁ y₂ : Γ(P, ⊤)) (hy₁ : IsUnit y₁)
      (hy : y₂ ^ N = y₁ ^ N),
      ∃ c : LocallyConstant ↥P (ZMod N), ∀ κ : P ⟶ P, κ.appTop.hom y₁ = y₁ →
        κ.appTop.hom y₂ = lam ζ * y₂ → κ.appTop.hom (lam ζ) = lam ζ →
        ∀ x, c (κ x) = c x + 1 := by
    intro P N hN lam ζ hζ y₁ y₂ hy₁ hy
    classical
    have : NeZero N := ⟨hN.ne'⟩
    obtain ⟨f, hf⟩ : ∃ f : ℕ → Γ(P, ⊤), ∀ j, f j = y₂ - lam ζ ^ j * y₁ := ⟨_, fun j => rfl⟩
    have hζN : lam ζ ^ N = 1 := by rw [← map_pow, hζ.pow_eq_one, map_one]
    have hpowmod : ∀ j, lam ζ ^ j = lam ζ ^ (j % N) := by
      intro j
      conv_lhs => rw [← Nat.mod_add_div j N, pow_add, pow_mul, hζN, one_pow, mul_one]
    have hunit : IsUnit (lam ζ) := (hζ.isUnit hN.ne').map lam
    have hev : ∀ (x : P) (g : Γ(P, ⊤)), (P.evaluation ⊤ x trivial).hom g ≠ 0 ↔ x ∈ P.basicOpen g :=
      fun x g => P.evaluation_ne_zero_iff_mem_basicOpen (U := ⊤) x trivial g
    have hprim : ∀ x : P, IsPrimitiveRoot ((P.evaluation ⊤ x trivial).hom (lam ζ)) N := fun x =>
      hζ.map_of_injective (f := ((P.evaluation ⊤ x trivial).hom).comp lam) (RingHom.injective _)
    have ha : ∀ x : P, (P.evaluation ⊤ x trivial).hom y₁ ≠ 0 := fun x =>
      (hy₁.map (P.evaluation ⊤ x trivial).hom).ne_zero
    have hzero : ∀ (x : P) (j : ℕ), x ∉ P.basicOpen (f j) ↔
        (P.evaluation ⊤ x trivial).hom y₂ =
          (P.evaluation ⊤ x trivial).hom (lam ζ) ^ j * (P.evaluation ⊤ x trivial).hom y₁ := by
      intro x j
      rw [← hev, not_not, hf, map_sub, map_mul, map_pow, sub_eq_zero]
    have hex : ∀ x : P, ∃ i : ℕ, x ∉ P.basicOpen (f i) := by
      intro x
      have e := congrArg (P.evaluation ⊤ x trivial).hom hy
      rw [map_pow, map_pow] at e
      have h1 : ((P.evaluation ⊤ x trivial).hom y₂ * ((P.evaluation ⊤ x trivial).hom y₁)⁻¹) ^ N = 1 := by
        rw [mul_pow, inv_pow, e, mul_inv_cancel₀ (pow_ne_zero _ (ha x))]
      obtain ⟨i, -, hzi⟩ := (hprim x).eq_pow_of_pow_eq_one h1
      refine ⟨i, (hzero x i).2 ?_⟩
      rw [hzi, inv_mul_cancel_right₀ (ha x)]
    have huniq : ∀ (x : P) (i j : ℕ), x ∉ P.basicOpen (f i) → x ∉ P.basicOpen (f j) →
        (i : ZMod N) = j := by
      intro x i j hi hj
      rw [hzero] at hi hj
      have h := mul_right_cancel₀ (ha x) (hi.symm.trans hj)
      have hm : ∀ k, (P.evaluation ⊤ x trivial).hom (lam ζ) ^ k =
          (P.evaluation ⊤ x trivial).hom (lam ζ) ^ (k % N) := by
        intro k
        simpa only [map_pow] using congrArg (P.evaluation ⊤ x trivial).hom (hpowmod k)
      rw [hm i, hm j] at h
      rw [ZMod.natCast_eq_natCast_iff]
      exact (hprim x).pow_inj (Nat.mod_lt _ hN) (Nat.mod_lt _ hN) h
    choose idx hidx using hex
    have H : ∀ (x : P) (j : ℕ), x ∉ P.basicOpen (f j) → ((idx x : ℕ) : ZMod N) = j :=
      fun x j hj => huniq x _ _ (hidx x) hj
    have hlc : IsLocallyConstant (fun x : P => ((idx x : ℕ) : ZMod N)) := by
      rw [IsLocallyConstant.iff_exists_open]
      intro x
      refine ⟨⋂ i ∈ ((Finset.range N).filter (fun i : ℕ => ((i : ℕ) : ZMod N) ≠ ((idx x : ℕ) : ZMod N)) : Finset ℕ),
        (P.basicOpen (f i) : Set P), ?_, ?_, ?_⟩
      · exact isOpen_biInter_finset (fun i _ => (P.basicOpen (f i)).isOpen)
      · refine Set.mem_iInter₂.2 (fun i hi => ?_)
        by_contra hc
        exact (Finset.mem_filter.1 hi).2 (H x i hc).symm
      · intro x' hx'
        by_contra hne
        have hlt : idx x' % N < N := Nat.mod_lt _ hN
        have hcast : ((idx x' % N : ℕ) : ZMod N) = ((idx x' : ℕ) : ZMod N) := ZMod.natCast_mod _ _
        have hmem := Set.mem_iInter₂.1 hx' (idx x' % N)
          (Finset.mem_filter.2 ⟨Finset.mem_range.2 hlt, by rw [hcast]; exact hne⟩)
        have hfm : f (idx x' % N) = f (idx x') := by rw [hf, hf, ← hpowmod]
        rw [hfm] at hmem
        exact hidx x' hmem
    refine ⟨⟨fun x => ((idx x : ℕ) : ZMod N), hlc⟩, ?_⟩
    intro κ h1 h2 h3 x
    show ((idx (κ x) : ℕ) : ZMod N) = ((idx x : ℕ) : ZMod N) + 1
    have hκf : κ.appTop.hom (f (idx x + 1)) = lam ζ * f (idx x) := by
      rw [hf, hf, map_sub, map_mul, map_pow, h1, h2, h3]
      ring
    have hmem : κ x ∉ P.basicOpen (f (idx x + 1)) := by
      intro hk
      have hx : x ∈ κ ⁻¹ᵁ P.basicOpen (f (idx x + 1)) := (Scheme.Hom.mem_preimage κ).2 hk
      rw [Scheme.preimage_basicOpen_top, hκf, Scheme.basicOpen_mul,
        Scheme.basicOpen_of_isUnit _ hunit, top_inf_eq] at hx
      exact hidx x hx
    rw [H (κ x) _ hmem, Nat.cast_add, Nat.cast_one]
  have hk2 : ∃ (lam : L →+* Γ(Limits.pullback v T.πi, ⊤)) (y₁ y₂ : Γ(Limits.pullback v T.πi, ⊤)),
      IsUnit y₁ ∧ y₂ ^ (ℓ ^ M) = y₁ ^ (ℓ ^ M) ∧
      ∀ κ : Limits.pullback v T.πi ⟶ Limits.pullback v T.πi,
        κ ≫ Limits.pullback.fst v T.πi = Limits.pullback.fst v T.πi →
        κ ≫ Limits.pullback.snd v T.πi = Limits.pullback.snd v T.πi ≫ T.γi →
        κ.appTop.hom y₁ = y₁ ∧ κ.appTop.hom y₂ = lam (T.ζ M) * y₂ ∧
          κ.appTop.hom (lam (T.ζ M)) = lam (T.ζ M) := by
    classical

    have htr : ∀ {X : Scheme.{u}} {R R' : CommRingCat.{u}} (u : X ⟶ Spec R) (φ : R' ⟶ R) (t : R'),
        u.appTop.hom ((Scheme.ΓSpecIso R).inv.hom (φ.hom t)) =
          (u ≫ Spec.map φ).appTop.hom ((Scheme.ΓSpecIso R').inv.hom t) := by
      intro X R R' u φ t
      have e := congrArg (fun h => h.hom t) (Scheme.ΓSpecIso_inv_naturality φ)
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e
      rw [e, Scheme.Hom.comp_appTop]
      rfl
    have hcomp : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (a : Γ(Z, ⊤)),
        (f ≫ g).appTop.hom a = f.appTop.hom (g.appTop.hom a) := by
      intro X Y Z f g a
      rw [Scheme.Hom.comp_appTop]; rfl
    set s₀ := Limits.pullback.snd v T.πi ≫ T.gi with hs₀
    set Θ : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) →+* Γ(Limits.pullback v T.πi, ⊤) :=
      s₀.appTop.hom.comp (Scheme.ΓSpecIso
        (CommRingCat.of (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))).inv.hom with hΘ
    set e : Localization.Away (ℓ : ℤ) := Localization.mk (1 : ℤ) ⟨(ℓ : ℤ) ^ M, M, rfl⟩ with he
    have hNe : (ℓ ^ M : ℕ) • e = 1 := by
      rw [he, nsmul_eq_mul, Localization.mk_eq_mk',
        ← map_natCast (algebraMap ℤ (Localization.Away (ℓ:ℤ))), mul_comm]
      have := IsLocalization.mk'_spec (Localization.Away (ℓ:ℤ)) (1 : ℤ)
        (⟨(ℓ : ℤ) ^ M, M, rfl⟩ : Submonoid.powers (ℓ : ℤ))
      rw [map_one] at this
      convert this using 3
      push_cast; rfl
    refine ⟨Θ.comp AddMonoidAlgebra.singleZeroRingHom, (Limits.pullback.fst v T.πi).appTop.hom r,
      Θ (AddMonoidAlgebra.single e 1), ?_, ?_, ?_⟩
    ·
      have hN0 : ℓ ^ M ≠ 0 := pow_ne_zero _ (Nat.Prime.ne_zero Fact.out)
      have h1 : IsUnit (r ^ (ℓ ^ M)) := by
        rw [hr]
        exact ((LaurentPolynomial.isUnit_T 1).map _).map _
      exact ((isUnit_pow_iff hN0).1 h1).map _
    ·
      rw [← map_pow, AddMonoidAlgebra.single_pow, one_pow, hNe, ← map_pow, hr, ← hcomp]
      have hψ : (AddMonoidAlgebra.single (1 : Localization.Away (ℓ : ℤ)) (1 : L)) =
          (CommRingCat.ofHom (AddMonoidAlgebra.mapDomainRingHom L
            (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom)).hom
            (LaurentPolynomial.T 1) := by
        rw [CommRingCat.hom_ofHom, AddMonoidAlgebra.mapDomainRingHom_apply]
        show _ = AddMonoidAlgebra.mapDomain _ (AddMonoidAlgebra.single (1 : ℤ) (1 : L))
        rw [AddMonoidAlgebra.mapDomain_single]
        simp
      rw [hΘ, RingHom.comp_apply, hψ, htr, hs₀, Category.assoc, ← T.hT.w, ← Category.assoc,
        ← Limits.pullback.condition, Category.assoc]
    · intro κ h1 h2
      have hκs : κ ≫ s₀ = s₀ ≫ Spec.map (CommRingCat.ofHom T.γR) := by
        rw [hs₀, ← Category.assoc, h2, Category.assoc, T.hγg, Category.assoc]
      have hκΘ : ∀ g, κ.appTop.hom (Θ g) = Θ (T.γR g) := by
        intro g
        rw [hΘ, RingHom.comp_apply, RingHom.comp_apply, ← hcomp, hκs,
          show T.γR g = (CommRingCat.ofHom T.γR).hom g from rfl, htr]
      refine ⟨?_, ?_, ?_⟩
      · rw [← hcomp, h1]
      · rw [hκΘ]
        show Θ (T.γR (AddMonoidAlgebra.single e 1)) =
          Θ (AddMonoidAlgebra.singleZeroRingHom (T.ζ M)) * Θ (AddMonoidAlgebra.single e 1)
        rw [← map_mul Θ]
        congr 1
        rw [T.hγR, mul_one, AddMonoidAlgebra.singleZeroRingHom_apply]
        show _ = AddMonoidAlgebra.single 0 (T.ζ M) * AddMonoidAlgebra.single e 1
        rw [AddMonoidAlgebra.single_mul_single, zero_add, mul_one, he, T.hχ 1 M, zpow_one]
      · show κ.appTop.hom (Θ (AddMonoidAlgebra.singleZeroRingHom (T.ζ M))) =
          Θ (AddMonoidAlgebra.singleZeroRingHom (T.ζ M))
        rw [hκΘ]
        congr 1
        rw [AddMonoidAlgebra.singleZeroRingHom_apply]
        show T.γR (AddMonoidAlgebra.single 0 (T.ζ M)) = AddMonoidAlgebra.single 0 (T.ζ M)
        rw [T.hγR, ofAdd_zero, map_one, Units.val_one, one_mul]
  obtain ⟨lam, y₁, y₂, hu, hp, hdeck⟩ := hk2
  obtain ⟨c, hc⟩ := hk1 (P := Limits.pullback v T.πi) (ℓ ^ M)
    (pow_pos (Fact.out : ℓ.Prime).pos M) lam (T.ζ M) (T.hζ M) y₁ y₂ hu hp
  refine ⟨c, fun κ h1 h2 x => ?_⟩
  obtain ⟨a, b, d⟩ := hdeck κ h1 h2
  exact hc κ a b d x

theorem wc_etqmt_antidiff_comb {X : Type*} [TopologicalSpace X] (ℓ j k : ℕ) (hℓ : 0 < ℓ)
    (κ : X → X) (hκ : Continuous κ) (F : LocallyConstant X (ZMod (ℓ ^ k)))
    (hF : ∀ x, F (κ^[ℓ ^ j] x) = F x) (c : LocallyConstant X (ZMod (ℓ ^ (j + k))))
    (hc : ∀ x, c (κ x) = c x + 1) :
    ∃ G : LocallyConstant X (ZMod (ℓ ^ k)), ∀ x, G (κ x) - G x = F x :=
by
  classical
  have hNpos : 0 < ℓ ^ (j + k) := pow_pos hℓ _
  haveI : NeZero (ℓ ^ (j + k)) := ⟨hNpos.ne'⟩
  have hNQP : ℓ ^ (j + k) = ℓ ^ k * ℓ ^ j := by rw [pow_add, mul_comm]
  let S : ℕ → X → ZMod (ℓ ^ k) := fun m y => ∑ i ∈ Finset.range m, F (κ^[i] y)
  have s1 : ∀ q r y, F (κ^[q * ℓ ^ j + r] y) = F (κ^[r] y) := by
    intro q
    induction q with
    | zero => intro r y; simp
    | succ q ih =>
      intro r y
      have : (q + 1) * ℓ ^ j + r = ℓ ^ j + (q * ℓ ^ j + r) := by ring
      rw [this, Function.iterate_add_apply, hF, ih]
  have s2 : ∀ q y, S (q * ℓ ^ j) y = q • S (ℓ ^ j) y := by
    intro q
    induction q with
    | zero => intro y; simp [S]
    | succ q ih =>
      intro y
      have : (q + 1) * ℓ ^ j = q * ℓ ^ j + ℓ ^ j := by ring
      simp only [S] at ih ⊢
      rw [this, Finset.sum_range_add, ih, succ_nsmul]
      congr 1
      exact Finset.sum_congr rfl (fun x _ => s1 q x y)
  have s3 : ∀ y, S (ℓ ^ (j + k)) y = 0 := by
    intro y
    rw [hNQP, s2, nsmul_eq_mul, ZMod.natCast_self, zero_mul]
  have s4 : ∀ m y, S (m + 1) y = S m (κ y) + F y := by
    intro m y
    simp only [S]
    rw [Finset.sum_range_succ']
    simp [Function.iterate_succ_apply]
  let g : X → ZMod (ℓ ^ k) := fun x => - S (ℓ ^ (j + k) - 1 - (c x).val) x
  have hg : IsLocallyConstant g := by
    rw [IsLocallyConstant.iff_exists_open]
    intro x
    refine ⟨{y | c y = c x} ∩ ⋂ i ∈ Finset.range (ℓ ^ (j + k)),
      {y | F (κ^[i] y) = F (κ^[i] x)}, ?_, ?_, ?_⟩
    · apply IsOpen.inter
      · exact c.isLocallyConstant.isOpen_fiber _
      · apply isOpen_biInter_finset
        intro i _
        exact (F.isLocallyConstant.comp_continuous (hκ.iterate i)).isOpen_fiber _
    · simp
    · intro y hy
      simp only [Set.mem_inter_iff, Set.mem_setOf_eq, Set.mem_iInter, Finset.mem_range] at hy
      obtain ⟨hcy, hFy⟩ := hy
      simp only [g, S, hcy]
      congr 1
      apply Finset.sum_congr rfl
      intro i hi
      rw [Finset.mem_range] at hi
      exact hFy i (by omega)
  refine ⟨⟨g, hg⟩, ?_⟩
  intro x
  show g (κ x) - g x = F x
  simp only [g]
  have ha : (c x).val < ℓ ^ (j + k) := ZMod.val_lt _
  rw [hc x]
  by_cases hA : (c x).val + 1 < ℓ ^ (j + k)
  · haveI : Fact (1 < ℓ ^ (j + k)) := ⟨by omega⟩
    have h1 : (c x + 1).val = (c x).val + 1 := by
      rw [ZMod.val_add_of_lt (by rwa [ZMod.val_one]), ZMod.val_one]
    rw [h1]
    have e1 : ℓ ^ (j + k) - 1 - (c x).val = (ℓ ^ (j + k) - 1 - ((c x).val + 1)) + 1 := by omega
    rw [e1, s4]
    ring
  · have hEq : (c x).val + 1 = ℓ ^ (j + k) := by omega
    have h0 : c x + 1 = 0 := by
      have h2 : (((c x).val + 1 : ℕ) : ZMod (ℓ ^ (j + k))) = 0 := by
        rw [hEq]; exact ZMod.natCast_self _
      push_cast at h2
      rwa [ZMod.natCast_zmod_val] at h2
    rw [h0, ZMod.val_zero, Nat.sub_zero]
    have e2 : ℓ ^ (j + k) - 1 - (c x).val = 0 := by omega
    rw [e2]
    have e3 := s4 (ℓ ^ (j + k) - 1) x
    rw [Nat.sub_add_cancel hNpos, s3] at e3
    have e4 : S 0 x = 0 := Finset.sum_range_zero _
    rw [e4]
    linear_combination e3

theorem wc_etqmt_local_antidiff {A B L : Type u} [CommRing A] [CommRing B] [Field L] {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)] {φA : A →+* L} {σ : L →+* L} {XE : Scheme.{u}}
    {p : XE ⟶ Spec (.of B)} {q : XE ⟶ Spec (.of L)} {w : XE ⟶ XE} {x₀ : B}
    (T : wcQmtmTower ℓ φA σ p q w x₀) (k : ℕ) (W : XE.Etale)
    (F : LocallyConstant ↥(Limits.pullback W.hom T.πi) (ZMod (ℓ ^ k))) (w₀ : ↥W.left) :
    ∃ (W₁ : XE.Etale) (h : W₁ ⟶ W)
      (G : LocallyConstant ↥(Limits.pullback W₁.hom T.πi) (ZMod (ℓ ^ k))),
      w₀ ∈ Set.range h.left ∧
      ∀ κ : Limits.pullback W₁.hom T.πi ⟶ Limits.pullback W₁.hom T.πi,
        κ ≫ Limits.pullback.fst W₁.hom T.πi = Limits.pullback.fst W₁.hom T.πi →
        κ ≫ Limits.pullback.snd W₁.hom T.πi = Limits.pullback.snd W₁.hom T.πi ≫ T.γi →
        ∀ x : ↥(Limits.pullback W₁.hom T.πi),
          G (κ x) - G x = F (((wcEtBaseChange T.πi).map h).left x) :=
by
  classical

  obtain ⟨O, hO, hw₀O, -⟩ := exists_isAffineOpen_mem_and_subset (x := w₀)
    (U := (⊤ : W.left.Opens)) (by simp)
  haveI : IsAffine O := hO
  haveI : Etale W.hom := W.prop
  obtain ⟨vO, hvO⟩ : ∃ vO : (O.toScheme ⟶ XE), vO = O.ι ≫ W.hom := ⟨_, rfl⟩

  obtain ⟨τ, hτ1, hτ2⟩ : ∃ τ : Limits.pullback vO T.πi ⟶ Limits.pullback W.hom T.πi,
      τ ≫ Limits.pullback.fst W.hom T.πi = Limits.pullback.fst vO T.πi ≫ O.ι ∧
      τ ≫ Limits.pullback.snd W.hom T.πi = Limits.pullback.snd vO T.πi :=
    ⟨Limits.pullback.lift (Limits.pullback.fst vO T.πi ≫ O.ι) (Limits.pullback.snd vO T.πi)
      (by rw [Category.assoc, ← hvO]; exact Limits.pullback.condition),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  obtain ⟨κO, hκO1, hκO2⟩ : ∃ κO : Limits.pullback vO T.πi ⟶ Limits.pullback vO T.πi,
      κO ≫ Limits.pullback.fst vO T.πi = Limits.pullback.fst vO T.πi ∧
      κO ≫ Limits.pullback.snd vO T.πi = Limits.pullback.snd vO T.πi ≫ T.γi :=
    ⟨Limits.pullback.lift (Limits.pullback.fst vO T.πi) (Limits.pullback.snd vO T.πi ≫ T.γi)
      (by rw [Category.assoc, T.hγπ, Limits.pullback.condition]),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  obtain ⟨FO, hFO⟩ : ∃ FO : LocallyConstant ↥(Limits.pullback vO T.πi) (ZMod (ℓ ^ k)),
      ∀ y, FO y = F (τ y) :=
    ⟨LocallyConstant.comap ⟨⇑τ, τ.continuous⟩ F, fun y => rfl⟩

  obtain ⟨j, hj⟩ := wc_etqmt_lc_period T vO (ℓ ^ k) FO κO hκO1 hκO2

  obtain ⟨V', e, he, hsurj, r, hr⟩ := wc_etqmt_kummer_root_cover T vO (j + k)
  haveI := he
  haveI := hsurj

  have main : ∀ (W₁ : XE.Etale) (h : W₁ ⟶ W) (e' : W₁.left ⟶ O),
      Function.Surjective e' → e' ≫ vO = W₁.hom → h.left = e' ≫ O.ι →
      ∀ r' : Γ(W₁.left, ⊤), r' ^ (ℓ ^ (j + k)) = (W₁.hom ≫ T.g₀).appTop.hom
        ((Scheme.ΓSpecIso (CommRingCat.of (LaurentPolynomial L))).inv.hom
          (LaurentPolynomial.T 1)) →
      ∃ G : LocallyConstant ↥(Limits.pullback W₁.hom T.πi) (ZMod (ℓ ^ k)),
        w₀ ∈ Set.range h.left ∧
        ∀ κ : Limits.pullback W₁.hom T.πi ⟶ Limits.pullback W₁.hom T.πi,
          κ ≫ Limits.pullback.fst W₁.hom T.πi = Limits.pullback.fst W₁.hom T.πi →
          κ ≫ Limits.pullback.snd W₁.hom T.πi = Limits.pullback.snd W₁.hom T.πi ≫ T.γi →
          ∀ x : ↥(Limits.pullback W₁.hom T.πi),
            G (κ x) - G x = F (((wcEtBaseChange T.πi).map h).left x) := by
    intro W₁ h e' hes he' hh r' hr'
    have hw : w₀ ∈ Set.range h.left := by
      have h1 : w₀ ∈ Set.range O.ι := by rw [Scheme.Opens.range_ι]; exact hw₀O
      obtain ⟨o, ho⟩ := h1
      obtain ⟨v', hv'⟩ := hes o
      refine ⟨v', ?_⟩
      rw [hh, Scheme.Hom.comp_apply, hv', ho]

    obtain ⟨c, hc⟩ := wc_etqmt_level_coordinate_of_root T W₁.hom (j + k) r' hr'

    obtain ⟨κ₁, hκ₁1, hκ₁2⟩ : ∃ κ₁ : Limits.pullback W₁.hom T.πi ⟶ Limits.pullback W₁.hom T.πi,
        κ₁ ≫ Limits.pullback.fst W₁.hom T.πi = Limits.pullback.fst W₁.hom T.πi ∧
        κ₁ ≫ Limits.pullback.snd W₁.hom T.πi = Limits.pullback.snd W₁.hom T.πi ≫ T.γi :=
      ⟨Limits.pullback.lift (Limits.pullback.fst W₁.hom T.πi)
        (Limits.pullback.snd W₁.hom T.πi ≫ T.γi)
        (by rw [Category.assoc, T.hγπ, Limits.pullback.condition]),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    obtain ⟨ρ, hρ1, hρ2⟩ : ∃ ρ : Limits.pullback W₁.hom T.πi ⟶ Limits.pullback vO T.πi,
        ρ ≫ Limits.pullback.fst vO T.πi = Limits.pullback.fst W₁.hom T.πi ≫ e' ∧
        ρ ≫ Limits.pullback.snd vO T.πi = Limits.pullback.snd W₁.hom T.πi :=
      ⟨Limits.pullback.lift (Limits.pullback.fst W₁.hom T.πi ≫ e') (Limits.pullback.snd W₁.hom T.πi)
        (by rw [Category.assoc, he']; exact Limits.pullback.condition),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩

    have hbc : (((wcEtBaseChange T.πi).map h).left :
        Limits.pullback W₁.hom T.πi ⟶ Limits.pullback W.hom T.πi) = ρ ≫ τ := by
      have k1 : ((wcEtBaseChange T.πi).map h).left ≫ Limits.pullback.fst W.hom T.πi =
          Limits.pullback.fst W₁.hom T.πi ≫ h.left := by
        first
          | exact Limits.pullback.lift_fst _ _ _
          | (unfold wcEtBaseChange; erw [MorphismProperty.Over.pullback_map_left];
              exact Limits.pullback.lift_fst _ _ _)
      have k2 : ((wcEtBaseChange T.πi).map h).left ≫ Limits.pullback.snd W.hom T.πi =
          Limits.pullback.snd W₁.hom T.πi := by
        first
          | exact Limits.pullback.lift_snd _ _ _
          | (unfold wcEtBaseChange; erw [MorphismProperty.Over.pullback_map_left];
              exact Limits.pullback.lift_snd _ _ _)
      have k1' : (ρ ≫ τ) ≫ Limits.pullback.fst W.hom T.πi =
          Limits.pullback.fst W₁.hom T.πi ≫ h.left := by
        rw [Category.assoc, hτ1, ← Category.assoc, hρ1, Category.assoc, hh]
      have k2' : (ρ ≫ τ) ≫ Limits.pullback.snd W.hom T.πi =
          Limits.pullback.snd W₁.hom T.πi := by
        rw [Category.assoc, hτ2, hρ2]
      exact Limits.pullback.hom_ext (k1.trans k1'.symm) (k2.trans k2'.symm)
    have hbcx : ∀ x : ↥(Limits.pullback W₁.hom T.πi),
        ((wcEtBaseChange T.πi).map h).left x = τ (ρ x) := by
      intro x
      rw [hbc]
      exact Scheme.Hom.comp_apply ρ τ x

    have hsc : κ₁ ≫ ρ = ρ ≫ κO := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Category.assoc, hρ1, hκO1, hρ1, ← Category.assoc, hκ₁1]
      · rw [Category.assoc, Category.assoc, hρ2, hκO2, ← Category.assoc, hρ2, hκ₁2]
    have hsemi : Function.Semiconj ⇑ρ ⇑κ₁ ⇑κO := by
      intro x
      calc ρ (κ₁ x) = (κ₁ ≫ ρ) x := (Scheme.Hom.comp_apply κ₁ ρ x).symm
        _ = (ρ ≫ κO) x := by rw [hsc]
        _ = κO (ρ x) := Scheme.Hom.comp_apply ρ κO x

    obtain ⟨F', hF'⟩ : ∃ F' : LocallyConstant ↥(Limits.pullback W₁.hom T.πi) (ZMod (ℓ ^ k)),
        ∀ y, F' y = FO (ρ y) :=
      ⟨LocallyConstant.comap ⟨⇑ρ, ρ.continuous⟩ FO, fun y => rfl⟩
    have hper : ∀ y, F' ((⇑κ₁)^[ℓ ^ j] y) = F' y := by
      intro y
      have e1 : ρ ((⇑κ₁)^[ℓ ^ j] y) = (⇑κO)^[ℓ ^ j] (ρ y) := hsemi.iterate_right (ℓ ^ j) y
      rw [hF', hF', e1]
      exact hj (ρ y)

    obtain ⟨G, hG⟩ := wc_etqmt_antidiff_comb ℓ j k (Fact.out : ℓ.Prime).pos (⇑κ₁)
      κ₁.continuous F' hper c (hc κ₁ hκ₁1 hκ₁2)

    refine ⟨G, hw, ?_⟩
    intro κ hκ1 hκ2 x
    have hκeq : κ = κ₁ :=
      Limits.pullback.hom_ext (hκ1.trans hκ₁1.symm) (hκ2.trans hκ₁2.symm)
    subst hκeq
    exact (hG x).trans ((hF' x).trans ((hFO (ρ x)).trans (congrArg F (hbcx x).symm)))

  let W₁ : XE.Etale := MorphismProperty.Over.mk ⊤ (e ≫ vO) (by rw [hvO]; infer_instance)
  have hcomm : (e ≫ O.ι) ≫ W.hom = W₁.hom := by
    show (e ≫ O.ι) ≫ W.hom = e ≫ vO
    rw [Category.assoc, ← hvO]
  obtain ⟨h, hh⟩ : ∃ h : W₁ ⟶ W, h.left = e ≫ O.ι :=
    ⟨MorphismProperty.Over.homMk (e ≫ O.ι) hcomm trivial, rfl⟩
  have hr₁ : r ^ (ℓ ^ (j + k)) = ((e ≫ vO) ≫ T.g₀).appTop.hom
      ((Scheme.ΓSpecIso (CommRingCat.of (LaurentPolynomial L))).inv.hom
        (LaurentPolynomial.T 1)) := by
    rw [Category.assoc]; exact hr
  obtain ⟨G, hw, hG⟩ := main W₁ h e e.surjective rfl hh r hr₁
  exact ⟨W₁, h, G, hw, hG⟩

theorem wc_etqmt_torsor_ses {A B L : Type u} [CommRing A] [CommRing B] [Field L] {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)] {φA : A →+* L} {σ : L →+* L} {XE : Scheme.{u}}
    {p : XE ⟶ Spec (.of B)} {q : XE ⟶ Spec (.of L)} {w : XE ⟶ XE} {x₀ : B}
    (T : wcQmtmTower ℓ φA σ p q w x₀) (k : ℕ)
    (Dπ : wcEtPullData T.πi (ℓ ^ k)) (Dγ : wcEtPullData T.γi (ℓ ^ k))
    (hφγ : wcEtqmtHPhi T.hγπ Dπ Dγ)
    (hz : wcEtqmtU Dπ ≫ (wcEtqmtGammaN T.hγπ Dπ Dγ hφγ - 𝟙 (wcEtSuppObj Dπ)) = 0) :
    (ShortComplex.mk (wcEtqmtU Dπ) (wcEtqmtGammaN T.hγπ Dπ Dγ hφγ - 𝟙 (wcEtSuppObj Dπ)) hz).ShortExact :=
by
  classical
  haveI : NeZero (ℓ ^ k) := ⟨pow_ne_zero _ (Nat.Prime.ne_zero Fact.out)⟩
  obtain ⟨E0, E, hnat, hu, hγ⟩ := wc_etqmt_sections_dict T k Dπ Dγ hφγ
  obtain ⟨_, hsurjπ, _, _⟩ := wc_qmtm_tower_pi_props T
  haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.smallEtaleTopology XE)
    (wcEtZModRing XE (ℓ ^ k))
  have hκ : ∀ W : XE.Etale, ∃ κ : Limits.pullback W.hom T.πi ⟶ Limits.pullback W.hom T.πi,
      κ ≫ Limits.pullback.fst W.hom T.πi = Limits.pullback.fst W.hom T.πi ∧
      κ ≫ Limits.pullback.snd W.hom T.πi = Limits.pullback.snd W.hom T.πi ≫ T.γi := fun W =>
    ⟨Limits.pullback.lift (Limits.pullback.fst W.hom T.πi)
        (Limits.pullback.snd W.hom T.πi ≫ T.γi)
        (by rw [Category.assoc, T.hγπ, Limits.pullback.condition]),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hsub : ∀ (W : XE.Etale) (s : (wcEtSuppObj Dπ).val.obj (Opposite.op W)),
      (((wcEtqmtGammaN T.hγπ Dπ Dγ hφγ - 𝟙 (wcEtSuppObj Dπ)).val.app (Opposite.op W)).hom s) =
        ((wcEtqmtGammaN T.hγπ Dπ Dγ hφγ).val.app (Opposite.op W)).hom s - s := fun W s => rfl
  have hfg : (SheafOfModules.toSheaf (wcEtZModRing XE (ℓ ^ k))).map (wcEtqmtU Dπ) ≫
      (SheafOfModules.toSheaf (wcEtZModRing XE (ℓ ^ k))).map
        (wcEtqmtGammaN T.hγπ Dπ Dγ hφγ - 𝟙 (wcEtSuppObj Dπ)) = 0 := by
    rw [← Functor.map_comp, hz, Functor.map_zero]
  have hS' := wc_sheaf_ses_of_sectionwise (Scheme.smallEtaleTopology XE) _ _ hfg ?_ ?_ ?_
  rotate_left
  ·
    intro W (a : (SheafOfModules.unit (wcEtZModRing XE (ℓ ^ k))).val.obj (Opposite.op W)) ha
    change ((wcEtqmtU Dπ).val.app (Opposite.op W)).hom a = 0 at ha
    haveI : Surjective (Limits.pullback.fst W.hom T.πi) :=
      MorphismProperty.of_isPullback (P := @Surjective)
        (IsPullback.of_hasPullback W.hom T.πi).flip hsurjπ
    have h0 : E0 W a = 0 := by
      ext y
      obtain ⟨x, rfl⟩ := (Limits.pullback.fst W.hom T.πi).surjective y
      rw [← hu W a x, ha, map_zero]
      rfl
    have h1 : E0 W a = E0 W 0 := by rw [h0, map_zero]
    exact (E0 W).injective h1
  ·
    intro W (b : (wcEtSuppObj Dπ).val.obj (Opposite.op W)) hb
    change ((wcEtqmtGammaN T.hγπ Dπ Dγ hφγ - 𝟙 (wcEtSuppObj Dπ)).val.app
      (Opposite.op W)).hom b = 0 at hb
    rw [hsub] at hb
    have hb' := sub_eq_zero.mp hb
    obtain ⟨f, hf⟩ := wc_etqmt_lc_invariant_factor T W.hom (ℓ ^ k) (E W b)
      (fun κ h1 h2 x => by rw [← hγ W b κ h1 h2 x, hb'])
    refine ⟨(E0 W).symm f, ?_⟩
    change ((wcEtqmtU Dπ).val.app (Opposite.op W)).hom ((E0 W).symm f) = b
    apply (E W).injective
    ext x
    rw [hu, AddEquiv.apply_symm_apply, hf]
  ·
    intro W (q0 : (wcEtSuppObj Dπ).val.obj (Opposite.op W))
    apply wc_etale_jointly_surjective_covers
    intro w₀
    obtain ⟨W₁, h, G, hw, hG⟩ := wc_etqmt_local_antidiff T k W (E W q0) w₀
    refine ⟨W₁, h, ⟨(E W₁).symm G, ?_⟩, hw⟩
    change ((wcEtqmtGammaN T.hγπ Dπ Dγ hφγ - 𝟙 (wcEtSuppObj Dπ)).val.app
      (Opposite.op W₁)).hom ((E W₁).symm G) = ((wcEtSuppObj Dπ).val.map h.op).hom q0
    apply (E W₁).injective
    ext x
    obtain ⟨κ, h1, h2⟩ := hκ W₁
    rw [hsub, map_sub, LocallyConstant.sub_apply, hγ W₁ _ κ h1 h2 x, AddEquiv.apply_symm_apply,
      hG κ h1 h2 x, hnat]
  have hex : (ShortComplex.mk (wcEtqmtU Dπ)
      (wcEtqmtGammaN T.hγπ Dπ Dγ hφγ - 𝟙 (wcEtSuppObj Dπ)) hz).Exact :=
    (ShortComplex.exact_map_iff_of_faithful _
      (SheafOfModules.toSheaf (wcEtZModRing XE (ℓ ^ k)))).mp hS'.exact
  haveI hrm : (SheafOfModules.toSheaf (wcEtZModRing XE (ℓ ^ k))).ReflectsMonomorphisms :=
    Functor.reflectsMonomorphisms_of_faithful _
  haveI hre : (SheafOfModules.toSheaf (wcEtZModRing XE (ℓ ^ k))).ReflectsEpimorphisms :=
    Functor.reflectsEpimorphisms_of_faithful _
  refine ShortComplex.ShortExact.mk' hex ?_ ?_
  · exact (SheafOfModules.toSheaf (wcEtZModRing XE (ℓ ^ k))).mono_of_mono_map hS'.mono_f
  · exact (SheafOfModules.toSheaf (wcEtZModRing XE (ℓ ^ k))).epi_of_epi_map hS'.epi_g

theorem wc_etqmt_gammaN_comp {X X' : Scheme.{u}} {p : X' ⟶ X} {a b : X' ⟶ X'} {n : ℕ}
    (ha : a ≫ p = p) (hb : b ≫ p = p) (hab : (a ≫ b) ≫ p = p)
    (Dp : wcEtPullData p n) (Da : wcEtPullData a n) (Db : wcEtPullData b n)
    (Dab : wcEtPullData (a ≫ b) n)
    (hφa : wcEtqmtHPhi ha Dp Da) (hφb : wcEtqmtHPhi hb Dp Db)
    (hφab : wcEtqmtHPhi hab Dp Dab) :
    wcEtqmtGammaN hab Dp Dab hφab = wcEtqmtGammaN hb Dp Db hφb ≫ wcEtqmtGammaN ha Dp Da hφa :=
by
  classical
  haveI := Dp.cont
  haveI := Da.cont
  haveI := Db.cont
  haveI := Dab.cont
  haveI : (wcEtBaseChange b ⋙ wcEtBaseChange a).IsContinuous
      (Scheme.smallEtaleTopology X') (Scheme.smallEtaleTopology X') :=
    Functor.isContinuous_comp (wcEtBaseChange b) (wcEtBaseChange a)
      (Scheme.smallEtaleTopology X') (Scheme.smallEtaleTopology X')
      (Scheme.smallEtaleTopology X')

  obtain ⟨κ, hκ⟩ : ∃ κ : wcEtBaseChange (a ≫ b) ⟶ wcEtBaseChange b ⋙ wcEtBaseChange a,
      ∀ W : X'.Etale, (κ.app W).left ≫
          Limits.pullback.fst (Limits.pullback.snd W.hom b) a ≫ Limits.pullback.fst W.hom b =
        Limits.pullback.fst W.hom (a ≫ b) := by
    haveI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) a :=
      ⟨fun _ _ => inferInstance⟩
    haveI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) a :=
      (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
        (inferInstance : Pr.IsStableUnderBaseChangeAlong a)) (@Etale : MorphismProperty Scheme.{u})
    haveI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) b :=
      ⟨fun _ _ => inferInstance⟩
    haveI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) b :=
      (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
        (inferInstance : Pr.IsStableUnderBaseChangeAlong b)) (@Etale : MorphismProperty Scheme.{u})
    exact ⟨(MorphismProperty.Over.pullbackComp (P := (@Etale : MorphismProperty Scheme.{u}))
      (Q := ⊤) a b (a ≫ b) rfl).hom, fun W =>
        MorphismProperty.Over.pullbackComp_left_fst_fst
          (P := (@Etale : MorphismProperty Scheme.{u})) (Q := ⊤) a b W⟩

  have ringExt : ∀ (R : Sheaf (Scheme.smallEtaleTopology X') RingCat.{u+1})
      (φ ψ : wcEtZModRing X' n ⟶ R), φ = ψ := by
    intro R φ ψ
    have key : ∀ (T : Type (u+1)) [Semiring T] (f g : ULift.{u+1} (ZMod n) →+* T), f = g := by
      intro T _ f g
      have h : f.comp (ULift.ringEquiv : ULift.{u+1} (ZMod n) ≃+* ZMod n).symm.toRingHom =
          g.comp (ULift.ringEquiv : ULift.{u+1} (ZMod n) ≃+* ZMod n).symm.toRingHom :=
        Subsingleton.elim _ _
      ext x
      exact RingHom.congr_fun h x.down
    apply ((sheafificationAdjunction (Scheme.smallEtaleTopology X') RingCat.{u+1}).homEquiv _
      R).injective
    apply NatTrans.ext
    funext U
    apply RingCat.hom_ext
    exact key _ _ _

  have hΓ : ∀ {c : X' ⟶ X'} (hc : c ≫ p = p) (Dc : wcEtPullData c n)
      (hφc : wcEtqmtHPhi hc Dp Dc) (V : X.Etale)
      (x : ↑((wcEtZModRing X' n).obj.obj (Opposite.op ((wcEtBaseChange p).obj V)))),
      ((wcEtqmtGammaN hc Dp Dc hφc).val.app (Opposite.op V)).hom x =
        ((wcEtZModRing X' n).obj.map ((wcEtqmtAlpha p c hc).app V).op).hom
          ((Dc.φ.hom.app (Opposite.op ((wcEtBaseChange p).obj V))).hom x) := by
    intro c hc Dc hφc V x
    haveI := Dc.cont
    haveI : (wcEtBaseChange p ⋙ wcEtBaseChange c).IsContinuous
        (Scheme.smallEtaleTopology X) (Scheme.smallEtaleTopology X') :=
      Functor.isContinuous_comp (wcEtBaseChange p) (wcEtBaseChange c)
        (Scheme.smallEtaleTopology X) (Scheme.smallEtaleTopology X')
        (Scheme.smallEtaleTopology X')
    simp only [wcEtqmtGammaN, wcEtqmtGamma, NatTrans.comp_app]
    erw [PresheafOfModules.comp_app]
    erw [ConcreteCategory.comp_apply]
    try erw [PresheafOfModules.pushforward_map_app_apply]

  have hcoh : ∀ (W : X'.Etale) (z : ↑((wcEtZModRing X' n).obj.obj (Opposite.op W))),
      (Dab.φ.hom.app (Opposite.op W)).hom z =
        ((wcEtZModRing X' n).obj.map (κ.app W).op).hom
          ((Da.φ.hom.app (Opposite.op ((wcEtBaseChange b).obj W))).hom
            ((Db.φ.hom.app (Opposite.op W)).hom z)) := by
    intro W z
    have h : (Db.φ ≫ ((wcEtBaseChange b).sheafPushforwardContinuous RingCat.{u+1}
        (Scheme.smallEtaleTopology X') (Scheme.smallEtaleTopology X')).map Da.φ) ≫
        (Functor.sheafPushforwardContinuousNatTrans κ RingCat.{u+1}
          (Scheme.smallEtaleTopology X') (Scheme.smallEtaleTopology X')).app
          (wcEtZModRing X' n) = Dab.φ :=
      ringExt _ _ _
    have h2 := NatTrans.congr_app
      ((sheafToPresheaf (Scheme.smallEtaleTopology X') RingCat.{u+1}).congr_map h)
        (Opposite.op W)
    have h3 := congrArg (fun f => RingCat.Hom.hom f z) h2
    exact h3.symm

  have gAlphaK : ∀ {S S' : Scheme.{u}} (f : S' ⟶ S) (g : S' ⟶ S') (hg : g ≫ f = f) (V : S.Etale),
      ((wcEtqmtAlpha f g hg).app V).left ≫ Limits.pullback.fst (Limits.pullback.snd V.hom f) g ≫
        Limits.pullback.fst V.hom f = Limits.pullback.fst V.hom f := by
    intro S S' f g hg V
    haveI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) f :=
      ⟨fun _ _ => inferInstance⟩
    haveI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) f :=
      (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
        (inferInstance : Pr.IsStableUnderBaseChangeAlong f)) (@Etale : MorphismProperty Scheme.{u})
    haveI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) g :=
      ⟨fun _ _ => inferInstance⟩
    haveI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) g :=
      (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
        (inferInstance : Pr.IsStableUnderBaseChangeAlong g)) (@Etale : MorphismProperty Scheme.{u})
    have hα : ((wcEtqmtAlpha f g hg).app V).left = _ :=
      MorphismProperty.Over.pullbackComp_hom_app_left
        (P := (@Etale : MorphismProperty Scheme.{u})) (Q := ⊤) g f f hg.symm V
    rw [hα]
    exact (Category.assoc _ _ _).trans ((whisker_eq _
      (Limits.pullbackLeftPullbackSndIso_inv_fst V.hom f g)).trans
        ((Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _)))
  have gMap : ∀ {S S' : Scheme.{u}} (g : S' ⟶ S) {V₁ V₂ : S.Etale} (h : V₁ ⟶ V₂)
      {Z' : Scheme.{u}} (k : V₂.left ⟶ Z'),
      ((wcEtBaseChange g).map h).left ≫ Limits.pullback.fst V₂.hom g ≫ k =
        Limits.pullback.fst V₁.hom g ≫ h.left ≫ k := by
    intro S S' g V₁ V₂ h Z' k
    have e : ((wcEtBaseChange g).map h).left ≫ Limits.pullback.fst V₂.hom g =
        Limits.pullback.fst V₁.hom g ≫ h.left := Limits.pullback.lift_fst _ _ _
    exact (Category.assoc _ _ _).symm.trans ((e =≫ k).trans (Category.assoc _ _ _))
  have gext : ∀ (V' : Scheme.{u}) (h : V' ⟶ X) {Z : Scheme.{u}}
      (u v : Z ⟶ Limits.pullback (Limits.pullback.snd (Limits.pullback.snd h p) b) a),
      u ≫ Limits.pullback.snd (Limits.pullback.snd (Limits.pullback.snd h p) b) a =
        v ≫ Limits.pullback.snd (Limits.pullback.snd (Limits.pullback.snd h p) b) a →
      u ≫ Limits.pullback.fst (Limits.pullback.snd (Limits.pullback.snd h p) b) a ≫
          Limits.pullback.fst (Limits.pullback.snd h p) b ≫ Limits.pullback.fst h p =
        v ≫ Limits.pullback.fst (Limits.pullback.snd (Limits.pullback.snd h p) b) a ≫
          Limits.pullback.fst (Limits.pullback.snd h p) b ≫ Limits.pullback.fst h p →
      u = v := by
    intro V' h Z u v h4 h1
    have key3 : ∀ t : Z ⟶ Limits.pullback (Limits.pullback.snd (Limits.pullback.snd h p) b) a,
        t ≫ Limits.pullback.fst (Limits.pullback.snd (Limits.pullback.snd h p) b) a ≫
          Limits.pullback.snd (Limits.pullback.snd h p) b =
        t ≫ Limits.pullback.snd (Limits.pullback.snd (Limits.pullback.snd h p) b) a ≫ a := by
      intro t
      rw [Limits.pullback.condition (f := Limits.pullback.snd (Limits.pullback.snd h p) b)
        (g := a)]
    have key2 : ∀ t : Z ⟶ Limits.pullback (Limits.pullback.snd (Limits.pullback.snd h p) b) a,
        t ≫ Limits.pullback.fst (Limits.pullback.snd (Limits.pullback.snd h p) b) a ≫
          Limits.pullback.fst (Limits.pullback.snd h p) b ≫ Limits.pullback.snd h p =
        t ≫ Limits.pullback.snd (Limits.pullback.snd (Limits.pullback.snd h p) b) a ≫
          a ≫ b := by
      intro t
      rw [Limits.pullback.condition (f := Limits.pullback.snd h p) (g := b),
        Limits.pullback.condition_assoc (f := Limits.pullback.snd (Limits.pullback.snd h p) b)
          (g := a)]
    apply Limits.pullback.hom_ext
    · apply Limits.pullback.hom_ext
      · apply Limits.pullback.hom_ext
        · simpa only [Category.assoc] using h1
        · simp only [Category.assoc]
          rw [key2 u, key2 v, ← Category.assoc u, ← Category.assoc v, h4]
      · simp only [Category.assoc]
        rw [key3 u, key3 v, ← Category.assoc u, ← Category.assoc v, h4]
    · exact h4

  have hD : ∀ V : X.Etale,
      (wcEtqmtAlpha p (a ≫ b) hab).app V ≫ κ.app ((wcEtBaseChange p).obj V) =
        (wcEtqmtAlpha p a ha).app V ≫ (wcEtBaseChange a).map ((wcEtqmtAlpha p b hb).app V) := by
    intro V
    apply MorphismProperty.Over.Hom.ext
    apply gext V.left V.hom
    · have w1 := MorphismProperty.Over.w ((wcEtqmtAlpha p (a ≫ b) hab).app V)
      have w2 := MorphismProperty.Over.w (κ.app ((wcEtBaseChange p).obj V))
      have w3 := MorphismProperty.Over.w ((wcEtqmtAlpha p a ha).app V)
      have w4 := MorphismProperty.Over.w
        ((wcEtBaseChange a).map ((wcEtqmtAlpha p b hb).app V))
      exact ((Category.assoc _ _ _).trans ((whisker_eq _ w2).trans w1)).trans
        ((Category.assoc _ _ _).trans ((whisker_eq _ w4).trans w3)).symm
    · have hk := hκ ((wcEtBaseChange p).obj V)
      have hk' : (κ.app ((wcEtBaseChange p).obj V)).left ≫
          Limits.pullback.fst (Limits.pullback.snd (Limits.pullback.snd V.hom p) b) a ≫
            Limits.pullback.fst (Limits.pullback.snd V.hom p) b ≫ Limits.pullback.fst V.hom p =
          Limits.pullback.fst (Limits.pullback.snd V.hom p) (a ≫ b) ≫
            Limits.pullback.fst V.hom p :=
        ((whisker_eq _ (Category.assoc _ _ _)).symm.trans (Category.assoc _ _ _).symm).trans
          (hk =≫ Limits.pullback.fst V.hom p)
      have gA0 := gAlphaK p (a ≫ b) hab V
      have gAa := gAlphaK p a ha V
      have gAb := gAlphaK p b hb V
      refine (Category.assoc _ _ _).trans ((whisker_eq _ hk').trans (gA0.trans ?_))
      refine Eq.symm ((Category.assoc _ _ _).trans ?_)
      refine (whisker_eq _ (gMap a ((wcEtqmtAlpha p b hb).app V) _)).trans ?_
      refine (whisker_eq _ (whisker_eq _ gAb)).trans ?_
      exact gAa

  have hnat : ∀ {W1 W2 : X'.Etale} (f : W1 ⟶ W2)
      (z : ↑((wcEtZModRing X' n).obj.obj (Opposite.op W2))),
      (Da.φ.hom.app (Opposite.op W1)).hom (((wcEtZModRing X' n).obj.map f.op).hom z) =
        ((wcEtZModRing X' n).obj.map ((wcEtBaseChange a).map f).op).hom
          ((Da.φ.hom.app (Opposite.op W2)).hom z) := by
    intro W1 W2 f z
    exact congrArg (fun k => RingCat.Hom.hom k z) (Da.φ.hom.naturality f.op)
  have hρc : ∀ {W1 W2 W3 : X'.Etale} (f : W1 ⟶ W2) (g : W2 ⟶ W3)
      (z : ↑((wcEtZModRing X' n).obj.obj (Opposite.op W3))),
      ((wcEtZModRing X' n).obj.map (f ≫ g).op).hom z =
        ((wcEtZModRing X' n).obj.map f.op).hom (((wcEtZModRing X' n).obj.map g.op).hom z) := by
    intro W1 W2 W3 f g z
    rw [op_comp, Functor.map_comp]
    rfl

  have main : ∀ (V : X.Etale)
      (x : ↑((wcEtZModRing X' n).obj.obj (Opposite.op ((wcEtBaseChange p).obj V)))),
      ((wcEtqmtGammaN hab Dp Dab hφab).val.app (Opposite.op V)).hom x =
        ((wcEtqmtGammaN ha Dp Da hφa).val.app (Opposite.op V)).hom
          (((wcEtqmtGammaN hb Dp Db hφb).val.app (Opposite.op V)).hom x) := by
    intro V x
    refine (hΓ hab Dab hφab V x).trans ?_
    refine (congrArg (fun y => ((wcEtZModRing X' n).obj.map
      ((wcEtqmtAlpha p (a ≫ b) hab).app V).op).hom y) (hcoh _ x)).trans ?_
    refine (hρc ((wcEtqmtAlpha p (a ≫ b) hab).app V) (κ.app ((wcEtBaseChange p).obj V))
      _).symm.trans ?_
    refine (congrArg (fun f => ((wcEtZModRing X' n).obj.map (Quiver.Hom.op f)).hom
      ((Da.φ.hom.app (Opposite.op ((wcEtBaseChange b).obj ((wcEtBaseChange p).obj V)))).hom
        ((Db.φ.hom.app (Opposite.op ((wcEtBaseChange p).obj V))).hom x))) (hD V)).trans ?_
    refine (hρc ((wcEtqmtAlpha p a ha).app V)
      ((wcEtBaseChange a).map ((wcEtqmtAlpha p b hb).app V)) _).trans ?_
    refine (congrArg (fun y => ((wcEtZModRing X' n).obj.map
      ((wcEtqmtAlpha p a ha).app V).op).hom y)
        (hnat ((wcEtqmtAlpha p b hb).app V) _).symm).trans ?_
    refine (congrArg (fun y => ((wcEtZModRing X' n).obj.map
      ((wcEtqmtAlpha p a ha).app V).op).hom
        ((Da.φ.hom.app (Opposite.op ((wcEtBaseChange p).obj V))).hom y))
        (hΓ hb Db hφb V x).symm).trans ?_
    exact (hΓ ha Da hφa V _).symm
  apply SheafOfModules.hom_ext
  apply PresheafOfModules.hom_ext
  intro X0
  obtain ⟨V⟩ := X0
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  exact main V x

theorem wc_etqmt_level_operator {A B L : Type u} [CommRing A] [CommRing B] [Field L] {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)] {φA : A →+* L} {σ : L →+* L} {XE : Scheme.{u}}
    {p : XE ⟶ Spec (.of B)} {q : XE ⟶ Spec (.of L)} {w : XE ⟶ XE} {x₀ : B}
    (T : wcQmtmTower ℓ φA σ p q w x₀) (k : ℕ)
    (Dπ : wcEtPullData T.πi (ℓ ^ k)) (Dγ : wcEtPullData T.γi (ℓ ^ k))
    (hφγ : wcEtqmtHPhi T.hγπ Dπ Dγ) (s : ℤ_[ℓ]) :
    ∃ (γs : T.XEi ⟶ T.XEi) (Rs : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) →+*
        AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))) (hγs : γs ≫ T.πi = T.πi),
      (∀ (a : ℤ) (j : ℕ) (c : L),
        Rs (AddMonoidAlgebra.single
            (Localization.mk a ⟨(ℓ : ℤ) ^ j, j, rfl⟩ : Localization.Away (ℓ : ℤ)) c) =
          AddMonoidAlgebra.single
            (Localization.mk a ⟨(ℓ : ℤ) ^ j, j, rfl⟩ : Localization.Away (ℓ : ℤ))
            (T.ζ j ^ (a * ((PadicInt.toZModPow j s).val : ℤ)) * c)) ∧
      γs ≫ T.gi = T.gi ≫ Spec.map (CommRingCat.ofHom Rs) ∧
      ∀ (Dγs : wcEtPullData γs (ℓ ^ k)) (hφs : wcEtqmtHPhi hγs Dπ Dγs),
        ∃ H : wcEtSuppObj Dπ ⟶ wcEtSuppObj Dπ,
          (wcEtqmtGammaN T.hγπ Dπ Dγ hφγ - 𝟙 _) ≫ H = wcEtqmtGammaN hγs Dπ Dγs hφs - 𝟙 _ ∧
          wcEtqmtU Dπ ≫ H = (PadicInt.toZModPow k s).val • wcEtqmtU Dπ :=
by
  classical

  obtain ⟨R, hR1, hR2, hR3, -, hR5⟩ := wc_qmtx1u_transl_ring T
  have hw : ∀ y, T.πi ≫ T.g₀ = (T.gi ≫ Spec.map (CommRingCat.ofHom (R y))) ≫
      Spec.map (CommRingCat.ofHom (AddMonoidAlgebra.mapDomainRingHom L
        (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom)) := by
    intro y
    rw [Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hR5 y]
    exact T.hT.w
  obtain ⟨γ, hπ, hg, hadd, h1⟩ : ∃ γ : ℤ_[ℓ] → (T.XEi ⟶ T.XEi), (∀ y, γ y ≫ T.πi = T.πi) ∧
      (∀ y, γ y ≫ T.gi = T.gi ≫ Spec.map (CommRingCat.ofHom (R y))) ∧
      (∀ y y', γ y ≫ γ y' = γ (y + y')) ∧ γ 1 = T.γi := by
    have hπ0 : ∀ y, T.hT.lift T.πi (T.gi ≫ Spec.map (CommRingCat.ofHom (R y))) (hw y) ≫ T.πi =
        T.πi := fun y => T.hT.lift_fst _ _ _
    have hg0 : ∀ y, T.hT.lift T.πi (T.gi ≫ Spec.map (CommRingCat.ofHom (R y))) (hw y) ≫ T.gi =
        T.gi ≫ Spec.map (CommRingCat.ofHom (R y)) := fun y => T.hT.lift_snd _ _ _
    refine ⟨fun y => T.hT.lift T.πi (T.gi ≫ Spec.map (CommRingCat.ofHom (R y))) (hw y),
      hπ0, hg0, ?_, ?_⟩
    · intro y y'
      apply T.hT.hom_ext
      · simp only [Category.assoc, hπ0]
      · simp only [Category.assoc, hg0]
        rw [← Category.assoc, hg0, Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
          hR2]
    · apply T.hT.hom_ext
      · simp only [hπ0, T.hγπ]
      · rw [hg0, hR3, T.hγg]

  have hcongr : ∀ {c c' : T.XEi ⟶ T.XEi} (e : c = c') (hc : c ≫ T.πi = T.πi)
      (hc' : c' ≫ T.πi = T.πi) (Dc : wcEtPullData c (ℓ ^ k)) (Dc' : wcEtPullData c' (ℓ ^ k))
      (hφc : wcEtqmtHPhi hc Dπ Dc) (hφc' : wcEtqmtHPhi hc' Dπ Dc'),
      wcEtqmtGammaN hc Dπ Dc hφc = wcEtqmtGammaN hc' Dπ Dc' hφc' := by
    intro c c' e hc hc' Dc Dc' hφc hφc'
    subst e
    obtain ⟨c1, φ1, Φ1, a1, ad1, l1, cl1, μ1⟩ := Dc
    obtain ⟨c2, φ2, Φ2, a2, ad2, l2, cl2, μ2⟩ := Dc'
    have hφφ : φ1 = φ2 := wc_et_zmod_ring_hom_ext _ _ _ _ _
    subst hφφ
    rfl

  have D : ∀ y, wcEtPullData (γ y) (ℓ ^ k) := fun y =>
    Classical.choice (wc_et_zmod_pull_data_exists (γ y) (ℓ ^ k))
  have hφ : ∀ y, wcEtqmtHPhi (hπ y) Dπ (D y) := by
    intro y
    unfold wcEtqmtHPhi
    exact wc_et_zmod_ring_hom_ext _ _ _ _ _
  obtain ⟨G, hGdef⟩ : ∃ G : ℤ_[ℓ] → End (wcEtSuppObj Dπ),
      ∀ y, G y = wcEtqmtGammaN (hπ y) Dπ (D y) (hφ y) := ⟨_, fun _ => rfl⟩

  have hG : ∀ y y', G y' * G y = G (y + y') := by
    intro y y'
    have hab : (γ y' ≫ γ y) ≫ T.πi = T.πi := by rw [Category.assoc, hπ y, hπ y']
    obtain ⟨Dab⟩ := wc_et_zmod_pull_data_exists (γ y' ≫ γ y) (ℓ ^ k)
    have hφab : wcEtqmtHPhi hab Dπ Dab := by
      unfold wcEtqmtHPhi
      exact wc_et_zmod_ring_hom_ext _ _ _ _ _
    have e1 := wc_etqmt_gammaN_comp (hπ y') (hπ y) hab Dπ (D y') (D y) Dab (hφ y') (hφ y) hφab
    have e2 := hcongr (show γ y' ≫ γ y = γ (y + y') by rw [hadd, add_comm]) hab (hπ (y + y'))
      Dab (D (y + y')) hφab (hφ (y + y'))
    calc G y' * G y = G y ≫ G y' := rfl
      _ = G (y + y') := by rw [hGdef, hGdef, hGdef, ← e2, e1]

  have hpow : ∀ (y : ℤ_[ℓ]) (n : ℕ), G (((n + 1 : ℕ) : ℤ_[ℓ]) * y) = G y ^ (n + 1) := by
    intro y n
    induction n with
    | zero => rw [zero_add, Nat.cast_one, one_mul, pow_one]
    | succ n ih =>
      have e : (((n + 1 + 1 : ℕ) : ℤ_[ℓ])) * y = ((n + 1 : ℕ) : ℤ_[ℓ]) * y + y := by
        push_cast; ring
      rw [e, ← hG, ih, ← pow_succ']

  have hu : ∀ y, wcEtqmtU Dπ ≫ G y = wcEtqmtU Dπ := by
    intro y
    rw [hGdef]
    exact wc_etqmt_unit_fix (hπ y) Dπ (D y) (hφ y)
  have hupow : ∀ x : End (wcEtSuppObj Dπ), wcEtqmtU Dπ ≫ x = wcEtqmtU Dπ →
      ∀ i : ℕ, wcEtqmtU Dπ ≫ x ^ i = wcEtqmtU Dπ := by
    intro x hx i
    induction i with
    | zero => rw [pow_zero]; exact Category.comp_id _
    | succ i ih =>
      rw [pow_succ]
      show wcEtqmtU Dπ ≫ (x ≫ x ^ i) = wcEtqmtU Dπ
      rw [← Category.assoc, hx, ih]

  have htor : (ℓ ^ k) • 𝟙 (wcEtSuppObj Dπ) = 0 := by
    apply (SheafOfModules.toSheaf (wcEtZModRing XE (ℓ ^ k))).map_injective
    rw [Functor.map_nsmul, CategoryTheory.Functor.map_id, Functor.map_zero]
    exact wc_et_zmod_toSheaf_nsmul_zero XE (ℓ ^ k) _
  have htor' : ∀ f : SheafOfModules.unit (wcEtZModRing XE (ℓ ^ k)) ⟶ wcEtSuppObj Dπ,
      (ℓ ^ k) • f = 0 := by
    intro f
    calc (ℓ ^ k) • f = f ≫ ((ℓ ^ k) • 𝟙 (wcEtSuppObj Dπ)) := by
          rw [Preadditive.comp_nsmul, Category.comp_id]
      _ = 0 := by rw [htor, Limits.comp_zero]

  haveI : NeZero (ℓ ^ k) := ⟨pow_ne_zero _ (Nat.Prime.ne_zero Fact.out)⟩
  obtain ⟨t, ht⟩ : ∃ t : ℕ, (PadicInt.toZModPow k s).val = t := ⟨_, rfl⟩
  obtain ⟨s', hs'⟩ : ∃ s' : ℤ_[ℓ], s = (t : ℤ_[ℓ]) + (ℓ : ℤ_[ℓ]) ^ k * s' := by
    have hmem : s - (t : ℤ_[ℓ]) ∈ RingHom.ker (PadicInt.toZModPow (p := ℓ) k) := by
      rw [RingHom.mem_ker, map_sub, map_natCast, ← ht, ZMod.natCast_zmod_val, sub_self]
    rw [PadicInt.ker_toZModPow, Ideal.mem_span_singleton'] at hmem
    obtain ⟨a, ha⟩ := hmem
    exact ⟨a, by linear_combination -ha⟩
  obtain ⟨m, hm⟩ : ∃ m : ℕ, ℓ ^ k = m + 1 :=
    ⟨ℓ ^ k - 1, by have := pow_pos (Fact.out : ℓ.Prime).pos k; omega⟩

  have hc : Commute (G 1) (G s') := by
    show G 1 * G s' = G s' * G 1
    rw [hG, hG, add_comm]
  have hM : G ((ℓ : ℤ_[ℓ]) ^ k * s') = G s' ^ (ℓ ^ k) := by
    have e : (ℓ : ℤ_[ℓ]) ^ k = ((m + 1 : ℕ) : ℤ_[ℓ]) := by rw [← hm, Nat.cast_pow]
    rw [e, hpow s' m]
    exact congrArg (fun n => G s' ^ n) hm.symm
  have hGs : G s = G s' ^ (ℓ ^ k) * G 1 ^ t := by
    rcases Nat.eq_zero_or_pos t with h0 | hpos
    · rw [hs', h0, Nat.cast_zero, zero_add, hM, pow_zero, mul_one]
    · obtain ⟨t0, rfl⟩ : ∃ t0, t = t0 + 1 := ⟨t - 1, by omega⟩
      rw [hs', ← hG, hM]
      congr 1
      have := hpow 1 t0
      rw [mul_one] at this
      exact this
  have hg1 : wcEtqmtGammaN T.hγπ Dπ Dγ hφγ = G 1 := by
    rw [hGdef]
    exact hcongr h1.symm _ _ _ _ _ _

  have hz : wcEtqmtU Dπ ≫ (wcEtqmtGammaN T.hγπ Dπ Dγ hφγ - 𝟙 (wcEtSuppObj Dπ)) = 0 := by
    rw [hg1, Preadditive.comp_sub, hu 1, Category.comp_id, sub_self]
  have hS := wc_etqmt_torsor_ses T k Dπ Dγ hφγ hz
  have hsubE : ∀ x : End (wcEtSuppObj Dπ), (x - 1 : End (wcEtSuppObj Dπ)) =
      @HSub.hSub (wcEtSuppObj Dπ ⟶ wcEtSuppObj Dπ) (wcEtSuppObj Dπ ⟶ wcEtSuppObj Dπ)
        (wcEtSuppObj Dπ ⟶ wcEtSuppObj Dπ) instHSub x (𝟙 (wcEtSuppObj Dπ)) := fun _ => rfl
  have hu' : wcEtqmtU Dπ ≫ (G s' - 1 : End (wcEtSuppObj Dπ)) = 0 := by
    rw [hsubE, Preadditive.comp_sub, hu s', Category.comp_id, sub_self]
  obtain ⟨Hd, hHd⟩ : ∃ Hd : End (wcEtSuppObj Dπ),
      (wcEtqmtGammaN T.hγπ Dπ Dγ hφγ - 𝟙 (wcEtSuppObj Dπ)) ≫ Hd =
        (G s' - 1 : End (wcEtSuppObj Dπ)) :=
    ⟨(Limits.CokernelCofork.IsColimit.desc' hS.gIsCokernel _ hu').1,
      (Limits.CokernelCofork.IsColimit.desc' hS.gIsCokernel _ hu').2⟩
  rw [hg1] at hHd
  have hHdE : Hd * (G 1 - 1) = G s' - 1 := hHd

  obtain ⟨A, hA_def⟩ : ∃ A : End (wcEtSuppObj Dπ), A = ∑ i ∈ Finset.range t, G 1 ^ i :=
    ⟨_, rfl⟩
  obtain ⟨S, hS_def⟩ : ∃ S : End (wcEtSuppObj Dπ), S = ∑ j ∈ Finset.range (ℓ ^ k), G s' ^ j :=
    ⟨_, rfl⟩
  have hcS : Commute (G 1 - 1) S := by
    rw [hS_def]
    exact Commute.sum_right _ _ _
      (fun j _ => (hc.sub_left (Commute.one_left _)).pow_right j)
  have hct : Commute (G 1 - 1) (G 1 ^ t) :=
    ((Commute.refl (G 1)).sub_left (Commute.one_left _)).pow_right t
  have hA : A * (G 1 - 1) = G 1 ^ t - 1 := by rw [hA_def, geom_sum_mul]
  have e2 : Hd * S * G 1 ^ t * (G 1 - 1) = (G s' ^ (ℓ ^ k) - 1) * G 1 ^ t := by
    calc Hd * S * G 1 ^ t * (G 1 - 1) = Hd * S * (G 1 ^ t * (G 1 - 1)) := by rw [mul_assoc]
      _ = Hd * S * ((G 1 - 1) * G 1 ^ t) := by rw [← hct.eq]
      _ = Hd * (S * (G 1 - 1)) * G 1 ^ t := by simp only [mul_assoc]
      _ = Hd * ((G 1 - 1) * S) * G 1 ^ t := by rw [← hcS.eq]
      _ = Hd * (G 1 - 1) * S * G 1 ^ t := by simp only [mul_assoc]
      _ = (G s' - 1) * S * G 1 ^ t := by rw [hHdE]
      _ = (G s' ^ (ℓ ^ k) - 1) * G 1 ^ t := by rw [hS_def, mul_geom_sum]
  have key : (A + Hd * S * G 1 ^ t) * (G 1 - 1) = G s - 1 := by
    rw [add_mul, hA, e2, hGs, sub_mul, one_mul]
    abel
  have huA : wcEtqmtU Dπ ≫ A = t • wcEtqmtU Dπ := by
    calc wcEtqmtU Dπ ≫ A = ∑ i ∈ Finset.range t, wcEtqmtU Dπ ≫ (G 1 ^ i : End (wcEtSuppObj Dπ)) := by
          rw [hA_def]; exact Preadditive.comp_sum _ _ _
      _ = ∑ i ∈ Finset.range t, wcEtqmtU Dπ :=
          Finset.sum_congr rfl (fun i _ => hupow _ (hu 1) i)
      _ = t • wcEtqmtU Dπ := by rw [Finset.sum_const, Finset.card_range]
  have huS : wcEtqmtU Dπ ≫ S = (ℓ ^ k) • wcEtqmtU Dπ := by
    calc wcEtqmtU Dπ ≫ S = ∑ j ∈ Finset.range (ℓ ^ k),
          wcEtqmtU Dπ ≫ (G s' ^ j : End (wcEtSuppObj Dπ)) := by
          rw [hS_def]; exact Preadditive.comp_sum _ _ _
      _ = ∑ j ∈ Finset.range (ℓ ^ k), wcEtqmtU Dπ :=
          Finset.sum_congr rfl (fun j _ => hupow _ (hu s') j)
      _ = (ℓ ^ k) • wcEtqmtU Dπ := by rw [Finset.sum_const, Finset.card_range]
  have huH : wcEtqmtU Dπ ≫ (A + Hd * S * G 1 ^ t) = t • wcEtqmtU Dπ := by
    have e3 : wcEtqmtU Dπ ≫ (Hd * S * G 1 ^ t) = ((wcEtqmtU Dπ ≫ G 1 ^ t) ≫ S) ≫ Hd := by
      show wcEtqmtU Dπ ≫ ((G 1 ^ t : End (wcEtSuppObj Dπ)) ≫ S ≫ Hd) = _
      simp only [Category.assoc]
    have e4 : wcEtqmtU Dπ ≫ (A + Hd * S * G 1 ^ t) =
        wcEtqmtU Dπ ≫ A + wcEtqmtU Dπ ≫ (Hd * S * G 1 ^ t) :=
      Preadditive.comp_add _ _ _ _ _ _
    rw [e4, e3, huA, hupow _ (hu 1) t, huS, Preadditive.nsmul_comp, htor', add_zero]

  refine ⟨γ s, R s, hπ s, hR1 s, hg s, ?_⟩
  intro Dγs hφs
  have hΓs : wcEtqmtGammaN (hπ s) Dπ Dγs hφs = G s := by
    rw [hGdef]
    exact hcongr rfl _ _ _ _ _ _
  refine ⟨A + Hd * S * G 1 ^ t, ?_, ?_⟩
  · rw [hg1, hΓs]
    exact key
  · rw [ht]
    exact huH

theorem wc_etqmt_tower_data (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) (π : A) (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (r : ℕ)
    (U : Scheme.{u}) (g : U ⟶ Spec (.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r))))
    (fX : U ⟶ Spec (.of A)) (hfX : fX = g ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r))
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A))
    (σ : Spec (.of Ω) ⟶ Spec (.of Ω)) (hσ : σ ≫ ξ = ξ)
    (htame : wcMntTame ℓ (Spec.preimage ξ).hom (Spec.preimage σ).hom π)
    (σQ : Limits.pullback fX ξ ⟶ Limits.pullback fX ξ)
    (hσQ1 : σQ ≫ Limits.pullback.fst fX ξ = Limits.pullback.fst fX ξ)
    (hσQ2 : σQ ≫ Limits.pullback.snd fX ξ = Limits.pullback.snd fX ξ ≫ σ) :
    Nonempty (wcEtqmtTower ℓ g fX ξ σ σQ ⟨0, by omega⟩) :=
by
  classical
  have hp : Nat.Prime ℓ := Fact.out
  have hℓ0 : ℓ ≠ 0 := hp.ne_zero
  have hnat : ∀ {R S : CommRingCat.{u}} (f : R ⟶ S) (y : R),
      (Spec.map f).appTop.hom ((Scheme.ΓSpecIso R).inv.hom y) =
        (Scheme.ΓSpecIso S).inv.hom (f.hom y) := by
    intro R S f y
    have h2 := congrArg (fun k => k.hom y) (Scheme.ΓSpecIso_inv_naturality f)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h2
    exact h2.symm

  have key : ∀ {B : Type u} [CommRing B] (φA : A →+* Ω) (_hφA : Function.Injective φA)
      (σ' : Ω →+* Ω) (XE : Scheme.{u}) (p : XE ⟶ Spec (.of B)) (q : XE ⟶ Spec (.of Ω))
      (w : XE ⟶ XE) (_hw₁ : w ≫ p = p) (_hw₂ : w ≫ q = q ≫ Spec.map (CommRingCat.ofHom σ'))
      (x₀ : B) (_hx0 : IsUnit (p.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom x₀))),
      Nonempty (wcQmtmTower ℓ φA σ' p q w x₀) := by
    intro B _ φA hφA σ XE p q w hw₁ hw₂ x₀ hx0
    have hlk : ((ℓ : ℕ) : IsLocalRing.ResidueField A) ≠ 0 := by
      have := hℓ.map (IsLocalRing.residue A)
      rw [map_natCast] at this
      exact this.ne_zero
    haveI : NeZero ((ℓ : ℕ) : IsLocalRing.ResidueField A) := ⟨hlk⟩
    have hroot : ∀ c : A, IsUnit c → ∃ a : A, a ^ ℓ = c := by
      intro c hc
      obtain ⟨bb, hbb⟩ := IsSepClosed.exists_pow_nat_eq (IsLocalRing.residue A c) ℓ
      obtain ⟨b, rfl⟩ := IsLocalRing.residue_surjective bb
      have hcres : IsLocalRing.residue A c ≠ 0 :=
        (IsLocalRing.residue_ne_zero_iff_isUnit c).mpr hc
      have hb : IsUnit b := by
        rw [← IsLocalRing.residue_ne_zero_iff_isUnit]
        intro h; apply hcres; rw [← hbb, h, zero_pow hℓ0]
