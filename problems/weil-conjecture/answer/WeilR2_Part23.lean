    let θb : wcQuadModelRing A (r + 2) π (wcSrmC0 A r) →+*
        MvPolynomial (Fin (r + 2)) (IsLocalRing.ResidueField A) := Ideal.Quotient.lift IM θ hker
    have hθb : ∀ f, θb (Ideal.Quotient.mk IM f) = θ f := fun f => Ideal.Quotient.lift_mk _ _ _
