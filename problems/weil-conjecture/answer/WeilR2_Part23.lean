theorem wc_r1s_push_gm_tau : ∀ {Q T : Scheme.{u}} (h : Q ⟶ T), ∃ τ : ∀ V : T.Etale, Additive (Γ(((wcEtBaseChange h).obj V).left, ⊤))ˣ →+ ((wcEtPush h).obj (wcEtGm Q)).obj.obj (Opposite.op V), (∀ {V W : T.Etale} (c : W ⟶ V) (a : (Γ(((wcEtBaseChange h).obj V).left, ⊤))ˣ), (((wcEtPush h).obj (wcEtGm Q)).obj.map c.op).hom (τ V (Additive.ofMul a)) = τ W (Additive.ofMul (Units.map ((wcEtBaseChange h).map c).left.appTop.hom.toMonoidHom a))) ∧ (∀ (V : T.Etale) (σ : ((wcEtPush h).obj (wcEtGm Q)).obj.obj (Opposite.op V)) (v : V.left), ∃ (W : T.Etale) (c : W ⟶ V) (w : W.left) (b : (Γ(((wcEtBaseChange h).obj W).left, ⊤))ˣ), c.left w = v ∧ (((wcEtPush h).obj (wcEtGm Q)).obj.map c.op).hom σ = τ W (Additive.ofMul b)) ∧ (∀ (V : T.Etale) (a : (Γ(((wcEtBaseChange h).obj V).left, ⊤))ˣ), τ V (Additive.ofMul a) = 0 → ∀ v : V.left, ∃ (W : T.Etale) (c : W ⟶ V) (w : W.left), c.left w = v ∧ Units.map ((wcEtBaseChange h).map c).left.appTop.hom.toMonoidHom a = 1) :=
