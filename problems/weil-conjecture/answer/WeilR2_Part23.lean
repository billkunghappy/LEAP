    rw [hΦb j] at h
    exact h

theorem wc_etqm_r1s_Y_criterion_mp (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    (r : ℕ) (π : A) (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    (X' : Scheme.{u}) (β : X' ⟶ Spec (.of (wcR1sR A r π))) (f' : X' ⟶ Spec (.of A))
    (hf' : β ≫ wcQuadModelStr A (r + 2) π (wcR1sCH A r) = f')
    (φ : wcR1sR A r π →+* wcR1sM A r π) (e : Spec (.of (wcR1sM A r π)) ⟶ X') [IsOpenImmersion e]
    (hβ : e ≫ β = Spec.map (CommRingCat.ofHom φ))
    (hA : φ.comp (algebraMap A (wcR1sR A r π)) = algebraMap A (wcR1sM A r π))
    (hJ : Ideal.map φ (wcR1sJ A r π) = Ideal.span {wcR1sY0 A r π}) :
    ∀ (y : Spec (.of (wcR1sM A r π))) (z : ↥(Limits.pullback f' (wcQmSp A))),
      Limits.pullback.fst f' (wcQmSp A) z = e y →
      z ∈ closure (wcSrhlExc A (r + 2) π (wcR1sCH A r) β f')ᶜ ∩ wcSrhlExc A (r + 2) π (wcR1sCH A r) β f' →
      wcR1sY0 A r π ∈ y.asIdeal ∧ wcR1sY1 A r π ∈ y.asIdeal :=
by
  classical
  set ι := Limits.pullback.fst f' (wcQmSp A) with hιdef
  set y0 := wcR1sY0 A r π with hy0def
  set y1 := wcR1sY1 A r π with hy1def

  have hβpt : ∀ (y' : Spec (.of (wcR1sM A r π))) (a : wcR1sR A r π),
      a ∈ (β (e y')).asIdeal ↔ φ a ∈ y'.asIdeal := by
    intro y' a
    have h1 : β (e y') = (e ≫ β) y' := (Scheme.Hom.comp_apply e β y').symm
    rw [h1, hβ, Spec.map_apply]
    rfl
  have hfpt : ∀ (y' : Spec (.of (wcR1sM A r π))) (a : A),
      a ∈ (f' (e y')).asIdeal ↔ algebraMap A (wcR1sM A r π) a ∈ y'.asIdeal := by
    intro y' a
    have h1 : f' (e y') = (wcQuadModelStr A (r + 2) π (wcR1sCH A r)) (β (e y')) := by
      rw [← hf', Scheme.Hom.comp_apply]
    rw [h1, ← hA, RingHom.comp_apply, ← hβpt]
    simp only [wcQuadModelStr, Spec.map_apply]
    rfl

  have hexc : ∀ (z' : ↥(Limits.pullback f' (wcQmSp A))) (y' : Spec (.of (wcR1sM A r π))),
      ι z' = e y' → (z' ∈ wcSrhlExc A (r + 2) π (wcR1sCH A r) β f' ↔ y0 ∈ y'.asIdeal) := by
    intro z' y' hz'
    have h1 : z' ∈ wcSrhlExc A (r + 2) π (wcR1sCH A r) β f' ↔
        (Set.range fun i : Fin (r + 2) =>
          Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcR1sCH A r))
            (MvPolynomial.X (⟨2 * (i.val / 2), lt_of_le_of_lt (Nat.mul_div_le i.val 2) i.isLt⟩ :
              Fin (r + 2)))) ⊆ ((β (e y')).asIdeal : Set _) := by
      have hc : (Limits.pullback.fst f' (wcQmSp A) ≫ β) z' = β (e y') := by
        rw [Scheme.Hom.comp_apply, ← hιdef, hz']
      change (Set.range fun i : Fin (r + 2) =>
          Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcR1sCH A r))
            (MvPolynomial.X (⟨2 * (i.val / 2), lt_of_le_of_lt (Nat.mul_div_le i.val 2) i.isLt⟩ :
              Fin (r + 2)))) ⊆ (((Limits.pullback.fst f' (wcQmSp A) ≫ β) z').asIdeal : Set _) ↔ _
      rw [hc]
    rw [h1]
    have h2 : (β (e y')).asIdeal = Ideal.comap φ y'.asIdeal := by
      ext a; rw [hβpt]; rfl
    rw [h2, ← Ideal.span_le]
    change wcR1sJ A r π ≤ Ideal.comap φ y'.asIdeal ↔ _
    rw [← Ideal.map_le_iff_le_comap, hJ, Ideal.span_singleton_le_iff_mem]

  have hprod : y0 * y1 = algebraMap A (wcR1sM A r π) π := by
    have Lc0 : ∑ a, ∑ b, MvPolynomial.C (wcR1sC0 A r a b) * MvPolynomial.X a * MvPolynomial.X b =
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) * MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) :
          MvPolynomial (Fin (r + 2)) A) := by
      rw [Finset.sum_eq_single (⟨0, by omega⟩ : Fin (r + 2))]
      · rw [Finset.sum_eq_single (⟨1, by omega⟩ : Fin (r + 2))]
        · simp
        · intro b _ hb
          have : b.val ≠ 1 := fun h => hb (Fin.ext h)
          simp [this]
        · simp
      · intro a _ ha
        have : a.val ≠ 0 := fun h => ha (Fin.ext h)
        simp [this]
      · simp
    have hal : algebraMap A (wcR1sM A r π) π =
        Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcR1sC0 A r)) (MvPolynomial.C π) := rfl
    rw [hal, hy0def, hy1def, ← map_mul, Ideal.Quotient.eq]
    unfold wcQuadModelIdeal
    rw [← Lc0]
    exact Ideal.mem_span_singleton_self _

  have hspec : ∀ (z' : ↥(Limits.pullback f' (wcQmSp A))) (y' : Spec (.of (wcR1sM A r π))),
      ι z' = e y' → y0 * y1 ∈ y'.asIdeal := by
    intro z' y' hz'
    have hcond : f' (ι z') = (wcQmSp A) (Limits.pullback.snd f' (wcQmSp A) z') := by
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hιdef, Limits.pullback.condition]
    have hπmem : π ∈ (f' (ι z')).asIdeal := by
      rw [hcond]
      have gen : ∀ p : Spec (.of (IsLocalRing.ResidueField A)),
          π ∈ (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) p).asIdeal ↔
            IsLocalRing.residue A π ∈ p.asIdeal := fun p => Iff.rfl
      simp only [wcQmSp]
      rw [gen, (IsLocalRing.residue_eq_zero_iff π).mpr
        (by rw [hπ]; exact Ideal.mem_span_singleton_self π)]
      exact zero_mem _
    rw [hz', hfpt] at hπmem
    rw [hprod]
    exact hπmem

  intro y z hyz hz
  have h0 : y0 ∈ y.asIdeal := (hexc z y hyz).mp hz.2
  refine ⟨h0, ?_⟩
  by_contra hy1
  set D : Set (Spec (.of (wcR1sM A r π))) := {p | y1 ∉ p.asIdeal} with hD
  have hDo : IsOpen D := PrimeSpectrum.isOpen_basicOpen (a := y1)
  have hU : IsOpen (e '' D) := (Scheme.Hom.isOpenEmbedding e).isOpenMap D hDo
  have hN : IsOpen (ι ⁻¹' (e '' D)) := hU.preimage (Scheme.Hom.continuous ι)
  have hzN : z ∈ ι ⁻¹' (e '' D) := by
    show ι z ∈ e '' D
    rw [hyz]
    exact ⟨y, hy1, rfl⟩
  obtain ⟨z', hz'N, hz'Z⟩ := mem_closure_iff.mp hz.1 _ hN hzN
  obtain ⟨y', hy'D, hy'⟩ := hz'N
  have hy'1 : y1 ∉ y'.asIdeal := hy'D
  have hmul := hspec z' y' hy'.symm
  have hy'0 : y0 ∈ y'.asIdeal := (y'.isPrime.mem_or_mem hmul).resolve_right hy'1
  exact hz'Z ((hexc z' y' hy'.symm).mpr hy'0)

theorem wc_r1s_unit_ratio {R M : Type u} [CommRing R] [CommRing M] (φ ψ : R →+* M) (J : Ideal R)
    (p q : M) (hφ : Ideal.map φ J = Ideal.span {p}) (hψ : Ideal.map ψ J = Ideal.span {q})
    (hp : p ∈ nonZeroDivisors M) (W : Scheme.{u}) (a c : W ⟶ Spec (.of M)) [Etale a] [Etale c]
    (hac : a ≫ Spec.map (CommRingCat.ofHom φ) = c ≫ Spec.map (CommRingCat.ofHom ψ)) :
    ∃ u : (Γ(W, ⊤))ˣ, a.appTop.hom ((Scheme.ΓSpecIso (.of M)).inv.hom p) =
      (u : Γ(W, ⊤)) * c.appTop.hom ((Scheme.ΓSpecIso (.of M)).inv.hom q) :=
by
  classical

  have s1 : ∀ {S : Type u} [CommRing S] (x y : S), Ideal.span {x} = Ideal.span {y} →
      x ∈ nonZeroDivisors S → ∃ u : Sˣ, x = (u : S) * y := by
    intro S _ x y hxy hx
    have hx' : x ∈ Ideal.span {y} := hxy ▸ Ideal.mem_span_singleton_self x
    have hy' : y ∈ Ideal.span {x} := hxy.symm ▸ Ideal.mem_span_singleton_self y
    obtain ⟨s, hs⟩ := Ideal.mem_span_singleton'.mp hx'
    obtain ⟨s', hs'⟩ := Ideal.mem_span_singleton'.mp hy'
    have h0 : (s * s' - 1) * x = 0 := by
      have : x = (s * s') * x := by rw [mul_assoc, hs', hs]
      calc (s * s' - 1) * x = (s * s') * x - x := by ring
        _ = 0 := by rw [← this, sub_self]
    have h1 : s * s' = 1 := sub_eq_zero.mp ((mem_nonZeroDivisors_iff.mp hx).2 _ h0)
    refine ⟨⟨s, s', h1, by rw [mul_comm]; exact h1⟩, ?_⟩
    simp [hs]

  have s2 : a.appTop.hom ((Scheme.ΓSpecIso (.of M)).inv.hom p) ∈ nonZeroDivisors Γ(W, ⊤) := by
    set P := a.appTop.hom ((Scheme.ΓSpecIso (.of M)).inv.hom p) with hP
    have key : ∀ x : Γ(W, ⊤), P * x = 0 → x = 0 := by
      intro x hx
      refine Scheme.OpenCover.ext_elem x 0 W.affineCover (fun i => ?_)
      change (W.affineCover.f i).appTop.hom x = (W.affineCover.f i).appTop.hom 0
      rw [map_zero]
      set g := W.affineCover.f i ≫ a with hg
      have hgf : Flat g := inferInstance
      have hF1 : (g.appTop).hom.Flat := HasRingHomProperty.appTop @Flat g hgf
      have hF2 : ((Scheme.ΓSpecIso (.of M)).inv.hom).Flat :=
        RingHom.Flat.of_bijective (ConcreteCategory.bijective_of_isIso _)
      have hF : ((g.appTop).hom.comp (Scheme.ΓSpecIso (.of M)).inv.hom).Flat :=
        RingHom.Flat.comp hF2 hF1
      let F := (g.appTop).hom.comp (Scheme.ΓSpecIso (.of M)).inv.hom
      letI := F.toAlgebra
      haveI : Module.Flat M Γ(W.affineCover.X i, ⊤) := hF
      have hreg := Module.Flat.isSMulRegular_of_nonZeroDivisors (M := Γ(W.affineCover.X i, ⊤)) hp
      have hFp : F p = (W.affineCover.f i).appTop.hom P := by
        simp only [F, RingHom.comp_apply, hg, hP, Scheme.Hom.comp_appTop, CommRingCat.hom_comp]
      have hmul : F p * (W.affineCover.f i).appTop.hom x = 0 := by
        rw [hFp, ← map_mul, hx, map_zero]
      apply hreg
      change p • (W.affineCover.f i).appTop.hom x = p • (0 : Γ(W.affineCover.X i, ⊤))
      rw [smul_zero, Algebra.smul_def, RingHom.algebraMap_toAlgebra]
      exact hmul
    exact mem_nonZeroDivisors_iff.mpr ⟨key, fun x hx => key x (by rw [mul_comm]; exact hx)⟩

  set α : M →+* Γ(W, ⊤) := a.appTop.hom.comp (Scheme.ΓSpecIso (.of M)).inv.hom with hα
  set γ : M →+* Γ(W, ⊤) := c.appTop.hom.comp (Scheme.ΓSpecIso (.of M)).inv.hom with hγ
  have s3 : α.comp φ = γ.comp ψ := by
    ext r
    have e1 : (Scheme.ΓSpecIso (.of M)).inv.hom (φ r) =
        (Spec.map (CommRingCat.ofHom φ)).appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom r) :=
      congrArg (fun f => f.hom r) (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom φ))
    have e2 : (Scheme.ΓSpecIso (.of M)).inv.hom (ψ r) =
        (Spec.map (CommRingCat.ofHom ψ)).appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom r) :=
      congrArg (fun f => f.hom r) (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom ψ))
    have e3 : ∀ (f : W ⟶ Spec (.of M)) (h : Spec (.of M) ⟶ Spec (.of R)) (y : Γ(Spec (.of R), ⊤)),
        f.appTop.hom (h.appTop.hom y) = (f ≫ h).appTop.hom y := by
      intro f h y
      rw [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
    simp only [RingHom.comp_apply, hα, hγ]
    rw [e1, e2, e3, e3, hac]

  have s4 : Ideal.span {α p} = Ideal.span {γ q} := by
    have h1 : Ideal.span {α p} = Ideal.map α (Ideal.span {p}) := by
      rw [Ideal.map_span, Set.image_singleton]
    have h2 : Ideal.span {γ q} = Ideal.map γ (Ideal.span {q}) := by
      rw [Ideal.map_span, Set.image_singleton]
    rw [h1, h2, ← hφ, ← hψ, Ideal.map_map, Ideal.map_map, s3]
  obtain ⟨u, hu⟩ := s1 (α p) (γ q) s4 s2
  exact ⟨u, hu⟩

theorem wc_r1s_push_toSheaf_iso_pos : ∀ {T Q : Scheme.{u}} (r : Q ⟶ T) (ℓ : ℕ), 0 < ℓ → ∀ (D : wcEtPullData r ℓ) (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing Q ℓ))) (J : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology Q) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) (n : ℕ), letI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ).Additive := @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D.adj D.additive; Nonempty ((SheafOfModules.toSheaf (wcEtZModRing T ℓ)).obj ((((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology n) ≅ (((wcEtPush r).mapHomologicalComplex (ComplexShape.up ℕ)).obj J.cocomplex).homology n) :=
by
  intro T Q r ℓ hn D I J n
  letI hPadd : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ).Additive :=
    @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D.adj D.additive
  haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology Q) AddCommGrpCat.{u+1}) :=
    wc_et_enough_injectives Q
  haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) :=
    wc_et_enough_injectives T
  haveI := sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology Q) (wcEtZModRing Q ℓ)
  haveI := sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology T) (wcEtZModRing T ℓ)
  haveI hIRQ : HasInjectiveResolutions (SheafOfModules.{u+1} (wcEtZModRing Q ℓ)) :=
    ⟨fun Z => ⟨⟨InjectiveResolution.of Z⟩⟩⟩
  haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.smallEtaleTopology Q)
    (wcEtZModRing Q ℓ)
  haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.smallEtaleTopology T)
    (wcEtZModRing T ℓ)
  have s1 : ∀ (X : Scheme.{u}) (E : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
      [Injective E], Epi (ℓ • 𝟙 E) := by
    intro X E _
    have hP : Injective ((sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj E) :=
      Injective.injective_of_adjoint
        (sheafificationAdjunction (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) E
    have hdiv : ∀ (U : X.Etale)
        (s : ((sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj E).obj
          (Opposite.op U)), ∃ t, ℓ • t = s := by
      intro U s
      let P := (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj E
      let G : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
        yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
      let φ : G ⟶ P :=
        { app := fun V => AddCommGrpCat.ofHom (FreeAbelianGroup.lift
            (fun f : ULift.{u+1} (V.unop ⟶ U) => (P.map f.down.op).hom s))
          naturality := by
            intro V W h
            apply AddCommGrpCat.hom_ext
            apply FreeAbelianGroup.lift_ext
            intro f
            show (FreeAbelianGroup.lift (fun f' : ULift.{u+1} (W.unop ⟶ U) => (P.map f'.down.op).hom s))
                ((G.map h).hom (FreeAbelianGroup.of f)) =
              (P.map h).hom ((FreeAbelianGroup.lift
                (fun f' : ULift.{u+1} (V.unop ⟶ U) => (P.map f'.down.op).hom s)) (FreeAbelianGroup.of f))
            have hG : (G.map h).hom (FreeAbelianGroup.of f) =
                FreeAbelianGroup.of (ULift.up (h.unop ≫ f.down)) := rfl
            rw [hG]
            erw [FreeAbelianGroup.lift_apply_of, FreeAbelianGroup.lift_apply_of]
            show (P.map (h.unop ≫ f.down).op).hom s = (P.map h).hom ((P.map f.down.op).hom s)
            rw [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp]
            rfl }
      have tf : ∀ (Y : Type (u+1)) (a b : FreeAbelianGroup Y), ℓ • a = ℓ • b → a = b := by
        intro Y a b hab
        apply (FreeAbelianGroup.equivFinsupp Y).injective
        ext x
        have hx := congrArg (fun z => FreeAbelianGroup.equivFinsupp Y z x) hab
        simp only [map_nsmul, Finsupp.smul_apply, nsmul_eq_mul] at hx
        exact Int.eq_of_mul_eq_mul_left (by exact_mod_cast hn.ne') hx
      have hmono : Mono (ℓ • 𝟙 G) := by
        have : ∀ V, Mono ((ℓ • 𝟙 G).app V) := by
          intro V
          rw [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.mono_iff_injective]
          intro a b hab
          simp only [AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id, AddMonoidHom.nsmul_apply,
            AddMonoidHom.id_apply] at hab
          exact tf _ a b hab
        exact NatTrans.mono_of_mono_app _
      let g := Injective.factorThru φ (ℓ • 𝟙 G)
      have hg : (ℓ • 𝟙 G) ≫ g = φ := Injective.comp_factorThru φ (ℓ • 𝟙 G)
      rw [Preadditive.nsmul_comp, Category.id_comp] at hg
      refine ⟨(g.app (Opposite.op U)).hom (FreeAbelianGroup.of (ULift.up (𝟙 U))), ?_⟩
      have h1 := congrArg (fun α : G ⟶ P =>
        (α.app (Opposite.op U)).hom (FreeAbelianGroup.of (ULift.up (𝟙 U)))) hg
      have h2 : (φ.app (Opposite.op U)).hom (FreeAbelianGroup.of (ULift.up (𝟙 U))) = s := by
        show (FreeAbelianGroup.lift (fun f : ULift.{u+1} (U ⟶ U) => (P.map f.down.op).hom s))
          (FreeAbelianGroup.of (ULift.up (𝟙 U))) = s
        rw [FreeAbelianGroup.lift_apply_of]
        simp
      rw [← h2, ← h1]
      simp only [NatTrans.app_nsmul, AddCommGrpCat.hom_nsmul]
      rfl
    have hmap : (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map (ℓ • 𝟙 E) =
        ℓ • 𝟙 ((sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj E) := by
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
    apply Functor.epi_of_epi_map (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
    rw [hmap]
    have : ∀ V, Epi ((ℓ • 𝟙 ((sheafToPresheaf (Scheme.smallEtaleTopology X)
        AddCommGrpCat.{u+1}).obj E)).app V) := by
      intro V
      rw [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.epi_iff_surjective]
      intro s
      obtain ⟨t, ht⟩ := hdiv V.unop s
      exact ⟨t, by simpa using ht⟩
    exact NatTrans.epi_of_epi_app _
  have hker : ∀ (E : Sheaf (Scheme.smallEtaleTopology Q) AddCommGrpCat.{u+1}) [Injective E],
      Epi ((wcEtPush r).map (ℓ • 𝟙 E)) → ∀ q : ℕ,
      Limits.IsZero (((wcEtPush r).rightDerived (q + 1)).obj (Limits.kernel (ℓ • 𝟙 E))) := by
    intro E _ hRe q
    let S := ShortComplex.mk (Limits.kernel.ι (ℓ • 𝟙 E)) (ℓ • 𝟙 E) (Limits.kernel.condition _)
    have hS : S.ShortExact := by
      refine ShortComplex.ShortExact.mk' ?_ (by dsimp [S]; infer_instance) (s1 Q E)
      exact S.exact_of_f_is_kernel (Limits.kernelIsKernel (ℓ • 𝟙 E))
    obtain ⟨_, _, hles⟩ := wc_rightDerived_les_package (wcEtPush r) S hS
    obtain ⟨_, δ, h1, h2, _, hex⟩ := hles q
    have hf : ((wcEtPush r).rightDerived (q + 1)).map S.f = 0 :=
      (Functor.isZero_rightDerived_obj_injective_succ (wcEtPush r) q E).eq_of_tgt _ _
    have hδ : δ = 0 := by
      cases q with
      | zero =>
        have hRe' : Epi ((wcEtPush r).map S.g) := hRe
        have hepi : Epi (((wcEtPush r).rightDerived 0).map S.g) := by
          rw [← NatIso.naturality_2 (wcEtPush r).rightDerivedZeroIsoSelf S.g]
          infer_instance
        exact (cancel_epi _).1 (h1.trans Limits.comp_zero.symm)
      | succ m =>
        exact (Functor.isZero_rightDerived_obj_injective_succ (wcEtPush r) m E).eq_of_src _ _
    exact hex.isZero_X₂ hδ hf
  obtain ⟨α₀, hinj₀, hsurj₀, hR⟩ := wc_et_zmod_ring_locbij Q ℓ
  obtain ⟨hfull, hess⟩ := sheafOfModules_toSheaf_torsion_equiv (Scheme.smallEtaleTopology Q)
    (wcEtZModRing Q ℓ) ℓ α₀ hinj₀ hsurj₀
  haveI := hfull
  have hacyc : ∀ (I : SheafOfModules.{u+1} (wcEtZModRing Q ℓ)) [Injective I] (k : ℕ),
