    have hk0 : k' ≫ I.cochainComplex.d 0 1 = 0 := by
      show (I.ι.f 0 ≫ (I.cochainComplexXIso 0 0 rfl).inv) ≫ I.cochainComplex.d 0 1 = 0
      rw [hd01, Category.assoc, Iso.inv_hom_id_assoc, ← Category.assoc,
