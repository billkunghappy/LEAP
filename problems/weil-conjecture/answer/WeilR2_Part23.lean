  obtain ⟨U, hU⟩ : ∃ U : Fin (r + 2) → Fin (r + 2) →
      CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmC0 A r)), ∀ s t, U s t =
        (if s.val / 2 = t.val / 2 then (1 : wcQuadModelRing A (r + 2) π (wcSrmC0 A r))
          else Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r))
