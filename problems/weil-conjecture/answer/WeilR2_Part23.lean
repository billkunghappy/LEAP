      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, ← hjs1, Scheme.Hom.comp_apply, hw,
        heu]
    have h2 : U'.ι (Limits.pullback.fst ((U'.ι ≫ e) ≫ wcQuadModelStr A n π c) (wcQmSp A) w) ∈ U' := by
      have : U'.ι (Limits.pullback.fst ((U'.ι ≫ e) ≫ wcQuadModelStr A n π c) (wcQmSp A) w) ∈
          Set.range U'.ι := ⟨_, rfl⟩
      rwa [Scheme.Opens.range_ι] at this
    have h3 := hiso _ h2 h1
    have h4 : Limits.pullback.fst ((U'.ι ≫ e) ≫ wcQuadModelStr A n π c) (wcQmSp A) w = u' := by
      apply U'.ι.isOpenEmbedding.isEmbedding.injective
