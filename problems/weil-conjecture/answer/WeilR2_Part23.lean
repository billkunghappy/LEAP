  have hu'e : (U'.ι ≫ e) u' = e u := by
    rw [Scheme.Hom.comp_apply, Scheme.Opens.ι_apply]
  have hlift : ((U'.ι ≫ e) ≫ wcQuadModelStr A n π c) u' =
      wcQmSp A (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) := by
