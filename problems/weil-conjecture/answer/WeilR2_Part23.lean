  obtain ⟨K, hKf, hKac, ιA, hbij, hℓK⟩ := wc_snkc_coeff_field F'' (wcP1Over F'').left (D.S i) A Λ W'
    φ a hA (a ≫ (wcP1Over F'').hom) ℓ Fact.out hℓ
  obtain ⟨hg, hodd⟩ := wc_snkc_hyp_relation A π 1 n hnm c P hP D' hD0 hid
  obtain ⟨hg', hodd'⟩ := wc_snkc_hyp_relation A π 1 n hnm c P' hP' D'' hD0' hid'

  let V : Uc.Opens := eQ ⁻¹ᵁ ((PrimeSpectrum.basicOpen (wcSnkcG π c P D') ⊓
    PrimeSpectrum.basicOpen (wcSnkcG π c P' D'')) : (Spec (.of (wcQuadModelRing A n π c))).Opens)
  have hu : u ∈ V := by
    apply (Scheme.Hom.mem_preimage eQ).mpr
    apply TopologicalSpace.Opens.mem_inf.mpr
    exact ⟨(PrimeSpectrum.mem_basicOpen _ _).mpr
        (hg _ (PrimeSpectrum.isPrime (R := wcQuadModelRing A n π c) (eQ u)) hut),
      (PrimeSpectrum.mem_basicOpen _ _).mpr
        (hg' _ (PrimeSpectrum.isPrime (R := wcQuadModelRing A n π c) (eQ u)) hut)⟩

  haveI := hjU
  haveI := heQ
  obtain ⟨W, β, hWV, huW, hβ, hβcp⟩ :=
    wc_et_dnb_bwk_etale_lift jU u V hu B a' (ha'.trans hux.symm)
  let T₀ : (Limits.pullback D.f a).Etale :=
    MorphismProperty.Over.mk ⊤ (W.ι ≫ jU) (by infer_instance)

  obtain ⟨βQ, hβQ⟩ : ∃ βQ : wcQuadModelRing A n π c →+* B,
      Spec.map (CommRingCat.ofHom βQ) = β ≫ W.ι ≫ eQ :=
    ⟨(Spec.preimage (β ≫ W.ι ≫ eQ)).hom, by rw [CommRingCat.ofHom_hom, Spec.map_preimage]⟩
  have hWEa : WeaklyEtale a' := wc_shdata_weaklyEtale x B Λ' W'' φ' a' hsh
  haveI hWEβ : WeaklyEtale β := by
    haveI : WeaklyEtale (β ≫ W.ι ≫ jU) := by rw [hβ]; exact hWEa
    exact WeaklyEtale.of_comp β (W.ι ≫ jU)
  have hWE : WeaklyEtale (Spec.map (CommRingCat.ofHom βQ)) := by
    rw [hβQ]; infer_instance
  have hcpQ : Spec.map (CommRingCat.ofHom βQ) (IsLocalRing.closedPoint B) = eQ u := by
    rw [hβQ, ← hβcp, ← Category.assoc]
    exact comp_ap _ _ _
  have ht : ∀ p, βQ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) ∈
      IsLocalRing.maximalIdeal B := by
    intro p
    have h1 := hut p
    rw [← hcpQ] at h1
    exact h1

  have hπmax : π ∈ IsLocalRing.maximalIdeal A := by
    rw [hπ]
    exact Ideal.mem_span_singleton_self π
  have hfx : Limits.pullback.snd D.f a x = IsLocalRing.closedPoint A := by
    apply wc_shdata_fibre_closed_point _ A Λ W' φ a hA
    calc a (Limits.pullback.snd D.f a x) = (Limits.pullback.snd D.f a ≫ a) x := (comp_ap _ _ _).symm
      _ = (Limits.pullback.fst D.f a ≫ D.f) x := by rw [Limits.pullback.condition]
      _ = D.f (D.xs i (IsLocalRing.closedPoint F'')) := by rw [comp_ap, hx]
      _ = (D.xs i ≫ D.f) (IsLocalRing.closedPoint F'') := (comp_ap _ _ _).symm
      _ = D.S i (IsLocalRing.closedPoint F'') := by rw [D.hxs i]
  obtain ⟨ρ, hρ, hρSpec, hρkill⟩ :=
    wc_et_dnb_bwk_germ_ring A (Limits.pullback.snd D.f a) x hfx B Λ' W'' φ' a' hsh C eC
  have hgSpec : Spec.map (CommRingCat.ofHom (βQ.comp (algebraMap A (wcQuadModelRing A n π c)))) =
      a' ≫ Limits.pullback.snd D.f a := by
    rw [CommRingCat.ofHom_comp, Spec.map_comp, hβQ, ← hβ]
    simp only [Category.assoc]
    rw [hsq]
  have hρπ : ρ (βQ (algebraMap A (wcQuadModelRing A n π c) π)) = 0 :=
    hρkill _ hgSpec π hπmax

  obtain ⟨P₀, D₀, hchoice, hy0, hordK⟩ := wc_et_dnb_bwk_branch_order A π hπ K ιA hbij n hnm c P P'
    hP hP' D' D'' hD0 hD0' hid hid' hPinv B βQ hWE ht C ρ hρ hρπ s t hspan Kb
    (by
      intro R _ _ _ y hy Kb' _ φ0 hA0 M hM j τ hτ
      exact wc_et_dnb_bwk_dvr_kummer_order R y hy Kb' φ0 hA0 M hM j τ hτ)

  obtain ⟨lam, hlam⟩ : ∃ lam : B →+* Kb, lam = (algebraMap C Kb).comp ρ := ⟨_, rfl⟩
  have hgU : eU.inv ≫ U.hom ≫ Limits.pullback.fst a'
      (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) =
      Spec.map (CommRingCat.ofHom lam) := by
    rw [hlam, CommRingCat.ofHom_comp, Spec.map_comp, hρSpec, ← hU]
    simp only [Category.assoc, Iso.hom_inv_id_assoc]
  have hs : lam (βQ (wcSnkcS π c P₀ (⟨2 * (0 : Fin 1).val + 1, by omega⟩ : Fin n))) ≠ 0 := by
    rw [hlam]; exact hy0
  obtain ⟨uD, hunit, huD, hmem, htrans⟩ := wc_et_dnb_bwk_branch_open (wcQuadModelRing A n π c) B Kb
    (W.ι ≫ eQ) β βQ hβQ (Limits.pullback.fst a'
      (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) U.hom eU lam hgU _ hs
  have hpt_comap : ∀ v : Uc, Limits.pullback.snd D.f a (jU v) =
      PrimeSpectrum.comap (algebraMap A (wcQuadModelRing A n π c)) (eQ v) := by
    intro v
    calc Limits.pullback.snd D.f a (jU v) = (jU ≫ Limits.pullback.snd D.f a) v := (comp_ap _ _ _).symm
      _ = (eQ ≫ wcQuadModelStr A n π c) v := by rw [hsq]
      _ = _ := by rw [comp_ap]; exact Spec.map_apply _ _
  refine ⟨T₀, β, hβ, _, ?_, uD, huD, ?_⟩
  ·
    intro w
    have e1 : Limits.pullback.fst T₀.hom (Limits.pullback.fst (Limits.pullback.snd D.f a) ξ) ≫
        T₀.hom ≫ Limits.pullback.snd D.f a =
        Limits.pullback.snd T₀.hom (Limits.pullback.fst (Limits.pullback.snd D.f a) ξ) ≫
          Limits.pullback.snd (Limits.pullback.snd D.f a) ξ ≫ ξ := by
      rw [← Category.assoc, Limits.pullback.condition, Category.assoc, Limits.pullback.condition]
    generalize hz : Limits.pullback.fst T₀.hom (Limits.pullback.fst (Limits.pullback.snd D.f a) ξ) w = z
    have hp1 : Limits.pullback.snd D.f a (T₀.hom z) =
        ξ (Limits.pullback.snd (Limits.pullback.snd D.f a) ξ
          (Limits.pullback.snd T₀.hom (Limits.pullback.fst (Limits.pullback.snd D.f a) ξ) w)) := by
      have := congrArg (fun g => g w) e1
      simp only [comp_ap] at this
      rw [← hz]
      exact this
    have hap : a (Limits.pullback.snd D.f a (T₀.hom z)) = η := by
      rw [hp1, ← comp_ap, hξ]
      exact hγ _ _ _
    have hpne : Limits.pullback.snd D.f a (T₀.hom z) ≠ IsLocalRing.closedPoint A := by
      intro h
      apply hηne
      rw [← hap, h, ha]
    have hTz : T₀.hom z = jU (W.ι z) := comp_ap W.ι jU z
    rw [hTz, hpt_comap] at hpne
    have hπq : algebraMap A (wcQuadModelRing A n π c) π ∉ (eQ (W.ι z)).asIdeal := by
      intro h
      apply hpne
      apply PrimeSpectrum.ext
      have hle : (PrimeSpectrum.comap (algebraMap A (wcQuadModelRing A n π c)) (eQ (W.ι z))).asIdeal
          ≤ IsLocalRing.maximalIdeal A :=
        IsLocalRing.le_maximalIdeal (PrimeSpectrum.isPrime _).ne_top
      have hge : IsLocalRing.maximalIdeal A ≤
          (PrimeSpectrum.comap (algebraMap A (wcQuadModelRing A n π c)) (eQ (W.ι z))).asIdeal := by
        rw [hπ, Ideal.span_le, Set.singleton_subset_iff]
        exact h
      exact le_antisymm hle hge
    have hzW : W.ι z ∈ (W : Set Uc) := by
      rw [← Scheme.Opens.range_ι]
      exact ⟨z, rfl⟩
    have hzV : W.ι z ∈ V := hWV hzW
    have hzV' := (Scheme.Hom.mem_preimage eQ).mp hzV
    obtain ⟨hzG, hzG'⟩ := TopologicalSpace.Opens.mem_inf.mp hzV'
    have hgq : wcSnkcG π c P D' ∉ (eQ (W.ι z)).asIdeal := (PrimeSpectrum.mem_basicOpen _ _).mp hzG
    have hgq' : wcSnkcG π c P' D'' ∉ (eQ (W.ι z)).asIdeal :=
      (PrimeSpectrum.mem_basicOpen _ _).mp hzG'
    have hS0 : wcSnkcS π c P₀ (⟨2 * (0 : Fin 1).val + 1, by omega⟩ : Fin n) ∉
        (eQ (W.ι z)).asIdeal := by
      rcases hchoice with ⟨h1, -⟩ | ⟨h1, -⟩
      · rw [h1]
        obtain ⟨j, hj⟩ := hodd _ (PrimeSpectrum.isPrime (R := wcQuadModelRing A n π c) (eQ (W.ι z)))
          hπq hgq
        obtain rfl : j = 0 := Subsingleton.elim _ _
        exact hj
      · rw [h1]
        obtain ⟨j, hj⟩ := hodd' _ (PrimeSpectrum.isPrime (R := wcQuadModelRing A n π c) (eQ (W.ι z)))
          hπq hgq'
        obtain rfl : j = 0 := Subsingleton.elim _ _
        exact hj
    have hze : (W.ι ≫ eQ) z = eQ (W.ι z) := comp_ap W.ι eQ z
    apply (hmem z).mpr
    intro hin
    apply hS0
    have hin' := hin
    rw [hze] at hin'
    exact hin'
  ·
    have hn1 : n - 1 = 1 := by omega
    rw [hn1]
    have hM : ((ℓ ^ k : ℕ) : K) ≠ 0 := by
      rw [Nat.cast_pow]
      exact pow_ne_zero _ hℓK
    haveI : NeZero ((ℓ ^ k : ℕ) : K) := ⟨hM⟩
    obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot K (ℓ ^ k)
    have hord : ∀ j : ℕ, (∃ t : (Γ(U.left, ⊤))ˣ,
        t ^ (ℓ ^ k) = (Units.map uD.appTop.hom.toMonoidHom hunit.unit) ^ j) → ℓ ^ k ∣ j := by
      intro j h
      obtain ⟨τ', hτ'⟩ := htrans (ℓ ^ k) j h
      rw [hlam] at hτ'
      exact hordK (ℓ ^ k) (pow_pos (Fact.out : ℓ.Prime).pos k) j τ' hτ'
    exact wc_et_dnb_bwk_kummer_order K _ U.left
      (Scheme.Opens.ι _ ≫ (W.ι ≫ eQ) ≫ Spec.map (CommRingCat.ofHom
        ((algebraMap A (wcQuadModelRing A n π c)).comp ιA))) uD (ℓ ^ k) hM ζ hζ hunit.unit hord

theorem wc_etsm_pull_unit_transpose_isIso {Y Y' : Scheme.{u}} (f : Y' ⟶ Y) (m : ℕ)
    (D : wcEtPullData f m) :
    IsIso ((D.adj.homEquiv _ _).symm
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange f) _ _ D.cont D.φ)) :=
by
  classical
  letI := D.cont

  have evbij : ∀ (Z : Scheme.{u}) (T : Z.Etale) (hT : Limits.IsTerminal T)
      (N : SheafOfModules.{u+1} (wcEtZModRing Z m)),
      Function.Bijective (fun φ : SheafOfModules.unit (wcEtZModRing Z m) ⟶ N =>
        (φ.val.app (Opposite.op T)).hom (1 : (wcEtZModRing Z m).obj.obj (Opposite.op T))) := by
    intro Z T hT N
    have hcomp : (fun φ : SheafOfModules.unit (wcEtZModRing Z m) ⟶ N =>
        (φ.val.app (Opposite.op T)).hom (1 : (wcEtZModRing Z m).obj.obj (Opposite.op T))) =
        (fun s : N.val.sections => s.1 (Opposite.op T)) ∘ (SheafOfModules.unitHomEquiv N) := by
      funext φ
      simp only [Function.comp_apply, SheafOfModules.unitHomEquiv_apply_coe]
    rw [hcomp]
    refine Function.Bijective.comp ?_ (SheafOfModules.unitHomEquiv N).bijective
    constructor
    · intro s s' hst
      apply PresheafOfModules.sections_ext
      intro X
      rw [← PresheafOfModules.sections_property s (hT.from X.unop).op,
        ← PresheafOfModules.sections_property s' (hT.from X.unop).op]
      simp only at hst
      rw [hst]
    · intro x
      refine ⟨PresheafOfModules.sectionsMk (fun X => (N.val.map (hT.from X.unop).op).hom x) ?_, ?_⟩
      · intro X X' g
        rw [← PresheafOfModules.map_comp_apply]
        have : (hT.from X.unop).op ≫ g = (hT.from X'.unop).op := by
          apply Quiver.Hom.unop_inj
          exact hT.hom_ext _ _
        rw [this]
      · show (N.val.map (hT.from T).op).hom x = x
        rw [show hT.from T = 𝟙 T from hT.hom_ext _ _]
        first | (simp; done) | (simp; rfl) | rfl

  have hT0 : Limits.IsTerminal (wcEtTop Y) := by
    refine Limits.IsTerminal.ofUniqueHom (fun X => MorphismProperty.Over.homMk
      (X.hom : X.left ⟶ Y) (Category.comp_id _) trivial) ?_
    intro X a
    apply MorphismProperty.Over.Hom.ext
    exact (Category.comp_id _).symm.trans (MorphismProperty.Over.w a)
  have hT1 : Limits.IsTerminal ((wcEtBaseChange f).obj (wcEtTop Y)) := by
    refine Limits.IsTerminal.ofUniqueHom (fun X => MorphismProperty.Over.homMk
      (Limits.pullback.lift (X.hom ≫ f) X.hom (Category.comp_id _) :
        X.left ⟶ Limits.pullback (𝟙 Y) f) (Limits.pullback.lift_snd _ _ _) trivial) ?_
    intro X g
    apply MorphismProperty.Over.Hom.ext
    have hw : (g.left : X.left ⟶ Limits.pullback (𝟙 Y) f) ≫ Limits.pullback.snd (𝟙 Y) f =
        X.hom := MorphismProperty.Over.w g
    have key1 : ∀ (gl : X.left ⟶ Limits.pullback (𝟙 Y) f),
        gl ≫ Limits.pullback.snd (𝟙 Y) f = X.hom →
        gl = Limits.pullback.lift (X.hom ≫ f) X.hom (Category.comp_id _) := by
      intro gl hgl
      apply Limits.pullback.hom_ext
      · rw [Limits.pullback.lift_fst]
        calc gl ≫ Limits.pullback.fst (𝟙 Y) f
            = (gl ≫ Limits.pullback.fst (𝟙 Y) f) ≫ 𝟙 Y := (Category.comp_id _).symm
          _ = gl ≫ Limits.pullback.snd (𝟙 Y) f ≫ f := by
              rw [Category.assoc, Limits.pullback.condition]
          _ = X.hom ≫ f := by rw [← Category.assoc, hgl]
      · rw [Limits.pullback.lift_snd]
        exact hgl
    exact key1 g.left hw

  obtain ⟨E, hE⟩ : ∃ E : (SheafOfModules.unit (wcEtZModRing Y' m) ⟶
      SheafOfModules.unit (wcEtZModRing Y' m)) →
      (wcEtZModRing Y' m).obj.obj (Opposite.op ((wcEtBaseChange f).obj (wcEtTop Y))) →
      (wcEtZModRing Y' m).obj.obj (Opposite.op ((wcEtBaseChange f).obj (wcEtTop Y))),
      ∀ k x, E k x = (k.val.app (Opposite.op ((wcEtBaseChange f).obj (wcEtTop Y)))).hom x :=
    ⟨fun k x => (k.val.app (Opposite.op ((wcEtBaseChange f).obj (wcEtTop Y)))).hom x,
      fun _ _ => rfl⟩
  have hlin : ∀ k x, E k x = x * E k 1 := by
    intro k x
    have e1 := (k.val.app (Opposite.op ((wcEtBaseChange f).obj (wcEtTop Y)))).hom.map_smul x
      (1 : (wcEtZModRing Y' m).obj.obj (Opposite.op ((wcEtBaseChange f).obj (wcEtTop Y))))
    calc E k x = E k (x * 1) := by rw [mul_one]
      _ = x * E k 1 := by rw [hE, hE]; exact e1
  have hcompE : ∀ k k' x, E (k ≫ k') x = E k' (E k x) := by
    intro k k' x
    rw [hE, hE, hE]
    rfl
  have hid : ∀ x, E (𝟙 _) x = x := by
    intro x
    rw [hE]
    rfl

  obtain ⟨F, hF⟩ : ∃ F : (SheafOfModules.unit (wcEtZModRing Y' m) ⟶
      SheafOfModules.unit (wcEtZModRing Y' m)) →
      (wcEtZModRing Y' m).obj.obj (Opposite.op ((wcEtBaseChange f).obj (wcEtTop Y))),
      ∀ k, F k = ((D.adj.homEquiv _ _ (D.μ.hom ≫ k)).val.app (Opposite.op (wcEtTop Y))).hom
        (1 : (wcEtZModRing Y m).obj.obj (Opposite.op (wcEtTop Y))) :=
    ⟨fun k => ((D.adj.homEquiv _ _ (D.μ.hom ≫ k)).val.app (Opposite.op (wcEtTop Y))).hom
        (1 : (wcEtZModRing Y m).obj.obj (Opposite.op (wcEtTop Y))), fun _ => rfl⟩
  obtain ⟨c, hc⟩ : ∃ c : (wcEtZModRing Y' m).obj.obj
      (Opposite.op ((wcEtBaseChange f).obj (wcEtTop Y))),
      c = ((D.adj.homEquiv _ _ D.μ.hom).val.app (Opposite.op (wcEtTop Y))).hom
        (1 : (wcEtZModRing Y m).obj.obj (Opposite.op (wcEtTop Y))) := ⟨_, rfl⟩
  have key : ∀ k, F k = E k c := by
    intro k
    rw [hF, hE, hc, Adjunction.homEquiv_naturality_right]
    rfl

  have hνh : (D.adj.homEquiv _ _).symm
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange f) _ _ D.cont D.φ) =
      D.μ.hom ≫ (D.μ.inv ≫ (D.adj.homEquiv _ _).symm
        (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange f) _ _ D.cont D.φ)) := by
    rw [Iso.hom_inv_id_assoc]
  obtain ⟨h, hh⟩ : ∃ h : SheafOfModules.unit (wcEtZModRing Y' m) ⟶
      SheafOfModules.unit (wcEtZModRing Y' m), h = D.μ.inv ≫ (D.adj.homEquiv _ _).symm
        (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange f) _ _ D.cont D.φ) :=
    ⟨_, rfl⟩
  rw [← hh] at hνh
  have hca : c * E h 1 = 1 := by
    rw [← hlin, ← key, hF, ← hνh, Equiv.apply_symm_apply,
      SheafOfModules.unitToPushforwardObjUnit_val_app_apply]
    exact map_one _

  have hevb := evbij Y' _ hT1 (SheafOfModules.unit (wcEtZModRing Y' m))
  have hsurjE : ∀ x, ∃ k, E k 1 = x := by
    intro x
    obtain ⟨k, hk⟩ := hevb.2 x
    exact ⟨k, by rw [hE]; exact hk⟩
  have hinjE : ∀ k k', E k 1 = E k' 1 → k = k' := by
    intro k k' hkk
    apply hevb.1
    rw [hE, hE] at hkk
    exact hkk
  have hcinj : ∀ x y : (wcEtZModRing Y' m).obj.obj
      (Opposite.op ((wcEtBaseChange f).obj (wcEtTop Y))), c * x = c * y → x = y := by
    intro x y hxy
    obtain ⟨kx, hkx⟩ := hsurjE x
    obtain ⟨ky, hky⟩ := hsurjE y
    have e1 : F kx = F ky := by
      rw [key, key, hlin kx c, hlin ky c, hkx, hky, hxy]
    rw [hF, hF] at e1
    have e2 : D.adj.homEquiv _ _ (D.μ.hom ≫ kx) = D.adj.homEquiv _ _ (D.μ.hom ≫ ky) :=
      (evbij Y _ hT0 _).1 e1
    have e3 : D.μ.hom ≫ kx = D.μ.hom ≫ ky := (D.adj.homEquiv _ _).injective e2
    have e4 : kx = ky := (cancel_epi D.μ.hom).mp e3
    rw [← hkx, ← hky, e4]
  have hac : E h 1 * c = 1 := by
    apply hcinj
    rw [← mul_assoc, hca, one_mul, mul_one]

  obtain ⟨h', hh'⟩ := hsurjE c
  have e1 : h ≫ h' = 𝟙 _ := by
    apply hinjE
    rw [hcompE, hid, hlin h', hh', hac]
  have e2 : h' ≫ h = 𝟙 _ := by
    apply hinjE
    rw [hcompE, hid, hh', hlin, hca]
  haveI : IsIso h := ⟨⟨h', e1, e2⟩⟩
  rw [hνh]
  infer_instance

theorem wc_etsm_unit_end_central (X : Scheme.{u}) (m : ℕ)
    (c : SheafOfModules.unit (wcEtZModRing X m) ⟶ SheafOfModules.unit (wcEtZModRing X m))
    (n : ℕ) (y : wcEtZModExt X m n) :
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing X m)) := HasExt.standard _
    (Abelian.Ext.mk₀ c).comp y (zero_add n) = y.comp (Abelian.Ext.mk₀ c) (add_zero n) :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing X m)) := HasExt.standard _

  have hcomm : ∀ (U : (X.Etale)ᵒᵖ) (a b : (wcEtZModRing X m).obj.obj U), a * b = b * a := by
    obtain ⟨e, -⟩ := wc_et_zmod_ring_sections_lc_equiv X m
    intro U a b
    induction U using Opposite.rec with
    | op V =>
      apply (e V).injective
      rw [map_mul, map_mul, mul_comm]

  have hext : ∃ mt : 𝟭 (SheafOfModules.{u+1} (wcEtZModRing X m)) ⟶
      𝟭 (SheafOfModules.{u+1} (wcEtZModRing X m)),
      mt.app (SheafOfModules.unit (wcEtZModRing X m)) = c := by
    let R := wcEtZModRing X m
    let s := (SheafOfModules.unit R).unitHomEquiv c
    let σ : ∀ U : (X.Etale)ᵒᵖ, R.obj.obj U := fun U => (s.1 U : R.obj.obj U)
    have hσ : ∀ {U V : (X.Etale)ᵒᵖ} (f : U ⟶ V), (R.obj.map f).hom (σ U) = σ V :=
      fun f => PresheafOfModules.sections_property s f
    let L : ∀ (M : SheafOfModules.{u+1} R) (U : (X.Etale)ᵒᵖ), M.val.obj U ⟶ M.val.obj U :=
      fun M U => ModuleCat.ofHom
        { toFun := fun x => σ U • x
          map_add' := fun x y => smul_add _ _ _
          map_smul' := fun r x => by
            simp only [RingHom.id_apply, smul_smul]
            rw [hcomm U] }
    let mM : ∀ M : SheafOfModules.{u+1} R, M ⟶ M := fun M =>
      ⟨PresheafOfModules.Hom.mk (L M) (by
        intro U V f
        ext x
        show σ V • (M.val.map f).hom x = (M.val.map f).hom (σ U • x)
        rw [PresheafOfModules.map_smul, hσ])⟩
    refine ⟨{ app := mM, naturality := ?_ }, ?_⟩
    · intro M N g
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro U
      ext x
      show σ U • (g.val.app U).hom x = (g.val.app U).hom (σ U • x)
      exact ((g.val.app U).hom.map_smul _ _).symm
    · apply (SheafOfModules.unit R).unitHomEquiv.injective
      apply PresheafOfModules.sections_ext
      intro U
      rw [SheafOfModules.unitHomEquiv_apply_coe]
      show σ U • (1 : R.obj.obj U) = s.1 U
      rw [smul_eq_mul, mul_one]

  have hcen : ∀ (τ : 𝟭 (SheafOfModules.{u+1} (wcEtZModRing X m)) ⟶
      𝟭 (SheafOfModules.{u+1} (wcEtZModRing X m))) (z : wcEtZModExt X m n),
      (Abelian.Ext.mk₀ (τ.app (SheafOfModules.unit (wcEtZModRing X m)))).comp z (zero_add n) =
        z.comp (Abelian.Ext.mk₀ (τ.app (SheafOfModules.unit (wcEtZModRing X m)))) (add_zero n) := by
    intro τ z
    have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp z τ
    simp only [Abelian.Ext.id_mapExactFunctor] at h
    exact h.symm

  obtain ⟨mt, hm⟩ := hext
  subst hm
  exact hcen mt y

theorem wc_et_bwx_slice_corep_unit {X : Scheme.{u}} (m : ℕ) (T : X.Etale)
    [hc : (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)]
    (ψ : wcEtZModRing T.left m ⟶ ((wcEtSlice T).sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)).obj (wcEtZModRing X m))
    (P : SheafOfModules.{u+1} (wcEtZModRing X m))
    (ev : ∀ M : SheafOfModules.{u+1} (wcEtZModRing X m), (P ⟶ M) ≃ M.val.obj (Opposite.op T))
    (hnat : ∀ (M N : SheafOfModules.{u+1} (wcEtZModRing X m)) (φ : M ⟶ N) (k : P ⟶ M),
      ev N (k ≫ φ) = (φ.val.app (Opposite.op T)).hom (ev M k))
    (ιT : (wcEtSlice T).obj (wcEtTop T.left) ⟶ T) (hιT : ιT.left = 𝟙 T.left) :
    ∃ ε : SheafOfModules.unit (wcEtZModRing T.left m) ⟶ (SheafOfModules.pushforward.{u+1} ψ).obj P,
      (∀ Y : SheafOfModules.{u+1} (wcEtZModRing X m),
        Function.Bijective (fun f : P ⟶ Y => ε ≫ (SheafOfModules.pushforward.{u+1} ψ).map f)) ∧
      (ε.val.app (Opposite.op (wcEtTop T.left))).hom
        (1 : (wcEtZModRing T.left m).obj.obj (Opposite.op (wcEtTop T.left))) =
        (P.val.map ιT.op).hom (ev P (𝟙 P)) :=
by
  classical
  have s1 : ∀ (Z : Scheme.{u}) (N : SheafOfModules.{u+1} (wcEtZModRing Z m)),
      Function.Bijective (fun φ : SheafOfModules.unit (wcEtZModRing Z m) ⟶ N =>
        (φ.val.app (Opposite.op (wcEtTop Z))).hom
          (1 : (wcEtZModRing Z m).obj.obj (Opposite.op (wcEtTop Z)))) := by
    intro Z N
    let τ : ∀ X : Z.Etale, X ⟶ wcEtTop Z := fun X =>
      MorphismProperty.Over.homMk (X.hom : X.left ⟶ Z) (Category.comp_id _) trivial
    have huniq : ∀ (X : Z.Etale) (a b : X ⟶ wcEtTop Z), a = b := by
      intro X a b
      apply MorphismProperty.Over.Hom.ext
      have ha : a.left = X.hom := (Category.comp_id _).symm.trans (MorphismProperty.Over.w a)
      have hb : b.left = X.hom := (Category.comp_id _).symm.trans (MorphismProperty.Over.w b)
      rw [ha, hb]
    have hcomp : (fun φ : SheafOfModules.unit (wcEtZModRing Z m) ⟶ N =>
        (φ.val.app (Opposite.op (wcEtTop Z))).hom
          (1 : (wcEtZModRing Z m).obj.obj (Opposite.op (wcEtTop Z)))) =
        (fun s : N.val.sections => s.1 (Opposite.op (wcEtTop Z))) ∘
          (SheafOfModules.unitHomEquiv N) := by
      funext φ
      simp only [Function.comp_apply, SheafOfModules.unitHomEquiv_apply_coe]
    rw [hcomp]
    refine Function.Bijective.comp ?_ (SheafOfModules.unitHomEquiv N).bijective
    constructor
    · intro s s' hst
      apply PresheafOfModules.sections_ext
      intro X
      rw [← PresheafOfModules.sections_property s (τ X.unop).op,
        ← PresheafOfModules.sections_property s' (τ X.unop).op]
      simp only at hst
      rw [hst]
    · intro x
      refine ⟨PresheafOfModules.sectionsMk (fun X => (N.val.map (τ X.unop).op).hom x) ?_, ?_⟩
      · intro X X' g
        rw [← PresheafOfModules.map_comp_apply]
        have : (τ X.unop).op ≫ g = (τ X'.unop).op := by
          apply Quiver.Hom.unop_inj
          exact huniq _ _ _
        rw [this]
      · show (N.val.map (τ (wcEtTop Z)).op).hom x = x
        rw [show τ (wcEtTop Z) = 𝟙 (wcEtTop Z) from huniq _ _ _]
        first | (simp; done) | (simp; rfl) | rfl
  let e : P.val.obj (Opposite.op T) := ev P (𝟙 P)
  have hQ : ∀ M : SheafOfModules.{u+1} (wcEtZModRing X m),
      Function.Bijective (fun φ : P ⟶ M => (φ.val.app (Opposite.op T)).hom e) := by
    intro M
    have hfe : (fun φ : P ⟶ M => (φ.val.app (Opposite.op T)).hom e) = ev M := by
      funext φ
      have h := hnat P M φ (𝟙 _)
      rw [Category.id_comp] at h
      exact h.symm
    rw [hfe]
    exact (ev M).bijective
  let ιinv : T ⟶ (wcEtSlice T).obj (wcEtTop T.left) :=
    MorphismProperty.Over.homMk (𝟙 T.left) (by first | rfl | simp) trivial
  have hιι : ιT ≫ ιinv = 𝟙 _ := by
    apply MorphismProperty.Over.Hom.ext
    show ιT.left ≫ 𝟙 T.left = 𝟙 T.left
    exact (Category.comp_id _).trans hιT
  have hιinvι : ιinv ≫ ιT = 𝟙 T := by
    apply MorphismProperty.Over.Hom.ext
    show 𝟙 T.left ≫ ιT.left = 𝟙 T.left
    exact (Category.id_comp _).trans hιT
  have hmapbij : ∀ M : SheafOfModules.{u+1} (wcEtZModRing X m),
      Function.Bijective (M.val.map ιT.op).hom := by
    intro M
    have h1 : ∀ x, (M.val.map ιinv.op).hom ((M.val.map ιT.op).hom x) = x := by
      intro x
      rw [← PresheafOfModules.map_comp_apply, ← op_comp, hιinvι, op_id]
      first | (simp; done) | (simp; rfl) | rfl
    have h2 : ∀ y, (M.val.map ιT.op).hom ((M.val.map ιinv.op).hom y) = y := by
      intro y
      rw [← PresheafOfModules.map_comp_apply, ← op_comp, hιι, op_id]
      first | (simp; done) | (simp; rfl) | rfl
    exact ⟨fun a b hab => by rw [← h1 a, ← h1 b, hab], fun y => ⟨_, h2 y⟩⟩
  obtain ⟨ε, hε0⟩ := (s1 T.left ((SheafOfModules.pushforward.{u+1} ψ).obj P)).2
      ((P.val.map ιT.op).hom e)
  have hε : (ε.val.app (Opposite.op (wcEtTop T.left))).hom
      (1 : (wcEtZModRing T.left m).obj.obj (Opposite.op (wcEtTop T.left))) =
      (P.val.map ιT.op).hom e := hε0
  have hhom : ∀ M : SheafOfModules.{u+1} (wcEtZModRing X m),
      Function.Bijective (fun φ : P ⟶ M =>
        ε ≫ (SheafOfModules.pushforward.{u+1} ψ).map φ) := by
    intro M
    have hpt : ∀ φ : P ⟶ M,
        ((ε ≫ (SheafOfModules.pushforward.{u+1} ψ).map φ).val.app
          (Opposite.op (wcEtTop T.left))).hom
          (1 : (wcEtZModRing T.left m).obj.obj (Opposite.op (wcEtTop T.left))) =
        (M.val.map ιT.op).hom ((φ.val.app (Opposite.op T)).hom e) := by
      intro φ
      show (((SheafOfModules.pushforward.{u+1} ψ).map φ).val.app
          (Opposite.op (wcEtTop T.left))).hom ((ε.val.app (Opposite.op (wcEtTop T.left))).hom
            (1 : (wcEtZModRing T.left m).obj.obj (Opposite.op (wcEtTop T.left)))) = _
      rw [hε]
      exact PresheafOfModules.naturality_apply φ.val ιT.op e
    have hb := (hmapbij M).comp (hQ M)
    refine (Function.Bijective.of_comp_iff'
      (s1 T.left ((SheafOfModules.pushforward.{u+1} ψ).obj M)) _).mp ?_
    refine ⟨fun a b hab => hb.1 ?_, fun y => ?_⟩
    · have := hab
      simp only [Function.comp_apply] at this
      rw [hpt, hpt] at this
      exact this
    · obtain ⟨φ, hφ⟩ := hb.2 y
      exact ⟨φ, (hpt φ).trans hφ⟩
  exact ⟨ε, hhom, hε⟩

theorem wc_et_bwx_push_slice_nat {S Z W : Scheme.{u}} (i : Z ⟶ S) (w : W ⟶ Z) (m : ℕ)
    (Di : wcEtPullData i m) (Dw : wcEtPullData w m)
    (V : S.Etale) (V' : W.Etale) (fU : V'.left ⟶ V.left) (hK : fU ≫ V.hom = V'.hom ≫ w ≫ i)
    [hc : (wcEtSlice V).IsContinuous (Scheme.smallEtaleTopology V.left) (Scheme.smallEtaleTopology S)]
    [hc' : (wcEtSlice V').IsContinuous (Scheme.smallEtaleTopology V'.left) (Scheme.smallEtaleTopology W)]
    (ψ : wcEtZModRing V.left m ⟶ ((wcEtSlice V).sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.smallEtaleTopology V.left) (Scheme.smallEtaleTopology S)).obj (wcEtZModRing S m))
    (ψ' : wcEtZModRing V'.left m ⟶ ((wcEtSlice V').sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.smallEtaleTopology V'.left) (Scheme.smallEtaleTopology W)).obj (wcEtZModRing W m))
    (D : wcEtPullData fU m) :
    ∃ β : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange w) _ _ Dw.cont Dw.φ ⋙
          @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ Di.cont Di.φ) ⋙
          SheafOfModules.pushforward.{u+1} ψ ⟶
        SheafOfModules.pushforward.{u+1} ψ' ⋙
          @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange fU) _ _ D.cont D.φ,
      ∀ (M : SheafOfModules.{u+1} (wcEtZModRing W m)) (T : V.left.Etale)
        (ζ : (wcEtSlice V').obj ((wcEtBaseChange fU).obj T) ⟶
          (wcEtBaseChange w).obj ((wcEtBaseChange i).obj ((wcEtSlice V).obj T))),
        ζ.left ≫ Limits.pullback.fst (Limits.pullback.snd (T.hom ≫ V.hom) i) w ≫
            Limits.pullback.fst (T.hom ≫ V.hom) i = Limits.pullback.fst T.hom fU →
        ζ.left ≫ Limits.pullback.snd (Limits.pullback.snd (T.hom ≫ V.hom) i) w =
            Limits.pullback.snd T.hom fU ≫ V'.hom →
        ∀ x : ((SheafOfModules.pushforward.{u+1} ψ).obj
            ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ Di.cont Di.φ).obj
              ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange w) _ _ Dw.cont Dw.φ).obj
                M))).val.obj (Opposite.op T),
          ((β.app M).val.app (Opposite.op T)).hom x = (M.val.map ζ.op).hom x :=
by
  have zmodExt : ∀ (Y : Scheme.{u}) (m : ℕ)
      (R : Sheaf (Scheme.smallEtaleTopology Y) RingCat.{u+1}) (φ ψ : wcEtZModRing Y m ⟶ R),
      φ = ψ := by
    intro Y m R φ ψ
    have key : ∀ (T : Type (u+1)) [Semiring T] (f g : ULift.{u+1} (ZMod m) →+* T), f = g := by
      intro T _ f g
      have h : f.comp (ULift.ringEquiv : ULift.{u+1} (ZMod m) ≃+* ZMod m).symm.toRingHom =
          g.comp (ULift.ringEquiv : ULift.{u+1} (ZMod m) ≃+* ZMod m).symm.toRingHom :=
        Subsingleton.elim _ _
      ext x
      exact RingHom.congr_fun h x.down
    apply ((sheafificationAdjunction (Scheme.smallEtaleTopology Y) RingCat.{u+1}).homEquiv _
      R).injective
    apply NatTrans.ext
    funext U
    apply RingCat.hom_ext
    exact key _ _ _
  have hBCfst : ∀ {X Y : Scheme.{u}} (h : X ⟶ Y) {A B : Y.Etale} (g : A ⟶ B),
      ((wcEtBaseChange h).map g).left ≫ Limits.pullback.fst B.hom h =
        Limits.pullback.fst A.hom h ≫ g.left := by
    intro X Y h A B g
    exact Limits.pullback.lift_fst _ _ _
  have hBCsnd : ∀ {X Y : Scheme.{u}} (h : X ⟶ Y) {A B : Y.Etale} (g : A ⟶ B),
      ((wcEtBaseChange h).map g).left ≫ Limits.pullback.snd B.hom h =
        Limits.pullback.snd A.hom h := by
    intro X Y h A B g
    exact Limits.pullback.lift_snd _ _ _
  have sqAux : ∀ {P₁ P₂ Q₁ Q₂ A₁ A₂ B₁ B₂ Z : Scheme.{u}} (a : P₁ ⟶ P₂) (b : Q₁ ⟶ Q₂)
      (e₁ : P₁ ⟶ Q₁) (e₂ : P₂ ⟶ Q₂) (x₁ : P₁ ⟶ A₁) (x₂ : P₂ ⟶ A₂) (y₁ : P₁ ⟶ B₁) (y₂ : P₂ ⟶ B₂)
      (p₁ : Q₁ ⟶ A₁) (p₂ : Q₂ ⟶ A₂) (q₁ : Q₁ ⟶ Z) (q₂ : Q₂ ⟶ Z) (gA : A₁ ⟶ A₂) (v₁ : B₁ ⟶ Z)
      (v₂ : B₂ ⟶ Z) (hext : ∀ φ ψ : P₁ ⟶ Q₂, φ ≫ p₂ = ψ ≫ p₂ → φ ≫ q₂ = ψ ≫ q₂ → φ = ψ)
      (h1 : e₁ ≫ p₁ = x₁) (h2 : e₂ ≫ p₂ = x₂) (h3 : e₁ ≫ q₁ = y₁ ≫ v₁) (h4 : e₂ ≫ q₂ = y₂ ≫ v₂)
      (ha1 : a ≫ x₂ = x₁ ≫ gA) (ha2 : a ≫ y₂ ≫ v₂ = y₁ ≫ v₁) (hb1 : b ≫ p₂ = p₁ ≫ gA)
      (hb2 : b ≫ q₂ = q₁),
      a ≫ e₂ = e₁ ≫ b := by
    intro P₁ P₂ Q₁ Q₂ A₁ A₂ B₁ B₂ Z a b e₁ e₂ x₁ x₂ y₁ y₂ p₁ p₂ q₁ q₂ gA v₁ v₂ hext h1 h2 h3 h4
      ha1 ha2 hb1 hb2
    apply hext
    · rw [Category.assoc, Category.assoc, h2, ha1, hb1, ← Category.assoc, h1]
    · rw [Category.assoc, Category.assoc, h4, ha2, hb2, h3]

  have hin : ∀ T : V.left.Etale, Limits.pullback.fst T.hom fU ≫ (T.hom ≫ V.hom) =
      (Limits.pullback.snd T.hom fU ≫ V'.hom ≫ w) ≫ i := by
    intro T
    rw [← Category.assoc, Limits.pullback.condition, Category.assoc, hK]
    simp only [Category.assoc]
  have hlam : ∀ T : V.left.Etale, ∃ l : Limits.pullback T.hom fU ⟶
      Limits.pullback (T.hom ≫ V.hom) i,
      l ≫ Limits.pullback.fst (T.hom ≫ V.hom) i = Limits.pullback.fst T.hom fU ∧
      l ≫ Limits.pullback.snd (T.hom ≫ V.hom) i = Limits.pullback.snd T.hom fU ≫ (V'.hom ≫ w) :=
    fun T => ⟨Limits.pullback.lift _ _ (hin T), Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩
  choose lam hlam1 hlam2 using hlam
  have hout : ∀ T : V.left.Etale, lam T ≫ Limits.pullback.snd (T.hom ≫ V.hom) i =
      (Limits.pullback.snd T.hom fU ≫ V'.hom) ≫ w := by
    intro T
    rw [hlam2, Category.assoc]
  have ha0 : ∀ T : V.left.Etale, ∃ a : Limits.pullback T.hom fU ⟶
      Limits.pullback (Limits.pullback.snd (T.hom ≫ V.hom) i) w,
      a ≫ Limits.pullback.fst (Limits.pullback.snd (T.hom ≫ V.hom) i) w = lam T ∧
      a ≫ Limits.pullback.snd (Limits.pullback.snd (T.hom ≫ V.hom) i) w =
        Limits.pullback.snd T.hom fU ≫ V'.hom :=
    fun T => ⟨Limits.pullback.lift _ _ (hout T), Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩
  choose a0 ha01 ha02 using ha0
  have ha0fa : ∀ T : V.left.Etale,
      a0 T ≫ Limits.pullback.fst (Limits.pullback.snd (T.hom ≫ V.hom) i) w ≫
        Limits.pullback.fst (T.hom ≫ V.hom) i = Limits.pullback.fst T.hom fU := by
    intro T
    rw [← Category.assoc, ha01, hlam1]
  let α : wcEtBaseChange fU ⋙ wcEtSlice V' ⟶
      (wcEtSlice V ⋙ wcEtBaseChange i) ⋙ wcEtBaseChange w :=
    { app := fun T => MorphismProperty.Over.homMk (a0 T) (ha02 T) trivial
      naturality := by
        intro T₁ T₂ g
        have hm1 : ((wcEtBaseChange fU).map g).left ≫ Limits.pullback.fst T₂.hom fU =
            Limits.pullback.fst T₁.hom fU ≫ g.left := hBCfst fU g
        have hm2 : ((wcEtBaseChange fU).map g).left ≫ Limits.pullback.snd T₂.hom fU =
            Limits.pullback.snd T₁.hom fU := hBCsnd fU g
        have hn1 : ((wcEtBaseChange i).map ((wcEtSlice V).map g)).left ≫
            Limits.pullback.fst (T₂.hom ≫ V.hom) i =
              Limits.pullback.fst (T₁.hom ≫ V.hom) i ≫ g.left :=
          hBCfst i ((wcEtSlice V).map g)
        have hn2 : ((wcEtBaseChange i).map ((wcEtSlice V).map g)).left ≫
            Limits.pullback.snd (T₂.hom ≫ V.hom) i = Limits.pullback.snd (T₁.hom ≫ V.hom) i :=
          hBCsnd i ((wcEtSlice V).map g)
        have hk1 : ((wcEtBaseChange w).map ((wcEtBaseChange i).map ((wcEtSlice V).map g))).left ≫
            Limits.pullback.fst (Limits.pullback.snd (T₂.hom ≫ V.hom) i) w =
              Limits.pullback.fst (Limits.pullback.snd (T₁.hom ≫ V.hom) i) w ≫
                ((wcEtBaseChange i).map ((wcEtSlice V).map g)).left :=
          hBCfst w ((wcEtBaseChange i).map ((wcEtSlice V).map g))
        have hk2 : ((wcEtBaseChange w).map ((wcEtBaseChange i).map ((wcEtSlice V).map g))).left ≫
            Limits.pullback.snd (Limits.pullback.snd (T₂.hom ≫ V.hom) i) w =
              Limits.pullback.snd (Limits.pullback.snd (T₁.hom ≫ V.hom) i) w :=
          hBCsnd w ((wcEtBaseChange i).map ((wcEtSlice V).map g))
        have hinner : ((wcEtBaseChange fU).map g).left ≫ lam T₂ =
            lam T₁ ≫ ((wcEtBaseChange i).map ((wcEtSlice V).map g)).left :=
          sqAux _ _ _ _ _ _ _ _ _ _ _ _ g.left (V'.hom ≫ w) (V'.hom ≫ w)
            (fun φ ψ h₁ h₂ => Limits.pullback.hom_ext h₁ h₂)
            (hlam1 T₁) (hlam1 T₂) (hlam2 T₁) (hlam2 T₂) hm1
            ((Category.assoc _ _ _).symm.trans (congrArg (· ≫ (V'.hom ≫ w)) hm2)) hn1 hn2
        apply MorphismProperty.Over.Hom.ext
        exact sqAux _ _ _ _ _ _ _ _ _ _ _ _ _ V'.hom V'.hom
          (fun φ ψ h₁ h₂ => Limits.pullback.hom_ext h₁ h₂)
          (ha01 T₁) (ha01 T₂) (ha02 T₁) (ha02 T₂) hinner
          ((Category.assoc _ _ _).symm.trans (congrArg (· ≫ V'.hom) hm2)) hk1 hk2 }

  haveI := Di.cont
  haveI := Dw.cont
  haveI := D.cont
  haveI : (wcEtSlice V ⋙ wcEtBaseChange i).IsContinuous (Scheme.smallEtaleTopology V.left)
      (Scheme.smallEtaleTopology Z) :=
    Functor.isContinuous_comp _ _ _ (Scheme.smallEtaleTopology S) _
  haveI : ((wcEtSlice V ⋙ wcEtBaseChange i) ⋙ wcEtBaseChange w).IsContinuous
      (Scheme.smallEtaleTopology V.left) (Scheme.smallEtaleTopology W) :=
    Functor.isContinuous_comp _ _ _ (Scheme.smallEtaleTopology Z) _
  haveI : (wcEtBaseChange fU ⋙ wcEtSlice V').IsContinuous (Scheme.smallEtaleTopology V.left)
      (Scheme.smallEtaleTopology W) :=
    Functor.isContinuous_comp _ _ _ (Scheme.smallEtaleTopology V'.left) _
  let φ₀ : wcEtZModRing V.left m ⟶ ((wcEtSlice V ⋙ wcEtBaseChange i).sheafPushforwardContinuous
      RingCat.{u+1} (Scheme.smallEtaleTopology V.left) (Scheme.smallEtaleTopology Z)).obj
        (wcEtZModRing Z m) :=
    ψ ≫ ((wcEtSlice V).sheafPushforwardContinuous
      RingCat.{u+1} (Scheme.smallEtaleTopology V.left) (Scheme.smallEtaleTopology S)).map Di.φ
  let φG : wcEtZModRing V.left m ⟶
      (((wcEtSlice V ⋙ wcEtBaseChange i) ⋙ wcEtBaseChange w).sheafPushforwardContinuous
        RingCat.{u+1} (Scheme.smallEtaleTopology V.left) (Scheme.smallEtaleTopology W)).obj
          (wcEtZModRing W m) :=
    φ₀ ≫ ((wcEtSlice V ⋙ wcEtBaseChange i).sheafPushforwardContinuous
      RingCat.{u+1} (Scheme.smallEtaleTopology V.left) (Scheme.smallEtaleTopology Z)).map Dw.φ
