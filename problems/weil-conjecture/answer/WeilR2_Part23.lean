  have hM : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
      (MvPolynomial.X 0 * MvPolynomial.X 1) =
      algebraMap A (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) π := by
    show _ = Ideal.Quotient.mk _ (MvPolynomial.C π)
    rw [Ideal.Quotient.eq, ← hF]
    exact Ideal.mem_span_singleton_self _
  have hΨ : ∀ a ∈ (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} :
      Ideal (MvPolynomial (Fin (r + 2)) (IsLocalRing.ResidueField A))), e₀ a = 0 := by
    intro a ha
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul, map_mul]
    simp only [e₀, MvPolynomial.eval₂Hom_X']
    rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, ← map_mul, hM,
      Algebra.TensorProduct.tmul_one_eq_one_tmul, hres]
    first
      | (rw [← Algebra.TensorProduct.includeRight_apply, map_zero, mul_zero])
      | (rw [TensorProduct.tmul_zero]; exact mul_zero (M₀ := TensorProduct A (wcQuadModelRing A (r + 2) π (Matrix.of fun i j : Fin (r + 2) =>
        if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (IsLocalRing.ResidueField A)) _)
  let Ψ₀ := Ideal.Quotient.lift (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} :
      Ideal (MvPolynomial (Fin (r + 2)) (IsLocalRing.ResidueField A))) e₀
      (fun a ha => by simpa using hΨ a ha)
  have hΨX : ∀ k : Fin (r + 2), Ψ₀ (Ideal.Quotient.mk _ (MvPolynomial.X k)) =
      Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
        (MvPolynomial.X k) ⊗ₜ[A] (1 : IsLocalRing.ResidueField A) := by
    intro k
    simp only [Ψ₀, Ideal.Quotient.lift_mk, e₀, MvPolynomial.eval₂Hom_X']
  have hΨC : ∀ c : IsLocalRing.ResidueField A, Ψ₀ (Ideal.Quotient.mk _ (MvPolynomial.C c)) =
      (1 : wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
        ⊗ₜ[A] c := by
    intro c
    simp only [Ψ₀, Ideal.Quotient.lift_mk, e₀, MvPolynomial.eval₂Hom_C, AlgHom.toRingHom_eq_coe,
      AlgHom.coe_toRingHom, Algebra.TensorProduct.includeRight_apply]
  have hβ : ∀ c : IsLocalRing.ResidueField A, β c = Ideal.Quotient.mk _ (MvPolynomial.C c) := by
    intro c
    rfl

  have inv1 : Φ₀.toRingHom.comp Ψ₀ = RingHom.id _ := by
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro c
      show Φ₀ (Ψ₀ (Ideal.Quotient.mk _ (MvPolynomial.C c))) = Ideal.Quotient.mk _ (MvPolynomial.C c)
      rw [hΨC, Algebra.TensorProduct.productMap_apply_tmul, map_one, one_mul, hβ]
    · intro i
      show Φ₀ (Ψ₀ (Ideal.Quotient.mk _ (MvPolynomial.X i))) = Ideal.Quotient.mk _ (MvPolynomial.X i)
      rw [hΨX, hΦX]

  have h6a : Ψ₀.comp (α : wcQuadModelRing A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) →+* _) =
      Algebra.TensorProduct.includeLeftRingHom := by
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro a
      show Ψ₀ (α (Ideal.Quotient.mk _ (MvPolynomial.C a))) =
        Ideal.Quotient.mk _ (MvPolynomial.C a) ⊗ₜ[A] (1 : IsLocalRing.ResidueField A)
      rw [hαC]
      show Ψ₀ (Ideal.Quotient.mk _ (MvPolynomial.C (algebraMap A (IsLocalRing.ResidueField A) a))) =
        algebraMap A (wcQuadModelRing A (r + 2) π
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) a
          ⊗ₜ[A] (1 : IsLocalRing.ResidueField A)
      rw [hΨC, Algebra.TensorProduct.tmul_one_eq_one_tmul]
    · intro i
      show Ψ₀ (α (Ideal.Quotient.mk _ (MvPolynomial.X i))) =
        Ideal.Quotient.mk _ (MvPolynomial.X i) ⊗ₜ[A] (1 : IsLocalRing.ResidueField A)
      rw [hαX, hΨX]
  have inv2 : Ψ₀.comp Φ₀.toRingHom = RingHom.id _ := by
    apply RingHom.ext
    intro x
    induction x using TensorProduct.induction_on with
    | zero => simp
    | tmul m k =>
      show Ψ₀ (Φ₀ (m ⊗ₜ[A] k)) = m ⊗ₜ[A] k
      rw [Algebra.TensorProduct.productMap_apply_tmul, map_mul]
      have h1 : Ψ₀ (α m) = m ⊗ₜ[A] (1 : IsLocalRing.ResidueField A) := by
        have := RingHom.congr_fun h6a m
        simpa using this
      rw [h1, hβ, hΨC, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    | add x y hx hy =>
      simp only [RingHom.comp_apply, RingHom.id_apply, map_add] at hx hy ⊢
      rw [hx, hy]
  exact ⟨RingEquiv.ofRingHom Φ₀.toRingHom Ψ₀ inv1 inv2, fun k => hΦX k⟩

theorem wc_sfh_special_chart_iso : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (R T : Type u) [CommRing R] [Algebra A R] [CommRing T] (X' : Scheme.{u}) (f' : X' ⟶ Spec (.of A)) (e : Spec (.of R) ⟶ X') [IsOpenImmersion e], e ≫ f' = Spec.map (CommRingCat.ofHom (algebraMap A R)) → ∀ (Φ : TensorProduct A R (IsLocalRing.ResidueField A) ≃+* T), ∃ φ : Spec (.of T) ≅ ((Limits.pullback.fst f' (wcQmSp A)) ⁻¹ᵁ e.opensRange : Scheme.{u}), φ.hom ≫ ((Limits.pullback.fst f' (wcQmSp A)) ⁻¹ᵁ e.opensRange).ι ≫ Limits.pullback.fst f' (wcQmSp A) = Spec.map (CommRingCat.ofHom (Φ.toRingHom.comp Algebra.TensorProduct.includeLeftRingHom)) ≫ e :=
by
  intro A _ _ R T _ _ _ X' f' e _ he Φ
  have hr : Set.range (Limits.pullback.snd e (Limits.pullback.fst f' (wcQmSp A))) =
      Set.range ((Limits.pullback.fst f' (wcQmSp A)) ⁻¹ᵁ e.opensRange).ι := by
    rw [Scheme.Pullback.range_snd, Scheme.Opens.range_ι, Scheme.Hom.coe_preimage,
      Scheme.Hom.coe_opensRange]
  let j1 := IsOpenImmersion.isoOfRangeEq (Limits.pullback.snd e (Limits.pullback.fst f' (wcQmSp A)))
    ((Limits.pullback.fst f' (wcQmSp A)) ⁻¹ᵁ e.opensRange).ι hr
  let j2 := Limits.pullbackRightPullbackFstIso f' (wcQmSp A) e
  have hq : wcQmSp A = Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))) :=
    rfl
  let j3 := Limits.pullback.congrHom he hq
  let j4 := pullbackSpecIso A R (IsLocalRing.ResidueField A)
  have hc1 : (CommRingCat.ofHom Φ.symm.toRingHom ≫ CommRingCat.ofHom Φ.toRingHom) =
      𝟙 (CommRingCat.of T) := by
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro x
    simp
  have hc2 : (CommRingCat.ofHom Φ.toRingHom ≫ CommRingCat.ofHom Φ.symm.toRingHom) =
      𝟙 (CommRingCat.of (TensorProduct A R (IsLocalRing.ResidueField A))) := by
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro x
    simp
  let j5 : Spec (.of T) ≅ Spec (.of (TensorProduct A R (IsLocalRing.ResidueField A))) :=
    { hom := Spec.map (CommRingCat.ofHom Φ.toRingHom)
      inv := Spec.map (CommRingCat.ofHom Φ.symm.toRingHom)
      hom_inv_id := by
        rw [← Spec.map_comp, hc1, Spec.map_id]
      inv_hom_id := by
        rw [← Spec.map_comp, hc2, Spec.map_id] }
  refine ⟨j5 ≪≫ j4.symm ≪≫ j3.symm ≪≫ j2.symm ≪≫ j1, ?_⟩
  have h1 : j1.hom ≫ ((Limits.pullback.fst f' (wcQmSp A)) ⁻¹ᵁ e.opensRange).ι =
      Limits.pullback.snd e (Limits.pullback.fst f' (wcQmSp A)) :=
    IsOpenImmersion.isoOfRangeEq_hom_fac _ _ _
  have h2 : j2.inv ≫ Limits.pullback.fst e (Limits.pullback.fst f' (wcQmSp A)) =
      Limits.pullback.fst (e ≫ f') (wcQmSp A) :=
    Limits.pullbackRightPullbackFstIso_inv_fst _ _ _
  have h3 : j3.inv ≫ Limits.pullback.fst (e ≫ f') (wcQmSp A) =
      Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap A R)))
        (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))) := by
    have hinv := Limits.pullback.congrHom_inv he hq
    show (Limits.pullback.congrHom he hq).inv ≫ _ = _
    rw [hinv]
    simp only [Limits.pullback.map, Limits.pullback.lift_fst, Category.comp_id]
  have h4 : j4.inv ≫ Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap A R)))
        (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))) =
      Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) :=
    pullbackSpecIso_inv_fst _ _ _
  have hφ : (j5 ≪≫ j4.symm ≪≫ j3.symm ≪≫ j2.symm ≪≫ j1).hom =
      j5.hom ≫ j4.inv ≫ j3.inv ≫ j2.inv ≫ j1.hom := rfl
  rw [hφ]
  simp only [Category.assoc]
  rw [reassoc_of% h1, ← Limits.pullback.condition, reassoc_of% h2, reassoc_of% h3,
    reassoc_of% h4]
  rw [← Spec.map_comp_assoc]
  rfl

theorem wc_sfh_node_basicOpen_preconn : ∀ (K : Type u) [Field K] (r : ℕ), (∃ x : PrimeSpectrum (MvPolynomial (Fin (r + 2)) K ⧸ (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} : Ideal (MvPolynomial (Fin (r + 2)) K))), ∀ g : MvPolynomial (Fin (r + 2)) K, MvPolynomial.aeval (fun k : Fin (r + 2) => if k.val < 2 then (0 : MvPolynomial (Fin (r + 2)) K) else MvPolynomial.X k) g ≠ 0 → Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) g ∉ x.asIdeal) ∧ ∀ g : MvPolynomial (Fin (r + 2)) K, MvPolynomial.aeval (fun k : Fin (r + 2) => if k.val < 2 then (0 : MvPolynomial (Fin (r + 2)) K) else MvPolynomial.X k) g ≠ 0 → _root_.IsPreconnected (PrimeSpectrum.basicOpen (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} : Ideal (MvPolynomial (Fin (r + 2)) K)) g) : Set (PrimeSpectrum (MvPolynomial (Fin (r + 2)) K ⧸ (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} : Ideal (MvPolynomial (Fin (r + 2)) K))))) :=
by
  intro K _ r
  classical

  have kerPrime : ∀ φ : MvPolynomial (Fin (r + 2)) K →ₐ[K] MvPolynomial (Fin (r + 2)) K,
      φ (MvPolynomial.X 0 * MvPolynomial.X 1) = 0 →
      ∃ a : PrimeSpectrum (MvPolynomial (Fin (r + 2)) K ⧸ (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} : Ideal (MvPolynomial (Fin (r + 2)) K))),
        ∀ g : MvPolynomial (Fin (r + 2)) K,
          Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) g ∈ a.asIdeal ↔ φ g = 0 := by
    intro φ hφ
    have H : ∀ c ∈ (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} : Ideal (MvPolynomial (Fin (r + 2)) K)),
        (φ : MvPolynomial (Fin (r + 2)) K →+* MvPolynomial (Fin (r + 2)) K) c = 0 := by
      intro c hc
      obtain ⟨t, rfl⟩ := Ideal.mem_span_singleton'.mp hc
      rw [map_mul]
      change _ * φ (MvPolynomial.X 0 * MvPolynomial.X 1) = 0
      rw [hφ, mul_zero]
    let φb := Ideal.Quotient.lift (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} : Ideal (MvPolynomial (Fin (r + 2)) K))
      (φ : MvPolynomial (Fin (r + 2)) K →+* MvPolynomial (Fin (r + 2)) K) H
    refine ⟨⟨RingHom.ker φb, RingHom.ker_isPrime φb⟩, fun g => ?_⟩
    show Ideal.Quotient.mk _ g ∈ RingHom.ker φb ↔ _
    rw [RingHom.mem_ker, Ideal.Quotient.lift_mk]
    rfl

  have comp : ∀ j : Fin (r + 2), j.val < 2 →
      ∃ a : PrimeSpectrum (MvPolynomial (Fin (r + 2)) K ⧸ (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} : Ideal (MvPolynomial (Fin (r + 2)) K))),
        (∀ g : MvPolynomial (Fin (r + 2)) K,
          Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) g ∈ a.asIdeal →
          MvPolynomial.aeval (fun k : Fin (r + 2) => if k.val < 2 then (0 : MvPolynomial (Fin (r + 2)) K) else MvPolynomial.X k) g = 0) ∧
        ∀ q : PrimeSpectrum (MvPolynomial (Fin (r + 2)) K ⧸ (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} : Ideal (MvPolynomial (Fin (r + 2)) K))),
          Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) (MvPolynomial.X j) ∈ q.asIdeal → a ≤ q := by
    intro j hj
    have hj01 : j = 0 ∨ j = 1 := by
      rcases (show j.val = 0 ∨ j.val = 1 by omega) with h | h
      · left; exact Fin.ext h
      · right; exact Fin.ext (by rw [h, Fin.val_one])
    have hφI : (MvPolynomial.aeval (fun k : Fin (r + 2) => if k = j then (0 : MvPolynomial (Fin (r + 2)) K) else MvPolynomial.X k))
        (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (r + 2)) K) = 0 := by
      rcases hj01 with h | h <;> simp [h]
    have hθφ : ∀ g : MvPolynomial (Fin (r + 2)) K,
        MvPolynomial.aeval (fun k : Fin (r + 2) => if k.val < 2 then (0 : MvPolynomial (Fin (r + 2)) K) else MvPolynomial.X k)
          (MvPolynomial.aeval (fun k : Fin (r + 2) => if k = j then (0 : MvPolynomial (Fin (r + 2)) K) else MvPolynomial.X k) g) =
        MvPolynomial.aeval (fun k : Fin (r + 2) => if k.val < 2 then (0 : MvPolynomial (Fin (r + 2)) K) else MvPolynomial.X k) g := by
      have h : (MvPolynomial.aeval (fun k : Fin (r + 2) => if k.val < 2 then (0 : MvPolynomial (Fin (r + 2)) K) else MvPolynomial.X k)).comp
          (MvPolynomial.aeval (fun k : Fin (r + 2) => if k = j then (0 : MvPolynomial (Fin (r + 2)) K) else MvPolynomial.X k)) =
          MvPolynomial.aeval (fun k : Fin (r + 2) => if k.val < 2 then (0 : MvPolynomial (Fin (r + 2)) K) else MvPolynomial.X k) := by
        apply MvPolynomial.algHom_ext
        intro k
        rw [AlgHom.comp_apply, MvPolynomial.aeval_X, MvPolynomial.aeval_X]
        by_cases hk : k = j
        · subst hk; simp [hj]
        · simp [hk]
      intro g
      have := congrArg (fun F => F g) h
      simpa only [AlgHom.comp_apply] using this
    have hker : ∀ f : MvPolynomial (Fin (r + 2)) K,
        MvPolynomial.aeval (fun k : Fin (r + 2) => if k = j then (0 : MvPolynomial (Fin (r + 2)) K) else MvPolynomial.X k) f = 0 →
        f ∈ Ideal.span {(MvPolynomial.X j : MvPolynomial (Fin (r + 2)) K)} := by
      intro f hf
      have h : (Ideal.Quotient.mkₐ K (Ideal.span {(MvPolynomial.X j : MvPolynomial (Fin (r + 2)) K)})).comp
          (MvPolynomial.aeval (fun k : Fin (r + 2) => if k = j then (0 : MvPolynomial (Fin (r + 2)) K) else MvPolynomial.X k)) =
          Ideal.Quotient.mkₐ K (Ideal.span {(MvPolynomial.X j : MvPolynomial (Fin (r + 2)) K)}) := by
        apply MvPolynomial.algHom_ext
        intro k
        rw [AlgHom.comp_apply, MvPolynomial.aeval_X]
        by_cases hk : k = j
        · subst hk
          rw [if_pos rfl, map_zero, Ideal.Quotient.mkₐ_eq_mk]
          symm
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
        · rw [if_neg hk]
      have h2 := congrArg (fun F => F f) h
      simp only [AlgHom.comp_apply] at h2
      rw [hf, map_zero, Ideal.Quotient.mkₐ_eq_mk] at h2
      exact Ideal.Quotient.eq_zero_iff_mem.mp h2.symm
    obtain ⟨a, ha⟩ := kerPrime _ hφI
    refine ⟨a, fun g hg => ?_, fun q hq => ?_⟩
    · rw [← hθφ g, (ha g).mp hg, map_zero]
    · rw [← PrimeSpectrum.asIdeal_le_asIdeal]
      intro h hh
      obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective h
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp (hker f ((ha f).mp hh))
      rw [map_mul]
      exact Ideal.mul_mem_left _ _ hq
  have hθI : MvPolynomial.aeval (fun k : Fin (r + 2) => if k.val < 2 then (0 : MvPolynomial (Fin (r + 2)) K) else MvPolynomial.X k)
      (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (r + 2)) K) = 0 := by
    simp
  obtain ⟨p, hp⟩ := kerPrime _ hθI
  obtain ⟨a, ha1, ha2⟩ := comp 0 (by simp)
  obtain ⟨b, hb1, hb2⟩ := comp 1 (by rw [Fin.val_one]; omega)
  have hle : ∀ c : PrimeSpectrum (MvPolynomial (Fin (r + 2)) K ⧸ (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} : Ideal (MvPolynomial (Fin (r + 2)) K))),
      (∀ g : MvPolynomial (Fin (r + 2)) K,
          Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) g ∈ c.asIdeal →
          MvPolynomial.aeval (fun k : Fin (r + 2) => if k.val < 2 then (0 : MvPolynomial (Fin (r + 2)) K) else MvPolynomial.X k) g = 0) →
      p ∈ closure ({c} : Set _) := by
    intro c hc
    rw [← PrimeSpectrum.le_iff_mem_closure, ← PrimeSpectrum.asIdeal_le_asIdeal]
    intro h hh
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective h
    exact (hp f).mpr (hc f hh)
  refine ⟨⟨p, fun g hg hmem => hg ((hp g).mp hmem)⟩, ?_⟩
  intro g hg
  have hU : ∀ c : PrimeSpectrum (MvPolynomial (Fin (r + 2)) K ⧸ (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} : Ideal (MvPolynomial (Fin (r + 2)) K))),
      (∀ g : MvPolynomial (Fin (r + 2)) K,
          Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) g ∈ c.asIdeal →
          MvPolynomial.aeval (fun k : Fin (r + 2) => if k.val < 2 then (0 : MvPolynomial (Fin (r + 2)) K) else MvPolynomial.X k) g = 0) →
      c ∈ (PrimeSpectrum.basicOpen (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} : Ideal (MvPolynomial (Fin (r + 2)) K)) g) : Set _) := by
    intro c hc
    rw [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen]
    exact fun hm => hg (hc g hm)
  have hpU := hU p (fun g hm => (hp g).mp hm)
  apply isPreconnected_of_forall p
  intro y hy
  have key : ∀ c, c ∈ (PrimeSpectrum.basicOpen (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} : Ideal (MvPolynomial (Fin (r + 2)) K)) g) : Set _) →
      p ∈ closure ({c} : Set _) → y ∈ closure ({c} : Set _) →
      ∃ t ⊆ (PrimeSpectrum.basicOpen (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} : Ideal (MvPolynomial (Fin (r + 2)) K)) g) : Set _),
        p ∈ t ∧ y ∈ t ∧ _root_.IsPreconnected t := by
    intro c hc hpc hyc
    refine ⟨{c, p, y}, ?_, by simp, by simp, ?_⟩
    · intro z hz
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
      rcases hz with h | h | h <;> rw [h] <;> assumption
    · refine isPreconnected_singleton.subset_closure (s := ({c} : Set _)) ?_ ?_
      · intro z hz
        rw [Set.mem_singleton_iff] at hz
        rw [hz]; exact Set.mem_insert _ _
      · intro z hz
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
        rcases hz with h | h | h <;> rw [h]
        · exact subset_closure rfl
        · exact hpc
        · exact hyc
  have h0 : Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} : Ideal (MvPolynomial (Fin (r + 2)) K)) (MvPolynomial.X 0) *
      Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} : Ideal (MvPolynomial (Fin (r + 2)) K)) (MvPolynomial.X 1) ∈ y.asIdeal := by
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)]
    exact y.asIdeal.zero_mem
  rcases y.isPrime.mem_or_mem h0 with h | h
  · exact key a (hU a ha1) (hle a ha1) ((PrimeSpectrum.le_iff_mem_closure a y).mp (ha2 y h))
  · exact key b (hU b hb1) (hle b hb1) ((PrimeSpectrum.le_iff_mem_closure b y).mp (hb2 y h))

theorem wc_etqm_sfh_special_charts (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    (π : A) (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (r : ℕ)
    (X' : Scheme.{u}) (f' : X' ⟶ Spec (.of A))
    (e : Fin (r + 2) → (Spec (.of (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))) ⟶ X'))
    (he1 : ∀ s, IsOpenImmersion (e s))
    (he2 : ∀ x : X', ∃ s, x ∈ Set.range (e s))
    (he3 : ∀ s, e s ≫ f' = wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
    (he4 : ∀ (s t : Fin (r + 2)) (y : Spec (.of (wcQuadModelRing A (r + 2) π
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))),
        e s y ∈ Set.range (e t) ↔
          (if s.val / 2 = t.val / 2 then (1 : wcQuadModelRing A (r + 2) π
              (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
            else Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
              (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
              (MvPolynomial.X (⟨2 * ((if t.val / 2 = 0 then s else t).val / 2),
                lt_of_le_of_lt (Nat.mul_div_le _ 2) (if t.val / 2 = 0 then s else t).isLt⟩ :
                Fin (r + 2)))) ∉ PrimeSpectrum.asIdeal y) :
    ∃ V : Fin (r + 2) → (Limits.pullback f' (wcQmSp A)).Opens,
      (∀ z : ↥(Limits.pullback f' (wcQmSp A)), ∃ i, z ∈ V i) ∧
      (∀ i, Nonempty ((V i : Scheme.{u}) ≅
        Spec (.of (MvPolynomial (Fin (r + 2)) (IsLocalRing.ResidueField A) ⧸
          (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} :
            Ideal (MvPolynomial (Fin (r + 2)) (IsLocalRing.ResidueField A))))))) ∧
      (∀ i j, _root_.IsPreconnected ((V i ⊓ V j : (Limits.pullback f' (wcQmSp A)).Opens) :
        Set ↥(Limits.pullback f' (wcQmSp A)))) ∧
      (∀ i j, ((V 0 ⊓ V i ⊓ V j : (Limits.pullback f' (wcQmSp A)).Opens) :
        Set ↥(Limits.pullback f' (wcQmSp A))).Nonempty) :=
by
  haveI : ∀ s, IsOpenImmersion (e s) := he1
  have hπm : π ∈ IsLocalRing.maximalIdeal A := by
    rw [hπ]; exact Ideal.mem_span_singleton_self π
  obtain ⟨Φ, hΦ⟩ := wc_sfh_special_tensor_equiv A π hπm r
  obtain ⟨ρ, hρ_def⟩ : ∃ ρ : wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) →+*
      (MvPolynomial (Fin (r + 2)) (IsLocalRing.ResidueField A) ⧸
          (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} :
            Ideal (MvPolynomial (Fin (r + 2)) (IsLocalRing.ResidueField A)))),
      ρ = Φ.toRingHom.comp Algebra.TensorProduct.includeLeftRingHom := ⟨_, rfl⟩
  have hρX : ∀ k : Fin (r + 2), ρ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
        (MvPolynomial.X k)) = Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1})
          (MvPolynomial.X k) := by
    intro k
    rw [hρ_def, RingHom.comp_apply, Algebra.TensorProduct.includeLeftRingHom_apply]
    exact hΦ k
  have hφex : ∀ s, ∃ φ : Spec (.of (MvPolynomial (Fin (r + 2)) (IsLocalRing.ResidueField A) ⧸
          (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} :
            Ideal (MvPolynomial (Fin (r + 2)) (IsLocalRing.ResidueField A))))) ≅
        ((Limits.pullback.fst f' (wcQmSp A)) ⁻¹ᵁ (e s).opensRange : Scheme.{u}),
      φ.hom ≫ ((Limits.pullback.fst f' (wcQmSp A)) ⁻¹ᵁ (e s).opensRange).ι ≫
        Limits.pullback.fst f' (wcQmSp A) = Spec.map (CommRingCat.ofHom ρ) ≫ e s := by
    intro s
    rw [hρ_def]
    exact wc_sfh_special_chart_iso A _ _ X' f' (e s) (he3 s) Φ
  choose φ hφ using hφex
  obtain ⟨u, hu_def⟩ : ∃ u : Fin (r + 2) → Fin (r + 2) → wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0),
      ∀ s t, u s t = (if s.val / 2 = t.val / 2 then (1 : wcQuadModelRing A (r + 2) π
              (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
            else Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
              (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
              (MvPolynomial.X (⟨2 * ((if t.val / 2 = 0 then s else t).val / 2),
                lt_of_le_of_lt (Nat.mul_div_le _ 2) (if t.val / 2 = 0 then s else t).isLt⟩ :
                Fin (r + 2)))) := ⟨_, fun _ _ => rfl⟩
  have he4' : ∀ s t y, e s y ∈ Set.range (e t) ↔ u s t ∉ PrimeSpectrum.asIdeal y := by
    intro s t y
    rw [hu_def]
    exact he4 s t y
  have hθX : ∀ k : Fin (r + 2), 2 ≤ k.val →
      MvPolynomial.aeval (fun k : Fin (r + 2) => if k.val < 2 then
        (0 : MvPolynomial (Fin (r + 2)) (IsLocalRing.ResidueField A)) else MvPolynomial.X k)
        (MvPolynomial.X k : MvPolynomial (Fin (r + 2)) (IsLocalRing.ResidueField A)) ≠ 0 := by
    intro k hk
    rw [MvPolynomial.aeval_X, if_neg (by omega)]
    exact MvPolynomial.X_ne_zero k
  have hu : ∀ s t, ∃ g : MvPolynomial (Fin (r + 2)) (IsLocalRing.ResidueField A),
      MvPolynomial.aeval (fun k : Fin (r + 2) => if k.val < 2 then
        (0 : MvPolynomial (Fin (r + 2)) (IsLocalRing.ResidueField A)) else MvPolynomial.X k) g ≠ 0 ∧
      ρ (u s t) = Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) g := by
    intro s t
    by_cases hst : s.val / 2 = t.val / 2
    · refine ⟨1, ?_, ?_⟩
      · rw [map_one]; exact one_ne_zero
      · rw [hu_def, if_pos hst, map_one, map_one]
    · refine ⟨MvPolynomial.X ⟨2 * ((if t.val / 2 = 0 then s else t).val / 2),
        lt_of_le_of_lt (Nat.mul_div_le _ 2) (if t.val / 2 = 0 then s else t).isLt⟩, hθX _ ?_, ?_⟩
      · show 2 ≤ 2 * ((if t.val / 2 = 0 then s else t).val / 2)
        split_ifs with h <;> omega
      · rw [hu_def, if_neg hst]
        exact hρX _
  have hKC : ∀ s (w : Spec (.of (MvPolynomial (Fin (r + 2)) (IsLocalRing.ResidueField A) ⧸
          (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} :
            Ideal (MvPolynomial (Fin (r + 2)) (IsLocalRing.ResidueField A)))))),
      Limits.pullback.fst f' (wcQmSp A)
        (((φ s).hom ≫ ((Limits.pullback.fst f' (wcQmSp A)) ⁻¹ᵁ (e s).opensRange).ι) w) =
        e s (Spec.map (CommRingCat.ofHom ρ) w) := by
    intro s w
    have h := congrArg (fun g => g w) (hφ s)
    simp only [Scheme.Hom.comp_apply] at h ⊢
    exact h
  have hmemV : ∀ s (z : ↥(Limits.pullback f' (wcQmSp A))),
      z ∈ (Limits.pullback.fst f' (wcQmSp A)) ⁻¹ᵁ (e s).opensRange ↔
        Limits.pullback.fst f' (wcQmSp A) z ∈ Set.range (e s) := by
    intro s z
    exact Iff.rfl
  have himg : ∀ s w, ((φ s).hom ≫ ((Limits.pullback.fst f' (wcQmSp A)) ⁻¹ᵁ (e s).opensRange).ι) w ∈
      (Limits.pullback.fst f' (wcQmSp A)) ⁻¹ᵁ (e s).opensRange := by
    intro s w
    rw [Scheme.Hom.comp_apply]
    have hmem := Set.mem_range_self (f := ⇑((Limits.pullback.fst f' (wcQmSp A)) ⁻¹ᵁ
      (e s).opensRange).ι) ((φ s).hom w)
    rwa [Scheme.Opens.range_ι] at hmem
  have hrng : ∀ s (z : ↥(Limits.pullback f' (wcQmSp A))),
      z ∈ (Limits.pullback.fst f' (wcQmSp A)) ⁻¹ᵁ (e s).opensRange →
      ∃ w, ((φ s).hom ≫ ((Limits.pullback.fst f' (wcQmSp A)) ⁻¹ᵁ (e s).opensRange).ι) w = z := by
    intro s z hz
    obtain ⟨v, rfl⟩ : z ∈ Set.range ((Limits.pullback.fst f' (wcQmSp A)) ⁻¹ᵁ
        (e s).opensRange).ι := by
      rw [Scheme.Opens.range_ι]; exact hz
    refine ⟨(φ s).inv v, ?_⟩
    rw [Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply (φ s).inv (φ s).hom, Iso.inv_hom_id]
    first | rfl | simp
  have hover : ∀ (s t : Fin (r + 2)) (a : wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)),
      (∀ y, e s y ∈ Set.range (e t) ↔ a ∉ PrimeSpectrum.asIdeal y) →
      (((Limits.pullback.fst f' (wcQmSp A)) ⁻¹ᵁ (e s).opensRange ⊓
          (Limits.pullback.fst f' (wcQmSp A)) ⁻¹ᵁ (e t).opensRange :
          (Limits.pullback f' (wcQmSp A)).Opens) : Set ↥(Limits.pullback f' (wcQmSp A))) =
        ((φ s).hom ≫ ((Limits.pullback.fst f' (wcQmSp A)) ⁻¹ᵁ (e s).opensRange).ι) ''
          {w | ρ a ∉ PrimeSpectrum.asIdeal w} := by
    intro s t a ha
    ext z
    simp only [TopologicalSpace.Opens.coe_inf, Set.mem_inter_iff, SetLike.mem_coe,
      Set.mem_image, Set.mem_setOf_eq]
    constructor
    · rintro ⟨hzs, hzt⟩
      obtain ⟨w, hw⟩ := hrng s z hzs
      refine ⟨w, ?_, hw⟩
      have h1 := (hmemV t z).mp hzt
      rw [← hw, hKC s w, ha] at h1
      exact h1
    · rintro ⟨w, hw, rfl⟩
      refine ⟨himg s w, ?_⟩
      rw [hmemV, hKC s w, ha]
      exact hw
  obtain ⟨⟨x, hx⟩, hpre⟩ := wc_sfh_node_basicOpen_preconn (IsLocalRing.ResidueField A) r
  refine ⟨fun s => (Limits.pullback.fst f' (wcQmSp A)) ⁻¹ᵁ (e s).opensRange, ?_, ?_, ?_, ?_⟩
  · intro z
    obtain ⟨s, hs⟩ := he2 (Limits.pullback.fst f' (wcQmSp A) z)
    exact ⟨s, (hmemV s z).mpr hs⟩
  · intro i
    exact ⟨(φ i).symm⟩
  · intro i j
    obtain ⟨g, hg, hρg⟩ := hu i j
    show _root_.IsPreconnected ((((Limits.pullback.fst f' (wcQmSp A)) ⁻¹ᵁ (e i).opensRange ⊓
          (Limits.pullback.fst f' (wcQmSp A)) ⁻¹ᵁ (e j).opensRange :
          (Limits.pullback f' (wcQmSp A)).Opens) : Set ↥(Limits.pullback f' (wcQmSp A))))
    rw [hover i j (u i j) (he4' i j), hρg]
    exact (hpre g hg).image _ (Scheme.Hom.continuous _).continuousOn
  · intro i j
    have hz : ∀ t, ((φ 0).hom ≫ ((Limits.pullback.fst f' (wcQmSp A)) ⁻¹ᵁ (e 0).opensRange).ι) x ∈
        (((Limits.pullback.fst f' (wcQmSp A)) ⁻¹ᵁ (e 0).opensRange ⊓
          (Limits.pullback.fst f' (wcQmSp A)) ⁻¹ᵁ (e t).opensRange :
          (Limits.pullback f' (wcQmSp A)).Opens) : Set ↥(Limits.pullback f' (wcQmSp A))) := by
      intro t
      rw [hover 0 t (u 0 t) (he4' 0 t)]
      obtain ⟨g, hg, hρg⟩ := hu 0 t
      refine ⟨x, ?_, rfl⟩
      show ρ (u 0 t) ∉ x.asIdeal
      rw [hρg]
      exact hx g hg
    refine ⟨((φ 0).hom ≫ ((Limits.pullback.fst f' (wcQmSp A)) ⁻¹ᵁ (e 0).opensRange).ι) x, ?_⟩
    simp only [TopologicalSpace.Opens.coe_inf, Set.mem_inter_iff] at hz ⊢
    exact ⟨⟨(hz i).1, (hz i).2⟩, (hz j).2⟩

theorem wc_etqm_sfh_affine_torsor_split : ∀ (K : Type u) [Field K] [IsSepClosed K] (ℓ : ℕ),
    ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (r : ℕ) (P : Scheme.{u})
    (p : P ⟶ Spec (.of (MvPolynomial (Fin r) K))) (α : ZMod ℓ → (P ⟶ P)),
    wcFetTorsor p ℓ α → ∃ σ : Spec (.of (MvPolynomial (Fin r) K)) ⟶ P, σ ≫ p = 𝟙 _ :=
by
  classical
  intro K _ _ ℓ hp hK r P p α ht
  haveI : NeZero ℓ := ⟨hp.ne_zero⟩
  haveI : NeZero ((ℓ : ℕ) : K) := ⟨hK⟩
  haveI := IsSepClosed.hasEnoughRootsOfUnity K ℓ
  obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot K ℓ
  obtain ⟨B, _, _, σ, φ, hφ, h0, hadd, het, hfin, hsurj, hbij⟩ :=
    wc_fet_torsor_affine_ring_data (MvPolynomial (Fin r) K) P p ℓ α ht
  have ht' := wc_fet_torsor_of_ring (MvPolynomial (Fin r) K) B ℓ σ het hfin hsurj h0 hadd hbij
  let κ : K →+* B :=
    (algebraMap (MvPolynomial (Fin r) K) B).comp (algebraMap K (MvPolynomial (Fin r) K))
  letI : Algebra K B := RingHom.toAlgebra κ
  haveI : IsScalarTower K (MvPolynomial (Fin r) K) B :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  obtain ⟨t, a, ht1, ht2⟩ := wc_fsa_ufd_kummer_generator_dom K ℓ hp (Ne.isUnit hK) ζ hζ
    (MvPolynomial (Fin r) K) B σ h0 hadd het hfin hsurj hbij
  have hκσ : ∀ (c : ZMod ℓ) (y : K), σ c (κ y) = κ y := fun c y => (σ c).commutes _
  have ht1' : σ 1 t = κ ζ * t := ht1

  obtain ⟨r₀, hr₀u, hr₀⟩ := MvPolynomial.isUnit_iff_eq_C_of_isReduced.mp a.isUnit
  have hr₀' : algebraMap (MvPolynomial (Fin r) K) B a = κ r₀ := by
    show _ = algebraMap (MvPolynomial (Fin r) K) B (algebraMap K (MvPolynomial (Fin r) K) r₀)
    rw [hr₀, MvPolynomial.algebraMap_eq]
  obtain ⟨b, hb⟩ := IsSepClosed.exists_pow_nat_eq r₀ ℓ
  have hr₀0 : r₀ ≠ 0 := hr₀u.ne_zero

  obtain ⟨s, hs1, hσc⟩ : ∃ s : B, s ^ ℓ = 1 ∧ ∀ c : ZMod ℓ, σ c s = κ (ζ ^ c.val) * s := by
    refine ⟨κ b⁻¹ * t, ?_, ?_⟩
    · rw [mul_pow, ht2, hr₀', ← map_pow, inv_pow, hb, ← map_mul, inv_mul_cancel₀ hr₀0, map_one]
    · have hσ1 : σ 1 (κ b⁻¹ * t) = κ ζ * (κ b⁻¹ * t) := by
        rw [map_mul, hκσ, ht1']; ring
      have hσn : ∀ n : ℕ, σ (n : ZMod ℓ) (κ b⁻¹ * t) = κ (ζ ^ n) * (κ b⁻¹ * t) := by
        intro n
        induction n with
        | zero => rw [Nat.cast_zero, h0, AlgHom.id_apply, pow_zero, map_one, one_mul]
        | succ n ih =>
          rw [Nat.cast_succ, hadd, AlgHom.comp_apply, hσ1, map_mul, hκσ, ih, pow_succ, map_mul]
          ring
      intro c
      have := hσn c.val
      rwa [ZMod.natCast_zmod_val] at this

  have RS : ∀ y : K, y ^ ℓ = 1 → y ≠ 1 → ∑ j ∈ Finset.range ℓ, y ^ j = 0 := by
    intro y hy hy1
    have h := mul_geom_sum y ℓ
    rw [hy, sub_self] at h
    exact (mul_eq_zero.mp h).resolve_left (sub_ne_zero.mpr hy1)

  let e : ZMod ℓ → B := fun c => ∑ i ∈ Finset.range ℓ, κ ((ℓ : K)⁻¹ * ζ ^ (c.val * i)) * s ^ i
  have hσe : ∀ c : ZMod ℓ, σ c (e 0) = e c := by
    intro c
    show σ c (∑ i ∈ Finset.range ℓ, κ ((ℓ : K)⁻¹ * ζ ^ ((0 : ZMod ℓ).val * i)) * s ^ i) = e c
    rw [map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_mul, map_pow, hκσ, hσc, ZMod.val_zero, zero_mul, pow_zero, mul_one, mul_pow,
      ← map_pow, ← pow_mul, ← mul_assoc, ← map_mul]
  obtain ⟨G, hG⟩ : ∃ G : B, G = ∑ i ∈ Finset.range ℓ, s ^ i := ⟨_, rfl⟩
  have hsG : s * G = G := by
    have h := mul_geom_sum s ℓ
    rw [hs1, sub_self, sub_mul, one_mul, sub_eq_zero, ← hG] at h
    exact h
  have hsiG : ∀ i : ℕ, s ^ i * G = G := by
    intro i
    induction i with
    | zero => rw [pow_zero, one_mul]
    | succ i ih => rw [pow_succ, mul_assoc, hsG, ih]
  have he0 : e 0 = κ (ℓ : K)⁻¹ * G := by
    show ∑ i ∈ Finset.range ℓ, κ ((ℓ : K)⁻¹ * ζ ^ ((0 : ZMod ℓ).val * i)) * s ^ i = _
    rw [hG, Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [ZMod.val_zero, zero_mul, pow_zero, mul_one]
  have heG : ∀ c : ZMod ℓ,
      e c * G = κ ((ℓ : K)⁻¹ * ∑ i ∈ Finset.range ℓ, (ζ ^ c.val) ^ i) * G := by
    intro c
    have h : e c * G = ∑ i ∈ Finset.range ℓ, κ ((ℓ : K)⁻¹ * (ζ ^ c.val) ^ i) * G := by
      show (∑ i ∈ Finset.range ℓ, κ ((ℓ : K)⁻¹ * ζ ^ (c.val * i)) * s ^ i) * G = _
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [mul_assoc, hsiG, pow_mul]
    rw [h, ← Finset.sum_mul, ← map_sum, ← Finset.mul_sum]
  have horth : ∀ c : ZMod ℓ, c ≠ 0 → e 0 * e c = 0 := by
    intro c hc
    have hv0 : c.val ≠ 0 := by rwa [Ne, ZMod.val_eq_zero]
    have hx1 : ζ ^ c.val ≠ 1 := hζ.pow_ne_one_of_pos_of_lt hv0 (ZMod.val_lt c)
    have hxl : (ζ ^ c.val) ^ ℓ = 1 := by
      rw [← pow_mul, mul_comm, pow_mul, hζ.pow_eq_one, one_pow]
    rw [he0, mul_assoc, mul_comm G, heG, RS _ hxl hx1, mul_zero, map_zero, zero_mul, mul_zero]
  have hreidx : ∀ f : ℕ → K, ∑ c : ZMod ℓ, f c.val = ∑ j ∈ Finset.range ℓ, f j := by
    intro f
    refine Finset.sum_nbij ZMod.val (fun a _ => Finset.mem_range.mpr (ZMod.val_lt a))
      (fun a _ b _ h => ZMod.val_injective ℓ h) ?_ (fun _ _ => rfl)
    intro j hj
    refine ⟨(j : ZMod ℓ), by simp, ZMod.val_cast_of_lt ?_⟩
    simpa using hj
  have hsum : ∑ c : ZMod ℓ, e c = 1 := by
    have h1 : ∑ c : ZMod ℓ, e c =
        ∑ i ∈ Finset.range ℓ, κ ((ℓ : K)⁻¹ * ∑ j ∈ Finset.range ℓ, (ζ ^ i) ^ j) * s ^ i := by
      show ∑ c : ZMod ℓ, ∑ i ∈ Finset.range ℓ, κ ((ℓ : K)⁻¹ * ζ ^ (c.val * i)) * s ^ i = _
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun i _ => ?_
      have hr := hreidx (fun j => (ζ ^ i) ^ j)
      have hin : ∑ c : ZMod ℓ, ζ ^ (c.val * i) = ∑ j ∈ Finset.range ℓ, (ζ ^ i) ^ j := by
        rw [← hr]
        refine Finset.sum_congr rfl fun c _ => ?_
        rw [← pow_mul, mul_comm]
      rw [← hin, Finset.mul_sum, map_sum, Finset.sum_mul]
    rw [h1, Finset.sum_eq_single 0]
    · simp only [pow_zero, one_pow, Finset.sum_const, Finset.card_range, nsmul_eq_mul, mul_one,
        inv_mul_cancel₀ hK, map_one]
    · intro i hi hi0
      have hx1 : ζ ^ i ≠ 1 := hζ.pow_ne_one_of_pos_of_lt hi0 (Finset.mem_range.mp hi)
      have hxl : (ζ ^ i) ^ ℓ = 1 := by
        rw [← pow_mul, mul_comm, pow_mul, hζ.pow_eq_one, one_pow]
      rw [RS _ hxl hx1, mul_zero, map_zero, zero_mul]
    · intro h
      exact absurd (Finset.mem_range.mpr hp.pos) h

  have hmem : ∀ (c : ZMod ℓ) (x : Spec (.of B)),
      (Spec.map (CommRingCat.ofHom (σ c).toRingHom)) x ∈
        {y : Spec (.of B) | e 0 ∉ y.asIdeal} ↔ e c ∉ x.asIdeal := by
    intro c x
    rw [Spec.map_apply]
    show σ c (e 0) ∉ x.asIdeal ↔ _
    rw [hσe]
  have hdisj : ∀ c : ZMod ℓ, c ≠ 0 → ∀ x ∈ {y : Spec (.of B) | e 0 ∉ y.asIdeal},
      (Spec.map (CommRingCat.ofHom (σ c).toRingHom)) x ∉ {y : Spec (.of B) | e 0 ∉ y.asIdeal} := by
    intro c hc x hx hcx
    have hx' : e 0 ∉ x.asIdeal := hx
    have hcx' := (hmem c x).mp hcx
    have h0m : e 0 * e c ∈ x.asIdeal := by rw [horth c hc]; exact x.asIdeal.zero_mem
    rcases x.isPrime.mem_or_mem h0m with h | h
    · exact hx' h
    · exact hcx' h
  have hcov : ∀ x : Spec (.of B), ∃ c : ZMod ℓ,
      (Spec.map (CommRingCat.ofHom (σ c).toRingHom)) x ∈ {y : Spec (.of B) | e 0 ∉ y.asIdeal} := by
    intro x
    by_contra hne
    have hall : ∀ c : ZMod ℓ, e c ∈ x.asIdeal := fun c => by
      by_contra hc
      exact hne ⟨c, (hmem c x).mpr hc⟩
    have h1 : (1 : B) ∈ x.asIdeal := by
      rw [← hsum]
      exact Ideal.sum_mem _ fun c _ => hall c
    exact x.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
  obtain ⟨σ', hσ'⟩ := wc_torsor_section_of_fundamental_open _ ℓ _ ht'
    {y : Spec (.of B) | e 0 ∉ y.asIdeal} (PrimeSpectrum.basicOpen (e 0)).isOpen hdisj hcov
  refine ⟨σ' ≫ φ.inv, ?_⟩
  rw [← hφ, Category.assoc, Iso.inv_hom_id_assoc, hσ']

theorem wc_etqm_sfh_node_torsor_split : ∀ (K : Type u) [Field K] (ℓ : ℕ) (r : ℕ),
    (∀ (r' : ℕ) (P : Scheme.{u}) (p : P ⟶ Spec (.of (MvPolynomial (Fin r') K)))
      (α : ZMod ℓ → (P ⟶ P)), wcFetTorsor p ℓ α →
        ∃ σ : Spec (.of (MvPolynomial (Fin r') K)) ⟶ P, σ ≫ p = 𝟙 _) →
    ℓ ≠ 0 →
    ∀ (P : Scheme.{u}) (p : P ⟶ Spec (.of (MvPolynomial (Fin (r + 2)) K ⧸
        (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} : Ideal (MvPolynomial (Fin (r + 2)) K)))))
      (α : ZMod ℓ → (P ⟶ P)), wcFetTorsor p ℓ α →
      ∃ σ : Spec (.of (MvPolynomial (Fin (r + 2)) K ⧸
        (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} : Ideal (MvPolynomial (Fin (r + 2)) K)))) ⟶ P,
        σ ≫ p = 𝟙 _ :=
by
  intro K _ ℓ r H _ P p α ht

  have algpart : ∃ (q₀ q₁ : (MvPolynomial (Fin (r + 2)) K ⧸ (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} :
      Ideal (MvPolynomial (Fin (r + 2)) K))) →+* MvPolynomial (Fin (r + 1)) K)
      (c : MvPolynomial (Fin (r + 1)) K →+* MvPolynomial (Fin r) K), c.comp q₀ = c.comp q₁ ∧
      (∀ z, q₀ z = 0 → q₁ z = 0 → z = 0) ∧ (∀ a b, c a = c b → ∃ z, q₀ z = a ∧ q₁ z = b) := by
    classical
    let Q0 : MvPolynomial (Fin (r + 2)) K →ₐ[K] MvPolynomial (Fin (r + 1)) K :=
      MvPolynomial.aeval (Fin.cons 0 (fun j : Fin (r + 1) => MvPolynomial.X j))
    let Q1 : MvPolynomial (Fin (r + 2)) K →ₐ[K] MvPolynomial (Fin (r + 1)) K :=
      MvPolynomial.aeval (Fin.cons (MvPolynomial.X 0)
        (Fin.cons 0 (fun k : Fin r => MvPolynomial.X k.succ) : Fin (r + 1) → MvPolynomial (Fin (r + 1)) K))
    let cc : MvPolynomial (Fin (r + 1)) K →ₐ[K] MvPolynomial (Fin r) K :=
      MvPolynomial.aeval (Fin.cons 0 (fun k : Fin r => MvPolynomial.X k))
    let s0 : MvPolynomial (Fin (r + 1)) K →ₐ[K] MvPolynomial (Fin (r + 2)) K :=
      MvPolynomial.aeval (fun j : Fin (r + 1) => MvPolynomial.X j.succ)
    let s1 : MvPolynomial (Fin (r + 1)) K →ₐ[K] MvPolynomial (Fin (r + 2)) K :=
      MvPolynomial.aeval (Fin.cons (MvPolynomial.X 0) (fun k : Fin r => MvPolynomial.X k.succ.succ))
    let G : MvPolynomial (Fin r) K →ₐ[K] MvPolynomial (Fin (r + 2)) K :=
      MvPolynomial.aeval (fun k : Fin r => MvPolynomial.X k.succ.succ)
    let e : MvPolynomial (Fin r) K →ₐ[K] MvPolynomial (Fin (r + 1)) K :=
      MvPolynomial.aeval (fun k : Fin r => MvPolynomial.X k.succ)
    let π0 : MvPolynomial (Fin (r + 2)) K →ₐ[K] MvPolynomial (Fin (r + 2)) K :=
      MvPolynomial.aeval (Fin.cons 0 (fun j : Fin (r + 1) => MvPolynomial.X j.succ))
    let π1 : MvPolynomial (Fin (r + 2)) K →ₐ[K] MvPolynomial (Fin (r + 2)) K :=
      MvPolynomial.aeval (Fin.cons (MvPolynomial.X 0)
        (Fin.cons 0 (fun k : Fin r => MvPolynomial.X k.succ.succ) : Fin (r + 1) → MvPolynomial (Fin (r + 2)) K))
    have I1 : cc.comp Q0 = cc.comp Q1 := by
      apply MvPolynomial.algHom_ext
      intro i
      refine Fin.cases ?_ (fun j => Fin.cases ?_ (fun k => ?_) j) i <;>
        simp [Q0, Q1, cc, Fin.cons_zero, Fin.cons_succ]
    have I2a : s0.comp Q0 = π0 := by
      apply MvPolynomial.algHom_ext
      intro i
      refine Fin.cases ?_ (fun j => ?_) i <;>
        simp [Q0, s0, π0, Fin.cons_zero, Fin.cons_succ]
    have I2b : s1.comp Q1 = π1 := by
      apply MvPolynomial.algHom_ext
      intro i
      refine Fin.cases ?_ (fun j => Fin.cases ?_ (fun k => ?_) j) i <;>
        simp [Q1, s1, π1, Fin.cons_zero, Fin.cons_succ]
    have I3a : Q0.comp s0 = AlgHom.id K _ := by
      apply MvPolynomial.algHom_ext
      intro i
      simp [Q0, s0, Fin.cons_succ]
    have I3b : Q1.comp s1 = AlgHom.id K _ := by
      apply MvPolynomial.algHom_ext
      intro i
      refine Fin.cases ?_ (fun j => ?_) i <;>
        simp [Q1, s1, Fin.cons_zero, Fin.cons_succ]
    have I3c : Q0.comp s1 = e.comp cc := by
      apply MvPolynomial.algHom_ext
      intro i
      refine Fin.cases ?_ (fun j => ?_) i <;>
        simp [Q0, s1, e, cc, Fin.cons_zero, Fin.cons_succ]
    have I3d : Q1.comp s0 = e.comp cc := by
      apply MvPolynomial.algHom_ext
      intro i
      refine Fin.cases ?_ (fun j => ?_) i <;>
        simp [Q1, s0, e, cc, Fin.cons_zero, Fin.cons_succ]
    have I3e : Q0.comp G = e := by
      apply MvPolynomial.algHom_ext
      intro i
      simp [Q0, G, e, Fin.cons_succ]
    have I3f : Q1.comp G = e := by
      apply MvPolynomial.algHom_ext
      intro i
      simp [Q1, G, e, Fin.cons_succ]
    have I4a : ∀ x, x - π0 x ∈ (Ideal.span {MvPolynomial.X 0} : Ideal (MvPolynomial (Fin (r + 2)) K)) := by
      have h : (Ideal.Quotient.mkₐ K (Ideal.span {MvPolynomial.X 0} :
          Ideal (MvPolynomial (Fin (r + 2)) K))).comp π0 = Ideal.Quotient.mkₐ K _ := by
        apply MvPolynomial.algHom_ext
        intro i
        refine Fin.cases ?_ (fun j => ?_) i
        · simp only [π0, AlgHom.comp_apply, MvPolynomial.aeval_X, Fin.cons_zero, map_zero]
          symm
          rw [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
          exact Ideal.mem_span_singleton_self _
        · simp [π0, Fin.cons_succ]
      intro x
      rw [← Ideal.Quotient.eq]
      have := congrArg (fun f => f x) h
      simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] at this
      exact this.symm
    have I4b : ∀ x, x - π1 x ∈ (Ideal.span {MvPolynomial.X 1} : Ideal (MvPolynomial (Fin (r + 2)) K)) := by
      have h : (Ideal.Quotient.mkₐ K (Ideal.span {MvPolynomial.X 1} :
          Ideal (MvPolynomial (Fin (r + 2)) K))).comp π1 = Ideal.Quotient.mkₐ K _ := by
        apply MvPolynomial.algHom_ext
        intro i
        refine Fin.cases ?_ (fun j => Fin.cases ?_ (fun k => ?_) j) i
        · simp [π1, Fin.cons_zero]
        · simp only [π1, AlgHom.comp_apply, MvPolynomial.aeval_X, Fin.cons_succ, Fin.cons_zero,
            map_zero]
          symm
          rw [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
          exact Ideal.mem_span_singleton_self _
        · simp [π1, Fin.cons_succ]
      intro x
      rw [← Ideal.Quotient.eq]
      have := congrArg (fun f => f x) h
      simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] at this
      exact this.symm
    have hQ0 : ∀ a ∈ (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} :
        Ideal (MvPolynomial (Fin (r + 2)) K)), Q0.toRingHom a = 0 := by
      intro a ha
      obtain ⟨t, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      simp [Q0, Fin.cons_zero]
    have hQ1 : ∀ a ∈ (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} :
        Ideal (MvPolynomial (Fin (r + 2)) K)), Q1.toRingHom a = 0 := by
      intro a ha
      obtain ⟨t, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      simp [Q1, Fin.cons_zero, Fin.cons_one]
    refine ⟨Ideal.Quotient.lift _ Q0.toRingHom hQ0, Ideal.Quotient.lift _ Q1.toRingHom hQ1,
      cc.toRingHom, ?_, ?_, ?_⟩
    · apply Ideal.Quotient.ringHom_ext
      refine RingHom.ext (fun x => ?_)
      simp only [RingHom.comp_apply, Ideal.Quotient.lift_mk]
      exact congrArg (fun f : MvPolynomial (Fin (r + 2)) K →ₐ[K] MvPolynomial (Fin r) K => f x) I1
    · intro z h0 h1
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
      rw [Ideal.Quotient.lift_mk] at h0 h1
      change Q0 x = 0 at h0
      change Q1 x = 0 at h1
      rw [Ideal.Quotient.eq_zero_iff_mem]
      have hp0 : π0 x = 0 := by
        rw [← I2a, AlgHom.comp_apply, h0, map_zero]
      obtain ⟨u, hu⟩ := Ideal.mem_span_singleton'.mp (I4a x)
      rw [hp0, sub_zero] at hu
      have hQ1u : Q1 u = 0 := by
        rw [← hu, map_mul] at h1
        have hX : Q1 (MvPolynomial.X 0) = MvPolynomial.X 0 := by simp [Q1, Fin.cons_zero]
        rw [hX] at h1
        exact (mul_eq_zero.mp h1).resolve_right (MvPolynomial.X_ne_zero _)
      have hp1 : π1 u = 0 := by
        rw [← I2b, AlgHom.comp_apply, hQ1u, map_zero]
      obtain ⟨v, hv⟩ := Ideal.mem_span_singleton'.mp (I4b u)
      rw [hp1, sub_zero] at hv
      rw [← hu, ← hv]
      apply Ideal.mem_span_singleton'.mpr
      exact ⟨v, by ring⟩
    · intro a b hab
      change cc a = cc b at hab
      refine ⟨Ideal.Quotient.mk _ (s0 a + s1 b - G (cc a)), ?_, ?_⟩
      · rw [Ideal.Quotient.lift_mk]
        change Q0 (s0 a + s1 b - G (cc a)) = a
        rw [map_sub, map_add, ← AlgHom.comp_apply Q0 s0, ← AlgHom.comp_apply Q0 s1,
          ← AlgHom.comp_apply Q0 G, I3a, I3c, I3e, AlgHom.comp_apply, AlgHom.id_apply, hab]
        ring
      · rw [Ideal.Quotient.lift_mk]
        change Q1 (s0 a + s1 b - G (cc a)) = b
        rw [map_sub, map_add, ← AlgHom.comp_apply Q1 s0, ← AlgHom.comp_apply Q1 s1,
          ← AlgHom.comp_apply Q1 G, I3b, I3d, I3f, AlgHom.comp_apply, AlgHom.id_apply]
        ring

  have glue : ∀ {N A C : Type u} [CommRing N] [CommRing A] [CommRing C] (q₀ q₁ : N →+* A)
      (c : A →+* C), (∀ z : N, q₀ z = 0 → q₁ z = 0 → z = 0) →
      (∀ a b : A, c a = c b → ∃ z : N, q₀ z = a ∧ q₁ z = b) →
      ∀ (P : Scheme.{u}) [IsAffine P] (p : P ⟶ Spec (.of N)) (s₀ s₁ : Spec (.of A) ⟶ P),
      s₀ ≫ p = Spec.map (CommRingCat.ofHom q₀) → s₁ ≫ p = Spec.map (CommRingCat.ofHom q₁) →
      Spec.map (CommRingCat.ofHom c) ≫ s₀ = Spec.map (CommRingCat.ofHom c) ≫ s₁ →
      ∃ σ : Spec (.of N) ⟶ P, σ ≫ p = 𝟙 _ := by
    intro N A C _ _ _ q₀ q₁ c hinj hglue P _ p s₀ s₁ h₀ h₁ hc
    have huniq : ∀ z z' : N, q₀ z = q₀ z' → q₁ z = q₁ z' → z = z' := by
      intro z z' e0 e1
      have := hinj (z - z') (by rw [map_sub, e0, sub_self]) (by rw [map_sub, e1, sub_self])
      exact sub_eq_zero.mp this
    let φ := P.isoSpec
    let π : CommRingCat.of N ⟶ Γ(P, ⊤) := Spec.preimage (φ.inv ≫ p)
    let b₀ : Γ(P, ⊤) ⟶ CommRingCat.of A := Spec.preimage (s₀ ≫ φ.hom)
    let b₁ : Γ(P, ⊤) ⟶ CommRingCat.of A := Spec.preimage (s₁ ≫ φ.hom)
    have hπ : Spec.map π = φ.inv ≫ p := Spec.map_preimage _
    have hb₀ : Spec.map b₀ = s₀ ≫ φ.hom := Spec.map_preimage _
    have hb₁ : Spec.map b₁ = s₁ ≫ φ.hom := Spec.map_preimage _
    have e₀ : π ≫ b₀ = CommRingCat.ofHom q₀ := by
      apply Spec.map_injective
      rw [Spec.map_comp, hb₀, hπ, Category.assoc, Iso.hom_inv_id_assoc, h₀]
    have e₁ : π ≫ b₁ = CommRingCat.ofHom q₁ := by
      apply Spec.map_injective
      rw [Spec.map_comp, hb₁, hπ, Category.assoc, Iso.hom_inv_id_assoc, h₁]
    have ec : b₀ ≫ CommRingCat.ofHom c = b₁ ≫ CommRingCat.ofHom c := by
      apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_comp, hb₀, hb₁, ← Category.assoc, hc, Category.assoc]
    have e₀' : ∀ z, b₀.hom (π.hom z) = q₀ z := fun z => by
      rw [← CommRingCat.comp_apply, e₀]; rfl
    have e₁' : ∀ z, b₁.hom (π.hom z) = q₁ z := fun z => by
      rw [← CommRingCat.comp_apply, e₁]; rfl
    have ec' : ∀ y, c (b₀.hom y) = c (b₁.hom y) := fun y => by
      have := congrArg (fun f => f.hom y) ec
      simpa using this
    choose β hβ₀ hβ₁ using fun y => hglue (b₀.hom y) (b₁.hom y) (ec' y)
    let βh : Γ(P, ⊤) →+* N :=
      { toFun := β
        map_one' := huniq _ _ (by rw [hβ₀, map_one, map_one]) (by rw [hβ₁, map_one, map_one])
        map_mul' := fun x y => huniq _ _ (by rw [hβ₀, map_mul, map_mul, hβ₀, hβ₀])
          (by rw [hβ₁, map_mul, map_mul, hβ₁, hβ₁])
        map_zero' := huniq _ _ (by rw [hβ₀, map_zero, map_zero]) (by rw [hβ₁, map_zero, map_zero])
        map_add' := fun x y => huniq _ _ (by rw [hβ₀, map_add, map_add, hβ₀, hβ₀])
          (by rw [hβ₁, map_add, map_add, hβ₁, hβ₁]) }
    have hβπ : π ≫ CommRingCat.ofHom βh = 𝟙 _ := by
      ext z
      show β (π.hom z) = z
      exact huniq _ _ (by rw [hβ₀, e₀']) (by rw [hβ₁, e₁'])
    refine ⟨Spec.map (CommRingCat.ofHom βh) ≫ φ.inv, ?_⟩
    rw [Category.assoc, ← hπ, ← Spec.map_comp, hβπ, Spec.map_id]

  have E5 : ∀ c, Limits.pullback.lift (α c) (𝟙 P) ((ht.act_p c).trans (Category.id_comp p).symm)
      ≫ Limits.pullback.fst p p = α c := fun c => Limits.pullback.lift_fst _ _ _
  have E6 : ∀ c, Limits.pullback.lift (α c) (𝟙 P) ((ht.act_p c).trans (Category.id_comp p).symm)
      ≫ Limits.pullback.snd p p = 𝟙 P := fun c => Limits.pullback.lift_snd _ _ _
  have s1 : ∀ {T : Scheme.{u}}, PreconnectedSpace T → Nonempty T → ∀ (τ₁ τ₂ : T ⟶ P),
      τ₂ ≫ p = τ₁ ≫ p → ∃ c : ZMod ℓ, τ₂ = τ₁ ≫ α c := by
    intro T hT hne τ₁ τ₂ w
    obtain ⟨t₀⟩ := hne
    obtain ⟨lam, hl1, hl2⟩ : ∃ lam : T ⟶ Limits.pullback p p,
        lam ≫ Limits.pullback.fst p p = τ₂ ∧ lam ≫ Limits.pullback.snd p p = τ₁ :=
      ⟨Limits.pullback.lift τ₂ τ₁ w, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have hopen : ∀ c', IsOpen (lam ⁻¹' Set.range (Limits.pullback.lift (α c') (𝟙 P)
        ((ht.act_p c').trans (Category.id_comp p).symm))) := by
      intro c'
      have := ht.graph_open c'
      exact (Limits.pullback.lift (α c') (𝟙 P)
        ((ht.act_p c').trans (Category.id_comp p).symm)).isOpenEmbedding.isOpen_range.preimage
          lam.continuous
    obtain ⟨c, hc⟩ := Set.mem_iUnion.mp (Set.eq_univ_iff_forall.mp ht.graph_cover (lam t₀))
    have hclopen : IsClopen (lam ⁻¹' Set.range (Limits.pullback.lift (α c) (𝟙 P)
        ((ht.act_p c).trans (Category.id_comp p).symm))) := by
      refine ⟨?_, hopen c⟩
      rw [← isOpen_compl_iff, isOpen_iff_forall_mem_open]
      intro t htc
      obtain ⟨c', hc'⟩ := Set.mem_iUnion.mp (Set.eq_univ_iff_forall.mp ht.graph_cover (lam t))
      have hne : c' ≠ c := by
        rintro rfl
        exact htc hc'
      refine ⟨_, ?_, hopen c', hc'⟩
      intro s hs hs'
      exact Set.disjoint_left.mp (ht.graph_disj hne) hs hs'
    have huniv := hclopen.eq_univ ⟨t₀, hc⟩
    have H' : Set.range lam ⊆ Set.range (Limits.pullback.lift (α c) (𝟙 P)
        ((ht.act_p c).trans (Category.id_comp p).symm)) := by
      rintro _ ⟨t, rfl⟩
      have : t ∈ lam ⁻¹' Set.range (Limits.pullback.lift (α c) (𝟙 P)
          ((ht.act_p c).trans (Category.id_comp p).symm)) := by
        rw [huniv]; exact Set.mem_univ t
      exact this
    have := ht.graph_open c
    obtain ⟨μ, hμ⟩ : ∃ μ : T ⟶ P, μ ≫ Limits.pullback.lift (α c) (𝟙 P)
        ((ht.act_p c).trans (Category.id_comp p).symm) = lam :=
      ⟨_, IsOpenImmersion.lift_fac _ _ H'⟩
    have h1 : μ = τ₁ := by
      have := congrArg (· ≫ Limits.pullback.snd p p) hμ
      simp only [Category.assoc, E6, Category.comp_id, hl2] at this
      exact this
    have h2 := congrArg (· ≫ Limits.pullback.fst p p) hμ
    simp only [Category.assoc, E5, hl1] at h2
    rw [h1] at h2
    exact ⟨c, h2.symm⟩

  obtain ⟨q₀, q₁, c, hc, hinj, hglue⟩ := algpart
  haveI : IsFinite p := ht.finite
  haveI : IsAffine P := isAffine_of_isAffineHom p
  have hsec : ∀ q : (MvPolynomial (Fin (r + 2)) K ⧸ (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} :
      Ideal (MvPolynomial (Fin (r + 2)) K))) →+* MvPolynomial (Fin (r + 1)) K,
      ∃ s : Spec (.of (MvPolynomial (Fin (r + 1)) K)) ⟶ P, s ≫ p = Spec.map (CommRingCat.ofHom q) := by
    intro q
    obtain ⟨a', ht'⟩ := wc_fet_torsor_base_change p (Spec.map (CommRingCat.ofHom q)) ℓ α ht
    obtain ⟨τ, hτ⟩ := H (r + 1) _ _ a' ht'
    refine ⟨τ ≫ Limits.pullback.fst _ _, ?_⟩
    rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hτ, Category.id_comp]
  obtain ⟨s₀, hs₀⟩ := hsec q₀
  obtain ⟨s₁, hs₁⟩ := hsec q₁
  have hmatch : (Spec.map (CommRingCat.ofHom c) ≫ s₁) ≫ p =
      (Spec.map (CommRingCat.ofHom c) ≫ s₀) ≫ p := by
    rw [Category.assoc, Category.assoc, hs₀, hs₁, ← Spec.map_comp, ← Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hc]
  obtain ⟨d, hd⟩ := s1 inferInstance inferInstance _ _ hmatch
  refine glue q₀ q₁ c hinj hglue P p (s₀ ≫ α d) s₁ ?_ hs₁ ?_
  · rw [Category.assoc, ht.act_p, hs₀]
  · rw [hd, Category.assoc]

theorem wc_etqm_sfh_torsor_glue : ∀ {Z P : Scheme.{u}} (p : P ⟶ Z) (m : ℕ) (a : ZMod m → (P ⟶ P)),
    wcFetTorsor p m a → ∀ {ι : Type} [Finite ι] (V : ι → Z.Opens) (i₀ : ι),
    (∀ z : Z, ∃ i, z ∈ V i) →
    (∀ i j, _root_.IsPreconnected ((V i ⊓ V j : Z.Opens) : Set Z)) →
    (∀ i j, ((V i₀ ⊓ V i ⊓ V j : Z.Opens) : Set Z).Nonempty) →
    (∀ i, ∃ σ : (V i : Scheme.{u}) ⟶ P, σ ≫ p = (V i).ι) →
    ∃ σ : Z ⟶ P, σ ≫ p = 𝟙 Z :=
by
  intro Z P p m a ht ι _ V i₀ hcov hpc htr hloc
  have E5 : ∀ c, Limits.pullback.lift (a c) (𝟙 P) ((ht.act_p c).trans (Category.id_comp p).symm)
      ≫ Limits.pullback.fst p p = a c := fun c => Limits.pullback.lift_fst _ _ _
  have E6 : ∀ c, Limits.pullback.lift (a c) (𝟙 P) ((ht.act_p c).trans (Category.id_comp p).symm)
      ≫ Limits.pullback.snd p p = 𝟙 P := fun c => Limits.pullback.lift_snd _ _ _

  have s1 : ∀ {T : Scheme.{u}}, PreconnectedSpace T → Nonempty T → ∀ (τ₁ τ₂ : T ⟶ P),
      τ₂ ≫ p = τ₁ ≫ p → ∃ c : ZMod m, τ₂ = τ₁ ≫ a c := by
    intro T hT hne τ₁ τ₂ w
    obtain ⟨t₀⟩ := hne
    obtain ⟨lam, hl1, hl2⟩ : ∃ lam : T ⟶ Limits.pullback p p,
        lam ≫ Limits.pullback.fst p p = τ₂ ∧ lam ≫ Limits.pullback.snd p p = τ₁ :=
      ⟨Limits.pullback.lift τ₂ τ₁ w, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have hopen : ∀ c', IsOpen (lam ⁻¹' Set.range (Limits.pullback.lift (a c') (𝟙 P)
        ((ht.act_p c').trans (Category.id_comp p).symm))) := by
      intro c'
      have := ht.graph_open c'
      exact (Limits.pullback.lift (a c') (𝟙 P)
        ((ht.act_p c').trans (Category.id_comp p).symm)).isOpenEmbedding.isOpen_range.preimage
          lam.continuous
    obtain ⟨c, hc⟩ := Set.mem_iUnion.mp (Set.eq_univ_iff_forall.mp ht.graph_cover (lam t₀))
    have hclopen : IsClopen (lam ⁻¹' Set.range (Limits.pullback.lift (a c) (𝟙 P)
        ((ht.act_p c).trans (Category.id_comp p).symm))) := by
      refine ⟨?_, hopen c⟩
      rw [← isOpen_compl_iff, isOpen_iff_forall_mem_open]
      intro t htc
      obtain ⟨c', hc'⟩ := Set.mem_iUnion.mp (Set.eq_univ_iff_forall.mp ht.graph_cover (lam t))
      have hne : c' ≠ c := by
        rintro rfl
        exact htc hc'
      refine ⟨_, ?_, hopen c', hc'⟩
      intro s hs hs'
      exact Set.disjoint_left.mp (ht.graph_disj hne) hs hs'
    have huniv := hclopen.eq_univ ⟨t₀, hc⟩
    have H' : Set.range lam ⊆ Set.range (Limits.pullback.lift (a c) (𝟙 P)
        ((ht.act_p c).trans (Category.id_comp p).symm)) := by
      rintro _ ⟨t, rfl⟩
      have : t ∈ lam ⁻¹' Set.range (Limits.pullback.lift (a c) (𝟙 P)
          ((ht.act_p c).trans (Category.id_comp p).symm)) := by
        rw [huniv]; exact Set.mem_univ t
      exact this
    have := ht.graph_open c
    obtain ⟨μ, hμ⟩ : ∃ μ : T ⟶ P, μ ≫ Limits.pullback.lift (a c) (𝟙 P)
        ((ht.act_p c).trans (Category.id_comp p).symm) = lam :=
      ⟨_, IsOpenImmersion.lift_fac _ _ H'⟩
    have h1 : μ = τ₁ := by
      have := congrArg (· ≫ Limits.pullback.snd p p) hμ
      simp only [Category.assoc, E6, Category.comp_id, hl2] at this
      exact this
    have h2 := congrArg (· ≫ Limits.pullback.fst p p) hμ
    simp only [Category.assoc, E5, hl1] at h2
    rw [h1] at h2
    exact ⟨c, h2.symm⟩

  have s2 : ∀ {T : Scheme.{u}}, Nonempty T → ∀ (τ : T ⟶ P) (d : ZMod m), τ ≫ a d = τ → d = 0 := by
    intro T hne τ d hd
    obtain ⟨t₀⟩ := hne
    by_contra hd0
    have key : τ ≫ Limits.pullback.lift (a d) (𝟙 P) ((ht.act_p d).trans (Category.id_comp p).symm) =
        τ ≫ Limits.pullback.lift (a 0) (𝟙 P) ((ht.act_p 0).trans (Category.id_comp p).symm) := by
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc, E5, hd]
        rw [ht.act_zero, Category.comp_id]
      · simp only [Category.assoc, E6]
    have e := congrArg (fun φ : T ⟶ Limits.pullback p p => φ t₀) key
    simp only [Scheme.Hom.comp_apply] at e
    exact Set.disjoint_left.mp (ht.graph_disj hd0) ⟨τ t₀, rfl⟩ ⟨τ t₀, e.symm⟩

  have hres : ∀ {U U' W : Z.Opens} (e₁ : U ≤ U') (e₂ : U' ≤ W) (e : U ≤ W),
      Z.homOfLE e₁ ≫ Z.homOfLE e₂ = Z.homOfLE e := fun e₁ e₂ _ => Scheme.homOfLE_homOfLE Z e₁ e₂

  choose σ hσ using hloc
  have hc : ∀ i, ∃ c : ZMod m, Z.homOfLE (inf_le_left : V i₀ ⊓ V i ≤ V i₀) ≫ σ i₀ =
      (Z.homOfLE (inf_le_right : V i₀ ⊓ V i ≤ V i) ≫ σ i) ≫ a c := by
    intro i
    obtain ⟨z, hz⟩ := htr i i
    apply s1 (Subtype.preconnectedSpace (hpc i₀ i))
      (⟨⟨z, (inf_le_left : V i₀ ⊓ V i ⊓ V i ≤ V i₀ ⊓ V i) hz⟩⟩ :
        Nonempty ((V i₀ ⊓ V i : Z.Opens) : Scheme.{u}))
    simp only [Category.assoc, hσ, Scheme.homOfLE_ι]
  choose c hc using hc
  obtain ⟨σ', hσ'⟩ : ∃ σ' : ∀ i, (V i : Scheme.{u}) ⟶ P, ∀ i, σ' i = σ i ≫ a (c i) :=
    ⟨_, fun _ => rfl⟩
  have hσ'p : ∀ i, σ' i ≫ p = (V i).ι := by
    intro i
    rw [hσ', Category.assoc, ht.act_p, hσ]
  have hσ'res : ∀ i, Z.homOfLE (inf_le_right : V i₀ ⊓ V i ≤ V i) ≫ σ' i =
      Z.homOfLE (inf_le_left : V i₀ ⊓ V i ≤ V i₀) ≫ σ i₀ := by
    intro i
    rw [hσ', hc i, Category.assoc]

  have hagree : ∀ i j, Z.homOfLE (inf_le_left : V i ⊓ V j ≤ V i) ≫ σ' i =
      Z.homOfLE (inf_le_right : V i ⊓ V j ≤ V j) ≫ σ' j := by
    intro i j
    obtain ⟨z, hz⟩ := htr i j
    have hWO : V i₀ ⊓ V i ⊓ V j ≤ V i ⊓ V j := le_inf (inf_le_left.trans inf_le_right) inf_le_right
    have hWUi : V i₀ ⊓ V i ⊓ V j ≤ V i₀ ⊓ V i := inf_le_left
    have hWUj : V i₀ ⊓ V i ⊓ V j ≤ V i₀ ⊓ V j := le_inf (inf_le_left.trans inf_le_left) inf_le_right
    have hW0 : V i₀ ⊓ V i ⊓ V j ≤ V i₀ := inf_le_left.trans inf_le_left
    have ha : Z.homOfLE (hWO.trans inf_le_left) ≫ σ' i = Z.homOfLE hW0 ≫ σ i₀ := by
      calc Z.homOfLE (hWO.trans inf_le_left) ≫ σ' i
          = (Z.homOfLE hWUi ≫ Z.homOfLE (inf_le_right : V i₀ ⊓ V i ≤ V i)) ≫ σ' i := by
            rw [hres]
        _ = Z.homOfLE hWUi ≫ (Z.homOfLE (inf_le_right : V i₀ ⊓ V i ≤ V i) ≫ σ' i) :=
            Category.assoc _ _ _
        _ = Z.homOfLE hWUi ≫ (Z.homOfLE (inf_le_left : V i₀ ⊓ V i ≤ V i₀) ≫ σ i₀) := by
            rw [hσ'res]
        _ = Z.homOfLE hW0 ≫ σ i₀ := by rw [← Category.assoc, hres]
    have hb : Z.homOfLE (hWO.trans inf_le_right) ≫ σ' j = Z.homOfLE hW0 ≫ σ i₀ := by
      calc Z.homOfLE (hWO.trans inf_le_right) ≫ σ' j
          = (Z.homOfLE hWUj ≫ Z.homOfLE (inf_le_right : V i₀ ⊓ V j ≤ V j)) ≫ σ' j := by
            rw [hres]
        _ = Z.homOfLE hWUj ≫ (Z.homOfLE (inf_le_right : V i₀ ⊓ V j ≤ V j) ≫ σ' j) :=
            Category.assoc _ _ _
        _ = Z.homOfLE hWUj ≫ (Z.homOfLE (inf_le_left : V i₀ ⊓ V j ≤ V i₀) ≫ σ i₀) := by
            rw [hσ'res]
        _ = Z.homOfLE hW0 ≫ σ i₀ := by rw [← Category.assoc, hres]
    obtain ⟨d, hd⟩ := s1 (Subtype.preconnectedSpace (hpc i j))
      (⟨⟨z, hWO hz⟩⟩ : Nonempty ((V i ⊓ V j : Z.Opens) : Scheme.{u}))
      (Z.homOfLE (inf_le_left : V i ⊓ V j ≤ V i) ≫ σ' i)
      (Z.homOfLE (inf_le_right : V i ⊓ V j ≤ V j) ≫ σ' j)
      (by simp only [Category.assoc, hσ'p, Scheme.homOfLE_ι])
    have hW := congrArg (Z.homOfLE hWO ≫ ·) hd
    simp only [← Category.assoc] at hW
    rw [hres hWO inf_le_right (hWO.trans inf_le_right),
      hres hWO inf_le_left (hWO.trans inf_le_left), ha, hb] at hW
    have hd0 : d = 0 := s2 (⟨⟨z, hz⟩⟩ : Nonempty ((V i₀ ⊓ V i ⊓ V j : Z.Opens) : Scheme.{u}))
      (Z.homOfLE hW0 ≫ σ i₀) d hW.symm
    rw [hd0, ht.act_zero, Category.comp_id] at hd
    exact hd.symm

  have hV : TopologicalSpace.IsOpenCover V := by
    show iSup V = ⊤
    rw [eq_top_iff]
    intro z _
    obtain ⟨i, hi⟩ := hcov z
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨i, hi⟩
  have hf' : ∀ x y : ι, Limits.pullback.fst (V x).ι (V y).ι ≫ σ' x =
      Limits.pullback.snd (V x).ι (V y).ι ≫ σ' y := by
    intro x y
    have hP := isPullback_opens_inf (V x) (V y)
    erw [← hP.isoPullback_inv_fst, ← hP.isoPullback_inv_snd, Category.assoc, Category.assoc,
      hagree x y]
  have hf : ∀ x y : (Z.openCoverOfIsOpenCover V hV).I₀,
      Limits.pullback.fst ((Z.openCoverOfIsOpenCover V hV).f x)
        ((Z.openCoverOfIsOpenCover V hV).f y) ≫ σ' x =
      Limits.pullback.snd ((Z.openCoverOfIsOpenCover V hV).f x)
        ((Z.openCoverOfIsOpenCover V hV).f y) ≫ σ' y := by
    intro x y
    exact hf' x y
  refine ⟨Scheme.Cover.glueMorphisms (Z.openCoverOfIsOpenCover V hV) σ' hf, ?_⟩
  apply Scheme.Cover.hom_ext (Z.openCoverOfIsOpenCover V hV)
  intro x
  have h := Scheme.Cover.ι_glueMorphisms (Z.openCoverOfIsOpenCover V hV) σ' hf x
  rw [Category.comp_id, ← Category.assoc]
  erw [h, hσ'p]
  exact (Scheme.openCoverOfIsOpenCover_f Z V hV x).symm

theorem wc_etqm_srhl_special_fibre_h1 (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) (k : ℕ) (hk : 1 ≤ k) (n : ℕ) (hn : Even n) (hn4 : 4 ≤ n) (π : A)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    (c : Matrix (Fin n) (Fin n) A)
    (hc : c = Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0)
    (X' : Scheme.{u}) (β : X' ⟶ Spec (.of (wcQuadModelRing A n π c)))
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun i : Fin n =>
        (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
          (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
            (MvPolynomial.X (⟨2 * (i.val / 2), lt_of_le_of_lt (Nat.mul_div_le i.val 2) i.isLt⟩ :
              Fin n)))))) β)
    (hprop : IsProper β) (f' : X' ⟶ Spec (.of A)) (hf' : β ≫ wcQuadModelStr A n π c = f')
    (hcov : ∀ x : X', ∃ (U : X'.Opens) (r : ℕ)
      (g : U.toScheme ⟶ Spec (.of (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))),
      x ∈ U ∧ Etale g ∧
      g ≫ wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) = U.ι ≫ f') :
    PreconnectedSpace ↥(Limits.pullback f' (wcQmSp A)) ∧
      (letI := HasDerivedCategory.standard
          (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k)));
        ∀ x : (DerivedCategory.singleFunctor
              (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k))) 0).obj
            (SheafOfModules.unit (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k))) ⟶
          ((DerivedCategory.singleFunctor
              (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k))) 0).obj
            (SheafOfModules.unit (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k))))⟦(1 : ℤ)⟧,
          x = 0) :=
by
  obtain ⟨r, rfl⟩ : ∃ r, n = r + 2 := ⟨n - 2, by omega⟩
  obtain ⟨e, he1, he2, he3, he4⟩ :=
    wc_etqm_sfh_charts A r hn hn4 π hπ c hc X' β hbl f' hf'
  obtain ⟨V, hVc, hVi, hVp, hVt⟩ :=
    wc_etqm_sfh_special_charts A π hπ r X' f' e he1 he2 he3 he4

  have hpc : PreconnectedSpace ↥(Limits.pullback f' (wcQmSp A)) := by
    have hself : ∀ i, _root_.IsPreconnected (V i : Set ↥(Limits.pullback f' (wcQmSp A))) := by
      intro i
      have h := hVp i i
      simpa only [TopologicalSpace.Opens.coe_inf, Set.inter_self] using h
    have hW : ∀ i, _root_.IsPreconnected ((V 0 : Set ↥(Limits.pullback f' (wcQmSp A))) ∪
        (V i : Set ↥(Limits.pullback f' (wcQmSp A)))) := by
      intro i
      obtain ⟨w, hw⟩ := hVt i i
      simp only [TopologicalSpace.Opens.coe_inf, Set.mem_inter_iff, SetLike.mem_coe] at hw
      exact _root_.IsPreconnected.union w hw.1.1 hw.1.2 (hself 0) (hself i)
    obtain ⟨w₀, hw₀⟩ := hVt 0 0
    simp only [TopologicalSpace.Opens.coe_inf, Set.mem_inter_iff, SetLike.mem_coe] at hw₀
    refine ⟨isPreconnected_of_forall_pair ?_⟩
    intro x _ y _
    obtain ⟨i, hi⟩ := hVc x
    obtain ⟨j, hj⟩ := hVc y
    refine ⟨((V 0 : Set ↥(Limits.pullback f' (wcQmSp A))) ∪ (V i : Set _)) ∪
      ((V 0 : Set _) ∪ (V j : Set _)), Set.subset_univ _, ?_, ?_, ?_⟩
    · exact Or.inl (Or.inr hi)
    · exact Or.inr (Or.inr hj)
    · exact _root_.IsPreconnected.union w₀ (Or.inl hw₀.1.1) (Or.inl hw₀.1.1) (hW i) (hW j)

  have hℓp : ℓ.Prime := Fact.out
  have hℓ0 : ℓ ≠ 0 := hℓp.ne_zero
  have hℓκ : ((ℓ : ℕ) : IsLocalRing.ResidueField A) ≠ 0 := by
    have h := hℓ.map (IsLocalRing.residue A)
    rw [map_natCast] at h
    exact h.ne_zero
  have hsplit : ∀ (P : Scheme.{u}) (p : P ⟶ Limits.pullback f' (wcQmSp A))
      (α : ZMod ℓ → (P ⟶ P)), wcFetTorsor p ℓ α →
      ∃ σ : Limits.pullback f' (wcQmSp A) ⟶ P, σ ≫ p = 𝟙 _ := by
    intro P p α ht
    refine wc_etqm_sfh_torsor_glue p ℓ α ht V 0 hVc hVp hVt ?_
    intro i
    obtain ⟨φ⟩ := hVi i
    obtain ⟨a', ht'⟩ := wc_fet_torsor_base_change p (V i).ι ℓ α ht
    have ht'' := wc_tar_fet_transport (Limits.pullback.snd p (V i).ι) ℓ a' φ ht'
    obtain ⟨τ, hτ⟩ := wc_etqm_sfh_node_torsor_split (IsLocalRing.ResidueField A) ℓ r
      (wc_etqm_sfh_affine_torsor_split (IsLocalRing.ResidueField A) ℓ hℓp hℓκ) hℓ0 _ _ a' ht''
    refine ⟨φ.hom ≫ τ ≫ Limits.pullback.fst p (V i).ι, ?_⟩
    have h1 : τ ≫ Limits.pullback.snd p (V i).ι = φ.inv := by
      rw [← cancel_mono φ.hom, Category.assoc, hτ, Iso.inv_hom_id]
    rw [Category.assoc, Category.assoc, Limits.pullback.condition, ← Category.assoc τ, h1,
      ← Category.assoc, Iso.hom_inv_id, Category.id_comp]

  have h1 : Subsingleton (wcEtCoh (Limits.pullback f' (wcQmSp A)) ℓ 1) :=
    wc_et_h1_subsingleton_of_torsor_sections _ ℓ hℓ0 hsplit
  obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
  have h2 := wc_et_coh_zmod_prime_pow_of_prime _ ℓ hℓp 1 h1 k'
  obtain ⟨eqv⟩ := wc_et_zmodext_coh_equiv (Limits.pullback f' (wcQmSp A)) (ℓ ^ (k' + 1)) 1
  haveI h3 : Subsingleton (wcEtZModExt (Limits.pullback f' (wcQmSp A)) (ℓ ^ (k' + 1)) 1) :=
    eqv.subsingleton

  refine ⟨hpc, ?_⟩
  letI := HasDerivedCategory.standard
    (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ (k' + 1))))
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ (k' + 1)))) :=
    HasExt.standard _
  intro x
  haveI hsub : Subsingleton (ShiftedHom
      ((DerivedCategory.singleFunctor
        (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ (k' + 1)))) 0).obj
        (SheafOfModules.unit (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ (k' + 1)))))
      ((DerivedCategory.singleFunctor
        (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ (k' + 1)))) 0).obj
        (SheafOfModules.unit (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ (k' + 1)))))
      ((1 : ℕ) : ℤ)) :=
    (Abelian.Ext.homEquiv
      (C := SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ (k' + 1))))).symm.subsingleton
  exact hsub.elim x 0

theorem wc_etqm_srhl_exc_irred (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (n : ℕ) (hn : Even n)
    (hn4 : 4 ≤ n) (π : A) (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    (c : Matrix (Fin n) (Fin n) A)
    (hc : c = Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0)
    (X' : Scheme.{u}) (β : X' ⟶ Spec (.of (wcQuadModelRing A n π c)))
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun i : Fin n =>
        (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
          (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
            (MvPolynomial.X (⟨2 * (i.val / 2), lt_of_le_of_lt (Nat.mul_div_le i.val 2) i.isLt⟩ :
              Fin n)))))) β)
    (hprop : IsProper β) (f' : X' ⟶ Spec (.of A)) (hf' : β ≫ wcQuadModelStr A n π c = f')
    (hcov : ∀ x : X', ∃ (U : X'.Opens) (r : ℕ)
      (g : U.toScheme ⟶ Spec (.of (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))),
      x ∈ U ∧ Etale g ∧
      g ≫ wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) = U.ι ≫ f') :
    IsPreirreducible (wcSrhlExc A n π c β f') :=
by
  obtain ⟨r, rfl⟩ : ∃ r, n = r + 2 := ⟨n - 2, by omega⟩
  subst hc
  have hπ0 : π ≠ 0 := by
    intro h0
    apply IsDiscreteValuationRing.not_a_field A
    rw [hπ, h0, Ideal.span_singleton_eq_bot]
  have Lc0 : ∀ {S : Type u} [CommRing S] (g : A →+* S) (f : Fin (r + 2) → S),
      ∑ a, ∑ b, g (wcSrmC0 A r a b) * f a * f b = f ⟨0, by omega⟩ * f ⟨1, by omega⟩ := by
    intro S _ g f
    rw [Finset.sum_eq_single (⟨0, by omega⟩ : Fin (r + 2))]
    · rw [Finset.sum_eq_single (⟨1, by omega⟩ : Fin (r + 2))]
      · simp
      · intro b _ hb
        have : b.val ≠ 1 := fun h => hb (Fin.ext h)
        simp [this]
      · simp
    · intro a _ ha
      have : a.val ≠ 0 := fun h => ha (Fin.ext h)
      simp [this]
    · simp
  have Lch : ∀ {S : Type u} [CommRing S] (g : A →+* S) (f : Fin (r + 2) → S),
      ∑ a, ∑ b, g (wcSrmCh A r a b) * f a * f b = f ⟨0, by omega⟩ * f ⟨1, by omega⟩ +
        ∑ i : Fin (r + 1), ∑ b, g (wcSrmCh A r i.succ b) * f i.succ * f b := by
    intro S _ g f
    rw [Fin.sum_univ_succ]
    congr 1
    rw [Finset.sum_eq_single (⟨1, by omega⟩ : Fin (r + 2))]
    · simp
    · intro b _ hb
      have : b.val ≠ 1 := fun h => hb (Fin.ext h)
      simp [this]
    · simp
  have s3core : ∑ a, ∑ b, MvPolynomial.C (wcSrmCh A r a b) * wcSrmFimg A r a * wcSrmFimg A r b =
      MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) * MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) := by
    rw [Lch MvPolynomial.C (wcSrmFimg A r)]
    have hQ := Lch (MvPolynomial.C)
      (MvPolynomial.X : Fin (r + 2) → MvPolynomial (Fin (r + 2)) A)
    have hT : ∑ i : Fin (r + 1), ∑ b, MvPolynomial.C (wcSrmCh A r i.succ b) *
        wcSrmFimg A r i.succ * wcSrmFimg A r b =
        MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) * ∑ i : Fin (r + 1), ∑ b,
          MvPolynomial.C (wcSrmCh A r i.succ b) * MvPolynomial.X i.succ * MvPolynomial.X b := by
      rw [Finset.mul_sum]
