  have htu : ∀ j, IsUnit ((Limits.pullback.fst (e j) (Limits.pullback.fst f' ξ)).appTop.hom
      ((Scheme.ΓSpecIso (CommRingCat.of (wcR1sM A r π))).inv.hom (wcR1sY0 A r π))) := by
    intro j
