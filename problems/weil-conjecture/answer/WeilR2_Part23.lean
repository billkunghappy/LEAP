  rw [Category.id_comp, Category.comp_id] at hsm
  have hmu : IsUnit (((ℓ ^ k : ℕ)) : A) := by rw [Nat.cast_pow]; exact hℓ.pow k
  have hst := wc_et_supp_unit_ker_coker_stalks_of_milnor_h0 A _ (wcQuadModelStr A n π c) (ℓ ^ k)
    (pow_pos (Fact.out : ℓ.Prime).pos k) Ω ξ Dh
    (Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A) y)
    (fun B _ _ _ Λ _ _ W' φ a hB =>
