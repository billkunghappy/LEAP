      let ψ : wcQuadModelRing A (r + 2) π (wcSrmC0 A r) →+* B := Ideal.Quotient.lift IM ψt hψt
      have hψy : ∀ p, ψ (y p) = v p := by
        intro p
        show Ideal.Quotient.lift IM ψt hψt (Ideal.Quotient.mk IM _) = _
        rw [Ideal.Quotient.lift_mk]
        exact MvPolynomial.eval₂Hom_X' g v p
      have hψalg : ∀ a, ψ (algebraMap A _ a) = g a := by
        intro a
        rw [← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq]
        show Ideal.Quotient.lift IM ψt hψt (Ideal.Quotient.mk IM _) = _
        rw [Ideal.Quotient.lift_mk]
        exact MvPolynomial.eval₂Hom_C g v a

      have hval : ∀ ψ' : wcQuadModelRing A (r + 2) π (wcSrmC0 A r) →+* B,
          ψ'.comp φ = ρ.hom → ∀ p, ψ' (y p) = v p := by
        intro ψ' hψ'
        have hc : ∀ z, ψ' (φ z) = ρ.hom z := fun z => RingHom.congr_fun hψ' z
        have hy0 : ψ' (y p0) = ξ := by rw [← hφ0, hc]
        have hyodd : ∀ p : Fin (r + 2), p.val ≠ 1 → p.val % 2 ≠ 0 → ψ' (y p) = ρ.hom (x p) := by
          intro p h1 h2
          rw [← hφodd p h1 h2, hc]
        have hyev : ∀ p : Fin (r + 2), p.val ≠ 0 → p.val % 2 = 0 → ψ' (y p) = β p := by
          intro p h0 h2
          have e1 : ξ * ψ' (y p) = ρ.hom (x p) := by
            rw [← hy0, ← map_mul, ← hφev p h0 h2, hc]
          have e2 : (ψ' (y p) - β p) * ξ = 0 := by
            rw [sub_mul, mul_comm, e1, hβ p h2, sub_self]
          exact sub_eq_zero.mp (mul_right_mem_nonZeroDivisors_eq_zero_iff hnzd |>.mp e2)
        have hga : ∀ a, ψ' (algebraMap A _ a) = g a := by
          intro a
          rw [← hφA, RingHom.comp_apply, hc]
          rfl
        have hy1 : ψ' (y p1) = ρ.hom (x p1) + S := by
          have e1 := hc (x p1)
          have hx1 : φ (x p1) = y p1 + y p0 * y p1 -
              ∑ a, ∑ b, algebraMap A _ (wcSrmCh A r a b) * y a * y b := by
            show φ (Ideal.Quotient.mk IR _) = _
            rw [hφX, hF1]
            simp only [map_sub, map_add, map_mul, map_sum, ← MvPolynomial.algebraMap_eq,
              Ideal.Quotient.mk_algebraMap]
            rfl
          rw [hx1] at e1
          simp only [map_sub, map_add, map_mul, map_sum, hga] at e1
          rw [Lch g (fun p => ψ' (y p))] at e1
          rw [htail (fun p => ψ' (y p)) hyev hyodd] at e1
          rw [← e1]
          ring
        intro p
        by_cases h0 : p.val = 0
        · have : p = p0 := Fin.ext h0
          rw [this, hy0, hv0]
        by_cases h1 : p.val = 1
        · have : p = p1 := Fin.ext h1
          rw [this, hy1, hv1]
        by_cases h2 : p.val % 2 = 0
        · rw [hyev p h0 h2, hvev p h0 h2]
        · rw [hyodd p h1 h2, hvodd p h1 h2]

      have hex : ψ.comp φ = ρ.hom := by
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext
        · intro a
          simp only [RingHom.comp_apply]
          rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
          rw [← RingHom.comp_apply φ, hφA, hψalg]
          rfl
        · intro p
          simp only [RingHom.comp_apply]
          change ψ (φ (x p)) = ρ.hom (x p)
          by_cases h0 : p.val = 0
          · have : p = p0 := Fin.ext h0
            rw [this, hφ0, hψy, hv0]
          by_cases h1 : p.val = 1
          · have : p = p1 := Fin.ext h1
            rw [this]
            have hx1 : φ (x p1) = y p1 + y p0 * y p1 -
                ∑ a, ∑ b, algebraMap A _ (wcSrmCh A r a b) * y a * y b := by
              show φ (Ideal.Quotient.mk IR _) = _
              rw [hφX, hF1]
              simp only [map_sub, map_add, map_mul, map_sum, ← MvPolynomial.algebraMap_eq,
                Ideal.Quotient.mk_algebraMap]
              rfl
            rw [hx1]
            simp only [map_sub, map_add, map_mul, map_sum, hψalg, hψy]
            rw [Lch g v, htail v hvev hvodd, hv1]
            ring
          by_cases h2 : p.val % 2 = 0
          · rw [hφev p h0 h2, map_mul, hψy, hψy, hv0, hvev p h0 h2, mul_comm, hβ p h2]
          · rw [hφodd p h1 h2, hψy, hvodd p h1 h2]
      refine ⟨CommRingCat.ofHom ψ, ?_, ?_⟩
      · apply CommRingCat.hom_ext
        rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom]
        exact hex
      · intro ψ₂ hψ₂
        have h2 : ψ₂.hom.comp φ = ρ.hom := by
          rw [← hψ₂, CommRingCat.hom_comp, CommRingCat.hom_ofHom]
        apply CommRingCat.hom_ext
        rw [CommRingCat.hom_ofHom]
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext
        · intro a
          simp only [RingHom.comp_apply]
          rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap, hψalg]
          rw [← hφA, RingHom.comp_apply, ← RingHom.comp_apply ψ₂.hom, h2]
          rfl
        · intro p
          simp only [RingHom.comp_apply]
          change ψ₂.hom (y p) = ψ (y p)
          rw [hval _ h2 p, hψy]
  haveI : IsNoetherianRing (wcQuadModelRing A (r + 2) π (wcSrmCh A r)) := inferInstance
  haveI : IsNoetherian (Spec (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmCh A r)))) :=
    inferInstance

  obtain ⟨X', β, hbl, -⟩ := wc_csd_blowup_exists_noeth
    (Spec (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmCh A r))))
    (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun i : Fin (r + 2) =>
      (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmCh A r)))).inv.hom
        (wcSrmGen A r π i))))

  have hprop : IsProper β := by
    obtain ⟨U, t, hCH⟩ := wc_bp_blowup_charts _ β hbl
    obtain ⟨h1, h2, h3⟩ := wc_bp_charts_finiteness _ β U t hCH
    have hV : ValuativeCriterion β := by
      rw [ValuativeCriterion.eq]
      exact ⟨wc_bp_charts_val_exist _ β U t hCH, wc_bp_charts_val_unique _ β U t hCH⟩
    exact IsProper.of_valuativeCriterion β hV

  obtain ⟨φ0, hφX, hφA⟩ := s3
  have hnzd0 := s6
  obtain ⟨hgen0, hup0⟩ := s7 φ0 hφX hφA
  have hb0 : φ0 (wcSrmGen A r π ⟨0, by omega⟩) =
      Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) := by
    have h := hφX ⟨0, by omega⟩
    have e0 : wcSrmGen A r π ⟨0, by omega⟩ =
        Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmCh A r))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) := by
      have hf : (⟨2 * ((⟨0, by omega⟩ : Fin (r + 2)).val / 2),
          lt_of_le_of_lt (Nat.mul_div_le _ 2) (⟨0, by omega⟩ : Fin (r + 2)).isLt⟩ : Fin (r + 2)) =
          ⟨0, by omega⟩ := Fin.ext (by simp)
      unfold wcSrmGen
      rw [hf]
    rw [e0, h]
    simp [wcSrmFimg]
  choose σ hσA hσb hσJ using s4
  have hT := fun k : Fin (r + 2) =>
    s5 (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmCh A r)))
      (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmC0 A r)))
      (wcSrmGen A r π) ⟨0, by omega⟩ k (σ k) (CommRingCat.ofHom φ0) (hσb k) (hσJ k)
      (by rw [CommRingCat.hom_ofHom, hb0]; exact hnzd0)
      (by rw [CommRingCat.hom_ofHom]; exact hgen0)
      (fun B ρ h1 h2 => hup0 B ρ h1 h2)
  obtain ⟨e, he_open, he_comp, he_cov⟩ := wc_qmbt_bm_blowup_charts
    (R := CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmCh A r))) (wcSrmGen A r π) β hbl
    (fun _ => CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmC0 A r)))
    (fun k => CommRingCat.ofHom (σ k : wcQuadModelRing A (r + 2) π (wcSrmCh A r) →+*
      wcQuadModelRing A (r + 2) π (wcSrmCh A r)) ≫ CommRingCat.ofHom φ0)
    (fun k => (hT k).1) (fun k => (hT k).2.1) (fun k => (hT k).2.2)

  have KE : ∀ k : Fin (r + 2),
      Spec.map (CommRingCat.ofHom (σ k : wcQuadModelRing A (r + 2) π (wcSrmCh A r) →+*
        wcQuadModelRing A (r + 2) π (wcSrmCh A r)) ≫ CommRingCat.ofHom φ0) ≫
        wcQuadModelStr A (r + 2) π
          (Matrix.of fun p q : Fin (r + 2) =>
            if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0) =
      wcQuadModelStr A (r + 2) π
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) := by
    intro k
    have hk : φ0.comp ((σ k : wcQuadModelRing A (r + 2) π (wcSrmCh A r) →+*
        wcQuadModelRing A (r + 2) π (wcSrmCh A r)).comp
          (algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmCh A r)))) =
        algebraMap A (wcQuadModelRing A (r + 2) π (wcSrmC0 A r)) := by
      rw [hσA k, hφA]
    simp only [wcQuadModelStr, ← Spec.map_comp]
    congr 1
    ext x
    exact RingHom.congr_fun hk x
  have hι : ∀ k : Fin (r + 2), haveI := he_open k;
      (e k).opensRange.ι = (e k).isoOpensRange.inv ≫ e k := by
    intro k
    haveI := he_open k
    exact ((Iso.inv_comp_eq _).mpr (Scheme.Hom.isoOpensRange_hom_ι (e k)).symm).symm
  refine ⟨X', β, hbl, hprop, ?_, ?_⟩
  ·
    intro x
    obtain ⟨k, y, hy⟩ := he_cov x
    haveI := he_open k
    refine ⟨(e k).opensRange, r, (e k).isoOpensRange.inv,
      Scheme.Hom.mem_opensRange.mpr ⟨y, hy⟩, inferInstance, ?_⟩
    rw [hι k, Category.assoc, ← Category.assoc (e k), he_comp k, KE k]
  ·
    have hmax := wc_qmbt_bm_origin_maximal hπ (r + 2) (wcSrmC0 A r)
    let y0 : Spec (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcSrmC0 A r))) :=
