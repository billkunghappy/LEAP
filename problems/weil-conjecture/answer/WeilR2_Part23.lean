    haveI := (wc_et_stalk_exact S (g s)).2
    have hm : Mono ((wcEtStalk S (g s)).map
        ((SheafOfModules.toSheaf (wcEtZModRing S n)).map (Limits.image.ι f))) := inferInstance
    have he : Epi ((wcEtStalk S (g s)).map
        ((SheafOfModules.toSheaf (wcEtZModRing S n)).map (Limits.factorThruImage f))) :=
      inferInstance
    have h0 : (wcEtStalk S (g s)).map
        ((SheafOfModules.toSheaf (wcEtZModRing S n)).map (Limits.factorThruImage f)) = 0 := by
      rw [← cancel_mono ((wcEtStalk S (g s)).map
        ((SheafOfModules.toSheaf (wcEtZModRing S n)).map (Limits.image.ι f))),
        ← Functor.map_comp, ← Functor.map_comp, Limits.image.fac, Limits.zero_comp]
      exact hstk s
    rw [Limits.IsZero.iff_id_eq_zero, ← cancel_epi ((wcEtStalk S (g s)).map
        ((SheafOfModules.toSheaf (wcEtZModRing S n)).map (Limits.factorThruImage f))), h0,
      Limits.zero_comp, Limits.zero_comp]
  have hE : Limits.IsZero (D.Φ.obj (Limits.image f)) := by
    have hT : Limits.IsZero ((SheafOfModules.toSheaf (wcEtZModRing S' n)).obj
        (D.Φ.obj (Limits.image f))) := by
      apply wc_et_stalks_zero
      intro s
      obtain ⟨α⟩ := wc_et_pull_data_stalk_iso g n D (Limits.image f) s
      exact AddCommGrpCat.subsingleton_of_isZero ((hI s).of_iso α)
