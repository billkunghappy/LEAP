    simp only [Matrix.map_apply, Matrix.of_apply]
    split_ifs <;> simp
  exact sJet (IsLocalRing.ResidueField A) S r (IsLocalRing.residue A π) _ hc β
    (sLift β hβ) (sLift _ hα) 𝔮 h𝔮 (hpt _ hT0B) (hpt _ hT1B)

theorem wc_srdci_chart_closure_iff (A : Type u) [CommRing A] [IsLocalRing A] (r : ℕ) (π : A)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    (X' : Scheme.{u}) (f' : X' ⟶ Spec (.of A))
    (e : Spec (.of (wcQuadModelRing A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))) ⟶ X')
    [IsOpenImmersion e]
    (he : e ≫ f' = wcQuadModelStr A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
    (T : Set ↥(Limits.pullback f' (wcQmSp A)))
    (hT : ∀ (z' : ↥(Limits.pullback f' (wcQmSp A)))
      (y' : Spec (.of (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))),
      Limits.pullback.fst f' (wcQmSp A) z' = e y' →
        (z' ∈ T ↔ Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal y'))
    (z : ↥(Limits.pullback f' (wcQmSp A)))
    (y : Spec (.of (wcQuadModelRing A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))))
    (hz : Limits.pullback.fst f' (wcQmSp A) z = e y) :
    z ∈ closure Tᶜ ↔ Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
          (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal y :=
by
  classical

  have Lc0 : ∀ {S : Type u} [CommRing S] (g : A →+* S) (f : Fin (r + 2) → S),
      ∑ a, ∑ b, g ((Matrix.of fun i j : Fin (r + 2) =>
        if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) a b) * f a * f b =
        f ⟨0, by omega⟩ * f ⟨1, by omega⟩ := by
    intro S _ g f
    rw [Finset.sum_eq_single (⟨0, by omega⟩ : Fin (r + 2))]
    · rw [Finset.sum_eq_single (⟨1, by omega⟩ : Fin (r + 2))]
      · simp
      · intro b _ hb
        have : b.val ≠ 1 := fun h => hb (Fin.ext h)
        simp [this]
      · simp
    · intro a _ ha
      have : a.val ≠ 0 := fun h => ha (Fin.ext h)
      have h0 : a ≠ 0 := fun h => this (by simp [h])
      simp [this, h0]
    · simp
  have hres : IsLocalRing.residue A π = 0 := by
    rw [IsLocalRing.residue_eq_zero_iff, hπ]; exact Ideal.mem_span_singleton_self π
  have hgenIM : wcQuadModelIdeal A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) =
      Ideal.span {MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) *
        MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) - MvPolynomial.C π} := by
    rw [wcQuadModelIdeal, Lc0 MvPolynomial.C MvPolynomial.X]
  have hrel : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
      (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) * MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) =
      Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
      (MvPolynomial.C π) := by
    rw [Ideal.Quotient.eq, hgenIM]
    exact Ideal.subset_span rfl
  have halg : algebraMap A (wcQuadModelRing A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) π =
      Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) *
      Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
        (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) := by
    rw [← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq, ← hrel, map_mul]

  have hF : ∀ (z' : ↥(Limits.pullback f' (wcQmSp A)))
      (y' : Spec (.of (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))),
      Limits.pullback.fst f' (wcQmSp A) z' = e y' →
      Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) *
      Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
        (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal y' := by
    intro z' y' h
    have h1 : f' (Limits.pullback.fst f' (wcQmSp A) z') =
        wcQmSp A (Limits.pullback.snd f' (wcQmSp A) z') := by
      rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
    have h2 : f' (e y') = wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) y' := by
      rw [← Scheme.Hom.comp_apply, he]
    rw [h, h2] at h1
    have h3 : π ∈ PrimeSpectrum.asIdeal (wcQmSp A (Limits.pullback.snd f' (wcQmSp A) z')) := by
      show IsLocalRing.residue A π ∈ PrimeSpectrum.asIdeal (Limits.pullback.snd f' (wcQmSp A) z')
      rw [hres]; exact Ideal.zero_mem _
    rw [← h1] at h3
    rw [← halg]
    exact h3

  have hy1 : (Ideal.span {Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
        (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)))}).IsPrime ∧
      Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∉
        Ideal.span {Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
          (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)))} := by
    set IM := wcQuadModelIdeal A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) with hIM
    set Y1 := Ideal.Quotient.mk IM (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) with hY1
    let vA : Fin (r + 2) → MvPolynomial (Fin (r + 2)) A := fun p =>
      if p.val = 1 then 0 else MvPolynomial.X p
    let τ : MvPolynomial (Fin (r + 2)) A →+* MvPolynomial (Fin (r + 2)) A :=
      MvPolynomial.eval₂Hom MvPolynomial.C vA
    let θ : MvPolynomial (Fin (r + 2)) A →+*
        MvPolynomial (Fin (r + 2)) (IsLocalRing.ResidueField A) :=
      (MvPolynomial.map (IsLocalRing.residue A)).comp τ
    have hτX : ∀ p, τ (MvPolynomial.X p) = vA p := fun p => MvPolynomial.eval₂Hom_X' _ _ p
    have hτC : ∀ a, τ (MvPolynomial.C a) = MvPolynomial.C a :=
      fun a => MvPolynomial.eval₂Hom_C _ _ a
    have hθgen : θ (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) *
        MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) - MvPolynomial.C π) = 0 := by
      simp [θ, hτX, hτC, vA, hres]
    have hker : ∀ a ∈ IM, θ a = 0 := by
      intro a ha
      rw [hgenIM] at ha
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      rw [map_mul, hθgen, mul_zero]
    let θb : wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) →+*
        MvPolynomial (Fin (r + 2)) (IsLocalRing.ResidueField A) := Ideal.Quotient.lift IM θ hker
    have hθb : ∀ f, θb (Ideal.Quotient.mk IM f) = θ f := fun f => Ideal.Quotient.lift_mk _ _ _
    have hdec : ∀ f : MvPolynomial (Fin (r + 2)) A,
        Ideal.Quotient.mk IM f - Ideal.Quotient.mk IM (τ f) ∈ Ideal.span {Y1} := by
      intro f
      induction f using MvPolynomial.induction_on
      next a =>
        rw [hτC, sub_self]
        exact Ideal.zero_mem _
      next p q hp hq =>
        have := Ideal.add_mem _ hp hq
        simp only [map_add]
        convert this using 1
        ring
      next p i hp =>
        simp only [map_mul, hτX]
        have hXi : Ideal.Quotient.mk IM (MvPolynomial.X i) - Ideal.Quotient.mk IM (vA i) ∈
            Ideal.span {Y1} := by
          by_cases hi : i.val = 1
          · have hi1 : i = ⟨1, by omega⟩ := Fin.ext hi
            simp only [vA, if_pos hi, map_zero, sub_zero]
            rw [hi1]
            exact Ideal.mem_span_singleton_self _
          · simp only [vA, if_neg hi, sub_self]
            exact Ideal.zero_mem _
        have e : Ideal.Quotient.mk IM p * Ideal.Quotient.mk IM (MvPolynomial.X i) -
            Ideal.Quotient.mk IM (τ p) * Ideal.Quotient.mk IM (vA i) =
            (Ideal.Quotient.mk IM p - Ideal.Quotient.mk IM (τ p)) *
              Ideal.Quotient.mk IM (MvPolynomial.X i) +
            Ideal.Quotient.mk IM (τ p) * (Ideal.Quotient.mk IM (MvPolynomial.X i) -
              Ideal.Quotient.mk IM (vA i)) := by ring
        rw [e]
        exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hp) (Ideal.mul_mem_left _ _ hXi)
    have hkerle : RingHom.ker θb ≤ Ideal.span {Y1} := by
      intro x hx
      obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
      rw [RingHom.mem_ker, hθb] at hx
      have h1 : τ f ∈ RingHom.ker (MvPolynomial.map (IsLocalRing.residue A) :
          MvPolynomial (Fin (r + 2)) A →+* MvPolynomial (Fin (r + 2)) (IsLocalRing.ResidueField A)) :=
        RingHom.mem_ker.mpr hx
      rw [MvPolynomial.ker_map, IsLocalRing.ker_residue, hπ, Ideal.map_span, Set.image_singleton,
        Ideal.mem_span_singleton'] at h1
      obtain ⟨u, hu⟩ := h1
      have h2 : Ideal.Quotient.mk IM (τ f) ∈ Ideal.span {Y1} := by
        rw [← hu, map_mul]
        apply Ideal.mul_mem_left
        rw [← hrel, map_mul]
        exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
      have := Ideal.add_mem _ (hdec f) h2
      rwa [sub_add_cancel] at this
    have hkereq : RingHom.ker θb = Ideal.span {Y1} := by
      apply le_antisymm hkerle
      rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker, hY1, hθb]
      simp [θ, hτX, vA]
    refine ⟨?_, ?_⟩
    · rw [← hkereq]
      exact RingHom.ker_isPrime θb
    · intro hmem
      rw [← hkereq, RingHom.mem_ker, hθb] at hmem
      simp [θ, hτX, vA] at hmem
      try exact MvPolynomial.X_ne_zero _ hmem
  obtain ⟨hP, hY0P⟩ := hy1
  constructor
  ·
    intro hcl
    by_contra h1
    let D : Set (Spec (.of (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))) :=
      {y'' | Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
          (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∉ PrimeSpectrum.asIdeal y''}
    have hD : IsOpen D := PrimeSpectrum.isOpen_basicOpen
    have hO : IsOpen (Limits.pullback.fst f' (wcQmSp A) ⁻¹' (e '' D)) :=
      ((Scheme.Hom.isOpenEmbedding e).isOpenMap D hD).preimage
        (Scheme.Hom.continuous (Limits.pullback.fst f' (wcQmSp A)))
    have hzO : z ∈ Limits.pullback.fst f' (wcQmSp A) ⁻¹' (e '' D) := ⟨y, h1, hz.symm⟩
    obtain ⟨w, hwO, hwT⟩ := mem_closure_iff.mp hcl _ hO hzO
    obtain ⟨y'', hy''D, hy''e⟩ := hwO
    apply hwT
    rw [hT w y'' hy''e.symm]
    have hm := hF w y'' hy''e.symm
    exact ((PrimeSpectrum.isPrime y'').mem_or_mem hm).resolve_right hy''D
  ·
    intro h1
    let P : Spec (.of (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))) :=
      (⟨_, hP⟩ : PrimeSpectrum (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))
    have hπP : algebraMap A (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) π ∈
        PrimeSpectrum.asIdeal P := by
      rw [halg]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
    have hfx : f' (e P) = wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) P := by
      rw [← Scheme.Hom.comp_apply, he]
    have hπx : π ∈ PrimeSpectrum.asIdeal (f' (e P)) := by
      rw [hfx]
      exact hπP
    have hmx : PrimeSpectrum.asIdeal (f' (e P)) = IsLocalRing.maximalIdeal A := by
      apply le_antisymm (IsLocalRing.le_maximalIdeal (PrimeSpectrum.isPrime _).ne_top)
      rw [hπ, Ideal.span_le, Set.singleton_subset_iff]
      exact hπx
    let pt : Spec (CommRingCat.of (IsLocalRing.ResidueField A)) :=
      (⟨⊥, inferInstance⟩ : PrimeSpectrum (IsLocalRing.ResidueField A))
    have hpt : f' (e P) = wcQmSp A pt := by
      apply PrimeSpectrum.ext
      rw [hmx]
      show IsLocalRing.maximalIdeal A = Ideal.comap (IsLocalRing.residue A) ⊥
      rw [← RingHom.ker_eq_comap_bot, IsLocalRing.ker_residue]
    obtain ⟨z', hz', -⟩ := Scheme.Pullback.exists_preimage_pullback (e P) pt hpt
    have hz'T : z' ∈ Tᶜ := fun hmem => hY0P ((hT z' P hz').mp hmem)
    haveI : IsClosedImmersion (wcQmSp A) :=
      IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
    have hind : Topology.IsInducing (Limits.pullback.fst f' (wcQmSp A)) :=
      (Scheme.Hom.isClosedEmbedding _).isInducing
    have hle : PrimeSpectrum.asIdeal P ≤ PrimeSpectrum.asIdeal y :=
      Ideal.span_le.mpr (Set.singleton_subset_iff.mpr h1)
    have hsp : e P ⤳ e y :=
      ((PrimeSpectrum.le_iff_specializes P y).mp hle).map (Scheme.Hom.continuous e)
    rw [← hz', ← hz, hind.specializes_iff] at hsp
    exact closure_mono (Set.singleton_subset_iff.mpr hz'T) (specializes_iff_mem_closure.mp hsp)

theorem wc_etqm_srd_cone_iso (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) (k : ℕ) (n : ℕ) (hn : Even n) (hn4 : 4 ≤ n) (π : A)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    (c : Matrix (Fin n) (Fin n) A)
    (hc : c = Matrix.of fun p q : Fin n => if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0)
    (X' : Scheme.{u}) (β : X' ⟶ Spec (.of (wcQuadModelRing A n π c)))
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun i : Fin n =>
        (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
          (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
            (MvPolynomial.X (⟨2 * (i.val / 2), lt_of_le_of_lt (Nat.mul_div_le i.val 2) i.isLt⟩ :
              Fin n)))))) β)
    (hprop : IsProper β) (f' : X' ⟶ Spec (.of A)) (hf' : β ≫ wcQuadModelStr A n π c = f')
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A))
    (hφπ : (Spec.preimage ξ).hom π ≠ 0)
    (Dh' : wcEtPullData (Limits.pullback.fst f' ξ) (ℓ ^ k))
    (Dg' : wcEtPullData (Limits.pullback.fst f' (wcQmSp A)) (ℓ ^ k))
    (I' : InjectiveResolution (SheafOfModules.unit (wcEtZModRing (Limits.pullback f' ξ) (ℓ ^ k))))
    (hk : 1 ≤ k) (Y : Scheme.{u}) (iY : Y ⟶ Limits.pullback f' (wcQmSp A)) [IsClosedImmersion iY]
    (hY : Set.range iY = {z | ¬ ∃ U : (Limits.pullback f' (wcQmSp A)).Opens, z ∈ U ∧
      Smooth (U.ι ≫ Limits.pullback.snd f' (wcQmSp A))})
    (DY : wcEtPullData iY (ℓ ^ k)) :
    haveI := Dg'.additive
    haveI := Dh'.additive
    let P' := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst f' ξ)) _ _ Dh'.cont Dh'.φ
    haveI : P'.Additive := Adjunction.right_adjoint_additive Dh'.adj
    let K' := (P'.mapHomologicalComplex (ComplexShape.up ℤ)).obj I'.cochainComplex
    let eK' := (HomologicalComplex.single (SheafOfModules.{u+1} (wcEtZModRing X' (ℓ ^ k))) (ComplexShape.up ℤ) 0).map
          (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst f' ξ)) _ _ Dh'.cont Dh'.φ) ≫
        (HomologicalComplex.singleMapHomologicalComplex P' (ComplexShape.up ℤ) 0).inv.app
          (SheafOfModules.unit (wcEtZModRing (Limits.pullback f' ξ) (ℓ ^ k))) ≫
        (P'.mapHomologicalComplex (ComplexShape.up ℤ)).map I'.ι'
    let eΨ' := (HomologicalComplex.single (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k))) (ComplexShape.up ℤ) 0).map
          Dg'.μ.inv ≫
        (HomologicalComplex.singleMapHomologicalComplex Dg'.Φ (ComplexShape.up ℤ) 0).inv.app
          (SheafOfModules.unit (wcEtZModRing X' (ℓ ^ k))) ≫
        (Dg'.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map eK'
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k)))
    Nonempty (DerivedCategory.Q.obj (CochainComplex.mappingCone eΨ') ≅
      (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
        (wcEtSuppObj DY)))⟦(-1 : ℤ)⟧) :=
by
  intro P' K' eK' eΨ'
  haveI := Dh'.additive
  haveI := Dg'.additive
  haveI : P'.Additive := Adjunction.right_adjoint_additive Dh'.adj
  letI := HasDerivedCategory.standard
    (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k)))
  haveI := Dg'.presLim
  haveI := Dg'.presColim
  haveI : Limits.PreservesFiniteLimits P' := by
    haveI := Dh'.adj.rightAdjoint_preservesLimits
    infer_instance
  have homology_transfer : ∀ {𝒜 𝒜' ℬ : Type (u+2)} [Category.{u+1} 𝒜] [Category.{u+1} 𝒜']
      [Category.{u+1} ℬ] [Abelian 𝒜] [Abelian 𝒜'] [Abelian ℬ]
      (P : 𝒜' ⥤ 𝒜) [P.Additive] [Limits.PreservesFiniteLimits P]
      (G : 𝒜 ⥤ ℬ) [G.Additive] [Limits.PreservesFiniteLimits G]
      [Limits.PreservesFiniteColimits G]
      {O : 𝒜} {O' : 𝒜'} {Os : ℬ} (u : O ⟶ P.obj O') (μ : G.obj O ≅ Os)
      (I : InjectiveResolution O'),
      let Ψ := (G.mapHomologicalComplex (ComplexShape.up ℤ)).obj
        ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex)
      (∀ q : ℕ, Nonempty (Ψ.homology (q : ℤ) ≅
          G.obj (((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q))) := by
    intro 𝒜 𝒜' ℬ _ _ _ _ _ _ P _ _ G _ _ _ O O' Os u μ I Ψ
    intro q
    let Kn := (P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex
    let L := (G.mapHomologicalComplex (ComplexShape.up ℕ)).obj Kn
    let φ : ∀ a : Option ℕ, G.obj (P.obj (HomologicalComplex.extend.X I.cocomplex a)) ≅
        HomologicalComplex.extend.X L a := fun a =>
      match a with
      | some k => Iso.refl _
      | none => Limits.IsZero.iso (G.map_isZero (P.map_isZero (Limits.isZero_zero _)))
          (Limits.isZero_zero _)
    have hφ : ∀ a b : Option ℕ,
        (φ a).hom ≫ HomologicalComplex.extend.d L a b =
          G.map (P.map (HomologicalComplex.extend.d I.cocomplex a b)) ≫ (φ b).hom := by
      intro a b
      cases a with
      | none => exact (G.map_isZero (P.map_isZero (Limits.isZero_zero _))).eq_of_src _ _
      | some i =>
        cases b with
        | none => exact (Limits.isZero_zero _).eq_of_tgt _ _
        | some j => exact (Category.id_comp _).trans (Category.comp_id _).symm
    let isoΨ : Ψ ≅ L.extend ComplexShape.embeddingUpNat :=
      HomologicalComplex.Hom.isoOfComponents
        (fun i => φ (ComplexShape.embeddingUpNat.r i))
        (fun i j _ => hφ _ _)
    exact ⟨HomologicalComplex.homologyMapIso isoΨ (q : ℤ) ≪≫
      L.extendHomologyIso ComplexShape.embeddingUpNat (j := q) rfl ≪≫
      (Kn.sc q).mapHomologyIso G⟩

  have hcov : ∀ x : X', ∃ (U : X'.Opens) (r : ℕ)
      (g : U.toScheme ⟶ Spec (.of (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))),
      x ∈ U ∧ Etale g ∧
      g ≫ wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) =
        U.ι ≫ f' := by
    obtain ⟨X₀, β₀, hbl₀, -, hcov₀, -⟩ := wc_etqm_sr_model A n hn hn4 π hπ c hc
    obtain ⟨φ, hφ, -⟩ := hbl₀.2 X' β hbl.1
    obtain ⟨ψ, hψ, -⟩ := hbl.2 X₀ β₀ hbl₀.1
    have h1 : φ ≫ ψ = 𝟙 X' := by
      apply (hbl.2 X' β hbl.1).unique
      · simp only [Category.assoc, hψ, hφ]
      · simp only [Category.id_comp]
    have h2 : ψ ≫ φ = 𝟙 X₀ := by
      apply (hbl₀.2 X₀ β₀ hbl₀.1).unique
      · simp only [Category.assoc, hφ, hψ]
      · simp only [Category.id_comp]
    haveI : IsIso φ := ⟨⟨ψ, h1, h2⟩⟩
    have hf : φ ≫ β₀ ≫ wcQuadModelStr A n π c = f' := by
      rw [← Category.assoc, hφ, hf']
    intro x
    obtain ⟨U₀, r, g₀, hx, hg₀, heq⟩ := hcov₀ (φ x)
    haveI := hg₀
    refine ⟨φ ⁻¹ᵁ U₀, r, (φ ∣_ U₀) ≫ g₀, ?_, ?_, ?_⟩
    · exact (Scheme.Hom.mem_preimage φ).mpr hx
    · infer_instance
    · rw [Category.assoc, heq, ← Category.assoc, morphismRestrict_ι, Category.assoc, hf]

  have hYset : Set.range iY = closure (wcSrhlExc A n π c β f')ᶜ ∩ wcSrhlExc A n π c β f' := by
    obtain ⟨r, rfl⟩ : ∃ r, n = r + 2 := ⟨n - 2, by omega⟩
    obtain ⟨e, he_open, he_str, he_cov, he_fib⟩ := wc_srdci_charts A r hn hn4 π hπ c hc X' β hbl
    rw [hY]
    ext z
    obtain ⟨j, y, hy⟩ := he_cov (Limits.pullback.fst f' (wcQmSp A) z)
    haveI := he_open j
    have hef : e j ≫ f' = wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) := by
      rw [← hf']
      exact he_str j
    have hT : ∀ (z' : ↥(Limits.pullback f' (wcQmSp A)))
        (y' : Spec (.of (wcQuadModelRing A (r + 2) π
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))),
        Limits.pullback.fst f' (wcQmSp A) z' = e j y' →
          (z' ∈ wcSrhlExc A (r + 2) π c β f' ↔ Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
            (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
            (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal y') := by
      intro z' y' hz'
      change (Limits.pullback.fst f' (wcQmSp A) ≫ β) z' ∈ PrimeSpectrum.zeroLocus _ ↔ _
      rw [Scheme.Hom.comp_apply, hz']
      exact he_fib j y'
    have hD := wc_srdci_chart_closure_iff A r π hπ X' f' (e j) hef _ hT z y hy.symm
    have hE := hT z y hy.symm
    constructor
    · intro hS
      refine ⟨hD.mpr ?_, hE.mpr ?_⟩
      · by_contra h
        exact hS (wc_srdci_offdouble_fibre_smooth A r π X' f' (e j) hef z y hy.symm (Or.inr h))
      · by_contra h
        exact hS (wc_srdci_offdouble_fibre_smooth A r π X' f' (e j) hef z y hy.symm (Or.inl h))
    · rintro ⟨hz1, hz2⟩
      exact wc_srdci_double_fibre_not_smooth A r π X' f' (e j) hef z y hy.symm (hE.mp hz2)
        (hD.mp hz1)

  have hGE := wc_etqm_sr_ss_cone_ge_one A ℓ hℓ k π hπ X' f' hcov Ω ξ hφπ Dh' Dg' I'
  have ha := homology_transfer P' Dg'.Φ
    (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
      (wcEtBaseChange (Limits.pullback.fst f' ξ)) _ _ Dh'.cont Dh'.φ)
    Dg'.μ I'
  have hΨ : ∀ q : ℤ, 2 ≤ q → Limits.IsZero
      (((Dg'.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj
        ((P'.mapHomologicalComplex (ComplexShape.up ℤ)).obj I'.cochainComplex)).homology q) := by
    intro q hq
    obtain ⟨m, rfl⟩ := Int.eq_ofNat_of_zero_le (by omega : (0 : ℤ) ≤ q)
    obtain ⟨iso⟩ := ha m
    exact Limits.IsZero.of_iso (wc_etqm_sr_ss_restr_higher_vanish A ℓ hℓ k hk π hπ X' f' hcov
      Ω ξ hφπ Dh' Dg' I' m (by omega)) iso
  have hR1 := wc_etqm_srhl_R1_supp A ℓ hℓ k hk n hn hn4 π hπ c hc X' β hbl hprop f' hf' hcov
    Ω ξ hφπ Dh' Dg' I' iY hYset DY
  have h1 : Nonempty (((Dg'.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj
        ((P'.mapHomologicalComplex (ComplexShape.up ℤ)).obj I'.cochainComplex)).homology 1 ≅
      wcEtSuppObj DY) := by
    obtain ⟨i1⟩ := ha 1
    obtain ⟨i2⟩ := hR1
    exact ⟨i1 ≪≫ i2⟩
  obtain ⟨θ⟩ := wc_qmbt_hl_cone_single _ (wcEtSuppObj DY) _ eΨ' hGE hΨ h1

  exact ⟨((shiftFunctorCompIsoId (DerivedCategory
      (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k))))
      (1 : ℤ) (-1) (by norm_num)).app _).symm ≪≫
    (shiftFunctor (DerivedCategory
      (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k)))) (-1 : ℤ)).mapIso θ ≪≫
    (shiftFunctor (DerivedCategory
      (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k)))) (-1 : ℤ)).mapIso
      ((DerivedCategory.singleFunctorIsoCompQ
        (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k))) 0).app
        (wcEtSuppObj DY))⟩

theorem wc_srdcb_bounded_devissage {𝒞 : Type*} [Category 𝒞] [Abelian 𝒞] [HasDerivedCategory 𝒞]
    (T Y : DerivedCategory 𝒞) (a b N : ℤ) [Y.IsGE a] [Y.IsLE b]
    (h : ∀ j : ℤ, a ≤ j → j ≤ b →
      ∀ f : T ⟶ (DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj
          ((DerivedCategory.homologyFunctor 𝒞 j).obj Y)))⟦N - j⟧, f = 0) :
    ∀ f : T ⟶ Y⟦N⟧, f = 0 :=
by

  have killIso : ∀ {Z Z' : DerivedCategory 𝒞} (e : Z ≅ Z'), (∀ g : T ⟶ Z', g = 0) →
      ∀ g : T ⟶ Z, g = 0 := by
    intro Z Z' e hZ g
    calc g = (g ≫ e.hom) ≫ e.inv := by simp
      _ = 0 := by rw [hZ (g ≫ e.hom), Limits.zero_comp]

  have s5 : ∀ (Tr : Pretriangulated.Triangle (DerivedCategory 𝒞)), Tr ∈ distTriang _ →
      ∀ M : ℤ, (∀ g : T ⟶ Tr.obj₁⟦M⟧, g = 0) → (∀ g : T ⟶ Tr.obj₃⟦M⟧, g = 0) →
      ∀ g : T ⟶ Tr.obj₂⟦M⟧, g = 0 := by
    intro Tr hTr M h1 h3 g
    have hsh := Pretriangulated.Triangle.shift_distinguished Tr hTr M
    rw [Pretriangulated.Triangle.shiftFunctor_eq, Pretriangulated.Triangle.shiftFunctor_obj] at hsh
    obtain ⟨g', hg'⟩ := Pretriangulated.Triangle.coyoneda_exact₂ _ hsh g (by
      dsimp
      rw [Units.smul_def, Preadditive.comp_zsmul, h3 (g ≫ (shiftFunctor _ M).map Tr.mor₂),
        smul_zero])
    rw [hg', h1 g', Limits.zero_comp]

  have s1 : ∀ (Z : DerivedCategory 𝒞) (p q : ℤ), q < p → Z.IsGE p → Z.IsLE q →
      ∀ M : ℤ, ∀ g : T ⟶ Z⟦M⟧, g = 0 := by
    intro Z p q hqp hge hle M g
    have hid : 𝟙 Z = 0 :=
      DerivedCategory.TStructure.t.zero_of_isLE_of_isGE (𝟙 Z) q p hqp hle hge
    have hz : Limits.IsZero Z := (Limits.IsZero.iff_id_eq_zero Z).mpr hid
    exact ((shiftFunctor _ M).map_isZero hz).eq_of_tgt _ _

  have s2 : ∀ (Z : DerivedCategory 𝒞) (c d : ℤ) (hcd : c + 1 = d) (i : ℤ), i ≤ c →
      IsIso ((DerivedCategory.homologyFunctor 𝒞 i).map
        ((DerivedCategory.TStructure.t.truncLEι c).app Z)) := by
    intro Z c d hcd i hi
    have hTr := DerivedCategory.TStructure.t.triangleLEGE_distinguished c d hcd Z
    have ex1 := DerivedCategory.HomologySequence.exact₁ _ hTr (i - 1) i (by omega)
    have ex2 := DerivedCategory.HomologySequence.exact₂ _ hTr i
    haveI : ((DerivedCategory.TStructure.t.truncGE d).obj Z).IsGE d :=
      DerivedCategory.TStructure.t.isGE_truncGE_obj Z d d
    have hz3 : ∀ k, k < d → Limits.IsZero ((DerivedCategory.homologyFunctor 𝒞 k).obj
        (((DerivedCategory.TStructure.t.triangleLEGE c d hcd).obj Z).obj₃)) := by
      intro k hk
      rw [DerivedCategory.TStructure.t.triangleLEGE_obj_obj₃]
      exact DerivedCategory.isZero_of_isGE _ d k hk
    have hm : Mono ((DerivedCategory.homologyFunctor 𝒞 i).map
        ((DerivedCategory.TStructure.t.triangleLEGE c d hcd).obj Z).mor₁) :=
      ex1.mono_g ((hz3 (i - 1) (by omega)).eq_of_src _ _)
    have he : Epi ((DerivedCategory.homologyFunctor 𝒞 i).map
        ((DerivedCategory.TStructure.t.triangleLEGE c d hcd).obj Z).mor₁) :=
      ex2.epi_f ((hz3 i (by omega)).eq_of_tgt _ _)
    have hI := @isIso_of_mono_of_epi _ _ _ _ _ _ hm he
    exact hI

  have s3 : ∀ (Z : DerivedCategory 𝒞) (c d : ℤ) (hcd : c + 1 = d) (i : ℤ), d ≤ i →
      IsIso ((DerivedCategory.homologyFunctor 𝒞 i).map
        ((DerivedCategory.TStructure.t.truncGEπ d).app Z)) := by
    intro Z c d hcd i hi
    have hTr := DerivedCategory.TStructure.t.triangleLEGE_distinguished c d hcd Z
    have ex2 := DerivedCategory.HomologySequence.exact₂ _ hTr i
    have ex3 := DerivedCategory.HomologySequence.exact₃ _ hTr i (i + 1) rfl
    haveI : ((DerivedCategory.TStructure.t.truncLE c).obj Z).IsLE c :=
      DerivedCategory.TStructure.t.isLE_truncLE_obj Z c c
    have hz1 : ∀ k, c < k → Limits.IsZero ((DerivedCategory.homologyFunctor 𝒞 k).obj
        (((DerivedCategory.TStructure.t.triangleLEGE c d hcd).obj Z).obj₁)) := by
      intro k hk
      rw [DerivedCategory.TStructure.t.triangleLEGE_obj_obj₁]
      exact DerivedCategory.isZero_of_isLE _ c k hk
    have hm : Mono ((DerivedCategory.homologyFunctor 𝒞 i).map
        ((DerivedCategory.TStructure.t.triangleLEGE c d hcd).obj Z).mor₂) :=
      ex2.mono_g ((hz1 i (by omega)).eq_of_src _ _)
    have he : Epi ((DerivedCategory.homologyFunctor 𝒞 i).map
        ((DerivedCategory.TStructure.t.triangleLEGE c d hcd).obj Z).mor₂) :=
      ex3.epi_f ((hz1 (i + 1) (by omega)).eq_of_tgt _ _)
    have hI := @isIso_of_mono_of_epi _ _ _ _ _ _ hm he
    exact hI

  have main : ∀ n : ℕ, ∀ (Y : DerivedCategory 𝒞) (b : ℤ), b - a < n → Y.IsGE a → Y.IsLE b →
      (∀ j : ℤ, a ≤ j → j ≤ b →
        ∀ f : T ⟶ (DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj
          ((DerivedCategory.homologyFunctor 𝒞 j).obj Y)))⟦N - j⟧, f = 0) →
      ∀ f : T ⟶ Y⟦N⟧, f = 0 := by
    intro n
    induction n with
    | zero =>
      intro Y b hd hge hle _ f
      exact s1 Y a b (by omega) hge hle N f
    | succ n ih =>
      intro Y b hd hge hle hY f
      by_cases hba : b < a
      · exact s1 Y a b hba hge hle N f
      have hTr := DerivedCategory.TStructure.t.triangleLEGE_distinguished (b - 1) b (by omega) Y
      have hf := s5 _ hTr N ?_ ?_
      · rw [DerivedCategory.TStructure.t.triangleLEGE_obj_obj₂] at hf
        exact hf f
      ·
        rw [DerivedCategory.TStructure.t.triangleLEGE_obj_obj₁]
        have hiso : ∀ i, i ≤ b - 1 → IsIso ((DerivedCategory.homologyFunctor 𝒞 i).map
            ((DerivedCategory.TStructure.t.truncLEι (b - 1)).app Y)) :=
          fun i hi => s2 Y (b - 1) b (by omega) i hi
        have hge' : ((DerivedCategory.TStructure.t.truncLE (b - 1)).obj Y).IsGE a := by
          rw [DerivedCategory.isGE_iff]
          intro i hi
          haveI := hiso i (by omega)
          exact (DerivedCategory.isZero_of_isGE Y a i hi).of_iso
            (asIso ((DerivedCategory.homologyFunctor 𝒞 i).map
              ((DerivedCategory.TStructure.t.truncLEι (b - 1)).app Y)))
        have hle' : ((DerivedCategory.TStructure.t.truncLE (b - 1)).obj Y).IsLE (b - 1) :=
          DerivedCategory.TStructure.t.isLE_truncLE_obj Y (b - 1) (b - 1)
        refine ih _ (b - 1) (by omega) hge' hle' ?_
        intro j hj1 hj2 g
        haveI := hiso j hj2
        exact killIso ((shiftFunctor _ (N - j)).mapIso (DerivedCategory.Q.mapIso
          ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).mapIso
            (asIso ((DerivedCategory.homologyFunctor 𝒞 j).map
              ((DerivedCategory.TStructure.t.truncLEι (b - 1)).app Y))))))
          (hY j hj1 (by omega)) g
      ·
        rw [DerivedCategory.TStructure.t.triangleLEGE_obj_obj₃]
        have hiso : ∀ i, b ≤ i → IsIso ((DerivedCategory.homologyFunctor 𝒞 i).map
            ((DerivedCategory.TStructure.t.truncGEπ b).app Y)) :=
          fun i hi => s3 Y (b - 1) b (by omega) i hi
        haveI hge'' : ((DerivedCategory.TStructure.t.truncGE b).obj Y).IsGE b :=
          DerivedCategory.TStructure.t.isGE_truncGE_obj Y b b
        haveI hle'' : ((DerivedCategory.TStructure.t.truncGE b).obj Y).IsLE b := by
          rw [DerivedCategory.isLE_iff]
          intro i hi
          haveI := hiso i (by omega)
          exact (DerivedCategory.isZero_of_isLE Y b i hi).of_iso
            (asIso ((DerivedCategory.homologyFunctor 𝒞 i).map
              ((DerivedCategory.TStructure.t.truncGEπ b).app Y))).symm
        obtain ⟨V, ⟨e₁⟩⟩ := DerivedCategory.exists_iso_singleFunctor_obj_of_isGE_of_isLE
          ((DerivedCategory.TStructure.t.truncGE b).obj Y) b
        haveI := hiso b le_rfl
        let e₂ : (DerivedCategory.homologyFunctor 𝒞 b).obj Y ≅ V :=
          asIso ((DerivedCategory.homologyFunctor 𝒞 b).map
              ((DerivedCategory.TStructure.t.truncGEπ b).app Y)) ≪≫
            (DerivedCategory.homologyFunctor 𝒞 b).mapIso e₁ ≪≫
            (DerivedCategory.singleFunctorCompHomologyFunctorIso 𝒞 b).app V
        let E : ((DerivedCategory.TStructure.t.truncGE b).obj Y)⟦N⟧ ≅
            (DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj
              ((DerivedCategory.homologyFunctor 𝒞 b).obj Y)))⟦N - b⟧ :=
          (shiftFunctor _ N).mapIso e₁ ≪≫
            ((DerivedCategory.singleFunctors 𝒞).shiftIso N (b - N) b (by omega)).app V ≪≫
            (((DerivedCategory.singleFunctors 𝒞).shiftIso (N - b) (b - N) 0 (by omega)).app V).symm ≪≫
            (shiftFunctor _ (N - b)).mapIso ((DerivedCategory.singleFunctorIsoCompQ 𝒞 0).app V) ≪≫
            (shiftFunctor _ (N - b)).mapIso (DerivedCategory.Q.mapIso
              ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).mapIso e₂.symm))
        exact killIso E (hY b (by omega) le_rfl)
  intro f
  exact main ((b - a).toNat + 1) Y b (by have := Int.self_le_toNat (b - a); omega)
    inferInstance inferInstance h f

theorem wc_srdcb_cone_homology {𝒞 : Type*} [Category 𝒞] [Abelian 𝒞] [HasDerivedCategory 𝒞]
    (O : 𝒞) (Bb C : DerivedCategory 𝒞) [Bb.IsGE 0]
    (u : DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj O) ⟶ Bb)
    (hu : IsIso ((DerivedCategory.homologyFunctor 𝒞 0).map u)) (v : Bb ⟶ C)
    (w : C ⟶ (DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj O))⟦(1 : ℤ)⟧)
    (hT : Pretriangulated.Triangle.mk u v w ∈ distTriang _) :
    C.IsGE 1 ∧ ∀ j : ℤ, 1 ≤ j → IsIso ((DerivedCategory.homologyFunctor 𝒞 j).map v) :=
by
  have hL : ∀ j : ℤ, j ≠ 0 → Limits.IsZero ((DerivedCategory.homologyFunctor 𝒞 j).obj
      (DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj O))) := by
    intro j hj
    exact (HomologicalComplex.isZero_single_obj_homology (ComplexShape.up ℤ) 0 O j hj).of_iso
      ((DerivedCategory.homologyFunctorFactors 𝒞 j).app _)
  have hB : ∀ j : ℤ, j < 0 → Limits.IsZero ((DerivedCategory.homologyFunctor 𝒞 j).obj Bb) :=
    fun j hj => DerivedCategory.isZero_of_isGE Bb 0 j hj
  have := hu
  have hv0 : (DerivedCategory.homologyFunctor 𝒞 0).map v = 0 :=
    ((DerivedCategory.HomologySequence.exact₂ _ hT 0).epi_f_iff).mp (by
      change Epi ((DerivedCategory.homologyFunctor 𝒞 0).map u); infer_instance)
  have hδ : DerivedCategory.HomologySequence.δ (Pretriangulated.Triangle.mk u v w) (-1) 0
      (by norm_num) = 0 :=
    ((DerivedCategory.HomologySequence.exact₁ _ hT (-1) 0 (by norm_num)).mono_g_iff).mp (by
      change Mono ((DerivedCategory.homologyFunctor 𝒞 0).map u); infer_instance)
  refine ⟨?_, ?_⟩
  · rw [DerivedCategory.isGE_iff]
    intro j hj
    rcases (show j = 0 ∨ j = -1 ∨ j < -1 by omega) with h | h | h
    · subst h
      exact (DerivedCategory.HomologySequence.exact₃ _ hT 0 1 (by norm_num)).isZero_X₂ hv0
        ((hL 1 (by norm_num)).eq_of_tgt _ _)
    · subst h
      exact (DerivedCategory.HomologySequence.exact₃ _ hT (-1) 0 (by norm_num)).isZero_X₂
        ((hB (-1) (by norm_num)).eq_of_src _ _) hδ
    · exact (DerivedCategory.HomologySequence.exact₃ _ hT j (j + 1) rfl).isZero_X₂
        ((hB j (by omega)).eq_of_src _ _) ((hL (j + 1) (by omega)).eq_of_tgt _ _)
  · intro j hj
    have : Mono ((DerivedCategory.homologyFunctor 𝒞 j).map v) :=
      (DerivedCategory.HomologySequence.exact₂ _ hT j).mono_g ((hL j (by omega)).eq_of_src _ _)
    have : Epi ((DerivedCategory.homologyFunctor 𝒞 j).map v) :=
      (DerivedCategory.HomologySequence.exact₃ _ hT j (j + 1) rfl).epi_f
        ((hL (j + 1) (by omega)).eq_of_tgt _ _)
    exact isIso_of_mono_of_epi _

theorem wc_srdcb_transpose_H0 {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] [HasDerivedCategory 𝒜]
    {𝒜' : Type*} [Category 𝒜'] [Abelian 𝒜'] [HasDerivedCategory 𝒜'] [EnoughInjectives 𝒜']
    (P : 𝒜' ⥤ 𝒜) [P.Additive] (Φ : 𝒜 ⥤ 𝒜') [Φ.Additive] [Limits.PreservesFiniteLimits Φ]
    [Limits.PreservesFiniteColimits Φ] (adj : Φ ⊣ P) (M : 𝒜) (M' : 𝒜') (μ : Φ.obj M ≅ M')
    (h1 : DerivedCategory.TStructure.t.plus (DerivedCategory.Q.obj
      ((HomologicalComplex.single 𝒜' (ComplexShape.up ℤ) 0).obj M'))) :
    ∃ u : DerivedCategory.Q.obj ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).obj M) ⟶
        (P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).obj
          (⟨_, h1⟩ : DerivedCategory.Plus 𝒜'),
      IsIso (adj.unit.app M ≫ P.map μ.hom) →
        IsIso ((DerivedCategory.homologyFunctor 𝒜 0).map u) :=
by
  classical

  have hS3 : ∀ (T : 𝒜) (Y : DerivedCategory 𝒜) [Y.IsGE 0] [Y.IsLE 0],
      Function.Bijective (fun φ : DerivedCategory.Q.obj
          ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).obj T) ⟶ Y =>
        (DerivedCategory.homologyFunctor 𝒜 0).map φ) := by
    intro T Y _ _
    obtain ⟨Z, ⟨e⟩⟩ := DerivedCategory.exists_iso_singleFunctor_obj_of_isGE_of_isLE Y 0
    let α := (DerivedCategory.singleFunctorIsoCompQ 𝒜 0).app T
    let S := DerivedCategory.singleFunctor 𝒜 0
    have hSff : S.FullyFaithful := Functor.FullyFaithful.ofFullyFaithful S
    have hSH : (S ⋙ DerivedCategory.homologyFunctor 𝒜 0).FullyFaithful :=
      (Functor.FullyFaithful.id 𝒜).ofIso (DerivedCategory.singleFunctorCompHomologyFunctorIso 𝒜 0).symm
    have hH : Function.Bijective (fun g : S.obj T ⟶ S.obj Z =>
        (DerivedCategory.homologyFunctor 𝒜 0).map g) :=
      (Function.Bijective.of_comp_iff _ (hSff.map_bijective T Z)).mp (hSH.map_bijective T Z)
    have heq : (fun φ : DerivedCategory.Q.obj
          ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).obj T) ⟶ Y =>
        (DerivedCategory.homologyFunctor 𝒜 0).map φ) =
        ((DerivedCategory.homologyFunctor 𝒜 0).mapIso α).homCongr
            ((DerivedCategory.homologyFunctor 𝒜 0).mapIso e).symm ∘
          (fun g : S.obj T ⟶ S.obj Z => (DerivedCategory.homologyFunctor 𝒜 0).map g) ∘
            (α.symm.homCongr e) := by
      funext φ
      simp only [Function.comp_apply, Iso.homCongr_apply, Functor.mapIso_inv,
        Iso.symm_inv, Iso.symm_hom]
      rw [← Functor.map_comp, ← Functor.map_comp]
      congr 1
      simp
    rw [heq]
    exact (Equiv.bijective _).comp (hH.comp (Equiv.bijective _))

  have main : ∀ (B : DerivedCategory 𝒜) [B.IsGE 0]
      (u : DerivedCategory.Q.obj ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).obj M) ⟶ B),
      (∀ T : 𝒜, Function.Bijective (fun a : T ⟶ M =>
        DerivedCategory.Q.map ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map a) ≫ u)) →
      IsIso ((DerivedCategory.homologyFunctor 𝒜 0).map u) := by
    intro B _ u hβ
    let ι := (DerivedCategory.TStructure.t.truncLEι 0).app B
    haveI : ((DerivedCategory.TStructure.t.truncLE 0).obj B).IsLE 0 := inferInstance
    haveI : ((DerivedCategory.TStructure.t.truncLE 0).obj B).IsGE 0 := inferInstance
    have hιiso : IsIso ((DerivedCategory.homologyFunctor 𝒜 0).map ι) := by
      have hT := DerivedCategory.TStructure.t.triangleLEGE_distinguished 0 1 (by norm_num) B
      have hz1 : Limits.IsZero ((DerivedCategory.homologyFunctor 𝒜 (-1)).obj
          ((DerivedCategory.TStructure.t.truncGE 1).obj B)) :=
        DerivedCategory.isZero_of_isGE _ 1 (-1) (by norm_num)
      have hz0 : Limits.IsZero ((DerivedCategory.homologyFunctor 𝒜 0).obj
          ((DerivedCategory.TStructure.t.truncGE 1).obj B)) :=
        DerivedCategory.isZero_of_isGE _ 1 0 (by norm_num)
      have hmono : Mono ((DerivedCategory.homologyFunctor 𝒜 0).map ι) :=
        (DerivedCategory.HomologySequence.exact₁ _ hT (-1) 0 (by norm_num)).mono_g
          (hz1.eq_of_src _ _)
      have hepi : Epi ((DerivedCategory.homologyFunctor 𝒜 0).map ι) :=
        (DerivedCategory.HomologySequence.exact₂ _ hT 0).epi_f (hz0.eq_of_tgt _ _)
      exact isIso_of_mono_of_epi _
    have hι : ∀ T : 𝒜, Function.Bijective (fun φ' : DerivedCategory.Q.obj
        ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).obj T) ⟶
          (DerivedCategory.TStructure.t.truncLE 0).obj B => φ' ≫ ι) := by
      intro T
      refine ⟨fun f₁ f₂ h => DerivedCategory.TStructure.t.to_truncLE_obj_ext h, fun φ =>
        ⟨DerivedCategory.TStructure.t.liftTruncLE φ 0,
          DerivedCategory.TStructure.t.liftTruncLE_ι φ 0⟩⟩
    have hγ : ∀ T : 𝒜, Function.Bijective (fun φ : DerivedCategory.Q.obj
        ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).obj T) ⟶ B =>
          (DerivedCategory.homologyFunctor 𝒜 0).map φ) := by
      intro T
      refine (Function.Bijective.of_comp_iff _ (hι T)).mp ?_
      have heq : (fun φ : DerivedCategory.Q.obj
          ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).obj T) ⟶ B =>
            (DerivedCategory.homologyFunctor 𝒜 0).map φ) ∘ (fun φ' => φ' ≫ ι) =
          (fun ψ => ψ ≫ (DerivedCategory.homologyFunctor 𝒜 0).map ι) ∘
            (fun φ' : DerivedCategory.Q.obj
              ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).obj T) ⟶
                (DerivedCategory.TStructure.t.truncLE 0).obj B =>
              (DerivedCategory.homologyFunctor 𝒜 0).map φ') := by
        funext φ'
        simp only [Function.comp_apply, Functor.map_comp]
      rw [heq]
      refine Function.Bijective.comp ?_ (hS3 T _)
      exact ⟨fun x y h => (cancel_mono _).mp h,
        fun z => ⟨z ≫ inv ((DerivedCategory.homologyFunctor 𝒜 0).map ι), by simp⟩⟩
    let E : (HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0 ⋙ DerivedCategory.Q) ⋙
        DerivedCategory.homologyFunctor 𝒜 0 ≅ 𝟭 𝒜 :=
      Functor.isoWhiskerRight (DerivedCategory.singleFunctorIsoCompQ 𝒜 0).symm
          (DerivedCategory.homologyFunctor 𝒜 0) ≪≫
        DerivedCategory.singleFunctorCompHomologyFunctorIso 𝒜 0
    let f := E.inv.app M ≫ (DerivedCategory.homologyFunctor 𝒜 0).map u
    have hf : IsIso f := by
      apply isIso_of_yoneda_map_bijective
      intro T
      have heq : (fun a : T ⟶ M => a ≫ f) = (fun x => E.inv.app T ≫ x) ∘
          (fun φ : DerivedCategory.Q.obj
            ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).obj T) ⟶ B =>
              (DerivedCategory.homologyFunctor 𝒜 0).map φ) ∘
          (fun a : T ⟶ M =>
            DerivedCategory.Q.map ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map a) ≫ u) := by
        funext a
        have hn := E.inv.naturality a
        simp only [Functor.id_map, Functor.comp_map] at hn
        simp only [Function.comp_apply, f]
        rw [← Category.assoc, hn, Category.assoc, Functor.map_comp]
      have hb : Function.Bijective (fun a : T ⟶ M => a ≫ f) := by
        rw [heq]
        refine Function.Bijective.comp ?_ ((hγ T).comp (hβ T))
        exact ⟨fun x y h => (cancel_epi _).mp h, fun z => ⟨E.hom.app T ≫ z, by simp⟩⟩
      exact hb
    haveI := hf
    have hu : (DerivedCategory.homologyFunctor 𝒜 0).map u = E.hom.app M ≫ f := by simp [f]
    rw [hu]
    infer_instance

  obtain ⟨τ, -, hτ2, -⟩ := wc_rdfp_plus_adj_transpose P Φ adj
  let Y₀ : DerivedCategory.Plus 𝒜' := ⟨_, h1⟩
  let w : DerivedCategory.Q.obj ((Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj
      ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).obj M)) ⟶ Y₀.obj :=
    DerivedCategory.Q.map
      ((HomologicalComplex.singleMapHomologicalComplex Φ (ComplexShape.up ℤ) 0).hom.app M ≫
        (HomologicalComplex.single 𝒜' (ComplexShape.up ℤ) 0).map μ.hom)
  refine ⟨(τ _ Y₀).symm w, fun hiso => ?_⟩
  have hu : τ _ Y₀ ((τ _ Y₀).symm w) = w := Equiv.apply_symm_apply _ _
  generalize (τ _ Y₀).symm w = u at hu ⊢
  haveI hB : ((P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).obj Y₀).IsGE 0 :=
    wc_rdfp_plus_isGE_zero P _ h1
  refine main _ u (fun T => ?_)
  let θ := adj.unit.app M ≫ P.map μ.hom
  let σT := (HomologicalComplex.singleMapHomologicalComplex Φ (ComplexShape.up ℤ) 0).hom.app T
  have key : ∀ a : T ⟶ M, τ _ Y₀
      (DerivedCategory.Q.map ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map a) ≫ u) =
      DerivedCategory.Q.map σT ≫ DerivedCategory.Q.map
        ((HomologicalComplex.single 𝒜' (ComplexShape.up ℤ) 0).map
          ((adj.homEquiv T M').symm (a ≫ θ))) := by
    intro a
    have e1 : (adj.homEquiv T M').symm (a ≫ θ) = Φ.map a ≫ μ.hom := by
      rw [Equiv.symm_apply_eq, Adjunction.homEquiv_naturality_left, Adjunction.homEquiv_unit]
    rw [e1, hτ2, hu]
    simp only [w, ← Functor.map_comp]
    congr 1
    have hn := (HomologicalComplex.singleMapHomologicalComplex Φ (ComplexShape.up ℤ) 0).hom.naturality a
    simp only [Functor.comp_map] at hn
    rw [← Category.assoc, hn, Category.assoc, Functor.map_comp]
  have hcomp : (τ _ Y₀) ∘ (fun a : T ⟶ M =>
      DerivedCategory.Q.map ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map a) ≫ u) =
      (fun x => DerivedCategory.Q.map σT ≫ x) ∘
        (fun b : Φ.obj T ⟶ M' => DerivedCategory.Q.map
          ((HomologicalComplex.single 𝒜' (ComplexShape.up ℤ) 0).map b)) ∘
        (adj.homEquiv T M').symm ∘ (fun a : T ⟶ M => a ≫ θ) := funext key
  refine ((Function.Bijective.of_comp_iff' (τ _ Y₀).bijective _).mp ?_)
  rw [hcomp]
  have hθ : Function.Bijective (fun a : T ⟶ M => a ≫ θ) :=
    ⟨fun x y h => (cancel_mono θ).mp h, fun z => ⟨z ≫ inv θ, by simp [θ]⟩⟩
  have hs' : Function.Bijective (fun b : Φ.obj T ⟶ M' => DerivedCategory.Q.map
      ((HomologicalComplex.single 𝒜' (ComplexShape.up ℤ) 0).map b)) :=
    ((Functor.FullyFaithful.ofFullyFaithful (DerivedCategory.singleFunctor 𝒜' 0)).ofIso
      (DerivedCategory.singleFunctorIsoCompQ 𝒜' 0)).map_bijective (Φ.obj T) M'
  have hσ : Function.Bijective (fun x : DerivedCategory.Q.obj
      ((HomologicalComplex.single 𝒜' (ComplexShape.up ℤ) 0).obj (Φ.obj T)) ⟶ Y₀.obj =>
        DerivedCategory.Q.map σT ≫ x) :=
    ⟨fun x y h => (cancel_epi _).mp h,
      fun z => ⟨inv (DerivedCategory.Q.map σT) ≫ z, by simp⟩⟩
  exact hσ.comp (hs'.comp ((Equiv.bijective _).comp hθ))

theorem wc_srdcbu_unit_iso_of_lc_bij : ∀ {S S' : Scheme.{u}} (g : S' ⟶ S) (n : ℕ) (E : wcEtPullData g n), (∀ V : S.Etale, Function.Bijective (LocallyConstant.comap ⟨Limits.pullback.fst V.hom g, (Limits.pullback.fst V.hom g).continuous⟩ : LocallyConstant V.left (ZMod n) → LocallyConstant ↥(Limits.pullback V.hom g) (ZMod n))) → IsIso (wcEtSuppUnitMap E) :=
by
  classical
  intro S S' g n E hbc

  have hA : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] {J : GrothendieckTopology C}
      {K : GrothendieckTopology D} (F : C ⥤ D) [F.IsContinuous J K] (R : Sheaf J RingCat.{u+1})
      (S : Sheaf K RingCat.{u+1}) (φ : R ⟶ (F.sheafPushforwardContinuous RingCat.{u+1} J K).obj S)
      (Φ : SheafOfModules.{u+1} R ⥤ SheafOfModules.{u+1} S)
      (adj : Φ ⊣ SheafOfModules.pushforward.{u+1} φ),
      (Φ.obj (SheafOfModules.unit R) ≅ SheafOfModules.unit S) →
      (∀ (X : Dᵒᵖ) (a b : S.obj.obj X), a * b = b * a) →
      (∀ X : Cᵒᵖ, Function.Bijective (φ.hom.app X).hom) →
      IsIso (adj.unit.app (SheafOfModules.unit R)) := by
    intro C D _ _ J K F _ R S φ Φ adj μ hcomm hbij
    let ψ : SheafOfModules.unit R ⟶
        (SheafOfModules.pushforward.{u+1} φ).obj (SheafOfModules.unit S) :=
      adj.homEquiv _ _ μ.hom
    have hψ : ψ = adj.unit.app _ ≫ (SheafOfModules.pushforward.{u+1} φ).map μ.hom :=
      adj.homEquiv_unit _ _ μ.hom
    let ψX : ∀ X : Cᵒᵖ, R.obj.obj X → S.obj.obj (Opposite.op (F.obj X.unop)) :=
      fun X r => (ψ.val.app X).hom r
    let φX : ∀ X : Cᵒᵖ, R.obj.obj X →+* S.obj.obj (Opposite.op (F.obj X.unop)) :=
      fun X => (φ.hom.app X).hom
    have hlin : ∀ (X : Cᵒᵖ) (r : R.obj.obj X), ψX X r = φX X r * ψX X 1 := by
      intro X r
      calc ψX X r = ψX X (r * 1) := by rw [mul_one]
        _ = φX X r * ψX X 1 := (ψ.val.app X).hom.map_smul r (1 : R.obj.obj X)
    let s : ((SheafOfModules.pushforward.{u+1} φ).obj (SheafOfModules.unit S)).sections :=
      PresheafOfModules.sectionsMk
        (M := ((SheafOfModules.pushforward.{u+1} φ).obj (SheafOfModules.unit S)).val)
        (fun X => (1 : S.obj.obj (Opposite.op (F.obj X.unop))))
        (fun _ _ h => map_one (S.obj.map (F.map h.unop).op).hom)
    let f : SheafOfModules.unit R ⟶
        (SheafOfModules.pushforward.{u+1} φ).obj (SheafOfModules.unit S) :=
      (SheafOfModules.unitHomEquiv _).symm s
    have hf1 : ∀ X, ((f.val.app X).hom (1 : R.obj.obj X) :
        S.obj.obj (Opposite.op (F.obj X.unop))) = (1 : S.obj.obj (Opposite.op (F.obj X.unop))) := by
      intro X
      have h1 := SheafOfModules.unitHomEquiv_apply_coe
        ((SheafOfModules.pushforward.{u+1} φ).obj (SheafOfModules.unit S)) f X
      have h2 : ((SheafOfModules.pushforward.{u+1} φ).obj
          (SheafOfModules.unit S)).unitHomEquiv f = s := Equiv.apply_symm_apply _ _
      rw [h2] at h1
      exact h1.symm.trans rfl
    let g : SheafOfModules.unit S ⟶ SheafOfModules.unit S := μ.inv ≫ (adj.homEquiv _ _).symm f
    have hg : ψ ≫ (SheafOfModules.pushforward.{u+1} φ).map g = f := by
      show adj.homEquiv _ _ μ.hom ≫ (SheafOfModules.pushforward.{u+1} φ).map g = f
      rw [← Adjunction.homEquiv_naturality_right]
      simp only [g, Iso.hom_inv_id_assoc, Equiv.apply_symm_apply]
    let gW : ∀ W : Dᵒᵖ, S.obj.obj W → S.obj.obj W := fun W m => (g.val.app W).hom m
    have hev : ∀ X : Cᵒᵖ, gW (Opposite.op (F.obj X.unop)) (ψX X 1) = 1 := by
      intro X
      have h : ((f.val.app X).hom (1 : R.obj.obj X) : S.obj.obj (Opposite.op (F.obj X.unop))) =
          gW (Opposite.op (F.obj X.unop)) (ψX X 1) := by
        rw [← hg]; rfl
      exact h.symm.trans (hf1 X)
    have hglin : ∀ (W : Dᵒᵖ) (m : S.obj.obj W), gW W m = m * gW W 1 := by
      intro W m
      calc gW W m = gW W (m * 1) := by rw [mul_one]
        _ = m * gW W 1 := (g.val.app W).hom.map_smul m (1 : S.obj.obj W)
    have hψbij : ∀ X : Cᵒᵖ, Function.Bijective (ψ.val.app X).hom := by
      intro X
      let sX : S.obj.obj (Opposite.op (F.obj X.unop)) := ψX X 1
      let cX : S.obj.obj (Opposite.op (F.obj X.unop)) := gW (Opposite.op (F.obj X.unop)) 1
      have hsc : sX * cX = 1 := (hglin _ sX).symm.trans (hev X)
      have hcs : cX * sX = 1 := (hcomm _ cX sX).trans hsc
      have hb : Function.Bijective (ψX X) := by
        constructor
        · intro a b hab
          apply (hbij X).1
          have h : φX X a * sX = φX X b * sX := by
            rw [← hlin, ← hlin]; exact hab
          have h2 := congrArg (· * cX) h
          simp only [mul_assoc, hsc, mul_one] at h2
          exact h2
        · intro y
          obtain ⟨r, hr⟩ := (hbij X).2 (y * cX)
          refine ⟨r, ?_⟩
          have e := hlin X r
          have hr' : φX X r = y * cX := hr
          rw [hr', mul_assoc, hcs, mul_one] at e
          exact e
      exact hb
    have hiso : IsIso ψ := by
      have h1 : ∀ X, IsIso (((PresheafOfModules.toPresheaf R.obj).map ψ.val).app X) := by
        intro X
        exact (ConcreteCategory.isIso_iff_bijective _).mpr (hψbij X)
      have : IsIso ((PresheafOfModules.toPresheaf R.obj).map ψ.val) :=
        NatIso.isIso_of_isIso_app _
      have : IsIso ψ.val := isIso_of_reflects_iso ψ.val (PresheafOfModules.toPresheaf R.obj)
      have : IsIso ((SheafOfModules.forget R).map ψ) := (inferInstance : IsIso ψ.val)
      exact isIso_of_reflects_iso ψ (SheafOfModules.forget R)
    have h2 : IsIso (adj.unit.app (SheafOfModules.unit R) ≫
        (SheafOfModules.pushforward.{u+1} φ).map μ.hom) := hψ ▸ hiso
    exact IsIso.of_isIso_comp_right _ ((SheafOfModules.pushforward.{u+1} φ).map μ.hom)

  have hglue : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), S ∈ Scheme.smallEtaleTopology Y V → ∀ (m : ℕ) (x : ∀ (V' : Y.Etale) (g : V' ⟶ V), S.arrows g → LocallyConstant V'.left (ZMod m)), (∀ (V' V'' : Y.Etale) (g : V' ⟶ V) (hg : S.arrows g) (h : V'' ⟶ V') (w : V''.left), x V'' (h ≫ g) (S.downward_closed hg h) w = x V' g hg (h.left w)) → ∃! f : LocallyConstant V.left (ZMod m), ∀ (V' : Y.Etale) (g : V' ⟶ V) (hg : S.arrows g) (v : V'.left), f (g.left v) = x V' g hg v := by
    intro Y V S hS m x hx
    have hEt : ∀ (A B : Y.Etale) (g : A ⟶ B), Etale g.left := by
      intro A B g
      haveI : Etale B.hom := B.prop
      have hw : g.left ≫ B.hom = A.hom := MorphismProperty.Over.w g
      haveI : Etale (g.left ≫ B.hom) := by
        rw [hw]
        exact A.prop
      exact Etale.of_comp g.left B.hom
    have hOpen : ∀ (A B : Y.Etale) (g : A ⟶ B), IsOpenMap g.left := by
      intro A B g
      haveI := hEt A B g
      exact g.left.isOpenMap
    have hsurj : ∀ v : V.left, ∃ (V' : Y.Etale) (g : V' ⟶ V) (v' : V'.left),
        S.arrows g ∧ g.left v' = v := by
      change S ∈ Scheme.smallGrothendieckTopology @Etale Y V at hS
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
      intro v
      obtain ⟨V', g, v', hg, -, hv⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V S).mp hS v
      exact ⟨V', g, v', hg, hv⟩
    have hcongr : ∀ (Q : Y.Etale) (k k' : Q ⟶ V) (_ : k = k') (hk : S.arrows k)
        (hk' : S.arrows k') (w : Q.left), x Q k hk w = x Q k' hk' w := by
      intro Q k k' e hk hk' w
      subst e
      rfl
    have hagree : ∀ (V₁ V₂ : Y.Etale) (g₁ : V₁ ⟶ V) (g₂ : V₂ ⟶ V) (hg₁ : S.arrows g₁)
        (hg₂ : S.arrows g₂) (v₁ : V₁.left) (v₂ : V₂.left), g₁.left v₁ = g₂.left v₂ →
        x V₁ g₁ hg₁ v₁ = x V₂ g₂ hg₂ v₂ := by
      intro V₁ V₂ g₁ g₂ hg₁ hg₂ v₁ v₂ hv
      haveI : Etale g₂.left := hEt V₂ V g₂
      haveI : Etale V₁.hom := V₁.prop
      let Q : Y.Etale := MorphismProperty.Over.mk ⊤
        (Limits.pullback.fst g₁.left g₂.left ≫ V₁.hom)
        (inferInstance : Etale (Limits.pullback.fst g₁.left g₂.left ≫ V₁.hom))
      let h₁ : Q ⟶ V₁ := MorphismProperty.Over.homMk (Limits.pullback.fst g₁.left g₂.left) rfl trivial
      have hc : Limits.pullback.snd g₁.left g₂.left ≫ V₂.hom = Q.hom := by
        change Limits.pullback.snd g₁.left g₂.left ≫ V₂.hom =
          Limits.pullback.fst g₁.left g₂.left ≫ V₁.hom
        rw [← MorphismProperty.Over.w g₂, ← MorphismProperty.Over.w g₁, ← Category.assoc,
          ← Category.assoc, Limits.pullback.condition]
      let h₂ : Q ⟶ V₂ := MorphismProperty.Over.homMk (Limits.pullback.snd g₁.left g₂.left) hc trivial
      obtain ⟨c₁, hc₁⟩ : ∃ c : Q ⟶ V, c = h₁ ≫ g₁ := ⟨_, rfl⟩
      obtain ⟨c₂, hc₂⟩ : ∃ c : Q ⟶ V, c = h₂ ≫ g₂ := ⟨_, rfl⟩
      have hc12 : c₁ = c₂ := by
        apply MorphismProperty.Over.Hom.ext
