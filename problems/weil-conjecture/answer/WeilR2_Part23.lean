theorem wc_et_dnb_bwk_branch_open {T Ul Wsch : Scheme.{u}} (Q B Kb : Type u) [CommRing Q]
    [CommRing B] [Field Kb] (eT : T ⟶ Spec (.of Q)) (β : Spec (.of B) ⟶ T) (βQ : Q →+* B)
    (hβQ : Spec.map (CommRingCat.ofHom βQ) = β ≫ eT) (fW : Wsch ⟶ Spec (.of B))
    (gU : Ul ⟶ Wsch) (eU : Ul ≅ Spec (.of Kb)) (lam : B →+* Kb)
    (hgU : eU.inv ≫ gU ≫ fW = Spec.map (CommRingCat.ofHom lam)) (s : Q) (hs : lam (βQ s) ≠ 0) :
    ∃ (uD : Ul ⟶ (T.basicOpen (eT.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Q)).inv.hom s))).toScheme)
      (hunit : IsUnit ((T.basicOpen (eT.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Q)).inv.hom s))).ι.appTop.hom
        (eT.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Q)).inv.hom s)))),
      uD ≫ (T.basicOpen (eT.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Q)).inv.hom s))).ι = gU ≫ fW ≫ β ∧
      (∀ z : T, z ∈ T.basicOpen (eT.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Q)).inv.hom s)) ↔
        s ∉ (eT z).asIdeal) ∧
      ∀ (M j : ℕ), (∃ τ : (Γ(Ul, ⊤))ˣ, τ ^ M = (Units.map uD.appTop.hom.toMonoidHom hunit.unit) ^ j) →
        ∃ τ' : Kb, τ' ^ M = (lam (βQ s)) ^ j :=
