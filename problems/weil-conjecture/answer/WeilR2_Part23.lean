        (IsLocalRing.closedPoint (AlgebraicClosure L)).asIdeal) =
        (IsLocalRing.closedPoint (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C π))).asIdeal :=
      (congrArg (Ideal.comap φ') e2.symm).trans (e1.symm.trans (congrArg PrimeSpectrum.asIdeal h'))
    change Ideal.comap φ' (Ideal.comap (algebraMap L (AlgebraicClosure L))
      (IsLocalRing.maximalIdeal (AlgebraicClosure L))) =
      IsLocalRing.maximalIdeal (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C π)) at h2
    rw [IsLocalRing.maximalIdeal_eq_bot,
      Ideal.comap_bot_of_injective _ (algebraMap L (AlgebraicClosure L)).injective,
      Ideal.comap_bot_of_injective _ hφ'inj] at h2
    exact IsDiscreteValuationRing.not_a_field _ h2.symm

  have hS0 := hv_gen (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C π))
    ℓ hℓ' (AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) - Polynomial.C π)) hmax' r hA'
    _ _ hWE' (hmemC _ (Set.mem_insert _ _)) (hmemC _ (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
    (AlgebraicClosure L) _ hξ q hq

  have hS1 := descent _ _ _ L _ φ' ℓ q hS0

  obtain ⟨E⟩ := wc_et_coh_iso_invariance (Spec.map e.toCommRingCatIso.hom) ℓ q
  exact @Equiv.subsingleton _ _ E hS1

theorem wc_etqmt_level_h1_kill : ∀ (A : Type u) [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)], IsUnit ((ℓ : ℕ) : A) →
    ∀ (π : A), IsLocalRing.maximalIdeal A = Ideal.span {π} →
    ∀ (r : ℕ) (R : Type u) [CommRing R] [HenselianLocalRing R]
      [IsSepClosed (IsLocalRing.ResidueField R)]
      (ρ : wcQuadModelRing A (r + 2) π (wcQmtmC A r) →+* R),
    WeaklyEtale (Spec.map (CommRingCat.ofHom ρ)) →
    ρ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
      (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) ∈ IsLocalRing.maximalIdeal R →
    ρ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
      (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)))) ∈ IsLocalRing.maximalIdeal R →
    ∀ (L : Type u) [Field L] [IsSepClosed L] (φA : A →+* L), Function.Injective φA →
    ∀ (k : ℕ),
      letI : Algebra A R := (ρ.comp (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).toAlgebra
      letI : Algebra A L := φA.toAlgebra
      ∀ (β : AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C ((1 : L) ⊗ₜ[A] ρ
            (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
              (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) : TensorProduct A L R)) →+*
          AdjoinRoot (Polynomial.X ^ (ℓ ^ (k + 1)) - Polynomial.C ((1 : L) ⊗ₜ[A] ρ
