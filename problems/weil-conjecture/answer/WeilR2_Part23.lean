    obtain ⟨-, hcardC, -⟩ := wc_et_const_zmod_stalk_cyclic (Limits.pullback f' (wcQmSp A)) (ℓ ^ k) hm (iY w)
    have hRHS : Function.Injective
        (θ.hom.app (SheafOfModules.unit (wcEtZModRing X' (ℓ ^ k))) ≫
          (wcEtStalk X' (Limits.pullback.fst f' (wcQmSp A) (iY w))).map
            ((SheafOfModules.toSheaf (wcEtZModRing X' (ℓ ^ k))).map ψ)).hom := by
      rw [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp]
      exact hinj.comp (isoinj (θ.app _))
    have hA : Function.Injective ((wcEtStalk (Limits.pullback f' (wcQmSp A)) (iY w)).map
        ((SheafOfModules.toSheaf (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k))).map
          (Dg'.Φ.map ψ))).hom := by
      have hc : Function.Injective
          ((Dg'.Φ ⋙ SheafOfModules.toSheaf (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k)) ⋙
            wcEtStalk (Limits.pullback f' (wcQmSp A)) (iY w)).map ψ ≫
            θ.hom.app (((P'.mapHomologicalComplex (ComplexShape.up ℕ)).obj I'.cocomplex).homology 1)).hom := by
        rw [θ.hom.naturality]; exact hRHS
      rw [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp] at hc
      exact hc.of_comp
    have hinjψ : Function.Injective
        ((wcEtStalk (Limits.pullback f' (wcQmSp A)) (iY w)).map ψab).hom := by
      have e1 : (wcEtStalk (Limits.pullback f' (wcQmSp A)) (iY w)).map ψab =
          (wcEtStalk (Limits.pullback f' (wcQmSp A)) (iY w)).map eS.inv ≫
          (wcEtStalk (Limits.pullback f' (wcQmSp A)) (iY w)).map
            ((SheafOfModules.toSheaf (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k))).map
              Dg'.μ.inv) ≫
          (wcEtStalk (Limits.pullback f' (wcQmSp A)) (iY w)).map
            ((SheafOfModules.toSheaf (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k))).map
              (Dg'.Φ.map ψ)) := by
        simp only [ψab, Functor.map_comp]
      rw [e1, AddCommGrpCat.hom_comp, AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp,
        AddMonoidHom.coe_comp]
      exact (hA.comp (isoinj ((wcEtStalk (Limits.pullback f' (wcQmSp A)) (iY w)).mapIso
        ((SheafOfModules.toSheaf (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k))).mapIso
          Dg'.μ.symm)))).comp (isoinj ((wcEtStalk (Limits.pullback f' (wcQmSp A)) (iY w)).mapIso eS.symm))
    let eT := (θ.app (((P'.mapHomologicalComplex (ComplexShape.up ℕ)).obj I'.cocomplex).homology 1)).addCommGroupIsoToAddEquiv
    haveI hfinT : Finite ((wcEtStalk (Limits.pullback f' (wcQmSp A)) (iY w)).obj
        ((SheafOfModules.toSheaf (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k))).obj
          (Dg'.Φ.obj (((P'.mapHomologicalComplex (ComplexShape.up ℕ)).obj I'.cocomplex).homology 1)))) :=
      @Finite.of_equiv _ _ hfin eT.toEquiv.symm
    have hcT : Nat.card ((wcEtStalk (Limits.pullback f' (wcQmSp A)) (iY w)).obj
        ((SheafOfModules.toSheaf (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k))).obj
          (Dg'.Φ.obj (((P'.mapHomologicalComplex (ComplexShape.up ℕ)).obj I'.cocomplex).homology 1)))) =
        ℓ ^ k := (Nat.card_congr eT.toEquiv).trans hcard
    refine hinjψ.bijective_of_nat_card_le ?_
    rw [hcT, hcardC]

  obtain ⟨Fiso⟩ := wc_cgth_closed_support_const_iso iY (ℓ ^ k) _ hoff ψab hbij

  obtain ⟨ePush⟩ := wc_et_toSheaf_pushforward_iso iY (ℓ ^ k) DY
  obtain ⟨eY⟩ := wc_et_zmod_unit_toSheaf_iso Y (ℓ ^ k)
  have eTgt : (SheafOfModules.toSheaf (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k))).obj
      (wcEtSuppObj DY) ≅ (wcEtPush iY).obj ((constantSheaf (Scheme.smallEtaleTopology Y)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ k))))) :=
    ePush.app (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ k))) ≪≫ (wcEtPush iY).mapIso eY

  obtain ⟨α, hinjα, hsurjα, -⟩ := wc_et_zmod_ring_locbij (Limits.pullback f' (wcQmSp A)) (ℓ ^ k)
  haveI : (SheafOfModules.toSheaf (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k))).Full :=
    (sheafOfModules_toSheaf_torsion_equiv (Scheme.smallEtaleTopology (Limits.pullback f' (wcQmSp A)))
      (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k)) (ℓ ^ k) α hinjα hsurjα).1
  exact ⟨(SheafOfModules.toSheaf (wcEtZModRing (Limits.pullback f' (wcQmSp A)) (ℓ ^ k))).preimageIso
    (Fiso ≪≫ eTgt.symm)⟩

theorem wc_etqm_srhl_mv {S Z₁ Z₂ ZY : Scheme.{u}} (i₁ : Z₁ ⟶ S) (i₂ : Z₂ ⟶ S) (iY : ZY ⟶ S)
    [IsClosedImmersion i₁] [IsClosedImmersion i₂] [IsClosedImmersion iY] (m : ℕ)
    (hcover : Set.range i₁ ∪ Set.range i₂ = Set.univ)
    (hinter : Set.range iY = Set.range i₁ ∩ Set.range i₂)
    (E₁ : wcEtPullData i₁ m) (E₂ : wcEtPullData i₂ m) (EY : wcEtPullData iY m) :
    ∃ (ρ₁ : wcEtSuppObj E₁ ⟶ wcEtSuppObj EY) (ρ₂ : wcEtSuppObj E₂ ⟶ wcEtSuppObj EY)
      (hz : Limits.biprod.lift (wcEtSuppUnitMap E₁) (wcEtSuppUnitMap E₂) ≫
        Limits.biprod.desc ρ₁ (-ρ₂) = 0),
      (ShortComplex.mk _ _ hz).ShortExact :=
by
  classical

  have G1 : ∀ x : S, x ∈ Set.range i₁ ∨ x ∈ Set.range i₂ := fun x => by
    have h : x ∈ Set.range i₁ ∪ Set.range i₂ := by rw [hcover]; exact Set.mem_univ x
    exact h
  have G2 : ∀ x : S, x ∈ Set.range i₁ → x ∈ Set.range i₂ → x ∈ Set.range iY := fun x h1 h2 => by
    rw [hinter]; exact ⟨h1, h2⟩
  have G31 : ∀ x : S, x ∈ Set.range iY → x ∈ Set.range i₁ := fun x h => by
    rw [hinter] at h; exact h.1
  have G32 : ∀ x : S, x ∈ Set.range iY → x ∈ Set.range i₂ := fun x h => by
    rw [hinter] at h; exact h.2
  obtain ⟨e, he⟩ := wc_et_zmod_ring_sections_lc_equiv S m

  have hcovS : ∀ (X : Scheme.{u}) (V : X.Etale) (T : Sieve V), (∀ v : V.left, ∃ (W : X.Etale)
      (f : W ⟶ V) (w : W.left), T.arrows f ∧ Etale f.left ∧ f.left w = v) →
      T ∈ Scheme.smallEtaleTopology X V := by
    intro X V T h
    change T ∈ Scheme.smallGrothendieckTopology @Etale X V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    exact (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V T).mpr h
  have sep : ∀ (M : SheafOfModules.{u+1} (wcEtZModRing S m))
      (W : S.Etale) (R : Sieve W), R ∈ Scheme.smallEtaleTopology S W →
      ∀ x : ↑(M.val.obj (Opposite.op W)),
      (∀ (Q : S.Etale) (g : Q ⟶ W), R.arrows g → (M.val.map g.op).hom x = 0) → x = 0 := by
    intro M W R hR x h
    have hs := ((SheafOfModules.toSheaf _).obj M).cond
    have h2 := (Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology S) _
      (forget AddCommGrpCat.{u+1})).1 hs
    exact (h2.isSeparated W R hR) x 0
      (fun Q g hg => (h Q g hg).trans (map_zero ((M.val.map g.op).hom)).symm)
  have hempty : ∀ (X : Scheme.{u}) (Q : X.Etale), IsEmpty Q.left →
      ∀ a b : ↑((wcEtZModRing X m).obj.obj (Opposite.op Q)), a = b := by
    intro X Q hQ a b
    exact (Sheaf.isSeparated (wcEtZModRing X m)) Q ⊥ (hcovS X Q ⊥ (fun v => isEmptyElim v)) a b
      (fun _ _ h => False.elim h)

  have s1 : ∀ {𝒞 : Type (u+2)} [Category.{u+1} 𝒞] [Abelian 𝒞]
      {L E₁ E₂ EY : 𝒞} (u₁ : L ⟶ E₁) (u₂ : L ⟶ E₂) (uY : L ⟶ EY)
      (hu₁ : Epi u₁) (hu₂ : Epi u₂) (huY : Epi uY)
      (ρ₁ : E₁ ⟶ EY) (ρ₂ : E₂ ⟶ EY) (h₁ : u₁ ≫ ρ₁ = uY) (h₂ : u₂ ≫ ρ₂ = uY)
      (hmono : ∀ {P : 𝒞} (g : P ⟶ L), g ≫ u₁ = 0 → g ≫ u₂ = 0 → g = 0)
      (hsplit : ∀ {P : 𝒞} (d : P ⟶ L), d ≫ uY = 0 →
        ∃ k₁ k₂ : P ⟶ L, k₁ ≫ u₁ = 0 ∧ k₂ ≫ u₂ = 0 ∧ d = k₁ + k₂)
      (hz : Limits.biprod.lift u₁ u₂ ≫ Limits.biprod.desc ρ₁ (-ρ₂) = 0),
      (ShortComplex.mk _ _ hz).ShortExact := by
    intro 𝒞 _ _ L E₁ E₂ EY u₁ u₂ uY hu₁ hu₂ huY ρ₁ ρ₂ h₁ h₂ hmono hsplit hz
    have hmf : Mono (Limits.biprod.lift u₁ u₂) := by
      apply Preadditive.mono_of_cancel_zero
      intro P q hq
      apply hmono q
      · have := congrArg (· ≫ Limits.biprod.fst) hq
        simpa using this
      · have := congrArg (· ≫ Limits.biprod.snd) hq
        simpa using this
    have hρ₁ : Epi ρ₁ := epi_of_epi_fac h₁
    have heg : Epi (Limits.biprod.desc ρ₁ (-ρ₂)) := epi_of_epi_fac (Limits.biprod.inl_desc ρ₁ (-ρ₂))
    refine @ShortComplex.ShortExact.mk _ _ _ _ ?_ hmf heg
    rw [ShortComplex.exact_iff_exact_up_to_refinements]
    intro P (x₂ : P ⟶ E₁ ⊞ E₂) hx₂
    have hx₂' : x₂ ≫ Limits.biprod.desc ρ₁ (-ρ₂) = 0 := hx₂
    set y₁ := x₂ ≫ Limits.biprod.fst
    set y₂ := x₂ ≫ Limits.biprod.snd
    have hstar : y₁ ≫ ρ₁ = y₂ ≫ ρ₂ := by
      have e : x₂ ≫ Limits.biprod.desc ρ₁ (-ρ₂) = y₁ ≫ ρ₁ - y₂ ≫ ρ₂ := by
        rw [Limits.biprod.desc_eq]
        simp [y₁, y₂, Preadditive.comp_add, Preadditive.comp_neg, sub_eq_add_neg]
      rw [hx₂'] at e
      exact (sub_eq_zero.mp e.symm)
    obtain ⟨P₁, π₁, hπ₁, a₁, ha₁⟩ := surjective_up_to_refinements_of_epi u₁ y₁
    obtain ⟨P₂, π₂, hπ₂, a₂, ha₂⟩ := surjective_up_to_refinements_of_epi u₂ (π₁ ≫ y₂)
    have e1 : a₁ ≫ uY = π₁ ≫ y₁ ≫ ρ₁ := by
      rw [← h₁, ← Category.assoc, ← ha₁, Category.assoc]
    have e2 : a₂ ≫ uY = π₂ ≫ π₁ ≫ y₂ ≫ ρ₂ := by
      rw [← h₂, ← Category.assoc, ← ha₂]
      simp only [Category.assoc]
    obtain ⟨k₁, k₂, hk₁, hk₂, hd⟩ := hsplit (π₂ ≫ a₁ - a₂) (by
      rw [Preadditive.sub_comp, Category.assoc, e1, e2, hstar, sub_self])
    refine ⟨P₂, π₂ ≫ π₁, epi_comp _ _, π₂ ≫ a₁ - k₁, ?_⟩
    apply Limits.biprod.hom_ext
    · show ((π₂ ≫ π₁) ≫ x₂) ≫ Limits.biprod.fst =
        ((π₂ ≫ a₁ - k₁) ≫ Limits.biprod.lift u₁ u₂) ≫ Limits.biprod.fst
      simp only [Category.assoc, Limits.biprod.lift_fst, Preadditive.sub_comp, hk₁, sub_zero]
      change π₂ ≫ π₁ ≫ y₁ = _
      rw [ha₁]
    · show ((π₂ ≫ π₁) ≫ x₂) ≫ Limits.biprod.snd =
        ((π₂ ≫ a₁ - k₁) ≫ Limits.biprod.lift u₁ u₂) ≫ Limits.biprod.snd
      simp only [Category.assoc, Limits.biprod.lift_snd]
      have e : π₂ ≫ a₁ - k₁ = a₂ + k₂ := by
        have h' := hd
        rw [sub_eq_iff_eq_add] at h'
        rw [h']
        abel
      rw [e, Preadditive.add_comp, hk₂, add_zero, ← ha₂]

  have s2 : ∀ {Z : Scheme.{u}} (i : Z ⟶ S) [IsClosedImmersion i] (E : wcEtPullData i m)
      {P : SheafOfModules.{u+1} (wcEtZModRing S m)}
      (g : P ⟶ SheafOfModules.unit (wcEtZModRing S m)), g ≫ wcEtSuppUnitMap E = 0 →
      ∀ (V : S.Etale) (p : P.val.obj (Opposite.op V)) (x : V.left), V.hom x ∈ Set.range i →
        e V ((g.val.app (Opposite.op V)).hom p) x = 0 := by
    intro Z i _ E P g hg V p x hx
    obtain ⟨z, hz⟩ := hx
    obtain ⟨eZ, -⟩ := wc_et_zmod_ring_sections_lc_equiv Z m
    let a : (wcEtZModRing S m).obj.obj (Opposite.op V) := (g.val.app (Opposite.op V)).hom p
    change e V a x = 0
    let F : LocallyConstant V.left (ZMod m) := e V a
    let O : V.left.Opens := ⟨{y | F y = F x}, F.isLocallyConstant.isOpen_fiber (F x)⟩
    have hmemO : ∀ y : O.toScheme, F (O.ι y) = F x := by
      intro y
      have hm := Set.mem_range_self (f := ⇑O.ι) y
      rw [Scheme.Opens.range_ι] at hm
      exact hm
    have hxO : x ∈ O := by
      show F x = F x
      rfl
    let U : S.Etale := wcEtOpen S V O
    let ι : U ⟶ V := wcEtOpenι S V O
    let a' : (wcEtZModRing S m).obj.obj (Opposite.op U) := ((wcEtZModRing S m).obj.map ι.op).hom a
    let k : ℤ := ((F x).cast : ℤ)
    have hkc : ((k : ℤ) : ZMod m) = F x := ZMod.intCast_zmod_cast (F x)
    have ha'k : a' = (k : (wcEtZModRing S m).obj.obj (Opposite.op U)) := by
      apply (e U).injective
      rw [map_intCast]
      ext y
      have h1 : e U a' y = F (O.ι y) := he V U ι a y
      rw [h1, hmemO y]
      have h2 : (k : LocallyConstant U.left (ZMod m)) y = (k : ZMod m) :=
        map_intCast (LocallyConstant.evalRingHom y) k
      rw [h2, hkc]
    let ρU : (wcEtZModRing S m).obj.obj (Opposite.op U) →+
        (wcEtZModRing Z m).obj.obj (Opposite.op ((wcEtBaseChange i).obj U)) :=
      ((wcEtSuppUnitMap E).val.app (Opposite.op U)).hom.toAddMonoidHom
    have h0 : ρU a' = 0 := by
      have hgU := congrArg (fun φ => (φ.val.app (Opposite.op U)).hom ((P.val.map ι.op).hom p)) hg
      change ((wcEtSuppUnitMap E).val.app (Opposite.op U)).hom
        ((g.val.app (Opposite.op U)).hom ((P.val.map ι.op).hom p)) = 0 at hgU
      rw [PresheafOfModules.naturality_apply g.val ι.op p] at hgU
      exact hgU
    rw [ha'k] at h0
    have e1 : ρU (k : (wcEtZModRing S m).obj.obj (Opposite.op U)) =
        (k : (wcEtZModRing Z m).obj.obj (Opposite.op ((wcEtBaseChange i).obj U))) * ρU 1 := by
      have hk1 : (k : (wcEtZModRing S m).obj.obj (Opposite.op U)) =
          k • (1 : (wcEtZModRing S m).obj.obj (Opposite.op U)) := (Int.smul_one_eq_cast k).symm
      rw [hk1, map_zsmul, zsmul_eq_mul]
    rw [e1] at h0
    have hu := wc_et_supp_unit_map_one_isUnit i m E U
    have hk0 : (k : (wcEtZModRing Z m).obj.obj (Opposite.op ((wcEtBaseChange i).obj U))) = 0 :=
      (IsUnit.mul_left_eq_zero hu).mp h0
    let x₀ : U.left := ⟨x, hxO⟩
    have hx₀ : U.hom x₀ = i z := by
      rw [hz]
      rfl
    obtain ⟨w, -, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := U.hom) (g := i) x₀ z hx₀
    have h3 : (k : LocallyConstant ((wcEtBaseChange i).obj U).left (ZMod m)) = 0 := by
      rw [← map_intCast (eZ ((wcEtBaseChange i).obj U)) k, hk0, map_zero]
    have h4 : (k : ZMod m) = 0 := by
      have h5 := congrArg (fun f : LocallyConstant ((wcEtBaseChange i).obj U).left (ZMod m) =>
        f w) h3
      have h6 : (k : LocallyConstant ((wcEtBaseChange i).obj U).left (ZMod m)) w = (k : ZMod m) :=
        map_intCast (LocallyConstant.evalRingHom (Y := ZMod m)
          (show ((wcEtBaseChange i).obj U).left from w)) k
      exact h6.symm.trans h5
    exact hkc.symm.trans h4

  have s3 : ∀ {Z : Scheme.{u}} (i : Z ⟶ S) [IsClosedImmersion i] (E : wcEtPullData i m)
      {P : SheafOfModules.{u+1} (wcEtZModRing S m)}
      (g : P ⟶ SheafOfModules.unit (wcEtZModRing S m)),
      (∀ (V : S.Etale) (p : P.val.obj (Opposite.op V)) (x : V.left), V.hom x ∈ Set.range i →
        e V ((g.val.app (Opposite.op V)).hom p) x = 0) → g ≫ wcEtSuppUnitMap E = 0 := by
    intro Z i _ E P g hv
    have hcompM : ∀ {A B C : S.Etale} (f : A ⟶ B) (h : B ⟶ C)
        (z : (wcEtSuppObj E).val.obj (Opposite.op C)),
        ((wcEtSuppObj E).val.map (f ≫ h).op).hom z =
          ((wcEtSuppObj E).val.map f.op).hom (((wcEtSuppObj E).val.map h.op).hom z) := by
      intro A B C f h z
      rw [op_comp, PresheafOfModules.map_comp]
      rfl
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro W
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro p
    induction W using Opposite.rec with
    | op W =>
    change ((wcEtSuppUnitMap E).val.app (Opposite.op W)).hom ((g.val.app (Opposite.op W)).hom p) = 0
    let a : (wcEtZModRing S m).obj.obj (Opposite.op W) := (g.val.app (Opposite.op W)).hom p
    let F : LocallyConstant W.left (ZMod m) := e W a
    have hvF : ∀ y : W.left, W.hom y ∈ Set.range i → F y = 0 := fun y hy => hv W p y hy
    let s := ((wcEtSuppUnitMap E).val.app (Opposite.op W)).hom a
    change s = 0
    let T : Sieve W :=
      { arrows := fun Q q => ((wcEtSuppObj E).val.map q.op).hom s = 0
        downward_closed := fun {Q Q'} {q} hq h' => by
          show ((wcEtSuppObj E).val.map (h' ≫ q).op).hom s = 0
          rw [hcompM, hq]
          exact map_zero _ }
    refine sep (wcEtSuppObj E) W T ?_ s (fun Q q hq => hq)
    apply hcovS
    intro v
    let O : W.left.Opens := ⟨{y | F y = F v}, F.isLocallyConstant.isOpen_fiber (F v)⟩
    have hvO : v ∈ O := by
      show F v = F v
      rfl
    have hmemO : ∀ y : O.toScheme, F (O.ι y) = F v := by
      intro y
      have hm := Set.mem_range_self (f := ⇑O.ι) y
      rw [Scheme.Opens.range_ι] at hm
      exact hm
    refine ⟨wcEtOpen S W O, wcEtOpenι S W O, ⟨v, hvO⟩, ?_, ?_, rfl⟩
    · show ((wcEtSuppObj E).val.map (wcEtOpenι S W O).op).hom s = 0
      rw [← PresheafOfModules.naturality_apply (wcEtSuppUnitMap E).val (wcEtOpenι S W O).op a]
      by_cases hF0 : F v = 0
      · have hres : ((wcEtZModRing S m).obj.map (wcEtOpenι S W O).op).hom a = 0 := by
          apply (e (wcEtOpen S W O)).injective
          refine Eq.trans ?_ (map_zero (e (wcEtOpen S W O))).symm
          ext y
          have h1 : e (wcEtOpen S W O)
              (((wcEtZModRing S m).obj.map (wcEtOpenι S W O).op).hom a) y = F (O.ι y) :=
            he W _ _ a y
          exact h1.trans ((hmemO y).trans hF0)
        have hres' : ((SheafOfModules.unit (wcEtZModRing S m)).val.map
            (wcEtOpenι S W O).op).hom a = 0 := hres
        rw [hres']
        exact map_zero _
      · have hE : IsEmpty ((wcEtBaseChange i).obj (wcEtOpen S W O)).left := by
          refine ⟨fun w' => ?_⟩
          have hc := congrArg (fun φ => φ.base w')
            (Limits.pullback.condition (f := (wcEtOpen S W O).hom) (g := i))
          have hmem : W.hom (O.ι (Limits.pullback.fst (wcEtOpen S W O).hom i w')) ∈ Set.range i :=
            ⟨Limits.pullback.snd (wcEtOpen S W O).hom i w', hc.symm⟩
          exact hF0 ((hmemO _).symm.trans (hvF _ hmem))
        exact hempty Z _ hE _ _
    · show Etale O.ι
      infer_instance

  have s4 : ∀ (Z₁ Z₂ : Set S) (hZ₁ : IsClosed Z₁) (hZ₂ : IsClosed Z₂)
      (hZcov : ∀ y : S, y ∈ Z₁ ∨ y ∈ Z₂)
      {P : SheafOfModules.{u+1} (wcEtZModRing S m)}
      (d : P ⟶ SheafOfModules.unit (wcEtZModRing S m))
      (hd : ∀ (V : S.Etale) (p : P.val.obj (Opposite.op V)) (x : V.left),
        V.hom x ∈ Z₁ → V.hom x ∈ Z₂ → e V ((d.val.app (Opposite.op V)).hom p) x = 0),
      ∃ k₁ k₂ : P ⟶ SheafOfModules.unit (wcEtZModRing S m), d = k₁ + k₂ ∧
        (∀ (V : S.Etale) (p : P.val.obj (Opposite.op V)) (x : V.left), V.hom x ∈ Z₁ →
          e V ((k₁.val.app (Opposite.op V)).hom p) x = 0) ∧
        (∀ (V : S.Etale) (p : P.val.obj (Opposite.op V)) (x : V.left), V.hom x ∈ Z₂ →
          e V ((k₂.val.app (Opposite.op V)).hom p) x = 0) := by
    intro Z₁ Z₂ hZ₁ hZ₂ hZcov P d hd
    let dR : ∀ V : S.Etale, P.val.obj (Opposite.op V) →+ (wcEtZModRing S m).obj.obj (Opposite.op V) :=
      fun V => (d.val.app (Opposite.op V)).hom.toAddMonoidHom
    let ds : ∀ (V : S.Etale), P.val.obj (Opposite.op V) → LocallyConstant V.left (ZMod m) :=
      fun V p => e V (dR V p)
    have hlc : ∀ (V : S.Etale) (p : P.val.obj (Opposite.op V)),
        IsLocallyConstant (fun x => if V.hom x ∈ Z₁ then ds V p x else 0) := by
      intro V p
      rw [IsLocallyConstant.iff_exists_open]
      intro x
      by_cases h1 : V.hom x ∈ Z₁
      · by_cases h2 : V.hom x ∈ Z₂
        · have h0 : ds V p x = 0 := hd V p x h1 h2
          refine ⟨{y | ds V p y = 0}, (ds V p).isLocallyConstant.isOpen_fiber 0, h0, ?_⟩
          intro y hy
          have hy' : ds V p y = 0 := hy
          dsimp only
          rw [if_pos h1, h0]
          split_ifs
          · exact hy'
          · rfl
        · refine ⟨(V.hom ⁻¹' Z₂)ᶜ ∩ {y | ds V p y = ds V p x},
            ((hZ₂.preimage V.hom.continuous).isOpen_compl).inter
              ((ds V p).isLocallyConstant.isOpen_fiber _), ⟨h2, rfl⟩, ?_⟩
          intro y hy
          have hy1 : V.hom y ∈ Z₁ := (hZcov (V.hom y)).resolve_right hy.1
          dsimp only
          rw [if_pos hy1, if_pos h1]
          exact hy.2
      · refine ⟨(V.hom ⁻¹' Z₁)ᶜ, (hZ₁.preimage V.hom.continuous).isOpen_compl, h1, ?_⟩
        intro y hy
        dsimp only
        rw [if_neg (show V.hom y ∉ Z₁ from hy), if_neg h1]
    let pst : ∀ (V : S.Etale), P.val.obj (Opposite.op V) → LocallyConstant V.left (ZMod m) :=
      fun V p => ⟨fun x => if V.hom x ∈ Z₁ then ds V p x else 0, hlc V p⟩
    have hpst : ∀ V p x, pst V p x = if V.hom x ∈ Z₁ then ds V p x else 0 := fun _ _ _ => rfl
    have hds_zero : ∀ V, ds V 0 = 0 := by
      intro V
      show e V (dR V 0) = 0
      rw [map_zero, map_zero]
    have hds_add : ∀ V (p q : P.val.obj (Opposite.op V)), ds V (p + q) = ds V p + ds V q := by
      intro V p q
      show e V (dR V (p + q)) = e V (dR V p) + e V (dR V q)
      rw [map_add, map_add]
    have hdR_smul : ∀ (V : S.Etale) (r : (wcEtZModRing S m).obj.obj (Opposite.op V))
        (p : P.val.obj (Opposite.op V)), dR V (r • p) = r * dR V p :=
      fun V r p => map_smul (d.val.app (Opposite.op V)).hom r p
    have hds_smul : ∀ (V : S.Etale) (r : (wcEtZModRing S m).obj.obj (Opposite.op V))
        (p : P.val.obj (Opposite.op V)), ds V (r • p) = e V r * ds V p := by
      intro V r p
      show e V (dR V (r • p)) = e V r * e V (dR V p)
      rw [hdR_smul, map_mul]
    have hds_nat : ∀ {V W : S.Etale} (g : W ⟶ V) (p : P.val.obj (Opposite.op V)) (y : W.left),
        ds W ((P.val.map g.op).hom p) y = ds V p (g.left y) := by
      intro V W g p y
      have h2 : dR W ((P.val.map g.op).hom p) = ((wcEtZModRing S m).obj.map g.op).hom (dR V p) :=
        PresheafOfModules.naturality_apply d.val g.op p
      show e W (dR W ((P.val.map g.op).hom p)) y = _
      rw [h2]
      exact he V W g (dR V p) y
    have hpst_zero : ∀ V, pst V 0 = 0 := by
      intro V
      ext x
      rw [hpst, hds_zero]
      split_ifs <;> rfl
    have hpst_add : ∀ V (p q : P.val.obj (Opposite.op V)), pst V (p + q) = pst V p + pst V q := by
      intro V p q
      ext x
      show pst V (p + q) x = pst V p x + pst V q x
      rw [hpst, hpst, hpst, hds_add]
      split_ifs
      · rfl
      · rw [add_zero]
    let φ : P.val.presheaf ⟶ (SheafOfModules.unit (wcEtZModRing S m)).val.presheaf :=
      { app := fun X => AddCommGrpCat.ofHom
          { toFun := fun p => (e X.unop).symm (pst X.unop p)
            map_zero' := by
              change (e X.unop).symm (pst X.unop 0) = (0 : (wcEtZModRing S m).obj.obj X)
              rw [hpst_zero, map_zero]
            map_add' := by
              intro p q
              change (e X.unop).symm (pst X.unop (p + q)) =
                (e X.unop).symm (pst X.unop p) + (e X.unop).symm (pst X.unop q)
              rw [hpst_add, map_add] }
        naturality := by
          intro X Y g
          apply AddCommGrpCat.hom_ext
          apply AddMonoidHom.ext
          intro p
          change (e Y.unop).symm (pst Y.unop ((P.val.map g).hom p)) =
            ((wcEtZModRing S m).obj.map g).hom ((e X.unop).symm (pst X.unop p))
          apply (e Y.unop).injective
          rw [RingEquiv.apply_symm_apply]
          ext y
          have h1 : e Y.unop (((wcEtZModRing S m).obj.map g).hom
              ((e X.unop).symm (pst X.unop p))) y = pst X.unop p (g.unop.left y) := by
            have := he X.unop Y.unop g.unop ((e X.unop).symm (pst X.unop p)) y
            rw [RingEquiv.apply_symm_apply] at this
            exact this
          rw [h1]
          show (if Y.unop.hom y ∈ Z₁ then ds Y.unop ((P.val.map g).hom p) y else 0) =
            (if X.unop.hom (g.unop.left y) ∈ Z₁ then ds X.unop p (g.unop.left y) else 0)
          have hw : Y.unop.hom y = X.unop.hom (g.unop.left y) :=
            (congrArg (fun k => k.base y) (MorphismProperty.Over.w g.unop)).symm
          have hn : ds Y.unop ((P.val.map g).hom p) y = ds X.unop p (g.unop.left y) :=
            hds_nat g.unop p y
          rw [hw, hn] }
    let k₂ : P ⟶ SheafOfModules.unit (wcEtZModRing S m) :=
      ⟨PresheafOfModules.homMk φ (by
        intro X r p
        change (e X.unop).symm (pst X.unop (r • p)) = r * (e X.unop).symm (pst X.unop p)
        apply (e X.unop).injective
        rw [map_mul, RingEquiv.apply_symm_apply, RingEquiv.apply_symm_apply]
        ext x
        show pst X.unop (r • p) x = e X.unop r x * pst X.unop p x
        rw [hpst, hpst, hds_smul]
        split_ifs
        · rfl
        · rw [mul_zero])⟩
    have hk₂ : ∀ (V : S.Etale) (p : P.val.obj (Opposite.op V)),
        e V ((k₂.val.app (Opposite.op V)).hom p) = pst V p := fun V p =>
      RingEquiv.apply_symm_apply (e V) (pst V p)
    refine ⟨d - k₂, k₂, (sub_add_cancel d k₂).symm, ?_, ?_⟩
    · intro V p x hx
      have hsub : (((d - k₂).val.app (Opposite.op V)).hom p :
          (wcEtZModRing S m).obj.obj (Opposite.op V)) = dR V p - (e V).symm (pst V p) := by
        change (((d.val - k₂.val).app (Opposite.op V)).hom p) = _
        rw [PresheafOfModules.sub_app, ModuleCat.hom_sub, LinearMap.sub_apply]
        rfl
      rw [hsub, map_sub, RingEquiv.apply_symm_apply]
      show ds V p x - pst V p x = 0
      rw [hpst, if_pos hx, sub_self]
    · intro V p x hx
      rw [hk₂, hpst]
      split_ifs with h
      · exact hd V p x h hx
      · rfl

  haveI hu₁ : Epi (wcEtSuppUnitMap E₁) := wc_et_supp_unit_epi i₁ E₁
  haveI hu₂ : Epi (wcEtSuppUnitMap E₂) := wc_et_supp_unit_epi i₂ E₂
  haveI huY : Epi (wcEtSuppUnitMap EY) := wc_et_supp_unit_epi iY EY
  have hk₁ : Limits.kernel.ι (wcEtSuppUnitMap E₁) ≫ wcEtSuppUnitMap EY = 0 := by
    have hv := s2 i₁ E₁ _ (Limits.kernel.condition _)
    exact s3 iY EY _ (fun V p x hx => hv V p x (G31 _ hx))
  have hk₂ : Limits.kernel.ι (wcEtSuppUnitMap E₂) ≫ wcEtSuppUnitMap EY = 0 := by
    have hv := s2 i₂ E₂ _ (Limits.kernel.condition _)
    exact s3 iY EY _ (fun V p x hx => hv V p x (G32 _ hx))
  let ρ₁ := Abelian.epiDesc (wcEtSuppUnitMap E₁) (wcEtSuppUnitMap EY) hk₁
  let ρ₂ := Abelian.epiDesc (wcEtSuppUnitMap E₂) (wcEtSuppUnitMap EY) hk₂
  have h₁ : wcEtSuppUnitMap E₁ ≫ ρ₁ = wcEtSuppUnitMap EY := Abelian.comp_epiDesc _ _ _
  have h₂ : wcEtSuppUnitMap E₂ ≫ ρ₂ = wcEtSuppUnitMap EY := Abelian.comp_epiDesc _ _ _

  have hz : Limits.biprod.lift (wcEtSuppUnitMap E₁) (wcEtSuppUnitMap E₂) ≫
      Limits.biprod.desc ρ₁ (-ρ₂) = 0 := by
    rw [Limits.biprod.lift_desc, Preadditive.comp_neg, h₁, h₂, add_neg_cancel]

  have hmono : ∀ {P : SheafOfModules.{u+1} (wcEtZModRing S m)}
      (g : P ⟶ SheafOfModules.unit (wcEtZModRing S m)),
      g ≫ wcEtSuppUnitMap E₁ = 0 → g ≫ wcEtSuppUnitMap E₂ = 0 → g = 0 := by
    intro P g hg₁ hg₂
    have v₁ := s2 i₁ E₁ g hg₁
    have v₂ := s2 i₂ E₂ g hg₂
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro W
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro p
    induction W using Opposite.rec with
    | op W =>
    change ((g.val.app (Opposite.op W)).hom p : (wcEtZModRing S m).obj.obj (Opposite.op W)) =
      (0 : (wcEtZModRing S m).obj.obj (Opposite.op W))
    apply (e W).injective
    refine Eq.trans ?_ (map_zero (e W)).symm
    ext x
    rcases G1 (W.hom x) with h | h
    · exact v₁ W p x h
    · exact v₂ W p x h

  have hsplit : ∀ {P : SheafOfModules.{u+1} (wcEtZModRing S m)}
      (d : P ⟶ SheafOfModules.unit (wcEtZModRing S m)), d ≫ wcEtSuppUnitMap EY = 0 →
      ∃ k₁ k₂ : P ⟶ SheafOfModules.unit (wcEtZModRing S m),
        k₁ ≫ wcEtSuppUnitMap E₁ = 0 ∧ k₂ ≫ wcEtSuppUnitMap E₂ = 0 ∧ d = k₁ + k₂ := by
    intro P d hd
    have vY := s2 iY EY d hd
    obtain ⟨k₁, k₂, hdk, hv₁, hv₂⟩ := s4 (Set.range i₁) (Set.range i₂)
      (Scheme.Hom.isClosedEmbedding i₁).isClosed_range
      (Scheme.Hom.isClosedEmbedding i₂).isClosed_range G1 d
      (fun V p x h1 h2 => vY V p x (G2 _ h1 h2))
    exact ⟨k₁, k₂, s3 i₁ E₁ k₁ hv₁, s3 i₂ E₂ k₂ hv₂, hdk⟩

  exact ⟨ρ₁, ρ₂, hz, s1 _ _ _ hu₁ hu₂ huY ρ₁ ρ₂ h₁ h₂ hmono hsplit hz⟩

theorem wc_etqm_srhl_ker_hom_const {S Z : Scheme.{u}} (i : Z ⟶ S) [IsClosedImmersion i] (m : ℕ)
    (hm : m ≠ 0) (D : wcEtPullData i m) (hconn : IsPreconnected (Set.range i)ᶜ) :
    ∀ φ : Limits.kernel (wcEtSuppUnitMap D) ⟶ SheafOfModules.unit (wcEtZModRing S m),
      ∃ c : ℕ, φ = Limits.kernel.ι (wcEtSuppUnitMap D) ≫
        (c • 𝟙 (SheafOfModules.unit (wcEtZModRing S m))) :=
by
  classical

  have e1 : ∀ {Y ZY : Scheme.{u}} (iY : ZY ⟶ Y) [IsClosedImmersion iY] (n : ℕ)
      (DY : wcEtPullData iY n), wcSuppIn Y (Set.range iY)ᶜ
        ((SheafOfModules.toSheaf (wcEtZModRing Y n)).obj (Limits.kernel (wcEtSuppUnitMap DY))) := by
    intro Y ZY iY _ n DY

    have locbij : ∀ (S : Scheme.{u}) (n : ℕ),
        ∃ α : (Functor.const (S.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶ (wcEtZModRing S n).obj,
          Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology S) α ∧
          Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology S) α := by
      intro S n
      let P : (S.Etale)ᵒᵖ ⥤ RingCat.{u+1} :=
        (Functor.const (S.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n)))
      exact ⟨toSheafify (Scheme.smallEtaleTopology S) P,
        Presheaf.isLocallyInjective_toSheafify' (Scheme.smallEtaleTopology S) P,
        Presheaf.isLocallySurjective_toSheafify' (Scheme.smallEtaleTopology S) P⟩

    have covsurj : ∀ (S : Scheme.{u}) (V : S.Etale) (R : Sieve V),
        R ∈ Scheme.smallEtaleTopology S V → ∀ x : V.left,
        ∃ (Y : S.Etale) (f : Y ⟶ V) (y : Y.left), R.arrows f ∧ f.left y = x := by
      intro S V R h x
      haveI : MorphismProperty.IsStableUnderComposition (@Etale : MorphismProperty Scheme.{u}) :=
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      have e := Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := (@Etale : MorphismProperty Scheme.{u})) (Q := (@Etale : MorphismProperty Scheme.{u})) S le_rfl
      have h' := (Scheme.mem_toGrothendieck_smallPretopology (P := @Etale) (Q := @Etale) V R).mp (e ▸ h)
      obtain ⟨Y, f, y, h1, _, h3⟩ := h' x
      exact ⟨Y, f, y, h1, h3⟩

    have twist : ∀ {S T : Scheme.{u}} {j : T ⟶ S} {n : ℕ} (E : wcEtPullData j n),
        ∃ e : SheafOfModules.unit (wcEtZModRing T n) ⟶ SheafOfModules.unit (wcEtZModRing T n),
          wcEtSuppUnitMap E ≫ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange j) _ _ E.cont E.φ).map e
            = @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange j) _ _ E.cont E.φ := by
      intro S T j n E
      refine ⟨E.μ.inv ≫ (E.adj.homEquiv _ _).symm
        (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange j) _ _ E.cont E.φ), ?_⟩
      dsimp only [wcEtSuppUnitMap, wcEtSuppObj]
      rw [Category.assoc, ← Functor.map_comp, Iso.hom_inv_id_assoc,
        ← Adjunction.homEquiv_unit, Equiv.apply_symm_apply]

    have intcast_eq : ∀ (S : Scheme.{u}) (n : ℕ) (V : S.Etale)
        (α : (Functor.const (S.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶ (wcEtZModRing S n).obj)
        (c : ULift.{u+1} (ZMod n)),
        (α.app (Opposite.op V)).hom c = (((c.down.cast : ℤ)) : ↑((wcEtZModRing S n).obj.obj (Opposite.op V))) := by
      intro S n V α c
      have hc : c = (((c.down.cast : ℤ)) : ULift.{u+1} (ZMod n)) := by
        apply ULift.ext
        rw [ULift.down_intCast, ZMod.intCast_zmod_cast]
      conv_lhs => rw [hc]
      exact map_intCast (α.app (Opposite.op V)).hom _

    have intzero : ∀ (S : Scheme.{u}) (n : ℕ) (V : S.Etale) (k : ℤ),
        (k : ↑((wcEtZModRing S n).obj.obj (Opposite.op V))) = 0 → (k : ZMod n) = 0 ∨ IsEmpty V.left := by
      intro S n V k hk
      by_cases hV : IsEmpty V.left
      · exact Or.inr hV
      · left
        obtain ⟨x⟩ := not_isEmpty_iff.mp hV
        obtain ⟨α, hinj, hsurj⟩ := locbij S n
        have h1 : (α.app (Opposite.op V)).hom ((k : ULift.{u+1} (ZMod n))) =
            (α.app (Opposite.op V)).hom (0 : ULift.{u+1} (ZMod n)) := by
          rw [map_intCast, map_zero]; exact hk
        have hmem := Presheaf.equalizerSieve_mem (Scheme.smallEtaleTopology S) α _ _ h1
        obtain ⟨Q, g, _, hg, _⟩ := covsurj S V _ hmem x
        have h2 : ((k : ULift.{u+1} (ZMod n))) = 0 := hg
        have h3 := congrArg ULift.down h2
        rw [ULift.down_intCast] at h3
        exact h3
    unfold wcSuppIn
    intro V s
    let k : ↑((wcEtZModRing Y n).obj.obj (Opposite.op V)) :=
      ((Limits.kernel.ι (wcEtSuppUnitMap DY)).val.app (Opposite.op V)).hom s
    have hρk : ((wcEtSuppUnitMap DY).val.app (Opposite.op V)).hom k = 0 := by
      have h := congrArg (fun h => (h.val.app (Opposite.op V)).hom s)
        (Limits.kernel.condition (wcEtSuppUnitMap DY))
      exact h
    have hφk : (DY.φ.hom.app (Opposite.op V)).hom k = 0 := by
      obtain ⟨e', he'⟩ := twist DY
      have h2 := congrArg (fun h => (h.val.app (Opposite.op V)).hom k) he'
      change (e'.val.app (Opposite.op ((wcEtBaseChange iY).obj V))).hom
        (((wcEtSuppUnitMap DY).val.app (Opposite.op V)).hom k) =
        (DY.φ.hom.app (Opposite.op V)).hom k at h2
      rw [hρk] at h2
      exact h2.symm.trans (LinearMap.map_zero _)
    obtain ⟨α, -, hsurj⟩ := locbij Y n
    refine GrothendieckTopology.superset_covering _ ?_
      (Presheaf.imageSieve_mem (Scheme.smallEtaleTopology Y) α k)
    intro V' g hg
    apply Sieve.le_generate
    obtain ⟨c, hc⟩ := hg
    have hk' : ((wcEtZModRing Y n).obj.map g.op).hom k =
        ((c.down.cast : ℤ) : ↑((wcEtZModRing Y n).obj.obj (Opposite.op V'))) :=
      hc.symm.trans (intcast_eq Y n V' α c)

    have hnat := congrArg (fun h => h.hom k) (DY.φ.hom.naturality g.op)
    simp only [RingCat.hom_comp, RingHom.comp_apply] at hnat
    rw [hφk, map_zero, hk', map_intCast] at hnat
    rcases intzero ZY n ((wcEtBaseChange iY).obj V') _ hnat with hk0 | hE
    · left
      rw [ZMod.intCast_zmod_cast] at hk0
      have hc0 : c = 0 := ULift.ext _ _ hk0
      have hk0' : ((wcEtZModRing Y n).obj.map g.op).hom k = 0 := by
        rw [← hc, hc0, map_zero]

      let G := SheafOfModules.toSheaf (wcEtZModRing Y n) ⋙
        sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} ⋙
        (evaluation _ AddCommGrpCat.{u+1}).obj (Opposite.op V')
      haveI : Limits.PreservesFiniteLimits G := inferInstance
      haveI : G.PreservesMonomorphisms := preservesMonomorphisms_of_preservesLimitsOfShape G
      have hm : Mono (G.map (Limits.kernel.ι (wcEtSuppUnitMap DY))) := inferInstance
      have hinjι := (AddCommGrpCat.mono_iff_injective _).mp hm
      have hn2 := PresheafOfModules.naturality_apply (Limits.kernel.ι (wcEtSuppUnitMap DY)).val g.op s
      apply hinjι
      refine hn2.trans ?_
      refine hk0'.trans ?_
      exact (map_zero _).symm
    · right
      intro x hx
      obtain ⟨z, hz⟩ := hx
      have hE' : IsEmpty ↥(Limits.pullback V'.hom iY) := hE
      obtain ⟨w, -, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := V'.hom) (g := iY) x z hz.symm
      exact hE'.false w

  have e2 : ∀ {X Z : Scheme.{u}} (i : Z ⟶ X) (ℓ : ℕ) (D : wcEtPullData i ℓ) (W : X.Etale),
      (∀ w : W.left, W.hom w ∉ Set.range i) →
        Subsingleton ↑((wcEtSuppObj D).val.obj (Opposite.op W)) := by
    intro X Z i ℓ D W hW
    have hEmpty : IsEmpty ↥(Limits.pullback W.hom i) :=
      Scheme.isEmpty_pullback W.hom i (Set.disjoint_left.2 (by rintro _ ⟨w, rfl⟩; exact hW w))
    have hE : IsEmpty ((wcEtBaseChange i).obj W).left := hEmpty
    have hBot : (⊥ : Sieve ((wcEtBaseChange i).obj W)) ∈
        Scheme.smallEtaleTopology Z ((wcEtBaseChange i).obj W) :=
      (congrArg (fun J : GrothendieckTopology Z.Etale =>
          (⊥ : Sieve ((wcEtBaseChange i).obj W)) ∈ J ((wcEtBaseChange i).obj W))
        (@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale
          Z MorphismProperty.IsMultiplicative.toIsStableUnderComposition
          _ _ _ _ le_rfl)).mpr
        ((@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Z
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _
          ((wcEtBaseChange i).obj W) (⊥ : Sieve ((wcEtBaseChange i).obj W))).2
            (fun x => isEmptyElim x))
    have hSub : Subsingleton ↑(((SheafOfModules.toSheaf (wcEtZModRing Z ℓ)).obj
        (SheafOfModules.unit (wcEtZModRing Z ℓ))).obj.obj
          (Opposite.op ((wcEtBaseChange i).obj W))) :=
      AddCommGrpCat.subsingleton_of_isZero
        (Sheaf.isTerminalOfBotCover ((SheafOfModules.toSheaf (wcEtZModRing Z ℓ)).obj
