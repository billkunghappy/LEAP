      letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (D₀.obj l₁).left ℓ)) := HasExt.standard _
      apply Abelian.Ext.precomp_mk₀_injective_of_epi
        (SheafOfModules.unit (wcEtZModRing (D₀.obj l₁).left ℓ)) (wcEtSuppUnitMap D₁)
      rw [map_zero]
      exact hθ₁
    | succ M =>
      obtain ⟨U, hU⟩ : ∃ U : Y.Opens, (U : Set Y) = (Set.range i)ᶜ :=
        ⟨⟨(Set.range i)ᶜ, i.isClosedEmbedding.isClosed_range.isOpen_compl⟩, rfl⟩
      have hrl : Set.range (Limits.pullback.fst (D₀.obj l₁).hom U.ι) =
          (Set.range (Limits.pullback.snd i (D₀.obj l₁).hom))ᶜ := by
        rw [Scheme.Pullback.range_fst, Scheme.Opens.range_ι, hU, Set.preimage_compl,
          Scheme.Pullback.range_snd]
      haveI : IsOpenImmersion (Limits.pullback.fst (D₀.obj l₁).hom U.ι) := by
        first
          | infer_instance
          | exact MorphismProperty.of_isPullback (P := @IsOpenImmersion)
              (IsPullback.of_hasPullback (D₀.obj l₁).hom U.ι).flip inferInstance
      obtain ⟨a, ha⟩ := G1
        (Limits.pullback.snd i (D₀.obj l₁).hom) (Limits.pullback.fst (D₀.obj l₁).hom U.ι) hrl
        ℓ hℓ D₁ M _ hθ₁
      obtain ⟨l₃, t, D₃, Et, γ₃, hγ₃, h3⟩ := G2 i ℓ U hU R k Λ
        D₀ φ hAff hφc hφa hlim l₁ D₁ M _ a ha T iT gT hTsq DT Eφ γT hγT hR
      haveI : IsClosedImmersion (Limits.pullback.snd i (D₀.obj l₃).hom) :=
        MorphismProperty.of_isPullback (P := @IsClosedImmersion)
          (IsPullback.of_hasPullback i (D₀.obj l₃).hom) inferInstance
      obtain ⟨E₃⟩ := wc_et_zmod_pull_data_exists (D₀.obj l₃).hom ℓ
      obtain ⟨γ₃', hγ₃', hepi₃⟩ := wc_et_closed_supp_base_change i (D₀.obj l₃).hom
        (Limits.pullback.snd i (D₀.obj l₃).hom) (Limits.pullback.fst i (D₀.obj l₃).hom)
        (IsPullback.of_hasPullback i (D₀.obj l₃).hom) D E₃ D₃
      refine ⟨l₃, D₃, E₃, γ₃', hγ₃', ?_⟩
      rw [wc_et_supp_restr_comp (D₀.obj l₁).hom (D₀.map t).left (D₀.obj l₃).hom
        (MorphismProperty.Over.w (D₀.map t)) D D₁ D₃ E₁ Et E₃ γ₁ γ₃ γ₃' hγ₁ hγ₃ hγ₃' hepi₃
        (M + 1) θ]
      exact h3
  refine ⟨(D₀.obj l).left, (D₀.obj l).hom, φ l, (D₀.obj l).prop, hAff l, hφa l, ?_⟩
  intro ZW iW gW hsq DW Ev γW hγW
  exact s3 i (D₀.obj l).hom (Limits.pullback.snd i (D₀.obj l).hom)
    (Limits.pullback.fst i (D₀.obj l).hom) iW gW (IsPullback.of_hasPullback _ _) hsq D Dl El γl
    DW Ev γW hγl hγW q θ hzero

theorem wc_et_tpl_dsl_fsz_supp_restr_inj (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (k : ℕ) (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left
      (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left))
    (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left)
    (hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a)
    (x : ↥(Limits.pullback D.f a)) (hx : Limits.pullback.fst D.f a x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Limits.pullback D.f a) x))
      (Scheme.Etale.forget (Limits.pullback D.f a)))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ Limits.pullback D.f a)
    (hsh : wcHalShData x B Λ' W'' φ' a')
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)))
    (hxs : Limits.pullback.fst (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A) xs = x)
    (Dx : wcEtPullData (wcEtGeomPt (Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)) xs) (ℓ ^ k))
    (Dw : wcEtPullData (Limits.pullback.snd a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (ℓ ^ k))
    (D' : wcEtPullData (Limits.pullback.snd (wcEtGeomPt (Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)) xs) (Limits.pullback.snd a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)))) (ℓ ^ k))
    (γ : wcEtSuppObj D' ⟶ Dw.Φ.obj (wcEtSuppObj Dx))
    (hγ : wcEtSuppUnitMap D' ≫ γ = Dw.μ.inv ≫ Dw.Φ.map (wcEtSuppUnitMap Dx)) :
    ∀ q : ℕ, Function.Injective (wcEtSuppRestr Dx Dw D' γ q) :=
by
  classical


  have core : ∀ {Xs WS : Scheme.{u}} [IsLocallyNoetherian Xs] (xs : Xs)
      [IsClosedImmersion (wcEtGeomPt Xs xs)] (w : WS ⟶ Xs) (_hwe : WeaklyEtale w)
      (R : Type u) [CommRing R] (hh : HenselianLocalRing R)
      (hsep : IsSepClosed (@IsLocalRing.ResidueField R _ hh.toIsLocalRing))
      (c : WS ⟶ Spec (.of R)) [IsIso c] (c₀ : WS) (_hc₀ : w c₀ = xs) (_hcs : ∀ t : WS, t ⤳ c₀)
      (m : ℕ) (_hm : 0 < m) (Dx : wcEtPullData (wcEtGeomPt Xs xs) m) (Dw : wcEtPullData w m)
      (D' : wcEtPullData (Limits.pullback.snd (wcEtGeomPt Xs xs) w) m)
      (γ : wcEtSuppObj D' ⟶ Dw.Φ.obj (wcEtSuppObj Dx))
      (_hγ : wcEtSuppUnitMap D' ≫ γ = Dw.μ.inv ≫ Dw.Φ.map (wcEtSuppUnitMap Dx)) (q : ℕ),
      Function.Injective (wcEtSuppRestr Dx Dw D' γ q) := by
    intro Xs WS _ xs _ w hwe R _ hh hsep c _ c₀ hc₀ hcs m hm Dx Dw D' γ hγ q
    rw [injective_iff_map_eq_zero]
    intro θ hθ
    have hxbpt : ∀ p, (wcEtGeomPt Xs xs) p = xs := fun p => by
      first
        | rw [Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]
        | simp only [wcEtGeomPt, Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]
        | exact Scheme.fromSpecResidueField_apply xs _

    have hk : WeaklyEtale (inv c ≫ w) :=
      (MorphismProperty.cancel_left_of_respectsIso @WeaklyEtale (inv c) w).mpr hwe

    have sq1 := IsPullback.of_hasPullback (wcEtGeomPt Xs xs) w
    have sq2 : IsPullback w c (𝟙 Xs) (inv c ≫ w) :=
      IsPullback.of_vert_isIso ⟨by rw [Category.comp_id, IsIso.hom_inv_id_assoc]⟩
    have sqT : IsPullback (Limits.pullback.fst (wcEtGeomPt Xs xs) w)
        (Limits.pullback.snd (wcEtGeomPt Xs xs) w ≫ c) (wcEtGeomPt Xs xs) (inv c ≫ w) := by
      have h := sq1.paste_vert sq2
      rwa [Category.comp_id] at h
    obtain ⟨DT⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.snd (wcEtGeomPt Xs xs) w ≫ c) m
    obtain ⟨Ek⟩ := wc_et_zmod_pull_data_exists (inv c ≫ w) m
    obtain ⟨γT, hγT, hepiT⟩ := wc_et_closed_supp_base_change (wcEtGeomPt Xs xs) (inv c ≫ w)
      (Limits.pullback.snd (wcEtGeomPt Xs xs) w ≫ c) (Limits.pullback.fst (wcEtGeomPt Xs xs) w)
      sqT Dx Ek DT
    have sq3 : IsPullback (𝟙 _) (Limits.pullback.snd (wcEtGeomPt Xs xs) w ≫ c)
        (Limits.pullback.snd (wcEtGeomPt Xs xs) w) (inv c) :=
      IsPullback.of_horiz_isIso ⟨by
        rw [Category.id_comp, Category.assoc, IsIso.hom_inv_id, Category.comp_id]⟩
    obtain ⟨E₂⟩ := wc_et_zmod_pull_data_exists (inv c) m
    obtain ⟨γ₂, hγ₂, -⟩ := wc_et_closed_supp_base_change (Limits.pullback.snd (wcEtGeomPt Xs xs) w)
      (inv c) (Limits.pullback.snd (wcEtGeomPt Xs xs) w ≫ c) (𝟙 _) sq3 D' E₂ DT

    have hθT : wcEtSuppRestr Dx Ek DT γT q θ = 0 := by
      rw [wc_et_supp_restr_comp w (inv c) (inv c ≫ w) rfl Dx D' DT Dw E₂ Ek γ γ₂ γT hγ hγ₂ hγT
        hepiT q θ, hθ, map_zero]

    obtain ⟨Wn, v, w₀, hv, hWaff, hw₀, hkill⟩ :=
      @wc_et_supp_strict_local_limit_kill_pos Xs _ (wcEtGeomPt Xs xs) _ _ m hm (CommRingCat.of R)
        hh hsep (inv c ≫ w) hk _ (Limits.pullback.snd (wcEtGeomPt Xs xs) w ≫ c)
        (Limits.pullback.fst (wcEtGeomPt Xs xs) w) sqT Dx DT Ek γT hγT q θ hθT
    haveI := hv
    haveI := hWaff
    haveI : IsSeparated v := inferInstance

    have e : (c ≫ w₀) ≫ v = w := by rw [Category.assoc, hw₀, IsIso.hom_inv_id_assoc]
    have hw₁ : v ((c ≫ w₀) c₀) = xs := by
      rw [← hc₀, ← e]
      rfl

    obtain ⟨V', π', v₀, hπ', hv₀ci, hv₀eq, hfib⟩ :=
      wc_et_isolated_geom_point_nbhd v xs inferInstance (c ≫ w₀) c₀ hcs hw₁
    haveI := hv₀ci
    have sqR : IsPullback (𝟙 _) v₀ (wcEtGeomPt Xs xs) (V'.ι ≫ v) :=
      wc_et_point_fibre_isPullback (AlgebraicClosure (Xs.residueField xs)) Xs V' (V'.ι ≫ v)
        (wcEtGeomPt Xs xs) v₀ hv₀eq (fun v' hv' => hfib v' (hv'.trans (hxbpt _)))
    have sqv := IsPullback.of_hasPullback (wcEtGeomPt Xs xs) v
    obtain ⟨DW⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.snd (wcEtGeomPt Xs xs) v) m
    obtain ⟨Ev⟩ := wc_et_zmod_pull_data_exists v m
    obtain ⟨γW, hγW, -⟩ := wc_et_closed_supp_base_change (wcEtGeomPt Xs xs) v
      (Limits.pullback.snd (wcEtGeomPt Xs xs) v) (Limits.pullback.fst (wcEtGeomPt Xs xs) v)
      sqv Dx Ev DW
    have h0 := hkill _ _ _ sqv DW Ev γW hγW
    have hgι : 𝟙 _ ≫ wcEtGeomPt Xs xs = (v₀ ≫ V'.ι) ≫ v := by
      rw [Category.id_comp, Category.assoc, hv₀eq]
    have outer : IsPullback
        (Limits.pullback.lift (𝟙 _) (v₀ ≫ V'.ι) hgι ≫ Limits.pullback.fst (wcEtGeomPt Xs xs) v)
        v₀ (wcEtGeomPt Xs xs) (V'.ι ≫ v) := by
      rw [Limits.pullback.lift_fst]
      exact sqR
    have sqι : IsPullback (Limits.pullback.lift (𝟙 _) (v₀ ≫ V'.ι) hgι) v₀
        (Limits.pullback.snd (wcEtGeomPt Xs xs) v) V'.ι :=
      IsPullback.of_right outer (Limits.pullback.lift_snd _ _ _) sqv
    obtain ⟨DV⟩ := wc_et_zmod_pull_data_exists v₀ m
    obtain ⟨Eι⟩ := wc_et_zmod_pull_data_exists V'.ι m
    obtain ⟨γι, hγι, hepiV⟩ := wc_et_closed_supp_base_change
      (Limits.pullback.snd (wcEtGeomPt Xs xs) v) V'.ι v₀
      (Limits.pullback.lift (𝟙 _) (v₀ ≫ V'.ι) hgι) sqι DW Eι DV
    obtain ⟨E''⟩ := wc_et_zmod_pull_data_exists (V'.ι ≫ v) m
    obtain ⟨γ'', hγ'', -⟩ := wc_et_closed_supp_base_change (wcEtGeomPt Xs xs) (V'.ι ≫ v) v₀
      (𝟙 _) sqR Dx E'' DV
    have h1 : wcEtSuppRestr Dx E'' DV γ'' q θ = 0 := by
      rw [wc_et_supp_restr_comp v V'.ι (V'.ι ≫ v) rfl Dx DW DV Ev Eι E'' γW γι γ'' hγW hγι hγ''
        hepiV q θ, h0, map_zero]
    exact wc_et_supp_restr_etale_excision_injective (V'.ι ≫ v) (wcEtGeomPt Xs xs) v₀ (𝟙 _) sqR
      inferInstance Dx E'' DV γ'' hγ'' q (h1.trans (map_zero _).symm)

  intro q
  have hm : 0 < ℓ ^ k := pow_pos (Fact.out : Nat.Prime ℓ).pos k
  haveI := wc_et_tpl_sfu_geom_pt_closed_immersion F' F'' Y n D i A Λ W' φ a hA x hx xs hxs
  haveI : IsClosedImmersion (wcQmSp A) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  haveI : IsLocallyNoetherian (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) := by
    haveI := D.proper
    haveI : LocallyOfFiniteType (D.f ≫ (wcP1Over F'').hom) := by
      rw [D.hf]
      infer_instance
    haveI : LocallyOfFiniteType D.f := locallyOfFiniteType_of_comp D.f (wcP1Over F'').hom
    haveI : LocallyOfFiniteType (Limits.pullback.snd D.f a) :=
      MorphismProperty.of_isPullback (P := @LocallyOfFiniteType)
        (IsPullback.of_hasPullback D.f a) inferInstance
    haveI : LocallyOfFiniteType (Limits.pullback.snd (Limits.pullback.snd D.f a) (wcQmSp A)) :=
      MorphismProperty.of_isPullback (P := @LocallyOfFiniteType)
        (IsPullback.of_hasPullback (Limits.pullback.snd D.f a) (wcQmSp A)) inferInstance
    exact LocallyOfFiniteType.isLocallyNoetherian
      (Limits.pullback.snd (Limits.pullback.snd D.f a) (wcQmSp A))

  obtain ⟨J, c, hpb, hJ⟩ := wc_et_dsl_shens_closed_fibre_square A (Limits.pullback.snd D.f a) x
    xs hxs B Λ' W'' φ' a' hsh
  haveI : IsIso c := hpb.isIso_snd_of_isIso
  obtain ⟨hh, hsep⟩ := wc_quot_strictly_henselian_of_ne_top B J hJ
  have hwe : WeaklyEtale (Limits.pullback.snd a'
      (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale)
      (IsPullback.of_hasPullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)))
      (wc_shdata_weaklyEtale x B Λ' W'' φ' a' hsh)
  obtain ⟨c₀, hc₀, hcs⟩ := wc_shdata_closed_fibre_center x B Λ' W'' φ' a' hsh
    (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) xs hxs
  exact core xs _ hwe (B ⧸ J) hh hsep c c₀ hc₀ hcs (ℓ ^ k) hm Dx Dw D' γ hγ q

theorem wc_et_closed_supp_end_eq_nsmul_id {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i]
    (hZ : Subsingleton ↥Z) (m : ℕ) (hm : 0 < m) (D : wcEtPullData i m)
    (c : wcEtSuppObj D ⟶ wcEtSuppObj D) : ∃ j : ℕ, c = j • 𝟙 (wcEtSuppObj D) :=
by
  classical
  let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ
  let R := wcEtZModRing Z m
  let U := SheafOfModules.unit R
  let T : Z.Etale := Scheme.Etale.mk (𝟙 Z)
  haveI := D.additive
  haveI : P.Additive := Adjunction.right_adjoint_additive D.adj
  obtain ⟨hFull, hFaith⟩ := wc_et_closed_push_modules_full_faithful i m D
  haveI := hFull
  haveI := hFaith
  change P.obj U ⟶ P.obj U at c

  have hT : Limits.IsTerminal T := by
    refine Limits.IsTerminal.ofUniqueHom
      (fun V => MorphismProperty.Over.homMk V.hom
        (by first
          | exact Category.comp_id V.hom
          | (show V.hom ≫ 𝟙 _ = V.hom; exact Category.comp_id _)
          | (erw [Category.comp_id])) trivial) ?_
    intro V g
    apply MorphismProperty.Over.Hom.ext
    have hw := MorphismProperty.Over.w g
    first
      | exact (Category.comp_id g.left).symm.trans hw
      | (show g.left = V.hom; rw [← hw]; exact (Category.comp_id g.left).symm)
      | (show g.left = V.hom; erw [Category.comp_id] at hw; exact hw)
  have hev := (wc_et_zmod_unit_hom_eval_terminal_bij Z m T hT U).1
  let evH : (U ⟶ U) →+ R.obj.obj (Opposite.op T) :=
    AddMonoidHom.mk' (fun g => (g.val.app (Opposite.op T)).hom (1 : R.obj.obj (Opposite.op T)))
      (fun g g' => by
        first
          | rfl
          | simp [SheafOfModules.add_val, PresheafOfModules.add_app])
  have hevH1 : evH (𝟙 U) = 1 := rfl
  obtain ⟨E, -⟩ := wc_et_zmod_ring_sections_lc_equiv Z m
  haveI : NeZero m := ⟨hm.ne'⟩
  let e := P.preimage c
  have hPe : P.map e = c := P.map_preimage c
  let s := evH e
  have key : ∃ j : ℕ, s = j • (1 : R.obj.obj (Opposite.op T)) := by
    by_cases hne : Nonempty Z
    · obtain ⟨z₀⟩ := hne
      refine ⟨(E T s z₀).val, ?_⟩
      apply (E T).injective
      ext z
      rw [map_nsmul, map_one, LocallyConstant.smul_apply, LocallyConstant.coe_one,
        Pi.one_apply, nsmul_one, ZMod.natCast_zmod_val]
      have hz : z = z₀ := Subsingleton.elim (α := ↥Z) z z₀
      rw [hz]
    · refine ⟨0, ?_⟩
      apply (E T).injective
      ext z
      exact (hne ⟨z⟩).elim
  obtain ⟨j, hj⟩ := key
  refine ⟨j, ?_⟩
  have he : e = j • 𝟙 U := by
    apply hev
    show evH e = evH (j • 𝟙 U)
    rw [map_nsmul, hevH1]
    exact hj
  rw [← hPe, he, CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
  all_goals rfl

theorem wc_et_shens_geom_pt_fibre_subsingleton {X : Scheme.{u}} (A : Type u) [CommRing A] [IsLocalRing A]
    (g : X ⟶ Spec (.of A)) (x : X)
    (xs : ↥(Limits.pullback g (wcQmSp A))) (hxs : Limits.pullback.fst g (wcQmSp A) xs = x)
    (B : Type u) [CommRing B] [IsLocalRing B]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt X x)) (Scheme.Etale.forget X))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ X)
    (hsh : wcHalShData x B Λ' W'' φ' a')
    [IsClosedImmersion (wcEtGeomPt (Limits.pullback g (wcQmSp A)) xs)] :
    Subsingleton ↥(Limits.pullback (wcEtGeomPt (Limits.pullback g (wcQmSp A)) xs)
      (Limits.pullback.snd a' (Limits.pullback.fst g (wcQmSp A)))) :=
by
  have wc_shdata_fibre_closed_point : ∀ {Y : Scheme.{u}} (y : Y) (B : Type u) [CommRing B] [IsLocalRing B] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Y), wcHalShData y B Λ W' φ a → ∀ p : Spec (.of B), a p = y → p = IsLocalRing.closedPoint B := by
    intro Y y B _ _ Λ _ _ W' φ a hA p hp
    have comp_ap : ∀ {X₁ Y₁ Z₁ : Scheme.{u}} (f₁ : X₁ ⟶ Y₁) (g₁ : Y₁ ⟶ Z₁) (x₁ : X₁),
        (f₁ ≫ g₁) x₁ = g₁ (f₁ x₁) := by
      intro X₁ Y₁ Z₁ f₁ g₁ x₁
      first
      | rfl
      | simp
    have hγ : ∀ (C : Scheme.{u}) (c : C) (t : Spec (.of (AlgebraicClosure (C.residueField c)))),
        wcEtGeomPt C c t = c := by
      intro C c t
      first
      | exact Scheme.fromSpecResidueField_apply c _
      | (unfold wcEtGeomPt; rw [comp_ap]; exact Scheme.fromSpecResidueField_apply c _)
      | (simp only [wcEtGeomPt, comp_ap, Scheme.fromSpecResidueField_apply])
      | (simp [wcEtGeomPt])
    have vnr : IsAffine (Limits.pullback (Y.fromSpecResidueField y) a) ∧
        ∀ g : Γ(Limits.pullback (Y.fromSpecResidueField y) a, ⊤),
          ∃ s : Γ(Limits.pullback (Y.fromSpecResidueField y) a, ⊤), g * g * s = g := by
      obtain ⟨-, haff, hcomp, hφa, hlim, -⟩ := hA
      haveI hiaff : IsAffineHom (Y.fromSpecResidueField y) := by
        constructor
