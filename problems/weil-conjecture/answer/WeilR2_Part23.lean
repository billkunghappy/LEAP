      (ε ((wcEtBaseChange w).obj V))
      (SheafOfModules.unitToPushforwardObjUnit (ψ ((wcEtBaseChange w).obj V)))
      (hiso ((wcEtBaseChange w).obj V))
      (wcEtsmKappa Dw Pf ev V)
      ((Dw.adj.homEquiv _ _).symm
        (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange w) _ _ Dw.cont Dw.φ))
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange w) _ _ Dw.cont Dw.φ) rfl
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
        (wcEtBaseChange (Limits.pullback.fst V.hom w)) _ _ D.cont D.φ) hν D.μ H1 H2
      (fun c n y => wc_etsm_unit_end_central ((wcEtBaseChange w).obj V).left m c n y) q b

theorem wc_etsm_milnor_limit_kill (A : Type u) [CommRing A] (Z : Scheme.{u}) (fZ : Z ⟶ Spec (.of A))
    (m n : ℕ) (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A))
    (σ : Spec (.of Ω) ⟶ Spec (.of Ω)) (hσ : σ ≫ ξ = ξ)
    (σQ : Limits.pullback fZ ξ ⟶ Limits.pullback fZ ξ)
    (hσQ1 : σQ ≫ Limits.pullback.fst fZ ξ = Limits.pullback.fst fZ ξ)
    (hσQ2 : σQ ≫ Limits.pullback.snd fZ ξ = Limits.pullback.snd fZ ξ ≫ σ) (x : Z)
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Z x)) (Scheme.Etale.forget Z))
    (φl : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Z)
    (hsh : wcHalShData x B Λ W' φl a)
    (hfix : ∀ (E : wcEtPullData (Limits.pullback.lift (Limits.pullback.fst (a ≫ fZ) ξ)
          (Limits.pullback.snd (a ≫ fZ) ξ ≫ σ)
          (by rw [Category.assoc, hσ]; exact Limits.pullback.condition)) m)
        (y : wcEtZModExt (Limits.pullback (a ≫ fZ) ξ) m n), wcEtPull E n y = y)
    (l : Λ) (y : wcEtZModExt (Limits.pullback (W'.obj l).right.hom (Limits.pullback.fst fZ ξ)) m n)
    (Eτ : wcEtPullData (Limits.pullback.lift
        (Limits.pullback.fst (W'.obj l).right.hom (Limits.pullback.fst fZ ξ))
        (Limits.pullback.snd (W'.obj l).right.hom (Limits.pullback.fst fZ ξ) ≫ σQ)
        (by rw [Category.assoc, hσQ1]; exact Limits.pullback.condition)) m) :
    ∃ (l' : Λ) (t : l' ⟶ l)
      (D' : wcEtPullData ((wcEtBaseChange (Limits.pullback.fst fZ ξ)).map (W'.map t).right).left m),
      wcEtPull D' n (wcEtPull Eτ n y - y) = 0 :=
by
  classical
  obtain ⟨_, hAff, hφt, hφa, hlim, _⟩ := hsh

  have hξ : IsAffineHom ξ := inferInstance
  have hh : IsAffineHom (Limits.pullback.fst fZ ξ) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) (IsPullback.of_hasPullback fZ ξ).flip hξ
  have hTaff : ∀ l, IsAffine (Limits.pullback (W'.obj l).right.hom (Limits.pullback.fst fZ ξ)) := by
    intro l
    haveI := hAff l
    haveI : IsAffine ((𝟭 Scheme).obj (W'.obj l).right.left) := hAff l
    haveI : IsAffineHom (Limits.pullback.fst (W'.obj l).right.hom (Limits.pullback.fst fZ ξ)) :=
      MorphismProperty.of_isPullback (P := @IsAffineHom) (IsPullback.of_hasPullback _ _).flip hh
    exact isAffine_of_isAffineHom (Limits.pullback.fst (W'.obj l).right.hom (Limits.pullback.fst fZ ξ))

  obtain ⟨p, hp1, hp2⟩ : ∃ p : Limits.pullback (a ≫ fZ) ξ ⟶ Limits.pullback fZ ξ,
      p ≫ Limits.pullback.fst fZ ξ = Limits.pullback.fst (a ≫ fZ) ξ ≫ a ∧
      p ≫ Limits.pullback.snd fZ ξ = Limits.pullback.snd (a ≫ fZ) ξ :=
    ⟨Limits.pullback.lift (Limits.pullback.fst (a ≫ fZ) ξ ≫ a) (Limits.pullback.snd (a ≫ fZ) ξ)
      (by rw [Category.assoc]; exact Limits.pullback.condition),
     Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩

  obtain ⟨π, hπ1, hπ2⟩ : ∃ π : ∀ l, Limits.pullback (a ≫ fZ) ξ ⟶
      Limits.pullback (W'.obj l).right.hom (Limits.pullback.fst fZ ξ),
      (∀ l, π l ≫ Limits.pullback.fst (W'.obj l).right.hom (Limits.pullback.fst fZ ξ) =
        Limits.pullback.fst (a ≫ fZ) ξ ≫ φl l) ∧
      (∀ l, π l ≫ Limits.pullback.snd (W'.obj l).right.hom (Limits.pullback.fst fZ ξ) = p) :=
    ⟨fun l => Limits.pullback.lift (Limits.pullback.fst (a ≫ fZ) ξ ≫ φl l) p
      (by rw [Category.assoc, hφa l, hp1]),
     fun l => Limits.pullback.lift_fst _ _ _, fun l => Limits.pullback.lift_snd _ _ _⟩

  have hLc : ∀ {l l' : Λ} (t : l ⟶ l'),
      (Limits.pullback.fst (W'.obj l).right.hom (Limits.pullback.fst fZ ξ) ≫ (W'.map t).right.left) ≫
        (W'.obj l').right.hom =
      Limits.pullback.snd (W'.obj l).right.hom (Limits.pullback.fst fZ ξ) ≫
        Limits.pullback.fst fZ ξ := by
    intro l l' t
    rw [Category.assoc]
    exact (whisker_eq _ (MorphismProperty.Over.w (W'.map t).right)).trans Limits.pullback.condition
  have hcT : ∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ Limits.pullback.lift
      (Limits.pullback.fst (W'.obj l).right.hom (Limits.pullback.fst fZ ξ) ≫ (W'.map t).right.left)
      (Limits.pullback.snd (W'.obj l).right.hom (Limits.pullback.fst fZ ξ)) (hLc t) = π l' := by
    intro l l' t
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, hπ1, hπ1, Category.assoc,
        hφt t]
    · rw [Category.assoc, Limits.pullback.lift_snd, hπ2, hπ2]

  have e1gen : ∀ (T : Scheme.{u}) (w : ∀ l, T ⟶ Limits.pullback (W'.obj l).right.hom
      (Limits.pullback.fst fZ ξ)) (b₀ : T ⟶ Spec (.of B)) (l : Λ),
      b₀ ≫ φl l = w l ≫ Limits.pullback.fst (W'.obj l).right.hom (Limits.pullback.fst fZ ξ) →
      b₀ ≫ a = w l ≫ Limits.pullback.snd (W'.obj l).right.hom (Limits.pullback.fst fZ ξ) ≫
        Limits.pullback.fst fZ ξ := by
    intro T w b₀ l hb
    rw [← hφa l, ← Category.assoc b₀, hb, Category.assoc (w l), Limits.pullback.condition]
  have hlimP : ∀ (T : Scheme.{u}) (w : ∀ l, T ⟶ Limits.pullback (W'.obj l).right.hom
      (Limits.pullback.fst fZ ξ)),
      (∀ {l l' : Λ} (t : l ⟶ l'), w l ≫ Limits.pullback.lift
        (Limits.pullback.fst (W'.obj l).right.hom (Limits.pullback.fst fZ ξ) ≫ (W'.map t).right.left)
        (Limits.pullback.snd (W'.obj l).right.hom (Limits.pullback.fst fZ ξ)) (hLc t) = w l') →
      ∃! w₀ : T ⟶ Limits.pullback (a ≫ fZ) ξ, ∀ l, w₀ ≫ π l = w l := by
    intro T w hw
    have hb : ∀ {l l' : Λ} (t : l ⟶ l'),
        (w l ≫ Limits.pullback.fst (W'.obj l).right.hom (Limits.pullback.fst fZ ξ)) ≫
          (W'.map t).right.left =
        w l' ≫ Limits.pullback.fst (W'.obj l').right.hom (Limits.pullback.fst fZ ξ) := by
      intro l l' t
      rw [← hw t, Category.assoc, Category.assoc, Limits.pullback.lift_fst]
    have hs : ∀ {l l' : Λ} (t : l ⟶ l'),
        w l ≫ Limits.pullback.snd (W'.obj l).right.hom (Limits.pullback.fst fZ ξ) =
        w l' ≫ Limits.pullback.snd (W'.obj l').right.hom (Limits.pullback.fst fZ ξ) := by
      intro l l' t
      rw [← hw t, Category.assoc, Limits.pullback.lift_snd]
    obtain ⟨l₀⟩ : Nonempty Λ := IsCofiltered.nonempty
    have hsc : ∀ l, w l ≫ Limits.pullback.snd (W'.obj l).right.hom (Limits.pullback.fst fZ ξ) =
        w l₀ ≫ Limits.pullback.snd (W'.obj l₀).right.hom (Limits.pullback.fst fZ ξ) := fun l =>
      (hs (IsCofiltered.minToLeft l l₀)).symm.trans (hs (IsCofiltered.minToRight l l₀))
    obtain ⟨b₀, hb₀, hb₀u⟩ := hlim T
      (fun l => w l ≫ Limits.pullback.fst (W'.obj l).right.hom (Limits.pullback.fst fZ ξ)) hb
    have hb₀' : ∀ l, b₀ ≫ φl l =
        w l ≫ Limits.pullback.fst (W'.obj l).right.hom (Limits.pullback.fst fZ ξ) := hb₀
    have hcond : b₀ ≫ a ≫ fZ = (w l₀ ≫ Limits.pullback.snd (W'.obj l₀).right.hom
        (Limits.pullback.fst fZ ξ) ≫ Limits.pullback.snd fZ ξ) ≫ ξ := by
      rw [← Category.assoc b₀, e1gen T w b₀ l₀ (hb₀' l₀)]
      simp only [Category.assoc]
      rw [Limits.pullback.condition]
    obtain ⟨z₀, hz1, hz2⟩ : ∃ z₀ : T ⟶ Limits.pullback (a ≫ fZ) ξ,
        z₀ ≫ Limits.pullback.fst (a ≫ fZ) ξ = b₀ ∧
        z₀ ≫ Limits.pullback.snd (a ≫ fZ) ξ = w l₀ ≫ Limits.pullback.snd (W'.obj l₀).right.hom
          (Limits.pullback.fst fZ ξ) ≫ Limits.pullback.snd fZ ξ :=
      ⟨Limits.pullback.lift _ _ hcond, Limits.pullback.lift_fst _ _ _,
        Limits.pullback.lift_snd _ _ _⟩
    have hz : ∀ l, z₀ ≫ π l = w l := by
      intro l
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hπ1, ← Category.assoc, hz1, hb₀' l]
      · rw [Category.assoc, hπ2]
        apply Limits.pullback.hom_ext
        · simp only [Category.assoc]
          rw [hp1, ← Category.assoc z₀, hz1, e1gen T w b₀ l (hb₀' l)]
        · simp only [Category.assoc]
          rw [hp2, hz2, ← Category.assoc (w l₀), ← hsc l, Category.assoc]
    refine ⟨z₀, hz, fun z₁ hz₁ => ?_⟩
    have h1 : z₁ ≫ Limits.pullback.fst (a ≫ fZ) ξ = b₀ := by
      apply hb₀u
      intro l
      show (z₁ ≫ Limits.pullback.fst (a ≫ fZ) ξ) ≫ φl l =
        w l ≫ Limits.pullback.fst (W'.obj l).right.hom (Limits.pullback.fst fZ ξ)
      rw [Category.assoc, ← hπ1 l, ← Category.assoc, hz₁ l]
    apply Limits.pullback.hom_ext
    · rw [h1, hz1]
    · rw [hz2, ← hp2, ← Category.assoc z₁, ← hπ2 l₀, ← Category.assoc z₁, hz₁ l₀, Category.assoc]

  have hint : Limits.pullback.lift (Limits.pullback.fst (a ≫ fZ) ξ)
        (Limits.pullback.snd (a ≫ fZ) ξ ≫ σ)
        (by rw [Category.assoc, hσ]; exact Limits.pullback.condition) ≫ π l =
      π l ≫ Limits.pullback.lift
        (Limits.pullback.fst (W'.obj l).right.hom (Limits.pullback.fst fZ ξ))
        (Limits.pullback.snd (W'.obj l).right.hom (Limits.pullback.fst fZ ξ) ≫ σQ)
        (by rw [Category.assoc, hσQ1]; exact Limits.pullback.condition) := by
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc, Limits.pullback.lift_fst, hπ1, Limits.pullback.lift_fst_assoc]
    · simp only [Category.assoc, Limits.pullback.lift_snd, hπ2, reassoc_of% (hπ2 l)]
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc, hp1, hσQ1, Limits.pullback.lift_fst_assoc]
      · simp only [Category.assoc, hp2, hσQ2, reassoc_of% hp2, Limits.pullback.lift_snd]

  obtain ⟨E⟩ := wc_et_zmod_pull_data_exists (π l) m
  obtain ⟨Ew⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.lift (Limits.pullback.fst (a ≫ fZ) ξ)
        (Limits.pullback.snd (a ≫ fZ) ξ ≫ σ)
        (by rw [Category.assoc, hσ]; exact Limits.pullback.condition)) m
  obtain ⟨Ec⟩ := wc_et_zmod_pull_data_exists (π l ≫ Limits.pullback.lift
        (Limits.pullback.fst (W'.obj l).right.hom (Limits.pullback.fst fZ ξ))
        (Limits.pullback.snd (W'.obj l).right.hom (Limits.pullback.fst fZ ξ) ≫ σQ)
        (by rw [Category.assoc, hσQ1]; exact Limits.pullback.condition)) m
  have e1 := wc_et_pull_comp _ (π l) _ rfl Eτ E Ec n y
  have e2 := wc_et_pull_comp (π l) _ _ hint E Ew Ec n y
  have e3 := hfix Ew (wcEtPull E n y)
  have hE : wcEtPull E n (wcEtPull Eτ n y - y) = 0 := by
    rw [map_sub, ← e1, e2, e3, sub_self]

  obtain ⟨l', t, E', hE'⟩ := wc_et_limit_pull_kill_qcqs_all p Λ
    ((W' ⋙ StructuredArrow.proj (Over.mk (wcEtGeomPt Z x)) (Scheme.Etale.forget Z)) ⋙
      wcEtBaseChange (Limits.pullback.fst fZ ξ)) π hπ2 hcT hlimP
    (fun l => by
      haveI := hTaff l
      exact (inferInstance : CompactSpace
        ↥(Limits.pullback (W'.obj l).right.hom (Limits.pullback.fst fZ ξ))))
    (fun l => by
      haveI := hTaff l
      exact (inferInstance : QuasiSeparatedSpace
        ↥(Limits.pullback (W'.obj l).right.hom (Limits.pullback.fst fZ ξ))))
    (fun {l l'} _ => @isAffineHom_of_isAffine _ _ _ (hTaff l) (hTaff l'))
    inferInstance inferInstance m n l (wcEtPull Eτ n y - y) E hE
  exact ⟨l', t, E', hE'⟩

theorem wc_etsm_section_class {Y : Scheme.{u}} {m : ℕ}
    (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing Y m)))
    (Pf : Y.Etale → SheafOfModules.{u+1} (wcEtZModRing Y m))
    (ev : ∀ (V : Y.Etale) (M : SheafOfModules.{u+1} (wcEtZModRing Y m)),
      (Pf V ⟶ M) ≃ M.val.obj (Opposite.op V))
    (hnat : ∀ (V : Y.Etale) (M N : SheafOfModules.{u+1} (wcEtZModRing Y m)) (ψ : M ⟶ N)
      (g : Pf V ⟶ M), ev V N (g ≫ ψ) = (ψ.val.app (Opposite.op V)).hom (ev V M g))
    (hadd : ∀ (V : Y.Etale) (M : SheafOfModules.{u+1} (wcEtZModRing Y m)) (g g' : Pf V ⟶ M),
      ev V M (g + g') = ev V M g + ev V M g')
    (Pm : ∀ (V V' : Y.Etale), (V' ⟶ V) → (Pf V' ⟶ Pf V))
    (hpre : ∀ (V V' : Y.Etale) (b : V' ⟶ V) (M : SheafOfModules.{u+1} (wcEtZModRing Y m))
      (g : Pf V ⟶ M), ev V' M (Pm V V' b ≫ g) = (M.val.map b.op).hom (ev V M g)) (n : ℕ) :
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y m)) := HasExt.standard _
    ∃ cls : ∀ V : Y.Etale, (I.cochainComplex.X (n : ℤ)).val.obj (Opposite.op V) →
        Abelian.Ext (Pf V) (SheafOfModules.unit (wcEtZModRing Y m)) n,
      (∀ (V : Y.Etale) (c c' : (I.cochainComplex.X (n : ℤ)).val.obj (Opposite.op V)),
        ((I.cochainComplex.d (n : ℤ) ((n : ℤ) + 1)).val.app (Opposite.op V)).hom c = 0 →
        ((I.cochainComplex.d (n : ℤ) ((n : ℤ) + 1)).val.app (Opposite.op V)).hom c' = 0 →
        cls V (c - c') = cls V c - cls V c') ∧
      (∀ (V : Y.Etale) (c : (I.cochainComplex.X (n : ℤ)).val.obj (Opposite.op V)),
        ((I.cochainComplex.d (n : ℤ) ((n : ℤ) + 1)).val.app (Opposite.op V)).hom c = 0 →
        (cls V c = 0 ↔ ∃ e : (I.cochainComplex.X ((n : ℤ) - 1)).val.obj (Opposite.op V),
          ((I.cochainComplex.d ((n : ℤ) - 1) (n : ℤ)).val.app (Opposite.op V)).hom e = c)) ∧
      (∀ (V V' : Y.Etale) (b : V' ⟶ V) (c : (I.cochainComplex.X (n : ℤ)).val.obj (Opposite.op V)),
        ((I.cochainComplex.d (n : ℤ) ((n : ℤ) + 1)).val.app (Opposite.op V)).hom c = 0 →
        cls V' (((I.cochainComplex.X (n : ℤ)).val.map b.op).hom c) =
          (Abelian.Ext.mk₀ (Pm V V' b)).comp (cls V c) (zero_add n)) ∧
      (∀ (Φ : SheafOfModules.{u+1} (wcEtZModRing Y m) ⥤ SheafOfModules.{u+1} (wcEtZModRing Y m))
        [Φ.Additive] [Limits.PreservesFiniteLimits Φ] [Limits.PreservesFiniteColimits Φ]
        (e : Φ.obj (SheafOfModules.unit (wcEtZModRing Y m)) ⟶ SheafOfModules.unit (wcEtZModRing Y m))
        (t : (Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex ⟶ I.cochainComplex),
        (Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι' ≫ t =
          (HomologicalComplex.singleMapHomologicalComplex Φ (ComplexShape.up ℤ) 0).hom.app
            (SheafOfModules.unit (wcEtZModRing Y m)) ≫
          (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map e ≫ I.ι' →
        ∀ (V : Y.Etale) (c₀ : Pf V ⟶ Φ.obj (Pf V))
          (c c' : (I.cochainComplex.X (n : ℤ)).val.obj (Opposite.op V)),
        ((I.cochainComplex.d (n : ℤ) ((n : ℤ) + 1)).val.app (Opposite.op V)).hom c = 0 →
        c' = ev V (I.cochainComplex.X (n : ℤ))
          (c₀ ≫ Φ.map ((ev V (I.cochainComplex.X (n : ℤ))).symm c) ≫ t.f (n : ℤ)) →
        cls V c' = (Abelian.Ext.mk₀ c₀).comp
          ((Φ.mapExtAddHom (Pf V) (SheafOfModules.unit (wcEtZModRing Y m)) n (cls V c)).comp
            (Abelian.Ext.mk₀ e) (add_zero n)) (zero_add n)) :=
by
  letI hExt : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y m)) := HasExt.standard _
  classical



  have hL2 : ∀ {X X' : SheafOfModules.{u+1} (wcEtZModRing Y m)} (f : X' ⟶ X)
      (g : X ⟶ I.cochainComplex.X (n : ℤ))
      (hg : g ≫ I.cochainComplex.d (n : ℤ) ((n : ℤ) + 1) = 0)
      (hfg : (f ≫ g) ≫ I.cochainComplex.d (n : ℤ) ((n : ℤ) + 1) = 0),
      I.extEquivCohomologyClass.symm (CochainComplex.HomComplex.CohomologyClass.mk
          (CochainComplex.HomComplex.Cocycle.fromSingleMk (f ≫ g) (zero_add (n : ℤ))
            ((n : ℤ) + 1) rfl hfg)) =
        (Abelian.Ext.mk₀ f).comp (I.extEquivCohomologyClass.symm
          (CochainComplex.HomComplex.CohomologyClass.mk
            (CochainComplex.HomComplex.Cocycle.fromSingleMk g (zero_add (n : ℤ))
              ((n : ℤ) + 1) rfl hg))) (zero_add n) := by
    intro X X' f g hg hfg
    have bridge : ∀ {X₀ : SheafOfModules.{u+1} (wcEtZModRing Y m)}
        (g₀ : X₀ ⟶ I.cochainComplex.X (n : ℤ))
        (hg₀ : g₀ ≫ I.cochainComplex.d (n : ℤ) ((n : ℤ) + 1) = 0),
        ∃ h₀ : (g₀ ≫ (I.cochainComplexXIso (n : ℤ) n rfl).hom) ≫ I.cocomplex.d n (n + 1) = 0,
        I.extEquivCohomologyClass.symm (CochainComplex.HomComplex.CohomologyClass.mk
          (CochainComplex.HomComplex.Cocycle.fromSingleMk g₀ (zero_add (n : ℤ))
            ((n : ℤ) + 1) rfl hg₀)) =
          I.extMk (g₀ ≫ (I.cochainComplexXIso (n : ℤ) n rfl).hom) (n + 1) rfl h₀ := by
      intro X₀ g₀ hg₀
      have hd := I.cochainComplex_d (n : ℤ) ((n : ℤ) + 1) n (n + 1) rfl (by push_cast; rfl)
      have h₀ : (g₀ ≫ (I.cochainComplexXIso (n : ℤ) n rfl).hom) ≫ I.cocomplex.d n (n + 1) = 0 := by
        have h1 : ((g₀ ≫ (I.cochainComplexXIso (n : ℤ) n rfl).hom) ≫ I.cocomplex.d n (n + 1)) ≫
            (I.cochainComplexXIso ((n : ℤ) + 1) (n + 1) (by push_cast; rfl)).inv = 0 := by
          rw [← hg₀, hd]
          simp only [Category.assoc]
        rw [← cancel_mono (I.cochainComplexXIso ((n : ℤ) + 1) (n + 1) (by push_cast; rfl)).inv, h1,
          Limits.zero_comp]
      refine ⟨h₀, ?_⟩
      rw [Equiv.symm_apply_eq, InjectiveResolution.extEquivCohomologyClass_extMk]
      congr 1
      apply CochainComplex.HomComplex.Cocycle.ext
      rw [CochainComplex.HomComplex.Cocycle.fromSingleMk_coe,
        CochainComplex.HomComplex.Cocycle.fromSingleMk_coe]
      congr 1
