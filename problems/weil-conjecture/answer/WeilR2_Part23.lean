        first
          | (simp only [PresheafOfModules.sectionsMk_coe, e1, PresheafOfModules.map_id]; rfl)
          | (rw [PresheafOfModules.sectionsMk_coe, e1, PresheafOfModules.map_id]; rfl)
          | (show (M.val.map (hT.from (Opposite.unop (Opposite.op T))).op).hom x = x
             rw [e1, PresheafOfModules.map_id]; rfl)
          | (show (M.val.map (hT.from (Opposite.unop (Opposite.op T))).op).hom x = x
             rw [e1]; simp)

  refine ⟨fun {E X} f p hp => ?_⟩
  have hepi : Epi ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing S m)).map p) :=
    Functor.map_epi _ p
  have hls : Sheaf.IsLocallySurjective ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing S m)).map p) :=
    (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} _).mpr hepi
  have hsurj := hsurjT _ hls
  obtain ⟨s, hs⟩ := hsurj ((f.val.app (Opposite.op T)).hom
    (1 : (wcEtZModRing S m).obj.obj (Opposite.op T)))
  obtain ⟨f', hf'⟩ := (hbij E).2 s
  refine ⟨f', (hbij X).1 ?_⟩
  show ((f' ≫ p).val.app (Opposite.op T)).hom (1 : (wcEtZModRing S m).obj.obj (Opposite.op T)) =
    (f.val.app (Opposite.op T)).hom (1 : (wcEtZModRing S m).obj.obj (Opposite.op T))
  have hf'' : (f'.val.app (Opposite.op T)).hom
      (1 : (wcEtZModRing S m).obj.obj (Opposite.op T)) = s := hf'
  exact (congrArg (fun z => (p.val.app (Opposite.op T)).hom z) hf'').trans hs

theorem wc_et_tpl_dsl_punct_supp_vanish (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (k : ℕ) (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left
      (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left))
    (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left)
    (hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a)
    (η : (wcP1Over F'').left) (hηb : η ⤳ D.S i (IsLocalRing.closedPoint F''))
    (hηne : η ≠ D.S i (IsLocalRing.closedPoint F''))
    (ξ : Spec (.of (AlgebraicClosure ((wcP1Over F'').left.residueField η))) ⟶ Spec (.of A))
    (hξ : ξ ≫ a = wcEtGeomPt (wcP1Over F'').left η)
    (x : ↥(Limits.pullback D.f a)) (hx : Limits.pullback.fst D.f a x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Limits.pullback D.f a) x))
      (Scheme.Etale.forget (Limits.pullback D.f a)))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ Limits.pullback D.f a)
    (hsh : wcHalShData x B Λ' W'' φ' a')
    (Dh : wcEtPullData (Limits.pullback.fst (Limits.pullback.snd D.f a) ξ) (ℓ ^ k)) (Dg : wcEtPullData (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k))
    (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) ξ) (ℓ ^ k))))
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)))
    (hxs : Limits.pullback.fst (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A) xs = x)
    (Dx : wcEtPullData (wcEtGeomPt (Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)) xs) (ℓ ^ k))
    (Dw : wcEtPullData (Limits.pullback.snd a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (ℓ ^ k)) :
    haveI := Dh.additive
    haveI := Dg.additive
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst (Limits.pullback.snd D.f a) ξ)) _ _ Dh.cont Dh.φ
    haveI : P.Additive := Adjunction.right_adjoint_additive Dh.adj
    let K := (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex
    let Ψ := (Dg.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k)))
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (ℓ ^ k)))
    haveI := Dw.additive
    haveI := Dw.presLim
    haveI := Dw.presColim
    let R := Dw.Φ.mapDerivedCategory
    let Lb := R.obj (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
      (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k)))))
    let Sb := R.obj (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj (wcEtSuppObj Dx)))
    let ub : Lb ⟶ Sb := R.map (DerivedCategory.Q.map ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map (wcEtSuppUnitMap Dx)))
    ∀ (Kp : DerivedCategory (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (ℓ ^ k))))
      (ι : Kp ⟶ Lb) (δ : Sb ⟶ Kp⟦(1 : ℤ)⟧),
      Pretriangulated.Triangle.mk ι ub δ ∈ distTriang _ →
      ∀ (j : ℤ) (f : Kp ⟶ Sb⟦j⟧), f = 0 :=
by
  classical
  intro P K Ψ R Lb Sb ub Kp ι δ hT j f
  haveI := Dh.additive
  haveI := Dg.additive
  haveI := Dw.additive
  haveI := Dw.presLim
  haveI := Dw.presColim
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k)))
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (ℓ ^ k)))

  have t1 : ∀ {𝒞 : Type (u+2)} [Category.{u+1} 𝒞] [Abelian 𝒞] {_hD : HasDerivedCategory.{u+2} 𝒞}
      {Kp L S : DerivedCategory 𝒞} (ι : Kp ⟶ L) (uu : L ⟶ S) (δ : S ⟶ Kp⟦(1 : ℤ)⟧),
      Pretriangulated.Triangle.mk ι uu δ ∈ distTriang _ →
      (∀ g : L ⟶ S, ∃ c : S ⟶ S, g = uu ≫ c) →
      (∀ c : S ⟶ S, uu ≫ c = 0 → c = 0) →
      (∀ k : ℤ, k ≠ 0 → ∀ g : L ⟶ S⟦k⟧, g = 0) →
      (∀ k : ℤ, k ≠ 0 → ∀ c : S ⟶ S⟦k⟧, c = 0) →
      ∀ (k : ℤ) (f : Kp ⟶ S⟦k⟧), f = 0 := by
    intro 𝒞 _ _ _ Kp L S ι uu δ hT hI0 hS0 hL hSS
    have hI : ∀ (k : ℤ) (g : L ⟶ S⟦k⟧), ∃ c : S ⟶ S⟦k⟧, g = uu ≫ c := by
      intro k g
      by_cases hk : k = 0
      · subst hk
        obtain ⟨c₀, hc₀⟩ := hI0 (g ≫ ((shiftFunctorZero (DerivedCategory 𝒞) ℤ).app S).hom)
        refine ⟨c₀ ≫ ((shiftFunctorZero (DerivedCategory 𝒞) ℤ).app S).inv, ?_⟩
        rw [← Category.assoc, ← hc₀, Category.assoc, Iso.hom_inv_id, Category.comp_id]
      · exact ⟨0, by rw [hL k hk g, Limits.comp_zero]⟩
    have hS : ∀ (k : ℤ) (c : S ⟶ S⟦k⟧), uu ≫ c = 0 → c = 0 := by
      intro k c hc
      by_cases hk : k = 0
      · subst hk
        have h1 : c ≫ ((shiftFunctorZero (DerivedCategory 𝒞) ℤ).app S).hom = 0 :=
          hS0 _ (by rw [← Category.assoc, hc, Limits.zero_comp])
        rw [← cancel_mono ((shiftFunctorZero (DerivedCategory 𝒞) ℤ).app S).hom, h1,
          Limits.zero_comp]
      · exact hSS k hk c
    intro k f
    let α := (shiftFunctorAdd' (DerivedCategory 𝒞) k 1 (k + 1) rfl).app S
    have h12 : ι ≫ uu = 0 := Pretriangulated.comp_distTriang_mor_zero₁₂ _ hT
    have h23 : uu ≫ δ = 0 := Pretriangulated.comp_distTriang_mor_zero₂₃ _ hT
    have ha : δ ≫ f⟦(1 : ℤ)⟧' = 0 := by
      have hc := hS (k + 1) (δ ≫ f⟦(1 : ℤ)⟧' ≫ α.inv)
        (by rw [← Category.assoc, h23, Limits.zero_comp])
      have : δ ≫ f⟦(1 : ℤ)⟧' = (δ ≫ f⟦(1 : ℤ)⟧' ≫ α.inv) ≫ α.hom := by
        simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id]
      rw [this, hc, Limits.zero_comp]
    have hrot := Pretriangulated.rot_of_distTriang _ hT
    obtain ⟨g, hg⟩ : ∃ g : L⟦(1 : ℤ)⟧ ⟶ (S⟦k⟧)⟦(1 : ℤ)⟧, f⟦(1 : ℤ)⟧' = (-(ι⟦(1 : ℤ)⟧')) ≫ g :=
      Pretriangulated.Triangle.yoneda_exact₃ _ hrot (f⟦(1 : ℤ)⟧') ha
    have hg' : f⟦(1 : ℤ)⟧' =
        (ι ≫ (-((shiftFunctor (DerivedCategory 𝒞) (1 : ℤ)).preimage g)))⟦(1 : ℤ)⟧' := by
      rw [hg, Functor.map_comp, Functor.map_neg, Functor.map_preimage, Preadditive.comp_neg,
        Preadditive.neg_comp]
    have hf : f = ι ≫ (-((shiftFunctor (DerivedCategory 𝒞) (1 : ℤ)).preimage g)) :=
      (shiftFunctor (DerivedCategory 𝒞) (1 : ℤ)).map_injective hg'
    obtain ⟨c₁, hc₁⟩ := hI k ((shiftFunctor (DerivedCategory 𝒞) (1 : ℤ)).preimage g)
    rw [hf, hc₁, Preadditive.comp_neg, ← Category.assoc, h12, Limits.zero_comp, neg_zero]

  have dlem : ∀ {C₁ C₂ : Type (u+2)} [Category.{u+1} C₁] [Category.{u+1} C₂] [Abelian C₁]
      [Abelian C₂] {_h1 : HasDerivedCategory.{u+2} C₁} {_h2 : HasDerivedCategory.{u+2} C₂}
      (F : C₁ ⥤ C₂) [F.Additive] [Limits.PreservesFiniteLimits F]
      [Limits.PreservesFiniteColimits F] {A B : C₁} (a : A ⟶ B),
      (∀ g : F.obj A ⟶ F.obj B, ∃ c : F.obj B ⟶ F.obj B, g = F.map a ≫ c) →
      (∀ c : F.obj B ⟶ F.obj B, F.map a ≫ c = 0 → c = 0) →
      (∀ g : F.mapDerivedCategory.obj (DerivedCategory.Q.obj
            ((HomologicalComplex.single C₁ (ComplexShape.up ℤ) 0).obj A)) ⟶
          F.mapDerivedCategory.obj (DerivedCategory.Q.obj ((CochainComplex.singleFunctor C₁ 0).obj B)),
        ∃ c : F.mapDerivedCategory.obj (DerivedCategory.Q.obj ((CochainComplex.singleFunctor C₁ 0).obj B)) ⟶
            F.mapDerivedCategory.obj (DerivedCategory.Q.obj ((CochainComplex.singleFunctor C₁ 0).obj B)),
          g = F.mapDerivedCategory.map (DerivedCategory.Q.map ((CochainComplex.singleFunctor C₁ 0).map a)) ≫ c) ∧
      (∀ c : F.mapDerivedCategory.obj (DerivedCategory.Q.obj ((CochainComplex.singleFunctor C₁ 0).obj B)) ⟶
          F.mapDerivedCategory.obj (DerivedCategory.Q.obj ((CochainComplex.singleFunctor C₁ 0).obj B)),
        F.mapDerivedCategory.map (DerivedCategory.Q.map ((CochainComplex.singleFunctor C₁ 0).map a)) ≫ c = 0 →
          c = 0) := by
    intro C₁ C₂ _ _ _ _ _ _ F _ _ _ A B a H1 H2
    let β := F.mapDerivedCategorySingleFunctor 0
    let H := DerivedCategory.singleFunctor C₂ 0
    refine ⟨?_, ?_⟩
    · intro g
      obtain ⟨φ, hφ⟩ := H.map_surjective (β.inv.app A ≫ g ≫ β.hom.app B)
      obtain ⟨c, hc⟩ := H1 φ
      refine ⟨β.hom.app B ≫ H.map c ≫ β.inv.app B, ?_⟩
      have n1 := β.hom.naturality a
      simp only [Functor.comp_map] at n1
      have hg : g = β.hom.app A ≫ H.map φ ≫ β.inv.app B := by
        rw [hφ]
        simp only [Category.assoc, Iso.hom_inv_id_app, Iso.hom_inv_id_app_assoc]
        exact (Category.comp_id g).symm
      rw [hg, hc, H.map_comp, Category.assoc, ← Category.assoc (β.hom.app A), ← n1, Category.assoc]
      rfl
    · intro c hc
      obtain ⟨c', hc'⟩ := H.map_surjective (β.inv.app B ≫ c ≫ β.hom.app B)
      have n2 := β.inv.naturality a
      simp only [Functor.comp_map] at n2
      have h1 : H.map (F.map a ≫ c') = 0 := by
        rw [H.map_comp, hc', ← Category.assoc, n2, Category.assoc]
        have : (DerivedCategory.singleFunctor C₁ 0 ⋙ F.mapDerivedCategory).map a ≫ c = 0 := hc
        simp only [Functor.comp_map] at this
        rw [← Category.assoc ((F.mapDerivedCategory).map _) c, this, Limits.zero_comp,
          Limits.comp_zero]
      have h2 : F.map a ≫ c' = 0 := H.map_injective (by rw [h1, H.map_zero])
      have h3 : c' = 0 := H2 c' h2
      have e : c = β.hom.app B ≫ (β.inv.app B ≫ c ≫ β.hom.app B) ≫ β.inv.app B := by
        simp only [Category.assoc, Iso.hom_inv_id_app, Iso.hom_inv_id_app_assoc]
        exact (Category.comp_id c).symm
      rw [e, ← hc', h3, H.map_zero, Limits.zero_comp, Limits.comp_zero]

  have dvan : ∀ {C₁ C₂ : Type (u+2)} [Category.{u+1} C₁] [Category.{u+1} C₂] [Abelian C₁]
      [Abelian C₂] {_h1 : HasDerivedCategory.{u+2} C₁} {_h2 : HasDerivedCategory.{u+2} C₂}
      (F : C₁ ⥤ C₂) [F.Additive] [Limits.PreservesFiniteLimits F]
      [Limits.PreservesFiniteColimits F] (X Y : C₁) (k : ℤ),
      (k < 0 ∨ (0 < k ∧ Projective (F.obj X))) →
      ∀ f : F.mapDerivedCategory.obj (DerivedCategory.Q.obj ((CochainComplex.singleFunctor C₁ 0).obj X)) ⟶
        (F.mapDerivedCategory.obj (DerivedCategory.Q.obj ((CochainComplex.singleFunctor C₁ 0).obj Y)))⟦k⟧,
        f = 0 := by
    intro C₁ C₂ _ _ _ _ _ _ F _ _ _ X Y k hk f
    let β := F.mapDerivedCategorySingleFunctor 0
    let H := DerivedCategory.singleFunctor C₂ 0
    have van : ∀ (X Y : C₂) (k : ℤ), (k < 0 ∨ (0 < k ∧ Projective X)) →
        ∀ f : H.obj X ⟶ (H.obj Y)⟦k⟧, f = 0 := by
      intro X Y k hk f
      let ε : (H.obj Y)⟦k⟧ ≅ DerivedCategory.Q.obj ((CochainComplex.singleFunctor C₂ (-k)).obj Y) :=
        ((DerivedCategory.singleFunctors C₂).shiftIso k (-k) 0 (by omega)).app Y ≪≫
          (DerivedCategory.singleFunctorIsoCompQ C₂ (-k)).app Y
      suffices h : f ≫ ε.hom = 0 by
        rw [← cancel_mono ε.hom, h, Limits.zero_comp]
      rcases hk with hk | ⟨hk, hP⟩
      · have hsub := DerivedCategory.subsingleton_hom_of_isStrictlyLE_of_isStrictlyGE
          ((CochainComplex.singleFunctor C₂ 0).obj X)
          ((CochainComplex.singleFunctor C₂ (-k)).obj Y) 0 (-k) (by omega)
        exact @Subsingleton.elim _ hsub _ _
      · exact DerivedCategory.from_singleFunctor_obj_eq_zero_of_projective (P := X) (i := 0) _
          (-k) (by omega)
    have h0 := van (F.obj X) (F.obj Y) k (by
        rcases hk with hk | ⟨hk, hP⟩
        · exact Or.inl hk
        · exact Or.inr ⟨hk, hP⟩)
      (β.inv.app X ≫ f ≫ (β.hom.app Y)⟦k⟧')
    have e : f = β.hom.app X ≫ (β.inv.app X ≫ f ≫ (β.hom.app Y)⟦k⟧') ≫ (β.inv.app Y)⟦k⟧' := by
      simp only [Category.assoc, Iso.hom_inv_id_app_assoc]
      rw [← CategoryTheory.Functor.map_comp, Iso.hom_inv_id_app]
      erw [CategoryTheory.Functor.map_id, Category.comp_id]
    rw [e, h0, Limits.zero_comp, Limits.comp_zero]

  have fin : ∀ {𝒞 𝒞W : Type (u+2)} [Category.{u+1} 𝒞] [Category.{u+1} 𝒞W] [Abelian 𝒞]
      [Abelian 𝒞W] {_hD : HasDerivedCategory.{u+2} 𝒞} {_hDW : HasDerivedCategory.{u+2} 𝒞W}
      (Φ : 𝒞 ⥤ 𝒞W) [Φ.Additive] [Limits.PreservesFiniteLimits Φ]
      [Limits.PreservesFiniteColimits Φ] (One Sx : 𝒞) (ub0 : One ⟶ Sx),
      (∀ g : Φ.obj One ⟶ Φ.obj Sx, ∃ c : Φ.obj Sx ⟶ Φ.obj Sx, g = Φ.map ub0 ≫ c) →
      (∀ c : Φ.obj Sx ⟶ Φ.obj Sx, Φ.map ub0 ≫ c = 0 → c = 0) →
      Projective (Φ.obj One) →
      (∀ k : ℤ, 0 < k → ∀ c : Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
            ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj Sx)) ⟶
          (Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
            ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj Sx)))⟦k⟧, c = 0) →
