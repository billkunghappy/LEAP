  erw [he _ _ ((wcEtqmtBeta p a b hab).app ((wcEtBaseChange f).obj V))]
  erw [L1 ((wcEtBaseChange p).obj ((wcEtBaseChange f).obj V)) s]
  rw [← chase]
  exact congrArg (e ((wcEtBaseChange p).obj ((wcEtBaseChange f).obj V)) s)
    ((Scheme.Hom.comp_apply ((wcEtBaseChange p).map ((wcEtqmtAlpha f b hb).app V)).left
        (((wcEtqmtBeta p a b hab).app ((wcEtBaseChange f).obj V)).left ≫
          Limits.pullback.fst (Limits.pullback.snd (Limits.pullback.snd V.hom f) p) a) z).trans
      (Scheme.Hom.comp_apply ((wcEtqmtBeta p a b hab).app ((wcEtBaseChange f).obj V)).left
          (Limits.pullback.fst (Limits.pullback.snd (Limits.pullback.snd V.hom f) p) a)
          (((wcEtBaseChange p).map ((wcEtqmtAlpha f b hb).app V)).left z))).symm

theorem wc_etqmtx1_kummer_exists_gen {A B L : Type u} [CommRing A] [CommRing B] [Field L]
    {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {φA : A →+* L} {σ : L →+* L} {XE : Scheme.{u}}
    {p : XE ⟶ Spec (.of B)} {q : XE ⟶ Spec (.of L)} {w : XE ⟶ XE} {x₀ : B}
    (T : wcQmtmTower ℓ φA σ p q w x₀) {E : Scheme.{u}} (sE : E ⟶ XE)
    (v : ℕ → Γ(E, ⊤)) (hv : ∀ k, v (k + 1) ^ ℓ = v k) (hvu : IsUnit (v 0))
    (hv0 : v 0 = sE.appTop.hom (p.appTop.hom ((Scheme.ΓSpecIso (.of B)).inv.hom x₀))) :
    ∃ sc : ℤ_[ℓ] → (E ⟶ Limits.pullback sE T.πi),
      (∀ a : ℤ_[ℓ], sc a ≫ Limits.pullback.fst sE T.πi = 𝟙 _) ∧
      ∀ (a : ℤ_[ℓ]) (m k : ℕ) (c : L),
        (sc a ≫ Limits.pullback.snd sE T.πi ≫ T.gi).appTop.hom
          ((Scheme.ΓSpecIso (.of (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))).inv.hom
            (AddMonoidAlgebra.single
              (Localization.mk (m : ℤ) ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) c)) =
          (sE ≫ q).appTop.hom ((Scheme.ΓSpecIso (.of L)).inv.hom c) *
            ((sE ≫ q).appTop.hom ((Scheme.ΓSpecIso (.of L)).inv.hom (T.ζ k)) ^
              (PadicInt.toZModPow k a).val * v k) ^ m :=
by
  classical
  have hp : Nat.Prime ℓ := Fact.out
  have hℓ0 : ℓ ≠ 0 := hp.ne_zero
  have hnat : ∀ {R S : CommRingCat.{u}} (f : R ⟶ S) (y : R),
      (Spec.map f).appTop.hom ((Scheme.ΓSpecIso R).inv.hom y) =
        (Scheme.ΓSpecIso S).inv.hom (f.hom y) := by
    intro R S f y
    have h2 := congrArg (fun k => k.hom y) (Scheme.ΓSpecIso_inv_naturality f)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h2
    exact h2.symm

  obtain ⟨φL, hφL⟩ : ∃ φL : L →+* Γ(E, ⊤), ∀ c : L,
      φL c = (sE ≫ q).appTop.hom
        ((Scheme.ΓSpecIso (CommRingCat.of L)).inv.hom c) :=
    ⟨(sE ≫ q).appTop.hom.comp
      (Scheme.ΓSpecIso (CommRingCat.of L)).inv.hom, fun _ => rfl⟩

  have hvU : ∀ k, IsUnit (v k) := by
    intro k
    induction k with
    | zero => exact hvu
    | succ k ih => exact (isUnit_pow_iff hℓ0).mp (by rw [hv k]; exact ih)
  have hζU : ∀ k, IsUnit (T.ζ k) := fun k => (T.hζ k).isUnit (pow_ne_zero k hℓ0)

  have htw : ∀ (a : ℤ_[ℓ]) (k : ℕ), (T.ζ (k + 1) ^ (PadicInt.toZModPow (k + 1) a).val) ^ ℓ =
      T.ζ k ^ (PadicInt.toZModPow k a).val := by
    intro a k
    haveI : NeZero (ℓ ^ (k + 1)) := ⟨pow_ne_zero _ hℓ0⟩
    have hmod : (PadicInt.toZModPow (k + 1) a).val % ℓ ^ k = (PadicInt.toZModPow k a).val := by
      have h1 := RingHom.congr_fun
        (PadicInt.zmod_cast_comp_toZModPow (p := ℓ) k (k + 1) (Nat.le_succ k)) a
      rw [RingHom.comp_apply, ZMod.castHom_apply, ZMod.cast_eq_val] at h1
      rw [← h1, ZMod.val_natCast]
    rw [← pow_mul, mul_comm, pow_mul, T.hζc,
      pow_eq_pow_mod (PadicInt.toZModPow (k + 1) a).val (T.hζ k).pow_eq_one, hmod]
  have htw0 : ∀ a : ℤ_[ℓ], T.ζ 0 ^ (PadicInt.toZModPow 0 a).val = 1 := by
    intro a
    have h := T.hζ 0
    rw [pow_zero, IsPrimitiveRoot.one_right_iff] at h
    rw [h, one_pow]

  obtain ⟨uu, huu⟩ : ∃ uu : ℤ_[ℓ] → ℕ → (Γ(E, ⊤))ˣ, ∀ a k,
      (uu a k : Γ(E, ⊤)) =
        φL (T.ζ k ^ (PadicInt.toZModPow k a).val) * v k :=
    ⟨fun a k => ((((hζU k).pow (PadicInt.toZModPow k a).val).map φL).mul (hvU k)).unit,
      fun a k => IsUnit.unit_spec _⟩
  have hstep : ∀ a k, uu a (k + 1) ^ ℓ = uu a k := by
    intro a k
    apply Units.ext
    rw [Units.val_pow_eq_pow_val, huu, huu, mul_pow, ← map_pow, htw, hv]
  have huu0 : ∀ a, (uu a 0 : Γ(E, ⊤)) = v 0 := by
    intro a
    rw [huu, htw0, map_one, one_mul]

  have hchar : ∀ u' : ℕ → (Γ(E, ⊤))ˣ, (∀ k, u' (k + 1) ^ ℓ = u' k) →
      ∃ χ : Multiplicative (Localization.Away (ℓ : ℤ)) →* (Γ(E, ⊤))ˣ,
        ∀ (a : ℤ) (k : ℕ), χ (Multiplicative.ofAdd
          (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ))) = u' k ^ a := by
    intro u' hs'
    have hK : ∀ k j, u' (k + j) ^ (ℓ ^ j) = u' k := by
      intro k j
      induction j with
      | zero => simp
      | succ j ih =>
        rw [← ih, ← add_assoc, pow_succ', pow_mul, hs']
    have hKz : ∀ k j (a : ℤ), u' (k + j) ^ ((ℓ : ℤ) ^ j * a) = u' k ^ a := by
      intro k j a
      have h : ((ℓ : ℤ) ^ j) = ((ℓ ^ j : ℕ) : ℤ) := by push_cast; rfl
      rw [zpow_mul, h, zpow_natCast, hK]
    have huniq : ∀ m n : ℕ, (ℓ : ℤ) ^ m = (ℓ : ℤ) ^ n → m = n := by
      intro m n h
      have h' : ℓ ^ m = ℓ ^ n := by exact_mod_cast h
      exact Nat.pow_right_injective hp.two_le h'
    let ex : Submonoid.powers (ℓ : ℤ) → ℕ := fun s =>
      Classical.choose ((Submonoid.mem_powers_iff _ _).mp s.2)
    have he : ∀ s, (ℓ : ℤ) ^ (ex s) = s := fun s =>
      Classical.choose_spec ((Submonoid.mem_powers_iff _ _).mp s.2)
    have hek : ∀ k : ℕ, ex ⟨(ℓ : ℤ) ^ k, k, rfl⟩ = k := fun k => huniq _ _ (he _)
    let f : ℤ → Submonoid.powers (ℓ : ℤ) → (Γ(E, ⊤))ˣ :=
      fun a s => u' (ex s) ^ a
    have H : ∀ {a c : ℤ} {b d : Submonoid.powers (ℓ : ℤ)},
        (Localization.r (Submonoid.powers (ℓ : ℤ))) (a, b) (c, d) → f a b = f c d := by
      intro a c b d hr
      rw [Localization.r_iff_exists] at hr
      obtain ⟨m, hm⟩ := hr
      have hm0 : (m : ℤ) ≠ 0 := by
        rw [← he m]; exact pow_ne_zero _ (by exact_mod_cast hℓ0)
      have h2 : (d : ℤ) * a = (b : ℤ) * c := mul_left_cancel₀ hm0 hm
      rw [← he b, ← he d] at h2
      show u' (ex b) ^ a = u' (ex d) ^ c
      rw [← hKz (ex b) (ex d) a, h2, add_comm, hKz]
    let χf : Multiplicative (Localization.Away (ℓ : ℤ)) → (Γ(E, ⊤))ˣ :=
      fun x => Localization.liftOn (Multiplicative.toAdd x) f H
    have hχf : ∀ a s, χf (Multiplicative.ofAdd (Localization.mk a s)) = u' (ex s) ^ a := by
      intro a s
      show Localization.liftOn (Localization.mk a s) f H = _
      rw [Localization.liftOn_mk]
    refine ⟨{ toFun := χf, map_one' := ?_, map_mul' := ?_ }, ?_⟩
    · show Localization.liftOn (0 : Localization.Away (ℓ : ℤ)) f H = 1
      rw [← Localization.mk_zero 1, Localization.liftOn_mk]
      simp [f]
    · intro x y
      show Localization.liftOn (Multiplicative.toAdd x + Multiplicative.toAdd y) f H =
        Localization.liftOn (Multiplicative.toAdd x) f H *
          Localization.liftOn (Multiplicative.toAdd y) f H
      generalize Multiplicative.toAdd x = X
      generalize Multiplicative.toAdd y = Y
      induction X using Localization.induction_on with
      | H p' =>
        induction Y using Localization.induction_on with
        | H p'' =>
          obtain ⟨a, s⟩ := p'
          obtain ⟨b, t⟩ := p''
          rw [Localization.add_mk, Localization.liftOn_mk, Localization.liftOn_mk,
            Localization.liftOn_mk]
          have hst : ex (s * t) = ex s + ex t := by
            apply huniq
            rw [he, pow_add, he, he, Submonoid.coe_mul]
          show u' (ex (s * t)) ^ ((s : ℤ) * b + (t : ℤ) * a) = u' (ex s) ^ a * u' (ex t) ^ b
          rw [hst, zpow_add, ← he s, ← he t, hKz, add_comm (ex s) (ex t), hKz, mul_comm]
    · intro a k
      show χf (Multiplicative.ofAdd (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩)) = _
      rw [hχf, hek]

  have hι : ∀ (n : ℤ) (c : L), (AddMonoidAlgebra.mapDomainRingHom L
      (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom) (AddMonoidAlgebra.single n c) =
      AddMonoidAlgebra.single (algebraMap ℤ (Localization.Away (ℓ : ℤ)) n) c := by
    intro n c
    rw [AddMonoidAlgebra.mapDomainRingHom_apply, AddMonoidAlgebra.mapDomain_single]
    rfl
  have hstar : ∀ y : L, T.g₀.appTop.hom
      ((Scheme.ΓSpecIso (CommRingCat.of (LaurentPolynomial L))).inv.hom
        (LaurentPolynomial.C y)) =
      q.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of L)).inv.hom y) := by
    intro y
    have h1 := congrArg (fun k => k.hom ((Scheme.ΓSpecIso (CommRingCat.of L)).inv.hom y))
      (congrArg Scheme.Hom.appTop T.hg₀q)
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at h1
    rw [hnat, CommRingCat.hom_ofHom] at h1
    exact h1
  have hlext : ∀ (f₁ f₂ : LaurentPolynomial L →+* Γ(E, ⊤)),
      (∀ r, f₁ (LaurentPolynomial.C r) = f₂ (LaurentPolynomial.C r)) →
      f₁ (LaurentPolynomial.T 1) = f₂ (LaurentPolynomial.T 1) → f₁ = f₂ := by
    intro f₁ f₂ hC hT
    have hTm : f₁ (LaurentPolynomial.T (-1)) = f₂ (LaurentPolynomial.T (-1)) := by
      have e : (LaurentPolynomial.T 1 : LaurentPolynomial L) * LaurentPolynomial.T (-1) = 1 := by
        rw [← LaurentPolynomial.T_add]; simp
      have e1 := congrArg f₁ e
      have e2 := congrArg f₂ e
      rw [map_mul, map_one] at e1 e2
      calc f₁ (LaurentPolynomial.T (-1))
          = f₁ (LaurentPolynomial.T (-1)) *
              (f₂ (LaurentPolynomial.T 1) * f₂ (LaurentPolynomial.T (-1))) := by
            rw [e2, mul_one]
        _ = (f₁ (LaurentPolynomial.T 1) * f₁ (LaurentPolynomial.T (-1))) *
              f₂ (LaurentPolynomial.T (-1)) := by
            rw [← hT]; ring
        _ = f₂ (LaurentPolynomial.T (-1)) := by rw [e1, one_mul]
    apply AddMonoidAlgebra.ringHom_ext
    · intro r; exact hC r
    · intro m
      show f₁ (LaurentPolynomial.T m) = f₂ (LaurentPolynomial.T m)
      rcases Int.eq_nat_or_neg m with ⟨n, rfl | rfl⟩
      · have : (LaurentPolynomial.T (n : ℤ) : LaurentPolynomial L) =
            LaurentPolynomial.T 1 ^ n := by
          rw [LaurentPolynomial.T_pow]; simp
        rw [this, map_pow, map_pow, hT]
      · have : (LaurentPolynomial.T (-(n : ℤ)) : LaurentPolynomial L) =
            LaurentPolynomial.T (-1) ^ n := by
          rw [LaurentPolynomial.T_pow]; simp
        rw [this, map_pow, map_pow, hTm]
  have hm : algebraMap ℤ (Localization.Away (ℓ : ℤ)) 1 =
      Localization.mk 1 (⟨(ℓ : ℤ) ^ 0, 0, rfl⟩ : Submonoid.powers (ℓ : ℤ)) := by
    rw [← Localization.mk_one_eq_algebraMap]
    exact congrArg (Localization.mk 1) (Subtype.ext (by simp))

  have hsec : ∀ a : ℤ_[ℓ], ∃ s : E ⟶ Limits.pullback sE T.πi,
      s ≫ Limits.pullback.fst sE T.πi = 𝟙 _ ∧
      ∀ (m k : ℕ) (c : L),
        (s ≫ Limits.pullback.snd sE T.πi ≫ T.gi).appTop.hom
          ((Scheme.ΓSpecIso (.of (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))).inv.hom
            (AddMonoidAlgebra.single
              (Localization.mk (m : ℤ) ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) c)) =
        φL c * (φL (T.ζ k) ^ (PadicInt.toZModPow k a).val * v k) ^ m := by
    intro a
    obtain ⟨χ, hχ⟩ := hchar (uu a) (hstep a)
    obtain ⟨ψ, hψ⟩ : ∃ ψ : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) →+* Γ(E, ⊤),
        ∀ (x : Localization.Away (ℓ : ℤ)) (c : L), ψ (AddMonoidAlgebra.single x c) =
          φL c * ((χ (Multiplicative.ofAdd x) : (Γ(E, ⊤))ˣ) : Γ(E, ⊤)) :=
      ⟨AddMonoidAlgebra.liftNCRingHom φL ((Units.coeHom _).comp χ) (fun _ _ => Commute.all _ _),
        fun x c => by rw [AddMonoidAlgebra.liftNCRingHom_single]; rfl⟩
    have hτ : ∀ y : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)),
        (E.toSpecΓ ≫ Spec.map (CommRingCat.ofHom ψ)).appTop.hom
          ((Scheme.ΓSpecIso (.of (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))).inv.hom y) =
        ψ y := by
      intro y
      rw [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply, hnat,
        CommRingCat.hom_ofHom, Scheme.toSpecΓ_appTop]
      have h := congrArg (fun f => CommRingCat.Hom.hom f (ψ y))
        (Scheme.ΓSpecIso Γ(E, ⊤)).inv_hom_id
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_id,
        RingHom.id_apply] at h
      exact h
    have hw : sE ≫ T.g₀ =
        (E.toSpecΓ ≫ Spec.map (CommRingCat.ofHom ψ)) ≫
          Spec.map (CommRingCat.ofHom (AddMonoidAlgebra.mapDomainRingHom L
            (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom)) := by
      apply ext_of_isAffine
      rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop,
        Scheme.toSpecΓ_appTop, Scheme.ΓSpecIso_naturality,
        reassoc_of% (Scheme.ΓSpecIso_naturality (CommRingCat.ofHom
          (AddMonoidAlgebra.mapDomainRingHom L
            (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom)))]
      rw [← cancel_epi (Scheme.ΓSpecIso (CommRingCat.of (LaurentPolynomial L))).inv,
        Iso.inv_hom_id_assoc]
      apply CommRingCat.hom_ext
      apply hlext
      · intro c
        simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom]
        rw [hstar, ← LaurentPolynomial.single_eq_C, hι, map_zero, hψ, ofAdd_zero, map_one,
          Units.val_one, mul_one, hφL, Scheme.Hom.comp_appTop, CommRingCat.hom_comp,
          RingHom.comp_apply]
      · simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom]
        rw [T.hg₀T, show (LaurentPolynomial.T 1 : LaurentPolynomial L) =
          AddMonoidAlgebra.single 1 1 from rfl, hι, hm, hψ, hχ, zpow_one, map_one, one_mul,
          huu0, hv0]
    refine ⟨Limits.pullback.lift (𝟙 _) (T.hT.lift _ _ hw)
      (by rw [Category.id_comp, T.hT.lift_fst]), Limits.pullback.lift_fst _ _ _,
      fun m k c => ?_⟩
    rw [Limits.pullback.lift_snd_assoc, T.hT.lift_snd, hτ, hψ, hχ, zpow_natCast,
      Units.val_pow_eq_pow_val, huu, map_pow]

  choose sc hsc1 hsc2 using hsec
  refine ⟨sc, hsc1, fun a m k c => ?_⟩
  rw [hsc2 a m k c, hφL c, hφL (T.ζ k)]

theorem wc_etqmtx1_kummer_points_gen {A B L : Type u} [CommRing A] [CommRing B] [Field L]
    {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {φA : A →+* L} {σ : L →+* L} {XE : Scheme.{u}}
    {p : XE ⟶ Spec (.of B)} {q : XE ⟶ Spec (.of L)} {w : XE ⟶ XE} {x₀ : B}
    (T : wcQmtmTower ℓ φA σ p q w x₀) {E : Scheme.{u}} (sE : E ⟶ XE)
    (v : ℕ → Γ(E, ⊤)) (hv : ∀ k, v (k + 1) ^ ℓ = v k) (hvu : IsUnit (v 0))
    (hv0 : v 0 = sE.appTop.hom (p.appTop.hom ((Scheme.ΓSpecIso (.of B)).inv.hom x₀)))
    (sc : ℤ_[ℓ] → (E ⟶ Limits.pullback sE T.πi))
    (hsc1 : ∀ a : ℤ_[ℓ], sc a ≫ Limits.pullback.fst sE T.πi = 𝟙 _)
    (hsc2 : ∀ (a : ℤ_[ℓ]) (m k : ℕ) (c : L),
        (sc a ≫ Limits.pullback.snd sE T.πi ≫ T.gi).appTop.hom
          ((Scheme.ΓSpecIso (.of (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))).inv.hom
            (AddMonoidAlgebra.single
              (Localization.mk (m : ℤ) ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) c)) =
          (sE ≫ q).appTop.hom ((Scheme.ΓSpecIso (.of L)).inv.hom c) *
            ((sE ≫ q).appTop.hom ((Scheme.ΓSpecIso (.of L)).inv.hom (T.ζ k)) ^
              (PadicInt.toZModPow k a).val * v k) ^ m) :
    ∀ x : ↥(Limits.pullback sE T.πi), ∃ a : ℤ_[ℓ],
      x = (sc a).base.hom ((Limits.pullback.fst sE T.πi).base.hom x) :=
by
  classical
  have hℓ0 : ℓ ≠ 0 := (Fact.out : ℓ.Prime).ne_zero

  have padic : ∀ (x : ∀ m : ℕ, ZMod (ℓ ^ m)),
      (∀ m : ℕ, ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ m)) (ZMod (ℓ ^ m)) (x (m + 1)) = x m) →
      ∃ z : ℤ_[ℓ], ∀ m : ℕ, PadicInt.toZModPow m z = x m := by
    intro x hx
    let S : Subring (∀ m : ℕ, ZMod (ℓ ^ m)) :=
      { carrier := {y | ∀ m : ℕ,
          ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ m)) (ZMod (ℓ ^ m)) (y (m + 1)) = y m}
        mul_mem' := by
          intro a b ha hb m
          simp only [Set.mem_setOf_eq] at ha hb
          simp only [Pi.mul_apply, map_mul, ha m, hb m]
        one_mem' := by
          intro m
          simp only [Pi.one_apply, map_one]
        add_mem' := by
          intro a b ha hb m
          simp only [Set.mem_setOf_eq] at ha hb
          simp only [Pi.add_apply, map_add, ha m, hb m]
        zero_mem' := by
          intro m
          simp only [Pi.zero_apply, map_zero]
        neg_mem' := by
          intro a ha m
          simp only [Set.mem_setOf_eq] at ha
          simp only [Pi.neg_apply, map_neg, ha m] }
    let f : ∀ k : ℕ, S →+* ZMod (ℓ ^ k) := fun k =>
      (Pi.evalRingHom (fun m : ℕ => ZMod (ℓ ^ m)) k).comp S.subtype
    have hf : ∀ k (y : S), f k y = (y : ∀ m : ℕ, ZMod (ℓ ^ m)) k := fun k y => rfl
    have compat : ∀ k1 k2 (hk : k1 ≤ k2),
        (ZMod.castHom (pow_dvd_pow ℓ hk) (ZMod (ℓ ^ k1))).comp (f k2) = f k1 := by
      intro k1 k2 hk
      induction k2, hk using Nat.le_induction with
      | base =>
        ext y
        rw [RingHom.comp_apply, hf, ZMod.castHom_apply]
        exact ZMod.cast_id _ _
      | succ k2 hk ih =>
        ext y
        have hy : ∀ m : ℕ, ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ m)) (ZMod (ℓ ^ m))
            ((y : ∀ m : ℕ, ZMod (ℓ ^ m)) (m + 1)) = (y : ∀ m : ℕ, ZMod (ℓ ^ m)) m := y.2
        have h1 := congrArg (fun g => g y) ih
        simp only [RingHom.comp_apply, hf] at h1
        rw [RingHom.comp_apply, hf, hf, ← h1, ← hy k2]
        exact (RingHom.congr_fun (ZMod.castHom_comp (pow_dvd_pow ℓ hk)
          (pow_dvd_pow ℓ (Nat.le_succ k2))) _).symm
    refine ⟨PadicInt.lift compat ⟨x, hx⟩, fun m => ?_⟩
    have h := congrArg (fun g => g (⟨x, hx⟩ : S)) (PadicInt.lift_spec compat m)
    simpa only [RingHom.comp_apply, hf] using h

  have s4 : ∀ (K : Type u) [Field K] (ξ ν τ : ℕ → K), (∀ k, IsPrimitiveRoot (ξ k) (ℓ ^ k)) →
      (∀ k, ξ (k + 1) ^ ℓ = ξ k) → (∀ k, ν (k + 1) ^ ℓ = ν k) → ν 0 ≠ 0 →
      (∀ k, τ (k + 1) ^ ℓ = τ k) → τ 0 = ν 0 →
      ∃ a : ℤ_[ℓ], ∀ k, τ k = ξ k ^ (PadicInt.toZModPow k a).val * ν k := by
    intro K _ ξ ν τ hξ hξc hν hν0 hτ hτ0
    have hνne : ∀ k, ν k ≠ 0 := by
      intro k
      induction k with
      | zero => exact hν0
      | succ k ih => intro h; apply ih; rw [← hν k, h, zero_pow hℓ0]
    obtain ⟨u, hu⟩ : ∃ u : ℕ → K, ∀ k, u k = τ k * (ν k)⁻¹ := ⟨_, fun k => rfl⟩
    have hu1 : ∀ k, u (k + 1) ^ ℓ = u k := by
      intro k
      rw [hu, hu, mul_pow, inv_pow, hτ, hν]
    have hu0 : u 0 = 1 := by rw [hu, hτ0]; exact mul_inv_cancel₀ hν0
    have hroot : ∀ k, u k ^ (ℓ ^ k) = 1 := by
      intro k
      induction k with
      | zero => rw [pow_zero, pow_one, hu0]
      | succ k ih => rw [pow_succ' ℓ k, pow_mul, hu1, ih]
    have hex : ∀ k, ∃ c < ℓ ^ k, ξ k ^ c = u k := by
      intro k
      haveI : NeZero (ℓ ^ k) := ⟨pow_ne_zero k hℓ0⟩
      exact (hξ k).eq_pow_of_pow_eq_one (hroot k)
    choose c hc hcu using hex
    have hcompat : ∀ k, c (k + 1) % ℓ ^ k = c k := by
      intro k
      have hpos : 0 < ℓ ^ k := pow_pos (Nat.pos_of_ne_zero hℓ0) k
      apply (hξ k).pow_inj (Nat.mod_lt _ hpos) (hc k)
      have h1 : ξ k ^ (c (k + 1) % ℓ ^ k) = ξ k ^ c (k + 1) := by
        rw [(hξ k).eq_orderOf, pow_mod_orderOf]
      have h2 : ξ k ^ c (k + 1) = ξ k ^ c k := by
        rw [hcu k, ← hξc k, ← pow_mul, mul_comm, pow_mul, hcu (k + 1), hu1]
      exact h1.trans h2
    obtain ⟨z, hz⟩ := padic (fun m => (c m : ZMod (ℓ ^ m))) (fun m => by
      show ZMod.castHom _ (ZMod (ℓ ^ m)) ((c (m + 1) : ZMod (ℓ ^ (m + 1)))) = (c m : ZMod (ℓ ^ m))
      rw [map_natCast, ← hcompat m, ZMod.natCast_mod])
    have hz' : ∀ m, (PadicInt.toZModPow m z).val = c m := fun m => by
      rw [hz m]; exact ZMod.val_cast_of_lt (hc m)
    refine ⟨z, fun k => ?_⟩
    rw [hz' k, hcu k, hu]
    exact (inv_mul_cancel_right₀ (hνne k) (τ k)).symm

  have hpowG : ∀ (m k : ℕ), (AddMonoidAlgebra.single
      (Localization.mk (m : ℤ) ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) (1 : L)) =
      (AddMonoidAlgebra.single
      (Localization.mk (1 : ℤ) ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) (1 : L)) ^ m := by
    intro m k
    induction m with
    | zero => rw [pow_zero, Nat.cast_zero, Localization.mk_zero, AddMonoidAlgebra.one_def]
    | succ m ih =>
      rw [pow_succ, ← ih, AddMonoidAlgebra.single_mul_single, Localization.add_mk_self, mul_one,
        Nat.cast_succ]
  have hℓG : ∀ k : ℕ, (AddMonoidAlgebra.single
      (Localization.mk (1 : ℤ) ⟨(ℓ : ℤ) ^ (k + 1), k + 1, rfl⟩ : Localization.Away (ℓ : ℤ))
        (1 : L)) ^ ℓ =
      AddMonoidAlgebra.single
      (Localization.mk (1 : ℤ) ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) (1 : L) := by
    intro k
    rw [← hpowG ℓ (k + 1)]
    congr 1
    rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    exact ⟨1, by simp [pow_succ]⟩
  have h0G : (AddMonoidAlgebra.single
      (Localization.mk (1 : ℤ) ⟨(ℓ : ℤ) ^ 0, 0, rfl⟩ : Localization.Away (ℓ : ℤ)) (1 : L)) =
      AddMonoidAlgebra.mapDomainRingHom L (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom
        (LaurentPolynomial.T 1) := by
    have e1 : (LaurentPolynomial.T 1 : LaurentPolynomial L) =
        AddMonoidAlgebra.single (1 : ℤ) (1 : L) := rfl
    rw [e1, AddMonoidAlgebra.mapDomainRingHom_apply, AddMonoidAlgebra.mapDomain_single]
    congr 1
  have hCG : ∀ c : L, AddMonoidAlgebra.single (0 : Localization.Away (ℓ : ℤ)) c =
      AddMonoidAlgebra.mapDomainRingHom L (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom
        (LaurentPolynomial.C c) := by
    intro c
    rw [← LaurentPolynomial.single_eq_C, AddMonoidAlgebra.mapDomainRingHom_apply,
      AddMonoidAlgebra.mapDomain_single]
    simp
  have hsplit : ∀ (m k : ℕ) (c : L), (AddMonoidAlgebra.single
      (Localization.mk (m : ℤ) ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) c) =
      AddMonoidAlgebra.single (0 : Localization.Away (ℓ : ℤ)) c * AddMonoidAlgebra.single
      (Localization.mk (m : ℤ) ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) (1 : L) := by
    intro m k c
    rw [AddMonoidAlgebra.single_mul_single, zero_add, mul_one]

  have inv_trick : ∀ {R S : Type u} [CommRing R] [CommRing S] (F F' : R →+* S) (a b : R),
      a * b = 1 → F b = F' b → F a = F' a := by
    intro R S _ _ F F' a b hab hb
    have h1 : F' b * F' a = 1 := by rw [← map_mul, mul_comm, hab, map_one]
    have h2 : F a * F b = 1 := by rw [← map_mul, hab, map_one]
    calc F a = F a * (F' b * F' a) := by rw [h1, mul_one]
      _ = (F a * F b) * F' a := by rw [hb]; ring
      _ = F' a := by rw [h2, one_mul]
  have ghom_ext : ∀ {S : Type u} [CommRing S]
      (F F' : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) →+* S),
      (∀ (m k : ℕ) (c : L), F (AddMonoidAlgebra.single
          (Localization.mk (m : ℤ) ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) c) =
        F' (AddMonoidAlgebra.single
          (Localization.mk (m : ℤ) ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) c)) →
      F = F' := by
    intro S _ F F' h
    apply AddMonoidAlgebra.ringHom_ext
    · intro r
      have e0 : (0 : Localization.Away (ℓ : ℤ)) =
          (Localization.mk ((0 : ℕ) : ℤ) ⟨(ℓ : ℤ) ^ 0, 0, rfl⟩ : Localization.Away (ℓ : ℤ)) := by
        rw [Nat.cast_zero, Localization.mk_zero]
      rw [e0]
      exact h 0 0 r
    · intro x
      refine Localization.induction_on x (fun y => ?_)
      obtain ⟨n, s, k, rfl⟩ := y
      obtain ⟨m, rfl | rfl⟩ := Int.eq_nat_or_neg n
      · exact h m k 1
      · show F (AddMonoidAlgebra.single
            (Localization.mk (-(m : ℤ)) ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) 1) =
          F' (AddMonoidAlgebra.single
            (Localization.mk (-(m : ℤ)) ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) 1)
        apply inv_trick F F' _ (AddMonoidAlgebra.single
          (Localization.mk (m : ℤ) ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) (1 : L))
        · rw [AddMonoidAlgebra.single_mul_single, Localization.add_mk_self, neg_add_cancel,
            Localization.mk_zero, mul_one, AddMonoidAlgebra.one_def]
        · exact h m k 1

  have bridge : ∀ y : LaurentPolynomial L,
      T.gi.appTop.hom ((Scheme.ΓSpecIso (.of (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))).inv.hom
        (AddMonoidAlgebra.mapDomainRingHom L (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom
          y)) =
      T.πi.appTop.hom (T.g₀.appTop.hom ((Scheme.ΓSpecIso (.of (LaurentPolynomial L))).inv.hom y)) := by
    intro y
    have h1 := congrArg (fun f => f.hom y) (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom
      (AddMonoidAlgebra.mapDomainRingHom L (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom)))
    have h2 := congrArg (fun f => (Scheme.Hom.appTop f).hom
      ((Scheme.ΓSpecIso (.of (LaurentPolynomial L))).inv.hom y)) T.hT.toCommSq.w
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom,
      Scheme.Hom.comp_appTop] at h1 h2
    rw [h1, ← h2]
  obtain ⟨τ, hτdef⟩ : ∃ τ : ℕ → Γ(T.XEi, ⊤), ∀ k, τ k = T.gi.appTop.hom
      ((Scheme.ΓSpecIso (.of (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))).inv.hom
        (AddMonoidAlgebra.single
          (Localization.mk (1 : ℤ) ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) (1 : L))) :=
    ⟨_, fun k => rfl⟩
  have s1a : ∀ k, τ (k + 1) ^ ℓ = τ k := by
    intro k
    rw [hτdef, hτdef, ← map_pow, ← map_pow, hℓG]
  have s1b : τ 0 = T.πi.appTop.hom (p.appTop.hom ((Scheme.ΓSpecIso (.of B)).inv.hom x₀)) := by
    rw [hτdef, h0G, bridge, T.hg₀T]
  have s1c : ∀ (m k : ℕ) (c : L), T.gi.appTop.hom
      ((Scheme.ΓSpecIso (.of (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))).inv.hom
        (AddMonoidAlgebra.single
          (Localization.mk (m : ℤ) ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) c)) =
      T.πi.appTop.hom (q.appTop.hom ((Scheme.ΓSpecIso (.of L)).inv.hom c)) * τ k ^ m := by
    intro m k c
    rw [hτdef, hsplit m k c, map_mul, map_mul, hpowG m k, map_pow, map_pow, hCG, bridge]
    congr 1
    have h1 := congrArg (fun f => f.hom c) (Scheme.ΓSpecIso_inv_naturality
      (CommRingCat.ofHom (LaurentPolynomial.C : L →+* LaurentPolynomial L)))
    have h2 := congrArg (fun f => (Scheme.Hom.appTop f).hom
      ((Scheme.ΓSpecIso (.of L)).inv.hom c)) T.hg₀q
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom,
      Scheme.Hom.comp_appTop] at h1 h2
    rw [h1, h2]

  have hcondApp : ∀ y : Γ(XE, ⊤),
      (Limits.pullback.snd sE T.πi).appTop.hom (T.πi.appTop.hom y) =
      (Limits.pullback.fst sE T.πi).appTop.hom
        (sE.appTop.hom y) := by
    intro y
    have h := congrArg (fun f => (Scheme.Hom.appTop f).hom y)
      (Limits.pullback.condition (f := sE) (g := T.πi))
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at h
    exact h.symm

  have s2 : ∀ {W : Scheme.{u}} (f g : W ⟶ Limits.pullback sE T.πi),
      f ≫ Limits.pullback.fst sE T.πi =
        g ≫ Limits.pullback.fst sE T.πi →
      (∀ (m k : ℕ) (c : L),
        (f ≫ Limits.pullback.snd sE T.πi ≫ T.gi).appTop.hom
          ((Scheme.ΓSpecIso (.of (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))).inv.hom
            (AddMonoidAlgebra.single
              (Localization.mk (m : ℤ) ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) c)) =
        (g ≫ Limits.pullback.snd sE T.πi ≫ T.gi).appTop.hom
          ((Scheme.ΓSpecIso (.of (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))).inv.hom
            (AddMonoidAlgebra.single
              (Localization.mk (m : ℤ) ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) c))) →
      f = g := by
    intro W f g h1 h2
    apply Limits.pullback.hom_ext h1
    apply T.hT.hom_ext
    · simp only [Category.assoc]
      rw [← Limits.pullback.condition, ← Category.assoc, h1, Category.assoc]
    · simp only [Category.assoc]
      apply ext_of_isAffine
      have hF := ghom_ext
        ((f ≫ Limits.pullback.snd sE T.πi ≫ T.gi).appTop.hom.comp
          (Scheme.ΓSpecIso (.of (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))).inv.hom)
        ((g ≫ Limits.pullback.snd sE T.πi ≫ T.gi).appTop.hom.comp
          (Scheme.ΓSpecIso (.of (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))).inv.hom)
        (fun m k c => h2 m k c)
      apply (Iso.cancel_iso_inv_left
        (Scheme.ΓSpecIso (.of (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))) _ _).mp
      apply CommRingCat.hom_ext
      rw [CommRingCat.hom_comp, CommRingCat.hom_comp]
      exact hF

  intro x
  have εinj : Function.Injective
      (Scheme.ΓSpecIso ((Limits.pullback sE T.πi).residueField x)).hom.hom :=
    (Scheme.ΓSpecIso _).commRingCatIsoToRingEquiv.injective
  obtain ⟨ρ, hρ⟩ : ∃ ρ : Γ(Limits.pullback sE T.πi, ⊤) →+*
      ((Limits.pullback sE T.πi).residueField x),
      ∀ y, ρ y = (Scheme.ΓSpecIso ((Limits.pullback sE T.πi).residueField
        x)).hom.hom
          (((Limits.pullback sE T.πi).fromSpecResidueField x).appTop.hom y) :=
    ⟨(Scheme.ΓSpecIso _).hom.hom.comp (Scheme.Hom.appTop _).hom, fun y => rfl⟩
  obtain ⟨θ, hθ⟩ : ∃ θ : L →+* ((Limits.pullback sE T.πi).residueField x),
      ∀ c, θ c = ρ ((Limits.pullback.fst sE T.πi).appTop.hom
        (sE.appTop.hom (q.appTop.hom ((Scheme.ΓSpecIso (.of L)).inv.hom c)))) :=
    ⟨ρ.comp ((Limits.pullback.fst sE T.πi).appTop.hom.comp
      (sE.appTop.hom.comp (q.appTop.hom.comp
        (Scheme.ΓSpecIso (.of L)).inv.hom))), fun c => rfl⟩
  have θinj : Function.Injective θ := RingHom.injective θ
  obtain ⟨ξ, hξdef⟩ : ∃ ξ : ℕ → ((Limits.pullback sE T.πi).residueField x),
      ∀ k, ξ k = θ (T.ζ k) := ⟨_, fun k => rfl⟩
  obtain ⟨ν, hνdef⟩ : ∃ ν : ℕ → ((Limits.pullback sE T.πi).residueField x),
      ∀ k, ν k = ρ ((Limits.pullback.fst sE T.πi).appTop.hom (v k)) :=
    ⟨_, fun k => rfl⟩
  obtain ⟨τ', hτ'def⟩ : ∃ τ' : ℕ → ((Limits.pullback sE T.πi).residueField x),
      ∀ k, τ' k = ρ ((Limits.pullback.snd sE T.πi).appTop.hom (τ k)) :=
    ⟨_, fun k => rfl⟩
  obtain ⟨a, ha⟩ := s4 _ ξ ν τ'
    (fun k => by rw [hξdef]; exact (T.hζ k).map_of_injective θinj)
    (fun k => by rw [hξdef, hξdef, ← map_pow, T.hζc])
    (fun k => by rw [hνdef, hνdef, ← map_pow, ← map_pow, hv])
    (by rw [hνdef]; exact ((hvu.map _).map ρ).ne_zero)
    (fun k => by rw [hτ'def, hτ'def, ← map_pow, ← map_pow, s1a])
    (by rw [hτ'def, hνdef, s1b, hcondApp, hv0])
  have hτK : ∀ k : ℕ,
      ((Limits.pullback sE T.πi).fromSpecResidueField x).appTop.hom
        ((Limits.pullback.snd sE T.πi).appTop.hom (τ k)) =
      (((Limits.pullback sE T.πi).fromSpecResidueField x).appTop.hom
        ((Limits.pullback.fst sE T.πi).appTop.hom
          (sE.appTop.hom
            (q.appTop.hom ((Scheme.ΓSpecIso (.of L)).inv.hom (T.ζ k)))))) ^
          (PadicInt.toZModPow k a).val *
      ((Limits.pullback sE T.πi).fromSpecResidueField x).appTop.hom
        ((Limits.pullback.fst sE T.πi).appTop.hom (v k)) := by
    intro k
    apply εinj
    rw [map_mul, map_pow, ← hρ, ← hρ, ← hρ]
    have h := ha k
    rw [hτ'def, hξdef, hθ, hνdef] at h
    exact h
  have hext : (Limits.pullback sE T.πi).fromSpecResidueField x =
      (Limits.pullback sE T.πi).fromSpecResidueField x ≫
        Limits.pullback.fst sE T.πi ≫ sc a := by
    apply s2
    · simp only [Category.assoc, hsc1 a, Category.comp_id]
    · intro m k c
      have hR := hsc2 a m k c
      have hL := s1c m k c
      simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply,
        Category.assoc] at hR ⊢
      rw [hR, hL]
      simp only [map_mul, map_pow]
      rw [hτK k, hcondApp]
  refine ⟨a, ?_⟩
  have e1 := Scheme.fromSpecResidueField_apply x
    (IsLocalRing.closedPoint ((Limits.pullback sE T.πi).residueField x))
  have e2 := congrArg (fun f : Spec ((Limits.pullback sE T.πi).residueField x) ⟶
      Limits.pullback sE T.πi =>
    f (IsLocalRing.closedPoint ((Limits.pullback sE T.πi).residueField x)))
    hext
  have e3 : ∀ y : ↥(Spec ((Limits.pullback sE T.πi).residueField x)),
      ((Limits.pullback sE T.πi).fromSpecResidueField x ≫
        Limits.pullback.fst sE T.πi ≫ sc a) y =
      (sc a).base.hom ((Limits.pullback.fst sE T.πi).base.hom
        (((Limits.pullback sE T.πi).fromSpecResidueField x) y)) := by
    intro y
    rfl
  exact e1.symm.trans (e2.trans ((e3 _).trans (congrArg (fun z =>
    (sc a).base.hom ((Limits.pullback.fst sE T.πi).base.hom z)) e1)))

theorem wc_etqmtx1_kummer_equivariance_gen {A B L : Type u} [CommRing A] [CommRing B] [Field L]
    {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {φA : A →+* L} {σ : L →+* L} {XE : Scheme.{u}}
    {p : XE ⟶ Spec (.of B)} {q : XE ⟶ Spec (.of L)} {w : XE ⟶ XE} {x₀ : B}
    (T : wcQmtmTower ℓ φA σ p q w x₀) {E : Scheme.{u}} (sE : E ⟶ XE)
    (v : ℕ → Γ(E, ⊤))
    (sc : ℤ_[ℓ] → (E ⟶ Limits.pullback sE T.πi))
    (hsc1 : ∀ a : ℤ_[ℓ], sc a ≫ Limits.pullback.fst sE T.πi = 𝟙 _)
    (hsc2 : ∀ (a : ℤ_[ℓ]) (m k : ℕ) (c : L),
        (sc a ≫ Limits.pullback.snd sE T.πi ≫ T.gi).appTop.hom
          ((Scheme.ΓSpecIso (.of (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))).inv.hom
            (AddMonoidAlgebra.single
              (Localization.mk (m : ℤ) ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) c)) =
          (sE ≫ q).appTop.hom ((Scheme.ΓSpecIso (.of L)).inv.hom c) *
            ((sE ≫ q).appTop.hom ((Scheme.ΓSpecIso (.of L)).inv.hom (T.ζ k)) ^
              (PadicInt.toZModPow k a).val * v k) ^ m)
    (wE : E ⟶ E) (hwE : wE ≫ sE = sE ≫ w)
    (hw₂ : w ≫ q = q ≫ Spec.map (CommRingCat.ofHom σ)) (hζσ : ∀ k, σ (T.ζ k) = T.ζ k)
    (t : ℤ_[ℓ])
    (hvw : ∀ k, wE.appTop.hom (v k) =
      (sE ≫ q).appTop.hom ((Scheme.ΓSpecIso (.of L)).inv.hom (T.ζ k)) ^ (PadicInt.toZModPow k t).val * v k)
    (γs : T.XEi ⟶ T.XEi)
    (Rs : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) →+*
      AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)))
    (hT2 : ∀ (a : ℤ) (k : ℕ) (c : L),
      Rs (AddMonoidAlgebra.single
          (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) c) =
        AddMonoidAlgebra.single
          (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ))
          (T.ζ k ^ (a * ((PadicInt.toZModPow k (-t)).val : ℤ)) * c))
    (hT3 : γs ≫ T.gi = T.gi ≫ Spec.map (CommRingCat.ofHom Rs)) :
    (∀ κ : Limits.pullback sE T.πi ⟶ Limits.pullback sE T.πi,
      κ ≫ Limits.pullback.fst sE T.πi = Limits.pullback.fst sE T.πi →
      κ ≫ Limits.pullback.snd sE T.πi = Limits.pullback.snd sE T.πi ≫ γs →
      ∀ a : ℤ_[ℓ], sc a ≫ κ = sc (a - t)) ∧
    (∀ Ξ : Limits.pullback sE T.πi ⟶ Limits.pullback sE T.πi,
      Ξ ≫ Limits.pullback.fst sE T.πi = Limits.pullback.fst sE T.πi ≫ wE →
