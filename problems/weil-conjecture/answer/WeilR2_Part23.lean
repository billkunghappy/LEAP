  have hC0 : Limits.IsZero (F.obj (Dg.Φ.obj (Limits.cokernel (wcEtSuppUnitMap Dh)))) :=
    (@AddCommGrpCat.isZero_of_subsingleton _ hst.2).of_iso θC
  have hK' : Limits.IsZero (Limits.kernel (F.map (Dg.Φ.map (wcEtSuppUnitMap Dh)))) :=
