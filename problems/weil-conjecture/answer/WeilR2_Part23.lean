      Limits.pullback.snd g₀ (Spec.map (CommRingCat.ofHom ι₀)), hT,
      hT.lift _ _ hγ, hT.lift _ _ hw,
      hT.lift_fst _ _ hγ, hT.lift_snd _ _ hγ,
      hT.lift_fst _ _ hw, hT.lift_snd _ _ hw⟩⟩

  have hφπ : (Spec.preimage ξ).hom π ≠ 0 := by
    intro h0
    have h1 := htame 1 le_rfl 0 (by rw [h0]; exact zero_pow (pow_ne_zero _ hℓ0))
    rw [map_zero, zero_mul] at h1
    exact h1.ne_zero (pow_ne_zero _ hℓ0) rfl
  have hπirr : Irreducible π := (IsDiscreteValuationRing.irreducible_iff_uniformizer π).mpr hπ
  have hφinj : Function.Injective (Spec.preimage ξ).hom := by
    rw [injective_iff_map_eq_zero]
    intro a ha
    by_contra hne
    obtain ⟨n, u, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hne hπirr
    rw [map_mul, map_pow] at ha
    exact mul_ne_zero ((u.isUnit.map _).ne_zero) (pow_ne_zero _ hφπ) ha

  have hsum : (∑ i : Fin (r + 2), ∑ j : Fin (r + 2), MvPolynomial.C (wcQmtmC A r i j) *
      MvPolynomial.X i * MvPolynomial.X j : MvPolynomial (Fin (r + 2)) A) =
      MvPolynomial.X ⟨0, by omega⟩ * MvPolynomial.X ⟨1, by omega⟩ := by
    rw [Finset.sum_eq_single (⟨0, by omega⟩ : Fin (r + 2))]
    · rw [Finset.sum_eq_single (⟨1, by omega⟩ : Fin (r + 2))]
      · simp [wcQmtmC]
      · intro b _ hb
        have hb1 : b.val ≠ 1 := fun h => hb (Fin.ext h)
        simp [wcQmtmC, hb1]
      · intro h; exact absurd (Finset.mem_univ _) h
    · intro b _ hb
      apply Finset.sum_eq_zero
      intro j _
      have hb0 : b.val ≠ 0 := fun h => hb (Fin.ext h)
      simp only [wcQmtmC, Matrix.of_apply]
      rw [if_neg (fun h => hb0 h.1)]
      simp
    · intro h; exact absurd (Finset.mem_univ _) h
  have hmem : (MvPolynomial.X ⟨0, by omega⟩ * MvPolynomial.X ⟨1, by omega⟩ -
      MvPolynomial.C π : MvPolynomial (Fin (r + 2)) A) ∈
      wcQuadModelIdeal A (r + 2) π (wcQmtmC A r) := by
    rw [← hsum]
    exact Ideal.subset_span (Set.mem_singleton _)
  have hquot : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
        (MvPolynomial.X ⟨0, by omega⟩) *
      Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
        (MvPolynomial.X ⟨1, by omega⟩) =
      algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r)) π := by
    rw [← map_mul, ← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq]
    exact Ideal.Quotient.eq.mpr hmem
  have hstr : (wcQuadModelStr A (r + 2) π (wcQmtmC A r)).appTop.hom
      ((Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom π) =
      (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).inv.hom
        (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r)) π) :=
    hnat (CommRingCat.ofHom (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))) π
  have hx01 : wcEtqmtX g ⟨0, by omega⟩ * wcEtqmtX g ⟨1, by omega⟩ =
      fX.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom π) := by
    show g.appTop.hom _ * g.appTop.hom _ = _
    rw [← map_mul, ← map_mul, hquot, hfX, Scheme.Hom.comp_appTop, CommRingCat.hom_comp,
      RingHom.comp_apply, hstr]
  have hcond := congrArg (fun k => k.hom ((Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom π))
    (congrArg Scheme.Hom.appTop (Limits.pullback.condition (f := fX) (g := ξ)))
  simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at hcond
  have hξ : ξ.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom π) =
      (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom ((Spec.preimage ξ).hom π) := by
    have h := hnat (Spec.preimage ξ) π
    rwa [Spec.map_preimage] at h
  have hfst : (Limits.pullback.fst fX ξ).appTop.hom (wcEtqmtX g ⟨0, by omega⟩) *
      (Limits.pullback.fst fX ξ).appTop.hom (wcEtqmtX g ⟨1, by omega⟩) =
      (Limits.pullback.snd fX ξ).appTop.hom
        ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom ((Spec.preimage ξ).hom π)) := by
    rw [← map_mul, hx01, hcond, hξ]
  have hunit : IsUnit ((Limits.pullback.fst fX ξ).appTop.hom (wcEtqmtX g ⟨0, by omega⟩)) := by
    apply isUnit_of_mul_isUnit_left (y := (Limits.pullback.fst fX ξ).appTop.hom
      (wcEtqmtX g ⟨1, by omega⟩))
    rw [hfst]
    exact (hφπ.isUnit.map _).map _
  have hx0 : IsUnit ((Limits.pullback.fst fX ξ ≫ U.toSpecΓ).appTop.hom
      ((Scheme.ΓSpecIso (CommRingCat.of Γ(U, ⊤))).inv.hom (wcEtqmtX g ⟨0, by omega⟩))) := by
    have e := congrArg (fun k => k.hom (wcEtqmtX g ⟨0, by omega⟩))
      (Iso.inv_hom_id (Scheme.ΓSpecIso Γ(U, ⊤)))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_id,
      RingHom.id_apply] at e
    rw [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply,
      Scheme.toSpecΓ_appTop]
    erw [e]
    exact hunit
  have hw₁ : σQ ≫ (Limits.pullback.fst fX ξ ≫ U.toSpecΓ) = Limits.pullback.fst fX ξ ≫ U.toSpecΓ := by
    rw [← Category.assoc, hσQ1]
  have hw₂ : σQ ≫ Limits.pullback.snd fX ξ =
      Limits.pullback.snd fX ξ ≫ Spec.map (CommRingCat.ofHom (Spec.preimage σ).hom) := by
    rw [CommRingCat.ofHom_hom, Spec.map_preimage]
    exact hσQ2
  exact key (Spec.preimage ξ).hom hφinj (Spec.preimage σ).hom _
    (Limits.pullback.fst fX ξ ≫ U.toSpecΓ) (Limits.pullback.snd fX ξ) σQ hw₁ hw₂ _ hx0

theorem wc_etqmt_affine_push_stalk_vanish : ∀ {X Y : Scheme.{u}} (g : X ⟶ Y) [IsAffineHom g] (m : ℕ), 0 < m → ∀ (D : wcEtPullData g m) (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing X m))) (y : Y) (q : ℕ), (∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Y), wcHalShData y B Λ W' φ a → Subsingleton (wcEtCoh (Limits.pullback g a) m q)) → letI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange g) _ _ D.cont D.φ).Additive := @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D.adj D.additive; Subsingleton ((wcEtStalk Y y).obj ((SheafOfModules.toSheaf (wcEtZModRing Y m)).obj ((((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange g) _ _ D.cont D.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q))) :=
by
  classical

  have L3 : ∀ {T Q : Scheme.{u}} (r : Q ⟶ T) (ℓ : ℕ), 0 < ℓ → ∀ (D : wcEtPullData r ℓ) (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing Q ℓ))) (J : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology Q) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) (n : ℕ), letI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ).Additive := @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D.adj D.additive; Nonempty ((SheafOfModules.toSheaf (wcEtZModRing T ℓ)).obj ((((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology n) ≅ (((wcEtPush r).mapHomologicalComplex (ComplexShape.up ℕ)).obj J.cocomplex).homology n) := by
    intro T Q r ℓ hn D I J n
    letI hPadd : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ).Additive :=
      @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D.adj D.additive
    haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology Q) AddCommGrpCat.{u+1}) :=
      wc_et_enough_injectives Q
    haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) :=
      wc_et_enough_injectives T
    haveI := sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology Q) (wcEtZModRing Q ℓ)
    haveI := sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology T) (wcEtZModRing T ℓ)
    haveI hIRQ : HasInjectiveResolutions (SheafOfModules.{u+1} (wcEtZModRing Q ℓ)) :=
      ⟨fun Z => ⟨⟨InjectiveResolution.of Z⟩⟩⟩
    haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.smallEtaleTopology Q)
      (wcEtZModRing Q ℓ)
    haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.smallEtaleTopology T)
      (wcEtZModRing T ℓ)
    have s1 : ∀ (X : Scheme.{u}) (E : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
        [Injective E], Epi (ℓ • 𝟙 E) := by
      intro X E _
      have hP : Injective ((sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj E) :=
        Injective.injective_of_adjoint
          (sheafificationAdjunction (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) E
      have hdiv : ∀ (U : X.Etale)
          (s : ((sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj E).obj
            (Opposite.op U)), ∃ t, ℓ • t = s := by
        intro U s
        let P := (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj E
        let G : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
          yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
        let φ : G ⟶ P :=
          { app := fun V => AddCommGrpCat.ofHom (FreeAbelianGroup.lift
              (fun f : ULift.{u+1} (V.unop ⟶ U) => (P.map f.down.op).hom s))
            naturality := by
              intro V W h
              apply AddCommGrpCat.hom_ext
              apply FreeAbelianGroup.lift_ext
              intro f
              show (FreeAbelianGroup.lift (fun f' : ULift.{u+1} (W.unop ⟶ U) => (P.map f'.down.op).hom s))
                  ((G.map h).hom (FreeAbelianGroup.of f)) =
                (P.map h).hom ((FreeAbelianGroup.lift
                  (fun f' : ULift.{u+1} (V.unop ⟶ U) => (P.map f'.down.op).hom s)) (FreeAbelianGroup.of f))
              have hG : (G.map h).hom (FreeAbelianGroup.of f) =
                  FreeAbelianGroup.of (ULift.up (h.unop ≫ f.down)) := rfl
              rw [hG]
              erw [FreeAbelianGroup.lift_apply_of, FreeAbelianGroup.lift_apply_of]
              show (P.map (h.unop ≫ f.down).op).hom s = (P.map h).hom ((P.map f.down.op).hom s)
              rw [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp]
              rfl }
        have tf : ∀ (Y : Type (u+1)) (a b : FreeAbelianGroup Y), ℓ • a = ℓ • b → a = b := by
          intro Y a b hab
          apply (FreeAbelianGroup.equivFinsupp Y).injective
          ext x
          have hx := congrArg (fun z => FreeAbelianGroup.equivFinsupp Y z x) hab
          simp only [map_nsmul, Finsupp.smul_apply, nsmul_eq_mul] at hx
          exact Int.eq_of_mul_eq_mul_left (by exact_mod_cast hn.ne') hx
        have hmono : Mono (ℓ • 𝟙 G) := by
          have : ∀ V, Mono ((ℓ • 𝟙 G).app V) := by
            intro V
            rw [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.mono_iff_injective]
            intro a b hab
            simp only [AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id, AddMonoidHom.nsmul_apply,
              AddMonoidHom.id_apply] at hab
            exact tf _ a b hab
          exact NatTrans.mono_of_mono_app _
        let g := Injective.factorThru φ (ℓ • 𝟙 G)
        have hg : (ℓ • 𝟙 G) ≫ g = φ := Injective.comp_factorThru φ (ℓ • 𝟙 G)
        rw [Preadditive.nsmul_comp, Category.id_comp] at hg
        refine ⟨(g.app (Opposite.op U)).hom (FreeAbelianGroup.of (ULift.up (𝟙 U))), ?_⟩
        have h1 := congrArg (fun α : G ⟶ P =>
          (α.app (Opposite.op U)).hom (FreeAbelianGroup.of (ULift.up (𝟙 U)))) hg
        have h2 : (φ.app (Opposite.op U)).hom (FreeAbelianGroup.of (ULift.up (𝟙 U))) = s := by
          show (FreeAbelianGroup.lift (fun f : ULift.{u+1} (U ⟶ U) => (P.map f.down.op).hom s))
            (FreeAbelianGroup.of (ULift.up (𝟙 U))) = s
          rw [FreeAbelianGroup.lift_apply_of]
          simp
        rw [← h2, ← h1]
        simp only [NatTrans.app_nsmul, AddCommGrpCat.hom_nsmul]
        rfl
      have hmap : (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map (ℓ • 𝟙 E) =
          ℓ • 𝟙 ((sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj E) := by
        rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
      apply Functor.epi_of_epi_map (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
      rw [hmap]
      have : ∀ V, Epi ((ℓ • 𝟙 ((sheafToPresheaf (Scheme.smallEtaleTopology X)
          AddCommGrpCat.{u+1}).obj E)).app V) := by
        intro V
        rw [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.epi_iff_surjective]
        intro s
        obtain ⟨t, ht⟩ := hdiv V.unop s
        exact ⟨t, by simpa using ht⟩
      exact NatTrans.epi_of_epi_app _
    have hker : ∀ (E : Sheaf (Scheme.smallEtaleTopology Q) AddCommGrpCat.{u+1}) [Injective E],
        Epi ((wcEtPush r).map (ℓ • 𝟙 E)) → ∀ q : ℕ,
        Limits.IsZero (((wcEtPush r).rightDerived (q + 1)).obj (Limits.kernel (ℓ • 𝟙 E))) := by
      intro E _ hRe q
      let S := ShortComplex.mk (Limits.kernel.ι (ℓ • 𝟙 E)) (ℓ • 𝟙 E) (Limits.kernel.condition _)
      have hS : S.ShortExact := by
        refine ShortComplex.ShortExact.mk' ?_ (by dsimp [S]; infer_instance) (s1 Q E)
        exact S.exact_of_f_is_kernel (Limits.kernelIsKernel (ℓ • 𝟙 E))
      obtain ⟨_, _, hles⟩ := wc_rightDerived_les_package (wcEtPush r) S hS
      obtain ⟨_, δ, h1, h2, _, hex⟩ := hles q
      have hf : ((wcEtPush r).rightDerived (q + 1)).map S.f = 0 :=
        (Functor.isZero_rightDerived_obj_injective_succ (wcEtPush r) q E).eq_of_tgt _ _
      have hδ : δ = 0 := by
        cases q with
        | zero =>
          have hRe' : Epi ((wcEtPush r).map S.g) := hRe
          have hepi : Epi (((wcEtPush r).rightDerived 0).map S.g) := by
            rw [← NatIso.naturality_2 (wcEtPush r).rightDerivedZeroIsoSelf S.g]
            infer_instance
          exact (cancel_epi _).1 (h1.trans Limits.comp_zero.symm)
        | succ m =>
          exact (Functor.isZero_rightDerived_obj_injective_succ (wcEtPush r) m E).eq_of_src _ _
      exact hex.isZero_X₂ hδ hf
    obtain ⟨α₀, hinj₀, hsurj₀, hR⟩ := wc_et_zmod_ring_locbij Q ℓ
    obtain ⟨hfull, hess⟩ := sheafOfModules_toSheaf_torsion_equiv (Scheme.smallEtaleTopology Q)
      (wcEtZModRing Q ℓ) ℓ α₀ hinj₀ hsurj₀
    haveI := hfull
    have hacyc : ∀ (I : SheafOfModules.{u+1} (wcEtZModRing Q ℓ)) [Injective I] (k : ℕ),
        Limits.IsZero (((wcEtPush r).rightDerived (k + 1)).obj
          ((SheafOfModules.toSheaf (wcEtZModRing Q ℓ)).obj I)) := by
      intro I _ k
      let Φ := SheafOfModules.toSheaf.{u+1} (wcEtZModRing Q ℓ)
      have hI0 : ℓ • 𝟙 (Φ.obj I) = 0 := by
        apply (sheafToPresheaf (Scheme.smallEtaleTopology Q) AddCommGrpCat.{u+1}).map_injective
        rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id,
          CategoryTheory.Functor.map_zero]
        ext X m
        have key : ∀ m' : (I.val.obj X : Type _), ℓ • m' = 0 := fun m' => by
          rw [← Nat.cast_smul_eq_nsmul ((wcEtZModRing Q ℓ).obj.obj X) ℓ m', hR X, zero_smul]
        simp only [NatTrans.app_nsmul, NatTrans.id_app, NatTrans.app_zero, AddCommGrpCat.hom_nsmul,
          AddCommGrpCat.hom_id, AddCommGrpCat.hom_zero, AddMonoidHom.nsmul_apply,
          AddMonoidHom.id_apply, AddMonoidHom.zero_apply]
        exact key m
      let E := Injective.under (Φ.obj I)
      let ι := Injective.ι (Φ.obj I)
      have hιn : ι ≫ (ℓ • 𝟙 E) = 0 := by
        have h1 : ℓ • ι = (ℓ • 𝟙 (Φ.obj I)) ≫ ι := by
          rw [Preadditive.nsmul_comp, Category.id_comp]
        rw [Preadditive.comp_nsmul, Category.comp_id, h1, hI0, Limits.zero_comp]
      let j := Limits.kernel.lift (ℓ • 𝟙 E) ι hιn
      have hj : j ≫ Limits.kernel.ι (ℓ • 𝟙 E) = ι := Limits.kernel.lift_ι _ _ _
      have : Mono j := mono_of_mono_fac hj
      have hK0 : ℓ • 𝟙 (Limits.kernel (ℓ • 𝟙 E)) = 0 := by
        apply (cancel_mono (Limits.kernel.ι (ℓ • 𝟙 E))).1
        have h1 : Limits.kernel.ι (ℓ • 𝟙 E) ≫ (ℓ • 𝟙 E) = ℓ • Limits.kernel.ι (ℓ • 𝟙 E) := by
          rw [Preadditive.comp_nsmul, Category.comp_id]
        rw [Preadditive.nsmul_comp, Category.id_comp, ← h1, Limits.kernel.condition, Limits.zero_comp]
      obtain ⟨M', ⟨β⟩⟩ := hess _ hK0
      let g := Φ.preimage (j ≫ β.inv)
      have hg : Φ.map g = j ≫ β.inv := Φ.map_preimage _
      have : Mono g := Φ.mono_of_mono_map (by rw [hg]; infer_instance)
      let rr := Injective.factorThru (𝟙 I) g
      have hr : g ≫ rr = 𝟙 I := Injective.comp_factorThru _ _
      let ρ := β.inv ≫ Φ.map rr
      have hjρ : j ≫ ρ = 𝟙 _ := by
        calc j ≫ ρ = (j ≫ β.inv) ≫ Φ.map rr := by simp only [ρ, Category.assoc]
          _ = Φ.map (g ≫ rr) := by rw [Φ.map_comp, hg]
          _ = 𝟙 _ := by rw [hr, Φ.map_id]
      have hEinj : Injective ((wcEtPush r).obj E) := by
        obtain ⟨L, ⟨adj⟩, hL, _⟩ := wc_et_push_left_adjoint r
        haveI := hL
        exact adj.map_injective E inferInstance
      haveI := hEinj
      have hepi : Epi ((wcEtPush r).map (ℓ • 𝟙 E)) := by
        rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
        exact s1 T _
      have hK := hker E hepi k
      rw [Limits.IsZero.iff_id_eq_zero]
      calc 𝟙 _ = ((wcEtPush r).rightDerived (k + 1)).map (𝟙 (Φ.obj I)) :=
            (CategoryTheory.Functor.map_id _ _).symm
        _ = ((wcEtPush r).rightDerived (k + 1)).map j ≫
              ((wcEtPush r).rightDerived (k + 1)).map ρ := by
            rw [← hjρ, CategoryTheory.Functor.map_comp]
        _ = 0 := by
            rw [hK.eq_of_tgt (((wcEtPush r).rightDerived (k + 1)).map j) 0, Limits.zero_comp]
    obtain ⟨βc⟩ := wc_et_toSheaf_pushforward_iso r ℓ D
    have hiso := wc_rightDerived_exact_conj_iso
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ) (wcEtPush r)
      (SheafOfModules.toSheaf (wcEtZModRing Q ℓ)) (SheafOfModules.toSheaf (wcEtZModRing T ℓ))
      ⟨βc⟩ hacyc
    obtain ⟨Θ⟩ := hiso (SheafOfModules.unit (wcEtZModRing Q ℓ)) n
    obtain ⟨e⟩ := wc_et_zmod_unit_toSheaf_iso Q ℓ
    exact ⟨(SheafOfModules.toSheaf (wcEtZModRing T ℓ)).mapIso
        (I.isoRightDerivedObj
          (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ) n).symm ≪≫
      Θ.symm ≪≫ ((wcEtPush r).rightDerived n).mapIso e ≪≫ J.isoRightDerivedObj (wcEtPush r) n⟩

  intro X Y g hgaff m hm D I y q hM
  haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) :=
    wc_et_enough_injectives X
  let J := InjectiveResolution.of ((constantSheaf (Scheme.smallEtaleTopology X)
    AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))
  obtain ⟨θ⟩ := L3 g m hm D I J q

  obtain ⟨B, _, _, _, Λ, _, _, W', φ, a, e, hinit, haff, hφ, hφa, hlim, he, hcomp⟩ :=
    wc_et_geom_strict_henselization y
