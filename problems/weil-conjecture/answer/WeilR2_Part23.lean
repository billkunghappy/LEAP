      (G : 𝒜 ⥤ ℬ) [G.Additive] [Limits.PreservesFiniteLimits G]
      [Limits.PreservesFiniteColimits G] {O' : 𝒜'} (I : InjectiveResolution O') (q : ℕ),
      Nonempty (((G.mapHomologicalComplex (ComplexShape.up ℤ)).obj
          ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex)).homology (q : ℤ) ≅
        G.obj (((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q)) := by
    intro 𝒜 𝒜' ℬ _ _ _ _ _ _ P _ G _ _ _ O' I q
    let Kn := (P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex
    let Lc := (G.mapHomologicalComplex (ComplexShape.up ℕ)).obj Kn
    let φ : ∀ a : Option ℕ, G.obj (P.obj (HomologicalComplex.extend.X I.cocomplex a)) ≅
        HomologicalComplex.extend.X Lc a := fun a =>
      match a with
      | some _ => Iso.refl _
      | none => Limits.IsZero.iso (G.map_isZero (P.map_isZero (Limits.isZero_zero _)))
          (Limits.isZero_zero _)
    have hφ : ∀ a b : Option ℕ,
        (φ a).hom ≫ HomologicalComplex.extend.d Lc a b =
          G.map (P.map (HomologicalComplex.extend.d I.cocomplex a b)) ≫ (φ b).hom := by
      intro a b
      cases a with
      | none => exact (G.map_isZero (P.map_isZero (Limits.isZero_zero _))).eq_of_src _ _
      | some i =>
        cases b with
        | none => exact (Limits.isZero_zero _).eq_of_tgt _ _
        | some j => exact (Category.id_comp _).trans (Category.comp_id _).symm
    let isoΨ : (G.mapHomologicalComplex (ComplexShape.up ℤ)).obj
          ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex) ≅
        Lc.extend ComplexShape.embeddingUpNat :=
      HomologicalComplex.Hom.isoOfComponents
        (fun i => φ (ComplexShape.embeddingUpNat.r i))
        (fun i j _ => hφ _ _)
    exact ⟨HomologicalComplex.homologyMapIso isoΨ (q : ℤ) ≪≫
      Lc.extendHomologyIso ComplexShape.embeddingUpNat (j := q) rfl ≪≫
      (Kn.sc q).mapHomologyIso G⟩

  have hΨ : ∀ q : ℤ, ((n - 1 : ℕ) : ℤ) < q → Limits.IsZero (Ψ.homology q) := by
    intro q hq
    obtain ⟨k', rfl⟩ := Int.eq_ofNat_of_zero_le (show (0 : ℤ) ≤ q by omega)
    have hk1 : 1 ≤ k' := by omega
    have hkN : k' ≠ n - 1 := by omega
    haveI := Dg.presLim
    haveI := Dg.presColim
    obtain ⟨iso⟩ := htr P Dg.Φ I k'
    exact (wc_et_tpl_restr_higher_vanish F' F'' Y n hn hn2 D ℓ hℓ k i A Λ W' φ a hA η hηb hηne
      ξ hξ Dh Dg I k' hk1 hkN).of_iso iso

  have gen : ∀ {𝒞 𝒞W : Type (u+2)} [Category.{u+1} 𝒞] [Category.{u+1} 𝒞W] [Abelian 𝒞]
      [Abelian 𝒞W] {_hD : HasDerivedCategory.{u+2} 𝒞} {_hDW : HasDerivedCategory.{u+2} 𝒞W}
      (Φ : 𝒞 ⥤ 𝒞W) [Φ.Additive] [Limits.PreservesFiniteLimits Φ]
      [Limits.PreservesFiniteColimits Φ] (One : 𝒞) (OneW : 𝒞W) (μ : Φ.obj One ≅ OneW)
      [Projective OneW] (Ψ0 : CochainComplex 𝒞 ℤ) (N M : ℤ) (_hM : 0 < M)
      (_hΨ : ∀ q : ℤ, N < q → Limits.IsZero (Ψ0.homology q)),
      ∀ g : Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
          ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One)) ⟶
        ((Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj Ψ0))⟦N⟧)⟦M⟧, g = 0 := by
    intro 𝒞 𝒞W _ _ _ _ _ _ Φ _ _ _ One OneW μ _ Ψ0 N M hM hΨ0 g
    have hLE : (Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj Ψ0)).IsLE N := by
      rw [DerivedCategory.isLE_iff]
      intro q hq
      exact Limits.IsZero.of_iso (Φ.map_isZero (hΨ0 q hq))
        ((DerivedCategory.homologyFunctor _ q).mapIso ((Φ.mapDerivedCategoryFactors).app Ψ0) ≪≫
          (DerivedCategory.homologyFunctorFactors _ q).app _ ≪≫ (Ψ0.sc q).mapHomologyIso Φ)
    have h2 : ((Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj Ψ0))⟦N⟧).IsLE 0 :=
      DerivedCategory.TStructure.t.isLE_shift _ N N 0 (by omega)
    have h3 : (((Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj Ψ0))⟦N⟧)⟦M⟧).IsLE (-M) :=
      DerivedCategory.TStructure.t.isLE_shift _ 0 M (-M) (by omega)
    obtain ⟨Kz, hKz, ⟨eZ⟩⟩ := DerivedCategory.exists_iso_Q_obj_of_isLE
      (((Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj Ψ0))⟦N⟧)⟦M⟧) (-M)
    let ιL : DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞W (ComplexShape.up ℤ) 0).obj
        OneW) ≅ Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
          ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One)) :=
      DerivedCategory.Q.mapIso ((HomologicalComplex.single 𝒞W (ComplexShape.up ℤ) 0).mapIso
          μ.symm) ≪≫
        DerivedCategory.Q.mapIso ((HomologicalComplex.singleMapHomologicalComplex Φ
          (ComplexShape.up ℤ) 0).symm.app One) ≪≫
        ((Φ.mapDerivedCategoryFactors).app _).symm
    have h0 : ιL.hom ≫ g ≫ eZ.hom = 0 :=
      DerivedCategory.from_singleFunctor_obj_eq_zero_of_projective
        (P := OneW) (i := 0) _ (-M) (by omega)
    rw [← cancel_epi ιL.hom, ← cancel_mono eZ.hom, Limits.comp_zero, Limits.zero_comp]
    simpa only [Category.assoc] using h0
  intro g
  exact gen Dw.Φ _ _ Dw.μ Ψ ((n - 1 : ℕ) : ℤ)
    ((n - 2 : ℕ) : ℤ) (by omega) hΨ g

theorem wc_et_open_system_level_lift : ∀ {S Z : Scheme.{u}} (p : Z ⟶ S) (U : S.Opens) [QuasiCompact U.ι] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (D : Λ ⥤ S.Etale) (π : ∀ l, Z ⟶ (D.obj l).left), (∀ l, π l ≫ (D.obj l).hom = p) → (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ (D.map t).left = π l') → (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (D.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (D.map t).left = z l') → ∃! z₀ : T ⟶ Z, ∀ l, z₀ ≫ π l = z l) → (∀ l, IsAffine (D.obj l).left) → IsAffine Z → ∀ (m M : ℕ) (y : wcEtZModExt (Limits.pullback p U.ι) m M), ∃ (l : Λ) (x : wcEtZModExt (Limits.pullback (D.obj l).hom U.ι) m M), ∀ (z : Limits.pullback p U.ι ⟶ Limits.pullback (D.obj l).hom U.ι), z ≫ Limits.pullback.fst (D.obj l).hom U.ι = Limits.pullback.fst p U.ι ≫ π l → z ≫ Limits.pullback.snd (D.obj l).hom U.ι = Limits.pullback.snd p U.ι → ∀ (E : wcEtPullData z m), wcEtPull E M x = y :=
by
  intro S Z p U _ Λ _ _ D π hπ hπc hlim hAff hZaff m M y

  have hpb : IsPullback (Limits.pullback.snd p U.ι) (Limits.pullback.fst p U.ι) U.ι p :=
    (IsPullback.of_hasPullback p U.ι).flip
  have M1 : ∀ {l l' : Λ} (t : l ⟶ l'),
      ((D ⋙ wcEtBaseChange U.ι).map t).left ≫ Limits.pullback.fst (D.obj l').hom U.ι =
        Limits.pullback.fst (D.obj l).hom U.ι ≫ (D.map t).left := by
    intro l l' t
    exact Limits.pullback.lift_fst _ _ _
  have M2 : ∀ {l l' : Λ} (t : l ⟶ l'),
      ((D ⋙ wcEtBaseChange U.ι).map t).left ≫ Limits.pullback.snd (D.obj l').hom U.ι =
        Limits.pullback.snd (D.obj l).hom U.ι := by
    intro l l' t
    exact Limits.pullback.lift_snd _ _ _
  have hw : Limits.pullback.snd p U.ι ≫ U.ι = Limits.pullback.fst p U.ι ≫ p := hpb.w
  have wl : ∀ l, (Limits.pullback.fst p U.ι ≫ π l) ≫ (D.obj l).hom =
      Limits.pullback.snd p U.ι ≫ U.ι := by
    intro l
    rw [Category.assoc, hπ l, hw]
  let ρ : ∀ l, Limits.pullback p U.ι ⟶ ((D ⋙ wcEtBaseChange U.ι).obj l).left := fun l =>
    Limits.pullback.lift (Limits.pullback.fst p U.ι ≫ π l) (Limits.pullback.snd p U.ι) (wl l)
  have P1 : ∀ l, ρ l ≫ Limits.pullback.fst (D.obj l).hom U.ι =
      Limits.pullback.fst p U.ι ≫ π l := fun l =>
    Limits.pullback.lift_fst _ _ _
  have P2 : ∀ l, ρ l ≫ Limits.pullback.snd (D.obj l).hom U.ι = Limits.pullback.snd p U.ι :=
    fun l => Limits.pullback.lift_snd _ _ _
  have P2' : ∀ l, ρ l ≫ ((D ⋙ wcEtBaseChange U.ι).obj l).hom = Limits.pullback.snd p U.ι :=
    P2
  have C2 : ∀ {l l' : Λ} (t : l ⟶ l'), ρ l ≫ ((D ⋙ wcEtBaseChange U.ι).map t).left = ρ l' := by
    intro l l' t
    refine Limits.pullback.hom_ext (f := (D.obj l').hom) (g := U.ι) ?_ ?_
    · calc (ρ l ≫ ((D ⋙ wcEtBaseChange U.ι).map t).left) ≫ Limits.pullback.fst (D.obj l').hom U.ι
          = ρ l ≫ (((D ⋙ wcEtBaseChange U.ι).map t).left ≫
              Limits.pullback.fst (D.obj l').hom U.ι) := Category.assoc _ _ _
        _ = ρ l ≫ (Limits.pullback.fst (D.obj l).hom U.ι ≫ (D.map t).left) := whisker_eq _ (M1 t)
        _ = (ρ l ≫ Limits.pullback.fst (D.obj l).hom U.ι) ≫ (D.map t).left :=
            (Category.assoc _ _ _).symm
        _ = (Limits.pullback.fst p U.ι ≫ π l) ≫ (D.map t).left := eq_whisker (P1 l) _
        _ = Limits.pullback.fst p U.ι ≫ π l' := by rw [Category.assoc, hπc t]
        _ = ρ l' ≫ Limits.pullback.fst (D.obj l').hom U.ι := (P1 l').symm
    · calc (ρ l ≫ ((D ⋙ wcEtBaseChange U.ι).map t).left) ≫ Limits.pullback.snd (D.obj l').hom U.ι
          = ρ l ≫ (((D ⋙ wcEtBaseChange U.ι).map t).left ≫
              Limits.pullback.snd (D.obj l').hom U.ι) := Category.assoc _ _ _
        _ = ρ l ≫ Limits.pullback.snd (D.obj l).hom U.ι := whisker_eq _ (M2 t)
        _ = Limits.pullback.snd p U.ι := P2 l
        _ = ρ l' ≫ Limits.pullback.snd (D.obj l').hom U.ι := (P2 l').symm
  have C3 : ∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ ((D ⋙ wcEtBaseChange U.ι).obj l).left),
      (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ ((D ⋙ wcEtBaseChange U.ι).map t).left = z l') →
      ∃! z₀ : T ⟶ Limits.pullback p U.ι, ∀ l, z₀ ≫ ρ l = z l := by
    intro T z hz
    have hs : ∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ Limits.pullback.snd (D.obj l).hom U.ι =
        z l' ≫ Limits.pullback.snd (D.obj l').hom U.ι := by
      intro l l' t
      calc z l ≫ Limits.pullback.snd (D.obj l).hom U.ι
          = z l ≫ (((D ⋙ wcEtBaseChange U.ι).map t).left ≫
              Limits.pullback.snd (D.obj l').hom U.ι) := (whisker_eq _ (M2 t)).symm
        _ = (z l ≫ ((D ⋙ wcEtBaseChange U.ι).map t).left) ≫
              Limits.pullback.snd (D.obj l').hom U.ι := (Category.assoc _ _ _).symm
        _ = z l' ≫ Limits.pullback.snd (D.obj l').hom U.ι := eq_whisker (hz t) _
    obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
    have hX : ∀ l, z l ≫ Limits.pullback.snd (D.obj l).hom U.ι =
        z l₀ ≫ Limits.pullback.snd (D.obj l₀).hom U.ι := fun l =>
      (hs (IsCofiltered.minToLeft l l₀)).symm.trans (hs (IsCofiltered.minToRight l l₀))
    have hf : ∀ {l l' : Λ} (t : l ⟶ l'), (z l ≫ Limits.pullback.fst (D.obj l).hom U.ι) ≫
        (D.map t).left = z l' ≫ Limits.pullback.fst (D.obj l').hom U.ι := by
      intro l l' t
      calc (z l ≫ Limits.pullback.fst (D.obj l).hom U.ι) ≫ (D.map t).left
          = z l ≫ (Limits.pullback.fst (D.obj l).hom U.ι ≫ (D.map t).left) :=
            Category.assoc _ _ _
        _ = z l ≫ (((D ⋙ wcEtBaseChange U.ι).map t).left ≫
              Limits.pullback.fst (D.obj l').hom U.ι) := whisker_eq _ (M1 t).symm
        _ = (z l ≫ ((D ⋙ wcEtBaseChange U.ι).map t).left) ≫
              Limits.pullback.fst (D.obj l').hom U.ι := (Category.assoc _ _ _).symm
        _ = z l' ≫ Limits.pullback.fst (D.obj l').hom U.ι := eq_whisker (hz t) _
    obtain ⟨y', hy, hyu⟩ := hlim T (fun l => z l ≫ Limits.pullback.fst (D.obj l).hom U.ι) hf
    have hy' : ∀ l, y' ≫ π l = z l ≫ Limits.pullback.fst (D.obj l).hom U.ι := hy
    have hxy : (z l₀ ≫ Limits.pullback.snd (D.obj l₀).hom U.ι) ≫ U.ι = y' ≫ p := by
      calc (z l₀ ≫ Limits.pullback.snd (D.obj l₀).hom U.ι) ≫ U.ι
          = z l₀ ≫ (Limits.pullback.snd (D.obj l₀).hom U.ι ≫ U.ι) := Category.assoc _ _ _
        _ = z l₀ ≫ (Limits.pullback.fst (D.obj l₀).hom U.ι ≫ (D.obj l₀).hom) :=
            whisker_eq _ Limits.pullback.condition.symm
        _ = (z l₀ ≫ Limits.pullback.fst (D.obj l₀).hom U.ι) ≫ (D.obj l₀).hom :=
            (Category.assoc _ _ _).symm
        _ = (y' ≫ π l₀) ≫ (D.obj l₀).hom := eq_whisker (hy' l₀).symm _
        _ = y' ≫ p := by rw [Category.assoc, hπ l₀]
    obtain ⟨z₀, hz₀p, hz₀Z⟩ : ∃ z₀ : T ⟶ Limits.pullback p U.ι,
        z₀ ≫ Limits.pullback.snd p U.ι = z l₀ ≫ Limits.pullback.snd (D.obj l₀).hom U.ι ∧
          z₀ ≫ Limits.pullback.fst p U.ι = y' :=
      ⟨hpb.lift _ y' hxy, hpb.lift_fst _ _ _, hpb.lift_snd _ _ _⟩
    refine ⟨z₀, fun l => ?_, fun z' hz' => ?_⟩
    · refine Limits.pullback.hom_ext (f := (D.obj l).hom) (g := U.ι) ?_ ?_
      · calc (z₀ ≫ ρ l) ≫ Limits.pullback.fst (D.obj l).hom U.ι
            = z₀ ≫ (ρ l ≫ Limits.pullback.fst (D.obj l).hom U.ι) := Category.assoc _ _ _
          _ = z₀ ≫ (Limits.pullback.fst p U.ι ≫ π l) := whisker_eq _ (P1 l)
          _ = (z₀ ≫ Limits.pullback.fst p U.ι) ≫ π l := (Category.assoc _ _ _).symm
          _ = y' ≫ π l := eq_whisker hz₀Z _
          _ = z l ≫ Limits.pullback.fst (D.obj l).hom U.ι := hy' l
      · calc (z₀ ≫ ρ l) ≫ Limits.pullback.snd (D.obj l).hom U.ι
            = z₀ ≫ (ρ l ≫ Limits.pullback.snd (D.obj l).hom U.ι) := Category.assoc _ _ _
          _ = z₀ ≫ Limits.pullback.snd p U.ι := whisker_eq _ (P2 l)
          _ = z l₀ ≫ Limits.pullback.snd (D.obj l₀).hom U.ι := hz₀p
          _ = z l ≫ Limits.pullback.snd (D.obj l).hom U.ι := (hX l).symm
    · have e1 : z' ≫ Limits.pullback.snd p U.ι =
          z l₀ ≫ Limits.pullback.snd (D.obj l₀).hom U.ι := by
        calc z' ≫ Limits.pullback.snd p U.ι
            = z' ≫ (ρ l₀ ≫ Limits.pullback.snd (D.obj l₀).hom U.ι) :=
              whisker_eq _ (P2 l₀).symm
          _ = (z' ≫ ρ l₀) ≫ Limits.pullback.snd (D.obj l₀).hom U.ι :=
              (Category.assoc _ _ _).symm
          _ = z l₀ ≫ Limits.pullback.snd (D.obj l₀).hom U.ι := eq_whisker (hz' l₀) _
      have e2 : z' ≫ Limits.pullback.fst p U.ι = y' := by
        apply hyu
        intro l
        calc (z' ≫ Limits.pullback.fst p U.ι) ≫ π l
            = z' ≫ (Limits.pullback.fst p U.ι ≫ π l) := Category.assoc _ _ _
          _ = z' ≫ (ρ l ≫ Limits.pullback.fst (D.obj l).hom U.ι) := whisker_eq _ (P1 l).symm
          _ = (z' ≫ ρ l) ≫ Limits.pullback.fst (D.obj l).hom U.ι := (Category.assoc _ _ _).symm
          _ = z l ≫ Limits.pullback.fst (D.obj l).hom U.ι := eq_whisker (hz' l) _
      exact hpb.hom_ext (e1.trans hz₀p.symm) (e2.trans hz₀Z.symm)

  have hfstQC : ∀ l, QuasiCompact (Limits.pullback.fst (D.obj l).hom U.ι) := fun l =>
    MorphismProperty.of_isPullback (P := @QuasiCompact)
      (IsPullback.of_hasPullback (D.obj l).hom U.ι).flip inferInstance
  have hfstQS : ∀ l, QuasiSeparated (Limits.pullback.fst (D.obj l).hom U.ι) := fun l =>
    MorphismProperty.of_isPullback (P := @QuasiSeparated)
      (IsPullback.of_hasPullback (D.obj l).hom U.ι).flip inferInstance
  have hLc : ∀ l, CompactSpace ((D ⋙ wcEtBaseChange U.ι).obj l).left := fun l => by
    haveI : IsAffine ((𝟭 Scheme.{u}).obj (D.obj l).left) := hAff l
    haveI : IsAffine (D.obj l).left := hAff l
    exact @QuasiCompact.compactSpace_of_compactSpace _ _
      (Limits.pullback.fst (D.obj l).hom U.ι) (hfstQC l) inferInstance
  have hLq : ∀ l, QuasiSeparatedSpace ((D ⋙ wcEtBaseChange U.ι).obj l).left := fun l => by
    haveI : IsAffine ((𝟭 Scheme.{u}).obj (D.obj l).left) := hAff l
    haveI : IsAffine (D.obj l).left := hAff l
    exact @quasiSeparatedSpace_of_quasiSeparated _ _
      (Limits.pullback.fst (D.obj l).hom U.ι) inferInstance (hfstQS l)
  have C6 : ∀ {l l' : Λ} (t' : l ⟶ l'), IsAffineHom ((D ⋙ wcEtBaseChange U.ι).map t').left := by
    intro l l' t'
    have := hAff l
    have := hAff l'
    have Rr : IsPullback (Limits.pullback.snd (D.obj l').hom U.ι)
        (Limits.pullback.fst (D.obj l').hom U.ι) U.ι (D.obj l').hom :=
      (IsPullback.of_hasPullback (D.obj l').hom U.ι).flip
    have O : IsPullback (((D ⋙ wcEtBaseChange U.ι).map t').left ≫
        Limits.pullback.snd (D.obj l').hom U.ι) (Limits.pullback.fst (D.obj l).hom U.ι) U.ι
        ((D.map t').left ≫ (D.obj l').hom) := by
      rw [M2 t', MorphismProperty.Over.w (D.map t')]
      exact (IsPullback.of_hasPullback (D.obj l).hom U.ι).flip
    have L : IsPullback ((D ⋙ wcEtBaseChange U.ι).map t').left
        (Limits.pullback.fst (D.obj l).hom U.ι) (Limits.pullback.fst (D.obj l').hom U.ι)
        (D.map t').left :=
      IsPullback.of_right O (M1 t') Rr
    exact MorphismProperty.of_isPullback (P := @IsAffineHom) L.flip
      (isAffineHom_of_isAffine (D.map t').left)
  haveI : QuasiCompact (Limits.pullback.fst p U.ι) :=
    MorphismProperty.of_isPullback (P := @QuasiCompact) hpb inferInstance
  haveI : QuasiSeparated (Limits.pullback.fst p U.ι) :=
    MorphismProperty.of_isPullback (P := @QuasiSeparated) hpb inferInstance
  have hPc : CompactSpace ↥(Limits.pullback (C := Scheme.{u}) p U.ι) :=
    QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.fst p U.ι)
  have hPs : QuasiSeparatedSpace ↥(Limits.pullback (C := Scheme.{u}) p U.ι) :=
    quasiSeparatedSpace_of_quasiSeparated (Limits.pullback.fst p U.ι)
  obtain ⟨l, x, hx⟩ := wc_et_limit_pull_surj_qcqs_all (Limits.pullback.snd p U.ι) Λ
    (D ⋙ wcEtBaseChange U.ι) ρ P2' C2 C3 hLc hLq C6 hPc hPs m M y
  refine ⟨l, x, fun z hz1 hz2 E => ?_⟩
  have hρz : ρ l = z :=
    Limits.pullback.hom_ext ((P1 l).trans hz1.symm) ((P2 l).trans hz2.symm)
  subst hρz
  exact hx E

theorem wc_et_isolated_point_excision_transfer : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] {X V Wt ZV Z' : Scheme.{u}} (xb : Spec (.of Ω) ⟶ X) [IsClosedImmersion xb] (φ : V ⟶ X) [Etale φ] [IsSeparated φ] (iV : ZV ⟶ V) (gV : ZV ⟶ Spec (.of Ω)), IsPullback gV iV xb φ → ∀ (s : Wt ⟶ V) (w' : Wt ⟶ X), s ≫ φ = w' → ∀ (w0 : Wt), (∀ p : Wt, p ⤳ w0) → φ (s w0) = xb (IsLocalRing.closedPoint Ω) → ∀ (i' : Z' ⟶ Wt) (g' : Z' ⟶ Spec (.of Ω)), IsPullback g' i' xb w' → ∀ (m : ℕ) (Dx : wcEtPullData xb m) (DV : wcEtPullData iV m) (D' : wcEtPullData i' m) (Es : wcEtPullData s m) (Ew : wcEtPullData w' m) (γs : wcEtSuppObj D' ⟶ Es.Φ.obj (wcEtSuppObj DV)) (γw : wcEtSuppObj D' ⟶ Ew.Φ.obj (wcEtSuppObj Dx)), wcEtSuppUnitMap D' ≫ γs = Es.μ.inv ≫ Es.Φ.map (wcEtSuppUnitMap DV) → wcEtSuppUnitMap D' ≫ γw = Ew.μ.inv ≫ Ew.Φ.map (wcEtSuppUnitMap Dx) → ∀ (q : ℕ) (θV : wcEtSuppExt DV q), ∃ θ : wcEtSuppExt Dx q, wcEtSuppRestr Dx Ew D' γw q θ = wcEtSuppRestr DV Es D' γs q θV :=
by
  intro Ω _ _ X V Wt ZV Z' xb _ φ _ _ iV gV hV s w' hsw w0 hloc hpt i' g' h' m Dx DV D' Es Ew
    γs γw hγs hγw q θV

  obtain ⟨O, hvO, hiso⟩ := wc_etale_fibre_point_isolated φ (s w0)
  have hsub : Set.range s ⊆ Set.range O.ι := by
    rintro _ ⟨p, rfl⟩
    rw [Scheme.Opens.range_ι]
    exact ((hloc p).map s.continuous).mem_open O.isOpen hvO
  obtain ⟨σ, hσ⟩ : ∃ σ : Wt ⟶ O, σ ≫ O.ι = s :=
    ⟨IsOpenImmersion.lift O.ι s hsub, IsOpenImmersion.lift_fac _ _ _⟩
  obtain ⟨v', hv'⟩ : s w0 ∈ Set.range O.ι := by
    rw [Scheme.Opens.range_ι]; exact hvO
  have hv'x : (O.ι ≫ φ) v' = xb (IsLocalRing.closedPoint Ω) := by
    rw [Scheme.Hom.comp_apply, hv', hpt]
  obtain ⟨t, ht, htv⟩ := wc_etale_lift_alg_closed_point Ω (O.ι ≫ φ) xb v' hv'x
  haveI : IsClosedImmersion (t ≫ (O.ι ≫ φ)) := by rw [ht]; infer_instance
  haveI : IsClosedImmersion t := IsClosedImmersion.of_comp t (O.ι ≫ φ)
  have huniq : ∀ y : ((O : V.Opens) : Scheme.{u}), (O.ι ≫ φ) y = xb (IsLocalRing.closedPoint Ω) →
      y = t (IsLocalRing.closedPoint Ω) := by
    intro y hy
    rw [Scheme.Hom.comp_apply, ← hpt] at hy
    have hyO : O.ι y ∈ O := by
      have hr : O.ι y ∈ Set.range O.ι := ⟨y, rfl⟩
      rwa [Scheme.Opens.range_ι] at hr
    have h1 := hiso _ hyO hy
    rw [htv]
    exact O.ι.isOpenEmbedding.isEmbedding.injective (h1.trans hv'.symm)
  have hP : IsPullback (𝟙 (Spec (.of Ω))) t xb (O.ι ≫ φ) :=
    wc_et_point_fibre_isPullback Ω _ _ (O.ι ≫ φ) xb t ht huniq

  haveI : IsClosedImmersion iV :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hV inferInstance
  haveI : IsClosedImmersion i' :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) h' inferInstance
  have hepi : Epi (wcEtSuppUnitMap D') := wc_et_supp_unit_epi i' D'
  have hwA : 𝟙 _ ≫ xb = (t ≫ O.ι) ≫ φ := by rw [Category.assoc]; exact hP.w
  obtain ⟨gZ, hgZ1, hgZ2⟩ : ∃ gZ : Spec (.of Ω) ⟶ ZV, gZ ≫ gV = 𝟙 _ ∧ gZ ≫ iV = t ≫ O.ι :=
    ⟨hV.lift _ _ hwA, hV.lift_fst _ _ _, hV.lift_snd _ _ _⟩
  have sqA : IsPullback gZ t iV O.ι := by
    refine IsPullback.of_right ?_ hgZ2 hV
    rw [hgZ1]; exact hP
  have hw2 : g' ≫ xb = (i' ≫ σ) ≫ (O.ι ≫ φ) := by
    rw [h'.w, ← hsw, ← hσ]; simp only [Category.assoc]
  have hcomm : g' ≫ t = i' ≫ σ := by
    have e1 := hP.lift_fst g' (i' ≫ σ) hw2
    have e2 := hP.lift_snd g' (i' ≫ σ) hw2
    rw [Category.comp_id] at e1
    rw [← e1]; exact e2
  have sqB : IsPullback g' i' t σ := by
    refine IsPullback.of_right ?_ hcomm hP
    rw [Category.comp_id, ← Category.assoc, hσ, hsw]; exact h'
  obtain ⟨Dt⟩ := wc_et_zmod_pull_data_exists t m
  obtain ⟨Eι⟩ := wc_et_zmod_pull_data_exists O.ι m
  obtain ⟨Eφ⟩ := wc_et_zmod_pull_data_exists (O.ι ≫ φ) m
  obtain ⟨Eσ⟩ := wc_et_zmod_pull_data_exists σ m
  obtain ⟨γι, hγι, -⟩ := wc_et_closed_supp_base_change iV O.ι t gZ sqA DV Eι Dt
  obtain ⟨γφ, hγφ, -⟩ := wc_et_closed_supp_base_change xb (O.ι ≫ φ) t (𝟙 _) hP Dx Eφ Dt
  obtain ⟨γσ, hγσ, -⟩ := wc_et_closed_supp_base_change t σ i' g' sqB Dt Eσ D'
  obtain ⟨θ, hθ⟩ := wc_et_supp_restr_etale_excision_surjective (O.ι ≫ φ) xb t (𝟙 _) hP
    inferInstance Dx Eφ Dt γφ hγφ q (wcEtSuppRestr DV Eι Dt γι q θV)
  have C1 := wc_et_supp_restr_comp (O.ι ≫ φ) σ w' (by rw [← Category.assoc, hσ, hsw])
    Dx Dt D' Eφ Eσ Ew γφ γσ γw hγφ hγσ hγw hepi q θ
  have C2 := wc_et_supp_restr_comp O.ι σ s hσ DV Dt D' Eι Eσ Es γι γσ γs hγι hγσ hγs hepi q θV
  exact ⟨θ, by rw [C1, hθ, ← C2]⟩

theorem wc_et_shens_closed_fibre_local_point : ∀ {X : Scheme.{u}} (A : Type u) [CommRing A] [IsLocalRing A] (g : X ⟶ Spec (.of A)) (x : X) (xs : ↥(Limits.pullback g (wcQmSp A))) (hxs : Limits.pullback.fst g (wcQmSp A) xs = x) (B : Type u) [CommRing B] [IsLocalRing B] (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ'] (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt X x)) (Scheme.Etale.forget X)) (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ X), wcHalShData x B Λ' W'' φ' a' → ∃ w0 : ↥(Limits.pullback a' (Limits.pullback.fst g (wcQmSp A))), (∀ p, p ⤳ w0) ∧ Limits.pullback.snd a' (Limits.pullback.fst g (wcQmSp A)) w0 = xs :=
by
  classical
  intro X A _ _ g x xs hxs B _ _ Λ' _ _ W'' φ' a' hsh

  let φ : A →+* B := (Spec.preimage (a' ≫ g)).hom
  have hφ : Spec.map (CommRingCat.ofHom φ) = a' ≫ g := by
    rw [CommRingCat.ofHom_hom]; exact Spec.map_preimage _
  let J : Ideal B := Ideal.map φ (IsLocalRing.maximalIdeal A)

  obtain ⟨-, -, -, -, -, ε, -, he⟩ := hsh
  have hgeom : ∀ z, wcEtGeomPt X x z = x := by
    intro z
    rw [wcEtGeomPt, Scheme.Hom.comp_apply]
    exact Scheme.fromSpecResidueField_apply x _
  have hres : ∀ z, (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) z =
      IsLocalRing.closedPoint B :=
    fun z => IsLocalRing.PrimeSpectrum.comap_residue B z
  have ha : a' (IsLocalRing.closedPoint B) = x := by
    have h1 := congrArg (fun f => f (IsLocalRing.closedPoint
      (AlgebraicClosure (X.residueField x)))) he
    have h1' := (Scheme.Hom.comp_apply _ _ _).symm.trans
      ((Scheme.Hom.comp_apply _ _ _).symm.trans (h1.trans (hgeom _)))
    rw [hres] at h1'
    exact h1'
  have hgx : g x = IsLocalRing.closedPoint A := by
    rw [← hxs]
    exact (Scheme.Hom.comp_apply _ _ xs).symm.trans
      ((congrArg (fun f => f xs) (Limits.pullback.condition (f := g) (g := wcQmSp A))).trans
        ((Scheme.Hom.comp_apply _ _ xs).trans (IsLocalRing.PrimeSpectrum.comap_residue A _)))
  have hclosed : (Spec.map (CommRingCat.ofHom φ)) (IsLocalRing.closedPoint B) =
      IsLocalRing.closedPoint A := by
    rw [hφ]
    exact (Scheme.Hom.comp_apply a' g _).trans ((congrArg g ha).trans hgx)
  have hcomap : Ideal.comap φ (IsLocalRing.maximalIdeal B) = IsLocalRing.maximalIdeal A := by
    have := congrArg PrimeSpectrum.asIdeal hclosed
    exact this
  have hJ : J ≠ ⊤ := by
    intro hJt
    have hle : J ≤ IsLocalRing.maximalIdeal B := by
      rw [Ideal.map_le_iff_le_comap, hcomap]
    rw [hJt, top_le_iff] at hle
    exact (IsLocalRing.maximalIdeal.isMaximal B).ne_top hle
  have h2 : IsPullback (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)))
      (Spec.map (CommRingCat.ofHom (Ideal.quotientMap J φ
        (Ideal.le_comap_map (I := IsLocalRing.maximalIdeal A)))))
      (Spec.map (CommRingCat.ofHom φ))
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal A)))) := by
    set I := IsLocalRing.maximalIdeal A
    apply AlgebraicGeometry.isPullback_SpecMap_of_isPushout
    have hcomm : ∀ r : A, Ideal.quotientMap J φ (Ideal.le_comap_map (I := I))
        (Ideal.Quotient.mk I r) = Ideal.Quotient.mk J (φ r) := fun r =>
      Ideal.quotientMap_mk
    have w : CommRingCat.ofHom φ ≫ CommRingCat.ofHom (Ideal.Quotient.mk J) =
        CommRingCat.ofHom (Ideal.Quotient.mk I) ≫
        CommRingCat.ofHom (Ideal.quotientMap J φ (Ideal.le_comap_map (I := I))) := by
      ext r
      exact (hcomm r).symm
    have key : ∀ (s : Limits.PushoutCocone (CommRingCat.ofHom φ)
        (CommRingCat.ofHom (Ideal.Quotient.mk I))) (r : A),
        s.inl.hom (φ r) = s.inr.hom (Ideal.Quotient.mk I r) := by
      intro s r
      have := congrArg (fun ψ => ψ.hom r) s.condition
      simpa using this
    have H : ∀ (s : Limits.PushoutCocone (CommRingCat.ofHom φ)
        (CommRingCat.ofHom (Ideal.Quotient.mk I))), J ≤ RingHom.ker s.inl.hom := by
      intro s
      rw [Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap, RingHom.mem_ker, key s x, Ideal.Quotient.eq_zero_iff_mem.mpr hx,
        map_zero]
    refine IsPushout.of_isColimit' ⟨w⟩ (Limits.PushoutCocone.IsColimit.mk w
      (fun s => CommRingCat.ofHom (Ideal.Quotient.lift _ s.inl.hom (fun a ha => H s ha)))
      ?_ ?_ ?_)
    · intro s
      ext x
      exact Ideal.Quotient.lift_mk J s.inl.hom (fun a ha => H s ha)
    · intro s
      ext x
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.coe_comp,
        Function.comp_apply, hcomm, Ideal.Quotient.lift_mk]
      exact key s x
    · intro s m h1 _
      ext x
      have := congrArg (fun ψ => ψ.hom x) h1
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.coe_comp,
        Function.comp_apply] at this
      simp only [CommRingCat.hom_ofHom, Ideal.Quotient.lift_mk]
      exact this
  have h1 : IsPullback (Limits.pullback.fst a' (Limits.pullback.fst g (wcQmSp A)))
      (Limits.pullback.snd a' (Limits.pullback.fst g (wcQmSp A)) ≫
        Limits.pullback.snd g (wcQmSp A))
      (Spec.map (CommRingCat.ofHom φ))
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal A)))) := by
    rw [hφ]
    exact (IsPullback.paste_horiz
      (IsPullback.of_hasPullback a' (Limits.pullback.fst g (wcQmSp A))).flip
      (IsPullback.of_hasPullback g (wcQmSp A)).flip).flip
  let E := IsPullback.isoIsPullback _ _ h1 h2
  have hfst : E.hom ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)) =
      Limits.pullback.fst a' (Limits.pullback.fst g (wcQmSp A)) :=
    IsPullback.isoIsPullback_hom_fst _ _ _ _

  haveI : Nontrivial (B ⧸ J) := Ideal.Quotient.nontrivial_iff.mpr hJ
  haveI : IsLocalRing (B ⧸ J) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
  haveI : IsLocalHom (Ideal.Quotient.mk J) :=
    Function.Surjective.isLocalHom _ Ideal.Quotient.mk_surjective

  obtain ⟨cp, hcp⟩ : ∃ cp : ↥(Spec (.of (B ⧸ J))), cp = IsLocalRing.closedPoint (B ⧸ J) :=
    ⟨_, rfl⟩
  have hEE : E.hom (E.inv cp) = cp :=
    (Scheme.Hom.comp_apply E.inv E.hom cp).symm.trans
      (by rw [Iso.inv_hom_id]; first | rfl | exact Scheme.id_apply _ _ | simp)
  refine ⟨E.inv cp, ?_, ?_⟩
  · intro p
    have hs1 : E.hom p ⤳ cp := by
      subst hcp
      exact IsLocalRing.specializes_closedPoint _
    have hs2 := hs1.map E.inv.continuous
    have hs3 : E.inv (E.hom p) = p :=
      (Scheme.Hom.comp_apply E.hom E.inv p).symm.trans
        (by rw [Iso.hom_inv_id]; first | rfl | exact Scheme.id_apply _ _ | simp)
    rwa [hs3] at hs2
  ·
    have hpr1 : Limits.pullback.fst a' (Limits.pullback.fst g (wcQmSp A))
        (E.inv cp) = IsLocalRing.closedPoint B := by
      refine (congrArg (fun f => f (E.inv cp)) hfst).symm.trans
        ((Scheme.Hom.comp_apply _ _ _).trans ?_)
      rw [hEE]
      subst hcp
      exact IsLocalRing.comap_closedPoint (Ideal.Quotient.mk J)

    haveI hqm : IsClosedImmersion (wcQmSp A) :=
      IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
    haveI : IsClosedImmersion (Limits.pullback.fst g (wcQmSp A)) :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion)
        (IsPullback.of_hasPullback g (wcQmSp A)).flip inferInstance
    apply (Limits.pullback.fst g (wcQmSp A)).isClosedEmbedding.isEmbedding.injective
    have hc := congrArg (fun f => f (E.inv cp))
      (Limits.pullback.condition (f := a') (g := Limits.pullback.fst g (wcQmSp A)))
    simp only [Scheme.Hom.comp_apply] at hc
    rw [hxs, ← hc, hpr1, ha]

theorem wc_et_tpl_dsl_supp_restr_surj_all (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (k : ℕ) (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left
      (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left))
    (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left)
    (hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a)
    (x : ↥(Limits.pullback D.f a)) (hx : Limits.pullback.fst D.f a x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Limits.pullback D.f a) x))
      (Scheme.Etale.forget (Limits.pullback D.f a)))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ Limits.pullback D.f a)
    (hsh : wcHalShData x B Λ' W'' φ' a')
    (xs : ↥(Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)))
    (hxs : Limits.pullback.fst (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A) xs = x)
    (Dx : wcEtPullData (wcEtGeomPt (Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)) xs) (ℓ ^ k))
    (Dw : wcEtPullData (Limits.pullback.snd a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (ℓ ^ k))
    (D' : wcEtPullData (Limits.pullback.snd (wcEtGeomPt (Limits.pullback (C := Scheme.{u}) (Limits.pullback.snd D.f a) (wcQmSp A)) xs) (Limits.pullback.snd a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)))) (ℓ ^ k))
    (γ : wcEtSuppObj D' ⟶ Dw.Φ.obj (wcEtSuppObj Dx))
    (hγ : wcEtSuppUnitMap D' ≫ γ = Dw.μ.inv ≫ Dw.Φ.map (wcEtSuppUnitMap Dx))
    (hac : ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtZModExt (Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (ℓ ^ k) q)) :
    ∀ q : ℕ, 1 ≤ q → Function.Surjective (wcEtSuppRestr Dx Dw D' γ q) :=
by
  classical

  have main : ∀ (Xs : Scheme.{u}) [IsLocallyNoetherian Xs] (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (xb : Spec (.of Ω) ⟶ Xs) [IsClosedImmersion xb] (Ws : Scheme.{u}) (w : Ws ⟶ Xs)
      (Λ₀ : Type u) [SmallCategory Λ₀] [IsCofiltered Λ₀] (Dsys : Λ₀ ⥤ Xs.Etale)
      (π : ∀ l, Ws ⟶ (Dsys.obj l).left), (∀ l, π l ≫ (Dsys.obj l).hom = w) →
      (∀ {l l' : Λ₀} (t : l ⟶ l'), π l ≫ (Dsys.map t).left = π l') →
      (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (Dsys.obj l).left),
        (∀ {l l' : Λ₀} (t : l ⟶ l'), z l ≫ (Dsys.map t).left = z l') →
        ∃! z₀ : T ⟶ Ws, ∀ l, z₀ ≫ π l = z l) →
      (∀ l, IsAffine (Dsys.obj l).left) → IsAffine Ws → (∀ l, IsSeparated (Dsys.obj l).hom) →
      ∀ (w0 : Ws), (∀ p : Ws, p ⤳ w0) → w w0 = xb (IsLocalRing.closedPoint Ω) →
      ∀ (m : ℕ), 0 < m → (∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtZModExt Ws m q)) →
      ∀ (Dx : wcEtPullData xb m) (Dw : wcEtPullData w m)
        (D' : wcEtPullData (Limits.pullback.snd xb w) m)
        (γ : wcEtSuppObj D' ⟶ Dw.Φ.obj (wcEtSuppObj Dx)),
        wcEtSuppUnitMap D' ≫ γ = Dw.μ.inv ≫ Dw.Φ.map (wcEtSuppUnitMap Dx) →
        ∀ q : ℕ, 1 ≤ q → Function.Surjective (wcEtSuppRestr Dx Dw D' γ q) := by
    intro Xs _ Ω _ _ xb _ Ws w Λ₀ _ _ Dsys π hπ1 hπ3 hπ4 hEaff hWaff hsep w0 hspec hpt m hm hac0
      Dx Dw D' γ hγ q hq θ'
    obtain ⟨M, rfl⟩ : ∃ M, q = M + 1 := ⟨q - 1, by omega⟩
    let U : Xs.Opens := ⟨(Set.range xb)ᶜ, xb.isClosedEmbedding.isClosed_range.isOpen_compl⟩
    have hU : (U : Set Xs) = (Set.range xb)ᶜ := rfl
    haveI : IsClosedImmersion (Limits.pullback.snd xb w) :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) (IsPullback.of_hasPullback xb w)
        inferInstance
    have hr' : Set.range (Limits.pullback.fst w U.ι) = (Set.range (Limits.pullback.snd xb w))ᶜ := by
      rw [Scheme.Pullback.range_fst, Scheme.Opens.range_ι, hU, Set.preimage_compl,
        Scheme.Pullback.range_snd]

    have hθ0 : wcEtSuppClass D' (M + 1) θ' = 0 := @Subsingleton.elim _ (hac0 (M + 1) (by omega)) _ _
    obtain ⟨a'', ha''⟩ := wc_et_supp_open_boundary_lift_any (Limits.pullback.snd xb w)
      (Limits.pullback.fst w U.ι) hr' m hm D' M θ' hθ0

    obtain ⟨l, b, hb⟩ := wc_et_open_system_level_lift w U Λ₀ Dsys π hπ1 hπ3 hπ4 hEaff hWaff m M a''
    haveI : Etale (Dsys.obj l).hom := (Dsys.obj l).prop
    haveI : IsSeparated (Dsys.obj l).hom := hsep l
    haveI : IsClosedImmersion (Limits.pullback.snd xb (Dsys.obj l).hom) :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion)
        (IsPullback.of_hasPullback xb (Dsys.obj l).hom) inferInstance
    have hrV : Set.range (Limits.pullback.fst (Dsys.obj l).hom U.ι) =
        (Set.range (Limits.pullback.snd xb (Dsys.obj l).hom))ᶜ := by
      rw [Scheme.Pullback.range_fst, Scheme.Opens.range_ι, hU, Set.preimage_compl,
        Scheme.Pullback.range_snd]
    obtain ⟨z, hz1, hz2⟩ : ∃ z : Limits.pullback w U.ι ⟶ Limits.pullback (Dsys.obj l).hom U.ι,
        z ≫ Limits.pullback.fst (Dsys.obj l).hom U.ι = Limits.pullback.fst w U.ι ≫ π l ∧
        z ≫ Limits.pullback.snd (Dsys.obj l).hom U.ι = Limits.pullback.snd w U.ι :=
