            y.asIdeal}, by rw [heq]; exact (PrimeSpectrum.isClosed_zeroLocus _).isOpen_compl⟩, rfl⟩
  obtain ⟨eq1⟩ := hE1 Ou hOu W hW (4 * e)
  have hOu0 : Subsingleton (wcEtCoh (Ou : Scheme.{u}) ℓ (4 * e)) := by
    haveI := hW0
    exact eq1.subsingleton

  obtain ⟨τ, hτ⟩ : ∃ τ : Fin (2 * e + 1 + 1) → Fin (2 * e + 1 + 1),
      ∀ p, (τ p).val = if p.val % 2 = 0 then p.val + 1 else p.val - 1 :=
