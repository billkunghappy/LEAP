  have hm0 : 0 < ℓ ^ k := pow_pos (Fact.out : Nat.Prime ℓ).pos k

  have hinj : Function.Injective (Spec.preimage ξ).hom := by
    rw [injective_iff_map_eq_zero]
    intro a ha
