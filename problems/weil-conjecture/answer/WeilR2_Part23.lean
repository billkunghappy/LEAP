        · rw [hyodd p h1 h2, hvodd p h1 h2]
      have hex : ψ.comp φ = ρ.hom := by
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext
        · intro a
          simp only [RingHom.comp_apply]
          rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
          rw [← RingHom.comp_apply φ, hφA, hψalg]
          rfl
        · intro p
          simp only [RingHom.comp_apply]
          change ψ (φ (x p)) = ρ.hom (x p)
          by_cases h0 : p.val = 0
          · have : p = p0 := Fin.ext h0
            rw [this, hφ0, hψy, hv0]
          by_cases h1 : p.val = 1
          · have : p = p1 := Fin.ext h1
            rw [this]
            have hx1 : φ (x p1) = y p1 + y p0 * y p1 -
                ∑ a, ∑ b, algebraMap A _ (wcSrmCh A r a b) * y a * y b := by
              show φ (Ideal.Quotient.mk IR _) = _
              rw [hφX, hF1]
              simp only [map_sub, map_add, map_mul, map_sum, ← MvPolynomial.algebraMap_eq,
                Ideal.Quotient.mk_algebraMap]
              rfl
            rw [hx1]
            simp only [map_sub, map_add, map_mul, map_sum, hψalg, hψy]
            rw [Lch g v, htail v hvev hvodd, hv1]
            ring
          by_cases h2 : p.val % 2 = 0
          · rw [hφev p h0 h2, map_mul, hψy, hψy, hv0, hvev p h0 h2, mul_comm, hβ p h2]
          · rw [hφodd p h1 h2, hψy, hvodd p h1 h2]
      refine ⟨CommRingCat.ofHom ψ, ?_, ?_⟩
      · apply CommRingCat.hom_ext
        rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom]
        exact hex
      · intro ψ₂ hψ₂
        have h2 : ψ₂.hom.comp φ = ρ.hom := by
          rw [← hψ₂, CommRingCat.hom_comp, CommRingCat.hom_ofHom]
        apply CommRingCat.hom_ext
        rw [CommRingCat.hom_ofHom]
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext
        · intro a
          simp only [RingHom.comp_apply]
          rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap, hψalg]
          rw [← hφA, RingHom.comp_apply, ← RingHom.comp_apply ψ₂.hom, h2]
