theorem wc_et_tpl_excision_faithful (A : Type u) [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : IsUnit ((ℓ : ℕ) : A)) (k n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (π : A) (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (c : Matrix (Fin n) (Fin n) A)
    (hc : IsUnit (c + c.transpose).det) (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (ξ : Spec (.of Ω) ⟶ Spec (.of A)) (σ : Spec (.of Ω) ⟶ Spec (.of Ω)) (hσ : σ ≫ ξ = ξ)
    (U' : Scheme.{u}) (e' : U' ⟶ Spec (.of (wcQuadModelRing A n π c))) (he' : Etale e')
    (x₀ : Spec (.of (IsLocalRing.ResidueField A)) ⟶
      Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A))
    (v₀ : Spec (.of (IsLocalRing.ResidueField A)) ⟶
      Limits.pullback (e' ≫ wcQuadModelStr A n π c) (wcQmSp A))
    (hx₀ : IsClosedImmersion x₀) (hv₀ : IsClosedImmersion v₀)
    (hpb : IsPullback (𝟙 _) v₀ x₀ (wcEtxcJs (wcQuadModelStr A n π c) e'))
    (hrange : ∀ y : ↥(Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A)), y ∈ Set.range x₀ ↔
      ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
        PrimeSpectrum.asIdeal (Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A) y))
    (DX : wcEtxcDatum (wcQuadModelStr A n π c) ξ σ ℓ k)
    (DjZ : wcEtPullData (wcEtxcJs (wcQuadModelStr A n π c) e') (ℓ ^ k)) :
    haveI := DjZ.additive
    letI := HasDerivedCategory.standard
      (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A)) (ℓ ^ k)))
    letI := HasDerivedCategory.standard
      (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (e' ≫ wcQuadModelStr A n π c) (wcQmSp A)) (ℓ ^ k)))
    ℓ ^ (k - 1) • (DerivedCategory.Q.map ((DjZ.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map DX.TPsi) -
        𝟙 (DerivedCategory.Q.obj ((DjZ.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj DX.Psi))) = 0 →
      ℓ ^ (k - 1) • (DerivedCategory.Q.map DX.TPsi - 𝟙 (DerivedCategory.Q.obj DX.Psi)) = 0 :=
by
  intro hU

  have conj : ∀ {𝒞 : Type _} [Category 𝒞] [Preadditive 𝒞] (N : ℕ) {P Q : 𝒞}
      (a : P ⟶ P) (b : Q ⟶ Q) (χ' : P ≅ Q),
      a ≫ χ'.hom = χ'.hom ≫ b → N • (b - 𝟙 Q) = 0 → N • (a - 𝟙 P) = 0 := by
    intro 𝒞 _ _ N P Q a b χ' h hb
    have hd : a - 𝟙 P = χ'.hom ≫ (b - 𝟙 Q) ≫ χ'.inv := by
      rw [Preadditive.sub_comp, Preadditive.comp_sub, Category.id_comp, Iso.hom_inv_id,
        ← reassoc_of% h, Iso.hom_inv_id, Category.comp_id]
    rw [hd, ← Preadditive.comp_nsmul, ← Preadditive.nsmul_comp, hb, Limits.zero_comp,
      Limits.comp_zero]


  have key : ∀ {C₁ C₂ : Type (u+2)} [Category.{u+1} C₁] [Category.{u+1} C₂] [Abelian C₁]
      [Abelian C₂] [HasDerivedCategory C₁] [HasDerivedCategory C₂] (ρ : C₁ ⥤ C₂) [ρ.Additive]
      [Limits.PreservesFiniteLimits ρ] [Limits.PreservesFiniteColimits ρ]
      (L : C₂ ⥤ C₁) (hL1 : L.Additive) (hL2 : Limits.PreservesFiniteLimits L)
      (hL3 : Limits.PreservesFiniteColimits L) (adj : L ⊣ ρ) (One : C₁) (Ψ : CochainComplex C₁ ℤ) [Ψ.IsStrictlyGE 0]
      (eΨ : (HomologicalComplex.single C₁ (ComplexShape.up ℤ) 0).obj One ⟶ Ψ) (TΨ : Ψ ⟶ Ψ)
      (N : ℕ), eΨ ≫ TΨ = eΨ →
      (∀ q : ℤ, IsIso (adj.counit.app ((CochainComplex.mappingCone eΨ).homology q))) →
      N • (DerivedCategory.Q.map ((ρ.mapHomologicalComplex (ComplexShape.up ℤ)).map TΨ) -
        𝟙 (DerivedCategory.Q.obj ((ρ.mapHomologicalComplex (ComplexShape.up ℤ)).obj Ψ))) = 0 →
      N • (DerivedCategory.Q.map TΨ - 𝟙 (DerivedCategory.Q.obj Ψ)) = 0 := by
    intro C₁ C₂ _ _ _ _ _ _ ρ _ _ _ L hL1 hL2 hL3 adj One Ψ _ eΨ TΨ N he hcounit hρU
    have hV1 : DerivedCategory.Q.map eΨ ≫ (N • (DerivedCategory.Q.map TΨ - 𝟙 _)) = 0 := by
      rw [Preadditive.comp_nsmul, Preadditive.comp_sub, ← CategoryTheory.Functor.map_comp, he,
        Category.comp_id, sub_self, smul_zero]
    obtain ⟨W, hW⟩ := Pretriangulated.Triangle.yoneda_exact₂ _
      (DerivedCategory.mappingCone_triangle_distinguished eΨ) _ hV1
    change DerivedCategory.Q.obj (CochainComplex.mappingCone eΨ) ⟶ DerivedCategory.Q.obj Ψ at W
    change N • (DerivedCategory.Q.map TΨ - 𝟙 _) =
      DerivedCategory.Q.map (CochainComplex.mappingCone.inr eΨ) ≫ W at hW
    have hρE : ρ.mapDerivedCategory.map
        (N • (DerivedCategory.Q.map TΨ - 𝟙 (DerivedCategory.Q.obj Ψ))) = 0 := by
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_sub,
        CategoryTheory.Functor.map_id]
      exact conj N _ _ (ρ.mapDerivedCategoryFactors.app Ψ)
        (ρ.mapDerivedCategoryFactors_hom_naturality TΨ) hρU
    have hρW0 : ρ.mapDerivedCategory.map
        (DerivedCategory.Q.map (CochainComplex.mappingCone.inr eΨ) ≫ W) = 0 := by
      rw [← hW]; exact hρE
    have hρW := wc_dcat_kill_through_cone_ge ρ One Ψ eΨ W hρW0
    have hW0 := wc_dcat_faithful_of_counit_iso ρ L adj (CochainComplex.mappingCone eΨ) hcounit _ W hρW
    rw [hW, hW0, Limits.comp_zero]

  have hjs : Etale (wcEtxcJs (wcQuadModelStr A n π c) e') := by
    have hsnd : wcEtxcJs (wcQuadModelStr A n π c) e' ≫
        Limits.pullback.snd (wcQuadModelStr A n π c) (wcQmSp A) =
        Limits.pullback.snd (e' ≫ wcQuadModelStr A n π c) (wcQmSp A) := by
      unfold wcEtxcJs Limits.pullback.map
      first
        | exact (Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _)
        | exact Limits.pullback.lift_snd _ _ _
    have h1 : IsPullback (wcEtxcJs (wcQuadModelStr A n π c) e' ≫
        Limits.pullback.snd (wcQuadModelStr A n π c) (wcQmSp A))
        (Limits.pullback.fst (e' ≫ wcQuadModelStr A n π c) (wcQmSp A)) (wcQmSp A)
        (e' ≫ wcQuadModelStr A n π c) := by
      rw [hsnd]
      exact (IsPullback.of_hasPullback _ _).flip
    have h2 : wcEtxcJs (wcQuadModelStr A n π c) e' ≫
        Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A) =
        Limits.pullback.fst (e' ≫ wcQuadModelStr A n π c) (wcQmSp A) ≫ e' := by
      unfold wcEtxcJs Limits.pullback.map
      first
        | exact Limits.pullback.lift_fst _ _ _
        | exact (Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _)
    have h3 := IsPullback.of_right h1 h2
      (IsPullback.of_hasPullback (wcQuadModelStr A n π c) (wcQmSp A)).flip
    exact MorphismProperty.of_isPullback (P := @Etale) h3.flip he'
  let T : (Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A)).Etale :=
    MorphismProperty.Over.mk ⊤ (wcEtxcJs (wcQuadModelStr A n π c) e') hjs

  haveI := hx₀
  haveI := DjZ.additive
  haveI := DjZ.presLim
  haveI := DjZ.presColim
  haveI := DX.Dh.additive
  haveI := DX.Dg.additive

  obtain ⟨L, adj, hLadd, hLlim, hLcolim⟩ := wc_et_etale_slice_exact_left_adjoint T (ℓ ^ k) DjZ
  haveI := hLadd
  haveI := hLlim
  haveI := hLcolim

  let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
    (wcEtBaseChange (Limits.pullback.fst (wcQuadModelStr A n π c) ξ)) _ _ DX.Dh.cont DX.Dh.φ
  haveI : P.Additive := Adjunction.right_adjoint_additive DX.Dh.adj
  let eK := (HomologicalComplex.single (SheafOfModules.{u+1}
        (wcEtZModRing (Spec (.of (wcQuadModelRing A n π c))) (ℓ ^ k))) (ComplexShape.up ℤ) 0).map
        (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
          (wcEtBaseChange (Limits.pullback.fst (wcQuadModelStr A n π c) ξ)) _ _ DX.Dh.cont DX.Dh.φ) ≫
      (HomologicalComplex.singleMapHomologicalComplex P (ComplexShape.up ℤ) 0).inv.app
        (SheafOfModules.unit (wcEtZModRing (Limits.pullback (wcQuadModelStr A n π c) ξ) (ℓ ^ k))) ≫
      (P.mapHomologicalComplex (ComplexShape.up ℤ)).map DX.I.ι'
  let eΨ : (HomologicalComplex.single (SheafOfModules.{u+1}
        (wcEtZModRing (Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A)) (ℓ ^ k)))
        (ComplexShape.up ℤ) 0).obj (SheafOfModules.unit
          (wcEtZModRing (Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A)) (ℓ ^ k))) ⟶ DX.Psi :=
    (HomologicalComplex.single (SheafOfModules.{u+1}
        (wcEtZModRing (Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A)) (ℓ ^ k)))
        (ComplexShape.up ℤ) 0).map DX.Dg.μ.inv ≫
      (HomologicalComplex.singleMapHomologicalComplex DX.Dg.Φ (ComplexShape.up ℤ) 0).inv.app
        (SheafOfModules.unit (wcEtZModRing (Spec (.of (wcQuadModelRing A n π c))) (ℓ ^ k))) ≫
      (DX.Dg.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map eK

  have he : eΨ ≫ DX.TPsi = eΨ :=
    wc_et_ePsi_T DX.hσQ1 DX.Dh DX.DσQ DX.Dg DX.I DX.hφ DX.t DX.ht

  haveI hGE : DX.Psi.IsStrictlyGE 0 := by
    rw [CochainComplex.isStrictlyGE_iff]
    intro i hi
    exact DX.Dg.Φ.map_isZero (P.map_isZero
      (CochainComplex.isZero_of_isStrictlyGE DX.I.cochainComplex 0 i hi))

  have hcounit : ∀ q : ℤ, IsIso (adj.counit.app ((CochainComplex.mappingCone eΨ).homology q)) := by
    intro q
    refine wc_et_point_supp_counit_isIso x₀ T v₀ hpb (ℓ ^ k) DjZ L adj _ ?_
    intro W hW
    apply wc_et_module_sections_subsingleton_of_stalks (ℓ ^ k) _ W
    intro v
    apply wc_et_cone_homology_stalk_subsingleton (ℓ ^ k) (W.hom v) eΨ ?_ q
    intro q'
    have hb : ∃ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∉
        PrimeSpectrum.asIdeal (Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A) (W.hom v)) :=
      not_forall.mp ((not_congr (hrange (W.hom v))).mp (hW v))
    rcases eq_or_ne q' 0 with hq | hq
    · subst hq
      exact wc_etxc_ePsi_stalk_bij_off_origin_zero A ℓ hℓ k n π c hc Ω ξ DX.Dh DX.Dg DX.I
        (W.hom v) hb
    · exact wc_etxc_ePsi_stalk_bij_off_origin_ne_zero A ℓ hℓ k n π c hc Ω ξ DX.Dh DX.Dg DX.I
        (W.hom v) hb q' hq

  letI := HasDerivedCategory.standard
    (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A)) (ℓ ^ k)))
  letI := HasDerivedCategory.standard
    (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (e' ≫ wcQuadModelStr A n π c) (wcQmSp A)) (ℓ ^ k)))
  exact key DjZ.Φ L hLadd hLlim hLcolim adj _ DX.Psi eΨ DX.TPsi (ℓ ^ (k - 1)) he hcounit hU

theorem wc_et_tpl_var_etale_excision (A : Type u) [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : IsUnit ((ℓ : ℕ) : A)) (k n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (π : A) (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (c : Matrix (Fin n) (Fin n) A)
    (hc : IsUnit (c + c.transpose).det) (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (ξ : Spec (.of Ω) ⟶ Spec (.of A)) (σ : Spec (.of Ω) ⟶ Spec (.of Ω)) (hσ : σ ≫ ξ = ξ)
    (ϖ : A) (hϖ : IsLocalRing.maximalIdeal A = Ideal.span {ϖ})
    (htame : wcMntTame ℓ (Spec.preimage ξ).hom (Spec.preimage σ).hom ϖ)
    (U : Scheme.{u}) (e : U ⟶ Spec (.of (wcQuadModelRing A n π c))) (he : Etale e) (u : U)
    (hu : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal (e u)) :
    wcEtTplStar (wcQuadModelStr A n π c) ξ σ ℓ k → wcEtTplStar (e ≫ wcQuadModelStr A n π c) ξ σ ℓ k :=
by
  have conj : ∀ {𝒞 : Type _} [Category 𝒞] [Preadditive 𝒞] (N : ℕ) {P Q : 𝒞}
      (a : P ⟶ P) (b : Q ⟶ Q) (χ' : P ≅ Q),
      a ≫ χ'.hom = χ'.hom ≫ b → N • (b - 𝟙 Q) = 0 → N • (a - 𝟙 P) = 0 := by
    intro 𝒞 _ _ N P Q a b χ' h hb
    have hd : a - 𝟙 P = χ'.hom ≫ (b - 𝟙 Q) ≫ χ'.inv := by
      rw [Preadditive.sub_comp, Preadditive.comp_sub, Category.id_comp, Iso.hom_inv_id,
        ← reassoc_of% h, Iso.hom_inv_id, Category.comp_id]
    rw [hd, ← Preadditive.comp_nsmul, ← Preadditive.nsmul_comp, hb, Limits.zero_comp,
      Limits.comp_zero]
  intro hX

  obtain ⟨U', _huU', x₀, v₀, hx₀, hv₀, hpb, hrange⟩ :=
    wc_et_tpl_excision_isolate A n π hπ c hc U e he u hu
  apply wc_et_tpl_var_etale_reflect A U U'.toScheme (e ≫ wcQuadModelStr A n π c) U'.ι
    inferInstance Ω ξ σ ℓ k
  rw [← Category.assoc]
  have hEt : Etale (U'.ι ≫ e) := by
    haveI := he
    infer_instance

  obtain ⟨Dh⟩ := wc_et_zmod_pull_data_exists
    (Limits.pullback.fst (wcQuadModelStr A n π c) ξ) (ℓ ^ k)
  obtain ⟨Dg⟩ := wc_et_zmod_pull_data_exists
    (Limits.pullback.fst (wcQuadModelStr A n π c) (wcQmSp A)) (ℓ ^ k)
  let σQ : Limits.pullback (wcQuadModelStr A n π c) ξ ⟶ Limits.pullback (wcQuadModelStr A n π c) ξ :=
    Limits.pullback.lift (Limits.pullback.fst (wcQuadModelStr A n π c) ξ)
      (Limits.pullback.snd (wcQuadModelStr A n π c) ξ ≫ σ)
      (by rw [Category.assoc, hσ]; exact Limits.pullback.condition)
  obtain ⟨DσQ⟩ := wc_et_zmod_pull_data_exists σQ (ℓ ^ k)
  obtain ⟨I, t, ht⟩ := wc_et_resolution_lift DσQ
  let DX : wcEtxcDatum (wcQuadModelStr A n π c) ξ σ ℓ k :=
    ⟨σQ, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _, Dh, Dg, I, DσQ,
      wc_et_zmod_ring_hom_ext _ _ _ _ _, t, ht⟩
  have hXnz : DX.VarNZ := hX DX.σQ DX.hσQ1 DX.hσQ2 DX.Dh DX.Dg DX.I DX.DσQ DX.hφ DX.t DX.ht

  obtain ⟨DU, DjZ, χ, hχ⟩ :=
    wc_et_tpl_excision_transport (wcQuadModelStr A n π c) (U'.ι ≫ e) hEt ξ σ ℓ k DX

  apply wc_et_tpl_star_of_datum _ ξ σ ℓ k DU
  intro hU
  apply hXnz
  haveI := DjZ.additive
  letI := HasDerivedCategory.standard
    (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (wcQuadModelStr A n π c) (wcQmSp A)) (ℓ ^ k)))
  letI := HasDerivedCategory.standard
    (SheafOfModules.{u+1} (wcEtZModRing
      (Limits.pullback ((U'.ι ≫ e) ≫ wcQuadModelStr A n π c) (wcQmSp A)) (ℓ ^ k)))

  refine wc_et_tpl_excision_faithful A ℓ hℓ k n hn hn2 π hπ c hc Ω ξ σ hσ U'.toScheme (U'.ι ≫ e) hEt
    x₀ v₀ hx₀ hv₀ hpb hrange DX DjZ ?_
  have hcomm : DerivedCategory.Q.map ((DjZ.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map DX.TPsi) ≫
      (DerivedCategory.Q.mapIso χ).hom = (DerivedCategory.Q.mapIso χ).hom ≫ DerivedCategory.Q.map DU.TPsi :=
    (CategoryTheory.Functor.map_comp _ _ _).symm.trans
      ((congrArg DerivedCategory.Q.map hχ).trans (CategoryTheory.Functor.map_comp _ _ _))
  exact conj _ _ _ (DerivedCategory.Q.mapIso χ) hcomm hU

theorem wc_etqmt_unit_fix {S S' : Scheme.{u}} {f : S' ⟶ S} {w : S' ⟶ S'} {n : ℕ}
    (hcomp : w ≫ f = f) (Df : wcEtPullData f n) (Dw : wcEtPullData w n)
    (hφ : wcEtqmtHPhi hcomp Df Dw) :
    wcEtqmtU Df ≫ (wcEtqmtP Df).map (wcEtqmtU Dw) ≫
      (wcEtqmtGamma hcomp Df Dw hφ).app (SheafOfModules.unit (wcEtZModRing S' n)) = wcEtqmtU Df :=
by
  haveI := Df.cont
  haveI := Dw.cont
  apply ((wcEtqmtP Df).obj (SheafOfModules.unit (wcEtZModRing S' n))).unitHomEquiv.injective
  apply PresheafOfModules.sections_ext
  intro X
  rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
  simp only [SheafOfModules.comp_val, PresheafOfModules.comp_app, ModuleCat.comp_apply,
    wcEtqmtGamma, NatTrans.comp_app, SheafOfModules.unitToPushforwardObjUnit_val_app_apply,
    map_one, SheafOfModules.pushforward_map_val, PresheafOfModules.pushforward_map_app_apply,
    SheafOfModules.pushforwardComp_hom_app_val_app, SheafOfModules.pushforwardNatTrans_app_val_app,
    SheafOfModules.pushforwardCongr_hom_app_val_app, SheafOfModules.unit_val,
    PresheafOfModules.unit_map_one]
  erw [PresheafOfModules.comp_app]
  erw [ConcreteCategory.comp_apply]
  erw [SheafOfModules.unitToPushforwardObjUnit_val_app_apply]
  erw [map_one (ConcreteCategory.hom (Df.φ.hom.app X))]
  erw [ConcreteCategory.comp_apply]
  erw [PresheafOfModules.pushforward_map_app_apply]
  erw [SheafOfModules.unitToPushforwardObjUnit_val_app_apply]
  erw [map_one]
  erw [PresheafOfModules.comp_app]
  erw [ConcreteCategory.comp_apply]
  have e1 := SheafOfModules.pushforwardComp_hom_app_val_app Df.φ Dw.φ
    (SheafOfModules.unit (wcEtZModRing S' n)) X
  erw [e1]
  erw [PresheafOfModules.comp_app]
  erw [ConcreteCategory.comp_apply]
  have e3 := SheafOfModules.pushforwardCongr_hom_app_val_app hφ
    (SheafOfModules.unit (wcEtZModRing S' n)) X
  erw [e3]
  haveI : (wcEtBaseChange f ⋙ wcEtBaseChange w).IsContinuous
      (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S') :=
    Functor.isContinuous_comp _ _ _ (Scheme.smallEtaleTopology S') _
  have e2 := SheafOfModules.pushforwardNatTrans_app_val_app (J := Scheme.smallEtaleTopology S)
    (K := Scheme.smallEtaleTopology S') (F := wcEtBaseChange f)
    (G := wcEtBaseChange f ⋙ wcEtBaseChange w)
    (T := wcEtZModRing S n) (S := wcEtZModRing S' n)
    (Df.φ ≫ ((wcEtBaseChange f).sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S')).map Dw.φ)
    (wcEtqmtAlpha f w hcomp) (SheafOfModules.unit (wcEtZModRing S' n)) X
  erw [e2]
  exact PresheafOfModules.unit_map_one _ _

theorem wc_etqmt_sq_unit {S S' : Scheme.{u}} {f : S' ⟶ S} {a : S' ⟶ S'} {b : S ⟶ S} {n : ℕ}
    (hab : a ≫ f = f ≫ b) (Df : wcEtPullData f n) (Da : wcEtPullData a n)
    (Db : wcEtPullData b n) (hφ : wcEtqmtSqPhi hab Df Da Db) :
    wcEtqmtU Df ≫ wcEtqmtActN hab Df Da Db hφ = wcEtqmtU Db ≫ (wcEtqmtP Db).map (wcEtqmtU Df) :=
by
  haveI := Df.cont
  haveI := Da.cont
  haveI := Db.cont
  haveI : (wcEtBaseChange f ⋙ wcEtBaseChange a).IsContinuous (Scheme.smallEtaleTopology S)
      (Scheme.smallEtaleTopology S') :=
    Functor.isContinuous_comp (wcEtBaseChange f) (wcEtBaseChange a) (Scheme.smallEtaleTopology S)
      (Scheme.smallEtaleTopology S') (Scheme.smallEtaleTopology S')
  haveI : (wcEtBaseChange b ⋙ wcEtBaseChange f).IsContinuous (Scheme.smallEtaleTopology S)
      (Scheme.smallEtaleTopology S') :=
    Functor.isContinuous_comp (wcEtBaseChange b) (wcEtBaseChange f) (Scheme.smallEtaleTopology S)
      (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S')
  apply ((wcEtqmtP Db).obj (wcEtSuppObj Df)).unitHomEquiv.injective
  apply PresheafOfModules.sections_ext
  intro X
  rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
  simp only [wcEtqmtActN, wcEtqmtSq, NatTrans.comp_app]
  erw [PresheafOfModules.comp_app]
  erw [ConcreteCategory.comp_apply]
  erw [SheafOfModules.unitToPushforwardObjUnit_val_app_apply]
  erw [map_one (ConcreteCategory.hom (Df.φ.hom.app X))]
  erw [PresheafOfModules.comp_app]
  erw [ConcreteCategory.comp_apply]
  erw [PresheafOfModules.pushforward_map_app_apply]
  erw [SheafOfModules.unitToPushforwardObjUnit_val_app_apply]
  erw [map_one]
  erw [PresheafOfModules.comp_app]
  erw [ConcreteCategory.comp_apply]
  have e1 := SheafOfModules.pushforwardComp_hom_app_val_app Df.φ Da.φ
    (SheafOfModules.unit (wcEtZModRing S' n)) X
  erw [e1]
  erw [PresheafOfModules.comp_app]
  erw [ConcreteCategory.comp_apply]
  have e2 := SheafOfModules.pushforwardNatTrans_app_val_app (J := Scheme.smallEtaleTopology S)
    (K := Scheme.smallEtaleTopology S') (F := wcEtBaseChange b ⋙ wcEtBaseChange f)
    (G := wcEtBaseChange f ⋙ wcEtBaseChange a)
    (T := wcEtZModRing S n) (S := wcEtZModRing S' n)
    (Df.φ ≫ ((wcEtBaseChange f).sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S')).map Da.φ)
    (wcEtqmtBeta f a b hab) (SheafOfModules.unit (wcEtZModRing S' n)) X
  erw [e2]
  refine (PresheafOfModules.unit_map_one _ _).trans ?_
  erw [PresheafOfModules.comp_app]
  erw [ConcreteCategory.comp_apply]
  erw [SheafOfModules.unitToPushforwardObjUnit_val_app_apply]
  erw [map_one (ConcreteCategory.hom (Db.φ.hom.app X))]
  exact (map_one (ConcreteCategory.hom (Df.φ.hom.app ((wcEtBaseChange b).op.obj X)))).symm

theorem wc_etqmt_action_comm {A B L : Type u} [CommRing A] [CommRing B] [Field L] {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)] {φA : A →+* L} {σ : L →+* L} {XE : Scheme.{u}}
    {p : XE ⟶ Spec (.of B)} {q : XE ⟶ Spec (.of L)} {w : XE ⟶ XE} {x₀ : B}
    (T : wcQmtmTower ℓ φA σ p q w x₀) (hσ : σ.comp φA = φA) (n : ℕ)
    (Dπ : wcEtPullData T.πi n) (Dγ : wcEtPullData T.γi n) (hφγ : wcEtqmtHPhi T.hγπ Dπ Dγ)
    (Dwi : wcEtPullData T.wi n) (Dw : wcEtPullData w n) (hφa : wcEtqmtSqPhi T.hwπ Dπ Dwi Dw) :
    wcEtqmtGammaN T.hγπ Dπ Dγ hφγ ≫ wcEtqmtActN T.hwπ Dπ Dwi Dw hφa =
      wcEtqmtActN T.hwπ Dπ Dwi Dw hφa ≫ (wcEtqmtP Dw).map (wcEtqmtGammaN T.hγπ Dπ Dγ hφγ) :=
by
  classical
  haveI := Dπ.cont
  haveI := Dγ.cont
  haveI := Dwi.cont
  haveI := Dw.cont

  have hζ : ∀ k, σ (T.ζ k) = T.ζ k := by
    intro k
    obtain ⟨a, ha⟩ := T.hζA k
    rw [← ha, ← RingHom.comp_apply, hσ]
  have hχσ : ∀ x : Localization.Away (ℓ : ℤ),
      σ ((T.χ (Multiplicative.ofAdd x) : Lˣ) : L) = ((T.χ (Multiplicative.ofAdd x) : Lˣ) : L) := by
    intro x
    refine Localization.induction_on x ?_
    rintro ⟨a, ⟨b, hb⟩⟩
    obtain ⟨k, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hb
    show σ ((T.χ (Multiplicative.ofAdd
      (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ))) : Lˣ) : L) = _
    rw [T.hχ, map_zpow₀, hζ]
  have hσγ : T.σG.comp T.γR = T.γR.comp T.σG := by
    apply AddMonoidAlgebra.ringHom_ext
    · intro r
      simp only [RingHom.comp_apply, T.hγR, T.hσG, map_mul, hχσ]
    · intro m
      simp only [RingHom.comp_apply, T.hγR, T.hσG, map_mul, hχσ]
  have hcomm : T.γi ≫ T.wi = T.wi ≫ T.γi := by
    apply T.hT.hom_ext
    · rw [Category.assoc, Category.assoc, T.hγπ, T.hwπ, ← Category.assoc, T.hγπ]
