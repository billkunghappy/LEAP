    have hR : Limits.IsLimit ((Limits.KernelFork.ofι k' hk0).map R) :=
      Limits.KernelFork.mapIsLimit _ hK R
    have hι : Limits.Fork.ι ((Limits.KernelFork.ofι k' hk0).map R) = R.map k' := rfl
    have e : L.iCycles 0 ≫ R.map (I.cochainComplex.d 0 1) = 0 := by
      rw [← hd]; exact HomologicalComplex.iCycles_d _ 0 1
    obtain ⟨δ, hδ⟩ := Limits.KernelFork.IsLimit.lift' hR (L.iCycles 0) e
    rw [hι] at hδ
    have hγδ : γ ≫ δ = R.map (HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 N).inv := by
      apply Limits.Fork.IsLimit.hom_ext hR
