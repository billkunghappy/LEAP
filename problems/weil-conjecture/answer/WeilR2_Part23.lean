    let Sb := R.obj (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj (wcEtSuppObj Dx)))
    let ub : Lb ⟶ Sb := R.map (DerivedCategory.Q.map ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map (wcEtSuppUnitMap Dx)))
    ∀ g : Sb ⟶ (R.obj (DerivedCategory.Q.obj Ψ))⟦(((n - 1) : ℕ) : ℤ)⟧, ub ≫ g = 0 :=
by

  have obsT : ∀ {𝒞 : Type (u+2)} [Category.{u+1} 𝒞] [Abelian 𝒞] {_hD : HasDerivedCategory.{u+2} 𝒞}
      (N : ℤ) (S : DerivedCategory 𝒞) (T : Pretriangulated.Triangle (DerivedCategory 𝒞))
      (_ : T ∈ Pretriangulated.distinguishedTriangles),
      Nonempty (T.obj₃⟦N⟧ ≅ S) → ∀ (m : ℕ),
      (∀ (j : ℕ) (r : T.obj₂ ⟶ T.obj₁), T.mor₁ ≫ r = j • 𝟙 _ → m ∣ j) →
      ∃ θ : S ⟶ T.obj₁⟦N + 1⟧, θ ≫ T.mor₁⟦N + 1⟧' = 0 ∧ ∀ j : ℕ, j • θ = 0 → m ∣ j := by
    intro 𝒞 _ _ _ N S T hT hσ m hnr
    obtain ⟨σ⟩ := hσ
    let α := shiftFunctorAdd' (DerivedCategory 𝒞) 1 N (N + 1) (by omega)
    obtain ⟨θ, hθdef⟩ : ∃ θ : S ⟶ T.obj₁⟦N + 1⟧, θ = σ.inv ≫ T.mor₃⟦N⟧' ≫ α.inv.app T.obj₁ :=
      ⟨_, rfl⟩
    refine ⟨θ, ?_, ?_⟩
    · have hn := α.inv.naturality T.mor₁
      rw [Functor.comp_map] at hn
      rw [hθdef, Category.assoc, Category.assoc, ← hn, ← Category.assoc (T.mor₃⟦N⟧'),
        ← CategoryTheory.Functor.map_comp, Pretriangulated.comp_distTriang_mor_zero₃₁ _ hT,
        Functor.map_zero, Limits.zero_comp, Limits.comp_zero]
    · intro j hj
      have e : T.mor₃⟦N⟧' = σ.hom ≫ θ ≫ α.hom.app T.obj₁ := by
        rw [hθdef]
        simp only [Category.assoc, Iso.inv_hom_id_app, Iso.hom_inv_id_assoc]
        exact (Category.comp_id _).symm
      have e2 : (shiftFunctor (DerivedCategory 𝒞) N).map (j • T.mor₃) = 0 := by
        rw [Functor.map_nsmul, e, ← Preadditive.comp_nsmul, ← Preadditive.nsmul_comp, hj,
          Limits.zero_comp, Limits.comp_zero]
      have h3 : j • T.mor₃ = 0 :=
        (shiftFunctor (DerivedCategory 𝒞) N).map_injective (by rw [e2, Functor.map_zero])
      have hTI := Pretriangulated.inv_rot_of_distTriang T hT
      have key0 : j • (-((shiftFunctor (DerivedCategory 𝒞) (-1 : ℤ)).map T.mor₃ ≫
          (shiftFunctorCompIsoId (DerivedCategory 𝒞) (1 : ℤ) (-1 : ℤ) (by omega)).hom.app T.obj₁)) = 0 := by
        rw [smul_neg, ← Preadditive.nsmul_comp, ← Functor.map_nsmul, h3, Functor.map_zero,
          Limits.zero_comp, neg_zero]
      obtain ⟨r, hr⟩ := Pretriangulated.Triangle.yoneda_exact₂ _ hTI
        (j • 𝟙 T.invRotate.obj₂) (by
          rw [Preadditive.comp_nsmul, Category.comp_id, Pretriangulated.Triangle.invRotate_mor₁]
          exact key0)
      rw [Pretriangulated.Triangle.invRotate_mor₂] at hr
      exact hnr j r hr.symm

  have key : ∀ {𝒞 : Type (u+2)} [Category.{u+1} 𝒞] [Abelian 𝒞] {_hD : HasDerivedCategory.{u+2} 𝒞}
      (T : Pretriangulated.Triangle (DerivedCategory 𝒞)) (_ : T ∈ distTriang _) (N : ℤ)
      (S : DerivedCategory 𝒞) (σ : T.obj₃⟦N⟧ ≅ S) (m : ℕ)
      (_ : ∀ a : T.obj₁ ⟶ T.obj₁⟦N⟧, a = 0)
      (_ : ∀ c : S ⟶ S, ∃ j : ℕ, c = j • 𝟙 S)
      (θ : S ⟶ T.obj₁⟦N + 1⟧) (_ : θ ≫ T.mor₁⟦N + 1⟧' = 0) (_ : ∀ j : ℕ, j • θ = 0 → m ∣ j)
      (_ : m • 𝟙 S = 0)
      (u : T.obj₁ ⟶ S) (g : S ⟶ T.obj₂⟦N⟧), u ≫ g = 0 := by
    intro 𝒞 _ _ _ T hT N S σ m h1 h2 θ hθe hθo h4 u g
    obtain ⟨c, hcdef⟩ : ∃ c : S ⟶ S, c = g ≫ T.mor₂⟦N⟧' ≫ σ.hom := ⟨_, rfl⟩
    have e1 : g ≫ T.mor₂⟦N⟧' = c ≫ σ.inv := by
      rw [hcdef, Category.assoc, Category.assoc, Iso.hom_inv_id, Category.comp_id]
    obtain ⟨j, hj⟩ := h2 c
    have hA : (j • σ.inv) ≫ T.mor₃⟦N⟧' = 0 := by
      have hs : j • σ.inv = c ≫ σ.inv := by rw [hj, Preadditive.nsmul_comp, Category.id_comp]
      rw [hs, ← e1, Category.assoc, ← CategoryTheory.Functor.map_comp,
        Pretriangulated.comp_distTriang_mor_zero₂₃ _ hT, Functor.map_zero, Limits.comp_zero]
    let TN := (shiftFunctor (Pretriangulated.Triangle (DerivedCategory 𝒞)) N).obj T
    have hTN : TN ∈ distTriang _ := Pretriangulated.Triangle.shift_distinguished T hT N
    have hTNR := Pretriangulated.rot_of_distTriang TN hTN
    let β := shiftFunctorAdd' (DerivedCategory 𝒞) N 1 (N + 1) (by omega)
    obtain ⟨f, hfdef⟩ : ∃ f : S ⟶ (T.obj₁⟦N⟧)⟦(1 : ℤ)⟧, f = θ ≫ β.hom.app T.obj₁ := ⟨_, rfl⟩
    have hf3 : f ≫ (-((shiftFunctor (DerivedCategory 𝒞) (1 : ℤ)).map
        (N.negOnePow • (shiftFunctor (DerivedCategory 𝒞) N).map T.mor₁))) = 0 := by
      rw [hfdef, Units.smul_def, Functor.map_zsmul, Preadditive.comp_neg, Preadditive.comp_zsmul,
        Category.assoc]
      have hn := β.hom.naturality T.mor₁
      rw [Functor.comp_map] at hn
      rw [← hn, ← Category.assoc, hθe, Limits.zero_comp, smul_zero, neg_zero]
    obtain ⟨g', hg'⟩ : ∃ g' : S ⟶ T.obj₃⟦N⟧, f = g' ≫ (N.negOnePow •
        ((shiftFunctor (DerivedCategory 𝒞) N).map T.mor₃ ≫
          (shiftFunctorComm (DerivedCategory 𝒞) 1 N).hom.app T.obj₁)) :=
      Pretriangulated.Triangle.coyoneda_exact₃ _ hTNR f hf3
    obtain ⟨j₁, hj₁⟩ := h2 (g' ≫ σ.hom)
    have hg'2 : g' = j₁ • σ.inv := by
      have e3 : g' = (g' ≫ σ.hom) ≫ σ.inv := by
        rw [Category.assoc, Iso.hom_inv_id, Category.comp_id]
      rw [e3, hj₁, Preadditive.nsmul_comp, Category.id_comp]
    have hjf : j • f = 0 := by
      rw [hg', hg'2, Preadditive.nsmul_comp, smul_comm j j₁, ← Preadditive.nsmul_comp,
        Units.smul_def, Preadditive.comp_zsmul, ← Category.assoc, hA, Limits.zero_comp,
        smul_zero, smul_zero]
    have hjθ : j • θ = 0 := by
      have : θ = f ≫ β.inv.app T.obj₁ := by
        rw [hfdef, Category.assoc, Iso.hom_inv_id_app, Category.comp_id]
      rw [this, ← Preadditive.nsmul_comp, hjf, Limits.zero_comp]
    obtain ⟨q, rfl⟩ := hθo j hjθ
    have hc : c = 0 := by rw [hj, mul_nsmul, h4, smul_zero]
    have hg : g ≫ T.mor₂⟦N⟧' = 0 := by rw [e1, hc, Limits.zero_comp]
    obtain ⟨a, ha⟩ : ∃ a : T.obj₁ ⟶ T.obj₁⟦N⟧, u ≫ g = a ≫ (N.negOnePow • T.mor₁⟦N⟧') :=
      Pretriangulated.Triangle.coyoneda_exact₂ TN hTN (u ≫ g) (by
        change (u ≫ g) ≫ (N.negOnePow • T.mor₂⟦N⟧') = 0
        rw [Units.smul_def, Preadditive.comp_zsmul, Category.assoc, hg, Limits.comp_zero,
          smul_zero])
    rw [ha, h1 a, Limits.zero_comp]

  have proj : ∀ {𝒞 : Type (u+2)} [Category.{u+1} 𝒞] [Abelian 𝒞]
      {_hD : HasDerivedCategory.{u+2} 𝒞}
      (Pt One : 𝒞) [Projective Pt] (m : ℕ) (k : ℤ) (_ : ((m + 1 : ℕ) : ℤ) = k)
      (g : DerivedCategory.Q.obj ((CochainComplex.singleFunctor 𝒞 0).obj Pt) ⟶
        (DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One))⟦k⟧),
      g = 0 := by
    intro 𝒞 _ _ _ Pt One _ m k hk g
    subst hk
    let _ : HasExt 𝒞 := HasExt.standard 𝒞
    let ι := DerivedCategory.singleFunctorIsoCompQ 𝒞 0
    let g' : ShiftedHom ((DerivedCategory.singleFunctor 𝒞 0).obj Pt)
        ((DerivedCategory.singleFunctor 𝒞 0).obj One) ((m + 1 : ℕ) : ℤ) :=
      ι.hom.app Pt ≫ g ≫ (ι.inv.app One)⟦((m + 1 : ℕ) : ℤ)⟧'
    have hg' : g' = 0 := by
      have h0 := Abelian.Ext.eq_zero_of_projective (Abelian.Ext.homEquiv.symm g')
      rw [← Abelian.Ext.homEquiv.apply_symm_apply g', h0]
      change (0 : Abelian.Ext Pt One (m + 1)).hom = 0
      rw [Abelian.Ext.zero_hom]
    have h1 : ι.hom.app Pt ≫ g ≫ (ι.inv.app One)⟦((m + 1 : ℕ) : ℤ)⟧' =
        ι.hom.app Pt ≫ 0 ≫ (ι.inv.app One)⟦((m + 1 : ℕ) : ℤ)⟧' := by
      rw [Limits.zero_comp, Limits.comp_zero]
      exact hg'
    rwa [cancel_epi, cancel_mono] at h1

  have h1gen : ∀ {𝒞 𝒞W : Type (u+2)} [Category.{u+1} 𝒞] [Category.{u+1} 𝒞W] [Abelian 𝒞]
      [Abelian 𝒞W] {_hD : HasDerivedCategory.{u+2} 𝒞} {_hDW : HasDerivedCategory.{u+2} 𝒞W}
      (Φ : 𝒞 ⥤ 𝒞W) [Φ.Additive] [Limits.PreservesFiniteLimits Φ]
      [Limits.PreservesFiniteColimits Φ] (One : 𝒞) (OneW : 𝒞W) (μ : Φ.obj One ≅ OneW)
      (_ : Projective OneW) (m : ℕ) (k : ℤ) (_ : ((m + 1 : ℕ) : ℤ) = k)
      (a : Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
          ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One)) ⟶
        (Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
          ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One)))⟦k⟧), a = 0 := by
    intro 𝒞 𝒞W _ _ _ _ _ _ Φ _ _ _ One OneW μ hP m k hk a
    haveI := hP
    let ιL : DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞W (ComplexShape.up ℤ) 0).obj
        OneW) ≅ Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
          ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One)) :=
      DerivedCategory.Q.mapIso ((HomologicalComplex.single 𝒞W (ComplexShape.up ℤ) 0).mapIso
          μ.symm) ≪≫
        DerivedCategory.Q.mapIso ((HomologicalComplex.singleMapHomologicalComplex Φ
          (ComplexShape.up ℤ) 0).symm.app One) ≪≫
        ((Φ.mapDerivedCategoryFactors).app _).symm
    have h0 : ιL.hom ≫ a ≫ (ιL.inv)⟦k⟧' = 0 := proj OneW OneW m k hk _
    rw [← cancel_epi ιL.hom, ← cancel_mono ((ιL.inv)⟦k⟧'), Limits.comp_zero, Limits.zero_comp]
    simpa only [Category.assoc] using h0

  have h2gen : ∀ {𝒞 𝒞W : Type (u+2)} [Category.{u+1} 𝒞] [Category.{u+1} 𝒞W] [Abelian 𝒞]
      [Abelian 𝒞W] {_hD : HasDerivedCategory.{u+2} 𝒞} {_hDW : HasDerivedCategory.{u+2} 𝒞W}
      (Φ : 𝒞 ⥤ 𝒞W) [Φ.Additive] [Limits.PreservesFiniteLimits Φ]
      [Limits.PreservesFiniteColimits Φ] (Sx : 𝒞) (S' : 𝒞W) (γ : S' ⟶ Φ.obj Sx) [IsIso γ]
      (_ : ∀ c : S' ⟶ S', ∃ j : ℕ, c = j • 𝟙 S')
      (c : Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
            ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj Sx)) ⟶
          Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
            ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj Sx))),
      ∃ j : ℕ, c = j • 𝟙 _ := by
    intro 𝒞 𝒞W _ _ _ _ _ _ Φ _ _ _ Sx S' γ _ hE c
    haveI hFull : (HomologicalComplex.single 𝒞W (ComplexShape.up ℤ) 0 ⋙ DerivedCategory.Q).Full :=
      Functor.Full.of_iso (DerivedCategory.singleFunctorIsoCompQ 𝒞W 0)
    let ιS : (HomologicalComplex.single 𝒞W (ComplexShape.up ℤ) 0 ⋙ DerivedCategory.Q).obj S' ≅
        Φ.mapDerivedCategory.obj (DerivedCategory.Q.obj
          ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj Sx)) :=
      DerivedCategory.Q.mapIso ((HomologicalComplex.single 𝒞W (ComplexShape.up ℤ) 0).mapIso
          (asIso γ)) ≪≫
        DerivedCategory.Q.mapIso ((HomologicalComplex.singleMapHomologicalComplex Φ
          (ComplexShape.up ℤ) 0).symm.app Sx) ≪≫
        ((Φ.mapDerivedCategoryFactors).app _).symm
    obtain ⟨j, hj⟩ := hE ((HomologicalComplex.single 𝒞W (ComplexShape.up ℤ) 0 ⋙
      DerivedCategory.Q).preimage (ιS.hom ≫ c ≫ ιS.inv))
    refine ⟨j, ?_⟩
    have e1 : ιS.hom ≫ c ≫ ιS.inv = j • 𝟙 _ := by
      rw [← (HomologicalComplex.single 𝒞W (ComplexShape.up ℤ) 0 ⋙ DerivedCategory.Q).map_preimage
        (ιS.hom ≫ c ≫ ιS.inv), hj, Functor.map_nsmul, CategoryTheory.Functor.map_id]
    calc c = ιS.inv ≫ (ιS.hom ≫ c ≫ ιS.inv) ≫ ιS.hom := by
          simp only [Category.assoc, Iso.inv_hom_id_assoc, Iso.inv_hom_id, Category.comp_id]
      _ = j • 𝟙 _ := by
          rw [e1, Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp,
            Iso.inv_hom_id]

  have injgen : ∀ {𝒞 𝒞W : Type (u+2)} [Category.{u+1} 𝒞] [Category.{u+1} 𝒞W] [Abelian 𝒞]
      [Abelian 𝒞W] {_hD : HasDerivedCategory.{u+2} 𝒞} {_hDW : HasDerivedCategory.{u+2} 𝒞W}
      (Φ : 𝒞 ⥤ 𝒞W) [Φ.Additive] [Limits.PreservesFiniteLimits Φ]
      [Limits.PreservesFiniteColimits Φ] (Sx One : 𝒞)
      (_ : ∀ k : ℕ, Function.Injective (fun f : DerivedCategory.Q.obj
            ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj Sx) ⟶
          (DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj
            One))⟦(k : ℤ)⟧ =>
        Φ.mapDerivedCategory.map f ≫ (Φ.mapDerivedCategory.commShiftIso (k : ℤ)).hom.app
            (DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj
              One))))
      (m : ℤ) (_ : 0 ≤ m)
      (f : DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj Sx) ⟶
          (DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj
            One))⟦m⟧),
      Φ.mapDerivedCategory.map f ≫ (Φ.mapDerivedCategory.commShiftIso m).hom.app
          (DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj
            One)) = 0 → f = 0 := by
    intro 𝒞 𝒞W _ _ _ _ _ _ Φ _ _ _ Sx One htr m hm f hf
    obtain ⟨k, rfl⟩ := Int.eq_ofNat_of_zero_le hm
    apply htr k
    beta_reduce
    rw [hf, Functor.map_zero, Limits.zero_comp]

  have b1 : ∀ {C D : Type (u+2)} [Category.{u+1} C] [Abelian C] [Category.{u+1} D] [Abelian D]
      [HasExt C] [HasExt D] [HasDerivedCategory C] [HasDerivedCategory D]
      (F : C ⥤ D) [F.Additive] [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F]
      (X Y : C) (n : ℕ),
      Function.Injective (fun β : Abelian.Ext X Y n => Abelian.Ext.mapExactFunctor F β) →
      Function.Injective (fun g : ShiftedHom ((DerivedCategory.singleFunctor C 0).obj X)
          ((DerivedCategory.singleFunctor C 0).obj Y) (n : ℤ) => g.map F.mapDerivedCategory) := by
    intro C D _ _ _ _ _ _ _ _ F _ _ _ X Y n h
    let α := F.mapDerivedCategorySingleFunctor 0
    let E₁ : Abelian.Ext X Y n ≃ _ := Abelian.Ext.homEquiv
    let E₂ : Abelian.Ext (F.obj X) (F.obj Y) n ≃ _ := Abelian.Ext.homEquiv
    let H := (α.app X).homCongr ((shiftFunctor (DerivedCategory D) (n : ℤ)).mapIso (α.app Y))
    have hK : ∀ β : Abelian.Ext X Y n,
        E₂ (Abelian.Ext.mapExactFunctor F β) = H ((E₁ β).map F.mapDerivedCategory) := by
      intro β
      show (Abelian.Ext.mapExactFunctor F β).hom = H (β.hom.map F.mapDerivedCategory)
      rw [Abelian.Ext.mapExactFunctor_hom, Iso.homCongr_apply, Functor.mapIso_hom, Iso.app_hom,
        Iso.app_inv]
    have hfac : (fun g : ShiftedHom ((DerivedCategory.singleFunctor C 0).obj X)
          ((DerivedCategory.singleFunctor C 0).obj Y) (n : ℤ) => g.map F.mapDerivedCategory) =
        H.symm ∘ E₂ ∘ (fun β : Abelian.Ext X Y n => Abelian.Ext.mapExactFunctor F β) ∘ E₁.symm := by
      funext g
      simp only [Function.comp_apply]
      rw [hK, Equiv.apply_symm_apply, Equiv.symm_apply_apply]
    rw [hfac]
    exact H.symm.injective.comp (E₂.injective.comp (h.comp E₁.symm.injective))

  have b2 : ∀ {C D : Type (u+2)} [Category.{u+2} C] [Category.{u+2} D]
      [HasShift C ℤ] [HasShift D ℤ] (Rf : C ⥤ D) [Rf.CommShift ℤ]
      {X X' Y Y' : C} (eX : X ≅ X') (eY : Y ≅ Y') (a : ℤ),
      Function.Injective (fun g : X ⟶ Y⟦a⟧ => Rf.map g ≫ (Rf.commShiftIso a).hom.app Y) →
      Function.Injective (fun f : X' ⟶ Y'⟦a⟧ => Rf.map f ≫ (Rf.commShiftIso a).hom.app Y') := by
    intro C D _ _ _ _ Rf _ X X' Y Y' eX eY a h
    let H₁ := eX.homCongr ((shiftFunctor C a).mapIso eY)
    let H₂ := (Rf.mapIso eX).homCongr ((shiftFunctor D a).mapIso (Rf.mapIso eY))
    have hN : ∀ g : X ⟶ Y⟦a⟧, Rf.map (H₁ g) ≫ (Rf.commShiftIso a).hom.app Y' =
