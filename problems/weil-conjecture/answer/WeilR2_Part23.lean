    have hiso : IsIso γ := by
      refine ⟨⟨δ ≫ R.map (HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 N).hom, ?_, ?_⟩⟩
      · rw [← Category.assoc, hγδ, ← R.map_comp, Iso.inv_hom_id, R.map_id]
      · rw [← cancel_mono (L.iCycles 0), Category.assoc, Category.assoc, hγ, ← R.map_comp,
