        (wcQmSp A)).fromSpecResidueField v) := isClosed_singleton_iff_isClosedImmersion.mp hvcl
    refine ⟨Spec.map ψ ≫ (Limits.pullback ((U'.ι ≫ e) ≫ wcQuadModelStr A n π c)
        (wcQmSp A)).fromSpecResidueField v, inferInstance, ?_, ?_⟩
    · rw [Category.assoc, ← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField,
        ← Category.assoc, ← Spec.map_comp]
      simp only [ψ, IsIso.hom_inv_id_assoc]
      rw [Spec.map_comp, Category.assoc, Scheme.residueFieldCongr_fromSpecResidueField,
        Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField]
    · exact (Scheme.Hom.comp_apply _ _ _).trans (Scheme.fromSpecResidueField_apply _ _)



  refine ⟨v₀, hx₀ci, hv₀ci, ?_, hrange⟩
  haveI := hx₀ci
  haveI := hv₀ci
  exact fibrePB (IsLocalRing.ResidueField A) _ _ _ x₀ v₀ hcomp
    (fun w hw => (hfib w hw).trans hv₀pt.symm)

theorem wc_et_tpl_star_of_datum {A : Type u} [CommRing A] [IsLocalRing A] {X : Scheme.{u}}
    (fX : X ⟶ Spec (.of A)) {Ω : Type u} [Field Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A))
    (σ : Spec (.of Ω) ⟶ Spec (.of Ω)) (ℓ k : ℕ) (D : wcEtxcDatum fX ξ σ ℓ k) :
    D.VarNZ → wcEtTplStar fX ξ σ ℓ k :=
by

  have t_s1 : ∀ {𝒜 : Type _} [Category 𝒜] [Abelian 𝒜] {One : 𝒜} (I : InjectiveResolution One)
      (L : CochainComplex 𝒜 ℤ) [L.IsKInjective],
      (∀ g : (CochainComplex.singleFunctor 𝒜 0).obj One ⟶ L, ∃ f : I.cochainComplex ⟶ L,
        Nonempty (Homotopy (I.ι' ≫ f) g)) ∧
      (∀ f₁ f₂ : I.cochainComplex ⟶ L, Nonempty (Homotopy (I.ι' ≫ f₁) (I.ι' ≫ f₂)) →
        Nonempty (Homotopy f₁ f₂)) := by
    intro 𝒜 _ _ One I L _
    letI := HasDerivedCategory.standard 𝒜
    let ε := DerivedCategory.quotientCompQhIso 𝒜
    have hQ : ∀ {K : CochainComplex 𝒜 ℤ} (f : K ⟶ L), DerivedCategory.Q.map f =
        ε.inv.app K ≫ DerivedCategory.Qh.map ((HomotopyCategory.quotient 𝒜 _).map f) ≫
          ε.hom.app L := by
      intro K f
      have := ε.hom.naturality f
      simp only [Functor.comp_map] at this
      rw [this, Iso.inv_hom_id_app_assoc]
    have hsurj : ∀ (K : CochainComplex 𝒜 ℤ)
        (φ : DerivedCategory.Q.obj K ⟶ DerivedCategory.Q.obj L),
        ∃ f : K ⟶ L, DerivedCategory.Q.map f = φ := by
      intro K φ
      obtain ⟨κ, hκ⟩ := (CochainComplex.IsKInjective.Qh_map_bijective
        ((HomotopyCategory.quotient 𝒜 _).obj K) L).2 (ε.hom.app K ≫ φ ≫ ε.inv.app L)
      obtain ⟨f, rfl⟩ := (HomotopyCategory.quotient 𝒜 (ComplexShape.up ℤ)).map_surjective κ
      refine ⟨f, ?_⟩
      rw [hQ, hκ]
      simp
    have hinj : ∀ (K : CochainComplex 𝒜 ℤ) (f₁ f₂ : K ⟶ L),
        DerivedCategory.Q.map f₁ = DerivedCategory.Q.map f₂ → Nonempty (Homotopy f₁ f₂) := by
      intro K f₁ f₂ h
      rw [hQ, hQ] at h
      have h2 := congrArg (fun x => ε.hom.app K ≫ x ≫ ε.inv.app L) h
      simp only [Iso.hom_inv_id_app_assoc, Category.assoc, Iso.hom_inv_id_app] at h2
      exact ⟨HomotopyCategory.homotopyOfEq _ _
        ((CochainComplex.IsKInjective.Qh_map_bijective _ L).1 h2)⟩
    haveI : IsIso (DerivedCategory.Q.map I.ι') := by
      rw [DerivedCategory.isIso_Q_map_iff_quasiIso]; infer_instance
    refine ⟨fun g => ?_, fun f₁ f₂ ⟨H⟩ => ?_⟩
    · obtain ⟨f, hf⟩ := hsurj _ (inv (DerivedCategory.Q.map I.ι') ≫ DerivedCategory.Q.map g)
      refine ⟨f, hinj _ _ _ ?_⟩
      rw [CategoryTheory.Functor.map_comp, hf, IsIso.hom_inv_id_assoc]
    · apply hinj
      have := DerivedCategory.Q_map_eq_of_homotopy _ H
      rw [CategoryTheory.Functor.map_comp, CategoryTheory.Functor.map_comp] at this
      exact (cancel_epi _).1 this

  have t_s3 : ∀ {𝒜 : Type _} [Category 𝒜] [Abelian 𝒜] (Φ Pw : 𝒜 ⥤ 𝒜) [Pw.Additive]
      [Limits.PreservesFiniteLimits Φ] (adj : Φ ⊣ Pw) {One : 𝒜} (I : InjectiveResolution One),
      CochainComplex.IsKInjective
        ((Pw.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex) := by
    intro 𝒜 _ _ Φ Pw _ _ adj One I
    haveI : ∀ n, Injective
        (((Pw.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex).X n) :=
      fun n => Injective.injective_of_adjoint adj (I.cochainComplex.X n)
    haveI : CochainComplex.IsStrictlyGE
        ((Pw.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex) 0 := by
      rw [CochainComplex.isStrictlyGE_iff]
      intro i hi
      exact Pw.map_isZero (CochainComplex.isZero_of_isStrictlyGE I.cochainComplex 0 i hi)
    exact CochainComplex.isKInjective_of_injective _ 0

  have t_s2 : ∀ {𝒜 : Type _} [Category 𝒜] [Abelian 𝒜] (Φ Pw : 𝒜 ⥤ 𝒜) [Φ.Additive]
      [Pw.Additive] (adj : Φ ⊣ Pw) (One : 𝒜) (u : One ⟶ Pw.obj One) (I : InjectiveResolution One)
      (t : (Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex ⟶ I.cochainComplex),
      (Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι' ≫ t =
        (HomologicalComplex.singleMapHomologicalComplex Φ (ComplexShape.up ℤ) 0).hom.app One ≫
          (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map ((adj.homEquiv _ _).symm u) ≫
            I.ι' →
      I.ι' ≫ ((Functor.mapHomologicalComplexIdIso _ (ComplexShape.up ℤ)).inv.app I.cochainComplex ≫
        (NatTrans.mapHomologicalComplex (show 𝟭 _ ⟶ Φ ⋙ Pw from adj.unit)
          (ComplexShape.up ℤ)).app I.cochainComplex ≫
        (Functor.mapHomologicalComplexCompIso (Iso.refl (Φ ⋙ Pw))
          (ComplexShape.up ℤ)).inv.app I.cochainComplex ≫
        (Pw.mapHomologicalComplex (ComplexShape.up ℤ)).map t) =
      (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map u ≫
        (HomologicalComplex.singleMapHomologicalComplex Pw (ComplexShape.up ℤ) 0).inv.app One ≫
        (Pw.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι' := by
    intro 𝒜 _ _ Φ Pw _ _ adj One u I t ht
    apply HomologicalComplex.from_single_hom_ext
    have h0 := congrArg (fun h => h.f 0) ht
    simp only [HomologicalComplex.comp_f, Functor.mapHomologicalComplex_map_f,
      HomologicalComplex.singleMapHomologicalComplex_hom_app_self,
      HomologicalComplex.single_map_f_self, Category.assoc, Iso.inv_hom_id_assoc] at h0
    have hu : adj.unit.app One ≫ Pw.map ((adj.homEquiv _ _).symm u) = u := by
      have := adj.homEquiv_unit One One ((adj.homEquiv One One).symm u)
      rw [Equiv.apply_symm_apply] at this
      exact this.symm
    simp only [HomologicalComplex.comp_f, Functor.mapHomologicalComplexIdIso_inv_app_f,
      NatTrans.mapHomologicalComplex_app_f, Functor.mapHomologicalComplexCompIso_inv_app_f,
      Functor.mapHomologicalComplex_map_f, HomologicalComplex.single_map_f_self,
      HomologicalComplex.singleMapHomologicalComplex_inv_app_self, Iso.refl_inv, NatTrans.id_app,
      Category.id_comp, Category.assoc, Iso.inv_hom_id_assoc, Functor.comp_obj]
    rw [← Adjunction.unit_naturality_assoc]
    erw [Category.id_comp]
    rw [← CategoryTheory.Functor.map_comp, h0]
    simp only [CategoryTheory.Functor.map_comp]
    rw [Adjunction.unit_naturality_assoc, reassoc_of% hu]

  have t_conjD : ∀ {ℬ 𝒞 : Type _} [Category ℬ] [Abelian ℬ] [Category 𝒞] [Abelian 𝒞]
      [HasDerivedCategory 𝒞]
      (G G' : ℬ ⥤ 𝒞) [G.Additive] [G'.Additive] (ν : G ≅ G') {K K' : CochainComplex ℬ ℤ}
      (T : K ⟶ K) (T' : K' ⟶ K') (p : K ⟶ K') (p' : K' ⟶ K),
      Homotopy (p ≫ T') (T ≫ p) → Homotopy (p ≫ p') (𝟙 _) → Homotopy (p' ≫ p) (𝟙 _) →
      ∃ e : DerivedCategory.Q.obj ((G.mapHomologicalComplex (ComplexShape.up ℤ)).obj K) ≅
          DerivedCategory.Q.obj ((G'.mapHomologicalComplex (ComplexShape.up ℤ)).obj K'),
        DerivedCategory.Q.map ((G.mapHomologicalComplex (ComplexShape.up ℤ)).map T) ≫ e.hom =
          e.hom ≫ DerivedCategory.Q.map ((G'.mapHomologicalComplex (ComplexShape.up ℤ)).map T') := by
    intro ℬ 𝒞 _ _ _ _ _ G G' _ _ ν K K' T T' p p' H hpp hp'p
    let nh := NatIso.mapHomologicalComplex ν (ComplexShape.up ℤ)
    let χ := (G.mapHomologicalComplex (ComplexShape.up ℤ)).map p ≫ nh.hom.app K'
    let χ' := nh.inv.app K' ≫ (G.mapHomologicalComplex (ComplexShape.up ℤ)).map p'
    have hQ : ∀ {X Y : CochainComplex ℬ ℤ} {f g : X ⟶ Y}, Homotopy f g →
        DerivedCategory.Q.map ((G.mapHomologicalComplex (ComplexShape.up ℤ)).map f) =
        DerivedCategory.Q.map ((G.mapHomologicalComplex (ComplexShape.up ℤ)).map g) :=
      fun h => DerivedCategory.Q_map_eq_of_homotopy _ (G.mapHomotopy h)
    have hG1 : DerivedCategory.Q.map ((G.mapHomologicalComplex (ComplexShape.up ℤ)).map (p ≫ p')) =
        𝟙 _ := by
      rw [hQ hpp, CategoryTheory.Functor.map_id, CategoryTheory.Functor.map_id]
    have hG2 : DerivedCategory.Q.map ((G.mapHomologicalComplex (ComplexShape.up ℤ)).map (p' ≫ p)) =
        𝟙 _ := by
      rw [hQ hp'p, CategoryTheory.Functor.map_id, CategoryTheory.Functor.map_id]
    have h1 : DerivedCategory.Q.map χ ≫ DerivedCategory.Q.map χ' = 𝟙 _ := by
      rw [← CategoryTheory.Functor.map_comp]
      have : χ ≫ χ' = (G.mapHomologicalComplex (ComplexShape.up ℤ)).map (p ≫ p') := by
        simp only [χ, χ', Category.assoc, Iso.hom_inv_id_app_assoc,
