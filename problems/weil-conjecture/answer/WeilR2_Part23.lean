    haveI h1 : Finite (OneW ⟶ Φ.obj Sx) := Finite.of_surjective π hπ
    have h2 : Nat.card (OneW ⟶ Φ.obj Sx) ≤ mm :=
      (Nat.card_le_card_of_surjective π hπ).trans hcard
    exact ⟨Finite.of_injective ρ hρ, (Nat.card_le_card_of_injective ρ hρ).trans h2⟩

  have c1 : ∀ (S : Scheme.{u}) (R : Type u) [CommRing R]
      [HenselianLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)] (e : S ≅ Spec (.of R))
      (m : ℕ) (_hm : m ≠ 0),
      Finite (SheafOfModules.unit (wcEtZModRing S m) ⟶ SheafOfModules.unit (wcEtZModRing S m)) ∧
      Nat.card (SheafOfModules.unit (wcEtZModRing S m) ⟶ SheafOfModules.unit (wcEtZModRing S m))
        ≤ m := by
    intro S R _ _ _ e m hm

    have hetale : ∀ (E : Type u) [CommRing E] [Algebra R E] [Algebra.Etale R E]
        (σ : E →ₐ[R] IsLocalRing.ResidueField R), ∃ τ : E →ₐ[R] R,
          ∀ x : E, IsLocalRing.residue R (τ x) = σ x := by
      intro E _ _ _ σ
      haveI hq : (RingHom.ker σ).IsPrime := RingHom.ker_isPrime σ
      haveI : Algebra.FormallyEtale E (Localization.AtPrime (RingHom.ker σ)) :=
        Algebra.FormallyEtale.of_isLocalization (RingHom.ker σ).primeCompl
      haveI : Algebra.IsEtaleAt R (RingHom.ker σ) :=
        Algebra.FormallyEtale.comp R E (Localization.AtPrime (RingHom.ker σ))
      obtain ⟨g, hg, hstd⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := R) (RingHom.ker σ)
      have hσg : IsUnit (σ g) := isUnit_iff_ne_zero.mpr (fun h => hg (RingHom.mem_ker.mpr h))
      let σg : Localization.Away g →ₐ[R] IsLocalRing.ResidueField R :=
        IsLocalization.Away.liftAlgHom g hσg
      have hσg_apply : ∀ y : E, σg (algebraMap E (Localization.Away g) y) = σ y := by
        intro y
        rw [IsLocalization.Away.liftAlgHom_apply, IsLocalization.Away.lift_eq]
        rfl
      obtain ⟨Q⟩ := hstd.nonempty_standardEtalePresentation
      let e' : Q.Ring ≃ₐ[R] Localization.Away g :=
        AlgEquiv.ofBijective (Q.lift Q.x Q.hasMap) Q.lift_bijective
      have heX : e' Q.X = Q.x := by
        rw [AlgEquiv.ofBijective_apply]
        exact Q.lift_X _ _
      set a₀ := σg Q.x with ha₀
      have hf0 : Polynomial.aeval a₀ Q.f = 0 := by
        rw [ha₀, Polynomial.aeval_algHom_apply, Q.hasMap.1, map_zero]
      have hf' : Polynomial.aeval a₀ (Polynomial.derivative Q.f) ≠ 0 := by
        rw [ha₀, Polynomial.aeval_algHom_apply]
        exact ((StandardEtalePair.HasMap.isUnit_derivative_f Q.P Q.hasMap).map σg).ne_zero
      have hg0 : Polynomial.aeval a₀ Q.g ≠ 0 := by
        rw [ha₀, Polynomial.aeval_algHom_apply]
        exact (Q.hasMap.2.map σg).ne_zero
      have hHen := ((HenselianLocalRing.TFAE R).out 1 2).mp (inferInstance : HenselianLocalRing R)
      obtain ⟨a, hroot, hres⟩ := hHen Q.f Q.monic_f a₀ hf0 hf'
      have hres' : ∀ p : Polynomial R,
          IsLocalRing.residue R (Polynomial.aeval a p) = Polynomial.aeval a₀ p := by
        intro p
        rw [← hres, ← IsLocalRing.ResidueField.algebraMap_eq, ← Algebra.ofId_apply,
          ← Algebra.ofId_apply, ← Polynomial.aeval_algHom_apply]
      have hHas : Q.HasMap a := by
        refine ⟨?_, ?_⟩
        · rw [Polynomial.coe_aeval_eq_eval]
          exact hroot
        · rw [← IsLocalRing.residue_ne_zero_iff_isUnit, hres']
          exact hg0
      have hcomp : (Algebra.ofId R (IsLocalRing.ResidueField R)).comp (Q.lift a hHas) =
          σg.comp (e' : Q.Ring →ₐ[R] Localization.Away g) := by
        apply StandardEtalePair.hom_ext
        rw [AlgHom.comp_apply, AlgHom.comp_apply, Q.lift_X, AlgEquiv.coe_toAlgHom, heX,
          Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq, hres]
      refine ⟨((Q.lift a hHas).comp (e'.symm : Localization.Away g →ₐ[R] Q.Ring)).comp
        (IsScalarTower.toAlgHom R E (Localization.Away g)), fun y => ?_⟩
      have h1 := congrArg (fun φ => φ (e'.symm (algebraMap E (Localization.Away g) y))) hcomp
      simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom, AlgEquiv.apply_symm_apply,
        Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq] at h1
      rw [AlgHom.comp_apply, AlgHom.comp_apply, IsScalarTower.coe_toAlgHom',
        AlgEquiv.coe_toAlgHom, h1, hσg_apply]
    have Hsec : ∀ (E : Type u) [CommRing E] [Algebra R E], Algebra.Etale R E →
        ∀ φ : E →ₐ[R] IsLocalRing.ResidueField R, ∃ τ : E →ₐ[R] R,
          (Algebra.ofId R (IsLocalRing.ResidueField R)).comp τ = φ := by
      intro E _ _ hE φ
      haveI := hE
      obtain ⟨τ, hτ⟩ := hetale E φ
      refine ⟨τ, AlgHom.ext fun x => ?_⟩
      rw [AlgHom.comp_apply, Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq]
      exact hτ x

    have hsec : ∀ {V : Scheme.{u}} (g : V ⟶ Spec (.of R)) [Etale g] (v : V),
        g v = IsLocalRing.closedPoint R → ∃ σ : Spec (.of R) ⟶ V, σ ≫ g = 𝟙 _ := by
      intro V g _ v hv
      have hres : ∀ (S : Type u) [CommRing S] [Algebra R S], Algebra.Etale R S →
          ∀ (q : Ideal S) [q.IsPrime], q.comap (algebraMap R S) = IsLocalRing.maximalIdeal R →
          Nonempty (S →ₐ[R] IsLocalRing.ResidueField R) := by
        intro S _ _ hE q _ hq
        have hker : RingHom.ker (algebraMap R q.ResidueField) = IsLocalRing.maximalIdeal R := by
          rw [IsScalarTower.algebraMap_eq R S q.ResidueField, ← RingHom.comap_ker,
            Ideal.ker_algebraMap_residueField, hq]
        have : IsLocalHom (algebraMap R q.ResidueField) := by
          constructor
          intro a ha
          by_contra hna
          have hm : a ∈ IsLocalRing.maximalIdeal R := hna
          rw [← hker, RingHom.mem_ker] at hm
          exact ha.ne_zero hm
        let j : IsLocalRing.ResidueField R →+* q.ResidueField :=
          IsLocalRing.ResidueField.lift (algebraMap R q.ResidueField)
        letI : Algebra (IsLocalRing.ResidueField R) q.ResidueField := j.toAlgebra
        have : IsScalarTower R (IsLocalRing.ResidueField R) q.ResidueField :=
          IsScalarTower.of_algebraMap_eq (fun r => by
            rw [RingHom.algebraMap_toAlgebra, IsLocalRing.ResidueField.algebraMap_eq,
              IsLocalRing.ResidueField.lift_residue_apply])
        have : Algebra.FormallyUnramified S (Localization.AtPrime q) :=
          Algebra.FormallyUnramified.of_isLocalization q.primeCompl
        have : Algebra.FormallyUnramified S q.ResidueField :=
          Algebra.FormallyUnramified.comp S (Localization.AtPrime q) q.ResidueField
        have : Algebra.FormallyUnramified R q.ResidueField :=
          Algebra.FormallyUnramified.comp R S q.ResidueField
        have : Algebra.EssFiniteType R q.ResidueField := Algebra.EssFiniteType.comp R S q.ResidueField
        have : Algebra.FormallyUnramified (IsLocalRing.ResidueField R) q.ResidueField :=
          Algebra.FormallyUnramified.of_restrictScalars R _ q.ResidueField
        have : Algebra.EssFiniteType (IsLocalRing.ResidueField R) q.ResidueField :=
          Algebra.EssFiniteType.of_comp R _ q.ResidueField
        have : Algebra.IsSeparable (IsLocalRing.ResidueField R) q.ResidueField :=
          Algebra.FormallyUnramified.isSeparable _ q.ResidueField
        have hsurj := IsSepClosed.algebraMap_surjective (IsLocalRing.ResidueField R) q.ResidueField
        let eq : IsLocalRing.ResidueField R ≃ₐ[R] q.ResidueField :=
          AlgEquiv.ofBijective (IsScalarTower.toAlgHom R (IsLocalRing.ResidueField R) q.ResidueField)
            ⟨(algebraMap (IsLocalRing.ResidueField R) q.ResidueField).injective, hsurj⟩
        exact ⟨eq.symm.toAlgHom.comp (IsScalarTower.toAlgHom R S q.ResidueField)⟩
      obtain ⟨E, ι, hι, hvι, -⟩ :=
        Scheme.exists_affine_mem_range_and_range_subset (U := (⊤ : V.Opens)) (x := v) trivial
      obtain ⟨w, hw⟩ := hvι
      have := hι
      let h : Spec E ⟶ Spec (.of R) := ι ≫ g
      have : Etale h := inferInstance
      let φ : CommRingCat.of R ⟶ E := Spec.preimage h
      have hφ : Spec.map φ = h := Spec.map_preimage h
      have hEt : (CommRingCat.Hom.hom φ).Etale := by
        have : Etale (Spec.map φ) := by rw [hφ]; infer_instance
        exact (HasRingHomProperty.Spec_iff (P := @Etale)).mp this
      letI : Algebra R E := (CommRingCat.Hom.hom φ).toAlgebra
      have hAE : Algebra.Etale R E := RingHom.Etale.toAlgebra hEt
      let p : PrimeSpectrum E := w
      have hq : (p.asIdeal).comap (algebraMap R E) = IsLocalRing.maximalIdeal R := by
        have h1 : (Spec.map φ) w = IsLocalRing.closedPoint R := by
          rw [hφ]
          show g (ι w) = _
          rw [hw, hv]
        have h2 := congrArg PrimeSpectrum.asIdeal h1
        exact h2
      obtain ⟨φ₀⟩ := hres E hAE p.asIdeal hq
      obtain ⟨τ, -⟩ := Hsec E hAE φ₀
      let τ' : E ⟶ CommRingCat.of R := CommRingCat.ofHom (τ : E →+* R)
      have hret : φ ≫ τ' = 𝟙 _ := by
        ext r
        exact τ.commutes r
      refine ⟨Spec.map τ' ≫ ι, ?_⟩
      have h3 : ι ≫ g = Spec.map φ := hφ.symm
      rw [Category.assoc, h3, ← Spec.map_comp, hret, Spec.map_id]
    have key : ∀ {V : Scheme.{u}} (g : V ⟶ S) [Etale g] (v : V),
        g v = e.inv (IsLocalRing.closedPoint R) → ∃ σ : S ⟶ V, σ ≫ g = 𝟙 S := by
      intro V g _ v hv
      have hv' : (g ≫ e.hom) v = IsLocalRing.closedPoint R := by
        show e.hom (g v) = _
        rw [hv]
        first
          | exact Scheme.inv_hom_apply e _
          | simp
      haveI : Etale (g ≫ e.hom) := inferInstance
      obtain ⟨σ, hσ⟩ := hsec (g ≫ e.hom) v hv'
      refine ⟨e.hom ≫ σ, ?_⟩
      have hσ1 : σ ≫ g = e.inv := by
        have h1 := congrArg (fun k => k ≫ e.inv) hσ
        simpa only [Category.assoc, Iso.hom_inv_id, Category.comp_id, Category.id_comp] using h1
      exact (Category.assoc _ _ _).trans ((congrArg (fun k => e.hom ≫ k) hσ1).trans e.hom_inv_id)

    let T : S.Etale := Scheme.Etale.mk (𝟙 S)
    have hT : Limits.IsTerminal T :=
      Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
        (fun V m => MorphismProperty.Over.Hom.ext
          ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
    have hcov : ∀ R' ∈ (Scheme.smallEtaleTopology S) T, R'.arrows (𝟙 T) := by
      intro R' hR'
      change R' ∈ Scheme.smallGrothendieckTopology @Etale S T at hR'
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale _
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR'
      have hR'' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale _
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hR'
      obtain ⟨Y, f, y, hf, hfe, hy⟩ := hR'' (e.inv (IsLocalRing.closedPoint R))
      obtain ⟨σ₀, hσ0⟩ := @key Y.left f.left hfe y hy
      let σ' : T ⟶ Y := MorphismProperty.Over.homMk σ₀ (by
        rw [← MorphismProperty.Over.w f]
        exact (Category.assoc _ _ _).symm.trans
          ((congrArg (fun k => k ≫ T.hom) hσ0).trans (Category.id_comp _)))
      have h := R'.downward_closed hf σ'
      rwa [hT.hom_ext (σ' ≫ f) (𝟙 T)] at h

    obtain ⟨α, -, hαs, -⟩ := wc_et_zmod_ring_locbij S m
    haveI := hαs
    have hαT : Function.Surjective (α.app (Opposite.op T)) := by
      intro s
      have h1 := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology S) α s
      have h2 := hcov _ h1
      rw [Presheaf.imageSieve_apply] at h2
      obtain ⟨t, ht⟩ := h2
      exact ⟨t, by simpa using ht⟩

    haveI : NeZero m := ⟨hm⟩
    have hαT' : Function.Surjective
        (fun t : ULift.{u+1} (ZMod m) => (α.app (Opposite.op T)) t) := hαT
    haveI hfinT : Finite ((wcEtZModRing S m).obj.obj (Opposite.op T)) :=
      Finite.of_surjective _ hαT'
    have hcardT : Nat.card ((wcEtZModRing S m).obj.obj (Opposite.op T)) ≤ m := by
      have h := Nat.card_le_card_of_surjective _ hαT'
      rwa [Nat.card_ulift, Nat.card_zmod] at h

    obtain ⟨hinj, -⟩ := wc_et_zmod_unit_hom_eval_terminal_bij S m T hT
      (SheafOfModules.unit (wcEtZModRing S m))
    exact ⟨@Finite.of_injective _ _ hfinT _ hinj,
      (@Nat.card_le_card_of_injective _ _ hfinT _ hinj).trans hcardT⟩

  intro P K Ψ R
  haveI := Dh.additive
  haveI := Dg.additive
  haveI := Dw.additive
  haveI := Dw.presLim
  haveI := Dw.presColim
  haveI : P.Additive := Adjunction.right_adjoint_additive Dh.adj
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k)))
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (ℓ ^ k)))
  let eK := (HomologicalComplex.single (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback D.f a) (ℓ ^ k))) (ComplexShape.up ℤ) 0).map
        (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst (Limits.pullback.snd D.f a) ξ)) _ _ Dh.cont Dh.φ) ≫
      (HomologicalComplex.singleMapHomologicalComplex P (ComplexShape.up ℤ) 0).inv.app
        (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) ξ) (ℓ ^ k))) ≫
      (P.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι'
  let eΨ := (HomologicalComplex.single (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k))) (ComplexShape.up ℤ) 0).map
        Dg.μ.inv ≫
      (HomologicalComplex.singleMapHomologicalComplex Dg.Φ (ComplexShape.up ℤ) 0).inv.app
        (SheafOfModules.unit (wcEtZModRing (Limits.pullback D.f a) (ℓ ^ k))) ≫
      (Dg.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map eK
  have hσ := wc_et_tpl_vanishing_point F' F'' Y n hn hn2 D ℓ hℓ k i A Λ W' φ a hA η hηb hηne ξ hξ
    x hx B Λ' W'' φ' a' hsh Dh Dg I xs hxs Dx
  have hloc : Projective (SheafOfModules.unit (wcEtZModRing (Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (ℓ ^ k))) ∧
      (Finite (SheafOfModules.unit (wcEtZModRing (Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (ℓ ^ k)) ⟶
          SheafOfModules.unit (wcEtZModRing (Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (ℓ ^ k))) ∧
        Nat.card (SheafOfModules.unit (wcEtZModRing (Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (ℓ ^ k)) ⟶
          SheafOfModules.unit (wcEtZModRing (Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (ℓ ^ k))) ≤ ℓ ^ k) := by
    obtain ⟨J, c, hpb, hJ⟩ := wc_et_dsl_shens_closed_fibre_square A (Limits.pullback.snd D.f a) x
      xs hxs B Λ' W'' φ' a' hsh
    haveI : IsIso c := hpb.isIso_snd_of_isIso
    obtain ⟨hh, hsep⟩ := wc_quot_strictly_henselian_of_ne_top B J hJ
    exact ⟨@wc_et_zmod_unit_projective_of_strictly_local _ (B ⧸ J) _ hh hsep (asIso c) (ℓ ^ k),
      @c1 _ (B ⧸ J) _ hh hsep (asIso c) (ℓ ^ k) (pow_ne_zero k (Nat.Prime.ne_zero Fact.out))⟩
  have hp : Epi (Dw.μ.inv ≫ Dw.Φ.map (wcEtSuppUnitMap Dx)) := by
    haveI := wc_et_tpl_sfu_geom_pt_closed_immersion F' F'' Y n D i A Λ W' φ a hA x hx xs hxs
    haveI := wc_et_supp_unit_epi _ Dx
    exact epi_comp _ _
  exact c2 Dw.Φ (SheafOfModules.unit _) (SheafOfModules.unit _) Dw.μ hloc.1 (wcEtSuppObj Dx)
    (wcEtSuppUnitMap Dx) hp Ψ eΨ (((n - 1) : ℕ) : ℤ) (by omega) hσ (ℓ ^ k) hloc.2.1 hloc.2.2

theorem wc_et_dnb_bwk_etale_lift {X U : Scheme.{u}} (jU : U ⟶ X) [Etale jU] (u : U)
    (V : U.Opens) (hu : u ∈ V)
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (a' : Spec (.of B) ⟶ X) (ha' : a' (IsLocalRing.closedPoint B) = jU u) :
    ∃ (W : U.Opens) (β : Spec (.of B) ⟶ W.toScheme), W ≤ V ∧ u ∈ W ∧
      β ≫ W.ι ≫ jU = a' ∧ (β ≫ W.ι) (IsLocalRing.closedPoint B) = u :=
by
  obtain ⟨U', hu', hiso⟩ := wc_etale_fibre_point_isolated jU u
  have huW : u ∈ V ⊓ U' := (TopologicalSpace.Opens.mem_inf).mpr ⟨hu, hu'⟩
  obtain ⟨w₀, hw₀⟩ : u ∈ Set.range (V ⊓ U').ι := by
    rw [Scheme.Opens.range_ι]; exact huW
  have hw : ((V ⊓ U').ι ≫ jU) w₀ = a' (IsLocalRing.closedPoint B) := by
    rw [Scheme.Hom.comp_apply, hw₀, ha']
  obtain ⟨β, hβ⟩ := wc_strictHensel_etale_point_lift B a' ((V ⊓ U').ι ≫ jU) w₀ hw
  have key : ∀ c : Spec (.of B), a' c = jU u → (β ≫ (V ⊓ U').ι) c = u := by
    intro c hc
    have h1 : (V ⊓ U').ι (β c) ∈ ((V ⊓ U' : U.Opens) : Set U) := by
      rw [← Scheme.Opens.range_ι]; exact ⟨_, rfl⟩
    have hmem : (β ≫ (V ⊓ U').ι) c ∈ U' := by
      rw [Scheme.Hom.comp_apply]
      exact ((TopologicalSpace.Opens.mem_inf).mp h1).2
    apply hiso _ hmem
    rw [← Scheme.Hom.comp_apply, Category.assoc, hβ, hc]
  exact ⟨V ⊓ U', β, inf_le_left, huW, hβ, key _ ha'⟩

theorem wc_et_dnb_bwk_dvr_kummer_order (R : Type u) [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] (y : R) (hy : IsLocalRing.maximalIdeal R = Ideal.span {y})
    (Kb : Type u) [Field Kb] (φ : R →+* Kb)
    (hAway : @IsLocalization.Away R _ y Kb _ φ.toAlgebra)
    (M : ℕ) (hM : 0 < M) (j : ℕ) (τ : Kb) (hτ : τ ^ M = φ y ^ j) : M ∣ j :=
by
  classical
  letI := φ.toAlgebra
  haveI : IsLocalization.Away y Kb := hAway
  have hal : algebraMap R Kb = φ := RingHom.algebraMap_toAlgebra φ
  have hφy : φ y ≠ 0 := by
    have h1 := IsLocalization.Away.algebraMap_isUnit (S := Kb) y
    rw [hal] at h1
    exact h1.ne_zero
  have hym : y ∈ IsLocalRing.maximalIdeal R := by
    rw [hy]; exact Ideal.mem_span_singleton_self y
  have hnu : ∀ d : ℕ, ¬ IsUnit (y ^ (d + 1)) := by
    intro d hu
    have hmem : y ^ (d + 1) ∈ IsLocalRing.maximalIdeal R := by
      rw [pow_succ]; exact Ideal.mul_mem_left _ _ hym
    exact (IsLocalRing.notMem_maximalIdeal.mpr hu) hmem
  have s1 : ∀ r : R, r ≠ 0 → ∃ (v : R) (k : ℕ), IsUnit v ∧ r = v * y ^ k := by
    intro r hr
    have hK := Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal R)
      (IsLocalRing.maximalIdeal.isMaximal R).ne_top
    have hex : ∃ i, r ∉ IsLocalRing.maximalIdeal R ^ i := by
      by_contra hcon
      push_neg at hcon
      apply hr
      have : r ∈ ⨅ i, IsLocalRing.maximalIdeal R ^ i := Ideal.mem_iInf.mpr hcon
      rw [hK] at this
      exact (Ideal.mem_bot).mp this
    have H : ∃ k, r ∉ IsLocalRing.maximalIdeal R ^ (k + 1) := by
      obtain ⟨i, hi⟩ := hex
      cases i with
      | zero => exact absurd (by simp : r ∈ IsLocalRing.maximalIdeal R ^ 0) hi
      | succ j => exact ⟨j, hi⟩
    obtain ⟨k, hk1, hkmin⟩ : ∃ k, r ∉ IsLocalRing.maximalIdeal R ^ (k + 1) ∧
        ∀ j < k, ¬ (r ∉ IsLocalRing.maximalIdeal R ^ (j + 1)) :=
      ⟨Nat.find H, Nat.find_spec H, fun j hj => Nat.find_min H hj⟩
    have hk0 : r ∈ IsLocalRing.maximalIdeal R ^ k := by
      by_cases h0 : k = 0
      · rw [h0]; simp
      · obtain ⟨j, hj⟩ := Nat.exists_eq_succ_of_ne_zero h0
        have := hkmin j (by omega)
        rw [hj]; exact not_not.mp this
    rw [hy, Ideal.span_singleton_pow] at hk0 hk1
    obtain ⟨v, hv⟩ := Ideal.mem_span_singleton'.mp hk0
    refine ⟨v, k, ?_, hv.symm⟩
    rw [← IsLocalRing.notMem_maximalIdeal, hy]
    intro hvm
    obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp hvm
    apply hk1
    refine Ideal.mem_span_singleton'.mpr ⟨w, ?_⟩
    rw [← hv, ← hw]; ring
  have hinj : Function.Injective φ := by
    rw [injective_iff_map_eq_zero]
    intro a ha
    by_contra hne
    obtain ⟨v, k, hv, rfl⟩ := s1 a hne
    rw [map_mul, map_pow] at ha
    exact mul_ne_zero (hv.map φ).ne_zero (pow_ne_zero k hφy) ha
  have hφyp : ∀ n : ℕ, φ y ^ n ≠ 0 := fun n => pow_ne_zero n hφy
  obtain ⟨e₀, r₀, hr₀⟩ := IsLocalization.Away.surj y τ
  rw [hal] at hr₀
  have hτ0 : τ ≠ 0 := by
    rintro rfl
    rw [zero_pow (by omega)] at hτ
    exact hφyp j hτ.symm
  have hr0 : r₀ ≠ 0 := by
    rintro rfl
    rw [map_zero] at hr₀
    exact mul_ne_zero hτ0 (hφyp e₀) hr₀
  have hR : φ (r₀ ^ M) = φ (y ^ (j + e₀ * M)) := by
    rw [map_pow, ← hr₀, mul_pow, hτ, map_pow, pow_add, ← pow_mul]
  have hR' := hinj hR
  obtain ⟨w, a, hw, rfl⟩ := s1 r₀ hr0
  have hK : φ w ^ M * φ y ^ (a * M) = φ y ^ (j + e₀ * M) := by
    have h1 := congrArg φ hR'
    simp only [map_pow, map_mul, mul_pow, ← pow_mul] at h1
    exact h1
  generalize hN : j + e₀ * M = N at hK
  rcases lt_trichotomy (a * M) N with hlt | heq | hgt
  · exfalso
    obtain ⟨d, hd⟩ := Nat.exists_eq_add_of_lt hlt
    have h2 : φ y ^ (a * M) * φ w ^ M = φ y ^ (a * M) * φ y ^ (d + 1) := by
      calc φ y ^ (a * M) * φ w ^ M = φ w ^ M * φ y ^ (a * M) := by ring
        _ = φ y ^ N := hK
        _ = _ := by rw [hd]; ring
    have h3 := mul_left_cancel₀ (hφyp (a * M)) h2
    have h4 : w ^ M = y ^ (d + 1) := hinj (by rw [map_pow, map_pow, h3])
    exact hnu d (by rw [← h4]; exact hw.pow M)
  · refine ⟨a - e₀, ?_⟩
    rw [Nat.mul_sub, mul_comm M a, mul_comm M e₀, heq, ← hN, Nat.add_sub_cancel]
  · exfalso
    obtain ⟨d, hd⟩ := Nat.exists_eq_add_of_lt hgt
    have h2 : φ y ^ N * (φ w ^ M * φ y ^ (d + 1)) = φ y ^ N * 1 := by
      calc φ y ^ N * (φ w ^ M * φ y ^ (d + 1)) = φ w ^ M * φ y ^ (N + d + 1) := by ring
        _ = _ := by rw [← hd, hK, mul_one]
    have h3 := mul_left_cancel₀ (hφyp N) h2
    have h4 : w ^ M * y ^ (d + 1) = 1 :=
      hinj (by rw [map_mul, map_pow, map_pow, map_one, h3])
    exact hnu d ⟨⟨y ^ (d + 1), w ^ M, by rw [mul_comm]; exact h4, h4⟩, rfl⟩

theorem wc_et_dnb_bwk_branch_order (A : Type u) [CommRing A] [IsLocalRing A] (π : A)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    (K : Type u) [Field K] (ι : K →+* A) (hι : Function.Bijective ((IsLocalRing.residue A).comp ι))
    (n : ℕ) (hnm : n = 2 * 1) (c P P' : Matrix (Fin n) (Fin n) A) (hP : IsUnit P.det)
    (hP' : IsUnit P'.det) (D' D'' : MvPolynomial (Fin n) A)
    (hD0 : MvPolynomial.constantCoeff D' = 0) (hD0' : MvPolynomial.constantCoeff D'' = 0)
    (hid : (∑ p, ∑ q, MvPolynomial.C (c p q) * (∑ a, MvPolynomial.C (P p a) * MvPolynomial.X a) *
          (∑ b, MvPolynomial.C (P q b) * MvPolynomial.X b)) =
        ∑ j : Fin 1, MvPolynomial.X (⟨2 * j.val, by omega⟩ : Fin n) *
          MvPolynomial.X (⟨2 * j.val + 1, by omega⟩ : Fin n) + MvPolynomial.C π * D')
    (hid' : (∑ p, ∑ q, MvPolynomial.C (c p q) * (∑ a, MvPolynomial.C (P' p a) * MvPolynomial.X a) *
          (∑ b, MvPolynomial.C (P' q b) * MvPolynomial.X b)) =
        ∑ j : Fin 1, MvPolynomial.X (⟨2 * j.val, by omega⟩ : Fin n) *
          MvPolynomial.X (⟨2 * j.val + 1, by omega⟩ : Fin n) + MvPolynomial.C π * D'')
    (hPinv : ∀ d : Fin n, P'⁻¹ (⟨2 * (0 : Fin 1).val, by omega⟩ : Fin n) d =
      P⁻¹ (⟨2 * (0 : Fin 1).val + 1, by omega⟩ : Fin n) d)
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (βQ : wcQuadModelRing A n π c →+* B) (hβ : WeaklyEtale (Spec.map (CommRingCat.ofHom βQ)))
    (ht : ∀ p, βQ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) ∈
      IsLocalRing.maximalIdeal B)
    (C : Type u) [CommRing C] [IsLocalRing C] (ρ : B →+* C) (hρ : Function.Surjective ρ)
    (hρπ : ρ (βQ (algebraMap A (wcQuadModelRing A n π c) π)) = 0)
    (s t : C) (hspan : Ideal.span {s, t} = IsLocalRing.maximalIdeal C)
    (Kb : Type u) [Field Kb] [Algebra C Kb] [IsLocalization.Away t Kb]
    (hL3 : ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (y : R),
      IsLocalRing.maximalIdeal R = Ideal.span {y} → ∀ (Kb' : Type u) [Field Kb'] (φ : R →+* Kb'),
      @IsLocalization.Away R _ y Kb' _ φ.toAlgebra → ∀ (M : ℕ), 0 < M → ∀ (j : ℕ) (τ : Kb'),
      τ ^ M = φ y ^ j → M ∣ j) :
    ∃ (P₀ : Matrix (Fin n) (Fin n) A) (D₀ : MvPolynomial (Fin n) A),
      ((P₀ = P ∧ D₀ = D') ∨ (P₀ = P' ∧ D₀ = D'')) ∧
      algebraMap C Kb (ρ (βQ (wcSnkcS π c P₀ (⟨2 * (0 : Fin 1).val + 1, by omega⟩ : Fin n)))) ≠ 0 ∧
      ∀ (M : ℕ), 0 < M → ∀ (j : ℕ) (τ : Kb), τ ^ M =
        (algebraMap C Kb (ρ (βQ (wcSnkcS π c P₀ (⟨2 * (0 : Fin 1).val + 1, by omega⟩ : Fin n))))) ^ j →
        M ∣ j :=
by
  classical
  have hconv : ∀ (P₁ : Matrix (Fin n) (Fin n) A) (a : Fin n), wcSnkcS π c P₁ a =
      Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
        (∑ d, MvPolynomial.C (P₁⁻¹ a d) * MvPolynomial.X d) := by
    intro P₁ a
    rw [map_sum]
    unfold wcSnkcS
    refine Finset.sum_congr rfl (fun d _ => ?_)
    rw [map_mul]
    rfl
  obtain ⟨lam, hlam⟩ : ∃ lam : B →+* Kb, lam = (algebraMap C Kb).comp ρ := ⟨_, rfl⟩
  have hlamπ : lam (βQ (algebraMap A (wcQuadModelRing A n π c) π)) = 0 := by
    rw [hlam, RingHom.comp_apply, hρπ, map_zero]

  obtain ⟨P₀, D₀, hchoice, hkill⟩ : ∃ (P₀ : Matrix (Fin n) (Fin n) A)
      (D₀ : MvPolynomial (Fin n) A), ((P₀ = P ∧ D₀ = D') ∨ (P₀ = P' ∧ D₀ = D'')) ∧
      lam (βQ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
        (∑ d, MvPolynomial.C (P₀⁻¹ (⟨2 * (0 : Fin 1).val, by omega⟩ : Fin n) d) *
          MvPolynomial.X d))) = 0 := by
    obtain ⟨SP, hSP⟩ : ∃ S : Fin n → wcQuadModelRing A n π c, ∀ i, S i =
        Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
          (∑ d, MvPolynomial.C (P⁻¹ i d) * MvPolynomial.X d) := ⟨_, fun _ => rfl⟩
    obtain ⟨u, hu, hrel, -, -, -⟩ :=
      wc_pmn_nbr_slice_explicit A π hπ K ι hι 1 n hnm c P hP D' hD0 hid B βQ hβ ht SP hSP
    rw [Fin.sum_univ_one] at hrel
    have h0 := congrArg lam hrel
    rw [map_mul, map_mul, hlamπ, zero_mul] at h0
    rcases mul_eq_zero.mp h0.symm with h | h
    · rw [hSP] at h
      exact ⟨P, D', Or.inl ⟨rfl, rfl⟩, h⟩
    · refine ⟨P', D'', Or.inr ⟨rfl, rfl⟩, ?_⟩
      rw [hSP] at h
      simp only [hPinv]
      exact h
  obtain ⟨hP₀, hD₀, hid₀⟩ : IsUnit P₀.det ∧ MvPolynomial.constantCoeff D₀ = 0 ∧
      (∑ p, ∑ q, MvPolynomial.C (c p q) * (∑ a, MvPolynomial.C (P₀ p a) * MvPolynomial.X a) *
          (∑ b, MvPolynomial.C (P₀ q b) * MvPolynomial.X b)) =
        ∑ j : Fin 1, MvPolynomial.X (⟨2 * j.val, by omega⟩ : Fin n) *
          MvPolynomial.X (⟨2 * j.val + 1, by omega⟩ : Fin n) + MvPolynomial.C π * D₀ := by
    rcases hchoice with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · rw [h1, h2]; exact ⟨hP, hD0, hid⟩
    · rw [h1, h2]; exact ⟨hP', hD0', hid'⟩

  obtain ⟨S, hS⟩ : ∃ S : Fin n → wcQuadModelRing A n π c, ∀ i, S i =
      Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
        (∑ d, MvPolynomial.C (P₀⁻¹ i d) * MvPolynomial.X d) := ⟨_, fun _ => rfl⟩
  have hx0 : lam (βQ (S ⟨2 * (0 : Fin 1).val, by omega⟩)) = 0 := by rw [hS]; exact hkill
  obtain ⟨u, hu, hrel, hSm, hI, hWE⟩ :=
    wc_pmn_nbr_slice_explicit A π hπ K ι hι 1 n hnm c P₀ hP₀ D₀ hD₀ hid₀ B βQ hβ ht S hS
  obtain ⟨ζ, hζ⟩ : ∃ ζ : MvPolynomial (Fin 1) K →+* B,
      ζ = MvPolynomial.eval₂Hom ((βQ.comp (algebraMap A (wcQuadModelRing A n π c))).comp ι)
        (fun j : Fin 1 => βQ (S ⟨2 * j.val + 1, by omega⟩)) := ⟨_, rfl⟩
  rw [← hζ] at hWE
  have hζX : ζ (MvPolynomial.X 0) = βQ (S ⟨2 * (0 : Fin 1).val + 1, by omega⟩) := by
    rw [hζ]; exact MvPolynomial.eval₂Hom_X' _ _ _
  obtain ⟨I, hIdef⟩ : ∃ I : Ideal B, I = Ideal.map βQ
      (Ideal.span (Set.range fun j : Fin 1 => S ⟨2 * j.val, by omega⟩)) := ⟨_, rfl⟩
  rw [← hIdef] at hI hWE
  obtain ⟨hR, hRs⟩ := wc_quot_strictly_henselian_of_ne_top B I hI
  have hyR : Ideal.Quotient.mk I (ζ (MvPolynomial.X 0)) ∈ IsLocalRing.maximalIdeal (B ⧸ I) := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    rintro ⟨v, hv⟩
    obtain ⟨z, hz⟩ := Ideal.Quotient.mk_surjective (↑v⁻¹ : B ⧸ I)
    have e1 : Ideal.Quotient.mk I (ζ (MvPolynomial.X 0) * z - 1) = 0 := by
      rw [map_sub, map_mul, map_one, hz, ← hv, Units.mul_inv, sub_self]
    have e2 : ζ (MvPolynomial.X 0) * z - 1 ∈ IsLocalRing.maximalIdeal B :=
      IsLocalRing.le_maximalIdeal hI (Ideal.Quotient.eq_zero_iff_mem.mp e1)
    have e3 : ζ (MvPolynomial.X 0) * z ∈ IsLocalRing.maximalIdeal B := by
      rw [hζX]; exact Ideal.mul_mem_right _ _ (hSm _)
    have e4 : (1 : B) ∈ IsLocalRing.maximalIdeal B := by
      have e5 := Ideal.sub_mem _ e3 e2
      rwa [sub_sub_cancel] at e5
    exact (IsLocalRing.maximalIdeal.isMaximal B).ne_top ((Ideal.eq_top_iff_one _).mpr e4)
  obtain ⟨hnoeth, hmR, -⟩ :=
    wc_pmn_nbr_slice_dvr K (B ⧸ I) ((Ideal.Quotient.mk I).comp ζ) hWE hyR
  have hlamI : ∀ r ∈ I, lam r = 0 := by
    intro r hr
    have hle : I ≤ RingHom.ker lam := by
      rw [hIdef, Ideal.map_le_iff_le_comap, Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      obtain rfl : j = 0 := Subsingleton.elim _ _
      simp only [SetLike.mem_coe, Ideal.mem_comap, RingHom.mem_ker]
      exact hx0
    exact (RingHom.mem_ker).mp (hle hr)
  obtain ⟨φ, hφdef⟩ : ∃ φ : B ⧸ I →+* Kb, φ = Ideal.Quotient.lift I lam hlamI := ⟨_, rfl⟩
  have hφ : φ.comp (Ideal.Quotient.mk I) = lam := by
    rw [hφdef]; exact Ideal.Quotient.lift_comp_mk I lam hlamI
  have hφ' : φ.comp (Ideal.Quotient.mk I) = (algebraMap C Kb).comp ρ := by rw [hφ, hlam]
  obtain ⟨hφy, hgen⟩ := wc_pmn_nbr_branch_nondeg B (B ⧸ I) (Ideal.Quotient.mk I)
    Ideal.Quotient.mk_surjective (ζ (MvPolynomial.X 0)) hmR C ρ hρ s t hspan Kb φ hφ'
  have hAway := wc_pmn_nbr_dvr_branch_away (B ⧸ I) (Ideal.Quotient.mk I (ζ (MvPolynomial.X 0)))
    hmR Kb φ hφy hgen
  have hval : algebraMap C Kb (ρ (βQ (wcSnkcS π c P₀
      (⟨2 * (0 : Fin 1).val + 1, by omega⟩ : Fin n)))) =
      φ (Ideal.Quotient.mk I (ζ (MvPolynomial.X 0))) := by
    have e1 : φ (Ideal.Quotient.mk I (ζ (MvPolynomial.X 0))) = lam (ζ (MvPolynomial.X 0)) := by
      rw [← hφ]; rfl
    rw [e1, hζX, hS, ← hconv, hlam, RingHom.comp_apply]
  refine ⟨P₀, D₀, hchoice, ?_, ?_⟩
  · rw [hval]; exact hφy
  · intro M hM j τ hτ
    rw [hval] at hτ
    exact hL3 (B ⧸ I) (Ideal.Quotient.mk I (ζ (MvPolynomial.X 0))) hmR Kb φ hAway M hM j τ hτ

theorem wc_et_dnb_bwk_germ_ring {X : Scheme.{u}} (A : Type u) [CommRing A] [IsLocalRing A]
    (gX : X ⟶ Spec (.of A)) (x : X) (hx : gX x = IsLocalRing.closedPoint A)
    (B : Type u) [CommRing B] [IsLocalRing B] (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt X x)) (Scheme.Etale.forget X))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ X)
    (hsh : wcHalShData x B Λ' W'' φ' a')
    (C : Type u) [CommRing C] [IsLocalRing C]
    (eC : Limits.pullback a' (Limits.pullback.fst gX (wcQmSp A)) ≅ Spec (.of C)) :
    ∃ ρ : B →+* C, Function.Surjective ρ ∧
      Spec.map (CommRingCat.ofHom ρ) = eC.inv ≫ Limits.pullback.fst a' (Limits.pullback.fst gX (wcQmSp A)) ∧
      ∀ g : A →+* B, Spec.map (CommRingCat.ofHom g) = a' ≫ gX →
        ∀ r ∈ IsLocalRing.maximalIdeal A, ρ (g r) = 0 :=
by
  classical
  haveI h0 : IsClosedImmersion (wcQmSp A) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  haveI h1 : IsClosedImmersion (Limits.pullback.fst gX (wcQmSp A)) :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion)
      (IsPullback.of_hasPullback _ _).flip h0
  haveI h2 : IsClosedImmersion (Limits.pullback.fst a' (Limits.pullback.fst gX (wcQmSp A))) :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion)
      (IsPullback.of_hasPullback _ _).flip h1
  haveI hci : IsClosedImmersion
      (eC.inv ≫ Limits.pullback.fst a' (Limits.pullback.fst gX (wcQmSp A))) :=
    IsClosedImmersion.comp _ _
  obtain ⟨ρ, hρ, hρS⟩ : ∃ ρ : B →+* C, Function.Surjective ρ ∧
      Spec.map (CommRingCat.ofHom ρ) =
        eC.inv ≫ Limits.pullback.fst a' (Limits.pullback.fst gX (wcQmSp A)) := by
    obtain ⟨I, e', he'⟩ := IsClosedImmersion.Spec_iff.mp hci
    have hτS : Spec.map (Spec.preimage e'.hom) = e'.hom := Spec.map_preimage _
    have hτb : Function.Bijective (Spec.preimage e'.hom).hom := by
      rw [← isIso_SpecMap_iff, hτS]; infer_instance
    refine ⟨(Spec.preimage e'.hom).hom.comp (Ideal.Quotient.mk I),
      hτb.2.comp Ideal.Quotient.mk_surjective, ?_⟩
    have h1 : CommRingCat.ofHom ((Spec.preimage e'.hom).hom.comp (Ideal.Quotient.mk I)) =
        CommRingCat.ofHom (Ideal.Quotient.mk I) ≫ Spec.preimage e'.hom := rfl
    rw [h1, Spec.map_comp, hτS, he']
  refine ⟨ρ, hρ, hρS, ?_⟩
  intro g hg r hr
  have hθ := Spec.map_preimage (eC.inv ≫ Limits.pullback.snd a'
      (Limits.pullback.fst gX (wcQmSp A)) ≫ Limits.pullback.snd gX (wcQmSp A))
  have hc1 : Limits.pullback.fst a' (Limits.pullback.fst gX (wcQmSp A)) ≫ a' =
      Limits.pullback.snd a' (Limits.pullback.fst gX (wcQmSp A)) ≫
      Limits.pullback.fst gX (wcQmSp A) :=
    Limits.pullback.condition
  have hc2 : Limits.pullback.fst gX (wcQmSp A) ≫ gX =
      Limits.pullback.snd gX (wcQmSp A) ≫ wcQmSp A :=
    Limits.pullback.condition
  have key : CommRingCat.ofHom (ρ.comp g) = CommRingCat.ofHom (IsLocalRing.residue A) ≫
      Spec.preimage (eC.inv ≫ Limits.pullback.snd a'
        (Limits.pullback.fst gX (wcQmSp A)) ≫ Limits.pullback.snd gX (wcQmSp A)) := by
    apply Spec.map_injective
    rw [Spec.map_comp, hθ, CommRingCat.ofHom_comp, Spec.map_comp, hρS, hg]
    calc (eC.inv ≫ Limits.pullback.fst a' (Limits.pullback.fst gX (wcQmSp A))) ≫ (a' ≫ gX)
        = eC.inv ≫ (Limits.pullback.fst a' (Limits.pullback.fst gX (wcQmSp A)) ≫ a') ≫ gX := by
          simp only [Category.assoc]
      _ = eC.inv ≫ (Limits.pullback.snd a' (Limits.pullback.fst gX (wcQmSp A)) ≫
          Limits.pullback.fst gX (wcQmSp A)) ≫ gX :=
          congrArg (fun t => eC.inv ≫ t ≫ gX) hc1
      _ = eC.inv ≫ Limits.pullback.snd a' (Limits.pullback.fst gX (wcQmSp A)) ≫
          (Limits.pullback.fst gX (wcQmSp A) ≫ gX) := by
          simp only [Category.assoc]
      _ = eC.inv ≫ Limits.pullback.snd a' (Limits.pullback.fst gX (wcQmSp A)) ≫
          (Limits.pullback.snd gX (wcQmSp A) ≫ wcQmSp A) :=
          congrArg (fun t => eC.inv ≫ Limits.pullback.snd a'
            (Limits.pullback.fst gX (wcQmSp A)) ≫ t) hc2
      _ = _ := by first | rfl | simp only [Category.assoc]
  have h2 := congrArg (fun φ => φ.hom r) key
  simp only [CommRingCat.hom_ofHom, CommRingCat.hom_comp, RingHom.comp_apply] at h2
  rw [h2, (IsLocalRing.residue_eq_zero_iff r).mpr hr, map_zero]

theorem wc_et_dnb_bwk_kummer_order (Ω : Type u) [Field Ω] (Y T : Scheme.{u})
    (fY : Y ⟶ Spec (.of Ω)) (uD : T ⟶ Y) (M : ℕ) (hM : (M : Ω) ≠ 0) (ζ : Ω)
    (hζ : IsPrimitiveRoot ζ M) (v : (Γ(Y, ⊤))ˣ)
    (hord : ∀ j : ℕ, (∃ t : (Γ(T, ⊤))ˣ, t ^ M = (Units.map uD.appTop.hom.toMonoidHom v) ^ j) → M ∣ j) :
    ∃ z : wcEtZModExt Y M 1, ∀ (DU : wcEtPullData uD M) (j : ℕ), j • wcEtPull DU 1 z = 0 → M ∣ j :=
by
  obtain ⟨κY, hκY, hWY, hSY⟩ := wc_qsfx_kummer_ses_field Ω Y fY M hM ζ hζ
  obtain ⟨κT, hκT, hWT, hST⟩ := wc_qsfx_kummer_ses_field Ω T (uD ≫ fY) M hM ζ hζ
  obtain ⟨βv, hβv, -⟩ := wc_qsfx_unit_class Y v
  obtain ⟨βw, hβw, hliftT⟩ := wc_qsfx_unit_class T (Units.map uD.appTop.hom.toMonoidHom v)
  letI := HasExt.standard (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
  letI := HasExt.standard (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1})
  let yY : wcR2gsH Y M 1 :=
    (Abelian.Ext.mk₀ ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map βv)).comp
      hSY.extClass (zero_add 1)
  let yT : wcR2gsH T M 1 :=
    (Abelian.Ext.mk₀ ((presheafToSheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}).map βw)).comp
      hST.extClass (zero_add 1)
