  obtain ⟨σ, hσ⟩ := wc_strictHensel_etale_point_lift (B ⧸ J) (inv c₀ ≫ Limits.pullback.snd a'
      (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) φW w₀ hw

  haveI : WeaklyEtale a' := wc_shdata_weaklyEtale x B Λ' W'' φ' a' hsh
  haveI : WeaklyEtale (Limits.pullback.snd a'
