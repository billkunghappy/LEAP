  have hev_add : ∀ (V : S.Etale)
      (f₁ f₂ : Limits.kernel (wcEtSuppUnitMap D) ⟶ SheafOfModules.unit (wcEtZModRing S m))
      (k : (Limits.kernel (wcEtSuppUnitMap D)).val.obj (Opposite.op V)),
      ((f₁ + f₂).val.app (Opposite.op V)).hom k =
        (f₁.val.app (Opposite.op V)).hom k + (f₂.val.app (Opposite.op V)).hom k := by
    intro V f₁ f₂ k
    rw [SheafOfModules.add_val, PresheafOfModules.add_app, ModuleCat.hom_add]
    rfl
  have hev_zero : ∀ (V : S.Etale) (k : (Limits.kernel (wcEtSuppUnitMap D)).val.obj (Opposite.op V)),
      ((0 : Limits.kernel (wcEtSuppUnitMap D) ⟶ SheafOfModules.unit (wcEtZModRing S m)).val.app
        (Opposite.op V)).hom k = 0 := by
    intro V k
    have h := hev_add V 0 0 k
    rw [add_zero] at h
    exact add_left_cancel (h.symm.trans (add_zero _).symm)
  have hev_nsmul : ∀ (n : ℕ) (V : S.Etale)
      (f : Limits.kernel (wcEtSuppUnitMap D) ⟶ SheafOfModules.unit (wcEtZModRing S m))
      (k : (Limits.kernel (wcEtSuppUnitMap D)).val.obj (Opposite.op V)),
      ((n • f).val.app (Opposite.op V)).hom k = n • (f.val.app (Opposite.op V)).hom k := by
    intro n
    induction n with
    | zero => intro V f k; rw [zero_nsmul, zero_nsmul, hev_zero]
    | succ n ih => intro V f k; rw [succ_nsmul, succ_nsmul, hev_add, ih]
  have hφ₂ : ((Limits.kernel.ι (wcEtSuppUnitMap D) ≫
      (c • 𝟙 (SheafOfModules.unit (wcEtZModRing S m)))).val.app (Opposite.op VO)).hom k₁ = g := by
    rw [Preadditive.comp_nsmul, Category.comp_id, hev_nsmul, hk₁, hc]
    first
      | exact Nat.smul_one_eq_cast (R := (wcEtZModRing S m).obj.obj (Opposite.op VO)) c
      | exact (nsmul_eq_mul c (1 : (wcEtZModRing S m).obj.obj (Opposite.op VO))).trans (mul_one _)
      | simp
  exact ⟨c, key _ _ hφ₂.symm⟩

theorem wc_etqm_srhl_unit_end_const (S : Scheme.{u}) [PreconnectedSpace S] (m : ℕ) (hm : m ≠ 0)
    (e : SheafOfModules.unit (wcEtZModRing S m) ⟶ SheafOfModules.unit (wcEtZModRing S m)) :
    ∃ c : ℕ, e = c • 𝟙 (SheafOfModules.unit (wcEtZModRing S m)) :=
by
  classical


  have hbij : ∀ (Y : Scheme.{u}) (N : ℕ) (T : Y.Etale), Limits.IsTerminal T →
      ∀ (M : SheafOfModules.{u+1} (wcEtZModRing Y N)),
      Function.Bijective (fun g : SheafOfModules.unit (wcEtZModRing Y N) ⟶ M =>
        (g.val.app (Opposite.op T)).hom (1 : (wcEtZModRing Y N).obj.obj (Opposite.op T))) := by
    intro Y N T hT M
    have huniq : ∀ (X : (Y.Etale)ᵒᵖ) (a b : Opposite.op T ⟶ X), a = b := fun X a b =>
      Quiver.Hom.unop_inj (hT.hom_ext _ _)
    let evT : M.sections → M.val.obj (Opposite.op T) := fun s => s.1 (Opposite.op T)
    have hfac : (fun g : SheafOfModules.unit (wcEtZModRing Y N) ⟶ M =>
        (g.val.app (Opposite.op T)).hom (1 : (wcEtZModRing Y N).obj.obj (Opposite.op T))) =
        evT ∘ M.unitHomEquiv := by
      funext g
      first
        | exact (SheafOfModules.unitHomEquiv_apply_coe M g (Opposite.op T)).symm
        | exact (SheafOfModules.unitHomEquiv_apply_coe g (Opposite.op T)).symm
        | simp [evT, SheafOfModules.unitHomEquiv_apply_coe]
    rw [hfac]
    refine Function.Bijective.comp ⟨?_, ?_⟩ M.unitHomEquiv.bijective
    · intro s t hst
      apply PresheafOfModules.sections_ext
      intro X
      have hs := PresheafOfModules.sections_property s (hT.from X.unop).op
      have ht := PresheafOfModules.sections_property t (hT.from X.unop).op
      rw [← hs, ← ht]
      exact congrArg _ hst
    · intro m
      refine ⟨PresheafOfModules.sectionsMk
        (fun X => (M.val.map (hT.from X.unop).op).hom m) ?_, ?_⟩
      · intro X X' f
        have e : (hT.from X'.unop).op = (hT.from X.unop).op ≫ f :=
          huniq X' (hT.from X'.unop).op ((hT.from X.unop).op ≫ f)
        first
          | (rw [e, PresheafOfModules.map_comp]; rfl)
          | (simp only [e, PresheafOfModules.map_comp]; rfl)
          | (rw [e]; simp [PresheafOfModules.map_comp])
          | (rw [e]; simp)
      · have e : (hT.from (Opposite.unop (Opposite.op T))).op = 𝟙 (Opposite.op T) :=
          huniq _ _ _
        show (PresheafOfModules.sectionsMk _ _).1 (Opposite.op T) = m
        first
          | (simp only [PresheafOfModules.sectionsMk_coe, e, PresheafOfModules.map_id]; rfl)
          | (rw [PresheafOfModules.sectionsMk_coe, e, PresheafOfModules.map_id]; rfl)
          | (show (M.val.map (hT.from (Opposite.unop (Opposite.op T))).op).hom m = m
             rw [e, PresheafOfModules.map_id]; rfl)
          | (show (M.val.map (hT.from (Opposite.unop (Opposite.op T))).op).hom m = m
             rw [e]; simp)


  have hlc : ∀ (Y : Scheme.{u}) (n : ℕ), ∃ e : ∀ V : Y.Etale,
      (wcEtZModRing Y n).obj.obj (Opposite.op V) ≃+* LocallyConstant V.left (ZMod n),
      ∀ (V V' : Y.Etale) (h : V' ⟶ V) (x : (wcEtZModRing Y n).obj.obj (Opposite.op V))
        (y : V'.left), e V' (((wcEtZModRing Y n).obj.map h.op).hom x) y = e V x (h.left y) := by
    intro Y n
    have hcov : ∀ (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale) (c : V₁ ⟶ V),
        S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
      intro V S hS
      change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      obtain ⟨V₁, c, hc, y, hy⟩ := hS x
      have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
      have hEt : Etale c.left := by
        have h1 : Etale V.hom := V.prop
        have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
        exact Etale.of_comp c.left V.hom
      exact ⟨V₁, c, y, hc, hEt, hy⟩
    have wcGlue : ∀ (V : Y.Etale) (S : Sieve V), S ∈ Scheme.smallEtaleTopology Y V → ∀ (m : ℕ) (x : ∀ (V' : Y.Etale) (g : V' ⟶ V), S.arrows g → LocallyConstant V'.left (ZMod m)), (∀ (V' V'' : Y.Etale) (g : V' ⟶ V) (hg : S.arrows g) (h : V'' ⟶ V') (w : V''.left), x V'' (h ≫ g) (S.downward_closed hg h) w = x V' g hg (h.left w)) → ∃! f : LocallyConstant V.left (ZMod m), ∀ (V' : Y.Etale) (g : V' ⟶ V) (hg : S.arrows g) (v : V'.left), f (g.left v) = x V' g hg v := by
      intro V S hS m x hx
      have hEt : ∀ (A B : Y.Etale) (g : A ⟶ B), Etale g.left := by
        intro A B g
        haveI : Etale B.hom := B.prop
        have hw : g.left ≫ B.hom = A.hom := MorphismProperty.Over.w g
        haveI : Etale (g.left ≫ B.hom) := by
          rw [hw]
          exact A.prop
        exact Etale.of_comp g.left B.hom
      have hOpen : ∀ (A B : Y.Etale) (g : A ⟶ B), IsOpenMap g.left := by
        intro A B g
        haveI := hEt A B g
        exact g.left.isOpenMap
      have hsurj : ∀ v : V.left, ∃ (V' : Y.Etale) (g : V' ⟶ V) (v' : V'.left),
          S.arrows g ∧ g.left v' = v := by
        change S ∈ Scheme.smallGrothendieckTopology @Etale Y V at hS
        rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
        intro v
        obtain ⟨V', g, v', hg, -, hv⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V S).mp hS v
        exact ⟨V', g, v', hg, hv⟩
      have hcongr : ∀ (Q : Y.Etale) (k k' : Q ⟶ V) (_ : k = k') (hk : S.arrows k)
          (hk' : S.arrows k') (w : Q.left), x Q k hk w = x Q k' hk' w := by
        intro Q k k' e hk hk' w
        subst e
        rfl
      have hagree : ∀ (V₁ V₂ : Y.Etale) (g₁ : V₁ ⟶ V) (g₂ : V₂ ⟶ V) (hg₁ : S.arrows g₁)
          (hg₂ : S.arrows g₂) (v₁ : V₁.left) (v₂ : V₂.left), g₁.left v₁ = g₂.left v₂ →
          x V₁ g₁ hg₁ v₁ = x V₂ g₂ hg₂ v₂ := by
        intro V₁ V₂ g₁ g₂ hg₁ hg₂ v₁ v₂ hv
        haveI : Etale g₂.left := hEt V₂ V g₂
        haveI : Etale V₁.hom := V₁.prop
        let Q : Y.Etale := MorphismProperty.Over.mk ⊤
          (Limits.pullback.fst g₁.left g₂.left ≫ V₁.hom)
          (inferInstance : Etale (Limits.pullback.fst g₁.left g₂.left ≫ V₁.hom))
        let h₁ : Q ⟶ V₁ := MorphismProperty.Over.homMk (Limits.pullback.fst g₁.left g₂.left) rfl trivial
        have hc : Limits.pullback.snd g₁.left g₂.left ≫ V₂.hom = Q.hom := by
          change Limits.pullback.snd g₁.left g₂.left ≫ V₂.hom =
            Limits.pullback.fst g₁.left g₂.left ≫ V₁.hom
          rw [← MorphismProperty.Over.w g₂, ← MorphismProperty.Over.w g₁, ← Category.assoc,
            ← Category.assoc, Limits.pullback.condition]
        let h₂ : Q ⟶ V₂ := MorphismProperty.Over.homMk (Limits.pullback.snd g₁.left g₂.left) hc trivial
        obtain ⟨c₁, hc₁⟩ : ∃ c : Q ⟶ V, c = h₁ ≫ g₁ := ⟨_, rfl⟩
        obtain ⟨c₂, hc₂⟩ : ∃ c : Q ⟶ V, c = h₂ ≫ g₂ := ⟨_, rfl⟩
        have hc12 : c₁ = c₂ := by
          apply MorphismProperty.Over.Hom.ext
          rw [hc₁, hc₂]
          change Limits.pullback.fst g₁.left g₂.left ≫ g₁.left =
            Limits.pullback.snd g₁.left g₂.left ≫ g₂.left
          exact Limits.pullback.condition
        obtain ⟨w, hw₁, hw₂⟩ := Scheme.Pullback.exists_preimage_pullback v₁ v₂ hv
        have k1 : h₁.left w = v₁ := hw₁
        have k2 : h₂.left w = v₂ := hw₂
        have e1 := hx V₁ Q g₁ hg₁ h₁ w
        have e2 := hx V₂ Q g₂ hg₂ h₂ w
        rw [← k1, ← k2, ← e1, ← e2]
        exact hcongr Q _ _ (hc₁.symm.trans (hc12.trans hc₂)) _ _ w
      choose V₀ g₀ z₀ hg₀ hz₀ using hsurj
      let F : V.left → ZMod m := fun v => x (V₀ v) (g₀ v) (hg₀ v) (z₀ v)
      have hF : ∀ (V' : Y.Etale) (g : V' ⟶ V) (hg : S.arrows g) (v : V'.left),
          F (g.left v) = x V' g hg v := by
        intro V' g hg v
        exact hagree _ _ _ _ _ _ _ _ (hz₀ (g.left v))
      have hFlc : IsLocallyConstant F := by
        rw [IsLocallyConstant.iff_isOpen_fiber]
        intro a
        have hfib : F ⁻¹' {a} = ⋃ (i : Σ V' : Y.Etale, {g : V' ⟶ V // S.arrows g}),
            i.2.1.left '' {z | x i.1 i.2.1 i.2.2 z = a} := by
          ext v
          constructor
          · intro hv
            exact Set.mem_iUnion.2 ⟨⟨V₀ v, g₀ v, hg₀ v⟩, z₀ v, hv, hz₀ v⟩
          · intro hv
            obtain ⟨⟨V', g, hg⟩, z, hz, hzv⟩ := Set.mem_iUnion.1 hv
            subst hzv
            exact (hF V' g hg z).trans hz
        rw [hfib]
        apply isOpen_iUnion
        intro i
        exact hOpen _ _ i.2.1 _ (IsLocallyConstant.isOpen_fiber (x i.1 i.2.1 i.2.2).isLocallyConstant a)
      refine ⟨⟨F, hFlc⟩, fun V' g hg v => hF V' g hg v, ?_⟩
      intro f' hf'
      ext v
      change f' v = F v
      exact (congrArg f' (hz₀ v)).symm.trans (hf' _ _ _ _)
    let L : (Y.Etale)ᵒᵖ ⥤ RingCat.{u+1} :=
      { obj := fun V => RingCat.of (LocallyConstant V.unop.left (ULift.{u+1} (ZMod n)))
        map := fun g => RingCat.ofHom (LocallyConstant.comapRingHom
          ⟨g.unop.left, g.unop.left.continuous⟩)
        map_id := fun _ => rfl
        map_comp := fun _ _ => rfl }
    let eL : ∀ V : Y.Etale, (L.obj (Opposite.op V)) ≃+* LocallyConstant V.left (ZMod n) := fun V =>
      { toFun := fun f => (show LocallyConstant V.left (ULift.{u+1} (ZMod n)) from f).map ULift.down
        invFun := fun g => (show L.obj (Opposite.op V) from g.map ULift.up)
        left_inv := fun f => rfl
        right_inv := fun g => rfl
        map_mul' := fun f g => rfl
        map_add' := fun f g => rfl }
    have hL : Presheaf.IsSheaf (Scheme.smallEtaleTopology Y) L := by
      rw [Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology Y) L
        (forget RingCat.{u+1}), isSheaf_iff_isSheaf_of_type]
      intro V S hS x hx
      have hx' := hx.to_sieveCompatible
      obtain ⟨f, hf, huniq⟩ := wcGlue V S hS n
        (fun V' g hg => eL V' (x g hg)) (by
        intro V' V'' g hg h w
        exact (congrArg (fun t => (eL V'' t) w) (hx' g h hg)).trans rfl)
      refine ⟨(eL V).symm f, ?_, ?_⟩
      · intro V' g hg
        apply (eL V').injective
        ext v
        exact hf V' g hg v
      · intro t ht
        have : eL V t = f := by
          apply huniq
          intro V' g hg v
          rw [← ht g hg]
          rfl
        exact (eL V).eq_symm_apply.mpr this
    let P := (Functor.const (Y.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n)))
    let α : P ⟶ L :=
      { app := fun V => RingCat.ofHom (LocallyConstant.constRingHom :
          ULift.{u+1} (ZMod n) →+* LocallyConstant V.unop.left (ULift.{u+1} (ZMod n)))
        naturality := fun _ _ _ => rfl }
    have hinj : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology Y) α := by
      constructor
      intro X a b hab
      apply hcov
      intro v
      have hab' : a = b :=
        congrArg (fun f : LocallyConstant X.unop.left (ULift.{u+1} (ZMod n)) => f v) hab
      refine ⟨X.unop, 𝟙 _, ?_, ⟨v, rfl⟩⟩
      rw [Presheaf.equalizerSieve_apply, hab']
    have hsurj : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) α := by
      constructor
      intro V s
      apply hcov
      intro v
      let f : LocallyConstant V.left (ULift.{u+1} (ZMod n)) := s
      let O : V.left.Opens := ⟨{x | f x = f v}, f.isLocallyConstant.isOpen_fiber (f v)⟩
      let V₁ : Y.Etale := MorphismProperty.Over.mk ⊤ (O.ι ≫ V.hom) (by infer_instance)
      let c : V₁ ⟶ V := MorphismProperty.Over.homMk O.ι rfl trivial
      have hv : v ∈ Set.range O.ι := by
        rw [Scheme.Opens.range_ι]
        exact (rfl : f v = f v)
      refine ⟨V₁, c, ?_, hv⟩
      rw [Presheaf.imageSieve_apply]
      refine ⟨f v, ?_⟩
      apply LocallyConstant.ext
      intro x
      have hx : O.ι x ∈ (O : Set V.left) := by
        rw [← Scheme.Opens.range_ι]
        exact ⟨x, rfl⟩
      exact (show f (O.ι x) = f v from hx).symm
    let φ := sheafifyLift (Scheme.smallEtaleTopology Y) α hL
    have hfac : toSheafify (Scheme.smallEtaleTopology Y) P ≫ φ = α :=
      toSheafify_sheafifyLift _ α hL
    have := hinj
    have := hsurj
    have : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y)
        (toSheafify (Scheme.smallEtaleTopology Y) P) :=
      Presheaf.isLocallySurjective_toSheafify' _ P
    have h1 : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) φ :=
      Presheaf.isLocallySurjective_of_isLocallySurjective_fac _ hfac
    have h2 : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology Y) φ :=
      Presheaf.isLocallyInjective_of_isLocallyInjective_of_isLocallySurjective_fac _ α hfac
    let Φ : (constantSheaf (Scheme.smallEtaleTopology Y) RingCat.{u+1}).obj
        (RingCat.of (ULift.{u+1} (ZMod n))) ⟶
        (⟨L, hL⟩ : Sheaf (Scheme.smallEtaleTopology Y) RingCat.{u+1}) :=
      ObjectProperty.homMk φ
    have hΦ : IsIso Φ := (Sheaf.isLocallyBijective_iff_isIso Φ).mp ⟨h2, h1⟩
    have hφ : IsIso φ := by
      have : IsIso ((sheafToPresheaf (Scheme.smallEtaleTopology Y) RingCat.{u+1}).map Φ) :=
        Functor.map_isIso _ Φ
      exact this
    have hV : ∀ V, IsIso (φ.app V) := fun V => NatIso.isIso_app_of_isIso φ V
    refine ⟨fun V => (asIso (φ.app (Opposite.op V))).ringCatIsoToRingEquiv.trans (eL V), ?_⟩
    intro V V' g s x
    have key := NatTrans.naturality_apply φ g.op s
    exact (congrArg (fun t => (eL V' t) x) key).trans rfl

  let T : S.Etale := wcEtTop S
  have hT : Limits.IsTerminal T :=
    Limits.IsTerminal.ofUniqueHom
      (fun V => MorphismProperty.Over.homMk (B := T) V.hom (Category.comp_id _) trivial)
      (fun V f => by
        apply MorphismProperty.Over.Hom.ext
        exact (Category.comp_id _).symm.trans (MorphismProperty.Over.w f))

  obtain ⟨φe, -⟩ := hlc S m
  let φ := φe T
  let one : (wcEtZModRing S m).obj.obj (Opposite.op T) := 1
  let ev : (SheafOfModules.unit (wcEtZModRing S m) ⟶ SheafOfModules.unit (wcEtZModRing S m)) →
      (wcEtZModRing S m).obj.obj (Opposite.op T) :=
    fun g => (g.val.app (Opposite.op T)).hom (1 : (wcEtZModRing S m).obj.obj (Opposite.op T))
  have hcoe : ∀ (c : ℕ) (f : LocallyConstant T.left (ZMod m)) (s : T.left),
      (c • f) s = c • f s := by
    intro c f s
    induction c with
    | zero => simp
    | succ k ih => rw [succ_nsmul, LocallyConstant.coe_add, Pi.add_apply, ih, succ_nsmul]
  have hx : ∃ c : ℕ, ev e = c • one := by
    haveI : PreconnectedSpace T.left := ‹PreconnectedSpace S›
    rcases isEmpty_or_nonempty S with hS | hS
    · refine ⟨0, φ.injective ?_⟩
      ext s
      exact isEmptyElim (α := S) s
    · obtain ⟨s₀⟩ := hS
      haveI : NeZero m := ⟨hm⟩
      refine ⟨(φ (ev e) s₀).val, φ.injective ?_⟩
      ext s
      rw [map_nsmul, map_one, hcoe, LocallyConstant.apply_eq_of_preconnectedSpace (φ (ev e)) s s₀,
        LocallyConstant.coe_one, Pi.one_apply, nsmul_eq_mul, mul_one, ZMod.natCast_zmod_val]

  have hadd : ∀ g h, ev (g + h) = ev g + ev h := by
    intro g h
    show ((g + h).val.app _).hom _ = _
    rw [SheafOfModules.add_val, PresheafOfModules.add_app, ModuleCat.hom_add]
    first
      | rfl
      | exact LinearMap.add_apply _ _ _
  have hzero : ev 0 = 0 := by
    have h := hadd 0 0
    rw [add_zero] at h
    exact add_left_cancel (h.symm.trans (add_zero _).symm)
  have hid : ev (𝟙 _) = one := rfl
  have hsmul : ∀ c : ℕ, ev (c • 𝟙 (SheafOfModules.unit (wcEtZModRing S m))) = c • one := by
    intro c
    induction c with
    | zero => rw [zero_nsmul, zero_nsmul, hzero]
    | succ k ih => rw [succ_nsmul, succ_nsmul, hadd, ih, hid]

  obtain ⟨c, hc⟩ := hx
  refine ⟨c, (hbij S m T hT (SheafOfModules.unit (wcEtZModRing S m))).1 ?_⟩
  show ev e = ev (c • 𝟙 _)
  rw [hc, hsmul]

theorem wc_etqm_sfh_charts (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (r : ℕ)
    (hn : Even (r + 2)) (hn4 : 4 ≤ r + 2) (π : A)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    (c : Matrix (Fin (r + 2)) (Fin (r + 2)) A)
    (hc : c = Matrix.of fun p q : Fin (r + 2) =>
      if p.val % 2 = 0 ∧ q.val = p.val + 1 then (1 : A) else 0)
    (X' : Scheme.{u}) (β : X' ⟶ Spec (.of (wcQuadModelRing A (r + 2) π c)))
