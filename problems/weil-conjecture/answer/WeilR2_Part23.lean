theorem wc_et_cone_homology_stalk_subsingleton : ∀ {B : Scheme.{u}} (m : ℕ) (b : B)
    {K₁ K₂ : CochainComplex (SheafOfModules.{u+1} (wcEtZModRing B m)) ℤ} (φ : K₁ ⟶ K₂),
    (∀ q : ℤ, Function.Bijective ((wcEtStalk B b).map
      ((SheafOfModules.toSheaf (wcEtZModRing B m)).map (HomologicalComplex.homologyMap φ q))).hom) →
    ∀ q : ℤ, Subsingleton ((wcEtStalk B b).obj
      ((SheafOfModules.toSheaf (wcEtZModRing B m)).obj ((CochainComplex.mappingCone φ).homology q))) :=
by
  intro B m b K₁ K₂ φ hbij q

  have crux : ∀ {𝒜 : Type (u+2)} [Category.{u+1} 𝒜] [Abelian 𝒜] {𝒟 : Type (u+2)}
      [Category.{u+1} 𝒟] [Abelian 𝒟] (G : 𝒜 ⥤ 𝒟) [G.PreservesZeroMorphisms]
      [Limits.PreservesFiniteLimits G] [Limits.PreservesFiniteColimits G]
      {L₁ L₂ : CochainComplex 𝒜 ℤ} (ψ : L₁ ⟶ L₂),
      (∀ n : ℤ, IsIso (G.map (HomologicalComplex.homologyMap ψ n))) →
      ∀ q : ℤ, Limits.IsZero (G.obj ((CochainComplex.mappingCone ψ).homology q)) := by
    intro 𝒜 _ _ 𝒟 _ _ G _ _ _ L₁ L₂ ψ hψ q
    haveI : G.PreservesHomology := Functor.preservesHomologyOfExact G
    letI := HasDerivedCategory.standard 𝒜
    have hT := DerivedCategory.mappingCone_triangle_distinguished ψ
    have E₂ := (DerivedCategory.HomologySequence.exact₂ _ hT q).map G
    have E₃ := (DerivedCategory.HomologySequence.exact₃ _ hT q (q + 1) rfl).map G
    have E₁ := (DerivedCategory.HomologySequence.exact₁ _ hT q (q + 1) rfl).map G
    have hiso : ∀ n : ℤ, IsIso (G.map ((DerivedCategory.homologyFunctor 𝒜 n).map
        (DerivedCategory.Q.map ψ))) := by
      intro n
      have hnat := DerivedCategory.homologyFunctorFactors_hom_naturality ψ n
      have h3 := IsIso.comp_isIso' (inferInstance : IsIso (G.map
        ((DerivedCategory.homologyFunctorFactors 𝒜 n).hom.app L₁))) (hψ n)
      have h3' := (congrArg IsIso (G.map_comp _ _)).mpr h3
      have h2 := (congrArg (fun f => IsIso (G.map f)) hnat).mpr h3'
      have h4 := (congrArg IsIso (G.map_comp _ _)).mp h2
      exact IsIso.of_isIso_comp_right _
        (G.map ((DerivedCategory.homologyFunctorFactors 𝒜 n).hom.app L₂))
    have hepi : Epi (G.map ((DerivedCategory.homologyFunctor 𝒜 q).map
        (DerivedCategory.Q.map ψ))) := by
      haveI := hiso q; infer_instance
    have hmono : Mono (G.map ((DerivedCategory.homologyFunctor 𝒜 (q + 1)).map
        (DerivedCategory.Q.map ψ))) := by
      haveI := hiso (q + 1); infer_instance

    have hg := E₂.epi_f_iff.1 hepi
    have hδ := E₁.mono_g_iff.1 hmono
    have hz := E₃.isZero_X₂ hg hδ
    exact hz.of_iso (G.mapIso ((DerivedCategory.homologyFunctorFactors 𝒜 q).app
      (CochainComplex.mappingCone ψ)).symm)

  have hexact : Limits.PreservesFiniteLimits (wcEtStalk B b) ∧
      Limits.PreservesFiniteColimits (wcEtStalk B b) := by
    haveI : AB5OfSize.{u, u} AddCommGrpCat.{u+1} :=
      AB5OfSize_shrink.{u, u, u+1, u+1} AddCommGrpCat.{u+1}
    let Φ := Scheme.pointSmallEtale (wcEtGeomPt B b)
    let E : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B) ⥤
        Φ.fiber.Elements :=
      { obj := fun A => Φ.fiber.elementsMk A.right A.hom
        map := fun {A A'} g => ⟨g.right, StructuredArrow.w g⟩
        map_id := fun A => rfl
        map_comp := fun f g => rfl }
    let Einv : Φ.fiber.Elements ⥤
        StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B) :=
      { obj := fun x => StructuredArrow.mk (T := Scheme.Etale.forget B) (Y := x.1) x.2
        map := fun {x y} φ => StructuredArrow.homMk φ.1 φ.2
        map_id := fun x => rfl
        map_comp := fun f g => rfl }
    let eqv : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B) ≌
        Φ.fiber.Elements :=
      CategoryTheory.Equivalence.mk E Einv
        (NatIso.ofComponents (fun A => Iso.refl _) (by intros; rfl))
        (NatIso.ofComponents (fun x => Iso.refl _) (by intros; rfl))
    haveI : E.IsEquivalence := eqv.isEquivalence_functor
    haveI : E.IsLeftAdjoint := Functor.isLeftAdjoint_of_isEquivalence
    haveI : E.Initial := Functor.initial_of_isLeftAdjoint E
    haveI : E.op.Final := Functor.final_op_of_initial E
    let i0 := Functor.Final.colimIso (E := AddCommGrpCat.{u+1}) E.op
    let i1 : (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj
        (StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙
          Limits.colim ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (Functor.Elements.π Φ.fiber).op ⋙
          Limits.colim :=
      Functor.isoWhiskerLeft ((Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj
        (Functor.Elements.π Φ.fiber).op) i0
    let j : Φ.sheafFiber (A := AddCommGrpCat.{u+1}) ≅ wcEtStalk B b :=
      Functor.isoWhiskerLeft (sheafToPresheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1})
        i1.symm
    exact ⟨Limits.preservesFiniteLimits_of_natIso j, Limits.preservesFiniteColimits_of_natIso j⟩
  obtain ⟨hlim, hcolim⟩ := hexact
  haveI := hlim
  haveI := hcolim

  have htoSheaf : Limits.PreservesFiniteColimits
      (SheafOfModules.toSheaf.{u+1} (wcEtZModRing B m)) := by
    have s2 : ∀ {C : Type (u+1)} [Category.{u} C]
        (J : GrothendieckTopology C)
        [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
        (R : Sheaf J RingCat.{u+1}), Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} R) := by
      intro C _ J _ _ R
      constructor
      intro I _ _
      constructor
      intro K
      let adj := PresheafOfModules.sheafificationAdjunction (J := J) (𝟙 R.obj)
      haveI : IsIso adj.counit := inferInstance
      haveI hP : Limits.PreservesColimitsOfShape I
          (PresheafOfModules.sheafification (J := J) (𝟙 R.obj) ⋙ SheafOfModules.toSheaf.{u+1} R) :=
        Limits.preservesColimitsOfShape_of_natIso
          (PresheafOfModules.sheafificationCompToSheaf (J := J) (𝟙 R.obj)).symm
      let K₀ := K ⋙ (SheafOfModules.forget R ⋙ PresheafOfModules.restrictScalars (𝟙 R.obj))
      let c₀ := Limits.colimit.cocone K₀
      let h₀ : Limits.IsColimit c₀ := Limits.colimit.isColimit K₀
      have ht : Limits.IsColimit
          ((PresheafOfModules.sheafification (J := J) (𝟙 R.obj)).mapCocone c₀) :=
        Limits.isColimitOfPreserves _ h₀
      have ht' : Limits.IsColimit ((SheafOfModules.toSheaf.{u+1} R).mapCocone
          ((PresheafOfModules.sheafification (J := J) (𝟙 R.obj)).mapCocone c₀)) :=
        Limits.IsColimit.ofIsoColimit
          (Limits.isColimitOfPreserves
            (PresheafOfModules.sheafification (J := J) (𝟙 R.obj) ⋙ SheafOfModules.toSheaf.{u+1} R) h₀)
          (Functor.mapCoconeMapCocone c₀).symm
      haveI : Limits.PreservesColimit (K₀ ⋙ PresheafOfModules.sheafification (J := J) (𝟙 R.obj))
          (SheafOfModules.toSheaf.{u+1} R) :=
        Limits.preservesColimit_of_preserves_colimit_cocone ht ht'
      let e : K₀ ⋙ PresheafOfModules.sheafification (J := J) (𝟙 R.obj) ≅ K :=
        Functor.associator _ _ _ ≪≫ Functor.isoWhiskerLeft K (asIso adj.counit) ≪≫
          Functor.rightUnitor K
      exact Limits.preservesColimit_of_iso_diagram _ e
    exact s2 (Scheme.smallEtaleTopology B) (wcEtZModRing B m)
  haveI := htoSheaf

  let G := SheafOfModules.toSheaf.{u+1} (wcEtZModRing B m) ⋙ wcEtStalk B b
  haveI : Limits.PreservesFiniteLimits G :=
    Limits.comp_preservesFiniteLimits _ _
  haveI : Limits.PreservesFiniteColimits G :=
    Limits.comp_preservesFiniteColimits _ _
  haveI : G.PreservesZeroMorphisms :=
    Functor.preservesZeroMorphisms_of_preserves_terminal_object
  have hG : ∀ n : ℤ, IsIso (G.map (HomologicalComplex.homologyMap φ n)) := fun n =>
    (ConcreteCategory.isIso_iff_bijective _).2 (hbij n)
  exact AddCommGrpCat.isZero_iff_subsingleton.1 (crux G φ hG q)

