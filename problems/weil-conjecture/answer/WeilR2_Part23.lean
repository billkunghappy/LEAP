        = ∑ p, ∑ q, (MvPolynomial.C (MAT (τ p) (τ q)) * MvPolynomial.X p * MvPolynomial.X q :
          MvPolynomial (Fin (2 * e + 1 + 1)) K) := by
          refine Fintype.sum_equiv T _ _ (fun p => ?_)
          refine Fintype.sum_equiv T _ _ (fun q => ?_)
          simp only [hT, hττ]
      _ = ∑ p, ∑ q, (MvPolynomial.C (MAT q p) * MvPolynomial.X q * MvPolynomial.X p :
          MvPolynomial (Fin (2 * e + 1 + 1)) K) := by
          refine Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl (fun q _ => ?_))
