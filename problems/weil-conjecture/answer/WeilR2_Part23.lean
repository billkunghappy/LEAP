    let Ψ := (Dg.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k)))
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (ℓ ^ k)))
    haveI := Dw.additive
    haveI := Dw.presLim
    haveI := Dw.presColim
    let R := Dw.Φ.mapDerivedCategory
    let Lb := R.obj (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
      (SheafOfModules.unit (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k)))))
    let Sb := R.obj (DerivedCategory.Q.obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj (wcEtSuppObj Dx)))
    let ub : Lb ⟶ Sb := R.map (DerivedCategory.Q.map ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map (wcEtSuppUnitMap Dx)))
    ∀ (Kp : DerivedCategory (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (ℓ ^ k))))
      (ι : Kp ⟶ Lb) (δ : Sb ⟶ Kp⟦(1 : ℤ)⟧),
      Pretriangulated.Triangle.mk ι ub δ ∈ distTriang _ →
      ∃ (zt : Kp ⟶ Kp⟦(((n - 2) : ℕ) : ℤ)⟧) (a₁ : Kp ⟶ Lb⟦(((n - 1) : ℕ) : ℤ)⟧),
        ∀ j : ℕ, j • (zt ≫ a₁⟦(((n - 2) : ℕ) : ℤ)⟧') = 0 → ℓ ^ k ∣ j :=
by
  have key : ∃ (O : (Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))).Opens),
      (O : Set ↥(Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)))) =
        {w | Limits.pullback.snd a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) w ≠ xs} ∧
      ∃ (ζ : wcEtZModExt (O : Scheme.{u}) (ℓ ^ k) (n - 2))
        (ω : wcEtZModExt (O : Scheme.{u}) (ℓ ^ k) (n - 1)),
        ∀ j : ℕ, j • wcEtZModCup (O : Scheme.{u}) (ℓ ^ k) (n - 2) (n - 1) (2 * n - 3)
          (by omega) ζ ω = 0 → ℓ ^ k ∣ j := by
    obtain ⟨Oc, O, κ, hOc, hO, hκ, hpre, hK, hℓK⟩ := wc_et_dsl_lw_cone_chart F' F'' Y n hn hn2 D ℓ hℓ
      i A Λ W' φ a hA x hx B Λ' W'' φ' a' hsh xs hxs
    refine ⟨O, hO, ?_⟩
    rcases Nat.eq_zero_or_pos k with hk0 | hk
    · refine ⟨0, 0, fun j _ => ?_⟩
      rw [hk0, pow_zero]
      exact one_dvd j
    · haveI := hK
      let κo : (O : Scheme.{u}) ⟶ (Oc : Scheme.{u}) := κ.resLE Oc O hpre.symm.le
      have hκo : κo ≫ Oc.ι = O.ι ≫ κ := Scheme.Hom.resLE_comp_ι _ _
      obtain ⟨Dκ⟩ := wc_et_zmod_pull_data_exists κo (ℓ ^ k)
      obtain ⟨ζ, ω, hord⟩ := wc_et_quad_cone_punct_link_cup_exact (IsLocalRing.ResidueField A) ℓ
        hℓK k hk n hn h4 Oc hOc
      have hinj := wc_et_dsl_lw_cone_top_pull_injective F' F'' Y n hn hn2 D ℓ hℓ i A Λ W' φ a hA
        x hx B Λ' W'' φ' a' hsh xs hxs k hK hℓK h4 Oc hOc O hO κ hκ hpre κo hκo Dκ
      refine ⟨wcEtPull Dκ (n - 2) ζ, wcEtPull Dκ (n - 1) ω, ?_⟩
      intro j hj
      rw [← wc_et_pull_cup Dκ (n - 2) (n - 1) (2 * n - 3) (by omega) ζ ω, ← map_nsmul] at hj
      apply hord j
      apply hinj
      rw [hj, map_zero]
  obtain ⟨O, hO, ζ, ω, hcup⟩ := key
  exact wc_et_dsl_lw_punct_cup_transport F' F'' Y n hn hn2 D ℓ hℓ i A Λ W' φ a hA x hx B Λ' W''
    φ' a' hsh xs hxs k Dx Dw O hO ζ ω hcup

theorem wc_et_dnb_node_coords (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
    (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcP1Over F'').left
      (D.S i (IsLocalRing.closedPoint F'')))) (Scheme.Etale.forget (wcP1Over F'').left))
    (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ (wcP1Over F'').left)
    (hA : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A Λ W' φ a)
    (x : ↥(Limits.pullback D.f a)) (hx : Limits.pullback.fst D.f a x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Limits.pullback D.f a) x))
      (Scheme.Etale.forget (Limits.pullback D.f a)))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left) (a' : Spec (.of B) ⟶ Limits.pullback D.f a)
    (hsh : wcHalShData x B Λ' W'' φ' a') (h2 : n = 2) (G : Prop)
    (kc : ∀ (C : Type u) (_ : CommRing C) (_ : IsLocalRing C)
      (_ : Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) ≅ Spec (.of C))
      (s t : C), s * t = 0 → Ideal.span {s, t} = IsLocalRing.maximalIdeal C →
      ∀ (K₁ K₂ : Type u) (_ : Field K₁) (_ : Field K₂) (_ : Algebra C K₁) (_ : Algebra C K₂),
        IsLocalization.Away t K₁ → IsLocalization.Away s K₂ → G) : G :=
by
  classical
  subst h2
  haveI hsub : Subsingleton (Spec (.of F'')) := by
    show Subsingleton (PrimeSpectrum F''); infer_instance

  have c2 : ∀ (C : Type u) [CommRing C] [IsLocalRing C] [IsNoetherianRing C]
      (a b : C), a * b = 0 → Ideal.span {a, b} = IsLocalRing.maximalIdeal C →
      (∀ n : ℕ, b ^ n ≠ 0) →
      ∃ (K : Type u) (_ : Field K) (_ : Algebra C K), IsLocalization.Away b K := by
    intro C _ _ _ a b hab hspan hb
    have ha𝔪 : a ∈ IsLocalRing.maximalIdeal C := hspan ▸ Ideal.subset_span (by simp)
    have hb𝔪 : b ∈ IsLocalRing.maximalIdeal C := hspan ▸ Ideal.subset_span (by simp)
    have hbu : IsUnit (algebraMap C (Localization.Away b) b) :=
      IsLocalization.Away.algebraMap_isUnit b
    have hι0 : algebraMap C (Localization.Away b) a = 0 := by
      have : algebraMap C (Localization.Away b) a * algebraMap C (Localization.Away b) b = 0 := by
        rw [← map_mul, hab, map_zero]
      exact hbu.mul_left_eq_zero.mp this
    have hI𝔪 : Ideal.span {a} ≤ IsLocalRing.maximalIdeal C :=
      Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ha𝔪)
    have hkrull : ∀ c : C, (∀ N : ℕ, c ∈ Ideal.span {b ^ N} ⊔ Ideal.span {a}) →
        c ∈ Ideal.span {a} := by
      intro c hc
      have hI : Ideal.span {a} ≠ ⊤ := fun h =>
        (IsLocalRing.maximalIdeal.isMaximal C).ne_top (top_le_iff.mp (h ▸ hI𝔪))
      haveI : Nontrivial (C ⧸ Ideal.span {a}) := Ideal.Quotient.nontrivial_iff.mpr hI
      haveI : IsLocalRing (C ⧸ Ideal.span {a}) :=
        IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
      have hqb : Ideal.Quotient.mk (Ideal.span {a}) b ∈
          IsLocalRing.maximalIdeal (C ⧸ Ideal.span {a}) := by
        by_contra hn
        rw [IsLocalRing.notMem_maximalIdeal] at hn
        obtain ⟨y, hy⟩ := hn.exists_right_inv
        obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
        rw [← map_mul, ← map_one (Ideal.Quotient.mk (Ideal.span {a})), Ideal.Quotient.eq] at hy
        have h1 : b * y - 1 ∈ IsLocalRing.maximalIdeal C := hI𝔪 hy
        have h2 : b * y ∈ IsLocalRing.maximalIdeal C := Ideal.mul_mem_right _ _ hb𝔪
        have h3 : (1 : C) ∈ IsLocalRing.maximalIdeal C := by
          have := Ideal.sub_mem _ h2 h1
          rwa [sub_sub_cancel] at this
        exact (IsLocalRing.maximalIdeal.isMaximal C).ne_top ((Ideal.eq_top_iff_one _).mpr h3)
      have h := Ideal.iInf_pow_eq_bot_of_isLocalRing
        (IsLocalRing.maximalIdeal (C ⧸ Ideal.span {a})) (IsLocalRing.maximalIdeal.isMaximal _).ne_top
      have hmem : Ideal.Quotient.mk (Ideal.span {a}) c ∈
          ⨅ i, IsLocalRing.maximalIdeal (C ⧸ Ideal.span {a}) ^ i := by
        rw [Ideal.mem_iInf]
        intro N
        obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.mp (hc N)
        rw [← hyz, map_add, Ideal.Quotient.eq_zero_iff_mem.mpr hz, add_zero]
        obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hy
        rw [map_mul, map_pow]
        exact Ideal.mul_mem_left _ _ (Ideal.pow_mem_pow hqb N)
      rw [h, Ideal.mem_bot, Ideal.Quotient.eq_zero_iff_mem] at hmem
      exact hmem
    have hunit : ∀ c : C, c ∉ Ideal.span {a} →
        IsUnit (algebraMap C (Localization.Away b) c) := by
      intro c hc
      have hex : ∃ N, c ∉ Ideal.span {b ^ N} ⊔ Ideal.span {a} := by
        by_contra hne
        push_neg at hne
        exact hc (hkrull c hne)
      have hN : c ∉ Ideal.span {b ^ Nat.find hex} ⊔ Ideal.span {a} := Nat.find_spec hex
      have hN0 : Nat.find hex ≠ 0 := by
        intro h0
        apply hN
        rw [h0, pow_zero, Ideal.span_singleton_one, top_sup_eq]
        trivial
      obtain ⟨e, he⟩ : ∃ e, Nat.find hex = e + 1 := ⟨Nat.find hex - 1, by omega⟩
      have hle : c ∈ Ideal.span {b ^ e} ⊔ Ideal.span {a} := by
        have := Nat.find_min hex (show e < Nat.find hex by omega)
        push_neg at this
        exact this
      obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.mp hle
      obtain ⟨v, rfl⟩ := Ideal.mem_span_singleton'.mp hy
      obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hz
      have hv : IsUnit v := by
        by_contra hv
        rw [← IsLocalRing.notMem_maximalIdeal, not_not, ← hspan, Ideal.mem_span_pair] at hv
        obtain ⟨s, t, hst⟩ := hv
        apply hN
        rw [he, ← hyz, ← hst]
        refine Submodule.mem_sup.mpr ⟨t * b ^ (e + 1), Ideal.mem_span_singleton'.mpr ⟨t, rfl⟩,
          (s * b ^ e + r) * a, Ideal.mem_span_singleton'.mpr ⟨_, rfl⟩, by ring⟩
      rw [← hyz, map_add, map_mul, map_mul, hι0, mul_zero, add_zero, map_pow]
      exact (hv.map _).mul (hbu.pow e)
    have hnt : Nontrivial (Localization.Away b) := by
      refine ⟨⟨0, 1, fun h => ?_⟩⟩
      have h1 : algebraMap C (Localization.Away b) 1 = 0 := by rw [map_one]; exact h.symm
      obtain ⟨⟨m, hm⟩, hm0⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers b) (Localization.Away b) 1).mp h1
      obtain ⟨n, rfl⟩ := Submonoid.mem_powers_iff _ _ |>.mp hm
      exact hb n (by simpa using hm0)
    have hfield : IsField (Localization.Away b) := by
      refine ⟨hnt.exists_pair_ne, mul_comm, fun {z} hz => ?_⟩
      obtain ⟨⟨c, s⟩, hcs⟩ := IsLocalization.mk'_surjective (Submonoid.powers b) z
      dsimp only at hcs
      subst hcs
      have hspec := IsLocalization.mk'_spec (Localization.Away b) c s
      have hsu : IsUnit (algebraMap C (Localization.Away b) s) :=
        IsLocalization.map_units (Localization.Away b) s
      have hc : c ∉ Ideal.span {a} := by
        intro hca
        obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hca
        apply hz
        rw [map_mul, hι0, mul_zero] at hspec
        exact hsu.mul_left_eq_zero.mp hspec
      have hu := hunit c hc
      rw [← hspec] at hu
      exact (isUnit_of_mul_isUnit_left hu).exists_right_inv
    letI := hfield.toField
    exact ⟨Localization.Away b, inferInstance, inferInstance, inferInstance⟩

  have hcondx : D.f (Limits.pullback.fst D.f a x) = a (Limits.pullback.snd D.f a x) := by
    have hc := congrArg (fun g => g x) (Limits.pullback.condition (f := D.f) (g := a))
    simp only [Scheme.Hom.comp_apply] at hc
    exact hc
  have hxsf : D.f (D.xs i (IsLocalRing.closedPoint F'')) = D.S i (IsLocalRing.closedPoint F'') := by
    have hc := congrArg (fun g => g (IsLocalRing.closedPoint F'')) (D.hxs i)
    simp only [Scheme.Hom.comp_apply] at hc
    exact hc
  have hSx : a (Limits.pullback.snd D.f a x) = D.S i (IsLocalRing.closedPoint F'') := by
    rw [← hcondx, hx, hxsf]
  have hsx : Limits.pullback.snd D.f a x = IsLocalRing.closedPoint A :=
    wc_shdata_fibre_closed_point _ A Λ W' φ a hA _ hSx
  have hρpt : (wcQmSp A) (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) =
      IsLocalRing.closedPoint A := by
    first
      | exact IsLocalRing.comap_closedPoint (IsLocalRing.residue A)
      | exact (Spec.map_apply _ _).trans (IsLocalRing.comap_closedPoint (IsLocalRing.residue A))
      | (erw [Spec.map_apply]; exact IsLocalRing.comap_closedPoint (IsLocalRing.residue A))
  obtain ⟨xs₀, hxs₀, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := Limits.pullback.snd D.f a)
    (g := wcQmSp A) x (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) (hsx.trans hρpt.symm)

  obtain ⟨J, c, hpb, hJ⟩ :=
    wc_et_dsl_shens_closed_fibre_square A (Limits.pullback.snd D.f a) x xs₀ hxs₀ B Λ' W'' φ' a' hsh
  obtain ⟨hH, hSC⟩ := wc_quot_strictly_henselian_of_ne_top B J hJ
  letI := hH
  haveI := hSC
  haveI : IsIso c := hpb.isIso_snd_of_isIso

  have hfc : inv c ≫ Limits.pullback.fst a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) =
      Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)) := by
    have hw := hpb.w
    rw [Category.comp_id] at hw
    rw [hw, IsIso.inv_hom_id_assoc]
  have hclB : Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)) (IsLocalRing.closedPoint (B ⧸ J)) =
      IsLocalRing.closedPoint B := by
    haveI : IsLocalHom (CommRingCat.Hom.hom (CommRingCat.ofHom (Ideal.Quotient.mk J))) := by
      rw [CommRingCat.hom_ofHom]
      exact IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
    exact Spec_closedPoint
  have ha'x : a' (IsLocalRing.closedPoint B) = x := by
    obtain ⟨ee, -, he⟩ := hsh.2.2.2.2.2
    have h1 : ∀ g g' : Spec (.of (AlgebraicClosure ((Limits.pullback D.f a).residueField x))) ⟶ Limits.pullback D.f a,
        g = g' → g (IsLocalRing.closedPoint (AlgebraicClosure ((Limits.pullback D.f a).residueField x))) = g' (IsLocalRing.closedPoint (AlgebraicClosure ((Limits.pullback D.f a).residueField x))) := by
      rintro g _ rfl; rfl
    have h2 := h1 _ _ he
    have h3 : a' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))
        ((Spec.map (CommRingCat.ofHom ee)) (IsLocalRing.closedPoint (AlgebraicClosure ((Limits.pullback D.f a).residueField x))))) = x :=
      h2.trans (Scheme.fromSpecResidueField_apply x _)
    have hsub' : (Spec.map (CommRingCat.ofHom ee)) (IsLocalRing.closedPoint (AlgebraicClosure ((Limits.pullback D.f a).residueField x))) =
        IsLocalRing.closedPoint (IsLocalRing.ResidueField B) :=
      Subsingleton.elim (α := PrimeSpectrum (IsLocalRing.ResidueField B)) _ _
    have hres : Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))
        (IsLocalRing.closedPoint (IsLocalRing.ResidueField B)) = IsLocalRing.closedPoint B := by
      haveI : IsLocalHom (CommRingCat.Hom.hom (CommRingCat.ofHom (IsLocalRing.residue B))) := by
        rw [CommRingCat.hom_ofHom]; infer_instance
      exact Spec_closedPoint
    rw [hsub', hres] at h3
    exact h3
  have hfz : Limits.pullback.fst a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) ((inv c) (IsLocalRing.closedPoint (B ⧸ J))) = IsLocalRing.closedPoint B := by
    have h : (inv c ≫ Limits.pullback.fst a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (IsLocalRing.closedPoint (B ⧸ J)) =
        Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)) (IsLocalRing.closedPoint (B ⧸ J)) := by
      rw [hfc]
    exact h.trans hclB
  have hcond : (Limits.pullback.fst a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) ≫ a') ((inv c) (IsLocalRing.closedPoint (B ⧸ J))) =
      (Limits.pullback.snd a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) ≫ (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) ((inv c) (IsLocalRing.closedPoint (B ⧸ J))) :=
    congrArg (fun g : Limits.pullback a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) ⟶ Limits.pullback D.f a => g ((inv c) (IsLocalRing.closedPoint (B ⧸ J))))
      (Limits.pullback.condition (f := a') (g := (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))))
  have hcond' : a' (Limits.pullback.fst a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) ((inv c) (IsLocalRing.closedPoint (B ⧸ J)))) =
      (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) (Limits.pullback.snd a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) ((inv c) (IsLocalRing.closedPoint (B ⧸ J)))) := hcond
  have hxs : (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) ((inv c ≫ Limits.pullback.snd a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (IsLocalRing.closedPoint (B ⧸ J))) = x := by
    have h : ((inv c ≫ Limits.pullback.snd a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A))) (IsLocalRing.closedPoint (B ⧸ J))) = Limits.pullback.snd a' (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) ((inv c) (IsLocalRing.closedPoint (B ⧸ J))) := rfl
    rw [h, ← hcond', hfz, ha'x]

  haveI hs : IsClosedImmersion (D.xs i) := isClosedImmersion_of_comp_eq_id D.Yt.hom (D.xs i)
    (by rw [← D.hf, ← Category.assoc, D.hxs i, D.hS i])
  haveI hsf : IsClosedImmersion (D.xs i ≫ D.f) :=
    isClosedImmersion_of_comp_eq_id (wcP1Over F'').hom (D.xs i ≫ D.f) (by rw [D.hxs i, D.hS i])
  haveI : IsClosedImmersion (wcQmSp A) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  have hιinj : Function.Injective (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)) :=
    (Limits.pullback.fst (Limits.pullback.snd D.f a) (wcQmSp A)).isClosedEmbedding.isEmbedding.injective

  have isoSurj : ∀ {R S : CommRingCat.{u}} (e : R ≅ S), Function.Surjective e.hom.hom :=
    fun e t => ⟨e.inv.hom t, by rw [← CommRingCat.comp_apply, Iso.inv_hom_id, CommRingCat.id_apply]⟩
  have s1 : ∀ {X Y : Scheme.{u}} (φ : X ⟶ Y) [SurjectiveOnStalks φ] (x : X),
      Function.Surjective (φ.residueFieldMap x).hom := by
    intro X Y φ _ x
    have h := Scheme.residue_residueFieldMap φ x
    have h2 : (φ.residueFieldMap x).hom ∘ (Y.residue (φ x)).hom =
        (X.residue x).hom ∘ (φ.stalkMap x).hom := by
      funext t
      have := congrArg (fun k => k.hom t) h
      simpa using this
    have h3 : Function.Surjective ((X.residue x).hom ∘ (φ.stalkMap x).hom) :=
      (Scheme.residue_surjective X x).comp (φ.stalkMap_surjective x)
    rw [← h2] at h3
    exact Function.Surjective.of_comp h3
  have s3 : ∀ {X' Y' P : Scheme.{u}} {K : Type u} [Field K] (f : X' ⟶ P) (g : Y' ⟶ P)
      (s : Spec (.of K) ⟶ X') [IsClosedImmersion (s ≫ f)] (w : ↥(Limits.pullback f g)),
      Limits.pullback.fst f g w = s (IsLocalRing.closedPoint K) →
