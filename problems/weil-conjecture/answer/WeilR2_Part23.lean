            (b ≫ (DerivedCategory.Q.map (CochainComplex.mappingCone.inr eΨ))⟦(((n - 1) : ℕ) : ℤ)⟧') :=
by
  intro P K eK eΨ Ψ
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback (Limits.pullback.snd D.f a) (wcQmSp A)) (ℓ ^ k)))
  haveI : NeZero (ℓ ^ k) := ⟨pow_ne_zero k (Nat.Prime.ne_zero Fact.out)⟩
  have unitlem : ∀ (m : ℕ) [NeZero m] (x z : ZMod m) (hxz : ∀ n : ℕ, n • x = 0 ↔ n • z = 0),
        ∃ u : (ZMod m)ˣ, z = u * x := by
    intro m _ x z hxz
    have hdiv : ∀ x z : ZMod m, (∀ n : ℕ, n • x = 0 → n • z = 0) → ∃ a, z = a * x := by
      intro x z h
      set d := Nat.gcd m x.val with hd
      have hdpos : 0 < d := Nat.gcd_pos_of_pos_left _ (NeZero.pos m)
      have hdm : d ∣ m := Nat.gcd_dvd_left _ _
      have hdx : d ∣ x.val := Nat.gcd_dvd_right _ _
      have h1 : (m / d) • x = 0 := by
        rw [nsmul_eq_mul, ← ZMod.natCast_zmod_val x, ← Nat.cast_mul, CharP.cast_eq_zero_iff (ZMod m) m]
        obtain ⟨t, ht⟩ := hdx
        rw [ht, ← mul_assoc, Nat.div_mul_cancel hdm]
        exact dvd_mul_right _ _
      have h2 := h _ h1
      rw [nsmul_eq_mul, ← ZMod.natCast_zmod_val z, ← Nat.cast_mul, CharP.cast_eq_zero_iff (ZMod m) m] at h2
      have h3 : d ∣ z.val := by
        have h4 : m / d * d ∣ m / d * z.val := by
          rwa [Nat.div_mul_cancel hdm]
        exact Nat.dvd_of_mul_dvd_mul_left
          (Nat.div_pos (Nat.le_of_dvd (NeZero.pos m) hdm) hdpos) h4
      obtain ⟨t, ht⟩ := h3
      have hbez : ((d : ℕ) : ZMod m) = x * ((Nat.gcdB m x.val : ℤ) : ZMod m) := by
        have := congrArg (fun q : ℤ => (q : ZMod m)) (Nat.gcd_eq_gcd_ab m x.val)
        simp only [Int.cast_add, Int.cast_mul, Int.cast_natCast, ZMod.natCast_self, zero_mul,
          zero_add, ZMod.natCast_zmod_val] at this
        exact this
      refine ⟨(t : ZMod m) * ((Nat.gcdB m x.val : ℤ) : ZMod m), ?_⟩
      rw [← ZMod.natCast_zmod_val z, ht, Nat.cast_mul, hbez]
      ring
    obtain ⟨a, ha⟩ := hdiv x z (fun n hn => (hxz n).1 hn)
    obtain ⟨b, hb⟩ := hdiv z x (fun n hn => (hxz n).2 hn)
    have hom : addOrderOf z ∣ m :=
      addOrderOf_dvd_of_nsmul_eq_zero (by rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul])
    haveI : NeZero (addOrderOf z) := NeZero.of_pos (Nat.pos_of_dvd_of_pos hom (NeZero.pos m))
    have hab : ((1 - a * b).val) • z = 0 := by
      rw [nsmul_eq_mul, ZMod.natCast_zmod_val, sub_mul, one_mul, mul_assoc, ← hb, ← ha, sub_self]
    have ho1 : addOrderOf z ∣ (1 - a * b).val := addOrderOf_dvd_of_nsmul_eq_zero hab
    have hcast : ∀ v : ZMod m, addOrderOf z ∣ v.val ↔
        (ZMod.castHom hom (ZMod (addOrderOf z))) v = 0 := by
      intro v
      rw [ZMod.castHom_apply, ZMod.cast_eq_val, CharP.cast_eq_zero_iff (ZMod (addOrderOf z)) (addOrderOf z)]
    have hunit : (ZMod.castHom hom (ZMod (addOrderOf z))) a *
        (ZMod.castHom hom (ZMod (addOrderOf z))) b = 1 := by
      have := (hcast _).1 ho1
      rw [map_sub, map_one, map_mul, sub_eq_zero] at this
      exact this.symm
    obtain ⟨u, hu⟩ := ZMod.unitsMap_surjective hom (Units.mkOfMulEqOne _ _ hunit)
    refine ⟨u, ?_⟩
    have hu' : (ZMod.castHom hom (ZMod (addOrderOf z))) ((u : ZMod m) - a) = 0 := by
      rw [map_sub, sub_eq_zero]
      have := congrArg Units.val hu
      rw [ZMod.unitsMap_val, Units.val_mkOfMulEqOne] at this
      rw [ZMod.castHom_apply]
      exact this
    have h4 : ((u : ZMod m) - a).val • z = 0 := by
      rw [← addOrderOf_dvd_iff_nsmul_eq_zero]
      exact (hcast _).2 hu'
    have h5 : ((u : ZMod m) - a).val • x = 0 := (hxz _).2 h4
    rw [nsmul_eq_mul, ZMod.natCast_zmod_val, sub_mul, sub_eq_zero] at h5
