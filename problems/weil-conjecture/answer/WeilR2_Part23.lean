      rw [Functor.map_comp Φ.mapDerivedCategory
          ((DerivedCategory.singleFunctorIsoCompQ (SheafOfModules.{u+1} (wcEtZModRing Y m)) 0).hom.app X),
        Functor.map_comp Φ.mapDerivedCategory (DerivedCategory.Q.map φ),
        Functor.map_comp Φ.mapDerivedCategory
          ((DerivedCategory.Q.commShiftIso (n : ℤ)).hom.app I.cochainComplex)]
      simp only [Category.assoc]
