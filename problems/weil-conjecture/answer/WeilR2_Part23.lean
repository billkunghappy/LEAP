        ⟨l.1, by
          have h2 : l.1 ≫ I.ι.f 0 = g' ≫ (I.cochainComplexXIso 0 0 rfl).hom := l.2
          show l.1 ≫ I.ι.f 0 ≫ (I.cochainComplexXIso 0 0 rfl).inv = g'
          rw [← Category.assoc, h2, Category.assoc, Iso.hom_inv_id, Category.comp_id]⟩)
    have hkk : (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 N).inv ≫ I.ι'.f 0 =
        (HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 N).inv ≫ k' := by
      rw [InjectiveResolution.ι'_f_zero, Iso.inv_hom_id_assoc]
      exact (Category.id_comp _).symm
    set L := (R.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex with hL
    have hd : L.d 0 1 = R.map (I.cochainComplex.d 0 1) := rfl
    have h0 : R.map ((HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 N).inv ≫ k') ≫
        L.d 0 1 = 0 := by
      rw [hd, ← R.map_comp, Category.assoc, hk0, Limits.comp_zero, R.map_zero]
    let γ : R.obj N ⟶ L.cycles 0 := L.liftCycles
      (R.map ((HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 N).inv ≫ k')) 1 (by simp) h0
    have hγ : γ ≫ L.iCycles 0 =
        R.map ((HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 N).inv ≫ k') :=
