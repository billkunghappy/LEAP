theorem wc_et_pull2_map_eq_of_stalks {S S' S'' : Scheme.{u}} (g₁ : S' ⟶ S) (g₂ : S'' ⟶ S')
    (n : ℕ) (D₁ : wcEtPullData g₁ n) (D₂ : wcEtPullData g₂ n)
    {M N : SheafOfModules.{u+1} (wcEtZModRing S n)} (ψ₁ ψ₂ : M ⟶ N)
    (h : ∀ s : S'', (wcEtStalk S (g₁ (g₂ s))).map ((SheafOfModules.toSheaf (wcEtZModRing S n)).map ψ₁) =
      (wcEtStalk S (g₁ (g₂ s))).map ((SheafOfModules.toSheaf (wcEtZModRing S n)).map ψ₂)) :
    D₂.Φ.map (D₁.Φ.map ψ₁) = D₂.Φ.map (D₁.Φ.map ψ₂) :=
by
  haveI := D₁.additive
  haveI := D₂.additive
  obtain ⟨ψ, hψ⟩ : ∃ ψ : M ⟶ N, ψ = ψ₁ - ψ₂ := ⟨_, rfl⟩
  have hstk : ∀ s : S'', (wcEtStalk S (g₁ (g₂ s))).map
      ((SheafOfModules.toSheaf (wcEtZModRing S n)).map ψ) = 0 := by
    intro s
    haveI := (wc_et_stalk_exact S (g₁ (g₂ s))).1
    haveI : (wcEtStalk S (g₁ (g₂ s))).Additive :=
      Functor.additive_of_preserves_binary_products _
    rw [hψ, Functor.map_sub, Functor.map_sub, h s, sub_self]
  haveI : Limits.PreservesFiniteColimits (SheafOfModules.toSheaf (wcEtZModRing S n)) :=
    sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.smallEtaleTopology S)
      (wcEtZModRing S n)
  have hI : ∀ s : S'', Limits.IsZero ((wcEtStalk S (g₁ (g₂ s))).obj
      ((SheafOfModules.toSheaf (wcEtZModRing S n)).obj (Limits.image ψ))) := by
    intro s
    haveI := (wc_et_stalk_exact S (g₁ (g₂ s))).1
    haveI := (wc_et_stalk_exact S (g₁ (g₂ s))).2
    have hm : Mono ((wcEtStalk S (g₁ (g₂ s))).map
        ((SheafOfModules.toSheaf (wcEtZModRing S n)).map (Limits.image.ι ψ))) := inferInstance
    have he : Epi ((wcEtStalk S (g₁ (g₂ s))).map
        ((SheafOfModules.toSheaf (wcEtZModRing S n)).map (Limits.factorThruImage ψ))) :=
      inferInstance
    have h0 : (wcEtStalk S (g₁ (g₂ s))).map
        ((SheafOfModules.toSheaf (wcEtZModRing S n)).map (Limits.factorThruImage ψ)) = 0 := by
      rw [← cancel_mono ((wcEtStalk S (g₁ (g₂ s))).map
        ((SheafOfModules.toSheaf (wcEtZModRing S n)).map (Limits.image.ι ψ))),
        ← Functor.map_comp, ← Functor.map_comp, Limits.image.fac, Limits.zero_comp]
      exact hstk s
    rw [Limits.IsZero.iff_id_eq_zero, ← cancel_epi ((wcEtStalk S (g₁ (g₂ s))).map
        ((SheafOfModules.toSheaf (wcEtZModRing S n)).map (Limits.factorThruImage ψ))), h0,
      Limits.zero_comp, Limits.zero_comp]
  have hE : Limits.IsZero (D₂.Φ.obj (D₁.Φ.obj (Limits.image ψ))) := by
    have hT'' : Limits.IsZero ((SheafOfModules.toSheaf (wcEtZModRing S'' n)).obj
        (D₂.Φ.obj (D₁.Φ.obj (Limits.image ψ)))) := by
      apply wc_et_stalks_zero
      intro s
      obtain ⟨α⟩ := wc_et_pull_data_stalk_iso g₂ n D₂ (D₁.Φ.obj (Limits.image ψ)) s
      obtain ⟨β⟩ := wc_et_pull_data_stalk_iso g₁ n D₁ (Limits.image ψ) (g₂ s)
      exact AddCommGrpCat.subsingleton_of_isZero ((hI s).of_iso (α ≪≫ β))
    rw [Limits.IsZero.iff_id_eq_zero]
    apply (SheafOfModules.toSheaf (wcEtZModRing S'' n)).map_injective
    rw [CategoryTheory.Functor.map_id, Functor.map_zero]
    exact hT''.eq_of_src _ _
  rw [← sub_eq_zero, ← Functor.map_sub, ← Functor.map_sub, ← hψ, ← Limits.image.fac ψ,
    Functor.map_comp, Functor.map_comp,
    hE.eq_zero_of_src (D₂.Φ.map (D₁.Φ.map (Limits.image.ι ψ))), Limits.comp_zero]

theorem wc_etqmt_x0_unit_stalk_bij (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) (k : ℕ) (π : A) (r : ℕ)
    (U : Scheme.{u}) (g : U ⟶ Spec (.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))) (hg : Etale g)
    (fX : U ⟶ Spec (.of A)) (hfX : fX = g ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r))
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A))
    (Dh : wcEtPullData (Limits.pullback.fst fX ξ) (ℓ ^ k)) (x : U)
    (hx0 : x ∈ U.basicOpen (wcEtqmtX g ⟨0, by omega⟩))
    (hxc : fX x = IsLocalRing.closedPoint A) :
    Function.Bijective ((wcEtStalk U x).map
      ((SheafOfModules.toSheaf (wcEtZModRing U (ℓ ^ k))).map (wcEtqmtU Dh))).hom :=
by
  classical

  have hq : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
      (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∉ PrimeSpectrum.asIdeal (g x) := by
    have e1 := Scheme.Hom.preimage_basicOpen_top g
      ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).inv.hom
        (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))))
    have h1 : x ∈ (TopologicalSpace.Opens.map g.base).obj
        ((Spec (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).basicOpen
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
              (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))))) := by
      rw [e1]; exact hx0
    have h2 : g x ∈ (Spec (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).basicOpen
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
              (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))))) := h1
    have h3 := basicOpen_eq_of_affine
      (R := CommRingCat.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))
      (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))))
    rw [h3] at h2
    exact (PrimeSpectrum.mem_basicOpen _ _).mp h2

  obtain ⟨V, hgV, hsmV⟩ := wc_qmssl_offdouble_smooth A r π (g x) (Or.inl hq)

  have hxU' : x ∈ g ⁻¹ᵁ V := hgV
  haveI hgE : Etale g := hg
  haveI hEr : Etale (g ∣_ V) := by
    first
    | exact MorphismProperty.of_isPullback (P := @Etale) (isPullback_morphismRestrict g V) hg
    | exact MorphismProperty.of_isPullback (P := @Etale) (isPullback_morphismRestrict g V).flip hg
  haveI hSr : Smooth (g ∣_ V) := by
    first
    | infer_instance
    | exact Etale.instSmooth (g ∣_ V)
  haveI hSV : Smooth (V.ι ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r)) := hsmV
  have hSc : Smooth ((g ∣_ V) ≫ V.ι ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r)) := by
    first
    | infer_instance
    | exact smooth_comp _ _
  have heq : (g ⁻¹ᵁ V).ι ≫ fX = (g ∣_ V) ≫ V.ι ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r) := by
    rw [hfX, ← Category.assoc, ← Category.assoc, morphismRestrict_ι]
  have hsm : Smooth ((g ⁻¹ᵁ V).ι ≫ fX) := by rw [heq]; exact hSc

  have hmu : IsUnit (((ℓ ^ k : ℕ)) : A) := by rw [Nat.cast_pow]; exact hℓ.pow k
  have hMH : ∀ (B : Type u) [CommRing B] [HenselianLocalRing B]
      [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
      (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt U x)) (Scheme.Etale.forget U))
      (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ U),
      wcHalShData x B Λ W' φ a → Nat.card (wcEtCoh (Limits.pullback (a ≫ fX) ξ) (ℓ ^ k) 0) = ℓ ^ k :=
    fun B _ _ _ Λ _ _ W' φ a hB =>
      (wc_smooth_open_shens_milnor_fibre_acyclic A U fX (g ⁻¹ᵁ V) hsm (ℓ ^ k) hmu x hxU' hxc
        B Λ W' φ a hB Ω ξ).1

  have hst := wc_et_supp_unit_ker_coker_stalks_of_milnor_h0 A U fX (ℓ ^ k)
    (pow_pos (Fact.out : ℓ.Prime).pos k) Ω ξ Dh x hMH

  let F := SheafOfModules.toSheaf (wcEtZModRing U (ℓ ^ k)) ⋙ wcEtStalk U x
  haveI : Limits.PreservesFiniteLimits (wcEtStalk U x) := (wc_et_stalk_exact U x).1
  haveI : Limits.PreservesFiniteColimits (wcEtStalk U x) := (wc_et_stalk_exact U x).2
  haveI : Limits.PreservesFiniteColimits (SheafOfModules.toSheaf (wcEtZModRing U (ℓ ^ k))) :=
    sheafOfModules_toSheaf_preservesFiniteColimits _ _
  haveI : Limits.PreservesFiniteLimits F := Limits.comp_preservesFiniteLimits _ _
  haveI : Limits.PreservesFiniteColimits F := Limits.comp_preservesFiniteColimits _ _
  haveI : F.PreservesZeroMorphisms := by
    first
    | infer_instance
    | exact Functor.preservesZeroMorphisms_of_preserves_terminal_object F
  have hK0 : Limits.IsZero (F.obj (Limits.kernel (wcEtSuppUnitMap Dh))) :=
    @AddCommGrpCat.isZero_of_subsingleton _ hst.1
  have hC0 : Limits.IsZero (F.obj (Limits.cokernel (wcEtSuppUnitMap Dh))) :=
    @AddCommGrpCat.isZero_of_subsingleton _ hst.2
  have hK' : Limits.IsZero (Limits.kernel (F.map (wcEtSuppUnitMap Dh))) :=
    hK0.of_iso (Limits.PreservesKernel.iso F (wcEtSuppUnitMap Dh)).symm
  have hC' : Limits.IsZero (Limits.cokernel (F.map (wcEtSuppUnitMap Dh))) :=
    hC0.of_iso (Limits.PreservesCokernel.iso F (wcEtSuppUnitMap Dh)).symm
  haveI : Mono (F.map (wcEtSuppUnitMap Dh)) :=
    Preadditive.mono_of_isZero_kernel' _ (Limits.kernelIsKernel _) hK'
  haveI : Epi (F.map (wcEtSuppUnitMap Dh)) :=
    Preadditive.epi_of_isZero_cokernel' _ (Limits.cokernelIsCokernel _) hC'
  have hs : IsIso (F.map (wcEtSuppUnitMap Dh)) := isIso_of_mono_of_epi _

  have hfinal : ∀ {S S' : Scheme.{u}} (g : S' ⟶ S), (wcEtBaseChange g).Final := by
    intro S S' g
    let F := wcEtBaseChange g
    let T : S.Etale := MorphismProperty.Over.mk ⊤ (𝟙 S) (inferInstance : Etale (𝟙 S))
    have hT : Limits.IsTerminal T := Limits.IsTerminal.ofUniqueHom
      (fun V => MorphismProperty.Over.homMk V.hom (Category.comp_id _) trivial)
      (fun V m => by
        apply MorphismProperty.Over.Hom.ext
        exact (Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m))
    have hFT : Limits.IsTerminal (F.obj T) := Limits.IsTerminal.ofUniqueHom
      (fun V => MorphismProperty.Over.homMk
        (Limits.pullback.lift (V.hom ≫ g) V.hom (by simp) : V.left ⟶ Limits.pullback (𝟙 S) g)
        (Limits.pullback.lift_snd _ _ _) trivial)
      (fun V m => by
        apply MorphismProperty.Over.Hom.ext
        have hw : m.left ≫ Limits.pullback.snd (𝟙 S) g = V.hom := MorphismProperty.Over.w m
        show @Eq (V.left ⟶ Limits.pullback (𝟙 S) g) m.left
          (Limits.pullback.lift (V.hom ≫ g) V.hom (by simp))
        apply Limits.pullback.hom_ext
        · have hl1 := Limits.pullback.lift_fst (f := 𝟙 S) (g := g) (V.hom ≫ g) V.hom (by simp)
          have hc := Limits.pullback.condition (f := 𝟙 S) (g := g)
          rw [Category.comp_id] at hc
          have h2 : m.left ≫ Limits.pullback.fst (𝟙 S) g = V.hom ≫ g := by
            rw [hc]
            exact (Category.assoc _ _ _).symm.trans (congrArg (fun t => t ≫ g) hw)
          exact h2.trans hl1.symm
        · have hl2 := Limits.pullback.lift_snd (f := 𝟙 S) (g := g) (V.hom ≫ g) V.hom (by simp)
          exact hw.trans hl2.symm)
    refine Functor.Final.mk (fun d => ?_)
    have hterm : Limits.IsTerminal (StructuredArrow.mk (hFT.from d) : StructuredArrow d F) :=
      Limits.IsTerminal.ofUniqueHom
        (fun X => StructuredArrow.homMk (hT.from X.right) (hFT.hom_ext _ _))
        (fun X m => StructuredArrow.hom_ext _ _ (hT.hom_ext _ _))
    haveI := hterm.hasTerminal
    exact isConnected_of_hasTerminal _

  have htrans : ∀ {S S' : Scheme.{u}} {g : S' ⟶ S} {m : ℕ} (E : wcEtPullData g m),
      IsIso ((E.adj.homEquiv _ _).symm
        (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange g) _ _ E.cont E.φ)) := by
    intro S S' g m E
    haveI := E.cont
    haveI : (wcEtBaseChange g).Final := hfinal g
    haveI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange g) _ _ E.cont E.φ).IsRightAdjoint :=
      ⟨_, ⟨E.adj⟩⟩
    let pPA := SheafOfModules.pullbackPushforwardAdjunction E.φ
    let e := E.adj.leftAdjointUniq pPA
    have h1 : (E.adj.homEquiv _ _).symm (SheafOfModules.unitToPushforwardObjUnit E.φ) =
        e.hom.app _ ≫ (pPA.homEquiv _ _).symm (SheafOfModules.unitToPushforwardObjUnit E.φ) := by
      rw [Adjunction.homEquiv_counit, Adjunction.homEquiv_counit,
        ← Adjunction.leftAdjointUniq_hom_app_counit E.adj pPA]
      rw [← Category.assoc, NatTrans.naturality, Category.assoc]
    rw [h1, SheafOfModules.pullbackPushforwardAdjunction_homEquiv_symm_unitToPushforwardObjUnit]
    infer_instance

  haveI := Dh.cont
  let u := @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
    (wcEtBaseChange (Limits.pullback.fst fX ξ)) _ _ Dh.cont Dh.φ
  let P := @SheafOfModules.pushforward _ _ _ _ _ _
    (wcEtBaseChange (Limits.pullback.fst fX ξ)) _ _ Dh.cont Dh.φ
  let ψ := (Dh.adj.homEquiv _ _).symm u
  haveI hψ : IsIso ψ := htrans Dh
  let c := Dh.μ.inv ≫ ψ
  have hfac : u = wcEtSuppUnitMap Dh ≫ P.map c := by
    have e1 : Dh.μ.hom ≫ c = ψ := Iso.hom_inv_id_assoc _ _
    calc u = Dh.adj.homEquiv _ _ ψ := (Equiv.apply_symm_apply _ _).symm
      _ = Dh.adj.homEquiv _ _ (Dh.μ.hom ≫ c) := by rw [e1]
      _ = Dh.adj.homEquiv _ _ Dh.μ.hom ≫ P.map c := Adjunction.homEquiv_naturality_right _ _ _
      _ = wcEtSuppUnitMap Dh ≫ P.map c := by rw [Adjunction.homEquiv_unit]; rfl

  have hc : IsIso c := IsIso.comp_isIso' inferInstance hψ
  have hPc : IsIso (P.map c) := @Functor.map_isIso _ _ _ _ _ _ P c hc
  have hFPc : IsIso (F.map (P.map c)) := @Functor.map_isIso _ _ _ _ _ _ F (P.map c) hPc
  have key : IsIso (F.map (wcEtSuppUnitMap Dh) ≫ F.map (P.map c)) :=
    IsIso.comp_isIso' hs hFPc
  have hmap : F.map u = F.map (wcEtSuppUnitMap Dh) ≫ F.map (P.map c) :=
    (congrArg F.map hfac).trans (F.map_comp _ _)
  have hFu : IsIso (F.map u) := cast (congrArg (fun t => IsIso t) hmap).symm key
  have hbij := ConcreteCategory.bijective_of_isIso (F.map u)
  exact hbij

theorem wc_etqmt_x0_stalk_id_of_local {B : Scheme.{u}}
    {R : Sheaf (Scheme.smallEtaleTopology B) RingCat.{u+1}}
    (M : SheafOfModules.{u+1} R) (φ : M ⟶ M) (b : B)
    (h : ∀ (A₀ : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B))
        (s : M.val.obj (Opposite.op A₀.right)),
      ∃ (A' : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) (k : A' ⟶ A₀),
        (M.val.map k.right.op).hom ((φ.val.app (Opposite.op A₀.right)).hom s) =
          (M.val.map k.right.op).hom s) :
    (wcEtStalk B b).map ((SheafOfModules.toSheaf R).map φ) = 𝟙 _ :=
by
  let G := (StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙
      ((SheafOfModules.toSheaf R).obj M).obj
  let α : G ⟶ G := Functor.whiskerLeft
    (StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op
    ((SheafOfModules.toSheaf R).map φ).hom
  change Limits.colim.map α = 𝟙 (Limits.colimit G)
  apply Limits.colimit.hom_ext
  intro j
  obtain ⟨A₀⟩ := j
  rw [Limits.colimit.ι_map, Category.comp_id]
  ext s
  obtain ⟨A', k, hk⟩ := h A₀ s
  have hw : ∀ x, Limits.colimit.ι G (Opposite.op A') (G.map k.op x) =
      Limits.colimit.ι G (Opposite.op A₀) x := fun x => Limits.colimit.w_apply G k.op x
  rw [ConcreteCategory.comp_apply, ← hw s, ← hw]
  exact congrArg _ hk

theorem wc_etqmt_x0_stalk_lift_family {B : Scheme.{u}}
    {R : Sheaf (Scheme.smallEtaleTopology B) RingCat.{u+1}}
    {G M : SheafOfModules.{u+1} R} (v : G ⟶ M) (b : B)
    (hs : Function.Surjective ((wcEtStalk B b).map ((SheafOfModules.toSheaf R).map v)).hom)
    (ι : Type) [Finite ι]
    (A₀ : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B))
    (f : ι → M.val.obj (Opposite.op A₀.right)) :
    ∃ (A' : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) (k : A' ⟶ A₀)
      (c : ι → G.val.obj (Opposite.op A'.right)),
      ∀ i, (M.val.map k.right.op).hom (f i) = (v.val.app (Opposite.op A'.right)).hom (c i) :=
by
  classical
  haveI hcof : IsCofiltered (StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) := by
    let Φ := Scheme.pointSmallEtale (wcEtGeomPt B b)
    haveI : IsCofiltered Φ.fiber.Elements := Φ.isCofiltered
    let E : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B) ⥤ Φ.fiber.Elements :=
      { obj := fun A => Φ.fiber.elementsMk A.right A.hom
        map := fun {A A'} g => ⟨g.right, StructuredArrow.w g⟩
        map_id := fun A => rfl
        map_comp := fun f g => rfl }
    let Einv : Φ.fiber.Elements ⥤ StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B) :=
      { obj := fun x => StructuredArrow.mk (T := Scheme.Etale.forget B) (Y := x.1) x.2
        map := fun {x y} φ => StructuredArrow.homMk φ.1 φ.2
        map_id := fun x => rfl
        map_comp := fun f g => rfl }
    let eqv : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B) ≌ Φ.fiber.Elements :=
      CategoryTheory.Equivalence.mk E Einv (NatIso.ofComponents (fun A => Iso.refl _) (by intros; rfl))
        (NatIso.ofComponents (fun x => Iso.refl _) (by intros; rfl))
    exact IsCofiltered.of_equivalence eqv.symm
  haveI : IsFiltered (StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B))ᵒᵖ :=
    isFiltered_op_of_isCofiltered _
  haveI := Limits.preservesFilteredColimitsOfSize_shrink.{u+1, u+1, u, u+1} (forget AddCommGrpCat.{u+1})

  have s1 : ∀ (A₀ : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B))
      (x : M.val.obj (Opposite.op A₀.right)),
      ∃ (A' : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) (k : A' ⟶ A₀)
        (c : G.val.obj (Opposite.op A'.right)),
        (M.val.map k.right.op).hom x = (v.val.app (Opposite.op A'.right)).hom c := by
    intro A₀ x
    let D := (StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op
    let FM := (SheafOfModules.toSheaf R).obj M
    let FG := (SheafOfModules.toSheaf R).obj G
    let u := (SheafOfModules.toSheaf R).map v
    let x' : FM.obj.obj (Opposite.op A₀.right) := x
    obtain ⟨γ, hγ⟩ := hs ((Limits.colimit.ι (D ⋙ FM.obj) (Opposite.op A₀)).hom x')
    obtain ⟨j, y, hy⟩ := Limits.Concrete.colimit_exists_rep (D ⋙ FG.obj) γ
    have h3 := Limits.colimit.ι_map_apply (Functor.whiskerLeft D u.hom) j y
    have h4 : (Limits.colimit.ι (D ⋙ FM.obj) j).hom (((Functor.whiskerLeft D u.hom).app j).hom y) =
        (Limits.colimit.ι (D ⋙ FM.obj) (Opposite.op A₀)).hom x' := by
      rw [← h3, ← hγ, ← hy]
      rfl
    obtain ⟨k, f₁, g₁, hk⟩ := (Limits.Concrete.colimit_rep_eq_iff_exists (D ⋙ FM.obj)
      (i := Opposite.op A₀) (j := j) x' (((Functor.whiskerLeft D u.hom).app j).hom y)).mp h4.symm
    let y' : G.val.obj (Opposite.op j.unop.right) := y
    refine ⟨k.unop, f₁.unop, (G.val.map g₁.unop.right.op).hom y', ?_⟩
    have hn := PresheafOfModules.naturality_apply v.val g₁.unop.right.op y'
    refine Eq.trans ?_ hn.symm
    exact hk

  have key : ∀ (α : Type) [Finite α]
      (A₀ : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B))
      (f : α → M.val.obj (Opposite.op A₀.right)),
      ∃ (A' : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) (k : A' ⟶ A₀)
        (c : α → G.val.obj (Opposite.op A'.right)),
        ∀ i, (M.val.map k.right.op).hom (f i) = (v.val.app (Opposite.op A'.right)).hom (c i) := by
    intro α _
    refine Finite.induction_empty_option
      (P := fun α : Type => ∀ (A₀ : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B))
        (f : α → M.val.obj (Opposite.op A₀.right)),
        ∃ (A' : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)) (k : A' ⟶ A₀)
          (c : α → G.val.obj (Opposite.op A'.right)),
          ∀ i, (M.val.map k.right.op).hom (f i) = (v.val.app (Opposite.op A'.right)).hom (c i))
      ?_ ?_ ?_ α
    · intro α β e hα A₀ f
      obtain ⟨A', k, c, hc⟩ := hα A₀ (fun a => f (e a))
      refine ⟨A', k, fun i => c (e.symm i), fun i => ?_⟩
      have h := hc (e.symm i)
      rw [Equiv.apply_symm_apply] at h
      exact h
    · intro A₀ f
      exact ⟨A₀, 𝟙 A₀, fun i => i.elim, fun i => i.elim⟩
    · intro α _ hα A₀ f
      obtain ⟨A₁, k₁, c₁, hc₁⟩ := hα A₀ (fun a => f (some a))
      obtain ⟨A₂, k₂, g, hg⟩ := s1 A₁ ((M.val.map k₁.right.op).hom (f none))
      refine ⟨A₂, k₂ ≫ k₁, fun o => Option.casesOn o g
        (fun a => (G.val.map k₂.right.op).hom (c₁ a)), ?_⟩
      intro i
      cases i with
      | none =>
        rw [StructuredArrow.comp_right, op_comp, PresheafOfModules.map_comp_apply]
        exact hg
      | some a =>
        rw [StructuredArrow.comp_right, op_comp, PresheafOfModules.map_comp_apply]
        show _ = (v.val.app (Opposite.op A₂.right)).hom ((G.val.map k₂.right.op).hom (c₁ a))
        rw [PresheafOfModules.naturality_apply, ← hc₁ a]
  exact key ι A₀ f

theorem wc_etqmt_x0_affine_unit_nbhd (U : Scheme.{u}) (x : U) (r : Γ(U, ⊤)) (hx : x ∈ U.basicOpen r)
    (A₀ : StructuredArrow (Over.mk (wcEtGeomPt U x)) (Scheme.Etale.forget U)) :
    ∃ (A' : StructuredArrow (Over.mk (wcEtGeomPt U x)) (Scheme.Etale.forget U)) (k : A' ⟶ A₀),
      IsAffine A'.right.left ∧ IsUnit (A'.right.hom.appTop.hom r) :=
by
  classical
  have comp_ap : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (x : X), (f ≫ g) x = g (f x) := by
    intro X Y Z f g x
    first
    | rfl
    | simp
  obtain ⟨t, ht0⟩ : ∃ t : Spec (.of (AlgebraicClosure (U.residueField x))) ⟶ A₀.right.left,
      t = A₀.hom.left := ⟨_, rfl⟩
  have ht : t ≫ A₀.right.hom = wcEtGeomPt U x := by rw [ht0]; exact Over.w A₀.hom
  have hγ : ∀ p : Spec (.of (AlgebraicClosure (U.residueField x))), wcEtGeomPt U x p = x := by
    intro p
    first
    | exact Scheme.fromSpecResidueField_apply x _
    | (unfold wcEtGeomPt; rw [comp_ap]; exact Scheme.fromSpecResidueField_apply x _)
    | (simp only [wcEtGeomPt, comp_ap, Scheme.fromSpecResidueField_apply])
    | (simp [wcEtGeomPt])
  have htmem : ∀ p : Spec (.of (AlgebraicClosure (U.residueField x))),
      t p ∈ A₀.right.hom ⁻¹ᵁ U.basicOpen r := by
    intro p
    have e1 := comp_ap t A₀.right.hom p
    rw [ht, hγ] at e1
    show A₀.right.hom (t p) ∈ U.basicOpen r
    rw [← e1]
    exact hx
  let O₀ : A₀.right.left.Opens := A₀.right.hom ⁻¹ᵁ U.basicOpen r
  obtain ⟨O, hOaff, hv₀, hOsub⟩ : ∃ O : A₀.right.left.Opens, IsAffineOpen O ∧
      t (IsLocalRing.closedPoint (AlgebraicClosure (U.residueField x))) ∈ O ∧
      O.carrier ⊆ (O₀ : Set A₀.right.left) :=
    exists_isAffineOpen_mem_and_subset (htmem (IsLocalRing.closedPoint _))
  have hrange : Set.range t ⊆ Set.range O.ι := by
    rintro _ ⟨p, rfl⟩
    rw [Scheme.Opens.range_ι]
    have hp : p = IsLocalRing.closedPoint (AlgebraicClosure (U.residueField x)) :=
      Subsingleton.elim _ _
    rw [hp]
    exact hv₀
  obtain ⟨t', ht'⟩ : ∃ t' : Spec (.of (AlgebraicClosure (U.residueField x))) ⟶ O.toScheme,
      t' ≫ O.ι = t :=
    ⟨IsOpenImmersion.lift O.ι t hrange, IsOpenImmersion.lift_fac O.ι t hrange⟩
  let A' : StructuredArrow (Over.mk (wcEtGeomPt U x)) (Scheme.Etale.forget U) :=
    StructuredArrow.mk (Y := wcEtOpen U A₀.right O) (Over.homMk t' (by
      change t' ≫ (O.ι ≫ A₀.right.hom) = wcEtGeomPt U x
      rw [← Category.assoc, ht', ht]) :
        Over.mk (wcEtGeomPt U x) ⟶ (Scheme.Etale.forget U).obj (wcEtOpen U A₀.right O))
  let k : A' ⟶ A₀ := StructuredArrow.homMk (wcEtOpenι U A₀.right O) (by
    apply Over.OverMorphism.ext
    exact ht'.trans ht0)
  refine ⟨A', k, ?_, ?_⟩
  · exact hOaff
  · change IsUnit ((O.ι ≫ A₀.right.hom).appTop.hom r)
    have hall : ∀ o : O.toScheme, o ∈ (O.ι ≫ A₀.right.hom) ⁻¹ᵁ U.basicOpen r := by
      intro o
      have hoO : O.ι o ∈ O := by
        have h1 : O.ι o ∈ Set.range O.ι := Set.mem_range_self o
        rwa [Scheme.Opens.range_ι] at h1
      show (O.ι ≫ A₀.right.hom) o ∈ U.basicOpen r
      rw [comp_ap]
      exact hOsub hoO
    generalize O.ι ≫ A₀.right.hom = f at hall ⊢
    have hall' : ∀ o : O.toScheme, o ∈ O.toScheme.basicOpen (f.appTop.hom r) := by
      intro o
      rw [← Scheme.Hom.preimage_basicOpen_top]
      exact hall o
    apply RingedSpace.isUnit_of_isUnit_germ (X := O.toScheme.toLocallyRingedSpace.toRingedSpace)
    intro o _
    exact (Scheme.mem_basicOpen_top _ _ _).mp (hall' o)

theorem wc_etqmt_x0_root_nbhd (U : Scheme.{u}) (x : U)
    (A₁ : StructuredArrow (Over.mk (wcEtGeomPt U x)) (Scheme.Etale.forget U))
    [IsAffine A₁.right.left] (a : Γ(A₁.right.left, ⊤)) (ha : IsUnit a) (N : ℕ) (hN0 : 0 < N)
    (hN : IsUnit ((N : ℕ) : Γ(A₁.right.left, ⊤))) :
    ∃ (A' : StructuredArrow (Over.mk (wcEtGeomPt U x)) (Scheme.Etale.forget U)) (k' : A' ⟶ A₁)
      (y : Γ(A'.right.left, ⊤)), y ^ N = k'.right.left.appTop.hom a :=
by
  classical


  have hEt : ∀ (R : Type u) [CommRing R] (g b : Polynomial R),
      Algebra.Etale R (Localization.Away (AdjoinRoot.mk g (Polynomial.derivative g * b))) := by
    intro R _ g b
    set h : AdjoinRoot g := AdjoinRoot.mk g (Polynomial.derivative g * b) with hh
    have hFP : Algebra.FinitePresentation R (Localization.Away h) :=
      Algebra.FinitePresentation.of_isLocalizationAway (S := AdjoinRoot g) h
    have himg : ∀ {S : Type u} [CommRing S] [Algebra R S] (φ : Localization.Away h →ₐ[R] S)
        (p : Polynomial R),
        Polynomial.aeval (φ (algebraMap (AdjoinRoot g) _ (AdjoinRoot.root g))) p =
          φ (algebraMap (AdjoinRoot g) _ (AdjoinRoot.mk g p)) := by
      intro S _ _ φ p
      rw [Polynomial.aeval_algHom_apply, Polynomial.aeval_algebraMap_apply, AdjoinRoot.aeval_eq]
    have hext : ∀ {S : Type u} [CommRing S] [Algebra R S] (φ₁ φ₂ : Localization.Away h →ₐ[R] S),
        φ₁ (algebraMap (AdjoinRoot g) _ (AdjoinRoot.root g)) =
          φ₂ (algebraMap (AdjoinRoot g) _ (AdjoinRoot.root g)) → φ₁ = φ₂ := by
      intro S _ _ φ₁ φ₂ hφ
      apply IsLocalization.algHom_ext (Submonoid.powers h)
      apply AdjoinRoot.algHom_ext
      exact hφ
    have hlift : ∀ {S : Type u} [CommRing S] [Algebra R S] (x : S), Polynomial.aeval x g = 0 →
        IsUnit (Polynomial.aeval x (Polynomial.derivative g * b)) →
        ∃ φ : Localization.Away h →ₐ[R] S,
          φ (algebraMap (AdjoinRoot g) _ (AdjoinRoot.root g)) = x := by
      intro S _ _ x hx hu
      have hx' : Polynomial.eval₂ (↑(Algebra.ofId R S)) x g = 0 := by
        rw [← hx, Polynomial.aeval_def]; rfl
      let f : AdjoinRoot g →ₐ[R] S := AdjoinRoot.liftAlgHom g (Algebra.ofId R S) x hx'
      have hfr : f (AdjoinRoot.root g) = x := AdjoinRoot.liftAlgHom_root _ _ _ _
      have hfh : IsUnit (f h) := by
        rw [hh, ← AdjoinRoot.aeval_eq, ← Polynomial.aeval_algHom_apply, hfr]
        exact hu
      refine ⟨IsLocalization.Away.liftAlgHom h hfh, ?_⟩
      rw [IsLocalization.Away.liftAlgHom_apply]
      exact (IsLocalization.lift_eq _ _).trans hfr
    have hFE : Algebra.FormallyEtale R (Localization.Away h) := by
      rw [Algebra.FormallyEtale.iff_comp_bijective]
      intro B _ _ I hI
      have hsq : ∀ e ∈ I, e ^ 2 = 0 := by
        intro e he
        have h2 : e ^ 2 ∈ I ^ 2 := Ideal.pow_mem_pow he 2
        rw [hI] at h2
        exact (Ideal.mem_bot).mp h2
      have hnil : IsNilpotent I := ⟨2, by rw [hI, Ideal.zero_eq_bot]⟩
      have hmk0 : ∀ (z : B) (p : Polynomial R),
          Ideal.Quotient.mk I (Polynomial.aeval z p) =
            Polynomial.aeval (Ideal.Quotient.mk I z) p := fun z p =>
        (Polynomial.aeval_algHom_apply (Ideal.Quotient.mkₐ R I) z p).symm
      have hroot : ∀ {S : Type u} [CommRing S] [Algebra R S] (φ : Localization.Away h →ₐ[R] S),
          Polynomial.aeval (φ (algebraMap (AdjoinRoot g) _ (AdjoinRoot.root g))) g = 0 ∧
          IsUnit (Polynomial.aeval (φ (algebraMap (AdjoinRoot g) _ (AdjoinRoot.root g)))
            (Polynomial.derivative g * b)) := by
        intro S _ _ φ
        refine ⟨?_, ?_⟩
        · rw [himg φ g, AdjoinRoot.mk_self, map_zero, map_zero]
        · rw [himg φ _]
          exact (IsLocalization.Away.algebraMap_isUnit h).map φ
      constructor
      · intro φ₁ φ₂ hφ
        apply hext
        obtain ⟨h1g, -⟩ := hroot φ₁
        obtain ⟨h2g, h2u⟩ := hroot φ₂
        set x₁ := φ₁ (algebraMap (AdjoinRoot g) _ (AdjoinRoot.root g)) with hx₁
        set x₂ := φ₂ (algebraMap (AdjoinRoot g) _ (AdjoinRoot.root g)) with hx₂
        have hq : Ideal.Quotient.mk I x₁ = Ideal.Quotient.mk I x₂ := by
          have := AlgHom.congr_fun hφ (algebraMap (AdjoinRoot g) _ (AdjoinRoot.root g))
          simpa only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] using this
        have he : x₁ - x₂ ∈ I := Ideal.Quotient.eq.mp hq
        have hD : IsUnit (Polynomial.aeval x₂ (Polynomial.derivative g)) := by
          rw [map_mul] at h2u
          exact isUnit_of_mul_isUnit_left h2u
        have key := Polynomial.aeval_add_of_sq_eq_zero g x₂ (x₁ - x₂) (hsq _ he)
        have hs : x₂ + (x₁ - x₂) = x₁ := by ring
        rw [hs, h1g, h2g, zero_add] at key
        have : x₁ - x₂ = 0 := hD.mul_right_eq_zero.mp key.symm
        exact sub_eq_zero.mp this
      · intro ψ
        obtain ⟨hyg, hyu⟩ := hroot ψ
        obtain ⟨x, hx⟩ := Ideal.Quotient.mk_surjective
          (ψ (algebraMap (AdjoinRoot g) _ (AdjoinRoot.root g)))
        have hG : Polynomial.aeval x g ∈ I := by
          apply Ideal.Quotient.eq_zero_iff_mem.mp
          rw [hmk0, hx, hyg]
        have hH : IsUnit (Polynomial.aeval x (Polynomial.derivative g * b)) := by
          apply (hnil.isUnit_quotient_mk_iff).mp
          rw [hmk0, hx]
          exact hyu
        have hD : IsUnit (Polynomial.aeval x (Polynomial.derivative g)) := by
          rw [map_mul] at hH
          exact isUnit_of_mul_isUnit_left hH
        set G := Polynomial.aeval x g with hGdef
        set D := Polynomial.aeval x (Polynomial.derivative g) with hDdef
        set u : B := ↑(hD.unit⁻¹) with hudef
        have hDu : D * u = 1 := hD.mul_val_inv
        have hε : -(G * u) ∈ I := I.neg_mem (I.mul_mem_right _ hG)
        have hr1 : Polynomial.aeval (x + -(G * u)) g = 0 := by
          rw [Polynomial.aeval_add_of_sq_eq_zero g x _ (hsq _ hε)]
          rw [← hGdef, ← hDdef]
          linear_combination (-G) * hDu
        have hmkx : Ideal.Quotient.mk I (x + -(G * u)) =
            ψ (algebraMap (AdjoinRoot g) _ (AdjoinRoot.root g)) := by
          rw [map_add, Ideal.Quotient.eq_zero_iff_mem.mpr hε, add_zero, hx]
        have hr2 : IsUnit (Polynomial.aeval (x + -(G * u)) (Polynomial.derivative g * b)) := by
          apply (hnil.isUnit_quotient_mk_iff).mp
          rw [hmk0, hmkx]
          exact hyu
        obtain ⟨φ, hφ⟩ := hlift (x + -(G * u)) hr1 hr2
        refine ⟨φ, hext _ _ ?_⟩
        rw [AlgHom.comp_apply, hφ, Ideal.Quotient.mkₐ_eq_mk, hmkx]
    exact ⟨hFE, hFP⟩

  have halg : ∀ (R : Type u) [CommRing R] (a : R) (_ : IsUnit a) (N : ℕ) (_ : 0 < N)
      (_ : IsUnit ((N : ℕ) : R)) (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (τ : R →+* Ω),
      ∃ (S : Type u) (_ : CommRing S) (_ : Algebra R S), Algebra.Etale R S ∧
        ∃ θ : S, θ ^ N = algebraMap R S a ∧ ∃ lam : S →+* Ω, lam.comp (algebraMap R S) = τ := by
    intro R _ a ha N hN0 hN Ω _ _ τ
    let f : Polynomial R := Polynomial.X ^ N - Polynomial.C a
    let r : AdjoinRoot f := AdjoinRoot.mk f (Polynomial.derivative f * 1)
    have hroot1 : AdjoinRoot.root f ^ N = AdjoinRoot.of f a := by
      have h0 : AdjoinRoot.mk f f = 0 := AdjoinRoot.mk_self
      have h1 : AdjoinRoot.mk f f = AdjoinRoot.root f ^ N - AdjoinRoot.of f a := by
        show AdjoinRoot.mk f (Polynomial.X ^ N - Polynomial.C a) = _
        rw [map_sub, map_pow, AdjoinRoot.mk_X, AdjoinRoot.mk_C]
      rw [h1] at h0
      exact sub_eq_zero.mp h0
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (τ a) hN0
    have hzu : IsUnit z := by
      have : IsUnit (z ^ N) := by rw [hz]; exact ha.map τ
      exact (isUnit_pow_iff hN0.ne').mp this
    have heval : Polynomial.eval₂ τ z f = 0 := by
      show Polynomial.eval₂ τ z (Polynomial.X ^ N - Polynomial.C a) = 0
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, hz, sub_self]
    have hder : Polynomial.derivative f = Polynomial.C ((N : ℕ) : R) * Polynomial.X ^ (N - 1) := by
      show Polynomial.derivative (Polynomial.X ^ N - Polynomial.C a) = _
      rw [Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C, sub_zero]
    have hl0r : IsUnit (AdjoinRoot.lift τ z heval r) := by
      show IsUnit (AdjoinRoot.lift τ z heval (AdjoinRoot.mk f (Polynomial.derivative f * 1)))
      rw [AdjoinRoot.lift_mk, hder, Polynomial.eval₂_mul, Polynomial.eval₂_one, mul_one,
        Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow]
      exact (hN.map τ).mul (hzu.pow _)
    refine ⟨Localization.Away r, inferInstance, inferInstance, hEt R f 1,
      algebraMap (AdjoinRoot f) (Localization.Away r) (AdjoinRoot.root f), ?_,
      IsLocalization.Away.lift (S := Localization.Away r) r hl0r, ?_⟩
    · rw [← map_pow, hroot1, IsScalarTower.algebraMap_apply R (AdjoinRoot f) (Localization.Away r) a,
        AdjoinRoot.algebraMap_eq]
    · apply RingHom.ext
      intro c
      rw [RingHom.comp_apply,
        IsScalarTower.algebraMap_apply R (AdjoinRoot f) (Localization.Away r) c,
        ← RingHom.comp_apply (IsLocalization.Away.lift (S := Localization.Away r) r hl0r),
        IsLocalization.Away.lift_comp (S := Localization.Away r) r hl0r,
        AdjoinRoot.algebraMap_eq]
      exact AdjoinRoot.lift_of heval

  obtain ⟨t, ht0⟩ : ∃ t : Spec (.of (AlgebraicClosure (U.residueField x))) ⟶ A₁.right.left,
      t = A₁.hom.left := ⟨_, rfl⟩
  have ht : t ≫ A₁.right.hom = wcEtGeomPt U x := by rw [ht0]; exact Over.w A₁.hom
  obtain ⟨ψ, hψ⟩ : ∃ ψ : Spec (.of (AlgebraicClosure (U.residueField x))) ⟶
      Spec Γ(A₁.right.left, ⊤), ψ = t ≫ A₁.right.left.isoSpec.hom := ⟨_, rfl⟩
  obtain ⟨S, _, _, hEtS, θ, hθ, lam, hlam⟩ := halg Γ(A₁.right.left, ⊤) a ha N hN0 hN
    (AlgebraicClosure (U.residueField x)) (Spec.preimage ψ).hom

  haveI hSpecEt : Etale (Spec.map (CommRingCat.ofHom (algebraMap Γ(A₁.right.left, ⊤) S))) :=
    HasRingHomProperty.Spec_iff.mpr (RingHom.etale_algebraMap.mpr hEtS)
  obtain ⟨e', he'⟩ : ∃ e' : Spec (.of S) ⟶ A₁.right.left,
      e' = Spec.map (CommRingCat.ofHom (algebraMap Γ(A₁.right.left, ⊤) S)) ≫
        A₁.right.left.isoSpec.inv := ⟨_, rfl⟩
  haveI hEe' : Etale e' := by rw [he']; infer_instance
  let V'obj : U.Etale := MorphismProperty.Over.mk ⊤ (e' ≫ A₁.right.hom)
