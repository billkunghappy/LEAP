  have hy1 : (Ideal.span {Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcSrmC0 A r))
        (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)))}).IsPrime ∧
