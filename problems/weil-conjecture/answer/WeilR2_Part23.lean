  have hfac : uD ≫ O.ι = gU ≫ fW ≫ β := IsOpenImmersion.lift_fac _ _ _

  have hunit : IsUnit (O.ι.appTop.hom yT) := by
    have htop : O.toScheme.basicOpen (O.ι.appTop.hom yT) = ⊤ := by
      rw [← Scheme.preimage_basicOpen_top, Scheme.Opens.ι_preimage_self]
    refine RingedSpace.isUnit_of_isUnit_germ O.toScheme.toRingedSpace ⊤ _ (fun x _ => ?_)
    have hx : x ∈ O.toScheme.basicOpen (O.ι.appTop.hom yT) := by rw [htop]; trivial
    exact (Scheme.mem_basicOpen_top _ _ x).mp hx

  set ψU : Γ(Ul, ⊤) →+* Kb := (eU.inv.appTop ≫ (Scheme.ΓSpecIso (CommRingCat.of Kb)).hom).hom
    with hψU
  have KVc : (Scheme.ΓSpecIso (CommRingCat.of Q)).inv ≫ eT.appTop ≫ O.ι.appTop ≫ uD.appTop ≫
      eU.inv.appTop ≫ (Scheme.ΓSpecIso (CommRingCat.of Kb)).hom =
      CommRingCat.ofHom βQ ≫ CommRingCat.ofHom lam := by
    have h1 : eU.inv ≫ uD ≫ O.ι ≫ eT = Spec.map (CommRingCat.ofHom βQ ≫ CommRingCat.ofHom lam) := by
      rw [reassoc_of% hfac, Spec.map_comp, ← H]
    have h2 := congrArg Scheme.Hom.appTop h1
    simp only [Scheme.Hom.comp_appTop, Category.assoc] at h2
    rw [reassoc_of% h2, Scheme.ΓSpecIso_naturality, Iso.inv_hom_id_assoc]
  have KV : ψU (uD.appTop.hom (O.ι.appTop.hom yT)) = lam (βQ s) := by
    exact congrArg (fun φ : CommRingCat.of Q ⟶ CommRingCat.of Kb => φ.hom s) KVc
  refine ⟨uD, hunit, hfac, hmem, ?_⟩
  rintro M j ⟨τ, hτ⟩
  refine ⟨ψU τ, ?_⟩
  have h1 := congrArg (fun u : (Γ(Ul, ⊤))ˣ => ψU (u : Γ(Ul, ⊤))) hτ
  simp only [Units.val_pow_eq_pow_val, map_pow, Units.coe_map, IsUnit.unit_spec] at h1
  rw [h1, ← KV]
  rfl

