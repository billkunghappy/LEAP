      let S : B := ∑ i : Fin (r + 1), ∑ b, g (wcSrmCh A r i.succ b) * w i.succ * w b
      let v : Fin (r + 2) → B := fun p => if p.val = 1 then ρ.hom (x p1) + S else w p
