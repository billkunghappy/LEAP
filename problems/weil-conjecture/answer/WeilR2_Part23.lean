        (evX' X' (𝟙 X'))
      have n1' := n1.trans (congrArg
        (fun y : (Dw.Φ.obj (Di.Φ.obj X')).val.obj
            (Opposite.op ((wcEtBaseChange w).obj ((wcEtBaseChange i).obj V))) =>
          ((Dw.Φ.obj (Di.Φ.obj X')).val.map
            ((wcEtBaseChange w).map ((wcEtBaseChange i).map h)).op).hom y) hθ')
      show ((β.app ((Di.Φ ⋙ Dw.Φ).obj X')).val.app (Opposite.op T)).hom
        ((((Di.adj.comp Dw.adj).unit.app X').val.app
            (Opposite.op ((wcEtSlice V).obj T))).hom
          ((εO.val.app (Opposite.op T)).hom
            (1 : (wcEtZModRing V.left m).obj.obj (Opposite.op T)))) = _
      rw [hεO_all T h hh]
      refine (congrArg (fun x => ((β.app ((Di.Φ ⋙ Dw.Φ).obj X')).val.app (Opposite.op T)).hom x)
        n1').trans ?_
      refine (hβ ((Di.Φ ⋙ Dw.Φ).obj X') T ζ hζf hζs _).trans ?_
      exact ((Dw.Φ.obj (Di.Φ.obj X')).val.map_comp_apply
        ((wcEtBaseChange w).map ((wcEtBaseChange i).map h)).op ζ.op θ').symm
    · rw [hK']
      have n2 := PresheafOfModules.naturality_apply tU.val h'.op (ev PU (𝟙 PU))
      have n2' := n2.trans (congrArg
        (fun y : (Dw.Φ.obj (Di.Φ.obj X')).val.obj (Opposite.op V') =>
          ((Dw.Φ.obj (Di.Φ.obj X')).val.map h'.op).hom y) s3)
      show _ = (tU.val.app (Opposite.op ((wcEtSlice V').obj ((wcEtBaseChange fU).obj T)))).hom
        ((εU.val.app (Opposite.op ((wcEtBaseChange fU).obj T))).hom
          (((@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
            (wcEtBaseChange fU) _ _ D.cont D.φ).val.app
              (Opposite.op T)).hom (1 : (wcEtZModRing V.left m).obj.obj (Opposite.op T))))
      rw [e5 T, hεU_all ((wcEtBaseChange fU).obj T) h' hh']
      exact ((Dw.Φ.obj (Di.Φ.obj X')).val.map_comp_apply d'.op h'.op θ').trans n2'.symm
  · obtain ⟨h, h', ζ, hh, hh', hζf, hζs, hK'⟩ := key T
    have e1 : ((SheafOfModules.unitToPushforwardObjUnit ψ).val.app (Opposite.op T)).hom
        (1 : (wcEtZModRing V.left m).obj.obj (Opposite.op T)) =
        (1 : (wcEtZModRing S m).obj.obj (Opposite.op ((wcEtSlice V).obj T))) :=
      (SheafOfModules.unitToPushforwardObjUnit_val_app_apply ψ (X := Opposite.op T) _).trans
        (map_one (ConcreteCategory.hom (ψ.hom.app (Opposite.op T))))
    have e2 : ((@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange i) _ _
        Di.cont Di.φ).val.app (Opposite.op ((wcEtSlice V).obj T))).hom
          (1 : (wcEtZModRing S m).obj.obj (Opposite.op ((wcEtSlice V).obj T))) =
        (1 : (wcEtZModRing Z m).obj.obj
          (Opposite.op ((wcEtBaseChange i).obj ((wcEtSlice V).obj T)))) :=
      (SheafOfModules.unitToPushforwardObjUnit_val_app_apply Di.φ
        (X := Opposite.op ((wcEtSlice V).obj T)) _).trans
        (map_one (ConcreteCategory.hom (Di.φ.hom.app (Opposite.op ((wcEtSlice V).obj T)))))
    have e3 : ((@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange w) _ _
        Dw.cont Dw.φ).val.app (Opposite.op ((wcEtBaseChange i).obj ((wcEtSlice V).obj T)))).hom
          (1 : (wcEtZModRing Z m).obj.obj
            (Opposite.op ((wcEtBaseChange i).obj ((wcEtSlice V).obj T)))) =
        (1 : (wcEtZModRing W m).obj.obj
          (Opposite.op ((wcEtBaseChange w).obj ((wcEtBaseChange i).obj ((wcEtSlice V).obj T))))) :=
      (SheafOfModules.unitToPushforwardObjUnit_val_app_apply Dw.φ
        (X := Opposite.op ((wcEtBaseChange i).obj ((wcEtSlice V).obj T))) _).trans
        (map_one (ConcreteCategory.hom
          (Dw.φ.hom.app (Opposite.op ((wcEtBaseChange i).obj ((wcEtSlice V).obj T))))))
    have e6 : ((SheafOfModules.unitToPushforwardObjUnit ψ').val.app
        (Opposite.op ((wcEtBaseChange fU).obj T))).hom
          (1 : (wcEtZModRing V'.left m).obj.obj (Opposite.op ((wcEtBaseChange fU).obj T))) =
        (1 : (wcEtZModRing W m).obj.obj
          (Opposite.op ((wcEtSlice V').obj ((wcEtBaseChange fU).obj T)))) :=
      (SheafOfModules.unitToPushforwardObjUnit_val_app_apply ψ'
        (X := Opposite.op ((wcEtBaseChange fU).obj T)) _).trans
        (map_one (ConcreteCategory.hom (ψ'.hom.app (Opposite.op ((wcEtBaseChange fU).obj T)))))
    show ((β.app (SheafOfModules.unit (wcEtZModRing W m))).val.app (Opposite.op T)).hom
        (((@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange w) _ _
          Dw.cont Dw.φ).val.app
            (Opposite.op ((wcEtBaseChange i).obj ((wcEtSlice V).obj T)))).hom
          (((@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange i) _ _
            Di.cont Di.φ).val.app (Opposite.op ((wcEtSlice V).obj T))).hom
            (((SheafOfModules.unitToPushforwardObjUnit ψ).val.app (Opposite.op T)).hom
              (1 : (wcEtZModRing V.left m).obj.obj (Opposite.op T))))) =
      ((SheafOfModules.unitToPushforwardObjUnit ψ').val.app
          (Opposite.op ((wcEtBaseChange fU).obj T))).hom
        (((@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
          (wcEtBaseChange fU) _ _ D.cont D.φ).val.app
            (Opposite.op T)).hom (1 : (wcEtZModRing V.left m).obj.obj (Opposite.op T)))
    rw [e1, e2, e3, e5 T, e6]
    refine (hβ _ T ζ hζf hζs _).trans ?_
    exact PresheafOfModules.unit_map_one _ ζ.op

theorem wc_et_bwx_section_factor {S Z : Scheme.{u}} (iS : Z ⟶ S) (m : ℕ) (Dg : wcEtPullData iS m)
    (B : Type u) [CommRing B] (a' : Spec (.of B) ⟶ S)
    (Dw : wcEtPullData (Limits.pullback.snd a' iS) m)
    (U : (Limits.pullback a' iS).Etale)
    (PU : SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback a' iS) m))
    (ev : ∀ M : SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback a' iS) m),
      (PU ⟶ M) ≃ M.val.obj (Opposite.op U))
    (hnat : ∀ (M N : SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback a' iS) m))
      (φ : M ⟶ N) (g : PU ⟶ M), ev N (g ≫ φ) = (φ.val.app (Opposite.op U)).hom (ev M g))
    (T₀ : S.Etale) (β : Spec (.of B) ⟶ T₀.left) (hβ : β ≫ T₀.hom = a') (O : T₀.left.Opens)
    (P P' : SheafOfModules.{u+1} (wcEtZModRing S m))
    (evP : ∀ M : SheafOfModules.{u+1} (wcEtZModRing S m), (P ⟶ M) ≃ M.val.obj (Opposite.op T₀))
    (hnatP : ∀ (M N : SheafOfModules.{u+1} (wcEtZModRing S m)) (φ : M ⟶ N) (g : P ⟶ M),
      evP N (g ≫ φ) = (φ.val.app (Opposite.op T₀)).hom (evP M g))
    (evP' : ∀ M : SheafOfModules.{u+1} (wcEtZModRing S m),
      (P' ⟶ M) ≃ M.val.obj (Opposite.op (wcEtOpen S T₀ O)))
    (hnatP' : ∀ (M N : SheafOfModules.{u+1} (wcEtZModRing S m)) (φ : M ⟶ N) (g : P' ⟶ M),
      evP' N (g ≫ φ) = (φ.val.app (Opposite.op (wcEtOpen S T₀ O))).hom (evP' M g))
    (ι : P' ⟶ P)
    (hι : ∀ (M : SheafOfModules.{u+1} (wcEtZModRing S m)) (g : P ⟶ M),
      evP' M (ι ≫ g) = (M.val.map (wcEtOpenι S T₀ O).op).hom (evP M g))
    (uD : U.left ⟶ O.toScheme)
    (huD : uD ≫ O.ι = U.hom ≫ Limits.pullback.fst a' iS ≫ β)
    (d' : U ⟶ (wcEtBaseChange (Limits.pullback.snd a' iS)).obj ((wcEtBaseChange iS).obj (wcEtOpen S T₀ O)))
    (hd' : d'.left ≫ Limits.pullback.fst (Limits.pullback.snd (wcEtOpen S T₀ O).hom iS)
      (Limits.pullback.snd a' iS) ≫ Limits.pullback.fst (wcEtOpen S T₀ O).hom iS = uD)
    (θ' : (Dw.Φ.obj (Dg.Φ.obj P')).val.obj (Opposite.op
      ((wcEtBaseChange (Limits.pullback.snd a' iS)).obj ((wcEtBaseChange iS).obj (wcEtOpen S T₀ O)))))
    (hθ' : (((Dg.adj.comp Dw.adj).unit.app P').val.app (Opposite.op (wcEtOpen S T₀ O))).hom
      (evP' P' (𝟙 P')) = θ')
    (tU : PU ⟶ Dw.Φ.obj (Dg.Φ.obj P'))
    (htU : ev _ tU = ((Dw.Φ.obj (Dg.Φ.obj P')).val.map d'.op).hom θ') :
    ∃ s : SheafOfModules.unit (wcEtZModRing (Limits.pullback a' iS) m) ⟶ Dw.Φ.obj (Dg.Φ.obj P),
      (ev (SheafOfModules.unit _)).symm (wcModUnitOne _ U) ≫ s = tU ≫ Dw.Φ.map (Dg.Φ.map ι) :=
by

  have hext : ∀ {V : S.Etale} {T : (Limits.pullback a' iS).Etale}
      (k l : T ⟶ (wcEtBaseChange (Limits.pullback.snd a' iS)).obj ((wcEtBaseChange iS).obj V)),
      k.left ≫ Limits.pullback.fst (Limits.pullback.snd V.hom iS) (Limits.pullback.snd a' iS) ≫
          Limits.pullback.fst V.hom iS =
        l.left ≫ Limits.pullback.fst (Limits.pullback.snd V.hom iS) (Limits.pullback.snd a' iS) ≫
          Limits.pullback.fst V.hom iS → k = l := by
    intro V T k l h
    apply MorphismProperty.Over.Hom.ext
    have hk : k.left ≫ Limits.pullback.snd (Limits.pullback.snd V.hom iS)
        (Limits.pullback.snd a' iS) = T.hom := MorphismProperty.Over.w k
    have hl : l.left ≫ Limits.pullback.snd (Limits.pullback.snd V.hom iS)
        (Limits.pullback.snd a' iS) = T.hom := MorphismProperty.Over.w l
    have ck : (k.left ≫ Limits.pullback.fst (Limits.pullback.snd V.hom iS)
        (Limits.pullback.snd a' iS)) ≫ Limits.pullback.snd V.hom iS =
        T.hom ≫ Limits.pullback.snd a' iS :=
      (Category.assoc _ _ _).trans ((whisker_eq k.left Limits.pullback.condition).trans
        ((Category.assoc _ _ _).symm.trans (eq_whisker hk _)))
    have cl : (l.left ≫ Limits.pullback.fst (Limits.pullback.snd V.hom iS)
        (Limits.pullback.snd a' iS)) ≫ Limits.pullback.snd V.hom iS =
        T.hom ≫ Limits.pullback.snd a' iS :=
      (Category.assoc _ _ _).trans ((whisker_eq l.left Limits.pullback.condition).trans
        ((Category.assoc _ _ _).symm.trans (eq_whisker hl _)))
    refine Limits.pullback.hom_ext (f := Limits.pullback.snd V.hom iS)
      (g := Limits.pullback.snd a' iS) ?_ ?_
    · refine Limits.pullback.hom_ext (f := V.hom) (g := iS) ?_ ?_
      · exact (Category.assoc _ _ _).trans (h.trans (Category.assoc _ _ _).symm)
      · exact ck.trans cl.symm
    · exact hk.trans hl.symm

  have cV : ∀ V : (Limits.pullback a' iS).Etale,
      (V.hom ≫ Limits.pullback.fst a' iS ≫ β) ≫ T₀.hom =
        (V.hom ≫ Limits.pullback.snd a' iS) ≫ iS := by
    intro V
    simp only [Category.assoc]
    rw [hβ, Limits.pullback.condition]
  obtain ⟨δ, hδ⟩ : ∃ δ : ∀ V : (Limits.pullback a' iS).Etale,
      V ⟶ (wcEtBaseChange (Limits.pullback.snd a' iS)).obj ((wcEtBaseChange iS).obj T₀),
      ∀ V, (δ V).left ≫ Limits.pullback.fst (Limits.pullback.snd T₀.hom iS)
          (Limits.pullback.snd a' iS) ≫ Limits.pullback.fst T₀.hom iS =
        V.hom ≫ Limits.pullback.fst a' iS ≫ β := by
    refine ⟨fun V => MorphismProperty.Over.homMk
      (Limits.pullback.lift (f := Limits.pullback.snd T₀.hom iS) (g := Limits.pullback.snd a' iS)
        (Limits.pullback.lift (f := T₀.hom) (g := iS)
          (V.hom ≫ Limits.pullback.fst a' iS ≫ β)
          (V.hom ≫ Limits.pullback.snd a' iS) (cV V)) V.hom (Limits.pullback.lift_snd _ _ _))
      (Limits.pullback.lift_snd _ _ _) trivial, fun V => ?_⟩
    show Limits.pullback.lift (f := Limits.pullback.snd T₀.hom iS)
        (g := Limits.pullback.snd a' iS) _ _ _ ≫ _ ≫ _ = _
    rw [Limits.pullback.lift_fst_assoc, Limits.pullback.lift_fst]

  have hcomp : ∀ {V₁ V₂ : (Limits.pullback a' iS).Etale} (f : V₁ ⟶ V₂), f ≫ δ V₂ = δ V₁ := by
    intro V₁ V₂ f
    apply hext
    have e : (f ≫ δ V₂).left = f.left ≫ (δ V₂).left := MorphismProperty.Comma.comp_left _ _
    rw [e, Category.assoc, hδ, hδ, ← Category.assoc, MorphismProperty.Over.w f]

  have hd : d' ≫ (wcEtBaseChange (Limits.pullback.snd a' iS)).map
      ((wcEtBaseChange iS).map (wcEtOpenι S T₀ O)) = δ U := by
    apply hext
    have e : (d' ≫ (wcEtBaseChange (Limits.pullback.snd a' iS)).map
        ((wcEtBaseChange iS).map (wcEtOpenι S T₀ O))).left =
        d'.left ≫ ((wcEtBaseChange (Limits.pullback.snd a' iS)).map
          ((wcEtBaseChange iS).map (wcEtOpenι S T₀ O))).left :=
      MorphismProperty.Comma.comp_left _ _
    have f1 : ((wcEtBaseChange (Limits.pullback.snd a' iS)).map
        ((wcEtBaseChange iS).map (wcEtOpenι S T₀ O))).left ≫
        Limits.pullback.fst (Limits.pullback.snd T₀.hom iS) (Limits.pullback.snd a' iS) =
        Limits.pullback.fst (Limits.pullback.snd (wcEtOpen S T₀ O).hom iS)
          (Limits.pullback.snd a' iS) ≫ ((wcEtBaseChange iS).map (wcEtOpenι S T₀ O)).left :=
      Limits.pullback.lift_fst _ _ _
    have f2 : ((wcEtBaseChange iS).map (wcEtOpenι S T₀ O)).left ≫ Limits.pullback.fst T₀.hom iS =
        Limits.pullback.fst (wcEtOpen S T₀ O).hom iS ≫ (wcEtOpenι S T₀ O).left :=
      Limits.pullback.lift_fst _ _ _
    have f1' : ((wcEtBaseChange (Limits.pullback.snd a' iS)).map
        ((wcEtBaseChange iS).map (wcEtOpenι S T₀ O))).left ≫
        Limits.pullback.fst (Limits.pullback.snd T₀.hom iS) (Limits.pullback.snd a' iS) ≫
          Limits.pullback.fst T₀.hom iS =
        Limits.pullback.fst (Limits.pullback.snd (wcEtOpen S T₀ O).hom iS)
          (Limits.pullback.snd a' iS) ≫ Limits.pullback.fst (wcEtOpen S T₀ O).hom iS ≫
            (wcEtOpenι S T₀ O).left :=
      (Category.assoc _ _ _).symm.trans ((eq_whisker f1 _).trans
        ((Category.assoc _ _ _).trans (whisker_eq _ f2)))
    have hd'' : d'.left ≫ Limits.pullback.fst (Limits.pullback.snd (wcEtOpen S T₀ O).hom iS)
          (Limits.pullback.snd a' iS) ≫ Limits.pullback.fst (wcEtOpen S T₀ O).hom iS ≫
            (wcEtOpenι S T₀ O).left =
        uD ≫ (wcEtOpenι S T₀ O).left :=
      (whisker_eq d'.left (Category.assoc _ _ _).symm).trans
        ((Category.assoc _ _ _).symm.trans (eq_whisker hd' _))
    have hU' : uD ≫ (wcEtOpenι S T₀ O).left = U.hom ≫ Limits.pullback.fst a' iS ≫ β := huD
    rw [hδ, e]
    exact (Category.assoc _ _ _).trans ((whisker_eq d'.left f1').trans (hd''.trans hU'))

  obtain ⟨θ, hθ⟩ : ∃ θ : (Dw.Φ.obj (Dg.Φ.obj P)).val.obj (Opposite.op
      ((wcEtBaseChange (Limits.pullback.snd a' iS)).obj ((wcEtBaseChange iS).obj T₀))),
      (((Dg.adj.comp Dw.adj).unit.app P).val.app (Opposite.op T₀)).hom (evP P (𝟙 P)) = θ :=
    ⟨_, rfl⟩
  have htr : ((Dw.Φ.map (Dg.Φ.map ι)).val.app (Opposite.op
        ((wcEtBaseChange (Limits.pullback.snd a' iS)).obj
          ((wcEtBaseChange iS).obj (wcEtOpen S T₀ O))))).hom θ' =
      ((Dw.Φ.obj (Dg.Φ.obj P)).val.map
        ((wcEtBaseChange (Limits.pullback.snd a' iS)).map
          ((wcEtBaseChange iS).map (wcEtOpenι S T₀ O))).op).hom θ := by
    have a1 := (Dg.adj.comp Dw.adj).unit_naturality ι
    have a2 := congrArg (fun φ => (φ.val.app (Opposite.op (wcEtOpen S T₀ O))).hom
      (evP' P' (𝟙 P'))) a1
    simp only [SheafOfModules.comp_val, PresheafOfModules.comp_app, ModuleCat.hom_comp,
      LinearMap.comp_apply] at a2
    have a3 : (ι.val.app (Opposite.op (wcEtOpen S T₀ O))).hom (evP' P' (𝟙 P')) =
        (P.val.map (wcEtOpenι S T₀ O).op).hom (evP P (𝟙 P)) := by
      rw [← hnatP', ← hι, Category.id_comp, Category.comp_id]
    rw [hθ', a3] at a2
    have a4 := PresheafOfModules.naturality_apply ((Dg.adj.comp Dw.adj).unit.app P).val
      (wcEtOpenι S T₀ O).op (evP P (𝟙 P))
    exact a2.trans (a4.trans (congrArg (fun y => ((Dw.Φ.obj (Dg.Φ.obj P)).val.map
      ((wcEtBaseChange (Limits.pullback.snd a' iS)).map
        ((wcEtBaseChange iS).map (wcEtOpenι S T₀ O))).op).hom y) hθ))

  let σ : (Y : ((Limits.pullback a' iS).Etale)ᵒᵖ) → (Dw.Φ.obj (Dg.Φ.obj P)).val.obj Y :=
    fun Y => ((Dw.Φ.obj (Dg.Φ.obj P)).val.map (δ Y.unop).op).hom θ
  have hσ : ∀ ⦃Y₁ Y₂ : ((Limits.pullback a' iS).Etale)ᵒᵖ⦄ (f : Y₁ ⟶ Y₂),
      ((Dw.Φ.obj (Dg.Φ.obj P)).val.map f).hom (σ Y₁) = σ Y₂ := by
    intro Y₁ Y₂ f
    have hf : (δ Y₁.unop).op ≫ f = (δ Y₂.unop).op := by
      rw [← hcomp f.unop, op_comp, Quiver.Hom.op_unop]
    have e1 := PresheafOfModules.map_comp_apply (Dw.Φ.obj (Dg.Φ.obj P)).val (δ Y₁.unop).op f θ
    rw [hf] at e1
    exact e1.symm
  obtain ⟨s, hs⟩ : ∃ s : SheafOfModules.unit (wcEtZModRing (Limits.pullback a' iS) m) ⟶
      Dw.Φ.obj (Dg.Φ.obj P),
      (Dw.Φ.obj (Dg.Φ.obj P)).unitHomEquiv s = PresheafOfModules.sectionsMk σ hσ :=
    ⟨_, Equiv.apply_symm_apply _ _⟩
  have hsU := (SheafOfModules.unitHomEquiv_apply_coe _ s (Opposite.op U)).symm.trans
    ((congrArg (fun t => t.1 (Opposite.op U)) hs).trans
      (PresheafOfModules.sectionsMk_coe σ hσ (Opposite.op U)))

  have e2 := PresheafOfModules.map_comp_apply (Dw.Φ.obj (Dg.Φ.obj P)).val
    ((wcEtBaseChange (Limits.pullback.snd a' iS)).map
      ((wcEtBaseChange iS).map (wcEtOpenι S T₀ O))).op d'.op θ
  rw [← op_comp, hd] at e2
  have n1 := PresheafOfModules.naturality_apply (Dw.Φ.map (Dg.Φ.map ι)).val d'.op θ'
  refine ⟨s, (ev (Dw.Φ.obj (Dg.Φ.obj P))).injective ?_⟩
  rw [hnat, hnat, Equiv.apply_symm_apply, htU]
  refine hsU.trans (e2.trans ?_)
  exact (n1.trans (congrArg (fun y => ((Dw.Φ.obj (Dg.Φ.obj P)).val.map d'.op).hom y) htr)).symm

theorem wc_et_dnb_bw_ext_order {S Z : Scheme.{u}} (iS : Z ⟶ S) (m : ℕ) (hm : 0 < m)
    (Dg : wcEtPullData iS m) (B : Type u) [CommRing B] (a' : Spec (.of B) ⟶ S)
    (Dw : wcEtPullData (Limits.pullback.snd a' iS) m)
    (U : (Limits.pullback a' iS).Etale)
    (PU : SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback a' iS) m))
    (ev : ∀ M : SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback a' iS) m),
      (PU ⟶ M) ≃ M.val.obj (Opposite.op U))
    (hnat : ∀ (M N : SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback a' iS) m))
      (ψ : M ⟶ N) (g : PU ⟶ M), ev N (g ≫ ψ) = (ψ.val.app (Opposite.op U)).hom (ev M g))
    (hadd : ∀ (M : SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback a' iS) m))
      (g g' : PU ⟶ M), ev M (g + g') = ev M g + ev M g')
    (T₀ : S.Etale) (β : Spec (.of B) ⟶ T₀.left) (hβ : β ≫ T₀.hom = a')
    (O : T₀.left.Opens)
    (P P' : SheafOfModules.{u+1} (wcEtZModRing S m))
    (evP : ∀ M : SheafOfModules.{u+1} (wcEtZModRing S m), (P ⟶ M) ≃ M.val.obj (Opposite.op T₀))
    (hnatP : ∀ (M N : SheafOfModules.{u+1} (wcEtZModRing S m)) (ψ : M ⟶ N) (g : P ⟶ M),
      evP N (g ≫ ψ) = (ψ.val.app (Opposite.op T₀)).hom (evP M g))
    (haddP : ∀ (M : SheafOfModules.{u+1} (wcEtZModRing S m)) (g g' : P ⟶ M),
      evP M (g + g') = evP M g + evP M g')
