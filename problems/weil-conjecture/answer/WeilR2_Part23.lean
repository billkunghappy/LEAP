  let tU : ∀ j, (Γ(((wcEtBaseChange (Limits.pullback.fst f' ξ)).obj (E j)).left, ⊤))ˣ :=
    fun j => (htu j).unit
  have htU : ∀ j, ((tU j : Γ(((wcEtBaseChange (Limits.pullback.fst f' ξ)).obj (E j)).left, ⊤))) =
      (Limits.pullback.fst (e j) (Limits.pullback.fst f' ξ)).appTop.hom
