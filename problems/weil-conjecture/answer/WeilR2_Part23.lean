theorem wc_sfh_special_tensor_equiv : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (π : A), π ∈ IsLocalRing.maximalIdeal A → ∀ (r : ℕ), ∃ Φ : TensorProduct A (wcQuadModelRing A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (IsLocalRing.ResidueField A) ≃+* (MvPolynomial (Fin (r + 2)) (IsLocalRing.ResidueField A) ⧸ (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} : Ideal (MvPolynomial (Fin (r + 2)) (IsLocalRing.ResidueField A)))), ∀ k : Fin (r + 2), Φ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X k) ⊗ₜ[A] (1 : IsLocalRing.ResidueField A)) = Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) (MvPolynomial.X k) :=
by
  intro A _ _ π hπ r
  classical

  have hF : (∑ p : Fin (r + 2), ∑ q : Fin (r + 2),
      MvPolynomial.C ((Matrix.of fun i j : Fin (r + 2) =>
        if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) p q) *
        MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C π : MvPolynomial (Fin (r + 2)) A) =
      MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C π := by
    congr 1
    rw [Fintype.sum_eq_single (0 : Fin (r + 2))]
    · rw [Fintype.sum_eq_single (1 : Fin (r + 2))]
      · simp
      · intro q hq
        have hq' : q.val ≠ 1 := fun h => hq (Fin.ext (by simp [h]))
        simp [hq']
    · intro p hp
      have hp' : p.val ≠ 0 := fun h => hp (Fin.ext (by simp [h]))
      apply Finset.sum_eq_zero
      intro q _
      simp [hp, hp']

  have hres : algebraMap A (IsLocalRing.ResidueField A) π = 0 :=
    (IsLocalRing.residue_eq_zero_iff π).mpr hπ
  have hresN : algebraMap A (MvPolynomial (Fin (r + 2)) (IsLocalRing.ResidueField A) ⧸
      (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} :
        Ideal (MvPolynomial (Fin (r + 2)) (IsLocalRing.ResidueField A)))) π = 0 := by
    rw [IsScalarTower.algebraMap_apply A (IsLocalRing.ResidueField A), hres, map_zero]

  let a₀ : MvPolynomial (Fin (r + 2)) A →ₐ[A]
      (MvPolynomial (Fin (r + 2)) (IsLocalRing.ResidueField A) ⧸
        (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} :
          Ideal (MvPolynomial (Fin (r + 2)) (IsLocalRing.ResidueField A)))) :=
    MvPolynomial.aeval (fun k => Ideal.Quotient.mk _ (MvPolynomial.X k))
  have hα : ∀ a ∈ wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) =>
      if i.val = 0 ∧ j.val = 1 then (1 : A) else 0), a₀ a = 0 := by
    intro a ha
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [hF, map_mul, map_sub, map_mul]
    simp only [a₀, MvPolynomial.aeval_X, MvPolynomial.aeval_C]
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _), hresN,
      sub_zero, mul_zero]
  let α := Ideal.Quotient.liftₐ _ a₀ hα
  let β := IsScalarTower.toAlgHom A (IsLocalRing.ResidueField A)
      (MvPolynomial (Fin (r + 2)) (IsLocalRing.ResidueField A) ⧸
        (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} :
          Ideal (MvPolynomial (Fin (r + 2)) (IsLocalRing.ResidueField A))))
  let Φ₀ := Algebra.TensorProduct.productMap α β
  have hαX : ∀ k : Fin (r + 2), α (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
      (MvPolynomial.X k)) =
      Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) (MvPolynomial.X k) := by
    intro k
    show a₀ (MvPolynomial.X k) = _
    exact MvPolynomial.aeval_X _ k
  have hαC : ∀ a : A, α (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
      (MvPolynomial.C a)) =
      algebraMap A (MvPolynomial (Fin (r + 2)) (IsLocalRing.ResidueField A) ⧸
        (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} :
          Ideal (MvPolynomial (Fin (r + 2)) (IsLocalRing.ResidueField A)))) a := by
    intro a
    show a₀ (MvPolynomial.C a) = _
    exact MvPolynomial.aeval_C _ a
  have hΦX : ∀ k : Fin (r + 2), Φ₀ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
      (MvPolynomial.X k) ⊗ₜ[A] (1 : IsLocalRing.ResidueField A)) =
      Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) (MvPolynomial.X k) := by
    intro k
    rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one, hαX]

  let e₀ : MvPolynomial (Fin (r + 2)) (IsLocalRing.ResidueField A) →+*
      TensorProduct A (wcQuadModelRing A (r + 2) π (Matrix.of fun i j : Fin (r + 2) =>
        if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (IsLocalRing.ResidueField A) :=
    MvPolynomial.eval₂Hom (Algebra.TensorProduct.includeRight :
      IsLocalRing.ResidueField A →ₐ[A] TensorProduct A (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
        (IsLocalRing.ResidueField A)).toRingHom
      (fun k => Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
