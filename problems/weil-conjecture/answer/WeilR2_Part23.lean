  classical
  set yT := eT.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Q)).inv.hom s) with hyT
  set O := T.basicOpen yT with hOdef

  have hmem : ∀ z : T, z ∈ O ↔ s ∉ (eT z).asIdeal := by
    intro z
    rw [hOdef, hyT, ← Scheme.preimage_basicOpen_top, Scheme.Hom.mem_preimage,
      basicOpen_eq_of_affine]
    exact Iff.rfl

  have H : eU.inv ≫ gU ≫ fW ≫ β ≫ eT =
      Spec.map (CommRingCat.ofHom lam) ≫ Spec.map (CommRingCat.ofHom βQ) := by
    rw [hβQ, ← hgU]
    simp only [Category.assoc]
  have hpt : ∀ p : Ul, (gU ≫ fW ≫ β) p ∈ O := by
    intro p
    rw [hmem]
    have e1 : eT ((gU ≫ fW ≫ β) p) =
        (Spec.map (CommRingCat.ofHom lam) ≫ Spec.map (CommRingCat.ofHom βQ)) (eU.hom p) := by
      rw [← H]
      simp only [Scheme.Hom.comp_apply, Scheme.hom_inv_apply]
    rw [e1]
    generalize eU.hom p = q
    intro hsm
    apply hs
    rw [Scheme.Hom.comp_apply, Spec.map_apply, Spec.map_apply] at hsm
    have hsm' : lam (βQ s) ∈ PrimeSpectrum.asIdeal (R := Kb) q := hsm
    haveI : (PrimeSpectrum.asIdeal (R := Kb) q).IsPrime := PrimeSpectrum.isPrime _
    rwa [Ideal.eq_bot_of_prime (PrimeSpectrum.asIdeal (R := Kb) q), Ideal.mem_bot] at hsm'

  have hrange : Set.range (gU ≫ fW ≫ β) ⊆ Set.range O.ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨p, rfl⟩
    exact hpt p
