        (wcEtsmKappa Dw Pf ev ((wcEtBaseChange f).obj V)) =
        ((Dw.adj.unit.app (Pf ((wcEtBaseChange f).obj V))).val.app
          (Opposite.op ((wcEtBaseChange f).obj V))).hom
          (ev ((wcEtBaseChange f).obj V) (Pf ((wcEtBaseChange f).obj V)) (𝟙 _)) :=
      Equiv.apply_symm_apply _ _
    have stepA : ((T.f n).val.app (Opposite.op V)).hom
          (ev ((wcEtBaseChange f).obj V) (I.cochainComplex.X n) g) =
        ((I.cochainComplex.X n).val.map (α.app V).op).hom
          (((t.f n).val.app (Opposite.op ((wcEtBaseChange w).obj ((wcEtBaseChange f).obj V)))).hom
            (((Dw.adj.unit.app (I.cochainComplex.X n)).val.app
              (Opposite.op ((wcEtBaseChange f).obj V))).hom
