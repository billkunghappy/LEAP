      have L : DerivedCategory.Q.map
          ((HomologicalComplex.single (SheafOfModules.{u+1} (wcEtZModRing Y m))
              (ComplexShape.up ℤ) 0).map c ≫
            (HomologicalComplex.singleMapHomologicalComplex Φ (ComplexShape.up ℤ) 0).inv.app X ≫
            (Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map φ ≫
            ((Φ.mapHomologicalComplex (ComplexShape.up ℤ)).commShiftIso (n : ℤ)).hom.app
              I.cochainComplex ≫ t⟦(n : ℤ)⟧') ≫
