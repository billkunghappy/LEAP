theorem wcpa_dj_sgf_generic_smooth : ∀ (k : Type u) [Field k] [Finite k] (Γ Q : Scheme.{u})
    [AlgebraicGeometry.IsIntegral Γ] [AlgebraicGeometry.IsIntegral Q] (sQ : Q ⟶ Spec (.of k))
    (g : Γ ⟶ Q) (d : ℕ),
    wcpaDjIsProjOver k (g ≫ sQ) → wcpaDjIsProjOver k sQ →
    topologicalKrullDim Q = (d : WithBot ℕ∞) →
    topologicalKrullDim Γ = ((d + 1 : ℕ) : WithBot ℕ∞) →
    GeometricallyIrreducible (Limits.pullback.snd g (Q.fromSpecStalk (genericPoint Q))) →
    GeometricallyReduced (Limits.pullback.snd g (Q.fromSpecStalk (genericPoint Q))) →
    ∃ m₀ : ℕ, ∀ m ≥ m₀, ∀ Φ : Q ⟶ Q, IsFinite Φ → wcIsAbsFrob Φ (Nat.card k ^ m) →
      Φ ≫ sQ = sQ →
      ∀ (R : Scheme.{u}) [AlgebraicGeometry.IsIntegral R] (r : R ⟶ Limits.pullback g Φ),
        IsClosedImmersion r → Surjective r →
        ∀ (Xt : Scheme.{u}) [AlgebraicGeometry.IsIntegral Xt] (b : Xt ⟶ R),
          IsFinite b → Surjective b → (∀ x : Xt, IsIntegrallyClosed (Xt.presheaf.stalk x)) →
          (∃ U : R.Opens, U ≠ ⊥ ∧ IsIso (b ∣_ U)) →
          SmoothOfRelativeDimension 1 (Limits.pullback.snd (b ≫ r ≫ Limits.pullback.snd g Φ)
            (Q.fromSpecStalk (genericPoint Q))) ∧
          GeometricallyConnected (Limits.pullback.snd (b ≫ r ≫ Limits.pullback.snd g Φ)
            (Q.fromSpecStalk (genericPoint Q))) :=
by
  intro k _ _ Γ Q _ _ sQ g d hPg hPQ hQd hΓd hGI hGR
  classical

  haveI hsQp : IsProper sQ := wcpa_dj_proj_proper k sQ hPQ
  haveI hgsQ : IsProper (g ≫ sQ) := wcpa_dj_proj_proper k _ hPg
  haveI hgp : IsProper g := IsProper.of_comp g sQ
  haveI : IsLocallyNoetherian Q := LocallyOfFiniteType.isLocallyNoetherian sQ

  have hirr : IrreducibleSpace
      ↥(Limits.pullback (C := Scheme.{u}) g (Q.fromSpecStalk (genericPoint Q))) :=
    hGI.geometrically_irreducibleSpace (K := Q.functionField)
      (𝟙 (Spec (Q.presheaf.stalk (genericPoint Q))))
      (𝟙 _) (Limits.pullback.snd g (Q.fromSpecStalk (genericPoint Q))) IsPullback.of_id_fst
  obtain ⟨w⟩ := (inferInstance :
    Nonempty ↥(Limits.pullback (C := Scheme.{u}) g (Q.fromSpecStalk (genericPoint Q))))
  have hc0 : (Limits.pullback.fst g (Q.fromSpecStalk (genericPoint Q)) ≫ g) w =
      (Limits.pullback.snd g (Q.fromSpecStalk (genericPoint Q)) ≫
        Q.fromSpecStalk (genericPoint Q)) w := by
    rw [Limits.pullback.condition]
  rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at hc0
  have hsp0 : Q.fromSpecStalk (genericPoint Q)
      (Limits.pullback.snd g (Q.fromSpecStalk (genericPoint Q)) w) ⤳ genericPoint Q := by
    have h : Q.fromSpecStalk (genericPoint Q)
        (Limits.pullback.snd g (Q.fromSpecStalk (genericPoint Q)) w) ∈
        Set.range (Q.fromSpecStalk (genericPoint Q)) := ⟨_, rfl⟩
    rw [Scheme.range_fromSpecStalk] at h
    exact h
  have hgγ : g (Limits.pullback.fst g (Q.fromSpecStalk (genericPoint Q)) w) = genericPoint Q := by
    rw [hc0]; exact (hsp0.antisymm (genericPoint_specializes _)).eq
  have hdom : g (genericPoint Γ) = genericPoint Q := by
    have h3 := (genericPoint_specializes
      (Limits.pullback.fst g (Q.fromSpecStalk (genericPoint Q)) w)).map g.continuous
    rw [hgγ] at h3
    exact (h3.antisymm (genericPoint_specializes _)).eq

  have hchart := wcpa_dj_sgs_chart_dim k Γ Q sQ g d hQd hΓd hdom
  obtain ⟨e₀, he₀⟩ := wcpa_dj_sgs_formal_smooth k Q Γ sQ g hchart

  letI := Fintype.ofFinite k
  obtain ⟨n, hp, hcard⟩ := FiniteField.card k (ringChar k)
