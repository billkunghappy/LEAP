  exact ⟨hA, hB, N', e ≫ ι ≫ Limits.pullback.map uX (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) ↥W) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) ↥W 0)))) (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W 0)))) (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) ↥W) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) ↥W 0)))) j (𝟙 _) (𝟙 _) hjg hh ≫ σ,
    inferInstance, heq⟩

theorem wcpa_dj_ms_fibre_ns_local_iso : ∀ (X Y S : Scheme.{u}) (r : Y ⟶ X) (g : X ⟶ S) (U : X.Opens), IsIso (r ∣_ U) → ∀ (K : Type u) [Field K] (sp : Spec (.of K) ⟶ S), (∀ w' : ↥(Limits.pullback g sp), wcpaDjMsFibreNS g K sp w') → ∀ w : ↥(Limits.pullback (r ≫ g) sp), r (Limits.pullback.fst (r ≫ g) sp w) ∈ U → wcpaDjMsFibreNS (r ≫ g) K sp w :=
by
  intro X Y S r g U hU K _ sp hNS w hw

  have hfe : ∀ {R : Type u} [CommRing R] (I : Ideal R) {m n : ℕ} (hle : m ≤ n)
      (y : AdicCompletion I R),
      Ideal.Quotient.factorPow I hle (AdicCompletion.evalₐ I n y) =
        AdicCompletion.evalₐ I m y := by
    intro R _ I m n hle y
    obtain ⟨s, rfl⟩ := AdicCompletion.mk_surjective I R y
    rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk]
    have key := AdicCompletion.AdicCauchySequence.mk_eq_mk hle s
    rw [Submodule.Quotient.eq] at key
    rw [Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk, Ideal.Quotient.eq]
    simpa [smul_eq_mul, Ideal.mul_top] using key

  have hadic : ∀ {A B : Type u} [CommRing A] [CommRing B] (I : Ideal A) (J : Ideal B)
      (σ : A ≃+* B), Ideal.map σ I = J → ∃ τ : AdicCompletion I A ≃+* AdicCompletion J B,
        ∀ a : A, τ (algebraMap A (AdicCompletion I A) a) =
          algebraMap B (AdicCompletion J B) (σ a) := by
    intro A B _ _ I J σ hIJ
    subst hIJ
    have h1 : ∀ n, I ^ n ≤ ((Ideal.map σ I) ^ n).comap σ.toRingHom := by
      intro n x hx
      rw [Ideal.mem_comap, ← Ideal.map_pow]
      exact Ideal.mem_map_of_mem σ hx
    have h2 : ∀ n, (Ideal.map σ I) ^ n ≤ (I ^ n).comap σ.symm.toRingHom := by
      intro n
      have : Ideal.map σ (I ^ n) ≤ (I ^ n).comap σ.symm.toRingHom := by
        rw [Ideal.map_le_iff_le_comap]
        intro x hx
        simpa [Ideal.mem_comap] using hx
      rwa [Ideal.map_pow] at this
    let f : ∀ n, A ⧸ I ^ n →+* B ⧸ (Ideal.map σ I) ^ n := fun n =>
      Ideal.quotientMap ((Ideal.map σ I) ^ n) σ.toRingHom (h1 n)
    let g : ∀ n, B ⧸ (Ideal.map σ I) ^ n →+* A ⧸ I ^ n := fun n =>
      Ideal.quotientMap (I ^ n) σ.symm.toRingHom (h2 n)
    have hgf : ∀ n z, g n (f n z) = z := by
      intro n z
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective z
      simp [f, g, Ideal.quotientMap_mk]
    have hfg : ∀ n z, f n (g n z) = z := by
      intro n z
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective z
      simp [f, g, Ideal.quotientMap_mk]
    let F : ∀ n, AdicCompletion I A →+* B ⧸ (Ideal.map σ I) ^ n := fun n =>
      (f n).comp (AdicCompletion.evalₐ I n).toRingHom
    have hF : ∀ {m n : ℕ} (hle : m ≤ n),
        (Ideal.Quotient.factorPow (Ideal.map σ I) hle).comp (F n) = F m := by
      intro m n hle
      refine RingHom.ext fun y => ?_
      show Ideal.Quotient.factorPow (Ideal.map σ I) hle (f n (AdicCompletion.evalₐ I n y)) =
        f m (AdicCompletion.evalₐ I m y)
      rw [← hfe I hle y]
      obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ I n y)
      rw [← ha]
      simp only [f, Ideal.quotientMap_mk, Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk]
    let G : ∀ n, AdicCompletion (Ideal.map σ I) B →+* A ⧸ I ^ n := fun n =>
      (g n).comp (AdicCompletion.evalₐ (Ideal.map σ I) n).toRingHom
    have hG : ∀ {m n : ℕ} (hle : m ≤ n), (Ideal.Quotient.factorPow I hle).comp (G n) = G m := by
      intro m n hle
      refine RingHom.ext fun y => ?_
      show Ideal.Quotient.factorPow I hle (g n (AdicCompletion.evalₐ (Ideal.map σ I) n y)) =
        g m (AdicCompletion.evalₐ (Ideal.map σ I) m y)
      rw [← hfe (Ideal.map σ I) hle y]
      obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ (Ideal.map σ I) n y)
      rw [← ha]
      simp only [g, Ideal.quotientMap_mk, Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk]
    let φ := AdicCompletion.liftRingHom (Ideal.map σ I) F hF
    let ψ := AdicCompletion.liftRingHom I G hG
    have hφ : ∀ n y, AdicCompletion.evalₐ (Ideal.map σ I) n (φ y) =
        f n (AdicCompletion.evalₐ I n y) :=
      fun n y => AdicCompletion.evalₐ_liftRingHom (Ideal.map σ I) F hF n y
    have hψ : ∀ n y, AdicCompletion.evalₐ I n (ψ y) =
        g n (AdicCompletion.evalₐ (Ideal.map σ I) n y) :=
      fun n y => AdicCompletion.evalₐ_liftRingHom I G hG n y
    have e1 : φ.comp ψ = RingHom.id _ := by
      refine RingHom.ext fun y => ?_
      apply AdicCompletion.ext_evalₐ
      intro n
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hφ, hψ, hfg]
    have e2 : ψ.comp φ = RingHom.id _ := by
      refine RingHom.ext fun y => ?_
      apply AdicCompletion.ext_evalₐ
      intro n
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hψ, hφ, hgf]
    refine ⟨RingEquiv.ofRingHom φ ψ e1 e2, fun a => ?_⟩
    show φ (algebraMap A (AdicCompletion I A) a) =
      algebraMap B (AdicCompletion (Ideal.map σ I) B) (σ a)
    apply AdicCompletion.ext_evalₐ
    intro n
    rw [hφ, AlgHom.commutes, AlgHom.commutes, Ideal.Quotient.algebraMap_eq,
      Ideal.Quotient.algebraMap_eq]
    simp [f, Ideal.quotientMap_mk]

  have hnode : ∀ (A B : Type u) [CommRing A] [IsLocalRing A] [CommRing B] [IsLocalRing B]
      (σ : A ≃+* B) (κA : K →+* A) (κB : K →+* B), (σ : A →+* B).comp κA = κB →
      (∃ e : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+*
          (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
        e.toRingHom.comp ((algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)).comp κA) =
          (Ideal.Quotient.mk _).comp MvPowerSeries.C) →
      ∃ e : AdicCompletion (IsLocalRing.maximalIdeal B) B ≃+*
          (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
        e.toRingHom.comp ((algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B)).comp κB) =
          (Ideal.Quotient.mk _).comp MvPowerSeries.C := by
    intro A B _ _ _ _ σ κA κB hκ he0
    obtain ⟨e, he⟩ := he0
    have hmax : Ideal.map σ (IsLocalRing.maximalIdeal A) = IsLocalRing.maximalIdeal B :=
      IsLocalRing.eq_maximalIdeal (Ideal.map_isMaximal_of_equiv σ)
    obtain ⟨τ, hτ⟩ := hadic _ _ σ hmax
    refine ⟨τ.symm.trans e, ?_⟩
    refine RingHom.ext fun c => ?_
    have h1 := RingHom.congr_fun he c
    have h2 := hτ (κA c)
    have h3 : σ (κA c) = κB c := RingHom.congr_fun hκ c
    simp only [RingHom.comp_apply] at h1 ⊢
    rw [← h3, ← h2]
    simp only [RingEquiv.toRingHom_eq_coe, RingHom.coe_coe, RingEquiv.trans_apply,
      RingEquiv.symm_apply_apply] at h1 ⊢
    exact h1

  have hstalk : ∀ {Q Z : Scheme.{u}} (j : Q ⟶ Z) (a : Z ⟶ Spec (.of K)) (q : Q),
      (j.stalkMap q).hom.comp
        ((Scheme.ΓSpecIso (.of K)).inv ≫ a.appTop ≫ Z.presheaf.germ ⊤ (j q) trivial).hom =
      ((Scheme.ΓSpecIso (.of K)).inv ≫ (j ≫ a).appTop ≫ Q.presheaf.germ ⊤ q trivial).hom := by
    intro Q Z j a q
    have hgs : Z.presheaf.germ ⊤ (j q) trivial ≫ j.stalkMap q =
        j.appTop ≫ Q.presheaf.germ ⊤ q trivial := by
      exact Scheme.Hom.germ_stalkMap j ⊤ q trivial
    have hmor : ((Scheme.ΓSpecIso (.of K)).inv ≫ a.appTop ≫
        Z.presheaf.germ ⊤ (j q) trivial) ≫ j.stalkMap q =
        (Scheme.ΓSpecIso (.of K)).inv ≫ (j ≫ a).appTop ≫ Q.presheaf.germ ⊤ q trivial := by
      rw [Scheme.Hom.comp_appTop, Category.assoc, Category.assoc, hgs]
      simp only [Category.assoc]
    rw [← hmor]
    rfl

  have hnd_fwd : ∀ {Q Z : Scheme.{u}} (j : Q ⟶ Z) [IsOpenImmersion j] (a : Z ⟶ Spec (.of K))
      (q : Q),
      (∃ e : AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk (j q)))
          (Z.presheaf.stalk (j q)) ≃+*
          (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
        e.toRingHom.comp ((algebraMap (Z.presheaf.stalk (j q))
          (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk (j q)))
            (Z.presheaf.stalk (j q)))).comp
          ((Scheme.ΓSpecIso (.of K)).inv ≫ a.appTop ≫ Z.presheaf.germ ⊤ (j q) trivial).hom) =
          (Ideal.Quotient.mk _).comp MvPowerSeries.C) →
      (∃ e : AdicCompletion (IsLocalRing.maximalIdeal (Q.presheaf.stalk q))
          (Q.presheaf.stalk q) ≃+*
          (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
        e.toRingHom.comp ((algebraMap (Q.presheaf.stalk q)
          (AdicCompletion (IsLocalRing.maximalIdeal (Q.presheaf.stalk q))
            (Q.presheaf.stalk q))).comp
          ((Scheme.ΓSpecIso (.of K)).inv ≫ (j ≫ a).appTop ≫ Q.presheaf.germ ⊤ q trivial).hom) =
          (Ideal.Quotient.mk _).comp MvPowerSeries.C) := by
    intro Q Z j _ a q h
    let σ : Z.presheaf.stalk (j q) ≃+* Q.presheaf.stalk q :=
      (asIso (j.stalkMap q)).commRingCatIsoToRingEquiv
    exact hnode _ _ σ _ _ (hstalk j a q) h
  have hnd_bwd : ∀ {Q Z : Scheme.{u}} (j : Q ⟶ Z) [IsOpenImmersion j] (a : Z ⟶ Spec (.of K))
      (q : Q),
      (∃ e : AdicCompletion (IsLocalRing.maximalIdeal (Q.presheaf.stalk q))
          (Q.presheaf.stalk q) ≃+*
          (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
        e.toRingHom.comp ((algebraMap (Q.presheaf.stalk q)
          (AdicCompletion (IsLocalRing.maximalIdeal (Q.presheaf.stalk q))
            (Q.presheaf.stalk q))).comp
          ((Scheme.ΓSpecIso (.of K)).inv ≫ (j ≫ a).appTop ≫ Q.presheaf.germ ⊤ q trivial).hom) =
          (Ideal.Quotient.mk _).comp MvPowerSeries.C) →
      (∃ e : AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk (j q)))
          (Z.presheaf.stalk (j q)) ≃+*
          (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
        e.toRingHom.comp ((algebraMap (Z.presheaf.stalk (j q))
          (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk (j q)))
            (Z.presheaf.stalk (j q)))).comp
          ((Scheme.ΓSpecIso (.of K)).inv ≫ a.appTop ≫ Z.presheaf.germ ⊤ (j q) trivial).hom) =
          (Ideal.Quotient.mk _).comp MvPowerSeries.C) := by
    intro Q Z j _ a q h
    let σ : Z.presheaf.stalk (j q) ≃+* Q.presheaf.stalk q :=
      (asIso (j.stalkMap q)).commRingCatIsoToRingEquiv
    have hσ : ∀ x, σ x = (j.stalkMap q).hom x := fun x => rfl
    refine hnode _ _ σ.symm _ _ ?_ h
    refine RingHom.ext fun c => ?_
    have h1 := RingHom.congr_fun (hstalk j a q) c
    simp only [RingHom.comp_apply, RingHom.coe_coe] at h1 ⊢
    rw [← h1, ← hσ, RingEquiv.symm_apply_apply]

  have hsm_fwd : ∀ {Q Z T : Scheme.{u}} (j : Q ⟶ Z) [IsOpenImmersion j] (a : Z ⟶ T) (q : Q),
      (∃ W : Z.Opens, j q ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ a)) →
      ∃ W' : Q.Opens, q ∈ W' ∧ SmoothOfRelativeDimension 1 (W'.ι ≫ j ≫ a) := by
    intro Q Z T j _ a q h
    obtain ⟨W, hW, hsm⟩ := h
    refine ⟨j ⁻¹ᵁ W, hW, ?_⟩
    have heq : (j ⁻¹ᵁ W).ι ≫ j ≫ a = (j ∣_ W) ≫ (W.ι ≫ a) := by
      rw [← Category.assoc, ← morphismRestrict_ι, Category.assoc]
    have : SmoothOfRelativeDimension 1 (W.ι ≫ a) := hsm
    have : SmoothOfRelativeDimension 0 (j ∣_ W) := inferInstance
    have hc := smoothOfRelativeDimension_comp 0 1 (j ∣_ W) (W.ι ≫ a)
    rw [heq]
    simpa using hc
  have hsm_bwd : ∀ {Q Z T : Scheme.{u}} (j : Q ⟶ Z) [IsOpenImmersion j] (a : Z ⟶ T) (q : Q),
      (∃ W' : Q.Opens, q ∈ W' ∧ SmoothOfRelativeDimension 1 (W'.ι ≫ j ≫ a)) →
      ∃ W : Z.Opens, j q ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ a) := by
    intro Q Z T j _ a q h
    obtain ⟨W', hW', hsm⟩ := h
    refine ⟨j ''ᵁ W', ?_, ?_⟩
    · rw [← SetLike.mem_coe, Scheme.Hom.coe_image]
      exact ⟨q, hW', rfl⟩
    · have heq : (j ''ᵁ W').ι ≫ a = (j.isoImage W').inv ≫ (W'.ι ≫ j ≫ a) := by
        rw [Scheme.Hom.isoImage_inv_ι_assoc]
      have : SmoothOfRelativeDimension 1 (W'.ι ≫ j ≫ a) := hsm
      have : SmoothOfRelativeDimension 0 (j.isoImage W').inv := inferInstance
      have hc := smoothOfRelativeDimension_comp 0 1 (j.isoImage W').inv (W'.ι ≫ j ≫ a)
      rw [heq]
      simpa using hc

  have := hU
  have hVr : IsOpenImmersion ((r ⁻¹ᵁ U).ι ≫ r) := by
    rw [← morphismRestrict_ι]; infer_instance
  have hcomm : (Limits.pullback.fst (r ⁻¹ᵁ U).ι (Limits.pullback.fst (r ≫ g) sp) ≫
      (r ⁻¹ᵁ U).ι ≫ r) ≫ g =
      (Limits.pullback.snd (r ⁻¹ᵁ U).ι (Limits.pullback.fst (r ≫ g) sp) ≫
        Limits.pullback.snd (r ≫ g) sp) ≫ sp := by
    have e1 : Limits.pullback.fst (r ⁻¹ᵁ U).ι (Limits.pullback.fst (r ≫ g) sp) ≫ (r ⁻¹ᵁ U).ι =
        Limits.pullback.snd (r ⁻¹ᵁ U).ι (Limits.pullback.fst (r ≫ g) sp) ≫
          Limits.pullback.fst (r ≫ g) sp := Limits.pullback.condition
    have e2 : Limits.pullback.fst (r ≫ g) sp ≫ (r ≫ g) =
        Limits.pullback.snd (r ≫ g) sp ≫ sp := Limits.pullback.condition
    calc (Limits.pullback.fst (r ⁻¹ᵁ U).ι (Limits.pullback.fst (r ≫ g) sp) ≫
          (r ⁻¹ᵁ U).ι ≫ r) ≫ g
        = (Limits.pullback.fst (r ⁻¹ᵁ U).ι (Limits.pullback.fst (r ≫ g) sp) ≫
          (r ⁻¹ᵁ U).ι) ≫ (r ≫ g) := by simp only [Category.assoc]
      _ = Limits.pullback.snd (r ⁻¹ᵁ U).ι (Limits.pullback.fst (r ≫ g) sp) ≫
          (Limits.pullback.fst (r ≫ g) sp ≫ (r ≫ g)) := by rw [e1, Category.assoc]
      _ = _ := by rw [e2, Category.assoc]
  let j₁ := Limits.pullback.lift _ _ hcomm
  have hj₁snd : j₁ ≫ Limits.pullback.snd g sp =
      Limits.pullback.snd (r ⁻¹ᵁ U).ι (Limits.pullback.fst (r ≫ g) sp) ≫
        Limits.pullback.snd (r ≫ g) sp := Limits.pullback.lift_snd _ _ _
  have hj₁fst : j₁ ≫ Limits.pullback.fst g sp =
      Limits.pullback.fst (r ⁻¹ᵁ U).ι (Limits.pullback.fst (r ≫ g) sp) ≫
        (r ⁻¹ᵁ U).ι ≫ r := Limits.pullback.lift_fst _ _ _
  have hsq : IsPullback (Limits.pullback.fst (r ⁻¹ᵁ U).ι (Limits.pullback.fst (r ≫ g) sp))
      j₁ ((r ⁻¹ᵁ U).ι ≫ r) (Limits.pullback.fst g sp) := by
    refine IsPullback.of_bot (v₂₁ := Limits.pullback.snd g sp) (v₂₂ := g) (h₃₁ := sp) ?_
      hj₁fst.symm (IsPullback.of_hasPullback g sp)
    rw [hj₁snd, Category.assoc]
    exact (IsPullback.of_hasPullback (r ⁻¹ᵁ U).ι (Limits.pullback.fst (r ≫ g) sp)).paste_vert
      (IsPullback.of_hasPullback (r ≫ g) sp)
  have hj₁ : IsOpenImmersion j₁ :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hsq hVr

  have hw' : Limits.pullback.fst (r ≫ g) sp w ∈ r ⁻¹ᵁ U := hw
  obtain ⟨z, -, hz⟩ := Scheme.Pullback.exists_preimage_pullback
    (f := (r ⁻¹ᵁ U).ι) (g := Limits.pullback.fst (r ≫ g) sp) ⟨_, hw'⟩ w rfl
  subst hz

  have h := hNS (j₁ z)
  unfold wcpaDjMsFibreNS at h ⊢
  rcases h with hs | hn
  · left
    have h1 := hsm_fwd j₁ (Limits.pullback.snd g sp) z hs
    rw [hj₁snd] at h1
    exact hsm_bwd _ (Limits.pullback.snd (r ≫ g) sp) z h1
  · right
    have h1 := hnd_fwd j₁ (Limits.pullback.snd g sp) z hn
    rw [hj₁snd] at h1
    exact hnd_bwd _ (Limits.pullback.snd (r ≫ g) sp) z h1

theorem wcpa_dj_nc_ofIdealTop_comap : ∀ (R : CommRingCat.{u}) (Y Y' : Scheme.{u}) (g : Y ⟶ Spec R) (f : Y' ⟶ Y) (t : R), (wcNcPrincipal R Y g t).comap f = wcNcPrincipal R Y' (f ≫ g) t :=
by

  have nat : ∀ (X Y : Scheme.{u}) (h : X ⟶ Y) (U : Y.Opens) (b : Γ(Y, ⊤)),
      (h.app U).hom ((Y.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom b) =
        (X.presheaf.map (homOfLE (le_top : h ⁻¹ᵁ U ≤ ⊤)).op).hom (h.appTop.hom b) := by
    intro X Y h U b
    exact congrArg (fun φ => φ.hom b) (h.naturality (homOfLE (le_top : U ≤ ⊤)).op)

  have key : ∀ (X : Scheme.{u}) (s : Γ(X, ⊤)),
      (Scheme.IdealSheafData.ofIdealTop (Ideal.span {s})).subschemeι.appTop.hom s = 0 := by
    intro X s
    set J := Scheme.IdealSheafData.ofIdealTop (Ideal.span {s})
    apply J.subscheme.IsSheaf.section_ext
    intro x _
    obtain ⟨W, hW, hxW, -⟩ := exists_isAffineOpen_mem_and_subset (x := J.subschemeι x)
      (U := ⊤) trivial
    refine ⟨J.subschemeι ⁻¹ᵁ W, le_top, hxW, ?_⟩
    rw [map_zero]
    have h1 := nat _ _ J.subschemeι W s
    rw [← h1]
    rw [← RingHom.mem_ker, J.ker_subschemeι_app ⟨W, hW⟩, Scheme.IdealSheafData.ofIdealTop_ideal]
    exact Ideal.mem_map_of_mem _ (Ideal.mem_span_singleton_self s)
  intro R Y Y' g f t
  unfold wcNcPrincipal
  set a := g.appTop.hom ((Scheme.ΓSpecIso R).inv.hom t)
  have hb : (f ≫ g).appTop.hom ((Scheme.ΓSpecIso R).inv.hom t) = f.appTop.hom a := rfl
  rw [hb]
  set b := f.appTop.hom a
  set I := Scheme.IdealSheafData.ofIdealTop (Ideal.span {a}) with hI
  set I' := Scheme.IdealSheafData.ofIdealTop (Ideal.span {b}) with hI'
  apply le_antisymm
  · apply (Scheme.IdealSheafData.le_map_iff_comap_le).mp
    show _ ≤ Scheme.Hom.ker _
    unfold Scheme.Hom.ker
    rw [Scheme.IdealSheafData.le_ofIdeals_iff]
    intro U
    rw [hI, Scheme.IdealSheafData.ofIdealTop_ideal, Ideal.map_span, Set.image_singleton,
      Ideal.span_singleton_le_iff_mem, RingHom.mem_ker, nat]
    have hz : (I'.subschemeι ≫ f).appTop.hom a = 0 := key Y' b
    rw [hz]
    exact map_zero _
  · show _ ≤ Scheme.Hom.ker _
    unfold Scheme.Hom.ker
    rw [Scheme.IdealSheafData.le_ofIdeals_iff]
    intro U
    rw [hI', Scheme.IdealSheafData.ofIdealTop_ideal, Ideal.map_span, Set.image_singleton,
      Ideal.span_singleton_le_iff_mem, RingHom.mem_ker, nat]
    have hz : (Limits.pullback.fst f I.subschemeι).appTop.hom b = 0 := by
      calc (Limits.pullback.fst f I.subschemeι).appTop.hom b
          = (Limits.pullback.fst f I.subschemeι ≫ f).appTop.hom a := rfl
        _ = (Limits.pullback.snd f I.subschemeι ≫ I.subschemeι).appTop.hom a := by
          rw [Limits.pullback.condition]
        _ = (Limits.pullback.snd f I.subschemeι).appTop.hom (I.subschemeι.appTop.hom a) := rfl
        _ = 0 := by rw [key Y a]; exact map_zero _
    rw [hz]
    exact map_zero _

theorem wcpa_lfg_localized_flat : ∀ (R A N : Type u) [CommRing R] [CommRing A] [Algebra R A] [AddCommGroup N] [Module A N] [Module R N] [IsScalarTower R A N] (Q : Ideal A) [Q.IsPrime], Module.Flat R N → Module.Flat R (LocalizedModule Q.primeCompl N) :=
by
  intro R A N _ _ _ _ _ _ _ Q _ hN
  rw [Module.Flat.iff_lTensor_preserves_injective_linearMap]
  intro P P' _ _ _ _ f hf
  set S := Q.primeCompl
  set g := LocalizedModule.mkLinearMap S N
  have hP := IsLocalizedModule.rTensor (R := R) A S (N := P) g
  have hP' := IsLocalizedModule.rTensor (R := R) A S (N := P') g
  set gP := TensorProduct.AlgebraTensorModule.rTensor R P g
  set gP' := TensorProduct.AlgebraTensorModule.rTensor R P' g
  set h := TensorProduct.AlgebraTensorModule.lTensor A N f
  have hh : Function.Injective h := by
    have e : (h : TensorProduct R N P → TensorProduct R N P') = LinearMap.lTensor N f := by
      rw [← TensorProduct.AlgebraTensorModule.restrictScalars_lTensor (R := R) (A := A)]
      rfl
    rw [e]
    exact Module.Flat.lTensor_preserves_injective_linearMap f hf
  have hinj := IsLocalizedModule.map_injective S gP gP' h hh
  have heq : IsLocalizedModule.map S gP gP' h =
      TensorProduct.AlgebraTensorModule.lTensor A (LocalizedModule S N) f := by
    apply IsLocalizedModule.linearMap_ext S gP gP'
    rw [IsLocalizedModule.map_comp]
    apply TensorProduct.AlgebraTensorModule.ext
    intro n p
    simp [gP, gP', h]
  have e2 : (LinearMap.lTensor (LocalizedModule S N) f : TensorProduct R (LocalizedModule S N) P → TensorProduct R (LocalizedModule S N) P') =
      TensorProduct.AlgebraTensorModule.lTensor A (LocalizedModule S N) f := by
    rw [← TensorProduct.AlgebraTensorModule.restrictScalars_lTensor (R := R) (A := A)]
    rfl
  rw [e2, ← heq]
  exact hinj

theorem wcpa_lfg_fp_to_fg : ∀ (A : Type u) [CommRing A] (I : Ideal A) (q : Ideal A) [q.IsPrime], Module.FinitePresentation (Localization.AtPrime q) (LocalizedModule q.primeCompl (A ⧸ I)) → (I.map (algebraMap A (Localization.AtPrime q))).FG :=
by
  intro A _ I q _ hfp
  let l : Localization.AtPrime q →ₗ[Localization.AtPrime q] LocalizedModule q.primeCompl (A ⧸ I) :=
    LinearMap.toSpanSingleton (Localization.AtPrime q) (LocalizedModule q.primeCompl (A ⧸ I))
      (LocalizedModule.mk (1 : A ⧸ I) (1 : q.primeCompl))
  have hsm : ∀ (v : q.primeCompl) (b : A), v • (Ideal.Quotient.mk I b) = Ideal.Quotient.mk I ((v : A) * b) := by
    intro v b
    rw [Submonoid.smul_def, Algebra.smul_def, Ideal.Quotient.algebraMap_eq, map_mul]
  have s1 : ∀ (a : A) (s : q.primeCompl), l (Localization.mk a s) =
      LocalizedModule.mk (Ideal.Quotient.mk I a) s := by
    intro a s
    show Localization.mk a s • LocalizedModule.mk (1 : A ⧸ I) (1 : q.primeCompl) = _
    rw [LocalizedModule.mk_smul_mk, mul_one, Algebra.smul_def, Ideal.Quotient.algebraMap_eq,
      mul_one]
  have s2 : Function.Surjective l := by
    intro y
    induction y using LocalizedModule.induction_on with
    | h b s =>
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective b
      exact ⟨Localization.mk a s, s1 a s⟩
  have s3 : (LinearMap.ker l).FG := Module.FinitePresentation.fg_ker l s2
  have s4 : LinearMap.ker l = I.map (algebraMap A (Localization.AtPrime q)) := by
    ext x
    induction x using Localization.induction_on with
    | H p =>
      obtain ⟨a, s⟩ := p
      rw [LinearMap.mem_ker, s1, Localization.mk_eq_mk',
        IsLocalization.mk'_mem_map_algebraMap_iff q.primeCompl, ← LocalizedModule.zero_mk s,
        LocalizedModule.mk_eq]
      simp only [smul_zero, hsm, Ideal.Quotient.eq_zero_iff_mem]
      constructor
      · rintro ⟨u, hu⟩
        refine ⟨(u : A) * s, (u * s).2, ?_⟩
        rw [mul_assoc]
        exact hu
      · rintro ⟨t, ht, hta⟩
        refine ⟨⟨t, ht⟩, ?_⟩
        show t * ((s : A) * a) ∈ I
        rw [mul_left_comm]
        exact I.mul_mem_left _ hta
  rw [← s4]
  exact s3

theorem wcpa_lfg_localize_base : (∀ (R A N : Type u) [CommRing R] [IsLocalRing R] [CommRing A] [Algebra R A] [Algebra.FinitePresentation R A] [AddCommGroup N] [Module A N] [Module R N] [IsScalarTower R A N] [Module.Finite A N] (Q : Ideal A) [Q.IsPrime], Q.comap (algebraMap R A) = IsLocalRing.maximalIdeal R → Module.Flat R (LocalizedModule Q.primeCompl N) → Module.FinitePresentation (Localization.AtPrime Q) (LocalizedModule Q.primeCompl N)) → ∀ (R A N : Type u) [CommRing R] [CommRing A] [Algebra R A] [Algebra.FinitePresentation R A] [AddCommGroup N] [Module A N] [Module R N] [IsScalarTower R A N] [Module.Finite A N] (Q : Ideal A) [Q.IsPrime], Module.Flat R (LocalizedModule Q.primeCompl N) → Module.FinitePresentation (Localization.AtPrime Q) (LocalizedModule Q.primeCompl N) :=
by

  have s1 : ∀ (R A : Type u) [CommRing R] [CommRing A] [Algebra R A]
      [Algebra.FinitePresentation R A] (p : Ideal R) [p.IsPrime],
      Algebra.FinitePresentation (Localization.AtPrime p)
        (Localization (Algebra.algebraMapSubmonoid A p.primeCompl)) := by
    intro R A _ _ _ _ p _
    haveI := (Algebra.isPushout_of_isLocalization p.primeCompl (Localization.AtPrime p) A
      (Localization (Algebra.algebraMapSubmonoid A p.primeCompl))).symm
    exact Algebra.FinitePresentation.equiv (Algebra.IsPushout.equiv R (Localization.AtPrime p) A _)

  have s2 : ∀ (R A : Type u) [CommRing R] [CommRing A] [Algebra R A] (Q : Ideal A) [Q.IsPrime]
      (p : Ideal R) [p.IsPrime], Q.comap (algebraMap R A) = p →
      (Q.map (algebraMap A (Localization (Algebra.algebraMapSubmonoid A p.primeCompl)))).IsPrime ∧
      (Q.map (algebraMap A (Localization (Algebra.algebraMapSubmonoid A p.primeCompl)))).comap
        (algebraMap A (Localization (Algebra.algebraMapSubmonoid A p.primeCompl))) = Q ∧
      (Q.map (algebraMap A (Localization (Algebra.algebraMapSubmonoid A p.primeCompl)))).comap
        (algebraMap (Localization.AtPrime p)
          (Localization (Algebra.algebraMapSubmonoid A p.primeCompl))) =
        IsLocalRing.maximalIdeal (Localization.AtPrime p) := by
    intro R A _ _ _ Q _ p _ hp
    subst hp
    have hdisj : Disjoint ((Algebra.algebraMapSubmonoid A (Q.comap (algebraMap R A)).primeCompl :
        Submonoid A) : Set A) (Q : Set A) := by
      rw [Set.disjoint_left]
      rintro _ ⟨s, hs, rfl⟩ hsQ
      exact hs hsQ
    have hprime := IsLocalization.isPrime_of_isPrime_disjoint
      (Algebra.algebraMapSubmonoid A (Q.comap (algebraMap R A)).primeCompl)
      (Localization (Algebra.algebraMapSubmonoid A (Q.comap (algebraMap R A)).primeCompl)) Q ‹_› hdisj
    have hcomap : (Q.map (algebraMap A (Localization (Algebra.algebraMapSubmonoid A
        (Q.comap (algebraMap R A)).primeCompl)))).comap (algebraMap A (Localization
        (Algebra.algebraMapSubmonoid A (Q.comap (algebraMap R A)).primeCompl))) = Q :=
      IsLocalization.under_map_of_isPrime_disjoint
        (Algebra.algebraMapSubmonoid A (Q.comap (algebraMap R A)).primeCompl)
        (Localization (Algebra.algebraMapSubmonoid A (Q.comap (algebraMap R A)).primeCompl))
        (I := Q) ‹_› hdisj
    refine ⟨hprime, hcomap, ?_⟩
    have hJ : ((Q.map (algebraMap A (Localization (Algebra.algebraMapSubmonoid A
        (Q.comap (algebraMap R A)).primeCompl)))).comap
        (algebraMap (Localization.AtPrime (Q.comap (algebraMap R A)))
          (Localization (Algebra.algebraMapSubmonoid A (Q.comap (algebraMap R A)).primeCompl)))).comap
          (algebraMap R (Localization.AtPrime (Q.comap (algebraMap R A)))) =
          Q.comap (algebraMap R A) := by
      rw [Ideal.comap_comap, ← IsScalarTower.algebraMap_eq,
        IsScalarTower.algebraMap_eq R A (Localization (Algebra.algebraMapSubmonoid A
          (Q.comap (algebraMap R A)).primeCompl)),
        ← Ideal.comap_comap, hcomap]
    have hmc := IsLocalization.map_under (Q.comap (algebraMap R A)).primeCompl
      (Localization.AtPrime (Q.comap (algebraMap R A)))
      ((Q.map (algebraMap A (Localization (Algebra.algebraMapSubmonoid A
        (Q.comap (algebraMap R A)).primeCompl)))).comap
        (algebraMap (Localization.AtPrime (Q.comap (algebraMap R A)))
          (Localization (Algebra.algebraMapSubmonoid A (Q.comap (algebraMap R A)).primeCompl))))
    rw [Ideal.under_def, hJ, Localization.AtPrime.map_eq_maximalIdeal] at hmc
    exact hmc.symm

  have s3 : ∀ (A N : Type u) [CommRing A] [AddCommGroup N] [Module A N] (T S : Submonoid A)
      (Q' : Ideal (Localization T)) [Q'.IsPrime] [IsLocalization S (Localization.AtPrime Q')],
      IsLocalizedModule S (((LocalizedModule.mkLinearMap Q'.primeCompl
        (LocalizedModule T N)).restrictScalars A).comp (LocalizedModule.mkLinearMap T N)) := by
    intro A N _ _ _ T S Q' _ _
    have h1 : IsBaseChange (Localization T) (LocalizedModule.mkLinearMap T N) :=
      (isLocalizedModule_iff_isBaseChange T (Localization T) _).mp inferInstance
    have h2 : IsBaseChange (Localization.AtPrime Q')
        (LocalizedModule.mkLinearMap Q'.primeCompl (LocalizedModule T N)) :=
      (isLocalizedModule_iff_isBaseChange Q'.primeCompl (Localization.AtPrime Q') _).mp
        inferInstance
    exact (isLocalizedModule_iff_isBaseChange S (Localization.AtPrime Q') _).mpr (h1.comp h2)

  have s4 : ∀ (A : Type u) [CommRing A] (S : Submonoid A) (B₁ B₂ M₁ M₂ : Type u) [CommRing B₁]
      [CommRing B₂] [Algebra A B₁] [Algebra A B₂] [IsLocalization S B₁] [IsLocalization S B₂]
      [AddCommGroup M₁] [AddCommGroup M₂] [Module A M₁] [Module A M₂] [Module B₁ M₁]
      [Module B₂ M₂] [IsScalarTower A B₁ M₁] [IsScalarTower A B₂ M₂], (M₁ ≃ₗ[A] M₂) →
      Module.FinitePresentation B₁ M₁ → Module.FinitePresentation B₂ M₂ := by
    intro A _ S B₁ B₂ M₁ M₂ _ _ _ _ _ _ _ _ _ _ _ _ _ _ e h
    let φ : B₁ ≃ₐ[A] B₂ := IsLocalization.algEquiv S B₁ B₂
    have hinj : ∀ (s : S) (x y : M₂), (s : A) • x = (s : A) • y → x = y := by
      intro s x y hxy
      obtain ⟨v, hv⟩ := IsLocalization.map_units B₂ s
      have h1 : (algebraMap A B₂ s) • x = (algebraMap A B₂ s) • y := by
        rw [algebraMap_smul, algebraMap_smul]; exact hxy
      rw [← hv] at h1
      have h2 := congrArg (fun z => ((v⁻¹ : B₂ˣ) : B₂) • z) h1
      simpa [smul_smul] using h2
    have hsemi : ∀ (b : B₁) (m : M₁), e (b • m) = φ b • e m := by
      intro b m
      obtain ⟨⟨a, s⟩, hb⟩ := IsLocalization.surj S b
      apply hinj s
      have h1 : (s : A) • (b • m) = a • m := by
        rw [← algebraMap_smul B₁ (s : A) (b • m), smul_smul, mul_comm, hb, algebraMap_smul]
      have h2 : φ b * algebraMap A B₂ s = algebraMap A B₂ a := by
        rw [← φ.commutes, ← φ.commutes, ← map_mul, hb]
      rw [← e.map_smul, h1, e.map_smul, ← algebraMap_smul B₂ (s : A) (φ b • e m), smul_smul,
        mul_comm, h2, algebraMap_smul]
    letI : Algebra B₁ B₂ := φ.toRingHom.toAlgebra
    letI : Module B₁ M₂ := Module.compHom M₂ (algebraMap B₁ B₂)
    haveI : IsScalarTower B₁ B₂ M₂ :=
      IsScalarTower.of_algebraMap_smul (R := B₁) (A := B₂) (M := M₂) (fun _ _ => rfl)
    let e' : M₁ ≃ₗ[B₁] M₂ :=
      { toFun := e
        invFun := e.symm
        map_add' := e.map_add
        map_smul' := fun b m => hsemi b m
        left_inv := e.left_inv
        right_inv := e.right_inv }
    haveI : Module.FinitePresentation B₁ M₂ := Module.FinitePresentation.of_equiv e'
    haveI : IsLocalization (⊥ : Submonoid B₁) B₁ := IsLocalization.of_le_isUnit (by simp)
    haveI : IsLocalization (⊥ : Submonoid B₁) B₂ :=
      IsLocalization.isLocalization_of_algEquiv (⊥ : Submonoid B₁)
        (AlgEquiv.ofRingEquiv (f := φ.toRingEquiv) (fun _ => rfl))
    have hbc : IsBaseChange B₂ (LinearMap.id : M₂ →ₗ[B₁] M₂) :=
      (isLocalizedModule_iff_isBaseChange (⊥ : Submonoid B₁) B₂ LinearMap.id).mp
        (isLocalizedModule_id (⊥ : Submonoid B₁) M₂ B₂)
    exact FinitePresentation.of_isBaseChange (R := B₁) LinearMap.id hbc

  have s5 : ∀ (R A : Type u) [CommRing R] [CommRing A] [Algebra R A] (p : Ideal R) [p.IsPrime]
      (M₁ M₂ : Type u) [AddCommGroup M₁] [AddCommGroup M₂] [Module A M₁] [Module A M₂]
      [Module R M₁] [IsScalarTower R A M₁] [Module (Localization.AtPrime p) M₂],
      (∀ (r : R) (x : M₂), algebraMap R (Localization.AtPrime p) r • x = algebraMap R A r • x) →
      (M₁ ≃ₗ[A] M₂) → Module.Flat R M₁ → Module.Flat (Localization.AtPrime p) M₂ := by
    intro R A _ _ _ p _ M₁ M₂ _ _ _ _ _ _ _ hc e hfl
    letI : Module R M₂ := Module.compHom M₂ (algebraMap R (Localization.AtPrime p))
    haveI : IsScalarTower R (Localization.AtPrime p) M₂ :=
      IsScalarTower.of_algebraMap_smul (R := R) (A := Localization.AtPrime p) (M := M₂)
        (fun _ _ => rfl)
    let eR : M₁ ≃ₗ[R] M₂ :=
      { toFun := e
        invFun := e.symm
        map_add' := e.map_add
        map_smul' := fun r x => by
          show e (r • x) = algebraMap R (Localization.AtPrime p) r • e x
          rw [hc, ← e.map_smul, algebraMap_smul]
        left_inv := e.left_inv
        right_inv := e.right_inv }
    haveI : Module.Flat R M₂ := Module.Flat.of_linearEquiv eR.symm
    haveI : IsLocalizedModule p.primeCompl (LinearMap.id : M₂ →ₗ[R] M₂) :=
      isLocalizedModule_id p.primeCompl M₂ (Localization.AtPrime p)
    exact Module.Flat.of_isLocalizedModule (Localization.AtPrime p) p.primeCompl
      (LinearMap.id : M₂ →ₗ[R] M₂)

  intro hloc R A N _ _ _ _ _ _ _ _ _ Q _ hfl
  obtain ⟨p, hp⟩ : ∃ p : Ideal R, Q.comap (algebraMap R A) = p := ⟨_, rfl⟩
  haveI : p.IsPrime := hp ▸ Ideal.IsPrime.comap (algebraMap R A)
  haveI : Algebra.FinitePresentation (Localization.AtPrime p)
      (Localization (Algebra.algebraMapSubmonoid A p.primeCompl)) := s1 R A p
  obtain ⟨hQ'prime, hQ'A, hQ'Rp⟩ := s2 R A Q p hp
  haveI := hQ'prime
  letI : Module (Localization.AtPrime p)
      (LocalizedModule (Algebra.algebraMapSubmonoid A p.primeCompl) N) :=
    Module.compHom _ (algebraMap (Localization.AtPrime p)
      (Localization (Algebra.algebraMapSubmonoid A p.primeCompl)))
  haveI : IsScalarTower (Localization.AtPrime p)
      (Localization (Algebra.algebraMapSubmonoid A p.primeCompl))
      (LocalizedModule (Algebra.algebraMapSubmonoid A p.primeCompl) N) :=
    IsScalarTower.of_algebraMap_smul (R := Localization.AtPrime p)
      (A := Localization (Algebra.algebraMapSubmonoid A p.primeCompl))
      (M := LocalizedModule (Algebra.algebraMapSubmonoid A p.primeCompl) N) (fun _ _ => rfl)

  have hloc2 := IsLocalization.isLocalization_isLocalization_atPrime_isLocalization
    (Algebra.algebraMapSubmonoid A p.primeCompl)
    (Localization.AtPrime (Q.map (algebraMap A
      (Localization (Algebra.algebraMapSubmonoid A p.primeCompl)))))
    (Q.map (algebraMap A (Localization (Algebra.algebraMapSubmonoid A p.primeCompl))))
  have hS : (Ideal.comap (algebraMap A (Localization (Algebra.algebraMapSubmonoid A p.primeCompl)))
      (Q.map (algebraMap A (Localization (Algebra.algebraMapSubmonoid A p.primeCompl))))).primeCompl
      = Q.primeCompl := by
    ext x
    exact Iff.of_eq (congrArg (fun I : Ideal A => x ∉ I) hQ'A)
  haveI : IsLocalization Q.primeCompl (Localization.AtPrime (Q.map (algebraMap A
      (Localization (Algebra.algebraMapSubmonoid A p.primeCompl))))) := by
    have h := hloc2
    unfold IsLocalization.AtPrime at h
    rw [hS] at h
    exact h
  have hL := s3 A N (Algebra.algebraMapSubmonoid A p.primeCompl) Q.primeCompl
    (Q.map (algebraMap A (Localization (Algebra.algebraMapSubmonoid A p.primeCompl))))
  let e := IsLocalizedModule.iso Q.primeCompl (((LocalizedModule.mkLinearMap
    (Q.map (algebraMap A (Localization (Algebra.algebraMapSubmonoid A p.primeCompl)))).primeCompl
    (LocalizedModule (Algebra.algebraMapSubmonoid A p.primeCompl) N)).restrictScalars A).comp
    (LocalizedModule.mkLinearMap (Algebra.algebraMapSubmonoid A p.primeCompl) N))
  have hflM := s5 R A p (LocalizedModule Q.primeCompl N)
    (LocalizedModule (Q.map (algebraMap A
      (Localization (Algebra.algebraMapSubmonoid A p.primeCompl)))).primeCompl
      (LocalizedModule (Algebra.algebraMapSubmonoid A p.primeCompl) N))
    (fun r x => by
      rw [← algebraMap_smul (Localization (Algebra.algebraMapSubmonoid A p.primeCompl))
          (algebraMap R (Localization.AtPrime p) r) x,
        ← IsScalarTower.algebraMap_apply R (Localization.AtPrime p),
        IsScalarTower.algebraMap_apply R A (Localization (Algebra.algebraMapSubmonoid A p.primeCompl)),
        algebraMap_smul])
    e hfl
  have hfp := hloc (Localization.AtPrime p)
    (Localization (Algebra.algebraMapSubmonoid A p.primeCompl))
    (LocalizedModule (Algebra.algebraMapSubmonoid A p.primeCompl) N)
    (Q.map (algebraMap A (Localization (Algebra.algebraMapSubmonoid A p.primeCompl))))
    hQ'Rp hflM
  exact s4 A Q.primeCompl _ (Localization.AtPrime Q) _ (LocalizedModule Q.primeCompl N)
    e.symm hfp

theorem wcpa_lfg_fibre_dim_finite : ∀ (R A : Type u) [CommRing R] [IsLocalRing R] [CommRing A] [Algebra R A] [Algebra.FiniteType R A] (J : Ideal A), Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R) ≤ J → ringKrullDim (A ⧸ J) < ⊤ :=
by
  intro R A _ _ _ _ _ J hJ
  obtain ⟨n, f, hf⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp (inferInstance : Algebra.FiniteType R A)
  set π : A →+* A ⧸ J := Ideal.Quotient.mk J with hπ
  have hker : ∀ a ∈ IsLocalRing.maximalIdeal R, (π.comp (algebraMap R A)) a = 0 := by
    intro a ha
    rw [RingHom.comp_apply, hπ, Ideal.Quotient.eq_zero_iff_mem]
    exact hJ (Ideal.mem_map_of_mem _ ha)
  let κ : IsLocalRing.ResidueField R →+* A ⧸ J :=
    Ideal.Quotient.lift (IsLocalRing.maximalIdeal R) (π.comp (algebraMap R A)) hker
  have hκ : ∀ r : R, κ (IsLocalRing.residue R r) = π (algebraMap R A r) := fun r =>
    Ideal.Quotient.lift_mk _ _ _
  let ψ : MvPolynomial (Fin n) (IsLocalRing.ResidueField R) →+* A ⧸ J :=
    MvPolynomial.eval₂Hom κ (fun i => π (f (MvPolynomial.X i)))
  have hcomp : ψ.comp (MvPolynomial.map (IsLocalRing.residue R)) = π.comp f.toRingHom := by
    apply MvPolynomial.ringHom_ext
    · intro r
      simp only [RingHom.comp_apply, MvPolynomial.map_C, ψ, MvPolynomial.eval₂Hom_C, hκ]
      rw [← MvPolynomial.algebraMap_eq]
      simp
    · intro i
      simp [ψ]
  have hsurj : Function.Surjective ψ := by
    intro y
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨p, rfl⟩ := hf a
    refine ⟨MvPolynomial.map (IsLocalRing.residue R) p, ?_⟩
    have := RingHom.congr_fun hcomp p
    simpa using this
  have h1 := ringKrullDim_le_of_surjective ψ hsurj
  have h2 : ringKrullDim (MvPolynomial (Fin n) (IsLocalRing.ResidueField R)) = (n : WithBot ℕ∞) := by
    rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field]
    simp
  refine lt_of_le_of_lt (h1.trans h2.le) ?_
  rw [← WithBot.coe_natCast, ← WithBot.coe_top]
  exact WithBot.coe_lt_coe.mpr (ENat.natCast_lt_top n)

theorem wcpa_lfg_els_np_refined_normalization : ∀ (k : Type u) [Field k] (n : ℕ) (𝔮 : Ideal (MvPolynomial (Fin n) k)) [𝔮.IsPrime], ∃ (m : ℕ) (φ : MvPolynomial (Fin n) k →ₐ[k] MvPolynomial (Fin n) k), φ.Finite ∧ Ideal.comap φ 𝔮 = Ideal.span ((fun i => MvPolynomial.X i) '' {i : Fin n | i.val < m}) :=
by
  open MvPolynomial in
  · intro k _
    classical



    have nagata : ∀ (N : ℕ) (f : MvPolynomial (Fin (N+1)) k), f ≠ 0 →
        ∃ T : MvPolynomial (Fin (N+1)) k ≃ₐ[k] MvPolynomial (Fin (N+1)) k,
          IsUnit (MvPolynomial.finSuccEquiv k N (T f)).leadingCoeff := by
      intro N f hf
      run_tac do
        let pre : Lean.Name := .str (.num (.str (.str (.str (.str .anonymous "_private")
          "Mathlib") "RingTheory") "NoetherNormalization") 0) "NoetherNormalization"
        let g ← Lean.Elab.Tactic.getMainGoal
        g.withContext do
          let some fd := (← Lean.getLCtx).findFromUserName? `f | throwError "no f"
          let some hd := (← Lean.getLCtx).findFromUserName? `hf | throwError "no hf"
          let Tf ← Lean.Meta.mkAppM (.str pre "T") #[fd.toExpr]
          let pf ← Lean.Meta.mkAppM (.str pre "T_leadingcoeff_isUnit") #[fd.toExpr, hd.toExpr]
          let gty ← Lean.instantiateMVars (← g.getType)
          let pred := gty.appArg!
          let e ← Lean.Meta.mkAppOptM ``Exists.intro #[none, some pred, some Tf, some pf]
          g.assign e
          Lean.Elab.Tactic.replaceMainGoal []

    have s2 : ∀ (N : ℕ) (φ : MvPolynomial (Fin N) k →ₐ[k] MvPolynomial (Fin N) k),
        (∀ i, φ.toRingHom.IsIntegralElem (X i)) → φ.Finite := by
      intro N φ hX
      have hall : ∀ h, φ.toRingHom.IsIntegralElem h := by
        intro h
        refine MvPolynomial.induction_on h ?_ ?_ ?_
        · intro a
          have e : (C a : MvPolynomial (Fin N) k) = φ.toRingHom (C a) := by
            show C a = φ (C a)
            rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes]
          rw [e]; exact RingHom.isIntegralElem_map _
        · intro p q hp hq; exact RingHom.IsIntegralElem.add _ hp hq
        · intro p i hp; exact RingHom.IsIntegralElem.mul _ hp (hX i)
      have hft : φ.toRingHom.FiniteType := by
        have h1 : (algebraMap k (MvPolynomial (Fin N) k)).FiniteType :=
          RingHom.finiteType_algebraMap.mpr inferInstance
        have h2 : algebraMap k (MvPolynomial (Fin N) k) = φ.toRingHom.comp (algebraMap k _) :=
          RingHom.ext fun a => (φ.commutes a).symm
        rw [h2] at h1
        exact RingHom.FiniteType.of_comp_finiteType h1
      exact RingHom.IsIntegral.to_finite hall hft

    have hbot : ∀ (N : ℕ) (𝔮 : Ideal (MvPolynomial (Fin N) k)), 𝔮 = ⊥ →
        ∃ (m : ℕ) (φ : MvPolynomial (Fin N) k →ₐ[k] MvPolynomial (Fin N) k), φ.Finite ∧
          Ideal.comap φ 𝔮 = Ideal.span ((fun i => MvPolynomial.X i) '' {i : Fin N | i.val < m}) := by
      intro N 𝔮 h
      refine ⟨0, AlgHom.id k _, AlgHom.Finite.of_surjective _ (fun x => ⟨x, rfl⟩), ?_⟩
      subst h
      ext x
      simp

    have s45 : ∀ (N m : ℕ) (Q₁ : Ideal (MvPolynomial (Fin (N+1)) k))
        (ψ : MvPolynomial (Fin N) k →ₐ[k] MvPolynomial (Fin N) k),
        ψ.Finite → (X 0 : MvPolynomial (Fin (N+1)) k) ∈ Q₁ →
        Ideal.comap ψ (Ideal.comap (rename Fin.succ : MvPolynomial (Fin N) k →ₐ[k]
          MvPolynomial (Fin (N+1)) k) Q₁) =
          Ideal.span ((fun i => (X i : MvPolynomial (Fin N) k)) '' {i : Fin N | i.val < m}) →
        ∃ φ : MvPolynomial (Fin (N+1)) k →ₐ[k] MvPolynomial (Fin (N+1)) k, φ.Finite ∧
          Ideal.comap φ Q₁ =
            Ideal.span ((fun i => (X i : MvPolynomial (Fin (N+1)) k)) '' {i : Fin (N+1) | i.val < m + 1}) := by
      intro N m Q₁ ψ hψfin hX0 hψ
      let ι : MvPolynomial (Fin N) k →ₐ[k] MvPolynomial (Fin (N+1)) k := rename Fin.succ
      let φ : MvPolynomial (Fin (N+1)) k →ₐ[k] MvPolynomial (Fin (N+1)) k :=
        aeval (Fin.cons (X 0) (fun j : Fin N => ι (ψ (X j))) : Fin (N+1) → MvPolynomial (Fin (N+1)) k)
      have hφ0 : φ (X 0) = X 0 := by simp [φ]
      have hφs : ∀ j : Fin N, φ (X j.succ) = ι (ψ (X j)) := by intro j; simp [φ]
      have hφι : φ.comp ι = ι.comp ψ := by
        apply MvPolynomial.algHom_ext; intro j
        rw [AlgHom.comp_apply, AlgHom.comp_apply]
        show φ (rename Fin.succ (X j)) = _
        rw [rename_X, hφs]
      refine ⟨φ, ?_, ?_⟩
      · apply s2
        intro i
        induction i using Fin.cases with
        | zero =>
          rw [show (X 0 : MvPolynomial (Fin (N+1)) k) = φ.toRingHom (X 0) from hφ0.symm]
          exact RingHom.isIntegralElem_map _
        | succ j =>
          obtain ⟨p, hpm, hp⟩ := RingHom.IsIntegral.of_finite hψfin (X j)
          refine ⟨p.map ι.toRingHom, hpm.map _, ?_⟩
          rw [Polynomial.eval₂_map]
          have e1 : φ.toRingHom.comp ι.toRingHom = ι.toRingHom.comp ψ.toRingHom :=
            RingHom.ext fun x => AlgHom.congr_fun hφι x
          have e2 : (X j.succ : MvPolynomial (Fin (N+1)) k) = ι.toRingHom (X j) := (rename_X _ _).symm
          rw [e1, e2, ← Polynomial.hom_eval₂, hp, map_zero]
      · let ev : MvPolynomial (Fin (N+1)) k →ₐ[k] MvPolynomial (Fin N) k :=
          aeval (Fin.cons 0 (fun j : Fin N => X j) : Fin (N+1) → MvPolynomial (Fin N) k)
        have hev0 : ev (X 0) = 0 := by simp [ev]
        have hevs : ∀ j : Fin N, ev (X j.succ) = X j := by intro j; simp [ev]
        have F1 : ∀ x, ev (ι x) = x := by
          have : ev.comp ι = AlgHom.id k _ := by
            apply MvPolynomial.algHom_ext; intro j
            rw [AlgHom.comp_apply, AlgHom.id_apply]
            show ev (rename Fin.succ (X j)) = X j
            rw [rename_X, hevs]
          intro x; exact AlgHom.congr_fun this x
        have F2 : ∀ x, x - ι (ev x) ∈ Ideal.span {(X 0 : MvPolynomial (Fin (N+1)) k)} := by
          have : (Ideal.Quotient.mkₐ k (Ideal.span {(X 0 : MvPolynomial (Fin (N+1)) k)})).comp
              (ι.comp ev) = Ideal.Quotient.mkₐ k _ := by
            apply MvPolynomial.algHom_ext; intro i
            induction i using Fin.cases with
            | zero =>
              rw [AlgHom.comp_apply, AlgHom.comp_apply, hev0, map_zero, map_zero,
                Ideal.Quotient.mkₐ_eq_mk]
              exact (Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)).symm
            | succ j =>
              rw [AlgHom.comp_apply, AlgHom.comp_apply, hevs]
              show (Ideal.Quotient.mkₐ k _) (rename Fin.succ (X j)) = _
              rw [rename_X]
          intro x
          have h1 := AlgHom.congr_fun this x
          rw [AlgHom.comp_apply, AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] at h1
          rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, h1, sub_self]
        have F3 : ∀ x, ev (φ x) = ψ (ev x) := by
          have : ev.comp φ = ψ.comp ev := by
            apply MvPolynomial.algHom_ext; intro i
            induction i using Fin.cases with
            | zero => rw [AlgHom.comp_apply, AlgHom.comp_apply, hφ0, hev0, map_zero]
            | succ j => rw [AlgHom.comp_apply, AlgHom.comp_apply, hφs, F1, hevs]
          intro x; exact AlgHom.congr_fun this x
        have F4 : ∀ x, ev x ∈ Ideal.span ((fun i => (X i : MvPolynomial (Fin N) k)) '' {i : Fin N | i.val < m}) ↔
            x ∈ Ideal.span ((fun i => (X i : MvPolynomial (Fin (N+1)) k)) '' {i : Fin (N+1) | i.val < m + 1}) := by
          intro x
          constructor
          · intro hx
            have h0 : (X 0 : MvPolynomial (Fin (N+1)) k) ∈ Ideal.span ((fun i => (X i : MvPolynomial (Fin (N+1)) k)) '' {i : Fin (N+1) | i.val < m + 1}) :=
              Ideal.subset_span ⟨0, by simp, rfl⟩
            have ha := (Ideal.span_singleton_le_iff_mem _).mpr h0 (F2 x)
            have hle : Ideal.span ((fun i => (X i : MvPolynomial (Fin N) k)) '' {i : Fin N | i.val < m}) ≤
                Ideal.comap ι (Ideal.span ((fun i => (X i : MvPolynomial (Fin (N+1)) k)) '' {i : Fin (N+1) | i.val < m + 1})) := by
              rw [Ideal.span_le]
              rintro _ ⟨j, hj, rfl⟩
              rw [SetLike.mem_coe, Ideal.mem_comap]; show rename Fin.succ (X j) ∈ _
              rw [rename_X]
              refine Ideal.subset_span ⟨j.succ, ?_, rfl⟩
              simp only [Set.mem_setOf_eq, Fin.val_succ] at hj ⊢
              omega
            have hb := Ideal.mem_comap.mp (hle hx)
            have := Ideal.add_mem _ ha hb
            rwa [sub_add_cancel] at this
          · intro hx
            have hle : Ideal.span ((fun i => (X i : MvPolynomial (Fin (N+1)) k)) '' {i : Fin (N+1) | i.val < m + 1}) ≤
                Ideal.comap ev (Ideal.span ((fun i => (X i : MvPolynomial (Fin N) k)) '' {i : Fin N | i.val < m})) := by
              rw [Ideal.span_le]
              rintro _ ⟨i, hi, rfl⟩
              induction i using Fin.cases with
              | zero =>
                rw [SetLike.mem_coe, Ideal.mem_comap]; show ev (X 0) ∈ _
                rw [hev0]; exact Ideal.zero_mem _
              | succ j =>
                rw [SetLike.mem_coe, Ideal.mem_comap]; show ev (X j.succ) ∈ _
                rw [hevs]
                refine Ideal.subset_span ⟨j, ?_, rfl⟩
                simp only [Set.mem_setOf_eq, Fin.val_succ] at hi ⊢
                omega
            exact hle hx
        ext x
        rw [Ideal.mem_comap, ← F4]
        have hsub : Ideal.span {(X 0 : MvPolynomial (Fin (N+1)) k)} ≤ Q₁ :=
          (Ideal.span_singleton_le_iff_mem _).mpr hX0
        have step1 : φ x ∈ Q₁ ↔ ι (ev (φ x)) ∈ Q₁ := by
          have hd := hsub (F2 (φ x))
          constructor
          · intro h
            have := Q₁.sub_mem h hd
            rwa [sub_sub_cancel] at this
          · intro h
            have := Q₁.add_mem hd h
            rwa [sub_add_cancel] at this
        rw [step1, F3, ← hψ]
        exact Iff.rfl
    intro n
    induction n with
    | zero =>
      intro 𝔮 h𝔮
      apply hbot
      rw [eq_bot_iff]
      intro h hh
      obtain ⟨c, e⟩ : ∃ c : k, h = C c := ⟨_, MvPolynomial.eq_C_of_isEmpty h⟩
      by_cases hc : c = 0
      · rw [Ideal.mem_bot, e, hc, map_zero]
      · exfalso
        have hu : IsUnit (C c : MvPolynomial (Fin 0) k) :=
          (isUnit_iff_ne_zero.mpr hc).map C
        rw [← e] at hu
        exact h𝔮.ne_top (Ideal.eq_top_of_isUnit_mem _ hh hu)
    | succ n ih =>
      intro 𝔮 h𝔮
      by_cases hb : 𝔮 = ⊥
      · exact hbot _ 𝔮 hb
      obtain ⟨f, hf𝔮, hf0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hb
      obtain ⟨T, hT⟩ := nagata n f hf0
      have hg𝔮 : T f ∈ Ideal.comap T.symm 𝔮 := by
        rw [Ideal.mem_comap, AlgEquiv.symm_apply_apply]; exact hf𝔮
      have h𝔮' : (Ideal.comap T.symm 𝔮).IsPrime := Ideal.comap_isPrime _ _
      have hιinj : Function.Injective
          ((rename Fin.succ : MvPolynomial (Fin n) k →ₐ[k] MvPolynomial (Fin (n+1)) k).toRingHom) :=
        rename_injective _ (Fin.succ_injective n)

      have hdeg : 0 < (MvPolynomial.finSuccEquiv k n (T f)).natDegree := by
        by_contra hd
        have hd0 : (MvPolynomial.finSuccEquiv k n (T f)).natDegree = 0 := by omega
        have heq := Polynomial.eq_C_of_natDegree_eq_zero hd0
        have hlc : (MvPolynomial.finSuccEquiv k n (T f)).leadingCoeff =
            (MvPolynomial.finSuccEquiv k n (T f)).coeff 0 := by
          rw [Polynomial.leadingCoeff, hd0]
        rw [hlc] at hT
        have hu : IsUnit (MvPolynomial.finSuccEquiv k n (T f)) := by
          rw [heq]; exact hT.map Polynomial.C
        have hu' : IsUnit (T f) := by
          have := hu.map (MvPolynomial.finSuccEquiv k n).symm
          rwa [AlgEquiv.symm_apply_apply] at this
        exact h𝔮'.ne_top (Ideal.eq_top_of_isUnit_mem _ hg𝔮 hu')

      let μ : MvPolynomial (Fin (n+1)) k →ₐ[k] MvPolynomial (Fin (n+1)) k :=
        aeval (Fin.cons (T f) (fun j : Fin n => (X j.succ : MvPolynomial (Fin (n+1)) k)) :
          Fin (n+1) → MvPolynomial (Fin (n+1)) k)
      have hμ0 : μ (X 0) = T f := by simp [μ]
      have hμs : ∀ j : Fin n, μ (X j.succ) = X j.succ := by intro j; simp [μ]
      have hμι : μ.comp (rename Fin.succ) =
          (rename Fin.succ : MvPolynomial (Fin n) k →ₐ[k] MvPolynomial (Fin (n+1)) k) := by
        apply MvPolynomial.algHom_ext; intro j
        rw [AlgHom.comp_apply, rename_X, hμs]
      have hJ : ∀ h : MvPolynomial (Fin (n+1)) k,
          Polynomial.eval₂ (rename Fin.succ : MvPolynomial (Fin n) k →ₐ[k]
            MvPolynomial (Fin (n+1)) k).toRingHom (X 0) (MvPolynomial.finSuccEquiv k n h) = h := by
        intro h
        have key : (Polynomial.eval₂RingHom (rename Fin.succ : MvPolynomial (Fin n) k →ₐ[k]
            MvPolynomial (Fin (n+1)) k).toRingHom (X 0)).comp
            (MvPolynomial.finSuccEquiv k n).toRingEquiv.toRingHom = RingHom.id _ := by
          apply MvPolynomial.ringHom_ext
          · intro a
            show Polynomial.eval₂ _ (X 0) (MvPolynomial.finSuccEquiv k n (C a)) = C a
            rw [← MvPolynomial.algebraMap_eq, AlgEquiv.commutes, Polynomial.algebraMap_apply,
              Polynomial.eval₂_C]
            exact AlgHom.commutes _ a
          · intro i
            induction i using Fin.cases with
            | zero =>
              show Polynomial.eval₂ _ (X 0) (MvPolynomial.finSuccEquiv k n (X 0)) = X 0
              rw [MvPolynomial.finSuccEquiv_X_zero, Polynomial.eval₂_X]
            | succ j =>
              show Polynomial.eval₂ _ (X 0) (MvPolynomial.finSuccEquiv k n (X j.succ)) = X j.succ
              rw [MvPolynomial.finSuccEquiv_X_succ, Polynomial.eval₂_C]
              exact rename_X _ _
        exact RingHom.congr_fun key h
      have hint0 : μ.toRingHom.IsIntegralElem (X 0) := by
        obtain ⟨u, hu⟩ := hT
        refine ⟨Polynomial.C ((rename Fin.succ : MvPolynomial (Fin n) k →ₐ[k]
            MvPolynomial (Fin (n+1)) k).toRingHom ↑u⁻¹) *
            ((MvPolynomial.finSuccEquiv k n (T f)).map (rename Fin.succ : MvPolynomial (Fin n) k →ₐ[k]
            MvPolynomial (Fin (n+1)) k).toRingHom - Polynomial.C (X 0)), ?_, ?_⟩
        · apply Polynomial.monic_C_mul_of_mul_leadingCoeff_eq_one
          have hlt : (Polynomial.C (X 0 : MvPolynomial (Fin (n+1)) k)).degree <
              ((MvPolynomial.finSuccEquiv k n (T f)).map (rename Fin.succ : MvPolynomial (Fin n) k →ₐ[k]
                MvPolynomial (Fin (n+1)) k).toRingHom).degree := by
            rw [Polynomial.degree_map_eq_of_injective hιinj]
            exact lt_of_le_of_lt Polynomial.degree_C_le (Polynomial.natDegree_pos_iff_degree_pos.mp hdeg)
          rw [Polynomial.leadingCoeff_sub_of_degree_lt hlt,
            Polynomial.leadingCoeff_map_of_injective hιinj, ← hu, ← map_mul, Units.inv_mul, map_one]
        · have hcomp : μ.toRingHom.comp (rename Fin.succ : MvPolynomial (Fin n) k →ₐ[k]
              MvPolynomial (Fin (n+1)) k).toRingHom = (rename Fin.succ : MvPolynomial (Fin n) k →ₐ[k]
              MvPolynomial (Fin (n+1)) k).toRingHom :=
            RingHom.ext fun x => AlgHom.congr_fun hμι x
          have hμ0' : μ.toRingHom (X 0) = T f := hμ0
          rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_sub, Polynomial.eval₂_map,
            Polynomial.eval₂_C, hcomp, hJ, hμ0', sub_self, mul_zero]
      have hμfin : μ.Finite := by
        apply s2
        intro i
        induction i using Fin.cases with
        | zero => exact hint0
        | succ j =>
          rw [show (X j.succ : MvPolynomial (Fin (n+1)) k) = μ.toRingHom (X j.succ) from (hμs j).symm]
          exact RingHom.isIntegralElem_map _

      obtain ⟨Q₁, hQ₁⟩ : ∃ Q : Ideal (MvPolynomial (Fin (n+1)) k),
          Q = Ideal.comap μ (Ideal.comap T.symm 𝔮) := ⟨_, rfl⟩
      haveI : Q₁.IsPrime := by rw [hQ₁]; exact Ideal.comap_isPrime _ _
      have hX0Q : (X 0 : MvPolynomial (Fin (n+1)) k) ∈ Q₁ := by
        rw [hQ₁, Ideal.mem_comap, hμ0]; exact hg𝔮
      haveI : (Ideal.comap (rename Fin.succ : MvPolynomial (Fin n) k →ₐ[k]
          MvPolynomial (Fin (n+1)) k) Q₁).IsPrime := Ideal.comap_isPrime _ _
      obtain ⟨m', ψ, hψfin, hψ⟩ := ih (Ideal.comap (rename Fin.succ : MvPolynomial (Fin n) k →ₐ[k]
          MvPolynomial (Fin (n+1)) k) Q₁)
      obtain ⟨φt, hφtfin, hφt⟩ := s45 n m' Q₁ ψ hψfin hX0Q hψ
      refine ⟨m' + 1, T.symm.toAlgHom.comp (μ.comp φt), ?_, ?_⟩
      · exact AlgHom.Finite.comp (AlgHom.Finite.of_surjective _ T.symm.surjective)
          (AlgHom.Finite.comp hμfin hφtfin)
      · rw [← hφt, hQ₁]
        ext x
        exact Iff.rfl

theorem wcpa_lfg_els_np_alg_closed_residue : ∀ (k : Type u) [Field k] (s m : ℕ) (𝔭 : Ideal (MvPolynomial (Fin s) k)) [𝔭.IsPrime], 𝔭 = Ideal.span ((fun i => MvPolynomial.X i) '' {i : Fin s | i.val < m}) → ∀ z : 𝔭.ResidueField, IsIntegral k z → ∃ c : k, algebraMap k 𝔭.ResidueField c = z :=
by
  intro k _ s m 𝔭 _ h z hz
  classical
  have s2 : ∀ (σ : Type) (d : MvPolynomial σ k), IsIntegral k d → ∃ c : k, MvPolynomial.C c = d := by
    intro σ d hd
    refine ⟨MvPolynomial.constantCoeff d, ?_⟩
    by_contra hne
    have he : IsIntegral k (d - MvPolynomial.C (MvPolynomial.constantCoeff d)) := by
      refine hd.sub ?_
      rw [← MvPolynomial.algebraMap_eq]
      exact isIntegral_algebraMap
    have hne' : d - MvPolynomial.C (MvPolynomial.constantCoeff d) ≠ 0 :=
      sub_ne_zero.mpr (Ne.symm hne)
    have hu := he.isUnit hne'
    obtain ⟨r, hr, hreq⟩ := MvPolynomial.isUnit_iff_eq_C_of_isReduced.mp hu
    have h0 := congrArg MvPolynomial.constantCoeff hreq
    rw [map_sub, MvPolynomial.constantCoeff_C, MvPolynomial.constantCoeff_C, sub_self] at h0
    exact hr.ne_zero h0.symm
  let σ : Type := {j : Fin s // m ≤ j.val}
  let v : Fin s → MvPolynomial σ k := fun i =>
    if hi : m ≤ i.val then MvPolynomial.X ⟨i, hi⟩ else 0
  let ψ : MvPolynomial (Fin s) k →ₐ[k] MvPolynomial σ k := MvPolynomial.aeval v
  let ι : MvPolynomial σ k →ₐ[k] MvPolynomial (Fin s) k := MvPolynomial.rename Subtype.val
  have hker : ∀ f, ψ f = 0 ↔ f ∈ 𝔭 := by
    intro f
    rw [h]
    constructor
    · intro hf
      have key : ∀ f, f - ι (ψ f) ∈
          Ideal.span ((fun i => MvPolynomial.X i) '' {i : Fin s | i.val < m}) := by
        intro f
        induction f using MvPolynomial.induction_on with
        | C a =>
          have : MvPolynomial.C a - ι (ψ (MvPolynomial.C a)) = 0 := by
            rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes, AlgHom.commutes, sub_self]
          rw [this]; exact Ideal.zero_mem _
        | add p q hp hq =>
          have : p + q - ι (ψ (p + q)) = (p - ι (ψ p)) + (q - ι (ψ q)) := by
            rw [map_add, map_add]; ring
          rw [this]; exact Ideal.add_mem _ hp hq
        | mul_X p n hp =>
          by_cases hn : m ≤ n.val
          · have : p * MvPolynomial.X n - ι (ψ (p * MvPolynomial.X n)) =
                (p - ι (ψ p)) * MvPolynomial.X n := by
              rw [map_mul, map_mul]
              have e1 : ψ (MvPolynomial.X n) = MvPolynomial.X ⟨n, hn⟩ := by
                simp only [ψ, MvPolynomial.aeval_X, v, dif_pos hn]
              rw [e1]
              simp only [ι, MvPolynomial.rename_X]
              ring
            rw [this]; exact Ideal.mul_mem_right _ _ hp
          · have : p * MvPolynomial.X n - ι (ψ (p * MvPolynomial.X n)) =
                p * MvPolynomial.X n := by
              rw [map_mul, map_mul]
              have e1 : ψ (MvPolynomial.X n) = 0 := by
                simp only [ψ, MvPolynomial.aeval_X, v, dif_neg hn]
              rw [e1, map_zero, mul_zero, sub_zero]
            rw [this]
            refine Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨n, ?_, rfl⟩)
            simp only [Set.mem_setOf_eq]
            omega
      have := key f
      rwa [hf, map_zero, sub_zero] at this
    · intro hf
      have hle : Ideal.span ((fun i => MvPolynomial.X i) '' {i : Fin s | i.val < m}) ≤
          RingHom.ker (ψ : MvPolynomial (Fin s) k →+* MvPolynomial σ k) := by
        rw [Ideal.span_le]
        rintro _ ⟨i, hi, rfl⟩
        have hi' : ¬ m ≤ i.val := by
          simp only [Set.mem_setOf_eq] at hi
          omega
        simp only [SetLike.mem_coe, RingHom.mem_ker]
        show ψ (MvPolynomial.X i) = 0
        simp only [ψ, MvPolynomial.aeval_X, v, dif_neg hi']
      exact hle hf
  let ψ₀ : MvPolynomial (Fin s) k →ₐ[k] FractionRing (MvPolynomial σ k) :=
    (IsScalarTower.toAlgHom k (MvPolynomial σ k) (FractionRing (MvPolynomial σ k))).comp ψ
  have hψ₀ : ∀ a ∈ 𝔭, ψ₀ a = 0 := by
    intro a ha
    simp only [ψ₀, AlgHom.comp_apply, (hker a).mpr ha, map_zero]
  let g : MvPolynomial (Fin s) k ⧸ 𝔭 →ₐ[k] FractionRing (MvPolynomial σ k) :=
    Ideal.Quotient.liftₐ 𝔭 ψ₀ hψ₀
  have hg : Function.Injective g := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    rw [Ideal.Quotient.eq_zero_iff_mem, ← hker]
    apply IsFractionRing.injective (MvPolynomial σ k) (FractionRing (MvPolynomial σ k))
    rw [map_zero]
    exact hx
  let Φ : 𝔭.ResidueField →ₐ[k] FractionRing (MvPolynomial σ k) :=
    IsFractionRing.liftAlgHom (K := 𝔭.ResidueField) hg
  have hΦinj : Function.Injective Φ := fun a b hab => Φ.toRingHom.injective hab
  have hz1 : IsIntegral k (Φ z) := hz.map Φ
  have hz2 : IsIntegral (MvPolynomial σ k) (Φ z) := hz1.tower_top
  obtain ⟨d, hd⟩ := IsIntegrallyClosed.isIntegral_iff.mp hz2
  have hd1 : IsIntegral k d := by
    have hinj : Function.Injective
        (IsScalarTower.toAlgHom k (MvPolynomial σ k) (FractionRing (MvPolynomial σ k))) :=
      IsFractionRing.injective _ _
    rw [← isIntegral_algHom_iff _ hinj]
    rw [IsScalarTower.coe_toAlgHom', hd]
    exact hz1
  obtain ⟨c, hc⟩ := s2 σ d hd1
  refine ⟨c, hΦinj ?_⟩
  rw [AlgHom.commutes, IsScalarTower.algebraMap_apply k (MvPolynomial σ k)
    (FractionRing (MvPolynomial σ k)), MvPolynomial.algebraMap_eq, hc, hd]

theorem wcpa_lfg_els_noether_point : ∀ (R B : Type u) [CommRing R] [IsLocalRing R] [CommRing B] [Algebra R B] [Algebra.FiniteType R B] (Q : Ideal B) [Q.IsPrime], Q.comap (algebraMap R B) = IsLocalRing.maximalIdeal R → ∃ (s : ℕ) (_ : Algebra (MvPolynomial (Fin s) R) B) (_ : IsScalarTower R (MvPolynomial (Fin s) R) B), (s : WithBot ℕ∞) ≤ ringKrullDim (B ⧸ Ideal.map (algebraMap R B) (IsLocalRing.maximalIdeal R)) ∧ Module.Finite (Q.comap (algebraMap (MvPolynomial (Fin s) R) B)).ResidueField ((Q.comap (algebraMap (MvPolynomial (Fin s) R) B)).Fiber B) ∧ ∀ y : (Q.comap (algebraMap (MvPolynomial (Fin s) R) B)).ResidueField, IsIntegral R y → ∃ r : R, algebraMap R _ r = y :=
by

  have wcpa_lfg_els_np_dim_le_of_integral : ∀ (A B : Type u) [CommRing A] [CommRing B]
      (f : A →+* B), Function.Injective f → f.IsIntegral → ringKrullDim A ≤ ringKrullDim B := by
    intro A B _ _ f hinj hint
    letI := f.toAlgebra
    haveI : Algebra.IsIntegral A B := ⟨hint⟩
    show Order.krullDim (PrimeSpectrum A) ≤ Order.krullDim (PrimeSpectrum B)
    refine iSup_le fun l => ?_
    obtain ⟨P, -, hP, hPu⟩ := Ideal.exists_ideal_over_prime_of_isIntegral
      (RelSeries.head l).asIdeal (⊥ : Ideal B) (by
        intro x hx
        have hx' : f x = 0 := hx
        have : x = 0 := hinj (hx'.trans (map_zero f).symm)
        rw [this]
        exact Ideal.zero_mem _)
    haveI := hP
    haveI : P.LiesOver (RelSeries.head l).asIdeal := ⟨hPu.symm⟩
    obtain ⟨L, hL, -⟩ := Ideal.exists_ltSeries_of_hasGoingUp l P
    calc ((l.length : ℕ∞) : WithBot ℕ∞) = ((L.length : ℕ∞) : WithBot ℕ∞) := by rw [hL]
      _ ≤ _ := Order.LTSeries.length_le_krullDim L

  have wcpa_lfg_els_np_fibre_finite : ∀ (P B : Type u) [CommRing P] [CommRing B] [Algebra P B]
      (𝔮₀ : Ideal P) [𝔮₀.IsPrime] (I : Ideal B), I ≤ Ideal.map (algebraMap P B) 𝔮₀ →
      ((Ideal.Quotient.mk I).comp (algebraMap P B)).Finite →
      Module.Finite 𝔮₀.ResidueField (𝔮₀.Fiber B) := by
    intro P B _ _ _ 𝔮₀ _ I hI hfin
    rw [← Ideal.Quotient.algebraMap_eq] at hfin
    haveI : Module.Finite P (B ⧸ I) := RingHom.finite_algebraMap.mp hfin
    show Module.Finite 𝔮₀.ResidueField (TensorProduct P 𝔮₀.ResidueField B)
    set g : B →ₗ[P] B ⧸ I := (Ideal.Quotient.mkₐ P I).toLinearMap with hg
    have hgs : Function.Surjective g := Ideal.Quotient.mkₐ_surjective P I
    have hex : Function.Exact (I.restrictScalars P).subtype g := by
      intro y
      simp [hg, Ideal.Quotient.eq_zero_iff_mem]
    have hex' := lTensor_exact 𝔮₀.ResidueField hex hgs
    have hzero : ∀ z ∈ Ideal.map (algebraMap P B) 𝔮₀, ∀ (x : 𝔮₀.ResidueField) (b : B),
        x ⊗ₜ[P] (b * z) = 0 := by
      intro z hz
      induction hz using Submodule.span_induction with
      | mem z hz =>
        obtain ⟨q, hq, rfl⟩ := hz
        intro x b
        rw [mul_comm, ← Algebra.smul_def, ← TensorProduct.smul_tmul, Algebra.smul_def,
          (Ideal.algebraMap_residueField_eq_zero).mpr hq, zero_mul, TensorProduct.zero_tmul]
      | zero => intro x b; rw [mul_zero, TensorProduct.tmul_zero]
      | add z w _ _ hz hw => intro x b; rw [mul_add, TensorProduct.tmul_add, hz, hw, add_zero]
      | smul a z _ hz => intro x b; rw [smul_eq_mul, ← mul_assoc]; exact hz x (b * a)
    have hall : ∀ v : TensorProduct P 𝔮₀.ResidueField (I.restrictScalars P),
        (LinearMap.lTensor 𝔮₀.ResidueField (I.restrictScalars P).subtype) v = 0 := by
      intro v
      induction v using TensorProduct.induction_on with
      | zero => simp
      | tmul x i =>
        rw [LinearMap.lTensor_tmul]
        have := hzero i.1 (hI i.2) x 1
        rw [one_mul] at this
        exact this
      | add v w hv hw' =>
        rw [map_add, hv, hw', add_zero]
    have hinj : Function.Injective (g.baseChange 𝔮₀.ResidueField) := by
      rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
      intro w hw
      obtain ⟨v, rfl⟩ := (hex' w).mp hw
      exact hall v
    haveI : Module.Finite 𝔮₀.ResidueField (TensorProduct P 𝔮₀.ResidueField (B ⧸ I)) :=
      Module.Finite.base_change P _ _
    exact Module.Finite.of_injective _ hinj

  have wcpa_lfg_els_np_residue_transfer : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (s : ℕ)
      (𝔮₀ : Ideal (MvPolynomial (Fin s) R)) [𝔮₀.IsPrime]
      (𝔭 : Ideal (MvPolynomial (Fin s) (R ⧸ IsLocalRing.maximalIdeal R))) [𝔭.IsPrime],
      𝔮₀ = 𝔭.comap (MvPolynomial.map (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R))) →
      (∀ z : 𝔭.ResidueField, IsIntegral (R ⧸ IsLocalRing.maximalIdeal R) z →
        ∃ c : R ⧸ IsLocalRing.maximalIdeal R,
          algebraMap (R ⧸ IsLocalRing.maximalIdeal R) 𝔭.ResidueField c = z) →
      ∀ y : 𝔮₀.ResidueField, IsIntegral R y → ∃ r : R, algebraMap R 𝔮₀.ResidueField r = y := by
    intro R _ _ s 𝔮₀ _ 𝔭 _ h hk y hy
    set e := Ideal.ResidueField.map 𝔮₀ 𝔭
      (MvPolynomial.map (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R))) h with he
    have hcomp : ∀ r : R, e (algebraMap R 𝔮₀.ResidueField r) =
        algebraMap (R ⧸ IsLocalRing.maximalIdeal R) 𝔭.ResidueField
          (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R) r) := by
      intro r
      rw [IsScalarTower.algebraMap_apply R (MvPolynomial (Fin s) R) 𝔮₀.ResidueField, he,
        Ideal.ResidueField.map_algebraMap, MvPolynomial.algebraMap_eq, MvPolynomial.map_C,
        IsScalarTower.algebraMap_apply (R ⧸ IsLocalRing.maximalIdeal R)
          (MvPolynomial (Fin s) (R ⧸ IsLocalRing.maximalIdeal R)) 𝔭.ResidueField,
        MvPolynomial.algebraMap_eq]
    have hcompR : (algebraMap (R ⧸ IsLocalRing.maximalIdeal R) 𝔭.ResidueField).comp
        (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R)) =
          e.comp (algebraMap R 𝔮₀.ResidueField) := by
      ext r
      exact (hcomp r).symm
    have hey : IsIntegral (R ⧸ IsLocalRing.maximalIdeal R) (e y) := by
      obtain ⟨p, hpm, hp⟩ := hy
      refine ⟨p.map (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R)), hpm.map _, ?_⟩
      rw [Polynomial.eval₂_map, hcompR, ← Polynomial.hom_eval₂, hp, map_zero]
    obtain ⟨c, hc⟩ := hk (e y) hey
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective c
    refine ⟨r, e.injective ?_⟩
    rw [hcomp, hc]
  intro R B _ _ _ _ _ Q _ hQ
  classical

  letI : Field (R ⧸ IsLocalRing.maximalIdeal R) := Ideal.Quotient.field (IsLocalRing.maximalIdeal R)
  letI : Algebra (R ⧸ IsLocalRing.maximalIdeal R)
      (B ⧸ Ideal.map (algebraMap R B) (IsLocalRing.maximalIdeal R)) :=
    Ideal.Quotient.algebraQuotientMapQuotient
  haveI : Algebra.FiniteType R (B ⧸ Ideal.map (algebraMap R B) (IsLocalRing.maximalIdeal R)) :=
    inferInstance
  haveI : Algebra.FiniteType (R ⧸ IsLocalRing.maximalIdeal R)
      (B ⧸ Ideal.map (algebraMap R B) (IsLocalRing.maximalIdeal R)) :=
    Algebra.FiniteType.of_restrictScalars_finiteType R _ _
  have hmBQ : Ideal.map (algebraMap R B) (IsLocalRing.maximalIdeal R) ≤ Q :=
    Ideal.map_le_iff_le_comap.mpr hQ.ge
  haveI : Nontrivial (B ⧸ Ideal.map (algebraMap R B) (IsLocalRing.maximalIdeal R)) :=
    Ideal.Quotient.nontrivial_iff.mpr (fun h =>
      (inferInstance : Q.IsPrime).ne_top (top_le_iff.mp (h ▸ hmBQ)))
  haveI hQbp : (Q.map (Ideal.Quotient.mk
      (Ideal.map (algebraMap R B) (IsLocalRing.maximalIdeal R)))).IsPrime :=
    Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rw [Ideal.mk_ker]; exact hmBQ)
  have hQbc : (Q.map (Ideal.Quotient.mk
      (Ideal.map (algebraMap R B) (IsLocalRing.maximalIdeal R)))).comap
      (Ideal.Quotient.mk (Ideal.map (algebraMap R B) (IsLocalRing.maximalIdeal R))) = Q := by
    rw [Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker]
    exact sup_eq_left.mpr hmBQ

  obtain ⟨s, φ₀, hφ₀inj, hφ₀fin⟩ := exists_finite_inj_algHom_of_fg (R ⧸ IsLocalRing.maximalIdeal R)
    (B ⧸ Ideal.map (algebraMap R B) (IsLocalRing.maximalIdeal R))

  have hdim : (s : WithBot ℕ∞) ≤
      ringKrullDim (B ⧸ Ideal.map (algebraMap R B) (IsLocalRing.maximalIdeal R)) := by
    have h1 := wcpa_lfg_els_np_dim_le_of_integral _ _ φ₀.toRingHom hφ₀inj
      (RingHom.IsIntegral.of_finite hφ₀fin)
    rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field,
      zero_add] at h1
    simpa using h1

  haveI h𝔮p : ((Q.map (Ideal.Quotient.mk
      (Ideal.map (algebraMap R B) (IsLocalRing.maximalIdeal R)))).comap φ₀).IsPrime :=
    Ideal.comap_isPrime _ _
  obtain ⟨m', φ₁, hφ₁fin, hφ₁⟩ := wcpa_lfg_els_np_refined_normalization
    (R ⧸ IsLocalRing.maximalIdeal R) s ((Q.map (Ideal.Quotient.mk
      (Ideal.map (algebraMap R B) (IsLocalRing.maximalIdeal R)))).comap φ₀)
  have hψfin : (φ₀.comp φ₁).toRingHom.Finite := RingHom.Finite.comp hφ₀fin hφ₁fin
  have hψQ : (Q.map (Ideal.Quotient.mk
      (Ideal.map (algebraMap R B) (IsLocalRing.maximalIdeal R)))).comap (φ₀.comp φ₁).toRingHom =
      Ideal.span ((fun i => MvPolynomial.X i) '' {i : Fin s | i.val < m'}) := by
    rw [← hφ₁]
    ext x
    exact Iff.rfl
  haveI hSp : (Ideal.span ((fun i => MvPolynomial.X i) ''
      {i : Fin s | i.val < m'}) : Ideal (MvPolynomial (Fin s) (R ⧸ IsLocalRing.maximalIdeal R))).IsPrime :=
    hψQ ▸ Ideal.comap_isPrime _ _

  choose b hb using fun i : Fin s =>
    Ideal.Quotient.mk_surjective (I := Ideal.map (algebraMap R B) (IsLocalRing.maximalIdeal R))
      ((φ₀.comp φ₁) (MvPolynomial.X i))
  letI iP : Algebra (MvPolynomial (Fin s) R) B :=
    (MvPolynomial.aeval b : MvPolynomial (Fin s) R →ₐ[R] B).toRingHom.toAlgebra
  haveI hT : IsScalarTower R (MvPolynomial (Fin s) R) B :=
    IsScalarTower.of_algebraMap_eq (fun r =>
      ((MvPolynomial.aeval b : MvPolynomial (Fin s) R →ₐ[R] B).commutes r).symm)
  have hkey : (Ideal.Quotient.mk (Ideal.map (algebraMap R B) (IsLocalRing.maximalIdeal R))).comp
      (algebraMap (MvPolynomial (Fin s) R) B) =
      (φ₀.comp φ₁).toRingHom.comp (MvPolynomial.map (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R))) := by
    apply MvPolynomial.ringHom_ext
    · intro r
      change Ideal.Quotient.mk (Ideal.map (algebraMap R B) (IsLocalRing.maximalIdeal R))
          ((MvPolynomial.aeval b : MvPolynomial (Fin s) R →ₐ[R] B) (MvPolynomial.C r)) =
        (φ₀.comp φ₁) (MvPolynomial.map (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R))
          (MvPolynomial.C r))
      rw [MvPolynomial.aeval_C, MvPolynomial.map_C, ← MvPolynomial.algebraMap_eq,
        AlgHom.commutes, Ideal.Quotient.algebraMap_quotient_map_quotient]
    · intro i
      change Ideal.Quotient.mk (Ideal.map (algebraMap R B) (IsLocalRing.maximalIdeal R))
          ((MvPolynomial.aeval b : MvPolynomial (Fin s) R →ₐ[R] B) (MvPolynomial.X i)) =
        (φ₀.comp φ₁) (MvPolynomial.map (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R))
          (MvPolynomial.X i))
      rw [MvPolynomial.aeval_X, MvPolynomial.map_X, hb i]
  have h𝔮₀ : Q.comap (algebraMap (MvPolynomial (Fin s) R) B) =
      (Ideal.span ((fun i => MvPolynomial.X i) '' {i : Fin s | i.val < m'})).comap
        (MvPolynomial.map (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R))) := by
    conv_lhs => rw [← hQbc]
    rw [Ideal.comap_comap, hkey, ← Ideal.comap_comap, hψQ]
  refine ⟨s, iP, hT, hdim, ?_, ?_⟩
  ·
    apply wcpa_lfg_els_np_fibre_finite _ _ _
      (Ideal.map (algebraMap R B) (IsLocalRing.maximalIdeal R))
    · rw [Ideal.map_le_iff_le_comap]
      intro r hr
      rw [Ideal.mem_comap, IsScalarTower.algebraMap_apply R (MvPolynomial (Fin s) R) B]
      apply Ideal.mem_map_of_mem
      rw [Ideal.mem_comap, ← IsScalarTower.algebraMap_apply]
      rw [← hQ] at hr
      exact hr
    · rw [hkey]
      exact RingHom.Finite.comp hψfin (RingHom.Finite.of_surjective _
        (MvPolynomial.map_surjective _ Ideal.Quotient.mk_surjective))
  ·
    exact wcpa_lfg_els_np_residue_transfer R s _ _ h𝔮₀
      (wcpa_lfg_els_np_alg_closed_residue _ s m' _ rfl)

theorem wcpa_lfg_els_quasifinite_at : ∀ (P B : Type u) [CommRing P] [CommRing B] [Algebra P B] [Algebra.FiniteType P B] (Q : Ideal B) [Q.IsPrime], Module.Finite (Q.comap (algebraMap P B)).ResidueField ((Q.comap (algebraMap P B)).Fiber B) → Algebra.QuasiFiniteAt P Q :=
by
  intro P B _ _ _ _ Q _ hfin
  let q : PrimeSpectrum B := ⟨Q, inferInstance⟩
  let p := q.comap (algebraMap P B)
  let e := PrimeSpectrum.preimageHomeomorphFiber P B p
  haveI : Module.Finite p.asIdeal.ResidueField (p.asIdeal.Fiber B) := hfin
  haveI : Algebra.QuasiFinite p.asIdeal.ResidueField (p.asIdeal.Fiber B) :=
    Algebra.QuasiFinite.instOfFinite
  haveI : Algebra.QuasiFiniteAt p.asIdeal.ResidueField (e ⟨q, rfl⟩).asIdeal :=
    Algebra.QuasiFinite.instLocalization _
  haveI : Q.LiesOver p.asIdeal := ⟨rfl⟩
  exact Algebra.QuasiFiniteAt.of_quasiFiniteAt_residueField (R := P) (S := B) p.asIdeal Q
    (e ⟨q, rfl⟩).asIdeal congr($(e.symm_apply_apply ⟨q, rfl⟩).1.asIdeal)

theorem wcpa_lfg_els_etale_finite_split : ∀ (R P B : Type u) [CommRing R] [CommRing P] [CommRing B] [Algebra R P] [Algebra R B] [Algebra P B] [IsScalarTower R P B] [Algebra.FinitePresentation P B] (Q : Ideal B) [Q.IsPrime] [Algebra.QuasiFiniteAt P Q], (∀ y : (Q.comap (algebraMap P B)).ResidueField, IsIntegral R y → ∃ r : R, algebraMap R _ r = y) → ∃ (T C : Type u) (_ : CommRing T) (_ : Algebra P T) (_ : Algebra.Etale P T) (_ : Algebra R T) (_ : IsScalarTower R P T) (_ : CommRing C) (_ : Algebra T C) (_ : Module.Finite T C) (_ : Algebra.FinitePresentation T C) (_ : Algebra B C) (_ : Module.Flat B C) (_ : Algebra R C) (_ : IsScalarTower R T C) (_ : IsScalarTower R B C) (QC : Ideal C) (_ : QC.IsPrime), QC.comap (algebraMap B C) = Q ∧ (QC.comap (algebraMap T C)).comap (algebraMap P T) = Q.comap (algebraMap P B) ∧ (∀ P'' : Ideal C, P''.IsPrime → P''.comap (algebraMap T C) = QC.comap (algebraMap T C) → P'' = QC) ∧ ∀ x : (QC.comap (algebraMap T C)).ResidueField, IsIntegral R x → ∃ r : R, algebraMap R _ r = x :=
by
  intro R P B _ _ _ _ _ _ _ _ Q _ _ hres
  classical
  haveI hLO : Q.LiesOver (Q.comap (algebraMap P B)) := ⟨rfl⟩
  obtain ⟨T, _, _, hEt, PT, _, _, e, -, P', _, _, hP'Q, he, hbij, hfin, huniq⟩ :=
    Algebra.exists_etale_isIdempotentElem_forall_liesOver_eq (Q.comap (algebraMap P B)) Q

  letI iRT : Algebra R T := ((algebraMap P T).comp (algebraMap R P)).toAlgebra
  haveI hRPT : IsScalarTower R P T := IsScalarTower.of_algebraMap_eq' rfl

  have key : ∀ x : PT.ResidueField, IsIntegral R x → ∃ r : R, algebraMap R _ r = x := by
    intro x hx
    obtain ⟨y, rfl⟩ := hbij.2 x
    have hy : IsIntegral R y :=
      (isIntegral_algHom_iff ((Ideal.ResidueField.mapₐ (Q.comap (algebraMap P B)) PT
        (Algebra.ofId P T) (Ideal.over_def PT _)).restrictScalars R) hbij.1).mp hx
    obtain ⟨r, rfl⟩ := hres y hy
    exact ⟨r, (((Ideal.ResidueField.mapₐ (Q.comap (algebraMap P B)) PT
        (Algebra.ofId P T) (Ideal.over_def PT _)).restrictScalars R).commutes r).symm⟩

  haveI : Algebra.FinitePresentation T (TensorProduct P T B) :=
    Algebra.FinitePresentation.baseChange T
  haveI hfp : Algebra.FinitePresentation T (Localization.Away e) :=
    Algebra.FinitePresentation.of_isLocalizationAway e

  letI iBC : Algebra B (Localization.Away e) :=
    ((algebraMap (TensorProduct P T B) (Localization.Away e)).comp
      (Algebra.TensorProduct.includeRight (R := P) (A := T) (B := B)).toRingHom).toAlgebra
  haveI : Module.Flat P T := Algebra.Smooth.flat P T
  have hflat : Module.Flat B (Localization.Away e) := by
    have h1 : (algebraMap B (TensorProduct P B T)).Flat :=
      RingHom.flat_algebraMap_iff.mpr (Module.Flat.baseChange P B T)
    have h2 : ((Algebra.TensorProduct.comm P B T).toRingEquiv.toRingHom).Flat :=
      RingHom.Flat.of_bijective (Algebra.TensorProduct.comm P B T).bijective
    have h3 : ((Algebra.TensorProduct.comm P B T).toRingEquiv.toRingHom).comp
        (algebraMap B (TensorProduct P B T)) =
        (Algebra.TensorProduct.includeRight (R := P) (A := T) (B := B)).toRingHom := by
      ext b
      simp [Algebra.TensorProduct.algebraMap_apply]
    have h4 : (algebraMap (TensorProduct P T B) (Localization.Away e)).Flat :=
      RingHom.flat_algebraMap_iff.mpr (IsLocalization.flat _ (Submonoid.powers e))
    have h5 : (algebraMap B (Localization.Away e)).Flat := by
      show ((algebraMap (TensorProduct P T B) (Localization.Away e)).comp
        (Algebra.TensorProduct.includeRight (R := P) (A := T) (B := B)).toRingHom).Flat
      rw [← h3]
      exact RingHom.Flat.comp (RingHom.Flat.comp h1 h2) h4
    exact RingHom.flat_algebraMap_iff.mp h5

  letI iRC : Algebra R (Localization.Away e) :=
    ((algebraMap T (Localization.Away e)).comp (algebraMap R T)).toAlgebra
  have hRTC : @IsScalarTower R T (Localization.Away e) Algebra.toSMul Algebra.toSMul
      Algebra.toSMul := IsScalarTower.of_algebraMap_eq' rfl
  have hRBC : @IsScalarTower R B (Localization.Away e) Algebra.toSMul Algebra.toSMul
      Algebra.toSMul := by
    refine IsScalarTower.of_algebraMap_eq (fun r => ?_)
    show algebraMap T (Localization.Away e) (algebraMap P T (algebraMap R P r)) =
      algebraMap (TensorProduct P T B) (Localization.Away e)
        (Algebra.TensorProduct.includeRight (algebraMap R B r))
    rw [IsScalarTower.algebraMap_apply R P B r,
      IsScalarTower.algebraMap_apply T (TensorProduct P T B) (Localization.Away e)]
    congr 1
    rw [Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.algebraMap_apply,
      Algebra.algebraMap_self, RingHom.id_apply, Algebra.TensorProduct.tmul_one_eq_one_tmul]

  have hdisj : Disjoint (Submonoid.powers e : Set (TensorProduct P T B)) (P' : Set _) := by
    rw [Set.disjoint_left]
    intro x hx hxP
    obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hx
    exact he (‹P'.IsPrime›.mem_of_pow_mem n hxP)
  haveI hQCp : (P'.map (algebraMap (TensorProduct P T B) (Localization.Away e))).IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers e) _ P' ‹_› hdisj
  have hQA : (P'.map (algebraMap (TensorProduct P T B) (Localization.Away e))).comap
      (algebraMap (TensorProduct P T B) (Localization.Away e)) = P' :=
    IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers e) _ ‹_› hdisj
  have hPT : PT = P'.comap (algebraMap T (TensorProduct P T B)) := Ideal.over_def P' PT
  have hp : Q.comap (algebraMap P B) = PT.comap (algebraMap P T) := Ideal.over_def PT _
  have hQT : (P'.map (algebraMap (TensorProduct P T B) (Localization.Away e))).comap
      (algebraMap T (Localization.Away e)) = PT := by
    rw [IsScalarTower.algebraMap_eq T (TensorProduct P T B) (Localization.Away e),
      ← Ideal.comap_comap, hQA, hPT]
  refine ⟨T, Localization.Away e, inferInstance, inferInstance, hEt, iRT, hRPT, inferInstance,
    inferInstance, hfin, hfp, iBC, hflat, iRC, hRTC, hRBC,
    P'.map (algebraMap (TensorProduct P T B) (Localization.Away e)), hQCp, ?_, ?_, ?_, ?_⟩
  · show Ideal.comap ((algebraMap (TensorProduct P T B) (Localization.Away e)).comp
      (Algebra.TensorProduct.includeRight (R := P) (A := T) (B := B)).toRingHom) _ = Q
    rw [← Ideal.comap_comap, hQA, hP'Q]
  · rw [hQT, ← hp]
  · intro P'' hP'' hc
    haveI := hP''
    rw [hQT] at hc
    have hP0 : (P''.comap (algebraMap (TensorProduct P T B) (Localization.Away e))).IsPrime :=
      Ideal.IsPrime.comap _
    have hLO' : (P''.comap (algebraMap (TensorProduct P T B) (Localization.Away e))).LiesOver PT :=
      ⟨by
        rw [← hc, IsScalarTower.algebraMap_eq T (TensorProduct P T B) (Localization.Away e),
          ← Ideal.comap_comap]⟩
    have he'' : e ∉ P''.comap (algebraMap (TensorProduct P T B) (Localization.Away e)) :=
      fun h => hP''.ne_top (Ideal.eq_top_of_isUnit_mem _ h
        (IsLocalization.Away.algebraMap_isUnit e))
    have hEq := huniq _ hP0 hLO' he''
    calc P'' = Ideal.map (algebraMap (TensorProduct P T B) (Localization.Away e))
          (Ideal.under (TensorProduct P T B) P'') :=
            (IsLocalization.map_under (Submonoid.powers e) _ P'').symm
      _ = _ := by rw [show Ideal.under (TensorProduct P T B) P'' = P' from hEq]
  · have gen : ∀ (J : Ideal T) [J.IsPrime], J = PT →
        ∀ x : J.ResidueField, IsIntegral R x → ∃ r : R, algebraMap R _ r = x := by
      intro J _ h
      subst h
      exact key
    exact gen _ hQT

theorem wcpa_lfg_els_gin_closed_component : ∀ (R T : Type u) [CommRing R] [IsLocalRing R] [CommRing T] [Algebra R T] (s : ℕ) [Algebra (MvPolynomial (Fin s) R) T] [IsScalarTower R (MvPolynomial (Fin s) R) T] [Algebra.Etale (MvPolynomial (Fin s) R) T] (q : Ideal T) [q.IsPrime], q.comap (algebraMap R T) = IsLocalRing.maximalIdeal R → (∀ x : q.ResidueField, IsIntegral R x → ∃ r : R, algebraMap R _ r = x) → ∃ g : T, g ∉ q ∧ IsDomain ((IsLocalRing.maximalIdeal R).Fiber (Localization.Away g)) ∧ ∀ x : (IsLocalRing.maximalIdeal R).Fiber (Localization.Away g), IsAlgebraic (IsLocalRing.maximalIdeal R).ResidueField x → ∃ c : (IsLocalRing.maximalIdeal R).ResidueField, algebraMap _ _ c = x :=
by
  have s2 : ∀ (B : Type u) [CommRing B] [IsDomain B] [UniqueFactorizationMonoid B] (F g : Polynomial B), F.Monic →
      (∃ (p₁ p₂ : Polynomial B) (n : ℕ), Polynomial.derivative F * p₁ + F * p₂ = g ^ n) →
      ∀ (Q : Ideal (Localization.Away (AdjoinRoot.mk F g))), Q.IsPrime →
      ∃ h : Localization.Away (AdjoinRoot.mk F g), h ∉ Q ∧ ∃ Q₀ : Ideal (Localization.Away (AdjoinRoot.mk F g)), Q₀.IsPrime ∧ h ∉ Q₀ ∧ ∀ x ∈ Q₀, h * x = 0 := by
    intro B _ _ _ F g hF hcond Q hQ
    classical
    obtain ⟨p₁, p₂, n, hpn⟩ := hcond
    let ψ : Polynomial B →+* Localization.Away (AdjoinRoot.mk F g) :=
      (algebraMap (AdjoinRoot F) (Localization.Away (AdjoinRoot.mk F g))).comp (AdjoinRoot.mk F)
    have ψF : ψ F = 0 := by simp [ψ, AdjoinRoot.mk_self]
    have ψg : IsUnit (ψ g) := IsLocalization.Away.algebraMap_isUnit (AdjoinRoot.mk F g)
    have ψsurj : ∀ t : Localization.Away (AdjoinRoot.mk F g), ∃ k : ℕ, ∃ a : Polynomial B,
        t * (ψ g) ^ k = ψ a := by
      intro t
      obtain ⟨⟨a', ⟨_, k, rfl⟩⟩, ha⟩ := IsLocalization.surj (Submonoid.powers (AdjoinRoot.mk F g)) t
      obtain ⟨a, rfl⟩ := AdjoinRoot.mk_surjective a'
      exact ⟨k, a, by simpa [ψ, map_pow] using ha⟩
    have stepB : ∀ (π F₁ : Polynomial B), F = π * F₁ → ∀ 𝔭 : Ideal (Polynomial B), 𝔭.IsPrime →
        π ∈ 𝔭 → F₁ ∈ 𝔭 → g ∈ 𝔭 := by
      intro π F₁ hF1 𝔭 h𝔭 hπ hF₁
      apply h𝔭.mem_of_pow_mem n
      rw [← hpn, hF1, Polynomial.derivative_mul]
      exact 𝔭.add_mem (𝔭.mul_mem_right _ (𝔭.add_mem (𝔭.mul_mem_left _ hF₁) (𝔭.mul_mem_right _ hπ)))
        (𝔭.mul_mem_right _ (𝔭.mul_mem_right _ hπ))
    have h𝔮 : (Q.comap ψ).IsPrime := Ideal.comap_isPrime ψ Q
    have hF𝔮 : F ∈ Q.comap ψ := by
      rw [Ideal.mem_comap, ψF]; exact Q.zero_mem
    have hg𝔮 : g ∉ Q.comap ψ := fun h => Ideal.notMem_of_isUnit Q ψg h
    have hF0 : F ≠ 0 := hF.ne_zero
    obtain ⟨π, hπmem, hπ𝔮⟩ : ∃ π ∈ UniqueFactorizationMonoid.factors F, π ∈ Q.comap ψ := by
      obtain ⟨u, hu⟩ := UniqueFactorizationMonoid.factors_prod hF0
      have hprod : (UniqueFactorizationMonoid.factors F).prod ∈ Q.comap ψ := by
        have h1 : (UniqueFactorizationMonoid.factors F).prod * (u : Polynomial B) ∈ Q.comap ψ := by
          rw [hu]; exact hF𝔮
        rcases h𝔮.mem_or_mem h1 with h | h
        · exact h
        · exact absurd h (Ideal.notMem_of_isUnit _ u.isUnit)
      exact (h𝔮.multiset_prod_mem_iff_exists_mem _).mp hprod
    have hπprime : Prime π := UniqueFactorizationMonoid.prime_of_factor π hπmem
    obtain ⟨F₁, hF₁⟩ := UniqueFactorizationMonoid.dvd_of_mem_factors hπmem
    have hπg : ¬ π ∣ g := by
      rintro ⟨c, hc⟩
      apply hg𝔮
      have hmem : π * c ∈ Q.comap ψ := Ideal.mul_mem_right _ _ hπ𝔮
      rw [← hc] at hmem
      exact hmem
    refine ⟨ψ F₁, ?_, ?_⟩
    · intro hmem
      exact hg𝔮 (stepB π F₁ hF₁ _ h𝔮 hπ𝔮 hmem)
    have hspan : (Ideal.span {π} : Ideal (Polynomial B)).IsPrime :=
      (Ideal.span_singleton_prime hπprime.ne_zero).mpr hπprime
    haveI : IsDomain (Polynomial B ⧸ Ideal.span {π}) := Ideal.Quotient.isDomain _
    let θ : Polynomial B →+* FractionRing (Polynomial B ⧸ Ideal.span {π}) :=
      (algebraMap (Polynomial B ⧸ Ideal.span {π}) (FractionRing (Polynomial B ⧸ Ideal.span {π}))).comp
        (Ideal.Quotient.mk _)
    have θ0 : ∀ a, θ a = 0 ↔ π ∣ a := by
      intro a
      simp only [θ, RingHom.comp_apply]
      rw [map_eq_zero_iff _ (IsFractionRing.injective _ _), Ideal.Quotient.eq_zero_iff_mem,
        Ideal.mem_span_singleton]
    have θF : ∀ a ∈ (Ideal.span {F} : Ideal (Polynomial B)), θ a = 0 := by
      intro a ha
      rw [θ0]
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      rw [hF₁]
      exact ⟨c * F₁, by ring⟩
    let χ₀ : AdjoinRoot F →+* FractionRing (Polynomial B ⧸ Ideal.span {π}) :=
      Ideal.Quotient.lift (Ideal.span {F}) θ θF
    have χ₀mk : ∀ a, χ₀ (AdjoinRoot.mk F a) = θ a := fun a => rfl
    have hχ₀g : IsUnit (χ₀ (AdjoinRoot.mk F g)) := by
      rw [χ₀mk]
      exact Ne.isUnit (fun h => hπg ((θ0 g).mp h))
    let χ : Localization.Away (AdjoinRoot.mk F g) →+* FractionRing (Polynomial B ⧸ Ideal.span {π}) :=
      IsLocalization.Away.lift (AdjoinRoot.mk F g) hχ₀g
    have χψ : ∀ a, χ (ψ a) = θ a := by
      intro a
      simp only [χ, ψ, RingHom.comp_apply]
      rw [IsLocalization.Away.lift_eq]
      exact χ₀mk a
    refine ⟨RingHom.ker χ, RingHom.ker_isPrime χ, ?_, ?_⟩
    · rw [RingHom.mem_ker, χψ, θ0]
      intro hdvd
      apply hπg
      have h1 : π ∈ (Ideal.span {π} : Ideal (Polynomial B)) := Ideal.mem_span_singleton_self π
      have h2 : F₁ ∈ (Ideal.span {π} : Ideal (Polynomial B)) := Ideal.mem_span_singleton.mpr hdvd
      exact Ideal.mem_span_singleton.mp (stepB π F₁ hF₁ _ hspan h1 h2)
    · intro t ht
      rw [RingHom.mem_ker] at ht
      obtain ⟨k, a, hka⟩ := ψsurj t
      have hθa : θ a = 0 := by
        rw [← χψ, ← hka, map_mul, ht, zero_mul]
      obtain ⟨b, rfl⟩ := (θ0 a).mp hθa
      have h0 : ψ F₁ * t * (ψ g) ^ k = 0 := by
        rw [mul_assoc, hka, ← map_mul, show F₁ * (π * b) = F * b by rw [hF₁]; ring, map_mul, ψF,
          zero_mul]
      exact (IsUnit.mul_left_eq_zero (ψg.pow k)).mp h0

  have s3 : ∀ (B R : Type u) [CommRing B] [IsDomain B] [UniqueFactorizationMonoid B] [CommRing R]
      (φ : B →+* R), φ.Etale → ∀ (Q : Ideal R), Q.IsPrime →
      ∃ h : R, h ∉ Q ∧ ∃ Q₀ : Ideal R, Q₀.IsPrime ∧ h ∉ Q₀ ∧ ∀ x ∈ Q₀, ∃ n : ℕ, h ^ n * x = 0 := by
    intro B R _ _ _ _ φ hφ Q hQ
    classical
    letI := φ.toAlgebra
    haveI : Algebra.Etale B R := hφ
    obtain ⟨f, hfQ, hstd⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := B) Q
    obtain ⟨P⟩ := hstd.nonempty_standardEtalePresentation
    let e : Localization.Away (AdjoinRoot.mk P.f P.g) ≃+* Localization.Away f :=
      (P.equivAwayAdjoinRoot.symm.trans (AlgEquiv.ofBijective (P.lift P.x P.hasMap) P.lift_bijective)).toRingEquiv
    let ι := algebraMap R (Localization.Away f)
    have hu : IsUnit (ι f) := IsLocalization.Away.algebraMap_isUnit f
    have locPrime : ∀ I : Ideal R, I.IsPrime → f ∉ I →
        (I.map ι).IsPrime ∧ (I.map ι).comap ι = I := by
      intro I hI hfI
      have hdisj : Disjoint (Submonoid.powers f : Set R) I :=
        (Ideal.disjoint_powers_iff_notMem f hI.isRadical).mpr hfI
      exact ⟨IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers f) _ I hI hdisj,
        IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers f) _ hI hdisj⟩
    obtain ⟨hQf, hQfc⟩ := locPrime Q hQ hfQ
    have hQ' : (Ideal.comap e (Q.map ι)).IsPrime := Ideal.comap_isPrime e _
    obtain ⟨h', hh'Q, Q₀', hQ₀', hh'Q₀', hann'⟩ := s2 B P.f P.g P.monic_f P.cond _ hQ'
    obtain ⟨⟨a, ⟨_, k, rfl⟩⟩, ha⟩ := IsLocalization.surj (Submonoid.powers f) (e h')
    simp only at ha
    have hfQ₀ : ∀ I : Ideal (Localization.Away f), I.IsPrime → ∀ j : ℕ, ι (f ^ j) ∉ I := by
      intro I hI j
      rw [map_pow]
      exact Ideal.notMem_of_isUnit I (hu.pow j)
    refine ⟨a * f, ?_, Ideal.comap ι (Ideal.comap e.symm Q₀'), ?_, ?_, ?_⟩
    · intro hmem
      rcases hQ.mem_or_mem hmem with h | h
      · apply hh'Q
        rw [Ideal.mem_comap]
        have h2 : ι a ∈ Q.map ι := Ideal.mem_map_of_mem ι h
        rw [← ha] at h2
        rcases hQf.mem_or_mem h2 with h3 | h3
        · exact h3
        · exact absurd h3 (hfQ₀ _ hQf k)
      · exact hfQ h
    · exact Ideal.comap_isPrime ι _
    · intro hmem
      rw [Ideal.mem_comap, Ideal.mem_comap] at hmem
      have hQ₀'' : (Ideal.comap e.symm Q₀').IsPrime := Ideal.comap_isPrime e.symm _
      have hmem' : e h' * ι (f ^ (k + 1)) ∈ Ideal.comap e.symm Q₀' := by
        rw [pow_succ, map_mul, ← mul_assoc, ha, ← map_mul]
        exact hmem
      rcases hQ₀''.mem_or_mem hmem' with h | h
      · apply hh'Q₀'
        rw [Ideal.mem_comap, RingEquiv.symm_apply_apply] at h
        exact h
      · exact hfQ₀ _ hQ₀'' (k + 1) h
    · intro x hx
      rw [Ideal.mem_comap, Ideal.mem_comap] at hx
      have h1 : h' * e.symm (ι x) = 0 := hann' _ hx
      have h2 : e h' * ι x = 0 := by
        have := congrArg e h1
        rwa [map_mul, RingEquiv.apply_symm_apply, map_zero] at this
      have h3 : ι (a * x) = 0 := by
        rw [map_mul, ← ha, mul_right_comm, h2, zero_mul]
      obtain ⟨⟨_, n, rfl⟩, hn⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.powers f) _ _).mp h3
      refine ⟨n + 1, ?_⟩
      simp only at hn
      calc (a * f) ^ (n + 1) * x = a ^ n * f * (f ^ n * (a * x)) := by ring
        _ = 0 := by rw [hn, mul_zero]

  have etale_key : ∀ {B C D E : Type u} [CommRing B] [CommRing C] [CommRing D] [CommRing E] [Algebra C D],
      Algebra.Etale C D → ∀ (e1 : B ≃+* C) (e2 : D ≃+* E),
      ((e2 : D →+* E).comp ((algebraMap C D).comp (e1 : B →+* C))).Etale := by
    intro B C D E _ _ _ _ _ hCD e1 e2
    refine RingHom.Etale.stableUnderComposition _ _ ?_ (RingHom.Etale.of_bijective e2.bijective)
    refine RingHom.Etale.stableUnderComposition _ _ (RingHom.Etale.of_bijective e1.bijective) ?_
    exact RingHom.etale_algebraMap.mpr hCD

  have s4' : ∀ (A S : Type u) [CommRing A] [CommRing S] [Algebra A S] (h : A) [IsLocalization.Away h S]
      (Q₀ : Ideal A), Q₀.IsPrime → h ∉ Q₀ → (∀ x ∈ Q₀, ∃ n : ℕ, h ^ n * x = 0) → IsDomain S := by
    intro A S _ _ _ h _ Q₀ hQ₀ hh hann
    have hpow : ∀ n : ℕ, h ^ n ∉ Q₀ := fun n hn => hh (hQ₀.mem_of_pow_mem n hn)
    have KF : ∀ a : A, algebraMap A S a = 0 ↔ ∃ n : ℕ, h ^ n * a = 0 := by
      intro a
      rw [IsLocalization.map_eq_zero_iff (Submonoid.powers h)]
      constructor
      · rintro ⟨⟨_, n, rfl⟩, hn⟩; exact ⟨n, hn⟩
      · rintro ⟨n, hn⟩; exact ⟨⟨h ^ n, n, rfl⟩, hn⟩
    have hnt : Nontrivial S := by
      refine ⟨⟨0, 1, fun h01 => ?_⟩⟩
      have : algebraMap A S 1 = 0 := by rw [map_one]; exact h01.symm
      obtain ⟨n, hn⟩ := (KF 1).mp this
      rw [mul_one] at hn
      exact hpow n (hn ▸ Q₀.zero_mem)
    have hnzd : NoZeroDivisors S := by
      refine ⟨fun {u v} huv => ?_⟩
      obtain ⟨⟨a, i⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers h) u
      obtain ⟨⟨b, j⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers h) v
      simp only at huv ⊢
      rw [← IsLocalization.mk'_mul, IsLocalization.mk'_eq_zero_iff] at huv
      obtain ⟨⟨_, n, rfl⟩, hn⟩ := huv
      simp only at hn
      have hab : h ^ n * (a * b) ∈ Q₀ := hn ▸ Q₀.zero_mem
      rcases hQ₀.mem_or_mem hab with h1 | h1
      · exact absurd h1 (hpow n)
      rcases hQ₀.mem_or_mem h1 with h2 | h2
      · left
        rw [IsLocalization.mk'_eq_zero_iff]
        obtain ⟨N, hN⟩ := hann a h2
        exact ⟨⟨h ^ N, N, rfl⟩, hN⟩
      · right
        rw [IsLocalization.mk'_eq_zero_iff]
        obtain ⟨N, hN⟩ := hann b h2
        exact ⟨⟨h ^ N, N, rfl⟩, hN⟩
    exact NoZeroDivisors.to_isDomain _

  have s5' : ∀ (R K T : Type u) [CommRing R] [CommRing K] [CommRing T] [Algebra R K] [Algebra R T] (g : T)
      (Q₀ : Ideal (TensorProduct R T K)), Q₀.IsPrime → algebraMap T (TensorProduct R T K) g ∉ Q₀ →
      (∀ x ∈ Q₀, ∃ n : ℕ, (algebraMap T (TensorProduct R T K) g) ^ n * x = 0) →
      IsDomain (TensorProduct R K (Localization.Away g)) := by
    intro R K T _ _ _ _ _ g Q₀ hQ₀ hh hann
    letI alg : Algebra (TensorProduct R T K) (TensorProduct R (Localization.Away g) K) :=
      (Algebra.TensorProduct.map (IsScalarTower.toAlgHom R T (Localization.Away g))
        (AlgHom.id R K)).toRingHom.toAlgebra
    haveI : IsScalarTower T (TensorProduct R T K) (TensorProduct R (Localization.Away g) K) := by
      refine IsScalarTower.of_algebraMap_eq (fun t => ?_)
      simp [RingHom.algebraMap_toAlgebra, Algebra.TensorProduct.algebraMap_apply]
    have H := IsLocalization.tensorProduct_tensorProduct R K (Submonoid.powers g)
      (Localization.Away g) (by
        ext k
        simp [RingHom.algebraMap_toAlgebra])
    have H' : IsLocalization.Away (algebraMap T (TensorProduct R T K) g)
        (TensorProduct R (Localization.Away g) K) := by
      unfold IsLocalization.Away
      simpa only [Algebra.algebraMapSubmonoid, Submonoid.map_powers] using H
    haveI : IsDomain (TensorProduct R (Localization.Away g) K) := s4' _ _ _ Q₀ hQ₀ hh hann
    exact MulEquiv.isDomain _ (Algebra.TensorProduct.comm R K (Localization.Away g)).toMulEquiv

  have s7 : ∀ (R K D E : Type u) [CommRing R] [Field K] [Algebra R K] [CommRing D] [IsDomain D] [Algebra K D]
      [Field E] [Algebra R E], Function.Surjective (algebraMap R K) → ∀ ρ : D →+* E,
      (∀ r : R, ρ (algebraMap K D (algebraMap R K r)) = algebraMap R E r) →
      (∀ e : E, IsIntegral R e → ∃ r : R, algebraMap R E r = e) →
      ∀ x : D, IsAlgebraic K x → ∃ c : K, algebraMap K D c = x := by
    intro R K D E _ _ _ _ _ _ _ _ hsurj ρ hρ hAlg
    intro x hx
    have hxi : IsIntegral K x := hx.isIntegral
    obtain ⟨p, hpm, hpx⟩ := id hxi
    obtain ⟨P, hPmap, -, hPm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic
      (Polynomial.map_surjective (algebraMap R K) hsurj p) hpm
    have hcomp : algebraMap R E = (ρ.comp (algebraMap K D)).comp (algebraMap R K) := by
      ext r; exact (hρ r).symm
    have hρx : IsIntegral R (ρ x) := by
      refine ⟨P, hPm, ?_⟩
      rw [hcomp, ← Polynomial.eval₂_map, hPmap, ← Polynomial.hom_eval₂, hpx, map_zero]
    obtain ⟨r, hr⟩ := hAlg _ hρx
    refine ⟨algebraMap R K r, ?_⟩
    by_contra hne
    have hy : IsIntegral K (x - algebraMap K D (algebraMap R K r)) :=
      hxi.sub isIntegral_algebraMap
    have hy0 : x - algebraMap K D (algebraMap R K r) ≠ 0 := sub_ne_zero.mpr (Ne.symm hne)
    have hu := (hy.isUnit hy0).map ρ
    rw [map_sub, hρ, hr, sub_self] at hu
    haveI : Nontrivial E := DivisionRing.toNontrivial
    exact not_isUnit_zero hu

  have s8a : ∀ (R : Type u) [CommRing R] [IsLocalRing R],
      Function.Surjective (algebraMap R (IsLocalRing.maximalIdeal R).ResidueField) := by
    intro R _ _
    rw [IsScalarTower.algebraMap_eq R (R ⧸ IsLocalRing.maximalIdeal R)]
    exact (Ideal.bijective_algebraMap_quotient_residueField _).2.comp Ideal.Quotient.mk_surjective

  intro R T _ _ _ _ s _ _ _ q _ hqR hres
  classical
  let κ := (IsLocalRing.maximalIdeal R).ResidueField
  let e1 : MvPolynomial (Fin s) κ ≃+* TensorProduct R (MvPolynomial (Fin s) R) κ :=
    ((MvPolynomial.algebraTensorAlgEquiv R κ).symm.toRingEquiv).trans
      (Algebra.TensorProduct.comm R κ (MvPolynomial (Fin s) R)).toRingEquiv
  let e2 : TensorProduct (MvPolynomial (Fin s) R) (TensorProduct R (MvPolynomial (Fin s) R) κ) T ≃+*
      TensorProduct R T κ :=
    (Algebra.TensorProduct.comm (MvPolynomial (Fin s) R)
      (TensorProduct R (MvPolynomial (Fin s) R) κ) T).toRingEquiv.trans
      (Algebra.TensorProduct.cancelBaseChange R (MvPolynomial (Fin s) R) (MvPolynomial (Fin s) R)
        T κ).toRingEquiv
  have hφ := etale_key (Algebra.Etale.baseChange (MvPolynomial (Fin s) R) T
    (TensorProduct R (MvPolynomial (Fin s) R) κ)) e1 e2
  let σA : T →ₐ[R] q.ResidueField := IsScalarTower.toAlgHom R T q.ResidueField
  let ι : (IsLocalRing.maximalIdeal R).ResidueField →ₐ[R] q.ResidueField :=
    Ideal.ResidueField.mapₐ (IsLocalRing.maximalIdeal R) q (Algebra.ofId R T) hqR.symm
  let ρ₀ : TensorProduct R T (IsLocalRing.maximalIdeal R).ResidueField →ₐ[R] q.ResidueField :=
    Algebra.TensorProduct.productMap σA ι
  have hρ₀ : ∀ t : T, ρ₀ (algebraMap T (TensorProduct R T (IsLocalRing.maximalIdeal R).ResidueField) t)
      = algebraMap T q.ResidueField t := by
    intro t
    rw [Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one]
    rfl
  have surj : Function.Surjective
      (algebraMap T (TensorProduct R T (IsLocalRing.maximalIdeal R).ResidueField)) := by
    intro z
    obtain ⟨t, ht⟩ := Algebra.TensorProduct.includeRight_surjective
      (S := (IsLocalRing.maximalIdeal R).ResidueField) T (s8a R)
      ((Algebra.TensorProduct.comm R T (IsLocalRing.maximalIdeal R).ResidueField) z)
    refine ⟨t, ?_⟩
    apply (Algebra.TensorProduct.comm R T (IsLocalRing.maximalIdeal R).ResidueField).injective
    rw [← ht]
    simp [Algebra.TensorProduct.algebraMap_apply]
  haveI hdomκ0 : IsDomain κ := Field.isDomain
  haveI hdomκ : IsDomain (MvPolynomial (Fin s) κ) :=
    MvPolynomial.instIsDomainOfIsCancelAdd
  haveI hufdκ0 : UniqueFactorizationMonoid κ :=
    set_option synthInstance.maxHeartbeats 400000 in inferInstance
  haveI hufdκ : UniqueFactorizationMonoid (MvPolynomial (Fin s) κ) :=
    MvPolynomial.uniqueFactorizationMonoid (Fin s)
  haveI hdomq : IsDomain q.ResidueField := Field.isDomain
  obtain ⟨h, hhQ, Q₀, hQ₀, hhQ₀, hann⟩ := s3 _ _ _ hφ (RingHom.ker ρ₀) (RingHom.ker_isPrime _)
  obtain ⟨g, rfl⟩ := surj h
  have hgq : g ∉ q := by
    intro hg
    apply hhQ
    rw [RingHom.mem_ker, hρ₀]
    exact Ideal.algebraMap_residueField_eq_zero.mpr hg
  have hdom : IsDomain ((IsLocalRing.maximalIdeal R).Fiber (Localization.Away g)) :=
    s5' R κ T g Q₀ hQ₀ hhQ₀ hann
  refine ⟨g, hgq, hdom, ?_⟩
  intro x hx
  have hσg : ∀ y : Submonoid.powers g, IsUnit (σA y) := by
    rintro ⟨_, n, rfl⟩
    have h0 : σA g ≠ 0 := by
      intro h0
      exact hgq (Ideal.algebraMap_residueField_eq_zero.mp h0)
    simpa [map_pow] using (Ne.isUnit h0).pow n
  let σ' : Localization.Away g →ₐ[R] q.ResidueField := IsLocalization.liftAlgHom hσg
  let ρ : TensorProduct R (IsLocalRing.maximalIdeal R).ResidueField (Localization.Away g) →ₐ[R]
      q.ResidueField := Algebra.TensorProduct.productMap ι σ'
  refine s7 R (IsLocalRing.maximalIdeal R).ResidueField
    ((IsLocalRing.maximalIdeal R).Fiber (Localization.Away g)) q.ResidueField (s8a R)
    (ρ : TensorProduct R (IsLocalRing.maximalIdeal R).ResidueField (Localization.Away g) →+*
      q.ResidueField) (fun r => ?_) hres x hx
  rw [← IsScalarTower.algebraMap_apply]
  exact ρ.commutes r

theorem wcpa_lfg_els_gin_smooth_field_local_normal : ∀ (k A : Type u) [Field k] [CommRing A] [Algebra k A] [Algebra.Smooth k A] (P : Ideal A) [P.IsPrime], IsDomain (Localization.AtPrime P) ∧ IsIntegrallyClosed (Localization.AtPrime P) :=
by
  have wc_fntame_smooth_stalk_normal : ∀ (A : Type u) [CommRing A] [IsDomain A]
      [IsIntegrallyClosed A] [IsNoetherianRing A] (X : Scheme.{u}) (f : X ⟶ Spec (.of A))
      [Smooth f] (x : X), IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x) := by
    have halg : ∀ (R T : Type u) [CommRing R] [IsDomain R] [IsIntegrallyClosed R] [CommRing T]
        [Algebra R T] [Algebra.Etale R T] (q : Ideal T) [q.IsPrime],
        IsDomain (Localization.AtPrime q) ∧ IsIntegrallyClosed (Localization.AtPrime q) := by
      intro R T _ _ _ _ _ _ q _
      classical
      have s2 : ∀ (K A : Type u) [Field K] [CommRing A] [Algebra K A] [Algebra.Etale K A] (y : A),
          ∃ ε γ : A, IsIdempotentElem ε ∧ y * γ = ε ∧ (1 - ε) * y = 0 := by
        intro K A _ _ _ _ y
        obtain ⟨I, _, Ai, hF, hA, e, -⟩ := (Algebra.Etale.iff_exists_algEquiv_prod K A).mp inferInstance
        let ε' : (i : I) → Ai i := fun i => if e y i = 0 then 0 else 1
        let γ' : (i : I) → Ai i := fun i => (e y i)⁻¹
        have hε' : IsIdempotentElem ε' := by
          show ε' * ε' = ε'
          funext i
          simp only [Pi.mul_apply, ε']
          split_ifs <;> simp
        refine ⟨e.symm ε', e.symm γ', hε'.map e.symm, ?_, ?_⟩
        · apply e.injective
          rw [map_mul, AlgEquiv.apply_symm_apply, AlgEquiv.apply_symm_apply]
          funext i
          simp only [Pi.mul_apply, ε', γ']
          split_ifs with h
          · rw [h, zero_mul]
          · exact mul_inv_cancel₀ h
        · apply e.injective
          rw [map_mul, map_sub, map_one, AlgEquiv.apply_symm_apply, map_zero]
          funext i
          simp only [Pi.mul_apply, Pi.sub_apply, Pi.one_apply, Pi.zero_apply, ε']
          split_ifs with h
          · rw [h, mul_zero]
          · simp
      let K := FractionRing R
      let S := TensorProduct R T K
      let j : T →ₐ[R] S := Algebra.TensorProduct.includeLeft
      have hj : ∀ t : T, j t = TensorProduct.tmul R t (1 : K) := fun t => rfl
      have hjinj : Function.Injective j :=
        Algebra.TensorProduct.includeLeft_injective (R := R) (S := R) (A := T) (B := K)
          (IsFractionRing.injective R K)
      have hQ : ∀ y : S, ∃ ε γ : S, IsIdempotentElem ε ∧ y * γ = ε ∧ (1 - ε) * y = 0 := by
        intro y
        let c : S ≃ₐ[R] TensorProduct R K T := Algebra.TensorProduct.comm R T K
        obtain ⟨ε', γ', hε', h1, h2⟩ := s2 K (TensorProduct R K T) (c y)
        refine ⟨c.symm ε', c.symm γ', hε'.map c.symm, ?_, ?_⟩
        · apply c.injective
          rw [map_mul, AlgEquiv.apply_symm_apply, AlgEquiv.apply_symm_apply]
          exact h1
        · apply c.injective
          rw [map_mul, map_sub, map_one, AlgEquiv.apply_symm_apply, map_zero]
          exact h2
      have hlift : ∀ z : S, IsIntegral T z → ∃ t : T, j t = z := by
        intro z hint
        obtain ⟨w, hw⟩ := (TensorProduct.toIntegralClosure_bijective_of_smooth (R := R) (S := T)
          (B := K)).2 ⟨z, (mem_integralClosure_iff T S).mpr hint⟩
        have hw' := congrArg Subtype.val hw
        simp only at hw'
        have key : ∀ w' : TensorProduct R T (integralClosure R K),
            ∃ t : T, ((TensorProduct.toIntegralClosure R T K w' : integralClosure T S) : S) = j t := by
          intro w'
          induction w' using TensorProduct.induction_on with
          | zero => exact ⟨0, by rw [map_zero, map_zero]; rfl⟩
          | tmul t c =>
            have hc : (c : K) ∈ (⊥ : Subalgebra R K) := by
              rw [← IsIntegrallyClosed.integralClosure_eq_bot R K]; exact c.2
            obtain ⟨r, hr⟩ := Algebra.mem_bot.mp hc
            refine ⟨r • t, ?_⟩
            rw [hj]
            change TensorProduct.tmul R t (c : K) = _
            rw [TensorProduct.smul_tmul, ← hr, Algebra.algebraMap_eq_smul_one]
          | add x y hx hy =>
            obtain ⟨t₁, h₁⟩ := hx
            obtain ⟨t₂, h₂⟩ := hy
            exact ⟨t₁ + t₂, by rw [map_add, Subalgebra.coe_add, h₁, h₂, map_add]⟩
        obtain ⟨t, ht⟩ := key w
        exact ⟨t, ht.symm.trans hw'⟩
      have hliftI : ∀ ε : S, IsIdempotentElem ε → ∃ e : T, j e = ε := by
        intro ε hε
        apply hlift
        refine ⟨Polynomial.X ^ 2 - Polynomial.X,
          Polynomial.monic_X_pow_sub (Polynomial.degree_X_le.trans_lt (by norm_num)), ?_⟩
        rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_X, pow_two, hε.eq,
          sub_self]
      have hsep : ∀ a b : S, a * b = 0 →
          ∃ ε : S, IsIdempotentElem ε ∧ ε * b = 0 ∧ (1 - ε) * a = 0 := by
        intro a b hab
        obtain ⟨ε, γ, hε, h1, h2⟩ := hQ a
        refine ⟨ε, hε, ?_, h2⟩
        rw [← h1, mul_comm a γ, mul_assoc, hab, mul_zero]
      have hnzd : NoZeroDivisors (Localization.AtPrime q) := by
        refine ⟨fun {x y} hxy => ?_⟩
        obtain ⟨⟨s, u⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl x
        obtain ⟨⟨s', u'⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl y
        dsimp only at hxy ⊢
        rw [← IsLocalization.mk'_mul] at hxy
        obtain ⟨m, hm⟩ := (IsLocalization.mk'_eq_zero_iff _ _).mp hxy
        obtain ⟨ε, hε, h1, h2⟩ := hsep (j ((m : T) * s)) (j s')
          (by rw [← map_mul, mul_assoc, hm, map_zero])
        obtain ⟨e, rfl⟩ := hliftI ε hε
        have he1 : e * s' = 0 := hjinj (by rw [map_mul, h1, map_zero])
        have he2 : (1 - e) * ((m : T) * s) = 0 :=
          hjinj (by rw [map_mul, map_sub, map_one, h2, map_zero])
        have he3 : e * e = e := hjinj (by rw [map_mul]; exact hε.eq)
        set π := algebraMap T (Localization.AtPrime q) with hπ
        have hē : π e * π e = π e := by rw [← map_mul, he3]
        rcases IsLocalRing.isUnit_or_isUnit_one_sub_self (π e) with hu | hu
        · right
          have h1' : π e = 1 := hu.mul_left_cancel (by rw [hē, mul_one])
          have hs' : π s' = 0 := by
            have := congrArg π he1
            rwa [map_mul, h1', one_mul, map_zero] at this
          rw [IsLocalization.mk'_eq_mul_mk'_one, hs', zero_mul]
        · left
          have h0 : π e = 0 := (hu.mul_right_eq_zero).mp (by rw [sub_mul, one_mul, hē, sub_self])
          have hs : π s = 0 := by
            have := congrArg π he2
            rw [map_mul, map_sub, map_one, h0, sub_zero, one_mul, map_mul, map_zero] at this
            exact ((IsLocalization.map_units (Localization.AtPrime q) m).mul_right_eq_zero).mp this
          rw [IsLocalization.mk'_eq_mul_mk'_one, hs, zero_mul]
      haveI hdom : IsDomain (Localization.AtPrime q) := NoZeroDivisors.to_isDomain _
      refine ⟨hdom, ?_⟩
      let L := Localization.AtPrime q
      let F := FractionRing L
      have hmk : ∀ (a : T) (s : q.primeCompl),
          algebraMap L F (IsLocalization.mk' L a s) * algebraMap T F s = algebraMap T F a := by
        intro a s
        rw [IsScalarTower.algebraMap_apply T L F (s : T), IsScalarTower.algebraMap_apply T L F a,
          ← map_mul, IsLocalization.mk'_spec]
      have hπne : ∀ s : T, s ∈ q.primeCompl → algebraMap T F s ≠ 0 := by
        intro s hs h
        rw [IsScalarTower.algebraMap_apply T L F] at h
        have h' := (IsFractionRing.injective L F) (h.trans (map_zero _).symm)
        exact (IsLocalization.map_units L (⟨s, hs⟩ : q.primeCompl)).ne_zero h'
      have hRne : ∀ r : R, r ≠ 0 → algebraMap R F r ≠ 0 := by
        intro r hr h
        rw [IsScalarTower.algebraMap_apply R T F, IsScalarTower.algebraMap_apply T L F] at h
        have h' : algebraMap T L (algebraMap R T r) = 0 :=
          (IsFractionRing.injective L F) (h.trans (map_zero _).symm)
        obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff q.primeCompl L _).mp h'
        have hu : IsUnit (j (algebraMap R T r)) := by
          rw [AlgHom.commutes]
          have e1 : algebraMap R S r = Algebra.TensorProduct.includeRight (algebraMap R K r) :=
            (AlgHom.commutes _ r).symm
          rw [e1]
          exact (IsUnit.mk0 _ ((map_ne_zero_iff _ (IsFractionRing.injective R K)).mpr hr)).map _
        have hjm : j (m : T) = 0 := by
          have := congrArg j hm
          rw [map_mul, map_zero] at this
          exact (hu.mul_left_eq_zero).mp this
        have hm0 : (m : T) = 0 := hjinj (hjm.trans (map_zero j).symm)
        exact m.2 (by rw [hm0]; exact q.zero_mem)
      let ι : R →ₐ[R] F := Algebra.ofId R F
      have hι : Function.Injective ι :=
        (injective_iff_map_eq_zero ι).mpr (fun r hr => by
          by_contra h
          exact hRne r h hr)
      let κ : K →ₐ[R] F := IsFractionRing.liftAlgHom (R := R) (A := R) (K := K) (L := F) hι
      let ρ : S →ₐ[R] F := Algebra.TensorProduct.productMap (IsScalarTower.toAlgHom R T F) κ
      have hρj : ∀ t : T, ρ (j t) = algebraMap T F t := by
        intro t
        rw [hj]
        show Algebra.TensorProduct.productMap (IsScalarTower.toAlgHom R T F) κ (t ⊗ₜ[R] (1 : K)) = _
        rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one]
        rfl
      have hinv : ∀ g : S, ρ g ≠ 0 → ∃ g' : S, ρ g * ρ g' = 1 := by
        intro g hg
        obtain ⟨ε, γ, -, h1, h2⟩ := hQ g
        refine ⟨γ, ?_⟩
        rw [← map_mul, h1]
        have h3 := congrArg ρ h2
        rw [map_mul, map_sub, map_one, map_zero] at h3
        have h4 := (mul_eq_zero.mp h3).resolve_right hg
        exact (sub_eq_zero.mp h4).symm
      have hrangeL : ∀ l : L, ∃ g : S, ρ g = algebraMap L F l := by
        intro l
        obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl l
        dsimp only
        obtain ⟨g', hg'⟩ := hinv (j s) (by rw [hρj]; exact hπne s s.2)
        rw [hρj] at hg'
        refine ⟨j a * g', ?_⟩
        rw [map_mul, hρj, ← hmk a s, mul_assoc, hg', mul_one]
      have hrange : ∀ y : F, ∃ g : S, ρ g = y := by
        intro y
        obtain ⟨a', b', hb', rfl⟩ := IsFractionRing.div_surjective L y
        obtain ⟨ga, hga⟩ := hrangeL a'
        obtain ⟨gb, hgb⟩ := hrangeL b'
        have hb0 : algebraMap L F b' ≠ 0 :=
          (map_ne_zero_iff _ (IsFractionRing.injective L F)).mpr (nonZeroDivisors.ne_zero hb')
        obtain ⟨g', hg'⟩ := hinv gb (by rw [hgb]; exact hb0)
        refine ⟨ga * g', ?_⟩
        rw [map_mul, hga, div_eq_mul_inv, ← hgb, inv_eq_of_mul_eq_one_right hg']
      refine (isIntegrallyClosed_iff F).mpr ?_
      intro x hx
      obtain ⟨m, hm⟩ := IsIntegral.exists_multiple_integral_of_isLocalization q.primeCompl x hx
      have hmx : m • x = algebraMap T F m * x := by rw [Submonoid.smul_def, Algebra.smul_def]
      rw [hmx] at hm
      obtain ⟨Q, hQm, hQx⟩ := hm
      obtain ⟨z, hz⟩ := hrange (algebraMap T F m * x)
      obtain ⟨v, hv⟩ : ∃ v : S, v = Q.eval₂ (algebraMap T S) z := ⟨_, rfl⟩
      have hρalg : ((ρ : S →+* F).comp (algebraMap T S)) = algebraMap T F :=
        RingHom.ext (fun t => hρj t)
      have hρv : ρ v = 0 := by
        have h0 : (ρ : S →+* F) v = 0 := by
          rw [hv, Polynomial.hom_eval₂, hρalg]
          change Polynomial.eval₂ (algebraMap T F) (ρ z) Q = 0
          rw [hz]
          exact hQx
        exact h0
      obtain ⟨δ, γ', hδ, h1, h2⟩ := hQ v
      have hρδ : ρ δ = 0 := by rw [← h1, map_mul, hρv, zero_mul]
      obtain ⟨z', hz'⟩ : ∃ z' : S, z' = (1 - δ) * z := ⟨_, rfl⟩
      obtain ⟨c, hc⟩ := Polynomial.sub_dvd_eval_sub z' z (Q.map (algebraMap T S))
      rw [Polynomial.eval_map, Polynomial.eval_map, ← hv] at hc
      have hz'int : IsIntegral T z' := by
        refine ⟨Polynomial.X * Q, Polynomial.monic_X.mul hQm, ?_⟩
        rw [Polynomial.eval₂_X_mul]
        have e1 : Q.eval₂ (algebraMap T S) z' = v + (z' - z) * c := by rw [← hc]; ring
        rw [e1, hz']
        linear_combination z * h2 + z ^ 2 * c * hδ.eq
      obtain ⟨t, ht⟩ := hlift z' hz'int
      have hρz' : ρ z' = algebraMap T F m * x := by
        rw [hz', map_mul, map_sub, map_one, hρδ, sub_zero, one_mul, hz]
      have hπt : algebraMap T F t = algebraMap T F m * x := by
        rw [← hρj t, ht, hρz']
      refine ⟨IsLocalization.mk' L t m, ?_⟩
      apply mul_right_cancel₀ (hπne m m.2)
      rw [hmk, hπt, mul_comm]
    have hgeo : ∀ (A : Type u) [CommRing A] (X : Scheme.{u}) (f : X ⟶ Spec (.of A)) [Smooth f]
        (x : X), ∃ (n : ℕ) (T : Type u) (_ : CommRing T) (_ : Algebra (MvPolynomial (Fin n) A) T)
        (q : Ideal T) (_ : q.IsPrime), Algebra.Etale (MvPolynomial (Fin n) A) T ∧
        Nonempty (X.presheaf.stalk x ≃+* Localization.AtPrime q) := by
      intro A _ X f _ x
      classical
      obtain ⟨V, hV, hxV, -⟩ :=
        exists_isAffineOpen_mem_and_subset (U := (⊤ : X.Opens)) (x := x) trivial
      have e : V ≤ f ⁻¹ᵁ ⊤ := by rw [Scheme.Hom.preimage_top]; exact le_top
      have hsm := (smooth_iff f).mp ‹_› (isAffineOpen_top (Spec (.of A))) hV e
      let e' : A ≃+* Γ(Spec (.of A), ⊤) :=
        Iso.commRingCatIsoToRingEquiv (Scheme.ΓSpecIso (CommRingCat.of A)).symm
      have he' : (e'.toRingHom).Smooth := RingHom.Smooth.of_bijective e'.bijective
      let φ : A →+* Γ(X, V) := (Scheme.Hom.appLE f ⊤ V e).hom.comp e'.toRingHom
      have hφ : φ.Smooth := RingHom.Smooth.comp he' hsm
      letI : Algebra A Γ(X, V) := φ.toAlgebra
      haveI : Algebra.Smooth A Γ(X, V) := RingHom.Smooth.toAlgebra hφ
      obtain ⟨s, hs, hstd⟩ := Algebra.Smooth.exists_span_eq_top_isStandardSmooth A Γ(X, V)
      let p := (hV.primeIdealOf ⟨x, hxV⟩).asIdeal
      haveI hp : p.IsPrime := (hV.primeIdealOf ⟨x, hxV⟩).isPrime
      obtain ⟨b, hbs, hbp⟩ : ∃ b ∈ s, b ∉ p := by
        by_contra h
        push_neg at h
        have h1 : Ideal.span s ≤ p := Ideal.span_le.mpr h
        rw [hs] at h1
        exact hp.ne_top (top_le_iff.mp h1)
      have hC : Algebra.IsStandardSmooth A (Localization.Away b) := hstd b hbs
      obtain ⟨n, g, -, hg⟩ := RingHom.IsStandardSmooth.exists_etale_mvPolynomial
        (RingHom.isStandardSmooth_algebraMap.mpr hC)
      letI : Algebra (MvPolynomial (Fin n) A) (Localization.Away b) := g.toAlgebra
      have hEt : Algebra.Etale (MvPolynomial (Fin n) A) (Localization.Away b) :=
        RingHom.Etale.toAlgebra hg
      have hdisj : Disjoint ((Submonoid.powers b : Submonoid Γ(X, V)) : Set Γ(X, V))
          (p : Set Γ(X, V)) := by
        refine Set.disjoint_left.mpr ?_
        rintro y ⟨k, rfl⟩ hy
        exact hbp (hp.mem_of_pow_mem k hy)
      let q := p.map (algebraMap Γ(X, V) (Localization.Away b))
      haveI hq : q.IsPrime :=
        IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers b) (Localization.Away b) p hp hdisj
      have hcomap : Ideal.comap (algebraMap Γ(X, V) (Localization.Away b)) q = p :=
        IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers b) (Localization.Away b) hp hdisj
      letI : Algebra Γ(X, V) (X.presheaf.stalk x) :=
        TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨x, hxV⟩ : V)
      have hgen : ∀ (P : Ideal Γ(X, V)) [P.IsPrime], P = p →
          IsLocalization.AtPrime (X.presheaf.stalk x) P := by
        intro P _ hP
        subst hP
        exact hV.isLocalization_stalk ⟨x, hxV⟩
      haveI hloc : IsLocalization.AtPrime (X.presheaf.stalk x)
          (Ideal.comap (algebraMap Γ(X, V) (Localization.Away b)) q) := hgen _ hcomap
      let Φ₁ := IsLocalization.algEquiv
        (Ideal.comap (algebraMap Γ(X, V) (Localization.Away b)) q).primeCompl
        (X.presheaf.stalk x)
        (Localization.AtPrime (Ideal.comap (algebraMap Γ(X, V) (Localization.Away b)) q))
      let Φ₂ := IsLocalization.localizationLocalizationAtPrimeIsoLocalization
        (Submonoid.powers b) q
      exact ⟨n, Localization.Away b, inferInstance, inferInstance, q, hq, hEt,
        ⟨Φ₁.toRingEquiv.trans Φ₂.toRingEquiv⟩⟩
    have hpoly : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] (n : ℕ),
        IsIntegrallyClosed (MvPolynomial (Fin n) A) := by
      intro A _ _ _ n
      induction n with
      | zero =>
        exact IsIntegrallyClosed.of_equiv (MvPolynomial.isEmptyAlgEquiv A (Fin 0)).symm.toRingEquiv
      | succ n ih =>
        haveI := ih
        exact IsIntegrallyClosed.of_equiv (MvPolynomial.finSuccEquiv A n).symm.toRingEquiv
    intro A _ _ _ _ X f _ x
    obtain ⟨n, T, _, _, q, _, hEt, ⟨Φ⟩⟩ := hgeo A X f x
    haveI := hEt
    haveI := hpoly A n
    obtain ⟨hD, hI⟩ := halg (MvPolynomial (Fin n) A) T q
    exact ⟨MulEquiv.isDomain _ Φ.toMulEquiv, IsIntegrallyClosed.of_equiv Φ.symm⟩
  intro k A _ _ _ _ P _
  haveI hsm : Smooth (Spec.map (CommRingCat.ofHom (algebraMap k A))) :=
    HasRingHomProperty.Spec_iff.mpr (RingHom.smooth_algebraMap.mpr inferInstance)
  let x : PrimeSpectrum A := ⟨P, inferInstance⟩
  obtain ⟨hD, hI⟩ := wc_fntame_smooth_stalk_normal k (Spec (CommRingCat.of A))
    (Spec.map (CommRingCat.ofHom (algebraMap k A))) x
  let e : (Spec (CommRingCat.of A)).presheaf.stalk x ≃+* Localization.AtPrime P :=
    (Spec.stalkIso (CommRingCat.of A) x).commRingCatIsoToRingEquiv
  exact ⟨MulEquiv.isDomain _ e.symm.toMulEquiv, IsIntegrallyClosed.of_equiv e⟩

theorem wcpa_lfg_els_gin_fg_frac_reduced : ∀ (k F k' : Type u) [Field k] [CommRing F] [IsDomain F] [Algebra k F] [Field k'] [Algebra k k'], IsReduced (TensorProduct k F k') → IsReduced (TensorProduct k (FractionRing F) k') :=
by
  intro k F k' _ _ _ _ _ _ hred
  classical
  let j : TensorProduct k F k' →ₐ[k] TensorProduct k (FractionRing F) k' :=
    Algebra.TensorProduct.map (IsScalarTower.toAlgHom k F (FractionRing F)) (AlgHom.id k k')
  have hjt : ∀ (a : F) (b : k'),
      j (a ⊗ₜ[k] b) = algebraMap F (FractionRing F) a ⊗ₜ[k] b := by
    intro a b
    simp [j, Algebra.TensorProduct.map_tmul]
  have hjlin : j.toLinearMap =
      LinearMap.rTensor k' (IsScalarTower.toAlgHom k F (FractionRing F)).toLinearMap := by
    apply TensorProduct.ext'
    intro x y
    simp [j]
  have hj : Function.Injective j := by
    have hinj : Function.Injective (IsScalarTower.toAlgHom k F (FractionRing F)).toLinearMap :=
      IsFractionRing.injective F (FractionRing F)
    have h3 := Module.Flat.rTensor_preserves_injective_linearMap (M := k') _ hinj
    rw [← hjlin] at h3
    exact h3
  have hcd : ∀ z : TensorProduct k (FractionRing F) k', ∃ s : F, s ≠ 0 ∧
      ∃ w : TensorProduct k F k',
        (algebraMap F (FractionRing F) s ⊗ₜ[k] (1 : k')) * z = j w := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact ⟨1, one_ne_zero, 0, by simp⟩
    | tmul a b =>
      obtain ⟨⟨r, t⟩, ht⟩ := IsLocalization.surj (nonZeroDivisors F) a
      refine ⟨(t : F), nonZeroDivisors.ne_zero t.2, r ⊗ₜ[k] b, ?_⟩
      rw [hjt, Algebra.TensorProduct.tmul_mul_tmul, one_mul]
      congr 1
      rw [mul_comm]
      exact ht
    | add z₁ z₂ h₁ h₂ =>
      obtain ⟨s₁, hs₁, w₁, e₁⟩ := h₁
      obtain ⟨s₂, hs₂, w₂, e₂⟩ := h₂
      refine ⟨s₁ * s₂, mul_ne_zero hs₁ hs₂,
        (s₂ ⊗ₜ[k] (1 : k')) * w₁ + (s₁ ⊗ₜ[k] (1 : k')) * w₂, ?_⟩
      have hu : algebraMap F (FractionRing F) (s₁ * s₂) ⊗ₜ[k] (1 : k') =
          (algebraMap F (FractionRing F) s₁ ⊗ₜ[k] (1 : k')) *
            (algebraMap F (FractionRing F) s₂ ⊗ₜ[k] (1 : k')) := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, map_mul, mul_one]
      rw [hu, map_add, map_mul j, map_mul j, hjt, hjt, ← e₁, ← e₂]
      ring
  refine ⟨fun z ⟨n, hz⟩ => ?_⟩
  obtain ⟨s, hs, w, e⟩ := hcd z
  have hw : w ^ n = 0 := by
    apply hj
    rw [map_pow, ← e, mul_pow, hz, mul_zero, map_zero]
  have hw0 : w = 0 := _root_.IsReduced.eq_zero w ⟨n, hw⟩
  have hu : IsUnit (algebraMap F (FractionRing F) s ⊗ₜ[k] (1 : k')) := by
    have h1 : IsUnit (algebraMap F (FractionRing F) s) :=
      IsLocalization.map_units (FractionRing F)
        (⟨s, mem_nonZeroDivisors_of_ne_zero hs⟩ : nonZeroDivisors F)
    have h2 := h1.map (Algebra.TensorProduct.includeLeft (R := k) (S := k)
      (A := FractionRing F) (B := k'))
    simpa using h2
  rw [hw0, map_zero] at e
  exact hu.mul_right_eq_zero.mp e

theorem wcpa_lfg_els_gin_field_geom_integral : ∀ (k F : Type u) [Field k] [CommRing F] [Algebra k F] [Algebra.Smooth k F] [IsDomain F], (∀ x : F, IsAlgebraic k x → ∃ c : k, algebraMap k F c = x) → ∀ (L : Type u) [Field L] [Algebra k L], IsDomain (TensorProduct k L F) :=
by
  intro k F _ _ _ _ _ hAC L _ _
  classical

  have hFic : IsIntegrallyClosed F := by
    apply IsIntegrallyClosed.of_localization_maximal
    intro p _ hp
    exact (wcpa_lfg_els_gin_smooth_field_local_normal k F p).2

  have hK1 : ∀ x : FractionRing F, IsAlgebraic k x → x ∈ Set.range (algebraMap k (FractionRing F)) := by
    intro α hα
    have h1 : IsIntegral k α := hα.isIntegral
    have h2 : IsIntegral F α := h1.tower_top
    obtain ⟨y, hy⟩ := (IsIntegrallyClosed.isIntegral_iff (R := F) (K := FractionRing F)).mp h2
    have hyalg : IsAlgebraic k y := by
      rw [← hy] at hα
      exact (isAlgebraic_algebraMap_iff (IsFractionRing.injective F (FractionRing F))).mp hα
    obtain ⟨c, hc⟩ := hAC y hyalg
    exact ⟨c, by rw [IsScalarTower.algebraMap_apply k F (FractionRing F), hc, hy]⟩

  have hred : ∀ (L' : Type u) [Field L'] [Algebra k L'], IsReduced (TensorProduct k F L') := by
    intro L' _ _
    have h0 : IsReduced (TensorProduct k L' F) := by
      apply isReduced_ofLocalizationMaximal
      intro J hJ
      haveI := (wcpa_lfg_els_gin_smooth_field_local_normal L' (TensorProduct k L' F) J).1
      infer_instance
    exact isReduced_of_injective (Algebra.TensorProduct.comm k F L').toRingHom
      (Algebra.TensorProduct.comm k F L').injective

  have hfin := wcpa_dj_cf_sp_tensor_domain_finite k (FractionRing F) hK1
    (fun A' _ _ _ => wcpa_lfg_els_gin_fg_frac_reduced k F A' (hred A'))

  haveI hall : IsDomain (TensorProduct k (FractionRing F) L) :=
    wcpa_dj_cf_sp_tensor_domain_all k (FractionRing F) hfin L
  let j : TensorProduct k F L →ₐ[k] TensorProduct k (FractionRing F) L :=
    Algebra.TensorProduct.map (IsScalarTower.toAlgHom k F (FractionRing F)) (AlgHom.id k L)
  have hjlin : j.toLinearMap =
      LinearMap.rTensor L (IsScalarTower.toAlgHom k F (FractionRing F)).toLinearMap := by
    apply TensorProduct.ext'
    intro x y
    simp [j, Algebra.TensorProduct.map_tmul]
  have hj : Function.Injective j := by
    have hinj : Function.Injective (IsScalarTower.toAlgHom k F (FractionRing F)).toLinearMap :=
      IsFractionRing.injective F (FractionRing F)
    have h3 := Module.Flat.rTensor_preserves_injective_linearMap (M := L) _ hinj
    rw [← hjlin] at h3
    exact h3
  have hψ : Function.Injective
      (j.toRingHom.comp (Algebra.TensorProduct.comm k L F).toRingHom) :=
    hj.comp (Algebra.TensorProduct.comm k L F).injective
  exact Function.Injective.isDomain _ hψ

theorem wcpa_lfg_els_gin_qf_slice : ∀ (R T : Type u) [CommRing R] [IsLocalRing R] [CommRing T] [Algebra R T] (s : ℕ) [Algebra (MvPolynomial (Fin s) R) T] [IsScalarTower R (MvPolynomial (Fin s) R) T] [Algebra.Etale (MvPolynomial (Fin s) R) T] (g : T) (q : Ideal T) [q.IsPrime], q.comap (algebraMap R T) = IsLocalRing.maximalIdeal R → g ∉ q → ∃ (Z₀ : Type u) (_ : CommRing Z₀) (_ : Algebra R Z₀) (_ : Algebra.FinitePresentation R Z₀) (_ : Module.Flat R Z₀) (π : T →ₐ[R] Z₀) (y₀ : Ideal Z₀) (_ : y₀.IsPrime) (_ : Algebra.QuasiFiniteAt R y₀), y₀.comap (algebraMap R Z₀) = IsLocalRing.maximalIdeal R ∧ π g ∉ y₀ :=
by
  intro R T _ _ _ _ s _ _ _ g q _ hqR hgq
  classical

  have key : ∀ (K : Type u) [Field K] [Algebra R K], Algebra.IsIntegral R K →
      ∀ (n : ℕ) (ξ : Fin n → K), ∃ (Z : Type u) (_ : CommRing Z) (_ : Algebra R Z)
        (_ : Module.Free R Z) (_ : Module.Finite R Z) (_ : Algebra.FinitePresentation R Z)
        (x : Fin n → Z) (χ : Z →ₐ[R] K), ∀ i, χ (x i) = ξ i := by
    intro K _ _ hint n
    induction n with
    | zero =>
      intro ξ
      exact ⟨R, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
        Fin.elim0, Algebra.ofId R K, fun i => Fin.elim0 i⟩
    | succ n ih =>
      intro ξ
      obtain ⟨Z, _, _, _, _, _, x, χ, hχ⟩ := ih (fun i => ξ i.succ)
      obtain ⟨f, hfm, hf⟩ := hint.isIntegral (ξ 0)
      set F : Polynomial Z := f.map (algebraMap R Z) with hF
      have hFm : F.Monic := hfm.map _
      have : Module.Free Z (Polynomial Z ⧸ Ideal.span {F}) := hFm.free_quotient
      have : Module.Finite Z (Polynomial Z ⧸ Ideal.span {F}) := hFm.finite_quotient
      have : Module.Free R (Polynomial Z ⧸ Ideal.span {F}) := Module.Free.trans (S := Z)
      have : Module.Finite R (Polynomial Z ⧸ Ideal.span {F}) := Module.Finite.trans Z _
      have : Algebra.FinitePresentation Z (Polynomial Z ⧸ Ideal.span {F}) :=
        Algebra.FinitePresentation.quotient ⟨{F}, by simp⟩
      have : Algebra.FinitePresentation R (Polynomial Z ⧸ Ideal.span {F}) :=
        Algebra.FinitePresentation.trans R Z _
      let ψ : Polynomial Z →+* K := Polynomial.eval₂RingHom (χ : Z →+* K) (ξ 0)
      have hψF : ψ F = 0 := by
        show Polynomial.eval₂ (χ : Z →+* K) (ξ 0) F = 0
        rw [hF, Polynomial.eval₂_map]
        have hc : (χ : Z →+* K).comp (algebraMap R Z) = algebraMap R K := χ.comp_algebraMap
        rw [hc]
        exact hf
      have hker : ∀ a ∈ Ideal.span {F}, ψ a = 0 := by
        intro a ha
        obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton.mp ha
        rw [map_mul, hψF, zero_mul]
      let χ' : (Polynomial Z ⧸ Ideal.span {F}) →ₐ[R] K :=
        { Ideal.Quotient.lift (Ideal.span {F}) ψ hker with
          commutes' := fun r => by
            show Ideal.Quotient.lift (Ideal.span {F}) ψ hker
              (algebraMap R (Polynomial Z ⧸ Ideal.span {F}) r) = algebraMap R K r
            rw [← Ideal.Quotient.mk_algebraMap, Ideal.Quotient.lift_mk]
            show Polynomial.eval₂ (χ : Z →+* K) (ξ 0) (algebraMap R (Polynomial Z) r) = _
            rw [Polynomial.algebraMap_apply, Polynomial.eval₂_C]
            exact χ.commutes r }
      refine ⟨Polynomial Z ⧸ Ideal.span {F}, inferInstance, inferInstance, inferInstance,
        inferInstance, inferInstance,
        Fin.cons (Ideal.Quotient.mk _ Polynomial.X)
          (fun i => Ideal.Quotient.mk _ (Polynomial.C (x i))), χ', ?_⟩
      intro i
      refine Fin.cases ?_ (fun j => ?_) i
      · rw [Fin.cons_zero]
        show Ideal.Quotient.lift (Ideal.span {F}) ψ hker (Ideal.Quotient.mk _ Polynomial.X) = ξ 0
        rw [Ideal.Quotient.lift_mk]
        show Polynomial.eval₂ (χ : Z →+* K) (ξ 0) Polynomial.X = ξ 0
        rw [Polynomial.eval₂_X]
      · rw [Fin.cons_succ]
        show Ideal.Quotient.lift (Ideal.span {F}) ψ hker
          (Ideal.Quotient.mk _ (Polynomial.C (x j))) = ξ j.succ
        rw [Ideal.Quotient.lift_mk]
        show Polynomial.eval₂ (χ : Z →+* K) (ξ 0) (Polynomial.C (x j)) = ξ j.succ
        rw [Polynomial.eval₂_C]
        exact hχ j

  haveI : Algebra.FinitePresentation R T :=
    Algebra.FinitePresentation.trans R (MvPolynomial (Fin s) R) T

  have hdisj : Disjoint (Submonoid.powers g : Set T) (q : Set T) := by
    rw [Set.disjoint_left]
    rintro x ⟨n, rfl⟩ hx
    exact hgq (Ideal.IsPrime.mem_of_pow_mem inferInstance n hx)
  have hQp : (q.map (algebraMap T (Localization.Away g))).IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers g) _ q inferInstance hdisj
  have hI : (IsLocalRing.maximalIdeal R).map (algebraMap R (Localization.Away g)) ≤
      q.map (algebraMap T (Localization.Away g)) := by
    rw [Ideal.map_le_iff_le_comap]
    intro r hr
    rw [Ideal.mem_comap, IsScalarTower.algebraMap_apply R T (Localization.Away g)]
    apply Ideal.mem_map_of_mem
    rw [← hqR] at hr
    exact hr
  have hIne : (IsLocalRing.maximalIdeal R).map (algebraMap R (Localization.Away g)) ≠ ⊤ :=
    fun h => hQp.ne_top (top_le_iff.mp (h ▸ hI))
  obtain ⟨M, hM, hIM⟩ := Ideal.exists_le_maximal _ hIne
  letI : Field (Localization.Away g ⧸ M) := Ideal.Quotient.field M
  let ρ : T →ₐ[R] (Localization.Away g ⧸ M) :=
    (Ideal.Quotient.mkₐ R M).comp (IsScalarTower.toAlgHom R T (Localization.Away g))
  have hρg : ρ g ≠ 0 :=
    ((IsLocalization.Away.algebraMap_isUnit g).map (Ideal.Quotient.mkₐ R M)).ne_zero
  have hmK : ∀ r ∈ IsLocalRing.maximalIdeal R,
      algebraMap R (Localization.Away g ⧸ M) r = 0 := by
    intro r hr
    rw [← Ideal.Quotient.mk_algebraMap, Ideal.Quotient.eq_zero_iff_mem]
    exact hIM (Ideal.mem_map_of_mem _ hr)

  have hint : Algebra.IsIntegral R (Localization.Away g ⧸ M) := by
    haveI : Algebra.FiniteType R (Localization.Away g ⧸ M) := inferInstance
    letI : Field (R ⧸ IsLocalRing.maximalIdeal R) := Ideal.Quotient.field _
    letI : Algebra (R ⧸ IsLocalRing.maximalIdeal R) (Localization.Away g ⧸ M) :=
      (Ideal.Quotient.lift (IsLocalRing.maximalIdeal R) (algebraMap R _) hmK).toAlgebra
    haveI : IsScalarTower R (R ⧸ IsLocalRing.maximalIdeal R) (Localization.Away g ⧸ M) :=
      IsScalarTower.of_algebraMap_eq (fun r => (Ideal.Quotient.lift_mk _ _ _).symm)
    haveI : Algebra.FiniteType (R ⧸ IsLocalRing.maximalIdeal R) (Localization.Away g ⧸ M) :=
      Algebra.FiniteType.of_restrictScalars_finiteType R _ _
    haveI : Module.Finite (R ⧸ IsLocalRing.maximalIdeal R) (Localization.Away g ⧸ M) :=
      finite_of_finite_type_of_isJacobsonRing _ _
    haveI : Algebra.IsIntegral (R ⧸ IsLocalRing.maximalIdeal R) (Localization.Away g ⧸ M) :=
      Algebra.IsIntegral.of_finite _ _
    exact Algebra.IsIntegral.trans (R ⧸ IsLocalRing.maximalIdeal R)

  obtain ⟨Z, _, _, _, _, _, x, χ, hχ⟩ := key (Localization.Away g ⧸ M) hint s
    (fun i => ρ (algebraMap (MvPolynomial (Fin s) R) T (MvPolynomial.X i)))
  letI : Algebra (MvPolynomial (Fin s) R) Z := (MvPolynomial.aeval x).toRingHom.toAlgebra
  haveI : IsScalarTower R (MvPolynomial (Fin s) R) Z :=
    IsScalarTower.of_algebraMap_eq (fun r => ((MvPolynomial.aeval x).commutes r).symm)
  have hcomp : χ.comp (MvPolynomial.aeval x) =
      ρ.comp (IsScalarTower.toAlgHom R (MvPolynomial (Fin s) R) T) := by
    apply MvPolynomial.algHom_ext
    intro i
    simp only [AlgHom.comp_apply, MvPolynomial.aeval_X, IsScalarTower.coe_toAlgHom']
    exact hχ i

  haveI : Algebra.Etale Z (TensorProduct (MvPolynomial (Fin s) R) Z T) := inferInstance
  have hFP : Algebra.FinitePresentation R (TensorProduct (MvPolynomial (Fin s) R) Z T) :=
    Algebra.FinitePresentation.trans R Z _
  have hFlat : Module.Flat R (TensorProduct (MvPolynomial (Fin s) R) Z T) :=
    Module.Flat.trans R Z _
  haveI : Algebra.QuasiFinite R Z := inferInstance
  haveI : Algebra.QuasiFinite R (TensorProduct (MvPolynomial (Fin s) R) Z T) :=
    Algebra.QuasiFinite.trans R Z _

  let ρP : T →ₐ[MvPolynomial (Fin s) R] (Localization.Away g ⧸ M) :=
    (Ideal.Quotient.mkₐ (MvPolynomial (Fin s) R) M).comp
      (IsScalarTower.toAlgHom (MvPolynomial (Fin s) R) T (Localization.Away g))
  have hρP : ∀ t, ρP t = ρ t := fun t => rfl
  have hχc : ∀ p : MvPolynomial (Fin s) R, χ (algebraMap (MvPolynomial (Fin s) R) Z p) =
      algebraMap (MvPolynomial (Fin s) R) (Localization.Away g ⧸ M) p := by
    intro p
    show χ (MvPolynomial.aeval x p) = _
    have h1 := congrArg (fun φ => φ p) hcomp
    simp only [AlgHom.comp_apply, IsScalarTower.coe_toAlgHom'] at h1
    rw [h1, ← hρP]
    exact ρP.commutes p
  let χP : Z →ₐ[MvPolynomial (Fin s) R] (Localization.Away g ⧸ M) :=
    { χ with commutes' := hχc }
  let Φ := Algebra.TensorProduct.lift χP ρP (fun _ _ => Commute.all _ _)
  haveI hy : (RingHom.ker Φ).IsPrime := RingHom.ker_isPrime Φ
  let π : T →ₐ[R] TensorProduct (MvPolynomial (Fin s) R) Z T :=
    (Algebra.TensorProduct.includeRight :
      T →ₐ[MvPolynomial (Fin s) R] TensorProduct (MvPolynomial (Fin s) R) Z T).restrictScalars R
  have hΦR : ∀ r : R, Φ (algebraMap R (TensorProduct (MvPolynomial (Fin s) R) Z T) r) =
      algebraMap R (Localization.Away g ⧸ M) r := by
    intro r
    rw [Algebra.TensorProduct.algebraMap_apply]
    show χP (algebraMap R Z r) * ρP 1 = _
    rw [map_one, mul_one]
    exact χ.commutes r
  refine ⟨TensorProduct (MvPolynomial (Fin s) R) Z T, inferInstance, inferInstance, hFP, hFlat,
    π, RingHom.ker Φ, hy, inferInstance, ?_, ?_⟩
  · ext r
    rw [Ideal.mem_comap, RingHom.mem_ker, hΦR]
    constructor
    · intro h
      by_contra hr
      have hu : IsUnit r := IsLocalRing.notMem_maximalIdeal.mp hr
      exact (hu.map (algebraMap R (Localization.Away g ⧸ M))).ne_zero h
    · exact hmK r
  · rw [RingHom.mem_ker]
    show Φ ((1 : Z) ⊗ₜ g) ≠ 0
    show χP 1 * ρP g ≠ 0
    rw [map_one, one_mul]
    exact hρg

theorem wcpa_lfg_els_gin_finite_free_nbhd : ∀ (R Z₀ : Type u) [CommRing R] [IsLocalRing R] [CommRing Z₀] [Algebra R Z₀] [Algebra.FinitePresentation R Z₀] [Module.Flat R Z₀] (y₀ : Ideal Z₀) [y₀.IsPrime] [Algebra.QuasiFiniteAt R y₀], y₀.comap (algebraMap R Z₀) = IsLocalRing.maximalIdeal R → ∃ (R' : Type u) (_ : CommRing R') (_ : IsLocalRing R') (_ : Algebra R R') (_ : Module.Flat R R') (_ : IsLocalHom (algebraMap R R')) (Z : Type u) (_ : CommRing Z) (_ : IsLocalRing Z) (_ : Algebra R' Z) (_ : IsLocalHom (algebraMap R' Z)) (_ : Module.Finite R' Z) (_ : Module.Free R' Z) (ψ : TensorProduct R R' Z₀ →ₐ[R'] Z), Function.Bijective (IsLocalRing.ResidueField.map (algebraMap R R')) ∧ ∀ z : Z₀, z ∉ y₀ → IsUnit (ψ (Algebra.TensorProduct.includeRight (R := R) (A := R') (B := Z₀) z)) :=
by
  intro R Z₀ _ _ _ _ _ _ y₀ _ _ hy₀
  classical

  have key : ∀ (R₁ A : Type u) [CommRing R₁] [CommRing A] [Algebra R₁ A] (P₁ : Ideal R₁)
      [P₁.IsPrime] (e : A) (P' : Ideal A) [P'.IsPrime], P'.comap (algebraMap R₁ A) = P₁ →
      e ∉ P' → Module.Finite R₁ (Localization.Away e) →
      (∀ P'' : Ideal A, P''.IsPrime → P''.comap (algebraMap R₁ A) = P₁ → e ∉ P'' → P'' = P') →
      ∃ (_ : IsLocalRing (TensorProduct R₁ (Localization.AtPrime P₁) (Localization.Away e))),
        IsLocalHom (algebraMap (Localization.AtPrime P₁)
          (TensorProduct R₁ (Localization.AtPrime P₁) (Localization.Away e))) ∧
        ∀ a : A, a ∉ P' → IsUnit (Algebra.TensorProduct.includeRight (R := R₁)
          (A := Localization.AtPrime P₁) (B := Localization.Away e)
          (algebraMap A (Localization.Away e) a)) := by
    intro R₁ A _ _ _ P₁ _ e P' _ hP'c heP' hfin huniq
    haveI := hfin

    have hjt : ∀ t : R₁, Algebra.TensorProduct.includeRight (R := R₁)
        (A := Localization.AtPrime P₁) (B := Localization.Away e)
        (algebraMap R₁ (Localization.Away e) t) =
        algebraMap (Localization.AtPrime P₁)
          (TensorProduct R₁ (Localization.AtPrime P₁) (Localization.Away e))
          (algebraMap R₁ (Localization.AtPrime P₁) t) := by
      intro t
      rw [Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.algebraMap_apply,
        Algebra.algebraMap_self, RingHom.id_apply, Algebra.TensorProduct.tmul_one_eq_one_tmul]
    have hjunit : ∀ t : R₁, t ∉ P₁ → IsUnit (Algebra.TensorProduct.includeRight (R := R₁)
        (A := Localization.AtPrime P₁) (B := Localization.Away e)
        (algebraMap R₁ (Localization.Away e) t)) := by
      intro t ht
      rw [hjt]
      exact (IsLocalization.map_units (Localization.AtPrime P₁)
        (⟨t, ht⟩ : P₁.primeCompl)).map _
    have hjeunit : IsUnit (Algebra.TensorProduct.includeRight (R := R₁)
        (A := Localization.AtPrime P₁) (B := Localization.Away e)
        (algebraMap A (Localization.Away e) e)) :=
      (IsLocalization.Away.algebraMap_isUnit e).map _

    have s3 : ∀ z : TensorProduct R₁ (Localization.AtPrime P₁) (Localization.Away e),
        ∃ (a : A) (v : TensorProduct R₁ (Localization.AtPrime P₁) (Localization.Away e)),
          IsUnit v ∧ z * v = Algebra.TensorProduct.includeRight (R := R₁)
            (A := Localization.AtPrime P₁) (B := Localization.Away e)
            (algebraMap A (Localization.Away e) a) := by
      intro z
      have hb : ∃ (b : Localization.Away e) (t : R₁), t ∉ P₁ ∧
          z * Algebra.TensorProduct.includeRight (R := R₁)
            (A := Localization.AtPrime P₁) (B := Localization.Away e)
            (algebraMap R₁ (Localization.Away e) t) =
          Algebra.TensorProduct.includeRight (R := R₁)
            (A := Localization.AtPrime P₁) (B := Localization.Away e) b := by
        letI : Algebra (Localization.Away e)
            (TensorProduct R₁ (Localization.AtPrime P₁) (Localization.Away e)) :=
          Algebra.TensorProduct.rightAlgebra
        haveI := IsLocalization.tensorRight (R := R₁) (S := Localization.Away e)
          (Localization.AtPrime P₁) P₁.primeCompl
        obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj
          (Algebra.algebraMapSubmonoid (Localization.Away e) P₁.primeCompl) z
        obtain ⟨t, ht, hts⟩ := Submonoid.mem_map.mp s.2
        refine ⟨b, t, ht, ?_⟩
        have hts' : algebraMap R₁ (Localization.Away e) t = s.1 := hts
        rw [hts']
        exact hbs
      obtain ⟨b, t, ht, hzb⟩ := hb
      obtain ⟨n, a, hna⟩ := IsLocalization.Away.surj e b
      refine ⟨a, Algebra.TensorProduct.includeRight (R := R₁)
          (A := Localization.AtPrime P₁) (B := Localization.Away e)
          (algebraMap R₁ (Localization.Away e) t) *
          Algebra.TensorProduct.includeRight (R := R₁)
          (A := Localization.AtPrime P₁) (B := Localization.Away e)
          (algebraMap A (Localization.Away e) e) ^ n, (hjunit t ht).mul (hjeunit.pow n), ?_⟩
      rw [← mul_assoc, hzb, ← map_pow, ← map_mul, hna]

    have s4 : Nontrivial (TensorProduct R₁ (Localization.AtPrime P₁) (Localization.Away e)) := by
      have hge : IsUnit (algebraMap A P'.ResidueField e) := by
        rw [isUnit_iff_ne_zero]
        intro h
        exact heP' (Ideal.algebraMap_residueField_eq_zero.mp h)
      have hα : ∀ y : P₁.primeCompl,
          IsUnit (((algebraMap A P'.ResidueField).comp (algebraMap R₁ A)) y) := by
        intro y
        rw [isUnit_iff_ne_zero]
        intro h
        apply y.2
        have hy : (y : R₁) ∈ P'.comap (algebraMap R₁ A) := by
          rw [Ideal.mem_comap]
          exact Ideal.algebraMap_residueField_eq_zero.mp h
        rw [hP'c] at hy
        exact hy
      let α : Localization.AtPrime P₁ →ₐ[R₁] P'.ResidueField :=
        { toRingHom := IsLocalization.lift (M := P₁.primeCompl) (S := Localization.AtPrime P₁) hα
          commutes' := fun t => by
            show IsLocalization.lift (M := P₁.primeCompl) (S := Localization.AtPrime P₁) hα
              (algebraMap R₁ (Localization.AtPrime P₁) t) = _
            rw [IsLocalization.lift_eq]
            exact (IsScalarTower.algebraMap_apply R₁ A P'.ResidueField t).symm }
      let β : Localization.Away e →ₐ[R₁] P'.ResidueField :=
        { toRingHom := IsLocalization.Away.lift e hge
          commutes' := fun t => by
            show IsLocalization.Away.lift e hge (algebraMap R₁ (Localization.Away e) t) = _
            rw [IsScalarTower.algebraMap_apply R₁ A (Localization.Away e) t,
              IsLocalization.Away.lift_eq]
            exact (IsScalarTower.algebraMap_apply R₁ A P'.ResidueField t).symm }
      exact RingHom.domain_nontrivial (Algebra.TensorProduct.productMap α β).toRingHom

    have s5 : ∀ M : Ideal (TensorProduct R₁ (Localization.AtPrime P₁) (Localization.Away e)),
        M.IsMaximal → M.comap (algebraMap (Localization.AtPrime P₁)
          (TensorProduct R₁ (Localization.AtPrime P₁) (Localization.Away e))) =
          IsLocalRing.maximalIdeal (Localization.AtPrime P₁) ∧
        ∀ a : A, Algebra.TensorProduct.includeRight (R := R₁)
          (A := Localization.AtPrime P₁) (B := Localization.Away e)
          (algebraMap A (Localization.Away e) a) ∈ M ↔ a ∈ P' := by
      intro M hM
      haveI : Module.Finite (Localization.AtPrime P₁)
          (TensorProduct R₁ (Localization.AtPrime P₁) (Localization.Away e)) :=
        Module.Finite.base_change R₁ (Localization.AtPrime P₁) (Localization.Away e)
      have hint : (algebraMap (Localization.AtPrime P₁)
          (TensorProduct R₁ (Localization.AtPrime P₁) (Localization.Away e))).IsIntegral := by
        haveI := Algebra.IsIntegral.of_finite (Localization.AtPrime P₁)
          (TensorProduct R₁ (Localization.AtPrime P₁) (Localization.Away e))
        exact fun x => Algebra.IsIntegral.isIntegral x
      have hMc : M.comap (algebraMap (Localization.AtPrime P₁)
          (TensorProduct R₁ (Localization.AtPrime P₁) (Localization.Away e))) =
          IsLocalRing.maximalIdeal (Localization.AtPrime P₁) :=
        IsLocalRing.eq_maximalIdeal (Ideal.isMaximal_comap_of_isIntegral_of_isMaximal _ hint M)
      refine ⟨hMc, ?_⟩
      haveI : M.IsPrime := hM.isPrime
      have hQ : M.comap ((Algebra.TensorProduct.includeRight (R := R₁)
          (A := Localization.AtPrime P₁) (B := Localization.Away e)).toRingHom.comp
          (algebraMap A (Localization.Away e))) = P' := by
        apply huniq
        · exact Ideal.IsPrime.comap _
        · ext t
          rw [Ideal.mem_comap, Ideal.mem_comap, RingHom.comp_apply,
            ← IsScalarTower.algebraMap_apply R₁ A (Localization.Away e) t]
          change Algebra.TensorProduct.includeRight (R := R₁)
            (A := Localization.AtPrime P₁) (B := Localization.Away e)
            (algebraMap R₁ (Localization.Away e) t) ∈ M ↔ t ∈ P₁
          rw [hjt, ← Ideal.mem_comap, hMc,
            IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime P₁) P₁]
        · intro h
          rw [Ideal.mem_comap] at h
          exact hM.ne_top (Ideal.eq_top_of_isUnit_mem _ h hjeunit)
      intro a
      rw [← hQ, Ideal.mem_comap]
      all_goals rfl

    obtain ⟨M₀, hM₀⟩ := Ideal.exists_maximal
      (TensorProduct R₁ (Localization.AtPrime P₁) (Localization.Away e))
    have hle : ∀ M M' : Ideal (TensorProduct R₁ (Localization.AtPrime P₁) (Localization.Away e)),
        M.IsMaximal → M'.IsMaximal → M ≤ M' := by
      intro M M' hM hM' z hz
      obtain ⟨a, v, hv, hzv⟩ := s3 z
      have h1 : Algebra.TensorProduct.includeRight (R := R₁)
          (A := Localization.AtPrime P₁) (B := Localization.Away e)
          (algebraMap A (Localization.Away e) a) ∈ M := by
        rw [← hzv]; exact M.mul_mem_right v hz
      have h2 : a ∈ P' := ((s5 M hM).2 a).mp h1
      have h3 : z * v ∈ M' := by
        rw [hzv]; exact ((s5 M' hM').2 a).mpr h2
      obtain ⟨w, hw⟩ := hv.exists_right_inv
      have hz' : z = z * v * w := by rw [mul_assoc, hw, mul_one]
      rw [hz']
      exact M'.mul_mem_right w h3
    have hZloc : IsLocalRing (TensorProduct R₁ (Localization.AtPrime P₁) (Localization.Away e)) := by
      apply IsLocalRing.of_unique_max_ideal
      exact ⟨M₀, hM₀, fun M₁ hM₁ => le_antisymm (hle _ _ hM₁ hM₀) (hle _ _ hM₀ hM₁)⟩
    haveI := hZloc
    have hmax := s5 _ (IsLocalRing.maximalIdeal.isMaximal
      (TensorProduct R₁ (Localization.AtPrime P₁) (Localization.Away e)))
    refine ⟨hZloc, ((IsLocalRing.local_hom_TFAE _).out 5 1).mp hmax.1, ?_⟩
    intro a ha
    exact IsLocalRing.notMem_maximalIdeal.mp (fun h => ha ((hmax.2 a).mp h))

  haveI : y₀.LiesOver (IsLocalRing.maximalIdeal R) := ⟨by rw [Ideal.under_def]; exact hy₀.symm⟩
  obtain ⟨R₁, _, _, _, P₁, _, _, e, _, P', _, _, hP'y, heP', hbij, hfin, huniq⟩ :=
    Algebra.exists_etale_isIdempotentElem_forall_liesOver_eq.{u,u} (IsLocalRing.maximalIdeal R) y₀
  have hP'c : P'.comap (algebraMap R₁ (TensorProduct R R₁ Z₀)) = P₁ :=
    (Ideal.under_def R₁ P').symm.trans (Ideal.over_def P' P₁).symm
  have hP₁m : P₁.comap (algebraMap R R₁) = IsLocalRing.maximalIdeal R :=
    (Ideal.under_def R P₁).symm.trans (Ideal.over_def P₁ _).symm
  have huniq' : ∀ P'' : Ideal (TensorProduct R R₁ Z₀), P''.IsPrime →
      P''.comap (algebraMap R₁ (TensorProduct R R₁ Z₀)) = P₁ → e ∉ P'' → P'' = P' :=
    fun P'' hp hc he => huniq P'' hp ⟨by rw [Ideal.under_def]; exact hc.symm⟩ he

  haveI : Module.Flat R R₁ := Algebra.Smooth.flat R R₁
  have hflat : Module.Flat R (Localization.AtPrime P₁) := Module.Flat.trans R R₁ _
  have hcomapR : (IsLocalRing.maximalIdeal (Localization.AtPrime P₁)).comap
      (algebraMap R (Localization.AtPrime P₁)) = IsLocalRing.maximalIdeal R := by
    ext r
    rw [Ideal.mem_comap, IsScalarTower.algebraMap_apply R R₁ (Localization.AtPrime P₁),
      IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime P₁) P₁,
      ← Ideal.mem_comap, hP₁m]
  haveI hlocR : IsLocalHom (algebraMap R (Localization.AtPrime P₁)) :=
    ((IsLocalRing.local_hom_TFAE (algebraMap R (Localization.AtPrime P₁))).out 5 1).mp hcomapR

  have hres : Function.Bijective
      (IsLocalRing.ResidueField.map (algebraMap R (Localization.AtPrime P₁))) := by
    refine ⟨RingHom.injective _, ?_⟩
    intro x
    obtain ⟨y, rfl⟩ := hbij.2 x
    obtain ⟨q, rfl⟩ :=
      (Ideal.bijective_algebraMap_quotient_residueField (IsLocalRing.maximalIdeal R)).2 y
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective q
    refine ⟨IsLocalRing.residue R r, ?_⟩
    rw [IsLocalRing.ResidueField.map_residue, ← Ideal.Quotient.algebraMap_eq,
      ← IsScalarTower.algebraMap_apply R (R ⧸ IsLocalRing.maximalIdeal R)
        (IsLocalRing.maximalIdeal R).ResidueField r, AlgHom.commutes,
      ← IsLocalRing.ResidueField.algebraMap_eq]
    exact (IsScalarTower.algebraMap_apply R (Localization.AtPrime P₁) P₁.ResidueField r).symm

  haveI : Module.Flat R₁ (TensorProduct R R₁ Z₀) := Module.Flat.baseChange R R₁ Z₀
  haveI : Module.Flat (TensorProduct R R₁ Z₀) (Localization.Away e) :=
    IsLocalization.flat _ (Submonoid.powers e)
  haveI : Module.Flat R₁ (Localization.Away e) := Module.Flat.trans R₁ (TensorProduct R R₁ Z₀) _
  haveI := hfin
  haveI : Module.Finite (Localization.AtPrime P₁)
      (TensorProduct R₁ (Localization.AtPrime P₁) (Localization.Away e)) :=
    Module.Finite.base_change R₁ (Localization.AtPrime P₁) (Localization.Away e)
  haveI : Module.Flat (Localization.AtPrime P₁)
      (TensorProduct R₁ (Localization.AtPrime P₁) (Localization.Away e)) :=
    Module.Flat.baseChange R₁ (Localization.AtPrime P₁) (Localization.Away e)
  obtain ⟨hZloc, hlh, hunit⟩ := key R₁ (TensorProduct R R₁ Z₀) P₁ e P' hP'c heP' hfin huniq'
  haveI := hZloc
  haveI : Module.Free (Localization.AtPrime P₁)
      (TensorProduct R₁ (Localization.AtPrime P₁) (Localization.Away e)) :=
    Module.free_of_flat_of_isLocalRing

  refine ⟨Localization.AtPrime P₁, inferInstance, inferInstance, inferInstance, hflat, hlocR,
    TensorProduct R₁ (Localization.AtPrime P₁) (Localization.Away e), inferInstance, hZloc,
    inferInstance, hlh, inferInstance, inferInstance,
    (Algebra.TensorProduct.map (AlgHom.id (Localization.AtPrime P₁) (Localization.AtPrime P₁))
      (IsScalarTower.toAlgHom R₁ (TensorProduct R R₁ Z₀) (Localization.Away e))).comp
      (Algebra.TensorProduct.cancelBaseChange R R₁ (Localization.AtPrime P₁)
        (Localization.AtPrime P₁) Z₀).symm.toAlgHom, hres, ?_⟩
  intro z hz
  have hψ : ((Algebra.TensorProduct.map (AlgHom.id (Localization.AtPrime P₁)
      (Localization.AtPrime P₁))
      (IsScalarTower.toAlgHom R₁ (TensorProduct R R₁ Z₀) (Localization.Away e))).comp
      (Algebra.TensorProduct.cancelBaseChange R R₁ (Localization.AtPrime P₁)
        (Localization.AtPrime P₁) Z₀).symm.toAlgHom)
      (Algebra.TensorProduct.includeRight (R := R) (A := Localization.AtPrime P₁) (B := Z₀) z) =
      Algebra.TensorProduct.includeRight (R := R₁) (A := Localization.AtPrime P₁)
        (B := Localization.Away e) (algebraMap (TensorProduct R R₁ Z₀) (Localization.Away e)
          (Algebra.TensorProduct.includeRight (R := R) (A := R₁) (B := Z₀) z)) := by
    rw [AlgHom.comp_apply, Algebra.TensorProduct.includeRight_apply,
      Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.includeRight_apply]
    change Algebra.TensorProduct.map _ _
      ((Algebra.TensorProduct.cancelBaseChange R R₁ (Localization.AtPrime P₁)
        (Localization.AtPrime P₁) Z₀).symm ((1 : Localization.AtPrime P₁) ⊗ₜ[R] z)) = _
    rw [Algebra.TensorProduct.cancelBaseChange_symm_tmul, Algebra.TensorProduct.map_tmul]
    all_goals rfl
  rw [hψ]
  apply hunit
  intro h
  apply hz
  rw [← hP'y]
  exact h

theorem wcpa_lfg_els_gin_closed_fibre_base_change : ∀ (W W' S : Type u) [CommRing W] [IsLocalRing W] [CommRing W'] [IsLocalRing W'] [Algebra W W'] [IsLocalHom (algebraMap W W')] [CommRing S] [Algebra W S] (g : S), (∀ (L : Type u) [Field L] [Algebra (IsLocalRing.maximalIdeal W).ResidueField L], IsDomain (TensorProduct (IsLocalRing.maximalIdeal W).ResidueField L ((IsLocalRing.maximalIdeal W).Fiber (Localization.Away g)))) → ∀ (L : Type u) [Field L] [Algebra (IsLocalRing.maximalIdeal W').ResidueField L], IsDomain (TensorProduct (IsLocalRing.maximalIdeal W').ResidueField L ((IsLocalRing.maximalIdeal W').Fiber (Localization.Away (Algebra.TensorProduct.includeRight (R := W) (A := W') (B := S) g)))) :=
by
  intro W W' S _ _ _ _ _ _ _ _ g hGI L _ _
  have s2 : Nonempty (Localization.Away (Algebra.TensorProduct.includeRight (R := W) (A := W') (B := S) g) ≃ₐ[W'] TensorProduct W W' (Localization.Away g)) := by
    set g' : TensorProduct W W' S := Algebra.TensorProduct.includeRight (R := W) (A := W') (B := S) g with hg'
    let θ : TensorProduct W W' S →ₐ[W'] TensorProduct W W' (Localization.Away g) :=
      Algebra.TensorProduct.map (AlgHom.id W' W') (IsScalarTower.toAlgHom W S (Localization.Away g))
    have hθtmul : ∀ (a : W') (s : S), θ (a ⊗ₜ[W] s) = a ⊗ₜ[W] (algebraMap S (Localization.Away g) s) := by
      intro a s
      simp [θ, Algebra.TensorProduct.map_tmul]
    have hθ : IsUnit (θ.toRingHom g') := by
      have : θ.toRingHom g' = Algebra.TensorProduct.includeRight (R := W) (A := W')
          (algebraMap S (Localization.Away g) g) := by
        show θ (1 ⊗ₜ g) = _
        rw [hθtmul]
        rfl
      rw [this]
      exact (IsLocalization.Away.algebraMap_isUnit g).map _
    let Fw : Localization.Away g' →+* TensorProduct W W' (Localization.Away g) :=
      IsLocalization.Away.lift g' hθ
    have hFw : ∀ x, Fw (algebraMap _ (Localization.Away g') x) = θ x := fun x =>
      IsLocalization.Away.lift_eq g' hθ x
    let j : S →+* Localization.Away g' :=
      (algebraMap (TensorProduct W W' S) (Localization.Away g')).comp
        (Algebra.TensorProduct.includeRight (R := W) (A := W') (B := S)).toRingHom
    have hj : IsUnit (j g) := IsLocalization.Away.algebraMap_isUnit g'
    let k0 : Localization.Away g →+* Localization.Away g' := IsLocalization.Away.lift g hj
    have hk0 : ∀ s, k0 (algebraMap S _ s) = j s := fun s => IsLocalization.Away.lift_eq g hj s
    let k : Localization.Away g →ₐ[W] Localization.Away g' :=
      { k0 with
        commutes' := fun w => by
          show k0 (algebraMap W (Localization.Away g) w) = _
          rw [IsScalarTower.algebraMap_apply W S (Localization.Away g), hk0]
          simp only [j, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, AlgHom.commutes]
          rw [← IsScalarTower.algebraMap_apply] }
    let Bw : TensorProduct W W' (Localization.Away g) →ₐ[W'] Localization.Away g' :=
      Algebra.TensorProduct.lift (Algebra.ofId W' (Localization.Away g')) k (fun _ _ => Commute.all _ _)
    have hBw : ∀ a y, Bw (a ⊗ₜ y) = algebraMap W' (Localization.Away g') a * k0 y := by
      intro a y
      simp [Bw, Algebra.TensorProduct.lift_tmul, k]
    have hFalg : ∀ c : W', Fw (algebraMap W' (Localization.Away g') c) =
        algebraMap W' (TensorProduct W W' (Localization.Away g)) c := by
      intro c
      rw [IsScalarTower.algebraMap_apply W' (TensorProduct W W' S) (Localization.Away g'), hFw,
        AlgHom.commutes]
    have hFk : Fw.comp k0 = (Algebra.TensorProduct.includeRight (R := W) (A := W')
        (B := Localization.Away g)).toRingHom := by
      apply IsLocalization.ringHom_ext (Submonoid.powers g)
      apply RingHom.ext
      intro s
      simp only [RingHom.comp_apply]
      rw [hk0]
      simp only [j, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        Algebra.TensorProduct.includeRight_apply]
      rw [hFw, hθtmul]
    have h1 : Fw.comp Bw.toRingHom = RingHom.id _ := by
      apply RingHom.ext
      intro x
      show Fw (Bw x) = x
      induction x using TensorProduct.induction_on with
      | zero => simp
      | tmul a y =>
        rw [hBw, map_mul, hFalg]
        have := RingHom.congr_fun hFk y
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          Algebra.TensorProduct.includeRight_apply] at this
        rw [this, Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.tmul_mul_tmul,
          mul_one, one_mul]
        rfl
      | add x y hx hy => rw [map_add, map_add, hx, hy]
    have h2 : Bw.toRingHom.comp Fw = RingHom.id _ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers g')
      apply RingHom.ext
      intro x
      show Bw (Fw (algebraMap _ _ x)) = algebraMap _ _ x
      rw [hFw]
      induction x using TensorProduct.induction_on with
      | zero => simp
      | tmul a s =>
        rw [hθtmul, hBw, hk0]
        simp only [j, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          Algebra.TensorProduct.includeRight_apply]
        rw [IsScalarTower.algebraMap_apply W' (TensorProduct W W' S) (Localization.Away g'),
          ← map_mul, Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.tmul_mul_tmul,
          mul_one, one_mul]
        rfl
      | add x y hx hy => rw [map_add, map_add, map_add, hx, hy]
    exact ⟨AlgEquiv.ofRingEquiv (f := RingEquiv.ofRingHom Fw Bw.toRingHom h1 h2) hFalg⟩
  obtain ⟨e⟩ := s2
  have h : IsLocalRing.maximalIdeal W = Ideal.comap (algebraMap W W') (IsLocalRing.maximalIdeal W') :=
    Ideal.LiesOver.over (P := IsLocalRing.maximalIdeal W') (p := IsLocalRing.maximalIdeal W)
  let φ : (IsLocalRing.maximalIdeal W).ResidueField →+* (IsLocalRing.maximalIdeal W').ResidueField :=
    Ideal.ResidueField.map (IsLocalRing.maximalIdeal W) (IsLocalRing.maximalIdeal W') (algebraMap W W') h
  letI iκ : Algebra (IsLocalRing.maximalIdeal W).ResidueField L :=
    ((algebraMap (IsLocalRing.maximalIdeal W').ResidueField L).comp φ).toAlgebra
  letI iW' : Algebra W' L :=
    ((algebraMap (IsLocalRing.maximalIdeal W').ResidueField L).comp
      (algebraMap W' (IsLocalRing.maximalIdeal W').ResidueField)).toAlgebra
  letI iW : Algebra W L := ((algebraMap W' L).comp (algebraMap W W')).toAlgebra
  haveI : IsScalarTower W' (IsLocalRing.maximalIdeal W').ResidueField L :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI : IsScalarTower W W' L := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI : IsScalarTower W (IsLocalRing.maximalIdeal W).ResidueField L :=
    IsScalarTower.of_algebraMap_eq (fun r => congrArg (algebraMap (IsLocalRing.maximalIdeal W').ResidueField L)
      (Ideal.ResidueField.map_algebraMap (IsLocalRing.maximalIdeal W) (IsLocalRing.maximalIdeal W')
        (algebraMap W W') h r).symm)
  let e1 := Algebra.TensorProduct.cancelBaseChange W' (IsLocalRing.maximalIdeal W').ResidueField L L
    (Localization.Away (Algebra.TensorProduct.includeRight (R := W) (A := W') (B := S) g))
  let e2 := Algebra.TensorProduct.congr (AlgEquiv.refl (R := L) (A₁ := L)) e
  let e3 := Algebra.TensorProduct.cancelBaseChange W W' L L (Localization.Away g)
  let e4 := Algebra.TensorProduct.cancelBaseChange W (IsLocalRing.maximalIdeal W).ResidueField L L
    (Localization.Away g)
  haveI := hGI L
  exact MulEquiv.isDomain _
    ((e1.toRingEquiv.trans (e2.toRingEquiv.trans e3.toRingEquiv)).trans e4.toRingEquiv.symm).toMulEquiv

theorem wcpa_lfg_els_gin_prime_over_both : ∀ (R R' T : Type u) [CommRing R] [IsLocalRing R] [CommRing R'] [IsLocalRing R'] [Algebra R R'] [IsLocalHom (algebraMap R R')] [CommRing T] [Algebra R T] (q : Ideal T) [q.IsPrime], q.comap (algebraMap R T) = IsLocalRing.maximalIdeal R → ∃ 𝔮 : Ideal (TensorProduct R R' T), 𝔮.IsPrime ∧ 𝔮.comap (algebraMap R' (TensorProduct R R' T)) = IsLocalRing.maximalIdeal R' ∧ 𝔮.comap (Algebra.TensorProduct.includeRight (R := R) (A := R') (B := T)).toRingHom = q :=
by
  intro R R' T _ _ _ _ _ _ _ _ q hq hqR
  let x : Spec (CommRingCat.of R') := IsLocalRing.closedPoint R'
  let y : Spec (CommRingCat.of T) := (⟨q, hq⟩ : PrimeSpectrum T)
  have hx : Spec.map (CommRingCat.ofHom (algebraMap R R')) x = IsLocalRing.closedPoint R := by
    rw [Spec.map_apply, CommRingCat.hom_ofHom]
    exact IsLocalRing.comap_closedPoint (algebraMap R R')
  have hy : Spec.map (CommRingCat.ofHom (algebraMap R T)) y = IsLocalRing.closedPoint R := by
    rw [Spec.map_apply, CommRingCat.hom_ofHom]
    apply PrimeSpectrum.ext
    rw [PrimeSpectrum.comap_asIdeal]
    exact hqR
  obtain ⟨z, hz1, hz2⟩ := Scheme.Pullback.exists_preimage_pullback
    (f := Spec.map (CommRingCat.ofHom (algebraMap R R')))
    (g := Spec.map (CommRingCat.ofHom (algebraMap R T))) x y (hx.trans hy.symm)
  let w : PrimeSpectrum (TensorProduct R R' T) := (pullbackSpecIso R R' T).hom z
  have h1 : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom
      (R := R) (A := R') (B := T))) ((pullbackSpecIso R R' T).hom z) = x := by
    rw [← Scheme.Hom.comp_apply, pullbackSpecIso_hom_fst]
    exact hz1
  have h2 : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight
      (R := R) (A := R') (B := T) : T →+* TensorProduct R R' T))
      ((pullbackSpecIso R R' T).hom z) = y := by
    rw [← Scheme.Hom.comp_apply, pullbackSpecIso_hom_snd]
    exact hz2
  rw [Spec.map_apply, CommRingCat.hom_ofHom] at h1 h2
  refine ⟨w.asIdeal, w.isPrime, ?_, ?_⟩
  · have := congrArg PrimeSpectrum.asIdeal h1
    exact this
  · have := congrArg PrimeSpectrum.asIdeal h2
    exact this

theorem wcpa_lfg_els_gin_primes_over_finite : ∀ (R' Z S : Type u) [CommRing R'] [IsLocalRing R'] [CommRing Z] [IsLocalRing Z] [Algebra R' Z] [Module.Finite R' Z] [CommRing S] [Algebra R' S] (q' : Ideal S) [q'.IsPrime], q'.comap (algebraMap R' S) = IsLocalRing.maximalIdeal R' → {P : Ideal (TensorProduct R' Z S) | P.IsPrime ∧ P.comap (Algebra.TensorProduct.includeRight (R := R') (A := Z) (B := S)).toRingHom = q'}.Finite ∧ ∀ P : Ideal (TensorProduct R' Z S), P.IsPrime → P.comap (Algebra.TensorProduct.includeRight (R := R') (A := Z) (B := S)).toRingHom = q' → P.comap (algebraMap Z (TensorProduct R' Z S)) = IsLocalRing.maximalIdeal Z :=
by
  intro R' Z S _ _ _ _ _ _ _ _ q' _ hq'
  classical
  constructor
  · have hfin : (q'.primesOver (TensorProduct R' S Z)).Finite :=
      Algebra.QuasiFinite.finite_primesOver q'
    have hf : Function.Injective (fun P : Ideal (TensorProduct R' Z S) =>
        P.comap ((Algebra.TensorProduct.comm R' Z S).symm : TensorProduct R' S Z →+* TensorProduct R' Z S)) :=
      Ideal.comap_injective_of_surjective _ (Algebra.TensorProduct.comm R' Z S).symm.surjective
    refine (hfin.preimage hf.injOn).subset ?_
    rintro P ⟨hP, hPc⟩
    refine ⟨Ideal.IsPrime.comap _, ⟨?_⟩⟩
    show q' = Ideal.comap (algebraMap S (TensorProduct R' S Z)) (P.comap
      ((Algebra.TensorProduct.comm R' Z S).symm : TensorProduct R' S Z →+* TensorProduct R' Z S))
    rw [Ideal.comap_comap, ← hPc]
    congr 1
  · intro P hP hPc
    have : Algebra.IsIntegral R' Z := Algebra.IsIntegral.of_finite R' Z
    have hc : (P.comap (algebraMap Z (TensorProduct R' Z S))).comap (algebraMap R' Z) =
        IsLocalRing.maximalIdeal R' := by
      rw [Ideal.comap_comap, ← IsScalarTower.algebraMap_eq, ← hq', ← hPc, Ideal.comap_comap]
      congr 1
      ext r
      simp
    have hm : ((P.comap (algebraMap Z (TensorProduct R' Z S))).comap (algebraMap R' Z)).IsMaximal := by
      rw [hc]; infer_instance
    apply IsLocalRing.eq_maximalIdeal
    exact Ideal.isMaximal_of_isIntegral_of_isMaximal_comap (algebraMap R' Z)
      (fun x => Algebra.IsIntegral.isIntegral x) _ hm

theorem wcpa_lfg_els_gin_section_connected : ∀ (W S : Type u) [CommRing W] [IsLocalRing W] [CommRing S] [Algebra W S] [Algebra.Smooth W S] (ε : S →ₐ[W] W) (g : S) (F : Set (Ideal S)), F.Finite → (∀ 𝔮 ∈ F, 𝔮.IsPrime ∧ 𝔮.comap (algebraMap W S) = IsLocalRing.maximalIdeal W ∧ g ∉ 𝔮) → IsUnit (ε g) → (∀ (L : Type u) [Field L] [Algebra (IsLocalRing.maximalIdeal W).ResidueField L], IsDomain (TensorProduct (IsLocalRing.maximalIdeal W).ResidueField L ((IsLocalRing.maximalIdeal W).Fiber (Localization.Away g)))) → ∃ h : S, IsUnit (ε h) ∧ (∀ 𝔮 ∈ F, h ∉ 𝔮) ∧ ∀ (p : Ideal W) [p.IsPrime] (L : Type u) [Field L] [Algebra p.ResidueField L], IsDomain (TensorProduct p.ResidueField L (p.Fiber (Localization.Away h))) :=
by
  intro W S _ _ _ _ _ ε g F hFfin hF hgu hH
  classical

  have s3 : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A],
      (∀ (P : Ideal A) [P.IsPrime], IsDomain (Localization.AtPrime P)) →
      ∀ x : PrimeSpectrum A, IsIrreducible (connectedComponent x) := by
    intro A _ _ hloc x
    have huniq : ∀ (P : Ideal A) [P.IsPrime] (q : Ideal A), q ∈ (⊥ : Ideal A).minimalPrimes →
        q ≤ P → q = RingHom.ker (algebraMap A (Localization.AtPrime P)) := by
      intro P _ q hq hqP
      haveI := hloc P
      have hkp : (RingHom.ker (algebraMap A (Localization.AtPrime P))).IsPrime :=
        RingHom.ker_isPrime _
      obtain ⟨⟨hqp, -⟩, hqmin⟩ := hq
      have hle : RingHom.ker (algebraMap A (Localization.AtPrime P)) ≤ q := by
        intro a ha
        rw [RingHom.mem_ker, IsLocalization.map_eq_zero_iff P.primeCompl] at ha
        obtain ⟨⟨s, hs⟩, hsa⟩ := ha
        have hs' : s ∉ P := hs
        have hsq : s ∉ q := fun h => hs' (hqP h)
        have hsa' : s * a ∈ q := by
          rw [show s * a = 0 from hsa]; exact q.zero_mem
        exact (hqp.mem_or_mem hsa').resolve_left hsq
      exact le_antisymm (hqmin ⟨hkp, bot_le⟩ hle) hle
    obtain ⟨p, hp, hpx⟩ := Ideal.exists_minimalPrimes_le (bot_le : (⊥ : Ideal A) ≤ x.asIdeal)
    have hpp : p.IsPrime := hp.1.1
    obtain ⟨Z, hZ⟩ : ∃ Z : Set (PrimeSpectrum A),
        Z = closure ({(⟨p, hpp⟩ : PrimeSpectrum A)} : Set (PrimeSpectrum A)) := ⟨_, rfl⟩
    have hZirr : IsIrreducible Z := by rw [hZ]; exact isIrreducible_singleton.closure
    have hZmem : ∀ Q : PrimeSpectrum A, Q ∈ Z ↔ p ≤ Q.asIdeal := by
      intro Q
      rw [hZ, PrimeSpectrum.closure_singleton, PrimeSpectrum.mem_zeroLocus,
        SetLike.coe_subset_coe]
    have hxZ : x ∈ Z := (hZmem x).2 hpx
    have hZcompl : Zᶜ = ⋃ q ∈ ((⊥ : Ideal A).minimalPrimes \ {p}),
        PrimeSpectrum.zeroLocus (q : Set A) := by
      ext Q
      simp only [Set.mem_compl_iff, Set.mem_iUnion, Set.mem_diff, Set.mem_singleton_iff,
        PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe, exists_prop]
      rw [hZmem]
      constructor
      · intro hQ
        obtain ⟨q, hq, hqQ⟩ := Ideal.exists_minimalPrimes_le (bot_le : (⊥ : Ideal A) ≤ Q.asIdeal)
        refine ⟨q, ⟨hq, ?_⟩, hqQ⟩
        rintro rfl
        exact hQ hqQ
      · rintro ⟨q, ⟨hq, hqp⟩, hqQ⟩ hpQ
        exact hqp ((huniq Q.asIdeal q hq hqQ).trans (huniq Q.asIdeal p hp hpQ).symm)
    have hZclopen : IsClopen Z := by
      refine ⟨by rw [hZ]; exact isClosed_closure, ?_⟩
      rw [← isClosed_compl_iff, hZcompl]
      exact ((minimalPrimes.finite_of_isNoetherianRing A).subset Set.diff_subset).isClosed_biUnion
        (fun q _ => PrimeSpectrum.isClosed_zeroLocus _)
    have hcc : connectedComponent x = Z :=
      Set.Subset.antisymm (hZclopen.connectedComponent_subset hxZ)
        (IsPreconnected.subset_connectedComponent (IsIrreducible.isConnected hZirr).isPreconnected hxZ)
    rw [hcc]
    exact hZirr

  have s6 : ∀ (A : Type u) [CommRing A], (∀ (P : Ideal A) [P.IsPrime],
      IsDomain (Localization.AtPrime P)) → IrreducibleSpace (PrimeSpectrum A) → IsDomain A := by
    intro A _ hloc hirr
    haveI : IsReduced A := by
      apply isReduced_ofLocalizationMaximal
      intro P hP
      haveI := hP.isPrime
      haveI := hloc P
      infer_instance
    have h1 : IsIrreducible (Set.univ : Set (PrimeSpectrum A)) := IrreducibleSpace.isIrreducible_univ _
    rw [PrimeSpectrum.isIrreducible_iff_vanishingIdeal_isPrime, PrimeSpectrum.vanishingIdeal_univ,
      nilradical_eq_zero, Ideal.zero_eq_bot] at h1
    haveI := Ideal.Quotient.isDomain (⊥ : Ideal A)
    exact MulEquiv.isDomain (A ⧸ (⊥ : Ideal A)) (RingEquiv.quotientBot A).symm.toMulEquiv

  have hφσ : ∀ q : PrimeSpectrum W,
      PrimeSpectrum.comap (algebraMap W S) (PrimeSpectrum.comap (ε : S →+* W) q) = q := by
    intro q
    ext a
    simp

  have hS5 : ∀ (pt : PrimeSpectrum W) (h : S),
      IrreducibleSpace (PrimeSpectrum (pt.asIdeal.Fiber (Localization.Away h))) ↔
      IsIrreducible (PrimeSpectrum.comap (algebraMap W S) ⁻¹' {pt} ∩
        (PrimeSpectrum.basicOpen h : Set (PrimeSpectrum S))) := by
    intro pt h
    have hψemb : Topology.IsOpenEmbedding (PrimeSpectrum.comap (algebraMap S (Localization.Away h))) :=
      PrimeSpectrum.localization_away_isOpenEmbedding (Localization.Away h) h
    have hψrange : Set.range (PrimeSpectrum.comap (algebraMap S (Localization.Away h))) =
        PrimeSpectrum.basicOpen h :=
      PrimeSpectrum.localization_away_comap_range (Localization.Away h) h
    have hcomp : ∀ x, PrimeSpectrum.comap (algebraMap W (Localization.Away h)) x =
        PrimeSpectrum.comap (algebraMap W S)
          (PrimeSpectrum.comap (algebraMap S (Localization.Away h)) x) := by
      intro x
      rw [IsScalarTower.algebraMap_eq W S (Localization.Away h), PrimeSpectrum.comap_comp_apply]
    have himg : PrimeSpectrum.comap (algebraMap S (Localization.Away h)) ''
        (PrimeSpectrum.comap (algebraMap W (Localization.Away h)) ⁻¹' {pt}) =
        PrimeSpectrum.comap (algebraMap W S) ⁻¹' {pt} ∩
          (PrimeSpectrum.basicOpen h : Set (PrimeSpectrum S)) := by
      ext P
      constructor
      · rintro ⟨x, hx, rfl⟩
        refine ⟨?_, ?_⟩
        · show PrimeSpectrum.comap (algebraMap W S)
            (PrimeSpectrum.comap (algebraMap S (Localization.Away h)) x) ∈ ({pt} : Set _)
          rw [← hcomp]; exact hx
        · rw [← hψrange]; exact ⟨x, rfl⟩
      · rintro ⟨hP1, hP2⟩
        rw [← hψrange] at hP2
        obtain ⟨x, rfl⟩ := hP2
        refine ⟨x, ?_, rfl⟩
        show PrimeSpectrum.comap (algebraMap W (Localization.Away h)) x ∈ ({pt} : Set _)
        rw [hcomp]; exact hP1
    have hTirr : IrreducibleSpace (PrimeSpectrum (pt.asIdeal.Fiber (Localization.Away h))) ↔
        IsIrreducible (PrimeSpectrum.comap (algebraMap W (Localization.Away h)) ⁻¹' {pt}) := by
      rw [isIrreducible_iff_irreducibleSpace, irreducibleSpace_def, irreducibleSpace_def]
      constructor
      · intro H
        have := H.image (PrimeSpectrum.preimageHomeomorphFiber W (Localization.Away h) pt).symm
          (PrimeSpectrum.preimageHomeomorphFiber W (Localization.Away h) pt).symm.continuous.continuousOn
        rwa [Set.top_eq_univ, Set.image_univ_of_surjective
          (PrimeSpectrum.preimageHomeomorphFiber W (Localization.Away h) pt).symm.surjective] at this
      · intro H
        have := H.image (PrimeSpectrum.preimageHomeomorphFiber W (Localization.Away h) pt)
          (PrimeSpectrum.preimageHomeomorphFiber W (Localization.Away h) pt).continuous.continuousOn
        rwa [Set.top_eq_univ, Set.image_univ_of_surjective
          (PrimeSpectrum.preimageHomeomorphFiber W (Localization.Away h) pt).surjective] at this
    rw [hTirr, ← himg]
    constructor
    · intro H
      exact H.image _ hψemb.continuous.continuousOn
    · intro H
      have h1 : PrimeSpectrum.comap (algebraMap S (Localization.Away h)) ⁻¹'
          (PrimeSpectrum.comap (algebraMap S (Localization.Away h)) ''
            (PrimeSpectrum.comap (algebraMap W (Localization.Away h)) ⁻¹' {pt})) =
          PrimeSpectrum.comap (algebraMap W (Localization.Away h)) ⁻¹' {pt} :=
        Set.preimage_image_eq _ hψemb.injective
      rw [← h1]
      refine H.preimage hψemb ?_
      obtain ⟨y, hy⟩ := H.nonempty
      exact ⟨y, hy, Set.image_subset_range _ _ hy⟩

  have hS7 : ∀ (h : S), IsUnit (ε h) → ∀ (p : Ideal W) [p.IsPrime],
      IsDomain (p.Fiber (Localization.Away h)) → ∀ x : p.Fiber (Localization.Away h),
      IsAlgebraic p.ResidueField x → ∃ c : p.ResidueField,
        algebraMap p.ResidueField (p.Fiber (Localization.Away h)) c = x := by
    intro h hu p _ _ x hx
    let εh : Localization.Away h →+* W := IsLocalization.Away.lift h (g := (ε : S →+* W)) hu
    have hεh : ∀ s : S, εh (algebraMap S _ s) = ε s := fun s => IsLocalization.Away.lift_eq h hu s
    let εA : Localization.Away h →ₐ[W] W :=
      { εh with
        commutes' := fun r => by
          show εh (algebraMap W (Localization.Away h) r) = algebraMap W W r
          rw [IsScalarTower.algebraMap_apply W S (Localization.Away h), hεh, AlgHom.commutes] }
    let ρ : p.Fiber (Localization.Away h) →ₐ[p.ResidueField] p.ResidueField :=
      Algebra.TensorProduct.lift (AlgHom.id p.ResidueField p.ResidueField)
        ((IsScalarTower.toAlgHom W W p.ResidueField).comp εA) (fun _ _ => Commute.all _ _)
    refine ⟨ρ x, ?_⟩
    by_contra hne
    have hz : IsIntegral p.ResidueField (x - algebraMap _ _ (ρ x)) :=
      hx.isIntegral.sub isIntegral_algebraMap
    have hz0 : x - algebraMap _ _ (ρ x) ≠ 0 := sub_ne_zero.mpr (Ne.symm hne)
    have hunit := (hz.isUnit hz0).map ρ
    rw [map_sub, AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply, sub_self] at hunit
    exact not_isUnit_zero hunit

  have hT : ∀ (pt : PrimeSpectrum W) (x : PrimeSpectrum S),
      PrimeSpectrum.comap (algebraMap W S) x = pt →
      IsIrreducible (connectedComponentIn (PrimeSpectrum.comap (algebraMap W S) ⁻¹' {pt}) x) := by
    intro pt x hx
    haveI : IsNoetherianRing (pt.asIdeal.Fiber S) :=
      Algebra.FiniteType.isNoetherianRing pt.asIdeal.ResidueField _
    have hcc := s3 (pt.asIdeal.Fiber S)
      (fun P _ => (wcpa_lfg_els_gin_smooth_field_local_normal pt.asIdeal.ResidueField
        (pt.asIdeal.Fiber S) P).1)
    have hxm : x ∈ PrimeSpectrum.comap (algebraMap W S) ⁻¹' {pt} := hx
    rw [connectedComponentIn_eq_image hxm]
    have key : connectedComponent (⟨x, hxm⟩ : PrimeSpectrum.comap (algebraMap W S) ⁻¹' {pt}) =
        (PrimeSpectrum.preimageHomeomorphFiber W S pt).symm ''
          connectedComponent ((PrimeSpectrum.preimageHomeomorphFiber W S pt) ⟨x, hxm⟩) := by
      apply Set.Subset.antisymm
      · intro z hz
        exact ⟨(PrimeSpectrum.preimageHomeomorphFiber W S pt) z,
          (PrimeSpectrum.preimageHomeomorphFiber W S pt).continuous.image_connectedComponent_subset
            _ ⟨z, hz, rfl⟩,
          (PrimeSpectrum.preimageHomeomorphFiber W S pt).symm_apply_apply z⟩
      · have := (PrimeSpectrum.preimageHomeomorphFiber W S pt).symm.continuous.image_connectedComponent_subset
          ((PrimeSpectrum.preimageHomeomorphFiber W S pt) ⟨x, hxm⟩)
        rwa [Homeomorph.symm_apply_apply] at this
    rw [key]
    exact ((hcc _).image _ (PrimeSpectrum.preimageHomeomorphFiber W S pt).symm.continuous.continuousOn).image
      _ continuous_subtype_val.continuousOn

  obtain ⟨X0, hX0⟩ : ∃ X0 : Set (PrimeSpectrum S), X0 = {P | P ∈ connectedComponentIn
      (PrimeSpectrum.comap (algebraMap W S) ⁻¹' {PrimeSpectrum.comap (algebraMap W S) P})
      (PrimeSpectrum.comap (ε : S →+* W) (PrimeSpectrum.comap (algebraMap W S) P))} := ⟨_, rfl⟩
  have hX0mem : ∀ P q, PrimeSpectrum.comap (algebraMap W S) P = q → (P ∈ X0 ↔
      P ∈ connectedComponentIn (PrimeSpectrum.comap (algebraMap W S) ⁻¹' {q})
        (PrimeSpectrum.comap (ε : S →+* W) q)) := by
    rintro P q rfl
    rw [hX0]
    rfl
  have hX0open : IsOpen X0 := by
    have : Smooth (Spec.map (CommRingCat.ofHom (algebraMap W S))) := by
      rw [HasRingHomProperty.Spec_iff (P := @Smooth)]
      exact RingHom.smooth_algebraMap.mpr inferInstance
    have hσf : Spec.map (CommRingCat.ofHom (ε : S →+* W)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap W S)) = 𝟙 _ := by
      rw [← Spec.map_comp]
      have : CommRingCat.ofHom (algebraMap W S) ≫ CommRingCat.ofHom (ε : S →+* W) =
          𝟙 (CommRingCat.of W) := by
        ext r
        simp
      rw [this, Spec.map_id]
    have hO := wc_smooth_section_fibre_component_isOpen W (Spec (.of S))
      (Spec.map (CommRingCat.ofHom (algebraMap W S)))
      (Spec.map (CommRingCat.ofHom (ε : S →+* W))) hσf
    rw [hX0]
    exact hO

  have hdomg : IsDomain ((IsLocalRing.maximalIdeal W).Fiber (Localization.Away g)) := by
    have := hH (IsLocalRing.maximalIdeal W).ResidueField
    exact MulEquiv.isDomain _ (Algebra.TensorProduct.lid (IsLocalRing.maximalIdeal W).ResidueField
      ((IsLocalRing.maximalIdeal W).Fiber (Localization.Away g))).symm.toRingEquiv.toMulEquiv
  have hCirr : IsIrreducible (PrimeSpectrum.comap (algebraMap W S) ⁻¹' {IsLocalRing.closedPoint W} ∩
      (PrimeSpectrum.basicOpen g : Set (PrimeSpectrum S))) :=
    (hS5 (IsLocalRing.closedPoint W) g).mp (@PrimeSpectrum.irreducibleSpace _ _ hdomg)
  have hεunit : ∀ s : S, IsUnit (ε s) →
      s ∉ (PrimeSpectrum.comap (ε : S →+* W) (IsLocalRing.closedPoint W)).asIdeal := by
    intro s hs hmem
    exact (IsLocalRing.notMem_maximalIdeal.mpr hs) hmem
  have hσyC : PrimeSpectrum.comap (ε : S →+* W) (IsLocalRing.closedPoint W) ∈
      PrimeSpectrum.comap (algebraMap W S) ⁻¹' {IsLocalRing.closedPoint W} ∩
      (PrimeSpectrum.basicOpen g : Set (PrimeSpectrum S)) := ⟨hφσ _, hεunit g hgu⟩
  have hCsub := IsPreconnected.subset_connectedComponentIn
    (IsIrreducible.isConnected hCirr).isPreconnected hσyC Set.inter_subset_left
  have hCX0 : ∀ P ∈ PrimeSpectrum.comap (algebraMap W S) ⁻¹' {IsLocalRing.closedPoint W} ∩
      (PrimeSpectrum.basicOpen g : Set (PrimeSpectrum S)), P ∈ X0 := by
    intro P hP
    rw [hX0mem P (IsLocalRing.closedPoint W) hP.1]
    exact hCsub hP

  obtain ⟨J, hJ⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus_ideal X0ᶜ).mp hX0open.isClosed_compl
  obtain ⟨K, hK⟩ : ∃ K : Set (Ideal S), K =
      insert (PrimeSpectrum.comap (ε : S →+* W) (IsLocalRing.closedPoint W)).asIdeal F := ⟨_, rfl⟩
  have hKfin : K.Finite := by rw [hK]; exact hFfin.insert _
  have hKC : ∀ i ∈ K, ∃ hi : i.IsPrime, (⟨i, hi⟩ : PrimeSpectrum S) ∈
      PrimeSpectrum.comap (algebraMap W S) ⁻¹' {IsLocalRing.closedPoint W} ∩
      (PrimeSpectrum.basicOpen g : Set (PrimeSpectrum S)) := by
    intro i hi
    rw [hK] at hi
    rcases hi with rfl | hi
    · exact ⟨inferInstance, hσyC⟩
    · obtain ⟨hp, hc, hg⟩ := hF i hi
      exact ⟨hp, PrimeSpectrum.ext hc, hg⟩
  have hnot : ¬ ((J : Set S) ⊆ ⋃ i ∈ K, ((id i : Ideal S) : Set S)) := by
    rw [Ideal.subset_union_prime_finite (f := id) hKfin
      (PrimeSpectrum.comap (ε : S →+* W) (IsLocalRing.closedPoint W)).asIdeal
      (PrimeSpectrum.comap (ε : S →+* W) (IsLocalRing.closedPoint W)).asIdeal
      (fun i hi _ _ => (hKC i hi).1)]
    rintro ⟨i, hi, hJi⟩
    obtain ⟨hip, hiC⟩ := hKC i hi
    have h1 : (⟨i, hip⟩ : PrimeSpectrum S) ∈ X0ᶜ := by rw [hJ]; exact hJi
    exact h1 (hCX0 _ hiC)
  obtain ⟨h, hhJ, hhK⟩ := Set.not_subset.mp hnot
  have hhK' : ∀ i ∈ K, h ∉ i := fun i hi hmem => hhK (Set.mem_biUnion hi hmem)
  have hDX0 : ∀ P : PrimeSpectrum S, h ∉ P.asIdeal → P ∈ X0 := by
    intro P hP
    by_contra hc
    have : P ∈ X0ᶜ := hc
    rw [hJ] at this
    exact hP (this hhJ)
  have hhu : IsUnit (ε h) :=
    (IsLocalRing.notMem_maximalIdeal (x := ε h)).mp (hhK' _ (by rw [hK]; exact Set.mem_insert _ _))
  refine ⟨h, hhu, fun 𝔮 h𝔮 => hhK' 𝔮 (by rw [hK]; exact Set.mem_insert_of_mem _ h𝔮), ?_⟩

  intro p _ L _ _
  haveI : Algebra.Smooth W (Localization.Away h) := Algebra.Smooth.comp W S (Localization.Away h)
  set pt : PrimeSpectrum W := ⟨p, inferInstance⟩
  have hσp : PrimeSpectrum.comap (ε : S →+* W) pt ∈ PrimeSpectrum.comap (algebraMap W S) ⁻¹' {pt} ∩
      (PrimeSpectrum.basicOpen h : Set (PrimeSpectrum S)) := by
    refine ⟨hφσ pt, ?_⟩
    intro hmem
    exact (inferInstance : p.IsPrime).ne_top (Ideal.eq_top_of_isUnit_mem p hmem hhu)
  have hX0p := hT pt _ (hφσ pt)
  have hYeq : PrimeSpectrum.comap (algebraMap W S) ⁻¹' {pt} ∩
      (PrimeSpectrum.basicOpen h : Set (PrimeSpectrum S)) =
      (PrimeSpectrum.basicOpen h : Set (PrimeSpectrum S)) ∩
        connectedComponentIn (PrimeSpectrum.comap (algebraMap W S) ⁻¹' {pt})
          (PrimeSpectrum.comap (ε : S →+* W) pt) := by
    ext P
    constructor
    · rintro ⟨hP1, hP2⟩
      exact ⟨hP2, (hX0mem P pt hP1).mp (hDX0 P hP2)⟩
    · rintro ⟨hP2, hP1⟩
      exact ⟨connectedComponentIn_subset _ _ hP1, hP2⟩
  have hYirr : IsIrreducible (PrimeSpectrum.comap (algebraMap W S) ⁻¹' {pt} ∩
      (PrimeSpectrum.basicOpen h : Set (PrimeSpectrum S))) := by
    rw [hYeq, ← Subtype.image_preimage_coe]
    refine (hX0p.preimage (PrimeSpectrum.basicOpen h).isOpen.isOpenEmbedding_subtypeVal ?_).image
      _ continuous_subtype_val.continuousOn
    exact ⟨_, mem_connectedComponentIn (hφσ pt), ⟨⟨_, hσp.2⟩, rfl⟩⟩
  have hirr : IrreducibleSpace (PrimeSpectrum (p.Fiber (Localization.Away h))) :=
    (hS5 pt h).mpr hYirr
  have hdom : IsDomain (p.Fiber (Localization.Away h)) :=
    s6 _ (fun P _ => (wcpa_lfg_els_gin_smooth_field_local_normal p.ResidueField
      (p.Fiber (Localization.Away h)) P).1) hirr
  exact wcpa_lfg_els_gin_field_geom_integral p.ResidueField (p.Fiber (Localization.Away h))
    (hS7 h hhu p hdom) L

theorem wcpa_lfg_els_gin_descend_finite_free : ∀ (R' Z S : Type u) [CommRing R'] [IsLocalRing R'] [CommRing Z] [IsLocalRing Z] [Algebra R' Z] [Module.Finite R' Z] [Module.Free R' Z] [CommRing S] [Algebra R' S] [Module.Flat R' S] (hZ : TensorProduct R' Z S) (q' : Ideal S) [q'.IsPrime], q'.comap (algebraMap R' S) = IsLocalRing.maximalIdeal R' → (∀ P : Ideal (TensorProduct R' Z S), P.IsPrime → P.comap (Algebra.TensorProduct.includeRight (R := R') (A := Z) (B := S)).toRingHom = q' → hZ ∉ P) → (∀ (P : Ideal Z) [P.IsPrime] (L : Type u) [Field L] [Algebra P.ResidueField L], IsDomain (TensorProduct P.ResidueField L (P.Fiber (Localization.Away hZ)))) → ∃ h : S, h ∉ q' ∧ ∀ (p : Ideal R') [p.IsPrime] (L : Type u) [Field L] [Algebra p.ResidueField L], IsDomain (TensorProduct p.ResidueField L (p.Fiber (Localization.Away h))) :=
by
  intro R' Z S _ _ _ _ _ _ _ _ _ _ hZ q' _ hq H1 H2
  classical

  have away_congr : ∀ {A B : Type u} [CommRing A] [CommRing B] (φ : A ≃+* B) (a : A) (b : B),
      φ a = b → Nonempty (Localization.Away a ≃+* Localization.Away b) := by
    intro A B _ _ φ a b hab
    subst hab
    exact ⟨@IsLocalization.ringEquivOfRingEquiv A _ (Submonoid.powers a) (Localization.Away a) _ _
      B _ _ (Submonoid.powers (φ a)) (Localization.Away (φ a)) _ _ _ φ
      (Submonoid.map_powers _ a)⟩

  have away_mul_domain : ∀ (E : Type u) [CommRing E] (e c : E), IsDomain (Localization.Away e) →
      Nontrivial (Localization.Away (e * c)) → IsDomain (Localization.Away (e * c)) := by
    intro E _ e c hd hn
    set c' : Localization.Away e := algebraMap E (Localization.Away e) c with hc'def
    have hT : IsLocalization.Away (c * e) (Localization.Away c') :=
      IsLocalization.Away.mul (Localization.Away e) (Localization.Away c') e c
    rw [mul_comm] at hT
    let φ : Localization.Away c' ≃ₐ[E] Localization.Away (e * c) :=
      @IsLocalization.algEquiv E _ (Submonoid.powers (e * c)) (Localization.Away c') _ _ hT
        (Localization.Away (e * c)) _ _ _
    have hc' : c' ≠ 0 := by
      intro h0
      have hu : IsUnit (algebraMap (Localization.Away e) (Localization.Away c') c') :=
        IsLocalization.Away.algebraMap_isUnit c'
      have h00 : algebraMap (Localization.Away e) (Localization.Away c') c' = 0 :=
        (congrArg (algebraMap (Localization.Away e) (Localization.Away c')) h0).trans (map_zero _)
      rw [h00, isUnit_zero_iff] at hu
      haveI : Subsingleton (Localization.Away c') := subsingleton_of_zero_eq_one hu
      haveI : Subsingleton (Localization.Away (e * c)) := φ.symm.injective.subsingleton
      exact false_of_nontrivial_of_subsingleton (Localization.Away (e * c))
    haveI : IsDomain (Localization.Away c') :=
      IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors hc')
    exact MulEquiv.isDomain (Localization.Away c') φ.symm.toRingEquiv.toMulEquiv

  have fibre_away_iso : ∀ (W T M : Type u) [CommRing W] [CommRing T] [Algebra W T] (P : Ideal W)
      [P.IsPrime] [CommRing M] [Algebra W M] [Algebra P.ResidueField M]
      [IsScalarTower W P.ResidueField M] (f : T),
      Nonempty (TensorProduct P.ResidueField M (P.Fiber (Localization.Away f)) ≃+*
        Localization.Away (TensorProduct.tmul W f (1 : M))) := by
    intro W T M _ _ _ P _ _ _ _ _ f
    let e1 := Algebra.TensorProduct.cancelBaseChange W P.ResidueField M M (Localization.Away f)
    let e2 := Algebra.TensorProduct.comm W M (Localization.Away f)
    let e3 := Algebra.TensorProduct.cancelBaseChange W T (Localization.Away f)
      (Localization.Away f) M
    let e4 := Algebra.TensorProduct.comm T (TensorProduct W T M) (Localization.Away f)
    have hloc := IsLocalization.Away.tensor (S := TensorProduct W T M) f (Localization.Away f)
    rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply] at hloc
    let e5 := @IsLocalization.algEquiv _ _ (Submonoid.powers (TensorProduct.tmul W f (1 : M)))
      (TensorProduct T (TensorProduct W T M) (Localization.Away f)) _ _ hloc
      (Localization.Away (TensorProduct.tmul W f (1 : M))) _ _ _
    exact ⟨e1.toRingEquiv.trans (e2.toRingEquiv.trans (e3.symm.toRingEquiv.trans
      (e4.symm.toRingEquiv.trans e5.toRingEquiv)))⟩

  have compositum : ∀ (k K L : Type u) [Field k] [Field K] [Field L] [Algebra k K] [Algebra k L],
      ∃ (M : Type u) (_ : Field M) (_ : Algebra k M), Nonempty (K →ₐ[k] M) ∧
        Nonempty (L →ₐ[k] M) := by
    intro k K L _ _ _ _ _
    haveI : Nontrivial (TensorProduct k K L) :=
      Algebra.TensorProduct.nontrivial_of_algebraMap_injective_of_flat_left k K L
        (algebraMap k L).injective
    obtain ⟨𝔐, h𝔐⟩ := Ideal.exists_maximal (TensorProduct k K L)
    letI := Ideal.Quotient.field 𝔐
    exact ⟨_, inferInstance, inferInstance,
      ⟨(Ideal.Quotient.mkₐ k 𝔐).comp (Algebra.TensorProduct.includeLeft (S := k))⟩,
      ⟨(Ideal.Quotient.mkₐ k 𝔐).comp Algebra.TensorProduct.includeRight⟩⟩

  have choose_h : ∃ h : S, h ∉ q' ∧ ∃ c : TensorProduct R' Z S,
      Algebra.TensorProduct.includeRight (R := R') (A := Z) (B := S) h = c * hZ := by
    have hint : (Algebra.TensorProduct.includeRight (R := R') (A := Z) (B := S)).toRingHom.IsIntegral := by
      have h1 : (algebraMap S (TensorProduct R' S Z)).IsIntegral :=
        algebraMap_isIntegral_iff.mpr (Algebra.IsIntegral.tensorProduct R' S Z)
      have h2 : (Algebra.TensorProduct.includeRight (R := R') (A := Z) (B := S)).toRingHom =
          (Algebra.TensorProduct.comm R' S Z).toRingEquiv.toRingHom.comp
            (algebraMap S (TensorProduct R' S Z)) := by
        apply RingHom.ext
        intro s
        simp [Algebra.TensorProduct.algebraMap_apply]
      rw [h2]
      exact RingHom.IsIntegral.trans _ _ h1
        (RingHom.isIntegral_of_surjective _ (Algebra.TensorProduct.comm R' S Z).surjective)
    letI : Algebra S (TensorProduct R' Z S) :=
      (Algebra.TensorProduct.includeRight (R := R') (A := Z) (B := S)).toRingHom.toAlgebra
    haveI : Algebra.IsIntegral S (TensorProduct R' Z S) := ⟨hint⟩
    by_contra hcon
    push_neg at hcon
    have hle : Ideal.under S (Ideal.span {hZ}) ≤ q' := by
      intro x hx
      by_contra hxq
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp (Ideal.mem_comap.mp hx)
      exact hcon x hxq c hc.symm
    obtain ⟨Q, hQI, hQp, hQc⟩ :=
      Ideal.exists_ideal_over_prime_of_isIntegral q' (Ideal.span {hZ}) hle
    exact H1 Q hQp hQc (hQI (Ideal.subset_span rfl))

  have fibre_nontrivial : ∀ h : S, h ∉ q' → ∀ (p : Ideal R') [p.IsPrime],
      Nontrivial (p.Fiber (Localization.Away h)) := by
    intro h hh p _
    haveI : Module.Flat S (Localization.Away h) := IsLocalization.flat _ (Submonoid.powers h)
    haveI : Module.Flat R' (Localization.Away h) := Module.Flat.trans R' S _
    have hdisj : Disjoint (Submonoid.powers h : Set S) (q' : Set S) := by
      rw [Set.disjoint_left]
      rintro x ⟨n, rfl⟩ hx
      exact hh (‹q'.IsPrime›.mem_of_pow_mem n hx)
    set Q := q'.map (algebraMap S (Localization.Away h)) with hQdef
    haveI hQp : Q.IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers h) _ q' ‹_› hdisj
    have hQc : Q.comap (algebraMap S _) = q' :=
      IsLocalization.comap_map_of_isPrime_disjoint (Submonoid.powers h) _ ‹_› hdisj
    haveI : Q.LiesOver (IsLocalRing.maximalIdeal R') := by
      refine ⟨?_⟩
      rw [Ideal.under, IsScalarTower.algebraMap_eq R' S (Localization.Away h), ← Ideal.comap_comap,
        hQc, hq]
    obtain ⟨P, -, hPp, hPl⟩ := Ideal.exists_ideal_le_liesOver_of_le (p := p) Q
      (IsLocalRing.le_maximalIdeal ‹p.IsPrime›.ne_top)
    have x := (PrimeSpectrum.preimageEquivFiber R' (Localization.Away h) ⟨p, inferInstance⟩)
      ⟨⟨P, hPp⟩, PrimeSpectrum.ext hPl.over.symm⟩
    exact PrimeSpectrum.nonempty_iff_nontrivial.mp ⟨x⟩

  obtain ⟨h, hhq, c, hjc⟩ := choose_h
  refine ⟨h, hhq, ?_⟩
  intro p _ L _ _

  obtain ⟨⟨𝔓, h𝔓⟩, h𝔓c⟩ :=
    PrimeSpectrum.comap_surjective_of_faithfullyFlat (A := R') (B := Z) ⟨p, inferInstance⟩
  have hp𝔓 : p = 𝔓.comap (algebraMap R' Z) := (congrArg PrimeSpectrum.asIdeal h𝔓c).symm
  letI : Algebra p.ResidueField 𝔓.ResidueField :=
    (Ideal.ResidueField.map p 𝔓 (algebraMap R' Z) hp𝔓).toAlgebra
  obtain ⟨M, _, _, ⟨σ⟩, ⟨τ⟩⟩ := compositum p.ResidueField 𝔓.ResidueField L
  letI : Algebra 𝔓.ResidueField M := σ.toRingHom.toAlgebra
  letI : Algebra Z M := ((algebraMap 𝔓.ResidueField M).comp (algebraMap Z 𝔓.ResidueField)).toAlgebra
  haveI : IsScalarTower Z 𝔓.ResidueField M := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  letI : Algebra R' M := ((algebraMap Z M).comp (algebraMap R' Z)).toAlgebra
  haveI : IsScalarTower R' Z M := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI : IsScalarTower R' p.ResidueField M := by
    refine IsScalarTower.of_algebraMap_eq (fun r => ?_)
    have e1 : algebraMap p.ResidueField M (algebraMap R' p.ResidueField r) =
        σ (algebraMap p.ResidueField 𝔓.ResidueField (algebraMap R' p.ResidueField r)) :=
      (σ.commutes _).symm
    rw [e1]
    have e2 : algebraMap p.ResidueField 𝔓.ResidueField (algebraMap R' p.ResidueField r) =
        algebraMap Z 𝔓.ResidueField (algebraMap R' Z r) :=
      Ideal.ResidueField.map_algebraMap p 𝔓 (algebraMap R' Z) hp𝔓 r
    rw [e2]
    rfl

  let Ψ : TensorProduct Z (TensorProduct R' Z S) M ≃+* TensorProduct R' S M :=
    (Algebra.TensorProduct.comm Z (TensorProduct R' Z S) M).toRingEquiv.trans
      ((Algebra.TensorProduct.cancelBaseChange R' Z M M S).toRingEquiv.trans
        (Algebra.TensorProduct.comm R' M S).toRingEquiv)
  have hΨ : ∀ s : S, Ψ (TensorProduct.tmul Z
      (Algebra.TensorProduct.includeRight (R := R') (A := Z) (B := S) s) (1 : M)) =
      TensorProduct.tmul R' s (1 : M) := by
    intro s
    simp [Ψ, Algebra.TensorProduct.comm_tmul, Algebra.TensorProduct.cancelBaseChange_tmul]
  set e : TensorProduct R' S M := Ψ (TensorProduct.tmul Z hZ (1 : M)) with he
  set c'' : TensorProduct R' S M := Ψ (TensorProduct.tmul Z c (1 : M)) with hc''
  have hmul : TensorProduct.tmul R' h (1 : M) = e * c'' := by
    rw [← hΨ h, hjc, he, hc'', ← map_mul, Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_comm]

  have hdomE : IsDomain (Localization.Away e) := by
    haveI := H2 𝔓 M
    obtain ⟨i1⟩ := fibre_away_iso Z (TensorProduct R' Z S) M 𝔓 hZ
    obtain ⟨i2⟩ := away_congr Ψ (TensorProduct.tmul Z hZ (1 : M)) e rfl
    exact Function.Injective.isDomain (i1.trans i2).symm (i1.trans i2).symm.injective

  obtain ⟨j1⟩ := fibre_away_iso R' S M p h
  obtain ⟨j2⟩ := away_congr (RingEquiv.refl _) (TensorProduct.tmul R' h (1 : M)) (e * c'') hmul
  let isoP := j1.trans j2
  haveI hFnt : Nontrivial (p.Fiber (Localization.Away h)) := fibre_nontrivial h hhq p
  haveI : Nontrivial (TensorProduct p.ResidueField M (p.Fiber (Localization.Away h))) :=
    Module.FaithfullyFlat.lTensor_nontrivial p.ResidueField M _
  haveI : Nontrivial (Localization.Away (e * c'')) := isoP.injective.nontrivial
  haveI := away_mul_domain _ e c'' hdomE inferInstance
  haveI : IsDomain (TensorProduct p.ResidueField M (p.Fiber (Localization.Away h))) :=
    Function.Injective.isDomain isoP isoP.injective

  let ι := Algebra.TensorProduct.map τ (AlgHom.id p.ResidueField (p.Fiber (Localization.Away h)))
  have hι : Function.Injective ι := by
    have := Module.Flat.rTensor_preserves_injective_linearMap
      (M := p.Fiber (Localization.Away h)) τ.toLinearMap τ.toRingHom.injective
    exact this
  exact Function.Injective.isDomain ι hι

theorem wcpa_lfg_els_geom_integral_nbhd : ∀ (R T : Type u) [CommRing R] [IsLocalRing R] [CommRing T] [Algebra R T] (s : ℕ) [Algebra (MvPolynomial (Fin s) R) T] [IsScalarTower R (MvPolynomial (Fin s) R) T] [Algebra.Etale (MvPolynomial (Fin s) R) T] (q : Ideal T) [q.IsPrime], q.comap (algebraMap R T) = IsLocalRing.maximalIdeal R → (∀ x : q.ResidueField, IsIntegral R x → ∃ r : R, algebraMap R _ r = x) → ∃ (R' : Type u) (_ : CommRing R') (_ : IsLocalRing R') (_ : Algebra R R') (_ : Module.Flat R R') (_ : IsLocalHom (algebraMap R R')) (h : TensorProduct R R' T) (Q' : Ideal (Localization.Away h)) (_ : Q'.IsPrime), Function.Bijective (IsLocalRing.ResidueField.map (algebraMap R R')) ∧ Q'.comap (algebraMap R' (Localization.Away h)) = IsLocalRing.maximalIdeal R' ∧ (Q'.comap (algebraMap (TensorProduct R R' T) (Localization.Away h))).comap (Algebra.TensorProduct.includeRight (R := R) (A := R') (B := T)).toRingHom = q ∧ ∀ (p : Ideal R') [p.IsPrime] (L : Type u) [Field L] [Algebra p.ResidueField L], IsDomain (TensorProduct p.ResidueField L (p.Fiber (Localization.Away h))) :=
by
  intro R T _ _ _ _ s _ _ _ q _ hqR hres
  classical

  obtain ⟨g, hgq, hdom, halg⟩ := wcpa_lfg_els_gin_closed_component R T s q hqR hres

  haveI hTsm : Algebra.Smooth R T := Algebra.Smooth.comp R (MvPolynomial (Fin s) R) T
  haveI : Algebra.Smooth R (Localization.Away g) := Algebra.Smooth.comp R T (Localization.Away g)
  haveI : Algebra.Smooth (IsLocalRing.maximalIdeal R).ResidueField
      ((IsLocalRing.maximalIdeal R).Fiber (Localization.Away g)) := inferInstance

  have GI0 := wcpa_lfg_els_gin_field_geom_integral (IsLocalRing.maximalIdeal R).ResidueField
    ((IsLocalRing.maximalIdeal R).Fiber (Localization.Away g)) halg

  obtain ⟨Z₀, _, _, _, _, π, y₀, _, _, hy₀, hπg⟩ := wcpa_lfg_els_gin_qf_slice R T s g q hqR hgq
  obtain ⟨R', _, _, _, _, _, Z, _, _, _, _, _, _, ψ, hbij, hunit⟩ :=
    wcpa_lfg_els_gin_finite_free_nbhd R Z₀ y₀ hy₀
  set φ : TensorProduct R R' T →ₐ[R'] Z :=
    ψ.comp (Algebra.TensorProduct.map (AlgHom.id R' R') π) with hφ
  set g' : TensorProduct R R' T := Algebra.TensorProduct.includeRight (R := R) (A := R') (B := T) g
    with hg'
  have hφg : IsUnit (φ g') := by
    have : φ g' = ψ (Algebra.TensorProduct.includeRight (R := R) (A := R') (B := Z₀) (π g)) := by
      simp [hφ, hg', Algebra.TensorProduct.map_tmul]
    rw [this]
    exact hunit _ hπg

  have GI1 := wcpa_lfg_els_gin_closed_fibre_base_change R R' T g GI0
  have GI2 := wcpa_lfg_els_gin_closed_fibre_base_change R' Z (TensorProduct R R' T) g' GI1

  obtain ⟨𝔮, h𝔮p, h𝔮R', h𝔮T⟩ := wcpa_lfg_els_gin_prime_over_both R R' T q hqR
  haveI := h𝔮p
  have hg'𝔮 : g' ∉ 𝔮 := by
    intro hmem
    apply hgq
    have : g ∈ 𝔮.comap (Algebra.TensorProduct.includeRight (R := R) (A := R') (B := T)).toRingHom :=
      hmem
    rwa [h𝔮T] at this

  obtain ⟨hfin, hcontr⟩ := wcpa_lfg_els_gin_primes_over_finite R' Z (TensorProduct R R' T) 𝔮 h𝔮R'
  set gZ : TensorProduct R' Z (TensorProduct R R' T) :=
    Algebra.TensorProduct.includeRight (R := R') (A := Z) (B := TensorProduct R R' T) g' with hgZ

  set ε : TensorProduct R' Z (TensorProduct R R' T) →ₐ[Z] Z :=
    Algebra.TensorProduct.lift (AlgHom.id Z Z) φ (fun _ _ => Commute.all _ _) with hε
  have hεg : IsUnit (ε gZ) := by
    have : ε gZ = φ g' := by
      simp [hε, hgZ, Algebra.TensorProduct.lift_tmul]
    rw [this]
    exact hφg
  have hF : ∀ P ∈ {P : Ideal (TensorProduct R' Z (TensorProduct R R' T)) | P.IsPrime ∧
      P.comap (Algebra.TensorProduct.includeRight (R := R') (A := Z)
        (B := TensorProduct R R' T)).toRingHom = 𝔮},
      P.IsPrime ∧ P.comap (algebraMap Z (TensorProduct R' Z (TensorProduct R R' T))) =
        IsLocalRing.maximalIdeal Z ∧ gZ ∉ P := by
    rintro P ⟨hP, hPc⟩
    refine ⟨hP, hcontr P hP hPc, ?_⟩
    intro hmem
    apply hg'𝔮
    have : g' ∈ P.comap (Algebra.TensorProduct.includeRight (R := R') (A := Z)
        (B := TensorProduct R R' T)).toRingHom := hmem
    rwa [hPc] at this

  obtain ⟨hZ, -, hhZF, GIZ⟩ := wcpa_lfg_els_gin_section_connected Z
    (TensorProduct R' Z (TensorProduct R R' T)) ε gZ _ hfin hF hεg GI2

  obtain ⟨h, hh𝔮, GIh⟩ := wcpa_lfg_els_gin_descend_finite_free R' Z (TensorProduct R R' T) hZ 𝔮
    h𝔮R' (fun P hP hPc => hhZF P ⟨hP, hPc⟩) GIZ

  have hdisj : Disjoint (Submonoid.powers h : Set (TensorProduct R R' T)) (𝔮 : Set _) := by
    rw [Set.disjoint_left]
    intro x hx hx𝔮
    obtain ⟨n, rfl⟩ := hx
    exact hh𝔮 (h𝔮p.mem_of_pow_mem n hx𝔮)
  have hQp : (𝔮.map (algebraMap (TensorProduct R R' T) (Localization.Away h))).IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers h) _ 𝔮 h𝔮p hdisj
  have hQc : (𝔮.map (algebraMap (TensorProduct R R' T) (Localization.Away h))).comap
      (algebraMap (TensorProduct R R' T) (Localization.Away h)) = 𝔮 :=
    IsLocalization.comap_map_of_isPrime_disjoint (Submonoid.powers h) (Localization.Away h) h𝔮p
      hdisj
  refine ⟨R', inferInstance, inferInstance, inferInstance, inferInstance, inferInstance, h,
    𝔮.map (algebraMap (TensorProduct R R' T) (Localization.Away h)), hQp, hbij, ?_, ?_, GIh⟩
  · rw [IsScalarTower.algebraMap_eq R' (TensorProduct R R' T) (Localization.Away h),
      ← Ideal.comap_comap, hQc, h𝔮R']
  · rw [hQc]
    exact h𝔮T

theorem wcpa_lfg_els_smooth_chart_props : ∀ (R T R' : Type u) [CommRing R] [CommRing T] [Algebra R T] (s : ℕ) [Algebra (MvPolynomial (Fin s) R) T] [IsScalarTower R (MvPolynomial (Fin s) R) T] [Algebra.Etale (MvPolynomial (Fin s) R) T] [CommRing R'] [IsLocalRing R'] [Algebra R R'] (h : TensorProduct R R' T), (∀ (p : Ideal R') [p.IsPrime] (L : Type u) [Field L] [Algebra p.ResidueField L], IsDomain (TensorProduct p.ResidueField L (p.Fiber (Localization.Away h)))) → Algebra.FinitePresentation R' (Localization.Away h) ∧ Module.Flat R' (Localization.Away h) ∧ IsDomain (Localization.Away h ⧸ Ideal.map (algebraMap R' (Localization.Away h)) (IsLocalRing.maximalIdeal R')) ∧ ringKrullDim (Localization.Away h ⧸ Ideal.map (algebraMap R' (Localization.Away h)) (IsLocalRing.maximalIdeal R')) ≤ (s : WithBot ℕ∞) :=
by
  intro R T R' _ _ _ s _ _ _ _ _ _ h hgeom
  classical

  have etale_dim_le : ∀ (A E : Type u) [CommRing A] [CommRing E] [Algebra A E]
      [Algebra.Etale A E], ringKrullDim E ≤ ringKrullDim A := by
    intro A E _ _ _ _
    apply Order.krullDim_le_of_strictMono (PrimeSpectrum.comap (algebraMap A E))
    intro q q' hlt
    have hle : PrimeSpectrum.comap (algebraMap A E) q ≤ PrimeSpectrum.comap (algebraMap A E) q' :=
      Ideal.comap_mono hlt.le
    refine lt_of_le_of_ne hle ?_
    intro heq
    set p := PrimeSpectrum.comap (algebraMap A E) q with hp
    have hq1 : q.asIdeal.LiesOver p.asIdeal := ⟨by rw [Ideal.under_def]; rfl⟩
    have hq2 : q'.asIdeal.LiesOver p.asIdeal :=
      ⟨by rw [Ideal.under_def, heq]; rfl⟩
    let Q : p.asIdeal.primesOver E := ⟨q.asIdeal, q.isPrime, hq1⟩
    let Q' : p.asIdeal.primesOver E := ⟨q'.asIdeal, q'.isPrime, hq2⟩
    have hQQ : Q < Q' := hlt
    set e := PrimeSpectrum.primesOverOrderIsoFiber A E p.asIdeal
    have h2 : e Q < e Q' := e.lt_iff_lt.mpr hQQ
    have : Module.Finite p.asIdeal.ResidueField (p.asIdeal.Fiber E) :=
      Algebra.FormallyUnramified.finite_of_free _ _
    have : IsArtinianRing (p.asIdeal.Fiber E) :=
      IsArtinianRing.of_finite p.asIdeal.ResidueField _
    have hmax := IsArtinianRing.isMaximal_of_isPrime (e Q).asIdeal
    have h3 := hmax.eq_of_le (e Q').isPrime.ne_top h2.le
    exact h2.ne (PrimeSpectrum.ext h3)

  have away_quot_dim_le : ∀ (R' B : Type u) [CommRing R'] [CommRing B] [Algebra R' B]
      (I : Ideal R') (h : B),
      ringKrullDim (Localization.Away h ⧸ Ideal.map (algebraMap R' (Localization.Away h)) I) ≤
        ringKrullDim (B ⧸ Ideal.map (algebraMap R' B) I) := by
    intro R' B _ _ _ I h
    have H : Ideal.map (algebraMap R' B) I ≤ Ideal.comap (algebraMap B (Localization.Away h))
        (Ideal.map (algebraMap R' (Localization.Away h)) I) := by
      rw [← Ideal.map_le_iff_le_comap, Ideal.map_map, ← IsScalarTower.algebraMap_eq]
    apply Order.krullDim_le_of_strictMono (PrimeSpectrum.comap (Ideal.quotientMap _
      (algebraMap B (Localization.Away h)) H))
    apply Monotone.strictMono_of_injective
    · intro a b hab
      exact Ideal.comap_mono hab
    · have hc : (PrimeSpectrum.comap (Ideal.Quotient.mk (Ideal.map (algebraMap R' B) I))) ∘
          (PrimeSpectrum.comap (Ideal.quotientMap _ (algebraMap B (Localization.Away h)) H)) =
          (PrimeSpectrum.comap (algebraMap B (Localization.Away h))) ∘
            PrimeSpectrum.comap (Ideal.Quotient.mk
              (Ideal.map (algebraMap R' (Localization.Away h)) I)) := by
        funext x
        apply PrimeSpectrum.ext
        simp only [Function.comp_apply, PrimeSpectrum.comap_asIdeal, Ideal.comap_comap,
          Ideal.quotientMap_comp_mk]
      apply Function.Injective.of_comp
        (f := PrimeSpectrum.comap (Ideal.Quotient.mk (Ideal.map (algebraMap R' B) I)))
      rw [hc]
      exact (PrimeSpectrum.localization_comap_injective _ (Submonoid.powers h)).comp
        (PrimeSpectrum.comap_injective_of_surjective _ Ideal.Quotient.mk_surjective)

  have closed_fibre : ∀ (R' S : Type u) [CommRing R'] [IsLocalRing R'] [CommRing S]
      [Algebra R' S], Nonempty ((S ⧸ Ideal.map (algebraMap R' S) (IsLocalRing.maximalIdeal R'))
        ≃+* (IsLocalRing.maximalIdeal R').Fiber S) := by
    intro R' S _ _ _ _
    exact ⟨(Algebra.TensorProduct.quotIdealMapEquivTensorQuot S
        (IsLocalRing.maximalIdeal R')).toRingEquiv.trans
      ((Algebra.TensorProduct.comm R' S (R' ⧸ IsLocalRing.maximalIdeal R')).toRingEquiv.trans
        (Algebra.TensorProduct.congr
          (AlgEquiv.ofBijective (IsScalarTower.toAlgHom R' (R' ⧸ IsLocalRing.maximalIdeal R')
              (IsLocalRing.maximalIdeal R').ResidueField)
            (Ideal.bijective_algebraMap_quotient_residueField (IsLocalRing.maximalIdeal R')))
          (AlgEquiv.refl : S ≃ₐ[R'] S)).toRingEquiv)⟩

  have tensor_reassoc : ∀ (R A T k : Type u) [CommRing R] [CommRing A] [CommRing T] [CommRing k]
      [Algebra R A] [Algebra A T] [Algebra R T] [IsScalarTower R A T] [Algebra R k],
      Nonempty (TensorProduct R k T ≃+* TensorProduct A (TensorProduct R A k) T) := by
    intro R A T k _ _ _ _ _ _ _ _ _
    exact ⟨(Algebra.TensorProduct.comm R k T).toRingEquiv.trans
      ((Algebra.TensorProduct.cancelBaseChange R A A T k).symm.toRingEquiv.trans
        (Algebra.TensorProduct.comm A T (TensorProduct R A k)).toRingEquiv)⟩

  have poly_fibre_dim : ∀ (R k : Type u) [CommRing R] [Field k] [Algebra R k] (s : ℕ),
      ringKrullDim (TensorProduct R (MvPolynomial (Fin s) R) k) = (s : WithBot ℕ∞) := by
    intro R k _ _ _ s
    rw [ringKrullDim_eq_of_ringEquiv ((Algebra.TensorProduct.comm R (MvPolynomial (Fin s) R)
      k).toRingEquiv.trans (MvPolynomial.algebraTensorAlgEquiv R k).toRingEquiv),
      MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field,
      ENat.card_eq_coe_fintype_card, Fintype.card_fin, zero_add]
    rfl

  have : Algebra.FinitePresentation R T :=
    Algebra.FinitePresentation.trans R (MvPolynomial (Fin s) R) T
  have : Algebra.FinitePresentation R' (TensorProduct R R' T) :=
    Algebra.FinitePresentation.baseChange R'
  have : Module.Flat R T := Module.Flat.trans R (MvPolynomial (Fin s) R) T
  have : Module.Flat R' (TensorProduct R R' T) := Module.Flat.baseChange R R' T

  have hdom : IsDomain (Localization.Away h ⧸ Ideal.map (algebraMap R' (Localization.Away h))
      (IsLocalRing.maximalIdeal R')) := by
    have := hgeom (IsLocalRing.maximalIdeal R') (IsLocalRing.maximalIdeal R').ResidueField
    have : IsDomain ((IsLocalRing.maximalIdeal R').Fiber (Localization.Away h)) :=
      MulEquiv.isDomain _ (Algebra.TensorProduct.lid (IsLocalRing.maximalIdeal R').ResidueField
        ((IsLocalRing.maximalIdeal R').Fiber (Localization.Away h))).symm.toRingEquiv.toMulEquiv
    obtain ⟨e⟩ := closed_fibre R' (Localization.Away h)
    exact MulEquiv.isDomain _ e.toMulEquiv
  refine ⟨inferInstance, Localization.flat _ (Submonoid.powers h), hdom, ?_⟩

  have d1 := away_quot_dim_le R' (TensorProduct R R' T) (IsLocalRing.maximalIdeal R') h
  obtain ⟨e1⟩ := closed_fibre R' (TensorProduct R R' T)
  obtain ⟨e3⟩ := tensor_reassoc R (MvPolynomial (Fin s) R) T
    (IsLocalRing.maximalIdeal R').ResidueField
  have e2 := (Algebra.TensorProduct.cancelBaseChange R R'
    (IsLocalRing.maximalIdeal R').ResidueField (IsLocalRing.maximalIdeal R').ResidueField
    T).toRingEquiv
  have d2 := etale_dim_le (TensorProduct R (MvPolynomial (Fin s) R)
    (IsLocalRing.maximalIdeal R').ResidueField)
    (TensorProduct (MvPolynomial (Fin s) R) (TensorProduct R (MvPolynomial (Fin s) R)
      (IsLocalRing.maximalIdeal R').ResidueField) T)
  have d3 := poly_fibre_dim R (IsLocalRing.maximalIdeal R').ResidueField s
  rw [ringKrullDim_eq_of_ringEquiv (e1.trans (e2.trans e3))] at d1
  exact d1.trans (d2.trans d3.le)

