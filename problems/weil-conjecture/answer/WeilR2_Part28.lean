theorem wcpa_dj_flrg_plucker_glue : ∀ (k : Type u) [Field k] (N : ℕ) (B : Scheme.{u}) (sB : B ⟶ Spec (.of k)) (e₀ r : ℕ), r ≤ Module.finrank k (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k e₀) → ∀ (m' : ℕ) (D : Fin m' → B.Opens), (⨆ l, D l) = ⊤ → ∀ (m : Fin m' → Fin r → (Fin (N + 1) →₀ ℕ)) (F : ∀ l, Fin r → MvPolynomial (Fin (N + 1)) Γ(B, D l)), (∀ l, Function.Injective (m l)) → (∀ l a, (m l a).degree = e₀) → (∀ l a, (F l a).IsHomogeneous e₀) → (∀ l a a', (F l a).coeff (m l a') = if a = a' then 1 else 0) → (∀ (l l' : Fin m') (O : B.Opens) (hO : O ≤ D l) (hO' : O ≤ D l') (a : Fin r) (b : Fin (N + 1) →₀ ℕ), (B.presheaf.map (homOfLE hO').op).hom ((F l' a).coeff b) = ∑ a', (B.presheaf.map (homOfLE hO').op).hom ((F l' a).coeff (m l a')) * (B.presheaf.map (homOfLE hO).op).hom ((F l a').coeff b)) → ∃ (L : ℕ) (μ : B ⟶ wcProjK k L) (G : ∀ c : Fin (L + 1), Fin r → MvPolynomial (Fin (N + 1)) Γ(wcProjK k L, wcSgD k L c)), μ ≫ wcProjKStr k L = sB ∧ (∀ c, (∀ a, (G c a).IsHomogeneous e₀) ∧ ∃ m₀ : Fin r → (Fin (N + 1) →₀ ℕ), Function.Injective m₀ ∧ ∀ a a', (a = a' → (G c a).coeff (m₀ a') = 1) ∧ (a ≠ a' → (G c a).coeff (m₀ a') = 0)) ∧ ∀ (c : Fin (L + 1)) (l : Fin m') (O : B.Opens) (hO : O ≤ μ ⁻¹ᵁ wcSgD k L c) (hOl : O ≤ D l), ∃ P Q : Matrix (Fin r) (Fin r) Γ(B, O), (∀ a, MvPolynomial.map (μ.appLE (wcSgD k L c) O hO).hom (G c a) = ∑ a', MvPolynomial.C (P a a') * MvPolynomial.map (B.presheaf.map (homOfLE hOl).op).hom (F l a')) ∧ (∀ a, MvPolynomial.map (B.presheaf.map (homOfLE hOl).op).hom (F l a) = ∑ a', MvPolynomial.C (Q a a') * MvPolynomial.map (μ.appLE (wcSgD k L c) O hO).hom (G c a')) :=
by
  intro k _ N B sB e₀ r hr m' D hDcov m F hminj hmdeg hFhom hFnorm htrans
  classical
  letI hιfin : Fintype {d : Fin (N + 1) →₀ ℕ // d.degree = e₀} :=
    Fintype.subtype ((Finset.univ : Finset (Fin (N + 1))).finsuppAntidiag e₀) (fun d => by
      rw [Finset.mem_finsuppAntidiag, Finsupp.degree_eq_sum]; simp)

  have hNF : ∀ (R : Type u) [CommRing R] (F' : Fin r → MvPolynomial (Fin (N + 1)) R),
      (∀ a, (F' a).IsHomogeneous e₀) →
      ∀ (τ : Fin r → {d : Fin (N + 1) →₀ ℕ // d.degree = e₀}), Function.Injective τ →
      IsUnit (Matrix.of fun a a' => (F' a).coeff (τ a').1).det →
      ∀ (z : (Fin r → {d : Fin (N + 1) →₀ ℕ // d.degree = e₀}) → R),
      (∀ τ', z τ' * (Matrix.of fun a a' => (F' a).coeff (τ a').1).det =
        (Matrix.of fun a a' => (F' a).coeff (τ' a').1).det) →
      ∀ (H : Fin r → MvPolynomial (Fin (N + 1)) R),
      (∀ a, H a = MvPolynomial.monomial (τ a).1 1 +
        ∑ b ∈ Finset.univ.filter (fun b => ∀ a', τ a' ≠ b),
          MvPolynomial.monomial b.1 (z (Function.update τ a b))) →
      ∃ P Q : Matrix (Fin r) (Fin r) R, (∀ a, H a = ∑ a', MvPolynomial.C (P a a') * F' a') ∧
        (∀ a, F' a = ∑ a', MvPolynomial.C (Q a a') * H a') := by
    intro R _ F' hF' τ hτ hu z hz H hH
    set A : Matrix (Fin r) (Fin r) R := Matrix.of fun a a' => (F' a).coeff (τ a').1 with hA
    have hstar : ∀ a, H a = ∑ a', MvPolynomial.C (A⁻¹ a a') * F' a' := by
      intro a
      ext d
      rw [hH a, MvPolynomial.coeff_add, MvPolynomial.coeff_sum, MvPolynomial.coeff_sum]
      simp only [MvPolynomial.coeff_monomial, MvPolynomial.coeff_C_mul]
      by_cases hd : d.degree = e₀
      · obtain ⟨b0, rfl⟩ : ∃ b0 : {d : Fin (N + 1) →₀ ℕ // d.degree = e₀}, b0.1 = d :=
          ⟨⟨d, hd⟩, rfl⟩
        have e1 : ∀ b : {d : Fin (N + 1) →₀ ℕ // d.degree = e₀},
            (if b.1 = b0.1 then z (Function.update τ a b) else 0) =
            (if b = b0 then z (Function.update τ a b) else 0) := by
          intro b
          by_cases hb : b = b0
          · rw [if_pos (congrArg Subtype.val hb), if_pos hb]
          · rw [if_neg (fun h => hb (Subtype.ext h)), if_neg hb]
        simp only [e1]
        rw [Finset.sum_ite_eq']
        by_cases hb : ∃ a'', τ a'' = b0
        · obtain ⟨a'', rfl⟩ := hb
          have hnot : τ a'' ∉ Finset.univ.filter (fun b => ∀ a', τ a' ≠ b) := by simp
          rw [if_neg hnot, add_zero]
          have : ∑ x, A⁻¹ a x * (F' x).coeff (τ a'').1 = (A⁻¹ * A) a a'' := by
            rw [Matrix.mul_apply]; rfl
          rw [this, Matrix.nonsing_inv_mul A hu, Matrix.one_apply]
          by_cases haa : a = a''
          · subst haa; simp
          · rw [if_neg haa, if_neg (fun h => haa (hτ (Subtype.ext h)))]
        · push_neg at hb
          have hin : b0 ∈ Finset.univ.filter (fun b => ∀ a', τ a' ≠ b) := by simpa using hb
          rw [if_pos hin, if_neg (fun h => hb a (Subtype.ext h)), zero_add]
          have hcol : ∑ x, A⁻¹ a x * (F' x).coeff b0.1 =
              Ring.inverse A.det * (A.updateCol a (fun j => (F' j).coeff b0.1)).det := by
            rw [← Matrix.cramer_apply, Matrix.cramer_eq_adjugate_mulVec, Matrix.inv_def]
            simp only [Matrix.smul_apply, smul_eq_mul, mul_assoc, ← Finset.mul_sum]
            rfl
          have hupd : A.updateCol a (fun j => (F' j).coeff b0.1) =
              Matrix.of fun j a' => (F' j).coeff (Function.update τ a b0 a').1 := by
            ext j a'
            rw [Matrix.updateCol_apply, Matrix.of_apply, Function.update_apply]
            split_ifs <;> rfl
          rw [hcol, hupd, ← hz (Function.update τ a b0), mul_comm (Ring.inverse A.det), mul_assoc,
            Ring.mul_inverse_cancel _ hu, mul_one]
      · have h1 : ∀ x, (F' x).coeff d = 0 := fun x => (hF' x).coeff_eq_zero hd
        simp only [h1, mul_zero, Finset.sum_const_zero]
        rw [if_neg (fun h : (τ a).1 = d => hd (h ▸ (τ a).2)), zero_add]
        exact Finset.sum_eq_zero (fun b _ => if_neg (fun h : b.1 = d => hd (h ▸ b.2)))
    refine ⟨A⁻¹, A, hstar, ?_⟩
    intro a
    have e2 : ∑ a', MvPolynomial.C (A a a') * H a' =
        ∑ a'', MvPolynomial.C ((A * A⁻¹) a a'') * F' a'' := by
      simp_rw [hstar, Finset.mul_sum, ← mul_assoc, ← MvPolynomial.C_mul]
      rw [Finset.sum_comm]
      simp_rw [← Finset.sum_mul, ← map_sum, Matrix.mul_apply]
    rw [e2, Matrix.mul_nonsing_inv A hu]
    rw [Finset.sum_eq_single a
      (fun b _ hb => by rw [Matrix.one_apply_ne' hb, map_zero, zero_mul]) (by simp)]
    rw [Matrix.one_apply_eq, map_one, one_mul]

  have hC4 : ∀ (R : Type u) [CommRing R] (A A' : Matrix (Fin r) (Fin (N + 1) →₀ ℕ) R)
      (μ1 μ2 : Fin r → (Fin (N + 1) →₀ ℕ)),
      (∀ a a', A a (μ1 a') = if a = a' then 1 else 0) →
      (∀ a b, A' a b = ∑ a', A' a (μ1 a') * A a' b) →
      (∀ a b, A a b = ∑ a', A a (μ2 a') * A' a' b) →
      IsUnit (Matrix.of fun a a' => A' a (μ1 a')).det ∧
        ∀ τ : Fin r → (Fin (N + 1) →₀ ℕ), (A'.submatrix id τ).det =
          (Matrix.of fun a a' => A' a (μ1 a')).det * (A.submatrix id τ).det := by
    intro R _ A A' μ1 μ2 hn h1 h2
    have e1 : A' = (Matrix.of fun a a' => A' a (μ1 a')) * A := by
      ext a b; rw [Matrix.mul_apply]; exact h1 a b
    have e2 : A = (Matrix.of fun a a' => A a (μ2 a')) * A' := by
      ext a b; rw [Matrix.mul_apply]; exact h2 a b
    refine ⟨?_, ?_⟩
    · apply Matrix.isUnit_det_of_left_inverse (B := Matrix.of fun a a' => A a (μ2 a'))
      ext a a''
      have h3 : A = ((Matrix.of fun a a' => A a (μ2 a')) *
          (Matrix.of fun a a' => A' a (μ1 a'))) * A := by
        rw [Matrix.mul_assoc, ← e1, ← e2]
      have := congrFun (congrFun h3 a) (μ1 a'')
      rw [Matrix.mul_apply] at this
      simp only [hn, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq', Finset.mem_univ,
        if_true] at this
      rw [Matrix.one_apply, this]
    · intro τ
      rw [← Matrix.det_mul]
      congr 1
      ext a a'
      simp only [Matrix.submatrix_apply, Matrix.mul_apply, Matrix.of_apply, id]
      exact h1 a (τ a')

  have hcard : Fintype.card (Fin r) ≤ Fintype.card {d : Fin (N + 1) →₀ ℕ // d.degree = e₀} := by
    rw [Fintype.card_fin, ← Nat.card_eq_fintype_card, ← (wcpa_dj_flrg_hom_finrank k N e₀).2]
    exact hr
  obtain ⟨emb⟩ := Function.Embedding.nonempty_of_card_le hcard
  have hTpos : 0 < Fintype.card
      {τ : Fin r → {d : Fin (N + 1) →₀ ℕ // d.degree = e₀} // Function.Injective τ} :=
    Fintype.card_pos_iff.mpr ⟨⟨emb, emb.injective⟩⟩
  obtain ⟨L, hL⟩ : ∃ L, Fintype.card
      {τ : Fin r → {d : Fin (N + 1) →₀ ℕ // d.degree = e₀} // Function.Injective τ} = L + 1 :=
    ⟨_, (Nat.succ_pred_eq_of_pos hTpos).symm⟩
  obtain ⟨cidx⟩ : Nonempty (Fin (L + 1) ≃
      {τ : Fin r → {d : Fin (N + 1) →₀ ℕ // d.degree = e₀} // Function.Injective τ}) :=
    ⟨(Fintype.equivFinOfCardEq hL).symm⟩

  obtain ⟨s, hs_def⟩ : ∃ s : ∀ l, Fin (L + 1) → Γ(B, D l), ∀ l c,
      s l c = (Matrix.of fun a a' => (F l a).coeff ((cidx c).1 a').1).det := ⟨_, fun _ _ => rfl⟩
  obtain ⟨w, hw_def⟩ : ∃ w : ∀ i j, Γ(B, D i ⊓ D j), ∀ i j,
      w i j = (Matrix.of fun a a' => (B.presheaf.map
        (homOfLE (inf_le_right : D i ⊓ D j ≤ D j)).op).hom ((F j a).coeff (m i a'))).det :=
    ⟨_, fun _ _ => rfl⟩
  have hs : ∀ l, Ideal.span (Set.range (s l)) = ⊤ := by
    intro l
    let τl : {τ : Fin r → {d : Fin (N + 1) →₀ ℕ // d.degree = e₀} // Function.Injective τ} :=
      ⟨fun a => ⟨m l a, hmdeg l a⟩, fun a b h => hminj l (congrArg Subtype.val h)⟩
    have hmem : s l (cidx.symm τl) ∈ Ideal.span (Set.range (s l)) :=
      Ideal.subset_span (Set.mem_range_self (cidx.symm τl))
    have h1 : (Matrix.of fun a a' => (F l a).coeff (τl.1 a').1) = 1 := by
      ext a a'
      rw [Matrix.of_apply, Matrix.one_apply]
      exact hFnorm l a a'
    have hunit : IsUnit (s l (cidx.symm τl)) := by
      rw [hs_def, Equiv.apply_symm_apply, h1, Matrix.det_one]
      exact isUnit_one
    exact Ideal.eq_top_of_isUnit_mem _ hmem hunit
  have hC4ij : ∀ i j, IsUnit (w i j) ∧ ∀ J,
      (B.presheaf.map (homOfLE (inf_le_right : D i ⊓ D j ≤ D j)).op).hom (s j J) =
        w i j * (B.presheaf.map (homOfLE (inf_le_left : D i ⊓ D j ≤ D i)).op).hom (s i J) := by
    intro i j
    obtain ⟨h1, h2⟩ := hC4 _
      (Matrix.of fun a b =>
        (B.presheaf.map (homOfLE (inf_le_left : D i ⊓ D j ≤ D i)).op).hom ((F i a).coeff b))
      (Matrix.of fun a b =>
        (B.presheaf.map (homOfLE (inf_le_right : D i ⊓ D j ≤ D j)).op).hom ((F j a).coeff b))
      (m i) (m j)
      (fun a a' => by
        show (B.presheaf.map (homOfLE (inf_le_left : D i ⊓ D j ≤ D i)).op).hom
          ((F i a).coeff (m i a')) = _
        rw [hFnorm i a a']; split_ifs <;> simp)
      (fun a b => htrans i j (D i ⊓ D j) inf_le_left inf_le_right a b)
      (fun a b => htrans j i (D i ⊓ D j) inf_le_right inf_le_left a b)
    refine ⟨by rw [hw_def]; exact h1, fun J => ?_⟩
    rw [hs_def, hs_def, hw_def, RingHom.map_det, RingHom.map_det]
    exact h2 (fun a' => ((cidx J).1 a').1)

  obtain ⟨μ, hμ, hbas, hrel⟩ := wc_projK_glue_local_coords k L B sB D hDcov s hs w
    (fun i j => (hC4ij i j).1) (fun i j J => (hC4ij i j).2 J)

  obtain ⟨zc, hzc1, hzc2⟩ : ∃ zc : ∀ c : Fin (L + 1),
      (Fin r → {d : Fin (N + 1) →₀ ℕ // d.degree = e₀}) → Γ(wcProjK k L, wcSgD k L c),
      (∀ c τ' (h : Function.Injective τ'), zc c τ' = wcSgE k L c (cidx.symm ⟨τ', h⟩)) ∧
      (∀ c τ', ¬ Function.Injective τ' → zc c τ' = 0) :=
    ⟨fun c τ' => if h : Function.Injective τ' then wcSgE k L c (cidx.symm ⟨τ', h⟩) else 0,
      fun c τ' h => dif_pos h, fun c τ' h => dif_neg h⟩
  obtain ⟨G, hG⟩ : ∃ G : ∀ c : Fin (L + 1), Fin r → MvPolynomial (Fin (N + 1)) Γ(wcProjK k L, wcSgD k L c),
      ∀ c a, G c a = MvPolynomial.monomial ((cidx c).1 a).1 1 +
        ∑ b ∈ Finset.univ.filter (fun b => ∀ a', (cidx c).1 a' ≠ b),
          MvPolynomial.monomial b.1 (zc c (Function.update (cidx c).1 a b)) :=
    ⟨_, fun _ _ => rfl⟩
  have hkey : ∀ (l : Fin m') (O : B.Opens) (h : O ≤ D l)
      (τ' : Fin r → {d : Fin (N + 1) →₀ ℕ // d.degree = e₀}),
      (B.presheaf.map (homOfLE h).op).hom (Matrix.of fun a a' => (F l a).coeff (τ' a').1).det =
      (Matrix.of fun a a' =>
        (MvPolynomial.map (B.presheaf.map (homOfLE h).op).hom (F l a)).coeff (τ' a').1).det := by
    intro l O h τ'
    rw [RingHom.map_det, RingHom.mapMatrix_apply]
    congr 1
  refine ⟨L, μ, G, hμ, fun c => ⟨fun a => ?_, ?_⟩, fun c l O hO hOl => ?_⟩
  ·
    rw [hG]
    exact (MvPolynomial.isHomogeneous_monomial _ ((cidx c).1 a).2).add
      (MvPolynomial.IsHomogeneous.sum _ _ _ (fun b _ => MvPolynomial.isHomogeneous_monomial _ b.2))
  ·
    have hcoef : ∀ a a', (G c a).coeff ((cidx c).1 a').1 = if a = a' then 1 else 0 := by
      intro a a'
      rw [hG, MvPolynomial.coeff_add, MvPolynomial.coeff_sum]
      simp only [MvPolynomial.coeff_monomial]
      have hz0 : ∀ b ∈ Finset.univ.filter (fun b => ∀ a'', (cidx c).1 a'' ≠ b),
          (if b.1 = ((cidx c).1 a').1 then zc c (Function.update (cidx c).1 a b) else 0) = 0 := by
        intro b hb
        rw [Finset.mem_filter] at hb
        exact if_neg (fun e => hb.2 a' (Subtype.ext e).symm)
      rw [Finset.sum_eq_zero hz0, add_zero]
      by_cases h : a = a'
      · subst h; simp
      · rw [if_neg (fun e => h ((cidx c).2 (Subtype.ext e))), if_neg h]
    exact ⟨fun a => ((cidx c).1 a).1, fun x y h => (cidx c).2 (Subtype.ext h),
      fun a a' => ⟨fun h => by rw [hcoef, if_pos h], fun h => by rw [hcoef, if_neg h]⟩⟩
  ·
    have hb : O ≤ B.basicOpen (s l c) := by rw [← hbas l c]; exact le_inf hO hOl
    have hu0 : IsUnit ((B.presheaf.map (homOfLE (B.basicOpen_le (s l c))).op).hom (s l c)) :=
      RingedSpace.isUnit_res_basicOpen B.toRingedSpace (s l c)
    have hres : (B.presheaf.map (homOfLE hOl).op).hom (s l c) =
        (B.presheaf.map (homOfLE hb).op).hom
          ((B.presheaf.map (homOfLE (B.basicOpen_le (s l c))).op).hom (s l c)) := by
      show _ = (B.presheaf.map (homOfLE (B.basicOpen_le (s l c))).op ≫
        B.presheaf.map (homOfLE hb).op).hom (s l c)
      rw [← Functor.map_comp]; rfl
    have hu : IsUnit ((B.presheaf.map (homOfLE hOl).op).hom (s l c)) := by
      rw [hres]; exact hu0.map _
    rw [hs_def, hkey l O hOl (cidx c).1] at hu
    refine hNF _ (fun a => MvPolynomial.map (B.presheaf.map (homOfLE hOl).op).hom (F l a))
      (fun a => (hFhom l a).map _) (cidx c).1 (cidx c).2 hu
      (fun τ' => (μ.appLE (wcSgD k L c) O hO).hom (zc c τ')) ?_
      (fun a => MvPolynomial.map (μ.appLE (wcSgD k L c) O hO).hom (G c a)) ?_
    · intro τ'
      try dsimp only
      by_cases hτ' : Function.Injective τ'
      · have e : (μ.appLE (wcSgD k L c) O hO).hom (wcSgE k L c (cidx.symm ⟨τ', hτ'⟩)) *
            (B.presheaf.map (homOfLE hOl).op).hom (s l c) =
            (B.presheaf.map (homOfLE hOl).op).hom (s l (cidx.symm ⟨τ', hτ'⟩)) :=
          hrel l c (cidx.symm ⟨τ', hτ'⟩) O hO hOl
        rw [hs_def l c, hs_def l (cidx.symm ⟨τ', hτ'⟩), Equiv.apply_symm_apply,
          hkey l O hOl (cidx c).1] at e
        rw [hzc1 c τ' hτ', e]
        exact hkey l O hOl τ'
      · rw [hzc2 c τ' hτ', map_zero, zero_mul]
        obtain ⟨i, j, hij, hne⟩ := Function.not_injective_iff.mp hτ'
        exact (Matrix.det_zero_of_column_eq hne (fun x => by simp only [Matrix.of_apply, hij])).symm
    · intro a
      try dsimp only
      simp only [hG, map_add, map_sum, MvPolynomial.map_monomial, map_one]

theorem wcpa_dj_flrg_glue_verify : ∀ (k : Type u) [Field k] (N : ℕ) (B Z : Scheme.{u}) (sB : B ⟶ Spec (.of k)) (jZ : Z ⟶ wcProjK k N) (g : Z ⟶ B) (hZ : jZ ≫ wcProjKStr k N = g ≫ sB), IsClosedImmersion (Limits.pullback.lift jZ g hZ) → ∀ (e₀ r : ℕ) (Φ : ℕ → ℕ), (1 ≤ e₀ ∧ Φ e₀ + r = Module.finrank k (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k e₀) ∧ ∀ e, e₀ ≤ e → Φ (e + 1) = wcpaDjMacUp e (Φ e)) → ∀ (m' : ℕ) (D : Fin m' → B.Opens), (⨆ l, D l) = ⊤ → (∀ l, wcpaDjFlrgGood k N sB jZ g hZ e₀ r Φ (D l)) → ∃ (L : ℕ) (μ : B ⟶ wcProjK k L) (G : ∀ c : Fin (L + 1), Fin r → MvPolynomial (Fin (N + 1)) Γ(wcProjK k L, wcSgD k L c)), μ ≫ wcProjKStr k L = sB ∧ wcpaDjFlrgHilb k N sB jZ g hZ e₀ r L Φ μ G :=
by
  intro k _ N B Z sB jZ g hZ hε e₀ r Φ hH0 m' D hDcov hGood
  classical
  unfold wcpaDjFlrgGood at hGood
  choose hDaff m F hminj hmdeg hFhom hFnorm hFhilb hFloc using hGood
  have hr : r ≤ Module.finrank k (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k e₀) := by
    have := hH0.2.1
    omega
  have htrans : ∀ (l l' : Fin m') (O : B.Opens) (hO : O ≤ D l) (hO' : O ≤ D l') (a : Fin r)
      (b : Fin (N + 1) →₀ ℕ), (B.presheaf.map (homOfLE hO').op).hom ((F l' a).coeff b) =
        ∑ a', (B.presheaf.map (homOfLE hO').op).hom ((F l' a).coeff (m l a')) *
          (B.presheaf.map (homOfLE hO).op).hom ((F l a').coeff b) :=
    fun l l' O hO hO' a b =>
      wcpa_dj_flrg_overlap_transition k N B Z sB jZ g hZ e₀ r (D l) (D l') (m l) (F l) (F l')
        (hDaff l) (hDaff l') (hFnorm l) (fun t G hG hGh => (hFloc l t).2.2 G hG hGh)
        (fun t' a => (hFloc l' t').2.1 a) (hFhom l') O hO hO' a b
  obtain ⟨L, μ, G, hμ, hN0, hcmp⟩ :=
    wcpa_dj_flrg_plucker_glue k N B sB e₀ r hr m' D hDcov m F hminj hmdeg hFhom hFnorm htrans
  refine ⟨L, μ, G, hμ, ?_⟩
  unfold wcpaDjFlrgHilb
  refine ⟨hH0, hN0, ?_, ?_⟩
  ·
    intro c V hV i hVaff
    refine wcpa_dj_flrg_h1_criterion k N B Z sB jZ g hZ hε e₀ r V
      (fun a => MvPolynomial.map (μ.appLE (wcSgD k L c) V hV).hom (G c a)) hVaff
      (fun a => ((hN0 c).1 a).map _) ?_ i
    intro p hp
    have hpD : p ∈ ⨆ l, D l := by rw [hDcov]; trivial
    obtain ⟨l, hl⟩ := TopologicalSpace.Opens.mem_iSup.mp hpD
    obtain ⟨f, t, hft, hpf⟩ := exists_basicOpen_le_affine_inter hVaff (hDaff l) p ⟨hp, hl⟩
    have key : ∀ (W : B.Opens) (hWV : W ≤ V), W = B.basicOpen t →
        (∀ a, MvPolynomial.map (B.presheaf.map (homOfLE hWV).op).hom
            (MvPolynomial.map (μ.appLE (wcSgD k L c) V hV).hom (G c a)) ∈
              wcpaDjFlrgSat k N sB jZ g hZ W) ∧
        (∀ e, e₀ ≤ e → wcpaDjGen N (wcpaDjFlrgSat k N sB jZ g hZ W) e) ∧
        (∀ G' ∈ wcpaDjFlrgSat k N sB jZ g hZ W, G'.IsHomogeneous e₀ →
          G' ∈ Submodule.span Γ(B, W) (Set.range fun a =>
            MvPolynomial.map (B.presheaf.map (homOfLE hWV).op).hom
              (MvPolynomial.map (μ.appLE (wcSgD k L c) V hV).hom (G c a)))) := by
      rintro W hWV rfl
      obtain ⟨hGen, hMem, hSpan⟩ := hFloc l t
      obtain ⟨P, Q, hP, hQ⟩ := hcmp c l (B.basicOpen t) (hWV.trans hV) (B.basicOpen_le t)
      have hres : ∀ a, MvPolynomial.map (B.presheaf.map (homOfLE hWV).op).hom
          (MvPolynomial.map (μ.appLE (wcSgD k L c) V hV).hom (G c a)) =
          MvPolynomial.map (μ.appLE (wcSgD k L c) (B.basicOpen t) (hWV.trans hV)).hom (G c a) := by
        intro a
        rw [MvPolynomial.map_map, ← CommRingCat.hom_comp, Scheme.Hom.appLE_map]
      refine ⟨?_, hGen, ?_⟩
      · intro a
        rw [hres a, hP a]
        exact Ideal.sum_mem _ fun a' _ => Ideal.mul_mem_left _ _ (hMem a')
      · intro G' hG' hG'h
        refine Submodule.span_le.mpr ?_ (hSpan G' hG' hG'h)
        rintro _ ⟨a, rfl⟩
        rw [SetLike.mem_coe]
        dsimp only
        rw [hQ a]
        refine Submodule.sum_mem _ fun a' _ => ?_
        rw [← MvPolynomial.smul_eq_C_mul, ← hres a']
        exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨a', rfl⟩)
    exact ⟨B.basicOpen f, B.basicOpen_le f, f, rfl, hpf,
      key (B.basicOpen f) (B.basicOpen_le f) hft⟩
  ·
    intro c p hp e he
    have hpD : p ∈ ⨆ l, D l := by rw [hDcov]; trivial
    obtain ⟨l, hl⟩ := TopologicalSpace.Opens.mem_iSup.mp hpD
    obtain ⟨P, Q, hP, hQ⟩ := hcmp c l (μ ⁻¹ᵁ wcSgD k L c ⊓ D l) inf_le_left inf_le_right
    have hpO : p ∈ μ ⁻¹ᵁ wcSgD k L c ⊓ D l := ⟨hp, hl⟩
    have hle : ∀ (X Y : Fin r → MvPolynomial (Fin (N + 1)) Γ(B, μ ⁻¹ᵁ wcSgD k L c ⊓ D l))
        (R : Matrix (Fin r) (Fin r) Γ(B, μ ⁻¹ᵁ wcSgD k L c ⊓ D l)),
        (∀ a, X a = ∑ a', MvPolynomial.C (R a a') * Y a') →
        Ideal.span (Set.range fun a => MvPolynomial.map
          (B.presheaf.germ (μ ⁻¹ᵁ wcSgD k L c ⊓ D l) p hpO ≫ B.residue p).hom (X a)) ≤
        Ideal.span (Set.range fun a => MvPolynomial.map
          (B.presheaf.germ (μ ⁻¹ᵁ wcSgD k L c ⊓ D l) p hpO ≫ B.residue p).hom (Y a)) := by
      intro X Y R hXY
      rw [Ideal.span_le]
      rintro _ ⟨a, rfl⟩
      simp only [hXY a, map_sum, map_mul, MvPolynomial.map_C]
      exact Ideal.sum_mem _ fun a' _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨a', rfl⟩)
    have e1 : μ.app (wcSgD k L c) ≫ B.presheaf.germ (μ ⁻¹ᵁ wcSgD k L c) p hp =
        μ.appLE (wcSgD k L c) (μ ⁻¹ᵁ wcSgD k L c ⊓ D l) inf_le_left ≫
          B.presheaf.germ (μ ⁻¹ᵁ wcSgD k L c ⊓ D l) p hpO := by
      rw [← B.presheaf.germ_res (homOfLE (inf_le_left : μ ⁻¹ᵁ wcSgD k L c ⊓ D l ≤ μ ⁻¹ᵁ wcSgD k L c))
        p hpO, Scheme.Hom.app_eq_appLE, ← Category.assoc, Scheme.Hom.appLE_map]
    have e2 : B.presheaf.germ (D l) p hl =
        B.presheaf.map (homOfLE (inf_le_right : μ ⁻¹ᵁ wcSgD k L c ⊓ D l ≤ D l)).op ≫
          B.presheaf.germ (μ ⁻¹ᵁ wcSgD k L c ⊓ D l) p hpO :=
      (B.presheaf.germ_res _ p hpO).symm
    have eG : ∀ a, MvPolynomial.map (μ.app (wcSgD k L c) ≫
        B.presheaf.germ (μ ⁻¹ᵁ wcSgD k L c) p hp ≫ B.residue p).hom (G c a) =
        MvPolynomial.map (B.presheaf.germ (μ ⁻¹ᵁ wcSgD k L c ⊓ D l) p hpO ≫ B.residue p).hom
          (MvPolynomial.map (μ.appLE (wcSgD k L c) (μ ⁻¹ᵁ wcSgD k L c ⊓ D l) inf_le_left).hom
            (G c a)) := by
      intro a
      rw [MvPolynomial.map_map, ← Category.assoc, e1, Category.assoc]
      rfl
    have eF : ∀ a, MvPolynomial.map (B.presheaf.germ (D l) p hl ≫ B.residue p).hom (F l a) =
        MvPolynomial.map (B.presheaf.germ (μ ⁻¹ᵁ wcSgD k L c ⊓ D l) p hpO ≫ B.residue p).hom
          (MvPolynomial.map (B.presheaf.map
            (homOfLE (inf_le_right : μ ⁻¹ᵁ wcSgD k L c ⊓ D l ≤ D l)).op).hom (F l a)) := by
      intro a
      rw [MvPolynomial.map_map, e2, Category.assoc]
      rfl
    have hidl : Ideal.span (Set.range fun a => MvPolynomial.map (μ.app (wcSgD k L c) ≫
          B.presheaf.germ (μ ⁻¹ᵁ wcSgD k L c) p hp ≫ B.residue p).hom (G c a)) =
        Ideal.span (Set.range fun a =>
          MvPolynomial.map (B.presheaf.germ (D l) p hl ≫ B.residue p).hom (F l a)) := by
      simp only [eG, eF]
      exact le_antisymm (hle _ _ P hP) (hle _ _ Q hQ)
    rw [hidl]
    exact hFhilb l p hl e he

theorem wcpa_dj_flrg_hilbert_point : ∀ (k : Type u) [Field k] (X P : Scheme.{u}) [AlgebraicGeometry.IsIntegral P] (sP : P ⟶ Spec (.of k)) (f : X ⟶ P) (U : P.Opens) (N : ℕ) (jX : X ⟶ wcProjK k N) (hcomm : jX ≫ wcProjKStr k N = f ≫ sP) (hZ : (Limits.pullback.fst f U.ι ≫ jX) ≫ wcProjKStr k N = Limits.pullback.snd f U.ι ≫ U.ι ≫ sP), IsClosedImmersion jX → wcpaDjIsProjOver k sP → U ≠ ⊥ → Flat (f ∣_ U) → ∃ (e₀ r L : ℕ) (Φ : ℕ → ℕ) (μ : U.toScheme ⟶ wcProjK k L) (G : ∀ c : Fin (L + 1), Fin r → MvPolynomial (Fin (N + 1)) Γ(wcProjK k L, wcSgD k L c)), μ ≫ wcProjKStr k L = U.ι ≫ sP ∧ wcpaDjFlrgHilb k N (U.ι ≫ sP) (Limits.pullback.fst f U.ι ≫ jX) (Limits.pullback.snd f U.ι) hZ e₀ r L Φ μ G :=
by
  intro k _ X P _ sP f U N jX hcomm hZ hjX hP hU hfl
  obtain ⟨hgflat, hε, hUint, hUnoeth, hUcpt⟩ :=
    wcpa_dj_flrg_hp_basic k X P sP f U N jX hcomm hZ hjX hP hU hfl
  obtain ⟨m, V, E, hE1, hVaff, hVcov, hVproj⟩ :=
    wcpa_dj_flrg_serre_cover k N U.toScheme (Limits.pullback f U.ι) (U.ι ≫ sP)
      (Limits.pullback.fst f U.ι ≫ jX) (Limits.pullback.snd f U.ι) hZ hε hgflat hUnoeth hUcpt
  obtain ⟨e₀, r, Φ, hEe₀, hH0, hfib⟩ :=
    wcpa_dj_flrg_numerics k N U.toScheme (Limits.pullback f U.ι) (U.ι ≫ sP)
      (Limits.pullback.fst f U.ι ≫ jX) (Limits.pullback.snd f U.ι) hZ hε hUint m V E hE1
      hVaff hVcov hVproj
  obtain ⟨m', D, hDcov, hDgood⟩ :=
    wcpa_dj_flrg_good_cover k N U.toScheme (Limits.pullback f U.ι) (U.ι ≫ sP)
      (Limits.pullback.fst f U.ι ≫ jX) (Limits.pullback.snd f U.ι) hZ hε hUint hUcpt m V E hE1
      hVaff hVcov hVproj e₀ r Φ hEe₀ hH0 hfib
  obtain ⟨L, μ, G, hμ, hHilb⟩ :=
    wcpa_dj_flrg_glue_verify k N U.toScheme (Limits.pullback f U.ι) (U.ι ≫ sP)
      (Limits.pullback.fst f U.ι ≫ jX) (Limits.pullback.snd f U.ι) hZ hε e₀ r Φ hH0 m' D
      hDcov hDgood
  exact ⟨e₀, r, L, Φ, μ, G, hμ, hHilb⟩

theorem wcpa_dj_flrg_homog_component_span : ∀ (R : Type u) [CommRing R] (N e₀ r : ℕ) (G : Fin r → MvPolynomial (Fin (N + 1)) R), (∀ a, (G a).IsHomogeneous e₀) → ∀ (e : ℕ) (H : MvPolynomial (Fin (N + 1)) R), H ∈ Ideal.span (Set.range G) → H.IsHomogeneous e → H ∈ Submodule.span R {P | ∃ (μ : Fin (N + 1) →₀ ℕ) (a : Fin r), μ.degree + e₀ = e ∧ P = MvPolynomial.monomial μ 1 * G a} :=
by
  intro R _ N e₀ r G hG e H hH hHe
  classical
  set S := Submodule.span R {P : MvPolynomial (Fin (N + 1)) R | ∃ (μ : Fin (N + 1) →₀ ℕ) (a : Fin r),
    μ.degree + e₀ = e ∧ P = MvPolynomial.monomial μ 1 * G a} with hS
  obtain ⟨c, hc⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hH
  have key : ∀ (a : Fin r) (p : MvPolynomial (Fin (N + 1)) R),
      MvPolynomial.homogeneousComponent e (p * G a) ∈ S := by
    intro a p
    induction p using MvPolynomial.induction_on' with
    | monomial ν t =>
      have hT : MvPolynomial.monomial ν (1 : R) * G a ∈
          MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R (ν.degree + e₀) := by
        rw [MvPolynomial.mem_homogeneousSubmodule]
        exact (MvPolynomial.isHomogeneous_monomial (1 : R) rfl).mul (hG a)
      have h1 : MvPolynomial.monomial ν t * G a = t • (MvPolynomial.monomial ν (1 : R) * G a) := by
        rw [← smul_mul_assoc, MvPolynomial.smul_monomial, smul_eq_mul, mul_one]
      rw [h1, map_smul, MvPolynomial.homogeneousComponent_of_mem hT]
      apply Submodule.smul_mem
      split_ifs with h
      · exact Submodule.subset_span ⟨ν, a, h.symm, rfl⟩
      · exact Submodule.zero_mem _
    | add p q hp hq =>
      rw [add_mul, map_add]
      exact Submodule.add_mem _ hp hq
  have hHH : H = MvPolynomial.homogeneousComponent e H :=
    (MvPolynomial.homogeneousComponent_eq_self hHe).symm
  rw [hHH, ← hc, map_sum]
  exact Submodule.sum_mem _ (fun a _ => key a (c a))

theorem wcpa_dj_flrg_homog_free_finite : ∀ (R : Type u) [CommRing R] (N e : ℕ), Module.Free R ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R e) ∧ Module.Finite R ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R e) :=
by
  intro R _ N e
  let E : ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R e) ≃ₗ[R]
      (↥({d : Fin (N + 1) →₀ ℕ | d.degree = e} : Set (Fin (N + 1) →₀ ℕ)) →₀ R) :=
    (LinearEquiv.ofEq _ _
      (MvPolynomial.homogeneousSubmodule_eq_finsupp_supported (Fin (N + 1)) R e)).trans
      (AddMonoidAlgebra.supportedEquivFinsupp (R := R) (S := R)
        {d : Fin (N + 1) →₀ ℕ | d.degree = e})
  haveI hS : Finite ↥({d : Fin (N + 1) →₀ ℕ | d.degree = e} : Set (Fin (N + 1) →₀ ℕ)) :=
    Set.Finite.to_subtype
      ((Finsupp.finite_of_degree_le (σ := Fin (N + 1)) e).subset
        (fun d (hd : d.degree = e) => le_of_eq hd))
  exact ⟨Module.Free.of_equiv E.symm, Module.Finite.equiv E.symm⟩

theorem wcpa_dj_flrg_normal_form_hilb : ∀ (K : Type u) [Field K] (N e₀ r : ℕ) (G : Fin r → MvPolynomial (Fin (N + 1)) K), (∀ a, (G a).IsHomogeneous e₀) → (∃ m : Fin r → (Fin (N + 1) →₀ ℕ), Function.Injective m ∧ ∀ a a', (a = a' → (G a).coeff (m a') = 1) ∧ (a ≠ a' → (G a).coeff (m a') = 0)) → wcpaDjHilbFn K N (Ideal.span (Set.range G)) e₀ + r = Nat.card {d : Fin (N + 1) →₀ ℕ // d.degree = e₀} :=
by
  intro K _ N e₀ r G hG hmex
  obtain ⟨m, _hminj, hm⟩ := hmex
  classical

  have hslice : ∀ (c g : MvPolynomial (Fin (N + 1)) K), g.IsHomogeneous e₀ →
      MvPolynomial.homogeneousComponent e₀ (c * g) = MvPolynomial.C (c.coeff 0) * g := by
    intro c g hg
    ext d
    rw [MvPolynomial.coeff_homogeneousComponent, MvPolynomial.coeff_C_mul]
    split_ifs with hd
    · rw [MvPolynomial.coeff_mul, Finset.sum_eq_single (0, d)]
      · intro x hx hne
        by_cases hgx : g.coeff x.2 = 0
        · rw [hgx, mul_zero]
        · exfalso
          have h2 : x.2.degree = e₀ := by
            by_contra h
            exact hgx (hg.coeff_eq_zero h)
          have hx' : x.1 + x.2 = d := Finset.HasAntidiagonal.mem_antidiagonal.mp hx
          have h3 : x.1.degree + x.2.degree = d.degree := by
            rw [← hx']
            exact (map_add _ _ _).symm
          have h1 : x.1 = 0 := by
            rw [← Finsupp.degree_eq_zero_iff]
            omega
          apply hne
          have h4 : x.2 = d := by rw [← hx', h1, zero_add]
          exact Prod.ext h1 h4
      · intro h
        exact absurd (Finset.HasAntidiagonal.mem_antidiagonal.mpr (zero_add d)) h
    · rw [hg.coeff_eq_zero hd, mul_zero]

  have hfinrank : Module.Finite K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e₀) ∧
      Module.finrank K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e₀) =
        Nat.card {d : Fin (N + 1) →₀ ℕ // d.degree = e₀} := by
    let S0 : Set (Fin (N + 1) →₀ ℕ) := {d | d.degree = e₀}
    have hS0 : S0.Finite :=
      (Finsupp.finite_of_degree_le (σ := Fin (N + 1)) e₀).subset (fun d hd => le_of_eq hd)
    have : Finite ↥S0 := Set.finite_coe_iff.mpr hS0
    have heq := MvPolynomial.homogeneousSubmodule_eq_finsupp_supported (Fin (N + 1)) K e₀
    let φ : ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e₀) ≃ₗ[K] (↥S0 →₀ K) :=
      (LinearEquiv.ofEq _ _ heq).trans (AddMonoidAlgebra.supportedEquivFinsupp S0)
    let b : Module.Basis ↥S0 K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e₀) :=
      (Finsupp.basisSingleOne).map φ.symm
    refine ⟨Module.Finite.of_basis b, ?_⟩
    rw [Module.finrank_eq_nat_card_basis b]
    rfl
  obtain ⟨hfin, hrank⟩ := hfinrank
  set S := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e₀ with hS
  let g : Fin r → S := fun a =>
    ⟨G a, (MvPolynomial.mem_homogeneousSubmodule e₀ (G a)).mpr (hG a)⟩
  set W : Submodule K S := Submodule.comap S.subtype
    (Submodule.restrictScalars K (Ideal.span (Set.range G))) with hW
  have hWspan : W = Submodule.span K (Set.range g) := by
    apply le_antisymm
    · rintro ⟨H, hH⟩ hHW
      have hHI : H ∈ Ideal.span (Set.range G) := hHW
      have hHh : H.IsHomogeneous e₀ := (MvPolynomial.mem_homogeneousSubmodule e₀ H).mp hH
      obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hHI
      have hHeq : H = ∑ a, (c a).coeff 0 • G a := by
        calc H = MvPolynomial.homogeneousComponent e₀ H :=
              (MvPolynomial.homogeneousComponent_eq_self hHh).symm
          _ = MvPolynomial.homogeneousComponent e₀ (∑ a, c a * G a) := by rw [hc]
          _ = ∑ a, MvPolynomial.homogeneousComponent e₀ (c a * G a) := map_sum _ _ _
          _ = ∑ a, MvPolynomial.C ((c a).coeff 0) * G a :=
              Finset.sum_congr rfl (fun a _ => hslice _ _ (hG a))
          _ = ∑ a, (c a).coeff 0 • G a := by simp only [MvPolynomial.C_mul']
      have hx : (⟨H, hH⟩ : S) = ∑ a, (c a).coeff 0 • g a := by
        apply Subtype.ext
        rw [Submodule.coe_sum]
        simp only [Submodule.coe_smul]
        exact hHeq
      rw [hx]
      exact Submodule.sum_mem _ (fun a _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨a, rfl⟩))
    · rw [Submodule.span_le]
      rintro _ ⟨a, rfl⟩
      show G a ∈ Ideal.span (Set.range G)
      exact Ideal.subset_span ⟨a, rfl⟩
  have hli : LinearIndependent K g := by
    rw [Fintype.linearIndependent_iff]
    intro l hl a'
    have h1 : ∑ a, l a • G a = 0 := by
      have := congrArg Subtype.val hl
      rw [Submodule.coe_sum] at this
      simpa only [Submodule.coe_smul, ZeroMemClass.coe_zero] using this
    have h2 := congrArg (fun p : MvPolynomial (Fin (N + 1)) K => p.coeff (m a')) h1
    simp only [MvPolynomial.coeff_sum, MvPolynomial.coeff_zero, MvPolynomial.coeff_smul,
      smul_eq_mul] at h2
    rw [Finset.sum_eq_single a'] at h2
    · rw [(hm a' a').1 rfl, mul_one] at h2
      exact h2
    · intro b _ hb
      rw [(hm b a').2 hb, mul_zero]
    · intro h
      exact absurd (Finset.mem_univ a') h
  have hWr : Module.finrank K W = r := by
    rw [hWspan, finrank_span_eq_card hli, Fintype.card_fin]
  have hrn := Submodule.finrank_quotient_add_finrank W
  show Module.finrank K (S ⧸ W) + r = _
  rw [← hrank, ← hWr]
  exact hrn

theorem wcpa_dj_flrg_macup_mono : ∀ (e a b : ℕ), a ≤ b → wcpaDjMacUp e a ≤ wcpaDjMacUp e b :=
by
  have F0 : ∀ d a : ℕ, a + 1 ≤ Nat.choose (a + d + 1) (d + 1) := by
    intro d a
    induction d with
    | zero => simp
    | succ d ih =>
      have h : Nat.choose (a + (d + 1) + 1) (d + 1 + 1) =
          Nat.choose (a + d + 1) (d + 1) + Nat.choose (a + d + 1) (d + 1 + 1) :=
        Nat.choose_succ_succ _ _
      rw [h]
      omega
  have spec : ∀ d a : ℕ,
      Nat.choose (Nat.findGreatest (fun k => Nat.choose k (d + 1) ≤ a) (a + d + 1)) (d + 1) ≤ a ∧
      a < Nat.choose (Nat.findGreatest (fun k => Nat.choose k (d + 1) ≤ a) (a + d + 1) + 1)
        (d + 1) := by
    intro d a
    set κ := Nat.findGreatest (fun k => Nat.choose k (d + 1) ≤ a) (a + d + 1) with hκ
    have h1 : Nat.choose κ (d + 1) ≤ a :=
      Nat.findGreatest_spec (P := fun k => Nat.choose k (d + 1) ≤ a) (Nat.zero_le (a + d + 1))
        (by simp)
    refine ⟨h1, ?_⟩
    have hle : κ ≤ a + d + 1 := Nat.findGreatest_le _
    rcases Nat.lt_or_ge κ (a + d + 1) with h | h
    · have h2 := Nat.findGreatest_is_greatest (P := fun k => Nat.choose k (d + 1) ≤ a)
        (Nat.lt_succ_self κ) (Nat.succ_le_of_lt h)
      exact not_le.mp h2
    · have h3 : κ = a + d + 1 := le_antisymm hle h
      rw [h3] at h1
      have := F0 d a
      omega
  have s2 : ∀ d κ ρ : ℕ, ρ < Nat.choose κ d → wcpaDjMacUp d ρ < Nat.choose (κ + 1) (d + 1) := by
    intro d
    induction d with
    | zero => intro κ ρ _; simp [wcpaDjMacUp]
    | succ d ih =>
      intro κ ρ hρ
      obtain ⟨h1, h2⟩ := spec d ρ
      have hU : wcpaDjMacUp (d + 1) ρ =
          Nat.choose (Nat.findGreatest (fun k => Nat.choose k (d + 1) ≤ ρ) (ρ + d + 1) + 1) (d + 2) +
          wcpaDjMacUp d (ρ - Nat.choose
            (Nat.findGreatest (fun k => Nat.choose k (d + 1) ≤ ρ) (ρ + d + 1)) (d + 1)) := by
        rw [wcpaDjMacUp]
      rw [hU]
      set κ' := Nat.findGreatest (fun k => Nat.choose k (d + 1) ≤ ρ) (ρ + d + 1) with hκ'
      have hp1 : Nat.choose (κ' + 1) (d + 1) = Nat.choose κ' d + Nat.choose κ' (d + 1) :=
        Nat.choose_succ_succ _ _
      have hr : ρ - Nat.choose κ' (d + 1) < Nat.choose κ' d := by omega
      have hih := ih κ' _ hr
      have hpas : Nat.choose (κ' + 2) (d + 2) =
          Nat.choose (κ' + 1) (d + 1) + Nat.choose (κ' + 1) (d + 2) :=
        Nat.choose_succ_succ _ _
      have hlt : κ' < κ := by
        by_contra hc
        have := Nat.choose_le_choose (d + 1) (not_lt.mp hc)
        omega
      have hmono := Nat.choose_le_choose (d + 2) (show κ' + 2 ≤ κ + 1 by omega)
      show _ < Nat.choose (κ + 1) (d + 2)
      omega
  have s3 : ∀ e a : ℕ, wcpaDjMacUp e a ≤ wcpaDjMacUp e (a + 1) := by
    intro e
    induction e with
    | zero => intro a; simp [wcpaDjMacUp]
    | succ d ih =>
      intro a
      obtain ⟨h1, h2⟩ := spec d a
      obtain ⟨h1', h2'⟩ := spec d (a + 1)
      have hU : wcpaDjMacUp (d + 1) a =
          Nat.choose (Nat.findGreatest (fun k => Nat.choose k (d + 1) ≤ a) (a + d + 1) + 1) (d + 2) +
          wcpaDjMacUp d (a - Nat.choose
            (Nat.findGreatest (fun k => Nat.choose k (d + 1) ≤ a) (a + d + 1)) (d + 1)) := by
        rw [wcpaDjMacUp]
      have hU' : wcpaDjMacUp (d + 1) (a + 1) =
          Nat.choose (Nat.findGreatest (fun k => Nat.choose k (d + 1) ≤ a + 1) (a + 1 + d + 1) + 1)
            (d + 2) +
          wcpaDjMacUp d (a + 1 - Nat.choose
            (Nat.findGreatest (fun k => Nat.choose k (d + 1) ≤ a + 1) (a + 1 + d + 1)) (d + 1)) := by
        rw [wcpaDjMacUp]
      rw [hU, hU']
      set κ := Nat.findGreatest (fun k => Nat.choose k (d + 1) ≤ a) (a + d + 1) with hκ
      set κ₁ := Nat.findGreatest (fun k => Nat.choose k (d + 1) ≤ a + 1) (a + 1 + d + 1) with hκ₁
      have hb : κ ≤ a + d + 1 := Nat.findGreatest_le _
      have hle : κ ≤ κ₁ :=
        Nat.le_findGreatest (P := fun k => Nat.choose k (d + 1) ≤ a + 1) (by omega)
          (show Nat.choose κ (d + 1) ≤ a + 1 by omega)
      rcases Nat.eq_or_lt_of_le hle with h | h
      · rw [← h]
        have e1 : a + 1 - Nat.choose κ (d + 1) = (a - Nat.choose κ (d + 1)) + 1 := by omega
        rw [e1]
        exact Nat.add_le_add_left (ih _) _
      · have hp1 : Nat.choose (κ + 1) (d + 1) = Nat.choose κ d + Nat.choose κ (d + 1) :=
          Nat.choose_succ_succ _ _
        have hr : a - Nat.choose κ (d + 1) < Nat.choose κ d := by omega
        have hs := s2 d κ _ hr
        have hpas : Nat.choose (κ + 2) (d + 2) =
            Nat.choose (κ + 1) (d + 1) + Nat.choose (κ + 1) (d + 2) :=
          Nat.choose_succ_succ _ _
        have hmono := Nat.choose_le_choose (d + 2) (show κ + 2 ≤ κ₁ + 1 by omega)
        omega
  intro e a b hab
  exact monotone_nat_of_le_succ (f := wcpaDjMacUp e) (s3 e) hab

theorem wcpa_dj_flrg_fibre_finrank : ∀ (B : Type u) [CommRing B] (K : Type u) [Field K] [Algebra B K] (N e₀ r : ℕ) (F : Fin r → MvPolynomial (Fin (N + 1)) B), (∀ a, (F a).IsHomogeneous e₀) → ∀ e, Module.finrank K (TensorProduct B K (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B e) ⧸ Submodule.comap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B e).subtype (Submodule.restrictScalars B (Ideal.span (Set.range F))))) = wcpaDjHilbFn K N (Ideal.span (Set.range fun a => MvPolynomial.map (algebraMap B K) (F a))) e :=
by
  intro B _ K _ _ N e₀ r F hF e
  classical

  have hc1 : ∀ (S S' : Type u) [AddCommGroup S] [Module B S] [AddCommGroup S'] [Module K S']
      [Module B S'] [IsScalarTower B K S'] (φ : S →ₗ[B] S') (W : Submodule B S)
      (W' : Submodule K S'), IsBaseChange K φ → (∀ w ∈ W, φ w ∈ W') →
      (∀ w' ∈ W', w' ∈ Submodule.span K (φ '' W)) →
      Module.finrank K (TensorProduct B K (S ⧸ W)) = Module.finrank K (S' ⧸ W') := by
    intro S S' _ _ _ _ _ _ φ W W' h h2 h3
    let l₀ : S →ₗ[B] S' ⧸ W' := (W'.mkQ.restrictScalars B) ∘ₗ φ
    have hl₀ : W ≤ LinearMap.ker l₀ := fun w hw => by
      rw [LinearMap.mem_ker]
      show (Submodule.Quotient.mk (φ w) : S' ⧸ W') = 0
      exact (Submodule.Quotient.mk_eq_zero W').mpr (h2 w hw)
    let l : S ⧸ W →ₗ[B] S' ⧸ W' := W.liftQ l₀ hl₀
    let α : TensorProduct B K (S ⧸ W) →ₗ[K] S' ⧸ W' := LinearMap.liftBaseChange K l
    let g : S →ₗ[B] TensorProduct B K (S ⧸ W) := (TensorProduct.mk B K (S ⧸ W) 1) ∘ₗ W.mkQ
    let β₀ : S' →ₗ[K] TensorProduct B K (S ⧸ W) := h.lift g
    have hKI : ∀ s, β₀ (φ s) = (1 : K) ⊗ₜ[B] (Submodule.Quotient.mk s : S ⧸ W) :=
      fun s => h.lift_eq g s
    have hβ₀ : W' ≤ LinearMap.ker β₀ := by
      intro w' hw'
      refine (Submodule.span_le.mpr ?_) (h3 w' hw')
      rintro _ ⟨w, hw, rfl⟩
      rw [SetLike.mem_coe, LinearMap.mem_ker, hKI, (Submodule.Quotient.mk_eq_zero W).mpr hw,
        TensorProduct.tmul_zero]
    let β : S' ⧸ W' →ₗ[K] TensorProduct B K (S ⧸ W) := W'.liftQ β₀ hβ₀
    have e1 : ∀ s, l (Submodule.Quotient.mk s) = Submodule.Quotient.mk (φ s) := fun s => rfl
    have e2 : ∀ y, β (Submodule.Quotient.mk y) = β₀ y := fun y => rfl
    have hαβ : α ∘ₗ β = LinearMap.id := by
      apply Submodule.linearMap_qext
      apply h.algHom_ext
      intro s
      show α (β (Submodule.Quotient.mk (φ s))) = Submodule.Quotient.mk (φ s)
      rw [e2, hKI]
      show LinearMap.liftBaseChange K l ((1 : K) ⊗ₜ[B] Submodule.Quotient.mk s) = _
      rw [LinearMap.liftBaseChange_tmul, one_smul, e1]
    have hβα : β ∘ₗ α = LinearMap.id := by
      apply LinearMap.ext
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul c m =>
        obtain ⟨s, rfl⟩ := Submodule.Quotient.mk_surjective W m
        show β (LinearMap.liftBaseChange K l (c ⊗ₜ[B] Submodule.Quotient.mk s)) = _
        rw [LinearMap.liftBaseChange_tmul, map_smul, e1, e2, hKI, TensorProduct.smul_tmul',
          smul_eq_mul, mul_one]
        rfl
      | add x y hx hy =>
        rw [map_add, hx, hy, map_add]
    exact LinearEquiv.finrank_eq (LinearEquiv.ofLinear α β hαβ hβα)

  have hbasis : ∀ (R : Type u) [CommRing R], ∃ b : Module.Basis {d : Fin (N + 1) →₀ ℕ // d.degree = e}
      R ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R e),
      ∀ μ, (b μ : MvPolynomial (Fin (N + 1)) R) = MvPolynomial.monomial μ.1 1 := by
    intro R _
    let v : {d : Fin (N + 1) →₀ ℕ // d.degree = e} → MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R e :=
      fun μ => ⟨MvPolynomial.monomial μ.1 1, (MvPolynomial.mem_homogeneousSubmodule _ _).2
        (MvPolynomial.isHomogeneous_monomial _ μ.2)⟩
    have hv : (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R e).subtype ∘ v =
        (MvPolynomial.basisMonomials (Fin (N + 1)) R) ∘ Subtype.val := by
      funext μ
      simp [v, MvPolynomial.coe_basisMonomials]
    have hli : LinearIndependent R v := by
      apply LinearIndependent.of_comp (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R e).subtype
      rw [hv]
      exact (MvPolynomial.basisMonomials (Fin (N + 1)) R).linearIndependent.comp _
        Subtype.val_injective
    have hsp : ⊤ ≤ Submodule.span R (Set.range v) := by
      rintro ⟨q, hq⟩ -
      have h1 : q ∈
          Submodule.span R ((MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R e).subtype ''
            Set.range v) := by
        have hqh : q.IsHomogeneous e := (MvPolynomial.mem_homogeneousSubmodule _ _).1 hq
        rw [MvPolynomial.as_sum q]
        refine Submodule.sum_mem _ (fun d hd => ?_)
        have hdeg : d.degree = e := by
          have h2 := hqh (MvPolynomial.mem_support_iff.mp hd)
          first
          | exact h2
          | (rw [Finsupp.degree_eq_weight_one]; exact h2)
        have h3 : MvPolynomial.monomial d (q.coeff d) =
            q.coeff d • MvPolynomial.monomial d (1 : R) := by
          rw [MvPolynomial.smul_monomial, smul_eq_mul, mul_one]
        rw [h3]
        exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨v ⟨d, hdeg⟩, ⟨⟨d, hdeg⟩, rfl⟩, rfl⟩)
      rw [Submodule.span_image] at h1
      obtain ⟨y, hy, hyp⟩ := Submodule.mem_map.mp h1
      have hy' : y = ⟨q, hq⟩ := Subtype.ext hyp
      rw [← hy']
      exact hy
    refine ⟨Module.Basis.mk hli hsp, fun μ => ?_⟩
    rw [Module.Basis.mk_apply]

  let φ : ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B e) →ₗ[B]
      ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e) :=
    { toFun := fun p => ⟨MvPolynomial.map (algebraMap B K) (p : MvPolynomial (Fin (N + 1)) B),
        (MvPolynomial.mem_homogeneousSubmodule _ _).2
          (((MvPolynomial.mem_homogeneousSubmodule _ _).1 p.2).map _)⟩
      map_add' := fun p q => by
        apply Subtype.ext
        simp only [Submodule.coe_add, map_add]
      map_smul' := fun c p => by
        apply Subtype.ext
        show MvPolynomial.map (algebraMap B K) (c • (p : MvPolynomial (Fin (N + 1)) B)) =
          c • MvPolynomial.map (algebraMap B K) (p : MvPolynomial (Fin (N + 1)) B)
        rw [MvPolynomial.smul_eq_C_mul, map_mul, MvPolynomial.map_C, ← MvPolynomial.smul_eq_C_mul,
          algebraMap_smul] }
  have hφ : ∀ p, (φ p : MvPolynomial (Fin (N + 1)) K) =
      MvPolynomial.map (algebraMap B K) (p : MvPolynomial (Fin (N + 1)) B) := fun p => rfl

  obtain ⟨b, hb⟩ := hbasis B
  obtain ⟨b', hb'⟩ := hbasis K
  have hφb : ∀ μ, φ (b μ) = b' μ := fun μ => by
    apply Subtype.ext
    rw [hφ, hb, hb', MvPolynomial.map_monomial, map_one]
  have hBC : IsBaseChange K φ := by
    refine IsBaseChange.of_equiv ((Module.Basis.baseChange K b).equiv b' (Equiv.refl _)) ?_
    have key : (((Module.Basis.baseChange K b).equiv b' (Equiv.refl _)).toLinearMap.restrictScalars B)
        ∘ₗ (TensorProduct.mk B K _ 1) = φ := by
      apply b.ext
      intro μ
      show ((Module.Basis.baseChange K b).equiv b' (Equiv.refl _)) ((1 : K) ⊗ₜ[B] b μ) = φ (b μ)
      rw [← Module.Basis.baseChange_apply, Module.Basis.equiv_apply, Equiv.refl_apply, hφb]
    intro x
    exact LinearMap.congr_fun key x

  have hJmap : ∀ P ∈ Ideal.span (Set.range F), MvPolynomial.map (algebraMap B K) P ∈
      Ideal.span (Set.range fun a => MvPolynomial.map (algebraMap B K) (F a)) := by
    intro P hP
    have := Ideal.mem_map_of_mem (MvPolynomial.map (algebraMap B K)) hP
    rw [Ideal.map_span, ← Set.range_comp] at this
    exact this
  have h2 : ∀ w ∈ Submodule.comap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B e).subtype
      (Submodule.restrictScalars B (Ideal.span (Set.range F))),
      φ w ∈ Submodule.comap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e).subtype
        (Submodule.restrictScalars K
          (Ideal.span (Set.range fun a => MvPolynomial.map (algebraMap B K) (F a)))) := by
    intro w hw
    rw [Submodule.mem_comap, Submodule.subtype_apply, Submodule.restrictScalars_mem] at hw ⊢
    rw [hφ]
    exact hJmap _ hw
  have h3 : ∀ w' ∈ Submodule.comap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e).subtype
        (Submodule.restrictScalars K
          (Ideal.span (Set.range fun a => MvPolynomial.map (algebraMap B K) (F a)))),
      w' ∈ Submodule.span K (φ '' (Submodule.comap
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B e).subtype
        (Submodule.restrictScalars B (Ideal.span (Set.range F))))) := by
    intro w' hw'
    rw [Submodule.mem_comap, Submodule.subtype_apply, Submodule.restrictScalars_mem] at hw'
    have hHe : (w' : MvPolynomial (Fin (N + 1)) K).IsHomogeneous e :=
      (MvPolynomial.mem_homogeneousSubmodule _ _).1 w'.2
    have hcomp : ∀ (G : Fin r → MvPolynomial (Fin (N + 1)) K), (∀ a, (G a).IsHomogeneous e₀) →
        ∀ (H : MvPolynomial (Fin (N + 1)) K), H ∈ Ideal.span (Set.range G) → H.IsHomogeneous e →
        H ∈ Submodule.span K {P | ∃ (μ : Fin (N + 1) →₀ ℕ) (a : Fin r), μ.degree + e₀ = e ∧
          P = MvPolynomial.monomial μ 1 * G a} := by
      intro G hG H hH hHe
      obtain ⟨c, hc⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hH
      have key : ∀ (a : Fin r) (p : MvPolynomial (Fin (N + 1)) K),
          MvPolynomial.homogeneousComponent e (p * G a) ∈ Submodule.span K
            {P | ∃ (μ : Fin (N + 1) →₀ ℕ) (a : Fin r), μ.degree + e₀ = e ∧
              P = MvPolynomial.monomial μ 1 * G a} := by
        intro a p
        induction p using MvPolynomial.induction_on' with
        | monomial ν t =>
          have hT : MvPolynomial.monomial ν (1 : K) * G a ∈
              MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (ν.degree + e₀) := by
            rw [MvPolynomial.mem_homogeneousSubmodule]
            exact (MvPolynomial.isHomogeneous_monomial (1 : K) rfl).mul (hG a)
          have h1 : MvPolynomial.monomial ν t * G a =
              t • (MvPolynomial.monomial ν (1 : K) * G a) := by
            rw [← smul_mul_assoc, MvPolynomial.smul_monomial, smul_eq_mul, mul_one]
          rw [h1, map_smul, MvPolynomial.homogeneousComponent_of_mem hT]
          apply Submodule.smul_mem
          split_ifs with h
          · exact Submodule.subset_span ⟨ν, a, h.symm, rfl⟩
          · exact Submodule.zero_mem _
        | add p q hp hq =>
          rw [add_mul, map_add]
          exact Submodule.add_mem _ hp hq
      have hHH : H = MvPolynomial.homogeneousComponent e H :=
        (MvPolynomial.homogeneousComponent_eq_self hHe).symm
      rw [hHH, ← hc, map_sum]
      exact Submodule.sum_mem _ (fun a _ => key a (c a))
    have hspan := hcomp
      (fun a => MvPolynomial.map (algebraMap B K) (F a)) (fun a => (hF a).map _) _ hw' hHe
    have hsub : {P : MvPolynomial (Fin (N + 1)) K | ∃ (μ : Fin (N + 1) →₀ ℕ) (a : Fin r),
        μ.degree + e₀ = e ∧ P = MvPolynomial.monomial μ 1 *
          (fun a => MvPolynomial.map (algebraMap B K) (F a)) a} ⊆
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e).subtype '' (φ '' (Submodule.comap
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B e).subtype
          (Submodule.restrictScalars B (Ideal.span (Set.range F))))) := by
      rintro P ⟨μ, a, hμ, rfl⟩
      have hmem : MvPolynomial.monomial μ (1 : B) * F a ∈
          MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B e := by
        rw [MvPolynomial.mem_homogeneousSubmodule]
        have := (MvPolynomial.isHomogeneous_monomial (1 : B) (rfl : μ.degree = μ.degree)).mul (hF a)
        rwa [hμ] at this
      refine ⟨φ ⟨_, hmem⟩, ⟨⟨_, hmem⟩, ?_, rfl⟩, ?_⟩
      · rw [SetLike.mem_coe, Submodule.mem_comap, Submodule.subtype_apply,
          Submodule.restrictScalars_mem]
        exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨a, rfl⟩)
      · rw [Submodule.subtype_apply, hφ]
        show MvPolynomial.map (algebraMap B K) (MvPolynomial.monomial μ (1 : B) * F a) = _
        rw [map_mul, MvPolynomial.map_monomial, map_one]
    have hmem := Submodule.span_mono hsub hspan
    rw [Submodule.span_image] at hmem
    obtain ⟨y, hy, hyw⟩ := Submodule.mem_map.mp hmem
    have hyw' : y = w' := Subtype.ext hyw
    rw [← hyw']
    exact hy
  unfold wcpaDjHilbFn
  exact hc1 _ _ φ _ _ hBC h2 h3

theorem wcpa_dj_flrg_fibre_le_generic_flat : ∀ (B : Type u) [CommRing B] [IsDomain B] (M : Type u) [AddCommGroup M] [Module B M] [Module.Finite B M], (∀ (P : Ideal B) [P.IsPrime], Module.finrank P.ResidueField (TensorProduct B P.ResidueField M) ≤ Module.finrank (FractionRing B) (TensorProduct B (FractionRing B) M)) → Module.Flat B M :=
by
  intro B _ _ M _ _ _ h
  have s1b : ∀ (A : Type u) [CommRing A] (L : Type u) [Field L] [Algebra A L] (N : Type u)
      [AddCommGroup N] [Module A N] (c : ℕ) (f : Fin c → N),
      Function.Injective (algebraMap A L) → Submodule.span A (Set.range f) = ⊤ →
      c ≤ Module.finrank L (TensorProduct A L N) →
      Function.Injective (Fintype.linearCombination A f) := by
    intro A _ L _ _ N _ _ c f hinj hspan hc
    have hφs : Function.Surjective (Fintype.linearCombination A f) := by
      rw [← LinearMap.range_eq_top, Fintype.range_linearCombination]; exact hspan
    have hψs : Function.Surjective (LinearMap.baseChange L (Fintype.linearCombination A f)) :=
      LinearMap.baseChange_surjective L hφs
    let eq := TensorProduct.piScalarRight A L L (Fin c)
    haveI : Module.Finite L (TensorProduct A L (Fin c → A)) := Module.Finite.equiv eq.symm
    haveI : Module.Finite L (TensorProduct A L N) := Module.Finite.of_surjective _ hψs
    have hr1 : Module.finrank L (TensorProduct A L (Fin c → A)) = c := by
      rw [LinearEquiv.finrank_eq eq, Module.finrank_fin_fun]
    have hr2 : Module.finrank L (TensorProduct A L N) ≤ c := by
      rw [← hr1]; exact LinearMap.finrank_le_finrank_of_surjective hψs
    have hψi : Function.Injective (LinearMap.baseChange L (Fintype.linearCombination A f)) :=
      (LinearMap.injective_iff_surjective_of_finrank_eq_finrank (by omega)).mpr hψs
    rw [injective_iff_map_eq_zero]
    intro v hv
    have h1 : LinearMap.baseChange L (Fintype.linearCombination A f) ((1 : L) ⊗ₜ v) = 0 := by
      rw [LinearMap.baseChange_tmul, hv, TensorProduct.tmul_zero]
    have h2 : (1 : L) ⊗ₜ[A] v = 0 := hψi (h1.trans (map_zero _).symm)
    have h3 := congrArg eq h2
    rw [map_zero] at h3
    funext j
    have h4 := congrFun h3 j
    simp only [eq, TensorProduct.piScalarRight_apply, TensorProduct.piScalarRightHom_tmul,
      Pi.zero_apply] at h4
    rw [Algebra.smul_def, mul_one] at h4
    exact hinj (h4.trans (map_zero _).symm)
  apply Module.flat_of_localized_maximal M
  intro P hP
  haveI : P.IsPrime := hP.isPrime
  let A := Localization.AtPrime P
  let L := FractionRing B
  let N := TensorProduct B A M
  haveI : Module.Finite A N := Module.Finite.base_change B A M
  let κ := IsLocalRing.ResidueField A
  obtain ⟨f, hf⟩ : ∃ f : Fin (Module.finrank κ (TensorProduct A κ N)) → N,
      Submodule.span A (Set.range f) = ⊤ := by
    let b := Module.finBasis κ (TensorProduct A κ N)
    have hsurj : Function.Surjective (TensorProduct.mk A κ N 1) :=
      TensorProduct.mk_surjective A N κ (by
        rw [IsLocalRing.ResidueField.algebraMap_eq]; exact IsLocalRing.residue_surjective)
    choose f hf using fun j => hsurj (b j)
    exact ⟨f, IsLocalRing.span_eq_top_of_tmul_eq_basis f b hf⟩
  have hcancel : ∀ (C : Type u) [Field C] [Algebra A C] [Algebra B C] [IsScalarTower B A C],
      Module.finrank C (TensorProduct A C N) = Module.finrank C (TensorProduct B C M) :=
    fun C _ _ _ _ => LinearEquiv.finrank_eq (TensorProduct.AlgebraTensorModule.cancelBaseChange B A C C M)
  have hle : Module.finrank κ (TensorProduct A κ N) ≤ Module.finrank L (TensorProduct A L N) := by
    rw [hcancel κ, hcancel L]
    exact h P
  have hinj := s1b A L N _ f (IsFractionRing.injective A L) hf hle
  have hsurj : Function.Surjective (Fintype.linearCombination A f) := by
    rw [← LinearMap.range_eq_top, Fintype.range_linearCombination]; exact hf
  let e₁ := LinearEquiv.ofBijective _ ⟨hinj, hsurj⟩
  haveI : Module.Free A N := Module.Free.of_equiv e₁
  let e₂ := ((isLocalizedModule_iff_isBaseChange P.primeCompl A
    (LocalizedModule.mkLinearMap P.primeCompl M)).mp inferInstance).equiv
  haveI : Module.Free A (LocalizedModule P.primeCompl M) := Module.Free.of_equiv e₂
  haveI : Module.Flat B A := IsLocalization.flat A P.primeCompl
  exact Module.Flat.trans B A _

theorem wcpa_dj_flrg_dehomog_flat : ∀ (B : Type u) [CommRing B] (N e₀ r : ℕ) (F : Fin r → MvPolynomial (Fin (N + 1)) B), (∀ a, (F a).IsHomogeneous e₀) → (∀ e, Module.Flat B (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B e) ⧸ Submodule.comap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B e).subtype (Submodule.restrictScalars B (Ideal.span (Set.range F))))) → ∀ i : Fin (N + 1), Module.Flat B (MvPolynomial (Fin (N + 1)) B ⧸ (Ideal.span (Set.range F) ⊔ Ideal.span {MvPolynomial.X i - 1})) :=
by
  intro B _ N e₀ r F hF hflat i
  set J : Ideal (MvPolynomial (Fin (N + 1)) B) := Ideal.span (Set.range F) with hJ
  set I : Ideal (MvPolynomial (Fin (N + 1)) B) := J ⊔ Ideal.span {MvPolynomial.X i - 1} with hI

  obtain ⟨hom, hhom⟩ : ∃ hom : ℕ → MvPolynomial (Fin (N + 1)) B → MvPolynomial (Fin (N + 1)) B,
      ∀ T P, hom T P = ∑ d ∈ Finset.range (T + 1),
        MvPolynomial.X i ^ (T - d) * MvPolynomial.homogeneousComponent d P := ⟨_, fun _ _ => rfl⟩

  have hXI : ∀ (t : ℕ) (P : MvPolynomial (Fin (N + 1)) B), MvPolynomial.X i ^ t * P - P ∈ I := by
    intro t P
    apply Ideal.mem_sup_right
    rw [Ideal.mem_span_singleton]
    have e : MvPolynomial.X i ^ t * P - P = (MvPolynomial.X i ^ t - 1) * P := by ring
    rw [e]
    exact (sub_one_dvd_pow_sub_one _ _).mul_right _

  have hom_sub : ∀ T P Q, hom T (P - Q) = hom T P - hom T Q := by
    intro T P Q
    simp only [hhom, map_sub, mul_sub, Finset.sum_sub_distrib]
  have hom_add : ∀ T P Q, hom T (P + Q) = hom T P + hom T Q := by
    intro T P Q
    simp only [hhom, map_add, mul_add, Finset.sum_add_distrib]

  have hom_homog : ∀ T D (P : MvPolynomial (Fin (N + 1)) B), P.IsHomogeneous D → D ≤ T →
      hom T P = MvPolynomial.X i ^ (T - D) * P := by
    intro T D P hP hDT
    have hPm : P ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B D :=
      (MvPolynomial.mem_homogeneousSubmodule _ _).mpr hP
    rw [hhom, Finset.sum_eq_single D]
    · rw [MvPolynomial.homogeneousComponent_of_mem hPm, if_pos rfl]
    · intro d _ hd
      rw [MvPolynomial.homogeneousComponent_of_mem hPm, if_neg hd, mul_zero]
    · intro hD
      exact absurd (Finset.mem_range.mpr (by omega)) hD

  have hom_isHom : ∀ T P, (hom T P).IsHomogeneous T := by
    intro T P
    rw [hhom]
    apply MvPolynomial.IsHomogeneous.sum
    intro d hd
    have hd' : d ≤ T := Finset.mem_range_succ_iff.mp hd
    have h := (MvPolynomial.isHomogeneous_X_pow i (T - d)).mul
      (MvPolynomial.homogeneousComponent_isHomogeneous d P)
    rwa [Nat.sub_add_cancel hd'] at h

  have hom_lift : ∀ T P, P.totalDegree ≤ T → hom T P - P ∈ Ideal.span {MvPolynomial.X i - 1} := by
    intro T P hP
    have hPsum : ∑ d ∈ Finset.range (T + 1), MvPolynomial.homogeneousComponent d P = P := by
      conv_rhs => rw [← MvPolynomial.sum_homogeneousComponent P]
      symm
      apply Finset.sum_subset
      · intro d hd
        simp only [Finset.mem_range] at hd ⊢
        omega
      · intro d _ hd
        apply MvPolynomial.homogeneousComponent_eq_zero
        simp only [Finset.mem_range] at hd
        omega
    have e : hom T P - P = ∑ d ∈ Finset.range (T + 1),
        (MvPolynomial.X i ^ (T - d) - 1) * MvPolynomial.homogeneousComponent d P := by
      calc hom T P - P = ∑ d ∈ Finset.range (T + 1),
            MvPolynomial.X i ^ (T - d) * MvPolynomial.homogeneousComponent d P -
            ∑ d ∈ Finset.range (T + 1), MvPolynomial.homogeneousComponent d P := by
              rw [hhom, hPsum]
        _ = _ := by simp only [sub_mul, one_mul, Finset.sum_sub_distrib]
    rw [e]
    exact Ideal.sum_mem _ (fun d _ => Ideal.mem_span_singleton.mpr
      ((sub_one_dvd_pow_sub_one _ _).mul_right _))

  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) :=
    MvPolynomial.gradedAlgebra
  have hdec : ∀ (x : MvPolynomial (Fin (N + 1)) B) (n : ℕ),
      ((DirectSum.decompose (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) x) n :
        MvPolynomial (Fin (N + 1)) B) = MvPolynomial.homogeneousComponent n x :=
    fun x n => MvPolynomial.decomposition.decompose'_apply x n
  have hshift : ∀ (h : MvPolynomial (Fin (N + 1)) B) (n : ℕ),
      MvPolynomial.homogeneousComponent n (MvPolynomial.X i * h) =
        if 1 ≤ n then MvPolynomial.X i * MvPolynomial.homogeneousComponent (n - 1) h else 0 := by
    intro h n
    rw [← hdec, ← hdec]
    exact DirectSum.coe_decompose_mul_of_left_mem _ n
      ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X B i))

  have hom_X : ∀ T (h : MvPolynomial (Fin (N + 1)) B), h.totalDegree < T →
      hom T (MvPolynomial.X i * h) = hom T h := by
    intro T h hT
    rw [hhom, hhom, Finset.sum_range_succ', Finset.sum_range_succ]
    rw [hshift h 0, if_neg (show ¬ (1 ≤ 0) by omega), mul_zero, add_zero]
    rw [MvPolynomial.homogeneousComponent_eq_zero T h hT, mul_zero, add_zero]
    apply Finset.sum_congr rfl
    intro k hk
    have hk' : k < T := Finset.mem_range.mp hk
    rw [hshift h (k + 1), if_pos (show 1 ≤ k + 1 by omega), Nat.add_sub_cancel, ← mul_assoc,
      ← pow_succ, show T - (k + 1) + 1 = T - k by omega]

  have hJhom : Ideal.IsHomogeneous (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) J := by
    apply Ideal.homogeneous_span
    rintro _ ⟨a, rfl⟩
    exact ⟨e₀, (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (hF a)⟩
  have hcJ : ∀ j ∈ J, ∀ d, MvPolynomial.homogeneousComponent d j ∈ J := by
    intro j hj d
    rw [← hdec]
    exact (Ideal.IsHomogeneous.mem_iff _ hJhom).mp hj d
  have hom_J : ∀ T, ∀ j ∈ J, hom T j ∈ J := by
    intro T j hj
    rw [hhom]
    exact Ideal.sum_mem _ (fun d _ => Ideal.mul_mem_left _ _ (hcJ j hj d))

  have htors : ∀ (D : ℕ) (H : MvPolynomial (Fin (N + 1)) B), H.IsHomogeneous D → H ∈ I →
      ∃ t : ℕ, MvPolynomial.X i ^ t * H ∈ J := by
    intro D H hH hHI
    obtain ⟨j, hj, z, hz, hjz⟩ := Submodule.mem_sup.mp hHI
    obtain ⟨h, rfl⟩ := Ideal.mem_span_singleton'.mp hz
    obtain ⟨T, hT⟩ : ∃ T, T = D + h.totalDegree + 1 := ⟨_, rfl⟩
    refine ⟨T - D, ?_⟩
    rw [← hom_homog T D H hH (by omega), ← hjz]
    have e : j + h * (MvPolynomial.X i - 1) = j + (MvPolynomial.X i * h - h) := by ring
    rw [e, hom_add, hom_sub, hom_X T h (by omega), sub_self, add_zero]
    exact hom_J T j hj

  have hle : ∀ D, Submodule.comap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B D).subtype
      (Submodule.restrictScalars B J) ≤ LinearMap.ker ((Ideal.Quotient.mkₐ B I).toLinearMap ∘ₗ
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B D).subtype) := by
    intro D x hx
    rw [Submodule.mem_comap, Submodule.restrictScalars_mem] at hx
    rw [LinearMap.mem_ker, LinearMap.comp_apply, AlgHom.toLinearMap_apply, Ideal.Quotient.mkₐ_eq_mk,
      Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mem_sup_left hx
  let θ : ∀ D, (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B D) ⧸
      Submodule.comap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B D).subtype
        (Submodule.restrictScalars B J)) →ₗ[B] (MvPolynomial (Fin (N + 1)) B ⧸ I) :=
    fun D => Submodule.liftQ _ ((Ideal.Quotient.mkₐ B I).toLinearMap ∘ₗ
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B D).subtype) (hle D)
  have hθ : ∀ D (P : MvPolynomial (Fin (N + 1)) B)
      (hP : P ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B D),
      θ D (Submodule.Quotient.mk ⟨P, hP⟩) = Ideal.Quotient.mk I P := by
    intro D P hP
    show Submodule.liftQ _ _ (hle D) (Submodule.Quotient.mk _) = _
    rw [Submodule.liftQ_apply]
    rfl

  apply Module.Flat.of_forall_isTrivialRelation
  intro l f x hsum
  choose G hG using fun j => Ideal.Quotient.mk_surjective (I := I) (x j)
  obtain ⟨D, hD⟩ : ∃ D, ∀ j, (G j).totalDegree ≤ D :=
    ⟨Finset.univ.sup (fun j => (G j).totalDegree), fun j => Finset.le_sup (f := fun j => (G j).totalDegree) (Finset.mem_univ j)⟩
  have hHx : ∀ j, Ideal.Quotient.mk I (hom D (G j)) = x j := by
    intro j
    rw [← hG j, Ideal.Quotient.mk_eq_mk_iff_sub_mem]
    exact Ideal.mem_sup_right (hom_lift D (G j) (hD j))
  obtain ⟨H, hHdef⟩ : ∃ H, H = ∑ j, f j • hom D (G j) := ⟨_, rfl⟩
  have hHhom : H.IsHomogeneous D := by
    rw [hHdef]
    exact (MvPolynomial.mem_homogeneousSubmodule _ _).mp (Submodule.sum_mem _ (fun j _ =>
      Submodule.smul_mem _ _ ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (hom_isHom D (G j)))))
  have hHI : H ∈ I := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, ← Ideal.Quotient.mkₐ_eq_mk B, hHdef, map_sum]
    simp only [map_smul, Ideal.Quotient.mkₐ_eq_mk, hHx]
    exact hsum
  obtain ⟨t, ht⟩ := htors D H hHhom hHI
  have hmem : ∀ j, MvPolynomial.X i ^ t * hom D (G j) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B (t + D) := fun j =>
    (MvPolynomial.mem_homogeneousSubmodule _ _).mpr
      ((MvPolynomial.isHomogeneous_X_pow i t).mul (hom_isHom D (G j)))
  let m' : Fin l → (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B (t + D)) ⧸
      Submodule.comap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B (t + D)).subtype
        (Submodule.restrictScalars B J)) := fun j => Submodule.Quotient.mk ⟨_, hmem j⟩
  have hrel : ∑ j, f j • m' j = 0 := by
    have e1 : ∑ j, f j • m' j = (Submodule.mkQ _) (∑ j, f j •
        (⟨_, hmem j⟩ : ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B (t + D)))) := by
      rw [map_sum]
      simp only [map_smul, Submodule.mkQ_apply]
      rfl
    rw [e1, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, Submodule.mem_comap,
      Submodule.subtype_apply, Submodule.restrictScalars_mem, Submodule.coe_sum]
    simp only [Submodule.coe_smul]
    have e2 : ∑ j, f j • (MvPolynomial.X i ^ t * hom D (G j)) = MvPolynomial.X i ^ t * H := by
      rw [hHdef, Finset.mul_sum]
      simp only [mul_smul_comm]
    rw [e2]
    exact ht
  haveI := hflat (t + D)
  obtain ⟨k, a, z, hza, hfa⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero hrel
  refine ⟨k, a, fun κ => θ (t + D) (z κ), ?_, hfa⟩
  intro j
  have h1 : θ (t + D) (m' j) = x j := by
    show θ (t + D) (Submodule.Quotient.mk ⟨_, hmem j⟩) = x j
    rw [hθ, ← hHx j, Ideal.Quotient.mk_eq_mk_iff_sub_mem]
    exact hXI t _
  rw [← h1, hza j, map_sum]
  simp only [map_smul]

theorem wcpa_dj_flrg_affine_flat : ∀ (k : Type u) [Field k] (B : Type u) [CommRing B] [IsDomain B] [IsNoetherianRing B] (N e₀ r : ℕ) (Φ : ℕ → ℕ) (F : Fin r → MvPolynomial (Fin (N + 1)) B), 1 ≤ e₀ → Φ e₀ + r = Module.finrank k (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k e₀) → (∀ e, e₀ ≤ e → Φ (e + 1) = wcpaDjMacUp e (Φ e)) → (∀ a, (F a).IsHomogeneous e₀) → (∃ m : Fin r → (Fin (N + 1) →₀ ℕ), Function.Injective m ∧ ∀ a a', (a = a' → (F a).coeff (m a') = 1) ∧ (a ≠ a' → (F a).coeff (m a') = 0)) → (∀ e, e₀ ≤ e → wcpaDjHilbFn (FractionRing B) N (Ideal.span (Set.range fun a => MvPolynomial.map (algebraMap B (FractionRing B)) (F a))) e = Φ e) → ∀ i : Fin (N + 1), Module.Flat B (MvPolynomial (Fin (N + 1)) B ⧸ (Ideal.span (Set.range F) ⊔ Ideal.span {MvPolynomial.X i - 1})) :=
by
  intro k _ B _ _ _ N e₀ r Φ F h1 h2 h3 h4 h5 h6 i

  have g4 : ∀ (K : Type u) [Field K] (G : Fin r → MvPolynomial (Fin (N + 1)) K),
      (∀ a, (G a).IsHomogeneous e₀) →
      (∃ m : Fin r → (Fin (N + 1) →₀ ℕ), Function.Injective m ∧ ∀ a a',
        (a = a' → (G a).coeff (m a') = 1) ∧ (a ≠ a' → (G a).coeff (m a') = 0)) →
      ∀ e, e₀ ≤ e → wcpaDjHilbFn K N (Ideal.span (Set.range G)) e ≤ Φ e := by
    intro K _ G hG hm e he
    induction e, he using Nat.le_induction with
    | base =>
      have hs3 := wcpa_dj_flrg_normal_form_hilb K N e₀ r G hG hm
      have hs5 := (wcpa_dj_flrg_hom_finrank k N e₀).2
      omega
    | succ e he ih =>
      obtain ⟨U, T, hU, hUc, hT, hTc⟩ :=
        wcpa_dj_flrg_lead_monomials K N e (Ideal.span (Set.range G))
      have hmac := wcpa_dj_flrg_macaulay_comb N e U T (le_trans h1 he) hU hT
      have hmono := wcpa_dj_flrg_macup_mono e _ _ ih
      rw [h3 e he]
      rw [hUc] at hmac
      omega

  refine wcpa_dj_flrg_dehomog_flat B N e₀ r F h4 ?_ i
  intro e
  by_cases he : e < e₀
  ·
    have hbot : Submodule.comap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B e).subtype
        (Submodule.restrictScalars B (Ideal.span (Set.range F))) = ⊥ := by
      rw [eq_bot_iff]
      rintro ⟨H, hH⟩ hmem
      rw [Submodule.mem_comap, Submodule.subtype_apply, Submodule.restrictScalars_mem] at hmem
      have hspan := wcpa_dj_flrg_homog_component_span B N e₀ r F h4 e H hmem
        ((MvPolynomial.mem_homogeneousSubmodule _ _).mp hH)
      have hempty : {P : MvPolynomial (Fin (N + 1)) B | ∃ (μ : Fin (N + 1) →₀ ℕ) (a : Fin r),
          μ.degree + e₀ = e ∧ P = MvPolynomial.monomial μ 1 * F a} = ∅ := by
        ext P
        simp only [Set.mem_setOf_eq, Set.mem_empty_iff_false, iff_false]
        rintro ⟨μ, a, hμ, -⟩
        omega
      rw [hempty, Submodule.span_empty, Submodule.mem_bot] at hspan
      rw [Submodule.mem_bot]
      exact Subtype.ext hspan
    haveI := (wcpa_dj_flrg_homog_free_finite B N e).1
    exact Module.Flat.of_linearEquiv (Submodule.quotEquivOfEqBot _ hbot)
  ·
    push_neg at he
    haveI := (wcpa_dj_flrg_homog_free_finite B N e).2
    apply wcpa_dj_flrg_fibre_le_generic_flat B
    intro P _
    rw [wcpa_dj_flrg_fibre_finrank B P.ResidueField N e₀ r F h4 e,
      wcpa_dj_flrg_fibre_finrank B (FractionRing B) N e₀ r F h4 e, h6 e he]
    refine g4 P.ResidueField (fun a => MvPolynomial.map (algebraMap B P.ResidueField) (F a))
      (fun a => (h4 a).map _) ?_ e he
    obtain ⟨m, hm, hm2⟩ := h5
    exact ⟨m, hm, fun a a' => ⟨fun h => by rw [MvPolynomial.coeff_map, (hm2 a a').1 h, map_one],
      fun h => by rw [MvPolynomial.coeff_map, (hm2 a a').2 h, map_zero]⟩⟩

theorem wcpa_dj_flrg_chart_ring_ker : ∀ (k : Type u) [Field k] (N : ℕ) {B : Scheme.{u}} (sB : B ⟶ Spec (.of k)) (V : B.Opens) (i : Fin (N + 1)), IsAffineOpen V → IsAffineOpen (wcpaDjFlrgChart k N sB V i) ∧ Function.Surjective (wcpaDjFlrgPsi k N sB V i) ∧ RingHom.ker (wcpaDjFlrgPsi k N sB V i) = Ideal.span {MvPolynomial.X i - 1} :=
by
  intro k _ N B sB V i hV
  classical

  have hM : ∀ {X Y : Scheme.{u}} (g₁ g₂ : X ⟶ Y) (_ : g₁ = g₂) (U : Y.Opens) (W : X.Opens)
      (e₁ : W ≤ g₁ ⁻¹ᵁ U) (e₂ : W ≤ g₂ ⁻¹ᵁ U), g₁.appLE U W e₁ = g₂.appLE U W e₂ := by
    intro X Y g₁ g₂ h U W e₁ e₂
    subst h
    rfl
  have hTop : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (e : (⊤ : X.Opens) ≤ f ⁻¹ᵁ ⊤),
      f.appTop = f.appLE ⊤ ⊤ e := by
    intro X Y f e
    have h1 : (homOfLE e).op = 𝟙 (Opposite.op (⊤ : X.Opens)) :=
      Quiver.Hom.unop_inj (Subsingleton.elim _ _)
    have h2 : X.presheaf.map (homOfLE e).op = 𝟙 _ :=
      (congrArg X.presheaf.map h1).trans (X.presheaf.map_id _)
    rw [Scheme.Hom.appLE, h2]
    exact (Category.comp_id (f.app ⊤)).symm
  have hmap_id : ∀ {X : Scheme.{u}} {U : X.Opens} (f : (Opposite.op U : X.Opensᵒᵖ) ⟶ Opposite.op U),
      X.presheaf.map f = 𝟙 _ := by
    intro X U f
    rw [show f = 𝟙 _ from Quiver.Hom.unop_inj (Subsingleton.elim _ _), CategoryTheory.Functor.map_id]
  have hres_id : ∀ {X : Scheme.{u}} (U : X.Opens) (h : U ≤ U) (x : Γ(X, U)),
      X.presheaf.map (homOfLE h).op x = x := by
    intro X U h x
    rw [hmap_id]
    rfl

  have hXi : (MvPolynomial.X i : MvPolynomial (Fin (N + 1)) k) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1 :=
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ i)
  have hDaff : IsAffineOpen (wcSgD k N i) :=
    @Proj.isAffineOpen_basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      MvPolynomial.gradedAlgebra (MvPolynomial.X i) 1 hXi one_pos
  obtain ⟨hA, hB⟩ := wc_closed_in_product_chart_gen (Spec (.of k)) (wcProjK k N) B
    (Limits.pullback (wcProjKStr k N) sB) (wcProjKStr k N) sB (𝟙 _) (wcSgD k N i) V hDaff hV
  rw [Category.id_comp, Category.id_comp] at hA hB
  have hψC : ∀ c, wcpaDjFlrgPsi k N sB V i (MvPolynomial.C c) =
      ((Limits.pullback.snd (wcProjKStr k N) sB).appLE V (wcpaDjFlrgChart k N sB V i)
        inf_le_right).hom c := by
    intro c
    unfold wcpaDjFlrgPsi
    exact MvPolynomial.eval₂Hom_C _ _ c
  have hψX : ∀ l, wcpaDjFlrgPsi k N sB V i (MvPolynomial.X l) =
      ((Limits.pullback.fst (wcProjKStr k N) sB).appLE (wcSgD k N i)
        (wcpaDjFlrgChart k N sB V i) inf_le_left).hom (wcSgE k N i l) := by
    intro l
    unfold wcpaDjFlrgPsi
    exact MvPolynomial.eval₂Hom_X' _ _ l
  have e3 : V ≤ sB ⁻¹ᵁ ⊤ := le_top.trans (Scheme.Hom.preimage_top sB).ge
  have hconst : ∀ y : Γ(Spec (.of k), ⊤),
      ((Limits.pullback.fst (wcProjKStr k N) sB).appLE (wcSgD k N i)
        (wcpaDjFlrgChart k N sB V i) inf_le_left).hom
        ((wcProjK k N).presheaf.map (homOfLE (le_top : wcSgD k N i ≤ ⊤)).op
          ((wcProjKStr k N).appTop y)) =
      ((Limits.pullback.snd (wcProjKStr k N) sB).appLE V (wcpaDjFlrgChart k N sB V i)
        inf_le_right).hom ((sB.appLE ⊤ V e3).hom y) := by
    intro y
    have e1 : (wcProjKStr k N).appTop ≫
        (wcProjK k N).presheaf.map (homOfLE (le_top : wcSgD k N i ≤ ⊤)).op ≫
        (Limits.pullback.fst (wcProjKStr k N) sB).appLE (wcSgD k N i)
          (wcpaDjFlrgChart k N sB V i) inf_le_left =
        sB.appLE ⊤ V e3 ≫ (Limits.pullback.snd (wcProjKStr k N) sB).appLE V
          (wcpaDjFlrgChart k N sB V i) inf_le_right := by
      rw [Scheme.Hom.map_appLE, hTop (wcProjKStr k N) (Scheme.Hom.preimage_top _).ge,
        Scheme.Hom.appLE_comp_appLE, Scheme.Hom.appLE_comp_appLE]
      exact hM _ _ Limits.pullback.condition _ _ _ _
    exact congrArg (fun φ => φ.hom y) e1
  refine ⟨hA, ?_, ?_⟩
  ·
    have hsurj : ∀ t, t ∈ (wcpaDjFlrgPsi k N sB V i).range := by
      intro t
      refine (Subring.closure_le.mpr ?_) (hB t)
      apply Set.union_subset
      · rintro _ ⟨x, rfl⟩
        show ((Limits.pullback.fst (wcProjKStr k N) sB).appLE (wcSgD k N i)
          (wcpaDjFlrgChart k N sB V i) inf_le_left).hom x ∈ _
        have hx := wc_ldpi_oai_proj_gen k N i x
        refine (Subring.closure_le (t := (wcpaDjFlrgPsi k N sB V i).range.comap
          ((Limits.pullback.fst (wcProjKStr k N) sB).appLE (wcSgD k N i)
            (wcpaDjFlrgChart k N sB V i) inf_le_left).hom)).mpr ?_ hx
        apply Set.union_subset
        · rintro _ ⟨l, rfl⟩
          exact Subring.mem_comap.mpr (RingHom.mem_range.mpr ⟨MvPolynomial.X l, hψX l⟩)
        · rintro _ ⟨c, rfl⟩
          refine Subring.mem_comap.mpr (RingHom.mem_range.mpr
            ⟨MvPolynomial.C ((sB.appLE ⊤ V e3).hom ((Scheme.ΓSpecIso (.of k)).inv c)), ?_⟩)
          rw [hψC]
          exact (hconst _).symm
      · rintro _ ⟨c, rfl⟩
        exact RingHom.mem_range.mpr ⟨MvPolynomial.C c, hψC c⟩
    intro t
    obtain ⟨g, hg⟩ := RingHom.mem_range.mp (hsurj t)
    exact ⟨g, hg⟩
  · apply le_antisymm
    · intro g hg
      rw [RingHom.mem_ker] at hg
      set I : Ideal (MvPolynomial (Fin (N + 1)) Γ(B, V)) :=
        Ideal.span {MvPolynomial.X i - 1} with hI
      have hmkXi : Ideal.Quotient.mk I (MvPolynomial.X i : MvPolynomial (Fin (N + 1)) Γ(B, V)) = 1 := by
        rw [← map_one (Ideal.Quotient.mk I), Ideal.Quotient.eq]
        exact Ideal.mem_span_singleton_self _
      obtain ⟨α, hα⟩ : ∃ α : Γ(B, V) ⟶ CommRingCat.of (MvPolynomial (Fin (N + 1)) Γ(B, V) ⧸ I),
          ∀ c, α.hom c = Ideal.Quotient.mk I (MvPolynomial.C c) :=
        ⟨CommRingCat.ofHom ((Ideal.Quotient.mk I).comp MvPolynomial.C), fun c => rfl⟩
      obtain ⟨b, hb⟩ : ∃ b : Spec (CommRingCat.of (MvPolynomial (Fin (N + 1)) Γ(B, V) ⧸ I)) ⟶ B,
          b = Spec.map α ≫ hV.fromSpec := ⟨_, rfl⟩
      have hbV : b ⁻¹ᵁ V = ⊤ := by
        rw [hb, Scheme.Hom.comp_preimage, IsAffineOpen.fromSpec_preimage_self,
          Scheme.Hom.preimage_top]
      have hbval : ∀ (h : (⊤ : (Spec (CommRingCat.of (MvPolynomial (Fin (N + 1)) Γ(B, V) ⧸ I))).Opens) ≤
          b ⁻¹ᵁ V) (c : Γ(B, V)),
          (Scheme.ΓSpecIso (CommRingCat.of (MvPolynomial (Fin (N + 1)) Γ(B, V) ⧸ I))).hom.hom
            ((b.appLE V ⊤ h).hom c) = Ideal.Quotient.mk I (MvPolynomial.C c) := by
        intro h c
        subst hb
        have e₁ : (⊤ : (Spec Γ(B, V)).Opens) ≤ hV.fromSpec ⁻¹ᵁ V := hV.fromSpec_preimage_self.ge
        have e₂ : (⊤ : (Spec (CommRingCat.of (MvPolynomial (Fin (N + 1)) Γ(B, V) ⧸ I))).Opens) ≤
            Spec.map α ⁻¹ᵁ ⊤ := (Scheme.Hom.preimage_top _).ge
        have hfs : hV.fromSpec.appLE V ⊤ e₁ = (Scheme.ΓSpecIso Γ(B, V)).inv := by
          rw [Scheme.Hom.appLE, IsAffineOpen.fromSpec_app_self, Category.assoc,
            ← Functor.map_comp, hmap_id, Category.comp_id]
        rw [← Scheme.Hom.appLE_comp_appLE (Spec.map α) hV.fromSpec V ⊤ ⊤ e₁ e₂, hfs,
          ← hTop _ e₂]
        have e4 := congrArg (fun φ => φ.hom c)
          (show (Scheme.ΓSpecIso Γ(B, V)).inv ≫ (Spec.map α).appTop ≫
              (Scheme.ΓSpecIso (CommRingCat.of (MvPolynomial (Fin (N + 1)) Γ(B, V) ⧸ I))).hom = α by
            rw [Scheme.ΓSpecIso_naturality, Iso.inv_hom_id_assoc])
        simp only at e4
        rw [hα] at e4
        exact e4
      obtain ⟨t, ht⟩ : ∃ t : Fin (N + 1) →
          Γ(Spec (CommRingCat.of (MvPolynomial (Fin (N + 1)) Γ(B, V) ⧸ I)), ⊤),
          ∀ l, t l = (Scheme.ΓSpecIso (CommRingCat.of (MvPolynomial (Fin (N + 1)) Γ(B, V) ⧸ I))).inv.hom
            (Ideal.Quotient.mk I (MvPolynomial.X l)) := ⟨_, fun l => rfl⟩
      have hti : t i = 1 := by rw [ht, hmkXi, map_one]
      have hspan : Ideal.span (Set.range t) = ⊤ :=
        Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span ⟨i, rfl⟩) (by rw [hti]; exact isUnit_one)
      obtain ⟨a, ha1, ha2, ha3⟩ := wc_ldpi_oai_proj_lift k N
        (Spec (CommRingCat.of (MvPolynomial (Fin (N + 1)) Γ(B, V) ⧸ I))) (b ≫ sB) t hspan
      have haD : a ⁻¹ᵁ wcSgD k N i = ⊤ := by rw [ha2 i, hti, Scheme.basicOpen_one]
      have ha4 : ∀ l, (a.appLE (wcSgD k N i) ⊤ haD.ge).hom (wcSgE k N i l) = t l := by
        intro l
        have h := ha3 i l ⊤ haD.ge
        rw [hti, map_one, mul_one, hres_id] at h
        exact h
      obtain ⟨φT, hφ1, hφ2⟩ : ∃ φT : Spec (CommRingCat.of (MvPolynomial (Fin (N + 1)) Γ(B, V) ⧸ I)) ⟶
          Limits.pullback (wcProjKStr k N) sB,
          φT ≫ Limits.pullback.fst (wcProjKStr k N) sB = a ∧
            φT ≫ Limits.pullback.snd (wcProjKStr k N) sB = b :=
        ⟨Limits.pullback.lift a b ha1, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
      have hφC : (⊤ : (Spec (CommRingCat.of (MvPolynomial (Fin (N + 1)) Γ(B, V) ⧸ I))).Opens) ≤
          φT ⁻¹ᵁ wcpaDjFlrgChart k N sB V i := by
        intro x _
        have h1 : x ∈ a ⁻¹ᵁ wcSgD k N i := by rw [haD]; trivial
        have h2 : x ∈ b ⁻¹ᵁ V := by rw [hbV]; trivial
        rw [Scheme.Hom.mem_preimage]
        refine TopologicalSpace.Opens.mem_inf.mpr ⟨?_, ?_⟩
        · rw [Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply, hφ1]
          exact (Scheme.Hom.mem_preimage _).mp h1
        · rw [Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply, hφ2]
          exact (Scheme.Hom.mem_preimage _).mp h2
      have hρψ : ((Scheme.ΓSpecIso (CommRingCat.of (MvPolynomial (Fin (N + 1)) Γ(B, V) ⧸ I))).hom.hom.comp
          (φT.appLE (wcpaDjFlrgChart k N sB V i) ⊤ hφC).hom).comp (wcpaDjFlrgPsi k N sB V i) =
          Ideal.Quotient.mk I := by
        apply MvPolynomial.ringHom_ext
        · intro c
          rw [RingHom.comp_apply, hψC, RingHom.comp_apply]
          have e := congrArg (fun φ => φ.hom c) (Scheme.Hom.appLE_comp_appLE φT
            (Limits.pullback.snd (wcProjKStr k N) sB) V (wcpaDjFlrgChart k N sB V i) ⊤
            inf_le_right hφC)
          simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e
          rw [e, hM _ _ hφ2 V ⊤ _ hbV.ge, hbval]
        · intro l
          rw [RingHom.comp_apply, hψX, RingHom.comp_apply]
          have e := congrArg (fun φ => φ.hom (wcSgE k N i l)) (Scheme.Hom.appLE_comp_appLE φT
            (Limits.pullback.fst (wcProjKStr k N) sB) (wcSgD k N i) (wcpaDjFlrgChart k N sB V i) ⊤
            inf_le_left hφC)
          simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e
          rw [e, hM _ _ hφ1 (wcSgD k N i) ⊤ _ haD.ge, ha4, ht]
          exact Iso.inv_hom_id_apply (Scheme.ΓSpecIso _) _
      have h0 := RingHom.congr_fun hρψ g
      rw [RingHom.comp_apply, hg, map_zero] at h0
      exact Ideal.Quotient.eq_zero_iff_mem.mp h0.symm
    · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker, map_sub,
        map_one, hψX, (wc_ldpi_oai_sgE_facts k N i i).1, map_one, sub_self]

theorem wcpa_dj_flrg_generic_hilb : ∀ (k : Type u) [Field k] (X P P' : Scheme.{u}) [AlgebraicGeometry.IsIntegral P] [AlgebraicGeometry.IsIntegral P'] (sP : P ⟶ Spec (.of k)) (f : X ⟶ P) (U : P.Opens) (N : ℕ) (jX : X ⟶ wcProjK k N) (hcomm : jX ≫ wcProjKStr k N = f ≫ sP) (hZ : (Limits.pullback.fst f U.ι ≫ jX) ≫ wcProjKStr k N = Limits.pullback.snd f U.ι ≫ U.ι ≫ sP) (e₀ r L : ℕ) (Φ : ℕ → ℕ) (μ : U.toScheme ⟶ wcProjK k L) (G : ∀ c : Fin (L + 1), Fin r → MvPolynomial (Fin (N + 1)) Γ(wcProjK k L, wcSgD k L c)) (β : P' ⟶ P) (γ : P' ⟶ wcProjK k L), IsClosedImmersion jX → wcpaDjIsProjOver k sP → wcpaDjIsProjOver k (β ≫ sP) → U ≠ ⊥ → μ ≫ wcProjKStr k L = U.ι ≫ sP → wcpaDjFlrgHilb k N (U.ι ≫ sP) (Limits.pullback.fst f U.ι ≫ jX) (Limits.pullback.snd f U.ι) hZ e₀ r L Φ μ G → IsIso (β ∣_ U) → γ ≫ wcProjKStr k L = β ≫ sP → (β ⁻¹ᵁ U).ι ≫ γ = (β ∣_ U) ≫ μ → ∀ (c : Fin (L + 1)) (V' : P'.Opens) (hV : V' ≤ γ ⁻¹ᵁ wcSgD k L c) [IsDomain Γ(P', V')], IsAffineOpen V' → ∀ e, e₀ ≤ e → wcpaDjHilbFn (FractionRing Γ(P', V')) N (Ideal.span (Set.range fun a => MvPolynomial.map (algebraMap Γ(P', V') (FractionRing Γ(P', V'))) (MvPolynomial.map (γ.appLE (wcSgD k L c) V' hV).hom (G c a)))) e = Φ e :=
by
  intro k _ X P P' _ _ sP f U N jX hcomm hZ e₀ r L Φ μ G β γ hjX hP hP' hU hμ hH hβiso hγ hcomp c V' hV _ hV'aff e he
  classical
  have C4 : ∀ (K L' : Type u) [Field K] [Field L'] (σ : K →+* L')
      (F : Fin r → MvPolynomial (Fin (N + 1)) K), (∀ a, (F a).IsHomogeneous e₀) →
      wcpaDjHilbFn L' N (Ideal.span (Set.range fun a => MvPolynomial.map σ (F a))) e =
        wcpaDjHilbFn K N (Ideal.span (Set.range F)) e := by
    let I := {x : (Fin (N + 1) →₀ ℕ) × Fin r // x.1.degree + e₀ = e}
    haveI hIfin : Finite I := by
      have h1 : {x : (Fin (N + 1) →₀ ℕ) × Fin r | x.1.degree + e₀ = e}.Finite := by
        refine ((Finsupp.finite_of_degree_le (σ := Fin (N + 1)) e).prod Set.finite_univ).subset ?_
        rintro ⟨d, a⟩ hx
        simp only [Set.mem_setOf_eq] at hx
        exact ⟨show d.degree ≤ e by omega, Set.mem_univ _⟩
      exact h1.to_subtype

    have hS : ∀ (K₀ : Type u) [Field K₀],
        Module.Finite K₀ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K₀ e) ∧
        Module.finrank K₀ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K₀ e) =
          Nat.card {d : Fin (N + 1) →₀ ℕ // d.degree = e} := by
      intro K₀ _
      haveI hfin : Finite {d : Fin (N + 1) →₀ ℕ | d.degree = e} :=
        ((Finsupp.finite_of_degree_le (σ := Fin (N + 1)) e).subset
          (fun d (hd : d.degree = e) => le_of_eq hd)).to_subtype
      rw [MvPolynomial.homogeneousSubmodule_eq_finsupp_supported]
      exact ⟨Module.Finite.of_basis (MvPolynomial.basisRestrictSupport K₀ {d | d.degree = e}),
        Module.finrank_eq_nat_card_basis (MvPolynomial.basisRestrictSupport K₀ {d | d.degree = e})⟩

    have hC3 : ∀ (K₀ : Type u) [Field K₀] (𝔞 : Ideal (MvPolynomial (Fin (N + 1)) K₀)),
        wcpaDjHilbFn K₀ N 𝔞 e + Module.finrank K₀ ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K₀ e ⊓
          Submodule.restrictScalars K₀ 𝔞) = Nat.card {d : Fin (N + 1) →₀ ℕ // d.degree = e} := by
      intro K₀ _ 𝔞
      obtain ⟨hfin, hrank⟩ := hS K₀
      rw [← hrank, ← Submodule.map_comap_subtype, Submodule.finrank_map_subtype_eq]
      exact Submodule.finrank_quotient_add_finrank _

    have hC1 : ∀ (K₀ : Type u) [Field K₀] (F₀ : Fin r → MvPolynomial (Fin (N + 1)) K₀),
        (∀ a, (F₀ a).IsHomogeneous e₀) →
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K₀ e ⊓
            Submodule.restrictScalars K₀ (Ideal.span (Set.range F₀)) =
          Submodule.span K₀ (Set.range fun x : I => MvPolynomial.monomial x.1.1 (1 : K₀) * F₀ x.1.2) := by
      intro K₀ _ F₀ hF₀
      have hmon : ∀ (d : Fin (N + 1) →₀ ℕ) (a : Fin r),
          (MvPolynomial.monomial d (1 : K₀) * F₀ a).IsHomogeneous (d.degree + e₀) :=
        fun d a => (MvPolynomial.isHomogeneous_monomial _ rfl).mul (hF₀ a)
      apply le_antisymm
      · intro g hg
        obtain ⟨hgS, hgI⟩ := Submodule.mem_inf.mp hg
        rw [Submodule.restrictScalars_mem] at hgI
        obtain ⟨c, rfl⟩ := Ideal.mem_span_range_iff_exists_fun.mp hgI
        have key : ∀ (c' : MvPolynomial (Fin (N + 1)) K₀) (a : Fin r),
            MvPolynomial.homogeneousComponent e (c' * F₀ a) ∈
              Submodule.span K₀ (Set.range fun x : I => MvPolynomial.monomial x.1.1 (1 : K₀) * F₀ x.1.2) := by
          intro c' a
          have hexp : c' * F₀ a = ∑ d ∈ c'.support,
              c'.coeff d • (MvPolynomial.monomial d (1 : K₀) * F₀ a) := by
            conv_lhs => rw [MvPolynomial.as_sum c']
            rw [Finset.sum_mul]
            refine Finset.sum_congr rfl (fun d _ => ?_)
            rw [MvPolynomial.smul_eq_C_mul, ← mul_assoc, MvPolynomial.C_mul_monomial, mul_one]
          rw [hexp, map_sum]
          refine Submodule.sum_mem _ (fun d _ => ?_)
          rw [map_smul]
          refine Submodule.smul_mem _ _ ?_
          rw [MvPolynomial.homogeneousComponent_of_mem
            ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (hmon d a))]
          split_ifs with h
          · exact Submodule.subset_span ⟨⟨(d, a), h.symm⟩, rfl⟩
          · exact Submodule.zero_mem _
        have h1 := MvPolynomial.homogeneousComponent_of_mem (m := e) hgS
        rw [if_pos rfl] at h1
        rw [← h1, map_sum]
        exact Submodule.sum_mem _ (fun a _ => key (c a) a)
      · rw [Submodule.span_le]
        rintro _ ⟨x, rfl⟩
        rw [SetLike.mem_coe, Submodule.mem_inf]
        refine ⟨?_, ?_⟩
        · rw [MvPolynomial.mem_homogeneousSubmodule]
          have hx := hmon x.1.1 x.1.2
          rw [x.2] at hx
          exact hx
        · rw [Submodule.restrictScalars_mem]
          exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨x.1.2, rfl⟩)

    have hC2 : ∀ (K₀ L₀ : Type u) [Field K₀] [Field L₀] (σ₀ : K₀ →+* L₀)
        (t : I → MvPolynomial (Fin (N + 1)) K₀),
        Module.finrank L₀ (Submodule.span L₀ (Set.range fun x => MvPolynomial.map σ₀ (t x))) =
          Module.finrank K₀ (Submodule.span K₀ (Set.range t)) := by
      intro K₀ L₀ _ _ σ₀ t
      obtain ⟨b, hbs, hspan, hli⟩ := exists_linearIndependent K₀ (Set.range t)
      have hbfin : b.Finite := (Set.finite_range t).subset hbs
      haveI : Fintype b := hbfin.fintype
      have hli' : LinearIndependent L₀
          (fun x : b => MvPolynomial.map σ₀ (x : MvPolynomial (Fin (N + 1)) K₀)) := by
        letI : Algebra K₀ L₀ := σ₀.toAlgebra
        have h1 := Module.Flat.linearIndependent_one_tmul (S := L₀) hli
        have h2 := h1.map' (MvPolynomial.algebraTensorAlgEquiv K₀ L₀).toLinearEquiv.toLinearMap
          (LinearEquiv.ker _)
        convert h2 using 1
        funext x
        simp only [Function.comp_apply, AlgEquiv.toLinearEquiv_toLinearMap,
          AlgEquiv.toLinearMap_apply, MvPolynomial.algebraTensorAlgEquiv_tmul, one_smul]
        rfl
      have e1 : Module.finrank K₀ (Submodule.span K₀ (Set.range t)) = Fintype.card b := by
        rw [← hspan]
        have := finrank_span_eq_card hli
        rwa [Subtype.range_coe] at this
      have e2 : Submodule.span L₀ (Set.range fun x => MvPolynomial.map σ₀ (t x)) =
          Submodule.span L₀ (Set.range fun x : b =>
            MvPolynomial.map σ₀ (x : MvPolynomial (Fin (N + 1)) K₀)) := by
        apply le_antisymm
        · rw [Submodule.span_le]
          rintro _ ⟨i, rfl⟩
          have hti : t i ∈ Submodule.span K₀ b := by
            rw [hspan]; exact Submodule.subset_span ⟨i, rfl⟩
          refine Submodule.span_induction (p := fun y _ => MvPolynomial.map σ₀ y ∈
            Submodule.span L₀ (Set.range fun x : b =>
              MvPolynomial.map σ₀ (x : MvPolynomial (Fin (N + 1)) K₀))) ?_ ?_ ?_ ?_ hti
          · intro y hy
            exact Submodule.subset_span ⟨⟨y, hy⟩, rfl⟩
          · rw [map_zero]; exact Submodule.zero_mem _
          · intro y z _ _ hy hz
            rw [map_add]; exact Submodule.add_mem _ hy hz
          · intro c y _ hy
            rw [MvPolynomial.smul_eq_C_mul, map_mul, MvPolynomial.map_C,
              ← MvPolynomial.smul_eq_C_mul]
            exact Submodule.smul_mem _ _ hy
        · apply Submodule.span_mono
          rintro _ ⟨x, rfl⟩
          obtain ⟨i, hi⟩ := hbs x.2
          exact ⟨i, by simp only [hi]⟩
      rw [e2, e1, finrank_span_eq_card hli']

    intro K L' _ _ σ F hF
    have hF' : ∀ a, (MvPolynomial.map σ (F a)).IsHomogeneous e₀ := fun a => (hF a).map σ
    have h1 := hC3 L' (Ideal.span (Set.range fun a => MvPolynomial.map σ (F a)))
    have h2 := hC3 K (Ideal.span (Set.range F))
    rw [hC1 L' (fun a => MvPolynomial.map σ (F a)) hF'] at h1
    rw [hC1 K F hF] at h2
    have h3 : (Set.range fun x : I => MvPolynomial.monomial x.1.1 (1 : L') *
        (fun a => MvPolynomial.map σ (F a)) x.1.2) =
        Set.range fun x : I => MvPolynomial.map σ (MvPolynomial.monomial x.1.1 (1 : K) * F x.1.2) := by
      congr 1; funext x; rw [map_mul, MvPolynomial.map_monomial, σ.map_one]
    rw [h3, hC2 K L' σ] at h1
    omega

  have hV'ne : (V' : Set P').Nonempty := by
    obtain ⟨x⟩ : Nonempty (PrimeSpectrum Γ(P', V')) := inferInstance
    refine ⟨hV'aff.fromSpec x, ?_⟩
    rw [← hV'aff.range_fromSpec]
    exact ⟨x, rfl⟩

  have hηV' : genericPoint P' ∈ V' :=
    ((genericPoint_spec P').mem_open_set_iff V'.isOpen).mpr (by simpa using hV'ne)
  have hηU : genericPoint P' ∈ β ⁻¹ᵁ U := by
    obtain ⟨u, hu⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).mp hU
    have hne : ((β ⁻¹ᵁ U : P'.Opens) : Set P').Nonempty :=
      ⟨((inv (β ∣_ U)) (⟨u, hu⟩ : U.toScheme)).1, ((inv (β ∣_ U)) (⟨u, hu⟩ : U.toScheme)).2⟩
    exact ((genericPoint_spec P').mem_open_set_iff (β ⁻¹ᵁ U).isOpen).mpr (by simpa using hne)

  let p : (β ⁻¹ᵁ U).toScheme := ⟨genericPoint P', hηU⟩
  have hιp : (β ⁻¹ᵁ U).ι p = genericPoint P' := Scheme.Opens.ι_apply _ _
  have ha : (β ⁻¹ᵁ U).ι p ∈ V' := by rw [hιp]; exact hηV'
  have hq : (β ∣_ U) p ∈ μ ⁻¹ᵁ wcSgD k L c := by
    rw [Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply, ← hcomp, Scheme.Hom.comp_apply]
    exact hV ha

  have H := hH.2.2.2 c ((β ∣_ U) p) hq e he

  have hevinj : ∀ (x : P') (hx : x ∈ V'), x = genericPoint P' →
      Function.Injective (P'.evaluation V' x hx).hom := by
    rintro x hx rfl
    rw [← Scheme.germ_residue, CommRingCat.hom_comp, RingHom.coe_comp]
    exact (RingHom.injective _).comp (germ_injective_of_isIntegral P' _ hx)
  let g : Γ(P', V') →+* (β ⁻¹ᵁ U).toScheme.residueField p :=
    (P'.evaluation V' ((β ⁻¹ᵁ U).ι p) ha ≫ (β ⁻¹ᵁ U).ι.residueFieldMap p).hom
  have hg : Function.Injective g := by
    show Function.Injective (P'.evaluation V' ((β ⁻¹ᵁ U).ι p) ha ≫
      (β ⁻¹ᵁ U).ι.residueFieldMap p).hom
    rw [CommRingCat.hom_comp, RingHom.coe_comp]
    exact (RingHom.injective _).comp (hevinj _ ha hιp)
  let σ₂ : FractionRing Γ(P', V') →+* (β ⁻¹ᵁ U).toScheme.residueField p :=
    IsFractionRing.lift hg
  let σ₁ := ((β ∣_ U).residueFieldMap p).hom
  let ρ := (μ.app (wcSgD k L c) ≫ U.toScheme.presheaf.germ (μ ⁻¹ᵁ wcSgD k L c) ((β ∣_ U) p) hq ≫
    U.toScheme.residue ((β ∣_ U) p)).hom

  have hres : ∀ (y : P') (hy : y ∈ V') (s : Γ(wcProjK k L, wcSgD k L c)),
      (P'.evaluation V' y hy).hom ((γ.appLE (wcSgD k L c) V' hV).hom s) =
        (γ.residueFieldMap y).hom (((wcProjK k L).evaluation (wcSgD k L c) (γ y)
          ((Scheme.Hom.mem_preimage _).mp (hV hy))).hom s) := by
    intro y hy s
    have h1 : γ.appLE (wcSgD k L c) V' hV =
        γ.app (wcSgD k L c) ≫ P'.presheaf.map (homOfLE hV).op := by
      rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_map]
    have h2 : ∀ t : Γ(P', γ ⁻¹ᵁ wcSgD k L c),
        (P'.evaluation V' y hy).hom ((P'.presheaf.map (homOfLE hV).op).hom t) =
          (P'.evaluation (γ ⁻¹ᵁ wcSgD k L c) y (hV hy)).hom t := by
      intro t
      rw [← Scheme.germ_residue, ← Scheme.germ_residue]
      simp only [CommRingCat.hom_comp, RingHom.comp_apply]
      congr 1
      first
      | exact TopCat.Presheaf.germ_res_apply _ _ _ _ _
      | rw [TopCat.Presheaf.germ_res_apply]
      | simp [TopCat.Presheaf.germ_res_apply]
    rw [h1, CommRingCat.hom_comp, RingHom.comp_apply, h2]
    exact (Scheme.evaluation_naturality_apply γ y _ s).symm
  have key : ∀ (φ₁ φ₂ : (β ⁻¹ᵁ U).toScheme ⟶ wcProjK k L) (_ : φ₁ = φ₂)
      (h₁ : φ₁ p ∈ wcSgD k L c) (h₂ : φ₂ p ∈ wcSgD k L c) (s : Γ(wcProjK k L, wcSgD k L c)),
      (φ₁.residueFieldMap p).hom (((wcProjK k L).evaluation (wcSgD k L c) (φ₁ p) h₁).hom s) =
        (φ₂.residueFieldMap p).hom (((wcProjK k L).evaluation (wcSgD k L c) (φ₂ p) h₂).hom s) := by
    intro φ₁ φ₂ h h₁ h₂ s
    subst h
    rfl
  have hγp : γ ((β ⁻¹ᵁ U).ι p) ∈ wcSgD k L c := by
    first
    | exact (Scheme.Hom.mem_preimage _).mp (hV ha)
    | exact hV ha
  have hμq : μ ((β ∣_ U) p) ∈ wcSgD k L c := by
    first
    | exact (Scheme.Hom.mem_preimage _).mp hq
    | exact hq
  have compat : ∀ s, g ((γ.appLE (wcSgD k L c) V' hV).hom s) = σ₁ (ρ s) := by
    intro s
    show ((β ⁻¹ᵁ U).ι.residueFieldMap p).hom ((P'.evaluation V' ((β ⁻¹ᵁ U).ι p) ha).hom
      ((γ.appLE (wcSgD k L c) V' hV).hom s)) = σ₁ (ρ s)
    rw [hres]
    have e1 : ρ s = (U.toScheme.evaluation (μ ⁻¹ᵁ wcSgD k L c) ((β ∣_ U) p) hq).hom
        ((μ.app (wcSgD k L c)).hom s) := by
      show (U.toScheme.residue ((β ∣_ U) p)).hom ((U.toScheme.presheaf.germ (μ ⁻¹ᵁ wcSgD k L c)
        ((β ∣_ U) p) hq).hom ((μ.app (wcSgD k L c)).hom s)) = _
      rw [← Scheme.germ_residue]
      rfl
    have e3 : (U.toScheme.evaluation (μ ⁻¹ᵁ wcSgD k L c) ((β ∣_ U) p) hq).hom
        ((μ.app (wcSgD k L c)).hom s) = (μ.residueFieldMap ((β ∣_ U) p)).hom
          (((wcProjK k L).evaluation (wcSgD k L c) (μ ((β ∣_ U) p)) hμq).hom s) :=
      (Scheme.evaluation_naturality_apply μ ((β ∣_ U) p) hμq s).symm
    rw [e1, e3]
    have e2 := key ((β ⁻¹ᵁ U).ι ≫ γ) ((β ∣_ U) ≫ μ) hcomp hγp hμq s
    rw [Scheme.residueFieldMap_comp, Scheme.residueFieldMap_comp] at e2
    exact e2

  have hF : ∀ a, (MvPolynomial.map (algebraMap Γ(P', V') (FractionRing Γ(P', V')))
      (MvPolynomial.map (γ.appLE (wcSgD k L c) V' hV).hom (G c a))).IsHomogeneous e₀ :=
    fun a => (((hH.2.1 c).1 a).map _).map _
  have hG : ∀ a, (MvPolynomial.map ρ (G c a)).IsHomogeneous e₀ :=
    fun a => ((hH.2.1 c).1 a).map _
  have hring : (σ₂.comp (algebraMap Γ(P', V') (FractionRing Γ(P', V')))).comp
      (γ.appLE (wcSgD k L c) V' hV).hom = σ₁.comp ρ := by
    refine RingHom.ext fun s => ?_
    rw [RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply]
    rw [IsFractionRing.lift_algebraMap]
    exact compat s
  have hmap : ∀ a, MvPolynomial.map σ₂ (MvPolynomial.map
      (algebraMap Γ(P', V') (FractionRing Γ(P', V')))
      (MvPolynomial.map (γ.appLE (wcSgD k L c) V' hV).hom (G c a))) =
      MvPolynomial.map σ₁ (MvPolynomial.map ρ (G c a)) := by
    intro a
    rw [MvPolynomial.map_map, MvPolynomial.map_map, MvPolynomial.map_map, hring]
  rw [← C4 _ _ σ₂ _ hF]
  simp only [hmap]
  rw [C4 _ _ σ₁ _ hG]
  exact H

theorem wcpa_dj_flrg_chart_vanish : ∀ (k : Type u) [Field k] (X P P' : Scheme.{u}) [AlgebraicGeometry.IsIntegral P] [AlgebraicGeometry.IsIntegral P'] (sP : P ⟶ Spec (.of k)) (f : X ⟶ P) (U : P.Opens) (N : ℕ) (jX : X ⟶ wcProjK k N) (hcomm : jX ≫ wcProjKStr k N = f ≫ sP) (hZ : (Limits.pullback.fst f U.ι ≫ jX) ≫ wcProjKStr k N = Limits.pullback.snd f U.ι ≫ U.ι ≫ sP) (e₀ r L : ℕ) (Φ : ℕ → ℕ) (μ : U.toScheme ⟶ wcProjK k L) (G : ∀ c : Fin (L + 1), Fin r → MvPolynomial (Fin (N + 1)) Γ(wcProjK k L, wcSgD k L c)) (β : P' ⟶ P) (γ : P' ⟶ wcProjK k L), IsClosedImmersion jX → wcpaDjIsProjOver k sP → wcpaDjIsProjOver k (β ≫ sP) → U ≠ ⊥ → μ ≫ wcProjKStr k L = U.ι ≫ sP → wcpaDjFlrgHilb k N (U.ι ≫ sP) (Limits.pullback.fst f U.ι ≫ jX) (Limits.pullback.snd f U.ι) hZ e₀ r L Φ μ G → IsIso (β ∣_ U) → γ ≫ wcProjKStr k L = β ≫ sP → (β ⁻¹ᵁ U).ι ≫ γ = (β ∣_ U) ≫ μ → ∀ (he : (Limits.pullback.fst f β ≫ jX) ≫ wcProjKStr k N = Limits.pullback.snd f β ≫ β ≫ sP) (c : Fin (L + 1)) (V' : P'.Opens) (hV : V' ≤ γ ⁻¹ᵁ wcSgD k L c) (i : Fin (N + 1)), IsAffineOpen V' → ∀ a, (((Limits.pullback.snd f β ⁻¹ᵁ (β ⁻¹ᵁ U)).ι.imageι ≫ Limits.pullback.lift (Limits.pullback.fst f β ≫ jX) (Limits.pullback.snd f β) he).appLE (wcpaDjFlrgChart k N (β ≫ sP) V' i) (((Limits.pullback.snd f β ⁻¹ᵁ (β ⁻¹ᵁ U)).ι.imageι ≫ Limits.pullback.lift (Limits.pullback.fst f β ≫ jX) (Limits.pullback.snd f β) he) ⁻¹ᵁ wcpaDjFlrgChart k N (β ≫ sP) V' i) le_rfl).hom (wcpaDjFlrgPsi k N (β ≫ sP) V' i (MvPolynomial.map (γ.appLE (wcSgD k L c) V' hV).hom (G c a))) = 0 :=
by
  intro k _ X P P' _ _ sP f U N jX hcomm hZ e₀ r L Φ μ G β γ hjX hP hP' hU hμ hH hβiso hγ hcomp
    he c V' hV i hV'aff a
  classical

  have happLE : ∀ {A B' : Scheme.{u}} (g₁ g₂ : A ⟶ B') (_ : g₁ = g₂) (O : B'.Opens)
      (O' : A.Opens) (e1 : O' ≤ g₁ ⁻¹ᵁ O) (e2 : O' ≤ g₂ ⁻¹ᵁ O) (b : Γ(B', O)),
      (g₁.appLE O O' e1).hom b = (g₂.appLE O O' e2).hom b := by
    intro A B' g₁ g₂ h O O' e1 e2 b
    subst h
    rfl
  have hle4 : ∀ {A B C : Scheme.{u}} (g : A ⟶ B) (h : B ⟶ C) (O : B.Opens) (O' : C.Opens)
      (A₀ : A.Opens), A₀ ≤ g ⁻¹ᵁ O → O ≤ h ⁻¹ᵁ O' → A₀ ≤ (g ≫ h) ⁻¹ᵁ O' := by
    intro A B C g h O O' A₀ h1 h2 x hx
    rw [Scheme.Hom.mem_preimage, Scheme.Hom.comp_apply]
    exact (Scheme.Hom.mem_preimage h).mp (h2 ((Scheme.Hom.mem_preimage g).mp (h1 hx)))
  have hle1 : ∀ {B A : Scheme.{u}} (sB : B ⟶ Spec (.of k)) (V : B.Opens)
      (q : A ⟶ Limits.pullback (wcProjKStr k N) sB) (A₀ : A.Opens),
      A₀ ≤ q ⁻¹ᵁ wcpaDjFlrgChart k N sB V i →
      A₀ ≤ (q ≫ Limits.pullback.snd (wcProjKStr k N) sB) ⁻¹ᵁ V := by
    intro B A sB V q A₀ hA
    exact hle4 _ _ _ _ _ hA inf_le_right
  have hle2 : ∀ {B A : Scheme.{u}} (sB : B ⟶ Spec (.of k)) (V : B.Opens)
      (q : A ⟶ Limits.pullback (wcProjKStr k N) sB) (A₀ : A.Opens),
      A₀ ≤ q ⁻¹ᵁ wcpaDjFlrgChart k N sB V i →
      A₀ ≤ (q ≫ Limits.pullback.fst (wcProjKStr k N) sB) ⁻¹ᵁ wcSgD k N i := by
    intro B A sB V q A₀ hA
    exact hle4 _ _ _ _ _ hA inf_le_left

  have hEF : ∀ {B A : Scheme.{u}} (sB : B ⟶ Spec (.of k)) (V : B.Opens) (ρ : B ⟶ wcProjK k L)
      (hρ : V ≤ ρ ⁻¹ᵁ wcSgD k L c) (q : A ⟶ Limits.pullback (wcProjKStr k N) sB) (A₀ : A.Opens)
      (hA : A₀ ≤ q ⁻¹ᵁ wcpaDjFlrgChart k N sB V i)
      (hS : A₀ ≤ ((q ≫ Limits.pullback.snd (wcProjKStr k N) sB) ≫ ρ) ⁻¹ᵁ wcSgD k L c)
      (hF : A₀ ≤ (q ≫ Limits.pullback.fst (wcProjKStr k N) sB) ⁻¹ᵁ wcSgD k N i)
      (g : MvPolynomial (Fin (N + 1)) Γ(wcProjK k L, wcSgD k L c)),
      (q.appLE (wcpaDjFlrgChart k N sB V i) A₀ hA).hom
          (wcpaDjFlrgPsi k N sB V i (MvPolynomial.map (ρ.appLE (wcSgD k L c) V hρ).hom g)) =
        MvPolynomial.eval₂
          (((q ≫ Limits.pullback.snd (wcProjKStr k N) sB) ≫ ρ).appLE (wcSgD k L c) A₀ hS).hom
          (fun l => ((q ≫ Limits.pullback.fst (wcProjKStr k N) sB).appLE (wcSgD k N i) A₀ hF).hom
            (wcSgE k N i l)) g := by
    intro B A sB V ρ hρ q A₀ hA hS hF g
    have h1 : ∀ b, (q.appLE (wcpaDjFlrgChart k N sB V i) A₀ hA).hom
        (((Limits.pullback.snd (wcProjKStr k N) sB).appLE V (wcpaDjFlrgChart k N sB V i)
          inf_le_right).hom ((ρ.appLE (wcSgD k L c) V hρ).hom b)) =
        (((q ≫ Limits.pullback.snd (wcProjKStr k N) sB) ≫ ρ).appLE (wcSgD k L c) A₀ hS).hom b := by
      intro b
      have h := congrArg (fun φ => φ.hom b) (Scheme.Hom.appLE_comp_appLE
        (q ≫ Limits.pullback.snd (wcProjKStr k N) sB) ρ (wcSgD k L c) V A₀ hρ
        (hle1 sB V q A₀ hA))
      have h' := congrArg (fun φ => φ.hom ((ρ.appLE (wcSgD k L c) V hρ).hom b))
        (Scheme.Hom.appLE_comp_appLE q (Limits.pullback.snd (wcProjKStr k N) sB) V
          (wcpaDjFlrgChart k N sB V i) A₀ inf_le_right hA)
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h h'
      exact h'.trans h
    have h2 : ∀ l, (q.appLE (wcpaDjFlrgChart k N sB V i) A₀ hA).hom
        (((Limits.pullback.fst (wcProjKStr k N) sB).appLE (wcSgD k N i)
          (wcpaDjFlrgChart k N sB V i) inf_le_left).hom (wcSgE k N i l)) =
        ((q ≫ Limits.pullback.fst (wcProjKStr k N) sB).appLE (wcSgD k N i) A₀ hF).hom
          (wcSgE k N i l) := by
      intro l
      have h := congrArg (fun φ => φ.hom (wcSgE k N i l))
        (Scheme.Hom.appLE_comp_appLE q (Limits.pullback.fst (wcProjKStr k N) sB) (wcSgD k N i)
          (wcpaDjFlrgChart k N sB V i) A₀ inf_le_left hA)
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h
      exact h
    unfold wcpaDjFlrgPsi
    rw [MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_map, MvPolynomial.eval₂_comp_left]
    congr 1
    · exact RingHom.ext fun b => h1 b
    · funext l
      exact h2 l
  have hEv : ∀ {A : Scheme.{u}} (a₁ a₂ : A ⟶ wcProjK k L) (b₁ b₂ : A ⟶ wcProjK k N)
      (A₀ : A.Opens) (ha₁ : A₀ ≤ a₁ ⁻¹ᵁ wcSgD k L c) (ha₂ : A₀ ≤ a₂ ⁻¹ᵁ wcSgD k L c)
      (hb₁ : A₀ ≤ b₁ ⁻¹ᵁ wcSgD k N i) (hb₂ : A₀ ≤ b₂ ⁻¹ᵁ wcSgD k N i)
      (g : MvPolynomial (Fin (N + 1)) Γ(wcProjK k L, wcSgD k L c)), a₁ = a₂ → b₁ = b₂ →
      MvPolynomial.eval₂ (a₁.appLE (wcSgD k L c) A₀ ha₁).hom
          (fun l => (b₁.appLE (wcSgD k N i) A₀ hb₁).hom (wcSgE k N i l)) g =
        MvPolynomial.eval₂ (a₂.appLE (wcSgD k L c) A₀ ha₂).hom
          (fun l => (b₂.appLE (wcSgD k N i) A₀ hb₂).hom (wcSgE k N i l)) g := by
    intro A a₁ a₂ b₁ b₂ A₀ ha₁ ha₂ hb₁ hb₂ g h₁ h₂
    subst h₁
    subst h₂
    rfl

  have hproj : ∀ {Y : Scheme.{u}} (s : Y ⟶ Spec (.of k)), wcpaDjIsProjOver k s → IsProper s := by
    intro Y s hs
    obtain ⟨N, j, hj, rfl⟩ := hs
    haveI := hj
    haveI hst : IsScalarTower k (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0))
        (MvPolynomial (Fin (N + 1)) k) :=
      IsScalarTower.of_algebraMap_eq
        (S := ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)) (fun c => by
          rw [SetLike.GradeZero.algebraMap_apply]
          exact (SetLike.GradeZero.coe_algebraMap
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) c).symm)
    haveI : Algebra.FiniteType (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0))
        (MvPolynomial (Fin (N + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k _ _
    haveI : IsProper (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
        MvPolynomial.gradedAlgebra) := inferInstance
    have hkey : ∀ c : k, ((algebraMap k (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)) c :
        ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)) : MvPolynomial (Fin (N + 1)) k) =
        MvPolynomial.C c := by
      intro c
      rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
    have hbij : Function.Bijective
        (algebraMap k (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0))) := by
      constructor
      · intro a b hab
        have h1 := congrArg (fun x : ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0) =>
          (x : MvPolynomial (Fin (N + 1)) k)) hab
        simp only [hkey] at h1
        exact MvPolynomial.C_injective _ _ h1
      · intro p
        have hp : (p : MvPolynomial (Fin (N + 1)) k).IsHomogeneous 0 :=
          (MvPolynomial.mem_homogeneousSubmodule _ _).mp p.2
        have htd : (p : MvPolynomial (Fin (N + 1)) k).totalDegree = 0 :=
          Nat.le_zero.mp hp.totalDegree_le
        refine ⟨(p : MvPolynomial (Fin (N + 1)) k).coeff 0, Subtype.ext ?_⟩
        rw [hkey]
        exact ((MvPolynomial.totalDegree_eq_zero_iff_eq_C).mp htd).symm
    haveI : IsIso (CommRingCat.ofHom
        (algebraMap k (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)))) :=
      (ConcreteCategory.isIso_iff_bijective _).mpr hbij
    infer_instance
  haveI hsP : IsProper sP := hproj sP hP
  haveI hfsP : IsProper (f ≫ sP) := hproj (f ≫ sP) (hcomm ▸ ⟨N, jX, hjX, rfl⟩)
  haveI hf : IsProper f := IsProper.of_comp f sP
  haveI hβsP : IsProper (β ≫ sP) := hproj _ hP'
  haveI hsnd : IsProper (Limits.pullback.snd f β) := by
    first
    | infer_instance
    | exact MorphismProperty.of_isPullback (P := @IsProper) (IsPullback.of_hasPullback f β).flip hf
    | exact MorphismProperty.of_isPullback (P := @IsProper) (IsPullback.of_hasPullback f β) hf
  haveI : IsProper (Limits.pullback.snd f β ≫ β ≫ sP) := inferInstance
  haveI : IsLocallyNoetherian (Limits.pullback f β) :=
    LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd f β ≫ β ≫ sP)
  set e := Limits.pullback.lift (Limits.pullback.fst f β ≫ jX) (Limits.pullback.snd f β) he
    with he_def
  set eZ := Limits.pullback.lift (Limits.pullback.fst f U.ι ≫ jX) (Limits.pullback.snd f U.ι) hZ
    with heZ_def
  set C' := wcpaDjFlrgChart k N (β ≫ sP) V' i with hC'
  set ψF := wcpaDjFlrgPsi k N (β ≫ sP) V' i (MvPolynomial.map (γ.appLE (wcSgD k L c) V' hV).hom
    (G c a)) with hψF

  have hΞ : ((Limits.pullback.snd f β ⁻¹ᵁ (β ⁻¹ᵁ U)).ι ≫ Limits.pullback.fst f β) ≫ f =
      ((Limits.pullback.snd f β ∣_ (β ⁻¹ᵁ U)) ≫ (β ∣_ U)) ≫ U.ι := by
    simp only [Category.assoc]
    rw [Limits.pullback.condition, morphismRestrict_ι β U]
    simp only [← Category.assoc, morphismRestrict_ι]
  obtain ⟨XI, hM, hFm⟩ : ∃ XI : (Limits.pullback.snd f β ⁻¹ᵁ (β ⁻¹ᵁ U)).toScheme ⟶
      Limits.pullback f U.ι,
      (((Limits.pullback.snd f β ⁻¹ᵁ (β ⁻¹ᵁ U)).ι ≫ e) ≫
          Limits.pullback.snd (wcProjKStr k N) (β ≫ sP)) ≫ γ =
        ((XI ≫ eZ) ≫ Limits.pullback.snd (wcProjKStr k N) (U.ι ≫ sP)) ≫ μ ∧
      ((Limits.pullback.snd f β ⁻¹ᵁ (β ⁻¹ᵁ U)).ι ≫ e) ≫
          Limits.pullback.fst (wcProjKStr k N) (β ≫ sP) =
        (XI ≫ eZ) ≫ Limits.pullback.fst (wcProjKStr k N) (U.ι ≫ sP) := by
    refine ⟨Limits.pullback.lift _ _ hΞ, ?_, ?_⟩
    · simp only [he_def, heZ_def, Category.assoc, Limits.pullback.lift_snd]
      rw [← hcomp]
      simp only [← Category.assoc, morphismRestrict_ι]
    · simp only [he_def, heZ_def, Category.assoc, Limits.pullback.lift_fst,
        Limits.pullback.lift_fst_assoc]
  clear hΞ
  revert XI hM hFm
  generalize Limits.pullback.snd f β ⁻¹ᵁ (β ⁻¹ᵁ U) = Wo
  intro XI hM hFm

  have hW : ((Wo.ι ≫ e).appLE C' ((Wo.ι ≫ e) ⁻¹ᵁ C') le_rfl).hom ψF = 0 := by
    refine TopCat.Presheaf.section_ext Wo.toScheme.sheaf ((Wo.ι ≫ e) ⁻¹ᵁ C') _ 0
      (fun x hx => ?_)
    have hx1 := (hle4 _ γ V' _ _ (hle1 _ V' (Wo.ι ≫ e) _ le_rfl) hV) hx
    rw [hM, Scheme.Hom.mem_preimage, Scheme.Hom.comp_apply] at hx1
    obtain ⟨OU, hOaff, hyO, hOle⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (U.toScheme).isBasis_affineOpens ((Scheme.Hom.mem_preimage μ).mpr hx1)
    have hx2 := (hle2 _ V' (Wo.ι ≫ e) _ le_rfl) hx
    rw [hFm, Scheme.Hom.mem_preimage, Scheme.Hom.comp_apply] at hx2
    have hyO' : Limits.pullback.snd (wcProjKStr k N) (U.ι ≫ sP) ((XI ≫ eZ) x) ∈ OU := by
      rw [← Scheme.Hom.comp_apply]; exact hyO
    set ChU := wcpaDjFlrgChart k N (U.ι ≫ sP) OU i with hChU
    set Q := (Wo.ι ≫ e) ⁻¹ᵁ C' ⊓ (XI ≫ eZ) ⁻¹ᵁ ChU with hQ
    have hxQ : x ∈ Q := TopologicalSpace.Opens.mem_inf.mpr ⟨hx, (Scheme.Hom.mem_preimage _).mpr
      (TopologicalSpace.Opens.mem_inf.mpr ⟨(Scheme.Hom.mem_preimage _).mpr hx2,
        (Scheme.Hom.mem_preimage _).mpr hyO'⟩)⟩
    have hQC' : Q ≤ (Wo.ι ≫ e) ⁻¹ᵁ C' := inf_le_left
    have hQU : Q ≤ (XI ≫ eZ) ⁻¹ᵁ ChU := inf_le_right
    have hS := hle4 _ γ V' _ Q (hle1 _ V' (Wo.ι ≫ e) Q hQC') hV
    have hF := hle2 _ V' (Wo.ι ≫ e) Q hQC'
    have hSU := hle4 _ μ OU _ Q (hle1 _ OU (XI ≫ eZ) Q hQU) hOle
    have hFU := hle2 _ OU (XI ≫ eZ) Q hQU
    have hval : ((Wo.ι ≫ e).appLE C' Q hQC').hom ψF = 0 := by
      rw [hψF, hEF (β ≫ sP) V' γ hV (Wo.ι ≫ e) Q hQC' hS hF (G c a),
        hEv _ _ _ _ Q hS hSU hF hFU (G c a) hM hFm,
        ← hEF (U.ι ≫ sP) OU μ hOle (XI ≫ eZ) Q hQU hSU hFU (G c a)]
      have hQXI : Q ≤ XI ⁻¹ᵁ (eZ ⁻¹ᵁ ChU) := by
        intro z hz
        have h := hQU hz
        rw [Scheme.Hom.mem_preimage, Scheme.Hom.comp_apply] at h
        rw [Scheme.Hom.mem_preimage, Scheme.Hom.mem_preimage]
        exact h
      have hcomp2 := congrArg (fun φ => φ.hom (wcpaDjFlrgPsi k N (U.ι ≫ sP) OU i
          (MvPolynomial.map (μ.appLE (wcSgD k L c) OU hOle).hom (G c a))))
        (Scheme.Hom.appLE_comp_appLE XI eZ ChU (eZ ⁻¹ᵁ ChU) Q le_rfl hQXI)
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at hcomp2
      refine hcomp2.symm.trans ?_
      have hk : (eZ.app ChU).hom (wcpaDjFlrgPsi k N (U.ι ≫ sP) OU i
          (MvPolynomial.map (μ.appLE (wcSgD k L c) OU hOle).hom (G c a))) = 0 := by
        rw [← RingHom.mem_ker, heZ_def, hH.2.2.1 c OU hOle i hOaff]
        exact Ideal.subset_span ⟨a, rfl⟩
      rw [Scheme.Hom.app_eq_appLE] at hk
      rw [hk, map_zero]
    have hres : ((Wo.toScheme.presheaf.map (homOfLE hQC').op).hom
        (((Wo.ι ≫ e).appLE C' ((Wo.ι ≫ e) ⁻¹ᵁ C') le_rfl).hom ψF)) = 0 := by
      have h2 := congrArg (fun φ => φ.hom ψF)
        (Scheme.Hom.appLE_map (Wo.ι ≫ e) (le_rfl : (Wo.ι ≫ e) ⁻¹ᵁ C' ≤ _) (homOfLE hQC').op)
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h2
      exact h2.trans hval
    have hg : (Wo.toScheme.presheaf.germ ((Wo.ι ≫ e) ⁻¹ᵁ C') x hx).hom
        (((Wo.ι ≫ e).appLE C' ((Wo.ι ≫ e) ⁻¹ᵁ C') le_rfl).hom ψF) = 0 := by
      rw [← Wo.toScheme.presheaf.germ_res_apply (homOfLE hQC') x hxQ, hres, map_zero]
    exact hg.trans (map_zero _).symm

  refine TopCat.Presheaf.section_ext Wo.ι.image.sheaf ((Wo.ι.imageι ≫ e) ⁻¹ᵁ C') _ 0
    (fun x hx => ?_)
  have hx' : Wo.ι.imageι x ∈ e ⁻¹ᵁ C' := by
    rw [Scheme.Hom.mem_preimage, Scheme.Hom.comp_apply] at hx
    exact (Scheme.Hom.mem_preimage _).mpr hx
  obtain ⟨Aff, hAff, hxAff, hAffle⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    (Limits.pullback f β).isBasis_affineOpens hx'
  have hxA : x ∈ Wo.ι.imageι ⁻¹ᵁ Aff := (Scheme.Hom.mem_preimage _).mpr hxAff
  have hAO : Wo.ι.imageι ⁻¹ᵁ Aff ≤ (Wo.ι.imageι ≫ e) ⁻¹ᵁ C' :=
    hle4 Wo.ι.imageι e Aff C' _ le_rfl hAffle
  have hinj := Scheme.Hom.toImage_app_injective Wo.ι ⟨Aff, hAff⟩
  have hR : ((Wo.ι.imageι ≫ e).appLE C' (Wo.ι.imageι ⁻¹ᵁ Aff) hAO).hom ψF = 0 := by
    apply hinj
    rw [map_zero, Scheme.Hom.app_eq_appLE]
    have h1 := congrArg (fun φ => φ.hom ψF) (Scheme.Hom.appLE_comp_appLE Wo.ι.toImage
      (Wo.ι.imageι ≫ e) C' (Wo.ι.imageι ⁻¹ᵁ Aff) (Wo.ι.toImage ⁻¹ᵁ (Wo.ι.imageι ⁻¹ᵁ Aff))
      hAO le_rfl)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h1
    refine h1.trans ?_
    have hτ : Wo.ι.toImage ≫ Wo.ι.imageι ≫ e = Wo.ι ≫ e := by
      rw [← Category.assoc, Scheme.Hom.toImage_imageι]
    have hle' : Wo.ι.toImage ⁻¹ᵁ (Wo.ι.imageι ⁻¹ᵁ Aff) ≤ (Wo.ι ≫ e) ⁻¹ᵁ C' := by
      rw [← hτ]
      exact hle4 Wo.ι.toImage (Wo.ι.imageι ≫ e) _ C' _ le_rfl hAO
    rw [happLE _ _ hτ C' _ _ hle' ψF]
    have h2 := congrArg (fun φ => φ.hom ψF)
      (Scheme.Hom.appLE_map (Wo.ι ≫ e) (le_rfl : (Wo.ι ≫ e) ⁻¹ᵁ C' ≤ _) (homOfLE hle').op)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h2
    rw [← h2, hW, map_zero]
  have hres : ((Wo.ι.image.presheaf.map (homOfLE hAO).op).hom
      (((Wo.ι.imageι ≫ e).appLE C' ((Wo.ι.imageι ≫ e) ⁻¹ᵁ C') le_rfl).hom ψF)) = 0 := by
    have h2 := congrArg (fun φ => φ.hom ψF)
