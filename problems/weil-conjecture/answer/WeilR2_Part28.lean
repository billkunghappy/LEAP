  have hz : LocallyOfFiniteType (Y.fromSpecResidueField z₀) :=
    (isClosed_singleton_iff_locallyOfFiniteType).mp hcl
  let z : Spec (.of (Y.residueField z₀)) ⟶ Y := Y.fromSpecResidueField z₀
  let φ : CommRingCat.of k ⟶ CommRingCat.of (Y.residueField z₀) := Spec.preimage (z ≫ s)
