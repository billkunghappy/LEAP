    have hi : i₀ ≠ i₁ := by simp [i₀, i₁, Fin.ext_iff]
    obtain ⟨m₀, hm₀⟩ := Ideal.toCotangent_surjective (IsLocalRing.maximalIdeal A) (b i₀)
    obtain ⟨m₁, hm₁⟩ := Ideal.toCotangent_surjective (IsLocalRing.maximalIdeal A) (b i₁)
    have hd : ∀ a, a - ι (r a) ∈ IsLocalRing.maximalIdeal A := fun a =>
      (hker _).mp (by rw [map_sub, hri', sub_self])
    let dd : A → IsLocalRing.maximalIdeal A := fun a => ⟨a - ι (r a), hd a⟩
    let T := (IsLocalRing.maximalIdeal A).toCotangent
    let D : _ → A → K := fun i a => ρ (b.coord i (T (dd a)))
    have hcoord : ∀ i (c : A) (v : IsLocalRing.CotangentSpace A),
        b.coord i (c • v) = IsLocalRing.residue A c * b.coord i v := by
      intro i c v
      rw [← IsScalarTower.algebraMap_smul (IsLocalRing.ResidueField A) c v, LinearMap.map_smul,
        smul_eq_mul, IsLocalRing.ResidueField.algebraMap_eq]
    have hadd : ∀ i a a', D i (a + a') = D i a + D i a' := by
      intro i a a'
      have : dd (a + a') = dd a + dd a' := by
        apply Subtype.ext
        simp only [dd, Submodule.coe_add, map_add]
        ring
      simp only [D, this, map_add]
    have hmul : ∀ i a a', D i (a * a') = r a * D i a' + r a' * D i a := by
      intro i a a'
      have hsq : (a - ι (r a)) * (a' - ι (r a')) ∈ IsLocalRing.maximalIdeal A := by
        exact Ideal.mul_mem_left _ _ (hd a')
      have e : dd (a * a') = ⟨_, hsq⟩ + ι (r a) • dd a' + ι (r a') • dd a := by
        apply Subtype.ext
        simp only [dd, Submodule.coe_add, Submodule.coe_smul, smul_eq_mul, map_mul]
        ring
      have h0 : T ⟨_, hsq⟩ = 0 := by
        rw [Ideal.toCotangent_eq_zero, pow_two]
        exact Ideal.mul_mem_mul (hd a) (hd a')
      simp only [D, e, map_add, map_smul, h0, zero_add]
      rw [hcoord, hcoord, map_mul, map_mul, hρ, hρ, hri', hri']
    have hι : ∀ i c, D i (ι c) = 0 := by
      intro i c
      have : dd (ι c) = 0 := by
        apply Subtype.ext
        simp [dd, hri']
      simp only [D, this, map_zero]
    have hr₀ : r m₀ = 0 := (hker _).mpr m₀.2
    have hr₁ : r m₁ = 0 := (hker _).mpr m₁.2
    have hdm₀ : dd m₀ = m₀ := Subtype.ext (by simp [dd, hr₀])
    have hdm₁ : dd m₁ = m₁ := Subtype.ext (by simp [dd, hr₁])
    have hval : ∀ i j, ρ (b.coord i (b j)) = if j = i then 1 else 0 := by
      intro i j
      rw [Module.Basis.coord_apply, Module.Basis.repr_self, Finsupp.single_apply]
      split_ifs <;> simp
    have hT₀ : T (dd m₀) = b i₀ := by rw [hdm₀]; exact hm₀
    have hT₁ : T (dd m₁) = b i₁ := by rw [hdm₁]; exact hm₁
    refine ⟨m₀, m₁, D i₀, D i₁, hr₀, hr₁, hadd i₀, hadd i₁, hmul i₀, hmul i₁, hι i₀, hι i₁,
      ?_, ?_, ?_, ?_⟩
    · show ρ (b.coord i₀ (T (dd m₀))) = 1
      rw [hT₀, hval, if_pos rfl]
    · show ρ (b.coord i₀ (T (dd m₁))) = 0
      rw [hT₁, hval, if_neg hi.symm]
    · show ρ (b.coord i₁ (T (dd m₀))) = 0
      rw [hT₀, hval, if_neg hi]
    · show ρ (b.coord i₁ (T (dd m₁))) = 1
      rw [hT₁, hval, if_pos rfl]



  have s8 : ∀ (K A : Type u) [Field K] [CommRing A] [IsDomain A] [IsNoetherianRing A] [IsLocalRing A] (ι : K →+* A) (r : A →+* K), r.comp ι = RingHom.id K → Submodule.IsPrincipal (IsLocalRing.maximalIdeal A) → ∃ Ψ : A →+* PowerSeries K, Function.Injective Ψ ∧ Ψ.comp ι = PowerSeries.C := by
    intro K A _ _ _ _ _ ι r hri hprin
    classical
    have hri' : ∀ c, r (ι c) = c := fun c => RingHom.congr_fun hri c
    have hker : ∀ a, r a = 0 ↔ a ∈ IsLocalRing.maximalIdeal A := by
      have hsurj : Function.Surjective r := fun c => ⟨ι c, hri' c⟩
      have := IsLocalRing.eq_maximalIdeal (RingHom.ker_isMaximal_of_surjective r hsurj)
      intro a; rw [← this, RingHom.mem_ker]
    set t := Submodule.IsPrincipal.generator (IsLocalRing.maximalIdeal A) with ht_def
    have hspan : Ideal.span {t} = IsLocalRing.maximalIdeal A :=
      Ideal.span_singleton_generator _
    have hd : ∀ a, ∃ d, d * t = a - ι (r a) := by
      intro a
      have : a - ι (r a) ∈ IsLocalRing.maximalIdeal A :=
        (hker _).mp (by rw [map_sub, hri', sub_self])
      rw [← hspan] at this
      exact Ideal.mem_span_singleton'.mp this
    have hrt : r t = 0 := (hker t).mpr (hspan ▸ Ideal.mem_span_singleton_self t)
    by_cases ht : t = 0
    · have hrinj : Function.Injective r := by
        rw [injective_iff_map_eq_zero]
        intro a ha
        obtain ⟨d, hdd⟩ := hd a
        rw [ht, mul_zero, ha, map_zero, sub_zero] at hdd
        exact hdd.symm
      refine ⟨PowerSeries.C.comp r, ?_, ?_⟩
      · exact (PowerSeries.C_injective).comp hrinj
      · ext c : 1
        simp [hri']
    · choose δ hδ using hd
      let ev : Polynomial K →+* A := Polynomial.eval₂RingHom ι t
      let Rep : PowerSeries K → A → Prop := fun f a =>
        ∀ N : ℕ, t ^ N ∣ a - ev (PowerSeries.trunc N f)
      have hU : ∀ (N : ℕ) (Q : Polynomial K), (∀ i, N ≤ i → Q.coeff i = 0) →
          t ^ N ∣ ev Q → Q = 0 := by
        intro N
        induction N with
        | zero =>
          intro Q hQ _
          ext i
          simp [hQ i (Nat.zero_le i)]
        | succ N ih =>
          intro Q hQ hdiv
          have h0 : Q.coeff 0 = 0 := by
            have e1 : r (ev Q) = Q.coeff 0 := by
              show r (Polynomial.eval₂ ι t Q) = _
              rw [Polynomial.hom_eval₂, hri, hrt, Polynomial.coeff_zero_eq_eval_zero]
              rfl
            rw [← e1]
            obtain ⟨w, hw⟩ := hdiv
            rw [hw, pow_succ, map_mul, map_mul, hrt, mul_zero, zero_mul]
          have hQ' : Q = Q.divX * Polynomial.X := by
            have := Polynomial.divX_mul_X_add Q
            rw [h0, map_zero, add_zero] at this
            exact this.symm
          have hdivX : Q.divX = 0 := by
            apply ih
            · intro i hi
              rw [Polynomial.coeff_divX]
              exact hQ (i + 1) (by omega)
            · have e2 : ev Q = ev Q.divX * t := by
                conv_lhs => rw [hQ']
                rw [map_mul]
                simp [ev]
              rw [e2, pow_succ] at hdiv
              exact (mul_dvd_mul_iff_right ht).mp hdiv
          rw [hQ', hdivX, zero_mul]
      have huniq : ∀ f g a, Rep f a → Rep g a → f = g := by
        intro f g a hf hg
        ext n
        have hQ := hU (n + 1) (PowerSeries.trunc (n + 1) f - PowerSeries.trunc (n + 1) g)
          (fun i hi => by
            rw [Polynomial.coeff_sub, PowerSeries.coeff_trunc, PowerSeries.coeff_trunc,
              if_neg (by omega), if_neg (by omega), sub_zero])
          (by
            have := dvd_sub (hg (n + 1)) (hf (n + 1))
            rw [map_sub]
            convert this using 1
            ring)
        have := congrArg (fun p => Polynomial.coeff p n) hQ
        simp only [Polynomial.coeff_sub, PowerSeries.coeff_trunc, if_pos (Nat.lt_succ_self n),
          Polynomial.coeff_zero] at this
        exact sub_eq_zero.mp this
      let c : ℕ → A → K := fun n a => r (δ^[n] a)
      let Ψ₀ : A → PowerSeries K := fun a => PowerSeries.mk (fun n => c n a)
      have hE : ∀ a N, a - ev (PowerSeries.trunc N (Ψ₀ a)) = t ^ N * δ^[N] a := by
        intro a N
        induction N with
        | zero =>
          have : PowerSeries.trunc 0 (Ψ₀ a) = 0 := by
            ext i; simp
          rw [this, map_zero, sub_zero, pow_zero, one_mul]
          rfl
        | succ N ih =>
          rw [PowerSeries.trunc_succ, map_add, Function.iterate_succ_apply']
          have e3 : ev (Polynomial.monomial N (PowerSeries.coeff N (Ψ₀ a))) =
              ι (c N a) * t ^ N := by
            simp [ev, Ψ₀, Polynomial.eval₂_monomial]
          rw [e3]
          have e4 : δ (δ^[N] a) * t = δ^[N] a - ι (c N a) := hδ (δ^[N] a)
          linear_combination ih - t ^ N * e4
      have hRepΨ : ∀ a, Rep (Ψ₀ a) a := fun a N => ⟨δ^[N] a, hE a N⟩
      have hRepAdd : ∀ f g a b, Rep f a → Rep g b → Rep (f + g) (a + b) := by
        intro f g a b hf hg N
        rw [map_add, map_add]
        have := dvd_add (hf N) (hg N)
        convert this using 1
        ring
      have hRepMul : ∀ f g a b, Rep f a → Rep g b → Rep (f * g) (a * b) := by
        intro f g a b hf hg N
        obtain ⟨x, hx⟩ := hf N
        obtain ⟨y, hy⟩ := hg N
        set p := PowerSeries.trunc N f
        set q := PowerSeries.trunc N g
        have hX : Polynomial.X ^ N ∣ p * q - PowerSeries.trunc N (f * g) := by
          rw [Polynomial.X_pow_dvd_iff]
          intro d hdN
          rw [← PowerSeries.trunc_trunc_mul_trunc, Polynomial.coeff_sub, PowerSeries.coeff_trunc,
            if_pos hdN, ← Polynomial.coe_mul, Polynomial.coeff_coe, sub_self]
        obtain ⟨w, hw⟩ := hX
        have hw' : ev p * ev q - ev (PowerSeries.trunc N (f * g)) = t ^ N * ev w := by
          have := congrArg ev hw
          simp only [map_sub, map_mul, map_pow] at this
          rw [this]
          simp [ev]
        refine ⟨x * ev q + y * ev p + t ^ N * x * y + ev w, ?_⟩
        linear_combination b * hx + (ev p + t ^ N * x) * hy + hw'
      have hRepC : ∀ k, Rep (PowerSeries.C k) (ι k) := by
        intro k N
        cases N with
        | zero => simp
        | succ N =>
          rw [PowerSeries.trunc_C]
          simp [ev]
      have hRepZero : Rep 0 0 := fun N => by simp
      let Ψ : A →+* PowerSeries K :=
        { toFun := Ψ₀
          map_one' := huniq _ _ _ (hRepΨ 1) (by rw [← map_one PowerSeries.C, ← map_one ι]; exact hRepC 1)
          map_mul' := fun a b => huniq _ _ _ (hRepΨ (a * b)) (hRepMul _ _ _ _ (hRepΨ a) (hRepΨ b))
          map_zero' := huniq _ _ _ (hRepΨ 0) hRepZero
          map_add' := fun a b => huniq _ _ _ (hRepΨ (a + b)) (hRepAdd _ _ _ _ (hRepΨ a) (hRepΨ b)) }
      refine ⟨Ψ, ?_, ?_⟩
      · rw [injective_iff_map_eq_zero]
        intro a ha
        have h0 : Ψ₀ a = 0 := ha
        have hrep : Rep 0 a := h0 ▸ hRepΨ a
        have hmem : ∀ N, a ∈ (IsLocalRing.maximalIdeal A) ^ N := by
          intro N
          rw [← hspan, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
          have := hrep N
          simpa using this
        have hbot := Ideal.iInf_pow_eq_bot_of_isDomain (IsLocalRing.maximalIdeal A)
          (Ideal.IsMaximal.ne_top inferInstance)
        have : a ∈ ⨅ i, (IsLocalRing.maximalIdeal A) ^ i := Submodule.mem_iInf _ |>.mpr hmem
        rw [hbot] at this
        exact this
      · ext k : 1
        exact huniq _ _ _ (hRepΨ (ι k)) (hRepC k)



  have s9 : ∀ (K B : Type u) [Field K] [CommRing B] [Algebra K B] (Ψ : B →ₐ[K] PowerSeries K), Function.Injective Ψ → ∀ (Ω : Type u) [Field Ω] [Algebra K Ω], id (IsDomain (TensorProduct K B Ω)) := by
    intro K B _ _ _ Ψ hΨ Ω _ _
    classical
    show IsDomain (TensorProduct K B Ω)
    let Θ : TensorProduct K B Ω →ₐ[K] PowerSeries Ω :=
      Algebra.TensorProduct.lift ((PowerSeries.mapAlgHom (Algebra.ofId K Ω)).comp Ψ)
        (IsScalarTower.toAlgHom K Ω (PowerSeries Ω)) (fun _ _ => Commute.all _ _)
    have hΘt : ∀ (x : B) (ω : Ω) (n : ℕ), PowerSeries.coeff n (Θ (x ⊗ₜ ω)) =
        (PowerSeries.coeff n (Ψ x)) • ω := by
      intro x ω n
      simp only [Θ, Algebra.TensorProduct.lift_tmul, AlgHom.comp_apply, IsScalarTower.coe_toAlgHom',
        PowerSeries.algebraMap_eq, PowerSeries.coeff_mul_C]
      rw [Algebra.smul_def]
      congr 1
    have hΘ : Function.Injective Θ := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      let b := Module.Basis.ofVectorSpace K Ω
      let E := TensorProduct.equivFinsuppOfBasisRight (M := B) b
      obtain ⟨l, rfl⟩ := E.symm.surjective z
      have hsymm : E.symm l = l.sum (fun j x => x ⊗ₜ[K] b j) := by
        have := LinearMap.congr_fun (TensorProduct.equivFinsuppOfBasisRight_symm (M := B) b) l
        refine Eq.trans this ?_
        rw [Finsupp.lsum_apply]
        rfl
      have hl : ∀ j, l j = 0 := by
        intro j
        apply hΨ
        rw [map_zero]
        ext n
        rw [map_zero]
        have hcoef := congrArg (PowerSeries.coeff n) hz
        rw [hsymm, map_finsuppSum, map_finsuppSum, map_zero] at hcoef
        simp only [hΘt] at hcoef
        have hli := linearIndependent_iff.mp b.linearIndependent
          (l.mapRange (fun x => PowerSeries.coeff n (Ψ x)) (by simp))
          (by
            rw [Finsupp.linearCombination_apply, Finsupp.sum_mapRange_index]
            · exact hcoef
            · intro i; exact zero_smul _ _)
        have := congrArg (fun g => g j) hli
        simpa using this
      have : l = 0 := Finsupp.ext hl
      rw [this, map_zero]
    exact hΘ.isDomain Θ.toRingHom



  have s10 : ∀ (K A L : Type u) [Field K] [CommRing A] [IsDomain A] [CommRing L] [Algebra K A] [Algebra A L] [Algebra K L] [IsScalarTower K A L] [IsFractionRing A L] (Ω : Type u) [Field Ω] [Algebra K Ω], IsDomain (TensorProduct K A Ω) → id (IsDomain (TensorProduct K L Ω)) := by
    intro K A L _ _ _ _ _ _ _ _ _ Ω _ _ hA
    classical
    show IsDomain (TensorProduct K L Ω)
    let f := IsScalarTower.toAlgHom K A L
    let j : TensorProduct K A Ω →ₐ[K] TensorProduct K L Ω :=
      Algebra.TensorProduct.map f (AlgHom.id K Ω)
    have hj : Function.Injective j := by
      have h1 : Function.Injective (LinearMap.rTensor Ω f.toLinearMap) :=
        Module.Flat.rTensor_preserves_injective_linearMap _ (IsFractionRing.injective A L)
      have h2 : ∀ z, j z = LinearMap.rTensor Ω f.toLinearMap z := by
        intro z
        induction z using TensorProduct.induction_on with
        | zero => simp
        | tmul a ω => simp [j]
        | add x y hx hy => rw [map_add, map_add, hx, hy]
      intro x y hxy
      apply h1
      rw [← h2, ← h2, hxy]
    have hjs : ∀ s : A, j (s ⊗ₜ (1 : Ω)) = algebraMap A L s ⊗ₜ (1 : Ω) := fun s => by
      simp [j, f]
    have hden : ∀ z : TensorProduct K L Ω, ∃ s : A, s ≠ 0 ∧ ∃ w,
        (algebraMap A L s ⊗ₜ[K] (1 : Ω)) * z = j w := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => exact ⟨1, one_ne_zero, 0, by simp⟩
      | tmul l ω =>
        obtain ⟨⟨a, s⟩, hs⟩ := IsLocalization.surj (nonZeroDivisors A) l
        refine ⟨s, nonZeroDivisors.ne_zero s.2, a ⊗ₜ ω, ?_⟩
        simp only [j, Algebra.TensorProduct.map_tmul, Algebra.TensorProduct.tmul_mul_tmul, one_mul,
          AlgHom.id_apply]
        rw [mul_comm, hs]
        simp [f]
      | add z₁ z₂ h₁ h₂ =>
        obtain ⟨s₁, hs₁, w₁, e₁⟩ := h₁
        obtain ⟨s₂, hs₂, w₂, e₂⟩ := h₂
        refine ⟨s₁ * s₂, mul_ne_zero hs₁ hs₂, (s₂ ⊗ₜ 1) * w₁ + (s₁ ⊗ₜ 1) * w₂, ?_⟩
        have hm : algebraMap A L (s₁ * s₂) ⊗ₜ[K] (1 : Ω) =
            (algebraMap A L s₁ ⊗ₜ[K] (1 : Ω)) * (algebraMap A L s₂ ⊗ₜ[K] (1 : Ω)) := by
          rw [map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one]
        rw [hm, map_add, map_mul j, map_mul j, hjs, hjs, ← e₁, ← e₂]
        ring
    have hunit : ∀ s : A, s ≠ 0 → IsUnit (algebraMap A L s ⊗ₜ[K] (1 : Ω)) := by
      intro s hs
      have := IsLocalization.map_units L (⟨s, mem_nonZeroDivisors_of_ne_zero hs⟩ : nonZeroDivisors A)
      exact this.map (Algebra.TensorProduct.includeLeftRingHom (R := K) (A := L) (B := Ω))
    haveI : Nontrivial (TensorProduct K L Ω) := hj.nontrivial
    haveI : NoZeroDivisors (TensorProduct K L Ω) := ⟨fun {z₁ z₂} h => by
      obtain ⟨s₁, hs₁, w₁, e₁⟩ := hden z₁
      obtain ⟨s₂, hs₂, w₂, e₂⟩ := hden z₂
      have hw : j (w₁ * w₂) = 0 := by rw [map_mul, ← e₁, ← e₂, mul_mul_mul_comm, h, mul_zero]
      have hw' : w₁ * w₂ = 0 := hj (by rw [hw, map_zero])
      rcases mul_eq_zero.mp hw' with h0 | h0
      · left
        rw [h0, map_zero] at e₁
        exact (hunit s₁ hs₁).mul_right_eq_zero.mp e₁
      · right
        rw [h0, map_zero] at e₂
        exact (hunit s₂ hs₂).mul_right_eq_zero.mp e₂⟩
    exact NoZeroDivisors.to_isDomain _



  intro Y P _ _ _ g _ _ σ hσ hsm
  have : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian g

  have hgx : g (σ (genericPoint P)) = genericPoint P := by
    rw [← Scheme.Hom.comp_apply, hσ]; rfl
  have hx : g (σ (genericPoint P)) ⤳ genericPoint P := Specializes.of_eq hgx
  have hx' : genericPoint P ⤳ g (σ (genericPoint P)) := Specializes.of_eq hgx.symm
  have hyx : genericPoint Y ⤳ σ (genericPoint P) :=
    (genericPoint_spec Y).specializes (Set.mem_univ _)
  have hdom : g (genericPoint Y) ⤳ genericPoint P := (hyx.map g.continuous).trans hx

  have s2 : (P.presheaf.stalkSpecializes hx ≫ g.stalkMap (σ (genericPoint P))) ≫
      σ.stalkMap (genericPoint P) = 𝟙 (P.presheaf.stalk (genericPoint P)) := by
    have key : ∀ (f : P ⟶ P) (_ : f = 𝟙 P) (h : f (genericPoint P) ⤳ genericPoint P),
        P.presheaf.stalkSpecializes h ≫ f.stalkMap (genericPoint P) = 𝟙 _ := by
      intro f hf h
      subst hf
      erw [Scheme.Hom.stalkMap_id, Category.comp_id]
      exact TopCat.Presheaf.stalkSpecializes_refl _ _
    rw [Category.assoc, ← Scheme.Hom.stalkMap_comp]
    exact key _ hσ hx

  have s3 : ∀ (hyx' : genericPoint Y ⤳ σ (genericPoint P)),
      (P.presheaf.stalkSpecializes hx ≫ g.stalkMap (σ (genericPoint P))) ≫
        Y.presheaf.stalkSpecializes hyx' =
      P.presheaf.stalkSpecializes hdom ≫ g.stalkMap (genericPoint Y) := by
    intro hyx'
    rw [Category.assoc, ← Scheme.Hom.stalkSpecializes_stalkMap, ← Category.assoc,
      TopCat.Presheaf.stalkSpecializes_comp]

  let ι : P.presheaf.stalk (genericPoint P) →+* Y.presheaf.stalk (σ (genericPoint P)) :=
    (P.presheaf.stalkSpecializes hx ≫ g.stalkMap (σ (genericPoint P))).hom
  let r : Y.presheaf.stalk (σ (genericPoint P)) →+* P.presheaf.stalk (genericPoint P) :=
    (σ.stalkMap (genericPoint P)).hom
  have hri : r.comp ι = RingHom.id _ := by
    have := congrArg CommRingCat.Hom.hom s2
    rw [CommRingCat.hom_comp, CommRingCat.hom_id] at this
    exact this

  have hprin : Submodule.IsPrincipal
      (IsLocalRing.maximalIdeal (Y.presheaf.stalk (σ (genericPoint P)))) := by
    by_contra hnp
    have h2 : 2 ≤ Module.finrank
        (IsLocalRing.ResidueField (Y.presheaf.stalk (σ (genericPoint P))))
        (IsLocalRing.CotangentSpace (Y.presheaf.stalk (σ (genericPoint P)))) := by
      have := mt IsLocalRing.finrank_cotangentSpace_le_one_iff.mp hnp
      omega
    obtain ⟨a₁, a₂, D₁, D₂, hr₁, hr₂, hD₁a, hD₂a, hD₁m, hD₂m, hD₁ι, hD₂ι, h11, h12, h21, h22⟩ :=
      s6 _ _ ι r hri h2
    obtain ⟨V, hxV, hVsm⟩ := hsm (genericPoint P)
    obtain ⟨R, S, f, β, α, hss, hcomm, hfrac⟩ :=
      s1 Y P g (σ (genericPoint P)) V hxV hVsm
    have hcomm' : ∀ c : R, β.hom (f.hom c) =
        ι ((α ≫ P.presheaf.stalkSpecializes hx').hom c) := by
      intro c
      have e : (α ≫ P.presheaf.stalkSpecializes hx') ≫
          (P.presheaf.stalkSpecializes hx ≫ g.stalkMap (σ (genericPoint P))) = f ≫ β := by
        rw [Category.assoc, ← Category.assoc (P.presheaf.stalkSpecializes hx'),
          TopCat.Presheaf.stalkSpecializes_comp, TopCat.Presheaf.stalkSpecializes_refl,
          Category.id_comp, hcomm]
      have := congrArg (fun φ => φ.hom c) e
      exact this.symm
    letI := f.hom.toAlgebra
    have hcyc := s4 R S f.hom hss
    have hminor := s5 R S (P.presheaf.stalk (genericPoint P))
      (r.comp β.hom) hcyc (fun s => D₁ (β.hom s)) (fun s => D₂ (β.hom s))
      (fun a b => by simp only [map_add, hD₁a])
      (fun a b => by simp only [map_add, hD₂a])
      (fun a b => by simp only [map_mul, hD₁m, RingHom.comp_apply])
      (fun a b => by simp only [map_mul, hD₂m, RingHom.comp_apply])
      (fun c => by
        show D₁ (β.hom (f.hom c)) = 0
        rw [hcomm']; exact hD₁ι _)
      (fun c => by
        show D₂ (β.hom (f.hom c)) = 0
        rw [hcomm']; exact hD₂ι _)

    obtain ⟨s₁, u₁, hu₁, e₁⟩ := hfrac a₁
    obtain ⟨s₂, u₂, hu₂, e₂⟩ := hfrac a₂
    have k11 : D₁ (β.hom s₁) = r (β.hom u₁) := by
      rw [← e₁, hD₁m, hr₁, h11]; ring
    have k22 : D₂ (β.hom s₂) = r (β.hom u₂) := by
      rw [← e₂, hD₂m, hr₂, h22]; ring
    have k12 : D₁ (β.hom s₂) = 0 := by
      rw [← e₂, hD₁m, hr₂, h12]; ring
    have k21 : D₂ (β.hom s₁) = 0 := by
      rw [← e₁, hD₂m, hr₁, h21]; ring
    have hm := hminor s₁ s₂
    simp only at hm
    rw [k11, k22, k12, k21, mul_zero] at hm
    exact mul_ne_zero (hu₁.map r).ne_zero (hu₂.map r).ne_zero hm

  obtain ⟨Ψ, hΨinj, hΨι⟩ := s8 _ _ ι r hri hprin

  letI : Algebra (P.presheaf.stalk (genericPoint P)) (Y.presheaf.stalk (σ (genericPoint P))) :=
    ι.toAlgebra
  let Ψa : Y.presheaf.stalk (σ (genericPoint P)) →ₐ[P.presheaf.stalk (genericPoint P)]
      PowerSeries (P.presheaf.stalk (genericPoint P)) :=
    { toRingHom := Ψ
      commutes' := fun c => by
        show Ψ (ι c) = _
        rw [PowerSeries.algebraMap_eq]
        exact RingHom.congr_fun hΨι c }
  have hTD := s9 _ _ Ψa hΨinj

  letI : Algebra (P.presheaf.stalk (genericPoint P)) (Y.presheaf.stalk (genericPoint Y)) :=
    (P.presheaf.stalkSpecializes hdom ≫ g.stalkMap (genericPoint Y)).hom.toAlgebra
  haveI : IsScalarTower (P.presheaf.stalk (genericPoint P))
      (Y.presheaf.stalk (σ (genericPoint P))) (Y.presheaf.stalk (genericPoint Y)) :=
    IsScalarTower.of_algebraMap_eq (fun c => by
      have := congrArg (fun φ => φ.hom c) (s3 hyx)
      exact this.symm)
  have hFR : ∀ (Ω : Type u) [Field Ω] [Algebra (P.presheaf.stalk (genericPoint P)) Ω],
      IsDomain (TensorProduct (P.presheaf.stalk (genericPoint P))
        (Y.presheaf.stalk (genericPoint Y)) Ω) := fun Ω _ _ =>
    s10 _ (Y.presheaf.stalk (σ (genericPoint P))) _ Ω (hTD Ω)

  exact s11 Y P g hdom hFR

theorem wcpa_dj_gs_norm_iso_normal_locus : ∀ (Xt R : Scheme.{u}) [AlgebraicGeometry.IsIntegral Xt] [AlgebraicGeometry.IsIntegral R] (b : Xt ⟶ R), IsFinite b → (∃ U : R.Opens, U ≠ ⊥ ∧ IsIso (b ∣_ U)) → ∀ V : R.Opens, (∀ y : R, y ∈ V → IsIntegrallyClosed (R.presheaf.stalk y)) → IsIso (b ∣_ V) :=
by
  intro Xt R _ _ b hb ⟨U, hU0, hUiso⟩ V hV

  have hF0 : ∀ W : R.Opens, W ≠ ⊥ → genericPoint R ∈ W := by
    intro W hW
    exact ((genericPoint_spec R).mem_open_set_iff W.isOpen).mpr
      (by simpa using (TopologicalSpace.Opens.ne_bot_iff_nonempty W).mp hW)

  obtain ⟨x, hbx, hst⟩ : ∃ x : Xt, b x = genericPoint R ∧ IsIso (b.stalkMap x) := by
    let y : U.toScheme := ⟨genericPoint R, hF0 U hU0⟩
    let x' : (b ⁻¹ᵁ U).toScheme := (inv (b ∣_ U)) y
    have hx' : (b ∣_ U) x' = y := by
      show (b ∣_ U) ((inv (b ∣_ U)) y) = y
      rw [← Scheme.Hom.comp_apply, IsIso.inv_hom_id]
      rfl
    refine ⟨x'.1, ?_, ?_⟩
    · rw [← morphismRestrict_base_coe, hx']
    · have h1 : IsIso ((b ∣_ U).stalkMap x') := ((isIso_iff_isIso_stalkMap _).mp hUiso).2 x'
      exact ((MorphismProperty.isomorphisms CommRingCat).arrow_mk_iso_iff
        (morphismRestrictStalkMap b U x')).mp h1

  have key : ∀ W : R.Opens, IsAffineOpen W → W ≠ ⊥ → W ≤ V → IsIso (b ∣_ W) := by
    intro W hW hW0 hWV
    have : Nonempty W :=
      (Scheme.Opens.nonempty_iff W).mpr ((TopologicalSpace.Opens.ne_bot_iff_nonempty W).mp hW0)
    have : IsAffine W := hW
    have : IsAffine (b ⁻¹ᵁ W) := IsAffineHom.isAffine_preimage W hW
    have hbx' : b x ∈ W := hbx ▸ hF0 W hW0
    have hxW : x ∈ b ⁻¹ᵁ W := hbx'
    have : IsFractionRing Γ(R, W) R.functionField :=
      functionField_isFractionRing_of_isAffineOpen R W hW

    have hic : IsIntegrallyClosed Γ(R, W) := by
      apply IsIntegrallyClosed.of_localization_maximal
      intro p _ hpm
      let P : Spec Γ(R, W) := ⟨p, hpm.isPrime⟩
      have hyW : hW.fromSpec P ∈ W := by
        have h0 : hW.fromSpec P ∈ Set.range hW.fromSpec := ⟨P, rfl⟩
        rw [hW.range_fromSpec] at h0
        exact h0
      letI := TopCat.Presheaf.algebra_section_stalk R.presheaf (U := W) ⟨_, hyW⟩
      have hloc : IsLocalization.AtPrime (R.presheaf.stalk (hW.fromSpec P)) p :=
        hW.isLocalization_stalk' P hyW
      have := hV _ (hWV hyW)
      exact IsIntegrallyClosed.of_equiv (IsLocalization.algEquiv p.primeCompl
        (R.presheaf.stalk (hW.fromSpec P)) (Localization.AtPrime p)).toRingEquiv

    let g := Xt.presheaf.germ (b ⁻¹ᵁ W) x hxW
    let c : R.presheaf.stalk (b x) ⟶ R.functionField :=
      (R.presheaf.stalkCongr (Inseparable.of_eq hbx)).hom
    have hcomp : b.app W ≫ g ≫ inv (b.stalkMap x) ≫ c = R.germToFunctionField W := by
      rw [← Category.assoc, ← Scheme.Hom.germ_stalkMap b W x hbx', Category.assoc,
        IsIso.hom_inv_id_assoc]
      simp only [c, TopCat.Presheaf.stalkCongr_hom]
      exact TopCat.Presheaf.germ_stalkSpecializes _ _ _
    set i := (b.app W).hom with hi
    set ψ := (g ≫ inv (b.stalkMap x) ≫ c).hom with hψ
    have hψcomp : ∀ a, ψ (i a) = algebraMap Γ(R, W) R.functionField a := by
      intro a
      have e : ψ (i a) = (b.app W ≫ g ≫ inv (b.stalkMap x) ≫ c).hom a := rfl
      rw [e, hcomp]
      rfl
    have hψinj : Function.Injective ψ := by
      have h1 := germ_injective_of_isIntegral Xt x hxW
      have h2 := ((ConcreteCategory.isIso_iff_bijective (inv (b.stalkMap x))).mp inferInstance).1
      have h3 := ((ConcreteCategory.isIso_iff_bijective c).mp inferInstance).1
      exact h3.comp (h2.comp h1)

    have hfin : i.Finite := IsFinite.finite_app b W hW
    have hinj : Function.Injective i := by
      intro a a' h
      apply IsFractionRing.injective Γ(R, W) R.functionField
      rw [← hψcomp, ← hψcomp, h]
    have hsurj : Function.Surjective i := by
      intro β
      obtain ⟨p, hpm, hp⟩ := hfin.to_isIntegral β
      have hint : _root_.IsIntegral Γ(R, W) (ψ β) := by
        refine ⟨p, hpm, ?_⟩
        have h0 := congrArg ψ hp
        rw [Polynomial.hom_eval₂, map_zero] at h0
        have e : ψ.comp i = algebraMap Γ(R, W) R.functionField := RingHom.ext hψcomp
        rw [e] at h0
        exact h0
      obtain ⟨a, ha⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral hint
      exact ⟨a, hψinj (by rw [hψcomp, ha])⟩
    have happ : IsIso (b.app W) :=
      (ConcreteCategory.isIso_iff_bijective (b.app W)).mpr ⟨hinj, hsurj⟩
    have htop : IsIso (b ∣_ W).appTop := by
      rw [morphismRestrict_appTop]
      have h1 : IsIso (b.app (W.ι ''ᵁ ⊤)) := by rw [Scheme.Opens.ι_image_top]; exact happ
      exact IsIso.comp_isIso' h1 (Functor.map_isIso _ _)
    have hspec : IsIso (Spec.map (b ∣_ W).appTop) := inferInstance
    exact ((MorphismProperty.isomorphisms Scheme).arrow_mk_iso_iff
      (arrowIsoSpecΓOfIsAffine (b ∣_ W))).mpr hspec

  let O : {W : R.Opens // IsAffineOpen W ∧ W ≠ ⊥ ∧ W ≤ V} → V.toScheme.Opens :=
    fun W => V.ι ⁻¹ᵁ W.1
  have hO : iSup O = ⊤ := by
    rw [eq_top_iff]
    rintro z -
    rw [TopologicalSpace.Opens.mem_iSup]
    obtain ⟨W, hWa, hzW, hWV⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Scheme.isBasis_affineOpens R)) z.2
    have hW0 : W ≠ ⊥ := fun h => by rw [h] at hzW; exact hzW
    refine ⟨⟨W, hWa, hW0, hWV⟩, ?_⟩
    show z ∈ V.ι ⁻¹ᵁ W
    rw [Scheme.Hom.mem_preimage]
    exact hzW
  rw [← MorphismProperty.isomorphisms.iff,
    IsZariskiLocalAtTarget.iff_of_iSup_eq_top (P := MorphismProperty.isomorphisms Scheme) O hO]
  rintro ⟨W, hWa, hW0, hWV⟩
  rw [MorphismProperty.isomorphisms.iff]
  have heq : V.ι ''ᵁ (V.ι ⁻¹ᵁ W) = W := by
    rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
    exact inf_eq_right.mpr hWV
  exact ((MorphismProperty.isomorphisms Scheme).arrow_mk_iso_iff
    (morphismRestrictRestrict b V (V.ι ⁻¹ᵁ W) ≪≫ morphismRestrictEq b heq)).mpr
    (key W hWa hW0 hWV)

theorem wcpa_dj_gs_twist_transport : ∀ (Γ Q T R : Scheme.{u}) [AlgebraicGeometry.IsReduced T] (g : Γ ⟶ Q) (Φ : T ⟶ Q) (r : R ⟶ Limits.pullback g Φ), IsClosedImmersion r → Surjective r → (∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ Q), topologicalKrullDim ↥(Limits.pullback g s) ≤ ((1 : ℕ) : WithBot ℕ∞)) → (∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ Q), ∀ Z ∈ irreducibleComponents ↥(Limits.pullback g s), ¬ topologicalKrullDim ↥Z ≤ ((0 : ℕ) : WithBot ℕ∞) → ∃ w ∈ Z, ∃ V : Γ.Opens, Limits.pullback.fst g s w ∈ V ∧ SmoothOfRelativeDimension 1 (V.ι ≫ g)) → (∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ T), topologicalKrullDim ↥(Limits.pullback (r ≫ Limits.pullback.snd g Φ) s) ≤ ((1 : ℕ) : WithBot ℕ∞)) ∧ (∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ T), ∀ Z ∈ irreducibleComponents ↥(Limits.pullback (r ≫ Limits.pullback.snd g Φ) s), ¬ topologicalKrullDim ↥Z ≤ ((0 : ℕ) : WithBot ℕ∞) → ∃ w ∈ Z, ∃ V : R.Opens, Limits.pullback.fst (r ≫ Limits.pullback.snd g Φ) s w ∈ V ∧ SmoothOfRelativeDimension 1 (V.ι ≫ r ≫ Limits.pullback.snd g Φ)) :=
by
  intro Γ Q T R hT g Φ r hci hs hFD hGS


  have hEt : ∀ (D H : Type u) [CommRing D] [IsDomain D] [CommRing H] [Algebra D H]
      [Algebra.Etale D H], _root_.IsReduced H := by
    intro D H _ _ _ _ _
    haveI : _root_.IsReduced (TensorProduct D (FractionRing D) H) :=
      Algebra.FormallyUnramified.isReduced_of_field (FractionRing D)
        (TensorProduct D (FractionRing D) H)
    exact isReduced_of_injective
      (Algebra.TensorProduct.includeRight (R := D) (A := FractionRing D) (B := H))
      (Algebra.TensorProduct.includeRight_injective (IsFractionRing.injective D (FractionRing D)))

  have hDom : ∀ (D C : Type u) [CommRing D] [IsDomain D] [CommRing C] [Algebra D C]
      [Algebra.Smooth D C], _root_.IsReduced C := by
    intro D C _ _ _ _ _
    obtain ⟨s, hs, hloc⟩ := Algebra.Smooth.exists_span_eq_top_isStandardSmooth D C
    have hred : ∀ x ∈ s, _root_.IsReduced (Localization.Away x) := by
      intro x hx
      haveI := hloc x hx
      obtain ⟨ι, σ, _, _, ⟨P⟩⟩ := Algebra.IsStandardSmooth.out (R := D) (S := Localization.Away x)
      haveI := P.isStandardSmoothOfRelativeDimension rfl
      obtain ⟨φ, hφ⟩ := Algebra.IsStandardSmoothOfRelativeDimension.exists_etale_mvPolynomial
        P.dimension D (Localization.Away x)
      letI := φ.toRingHom.toAlgebra
      haveI : Algebra.Etale (MvPolynomial (Fin P.dimension) D) (Localization.Away x) :=
        RingHom.etale_algebraMap.mp hφ
      exact hEt (MvPolynomial (Fin P.dimension) D) (Localization.Away x)
    refine ⟨fun c ⟨k, hk⟩ => ?_⟩
    let I : Ideal C := LinearMap.ker (LinearMap.mulRight C c)
    have hI : ∀ x ∈ s, x ∈ I.radical := by
      intro x hx
      haveI := hred x hx
      have h0 : algebraMap C (Localization.Away x) c = 0 :=
        IsNilpotent.eq_zero ⟨k, by rw [← map_pow, hk, map_zero]⟩
      obtain ⟨⟨m, ⟨n, rfl⟩⟩, hm⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.powers x) _ c).mp h0
      exact ⟨n, by
        show x ^ n ∈ LinearMap.ker (LinearMap.mulRight C c)
        rw [LinearMap.mem_ker, LinearMap.mulRight_apply]
        exact hm⟩
    have htop : I.radical = ⊤ := by
      rw [eq_top_iff, ← hs]
      exact Ideal.span_le.mpr hI
    have h1 : (1 : C) ∈ I := by rw [Ideal.radical_eq_top.mp htop]; trivial
    have := LinearMap.mem_ker.mp h1
    rw [LinearMap.mulRight_apply, one_mul] at this
    exact this

  have hNoeth : ∀ (A B : Type u) [CommRing A] [_root_.IsReduced A] [IsNoetherianRing A]
      [CommRing B] [Algebra A B] [Algebra.Smooth A B], _root_.IsReduced B := by
    intro A B _ _ _ _ _ _
    classical
    haveI : Fintype (minimalPrimes A) := (minimalPrimes.finite_of_isNoetherianRing A).fintype
    let φ : A →ₗ[A] ((p : minimalPrimes A) → A ⧸ (p : Ideal A)) :=
      LinearMap.pi (fun p => (Ideal.Quotient.mkₐ A (p : Ideal A)).toLinearMap)
    have hφ : Function.Injective φ := by
      rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
      intro a ha
      have hmem : a ∈ sInf (minimalPrimes A) := by
        rw [Submodule.mem_sInf]
        intro p hp
        have := congrFun ha ⟨p, hp⟩
        simpa [φ, Ideal.Quotient.eq_zero_iff_mem] using this
      have hrad : a ∈ (⊥ : Ideal A).radical := by
        rw [← Ideal.sInf_minimalPrimes]; exact hmem
      obtain ⟨n, hn⟩ := hrad
      exact IsNilpotent.eq_zero ⟨n, hn⟩
    haveI : Module.Flat A B := Algebra.Smooth.flat A B
    let L : B →ₗ[A] ((p : minimalPrimes A) → TensorProduct A B (A ⧸ (p : Ideal A))) :=
      (TensorProduct.piRight A A B (fun p : minimalPrimes A => A ⧸ (p : Ideal A))).toLinearMap ∘ₗ
        (LinearMap.lTensor B φ) ∘ₗ (TensorProduct.rid A B).symm.toLinearMap
    have hL : Function.Injective L :=
      (TensorProduct.piRight A A B _).injective.comp
        ((Module.Flat.lTensor_preserves_injective_linearMap φ hφ).comp
          (TensorProduct.rid A B).symm.injective)
    have hLb : ∀ (b : B) (p : minimalPrimes A), L b p = b ⊗ₜ[A] (1 : A ⧸ (p : Ideal A)) := by
      intro b p
      simp [L, φ]
    refine ⟨fun b ⟨k, hk⟩ => hL ?_⟩
    rw [map_zero]
    funext p
    rw [hLb]
    haveI : IsDomain (A ⧸ (p : Ideal A)) :=
      Ideal.Quotient.isDomain _ (hI := p.2.1.1)
    haveI : _root_.IsReduced (TensorProduct A (A ⧸ (p : Ideal A)) B) :=
      hDom (A ⧸ (p : Ideal A)) (TensorProduct A (A ⧸ (p : Ideal A)) B)
    have h0 : (Algebra.TensorProduct.includeRight : B →ₐ[A] TensorProduct A (A ⧸ (p : Ideal A)) B) b = 0 :=
      IsNilpotent.eq_zero ⟨k, by rw [← map_pow, hk, map_zero]⟩
    have h1 := congrArg (Algebra.TensorProduct.comm A (A ⧸ (p : Ideal A)) B) h0
    simpa using h1

  have hRg : ∀ (A B : Type u) [CommRing A] [_root_.IsReduced A] [CommRing B] [Algebra A B]
      [Algebra.Smooth A B], _root_.IsReduced B := by
    intro A B _ _ _ _ _
    obtain ⟨A₀, B₀, _, _, hfg, hsm, ⟨e⟩⟩ := Algebra.Smooth.exists_subalgebra_fg ℤ A B
    haveI := hsm
    haveI : Module.Flat A₀ B₀ := Algebra.Smooth.flat A₀ B₀
    haveI : Algebra.FiniteType ℤ A₀ := Subalgebra.fg_iff_finiteType A₀ |>.mp hfg
    have hBA : _root_.IsReduced (TensorProduct A₀ B₀ A) := by
      apply IsReduced.tensorProduct_of_flat_of_forall_fg
      intro A' hA'
      haveI : _root_.IsReduced A' := isReduced_of_injective A'.val Subtype.val_injective
      haveI : Algebra.FiniteType A₀ A' := Subalgebra.fg_iff_finiteType A' |>.mp hA'
      haveI : Algebra.FiniteType ℤ A' := Algebra.FiniteType.trans (S := A₀) inferInstance inferInstance
      haveI : IsNoetherianRing A' := Algebra.FiniteType.isNoetherianRing ℤ A'
      haveI : _root_.IsReduced (TensorProduct A₀ A' B₀) := hNoeth A' (TensorProduct A₀ A' B₀)
      exact isReduced_of_injective (Algebra.TensorProduct.comm A₀ B₀ A').toRingHom
        (Algebra.TensorProduct.comm A₀ B₀ A').injective
    haveI := hBA
    haveI : _root_.IsReduced (TensorProduct A₀ A B₀) :=
      isReduced_of_injective (Algebra.TensorProduct.comm A₀ A B₀).toRingHom
        (Algebra.TensorProduct.comm A₀ A B₀).injective
    exact isReduced_of_injective e.toRingHom e.injective

  have hSch : ∀ {Y S : Scheme.{u}} [AlgebraicGeometry.IsReduced S] (f : Y ⟶ S), Smooth f →
      AlgebraicGeometry.IsReduced Y := by
    intro Y S hS f hf
    have hst : ∀ y : Y, _root_.IsReduced (Y.presheaf.stalk y) := by
      intro y
      obtain ⟨U, hU, hyU, -⟩ := exists_isAffineOpen_mem_and_subset (x := f y) (U := ⊤) trivial
      obtain ⟨V, hV, hyV, hVU⟩ := exists_isAffineOpen_mem_and_subset (x := y) (U := f ⁻¹ᵁ U) hyU
      have e : V ≤ f ⁻¹ᵁ U := hVU
      have hsm := HasRingHomProperty.appLE @Smooth f hf ⟨U, hU⟩ ⟨V, hV⟩ e
      letI := (f.appLE U V e).hom.toAlgebra
      haveI : Algebra.Smooth Γ(S, U) Γ(Y, V) := hsm.toAlgebra
      haveI hSU : _root_.IsReduced Γ(S, U) := hS.component_reduced U
      have hYV : _root_.IsReduced Γ(Y, V) := @hRg Γ(S, U) Γ(Y, V) _ hSU _ _ _
      letI : Algebra Γ(Y, V) (Y.presheaf.stalk y) := (Y.presheaf.germ V y hyV).hom.toAlgebra
      haveI : IsLocalization.AtPrime (Y.presheaf.stalk y) (hV.primeIdealOf ⟨y, hyV⟩).asIdeal :=
        hV.isLocalization_stalk ⟨y, hyV⟩
      exact isReduced_localizationPreserves (hV.primeIdealOf ⟨y, hyV⟩).asIdeal.primeCompl
        (Y.presheaf.stalk y) hYV
    exact isReduced_of_isReduced_stalk Y

  have hθ : ∀ (S : Scheme.{u}) (s : S ⟶ T), ∃ θ : Limits.pullback (r ≫ Limits.pullback.snd g Φ) s ⟶
      Limits.pullback g (s ≫ Φ), IsHomeomorph ⇑θ ∧ θ ≫ Limits.pullback.fst g (s ≫ Φ) =
      Limits.pullback.fst (r ≫ Limits.pullback.snd g Φ) s ≫ r ≫ Limits.pullback.fst g Φ := by
    intro S s
    let ρ : Limits.pullback (r ≫ Limits.pullback.snd g Φ) s ⟶
        Limits.pullback (Limits.pullback.snd g Φ) s :=
      Limits.pullback.lift (Limits.pullback.fst (r ≫ Limits.pullback.snd g Φ) s ≫ r)
        (Limits.pullback.snd (r ≫ Limits.pullback.snd g Φ) s)
        (by rw [Category.assoc]; exact Limits.pullback.condition)
    have hout : IsPullback (ρ ≫ Limits.pullback.snd (Limits.pullback.snd g Φ) s)
        (Limits.pullback.fst (r ≫ Limits.pullback.snd g Φ) s) s
        (r ≫ Limits.pullback.snd g Φ) := by
      rw [Limits.pullback.lift_snd]
      exact (IsPullback.of_hasPullback _ _).flip
    have hsq : IsPullback ρ (Limits.pullback.fst (r ≫ Limits.pullback.snd g Φ) s)
        (Limits.pullback.fst (Limits.pullback.snd g Φ) s) r :=
      IsPullback.of_right hout (Limits.pullback.lift_fst _ _ _)
        (IsPullback.of_hasPullback _ _).flip
    haveI : IsClosedImmersion ρ := MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq.flip hci
    haveI : Surjective ρ := MorphismProperty.of_isPullback (P := @Surjective) hsq.flip hs
    refine ⟨ρ ≫ (Limits.pullbackLeftPullbackSndIso g Φ s).hom, ?_, ?_⟩
    · exact isHomeomorph_iff_isEmbedding_surjective.mpr
        ⟨(Scheme.Hom.isClosedEmbedding _).isEmbedding, Scheme.Hom.surjective _⟩
    · rw [Category.assoc, Limits.pullbackLeftPullbackSndIso_hom_fst, ← Category.assoc,
        Limits.pullback.lift_fst, Category.assoc]

  have hcomp : ∀ {X Y : Type u} [TopologicalSpace X] [TopologicalSpace Y] (f : X → Y),
      IsHomeomorph f → ∀ Z ∈ irreducibleComponents X,
        f '' Z ∈ irreducibleComponents Y ∧ topologicalKrullDim ↥(f '' Z) = topologicalKrullDim ↥Z := by
    intro X Y _ _ f hf Z hZ
    refine ⟨image_mem_irreducibleComponents_of_isPreirreducible_fiber f hf.continuous hf.isOpenMap
      (fun y => Set.Subsingleton.isPreirreducible (fun a ha b hb => by
        rw [Set.mem_preimage, Set.mem_singleton_iff] at ha hb
        exact hf.injective (ha.trans hb.symm))) hf.surjective hZ, ?_⟩
    have hh : IsHomeomorph (Set.MapsTo.restrict f Z (f '' Z) (Set.mapsTo_image f Z)) :=
      isHomeomorph_iff_isEmbedding_surjective.mpr
        ⟨(isHomeomorph_iff_isEmbedding_surjective.mp hf).1.restrict _,
          Set.surjective_mapsTo_image_restrict f Z⟩
    exact (IsHomeomorph.topologicalKrullDim_eq _ hh).symm
  refine ⟨?_, ?_⟩
  · intro K _ _ s
    obtain ⟨θ, hθh, -⟩ := hθ _ s
    exact (IsHomeomorph.topologicalKrullDim_eq _ hθh).trans_le (hFD K (s ≫ Φ))
  · intro K _ _ s Z hZ hZ0
    obtain ⟨θ, hθh, hθfst⟩ := hθ _ s
    obtain ⟨hZ', hdim⟩ := hcomp _ hθh Z hZ
    obtain ⟨w', ⟨w, hwZ, rfl⟩, V, hw'V, hV⟩ :=
      hGS K (s ≫ Φ) _ hZ' (by rw [hdim]; exact hZ0)
    have key : (θ ≫ Limits.pullback.fst g (s ≫ Φ)) w =
        (Limits.pullback.fst (r ≫ Limits.pullback.snd g Φ) s ≫ r ≫ Limits.pullback.fst g Φ) w := by
      rw [hθfst]
    simp only [Scheme.Hom.comp_apply] at key
    refine ⟨w, hwZ, r ⁻¹ᵁ (Limits.pullback.fst g Φ ⁻¹ᵁ V), ?_, ?_⟩
    · rw [Scheme.Hom.mem_preimage, Scheme.Hom.mem_preimage, ← key]
      exact hw'V
    · have hsq : IsPullback (Limits.pullback.fst g Φ ∣_ V)
          ((Limits.pullback.fst g Φ ⁻¹ᵁ V).ι ≫ Limits.pullback.snd g Φ) (V.ι ≫ g) Φ :=
        (isPullback_morphismRestrict (Limits.pullback.fst g Φ) V).paste_vert
          (IsPullback.of_hasPullback g Φ)
      have hOsm : SmoothOfRelativeDimension 1
          ((Limits.pullback.fst g Φ ⁻¹ᵁ V).ι ≫ Limits.pullback.snd g Φ) :=
        MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hsq hV
      haveI hOred : AlgebraicGeometry.IsReduced (Limits.pullback.fst g Φ ⁻¹ᵁ V).toScheme :=
        @hSch _ T hT ((Limits.pullback.fst g Φ ⁻¹ᵁ V).ι ≫ Limits.pullback.snd g Φ)
          (by haveI := hOsm; exact SmoothOfRelativeDimension.smooth 1 _)
      haveI : Surjective (r ∣_ (Limits.pullback.fst g Φ ⁻¹ᵁ V)) :=
        MorphismProperty.of_isPullback (P := @Surjective)
          (isPullback_morphismRestrict r (Limits.pullback.fst g Φ ⁻¹ᵁ V)).flip hs
      haveI : IsIso (r ∣_ (Limits.pullback.fst g Φ ⁻¹ᵁ V)) :=
        isIso_of_isClosedImmersion_of_surjective _
      have hcomm : (r ⁻¹ᵁ (Limits.pullback.fst g Φ ⁻¹ᵁ V)).ι ≫ r ≫ Limits.pullback.snd g Φ =
          (r ∣_ (Limits.pullback.fst g Φ ⁻¹ᵁ V)) ≫
            (Limits.pullback.fst g Φ ⁻¹ᵁ V).ι ≫ Limits.pullback.snd g Φ := by
        rw [← Category.assoc, ← morphismRestrict_ι, Category.assoc]
      rw [hcomm]
      have hsq2 : IsPullback (r ∣_ (Limits.pullback.fst g Φ ⁻¹ᵁ V))
          ((r ∣_ (Limits.pullback.fst g Φ ⁻¹ᵁ V)) ≫
            (Limits.pullback.fst g Φ ⁻¹ᵁ V).ι ≫ Limits.pullback.snd g Φ)
          ((Limits.pullback.fst g Φ ⁻¹ᵁ V).ι ≫ Limits.pullback.snd g Φ) (𝟙 T) :=
        IsPullback.of_horiz_isIso ⟨by rw [Category.comp_id]⟩
      exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hsq2 hOsm

theorem wcpa_dj_gs_normalization_transport : ∀ (Xt R Q : Scheme.{u}) [AlgebraicGeometry.IsIntegral Q] [IsLocallyNoetherian Q] (g : R ⟶ Q) (b : Xt ⟶ R), (∀ q : Q, IsIntegrallyClosed (Q.presheaf.stalk q)) → IsFinite b → (∀ V : R.Opens, (∀ y : R, y ∈ V → IsIntegrallyClosed (R.presheaf.stalk y)) → IsIso (b ∣_ V)) → (∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ Q), topologicalKrullDim ↥(Limits.pullback g s) ≤ ((1 : ℕ) : WithBot ℕ∞)) → (∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ Q), ∀ Z ∈ irreducibleComponents ↥(Limits.pullback g s), ¬ topologicalKrullDim ↥Z ≤ ((0 : ℕ) : WithBot ℕ∞) → ∃ w ∈ Z, ∃ V : R.Opens, Limits.pullback.fst g s w ∈ V ∧ SmoothOfRelativeDimension 1 (V.ι ≫ g)) → ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ Q), ∀ Z ∈ irreducibleComponents ↥(Limits.pullback (b ≫ g) s), ¬ topologicalKrullDim ↥Z ≤ ((0 : ℕ) : WithBot ℕ∞) → ∃ w ∈ Z, ∃ V : Xt.Opens, Limits.pullback.fst (b ≫ g) s w ∈ V ∧ SmoothOfRelativeDimension 1 (V.ι ≫ b ≫ g) :=
by
  intro Xt R Q _ _ g b hQn hb hIso hFD1 hGSP K _ _ s Z hZ hpos
  classical

  have D1 : ∀ {S : Type u} [TopologicalSpace S] (p q : S), p ⤳ q → ¬ q ⤳ p →
      ¬ topologicalKrullDim S ≤ ((0 : ℕ) : WithBot ℕ∞) := by
    intro S _ p q hpq hqp hle
    let Cq : TopologicalSpace.IrreducibleCloseds S :=
      ⟨closure {q}, isIrreducible_singleton.closure, isClosed_closure⟩
    let Cp : TopologicalSpace.IrreducibleCloseds S :=
      ⟨closure {p}, isIrreducible_singleton.closure, isClosed_closure⟩
    have hlt : Cq < Cp := by
      refine lt_of_le_of_ne ?_ ?_
      · show closure {q} ⊆ closure {p}
        exact specializes_iff_closure_subset.mp hpq
      · intro h
        apply hqp
        have h' : (Cp : Set S) = Cq := by rw [h]
        rw [specializes_iff_mem_closure]
        show p ∈ (Cq : Set S)
        rw [← h']
        exact subset_closure rfl
    have h2 : ((1 : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim S := by
      let ser : LTSeries (TopologicalSpace.IrreducibleCloseds S) :=
        (RelSeries.singleton _ Cq).snoc Cp hlt
      have hl : ser.length = 1 := rfl
      have := Order.LTSeries.length_le_krullDim ser
      rw [hl] at this
      exact this
    exact absurd (h2.trans hle) (by norm_num)

  have D2 : ∀ {S : Type u} [TopologicalSpace S] (p q : S) (W : Set S), IsIrreducible W →
      IsClosed W → p ⤳ q → ¬ q ⤳ p → closure {p} ⊆ W → closure {p} ≠ W →
      ¬ topologicalKrullDim S ≤ ((1 : ℕ) : WithBot ℕ∞) := by
    intro S _ p q W hWi hWc hpq hqp hpW hpW' hle
    let Cq : TopologicalSpace.IrreducibleCloseds S :=
      ⟨closure {q}, isIrreducible_singleton.closure, isClosed_closure⟩
    let Cp : TopologicalSpace.IrreducibleCloseds S :=
      ⟨closure {p}, isIrreducible_singleton.closure, isClosed_closure⟩
    let CW : TopologicalSpace.IrreducibleCloseds S := ⟨W, hWi, hWc⟩
    have hlt : Cq < Cp := by
      refine lt_of_le_of_ne ?_ ?_
      · show closure {q} ⊆ closure {p}
        exact specializes_iff_closure_subset.mp hpq
      · intro h
        apply hqp
        have h' : (Cp : Set S) = Cq := by rw [h]
        rw [specializes_iff_mem_closure]
        show p ∈ (Cq : Set S)
        rw [← h']
        exact subset_closure rfl
    have hlt2 : Cp < CW := by
      refine lt_of_le_of_ne ?_ ?_
      · show closure {p} ⊆ W
        exact hpW
      · intro h
        apply hpW'
        have h' : (Cp : Set S) = CW := by rw [h]
        exact h'
    have h2 : ((2 : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim S := by
      let ser1 : LTSeries (TopologicalSpace.IrreducibleCloseds S) :=
        (RelSeries.singleton _ Cq).snoc Cp hlt
      have hlast : ser1.last = Cp := rfl
      let ser : LTSeries (TopologicalSpace.IrreducibleCloseds S) :=
        ser1.snoc CW (by show ser1.last < CW; rw [hlast]; exact hlt2)
      have hl : ser.length = 2 := rfl
      have := Order.LTSeries.length_le_krullDim ser
      rw [hl] at this
      exact this
    exact absurd (h2.trans hle) (by norm_num)

  have s1 : ∀ {T' T : Type u} [TopologicalSpace T'] [TopologicalSpace T] [QuasiSober T']
      [T0Space T] (β : T' → T), Continuous β → (∀ x y : T', x ⤳ y → β x = β y → x = y) →
      topologicalKrullDim T ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ Z ∈ irreducibleComponents T',
      ¬ topologicalKrullDim ↥Z ≤ ((0 : ℕ) : WithBot ℕ∞) → ∃ ζ ∈ Z, ∃ Z' ∈ irreducibleComponents T,
      ¬ topologicalKrullDim ↥Z' ≤ ((0 : ℕ) : WithBot ℕ∞) ∧ ∀ w' ∈ Z', β ζ ⤳ w' := by
    intro T' T _ _ _ _ β hβ hfib hdim Z hZ hpos
    have hZi : IsIrreducible Z := hZ.1
    have hZc : IsClosed Z := isClosed_of_mem_irreducibleComponents Z hZ
    have hgen := hZi.isGenericPoint_genericPoint hZc
    set ζ := hZi.genericPoint with hζ
    have hζZ : ζ ∈ Z := hgen.mem
    obtain ⟨z, hzZ, hzne⟩ : ∃ z ∈ Z, z ≠ ζ := by
      by_contra hcon
      push_neg at hcon
      apply hpos
      haveI : Subsingleton ↥Z :=
        ⟨fun a c => Subtype.ext ((hcon a a.2).trans (hcon c c.2).symm)⟩
      haveI : Subsingleton (TopologicalSpace.IrreducibleCloseds ↥Z) := ⟨fun A B => by
        apply TopologicalSpace.IrreducibleCloseds.ext
        have hA : (A : Set ↥Z) = Set.univ := by
          obtain ⟨a, ha⟩ := A.isIrreducible.nonempty
          exact Set.eq_univ_of_forall (fun c => Subsingleton.elim a c ▸ ha)
        have hB : (B : Set ↥Z) = Set.univ := by
          obtain ⟨a, ha⟩ := B.isIrreducible.nonempty
          exact Set.eq_univ_of_forall (fun c => Subsingleton.elim a c ▸ ha)
        rw [hA, hB]⟩
      rw [Nat.cast_zero]
      exact Order.krullDim_nonpos_of_subsingleton
    have hζz : ζ ⤳ z := hgen.specializes hzZ
    set x := β ζ with hx
    set y := β z with hy
    have hxy : x ⤳ y := hζz.map hβ
    have hxney : x ≠ y := fun h => hzne (hfib ζ z hζz h).symm
    have hyx : ¬ y ⤳ x := fun h => hxney (hxy.antisymm h).eq
    obtain ⟨Z', hZ', hCZ'⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible
      (closure {x}) isIrreducible_singleton.closure
    have hZ'i : IsIrreducible Z' := hZ'.1
    have hZ'c : IsClosed Z' := isClosed_of_mem_irreducibleComponents Z' hZ'
    have hC : closure {x} = Z' := by
      by_contra hne
      exact D2 x y Z' hZ'i hZ'c hxy hyx hCZ' hne hdim
    refine ⟨ζ, hζZ, Z', hZ', ?_, ?_⟩
    · have hxZ' : x ∈ Z' := hC ▸ subset_closure rfl
      have hyZ' : y ∈ Z' := hC ▸ specializes_iff_mem_closure.mp hxy
      have hind : Topology.IsInducing (Subtype.val : ↥Z' → T) := Topology.IsInducing.subtypeVal
      apply D1 (⟨x, hxZ'⟩ : ↥Z') ⟨y, hyZ'⟩
      · exact hind.specializes_iff.mp hxy
      · intro h
        exact hyx (hind.specializes_iff.mpr h)
    · intro w' hw'
      rw [← hC] at hw'
      exact specializes_iff_mem_closure.mpr hw'

  have s2 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIntegralHom f] (x y : X), x ⤳ y →
      f x = f y → x = y := by
    intro X Y f _ x y hxy hfxy
    obtain ⟨U, hU, hyU, -⟩ :=
      exists_isAffineOpen_mem_and_subset (x := f y) (U := (⊤ : Y.Opens)) trivial
    have hV : IsAffineOpen (f ⁻¹ᵁ U) := hU.preimage f
    have hyV : y ∈ f ⁻¹ᵁ U := hyU
    have hxV : x ∈ f ⁻¹ᵁ U := hxy.mem_open (f ⁻¹ᵁ U).isOpen hyV
    have hpx : hV.fromSpec (hV.primeIdealOf ⟨x, hxV⟩) = x := hV.fromSpec_primeIdealOf ⟨x, hxV⟩
    have hqy : hV.fromSpec (hV.primeIdealOf ⟨y, hyV⟩) = y := hV.fromSpec_primeIdealOf ⟨y, hyV⟩
    have hembV := hV.fromSpec.isOpenEmbedding
    have hembU := hU.fromSpec.isOpenEmbedding
    have hpq : hV.primeIdealOf ⟨x, hxV⟩ ≤ hV.primeIdealOf ⟨y, hyV⟩ := by
      have h0 : hV.fromSpec (hV.primeIdealOf ⟨x, hxV⟩) ⤳ hV.fromSpec (hV.primeIdealOf ⟨y, hyV⟩) := by
        rw [hpx, hqy]; exact hxy
      have hsp := hembV.isInducing.specializes_iff.mp h0
      exact (PrimeSpectrum.le_iff_specializes _ _).mpr hsp
    have hsq := hU.SpecMap_appLE_fromSpec f hV le_rfl
    rw [Scheme.Hom.appLE_eq_app] at hsq
    have h1 : ∀ r, hU.fromSpec (Spec.map (f.app U) r) = f (hV.fromSpec r) := by
      intro r
      rw [← Scheme.Hom.comp_apply, hsq, Scheme.Hom.comp_apply]
    have hsame : Spec.map (f.app U) (hV.primeIdealOf ⟨x, hxV⟩) =
        Spec.map (f.app U) (hV.primeIdealOf ⟨y, hyV⟩) := by
      apply hembU.injective
      have e1 := h1 (hV.primeIdealOf ⟨x, hxV⟩)
      have e2 := h1 (hV.primeIdealOf ⟨y, hyV⟩)
      rw [hpx] at e1
      rw [hqy] at e2
      exact e1.trans (hfxy.trans e2.symm)
    have hint := IsIntegralHom.isIntegral_app f U hU
    letI : Algebra Γ(Y, U) Γ(X, f ⁻¹ᵁ U) := (f.app U).hom.toAlgebra
    haveI : Algebra.IsIntegral Γ(Y, U) Γ(X, f ⁻¹ᵁ U) := ⟨fun z => hint z⟩
    have hpq' : hV.primeIdealOf ⟨x, hxV⟩ = hV.primeIdealOf ⟨y, hyV⟩ := by
      by_contra hne
      have hlt : (hV.primeIdealOf ⟨x, hxV⟩).asIdeal < (hV.primeIdealOf ⟨y, hyV⟩).asIdeal :=
        lt_of_le_of_ne hpq (fun h => hne (PrimeSpectrum.ext h))
      have := Ideal.IsIntegral.under_lt_under (R := Γ(Y, U)) hlt
      have h2 : Ideal.under Γ(Y, U) (hV.primeIdealOf ⟨x, hxV⟩).asIdeal =
          Ideal.under Γ(Y, U) (hV.primeIdealOf ⟨y, hyV⟩).asIdeal :=
        congrArg PrimeSpectrum.asIdeal hsame
      exact (ne_of_lt this) h2
    rw [← hpx, ← hqy, hpq']

  have s3a : ∀ (U : Q.Opens), IsAffineOpen U → ∀ x : Q, x ∈ U → IsIntegrallyClosed Γ(Q, U) := by
    intro U hU x hx
    haveI : Nonempty U := ⟨⟨x, hx⟩⟩
    haveI : IsDomain Γ(Q, U) := IsIntegral.component_integral U
    apply IsIntegrallyClosed.of_localization_maximal
    intro p _ hpm
    have hr : hU.fromSpec ⟨p, hpm.isPrime⟩ ∈ (U : Set Q) := by
      rw [← hU.range_fromSpec]; exact ⟨_, rfl⟩
    obtain ⟨z, hz⟩ : ∃ z : U, hU.primeIdealOf z = ⟨p, hpm.isPrime⟩ := by
      refine ⟨⟨_, hr⟩, ?_⟩
      apply hU.fromSpec.isOpenEmbedding.injective
      rw [hU.fromSpec_primeIdealOf]
    have hloc : IsLocalization.AtPrime (Q.presheaf.stalk (z : Q)) p := by
      have h := hU.isLocalization_stalk z
      rw [hz] at h
      exact h
    haveI := hQn (z : Q)
    let e := IsLocalization.algEquiv p.primeCompl (Localization.AtPrime p)
      (Q.presheaf.stalk (z : Q))
    exact IsIntegrallyClosed.of_equiv e.symm.toRingEquiv

  have s3 : ∀ (X : Scheme.{u}) (f : X ⟶ Q), SmoothOfRelativeDimension 1 f → ∀ x : X,
      IsIntegrallyClosed (X.presheaf.stalk x) := by
    intro X f hf x
    obtain ⟨U, hU, hxU, -⟩ :=
      exists_isAffineOpen_mem_and_subset (x := f x) (U := (⊤ : Q.Opens)) trivial
    haveI : Nonempty U := ⟨⟨f x, hxU⟩⟩
    haveI : IsDomain Γ(Q, U) := IsIntegral.component_integral U
    haveI : IsNoetherianRing Γ(Q, U) := IsLocallyNoetherian.component_noetherian ⟨U, hU⟩
    haveI : IsIntegrallyClosed Γ(Q, U) := s3a U hU (f x) hxU
    haveI : SmoothOfRelativeDimension 1 (f ∣_ U) :=
      MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1)
        (isPullback_morphismRestrict f U).flip hf
    haveI : Smooth (f ∣_ U) := SmoothOfRelativeDimension.smooth 1 _
    have hxW : x ∈ f ⁻¹ᵁ U := hxU
    haveI : Smooth ((f ∣_ U) ≫ hU.isoSpec.hom) := inferInstance
    have h := (wc_fntame_smooth_stalk_normal Γ(Q, U) (f ⁻¹ᵁ U) ((f ∣_ U) ≫ hU.isoSpec.hom)
      ⟨x, hxW⟩).2
    exact IsIntegrallyClosed.of_equiv ((f ⁻¹ᵁ U).stalkIso ⟨x, hxW⟩).commRingCatIsoToRingEquiv

  have hcond : (Limits.pullback.fst (b ≫ g) s ≫ b) ≫ g = Limits.pullback.snd (b ≫ g) s ≫ s := by
    rw [Category.assoc]; exact Limits.pullback.condition
  let β : Limits.pullback (b ≫ g) s ⟶ Limits.pullback g s :=
    Limits.pullback.lift (Limits.pullback.fst (b ≫ g) s ≫ b) (Limits.pullback.snd (b ≫ g) s) hcond
  have hβfst : β ≫ Limits.pullback.fst g s = Limits.pullback.fst (b ≫ g) s ≫ b :=
    Limits.pullback.lift_fst _ _ _
  have hβsnd : β ≫ Limits.pullback.snd g s = Limits.pullback.snd (b ≫ g) s :=
    Limits.pullback.lift_snd _ _ _
  have hpb : IsPullback (Limits.pullback.fst (b ≫ g) s) β b (Limits.pullback.fst g s) := by
    refine IsPullback.of_bot ?_ hβfst.symm (IsPullback.of_hasPullback g s)
    rw [hβsnd]; exact IsPullback.of_hasPullback (b ≫ g) s
  haveI : IsFinite β := MorphismProperty.of_isPullback (P := @IsFinite) hpb hb

  obtain ⟨ζ, hζZ, Z', hZ', hpos', hsp⟩ :=
    s1 (⇑β) β.continuous (s2 β) (hFD1 K s) Z hZ hpos
  obtain ⟨w', hw'Z', V, hw'V, hVsm⟩ := hGSP K s Z' hZ' hpos'
  have hVn : ∀ y : R, y ∈ V → IsIntegrallyClosed (R.presheaf.stalk y) := by
    intro y hy
    haveI := s3 V (V.ι ≫ g) hVsm ⟨y, hy⟩
    exact IsIntegrallyClosed.of_equiv (V.stalkIso ⟨y, hy⟩).commRingCatIsoToRingEquiv
  haveI hiso := hIso V hVn
  refine ⟨ζ, hζZ, b ⁻¹ᵁ V, ?_, ?_⟩
  · rw [Scheme.Hom.mem_preimage]
    have h1 : b (Limits.pullback.fst (b ≫ g) s ζ) = Limits.pullback.fst g s (β ζ) := by
      rw [← Scheme.Hom.comp_apply, ← hβfst, Scheme.Hom.comp_apply]
    rw [h1]
    exact ((hsp w' hw'Z').map (Limits.pullback.fst g s).continuous).mem_open V.isOpen hw'V
  · have he : (b ⁻¹ᵁ V).ι ≫ b ≫ g = (b ∣_ V) ≫ (V.ι ≫ g) := by
      rw [← Category.assoc, ← morphismRestrict_ι, Category.assoc]
    rw [he]
    haveI := hVsm
    have := smoothOfRelativeDimension_comp 0 1 (b ∣_ V) (V.ι ≫ g)
    simpa using this

theorem wcpa_dj_gs_fcp_affine_chart : ∀ (X S : Scheme.{u}) (f : X ⟶ S) (K : Type u) [Field K] (s : Spec (.of K) ⟶ S) (z : ↥(Limits.pullback f s)), IsClosed ({z} : Set ↥(Limits.pullback f s)) → (∀ z' : ↥(Limits.pullback f s), z' ⤳ z → z' = z) → ∃ (V : S.Opens) (U : X.Opens) (_ : IsAffineOpen V) (_ : IsAffineOpen U) (hUV : U ≤ f ⁻¹ᵁ V) (ψ : Γ(S, V) →+* K), (U : Set X).Nonempty ∧ (letI := (f.appLE V U hUV).hom.toAlgebra; letI := ψ.toAlgebra; ∃ Q : Ideal (TensorProduct Γ(S, V) Γ(X, U) K), Q ∈ minimalPrimes (TensorProduct Γ(S, V) Γ(X, U) K) ∧ Q.IsMaximal) :=
by
  intro X S f K _ s z hcl hgen
  classical

  obtain ⟨V, hV, hpV, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    (Scheme.isBasis_affineOpens S)) (show f (Limits.pullback.fst f s z) ∈ (⊤ : S.Opens) from trivial)
  have hxV : Limits.pullback.fst f s z ∈ f ⁻¹ᵁ V := hpV
  obtain ⟨U, hU, hxU, hUV⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    (Scheme.isBasis_affineOpens X)) hxV
  have hV' : IsAffineOpen V := hV
  have hU' : IsAffineOpen U := hU

  have hrange : Set.range s ⊆ Set.range hV'.fromSpec := by
    rw [hV'.range_fromSpec]
    rintro _ ⟨w, rfl⟩
    have hw : w = Limits.pullback.snd f s z := Subsingleton.elim _ _
    rw [hw, ← Scheme.Hom.comp_apply, ← Limits.pullback.condition, Scheme.Hom.comp_apply]
    exact hpV
  obtain ⟨ψ, hs⟩ : ∃ ψ : Γ(S, V) →+* K, s = Spec.map (CommRingCat.ofHom ψ) ≫ hV'.fromSpec := by
    refine ⟨(Spec.preimage (IsOpenImmersion.lift hV'.fromSpec s hrange)).hom, ?_⟩
    rw [CommRingCat.ofHom_hom, Spec.map_preimage, IsOpenImmersion.lift_fac]
  refine ⟨V, U, hV', hU', hUV, ψ, ⟨Limits.pullback.fst f s z, hxU⟩, ?_⟩
  letI := (f.appLE V U hUV).hom.toAlgebra
  letI := ψ.toAlgebra


  have H1 : IsPullback (Limits.pullback.fst f s ∣_ U)
      ((Limits.pullback.fst f s ⁻¹ᵁ U).ι ≫ Limits.pullback.snd f s) (Scheme.Opens.ι U ≫ f) s :=
    (isPullback_morphismRestrict (Limits.pullback.fst f s) U).paste_vert
      (IsPullback.of_hasPullback f s)
  have H20 : IsPullback
      (Limits.pullback.fst (Spec.map (f.appLE V U hUV)) (Spec.map (CommRingCat.ofHom ψ)))
      (Limits.pullback.snd (Spec.map (f.appLE V U hUV)) (Spec.map (CommRingCat.ofHom ψ)))
      (Spec.map (f.appLE V U hUV) ≫ hV'.fromSpec)
      (Spec.map (CommRingCat.ofHom ψ) ≫ hV'.fromSpec) :=
    IsPullback.of_isLimit (Limits.pullbackIsPullbackOfCompMono _ _ hV'.fromSpec)
  have H2 : IsPullback
      (Limits.pullback.fst (Spec.map (f.appLE V U hUV)) (Spec.map (CommRingCat.ofHom ψ)) ≫
        hU'.isoSpec.inv)
      (Limits.pullback.snd (Spec.map (f.appLE V U hUV)) (Spec.map (CommRingCat.ofHom ψ)))
      (Scheme.Opens.ι U ≫ f) s :=
    IsPullback.of_iso H20 (Iso.refl _) hU'.isoSpec.symm (Iso.refl _) (Iso.refl _)
      (by simp) (by simp)
      (by
        rw [Iso.refl_hom, Category.comp_id, Iso.symm_hom, ← Category.assoc,
          IsAffineOpen.isoSpec_inv_ι, IsAffineOpen.SpecMap_appLE_fromSpec f hV' hU' hUV])
      (by rw [Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp, hs])
  let e₁ := IsPullback.isoIsPullback _ _ H1 H2
  let e₂ : Limits.pullback (Spec.map (f.appLE V U hUV)) (Spec.map (CommRingCat.ofHom ψ)) ≅
      Spec (.of (TensorProduct Γ(S, V) Γ(X, U) K)) :=
    pullbackSpecIso Γ(S, V) Γ(X, U) K
  have e : ↥((Limits.pullback.fst f s) ⁻¹' (U : Set X)) ≃ₜ
      PrimeSpectrum (TensorProduct Γ(S, V) Γ(X, U) K) :=
    Scheme.homeoOfIso (e₁ ≪≫ e₂)

  have hz : z ∈ (Limits.pullback.fst f s) ⁻¹' (U : Set X) := hxU
  have hmax : (e ⟨z, hz⟩).asIdeal.IsMaximal := by
    rw [← PrimeSpectrum.isClosed_singleton_iff_isMaximal]
    have h1 : IsClosed ({⟨z, hz⟩} : Set ↥((Limits.pullback.fst f s) ⁻¹' (U : Set X))) := by
      have heq : ({⟨z, hz⟩} : Set ↥((Limits.pullback.fst f s) ⁻¹' (U : Set X))) =
          Subtype.val ⁻¹' ({z} : Set ↥(Limits.pullback f s)) := by
        ext w
        simp only [Set.mem_singleton_iff, Set.mem_preimage, Subtype.ext_iff]
      rw [heq]
      exact hcl.preimage continuous_subtype_val
    have h2 := e.isClosed_image.mpr h1
    rwa [Set.image_singleton] at h2
  have hmin : (e ⟨z, hz⟩).asIdeal ∈ minimalPrimes (TensorProduct Γ(S, V) Γ(X, U) K) := by
    refine ⟨⟨(e ⟨z, hz⟩).isPrime, bot_le⟩, ?_⟩
    rintro q ⟨hq, -⟩ hle
    let P' : PrimeSpectrum (TensorProduct Γ(S, V) Γ(X, U) K) := ⟨q, hq⟩
    have h1 : P' ⤳ e ⟨z, hz⟩ := (PrimeSpectrum.le_iff_specializes P' (e ⟨z, hz⟩)).mp hle
    have h2 : e.symm P' ⤳ ⟨z, hz⟩ := by
      have := h1.map e.symm.continuous
      rwa [Homeomorph.symm_apply_apply] at this
    have h3 : (e.symm P').1 ⤳ z := h2.map continuous_subtype_val
    have h4 : e.symm P' = ⟨z, hz⟩ := Subtype.ext (hgen _ h3)
    have h5 : P' = e ⟨z, hz⟩ := by rw [← h4, Homeomorph.apply_symm_apply]
    have h6 : q = (e ⟨z, hz⟩).asIdeal := congrArg PrimeSpectrum.asIdeal h5
    rw [h6]
  exact ⟨(e ⟨z, hz⟩).asIdeal, hmin, hmax⟩

theorem wcpa_dj_gs_fcp_tensor_nzd : ∀ (F K D : Type u) [Field F] [Field K] [Algebra F K] [CommRing D] [IsDomain D] [Algebra F D] (n : ℕ) (g : MvPolynomial (Fin n) F →ₐ[F] D), Function.Injective g → g.Finite → ∀ h : TensorProduct F (MvPolynomial (Fin n) F) K, h ≠ 0 → Algebra.TensorProduct.map g (AlgHom.id F K) h ∈ nonZeroDivisors (TensorProduct F D K) :=
by
  classical

  have s1 : ∀ (P M : Type u) [CommRing P] [IsDomain P] [AddCommGroup M] [Module P M]
      [Module.Finite P M], (∀ (p : P) (x : M), p ≠ 0 → p • x = 0 → x = 0) →
      ∃ (m : ℕ) (Φ : M →ₗ[P] (Fin m → P)), Function.Injective Φ := by
    intro P M _ _ _ _ _ htf
    obtain ⟨t, v, hv⟩ := Module.Finite.exists_fin (R := P) (M := M)
    obtain ⟨s, hli, hmax⟩ := exists_maximal_linearIndepOn P v
    choose! a ha hav using hmax
    set N := Submodule.span P (v '' s) with hN
    set T := Finset.univ.filter (fun i => i ∉ s) with hT
    set c := ∏ i ∈ T, a i with hc
    have hc0 : c ≠ 0 := by
      rw [hc, Finset.prod_ne_zero_iff]
      intro i hi
      exact ha i (Finset.mem_filter.mp hi).2
    have hcN : ∀ x : M, c • x ∈ N := by
      have hle : Submodule.span P (Set.range v) ≤ N.comap (c • LinearMap.id) := by
        rw [Submodule.span_le]
        rintro _ ⟨i, rfl⟩
        show c • v i ∈ N
        by_cases hi : i ∈ s
        · exact N.smul_mem c (Submodule.subset_span ⟨i, hi, rfl⟩)
        · have hiT : i ∈ T := Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi⟩
          rw [hc, ← Finset.prod_erase_mul T a hiT, mul_smul]
          exact N.smul_mem _ (hav i hi)
      intro x
      have hx : x ∈ Submodule.span P (Set.range v) := by rw [hv]; trivial
      exact hle hx
    have hli' : LinearIndependent P (fun x : s => v x) := hli.linearIndependent
    let b := Module.Basis.span hli'
    have hNeq : Submodule.span P (Set.range (fun x : s => v x)) = N := by
      rw [hN, Set.image_eq_range]
    let e : N ≃ₗ[P] (Fin (Nat.card s) → P) :=
      ((LinearEquiv.ofEq _ _ hNeq).symm.trans b.equivFun).trans
        (LinearEquiv.funCongrLeft P P (Finite.equivFin s).symm)
    let μ : M →ₗ[P] N := LinearMap.codRestrict N (c • LinearMap.id) (fun x => hcN x)
    have hμ : Function.Injective μ := by
      intro x y hxy
      have h1 : c • x = c • y := congrArg Subtype.val hxy
      have h2 : c • (x - y) = 0 := by rw [smul_sub, h1, sub_self]
      exact sub_eq_zero.mp (htf c _ hc0 h2)
    exact ⟨Nat.card s, e.toLinearMap ∘ₗ μ, e.injective.comp hμ⟩

  have s2 : ∀ (F K M N : Type u) [Field F] [Field K] [Algebra F K] [AddCommGroup M] [Module F M]
      [AddCommGroup N] [Module F N] (m : ℕ) (Φ : Fin m → (M →ₗ[F] N)),
      (∀ x : M, (∀ j, Φ j x = 0) → x = 0) → ∀ y : TensorProduct F M K,
      (∀ j, LinearMap.rTensor K (Φ j) y = 0) → y = 0 := by
    intro F K M N _ _ _ _ _ _ _ m Φ hΦ y hy
    let Ψ : M →ₗ[F] (Fin m → N) := LinearMap.pi Φ
    have hΨinj : Function.Injective Ψ := by
      rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
      intro x hx
      apply hΦ x
      intro j
      exact congrFun hx j
    have hinj := Module.Flat.rTensor_preserves_injective_linearMap (M := K) Ψ hΨinj
    have hcomp : ∀ j, LinearMap.proj j ∘ₗ Ψ = Φ j := fun j => by ext x; rfl
    have hdec : ∀ z : TensorProduct F (Fin m → N) K, z = ∑ j,
        LinearMap.rTensor K (LinearMap.single F (fun _ : Fin m => N) j)
          (LinearMap.rTensor K (LinearMap.proj j) z) := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul x k =>
        simp only [LinearMap.rTensor_tmul, LinearMap.proj_apply]
        rw [← TensorProduct.sum_tmul]
        congr 1
        simp only [LinearMap.single_apply]
        exact (Finset.univ_sum_single x).symm
      | add z1 z2 h1 h2 =>
        simp only [map_add, Finset.sum_add_distrib, ← h1, ← h2]
    have hpj : ∀ j, LinearMap.rTensor K (LinearMap.proj j) (LinearMap.rTensor K Ψ y) = 0 := by
      intro j
      rw [← LinearMap.comp_apply, ← LinearMap.rTensor_comp, hcomp j, hy j]
    have hz : LinearMap.rTensor K Ψ y = 0 := by
      rw [hdec (LinearMap.rTensor K Ψ y)]
      apply Finset.sum_eq_zero
      intro j _
      rw [hpj j, map_zero]
    exact hinj (hz.trans (map_zero _).symm)

  have s3 : ∀ (F K P D : Type u) [Field F] [Field K] [Algebra F K] [CommRing P] [Algebra F P]
      [CommRing D] [Algebra F D] (g : P →ₐ[F] D) (φ : D →ₗ[F] P),
      (∀ (p : P) (d : D), φ (g p * d) = p * φ d) → ∀ (h : TensorProduct F P K)
      (y : TensorProduct F D K),
      LinearMap.rTensor K φ (Algebra.TensorProduct.map g (AlgHom.id F K) h * y) =
        h * LinearMap.rTensor K φ y := by
    intro F K P D _ _ _ _ _ _ _ g φ hφ h y
    induction h using TensorProduct.induction_on with
    | zero => simp
    | tmul p a =>
      induction y using TensorProduct.induction_on with
      | zero => simp
      | tmul d b =>
        simp only [Algebra.TensorProduct.map_tmul, AlgHom.id_apply,
          Algebra.TensorProduct.tmul_mul_tmul, LinearMap.rTensor_tmul, hφ]
      | add y1 y2 hy1 hy2 => simp only [mul_add, map_add, hy1, hy2]
    | add h1 h2 ih1 ih2 => simp only [map_add, add_mul, ih1, ih2]

  have s4 : ∀ (F K : Type u) [Field F] [Field K] [Algebra F K] (n : ℕ),
      IsDomain (TensorProduct F (MvPolynomial (Fin n) F) K) := by
    intro F K _ _ _ n
    exact MulEquiv.isDomain (MvPolynomial (Fin n) K)
      ((Algebra.TensorProduct.comm F (MvPolynomial (Fin n) F) K).toRingEquiv.trans
        (MvPolynomial.algebraTensorAlgEquiv (σ := Fin n) F K).toRingEquiv).toMulEquiv

  intro F K D _ _ _ _ _ _ n g hinj hfin h hh
  haveI := s4 F K n
  letI : Algebra (MvPolynomial (Fin n) F) D := g.toRingHom.toAlgebra
  haveI : Module.Finite (MvPolynomial (Fin n) F) D := hfin
  have htf : ∀ (p : MvPolynomial (Fin n) F) (x : D), p ≠ 0 → p • x = 0 → x = 0 := by
    intro p x hp hpx
    rw [Algebra.smul_def] at hpx
    have hgp : g p ≠ 0 := fun h0 => hp (hinj (h0.trans (map_zero g).symm))
    exact (mul_eq_zero.mp hpx).resolve_left hgp
  obtain ⟨m, Φ, hΦ⟩ := s1 (MvPolynomial (Fin n) F) D htf
  let φ : Fin m → (D →ₗ[F] MvPolynomial (Fin n) F) := fun j =>
    { toFun := fun d => Φ d j
      map_add' := fun d1 d2 => by simp only [map_add, Pi.add_apply]
      map_smul' := fun c d => by
        have hcd : c • d = (algebraMap F (MvPolynomial (Fin n) F) c) • d := by
          rw [Algebra.smul_def (A := D) c d, Algebra.smul_def (algebraMap F _ c) d]
          show algebraMap F D c * d = g (algebraMap F _ c) * d
          rw [AlgHom.commutes]
        rw [hcd, map_smul, Pi.smul_apply, smul_eq_mul, RingHom.id_apply, Algebra.smul_def] }
  have hsemi : ∀ j p d, φ j (g p * d) = p * φ j d := by
    intro j p d
    show Φ (g p * d) j = p * Φ d j
    rw [show g p * d = p • d from (Algebra.smul_def p d).symm, map_smul]
    rfl
  have hjoint : ∀ x, (∀ j, φ j x = 0) → x = 0 := by
    intro x hx
    apply hΦ
    rw [map_zero]
    funext j
    exact hx j
  rw [mem_nonZeroDivisors_iff_right]
  intro y hy
  apply s2 F K D (MvPolynomial (Fin n) F) m φ hjoint y
  intro j
  have h1 := s3 F K _ D g (φ j) (hsemi j) h y
  rw [mul_comm (Algebra.TensorProduct.map g (AlgHom.id F K) h) y, hy, map_zero] at h1
  exact (mul_eq_zero.mp h1.symm).resolve_left hh

theorem wcpa_dj_gs_fcp_minmax_algebraic : (∀ (F K D : Type u) [Field F] [Field K] [Algebra F K] [CommRing D] [IsDomain D] [Algebra F D] (n : ℕ) (g : MvPolynomial (Fin n) F →ₐ[F] D), Function.Injective g → g.Finite → ∀ h : TensorProduct F (MvPolynomial (Fin n) F) K, h ≠ 0 → Algebra.TensorProduct.map g (AlgHom.id F K) h ∈ nonZeroDivisors (TensorProduct F D K)) → ∀ (F K D : Type u) [Field F] [Field K] [Algebra F K] [CommRing D] [IsDomain D] [Algebra F D] [Algebra.FiniteType F D] (Q : Ideal (TensorProduct F D K)), Q ∈ minimalPrimes (TensorProduct F D K) → Q.IsMaximal → Algebra.IsAlgebraic F D :=
by
  intro H F K D _ _ _ _ _ _ _ Q hQmin hQmax
  classical
  have := hQmax
  obtain ⟨s, g, hginj, hgfin⟩ := exists_finite_inj_algHom_of_fg F D
  rcases s with _ | n
  ·
    have hsurj : Function.Surjective (algebraMap F (MvPolynomial (Fin 0) F)) := by
      intro p
      refine ⟨MvPolynomial.isEmptyAlgEquiv F (Fin 0) p, ?_⟩
      have := (MvPolynomial.isEmptyAlgEquiv F (Fin 0)).symm.commutes
        (MvPolynomial.isEmptyAlgEquiv F (Fin 0) p)
      rw [← this, Algebra.algebraMap_self, RingHom.id_apply, AlgEquiv.symm_apply_apply]
    have hP : (algebraMap F (MvPolynomial (Fin 0) F)).Finite := RingHom.Finite.of_surjective _ hsurj
    have hcomp : algebraMap F D = (g : MvPolynomial (Fin 0) F →+* D).comp
        (algebraMap F (MvPolynomial (Fin 0) F)) :=
      RingHom.ext fun c => (g.commutes c).symm
    have hD : (algebraMap F D).Finite := by
      rw [hcomp]; exact RingHom.Finite.comp hgfin hP
    have : Module.Finite F D := RingHom.finite_algebraMap.mp hD
    exact Algebra.IsAlgebraic.of_finite F D
  · exfalso
    set gK := Algebra.TensorProduct.map g (AlgHom.id F K) with hgK
    have hgKfin : gK.Finite := RingHom.Finite.tensorProductMap hgfin (AlgHom.Finite.id F K)
    have hgKint : (gK : TensorProduct F (MvPolynomial (Fin (n+1)) F) K →+* TensorProduct F D K).IsIntegral :=
      RingHom.Finite.to_isIntegral hgKfin
    have hm : (Q.comap (gK : TensorProduct F (MvPolynomial (Fin (n+1)) F) K →+* TensorProduct F D K)).IsMaximal :=
      Ideal.isMaximal_comap_of_isIntegral_of_isMaximal _ hgKint Q
    let E : TensorProduct F (MvPolynomial (Fin (n+1)) F) K ≃+* Polynomial (MvPolynomial (Fin n) K) :=
      ((Algebra.TensorProduct.comm F (MvPolynomial (Fin (n+1)) F) K).toRingEquiv.trans
        (MvPolynomial.algebraTensorAlgEquiv F K (σ := Fin (n+1))).toRingEquiv).trans
        (MvPolynomial.finSuccEquiv K n).toRingEquiv
    have : Nontrivial (TensorProduct F (MvPolynomial (Fin (n+1)) F) K) := E.toEquiv.nontrivial
    have hnf : ¬ IsField (TensorProduct F (MvPolynomial (Fin (n+1)) F) K) := by
      intro hf
      exact Polynomial.not_isField (MvPolynomial (Fin n) K) (MulEquiv.isField hf E.symm.toMulEquiv)
    have hne := Ring.ne_bot_of_isMaximal_of_not_isField hm hnf
    obtain ⟨h, hh, hh0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
    have hnzd := H F K D (n+1) g hginj hgfin h hh0
    have hQ : gK h ∈ Q := Ideal.mem_comap.mp hh
    exact Set.disjoint_left.mp (Ideal.disjoint_nonZeroDivisors_of_mem_minimalPrimes hQmin) hQ hnzd

theorem wcpa_dj_gs_fcp_minmax_descend : (∀ (F K D : Type u) [Field F] [Field K] [Algebra F K] [CommRing D] [IsDomain D] [Algebra F D] [Algebra.FiniteType F D] (Q : Ideal (TensorProduct F D K)), Q ∈ minimalPrimes (TensorProduct F D K) → Q.IsMaximal → Algebra.IsAlgebraic F D) → ∀ (F C K : Type u) [Field F] [CommRing C] [Algebra F C] [Algebra.FiniteType F C] [Field K] [Algebra F K] (Q : Ideal (TensorProduct F C K)), Q ∈ minimalPrimes (TensorProduct F C K) → Q.IsMaximal → Q.comap (Algebra.TensorProduct.includeLeftRingHom : C →+* TensorProduct F C K) ∈ minimalPrimes C ∧ (Q.comap (Algebra.TensorProduct.includeLeftRingHom : C →+* TensorProduct F C K)).IsMaximal :=
by
  intro H F C K _ _ _ _ _ _ Q hQmin hQmax
  classical
  have hQp : Q.IsPrime := hQmax.isPrime
  set q : Ideal C := Q.comap (Algebra.TensorProduct.includeLeftRingHom : C →+* TensorProduct F C K)
    with hq
  have hqp : q.IsPrime := Ideal.comap_isPrime _ Q
  have hmin : q ∈ minimalPrimes C := by
    refine ⟨⟨hqp, bot_le⟩, ?_⟩
    rintro p ⟨hpp, -⟩ hpq
    have : Q.LiesOver q := ⟨rfl⟩
    have hfree : Module.Free F K := Module.Free.of_divisionRing F K
    have hflat : Module.Flat F K := Module.Flat.of_free
    have : Module.Flat C (TensorProduct F C K) := @Module.Flat.baseChange F C K _ _ _ _ _ hflat
    have : Algebra.HasGoingDown C (TensorProduct F C K) := Algebra.HasGoingDown.of_flat
    obtain ⟨P, hPQ, hPp, hPl⟩ :=
      Ideal.exists_ideal_le_liesOver_of_le (S := TensorProduct F C K) Q hpq
    have hQP : Q ≤ P := hQmin.2 ⟨hPp, bot_le⟩ hPQ
    rw [hPl.over]
    exact Ideal.comap_mono hQP
  refine ⟨hmin, ?_⟩
  have : Algebra.FiniteType F (C ⧸ q) :=
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ F q)
      (Ideal.Quotient.mkₐ_surjective F q)
  let π : TensorProduct F C K →ₐ[F] TensorProduct F (C ⧸ q) K :=
    Algebra.TensorProduct.map (Ideal.Quotient.mkₐ F q) (AlgHom.id F K)
  have hπs : Function.Surjective π :=
    Algebra.TensorProduct.map_surjective (Ideal.Quotient.mkₐ F q) (AlgHom.id F K)
      (Ideal.Quotient.mkₐ_surjective F q) Function.surjective_id
  have hker : RingHom.ker π ≤ Q := by
    have h1 := Algebra.TensorProduct.rTensor_ker (R := F) (S := F) (C := K)
      (Ideal.Quotient.mkₐ F q) (Ideal.Quotient.mkₐ_surjective F q)
    have h2 : RingHom.ker π = RingHom.ker (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ F q)
      (AlgHom.id F K)) := rfl
    rw [h2, h1, Ideal.map_le_iff_le_comap]
    intro c hc
    rw [RingHom.mem_ker, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem] at hc
    exact hc
  have hcm : Ideal.comap π (Ideal.map π Q) = Q := by
    rw [Ideal.comap_map_of_surjective' π hπs Q]
    exact sup_eq_left.mpr hker
  have hQ'max : (Ideal.map π Q).IsMaximal := by
    rcases Ideal.map_eq_top_or_isMaximal_of_surjective π hπs hQmax with h | h
    · exfalso
      apply hQmax.ne_top
      rw [← hcm, h, Ideal.comap_top]
    · exact h
  have hQ'min : Ideal.map π Q ∈ minimalPrimes (TensorProduct F (C ⧸ q) K) := by
    refine ⟨⟨hQ'max.isPrime, bot_le⟩, ?_⟩
    rintro P' ⟨hP'p, -⟩ hP'Q
    have h1 : Ideal.comap π P' ≤ Q := hcm ▸ Ideal.comap_mono hP'Q
    have h2 : Q ≤ Ideal.comap π P' := hQmin.2 ⟨Ideal.comap_isPrime π P', bot_le⟩ h1
    calc Ideal.map π Q ≤ Ideal.map π (Ideal.comap π P') := Ideal.map_mono h2
      _ = P' := Ideal.map_comap_of_surjective π hπs P'
  have halg : Algebra.IsAlgebraic F (C ⧸ q) := H F K (C ⧸ q) (Ideal.map π Q) hQ'min hQ'max
  have : Algebra.IsIntegral F (C ⧸ q) := Algebra.IsAlgebraic.isIntegral
  exact Ideal.Quotient.maximal_of_isField q
    (isField_of_isIntegral_of_isField' (R := F) (Field.toIsField F))

theorem wcpa_dj_gs_fcp_quasiFiniteAt : (∀ (F C K : Type u) [Field F] [CommRing C] [Algebra F C] [Algebra.FiniteType F C] [Field K] [Algebra F K] (Q : Ideal (TensorProduct F C K)), Q ∈ minimalPrimes (TensorProduct F C K) → Q.IsMaximal → Q.comap (Algebra.TensorProduct.includeLeftRingHom : C →+* TensorProduct F C K) ∈ minimalPrimes C ∧ (Q.comap (Algebra.TensorProduct.includeLeftRingHom : C →+* TensorProduct F C K)).IsMaximal) → (∀ (C : Type u) [CommRing C] [IsNoetherianRing C] (q : PrimeSpectrum C), q.asIdeal ∈ minimalPrimes C → q.asIdeal.IsMaximal → IsOpen ({q} : Set (PrimeSpectrum C))) → ∀ (R A K : Type u) [CommRing R] [CommRing A] [Algebra R A] [Algebra.FiniteType R A] [Field K] (ψ : R →+* K), letI := ψ.toAlgebra; ∀ Q : Ideal (TensorProduct R A K), Q ∈ minimalPrimes (TensorProduct R A K) → Q.IsMaximal → ∃ (q : Ideal A) (hq : q.IsPrime), @Algebra.QuasiFiniteAt R A _ _ _ q hq :=
by
  intro H1 H2 R A K _ _ _ _ _ ψ
  letI := ψ.toAlgebra
  intro Q hQmin hQmax

  have key : ∀ (B B' : Type u) [CommRing B] [CommRing B'] (e : B ≃+* B') (Q : Ideal B'),
      Q ∈ minimalPrimes B' → Q.IsMaximal →
        Q.comap e.toRingHom ∈ minimalPrimes B ∧ (Q.comap e.toRingHom).IsMaximal := by
    intro B B' _ _ e Q hQ hQm
    have hs : Function.Surjective e.toRingHom := e.surjective
    refine ⟨?_, ?_⟩
    · have h := Ideal.minimalPrimes_comap_of_surjective hs (I := ⊥) hQ
      rwa [Ideal.comap_bot_of_injective e.toRingHom e.injective] at h
    · exact Ideal.comap_isMaximal_of_surjective e.toRingHom hs
  have hpp : (RingHom.ker ψ).IsPrime := RingHom.ker_isPrime ψ
  set p : Ideal R := RingHom.ker ψ with hp

  have hf₂ : p.primeCompl ≤ Submonoid.comap ψ (IsUnit.submonoid K) := by
    intro r hr
    rw [Submonoid.mem_comap, IsUnit.mem_submonoid_iff]
    refine isUnit_iff_ne_zero.mpr ?_
    intro h
    exact hr (RingHom.mem_ker.mpr h)
  let l : p.ResidueField →+* K := Ideal.ResidueField.lift p ψ le_rfl hf₂
  letI : Algebra p.ResidueField K := l.toAlgebra
  haveI : IsScalarTower R p.ResidueField K := IsScalarTower.of_algebraMap_eq' (by
    ext r
    exact (Ideal.ResidueField.lift_algebraMap p ψ le_rfl hf₂ r).symm)

  let e₀ := Algebra.TensorProduct.comm p.ResidueField (p.Fiber A) K
  let e₁ := Algebra.TensorProduct.cancelBaseChange R p.ResidueField K K A
  let e₂ := Algebra.TensorProduct.comm R K A
  let Θ : TensorProduct p.ResidueField (p.Fiber A) K ≃+* TensorProduct R A K :=
    e₀.toRingEquiv.trans (e₁.toRingEquiv.trans e₂.toRingEquiv)

  obtain ⟨hQCmin, hQCmax⟩ := key (TensorProduct p.ResidueField (p.Fiber A) K)
    (TensorProduct R A K) Θ Q hQmin hQmax

  obtain ⟨hqmin, hqmax⟩ := H1 p.ResidueField (p.Fiber A) K _ hQCmin hQCmax
  set qb : Ideal (p.Fiber A) := (Q.comap Θ.toRingHom).comap
    (Algebra.TensorProduct.includeLeftRingHom : p.Fiber A →+* TensorProduct p.ResidueField (p.Fiber A) K) with hqb
  haveI hqbp : qb.IsPrime := hqmax.isPrime

  haveI : IsNoetherianRing (p.Fiber A) := Algebra.FiniteType.isNoetherianRing p.ResidueField _
  have hopen := H2 (p.Fiber A) ⟨qb, hqbp⟩ hqmin hqmax

  haveI hqf : Algebra.QuasiFiniteAt p.ResidueField qb :=
    Algebra.QuasiFiniteAt.of_isOpen_singleton (⟨qb, hqbp⟩ : PrimeSpectrum (p.Fiber A)) hopen

  have hlo : ∀ (Q' : Ideal (p.Fiber A)), Q'.IsPrime →
      (Q'.comap (Algebra.TensorProduct.includeRight : A →ₐ[R] p.Fiber A).toRingHom).LiesOver p := by
    intro Q' hQ'
    rw [Ideal.liesOver_iff, Ideal.under_def, Ideal.comap_comap]
    have h1 : ((Algebra.TensorProduct.includeRight : A →ₐ[R] p.Fiber A).toRingHom).comp
        (algebraMap R A) = algebraMap R (p.Fiber A) := by
      first
        | exact AlgHom.comp_algebraMap _
        | (ext r; exact (Algebra.TensorProduct.includeRight : A →ₐ[R] p.Fiber A).commutes r)
    rw [h1, IsScalarTower.algebraMap_eq R p.ResidueField (p.Fiber A), ← Ideal.comap_comap]
    have h2 : Q'.comap (algebraMap p.ResidueField (p.Fiber A)) = ⊥ :=
      (Ideal.eq_bot_or_top _).resolve_right (Ideal.comap_ne_top _ hQ'.ne_top)
    rw [h2, ← RingHom.ker_eq_comap_bot, Ideal.ker_algebraMap_residueField]
  haveI hqp : (qb.comap (Algebra.TensorProduct.includeRight : A →ₐ[R] p.Fiber A).toRingHom).IsPrime :=
    Ideal.IsPrime.comap _
  haveI := hlo qb hqbp
  exact ⟨_, hqp, Algebra.QuasiFiniteAt.of_quasiFiniteAt_residueField p _ qb rfl⟩

theorem wcpa_dj_gs_fcp_algebraic_to_generic : ∀ (X S : Scheme.{u}) [AlgebraicGeometry.IsIntegral X] [AlgebraicGeometry.IsIntegral S] (f : X ⟶ S) (h : f (genericPoint X) ⤳ genericPoint S) (V : S.Opens) (U : X.Opens), IsAffineOpen V → IsAffineOpen U → ∀ (hUV : U ≤ f ⁻¹ᵁ V), (U : Set X).Nonempty → (letI := (f.appLE V U hUV).hom.toAlgebra; Algebra.IsAlgebraic Γ(S, V) Γ(X, U)) → (letI := (S.presheaf.stalkSpecializes h ≫ f.stalkMap (genericPoint X)).hom.toAlgebra; Algebra.IsAlgebraic (S.presheaf.stalk (genericPoint S)) (X.presheaf.stalk (genericPoint X))) :=
by
  intro X S _ _ f h V U hV hU hUV hUne hAlg
  have hx : genericPoint X ∈ U :=
    ((genericPoint_spec X).mem_open_set_iff U.isOpen).mpr (by simpa using hUne)
  have hy : genericPoint S ∈ V := by
    have hfx : f (genericPoint X) ∈ V := hUV hx
    exact ((genericPoint_spec S).mem_open_set_iff V.isOpen).mpr ⟨_, trivial, hfx⟩
  have hsq : S.presheaf.germ V _ hy ≫ S.presheaf.stalkSpecializes h ≫
      f.stalkMap (genericPoint X) = f.appLE V U hUV ≫ X.presheaf.germ U _ hx := by
    rw [TopCat.Presheaf.germ_stalkSpecializes_assoc, Scheme.Hom.germ_stalkMap,
      Scheme.Hom.appLE, Category.assoc, TopCat.Presheaf.germ_res]
  have hinj : Function.Injective (S.presheaf.germ V _ hy).hom :=
    germ_injective_of_isIntegral S _ hy
  letI iRA := (f.appLE V U hUV).hom.toAlgebra
  letI iKK := (S.presheaf.stalkSpecializes h ≫ f.stalkMap (genericPoint X)).hom.toAlgebra
  have hcomp : (algebraMap (S.presheaf.stalk (genericPoint S))
      (X.presheaf.stalk (genericPoint X))).comp (S.presheaf.germ V _ hy).hom =
      (X.presheaf.germ U _ hx).hom.comp (algebraMap Γ(S, V) Γ(X, U)) := by
    ext r
    exact congrArg (fun g => g.hom r) hsq
  have hC : ∀ a : Γ(X, U), IsAlgebraic (S.presheaf.stalk (genericPoint S))
      ((X.presheaf.germ U _ hx).hom a) := by
    intro a
    obtain ⟨p, hp0, hpa⟩ := hAlg.isAlgebraic a
    refine ⟨p.map (S.presheaf.germ V _ hy).hom, (Polynomial.map_ne_zero_iff hinj).mpr hp0, ?_⟩
    rw [Polynomial.aeval_def] at hpa
    rw [Polynomial.aeval_def, Polynomial.eval₂_map, hcomp, ← Polynomial.hom_eval₂, hpa, map_zero]
  haveI : Nonempty U := ⟨⟨_, hx⟩⟩
  haveI hfrac : IsFractionRing Γ(X, U) X.functionField :=
    functionField_isFractionRing_of_isAffineOpen X U hU
  constructor
  intro ξ
  obtain ⟨⟨a, b⟩, hab⟩ := IsLocalization.surj (nonZeroDivisors Γ(X, U)) (ξ : X.functionField)
  have hb : algebraMap Γ(X, U) X.functionField b ≠ 0 :=
    IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors b.2
  have hξ : ξ = algebraMap Γ(X, U) X.functionField a *
      (algebraMap Γ(X, U) X.functionField b)⁻¹ := by
    rw [← hab, mul_inv_cancel_right₀ hb]
  rw [hξ]
  exact (hC a).mul (hC b).inv

theorem wcpa_dj_gs_fibre_components_pos : ∀ (k : Type u) [Field k] (X S : Scheme.{u}) [AlgebraicGeometry.IsIntegral X] [AlgebraicGeometry.IsIntegral S] (sS : S ⟶ Spec (.of k)) [IsProper sS] (f : X ⟶ S) [IsProper f] (d : ℕ), topologicalKrullDim S = (d : WithBot ℕ∞) → topologicalKrullDim X = ((d + 1 : ℕ) : WithBot ℕ∞) → Surjective f → ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ S), ∀ Z ∈ irreducibleComponents ↥(Limits.pullback f s), ¬ topologicalKrullDim ↥Z ≤ ((0 : ℕ) : WithBot ℕ∞) :=
by
  intro k _ X S _ _ sS _ f _ d hS hX hf K _ _ s Z hZ hZ0
  classical

  have hT1 : ∀ (T : Type u) [TopologicalSpace T] [QuasiSober T] [T0Space T] (Z : Set T),
      Z ∈ irreducibleComponents T → topologicalKrullDim ↥Z ≤ ((0 : ℕ) : WithBot ℕ∞) →
      ∃ z : T, Z = {z} ∧ IsClosed ({z} : Set T) ∧ ∀ z' : T, z' ⤳ z → z' = z := by
    intro T _ _ _ Z hZ hZ0
    have hZirr : IsIrreducible Z := hZ.prop
    have hZcl : IsClosed Z := isClosed_of_mem_irreducibleComponents Z hZ
    have hzgen : IsGenericPoint hZirr.genericPoint Z := by
      have := hZirr.isGenericPoint_genericPoint_closure
      rwa [hZcl.closure_eq] at this
    set z := hZirr.genericPoint with hzdef
    have hclZ : ∀ y : Z, IsClosed ({y} : Set Z) := by
      have h0 : Order.krullDim (TopologicalSpace.IrreducibleCloseds Z) ≤ 0 := by
        have h' : topologicalKrullDim Z ≤ 0 := by simpa using hZ0
        exact h'
      have hmin := Order.krullDim_nonpos_iff_forall_isMin.mp h0
      intro x
      apply closure_subset_iff_isClosed.mp
      intro y hy
      have hxy : x ⤳ y := specializes_iff_mem_closure.mpr hy
      let c : TopologicalSpace.IrreducibleCloseds Z :=
        ⟨closure {x}, isIrreducible_singleton.closure, isClosed_closure⟩
      let e : TopologicalSpace.IrreducibleCloseds Z :=
        ⟨closure {y}, isIrreducible_singleton.closure, isClosed_closure⟩
      have hdc : e ≤ c := by
        show (closure {y} : Set Z) ⊆ closure {x}
        exact hxy.closure_subset
      have hcd : c ≤ e := hmin c hdc
      have hcd' : (closure {x} : Set Z) ⊆ closure {y} := hcd
      have heq : closure ({x} : Set Z) = closure {y} :=
        Set.Subset.antisymm hcd' hxy.closure_subset
      have hins : Inseparable x y := inseparable_iff_closure_eq.mpr heq
      exact Set.mem_singleton_iff.mpr hins.eq.symm
    have hZeq : Z = {z} := by
      ext w
      constructor
      · intro hw
        have hzw : z ⤳ w := hzgen.specializes hw
        have h1 : (⟨z, hzgen.mem⟩ : Z) ⤳ ⟨w, hw⟩ := (subtype_specializes_iff _ _).mpr hzw
        have h2 := h1.mem_closed (hclZ ⟨z, hzgen.mem⟩) rfl
        rw [Set.mem_singleton_iff] at h2 ⊢
        exact congrArg Subtype.val h2
      · intro hw
        rw [Set.mem_singleton_iff.mp hw]
        exact hzgen.mem
    refine ⟨z, hZeq, hZeq ▸ hZcl, ?_⟩
    intro z' hz'
    have h1 : Z ⊆ closure {z'} := by
      rw [hZeq]
      exact Set.singleton_subset_iff.mpr (specializes_iff_mem_closure.mp hz')
    have h2 := hZ.2 isIrreducible_singleton.closure h1
    have h3 : z' ∈ Z := h2 (subset_closure rfl)
    rw [hZeq] at h3
    exact h3
  obtain ⟨z, -, hzcl, hzgen⟩ := hT1 _ Z hZ hZ0

  obtain ⟨V, U, hV, hU, hUV, ψ, hUne, hQ⟩ :=
    wcpa_dj_gs_fcp_affine_chart X S f K s z hzcl hzgen
  letI := (f.appLE V U hUV).hom.toAlgebra
  letI := ψ.toAlgebra
  obtain ⟨Q, hQmin, hQmax⟩ := hQ
  haveI : Nonempty U := ⟨⟨hUne.some, hUne.some_mem⟩⟩
  haveI : Nonempty V := ⟨⟨f hUne.some, hUV hUne.some_mem⟩⟩
  haveI hft : Algebra.FiniteType Γ(S, V) Γ(X, U) :=
    HasRingHomProperty.appLE @LocallyOfFiniteType f inferInstance ⟨V, hV⟩ ⟨U, hU⟩ hUV

  have hN4 : ∀ (C : Type u) [CommRing C] [IsNoetherianRing C] (q : PrimeSpectrum C),
      q.asIdeal ∈ minimalPrimes C → q.asIdeal.IsMaximal → IsOpen ({q} : Set (PrimeSpectrum C)) := by
    intro C _ _ q hqmin hqmax
    have hfin : (minimalPrimes C).Finite := minimalPrimes.finite_of_isNoetherianRing C
    have heq : ({q} : Set (PrimeSpectrum C)) =
        (⋃ q' ∈ minimalPrimes C \ {q.asIdeal}, PrimeSpectrum.zeroLocus (q' : Set C))ᶜ := by
      ext P
      simp only [Set.mem_singleton_iff, Set.mem_compl_iff, Set.mem_iUnion, Set.mem_diff,
        PrimeSpectrum.mem_zeroLocus, not_exists, not_and, exists_prop]
      constructor
      · rintro rfl q' ⟨hq'min, hq'ne⟩ hle
        apply hq'ne
        exact le_antisymm hle (hqmin.2 ⟨hq'min.1.1, bot_le⟩ hle)
      · intro H
        obtain ⟨q'', hq''min, hq''le⟩ :=
          Ideal.exists_minimalPrimes_le (bot_le : (⊥ : Ideal C) ≤ P.asIdeal)
        by_cases hq'' : q'' = q.asIdeal
        · rw [hq''] at hq''le
          ext1
          exact (hqmax.eq_of_le P.isPrime.ne_top hq''le).symm
        · exact absurd hq''le (H q'' ⟨hq''min, hq''⟩)
    rw [heq, isOpen_compl_iff]
    exact hfin.sdiff.isClosed_biUnion (fun _ _ => PrimeSpectrum.isClosed_zeroLocus _)

  obtain ⟨q, hq, hqf⟩ := wcpa_dj_gs_fcp_quasiFiniteAt
    (wcpa_dj_gs_fcp_minmax_descend (wcpa_dj_gs_fcp_minmax_algebraic wcpa_dj_gs_fcp_tensor_nzd))
    hN4 Γ(S, V) Γ(X, U) K ψ Q hQmin hQmax

  have hR : Algebra.IsAlgebraic Γ(S, V) Γ(X, U) := by
    haveI := hq
    haveI := hqf
    obtain ⟨r, hrq, hr, hx⟩ := Algebra.zariskisMainProperty_iff.mp
      (Algebra.ZariskisMainProperty.of_finiteType (R := Γ(S, V)) q)
    have hr0 : r ≠ 0 := fun h => hrq (h ▸ q.zero_mem)
    constructor
    intro x
    obtain ⟨m, hm⟩ := hx x
    exact IsAlgebraic.of_mul (mem_nonZeroDivisors_of_ne_zero (pow_ne_zero m hr0))
      (hr.pow m).isAlgebraic hm.isAlgebraic

  obtain ⟨x₀, hx₀⟩ := f.surjective (genericPoint S)
  have h : f (genericPoint X) ⤳ genericPoint S := by
    rw [← hx₀]
    exact ((genericPoint_spec X).specializes (Set.mem_univ x₀)).map f.continuous

  have hG := wcpa_dj_gs_fcp_algebraic_to_generic X S f h V U hV hU hUV hUne hR

  have hηS : genericPoint S ∈ (⊤ : S.Opens) := trivial
  have hηX : genericPoint X ∈ (⊤ : X.Opens) := trivial
  have key : S.presheaf.germ ⊤ (genericPoint S) hηS ≫ S.presheaf.stalkSpecializes h ≫
      f.stalkMap (genericPoint X) = f.appTop ≫ X.presheaf.germ ⊤ (genericPoint X) hηX := by
    rw [TopCat.Presheaf.germ_stalkSpecializes_assoc]
    rw [Scheme.Hom.germ_stalkMap]
    rfl
  letI iL : Algebra k (S.presheaf.stalk (genericPoint S)) :=
    ((Scheme.ΓSpecIso (.of k)).inv ≫ sS.appTop ≫
      S.presheaf.germ ⊤ (genericPoint S) trivial).hom.toAlgebra
  letI iM : Algebra k (X.presheaf.stalk (genericPoint X)) :=
    ((Scheme.ΓSpecIso (.of k)).inv ≫ (f ≫ sS).appTop ≫
      X.presheaf.germ ⊤ (genericPoint X) trivial).hom.toAlgebra
  letI iLM : Algebra (S.presheaf.stalk (genericPoint S)) (X.presheaf.stalk (genericPoint X)) :=
    (S.presheaf.stalkSpecializes h ≫ f.stalkMap (genericPoint X)).hom.toAlgebra
  have hmor : ((Scheme.ΓSpecIso (.of k)).inv ≫ sS.appTop ≫
      S.presheaf.germ ⊤ (genericPoint S) trivial) ≫
      (S.presheaf.stalkSpecializes h ≫ f.stalkMap (genericPoint X)) =
      (Scheme.ΓSpecIso (.of k)).inv ≫ (f ≫ sS).appTop ≫
        X.presheaf.germ ⊤ (genericPoint X) trivial := by
    rw [Scheme.Hom.comp_appTop]
    simp only [Category.assoc]
    exact congrArg (fun g => (Scheme.ΓSpecIso (.of k)).inv ≫ sS.appTop ≫ g) key
  haveI : IsScalarTower k (S.presheaf.stalk (genericPoint S))
      (X.presheaf.stalk (genericPoint X)) :=
    IsScalarTower.of_algebraMap_eq (fun c => (congrArg (fun g => g.hom c) hmor).symm)
  obtain ⟨-, nS, tS, htS, hdS⟩ := wcpa_dj_cf_sp_function_field_trdeg k S sS
  obtain ⟨-, nX, tX, htX, hdX⟩ := wcpa_dj_cf_sp_function_field_trdeg k X (f ≫ sS)
  have hnS : nS = d := by
    have h1 := hdS.symm.trans hS
    exact_mod_cast h1
  have hnX : nX = d + 1 := by
    have h1 := hdX.symm.trans hX
    exact_mod_cast h1
  have cS : Algebra.trdeg k (S.presheaf.stalk (genericPoint S)) = (nS : Cardinal) := by
    have h1 := htS.lift_cardinalMk_eq_trdeg
    simp only [Cardinal.mk_fin, Cardinal.lift_natCast, Cardinal.lift_uzero] at h1
    exact h1.symm
  have cX : Algebra.trdeg k (X.presheaf.stalk (genericPoint X)) = (nX : Cardinal) := by
    have h1 := htX.lift_cardinalMk_eq_trdeg
    simp only [Cardinal.mk_fin, Cardinal.lift_natCast, Cardinal.lift_uzero] at h1
    exact h1.symm
  have hadd := trdeg_add_eq k (S.presheaf.stalk (genericPoint S))
    (A := X.presheaf.stalk (genericPoint X))
  rw [cS, cX, hnS, hnX, Nat.cast_add, Nat.cast_one, add_comm (d : Cardinal),
    add_comm (d : Cardinal) 1] at hadd
  have ht : Algebra.trdeg (S.presheaf.stalk (genericPoint S))
      (X.presheaf.stalk (genericPoint X)) = 1 :=
    (Cardinal.add_right_inj_of_lt_aleph0 (Cardinal.natCast_lt_aleph0)).mp hadd
  have h0 : Algebra.trdeg (S.presheaf.stalk (genericPoint S))
      (X.presheaf.stalk (genericPoint X)) = 0 := trdeg_eq_zero_iff.mpr hG
  rw [ht] at h0
  exact one_ne_zero h0

theorem wcpa_dj_cf_gs_upgrade : ∀ (k : Type u) [Field k] [Finite k] (X : Scheme.{u})
    [AlgebraicGeometry.IsIntegral X] (sX : X ⟶ Spec (.of k)) [IsProper sX] (d : ℕ),
    topologicalKrullDim X = ((d + 1 : ℕ) : WithBot ℕ∞) →
    ∀ (X₀ P₀ : Scheme.{u}) [AlgebraicGeometry.IsIntegral X₀] [AlgebraicGeometry.IsIntegral P₀]
      (α₀ : X₀ ⟶ X) (sP₀ : P₀ ⟶ Spec (.of k)) (f₀ : X₀ ⟶ P₀),
      f₀ ≫ sP₀ = α₀ ≫ sX → wcpaDjIsProjOver k (α₀ ≫ sX) → wcpaDjIsProjOver k sP₀ →
      IsProper α₀ → Surjective α₀ → (∃ V : X.Opens, V ≠ ⊥ ∧ IsFinite (α₀ ∣_ V)) →
      topologicalKrullDim P₀ = (d : WithBot ℕ∞) →
      ∀ U₀ : P₀.Opens, U₀ ≠ ⊥ → SmoothOfRelativeDimension 1 (f₀ ∣_ U₀) →
        GeometricallyConnected (f₀ ∣_ U₀) →
    ∃ (X₁ P : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral X₁) (_ : AlgebraicGeometry.IsIntegral P)
      (α : X₁ ⟶ X) (sP : P ⟶ Spec (.of k)) (f : X₁ ⟶ P),
      f ≫ sP = α ≫ sX ∧ wcpaDjIsProjOver k (α ≫ sX) ∧ wcpaDjIsProjOver k sP ∧
      IsProper α ∧ Surjective α ∧ (∃ V : X.Opens, V ≠ ⊥ ∧ IsFinite (α ∣_ V)) ∧
      topologicalKrullDim P = (d : WithBot ℕ∞) ∧
      ∃ U : P.Opens, U ≠ ⊥ ∧ SmoothOfRelativeDimension 1 (f ∣_ U) ∧
        GeometricallyConnected (f ∣_ U) ∧
        wcpaDjGS f :=
by
  intro k _ _ X _ sX _ d hX _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
  classical

  obtain ⟨X', iX', α₀, hP0, hα₀p, hα₀s, V₀, hV₀, hV₀iso⟩ := wcpa_dj_sgf_chow_birational k X sX
  haveI := iX'
  haveI := hα₀p
  haveI hsX' : IsProper (α₀ ≫ sX) := wcpa_dj_proj_proper k _ hP0
  have hα₀f : ∃ V : X.Opens, V ≠ ⊥ ∧ IsFinite (α₀ ∣_ V) :=
    ⟨V₀, hV₀, by haveI := hV₀iso; infer_instance⟩
  have hX' : topologicalKrullDim X' = ((d + 1 : ℕ) : WithBot ℕ∞) :=
    (wcpa_dj_alteration_dim_eq k X' X (α₀ ≫ sX) sX α₀ rfl hα₀s hα₀f).trans hX

  obtain ⟨k', iFk', iAk', iFDk', Y', iY', c, t, π, y₀, e, W, hcfin, hcsurj, htc, hPt, hY'd,
    hπfin, hπt, hy₀, heπ, hW, hWet⟩ :=
    wcpa_dj_gs_generic_projection k X' (α₀ ≫ sX) (d + 1) hP0 hX' (by omega)
  haveI := iY'
  haveI := hcfin
  haveI : Finite k' := Module.finite_of_finite k
  haveI htp : IsProper t := wcpa_dj_proj_proper k' t hPt

  obtain ⟨Y₁, iY₁, a₁, g, σ, ha₁p, ha₁s, ha₁f, hga, hPa, hσ, hσsm, hFD1, hGSP⟩ :=
    wcpa_dj_gs_blowup_fibration k' Y' t d π y₀ e W hPt hY'd hπfin hπt hy₀ heπ hW hWet
  haveI := iY₁
  haveI := ha₁p
  haveI hsQ : IsProper (wcProjKStr k' d) := wc_proj_space_isProper k' d
  haveI hQsm : SmoothOfRelativeDimension d (wcProjKStr k' d) := wc_proj_space_smooth k' d
  haveI : Smooth (wcProjKStr k' d) := SmoothOfRelativeDimension.smooth d _
  haveI hQirr : IrreducibleSpace (wcProjK k' d) := wc_proj_space_irreducible k' d
  have hQnorm : ∀ p : wcProjK k' d, IsDomain ((wcProjK k' d).presheaf.stalk p) ∧
      IsIntegrallyClosed ((wcProjK k' d).presheaf.stalk p) :=
    fun p => wc_fntame_smooth_stalk_normal k' (wcProjK k' d) (wcProjKStr k' d) p
  haveI : ∀ p : wcProjK k' d, _root_.IsReduced ((wcProjK k' d).presheaf.stalk p) := fun p => by
    haveI := (hQnorm p).1
    infer_instance
  haveI : AlgebraicGeometry.IsReduced (wcProjK k' d) := isReduced_of_isReduced_stalk _
  haveI iQ : AlgebraicGeometry.IsIntegral (wcProjK k' d) :=
    isIntegral_of_irreducibleSpace_of_isReduced _
  haveI : IsLocallyNoetherian (wcProjK k' d) :=
    LocallyOfFiniteType.isLocallyNoetherian (wcProjKStr k' d)
  have hE0 : wcpaDjIsProjOver k' (wcProjKStr k' d) := ⟨d, 𝟙 _, inferInstance, Category.id_comp _⟩
  haveI hYt : IsProper (a₁ ≫ t) := wcpa_dj_proj_proper k' _ hPa
  haveI hgsQ : IsProper (g ≫ wcProjKStr k' d) := by rw [hga]; exact hYt
  haveI hgp : IsProper g := IsProper.of_comp g (wcProjKStr k' d)
  have hY₁d : topologicalKrullDim Y₁ = ((d + 1 : ℕ) : WithBot ℕ∞) :=
    (wcpa_dj_alteration_dim_eq k' Y₁ Y' (a₁ ≫ t) t a₁ rfl ha₁s ha₁f).trans hY'd

  obtain ⟨hGI, hGR⟩ := wcpa_dj_gs_section_geom_integral Y₁ (wcProjK k' d) g σ hσ hσsm

  have hPg : wcpaDjIsProjOver k' (g ≫ wcProjKStr k' d) := by rw [hga]; exact hPa
  obtain ⟨m₀, hm₀⟩ := wcpa_dj_sgf_generic_smooth k' Y₁ (wcProjK k' d) (wcProjKStr k' d) g d hPg
    hE0 (wc_proj_space_dim k' d) hY₁d hGI hGR
  obtain ⟨Φ, hΦfin, hΦfrob, hΦs⟩ := wcpa_dj_sgf_frobenius_k k' (wcProjK k' d) (wcProjKStr k' d) m₀
  obtain ⟨R, iR, r, hrci, hrs, hrffin, hrfs⟩ := wcpa_dj_sgf_twist_reduced_integral k' Y₁
    (wcProjK k' d) (wcProjKStr k' d) g Φ m₀ hΦfin hΦfrob hΦs
  haveI := iR
  haveI := hrffin
  haveI := hrfs
  haveI := hrs
  haveI := hrci
  haveI hsR : IsProper ((r ≫ Limits.pullback.fst g Φ) ≫ a₁ ≫ t) := inferInstance
  obtain ⟨Xt, iXt, b, hbfin, hbs, hbnorm, hbU⟩ :=
    wcpa_dj_sgf_normalization k' R ((r ≫ Limits.pullback.fst g Φ) ≫ a₁ ≫ t)
  haveI := iXt
  haveI := hbfin
  haveI := hbs
  obtain ⟨hsm1, hgc1⟩ := hm₀ m₀ le_rfl Φ hΦfin hΦfrob hΦs R r hrci hrs Xt b hbfin hbs hbnorm hbU

  have hsnd : Limits.pullback.snd g Φ ≫ wcProjKStr k' d = Limits.pullback.fst g Φ ≫ a₁ ≫ t := by
    calc Limits.pullback.snd g Φ ≫ wcProjKStr k' d
        = Limits.pullback.snd g Φ ≫ Φ ≫ wcProjKStr k' d := by rw [hΦs]
      _ = (Limits.pullback.fst g Φ ≫ g) ≫ wcProjKStr k' d := by
          rw [Limits.pullback.condition, Category.assoc]
      _ = Limits.pullback.fst g Φ ≫ a₁ ≫ t := by rw [Category.assoc, hga]
  have hft : (b ≫ r ≫ Limits.pullback.snd g Φ) ≫ wcProjKStr k' d =
      (b ≫ r ≫ Limits.pullback.fst g Φ) ≫ a₁ ≫ t := by
    simp only [Category.assoc, hsnd]
  have heq : (b ≫ r ≫ Limits.pullback.snd g Φ) ≫
      (wcProjKStr k' d ≫ Spec.map (CommRingCat.ofHom (algebraMap k k'))) =
      ((b ≫ r ≫ Limits.pullback.fst g Φ) ≫ a₁ ≫ c ≫ α₀) ≫ sX := by
    simp only [Category.assoc, reassoc_of% hsnd, htc]

  have hPbig : wcpaDjIsProjOver k' ((b ≫ r ≫ Limits.pullback.fst g Φ) ≫ a₁ ≫ t) :=
    wcpa_dj_gs_finite_proj k' (b ≫ r ≫ Limits.pullback.fst g Φ) (a₁ ≫ t) inferInstance hPa
  have e2 : ((b ≫ r ≫ Limits.pullback.fst g Φ) ≫ a₁ ≫ c ≫ α₀) ≫ sX =
      ((b ≫ r ≫ Limits.pullback.fst g Φ) ≫ a₁ ≫ t) ≫
        Spec.map (CommRingCat.ofHom (algebraMap k k')) := by
    simp only [Category.assoc, htc]
  have hPα : wcpaDjIsProjOver k (((b ≫ r ≫ Limits.pullback.fst g Φ) ≫ a₁ ≫ c ≫ α₀) ≫ sX) := by
    rw [e2]; exact wcpa_dj_gs_proj_restrict k k' _ hPbig
  have hPsP : wcpaDjIsProjOver k
      (wcProjKStr k' d ≫ Spec.map (CommRingCat.ofHom (algebraMap k k'))) :=
    wcpa_dj_gs_proj_restrict k k' _ hE0

  have htop : ∀ (Z : Scheme.{u}) [Nonempty Z], (⊤ : Z.Opens) ≠ ⊥ := by
    intro Z _ h
    obtain ⟨z⟩ := ‹Nonempty Z›
    have hz : z ∈ (⊤ : Z.Opens) := by simp
    rw [h] at hz
    simp at hz
  haveI hcαp : IsProper (c ≫ α₀) := inferInstance
  obtain ⟨hs1, hf1⟩ := wcpa_dj_alteration_comp (X := X) (Y := X') α₀ c hα₀p hα₀s hcsurj hα₀f
    ⟨⊤, htop X', inferInstance⟩
  haveI ha₁cα : IsProper (a₁ ≫ c ≫ α₀) := inferInstance
  obtain ⟨hs2, hf2⟩ := wcpa_dj_alteration_comp (X := X) (Y := Y') (c ≫ α₀) a₁ hcαp hs1 ha₁s hf1 ha₁f
  haveI hbrf : IsFinite (b ≫ r ≫ Limits.pullback.fst g Φ) := inferInstance
  have hbrfs : Surjective (b ≫ r ≫ Limits.pullback.fst g Φ) := inferInstance
  obtain ⟨hs3, hf3⟩ := wcpa_dj_alteration_comp (X := X) (Y := Y₁) (a₁ ≫ c ≫ α₀)
    (b ≫ r ≫ Limits.pullback.fst g Φ) ha₁cα hs2 hbrfs hf2 ⟨⊤, htop Y₁, inferInstance⟩
  have hαp : IsProper ((b ≫ r ≫ Limits.pullback.fst g Φ) ≫ a₁ ≫ c ≫ α₀) := inferInstance

  haveI hfsQ : IsProper ((b ≫ r ≫ Limits.pullback.snd g Φ) ≫ wcProjKStr k' d) := by
    rw [hft]; infer_instance
  haveI hfp : IsProper (b ≫ r ≫ Limits.pullback.snd g Φ) :=
    IsProper.of_comp (b ≫ r ≫ Limits.pullback.snd g Φ) (wcProjKStr k' d)
  obtain ⟨U₁, hU₁, hU₁sm⟩ := wcpa_dj_cf_smooth_spread k' Xt (wcProjK k' d) (wcProjKStr k' d)
    (b ≫ r ≫ Limits.pullback.snd g Φ) hsm1
  obtain ⟨U, hU, hUsm, hUgc⟩ := wcpa_dj_cf_geom_connected_spread k' Xt (wcProjK k' d)
    (wcProjKStr k' d) (b ≫ r ≫ Limits.pullback.snd g Φ) U₁ hU₁ hU₁sm hgc1

  have hT := wcpa_dj_gs_twist_transport Y₁ (wcProjK k' d) (wcProjK k' d) R g Φ r hrci hrs hFD1 hGSP
  have hn1 := wcpa_dj_gs_norm_iso_normal_locus Xt R b hbfin hbU
  have hGSPf := wcpa_dj_gs_normalization_transport Xt R (wcProjK k' d)
    (r ≫ Limits.pullback.snd g Φ) b (fun q => (hQnorm q).2) hbfin hn1 hT.1 hT.2
  have hXtd : topologicalKrullDim Xt = ((d + 1 : ℕ) : WithBot ℕ∞) :=
    (wcpa_dj_alteration_dim_eq k' Xt Y₁ ((b ≫ r ≫ Limits.pullback.fst g Φ) ≫ a₁ ≫ t) (a₁ ≫ t)
      (b ≫ r ≫ Limits.pullback.fst g Φ) rfl hbrfs ⟨⊤, htop Y₁, inferInstance⟩).trans hY₁d
  haveI hgs : Surjective g := ⟨fun y => ⟨σ y, by rw [← Scheme.Hom.comp_apply, hσ]; rfl⟩⟩
  haveI hsnds : Surjective (Limits.pullback.snd g Φ) :=
    MorphismProperty.of_isPullback (P := @Surjective) (IsPullback.of_hasPullback g Φ) hgs
  have hfs : Surjective (b ≫ r ≫ Limits.pullback.snd g Φ) := inferInstance
  have hPos := wcpa_dj_gs_fibre_components_pos k' Xt (wcProjK k' d) (wcProjKStr k' d)
    (b ≫ r ≫ Limits.pullback.snd g Φ) d (wc_proj_space_dim k' d) hXtd hfs
  have hGS : wcpaDjGS (b ≫ r ≫ Limits.pullback.snd g Φ) := by
    intro K _ _ s Z hZ
    obtain ⟨w, hwZ, V, hwV, hVsm⟩ := hGSPf K s Z hZ (hPos K s Z hZ)
    refine ⟨w, hwZ, Limits.pullback.fst (b ≫ r ≫ Limits.pullback.snd g Φ) s ⁻¹ᵁ V,
      by rw [Scheme.Hom.mem_preimage]; exact hwV, ?_⟩
    exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1)
      ((isPullback_morphismRestrict _ V).paste_vert (IsPullback.of_hasPullback _ s)) hVsm
  exact ⟨Xt, wcProjK k' d, iXt, iQ, (b ≫ r ≫ Limits.pullback.fst g Φ) ≫ a₁ ≫ c ≫ α₀,
    wcProjKStr k' d ≫ Spec.map (CommRingCat.ofHom (algebraMap k k')),
    b ≫ r ≫ Limits.pullback.snd g Φ, heq, hPα, hPsP, hαp, hs3, hf3, wc_proj_space_dim k' d,
    U, hU, hUsm, hUgc, hGS⟩

theorem wcpa_dj_ssm_gf_base_change : ∀ (X P : Scheme.{u}) (f : X ⟶ P) (U : P.Opens) (K : Type u) [Field K] (g : Spec (.of K) ⟶ P), Set.range ⇑g ⊆ (U : Set P) → SmoothOfRelativeDimension 1 (f ∣_ U) → GeometricallyConnected (f ∣_ U) → SmoothOfRelativeDimension 1 (Limits.pullback.snd f g) ∧ ConnectedSpace ↥(Limits.pullback f g) :=
by
  intro X P f U K _ g hrange hsm hgc
  have hrange' : Set.range ⇑g ⊆ Set.range ⇑U.ι := by
    rw [Scheme.Opens.range_ι]; exact hrange
  have hfac : IsOpenImmersion.lift U.ι g hrange' ≫ U.ι = g := IsOpenImmersion.lift_fac U.ι g hrange'
  have C : IsPullback (Limits.pullback.fst f g) (Limits.pullback.snd f g) f
      (IsOpenImmersion.lift U.ι g hrange' ≫ U.ι) := by
    rw [hfac]; exact IsPullback.of_hasPullback f g
  have t := (isPullback_morphismRestrict f U).flip
  have hW := IsPullback.of_right' C t
  refine ⟨MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hW hsm, ?_⟩
  exact GeometricallyConnected.geometrically_connectedSpace (f := f ∣_ U) _ _ _ hW

theorem wcpa_dj_ssm_gf_chain_of_geom_dim : ∀ (X P : Scheme.{u}) (f : X ⟶ P) (p : P), ((1 : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim ↥(Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap (P.residueField p) (AlgebraicClosure (P.residueField p)))) ≫ P.fromSpecResidueField p)) → ∃ x y : X, f x = p ∧ f y = p ∧ x ⤳ y ∧ x ≠ y :=
by
  intro X P f p hdim

  have top : ∀ (T : Type u) [TopologicalSpace T] [QuasiSober T],
      ((1 : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim T → ∃ a b : T, a ⤳ b ∧ a ≠ b := by
    intro T _ _ hT
    have h0 : ((1 : ℕ) : WithBot ℕ∞) = 1 := Nat.cast_one
    have h1 : (1 : WithBot ℕ∞) ≤ Order.krullDim (TopologicalSpace.IrreducibleCloseds T) := by
      rw [h0] at hT
      exact hT
    obtain ⟨A, B, hAB⟩ := Order.one_le_krullDim_iff.mp h1
    have hA := A.isIrreducible.isGenericPoint_genericPoint_closure
    have hB := B.isIrreducible.isGenericPoint_genericPoint_closure
    rw [A.isClosed.closure_eq] at hA
    rw [B.isClosed.closure_eq] at hB
    have hsub : (A : Set T) ⊆ B := hAB.le
    refine ⟨B.isIrreducible.genericPoint, A.isIrreducible.genericPoint,
      hB.specializes (hsub hA.mem), ?_⟩
    intro heq
    apply hAB.ne
    apply TopologicalSpace.IrreducibleCloseds.ext
    rw [← isGenericPoint_def.mp hA, ← isGenericPoint_def.mp hB, heq]

  have ring : ∀ {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S), φ.IsIntegral →
      ∀ P₁ P₂ : PrimeSpectrum S, P₁ ≤ P₂ →
      PrimeSpectrum.comap φ P₁ = PrimeSpectrum.comap φ P₂ → P₁ = P₂ := by
    intro R S _ _ φ hφ P₁ P₂ hle heq
    by_contra hne
    have hlt : P₁.asIdeal < P₂.asIdeal :=
      lt_of_le_of_ne hle (fun h => hne (PrimeSpectrum.ext h))
    obtain ⟨s, hs2, hs1⟩ := SetLike.exists_of_lt hlt
    let _ := φ.toAlgebra
    have hc := Ideal.under_lt_under_of_integral_mem_sdiff (R := R) hlt.le ⟨hs2, hs1⟩ (hφ s)
    have h2 : (PrimeSpectrum.comap φ P₁).asIdeal = (PrimeSpectrum.comap φ P₂).asIdeal := by
      rw [heq]
    exact (ne_of_lt hc) h2

  have aff : ∀ {Y Z : Scheme.{u}} (g : Y ⟶ Z) [IsIntegralHom g] [IsAffine Y] [IsAffine Z]
      (y₁ y₂ : Y), y₁ ⤳ y₂ → g y₁ = g y₂ → y₁ = y₂ := by
    intro Y Z g _ _ _ y₁ y₂ h he
    have hint : g.appTop.hom.IsIntegral := IsIntegralHom.isIntegral_app g ⊤ (isAffineOpen_top Z)
    have nat := Scheme.isoSpec_hom_naturality g
    have hP : (Spec.map g.appTop) (Y.isoSpec.hom y₁) = (Spec.map g.appTop) (Y.isoSpec.hom y₂) := by
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, nat, Scheme.Hom.comp_apply,
        Scheme.Hom.comp_apply, he]
    have hsp : Y.isoSpec.hom y₁ ⤳ Y.isoSpec.hom y₂ := h.map (Scheme.Hom.continuous _)
    have hle := (PrimeSpectrum.le_iff_specializes _ _).mpr hsp
    have h3 := ring g.appTop.hom hint _ _ hle hP
    have h4 := congrArg Y.isoSpec.inv h3
    rwa [Scheme.hom_inv_apply, Scheme.hom_inv_apply] at h4

  have incomp : ∀ {Y Z : Scheme.{u}} (g : Y ⟶ Z) [IsIntegralHom g] (y₁ y₂ : Y),
      y₁ ⤳ y₂ → g y₁ = g y₂ → y₁ = y₂ := by
    intro Y Z g _ y₁ y₂ h he
    obtain ⟨V, hV, hmem, -⟩ := exists_isAffineOpen_mem_and_subset (U := (⊤ : Z.Opens))
      (x := g y₂) trivial
    have hW : IsAffineOpen (g ⁻¹ᵁ V) := hV.preimage g
    have : IsAffine (g ⁻¹ᵁ V) := hW
    have : IsAffine V := hV
    have : IsIntegralHom (g ∣_ V) :=
      MorphismProperty.of_isPullback (P := @IsIntegralHom) (isPullback_morphismRestrict g V).flip
        ‹IsIntegralHom g›
    have hy₂ : y₂ ∈ g ⁻¹ᵁ V := hmem
    have hy₁ : y₁ ∈ g ⁻¹ᵁ V := h.mem_open (g ⁻¹ᵁ V).isOpen hy₂
    have hy₁' : y₁ ∈ Set.range (g ⁻¹ᵁ V).ι := by rw [Scheme.Opens.range_ι]; exact hy₁
    have hy₂' : y₂ ∈ Set.range (g ⁻¹ᵁ V).ι := by rw [Scheme.Opens.range_ι]; exact hy₂
    obtain ⟨w₁, hw₁⟩ := hy₁'
    obtain ⟨w₂, hw₂⟩ := hy₂'
    have hw : w₁ ⤳ w₂ := by
      rw [← (g ⁻¹ᵁ V).ι.isOpenEmbedding.isInducing.specializes_iff, hw₁, hw₂]
      exact h
    have hres : ∀ w, V.ι ((g ∣_ V) w) = g ((g ⁻¹ᵁ V).ι w) := by
      intro w
      rw [← Scheme.Hom.comp_apply, morphismRestrict_ι, Scheme.Hom.comp_apply]
    have hgw : (g ∣_ V) w₁ = (g ∣_ V) w₂ := by
      apply V.ι.isOpenEmbedding.injective
      rw [hres, hres, hw₁, hw₂]
      exact he
    have := aff (g ∣_ V) _ _ hw hgw
    rw [← hw₁, ← hw₂, this]

  have over_gen : ∀ {Y : Scheme.{u}} (a : Y ⟶ Spec (P.residueField p))
      (k : ↥(Limits.pullback f (a ≫ P.fromSpecResidueField p))),
      f (Limits.pullback.fst f (a ≫ P.fromSpecResidueField p) k) = p := by
    intro Y a k
    have hm : f (Limits.pullback.fst f (a ≫ P.fromSpecResidueField p) k) ∈
        Set.range (P.fromSpecResidueField p) := by
      refine ⟨a (Limits.pullback.snd f (a ≫ P.fromSpecResidueField p) k), ?_⟩
      have h := Scheme.Hom.comp_apply (Limits.pullback.snd f (a ≫ P.fromSpecResidueField p))
        (a ≫ P.fromSpecResidueField p) k
      have h' := Scheme.Hom.comp_apply (Limits.pullback.fst f (a ≫ P.fromSpecResidueField p)) f k
      rw [Limits.pullback.condition] at h'
      rw [← h', h, Scheme.Hom.comp_apply]
    rw [Scheme.range_fromSpecResidueField] at hm
    exact hm
  obtain ⟨g₁, g₂, hg, hne⟩ := top _ hdim
  refine ⟨_, _, over_gen _ g₁, over_gen _ g₂, hg.map (Scheme.Hom.continuous _), ?_⟩
  intro heq
  apply hne
  have hint : IsIntegralHom (Spec.map (CommRingCat.ofHom
      (algebraMap (P.residueField p) (AlgebraicClosure (P.residueField p))))) :=
    IsIntegralHom.SpecMap_iff.mpr (fun x => Algebra.IsIntegral.isIntegral x)
  have hint2 : IsIntegralHom (Limits.pullback.fst
      (Limits.pullback.snd f (P.fromSpecResidueField p)) (Spec.map (CommRingCat.ofHom
        (algebraMap (P.residueField p) (AlgebraicClosure (P.residueField p)))))) :=
    MorphismProperty.of_isPullback (P := @IsIntegralHom) (IsPullback.of_hasPullback _ _).flip hint
  have he : ∀ k, Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap (P.residueField p)
      (AlgebraicClosure (P.residueField p)))) ≫ P.fromSpecResidueField p)
      ((Limits.pullbackLeftPullbackSndIso f (P.fromSpecResidueField p) (Spec.map (CommRingCat.ofHom
        (algebraMap (P.residueField p) (AlgebraicClosure (P.residueField p)))))).hom k) =
      Limits.pullback.fst f (P.fromSpecResidueField p) (Limits.pullback.fst
        (Limits.pullback.snd f (P.fromSpecResidueField p)) (Spec.map (CommRingCat.ofHom
          (algebraMap (P.residueField p) (AlgebraicClosure (P.residueField p))))) k) := by
    intro k
    rw [← Scheme.Hom.comp_apply, ← Limits.pullbackLeftPullbackSndIso_hom_fst, Scheme.Hom.comp_apply]
    rfl
  have hk₁ : (Limits.pullbackLeftPullbackSndIso f (P.fromSpecResidueField p)
      (Spec.map (CommRingCat.ofHom (algebraMap (P.residueField p)
        (AlgebraicClosure (P.residueField p)))))).hom
      ((Limits.pullbackLeftPullbackSndIso f (P.fromSpecResidueField p)
      (Spec.map (CommRingCat.ofHom (algebraMap (P.residueField p)
        (AlgebraicClosure (P.residueField p)))))).inv g₁) = g₁ := Scheme.inv_hom_apply _ _
  have hk₂ : (Limits.pullbackLeftPullbackSndIso f (P.fromSpecResidueField p)
      (Spec.map (CommRingCat.ofHom (algebraMap (P.residueField p)
        (AlgebraicClosure (P.residueField p)))))).hom
      ((Limits.pullbackLeftPullbackSndIso f (P.fromSpecResidueField p)
      (Spec.map (CommRingCat.ofHom (algebraMap (P.residueField p)
        (AlgebraicClosure (P.residueField p)))))).inv g₂) = g₂ := Scheme.inv_hom_apply _ _
  have h1 := he ((Limits.pullbackLeftPullbackSndIso f (P.fromSpecResidueField p)
      (Spec.map (CommRingCat.ofHom (algebraMap (P.residueField p)
        (AlgebraicClosure (P.residueField p)))))).inv g₁)
  have h2 := he ((Limits.pullbackLeftPullbackSndIso f (P.fromSpecResidueField p)
      (Spec.map (CommRingCat.ofHom (algebraMap (P.residueField p)
        (AlgebraicClosure (P.residueField p)))))).inv g₂)
  rw [hk₁] at h1
  rw [hk₂] at h2
  rw [h1, h2] at heq
  have hπ := (Limits.pullback.fst f (P.fromSpecResidueField p)).isEmbedding.injective heq
  have hsp : (Limits.pullbackLeftPullbackSndIso f (P.fromSpecResidueField p)
      (Spec.map (CommRingCat.ofHom (algebraMap (P.residueField p)
        (AlgebraicClosure (P.residueField p)))))).inv g₁ ⤳
      (Limits.pullbackLeftPullbackSndIso f (P.fromSpecResidueField p)
      (Spec.map (CommRingCat.ofHom (algebraMap (P.residueField p)
        (AlgebraicClosure (P.residueField p)))))).inv g₂ := hg.map (Scheme.Hom.continuous _)
  have := incomp _ _ _ hsp hπ
  rw [← hk₁, ← hk₂, this]

theorem wcpa_dj_ssm_generic_fibre : ∀ (X₁ P : Scheme.{u}) [AlgebraicGeometry.IsIntegral X₁]
    [AlgebraicGeometry.IsIntegral P] (f : X₁ ⟶ P) [IsProper f] (U : P.Opens), U ≠ ⊥ →
    SmoothOfRelativeDimension 1 (f ∣_ U) → GeometricallyConnected (f ∣_ U) →
    f (genericPoint X₁) = genericPoint P ∧
    (∀ x : X₁, f x = genericPoint P → x ≠ genericPoint X₁ → (f.residueFieldMap x).hom.Finite) ∧
    {x : X₁ | f x = genericPoint P}.Infinite ∧
    ∀ Z : Set X₁, IsClosed Z → genericPoint X₁ ∉ Z → (Z ∩ {x : X₁ | f x = genericPoint P}).Finite :=
by
  intro X₁ P _ _ f _ U hU hsm hgc
  classical

  have hηU : genericPoint P ∈ U := by
    obtain ⟨p, hp⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).mp hU
    exact ((genericPoint_spec P).specializes (Set.mem_univ p)).mem_open U.isOpen hp
  let g : Spec (.of (AlgebraicClosure (P.residueField (genericPoint P)))) ⟶ P :=
    Spec.map (CommRingCat.ofHom (algebraMap (P.residueField (genericPoint P))
      (AlgebraicClosure (P.residueField (genericPoint P))))) ≫ P.fromSpecResidueField (genericPoint P)
  have hrange : Set.range ⇑g ⊆ (U : Set P) := by
    rintro p ⟨z, rfl⟩
    have hmem : g z ∈ Set.range ⇑(P.fromSpecResidueField (genericPoint P)) :=
      ⟨_, (Scheme.Hom.comp_apply _ _ z).symm⟩
    rw [Scheme.range_fromSpecResidueField] at hmem
    rw [Set.mem_singleton_iff.mp hmem]
    exact hηU

  obtain ⟨hWsm, hWconn⟩ := wcpa_dj_ssm_gf_base_change X₁ P f U _ g hrange hsm hgc

  have hdim : topologicalKrullDim ↥(Limits.pullback f g) = ((1 : ℕ) : WithBot ℕ∞) := by
    haveI := hWsm
    haveI := hWconn
    haveI : Smooth (Limits.pullback.snd f g) := SmoothOfRelativeDimension.smooth 1 _
    haveI : IsLocallyNoetherian (Limits.pullback f g) :=
      LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd f g)
    haveI : IrreducibleSpace ↥(Limits.pullback f g) :=
      wcpa_irreducible_of_connected_domain_stalks _
        (fun w => wcpa_smooth_stalk_isDomain _ _ (Limits.pullback.snd f g) 1 w)
    exact le_antisymm (wc_smooth_alg_closed_dim_le _ _ (Limits.pullback.snd f g) 1)
      (wc_smooth_irreducible_dim_ge _ _ (Limits.pullback.snd f g) 1)

  obtain ⟨x, y, hx, hy, hxy, hne⟩ :=
    wcpa_dj_ssm_gf_chain_of_geom_dim X₁ P f (genericPoint P) hdim.ge

  have hA : f (genericPoint X₁) = genericPoint P := by
    have h1 : f (genericPoint X₁) ⤳ f x :=
      ((genericPoint_spec X₁).specializes (Set.mem_univ x)).map f.continuous
    rw [hx] at h1
    have h2 : genericPoint P ⤳ f (genericPoint X₁) :=
      (genericPoint_spec P).specializes (Set.mem_univ _)
    exact (h1.antisymm h2).eq

  have key : ∀ a b : X₁, f a = genericPoint P → f b = genericPoint P → a ≠ genericPoint X₁ →
      a ⤳ b → b = a := by
    intro a b ha hb hna hab
    rcases wcfd_fibre_chain_short P X₁ f (genericPoint P) hdim.le (genericPoint X₁) a b hA ha hb
      ((genericPoint_spec X₁).specializes (Set.mem_univ a)) hab with h | h
    · exact absurd h.symm hna
    · exact h.symm

  have hB : ∀ x' : X₁, f x' = genericPoint P → x' ≠ genericPoint X₁ →
      (f.residueFieldMap x').hom.Finite := by
    intro x' hx' hnx'
    exact wcpa_dj_ssm_gf_residue_finite f x'
      (fun y' hy' hxy' => key x' y' hx' (hy'.trans hx') hnx' hxy')

  have hFtop : TopologicalSpace.NoetherianSpace ↥(⇑f ⁻¹' {genericPoint P}) ∧
      QuasiSober ↥(⇑f ⁻¹' {genericPoint P}) ∧ JacobsonSpace ↥(⇑f ⁻¹' {genericPoint P}) := by
    haveI : IsProper (Limits.pullback.snd f (P.fromSpecResidueField (genericPoint P))) :=
      inferInstance
    haveI : IsLocallyNoetherian (Limits.pullback f (P.fromSpecResidueField (genericPoint P))) :=
      LocallyOfFiniteType.isLocallyNoetherian
        (Limits.pullback.snd f (P.fromSpecResidueField (genericPoint P)))
    haveI : CompactSpace ↥(Limits.pullback f (P.fromSpecResidueField (genericPoint P))) :=
      QuasiCompact.compactSpace_of_compactSpace
        (Limits.pullback.snd f (P.fromSpecResidueField (genericPoint P)))
    haveI : AlgebraicGeometry.IsNoetherian
        (Limits.pullback f (P.fromSpecResidueField (genericPoint P))) := {}
    haveI hJ : JacobsonSpace ↥(Limits.pullback f (P.fromSpecResidueField (genericPoint P))) :=
      LocallyOfFiniteType.jacobsonSpace
        (Limits.pullback.snd f (P.fromSpecResidueField (genericPoint P)))
    have hN : TopologicalSpace.NoetherianSpace
        ↥(Limits.pullback f (P.fromSpecResidueField (genericPoint P))) := inferInstance
    have hQ : QuasiSober ↥(Limits.pullback f (P.fromSpecResidueField (genericPoint P))) :=
      inferInstance
    let h := f.fiberHomeo (genericPoint P)
    refine ⟨(TopologicalSpace.noetherianSpace_iff_of_homeomorph h).mp hN, ?_, ?_⟩
    · haveI : QuasiSober ↥(f.fiber (genericPoint P)) := hQ
      exact h.symm.isClosedEmbedding.quasiSober
    · haveI : JacobsonSpace ↥(f.fiber (genericPoint P)) := hJ
      exact JacobsonSpace.of_isClosedEmbedding h.symm.isClosedEmbedding
  obtain ⟨hFN, hFQ, hFJ⟩ := hFtop

  have hD : ∀ Z : Set X₁, IsClosed Z → genericPoint X₁ ∉ Z →
      (Z ∩ {x : X₁ | f x = genericPoint P}).Finite := by
    intro Z hZ hηZ
    let C : TopologicalSpace.Closeds ↥(⇑f ⁻¹' {genericPoint P}) :=
      ⟨Subtype.val ⁻¹' Z, hZ.preimage continuous_subtype_val⟩
    obtain ⟨S, hSirr, hCS⟩ := TopologicalSpace.NoetherianSpace.exists_finset_irreducible C
    have hsub : (Subtype.val ⁻¹' Z : Set ↥(⇑f ⁻¹' {genericPoint P})) ⊆
        ⋃ k : S, {(hSirr k).genericPoint} := by
      intro c hc
      have hc' : c ∈ ((S.sup id : TopologicalSpace.Closeds _) : Set _) := by
        rw [← hCS]; exact hc
      rw [TopologicalSpace.Closeds.coe_finset_sup, Finset.sup_set_eq_biUnion] at hc'
      obtain ⟨k, hkS, hck⟩ := Set.mem_iUnion₂.mp hc'
      have hgen : IsGenericPoint (hSirr ⟨k, hkS⟩).genericPoint (k : Set _) := by
        have := (hSirr ⟨k, hkS⟩).isGenericPoint_genericPoint_closure
        rwa [k.isClosed.closure_eq] at this
      have hkC : (k : Set ↥(⇑f ⁻¹' {genericPoint P})) ⊆ Subtype.val ⁻¹' Z := by
        intro a ha
        have hle : k ≤ S.sup id := Finset.le_sup (f := id) hkS
        rw [← hCS] at hle
        exact hle ha
      set e := (hSirr ⟨k, hkS⟩).genericPoint with he
      have hec : e ⤳ c := hgen.specializes hck
      have heZ : (e : X₁) ∈ Z := hkC hgen.mem
      have hne' : (e : X₁) ≠ genericPoint X₁ := fun h => hηZ (h ▸ heZ)
      have hfe : f (e : X₁) = genericPoint P := e.2
      have hfc : f (c : X₁) = genericPoint P := c.2
      have hce : (c : X₁) = e := key e c hfe hfc hne' (hec.map continuous_subtype_val)
      exact Set.mem_iUnion.mpr ⟨⟨k, hkS⟩, Set.mem_singleton_iff.mpr (Subtype.ext hce)⟩
    have heq : Z ∩ {x : X₁ | f x = genericPoint P} =
        Subtype.val '' (Subtype.val ⁻¹' Z : Set ↥(⇑f ⁻¹' {genericPoint P})) := by
      rw [Subtype.image_preimage_coe, Set.inter_comm]
      rfl
    rw [heq]
    exact ((Set.finite_iUnion fun k => Set.finite_singleton _).subset hsub).image _

  have hC : {x : X₁ | f x = genericPoint P}.Infinite := by
    intro hfin
    haveI : Finite ↥(⇑f ⁻¹' {genericPoint P}) := hfin.to_subtype
    have hcl : ∀ x0 : ↥(⇑f ⁻¹' {genericPoint P}), IsClosed ({x0} : Set _) := by
      intro x0
      apply isClosed_singleton_of_isLocallyClosed_singleton
      refine ⟨⋂₀ {s : Set ↥(⇑f ⁻¹' {genericPoint P}) | IsOpen s ∧ x0 ∈ s}, closure {x0},
        Set.Finite.isOpen_sInter (Set.toFinite _) (fun t ht => ht.1), isClosed_closure, ?_⟩
      ext z
      constructor
      · intro hz
        rw [Set.mem_singleton_iff.mp hz]
        exact ⟨Set.mem_sInter.mpr (fun t ht => ht.2), subset_closure rfl⟩
      · rintro ⟨hz1, hz2⟩
        have h1 : x0 ⤳ z := specializes_iff_mem_closure.mpr hz2
        have h2 : z ⤳ x0 := specializes_iff_forall_open.mpr
          (fun s hs hx0 => Set.mem_sInter.mp hz1 s ⟨hs, hx0⟩)
        exact Set.mem_singleton_iff.mpr (h1.antisymm h2).eq.symm
    have hsp : (⟨x, hx⟩ : ↥(⇑f ⁻¹' {genericPoint P})) ⤳ ⟨y, hy⟩ :=
      Topology.IsInducing.subtypeVal.specializes_iff.mp hxy
    have hmem := hsp.mem_closed (hcl ⟨x, hx⟩) (Set.mem_singleton _)
    exact hne (congrArg Subtype.val (Set.mem_singleton_iff.mp hmem)).symm
  exact ⟨hA, hB, hC, hD⟩

theorem wcpa_ssmr_splitting_field : ∀ (K : Type u) [Field K] (ι : Type u) [Finite ι]
    (A : ι → Type u) [∀ i, Field (A i)] (φ : ∀ i, K →+* A i), (∀ i, (φ i).Finite) →
    ∃ (L : Type u) (_ : Field L) (_ : Algebra K L), FiniteDimensional K L ∧
      ∀ (i : ι) (a : A i), ∃ p : Polynomial K, p ≠ 0 ∧ p.eval₂ (φ i) a = 0 ∧
        (p.map (algebraMap K L)).Splits :=
by
  intro K _ ι _ A _ φ hφ
  classical
  haveI := Fintype.ofFinite ι
  have hloc : ∀ i, ∃ q : Polynomial K, q.Monic ∧ ∀ (L : Type u) [Field L] [Algebra K L],
      Normal K L → (q.map (algebraMap K L)).Splits → ∀ a : A i, ∃ p : Polynomial K, p ≠ 0 ∧
        p.eval₂ (φ i) a = 0 ∧ (p.map (algebraMap K L)).Splits := by
    intro i
    letI : Algebra K (A i) := (φ i).toAlgebra
    haveI : Module.Finite K (A i) := hφ i
    have hmon : (∏ j, minpoly K (Module.finBasis K (A i) j)).Monic :=
      Polynomial.monic_prod_of_monic _ _
        (fun j _ => minpoly.monic (IsIntegral.of_finite K (Module.finBasis K (A i) j)))
    refine ⟨∏ j, minpoly K (Module.finBasis K (A i) j), hmon, ?_⟩
    intro L _ _ hN hq a
    have hne : (∏ j, minpoly K (Module.finBasis K (A i) j)).map (algebraMap K L) ≠ 0 :=
      (hmon.map _).ne_zero
    have hspl : ∀ j, ((minpoly K (Module.finBasis K (A i) j)).map (algebraMap K L)).Splits :=
      fun j => Polynomial.Splits.of_dvd hq hne
        (Polynomial.map_dvd _ (Finset.dvd_prod_of_mem _ (Finset.mem_univ j)))
    have hadj : IntermediateField.adjoin K (Set.range (Module.finBasis K (A i))) = ⊤ := by
      rw [eq_top_iff]
      intro x _
      have hx : x ∈ Submodule.span K (Set.range (Module.finBasis K (A i))) :=
        (Module.finBasis K (A i)).mem_span x
      have hle : Submodule.span K (Set.range (Module.finBasis K (A i))) ≤
          (IntermediateField.adjoin K (Set.range (Module.finBasis K (A i)))).toSubalgebra.toSubmodule :=
        Submodule.span_le.mpr (IntermediateField.subset_adjoin K _)
      exact hle hx
    obtain ⟨σ⟩ := IntermediateField.nonempty_algHom_of_adjoin_splits (K := L)
      (fun s hs => by
        obtain ⟨j, rfl⟩ := hs
        exact ⟨IsIntegral.of_finite K _, hspl j⟩) hadj
    refine ⟨minpoly K a, minpoly.ne_zero (IsIntegral.of_finite K a), ?_, ?_⟩
    · have h := minpoly.aeval K a
      rwa [Polynomial.aeval_def, RingHom.algebraMap_toAlgebra] at h
    · rw [← minpoly.algHom_eq σ σ.toRingHom.injective a]
      exact hN.splits (σ a)
  choose q hqm hq using hloc
  have hQ : (∏ i, q i).Monic := Polynomial.monic_prod_of_monic _ _ (fun i _ => hqm i)
  refine ⟨(∏ i, q i).SplittingField, inferInstance, inferInstance, inferInstance, ?_⟩
  intro i a
  have hne : (∏ i, q i).map (algebraMap K (∏ i, q i).SplittingField) ≠ 0 := (hQ.map _).ne_zero
  have hsplit : ((q i).map (algebraMap K (∏ i, q i).SplittingField)).Splits :=
    Polynomial.Splits.of_dvd (Polynomial.SplittingField.splits _) hne
      (Polynomial.map_dvd _ (Finset.dvd_prod_of_mem _ (Finset.mem_univ i)))
  exact hq i _ inferInstance hsplit a

theorem wcpa_ssmr_affine_model : ∀ (P : Scheme.{u}) [AlgebraicGeometry.IsIntegral P]
    [IsLocallyNoetherian P] (L : Type u) [Field L]
    [Algebra (P.residueField (genericPoint P)) L]
    [FiniteDimensional (P.residueField (genericPoint P)) L],
    ∃ (W₁ : P.Opens) (Y : Scheme.{u}) (εO : Y ⟶ (W₁ : Scheme.{u})), IsAffineOpen W₁ ∧
      genericPoint P ∈ W₁ ∧ IsFinite εO ∧ Surjective εO ∧ AlgebraicGeometry.IsIntegral Y ∧
      ∀ (y : Y) (hy : (εO ≫ W₁.ι) y = genericPoint P), ∃ j : L →+* Y.residueField y,
        ∀ c : P.residueField (genericPoint P),
          j (algebraMap _ L c) =
            ((εO ≫ W₁.ι).residueFieldMap y).hom ((P.residueFieldCongr hy).inv.hom c) :=
by
  intro P _ _ L _ _ _
  have key : ∀ {Ya Yb : Scheme.{u}} (h : Yb ⟶ P) (t : Ya ⟶ Yb) (g : Ya ⟶ P), g = t ≫ h →
      ∀ (x : P) (a : P.residueField x ⟶ CommRingCat.of L) (z₀ : Yb)
        (e : Yb.residueField z₀ ⟶ CommRingCat.of L), IsIso e →
        Spec.map e ≫ Yb.fromSpecResidueField z₀ ≫ h = Spec.map a ≫ P.fromSpecResidueField x →
        ∀ (y : Ya) (hy : g y = x), t y = z₀ → ∃ j : L →+* Ya.residueField y,
          ∀ c : P.residueField x,
            j (a.hom c) = (g.residueFieldMap y).hom ((P.residueFieldCongr hy).inv.hom c) := by
    intro Ya Yb h t g hg x a z₀ e he hspec y hy htz
    subst hg htz
    have hy' : h (t y) = x := hy
    subst hy'
    rw [← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField, ← Category.assoc,
      ← Spec.map_comp, cancel_mono] at hspec
    have hra : h.residueFieldMap (t y) ≫ e = a := Spec.map_injective hspec
    have h2 : ∀ w, (inv e).hom (e.hom w) = w := fun w => by
      show (e ≫ inv e).hom w = w
      rw [IsIso.hom_inv_id]
      rfl
    refine ⟨(inv e ≫ t.residueFieldMap y).hom, fun c => ?_⟩
    have h3 : (t ≫ h).residueFieldMap y = h.residueFieldMap (t y) ≫ t.residueFieldMap y :=
      Scheme.residueFieldMap_comp t h y
    rw [h3, ← hra]
    show (t.residueFieldMap y).hom ((inv e).hom (e.hom ((h.residueFieldMap (t y)).hom c))) =
      (t.residueFieldMap y).hom ((h.residueFieldMap (t y)).hom
        ((P.residueFieldCongr hy).inv.hom c))
    rw [h2]
    rfl
  obtain ⟨U, Y', ι, q₀, hι, hηr, hq₀fin, hq₀surj, -, -, hY'int, hfib, e, he, hspec⟩ :=
    wc_spread_finite_ext_generic P L
  haveI := hι
  haveI := hq₀fin
  haveI := hY'int
  obtain ⟨u₀, hu₀⟩ := hηr
  obtain ⟨V, hV, hu₀V, -⟩ :=
    exists_isAffineOpen_mem_and_subset (show u₀ ∈ (⊤ : U.Opens) from trivial)
  have hfac : (q₀ ∣_ V ≫ (Scheme.Hom.isoImage ι V).hom) ≫ (ι ''ᵁ V).ι =
      (q₀ ⁻¹ᵁ V).ι ≫ q₀ ≫ ι := by
    rw [Category.assoc, Scheme.Hom.isoImage_hom_ι, ← Category.assoc, morphismRestrict_ι,
      Category.assoc]
  refine ⟨ι ''ᵁ V, (q₀ ⁻¹ᵁ V : Scheme.{u}), q₀ ∣_ V ≫ (Scheme.Hom.isoImage ι V).hom,
    hV.image_of_isOpenImmersion ι, ?_, inferInstance, ?_, ?_, ?_⟩
  · show genericPoint P ∈ ((ι ''ᵁ V : P.Opens) : Set P)
    rw [Scheme.Hom.coe_image, ← hu₀]
    exact Set.mem_image_of_mem _ hu₀V
  · haveI : Surjective (q₀ ∣_ V) := IsZariskiLocalAtTarget.restrict (P := @Surjective) hq₀surj V
    infer_instance
  · obtain ⟨y₀, hy₀⟩ := hq₀surj.surj u₀
    haveI : Nonempty (q₀ ⁻¹ᵁ V : Scheme.{u}) :=
      ⟨⟨y₀, by rw [Scheme.Hom.mem_preimage, hy₀]; exact hu₀V⟩⟩
    exact isIntegral_of_isOpenImmersion (q₀ ⁻¹ᵁ V).ι
  · intro y hy
    have h' : ((q₀ ⁻¹ᵁ V).ι ≫ q₀ ≫ ι) y = genericPoint P := by rw [← hfac]; exact hy
    have htη : (q₀ ⁻¹ᵁ V).ι y = genericPoint Y' := hfib _ h'
    obtain ⟨j, hj⟩ := key (q₀ ≫ ι) (q₀ ⁻¹ᵁ V).ι _ hfac (genericPoint P)
      (CommRingCat.ofHom (algebraMap (P.residueField (genericPoint P)) L)) (genericPoint Y')
      e he hspec y hy htη
    exact ⟨j, hj⟩

theorem wcpa_ssmr_compactify : ∀ (P : Scheme.{u}) [AlgebraicGeometry.IsIntegral P] [CompactSpace P]
    [QuasiSeparatedSpace P] (L : Type u) [Field L] [Algebra (P.residueField (genericPoint P)) L]
    (W₁ : P.Opens) (Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral Y]
    (εO : Y ⟶ (W₁ : Scheme.{u})),
    IsAffineOpen W₁ → genericPoint P ∈ W₁ → IsFinite εO → Surjective εO →
    (∀ (y : Y) (hy : (εO ≫ W₁.ι) y = genericPoint P), ∃ j : L →+* Y.residueField y,
        ∀ c : P.residueField (genericPoint P),
          j (algebraMap _ L c) =
            ((εO ≫ W₁.ι).residueFieldMap y).hom ((P.residueFieldCongr hy).inv.hom c)) →
    ∃ (P₀ : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral P₀) (β₀ : P₀ ⟶ P), IsFinite β₀ ∧
      Surjective β₀ ∧ ∃ hη : β₀ (genericPoint P₀) = genericPoint P,
        ∃ j : L →+* P₀.residueField (genericPoint P₀), ∀ c : P.residueField (genericPoint P),
          j (algebraMap _ L c) =
            (β₀.residueFieldMap (genericPoint P₀)).hom ((P.residueFieldCongr hη).inv.hom c) :=
by
  intro P _ _ _ L _ _ W₁ Y _ εO hW₁ hηW₁ hεfin hεsurj hεj
  classical
  haveI := hεsurj
  obtain ⟨X', h, hhfin, ψ, hψ, hrange, hdense, hcomm⟩ :=
    wc_finite_extension_of_affine_finite P W₁ hW₁ Y εO hεfin
  haveI := hhfin
  haveI := hψ
  obtain ⟨R, r, hrci, hrsurj, hred⟩ := wc_reduced_subscheme_exists X'
  haveI := hrci
  haveI := hred

  have hirrψ : IsIrreducible (Set.range ψ) := by
    rw [← Set.image_univ]
    exact (IrreducibleSpace.isIrreducible_univ Y).image ψ ψ.continuous.continuousOn
  have hX'irr : IsIrreducible (Set.univ : Set X') := by
    have h1 := hirrψ.closure
    rwa [hrange, hdense.closure_eq] at h1
  haveI : IrreducibleSpace X' := (irreducibleSpace_def X').mpr hX'irr

  have hemb := (IsClosedImmersion.isClosedEmbedding r).toIsEmbedding
  set e := hemb.toHomeomorph with he
  have hmemr : ∀ x : X', x ∈ Set.range r := fun x => by rw [hrsurj]; exact Set.mem_univ x
  let g : X' → R := fun x => e.symm ⟨x, hmemr x⟩
  have hgcont : Continuous g := e.symm.continuous.comp (continuous_id.subtype_mk _)
  have hgsurj : Function.Surjective g := by
    intro x
    refine ⟨r x, ?_⟩
    show e.symm ⟨r x, hmemr (r x)⟩ = x
    rw [Homeomorph.symm_apply_eq]
    exact Subtype.ext rfl
  haveI : IrreducibleSpace R := hgsurj.irreducibleSpace hgcont
  haveI hRint : AlgebraicGeometry.IsIntegral R := isIntegral_of_irreducibleSpace_of_isReduced R

  have hW₁range : (W₁ : Set P) ⊆ Set.range h := by
    intro w hw
    obtain ⟨y, hy⟩ := εO.surjective ⟨w, hw⟩
    refine ⟨ψ y, ?_⟩
    rw [← Scheme.Hom.comp_apply, hcomm, Scheme.Hom.comp_apply, hy]
    rfl
  have hhsurj : Set.range h = Set.univ := by
    have hcl : IsClosed (Set.range h) := h.isClosedMap.isClosed_range
    have hd : Dense (W₁ : Set P) := W₁.isOpen.dense ⟨_, hηW₁⟩
    have h2 := closure_minimal hW₁range hcl
    rw [hd.closure_eq] at h2
    exact Set.univ_subset_iff.mp h2
  have hβsurj : Function.Surjective (r ≫ h) := by
    intro p
    obtain ⟨x', hx'⟩ : p ∈ Set.range h := hhsurj ▸ Set.mem_univ p
    obtain ⟨x, hx⟩ : x' ∈ Set.range r := hrsurj ▸ Set.mem_univ x'
    exact ⟨x, by rw [Scheme.Hom.comp_apply, hx, hx']⟩

  have hη : (r ≫ h) (genericPoint R) = genericPoint P := by
    have h1 : IsGenericPoint ((r ≫ h) (genericPoint R)) Set.univ := by
      rw [isGenericPoint_iff_specializes]
      intro y
      simp only [Set.mem_univ, iff_true]
      obtain ⟨x, rfl⟩ := hβsurj y
      exact ((genericPoint_spec R).specializes (Set.mem_univ x)).map (r ≫ h).continuous
    exact h1.eq (genericPoint_spec P)

  have hmem : r (genericPoint R) ∈ Set.range ψ := by
    rw [hrange]
    show h (r (genericPoint R)) ∈ (W₁ : Set P)
    rw [← Scheme.Hom.comp_apply, hη]
    exact hηW₁
  obtain ⟨y, hψy⟩ := hmem
  have hy : (εO ≫ W₁.ι) y = genericPoint P := by
    rw [← hcomm, Scheme.Hom.comp_apply, hψy, ← Scheme.Hom.comp_apply, hη]
  obtain ⟨j₀, hj₀⟩ := hεj y hy

  have N : ∀ (z z' : X') (e : z = z') (e' : h z' = h z) {T : CommRingCat}
      (k : X'.residueField z' ⟶ T),
      h.residueFieldMap z ≫ (X'.residueFieldCongr e).hom ≫ k =
        (P.residueFieldCongr e').inv ≫ h.residueFieldMap z' ≫ k := by
    intro z z' e e' T k
    subst e
    simp [Scheme.residueFieldCongr_refl]
  have K : ∀ (g : Y ⟶ P) (hg : ψ ≫ h = g) (p : P) (hy' : g y = p)
      (hp : (r ≫ h) (genericPoint R) = p),
      (P.residueFieldCongr hy').inv ≫ g.residueFieldMap y ≫ inv (ψ.residueFieldMap y) ≫
        (X'.residueFieldCongr hψy).hom ≫ r.residueFieldMap (genericPoint R) =
      (P.residueFieldCongr hp).inv ≫ (r ≫ h).residueFieldMap (genericPoint R) := by
    intro g hg p hy' hp
    subst hg
    subst hy'
    rw [Scheme.residueFieldCongr_refl, Iso.refl_inv, Category.id_comp]
    have e2 : ∀ {T : CommRingCat} (k : Y.residueField y ⟶ T),
        (ψ ≫ h).residueFieldMap y ≫ k = h.residueFieldMap (ψ y) ≫ ψ.residueFieldMap y ≫ k := by
      intro T k
      rw [Scheme.residueFieldMap_comp]
      exact Category.assoc _ _ _
    have e3 : (r ≫ h).residueFieldMap (genericPoint R) =
        h.residueFieldMap (r (genericPoint R)) ≫ r.residueFieldMap (genericPoint R) :=
      Scheme.residueFieldMap_comp _ _ _
    rw [e2, IsIso.hom_inv_id_assoc, N (ψ y) (r (genericPoint R)) hψy hp, e3]
    rfl
  refine ⟨R, hRint, r ≫ h, inferInstance, ⟨hβsurj⟩, hη,
    (inv (ψ.residueFieldMap y) ≫ (X'.residueFieldCongr hψy).hom ≫
      r.residueFieldMap (genericPoint R)).hom.comp j₀, ?_⟩
  intro c
  rw [RingHom.comp_apply, hj₀ c]
  have h3 := congrArg (fun F => F.hom c) (K _ hcomm _ hy hη)
  exact h3

theorem wcpa_ssmr_fibre_points_finite : ∀ {X Y S : Scheme.{u}} (f : X ⟶ S) (g : Y ⟶ S) (x : X) (y : Y),
    f x = g y → (f.residueFieldMap x).hom.Finite →
    {t : ↥(Limits.pullback f g) |
      Limits.pullback.fst f g t = x ∧ Limits.pullback.snd f g t = y}.Finite :=
by
  intro X Y S f g x y h hfin
  classical
  let T₀ : Scheme.Pullback.Triplet f g := ⟨x, y, f x, rfl, h.symm⟩
  have hsub : {t : ↥(Limits.pullback f g) |
      Limits.pullback.fst f g t = x ∧ Limits.pullback.snd f g t = y} ⊆
      Set.range (fun p : ↥(Spec T₀.tensor) => Scheme.Pullback.carrierEquiv.symm ⟨T₀, p⟩) := by
    rintro t ⟨h1, h2⟩
    obtain ⟨⟨T, p⟩, hσ⟩ : ∃ σ, Scheme.Pullback.carrierEquiv t = σ := ⟨_, rfl⟩
    have ht : t = Scheme.Pullback.carrierEquiv.symm ⟨T, p⟩ := by
      rw [← hσ, Equiv.symm_apply_apply]
    have hTx : T.x = x := by
      rw [← h1, ht, Scheme.Pullback.carrierEquiv_symm_fst]
    have hTy : T.y = y := by
      rw [← h2, ht, Scheme.Pullback.carrierEquiv_symm_snd]
    have hT : T = T₀ := Scheme.Pullback.Triplet.ext hTx hTy
    subst hT
    exact ⟨p, ht.symm⟩
  have hφx : ((S.residueFieldCongr T₀.hx).inv ≫ f.residueFieldMap T₀.x).hom.Finite := by
    rw [CommRingCat.hom_comp]
    refine RingHom.Finite.comp hfin (RingHom.Finite.of_surjective _ ?_)
    intro c
    refine ⟨(S.residueFieldCongr T₀.hx).hom.hom c, ?_⟩
    change ((S.residueFieldCongr T₀.hx).hom ≫ (S.residueFieldCongr T₀.hx).inv).hom c = c
    rw [Iso.hom_inv_id]
    rfl
  have gen : ∀ {R A B : CommRingCat.{u}} (a : R ⟶ A) (b : R ⟶ B), a.hom.Finite →
      (Limits.pushout.inr a b).hom.Finite := by
    intro R A B a b ha
    have hinl : (Limits.pushout.inl b a).hom.Finite :=
      RingHom.finite_isStableUnderBaseChange.pushout_inl RingHom.finite_respectsIso _ _ ha
    have e : (Limits.pushout.inr a b).hom =
        (Limits.pushoutSymmetry b a).hom.hom.comp (Limits.pushout.inl b a).hom := by
      rw [← CommRingCat.hom_comp, Limits.inl_comp_pushoutSymmetry_hom]
    rw [e]
    exact (RingHom.finite_respectsIso.cancel_right_isIso _ _).mpr hinl
  have hinr : T₀.tensorInr.hom.Finite := gen _ _ hφx
  letI : Algebra (Y.residueField y) T₀.tensor := T₀.tensorInr.hom.toAlgebra
  haveI : Module.Finite (Y.residueField y) T₀.tensor := hinr
  haveI : IsArtinianRing T₀.tensor := IsArtinianRing.of_finite (Y.residueField y) T₀.tensor
  exact (Set.finite_range _).subset hsub

theorem wcpa_ssmr_residue_iso_of_range : ∀ {X Y S : Scheme.{u}} (f : X ⟶ S) (g : Y ⟶ S)
    (t : ↥(Limits.pullback f g)),
    Set.range ((Limits.pullback.fst f g).residueFieldMap t).hom ⊆
      Set.range ((Limits.pullback.snd f g).residueFieldMap t).hom →
    IsIso ((Limits.pullback.snd f g).residueFieldMap t) :=
by
  intro X Y S f g t hsub
  classical
  have hinj : Function.Injective ((Limits.pullback.snd f g).residueFieldMap t).hom :=
    ((Limits.pullback.snd f g).residueFieldMap t).hom.injective
  have hch : ∀ a, ∃ b, ((Limits.pullback.snd f g).residueFieldMap t).hom b =
      ((Limits.pullback.fst f g).residueFieldMap t).hom a := fun a => hsub ⟨a, rfl⟩
  choose α'f hα'f using hch
  let α' : X.residueField (Limits.pullback.fst f g t) →+*
      Y.residueField (Limits.pullback.snd f g t) :=
    { toFun := α'f
      map_one' := hinj (by rw [hα'f, map_one, map_one])
      map_mul' := fun a b => hinj (by rw [hα'f, map_mul, map_mul, hα'f, hα'f])
      map_zero' := hinj (by rw [hα'f, map_zero, map_zero])
      map_add' := fun a b => hinj (by rw [hα'f, map_add, map_add, hα'f, hα'f]) }
  let A' : X.residueField (Limits.pullback.fst f g t) ⟶
      Y.residueField (Limits.pullback.snd f g t) := CommRingCat.ofHom α'
  have hA'pt : ∀ a, ((Limits.pullback.snd f g).residueFieldMap t).hom (A'.hom a) =
      ((Limits.pullback.fst f g).residueFieldMap t).hom a := fun a => hα'f a
  have hA' : A' ≫ (Limits.pullback.snd f g).residueFieldMap t =
      (Limits.pullback.fst f g).residueFieldMap t := by
    ext a
    exact hA'pt a
  have e : f (Limits.pullback.fst f g t) = g (Limits.pullback.snd f g t) := by
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
  have hcomm : f.residueFieldMap (Limits.pullback.fst f g t) ≫
      (Limits.pullback.fst f g).residueFieldMap t =
      (S.residueFieldCongr e).hom ≫ g.residueFieldMap (Limits.pullback.snd f g t) ≫
        (Limits.pullback.snd f g).residueFieldMap t := by
    have h1 := Scheme.Hom.residueFieldMap_congr (Limits.pullback.condition (f := f) (g := g)) t
    rw [Scheme.residueFieldMap_comp, Scheme.residueFieldMap_comp] at h1
    exact h1
  have hcomp' : f.residueFieldMap (Limits.pullback.fst f g t) ≫ A' =
      (S.residueFieldCongr e).hom ≫ g.residueFieldMap (Limits.pullback.snd f g t) := by
    ext c
    apply hinj
    have h2 := congrArg (fun φ => φ.hom c) hcomm
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h2 ⊢
    rw [hA'pt]
    exact h2
  have hab : (Spec.map A' ≫ X.fromSpecResidueField (Limits.pullback.fst f g t)) ≫ f =
      Y.fromSpecResidueField (Limits.pullback.snd f g t) ≫ g := by
    rw [Category.assoc, ← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField,
      ← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField,
      ← Scheme.residueFieldCongr_fromSpecResidueField e, ← Category.assoc, ← Category.assoc,
      ← Spec.map_comp, ← Spec.map_comp, hcomp']
  let u := Limits.pullback.lift _ _ hab
  have hu : Spec.map ((Limits.pullback.snd f g).residueFieldMap t) ≫ u =
      (Limits.pullback f g).fromSpecResidueField t := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Limits.pullback.lift_fst,
        ← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField, ← hA', Spec.map_comp,
        Category.assoc]
    · rw [Category.assoc, Limits.pullback.lift_snd,
        Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField]
  obtain ⟨p, hp⟩ : ∃ p, Scheme.SpecToEquivOfField
      (Y.residueField (Limits.pullback.snd f g t)) (Limits.pullback f g) u = p := ⟨_, rfl⟩
  obtain ⟨t', σ⟩ := p
  have hu' : u = Spec.map σ ≫ (Limits.pullback f g).fromSpecResidueField t' := by
    have h0 := congrArg (Scheme.SpecToEquivOfField
      (Y.residueField (Limits.pullback.snd f g t)) (Limits.pullback f g)).symm hp
    rw [Equiv.symm_apply_apply, Scheme.SpecToEquivOfField_symm_apply] at h0
    exact h0
  have heq : (Scheme.SpecToEquivOfField ((Limits.pullback f g).residueField t)
      (Limits.pullback f g)).symm ⟨t', σ ≫ ((Limits.pullback.snd f g).residueFieldMap t)⟩ =
      (Scheme.SpecToEquivOfField ((Limits.pullback f g).residueField t)
      (Limits.pullback f g)).symm ⟨t, 𝟙 _⟩ := by
    rw [Scheme.SpecToEquivOfField_symm_apply, Scheme.SpecToEquivOfField_symm_apply,
      Spec.map_comp, Category.assoc, ← hu', hu, Spec.map_id]
    exact (Category.id_comp _).symm
  obtain ⟨e', h'⟩ := Scheme.SpecToEquivOfField_eq_iff.mp
    ((Scheme.SpecToEquivOfField _ _).symm.injective heq)
  have hsurj : Function.Surjective ((Limits.pullback.snd f g).residueFieldMap t).hom := by
    intro w
    refine ⟨σ.hom ((Scheme.residueFieldCongr e').inv.hom w), ?_⟩
    have h3 := congrArg (fun φ => φ.hom ((Scheme.residueFieldCongr e').inv.hom w)) h'
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_id,
      RingHom.id_apply] at h3
    rw [h3, ← RingHom.comp_apply, ← CommRingCat.hom_comp, Iso.inv_hom_id, CommRingCat.hom_id,
      RingHom.id_apply]
  rw [ConcreteCategory.isIso_iff_bijective]
  exact ⟨hinj, hsurj⟩

theorem wcpa_ssmr_range_of_splits : ∀ {X₁ P P₀ : Scheme.{u}} (f : X₁ ⟶ P) (β₀ : P₀ ⟶ P) (η : P)
    (η₀ : P₀) (hη : β₀ η₀ = η) (L : Type u) [Field L] (ιL : P.residueField η →+* L)
    (j : L →+* P₀.residueField η₀),
    (∀ c, j (ιL c) = (β₀.residueFieldMap η₀).hom ((P.residueFieldCongr hη).inv.hom c)) →
    ∀ (y : X₁) (hy : f y = η), (∀ a : X₁.residueField y, ∃ p : Polynomial (P.residueField η),
      p ≠ 0 ∧ p.eval₂ ((f.residueFieldMap y).hom.comp (P.residueFieldCongr hy).inv.hom) a = 0 ∧
      (p.map ιL).Splits) →
    ∀ z : ↥(Limits.pullback f β₀), Limits.pullback.fst f β₀ z = y →
      Limits.pullback.snd f β₀ z = η₀ →
      Set.range ((Limits.pullback.fst f β₀).residueFieldMap z).hom ⊆
        Set.range ((Limits.pullback.snd f β₀).residueFieldMap z).hom :=
by
  intro X₁ P P₀ f β₀ η η₀ hη L _ ιL j hj y hy hroots z hz1 hz2
  subst hz1 hz2 hη
  have hcomm : ∀ c : P.residueField (f (Limits.pullback.fst f β₀ z)),
      ((Limits.pullback.fst f β₀).residueFieldMap z).hom
          ((f.residueFieldMap (Limits.pullback.fst f β₀ z)).hom c) =
        ((Limits.pullback.snd f β₀).residueFieldMap z).hom
          ((β₀.residueFieldMap (Limits.pullback.snd f β₀ z)).hom
            ((P.residueFieldCongr hy).hom.hom c)) := by
    intro c
    have h1 := Scheme.residueFieldMap_comp (Limits.pullback.fst f β₀) f z
    have h3 := Scheme.residueFieldMap_comp (Limits.pullback.snd f β₀) β₀ z
    have h2 := Scheme.Hom.residueFieldMap_congr (Limits.pullback.condition (f := f) (g := β₀)) z
    rw [h1, h3] at h2
    have := congrArg (fun φ => φ.hom c) h2
    exact this
  have hsq : ((Limits.pullback.fst f β₀).residueFieldMap z).hom.comp
      ((f.residueFieldMap (Limits.pullback.fst f β₀ z)).hom.comp (P.residueFieldCongr hy).inv.hom) =
      (((Limits.pullback.snd f β₀).residueFieldMap z).hom.comp j).comp ιL := by
    ext c
    have e1 : (P.residueFieldCongr hy).hom.hom ((P.residueFieldCongr hy).inv.hom c) = c := by
      change ((P.residueFieldCongr hy).inv ≫ (P.residueFieldCongr hy).hom).hom c = c
      rw [Iso.inv_hom_id]
      rfl
    have e2 : (P.residueFieldCongr (rfl : β₀ (Limits.pullback.snd f β₀ z) =
        β₀ (Limits.pullback.snd f β₀ z))).inv.hom c = c := by
      rw [Scheme.residueFieldCongr_refl]
      rfl
    simp only [RingHom.comp_apply]
    rw [hcomm, hj, e1, e2]
  rintro _ ⟨a, rfl⟩
  obtain ⟨p, hp0, hpa, hsplit⟩ := hroots a
  have hne : p.map ιL ≠ 0 := (Polynomial.map_ne_zero_iff ιL.injective).mpr hp0
  have hroot : ((p.map ιL).map (((Limits.pullback.snd f β₀).residueFieldMap z).hom.comp j)).IsRoot
      (((Limits.pullback.fst f β₀).residueFieldMap z).hom a) := by
    rw [Polynomial.IsRoot.def, Polynomial.map_map, ← hsq, Polynomial.eval_map,
      ← Polynomial.hom_eval₂, hpa, map_zero]
  obtain ⟨r, hr⟩ := RingHom.mem_range.mp (hsplit.mem_range_of_isRoot hne hroot)
  exact ⟨j r, hr⟩

theorem wcpa_dj_ssm_rationalize : ∀ (k : Type u) [Field k] (X₁ P : Scheme.{u})
    [AlgebraicGeometry.IsIntegral X₁] [AlgebraicGeometry.IsIntegral P] (sP : P ⟶ Spec (.of k))
    [IsProper sP] (f : X₁ ⟶ P) (Y₀ : Finset X₁),
    (∀ y ∈ Y₀, f y = genericPoint P ∧ (f.residueFieldMap y).hom.Finite) →
    ∃ (P₀ : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral P₀) (β₀ : P₀ ⟶ P), IsProper β₀ ∧
      Surjective β₀ ∧ (∃ V : P.Opens, V ≠ ⊥ ∧ IsFinite (β₀ ∣_ V)) ∧
      β₀ (genericPoint P₀) = genericPoint P ∧
      ∃ S : Finset ↥(Limits.pullback f β₀),
        (∀ z ∈ S, Limits.pullback.snd f β₀ z = genericPoint P₀ ∧
          IsIso ((Limits.pullback.snd f β₀).residueFieldMap z)) ∧
        (∀ y ∈ Y₀, ∃ z ∈ S, Limits.pullback.fst f β₀ z = y) ∧
        ∀ z : ↥(Limits.pullback f β₀), Limits.pullback.snd f β₀ z = genericPoint P₀ →
          Limits.pullback.fst f β₀ z ∈ Y₀ → z ∈ S :=
by
  intro k _ X₁ P _ _ sP _ f Y₀ hY₀
  classical
  haveI : IsLocallyNoetherian P := LocallyOfFiniteType.isLocallyNoetherian sP
  haveI : CompactSpace P := QuasiCompact.compactSpace_of_compactSpace sP
  haveI : QuasiSeparatedSpace P := quasiSeparatedSpace_of_quasiSeparated sP

  have hφfin : ∀ i : ↥Y₀, ((f.residueFieldMap i.1).hom.comp
      (P.residueFieldCongr (hY₀ i.1 i.2).1).inv.hom).Finite := by
    intro i
    refine RingHom.Finite.comp (hY₀ i.1 i.2).2 (RingHom.Finite.of_surjective _ ?_)
    intro c
    refine ⟨(P.residueFieldCongr (hY₀ i.1 i.2).1).hom.hom c, ?_⟩
    change ((P.residueFieldCongr (hY₀ i.1 i.2).1).hom ≫
      (P.residueFieldCongr (hY₀ i.1 i.2).1).inv).hom c = c
    rw [Iso.hom_inv_id]
    rfl
  obtain ⟨L, iL, iA, iFD, hroots⟩ := wcpa_ssmr_splitting_field (P.residueField (genericPoint P))
    (↥Y₀) (fun i => X₁.residueField i.1)
    (fun i => (f.residueFieldMap i.1).hom.comp (P.residueFieldCongr (hY₀ i.1 i.2).1).inv.hom)
    hφfin

  obtain ⟨W₁, Y, εO, hW₁, hηW₁, hεfin, hεsurj, hYint, hεj⟩ := wcpa_ssmr_affine_model P L
  obtain ⟨P₀, iP₀, β₀, hβfin, hβsurj, hη, j, hj⟩ :=
    wcpa_ssmr_compactify P L W₁ Y εO hW₁ hηW₁ hεfin hεsurj hεj
  haveI := iP₀
  haveI := hβfin
  have hPne : (⊤ : P.Opens) ≠ ⊥ := by
    rw [TopologicalSpace.Opens.ne_bot_iff_nonempty]
    obtain ⟨p⟩ := (inferInstance : Nonempty P)
    exact ⟨p, trivial⟩

  have hZfin : ∀ y ∈ (Y₀ : Set X₁), {t : ↥(Limits.pullback f β₀) |
      Limits.pullback.fst f β₀ t = y ∧ Limits.pullback.snd f β₀ t = genericPoint P₀}.Finite := by
    intro y hy
    exact wcpa_ssmr_fibre_points_finite f β₀ y (genericPoint P₀) ((hY₀ y hy).1.trans hη.symm)
      (hY₀ y hy).2
  have hZall : (⋃ y ∈ (Y₀ : Set X₁), {t : ↥(Limits.pullback f β₀) |
      Limits.pullback.fst f β₀ t = y ∧ Limits.pullback.snd f β₀ t = genericPoint P₀}).Finite :=
    Set.Finite.biUnion Y₀.finite_toSet hZfin
  have hmem : ∀ t, t ∈ hZall.toFinset ↔ ∃ y ∈ Y₀, Limits.pullback.fst f β₀ t = y ∧
      Limits.pullback.snd f β₀ t = genericPoint P₀ := by
    intro t
    rw [Set.Finite.mem_toFinset, Set.mem_iUnion₂]
    simp only [Finset.mem_coe, Set.mem_setOf_eq, exists_prop]
  refine ⟨P₀, iP₀, β₀, inferInstance, hβsurj, ⟨⊤, hPne, inferInstance⟩, hη, hZall.toFinset,
    ?_, ?_, ?_⟩
  · intro z hz
    obtain ⟨y, hy, hfst, hsnd⟩ := (hmem z).mp hz
    refine ⟨hsnd, ?_⟩
    apply wcpa_ssmr_residue_iso_of_range
    exact wcpa_ssmr_range_of_splits f β₀ (genericPoint P) (genericPoint P₀) hη L
      (algebraMap (P.residueField (genericPoint P)) L) j hj y (hY₀ y hy).1
      (hroots ⟨y, hy⟩) z hfst hsnd
  · intro y hy
    obtain ⟨z, hz1, hz2⟩ := Scheme.Pullback.exists_preimage_pullback (f := f) (g := β₀) y
      (genericPoint P₀) ((hY₀ y hy).1.trans hη.symm)
    exact ⟨z, (hmem z).mpr ⟨y, hy, hz1, hz2⟩, hz1⟩
  · intro z hz hy
    exact (hmem z).mpr ⟨_, hy, rfl, hz⟩

theorem wcpa_dj_ssm_spread_section : ∀ {Y B : Scheme.{u}} [AlgebraicGeometry.IsIntegral B]
    (g : Y ⟶ B) [LocallyOfFiniteType g] (z : Y), g z = genericPoint B →
    IsIso (g.residueFieldMap z) →
    ∃ (W : B.Opens) (s : (W : Scheme.{u}) ⟶ Y) (hW : genericPoint B ∈ W),
      s ≫ g = W.ι ∧ s ⟨genericPoint B, hW⟩ = z :=
by
  intro Y B _ g _ z hz hiso
  classical
  haveI hr : IsIso (B.residue (genericPoint B)) := by
    rw [ConcreteCategory.isIso_iff_bijective]
    refine ⟨?_, Scheme.residue_surjective B (genericPoint B)⟩
    exact RingHom.injective (B.residue (genericPoint B)).hom
  haveI := hiso
  obtain ⟨ρ, hρ⟩ : ∃ ρ : B.presheaf.stalk (genericPoint B) ⟶ Y.residueField z,
      ρ = B.residue (genericPoint B) ≫ (B.residueFieldCongr hz.symm).hom ≫ g.residueFieldMap z :=
    ⟨_, rfl⟩
  haveI hρiso : IsIso ρ := by rw [hρ]; infer_instance
  obtain ⟨φ, hφ⟩ : ∃ φ : Spec (B.presheaf.stalk (genericPoint B)) ⟶ Y,
      φ = Spec.map (inv ρ) ≫ Y.fromSpecResidueField z := ⟨_, rfl⟩
  have hSρ : Spec.map ρ = Spec.map (g.residueFieldMap z) ≫
      Spec.map (B.residueFieldCongr hz.symm).hom ≫ Spec.map (B.residue (genericPoint B)) := by
    rw [hρ, Spec.map_comp, Spec.map_comp, Category.assoc]
  have hφg : φ ≫ g = B.fromSpecStalk (genericPoint B) ≫ 𝟙 B := by
    rw [Category.comp_id, hφ, Category.assoc,
      ← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField,
      ← Scheme.residueFieldCongr_fromSpecResidueField hz.symm, Scheme.fromSpecResidueField]
    have e : Spec.map (inv ρ) ≫ Spec.map (g.residueFieldMap z) ≫
        Spec.map (B.residueFieldCongr hz.symm).hom ≫ Spec.map (B.residue (genericPoint B)) =
        𝟙 _ := by
      rw [← hSρ, ← Spec.map_comp, IsIso.hom_inv_id, Spec.map_id]
    calc Spec.map (inv ρ) ≫ Spec.map (g.residueFieldMap z) ≫
          Spec.map (B.residueFieldCongr hz.symm).hom ≫ Spec.map (B.residue (genericPoint B)) ≫
          B.fromSpecStalk (genericPoint B)
        = (Spec.map (inv ρ) ≫ Spec.map (g.residueFieldMap z) ≫
          Spec.map (B.residueFieldCongr hz.symm).hom ≫ Spec.map (B.residue (genericPoint B))) ≫
          B.fromSpecStalk (genericPoint B) := by simp only [Category.assoc]
      _ = B.fromSpecStalk (genericPoint B) := by rw [e, Category.id_comp]
  obtain ⟨U, hU, f, hφf, hfg⟩ := spread_out_of_isGermInjective' (𝟙 B) g φ hφg
  refine ⟨U, f, hU, by rw [hfg, Category.comp_id], ?_⟩
  have h1 : (U.fromSpecStalkOfMem (genericPoint B) hU ≫ U.ι)
      (IsLocalRing.closedPoint (B.presheaf.stalk (genericPoint B))) =
      B.fromSpecStalk (genericPoint B)
        (IsLocalRing.closedPoint (B.presheaf.stalk (genericPoint B))) := by
    rw [Scheme.Opens.fromSpecStalkOfMem_ι]
  have hq : U.fromSpecStalkOfMem (genericPoint B) hU
      (IsLocalRing.closedPoint (B.presheaf.stalk (genericPoint B))) = ⟨genericPoint B, hU⟩ := by
    apply Subtype.ext
    show U.ι (U.fromSpecStalkOfMem (genericPoint B) hU
      (IsLocalRing.closedPoint (B.presheaf.stalk (genericPoint B)))) = genericPoint B
    exact (Scheme.Hom.comp_apply _ _ _).symm.trans (h1.trans (Scheme.fromSpecStalk_closedPoint))
  have h2 : (U.fromSpecStalkOfMem (genericPoint B) hU ≫ f)
      (IsLocalRing.closedPoint (B.presheaf.stalk (genericPoint B))) = z := by
    rw [← hφf, hφ]
    exact (Scheme.Hom.comp_apply _ _ _).trans (Scheme.fromSpecResidueField_apply _ _)
  rw [← hq]
  exact (Scheme.Hom.comp_apply _ _ _).symm.trans h2

theorem wcpa_dj_ssm_extend_sections : ∀ (B Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral B]
    (g : Y ⟶ B) [IsProper g] (n : ℕ) (W : Fin n → B.Opens) (s : ∀ i, ((W i : Scheme.{u}) ⟶ Y))
    (hW : ∀ i, genericPoint B ∈ W i), (∀ i, s i ≫ g = (W i).ι) →
    ∃ (B' : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral B') (ρ : B' ⟶ B) (t : Fin n → (B' ⟶ Y)),
      IsProper ρ ∧ Surjective ρ ∧ (∃ V : B.Opens, V ≠ ⊥ ∧ IsFinite (ρ ∣_ V)) ∧
      (∀ i, t i ≫ g = ρ) ∧ ∀ i, t i (genericPoint B') = s i ⟨genericPoint B, hW i⟩ :=
by
  classical
  have gen_of_surj : ∀ {A B : Scheme.{u}} [AlgebraicGeometry.IsIntegral A]
      [AlgebraicGeometry.IsIntegral B] (φ : A ⟶ B), Surjective φ →
      φ (genericPoint A) = genericPoint B := by
    intro A B _ _ φ hφ
    haveI := hφ
    have h1 : IsGenericPoint (φ (genericPoint A)) Set.univ := by
      rw [isGenericPoint_iff_specializes]
      intro y
      simp only [Set.mem_univ, iff_true]
      obtain ⟨x, rfl⟩ := φ.surjective y
      exact ((genericPoint_spec A).specializes (Set.mem_univ x)).map φ.continuous
    exact h1.eq (genericPoint_spec B)

  have liftCI : ∀ (R S C : Scheme.{u}) [IsReduced R] (a : R ⟶ S)
      (j : C ⟶ S) [IsClosedImmersion j], Set.range ⇑a ⊆ Set.range ⇑j → ∃ b : R ⟶ C, b ≫ j = a := by
    intro R S C _ a j _ hrange
    have H : Scheme.Hom.ker j ≤ Scheme.Hom.ker a := by
      rw [Scheme.Hom.ker.eq_1 a, Scheme.IdealSheafData.le_ofIdeals_iff]
      intro U s hs
      rw [Scheme.Hom.ker_apply, RingHom.mem_ker] at hs
      rw [RingHom.mem_ker]
      apply eq_zero_of_basicOpen_eq_bot
      rw [← Scheme.Hom.preimage_basicOpen]
      have hj : j ⁻¹ᵁ S.basicOpen s = ⊥ := by
        rw [Scheme.Hom.preimage_basicOpen, hs, Scheme.basicOpen_zero]
      rw [← TopologicalSpace.Opens.not_nonempty_iff_eq_bot]
      rintro ⟨x, hx⟩
      obtain ⟨c, hc⟩ := hrange ⟨x, rfl⟩
      have hc' : c ∈ j ⁻¹ᵁ S.basicOpen s := by
        show j c ∈ S.basicOpen s
        rw [hc]
        exact hx
      rw [hj] at hc'
      exact hc'
    exact ⟨IsClosedImmersion.lift j a H, IsClosedImmersion.lift_fac j a H⟩

  have altComp : ∀ {X Y W : Scheme.{u}} [AlgebraicGeometry.IsIntegral X]
      [AlgebraicGeometry.IsIntegral Y] (φ : Y ⟶ X) (ψ : W ⟶ Y), IsProper φ → Surjective φ →
      Surjective ψ → (∃ V : X.Opens, V ≠ ⊥ ∧ IsFinite (φ ∣_ V)) →
      (∃ V : Y.Opens, V ≠ ⊥ ∧ IsFinite (ψ ∣_ V)) →
      Surjective (ψ ≫ φ) ∧ ∃ V : X.Opens, V ≠ ⊥ ∧ IsFinite ((ψ ≫ φ) ∣_ V) := by
    intro X Y W _ _ φ ψ hφp hφs hψs ⟨V, hV0, hVfin⟩ ⟨V', hV'0, hV'fin⟩
    haveI := hφp
    haveI := hφs
    haveI := hψs
    refine ⟨inferInstance, ?_⟩
    have rmono : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (U U₁ : B.Opens), U ≤ U₁ →
        IsFinite (f ∣_ U₁) → IsFinite (f ∣_ U) := by
      intro A B f U U₁ hUV h
      have hR : MorphismProperty.RespectsIso (@IsFinite : MorphismProperty Scheme.{u}) :=
        MorphismProperty.respectsIso_of_isStableUnderComposition
          (fun _ _ f (_ : MorphismProperty.isomorphisms Scheme f) => (inferInstance : IsFinite f))
      have heq : U₁.ι ''ᵁ (U₁.ι ⁻¹ᵁ U) = U := by
        rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
        exact inf_eq_right.mpr hUV
      have e := morphismRestrictRestrict f U₁ (U₁.ι ⁻¹ᵁ U) ≪≫ morphismRestrictEq f heq
      exact (MorphismProperty.arrow_mk_iso_iff (@IsFinite : MorphismProperty Scheme.{u}) e).mp
        inferInstance
    have hgen : ∀ (T : Scheme.{u}) [IrreducibleSpace T] (U : T.Opens), U ≠ ⊥ →
        genericPoint T ∈ U := by
      intro T _ U hU
      obtain ⟨x, hx⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).mp hU
      exact (genericPoint_specializes x).mem_open U.isOpen hx
    have hηmap : φ (genericPoint Y) = genericPoint X := by
      have h1 := (genericPoint_spec Y).image φ.continuous
      simp only [Set.image_univ_of_surjective φ.surjective, closure_univ] at h1
      have h2 := genericPoint_spec X
      exact h1.eq h2
    have hC : IsClosed (φ '' (V' : Set Y)ᶜ) := φ.isClosedMap _ V'.isOpen.isClosed_compl
    have hnot : genericPoint X ∉ φ '' (V' : Set Y)ᶜ := by
      rintro ⟨z, hz, hzη⟩
      have hηV : genericPoint X ∈ V := hgen X V hV0
      have hzS : z ∈ φ ⁻¹ᵁ V := by rw [Scheme.Hom.mem_preimage, hzη]; exact hηV
      have haS : genericPoint Y ∈ φ ⁻¹ᵁ V := by rw [Scheme.Hom.mem_preimage, hηmap]; exact hηV
      let a : (φ ⁻¹ᵁ V).toScheme := ⟨genericPoint Y, haS⟩
      let b : (φ ⁻¹ᵁ V).toScheme := ⟨z, hzS⟩
      have hab : (φ ∣_ V) a = (φ ∣_ V) b := by
        apply Subtype.ext
        exact (morphismRestrict_base_coe φ V a).trans
          (hηmap.trans (hzη.symm.trans (morphismRestrict_base_coe φ V b).symm))
      have hsp : a ⤳ b := by
        apply ((φ ⁻¹ᵁ V).ι.isOpenEmbedding.isInducing.specializes_iff).mp
        have e1 : (φ ⁻¹ᵁ V).ι a = genericPoint Y := Scheme.Opens.ι_apply _ _
        have e2 : (φ ⁻¹ᵁ V).ι b = z := Scheme.Opens.ι_apply _ _
        rw [e1, e2]
        exact genericPoint_specializes z
      haveI : DiscreteTopology ((φ ∣_ V) ⁻¹' {(φ ∣_ V) a}) :=
        ((φ ∣_ V).isDiscrete_preimage_singleton ((φ ∣_ V) a)).to_subtype
      have hsp' : (⟨a, rfl⟩ : ((φ ∣_ V) ⁻¹' {(φ ∣_ V) a})) ⤳ ⟨b, hab.symm⟩ :=
        (subtype_specializes_iff _ _).mpr hsp
      have hab' : a = b := congrArg Subtype.val hsp'.eq
      have hzY : genericPoint Y = z := congrArg Subtype.val hab'
      exact hz (hzY ▸ hgen Y V' hV'0)
    let O : X.Opens := ⟨(φ '' (V' : Set Y)ᶜ)ᶜ, hC.isOpen_compl⟩
    refine ⟨V ⊓ O, ?_, ?_⟩
    · rw [TopologicalSpace.Opens.ne_bot_iff_nonempty]
      exact ⟨genericPoint X, TopologicalSpace.Opens.mem_inf.mpr ⟨hgen X V hV0, hnot⟩⟩
    · rw [morphismRestrict_comp]
      have hle : φ ⁻¹ᵁ (V ⊓ O) ≤ V' := by
        intro y hy
        have hy' : φ y ∈ V ⊓ O := hy
        by_contra hyV
        exact (TopologicalSpace.Opens.mem_inf.mp hy').2 ⟨y, hyV, rfl⟩
      have h1 := rmono ψ _ _ hle hV'fin
      have h2 := rmono φ (V ⊓ O) V inf_le_left hVfin
      exact MorphismProperty.comp_mem (@IsFinite) _ _ h1 h2

  have isoRestrict : ∀ (Y' Y : Scheme.{u}) (π : Y' ⟶ Y) [IsSeparated π] (U : Y.Opens)
      (δ : (U : Scheme.{u}) ⟶ Y'), (∀ W : Y'.Opens, Function.Injective (δ.app W)) →
      δ ≫ π = U.ι → IsIso (π ∣_ U) := by
    intro Y' Y π _ U δ hinj hδπ
    have s1 : ∀ {X Z : Scheme.{u}} (f : X ⟶ Z) [IsClosedImmersion f],
        (∀ V : Z.Opens, Function.Injective (f.app V)) → IsIso f := by
      intro X Z f _ hf
      have hP : MorphismProperty.isomorphisms Scheme f := by
        rw [IsZariskiLocalAtTarget.iff_of_iSup_eq_top (P := MorphismProperty.isomorphisms Scheme)
          (fun V : Z.affineOpens => (V : Z.Opens)) (iSup_affineOpens_eq_top Z)]
        intro V
        haveI : IsAffine (V : Z.Opens) := V.2
        haveI : IsClosedImmersion (f ∣_ (V : Z.Opens)) :=
          IsZariskiLocalAtTarget.restrict (P := @IsClosedImmersion) inferInstance _
        have hbij : ∀ {A B : X.Opens} (h : A = B),
            Function.Bijective (X.presheaf.map (eqToHom h).op) := by
          intro A B h
          subst h
          rw [eqToHom_refl, op_id, CategoryTheory.Functor.map_id]
          exact ConcreteCategory.bijective_of_isIso _
        have hinjV : Function.Injective (f ∣_ (V : Z.Opens)).appTop := by
          rw [morphismRestrict_appTop]
          intro a b hab
          exact hf _ ((hbij _).1 hab)
        exact IsClosedImmersion.isIso_of_injective_of_isAffine hinjV
      exact hP
    have hrange : Set.range δ ⊆ Set.range (π ⁻¹ᵁ U).ι := by
      rintro _ ⟨x, rfl⟩
      rw [Scheme.Opens.range_ι]
      show π (δ x) ∈ (U : Set Y)
      rw [← Scheme.Hom.comp_apply, hδπ]
      have hx : U.ι x ∈ Set.range U.ι := ⟨x, rfl⟩
      rwa [Scheme.Opens.range_ι] at hx
    obtain ⟨δ', hfac⟩ : ∃ δ' : (U : Scheme.{u}) ⟶ (π ⁻¹ᵁ U : Scheme.{u}),
        δ' ≫ (π ⁻¹ᵁ U).ι = δ := ⟨_, IsOpenImmersion.lift_fac _ _ hrange⟩
    subst hfac
    have hsec : δ' ≫ π ∣_ U = 𝟙 _ := by
      rw [← cancel_mono U.ι, Category.assoc, morphismRestrict_ι, ← Category.assoc, hδπ,
        Category.id_comp]
    haveI : IsSeparated (π ∣_ U) := IsZariskiLocalAtTarget.restrict (P := @IsSeparated) ‹_› U
    haveI : IsClosedImmersion (δ' ≫ π ∣_ U) := by rw [hsec]; infer_instance
    haveI : IsClosedImmersion δ' := IsClosedImmersion.of_comp δ' (π ∣_ U)
    have hinj' : ∀ W' : (π ⁻¹ᵁ U : Scheme.{u}).Opens, Function.Injective (δ'.app W') := by
      intro W'
      have h1 := Scheme.Hom.comp_app δ' (π ⁻¹ᵁ U).ι ((π ⁻¹ᵁ U).ι ''ᵁ W')
      haveI := Scheme.Hom.isIso_app (π ⁻¹ᵁ U).ι ((π ⁻¹ᵁ U).ι ''ᵁ W')
        (Scheme.Hom.image_le_opensRange _ W')
      have hsurj := (ConcreteCategory.bijective_of_isIso
        ((π ⁻¹ᵁ U).ι.app ((π ⁻¹ᵁ U).ι ''ᵁ W'))).2
      have key : Function.Injective (δ'.app ((π ⁻¹ᵁ U).ι ⁻¹ᵁ ((π ⁻¹ᵁ U).ι ''ᵁ W'))) := by
        intro a b hab
        obtain ⟨a', rfl⟩ := hsurj a
        obtain ⟨b', rfl⟩ := hsurj b
        have h2 : (δ' ≫ (π ⁻¹ᵁ U).ι).app ((π ⁻¹ᵁ U).ι ''ᵁ W') a' =
            (δ' ≫ (π ⁻¹ᵁ U).ι).app ((π ⁻¹ᵁ U).ι ''ᵁ W') b' := by
          first
            | exact hab
            | (rw [h1]; exact hab)
        rw [hinj _ h2]
      rwa [Scheme.Hom.preimage_image_eq] at key
    haveI : IsIso δ' := s1 δ' hinj'
    haveI : IsIso (δ' ≫ π ∣_ U) := by rw [hsec]; infer_instance
    exact IsIso.of_isIso_comp_left δ' (π ∣_ U)

  have hS : ∀ (B Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral B] (g : Y ⟶ B) [IsProper g]
      (W : B.Opens) (s : (W : Scheme.{u}) ⟶ Y) (hW : genericPoint B ∈ W), s ≫ g = W.ι →
      ∃ (Γ : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral Γ) (ρ : Γ ⟶ B) (t : Γ ⟶ Y),
        IsProper ρ ∧ Surjective ρ ∧ (∃ V : B.Opens, V ≠ ⊥ ∧ IsFinite (ρ ∣_ V)) ∧
        t ≫ g = ρ ∧ t (genericPoint Γ) = s ⟨genericPoint B, hW⟩ := by
    intro B Y _ g _ W s hW hs
    let η : (W : Scheme.{u}) := ⟨genericPoint B, hW⟩
    obtain ⟨ξ, hξ⟩ : ∃ ξ : Y, ξ = s η := ⟨_, rfl⟩
    have hgξ : g ξ = genericPoint B := by
      rw [hξ, ← Scheme.Hom.comp_apply, hs, Scheme.Opens.ι_apply]
    let Z : TopologicalSpace.Closeds Y := ⟨closure {ξ}, isClosed_closure⟩
    let J : Y.IdealSheafData := (Scheme.IdealSheafData.vanishingIdeal Z).radical
    have hJr : Set.range J.subschemeι = closure {ξ} := by
      rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.support_radical,
        Scheme.IdealSheafData.coe_support_vanishingIdeal]
      rfl
    have hring : ∀ U : Y.affineOpens, _root_.IsReduced (Γ(Y, U) ⧸ J.ideal U) := fun U =>
      (Ideal.isRadical_iff_quotient_reduced _).mp
        (by
          show ((Scheme.IdealSheafData.vanishingIdeal Z).radical.ideal U).IsRadical
          rw [Scheme.IdealSheafData.radical_ideal]
          exact Ideal.radical_isRadical _)
    have hpieces : ∀ i, IsReduced (J.subschemeCover.openCover.X i) := fun (U : Y.affineOpens) => by
      haveI := hring U
      exact (inferInstance : IsReduced (Spec (CommRingCat.of (Γ(Y, (U : Y.Opens)) ⧸ J.ideal U))))
    have hJred : IsReduced J.subscheme := IsReduced.of_openCover _ J.subschemeCover.openCover
    obtain ⟨R, ι, hιci, hιr, hRred⟩ : ∃ (R : Scheme.{u}) (ι : R ⟶ Y),
        IsClosedImmersion ι ∧ Set.range ι = closure {ξ} ∧ IsReduced R :=
      ⟨J.subscheme, J.subschemeι, inferInstance, hJr, hJred⟩
    haveI := hιci
    haveI := hRred
    have hιemb := IsClosedImmersion.isClosedEmbedding ι
    obtain ⟨x₀, hx₀⟩ : ξ ∈ Set.range ι := by rw [hιr]; exact subset_closure rfl
    have hgen : IsGenericPoint x₀ Set.univ := by
      rw [isGenericPoint_iff_specializes]
      intro x
      simp only [Set.mem_univ, iff_true]
      have h1 : ι x ∈ closure {ξ} := by rw [← hιr]; exact ⟨x, rfl⟩
      rw [← specializes_iff_mem_closure, ← hx₀] at h1
      exact hιemb.isInducing.specializes_iff.mp h1
    haveI : IrreducibleSpace R := by
      rw [irreducibleSpace_def]; exact hgen.isIrreducible
    haveI hRint : AlgebraicGeometry.IsIntegral R := isIntegral_of_irreducibleSpace_of_isReduced R
    have hgR : genericPoint R = x₀ := (genericPoint_spec R).eq hgen
    have hιξ : ι (genericPoint R) = ξ := by rw [hgR, hx₀]
    have hrange : Set.range s ⊆ Set.range ι := by
      rw [hιr]
      rintro _ ⟨w, rfl⟩
      have h1 : η ⤳ w := by
        apply (W.ι.isOpenEmbedding.isInducing.specializes_iff).mp
        have e1 : W.ι η = genericPoint B := Scheme.Opens.ι_apply _ _
        rw [e1]
        exact (genericPoint_spec B).specializes (Set.mem_univ _)
      rw [hξ]
      exact specializes_iff_mem_closure.mp (h1.map s.continuous)
    obtain ⟨δ, hδ⟩ := liftCI (W : Scheme.{u}) Y R s ι hrange
    have hδρ : δ ≫ (ι ≫ g) = W.ι := by rw [← Category.assoc, hδ, hs]
    have hδη : δ η = genericPoint R := by
      apply hιemb.injective
      rw [← Scheme.Hom.comp_apply, hδ, hιξ, hξ]
    have hdense : DenseRange δ := by
      have h1 : closure ({genericPoint R} : Set R) = Set.univ :=
        isGenericPoint_def.mp (genericPoint_spec R)
      refine dense_iff_closure_eq.mpr (Set.eq_univ_of_univ_subset ?_)
      rw [← h1]
      exact closure_mono (Set.singleton_subset_iff.mpr ⟨η, hδη⟩)
    have hinj : ∀ U : R.Opens, Function.Injective (δ.app U) := by
      intro U
      refine (injective_iff_map_eq_zero (ConcreteCategory.hom (δ.app U))).mpr ?_
      intro a ha
      apply eq_zero_of_basicOpen_eq_bot
      by_contra hne
      obtain ⟨x, hx, ⟨y, rfl⟩⟩ := hdense.inter_open_nonempty _ (R.basicOpen a).isOpen
        ((TopologicalSpace.Opens.ne_bot_iff_nonempty _).mp hne)
      have h2 : y ∈ δ ⁻¹ᵁ R.basicOpen a := (Scheme.Hom.mem_preimage δ).mpr hx
      rw [Scheme.preimage_basicOpen, ha, Scheme.basicOpen_zero] at h2
      exact h2
    haveI := isoRestrict R B (ι ≫ g) W δ hinj hδρ
    refine ⟨R, hRint, ι ≫ g, ι, inferInstance, ?_, ⟨W, ?_, inferInstance⟩, rfl, ?_⟩
    · refine Surjective.mk ?_
      intro b
      have hcl : IsClosed (Set.range (ι ≫ g)) := (ι ≫ g).isClosedMap.isClosed_range
      have hmem : genericPoint B ∈ Set.range (ι ≫ g) :=
        ⟨genericPoint R, by rw [Scheme.Hom.comp_apply, hιξ, hgξ]⟩
      exact ((genericPoint_spec B).specializes (Set.mem_univ b)).mem_closed hcl hmem
    · exact (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mpr ⟨_, hW⟩
    · rw [hιξ, hξ]

  have main : ∀ (n : ℕ) (B Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral B]
      (g : Y ⟶ B) [IsProper g] (W : Fin n → B.Opens) (s : ∀ i, ((W i : Scheme.{u}) ⟶ Y))
      (hW : ∀ i, genericPoint B ∈ W i), (∀ i, s i ≫ g = (W i).ι) →
      ∃ (B' : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral B') (ρ : B' ⟶ B)
        (t : Fin n → (B' ⟶ Y)),
        IsProper ρ ∧ Surjective ρ ∧ (∃ V : B.Opens, V ≠ ⊥ ∧ IsFinite (ρ ∣_ V)) ∧
        (∀ i, t i ≫ g = ρ) ∧ ∀ i, t i (genericPoint B') = s i ⟨genericPoint B, hW i⟩ := by
    intro n
    induction n with
    | zero =>
      intro B Y _ g _ W s hW hs
      refine ⟨B, inferInstance, 𝟙 B, fun i => i.elim0, inferInstance, inferInstance,
        ⟨⊤, ?_, inferInstance⟩, fun i => i.elim0, fun i => i.elim0⟩
      exact (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mpr ⟨genericPoint B, trivial⟩
    | succ n ih =>
      intro B Y _ g _ W s hW hs
      obtain ⟨B₀, iB₀, ρ₀, t₀, hρ₀p, hρ₀s, hρ₀f, ht₀, ht₀η⟩ :=
        hS B Y g (W 0) (s 0) (hW 0) (hs 0)
      haveI := iB₀
      haveI := hρ₀p
      have hη₀ : ρ₀ (genericPoint B₀) = genericPoint B := gen_of_surj ρ₀ hρ₀s
      have hW' : ∀ i : Fin n, genericPoint B₀ ∈ ρ₀ ⁻¹ᵁ W i.succ := fun i => by
        rw [Scheme.Hom.mem_preimage, hη₀]; exact hW i.succ
      have hcond : ∀ i : Fin n, ((ρ₀ ∣_ W i.succ) ≫ s i.succ) ≫ g =
          (ρ₀ ⁻¹ᵁ W i.succ).ι ≫ ρ₀ := fun i => by
        rw [Category.assoc, hs i.succ, morphismRestrict_ι]
      obtain ⟨s', hs'snd, hs'fst⟩ : ∃ s' : ∀ i : Fin n,
          ((ρ₀ ⁻¹ᵁ W i.succ : B₀.Opens) : Scheme.{u}) ⟶ Limits.pullback g ρ₀,
          (∀ i, s' i ≫ Limits.pullback.snd g ρ₀ = (ρ₀ ⁻¹ᵁ W i.succ).ι) ∧
          (∀ i, s' i ≫ Limits.pullback.fst g ρ₀ = (ρ₀ ∣_ W i.succ) ≫ s i.succ) :=
        ⟨fun i => Limits.pullback.lift _ _ (hcond i), fun i => Limits.pullback.lift_snd _ _ _,
          fun i => Limits.pullback.lift_fst _ _ _⟩
      obtain ⟨B', iB', ρ₁, t', hρ₁p, hρ₁s, hρ₁f, ht', ht'η⟩ :=
        ih B₀ (Limits.pullback g ρ₀) (Limits.pullback.snd g ρ₀) (fun i => ρ₀ ⁻¹ᵁ W i.succ) s'
          hW' hs'snd
      haveI := iB'
      haveI := hρ₁p
      have hη₁ : ρ₁ (genericPoint B') = genericPoint B₀ := gen_of_surj ρ₁ hρ₁s
      obtain ⟨hsurj, hfin⟩ := altComp ρ₀ ρ₁ hρ₀p hρ₀s hρ₁s hρ₀f hρ₁f
      refine ⟨B', iB', ρ₁ ≫ ρ₀,
        Fin.cases (ρ₁ ≫ t₀) (fun i => t' i ≫ Limits.pullback.fst g ρ₀),
        inferInstance, hsurj, hfin, ?_, ?_⟩
      · intro i
        induction i using Fin.cases with
        | zero =>
          show (ρ₁ ≫ t₀) ≫ g = ρ₁ ≫ ρ₀
          rw [Category.assoc, ht₀]
        | succ i =>
          show (t' i ≫ Limits.pullback.fst g ρ₀) ≫ g = ρ₁ ≫ ρ₀
          rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, ht' i]
      · intro i
        induction i using Fin.cases with
        | zero =>
          show (ρ₁ ≫ t₀) (genericPoint B') = _
          rw [Scheme.Hom.comp_apply, hη₁, ht₀η]
        | succ i =>
          show (t' i ≫ Limits.pullback.fst g ρ₀) (genericPoint B') = _
          have key : ∀ x, Limits.pullback.fst g ρ₀ (s' i x) = s i.succ ((ρ₀ ∣_ W i.succ) x) :=
            fun x => by rw [← Scheme.Hom.comp_apply, hs'fst i, Scheme.Hom.comp_apply]
          rw [Scheme.Hom.comp_apply, ht'η i]
          refine (key _).trans ?_
          congr 1
          apply Subtype.ext
          exact (morphismRestrict_base_coe _ _ _).trans hη₀
  intro B Y _ g _ n W s hW hs
  exact main n B Y g W s hW hs

theorem wcpa_dj_sst_fibre_irreducible : ∀ {Y B : Scheme.{u}} (g : Y ⟶ B) (n : ℕ),
    SmoothOfRelativeDimension n g → GeometricallyConnected g → ∀ b : B, IsIrreducible (⇑g ⁻¹' {b}) :=
by
  intro Y B g n hsm hgc b
  haveI := hsm
  have hpb : IsPullback (Limits.pullback.fst g (B.fromSpecResidueField b))
      (Limits.pullback.snd g (B.fromSpecResidueField b)) g (B.fromSpecResidueField b) :=
    IsPullback.of_hasPullback _ _
  haveI hconn : ConnectedSpace ↥(Limits.pullback g (B.fromSpecResidueField b)) :=
    GeometricallyConnected.geometrically_connectedSpace (f := g) (B.fromSpecResidueField b)
      (Limits.pullback.fst g _) (Limits.pullback.snd g _) hpb
  haveI hsm' : SmoothOfRelativeDimension n (Limits.pullback.snd g (B.fromSpecResidueField b)) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension n) hpb hsm
  haveI : Smooth (Limits.pullback.snd g (B.fromSpecResidueField b)) :=
    SmoothOfRelativeDimension.smooth n _
  haveI : LocallyOfFiniteType (Limits.pullback.snd g (B.fromSpecResidueField b)) := inferInstance
  haveI : IsLocallyNoetherian (Limits.pullback g (B.fromSpecResidueField b)) :=
    LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd g (B.fromSpecResidueField b))
  haveI hirr : IrreducibleSpace ↥(Limits.pullback g (B.fromSpecResidueField b)) :=
    wcpa_irreducible_of_connected_domain_stalks _
      (wcpa_smooth_stalk_isDomain (↑(B.residueField b)) _
        (Limits.pullback.snd g (B.fromSpecResidueField b)) n)
  have hrange : Set.range ⇑(Limits.pullback.fst g (B.fromSpecResidueField b)) = ⇑g ⁻¹' {b} := by
    rw [Scheme.Pullback.range_fst, Scheme.range_fromSpecResidueField]
  have h1 := (IrreducibleSpace.isIrreducible_univ
    ↥(Limits.pullback g (B.fromSpecResidueField b))).image
    (Limits.pullback.fst g (B.fromSpecResidueField b))
    (Limits.pullback.fst g (B.fromSpecResidueField b)).continuous.continuousOn
  rw [Set.image_univ, hrange] at h1
  exact h1

theorem wcpa_dj_sst_closure_subscheme : ∀ (Q : Scheme.{u}) (O : Q.Opens),
    AlgebraicGeometry.IsIntegral (O : Scheme.{u}) →
    ∃ (X₂ : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral X₂) (ι : X₂ ⟶ Q),
      IsClosedImmersion ι ∧ (O : Set Q) ⊆ Set.range ⇑ι ∧ IsIso (ι ∣_ O) :=
by
  intro Q O hO

  have hred : ∀ (C : Scheme.{u}), ∃ (R : Scheme.{u}) (r : R ⟶ C),
      IsClosedImmersion r ∧ Set.range r = Set.univ ∧ IsReduced R := by
    intro C
    let J : C.IdealSheafData := (⊥ : C.IdealSheafData).radical
    have h2 : Set.range J.subschemeι = Set.univ := by
      rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.support_radical,
        Scheme.IdealSheafData.support_bot, TopologicalSpace.Closeds.coe_top]
    have hring : ∀ U : C.affineOpens, _root_.IsReduced (Γ(C, U) ⧸ J.ideal U) := fun U =>
      (Ideal.isRadical_iff_quotient_reduced _).mp
        (by
          show ((⊥ : C.IdealSheafData).radical.ideal U).IsRadical
          rw [Scheme.IdealSheafData.radical_ideal]
          exact Ideal.radical_isRadical _)
    have hpieces : ∀ i, IsReduced (J.subschemeCover.openCover.X i) := fun (U : C.affineOpens) => by
      haveI := hring U
      exact (inferInstance : IsReduced (Spec (CommRingCat.of (Γ(C, (U : C.Opens)) ⧸ J.ideal U))))
    have h3 : IsReduced J.subscheme := IsReduced.of_openCover _ J.subschemeCover.openCover
    exact ⟨J.subscheme, J.subschemeι, inferInstance, h2, h3⟩

  let Z : TopologicalSpace.Closeds Q := ⟨closure (O : Set Q), isClosed_closure⟩
  let J : Q.IdealSheafData := Scheme.IdealSheafData.vanishingIdeal Z
  have hsrange : Set.range J.subschemeι = closure (O : Set Q) := by
    rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.coe_support_vanishingIdeal]
    rfl
  obtain ⟨R, r, hr, hrr, hR⟩ := hred J.subscheme
  haveI := hr
  haveI := hR

  let ι : R ⟶ Q := r ≫ J.subschemeι
  haveI hι : IsClosedImmersion ι := inferInstance

  have hιrange : Set.range ι = closure (O : Set Q) := by
    rw [← hsrange]
    ext q
    constructor
    · rintro ⟨x, rfl⟩
      exact ⟨r x, (Scheme.Hom.comp_apply r J.subschemeι x).symm⟩
    · rintro ⟨y, rfl⟩
      have hy : y ∈ Set.range r := by rw [hrr]; exact Set.mem_univ y
      obtain ⟨x, rfl⟩ := hy
      exact ⟨x, Scheme.Hom.comp_apply r J.subschemeι x⟩
  have hOsub : (O : Set Q) ⊆ Set.range ι := by
    rw [hιrange]; exact subset_closure

  haveI : IrreducibleSpace (O : Scheme.{u}) := inferInstance
  have hOirr : IsIrreducible (O : Set Q) := by
    have h1 : IsIrreducible (Set.univ : Set (O : Scheme.{u})) :=
      IrreducibleSpace.isIrreducible_univ _
    have h2 := h1.image _ O.ι.continuous.continuousOn
    rwa [Set.image_univ, Scheme.Opens.range_ι] at h2
  have hZirr : IsIrreducible (Set.range ι) := by
    rw [hιrange]; exact hOirr.closure

  have hemb : Topology.IsEmbedding ι := (IsClosedImmersion.isClosedEmbedding ι).isEmbedding
  haveI : IrreducibleSpace (Set.range ι) := Subtype.irreducibleSpace hZirr
  haveI hRirr : IrreducibleSpace R :=
    Function.Surjective.irreducibleSpace hemb.toHomeomorph.symm.continuous
      hemb.toHomeomorph.symm.surjective

  haveI hRint : AlgebraicGeometry.IsIntegral R := isIntegral_of_irreducibleSpace_of_isReduced R

  have hsurj : Surjective (ι ∣_ O) := by
    refine ⟨fun o => ?_⟩
    obtain ⟨y, hy⟩ := hOsub o.2
    have hyO : y ∈ ι ⁻¹ᵁ O := by
      rw [Scheme.Hom.mem_preimage, hy]; exact o.2
    let x' : (ι ⁻¹ᵁ O : Scheme.{u}) := ⟨y, hyO⟩
    refine ⟨x', ?_⟩
    have e : ((ι ∣_ O) ≫ O.ι) x' = ((ι ⁻¹ᵁ O).ι ≫ ι) x' := by rw [morphismRestrict_ι]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at e
    have e' : ((ι ∣_ O) x').1 = ι y := e
    exact Subtype.ext (e'.trans hy)

  haveI := hsurj
  haveI : IsReduced (O : Scheme.{u}) := inferInstance
  have hiso : IsIso (ι ∣_ O) := isIso_of_isClosedImmersion_of_surjective _
  exact ⟨R, hRint, ι, hι, hOsub, hiso⟩

theorem wcpa_dj_ssm_strict_transform : ∀ (X₁ P P₁ : Scheme.{u}) [AlgebraicGeometry.IsIntegral X₁]
    [AlgebraicGeometry.IsIntegral P] [AlgebraicGeometry.IsIntegral P₁] (f : X₁ ⟶ P) [IsProper f]
    (β : P₁ ⟶ P) (U : P.Opens), U ≠ ⊥ → SmoothOfRelativeDimension 1 (f ∣_ U) →
    GeometricallyConnected (f ∣_ U) → IsProper β → Surjective β →
    (∃ V : P.Opens, V ≠ ⊥ ∧ IsFinite (β ∣_ V)) →
    ∃ (X₂ : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral X₂) (ι : X₂ ⟶ Limits.pullback f β),
      IsClosedImmersion ι ∧
      ⇑(Limits.pullback.snd f β) ⁻¹' (⇑β ⁻¹' (U : Set P)) ⊆ Set.range ⇑ι ∧
      SmoothOfRelativeDimension 1 ((ι ≫ Limits.pullback.snd f β) ∣_ (β ⁻¹ᵁ U)) ∧
      GeometricallyConnected ((ι ≫ Limits.pullback.snd f β) ∣_ (β ⁻¹ᵁ U)) ∧
      Surjective (ι ≫ Limits.pullback.fst f β) ∧
      ∃ V : X₁.Opens, V ≠ ⊥ ∧ IsFinite ((ι ≫ Limits.pullback.fst f β) ∣_ V) :=
by
  intro X₁ P P₁ _ _ _ f _ β U hU hsm hgc hβp hβs hVex
  obtain ⟨V, hV0, hVfin⟩ := hVex
  haveI := hβp

  have L1 : ∀ (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange]
      {X Y S T : Scheme.{u}} (f : X ⟶ S) (g : Y ⟶ S) (a : T ⟶ X) (b : T ⟶ Y),
      IsPullback a b f g → ∀ W : S.Opens, Pr (f ∣_ W) → Pr (b ∣_ (g ⁻¹ᵁ W)) := by
    intro Pr _ X Y S T f g a b hpb W hP
    have hrange : Set.range ⇑((b ⁻¹ᵁ (g ⁻¹ᵁ W)).ι ≫ a) ⊆ Set.range ⇑(f ⁻¹ᵁ W).ι := by
      rintro _ ⟨o, rfl⟩
      rw [Scheme.Opens.range_ι]
      have ho : g (b o.1) ∈ W := o.2
      have hc : f (a o.1) = g (b o.1) := by
        rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hpb.w]
      show f (a o.1) ∈ W
      rw [hc]
      exact ho
    obtain ⟨h, hh⟩ : ∃ h : (b ⁻¹ᵁ (g ⁻¹ᵁ W) : Scheme.{u}) ⟶ (f ⁻¹ᵁ W : Scheme.{u}),
        h ≫ (f ⁻¹ᵁ W).ι = (b ⁻¹ᵁ (g ⁻¹ᵁ W)).ι ≫ a :=
      ⟨IsOpenImmersion.lift _ _ hrange, IsOpenImmersion.lift_fac _ _ hrange⟩
    have h1 := (isPullback_morphismRestrict b (g ⁻¹ᵁ W)).flip.paste_horiz hpb
    rw [← hh, ← morphismRestrict_ι g W] at h1
    have h2 : IsPullback h (b ∣_ (g ⁻¹ᵁ W)) (f ∣_ W) (g ∣_ W) := by
      refine IsPullback.of_right h1 ?_ (isPullback_morphismRestrict f W).flip
      rw [← cancel_mono W.ι, Category.assoc, Category.assoc, morphismRestrict_ι f W,
        morphismRestrict_ι g W, ← Category.assoc h, hh, ← Category.assoc (b ∣_ (g ⁻¹ᵁ W)),
        morphismRestrict_ι b (g ⁻¹ᵁ W), Category.assoc, Category.assoc, hpb.w]
    exact MorphismProperty.of_isPullback h2 hP

  have hpbQ : IsPullback (Limits.pullback.fst f β) (Limits.pullback.snd f β) f β :=
    IsPullback.of_hasPullback f β
  have hsmO : SmoothOfRelativeDimension 1 (Limits.pullback.snd f β ∣_ (β ⁻¹ᵁ U)) :=
    L1 (@SmoothOfRelativeDimension 1) f β _ _ hpbQ U hsm
  have hgcO : GeometricallyConnected (Limits.pullback.snd f β ∣_ (β ⁻¹ᵁ U)) :=
    L1 (@GeometricallyConnected) f β _ _ hpbQ U hgc
  have hfinV : IsFinite (Limits.pullback.fst f β ∣_ (f ⁻¹ᵁ V)) :=
    L1 (@IsFinite) β f _ _ hpbQ.flip V hVfin

  have hfU : ∀ u ∈ (U : Set P), ∃ x : X₁, f x = u := by
    intro u hu
    obtain ⟨x', hx'⟩ := (wcpa_dj_sst_fibre_irreducible (f ∣_ U) 1 hsm hgc ⟨u, hu⟩).nonempty
    refine ⟨x'.1, ?_⟩
    have e : (f ∣_ U ≫ U.ι) x' = ((f ⁻¹ᵁ U).ι ≫ f) x' := by rw [morphismRestrict_ι]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at e
    have e' : ((f ∣_ U) x').1 = f x'.1 := e
    have hx'' : (f ∣_ U) x' = ⟨u, hu⟩ := hx'
    rw [hx''] at e'
    exact e'.symm

  obtain ⟨u, hu⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).mp hU
  obtain ⟨p, hp⟩ := hβs.surj u
  have hWne : Nonempty ↥(β ⁻¹ᵁ U) := ⟨⟨p, by show β p ∈ U; rw [hp]; exact hu⟩⟩
  haveI hWint : AlgebraicGeometry.IsIntegral (β ⁻¹ᵁ U : Scheme.{u}) :=
    @isIntegral_of_isOpenImmersion _ _ (β ⁻¹ᵁ U).ι _ _ hWne

  haveI hOred : AlgebraicGeometry.IsReduced
      (Limits.pullback.snd f β ⁻¹ᵁ (β ⁻¹ᵁ U) : Scheme.{u}) :=
    wcpa_dj_sst_smooth_reduced (Limits.pullback.snd f β ∣_ (β ⁻¹ᵁ U)) 1 hsmO
  haveI := hsmO
  haveI : Smooth (Limits.pullback.snd f β ∣_ (β ⁻¹ᵁ U)) :=
    SmoothOfRelativeDimension.smooth 1 _
  have hgen := Flat.generalizingMap (Limits.pullback.snd f β ∣_ (β ⁻¹ᵁ U))
  have hη : ∀ b : (β ⁻¹ᵁ U : Scheme.{u}), genericPoint (β ⁻¹ᵁ U : Scheme.{u}) ⤳ b :=
    fun b => (genericPoint_spec (β ⁻¹ᵁ U : Scheme.{u})).specializes (Set.mem_univ b)
  have hirrF := wcpa_dj_sst_fibre_irreducible (Limits.pullback.snd f β ∣_ (β ⁻¹ᵁ U)) 1 hsmO hgcO
    (genericPoint (β ⁻¹ᵁ U : Scheme.{u}))
  haveI hOirr : IrreducibleSpace (Limits.pullback.snd f β ⁻¹ᵁ (β ⁻¹ᵁ U) : Scheme.{u}) := by
    have hcl : closure (⇑(Limits.pullback.snd f β ∣_ (β ⁻¹ᵁ U)) ⁻¹'
        {genericPoint (β ⁻¹ᵁ U : Scheme.{u})}) = Set.univ := by
      apply Set.eq_univ_of_forall
      intro y
      obtain ⟨y', hy'y, hy'η⟩ := hgen (hη ((Limits.pullback.snd f β ∣_ (β ⁻¹ᵁ U)) y))
      have hmem : y' ∈ ⇑(Limits.pullback.snd f β ∣_ (β ⁻¹ᵁ U)) ⁻¹'
          {genericPoint (β ⁻¹ᵁ U : Scheme.{u})} := hy'η
      exact closure_mono (Set.singleton_subset_iff.mpr hmem) (specializes_iff_mem_closure.mp hy'y)
    have h2 : IsIrreducible (Set.univ : Set (Limits.pullback.snd f β ⁻¹ᵁ (β ⁻¹ᵁ U) : Scheme.{u})) := by
      rw [← hcl]; exact hirrF.closure
    exact (irreducibleSpace_def _).mpr h2
  have hOint : AlgebraicGeometry.IsIntegral (Limits.pullback.snd f β ⁻¹ᵁ (β ⁻¹ᵁ U) : Scheme.{u}) :=
    isIntegral_of_irreducibleSpace_of_isReduced _

  obtain ⟨X₂, iX₂, ι, hι, hOι, hiso⟩ :=
    wcpa_dj_sst_closure_subscheme (Limits.pullback f β) (Limits.pullback.snd f β ⁻¹ᵁ (β ⁻¹ᵁ U)) hOint
  haveI := hι
  have hsq : IsPullback (ι ∣_ (Limits.pullback.snd f β ⁻¹ᵁ (β ⁻¹ᵁ U)))
      (ι ∣_ (Limits.pullback.snd f β ⁻¹ᵁ (β ⁻¹ᵁ U)) ≫ Limits.pullback.snd f β ∣_ (β ⁻¹ᵁ U))
      (Limits.pullback.snd f β ∣_ (β ⁻¹ᵁ U)) (𝟙 _) := by
    haveI := hiso
    exact IsPullback.of_horiz_isIso ⟨(Category.comp_id _).symm⟩
  refine ⟨X₂, iX₂, ι, hι, ?_, ?_, ?_, ?_, ?_⟩
  ·
    intro z hz
    exact hOι hz
  ·
    rw [morphismRestrict_comp]
    exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hsq hsmO
  ·
    rw [morphismRestrict_comp]
    exact MorphismProperty.of_isPullback (P := @GeometricallyConnected) hsq hgcO
  ·
    refine ⟨fun x => ?_⟩
    have hcl : IsClosed (Set.range ⇑(ι ≫ Limits.pullback.fst f β)) :=
      (ι ≫ Limits.pullback.fst f β).isClosedMap.isClosed_range
    have hsub : ⇑f ⁻¹' (U : Set P) ⊆ Set.range ⇑(ι ≫ Limits.pullback.fst f β) := by
      intro x hx
      obtain ⟨q, hq⟩ := hβs.surj (f x)
      obtain ⟨z, hz1, hz2⟩ := Scheme.Pullback.exists_preimage_pullback (f := f) (g := β) x q hq.symm
      have hzO : z ∈ Limits.pullback.snd f β ⁻¹ᵁ (β ⁻¹ᵁ U) := by
        show β (Limits.pullback.snd f β z) ∈ U
        rw [hz2, hq]
        exact hx
      obtain ⟨y, hy⟩ := hOι hzO
      refine ⟨y, ?_⟩
      rw [Scheme.Hom.comp_apply, hy, hz1]
    obtain ⟨x0, hx0⟩ := hfU u hu
    have hdense : Dense (⇑f ⁻¹' (U : Set P)) :=
      (U.isOpen.preimage f.continuous).dense ⟨x0, show f x0 ∈ (U : Set P) by rw [hx0]; exact hu⟩
    exact (hcl.closure_subset_iff.mpr hsub) (hdense x)
  ·
    refine ⟨f ⁻¹ᵁ V, ?_, ?_⟩
    · obtain ⟨v, hv⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty V).mp hV0
      obtain ⟨q, hqV, hqU⟩ := nonempty_preirreducible_inter V.isOpen U.isOpen ⟨v, hv⟩ ⟨u, hu⟩
      obtain ⟨x, hx⟩ := hfU q hqU
      exact (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mpr
        ⟨x, show f x ∈ V by rw [hx]; exact hqV⟩
    · rw [morphismRestrict_comp]
      haveI := hfinV
      haveI : IsClosedImmersion (ι ∣_ (Limits.pullback.fst f β ⁻¹ᵁ (f ⁻¹ᵁ V))) := inferInstance
      haveI : IsFinite (ι ∣_ (Limits.pullback.fst f β ⁻¹ᵁ (f ⁻¹ᵁ V))) := inferInstance
      exact MorphismProperty.comp_mem (@IsFinite) _ _ this hfinV

theorem wcpa_dj_ssm_lift_closed_immersion : ∀ (R S C : Scheme.{u}) [IsReduced R] (a : R ⟶ S)
    (j : C ⟶ S) [IsClosedImmersion j], Set.range ⇑a ⊆ Set.range ⇑j → ∃ b : R ⟶ C, b ≫ j = a :=
by
  intro R S C _ a j _ hrange
  have H : Scheme.Hom.ker j ≤ Scheme.Hom.ker a := by
    rw [Scheme.Hom.ker.eq_1 a, Scheme.IdealSheafData.le_ofIdeals_iff]
    intro U s hs
    rw [Scheme.Hom.ker_apply, RingHom.mem_ker] at hs
    rw [RingHom.mem_ker]
    apply eq_zero_of_basicOpen_eq_bot
    rw [← Scheme.Hom.preimage_basicOpen]
    have hj : j ⁻¹ᵁ S.basicOpen s = ⊥ := by
      rw [Scheme.Hom.preimage_basicOpen, hs, Scheme.basicOpen_zero]
    rw [← TopologicalSpace.Opens.not_nonempty_iff_eq_bot]
    rintro ⟨x, hx⟩
    obtain ⟨c, hc⟩ := hrange ⟨x, rfl⟩
    have hc' : c ∈ j ⁻¹ᵁ S.basicOpen s := by
      show j c ∈ S.basicOpen s
      rw [hc]
      exact hx
    rw [hj] at hc'
    exact hc'
  exact ⟨IsClosedImmersion.lift j a H, IsClosedImmersion.lift_fac j a H⟩

theorem wcpa_dj_ssm_section_eq_closed : ∀ {X B : Scheme.{u}} (g : X ⟶ B) [IsSeparated g]
    (σ σ' : B ⟶ X), σ ≫ g = 𝟙 B → σ' ≫ g = 𝟙 B → IsClosed {b : B | σ b = σ' b} :=
by
  intro X B g _ σ σ' hσ hσ'
  haveI : IsClosedImmersion (σ ≫ g) := by rw [hσ]; infer_instance
  haveI : IsClosedImmersion σ := IsClosedImmersion.of_comp σ g
  have hcl : IsClosed (Set.range ⇑σ) := σ.isClosedEmbedding.isClosed_range
  have hpt : ∀ (τ : B ⟶ X), τ ≫ g = 𝟙 B → ∀ x : B, g (τ x) = x := by
    intro τ hτ x
    rw [← Scheme.Hom.comp_apply, hτ]
    rfl
  have hset : {b : B | σ b = σ' b} = ⇑σ' ⁻¹' Set.range ⇑σ := by
    ext b
    constructor
    · intro h
      exact ⟨b, h⟩
    · rintro ⟨c, hc⟩
      have hcb : c = b :=
        calc c = g (σ c) := (hpt σ hσ c).symm
          _ = g (σ' b) := by rw [hc]
          _ = b := hpt σ' hσ' b
      show σ b = σ' b
      rw [hcb] at hc
      exact hc
  rw [hset]
  exact hcl.preimage σ'.continuous

theorem wcpa_dj_ssm_proj_fibre_product : ∀ (k : Type u) [Field k] (X₁ P P₁ X₂ : Scheme.{u})
    (sP : P ⟶ Spec (.of k)) (f : X₁ ⟶ P) (β : P₁ ⟶ P) (ι : X₂ ⟶ Limits.pullback f β),
    IsSeparated sP → wcpaDjIsProjOver k (f ≫ sP) → wcpaDjIsProjOver k (β ≫ sP) →
    IsClosedImmersion ι → wcpaDjIsProjOver k (ι ≫ Limits.pullback.snd f β ≫ β ≫ sP) :=
by
  intro k _ X₁ P P₁ X₂ sP f β ι hsep hf hβ hι
  haveI := hsep
  haveI := hι
  obtain ⟨N₃, j₃, hj₃, hj₃eq⟩ := hf
  obtain ⟨N₂, j₂, hj₂, hj₂eq⟩ := hβ
  haveI := hj₂
  haveI := hj₃
  haveI hδ : IsClosedImmersion (Limits.pullback.map f β (f ≫ sP) (β ≫ sP) (𝟙 X₁) (𝟙 P₁) sP
      (by simp) (by simp)) :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion)
      (Limits.pullback_map_diagonal_isPullback f β sP) inferInstance
  haveI : MorphismProperty.IsStableUnderComposition
      (@IsClosedImmersion : MorphismProperty Scheme.{u}) :=
    MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  haveI hμ := MorphismProperty.pullbackMap (P := @IsClosedImmersion) (f := f ≫ sP)
    (g := β ≫ sP) hj₃ hj₂ hj₃eq.symm hj₂eq.symm
  obtain ⟨N', σ, hσ, hσeq⟩ := wc_pp_segre k N₃ N₂
  haveI := hσ
  refine ⟨N', ι ≫ Limits.pullback.map f β (f ≫ sP) (β ≫ sP) (𝟙 X₁) (𝟙 P₁) sP
      (by simp) (by simp) ≫ Limits.pullback.map (f ≫ sP) (β ≫ sP) _ _ j₃ j₂ (𝟙 _)
      (by rw [Category.comp_id]; exact hj₃eq.symm) (by rw [Category.comp_id]; exact hj₂eq.symm) ≫ σ,
    inferInstance, ?_⟩
  simp only [Category.assoc]
  rw [hσeq]
  simp only [Limits.pullback.map, Limits.pullback.lift_fst_assoc, Category.assoc]
  rw [hj₃eq]
  simp only [Limits.pullback.lift_fst_assoc, Category.id_comp]
  rw [Limits.pullback.condition_assoc]

theorem wcpa_dj_ssm_unique_lift : ∀ {X P P₀ P₁ : Scheme.{u}} (f : X ⟶ P) (β₀ : P₀ ⟶ P)
    (ρ : P₁ ⟶ P₀) (z : ↥(Limits.pullback f β₀)),
    IsIso ((Limits.pullback.snd f β₀).residueFieldMap z) →
    ∀ w w' : ↥(Limits.pullback f (ρ ≫ β₀)),
      Limits.pullback.snd f (ρ ≫ β₀) w = Limits.pullback.snd f (ρ ≫ β₀) w' →
      Limits.pullback.lift (Limits.pullback.fst f (ρ ≫ β₀)) (Limits.pullback.snd f (ρ ≫ β₀) ≫ ρ)
        ((Limits.pullback.condition).trans (Category.assoc _ _ _).symm) w = z →
      Limits.pullback.lift (Limits.pullback.fst f (ρ ≫ β₀)) (Limits.pullback.snd f (ρ ≫ β₀) ≫ ρ)
        ((Limits.pullback.condition).trans (Category.assoc _ _ _).symm) w' = z → w = w' :=
by
  intro X P P₀ P₁ f β₀ ρ z hz w w' hsnd hw hw'
  classical

  have s1 : ∀ {A B S : Scheme.{u}} (g : A ⟶ S) (ρ : B ⟶ S) (T : Scheme.Pullback.Triplet g ρ),
      IsIso (g.residueFieldMap T.x) → Subsingleton ↥(Spec T.tensor) := by
    intro A B S g ρ T hT
    haveI : IsIso T.tensorInr := by
      unfold Scheme.Pullback.Triplet.tensorInr
      exact Limits.pushout_inr_iso_of_left_iso _ _
    have hbij : Function.Bijective T.tensorInr.hom :=
      ConcreteCategory.bijective_of_isIso T.tensorInr
    have hinj : Function.Injective (PrimeSpectrum.comap T.tensorInr.hom) :=
      PrimeSpectrum.comap_injective_of_surjective T.tensorInr.hom hbij.2
    show Subsingleton (PrimeSpectrum T.tensor)
    exact hinj.subsingleton

  have s2 : ∀ {A B S : Scheme.{u}} (g : A ⟶ S) (ρ : B ⟶ S) (r r' : ↥(Limits.pullback g ρ)),
      Limits.pullback.fst g ρ r = Limits.pullback.fst g ρ r' →
      Limits.pullback.snd g ρ r = Limits.pullback.snd g ρ r' →
      IsIso (g.residueFieldMap (Limits.pullback.fst g ρ r)) → r = r' := by
    intro A B S g ρ r r' h1 h2 h3
    apply Scheme.Pullback.carrierEquiv.injective
    rw [Scheme.Pullback.carrierEquiv_eq_iff]
    have e : Scheme.Pullback.Triplet.ofPoint r = Scheme.Pullback.Triplet.ofPoint r' :=
      Scheme.Pullback.Triplet.ext
        (by rw [Scheme.Pullback.Triplet.ofPoint_x, Scheme.Pullback.Triplet.ofPoint_x, h1])
        (by rw [Scheme.Pullback.Triplet.ofPoint_y, Scheme.Pullback.Triplet.ofPoint_y, h2])
    have aux : ∀ x, x = Limits.pullback.fst g ρ r → IsIso (g.residueFieldMap x) := by
      rintro x rfl; exact h3
    have hiso : IsIso (g.residueFieldMap (Scheme.Pullback.Triplet.ofPoint r').x) :=
      aux _ (by rw [Scheme.Pullback.Triplet.ofPoint_x, h1])
    refine ⟨e, ?_⟩
    exact @Subsingleton.elim _ (s1 g ρ _ hiso) _ _

  set π := Limits.pullback.lift (Limits.pullback.fst f (ρ ≫ β₀)) (Limits.pullback.snd f (ρ ≫ β₀) ≫ ρ)
        ((Limits.pullback.condition).trans (Category.assoc _ _ _).symm) with hπ
  set e := Limits.pullbackLeftPullbackSndIso f β₀ ρ with he
  have he1 : e.hom ≫ π = Limits.pullback.fst (Limits.pullback.snd f β₀) ρ := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hπ, Limits.pullback.lift_fst, he,
        Limits.pullbackLeftPullbackSndIso_hom_fst]
    · rw [Category.assoc, hπ, Limits.pullback.lift_snd, ← Category.assoc, he,
        Limits.pullbackLeftPullbackSndIso_hom_snd, Limits.pullback.condition]
  have he2 : e.hom ≫ Limits.pullback.snd f (ρ ≫ β₀) =
      Limits.pullback.snd (Limits.pullback.snd f β₀) ρ :=
    Limits.pullbackLeftPullbackSndIso_hom_snd f β₀ ρ
  have hinv : ∀ x, e.hom (e.inv x) = x := by
    intro x
    rw [← Scheme.Hom.comp_apply, Iso.inv_hom_id]
    rfl
  have ha : ∀ x, Limits.pullback.fst (Limits.pullback.snd f β₀) ρ (e.inv x) = π x := by
    intro x
    rw [← he1, Scheme.Hom.comp_apply, hinv]
  have hb : ∀ x, Limits.pullback.snd (Limits.pullback.snd f β₀) ρ (e.inv x) =
      Limits.pullback.snd f (ρ ≫ β₀) x := by
    intro x
    rw [← he2, Scheme.Hom.comp_apply, hinv]
  have hz' : ∀ x, x = z → IsIso ((Limits.pullback.snd f β₀).residueFieldMap x) := by
    rintro x rfl; exact hz
  have hr : e.inv w = e.inv w' :=
    s2 (Limits.pullback.snd f β₀) ρ (e.inv w) (e.inv w')
      (by rw [ha, ha, hw, hw']) (by rw [hb, hb, hsnd]) (hz' _ (by rw [ha, hw]))
  rw [← hinv w, ← hinv w', hr]

theorem wcpa_dj_ssm_generic_cover : ∀ {X B : Scheme.{u}} [AlgebraicGeometry.IsIntegral B]
    [TopologicalSpace.NoetherianSpace X] (g : X ⟶ B) [UniversallyClosed g] [IsSeparated g] (n : ℕ)
    (σ : Fin n → (B ⟶ X)), (∀ i, σ i ≫ g = 𝟙 B) → ∀ Z : Set X, IsClosed Z →
    (∀ x ∈ Z, g x = genericPoint B → ∃ i, σ i (genericPoint B) = x) →
    ∃ O : B.Opens, genericPoint B ∈ O ∧ Z ∩ ⇑g ⁻¹' (O : Set B) ⊆ ⋃ i, Set.range ⇑(σ i) :=
by
  intro X B _ _ g _ _ n σ hσ Z hZ hZgen
  classical
  obtain ⟨S, hSfin, hScl, hSirr, hZS⟩ :=
    TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible hZ
  haveI : Finite S := hSfin.to_subtype
  have hgen : ∀ t : S, ∃ z, IsGenericPoint z (t : Set X) := fun t =>
    ⟨_, (hSirr t.1 t.2).isGenericPoint_genericPoint (hScl t.1 t.2)⟩
  choose ζ hζ using hgen
  have hrange : ∀ i, IsClosed (Set.range ⇑(σ i)) := by
    intro i
    haveI : IsClosedImmersion (σ i ≫ g) := by rw [hσ i]; infer_instance
    haveI : IsClosedImmersion (σ i) := IsClosedImmersion.of_comp (σ i) g
    exact (IsClosedImmersion.isClosedEmbedding (σ i)).isClosed_range
  obtain ⟨C, hC⟩ : ∃ C : Set B,
      C = ⋃ (t : S) (_ : g (ζ t) ≠ genericPoint B), closure {g (ζ t)} := ⟨_, rfl⟩
  have hCcl : IsClosed C := by
    rw [hC]
    exact isClosed_iUnion_of_finite (fun t =>
      isClosed_iUnion_of_finite (fun _ => isClosed_closure))
  have hηC : genericPoint B ∉ C := by
    intro hmem
    rw [hC] at hmem
    obtain ⟨t, ht⟩ := Set.mem_iUnion.mp hmem
    obtain ⟨hne, hcl⟩ := Set.mem_iUnion.mp ht
    have h1 : g (ζ t) ⤳ genericPoint B := specializes_iff_mem_closure.mpr hcl
    have h2 : genericPoint B ⤳ g (ζ t) := (genericPoint_spec B).specializes (Set.mem_univ _)
    exact hne (h1.antisymm h2).eq
  refine ⟨⟨Cᶜ, hCcl.isOpen_compl⟩, hηC, ?_⟩
  rintro x ⟨hxZ, hxO⟩
  have hxO' : g x ∈ (Cᶜ : Set B) := hxO
  have hxZ' : x ∈ ⋃₀ S := hZS ▸ hxZ
  obtain ⟨t, htS, hxt⟩ := Set.mem_sUnion.mp hxZ'
  have hspec : ζ ⟨t, htS⟩ ⤳ x := (hζ ⟨t, htS⟩).specializes hxt
  by_cases hη : g (ζ ⟨t, htS⟩) = genericPoint B
  · have hζZ : ζ ⟨t, htS⟩ ∈ Z := by
      have : ζ ⟨t, htS⟩ ∈ ⋃₀ S := Set.mem_sUnion.mpr ⟨t, htS, (hζ ⟨t, htS⟩).mem⟩
      exact hZS ▸ this
    obtain ⟨i, hi⟩ := hZgen _ hζZ hη
    have hmem : ζ ⟨t, htS⟩ ∈ Set.range ⇑(σ i) := ⟨_, hi⟩
    exact Set.mem_iUnion.mpr ⟨i, hspec.mem_closed (hrange i) hmem⟩
  · exfalso
    apply hxO'
    rw [hC]
    exact Set.mem_iUnion.mpr ⟨⟨t, htS⟩, Set.mem_iUnion.mpr ⟨hη,
      specializes_iff_mem_closure.mp (hspec.map g.continuous)⟩⟩

theorem wcpa_dj_ssm_restrict_smaller : ∀ {X Y : Scheme.{u}} (g : X ⟶ Y) (U V : Y.Opens), V ≤ U →
    SmoothOfRelativeDimension 1 (g ∣_ U) → GeometricallyConnected (g ∣_ U) →
    SmoothOfRelativeDimension 1 (g ∣_ V) ∧ GeometricallyConnected (g ∣_ V) :=
by
  intro X Y g U V hVU hsm hgc
  have hle : g ⁻¹ᵁ V ≤ g ⁻¹ᵁ U := g.preimage_mono hVU
  have hcomm : X.homOfLE hle ≫ g ∣_ U = g ∣_ V ≫ Y.homOfLE hVU := by
    rw [← cancel_mono U.ι]
    rw [Category.assoc, Category.assoc, morphismRestrict_ι, Scheme.homOfLE_ι, ← Category.assoc,
      Scheme.homOfLE_ι, morphismRestrict_ι]
  have H' := (isPullback_morphismRestrict g U).flip
  have H : IsPullback (X.homOfLE hle ≫ (g ⁻¹ᵁ U).ι) (g ∣_ V) g (Y.homOfLE hVU ≫ U.ι) := by
    rw [Scheme.homOfLE_ι, Scheme.homOfLE_ι]
    exact (isPullback_morphismRestrict g V).flip
  have hpb := IsPullback.of_right H hcomm H'
  exact ⟨MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hpb hsm,
    MorphismProperty.of_isPullback (P := @GeometricallyConnected) hpb hgc⟩

theorem wcpa_dj_ss_marked_sections : ∀ (k : Type u) [Field k] [Finite k] (X₁ P : Scheme.{u})
    [AlgebraicGeometry.IsIntegral X₁] [AlgebraicGeometry.IsIntegral P] (sP : P ⟶ Spec (.of k))
    (f : X₁ ⟶ P), wcpaDjIsProjOver k (f ≫ sP) → wcpaDjIsProjOver k sP →
    ∀ U : P.Opens, U ≠ ⊥ → SmoothOfRelativeDimension 1 (f ∣_ U) → GeometricallyConnected (f ∣_ U) →
    ∀ T : Set X₁, IsClosed T → T ≠ Set.univ →
    ∃ (P₁ : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral P₁) (sP₁ : P₁ ⟶ Spec (.of k))
      (β₁ : P₁ ⟶ P),
      β₁ ≫ sP = sP₁ ∧ wcpaDjIsProjOver k sP₁ ∧ IsProper β₁ ∧ Surjective β₁ ∧
      (∃ V : P.Opens, V ≠ ⊥ ∧ IsFinite (β₁ ∣_ V)) ∧
      ∃ (X₂ : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral X₂) (f₂ : X₂ ⟶ P₁) (α₂ : X₂ ⟶ X₁),
        α₂ ≫ f = f₂ ≫ β₁ ∧ wcpaDjIsProjOver k (f₂ ≫ sP₁) ∧
        IsProper α₂ ∧ Surjective α₂ ∧ (∃ V : X₁.Opens, V ≠ ⊥ ∧ IsFinite (α₂ ∣_ V)) ∧
        ∃ (U₁ : P₁.Opens) (n : ℕ) (σ : Fin n → (P₁ ⟶ X₂)),
          U₁ ≠ ⊥ ∧ SmoothOfRelativeDimension 1 (f₂ ∣_ U₁) ∧ GeometricallyConnected (f₂ ∣_ U₁) ∧
          3 ≤ n ∧ (∀ i, σ i ≫ f₂ = 𝟙 P₁) ∧
          (∀ (i j : Fin n) (p : P₁), p ∈ U₁ → i ≠ j → σ i p ≠ σ j p) ∧
          ⇑α₂ ⁻¹' T ⊆ (⋃ i, Set.range ⇑(σ i)) ∪ ⇑f₂ ⁻¹' ((U₁ : Set P₁)ᶜ) :=
by
  intro k _ _ X₁ P _ _ sP f hf hP U hU hUsm hUgc T hTcl hTne
  classical

  have capp : ∀ {A B C : Scheme.{u}} (φ : A ⟶ B) (ψ : B ⟶ C) (x : A), ψ (φ x) = (φ ≫ ψ) x :=
    fun φ ψ x => (Scheme.Hom.comp_apply φ ψ x).symm
  have papp : ∀ {A B : Scheme.{u}} {φ ψ : A ⟶ B}, φ = ψ → ∀ x : A, φ x = ψ x :=
    fun h x => by rw [h]
  have gen_of_surj : ∀ {A B : Scheme.{u}} [AlgebraicGeometry.IsIntegral A]
      [AlgebraicGeometry.IsIntegral B] (φ : A ⟶ B), Surjective φ →
      φ (genericPoint A) = genericPoint B := by
    intro A B _ _ φ hφ
    haveI := hφ
    have h1 : IsGenericPoint (φ (genericPoint A)) Set.univ := by
      rw [isGenericPoint_iff_specializes]
      intro y
      simp only [Set.mem_univ, iff_true]
      obtain ⟨x, rfl⟩ := φ.surjective y
      exact ((genericPoint_spec A).specializes (Set.mem_univ x)).map φ.continuous
    exact h1.eq (genericPoint_spec B)

  haveI hsPp : IsProper sP := wcpa_dj_proj_proper k sP hP
  haveI hfsPp : IsProper (f ≫ sP) := wcpa_dj_proj_proper k _ hf
  haveI hfp : IsProper f := IsProper.of_comp f sP

  obtain ⟨hgen, hres, hinf, hfin⟩ := wcpa_dj_ssm_generic_fibre X₁ P f U hU hUsm hUgc
  have hηT : genericPoint X₁ ∉ T := by
    intro h
    apply hTne
    apply Set.eq_univ_of_forall
    intro x
    exact ((genericPoint_spec X₁).specializes (Set.mem_univ x)).mem_closed hTcl h
  have hTF : (T ∩ {x : X₁ | f x = genericPoint P}).Finite := hfin T hTcl hηT
  have hinf2 : ({x : X₁ | f x = genericPoint P} \
      ({genericPoint X₁} ∪ (T ∩ {x : X₁ | f x = genericPoint P}))).Infinite :=
    hinf.diff ((Set.finite_singleton _).union hTF)
  obtain ⟨E, hEsub, hEcard⟩ := hinf2.exists_subset_card_eq 3
  have hY₀F : ∀ y ∈ hTF.toFinset ∪ E, f y = genericPoint P ∧ y ≠ genericPoint X₁ := by
    intro y hy
    rcases Finset.mem_union.mp hy with h | h
    · have h' := (Set.Finite.mem_toFinset hTF).mp h
      exact ⟨h'.2, fun he => hηT (he ▸ h'.1)⟩
    · have h' := hEsub (Finset.mem_coe.mpr h)
      exact ⟨h'.1, fun he => h'.2 (Set.mem_union_left _ (Set.mem_singleton_iff.mpr he))⟩
  have hY₀res : ∀ y ∈ hTF.toFinset ∪ E, f y = genericPoint P ∧ (f.residueFieldMap y).hom.Finite :=
    fun y hy => ⟨(hY₀F y hy).1, hres y (hY₀F y hy).1 (hY₀F y hy).2⟩
  have hY₀T : ∀ x : X₁, f x = genericPoint P → x ∈ T → x ∈ hTF.toFinset ∪ E := by
    intro x hx hxT
    exact Finset.mem_union_left _ ((Set.Finite.mem_toFinset hTF).mpr ⟨hxT, hx⟩)
  have hY₀card : 3 ≤ (hTF.toFinset ∪ E).card := hEcard ▸ Finset.card_le_card Finset.subset_union_right

  obtain ⟨P₀, iP₀, β₀, hβ₀p, hβ₀s, hβ₀f, hβ₀η, S, hS, hScov, hSall⟩ :=
    wcpa_dj_ssm_rationalize k X₁ P sP f (hTF.toFinset ∪ E) hY₀res
  haveI := iP₀
  haveI := hβ₀p
  have hScard : 3 ≤ S.card := by
    refine hY₀card.trans (Finset.card_le_card_of_surjOn (fun z => Limits.pullback.fst f β₀ z) ?_)
    intro y hy
    obtain ⟨z, hz, hzy⟩ := hScov y hy
    exact ⟨z, hz, hzy⟩
  obtain ⟨zz, hzzS, hzzinj, hzzsurj⟩ : ∃ zz : Fin S.card → ↥(Limits.pullback f β₀),
      (∀ i, zz i ∈ S) ∧ Function.Injective zz ∧ ∀ z ∈ S, ∃ i, zz i = z :=
    ⟨fun i => (S.equivFin.symm i).1, fun i => (S.equivFin.symm i).2,
      fun i j h => S.equivFin.symm.injective (Subtype.ext h),
      fun z hz => ⟨S.equivFin ⟨z, hz⟩, by simp⟩⟩

  have hspread : ∀ i : Fin S.card, ∃ (W : P₀.Opens)
      (s : (W : Scheme.{u}) ⟶ Limits.pullback f β₀) (hW : genericPoint P₀ ∈ W),
      s ≫ Limits.pullback.snd f β₀ = W.ι ∧ s ⟨genericPoint P₀, hW⟩ = zz i :=
    fun i => wcpa_dj_ssm_spread_section (Limits.pullback.snd f β₀) (zz i)
      (hS _ (hzzS i)).1 (hS _ (hzzS i)).2
  choose W s hW hsW hsη using hspread

  obtain ⟨P10, iP10, ρ, t, hρp, hρs, hρf, ht, htη⟩ :=
    wcpa_dj_ssm_extend_sections P₀ (Limits.pullback f β₀) (Limits.pullback.snd f β₀) S.card W s hW hsW
  haveI := iP10
  haveI := hρp

  haveI : IsProper (ρ ≫ β₀ ≫ sP) := inferInstance
  obtain ⟨P₁, iP₁, c, hcP, hcp, hcs, hcf⟩ := wcpa_dj_cf_chow_projective k P10 (ρ ≫ β₀ ≫ sP)
  haveI := iP₁
  haveI := hcp
  obtain ⟨hρ's0, hρ'f0⟩ := wcpa_dj_alteration_comp ρ c hρp hρs hcs hρf hcf
  obtain ⟨ρ', hρ'def⟩ : ∃ ρ' : P₁ ⟶ P₀, ρ' = c ≫ ρ := ⟨_, rfl⟩
  have hρ'p : IsProper ρ' := by rw [hρ'def]; infer_instance
  have hρ's : Surjective ρ' := by rw [hρ'def]; exact hρ's0
  have hρ'f : ∃ V : P₀.Opens, V ≠ ⊥ ∧ IsFinite (ρ' ∣_ V) := by rw [hρ'def]; exact hρ'f0
  haveI := hρ'p
  obtain ⟨hβ₁s, hβ₁f⟩ := wcpa_dj_alteration_comp β₀ ρ' hβ₀p hβ₀s hρ's hβ₀f hρ'f
  have hβ₁p : IsProper (ρ' ≫ β₀) := inferInstance
  haveI := hβ₁p
  have hcP' : wcpaDjIsProjOver k ((ρ' ≫ β₀) ≫ sP) := by
    rw [hρ'def]; simpa only [Category.assoc] using hcP
  have hρ'η : ρ' (genericPoint P₁) = genericPoint P₀ := gen_of_surj ρ' hρ's
  obtain ⟨t', ht'def⟩ : ∃ t' : Fin S.card → (P₁ ⟶ Limits.pullback f β₀), ∀ i, t' i = c ≫ t i :=
    ⟨fun i => c ≫ t i, fun _ => rfl⟩
  have ht' : ∀ i, t' i ≫ Limits.pullback.snd f β₀ = ρ' := by
    intro i; rw [ht'def, hρ'def, Category.assoc, ht i]
  have ht'η : ∀ i, t' i (genericPoint P₁) = zz i := by
    intro i
    rw [ht'def, Scheme.Hom.comp_apply, gen_of_surj c hcs, htη i, hsη i]

  have hcond : ∀ i, (t' i ≫ Limits.pullback.fst f β₀) ≫ f = 𝟙 P₁ ≫ ρ' ≫ β₀ := by
    intro i
    rw [Category.id_comp, Category.assoc, Limits.pullback.condition, ← ht' i, Category.assoc]
  obtain ⟨σ', hσ'def⟩ : ∃ σ' : Fin S.card → (P₁ ⟶ Limits.pullback f (ρ' ≫ β₀)),
      ∀ i, σ' i = Limits.pullback.lift (t' i ≫ Limits.pullback.fst f β₀) (𝟙 P₁) (hcond i) :=
    ⟨fun i => Limits.pullback.lift (t' i ≫ Limits.pullback.fst f β₀) (𝟙 P₁) (hcond i),
      fun _ => rfl⟩
  have hσ'snd : ∀ i, σ' i ≫ Limits.pullback.snd f (ρ' ≫ β₀) = 𝟙 P₁ := by
    intro i; rw [hσ'def, Limits.pullback.lift_snd]
  have hσ'fst : ∀ i, σ' i ≫ Limits.pullback.fst f (ρ' ≫ β₀) = t' i ≫ Limits.pullback.fst f β₀ := by
    intro i; rw [hσ'def, Limits.pullback.lift_fst]
  obtain ⟨π, hπ⟩ : ∃ π : Limits.pullback f (ρ' ≫ β₀) ⟶ Limits.pullback f β₀,
      π = Limits.pullback.lift (Limits.pullback.fst f (ρ' ≫ β₀))
        (Limits.pullback.snd f (ρ' ≫ β₀) ≫ ρ')
        ((Limits.pullback.condition).trans (Category.assoc _ _ _).symm) := ⟨_, rfl⟩
  have hπfst : π ≫ Limits.pullback.fst f β₀ = Limits.pullback.fst f (ρ' ≫ β₀) := by
    rw [hπ, Limits.pullback.lift_fst]
  have hπsnd : π ≫ Limits.pullback.snd f β₀ = Limits.pullback.snd f (ρ' ≫ β₀) ≫ ρ' := by
    rw [hπ, Limits.pullback.lift_snd]
  have hπσ : ∀ i, σ' i ≫ π = t' i := by
    intro i
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hπfst, hσ'fst]
    · rw [Category.assoc, hπsnd, ← Category.assoc, hσ'snd, Category.id_comp, ht' i]
  have hσ'η : ∀ i, π (σ' i (genericPoint P₁)) = zz i := by
    intro i; rw [capp (σ' i) π, hπσ i, ht'η i]
  have hσ'sndη : ∀ i, Limits.pullback.snd f (ρ' ≫ β₀) (σ' i (genericPoint P₁)) = genericPoint P₁ := by
    intro i
    rw [capp (σ' i) (Limits.pullback.snd f (ρ' ≫ β₀)), hσ'snd i]
    try rfl

  have key : ∀ w : ↥(Limits.pullback f (ρ' ≫ β₀)),
      Limits.pullback.snd f (ρ' ≫ β₀) w = genericPoint P₁ →
      Limits.pullback.fst f (ρ' ≫ β₀) w ∈ T → ∃ i, w = σ' i (genericPoint P₁) := by
    intro w hw hwT
    have h1 : Limits.pullback.snd f β₀ (π w) = genericPoint P₀ := by
      rw [capp π (Limits.pullback.snd f β₀) w, papp hπsnd w, Scheme.Hom.comp_apply, hw, hρ'η]
    have h2 : Limits.pullback.fst f β₀ (π w) = Limits.pullback.fst f (ρ' ≫ β₀) w := by
      rw [capp π (Limits.pullback.fst f β₀) w, papp hπfst w]
    have h3 : f (Limits.pullback.fst f β₀ (π w)) = genericPoint P := by
      rw [capp (Limits.pullback.fst f β₀) f (π w), papp Limits.pullback.condition (π w),
        Scheme.Hom.comp_apply, h1, hβ₀η]
    have h4 : π w ∈ S := hSall (π w) h1 (hY₀T _ h3 (by rw [h2]; exact hwT))
    obtain ⟨i, hi⟩ := hzzsurj _ h4
    refine ⟨i, ?_⟩
    have hsnd : Limits.pullback.snd f (ρ' ≫ β₀) w =
        Limits.pullback.snd f (ρ' ≫ β₀) (σ' i (genericPoint P₁)) := by
      rw [hw, hσ'sndη i]
    have := wcpa_dj_ssm_unique_lift f β₀ ρ' (zz i) (hS _ (hzzS i)).2 w (σ' i (genericPoint P₁)) hsnd
      (by rw [← hπ, hi]) (by rw [← hπ]; exact hσ'η i)
    exact this
  have hdist : ∀ i j, σ' i (genericPoint P₁) = σ' j (genericPoint P₁) → i = j := by
    intro i j h
    apply hzzinj
    rw [← hσ'η i, ← hσ'η j, h]

  obtain ⟨X₂, iX₂, ι, hι, hcont, hsm, hgc, hαs, hαf⟩ :=
    wcpa_dj_ssm_strict_transform X₁ P P₁ f (ρ' ≫ β₀) U hU hUsm hUgc hβ₁p hβ₁s hβ₁f
  haveI := iX₂
  haveI := hι
  have hcomm : (ι ≫ Limits.pullback.fst f (ρ' ≫ β₀)) ≫ f =
      (ι ≫ Limits.pullback.snd f (ρ' ≫ β₀)) ≫ (ρ' ≫ β₀) := by
    rw [Category.assoc, Category.assoc, Limits.pullback.condition]
  have hproj : wcpaDjIsProjOver k ((ι ≫ Limits.pullback.snd f (ρ' ≫ β₀)) ≫ (ρ' ≫ β₀) ≫ sP) := by
    have := wcpa_dj_ssm_proj_fibre_product k X₁ P P₁ X₂ sP f (ρ' ≫ β₀) ι inferInstance hf hcP' hι
    simpa only [Category.assoc] using this
  have hαp : IsProper (ι ≫ Limits.pullback.fst f (ρ' ≫ β₀)) := inferInstance

  have hηU : genericPoint P ∈ U := by
    obtain ⟨p, hp⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).mp hU
    exact ((genericPoint_spec P).specializes (Set.mem_univ p)).mem_open U.isOpen hp
  have hβ₁η : (ρ' ≫ β₀) (genericPoint P₁) = genericPoint P := by
    rw [Scheme.Hom.comp_apply, hρ'η, hβ₀η]
  have hι_inj : Function.Injective ι := (IsClosedImmersion.isClosedEmbedding ι).toIsEmbedding.injective
  have hrange : ∀ i, Set.range (σ' i) ⊆ Set.range ι := by
    intro i
    have hA : IsClosed ((σ' i) ⁻¹' Set.range ι) :=
      (IsClosedImmersion.isClosedEmbedding ι).isClosed_range.preimage (σ' i).continuous
    have hη : σ' i (genericPoint P₁) ∈ Set.range ι := by
      apply hcont
      show (ρ' ≫ β₀) (Limits.pullback.snd f (ρ' ≫ β₀) (σ' i (genericPoint P₁))) ∈ (U : Set P)
      rw [hσ'sndη i, hβ₁η]
      exact hηU
    rintro _ ⟨p, rfl⟩
    exact ((genericPoint_spec P₁).specializes (Set.mem_univ p)).mem_closed hA hη
  have hlift : ∀ i, ∃ b : P₁ ⟶ X₂, b ≫ ι = σ' i := fun i =>
    wcpa_dj_ssm_lift_closed_immersion P₁ (Limits.pullback f (ρ' ≫ β₀)) X₂ (σ' i) ι (hrange i)
  choose σ hσ using hlift
  have hσsec : ∀ i, σ i ≫ (ι ≫ Limits.pullback.snd f (ρ' ≫ β₀)) = 𝟙 P₁ := by
    intro i; rw [← Category.assoc, hσ i, hσ'snd i]
  have hισ : ∀ i, ι (σ i (genericPoint P₁)) = σ' i (genericPoint P₁) := by
    intro i; rw [capp (σ i) ι, hσ i]

  haveI hf₂p : IsProper (ι ≫ Limits.pullback.snd f (ρ' ≫ β₀)) := inferInstance
  haveI hX₂noeth : TopologicalSpace.NoetherianSpace X₂ := by
    haveI : IsProper ((ι ≫ Limits.pullback.snd f (ρ' ≫ β₀)) ≫ (ρ' ≫ β₀) ≫ sP) := inferInstance
    haveI : IsLocallyNoetherian X₂ :=
      LocallyOfFiniteType.isLocallyNoetherian ((ι ≫ Limits.pullback.snd f (ρ' ≫ β₀)) ≫ (ρ' ≫ β₀) ≫ sP)
    haveI : CompactSpace X₂ :=
      QuasiCompact.compactSpace_of_compactSpace ((ι ≫ Limits.pullback.snd f (ρ' ≫ β₀)) ≫ (ρ' ≫ β₀) ≫ sP)
    haveI : AlgebraicGeometry.IsNoetherian X₂ := {}
    infer_instance
  have hZcl : IsClosed (⇑(ι ≫ Limits.pullback.fst f (ρ' ≫ β₀)) ⁻¹' T) :=
    hTcl.preimage (ι ≫ Limits.pullback.fst f (ρ' ≫ β₀)).continuous
  have hgen_hyp : ∀ x ∈ ⇑(ι ≫ Limits.pullback.fst f (ρ' ≫ β₀)) ⁻¹' T,
      (ι ≫ Limits.pullback.snd f (ρ' ≫ β₀)) x = genericPoint P₁ →
      ∃ i, σ i (genericPoint P₁) = x := by
    intro x hx hxη
    rw [Set.mem_preimage, Scheme.Hom.comp_apply] at hx
    rw [Scheme.Hom.comp_apply] at hxη
    obtain ⟨i, hi⟩ := key (ι x) hxη hx
    exact ⟨i, hι_inj (by rw [hισ i, hi])⟩
  obtain ⟨O, hηO, hO⟩ := wcpa_dj_ssm_generic_cover (ι ≫ Limits.pullback.snd f (ρ' ≫ β₀)) S.card σ
    hσsec _ hZcl hgen_hyp

  obtain ⟨D, hDdef⟩ : ∃ D : Set P₁, D = ⋃ (q : Fin S.card × Fin S.card) (_ : q.1 ≠ q.2),
      {b : P₁ | σ q.1 b = σ q.2 b} := ⟨_, rfl⟩
  have hDcl : IsClosed D := by
    rw [hDdef]
    exact isClosed_iUnion_of_finite (fun q => isClosed_iUnion_of_finite (fun _ =>
      wcpa_dj_ssm_section_eq_closed (ι ≫ Limits.pullback.snd f (ρ' ≫ β₀)) (σ q.1) (σ q.2)
        (hσsec q.1) (hσsec q.2)))
  have hDmem : ∀ (p : P₁) (i j : Fin S.card), i ≠ j → σ i p = σ j p → p ∈ D := by
    intro p i j hij h
    rw [hDdef]
    exact Set.mem_iUnion.mpr ⟨(i, j), Set.mem_iUnion.mpr ⟨hij, h⟩⟩
  have hηD : genericPoint P₁ ∉ D := by
    intro hmem
    rw [hDdef] at hmem
    obtain ⟨q, hq⟩ := Set.mem_iUnion.mp hmem
    obtain ⟨hq1, hq2⟩ := Set.mem_iUnion.mp hq
    apply hq1
    apply hdist
    have hq2' : σ q.1 (genericPoint P₁) = σ q.2 (genericPoint P₁) := hq2
    rw [← hισ q.1, ← hισ q.2, hq2']
  obtain ⟨O', hO'⟩ : ∃ O' : P₁.Opens, ∀ p, p ∈ O' ↔ p ∉ D :=
    ⟨⟨Dᶜ, hDcl.isOpen_compl⟩, fun p => Iff.rfl⟩

  have hηU₁ : genericPoint P₁ ∈ (ρ' ≫ β₀) ⁻¹ᵁ U ⊓ O ⊓ O' := by
    refine TopologicalSpace.Opens.mem_inf.mpr ⟨TopologicalSpace.Opens.mem_inf.mpr ⟨?_, hηO⟩,
      (hO' _).mpr hηD⟩
    rw [Scheme.Hom.mem_preimage, hβ₁η]
    exact hηU
  have hU₁ne : (ρ' ≫ β₀) ⁻¹ᵁ U ⊓ O ⊓ O' ≠ ⊥ :=
    (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mpr ⟨_, hηU₁⟩
  obtain ⟨hsm1, hgc1⟩ := wcpa_dj_ssm_restrict_smaller (ι ≫ Limits.pullback.snd f (ρ' ≫ β₀))
    ((ρ' ≫ β₀) ⁻¹ᵁ U) ((ρ' ≫ β₀) ⁻¹ᵁ U ⊓ O ⊓ O') (inf_le_left.trans inf_le_left) hsm hgc
  have hdisj : ∀ (i j : Fin S.card) (p : P₁), p ∈ (ρ' ≫ β₀) ⁻¹ᵁ U ⊓ O ⊓ O' → i ≠ j →
      σ i p ≠ σ j p := by
    intro i j p hp hij h
    exact (hO' p).mp (TopologicalSpace.Opens.mem_inf.mp hp).2 (hDmem p i j hij h)
  have hcontain : ⇑(ι ≫ Limits.pullback.fst f (ρ' ≫ β₀)) ⁻¹' T ⊆ (⋃ i, Set.range ⇑(σ i)) ∪
      ⇑(ι ≫ Limits.pullback.snd f (ρ' ≫ β₀)) ⁻¹'
        ((((ρ' ≫ β₀) ⁻¹ᵁ U ⊓ O ⊓ O' : P₁.Opens) : Set P₁)ᶜ) := by
    intro x hx
    by_cases hxU : (ι ≫ Limits.pullback.snd f (ρ' ≫ β₀)) x ∈ (ρ' ≫ β₀) ⁻¹ᵁ U ⊓ O ⊓ O'
    · left
      apply hO
      exact ⟨hx, (TopologicalSpace.Opens.mem_inf.mp (TopologicalSpace.Opens.mem_inf.mp hxU).1).2⟩
    · right
      exact hxU

  exact ⟨P₁, iP₁, (ρ' ≫ β₀) ≫ sP, ρ' ≫ β₀, rfl, hcP', hβ₁p, hβ₁s, hβ₁f, X₂, iX₂,
    ι ≫ Limits.pullback.snd f (ρ' ≫ β₀), ι ≫ Limits.pullback.fst f (ρ' ≫ β₀), hcomm, hproj, hαp,
    hαs, hαf, (ρ' ≫ β₀) ⁻¹ᵁ U ⊓ O ⊓ O', S.card, σ, hU₁ne, hsm1, hgc1, hScard, hσsec, hdisj,
    hcontain⟩

theorem wcpa_dj_flrg_graph_closure : ∀ (k : Type u) [Field k] (P Q : Scheme.{u}) [AlgebraicGeometry.IsIntegral P] (sP : P ⟶ Spec (.of k)) (sQ : Q ⟶ Spec (.of k)) (U : P.Opens) (μ : U.toScheme ⟶ Q), wcpaDjIsProjOver k sP → wcpaDjIsProjOver k sQ → U ≠ ⊥ → μ ≫ sQ = U.ι ≫ sP → ∃ (P' : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral P') (β : P' ⟶ P) (γ : P' ⟶ Q), wcpaDjIsProjOver k (β ≫ sP) ∧ IsIso (β ∣_ U) ∧ γ ≫ sQ = β ≫ sP ∧ (β ⁻¹ᵁ U).ι ≫ γ = (β ∣_ U) ≫ μ :=
by
  intro k _ P Q _ sP sQ U μ hP hQ hU hμ
  haveI hsPp : IsProper sP := wcpa_dj_proj_proper k sP hP
  haveI hsQp : IsProper sQ := wcpa_dj_proj_proper k sQ hQ
  haveI : IsLocallyNoetherian P := LocallyOfFiniteType.isLocallyNoetherian sP
  haveI : CompactSpace P := QuasiCompact.compactSpace_of_compactSpace sP
  haveI : Nonempty U := by
    obtain ⟨x, hx⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).mp hU
    exact ⟨⟨x, hx⟩⟩
  haveI : AlgebraicGeometry.IsIntegral U.toScheme := inferInstance
  let g : U.toScheme ⟶ Limits.pullback sP sQ := Limits.pullback.lift U.ι μ hμ.symm
  have hgf : g ≫ Limits.pullback.fst sP sQ = U.ι := Limits.pullback.lift_fst _ _ _
  have hgs : g ≫ Limits.pullback.snd sP sQ = μ := Limits.pullback.lift_snd _ _ _
  haveI : QuasiCompact (g ≫ Limits.pullback.fst sP sQ) := by rw [hgf]; infer_instance
  haveI : QuasiCompact g := QuasiCompact.of_comp g (Limits.pullback.fst sP sQ)
  obtain ⟨hinj, hdense⟩ := wc_toImage_injective_dense _ _ g
  have hγ : g.toImage ≫ g.imageι = g := Scheme.Hom.toImage_imageι g

  have hint : AlgebraicGeometry.IsIntegral g.image ∧ IrreducibleSpace g.image := by
    haveI : AlgebraicGeometry.IsReduced g.image :=
      ⟨fun O => isReduced_of_injective (g.toImage.app O).hom (hinj O)⟩
    haveI : IrreducibleSpace g.image := by
      rw [irreducibleSpace_def]
      have hirr := ((irreducibleSpace_def U.toScheme).mp inferInstance).image g.toImage
        g.toImage.continuous.continuousOn
      rw [Set.top_eq_univ, Set.image_univ] at hirr
      have hcl := hirr.closure
      rw [hdense.closure_range] at hcl
      rw [Set.top_eq_univ]
      exact hcl
    exact ⟨isIntegral_of_irreducibleSpace_of_isReduced _, inferInstance⟩

  have hproj : wcpaDjIsProjOver k (g.imageι ≫ Limits.pullback.fst sP sQ ≫ sP) := by
    obtain ⟨M, jP, hjP, eP⟩ := hP
    obtain ⟨L, jQ, hjQ, eQ⟩ := hQ
    obtain ⟨N', σ, hσ, hσs⟩ := wc_pp_segre k M L
    haveI : MorphismProperty.IsStableUnderComposition @IsClosedImmersion :=
      ⟨fun f g hf hg => by haveI := hf; haveI := hg; infer_instance⟩
    have hm := MorphismProperty.pullbackMap (P := @IsClosedImmersion) (f := sP)
      (g := sQ) (f' := wcProjKStr k M) (g' := wcProjKStr k L) (i₁ := jP)
      (i₂ := jQ) hjP hjQ eP.symm eQ.symm
    haveI := hm
    haveI := hσ
    refine ⟨N', g.imageι ≫ Limits.pullback.map sP sQ (wcProjKStr k M) (wcProjKStr k L) jP
      jQ (𝟙 _) _ _ ≫ σ, inferInstance, ?_⟩
    simp only [Category.assoc]
    rw [hσs, Limits.pullback.lift_fst_assoc, Category.assoc, eP]
  have hC3 : (g.imageι ≫ Limits.pullback.snd sP sQ) ≫ sQ =
      (g.imageι ≫ Limits.pullback.fst sP sQ) ≫ sP := by
    rw [Category.assoc, Category.assoc, Limits.pullback.condition]
  have hproj' : wcpaDjIsProjOver k ((g.imageι ≫ Limits.pullback.fst sP sQ) ≫ sP) := by
    rw [Category.assoc]; exact hproj
  set β := g.imageι ≫ Limits.pullback.fst sP sQ with hβ
  set γ := g.imageι ≫ Limits.pullback.snd sP sQ with hγdef
  have h1 : g.toImage ≫ β = U.ι := by
    rw [hβ, ← Category.assoc, hγ]; exact hgf
  have h2 : g.toImage ≫ γ = μ := by
    rw [hγdef, ← Category.assoc, hγ]; exact hgs
  haveI : IsSeparated β := by rw [hβ]; infer_instance
  have hiso : IsIso (β ∣_ U) := wc_isIso_restrict_of_section _ _ β U g.toImage hinj h1
  haveI := hiso
  have hrange : Set.range g.toImage ⊆ Set.range (β ⁻¹ᵁ U).ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨x, rfl⟩
    show g.toImage x ∈ β ⁻¹ᵁ U
    rw [Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply, h1]
    show U.ι x ∈ (U : Set P)
    rw [← Scheme.Opens.range_ι U]
    exact ⟨x, rfl⟩
  obtain ⟨δ', hδ'⟩ : ∃ δ' : U.toScheme ⟶ (β ⁻¹ᵁ U).toScheme,
      δ' ≫ (β ⁻¹ᵁ U).ι = g.toImage :=
    ⟨IsOpenImmersion.lift _ _ hrange, IsOpenImmersion.lift_fac _ _ _⟩
  have hb : δ' ≫ (β ∣_ U) = 𝟙 _ := by
    rw [← cancel_mono U.ι, Category.assoc, morphismRestrict_ι, ← Category.assoc, hδ', h1,
      Category.id_comp]
  have hρδ : (β ∣_ U) ≫ δ' = 𝟙 _ := by
    rw [← cancel_mono (β ∣_ U), Category.assoc, hb, Category.comp_id, Category.id_comp]
  have hC4 : (β ⁻¹ᵁ U).ι ≫ γ = (β ∣_ U) ≫ μ := by
    calc (β ⁻¹ᵁ U).ι ≫ γ = ((β ∣_ U) ≫ δ') ≫ (β ⁻¹ᵁ U).ι ≫ γ := by
          rw [hρδ, Category.id_comp]
      _ = (β ∣_ U) ≫ (δ' ≫ (β ⁻¹ᵁ U).ι) ≫ γ := by simp only [Category.assoc]
      _ = (β ∣_ U) ≫ μ := by rw [hδ', h2]
  exact ⟨g.image, hint.1, β, γ, hproj', hiso, hC3, hC4⟩

theorem wcpa_dj_flrg_open_closure : ∀ (k : Type u) [Field k] (Y : Scheme.{u}) (q : Y ⟶ Spec (.of k)) [IsProper q] (W : Y.Opens), IsClosedImmersion W.ι.imageι ∧ IsIso (W.ι.imageι ∣_ W) :=
by

  have hTI : ∀ (X Y : Scheme.{u}) (f : X ⟶ Y) [QuasiCompact f],
      ∀ U : f.image.Opens, Function.Injective (f.toImage.app U) := by
    intro X Y f _ U
    rw [injective_iff_map_eq_zero]
    intro s hs
    obtain ⟨t, ht, htU⟩ := (f.imageι.isClosedEmbedding.isInducing.isOpen_iff).mp U.isOpen
    have key : ∀ x (hx : x ∈ U), ∃ V : Y.affineOpens,
        ∃ _ : f.imageι ⁻¹ᵁ (V : Y.Opens) ≤ U, x ∈ f.imageι ⁻¹ᵁ (V : Y.Opens) := by
      intro x hx
      have hx' : f.imageι x ∈ (⟨t, ht⟩ : Y.Opens) := by
        have : x ∈ f.imageι ⁻¹' t := by rw [htU]; exact hx
        exact this
      obtain ⟨V, hV, hxV, hVU⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Scheme.isBasis_affineOpens Y)) hx'
      refine ⟨⟨V, hV⟩, ?_, hxV⟩
      intro y hy
      have h1 : f.imageι y ∈ (⟨t, ht⟩ : Y.Opens) := hVU hy
      have h2 : y ∈ f.imageι ⁻¹' t := h1
      rw [htU] at h2
      exact h2
    apply TopCat.Presheaf.section_ext f.image.sheaf U s 0
    intro x hx
    obtain ⟨V, hW, hxW⟩ := key x hx
    have hres : (ConcreteCategory.hom (f.image.presheaf.map (homOfLE hW).op)) s = 0 := by
      apply f.toImage_app_injective V
      rw [map_zero, ← CommRingCat.comp_apply, Scheme.Hom.naturality, CommRingCat.comp_apply, hs,
        map_zero]
    have e := TopCat.Presheaf.germ_res_apply f.image.presheaf (homOfLE hW) x hxW s
    rw [hres, map_zero] at e
    rw [map_zero]
    exact e.symm

  have hSec : ∀ (Y' Y : Scheme.{u}) (π : Y' ⟶ Y) [IsSeparated π] (U : Y.Opens)
      (δ : (U : Scheme.{u}) ⟶ Y'), (∀ W : Y'.Opens, Function.Injective (δ.app W)) →
      δ ≫ π = U.ι → IsIso (π ∣_ U) := by
    intro Y' Y π _ U δ hinj hδπ
    have s1 : ∀ {X Z : Scheme.{u}} (f : X ⟶ Z) [IsClosedImmersion f],
        (∀ V : Z.Opens, Function.Injective (f.app V)) → IsIso f := by
      intro X Z f _ hf
      have hP : MorphismProperty.isomorphisms Scheme f := by
        rw [IsZariskiLocalAtTarget.iff_of_iSup_eq_top (P := MorphismProperty.isomorphisms Scheme)
          (fun V : Z.affineOpens => (V : Z.Opens)) (iSup_affineOpens_eq_top Z)]
        intro V
        haveI : IsAffine (V : Z.Opens) := V.2
        haveI : IsClosedImmersion (f ∣_ (V : Z.Opens)) :=
          IsZariskiLocalAtTarget.restrict (P := @IsClosedImmersion) inferInstance _
        have hbij : ∀ {A B : X.Opens} (h : A = B),
            Function.Bijective (X.presheaf.map (eqToHom h).op) := by
          intro A B h
          subst h
          rw [eqToHom_refl, op_id, CategoryTheory.Functor.map_id]
          exact ConcreteCategory.bijective_of_isIso _
        have hinjV : Function.Injective (f ∣_ (V : Z.Opens)).appTop := by
          rw [morphismRestrict_appTop]
          intro a b hab
          exact hf _ ((hbij _).1 hab)
        exact IsClosedImmersion.isIso_of_injective_of_isAffine hinjV
      exact hP
    have hrange : Set.range δ ⊆ Set.range (π ⁻¹ᵁ U).ι := by
      rintro _ ⟨x, rfl⟩
      rw [Scheme.Opens.range_ι]
      show π (δ x) ∈ (U : Set Y)
      rw [← Scheme.Hom.comp_apply, hδπ]
      have hx : U.ι x ∈ Set.range U.ι := ⟨x, rfl⟩
      rwa [Scheme.Opens.range_ι] at hx
    obtain ⟨δ', hfac⟩ : ∃ δ' : (U : Scheme.{u}) ⟶ (π ⁻¹ᵁ U : Scheme.{u}),
        δ' ≫ (π ⁻¹ᵁ U).ι = δ := ⟨_, IsOpenImmersion.lift_fac _ _ hrange⟩
    subst hfac
    have hsec : δ' ≫ π ∣_ U = 𝟙 _ := by
      rw [← cancel_mono U.ι, Category.assoc, morphismRestrict_ι, ← Category.assoc, hδπ,
        Category.id_comp]
    haveI : IsSeparated (π ∣_ U) := IsZariskiLocalAtTarget.restrict (P := @IsSeparated) ‹_› U
    haveI : IsClosedImmersion (δ' ≫ π ∣_ U) := by rw [hsec]; infer_instance
    haveI : IsClosedImmersion δ' := IsClosedImmersion.of_comp δ' (π ∣_ U)
    have hinj' : ∀ W' : (π ⁻¹ᵁ U : Scheme.{u}).Opens, Function.Injective (δ'.app W') := by
      intro W'
      have h1 := Scheme.Hom.comp_app δ' (π ⁻¹ᵁ U).ι ((π ⁻¹ᵁ U).ι ''ᵁ W')
      haveI := Scheme.Hom.isIso_app (π ⁻¹ᵁ U).ι ((π ⁻¹ᵁ U).ι ''ᵁ W')
        (Scheme.Hom.image_le_opensRange _ W')
      have hsurj := (ConcreteCategory.bijective_of_isIso
        ((π ⁻¹ᵁ U).ι.app ((π ⁻¹ᵁ U).ι ''ᵁ W'))).2
      have key : Function.Injective (δ'.app ((π ⁻¹ᵁ U).ι ⁻¹ᵁ ((π ⁻¹ᵁ U).ι ''ᵁ W'))) := by
        intro a b hab
        obtain ⟨a', rfl⟩ := hsurj a
        obtain ⟨b', rfl⟩ := hsurj b
        have h2 : (δ' ≫ (π ⁻¹ᵁ U).ι).app ((π ⁻¹ᵁ U).ι ''ᵁ W') a' =
            (δ' ≫ (π ⁻¹ᵁ U).ι).app ((π ⁻¹ᵁ U).ι ''ᵁ W') b' := by
          first
            | exact hab
            | (rw [h1]; exact hab)
        rw [hinj _ h2]
      rwa [Scheme.Hom.preimage_image_eq] at key
    haveI : IsIso δ' := s1 δ' hinj'
    haveI : IsIso (δ' ≫ π ∣_ U) := by rw [hsec]; infer_instance
    exact IsIso.of_isIso_comp_left δ' (π ∣_ U)
  intro k _ Y q _ W
  haveI : LocallyOfFiniteType q := inferInstance
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian q
  haveI : QuasiCompact W.ι := inferInstance
  haveI : IsSeparated W.ι.imageι := inferInstance
  exact ⟨inferInstance, hSec _ _ W.ι.imageι W W.ι.toImage
    (hTI _ _ W.ι) (Scheme.Hom.toImage_imageι W.ι)⟩

theorem wcpa_dj_flrg_hp_basic : ∀ (k : Type u) [Field k] (X P : Scheme.{u}) [AlgebraicGeometry.IsIntegral P] (sP : P ⟶ Spec (.of k)) (f : X ⟶ P) (U : P.Opens) (N : ℕ) (jX : X ⟶ wcProjK k N) (hcomm : jX ≫ wcProjKStr k N = f ≫ sP) (hZ : (Limits.pullback.fst f U.ι ≫ jX) ≫ wcProjKStr k N = Limits.pullback.snd f U.ι ≫ U.ι ≫ sP), IsClosedImmersion jX → wcpaDjIsProjOver k sP → U ≠ ⊥ → Flat (f ∣_ U) → Flat (Limits.pullback.snd f U.ι) ∧ IsClosedImmersion (Limits.pullback.lift (Limits.pullback.fst f U.ι ≫ jX) (Limits.pullback.snd f U.ι) hZ) ∧ AlgebraicGeometry.IsIntegral U.toScheme ∧ IsLocallyNoetherian U.toScheme ∧ CompactSpace U.toScheme :=
by
  intro k _ X P _ sP f U N jX hcomm hZ hjX hP hU hfl
  haveI hsP : IsProper sP := by
    obtain ⟨N', j, hj, hjeq⟩ := hP
    rw [← hjeq]
    haveI := hj
    haveI hst : IsScalarTower k (↥(MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) k 0))
        (MvPolynomial (Fin (N' + 1)) k) :=
      IsScalarTower.of_algebraMap_eq
        (S := ↥(MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) k 0)) (fun c => by
          rw [SetLike.GradeZero.algebraMap_apply]
          exact (SetLike.GradeZero.coe_algebraMap
            (MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) k) c).symm)
    haveI : Algebra.FiniteType (↥(MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) k 0))
        (MvPolynomial (Fin (N' + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k _ _
    haveI : IsProper (@Proj.toSpecZero _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) k) MvPolynomial.gradedAlgebra) :=
      inferInstance
    have hkey : ∀ c : k, ((algebraMap k (↥(MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) k 0)) c :
        ↥(MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) k 0)) : MvPolynomial (Fin (N' + 1)) k) =
        MvPolynomial.C c := by
      intro c
      rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
    have hbij : Function.Bijective
        (algebraMap k (↥(MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) k 0))) := by
      constructor
      · intro a b hab
        have h1 := congrArg (fun x : ↥(MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) k 0) =>
          (x : MvPolynomial (Fin (N' + 1)) k)) hab
        simp only [hkey] at h1
        exact MvPolynomial.C_injective _ _ h1
      · intro p
        have hp : (p : MvPolynomial (Fin (N' + 1)) k).IsHomogeneous 0 :=
          (MvPolynomial.mem_homogeneousSubmodule _ _).mp p.2
        have htd : (p : MvPolynomial (Fin (N' + 1)) k).totalDegree = 0 :=
          Nat.le_zero.mp hp.totalDegree_le
        refine ⟨(p : MvPolynomial (Fin (N' + 1)) k).coeff 0, Subtype.ext ?_⟩
        rw [hkey]
        exact ((MvPolynomial.totalDegree_eq_zero_iff_eq_C).mp htd).symm
    haveI : IsIso (CommRingCat.ofHom
        (algebraMap k (↥(MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) k 0)))) :=
      (ConcreteCategory.isIso_iff_bijective _).mpr hbij
    infer_instance

  have hA : Flat (Limits.pullback.snd f U.ι) := by
    rw [← pullbackRestrictIsoRestrict_hom_morphismRestrict f U]
    haveI := hfl
    infer_instance

  have hC : AlgebraicGeometry.IsIntegral U.toScheme := by
    obtain ⟨x, hx⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).mp hU
    haveI : Nonempty U.toScheme := ⟨⟨x, hx⟩⟩
    exact isIntegral_of_isOpenImmersion U.ι

  haveI hPln : IsLocallyNoetherian P := LocallyOfFiniteType.isLocallyNoetherian sP
  have hD : IsLocallyNoetherian U.toScheme := inferInstance

  have hE : CompactSpace U.toScheme := by
    haveI : CompactSpace P := QuasiCompact.compactSpace_of_compactSpace sP
    haveI : AlgebraicGeometry.IsNoetherian P := by
      first
      | exact ⟨⟩
      | exact AlgebraicGeometry.IsNoetherian.mk
      | exact {}
    exact isCompact_iff_compactSpace.mp (TopologicalSpace.NoetherianSpace.isCompact (U : Set P))

  have hε' : IsClosedImmersion (Limits.pullback.lift jX f hcomm) := by
    haveI : IsClosedImmersion (Limits.pullback.lift jX f hcomm ≫
        Limits.pullback.fst (wcProjKStr k N) sP) := by
      rw [Limits.pullback.lift_fst]; exact hjX
    exact IsClosedImmersion.of_comp _ (Limits.pullback.fst (wcProjKStr k N) sP)
  have hm : Limits.pullback.fst (wcProjKStr k N) (U.ι ≫ sP) ≫ wcProjKStr k N =
      (Limits.pullback.snd (wcProjKStr k N) (U.ι ≫ sP) ≫ U.ι) ≫ sP := by
    rw [Limits.pullback.condition, Category.assoc]
  obtain ⟨m, hm1, hm2⟩ : ∃ m : Limits.pullback (wcProjKStr k N) (U.ι ≫ sP) ⟶
      Limits.pullback (wcProjKStr k N) sP,
      m ≫ Limits.pullback.fst (wcProjKStr k N) sP =
        Limits.pullback.fst (wcProjKStr k N) (U.ι ≫ sP) ∧
      m ≫ Limits.pullback.snd (wcProjKStr k N) sP =
        Limits.pullback.snd (wcProjKStr k N) (U.ι ≫ sP) ≫ U.ι :=
    ⟨Limits.pullback.lift _ _ hm, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hSqA : IsPullback m (Limits.pullback.snd (wcProjKStr k N) (U.ι ≫ sP))
      (Limits.pullback.snd (wcProjKStr k N) sP) U.ι := by
    refine IsPullback.of_right ?_ hm2 (IsPullback.of_hasPullback (wcProjKStr k N) sP)
    rw [hm1]
    exact IsPullback.of_hasPullback (wcProjKStr k N) (U.ι ≫ sP)
  have hSqB : IsPullback (Limits.pullback.fst f U.ι)
      (Limits.pullback.lift (Limits.pullback.fst f U.ι ≫ jX) (Limits.pullback.snd f U.ι) hZ)
      (Limits.pullback.lift jX f hcomm) m := by
    refine IsPullback.of_bot ?_ ?_ hSqA
    · rw [Limits.pullback.lift_snd, Limits.pullback.lift_snd]
      exact IsPullback.of_hasPullback f U.ι
    · apply Limits.pullback.hom_ext
      · rw [Category.assoc, Category.assoc, hm1, Limits.pullback.lift_fst,
          Limits.pullback.lift_fst]
      · rw [Category.assoc, Category.assoc, hm2, Limits.pullback.lift_snd,
          ← Category.assoc, Limits.pullback.lift_snd, Limits.pullback.condition]
  have hB := MorphismProperty.of_isPullback (P := @IsClosedImmersion) hSqB hε'
  exact ⟨hA, hB, hC, hD, hE⟩

theorem wcpa_dj_flrg_sc_sat_algebra : ∀ (A : Type u) [CommRing A] (N : ℕ) (R : Fin (N + 1) → Type u) [∀ i, CommRing (R i)] (ψ : ∀ i, MvPolynomial (Fin (N + 1)) A →+* R i) (K : ∀ i, Ideal (R i)), (∀ F ∈ Ideal.span {F | ∃ e : ℕ, F.IsHomogeneous e ∧ ∀ i, ψ i F ∈ K i}, ∀ e : ℕ, MvPolynomial.homogeneousComponent e F ∈ Ideal.span {F | ∃ e : ℕ, F.IsHomogeneous e ∧ ∀ i, ψ i F ∈ K i}) ∧ (∀ (F : MvPolynomial (Fin (N + 1)) A) (e : ℕ), F.IsHomogeneous e → (F ∈ Ideal.span {F | ∃ e : ℕ, F.IsHomogeneous e ∧ ∀ i, ψ i F ∈ K i} ↔ ∀ i, ψ i F ∈ K i)) ∧ ((∀ i, ψ i (MvPolynomial.X i) = 1) → ∀ (F : MvPolynomial (Fin (N + 1)) A) (e : ℕ), F.IsHomogeneous e → (∀ i, ∃ M : ℕ, MvPolynomial.X i ^ M * F ∈ Ideal.span {F | ∃ e : ℕ, F.IsHomogeneous e ∧ ∀ i, ψ i F ∈ K i}) → F ∈ Ideal.span {F | ∃ e : ℕ, F.IsHomogeneous e ∧ ∀ i, ψ i F ∈ K i}) :=
by
  intro A _ N R _ ψ K
  classical
  set G : Set (MvPolynomial (Fin (N + 1)) A) :=
    {F | ∃ e : ℕ, F.IsHomogeneous e ∧ ∀ i, ψ i F ∈ K i} with hG

  have s2 : ∀ (i : Fin (N + 1)) (a x : MvPolynomial (Fin (N + 1)) A),
      (∀ t : ℕ, ψ i (MvPolynomial.homogeneousComponent t x) ∈ K i) →
      ∀ e : ℕ, ψ i (MvPolynomial.homogeneousComponent e (a * x)) ∈ K i := by
    intro i a x hx e
    have hax : a * x = ∑ s ∈ Finset.range (a.totalDegree + 1),
        ∑ t ∈ Finset.range (x.totalDegree + 1),
          MvPolynomial.homogeneousComponent s a * MvPolynomial.homogeneousComponent t x := by
      calc a * x = (∑ s ∈ Finset.range (a.totalDegree + 1), MvPolynomial.homogeneousComponent s a) *
            (∑ t ∈ Finset.range (x.totalDegree + 1), MvPolynomial.homogeneousComponent t x) := by
            rw [MvPolynomial.sum_homogeneousComponent, MvPolynomial.sum_homogeneousComponent]
        _ = _ := by
            rw [Finset.sum_mul]
            simp_rw [Finset.mul_sum]
    rw [hax]
    simp only [map_sum]
    refine Ideal.sum_mem _ (fun s _ => Ideal.sum_mem _ (fun t _ => ?_))
    have hh : MvPolynomial.homogeneousComponent s a * MvPolynomial.homogeneousComponent t x ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A (s + t) :=
      (MvPolynomial.mem_homogeneousSubmodule _ _).2
        ((MvPolynomial.homogeneousComponent_isHomogeneous s a).mul
          (MvPolynomial.homogeneousComponent_isHomogeneous t x))
    rw [MvPolynomial.homogeneousComponent_of_mem hh]
    split_ifs
    · rw [map_mul]; exact Ideal.mul_mem_left _ _ (hx t)
    · rw [map_zero]; exact Ideal.zero_mem _

  have s3 : ∀ x, x ∈ Ideal.span G ↔
      ∀ e i, ψ i (MvPolynomial.homogeneousComponent e x) ∈ K i := by
    intro x
    constructor
    · intro hx
      induction hx using Submodule.span_induction with
      | mem y hy =>
        obtain ⟨d, hd, hy⟩ := hy
        intro e i
        rw [MvPolynomial.homogeneousComponent_of_mem
          ((MvPolynomial.mem_homogeneousSubmodule d y).2 hd)]
        split_ifs
        · exact hy i
        · rw [map_zero]; exact Ideal.zero_mem _
      | zero => intro e i; rw [map_zero, map_zero]; exact Ideal.zero_mem _
      | add y z _ _ hy hz =>
        intro e i; rw [map_add, map_add]; exact Ideal.add_mem _ (hy e i) (hz e i)
      | smul a y _ hy =>
        intro e i; rw [smul_eq_mul]; exact s2 i a y (fun t => hy t i) e
    · intro h
      rw [← MvPolynomial.sum_homogeneousComponent x]
      exact Ideal.sum_mem _ (fun e _ => Ideal.subset_span
        ⟨e, MvPolynomial.homogeneousComponent_isHomogeneous e x, fun i => h e i⟩)
  have hcF : ∀ (F : MvPolynomial (Fin (N + 1)) A) (e : ℕ), F.IsHomogeneous e →
      MvPolynomial.homogeneousComponent e F = F := fun F e hF => by
    rw [MvPolynomial.homogeneousComponent_of_mem
      ((MvPolynomial.mem_homogeneousSubmodule e F).2 hF), if_pos rfl]
  have pb : ∀ (F : MvPolynomial (Fin (N + 1)) A) (e : ℕ), F.IsHomogeneous e →
      (F ∈ Ideal.span G ↔ ∀ i, ψ i F ∈ K i) := by
    intro F e hF
    constructor
    · intro h i
      have := (s3 F).1 h e i
      rwa [hcF F e hF] at this
    · intro h; exact Ideal.subset_span ⟨e, hF, h⟩
  refine ⟨?_, pb, ?_⟩
  · intro F hF e
    exact Ideal.subset_span
      ⟨e, MvPolynomial.homogeneousComponent_isHomogeneous e F, fun i => (s3 F).1 hF e i⟩
  · intro hX F e hF hM
    refine (pb F e hF).2 (fun i => ?_)
    obtain ⟨M, hM⟩ := hM i
    have := (pb _ (M + e) ((MvPolynomial.isHomogeneous_X_pow i M).mul hF)).1 hM i
    rwa [map_mul, map_pow, hX i, one_pow, one_mul] at this

theorem wcpa_dj_flrg_sc_psi_transition : ∀ (k : Type u) [Field k] (N : ℕ) (B : Scheme.{u}) (sB : B ⟶ Spec (.of k)) (V : B.Opens) (i j : Fin (N + 1)) (F : MvPolynomial (Fin (N + 1)) Γ(B, V)) (d : ℕ), F.IsHomogeneous d → ((Limits.pullback (wcProjKStr k N) sB).presheaf.map (homOfLE (inf_le_right : wcpaDjFlrgChart k N sB V i ⊓ wcpaDjFlrgChart k N sB V j ≤ wcpaDjFlrgChart k N sB V j)).op).hom (wcpaDjFlrgPsi k N sB V j F) = (((Limits.pullback (wcProjKStr k N) sB).presheaf.map (homOfLE (inf_le_right : wcpaDjFlrgChart k N sB V i ⊓ wcpaDjFlrgChart k N sB V j ≤ wcpaDjFlrgChart k N sB V j)).op).hom (wcpaDjFlrgPsi k N sB V j (MvPolynomial.X i))) ^ d * ((Limits.pullback (wcProjKStr k N) sB).presheaf.map (homOfLE (inf_le_left : wcpaDjFlrgChart k N sB V i ⊓ wcpaDjFlrgChart k N sB V j ≤ wcpaDjFlrgChart k N sB V i)).op).hom (wcpaDjFlrgPsi k N sB V i F) :=
by
  intro k _ N B sB V i j F d hF

  have scale : ∀ {S : Type u} [CommRing S] (f : Γ(B, V) →+* S) (c : S) (b : Fin (N + 1) → S),
      MvPolynomial.eval₂ f (fun l => c * b l) F = c ^ d * MvPolynomial.eval₂ f b F := by
    intro S _ f c b
    conv_lhs => rw [MvPolynomial.as_sum F]
    conv_rhs => rw [MvPolynomial.as_sum F]
    rw [MvPolynomial.eval₂_sum, MvPolynomial.eval₂_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun m hm => ?_)
    have hdeg : ∑ l, m l = d := by
      have := hF (MvPolynomial.mem_support_iff.mp hm)
      rw [← Finsupp.degree_eq_sum, Finsupp.degree_eq_weight_one]
      exact this
    rw [MvPolynomial.eval₂_monomial, MvPolynomial.eval₂_monomial, Finsupp.prod_pow,
      Finsupp.prod_pow]
    simp_rw [mul_pow]
    rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
    ring

  have L2 : ∀ {σ : Type u} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
      (𝒜 : ℕ → σ) [GradedRing 𝒜] (f g h : A) (hf : f ∈ 𝒜 1) (hg : g ∈ 𝒜 1) (hh : h ∈ 𝒜 1),
      (Proj 𝒜).presheaf.map (homOfLE (inf_le_left :
          Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 f)).op
          (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 h hh)) =
        (Proj 𝒜).presheaf.map (homOfLE (inf_le_left :
          Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 f)).op
          (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) *
        (Proj 𝒜).presheaf.map (homOfLE (inf_le_right :
          Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 g)).op
          (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 1 h hh)) := by
    intro σ A _ _ _ 𝒜 _ f g h hf hg hh
    have key : ∀ (W : (Proj 𝒜).Opens) (_ : W = Proj.basicOpen 𝒜 (f * g))
        (h₁ : W ≤ Proj.basicOpen 𝒜 f) (h₂ : W ≤ Proj.basicOpen 𝒜 g),
        (Proj 𝒜).presheaf.map (homOfLE h₁).op
            (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 h hh)) =
          (Proj 𝒜).presheaf.map (homOfLE h₁).op
            (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) *
          (Proj 𝒜).presheaf.map (homOfLE h₂).op
            (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 1 h hh)) := by
      rintro W rfl h₁ h₂
      have e1 : ∀ a, (Proj 𝒜).presheaf.map (homOfLE h₁).op (Proj.awayToSection 𝒜 f a) =
          Proj.awayToSection 𝒜 (f * g) (HomogeneousLocalization.awayMap 𝒜 hg rfl a) := by
        intro a
        have := ConcreteCategory.congr_hom
          (Proj.awayMap_awayToSection 𝒜 hg (rfl : f * g = f * g)) a
        exact this.symm
      have e2 : ∀ b, (Proj 𝒜).presheaf.map (homOfLE h₂).op (Proj.awayToSection 𝒜 g b) =
          Proj.awayToSection 𝒜 (f * g) (HomogeneousLocalization.awayMap 𝒜 hf (mul_comm f g) b) := by
        intro b
        have := ConcreteCategory.congr_hom
          (Proj.awayMap_awayToSection 𝒜 (f := g) hf (mul_comm f g)) b
        exact this.symm
      rw [e1, e1, e2, ← map_mul]
      congr 1
      rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
        HomogeneousLocalization.awayMap_mk]
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
        HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
        Localization.mk_mul, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      refine ⟨1, ?_⟩
      simp only [Submonoid.coe_mul, pow_one, OneMemClass.coe_one, one_mul]
      ring
    exact key _ (Proj.basicOpen_mul 𝒜 f g).symm _ _
  have hX : ∀ l : Fin (N + 1), (MvPolynomial.X l : MvPolynomial (Fin (N + 1)) k) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1 := fun l =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ l)

  have C0 : ∀ J L l : Fin (N + 1),
      ((wcProjK k N).presheaf.map (homOfLE (inf_le_left : wcSgD k N J ⊓ wcSgD k N L ≤
          wcSgD k N J)).op).hom (wcSgE k N J l) =
        ((wcProjK k N).presheaf.map (homOfLE (inf_le_left : wcSgD k N J ⊓ wcSgD k N L ≤
          wcSgD k N J)).op).hom (wcSgE k N J L) *
        ((wcProjK k N).presheaf.map (homOfLE (inf_le_right : wcSgD k N J ⊓ wcSgD k N L ≤
          wcSgD k N L)).op).hom (wcSgE k N L l) := by
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
      MvPolynomial.gradedAlgebra
    intro J L l
    exact L2 _ (MvPolynomial.X J) (MvPolynomial.X L) (MvPolynomial.X l) (hX J) (hX L) (hX l)

  have T0 : ∀ (A A' : (wcProjK k N).Opens) (kk : A' ≤ A) (s : Γ(wcProjK k N, A))
      (O : (Limits.pullback (wcProjKStr k N) sB).Opens)
      (h' : O ≤ Limits.pullback.fst (wcProjKStr k N) sB ⁻¹ᵁ A')
