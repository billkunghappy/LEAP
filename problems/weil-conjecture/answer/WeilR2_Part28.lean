  have : LocallyOfFiniteType (z ≫ s) := inferInstance
  have hloft : LocallyOfFiniteType (Spec.map φ) := by
    rw [Spec.map_preimage]; infer_instance
  have hfin : IsFinite (Spec.map φ) :=
    isFinite_iff_locallyOfFiniteType_of_jacobsonSpace.mpr hloft
  have hφ : φ.hom.Finite := (IsFinite.SpecMap_iff φ).mp hfin
  have : FiniteDimensional k (Y.residueField z₀) := hφ
  have hzpt : z (IsLocalRing.closedPoint (Y.residueField z₀)) = z₀ :=
    Scheme.fromSpecResidueField_apply z₀ _
  refine ⟨Y.residueField z₀, inferInstance, inferInstance, inferInstance, z, heq, ?_⟩
  intro y hy
  apply hOW
  rw [hy, hzpt]
  exact hz₀V

theorem wcpa_dj_gsgp_base_change_component : ∀ (K : Type u) [Field K] [Finite K] (Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral Y] (t : Y ⟶ Spec (.of K)) (n : ℕ) (π : Y ⟶ wcProjK K n) (W : Y.Opens) (K' : Type u) [Field K'] [Algebra K K'] [FiniteDimensional K K'] (z : Spec (.of K') ⟶ Y), wcpaDjIsProjOver K t → topologicalKrullDim Y = (n : WithBot ℕ∞) → IsFinite π → π ≫ wcProjKStr K n = t → Etale (W.ι ≫ π) → z ≫ t = Spec.map (CommRingCat.ofHom (algebraMap K K')) → z (IsLocalRing.closedPoint K') ∈ W → ∃ (Y' : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral Y') (c : Y' ⟶ Y) (t' : Y' ⟶ Spec (.of K')) (π' : Y' ⟶ wcProjK K' n) (e : Spec (.of K') ⟶ Y'), IsFinite c ∧ Surjective c ∧ t' ≫ Spec.map (CommRingCat.ofHom (algebraMap K K')) = c ≫ t ∧ wcpaDjIsProjOver K' t' ∧ topologicalKrullDim Y' = (n : WithBot ℕ∞) ∧ IsFinite π' ∧ π' ≫ wcProjKStr K' n = t' ∧ e ≫ c = z ∧ e ≫ t' = 𝟙 _ ∧ (∀ y₁ y₂ : Y', π' y₁ = π' y₂ → π (c y₁) = π (c y₂)) ∧ Etale ((c ⁻¹ᵁ W).ι ≫ π') :=
by
  intro K _ _ Y _ t n π W K' _ _ _ z hP hdim hπfin hπt het hz hzW
  classical

  have t_s1 : ∀ (X : Type u) [TopologicalSpace X] [QuasiSober X]
      [TopologicalSpace.NoetherianSpace X] (O : Set X), IsOpen O →
      (∀ o ∈ O, IsIrreducible {y : X | y ⤳ o}) → ∀ x ∈ O,
      ∃ Z ∈ irreducibleComponents X, x ∈ Z ∧ IsOpen (Z ∩ O) := by
    intro X _ _ _ O hO hG x _
    obtain ⟨Z, hZ, hxZ⟩ :=
      exists_mem_irreducibleComponents_subset_of_isIrreducible {x} isIrreducible_singleton
    refine ⟨Z, hZ, hxZ rfl, ?_⟩
    set B := {C ∈ irreducibleComponents X | C ≠ Z} with hB
    have hBfin : B.Finite :=
      TopologicalSpace.NoetherianSpace.finite_irreducibleComponents.subset (fun C hC => hC.1)
    have hBcl : IsClosed (⋃₀ B) :=
      hBfin.isClosed_sUnion (fun C hC => isClosed_of_mem_irreducibleComponents C hC.1)
    have key : Z ∩ O = O \ ⋃₀ B := by
      ext u
      constructor
      · rintro ⟨huZ, huO⟩
        refine ⟨huO, ?_⟩
        rintro ⟨C, ⟨hC, hCZ⟩, huC⟩
        apply hCZ
        obtain ⟨c, hc⟩ := QuasiSober.sober hC.prop (isClosed_of_mem_irreducibleComponents C hC)
        obtain ⟨ξ, hξ⟩ := QuasiSober.sober hZ.prop (isClosed_of_mem_irreducibleComponents Z hZ)
        obtain ⟨D, hD, hGD⟩ :=
          exists_mem_irreducibleComponents_subset_of_isIrreducible _ (hG u huO)
        have hDcl := isClosed_of_mem_irreducibleComponents D hD
        have hcD : c ∈ D := hGD (show c ⤳ u from hc.specializes huC)
        have hξD : ξ ∈ D := hGD (show ξ ⤳ u from hξ.specializes huZ)
        have hCD : C ⊆ D := by
          rw [← hc.def]; exact closure_minimal (Set.singleton_subset_iff.mpr hcD) hDcl
        have hZD : Z ⊆ D := by
          rw [← hξ.def]; exact closure_minimal (Set.singleton_subset_iff.mpr hξD) hDcl
        rw [hC.eq_of_subset hD.prop hCD, hZ.eq_of_subset hD.prop hZD]
      · rintro ⟨huO, hu⟩
        refine ⟨?_, huO⟩
        obtain ⟨C, hC, huC⟩ :=
          exists_mem_irreducibleComponents_subset_of_isIrreducible {u} isIrreducible_singleton
        by_contra hZu
        apply hu
        refine ⟨C, ⟨hC, ?_⟩, huC rfl⟩
        rintro rfl
        exact hZu (huC rfl)
    rw [key]
    exact hO.sdiff hBcl

  have t_s2 : ∀ (X : Scheme.{u}) (Z : TopologicalSpace.Closeds X), IsIrreducible (Z : Set X) →
      AlgebraicGeometry.IsIntegral (Scheme.IdealSheafData.vanishingIdeal Z).subscheme := by
    intro X Z hZ
    set I := Scheme.IdealSheafData.vanishingIdeal Z with hI
    have hrad : ∀ U : X.affineOpens, _root_.IsReduced (Γ(X, U) ⧸ I.ideal U) := fun U => by
      rw [← Ideal.isRadical_iff_quotient_reduced, hI, Scheme.IdealSheafData.vanishingIdeal_ideal]
      exact PrimeSpectrum.isRadical_vanishingIdeal _
    haveI : IsReduced I.subscheme :=
      @IsReduced.of_openCover _ I.subschemeCover.openCover (fun (U : X.affineOpens) => by
        haveI := hrad U
        exact (inferInstance : IsReduced (Spec (CommRingCat.of (Γ(X, U.1) ⧸ I.ideal U)))))
    have hrange : Set.range I.subschemeι = (Z : Set X) := by
      rw [Scheme.IdealSheafData.range_subschemeι, hI,
        Scheme.IdealSheafData.coe_support_vanishingIdeal]
    haveI : IrreducibleSpace (Set.range I.subschemeι) := Subtype.irreducibleSpace (hrange ▸ hZ)
    let h := (I.subschemeι.isClosedEmbedding.isEmbedding.toHomeomorph)
    haveI : IrreducibleSpace I.subscheme := by
      rw [irreducibleSpace_def]
      have := (IrreducibleSpace.isIrreducible_univ (Set.range I.subschemeι)).image h.symm
        h.symm.continuous.continuousOn
      rwa [Set.image_univ, h.symm.surjective.range_eq] at this
    exact isIntegral_of_irreducibleSpace_of_isReduced _

  have t_s3 : ∀ (X : Scheme.{u}) (Z : TopologicalSpace.Closeds X) (O : X.Opens),
      IsOpen ((Z : Set X) ∩ (O : Set X)) →
      (∀ p : X, p ∈ O → _root_.IsReduced (X.presheaf.stalk p)) →
      IsOpenImmersion (((Scheme.IdealSheafData.vanishingIdeal Z).subschemeι ⁻¹ᵁ O).ι ≫
        (Scheme.IdealSheafData.vanishingIdeal Z).subschemeι) := by
    intro X Z O hZO hred
    set I := Scheme.IdealSheafData.vanishingIdeal Z with hI
    set ι := I.subschemeι with hι
    have hrange : Set.range ι = (Z : Set X) := by
      rw [hι, Scheme.IdealSheafData.range_subschemeι, hI,
        Scheme.IdealSheafData.coe_support_vanishingIdeal]
    let O' : X.Opens := ⟨(Z : Set X) ∩ (O : Set X), hZO⟩
    haveI : Surjective (ι ∣_ O') := ⟨fun q => by
      obtain ⟨p, hp⟩ := q
      obtain ⟨y, hy⟩ : p ∈ Set.range ι := hrange ▸ hp.1
      have hyO : y ∈ ι ⁻¹ᵁ O' := by rw [Scheme.Hom.mem_preimage, hy]; exact hp
      exact ⟨⟨y, hyO⟩, Subtype.ext ((morphismRestrict_base_coe ι O' ⟨y, hyO⟩).trans hy)⟩⟩
    haveI : ∀ q : (O' : Scheme), _root_.IsReduced ((O' : Scheme).presheaf.stalk q) := fun q => by
      haveI := hred q.1 q.2.2
      exact isReduced_of_injective (Iso.commRingCatIsoToRingEquiv (O'.stalkIso q))
        (RingEquiv.injective _)
    haveI : IsReduced (O' : Scheme) := isReduced_of_isReduced_stalk _
    haveI : IsIso (ι ∣_ O') := isIso_of_isClosedImmersion_of_surjective _
    have heq : ι ⁻¹ᵁ O = ι ⁻¹ᵁ O' := by
      apply TopologicalSpace.Opens.ext
      apply Set.ext
      intro y
      show ι y ∈ (O : Set X) ↔ ι y ∈ (Z : Set X) ∩ (O : Set X)
      constructor
      · intro h; exact ⟨hrange ▸ ⟨y, rfl⟩, h⟩
      · intro h; exact h.2
    have hfac : (ι ⁻¹ᵁ O).ι ≫ ι = (I.subscheme.isoOfEq heq).hom ≫ (ι ∣_ O') ≫ O'.ι := by
      rw [morphismRestrict_ι, ← Category.assoc, Scheme.isoOfEq_hom_ι]
    rw [hfac]
    infer_instance

  have t_s4 : ∀ (Y' P Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral Y] (ι : Y' ⟶ P) (f : P ⟶ Y)
      [IsClosedImmersion ι] [IsFinite f] [Flat f], Set.range ι ∈ irreducibleComponents P →
      Surjective (ι ≫ f) := by
    intro Y' P Y _ ι f _ _ _ hZ
    obtain ⟨ζ, hζ⟩ := QuasiSober.sober hZ.prop (isClosed_of_mem_irreducibleComponents _ hZ)
    have h1 : genericPoint Y ⤳ f ζ := genericPoint_specializes _
    obtain ⟨ζ', hζ'ζ, hfζ'⟩ := Flat.generalizingMap f h1
    have hsub : Set.range ι ⊆ closure {ζ'} := by
      rw [← hζ.def]
      exact closure_minimal (Set.singleton_subset_iff.mpr (specializes_iff_mem_closure.mp hζ'ζ))
        isClosed_closure
    have heq := hZ.eq_of_subset isIrreducible_singleton.closure hsub
    have hζ'mem : ζ' ∈ Set.range ι := by rw [heq]; exact subset_closure rfl
    obtain ⟨y, hy⟩ := hζ'mem
    have hcl : IsClosed (Set.range (ι ≫ f)) := (Scheme.Hom.isClosedMap (ι ≫ f)).isClosed_range
    have hη : genericPoint Y ∈ Set.range (ι ≫ f) := ⟨y, by rw [Scheme.Hom.comp_apply, hy, hfζ']⟩
    refine ⟨fun w => ?_⟩
    have hw : w ∈ closure {genericPoint Y} := by
      rw [(genericPoint_spec Y).def]; trivial
    exact closure_minimal (Set.singleton_subset_iff.mpr hη) hcl hw

  have t_s6 : ∀ (Y PK PK' SK SK' : Scheme.{u}) (t : Y ⟶ SK) (b : SK' ⟶ SK) (sK : PK ⟶ SK)
      (sK' : PK' ⟶ SK') (π : Y ⟶ PK) (W : Y.Opens) (eP : Limits.pullback sK b ⟶ PK') [IsIso eP],
      eP ≫ sK' = Limits.pullback.snd sK b → IsFinite π → π ≫ sK = t → Etale (W.ι ≫ π) →
      ∃ (πP : Limits.pullback t b ⟶ PK') (M : PK' ⟶ PK), IsFinite πP ∧
        πP ≫ sK' = Limits.pullback.snd t b ∧ πP ≫ M = Limits.pullback.fst t b ≫ π ∧
        Etale ((Limits.pullback.fst t b ⁻¹ᵁ W).ι ≫ πP) := by
    intro Y PK PK' SK SK' t b sK sK' π W eP _ heP hπfin hπt het
    have w : (Limits.pullback.fst t b ≫ π) ≫ sK = Limits.pullback.snd t b ≫ b := by
      rw [Category.assoc, hπt, Limits.pullback.condition]
    set L := Limits.pullback.lift (Limits.pullback.fst t b ≫ π) (Limits.pullback.snd t b) w
      with hL
    have H1 : IsPullback L (Limits.pullback.fst t b) (Limits.pullback.fst sK b) π := by
      refine IsPullback.of_right (h₁₂ := Limits.pullback.snd sK b) (v₁₃ := b) (h₂₂ := sK) ?_ ?_
        (IsPullback.of_hasPullback sK b).flip
      · rw [hL, Limits.pullback.lift_snd, hπt]
        exact (IsPullback.of_hasPullback t b).flip
      · rw [hL, Limits.pullback.lift_fst]
    have H2 : IsPullback (L ≫ eP) (Limits.pullback.fst t b)
        (inv eP ≫ Limits.pullback.fst sK b) π :=
      IsPullback.of_iso H1 (Iso.refl _) (asIso eP) (Iso.refl _) (Iso.refl _) (by simp) (by simp)
        (by simp) (by simp)
    refine ⟨L ≫ eP, inv eP ≫ Limits.pullback.fst sK b,
      MorphismProperty.of_isPullback H2.flip hπfin, ?_, ?_, ?_⟩
    · rw [Category.assoc, heP, hL, Limits.pullback.lift_snd]
    · rw [Category.assoc, IsIso.hom_inv_id_assoc, hL, Limits.pullback.lift_fst]
    · exact MorphismProperty.of_isPullback
        ((isPullback_morphismRestrict (Limits.pullback.fst t b) W).paste_vert H2.flip) het

  haveI htp : IsProper t := wcpa_dj_proj_proper K t hP

  have hbfin : IsFinite (Spec.map (CommRingCat.ofHom (algebraMap K K'))) := by
    rw [IsFinite.SpecMap_iff, CommRingCat.hom_ofHom, RingHom.finite_algebraMap]
    infer_instance
  have hbflat : Flat (Spec.map (CommRingCat.ofHom (algebraMap K K'))) := by
    rw [Flat.SpecMap_iff, CommRingCat.hom_ofHom, RingHom.flat_algebraMap_iff]
    infer_instance
  set b := Spec.map (CommRingCat.ofHom (algebraMap K K')) with hb
  have Hpb := IsPullback.of_hasPullback t b
  haveI hffin : IsFinite (Limits.pullback.fst t b) := MorphismProperty.of_isPullback Hpb.flip hbfin
  haveI hfflat : Flat (Limits.pullback.fst t b) := MorphismProperty.of_isPullback Hpb.flip hbflat
  haveI : LocallyOfFiniteType (Limits.pullback.snd t b) :=
    MorphismProperty.of_isPullback Hpb (inferInstance : LocallyOfFiniteType t)
  haveI : QuasiCompact (Limits.pullback.snd t b) :=
    MorphismProperty.of_isPullback Hpb (inferInstance : QuasiCompact t)
  haveI : IsLocallyNoetherian (Limits.pullback t b) :=
    LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd t b)
  haveI : CompactSpace ((Limits.pullback t b : Scheme.{u}) : Type u) :=
    QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.snd t b)
  haveI : AlgebraicGeometry.IsNoetherian (Limits.pullback t b) := ⟨⟩

  obtain ⟨eP, heiso, heP⟩ := wcpa_proj_base_change K K' n
  haveI := heiso
  obtain ⟨πP, M, hπPfin, hπPs, hM, hOet⟩ :=
    t_s6 Y (wcProjK K n) (wcProjK K' n) (Spec (.of K)) (Spec (.of K')) t b (wcProjKStr K n)
      (wcProjKStr K' n) π W eP heP hπfin hπt het
  haveI := hπPfin

  have hdom : ∀ p : ((Limits.pullback t b : Scheme.{u}) : Type u),
      p ∈ Limits.pullback.fst t b ⁻¹ᵁ W →
      IsDomain ((Limits.pullback t b).presheaf.stalk p) := by
    intro p hp
    set O := Limits.pullback.fst t b ⁻¹ᵁ W
    haveI : SmoothOfRelativeDimension n (wcProjKStr K' n) := wc_proj_space_smooth K' n
    haveI : SmoothOfRelativeDimension 0 (O.ι ≫ πP) :=
      (Etale.iff_smoothOfRelativeDimension_zero _).mp hOet
    haveI : SmoothOfRelativeDimension (0 + n) ((O.ι ≫ πP) ≫ wcProjKStr K' n) :=
      smoothOfRelativeDimension_comp 0 n _ _
    haveI : Smooth ((O.ι ≫ πP) ≫ wcProjKStr K' n) := SmoothOfRelativeDimension.smooth (0 + n) _
    haveI := (wc_fntame_smooth_stalk_normal K' O ((O.ι ≫ πP) ≫ wcProjKStr K' n) ⟨p, hp⟩).1
    exact MulEquiv.isDomain _ (Iso.commRingCatIsoToRingEquiv (O.stalkIso ⟨p, hp⟩)).symm.toMulEquiv

  have hzw : z ≫ t = 𝟙 _ ≫ b := by rw [hz, Category.id_comp]
  set zP : Spec (.of K') ⟶ Limits.pullback t b := Limits.pullback.lift z (𝟙 _) hzw with hzP
  have hzPf : zP ≫ Limits.pullback.fst t b = z := Limits.pullback.lift_fst _ _ _
  have hzPs : zP ≫ Limits.pullback.snd t b = 𝟙 _ := Limits.pullback.lift_snd _ _ _
  have hxO : zP (IsLocalRing.closedPoint K') ∈ Limits.pullback.fst t b ⁻¹ᵁ W := by
    rw [Scheme.Hom.mem_preimage]
    have h := Scheme.Hom.comp_apply zP (Limits.pullback.fst t b) (IsLocalRing.closedPoint K')
    rw [hzPf] at h
    rw [← h]; exact hzW

  have hG : ∀ o ∈ ((Limits.pullback.fst t b ⁻¹ᵁ W : (Limits.pullback t b).Opens) :
      Set ((Limits.pullback t b : Scheme.{u}) : Type u)),
      IsIrreducible {y : ((Limits.pullback t b : Scheme.{u}) : Type u) | y ⤳ o} := by
    intro o ho
    haveI := hdom o ho
    rw [← Scheme.range_fromSpecStalk, ← Set.image_univ]
    exact (IrreducibleSpace.isIrreducible_univ _).image _
      ((Limits.pullback t b).fromSpecStalk o).continuous.continuousOn

  obtain ⟨Z, hZ, hxZ, hZO⟩ := t_s1 ((Limits.pullback t b : Scheme.{u}) : Type u) _
    (Limits.pullback.fst t b ⁻¹ᵁ W).isOpen hG _ hxO
  set Zc : TopologicalSpace.Closeds ((Limits.pullback t b : Scheme.{u}) : Type u) :=
    ⟨Z, isClosed_of_mem_irreducibleComponents Z hZ⟩ with hZc
  set I := Scheme.IdealSheafData.vanishingIdeal Zc with hI
  set ι := I.subschemeι with hι
  have hrange : Set.range ι = Z := by
    rw [hι, Scheme.IdealSheafData.range_subschemeι, hI,
      Scheme.IdealSheafData.coe_support_vanishingIdeal]
    rfl
  haveI hY'int : AlgebraicGeometry.IsIntegral I.subscheme := t_s2 _ Zc hZ.prop
  haveI hVopen : IsOpenImmersion ((ι ⁻¹ᵁ (Limits.pullback.fst t b ⁻¹ᵁ W)).ι ≫ ι) :=
    t_s3 _ Zc _ hZO (fun p hp => by haveI := hdom p hp; infer_instance)

  obtain ⟨y0, hy0⟩ : zP (IsLocalRing.closedPoint K') ∈ Set.range ι := hrange ▸ hxZ
  have hy0V : y0 ∈ ι ⁻¹ᵁ (Limits.pullback.fst t b ⁻¹ᵁ W) := by
    rw [Scheme.Hom.mem_preimage, hy0]; exact hxO
  have hsub : Set.range zP ⊆ Set.range ((ι ⁻¹ᵁ (Limits.pullback.fst t b ⁻¹ᵁ W)).ι ≫ ι) := by
    rintro _ ⟨q, rfl⟩
    refine ⟨⟨y0, hy0V⟩, ?_⟩
    have h1 := Scheme.Hom.comp_apply (ι ⁻¹ᵁ (Limits.pullback.fst t b ⁻¹ᵁ W)).ι ι ⟨y0, hy0V⟩
    rw [h1, Scheme.Opens.ι_apply]
    exact hy0.trans (congrArg zP (Subsingleton.elim _ _))
  set e := IsOpenImmersion.lift _ zP hsub ≫ (ι ⁻¹ᵁ (Limits.pullback.fst t b ⁻¹ᵁ W)).ι with he_def
  have he : e ≫ ι = zP := by
    rw [he_def, Category.assoc]; exact IsOpenImmersion.lift_fac _ _ _

  have hcsurj : Surjective (ι ≫ Limits.pullback.fst t b) :=
    t_s4 _ _ _ ι (Limits.pullback.fst t b) (by rw [hrange]; exact hZ)
  have htop : (⊤ : Y.Opens) ≠ ⊥ := by
    intro h
    obtain ⟨y⟩ := (inferInstance : Nonempty Y)
    have hy : y ∈ (⊤ : Y.Opens) := by simp
    rw [h] at hy
    simp at hy
  have hdim' : topologicalKrullDim I.subscheme = topologicalKrullDim Y :=
    wcpa_dj_alteration_dim_eq K I.subscheme Y ((ι ≫ Limits.pullback.fst t b) ≫ t) t
      (ι ≫ Limits.pullback.fst t b) rfl hcsurj ⟨⊤, htop, inferInstance⟩
  have ht' : ι ≫ Limits.pullback.snd t b = (ι ≫ πP) ≫ wcProjKStr K' n := by
    rw [Category.assoc, hπPs]
  have hE0 : wcpaDjIsProjOver K' (wcProjKStr K' n) := ⟨n, 𝟙 _, inferInstance, Category.id_comp _⟩
  have hcM : (ι ≫ Limits.pullback.fst t b) ≫ π = (ι ≫ πP) ≫ M := by
    rw [Category.assoc, Category.assoc, hM]
  have hk : Set.range ((ι ⁻¹ᵁ (Limits.pullback.fst t b ⁻¹ᵁ W)).ι ≫ ι) ⊆
      Set.range (Limits.pullback.fst t b ⁻¹ᵁ W).ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨v, rfl⟩
    have h1 := Scheme.Hom.comp_apply (ι ⁻¹ᵁ (Limits.pullback.fst t b ⁻¹ᵁ W)).ι ι v
    rw [h1]
    exact v.2
  set k := IsOpenImmersion.lift (Limits.pullback.fst t b ⁻¹ᵁ W).ι _ hk with hk_def
  have hkfac : k ≫ (Limits.pullback.fst t b ⁻¹ᵁ W).ι =
      (ι ⁻¹ᵁ (Limits.pullback.fst t b ⁻¹ᵁ W)).ι ≫ ι := IsOpenImmersion.lift_fac _ _ _
  haveI : IsOpenImmersion (k ≫ (Limits.pullback.fst t b ⁻¹ᵁ W).ι) := by
    rw [hkfac]; infer_instance
  haveI : IsOpenImmersion k := IsOpenImmersion.of_comp k (Limits.pullback.fst t b ⁻¹ᵁ W).ι
  haveI := hOet
  refine ⟨I.subscheme, hY'int, ι ≫ Limits.pullback.fst t b, ι ≫ Limits.pullback.snd t b,
    ι ≫ πP, e, inferInstance, hcsurj, ?_, ?_, hdim'.trans hdim, inferInstance, ?_, ?_, ?_, ?_, ?_⟩
  · rw [Category.assoc, Category.assoc, ← Limits.pullback.condition]
  · rw [ht']
    exact wcpa_dj_gs_finite_proj K' (ι ≫ πP) (wcProjKStr K' n) inferInstance hE0
  · rw [Category.assoc, hπPs]
  · rw [← Category.assoc, he, hzPf]
  · rw [← Category.assoc, he, hzPs]
  · intro y₁ y₂ h
    have e1 : ∀ y, π ((ι ≫ Limits.pullback.fst t b) y) = M ((ι ≫ πP) y) := fun y => by
      have h1 := Scheme.Hom.comp_apply (ι ≫ Limits.pullback.fst t b) π y
      have h2 := Scheme.Hom.comp_apply (ι ≫ πP) M y
      rw [hcM] at h1
      exact h1.symm.trans h2
    rw [e1, e1, h]
  · show Etale ((ι ⁻¹ᵁ (Limits.pullback.fst t b ⁻¹ᵁ W)).ι ≫ ι ≫ πP)
    rw [← Category.assoc, ← hkfac, Category.assoc]
    infer_instance

theorem wcpa_dj_gs_generic_projection : ∀ (k : Type u) [Field k] [Finite k] (Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral Y] (sY : Y ⟶ Spec (.of k)) (n : ℕ), wcpaDjIsProjOver k sY → topologicalKrullDim Y = (n : WithBot ℕ∞) → 1 ≤ n → ∃ (k' : Type u) (_ : Field k') (_ : Algebra k k') (_ : FiniteDimensional k k') (Y' : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral Y') (c : Y' ⟶ Y) (t : Y' ⟶ Spec (.of k')) (π : Y' ⟶ wcProjK k' n) (y₀ : Spec (.of k') ⟶ wcProjK k' n) (e : Spec (.of k') ⟶ Y') (W : Y'.Opens), IsFinite c ∧ Surjective c ∧ t ≫ Spec.map (CommRingCat.ofHom (algebraMap k k')) = c ≫ sY ∧ wcpaDjIsProjOver k' t ∧ topologicalKrullDim Y' = (n : WithBot ℕ∞) ∧ IsFinite π ∧ π ≫ wcProjKStr k' n = t ∧ y₀ ≫ wcProjKStr k' n = 𝟙 _ ∧ e ≫ π = y₀ ∧ (∀ y : Y', π y = y₀ (IsLocalRing.closedPoint k') → y ∈ W) ∧ Etale (W.ι ≫ π) :=
by
  intro k _ _ Y _ sY n hP hdim _
  obtain ⟨π₀, W₀, hW₀, hπ₀fin, hπ₀s, hπ₀et⟩ := wcpa_dj_gsgp_gen_etale_proj k Y sY n hP hdim
  obtain ⟨k', iF', iA', iFD', z, hz, hfib⟩ :=
    wcpa_dj_gsgp_good_closed_point k Y n π₀ W₀ hπ₀fin hW₀ hπ₀et
  letI := iF'
  letI := iA'
  haveI := iFD'
  have hz' : z ≫ sY = Spec.map (CommRingCat.ofHom (algebraMap k k')) := by
    rw [← hπ₀s]; exact hz
  have hzW : z (IsLocalRing.closedPoint k') ∈ W₀ := hfib _ rfl
  obtain ⟨Y', iY', c, t', π', e, hcfin, hcsurj, hbase, hPt', hdim', hπ'fin, hπ't, hec, het',
    hcompat, hπ'et⟩ :=
    wcpa_dj_gsgp_base_change_component k Y sY n π₀ W₀ k' z hP hdim hπ₀fin hπ₀s hπ₀et hz' hzW
  refine ⟨k', iF', iA', iFD', Y', iY', c, t', π', e ≫ π', e, c ⁻¹ᵁ W₀, hcfin, hcsurj, hbase,
    hPt', hdim', hπ'fin, hπ't, ?_, rfl, ?_, hπ'et⟩
  · rw [Category.assoc, hπ't, het']
  · intro y hy
    have hy' : π' y = π' (e (IsLocalRing.closedPoint k')) := hy
    have h1 := hcompat y (e (IsLocalRing.closedPoint k')) hy'
    have h2 : c (e (IsLocalRing.closedPoint k')) = z (IsLocalRing.closedPoint k') := by
      subst hec; rfl
    rw [h2] at h1
    rw [Scheme.Hom.mem_preimage]
    exact hfib _ h1

theorem wcpa_dj_gs_bf_P1_smooth : ∀ (A : Type u) [CommRing A], SmoothOfRelativeDimension 1 (wcP1 A) :=
by
  intro A _
  classical
  letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin 2) A) :=
    MvPolynomial.gradedAlgebra

  have scaling : ∀ (T : Type u) [CommRing T] (ν ι : MvPolynomial (Fin 2) A →+* T) (t : T),
      (∀ c : A, ν (MvPolynomial.C c) = ι (MvPolynomial.C c)) →
      (∀ k, ν (MvPolynomial.X k) * t = ι (MvPolynomial.X k)) →
      ∀ (n : ℕ) (a : MvPolynomial (Fin 2) A), a.IsHomogeneous n → ν a * t ^ n = ι a := by
    intro T _ ν ι t hC hXk n a ha
    conv_rhs => rw [a.as_sum]
    conv_lhs => rw [a.as_sum]
    rw [map_sum, map_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl (fun m hm => ?_)
    have hdeg : ∑ k ∈ m.support, m k = n := by
      have := ha (MvPolynomial.mem_support_iff.mp hm)
      simpa [Finsupp.weight_apply, Finsupp.sum] using this
    rw [MvPolynomial.monomial_eq, map_mul, map_mul, Finsupp.prod, map_prod, map_prod, ← hdeg,
      ← Finset.prod_pow_eq_pow_sum, mul_assoc, ← Finset.prod_mul_distrib, hC]
    congr 1
    refine Finset.prod_congr rfl (fun k _ => ?_)
    rw [map_pow, map_pow, ← mul_pow, hXk]

  have mvpoly : ∀ (S : Type u) [CommRing S] (e : MvPolynomial (Fin 1) A ≃+* S),
      RingHom.IsStandardSmoothOfRelativeDimension 1
        ((e : MvPolynomial (Fin 1) A →+* S).comp MvPolynomial.C) := by
    intro S _ e
    have h1 : RingHom.IsStandardSmoothOfRelativeDimension 1
        (algebraMap A (MvPolynomial (Fin 1) A)) := by
      rw [RingHom.isStandardSmoothOfRelativeDimension_algebraMap]
      have := Algebra.IsStandardSmoothOfRelativeDimension.mvPolynomial A (Fin 1)
      rwa [Nat.card_fin] at this
    have h3 := (RingHom.IsStandardSmoothOfRelativeDimension.equiv e).comp h1
    rw [zero_add, MvPolynomial.algebraMap_eq] at h3
    exact h3
  have hX : ∀ k : Fin 2, (MvPolynomial.X k : MvPolynomial (Fin 2) A) ∈
      MvPolynomial.homogeneousSubmodule (Fin 2) A 1 :=
    fun k => (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X A k)

  have chart : ∀ i : Fin 2, ∃ e : MvPolynomial (Fin 1) A ≃+* HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X i),
      ∀ c : A, e (MvPolynomial.C c) =
        HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin 2) A)
          (Submonoid.powers (MvPolynomial.X i))
          (algebraMap A (MvPolynomial.homogeneousSubmodule (Fin 2) A 0) c) := by
    intro i
    let κ := (HomogeneousLocalization.fromZeroRingHom
      (MvPolynomial.homogeneousSubmodule (Fin 2) A) (Submonoid.powers (MvPolynomial.X i))).comp
        (algebraMap A (MvPolynomial.homogeneousSubmodule (Fin 2) A 0))
    have h1 : ∀ j : Fin 1, (MvPolynomial.X (i.succAbove j) : MvPolynomial (Fin 2) A) ∈
        MvPolynomial.homogeneousSubmodule (Fin 2) A (1 • 1) := fun j => by
      rw [smul_eq_mul, mul_one]; exact hX _
    let y : Fin 1 → HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X i) := fun j =>
      HomogeneousLocalization.Away.mk _ (hX i) 1 (MvPolynomial.X (i.succAbove j)) (h1 j)
    let φ := MvPolynomial.eval₂Hom κ y
    let δ : MvPolynomial (Fin 2) A →ₐ[A] MvPolynomial (Fin 1) A :=
      MvPolynomial.aeval (Fin.insertNth i (1 : MvPolynomial (Fin 1) A) MvPolynomial.X)
    have hδi : δ (MvPolynomial.X i) = 1 := by
      simp only [δ, MvPolynomial.aeval_X, Fin.insertNth_apply_same]
    have hδs : ∀ j, δ (MvPolynomial.X (i.succAbove j)) = MvPolynomial.X j := by
      intro j; simp only [δ, MvPolynomial.aeval_X, Fin.insertNth_apply_succAbove]
    have hδC : ∀ c, δ (MvPolynomial.C c) = MvPolynomial.C c := by
      intro c; simp only [δ, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
    let L := Localization (Submonoid.powers (MvPolynomial.X i : MvPolynomial (Fin 2) A))
    have hu : IsUnit (δ.toRingHom (MvPolynomial.X i)) := by
      show IsUnit (δ (MvPolynomial.X i))
      rw [hδi]; exact isUnit_one
    let Λ : L →+* MvPolynomial (Fin 1) A := IsLocalization.Away.lift (MvPolynomial.X i) hu
    have hΛ : ∀ a, Λ (algebraMap _ L a) = δ a := fun a => IsLocalization.Away.lift_eq _ hu a
    let ψ : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin 2) A)
        (MvPolynomial.X i) →+* MvPolynomial (Fin 1) A := Λ.comp (algebraMap _ L)
    have hF : ∀ (n : ℕ) (a : MvPolynomial (Fin 2) A)
        (ha : a ∈ MvPolynomial.homogeneousSubmodule (Fin 2) A (n • 1)),
        ψ (HomogeneousLocalization.Away.mk _ (hX i) n a ha) = δ a := by
      intro n a ha
      have hs := IsLocalization.mk'_spec L a
        (⟨MvPolynomial.X i ^ n, n, rfl⟩ : Submonoid.powers (MvPolynomial.X i))
      have h2 := congrArg Λ hs
      rw [map_mul, hΛ, hΛ] at h2
      change Λ _ * δ (MvPolynomial.X i ^ n) = δ a at h2
      rw [map_pow, hδi, one_pow, mul_one] at h2
      show Λ (algebraMap _ L _) = _
      rw [HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
        Localization.mk_eq_mk'_apply]
      exact h2
    have hC0 : ∀ c : A, (MvPolynomial.C c : MvPolynomial (Fin 2) A) ∈
        MvPolynomial.homogeneousSubmodule (Fin 2) A (0 • 1) := fun c => by
      rw [zero_smul]
      exact (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_C _ c)
    have hκ : ∀ c, κ c = HomogeneousLocalization.Away.mk _ (hX i) 0 (MvPolynomial.C c) (hC0 c) := by
      intro c
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk]
      change (HomogeneousLocalization.mk
          ⟨0, algebraMap A _ c, 1, by rw [SetLike.GradeZero.coe_one]; exact Submonoid.one_mem _⟩ :
            HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin 2) A)
              (MvPolynomial.X i)).val = _
      rw [HomogeneousLocalization.val_mk]
      congr 1
    have hψφ : ψ.comp φ = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro c
        rw [RingHom.comp_apply, RingHom.id_apply]
        show ψ (MvPolynomial.eval₂Hom κ y (MvPolynomial.C c)) = _
        rw [MvPolynomial.eval₂Hom_C, hκ, hF, hδC]
      · intro j
        rw [RingHom.comp_apply, RingHom.id_apply]
        show ψ (MvPolynomial.eval₂Hom κ y (MvPolynomial.X j)) = _
        rw [MvPolynomial.eval₂Hom_X', hF, hδs]
    have hφψ : φ.comp ψ = RingHom.id _ := by
      refine RingHom.ext fun x => ?_
      obtain ⟨n, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective _ (hX i) x
      rw [RingHom.comp_apply, RingHom.id_apply, hF]
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk'_apply, eq_comm,
        IsLocalization.mk'_eq_iff_eq_mul]
      have hahom : a.IsHomogeneous n := by
        rw [smul_eq_mul, mul_one] at ha
        exact (MvPolynomial.mem_homogeneousSubmodule _ _).mp ha
      have key := scaling L
        ((algebraMap (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X i)) L).comp
            (φ.comp δ.toRingHom))
        (algebraMap (MvPolynomial (Fin 2) A) L)
        (algebraMap (MvPolynomial (Fin 2) A) L (MvPolynomial.X i)) ?_ ?_ n a hahom
      · rw [← key, RingHom.comp_apply, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply]
        congr 1
        exact (map_pow _ _ _).symm
      · intro c
        show algebraMap _ L (φ (δ (MvPolynomial.C c))) = _
        rw [hδC]
        show algebraMap _ L (MvPolynomial.eval₂Hom κ y (MvPolynomial.C c)) = _
        rw [MvPolynomial.eval₂Hom_C, hκ, HomogeneousLocalization.algebraMap_apply,
          HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk'_apply,
          IsLocalization.mk'_eq_iff_eq_mul]
        show _ = _ * algebraMap (MvPolynomial (Fin 2) A) L (MvPolynomial.X i ^ 0)
        rw [pow_zero, map_one, mul_one]
      · intro k
        obtain h | ⟨j, h⟩ := Fin.eq_self_or_eq_succAbove i k
        · rw [h]
          show algebraMap _ L (φ (δ (MvPolynomial.X i))) * _ = _
          rw [hδi, map_one, map_one, one_mul]
        · rw [h]
          show algebraMap _ L (φ (δ (MvPolynomial.X (i.succAbove j)))) * _ = _
          rw [hδs]
          show algebraMap _ L (MvPolynomial.eval₂Hom κ y (MvPolynomial.X j)) * _ = _
          rw [MvPolynomial.eval₂Hom_X', HomogeneousLocalization.algebraMap_apply,
            HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk'_apply]
          have hs := IsLocalization.mk'_spec L
            (MvPolynomial.X (i.succAbove j) : MvPolynomial (Fin 2) A)
            (⟨MvPolynomial.X i ^ 1, 1, rfl⟩ : Submonoid.powers (MvPolynomial.X i))
          rw [← hs]
          congr 1
          show _ = algebraMap (MvPolynomial (Fin 2) A) L (MvPolynomial.X i ^ 1)
          rw [pow_one]
    exact ⟨RingEquiv.ofRingHom φ ψ hφψ hψφ, fun c => MvPolynomial.eval₂Hom_C _ _ _⟩

  have hspan : (HomogeneousIdeal.irrelevant
      (MvPolynomial.homogeneousSubmodule (Fin 2) A)).toIdeal ≤
      Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) A)) := by
    intro a ha
    have ha2 : a ∈ HomogeneousIdeal.irrelevant
        (MvPolynomial.homogeneousSubmodule (Fin 2) A) := HomogeneousIdeal.mem_iff.mp ha
    rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply] at ha2
    have ha' : MvPolynomial.homogeneousComponent 0 a = 0 :=
      (MvPolynomial.decomposition.decompose'_apply a 0).symm.trans ha2
    rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at ha'
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    by_contra hc
    push_neg at hc
    have hm0 : m = 0 := Finsupp.ext fun k => hc k (Set.mem_univ k)
    rw [hm0] at hm
    exact (MvPolynomial.mem_support_iff.mp hm) ha'

  have hbij : Function.Bijective
      (algebraMap A ↥(MvPolynomial.homogeneousSubmodule (Fin 2) A 0)) := by
    have hC : ∀ a : A, ((algebraMap A ↥(MvPolynomial.homogeneousSubmodule (Fin 2) A 0) a :
        ↥(MvPolynomial.homogeneousSubmodule (Fin 2) A 0)) : MvPolynomial (Fin 2) A) =
        MvPolynomial.C a := by
      intro a
      rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
    refine ⟨fun a b h => ?_, fun x => ⟨(x : MvPolynomial (Fin 2) A).coeff 0, ?_⟩⟩
    · have h' := congrArg Subtype.val h
      have h'' : MvPolynomial.C a = (MvPolynomial.C b : MvPolynomial (Fin 2) A) := by
        rw [← hC a, ← hC b]
        exact h'
      exact MvPolynomial.C_injective _ _ h''
    · have hp : (x : MvPolynomial (Fin 2) A).IsHomogeneous 0 :=
        (MvPolynomial.mem_homogeneousSubmodule 0 _).mp x.2
      have h0 : (x : MvPolynomial (Fin 2) A).totalDegree = 0 := Nat.le_zero.mp hp.totalDegree_le
      apply Subtype.ext
      rw [hC]
      exact (MvPolynomial.totalDegree_eq_zero_iff_eq_C.mp h0).symm
  let α : A ≃+* ↥(MvPolynomial.homogeneousSubmodule (Fin 2) A 0) :=
    RingEquiv.ofBijective (algebraMap A ↥(MvPolynomial.homogeneousSubmodule (Fin 2) A 0)) hbij

  haveI : IsZariskiLocalAtSource (@SmoothOfRelativeDimension 1) :=
    HasRingHomProperty.instIsZariskiLocalAtSource
  apply IsZariskiLocalAtSource.of_openCover
    (Proj.affineOpenCoverOfIrrelevantLESpan (MvPolynomial.homogeneousSubmodule (Fin 2) A)
      (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) A) (m := fun _ => 1) hX
      (fun _ => one_pos) hspan).openCover
  intro (i : Fin 2)
  change SmoothOfRelativeDimension 1
    (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X i) (hX i)
      one_pos ≫ Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) A))
  rw [Proj.awayι_toSpecZero,
    HasRingHomProperty.Spec_iff (P := @SmoothOfRelativeDimension 1), CommRingCat.hom_ofHom]
  apply RingHom.locally_of RingHom.isStandardSmoothOfRelativeDimension_respectsIso
  obtain ⟨e, he⟩ := chart i
  have heq : HomogeneousLocalization.fromZeroRingHom
      (MvPolynomial.homogeneousSubmodule (Fin 2) A) (Submonoid.powers (MvPolynomial.X i)) =
      ((e : MvPolynomial (Fin 1) A →+* _).comp MvPolynomial.C).comp
        (α.symm : ↥(MvPolynomial.homogeneousSubmodule (Fin 2) A 0) →+* A) := by
    refine RingHom.ext fun z => ?_
    obtain ⟨a, rfl⟩ := α.surjective z
    rw [RingHom.comp_apply, RingHom.comp_apply]
    simp only [RingEquiv.coe_toRingHom, RingEquiv.symm_apply_apply]
    exact (he a).symm
  rw [heq]
  exact (mvpoly _ e).comp (RingHom.IsStandardSmoothOfRelativeDimension.equiv α.symm)

theorem wcpa_dj_gs_bf_P1_fibre_irred : ∀ (A : Type u) [CommRing A] (Ω : Type u) [Field Ω] (t : Spec (.of Ω) ⟶ Spec (.of ↥(MvPolynomial.homogeneousSubmodule (Fin 2) A 0))), IrreducibleSpace ↥(Limits.pullback (wcP1 A) t) :=
by
  intro A _ Ω _ t
  classical
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) A) :=
    MvPolynomial.gradedAlgebra

  have s1 : ∀ (X : Type u) [TopologicalSpace X] (U V : Set X), IsOpen U →
      IsIrreducible U → IsIrreducible V → (U ∩ V).Nonempty → (∀ x : X, x ∈ U ∨ x ∈ V) →
      IrreducibleSpace X := by
    intro X _ U V hU hUi hVi hne hcov
    have hcl : closure U = Set.univ := by
      apply Set.eq_univ_of_forall
      intro x
      rcases hcov x with hx | hx
      · exact subset_closure hx
      · have h1 : V ⊆ closure (V ∩ U) :=
          subset_closure_inter_of_isPreirreducible_of_isOpen hVi.isPreirreducible hU
            (by rw [Set.inter_comm]; exact hne)
        exact closure_mono Set.inter_subset_right (h1 hx)
    have h := hUi.closure
    rw [hcl] at h
    exact (irreducibleSpace_def X).mpr h

  have s3 : ∀ (R B : Type u) [CommRing R] [CommRing B] (φ : R →+* B) (y : B),
      Function.Bijective (Polynomial.eval₂RingHom φ y) →
      ∀ (f : Spec (.of B) ⟶ Spec (.of R)), f = Spec.map (CommRingCat.ofHom φ) →
      ∀ (g : Spec (.of Ω) ⟶ Spec (.of R)),
        IrreducibleSpace ↥(Limits.pullback f g) ∧
          ∃ w : ↥(Limits.pullback f g), Limits.pullback.fst f g w ∈ PrimeSpectrum.basicOpen y := by
    intro R B _ _ φ y hb f hf g
    subst hf
    obtain ⟨ψ₀, rfl⟩ : ∃ ψ₀, Spec.map ψ₀ = g := ⟨Spec.preimage g, Spec.map_preimage g⟩
    letI : Algebra R B := φ.toAlgebra
    letI : Algebra R Ω := ψ₀.hom.toAlgebra
    let e : Polynomial R ≃+* B := RingEquiv.ofBijective _ hb
    have he : ∀ r : R, e (algebraMap R (Polynomial R) r) = φ r := by
      intro r
      show Polynomial.eval₂ φ y (algebraMap R (Polynomial R) r) = φ r
      rw [Polynomial.algebraMap_eq, Polynomial.eval₂_C]
    let E : Polynomial Ω ≃ₐ[R] TensorProduct R B Ω :=
      (polyEquivTensor R Ω).trans ((Algebra.TensorProduct.comm R Ω (Polynomial R)).trans
        (Algebra.TensorProduct.congr (AlgEquiv.ofRingEquiv (f := e) he) AlgEquiv.refl))
    have hEX : E Polynomial.X = y ⊗ₜ[R] (1 : Ω) := by
      simp only [E, AlgEquiv.trans_apply, polyEquivTensor_apply, Polynomial.eval₂_X,
        Algebra.TensorProduct.comm_tmul, Algebra.TensorProduct.congr_apply,
        Algebra.TensorProduct.map_tmul]
      congr 1
      show Polynomial.eval₂ φ y Polynomial.X = y
      rw [Polynomial.eval₂_X]
    haveI : IsDomain (TensorProduct R B Ω) :=
      MulEquiv.isDomain (Polynomial Ω) E.symm.toRingEquiv.toMulEquiv
    let I := pullbackSpecIso R B Ω
    haveI hirrT : IrreducibleSpace ↥(Spec (.of (TensorProduct R B Ω))) :=
      show IrreducibleSpace (PrimeSpectrum (TensorProduct R B Ω)) from inferInstance
    refine ⟨@Function.Surjective.irreducibleSpace _ _ _ _ _ (Scheme.homeoOfIso I.symm).continuous
      (Scheme.homeoOfIso I.symm).surjective hirrT, ?_⟩
    let p₀ : ↥(Spec (.of (TensorProduct R B Ω))) :=
      (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum (TensorProduct R B Ω))
    refine ⟨I.inv p₀, ?_⟩
    have h1 : Limits.pullback.fst (Spec.map (CommRingCat.ofHom φ)) (Spec.map ψ₀) (I.inv p₀) =
        Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
          B →+* TensorProduct R B Ω)) p₀ := by
      rw [← Scheme.Hom.comp_apply]
      exact congrArg (fun h : Spec (.of (TensorProduct R B Ω)) ⟶ Spec (.of B) => h p₀)
        (pullbackSpecIso_inv_fst R B Ω)
    rw [h1, Spec.map_apply]
    change y ∉ (PrimeSpectrum.comap (Algebra.TensorProduct.includeLeftRingHom :
      B →+* TensorProduct R B Ω) (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum (TensorProduct R B Ω))).asIdeal
    rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap, Ideal.mem_bot,
      Algebra.TensorProduct.includeLeftRingHom_apply, ← hEX]
    exact (map_ne_zero_iff E E.injective).mpr Polynomial.X_ne_zero

  have hH : ∀ {S : Type u} [CommRing S] (g h : MvPolynomial (Fin 2) A →+* S) (s : S),
      (∀ r, g (MvPolynomial.C r) = h (MvPolynomial.C r)) →
      (∀ l, g (MvPolynomial.X l) = s * h (MvPolynomial.X l)) →
      ∀ (a : MvPolynomial (Fin 2) A) (k : ℕ), a.IsHomogeneous k → g a = s ^ k * h a := by
    intro S _ g h s hC hXs a k ha
    conv_lhs => rw [a.as_sum]
    conv_rhs => rw [a.as_sum]
    rw [map_sum, map_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun d hd => ?_
    have hdeg := ha (MvPolynomial.mem_support_iff.mp hd)
    simp only [Finsupp.weight_apply, Finsupp.sum, smul_eq_mul, mul_one, Pi.one_apply] at hdeg
    rw [MvPolynomial.monomial_eq, map_mul, map_mul, hC, Finsupp.prod, map_prod, map_prod]
    simp only [map_pow, hXs, mul_pow]
    rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
    ring
  have hX : ∀ l, (MvPolynomial.X l : MvPolynomial (Fin 2) A) ∈
      MvPolynomial.homogeneousSubmodule (Fin 2) A 1 := fun l =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X A l)

  have hdeg0 : ∀ r : ↥(MvPolynomial.homogeneousSubmodule (Fin 2) A 0),
      ∃ c : A, algebraMap A ↥(MvPolynomial.homogeneousSubmodule (Fin 2) A 0) c = r := by
    intro x
    refine ⟨(x : MvPolynomial (Fin 2) A).coeff 0, ?_⟩
    have hp : (x : MvPolynomial (Fin 2) A).IsHomogeneous 0 :=
      (MvPolynomial.mem_homogeneousSubmodule 0 _).mp x.2
    have h0 : (x : MvPolynomial (Fin 2) A).totalDegree = 0 := Nat.le_zero.mp hp.totalDegree_le
    apply Subtype.ext
    rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
    exact (MvPolynomial.totalDegree_eq_zero_iff_eq_C.mp h0).symm

  have s2 : ∀ i j : Fin 2, j = i.succAbove 0 →
      Function.Bijective (Polynomial.eval₂RingHom (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin 2) A) (Submonoid.powers (MvPolynomial.X i)))
        (HomogeneousLocalization.Away.isLocalizationElem (hX i) (hX j))) := by
    intro i j hij
    subst hij
    let y : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin 2) A)
        (MvPolynomial.X i) :=
      HomogeneousLocalization.Away.mk _ (hX i) 1 (MvPolynomial.X (i.succAbove 0))
        (by rw [one_smul]; exact hX _)
    have hy : HomogeneousLocalization.Away.isLocalizationElem (hX i) (hX (i.succAbove 0)) = y := by
      apply HomogeneousLocalization.val_injective
      simp only [y, HomogeneousLocalization.Away.isLocalizationElem.eq_1,
        HomogeneousLocalization.Away.val_mk]
      congr 1
      exact pow_one _
    rw [hy]
    let gv : Fin 2 → Polynomial (MvPolynomial.homogeneousSubmodule (Fin 2) A 0) :=
      Fin.insertNth (α := fun _ => Polynomial (MvPolynomial.homogeneousSubmodule (Fin 2) A 0)) i 1
        (fun _ => Polynomial.X)
    let cv : A →+* Polynomial (MvPolynomial.homogeneousSubmodule (Fin 2) A 0) :=
      Polynomial.C.comp (algebraMap A (MvPolynomial.homogeneousSubmodule (Fin 2) A 0))
    let ev : MvPolynomial (Fin 2) A →+* Polynomial (MvPolynomial.homogeneousSubmodule (Fin 2) A 0) :=
      MvPolynomial.eval₂Hom cv gv
    have hev_i : ev (MvPolynomial.X i) = 1 := by simp [ev, gv]
    have hev_s : ∀ j, ev (MvPolynomial.X (i.succAbove j)) = Polynomial.X := by simp [ev, gv]
    have hev_C : ∀ r, ev (MvPolynomial.C r) =
        Polynomial.C (algebraMap A (MvPolynomial.homogeneousSubmodule (Fin 2) A 0) r) := by
      simp [ev, cv]
    let φy := Polynomial.eval₂RingHom (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin 2) A) (Submonoid.powers (MvPolynomial.X i))) y
    have hc : ∀ r, (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin 2) A) (Submonoid.powers (MvPolynomial.X i))
        (algebraMap A (MvPolynomial.homogeneousSubmodule (Fin 2) A 0) r)).val =
        algebraMap (MvPolynomial (Fin 2) A) (Localization.Away
          (MvPolynomial.X i : MvPolynomial (Fin 2) A)) (MvPolynomial.C r) := by
      intro r
      rw [← Localization.mk_one_eq_algebraMap]
      rfl
    let θ := (algebraMap (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X i))
        (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A))).comp (φy.comp ev)
    have hθ : ∀ (k : ℕ) (a : MvPolynomial (Fin 2) A), a.IsHomogeneous k →
        algebraMap (MvPolynomial (Fin 2) A)
          (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) a =
        (algebraMap (MvPolynomial (Fin 2) A)
          (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A))
          (MvPolynomial.X i)) ^ k * θ a := by
      intro k a ha
      apply hH _ θ _ _ _ a k ha
      · intro r
        simp only [θ, RingHom.comp_apply, hev_C, φy, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        rw [HomogeneousLocalization.algebraMap_apply, hc]
      · intro l
        rcases Fin.eq_self_or_eq_succAbove i l with rfl | ⟨j, rfl⟩
        · simp only [θ, RingHom.comp_apply, hev_i, map_one, mul_one]
        · have hj : j = 0 := Subsingleton.elim _ _
          subst hj
          simp only [θ, RingHom.comp_apply, hev_s, φy, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
          rw [HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
            ← Localization.mk_one_eq_algebraMap, ← Localization.mk_one_eq_algebraMap,
            Localization.mk_mul, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
          refine ⟨1, ?_⟩
          simp only [OneMemClass.coe_one, one_mul, pow_one]
          try ring
    have hsurj : Function.Surjective φy := by
      intro z
      obtain ⟨k, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective _ (hX i) z
      refine ⟨ev a, ?_⟩
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk',
        IsLocalization.eq_mk'_iff_mul_eq]
      have hh : a.IsHomogeneous k := by
        have := (MvPolynomial.mem_homogeneousSubmodule _ _).mp ha
        simpa using this
      rw [hθ k a hh, mul_comm]
      congr 1
      exact map_pow _ _ _

    have hu : IsUnit (ev (MvPolynomial.X i)) := by rw [hev_i]; exact isUnit_one
    let Λ : Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A) →+*
        Polynomial (MvPolynomial.homogeneousSubmodule (Fin 2) A 0) :=
      IsLocalization.Away.lift (MvPolynomial.X i) hu
    have hΛ : ∀ a, Λ (algebraMap _ (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) a)
        = ev a := fun a => IsLocalization.Away.lift_eq _ hu a
    let D := Λ.comp (algebraMap (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X i))
        (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)))
    have hF : ∀ (n : ℕ) (a : MvPolynomial (Fin 2) A)
        (ha : a ∈ MvPolynomial.homogeneousSubmodule (Fin 2) A (n • 1)),
        D (HomogeneousLocalization.Away.mk _ (hX i) n a ha) = ev a := by
      intro n a ha
      have hs := IsLocalization.mk'_spec
        (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) a
        (⟨MvPolynomial.X i ^ n, n, rfl⟩ : Submonoid.powers (MvPolynomial.X i))
      have h2 := congrArg Λ hs
      rw [map_mul, hΛ, hΛ] at h2
      change Λ _ * ev (MvPolynomial.X i ^ n) = ev a at h2
      rw [map_pow, hev_i, one_pow, mul_one] at h2
      show Λ (algebraMap _ _ _) = _
      rw [HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
        Localization.mk_eq_mk'_apply]
      exact h2
    have hC0 : ∀ c : A, (MvPolynomial.C c : MvPolynomial (Fin 2) A) ∈
        MvPolynomial.homogeneousSubmodule (Fin 2) A (0 • 1) := fun c => by
      rw [zero_smul]
      exact (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_C _ c)
    have hκ : ∀ c, HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin 2) A) (Submonoid.powers (MvPolynomial.X i))
        (algebraMap A (MvPolynomial.homogeneousSubmodule (Fin 2) A 0) c) =
        HomogeneousLocalization.Away.mk _ (hX i) 0 (MvPolynomial.C c) (hC0 c) := by
      intro c
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk]
      change (HomogeneousLocalization.mk
          ⟨0, algebraMap A _ c, 1, by rw [SetLike.GradeZero.coe_one]; exact Submonoid.one_mem _⟩ :
            HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin 2) A)
              (MvPolynomial.X i)).val = _
      rw [HomogeneousLocalization.val_mk]
      congr 1
    have hDφ : D.comp φy = RingHom.id _ := by
      apply Polynomial.ringHom_ext
      · intro r
        obtain ⟨c, rfl⟩ := hdeg0 r
        rw [RingHom.comp_apply, RingHom.id_apply]
        show D (Polynomial.eval₂ _ y (Polynomial.C _)) = _
        rw [Polynomial.eval₂_C, hκ, hF, hev_C]
      · rw [RingHom.comp_apply, RingHom.id_apply]
        show D (Polynomial.eval₂ _ y Polynomial.X) = _
        rw [Polynomial.eval₂_X]
        show D (HomogeneousLocalization.Away.mk _ (hX i) 1 _ _) = _
        rw [hF, hev_s]
    exact ⟨Function.LeftInverse.injective (g := D) (fun p => RingHom.congr_fun hDφ p), hsurj⟩

  have hcover : (⨆ i : Fin 2, Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X i)) = ⊤ := by
    apply Proj.iSup_basicOpen_eq_top _ (fun i => MvPolynomial.X i)
    intro a ha
    have ha' := (HomogeneousIdeal.mem_irrelevant_iff _ a).mp ha
    have h0 : MvPolynomial.homogeneousComponent 0 a = 0 := by
      rw [← MvPolynomial.decomposition.decompose'_apply]
      exact ha'
    rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    have hm0 : m ≠ 0 := by
      rintro rfl
      exact (MvPolynomial.mem_support_iff.mp hm) h0
    obtain ⟨l, hl⟩ := Finsupp.ne_iff.mp hm0
    exact ⟨l, Set.mem_univ _, hl⟩

  show IrreducibleSpace ↥(Limits.pullback
    (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) A)) t)
  have hUirr : ∀ i j : Fin 2, j = i.succAbove 0 → IsIrreducible (Set.range (Limits.pullback.snd
      (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X i) (hX i) one_pos)
      (Limits.pullback.fst (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) A)) t))) := by
    intro i j hij
    obtain ⟨hirr, -⟩ := s3 _ _ _ _ (s2 i j hij) _
      (Proj.awayι_toSpecZero _ _ (hX i) one_pos) t
    haveI : IrreducibleSpace ↥(Limits.pullback
        (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X i) (hX i) one_pos)
        (Limits.pullback.fst (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) A)) t)) :=
      @Function.Surjective.irreducibleSpace _ _ _ _ _
        (Scheme.homeoOfIso (Limits.pullbackRightPullbackFstIso
          (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) A)) t
          (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X i) (hX i)
            one_pos)).symm).continuous
        (Scheme.homeoOfIso (Limits.pullbackRightPullbackFstIso
          (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) A)) t
          (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X i) (hX i)
            one_pos)).symm).surjective hirr
    rw [← Set.image_univ]
    exact (IrreducibleSpace.isIrreducible_univ _).image _ (Scheme.Hom.continuous _).continuousOn

  obtain ⟨-, w, hw⟩ := s3 _ _ _ _ (s2 0 1 (by decide)) _
    (Proj.awayι_toSpecZero _ _ (hX 0) one_pos) t
  have hv1 : Limits.pullback.fst
      (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X 0) (hX 0) one_pos)
      (Limits.pullback.fst (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) A)) t)
      ((Limits.pullbackRightPullbackFstIso
          (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) A)) t
          (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X 0) (hX 0)
            one_pos)).inv w) =
      Limits.pullback.fst
        (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X 0) (hX 0) one_pos ≫
          Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) A)) t w := by
    rw [← Scheme.Hom.comp_apply, Limits.pullbackRightPullbackFstIso_inv_fst]
  have hw' : Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X 0) (hX 0)
      one_pos (Limits.pullback.fst
        (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X 0) (hX 0) one_pos ≫
          Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) A)) t w) ∈
      Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X 1) := by
    rw [← Scheme.Hom.mem_preimage,
      Proj.awayι_preimage_basicOpen _ (hX 0) one_pos (hX 1) one_pos]
    exact hw
  have hc : ∀ v, (Limits.pullback.fst (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) A)) t)
      ((Limits.pullback.snd
        (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X 0) (hX 0) one_pos)
        (Limits.pullback.fst (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) A)) t)) v) =
      Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X 0) (hX 0) one_pos
        ((Limits.pullback.fst
        (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X 0) (hX 0) one_pos)
        (Limits.pullback.fst (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) A)) t)) v) := by
    intro v
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
  have hrange : ∀ (i : Fin 2) x, (Limits.pullback.fst
      (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) A)) t) x ∈
      Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X i) →
      x ∈ Set.range (Limits.pullback.snd
        (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X i) (hX i) one_pos)
        (Limits.pullback.fst (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) A)) t)) := by
    intro i x hx
    rw [Scheme.Pullback.range_snd, Set.mem_preimage, ← Scheme.Hom.coe_opensRange,
      Proj.opensRange_awayι]
    exact hx
  let v := (Limits.pullbackRightPullbackFstIso
          (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) A)) t
          (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X 0) (hX 0)
            one_pos)).inv w
  have hx1 := hrange 1 _ (by rw [hc v, hv1]; exact hw')
  refine s1 _ _ _ (IsOpenImmersion.isOpen_range _) (hUirr 0 1 (by decide)) (hUirr 1 0 (by decide))
    ⟨_, ⟨v, rfl⟩, hx1⟩ ?_
  intro x
  have hx : (Limits.pullback.fst (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin 2) A)) t) x ∈
      (⊤ : (Proj (MvPolynomial.homogeneousSubmodule (Fin 2) A)).Opens) := trivial
  rw [← hcover] at hx
  obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
  have h01 : i = 0 ∨ i = 1 := by fin_cases i <;> simp
  rcases h01 with rfl | rfl
  · exact Or.inl (hrange 0 x hi)
  · exact Or.inr (hrange 1 x hi)

theorem wcpa_dj_gs_bf_P1_dense : ∀ (A : Type u) [CommRing A], Dense ((@Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra (MvPolynomial.X 0) : Set ↥(@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra))) :=
by
  intro A _
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) A) := MvPolynomial.gradedAlgebra
  rw [dense_iff_inter_open]
  rintro U hU ⟨y, hyU⟩
  let y' : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin 2) A) := y
  haveI hQ : y'.asHomogeneousIdeal.toIdeal.IsPrime := y'.isPrime
  set p : Ideal A := Ideal.comap (MvPolynomial.C : A →+* MvPolynomial (Fin 2) A)
    y'.asHomogeneousIdeal.toIdeal with hp
  haveI hpP : p.IsPrime := Ideal.IsPrime.comap _
  set P : Ideal (MvPolynomial (Fin 2) A) :=
    Ideal.map (MvPolynomial.C : A →+* MvPolynomial (Fin 2) A) p with hPdef
  have hPker : P = RingHom.ker (MvPolynomial.map (Ideal.Quotient.mk p) :
      MvPolynomial (Fin 2) A →+* MvPolynomial (Fin 2) (A ⧸ p)) := by
    rw [MvPolynomial.ker_map, Ideal.mk_ker]
  have hPprime : P.IsPrime := by rw [hPker]; exact RingHom.ker_isPrime _
  have hPhom : P.IsHomogeneous (MvPolynomial.homogeneousSubmodule (Fin 2) A) := by
    have e : P = Ideal.span (MvPolynomial.C '' (p : Set A)) := rfl
    rw [e]
    apply Ideal.homogeneous_span
    rintro _ ⟨a, _, rfl⟩
    exact ⟨0, (MvPolynomial.mem_homogeneousSubmodule 0 _).mpr (MvPolynomial.isHomogeneous_C _ a)⟩
  have hX0 : (MvPolynomial.X 0 : MvPolynomial (Fin 2) A) ∉ P := by
    intro h
    rw [hPdef, MvPolynomial.mem_map_C_iff] at h
    have h1 := h (Finsupp.single 0 1)
    rw [MvPolynomial.coeff_X, if_pos rfl] at h1
    exact hpP.ne_top (Ideal.eq_top_of_isUnit_mem p h1 isUnit_one)
  let PH : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin 2) A) := ⟨P, hPhom⟩
  have hirr : ¬ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin 2) A) ≤ PH := by
    intro h
    apply hX0
    have hX : (MvPolynomial.X 0 : MvPolynomial (Fin 2) A) ∈
        MvPolynomial.homogeneousSubmodule (Fin 2) A 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X A 0)
    exact h (HomogeneousIdeal.mem_irrelevant_of_mem _ one_pos hX)
  let x : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin 2) A) := ⟨PH, hPprime, hirr⟩
  let x' : ↥(Proj (MvPolynomial.homogeneousSubmodule (Fin 2) A)) := x
  have hxD : x' ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) A) (MvPolynomial.X 0) :=
    (Proj.mem_basicOpen _ _ x').mpr hX0
  have hxy : x ≤ y' := by
    rw [← ProjectiveSpectrum.as_ideal_le_as_ideal]
    intro z hz
    exact Ideal.map_comap_le hz
  have hcl : y' ∈ closure ({x} : Set (ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin 2) A))) :=
    (ProjectiveSpectrum.le_iff_mem_closure _ x y').mp hxy
  have hsp : x ⤳ y' := specializes_iff_mem_closure.mpr hcl
  have hU' : IsOpen (U : Set (ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin 2) A))) := hU
  exact ⟨x', hsp.mem_open hU' hyU, hxD⟩

theorem wcpa_dj_gs_bf_chart_closedImm : ∀ (K : Type u) [Field K] (n : ℕ) (j : Fin (n + 1)) (i : Fin (n + 1 + 1)) (h : Spec (.of (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin 2) (wcBlB K n {j})) (wcBlF K n ⟨{j}, Finset.singleton_nonempty j⟩ (MvPolynomial.X i)))) ⟶ Limits.pullback (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K) (MvPolynomial.X i) ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K i)) one_pos ≫ wcProjKStr K (n + 1)) (wcBlι K n {j} (Finset.singleton_nonempty j) ≫ wcProjKStr K n)), h ≫ Limits.pullback.fst _ _ = Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map (wcBlF K n ⟨{j}, Finset.singleton_nonempty j⟩) (MvPolynomial.X i))) → h ≫ Limits.pullback.snd _ _ = Spec.map (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin 2) (wcBlB K n {j})) (Submonoid.powers (wcBlF K n ⟨{j}, Finset.singleton_nonempty j⟩ (MvPolynomial.X i)))).comp (algebraMap (wcBlB K n {j}) ↥(MvPolynomial.homogeneousSubmodule (Fin 2) (wcBlB K n {j}) 0)))) → IsClosedImmersion h :=
by

  have hSP : ∀ {K A B R : Type u} [CommRing K] [CommRing A] [CommRing B] [CommRing R]
      (αA : K →+* A) (αB : K →+* B) (φ : A →+* R) (ψ : B →+* R)
      (f : Spec (.of A) ⟶ Spec (.of K)) (g : Spec (.of B) ⟶ Spec (.of K))
      (h : Spec (.of R) ⟶ Limits.pullback f g),
      f = Spec.map (CommRingCat.ofHom αA) → g = Spec.map (CommRingCat.ofHom αB) →
      h ≫ Limits.pullback.fst f g = Spec.map (CommRingCat.ofHom φ) →
      h ≫ Limits.pullback.snd f g = Spec.map (CommRingCat.ofHom ψ) →
      (∀ r : R, r ∈ Subring.closure (Set.range φ ∪ Set.range ψ)) → IsClosedImmersion h := by
    intro K A B R _ _ _ _ αA αB φ ψ f g h hf hg h1 h2 hgen
    subst hf hg
    have hc : φ.comp αA = ψ.comp αB := by
      have e : Spec.map (CommRingCat.ofHom φ) ≫ Spec.map (CommRingCat.ofHom αA) =
          Spec.map (CommRingCat.ofHom ψ) ≫ Spec.map (CommRingCat.ofHom αB) := by
        rw [← h1, ← h2, Category.assoc, Category.assoc, Limits.pullback.condition]
      rw [← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← CommRingCat.ofHom_comp] at e
      have e' := Spec.map_injective e
      exact congrArg CommRingCat.Hom.hom e'
    letI : Algebra K A := αA.toAlgebra
    letI : Algebra K B := αB.toAlgebra
    letI : Algebra K R := (φ.comp αA).toAlgebra
    let φ' : A →ₐ[K] R := { φ with commutes' := fun k => rfl }
    let ψ' : B →ₐ[K] R := { ψ with commutes' := fun k => (RingHom.congr_fun hc k).symm }
    let θ : TensorProduct K A B →ₐ[K] R := Algebra.TensorProduct.productMap φ' ψ'
    have hθl : ∀ a : A, θ (a ⊗ₜ[K] (1 : B)) = φ a := by
      intro a
      simp [θ, φ', ψ']
    have hθr : ∀ b : B, θ ((1 : A) ⊗ₜ[K] b) = ψ b := by
      intro b
      simp [θ, φ', ψ']
    have hθ : Function.Surjective θ := by
      intro r
      have hle : Subring.closure (Set.range φ ∪ Set.range ψ) ≤ θ.toRingHom.range := by
        rw [Subring.closure_le]
        rintro _ (⟨a, rfl⟩ | ⟨b, rfl⟩)
        · exact ⟨a ⊗ₜ[K] (1 : B), hθl a⟩
        · exact ⟨(1 : A) ⊗ₜ[K] b, hθr b⟩
      obtain ⟨t, ht⟩ := hle (hgen r)
      exact ⟨t, ht⟩
    haveI hci : IsClosedImmersion (Spec.map (CommRingCat.ofHom θ.toRingHom)) :=
      IsClosedImmersion.spec_of_surjective _ hθ
    have e1 : (pullbackSpecIso K A B).inv ≫ Limits.pullback.fst (Spec.map (CommRingCat.ofHom αA))
        (Spec.map (CommRingCat.ofHom αB)) =
        Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) :=
      pullbackSpecIso_inv_fst K A B
    have e2 : (pullbackSpecIso K A B).inv ≫ Limits.pullback.snd (Spec.map (CommRingCat.ofHom αA))
        (Spec.map (CommRingCat.ofHom αB)) =
        Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight : B →ₐ[K] TensorProduct K A B).toRingHom) :=
      pullbackSpecIso_inv_snd K A B
    have heq : h = Spec.map (CommRingCat.ofHom θ.toRingHom) ≫ (pullbackSpecIso K A B).inv := by
      apply Limits.pullback.hom_ext
      · rw [h1, Category.assoc, e1, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
        congr 2
        ext a
        exact (hθl a).symm
      · rw [h2, Category.assoc, e2, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
        congr 2
        ext b
        exact (hθr b).symm
    rw [heq]
    infer_instance

  have hvm : ∀ {A σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ)
      [GradedRing 𝒜] (z : A) (d : ℕ) (hz : z ∈ 𝒜 d) (k : ℕ) (a : A) (ha : a ∈ 𝒜 (k • d)),
      HomogeneousLocalization.val (HomogeneousLocalization.Away.mk 𝒜 hz k a ha) *
        algebraMap A (Localization.Away z) z ^ k = algebraMap A (Localization.Away z) a := by
    intro A σ _ _ _ 𝒜 _ z d hz k a ha
    rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk', ← map_pow]
    exact IsLocalization.mk'_spec _ _ _

  have hAG : ∀ (S : Type u) [CommRing S] (u : MvPolynomial (Fin 2) S)
      (hu : u ∈ MvPolynomial.homogeneousSubmodule (Fin 2) S 1)
      (g0 g1 : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin 2) S) u),
      HomogeneousLocalization.val g0 * algebraMap (MvPolynomial (Fin 2) S) (Localization.Away u) u =
        algebraMap (MvPolynomial (Fin 2) S) (Localization.Away u) (MvPolynomial.X 0) →
      HomogeneousLocalization.val g1 * algebraMap (MvPolynomial (Fin 2) S) (Localization.Away u) u =
        algebraMap (MvPolynomial (Fin 2) S) (Localization.Away u) (MvPolynomial.X 1) →
      ∀ x : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin 2) S) u,
        x ∈ Subring.closure ({g0, g1} ∪ Set.range
          ((HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin 2) S)
            (Submonoid.powers u)).comp
              (algebraMap S ↥(MvPolynomial.homogeneousSubmodule (Fin 2) S 0)))) := by
    have hH : ∀ {S : Type u} [CommRing S] (R : Type u) [CommRing R] (m : ℕ)
        (g h : MvPolynomial (Fin m) R →+* S) (s : S),
        (∀ r, g (MvPolynomial.C r) = h (MvPolynomial.C r)) →
        (∀ l, g (MvPolynomial.X l) = s * h (MvPolynomial.X l)) →
        ∀ (a : MvPolynomial (Fin m) R) (k : ℕ), a.IsHomogeneous k → g a = s ^ k * h a := by
      intro S _ R _ m g h s hC hXs a k ha
      conv_lhs => rw [a.as_sum]
      conv_rhs => rw [a.as_sum]
      rw [map_sum, map_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl fun d hd => ?_
      have hdeg := ha (MvPolynomial.mem_support_iff.mp hd)
      simp only [Finsupp.weight_apply, Finsupp.sum, smul_eq_mul, mul_one, Pi.one_apply] at hdeg
      rw [MvPolynomial.monomial_eq, map_mul, map_mul, hC, Finsupp.prod, map_prod, map_prod]
