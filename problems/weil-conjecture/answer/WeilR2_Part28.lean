    let κ := (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin 2) S)
            (Submonoid.powers u)).comp (algebraMap S ↥(MvPolynomial.homogeneousSubmodule (Fin 2) S 0))
    let Θ : MvPolynomial (Fin 2) S →+*
        HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin 2) S) u :=
      MvPolynomial.eval₂Hom κ ![g0, g1]
    have hΘC : ∀ s, Θ (MvPolynomial.C s) = κ s := fun s => MvPolynomial.eval₂Hom_C _ _ _
    have hΘX : ∀ p, Θ (MvPolynomial.X p) = ![g0, g1] p := fun p => MvPolynomial.eval₂Hom_X' _ _ _
