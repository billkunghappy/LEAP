  have s5 : ∀ (KQ KG E : Type u) [CommRing KQ] [CommRing KG] [CommRing E] (i : KQ →+* KG)
      (u : KG →+* E) (v : KQ →+* E) (F : E →+* E), Function.Injective u → Function.Injective F →
