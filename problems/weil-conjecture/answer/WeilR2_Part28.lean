  obtain ⟨c, hc⟩ := TopologicalSpace.Opens.mem_iSup.mp hxc
  obtain ⟨V', hV'aff, hxV', hV'le⟩ :=
    TopologicalSpace.Opens.isBasis_iff_nbhd.mp P'.isBasis_affineOpens
