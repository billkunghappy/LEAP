  ·
    rw [Category.assoc, ← hσρ, ← Category.assoc, ← Limits.pullback.condition, Category.assoc, hπ't]
  ·
    obtain ⟨ι, hι, hι1, _⟩ := hcg π' σB ρ (wcProjKStr k' (d + 1)) (wcProjKStr k' d) t ιP hπ't hιP
