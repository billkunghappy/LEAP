theorem wcpa_dj_gsgp_good_closed_point : ∀ (k : Type u) [Field k] [Finite k] (Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral Y] (n : ℕ) (π : Y ⟶ wcProjK k n) (W : Y.Opens), IsFinite π → W ≠ ⊥ → Etale (W.ι ≫ π) → ∃ (k' : Type u) (_ : Field k') (_ : Algebra k k') (_ : FiniteDimensional k k') (z : Spec (.of k') ⟶ Y), z ≫ π ≫ wcProjKStr k n = Spec.map (CommRingCat.ofHom (algebraMap k k')) ∧ ∀ y : Y, π y = π (z (IsLocalRing.closedPoint k')) → y ∈ W :=
by
  intro k _ _ Y _ n π W hπ hW _
  have := hπ

  have hsp : ∀ x y : Y, x ⤳ y → π x = π y → x = y := by
    intro x y hxy he
    set T : Set Y := π ⁻¹' {π y} with hT
    have : DiscreteTopology (π.fiber (π y)) := inferInstance
    have : DiscreteTopology T := (Scheme.Hom.fiberHomeo π (π y)).discreteTopology
    have hx : x ∈ T := he
    have hy : y ∈ T := rfl
    have h1 : (⟨x, hx⟩ : T) ⤳ ⟨y, hy⟩ := Topology.IsInducing.subtypeVal.specializes_iff.mp hxy
    exact congrArg Subtype.val h1.eq

  have hηW : genericPoint Y ∈ W :=
    ((genericPoint_spec Y).mem_open_set_iff W.isOpen).mpr
      (by simpa using (TopologicalSpace.Opens.ne_bot_iff_nonempty W).mp hW)
  have hB : IsClosed (π '' (W : Set Y)ᶜ) := π.isClosedMap _ W.isOpen.isClosed_compl
  let O : (wcProjK k n).Opens := ⟨(π '' (W : Set Y)ᶜ)ᶜ, hB.isOpen_compl⟩
  have hO : π ⁻¹ᵁ O ≠ ⊥ := by
    rw [TopologicalSpace.Opens.ne_bot_iff_nonempty]
    refine ⟨genericPoint Y, ?_⟩
    show π (genericPoint Y) ∈ (π '' (W : Set Y)ᶜ)ᶜ
    rintro ⟨w, hw, hwe⟩
    have h := hsp _ _ ((genericPoint_spec Y).specializes (Set.mem_univ w)) hwe.symm
    exact hw (h ▸ hηW)
  have hOW : ∀ y : Y, π y ∈ O → y ∈ W := by
    intro y hy
    by_contra hyW
    exact hy ⟨y, hyW, rfl⟩

  have : IsProper (wcProjKStr k n) := by
    letI := @MvPolynomial.gradedAlgebra (Fin (n+1)) k _
    letI : IsScalarTower k ((MvPolynomial.homogeneousSubmodule (Fin (n+1)) k) 0)
        (MvPolynomial (Fin (n+1)) k) :=
      IsScalarTower.of_algebraMap_eq (R := k)
        (S := (MvPolynomial.homogeneousSubmodule (Fin (n+1)) k) 0)
        (A := MvPolynomial (Fin (n+1)) k) (fun r => rfl)
    haveI : Algebra.FiniteType ((MvPolynomial.homogeneousSubmodule (Fin (n+1)) k) 0)
        (MvPolynomial (Fin (n+1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k _ _
    haveI : IsProper (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (n+1)) k)) :=
      inferInstance
    have hbij : Function.Bijective
        (algebraMap k ((MvPolynomial.homogeneousSubmodule (Fin (n+1)) k) 0)) := by
      constructor
      · intro a b hab
        have h := congrArg (fun x : (MvPolynomial.homogeneousSubmodule (Fin (n+1)) k) 0 =>
          (x : MvPolynomial (Fin (n+1)) k)) hab
        simp only [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq] at h
        exact MvPolynomial.C_injective _ _ h
      · intro x
        have hx : (x : MvPolynomial (Fin (n+1)) k).IsHomogeneous 0 :=
          (MvPolynomial.mem_homogeneousSubmodule 0 _).mp x.2
        have ht : (x : MvPolynomial (Fin (n+1)) k).totalDegree = 0 :=
          Nat.le_zero.mp hx.totalDegree_le
        refine ⟨(x : MvPolynomial (Fin (n+1)) k).coeff 0, Subtype.ext ?_⟩
        simp only [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
        exact ((MvPolynomial.totalDegree_eq_zero_iff_eq_C).mp ht).symm
    haveI : IsIso (CommRingCat.ofHom
        (algebraMap k ((MvPolynomial.homogeneousSubmodule (Fin (n+1)) k) 0))) := by
      rw [ConcreteCategory.isIso_iff_bijective]
      exact hbij
    show IsProper (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (n+1)) k) ≫
      Spec.map (CommRingCat.ofHom
        (algebraMap k ((MvPolynomial.homogeneousSubmodule (Fin (n+1)) k) 0))))
    infer_instance
  set s : Y ⟶ Spec (.of k) := π ≫ wcProjKStr k n with hs
  have hsl : LocallyOfFiniteType s := inferInstance
  have : JacobsonSpace Y := LocallyOfFiniteType.jacobsonSpace s
  obtain ⟨z₀, hz₀V, hz₀c⟩ := nonempty_inter_closedPoints
    ((TopologicalSpace.Opens.ne_bot_iff_nonempty _).mp hO) (π ⁻¹ᵁ O).isOpen.isLocallyClosed
