  have hcg : ∀ {Y P B C S : Scheme.{u}} (π : Y ⟶ B) (σB : P ⟶ B) (ρ : P ⟶ C) (sB : B ⟶ S)
      (sC : C ⟶ S) (t : Y ⟶ S) (ιP : P ⟶ Limits.pullback sB sC), π ≫ sB = t →
