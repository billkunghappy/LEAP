      have h2 : Spec.preimage (W.fromSpecResidueField x ≫ q) ≫ a' = 𝟙 _ := by
        apply Spec.map_injective
        rw [Spec.map_comp, hbm, ha', Spec.map_id]
      have e1 : ∀ k, a.hom ((Spec.preimage (W.fromSpecResidueField x ≫ q)).hom k) = k := by
        intro k
        have := congrArg (fun f => f.hom k) h1
        simpa using this
      have e2 : ∀ k, a'.hom ((Spec.preimage (W.fromSpecResidueField x ≫ q)).hom k) = k := by
        intro k
        have := congrArg (fun f => f.hom k) h2
        simpa using this
      have hinj : Function.Injective a.hom := RingHom.injective a.hom
      have e3 : ∀ y, (Spec.preimage (W.fromSpecResidueField x ≫ q)).hom (a.hom y) = y :=
        fun y => hinj (e1 (a.hom y))
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro y
      calc a.hom y = a'.hom ((Spec.preimage (W.fromSpecResidueField x ≫ q)).hom (a.hom y)) :=
            (e2 _).symm
        _ = a'.hom y := by rw [e3]
    have ht := Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField K W t
    have ht' := Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField K W t'
    obtain ⟨a, ha⟩ : ∃ a : W.residueField (t (IsLocalRing.closedPoint K)) ⟶ CommRingCat.of K,
        Spec.map a ≫ W.fromSpecResidueField (t (IsLocalRing.closedPoint K)) = t := ⟨_, ht⟩
    obtain ⟨a', ha'⟩ : ∃ a' : W.residueField (t (IsLocalRing.closedPoint K)) ⟶ CommRingCat.of K,
        Spec.map a' ≫ W.fromSpecResidueField (t (IsLocalRing.closedPoint K)) = t' := by
      rw [hpt]; exact ⟨_, ht'⟩
    have hk : a = a' := key _ a a'
      (by rw [← Category.assoc, ha, hq]) (by rw [← Category.assoc, ha', hq'])
    calc t = Spec.map a ≫ W.fromSpecResidueField (t (IsLocalRing.closedPoint K)) := ha.symm
      _ = Spec.map a' ≫ W.fromSpecResidueField (t (IsLocalRing.closedPoint K)) := by rw [hk]
      _ = t' := ha'

  have hbc : ∀ {A B σ τ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] [CommRing B]
      [SetLike τ B] [AddSubgroupClass τ B] {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]
      (f : 𝒜 →+*ᵍ ℬ)
      (hf : HomogeneousIdeal.irrelevant ℬ ≤ HomogeneousIdeal.map f (HomogeneousIdeal.irrelevant 𝒜))
      (f₀ : ↥(𝒜 0) →+* ↥(ℬ 0)), (∀ a : ↥(𝒜 0), ((f₀ a : ↥(ℬ 0)) : B) = f (a : A)) →
      Proj.map f hf ≫ Proj.toSpecZero 𝒜 = Proj.toSpecZero ℬ ≫ Spec.map (CommRingCat.ofHom f₀) := by
    intro A B σ τ _ _ _ _ _ _ 𝒜 ℬ _ _ f hf f₀ hf₀
    have s1 : ∀ s : A, (HomogeneousLocalization.Away.map f s).comp
        (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers s)) =
        (HomogeneousLocalization.fromZeroRingHom ℬ (Submonoid.powers (f s))).comp f₀ := by
      intro s
      refine RingHom.ext (fun a => ?_)
      apply HomogeneousLocalization.val_injective
      simp only [RingHom.comp_apply]
      show (HomogeneousLocalization.Away.map f s (HomogeneousLocalization.mk ⟨0, a, 1, _⟩)).val =
        (HomogeneousLocalization.mk ⟨0, f₀ a, 1, _⟩ :
          HomogeneousLocalization ℬ (Submonoid.powers (f s))).val
      rw [HomogeneousLocalization.Away.map, HomogeneousLocalization.map_mk,
        HomogeneousLocalization.val_mk, HomogeneousLocalization.val_mk]
      simp only [SetLike.GradeZero.coe_one, map_one, hf₀]
    have s2 : ∀ x : Proj ℬ, ∃ i, ∃ s ∈ 𝒜 i, 0 < i ∧ x ∈ Proj.basicOpen ℬ (f s) := by
      intro x
      by_contra hcon
      push_neg at hcon
      apply ProjectiveSpectrum.not_irrelevant_le (x : ProjectiveSpectrum ℬ)
      intro b hb
      have hb' := hf hb
      have hle : (HomogeneousIdeal.map f (HomogeneousIdeal.irrelevant 𝒜)).toIdeal ≤
          (x : ProjectiveSpectrum ℬ).asHomogeneousIdeal.toIdeal := by
        rw [HomogeneousIdeal.toIdeal_map, HomogeneousIdeal.irrelevant_eq_span, Ideal.map_span,
          Ideal.span_le]
        rintro _ ⟨y, hy, rfl⟩
        simp only [Set.mem_iUnion] at hy
        obtain ⟨i, hi, hyi⟩ := hy
        have h1 := hcon i y hyi hi
        rw [Proj.mem_basicOpen] at h1
        push_neg at h1
        exact h1
      exact hle hb'
    let 𝒰 : (Proj ℬ).OpenCover := Scheme.Cover.mkOfCovers (P := @IsOpenImmersion)
        {p : ℕ × A // p.2 ∈ 𝒜 p.1 ∧ 0 < p.1}
        (fun j => Spec (.of (HomogeneousLocalization.Away ℬ (f j.1.2))))
        (fun j => Proj.awayι ℬ (f j.1.2) (f.map_mem j.2.1) j.2.2) (fun x => by
          obtain ⟨i, s, hs, hi, hx⟩ := s2 x
          rw [← Proj.opensRange_awayι ℬ (f s) (f.map_mem hs) hi] at hx
          obtain ⟨y, hy⟩ := hx
          exact ⟨⟨(i, s), hs, hi⟩, y, hy⟩)
    refine Scheme.Cover.hom_ext 𝒰 _ _ (fun j => ?_)
    obtain ⟨⟨i, s⟩, hs, hi⟩ := j
    have hs' : s ∈ 𝒜 i := hs
    have hi' : 0 < i := hi
    show Proj.awayι ℬ (f s) (f.map_mem hs') hi' ≫ _ = Proj.awayι ℬ (f s) (f.map_mem hs') hi' ≫ _
    rw [Proj.awayι_comp_map_assoc f hf hi' s hs', Proj.awayι_toSpecZero, Proj.awayι_toSpecZero_assoc,
      ← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, s1]

  have hlin : ∀ (d : ℕ) (x₀ : Spec (.of K) ⟶ wcProjK K d), x₀ ≫ wcProjKStr K d = 𝟙 _ →
      ∃ L M : Fin (d + 1) → MvPolynomial (Fin (d + 1)) K, (∀ i, (L i).IsHomogeneous 1) ∧
        (∀ i, (M i).IsHomogeneous 1) ∧ (∀ i, MvPolynomial.aeval L (M i) = MvPolynomial.X i) ∧
        (∀ i, MvPolynomial.aeval M (L i) = MvPolynomial.X i) ∧
        ∀ i : Fin (d + 1), i.val < d → x₀ (IsLocalRing.closedPoint K) ∉
          @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)
            MvPolynomial.gradedAlgebra (L i) := by
    intro d x₀ hx₀
    letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) :=
      MvPolynomial.gradedAlgebra
    have hX : ∀ b : Fin (d + 1), (MvPolynomial.X b : MvPolynomial (Fin (d + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K 1 :=
      fun b => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K b)
    have hcover : ⨆ i, Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)
        (MvPolynomial.X i : MvPolynomial (Fin (d + 1)) K) = ⊤ := by
      apply Proj.iSup_basicOpen_eq_top
      rw [HomogeneousIdeal.toIdeal_irrelevant_le]
      intro i hi p hp
      have hp' : p.IsHomogeneous i := (MvPolynomial.mem_homogeneousSubmodule i p).mp hp
      show p ∈ Ideal.span _
      rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      by_contra hcon
      push_neg at hcon
      have hm0 : m = 0 := Finsupp.ext fun j => hcon j (Set.mem_univ _)
      have h1 := hp' (MvPolynomial.mem_support_iff.mp hm)
      subst hm0
      simp at h1
      omega
    obtain ⟨a, ha⟩ : ∃ a : Fin (d + 1), x₀ (IsLocalRing.closedPoint K) ∈
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)
          (MvPolynomial.X a : MvPolynomial (Fin (d + 1)) K) := by
      have h : x₀ (IsLocalRing.closedPoint K) ∈ (⊤ : (wcProjK K d).Opens) := trivial
      rw [← hcover, TopologicalSpace.Opens.mem_iSup] at h
      exact h
    have hrange : Set.range x₀ ⊆ Set.range (Proj.awayι
        (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) (MvPolynomial.X a) (hX a) one_pos) := by
      rintro _ ⟨p, rfl⟩
      rw [show p = IsLocalRing.closedPoint K from Subsingleton.elim (α := PrimeSpectrum K) _ _]
      have h : x₀ (IsLocalRing.closedPoint K) ∈ (Proj.awayι
          (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)
          (MvPolynomial.X a) (hX a) one_pos).opensRange := by
        rw [Proj.opensRange_awayι]; exact ha
      exact h
    have hfac := IsOpenImmersion.lift_fac _ _ hrange
    obtain ⟨φ₀, hφ₀⟩ : ∃ φ₀, Spec.map φ₀ = IsOpenImmersion.lift _ _ hrange :=
      ⟨_, Spec.map_preimage _⟩
    have hx₀' : x₀ = Spec.map φ₀ ≫ Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)
        (MvPolynomial.X a) (hX a) one_pos := by rw [hφ₀, hfac]
    have hret : ∀ c : K, φ₀.hom (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) (Submonoid.powers (MvPolynomial.X a))
        (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K 0) c)) = c := by
      have h1 : Spec.map (CommRingCat.ofHom
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K 0)) ≫
          CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)
            (Submonoid.powers (MvPolynomial.X a))) ≫ φ₀) =
          Spec.map (𝟙 (CommRingCat.of K)) := by
        rw [Spec.map_id, ← hx₀, hx₀']
        simp only [Spec.map_comp, Category.assoc, wcProjKStr]
        rw [Proj.awayι_toSpecZero_assoc]
      have h2 := Spec.map_injective h1
      intro c
      have h3 := congrArg (fun f => f.hom c) h2
      simpa using h3
    have hdet : ∀ (g : MvPolynomial (Fin (d + 1)) K)
        (hg : g ∈ MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K 1),
        x₀ (IsLocalRing.closedPoint K) ∈
          Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) g →
        φ₀.hom (HomogeneousLocalization.Away.isLocalizationElem (hX a) hg) ≠ 0 := by
      intro g hg hmem h0
      have key : ∀ z : Spec (.of K), x₀ z ∈
          Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) g → False := by
        intro z hz
        rw [hx₀', Scheme.Hom.comp_apply, ← Scheme.Hom.mem_preimage,
          Proj.awayι_preimage_basicOpen _ (hX a) one_pos hg one_pos] at hz
        have hz' := (PrimeSpectrum.mem_basicOpen _ _).mp hz
        apply hz'
        rw [Spec.map_apply]
        exact Ideal.mem_comap.mpr (by rw [h0]; exact zero_mem _)
      exact key _ hmem
    have hshear : ∀ (b : Fin (d + 1)) (c : K)
        (hg : MvPolynomial.X b - MvPolynomial.C c * MvPolynomial.X a ∈
          MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K 1),
        HomogeneousLocalization.Away.isLocalizationElem (hX a) hg =
          HomogeneousLocalization.Away.isLocalizationElem (hX a) (hX b) -
            HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)
              (Submonoid.powers (MvPolynomial.X a))
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K 0) c) := by
      intro b c hg
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.val_sub]
      have hC : (HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)
          (Submonoid.powers (MvPolynomial.X a))
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K 0) c)).val =
          Localization.mk (MvPolynomial.C c) 1 := by
        rw [Localization.mk_one_eq_algebraMap]; rfl
      rw [hC]
      simp only [HomogeneousLocalization.Away.isLocalizationElem,
        HomogeneousLocalization.Away.val_mk]
      rw [Localization.sub_mk, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      refine ⟨1, ?_⟩
      simp only [OneMemClass.coe_one, pow_one, one_mul, mul_one]
      ring
    obtain ⟨σ, hσ⟩ : ∃ σ : Equiv.Perm (Fin (d + 1)), σ = Equiv.swap a (Fin.last d) := ⟨_, rfl⟩
    have hσσ : ∀ i, σ (σ i) = i := fun i => by rw [hσ]; exact Equiv.swap_apply_self _ _ _
    have hσa : σ a = Fin.last d := by rw [hσ]; exact Equiv.swap_apply_left _ _
    have hσl : σ (Fin.last d) = a := by rw [hσ]; exact Equiv.swap_apply_right _ _
    obtain ⟨v, hv⟩ : ∃ v : Fin (d + 1) → K, ∀ b, v b =
        φ₀.hom (HomogeneousLocalization.Away.isLocalizationElem (hX a) (hX b)) :=
      ⟨_, fun _ => rfl⟩
    obtain ⟨w, hwa, hw⟩ : ∃ w : Fin (d + 1) → K, w a = 0 ∧ ∀ b, b ≠ a → w b = v b :=
      ⟨fun b => if b = a then 0 else v b, by simp, fun b hb => by simp [hb]⟩
    refine ⟨fun i => MvPolynomial.X (σ i) - MvPolynomial.C (w (σ i)) * MvPolynomial.X a,
      fun i => MvPolynomial.X (σ i) + MvPolynomial.C (w i) * MvPolynomial.X (Fin.last d),
      fun i => (MvPolynomial.isHomogeneous_X K _).sub (MvPolynomial.isHomogeneous_C_mul_X _ _),
      fun i => (MvPolynomial.isHomogeneous_X K _).add (MvPolynomial.isHomogeneous_C_mul_X _ _),
      ?_, ?_, ?_⟩
    · intro i
      simp only [map_sub, map_add, map_mul, MvPolynomial.aeval_X, MvPolynomial.aeval_C,
        MvPolynomial.algebraMap_eq, hσσ, hσl, hwa, map_zero, zero_mul, sub_zero]
      ring
    · intro i
      simp only [map_sub, map_add, map_mul, MvPolynomial.aeval_X, MvPolynomial.aeval_C,
        MvPolynomial.algebraMap_eq, hσσ, hσa, hwa, map_zero, zero_mul, add_zero]
      ring
    · intro i hi hmem
      have hil : i ≠ Fin.last d := fun h => by rw [h, Fin.val_last] at hi; omega
      have hσi : σ i ≠ a := fun h =>
        hil (by have := congrArg σ h; rw [hσσ, hσa] at this; exact this)
      have hg : MvPolynomial.X (σ i) - MvPolynomial.C (v (σ i)) * MvPolynomial.X a ∈
          MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K 1 :=
        (MvPolynomial.mem_homogeneousSubmodule _ _).mpr
          ((MvPolynomial.isHomogeneous_X K _).sub (MvPolynomial.isHomogeneous_C_mul_X _ _))
      have hmem' : x₀ (IsLocalRing.closedPoint K) ∈ Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)
          (MvPolynomial.X (σ i) - MvPolynomial.C (v (σ i)) * MvPolynomial.X a) := by
        rw [← hw _ hσi]; exact hmem
      apply hdet _ hg hmem'
      rw [hshear (σ i) (v (σ i)) hg, map_sub, hret, hv, sub_self]

  have hauto : ∀ (d : ℕ) (L M : Fin (d + 1) → MvPolynomial (Fin (d + 1)) K),
      (∀ i, (L i).IsHomogeneous 1) → (∀ i, (M i).IsHomogeneous 1) →
      (∀ i, MvPolynomial.aeval L (M i) = MvPolynomial.X i) →
      (∀ i, MvPolynomial.aeval M (L i) = MvPolynomial.X i) →
      ∃ g : wcProjK K d ⟶ wcProjK K d, IsIso g ∧ g ≫ wcProjKStr K d = wcProjKStr K d ∧
        ∀ i : Fin (d + 1), g ⁻¹ᵁ (@Proj.basicOpen _ _ _ _ _
          (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) MvPolynomial.gradedAlgebra
          (MvPolynomial.X i)) = @Proj.basicOpen _ _ _ _ _
          (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) MvPolynomial.gradedAlgebra (L i) := by
    intro d L M hL hM hLM hML
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) :=
      MvPolynomial.gradedAlgebra
    have hcc : ∀ (N : Fin (d + 1) → MvPolynomial (Fin (d + 1)) K), (∀ i, (N i).IsHomogeneous 1) →
        ∀ p : MvPolynomial (Fin (d + 1)) K,
          MvPolynomial.constantCoeff (MvPolynomial.aeval N p) = MvPolynomial.constantCoeff p := by
      intro N hN p
      induction p using MvPolynomial.induction_on with
      | C r => rw [MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
      | add p q hp hq => rw [map_add, map_add, map_add, hp, hq]
      | mul_X p i hp =>
        have h0 : MvPolynomial.constantCoeff (N i) = 0 := by
          rw [MvPolynomial.constantCoeff_eq]
          exact (hN i).coeff_eq_zero (by simp)
        rw [map_mul, map_mul, map_mul, hp, MvPolynomial.aeval_X, MvPolynomial.constantCoeff_X, h0]
    have hirr : ∀ a : MvPolynomial (Fin (d + 1)) K,
        a ∈ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) ↔
          MvPolynomial.constantCoeff a = 0 := by
      intro a
      rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
      change ((MvPolynomial.decomposition.decompose' a 0 : MvPolynomial (Fin (d + 1)) K)) = 0 ↔ _
      rw [MvPolynomial.decomposition.decompose'_apply, MvPolynomial.homogeneousComponent_zero,
        MvPolynomial.C_eq_zero, MvPolynomial.constantCoeff_eq]
    let Φ : ∀ N : Fin (d + 1) → MvPolynomial (Fin (d + 1)) K, (∀ i, (N i).IsHomogeneous 1) →
        (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K →+*ᵍ
          MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) :=
      fun N hN => GradedRingHom.mk (MvPolynomial.aeval N).toRingHom (fun {n} {x} hx => by
        rw [MvPolynomial.mem_homogeneousSubmodule] at hx ⊢
        simpa using hx.aeval N hN)
    have hΦ : ∀ N hN (x : MvPolynomial (Fin (d + 1)) K), Φ N hN x = MvPolynomial.aeval N x :=
      fun _ _ _ => rfl
    have hinv : ∀ N N' : Fin (d + 1) → MvPolynomial (Fin (d + 1)) K,
        (∀ i, MvPolynomial.aeval N (N' i) = MvPolynomial.X i) →
        ∀ x, MvPolynomial.aeval N (MvPolynomial.aeval N' x) = x := by
      intro N N' h x
      have e : (MvPolynomial.aeval N).comp (MvPolynomial.aeval N') =
          AlgHom.id K (MvPolynomial (Fin (d + 1)) K) :=
        MvPolynomial.algHom_ext (fun i => by
          rw [AlgHom.comp_apply, MvPolynomial.aeval_X, h i, AlgHom.id_apply])
      exact AlgHom.congr_fun e x
    have hcond : ∀ (N N' : Fin (d + 1) → MvPolynomial (Fin (d + 1)) K)
        (hN : ∀ i, (N i).IsHomogeneous 1),
        (∀ i, (N' i).IsHomogeneous 1) →
        (∀ i, MvPolynomial.aeval N (N' i) = MvPolynomial.X i) →
        HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) ≤
          HomogeneousIdeal.map (Φ N hN)
            (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)) := by
      intro N N' hN hN' h a ha
      have hb : MvPolynomial.aeval N' a ∈
          HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) :=
        (hirr _).mpr (by rw [hcc N' hN', (hirr a).mp ha])
      rw [← HomogeneousIdeal.mem_iff, HomogeneousIdeal.toIdeal_map]
      have hm := Ideal.mem_map_of_mem (Φ N hN) (HomogeneousIdeal.mem_iff.mpr hb)
      rwa [hΦ N hN, hinv N N' h] at hm
    have hcomp : ∀ (N N' : Fin (d + 1) → MvPolynomial (Fin (d + 1)) K)
        (hN : ∀ i, (N i).IsHomogeneous 1) (hN' : ∀ i, (N' i).IsHomogeneous 1),
        (∀ i, MvPolynomial.aeval N (N' i) = MvPolynomial.X i) →
        (Φ N hN).comp (Φ N' hN') = GradedRingHom.id _ := by
      intro N N' hN hN' h
      apply GradedRingHom.ext
      intro x
      rw [GradedRingHom.comp_apply, GradedRingHom.id_apply, hΦ N' hN', hΦ N hN, hinv N N' h]
    have key : ∀ (f : MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K →+*ᵍ
          MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) hf,
        f = GradedRingHom.id _ → Proj.map f hf = 𝟙 _ := by
      rintro f hf rfl
      exact Proj.map_id
    have hL' := hcond L M hL hM hLM
    have hM' := hcond M L hM hL hML
    have hdeg0 : ∀ p : MvPolynomial (Fin (d + 1)) K, p.IsHomogeneous 0 →
        p = MvPolynomial.C (p.coeff 0) := by
      intro p hp
      by_cases hp0 : p = 0
      · rw [hp0]; simp
      · exact MvPolynomial.totalDegree_eq_zero_iff_eq_C.mp (hp.totalDegree hp0)
    have hover : Proj.map (Φ L hL) hL' ≫
        Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) =
        Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) ≫
          Spec.map (CommRingCat.ofHom
            (RingHom.id ↥(MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K 0))) := by
      apply hbc (Φ L hL) hL' (RingHom.id _)
      intro a
      have ha : (a : MvPolynomial (Fin (d + 1)) K).IsHomogeneous 0 :=
        (MvPolynomial.mem_homogeneousSubmodule 0 _).mp a.2
      rw [RingHom.id_apply, hΦ L hL, hdeg0 _ ha, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
    refine ⟨Proj.map (Φ L hL) hL', ⟨Proj.map (Φ M hM) hM', ?_, ?_⟩, ?_, ?_⟩
    · rw [← Proj.map_comp]
      exact key _ _ (hcomp L M hL hM hLM)
    · rw [← Proj.map_comp]
      exact key _ _ (hcomp M L hM hL hML)
    · dsimp only [wcProjKStr]
      rw [← Category.assoc, hover, CommRingCat.ofHom_id, Spec.map_id, Category.comp_id]
    · intro i
      rw [Proj.map_preimage_basicOpen, hΦ L hL, MvPolynomial.aeval_X]

  have huniq : ∀ (d : ℕ) (x x' : ↥(wcProjK K d)),
      (∀ j : Fin d, (MvPolynomial.X (Fin.castSucc j) : MvPolynomial (Fin (d + 1)) K) ∈
        x.asHomogeneousIdeal.toIdeal) →
      (∀ j : Fin d, (MvPolynomial.X (Fin.castSucc j) : MvPolynomial (Fin (d + 1)) K) ∈
        x'.asHomogeneousIdeal.toIdeal) → x = x' := by
    intro d x x' hx hx'
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) :=
      MvPolynomial.gradedAlgebra
    have hd : ∀ e : Fin (d + 1) →₀ ℕ, (∀ j : Fin d, e (Fin.castSucc j) = 0) →
        e = Finsupp.single (Fin.last d) (e (Fin.last d)) := by
      intro e hdj
      ext i
      rcases Fin.eq_castSucc_or_eq_last i with ⟨j, rfl⟩ | rfl
      · simp [Finsupp.single_apply, hdj j, (Fin.castSucc_ne_last j).symm]
      · simp
    have hsingle : ∀ (j : Fin d) (k : ℕ),
        Finsupp.single (Fin.last d) k (Fin.castSucc j) = 0 := by
      intro j k
      simp [Finsupp.single_apply, (Fin.castSucc_ne_last j).symm]
    obtain ⟨I, hIdef⟩ : ∃ I : Ideal (MvPolynomial (Fin (d + 1)) K), I = Ideal.span
        (Set.range fun j : Fin d =>
          (MvPolynomial.X (Fin.castSucc j) : MvPolynomial (Fin (d + 1)) K)) := ⟨_, rfl⟩
    have hI_eq : I = Ideal.span (MvPolynomial.X '' Set.range
        (Fin.castSucc : Fin d → Fin (d + 1))) := by
      rw [hIdef, ← Set.range_comp]
      rfl
    have s1 : ∀ f : MvPolynomial (Fin (d + 1)) K,
        f ∈ I ↔ ∀ k : ℕ, f.coeff (Finsupp.single (Fin.last d) k) = 0 := by
      intro f
      rw [hI_eq, MvPolynomial.mem_ideal_span_X_image]
      constructor
      · intro h k
        by_contra hc
        obtain ⟨i, ⟨j, rfl⟩, hi⟩ := h _ (MvPolynomial.mem_support_iff.mpr hc)
        exact hi (hsingle j k)
      · intro h m hm
        by_contra hc
        push_neg at hc
        have hm' := hd m (fun j => hc _ ⟨j, rfl⟩)
        apply MvPolynomial.mem_support_iff.mp hm
        rw [hm']
        exact h _
    have hirr : ∀ a : MvPolynomial (Fin (d + 1)) K,
        a ∈ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) ↔
          a.coeff 0 = 0 := by
      intro a
      have e : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) 0 a =
          MvPolynomial.homogeneousComponent 0 a := by
        rw [← MvPolynomial.decomposition.decompose'_apply]
        rfl
      rw [HomogeneousIdeal.mem_irrelevant_iff, e, MvPolynomial.homogeneousComponent_zero,
        MvPolynomial.C_eq_zero]
    have hkey : ∀ z : ↥(wcProjK K d),
        (∀ j : Fin d, (MvPolynomial.X (Fin.castSucc j) : MvPolynomial (Fin (d + 1)) K) ∈
          z.asHomogeneousIdeal.toIdeal) → z.asHomogeneousIdeal.toIdeal = I := by
      intro z hz
      have hIx : I ≤ z.asHomogeneousIdeal.toIdeal := by
        rw [hIdef, Ideal.span_le]
        rintro _ ⟨j, rfl⟩
        exact hz j
      have hXL : (MvPolynomial.X (Fin.last d) : MvPolynomial (Fin (d + 1)) K) ∉
          z.asHomogeneousIdeal.toIdeal := by
        intro hL
        apply z.not_irrelevant_le
        intro a ha
        rw [hirr] at ha
        have hspan : a ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (d + 1)))) := by
          rw [MvPolynomial.mem_ideal_span_X_image]
          intro m hm
          have hm0 : m ≠ 0 := by
            rintro rfl
            exact (MvPolynomial.mem_support_iff.mp hm) ha
          obtain ⟨l, hl⟩ := Finsupp.ne_iff.mp hm0
          exact ⟨l, Set.mem_univ _, hl⟩
        have hle : Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (d + 1)))) ≤
            z.asHomogeneousIdeal.toIdeal := by
          rw [Ideal.span_le]
          rintro _ ⟨i, -, rfl⟩
          rcases Fin.eq_castSucc_or_eq_last i with ⟨j, rfl⟩ | rfl
          · exact hz j
          · exact hL
        exact hle hspan
      have hhom : ∀ f ∈ z.asHomogeneousIdeal.toIdeal, ∀ n : ℕ,
          MvPolynomial.homogeneousComponent n f ∈ z.asHomogeneousIdeal.toIdeal := by
        intro f hf n
        have h1 := (z.asHomogeneousIdeal.isHomogeneous.mem_iff).mp hf n
        rw [← MvPolynomial.decomposition.decompose'_apply]
        exact h1
      have hle : z.asHomogeneousIdeal.toIdeal ≤ I := by
        intro f hf
        rw [s1]
        intro k
        by_contra hc
        obtain ⟨c, hcdef⟩ : ∃ c : K, c = f.coeff (Finsupp.single (Fin.last d) k) := ⟨_, rfl⟩
        rw [← hcdef] at hc
        have hh := hhom f hf k
        have hg : MvPolynomial.homogeneousComponent k f -
            MvPolynomial.C c * MvPolynomial.X (Fin.last d) ^ k ∈ I := by
          rw [s1]
          intro k'
          rw [MvPolynomial.coeff_sub, MvPolynomial.coeff_C_mul, MvPolynomial.coeff_X_pow,
            MvPolynomial.coeff_homogeneousComponent, Finsupp.degree_single]
          by_cases hk : k' = k
          · rw [hk, if_pos rfl, if_pos rfl, hcdef, mul_one, sub_self]
          · rw [if_neg hk, if_neg (fun h' => hk (Finsupp.single_injective _ h').symm), mul_zero,
              sub_zero]
        have hc' : MvPolynomial.C c * MvPolynomial.X (Fin.last d) ^ k ∈
            z.asHomogeneousIdeal.toIdeal := by
          have h2 := Ideal.sub_mem _ hh (hIx hg)
          rwa [sub_sub_cancel] at h2
        have hpow : (MvPolynomial.X (Fin.last d) : MvPolynomial (Fin (d + 1)) K) ^ k ∈
            z.asHomogeneousIdeal.toIdeal := by
          have h2 := Ideal.mul_mem_left _ (MvPolynomial.C c⁻¹) hc'
          rwa [← mul_assoc, ← MvPolynomial.C_mul, inv_mul_cancel₀ hc, MvPolynomial.C_1,
            one_mul] at h2
        exact hXL (z.isPrime.mem_of_pow_mem k hpow)
      exact le_antisymm hle hIx
    apply ProjectiveSpectrum.ext
    apply HomogeneousIdeal.toIdeal_injective
    rw [hkey x hx, hkey x' hx']

  have hnorm : ∀ y : Spec (.of K) ⟶ wcProjK K m, y ≫ wcProjKStr K m = 𝟙 _ →
      ∃ g : wcProjK K m ⟶ wcProjK K m, IsIso g ∧ g ≫ wcProjKStr K m = wcProjKStr K m ∧
        ∀ j : Fin m, (MvPolynomial.X (Fin.castSucc j) : MvPolynomial (Fin (m + 1)) K) ∈
          (g (y (IsLocalRing.closedPoint K))).asHomogeneousIdeal.toIdeal := by
    intro y hy
    obtain ⟨L, M, hL, hM, hLM, hML, hout⟩ := hlin m y hy
    obtain ⟨g, hgi, hgs, hpre⟩ := hauto m L M hL hM hLM hML
    refine ⟨g, hgi, hgs, fun j => ?_⟩
    have h1 := hout (Fin.castSucc j) (by rw [Fin.val_castSucc]; exact j.isLt)
    by_contra hc
    apply h1
    rw [← hpre (Fin.castSucc j), Scheme.Hom.mem_preimage, Proj.mem_basicOpen]
    exact hc

  obtain ⟨g₀, hg₀i, hg₀s, hg₀p⟩ := hnorm y₀ hy₀
  obtain ⟨g₁, hg₁i, hg₁s, hg₁p⟩ := hnorm y₁ hy₁
  have E : y₀ ≫ g₀ = y₁ ≫ g₁ := by
    apply hsec (wcProjKStr K m)
    · rw [Category.assoc, hg₀s, hy₀]
    · rw [Category.assoc, hg₁s, hy₁]
    · exact (Scheme.Hom.comp_apply _ _ _).trans
        ((huniq m _ _ hg₀p hg₁p).trans (Scheme.Hom.comp_apply _ _ _).symm)
  haveI := hg₁i
  have hinvs : inv g₁ ≫ wcProjKStr K m = wcProjKStr K m :=
    calc inv g₁ ≫ wcProjKStr K m = inv g₁ ≫ (g₁ ≫ wcProjKStr K m) := by rw [hg₁s]
      _ = wcProjKStr K m := IsIso.inv_hom_id_assoc _ _
  refine ⟨g₀ ≫ inv g₁, inferInstance, ?_, ?_⟩
  · rw [Category.assoc, hinvs, hg₀s]
  · rw [← Category.assoc, E, Category.assoc, IsIso.hom_inv_id, Category.comp_id]

theorem wcpa_dj_gs_bf_pullback_integral : ∀ (K : Type u) [Field K] (Y P B : Scheme.{u}) [AlgebraicGeometry.IsIntegral Y] (π : Y ⟶ B) (σB : P ⟶ B) (sP : P ⟶ Spec (.of K)) [Smooth sP] (Z : Set B) (W : Y.Opens), IsClosed Z → (∀ y : Y, π y ∈ Z → y ∈ W) → Etale (W.ι ≫ π) → (∀ O : B.Opens, (O : Set B) = Zᶜ → IsIso (σB ∣_ O)) → (∃ y : Y, π y ∉ Z) → Dense (σB ⁻¹' Zᶜ) → AlgebraicGeometry.IsIntegral (Limits.pullback π σB) :=
by
  intro K _ Y P B _ π σB sP _ Z W hZ hW hWet hiso hne hdense
  classical

  have hisoover : ∀ {Y P B : Scheme.{u}} (π : Y ⟶ B) (σB : P ⟶ B) (O : B.Opens),
      IsIso (σB ∣_ O) → IsIso ((Limits.pullback.fst π σB) ∣_ (π ⁻¹ᵁ O)) := by
    intro Y P B π σB O h
    have A := isPullback_morphismRestrict (Limits.pullback.fst π σB) (π ⁻¹ᵁ O)
    have C := IsPullback.of_hasPullback π σB
    have D := isPullback_morphismRestrict σB O
    have hc : ((Limits.pullback.fst π σB) ∣_ (π ⁻¹ᵁ O) ≫ π ∣_ O) ≫ O.ι =
        ((Limits.pullback.fst π σB ⁻¹ᵁ (π ⁻¹ᵁ O)).ι ≫ Limits.pullback.snd π σB) ≫ σB := by
      rw [Category.assoc, morphismRestrict_ι, ← Category.assoc, morphismRestrict_ι, Category.assoc,
        Category.assoc, Limits.pullback.condition]
    have big : IsPullback (D.lift _ _ hc ≫ (σB ⁻¹ᵁ O).ι) ((Limits.pullback.fst π σB) ∣_ (π ⁻¹ᵁ O))
        σB (π ∣_ O ≫ O.ι) := by
      rw [D.lift_snd, morphismRestrict_ι]
      exact (A.paste_vert C).flip
    have sq := IsPullback.of_right big (D.lift_fst _ _ hc) D.flip
    exact MorphismProperty.of_isPullback (P := MorphismProperty.isomorphisms Scheme) sq h

  have hetres : ∀ {Y P B : Scheme.{u}} (π : Y ⟶ B) (σB : P ⟶ B) (W : Y.Opens), Etale (W.ι ≫ π) →
      Etale ((Limits.pullback.fst π σB ⁻¹ᵁ W).ι ≫ Limits.pullback.snd π σB) := by
    intro Y P B π σB W h
    have h1 := isPullback_morphismRestrict (Limits.pullback.fst π σB) W
    have h2 := IsPullback.of_hasPullback π σB
    exact MorphismProperty.of_isPullback (P := @Etale) (h1.paste_vert h2) h

  have hPB : ∀ x : ↥(Limits.pullback π σB),
      π (Limits.pullback.fst π σB x) = σB (Limits.pullback.snd π σB x) := by
    intro x
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
  let O : B.Opens := ⟨Zᶜ, hZ.isOpen_compl⟩
  haveI hisoV : IsIso ((Limits.pullback.fst π σB) ∣_ (π ⁻¹ᵁ O)) := hisoover π σB O (hiso O rfl)
  obtain ⟨y, hy⟩ := hne
  have hyV : y ∈ π ⁻¹ᵁ O := hy
  haveI : Nonempty (π ⁻¹ᵁ O).toScheme := ⟨⟨y, hyV⟩⟩
  haveI : AlgebraicGeometry.IsIntegral (π ⁻¹ᵁ O).toScheme := inferInstance
  haveI : Nonempty (Limits.pullback.fst π σB ⁻¹ᵁ (π ⁻¹ᵁ O)).toScheme :=
    ⟨(inv ((Limits.pullback.fst π σB) ∣_ (π ⁻¹ᵁ O))) ⟨y, hyV⟩⟩
  haveI hTVint : AlgebraicGeometry.IsIntegral (Limits.pullback.fst π σB ⁻¹ᵁ (π ⁻¹ᵁ O)).toScheme :=
    isIntegral_of_isOpenImmersion ((Limits.pullback.fst π σB) ∣_ (π ⁻¹ᵁ O))
  haveI hU1et : Etale ((Limits.pullback.fst π σB ⁻¹ᵁ W).ι ≫ Limits.pullback.snd π σB) :=
    hetres π σB W hWet
  haveI : Smooth (((Limits.pullback.fst π σB ⁻¹ᵁ W).ι ≫ Limits.pullback.snd π σB) ≫ sP) :=
    inferInstance
  haveI hU1red : AlgebraicGeometry.IsReduced (Limits.pullback.fst π σB ⁻¹ᵁ W).toScheme := by
    haveI : ∀ x : (Limits.pullback.fst π σB ⁻¹ᵁ W).toScheme,
        _root_.IsReduced ((Limits.pullback.fst π σB ⁻¹ᵁ W).toScheme.presheaf.stalk x) := fun x => by
      haveI := (wc_fntame_smooth_stalk_normal K (Limits.pullback.fst π σB ⁻¹ᵁ W).toScheme
        (((Limits.pullback.fst π σB ⁻¹ᵁ W).ι ≫ Limits.pullback.snd π σB) ≫ sP) x).1
      infer_instance
    exact isReduced_of_isReduced_stalk _
  haveI hTVred : AlgebraicGeometry.IsReduced (Limits.pullback.fst π σB ⁻¹ᵁ (π ⁻¹ᵁ O)).toScheme :=
    inferInstance

  have hcover : ∀ x : ↥(Limits.pullback π σB),
      x ∈ Limits.pullback.fst π σB ⁻¹ᵁ (π ⁻¹ᵁ O) ∨ x ∈ Limits.pullback.fst π σB ⁻¹ᵁ W := by
    intro x
    by_cases h : π (Limits.pullback.fst π σB x) ∈ Z
    · right
      exact hW _ h
    · left
      exact h

  haveI : ∀ x : ↥(Limits.pullback π σB),
      _root_.IsReduced ((Limits.pullback π σB).presheaf.stalk x) := by
    intro x
    rcases hcover x with h | h
    · have hr := isReduced_stalk_of_isReduced
        (Limits.pullback.fst π σB ⁻¹ᵁ (π ⁻¹ᵁ O)).toScheme ⟨x, h⟩
      exact @isReduced_of_injective _ _ _ _ _ _ _
        (Scheme.Opens.stalkIso (Limits.pullback.fst π σB ⁻¹ᵁ (π ⁻¹ᵁ O)) ⟨x, h⟩).symm.commRingCatIsoToRingEquiv
        (RingEquiv.injective _) hr
    · have hr := isReduced_stalk_of_isReduced (Limits.pullback.fst π σB ⁻¹ᵁ W).toScheme ⟨x, h⟩
      exact @isReduced_of_injective _ _ _ _ _ _ _
        (Scheme.Opens.stalkIso (Limits.pullback.fst π σB ⁻¹ᵁ W) ⟨x, h⟩).symm.commRingCatIsoToRingEquiv
        (RingEquiv.injective _) hr
  haveI : AlgebraicGeometry.IsReduced (Limits.pullback π σB) := isReduced_of_isReduced_stalk _

  have hTVirr : IsIrreducible
      ((Limits.pullback.fst π σB ⁻¹ᵁ (π ⁻¹ᵁ O) : (Limits.pullback π σB).Opens) :
        Set ↥(Limits.pullback π σB)) := by
    have e : ((Limits.pullback.fst π σB ⁻¹ᵁ (π ⁻¹ᵁ O) : (Limits.pullback π σB).Opens) :
        Set ↥(Limits.pullback π σB)) =
        ⇑(Limits.pullback.fst π σB ⁻¹ᵁ (π ⁻¹ᵁ O)).ι '' Set.univ := by
      rw [Set.image_univ, Scheme.Opens.range_ι]
    rw [e]
    exact (IrreducibleSpace.isIrreducible_univ _).image _
      (Limits.pullback.fst π σB ⁻¹ᵁ (π ⁻¹ᵁ O)).ι.continuous.continuousOn
  have hdenseTV : ∀ x : ↥(Limits.pullback π σB), x ∈ closure
      ((Limits.pullback.fst π σB ⁻¹ᵁ (π ⁻¹ᵁ O) : (Limits.pullback π σB).Opens) :
        Set ↥(Limits.pullback π σB)) := by
    intro x
    rcases hcover x with h | h
    · exact subset_closure h
    · rw [mem_closure_iff]
      intro o ho hxo
      have hgopen : IsOpenMap
          ⇑((Limits.pullback.fst π σB ⁻¹ᵁ W).ι ≫ Limits.pullback.snd π σB) :=
        ((Limits.pullback.fst π σB ⁻¹ᵁ W).ι ≫ Limits.pullback.snd π σB).isOpenMap
      have hNo : IsOpen (⇑(Limits.pullback.fst π σB ⁻¹ᵁ W).ι ⁻¹' o) :=
        ho.preimage (Limits.pullback.fst π σB ⁻¹ᵁ W).ι.continuous
      have hxN : (⟨x, h⟩ : (Limits.pullback.fst π σB ⁻¹ᵁ W).toScheme) ∈
          ⇑(Limits.pullback.fst π σB ⁻¹ᵁ W).ι ⁻¹' o := by
        show (Limits.pullback.fst π σB ⁻¹ᵁ W).ι ⟨x, h⟩ ∈ o
        rw [Scheme.Opens.ι_apply]
        exact hxo
      obtain ⟨p, ⟨w, hwN, rfl⟩, hpD⟩ := hdense.inter_open_nonempty _ (hgopen _ hNo)
        ⟨_, ⟨x, h⟩, hxN, rfl⟩
      refine ⟨(Limits.pullback.fst π σB ⁻¹ᵁ W).ι w, hwN, ?_⟩
      show π (Limits.pullback.fst π σB ((Limits.pullback.fst π σB ⁻¹ᵁ W).ι w)) ∉ Z
      rw [hPB]
      have hg : ((Limits.pullback.fst π σB ⁻¹ᵁ W).ι ≫ Limits.pullback.snd π σB) w =
          Limits.pullback.snd π σB ((Limits.pullback.fst π σB ⁻¹ᵁ W).ι w) :=
        Scheme.Hom.comp_apply _ _ _
      rw [← hg]
      exact hpD
  have hcl : closure
      ((Limits.pullback.fst π σB ⁻¹ᵁ (π ⁻¹ᵁ O) : (Limits.pullback π σB).Opens) :
        Set ↥(Limits.pullback π σB)) = Set.univ := Set.eq_univ_of_forall hdenseTV
  have hirr := hTVirr.closure
  rw [hcl] at hirr
  haveI : IrreducibleSpace ↥(Limits.pullback π σB) := by
    rw [irreducibleSpace_def]
    exact hirr
  exact isIntegral_of_irreducibleSpace_of_isReduced _

theorem wcpa_dj_gs_blowup_fibration : ∀ (k' : Type u) [Field k'] (Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral Y] (t : Y ⟶ Spec (.of k')) (d : ℕ) (π : Y ⟶ wcProjK k' (d + 1)) (y₀ : Spec (.of k') ⟶ wcProjK k' (d + 1)) (e : Spec (.of k') ⟶ Y) (W : Y.Opens), wcpaDjIsProjOver k' t → topologicalKrullDim Y = ((d + 1 : ℕ) : WithBot ℕ∞) → IsFinite π → π ≫ wcProjKStr k' (d + 1) = t → y₀ ≫ wcProjKStr k' (d + 1) = 𝟙 _ → e ≫ π = y₀ → (∀ y : Y, π y = y₀ (IsLocalRing.closedPoint k') → y ∈ W) → Etale (W.ι ≫ π) → ∃ (Y₁ : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral Y₁) (a₁ : Y₁ ⟶ Y) (g : Y₁ ⟶ wcProjK k' d) (σ : wcProjK k' d ⟶ Y₁), IsProper a₁ ∧ Surjective a₁ ∧ (∃ V : Y.Opens, V ≠ ⊥ ∧ IsFinite (a₁ ∣_ V)) ∧ g ≫ wcProjKStr k' d = a₁ ≫ t ∧ wcpaDjIsProjOver k' (a₁ ≫ t) ∧ σ ≫ g = 𝟙 _ ∧ (∀ p : ↥(wcProjK k' d), ∃ V : Y₁.Opens, σ p ∈ V ∧ SmoothOfRelativeDimension 1 (V.ι ≫ g)) ∧ (∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ wcProjK k' d), topologicalKrullDim ↥(Limits.pullback g s) ≤ ((1 : ℕ) : WithBot ℕ∞)) ∧ (∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ wcProjK k' d), ∀ Z ∈ irreducibleComponents ↥(Limits.pullback g s), ¬ topologicalKrullDim ↥Z ≤ ((0 : ℕ) : WithBot ℕ∞) → ∃ w ∈ Z, ∃ V : Y₁.Opens, Limits.pullback.fst g s w ∈ V ∧ SmoothOfRelativeDimension 1 (V.ι ≫ g)) :=
by
  intro k' _ Y _ t d π y₀ e W hPt hYd hπfin hπt hy₀ heπ hW hWet
  classical

  have hsub : ∀ (X : Type u) [TopologicalSpace X] [Subsingleton X],
      topologicalKrullDim X ≤ ((0 : ℕ) : WithBot ℕ∞) := by
    intro X _ _
    haveI : Subsingleton (TopologicalSpace.IrreducibleCloseds X) := ⟨fun a b => by
      ext x
      constructor
      · intro hx
        obtain ⟨y, hy⟩ := b.isIrreducible.nonempty
        rwa [Subsingleton.elim x y]
      · intro hx
        obtain ⟨y, hy⟩ := a.isIrreducible.nonempty
        rwa [Subsingleton.elim x y]⟩
    exact Order.krullDim_nonpos_of_subsingleton
  have hnn : ∀ (X : Type u) [TopologicalSpace X] [Nonempty X],
      ((0 : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim X := by
    intro X _ hX
    obtain ⟨x⟩ := hX
    haveI : Nonempty (TopologicalSpace.IrreducibleCloseds X) :=
      ⟨⟨closure {x}, isIrreducible_singleton.closure, isClosed_closure⟩⟩
    exact Order.krullDim_nonneg
  have huniv : ∀ (X : Type u) [TopologicalSpace X],
      topologicalKrullDim ↥(Set.univ : Set X) = topologicalKrullDim X := fun X _ =>
    (Homeomorph.Set.univ X).isHomeomorph.topologicalKrullDim_eq

  have hit : ∀ {F Ps : Scheme.{u}} (φ : F ⟶ Ps) [IsFinite φ] [IrreducibleSpace Ps],
      topologicalKrullDim ↥Ps ≤ ((1 : ℕ) : WithBot ℕ∞) →
      topologicalKrullDim ↥F ≤ ((1 : ℕ) : WithBot ℕ∞) ∧
      ∀ Z ∈ irreducibleComponents ↥F, ¬ topologicalKrullDim ↥Z ≤ ((0 : ℕ) : WithBot ℕ∞) →
