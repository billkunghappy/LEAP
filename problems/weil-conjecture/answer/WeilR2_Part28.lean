  have s5 : ∀ (X X₁ X₂ : Scheme.{u}) (I : X.IdealSheafData) (r₁ : X₁ ⟶ X) (r₂ : X₂ ⟶ X), wcCsdIsBlowup I r₁ → wcCsdIsBlowup I r₂ → ∃ e : X₁ ⟶ X₂, IsIso e ∧ e ≫ r₂ = r₁ := by
