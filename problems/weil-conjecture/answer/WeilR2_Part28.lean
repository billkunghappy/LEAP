  have s11 : ∀ {X Y Z S : Scheme.{u}} (f : X ⟶ S) (g : Y ⟶ S) (h : Z ⟶ S) (j : X ⟶ Y) (hjg : f ≫ 𝟙 S = j ≫ g) (hh : h ≫ 𝟙 S = 𝟙 Z ≫ h), IsClosedImmersion j → IsClosedImmersion (Limits.pullback.map f h g h j (𝟙 Z) (𝟙 S) hjg hh) := by
