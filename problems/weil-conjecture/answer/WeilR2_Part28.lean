    (fun U hU s => by rw [hΦfrob.2 U hU s, hNat, hre, pow_mul]) R r hrci
    (Set.range_eq_univ.mpr r.surjective) inferInstance Xt b _
    (Scheme.IdealSheafData.vanishingIdeal C).subschemeι hbfin inferInstance hiso
    (fun x => ⟨inferInstance, hbnorm x⟩) hZgen hdense

  haveI hfp : IsProper (b ≫ r ≫ Limits.pullback.snd g Φ) := inferInstance
  obtain ⟨T, hTcl, hηT, hTsm⟩ := wcfd_smooth_spread Q Xt (b ≫ r ≫ Limits.pullback.snd g Φ) hFS
  let W : Q.Opens := ⟨Tᶜ, hTcl.isOpen_compl⟩
  have hWsm : Smooth ((b ≫ r ≫ Limits.pullback.snd g Φ) ∣_ W) := hTsm W (fun _ h => h)

  haveI : Surjective Φ := ⟨fun x => ⟨x, hΦfrob.1 x⟩⟩
  haveI : IsFinite (b ≫ r ≫ Limits.pullback.fst g Φ) := inferInstance
  haveI : Surjective (b ≫ r ≫ Limits.pullback.fst g Φ) := inferInstance
  have heqρ : (b ≫ r ≫ Limits.pullback.fst g Φ) ≫ g ≫ sQ =
