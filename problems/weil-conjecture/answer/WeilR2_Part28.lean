      rw [← hAmap V.ι (U J) _ (W ⟨(J, k)⟩) (hOW J k).ge inf_le_left (hWU ⟨(J, k)⟩) F, hF, map_zero]
    have hE : V.ι ''ᵁ (W ⟨(J, k)⟩) = X.basicOpen (g J k) := by
      show V.ι ''ᵁ (V.ι ⁻¹ᵁ X.basicOpen (g J k)) = _
      rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
      exact inf_eq_right.mpr (le_iSup DD ⟨(J, k)⟩)
    have hk : V.ι ''ᵁ (W ⟨(J, k)⟩) ≤ U J := hE.le.trans (X.basicOpen_le _)
    rw [Scheme.Opens.ι_appLE] at h1
    calc X.presheaf.map (homOfLE (X.basicOpen_le (g J k))).op F
        = X.presheaf.map (homOfLE hE.ge).op (X.presheaf.map (homOfLE hk).op F) :=
          (hres X (U J) _ _ hk hE.ge _ F).symm
      _ = X.presheaf.map (homOfLE hE.ge).op 0 := congrArg (X.presheaf.map (homOfLE hE.ge).op) h1
      _ = 0 := map_zero _

theorem wcpa_dj_ms_bfp_rbm_product_chart_closure : ∀ (R : Type u) [CommRing R] (X : Scheme.{u}) (fX : X ⟶ Spec (.of R)) (m : ℕ) (U : X.Opens) (k : Fin (m + 1)), IsAffineOpen U → ∀ y : Γ(Limits.pullback fX (wcFprS R m), Limits.pullback.fst fX (wcFprS R m) ⁻¹ᵁ U ⊓ Limits.pullback.snd fX (wcFprS R m) ⁻¹ᵁ wcFprD R m k), y ∈ Subring.closure (Set.range ((Limits.pullback.fst fX (wcFprS R m)).appLE U (Limits.pullback.fst fX (wcFprS R m) ⁻¹ᵁ U ⊓ Limits.pullback.snd fX (wcFprS R m) ⁻¹ᵁ wcFprD R m k) inf_le_left).hom ∪ Set.range (fun l => (Limits.pullback.snd fX (wcFprS R m)).appLE (wcFprD R m k) (Limits.pullback.fst fX (wcFprS R m) ⁻¹ᵁ U ⊓ Limits.pullback.snd fX (wcFprS R m) ⁻¹ᵁ wcFprD R m k) inf_le_right (wcFprE R m k l))) :=
by
  intro R _ X fX m U k hU y

  have S1 : ∀ (n : ℕ) (J : Fin (n + 1)) (x : Γ(wcFprP R n, wcFprD R n J)),
    x ∈ Subring.closure (Set.range (wcFprE R n J) ∪ Set.range (fun c : Γ(Spec (.of R), ⊤) =>
      (wcFprP R n).presheaf.map (homOfLE (le_top : wcFprD R n J ≤ ⊤)).op ((wcFprS R n).appTop c))) := by
      intro n J x
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R) := MvPolynomial.gradedAlgebra
      have hX : ∀ k : Fin (n + 1), (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) R) ∈
          MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R 1 := fun k =>
        (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)
      have GEN : ∀ (k : Fin (n + 1)) (d : ℕ) (F : MvPolynomial (Fin (n + 1)) R)
          (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R (d • 1)),
          MvPolynomial.eval₂ ((HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R) (Submonoid.powers (MvPolynomial.X k))).comp
              (algebraMap R ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R 0)))
            (fun l => HomogeneousLocalization.Away.mk
              (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R) (hX k) 1
              (MvPolynomial.X l) (hX l)) F =
          HomogeneousLocalization.Away.mk
            (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R) (hX k) d F hF := by
        intro k d F hF
        have hFh : F.IsHomogeneous d := by
          have := (MvPolynomial.mem_homogeneousSubmodule (d • 1) F).mp hF
          simpa using this
        have scale : ∀ {L : Type u} [CommRing L] (χ : R →+* L) (g : Fin (n + 1) → L) (t : L),
            MvPolynomial.eval₂ χ (fun l => g l * t) F = t ^ d * MvPolynomial.eval₂ χ g F := by
          intro L _ χ g t
          rw [MvPolynomial.eval₂_eq, MvPolynomial.eval₂_eq, Finset.mul_sum]
          refine Finset.sum_congr rfl (fun e he => ?_)
          have hdeg : ∑ i ∈ e.support, e i = d := by
            by_contra hne
            exact (MvPolynomial.mem_support_iff.mp he) (hFh.coeff_eq_zero hne)
