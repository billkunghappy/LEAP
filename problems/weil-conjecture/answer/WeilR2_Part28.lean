    apply hW'
    rw [← Scheme.Hom.comp_apply (Limits.pullback.fst π' σB) π', Limits.pullback.condition,
      Scheme.Hom.comp_apply,
      ← Scheme.Hom.comp_apply (Limits.pullback.fst (Limits.pullback.snd π' σB ≫ ρ) s)
