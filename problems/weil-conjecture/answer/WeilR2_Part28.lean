      {y (IsLocalRing.closedPoint k')} W hycl (fun z hz => hW' z hz) hWet' hσiso ⟨z₀, hz₀⟩ hdense

  have hsmW : ∀ w : ↥(Limits.pullback π' σB), Limits.pullback.fst π' σB w ∈ W →
