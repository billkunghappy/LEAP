    rw [← CategoryTheory.comp_apply, Scheme.Hom.map_appLE]

  have isUnit_of_bo : ∀ (Y : Scheme.{u}) (O : Y.Opens) (x : Γ(Y, O)), Y.basicOpen x = O → IsUnit x := by
    intro Y O x hx
    have hu : IsUnit (Y.presheaf.map (homOfLE (Y.basicOpen_le x)).op x) :=
      RingedSpace.isUnit_res_basicOpen _ _
    rw [← hid Y O le_rfl x, ← hres Y O _ O (Y.basicOpen_le x) hx.ge le_rfl]
    exact hu.map _

  have hov : ∀ (Y : Scheme.{u}) (A B : Y.Opens) (a : Γ(Y, A)) (b : Γ(Y, B)) (v0 : Γ(Y, A ⊓ B)), IsUnit v0 →
      Y.presheaf.map (homOfLE (inf_le_right : A ⊓ B ≤ B)).op b =
        v0 * Y.presheaf.map (homOfLE (inf_le_left : A ⊓ B ≤ A)).op a →
      A ⊓ Y.basicOpen b = B ⊓ Y.basicOpen a := by
    intro Y A B a b v0 hv0 h
    have h2 := congrArg Y.basicOpen h
    rw [Scheme.basicOpen_res, Scheme.basicOpen_mul, Scheme.basicOpen_of_isUnit _ hv0,
      Scheme.basicOpen_res] at h2
    have hb := Y.basicOpen_le b
    have ha := Y.basicOpen_le a
    calc A ⊓ Y.basicOpen b = A ⊓ B ⊓ Y.basicOpen b := by rw [inf_assoc, inf_eq_right.mpr hb]
      _ = A ⊓ B ⊓ (A ⊓ B ⊓ Y.basicOpen a) := h2
      _ = A ⊓ B ⊓ Y.basicOpen a := by rw [← inf_assoc, inf_idem]
      _ = B ⊓ Y.basicOpen a := by rw [inf_comm A B, inf_assoc, inf_eq_right.mpr ha]

  have haff : ∀ J : Fin (m + 1), IsAffineOpen (wcFprD R m J) := by
    intro J
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) R) := MvPolynomial.gradedAlgebra
    exact Proj.isAffineOpen_basicOpen _ (MvPolynomial.X J)
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ J)) Nat.one_pos
  have hcovD0 : (⨆ a : Fin (m + 1), @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) R) MvPolynomial.gradedAlgebra (MvPolynomial.X a)) = ⊤ := by
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) R) :=
      MvPolynomial.gradedAlgebra
    refine Proj.iSup_basicOpen_eq_top _ _ ?_
    intro p hp
    have h0 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) R) 0 p = 0 :=
      (HomogeneousIdeal.mem_irrelevant_iff (𝒜 := MvPolynomial.homogeneousSubmodule (Fin (m + 1)) R)
        p).mp hp
    have h1 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) R) 0 p =
        MvPolynomial.homogeneousComponent 0 p :=
      (GradedRing.proj_apply _ 0 p).trans (MvPolynomial.decomposition.decompose'_apply p 0)
    rw [h1, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
    rw [← Set.image_univ]
    rw [MvPolynomial.mem_ideal_span_X_image]
    intro e he
    rw [MvPolynomial.mem_support_iff] at he
    have hne : e ≠ 0 := by
      rintro rfl
      exact he h0
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hne
    exact ⟨i, Set.mem_univ i, by simpa using hi⟩
  have hcovD : (⨆ a : Fin (m + 1), wcFprD R m a) = ⊤ := hcovD0

  let DD : ULift.{u} (Fin (n + 1) × Fin (m + 1)) → X.Opens := fun c => X.basicOpen (g c.down.1 c.down.2)
  let V : X.Opens := ⨆ c, DD c
  let W : ULift.{u} (Fin (n + 1) × Fin (m + 1)) → (V : Scheme.{u}).Opens := fun c => V.ι ⁻¹ᵁ DD c
  have hWU : ∀ c, W c ≤ V.ι ⁻¹ᵁ U c.down.1 := fun c =>
    Scheme.Hom.preimage_mono _ (X.basicOpen_le (g c.down.1 c.down.2))
  obtain ⟨s, hs⟩ : ∃ s : ∀ c, Fin (m + 1) → Γ((V : Scheme.{u}), W c), ∀ c l,
      s c l = V.ι.appLE (U c.down.1) (W c) (hWU c) (g c.down.1 l) :=
    ⟨fun c l => V.ι.appLE (U c.down.1) (W c) (hWU c) (g c.down.1 l), fun _ _ => rfl⟩
  have hcovW : (⨆ c, W c) = ⊤ :=
    (Scheme.Hom.preimage_iSup V.ι DD).symm.trans (Scheme.Opens.ι_preimage_self V)
  have hbo : ∀ c l, (V : Scheme.{u}).basicOpen (s c l) =
      W c ⊓ V.ι ⁻¹ᵁ X.basicOpen (g c.down.1 l) := by
    intro c l
    rw [hs]
    exact Scheme.basicOpen_appLE _ _ _ _ _
  have hWk : ∀ c, (V : Scheme.{u}).basicOpen (s c c.down.2) = W c := by
    intro c
    rw [hbo]
    exact inf_idem _
  have hspan : ∀ c, Ideal.span (Set.range (s c)) = ⊤ := fun c =>
    Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span ⟨c.down.2, rfl⟩)
      (isUnit_of_bo _ _ _ (hWk c))
  have eWW : ∀ c c', W c ⊓ W c' ≤ V.ι ⁻¹ᵁ (U c.down.1 ⊓ U c'.down.1) := by
    intro c c'
    rw [Scheme.Hom.preimage_inf]
    exact inf_le_inf (hWU c) (hWU c')
  have hwW : ∀ c c', IsUnit (V.ι.appLE (U c.down.1 ⊓ U c'.down.1) (W c ⊓ W c') (eWW c c')
      (w c.down.1 c'.down.1)) := fun c c' => (hw _ _).map _
  have htrW : ∀ c c' l, (V : Scheme.{u}).presheaf.map (homOfLE (inf_le_right : W c ⊓ W c' ≤ W c')).op (s c' l) =
      V.ι.appLE (U c.down.1 ⊓ U c'.down.1) (W c ⊓ W c') (eWW c c') (w c.down.1 c'.down.1) *
        (V : Scheme.{u}).presheaf.map (homOfLE (inf_le_left : W c ⊓ W c' ≤ W c)).op (s c l) := by
    intro c c' l
    rw [hs c' l, hs c l,
      hAmap V.ι (U c'.down.1) (W c') (W c ⊓ W c') inf_le_right (hWU c') (le_trans inf_le_right (hWU c')),
      hAmap V.ι (U c.down.1) (W c) (W c ⊓ W c') inf_le_left (hWU c) (le_trans inf_le_left (hWU c)),
      ← hmapA V.ι (U c.down.1 ⊓ U c'.down.1) (U c'.down.1) (W c ⊓ W c') inf_le_right (eWW c c')
