    rw [map_mul, key V₁ inf_le_left inf_le_right, key V₁ inf_le_left inf_le_right,
      key V₂ inf_le_right inf_le_left] at h2
    exact h2

  let V : Fin (n + 1) → (wcProjK k N).Opens := fun i =>
    Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (Θ i)
  let U : Fin (n + 1) → Y.Opens := fun i => j ⁻¹ᵁ V i
  have hΘ1 : ∀ l, Θ l ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k (1 • D) := fun l => by
    rw [one_smul]; exact hΘ l
  let t : ∀ i, Fin (n + 1) → Γ(wcProjK k N, V i) := fun i l =>
    Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (Θ i)
      (HomogeneousLocalization.Away.mk _ (hΘ i) 1 (Θ l) (hΘ1 l))
  let s : ∀ i, Fin (n + 1) → Γ(Y, U i) := fun i l => j.app (V i) (t i l)

  have hmk1 : ∀ i, HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      (hΘ i) 1 (Θ i) (hΘ1 i) = 1 := by
    intro i
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one,
      ← Localization.mk_one, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    exact ⟨1, by simp⟩
  have hone : ∀ i, s i i = 1 := by
    intro i
    show j.app (V i) (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (Θ i)
      (HomogeneousLocalization.Away.mk _ (hΘ i) 1 (Θ i) (hΘ1 i))) = 1
    rw [hmk1 i, map_one, map_one]
  have hU : (⨆ i, U i) = ⊤ := by
    rw [eq_top_iff]
    intro y _
    obtain ⟨i, hi⟩ := hcov y
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨i, hi⟩
  have hs : ∀ i, Ideal.span (Set.range (s i)) = ⊤ := fun i =>
    Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span ⟨i, rfl⟩) (by rw [hone i]; exact isUnit_one)
  have hbo : ∀ l i, Y.basicOpen (s l i) = U l ⊓ U i := by
    intro l i
    have h1 := Scheme.preimage_basicOpen j (t l i)
    have h2 : (wcProjK k N).basicOpen (t l i) = V l ⊓ V i :=
      (LA (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) D (Θ l) (Θ i) (hΘ l) (hΘ i) (hΘ1 i) hD).symm
    rw [h2, Scheme.Hom.preimage_inf] at h1
    exact h1.symm

  let w : ∀ i i', Γ(Y, U i ⊓ U i') := fun i i' =>
    Y.presheaf.map (homOfLE (inf_le_right : U i ⊓ U i' ≤ U i')).op (s i' i)
  have htr : ∀ i i' J, Y.presheaf.map (homOfLE (inf_le_right : U i ⊓ U i' ≤ U i')).op (s i' J) =
      w i i' * Y.presheaf.map (homOfLE (inf_le_left : U i ⊓ U i' ≤ U i)).op (s i J) := by
    intro i i' J
    exact PR (V i') (V i) (t i' J) (t i' i) (t i J)
      (LB (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) D (Θ i') (Θ i) (Θ J) (hΘ i') (hΘ i)
        (hΘ1 i) (hΘ1 J))
  have hw : ∀ i i', IsUnit (w i i') := by
    intro i i'
    have h := htr i i' i'
    rw [hone i', map_one] at h
    exact IsUnit.of_mul_eq_one _ h.symm

  obtain ⟨π, hπs, hπbo, hπrel⟩ :=
    wc_projK_glue_local_coords k n Y (j ≫ wcProjKStr k N) U hU s hs w hw htr
  have hpre : ∀ i, π ⁻¹ᵁ wcSgD k n i = U i := by
    intro i
    apply le_antisymm
    · intro y hy
      have hy0 : y ∈ (⨆ i, U i) := by rw [hU]; trivial
      obtain ⟨l, hl⟩ := TopologicalSpace.Opens.mem_iSup.mp hy0
      have h1 : y ∈ π ⁻¹ᵁ wcSgD k n i ⊓ U l := ⟨hy, hl⟩
      rw [hπbo l i, hbo l i] at h1
      exact h1.2
    · intro y hy
      have hu : IsUnit (s i i) := by rw [hone i]; exact isUnit_one
      have h1 : y ∈ Y.basicOpen (s i i) := by
        rw [Scheme.basicOpen_of_isUnit Y hu]; exact hy
      rw [← hπbo i i] at h1
      exact h1.1
  refine ⟨π, ?_, hπs, hpre, ?_⟩
  · rw [IsFinite.iff_isProper_and_isAffineHom]
    constructor
    · haveI : IsProper (j ≫ wcProjKStr k N) := wcpa_dj_proj_proper k _ ⟨N, j, hj, rfl⟩
      haveI : IsProper (wcProjKStr k n) :=
        wcpa_dj_proj_proper k _ ⟨n, 𝟙 _, inferInstance, Category.id_comp _⟩
      haveI : IsProper (π ≫ wcProjKStr k n) := by rw [hπs]; infer_instance
      exact IsProper.of_comp π (wcProjKStr k n)
    · apply isAffineHom_of_forall_exists_isAffineOpen
      intro x
      have hx : x ∈ (⊤ : (wcProjK k n).Opens) := trivial
      rw [← wc_pp_basicOpen_cover k n] at hx
      obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
      refine ⟨wcSgD k n i, hi, ?_, ?_⟩
      · letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k) := MvPolynomial.gradedAlgebra
        exact Proj.isAffineOpen_basicOpen _ (MvPolynomial.X i)
          ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ i)) Nat.one_pos
      · rw [hpre i]
        exact IsAffineHom.isAffine_preimage _
          (Proj.isAffineOpen_basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (Θ i) (hΘ i) hD)
  · intro i l y hy hy'
    have hOi : π ⁻¹ᵁ wcSgD k n i ≤ U i := (hpre i).le
    have h := hπrel i i l (π ⁻¹ᵁ wcSgD k n i) le_rfl hOi
    rw [hone i, map_one, mul_one, Scheme.Hom.appLE_eq_app] at h
    have h2 := congrArg (Y.presheaf.germ _ y hy) h
    rw [TopCat.Presheaf.germ_res_apply] at h2
    exact h2

theorem wcpa_dj_gsgp_gep_maclane_select : ∀ (k B K : Type u) [Field k] [Finite k] [CommRing B] [IsDomain B] [Field K] [Algebra B K] [IsFractionRing B K] [Algebra k K] (n : ℕ), (∃ S : Finset K, IntermediateField.adjoin k (S : Set K) = ⊤) → (∃ t : Fin n → K, IsTranscendenceBasis k t) → ∃ s : Fin n → B, Algebra.IsSeparable (IntermediateField.adjoin k (Set.range fun l => algebraMap B K (s l))) K :=
by
  intro k B K _ _ _ _ _ _ _ _ n hS ht₀
  classical
  obtain ⟨S, hS⟩ := hS
  obtain ⟨t₀, ht₀⟩ := ht₀

  choose a b _ hab using fun x : K => IsFractionRing.div_surjective (A := B) x
  let G : Finset K := S.image (fun x => algebraMap B K (a x)) ∪ S.image (fun x => algebraMap B K (b x))
  have hGB : ∀ g ∈ G, ∃ y : B, algebraMap B K y = g := by
    intro g hg
    rcases Finset.mem_union.mp hg with h | h
    · obtain ⟨x, -, rfl⟩ := Finset.mem_image.mp h
      exact ⟨a x, rfl⟩
    · obtain ⟨x, -, rfl⟩ := Finset.mem_image.mp h
      exact ⟨b x, rfl⟩
  have hG : IntermediateField.adjoin k (G : Set K) = ⊤ := by
    rw [eq_top_iff, ← hS, IntermediateField.adjoin_le_iff]
    intro x hx
    have h1 : algebraMap B K (a x) ∈ IntermediateField.adjoin k (G : Set K) :=
      IntermediateField.subset_adjoin k _
        (Finset.mem_coe.mpr (Finset.mem_union_left _ (Finset.mem_image_of_mem _ hx)))
    have h2 : algebraMap B K (b x) ∈ IntermediateField.adjoin k (G : Set K) :=
      IntermediateField.subset_adjoin k _
        (Finset.mem_coe.mpr (Finset.mem_union_right _ (Finset.mem_image_of_mem _ hx)))
    have h3 := div_mem h1 h2
    rw [hab x] at h3
    exact h3

  have hp : (ringChar k).Prime := CharP.char_is_prime k (ringChar k)
  have : ExpChar k (ringChar k) := ExpChar.prime hp
  have : CharP K (ringChar k) := charP_of_injective_algebraMap (algebraMap k K).injective (ringChar k)
  have : ExpChar K (ringChar k) := ExpChar.prime hp
  have : PerfectField k := PerfectField.ofFinite
  have : PerfectRing k (ringChar k) := PerfectField.toPerfectRing (ringChar k)
  have hfr : ∀ r : k, ((frobeniusEquiv k (ringChar k)).symm r) ^ (ringChar k) = r := by
    intro r
    have h := (frobeniusEquiv k (ringChar k)).apply_symm_apply r
    rwa [frobeniusEquiv_apply, frobenius_def] at h
  have H : ∀ s : Finset K, LinearIndepOn k id (s : Set K) →
      LinearIndepOn k (fun x => x ^ (ringChar k)) (s : Set K) := by
    intro s hs
    have := hs.map_of_injective_injective (frobeniusEquiv k (ringChar k)).symm
      (frobenius K (ringChar k)).toAddMonoidHom
      (fun r hr => by simpa using hr)
      (fun m hm => by
        have hm' : m ^ (ringChar k) = 0 := hm
        exact (pow_eq_zero_iff hp.ne_zero).mp hm')
      (fun r m => by
        show (((frobeniusEquiv k (ringChar k)).symm r) • m) ^ (ringChar k) = r • m ^ (ringChar k)
        rw [Algebra.smul_def, Algebra.smul_def, mul_pow, ← map_pow, hfr])
    exact this

  have hAlgI : Algebra.IsAlgebraic (Algebra.adjoin k (G : Set K)) K := by
    rw [← IntermediateField.isAlgebraic_adjoin_iff_top]
    refine ⟨fun x => ?_⟩
    have hx : x ∈ IntermediateField.adjoin k (G : Set K) := by rw [hG]; trivial
    exact (isIntegral_algebraMap (x := (⟨x, hx⟩ : IntermediateField.adjoin k (G : Set K)))).isAlgebraic
  obtain ⟨t₁, ht₁G, ht₁⟩ := exists_isTranscendenceBasis_subset (R := k) (G : Set K)
  have ht₁fin : t₁.Finite := G.finite_toSet.subset ht₁G
  let Sep : Finset K → IntermediateField k K := fun t =>
    IntermediateField.restrictScalars k
      (separableClosure (IntermediateField.adjoin k (t : Set K)) K)
  let C : Finset (Finset K) := G.powerset.filter
    (fun t : Finset K => IsTranscendenceBasis k (Subtype.val : ↥(t : Set K) → K))
  have hC : C.Nonempty := by
    refine ⟨ht₁fin.toFinset, ?_⟩
    simp only [C, Finset.mem_filter, Finset.mem_powerset]
    refine ⟨fun x hx => ht₁G (ht₁fin.mem_toFinset.mp hx), ?_⟩
    rw [Set.Finite.coe_toFinset]
    exact ht₁
  obtain ⟨t, htC, hmax⟩ := Finset.exists_maximalFor Sep C hC
  simp only [C, Finset.mem_filter, Finset.mem_powerset] at htC
  obtain ⟨htG, ht⟩ := htC
  have hsep : Algebra.IsSeparable (IntermediateField.adjoin k (t : Set K)) K := by
    by_contra hns
    have hex : ∃ g ∈ G, g ∉ Sep t := by
      by_contra hall
      push_neg at hall
      apply hns
      have h1 : IntermediateField.adjoin k (G : Set K) ≤ Sep t := by
        rw [IntermediateField.adjoin_le_iff]
        intro x hx
        exact hall x hx
      rw [hG] at h1
      have h2 : Sep t = ⊤ := top_le_iff.mp h1
      have h3 : separableClosure (IntermediateField.adjoin k (t : Set K)) K = ⊤ := by
        apply IntermediateField.restrictScalars_injective k
        rw [IntermediateField.restrictScalars_top]
        exact h2
      exact (separableClosure.eq_top_iff _ _).mp h3
    obtain ⟨g, hgG, hg⟩ := hex
    have hgt : g ∉ (t : Set K) := by
      intro hgt'
      exact hg (le_restrictScalars_separableClosure (IntermediateField.adjoin k (t : Set K))
        (IntermediateField.subset_adjoin k _ hgt'))
    obtain ⟨i, hi₁, hi₂⟩ := exists_isTranscendenceBasis_and_isSeparable_of_linearIndepOn_pow'
      (ringChar k) hp H (a := id) (t : Set K) g ht hgt
    rw [Set.image_id] at hi₂
    obtain ⟨t', ht'⟩ : ∃ t' : Finset K, (t' : Set K) = insert g (t : Set K) \ {i} :=
      ⟨insert g t \ {i}, by simp⟩
    have ht'C : t' ∈ C := by
      simp only [C, Finset.mem_filter, Finset.mem_powerset]
      refine ⟨?_, ?_⟩
      · intro x hx
        have hx' : x ∈ (t' : Set K) := hx
        rw [ht'] at hx'
        rcases hx'.1 with h | h
        · rw [h]; exact hgG
        · exact htG h
      · rw [ht']
        exact hi₁
    have hsepi : i ∈ Sep t' := by
      show i ∈ IntermediateField.restrictScalars k
        (separableClosure (IntermediateField.adjoin k (t' : Set K)) K)
      rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff, ht']
      exact hi₂
    have hmem' : ∀ x ∈ insert g (t : Set K), x ∈ Sep t' := by
      intro x hx
      by_cases hxi : x = i
      · rw [hxi]; exact hsepi
      · have hxt' : x ∈ (t' : Set K) := by rw [ht']; exact ⟨hx, hxi⟩
        exact le_restrictScalars_separableClosure (IntermediateField.adjoin k (t' : Set K))
          (IntermediateField.subset_adjoin k _ hxt')
    have hle : Sep t ≤ Sep t' := by
      show IntermediateField.restrictScalars k
          (separableClosure (IntermediateField.adjoin k (t : Set K)) K) ≤
        IntermediateField.restrictScalars k
          (separableClosure (IntermediateField.adjoin k (t' : Set K)) K)
      rw [separableClosure_le_separableClosure_iff, IntermediateField.adjoin_le_iff]
      intro x hx
      exact hmem' x (Set.mem_insert_of_mem _ hx)
    exact hg (hmax ht'C hle (hmem' g (Set.mem_insert _ _)))

  have hc := ht₀.lift_cardinalMk_eq ht
  simp only [Cardinal.mk_fin, Cardinal.lift_natCast, Finset.coe_sort_coe,
    Cardinal.mk_coe_finset] at hc
  have hcard : t.card = n := by exact_mod_cast hc.symm
  let e : t ≃ Fin n := Finset.equivFinOfCardEq hcard
  choose s hs using fun l : Fin n => hGB _ (htG (e.symm l).2)
  have hrange : Set.range (fun l => algebraMap B K (s l)) = (t : Set K) := by
    ext x
    constructor
    · rintro ⟨l, rfl⟩
      show algebraMap B K (s l) ∈ (t : Set K)
      rw [hs l]
      exact (e.symm l).2
    · intro hx
      refine ⟨e ⟨x, hx⟩, ?_⟩
      show algebraMap B K (s (e ⟨x, hx⟩)) = x
      rw [hs, Equiv.symm_apply_apply]
  refine ⟨s, ?_⟩
  rw [hrange]
  exact hsep

theorem wcpa_dj_gsgp_gep_shift_separable : ∀ (k K : Type u) [Field k] [Field K] [Algebra k K] (p : ℕ) [Fact p.Prime] [CharP K p] (n : ℕ) (w a : Fin n → K), (∃ S : Finset K, IntermediateField.adjoin k (S : Set K) = ⊤) → Algebra.IsSeparable (IntermediateField.adjoin k (Set.range w)) K → Algebra.IsAlgebraic (IntermediateField.adjoin k (Set.range fun l => a l ^ p + w l)) K → Algebra.IsSeparable (IntermediateField.adjoin k (Set.range fun l => a l ^ p + w l)) K :=
by
  intro k K _ _ _ p _ _ n w a hS hsep halg
  set L := IntermediateField.adjoin k (Set.range w) with hL
  set M := IntermediateField.adjoin k (Set.range fun l => a l ^ p + w l) with hM
  let D := KaehlerDifferential.D M K
  have hk : ∀ c : k, D (algebraMap k K c) = 0 := by
    intro c
    rw [IsScalarTower.algebraMap_apply k M K]
    exact D.map_algebraMap _
  have hv : ∀ l, D (a l ^ p + w l) = 0 := by
    intro l
    have hmem : a l ^ p + w l ∈ M := IntermediateField.subset_adjoin k _ ⟨l, rfl⟩
    have e : a l ^ p + w l = algebraMap M K ⟨_, hmem⟩ := rfl
    rw [e]
    exact D.map_algebraMap _
  have hp : ∀ l, D (a l ^ p) = 0 := by
    intro l
    rw [Derivation.leibniz_pow, ← Nat.cast_smul_eq_nsmul K, CharP.cast_eq_zero K p, zero_smul]
  have hw : ∀ l, D (w l) = 0 := by
    intro l
    have e : w l = (a l ^ p + w l) - a l ^ p := by ring
    rw [e, map_sub, hv, hp, sub_zero]
  have hLker : ∀ x ∈ L, D x = 0 := by
    intro x hx
    induction hx using IntermediateField.adjoin_induction with
    | mem x hx => obtain ⟨l, rfl⟩ := hx; exact hw l
    | algebraMap c => exact hk c
    | add x y _ _ hx hy => rw [map_add, hx, hy, add_zero]
    | inv x _ hx => rw [Derivation.leibniz_inv, hx, smul_zero]
    | mul x y _ _ hx hy => rw [Derivation.leibniz, hx, hy, smul_zero, smul_zero, add_zero]
  have hpoly : ∀ (x : K) (g : Polynomial L),
      D (Polynomial.aeval x g) = Polynomial.aeval x (Polynomial.derivative g) • D x := by
    intro x g
    induction g using Polynomial.induction_on' with
    | add f g hf hg =>
      rw [map_add, map_add, hf, hg, Polynomial.derivative_add, map_add, add_smul]
    | monomial m c =>
      have hc : D (algebraMap L K c) = 0 := hLker _ c.2
      rw [Polynomial.aeval_monomial, Polynomial.derivative_monomial, Polynomial.aeval_monomial,
        Derivation.leibniz, Derivation.leibniz_pow, hc, smul_zero, add_zero,
        ← Nat.cast_smul_eq_nsmul K, smul_smul, smul_smul, map_mul, map_natCast]
  have hall : ∀ x : K, D x = 0 := by
    intro x
    have hsx : IsSeparable L x := Algebra.IsSeparable.isSeparable L x
    have hne : Polynomial.aeval x (Polynomial.derivative (minpoly L x)) ≠ 0 :=
      hsx.aeval_derivative_ne_zero (minpoly.aeval L x)
    have h0 := hpoly x (minpoly L x)
    rw [minpoly.aeval, map_zero] at h0
    have h1 := congrArg (fun ω => (Polynomial.aeval x (Polynomial.derivative (minpoly L x)))⁻¹ • ω) h0
    simp only [smul_zero, inv_smul_smul₀ hne] at h1
    exact h1.symm
  have hsub : Subsingleton (KaehlerDifferential M K) := by
    have h := KaehlerDifferential.span_range_derivation M K
    have hle : Submodule.span K (Set.range (KaehlerDifferential.D M K)) ≤ ⊥ := by
      rw [Submodule.span_le]
      rintro _ ⟨x, rfl⟩
      exact hall x
    rw [h] at hle
    exact subsingleton_of_forall_eq 0 (fun ω => by
      simpa using hle (Submodule.mem_top (x := ω)))
  have : Algebra.FormallyUnramified M K := ⟨hsub⟩
  obtain ⟨S, hS⟩ := hS
  have hSM : IntermediateField.adjoin M (S : Set K) = ⊤ := by
    rw [eq_top_iff]
    intro y _
    have hy : y ∈ IntermediateField.adjoin k (S : Set K) := hS ▸ IntermediateField.mem_top
    have hle : IntermediateField.adjoin k (S : Set K) ≤
        (IntermediateField.adjoin M (S : Set K)).restrictScalars k := by
      rw [IntermediateField.adjoin_le_iff]
      intro s hs
      exact IntermediateField.subset_adjoin M _ hs
    exact hle hy
  have hAlg : Algebra.adjoin M (S : Set K) = ⊤ :=
    Algebra.adjoin_eq_top_of_intermediateField (fun x _ => Algebra.IsAlgebraic.isAlgebraic x) hSM
  have : Algebra.FiniteType M K := ⟨⟨S, hAlg⟩⟩
  have : Algebra.EssFiniteType M K := Algebra.EssFiniteType.of_finiteType M K
  exact Algebra.FormallyUnramified.isSeparable M K

theorem wcpa_sde_trdeg_standard_smooth : ∀ (K : Type u) [Field K] [PerfectField K] (A : Type u)
    [CommRing A] [IsDomain A] [Algebra K A] (n : ℕ) [Algebra.IsStandardSmoothOfRelativeDimension n K A],
    Algebra.trdeg K A = n :=
by
  intro K _ _ A _ _ _ n _
  haveI : Algebra.IsStandardSmooth K A :=
    Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth n
  haveI : Algebra.FinitePresentation K A := Algebra.IsStandardSmooth.finitePresentation
  haveI : Algebra.FiniteType K A := Algebra.FiniteType.of_finitePresentation

  obtain ⟨x, hli, hsp⟩ : ∃ x : Fin n → A,
      LinearIndependent A (fun i => KaehlerDifferential.D K A (x i)) ∧
      Submodule.span A (Set.range (fun i => KaehlerDifferential.D K A (x i))) = ⊤ := by
    obtain ⟨ι, σ, _, _, P, -⟩ :=
      Algebra.IsStandardSmoothOfRelativeDimension.out (n := n) (R := K) (S := A)
    have hr :=
      Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential (R := K) (S := A) n
    have hf : Module.finrank A Ω[A⁄K] = n := Module.finrank_eq_of_rank_eq hr
    have hc : Nat.card (↑(Set.range P.map)ᶜ) = n := by
      rw [← Module.finrank_eq_nat_card_basis P.basisKaehler, hf]
    let e := (Finite.equivFinOfCardEq hc).symm
    have hfun : (fun i => KaehlerDifferential.D K A (P.val (e i))) = P.basisKaehler ∘ e := by
      funext i
      simp only [Function.comp_apply, Algebra.SubmersivePresentation.basisKaehler_apply]
    refine ⟨fun i => P.val (e i), ?_, ?_⟩
    · rw [hfun]
      exact P.basisKaehler.linearIndependent.comp e e.injective
    · rw [hfun, Set.range_comp, e.range_eq_univ, Set.image_univ, P.basisKaehler.span_eq]

  have hai : AlgebraicIndependent K x := by
    classical
    have chain : ∀ Q : MvPolynomial (Fin n) K,
        KaehlerDifferential.D K A (MvPolynomial.aeval x Q) =
        ∑ i, MvPolynomial.aeval x (MvPolynomial.pderiv i Q) • KaehlerDifferential.D K A (x i) := by
      intro Q
      induction Q using MvPolynomial.induction_on with
      | C a => simp [Derivation.map_algebraMap]
      | add p q hp hq => simp only [map_add, hp, hq, add_smul, Finset.sum_add_distrib]
      | mul_X p j hp =>
        have e1 : ∀ i, MvPolynomial.pderiv i (p * MvPolynomial.X j) =
            MvPolynomial.pderiv i p * MvPolynomial.X j + (if i = j then p else 0) := by
          intro i
          rw [Derivation.leibniz, MvPolynomial.pderiv_X, smul_eq_mul, smul_eq_mul]
          by_cases h : i = j
          · subst h
            simp only [Pi.single_eq_same, if_true, mul_one]
            ring
          · have h' : j ≠ i := Ne.symm h
            rw [if_neg h, Pi.single_apply, if_neg h', mul_zero]
            ring
        have e2 : ∑ i, (MvPolynomial.aeval x (if i = j then p else 0)) •
            KaehlerDifferential.D K A (x i) =
            MvPolynomial.aeval x p • KaehlerDifferential.D K A (x j) := by
          rw [Finset.sum_eq_single j]
          · simp
          · intro i _ hij
            simp [hij]
          · simp
        rw [map_mul, MvPolynomial.aeval_X, Derivation.leibniz, hp]
        simp only [e1]
        simp only [map_add, add_smul, Finset.sum_add_distrib]
        rw [e2, add_comm, Finset.smul_sum]
        congr 1
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [map_mul, MvPolynomial.aeval_X, smul_smul, mul_comm]
    have hdeg : ∀ (Q : MvPolynomial (Fin n) K) (i : Fin n), MvPolynomial.pderiv i Q ≠ 0 →
        (MvPolynomial.pderiv i Q).totalDegree < Q.totalDegree := by
      intro Q i hne
      have hpos : ∀ m ∈ (MvPolynomial.pderiv i Q).support,
          (m.sum fun _ e => e) + 1 ≤ Q.totalDegree := by
        intro m hm
        rw [MvPolynomial.mem_support_iff, MvPolynomial.coeff_pderiv] at hm
        have hm' : m + Finsupp.single i 1 ∈ Q.support := by
          rw [MvPolynomial.mem_support_iff]
          intro h
          apply hm
          rw [h, zero_mul]
        have := MvPolynomial.le_totalDegree hm'
        rw [Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl),
          Finsupp.sum_single_index rfl] at this
        exact this
      have h1 : (MvPolynomial.pderiv i Q).totalDegree ≤ Q.totalDegree - 1 :=
        Finset.sup_le (fun m hm => by have := hpos m hm; omega)
      obtain ⟨m, hm⟩ :=
        Finset.nonempty_iff_ne_empty.mpr (mt MvPolynomial.support_eq_empty.mp hne)
      have := hpos m hm
      omega
    have hcoef : ∀ (Q : MvPolynomial (Fin n) K) (i : Fin n), MvPolynomial.pderiv i Q = 0 →
        ∀ m ∈ Q.support, ((m i : ℕ) : K) = 0 := by
      intro Q i hQ m hm
      by_cases hmi : m i = 0
      · simp [hmi]
      · set m' : Fin n →₀ ℕ := m - Finsupp.single i 1 with hm'def
        have hm' : m = m' + Finsupp.single i 1 := by
          ext j
          rw [hm'def, Finsupp.add_apply, Finsupp.tsub_apply, Finsupp.single_apply]
          split_ifs with h
          · subst h; omega
          · omega
        have := MvPolynomial.coeff_pderiv (i := i) Q m'
        rw [hQ, MvPolynomial.coeff_zero, ← hm'] at this
        have hc : Q.coeff m ≠ 0 := MvPolynomial.mem_support_iff.mp hm
        have h2 : ((m' i : ℕ) : K) + 1 = (m i : K) := by
          rw [hm'def, Finsupp.tsub_apply, Finsupp.single_eq_same, ← Nat.cast_succ]
          exact congrArg Nat.cast (by omega)
        rw [h2] at this
        exact (mul_eq_zero.mp this.symm).resolve_left hc
    have hinjK : Function.Injective (algebraMap K A) := (algebraMap K A).injective
    have hpowdeg : ∀ (R : MvPolynomial (Fin n) K), R ≠ 0 → ∀ k : ℕ,
        (R ^ k).totalDegree = k * R.totalDegree := by
      intro R hR k
      induction k with
      | zero => simp
      | succ k ih =>
        rw [pow_succ, MvPolynomial.totalDegree_mul_of_isDomain (pow_ne_zero k hR) hR, ih]
        ring
    rw [algebraicIndependent_iff_injective_aeval, injective_iff_map_eq_zero]
    have key : ∀ d (Q : MvPolynomial (Fin n) K), Q.totalDegree = d →
        MvPolynomial.aeval x Q = 0 → Q = 0 := by
      intro d
      induction d using Nat.strong_induction_on with
      | _ d ih =>
      intro Q hQd hQ
      have hpd : ∀ i, MvPolynomial.pderiv i Q = 0 := by
        have h0 : ∑ i, MvPolynomial.aeval x (MvPolynomial.pderiv i Q) •
            KaehlerDifferential.D K A (x i) = 0 := by
          rw [← chain, hQ, map_zero]
        have hz := (Fintype.linearIndependent_iff.mp hli) _ h0
        intro i
        by_contra hne
        exact hne (ih _ (hQd ▸ hdeg Q i hne) _ rfl (hz i))
      obtain ⟨p, hp⟩ := CharP.exists K
      rcases CharP.char_is_prime_or_zero K p with hprime | hzero
      · haveI := Fact.mk hprime
        haveI : ExpChar K p := ExpChar.prime hprime
        haveI : PerfectRing K p := PerfectField.toPerfectRing p
        have hdvd : ∀ m ∈ Q.support, ∀ i, p ∣ m i := fun m hm i =>
          (CharP.cast_eq_zero_iff K p (m i)).mp (hcoef Q i (hpd i) m hm)
        let R : MvPolynomial (Fin n) K := ∑ m ∈ Q.support,
          MvPolynomial.monomial (Finsupp.mapRange (· / p) (Nat.zero_div p) m)
            ((frobeniusEquiv K p).symm (Q.coeff m))
        have hRp : R ^ p = Q := by
          simp only [R]
          rw [sum_pow_char]
          conv_rhs => rw [MvPolynomial.as_sum Q]
          refine Finset.sum_congr rfl fun m hm => ?_
          rw [MvPolynomial.monomial_pow]
          have h1 : p • Finsupp.mapRange (fun x => x / p) (Nat.zero_div p) m = m := by
            ext i
            rw [Finsupp.smul_apply, Finsupp.mapRange_apply, smul_eq_mul]
            exact Nat.mul_div_cancel' (hdvd m hm i)
          have h2 : ((frobeniusEquiv K p).symm (Q.coeff m)) ^ p = Q.coeff m := by
            rw [← frobenius_def, frobenius_apply_frobeniusEquiv_symm]
          rw [h1, h2]
        have hRx : MvPolynomial.aeval x R = 0 := by
          have : (MvPolynomial.aeval x R) ^ p = 0 := by rw [← map_pow, hRp, hQ]
          exact (pow_eq_zero_iff hprime.ne_zero).mp this
        by_contra hQne
        have hRne : R ≠ 0 := by
          intro h
          apply hQne
          rw [← hRp, h, zero_pow hprime.ne_zero]
        have hdegR : Q.totalDegree = p * R.totalDegree := by
          rw [← hRp]
          exact hpowdeg R hRne p
        rcases Nat.eq_zero_or_pos R.totalDegree with h0 | hpos
        · have hRC : R = MvPolynomial.C (R.coeff 0) :=
            MvPolynomial.totalDegree_eq_zero_iff_eq_C.mp h0
          rw [hRC, MvPolynomial.aeval_C] at hRx
          apply hRne
          rw [hRC, hinjK (hRx.trans (map_zero _).symm), map_zero]
        · have h2 := hprime.two_le
          have hlt : R.totalDegree < d := by
            rw [← hQd, hdegR]
            nlinarith
          exact hRne (ih _ hlt R rfl hRx)
      · subst hzero
        haveI : CharZero K := CharP.charP_to_charZero K
        have h0 : Q.totalDegree = 0 := by
          apply Nat.eq_zero_of_le_zero
          apply Finset.sup_le
          intro m hm
          have hm0 : m = 0 := by
            ext i
            exact_mod_cast hcoef Q i (hpd i) m hm
          subst hm0
          simp
        have hQC : Q = MvPolynomial.C (Q.coeff 0) :=
          MvPolynomial.totalDegree_eq_zero_iff_eq_C.mp h0
        rw [hQC, MvPolynomial.aeval_C] at hQ
        rw [hQC, hinjK (hQ.trans (map_zero _).symm), map_zero]
    intro Q hQ
    exact key _ Q rfl hQ

  have halg : Algebra.IsAlgebraic (Algebra.adjoin K (Set.range x)) A := by
    set B := Algebra.adjoin K (Set.range x)
    haveI hsub : Subsingleton Ω[A⁄B] := by
      have hall : ∀ ω : Ω[A⁄B], ω = 0 := by
        intro ω
        obtain ⟨η, rfl⟩ := KaehlerDifferential.map_surjective K B A ω
        have hη : η ∈ Submodule.span A (Set.range (fun i => KaehlerDifferential.D K A (x i))) :=
          hsp ▸ Submodule.mem_top
        have hle : Submodule.span A (Set.range (fun i => KaehlerDifferential.D K A (x i))) ≤
            LinearMap.ker (KaehlerDifferential.map K B A A) := by
          rw [Submodule.span_le]
          rintro _ ⟨i, rfl⟩
          simp only [SetLike.mem_coe, LinearMap.mem_ker]
          rw [KaehlerDifferential.map_D]
          have : (algebraMap A A) (x i) =
              algebraMap B A ⟨x i, Algebra.subset_adjoin ⟨i, rfl⟩⟩ := rfl
          rw [this, Derivation.map_algebraMap]
        exact hle hη
      exact ⟨fun a b => by rw [hall a, hall b]⟩
    haveI : Algebra.FormallyUnramified B A := ⟨hsub⟩
    haveI : Algebra.FormallyUnramified A (FractionRing A) :=
      Algebra.FormallyUnramified.of_isLocalization (nonZeroDivisors A)
    haveI : Algebra.FormallyUnramified B (FractionRing A) :=
      Algebra.FormallyUnramified.comp B A (FractionRing A)
    have hinj : Function.Injective (algebraMap B (FractionRing A)) := by
      rw [IsScalarTower.algebraMap_eq B A (FractionRing A)]
      exact (IsFractionRing.injective A (FractionRing A)).comp Subtype.val_injective
    haveI : FaithfulSMul B (FractionRing A) :=
      (faithfulSMul_iff_algebraMap_injective _ _).mpr hinj
    letI : Algebra (FractionRing B) (FractionRing A) := FractionRing.liftAlgebra B (FractionRing A)
    haveI : IsScalarTower B (FractionRing B) (FractionRing A) :=
      FractionRing.isScalarTower_liftAlgebra B (FractionRing A)
    haveI : Algebra.FormallyUnramified (FractionRing B) (FractionRing A) :=
      Algebra.FormallyUnramified.localization_base (nonZeroDivisors B)
    haveI : Algebra.FiniteType B A := Algebra.FiniteType.of_restrictScalars_finiteType K B A
    haveI : Algebra.EssFiniteType B A := Algebra.EssFiniteType.of_finiteType _ _
    haveI : Algebra.EssFiniteType A (FractionRing A) :=
      Algebra.EssFiniteType.of_isLocalization (FractionRing A) (nonZeroDivisors A)
    haveI : Algebra.EssFiniteType B (FractionRing A) :=
      Algebra.EssFiniteType.comp B A (FractionRing A)
    haveI : Algebra.EssFiniteType (FractionRing B) (FractionRing A) :=
      Algebra.EssFiniteType.of_comp B _ (FractionRing A)
    haveI : Algebra.IsSeparable (FractionRing B) (FractionRing A) :=
      Algebra.FormallyUnramified.isSeparable _ _
    haveI : Algebra.IsAlgebraic (FractionRing B) (FractionRing A) :=
      Algebra.IsSeparable.isAlgebraic _ _
    haveI : Algebra.IsAlgebraic B (FractionRing A) :=
      (IsFractionRing.comap_isAlgebraic_iff (A := B) (K := FractionRing B)
        (C := FractionRing A)).mpr inferInstance
    exact Algebra.IsAlgebraic.of_injective (IsScalarTower.toAlgHom B A (FractionRing A))
      (IsFractionRing.injective A (FractionRing A))

  have htb : IsTranscendenceBasis K x := hai.isTranscendenceBasis_iff_isAlgebraic.mpr halg
  have h := htb.lift_cardinalMk_eq_trdeg
  rw [Cardinal.mk_fin, Cardinal.lift_natCast, Cardinal.lift_uzero] at h
  exact h.symm

theorem wcpa_dj_mn_fs_chart_smooth : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (n : ℕ) (U : Y.Opens) (_ : IsAffineOpen U) (V : X.Opens) (_ : IsAffineOpen V) (e : V ≤ f ⁻¹ᵁ U), RingHom.IsStandardSmoothOfRelativeDimension n (f.appLE U V e).hom → SmoothOfRelativeDimension n (V.ι ≫ f) :=
by
  intro X Y f n U hU V hV e hstd
  have : IsAffine V.toScheme := hV
  have e' : (⊤ : V.toScheme.Opens) ≤ (V.ι ≫ f) ⁻¹ᵁ U := by
    intro z _
    show (V.ι ≫ f) z ∈ U
    rw [Scheme.Hom.comp_apply]
    exact e z.2
  have h₀ : V.ι ''ᵁ ⊤ ≤ f ⁻¹ᵁ U := by
    rw [Scheme.Opens.ι_image_top]; exact e
  have e'' : (⊤ : V.toScheme.Opens) ≤ V.ι ⁻¹ᵁ f ⁻¹ᵁ U := e'
  have key : (V.ι ≫ f).appLE U ⊤ e' = f.appLE U (V.ι ''ᵁ ⊤) h₀ := by
    rw [Scheme.Hom.comp_appLE]
    have h2 := Scheme.Opens.ι_appLE V (f ⁻¹ᵁ U) ⊤ e''
    rw [h2]
    rfl
  have hstd' : RingHom.IsStandardSmoothOfRelativeDimension n (f.appLE U (V.ι ''ᵁ ⊤) h₀).hom :=
    (Scheme.Hom.appLE_congr f e rfl (Scheme.Opens.ι_image_top V).symm
      (fun φ => RingHom.IsStandardSmoothOfRelativeDimension n φ.hom)).mp hstd
  refine SmoothOfRelativeDimension.mk ?_
  intro x
  refine ⟨U, hU, ⊤, isAffineOpen_top V.toScheme, trivial, e', ?_⟩
  rw [key]
  exact hstd'

theorem wcpa_dj_gsgp_gep_generic_smooth_open : ∀ (k : Type u) [Field k] [PerfectField k] (Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral Y] (sY : Y ⟶ Spec (.of k)) [IsProper sY] (n : ℕ), topologicalKrullDim Y = (n : WithBot ℕ∞) → ∃ U : Y.Opens, U ≠ ⊥ ∧ SmoothOfRelativeDimension n (U.ι ≫ sY) :=
by
  intro k _ _ Y _ sY _ n hdim
  classical

  obtain ⟨V₀, hV₀, hηV₀, -⟩ :=
    exists_isAffineOpen_mem_and_subset (x := genericPoint Y) (U := ⊤) trivial
  haveI : Nonempty V₀ := ⟨⟨_, hηV₀⟩⟩
  haveI : IsDomain Γ(Y, V₀) := IsIntegral.component_integral V₀
  letI i₀ : Algebra k Γ(Y, V₀) := ((Scheme.ΓSpecIso (.of k)).inv ≫ sY.appTop ≫
    Y.presheaf.map (homOfLE (le_top : V₀ ≤ ⊤)).op).hom.toAlgebra
  have hsurjiso : Function.Surjective (Scheme.ΓSpecIso (.of k)).inv.hom :=
    (Scheme.ΓSpecIso (.of k)).symm.commRingCatIsoToRingEquiv.surjective
  haveI hft : Algebra.FiniteType k Γ(Y, V₀) := by
    have e : V₀ ≤ sY ⁻¹ᵁ ⊤ := fun x _ => trivial
    have h1 : RingHom.FiniteType (sY.appLE ⊤ V₀ e).hom :=
      HasRingHomProperty.appLE @LocallyOfFiniteType sY inferInstance
        ⟨⊤, isAffineOpen_top _⟩ ⟨V₀, hV₀⟩ e
    have h2 : RingHom.FiniteType (Scheme.ΓSpecIso (.of k)).inv.hom :=
      RingHom.FiniteType.of_surjective _ hsurjiso
    have h3 := h1.comp h2
    have heq : (sY.appLE ⊤ V₀ e).hom.comp (Scheme.ΓSpecIso (.of k)).inv.hom =
        ((Scheme.ΓSpecIso (.of k)).inv ≫ sY.appTop ≫
          Y.presheaf.map (homOfLE (le_top : V₀ ≤ ⊤)).op).hom := by
      rw [← CommRingCat.hom_comp]
      rfl
    rw [heq] at h3
    exact h3
  haveI : Algebra.FinitePresentation k Γ(Y, V₀) := Algebra.FinitePresentation.of_finiteType.mp hft

  have hsm : Algebra.IsSmoothAt k (⊥ : Ideal Γ(Y, V₀)) := by
    haveI : Algebra.EssFiniteType k Γ(Y, V₀) := Algebra.EssFiniteType.of_finiteType k _
    haveI : Algebra.EssFiniteType Γ(Y, V₀) (FractionRing Γ(Y, V₀)) :=
      Algebra.EssFiniteType.of_isLocalization _ (nonZeroDivisors Γ(Y, V₀))
    haveI : Algebra.EssFiniteType k (FractionRing Γ(Y, V₀)) :=
      Algebra.EssFiniteType.comp k Γ(Y, V₀) (FractionRing Γ(Y, V₀))
    haveI : Algebra.FormallySmooth k (FractionRing Γ(Y, V₀)) := Algebra.FormallySmooth.of_perfectField
    haveI : IsLocalization (⊥ : Ideal Γ(Y, V₀)).primeCompl (FractionRing Γ(Y, V₀)) := by
      rw [Ideal.primeCompl_bot]; infer_instance
    let e := IsLocalization.algEquiv (⊥ : Ideal Γ(Y, V₀)).primeCompl (FractionRing Γ(Y, V₀))
      (Localization.AtPrime (⊥ : Ideal Γ(Y, V₀)))
    exact Algebra.FormallySmooth.of_equiv (e.restrictScalars k)
  obtain ⟨b, hb, hstd0⟩ :=
    @Algebra.IsSmoothAt.exists_notMem_isStandardSmooth k Γ(Y, V₀) _ _ _ _ ⊥ _ hsm
  obtain ⟨ι, σ, hσ, hι, ⟨P⟩⟩ := hstd0.out
  set m := P.dimension with hmdef
  haveI hstdb : Algebra.IsStandardSmoothOfRelativeDimension m k (Localization.Away b) :=
    ⟨⟨ι, σ, hσ, hι, P, rfl⟩⟩
  have hb0 : b ≠ 0 := fun h => hb (by rw [h]; exact Submodule.zero_mem _)

  have hVaff : IsAffineOpen (Y.basicOpen b) := hV₀.basicOpen b
  have hVne : Y.basicOpen b ≠ ⊥ := fun h => hb0 ((basicOpen_eq_bot_iff b).mp h)
  have hVne' : (Y.basicOpen b : Set Y).Nonempty :=
    (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mp hVne
  haveI : Nonempty (Y.basicOpen b) := ⟨⟨_, hVne'.some_mem⟩⟩
  haveI : IsDomain Γ(Y, Y.basicOpen b) := IsIntegral.component_integral _
  letI i₁ : Algebra k Γ(Y, Y.basicOpen b) := ((Scheme.ΓSpecIso (.of k)).inv ≫ sY.appTop ≫
    Y.presheaf.map (homOfLE (le_top : Y.basicOpen b ≤ ⊤)).op).hom.toAlgebra
  haveI : IsScalarTower k Γ(Y, V₀) Γ(Y, Y.basicOpen b) := IsScalarTower.of_algebraMap_eq' (by
    change ((Scheme.ΓSpecIso (.of k)).inv ≫ sY.appTop ≫
        Y.presheaf.map (homOfLE (le_top : Y.basicOpen b ≤ ⊤)).op).hom =
      (Y.presheaf.map (homOfLE (Y.basicOpen_le b)).op).hom.comp
        ((Scheme.ΓSpecIso (.of k)).inv ≫ sY.appTop ≫
          Y.presheaf.map (homOfLE (le_top : V₀ ≤ ⊤)).op).hom
    rw [← CommRingCat.hom_comp]
    congr 1
    simp only [Category.assoc, ← Functor.map_comp]
    rfl)
  haveI := hV₀.isLocalization_basicOpen b
  let e₁ := IsLocalization.algEquiv (Submonoid.powers b) (Localization.Away b)
    Γ(Y, Y.basicOpen b)
  haveI hstdV : Algebra.IsStandardSmoothOfRelativeDimension m k Γ(Y, Y.basicOpen b) :=
    Algebra.IsStandardSmoothOfRelativeDimension.of_algEquiv m (e₁.restrictScalars k)

  have hm : Algebra.trdeg k Γ(Y, Y.basicOpen b) = m :=
    wcpa_sde_trdeg_standard_smooth k Γ(Y, Y.basicOpen b) m
  have hn : Algebra.trdeg k Γ(Y, Y.basicOpen b) = n :=
    wcpa_dj_sgs_affine_trdeg k Y sY n hdim (Y.basicOpen b) hVaff hVne'
  have hmn : m = n := by
    have h : (m : Cardinal.{u}) = (n : Cardinal.{u}) := hm.symm.trans hn
    exact_mod_cast h
  rw [hmn] at hstdV

  have e : Y.basicOpen b ≤ sY ⁻¹ᵁ ⊤ := fun x _ => trivial
  have hring : RingHom.IsStandardSmoothOfRelativeDimension n
      ((Scheme.ΓSpecIso (.of k)).inv ≫ sY.appTop ≫
        Y.presheaf.map (homOfLE (le_top : Y.basicOpen b ≤ ⊤)).op).hom := hstdV
  have heq : ((Scheme.ΓSpecIso (.of k)).inv ≫ sY.appTop ≫
        Y.presheaf.map (homOfLE (le_top : Y.basicOpen b ≤ ⊤)).op) =
      (Scheme.ΓSpecIso (.of k)).inv ≫ sY.appLE ⊤ (Y.basicOpen b) e := rfl
  rw [heq, CommRingCat.hom_comp,
    RingHom.RespectsIso.cancel_left_isIso RingHom.isStandardSmoothOfRelativeDimension_respectsIso]
    at hring
  exact ⟨Y.basicOpen b, hVne,
    wcpa_dj_mn_fs_chart_smooth sY n ⊤ (isAffineOpen_top _) (Y.basicOpen b) hVaff e hring⟩

theorem wcpa_dj_gsgp_gep_shift_forms : ∀ (k : Type u) [Field k] (N n D p : ℕ) (Y : Scheme.{u}) (j : Y ⟶ wcProjK k N) (θ : Fin (n + 1) → MvPolynomial (Fin (N + 1)) k), IsClosedImmersion j → 0 < D → 2 ≤ p → (∀ i, (θ i).IsHomogeneous D) → (∀ y : Y, ∃ i, j y ∈ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra (θ i)) → ∀ s : Fin n → Γ(Y, j ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra (θ 0)), ∃ (D' : ℕ) (Θ : Fin (n + 1) → MvPolynomial (Fin (N + 1)) k) (hΘ : ∀ i, Θ i ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k D') (a : Fin n → Γ(Y, j ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra (θ 0))), 0 < D' ∧ (∀ y : Y, ∃ i, j y ∈ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra (Θ i)) ∧ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra (Θ 0) = @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra (θ 0) ∧ ∀ (l : Fin n) (y : Y) (hy : y ∈ j ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra (θ 0)) (hy' : y ∈ j ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra (Θ 0)), (Y.presheaf.germ _ y hy').hom ((j.app _).hom ((@Proj.awayToSection _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra (Θ 0)).hom (letI := @MvPolynomial.gradedAlgebra (Fin (N + 1)) k _; HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (hΘ 0) 1 (Θ l.succ) (by rw [one_smul]; exact hΘ l.succ)))) = (Y.presheaf.germ _ y hy).hom (a l ^ p + s l) :=
by

  have s1 : ∀ {σ A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ) [GradedRing 𝒜] (Y : Scheme.{u}) (j : Y ⟶ Proj 𝒜) (f : A) (D : ℕ) (hf : f ∈ 𝒜 D), IsClosedImmersion j → 0 < D → ∀ s : Γ(Y, j ⁻¹ᵁ Proj.basicOpen 𝒜 f), ∃ (ρ : ℕ) (F : A) (hF : F ∈ 𝒜 (ρ • D)), (j.app (Proj.basicOpen 𝒜 f)).hom ((Proj.awayToSection 𝒜 f).hom (HomogeneousLocalization.Away.mk 𝒜 hf ρ F hF)) = s := by
    intro σ A _ _ _ 𝒜 _ Y j f D hf hj hD s
    obtain ⟨t, ht⟩ := Scheme.Hom.app_surjective j _ (Proj.isAffineOpen_basicOpen 𝒜 f hf hD) s
    obtain ⟨ρ, F, hF, hz⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 hf
      ((Proj.basicOpenIsoAway 𝒜 f hf hD).inv.hom t)
    refine ⟨ρ, F, hF, ?_⟩
    rw [hz, ← ht, ← Proj.basicOpenIsoAway_hom 𝒜 f hf hD]
    congr 1
    exact Iso.inv_hom_id_apply (Proj.basicOpenIsoAway 𝒜 f hf hD) t

  have s2 : ∀ {σ A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ) [GradedRing 𝒜] (Y : Scheme.{u}) (j : Y ⟶ Proj 𝒜) (f g x : A) (e : ℕ) (hg : g ∈ 𝒜 e) (hx : x = f * g) (z : HomogeneousLocalization.Away 𝒜 f) (y : Y) (hy : y ∈ j ⁻¹ᵁ Proj.basicOpen 𝒜 f) (hy' : y ∈ j ⁻¹ᵁ Proj.basicOpen 𝒜 x), (Y.presheaf.germ _ y hy').hom ((j.app (Proj.basicOpen 𝒜 x)).hom ((Proj.awayToSection 𝒜 x).hom (HomogeneousLocalization.awayMap 𝒜 hg hx z))) = (Y.presheaf.germ _ y hy).hom ((j.app (Proj.basicOpen 𝒜 f)).hom ((Proj.awayToSection 𝒜 f).hom z)) := by
    intro σ A _ _ _ 𝒜 _ Y j f g x e hg hx z y hy hy'
    have h1 := congrArg (fun φ => φ.hom z) (Proj.awayMap_awayToSection 𝒜 hg hx)
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply] at h1
    have hle : Proj.basicOpen 𝒜 x ≤ Proj.basicOpen 𝒜 f := by
      rw [hx, Proj.basicOpen_mul]; exact inf_le_left
    have key : ∀ t, (j.app (Proj.basicOpen 𝒜 x)).hom (((Proj 𝒜).presheaf.map (homOfLE hle).op).hom t) =
        (Y.presheaf.map ((TopologicalSpace.Opens.map j.base).map (homOfLE hle)).op).hom
          ((j.app (Proj.basicOpen 𝒜 f)).hom t) := fun t => by
      have := congrArg (fun φ => φ.hom t) (Scheme.Hom.naturality j (homOfLE hle).op)
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
      exact this
    rw [h1, key]
    exact TopCat.Presheaf.germ_res_apply Y.presheaf _ y hy' _

  have s3 : ∀ {σ A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ) [GradedRing 𝒜] (f g x h F T : A) (D e d' r p ρ c : ℕ) (hf : f ∈ 𝒜 D) (hh : h ∈ 𝒜 D) (hF : F ∈ 𝒜 (ρ • D)) (hg : g ∈ 𝒜 e) (hx : x = f * g) (hxd : x ∈ 𝒜 d') (hT : T ∈ 𝒜 (1 • d')), g = f ^ (ρ + c) → ρ + c + 1 = r * p → T = h ^ (r * p) + F * f ^ (c + 1) → HomogeneousLocalization.awayMap 𝒜 hg hx ((HomogeneousLocalization.Away.mk 𝒜 hf r (h ^ r) (SetLike.pow_mem_graded r hh)) ^ p + HomogeneousLocalization.Away.mk 𝒜 hf ρ F hF) = HomogeneousLocalization.Away.mk 𝒜 hxd 1 T hT := by
    intro σ A _ _ _ 𝒜 _ f g x h F T D e d' r p ρ c hf hh hF hg hx hxd hT hge hM hTe
    apply HomogeneousLocalization.val_injective
    rw [map_add, map_pow, HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk]
    simp only [HomogeneousLocalization.val_add, HomogeneousLocalization.val_pow,
      HomogeneousLocalization.Away.val_mk]
    rw [Localization.mk_pow, Localization.add_mk, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    refine ⟨1, ?_⟩
    simp only [OneMemClass.coe_one, one_mul, Submonoid.coe_mul, SubmonoidClass.coe_pow]
    subst hx hTe
    simp only [mul_pow, ← pow_mul]
    rw [← hM]
    subst hge
    ring

  have s4 : ∀ {σ A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ) [GradedRing 𝒜] (n M : ℕ) (θ Θ : Fin (n + 1) → A) (F : Fin n → A) (c : Fin n → ℕ) (x : Proj 𝒜), Θ 0 = θ 0 ^ M → (∀ l : Fin n, Θ l.succ = θ l.succ ^ M + F l * θ 0 ^ (c l + 1)) → (∃ i, x ∈ Proj.basicOpen 𝒜 (θ i)) → ∃ i, x ∈ Proj.basicOpen 𝒜 (Θ i) := by
    intro σ A _ _ _ 𝒜 _ n M θ Θ F c x h0 hs hx
    by_contra hcon
    obtain ⟨i₀, hi₀⟩ := hx
    have hP := x.isPrime
    have hmem : ∀ i, Θ i ∈ x.asHomogeneousIdeal.toIdeal := by
      intro i
      by_contra hi
      exact hcon ⟨i, (Proj.mem_basicOpen 𝒜 (Θ i) x).mpr hi⟩
    have hf0 : θ 0 ∈ x.asHomogeneousIdeal.toIdeal := by
      apply hP.mem_of_pow_mem M
      rw [← h0]; exact hmem 0
    have hall : ∀ i, θ i ∈ x.asHomogeneousIdeal.toIdeal := by
      intro i
      refine Fin.cases hf0 (fun l => ?_) i
      apply hP.mem_of_pow_mem M
      have e1 : F l * θ 0 ^ (c l + 1) ∈ x.asHomogeneousIdeal.toIdeal := by
        apply Ideal.mul_mem_left
        rw [pow_succ]
        exact Ideal.mul_mem_left _ _ hf0
      have e2 := Ideal.sub_mem _ (hmem l.succ) e1
      rwa [hs l, add_sub_cancel_right] at e2
    rw [Proj.mem_basicOpen] at hi₀
    exact hi₀ (hall i₀)

  intro k _ N n D p Y j θ hj hD hp hθ hcov s
  classical
  letI gN := @MvPolynomial.gradedAlgebra (Fin (N + 1)) k _
  have hθm : ∀ i, θ i ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k D :=
    fun i => (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (hθ i)
  have hlift := fun l => s1 (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) Y j (θ 0) D (hθm 0)
    hj hD (s l)
  choose ρ F hF hs using hlift
  obtain ⟨r, hr⟩ : ∃ r : ℕ, r = (∑ l, ρ l) + 1 := ⟨_, rfl⟩
  obtain ⟨M, hM⟩ : ∃ M : ℕ, M = r * p := ⟨_, rfl⟩
  have hρle : ∀ l, ρ l ≤ ∑ l, ρ l := fun l =>
    Finset.single_le_sum (f := ρ) (fun i _ => Nat.zero_le _) (Finset.mem_univ l)
  have hrM : r ≤ M := by rw [hM]; exact Nat.le_mul_of_pos_right r (by omega)
  have hMpos : 0 < M := by omega
  obtain ⟨c, hc⟩ : ∃ c : Fin n → ℕ, ∀ l, ρ l + c l + 1 = M :=
    ⟨fun l => M - (ρ l + 1), fun l => by
      show ρ l + (M - (ρ l + 1)) + 1 = M
      have := hρle l; omega⟩
  obtain ⟨Θ, hΘ0, hΘs⟩ : ∃ Θ : Fin (n + 1) → MvPolynomial (Fin (N + 1)) k, Θ 0 = θ 0 ^ M ∧
      ∀ l, Θ l.succ = θ l.succ ^ M + F l * θ 0 ^ (c l + 1) :=
    ⟨Fin.cons (θ 0 ^ M) (fun l => θ l.succ ^ M + F l * θ 0 ^ (c l + 1)), Fin.cons_zero _ _,
      fun l => Fin.cons_succ _ _ _⟩
  have hΘ : ∀ i, Θ i ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k (M * D) := by
    intro i
    rw [MvPolynomial.mem_homogeneousSubmodule]
    refine Fin.cases ?_ (fun l => ?_) i
    · rw [hΘ0]
      have := (hθ 0).pow M
      rwa [mul_comm] at this
    · rw [hΘs l]
      have hFl : (F l).IsHomogeneous (ρ l * D) := by
        have := hF l
        rwa [MvPolynomial.mem_homogeneousSubmodule, smul_eq_mul] at this
      have h1 : (θ l.succ ^ M).IsHomogeneous (M * D) := by
        have := (hθ l.succ).pow M
        rwa [mul_comm] at this
      have h2 : (F l * θ 0 ^ (c l + 1)).IsHomogeneous (M * D) := by
        have := hFl.mul ((hθ 0).pow (c l + 1))
        have e : ρ l * D + D * (c l + 1) = M * D := by rw [← hc l]; ring
        rwa [e] at this
      exact h1.add h2
  obtain ⟨a, ha⟩ : ∃ a : Fin n → Γ(Y, j ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra (θ 0)),
      ∀ l, a l = (j.app _).hom ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
        (θ 0)).hom (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
          (hθm 0) r (θ l.succ ^ r) (SetLike.pow_mem_graded r (hθm l.succ)))) := ⟨_, fun l => rfl⟩
  refine ⟨M * D, Θ, hΘ, a, Nat.mul_pos hMpos hD, fun y => s4 _ n M θ Θ F c (j y) hΘ0 hΘs (hcov y),
    ?_, ?_⟩
  · rw [hΘ0]
    exact Proj.basicOpen_pow _ _ _ hMpos
  · intro l y hy hy'
    have hg : θ 0 ^ (M - 1) ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k ((M - 1) • D) :=
      SetLike.pow_mem_graded (M - 1) (hθm 0)
    have hx : Θ 0 = θ 0 * θ 0 ^ (M - 1) := by
      rw [hΘ0, ← pow_succ']
      congr 1
      omega
    have hge : θ 0 ^ (M - 1) = θ 0 ^ (ρ l + c l) := by
      congr 1
      have := hc l
      omega
    have hTe : Θ l.succ = θ l.succ ^ (r * p) + F l * θ 0 ^ (c l + 1) := by
      rw [hΘs l, hM]
    have e3 := s3 (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (θ 0) (θ 0 ^ (M - 1)) (Θ 0)
      (θ l.succ) (F l) (Θ l.succ) D ((M - 1) • D) (M * D) r p (ρ l) (c l) (hθm 0) (hθm l.succ) (hF l)
      hg hx (hΘ 0) (by rw [one_smul]; exact hΘ l.succ) hge (by rw [hc l, hM]) hTe
    rw [← e3, s2 (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) Y j (θ 0) (θ 0 ^ (M - 1)) (Θ 0)
      ((M - 1) • D) hg hx _ y hy hy']
    congr 1
    rw [map_add, map_add, map_pow, map_pow, hs l, ha l]

theorem wcpa_dj_gsgp_gen_etale_proj : ∀ (k : Type u) [Field k] [Finite k] (Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral Y] (sY : Y ⟶ Spec (.of k)) (n : ℕ), wcpaDjIsProjOver k sY → topologicalKrullDim Y = (n : WithBot ℕ∞) → ∃ (π : Y ⟶ wcProjK k n) (W : Y.Opens), W ≠ ⊥ ∧ IsFinite π ∧ π ≫ wcProjKStr k n = sY ∧ Etale (W.ι ≫ π) :=
by

  have c11 : ∀ (k A B K : Type u) [Field k] [CommRing A] [CommRing B] [IsDomain B] [Field K] [Algebra k A] [Algebra k B] [Algebra B K] [IsFractionRing B K] [Algebra k K] [IsScalarTower k B K] (φ : A →ₐ[k] B) (m : ℕ) (a : Fin m → A), (φ : A →+* B).Finite → Algebra.adjoin k (Set.range a) = ⊤ → Algebra.IsAlgebraic (IntermediateField.adjoin k (Set.range fun l => algebraMap B K (φ (a l)))) K := by
    intro k A B K _ _ _ _ _ _ _ _ _ _ _ φ m a hfin hgen
    set E := IntermediateField.adjoin k (Set.range fun l => algebraMap B K (φ (a l))) with hE
    let ψ : A →ₐ[k] K := (IsScalarTower.toAlgHom k B K).comp φ
    have hrange : ∀ x : A, ψ x ∈ E := by
      intro x
      have hx : x ∈ Algebra.adjoin k (Set.range a) := hgen ▸ Algebra.mem_top
      have h1 : ψ x ∈ (Algebra.adjoin k (Set.range a)).map ψ := ⟨x, hx, rfl⟩
      rw [AlgHom.map_adjoin, ← Set.range_comp] at h1
      exact IntermediateField.algebra_adjoin_le_adjoin k _ h1
    letI : Algebra A E := (ψ.toRingHom.codRestrict E hrange).toAlgebra
    letI : Algebra A K := ψ.toRingHom.toAlgebra
    haveI : IsScalarTower A E K := IsScalarTower.of_algebraMap_eq (fun x => rfl)
    have hint : ∀ b : B, IsIntegral E (algebraMap B K b) := by
      intro b
      obtain ⟨p, hp, hpb⟩ := hfin.to_isIntegral b
      have hA : IsIntegral A (algebraMap B K b) := by
        refine ⟨p, hp, ?_⟩
        have := Polynomial.hom_eval₂ p (φ : A →+* B) (algebraMap B K) b
        rw [hpb, map_zero] at this
        exact this.symm
      exact hA.tower_top
    constructor
    intro z
    obtain ⟨x, y, _, rfl⟩ := IsFractionRing.div_surjective (A := B) z
    rw [div_eq_mul_inv]
    exact ((hint x).isAlgebraic).mul ((hint y).isAlgebraic).inv

  have c5 : ∀ (k A B K : Type u) [Field k] [CommRing A] [CommRing B] [IsDomain B] [Field K] [Algebra k A] [Algebra k B] [Algebra B K] [IsFractionRing B K] [Algebra k K] [IsScalarTower k B K] (φ : A →ₐ[k] B) (n : ℕ) (a : Fin n → A), (φ : A →+* B).FiniteType → Algebra.adjoin k (Set.range a) = ⊤ → Algebra.IsSeparable (IntermediateField.adjoin k (Set.range fun l => algebraMap B K (φ (a l)))) K → ∃ b : B, b ≠ 0 ∧ ((algebraMap B (Localization.Away b)).comp (φ : A →+* B)).FormallyUnramified := by
    intro k A B K _ _ _ _ _ _ _ _ _ _ _ φ n a hft hgen hsep
    set E := IntermediateField.adjoin k (Set.range fun l => algebraMap B K (φ (a l))) with hE
    let ψ : A →ₐ[k] K := (IsScalarTower.toAlgHom k B K).comp φ
    have hadj : (Algebra.adjoin k (Set.range a)).map ψ =
        Algebra.adjoin k (Set.range fun l => algebraMap B K (φ (a l))) := by
      rw [AlgHom.map_adjoin, ← Set.range_comp]; rfl
    have hrange : ∀ x : A, ψ x ∈ E := by
      intro x
      have hx : x ∈ Algebra.adjoin k (Set.range a) := hgen ▸ Algebra.mem_top
      have h1 : ψ x ∈ (Algebra.adjoin k (Set.range a)).map ψ := ⟨x, hx, rfl⟩
      rw [hadj] at h1
      exact IntermediateField.algebra_adjoin_le_adjoin k _ h1
    let f : A →+* E := ψ.toRingHom.codRestrict E hrange
    letI iAE : Algebra A E := f.toAlgebra
    letI iAK : Algebra A K := ψ.toRingHom.toAlgebra
    haveI : IsScalarTower A E K := IsScalarTower.of_algebraMap_eq (fun x => rfl)
    let R : Subring E := f.range
    letI iAR : Algebra A R := f.rangeRestrict.toAlgebra
    haveI : IsScalarTower A R E := IsScalarTower.of_algebraMap_eq (fun x => rfl)
    haveI hRE : IsFractionRing R E := by
      haveI : FaithfulSMul R E :=
        (faithfulSMul_iff_algebraMap_injective R E).mpr Subtype.val_injective
      refine IsFractionRing.of_field R E (fun z => ?_)
      have hz : (z : K) ∈ IntermediateField.adjoin k (Set.range fun l => algebraMap B K (φ (a l))) := z.2
      obtain ⟨r, hr, s, hs, hrs⟩ := IntermediateField.mem_adjoin_iff_div.mp hz
      rw [← hadj] at hr hs
      obtain ⟨x, -, rfl⟩ := hr
      obtain ⟨y, -, rfl⟩ := hs
      refine ⟨⟨f x, x, rfl⟩, ⟨f y, y, rfl⟩, ?_⟩
      apply Subtype.ext
      simp only [IntermediateField.coe_div]
      exact hrs
    have hAR : Algebra.FormallyUnramified A R :=
      Algebra.FormallyUnramified.of_surjective (Algebra.ofId A R) f.rangeRestrict_surjective
    have hRE' : Algebra.FormallyUnramified R E :=
      Algebra.FormallyUnramified.of_isLocalization (nonZeroDivisors R)
    have hAE : Algebra.FormallyUnramified A E := Algebra.FormallyUnramified.comp A R E
    have hEK : Algebra.FormallyUnramified E K := Algebra.FormallyUnramified.of_isSeparable E K
    have hAK : Algebra.FormallyUnramified A K := Algebra.FormallyUnramified.comp A E K
    letI iAB : Algebra A B := (φ : A →+* B).toAlgebra
    haveI : IsScalarTower A B K := IsScalarTower.of_algebraMap_eq (fun x => rfl)
    haveI : IsLocalization (⊥ : Ideal B).primeCompl K := by
      rw [Ideal.primeCompl_bot]; infer_instance
    let e : K ≃ₐ[B] Localization.AtPrime (⊥ : Ideal B) :=
      IsLocalization.algEquiv (⊥ : Ideal B).primeCompl K (Localization.AtPrime (⊥ : Ideal B))
    have hloc : Algebra.FormallyUnramified A (Localization.AtPrime (⊥ : Ideal B)) :=
      Algebra.FormallyUnramified.of_equiv (e.restrictScalars A)
    have hmem : (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum B) ∈ Algebra.unramifiedLocus A B := hloc
    haveI : Algebra.FiniteType A B := hft
    haveI : Algebra.EssFiniteType A B := Algebra.EssFiniteType.of_finiteType A B
    obtain ⟨_, ⟨b, rfl⟩, hxb, hsub⟩ :=
      PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open
        hmem Algebra.isOpen_unramifiedLocus
    refine ⟨b, fun hb => ?_, ?_⟩
    · rw [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen] at hxb
      exact hxb (by rw [hb]; exact Submodule.zero_mem _)
    · have h := (Algebra.basicOpen_subset_unramifiedLocus_iff (R := A) (A := B) (f := b)).mp hsub
      have e2 : (algebraMap B (Localization.Away b)).comp (φ : A →+* B) =
          algebraMap A (Localization.Away b) :=
        (IsScalarTower.algebraMap_eq A B (Localization.Away b)).symm
      rw [e2]
      exact RingHom.formallyUnramified_algebraMap.mpr h

  have c9 : ∀ {Y P : Scheme.{u}} (π : Y ⟶ P) (V : P.Opens), IsAffineOpen V → IsAffineOpen (π ⁻¹ᵁ V) → ∀ b : Γ(Y, π ⁻¹ᵁ V), ((algebraMap Γ(Y, π ⁻¹ᵁ V) (Localization.Away b)).comp (π.app V).hom).FormallyUnramified → FormallyUnramified ((Y.basicOpen b).ι ≫ π) := by
    intro Y P π V hV hU b hb
    have hW : IsAffineOpen (Y.basicOpen b) := hU.basicOpen b
    have e : Y.basicOpen b ≤ π ⁻¹ᵁ V := Y.basicOpen_le b
    haveI := hU.isLocalization_basicOpen b
    let eq := IsLocalization.algEquiv (Submonoid.powers b) (Localization.Away b) Γ(Y, Y.basicOpen b)
    have hring : RingHom.FormallyUnramified (π.appLE V (Y.basicOpen b) e).hom := by
      have h1 : (π.appLE V (Y.basicOpen b) e).hom =
          (eq.toRingHom : Localization.Away b →+* Γ(Y, Y.basicOpen b)).comp
            ((algebraMap Γ(Y, π ⁻¹ᵁ V) (Localization.Away b)).comp (π.app V).hom) := by
        rw [← RingHom.comp_assoc]
        have h2 : (eq.toRingHom : Localization.Away b →+* Γ(Y, Y.basicOpen b)).comp
            (algebraMap Γ(Y, π ⁻¹ᵁ V) (Localization.Away b)) =
            algebraMap Γ(Y, π ⁻¹ᵁ V) Γ(Y, Y.basicOpen b) := by
          ext x
          exact eq.commutes x
        rw [h2, Scheme.Hom.appLE]
        rfl
      rw [h1]
      exact RingHom.FormallyUnramified.comp hb
        (RingHom.FormallyUnramified.of_surjective eq.surjective)
