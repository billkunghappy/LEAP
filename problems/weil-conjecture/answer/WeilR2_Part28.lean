      (perfectClosure (FractionRing A) (AlgebraicClosure (FractionRing A)))
      (TensorProduct (FractionRing A)
          (perfectClosure (FractionRing A) (AlgebraicClosure (FractionRing A)))
          (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)))) hN hd
    have hk := wcfd_tn_formallySmooth_descent_field (FractionRing A)
      (perfectClosure (FractionRing A) (AlgebraicClosure (FractionRing A)))
      (Localization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))) hsm
    exact wcfd_tn_stalk_of_generic_smooth A B hk Q hQ

  intro K _ S X fS _ _ g _ HCHART
  classical
  obtain ⟨V, hVaff, hηV, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    (Scheme.isBasis_affineOpens S)) (show genericPoint S ∈ (⊤ : S.Opens) from trivial)
  have hV : IsAffineOpen V := hVaff
  haveI : Nonempty V := ⟨⟨genericPoint S, hηV⟩⟩
  have hleK : V ≤ fS ⁻¹ᵁ ⊤ := by simp
  have hκft : ((Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ fS.appLE ⊤ V hleK).hom.FiniteType := by
    rw [CommRingCat.hom_comp]
    refine RingHom.FiniteType.comp ?_ ?_
    · exact HasRingHomProperty.appLE @LocallyOfFiniteType fS inferInstance
        ⟨⊤, isAffineOpen_top _⟩ ⟨V, hV⟩ hleK
    · apply RingHom.FiniteType.of_surjective
      intro y
      exact ⟨(Scheme.ΓSpecIso (CommRingCat.of K)).hom y, by simp⟩
  have key : ∀ U : X.Opens, ∃ e₀ : ℕ, IsAffineOpen U → ∀ hUV : U ≤ g ⁻¹ᵁ V, ∀ e : ℕ, e₀ ≤ e →
      ∀ (φ : Γ(S, V) ⟶ Γ(S, V)), (∀ a : Γ(S, V), φ.hom a = a ^ (ringExpChar K ^ e)) →
      ∀ (C : CommRingCat.{u}) (γ : Γ(X, U) ⟶ C) (β : Γ(S, V) ⟶ C),
      IsPushout (g.appLE V U hUV) φ γ β →
      ∀ (C' : CommRingCat.{u}) (ρ : C ⟶ C'), Function.Surjective ρ.hom →
      RingHom.ker ρ.hom = nilradical C →
      ∀ (B : CommRingCat.{u}) (ι : C' ⟶ B), Function.Injective ι.hom → ι.hom.Finite →
      (∀ (Q : Ideal B) [Q.IsPrime], IsDomain (Localization.AtPrime Q) ∧
        IsIntegrallyClosed (Localization.AtPrime Q)) →
      (∃ f : C', f ∈ nonZeroDivisors C' ∧ ι.hom f ∈ nonZeroDivisors B ∧
        Function.Bijective (Localization.awayMap ι.hom f)) →
      ∀ (τ : Γ(S, V) ⟶ B), τ = β ≫ ρ ≫ ι → ∀ (Q : Ideal B) [Q.IsPrime]
      (hQ : (⊥ : Ideal Γ(S, V)) = Q.comap τ.hom),
      (Localization.localRingHom ⊥ Q τ.hom hQ).FormallySmooth := by
    intro U
    by_cases hU : IsAffineOpen U ∧ U ≤ g ⁻¹ᵁ V
    · obtain ⟨hUa, hUV⟩ := hU
      have hαft : (g.appLE V U hUV).hom.FiniteType :=
        HasRingHomProperty.appLE @LocallyOfFiniteType g inferInstance ⟨V, hV⟩ ⟨U, hUa⟩ hUV
      have hdim := HCHART V hV U hUa hUV
      obtain ⟨e₀, he₀⟩ := algK K Γ(S, V) Γ(X, U)
        ((Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ fS.appLE ⊤ V hleK) (g.appLE V U hUV)
        hκft hαft hdim
      exact ⟨e₀, fun _ _ => he₀⟩
    · exact ⟨0, fun hUa hUV => absurd ⟨hUa, hUV⟩ hU⟩
  choose E hE using key
  have hcpt : IsCompact ((g ⁻¹ᵁ V : X.Opens) : Set X) :=
    QuasiCompact.isCompact_preimage (V : Set S) V.isOpen hV.isCompact
  obtain ⟨s, hs, hcov⟩ := isCompact_iff_finite_and_eq_biUnion_affineOpens.mp hcpt
  refine ⟨hs.toFinset.sup (fun i => E i.1), ?_⟩
  intro e he Φ hΦfin hΦid hΦpow R r hr hrsurj hRred Xt b Z iZ hbfin hiZ hiso hnorm hZgen hdense x hx
  haveI := hΦfin
  haveI := hr
  haveI := hRred
  haveI := hbfin
  haveI := hiZ
  have hVV : V ≤ Φ ⁻¹ᵁ V := by
    intro z hz
    exact (Scheme.Hom.mem_preimage Φ).mpr (by rw [hΦid z]; exact hz)
  have hsnd : Limits.pullback.snd g Φ (r (b x)) = genericPoint S := hx
  have hc : (Limits.pullback.fst g Φ ≫ g) (r (b x)) = (Limits.pullback.snd g Φ ≫ Φ) (r (b x)) := by
    rw [Limits.pullback.condition]
  rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hsnd, hΦid] at hc
  have hy : Limits.pullback.fst g Φ (r (b x)) ∈ g ⁻¹ᵁ V :=
    (Scheme.Hom.mem_preimage g).mpr (by rw [hc]; exact hηV)
  have hy' : Limits.pullback.fst g Φ (r (b x)) ∈ (⨆ i ∈ s, (i : X.Opens)) := by
    rw [← hcov]; exact hy
  simp only [TopologicalSpace.Opens.mem_iSup] at hy'
  obtain ⟨i, hi, hyi⟩ := hy'
  have hiV : (i : X.Opens) ≤ g ⁻¹ᵁ V := by
    rw [hcov]
    exact le_iSup₂ (f := fun (j : X.affineOpens) (_ : j ∈ s) => (j : X.Opens)) i hi
  have heE : E i.1 ≤ hs.toFinset.sup (fun i => E i.1) :=
    Finset.le_sup (f := fun i => E i.1) (hs.mem_toFinset.mpr hi)
  obtain ⟨hUPaff, hpush⟩ := wcfd_gst_twist_chart_ring S X g Φ V hV hVV i.1 i.2 hiV
  obtain ⟨hURaff, hρsurj, hρker⟩ := wcfd_gst_reduced_chart_ring _ R r hrsurj
    (Limits.pullback.fst g Φ ⁻¹ᵁ i.1 ⊓ Limits.pullback.snd g Φ ⁻¹ᵁ V) hUPaff
  haveI : IsLocallyNoetherian R :=
    LocallyOfFiniteType.isLocallyNoetherian (r ≫ Limits.pullback.snd g Φ ≫ fS)
  obtain ⟨hWaff, hιinj, hιfin, hBnorm, hN3⟩ := wcfd_gst_normalization_chart R Xt Z b iZ hiso
    hnorm hZgen hdense
    (r ⁻¹ᵁ (Limits.pullback.fst g Φ ⁻¹ᵁ i.1 ⊓ Limits.pullback.snd g Φ ⁻¹ᵁ V)) hURaff
  have hWV : b ⁻¹ᵁ (r ⁻¹ᵁ (Limits.pullback.fst g Φ ⁻¹ᵁ i.1 ⊓ Limits.pullback.snd g Φ ⁻¹ᵁ V)) ≤
      (b ≫ r ≫ Limits.pullback.snd g Φ) ⁻¹ᵁ V := fun z hz => hz.2
  have hxW : x ∈ b ⁻¹ᵁ (r ⁻¹ᵁ (Limits.pullback.fst g Φ ⁻¹ᵁ i.1 ⊓
      Limits.pullback.snd g Φ ⁻¹ᵁ V)) :=
    ⟨hyi, (Scheme.Hom.mem_preimage _).mpr (by rw [hsnd]; exact hηV)⟩
  obtain ⟨Q, hQp, hQ, hiff⟩ := wcfd_gst_stalk_as_localization S Xt
    (b ≫ r ≫ Limits.pullback.snd g Φ) V hV _ hWaff hWV x hxW hx
  haveI := hQp
  rw [hiff]
  have hτ : (b ≫ r ≫ Limits.pullback.snd g Φ).appLE V _ hWV =
      (Limits.pullback.snd g Φ).appLE V
        (Limits.pullback.fst g Φ ⁻¹ᵁ i.1 ⊓ Limits.pullback.snd g Φ ⁻¹ᵁ V) inf_le_right ≫
      r.appLE _ _ le_rfl ≫ b.appLE _ _ le_rfl := by
    rw [Scheme.Hom.appLE_comp_appLE, Scheme.Hom.appLE_comp_appLE]
    simp only [Category.assoc]
  exact hE i.1 i.2 hiV _ (le_trans heE he) (Φ.appLE V V hVV) (fun a => hΦpow V hVV a) _ _ _ hpush _ _
    hρsurj hρker _ _ hιinj hιfin hBnorm hN3 _ hτ Q hQ

theorem wcpa_dj_cf_ss_restrict_of_charts : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (n : ℕ) (U : Y.Opens),
    (∀ x : X, f x ∈ U → ∃ (U' : Y.Opens) (_ : IsAffineOpen U') (V' : X.Opens) (_ : IsAffineOpen V')
      (_ : x ∈ V') (e : V' ≤ f ⁻¹ᵁ U'),
      RingHom.IsStandardSmoothOfRelativeDimension n (f.appLE U' V' e).hom) →
    SmoothOfRelativeDimension n (f ∣_ U) :=
by
  intro X Y f n U hyp
  constructor
  intro y
  have hfx : f y.1 ∈ U := y.2
  obtain ⟨U', hU', V', hV', hxV', e, hstd⟩ := hyp y.1 hfx
  have hfxU' : f y.1 ∈ U' := e hxV'
  obtain ⟨a, haU, hfxa⟩ := hU'.exists_basicOpen_le (V := U ⊓ U') ⟨f y.1, hfx, hfxU'⟩ hfxU'
  have hV''eq : X.basicOpen (f.appLE U' V' e a) = V' ⊓ f ⁻¹ᵁ Y.basicOpen a :=
    Scheme.basicOpen_appLE f V' U' e a
  have e'' : X.basicOpen (f.appLE U' V' e a) ≤ f ⁻¹ᵁ Y.basicOpen a :=
    hV''eq.le.trans inf_le_right
  have hxV'' : y.1 ∈ X.basicOpen (f.appLE U' V' e a) := by
    rw [hV''eq]; exact ⟨hxV', hfxa⟩
  have hstd'' : RingHom.IsStandardSmoothOfRelativeDimension n
      (f.appLE (Y.basicOpen a) (X.basicOpen (f.appLE U' V' e a)) e'').hom := by
    rw [IsAffineOpen.appLE_eq_away_map f hU' hV' e a, CommRingCat.hom_ofHom]
    have := hU'.isLocalization_basicOpen a
    have := hV'.isLocalization_basicOpen (f.appLE U' V' e a)
    exact (RingHom.isStandardSmoothOfRelativeDimension_localizationPreserves n).away _ a _ _ hstd
  have hle : Y.basicOpen a ≤ U := haU.trans inf_le_left
  have hV''U : X.basicOpen (f.appLE U' V' e a) ≤ f ⁻¹ᵁ U := fun z hz => hle (e'' hz)
  have hWV : (f ⁻¹ᵁ U).ι ⁻¹ᵁ X.basicOpen (f.appLE U' V' e a) ≤
      (f ∣_ U) ⁻¹ᵁ (U.ι ⁻¹ᵁ Y.basicOpen a) := by
    intro w hw
    have hw' : (f ⁻¹ᵁ U).ι w ∈ X.basicOpen (f.appLE U' V' e a) := hw
    have key : U.ι ((f ∣_ U) w) = f ((f ⁻¹ᵁ U).ι w) := by
      rw [← Scheme.Hom.comp_apply, morphismRestrict_ι, Scheme.Hom.comp_apply]
    show U.ι ((f ∣_ U) w) ∈ Y.basicOpen a
    rw [key]; exact e'' hw'
  refine ⟨U.ι ⁻¹ᵁ Y.basicOpen a,
    (hU'.basicOpen a).preimage_of_isOpenImmersion U.ι
      (by rw [Scheme.Opens.opensRange_ι]; exact hle),
    (f ⁻¹ᵁ U).ι ⁻¹ᵁ X.basicOpen (f.appLE U' V' e a),
    (hV'.basicOpen (f.appLE U' V' e a)).preimage_of_isOpenImmersion _
      (by rw [Scheme.Opens.opensRange_ι]; exact hV''U), ?_, hWV, ?_⟩
  · show (f ⁻¹ᵁ U).ι y ∈ X.basicOpen (f.appLE U' V' e a)
    have hy : (f ⁻¹ᵁ U).ι y = y.1 := Scheme.Opens.ι_apply _ y
    rw [hy]; exact hxV''
  · rw [morphismRestrict_appLE]
    have h₁ : U.ι ''ᵁ (U.ι ⁻¹ᵁ Y.basicOpen a) = Y.basicOpen a := by
      rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
      exact inf_eq_right.mpr hle
    have h₂ : (f ⁻¹ᵁ U).ι ''ᵁ ((f ⁻¹ᵁ U).ι ⁻¹ᵁ X.basicOpen (f.appLE U' V' e a)) =
        X.basicOpen (f.appLE U' V' e a) := by
      rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
      exact inf_eq_right.mpr hV''U
    exact (Scheme.Hom.appLE_congr f _ h₁ h₂
      (fun g => RingHom.IsStandardSmoothOfRelativeDimension n g.hom)).mpr hstd''

theorem wcpa_dj_sgs_etale_poly_trdeg : ∀ (A B : Type u) [CommRing A] [IsDomain A] [CommRing B] [IsDomain B] (n : ℕ) (g : MvPolynomial (Fin n) A →+* B), g.Etale → letI : Algebra A B := (g.comp MvPolynomial.C).toAlgebra; Algebra.trdeg A B = n :=
by
  intro A B _ _ _ _ n g hg
  have hinj : ∀ (R S : Type u) [CommRing R] [IsDomain R] [CommRing S] [Nontrivial S]
      (f : R →+* S), f.Etale → Function.Injective f := by
    intro R S _ _ _ _ f hf
    letI := f.toAlgebra
    haveI : Algebra.Etale R S := hf
    rw [injective_iff_map_eq_zero]
    intro r hr
    by_contra h0
    have hreg := Module.Flat.isSMulRegular_of_nonZeroDivisors (M := S)
      (mem_nonZeroDivisors_of_ne_zero h0)
    apply one_ne_zero (α := S)
    apply hreg
    show r • (1 : S) = r • (0 : S)
    rw [Algebra.smul_def, Algebra.smul_def]
    show f r * 1 = f r * 0
    rw [hr, zero_mul, zero_mul]
  have halg : ∀ (R S : Type u) [CommRing R] [IsDomain R] [CommRing S] (f : R →+* S),
      f.Etale → letI := f.toAlgebra; Algebra.IsAlgebraic R S := by
    intro R S _ _ _ f hf
    letI := f.toAlgebra
    haveI : Algebra.Etale R S := hf
    haveI : Algebra.Etale (FractionRing R) (TensorProduct R (FractionRing R) S) := inferInstance
    haveI : Module.Finite (FractionRing R) (TensorProduct R (FractionRing R) S) :=
      Algebra.FormallyUnramified.finite_of_free _ _
    haveI : Algebra.IsAlgebraic (FractionRing R) (TensorProduct R (FractionRing R) S) :=
      Algebra.IsAlgebraic.of_finite _ _
    haveI : Algebra.IsAlgebraic R (TensorProduct R (FractionRing R) S) :=
      (IsFractionRing.comap_isAlgebraic_iff (K := FractionRing R)).mpr inferInstance
    exact Algebra.IsAlgebraic.of_injective
      (Algebra.TensorProduct.includeRight (R := R) (A := FractionRing R) (B := S))
      (Algebra.TensorProduct.includeRight_injective (IsFractionRing.injective R (FractionRing R)))
  letI : Algebra A B := (g.comp MvPolynomial.C).toAlgebra
  letI : Algebra (MvPolynomial (Fin n) A) B := g.toAlgebra
  haveI : IsScalarTower A (MvPolynomial (Fin n) A) B := IsScalarTower.of_algebraMap_eq' rfl
  haveI : FaithfulSMul (MvPolynomial (Fin n) A) B :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr (hinj _ _ g hg)
  haveI : FaithfulSMul A (MvPolynomial (Fin n) A) :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr (MvPolynomial.C_injective _ _)
  haveI : Algebra.IsAlgebraic (MvPolynomial (Fin n) A) B := halg _ _ g hg
  have h0 : Algebra.trdeg (MvPolynomial (Fin n) A) B = 0 := trdeg_eq_zero_iff.mpr inferInstance
  have hadd := trdeg_add_eq A (MvPolynomial (Fin n) A) (A := B)
  rw [MvPolynomial.trdeg_of_isDomain, h0, add_zero, Cardinal.mk_fin,
    Cardinal.lift_natCast] at hadd
  exact hadd.symm

theorem wcpa_dj_sgs_affine_trdeg : ∀ (k : Type u) [Field k] (X : Scheme.{u}) [AlgebraicGeometry.IsIntegral X] (s : X ⟶ Spec (.of k)) [IsProper s] (n : ℕ), topologicalKrullDim X = (n : WithBot ℕ∞) → ∀ (U : X.Opens), IsAffineOpen U → (U : Set X).Nonempty → letI : Algebra k Γ(X, U) := ((Scheme.ΓSpecIso (.of k)).inv ≫ s.appTop ≫ X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.toAlgebra; Algebra.trdeg k Γ(X, U) = n :=
by
  intro k _ X _ s _ n hdim U hU hne
  obtain ⟨x, hx⟩ := hne
  haveI : Nonempty U := ⟨⟨x, hx⟩⟩
  haveI : IsDomain Γ(X, U) := IsIntegral.component_integral U
  letI ikA : Algebra k Γ(X, U) := ((Scheme.ΓSpecIso (.of k)).inv ≫ s.appTop ≫
    X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.toAlgebra
  show Algebra.trdeg k Γ(X, U) = n
  obtain ⟨-, m, t, ht, hm⟩ := wcpa_dj_cf_sp_function_field_trdeg k X s
  have hmn : m = n := by
    have h := hm.symm.trans hdim
    exact_mod_cast h
  letI ikK : Algebra k X.functionField := ((Scheme.ΓSpecIso (.of k)).inv ≫
    s.appTop ≫ X.presheaf.germ ⊤ (genericPoint X) trivial).hom.toAlgebra
  have ht' : IsTranscendenceBasis k (t : Fin m → X.functionField) := ht
  have hK : Algebra.trdeg k X.functionField = n := by
    have h := ht'.lift_cardinalMk_eq_trdeg
    rw [Cardinal.mk_fin, Cardinal.lift_natCast, Cardinal.lift_uzero] at h
    rw [← h, hmn]
  haveI hfr : IsFractionRing Γ(X, U) X.functionField :=
    functionField_isFractionRing_of_isAffineOpen X U hU
  have hmor : ((Scheme.ΓSpecIso (.of k)).inv ≫ s.appTop ≫
      X.presheaf.germ ⊤ (genericPoint X) trivial) =
      ((Scheme.ΓSpecIso (.of k)).inv ≫ s.appTop ≫
        X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op) ≫ X.germToFunctionField U := by
    simp only [Category.assoc, Scheme.germToFunctionField, TopCat.Presheaf.germ_res]
  have htower : algebraMap k X.functionField =
      (algebraMap Γ(X, U) X.functionField).comp (algebraMap k Γ(X, U)) := by
    change ((Scheme.ΓSpecIso (.of k)).inv ≫ s.appTop ≫
      X.presheaf.germ ⊤ (genericPoint X) trivial).hom =
      (X.germToFunctionField U).hom.comp ((Scheme.ΓSpecIso (.of k)).inv ≫ s.appTop ≫
        X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom
    rw [← CommRingCat.hom_comp, hmor]
  haveI : IsScalarTower k Γ(X, U) X.functionField :=
    IsScalarTower.of_algebraMap_eq' htower
  haveI : FaithfulSMul k Γ(X, U) :=
    (faithfulSMul_iff_algebraMap_injective k Γ(X, U)).mpr (RingHom.injective _)
  haveI : FaithfulSMul Γ(X, U) X.functionField :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr (IsFractionRing.injective _ _)
  haveI : Algebra.IsAlgebraic Γ(X, U) X.functionField :=
    IsLocalization.isAlgebraic _ (nonZeroDivisors Γ(X, U))
  have h0 : Algebra.trdeg Γ(X, U) X.functionField = 0 := trdeg_eq_zero
  have hadd := trdeg_add_eq k Γ(X, U) (A := X.functionField)
  rw [h0, add_zero, hK] at hadd
  exact hadd

theorem wcpa_dj_sgs_appLE_injective : ∀ (Y S : Scheme.{u}) [AlgebraicGeometry.IsIntegral Y] [AlgebraicGeometry.IsIntegral S] (p : Y ⟶ S), p (genericPoint Y) = genericPoint S → ∀ (U : S.Opens) (V : Y.Opens) (e : V ≤ p ⁻¹ᵁ U), (V : Set Y).Nonempty → Function.Injective (p.appLE U V e).hom :=
by
  intro Y S _ _ p hgen U V e hV
  rw [injective_iff_map_eq_zero]
  intro s hs
  by_contra hs0
  have h := Scheme.basicOpen_appLE p V U e s
  have hs' : (p.appLE U V e) s = 0 := hs
  rw [hs', Scheme.basicOpen_zero] at h
  have hne : S.basicOpen s ≠ ⊥ := fun h' => hs0 ((basicOpen_eq_bot_iff s).mp h')
  obtain ⟨t, ht⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mp hne
  have hηS : genericPoint S ∈ (S.basicOpen s : Set S) :=
    (IsGenericPoint.mem_open_set_iff (genericPoint_spec S) (S.basicOpen s).isOpen).mpr
      ⟨t, trivial, ht⟩
  obtain ⟨v, hv⟩ := hV
  have hηV : genericPoint Y ∈ (V : Set Y) :=
    (IsGenericPoint.mem_open_set_iff (genericPoint_spec Y) V.isOpen).mpr ⟨v, trivial, hv⟩
  have hηP : genericPoint Y ∈ p ⁻¹ᵁ (S.basicOpen s) := by
    rw [Scheme.Hom.mem_preimage, hgen]
    exact hηS
  have hmem : genericPoint Y ∈ V ⊓ p ⁻¹ᵁ (S.basicOpen s) := ⟨hηV, hηP⟩
  rw [← h] at hmem
  exact hmem

theorem wcpa_dj_sgs_reldim_one : ∀ (k : Type u) [Field k] (Y S : Scheme.{u}) [AlgebraicGeometry.IsIntegral Y] [AlgebraicGeometry.IsIntegral S] (sS : S ⟶ Spec (.of k)) [IsProper sS] (p : Y ⟶ S) [IsProper p] (d : ℕ), topologicalKrullDim S = (d : WithBot ℕ∞) → topologicalKrullDim Y = ((d + 1 : ℕ) : WithBot ℕ∞) → p (genericPoint Y) = genericPoint S → ∀ W : S.Opens, Smooth (p ∣_ W) → SmoothOfRelativeDimension 1 (p ∣_ W) :=
by
  intro k _ Y S _ _ sS _ p _ d hS hY hgen W hW
  haveI := hW

  have key : ∀ (U' : S.Opens) (V' : Y.Opens) (e : V' ≤ p ⁻¹ᵁ U'), IsAffineOpen U' →
      IsAffineOpen V' → (V' : Set Y).Nonempty → (p.appLE U' V' e).hom.IsStandardSmooth →
      RingHom.IsStandardSmoothOfRelativeDimension 1 (p.appLE U' V' e).hom := by
    intro U' V' e hU' hV' hne hss
    obtain ⟨y, hy⟩ := hne
    have hpy : p y ∈ U' := e hy
    haveI : Nonempty V' := ⟨⟨y, hy⟩⟩
    haveI : Nonempty U' := ⟨⟨p y, hpy⟩⟩
    haveI : IsDomain Γ(Y, V') := IsIntegral.component_integral V'
    haveI : IsDomain Γ(S, U') := IsIntegral.component_integral U'
    have hinj := wcpa_dj_sgs_appLE_injective Y S p hgen U' V' e ⟨y, hy⟩
    have htow : ((Scheme.ΓSpecIso (.of k)).inv ≫ (p ≫ sS).appTop ≫
        Y.presheaf.map (homOfLE (le_top : V' ≤ ⊤)).op) =
        ((Scheme.ΓSpecIso (.of k)).inv ≫ sS.appTop ≫
          S.presheaf.map (homOfLE (le_top : U' ≤ ⊤)).op) ≫ p.appLE U' V' e := by
      rw [Scheme.Hom.comp_appTop]
      simp only [Category.assoc, Scheme.Hom.map_appLE]
      have hpt : p.appTop ≫ Y.presheaf.map (homOfLE (le_top : V' ≤ ⊤)).op =
          p.appLE ⊤ V' (fun _ _ => trivial) := rfl
      rw [hpt]
    have h3 := wcpa_dj_sgs_affine_trdeg k S sS d hS U' hU' ⟨p y, hpy⟩
    have h4 := wcpa_dj_sgs_affine_trdeg k Y (p ≫ sS) (d + 1) hY V' hV' ⟨y, hy⟩
    obtain ⟨φ, hφ⟩ : ∃ φ, φ = (p.appLE U' V' e).hom := ⟨_, rfl⟩
    rw [← hφ] at hss hinj ⊢
    obtain ⟨κA, hκA⟩ : ∃ κA, κA = ((Scheme.ΓSpecIso (.of k)).inv ≫ sS.appTop ≫
        S.presheaf.map (homOfLE (le_top : U' ≤ ⊤)).op).hom := ⟨_, rfl⟩
    obtain ⟨κB, hκB⟩ : ∃ κB, κB = ((Scheme.ΓSpecIso (.of k)).inv ≫ (p ≫ sS).appTop ≫
        Y.presheaf.map (homOfLE (le_top : V' ≤ ⊤)).op).hom := ⟨_, rfl⟩
    rw [← hκA] at h3
    rw [← hκB] at h4
    have hκ : κB = φ.comp κA := by
      rw [hκB, hκA, hφ, htow, CommRingCat.hom_comp]
    letI iAB : Algebra Γ(S, U') Γ(Y, V') := φ.toAlgebra
    letI ikA : Algebra k Γ(S, U') := κA.toAlgebra
    letI ikB : Algebra k Γ(Y, V') := κB.toAlgebra
    haveI : IsScalarTower k Γ(S, U') Γ(Y, V') := IsScalarTower.of_algebraMap_eq' hκ
    haveI : FaithfulSMul k Γ(S, U') :=
      (faithfulSMul_iff_algebraMap_injective k Γ(S, U')).mpr (RingHom.injective κA)
    haveI : FaithfulSMul Γ(S, U') Γ(Y, V') :=
      (faithfulSMul_iff_algebraMap_injective Γ(S, U') Γ(Y, V')).mpr hinj
    have hss' : Algebra.IsStandardSmooth Γ(S, U') Γ(Y, V') := hss
    obtain ⟨ι, σ, _, _, ⟨P⟩⟩ := hss'.out
    have hn : RingHom.IsStandardSmoothOfRelativeDimension P.dimension φ :=
      P.isStandardSmoothOfRelativeDimension rfl
    obtain ⟨g, hgC, hget⟩ := hn.exists_etale_mvPolynomial
    have h2 : Algebra.trdeg Γ(S, U') Γ(Y, V') = P.dimension := by
      have h := wcpa_dj_sgs_etale_poly_trdeg Γ(S, U') Γ(Y, V') P.dimension g hget
      rw [hgC] at h
      exact h
    have hadd := trdeg_add_eq k Γ(S, U') (A := Γ(Y, V'))
    rw [h3, h4, h2] at hadd
    have hnat : d + P.dimension = d + 1 := by exact_mod_cast hadd
    have hdim : P.dimension = 1 := by omega
    exact P.isStandardSmoothOfRelativeDimension hdim
  apply wcpa_dj_cf_ss_restrict_of_charts p 1 W
  intro x hx
  have hx' : x ∈ p ⁻¹ᵁ W := hx
  obtain ⟨U₁, hU₁, V₁, hV₁, hxV₁, e₁, hss⟩ := Smooth.exists_isStandardSmooth (p ∣_ W) ⟨x, hx'⟩
  rw [morphismRestrict_appLE] at hss
  have hxmem : x ∈ (p ⁻¹ᵁ W).ι ''ᵁ V₁ := by
    show x ∈ (((p ⁻¹ᵁ W).ι ''ᵁ V₁ : Y.Opens) : Set Y)
    rw [Scheme.Hom.coe_image]
    exact ⟨⟨x, hx'⟩, hxV₁, Scheme.Opens.ι_apply _ _⟩
  exact ⟨W.ι ''ᵁ U₁, hU₁.image_of_isOpenImmersion _, (p ⁻¹ᵁ W).ι ''ᵁ V₁,
    hV₁.image_of_isOpenImmersion _, hxmem, _,
    key _ _ _ (hU₁.image_of_isOpenImmersion _) (hV₁.image_of_isOpenImmersion _) ⟨x, hxmem⟩ hss⟩

theorem wcpa_stein_field : ∀ (F : Type u) [Field F] (Z : Scheme.{u}) [AlgebraicGeometry.IsIntegral Z]
    (sZ : Z ⟶ Spec (.of F)) [IsProper sZ],
    ∃ (F' : Type u) (_ : Field F') (_ : Algebra F F') (_ : FiniteDimensional F F')
      (t : Z ⟶ Spec (.of F')),
      t ≫ Spec.map (CommRingCat.ofHom (algebraMap F F')) = sZ ∧ IsIso t.appTop :=
by
  intro F _ Z _ sZ _
  have hR : IsField Γ(Z, ⊤) := isField_of_universallyClosed F sZ
  letI iF : Field Γ(Z, ⊤) := { (inferInstance : CommRing Γ(Z, ⊤)), hR.toField with }
  let eF := Scheme.ΓSpecIso (CommRingCat.of F)
  let α : CommRingCat.of F ⟶ Γ(Z, ⊤) := eF.inv ≫ sZ.appTop
  letI iA : Algebra F Γ(Z, ⊤) := α.hom.toAlgebra
  have hfin : FiniteDimensional F Γ(Z, ⊤) := by
    have h1 : sZ.appTop.hom.Finite := finite_appTop_of_universallyClosed F sZ
    have h2 : eF.inv.hom.Finite := RingHom.Finite.of_surjective _ (fun y => ⟨eF.hom.hom y, by
      rw [← CommRingCat.comp_apply, Iso.hom_inv_id]; rfl⟩)
    have h3 : (algebraMap F Γ(Z, ⊤)).Finite := by
      show (eF.inv ≫ sZ.appTop).hom.Finite
      rw [CommRingCat.hom_comp]
      exact h1.comp h2
    exact RingHom.finite_algebraMap.mp h3
  refine ⟨Γ(Z, ⊤), iF, iA, hfin, Z.toSpecΓ, ?_, ?_⟩
  · have hα : CommRingCat.ofHom (algebraMap F Γ(Z, ⊤)) = α := rfl
    rw [hα]
    show Z.toSpecΓ ≫ Spec.map (eF.inv ≫ sZ.appTop) = sZ
    rw [Spec.map_comp, ← Category.assoc, ← Scheme.toSpecΓ_naturality, Category.assoc,
      ← SpecMap_ΓSpecIso_hom, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id,
      Category.comp_id]
  · show IsIso (Scheme.Hom.appTop Z.toSpecΓ)
    rw [Scheme.toSpecΓ_appTop]
    exact Iso.isIso_hom _

theorem wcpa_geom_connected_of_global_sections : ∀ (F' : Type u) [Field F'] (Z : Scheme.{u})
    [Nonempty Z] (t : Z ⟶ Spec (.of F')) [IsProper t],
    IsIso t.appTop → GeometricallyConnected t :=
by
  intro F' _ Z _ t _ hiso
  refine ⟨?_⟩
  intro K _ y W fst snd hpb

  have hUST : (⊤ : (Spec (.of K)).Opens) ≤ y ⁻¹ᵁ ⊤ := le_top
  have hUSX : (⊤ : Z.Opens) ≤ t ⁻¹ᵁ ⊤ := le_top
  have hUY : (⊤ : W.Opens) = fst ⁻¹ᵁ ⊤ ⊓ snd ⁻¹ᵁ ⊤ := by simp
  haveI : CompactSpace Z := QuasiCompact.compactSpace_of_compactSpace t
  haveI : QuasiSeparatedSpace Z := quasiSeparatedSpace_of_quasiSeparated t
  have hiso2 : IsIso (pushoutSection hpb hUST hUSX hUY) :=
    isIso_pushoutSection_of_isQuasiSeparated_of_flat_right hpb hUST hUSX hUY
      (isAffineOpen_top _) (isAffineOpen_top _)
      (by rw [TopologicalSpace.Opens.coe_top]; exact isCompact_univ)
      (by rw [TopologicalSpace.Opens.coe_top]; exact isQuasiSeparated_univ)
  haveI hleft : IsIso (t.appLE ⊤ ⊤ hUSX) := by
    have : t.appLE ⊤ ⊤ hUSX = t.appTop := Scheme.Hom.appLE_eq_app t
    rw [this]; exact hiso
  haveI hinr : IsIso (Limits.pushout.inr (t.appLE ⊤ ⊤ hUSX) (y.appLE ⊤ ⊤ hUST)) :=
    Limits.pushout_inr_iso_of_left_iso _ _
  let e : Γ(W, ⊤) ≅ CommRingCat.of K :=
    (asIso (Limits.pushout.inr (t.appLE ⊤ ⊤ hUSX) (y.appLE ⊤ ⊤ hUST) ≫
      pushoutSection hpb hUST hUSX hUY)).symm ≪≫ Scheme.ΓSpecIso (.of K)
  have hF : IsField Γ(W, ⊤) :=
    MulEquiv.isField (Field.toIsField K) e.commRingCatIsoToRingEquiv.toMulEquiv

  have hnt : Nontrivial Γ(W, ⊤) := hF.nontrivial
  have sub_of_bot : ∀ U : W.Opens, U = ⊥ → Subsingleton Γ(W, U) := fun U hU =>
    CommRingCat.subsingleton_of_isTerminal (W.sheaf.isTerminalOfEqEmpty hU)
  have empty_of_sub : ∀ U : W.Opens, Subsingleton Γ(W, U) → (U : Set W) = ∅ := by
    intro U hU
    by_contra h
    haveI : Nonempty U := (Set.nonempty_iff_ne_empty.mpr h).to_subtype
    haveI := W.component_nontrivial U
    exact false_of_nontrivial_of_subsingleton Γ(W, U)
  rw [connectedSpace_iff_clopen]
  refine ⟨?_, ?_⟩
  · by_contra hne
    rw [not_nonempty_iff] at hne
    have h0 : (⊤ : W.Opens) = ⊥ := by ext x; exact hne.elim x
    haveI := sub_of_bot ⊤ h0
    exact false_of_nontrivial_of_subsingleton Γ(W, ⊤)
  · intro s hs
    let U : W.Opens := ⟨s, hs.isOpen⟩
    let V : W.Opens := ⟨sᶜ, hs.compl.isOpen⟩
    let 𝒰 : Bool → W.Opens := fun b => bif b then U else V
    have hdisj : ∀ i j : Bool, i ≠ j → 𝒰 i ⊓ 𝒰 j = ⊥ := by
      intro i j hij
      cases i <;> cases j <;> simp at hij <;> ext x <;> simp [𝒰, U, V]
    have hcov : (⊤ : W.Opens) ≤ iSup 𝒰 := by
      intro x _
      show x ∈ iSup 𝒰
      rw [TopologicalSpace.Opens.mem_iSup]
      by_cases hx : x ∈ s
      · exact ⟨true, hx⟩
      · exact ⟨false, hx⟩
    let sf : (i : Bool) → ToType (W.sheaf.obj.obj (Opposite.op (𝒰 i))) := fun b =>
      match b with
      | true => (1 : Γ(W, U))
      | false => (0 : Γ(W, V))
    have hcomp : TopCat.Presheaf.IsCompatible W.sheaf.obj 𝒰 sf := by
      intro i j
      by_cases hij : i = j
      · subst hij
        have : TopologicalSpace.Opens.infLELeft (𝒰 i) (𝒰 i) =
            TopologicalSpace.Opens.infLERight (𝒰 i) (𝒰 i) := Subsingleton.elim _ _
        rw [this]
      · exact @Subsingleton.elim _ (sub_of_bot _ (hdisj i j hij)) _ _
    obtain ⟨ε, hε, -⟩ := W.sheaf.existsUnique_gluing' 𝒰 ⊤ (fun i => homOfLE le_top) hcov sf hcomp
    have hidem : ε * ε = ε := by
      apply W.sheaf.eq_of_locally_eq' 𝒰 ⊤ (fun i => homOfLE le_top) hcov
      intro i
      rw [map_mul, hε i]
      cases i
      · show (0 : Γ(W, V)) * 0 = 0
        exact mul_zero _
      · show (1 : Γ(W, U)) * 1 = 1
        exact mul_one _
    have key : ∀ x : Γ(W, ⊤), x * x = x → x = 0 ∨ x = 1 := by
      intro x hx
      haveI := hF.isDomain
      have : x * (x - 1) = 0 := by rw [mul_sub, hx, mul_one, sub_self]
      rcases mul_eq_zero.mp this with h | h
      · exact Or.inl h
      · exact Or.inr (sub_eq_zero.mp h)
    have h01 : ε = 0 ∨ ε = 1 := key ε hidem
    rcases h01 with h | h
    · left
      have h1 := hε true
      rw [h, map_zero] at h1
      haveI : Subsingleton Γ(W, U) := subsingleton_of_zero_eq_one h1
      exact empty_of_sub U this
    · right
      have h1 := hε false
      rw [h, map_one] at h1
      haveI : Subsingleton Γ(W, V) := subsingleton_of_zero_eq_one h1.symm
      have := empty_of_sub V this
      exact Set.compl_empty_iff.mp this

theorem wcpa_dj_sgs_gc_sections_embed : ∀ (Xt Q : Scheme.{u}) [AlgebraicGeometry.IsIntegral Xt] [AlgebraicGeometry.IsIntegral Q] (f : Xt ⟶ Q) (h : f (genericPoint Xt) ⤳ genericPoint Q), AlgebraicGeometry.IsIntegral (Limits.pullback f (Q.fromSpecStalk (genericPoint Q))) → ∃ lam : Γ(Limits.pullback f (Q.fromSpecStalk (genericPoint Q)), ⊤) →+* Xt.presheaf.stalk (genericPoint Xt), Function.Injective lam ∧ ∀ c : Q.presheaf.stalk (genericPoint Q), lam (((Scheme.ΓSpecIso (Q.presheaf.stalk (genericPoint Q))).inv ≫ (Limits.pullback.snd f (Q.fromSpecStalk (genericPoint Q))).appTop).hom c) = (Q.presheaf.stalkSpecializes h ≫ f.stalkMap (genericPoint Xt)).hom c :=
by
  intro Xt Q _ _ f h hYint
  haveI := hYint
  have hfη : f (genericPoint Xt) = genericPoint Q := (h.antisymm (genericPoint_specializes _)).eq
  obtain ⟨y₁, hy₁, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := f)
    (g := Q.fromSpecStalk (genericPoint Q)) (genericPoint Xt)
    (IsLocalRing.closedPoint (Q.presheaf.stalk (genericPoint Q)))
    (by rw [Scheme.fromSpecStalk_closedPoint]; exact hfη)

  have hsurj1 : Function.Surjective
      ((Limits.pullback.fst f (Q.fromSpecStalk (genericPoint Q))).stalkMap y₁).hom :=
    SurjectiveOnStalks.stalkMap_surjective _ y₁
  have hsurj2 : ∀ (a b : Xt) (e : a = b) (hab : a ⤳ b),
      Function.Surjective (Xt.presheaf.stalkSpecializes hab).hom := by
    intro a b e hab
    subst e
    rw [TopCat.Presheaf.stalkSpecializes_refl, CommRingCat.hom_id]
    exact fun x => ⟨x, rfl⟩
  have hbij : Function.Bijective (Xt.presheaf.stalkSpecializes (specializes_of_eq hy₁) ≫
      (Limits.pullback.fst f (Q.fromSpecStalk (genericPoint Q))).stalkMap y₁).hom := by
    refine ⟨RingHom.injective _, ?_⟩
    rw [CommRingCat.hom_comp]
    exact hsurj1.comp (hsurj2 _ _ hy₁ _)
  let θe := RingEquiv.ofBijective _ hbij
  have hθ : ∀ x, θe x = (Xt.presheaf.stalkSpecializes (specializes_of_eq hy₁) ≫
      (Limits.pullback.fst f (Q.fromSpecStalk (genericPoint Q))).stalkMap y₁).hom x :=
    fun x => rfl

  have hmem' : ∀ (V : Q.Opens), genericPoint Q ∈ V →
      y₁ ∈ Limits.pullback.fst f (Q.fromSpecStalk (genericPoint Q)) ⁻¹ᵁ (f ⁻¹ᵁ V) := by
    intro V hV
    rw [Scheme.Hom.mem_preimage, Scheme.Hom.mem_preimage, hy₁, hfη]
    exact hV
  have hmem : ∀ (V : Q.Opens), genericPoint Q ∈ V →
      y₁ ∈ Limits.pullback.snd f (Q.fromSpecStalk (genericPoint Q)) ⁻¹ᵁ
        (Q.fromSpecStalk (genericPoint Q) ⁻¹ᵁ V) := by
    intro V hV
    rw [Scheme.Hom.mem_preimage, Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply,
      ← Limits.pullback.condition, Scheme.Hom.comp_apply, hy₁, hfη]
    exact hV
  have hlink : ∀ (V : Q.Opens) (φ ψ : Limits.pullback f (Q.fromSpecStalk (genericPoint Q)) ⟶ Q),
      φ = ψ → ∀ (h₁ : y₁ ∈ φ ⁻¹ᵁ V) (h₂ : y₁ ∈ ψ ⁻¹ᵁ V),
      φ.app V ≫ (Limits.pullback f (Q.fromSpecStalk (genericPoint Q))).presheaf.germ _ y₁ h₁ =
      ψ.app V ≫ (Limits.pullback f (Q.fromSpecStalk (genericPoint Q))).presheaf.germ _ y₁ h₂ := by
    rintro V φ _ rfl _ _
    rfl
  have key : (Scheme.ΓSpecIso (Q.presheaf.stalk (genericPoint Q))).inv ≫
      (Limits.pullback.snd f (Q.fromSpecStalk (genericPoint Q))).appTop ≫
      (Limits.pullback f (Q.fromSpecStalk (genericPoint Q))).presheaf.germ ⊤ y₁ trivial =
      (Q.presheaf.stalkSpecializes h ≫ f.stalkMap (genericPoint Xt)) ≫
      (Xt.presheaf.stalkSpecializes (specializes_of_eq hy₁) ≫
        (Limits.pullback.fst f (Q.fromSpecStalk (genericPoint Q))).stalkMap y₁) := by
    apply TopCat.Presheaf.stalk_hom_ext
    intro V hV
    have hL : Q.presheaf.germ V (genericPoint Q) hV ≫
        (Scheme.ΓSpecIso (Q.presheaf.stalk (genericPoint Q))).inv ≫
        (Limits.pullback.snd f (Q.fromSpecStalk (genericPoint Q))).appTop ≫
        (Limits.pullback f (Q.fromSpecStalk (genericPoint Q))).presheaf.germ ⊤ y₁ trivial =
        (Q.fromSpecStalk (genericPoint Q)).app V ≫
          (Limits.pullback.snd f (Q.fromSpecStalk (genericPoint Q))).app
            (Q.fromSpecStalk (genericPoint Q) ⁻¹ᵁ V) ≫
        (Limits.pullback f (Q.fromSpecStalk (genericPoint Q))).presheaf.germ
          (Limits.pullback.snd f (Q.fromSpecStalk (genericPoint Q)) ⁻¹ᵁ
            (Q.fromSpecStalk (genericPoint Q) ⁻¹ᵁ V)) y₁ (hmem V hV) := by
      rw [Scheme.fromSpecStalk_app hV]
      simp only [Category.assoc]
      first
        | (rw [← Scheme.Hom.naturality_assoc, TopCat.Presheaf.germ_res']; rfl)
        | (rw [← Scheme.Hom.naturality_assoc, TopCat.Presheaf.germ_res'])
        | (erw [← Scheme.Hom.naturality_assoc]; erw [TopCat.Presheaf.germ_res']; rfl)
        | (erw [← Scheme.Hom.naturality_assoc]; erw [TopCat.Presheaf.germ_res'])
        | (rw [← Scheme.Hom.naturality_assoc]; simp only [TopCat.Presheaf.germ_res']; rfl)
        | (simp [Scheme.Hom.appTop])
    have hR : Q.presheaf.germ V (genericPoint Q) hV ≫
        (Q.presheaf.stalkSpecializes h ≫ f.stalkMap (genericPoint Xt)) ≫
        (Xt.presheaf.stalkSpecializes (specializes_of_eq hy₁) ≫
          (Limits.pullback.fst f (Q.fromSpecStalk (genericPoint Q))).stalkMap y₁) =
        f.app V ≫ (Limits.pullback.fst f (Q.fromSpecStalk (genericPoint Q))).app (f ⁻¹ᵁ V) ≫
        (Limits.pullback f (Q.fromSpecStalk (genericPoint Q))).presheaf.germ
          (Limits.pullback.fst f (Q.fromSpecStalk (genericPoint Q)) ⁻¹ᵁ (f ⁻¹ᵁ V)) y₁
          (hmem' V hV) := by
      have hη : genericPoint Xt ∈ f ⁻¹ᵁ V := by
        rw [Scheme.Hom.mem_preimage, hfη]; exact hV
      have hfy : (Limits.pullback.fst f (Q.fromSpecStalk (genericPoint Q))) y₁ ∈ f ⁻¹ᵁ V := by
        rw [hy₁]; exact hη
      have hgen : ∀ (a : Xt) (e : a = genericPoint Xt) (ha : a ∈ f ⁻¹ᵁ V),
          Xt.presheaf.germ (f ⁻¹ᵁ V) (genericPoint Xt) hη ≫
            Xt.presheaf.stalkSpecializes (specializes_of_eq e) =
          Xt.presheaf.germ (f ⁻¹ᵁ V) a ha := by
        rintro a rfl ha
        rw [TopCat.Presheaf.stalkSpecializes_refl, Category.comp_id]
      simp only [Category.assoc]
      first
        | (rw [TopCat.Presheaf.germ_stalkSpecializes_assoc, Scheme.Hom.germ_stalkMap_assoc,
            TopCat.Presheaf.germ_stalkSpecializes_assoc, Scheme.Hom.germ_stalkMap])
        | (rw [TopCat.Presheaf.germ_stalkSpecializes_assoc, Scheme.Hom.germ_stalkMap_assoc,
            reassoc_of% (hgen _ hy₁ hfy), Scheme.Hom.germ_stalkMap])
        | (simp only [TopCat.Presheaf.germ_stalkSpecializes_assoc, Scheme.Hom.germ_stalkMap_assoc]
           rw [reassoc_of% (hgen _ hy₁ hfy), Scheme.Hom.germ_stalkMap])
        | (simp only [TopCat.Presheaf.germ_stalkSpecializes_assoc, Scheme.Hom.germ_stalkMap_assoc]
           erw [reassoc_of% (hgen _ hy₁ hfy)]
           erw [Scheme.Hom.germ_stalkMap])
    rw [hL, hR]
    exact hlink V _ _ Limits.pullback.condition.symm (hmem V hV) (hmem' V hV)
  have e2 : ∀ c : Q.presheaf.stalk (genericPoint Q),
      θe ((Q.presheaf.stalkSpecializes h ≫ f.stalkMap (genericPoint Xt)).hom c) =
      ((Limits.pullback f (Q.fromSpecStalk (genericPoint Q))).presheaf.germ ⊤ y₁ trivial).hom
        (((Scheme.ΓSpecIso (Q.presheaf.stalk (genericPoint Q))).inv ≫
          (Limits.pullback.snd f (Q.fromSpecStalk (genericPoint Q))).appTop).hom c) := by
    intro c
    rw [hθ]
    first
      | exact (congrArg (fun g => g.hom c) key).symm
      | (have e3 := congrArg (fun g => g.hom c) key
         simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e3 ⊢
         exact e3.symm)
  refine ⟨θe.symm.toRingHom.comp
    ((Limits.pullback f (Q.fromSpecStalk (genericPoint Q))).presheaf.germ ⊤ y₁ trivial).hom, ?_, ?_⟩
  · exact θe.symm.injective.comp (germ_injective_of_isIntegral _ (U := ⊤) y₁ trivial)
  · intro c
    show θe.symm (((Limits.pullback f (Q.fromSpecStalk (genericPoint Q))).presheaf.germ ⊤ y₁
      trivial).hom (((Scheme.ΓSpecIso (Q.presheaf.stalk (genericPoint Q))).inv ≫
      (Limits.pullback.snd f (Q.fromSpecStalk (genericPoint Q))).appTop).hom c)) = _
    rw [← e2 c]
    exact θe.symm_apply_apply _

theorem wcpa_dj_sgs_gc_twist_function_field : ∀ (k : Type u) [Field k] [Finite k] (Γ Q : Scheme.{u}) [AlgebraicGeometry.IsIntegral Γ] [AlgebraicGeometry.IsIntegral Q] (sQ : Q ⟶ Spec (.of k)) (g : Γ ⟶ Q) (m : ℕ) (Φ : Q ⟶ Q), wcIsAbsFrob Φ (Nat.card k ^ m) → Φ ≫ sQ = sQ → ∀ (R : Scheme.{u}) [AlgebraicGeometry.IsIntegral R] (r : R ⟶ Limits.pullback g Φ), IsClosedImmersion r → Surjective r → ∀ (Xt : Scheme.{u}) [AlgebraicGeometry.IsIntegral Xt] (b : Xt ⟶ R), Surjective b → (∃ U : R.Opens, U ≠ ⊥ ∧ IsIso (b ∣_ U)) → ∀ (h₁ : (b ≫ r ≫ Limits.pullback.fst g Φ) (genericPoint Xt) ⤳ genericPoint Γ) (h₂ : (b ≫ r ≫ Limits.pullback.snd g Φ) (genericPoint Xt) ⤳ genericPoint Q) (h₃ : g (genericPoint Γ) ⤳ genericPoint Q), CharP (Xt.presheaf.stalk (genericPoint Xt)) (ringChar k) ∧ (∀ c : Q.presheaf.stalk (genericPoint Q), (Γ.presheaf.stalkSpecializes h₁ ≫ (b ≫ r ≫ Limits.pullback.fst g Φ).stalkMap (genericPoint Xt)).hom ((Q.presheaf.stalkSpecializes h₃ ≫ g.stalkMap (genericPoint Γ)).hom c) = (Q.presheaf.stalkSpecializes h₂ ≫ (b ≫ r ≫ Limits.pullback.snd g Φ).stalkMap (genericPoint Xt)).hom c ^ (Nat.card k ^ m)) ∧ ∀ x : Xt.presheaf.stalk (genericPoint Xt), ∃ y : Γ.presheaf.stalk (genericPoint Γ), (Γ.presheaf.stalkSpecializes h₁ ≫ (b ≫ r ≫ Limits.pullback.fst g Φ).stalkMap (genericPoint Xt)).hom y = x ^ (Nat.card k ^ m) :=
by
  intro k _ _ Γ Q _ _ sQ g m Φ hΦ hΦs R _ r hrci hrs Xt _ b hbs hbU h₁ h₂ h₃
  classical
  haveI := hrci
  haveI := hbs

  have key : ∀ {Y : Scheme.{u}} (φ₁ φ₂ : Xt ⟶ Y), φ₁ = φ₂ → ∀ (V : Y.Opens)
      (e₁ : genericPoint Xt ∈ φ₁ ⁻¹ᵁ V) (e₂ : genericPoint Xt ∈ φ₂ ⁻¹ᵁ V),
      φ₁.app V ≫ Xt.presheaf.germ (φ₁ ⁻¹ᵁ V) (genericPoint Xt) e₁ =
        φ₂.app V ≫ Xt.presheaf.germ (φ₂ ⁻¹ᵁ V) (genericPoint Xt) e₂ := by
    rintro Y φ₁ φ₂ rfl V e₁ e₂
    rfl
  have hcond : (b ≫ r ≫ Limits.pullback.fst g Φ) ≫ g =
      (b ≫ r ≫ Limits.pullback.snd g Φ) ≫ Φ := by
    simp only [Category.assoc, Limits.pullback.condition]

  have hC1 : CharP (Xt.presheaf.stalk (genericPoint Xt)) (ringChar k) := by
    let κ : k →+* Xt.presheaf.stalk (genericPoint Xt) :=
      ((Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
        ((b ≫ r ≫ Limits.pullback.snd g Φ) ≫ sQ).appTop ≫
        Xt.presheaf.germ ⊤ (genericPoint Xt) trivial).hom
    exact charP_of_injective_ringHom κ.injective (ringChar k)

  have hC2 : ∀ c : Q.presheaf.stalk (genericPoint Q),
      (Γ.presheaf.stalkSpecializes h₁ ≫
        (b ≫ r ≫ Limits.pullback.fst g Φ).stalkMap (genericPoint Xt)).hom
        ((Q.presheaf.stalkSpecializes h₃ ≫ g.stalkMap (genericPoint Γ)).hom c) =
      (Q.presheaf.stalkSpecializes h₂ ≫
        (b ≫ r ≫ Limits.pullback.snd g Φ).stalkMap (genericPoint Xt)).hom c ^
          (Nat.card k ^ m) := by
    intro c
    obtain ⟨V, hηV, s, hs⟩ := Q.presheaf.exists_germ_eq c
    have hs' : c = (Q.presheaf.germ V (genericPoint Q) hηV).hom s := hs.symm
    subst hs'
    have hVV : V ≤ Φ ⁻¹ᵁ V := fun y hy =>
      (Scheme.Hom.mem_preimage Φ).mpr (by rw [hΦ.1 y]; exact hy)
    have hM : Q.presheaf.germ V (genericPoint Q) hηV ≫ Q.presheaf.stalkSpecializes h₃ ≫
        g.stalkMap (genericPoint Γ) ≫ Γ.presheaf.stalkSpecializes h₁ ≫
        (b ≫ r ≫ Limits.pullback.fst g Φ).stalkMap (genericPoint Xt) =
        Φ.appLE V V hVV ≫ Q.presheaf.germ V (genericPoint Q) hηV ≫
        Q.presheaf.stalkSpecializes h₂ ≫
        (b ≫ r ≫ Limits.pullback.snd g Φ).stalkMap (genericPoint Xt) := by
      rw [TopCat.Presheaf.germ_stalkSpecializes_assoc Q.presheaf hηV h₃,
        Scheme.Hom.germ_stalkMap_assoc g]
      erw [TopCat.Presheaf.germ_stalkSpecializes_assoc Γ.presheaf _ h₁]
      rw [Scheme.Hom.germ_stalkMap (b ≫ r ≫ Limits.pullback.fst g Φ),
        TopCat.Presheaf.germ_stalkSpecializes_assoc Q.presheaf hηV h₂,
        Scheme.Hom.appLE, Category.assoc (Φ.app V),
        TopCat.Presheaf.germ_res_assoc,
        Scheme.Hom.germ_stalkMap (b ≫ r ≫ Limits.pullback.snd g Φ),
        ← Category.assoc (g.app V),
        ← Scheme.Hom.comp_app (b ≫ r ≫ Limits.pullback.fst g Φ) g V,
        ← Category.assoc (Φ.app V),
        ← Scheme.Hom.comp_app (b ≫ r ≫ Limits.pullback.snd g Φ) Φ V]
      exact key _ _ hcond V _ _
    have e1 := congrArg (fun φ => φ.hom s) hM
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e1 ⊢
    rw [e1, hΦ.2 V hVV s, map_pow, map_pow, map_pow]
  refine ⟨hC1, hC2, ?_⟩


  have chart : ∀ (S X : Scheme.{u}) (g : X ⟶ S) (Φ : S ⟶ S) (V : S.Opens), IsAffineOpen V →
      ∀ (hVV : V ≤ Φ ⁻¹ᵁ V) (U : X.Opens), IsAffineOpen U → ∀ (hUV : U ≤ g ⁻¹ᵁ V),
      IsAffineOpen (Limits.pullback.fst g Φ ⁻¹ᵁ U ⊓ Limits.pullback.snd g Φ ⁻¹ᵁ V) ∧
      IsPushout (g.appLE V U hUV) (Φ.appLE V V hVV)
        ((Limits.pullback.fst g Φ).appLE U
          (Limits.pullback.fst g Φ ⁻¹ᵁ U ⊓ Limits.pullback.snd g Φ ⁻¹ᵁ V) inf_le_left)
        ((Limits.pullback.snd g Φ).appLE V
          (Limits.pullback.fst g Φ ⁻¹ᵁ U ⊓ Limits.pullback.snd g Φ ⁻¹ᵁ V) inf_le_right) := by
    intro S X g Φ V hV hVV U hU hUV
    have s2 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) {U : Y.Opens} {V : X.Opens} (hU : IsAffineOpen U)
        (hV : IsAffineOpen V) (e : V ≤ f ⁻¹ᵁ U),
        f.resLE U V e ≫ hU.isoSpec.hom = hV.isoSpec.hom ≫ Spec.map (f.appLE U V e) := by
      intro X Y f U V hU hV e
      have h : hV.isoSpec.inv ≫ f.resLE U V e = Spec.map (f.appLE U V e) ≫ hU.isoSpec.inv := by
        rw [← cancel_mono U.ι]
        simp only [Category.assoc, Scheme.Hom.resLE_comp_ι, IsAffineOpen.isoSpec_inv_ι]
        rw [← Category.assoc, IsAffineOpen.isoSpec_inv_ι, IsAffineOpen.SpecMap_appLE_fromSpec]
      calc f.resLE U V e ≫ hU.isoSpec.hom
          = hV.isoSpec.hom ≫ (hV.isoSpec.inv ≫ f.resLE U V e) ≫ hU.isoSpec.hom := by simp
        _ = hV.isoSpec.hom ≫ Spec.map (f.appLE U V e) := by rw [h]; simp
    have s3 : ∀ {A B C D : CommRingCat.{u}} (f : A ⟶ B) (g : A ⟶ C) (inl : B ⟶ D) (inr : C ⟶ D),
        IsPullback (Spec.map inl) (Spec.map inr) (Spec.map f) (Spec.map g) →
        IsPushout f g inl inr := by
      intro A B C D f g inl inr h
      have h' : IsPullback (Scheme.Spec.map inl.op) (Scheme.Spec.map inr.op)
          (Scheme.Spec.map f.op) (Scheme.Spec.map g.op) := h
      exact (IsPullback.of_map_of_faithful Scheme.Spec h').unop.flip
    have H1 := Scheme.Hom.isPullback_resLE (IsPullback.of_hasPullback g Φ) hVV hUV
      (UY := Limits.pullback.fst g Φ ⁻¹ᵁ U ⊓ Limits.pullback.snd g Φ ⁻¹ᵁ V) rfl
    have : IsAffine U := hU
    have : IsAffine V := hV
    have hUP : IsAffineOpen (Limits.pullback.fst g Φ ⁻¹ᵁ U ⊓ Limits.pullback.snd g Φ ⁻¹ᵁ V) :=
      IsAffine.of_isIso H1.isoPullback.hom
    refine ⟨hUP, s3 _ _ _ _ ?_⟩
    exact IsPullback.of_iso H1 hUP.isoSpec hU.isoSpec hV.isoSpec hV.isoSpec
      (s2 _ _ _ _) (s2 _ _ _ _) (s2 _ _ _ _) (s2 _ _ _ _)

  have pf : ∀ (A D C : CommRingCat.{u}) (α : A ⟶ D) (φ : A ⟶ A) (γ : D ⟶ C) (β : A ⟶ C),
      IsPushout α φ γ β → ∀ (E : Type u) [CommRing E] (p e : ℕ) [ExpChar E p] (θ : C →+* E),
      (∀ a : A, φ.hom a = a ^ (p ^ e)) → ∀ c : C, ∃ d : D, θ (γ.hom d) = θ c ^ (p ^ e) := by
    intro A D C α φ γ β hP E _ p e _ θ hφ
    obtain ⟨S, hmem⟩ : ∃ S : Subring C, ∀ c, c ∈ S ↔ ∃ d : D, θ (γ.hom d) = θ c ^ (p ^ e) :=
      ⟨Subring.comap ((iterateFrobenius E p e).comp θ) (θ.comp γ.hom).range, fun c => by
        simp only [Subring.mem_comap, RingHom.mem_range, RingHom.comp_apply,
          iterateFrobenius_def]⟩
    have hγS : ∀ d, γ.hom d ∈ S := fun d =>
      (hmem _).mpr ⟨d ^ (p ^ e), by rw [map_pow, map_pow]⟩
    have hβS : ∀ a, β.hom a ∈ S := fun a => (hmem _).mpr ⟨α.hom a, by
      have h := congrArg (fun f => f.hom a) hP.toCommSq.w
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h
      rw [h, hφ, map_pow, map_pow]⟩
    let ι : CommRingCat.of S ⟶ C := CommRingCat.ofHom S.subtype
    let γ' : D ⟶ CommRingCat.of S := CommRingCat.ofHom (γ.hom.codRestrict S hγS)
    let β' : A ⟶ CommRingCat.of S := CommRingCat.ofHom (β.hom.codRestrict S hβS)
    have hγ' : γ' ≫ ι = γ := by ext d; rfl
    have hβ' : β' ≫ ι = β := by ext a; rfl
    have hw : α ≫ γ' = φ ≫ β' := by
      ext a
      have h := congrArg (fun f => f.hom a) hP.toCommSq.w
      exact h
    have hσ : hP.desc γ' β' hw ≫ ι = 𝟙 C := by
      apply hP.hom_ext
      · rw [Category.comp_id, ← Category.assoc, hP.inl_desc, hγ']
      · rw [Category.comp_id, ← Category.assoc, hP.inr_desc, hβ']
    intro c
    have hc : c ∈ S := by
      have e1 : (hP.desc γ' β' hw ≫ ι).hom c = c := by rw [hσ]; rfl
      have h2 : (hP.desc γ' β' hw ≫ ι).hom c ∈ S := ((hP.desc γ' β' hw).hom c).2
      rw [e1] at h2
      exact h2
    exact (hmem c).mp hc

  have frac : ∀ (Y : Scheme.{u}) (W : Y.Opens), IsAffineOpen W → ∀ (p : Y) (hp : p ∈ W)
      (ξ : Y.presheaf.stalk p), ∃ c t : Γ(Y, W),
        IsUnit ((Y.presheaf.germ W p hp).hom t) ∧
        ξ * (Y.presheaf.germ W p hp).hom t = (Y.presheaf.germ W p hp).hom c := by
    intro Y W hW p hp ξ
    obtain ⟨y, rfl⟩ : ∃ y : W, (y : Y) = p := ⟨⟨p, hp⟩, rfl⟩
    haveI := hW.isLocalization_stalk y
    obtain ⟨⟨c, t⟩, hct⟩ :=
      IsLocalization.mk'_surjective (hW.primeIdealOf y).asIdeal.primeCompl ξ
    refine ⟨c, t, ?_, ?_⟩
    · exact IsLocalization.map_units (Y.presheaf.stalk y) t
    · rw [← hct]
      exact IsLocalization.mk'_spec (Y.presheaf.stalk y) c t

  have alg : ∀ (KΓ KX O C : Type u) [Field KΓ] [Field KX] [CommRing O] [CommRing C]
      (u : KΓ →+* KX) (Ψ : O →+* KX) (j : C →+* O) (N : ℕ), Function.Surjective Ψ →
      (∀ ξ : O, ∃ c t : C, IsUnit (j t) ∧ ξ * j t = j c) →
      (∀ c, ∃ y, u y = Ψ (j c) ^ N) → ∀ z, ∃ y, u y = z ^ N := by
    intro KΓ KX O C _ _ _ _ u Ψ j N hΨ hfr hS z
    obtain ⟨ξ, rfl⟩ := hΨ z
    obtain ⟨c, t, hu, hct⟩ := hfr ξ
    obtain ⟨yc, hyc⟩ := hS c
    obtain ⟨yt, hyt⟩ := hS t
    have ht0 : Ψ (j t) ≠ 0 := (hu.map Ψ).ne_zero
    have e : Ψ ξ = Ψ (j c) / Ψ (j t) := by rw [eq_div_iff ht0, ← map_mul, hct]
    refine ⟨yc / yt, ?_⟩
    rw [map_div₀, hyc, hyt, e, div_pow]

  obtain ⟨U, hU0, hbUiso⟩ := hbU
  have hUne : (U : Set R).Nonempty := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).mp hU0
  have hbx : b (genericPoint Xt) ∈ U := by
    obtain ⟨u, hu⟩ := hUne
    obtain ⟨x, hx⟩ := b.surjective u
    have hx' : x ∈ b ⁻¹ᵁ U := (Scheme.Hom.mem_preimage b).mpr (by rw [hx]; exact hu)
    have h1 : genericPoint Xt ∈ ((b ⁻¹ᵁ U : Xt.Opens) : Set Xt) :=
      (IsGenericPoint.mem_open_set_iff (genericPoint_spec Xt) (b ⁻¹ᵁ U).isOpen).mpr
        ⟨x, trivial, hx'⟩
    exact (Scheme.Hom.mem_preimage b).mp h1
  have hbsurj : Function.Surjective (b.stalkMap (genericPoint Xt)).hom := by
    haveI : IsOpenImmersion ((b ⁻¹ᵁ U).ι ≫ b) := by
      rw [← morphismRestrict_ι]; infer_instance
    have hmem : genericPoint Xt ∈ Set.range (b ⁻¹ᵁ U).ι := by
      rw [Scheme.Opens.range_ι]
      exact (Scheme.Hom.mem_preimage b).mpr hbx
    obtain ⟨x', hx'⟩ := hmem
    have h1 : IsIso (((b ⁻¹ᵁ U).ι ≫ b).stalkMap x') := inferInstance
    rw [Scheme.Hom.stalkMap_comp] at h1
    have h2 : IsIso ((b ⁻¹ᵁ U).ι.stalkMap x') := inferInstance
    have h4 : IsIso (b.stalkMap ((b ⁻¹ᵁ U).ι x')) :=
      @IsIso.of_isIso_comp_right _ _ _ _ _ (b.stalkMap ((b ⁻¹ᵁ U).ι x'))
        ((b ⁻¹ᵁ U).ι.stalkMap x') h2 h1
    have h3 := (@ConcreteCategory.bijective_of_isIso _ _ _ _ _ _ _ _
      (b.stalkMap ((b ⁻¹ᵁ U).ι x')) h4).2
    rw [hx'] at h3
    exact h3
  have hψsurj : Function.Surjective ((b ≫ r).stalkMap (genericPoint Xt)).hom := by
    have e := Scheme.Hom.stalkMap_comp b r (genericPoint Xt)
    have h2 : Function.Surjective
        ((r.stalkMap (b (genericPoint Xt)) ≫ b.stalkMap (genericPoint Xt)).hom) := by
      rw [CommRingCat.hom_comp, RingHom.coe_comp]
      exact hbsurj.comp (Scheme.Hom.stalkMap_surjective r (b (genericPoint Xt)))
    rw [e]
    exact h2

  have hgw : ∀ z : ↥(Limits.pullback g Φ),
      g (Limits.pullback.fst g Φ z) = Limits.pullback.snd g Φ z := by
    intro z
    have hc : (Limits.pullback.fst g Φ ≫ g) z = (Limits.pullback.snd g Φ ≫ Φ) z := by
      rw [Limits.pullback.condition]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hΦ.1] at hc
    exact hc
  obtain ⟨V₀, hV₀, hwV, -⟩ := exists_isAffineOpen_mem_and_subset (X := Q)
    (x := Limits.pullback.snd g Φ ((b ≫ r) (genericPoint Xt))) (U := ⊤) trivial
  have hfwV : Limits.pullback.fst g Φ ((b ≫ r) (genericPoint Xt)) ∈ g ⁻¹ᵁ V₀ :=
    (Scheme.Hom.mem_preimage g).mpr (by rw [hgw]; exact hwV)
  obtain ⟨U₀, hU₀, hwU, hUsub⟩ := exists_isAffineOpen_mem_and_subset hfwV
  have hUV : U₀ ≤ g ⁻¹ᵁ V₀ := fun y hy => hUsub hy
  have hVV : V₀ ≤ Φ ⁻¹ᵁ V₀ := fun y hy =>
    (Scheme.Hom.mem_preimage Φ).mpr (by rw [hΦ.1 y]; exact hy)
  obtain ⟨hW₀, hP⟩ := chart Q Γ g Φ V₀ hV₀ hVV U₀ hU₀ hUV
  have Hw : (b ≫ r) (genericPoint Xt) ∈
      Limits.pullback.fst g Φ ⁻¹ᵁ U₀ ⊓ Limits.pullback.snd g Φ ⁻¹ᵁ V₀ :=
    TopologicalSpace.Opens.mem_inf.mpr
      ⟨(Scheme.Hom.mem_preimage _).mpr hwU, (Scheme.Hom.mem_preimage _).mpr hwV⟩
  have hηU : genericPoint Γ ∈ U₀ := (genericPoint_specializes _).mem_open U₀.isOpen hwU

  letI := Fintype.ofFinite k
  obtain ⟨n, hp, hcard⟩ := FiniteField.card k (ringChar k)
  have hNat : Nat.card k = ringChar k ^ (n : ℕ) := by rw [Nat.card_eq_fintype_card, hcard]
  have hN : Nat.card k ^ m = ringChar k ^ ((n : ℕ) * m) := by rw [hNat, pow_mul]
  haveI := hC1
  haveI : ExpChar (Xt.presheaf.stalk (genericPoint Xt)) (ringChar k) := ExpChar.prime hp
  have hφ : ∀ a, (Φ.appLE V₀ V₀ hVV).hom a = a ^ (ringChar k ^ ((n : ℕ) * m)) := fun a => by
    rw [hΦ.2 V₀ hVV a, hN]
  have H := pf _ _ _ (g.appLE V₀ U₀ hUV) (Φ.appLE V₀ V₀ hVV) _ _ hP
    (Xt.presheaf.stalk (genericPoint Xt)) (ringChar k) ((n : ℕ) * m)
    ((Limits.pullback g Φ).presheaf.germ _ _ Hw ≫ (b ≫ r).stalkMap (genericPoint Xt)).hom hφ

  have compat : ∀ d : Γ(Γ, U₀),
      (Γ.presheaf.stalkSpecializes h₁ ≫
        (b ≫ r ≫ Limits.pullback.fst g Φ).stalkMap (genericPoint Xt)).hom
        ((Γ.presheaf.germ U₀ (genericPoint Γ) hηU).hom d) =
      ((Limits.pullback g Φ).presheaf.germ _ _ Hw ≫ (b ≫ r).stalkMap (genericPoint Xt)).hom
        (((Limits.pullback.fst g Φ).appLE U₀
          (Limits.pullback.fst g Φ ⁻¹ᵁ U₀ ⊓ Limits.pullback.snd g Φ ⁻¹ᵁ V₀) inf_le_left).hom d) := by
    intro d
    have hM : Γ.presheaf.germ U₀ (genericPoint Γ) hηU ≫ Γ.presheaf.stalkSpecializes h₁ ≫
        (b ≫ r ≫ Limits.pullback.fst g Φ).stalkMap (genericPoint Xt) =
        (Limits.pullback.fst g Φ).appLE U₀
          (Limits.pullback.fst g Φ ⁻¹ᵁ U₀ ⊓ Limits.pullback.snd g Φ ⁻¹ᵁ V₀) inf_le_left ≫
        (Limits.pullback g Φ).presheaf.germ _ _ Hw ≫ (b ≫ r).stalkMap (genericPoint Xt) := by
      rw [TopCat.Presheaf.germ_stalkSpecializes_assoc Γ.presheaf hηU h₁,
        Scheme.Hom.germ_stalkMap (b ≫ r ≫ Limits.pullback.fst g Φ),
        Scheme.Hom.appLE, Category.assoc (Scheme.Hom.app (Limits.pullback.fst g Φ) U₀),
        TopCat.Presheaf.germ_res_assoc,
        Scheme.Hom.germ_stalkMap (b ≫ r),
        ← Category.assoc (Scheme.Hom.app (Limits.pullback.fst g Φ) U₀),
        ← Scheme.Hom.comp_app (b ≫ r) (Limits.pullback.fst g Φ) U₀]
      exact key _ _ (Category.assoc _ _ _).symm U₀ _ _
    have e1 := congrArg (fun φ => φ.hom d) hM
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply] using e1
  have hS : ∀ c : Γ(Limits.pullback g Φ,
      Limits.pullback.fst g Φ ⁻¹ᵁ U₀ ⊓ Limits.pullback.snd g Φ ⁻¹ᵁ V₀), ∃ y,
      (Γ.presheaf.stalkSpecializes h₁ ≫
        (b ≫ r ≫ Limits.pullback.fst g Φ).stalkMap (genericPoint Xt)).hom y =
      ((Limits.pullback g Φ).presheaf.germ _ _ Hw ≫ (b ≫ r).stalkMap (genericPoint Xt)).hom c ^
        (Nat.card k ^ m) := by
    intro c
    obtain ⟨d, hd⟩ := H c
    exact ⟨(Γ.presheaf.germ U₀ (genericPoint Γ) hηU).hom d, by rw [compat, hd, hN]⟩
  exact alg _ _ _ _ _ ((b ≫ r).stalkMap (genericPoint Xt)).hom
    ((Limits.pullback g Φ).presheaf.germ _ _ Hw).hom (Nat.card k ^ m) hψsurj
    (frac _ _ hW₀ _ Hw) hS

theorem wcpa_dj_sgs_gc_generic_alg_closed : ∀ (Γ Q : Scheme.{u}) [AlgebraicGeometry.IsIntegral Γ] [AlgebraicGeometry.IsIntegral Q] (g : Γ ⟶ Q) (h : g (genericPoint Γ) ⤳ genericPoint Q), GeometricallyIrreducible (Limits.pullback.snd g (Q.fromSpecStalk (genericPoint Q))) → GeometricallyReduced (Limits.pullback.snd g (Q.fromSpecStalk (genericPoint Q))) → letI : Algebra (Q.presheaf.stalk (genericPoint Q)) (Γ.presheaf.stalk (genericPoint Γ)) := (Q.presheaf.stalkSpecializes h ≫ g.stalkMap (genericPoint Γ)).hom.toAlgebra; ∀ y : Γ.presheaf.stalk (genericPoint Γ), IsAlgebraic (Q.presheaf.stalk (genericPoint Q)) y → y ∈ Set.range (Q.presheaf.stalkSpecializes h ≫ g.stalkMap (genericPoint Γ)).hom :=
by
  intro Γ Q _ _ g h hGI hGR

  have C1 : ∀ (A B K L Ω : Type u) [CommRing A] [CommRing B] [Field K] [Field L] [Field Ω]
      [Algebra K Ω] (α : A →+* B) (β : A →+* K) (φ : K →+* L) (γ : B →+* L),
      (letI := β.toAlgebra; IsFractionRing A K) → Function.Injective γ → γ.comp α = φ.comp β →
      (letI := α.toAlgebra; letI := ((algebraMap K Ω).comp β).toAlgebra; letI := φ.toAlgebra;
        ∃ Θ : TensorProduct A B Ω →+* TensorProduct K L Ω, Function.Injective Θ ∧
          ∀ (b : B) (w : Ω), Θ (b ⊗ₜ[A] w) = γ b ⊗ₜ[K] w) := by
    intro A B K L Ω _ _ _ _ _ _ α β φ γ hfrac hγ hsq
    letI : Algebra A B := α.toAlgebra
    letI : Algebra A K := β.toAlgebra
    letI : Algebra K L := φ.toAlgebra
    letI : Algebra A Ω := ((algebraMap K Ω).comp β).toAlgebra
    letI : Algebra A L := (φ.comp β).toAlgebra
    haveI : IsScalarTower A K Ω := IsScalarTower.of_algebraMap_eq' rfl
    haveI : IsScalarTower A K L := IsScalarTower.of_algebraMap_eq' rfl
    haveI : IsFractionRing A K := hfrac
    letI : Algebra B (TensorProduct A K B) := Algebra.TensorProduct.rightAlgebra
    haveI hloc : IsLocalization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))
        (TensorProduct A K B) :=
      IsLocalization.tensorRight K (nonZeroDivisors A)
    have hcomm : ∀ a : A, γ (algebraMap A B a) = algebraMap A L a := fun a =>
      congrArg (fun f : A →+* L => f a) hsq
    let γA : B →ₐ[A] L := AlgHom.mk γ hcomm
    let lam : TensorProduct A K B →ₐ[K] L :=
      Algebra.TensorProduct.lift (Algebra.ofId K L) γA (fun _ _ => Commute.all _ _)
    have hlam1 : ∀ b : B, lam ((1 : K) ⊗ₜ b) = γ b := by
      intro b
      rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
      rfl
    have hlam : Function.Injective lam := by
      have := IsLocalization.injective_of_map_algebraMap_zero
        (M := Algebra.algebraMapSubmonoid B (nonZeroDivisors A)) (S := TensorProduct A K B)
        lam.toRingHom ?_
      · exact this
      intro b hb
      have h1 : algebraMap B (TensorProduct A K B) b = (1 : K) ⊗ₜ b := rfl
      rw [h1] at hb ⊢
      have h2 : lam.toRingHom ((1 : K) ⊗ₜ b) = γ b := hlam1 b
      rw [h2] at hb
      have : b = 0 := hγ (by rw [hb, map_zero])
      rw [this, TensorProduct.tmul_zero]
    let μ := Algebra.TensorProduct.map (AlgHom.id K Ω) lam
    have hμ : Function.Injective μ := by
      have heq : ⇑μ = ⇑(LinearMap.lTensor Ω lam.toLinearMap) := by
        funext x
        induction x using TensorProduct.induction_on with
        | zero => simp
        | tmul w l => simp [μ]
        | add x y hx hy => simp only [map_add, hx, hy]
      rw [heq]
      exact Module.Flat.lTensor_preserves_injective_linearMap _ hlam
    let cb := Algebra.TensorProduct.cancelBaseChange A K K Ω B
    let cA := Algebra.TensorProduct.comm A B Ω
    let cF := Algebra.TensorProduct.comm K Ω L
    let Θ : TensorProduct A B Ω →+* TensorProduct K L Ω :=
      (cF.toRingEquiv.toRingHom.comp μ.toRingHom).comp
        (cb.symm.toRingEquiv.toRingHom.comp cA.toRingEquiv.toRingHom)
    have hΘ : Function.Injective Θ := by
      intro x y hxy
      apply cA.injective
      apply cb.symm.injective
      apply hμ
      apply cF.injective
      exact hxy
    refine ⟨Θ, hΘ, fun b w => ?_⟩
    show (Algebra.TensorProduct.comm K Ω L)
      ((Algebra.TensorProduct.map (AlgHom.id K Ω) lam)
        ((Algebra.TensorProduct.cancelBaseChange A K K Ω B).symm
          ((Algebra.TensorProduct.comm A B Ω) (b ⊗ₜ[A] w)))) = γ b ⊗ₜ[K] w
    rw [Algebra.TensorProduct.comm_tmul, Algebra.TensorProduct.cancelBaseChange_symm_tmul,
      Algebra.TensorProduct.map_tmul, AlgHom.id_apply, Algebra.TensorProduct.comm_tmul, hlam1]

  have C2 : ∀ (A B K L Ω : Type u) [CommRing A] [CommRing B] [Field K] [Field L] [Field Ω]
      [Algebra K Ω] (α : A →+* B) (β : A →+* K) (φ : K →+* L) (γ : B →+* L),
      (letI := γ.toAlgebra; IsFractionRing B L) →
      (letI := α.toAlgebra; letI := ((algebraMap K Ω).comp β).toAlgebra; letI := φ.toAlgebra;
        ∀ Θ : TensorProduct A B Ω →+* TensorProduct K L Ω,
          (∀ (b : B) (w : Ω), Θ (b ⊗ₜ[A] w) = γ b ⊗ₜ[K] w) →
          ∀ x : TensorProduct K L Ω, ∃ t r : TensorProduct A B Ω, IsUnit (Θ t) ∧ Θ t * x = Θ r) := by
    intro A B K L Ω _ _ _ _ _ _ α β φ γ hfrac
    letI : Algebra A B := α.toAlgebra
    letI : Algebra A Ω := ((algebraMap K Ω).comp β).toAlgebra
    letI : Algebra K L := φ.toAlgebra
    intro Θ hΘ x
    induction x using TensorProduct.induction_on with
    | zero => exact ⟨1, 0, by rw [map_one]; exact isUnit_one, by rw [mul_zero, map_zero]⟩
    | tmul l w =>
      letI : Algebra B L := γ.toAlgebra
      haveI : IsFractionRing B L := hfrac
      obtain ⟨⟨b, s⟩, rfl⟩ := IsLocalization.mk'_surjective (nonZeroDivisors B) l
      have hs : IsLocalization.mk' L b s * γ s = γ b := IsLocalization.mk'_spec L b s
      have hu : IsUnit (γ s) := IsLocalization.map_units L s
      refine ⟨(s : B) ⊗ₜ[A] (1 : Ω), b ⊗ₜ[A] w, ?_, ?_⟩
      · rw [hΘ]
        have := hu.map (Algebra.TensorProduct.includeLeftRingHom (R := K) (A := L) (B := Ω))
        exact this
      · rw [hΘ, hΘ, Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_comm, hs]
    | add x₁ x₂ h₁ h₂ =>
      obtain ⟨t₁, r₁, hu₁, he₁⟩ := h₁
      obtain ⟨t₂, r₂, hu₂, he₂⟩ := h₂
      refine ⟨t₁ * t₂, t₂ * r₁ + t₁ * r₂, by rw [map_mul]; exact hu₁.mul hu₂, ?_⟩
      simp only [map_mul, map_add]
      rw [← he₁, ← he₂]
      ring

  have C3 : ∀ (R S : Type u) [CommRing R] [CommRing S] [IsDomain R] (Θ : R →+* S),
      Function.Injective Θ → (∀ x : S, ∃ t r : R, IsUnit (Θ t) ∧ Θ t * x = Θ r) →
      id (IsDomain S) := by
    intro R S _ _ _ Θ hΘ hfr
    haveI : Nontrivial S :=
      ⟨⟨0, 1, fun h0 => zero_ne_one (hΘ (by rw [map_zero, map_one]; exact h0))⟩⟩
    haveI : NoZeroDivisors S := ⟨fun {x x'} hxx => by
      obtain ⟨t, r, hu, he⟩ := hfr x
      obtain ⟨t', r', hu', he'⟩ := hfr x'
      have h0 : Θ (r * r') = Θ 0 := by
        rw [map_mul, ← he, ← he', map_zero]
        calc Θ t * x * (Θ t' * x') = Θ t * Θ t' * (x * x') := by ring
          _ = 0 := by rw [hxx, mul_zero]
      rcases mul_eq_zero.mp (hΘ h0) with h1 | h1
      · left
        rw [h1, map_zero] at he
        exact hu.mul_right_eq_zero.mp he
      · right
        rw [h1, map_zero] at he'
        exact hu'.mul_right_eq_zero.mp he'⟩
    exact NoZeroDivisors.to_isDomain S

  have C4 : ∀ {Γ Q Z : Scheme.{u}} (g : Γ ⟶ Q) (Ω : Type u) [Field Ω] (c : Spec (.of Ω) ⟶ Q)
      (p : Z ⟶ Γ) (q : Z ⟶ Spec (.of Ω)), IsPullback p q g c → AlgebraicGeometry.IsIntegral Z →
      ∀ (U : Q.Opens) (hU : IsAffineOpen U) (V : Γ.Opens), IsAffineOpen V →
      ∀ (e : V ≤ g ⁻¹ᵁ U) (ψ : Γ(Q, U) ⟶ CommRingCat.of Ω), c = Spec.map ψ ≫ hU.fromSpec →
      id (letI := (g.appLE U V e).hom.toAlgebra; letI := ψ.hom.toAlgebra;
        Nontrivial (TensorProduct Γ(Q, U) Γ(Γ, V) Ω) →
          IsDomain (TensorProduct Γ(Q, U) Γ(Γ, V) Ω)) := by
    intro Γ Q Z g Ω _ c p q G hZ U hU V hV e ψ hc
    letI : Algebra Γ(Q, U) Γ(Γ, V) := (g.appLE U V e).hom.toAlgebra
    letI : Algebra Γ(Q, U) Ω := ψ.hom.toAlgebra
    intro hT
    have H1 := isPullback_SpecMap_of_isPushout _ _ _ _
      (CommRingCat.isPushout_tensorProduct Γ(Q, U) Γ(Γ, V) Ω)
    have hmono : ∀ {P X Y W M : Scheme.{u}} {fst : P ⟶ X} {snd : P ⟶ Y} {f₁ : X ⟶ W}
        {f₂ : Y ⟶ W} (i : W ⟶ M) [Mono i], IsPullback fst snd f₁ f₂ →
        IsPullback fst snd (f₁ ≫ i) (f₂ ≫ i) := by
      intro P X Y W M fst snd f₁ f₂ i _ H
      refine IsPullback.mk' (by rw [← Category.assoc, H.w, Category.assoc])
        (fun T φ φ' h1 h2 => H.hom_ext h1 h2) (fun T a b hab => ?_)
      have hab' : a ≫ f₁ = b ≫ f₂ := by
        rw [← cancel_mono i]; simpa only [Category.assoc] using hab
      exact ⟨H.lift a b hab', H.lift_fst a b hab', H.lift_snd a b hab'⟩
    have H2 := hmono hU.fromSpec H1
    have e1 : Spec.map (CommRingCat.ofHom (algebraMap Γ(Q, U) Γ(Γ, V))) ≫ hU.fromSpec =
        hV.fromSpec ≫ g :=
      IsAffineOpen.SpecMap_appLE_fromSpec g hU hV e
    have e2 : Spec.map (CommRingCat.ofHom (algebraMap Γ(Q, U) Ω)) ≫ hU.fromSpec = c := hc.symm
    rw [e1, e2] at H2
    have H3 := (isPullback_morphismRestrict p V).paste_vert G
    have H4 : IsPullback ((p ∣_ V) ≫ hV.isoSpec.hom) ((p ⁻¹ᵁ V).ι ≫ q) (hV.fromSpec ≫ g) c := by
      refine IsPullback.of_iso H3 (Iso.refl _) hV.isoSpec (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
      · simp
      · simp
      · rw [← IsAffineOpen.isoSpec_inv_ι hV]; simp
      · simp
    let ε := IsPullback.isoIsPullback _ _ H2 H4
    haveI : Nonempty (p ⁻¹ᵁ V).toScheme := by
      obtain ⟨x⟩ := (inferInstance :
        Nonempty (Spec (CommRingCat.of (TensorProduct Γ(Q, U) Γ(Γ, V) Ω))))
      exact ⟨ε.hom x⟩
    haveI : AlgebraicGeometry.IsIntegral (p ⁻¹ᵁ V).toScheme :=
      isIntegral_of_isOpenImmersion (p ⁻¹ᵁ V).ι
    haveI : AlgebraicGeometry.IsIntegral
        (Spec (CommRingCat.of (TensorProduct Γ(Q, U) Γ(Γ, V) Ω))) :=
      isIntegral_of_isOpenImmersion ε.hom
    exact (affine_isIntegral_iff (CommRingCat.of (TensorProduct Γ(Q, U) Γ(Γ, V) Ω))).mp this

  have C5 : ∀ {Γ Q T : Scheme.{u}} (g : Γ ⟶ Q) (ι : T ⟶ Q),
      GeometricallyIrreducible (Limits.pullback.snd g ι) →
      GeometricallyReduced (Limits.pullback.snd g ι) →
      ∀ (Ω : Type u) [Field Ω] (y : Spec (.of Ω) ⟶ T),
        id (AlgebraicGeometry.IsIntegral (Limits.pullback (Limits.pullback.snd g ι) y)) ∧
        IsPullback (Limits.pullback.fst (Limits.pullback.snd g ι) y ≫ Limits.pullback.fst g ι)
          (Limits.pullback.snd (Limits.pullback.snd g ι) y) g (y ≫ ι) := by
    intro Γ Q T g ι hGI hGR Ω _ y
    have H₀ := IsPullback.of_hasPullback (Limits.pullback.snd g ι) y
    haveI : IrreducibleSpace ↥(Limits.pullback (Limits.pullback.snd g ι) y) :=
      hGI.geometrically_irreducibleSpace y _ _ H₀
    haveI : AlgebraicGeometry.IsReduced (Limits.pullback (Limits.pullback.snd g ι) y) :=
      hGR.geometrically_isReduced y _ _ H₀
    exact ⟨isIntegral_of_irreducibleSpace_of_isReduced _,
      H₀.paste_horiz (IsPullback.of_hasPullback g ι)⟩

  have C6 : ∀ (K L E : Type u) [Field K] [Field L] [Field E] [Algebra K L] [Algebra K E]
      [FiniteDimensional K E] (j : E →ₐ[K] L), IsDomain (TensorProduct K L E) →
      Module.finrank K E = 1 := by
    intro K L E _ _ _ _ _ _ j hdom
    let ρ : TensorProduct K E E →ₐ[K] TensorProduct K L E :=
      Algebra.TensorProduct.map j (AlgHom.id K E)
    have hρ : Function.Injective ρ := by
      have heq : ⇑ρ = ⇑(LinearMap.rTensor E j.toLinearMap) := by
        funext x
        induction x using TensorProduct.induction_on with
        | zero => simp
        | tmul a b => simp [ρ]
        | add x y hx hy => simp only [map_add, hx, hy]
      rw [heq]
      exact Module.Flat.rTensor_preserves_injective_linearMap _ j.toRingHom.injective
    haveI : IsDomain (TensorProduct K E E) := Function.Injective.isDomain ρ.toRingHom hρ
    let m : TensorProduct K E E →ₐ[K] E := Algebra.TensorProduct.lmul' K
    have hinj : Function.Injective m := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      by_contra hx0
      obtain ⟨x', hx'⟩ := FiniteDimensional.exists_mul_eq_one K hx0
      have h3 := congrArg m hx'
      rw [map_mul, hx, zero_mul, map_one] at h3
      exact zero_ne_one h3
    have hsurj : Function.Surjective m := fun a => ⟨a ⊗ₜ 1, by simp [m]⟩
    have h1 : Module.finrank K (TensorProduct K E E) = Module.finrank K E :=
      LinearEquiv.finrank_eq (LinearEquiv.ofBijective m.toLinearMap ⟨hinj, hsurj⟩)
    have h2 : Module.finrank K (TensorProduct K E E) = Module.finrank K E * Module.finrank K E :=
      Module.finrank_tensorProduct
    have hpos : 0 < Module.finrank K E := Module.finrank_pos
    rw [h1] at h2
    exact Nat.eq_of_mul_eq_mul_left hpos (h2.symm.trans (mul_one _).symm)

  have C7 : ∀ (U : Q.Opens) (hηU : genericPoint Q ∈ U) (V : Γ.Opens) (hηV : genericPoint Γ ∈ V)
      (e : V ≤ g ⁻¹ᵁ U), g.appLE U V e ≫ Γ.presheaf.germ V (genericPoint Γ) hηV =
      Q.presheaf.germ U (genericPoint Q) hηU ≫ Q.presheaf.stalkSpecializes h ≫
        g.stalkMap (genericPoint Γ) := by
    intro U hηU V hηV e
    rw [← Category.assoc, TopCat.Presheaf.germ_stalkSpecializes, Scheme.Hom.germ_stalkMap,
      Scheme.Hom.appLE, Category.assoc, TopCat.Presheaf.germ_res]

  intro y hy
  letI : Algebra (Q.presheaf.stalk (genericPoint Q)) (Γ.presheaf.stalk (genericPoint Γ)) :=
    (Q.presheaf.stalkSpecializes h ≫ g.stalkMap (genericPoint Γ)).hom.toAlgebra
  have hyI : IsIntegral (Q.presheaf.stalk (genericPoint Q)) y := hy.isIntegral
  let E := IntermediateField.adjoin (Q.presheaf.stalk (genericPoint Q)) {y}
  haveI : FiniteDimensional (Q.presheaf.stalk (genericPoint Q)) E :=
    IntermediateField.adjoin.finiteDimensional hyI
  let ψ₀ : Q.presheaf.stalk (genericPoint Q) ⟶ CommRingCat.of E :=
    CommRingCat.ofHom (algebraMap (Q.presheaf.stalk (genericPoint Q)) E)
  let yE : Spec (CommRingCat.of E) ⟶ Spec (Q.presheaf.stalk (genericPoint Q)) := Spec.map ψ₀
  obtain ⟨hZ, G⟩ := C5 g (Q.fromSpecStalk (genericPoint Q)) hGI hGR E yE
  obtain ⟨U, hU, hηU, -⟩ :=
    exists_isAffineOpen_mem_and_subset (x := genericPoint Q) (U := ⊤) trivial
  have hgU : g (genericPoint Γ) ∈ U := h.mem_open U.isOpen hηU
  obtain ⟨V, hV, hηV, hVU⟩ :=
    exists_isAffineOpen_mem_and_subset (x := genericPoint Γ) (U := g ⁻¹ᵁ U) hgU
  have e : V ≤ g ⁻¹ᵁ U := fun x hx => hVU hx
  have hc : yE ≫ Q.fromSpecStalk (genericPoint Q) =
      Spec.map (Q.presheaf.germ U (genericPoint Q) hηU ≫ ψ₀) ≫ hU.fromSpec := by
    rw [← IsAffineOpen.fromSpecStalk_eq_fromSpecStalk hU hηU, IsAffineOpen.fromSpecStalk,
      Spec.map_comp, Category.assoc]
  have hfrac : (letI := (Q.presheaf.germ U (genericPoint Q) hηU).hom.toAlgebra;
      IsFractionRing Γ(Q, U) (Q.presheaf.stalk (genericPoint Q))) := by
    letI : Nonempty U := ⟨⟨_, hηU⟩⟩
    exact functionField_isFractionRing_of_isAffineOpen Q U hU
  have hfracB : (letI := (Γ.presheaf.germ V (genericPoint Γ) hηV).hom.toAlgebra;
      IsFractionRing Γ(Γ, V) (Γ.presheaf.stalk (genericPoint Γ))) := by
    letI : Nonempty V := ⟨⟨_, hηV⟩⟩
    exact functionField_isFractionRing_of_isAffineOpen Γ V hV
  have hγ : Function.Injective (Γ.presheaf.germ V (genericPoint Γ) hηV).hom := by
    letI : Nonempty V := ⟨⟨_, hηV⟩⟩
    letI := (Γ.presheaf.germ V _ hηV).hom.toAlgebra
    haveI : IsFractionRing Γ(Γ, V) (Γ.presheaf.stalk (genericPoint Γ)) :=
      functionField_isFractionRing_of_isAffineOpen Γ V hV
    exact IsFractionRing.injective Γ(Γ, V) (Γ.presheaf.stalk (genericPoint Γ))
  have hsq : (Γ.presheaf.germ V (genericPoint Γ) hηV).hom.comp (g.appLE U V e).hom =
      (Q.presheaf.stalkSpecializes h ≫ g.stalkMap (genericPoint Γ)).hom.comp
        (Q.presheaf.germ U (genericPoint Q) hηU).hom :=
    congrArg CommRingCat.Hom.hom (C7 U hηU V hηV e)
  obtain ⟨Θ, hΘi, hΘf⟩ := C1 Γ(Q, U) Γ(Γ, V) (Q.presheaf.stalk (genericPoint Q))
    (Γ.presheaf.stalk (genericPoint Γ)) E (g.appLE U V e).hom
    (Q.presheaf.germ U (genericPoint Q) hηU).hom
    (Q.presheaf.stalkSpecializes h ≫ g.stalkMap (genericPoint Γ)).hom
    (Γ.presheaf.germ V (genericPoint Γ) hηV).hom hfrac hγ hsq
  have hNT := RingHom.domain_nontrivial Θ
  have hdomB := C4 g E (yE ≫ Q.fromSpecStalk (genericPoint Q)) _ _ G hZ U hU V hV e
    (Q.presheaf.germ U (genericPoint Q) hηU ≫ ψ₀) hc hNT
  have hfr := C2 Γ(Q, U) Γ(Γ, V) (Q.presheaf.stalk (genericPoint Q))
    (Γ.presheaf.stalk (genericPoint Γ)) E (g.appLE U V e).hom
    (Q.presheaf.germ U (genericPoint Q) hηU).hom
    (Q.presheaf.stalkSpecializes h ≫ g.stalkMap (genericPoint Γ)).hom
    (Γ.presheaf.germ V (genericPoint Γ) hηV).hom hfracB Θ hΘf
  have hdomL := @C3 _ _ _ _ hdomB Θ hΘi hfr
  have hrank : Module.finrank (Q.presheaf.stalk (genericPoint Q)) E = 1 :=
    C6 _ _ _ (IntermediateField.val E) hdomL
  have hbot : E = ⊥ := IntermediateField.finrank_eq_one_iff.mp hrank
  have hyE : y ∈ E := IntermediateField.mem_adjoin_simple_self _ y
  rw [hbot, IntermediateField.mem_bot] at hyE
  exact hyE

theorem wcpa_dj_sgs_geom_connected : ∀ (k : Type u) [Field k] [Finite k] (Γ Q : Scheme.{u}) [AlgebraicGeometry.IsIntegral Γ] [AlgebraicGeometry.IsIntegral Q] (sQ : Q ⟶ Spec (.of k)) [IsProper sQ] (g : Γ ⟶ Q) [IsProper g] (m : ℕ) (Φ : Q ⟶ Q), wcIsAbsFrob Φ (Nat.card k ^ m) → Φ ≫ sQ = sQ → GeometricallyIrreducible (Limits.pullback.snd g (Q.fromSpecStalk (genericPoint Q))) → GeometricallyReduced (Limits.pullback.snd g (Q.fromSpecStalk (genericPoint Q))) → ∀ (R : Scheme.{u}) [AlgebraicGeometry.IsIntegral R] (r : R ⟶ Limits.pullback g Φ), IsClosedImmersion r → Surjective r → ∀ (Xt : Scheme.{u}) [AlgebraicGeometry.IsIntegral Xt] (b : Xt ⟶ R), IsFinite b → Surjective b → (∃ U : R.Opens, U ≠ ⊥ ∧ IsIso (b ∣_ U)) → IsProper (b ≫ r ≫ Limits.pullback.snd g Φ) → SmoothOfRelativeDimension 1 (Limits.pullback.snd (b ≫ r ≫ Limits.pullback.snd g Φ) (Q.fromSpecStalk (genericPoint Q))) → GeometricallyConnected (Limits.pullback.snd (b ≫ r ≫ Limits.pullback.snd g Φ) (Q.fromSpecStalk (genericPoint Q))) :=
by
  intro k _ _ Γ Q _ _ sQ _ g _ m Φ hΦfrob hΦs hGI hGR R _ r hrci hrs Xt _ b hbfin hbs hbU hfp hsm
  classical
  haveI := hrs
  haveI := hbs

  have hstein : ∀ (f : Xt ⟶ Q) (hη : f (genericPoint Xt) = genericPoint Q) [IsProper f]
      (hsm1 : SmoothOfRelativeDimension 1 (Limits.pullback.snd f (Q.fromSpecStalk (genericPoint Q)))),
      (∀ (x : Xt.presheaf.stalk (genericPoint Xt)) (P : Polynomial (Q.presheaf.stalk (genericPoint Q))),
        P ≠ 0 → P.eval₂ (Q.presheaf.stalkSpecializes (specializes_of_eq hη) ≫
          f.stalkMap (genericPoint Xt)).hom x = 0 →
        x ∈ Set.range (Q.presheaf.stalkSpecializes (specializes_of_eq hη) ≫
          f.stalkMap (genericPoint Xt)).hom) →
      GeometricallyConnected (Limits.pullback.snd f (Q.fromSpecStalk (genericPoint Q))) := by
    intro f hη _ hsm1 hcl

    have hdom : ∀ w, IsDomain ((Limits.pullback f (Q.fromSpecStalk (genericPoint Q))).presheaf.stalk w) :=
      fun w => @wcpa_smooth_stalk_isDomain (Q.presheaf.stalk (genericPoint Q)) _ _
        (Limits.pullback.snd f (Q.fromSpecStalk (genericPoint Q))) 1 hsm1 w
    obtain ⟨y₁, hy₁, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := f)
      (g := Q.fromSpecStalk (genericPoint Q)) (genericPoint Xt)
      (IsLocalRing.closedPoint (Q.presheaf.stalk (genericPoint Q)))
      (by rw [Scheme.fromSpecStalk_closedPoint]; exact hη)
    have hemb := IsPreimmersion.isEmbedding (Limits.pullback.fst f (Q.fromSpecStalk (genericPoint Q)))
    have hspec : ∀ y, y₁ ⤳ y := fun y =>
      hemb.toIsInducing.specializes_iff.mp (by rw [hy₁]; exact genericPoint_specializes _)
    have huniv : (Set.univ : Set ↥(Limits.pullback f (Q.fromSpecStalk (genericPoint Q)))) =
        closure ({y₁} : Set _) :=
      (Set.eq_univ_of_forall (fun y => specializes_iff_mem_closure.mp (hspec y))).symm
    haveI hirrY : IrreducibleSpace ↥(Limits.pullback f (Q.fromSpecStalk (genericPoint Q))) :=
