        _ = ∑ l, c' l * (w * (σ l * β)) := Finset.sum_congr rfl (fun l _ => by rw [hrel l])
        _ = _ := by
            rw [Finset.mul_sum, Finset.sum_mul]; exact Finset.sum_congr rfl (fun l _ => by ring)
    have hrel' : ∀ l, σ l * β = wi * (σ' l * β') := fun l => by
      rw [hrel l, ← mul_assoc, hwi, one_mul]
    have h2 : β = (wi * ∑ l, c l * σ' l) * β' := by
      calc β = (∑ l, c l * σ l) * β := by rw [hc, one_mul]
        _ = ∑ l, c l * (σ l * β) := by
            rw [Finset.sum_mul]; exact Finset.sum_congr rfl (fun l _ => by ring)
        _ = ∑ l, c l * (wi * (σ' l * β')) := Finset.sum_congr rfl (fun l _ => by rw [hrel' l])
        _ = _ := by
            rw [Finset.mul_sum, Finset.sum_mul]; exact Finset.sum_congr rfl (fun l _ => by ring)
    generalize w * ∑ l, c' l * σ l = u at h1
    generalize wi * ∑ l, c l * σ' l = u' at h2
    have h3 : u' * u = 1 := by
      have h0 : (u' * u - 1) * β = 0 := by
        rw [sub_mul, one_mul, mul_assoc, ← h1, ← h2, sub_self]
      exact sub_eq_zero.mp ((mul_right_mem_nonZeroDivisors_eq_zero_iff hβ).mp h0)
    have h4 : ∀ l, σ' l * u = w * σ l := by
      intro l
      apply (mul_cancel_right_mem_nonZeroDivisors hβ).mp
      rw [mul_assoc (σ' l), ← h1, hrel l, mul_assoc]
    refine ⟨w * u', hw.mul (isUnit_iff_exists_inv.mpr ⟨u, h3⟩), fun l => ?_⟩
    calc σ' l = σ' l * (u' * u) := by rw [h3, mul_one]
      _ = (σ' l * u) * u' := by ring
      _ = w * u' * σ l := by rw [h4 l]; ring

  intro X fX I n m U hU g w hcov hI hw htr T h hP

  have NZR : ∀ (W O : T.Opens) (hOW : O ≤ W), IsAffineOpen W → ∀ b : Γ(T, W),
      b ∈ nonZeroDivisors Γ(T, W) → T.presheaf.map (homOfLE hOW).op b ∈ nonZeroDivisors Γ(T, O) := by
    intro W O hOW hW b hb
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    refine TopCat.Presheaf.section_ext T.sheaf O x 0 (fun p hp => ?_)
    obtain ⟨f, hfO, hpf⟩ := hW.exists_basicOpen_le (V := O) ⟨p, hp⟩ (hOW hp)
    letI : Algebra Γ(T, W) Γ(T, T.basicOpen f) :=
      (T.presheaf.map (homOfLE (T.basicOpen_le f)).op).hom.toAlgebra
    have hL : IsLocalization.Away f Γ(T, T.basicOpen f) := hW.isLocalization_basicOpen f
    have hy0 : T.presheaf.map (homOfLE hfO).op x = 0 := by
      obtain ⟨⟨z, s⟩, hz⟩ := IsLocalization.surj (Submonoid.powers f)
        (T.presheaf.map (homOfLE hfO).op x)
      have hab : ∀ a : Γ(T, W), algebraMap Γ(T, W) Γ(T, T.basicOpen f) a =
          T.presheaf.map (homOfLE (T.basicOpen_le f)).op a := fun a => rfl
      have h1 : algebraMap Γ(T, W) Γ(T, T.basicOpen f) (z * b) = 0 := by
        have e : algebraMap Γ(T, W) Γ(T, T.basicOpen f) (z * b) =
            T.presheaf.map (homOfLE hfO).op (x * T.presheaf.map (homOfLE hOW).op b) *
              algebraMap Γ(T, W) Γ(T, T.basicOpen f) (s : Γ(T, W)) := by
          rw [map_mul, ← hz, hab b, ← hres T W O _ hOW hfO (T.basicOpen_le f) b, map_mul]
          ring
        rw [e, hx, map_zero, zero_mul]
      obtain ⟨c, hc⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.powers f) _ _).mp h1
      have h2 : (c : Γ(T, W)) * z = 0 := by
        apply (mul_right_mem_nonZeroDivisors_eq_zero_iff hb).mp
        rw [mul_assoc]; exact hc
      have h3 : algebraMap Γ(T, W) Γ(T, T.basicOpen f) z = 0 := by
        have hu := IsLocalization.map_units Γ(T, T.basicOpen f) c
        apply (hu.mul_right_eq_zero).mp
        rw [← map_mul, h2, map_zero]
      have hu := IsLocalization.map_units Γ(T, T.basicOpen f) s
      rw [h3] at hz
      exact (hu.mul_left_eq_zero).mp hz
    have hg := TopCat.Presheaf.germ_res_apply T.presheaf (homOfLE hfO) p hpf x
    rw [hy0, map_zero] at hg
    exact hg.symm.trans (map_zero _).symm

  have hpt : ∀ t : T, ∃ J, h t ∈ U J := by
    intro t
    have hx : h t ∈ (⨆ J, U J) := by rw [hcov]; trivial
    exact TopologicalSpace.Opens.mem_iSup.mp hx
  choose Jt hJt using hpt

  have LOC : ∀ t : T, ∃ (W : T.Opens) (_ : IsAffineOpen W) (hW : W ≤ h ⁻¹ᵁ U (Jt t)) (b : Γ(T, W)),
      t ∈ W ∧ b ∈ nonZeroDivisors Γ(T, W) ∧
      Ideal.map (h.appLE (U (Jt t)) W hW).hom (I.ideal ⟨U (Jt t), hU (Jt t)⟩) = Ideal.span {b} := by
    intro t
    obtain ⟨U₁, V₁, e₁, a₁, htV, -, hnzd, hId⟩ := hP t
    have hD0 : h t ∈ U₁.1 ⊓ U (Jt t) := TopologicalSpace.Opens.mem_inf.mpr ⟨e₁ htV, hJt t⟩
    obtain ⟨D, hDa, hDt, hDsub⟩ := exists_isAffineOpen_mem_and_subset hD0
    have hDU₁ : D ≤ U₁.1 := fun x hx => (TopologicalSpace.Opens.mem_inf.mp (hDsub hx)).1
    have hDU : D ≤ U (Jt t) := fun x hx => (TopologicalSpace.Opens.mem_inf.mp (hDsub hx)).2
    have htVD : t ∈ V₁.1 ⊓ h ⁻¹ᵁ D := TopologicalSpace.Opens.mem_inf.mpr ⟨htV, hDt⟩
    obtain ⟨f, hfle, htf⟩ := V₁.2.exists_basicOpen_le (V := V₁.1 ⊓ h ⁻¹ᵁ D) ⟨t, htVD⟩ htV
    have hWV : T.basicOpen f ≤ V₁.1 := le_trans hfle inf_le_left
    have eD : T.basicOpen f ≤ h ⁻¹ᵁ D := le_trans hfle inf_le_right
    have hW : T.basicOpen f ≤ h ⁻¹ᵁ U (Jt t) := le_trans eD (Scheme.Hom.preimage_mono h hDU)
    have e₁' : T.basicOpen f ≤ h ⁻¹ᵁ U₁.1 := le_trans eD (Scheme.Hom.preimage_mono h hDU₁)
    refine ⟨T.basicOpen f, V₁.2.basicOpen f, hW,
      T.presheaf.map (homOfLE hWV).op ((h.appLE U₁.1 V₁.1 e₁).hom a₁), htf,
      NZR _ _ hWV V₁.2 _ hnzd, ?_⟩
    have key : ∀ (Y : X.affineOpens) (hDY : D ≤ Y.1) (eY : T.basicOpen f ≤ h ⁻¹ᵁ Y.1),
        Ideal.map (h.appLE Y.1 (T.basicOpen f) eY).hom (I.ideal Y) =
          Ideal.map (h.appLE D (T.basicOpen f) eD).hom (I.ideal ⟨D, hDa⟩) := by
      intro Y hDY eY
      have hfac : h.appLE Y.1 (T.basicOpen f) eY =
          X.presheaf.map (homOfLE hDY).op ≫ h.appLE D (T.basicOpen f) eD :=
        (Scheme.Hom.map_appLE h eD (homOfLE hDY).op).symm
      rw [hfac, CommRingCat.hom_comp, ← Ideal.map_map]
      congr 1
      exact I.map_ideal (U := ⟨D, hDa⟩) (V := Y) hDY
    have k1 : Ideal.map (h.appLE (U (Jt t)) (T.basicOpen f) hW).hom (I.ideal ⟨U (Jt t), hU (Jt t)⟩) =
        Ideal.map (h.appLE D (T.basicOpen f) eD).hom (I.ideal ⟨D, hDa⟩) :=
      key ⟨U (Jt t), hU (Jt t)⟩ hDU hW
    have k2 : Ideal.map (h.appLE U₁.1 (T.basicOpen f) e₁').hom (I.ideal U₁) =
        Ideal.map (h.appLE D (T.basicOpen f) eD).hom (I.ideal ⟨D, hDa⟩) := key U₁ hDU₁ e₁'
    have hfac2 : h.appLE U₁.1 (T.basicOpen f) e₁' =
        h.appLE U₁.1 V₁.1 e₁ ≫ T.presheaf.map (homOfLE hWV).op :=
      (Scheme.Hom.appLE_map h e₁ (homOfLE hWV).op).symm
    rw [k1, ← k2, hfac2, CommRingCat.hom_comp, ← Ideal.map_map, hId, Ideal.map_span,
      Set.image_singleton]
    try rfl
  choose W hWa hW b htW hbnzd hId using LOC

  have COF : ∀ t, ∃ σ c : Fin (m + 1) → Γ(T, W t),
      (∀ l, h.appLE (U (Jt t)) (W t) (hW t) (g (Jt t) l) = σ l * b t) ∧ ∑ l, c l * σ l = 1 := by
    intro t
    have H := hId t
    rw [hI (Jt t), Ideal.map_span, ← Set.range_comp] at H
    have hσ : ∀ l, ∃ s, s * b t = h.appLE (U (Jt t)) (W t) (hW t) (g (Jt t) l) := by
      intro l
      have hm : (h.appLE (U (Jt t)) (W t) (hW t)).hom (g (Jt t) l) ∈ Ideal.span {b t} := by
        rw [← H]; exact Ideal.subset_span ⟨l, rfl⟩
      exact Ideal.mem_span_singleton'.mp hm
    choose σ hσ using hσ
    have hb : b t ∈ Ideal.span (Set.range ((h.appLE (U (Jt t)) (W t) (hW t)).hom ∘ g (Jt t))) := by
      rw [H]; exact Ideal.mem_span_singleton_self _
    obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hb
    refine ⟨σ, c, fun l => (hσ l).symm, ?_⟩
    have e : (∑ l, c l * σ l - 1) * b t = 0 := by
      rw [sub_mul, one_mul, Finset.sum_mul, sub_eq_zero]
      conv_rhs => rw [← hc]
      refine Finset.sum_congr rfl (fun l _ => ?_)
      show c l * σ l * b t = c l * h.appLE (U (Jt t)) (W t) (hW t) (g (Jt t) l)
      rw [mul_assoc, hσ l]
    exact sub_eq_zero.mp ((mul_right_mem_nonZeroDivisors_eq_zero_iff (hbnzd t)).mp e)
  choose σ c hσ hc using COF

  have TU : ∀ t t', ∃ v : Γ(T, W t ⊓ W t'), IsUnit v ∧ ∀ l,
      T.presheaf.map (homOfLE (inf_le_right : W t ⊓ W t' ≤ W t')).op (σ t' l) =
        v * T.presheaf.map (homOfLE (inf_le_left : W t ⊓ W t' ≤ W t)).op (σ t l) := by
    intro t t'
    have e : W t ⊓ W t' ≤ h ⁻¹ᵁ (U (Jt t) ⊓ U (Jt t')) := by
      rw [Scheme.Hom.preimage_inf]; exact inf_le_inf (hW t) (hW t')
    have PT : ∀ l, T.presheaf.map (homOfLE (inf_le_right : W t ⊓ W t' ≤ W t')).op
          (h.appLE (U (Jt t')) (W t') (hW t') (g (Jt t') l)) =
        h.appLE (U (Jt t) ⊓ U (Jt t')) (W t ⊓ W t') e (w (Jt t) (Jt t')) *
          T.presheaf.map (homOfLE (inf_le_left : W t ⊓ W t' ≤ W t)).op
            (h.appLE (U (Jt t)) (W t) (hW t) (g (Jt t) l)) := by
      intro l
      rw [hAmap h (U (Jt t')) (W t') (W t ⊓ W t') inf_le_right (hW t') (le_trans inf_le_right (hW t')),
        hAmap h (U (Jt t)) (W t) (W t ⊓ W t') inf_le_left (hW t) (le_trans inf_le_left (hW t)),
        ← hmapA h (U (Jt t) ⊓ U (Jt t')) (U (Jt t')) (W t ⊓ W t') inf_le_right e
          (le_trans inf_le_right (hW t')),
        htr, map_mul,
        hmapA h (U (Jt t) ⊓ U (Jt t')) (U (Jt t)) (W t ⊓ W t') inf_le_left e
          (le_trans inf_le_left (hW t))]
    have PT' : ∀ l, T.presheaf.map (homOfLE (inf_le_right : W t ⊓ W t' ≤ W t')).op (σ t' l) *
          T.presheaf.map (homOfLE (inf_le_right : W t ⊓ W t' ≤ W t')).op (b t') =
        h.appLE (U (Jt t) ⊓ U (Jt t')) (W t ⊓ W t') e (w (Jt t) (Jt t')) *
          (T.presheaf.map (homOfLE (inf_le_left : W t ⊓ W t' ≤ W t)).op (σ t l) *
            T.presheaf.map (homOfLE (inf_le_left : W t ⊓ W t' ≤ W t)).op (b t)) := by
      intro l
      have h0 := PT l
      rw [hσ t' l, hσ t l, map_mul, map_mul] at h0
      exact h0
    have hc1 : ∑ l, T.presheaf.map (homOfLE (inf_le_left : W t ⊓ W t' ≤ W t)).op (c t l) *
        T.presheaf.map (homOfLE (inf_le_left : W t ⊓ W t' ≤ W t)).op (σ t l) = 1 := by
      have h0 := congrArg (fun x => T.presheaf.map (homOfLE (inf_le_left : W t ⊓ W t' ≤ W t)).op x) (hc t)
      simpa only [map_sum, map_mul, map_one] using h0
    have hc2 : ∑ l, T.presheaf.map (homOfLE (inf_le_right : W t ⊓ W t' ≤ W t')).op (c t' l) *
        T.presheaf.map (homOfLE (inf_le_right : W t ⊓ W t' ≤ W t')).op (σ t' l) = 1 := by
      have h0 := congrArg (fun x => T.presheaf.map (homOfLE (inf_le_right : W t ⊓ W t' ≤ W t')).op x) (hc t')
      simpa only [map_sum, map_mul, map_one] using h0
    obtain ⟨v, hv, hvr⟩ := RU Γ(T, W t ⊓ W t') m
      (fun l => T.presheaf.map (homOfLE (inf_le_left : W t ⊓ W t' ≤ W t)).op (σ t l))
      (fun l => T.presheaf.map (homOfLE (inf_le_right : W t ⊓ W t' ≤ W t')).op (σ t' l))
      (fun l => T.presheaf.map (homOfLE (inf_le_left : W t ⊓ W t' ≤ W t)).op (c t l))
      (fun l => T.presheaf.map (homOfLE (inf_le_right : W t ⊓ W t' ≤ W t')).op (c t' l))
      (h.appLE (U (Jt t) ⊓ U (Jt t')) (W t ⊓ W t') e (w (Jt t) (Jt t')))
      (T.presheaf.map (homOfLE (inf_le_left : W t ⊓ W t' ≤ W t)).op (b t))
      (T.presheaf.map (homOfLE (inf_le_right : W t ⊓ W t' ≤ W t')).op (b t'))
      ((hw (Jt t) (Jt t')).map _) (NZR _ _ inf_le_left (hWa t) _ (hbnzd t)) hc1 hc2 PT'
    exact ⟨v, hv, hvr⟩
  choose v hv hvr using TU

  have haff : ∀ J : Fin (m + 1), IsAffineOpen (wcFprD R m J) := by
    intro J
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) R) := MvPolynomial.gradedAlgebra
    exact Proj.isAffineOpen_basicOpen _ (MvPolynomial.X J)
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ J)) Nat.one_pos
  have hcovW : (⨆ t, W t) = ⊤ :=
    eq_top_iff.mpr (fun x _ => TopologicalSpace.Opens.mem_iSup.mpr ⟨x, htW x⟩)
  have hspan : ∀ t, Ideal.span (Set.range (σ t)) = ⊤ := fun t =>
    Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_span_range_iff_exists_fun.mpr ⟨c t, hc t⟩) isUnit_one
  have hcovD0 : (⨆ a : Fin (m + 1), @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) R) MvPolynomial.gradedAlgebra (MvPolynomial.X a)) = ⊤ := by
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) R) :=
      MvPolynomial.gradedAlgebra
    refine Proj.iSup_basicOpen_eq_top _ _ ?_
    intro p hp
    have h0 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) R) 0 p = 0 :=
      (HomogeneousIdeal.mem_irrelevant_iff (𝒜 := MvPolynomial.homogeneousSubmodule (Fin (m + 1)) R)
        p).mp hp
    have h1 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) R) 0 p =
        MvPolynomial.homogeneousComponent 0 p :=
      (GradedRing.proj_apply _ 0 p).trans (MvPolynomial.decomposition.decompose'_apply p 0)
    rw [h1, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
    rw [← Set.image_univ]
    rw [MvPolynomial.mem_ideal_span_X_image]
    intro e he
    rw [MvPolynomial.mem_support_iff] at he
    have hne : e ≠ 0 := by
      rintro rfl
      exact he h0
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hne
    exact ⟨i, Set.mem_univ i, by simpa using hi⟩
  have hcovD : (⨆ a : Fin (m + 1), wcFprD R m a) = ⊤ := hcovD0
  obtain ⟨φ, hφ, hpre, hrel⟩ := PG (wcFprP R m) (Spec (.of R)) (wcFprS R m) (wcFprD R m) (wcFprE R m)
    hcovD (S3 m) (fun W' g₁ g₂ t' hq hc' hg hg' hr hr' =>
      UQ _ _ _ (wcFprD R m) haff (wcFprE R m) (S1 m) W' g₁ g₂ t' hq hc' hg hg' hr hr')
    T (h ≫ fX) W hcovW σ hspan v hv hvr
  exact ⟨φ, Jt, W, hW, b, σ, hφ, fun t => ⟨hWa t, htW t, hbnzd t⟩, hσ, hpre, hrel⟩

theorem wcpa_dj_ms_bfp_rbm_proj_uniq : ∀ (R : Type u) [CommRing R] (n : ℕ) (T : Scheme.{u}) (W : T.Opens) (g g' : T ⟶ wcFprP R n) (t : Fin (n + 1) → Γ(T, W)), g ≫ wcFprS R n = g' ≫ wcFprS R n → (⨆ J, T.basicOpen (t J)) = W → (∀ J L (O : T.Opens) (hO : O ≤ g ⁻¹ᵁ wcFprD R n J) (hOW : O ≤ W), g.appLE (wcFprD R n J) O hO (wcFprE R n J L) * T.presheaf.map (homOfLE hOW).op (t J) = T.presheaf.map (homOfLE hOW).op (t L)) → (∀ J L (O : T.Opens) (hO : O ≤ g' ⁻¹ᵁ wcFprD R n J) (hOW : O ≤ W), g'.appLE (wcFprD R n J) O hO (wcFprE R n J L) * T.presheaf.map (homOfLE hOW).op (t J) = T.presheaf.map (homOfLE hOW).op (t L)) → W.ι ≫ g = W.ι ≫ g' :=
by
  intro R _ n T W g g' t hq hcov hr hr'

  have L1 : ∀ {σ : Type u} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ) [GradedRing 𝒜] (f g : A) (hf : f ∈ 𝒜 1) (hg : g ∈ 𝒜 1), Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g = (Proj 𝒜).basicOpen (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) := by
    intro σ A _ _ _ 𝒜 _ f g hf hg
    have ha : HomogeneousLocalization.Away.isLocalizationElem hf hg =
        HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg := by
      apply HomogeneousLocalization.val_injective
      simp [HomogeneousLocalization.Away.val_mk]
    have hb : (Proj.basicOpen 𝒜 f).ι ⁻¹ᵁ Proj.basicOpen 𝒜 g =
        (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg) := by
      have h1 := Proj.awayι_preimage_basicOpen 𝒜 hf Nat.one_pos hg Nat.one_pos
      rw [← Proj.basicOpenIsoSpec_inv_ι, Scheme.Hom.comp_preimage, ha] at h1
      rw [← h1, ← Scheme.Hom.comp_preimage, Iso.hom_inv_id, Scheme.Hom.id_preimage]
    have hd : (Proj 𝒜).basicOpen (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) =
        (Proj.basicOpen 𝒜 f).ι ''ᵁ ((Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) := by
      have hsp := basicOpen_eq_of_affine (R := CommRingCat.of (HomogeneousLocalization.Away 𝒜 f))
        (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)
      have h3 : (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg) =
          (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          (Spec _).basicOpen ((Scheme.ΓSpecIso _).inv (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) :=
        congrArg (fun V => (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ V) hsp.symm
      rw [h3, ← Scheme.Opens.ι_image_basicOpen_topIso_inv, Scheme.preimage_basicOpen_top]
      congr 2
      rw [Proj.basicOpenIsoSpec_hom]
      change _ = ConcreteCategory.hom (Scheme.Hom.app (Proj.basicOpenToSpec 𝒜 f) ⊤) _
      rw [Proj.basicOpenToSpec_app_top]
      exact congrArg (fun y => ConcreteCategory.hom (Proj.basicOpen 𝒜 f).topIso.inv
        (ConcreteCategory.hom (Proj.awayToSection 𝒜 f) y))
        (Iso.inv_hom_id_apply (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 f)))
          (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)).symm
    rw [hd, ← hb, Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
  have hBO : ∀ J L : Fin (n + 1), (wcFprP R n).basicOpen (wcFprE R n J L) = wcFprD R n J ⊓ wcFprD R n L := by
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R) := MvPolynomial.gradedAlgebra
    have hX : ∀ k : Fin (n + 1), (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) R) ∈
        MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R 1 := fun k =>
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)
    intro J L
    exact (L1 _ (MvPolynomial.X J) (MvPolynomial.X L) (hX J) (hX L)).symm
  have haffD : ∀ k, IsAffineOpen (wcFprD R n k) := by
    intro k
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R) :=
      MvPolynomial.gradedAlgebra
    exact Proj.isAffineOpen_basicOpen _ (MvPolynomial.X k)
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)) Nat.one_pos

  have S1 : ∀ (R' : Type u) [CommRing R'] (n : ℕ) (J : Fin (n + 1)) (x : Γ(wcFprP R' n, wcFprD R' n J)),
      x ∈ Subring.closure (Set.range (wcFprE R' n J) ∪ Set.range (fun c : R' => (wcFprP R' n).presheaf.map
        (homOfLE (le_top : wcFprD R' n J ≤ ⊤)).op ((wcFprS R' n).appTop ((Scheme.ΓSpecIso (.of R')).inv c)))) := by
    intro R' _ n
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R') := MvPolynomial.gradedAlgebra
    have hX : ∀ k : Fin (n + 1), (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) R') ∈
        MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R' 1 := fun k =>
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)
    intro J x
    have GEN : ∀ (k : Fin (n + 1)) (d : ℕ) (F : MvPolynomial (Fin (n + 1)) R')
        (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R' (d • 1)),
        MvPolynomial.eval₂ ((HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R') (Submonoid.powers (MvPolynomial.X k))).comp
            (algebraMap R' ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R' 0)))
          (fun l => HomogeneousLocalization.Away.mk
            (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R') (hX k) 1
            (MvPolynomial.X l) (hX l)) F =
        HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R') (hX k) d F hF := by
      intro k d F hF
      have hFh : F.IsHomogeneous d := by
        have := (MvPolynomial.mem_homogeneousSubmodule (d • 1) F).mp hF
        simpa using this
      have scale : ∀ {L : Type u} [CommRing L] (χ : R' →+* L) (g : Fin (n + 1) → L) (t : L),
          MvPolynomial.eval₂ χ (fun l => g l * t) F = t ^ d * MvPolynomial.eval₂ χ g F := by
        intro L _ χ g t
        rw [MvPolynomial.eval₂_eq, MvPolynomial.eval₂_eq, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun e he => ?_)
        have hdeg : ∑ i ∈ e.support, e i = d := by
          by_contra hne
          exact (MvPolynomial.mem_support_iff.mp he) (hFh.coeff_eq_zero hne)
        simp_rw [mul_pow]
        rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
        ring
      apply HomogeneousLocalization.val_injective
      rw [← HomogeneousLocalization.algebraMap_apply, ← HomogeneousLocalization.algebraMap_apply,
        MvPolynomial.eval₂_comp_left, HomogeneousLocalization.algebraMap_apply,
        HomogeneousLocalization.Away.val_mk]
      calc _ = MvPolynomial.eval₂
            ((algebraMap (MvPolynomial (Fin (n + 1)) R')
              (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) R')))).comp
              MvPolynomial.C)
            (fun l => algebraMap (MvPolynomial (Fin (n + 1)) R')
              (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) R')))
              (MvPolynomial.X l) * Localization.mk 1 (⟨MvPolynomial.X k ^ 1, ⟨1, rfl⟩⟩ :
                Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) R'))) F := by
            congr 1
            funext l
            simp only [Function.comp_apply, HomogeneousLocalization.algebraMap_apply,
              HomogeneousLocalization.Away.val_mk, ← Localization.mk_one_eq_algebraMap,
              Localization.mk_mul, mul_one, one_mul]
        _ = _ := by
            rw [scale]
            have h2 := MvPolynomial.eval₂_comp_left (algebraMap (MvPolynomial (Fin (n + 1)) R')
              (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) R'))))
              MvPolynomial.C MvPolynomial.X F
            rw [MvPolynomial.eval₂_eta] at h2
            rw [show (fun l => algebraMap (MvPolynomial (Fin (n + 1)) R')
                (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) R')))
                (MvPolynomial.X l)) = ⇑(algebraMap (MvPolynomial (Fin (n + 1)) R')
                (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) R')))) ∘
                MvPolynomial.X from rfl, ← h2, Localization.mk_pow,
              ← Localization.mk_one_eq_algebraMap, Localization.mk_mul, Localization.mk_eq_mk_iff,
              Localization.r_iff_exists]
            refine ⟨1, ?_⟩
            simp only [one_pow, one_mul, mul_one, OneMemClass.coe_one, SubmonoidClass.coe_pow, ← pow_mul]
    have hι : ∀ (U : (Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R')).Opens) a,
        U.ι.appTop a = U.topIso.inv ((Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R')).presheaf.map (homOfLE (le_top : U ≤ ⊤)).op a) := by
      intro U a
      rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_inv]
      erw [← CategoryTheory.comp_apply, ← Functor.map_comp]
      rfl
    have hconst : ∀ c : R', (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R') (MvPolynomial.X J)).hom
        (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R')
          (Submonoid.powers (MvPolynomial.X J)) (algebraMap R' ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R' 0) c)) =
        ((Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R')).presheaf.map (homOfLE (le_top : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R') (MvPolynomial.X J)) ≤ ⊤)).op).hom ((Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R') ≫ Spec.map (CommRingCat.ofHom (algebraMap R' ↥((MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R') 0)))).appTop.hom ((Scheme.ΓSpecIso (.of R')).inv.hom c)) := by
      intro c
      have e0 : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R') (MvPolynomial.X J)).ι =
          (Proj.basicOpenIsoSpec _ (MvPolynomial.X J) (hX J) Nat.one_pos).hom ≫
            Proj.awayι _ (MvPolynomial.X J) (hX J) Nat.one_pos := by
        rw [← Proj.basicOpenIsoSpec_inv_ι, Iso.hom_inv_id_assoc]
      have e1 : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R') (MvPolynomial.X J)).ι ≫
          (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R') ≫ Spec.map (CommRingCat.ofHom (algebraMap R' ↥((MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R') 0)))) =
          (Proj.basicOpenIsoSpec _ (MvPolynomial.X J) (hX J) Nat.one_pos).hom ≫
            Spec.map (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R') (Submonoid.powers (MvPolynomial.X J))).comp
              (algebraMap R' ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R' 0)))) := by
        rw [e0, Category.assoc, Proj.awayι_toSpecZero_assoc, ← Spec.map_comp]
        rfl
      have e2 := congrArg (fun g => (Scheme.Hom.appTop g).hom ((Scheme.ΓSpecIso (.of R')).inv.hom c)) e1
      simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at e2
      have e3 := congrArg (fun g => g.hom c) (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R') (Submonoid.powers (MvPolynomial.X J))).comp
              (algebraMap R' ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R' 0)))))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e3
      rw [← e3] at e2
      have hi : ∀ y, (Proj.basicOpenIsoSpec _ (MvPolynomial.X J) (hX J) Nat.one_pos).hom.appTop
          ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R') (MvPolynomial.X J)))).inv y) =
          (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R') (MvPolynomial.X J)).topIso.inv
            ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R') (MvPolynomial.X J)).hom y) := by
        intro y
        rw [Proj.basicOpenIsoSpec_hom]
        have hh := Proj.basicOpenToSpec_app_top (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R') (MvPolynomial.X J)
        calc _ = ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R') (MvPolynomial.X J)))).hom ≫ Proj.awayToSection _ (MvPolynomial.X J) ≫ (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R') (MvPolynomial.X J)).topIso.inv) ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R') (MvPolynomial.X J)))).inv y) := by rw [← hh]
          _ = _ := by
            change (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R') (MvPolynomial.X J)).topIso.inv
              ((Proj.awayToSection _ (MvPolynomial.X J)) ((Scheme.ΓSpecIso _).hom ((Scheme.ΓSpecIso _).inv y))) = _
            rw [Iso.inv_hom_id_apply]
      have e4 := e2.trans (hi _)
      rw [hι] at e4
      have hinj : ∀ a b : Γ(Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R'), Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R') (MvPolynomial.X J)),
          (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R') (MvPolynomial.X J)).topIso.inv a =
            (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R') (MvPolynomial.X J)).topIso.inv b → a = b := by
        intro a b h
        have h' := congrArg (fun w => (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R') (MvPolynomial.X J)).topIso.hom w) h
        simp only [Iso.inv_hom_id_apply] at h'
        exact h'
      exact (hinj _ _ e4).symm
    have hs : Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R')
        (MvPolynomial.X J) ((Proj.basicOpenIsoAway _ (MvPolynomial.X J) (hX J) Nat.one_pos).inv x) = x := by
      have := Iso.inv_hom_id_apply (Proj.basicOpenIsoAway _ (MvPolynomial.X J) (hX J) Nat.one_pos) x
      rwa [Proj.basicOpenIsoAway_hom] at this
    obtain ⟨d, F, hF, hmk⟩ := HomogeneousLocalization.Away.mk_surjective
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R') (hX J)
      ((Proj.basicOpenIsoAway _ (MvPolynomial.X J) (hX J) Nat.one_pos).inv x)
    rw [← hs, ← hmk, ← GEN J d F hF]
    change (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R') (MvPolynomial.X J)).hom _ ∈ _
    rw [MvPolynomial.eval₂_comp_left]
    apply MvPolynomial.eval₂_mem
    · intro i _
      apply Subring.subset_closure
      right
      exact ⟨F.coeff i, (hconst (F.coeff i)).symm⟩
    · intro l
      apply Subring.subset_closure
      left
      exact ⟨l, rfl⟩

  have hle : ∀ (h : T ⟶ wcFprP R n), (∀ J L (O : T.Opens) (hO : O ≤ h ⁻¹ᵁ wcFprD R n J) (hOW : O ≤ W),
      h.appLE (wcFprD R n J) O hO (wcFprE R n J L) * T.presheaf.map (homOfLE hOW).op (t J) =
        T.presheaf.map (homOfLE hOW).op (t L)) → ∀ J, T.basicOpen (t J) ≤ h ⁻¹ᵁ wcFprD R n J := by
    intro h hrel J x hx
    have hxW : x ∈ W := T.basicOpen_le (t J) hx
    have hcovD : (⨆ k, wcFprD R n k) = ⊤ := by
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R) :=
        MvPolynomial.gradedAlgebra
      refine Proj.iSup_basicOpen_eq_top _ _ ?_
      intro p hp
      have h0 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R) 0 p = 0 :=
        (HomogeneousIdeal.mem_irrelevant_iff (𝒜 := MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R)
          p).mp hp
      have h1 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R) 0 p =
          MvPolynomial.homogeneousComponent 0 p :=
        (GradedRing.proj_apply _ 0 p).trans (MvPolynomial.decomposition.decompose'_apply p 0)
      rw [h1, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
      rw [← Set.image_univ]
      rw [MvPolynomial.mem_ideal_span_X_image]
      intro e he
      rw [MvPolynomial.mem_support_iff] at he
      have hne : e ≠ 0 := by
        rintro rfl
        exact he h0
      obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hne
      exact ⟨i, Set.mem_univ i, by simpa using hi⟩
    obtain ⟨k, hk⟩ : ∃ k, h x ∈ wcFprD R n k := by
      have : h x ∈ (⨆ k, wcFprD R n k) := by rw [hcovD]; trivial
      exact TopologicalSpace.Opens.mem_iSup.mp this
    have e := hrel k J (h ⁻¹ᵁ wcFprD R n k ⊓ W) inf_le_left inf_le_right
    have e2 := congrArg T.basicOpen e
    simp only [Scheme.basicOpen_mul, Scheme.basicOpen_res, Scheme.basicOpen_appLE, hBO] at e2
    have hxO : x ∈ (h ⁻¹ᵁ wcFprD R n k ⊓ W) ⊓ T.basicOpen (t J) := ⟨⟨hk, hxW⟩, hx⟩
    rw [← e2] at hxO
    exact (show h ⁻¹ᵁ (wcFprD R n k ⊓ wcFprD R n J) ≤ h ⁻¹ᵁ wcFprD R n J from
      fun y hy => hy.2) hxO.1.2
  have hB := hle g hr
  have hB' := hle g' hr'

  have hchart : ∀ J, (T.basicOpen (t J)).ι ≫ g = (T.basicOpen (t J)).ι ≫ g' := by
    intro J
    have hconst : ∀ (h : T ⟶ wcFprP R n) (U : (wcFprP R n).Opens) (V : T.Opens) (e : V ≤ h ⁻¹ᵁ U)
        (x : Γ(wcFprP R n, ⊤)),
        h.appLE U V e ((wcFprP R n).presheaf.map (homOfLE (le_top : U ≤ ⊤)).op x) =
          T.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op (h.appTop x) := by
      intro h U V e x
      rw [← CategoryTheory.comp_apply, Scheme.Hom.map_appLE]
      rfl
    rw [← Scheme.Hom.resLE_comp_ι g (hB J), ← Scheme.Hom.resLE_comp_ι g' (hB' J)]
    congr 1
    haveI : IsAffine (wcFprD R n J) := haffD J
    apply ext_of_isAffine
    show (g.resLE (wcFprD R n J) (T.basicOpen (t J)) (hB J)).app ⊤ =
      (g'.resLE (wcFprD R n J) (T.basicOpen (t J)) (hB' J)).app ⊤
    rw [Scheme.Hom.resLE_app_top, Scheme.Hom.resLE_app_top]
    congr 2
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro x
    refine RingHom.eqOn_set_closure (f := (g.appLE (wcFprD R n J) (T.basicOpen (t J)) (hB J)).hom)
      (g := (g'.appLE (wcFprD R n J) (T.basicOpen (t J)) (hB' J)).hom) ?_ (S1 R n J x)
    rintro _ (⟨L, rfl⟩ | ⟨c, rfl⟩)
    · have hu : IsUnit (T.presheaf.map (homOfLE (T.basicOpen_le (t J))).op (t J)) :=
        RingedSpace.isUnit_res_basicOpen _ _
      have e1 := hr J L _ (hB J) (T.basicOpen_le (t J))
      rw [← hr' J L _ (hB' J) (T.basicOpen_le (t J))] at e1
      exact (hu.mul_left_inj).mp e1
    · have hqc : g.appTop ((wcFprS R n).appTop ((Scheme.ΓSpecIso (.of R)).inv c)) =
          g'.appTop ((wcFprS R n).appTop ((Scheme.ΓSpecIso (.of R)).inv c)) := by
        have := congrArg (fun h => (Scheme.Hom.appTop h).hom ((Scheme.ΓSpecIso (.of R)).inv c)) hq
        simpa only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] using this
      show (g.appLE (wcFprD R n J) (T.basicOpen (t J)) (hB J))
          ((wcFprP R n).presheaf.map (homOfLE (le_top : wcFprD R n J ≤ ⊤)).op
            ((wcFprS R n).appTop ((Scheme.ΓSpecIso (.of R)).inv c))) =
        (g'.appLE (wcFprD R n J) (T.basicOpen (t J)) (hB' J))
          ((wcFprP R n).presheaf.map (homOfLE (le_top : wcFprD R n J ≤ ⊤)).op
            ((wcFprS R n).appTop ((Scheme.ΓSpecIso (.of R)).inv c)))
      rw [hconst, hconst, hqc]

  have hV : (⨆ J, W.ι ⁻¹ᵁ T.basicOpen (t J)) = ⊤ := by
    rw [← Scheme.Hom.preimage_iSup, hcov, Scheme.Opens.ι_preimage_self]
  apply Scheme.Cover.hom_ext (W.toScheme.openCoverOfIsOpenCover (fun J => W.ι ⁻¹ᵁ T.basicOpen (t J)) hV)
  refine fun (J : Fin (n + 1)) => ?_
  show (W.ι ⁻¹ᵁ T.basicOpen (t J)).ι ≫ W.ι ≫ g = (W.ι ⁻¹ᵁ T.basicOpen (t J)).ι ≫ W.ι ≫ g'
  rw [← Category.assoc, ← Category.assoc,
    ← Scheme.Hom.resLE_comp_ι W.ι (le_rfl : W.ι ⁻¹ᵁ T.basicOpen (t J) ≤ W.ι ⁻¹ᵁ T.basicOpen (t J)),
    Category.assoc, Category.assoc, hchart J]

theorem wcpa_dj_ms_bfp_ring_blowup_model : ∀ (R : Type u) [CommRing R] (X : Scheme.{u}) (fX : X ⟶ Spec (.of R)) [IsSeparated fX] (I : X.IdealSheafData) (n m : ℕ) (U : Fin (n + 1) → X.Opens) (hU : ∀ J, IsAffineOpen (U J)) (g : ∀ J, Fin (m + 1) → Γ(X, U J)) (w : ∀ J L, Γ(X, U J ⊓ U L)), (⨆ J, U J) = ⊤ → (∀ J, I.ideal ⟨U J, hU J⟩ = Ideal.span (Set.range (g J))) → (∀ J L, IsUnit (w J L)) → (∀ J L l, X.presheaf.map (homOfLE (inf_le_right : U J ⊓ U L ≤ U L)).op (g L l) = w J L * X.presheaf.map (homOfLE (inf_le_left : U J ⊓ U L ≤ U J)).op (g J l)) → ∃ (P : Scheme.{u}) (r : P ⟶ X) (ι : P ⟶ Limits.pullback fX (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) R) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap R ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) R 0))))), IsClosedImmersion ι ∧ ι ≫ Limits.pullback.fst fX (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) R) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap R ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) R 0)))) = r ∧ wcCsdIsBlowup I r :=
by
  intro R _ X fX _ I n m U hU g w hcov hI hw htr
  show ∃ (P : Scheme.{u}) (r : P ⟶ X) (ι : P ⟶ Limits.pullback fX (wcFprS R m)),
    IsClosedImmersion ι ∧ ι ≫ Limits.pullback.fst fX (wcFprS R m) = r ∧ wcCsdIsBlowup I r
  have hres : ∀ (Y : Scheme.{u}) (A B C : Y.Opens) (h1 : B ≤ A) (h2 : C ≤ B) (h3 : C ≤ A)
      (x : Γ(Y, A)), Y.presheaf.map (homOfLE h2).op (Y.presheaf.map (homOfLE h1).op x) =
        Y.presheaf.map (homOfLE h3).op x := by
    intro Y A B C h1 h2 h3 x
    rw [← CategoryTheory.comp_apply, ← Functor.map_comp]
    rfl
  have hid : ∀ (Y : Scheme.{u}) (A : Y.Opens) (h : A ≤ A) (x : Γ(Y, A)),
      Y.presheaf.map (homOfLE h).op x = x := by
    intro Y A h x
    rw [show (homOfLE h).op = 𝟙 (Opposite.op A) from rfl, CategoryTheory.Functor.map_id]
    rfl
  have hAmap : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (V : B.Opens) (O1 O2 : A.Opens) (h12 : O2 ≤ O1)
      (e1 : O1 ≤ f ⁻¹ᵁ V) (e2 : O2 ≤ f ⁻¹ᵁ V) (x : Γ(B, V)),
      A.presheaf.map (homOfLE h12).op (f.appLE V O1 e1 x) = f.appLE V O2 e2 x := by
    intro A B f V O1 O2 h12 e1 e2 x
    rw [← CategoryTheory.comp_apply, Scheme.Hom.appLE_map]
  have hcompA : ∀ {A B C : Scheme.{u}} (f : A ⟶ B) (k : B ⟶ C) (V : C.Opens) (V' : B.Opens)
      (O : A.Opens) (e1 : V' ≤ k ⁻¹ᵁ V) (e2 : O ≤ f ⁻¹ᵁ V') (e3 : O ≤ (f ≫ k) ⁻¹ᵁ V)
