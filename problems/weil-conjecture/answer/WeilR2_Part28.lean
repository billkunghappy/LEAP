  have homog : ∀ (A S : Type u) [CommRing A] [CommRing S] (α : A →+* S) (gg : Fin (m + 1) → A)
      (τ : Fin (m + 1) → S) (k : Fin (m + 1)) (y : S),
      y ∈ Subring.closure (Set.range α ∪ Set.range τ) → ∃ (e : ℕ) (F : A),
        ∀ (R : Type u) [CommRing R] (π : S →+* R) (c : R) (ρ : Fin (m + 1) → R),
          (∀ l, π (α (gg l)) = c * ρ l) → (∀ l, π (τ l) * ρ k = ρ l) →
            (c * ρ k) ^ e * π y = π (α F) := by
    intro A S _ _ α gg τ k y hy
    induction hy using Subring.closure_induction with
    | mem x hx =>
      rcases hx with ⟨a, rfl⟩ | ⟨l, rfl⟩
      · exact ⟨0, a, fun R _ π c ρ _ _ => by rw [pow_zero, one_mul]⟩
      · refine ⟨1, gg l, fun R _ π c ρ H1 H2 => ?_⟩
        rw [pow_one, H1 l, ← H2 l]
        ring
    | zero => exact ⟨0, 0, fun R _ π c ρ _ _ => by simp⟩
    | one => exact ⟨0, 1, fun R _ π c ρ _ _ => by simp⟩
    | add x y _ _ ihx ihy =>
      obtain ⟨e1, F1, hF1⟩ := ihx
      obtain ⟨e2, F2, hF2⟩ := ihy
      refine ⟨e1 + e2, gg k ^ e2 * F1 + gg k ^ e1 * F2, fun R _ π c ρ H1 H2 => ?_⟩
      simp only [map_add, map_mul, map_pow]
      rw [H1 k, ← hF1 R π c ρ H1 H2, ← hF2 R π c ρ H1 H2]
      ring
    | neg x _ ih =>
      obtain ⟨e, F, hF⟩ := ih
      exact ⟨e, -F, fun R _ π c ρ H1 H2 => by
        rw [map_neg, map_neg, map_neg, ← hF R π c ρ H1 H2]
        ring⟩
    | mul x y _ _ ihx ihy =>
      obtain ⟨e1, F1, hF1⟩ := ihx
      obtain ⟨e2, F2, hF2⟩ := ihy
      refine ⟨e1 + e2, F1 * F2, fun R _ π c ρ H1 H2 => ?_⟩
      rw [map_mul, map_mul, map_mul, ← hF1 R π c ρ H1 H2, ← hF2 R π c ρ H1 H2]
      ring

