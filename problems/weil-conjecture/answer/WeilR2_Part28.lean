    obtain ⟨lam, -, hlam⟩ := wcpa_dj_sgs_gc_sections_embed Xt Q f (specializes_of_eq hη) hYint

    haveI hπp : IsProper (Limits.pullback.snd f (Q.fromSpecStalk (genericPoint Q))) := inferInstance
