    (wcpa_dj_flrg_generic_hilb k X P P' sP f U N jX hcomm hZ e₀ r L Φ μ G β γ hjX hP hP' hU hμ
      hH hβiso hγ hcomp c V' hV'le hV'aff) i
  set J : Ideal (MvPolynomial (Fin (N + 1)) Γ(P', V')) :=
    Ideal.span (Set.range fun a => MvPolynomial.map (γ.appLE (wcSgD k L c) V' hV'le).hom (G c a)) ⊔
