    have hΘa : Θ a = HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin 2) S) hu k a ha := by
      apply HomogeneousLocalization.val_injective
      have hv := hvm (MvPolynomial.homogeneousSubmodule (Fin 2) S) u 1 hu k a ha
