  refine hSP ((HomogeneousLocalization.fromZeroRingHom
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K) (Submonoid.powers (MvPolynomial.X i))).comp
      (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K 0)))
    ((HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
      (Submonoid.powers (∏ m ∈ ({j} : Finset (Fin (n + 1))), MvPolynomial.X m))).comp
      (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0)))
    _ _ _ _ h ?_ ?_ h1 h2 ?_
  · simp only [wcProjKStr]
    rw [← Category.assoc, Proj.awayι_toSpecZero, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
  · simp only [wcProjKStr, wcBlι]
    rw [← Category.assoc, Proj.awayι_toSpecZero, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
  · intro r
    refine Subring.closure_mono ?_ (hgen r)
    rintro _ (hx | ⟨b, rfl⟩)
    · rcases hx with rfl | rfl
      · exact Or.inl ⟨_, rfl⟩
      · exact Or.inl ⟨_, rfl⟩
    · exact Or.inr ⟨b, rfl⟩

theorem wcpa_dj_gs_bf_std_blowup : ∀ (K : Type u) [Field K] (n : ℕ), ∃ (P : Scheme.{u}) (σB : P ⟶ wcProjK K (n + 1)) (ρ : P ⟶ wcProjK K n) (ex : wcProjK K n ⟶ P) (y : Spec (.of K) ⟶ wcProjK K (n + 1)) (ιP : P ⟶ Limits.pullback (wcProjKStr K (n + 1)) (wcProjKStr K n)), y ≫ wcProjKStr K (n + 1) = 𝟙 _ ∧ IsClosed ({y (IsLocalRing.closedPoint K)} : Set ↥(wcProjK K (n + 1))) ∧ σB ≫ wcProjKStr K (n + 1) = ρ ≫ wcProjKStr K n ∧ IsProper σB ∧ Surjective σB ∧ (∀ O : (wcProjK K (n + 1)).Opens, (O : Set ↥(wcProjK K (n + 1))) = {y (IsLocalRing.closedPoint K)}ᶜ → IsIso (σB ∣_ O)) ∧ Dense (σB ⁻¹' {y (IsLocalRing.closedPoint K)}ᶜ) ∧ ex ≫ ρ = 𝟙 _ ∧ ex ≫ σB = wcProjKStr K n ≫ y ∧ SmoothOfRelativeDimension 1 ρ ∧ IsClosedImmersion ιP ∧ ιP ≫ Limits.pullback.fst (wcProjKStr K (n + 1)) (wcProjKStr K n) = σB ∧ ιP ≫ Limits.pullback.snd (wcProjKStr K (n + 1)) (wcProjKStr K n) = ρ ∧ ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (s : Spec (.of Ω) ⟶ wcProjK K n), IrreducibleSpace ↥(Limits.pullback ρ s) ∧ topologicalKrullDim ↥(Limits.pullback ρ s) ≤ ((1 : ℕ) : WithBot ℕ∞) :=
by
  intro K _ n
  have hprod : ∀ S : Finset (Fin (n + 1)),
      (∏ m ∈ S, MvPolynomial.X m : MvPolynomial (Fin (n + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K S.card := fun S =>
    (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (by
      simpa using MvPolynomial.IsHomogeneous.prod S
        (fun m => (MvPolynomial.X m : MvPolynomial (Fin (n + 1)) K)) (fun _ => 1)
        (fun m _ => MvPolynomial.isHomogeneous_X K m))
  have hνmem : ∀ (S : Finset (Fin (n + 1))) (j l : Fin (n + 1)), j ∈ S →
      (MvPolynomial.X l * ∏ m ∈ S.erase j, MvPolynomial.X m : MvPolynomial (Fin (n + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K (1 • S.card) := by
    intro S j l hj
    rw [MvPolynomial.mem_homogeneousSubmodule]
    have h2 := Finset.card_erase_of_mem hj
    have h1 : 0 < S.card := Finset.card_pos.mpr ⟨j, hj⟩
    have h3 := (MvPolynomial.isHomogeneous_X K l).mul (MvPolynomial.IsHomogeneous.prod
      (S.erase j) (fun m => (MvPolynomial.X m : MvPolynomial (Fin (n + 1)) K))
      (fun _ => 1) (fun m _ => MvPolynomial.isHomogeneous_X K m))
    convert h3 using 1
    simp only [Finset.sum_const, smul_eq_mul, mul_one, h2]
    omega
  have hXn : ∀ i : Fin (n + 1), (MvPolynomial.X i : MvPolynomial (Fin (n + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 1 := fun i =>
    (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K i)
  have hX : ∀ i : Fin (n + 1 + 1), (MvPolynomial.X i : MvPolynomial (Fin (n + 1 + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (n + 1 + 1)) K 1 := fun i =>
    (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K i)
  have hsd : ∀ (S S' : Finset (Fin (n + 1))), S' ⊆ S →
