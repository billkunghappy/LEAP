    show MvPolynomial.eval₂Hom _ _ (MvPolynomial.X (Fin.castSucc j)) = _
    simp
  have hFXl : wcBlF K n ⟨{j}, Finset.singleton_nonempty j⟩ (MvPolynomial.X (Fin.last (n + 1))) =
      MvPolynomial.X 1 := by
    show MvPolynomial.eval₂Hom _ _ (MvPolynomial.X (Fin.last (n + 1))) = _
    simp
  have hνj : wcBlNu K n ⟨{j}, Finset.singleton_nonempty j⟩ j = 1 := by
    apply HomogeneousLocalization.val_injective
    unfold wcBlNu
    rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one, Localization.mk_eq_mk',
      IsLocalization.mk'_eq_iff_eq_mul, one_mul]
    congr 1
    simp
