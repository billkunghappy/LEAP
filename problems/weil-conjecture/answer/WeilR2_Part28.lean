import WeilR2_Part27
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem wcpa_dj_sgf_frobenius_k : ∀ (k : Type u) [Field k] [Finite k] (Q : Scheme.{u})
    (sQ : Q ⟶ Spec (.of k)) [LocallyOfFiniteType sQ] (m : ℕ),
    ∃ Φ : Q ⟶ Q, IsFinite Φ ∧ wcIsAbsFrob Φ (Nat.card k ^ m) ∧ Φ ≫ sQ = sQ :=
by
  classical
  intro k _ _ Q sQ _ m
  letI : Fintype k := Fintype.ofFinite k
  have hq0 : 0 < Nat.card k := Finite.card_pos
  have hq : 0 < Nat.card k ^ m := pow_pos hq0 m

  let ι : ∀ U : Q.Opens, k →+* Γ(Q, U) := fun U =>
    (sQ.appLE ⊤ U (fun _ _ => trivial)).hom.comp (Scheme.ΓSpecIso (.of k)).inv.hom

  have hP : ∀ (U : Q.Opens) (a b : Γ(Q, U)),
      (a + b) ^ Nat.card k = a ^ Nat.card k + b ^ Nat.card k := by
    intro U a b
    letI : Algebra k Γ(Q, U) := (ι U).toAlgebra
    have := map_add (FiniteField.frobeniusAlgHom k Γ(Q, U)) a b
    simp only [FiniteField.coe_frobeniusAlgHom, Fintype.card_eq_nat_card] at this
    exact this
  have hadd' : ∀ (n : ℕ) (U : Q.Opens) (a b : Γ(Q, U)),
      (a + b) ^ (Nat.card k ^ n) = a ^ (Nat.card k ^ n) + b ^ (Nat.card k ^ n) := by
    intro n
    induction n with
    | zero => intro U a b; simp only [pow_zero, pow_one]
    | succ n ih =>
      intro U a b
      rw [pow_succ, pow_mul, pow_mul, pow_mul, ih U a b, hP]
  have hadd := hadd' m

  let fr : ∀ U : Q.Opens, Γ(Q, U) →+* Γ(Q, U) := fun U =>
    { toFun := fun s => s ^ (Nat.card k ^ m)
      map_one' := one_pow _
      map_mul' := fun a b => mul_pow a b _
      map_zero' := zero_pow hq.ne'
      map_add' := hadd U }
  let c : Q.presheaf ⟶
      (TopCat.Presheaf.pushforward CommRingCat (𝟙 Q.toTopCat)).obj Q.presheaf :=
    { app := fun U => CommRingCat.ofHom (fr U.unop)
      naturality := by
        intro U V i
        ext s
        exact (map_pow (Q.presheaf.map i).hom s _).symm }
  let ψ : Q.toPresheafedSpace ⟶ Q.toPresheafedSpace := ⟨𝟙 _, c⟩
  have hloc : ∀ y, IsLocalHom (ψ.stalkMap y).hom := by
    intro y
    constructor
    intro a ha
    obtain ⟨U, hyU, s, rfl⟩ := Q.presheaf.exists_germ_eq a
    rw [PresheafedSpace.stalkMap_germ_apply ψ U y hyU s] at ha
    change IsUnit ((Q.presheaf.germ U y hyU).hom (s ^ (Nat.card k ^ m))) at ha
    rwa [map_pow, isUnit_pow_iff hq.ne'] at ha
  let Φ : Q ⟶ Q := ⟨⟨ψ, hloc⟩⟩
  have hpow : ∀ (U : Q.Opens) (hU : U ≤ Φ ⁻¹ᵁ U) (s : Γ(Q, U)),
      (Φ.appLE U U hU).hom s = s ^ (Nat.card k ^ m) := by
    intro U hU s
    change (Q.presheaf.map (homOfLE hU).op).hom (s ^ (Nat.card k ^ m)) = s ^ (Nat.card k ^ m)
    erw [show (homOfLE hU).op = 𝟙 (Opposite.op U) from rfl, Q.presheaf.map_id]
    rfl
  have happ : ∀ s : Γ(Q, ⊤), Φ.appTop.hom s = s ^ (Nat.card k ^ m) := fun s => rfl
  have hkpow : ∀ x : k, x ^ (Nat.card k ^ m) = x := by
    intro x
    have := FiniteField.pow_card_pow m x
    rwa [Fintype.card_eq_nat_card] at this

  have hfinΦ : IsFinite Φ := by
    rw [isFinite_iff]
    refine ⟨(isAffineHom_iff Φ).mpr (fun U hU => hU), fun U hU => ?_⟩
    have hfin : (fr U).Finite := by
      apply RingHom.IsIntegral.to_finite
      · intro a
        refine ⟨Polynomial.X ^ (Nat.card k ^ m) - Polynomial.C a,
          Polynomial.monic_X_pow_sub_C a hq.ne', ?_⟩
        rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C]
        exact sub_self _
      · have hι1 : (sQ.appLE ⊤ U (fun _ _ => trivial)).hom.FiniteType :=
          HasRingHomProperty.appLE @LocallyOfFiniteType sQ inferInstance
            ⟨⊤, isAffineOpen_top _⟩ ⟨U, hU⟩ (fun _ _ => trivial)
        have hι2 : (Scheme.ΓSpecIso (.of k)).inv.hom.FiniteType :=
          RingHom.FiniteType.of_surjective _ (fun x => ⟨_, Iso.hom_inv_id_apply _ x⟩)
        have hι : (ι U).FiniteType := hι1.comp hι2
        have hcomm : (fr U).comp (ι U) = ι U := by
          ext x
          change (ι U x) ^ (Nat.card k ^ m) = ι U x
          rw [← map_pow, hkpow]
        have h2 : ((fr U).comp (ι U)).FiniteType := by
          rw [hcomm]; exact hι
        exact RingHom.FiniteType.of_comp_finiteType h2
    exact hfin

  have hcomp : Φ ≫ sQ = sQ := by
    apply ext_of_isAffine
    rw [Scheme.Hom.comp_appTop]
    ext s
    change Φ.appTop.hom (sQ.appTop.hom s) = sQ.appTop.hom s
    rw [happ, ← map_pow]
    congr 1
    obtain ⟨r, rfl⟩ : ∃ r, (Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom r = s :=
      ⟨_, Iso.hom_inv_id_apply _ s⟩
    rw [← map_pow, hkpow]
  exact ⟨Φ, hfinΦ, ⟨fun y => rfl, hpow⟩, hcomp⟩

theorem wcpa_dj_sgf_twist_reduced_integral : ∀ (k : Type u) [Field k] [Finite k] (Γ Q : Scheme.{u})
    [AlgebraicGeometry.IsIntegral Γ] [AlgebraicGeometry.IsIntegral Q] (sQ : Q ⟶ Spec (.of k))
    [LocallyOfFiniteType sQ] (g : Γ ⟶ Q) (Φ : Q ⟶ Q) (m : ℕ),
    IsFinite Φ → wcIsAbsFrob Φ (Nat.card k ^ m) → Φ ≫ sQ = sQ →
    ∃ (R : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral R) (r : R ⟶ Limits.pullback g Φ),
      IsClosedImmersion r ∧ Surjective r ∧ IsFinite (r ≫ Limits.pullback.fst g Φ) ∧
      Surjective (r ≫ Limits.pullback.fst g Φ) :=
by
  intro k _ _ Γ Q _ _ sQ _ g Φ m hΦfin hΦ _

  have t_s2 : ∀ (S K L : CommRingCat.{u}) (f₁ : S ⟶ K) (f₂ : S ⟶ L) (p e : ℕ), IsField K →
      Nat.Prime p → ((p : ℕ) : S) = 0 → (∀ b : L, ∃ c : S, f₂.hom c = b ^ (p ^ e)) →
      Subsingleton ↥(Spec (Limits.pushout f₁ f₂)) := by
    intro S K L f₁ f₂ p e hK hp hpS hL
    have hcond : ∀ c : S, (Limits.pushout.inl f₁ f₂).hom (f₁.hom c) =
        (Limits.pushout.inr f₁ f₂).hom (f₂.hom c) := by
      intro c
      have := congrArg (fun φ => φ.hom c) (Limits.pushout.condition (f := f₁) (g := f₂))
      simpa using this
    constructor
    show ∀ 𝔭 𝔮 : PrimeSpectrum (↑(Limits.pushout f₁ f₂) : Type u), 𝔭 = 𝔮
    intro 𝔭 𝔮
    haveI : Nontrivial (↑(Limits.pushout f₁ f₂) : Type u) :=
      ⟨⟨0, 1, fun h => 𝔭.isPrime.ne_top
        ((Ideal.eq_top_iff_one _).mpr (by rw [← h]; exact Ideal.zero_mem _))⟩⟩
    have hpP : ((p : ℕ) : (↑(Limits.pushout f₁ f₂) : Type u)) = 0 := by
      rw [← map_natCast ((Limits.pushout.inl f₁ f₂).hom.comp f₁.hom) p, hpS, map_zero]
    haveI : CharP (↑(Limits.pushout f₁ f₂) : Type u) p :=
      (CharP.charP_iff_prime_eq_zero hp).mpr hpP
    haveI : ExpChar (↑(Limits.pushout f₁ f₂) : Type u) p := ExpChar.prime hp
    let A : Subring (↑(Limits.pushout f₁ f₂) : Type u) :=
      (Limits.pushout.inl f₁ f₂).hom.range.comap
        (iterateFrobenius (↑(Limits.pushout f₁ f₂) : Type u) p e)
    have hA : ∀ z, z ∈ A ↔ ∃ w, (Limits.pushout.inl f₁ f₂).hom w = z ^ (p ^ e) := by
      intro z
      show (iterateFrobenius (↑(Limits.pushout f₁ f₂) : Type u) p e) z ∈
        (Limits.pushout.inl f₁ f₂).hom.range ↔ _
      rw [iterateFrobenius_def, RingHom.mem_range]
    have h1 : ∀ a, (Limits.pushout.inl f₁ f₂).hom a ∈ A := fun a =>
      (hA _).mpr ⟨a ^ (p ^ e), map_pow _ _ _⟩
    have h2 : ∀ b, (Limits.pushout.inr f₁ f₂).hom b ∈ A := by
      intro b
      obtain ⟨c, hc⟩ := hL b
      refine (hA _).mpr ⟨f₁.hom c, ?_⟩
      rw [hcond, hc, map_pow]
    let j₁ := (Limits.pushout.inl f₁ f₂).hom.codRestrict A h1
    let j₂ := (Limits.pushout.inr f₁ f₂).hom.codRestrict A h2
    have hj : f₁ ≫ CommRingCat.ofHom j₁ = f₂ ≫ CommRingCat.ofHom j₂ := by
      ext c
      exact hcond c
    let δ := Limits.pushout.desc (CommRingCat.ofHom j₁) (CommRingCat.ofHom j₂) hj
    have hδ : δ ≫ CommRingCat.ofHom A.subtype = 𝟙 _ := by
      apply Limits.pushout.hom_ext
      · rw [Limits.pushout.inl_desc_assoc, Category.comp_id]
        ext a; rfl
      · rw [Limits.pushout.inr_desc_assoc, Category.comp_id]
        ext a; rfl
    have hgen : ∀ z, ∃ w, (Limits.pushout.inl f₁ f₂).hom w = z ^ (p ^ e) := by
      intro z
      have : z = A.subtype (δ.hom z) := by
        have := congrArg (fun φ => φ.hom z) hδ
        simpa using this.symm
      rw [this]
      exact (hA _).mp (δ.hom z).2
    have key : ∀ (𝔯 : PrimeSpectrum (↑(Limits.pushout f₁ f₂) : Type u))
        (z : (↑(Limits.pushout f₁ f₂) : Type u))
        (w : K), (Limits.pushout.inl f₁ f₂).hom w = z ^ (p ^ e) → (z ∈ 𝔯.asIdeal ↔ w = 0) := by
      intro 𝔯 z w hw
      constructor
      · intro hz
        by_contra hw0
        obtain ⟨w', hw'⟩ := hK.mul_inv_cancel hw0
        apply 𝔯.isPrime.ne_top
        apply Ideal.eq_top_of_isUnit_mem _ _ (isUnit_one)
        have h1 : (Limits.pushout.inl f₁ f₂).hom w * (Limits.pushout.inl f₁ f₂).hom w' = 1 := by
          rw [← map_mul, hw', map_one]
        rw [← h1]
        apply Ideal.mul_mem_right
        rw [hw]
        exact Ideal.pow_mem_of_mem _ hz _ (pow_pos hp.pos _)
      · intro hw0
        apply 𝔯.isPrime.mem_of_pow_mem (p ^ e)
        rw [← hw, hw0, map_zero]
        exact Ideal.zero_mem _
    apply PrimeSpectrum.ext
    ext z
    obtain ⟨w, hw⟩ := hgen z
    rw [key 𝔭 z w hw, key 𝔮 z w hw]

  have t_s1 : ∀ (Y : Scheme.{u}) (Φ : Y ⟶ Y) (N : ℕ), wcIsAbsFrob Φ N → ∀ (y : Y)
      (b : Y.residueField y), ∃ c : Y.residueField (Φ y), (Φ.residueFieldMap y).hom c = b ^ N := by
    intro Y Φ N hΦ y b
    obtain ⟨t, rfl⟩ := Y.residue_surjective y b
    obtain ⟨U, hy, σ, rfl⟩ := Y.presheaf.exists_germ_eq t
    have hU : U ≤ Φ ⁻¹ᵁ U := fun y' hy' => by
      rw [Scheme.Hom.mem_preimage, hΦ.1 y']; exact hy'
    have hy' : Φ y ∈ U := by rw [hΦ.1 y]; exact hy
    refine ⟨(Y.residue (Φ y)).hom ((Y.presheaf.germ U (Φ y) hy').hom σ), ?_⟩
    have e1 := congrArg (fun f => f.hom ((Y.presheaf.germ U (Φ y) hy').hom σ))
      (Scheme.residue_residueFieldMap Φ y)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e1
    rw [e1, Scheme.Hom.germ_stalkMap_apply, ← map_pow, ← map_pow, ← hΦ.2 U hU σ]
    congr 1
    rw [Scheme.Hom.appLE, CommRingCat.hom_comp, RingHom.comp_apply, TopCat.Presheaf.germ_res_apply]

  have t_s4 : ∀ (X : Scheme.{u}) (s : X ⟶ Spec (.of k)) (x : X),
      ((ringChar k : ℕ) : X.residueField x) = 0 := by
    intro X s x
    rw [← map_natCast ((Scheme.ΓSpecIso (.of k)).inv ≫ s.appTop ≫ X.presheaf.germ ⊤ x trivial ≫
      X.residue x).hom, ringChar.Nat.cast_ringChar, map_zero]

  have t_s3 : ∀ {X Y S : Scheme.{u}} (f : X ⟶ S) (g : Y ⟶ S), Function.Injective g →
      (∀ T : Scheme.Pullback.Triplet f g, Subsingleton ↥(Spec T.tensor)) →
      Function.Injective (Limits.pullback.fst f g) := by
    intro X Y S f g hg hT z z' h
    have hc : ∀ w, g (Limits.pullback.snd f g w) = f (Limits.pullback.fst f g w) := by
      intro w
      have := congrArg (fun φ : Limits.pullback f g ⟶ S => φ w)
        (Limits.pullback.condition (f := f) (g := g))
      simp only [Scheme.Hom.comp_apply] at this
      exact this.symm
    have hs : Limits.pullback.snd f g z = Limits.pullback.snd f g z' := by
      apply hg
      rw [hc, hc, h]
    have E : Scheme.Pullback.Triplet.ofPoint z = Scheme.Pullback.Triplet.ofPoint z' :=
      Scheme.Pullback.Triplet.ext
        (by rw [Scheme.Pullback.Triplet.ofPoint_x, Scheme.Pullback.Triplet.ofPoint_x, h])
        (by rw [Scheme.Pullback.Triplet.ofPoint_y, Scheme.Pullback.Triplet.ofPoint_y, hs])
    apply Scheme.Pullback.carrierEquiv.injective
    rw [Scheme.Pullback.carrierEquiv_eq_iff]
    exact ⟨E, (hT _).elim _ _⟩

  haveI : Fintype k := Fintype.ofFinite k
  obtain ⟨n, hp, hcard⟩ := FiniteField.card k (ringChar k)
  have hN : Nat.card k ^ m = ringChar k ^ ((n : ℕ) * m) := by
    rw [Nat.card_eq_fintype_card, hcard, ← pow_mul]
  rw [hN] at hΦ
  have hinj : Function.Injective Φ := fun a b h => by rw [hΦ.1 a, hΦ.1 b] at h; exact h
  haveI : Surjective Φ := (surjective_iff Φ).mpr (fun y => ⟨y, hΦ.1 y⟩)
  have hT : ∀ T : Scheme.Pullback.Triplet g Φ, Subsingleton ↥(Spec T.tensor) := by
    intro T
    show Subsingleton ↥(Spec (Limits.pushout
      ((Scheme.residueFieldCongr T.hx).inv ≫ g.residueFieldMap T.x)
      ((Scheme.residueFieldCongr T.hy).inv ≫ Φ.residueFieldMap T.y)))
    refine t_s2 _ _ _ _ _ (ringChar k) ((n : ℕ) * m) (Field.toIsField _) hp (t_s4 Q sQ T.s) ?_
    intro b
    obtain ⟨c₀, hc₀⟩ := t_s1 Q Φ _ hΦ T.y b
    refine ⟨(Scheme.residueFieldCongr T.hy).hom.hom c₀, ?_⟩
    rw [CommRingCat.hom_comp, RingHom.comp_apply, Iso.hom_inv_id_apply, hc₀]
  have hfst : Function.Injective (Limits.pullback.fst g Φ) := t_s3 g Φ hinj hT

  let J : (Limits.pullback g Φ).IdealSheafData :=
    (⊥ : (Limits.pullback g Φ).IdealSheafData).radical
  have hJr : Set.range J.subschemeι = Set.univ := by
    rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.support_radical,
      Scheme.IdealSheafData.support_bot, TopologicalSpace.Closeds.coe_top]
  have hring : ∀ U : (Limits.pullback g Φ).affineOpens,
      _root_.IsReduced ((Limits.pullback g Φ).presheaf.obj
        (Opposite.op (U : (Limits.pullback g Φ).Opens)) ⧸ J.ideal U) :=
    fun U => (Ideal.isRadical_iff_quotient_reduced _).mp
      (by
        show ((⊥ : (Limits.pullback g Φ).IdealSheafData).radical.ideal U).IsRadical
        rw [Scheme.IdealSheafData.radical_ideal]
        exact Ideal.radical_isRadical _)
  have hpieces : ∀ i, IsReduced (J.subschemeCover.openCover.X i) :=
    fun (U : (Limits.pullback g Φ).affineOpens) => by
      haveI := hring U
      exact (inferInstance : IsReduced (Spec (CommRingCat.of
        ((Limits.pullback g Φ).presheaf.obj
          (Opposite.op (U : (Limits.pullback g Φ).Opens)) ⧸ J.ideal U))))
  haveI hred : IsReduced J.subscheme := IsReduced.of_openCover _ J.subschemeCover.openCover
  haveI hrs : Surjective J.subschemeι :=
    (surjective_iff _).mpr (Set.range_eq_univ.mp hJr)
  haveI hρf : IsFinite (J.subschemeι ≫ Limits.pullback.fst g Φ) := inferInstance
  haveI hρs : Surjective (J.subschemeι ≫ Limits.pullback.fst g Φ) := inferInstance
  have hρinj : Function.Injective (J.subschemeι ≫ Limits.pullback.fst g Φ) := by
    intro a b h
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h
    exact J.subschemeι.isClosedEmbedding.injective (hfst h)
  have hhomeo : IsHomeomorph (J.subschemeι ≫ Limits.pullback.fst g Φ) :=
    isHomeomorph_iff_continuous_isClosedMap_bijective.mpr
      ⟨Scheme.Hom.continuous _, Scheme.Hom.isClosedMap _, hρinj, (surjective_iff _).mp hρs⟩
  haveI : IrreducibleSpace J.subscheme :=
    Function.Surjective.irreducibleSpace (hhomeo.homeomorph _).symm.continuous
      (hhomeo.homeomorph _).symm.surjective
  exact ⟨J.subscheme, isIntegral_of_irreducibleSpace_of_isReduced _, J.subschemeι, inferInstance,
    hrs, hρf, hρs⟩

theorem wcpa_dj_sgf_normalization : ∀ (k : Type u) [Field k] [Finite k] (R : Scheme.{u})
    [AlgebraicGeometry.IsIntegral R] (sR : R ⟶ Spec (.of k)) [IsProper sR],
    ∃ (Xt : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral Xt) (b : Xt ⟶ R),
      IsFinite b ∧ Surjective b ∧ (∀ x : Xt, IsIntegrallyClosed (Xt.presheaf.stalk x)) ∧
      ∃ U : R.Opens, U ≠ ⊥ ∧ IsIso (b ∣_ U) :=
by

  have tmpl : ∀ (Ω : Type u) [Field Ω] [PerfectField Ω] (R : Scheme.{u}) (fR : R ⟶ Spec (.of Ω)) [IsProper fR] [IsReduced R], ∃ (Xt : Scheme.{u}) (b : Xt ⟶ R) (Z : Scheme.{u}) (iZ : Z ⟶ R), IsFinite b ∧ IsClosedImmersion iZ ∧ (∀ U : R.Opens, (U : Set R) = (Set.range iZ)ᶜ → IsIso (b ∣_ U)) ∧ (∀ x : Xt, IsDomain (Xt.presheaf.stalk x) ∧ IsIntegrallyClosed (Xt.presheaf.stalk x)) ∧ (∀ z : Z, ∃ y : R, y ⤳ iZ z ∧ y ≠ iZ z) ∧ (∀ x : Xt, ∃ x' : Xt, x' ⤳ x ∧ b x' ∉ Set.range iZ) := by

    have s0 : ∀ (Ω : Type u) [Field Ω] (R : Scheme.{u}) (fR : R ⟶ Spec (.of Ω)) [IsProper fR]
        (V : R.affineOpens), ∃ φ : Ω →+* Γ(R, V), φ.FiniteType := by
      intro Ω _ R fR _ V
      have h := HasRingHomProperty.appLE @LocallyOfFiniteType fR inferInstance
        ⟨⊤, isAffineOpen_top _⟩ V (by simp)
      refine ⟨(fR.appLE ⊤ V.1 (by simp)).hom.comp (Scheme.ΓSpecIso (.of Ω)).inv.hom, ?_⟩
      exact h.comp (RingHom.FiniteType.of_surjective _
        (Scheme.ΓSpecIso (.of Ω)).commRingCatIsoToRingEquiv.symm.surjective)

    have s4b : ∀ (B : Type u) [CommRing B] [IsDomain B] [IsIntegrallyClosed B] (L : Type u)
        [CommRing L] [Algebra B L], Nonempty (L ≃ₐ[B] ((P : {P : PrimeSpectrum B //
          P.asIdeal ∈ minimalPrimes B}) → Localization.AtPrime P.1.asIdeal)) →
        Function.Bijective (algebraMap B (integralClosure B L)) := by
      intro B _ _ _ L _ _ ⟨e⟩
      have hmin : (⊥ : Ideal B) ∈ minimalPrimes B := by
        refine ⟨⟨Ideal.isPrime_bot, bot_le⟩, fun q _ _ => bot_le⟩
      let P0 : {P : PrimeSpectrum B // P.asIdeal ∈ minimalPrimes B} :=
        ⟨⟨⊥, Ideal.isPrime_bot⟩, hmin⟩
      have huniq : ∀ P : {P : PrimeSpectrum B // P.asIdeal ∈ minimalPrimes B}, P = P0 := by
        intro P
        apply Subtype.ext
        apply PrimeSpectrum.ext
        exact le_antisymm (P.2.2 ⟨Ideal.isPrime_bot, bot_le⟩ bot_le) bot_le
      haveI : IsFractionRing B (Localization.AtPrime P0.1.asIdeal) := by
        have : P0.1.asIdeal.primeCompl = nonZeroDivisors B := by
          ext x; simp [Ideal.primeCompl, P0, mem_nonZeroDivisors_iff_ne_zero]
        show IsLocalization (nonZeroDivisors B) _
        rw [← this]; infer_instance
      let π : L →ₐ[B] Localization.AtPrime P0.1.asIdeal := (Pi.evalAlgHom B _ P0).comp e.toAlgHom
      have hπinj : Function.Injective π := by
        intro x y hxy
        apply e.injective
        funext P
        rw [huniq P]
        exact hxy
      constructor
      · intro a a' h
        have h2 : algebraMap B L a = algebraMap B L a' := congrArg Subtype.val h
        have h3 := congrArg π h2
        rw [π.commutes, π.commutes] at h3
        exact IsFractionRing.injective B _ h3
      · rintro ⟨x, hx⟩
        have hx' : IsIntegral B (π x) := hx.map π
        obtain ⟨a, ha⟩ := IsIntegrallyClosed.isIntegral_iff.mp hx'
        refine ⟨a, Subtype.ext (hπinj ?_)⟩
        show π (algebraMap B L a) = π x
        rw [π.commutes, ha]

    have s6a : ∀ (X R : Scheme.{u}) (g : X ⟶ R) [QuasiCompact g] [QuasiSeparated g],
        (∀ V : R.affineOpens, letI := (g.app V).hom.toAlgebra;
          Module.Finite Γ(R, V) (integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V))) →
        IsFinite (Scheme.Hom.fromNormalization g) := by
      intro X R g _ _ h
      rw [isFinite_iff]
      refine ⟨inferInstance, fun U hU => ?_⟩
      rw [Scheme.Hom.fromNormalization_app g hU]
      letI := (g.app U).hom.toAlgebra
      have h1 := h ⟨U, hU⟩
      rw [CommRingCat.hom_comp]
      apply RingHom.Finite.comp
      · exact RingHom.Finite.of_surjective _
          (Scheme.Hom.normalizationObjIso g hU).commRingCatIsoToRingEquiv.symm.surjective
      · exact RingHom.finite_algebraMap.mpr h1

    have s6b : ∀ (X R : Scheme.{u}) (g : X ⟶ R) [QuasiCompact g] [QuasiSeparated g],
        (∀ V : R.affineOpens, letI := (g.app V).hom.toAlgebra;
          ∀ (Q : Ideal (integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V))) [Q.IsPrime],
            IsDomain (Localization.AtPrime Q) ∧ IsIntegrallyClosed (Localization.AtPrime Q)) →
        ∀ x : Scheme.Hom.normalization g,
          IsDomain ((Scheme.Hom.normalization g).presheaf.stalk x) ∧
          IsIntegrallyClosed ((Scheme.Hom.normalization g).presheaf.stalk x) := by
      intro X R g _ _ h x
      set b := Scheme.Hom.fromNormalization g
      obtain ⟨V, hV, hbV, -⟩ := exists_isAffineOpen_mem_and_subset (x := b x) (U := ⊤) trivial
      have hW : IsAffineOpen (b ⁻¹ᵁ V) := hV.preimage b
      have hx : x ∈ b ⁻¹ᵁ V := hbV
      letI := (g.app V).hom.toAlgebra
      let e : Γ(Scheme.Hom.normalization g, b ⁻¹ᵁ V) ≃+* integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V) :=
        (Scheme.Hom.normalizationObjIso g hV).commRingCatIsoToRingEquiv
      let p := (hW.primeIdealOf ⟨x, hx⟩).asIdeal
      let Q : Ideal (integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V)) := p.comap e.symm.toRingHom
      haveI : Q.IsPrime := Ideal.comap_isPrime _ _
      obtain ⟨hd, hic⟩ := h ⟨V, hV⟩ Q
      set y : (b ⁻¹ᵁ V : Scheme) := ⟨x, hx⟩
      show IsDomain ((Scheme.Hom.normalization g).presheaf.stalk y.1) ∧
        IsIntegrallyClosed ((Scheme.Hom.normalization g).presheaf.stalk y.1)
      letI : Algebra Γ(Scheme.Hom.normalization g, b ⁻¹ᵁ V)
          ((Scheme.Hom.normalization g).presheaf.stalk y.1) :=
        TopCat.Presheaf.algebra_section_stalk (Scheme.Hom.normalization g).presheaf y
      haveI := hW.isLocalization_stalk y
      have hM : p.primeCompl.map e.toMonoidHom = Q.primeCompl := by
        ext z
        constructor
        · rintro ⟨w, hw, rfl⟩
          show e.symm (e w) ∉ p
          rw [e.symm_apply_apply]
          exact hw
        · intro hz
          exact ⟨e.symm z, hz, e.apply_symm_apply z⟩
      let f : (Scheme.Hom.normalization g).presheaf.stalk y.1 ≃+* Localization.AtPrime Q :=
        IsLocalization.ringEquivOfRingEquiv (M := p.primeCompl) (T := Q.primeCompl) _ _ e hM
      haveI : IsDomain ((Scheme.Hom.normalization g).presheaf.stalk y.1) :=
        MulEquiv.isDomain _ f.toMulEquiv
      exact ⟨inferInstance, IsIntegrallyClosed.of_equiv f.symm⟩

    have s6c : ∀ (X R : Scheme.{u}) (g : X ⟶ R) [QuasiCompact g] [QuasiSeparated g] (W : R.Opens),
        IsAffineOpen W → (letI := (g.app W).hom.toAlgebra;
          Function.Bijective (algebraMap Γ(R, W) (integralClosure Γ(R, W) Γ(X, g ⁻¹ᵁ W)))) →
        IsIso (Scheme.Hom.fromNormalization g ∣_ W) := by
      intro X R g _ _ W hW hbij
      set b := Scheme.Hom.fromNormalization g
      haveI : IsAffine W := hW
      haveI : IsAffine (b ⁻¹ᵁ W : Scheme) := hW.preimage b
      have hiso : IsIso (b.app W) := by
        rw [Scheme.Hom.fromNormalization_app g hW]
        letI := (g.app W).hom.toAlgebra
        haveI : IsIso (CommRingCat.ofHom (algebraMap Γ(R, W)
            (integralClosure Γ(R, W) Γ(X, g ⁻¹ᵁ W)))) :=
          (RingEquiv.ofBijective _ hbij).toCommRingCatIso.isIso_hom
        infer_instance
      have hiso' : ∀ U' : R.Opens, U' = W → IsIso (b.app U') := by
        rintro U' rfl; exact hiso
      have htop : IsIso (Scheme.Hom.appTop (b ∣_ W)) := by
        rw [morphismRestrict_appTop]
        have h3 := hiso' _ (Scheme.Opens.ι_image_top W)
        exact @IsIso.comp_isIso _ _ _ _ _ _ _ h3 (Functor.map_isIso _ _)
      have := Scheme.isoSpec_hom_naturality (b ∣_ W)
      have h2 : b ∣_ W = (b ⁻¹ᵁ W : Scheme).isoSpec.hom ≫ Spec.map (Scheme.Hom.appTop (b ∣_ W)) ≫
          (W : Scheme).isoSpec.inv := by
        rw [← Category.assoc, this]; simp
      rw [h2]
      infer_instance

    have s9 : ∀ (R : Scheme.{u}) (N : Set R), IsClosed N →
        ∃ (Z : Scheme.{u}) (iZ : Z ⟶ R), IsClosedImmersion iZ ∧ Set.range iZ = N := by
      intro R N hN
      refine ⟨(Scheme.IdealSheafData.vanishingIdeal ⟨N, hN⟩).subscheme,
        (Scheme.IdealSheafData.vanishingIdeal ⟨N, hN⟩).subschemeι, inferInstance, ?_⟩
      rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.coe_support_vanishingIdeal]
      rfl

    have s10 : ∀ (X R : Scheme.{u}) (b : X ⟶ R) (U : R.Opens),
        (∀ y ∈ U, ∃ V : R.Opens, y ∈ V ∧ IsIso (b ∣_ V)) → IsIso (b ∣_ U) := by
      intro X R b U h
      have hmono : ∀ (V W : R.Opens), W ≤ V → IsIso (b ∣_ V) → IsIso (b ∣_ W) := by
        intro V W hWV hV
        have h1 : IsIso ((b ∣_ V) ∣_ (V.ι ⁻¹ᵁ W)) :=
          IsZariskiLocalAtTarget.restrict (P := MorphismProperty.isomorphisms Scheme) hV _
        have e : V.ι ''ᵁ (V.ι ⁻¹ᵁ W) = W := by
          rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
          exact inf_eq_right.mpr hWV
        have h2 := (MorphismProperty.isomorphisms Scheme).arrow_mk_iso_iff
          (morphismRestrictRestrict b V (V.ι ⁻¹ᵁ W)) |>.mp h1
        rw [e] at h2
        exact h2
      choose! V hyV hV using h
      have key : ∀ y : U, IsIso ((b ∣_ U) ∣_ (U.ι ⁻¹ᵁ V y.1)) := by
        intro y
        have h1 : IsIso (b ∣_ (U.ι ''ᵁ (U.ι ⁻¹ᵁ V y.1))) := by
          apply hmono (V y.1) _ _ (hV y.1 y.2)
          rw [Scheme.Hom.image_preimage_eq_opensRange_inf]
          exact inf_le_right
        exact (MorphismProperty.isomorphisms Scheme).arrow_mk_iso_iff
          (morphismRestrictRestrict b U (U.ι ⁻¹ᵁ V y.1)) |>.mpr h1
      have htop : ⨆ y : U, U.ι ⁻¹ᵁ V y.1 = ⊤ := by
        rw [eq_top_iff]
        intro z _
        exact TopologicalSpace.Opens.mem_iSup.mpr ⟨z, hyV z.1 z.2⟩
      exact (IsZariskiLocalAtTarget.iff_of_iSup_eq_top
        (P := MorphismProperty.isomorphisms Scheme) _ htop).mpr key

    have s12 : ∀ (R : Scheme.{u}) (V : R.Opens) (hV : IsAffineOpen V) (y : R) (hy : y ∈ V),
        ((∀ y' : R, y' ⤳ y → y' = y) →
          (hV.primeIdealOf ⟨y, hy⟩).asIdeal ∈ minimalPrimes Γ(R, V)) ∧
        ∀ f : Γ(R, V), f ∉ (hV.primeIdealOf ⟨y, hy⟩).asIdeal → y ∈ R.basicOpen f := by
      intro R V hV y hy
      have hfy : hV.fromSpec (hV.primeIdealOf ⟨y, hy⟩) = y := hV.fromSpec_primeIdealOf ⟨y, hy⟩
      refine ⟨fun hgen => ?_, fun f hf => ?_⟩
      · refine ⟨⟨(hV.primeIdealOf ⟨y, hy⟩).isPrime, bot_le⟩, fun q ⟨hq, _⟩ hle => ?_⟩
        let q' : PrimeSpectrum Γ(R, V) := ⟨q, hq⟩
        have hsp : q' ⤳ hV.primeIdealOf ⟨y, hy⟩ := (PrimeSpectrum.le_iff_specializes _ _).mp hle
        have h1 : hV.fromSpec q' ⤳ y := hfy ▸ hsp.map hV.fromSpec.continuous
        have h2 : hV.fromSpec q' = hV.fromSpec (hV.primeIdealOf ⟨y, hy⟩) :=
          (hgen _ h1).trans hfy.symm
        have h3 := hV.fromSpec.isOpenEmbedding.injective h2
        have : q' = hV.primeIdealOf ⟨y, hy⟩ := h3
        rw [← this]
      · have h1 : hV.primeIdealOf ⟨y, hy⟩ ∈ PrimeSpectrum.basicOpen f := hf
        rw [← hV.fromSpec_preimage_basicOpen] at h1
        have h2 : hV.fromSpec (hV.primeIdealOf ⟨y, hy⟩) ∈ R.basicOpen f := h1
        rwa [hfy] at h2

    have s6 : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (L : Type u) [CommRing L] [Algebra A L], Nonempty (L ≃ₐ[A] ((P : {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A}) → Localization.AtPrime P.1.asIdeal)) → ∀ Q ∈ minimalPrimes (integralClosure A L), Q.comap (algebraMap A (integralClosure A L)) ∈ minimalPrimes A := by
      intro A _ _ L _ _ ⟨e⟩ Q hQ
      have : Q.IsPrime := hQ.1.1
      set q := Q.comap (algebraMap A (integralClosure A L)) with hq
      have hqp : q.IsPrime := Ideal.comap_isPrime _ _
      have hdis := Ideal.disjoint_nonZeroDivisors_of_mem_minimalPrimes hQ
      have hunit : ∀ a : A, (∀ P ∈ minimalPrimes A, a ∉ P) → IsUnit (algebraMap A L a) := by
        intro a ha
        have h1 : IsUnit (e (algebraMap A L a)) := by
          rw [e.commutes, Pi.isUnit_iff]
          intro P
          rw [Pi.algebraMap_apply]
          exact (IsLocalization.AtPrime.isUnit_to_map_iff _ P.1.asIdeal a).mpr (ha _ P.2)
        have h2 := h1.map e.symm
        simpa using h2
      have hsub : (q : Set A) ⊆ ⋃ P ∈ minimalPrimes A, ((id P : Ideal A) : Set A) := by
        intro a haq
        by_contra hcon
        simp only [Set.mem_iUnion, not_exists, id] at hcon
        have hu := hunit a (fun P hP h => hcon P hP h)
        have hnzd : algebraMap A (integralClosure A L) a ∈ nonZeroDivisors (integralClosure A L) := by
          rw [mem_nonZeroDivisors_iff_right]
          intro c hc
          apply Subtype.ext
          have hc' : (c : L) * algebraMap A L a = 0 := by
            have := congrArg (fun z : integralClosure A L => (z : L)) hc
            simpa using this
          simpa using (hu.mul_left_eq_zero).mp hc'
        exact Set.disjoint_left.mp hdis haq hnzd
      obtain ⟨P, hP, hle⟩ := (Ideal.subset_union_prime_finite (minimalPrimes.finite_of_isNoetherianRing A)
        (f := id) ⊥ ⊥ (fun P hP _ _ => hP.1.1)).mp hsub
      have heq : q = P := le_antisymm hle (hP.2 ⟨hqp, bot_le⟩ hle)
      rw [heq]
      exact hP

    have s7 : ∀ (X R : Scheme.{u}) (g : X ⟶ R) [QuasiCompact g] [QuasiSeparated g], (∀ V : R.affineOpens, letI := (g.app V).hom.toAlgebra; ∀ Q ∈ minimalPrimes (integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V)), Q.comap (algebraMap Γ(R, V) (integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V))) ∈ minimalPrimes Γ(R, V)) → ∀ x : Scheme.Hom.normalization g, ∃ x' : Scheme.Hom.normalization g, x' ⤳ x ∧ ∀ y : R, y ⤳ Scheme.Hom.fromNormalization g x' → y = Scheme.Hom.fromNormalization g x' := by
      intro X R g _ _ hD x
      set b := Scheme.Hom.fromNormalization g
      obtain ⟨V, hV, hbV, -⟩ := exists_isAffineOpen_mem_and_subset (x := b x) (U := ⊤) trivial
      have hW : IsAffineOpen (b ⁻¹ᵁ V) := hV.preimage b
      have hx : x ∈ b ⁻¹ᵁ V := hbV
      letI := (g.app V).hom.toAlgebra
      set p := hW.primeIdealOf ⟨x, hx⟩
      obtain ⟨q₀, hq₀, hle⟩ := Ideal.exists_minimalPrimes_le (J := p.asIdeal) (I := ⊥) bot_le
      let s : Spec Γ(Scheme.Hom.normalization g, b ⁻¹ᵁ V) := ⟨q₀, hq₀.1.1⟩
      refine ⟨hW.fromSpec s, ?_, ?_⟩
      · have hsp : s ⤳ p := (PrimeSpectrum.le_iff_specializes _ _).mp hle
        have := hsp.map hW.fromSpec.continuous
        rwa [hW.fromSpec_primeIdealOf] at this
      · have hcomp := IsAffineOpen.SpecMap_appLE_fromSpec b hV hW le_rfl
        have hbx : b (hW.fromSpec s) = hV.fromSpec ((Spec.map (b.appLE V (b ⁻¹ᵁ V) le_rfl)) s) := by
          rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hcomp]
        let e : Γ(Scheme.Hom.normalization g, b ⁻¹ᵁ V) ≃+* integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V) :=
          (Scheme.Hom.normalizationObjIso g hV).commRingCatIsoToRingEquiv
        let Q : Ideal (integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V)) := q₀.comap e.symm.toRingHom
        have hQ : Q ∈ minimalPrimes (integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V)) := by
          have := Ideal.minimalPrimes_comap_of_surjective (f := e.symm.toRingHom) e.symm.surjective hq₀
          rw [Ideal.comap_bot_of_injective e.symm.toRingHom e.symm.injective] at this
          exact this
        have hP := hD ⟨V, hV⟩ Q hQ
        set t := (Spec.map (b.appLE V (b ⁻¹ᵁ V) le_rfl)) s with ht
        have hideal : t.asIdeal =
            Q.comap (algebraMap Γ(R, V) (integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V))) := by
          show q₀.comap (b.appLE V (b ⁻¹ᵁ V) le_rfl).hom = _
          rw [← Scheme.Hom.app_eq_appLE, Scheme.Hom.fromNormalization_app g hV, CommRingCat.hom_comp,
            ← Ideal.comap_comap]
          rfl
        rw [hbx]
        intro y hy
        have hmem : hV.fromSpec t ∈ (V : Set R) := hV.range_fromSpec ▸ ⟨t, rfl⟩
        have hyV : y ∈ (V : Set R) := hy.mem_open V.isOpen hmem
        rw [← hV.range_fromSpec] at hyV
        obtain ⟨t', rfl⟩ := hyV
        have hsp : t' ⤳ t := hV.fromSpec.isOpenEmbedding.isInducing.specializes_iff.mp hy
        have hle' : t'.asIdeal ≤ t.asIdeal := (PrimeSpectrum.le_iff_specializes _ _).mpr hsp
        rw [hideal] at hle'
        have hge := hP.2 ⟨t'.isPrime, bot_le⟩ hle'
        rw [← hideal] at hge
        have : t' = t := PrimeSpectrum.ext (le_antisymm (hideal ▸ hle') hge)
        rw [this]
    intro Ω _ _ R fR _ _
    obtain ⟨X, g, hqc, hqs, hL⟩ := generic_points_scheme Ω R fR
    haveI := hqc
    haveI := hqs
    have hnoeth : ∀ (V : R.Opens) (hV : IsAffineOpen V), IsNoetherianRing Γ(R, V) := by
      intro V hV
      obtain ⟨φ, hφ⟩ := s0 Ω R fR ⟨V, hV⟩
      letI := φ.toAlgebra
      haveI : Algebra.FiniteType Ω Γ(R, V) := hφ
      exact Algebra.FiniteType.isNoetherianRing Ω _
    have hfinP : ∀ (V : R.Opens) (hV : IsAffineOpen V), ∀ P ∈ minimalPrimes Γ(R, V),
        Module.Finite (Γ(R, V) ⧸ P)
          (integralClosure (Γ(R, V) ⧸ P) (FractionRing (Γ(R, V) ⧸ P))) := by
      intro V hV P hP
      obtain ⟨φ, hφ⟩ := s0 Ω R fR ⟨V, hV⟩
      letI := φ.toAlgebra
      haveI : Algebra.FiniteType Ω Γ(R, V) := hφ
      haveI : P.IsPrime := hP.1.1
      exact noether_integralClosure_finite Ω (Γ(R, V) ⧸ P)
    haveI hfin : IsFinite (Scheme.Hom.fromNormalization g) := by
      apply s6a X R g
      intro V
      letI := (g.app V).hom.toAlgebra
      haveI := hnoeth V.1 V.2
      exact integralClosure_prod_minimal_finite Γ(R, V) Γ(X, g ⁻¹ᵁ V) (hL V) (hfinP V.1 V.2)
    have hnorm := s6b X R g (fun V => by
      letI := (g.app V).hom.toAlgebra
      haveI := hnoeth V.1 V.2
      exact integralClosure_prod_minimal_stalks_normal Γ(R, V) Γ(X, g ⁻¹ᵁ V) (hL V))
    have hgen : ∀ y : R, (∀ y' : R, y' ⤳ y → y' = y) →
        ∃ W : R.Opens, y ∈ W ∧ IsIso (Scheme.Hom.fromNormalization g ∣_ W) := by
      intro y hy
      obtain ⟨V, hV, hyV, -⟩ := exists_isAffineOpen_mem_and_subset (x := y) (U := ⊤) trivial
      obtain ⟨hmin, hbasic⟩ := s12 R V hV y hyV
      haveI := hnoeth V hV
      obtain ⟨f, hf, hB⟩ := reduced_noetherian_generic_normal Γ(R, V) (hfinP V hV) _ (hmin hy)
      have hW : IsAffineOpen (R.basicOpen f) := hV.basicOpen f
      haveI := hV.isLocalization_basicOpen f
      obtain ⟨hdom, hic⟩ := hB Γ(R, R.basicOpen f)
      refine ⟨R.basicOpen f, hbasic f hf, ?_⟩
      apply s6c X R g _ hW
      letI := (g.app (R.basicOpen f)).hom.toAlgebra
      exact s4b Γ(R, R.basicOpen f) Γ(X, g ⁻¹ᵁ R.basicOpen f) (hL ⟨R.basicOpen f, hW⟩)
    let G : Set R := {y | ∃ W : R.Opens, y ∈ W ∧ IsIso (Scheme.Hom.fromNormalization g ∣_ W)}
    have hGopen : IsOpen G := by
      rw [isOpen_iff_forall_mem_open]
      rintro y ⟨W, hyW, hW⟩
      exact ⟨W, fun z hz => ⟨W, hz, hW⟩, W.isOpen, hyW⟩
    obtain ⟨Z, iZ, hiZ, hrange⟩ := s9 R Gᶜ hGopen.isClosed_compl
    haveI := hiZ
    have hnongen : ∀ z : Z, ∃ y' : R, y' ⤳ iZ z ∧ y' ≠ iZ z := by
      intro z
      have hz : iZ z ∈ Gᶜ := by rw [← hrange]; exact ⟨z, rfl⟩
      by_contra hcon
      push_neg at hcon
      obtain ⟨W, hyW, hW⟩ := hgen (iZ z) hcon
      exact hz ⟨W, hyW, hW⟩
    have hD1 : ∀ V : R.affineOpens, letI := (g.app V).hom.toAlgebra;
        ∀ Q ∈ minimalPrimes (integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V)),
          Q.comap (algebraMap Γ(R, V) (integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V))) ∈
            minimalPrimes Γ(R, V) := by
      intro V
      letI := (g.app V).hom.toAlgebra
      haveI := hnoeth V.1 V.2
      exact s6 Γ(R, V) Γ(X, g ⁻¹ᵁ V) (hL V)
    have hdense : ∀ x : Scheme.Hom.normalization g, ∃ x' : Scheme.Hom.normalization g,
        x' ⤳ x ∧ Scheme.Hom.fromNormalization g x' ∉ Set.range iZ := by
      intro x
      obtain ⟨x', hsp, hgx'⟩ := s7 X R g hD1 x
      refine ⟨x', hsp, fun hmem => ?_⟩
      rw [hrange] at hmem
      obtain ⟨W, hW, hiso⟩ := hgen _ hgx'
      exact hmem ⟨W, hW, hiso⟩
    refine ⟨Scheme.Hom.normalization g, Scheme.Hom.fromNormalization g, Z, iZ, hfin, hiZ,
      ?_, hnorm, hnongen, hdense⟩
    intro U hU
    apply s10 _ R _ U
    intro y hy
    have h : y ∈ (U : Set R) := hy
    rw [hU, hrange, compl_compl] at h
    exact h

  intro k _ _ R _ sR _
  obtain ⟨Xt, b, Z, iZ, hfin, hiZ, hiso, hnorm, hnongen, hdense⟩ := tmpl k R sR
  haveI := hfin
  haveI := hiZ
  have hZcl : IsClosed (Set.range iZ) := iZ.isClosedEmbedding.isClosed_range
  let U : R.Opens := ⟨(Set.range iZ)ᶜ, hZcl.isOpen_compl⟩
  have hU : IsIso (b ∣_ U) := hiso U rfl
  have hηsp : ∀ y : R, genericPoint R ⤳ y := fun y =>
    (genericPoint_spec R).specializes (Set.mem_univ y)

  have hηU : genericPoint R ∈ U := by
    show genericPoint R ∉ Set.range iZ
    rintro ⟨z, hz⟩
    obtain ⟨y, hy, hne⟩ := hnongen z
    rw [hz] at hy hne
    exact hne (hy.antisymm (hηsp y)).eq
  have hUne : U ≠ ⊥ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).mpr ⟨_, hηU⟩

  have hcomm : ∀ v : (b ⁻¹ᵁ U : Scheme), U.ι ((b ∣_ U) v) = b ((b ⁻¹ᵁ U).ι v) := by
    intro v
    rw [← Scheme.Hom.comp_apply, morphismRestrict_ι, Scheme.Hom.comp_apply]
  obtain ⟨w, hw⟩ : genericPoint R ∈ Set.range U.ι := by
    rw [Scheme.Opens.range_ι]; exact hηU
  obtain ⟨u, hu⟩ := Surjective.surj (f := b ∣_ U) w
  have hbξ : b ((b ⁻¹ᵁ U).ι u) = genericPoint R := by
    rw [← hcomm, hu, hw]

  have hspec : ∀ x : Xt, (b ⁻¹ᵁ U).ι u ⤳ x := by
    intro x
    obtain ⟨x', hx'x, hx'Z⟩ := hdense x
    have hx'U : x' ∈ b ⁻¹ᵁ U := by
      rw [Scheme.Hom.mem_preimage]; exact hx'Z
    obtain ⟨u', hu'⟩ : x' ∈ Set.range (b ⁻¹ᵁ U).ι := by
      rw [Scheme.Opens.range_ι]; exact hx'U
    have h1 : U.ι ((b ∣_ U) u) ⤳ U.ι ((b ∣_ U) u') := by
      rw [hcomm, hcomm, hu', hbξ]
      exact hηsp _
    have h2 : (b ∣_ U) u ⤳ (b ∣_ U) u' := U.ι.isOpenEmbedding.isInducing.specializes_iff.mp h1
    have h3 : u ⤳ u' := (b ∣_ U).isOpenEmbedding.isInducing.specializes_iff.mp h2
    have h4 : (b ⁻¹ᵁ U).ι u ⤳ x' := hu' ▸ h3.map (b ⁻¹ᵁ U).ι.continuous
    exact h4.trans hx'x
  have hclos : closure ({(b ⁻¹ᵁ U).ι u} : Set Xt) = Set.univ :=
    Set.eq_univ_of_forall fun x => specializes_iff_mem_closure.mp (hspec x)
  haveI : IrreducibleSpace Xt := by
    rw [irreducibleSpace_def]
    have := (isIrreducible_singleton (x := (b ⁻¹ᵁ U).ι u)).closure
    rw [hclos] at this
    exact this
  haveI : ∀ x : Xt, _root_.IsReduced (Xt.presheaf.stalk x) := fun x => by
    haveI := (hnorm x).1
    infer_instance
  haveI : IsReduced Xt := isReduced_of_isReduced_stalk Xt
  haveI hXt : AlgebraicGeometry.IsIntegral Xt := isIntegral_of_irreducibleSpace_of_isReduced Xt

  have hsurj : Surjective b := by
    constructor
    intro y
    have hcl : IsClosed (Set.range b) := by
      rw [← Set.image_univ]; exact b.isClosedMap _ isClosed_univ
    exact (hηsp y).mem_closed hcl ⟨_, hbξ⟩
  exact ⟨Xt, hXt, b, hfin, hsurj, fun x => (hnorm x).2, U, hUne, hU⟩

theorem wcpa_dj_scd_rel_trdeg : ∀ (k : Type u) [Field k] (X S : Scheme.{u}) [AlgebraicGeometry.IsIntegral X] [AlgebraicGeometry.IsIntegral S] (sS : S ⟶ Spec (.of k)) [IsProper sS] (g : X ⟶ S) [IsProper (g ≫ sS)] (d : ℕ), topologicalKrullDim S = (d : WithBot ℕ∞) → topologicalKrullDim X = ((d + 1 : ℕ) : WithBot ℕ∞) → ∀ (h : g (genericPoint X) ⤳ genericPoint S), letI := (S.presheaf.stalkSpecializes h ≫ g.stalkMap (genericPoint X)).hom.toAlgebra; Algebra.trdeg (S.presheaf.stalk (genericPoint S)) (X.presheaf.stalk (genericPoint X)) ≤ 1 :=
by
  intro k _ X S _ _ sS _ g _ d hS hX h
  have hηS : genericPoint S ∈ (⊤ : S.Opens) := trivial
  have hηX : genericPoint X ∈ (⊤ : X.Opens) := trivial
  have key : S.presheaf.germ ⊤ (genericPoint S) hηS ≫ S.presheaf.stalkSpecializes h ≫
      g.stalkMap (genericPoint X) = g.appTop ≫ X.presheaf.germ ⊤ (genericPoint X) hηX := by
    rw [TopCat.Presheaf.germ_stalkSpecializes_assoc]
    first
      | (rw [Scheme.Hom.germ_stalkMap]; rfl)
      | (rw [Scheme.Hom.germ_stalkMap]; simp [Scheme.Hom.appTop])
      | (simp [Scheme.Hom.appTop, Scheme.Hom.germ_stalkMap])
  letI iL : Algebra k (S.presheaf.stalk (genericPoint S)) :=
    ((Scheme.ΓSpecIso (.of k)).inv ≫ sS.appTop ≫ S.presheaf.germ ⊤ (genericPoint S) trivial).hom.toAlgebra
  letI iM : Algebra k (X.presheaf.stalk (genericPoint X)) :=
    ((Scheme.ΓSpecIso (.of k)).inv ≫ (g ≫ sS).appTop ≫
      X.presheaf.germ ⊤ (genericPoint X) trivial).hom.toAlgebra
  letI iLM : Algebra (S.presheaf.stalk (genericPoint S)) (X.presheaf.stalk (genericPoint X)) :=
    (S.presheaf.stalkSpecializes h ≫ g.stalkMap (genericPoint X)).hom.toAlgebra
  have hmor : ((Scheme.ΓSpecIso (.of k)).inv ≫ sS.appTop ≫
      S.presheaf.germ ⊤ (genericPoint S) trivial) ≫
      (S.presheaf.stalkSpecializes h ≫ g.stalkMap (genericPoint X)) =
      (Scheme.ΓSpecIso (.of k)).inv ≫ (g ≫ sS).appTop ≫
        X.presheaf.germ ⊤ (genericPoint X) trivial := by
    rw [Scheme.Hom.comp_appTop]
    simp only [Category.assoc]
    exact congrArg (fun f => (Scheme.ΓSpecIso (.of k)).inv ≫ sS.appTop ≫ f) key
  haveI : IsScalarTower k (S.presheaf.stalk (genericPoint S)) (X.presheaf.stalk (genericPoint X)) :=
    IsScalarTower.of_algebraMap_eq (fun c => (congrArg (fun f => f.hom c) hmor).symm)
  obtain ⟨-, nS, tS, htS, hdS⟩ := wcpa_dj_cf_sp_function_field_trdeg k S sS
  obtain ⟨-, nX, tX, htX, hdX⟩ := wcpa_dj_cf_sp_function_field_trdeg k X (g ≫ sS)
  have hnS : nS = d := by
    have h1 := hdS.symm.trans hS
    exact_mod_cast h1
  have hnX : nX = d + 1 := by
    have h1 := hdX.symm.trans hX
    exact_mod_cast h1
  have cS : Algebra.trdeg k (S.presheaf.stalk (genericPoint S)) = (nS : Cardinal) := by
    have h1 := htS.lift_cardinalMk_eq_trdeg
    simp only [Cardinal.mk_fin, Cardinal.lift_natCast, Cardinal.lift_uzero] at h1
    exact h1.symm
  have cX : Algebra.trdeg k (X.presheaf.stalk (genericPoint X)) = (nX : Cardinal) := by
    have h1 := htX.lift_cardinalMk_eq_trdeg
    simp only [Cardinal.mk_fin, Cardinal.lift_natCast, Cardinal.lift_uzero] at h1
    exact h1.symm
  have hadd := trdeg_add_eq k (S.presheaf.stalk (genericPoint S))
    (A := X.presheaf.stalk (genericPoint X))
  rw [cS, cX, hnS, hnX, Nat.cast_add, Nat.cast_one, add_comm (d : Cardinal),
    add_comm (d : Cardinal) 1] at hadd
  have ht : Algebra.trdeg (S.presheaf.stalk (genericPoint S)) (X.presheaf.stalk (genericPoint X)) = 1 :=
    (Cardinal.add_right_inj_of_lt_aleph0 (Cardinal.natCast_lt_aleph0)).mp hadd
  exact ht.le

theorem wcpa_dj_scd_generic_trdeg_le : ∀ (A D L M : Type u) [CommRing A] [IsDomain A] [CommRing D] [IsDomain D] [Field L] [Field M] [Algebra A D] [Algebra A L] [Algebra A M] [Algebra L M] [Algebra D M] [IsScalarTower A L M] [IsScalarTower A D M] [IsFractionRing A L] [IsFractionRing D M], Algebra.trdeg (FractionRing A) (TensorProduct A (FractionRing A) D) ≤ Algebra.trdeg L M :=
by
  intro A D L M _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
  classical
  have hAM : Function.Injective (algebraMap A M) := by
    rw [IsScalarTower.algebraMap_eq A L M]
    exact (algebraMap L M).injective.comp (IsFractionRing.injective A L)
  haveI : FaithfulSMul A M := (faithfulSMul_iff_algebraMap_injective A M).mpr hAM
  letI : Algebra (FractionRing A) M := FractionRing.liftAlgebra A M
  let ψ : TensorProduct A (FractionRing A) D →ₐ[FractionRing A] M :=
    Algebra.TensorProduct.lift (Algebra.ofId (FractionRing A) M) (IsScalarTower.toAlgHom A D M)
      (fun _ _ => Commute.all _ _)
  have hψt : ∀ (c : FractionRing A) (d : D),
      ψ (TensorProduct.tmul A c d) = algebraMap (FractionRing A) M c * algebraMap D M d := by
    intro c d
    simp [ψ, Algebra.TensorProduct.lift_tmul]
  have hmove : ∀ (x : A) (d : D), TensorProduct.tmul A (algebraMap A (FractionRing A) x) d
      = TensorProduct.tmul A (1 : FractionRing A) (algebraMap A D x * d) := by
    intro x d
    rw [Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul, Algebra.smul_def]
  have hclear : ∀ z : TensorProduct A (FractionRing A) D, ∃ a ∈ nonZeroDivisors A, ∃ d : D,
      (TensorProduct.tmul A (algebraMap A (FractionRing A) a) (1 : D)) * z
        = TensorProduct.tmul A (1 : FractionRing A) d := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact ⟨1, one_mem _, 0, by rw [mul_zero, TensorProduct.tmul_zero]⟩
    | tmul c d₀ =>
      obtain ⟨⟨x, s⟩, hxs⟩ := IsLocalization.surj (nonZeroDivisors A) c
      refine ⟨s, s.2, algebraMap A D x * d₀, ?_⟩
      rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_comm]
      simp only at hxs
      rw [hxs, hmove]
    | add z₁ z₂ h₁ h₂ =>
      obtain ⟨a₁, ha₁, d₁, e₁⟩ := h₁
      obtain ⟨a₂, ha₂, d₂, e₂⟩ := h₂
      refine ⟨a₁ * a₂, mul_mem ha₁ ha₂, algebraMap A D a₂ * d₁ + algebraMap A D a₁ * d₂, ?_⟩
      have hsplit : ∀ (b₁ b₂ : A),
          TensorProduct.tmul A (algebraMap A (FractionRing A) (b₁ * b₂)) (1 : D)
          = (TensorProduct.tmul A (algebraMap A (FractionRing A) b₂) (1 : D)) *
            (TensorProduct.tmul A (algebraMap A (FractionRing A) b₁) (1 : D)) := by
        intro b₁ b₂
        rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, map_mul, mul_comm]
      rw [mul_add, hsplit a₁ a₂, mul_assoc, e₁,
        mul_comm (TensorProduct.tmul A (algebraMap A (FractionRing A) a₂) (1 : D))
          (TensorProduct.tmul A (algebraMap A (FractionRing A) a₁) (1 : D)), mul_assoc, e₂]
      simp only [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [hmove, hmove, TensorProduct.tmul_add]
  have hψ : Function.Injective ψ := by
    rw [injective_iff_map_eq_zero]
    intro z hz
    obtain ⟨a, ha, d, e⟩ := hclear z
    have h1 : ψ (TensorProduct.tmul A (1 : FractionRing A) d) = 0 := by
      rw [← e, map_mul, hz, mul_zero]
    rw [hψt, map_one, one_mul] at h1
    have hd : d = 0 := (IsFractionRing.injective D M) (by rw [h1, map_zero])
    rw [hd, TensorProduct.tmul_zero] at e
    have hne : algebraMap A (FractionRing A) a ≠ 0 :=
      IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors ha
    calc z = (TensorProduct.tmul A (algebraMap A (FractionRing A) a)⁻¹ (1 : D)) *
          ((TensorProduct.tmul A (algebraMap A (FractionRing A) a) (1 : D)) * z) := by
            rw [← mul_assoc, Algebra.TensorProduct.tmul_mul_tmul, inv_mul_cancel₀ hne, mul_one,
              ← Algebra.TensorProduct.one_def, one_mul]
      _ = 0 := by rw [e, mul_zero]
  have h1 := trdeg_le_of_injective ψ hψ
  let eKL : FractionRing A ≃ₐ[A] L :=
    IsLocalization.algEquiv (nonZeroDivisors A) (FractionRing A) L
  letI : Algebra (FractionRing A) L := (eKL : FractionRing A →+* L).toAlgebra
  have hcomp : algebraMap (FractionRing A) M
      = (algebraMap L M).comp (eKL : FractionRing A →+* L) := by
    apply IsLocalization.ringHom_ext (nonZeroDivisors A)
    rw [← IsScalarTower.algebraMap_eq A (FractionRing A) M, RingHom.comp_assoc]
    have : (eKL : FractionRing A →+* L).comp (algebraMap A (FractionRing A)) = algebraMap A L := by
      ext x
      exact eKL.commutes x
    rw [this, ← IsScalarTower.algebraMap_eq A L M]
  haveI : IsScalarTower (FractionRing A) L M := IsScalarTower.of_algebraMap_eq (fun x => by
    rw [hcomp]; rfl)
  haveI : Algebra.IsAlgebraic (FractionRing A) L := by
    constructor
    intro l
    have : l = algebraMap (FractionRing A) L (eKL.symm l) := by
      show l = eKL (eKL.symm l)
      rw [AlgEquiv.apply_symm_apply]
    rw [this]
    exact isAlgebraic_algebraMap _
  haveI : FaithfulSMul (FractionRing A) L :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr (RingHom.injective _)
  haveI : FaithfulSMul L M :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr (RingHom.injective _)
  have h2 := trdeg_add_eq (FractionRing A) L (A := M)
  rw [trdeg_eq_zero, zero_add] at h2
  rw [h2]
  exact h1

theorem wcpa_dj_scd_noether_dim : ∀ (K E Ω : Type u) [Field K] [CommRing E] [Algebra K E] [Algebra.FiniteType K E] [Field Ω] [Algebra K Ω], Algebra.trdeg K E ≤ 1 → ringKrullDim (TensorProduct K Ω E) ≤ 1 :=
by
  intro K E Ω _ _ _ _ _ _ htr
  classical

  have T1 : ∀ (R S : Type u) [CommRing R] [CommRing S] (f : R →+* S), f.IsIntegral →
      ringKrullDim S ≤ ringKrullDim R := by
    intro R S _ _ f hf
    letI := f.toAlgebra
    haveI : Algebra.IsIntegral R S := ⟨hf⟩
    refine Order.krullDim_le_of_strictMono (PrimeSpectrum.comap f) ?_
    intro P Q hPQ
    exact Ideal.IsIntegral.under_lt_under (R := R) (show P.asIdeal < Q.asIdeal from hPQ)

  rcases subsingleton_or_nontrivial E with hE | hE
  · haveI : Subsingleton (TensorProduct K Ω E) := by
      have h0 : ∀ z : TensorProduct K Ω E, z = 0 := by
        intro z
        induction z using TensorProduct.induction_on with
        | zero => rfl
        | tmul x y => rw [Subsingleton.elim y 0, TensorProduct.tmul_zero]
        | add x y hx hy => rw [hx, hy, add_zero]
      exact ⟨fun a b => by rw [h0 a, h0 b]⟩
    rw [ringKrullDim_eq_bot_of_subsingleton]
    exact bot_le

  obtain ⟨s, G, hGinj, hGfin⟩ := exists_finite_inj_algHom_of_fg K E

  have hs : s ≤ 1 := by
    have hai : AlgebraicIndependent K (G ∘ (MvPolynomial.X : Fin s → MvPolynomial (Fin s) K)) :=
      (MvPolynomial.algebraicIndependent_X (Fin s) K).map' hGinj
    have h1 := hai.lift_cardinalMk_le_trdeg
    simp only [Cardinal.mk_fin, Cardinal.lift_natCast, Cardinal.lift_uzero] at h1
    have h2 : (s : Cardinal.{u}) ≤ 1 := h1.trans htr
    exact_mod_cast h2

  let Φ := Algebra.TensorProduct.map (AlgHom.id K Ω) G
  have hGint : G.toRingHom.IsIntegral := RingHom.IsIntegral.of_finite hGfin
  have hΦ : Φ.toRingHom.IsIntegral := by
    have hl : ∀ y : Ω, Φ.toRingHom.IsIntegralElem (TensorProduct.tmul K y (1 : E)) := by
      intro y
      have h := Φ.toRingHom.isIntegralElem_map
        (x := TensorProduct.tmul K y (1 : MvPolynomial (Fin s) K))
      simpa [Φ, Algebra.TensorProduct.map_tmul] using h
    have hr : ∀ m : E, Φ.toRingHom.IsIntegralElem (TensorProduct.tmul K (1 : Ω) m) := by
      intro m
      obtain ⟨p, hpm, hp⟩ := hGint m
      refine ⟨p.map (Algebra.TensorProduct.includeRight :
        MvPolynomial (Fin s) K →ₐ[K] TensorProduct K Ω (MvPolynomial (Fin s) K)).toRingHom,
        hpm.map _, ?_⟩
      rw [Polynomial.eval₂_map]
      have hc : Φ.toRingHom.comp (Algebra.TensorProduct.includeRight :
          MvPolynomial (Fin s) K →ₐ[K] TensorProduct K Ω (MvPolynomial (Fin s) K)).toRingHom =
          (Algebra.TensorProduct.includeRight : E →ₐ[K] TensorProduct K Ω E).toRingHom.comp
            G.toRingHom := by
        refine RingHom.ext fun x => ?_
        simp [Φ, Algebra.TensorProduct.map_tmul]
      rw [hc]
      have e2 : TensorProduct.tmul K (1 : Ω) m =
          (Algebra.TensorProduct.includeRight : E →ₐ[K] TensorProduct K Ω E).toRingHom m := rfl
      rw [e2, ← Polynomial.hom_eval₂, hp, map_zero]
    intro x
    induction x using TensorProduct.induction_on with
    | zero =>
      have h0 := Φ.toRingHom.isIntegralElem_map (x := 0)
      rwa [map_zero] at h0
    | tmul y m =>
      have e : TensorProduct.tmul K y m =
          TensorProduct.tmul K y (1 : E) * TensorProduct.tmul K (1 : Ω) m := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [e]
      exact RingHom.IsIntegralElem.mul _ (hl y) (hr m)
    | add x y hx hy => exact RingHom.IsIntegralElem.add _ hx hy
  have hle := T1 _ _ Φ.toRingHom hΦ

  have hP : ringKrullDim (TensorProduct K Ω (MvPolynomial (Fin s) K)) = (s : WithBot ℕ∞) := by
    rw [ringKrullDim_eq_of_ringEquiv (MvPolynomial.algebraTensorAlgEquiv K Ω).toRingEquiv,
      MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field, zero_add]
    first
      | (rw [ENat.card_eq_coe_fintype_card, Fintype.card_fin]; done)
      | (rw [ENat.card_eq_coe_fintype_card, Fintype.card_fin]; rfl)
      | (simp; done)
      | (simp; rfl)
  rw [hP] at hle
  refine hle.trans ?_
  exact_mod_cast hs

theorem wcpa_dj_sgs_chart_dim : ∀ (k : Type u) [Field k] (X S : Scheme.{u}) [AlgebraicGeometry.IsIntegral X] [AlgebraicGeometry.IsIntegral S] (sS : S ⟶ Spec (.of k)) [IsProper sS] (g : X ⟶ S) [IsProper (g ≫ sS)] (d : ℕ), topologicalKrullDim S = (d : WithBot ℕ∞) → topologicalKrullDim X = ((d + 1 : ℕ) : WithBot ℕ∞) → g (genericPoint X) = genericPoint S → ∀ (V : S.Opens) [Nonempty V], IsAffineOpen V → ∀ (U : X.Opens), IsAffineOpen U → ∀ (hUV : U ≤ g ⁻¹ᵁ V), letI := (g.appLE V U hUV).hom.toAlgebra; ringKrullDim (TensorProduct Γ(S, V) Γ(X, U) (AlgebraicClosure (FractionRing Γ(S, V)))) ≤ 1 :=
by
  intro k _ X S _ _ sS _ g _ d hSd hXd hgen V _ hV U hU hUV
  letI := (g.appLE V U hUV).hom.toAlgebra
  classical
  by_cases hUe : (U : Set X).Nonempty
  swap
  ·
    have hU0 : U = ⊥ := by
      ext x
      constructor
      · intro hx; exact absurd ⟨x, hx⟩ hUe
      · intro hx; exact absurd hx (by simp)
    haveI : Subsingleton Γ(X, U) := by rw [hU0]; infer_instance
    haveI : Subsingleton (TensorProduct Γ(S, V) Γ(X, U)
        (AlgebraicClosure (FractionRing Γ(S, V)))) := by
      have h0 : ∀ z : TensorProduct Γ(S, V) Γ(X, U) (AlgebraicClosure (FractionRing Γ(S, V))),
          z = 0 := by
        intro z
        induction z using TensorProduct.induction_on with
        | zero => rfl
        | tmul x y => rw [Subsingleton.elim x 0, TensorProduct.zero_tmul]
        | add x y hx hy => rw [hx, hy, add_zero]
      exact ⟨fun a b => by rw [h0 a, h0 b]⟩
    rw [ringKrullDim_eq_bot_of_subsingleton]
    exact bot_le

  haveI hUne : Nonempty U := hUe.to_subtype
  obtain ⟨⟨v, hv⟩⟩ := (inferInstance : Nonempty V)
  obtain ⟨u, hu⟩ := hUe
  have hηS : genericPoint S ∈ V :=
    (IsGenericPoint.mem_open_set_iff (genericPoint_spec S) V.isOpen).mpr ⟨v, trivial, hv⟩
  have hηX : genericPoint X ∈ U :=
    (IsGenericPoint.mem_open_set_iff (genericPoint_spec X) U.isOpen).mpr ⟨u, trivial, hu⟩
  have h : g (genericPoint X) ⤳ genericPoint S := by rw [hgen]

  have key : S.presheaf.germ V (genericPoint S) hηS ≫ S.presheaf.stalkSpecializes h ≫
      g.stalkMap (genericPoint X) = g.appLE V U hUV ≫ X.presheaf.germ U (genericPoint X) hηX := by
    rw [TopCat.Presheaf.germ_stalkSpecializes_assoc]
    first
      | (rw [Scheme.Hom.germ_stalkMap, Scheme.Hom.appLE, Category.assoc,
          TopCat.Presheaf.germ_res]; done)
      | (rw [Scheme.Hom.germ_stalkMap, Scheme.Hom.appLE, Category.assoc,
          TopCat.Presheaf.germ_res']; done)
      | (simp only [Scheme.Hom.germ_stalkMap, Scheme.Hom.appLE, Category.assoc,
          TopCat.Presheaf.germ_res]; done)
      | (simp [Scheme.Hom.appLE]; done)

  haveI : LocallyOfFiniteType g := locallyOfFiniteType_of_comp g sS
  have hft : (g.appLE V U hUV).hom.FiniteType :=
    HasRingHomProperty.appLE @LocallyOfFiniteType g inferInstance ⟨V, hV⟩ ⟨U, hU⟩ hUV
  haveI : Algebra.FiniteType Γ(S, V) Γ(X, U) := RingHom.finiteType_algebraMap.mp hft
  haveI : Algebra.FiniteType (FractionRing Γ(S, V))
      (TensorProduct Γ(S, V) (FractionRing Γ(S, V)) Γ(X, U)) :=
    Algebra.FiniteType.baseChange (FractionRing Γ(S, V))

  have htr : Algebra.trdeg (FractionRing Γ(S, V))
      (TensorProduct Γ(S, V) (FractionRing Γ(S, V)) Γ(X, U)) ≤ 1 := by
    haveI := functionField_isFractionRing_of_isAffineOpen S V hV
    haveI := functionField_isFractionRing_of_isAffineOpen X U hU
    letI : Algebra S.functionField X.functionField :=
      (S.presheaf.stalkSpecializes h ≫ g.stalkMap (genericPoint X)).hom.toAlgebra
    letI : Algebra Γ(S, V) X.functionField :=
      ((algebraMap S.functionField X.functionField).comp
        (algebraMap Γ(S, V) S.functionField)).toAlgebra
    haveI : IsScalarTower Γ(S, V) S.functionField X.functionField :=
      IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : IsScalarTower Γ(S, V) Γ(X, U) X.functionField := by
      refine IsScalarTower.of_algebraMap_eq (fun a => ?_)
      change (S.presheaf.stalkSpecializes h ≫ g.stalkMap (genericPoint X)).hom
          ((S.presheaf.germ V (genericPoint S) hηS).hom a) =
        (X.presheaf.germ U (genericPoint X) hηX).hom ((g.appLE V U hUV).hom a)
      have := congrArg (fun f => (CommRingCat.Hom.hom f) a) key
      simpa only [CommRingCat.hom_comp, RingHom.comp_apply] using this
    have h4 := wcpa_dj_scd_generic_trdeg_le Γ(S, V) Γ(X, U) S.functionField X.functionField
    have h3 := wcpa_dj_scd_rel_trdeg k X S sS g d hSd hXd h
    exact h4.trans h3
  have h5 := wcpa_dj_scd_noether_dim (FractionRing Γ(S, V))
    (TensorProduct Γ(S, V) (FractionRing Γ(S, V)) Γ(X, U))
    (AlgebraicClosure (FractionRing Γ(S, V))) htr
  rw [ringKrullDim_eq_of_ringEquiv
    ((Algebra.TensorProduct.comm Γ(S, V) Γ(X, U) (AlgebraicClosure (FractionRing Γ(S, V)))).toRingEquiv.trans
