      have h1 := (cocyc N f j.1 i.1 (U i ⊓ U j) (hW1' i j) (hW1 i j)).2
      have h2 := (cocyc m g j.2 i.2 (U i ⊓ U j) (hW2' i j) (hW2 i j)).2
      exact (isUnit_iff_exists_inv.mpr ⟨_, h1⟩).mul (isUnit_iff_exists_inv.mpr ⟨_, h2⟩)
    have htrans : ∀ i j J, Pz.presheaf.map (homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).op (s j J) =
        w i j * Pz.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op (s i J) := by
      intro i j J
      show Pz.presheaf.map (homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).op
          (f.appLE (wcRsD R N j.1) (U j) (hU1 j) (wcRsE R N j.1 (e.symm J).1) *
            g.appLE (wcRsD R m j.2) (U j) (hU2 j) (wcRsE R m j.2 (e.symm J).2)) =
        (f.appLE (wcRsD R N j.1) (U i ⊓ U j) (hW1' i j) (wcRsE R N j.1 i.1) *
          g.appLE (wcRsD R m j.2) (U i ⊓ U j) (hW2' i j) (wcRsE R m j.2 i.2)) *
        Pz.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op
          (f.appLE (wcRsD R N i.1) (U i) (hU1 i) (wcRsE R N i.1 (e.symm J).1) *
            g.appLE (wcRsD R m i.2) (U i) (hU2 i) (wcRsE R m i.2 (e.symm J).2))
      rw [map_mul, map_mul, hres2, hres2, hres2, hres2,
        (cocyc N f j.1 i.1 _ (hW1' i j) (hW1 i j)).1 (e.symm J).1,
        (cocyc m g j.2 i.2 _ (hW2' i j) (hW2 i j)).1 (e.symm J).2]
      ring
    obtain ⟨σ, U1, U2, U3⟩ := HUP N' Pz fX U hU s hspan w hw htrans
    have h : ∀ b c, f ⁻¹ᵁ wcRsD R N b ⊓ g ⁻¹ᵁ wcRsD R m c ≤ σ ⁻¹ᵁ wcRsD R N' (e (b, c)) := by
      intro b c
      have h1 := U2 (b, c) (e (b, c))
      rw [hs1, Scheme.basicOpen_one] at h1
      exact h1.symm.le.trans inf_le_left
    have hpre : ∀ b c, σ ⁻¹ᵁ wcRsD R N' (e (b, c)) ≤ f ⁻¹ᵁ wcRsD R N b ⊓ g ⁻¹ᵁ wcRsD R m c := by
      intro b c
      calc σ ⁻¹ᵁ wcRsD R N' (e (b, c)) = σ ⁻¹ᵁ wcRsD R N' (e (b, c)) ⊓ ⨆ i, U i := by
            rw [hU, inf_top_eq]
        _ = ⨆ i, σ ⁻¹ᵁ wcRsD R N' (e (b, c)) ⊓ U i := inf_iSup_eq _ _
        _ = ⨆ i, Pz.basicOpen (s i (e (b, c))) := iSup_congr (fun i => U2 i (e (b, c)))
        _ ≤ _ := by
          refine iSup_le (fun i => ?_)
          rw [hsAt, Scheme.basicOpen_mul]
          refine le_inf (inf_le_left.trans ?_) (inf_le_right.trans ?_)
          · show Pz.basicOpen (f.appLE (wcRsD R N i.1) (U i) (hU1 i) (wcRsE R N i.1 b)) ≤ _
            rw [Scheme.basicOpen_appLE, (S2 N i.1 b b).2.1]
            exact inf_le_right.trans (Scheme.Hom.preimage_mono _ inf_le_right)
          · show Pz.basicOpen (g.appLE (wcRsD R m i.2) (U i) (hU2 i) (wcRsE R m i.2 c)) ≤ _
            rw [Scheme.basicOpen_appLE, (S2 m i.2 c c).2.1]
            exact inf_le_right.trans (Scheme.Hom.preimage_mono _ inf_le_right)
    refine ⟨σ, h, U1, hpre, ?_⟩
    intro b b2 c c2
    have h3 := U3 (b, c) (e (b, c)) (e (b2, c2)) (U (b, c)) (h b c) le_rfl
    rw [hs1, map_one, mul_one, hid, hsAt] at h3
    exact h3
  obtain ⟨σ, h, hover, hpre, hcoords⟩ := key _ (Limits.pullback.fst (wcRsStr R N) (wcRsStr R m))
    (Limits.pullback.snd (wcRsStr R N) (wcRsStr R m))
    (Limits.pullback.fst (wcRsStr R N) (wcRsStr R m) ≫ wcRsStr R N) (N * m + N + m)
    (finProdFinEquiv.trans (finCongr (by ring)))

  have AC : ∀ (X Y : Scheme.{u}) (φ : X ⟶ Y) (U : Y.Opens) (V : X.Opens) (hV : V ≤ φ ⁻¹ᵁ U),
      IsAffineOpen U → IsAffineOpen V → φ ⁻¹ᵁ U ≤ V →
      Function.Surjective (φ.appLE U V hV).hom → IsClosedImmersion (φ ∣_ U) := by
    intro X Y φ U V hV hU hVa hle hsurj
    have hEq : V = φ ⁻¹ᵁ U := le_antisymm hV hle
    subst hEq
    have : IsAffine (U : Scheme.{u}) := hU
    have : IsAffine ((φ ⁻¹ᵁ U : X.Opens) : Scheme.{u}) := hVa
    apply IsClosedImmersion.of_surjective_of_isAffine
    show Function.Surjective (ConcreteCategory.hom ((φ ∣_ U).app ⊤))
    rw [Scheme.Hom.app_eq_appLE, morphismRestrict_appLE]
    refine (Scheme.Hom.appLE_congr φ _ (Scheme.Opens.ι_image_top U) ?_
      (fun f => Function.Surjective (ConcreteCategory.hom f))).mpr hsurj
    rw [Scheme.Hom.preimage_top, Scheme.Opens.ι_image_top]
  have hconst' : ∀ {A B : Scheme.{u}} (k : A ⟶ B) (U : B.Opens) (W : A.Opens) (e : W ≤ k ⁻¹ᵁ U)
      (x : Γ(B, ⊤)), k.appLE U W e (B.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op x) =
        A.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op (k.appTop x) := by
    intro A B k U W e x
    rw [← CategoryTheory.comp_apply, Scheme.Hom.map_appLE]
    rfl
  have hcomp : ∀ {A B C' : Scheme.{u}} (k : A ⟶ B) (l : B ⟶ C') (x : Γ(C', ⊤)),
      (k ≫ l).appTop x = k.appTop (l.appTop x) := by
    intro A B C' k l x
    rw [Scheme.Hom.comp_appTop]
    rfl
  have SURJ : ∀ (S X Y T : Scheme.{u}) (f : X ⟶ S) (g : Y ⟶ S) (qT : T ⟶ S)
      (φ : Limits.pullback f g ⟶ T) (D : X.Opens) (C : Y.Opens) (E : T.Opens) {ι₁ ι₂ : Type}
      (a : ι₁ → Γ(X, D)) (b : ι₂ → Γ(Y, C)) (a' : ι₁ → Γ(T, E)) (b' : ι₂ → Γ(T, E))
      (h : Limits.pullback.fst f g ⁻¹ᵁ D ⊓ Limits.pullback.snd f g ⁻¹ᵁ C ≤ φ ⁻¹ᵁ E),
      φ ≫ qT = Limits.pullback.fst f g ≫ f →
      (∀ x : Γ(X, D), x ∈ Subring.closure (Set.range a ∪ Set.range (fun s : Γ(S, ⊤) =>
        X.presheaf.map (homOfLE (le_top : D ≤ ⊤)).op (f.appTop s)))) →
      (∀ y : Γ(Y, C), y ∈ Subring.closure (Set.range b ∪ Set.range (fun s : Γ(S, ⊤) =>
        Y.presheaf.map (homOfLE (le_top : C ≤ ⊤)).op (g.appTop s)))) →
      (∀ t : Γ(Limits.pullback f g, Limits.pullback.fst f g ⁻¹ᵁ D ⊓ Limits.pullback.snd f g ⁻¹ᵁ C),
        t ∈ Subring.closure (Set.range (((Limits.pullback f g).presheaf.map (homOfLE
          (inf_le_left : Limits.pullback.fst f g ⁻¹ᵁ D ⊓ Limits.pullback.snd f g ⁻¹ᵁ C ≤
            Limits.pullback.fst f g ⁻¹ᵁ D)).op).hom.comp ((Limits.pullback.fst f g).app D).hom) ∪
          Set.range (((Limits.pullback f g).presheaf.map (homOfLE
          (inf_le_right : Limits.pullback.fst f g ⁻¹ᵁ D ⊓ Limits.pullback.snd f g ⁻¹ᵁ C ≤
            Limits.pullback.snd f g ⁻¹ᵁ C)).op).hom.comp ((Limits.pullback.snd f g).app C).hom))) →
      (∀ i, φ.appLE E _ h (a' i) = (Limits.pullback.fst f g).appLE D _ inf_le_left (a i)) →
      (∀ j, φ.appLE E _ h (b' j) = (Limits.pullback.snd f g).appLE C _ inf_le_right (b j)) →
      Function.Surjective (φ.appLE E _ h).hom := by
    intro S X Y T f g qT φ D C E ι₁ ι₂ a b a' b' h hov hX hY hP ha hb
    have hc1 : ∀ s : Γ(S, ⊤), (Limits.pullback.fst f g).appLE D _ inf_le_left
        (X.presheaf.map (homOfLE (le_top : D ≤ ⊤)).op (f.appTop s)) =
        φ.appLE E _ h (T.presheaf.map (homOfLE (le_top : E ≤ ⊤)).op (qT.appTop s)) := by
      intro s
      rw [hconst', hconst', ← hcomp, ← hcomp, hov]
    have hc2 : ∀ s : Γ(S, ⊤), (Limits.pullback.snd f g).appLE C _ inf_le_right
        (Y.presheaf.map (homOfLE (le_top : C ≤ ⊤)).op (g.appTop s)) =
        φ.appLE E _ h (T.presheaf.map (homOfLE (le_top : E ≤ ⊤)).op (qT.appTop s)) := by
      intro s
      rw [hconst', hconst', ← hcomp, ← hcomp, hov, Limits.pullback.condition]
    have h1 : ∀ x : Γ(X, D), (Limits.pullback.fst f g).appLE D _ inf_le_left x ∈
        (φ.appLE E _ h).hom.range := by
      intro x
      have hle : Subring.closure (Set.range a ∪ Set.range (fun s : Γ(S, ⊤) =>
          X.presheaf.map (homOfLE (le_top : D ≤ ⊤)).op (f.appTop s))) ≤
          (φ.appLE E _ h).hom.range.comap
            ((Limits.pullback.fst f g).appLE D _ inf_le_left).hom := by
        rw [Subring.closure_le]
        rintro _ (⟨i, rfl⟩ | ⟨s, rfl⟩)
        · exact Subring.mem_comap.mpr (RingHom.mem_range.mpr ⟨a' i, ha i⟩)
        · exact Subring.mem_comap.mpr (RingHom.mem_range.mpr ⟨_, (hc1 s).symm⟩)
      exact Subring.mem_comap.mp (hle (hX x))
    have h2 : ∀ y : Γ(Y, C), (Limits.pullback.snd f g).appLE C _ inf_le_right y ∈
        (φ.appLE E _ h).hom.range := by
      intro y
      have hle : Subring.closure (Set.range b ∪ Set.range (fun s : Γ(S, ⊤) =>
          Y.presheaf.map (homOfLE (le_top : C ≤ ⊤)).op (g.appTop s))) ≤
          (φ.appLE E _ h).hom.range.comap
            ((Limits.pullback.snd f g).appLE C _ inf_le_right).hom := by
        rw [Subring.closure_le]
        rintro _ (⟨j, rfl⟩ | ⟨s, rfl⟩)
        · exact Subring.mem_comap.mpr (RingHom.mem_range.mpr ⟨b' j, hb j⟩)
        · exact Subring.mem_comap.mpr (RingHom.mem_range.mpr ⟨_, (hc2 s).symm⟩)
      exact Subring.mem_comap.mp (hle (hY y))
    intro t
    have hle : Subring.closure (Set.range (((Limits.pullback f g).presheaf.map (homOfLE
          (inf_le_left : Limits.pullback.fst f g ⁻¹ᵁ D ⊓ Limits.pullback.snd f g ⁻¹ᵁ C ≤
            Limits.pullback.fst f g ⁻¹ᵁ D)).op).hom.comp ((Limits.pullback.fst f g).app D).hom) ∪
          Set.range (((Limits.pullback f g).presheaf.map (homOfLE
          (inf_le_right : Limits.pullback.fst f g ⁻¹ᵁ D ⊓ Limits.pullback.snd f g ⁻¹ᵁ C ≤
            Limits.pullback.snd f g ⁻¹ᵁ C)).op).hom.comp ((Limits.pullback.snd f g).app C).hom)) ≤
        (φ.appLE E _ h).hom.range := by
      rw [Subring.closure_le]
      rintro _ (⟨x, rfl⟩ | ⟨y, rfl⟩)
      · exact h1 x
      · exact h2 y
    exact RingHom.mem_range.mp (hle (hP t))
  have hcl : IsClosedImmersion σ := by
    refine IsZariskiLocalAtTarget.of_iSup_eq_top (P := @IsClosedImmersion) (wcRsD R (N * m + N + m))
      (hcov (N * m + N + m)) (fun J => ?_)
    obtain ⟨⟨b, c⟩, rfl⟩ := (finProdFinEquiv.trans (finCongr (by ring)) :
      Fin (N + 1) × Fin (m + 1) ≃ Fin (N * m + N + m + 1)).surjective J
    have hP := CPG (Spec (.of R)) (wcRsPj R N) (wcRsPj R m) (wcRsStr R N) (wcRsStr R m)
      (wcRsD R N b) (wcRsD R m c) (haff N b) (haff m c)
    refine AC _ _ σ _ (wcRsV R N m b c) (h b c) (haff _ _) hP.1 (hpre b c) ?_
    refine SURJ (Spec (.of R)) (wcRsPj R N) (wcRsPj R m) (wcRsPj R (N * m + N + m)) (wcRsStr R N)
      (wcRsStr R m) (wcRsStr R (N * m + N + m)) σ (wcRsD R N b) (wcRsD R m c) _
      (wcRsE R N b) (wcRsE R m c) (fun i => wcRsE R (N * m + N + m) _ ((finProdFinEquiv.trans (finCongr (by ring)) :
        Fin (N + 1) × Fin (m + 1) ≃ Fin (N * m + N + m + 1)) (i, c)))
      (fun j => wcRsE R (N * m + N + m) _ ((finProdFinEquiv.trans (finCongr (by ring)) :
        Fin (N + 1) × Fin (m + 1) ≃ Fin (N * m + N + m + 1)) (b, j))) (h b c) hover ?_ ?_ hP.2 ?_ ?_
    · intro x
      refine Subring.closure_mono ?_ (S1 N b x)
      rintro _ (⟨L, rfl⟩ | ⟨k, rfl⟩)
      · exact Or.inl ⟨L, rfl⟩
      · exact Or.inr ⟨_, rfl⟩
    · intro y
      refine Subring.closure_mono ?_ (S1 m c y)
      rintro _ (⟨L, rfl⟩ | ⟨k, rfl⟩)
      · exact Or.inl ⟨L, rfl⟩
      · exact Or.inr ⟨_, rfl⟩
    · intro i
      have hi := hcoords b i c c
      rw [(S2 m c c c).1, map_one, mul_one] at hi
      exact hi
    · intro j
      have hj := hcoords b b c j
      rw [(S2 N b b b).1, map_one, one_mul] at hj
      exact hj
  exact ⟨N * m + N + m, σ, hcl, hover⟩

theorem wcpa_dj_ms_blowup_flat_proj_W : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)), Flat uX → (∃ (N : ℕ) (j : X ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) MvPolynomial.gradedAlgebra), IsClosedImmersion j ∧ j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W 0))) = uX) → ∀ (I : X.IdealSheafData), (∀ U : X.affineOpens, (I.ideal U).FG) → ∀ (X' : Scheme.{u}) (r : X' ⟶ X), wcCsdIsBlowup I r → Flat (r ≫ uX) ∧ IsProper (r ≫ uX) ∧ (∃ (N : ℕ) (j : X' ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) MvPolynomial.gradedAlgebra), IsClosedImmersion j ∧ j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W 0))) = r ≫ uX) :=
by
  intro Ω _ W X uX hflat hproj I hI X' r hbl

  have hA : Flat (r ≫ uX) := by
    haveI := hflat

    have ringTF : ∀ (B : CommRingCat.{u}) (φ : Γ(Spec (.of ↥W), ⊤) ⟶ B), RingHom.Flat φ.hom ↔
        ∀ c : ↥W, c ≠ 0 → ∀ s : B, φ.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom c) * s = 0 → s = 0 := by
      intro B φ
      set ψ : ↥W →+* B := φ.hom.comp (Scheme.ΓSpecIso (.of ↥W)).inv.hom with hψ
      have hφψ : φ.hom = ψ.comp (Scheme.ΓSpecIso (.of ↥W)).hom.hom := by
        ext x
        simp [hψ]
      have hbinv : Function.Bijective (Scheme.ΓSpecIso (.of ↥W)).inv.hom :=
        ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (.of ↥W)).inv
      have hbhom : Function.Bijective (Scheme.ΓSpecIso (.of ↥W)).hom.hom :=
        ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (.of ↥W)).hom
      have e1 : RingHom.Flat φ.hom ↔ RingHom.Flat ψ := by
        constructor
        · intro h
          exact RingHom.Flat.comp (RingHom.Flat.of_bijective hbinv) h
        · intro h
          rw [hφψ]
          exact RingHom.Flat.comp (RingHom.Flat.of_bijective hbhom) h
      rw [e1]
      letI := ψ.toAlgebra
      have e : ψ.Flat ↔ Module.Flat ↥W B := Iff.rfl
      rw [e, Module.Flat.flat_iff_torsion_eq_bot_of_isBezout, Submodule.eq_bot_iff]
      constructor
      · intro h c hc s hs
        apply h s
        rw [Submodule.mem_torsion_iff]
        refine ⟨⟨c, mem_nonZeroDivisors_of_ne_zero hc⟩, ?_⟩
        rw [Submonoid.smul_def, Algebra.smul_def, RingHom.algebraMap_toAlgebra]
        exact hs
      · intro h s hs
        rw [Submodule.mem_torsion_iff] at hs
        obtain ⟨⟨c, hc⟩, hcs⟩ := hs
        refine h c (nonZeroDivisors.ne_zero hc) s ?_
        rw [Submonoid.smul_def, Algebra.smul_def, RingHom.algebraMap_toAlgebra] at hcs
        exact hcs
    have htop : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (O : A.Opens), O ≤ f ⁻¹ᵁ ⊤ := by
      intro A B f O
      rw [Scheme.Hom.preimage_top]
      exact le_top
    have hle : ∀ O : X'.Opens, O ≤ (r ≫ uX) ⁻¹ᵁ ⊤ := fun O => htop _ O
    let TF : X'.Opens → Prop := fun O => ∀ c : ↥W, c ≠ 0 → ∀ s : Γ(X', O),
      ((r ≫ uX).appLE ⊤ O (hle O)).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom c) * s = 0 → s = 0

    have TF_of_flat : ∀ V : X'.Opens, IsAffineOpen V → Flat (V.ι ≫ r ≫ uX) → TF V := by
      intro V hV hfl
      haveI : IsAffine V := hV
      have h1 : RingHom.Flat ((V.ι ≫ r ≫ uX).appLE ⊤ ⊤ (htop _ ⊤)).hom :=
        HasRingHomProperty.appLE (P := @Flat) (V.ι ≫ r ≫ uX) hfl
          ⟨⊤, isAffineOpen_top _⟩ ⟨⊤, isAffineOpen_top _⟩ (htop _ ⊤)
      have e2 : (⊤ : (V : Scheme.{u}).Opens) ≤ V.ι ⁻¹ᵁ (V.ι ''ᵁ ⊤) := by
        intro x _
        exact ⟨x, trivial, rfl⟩
      have heq : (V.ι ≫ r ≫ uX).appLE ⊤ ⊤ (htop _ ⊤) = (r ≫ uX).appLE ⊤ (V.ι ''ᵁ ⊤) (hle _) := by
        rw [← Scheme.Hom.appLE_comp_appLE V.ι (r ≫ uX) ⊤ (V.ι ''ᵁ ⊤) ⊤ (hle _) e2,
          Scheme.Opens.ι_appLE]
        have : (homOfLE (le_refl _) : V.ι ''ᵁ ⊤ ⟶ V.ι ''ᵁ ⊤) = 𝟙 _ := Subsingleton.elim _ _
        erw [this, op_id, CategoryTheory.Functor.map_id, Category.comp_id]
      rw [heq] at h1
      have h2 : TF (V.ι ''ᵁ ⊤) := (ringTF _ ((r ≫ uX).appLE ⊤ (V.ι ''ᵁ ⊤) (hle _))).mp h1
      rw [Scheme.Opens.ι_image_top] at h2
      exact h2

    set U₀ : X.Opens := I.support.compl with hU₀
    haveI hiso : IsIso (r ∣_ U₀) := wc_csd_blowup_iso_off_center X X' I r U₀ hbl
      (by rw [hU₀, TopologicalSpace.Closeds.coe_compl]; exact Set.inter_compl_self _)
    have hflatV : ∀ V : X'.Opens, V ≤ r ⁻¹ᵁ U₀ → Flat (V.ι ≫ r ≫ uX) := by
      intro V hV
      have e : V.ι ≫ r ≫ uX = X'.homOfLE hV ≫ (r ∣_ U₀) ≫ U₀.ι ≫ uX := by
        rw [← Scheme.homOfLE_ι X' hV, Category.assoc, ← reassoc_of% (morphismRestrict_ι r U₀)]
      rw [e]
      infer_instance

    have hchart : ∀ x' : X', ∃ V : X'.Opens, IsAffineOpen V ∧ x' ∈ V ∧ TF V := by
      intro x'
      obtain ⟨U, V, hVU, a, hx, ha, hb, -⟩ := hbl.1 x'
      refine ⟨V.1, V.2, hx, ?_⟩
      set b := (r.appLE U.1 V.1 hVU).hom a with hbdef
      have hD : X'.basicOpen b ≤ r ⁻¹ᵁ U₀ := by
        intro y hy
        have hy' : y ∈ V.1 ⊓ r ⁻¹ᵁ X.basicOpen a := by
          rw [← Scheme.basicOpen_appLE]; exact hy
        have hya : r y ∈ X.basicOpen a := (Scheme.Hom.mem_preimage r).mp hy'.2
        have hyU : r y ∈ U.1 := X.basicOpen_le a hya
        rw [Scheme.Hom.mem_preimage, hU₀, ← SetLike.mem_coe, TopologicalSpace.Closeds.coe_compl]
        intro hsupp0
        have hsupp : r y ∈ I.support := hsupp0
        rw [Scheme.IdealSheafData.mem_support_iff_of_mem hyU, Scheme.mem_zeroLocus_iff] at hsupp
        exact hsupp a ha hya
      have hDTF : TF (X'.basicOpen b) :=
        TF_of_flat _ (V.2.basicOpen b) (hflatV _ hD)
      intro c hc s hs
      have hres := Scheme.Hom.appLE_map (r ≫ uX) (hle V.1) (homOfLE (X'.basicOpen_le b)).op
      have h1 : (X'.presheaf.map (homOfLE (X'.basicOpen_le b)).op).hom s = 0 := by
        apply hDTF c hc
        rw [← hres, CommRingCat.comp_apply, ← map_mul, hs, map_zero]
      obtain ⟨n, hn⟩ := exists_pow_mul_eq_zero_of_res_basicOpen_eq_zero_of_isAffineOpen X' V.2 s b h1
      exact (mul_left_mem_nonZeroDivisors_eq_zero_iff (pow_mem hb n)).mp hn
    choose V hVaff hxV hTF using hchart
    refine HasRingHomProperty.of_iSup_eq_top (P := @Flat) (fun x' : X' => ⟨V x', hVaff x'⟩) ?_ ?_
    · exact eq_top_iff.mpr fun x _ => TopologicalSpace.Opens.mem_iSup.mpr ⟨x, hxV x⟩
    · intro x'
      exact (ringTF _ _).mpr (hTF x')

  have s6 : ∀ (K : Type u) [CommRing K] (n : ℕ), IsProper (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0)))) := by
    intro K _ n
    letI := @MvPolynomial.gradedAlgebra (Fin (n+1)) K _
    letI : IsScalarTower K ((MvPolynomial.homogeneousSubmodule (Fin (n+1)) K) 0)
        (MvPolynomial (Fin (n+1)) K) :=
      IsScalarTower.of_algebraMap_eq (R := K)
        (S := (MvPolynomial.homogeneousSubmodule (Fin (n+1)) K) 0)
        (A := MvPolynomial (Fin (n+1)) K) (fun r => rfl)
    haveI : Algebra.FiniteType ((MvPolynomial.homogeneousSubmodule (Fin (n+1)) K) 0)
