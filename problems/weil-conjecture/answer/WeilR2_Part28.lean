    have hcomp : ∀ c : Q.presheaf.stalk (genericPoint Q),
        lam (((Scheme.ΓSpecIso (CommRingCat.of F')).inv ≫ t.appTop).hom
          (algebraMap (Q.presheaf.stalk (genericPoint Q)) F' c)) =
