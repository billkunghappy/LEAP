        ι ≫ Limits.pullback.snd t sC = Limits.pullback.snd π σB ≫ ρ := by
    intro Y P B C S π σB ρ sB sC t ιP ht hι h1 h2
    subst ht
    have hcomm : Limits.pullback.fst π σB ≫ π ≫ sB = (Limits.pullback.snd π σB ≫ ρ) ≫ sC := by
