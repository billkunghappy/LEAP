theorem wcpa_dj_flrg_closure_flat : ∀ (k : Type u) [Field k] (X P P' : Scheme.{u}) [AlgebraicGeometry.IsIntegral P] [AlgebraicGeometry.IsIntegral P'] (sP : P ⟶ Spec (.of k)) (f : X ⟶ P) (U : P.Opens) (N : ℕ) (jX : X ⟶ wcProjK k N) (hcomm : jX ≫ wcProjKStr k N = f ≫ sP) (hZ : (Limits.pullback.fst f U.ι ≫ jX) ≫ wcProjKStr k N = Limits.pullback.snd f U.ι ≫ U.ι ≫ sP) (e₀ r L : ℕ) (Φ : ℕ → ℕ) (μ : U.toScheme ⟶ wcProjK k L) (G : ∀ c : Fin (L + 1), Fin r → MvPolynomial (Fin (N + 1)) Γ(wcProjK k L, wcSgD k L c)) (β : P' ⟶ P) (γ : P' ⟶ wcProjK k L), IsClosedImmersion jX → wcpaDjIsProjOver k sP → wcpaDjIsProjOver k (β ≫ sP) → U ≠ ⊥ → μ ≫ wcProjKStr k L = U.ι ≫ sP → wcpaDjFlrgHilb k N (U.ι ≫ sP) (Limits.pullback.fst f U.ι ≫ jX) (Limits.pullback.snd f U.ι) hZ e₀ r L Φ μ G → IsIso (β ∣_ U) → γ ≫ wcProjKStr k L = β ≫ sP → (β ⁻¹ᵁ U).ι ≫ γ = (β ∣_ U) ≫ μ → Flat ((Limits.pullback.snd f β ⁻¹ᵁ (β ⁻¹ᵁ U)).ι.imageι ≫ Limits.pullback.snd f β) :=
by
  intro k _ X P P' _ _ sP f U N jX hcomm hZ e₀ r L Φ μ G β γ hjX hP hP' hU hμ hH hβiso hγ hcomp
