theorem wcpa_dj_gs_section_geom_integral : ∀ (Y P : Scheme.{u}) [AlgebraicGeometry.IsIntegral Y] [AlgebraicGeometry.IsIntegral P] [IsLocallyNoetherian P] (g : Y ⟶ P) [LocallyOfFiniteType g] [QuasiCompact g] (σ : P ⟶ Y), σ ≫ g = 𝟙 P → (∀ p : P, ∃ V : Y.Opens, σ p ∈ V ∧ SmoothOfRelativeDimension 1 (V.ι ≫ g)) → GeometricallyIrreducible (Limits.pullback.snd g (P.fromSpecStalk (genericPoint P))) ∧ GeometricallyReduced (Limits.pullback.snd g (P.fromSpecStalk (genericPoint P))) :=
by





  have s11 : ∀ (Γ Q : Scheme.{u}) [AlgebraicGeometry.IsIntegral Γ] [AlgebraicGeometry.IsIntegral Q] (g : Γ ⟶ Q) (h : g (genericPoint Γ) ⤳ genericPoint Q), (letI : Algebra (Q.presheaf.stalk (genericPoint Q)) (Γ.presheaf.stalk (genericPoint Γ)) := (Q.presheaf.stalkSpecializes h ≫ g.stalkMap (genericPoint Γ)).hom.toAlgebra; ∀ (Ω : Type u) [Field Ω] [Algebra (Q.presheaf.stalk (genericPoint Q)) Ω], IsDomain (TensorProduct (Q.presheaf.stalk (genericPoint Q)) (Γ.presheaf.stalk (genericPoint Γ)) Ω)) → GeometricallyIrreducible (Limits.pullback.snd g (Q.fromSpecStalk (genericPoint Q))) ∧ GeometricallyReduced (Limits.pullback.snd g (Q.fromSpecStalk (genericPoint Q))) := by
    intro Γ Q _ _ g h hdom
    have S1 : ∀ {Γ Q T : Scheme.{u}} (g : Γ ⟶ Q) (ι : T ⟶ Q), (∀ (Ω : Type u) [Field Ω] (y : Spec (.of Ω) ⟶ T) (Z : Scheme.{u}) (p : Z ⟶ Γ) (q : Z ⟶ Spec (.of Ω)), IsPullback p q g (y ≫ ι) → AlgebraicGeometry.IsIntegral Z) → GeometricallyIrreducible (Limits.pullback.snd g ι) ∧ GeometricallyReduced (Limits.pullback.snd g ι) := by
      intro Γ Q T g ι H
      refine ⟨⟨fun K _ y Z fst snd hpb => ?_⟩, ⟨fun K _ y Z fst snd hpb => ?_⟩⟩
      · haveI := H K y Z (fst ≫ Limits.pullback.fst g ι) snd
          (hpb.paste_horiz (IsPullback.of_hasPullback g ι))
        infer_instance
      · haveI := H K y Z (fst ≫ Limits.pullback.fst g ι) snd
          (hpb.paste_horiz (IsPullback.of_hasPullback g ι))
        infer_instance
    have S2 : ∀ (A B F K Ω : Type u) [CommRing A] [CommRing B] [Field F] [Field K] [Field Ω] (α : A →+* B) (β : A →+* F) (φ : F →+* K) (γ : B →+* K) (ω : F →+* Ω), (letI := β.toAlgebra; IsFractionRing A F) → Function.Injective γ → γ.comp α = φ.comp β → (letI := φ.toAlgebra; letI := ω.toAlgebra; IsDomain (TensorProduct F K Ω)) → id (letI := α.toAlgebra; letI := (ω.comp β).toAlgebra; IsDomain (TensorProduct A B Ω)) := by
      intro A B F K Ω _ _ _ _ _ α β φ γ ω hfrac hγ hsq hdom
      letI : Algebra A B := α.toAlgebra
      letI : Algebra A F := β.toAlgebra
      letI : Algebra F K := φ.toAlgebra
      letI : Algebra F Ω := ω.toAlgebra
      letI : Algebra A Ω := (ω.comp β).toAlgebra
      letI : Algebra A K := (φ.comp β).toAlgebra
      haveI : IsScalarTower A F Ω := IsScalarTower.of_algebraMap_eq' rfl
      haveI : IsScalarTower A F K := IsScalarTower.of_algebraMap_eq' rfl
      haveI : IsFractionRing A F := hfrac
      haveI : IsDomain (TensorProduct F K Ω) := hdom
      letI : Algebra B (TensorProduct A F B) := Algebra.TensorProduct.rightAlgebra
      haveI hloc : IsLocalization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))
          (TensorProduct A F B) :=
        IsLocalization.tensorRight F (nonZeroDivisors A)
      have hcomm : ∀ a : A, γ (algebraMap A B a) = algebraMap A K a := fun a =>
        congrArg (fun f : A →+* K => f a) hsq
      let γA : B →ₐ[A] K := AlgHom.mk γ hcomm
      let lam : TensorProduct A F B →ₐ[F] K :=
        Algebra.TensorProduct.lift (Algebra.ofId F K) γA (fun _ _ => Commute.all _ _)
      have hlam : Function.Injective lam := by
        have := IsLocalization.injective_of_map_algebraMap_zero
