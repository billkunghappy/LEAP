  have s7 : ∀ (K : Type u) [CommRing K] (m : ℕ), (⨆ a : Fin (m + 1), @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) MvPolynomial.gradedAlgebra (MvPolynomial.X a)) = ⊤ := by
    intro K _ m
