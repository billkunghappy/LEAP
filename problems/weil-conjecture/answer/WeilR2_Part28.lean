  haveI := he
  haveI := hι
  obtain ⟨N', σ, hσ, hσeq⟩ := wcpa_dj_ms_bfp_ring_segre ↥W N m
  haveI := hσ
  have hjg : uX ≫ 𝟙 _ = j ≫ (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W 0)))) := by rw [Category.comp_id, hjeq]
  have hh : (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) ↥W) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) ↥W 0)))) ≫ 𝟙 _ = 𝟙 _ ≫ (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) ↥W) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) ↥W 0)))) := by simp
  haveI hμ : IsClosedImmersion (Limits.pullback.map uX (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) ↥W) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) ↥W 0)))) (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W 0)))) (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) ↥W) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) ↥W 0)))) j (𝟙 _) (𝟙 _) hjg hh) :=
