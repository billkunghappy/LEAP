  obtain ⟨hchar, htw, hfrobx⟩ := wcpa_dj_sgs_gc_twist_function_field k Γ Q sQ g m Φ hΦfrob hΦs
    R r hrci hrs Xt b hbs hbU h₁ h₂ h₃
  letI := Fintype.ofFinite k
