        (Proj 𝒜).presheaf.map (homOfLE h₁).op
            (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 h hh1)) =
          (Proj 𝒜).presheaf.map (homOfLE h₁).op
            (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg1)) *
          (Proj 𝒜).presheaf.map (homOfLE h₂).op
            (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 1 h hh1)) := by
      rintro W rfl h₁ h₂
      have e1 : ∀ a, (Proj 𝒜).presheaf.map (homOfLE h₁).op (Proj.awayToSection 𝒜 f a) =
          Proj.awayToSection 𝒜 (f * g) (HomogeneousLocalization.awayMap 𝒜 hg rfl a) := by
        intro a
        have := ConcreteCategory.congr_hom
          (Proj.awayMap_awayToSection 𝒜 hg (rfl : f * g = f * g)) a
        exact this.symm
      have e2 : ∀ b, (Proj 𝒜).presheaf.map (homOfLE h₂).op (Proj.awayToSection 𝒜 g b) =
          Proj.awayToSection 𝒜 (f * g) (HomogeneousLocalization.awayMap 𝒜 hf (mul_comm f g) b) := by
        intro b
        have := ConcreteCategory.congr_hom
          (Proj.awayMap_awayToSection 𝒜 (f := g) hf (mul_comm f g)) b
        exact this.symm
      rw [e1, e1, e2, ← map_mul]
      congr 1
      rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
        HomogeneousLocalization.awayMap_mk]
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
        HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
        Localization.mk_mul, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      refine ⟨1, ?_⟩
      simp only [Submonoid.coe_mul, pow_one, OneMemClass.coe_one, one_mul]
      ring
    exact key _ (Proj.basicOpen_mul 𝒜 f g).symm _ _
  intro k _ N n D Y j Θ hΘ hj hD hcov
  classical
  haveI := hj
  letI gN : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) := MvPolynomial.gradedAlgebra

  have PR : ∀ (V₁ V₂ : (wcProjK k N).Opens) (a b : Γ(wcProjK k N, V₁)) (c : Γ(wcProjK k N, V₂)),
      (wcProjK k N).presheaf.map (homOfLE (inf_le_left : V₁ ⊓ V₂ ≤ V₁)).op a =
        (wcProjK k N).presheaf.map (homOfLE (inf_le_left : V₁ ⊓ V₂ ≤ V₁)).op b *
        (wcProjK k N).presheaf.map (homOfLE (inf_le_right : V₁ ⊓ V₂ ≤ V₂)).op c →
      Y.presheaf.map (homOfLE (inf_le_right : j ⁻¹ᵁ V₂ ⊓ j ⁻¹ᵁ V₁ ≤ j ⁻¹ᵁ V₁)).op (j.app V₁ a) =
        Y.presheaf.map (homOfLE (inf_le_right : j ⁻¹ᵁ V₂ ⊓ j ⁻¹ᵁ V₁ ≤ j ⁻¹ᵁ V₁)).op (j.app V₁ b) *
        Y.presheaf.map (homOfLE (inf_le_left : j ⁻¹ᵁ V₂ ⊓ j ⁻¹ᵁ V₁ ≤ j ⁻¹ᵁ V₂)).op (j.app V₂ c) := by
    intro V₁ V₂ a b c h
    have e : j ⁻¹ᵁ V₂ ⊓ j ⁻¹ᵁ V₁ ≤ j ⁻¹ᵁ (V₁ ⊓ V₂) := by
      rw [Scheme.Hom.preimage_inf]
      exact le_of_eq (inf_comm _ _)
    have key : ∀ (V : (wcProjK k N).Opens) (hV : V₁ ⊓ V₂ ≤ V)
        (hV' : j ⁻¹ᵁ V₂ ⊓ j ⁻¹ᵁ V₁ ≤ j ⁻¹ᵁ V) (x : Γ(wcProjK k N, V)),
