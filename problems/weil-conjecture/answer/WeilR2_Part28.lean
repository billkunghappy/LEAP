  haveI := hbs
  have hle : e₀ ≤ (n : ℕ) * m := le_trans hm (Nat.le_mul_of_pos_left m n.pos)

  obtain ⟨U, hU0, hbUiso⟩ := hbU
  let C : TopologicalSpace.Closeds R := ⟨(U : Set R)ᶜ, U.isOpen.isClosed_compl⟩
  have hrange : Set.range (Scheme.IdealSheafData.vanishingIdeal C).subschemeι = (U : Set R)ᶜ := by
    rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.coe_support_vanishingIdeal]
    rfl
  have hUne : (U : Set R).Nonempty := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).mp hU0
  have hηR : genericPoint R ∈ (U : Set R) := by
    obtain ⟨u, hu⟩ := hUne
    exact (IsGenericPoint.mem_open_set_iff (genericPoint_spec R) U.isOpen).mpr ⟨u, trivial, hu⟩
  have hηXt : b (genericPoint Xt) ∈ (U : Set R) := by
    obtain ⟨u, hu⟩ := hUne
    obtain ⟨x, hx⟩ := b.surjective u
    have hx' : x ∈ b ⁻¹ᵁ U := (Scheme.Hom.mem_preimage b).mpr (by rw [hx]; exact hu)
    have h1 : genericPoint Xt ∈ ((b ⁻¹ᵁ U : Xt.Opens) : Set Xt) :=
      (IsGenericPoint.mem_open_set_iff (genericPoint_spec Xt) (b ⁻¹ᵁ U).isOpen).mpr
        ⟨x, trivial, hx'⟩
    exact (Scheme.Hom.mem_preimage b).mp h1
  have hiso : ∀ U' : R.Opens,
      (U' : Set R) = (Set.range (Scheme.IdealSheafData.vanishingIdeal C).subschemeι)ᶜ →
      IsIso (b ∣_ U') := by
    intro U' hU'
