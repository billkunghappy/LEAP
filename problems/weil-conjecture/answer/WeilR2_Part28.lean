      MvPolynomial.X 0 := by
    rw [hFX, hνj, map_one, one_mul]
  have hu : wcBlF K n ⟨{j}, Finset.singleton_nonempty j⟩ (MvPolynomial.X i) ∈
      MvPolynomial.homogeneousSubmodule (Fin 2) (wcBlB K n {j}) 1 :=
    (wcBlF K n ⟨{j}, Finset.singleton_nonempty j⟩).map_mem hXi
  have hg : ∀ (l : Fin (n + 1 + 1)) (p : Fin 2),
      wcBlF K n ⟨{j}, Finset.singleton_nonempty j⟩ (MvPolynomial.X l) = MvPolynomial.X p →
      HomogeneousLocalization.val (HomogeneousLocalization.Away.map
        (wcBlF K n ⟨{j}, Finset.singleton_nonempty j⟩) (MvPolynomial.X i)
        (HomogeneousLocalization.Away.mk _ hXi 1 (MvPolynomial.X l) (hXl l))) *
        algebraMap (MvPolynomial (Fin 2) (wcBlB K n {j}))
          (Localization.Away (wcBlF K n ⟨{j}, Finset.singleton_nonempty j⟩ (MvPolynomial.X i)))
          (wcBlF K n ⟨{j}, Finset.singleton_nonempty j⟩ (MvPolynomial.X i)) =
        algebraMap (MvPolynomial (Fin 2) (wcBlB K n {j}))
          (Localization.Away (wcBlF K n ⟨{j}, Finset.singleton_nonempty j⟩ (MvPolynomial.X i)))
          (MvPolynomial.X p) := by
    intro l p hl
    rw [HomogeneousLocalization.Away.map_mk, ← hl]
    have e := hvm _ _ 1 ((wcBlF K n ⟨{j}, Finset.singleton_nonempty j⟩).map_mem hXi) 1 _
      ((wcBlF K n ⟨{j}, Finset.singleton_nonempty j⟩).map_mem (hXl l))
