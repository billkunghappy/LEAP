  haveI : IsProper ((b ≫ r ≫ Limits.pullback.snd g Φ) ≫ sQ) := inferInstance
  have hΓne : (⊤ : Γ.Opens) ≠ ⊥ := by
    obtain ⟨x⟩ := (inferInstance : Nonempty Γ)
    exact (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mpr ⟨x, trivial⟩
  have hXtd : topologicalKrullDim Xt = ((d + 1 : ℕ) : WithBot ℕ∞) := by
    rw [wcpa_dj_alteration_dim_eq k Xt Γ ((b ≫ r ≫ Limits.pullback.snd g Φ) ≫ sQ) (g ≫ sQ)
      (b ≫ r ≫ Limits.pullback.fst g Φ) heqρ inferInstance ⟨⊤, hΓne, inferInstance⟩, hΓd]
  have hρη : (b ≫ r ≫ Limits.pullback.fst g Φ) (genericPoint Xt) = genericPoint Γ := by
    obtain ⟨x₀, hx₀⟩ := (b ≫ r ≫ Limits.pullback.fst g Φ).surjective (genericPoint Γ)
    have h := (genericPoint_specializes x₀).map (b ≫ r ≫ Limits.pullback.fst g Φ).continuous
    rw [hx₀] at h
    exact (h.antisymm (genericPoint_specializes _)).eq
  have hfη : (b ≫ r ≫ Limits.pullback.snd g Φ) (genericPoint Xt) = genericPoint Q := by
    have hc : (Limits.pullback.fst g Φ ≫ g) (r (b (genericPoint Xt))) =
        (Limits.pullback.snd g Φ ≫ Φ) (r (b (genericPoint Xt))) := by
      rw [Limits.pullback.condition]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hΦfrob.1] at hc
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, ← hc]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at hρη
    rw [hρη, hdom]

  have hsm1 : SmoothOfRelativeDimension 1 ((b ≫ r ≫ Limits.pullback.snd g Φ) ∣_ W) :=
    wcpa_dj_sgs_reldim_one k Xt Q sQ (b ≫ r ≫ Limits.pullback.snd g Φ) d hQd hXtd hfη W hWsm
  have hbc : ∀ {X : Scheme.{u}} (p : X ⟶ Q) (W : Q.Opens) (s : Q) (hs : s ∈ W),
      SmoothOfRelativeDimension 1 (p ∣_ W) →
      SmoothOfRelativeDimension 1 (Limits.pullback.snd p (Q.fromSpecStalk s)) := by
    intro X p W s hs h
    have hR := (isPullback_morphismRestrict p W).flip
    have hw : Limits.pullback.fst p (Q.fromSpecStalk s) ≫ p =
        (Limits.pullback.snd p (Q.fromSpecStalk s) ≫ W.fromSpecStalkOfMem s hs) ≫ W.ι := by
      rw [Category.assoc, Scheme.Opens.fromSpecStalkOfMem_ι, Limits.pullback.condition]
    have hout : IsPullback (hR.lift _ _ hw ≫ (p ⁻¹ᵁ W).ι)
        (Limits.pullback.snd p (Q.fromSpecStalk s)) p (W.fromSpecStalkOfMem s hs ≫ W.ι) := by
      rw [hR.lift_fst, Scheme.Opens.fromSpecStalkOfMem_ι]
      exact IsPullback.of_hasPullback _ _
    have hL := IsPullback.of_right hout (hR.lift_snd _ _ hw) hR
    exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hL h
  have hconj1 := hbc (b ≫ r ≫ Limits.pullback.snd g Φ) W (genericPoint Q) hηT hsm1

  exact ⟨hconj1, wcpa_dj_sgs_geom_connected k Γ Q sQ g m Φ hΦfrob hΦs hGI hGR R r hrci hrs Xt b
    hbfin hbs ⟨U, hU0, hbUiso⟩ hfp hconj1⟩

theorem wcpa_dj_sgf_chow_birational : ∀ (k : Type u) [Field k] (X : Scheme.{u})
    [AlgebraicGeometry.IsIntegral X] (sX : X ⟶ Spec (.of k)) [IsProper sX],
    ∃ (X' : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral X') (α₀ : X' ⟶ X),
      wcpaDjIsProjOver k (α₀ ≫ sX) ∧ IsProper α₀ ∧ Surjective α₀ ∧
      ∃ V : X.Opens, V ≠ ⊥ ∧ IsIso (α₀ ∣_ V) :=
by
  intro K _ Y _ f _

  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace f
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian f
  haveI : IsNoetherian Y := ⟨⟩
  obtain ⟨r, U, hUaff, hUcov, hUdense⟩ := wc_chow_dense_affine_charts Y
  let W : Y.Opens := ⨅ i, U i
  have hWcoe : (W : Set Y) = ⋂ i, (U i : Set Y) := TopologicalSpace.Opens.coe_iInf U
  have hWdense : Dense (W : Set Y) := by rw [hWcoe]; exact hUdense
  have hWU : ∀ i, W ≤ U i := fun i => iInf_le U i
  have hgen := fun i => wc_chow_affine_generators K Y f (U i) (hUaff i)
  choose n a ha0 hagen using hgen
  have hcard : 0 < Fintype.card (∀ i, Fin (n i + 1)) := Fintype.card_pos
  let N : ℕ := Fintype.card (∀ i, Fin (n i + 1)) - 1
  let κ : Fin (N + 1) ≃ (∀ i, Fin (n i + 1)) :=
    (Fintype.equivFinOfCardEq (by omega : Fintype.card (∀ i, Fin (n i + 1)) = N + 1)).symm
  obtain ⟨C, e, hCcov, hCaff, hCbo, UP⟩ := wc_projK_coords K N
  have hψU : ∀ i, W.ι ⁻¹ᵁ U i = ⊤ := by
    intro i
    apply top_le_iff.mp
    intro x _
    show W.ι x ∈ (U i : Set Y)
    have hx : W.ι x ∈ Set.range W.ι := ⟨x, rfl⟩
    rw [Scheme.Opens.range_ι] at hx
    exact hWU i hx
  let s : Fin (N + 1) → Γ((W : Scheme.{u}), ⊤) :=
    fun L => ∏ i, W.ι.appLE (U i) ⊤ (hψU i).ge (a i (κ L i))
  have hs1 : s (κ.symm 0) = 1 := by
    simp only [s, Equiv.apply_symm_apply, Pi.zero_apply, ha0, map_one, Finset.prod_const_one]
  have hspan : Ideal.span (Set.range s) = ⊤ := by
    rw [Ideal.eq_top_iff_one]
    exact Ideal.subset_span ⟨κ.symm 0, hs1⟩
  obtain ⟨φ, hφstr, hφC, hrel⟩ := UP (W : Scheme.{u}) (W.ι ≫ f) s hspan
  haveI := wc_proj_space_isProper K N
  let γ : (W : Scheme.{u}) ⟶ Limits.pullback f (wcProjKStr K N) :=
    Limits.pullback.lift W.ι φ hφstr.symm
  haveI : CompactSpace (W : Scheme.{u}) :=
    isCompact_iff_compactSpace.mp (TopologicalSpace.NoetherianSpace.isCompact (W : Set Y))
  haveI : IsNoetherian (W : Scheme.{u}) := ⟨⟩
  haveI : QuasiCompact γ := inferInstance
  let ιQ := γ.imageι
  let δ := γ.toImage
  have hδι : δ ≫ ιQ = γ := Scheme.Hom.toImage_imageι γ
  let π : γ.image ⟶ Y := ιQ ≫ Limits.pullback.fst f (wcProjKStr K N)
  let g : γ.image ⟶ wcProjK K N := ιQ ≫ Limits.pullback.snd f (wcProjKStr K N)
  have hδπ : δ ≫ π = W.ι := by
    show δ ≫ ιQ ≫ Limits.pullback.fst f (wcProjKStr K N) = W.ι
    rw [← Category.assoc, hδι]
    exact Limits.pullback.lift_fst _ _ _
  have hδg : δ ≫ g = φ := by
    show δ ≫ ιQ ≫ Limits.pullback.snd f (wcProjKStr K N) = φ
    rw [← Category.assoc, hδι]
    exact Limits.pullback.lift_snd _ _ _
  obtain ⟨hinj, hdense⟩ := wc_toImage_injective_dense _ _ γ
  haveI hπprop : IsProper π := by
    show IsProper (ιQ ≫ Limits.pullback.fst f (wcProjKStr K N))
    infer_instance
  have hiso : IsIso (π ∣_ W) := wc_isIso_restrict_of_section _ Y π W δ hinj hδπ
  have hgf : π ≫ f = g ≫ wcProjKStr K N := by
    show (ιQ ≫ Limits.pullback.fst f (wcProjKStr K N)) ≫ f =
      (ιQ ≫ Limits.pullback.snd f (wcProjKStr K N)) ≫ wcProjKStr K N
    rw [Category.assoc, Category.assoc, Limits.pullback.condition]
  haveI hgprop : IsProper g := by
    show IsProper (ιQ ≫ Limits.pullback.snd f (wcProjKStr K N))
    infer_instance
  have hrange : IsClosed (Set.range g) := g.isClosedMap.isClosed_range
  have hπcov : ∀ z : γ.image, ∃ i, π z ∈ U i := by
    intro z
    have hz : π z ∈ (⊤ : Y.Opens) := trivial
    rw [← hUcov] at hz
    exact TopologicalSpace.Opens.mem_iSup.mp hz
  have hcov := wc_chow_charts_cover_K Y γ.image (W : Scheme.{u}) (wcProjK K N) π g δ W.ι φ r U n a
    N κ C e s hψU hinj hδπ hδg ha0 (fun L => rfl) hφC hrel hCcov hCbo hπcov
  have hchart : ∀ J ∈ {J : Fin (N + 1) | ∃ i, κ J i = 0}, IsClosedImmersion (g ∣_ C J) := by
    rintro J ⟨i, hi⟩
    obtain ⟨hGaff, hGgen⟩ := wc_closed_in_product_chart_gen (Spec (.of K)) Y (wcProjK K N)
      γ.image f (wcProjKStr K N) ιQ (U i) (C J) (hUaff i) (hCaff J)
    have hkey := wc_chow_key_identity Y γ.image (W : Scheme.{u}) (wcProjK K N) π g δ W.ι φ r U n a
      N κ C e s hψU hinj hδπ hδg ha0 (fun L => rfl) hφC hrel i J hi
    have hsurj := wc_chart_sections_from_target K Y γ.image (wcProjK K N) f (wcProjKStr K N) π g
      (U i) (C J) (n i) (a i) (fun k => e J (κ.symm (Function.update (κ J) i k))) hgf hGgen
      (hagen i) hkey
    have hpre : (δ ≫ π) ⁻¹ᵁ U i = ⊤ := by rw [hδπ]; exact hψU i
    exact wc_chart_closed_immersion_of_surj Y γ.image (W : Scheme.{u}) (wcProjK K N) π g δ (U i)
      (C J) hdense hpre (hCaff J) hGaff hsurj
  haveI hgci : IsClosedImmersion g :=
    wc_closed_immersion_of_chart_cover γ.image (wcProjK K N) g N C _ hrange hcov hchart
  haveI := hiso

  haveI hYne : Nonempty Y := IsIntegral.nonempty
  have hW0 : W ≠ ⊥ := by
    rw [TopologicalSpace.Opens.ne_bot_iff_nonempty]
    exact hWdense.nonempty

  haveI hWne : Nonempty (W : Scheme.{u}) := by
    obtain ⟨x, hx⟩ := hWdense.nonempty
    have hx' : x ∈ Set.range W.ι := by rw [Scheme.Opens.range_ι]; exact hx
    obtain ⟨w, _⟩ := hx'
    exact ⟨w⟩
  haveI hWirr : IrreducibleSpace (W : Scheme.{u}) :=
    Topology.IsOpenEmbedding.irreducibleSpace W.ι.isOpenEmbedding
  haveI hY'irr : IrreducibleSpace γ.image := by
    rw [irreducibleSpace_def]
    have h1 : IsIrreducible (Set.range δ) := by
      rw [← Set.image_univ]
      exact (IrreducibleSpace.isIrreducible_univ _).image _ δ.continuous.continuousOn
    have h2 := h1.closure
    rw [hdense.closure_range] at h2
    exact h2

  haveI hπs : Surjective π := by
    refine ⟨?_⟩
    have hcl : IsClosed (Set.range π) := π.isClosedMap.isClosed_range
    have hsub : (W : Set Y) ⊆ Set.range π := by
      intro x hx
      have hx' : x ∈ Set.range W.ι := by rw [Scheme.Opens.range_ι]; exact hx
      obtain ⟨w, rfl⟩ := hx'
      exact ⟨δ w, by rw [← Scheme.Hom.comp_apply, hδπ]⟩
    rw [← Set.range_eq_univ]
    apply Set.eq_univ_of_univ_subset
    rw [← hWdense.closure_eq]
    exact closure_minimal hsub hcl

  let J : γ.image.IdealSheafData := (⊥ : γ.image.IdealSheafData).radical
  have h2 : Set.range J.subschemeι = Set.univ := by
    rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.support_radical,
      Scheme.IdealSheafData.support_bot, TopologicalSpace.Closeds.coe_top]
  have hring : ∀ V : γ.image.affineOpens, _root_.IsReduced (Γ(γ.image, V) ⧸ J.ideal V) := fun V =>
    (Ideal.isRadical_iff_quotient_reduced _).mp
      (by
        show ((⊥ : γ.image.IdealSheafData).radical.ideal V).IsRadical
        rw [Scheme.IdealSheafData.radical_ideal]
        exact Ideal.radical_isRadical _)
  have hpieces : ∀ i, IsReduced (J.subschemeCover.openCover.X i) :=
    fun (V : γ.image.affineOpens) => by
      haveI := hring V
      exact (inferInstance :
        IsReduced (Spec (CommRingCat.of (Γ(γ.image, (V : γ.image.Opens)) ⧸ J.ideal V))))
  haveI hRred : IsReduced J.subscheme := IsReduced.of_openCover _ J.subschemeCover.openCover
  have hrs : Function.Surjective J.subschemeι := Set.range_eq_univ.mp h2
  haveI hrsurj : Surjective J.subschemeι := ⟨hrs⟩
  haveI hRne : Nonempty J.subscheme := by
    obtain ⟨y⟩ := (inferInstance : Nonempty γ.image)
    obtain ⟨z, _⟩ := hrs y
    exact ⟨z⟩
  haveI hRirr : IrreducibleSpace J.subscheme :=
    Topology.IsOpenEmbedding.irreducibleSpace
      (J.subschemeι.isClosedEmbedding.isEmbedding.isOpenEmbedding_of_surjective hrs)
  haveI hRint : AlgebraicGeometry.IsIntegral J.subscheme :=
    isIntegral_of_irreducibleSpace_of_isReduced J.subscheme

  refine ⟨J.subscheme, hRint, J.subschemeι ≫ π, ?_, inferInstance, inferInstance, W, hW0, ?_⟩
  · refine ⟨N, J.subschemeι ≫ g, inferInstance, ?_⟩
    show (J.subschemeι ≫ g) ≫ wcProjKStr K N = (J.subschemeι ≫ π) ≫ f
    simp only [Category.assoc, hgf]
  ·
    haveI hpred : IsReduced (π ⁻¹ᵁ W : Scheme.{u}) := isReduced_of_isOpenImmersion (π ∣_ W)
    haveI hrW : Surjective (J.subschemeι ∣_ (π ⁻¹ᵁ W)) :=
      IsZariskiLocalAtTarget.restrict hrsurj (π ⁻¹ᵁ W)
    haveI hci : IsClosedImmersion (J.subschemeι ∣_ (π ⁻¹ᵁ W)) := inferInstance
    haveI h1 : IsIso (J.subschemeι ∣_ (π ⁻¹ᵁ W)) := isIso_of_isClosedImmersion_of_surjective _
    rw [morphismRestrict_comp]
    exact @IsIso.comp_isIso _ _ _ _ _ _ _ h1 hiso

theorem wcpa_dj_sgt_dominant_of_fibre_nonempty : ∀ (X P : Scheme.{u}) [AlgebraicGeometry.IsIntegral X]
    [AlgebraicGeometry.IsIntegral P] (f : X ⟶ P),
    Nonempty ↥(Limits.pullback f (P.fromSpecStalk (genericPoint P))) →
    f (genericPoint X) = genericPoint P ∧
      ∃ z : ↥(Limits.pullback f (P.fromSpecStalk (genericPoint P))),
        Limits.pullback.fst f (P.fromSpecStalk (genericPoint P)) z = genericPoint X :=
by
  intro X P _ _ f hne
  obtain ⟨w⟩ := hne
  have h2 : f (Limits.pullback.fst f (P.fromSpecStalk (genericPoint P)) w) =
      P.fromSpecStalk (genericPoint P)
        (Limits.pullback.snd f (P.fromSpecStalk (genericPoint P)) w) := by
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
  have h3 : f (Limits.pullback.fst f (P.fromSpecStalk (genericPoint P)) w) ⤳ genericPoint P := by
    have hmem : P.fromSpecStalk (genericPoint P)
        (Limits.pullback.snd f (P.fromSpecStalk (genericPoint P)) w) ∈
        Set.range ⇑(P.fromSpecStalk (genericPoint P)) := ⟨_, rfl⟩
    rw [Scheme.range_fromSpecStalk] at hmem
    rw [h2]
    exact hmem
  have h4 : f (genericPoint X) ⤳ genericPoint P :=
    ((genericPoint_specializes
      (Limits.pullback.fst f (P.fromSpecStalk (genericPoint P)) w)).map
        f.continuous).trans h3
  have h5 : f (genericPoint X) = genericPoint P :=
    (h4.antisymm (genericPoint_specializes _)).eq
  refine ⟨h5, ?_⟩
  obtain ⟨z, hz, -⟩ := Scheme.Pullback.exists_preimage_pullback
    (f := f) (g := P.fromSpecStalk (genericPoint P)) (genericPoint X)
    (IsLocalRing.closedPoint (P.presheaf.stalk (genericPoint P)))
    (h5.trans (Scheme.fromSpecStalk_closedPoint).symm)
  exact ⟨z, hz⟩

theorem wcpa_dj_sgt_generic_fibre_integral : ∀ (X P : Scheme.{u}) [AlgebraicGeometry.IsIntegral X]
    [AlgebraicGeometry.IsIntegral P] (f : X ⟶ P),
    Nonempty ↥(Limits.pullback f (P.fromSpecStalk (genericPoint P))) →
    AlgebraicGeometry.IsIntegral (Limits.pullback f (P.fromSpecStalk (genericPoint P))) :=
by
  intro X P _ _ f hne
  have hflatι : ∀ (Y : Scheme.{u}) (y : Y), Flat (Y.fromSpecStalk y) := by
    intro Y y
    obtain ⟨U, hU, hy, -⟩ := exists_isAffineOpen_mem_and_subset (X := Y) (U := ⊤) (Set.mem_univ y)
    rw [← hU.fromSpecStalk_eq_fromSpecStalk hy]
    have hg : Flat (Spec.map (Y.presheaf.germ U y hy)) := by
      letI := TopCat.Presheaf.algebra_section_stalk Y.presheaf ⟨y, hy⟩
      haveI := hU.isLocalization_stalk ⟨y, hy⟩
      have h1 : Module.Flat Γ(Y, U) (Y.presheaf.stalk y) :=
        IsLocalization.flat _ (hU.primeIdealOf ⟨y, hy⟩).asIdeal.primeCompl
      have h2 : (algebraMap Γ(Y, U) (Y.presheaf.stalk y)).Flat := RingHom.flat_algebraMap_iff.mpr h1
      exact (HasRingHomProperty.Spec_iff (P := @Flat)).mpr h2
    haveI := hU.isOpenImmersion_fromSpec
    show Flat (Spec.map (Y.presheaf.germ U y hy) ≫ hU.fromSpec)
    infer_instance
  haveI : Flat (P.fromSpecStalk (genericPoint P)) := hflatι P _
  haveI : Flat (Limits.pullback.fst f (P.fromSpecStalk (genericPoint P))) := inferInstance
  haveI : IsPreimmersion (Limits.pullback.fst f (P.fromSpecStalk (genericPoint P))) := inferInstance
  have hred : ∀ z : ↥(Limits.pullback f (P.fromSpecStalk (genericPoint P))),
      _root_.IsReduced ((Limits.pullback f (P.fromSpecStalk (genericPoint P))).presheaf.stalk z) := by
    intro z
    have hsurj : Function.Surjective
        ((Limits.pullback.fst f (P.fromSpecStalk (genericPoint P))).stalkMap z).hom :=
      (Limits.pullback.fst f (P.fromSpecStalk (genericPoint P))).stalkMap_surjective z
    letI := ((Limits.pullback.fst f (P.fromSpecStalk (genericPoint P))).stalkMap z).hom.toAlgebra
    haveI : Module.Flat (X.presheaf.stalk ((Limits.pullback.fst f (P.fromSpecStalk (genericPoint P))) z))
        ((Limits.pullback f (P.fromSpecStalk (genericPoint P))).presheaf.stalk z) :=
      RingHom.flat_algebraMap_iff.mp (Flat.stalkMap (Limits.pullback.fst f (P.fromSpecStalk (genericPoint P))) z)
    haveI : IsLocalHom (algebraMap
        (X.presheaf.stalk ((Limits.pullback.fst f (P.fromSpecStalk (genericPoint P))) z))
        ((Limits.pullback f (P.fromSpecStalk (genericPoint P))).presheaf.stalk z)) :=
      inferInstanceAs (IsLocalHom ((Limits.pullback.fst f (P.fromSpecStalk (genericPoint P))).stalkMap z).hom)
    haveI : Module.FaithfullyFlat
        (X.presheaf.stalk ((Limits.pullback.fst f (P.fromSpecStalk (genericPoint P))) z))
        ((Limits.pullback f (P.fromSpecStalk (genericPoint P))).presheaf.stalk z) :=
      Module.FaithfullyFlat.of_flat_of_isLocalHom
    have hinj : Function.Injective
        ((Limits.pullback.fst f (P.fromSpecStalk (genericPoint P))).stalkMap z).hom :=
      FaithfulSMul.algebraMap_injective
        (X.presheaf.stalk ((Limits.pullback.fst f (P.fromSpecStalk (genericPoint P))) z))
        ((Limits.pullback f (P.fromSpecStalk (genericPoint P))).presheaf.stalk z)
    let e := RingEquiv.ofBijective _ ⟨hinj, hsurj⟩
    exact isReduced_of_injective e.symm e.symm.injective
  haveI : IsReduced (Limits.pullback f (P.fromSpecStalk (genericPoint P))) :=
    isReduced_of_isReduced_stalk _
  have hrange : ∀ x : X, x ∈ Set.range (Limits.pullback.fst f (P.fromSpecStalk (genericPoint P))) ↔
      f x ⤳ genericPoint P := by
    intro x
    rw [Scheme.Pullback.range_fst, Set.mem_preimage, Scheme.range_fromSpecStalk]
    rfl
  obtain ⟨y₀⟩ := hne
  have hξ : genericPoint X ∈ Set.range (Limits.pullback.fst f (P.fromSpecStalk (genericPoint P))) := by
    rw [hrange]
    exact ((genericPoint_specializes _).map f.continuous).trans ((hrange _).mp ⟨y₀, rfl⟩)
  obtain ⟨z₀, hz₀⟩ := hξ
  have hall : ∀ z, z₀ ⤳ z := by
    intro z
    rw [← (Limits.pullback.fst f (P.fromSpecStalk (genericPoint P))).isEmbedding.isInducing.specializes_iff,
      hz₀]
    exact genericPoint_specializes _
  haveI : IrreducibleSpace ↥(Limits.pullback f (P.fromSpecStalk (genericPoint P))) := by
    rw [irreducibleSpace_def]
    have hcl : closure ({z₀} : Set _) = Set.univ :=
      Set.eq_univ_of_forall (fun z => specializes_iff_mem_closure.mp (hall z))
    have h := (isIrreducible_singleton (x := z₀)).closure
    rw [hcl] at h
    exact h
  exact isIntegral_of_irreducibleSpace_of_isReduced _

theorem wcpa_dj_sgt_isIso_restrict_pullback : ∀ {X Y Z : Scheme.{u}} (α : X ⟶ Y) (g : Z ⟶ Y)
    (V : Y.Opens), IsIso (α ∣_ V) → IsIso ((Limits.pullback.snd α g) ∣_ (g ⁻¹ᵁ V)) :=
by
  intro X Y Z α g V hα
  have C := IsPullback.of_hasPullback α g
  have A := isPullback_morphismRestrict (Limits.pullback.snd α g) (g ⁻¹ᵁ V)
  have t := (isPullback_morphismRestrict α V).flip
  have s0 := A.flip.paste_horiz C
  have s : IsPullback ((Limits.pullback.snd α g ⁻¹ᵁ (g ⁻¹ᵁ V)).ι ≫ Limits.pullback.fst α g)
      ((Limits.pullback.snd α g) ∣_ (g ⁻¹ᵁ V)) α (g ∣_ V ≫ V.ι) := by
    rw [morphismRestrict_ι]; exact s0
  exact (IsPullback.of_right' s t).isIso_snd_of_isIso hα

theorem wcpa_dj_sgt_smooth_curve_stalk_valuation : ∀ (K : Type u) [Field K] (W : Scheme.{u})
    (s : W ⟶ Spec (.of K)) [SmoothOfRelativeDimension 1 s] (w : W)
    [IsDomain (W.presheaf.stalk w)], ValuationRing (W.presheaf.stalk w) :=
by

  have s8 : ∀ (S : Type u) [CommRing S] [IsLocalRing S] [IsNoetherianRing S] (t : S),
      IsLocalRing.maximalIdeal S = Ideal.span {t} → ∀ x y : S, x ∣ y ∨ y ∣ x := by
    intro S _ _ _ t ht
    have key : ∀ z : S, z ≠ 0 → ∃ (n : ℕ) (u : S), IsUnit u ∧ z = t ^ n * u := by
      intro z hz
      have hK := Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal S)
        (IsLocalRing.maximalIdeal.isMaximal S).ne_top
      have hex : ∃ n, z ∉ IsLocalRing.maximalIdeal S ^ n := by
        by_contra h
        push_neg at h
        apply hz
        have : z ∈ ⨅ i, IsLocalRing.maximalIdeal S ^ i := Ideal.mem_iInf.mpr h
        rw [hK] at this
        exact this
      classical
      have hn0 : z ∉ IsLocalRing.maximalIdeal S ^ (Nat.find hex) := Nat.find_spec hex
      have hpos : Nat.find hex ≠ 0 := by
        intro h0; apply hn0; rw [h0, pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top
      obtain ⟨n, hn⟩ : ∃ n, Nat.find hex = n + 1 := Nat.exists_eq_succ_of_ne_zero hpos
      have hzn : z ∈ IsLocalRing.maximalIdeal S ^ n := by
        have := Nat.find_min hex (show n < Nat.find hex by omega)
        push_neg at this; exact this
      rw [ht, Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at hzn
      obtain ⟨u, hu⟩ := hzn
      refine ⟨n, u, ?_, by rw [← hu, mul_comm]⟩
      by_contra hu'
      have hm : u ∈ IsLocalRing.maximalIdeal S := (IsLocalRing.mem_maximalIdeal u).mpr hu'
      rw [ht, Ideal.mem_span_singleton'] at hm
      obtain ⟨r, hr⟩ := hm
      apply hn0
      rw [hn, ht, Ideal.span_singleton_pow, Ideal.mem_span_singleton']
      exact ⟨r, by rw [← hu, ← hr]; ring⟩
    intro x y
    by_cases hx : x = 0
    · right; rw [hx]; exact dvd_zero y
    by_cases hy : y = 0
    · left; rw [hy]; exact dvd_zero x
    obtain ⟨n, u, hu, rfl⟩ := key x hx
    obtain ⟨m, v, hv, rfl⟩ := key y hy
    rcases le_total n m with h | h
    · left
      exact (hu.mul_right_dvd).mpr ((pow_dvd_pow t h).mul_right v)
    · right
      exact (hv.mul_right_dvd).mpr ((pow_dvd_pow t h).mul_right u)

  have s7 : ∀ (S : Type u) [CommRing S] [IsLocalRing S] [IsNoetherianRing S] (t : S),
      t ∈ IsLocalRing.maximalIdeal S →
      (∀ x ∈ IsLocalRing.maximalIdeal S, ∃ r : S, x - r * t ∈ IsLocalRing.maximalIdeal S ^ 2) →
      IsLocalRing.maximalIdeal S = Ideal.span {t} := by
    intro S _ _ _ t ht h
    apply le_antisymm
    · apply Submodule.le_of_le_smul_of_le_jacobson_bot (I := IsLocalRing.maximalIdeal S)
      · exact IsNoetherian.noetherian _
      · rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top]
      · intro x hx
        obtain ⟨r, hr⟩ := h x hx
        rw [pow_two, ← Ideal.smul_eq_mul] at hr
        have : x = r * t + (x - r * t) := by ring
        rw [this]
        exact Submodule.add_mem_sup (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self t)) hr
    · rw [Ideal.span_singleton_le_iff_mem]; exact ht

  have s2 : ∀ (K : Type u) [Field K] (A : Type u) [CommRing A] [Algebra K A] (p : Ideal A)
      [p.IsPrime], ∃ M : Ideal (TensorProduct K (AlgebraicClosure K) A), M.IsMaximal ∧ ∀ a ∈ p,
        (Algebra.TensorProduct.includeRight : A →ₐ[K] TensorProduct K (AlgebraicClosure K) A) a
          ∈ M := by
    intro K _ A _ _ p _
    let g : A →ₐ[K] A ⧸ p := Ideal.Quotient.mkₐ K p
    let f := Algebra.TensorProduct.map (AlgHom.id K (AlgebraicClosure K)) g
    haveI : Nontrivial (TensorProduct K (AlgebraicClosure K) (A ⧸ p)) := inferInstance
    obtain ⟨M, hM, hle⟩ :=
      Ideal.exists_le_maximal (RingHom.ker f.toRingHom) (RingHom.ker_ne_top _)
    refine ⟨M, hM, fun a ha => hle ?_⟩
    rw [RingHom.mem_ker]
    show f (1 ⊗ₜ a) = 0
    rw [Algebra.TensorProduct.map_tmul]
    have : g a = 0 := by
      simp only [g, Ideal.Quotient.mkₐ_eq_mk]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr ha
    rw [this, TensorProduct.tmul_zero]

  have s3 : ∀ (K : Type u) [Field K] (L : Type u) [Field L] [Algebra K L] (A : Type u)
      [CommRing A] [Algebra K A] (p : Ideal A) (M : Ideal (TensorProduct K L A)),
      (∀ a ∈ p, (Algebra.TensorProduct.includeRight : A →ₐ[K] TensorProduct K L A) a ∈ M) →
      ∀ (x y : A) (v w : TensorProduct K L A), v ∉ M →
        v * Algebra.TensorProduct.includeRight y = Algebra.TensorProduct.includeRight x * w →
        ∃ s a : A, s ∉ p ∧ s * y = x * a := by
    intro K _ L _ _ A _ _ p M hp x y v w hv hvw
    classical
    let b := Module.Free.chooseBasis K L
    let Φ := TensorProduct.equivFinsuppOfBasisLeft (N := A) b
    have hmul : ∀ (z : TensorProduct K L A) (a : A) j,
        Φ (z * Algebra.TensorProduct.includeRight a) j = Φ z j * a := by
      intro z a j
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul β a' =>
        simp [Φ, Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.tmul_mul_tmul,
          TensorProduct.equivFinsuppOfBasisLeft_apply_tmul]
      | add z₁ z₂ h₁ h₂ =>
        rw [add_mul, map_add, map_add, Finsupp.add_apply, Finsupp.add_apply, h₁, h₂, add_mul]
    have hrec : ∀ z : TensorProduct K L A,
        z = (Φ z).sum (fun j c => (b j ⊗ₜ (1 : A)) * Algebra.TensorProduct.includeRight c) := by
      intro z
      conv_lhs => rw [← Φ.symm_apply_apply z]
      rw [TensorProduct.equivFinsuppOfBasisLeft_symm_apply]
      simp [Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.tmul_mul_tmul]
    by_contra hcon
    push_neg at hcon
    apply hv
    rw [hrec v]
    apply Ideal.sum_mem
    intro j _
    apply Ideal.mul_mem_left
    apply hp
    by_contra hj
    apply hcon (Φ v j) (Φ w j) hj
    rw [mul_comm (Algebra.TensorProduct.includeRight x) w] at hvw
    have := congrArg (fun z => Φ z j) hvw
    simp only [hmul] at this
    rw [this, mul_comm]

  have s4 : ∀ (k : Type u) [Field k] (B : Type u) [CommRing B] [Algebra k B]
      [Algebra.IsStandardSmoothOfRelativeDimension 1 k B] (M : Ideal B) [M.IsPrime],
      ∃ ω : Ω[Localization.AtPrime M⁄k], Submodule.span (Localization.AtPrime M) {ω} = ⊤ := by
    intro k _ B _ _ _ M _
    haveI : Nontrivial B := ⟨⟨0, 1, fun h => (inferInstance : M.IsPrime).ne_top
      ((Ideal.eq_top_iff_one _).mpr (h ▸ M.zero_mem))⟩⟩
    haveI := Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth (n := 1) (R := k) (S := B)
    haveI := Algebra.IsStandardSmooth.free_kaehlerDifferential (R := k) (S := B)
    have hr :=
      Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential (R := k) (S := B) 1
    rw [Module.Free.rank_eq_card_chooseBasisIndex] at hr
    have hι : Subsingleton (Module.Free.ChooseBasisIndex B Ω[B⁄k]) ∧
        Nonempty (Module.Free.ChooseBasisIndex B Ω[B⁄k]) := by
      rw [← Cardinal.eq_one_iff_unique]; exact_mod_cast hr
    obtain ⟨hsub, ⟨i₀⟩⟩ := hι
    let bs := Module.Free.chooseBasis B Ω[B⁄k]
    have hspan : Submodule.span B {bs i₀} = ⊤ := by
      rw [← bs.span_eq]
      congr 1
      ext η
      simp only [Set.mem_singleton_iff, Set.mem_range]
      exact ⟨fun h => ⟨i₀, h.symm⟩, fun ⟨i, hi⟩ => by rw [← hi, Subsingleton.elim i i₀]⟩
    set S := Localization.AtPrime M
    set ω := KaehlerDifferential.map k k B S (bs i₀) with hω
    refine ⟨ω, ?_⟩
    set N := Submodule.span S {ω}
    have hB : ∀ a : B, KaehlerDifferential.D k S (algebraMap B S a) ∈ N := by
      intro a
      have ha : KaehlerDifferential.D k B a ∈ Submodule.span B {bs i₀} := by
        rw [hspan]; exact Submodule.mem_top
      obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp ha
      rw [← KaehlerDifferential.map_D k k B S, ← hc, LinearMap.map_smul, ← algebraMap_smul S c]
      exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self ω)
    rw [eq_top_iff, ← KaehlerDifferential.span_range_derivation k S, Submodule.span_le]
    rintro _ ⟨z, rfl⟩
    obtain ⟨⟨a, u⟩, rfl⟩ := IsLocalization.mk'_surjective M.primeCompl z
    dsimp only
    have hspec := IsLocalization.mk'_spec S a u
    have hu : IsUnit (algebraMap B S u) := IsLocalization.map_units S u
    have h1 : algebraMap B S u • KaehlerDifferential.D k S (IsLocalization.mk' S a u) ∈ N := by
      have hl := (KaehlerDifferential.D k S).leibniz (IsLocalization.mk' S a u) (algebraMap B S u)
      rw [hspec] at hl
      have : algebraMap B S u • KaehlerDifferential.D k S (IsLocalization.mk' S a u) =
          KaehlerDifferential.D k S (algebraMap B S a) -
            IsLocalization.mk' S a u • KaehlerDifferential.D k S (algebraMap B S u) := by
        rw [hl]; abel
      rw [this]
      exact N.sub_mem (hB a) (N.smul_mem _ (hB u))
    have heq : KaehlerDifferential.D k S (IsLocalization.mk' S a u) =
        ((hu.unit⁻¹ : Sˣ) : S) • (algebraMap B S u •
            KaehlerDifferential.D k S (IsLocalization.mk' S a u)) := by
      rw [← mul_smul, hu.val_inv_mul, one_smul]
    show KaehlerDifferential.D k S (IsLocalization.mk' S a u) ∈ N
    rw [heq]
    exact N.smul_mem _ h1



  have s5 : ∀ (k : Type u) [Field k] [IsAlgClosed k] (B : Type u) [CommRing B] [Algebra k B]
      [Algebra.FiniteType k B] (M : Ideal B) [M.IsMaximal] (y : Localization.AtPrime M),
      ∃ c : k, y - algebraMap k (Localization.AtPrime M) c ∈
        IsLocalRing.maximalIdeal (Localization.AtPrime M) := by
    intro k _ _ B _ _ _ M _ y
    letI : Field (B ⧸ M) := Ideal.Quotient.field M
    haveI : Algebra.FiniteType k (B ⧸ M) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ k M) (Ideal.Quotient.mkₐ_surjective k M)
    haveI : Module.Finite k (B ⧸ M) := finite_of_finite_type_of_isJacobsonRing k (B ⧸ M)
    haveI : Algebra.IsIntegral k (B ⧸ M) := Algebra.IsIntegral.of_finite k (B ⧸ M)
    have hsurj : Function.Surjective (algebraMap k (B ⧸ M)) :=
      (IsAlgClosed.algebraMap_bijective_of_isIntegral (k := k) (K := B ⧸ M)).2
    have htow : ∀ c : k, algebraMap k (B ⧸ M) c = Ideal.Quotient.mk M (algebraMap k B c) :=
      fun c => by rw [IsScalarTower.algebraMap_apply k B (B ⧸ M), Ideal.Quotient.algebraMap_eq]
    obtain ⟨⟨b, s⟩, rfl⟩ := IsLocalization.mk'_surjective M.primeCompl y
    obtain ⟨c₁, hc₁⟩ := hsurj (Ideal.Quotient.mk M b)
    obtain ⟨c₂, hc₂⟩ := hsurj (Ideal.Quotient.mk M (s : B))
    have hc₂0 : c₂ ≠ 0 := by
      rintro rfl
      rw [map_zero, eq_comm, Ideal.Quotient.eq_zero_iff_mem] at hc₂
      exact s.2 hc₂
    refine ⟨c₁ / c₂, ?_⟩
    have hmem : b - algebraMap k B (c₁ / c₂) * (s : B) ∈ M := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, ← htow, ← hc₁, ← hc₂, ← map_mul,
        ← map_sub, div_mul_cancel₀ c₁ hc₂0, sub_self, map_zero]
    have hfrac : IsLocalization.mk' (Localization.AtPrime M) b s
        - algebraMap k (Localization.AtPrime M) (c₁ / c₂)
        = IsLocalization.mk' (Localization.AtPrime M)
            (b - algebraMap k B (c₁ / c₂) * (s : B)) s := by
      rw [eq_comm, IsLocalization.mk'_eq_iff_eq_mul, sub_mul, IsLocalization.mk'_spec, map_sub,
        map_mul, IsScalarTower.algebraMap_apply k B (Localization.AtPrime M)]
    rw [hfrac]
    exact (IsLocalization.AtPrime.mk'_mem_maximal_iff (Localization.AtPrime M) M _ _).mpr hmem

  have s6 : ∀ (k : Type u) [Field k] (S : Type u) [CommRing S] [IsLocalRing S] [Algebra k S],
      (∀ y : S, ∃ c : k, y - algebraMap k S c ∈ IsLocalRing.maximalIdeal S) →
      (∃ ω : Ω[S⁄k], Submodule.span S {ω} = ⊤) →
      ∃ t ∈ IsLocalRing.maximalIdeal S, ∀ x ∈ IsLocalRing.maximalIdeal S, ∃ r : S,
        x - r * t ∈ IsLocalRing.maximalIdeal S ^ 2 := by
    intro k _ S _ _ _ hres ⟨ω, hω⟩
    set m := IsLocalRing.maximalIdeal S with hm
    choose ε hε using hres
    have huniq : ∀ (y : S) (c : k), y - algebraMap k S c ∈ m → ε y = c := by
      intro y c hc
      by_contra hne
      have h1 : algebraMap k S (ε y - c) ∈ m := by
        have := m.sub_mem hc (hε y)
        rw [map_sub]
        convert this using 1; ring
      have h2 : IsUnit (algebraMap k S (ε y - c)) :=
        (isUnit_iff_ne_zero.mpr (sub_ne_zero.mpr hne)).map _
      exact (IsLocalRing.mem_maximalIdeal _).mp h1 h2
    let q := m.toCotangent
    let d : S → m.Cotangent := fun y => q ⟨y - algebraMap k S (ε y), hε y⟩
    have hd : ∀ (y : S) (c : k) (h : y - algebraMap k S c ∈ m), d y = q ⟨_, h⟩ := by
      intro y c h
      have := huniq y c h
      exact congrArg q (Subtype.ext (by simp only [this]))
    let L : S →ₗ[k] m.Cotangent :=
      { toFun := d
        map_add' := by
          intro y z
          have hmem : (y + z) - algebraMap k S (ε y + ε z) ∈ m := by
            have := m.add_mem (hε y) (hε z)
            rw [map_add]; convert this using 1; ring
          rw [hd _ _ hmem, ← map_add]
          exact congrArg q (Subtype.ext (by simp only [Submodule.coe_add, map_add]; ring))
        map_smul' := by
          intro c y
          have hmem : c • y - algebraMap k S (c * ε y) ∈ m := by
            have := m.mul_mem_left (algebraMap k S c) (hε y)
            rw [map_mul, Algebra.smul_def]; convert this using 1; ring
          rw [hd _ _ hmem, RingHom.id_apply, ← algebraMap_smul S c (d y), ← map_smul]
          exact congrArg q (Subtype.ext (by
            simp only [Submodule.coe_smul, smul_eq_mul, map_mul, Algebra.smul_def]; ring)) }
    have leib : ∀ y z : S, L (y * z) = y • L z + z • L y := by
      intro y z
      show d (y * z) = y • d z + z • d y
      have hmem : y * z - algebraMap k S (ε y * ε z) ∈ m := by
        have := m.add_mem (m.mul_mem_left y (hε z))
          (m.mul_mem_left (algebraMap k S (ε z)) (hε y))
        rw [map_mul]; convert this using 1; ring
      rw [hd _ _ hmem, ← map_smul, ← map_smul, ← map_add, ← sub_eq_zero, ← map_sub,
        Ideal.toCotangent_eq_zero]
      have : (((⟨y * z - algebraMap k S (ε y * ε z), hmem⟩ : m) -
          (y • (⟨z - algebraMap k S (ε z), hε z⟩ : m) +
            z • (⟨y - algebraMap k S (ε y), hε y⟩ : m)) : m) : S) =
          -((y - algebraMap k S (ε y)) * (z - algebraMap k S (ε z))) := by
        simp only [Submodule.coe_sub, Submodule.coe_add, Submodule.coe_smul, smul_eq_mul, map_mul]
        ring
      rw [this, Ideal.neg_mem_iff, pow_two]
      exact Ideal.mul_mem_mul (hε y) (hε z)
    let D' : Derivation k S m.Cotangent := Derivation.mk' L leib
    have hD' : ∀ y, D' y = d y := fun y => rfl
    obtain ⟨⟨t, ht⟩, hqt⟩ := Ideal.toCotangent_surjective m (D'.liftKaehlerDifferential ω)
    refine ⟨t, ht, fun x hx => ?_⟩
    have hxs : KaehlerDifferential.D k S x ∈ Submodule.span S {ω} := by
      rw [hω]; exact Submodule.mem_top
    obtain ⟨r, hr⟩ := Submodule.mem_span_singleton.mp hxs
    refine ⟨r, ?_⟩
    have hx0 : x - algebraMap k S 0 ∈ m := by rw [map_zero, sub_zero]; exact hx
    have e1 : D'.liftKaehlerDifferential (KaehlerDifferential.D k S x) = q ⟨_, hx0⟩ := by
      rw [Derivation.liftKaehlerDifferential_comp_D, hD', hd x 0 hx0]
    rw [← hr, LinearMap.map_smul, ← hqt, ← map_smul] at e1
    have e2 := congrArg (fun v => v - q ⟨_, hx0⟩) e1
    simp only [sub_self] at e2
    rw [← map_sub, Ideal.toCotangent_eq_zero] at e2
    have : ((r • (⟨t, ht⟩ : m) - ⟨x - algebraMap k S 0, hx0⟩ : m) : S) = -(x - r * t) := by
      simp only [Submodule.coe_sub, Submodule.coe_smul, smul_eq_mul, map_zero]; ring
    rw [this, Ideal.neg_mem_iff] at e2
    exact e2

  have alg : ∀ (K : Type u) [Field K] (A : Type u) [CommRing A] [Algebra K A]
      [Algebra.IsStandardSmoothOfRelativeDimension 1 K A] (p : Ideal A) [p.IsPrime]
      (z₁ z₂ : Localization.AtPrime p), z₁ ∣ z₂ ∨ z₂ ∣ z₁ := by
    intro K _ A _ _ _ p _

    have hC : ∀ x y : A, (∃ s a : A, s ∉ p ∧ s * y = x * a) ∨
        (∃ s a : A, s ∉ p ∧ s * x = y * a) := by
      intro x y
      obtain ⟨M, hM, hpM⟩ := s2 K A p
      haveI := hM
      let B := TensorProduct K (AlgebraicClosure K) A
      let S := Localization.AtPrime M
      haveI : Algebra.IsStandardSmoothOfRelativeDimension 1 (AlgebraicClosure K) B :=
        inferInstance
      haveI := Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth (n := 1)
        (R := AlgebraicClosure K) (S := B)
      haveI : Algebra.FiniteType (AlgebraicClosure K) B := inferInstance
      haveI : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing (AlgebraicClosure K) B
      haveI : IsNoetherianRing S := IsLocalization.isNoetherianRing M.primeCompl S inferInstance

      have hres := s5 (AlgebraicClosure K) B M
      have hΩ := s4 (AlgebraicClosure K) B M
      obtain ⟨t, ht, htm⟩ := s6 (AlgebraicClosure K) S hres hΩ
      have hmt := s7 S t ht htm
      have htot := s8 S t hmt

      have s10 : ∀ x' y' : B, algebraMap B S x' ∣ algebraMap B S y' →
          ∃ v w : B, v ∉ M ∧ v * y' = x' * w := by
        intro x' y' ⟨z, hz⟩
        obtain ⟨⟨w₀, u⟩, rfl⟩ := IsLocalization.mk'_surjective M.primeCompl z
        dsimp only at hz
        have h1 : algebraMap B S (u * y') = algebraMap B S (x' * w₀) := by
          rw [map_mul, map_mul, hz, ← IsLocalization.mk'_spec S w₀ u]; ring
        obtain ⟨c, hc⟩ := (IsLocalization.eq_iff_exists M.primeCompl S).mp h1
        exact ⟨c * u, c * w₀, M.primeCompl.mul_mem c.2 u.2, by linear_combination hc⟩
      rcases htot (algebraMap B S (Algebra.TensorProduct.includeRight x))
          (algebraMap B S (Algebra.TensorProduct.includeRight y)) with h | h
      · obtain ⟨v, w, hv, hvw⟩ := s10 _ _ h
        left
        exact s3 K (AlgebraicClosure K) A p M hpM x y v w hv hvw
      · obtain ⟨v, w, hv, hvw⟩ := s10 _ _ h
        right
        exact s3 K (AlgebraicClosure K) A p M hpM y x v w hv hvw

    intro z₁ z₂
    obtain ⟨⟨x, u₁⟩, rfl⟩ := IsLocalization.mk'_surjective p.primeCompl z₁
    obtain ⟨⟨y, u₂⟩, rfl⟩ := IsLocalization.mk'_surjective p.primeCompl z₂
    dsimp only
    rcases hC x y with ⟨s, a, hs, hsy⟩ | ⟨s, a, hs, hsx⟩
    · left
      refine ⟨IsLocalization.mk' _ ((u₁ : A) * a) (⟨s, hs⟩ * u₂), ?_⟩
      rw [← IsLocalization.mk'_mul, IsLocalization.mk'_eq_iff_eq]
      congr 1
      simp only [Submonoid.coe_mul]
      linear_combination ((u₁ : A) * (u₂ : A)) * hsy
    · right
      refine ⟨IsLocalization.mk' _ ((u₂ : A) * a) (⟨s, hs⟩ * u₁), ?_⟩
      rw [← IsLocalization.mk'_mul, IsLocalization.mk'_eq_iff_eq]
      congr 1
      simp only [Submonoid.coe_mul]
      linear_combination ((u₁ : A) * (u₂ : A)) * hsx

  intro K _ W s _ w _
  obtain ⟨U, hU, V, hV, hw, e, hst⟩ :=
    SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := 1) (f := s) w
  obtain rfl : U = ⊤ := by
    rw [eq_top_iff]
    intro z _
    have h1 : s w ∈ U := e hw
    rwa [Subsingleton.elim (s w) z] at h1
  set g : K →+* Γ(Spec (.of K), ⊤) := (Scheme.ΓSpecIso (.of K)).inv.hom with hg
  have hgb : Function.Bijective g := by
    refine Function.bijective_iff_has_inverse.mpr ⟨(Scheme.ΓSpecIso (.of K)).hom.hom, ?_, ?_⟩
    · intro x
      exact CommRingCat.hom_inv_apply (Scheme.ΓSpecIso (.of K)) x
    · intro x
      exact CommRingCat.inv_hom_apply (Scheme.ΓSpecIso (.of K)) x
  let e₀ : K ≃+* Γ(Spec (.of K), ⊤) := RingEquiv.ofBijective g hgb
  have h0 := RingHom.IsStandardSmoothOfRelativeDimension.equiv e₀
  have hφ := hst.comp h0
  letI : Algebra K Γ(W, V) := ((s.appLE ⊤ V e).hom.comp (e₀ : K →+* Γ(Spec (.of K), ⊤))).toAlgebra
  haveI : Algebra.IsStandardSmoothOfRelativeDimension 1 K Γ(W, V) := hφ
  obtain ⟨x, hx⟩ : ∃ x : V, (x : W) = w := ⟨⟨w, hw⟩, rfl⟩
  subst hx
  let p : Ideal Γ(W, V) := (hV.primeIdealOf x).asIdeal
  haveI hloc : IsLocalization.AtPrime (W.presheaf.stalk (x : W)) p := hV.isLocalization_stalk x
  let iso : W.presheaf.stalk (x : W) ≃+* Localization.AtPrime p :=
    (IsLocalization.algEquiv p.primeCompl (W.presheaf.stalk (x : W))
      (Localization.AtPrime p)).toRingEquiv
  rw [ValuationRing.iff_dvd_total]
  refine ⟨fun a b => ?_⟩
  rcases alg K Γ(W, V) p (iso a) (iso b) with h | h
  · left
    have := map_dvd iso.symm h
    simpa using this
  · right
    have := map_dvd iso.symm h
    simpa using this

theorem wcpa_dj_sgt_birational_iso_valuative : ∀ (Y' Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral Y']
    [AlgebraicGeometry.IsIntegral Y] (π : Y' ⟶ Y) [IsProper π] (V : Y.Opens), V ≠ ⊥ →
    IsIso (π ∣_ V) → (∀ y : Y, ValuationRing (Y.presheaf.stalk y)) → IsIso π :=
by
  intro Y' Y _ _ π _ V hV hiso hval

  have hVne : (V : Set Y).Nonempty := (TopologicalSpace.Opens.ne_bot_iff_nonempty V).mp hV
  have hηV : genericPoint Y ∈ V :=
    ((genericPoint_spec Y).mem_open_set_iff V.isOpen).mpr (by simpa using hVne)
  have hsurjV : ∀ v ∈ V, ∃ x : Y', π x = v := by
    intro v hv
    obtain ⟨x, hx⟩ := (π ∣_ V).surjective ⟨v, hv⟩
    exact ⟨x.1, by rw [← morphismRestrict_base_coe, hx]⟩
  obtain ⟨x₀, hx₀⟩ := hsurjV _ hηV
  have hx₀V : x₀ ∈ π ⁻¹ᵁ V := by
    rw [Scheme.Hom.mem_preimage, hx₀]; exact hηV
  have hη'V : genericPoint Y' ∈ π ⁻¹ᵁ V := by
    have hne : ((π ⁻¹ᵁ V : Y'.Opens) : Set Y').Nonempty := ⟨x₀, hx₀V⟩
    exact ((genericPoint_spec Y').mem_open_set_iff (π ⁻¹ᵁ V).isOpen).mpr (by simpa using hne)
  have hstη : IsIso (π.stalkMap (genericPoint Y')) := by
    have e := morphismRestrictStalkMap π V ⟨genericPoint Y', hη'V⟩
    have h0 : IsIso ((π ∣_ V).stalkMap ⟨genericPoint Y', hη'V⟩) :=
      ((isIso_iff_isIso_stalkMap (π ∣_ V)).mp hiso).2 _
    exact (MorphismProperty.arrow_mk_iso_iff (MorphismProperty.isomorphisms CommRingCat) e).mp h0

  have alg : ∀ (A B K : Type u) [CommRing A] [IsDomain A] [ValuationRing A] [CommRing B] [Field K]
      [Algebra A K] [IsFractionRing A K] (φ : A →+* B) [IsLocalHom φ] (ψ : B →+* K),
      Function.Injective ψ → ψ.comp φ = algebraMap A K → Function.Bijective φ := by
    intro A B K _ _ _ _ _ _ _ φ _ ψ hψ hc
    have hc' : ∀ a, ψ (φ a) = algebraMap A K a := fun a => by rw [← hc]; rfl
    refine ⟨fun a b hab => IsFractionRing.injective A K (by rw [← hc', ← hc', hab]), fun b => ?_⟩
    rcases ValuationRing.isInteger_or_isInteger A (ψ b) with ⟨a, ha⟩ | ⟨a, ha⟩
    · exact ⟨a, hψ (by rw [hc', ha])⟩
    · by_cases hb : ψ b = 0
      · exact ⟨0, hψ (by rw [map_zero, map_zero, hb])⟩
      have h1 : b * φ a = 1 := hψ (by rw [map_mul, hc', ha, map_one, mul_inv_cancel₀ hb])
      have hu : IsUnit a := isUnit_of_map_unit φ a (IsUnit.of_mul_eq_one_right b h1)
      obtain ⟨c, hc2⟩ := hu.exists_right_inv
      refine ⟨c, ?_⟩
      calc φ c = (b * φ a) * φ c := by rw [h1, one_mul]
        _ = b * φ (a * c) := by rw [map_mul, mul_assoc]
        _ = b := by rw [hc2, map_one, mul_one]

  have hst : ∀ z : Y', IsIso (π.stalkMap z) := by
    intro z
    haveI := hval (π z)
    have h1 : Function.Injective (Y'.presheaf.stalkSpecializes (genericPoint_specializes z)).hom :=
      IsFractionRing.injective (Y'.presheaf.stalk z) Y'.functionField
    have h2 : Function.Injective (inv (π.stalkMap (genericPoint Y'))).hom :=
      (ConcreteCategory.bijective_of_isIso (inv (π.stalkMap (genericPoint Y')))).1
    have h3 : Function.Injective
        (Y.presheaf.stalkSpecializes (genericPoint_specializes (π (genericPoint Y')))).hom :=
      IsFractionRing.injective (Y.presheaf.stalk (π (genericPoint Y'))) Y.functionField
    have hψinj : Function.Injective
        (Y'.presheaf.stalkSpecializes (genericPoint_specializes z) ≫
          inv (π.stalkMap (genericPoint Y')) ≫
          Y.presheaf.stalkSpecializes (genericPoint_specializes (π (genericPoint Y')))).hom := by
      rw [CommRingCat.hom_comp, CommRingCat.hom_comp, RingHom.coe_comp, RingHom.coe_comp]
      exact h3.comp (h2.comp h1)
    have hcomp : π.stalkMap z ≫ (Y'.presheaf.stalkSpecializes (genericPoint_specializes z) ≫
          inv (π.stalkMap (genericPoint Y')) ≫
          Y.presheaf.stalkSpecializes (genericPoint_specializes (π (genericPoint Y')))) =
        Y.presheaf.stalkSpecializes (genericPoint_specializes (π z)) := by
      have e := π.stalkSpecializes_stalkMap (genericPoint Y') z (genericPoint_specializes z)
      rw [← Category.assoc, ← e, Category.assoc, IsIso.hom_inv_id_assoc,
        TopCat.Presheaf.stalkSpecializes_comp]
    have hc : (Y'.presheaf.stalkSpecializes (genericPoint_specializes z) ≫
          inv (π.stalkMap (genericPoint Y')) ≫
          Y.presheaf.stalkSpecializes (genericPoint_specializes (π (genericPoint Y')))).hom.comp
          (π.stalkMap z).hom = algebraMap (Y.presheaf.stalk (π z)) Y.functionField := by
      rw [← CommRingCat.hom_comp, hcomp]; rfl
    have hbij := alg (Y.presheaf.stalk (π z)) (Y'.presheaf.stalk z) Y.functionField
      (π.stalkMap z).hom _ hψinj hc
    exact (ConcreteCategory.isIso_iff_bijective _).mpr hbij

  have lift : ∀ (z : Y') (y : Y), π z = y → ∃ l : Spec (Y.presheaf.stalk y) ⟶ Y',
      l ≫ π = Y.fromSpecStalk y ∧ l (IsLocalRing.closedPoint (Y.presheaf.stalk y)) = z := by
    rintro z y rfl
    haveI := hst z
    refine ⟨Spec.map (inv (π.stalkMap z)) ≫ Y'.fromSpecStalk z, ?_, ?_⟩
    · rw [Category.assoc, ← Scheme.SpecMap_stalkMap_fromSpecStalk, ← Category.assoc,
        ← Spec.map_comp, IsIso.hom_inv_id, Spec.map_id, Category.id_comp]
    · have hcp : (Spec.map (inv (π.stalkMap z))) (IsLocalRing.closedPoint (Y.presheaf.stalk (π z))) =
          IsLocalRing.closedPoint (Y'.presheaf.stalk z) := by
        show PrimeSpectrum.comap (inv (π.stalkMap z)).hom
          (IsLocalRing.closedPoint (Y.presheaf.stalk (π z))) = _
        haveI := isLocalHom_of_isIso (inv (π.stalkMap z))
        exact IsLocalRing.comap_closedPoint (inv (π.stalkMap z)).hom
      have h2 := congrArg (Y'.fromSpecStalk z) hcp
      rw [Scheme.fromSpecStalk_closedPoint] at h2
      exact h2

  have uniq : ∀ (y : Y) (l₁ l₂ : Spec (Y.presheaf.stalk y) ⟶ Y'), l₁ ≫ π = Y.fromSpecStalk y →
      l₂ ≫ π = Y.fromSpecStalk y →
      Spec.map (Y.presheaf.stalkSpecializes (genericPoint_specializes y)) ≫ l₁ =
        Spec.map (Y.presheaf.stalkSpecializes (genericPoint_specializes y)) ≫ l₂ → l₁ = l₂ := by
    intro y l₁ l₂ h₁ h₂ hj
    have hj0 : CommRingCat.ofHom (algebraMap (Y.presheaf.stalk y) Y.functionField) =
        Y.presheaf.stalkSpecializes (genericPoint_specializes y) := rfl
    have hsq : CommSq (Spec.map (Y.presheaf.stalkSpecializes (genericPoint_specializes y)) ≫ l₁)
        (Spec.map (CommRingCat.ofHom (algebraMap (Y.presheaf.stalk y) Y.functionField))) π
        (Y.fromSpecStalk y) := ⟨by
          rw [Category.assoc, h₁]
          exact congrArg (fun g => Spec.map g ≫ Y.fromSpecStalk y) hj0.symm⟩
    let S : ValuativeCommSq π := @ValuativeCommSq.mk _ _ π (Y.presheaf.stalk y) _ inferInstance
      (hval y) Y.functionField _ _ inferInstance _ _ hsq
    have hu : Subsingleton S.commSq.LiftStruct := IsSeparated.valuativeCriterion π S
    let L₁ : S.commSq.LiftStruct := ⟨l₁, rfl, h₁⟩
    let L₂ : S.commSq.LiftStruct := ⟨l₂, hj.symm, h₂⟩
    exact congrArg CommSq.LiftStruct.l (hu.elim L₁ L₂)

  have eqV : ∀ (T : Scheme.{u}) (a b : T ⟶ Y'), a ≫ π = b ≫ π →
      Set.range ⇑(a ≫ π) ⊆ (V : Set Y) → a = b := by
    intro T a b hab hr
    have hr' : Set.range ⇑(b ≫ π) ⊆ (V : Set Y) := hab ▸ hr
    have ha : Set.range ⇑a ⊆ Set.range ⇑(π ⁻¹ᵁ V).ι := by
      rw [Scheme.Opens.range_ι]; rintro _ ⟨t, rfl⟩; exact hr ⟨t, rfl⟩
    have hb : Set.range ⇑b ⊆ Set.range ⇑(π ⁻¹ᵁ V).ι := by
      rw [Scheme.Opens.range_ι]; rintro _ ⟨t, rfl⟩; exact hr' ⟨t, rfl⟩
    have key : IsOpenImmersion.lift _ a ha = IsOpenImmersion.lift _ b hb := by
      rw [← cancel_mono (π ∣_ V), ← cancel_mono V.ι, Category.assoc, Category.assoc,
        morphismRestrict_ι, ← Category.assoc, IsOpenImmersion.lift_fac, ← Category.assoc,
        IsOpenImmersion.lift_fac, hab]
    calc a = IsOpenImmersion.lift _ a ha ≫ (π ⁻¹ᵁ V).ι := (IsOpenImmersion.lift_fac _ a ha).symm
      _ = IsOpenImmersion.lift _ b hb ≫ (π ⁻¹ᵁ V).ι := by rw [key]
      _ = b := IsOpenImmersion.lift_fac _ b hb

  have hinj : Function.Injective π := by
    intro z₁ z₂ h
    obtain ⟨l₁, hl₁, hc₁⟩ := lift z₁ (π z₁) rfl
    obtain ⟨l₂, hl₂, hc₂⟩ := lift z₂ (π z₁) h.symm
    have hj : Spec.map (Y.presheaf.stalkSpecializes (genericPoint_specializes (π z₁))) ≫ l₁ =
        Spec.map (Y.presheaf.stalkSpecializes (genericPoint_specializes (π z₁))) ≫ l₂ := by
      apply eqV
      · rw [Category.assoc, Category.assoc, hl₁, hl₂]
      · rw [Category.assoc, hl₁, Scheme.SpecMap_stalkSpecializes_fromSpecStalk,
          Scheme.range_fromSpecStalk]
        intro x hx
        exact hx.mem_open V.isOpen hηV
    have hl := uniq _ l₁ l₂ hl₁ hl₂ hj
    calc z₁ = l₁ (IsLocalRing.closedPoint _) := hc₁.symm
      _ = l₂ (IsLocalRing.closedPoint _) := by rw [hl]
      _ = z₂ := hc₂

  have hsurj : Function.Surjective π := by
    have hcl : IsClosed (Set.range π) := π.isClosedMap.isClosed_range
    have hVsub : (V : Set Y) ⊆ Set.range π := fun v hv => hsurjV v hv
    have hdense : Dense (V : Set Y) := V.isOpen.dense hVne
    intro y
    have hy : y ∈ closure (V : Set Y) := by rw [hdense.closure_eq]; trivial
    exact (closure_minimal hVsub hcl) hy
  have hbase : IsIso π.base :=
    TopCat.isIso_of_bijective_of_isClosedMap _ ⟨hinj, hsurj⟩ π.isClosedMap
  exact (isIso_iff_isIso_stalkMap π).mpr ⟨hbase, hst⟩

theorem wcpa_dj_sgf_generic_transfer : ∀ (X₁ Xt P : Scheme.{u}) [AlgebraicGeometry.IsIntegral X₁]
    [AlgebraicGeometry.IsIntegral Xt] [AlgebraicGeometry.IsIntegral P] (α : X₁ ⟶ Xt)
    (f : Xt ⟶ P), IsProper α → IsProper f → (∃ V : Xt.Opens, V ≠ ⊥ ∧ IsIso (α ∣_ V)) →
    SmoothOfRelativeDimension 1 (Limits.pullback.snd f (P.fromSpecStalk (genericPoint P))) →
    GeometricallyConnected (Limits.pullback.snd f (P.fromSpecStalk (genericPoint P))) →
    SmoothOfRelativeDimension 1 (Limits.pullback.snd (α ≫ f) (P.fromSpecStalk (genericPoint P))) ∧
    GeometricallyConnected (Limits.pullback.snd (α ≫ f) (P.fromSpecStalk (genericPoint P))) :=
by
  intro X₁ Xt P _ _ _ α f hαp hfp hV hsm hgc
  haveI := hαp
  haveI := hfp
  haveI := hsm
  haveI := hgc
  obtain ⟨V, hV0, hVi⟩ := hV

  haveI hconn : ConnectedSpace ↥(Limits.pullback f (P.fromSpecStalk (genericPoint P))) :=
    GeometricallyConnected.geometrically_connectedSpace
      (f := Limits.pullback.snd f (P.fromSpecStalk (genericPoint P)))
      (𝟙 _) (𝟙 _) (Limits.pullback.snd f (P.fromSpecStalk (genericPoint P)))
      IsPullback.of_id_fst
  haveI hXηint : AlgebraicGeometry.IsIntegral
      (Limits.pullback f (P.fromSpecStalk (genericPoint P))) :=
    wcpa_dj_sgt_generic_fibre_integral Xt P f inferInstance

  obtain ⟨_, z₁, hz₁⟩ := wcpa_dj_sgt_dominant_of_fibre_nonempty Xt P f inferInstance
  have hξV : genericPoint Xt ∈ V := by
    refine ((genericPoint_spec Xt).mem_open_set_iff V.isOpen).mpr ?_
    simpa using (TopologicalSpace.Opens.ne_bot_iff_nonempty V).mp hV0
  have hV'0 : Limits.pullback.fst f (P.fromSpecStalk (genericPoint P)) ⁻¹ᵁ V ≠ ⊥ := by
    rw [TopologicalSpace.Opens.ne_bot_iff_nonempty]
    refine ⟨z₁, ?_⟩
    show z₁ ∈ Limits.pullback.fst f (P.fromSpecStalk (genericPoint P)) ⁻¹ᵁ V
    rw [Scheme.Hom.mem_preimage, hz₁]
    exact hξV

  obtain ⟨x₁, hx₁⟩ := (α ∣_ V).surjective ⟨genericPoint Xt, hξV⟩
  have hαx₁ : α x₁.1 = genericPoint Xt := by
    rw [← morphismRestrict_base_coe, hx₁]
  obtain ⟨z, -, -⟩ := Scheme.Pullback.exists_preimage_pullback
    (f := α) (g := Limits.pullback.fst f (P.fromSpecStalk (genericPoint P))) x₁.1 z₁
    (hαx₁.trans hz₁.symm)
  haveI : Nonempty ↥(Limits.pullback (α ≫ f) (P.fromSpecStalk (genericPoint P))) :=
    ⟨(Limits.pullbackRightPullbackFstIso f (P.fromSpecStalk (genericPoint P)) α).hom z⟩
  haveI : AlgebraicGeometry.IsIntegral
      (Limits.pullback (α ≫ f) (P.fromSpecStalk (genericPoint P))) :=
    wcpa_dj_sgt_generic_fibre_integral X₁ P (α ≫ f) inferInstance
  haveI : Nonempty ↥(Limits.pullback α
      (Limits.pullback.fst f (P.fromSpecStalk (genericPoint P)))) :=
    ⟨z⟩
  haveI hZint : AlgebraicGeometry.IsIntegral
      (Limits.pullback α (Limits.pullback.fst f (P.fromSpecStalk (genericPoint P)))) :=
    isIntegral_of_isOpenImmersion
      (Limits.pullbackRightPullbackFstIso f (P.fromSpecStalk (genericPoint P)) α).hom

  haveI : IsProper (Limits.pullback.snd α
      (Limits.pullback.fst f (P.fromSpecStalk (genericPoint P)))) := inferInstance
  have hiso' := wcpa_dj_sgt_isIso_restrict_pullback α
    (Limits.pullback.fst f (P.fromSpecStalk (genericPoint P))) V hVi
  have hval : ∀ y : ↥(Limits.pullback f (P.fromSpecStalk (genericPoint P))),
      ValuationRing ((Limits.pullback f (P.fromSpecStalk (genericPoint P))).presheaf.stalk y) :=
    fun y => wcpa_dj_sgt_smooth_curve_stalk_valuation ↑(P.presheaf.stalk (genericPoint P))
      (Limits.pullback f (P.fromSpecStalk (genericPoint P)))
      (Limits.pullback.snd f (P.fromSpecStalk (genericPoint P))) y
  haveI hαη : IsIso (Limits.pullback.snd α
      (Limits.pullback.fst f (P.fromSpecStalk (genericPoint P)))) :=
    wcpa_dj_sgt_birational_iso_valuative _ _ _ _ hV'0 hiso' hval

  have hcomm : (Limits.pullbackRightPullbackFstIso f (P.fromSpecStalk (genericPoint P)) α).inv ≫
      Limits.pullback.snd α (Limits.pullback.fst f (P.fromSpecStalk (genericPoint P))) ≫
        Limits.pullback.snd f (P.fromSpecStalk (genericPoint P)) =
      Limits.pullback.snd (α ≫ f) (P.fromSpecStalk (genericPoint P)) := by
    rw [Iso.inv_comp_eq, Limits.pullbackRightPullbackFstIso_hom_snd]
  have hpb : IsPullback
      ((Limits.pullbackRightPullbackFstIso f (P.fromSpecStalk (genericPoint P)) α).inv ≫
        Limits.pullback.snd α (Limits.pullback.fst f (P.fromSpecStalk (genericPoint P))))
      (Limits.pullback.snd (α ≫ f) (P.fromSpecStalk (genericPoint P)))
      (Limits.pullback.snd f (P.fromSpecStalk (genericPoint P))) (𝟙 _) :=
    IsPullback.of_horiz_isIso ⟨by rw [Category.comp_id, Category.assoc, hcomm]⟩
  exact ⟨MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hpb hsm,
    MorphismProperty.of_isPullback (P := @GeometricallyConnected) hpb hgc⟩

theorem wcpa_dj_cf_smooth_generic_fibre : ∀ (k : Type u) [Field k] [Finite k] (Γ Q : Scheme.{u})
    [AlgebraicGeometry.IsIntegral Γ] [AlgebraicGeometry.IsIntegral Q] (sQ : Q ⟶ Spec (.of k))
    (g : Γ ⟶ Q) (d : ℕ),
    wcpaDjIsProjOver k (g ≫ sQ) → wcpaDjIsProjOver k sQ →
    topologicalKrullDim Q = (d : WithBot ℕ∞) →
    topologicalKrullDim Γ = ((d + 1 : ℕ) : WithBot ℕ∞) →
    GeometricallyIrreducible (Limits.pullback.snd g (Q.fromSpecStalk (genericPoint Q))) →
    GeometricallyReduced (Limits.pullback.snd g (Q.fromSpecStalk (genericPoint Q))) →
    ∃ (X₁ P : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral X₁) (_ : AlgebraicGeometry.IsIntegral P)
      (α₂ : X₁ ⟶ Γ) (sP : P ⟶ Spec (.of k)) (f : X₁ ⟶ P),
      f ≫ sP = α₂ ≫ g ≫ sQ ∧ wcpaDjIsProjOver k (α₂ ≫ g ≫ sQ) ∧ wcpaDjIsProjOver k sP ∧
      IsProper α₂ ∧ Surjective α₂ ∧ (∃ V : Γ.Opens, V ≠ ⊥ ∧ IsFinite (α₂ ∣_ V)) ∧
      topologicalKrullDim P = (d : WithBot ℕ∞) ∧
      SmoothOfRelativeDimension 1 (Limits.pullback.snd f (P.fromSpecStalk (genericPoint P))) ∧
      GeometricallyConnected (Limits.pullback.snd f (P.fromSpecStalk (genericPoint P))) :=
by
  intro k _ _ Γ Q _ _ sQ g d hPg hPQ hQd hΓd hGI hGR
  haveI hsQp : IsProper sQ := wcpa_dj_proj_proper k sQ hPQ
  haveI hgsQ : IsProper (g ≫ sQ) := wcpa_dj_proj_proper k _ hPg
  haveI hgp : IsProper g := IsProper.of_comp g sQ

  obtain ⟨m₀, hm⟩ := wcpa_dj_sgf_generic_smooth k Γ Q sQ g d hPg hPQ hQd hΓd hGI hGR

  obtain ⟨Φ, hΦfin, hΦfrob, hΦs⟩ := wcpa_dj_sgf_frobenius_k k Q sQ m₀

  obtain ⟨R, iR, r, hrci, hrs, hρfin, hρs⟩ :=
    wcpa_dj_sgf_twist_reduced_integral k Γ Q sQ g Φ m₀ hΦfin hΦfrob hΦs
  haveI := iR
  haveI := hrci
  haveI := hρfin
  haveI : IsProper (Limits.pullback.snd g Φ) := inferInstance
  haveI hsR : IsProper (r ≫ Limits.pullback.snd g Φ ≫ sQ) := inferInstance

  obtain ⟨Xt, iXt, b, hbfin, hbs, hbnorm, hbU⟩ :=
    wcpa_dj_sgf_normalization k R (r ≫ Limits.pullback.snd g Φ ≫ sQ)
  haveI := iXt
  haveI := hbfin
  obtain ⟨hsm, hgc⟩ := hm m₀ le_rfl Φ hΦfin hΦfrob hΦs R r hrci hrs Xt b hbfin hbs hbnorm hbU

  haveI : IsProper (b ≫ r ≫ Limits.pullback.snd g Φ ≫ sQ) := inferInstance
  obtain ⟨X₁, iX₁, α, hαP, hαp, hαs, hαV⟩ :=
    wcpa_dj_sgf_chow_birational k Xt (b ≫ r ≫ Limits.pullback.snd g Φ ≫ sQ)
  haveI := iX₁
  haveI := hαp
  have hfp : IsProper (b ≫ r ≫ Limits.pullback.snd g Φ) := inferInstance

  obtain ⟨hsm', hgc'⟩ := wcpa_dj_sgf_generic_transfer X₁ Xt Q α
    (b ≫ r ≫ Limits.pullback.snd g Φ) hαp hfp hαV hsm hgc

  have heq : (α ≫ b ≫ r ≫ Limits.pullback.snd g Φ) ≫ sQ =
      (α ≫ b ≫ r ≫ Limits.pullback.fst g Φ) ≫ g ≫ sQ := by
    simp only [Category.assoc]
    rw [Limits.pullback.condition_assoc, hΦs]

  have hΓne : (⊤ : Γ.Opens) ≠ ⊥ := by
    obtain ⟨x⟩ := (inferInstance : Nonempty Γ)
    exact (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mpr ⟨x, trivial⟩
  have hρV : ∃ V : Γ.Opens, V ≠ ⊥ ∧ IsFinite ((r ≫ Limits.pullback.fst g Φ) ∣_ V) :=
    ⟨⊤, hΓne, inferInstance⟩
  have hbV : ∃ V : R.Opens, V ≠ ⊥ ∧ IsFinite (b ∣_ V) := by
    obtain ⟨U, hU, hiso⟩ := hbU
    exact ⟨U, hU, inferInstance⟩
  have hαV' : ∃ V : Xt.Opens, V ≠ ⊥ ∧ IsFinite (α ∣_ V) := by
    obtain ⟨V, hV, hiso⟩ := hαV
    exact ⟨V, hV, inferInstance⟩
  have hρp : IsProper (r ≫ Limits.pullback.fst g Φ) := inferInstance
  obtain ⟨h1s, h1f⟩ := wcpa_dj_alteration_comp (X := Γ) (Y := R)
    (r ≫ Limits.pullback.fst g Φ) b hρp hρs hbs hρV hbV
  have h1p : IsProper (b ≫ r ≫ Limits.pullback.fst g Φ) := inferInstance
  obtain ⟨h2s, h2f⟩ := wcpa_dj_alteration_comp (X := Γ) (Y := Xt)
    (b ≫ r ≫ Limits.pullback.fst g Φ) α h1p h1s hαs h1f hαV'
  refine ⟨X₁, Q, iX₁, inferInstance, α ≫ b ≫ r ≫ Limits.pullback.fst g Φ, sQ,
    α ≫ b ≫ r ≫ Limits.pullback.snd g Φ, heq, ?_, hPQ, inferInstance, h2s, h2f, hQd, hsm', hgc'⟩
  rw [← heq]
  simpa only [Category.assoc] using hαP

theorem wcpa_dj_cf_ss_affine_generic_fibre : ∀ (X₁ P : Scheme.{u}) [AlgebraicGeometry.IsIntegral P]
    (f : X₁ ⟶ P) (n : ℕ),
    SmoothOfRelativeDimension n (Limits.pullback.snd f (P.fromSpecStalk (genericPoint P))) →
    ∀ (U₀ : P.Opens) (_ : IsAffineOpen U₀) [Nonempty U₀] (V₀ : X₁.Opens) (_ : IsAffineOpen V₀)
      (e : V₀ ≤ f ⁻¹ᵁ U₀),
      letI := (f.appLE U₀ V₀ e).hom.toAlgebra
      letI := (P.germToFunctionField U₀).hom.toAlgebra
      SmoothOfRelativeDimension n (Spec.map (CommRingCat.ofHom (algebraMap P.functionField
        (TensorProduct Γ(P, U₀) P.functionField Γ(X₁, V₀))))) :=
by
  intro X₁ P _ f n h U₀ hU₀ _ V₀ hV₀ e
  letI := (f.appLE U₀ V₀ e).hom.toAlgebra
  letI := (P.germToFunctionField U₀).hom.toAlgebra

  have s2 : ∀ {W X Y Z S : Scheme.{u}} {fst : W ⟶ X} {snd : W ⟶ Y} {f : X ⟶ Z} {g : Y ⟶ Z}
      (i : Z ⟶ S) [Mono i] {f' : X ⟶ S} {g' : Y ⟶ S},
      IsPullback fst snd f g → f ≫ i = f' → g ≫ i = g' → IsPullback fst snd f' g' := by
    intro W X Y Z S fst snd f g i _ f' g' H hf hg
    subst hf hg
    refine IsPullback.mk' ?_ ?_ ?_
    · rw [← Category.assoc, H.w, Category.assoc]
    · intro T φ φ' h1 h2
      exact H.hom_ext h1 h2
    · intro T a b hab
      have w : a ≫ f = b ≫ g := by
        rw [← cancel_mono i]
        simpa only [Category.assoc] using hab
      exact ⟨H.lift a b w, H.lift_fst a b w, H.lift_snd a b w⟩

  have s3 : ∀ {X₁ P W V E : Scheme.{u}} (f : X₁ ⟶ P) (j : E ⟶ P) (ι : V ⟶ X₁)
      [IsOpenImmersion ι] (a : W ⟶ E) (b : W ⟶ V) (n : ℕ), IsPullback a b j (ι ≫ f) →
      SmoothOfRelativeDimension n (Limits.pullback.snd f j) →
      SmoothOfRelativeDimension n a := by
    intro X₁ P W V E f j ι _ a b n H hs
    have H₂ := (IsPullback.of_hasPullback ι (Limits.pullback.fst f j)).flip.paste_horiz
      (IsPullback.of_hasPullback f j).flip
    have hε := IsPullback.isoIsPullback_hom_fst E V H H₂
    haveI := hs
    haveI h1 := smoothOfRelativeDimension_comp 0 n
      (Limits.pullback.snd ι (Limits.pullback.fst f j)) (Limits.pullback.snd f j)
    have h2 := smoothOfRelativeDimension_comp 0 (0 + n) (IsPullback.isoIsPullback E V H H₂).hom
      (Limits.pullback.snd ι (Limits.pullback.fst f j) ≫ Limits.pullback.snd f j)
    rw [hε] at h2
    simpa only [zero_add] using h2

  obtain ⟨⟨x, hx⟩⟩ := ‹Nonempty U₀›
  have hη : genericPoint P ∈ U₀ :=
    ((genericPoint_spec P).mem_open_set_iff U₀.isOpen).mpr ⟨x, Set.mem_univ x, hx⟩
  have e1 : Spec.map (CommRingCat.ofHom (algebraMap Γ(P, U₀) P.functionField)) ≫ hU₀.fromSpec
      = P.fromSpecStalk (genericPoint P) := by
    rw [← hU₀.fromSpecStalk_eq_fromSpecStalk hη]
    rfl

  have H1 := isPullback_SpecMap_of_isPushout _ _ _ _
    (CommRingCat.isPushout_tensorProduct Γ(P, U₀) P.functionField Γ(X₁, V₀))
  haveI : IsOpenImmersion hU₀.fromSpec := hU₀.isOpenImmersion_fromSpec
  haveI : IsOpenImmersion hV₀.fromSpec := hV₀.isOpenImmersion_fromSpec
  have e2 : Spec.map (CommRingCat.ofHom (algebraMap Γ(P, U₀) Γ(X₁, V₀))) ≫ hU₀.fromSpec
      = hV₀.fromSpec ≫ f := IsAffineOpen.SpecMap_appLE_fromSpec f hU₀ hV₀ e
  have H2 := s2 hU₀.fromSpec H1 e1 e2
  exact s3 f _ hV₀.fromSpec _ _ n H2 h

theorem wcpa_dj_cf_ss_generic_prime_comap : ∀ (X₁ P : Scheme.{u}) [AlgebraicGeometry.IsIntegral P]
    (f : X₁ ⟶ P) (U₀ : P.Opens) (_ : IsAffineOpen U₀) (V₀ : X₁.Opens) (hV₀ : IsAffineOpen V₀)
    (e : V₀ ≤ f ⁻¹ᵁ U₀) (x : X₁) (hx : x ∈ V₀), f x = genericPoint P →
    Ideal.comap (f.appLE U₀ V₀ e).hom (hV₀.primeIdealOf ⟨x, hx⟩).asIdeal = ⊥ :=
by
  intro X₁ P _ f U₀ _ V₀ hV₀ e x hx hfx
  rw [eq_bot_iff]
  intro s hs
  rw [Ideal.mem_comap] at hs
  rw [Ideal.mem_bot]
  have h2 : x ∉ X₁.basicOpen ((f.appLE U₀ V₀ e).hom s) := by
    intro hxb
    have h1 : hV₀.primeIdealOf ⟨x, hx⟩ ∈
        hV₀.fromSpec ⁻¹ᵁ X₁.basicOpen ((f.appLE U₀ V₀ e).hom s) := by
      show hV₀.fromSpec (hV₀.primeIdealOf ⟨x, hx⟩) ∈ X₁.basicOpen ((f.appLE U₀ V₀ e).hom s)
      rw [hV₀.fromSpec_primeIdealOf]; exact hxb
    rw [hV₀.fromSpec_preimage_basicOpen] at h1
    exact (PrimeSpectrum.mem_basicOpen _ _).mp h1 hs
  have h3 : genericPoint P ∉ P.basicOpen s := by
    intro hg
    apply h2
    have hmem : x ∈ V₀ ⊓ f ⁻¹ᵁ P.basicOpen s := by
      refine ⟨hx, ?_⟩
      show f x ∈ P.basicOpen s
      rw [hfx]; exact hg
    rw [← Scheme.basicOpen_appLE] at hmem
    exact hmem
  have h4 : P.basicOpen s = ⊥ := by
    by_contra hne
    rw [← Ne, TopologicalSpace.Opens.ne_bot_iff_nonempty] at hne
    apply h3
    exact ((genericPoint_spec P).mem_open_set_iff (P.basicOpen s).isOpen).mpr
      (by simpa using hne)
  exact (basicOpen_eq_bot_iff s).mp h4

theorem wcpa_dj_cf_ss_smoothAt_of_generic : ∀ (A K B : Type u) [CommRing A] [IsDomain A] [Field K]
    [Algebra A K] [IsFractionRing A K] [CommRing B] [Algebra A B] (n : ℕ) (q : Ideal B) [q.IsPrime],
    q.comap (algebraMap A B) = ⊥ →
    (∀ Q : Ideal (TensorProduct A K B), Q.IsPrime → ∃ s : TensorProduct A K B, s ∉ Q ∧
      Algebra.IsStandardSmoothOfRelativeDimension n K (Localization.Away s)) →
    Algebra.IsSmoothAt A q :=
by
  intro A K B _ _ _ _ _ _ _ n q hqP hq H
  classical
  letI : Algebra B (TensorProduct A K B) := Algebra.TensorProduct.rightAlgebra
  haveI hT : IsLocalization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))
      (TensorProduct A K B) :=
    IsLocalization.tensorRight (R := A) (S := B) K (nonZeroDivisors A)
  have hdisj : Disjoint (↑(Algebra.algebraMapSubmonoid B (nonZeroDivisors A)) : Set B) ↑q := by
    rw [Set.disjoint_left]
    rintro x hx hxq
    obtain ⟨a, ha, rfl⟩ := Submonoid.mem_map.mp hx
    have h0 : a ∈ q.comap (algebraMap A B) := hxq
    rw [hq, Ideal.mem_bot] at h0
    subst h0
    exact zero_notMem_nonZeroDivisors ha

  have key : ∀ {R L : Type u} [CommRing R] [CommRing L] [Algebra R L] (I J : Ideal R)
      [I.IsPrime] [J.IsPrime], I = J → IsLocalization.AtPrime L I → IsLocalization.AtPrime L J := by
    intro R L _ _ _ I J _ _ hIJ h
    subst hIJ
    exact h
  have hQ : (q.map (algebraMap B (TensorProduct A K B))).IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))
      (TensorProduct A K B) q hqP hdisj
  have hQq : (q.map (algebraMap B (TensorProduct A K B))).comap
      (algebraMap B (TensorProduct A K B)) = q := by
    have h := IsLocalization.under_map_of_isPrime_disjoint
      (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)) (TensorProduct A K B) hqP hdisj
    rwa [Ideal.under_def] at h
  generalize hQdef : q.map (algebraMap B (TensorProduct A K B)) = Q at hQ hQq
  obtain ⟨s, hs, hstd⟩ := H Q hQ
  haveI := Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth n (R := K)
    (S := Localization.Away s)
  have hsdisj : Disjoint (↑(Submonoid.powers s) : Set (TensorProduct A K B)) ↑Q :=
    (Ideal.disjoint_powers_iff_notMem s hQ.isRadical).mpr hs
  have hP : (Q.map (algebraMap (TensorProduct A K B) (Localization.Away s))).IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers s) (Localization.Away s) Q hQ hsdisj
  have hPQ : (Q.map (algebraMap (TensorProduct A K B) (Localization.Away s))).comap
      (algebraMap (TensorProduct A K B) (Localization.Away s)) = Q := by
    have h := IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers s)
      (Localization.Away s) hQ hsdisj
    rwa [Ideal.under_def] at h
  generalize hPdef : Q.map (algebraMap (TensorProduct A K B) (Localization.Away s)) = P at hP hPQ
  haveI hLP : IsLocalization P.primeCompl (Localization.AtPrime P) := Localization.isLocalization
  haveI : Algebra.FormallySmooth (Localization.Away s) (Localization.AtPrime P) :=
    Algebra.FormallySmooth.of_isLocalization P.primeCompl
  haveI : Algebra.FormallySmooth K (Localization.AtPrime P) :=
    Algebra.FormallySmooth.comp K (Localization.Away s) _
  haveI : Algebra.FormallySmooth A K := Algebra.FormallySmooth.of_isLocalization (nonZeroDivisors A)
  haveI hAL : Algebra.FormallySmooth A (Localization.AtPrime P) :=
    Algebra.FormallySmooth.comp A K _
  have h1 : IsLocalization.AtPrime (Localization.AtPrime P)
      (P.comap (algebraMap (TensorProduct A K B) (Localization.Away s))) :=
    IsLocalization.isLocalization_isLocalization_atPrime_isLocalization (Submonoid.powers s)
      (S := Localization.Away s) (Localization.AtPrime P) P
  haveI h1' : IsLocalization.AtPrime (Localization.AtPrime P) Q := key _ _ hPQ h1
  have h2 : IsLocalization.AtPrime (Localization.AtPrime P)
      (Q.comap (algebraMap B (TensorProduct A K B))) :=
    IsLocalization.isLocalization_isLocalization_atPrime_isLocalization
      (Algebra.algebraMapSubmonoid B (nonZeroDivisors A)) (S := TensorProduct A K B)
      (Localization.AtPrime P) Q
  haveI h2' : IsLocalization.AtPrime (Localization.AtPrime P) q := key _ _ hQq h2
  haveI hLq : IsLocalization q.primeCompl (Localization.AtPrime q) := Localization.isLocalization
  let e : Localization.AtPrime P ≃ₐ[B] Localization.AtPrime q :=
    IsLocalization.algEquiv q.primeCompl (Localization.AtPrime P) (Localization.AtPrime q)
  exact Algebra.FormallySmooth.of_equiv (e.restrictScalars A)

theorem wcpa_dj_cf_ss_std_smooth_nbhd : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
    [Algebra.FinitePresentation A B] (q : Ideal B) [q.IsPrime], Algebra.IsSmoothAt A q →
    ∃ (b : B) (m : ℕ), b ∉ q ∧ Algebra.IsStandardSmoothOfRelativeDimension m A (Localization.Away b) :=
by
  intro A B _ _ _ _ q _ h
  obtain ⟨b, hb, hstd⟩ :=
    @Algebra.IsSmoothAt.exists_notMem_isStandardSmooth A B _ _ _ _ q _ h
  obtain ⟨ι, σ, hσ, hι, ⟨P⟩⟩ := hstd.out
  exact ⟨b, P.dimension, hb, ⟨⟨ι, σ, hσ, hι, P, rfl⟩⟩⟩

theorem wcpa_dj_cf_ss_reldim_eq : ∀ (A K B : Type u) [CommRing A] [IsDomain A] [Field K] [Algebra A K]
    [IsFractionRing A K] [CommRing B] [Algebra A B] (n m : ℕ) (q : Ideal B) [q.IsPrime],
    q.comap (algebraMap A B) = ⊥ →
    (∀ Q : Ideal (TensorProduct A K B), Q.IsPrime → ∃ s : TensorProduct A K B, s ∉ Q ∧
      Algebra.IsStandardSmoothOfRelativeDimension n K (Localization.Away s)) →
    ∀ b : B, b ∉ q → Algebra.IsStandardSmoothOfRelativeDimension m A (Localization.Away b) → m = n :=
by
  classical

  have s3 : ∀ (K T : Type u) [CommRing K] [CommRing T] [Algebra K T] (Q : Ideal T), Q.IsPrime →
      ∀ (s β : T), s ∉ Q → β ∉ Q → ∀ (n m : ℕ),
      Algebra.IsStandardSmoothOfRelativeDimension n K (Localization.Away s) →
      Algebra.IsStandardSmoothOfRelativeDimension m K (Localization.Away β) → m = n := by
    intro K T _ _ _ Q hQ s β hs hβ n m hn hm
    let Ts := Localization.Away s
    let Tb := Localization.Away β
    let C := Localization.Away (algebraMap T Ts β)
    let D := Localization.Away (algebraMap T Tb s)
    haveI hC0 : Algebra.IsStandardSmoothOfRelativeDimension 0 Ts C :=
      Algebra.IsStandardSmoothOfRelativeDimension.localization_away (algebraMap T Ts β)
    haveI hD0 : Algebra.IsStandardSmoothOfRelativeDimension 0 Tb D :=
      Algebra.IsStandardSmoothOfRelativeDimension.localization_away (algebraMap T Tb s)
    have hCn : Algebra.IsStandardSmoothOfRelativeDimension (0 + n) K C :=
      Algebra.IsStandardSmoothOfRelativeDimension.trans n 0 K Ts C
    have hDm : Algebra.IsStandardSmoothOfRelativeDimension (0 + m) K D :=
      Algebra.IsStandardSmoothOfRelativeDimension.trans m 0 K Tb D
    haveI hCl : IsLocalization.Away (β * s) C := IsLocalization.Away.mul Ts C s β
    haveI hDl : IsLocalization.Away (β * s) D := IsLocalization.Away.mul' Tb D β s
    let e : C ≃ₐ[T] D := IsLocalization.algEquiv (Submonoid.powers (β * s)) C D
    let e' : D ≃ₐ[K] C := (e.restrictScalars K).symm
    have hCm : Algebra.IsStandardSmoothOfRelativeDimension (0 + m) K C :=
      @Algebra.IsStandardSmoothOfRelativeDimension.of_algEquiv (0 + m) K D _ _ _ C _ _ e' hDm
    have hprod : β * s ∉ Q := fun h => (hQ.mem_or_mem h).elim hβ hs
    have hdisj : Disjoint (Submonoid.powers (β * s) : Set T) (Q : Set T) :=
      (Ideal.disjoint_powers_iff_notMem (β * s) hQ.isRadical).mpr hprod
    have hP := IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers (β * s)) C Q hQ hdisj
    haveI : Nontrivial C := nontrivial_of_ne (0 : C) 1 (fun h => hP.ne_top
      ((Ideal.eq_top_iff_one _).mpr (by rw [← h]; exact Ideal.zero_mem _)))
    have h1 := @Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential K C _ _ _ _
      (0 + n) hCn
    have h2 := @Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential K C _ _ _ _
      (0 + m) hCm
    rw [h1] at h2
    have h3 : 0 + n = 0 + m := by exact_mod_cast h2
    omega

  have s2 : ∀ (A K B : Type u) [CommRing A] [CommRing K] [Algebra A K] [CommRing B] [Algebra A B]
      (b : B), Nonempty (TensorProduct A K (Localization.Away b) ≃ₐ[K]
        Localization.Away (TensorProduct.tmul A (1 : K) b)) := by
    intro A K B _ _ _ _ _ b
    let β : TensorProduct A K B := TensorProduct.tmul A (1 : K) b
    let ιT : TensorProduct A K B →ₐ[K] Localization.Away β :=
      IsScalarTower.toAlgHom K _ (Localization.Away β)
    let jB : B →ₐ[A] Localization.Away β :=
      (ιT.restrictScalars A).comp Algebra.TensorProduct.includeRight
    have hjb : IsUnit (jB b) := IsLocalization.Away.algebraMap_isUnit β
    have hjbp : ∀ y : Submonoid.powers b, IsUnit (jB y) := by
      rintro ⟨y, k, rfl⟩
      simp only [map_pow]
      exact hjb.pow k
    let g : Localization.Away b →ₐ[A] Localization.Away β :=
      IsLocalization.liftAlgHom (M := Submonoid.powers b) hjbp
    let Φ : TensorProduct A K (Localization.Away b) →ₐ[K] Localization.Away β :=
      Algebra.TensorProduct.lift (Algebra.ofId K _) g (fun _ _ => Commute.all _ _)
    let ψ₀ : TensorProduct A K B →ₐ[K] TensorProduct A K (Localization.Away b) :=
      Algebra.TensorProduct.map (AlgHom.id K K) (IsScalarTower.toAlgHom A B (Localization.Away b))
    have hψb : IsUnit (ψ₀ β) := by
      have : ψ₀ β = Algebra.TensorProduct.includeRight (algebraMap B (Localization.Away b) b) := by
        simp [ψ₀, β, Algebra.TensorProduct.includeRight_apply]
      rw [this]
      exact (IsLocalization.Away.algebraMap_isUnit b).map _
    have hψbp : ∀ y : Submonoid.powers β, IsUnit (ψ₀ y) := by
      rintro ⟨y, k, rfl⟩
      simp only [map_pow]
      exact hψb.pow k
    let Ψ : Localization.Away β →ₐ[K] TensorProduct A K (Localization.Away b) :=
      IsLocalization.liftAlgHom (M := Submonoid.powers β) hψbp
    have hΨ : ∀ y, Ψ (algebraMap _ (Localization.Away β) y) = ψ₀ y := fun y =>
      IsLocalization.lift_eq _ y
    have hg : ∀ x, g (algebraMap B (Localization.Away b) x) =
        algebraMap _ (Localization.Away β) (TensorProduct.tmul A (1 : K) x) := fun x =>
      IsLocalization.lift_eq _ x
    have hΦ : ∀ y, Φ (TensorProduct.tmul A (1 : K) y) = g y := fun y => by
      simp only [Φ, Algebra.TensorProduct.lift_tmul, map_one, one_mul]
    have hψ₀ : ∀ x, ψ₀ (TensorProduct.tmul A (1 : K) x) =
        TensorProduct.tmul A (1 : K) (algebraMap B (Localization.Away b) x) :=
      fun x => by simp [ψ₀]
    refine ⟨AlgEquiv.ofAlgHom Φ Ψ ?_ ?_⟩
    · apply IsLocalization.algHom_ext (Submonoid.powers β)
      apply Algebra.TensorProduct.ext
      · apply Algebra.ext_id
      · ext x
        change Φ (Ψ (algebraMap _ (Localization.Away β) (TensorProduct.tmul A (1 : K) x))) =
          algebraMap _ (Localization.Away β) (TensorProduct.tmul A (1 : K) x)
        rw [hΨ, hψ₀, hΦ, hg]
    · apply Algebra.TensorProduct.ext
      · apply Algebra.ext_id
      · apply IsLocalization.algHom_ext (Submonoid.powers b)
        ext x
        change Ψ (Φ (TensorProduct.tmul A (1 : K) (algebraMap B (Localization.Away b) x))) =
          TensorProduct.tmul A (1 : K) (algebraMap B (Localization.Away b) x)
        rw [hΦ, hg, hΨ, hψ₀]

  have s1 : ∀ (A K B : Type u) [CommRing A] [IsDomain A] [Field K] [Algebra A K]
      [IsFractionRing A K] [CommRing B] [Algebra A B] (q : Ideal B) [q.IsPrime],
      q.comap (algebraMap A B) = ⊥ → ∀ b : B, b ∉ q →
      ∃ Q : Ideal (TensorProduct A K B), Q.IsPrime ∧ TensorProduct.tmul A (1 : K) b ∉ Q := by
    intro A K B _ _ _ _ _ _ _ q _ hq b hb
    let φ : B →+* q.ResidueField := algebraMap B q.ResidueField
    let g₀ : A →+* q.ResidueField := φ.comp (algebraMap A B)
    have hg₀ : ∀ y : nonZeroDivisors A, IsUnit (g₀ y) := by
      rintro ⟨y, hy⟩
      apply isUnit_iff_ne_zero.mpr
      intro h0
      have h1 : algebraMap A B y ∈ q := Ideal.algebraMap_residueField_eq_zero.mp h0
      have h2 : y ∈ q.comap (algebraMap A B) := h1
      rw [hq] at h2
      exact nonZeroDivisors.ne_zero hy ((Submodule.mem_bot A).mp h2)
    let g : K →+* q.ResidueField := IsLocalization.lift hg₀
    have hgc : ∀ a : A, g (algebraMap A K a) = algebraMap A q.ResidueField a := by
      intro a
      rw [IsLocalization.lift_eq hg₀ a, IsScalarTower.algebraMap_apply A B q.ResidueField]
      rfl
    let gA : K →ₐ[A] q.ResidueField := { g with commutes' := hgc }
    let φA : B →ₐ[A] q.ResidueField := IsScalarTower.toAlgHom A B q.ResidueField
    let ψ : TensorProduct A K B →ₐ[A] q.ResidueField :=
      Algebra.TensorProduct.lift gA φA (fun _ _ => Commute.all _ _)
    refine ⟨RingHom.ker ψ, RingHom.ker_isPrime ψ, ?_⟩
    rw [RingHom.mem_ker]
    have : ψ (TensorProduct.tmul A (1 : K) b) = φA b := by
      simp only [ψ, Algebra.TensorProduct.lift_tmul, map_one, one_mul]
    rw [this]
    intro h
    exact hb (Ideal.algebraMap_residueField_eq_zero.mp h)

  intro A K B _ _ _ _ _ _ _ n m q _ hq hloc b hb hstd
  obtain ⟨Q, hQ, hβQ⟩ := s1 A K B q hq b hb
  obtain ⟨s, hsQ, hs⟩ := hloc Q hQ
  haveI := hstd
  have hD : Algebra.IsStandardSmoothOfRelativeDimension m K
      (TensorProduct A K (Localization.Away b)) :=
    Algebra.IsStandardSmoothOfRelativeDimension.baseChange m K
  obtain ⟨e⟩ := s2 A K B b
  have hβ : Algebra.IsStandardSmoothOfRelativeDimension m K
      (Localization.Away (TensorProduct.tmul A (1 : K) b)) :=
    @Algebra.IsStandardSmoothOfRelativeDimension.of_algEquiv m K _ _ _ _ _ _ _ e hD
  exact s3 K (TensorProduct A K B) Q hQ s _ hsQ hβQ n m hs hβ

theorem wcpa_dj_cf_ss_chart_of_away : ∀ (X₁ P : Scheme.{u}) (f : X₁ ⟶ P) (n : ℕ)
    (U₀ : P.Opens) (_ : IsAffineOpen U₀) (V₀ : X₁.Opens) (hV₀ : IsAffineOpen V₀)
    (e : V₀ ≤ f ⁻¹ᵁ U₀) (x : X₁) (hx : x ∈ V₀) (b : Γ(X₁, V₀)),
    b ∉ (hV₀.primeIdealOf ⟨x, hx⟩).asIdeal →
    (letI := (f.appLE U₀ V₀ e).hom.toAlgebra
     Algebra.IsStandardSmoothOfRelativeDimension n Γ(P, U₀) (Localization.Away b)) →
    ∃ (U' : P.Opens) (_ : IsAffineOpen U') (V' : X₁.Opens) (_ : IsAffineOpen V')
      (_ : x ∈ V') (e' : V' ≤ f ⁻¹ᵁ U'),
      RingHom.IsStandardSmoothOfRelativeDimension n (f.appLE U' V' e').hom :=
by
  intro X₁ P f n U₀ hU₀ V₀ hV₀ e x hx b hb hstd
  have hD : IsAffineOpen (X₁.basicOpen b) := hV₀.basicOpen b
  have hxD : x ∈ X₁.basicOpen b := by
    have h1 := hV₀.fromSpec_primeIdealOf ⟨x, hx⟩
    have h2 : hV₀.primeIdealOf ⟨x, hx⟩ ∈ hV₀.fromSpec ⁻¹ᵁ X₁.basicOpen b := by
      rw [hV₀.fromSpec_preimage_basicOpen]
      exact hb
    have h3 : hV₀.fromSpec (hV₀.primeIdealOf ⟨x, hx⟩) ∈ X₁.basicOpen b := h2
    rw [h1] at h3
    exact h3
  have e' : X₁.basicOpen b ≤ f ⁻¹ᵁ U₀ := (X₁.basicOpen_le b).trans e
  refine ⟨U₀, hU₀, X₁.basicOpen b, hD, hxD, e', ?_⟩
  have hcomp : (f.appLE U₀ (X₁.basicOpen b) e').hom =
      (X₁.presheaf.map (homOfLE (X₁.basicOpen_le b)).op).hom.comp (f.appLE U₀ V₀ e).hom := by
    rw [← Scheme.Hom.appLE_map f e (homOfLE (X₁.basicOpen_le b)).op]
    rfl
  have H : RingHom.IsStandardSmoothOfRelativeDimension n
      ((algebraMap Γ(X₁, V₀) (Localization.Away b)).comp (f.appLE U₀ V₀ e).hom) := by
    letI := (f.appLE U₀ V₀ e).hom.toAlgebra
    have h := (RingHom.isStandardSmoothOfRelativeDimension_algebraMap n).mpr hstd
    have h2 : algebraMap Γ(P, U₀) (Localization.Away b) =
        (algebraMap Γ(X₁, V₀) (Localization.Away b)).comp (f.appLE U₀ V₀ e).hom :=
      IsScalarTower.algebraMap_eq _ _ _
    rw [h2] at h
    exact h
  haveI hloc : IsLocalization.Away b Γ(X₁, X₁.basicOpen b) := hV₀.isLocalization_basicOpen b
  let ε := IsLocalization.algEquiv (Submonoid.powers b) (Localization.Away b)
    Γ(X₁, X₁.basicOpen b)
  have hε : (ε.toRingEquiv.toRingHom).comp (algebraMap Γ(X₁, V₀) (Localization.Away b)) =
      (X₁.presheaf.map (homOfLE (X₁.basicOpen_le b)).op).hom := by
    ext r
    exact ε.commutes r
  have h3 := (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso n).1 _ ε.toRingEquiv H
  rw [← RingHom.comp_assoc, hε, ← hcomp] at h3
  exact h3

theorem wcpa_dj_cf_smooth_spread : ∀ (k : Type u) [Field k] (X₁ P : Scheme.{u})
    [AlgebraicGeometry.IsIntegral X₁] [AlgebraicGeometry.IsIntegral P]
    (sP : P ⟶ Spec (.of k)) [IsProper sP] (f : X₁ ⟶ P) [IsProper f],
    SmoothOfRelativeDimension 1 (Limits.pullback.snd f (P.fromSpecStalk (genericPoint P))) →
    ∃ U : P.Opens, U ≠ ⊥ ∧ SmoothOfRelativeDimension 1 (f ∣_ U) :=
by
  intro k _ X₁ P _ _ sP _ f _ h
  classical
  haveI : IsLocallyNoetherian P := LocallyOfFiniteType.isLocallyNoetherian sP

  have hgen : ∀ x : X₁, f x = genericPoint P →
      ∃ (U' : P.Opens) (_ : IsAffineOpen U') (V' : X₁.Opens) (_ : IsAffineOpen V')
        (_ : x ∈ V') (e' : V' ≤ f ⁻¹ᵁ U'),
        RingHom.IsStandardSmoothOfRelativeDimension 1 (f.appLE U' V' e').hom := by
    intro x hfx
    obtain ⟨U₀, hU₀, hηU₀, -⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp P.isBasis_affineOpens)
        (show genericPoint P ∈ (⊤ : P.Opens) from trivial)
    have hU₀' : IsAffineOpen U₀ := hU₀
    haveI : Nonempty U₀ := ⟨⟨_, hηU₀⟩⟩
    have hxU : x ∈ f ⁻¹ᵁ U₀ := by rw [Scheme.Hom.mem_preimage, hfx]; exact hηU₀
    obtain ⟨V₀, hV₀, hxV₀, e⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp X₁.isBasis_affineOpens) hxU
    have hV₀' : IsAffineOpen V₀ := hV₀
    letI := (f.appLE U₀ V₀ e).hom.toAlgebra
    letI := (P.germToFunctionField U₀).hom.toAlgebra
    haveI : IsDomain Γ(P, U₀) := IsIntegral.component_integral U₀
    haveI : IsFractionRing Γ(P, U₀) P.functionField :=
      functionField_isFractionRing_of_isAffineOpen P U₀ hU₀'
    haveI : IsNoetherianRing Γ(P, U₀) := IsLocallyNoetherian.component_noetherian ⟨U₀, hU₀'⟩
    haveI : Algebra.FiniteType Γ(P, U₀) Γ(X₁, V₀) :=
      HasRingHomProperty.appLE @LocallyOfFiniteType f inferInstance ⟨U₀, hU₀'⟩ ⟨V₀, hV₀'⟩ e
    haveI : Algebra.FinitePresentation Γ(P, U₀) Γ(X₁, V₀) :=
      Algebra.FinitePresentation.of_finiteType.mp inferInstance
    have hgenfib := wcpa_dj_cf_ss_affine_generic_fibre X₁ P f 1 h U₀ hU₀' V₀ hV₀' e
    have hloc := wcpa_dj_cf_ss_field_local_std P.functionField
      (TensorProduct Γ(P, U₀) P.functionField Γ(X₁, V₀)) 1 hgenfib
    have hq : (hV₀'.primeIdealOf ⟨x, hxV₀⟩).asIdeal.comap
        (algebraMap Γ(P, U₀) Γ(X₁, V₀)) = ⊥ :=
      wcpa_dj_cf_ss_generic_prime_comap X₁ P f U₀ hU₀' V₀ hV₀' e x hxV₀ hfx
    have hsm := wcpa_dj_cf_ss_smoothAt_of_generic Γ(P, U₀) P.functionField Γ(X₁, V₀) 1
      (hV₀'.primeIdealOf ⟨x, hxV₀⟩).asIdeal hq hloc
    obtain ⟨b, m, hb, hstd⟩ := wcpa_dj_cf_ss_std_smooth_nbhd Γ(P, U₀) Γ(X₁, V₀)
      (hV₀'.primeIdealOf ⟨x, hxV₀⟩).asIdeal hsm
    have hm := wcpa_dj_cf_ss_reldim_eq Γ(P, U₀) P.functionField Γ(X₁, V₀) 1 m
      (hV₀'.primeIdealOf ⟨x, hxV₀⟩).asIdeal hq hloc b hb hstd
    subst hm
    exact wcpa_dj_cf_ss_chart_of_away X₁ P f 1 U₀ hU₀' V₀ hV₀' e x hxV₀ b hb hstd

  set S : Set X₁ := {x | ∃ (U' : P.Opens) (_ : IsAffineOpen U') (V' : X₁.Opens)
      (_ : IsAffineOpen V') (_ : x ∈ V') (e' : V' ≤ f ⁻¹ᵁ U'),
      RingHom.IsStandardSmoothOfRelativeDimension 1 (f.appLE U' V' e').hom} with hSdef
  have hopen : IsOpen S := by
    rw [isOpen_iff_forall_mem_open]
    rintro x ⟨U', hU', V', hV', hxV', e', hstd⟩
    exact ⟨V', fun y hy => ⟨U', hU', V', hV', hy, e', hstd⟩, V'.isOpen, hxV'⟩

  have hZ : IsClosed (f '' Sᶜ) := f.isClosedMap _ hopen.isClosed_compl
  refine ⟨⟨(f '' Sᶜ)ᶜ, hZ.isOpen_compl⟩, ?_, ?_⟩
  ·
    rw [TopologicalSpace.Opens.ne_bot_iff_nonempty]
    refine ⟨genericPoint P, ?_⟩
    show genericPoint P ∈ (f '' Sᶜ)ᶜ
    rintro ⟨z, hz, hfz⟩
    exact hz (hgen z hfz)
  ·
    apply wcpa_dj_cf_ss_restrict_of_charts f 1
    intro x hx
    have hx' : f x ∈ (f '' Sᶜ)ᶜ := hx
    by_contra hc
    exact hx' ⟨x, hc, rfl⟩

theorem wcpa_dj_cf_geom_connected_spread : ∀ (k : Type u) [Field k] (X₁ P : Scheme.{u})
    [AlgebraicGeometry.IsIntegral X₁] [AlgebraicGeometry.IsIntegral P] (sP : P ⟶ Spec (.of k))
    [IsProper sP] (f : X₁ ⟶ P) [IsProper f] (U : P.Opens), U ≠ ⊥ →
    SmoothOfRelativeDimension 1 (f ∣_ U) →
    GeometricallyConnected (Limits.pullback.snd f (P.fromSpecStalk (genericPoint P))) →
    ∃ U' : P.Opens, U' ≠ ⊥ ∧ SmoothOfRelativeDimension 1 (f ∣_ U') ∧
      GeometricallyConnected (f ∣_ U') :=
by

  have wcgcs_geomConnected_restrict_of_points : ∀ (X P : Scheme.{u}) (f : X ⟶ P) (U : P.Opens),
      (∀ (K : Type u) [Field K] (t : Spec (.of K) ⟶ P), Set.range t ⊆ (U : Set P) →
        ∀ (W : Scheme.{u}) (fst : W ⟶ X) (snd : W ⟶ Spec (.of K)), IsPullback fst snd f t →
          ConnectedSpace ↥W) →
      GeometricallyConnected (f ∣_ U) := by
    intro X P f U H
    constructor
    intro K _ y W fst snd hpb
    have h2 := IsPullback.paste_horiz hpb (isPullback_morphismRestrict f U).flip
    refine H K (y ≫ U.ι) ?_ W (fst ≫ (f ⁻¹ᵁ U).ι) snd h2
    rintro _ ⟨z, rfl⟩
    rw [← U.range_ι]
    exact ⟨y z, (Scheme.Hom.comp_apply y U.ι z).symm⟩

  have wcgcs_connected_of_field_extension : ∀ (X₁ P W : Scheme.{u}) (f : X₁ ⟶ P) (K L : Type u)
      [Field K] [Field L] (ψ : K →+* L) (g : Spec (.of K) ⟶ P) (t : Spec (.of L) ⟶ P)
      (fst : W ⟶ X₁) (snd : W ⟶ Spec (.of K)), IsPullback fst snd f g →
      Spec.map (CommRingCat.ofHom ψ) ≫ g = t → ConnectedSpace ↥(Limits.pullback f t) →
      ConnectedSpace ↥W := by
    intro X₁ P W f K L _ _ ψ g t fst snd hW ht hc
    subst ht
    have hsurjψ : Surjective (Spec.map (CommRingCat.ofHom ψ)) := by
      constructor
      intro x
      haveI : Subsingleton ↥(Spec (.of K)) := inferInstanceAs (Subsingleton (PrimeSpectrum K))
      obtain ⟨y⟩ : Nonempty ↥(Spec (.of L)) := inferInstanceAs (Nonempty (PrimeSpectrum L))
      exact ⟨y, Subsingleton.elim _ _⟩
    let c : Limits.pullback f (Spec.map (CommRingCat.ofHom ψ) ≫ g) ⟶ W :=
      hW.lift (Limits.pullback.fst _ _) (Limits.pullback.snd _ _ ≫ Spec.map (CommRingCat.ofHom ψ))
        (by rw [Limits.pullback.condition, Category.assoc])
    have hsq : IsPullback c (Limits.pullback.snd _ _) snd (Spec.map (CommRingCat.ofHom ψ)) := by
      refine IsPullback.of_right ?_ (hW.lift_snd _ _ _) hW
      rw [hW.lift_fst]
      exact IsPullback.of_hasPullback _ _
    haveI : Surjective c := MorphismProperty.of_isPullback (P := @Surjective) hsq.flip hsurjψ
    exact (Scheme.Hom.surjective c).connectedSpace c.continuous

  have wcgcs_smooth_base_change_into_open : ∀ (X₁ P T : Scheme.{u}) (f : X₁ ⟶ P) (U : P.Opens)
      (g : T ⟶ P), Set.range g ⊆ (U : Set P) → SmoothOfRelativeDimension 1 (f ∣_ U) →
      SmoothOfRelativeDimension 1 (Limits.pullback.snd f g) := by
    intro X₁ P T f U g hg h
    have hg' : Set.range g ⊆ Set.range U.ι := by rw [U.range_ι]; exact hg
    have hfac : IsOpenImmersion.lift U.ι g hg' ≫ U.ι = g := IsOpenImmersion.lift_fac _ _ _
    let l : Limits.pullback f g ⟶ (f ⁻¹ᵁ U : Scheme) :=
      (isPullback_morphismRestrict f U).lift
        (Limits.pullback.snd f g ≫ IsOpenImmersion.lift U.ι g hg')
        (Limits.pullback.fst f g) (by rw [Category.assoc, hfac, Limits.pullback.condition])
    have hsq : IsPullback l (Limits.pullback.snd f g) (f ∣_ U) (IsOpenImmersion.lift U.ι g hg') := by
      refine IsPullback.of_right ?_ ((isPullback_morphismRestrict f U).lift_fst _ _ _)
        (isPullback_morphismRestrict f U).flip
      rw [(isPullback_morphismRestrict f U).lift_snd, hfac]
      exact IsPullback.of_hasPullback _ _
    exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hsq h

  have wcgcs_injective_stalk_point_generic : ∀ (P : Scheme.{u}) [AlgebraicGeometry.IsIntegral P]
      (x : P) (Ω : Type u) [Field Ω] (ψ : ↑(P.presheaf.stalk x) →+* Ω), Function.Injective ψ →
      (Spec.map (CommRingCat.ofHom ψ) ≫ P.fromSpecStalk x) (IsLocalRing.closedPoint Ω) =
        genericPoint P := by
    intro P _ x Ω _ ψ hψ
    have hη : genericPoint P ∈ Set.range (P.fromSpecStalk x) := by
      rw [Scheme.range_fromSpecStalk]; exact genericPoint_specializes x
    obtain ⟨q, hq⟩ := hη
    have hzq : Spec.map (CommRingCat.ofHom ψ) (IsLocalRing.closedPoint Ω) ⤳ q := by
      refine (PrimeSpectrum.le_iff_specializes _ _).mp ?_
      intro a ha
      change ψ a ∈ IsLocalRing.maximalIdeal Ω at ha
      have h0 : ψ a = 0 := by
        by_contra hne
        exact (IsLocalRing.mem_maximalIdeal _).mp ha (isUnit_iff_ne_zero.mpr hne)
      have : a = 0 := hψ (h0.trans (map_zero ψ).symm)
      rw [this]; exact Ideal.zero_mem _
    have h1 := hzq.map (P.fromSpecStalk x).continuous
    rw [hq] at h1
    exact (Scheme.Hom.comp_apply _ _ _).trans (h1.antisymm (genericPoint_specializes _)).eq

  have wcgcs_geom_generic_fibre_irreducible : ∀ (X₁ P : Scheme.{u}) [AlgebraicGeometry.IsIntegral P]
      (f : X₁ ⟶ P), GeometricallyConnected (Limits.pullback.snd f (P.fromSpecStalk (genericPoint P))) →
      ∀ (Ω : Type u) [Field Ω] (g : Spec (.of Ω) ⟶ P), g (IsLocalRing.closedPoint Ω) = genericPoint P →
      SmoothOfRelativeDimension 1 (Limits.pullback.snd f g) →
      IrreducibleSpace ↥(Limits.pullback f g) := by
    intro X₁ P _ f hgc Ω _ g hg hsm
    have key : ∀ (x : P) (e : g (IsLocalRing.closedPoint Ω) = x),
        ∃ ψ : P.presheaf.stalk x ⟶ CommRingCat.of Ω, Spec.map ψ ≫ P.fromSpecStalk x = g := by
      intro x e
      subst e
      exact ⟨_, Scheme.Spec_stalkClosedPointTo_fromSpecStalk g⟩
    obtain ⟨ψ, hψ⟩ := key _ hg
    subst hψ
    haveI := hsm
    haveI hc0 : ConnectedSpace ↥(Limits.pullback
        (Limits.pullback.snd f (P.fromSpecStalk (genericPoint P))) (Spec.map ψ)) :=
      hgc.geometrically_connectedSpace (Spec.map ψ) (Limits.pullback.fst _ _)
        (Limits.pullback.snd _ _) (IsPullback.of_hasPullback _ _)
    let e := Limits.pullbackLeftPullbackSndIso f (P.fromSpecStalk (genericPoint P)) (Spec.map ψ)
    haveI : ConnectedSpace ↥(Limits.pullback f (Spec.map ψ ≫ P.fromSpecStalk (genericPoint P))) :=
      (Scheme.Hom.surjective e.hom).connectedSpace e.hom.continuous
    haveI : Smooth (Limits.pullback.snd f (Spec.map ψ ≫ P.fromSpecStalk (genericPoint P))) :=
      SmoothOfRelativeDimension.smooth 1 _
    haveI : IsLocallyNoetherian (Limits.pullback f (Spec.map ψ ≫ P.fromSpecStalk (genericPoint P))) :=
      LocallyOfFiniteType.isLocallyNoetherian
        (Limits.pullback.snd f (Spec.map ψ ≫ P.fromSpecStalk (genericPoint P)))
    exact wcpa_irreducible_of_connected_domain_stalks _
      (wcpa_smooth_stalk_isDomain Ω _ (Limits.pullback.snd f _) 1)

  have wcgcs_closed_fibre_connected : ∀ (X P : Scheme.{u}) (f : X ⟶ P) (A : Type u) [CommRing A]
      [IsLocalRing A] (gA : Spec (.of A) ⟶ P) [Flat (Limits.pullback.snd f gA)],
      (∀ y : ↥(Limits.pullback f gA),
        _root_.IsConnected (closure {y} ∩ (Limits.pullback.snd f gA) ⁻¹' {IsLocalRing.closedPoint A})) →
      ∀ (Ω : Type u) [Field Ω] (j : A →+* Ω), Function.Injective j →
      IrreducibleSpace ↥(Limits.pullback f (Spec.map (CommRingCat.ofHom j) ≫ gA)) →
      ConnectedSpace ↥(Limits.pullback f
        (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) ≫ gA)) := by
    intro X P f A _ _ gA _ H Ω _ j _ hirr
    set h := Limits.pullback.snd f gA with hh
    set F₀ : Set ↥(Limits.pullback f gA) := h ⁻¹' {IsLocalRing.closedPoint A} with hF₀
    have hres_pt : ∀ z : ↥(Spec (.of (IsLocalRing.ResidueField A))),
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) z = IsLocalRing.closedPoint A := by
      intro z
      have hz : z = IsLocalRing.closedPoint (IsLocalRing.ResidueField A) :=
        Subsingleton.elim (α := PrimeSpectrum (IsLocalRing.ResidueField A)) _ _
      subst hz
      exact IsLocalRing.comap_closedPoint (IsLocalRing.residue A)
    haveI : IsClosedImmersion (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))) :=
      IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
    have hrange : Set.range (Limits.pullback.fst h
        (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))) = F₀ := by
      rw [Scheme.Pullback.range_fst]
      ext y
      constructor
      · rintro ⟨z, hz⟩
        show h y ∈ ({IsLocalRing.closedPoint A} : Set _)
        rw [← hz, hres_pt]
        exact Set.mem_singleton _
      · intro hy
        have hy' : h y = IsLocalRing.closedPoint A := hy
        obtain ⟨z⟩ : Nonempty ↥(Spec (.of (IsLocalRing.ResidueField A))) :=
          inferInstanceAs (Nonempty (PrimeSpectrum (IsLocalRing.ResidueField A)))
        exact ⟨z, (hres_pt z).trans hy'.symm⟩
    set θ := Spec.map (CommRingCat.ofHom j) (IsLocalRing.closedPoint Ω) with hθ
    set G := Set.range (Limits.pullback.fst h (Spec.map (CommRingCat.ofHom j))) with hG
    have hGirr : IsIrreducible G := by
      let ej := Limits.pullbackLeftPullbackSndIso f gA (Spec.map (CommRingCat.ofHom j))
      haveI : IrreducibleSpace ↥(Limits.pullback h (Spec.map (CommRingCat.ofHom j))) :=
        (Scheme.Hom.surjective ej.inv).irreducibleSpace ej.inv.continuous
      have := (IrreducibleSpace.isIrreducible_univ
        (↥(Limits.pullback h (Spec.map (CommRingCat.ofHom j))))).image
        (Limits.pullback.fst h (Spec.map (CommRingCat.ofHom j))) (Scheme.Hom.continuous _).continuousOn
      rwa [Set.image_univ] at this
    obtain ⟨y₀, hy₀⟩ := QuasiSober.sober hGirr.closure isClosed_closure
    have hsub : F₀ ⊆ closure {y₀} := by
      rw [hy₀.def]
      intro x hx
      have hxpt : h x = IsLocalRing.closedPoint A := hx
      have hspec : θ ⤳ h x := by
        rw [hxpt]
        refine (PrimeSpectrum.le_iff_specializes _ _).mp ?_
        exact IsLocalRing.le_maximalIdeal (θ.isPrime.ne_top)
      obtain ⟨x', hx'x, hx'θ⟩ := Flat.generalizingMap h hspec
      have hx'G : x' ∈ G := by
        rw [hG, Scheme.Pullback.range_fst]
        exact ⟨_, hx'θ.symm⟩
      exact closure_mono (Set.singleton_subset_iff.mpr hx'G) (specializes_iff_mem_closure.mp hx'x)
    have hF₀c : _root_.IsConnected F₀ := by
      have := H y₀
      rwa [Set.inter_eq_right.mpr hsub] at this
    rw [← hrange] at hF₀c
    have hemb := (Limits.pullback.fst h
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))).isClosedEmbedding
    haveI : ConnectedSpace ↥(Set.range (Limits.pullback.fst h
        (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))))) := Subtype.connectedSpace hF₀c
    haveI : ConnectedSpace ↥(Limits.pullback h
        (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))) :=
      hemb.isEmbedding.toHomeomorph.symm.surjective.connectedSpace
        hemb.isEmbedding.toHomeomorph.symm.continuous
    let er := Limits.pullbackLeftPullbackSndIso f gA
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))
    exact (Scheme.Hom.surjective er.hom).connectedSpace er.hom.continuous

  have wcgcs_valuationSubring_henselian : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (V : ValuationSubring Ω), HenselianLocalRing V := by
    intro Ω _ _ V
    refine HenselianLocalRing.mk ?_
    intro F hF a₀ ha₀ _
    set FΩ := F.map (algebraMap V Ω) with hFΩ
    have hmon : FΩ.Monic := hF.map _
    have hlift : ∀ α ∈ FΩ.roots, ∃ a : V, algebraMap V Ω a = α := by
      intro α hα
      have hint : _root_.IsIntegral V α := by
        refine ⟨F, hF, ?_⟩
        have := (Polynomial.mem_roots hmon.ne_zero).mp hα
        rw [Polynomial.IsRoot, hFΩ, Polynomial.eval_map] at this
        exact this
      exact IsIntegrallyClosed.isIntegral_iff.mp hint
    choose! lft hlft using hlift
    set s : Multiset V := FΩ.roots.map lft with hs
    have hsplit : FΩ = (FΩ.roots.map (fun α => Polynomial.X - Polynomial.C α)).prod := by
      have := Polynomial.Splits.eq_prod_roots (IsAlgClosed.splits FΩ)
      rwa [hmon.leadingCoeff, Polynomial.C_1, one_mul] at this
    have hFs : F = (s.map (fun a => Polynomial.X - Polynomial.C a)).prod := by
      apply Polynomial.map_injective (algebraMap V Ω) (IsFractionRing.injective V Ω)
      rw [← hFΩ, hsplit, Polynomial.map_multiset_prod, hs, Multiset.map_map, Multiset.map_map]
      congr 1
      apply Multiset.map_congr rfl
      intro α hα
      simp [hlft α hα]
    have heval : ∀ b : V, F.eval b = (s.map (fun a => b - a)).prod := by
      intro b
      rw [hFs, Polynomial.eval_multiset_prod, Multiset.map_map]
      congr 1
      apply Multiset.map_congr rfl
      intro a _
      simp
    rw [heval] at ha₀
    obtain ⟨p, hp, hpm⟩ :=
      ((IsLocalRing.maximalIdeal.isMaximal V).isPrime.multiset_prod_mem_iff_exists_mem _).mp ha₀
    obtain ⟨a, ha, rfl⟩ := Multiset.mem_map.mp hp
    refine ⟨a, ?_, ?_⟩
    · rw [Polynomial.IsRoot, heval]
      exact Multiset.prod_eq_zero (Multiset.mem_map.mpr ⟨a, ha, sub_self a⟩)
    · have := (IsLocalRing.maximalIdeal V).neg_mem hpm
      rwa [neg_sub] at this

  have wcgcs_valuation_dominating : ∀ (A : Type u) [CommRing A] [IsDomain A] (K : Type u) [Field K]
      (φ : A →+* K), ∃ (Ω : Type u) (_ : Field Ω) (_ : IsAlgClosed Ω) (V : ValuationSubring Ω)
      (ι : A →+* V) (ψ : K →+* IsLocalRing.ResidueField V),
      Function.Injective ι ∧ ψ.comp φ = (IsLocalRing.residue V).comp ι := by
    intro A _ _ K _ φ
    classical
    let S := MvPolynomial K A
    let ev : S →+* K := MvPolynomial.eval₂Hom φ (fun c => c)
    have hev : Function.Surjective ev :=
      fun c => ⟨MvPolynomial.X c, MvPolynomial.eval₂Hom_X' _ _ _⟩
    let q : Ideal S := RingHom.ker ev
    haveI hqmax : q.IsMaximal := RingHom.ker_isMaximal_of_surjective ev hev
    haveI : q.IsPrime := hqmax.isPrime
    let B := Localization.AtPrime q
    have hSB : Function.Injective (algebraMap S B) :=
      IsLocalization.injective B (Ideal.primeCompl_le_nonZeroDivisors q)
    let e : A →+* B := (algebraMap S B).comp MvPolynomial.C
    have he : Function.Injective e := hSB.comp (MvPolynomial.C_injective K A)
    have hunit : ∀ y : q.primeCompl, IsUnit (ev y) := by
      intro y
      exact isUnit_iff_ne_zero.mpr (fun h => y.2 h)
    let evB : B →+* K := IsLocalization.lift (M := q.primeCompl) (S := B) hunit
    have hevB : ∀ s : S, evB (algebraMap S B s) = ev s := IsLocalization.lift_eq hunit
    have hevBs : Function.Surjective evB := by
      intro c
      obtain ⟨s, hs⟩ := hev c
      exact ⟨algebraMap S B s, (hevB s).trans hs⟩
    have hker : RingHom.ker evB = IsLocalRing.maximalIdeal B :=
      IsLocalRing.eq_maximalIdeal (RingHom.ker_isMaximal_of_surjective evB hevBs)
    let σ : K →+* IsLocalRing.ResidueField B :=
      (Ideal.quotEquivOfEq hker).toRingHom.comp
        (RingHom.quotientKerEquivOfSurjective hevBs).symm.toRingHom
    have hσ : ∀ b : B, σ (evB b) = IsLocalRing.residue B b := by
      intro b
      have h1 : (RingHom.quotientKerEquivOfSurjective hevBs).symm (evB b) =
          Ideal.Quotient.mk (RingHom.ker evB) b := by
        rw [RingEquiv.symm_apply_eq, RingHom.quotientKerEquivOfSurjective_apply_mk]
      change Ideal.quotEquivOfEq hker ((RingHom.quotientKerEquivOfSurjective hevBs).symm (evB b)) = _
      rw [h1, Ideal.quotEquivOfEq_mk]
      rfl
    have hfr : ∀ (B' : Type u) [CommRing B'] [IsDomain B'], ∃ (Ω : Type u) (_ : Field Ω)
        (_ : IsAlgClosed Ω) (emb : B' →+* Ω), Function.Injective emb := by
      intro B' _ _
      exact ⟨AlgebraicClosure (FractionRing B'), inferInstance, inferInstance,
        (algebraMap (FractionRing B') (AlgebraicClosure (FractionRing B'))).comp
          (algebraMap B' (FractionRing B')),
        (algebraMap (FractionRing B') _).injective.comp
          (IsFractionRing.injective B' (FractionRing B'))⟩
    obtain ⟨Ω, _, _, emb, hemb⟩ := hfr B
    let Bsub : LocalSubring Ω := LocalSubring.range emb
    obtain ⟨V, hV⟩ := LocalSubring.exists_le_valuationSubring Bsub
    obtain ⟨hle, hloc⟩ := LocalSubring.le_def.mp hV
    have hmem : ∀ b : B, emb b ∈ Bsub.toSubring := fun b => ⟨b, rfl⟩
    let β : B →+* V := emb.codRestrict V (fun b => hle (hmem b))
    have hβinj : Function.Injective β := fun a b h => hemb (congrArg Subtype.val h)
    haveI : IsLocalHom β := by
      refine ⟨fun b hb => ?_⟩
      let b' : Bsub.toSubring := ⟨emb b, hmem b⟩
      have h2 : IsUnit (Subring.inclusion hle b') := by
        have : Subring.inclusion hle b' = β b := rfl
        rw [this]; exact hb
      have h3 : IsUnit b' := isUnit_of_map_unit (Subring.inclusion hle) b' h2
      obtain ⟨u, hu⟩ := h3
      obtain ⟨b₀, hb₀⟩ : ((u⁻¹ : (Bsub.toSubring)ˣ) : Bsub.toSubring).1 ∈ emb.range :=
        ((u⁻¹ : (Bsub.toSubring)ˣ) : Bsub.toSubring).2
      have hbb : b * b₀ = 1 := by
        apply hemb
        rw [map_mul, map_one, hb₀]
        have h4 : ((u : Bsub.toSubring) * ((u⁻¹ : (Bsub.toSubring)ˣ) : Bsub.toSubring)).1 = 1 := by
          rw [Units.mul_inv]; rfl
        rw [← h4, hu]
        rfl
      exact ⟨⟨b, b₀, hbb, (mul_comm _ _).trans hbb⟩, rfl⟩
    refine ⟨Ω, inferInstance, inferInstance, V, β.comp e,
      (IsLocalRing.ResidueField.map β).comp σ, hβinj.comp he, ?_⟩
    ext a
    simp only [RingHom.comp_apply]
    have h5 : φ a = evB (e a) := by
      simp only [e, RingHom.comp_apply, hevB, ev]
      exact (MvPolynomial.eval₂Hom_C φ _ a).symm
    rw [h5, hσ, IsLocalRing.ResidueField.map_residue]

  intro k _ X₁ P _ _ sP _ f _ U hU hUsm hgc
  refine ⟨U, hU, hUsm, ?_⟩
  apply wcgcs_geomConnected_restrict_of_points X₁ P f U
  intro K _ t ht W fst snd hW

  have ht' := Scheme.Spec_stalkClosedPointTo_fromSpecStalk t
  set s := t (IsLocalRing.closedPoint K) with hs
  have hsU : s ∈ U := ht ⟨_, rfl⟩
  obtain ⟨φ, hφ⟩ : ∃ φ : ↑(P.presheaf.stalk s) →+* K,
      CommRingCat.ofHom φ = Scheme.stalkClosedPointTo t := ⟨(Scheme.stalkClosedPointTo t).hom, rfl⟩
  have htφ : Spec.map (CommRingCat.ofHom φ) ≫ P.fromSpecStalk s = t := by
    rw [hφ]; exact ht'

  obtain ⟨Ω, _, _, V, ι, ψ, hι, hcomm⟩ :=
    wcgcs_valuation_dominating (↑(P.presheaf.stalk s)) K φ

  obtain ⟨gV, hgV⟩ : ∃ g : Spec (.of V) ⟶ P,
      g = Spec.map (CommRingCat.ofHom ι) ≫ P.fromSpecStalk s := ⟨_, rfl⟩
  obtain ⟨gΩ, hgΩ⟩ : ∃ g : Spec (.of Ω) ⟶ P,
      g = Spec.map (CommRingCat.ofHom V.subtype) ≫ gV := ⟨_, rfl⟩
  have hgΩeq : Spec.map (CommRingCat.ofHom (V.subtype.comp ι)) ≫ P.fromSpecStalk s = gΩ := by
    rw [hgΩ, hgV, CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc]

  have hgVU : Set.range gV ⊆ (U : Set P) := by
    intro y hy
    obtain ⟨z, rfl⟩ := hy
    have hmem : gV z ∈ Set.range (P.fromSpecStalk s) := by
      rw [hgV]
      exact ⟨_, (Scheme.Hom.comp_apply _ _ z).symm⟩
    rw [Scheme.range_fromSpecStalk] at hmem
    exact Specializes.mem_open hmem U.isOpen hsU
  have hgΩU : Set.range gΩ ⊆ (U : Set P) := by
    intro y hy
    obtain ⟨z, rfl⟩ := hy
    rw [hgΩ]
    exact hgVU ⟨_, (Scheme.Hom.comp_apply _ _ z).symm⟩

  haveI hsmV : SmoothOfRelativeDimension 1 (Limits.pullback.snd f gV) :=
    wcgcs_smooth_base_change_into_open X₁ P _ f U gV hgVU hUsm
  haveI : Smooth (Limits.pullback.snd f gV) := SmoothOfRelativeDimension.smooth 1 _
  haveI : Flat (Limits.pullback.snd f gV) := inferInstance
  have hsmΩ : SmoothOfRelativeDimension 1 (Limits.pullback.snd f gΩ) :=
    wcgcs_smooth_base_change_into_open X₁ P _ f U gΩ hgΩU hUsm

  haveI : HenselianLocalRing V := wcgcs_valuationSubring_henselian Ω V
  have h1 := wc_proper_henselian_fibre_trace_connected V _ (Limits.pullback.snd f gV)

  have hinj : Function.Injective (V.subtype.comp ι) := fun a b h => hι (Subtype.ext h)
  have hgen : gΩ (IsLocalRing.closedPoint Ω) = genericPoint P := by
    rw [← hgΩeq]
    exact wcgcs_injective_stalk_point_generic P s Ω (V.subtype.comp ι) hinj
  have hirr := wcgcs_geom_generic_fibre_irreducible X₁ P f hgc Ω gΩ hgen hsmΩ
  rw [hgΩ] at hirr

  have hconn := wcgcs_closed_fibre_connected X₁ P f V gV h1 Ω V.subtype
    (fun a b h => Subtype.ext h) hirr

  have e1 : Spec.map (CommRingCat.ofHom ψ) ≫ t =
      Spec.map (CommRingCat.ofHom (ψ.comp φ)) ≫ P.fromSpecStalk s := by
    rw [CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc, htφ]
  have e2 : Spec.map (CommRingCat.ofHom (IsLocalRing.residue V)) ≫ gV =
      Spec.map (CommRingCat.ofHom ((IsLocalRing.residue V).comp ι)) ≫ P.fromSpecStalk s := by
    rw [hgV, CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc]
  have hres : Spec.map (CommRingCat.ofHom ψ) ≫ t =
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue V)) ≫ gV := by
    rw [e1, e2, hcomm]

  exact wcgcs_connected_of_field_extension X₁ P W f K _ ψ t _ fst snd hW hres hconn

theorem wcpa_dj_curve_fibration : ∀ (k : Type u) [Field k] [Finite k] (X : Scheme.{u})
    [AlgebraicGeometry.IsIntegral X] (sX : X ⟶ Spec (.of k)) [IsProper sX] (d : ℕ),
    topologicalKrullDim X = ((d + 1 : ℕ) : WithBot ℕ∞) →
    ∃ (X₁ P : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral X₁) (_ : AlgebraicGeometry.IsIntegral P)
      (α : X₁ ⟶ X) (sP : P ⟶ Spec (.of k)) (f : X₁ ⟶ P),
      f ≫ sP = α ≫ sX ∧ wcpaDjIsProjOver k (α ≫ sX) ∧ wcpaDjIsProjOver k sP ∧
      IsProper α ∧ Surjective α ∧ (∃ V : X.Opens, V ≠ ⊥ ∧ IsFinite (α ∣_ V)) ∧
      topologicalKrullDim P = (d : WithBot ℕ∞) ∧
      ∃ U : P.Opens, U ≠ ⊥ ∧ SmoothOfRelativeDimension 1 (f ∣_ U) ∧
        GeometricallyConnected (f ∣_ U) :=
by
  intro k _ _ X _ sX _ d hX

  obtain ⟨X', iX', α₀, hP0, hα₀p, hα₀s, hα₀f⟩ := wcpa_dj_cf_chow_projective k X sX
  haveI := iX'
  haveI := hα₀p
  haveI hsX' : IsProper (α₀ ≫ sX) := wcpa_dj_proj_proper k _ hP0
  have hX' : topologicalKrullDim X' = ((d + 1 : ℕ) : WithBot ℕ∞) :=
    (wcpa_dj_alteration_dim_eq k X' X (α₀ ≫ sX) sX α₀ rfl hα₀s hα₀f).trans hX

  obtain ⟨Γ, Q, iΓ, iQ, α₁, sQ, g, hg, hPΓ, hPQ, hα₁p, hα₁s, hα₁f, hQd, hGI, hGR⟩ :=
    wcpa_dj_cf_separable_projection k X' (α₀ ≫ sX) d hP0 hX'
  haveI := iΓ
  haveI := iQ
  haveI := hα₁p
  haveI hsΓ : IsProper (α₁ ≫ α₀ ≫ sX) := wcpa_dj_proj_proper k _ hPΓ
  have hΓd : topologicalKrullDim Γ = ((d + 1 : ℕ) : WithBot ℕ∞) :=
    (wcpa_dj_alteration_dim_eq k Γ X' (α₁ ≫ α₀ ≫ sX) (α₀ ≫ sX) α₁ rfl hα₁s hα₁f).trans hX'
  have hPΓ' : wcpaDjIsProjOver k (g ≫ sQ) := by rw [hg]; exact hPΓ

  obtain ⟨X₁, P, iX₁, iP, α₂, sP, f, hf, hPX₁, hPP, hα₂p, hα₂s, hα₂f, hPd, hsm, hgc⟩ :=
    wcpa_dj_cf_smooth_generic_fibre k Γ Q sQ g d hPΓ' hPQ hQd hΓd hGI hGR
  haveI := iX₁
  haveI := iP
  haveI := hα₂p
  have heq : f ≫ sP = (α₂ ≫ α₁ ≫ α₀) ≫ sX := by
    rw [hf, hg]; simp only [Category.assoc]
  have hproj : wcpaDjIsProjOver k ((α₂ ≫ α₁ ≫ α₀) ≫ sX) := by
    rw [← heq, hf]; exact hPX₁
  have h10p : IsProper (α₁ ≫ α₀) := inferInstance
  obtain ⟨h10s, h10f⟩ := wcpa_dj_alteration_comp (X := X) (Y := X') α₀ α₁ hα₀p hα₀s hα₁s hα₀f hα₁f
  obtain ⟨hαs, hαf⟩ :=
    wcpa_dj_alteration_comp (X := X) (Y := Γ) (α₁ ≫ α₀) α₂ h10p h10s hα₂s h10f hα₂f
  have hαp : IsProper (α₂ ≫ α₁ ≫ α₀) := inferInstance

  haveI hsPp : IsProper sP := wcpa_dj_proj_proper k sP hPP
  haveI hfsP : IsProper (f ≫ sP) := by
    rw [hf]; exact wcpa_dj_proj_proper k _ hPX₁
  haveI hfp : IsProper f := IsProper.of_comp f sP

  obtain ⟨U, hU, hUsm⟩ := wcpa_dj_cf_smooth_spread k X₁ P sP f hsm
  obtain ⟨U', hU', hU'sm, hU'gc⟩ := wcpa_dj_cf_geom_connected_spread k X₁ P sP f U hU hUsm hgc
  exact ⟨X₁, P, iX₁, iP, α₂ ≫ α₁ ≫ α₀, sP, f, heq, hproj, hPP, hαp, hαs, hαf, hPd,
    U', hU', hU'sm, hU'gc⟩

theorem wcpa_dj_gsfp_chart_facts : ∀ (K : Type u) [Field K] (n : ℕ), (∀ J : Fin (n + 1), IsAffineOpen (wcSgD K n J)) ∧ ∀ (J L j : Fin (n + 1)), wcSgE K n J J = 1 ∧ (wcProjK K n).basicOpen (wcSgE K n J L) = wcSgD K n J ⊓ wcSgD K n L ∧ (wcProjK K n).presheaf.map (homOfLE (inf_le_left : wcSgD K n J ⊓ wcSgD K n L ≤ wcSgD K n J)).op (wcSgE K n J j) = (wcProjK K n).presheaf.map (homOfLE (inf_le_left : wcSgD K n J ⊓ wcSgD K n L ≤ wcSgD K n J)).op (wcSgE K n J L) * (wcProjK K n).presheaf.map (homOfLE (inf_le_right : wcSgD K n J ⊓ wcSgD K n L ≤ wcSgD K n L)).op (wcSgE K n L j) :=
by
  have L1 : ∀ {σ : Type u} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ) [GradedRing 𝒜] (f g : A) (hf : f ∈ 𝒜 1) (hg : g ∈ 𝒜 1), Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g = (Proj 𝒜).basicOpen (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) := by
    intro σ A _ _ _ 𝒜 _ f g hf hg
    have ha : HomogeneousLocalization.Away.isLocalizationElem hf hg =
        HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg := by
      apply HomogeneousLocalization.val_injective
      simp [HomogeneousLocalization.Away.val_mk]
    have hb : (Proj.basicOpen 𝒜 f).ι ⁻¹ᵁ Proj.basicOpen 𝒜 g =
        (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg) := by
      have h1 := Proj.awayι_preimage_basicOpen 𝒜 hf Nat.one_pos hg Nat.one_pos
      rw [← Proj.basicOpenIsoSpec_inv_ι, Scheme.Hom.comp_preimage, ha] at h1
      rw [← h1, ← Scheme.Hom.comp_preimage, Iso.hom_inv_id, Scheme.Hom.id_preimage]
    have hd : (Proj 𝒜).basicOpen (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) =
        (Proj.basicOpen 𝒜 f).ι ''ᵁ ((Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) := by
      have hsp := basicOpen_eq_of_affine (R := CommRingCat.of (HomogeneousLocalization.Away 𝒜 f))
        (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)
      have h3 : (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg) =
          (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          (Spec _).basicOpen ((Scheme.ΓSpecIso _).inv (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) :=
        congrArg (fun V => (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ V) hsp.symm
      rw [h3, ← Scheme.Opens.ι_image_basicOpen_topIso_inv, Scheme.preimage_basicOpen_top]
      congr 2
      rw [Proj.basicOpenIsoSpec_hom]
      change _ = ConcreteCategory.hom (Scheme.Hom.app (Proj.basicOpenToSpec 𝒜 f) ⊤) _
      rw [Proj.basicOpenToSpec_app_top]
      exact congrArg (fun y => ConcreteCategory.hom (Proj.basicOpen 𝒜 f).topIso.inv
        (ConcreteCategory.hom (Proj.awayToSection 𝒜 f) y))
        (Iso.inv_hom_id_apply (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 f)))
          (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)).symm
    rw [hd, ← hb, Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
  have L2 : ∀ {σ : Type u} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ) [GradedRing 𝒜] (f g h : A) (hf : f ∈ 𝒜 1) (hg : g ∈ 𝒜 1) (hh : h ∈ 𝒜 1), (Proj 𝒜).presheaf.map (homOfLE (inf_le_left : Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 f)).op (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 h hh)) = (Proj 𝒜).presheaf.map (homOfLE (inf_le_left : Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 f)).op (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) * (Proj 𝒜).presheaf.map (homOfLE (inf_le_right : Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 g)).op (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 1 h hh)) := by
    intro σ A _ _ _ 𝒜 _ f g h hf hg hh
    have key : ∀ (W : (Proj 𝒜).Opens) (_ : W = Proj.basicOpen 𝒜 (f * g))
        (h₁ : W ≤ Proj.basicOpen 𝒜 f) (h₂ : W ≤ Proj.basicOpen 𝒜 g),
        (Proj 𝒜).presheaf.map (homOfLE h₁).op
            (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 h hh)) =
          (Proj 𝒜).presheaf.map (homOfLE h₁).op
            (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) *
          (Proj 𝒜).presheaf.map (homOfLE h₂).op
            (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 1 h hh)) := by
      rintro W rfl h₁ h₂
      have e1 : ∀ a, (Proj 𝒜).presheaf.map (homOfLE h₁).op (Proj.awayToSection 𝒜 f a) =
          Proj.awayToSection 𝒜 (f * g) (HomogeneousLocalization.awayMap 𝒜 hg rfl a) := by
        intro a
        have := ConcreteCategory.congr_hom
          (Proj.awayMap_awayToSection 𝒜 hg (rfl : f * g = f * g)) a
        exact this.symm
      have e2 : ∀ b, (Proj 𝒜).presheaf.map (homOfLE h₂).op (Proj.awayToSection 𝒜 g b) =
          Proj.awayToSection 𝒜 (f * g) (HomogeneousLocalization.awayMap 𝒜 hf (mul_comm f g) b) := by
        intro b
        have := ConcreteCategory.congr_hom
          (Proj.awayMap_awayToSection 𝒜 (f := g) hf (mul_comm f g)) b
        exact this.symm
      rw [e1, e1, e2, ← map_mul]
      congr 1
      rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
        HomogeneousLocalization.awayMap_mk]
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
        HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
        Localization.mk_mul, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      refine ⟨1, ?_⟩
      simp only [Submonoid.coe_mul, pow_one, OneMemClass.coe_one, one_mul]
      ring
    exact key _ (Proj.basicOpen_mul 𝒜 f g).symm _ _
  intro K _ n
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) := MvPolynomial.gradedAlgebra
  have hX : ∀ k : Fin (n + 1), (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 1 := fun k =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)
  refine ⟨fun J => Proj.isAffineOpen_basicOpen _ (MvPolynomial.X J) (hX J) Nat.one_pos, ?_⟩
  intro J L j
  refine ⟨?_, ?_, ?_⟩
  · have h1 : HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX J) 1
        (MvPolynomial.X J) (hX J) = 1 := by
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one,
        ← Localization.mk_one, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      exact ⟨1, by simp⟩
    show Proj.awayToSection _ _ _ = 1
    rw [h1, map_one]
  · exact (L1 _ (MvPolynomial.X J) (MvPolynomial.X L) (hX J) (hX L)).symm
  · exact L2 _ (MvPolynomial.X J) (MvPolynomial.X L) (MvPolynomial.X j) (hX J) (hX L) (hX j)

theorem wcpa_dj_gsfp_proj_up : ∀ (K : Type u) [Field K] (n : ℕ) (X : Scheme.{u}) (fX : X ⟶ Spec (.of K)) {I : Type} (U : I → X.Opens), (⨆ i, U i) = ⊤ → ∀ (s : ∀ i, Fin (n + 1) → Γ(X, U i)), (∀ i, Ideal.span (Set.range (s i)) = ⊤) → ∀ (w : ∀ i j, Γ(X, U i ⊓ U j)), (∀ i j, IsUnit (w i j)) → (∀ i j J, X.presheaf.map (homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).op (s j J) = w i j * X.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op (s i J)) → ∃ φ : X ⟶ wcProjK K n, φ ≫ wcProjKStr K n = fX ∧ (∀ i J, φ ⁻¹ᵁ wcSgD K n J ⊓ U i = X.basicOpen (s i J)) ∧ ∀ i J L (O : X.Opens) (hO : O ≤ φ ⁻¹ᵁ wcSgD K n J) (hOi : O ≤ U i), φ.appLE (wcSgD K n J) O hO (wcSgE K n J L) * X.presheaf.map (homOfLE hOi).op (s i J) = X.presheaf.map (homOfLE hOi).op (s i L) :=
by
  intro K _ n X fX I U hU s hs w hw htr
  exact wc_projK_glue_local_coords K n X fX U hU s hs w hw htr

theorem wcpa_dj_gsfp_pre_tuples : ∀ (K : Type u) [Field K] (N : ℕ) {X : Scheme.{u}} (b : X ⟶ wcProjK K N), IsFinite b → (∀ J : Fin (N + 1), IsAffineOpen (wcSgD K N J)) → (∀ (J L j : Fin (N + 1)), wcSgE K N J J = 1 ∧ (wcProjK K N).basicOpen (wcSgE K N J L) = wcSgD K N J ⊓ wcSgD K N L ∧ (wcProjK K N).presheaf.map (homOfLE (inf_le_left : wcSgD K N J ⊓ wcSgD K N L ≤ wcSgD K N J)).op (wcSgE K N J j) = (wcProjK K N).presheaf.map (homOfLE (inf_le_left : wcSgD K N J ⊓ wcSgD K N L ≤ wcSgD K N J)).op (wcSgE K N J L) * (wcProjK K N).presheaf.map (homOfLE (inf_le_right : wcSgD K N J ⊓ wcSgD K N L ≤ wcSgD K N L)).op (wcSgE K N L j)) → ∃ (E r : ℕ) (γ : ∀ l : Fin (N + 1), Fin (N + 1) → Fin r → Γ(X, b ⁻¹ᵁ wcSgD K N l)), 1 ≤ E ∧ (∀ (l : Fin (N + 1)) (t : Γ(X, b ⁻¹ᵁ wcSgD K N l)), t ∈ Subring.closure (Set.range (b.app (wcSgD K N l)) ∪ Set.range (γ l l))) ∧ ∀ (i l : Fin (N + 1)) (j' : Fin r), X.presheaf.map (homOfLE (inf_le_right : b ⁻¹ᵁ wcSgD K N i ⊓ b ⁻¹ᵁ wcSgD K N l ≤ b ⁻¹ᵁ wcSgD K N l)).op (γ l i j') = (X.presheaf.map (homOfLE (inf_le_right : b ⁻¹ᵁ wcSgD K N i ⊓ b ⁻¹ᵁ wcSgD K N l ≤ b ⁻¹ᵁ wcSgD K N l)).op (b.app (wcSgD K N l) (wcSgE K N l i))) ^ E * X.presheaf.map (homOfLE (inf_le_left : b ⁻¹ᵁ wcSgD K N i ⊓ b ⁻¹ᵁ wcSgD K N l ≤ b ⁻¹ᵁ wcSgD K N i)).op (γ i i j') :=
by
  classical

  have t_inter : ∀ {X Y : Scheme.{u}} (b : X ⟶ Y) (D D' : Y.Opens) (e : Γ(Y, D)),
      Y.basicOpen e = D ⊓ D' → b ⁻¹ᵁ D' ⊓ b ⁻¹ᵁ D = X.basicOpen (b.app D e) := by
    intro X Y b D D' e h
    rw [inf_comm, ← Scheme.Hom.preimage_inf, ← h, Scheme.preimage_basicOpen]

  have t_gens : ∀ (n : ℕ) (A B : Fin (n + 1) → CommRingCat.{u}) (φ : ∀ l, A l ⟶ B l),
      (∀ l, (φ l).hom.Finite) → ∃ (r : ℕ) (g : ∀ l, Fin r → B l), ∀ (l : Fin (n + 1)) (t : B l),
        t ∈ Subring.closure (Set.range (φ l) ∪ Set.range (g l)) := by
    intro n A B φ hφ
    have key : ∀ l, ∃ (m : ℕ) (s : Fin m → B l), ∀ t : B l,
        t ∈ Subring.closure (Set.range (φ l) ∪ Set.range s) := by
      intro l
      letI : Algebra (A l) (B l) := (φ l).hom.toAlgebra
      have hfin : Module.Finite (A l) (B l) := hφ l
      obtain ⟨m, s, hs⟩ := Module.Finite.exists_fin (R := A l) (M := B l)
      refine ⟨m, s, fun t => ?_⟩
      have h1 : t ∈ Algebra.adjoin (A l) (Set.range s) := by
        apply Algebra.span_le_adjoin
        rw [hs]; trivial
      have h2 : t ∈ (Algebra.adjoin (A l) (Set.range s)).toSubring := h1
      rw [Algebra.adjoin_eq_ring_closure] at h2
      exact h2
    choose m s hs using key
    refine ⟨Finset.univ.sup m, fun l j => if h : j.val < m l then s l ⟨j.val, h⟩ else 0, ?_⟩
    intro l t
    refine Subring.closure_mono (Set.union_subset_union_right _ ?_) (hs l t)
    rintro _ ⟨k, rfl⟩
    have hle : m l ≤ Finset.univ.sup m := Finset.le_sup (Finset.mem_univ l)
    refine ⟨⟨k.val, lt_of_lt_of_le k.isLt hle⟩, ?_⟩
    simp [k.isLt]

  have t_pole : ∀ {X : Scheme.{u}} (U V W : X.Opens) (hWU : W ≤ U) (hWV : W ≤ V),
      IsAffineOpen U → ∀ (f : Γ(X, U)), W = X.basicOpen f → ∀ (z : Γ(X, V)),
      ∃ (n : ℕ) (a : Γ(X, U)),
        X.presheaf.map (homOfLE hWV).op z * (X.presheaf.map (homOfLE hWU).op f) ^ n =
          X.presheaf.map (homOfLE hWU).op a := by
    intro X U V W hWU hWV hU f hW z
    letI : Algebra Γ(X, U) Γ(X, W) := (X.presheaf.map (homOfLE hWU).op).hom.toAlgebra
    have := hU.isLocalization_of_eq_basicOpen f (homOfLE hWU) hW
    obtain ⟨n, a, h⟩ := IsLocalization.Away.surj f (X.presheaf.map (homOfLE hWV).op z)
    exact ⟨n, a, h⟩

  have t_uniform : ∀ (n r : ℕ) (B : Fin (n + 1) → Type u) [∀ l, CommRing (B l)]
      (C : Fin (n + 1) → Fin (n + 1) → Type u) [∀ i l, CommRing (C i l)]
      (ρR : ∀ i l, B l →+* C i l) (ρL : ∀ i l, B i →+* C i l) (ε : ∀ l, Fin (n + 1) → B l)
      (g : ∀ l, Fin r → B l), (∀ l, ρR l l = ρL l l) → (∀ l, ε l l = 1) →
      (∀ (i l : Fin (n + 1)) (z : B i), ∃ (m : ℕ) (a : B l),
        ρL i l z * (ρR i l (ε l i)) ^ m = ρR i l a) →
      ∃ (E : ℕ) (γ : ∀ l, Fin (n + 1) → Fin r → B l), 1 ≤ E ∧ (∀ l, γ l l = g l) ∧
        ∀ (i l : Fin (n + 1)) (j' : Fin r),
          ρR i l (γ l i j') = (ρR i l (ε l i)) ^ E * ρL i l (γ i i j') := by
    intro n r B _ C _ ρR ρL ε g hρ hε hpole
    choose m a ha using fun i l j' => hpole i l (g i j')
    obtain ⟨E, hE⟩ : ∃ E : ℕ, E = 1 + Finset.univ.sup
        (fun p : Fin (n + 1) × Fin (n + 1) × Fin r => m p.1 p.2.1 p.2.2) := ⟨_, rfl⟩
    have hmE : ∀ i l j', m i l j' ≤ E := by
      intro i l j'
      have : m i l j' ≤ Finset.univ.sup
          (fun p : Fin (n + 1) × Fin (n + 1) × Fin r => m p.1 p.2.1 p.2.2) :=
        Finset.le_sup (f := fun p : Fin (n + 1) × Fin (n + 1) × Fin r => m p.1 p.2.1 p.2.2)
          (Finset.mem_univ (i, l, j'))
      omega
    refine ⟨E, fun l i j' => if i = l then g l j' else ε l i ^ (E - m i l j') * a i l j',
      by omega, ?_, ?_⟩
    · intro l; funext j'; simp
    · intro i l j'
      by_cases hil : i = l
      · subst hil
        simp only [ite_true, hε, map_one, one_pow, one_mul, hρ]
      · simp only [hil, ite_false, ite_true, map_mul, map_pow]
        rw [← ha i l j']
        calc ρR i l (ε l i) ^ (E - m i l j') * (ρL i l (g i j') * ρR i l (ε l i) ^ m i l j')
            = ρL i l (g i j') * ρR i l (ε l i) ^ (E - m i l j' + m i l j') := by ring
          _ = _ := by rw [Nat.sub_add_cancel (hmE i l j')]; ring

  intro K _ N X b hb haff hcf
  haveI := hb
  obtain ⟨r, g, hgen⟩ := t_gens N (fun l => Γ(wcProjK K N, wcSgD K N l))
    (fun l => Γ(X, b ⁻¹ᵁ wcSgD K N l)) (fun l => b.app (wcSgD K N l))
    (fun l => IsFinite.finite_app b _ (haff l))
  obtain ⟨E, γ, hE, hdiag, hrel⟩ := t_uniform N r (fun l => (Γ(X, b ⁻¹ᵁ wcSgD K N l) : Type u))
    (fun i l => (Γ(X, b ⁻¹ᵁ wcSgD K N i ⊓ b ⁻¹ᵁ wcSgD K N l) : Type u))
    (fun i l => (X.presheaf.map (homOfLE (inf_le_right : b ⁻¹ᵁ wcSgD K N i ⊓ b ⁻¹ᵁ wcSgD K N l ≤
      b ⁻¹ᵁ wcSgD K N l)).op).hom)
    (fun i l => (X.presheaf.map (homOfLE (inf_le_left : b ⁻¹ᵁ wcSgD K N i ⊓ b ⁻¹ᵁ wcSgD K N l ≤
      b ⁻¹ᵁ wcSgD K N i)).op).hom)
    (fun l i => b.app (wcSgD K N l) (wcSgE K N l i)) g (fun l => rfl)
    (fun l => by
      show b.app (wcSgD K N l) (wcSgE K N l l) = 1
      rw [(hcf l l l).1, map_one])
    (fun i l z => t_pole (b ⁻¹ᵁ wcSgD K N l) (b ⁻¹ᵁ wcSgD K N i)
      (b ⁻¹ᵁ wcSgD K N i ⊓ b ⁻¹ᵁ wcSgD K N l) inf_le_right inf_le_left ((haff l).preimage b)
      (b.app (wcSgD K N l) (wcSgE K N l i))
      (t_inter b (wcSgD K N l) (wcSgD K N i) (wcSgE K N l i) (hcf l i l).2.1) z)
  refine ⟨E, r, γ, hE, fun l t => ?_, fun i l j' => hrel i l j'⟩
  rw [hdiag l]
  exact hgen l t

theorem wcpa_dj_gsfp_fix_tuples : ∀ (K : Type u) [Field K] (N : ℕ) {X : Scheme.{u}} (b : X ⟶ wcProjK K N) (E r : ℕ) (γ : ∀ l : Fin (N + 1), Fin (N + 1) → Fin r → Γ(X, b ⁻¹ᵁ wcSgD K N l)), IsFinite b → (∀ J : Fin (N + 1), IsAffineOpen (wcSgD K N J)) → (∀ (J L j : Fin (N + 1)), wcSgE K N J J = 1 ∧ (wcProjK K N).basicOpen (wcSgE K N J L) = wcSgD K N J ⊓ wcSgD K N L ∧ (wcProjK K N).presheaf.map (homOfLE (inf_le_left : wcSgD K N J ⊓ wcSgD K N L ≤ wcSgD K N J)).op (wcSgE K N J j) = (wcProjK K N).presheaf.map (homOfLE (inf_le_left : wcSgD K N J ⊓ wcSgD K N L ≤ wcSgD K N J)).op (wcSgE K N J L) * (wcProjK K N).presheaf.map (homOfLE (inf_le_right : wcSgD K N J ⊓ wcSgD K N L ≤ wcSgD K N L)).op (wcSgE K N L j)) → 1 ≤ E → (∀ (i l : Fin (N + 1)) (j' : Fin r), X.presheaf.map (homOfLE (inf_le_right : b ⁻¹ᵁ wcSgD K N i ⊓ b ⁻¹ᵁ wcSgD K N l ≤ b ⁻¹ᵁ wcSgD K N l)).op (γ l i j') = (X.presheaf.map (homOfLE (inf_le_right : b ⁻¹ᵁ wcSgD K N i ⊓ b ⁻¹ᵁ wcSgD K N l ≤ b ⁻¹ᵁ wcSgD K N l)).op (b.app (wcSgD K N l) (wcSgE K N l i))) ^ E * X.presheaf.map (homOfLE (inf_le_left : b ⁻¹ᵁ wcSgD K N i ⊓ b ⁻¹ᵁ wcSgD K N l ≤ b ⁻¹ᵁ wcSgD K N i)).op (γ i i j')) → ∃ (E' : ℕ) (γ' : ∀ l : Fin (N + 1), Fin (N + 1) → Fin r → Γ(X, b ⁻¹ᵁ wcSgD K N l)), 1 ≤ E' ∧ (∀ (l : Fin (N + 1)) (j' : Fin r), γ' l l j' = γ l l j') ∧ ∀ (i j i' : Fin (N + 1)) (j' : Fin r), X.presheaf.map (homOfLE (inf_le_right : b ⁻¹ᵁ wcSgD K N i ⊓ b ⁻¹ᵁ wcSgD K N j ≤ b ⁻¹ᵁ wcSgD K N j)).op (γ' j i' j') = (X.presheaf.map (homOfLE (inf_le_right : b ⁻¹ᵁ wcSgD K N i ⊓ b ⁻¹ᵁ wcSgD K N j ≤ b ⁻¹ᵁ wcSgD K N j)).op (b.app (wcSgD K N j) (wcSgE K N j i))) ^ E' * X.presheaf.map (homOfLE (inf_le_left : b ⁻¹ᵁ wcSgD K N i ⊓ b ⁻¹ᵁ wcSgD K N j ≤ b ⁻¹ᵁ wcSgD K N i)).op (γ' i i' j') :=
by
  have hgen : ∀ {X P : Scheme.{u}} (n : ℕ) (D : Fin (n + 1) → P.Opens)
      (e : ∀ _J _L : Fin (n + 1), Γ(P, D _J)) (b : X ⟶ P) (E r : ℕ)
      (γ : ∀ l : Fin (n + 1), Fin (n + 1) → Fin r → Γ(X, b ⁻¹ᵁ D l)),
      IsFinite b → (∀ J, IsAffineOpen (D J)) →
      (∀ (J L j : Fin (n + 1)), e J J = 1 ∧ P.basicOpen (e J L) = D J ⊓ D L ∧
        P.presheaf.map (homOfLE (inf_le_left : D J ⊓ D L ≤ D J)).op (e J j) =
          P.presheaf.map (homOfLE (inf_le_left : D J ⊓ D L ≤ D J)).op (e J L) *
          P.presheaf.map (homOfLE (inf_le_right : D J ⊓ D L ≤ D L)).op (e L j)) →
      1 ≤ E →
      (∀ (i l : Fin (n + 1)) (j' : Fin r),
        X.presheaf.map (homOfLE (inf_le_right : b ⁻¹ᵁ D i ⊓ b ⁻¹ᵁ D l ≤ b ⁻¹ᵁ D l)).op (γ l i j') =
          (X.presheaf.map (homOfLE (inf_le_right : b ⁻¹ᵁ D i ⊓ b ⁻¹ᵁ D l ≤ b ⁻¹ᵁ D l)).op
            (b.app (D l) (e l i))) ^ E *
          X.presheaf.map (homOfLE (inf_le_left : b ⁻¹ᵁ D i ⊓ b ⁻¹ᵁ D l ≤ b ⁻¹ᵁ D i)).op
            (γ i i j')) →
      ∃ (E' : ℕ) (γ' : ∀ l : Fin (n + 1), Fin (n + 1) → Fin r → Γ(X, b ⁻¹ᵁ D l)), 1 ≤ E' ∧
        (∀ (l : Fin (n + 1)) (j' : Fin r), γ' l l j' = γ l l j') ∧
        ∀ (i j i' : Fin (n + 1)) (j' : Fin r),
          X.presheaf.map (homOfLE (inf_le_right : b ⁻¹ᵁ D i ⊓ b ⁻¹ᵁ D j ≤ b ⁻¹ᵁ D j)).op
              (γ' j i' j') =
            (X.presheaf.map (homOfLE (inf_le_right : b ⁻¹ᵁ D i ⊓ b ⁻¹ᵁ D j ≤ b ⁻¹ᵁ D j)).op
              (b.app (D j) (e j i))) ^ E' *
            X.presheaf.map (homOfLE (inf_le_left : b ⁻¹ᵁ D i ⊓ b ⁻¹ᵁ D j ≤ b ⁻¹ᵁ D i)).op
              (γ' i i' j') := by
    intro X P n D e b E r γ hb haff hcf hE hrel
    classical
    haveI := hb
    have hU : ∀ l, IsAffineOpen (b ⁻¹ᵁ D l) := fun l => (haff l).preimage b

    have hres : ∀ {A B C : X.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (x : Γ(X, A)),
        X.presheaf.map (homOfLE h2).op (X.presheaf.map (homOfLE h1).op x) =
          X.presheaf.map (homOfLE (h2.trans h1)).op x := by
      intro A B C h1 h2 x
      rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
      rfl

    have hcoc : ∀ (j i i' : Fin (n + 1)) (O : X.Opens) (h1 : O ≤ b ⁻¹ᵁ D j)
        (h2 : O ≤ b ⁻¹ᵁ D i),
        X.presheaf.map (homOfLE h1).op (b.app (D j) (e j i')) =
          X.presheaf.map (homOfLE h1).op (b.app (D j) (e j i)) *
            X.presheaf.map (homOfLE h2).op (b.app (D i) (e i i')) := by
      intro j i i' O h1 h2
      have hO : O ≤ b ⁻¹ᵁ (D j ⊓ D i) := by
        rw [Scheme.Hom.preimage_inf]; exact le_inf h1 h2
      have key : ∀ (V : P.Opens) (hV : D j ⊓ D i ≤ V) (hV' : O ≤ b ⁻¹ᵁ V) (x : Γ(P, V)),
          X.presheaf.map (homOfLE hV').op (b.app V x) =
            b.appLE (D j ⊓ D i) O hO (P.presheaf.map (homOfLE hV).op x) := by
        intro V hV hV' x
        rw [← ConcreteCategory.comp_apply, ← ConcreteCategory.comp_apply, Scheme.Hom.map_appLE]
        rfl
      rw [key (D j) inf_le_left h1, key (D j) inf_le_left h1, key (D i) inf_le_right h2,
        ← map_mul, (hcf j i i').2.2]

    have hbo0 : ∀ (j i' : Fin (n + 1)),
        X.basicOpen (b.app (D j) (e j i')) = b ⁻¹ᵁ D j ⊓ b ⁻¹ᵁ D i' := by
      intro j i'
      rw [← Scheme.preimage_basicOpen, (hcf j i' j).2.1, Scheme.Hom.preimage_inf]
    have hbo : ∀ (j i' : Fin (n + 1)) (O : X.Opens) (h : O ≤ b ⁻¹ᵁ D j),
        X.basicOpen (X.presheaf.map (homOfLE h).op (b.app (D j) (e j i'))) =
          O ⊓ b ⁻¹ᵁ D i' := by
      intro j i' O h
      rw [Scheme.basicOpen_res, hbo0, ← inf_assoc, inf_eq_left.mpr h]

    have hrelO : ∀ (i l : Fin (n + 1)) (j' : Fin r) (O : X.Opens) (hl : O ≤ b ⁻¹ᵁ D l)
        (hi : O ≤ b ⁻¹ᵁ D i),
        X.presheaf.map (homOfLE hl).op (γ l i j') =
          (X.presheaf.map (homOfLE hl).op (b.app (D l) (e l i))) ^ E *
            X.presheaf.map (homOfLE hi).op (γ i i j') := by
      intro i l j' O hl hi
      have h := congrArg (fun x => X.presheaf.map (homOfLE (le_inf hi hl)).op x) (hrel i l j')
      simp only [map_mul, map_pow] at h
      rw [hres, hres, hres] at h
      exact h

    have hkill : ∀ (i j i' : Fin (n + 1)) (j' : Fin r), ∃ m : ℕ,
        (X.presheaf.map (homOfLE (inf_le_right : b ⁻¹ᵁ D i ⊓ b ⁻¹ᵁ D j ≤ b ⁻¹ᵁ D j)).op
          (b.app (D j) (e j i'))) ^ m *
        (X.presheaf.map (homOfLE (inf_le_right : b ⁻¹ᵁ D i ⊓ b ⁻¹ᵁ D j ≤ b ⁻¹ᵁ D j)).op
            (γ j i' j') -
          (X.presheaf.map (homOfLE (inf_le_right : b ⁻¹ᵁ D i ⊓ b ⁻¹ᵁ D j ≤ b ⁻¹ᵁ D j)).op
            (b.app (D j) (e j i))) ^ E *
          X.presheaf.map (homOfLE (inf_le_left : b ⁻¹ᵁ D i ⊓ b ⁻¹ᵁ D j ≤ b ⁻¹ᵁ D i)).op
            (γ i i' j')) = 0 := by
      intro i j i' j'
      have hW : IsAffineOpen (b ⁻¹ᵁ D i ⊓ b ⁻¹ᵁ D j) := by
        have := (hU j).basicOpen (b.app (D j) (e j i))
        rwa [hbo0 j i, inf_comm] at this
      refine exists_pow_mul_eq_zero_of_res_basicOpen_eq_zero_of_isAffineOpen X hW _ _ ?_
      have hW' := hbo j i' (b ⁻¹ᵁ D i ⊓ b ⁻¹ᵁ D j) inf_le_right
      have hWj : X.basicOpen (X.presheaf.map (homOfLE (inf_le_right :
          b ⁻¹ᵁ D i ⊓ b ⁻¹ᵁ D j ≤ b ⁻¹ᵁ D j)).op (b.app (D j) (e j i'))) ≤ b ⁻¹ᵁ D j := by
        rw [hW']; exact inf_le_left.trans inf_le_right
      have hWi : X.basicOpen (X.presheaf.map (homOfLE (inf_le_right :
          b ⁻¹ᵁ D i ⊓ b ⁻¹ᵁ D j ≤ b ⁻¹ᵁ D j)).op (b.app (D j) (e j i'))) ≤ b ⁻¹ᵁ D i := by
        rw [hW']; exact inf_le_left.trans inf_le_left
      have hWi' : X.basicOpen (X.presheaf.map (homOfLE (inf_le_right :
          b ⁻¹ᵁ D i ⊓ b ⁻¹ᵁ D j ≤ b ⁻¹ᵁ D j)).op (b.app (D j) (e j i'))) ≤ b ⁻¹ᵁ D i' := by
        rw [hW']; exact inf_le_right
      show X.presheaf.map (homOfLE (X.basicOpen_le _)).op _ = 0
      rw [map_sub, map_mul, map_pow, hres, hres, hres, hrelO i' j j' _ hWj hWi',
        hrelO i' i j' _ hWi hWi', hcoc j i i' _ hWj hWi]
      ring

    choose m hm using hkill
    obtain ⟨n₀, hle⟩ : ∃ n₀ : ℕ, ∀ i j i' j', m i j i' j' ≤ n₀ :=
      ⟨Finset.univ.sup (fun t : Fin (n + 1) × Fin (n + 1) × Fin (n + 1) × Fin r =>
          m t.1 t.2.1 t.2.2.1 t.2.2.2),
        fun i j i' j' => Finset.le_sup
          (f := fun t : Fin (n + 1) × Fin (n + 1) × Fin (n + 1) × Fin r =>
            m t.1 t.2.1 t.2.2.1 t.2.2.2) (Finset.mem_univ (i, j, i', j'))⟩
    refine ⟨E + n₀, fun l i' j' => (b.app (D l) (e l i')) ^ n₀ * γ l i' j', by omega, ?_, ?_⟩
    · intro l j'
      dsimp only
      rw [(hcf l l l).1, map_one, one_pow, one_mul]
    · intro i j i' j'
      dsimp only
      obtain ⟨k, hk⟩ := Nat.exists_eq_add_of_le (hle i j i' j')
      have h := hm i j i' j'
      simp only [map_mul, map_pow]
      rw [hcoc j i i' _ inf_le_right inf_le_left] at h ⊢
      rw [hk]
      linear_combination
        (X.presheaf.map (homOfLE (inf_le_right : b ⁻¹ᵁ D i ⊓ b ⁻¹ᵁ D j ≤ b ⁻¹ᵁ D j)).op
            (b.app (D j) (e j i)) *
          X.presheaf.map (homOfLE (inf_le_left : b ⁻¹ᵁ D i ⊓ b ⁻¹ᵁ D j ≤ b ⁻¹ᵁ D i)).op
            (b.app (D i) (e i i'))) ^ k * h
  intro K _ N X b E r γ hb haff hcf hE hrel
  exact hgen N (wcSgD K N) (wcSgE K N) b E r γ hb haff hcf hE hrel

theorem wcpa_dj_gsfp_glue : ∀ (K : Type u) [Field K] (N : ℕ) {X : Scheme.{u}} (b : X ⟶ wcProjK K N) (E r : ℕ) (γ : ∀ l : Fin (N + 1), Fin (N + 1) → Fin r → Γ(X, b ⁻¹ᵁ wcSgD K N l)), 1 ≤ E → (⨆ a : Fin (N + 1), wcSgD K N a) = ⊤ → (∀ (J L j : Fin (N + 1)), wcSgE K N J J = 1 ∧ (wcProjK K N).basicOpen (wcSgE K N J L) = wcSgD K N J ⊓ wcSgD K N L ∧ (wcProjK K N).presheaf.map (homOfLE (inf_le_left : wcSgD K N J ⊓ wcSgD K N L ≤ wcSgD K N J)).op (wcSgE K N J j) = (wcProjK K N).presheaf.map (homOfLE (inf_le_left : wcSgD K N J ⊓ wcSgD K N L ≤ wcSgD K N J)).op (wcSgE K N J L) * (wcProjK K N).presheaf.map (homOfLE (inf_le_right : wcSgD K N J ⊓ wcSgD K N L ≤ wcSgD K N L)).op (wcSgE K N L j)) → (∀ (n : ℕ) (X : Scheme.{u}) (fX : X ⟶ Spec (.of K)) {I : Type} (U : I → X.Opens), (⨆ i, U i) = ⊤ → ∀ (s : ∀ i, Fin (n + 1) → Γ(X, U i)), (∀ i, Ideal.span (Set.range (s i)) = ⊤) → ∀ (w : ∀ i j, Γ(X, U i ⊓ U j)), (∀ i j, IsUnit (w i j)) → (∀ i j J, X.presheaf.map (homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).op (s j J) = w i j * X.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op (s i J)) → ∃ φ : X ⟶ wcProjK K n, φ ≫ wcProjKStr K n = fX ∧ (∀ i J, φ ⁻¹ᵁ wcSgD K n J ⊓ U i = X.basicOpen (s i J)) ∧ ∀ i J L (O : X.Opens) (hO : O ≤ φ ⁻¹ᵁ wcSgD K n J) (hOi : O ≤ U i), φ.appLE (wcSgD K n J) O hO (wcSgE K n J L) * X.presheaf.map (homOfLE hOi).op (s i J) = X.presheaf.map (homOfLE hOi).op (s i L)) → (∀ (i j i' : Fin (N + 1)) (j' : Fin r), X.presheaf.map (homOfLE (inf_le_right : b ⁻¹ᵁ wcSgD K N i ⊓ b ⁻¹ᵁ wcSgD K N j ≤ b ⁻¹ᵁ wcSgD K N j)).op (γ j i' j') = (X.presheaf.map (homOfLE (inf_le_right : b ⁻¹ᵁ wcSgD K N i ⊓ b ⁻¹ᵁ wcSgD K N j ≤ b ⁻¹ᵁ wcSgD K N j)).op (b.app (wcSgD K N j) (wcSgE K N j i))) ^ E * X.presheaf.map (homOfLE (inf_le_left : b ⁻¹ᵁ wcSgD K N i ⊓ b ⁻¹ᵁ wcSgD K N j ≤ b ⁻¹ᵁ wcSgD K N i)).op (γ i i' j')) → ∃ (M : ℕ) (ψ : X ⟶ wcProjK K M) (J0 : Fin (N + 1) → Fin (M + 1)) (hψ : ∀ l, b ⁻¹ᵁ wcSgD K N l ≤ ψ ⁻¹ᵁ wcSgD K M (J0 l)), ψ ≫ wcProjKStr K M = b ≫ wcProjKStr K N ∧ (∀ l, ψ ⁻¹ᵁ wcSgD K M (J0 l) = b ⁻¹ᵁ wcSgD K N l) ∧ (∀ (l m : Fin (N + 1)), ∃ L, ψ.appLE (wcSgD K M (J0 l)) (b ⁻¹ᵁ wcSgD K N l) (hψ l) (wcSgE K M (J0 l) L) = b.app (wcSgD K N l) (wcSgE K N l m)) ∧ ∀ (l : Fin (N + 1)) (j' : Fin r), ∃ L, ψ.appLE (wcSgD K M (J0 l)) (b ⁻¹ᵁ wcSgD K N l) (hψ l) (wcSgE K M (J0 l) L) = γ l l j' :=
by
  intro K _ N X b E r γ hE hcov HS HUP hrel
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le' hE

  have hresA : ∀ (D : (wcProjK K N).Opens) (A : X.Opens) (hA : A ≤ b ⁻¹ᵁ D)
      (x : Γ(wcProjK K N, D)),
      X.presheaf.map (homOfLE hA).op (b.app D x) = b.appLE D A hA x := by
    intro D A hA x
    rw [Scheme.Hom.app_eq_appLE, ← CategoryTheory.comp_apply, Scheme.Hom.appLE_map]
  have hid : ∀ (A : X.Opens) (y : Γ(X, A)), X.presheaf.map (homOfLE (le_refl A)).op y = y := by
    intro A y
    change (X.presheaf.map (𝟙 (Opposite.op A))) y = y
    rw [CategoryTheory.Functor.map_id]
    rfl

  have cocyc : ∀ (J L : Fin (N + 1)) (W : X.Opens)
      (hJ : W ≤ b ⁻¹ᵁ wcSgD K N J) (hL : W ≤ b ⁻¹ᵁ wcSgD K N L),
      (∀ j, b.appLE (wcSgD K N J) W hJ (wcSgE K N J j) =
        b.appLE (wcSgD K N J) W hJ (wcSgE K N J L) * b.appLE (wcSgD K N L) W hL (wcSgE K N L j)) ∧
      b.appLE (wcSgD K N J) W hJ (wcSgE K N J L) * b.appLE (wcSgD K N L) W hL (wcSgE K N L J) = 1 := by
    intro J L W hJ hL
    have hMle : W ≤ b ⁻¹ᵁ (wcSgD K N J ⊓ wcSgD K N L) := by
      rw [Scheme.Hom.preimage_inf]
      exact le_inf hJ hL
    have K1 : ∀ x, b.appLE (wcSgD K N J) W hJ x = b.appLE _ W hMle
        ((wcProjK K N).presheaf.map
          (homOfLE (inf_le_left : wcSgD K N J ⊓ wcSgD K N L ≤ wcSgD K N J)).op x) := by
      intro x
      rw [← CategoryTheory.comp_apply, Scheme.Hom.map_appLE]
    have K2 : ∀ x, b.appLE (wcSgD K N L) W hL x = b.appLE _ W hMle
        ((wcProjK K N).presheaf.map
          (homOfLE (inf_le_right : wcSgD K N J ⊓ wcSgD K N L ≤ wcSgD K N L)).op x) := by
      intro x
      rw [← CategoryTheory.comp_apply, Scheme.Hom.map_appLE]
    have hc : ∀ j, b.appLE (wcSgD K N J) W hJ (wcSgE K N J j) =
        b.appLE (wcSgD K N J) W hJ (wcSgE K N J L) *
          b.appLE (wcSgD K N L) W hL (wcSgE K N L j) := by
      intro j
      rw [K1 (wcSgE K N J j), K1 (wcSgE K N J L), K2 (wcSgE K N L j), (HS J L j).2.2, map_mul]
    refine ⟨hc, ?_⟩
    rw [← hc J, (HS J L J).1, map_one]

  have hMeq : (N + 1) * (N + 1) + (N + 1) * r = N * (N + 1) + N + (N + 1) * r + 1 := by ring
  obtain ⟨M, ⟨e⟩⟩ : ∃ M : ℕ,
      Nonempty ((Fin (N + 1) × Fin (N + 1)) ⊕ (Fin (N + 1) × Fin r) ≃ Fin (M + 1)) :=
    ⟨_, ⟨(Equiv.sumCongr finProdFinEquiv finProdFinEquiv).trans
      (finSumFinEquiv.trans (finCongr hMeq))⟩⟩

  obtain ⟨s, ev1, ev2⟩ : ∃ s : ∀ l : Fin (N + 1), Fin (M + 1) → Γ(X, b ⁻¹ᵁ wcSgD K N l),
      (∀ l a c, s l (e (Sum.inl (a, c))) =
        b.app (wcSgD K N l) (wcSgE K N l a) * b.app (wcSgD K N l) (wcSgE K N l c) ^ k) ∧
      (∀ l i' j', s l (e (Sum.inr (i', j'))) = γ l i' j') :=
    ⟨fun l J => Sum.elim
      (fun p : Fin (N + 1) × Fin (N + 1) =>
        b.app (wcSgD K N l) (wcSgE K N l p.1) * b.app (wcSgD K N l) (wcSgE K N l p.2) ^ k)
      (fun q : Fin (N + 1) × Fin r => γ l q.1 q.2) (e.symm J),
     fun l a c => by simp only [Equiv.symm_apply_apply, Sum.elim_inl],
     fun l i' j' => by simp only [Equiv.symm_apply_apply, Sum.elim_inr]⟩
  have hone : ∀ l, b.app (wcSgD K N l) (wcSgE K N l l) = 1 := fun l => by
    rw [(HS l l l).1, map_one]
  have hs1 : ∀ l, s l (e (Sum.inl (l, l))) = 1 := fun l => by
    rw [ev1, hone, one_pow, one_mul]
  have hbasic : ∀ i l, X.basicOpen (s i (e (Sum.inl (l, l)))) =
      b ⁻¹ᵁ wcSgD K N i ⊓ b ⁻¹ᵁ wcSgD K N l := by
    intro i l
    rw [ev1, ← pow_succ', Scheme.basicOpen_pow _ _ (Nat.succ_pos k), ← Scheme.preimage_basicOpen,
      (HS i l i).2.1, Scheme.Hom.preimage_inf]

  have hU : (⨆ l, b ⁻¹ᵁ wcSgD K N l) = ⊤ := by
    rw [← Scheme.Hom.preimage_iSup, hcov, Scheme.Hom.preimage_top]
  have hspan : ∀ l, Ideal.span (Set.range (s l)) = ⊤ := fun l =>
    Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span ⟨e (Sum.inl (l, l)), rfl⟩)
      (by rw [hs1 l]; exact isUnit_one)
  have hw : ∀ i j, IsUnit ((b.appLE (wcSgD K N j) (b ⁻¹ᵁ wcSgD K N i ⊓ b ⁻¹ᵁ wcSgD K N j)
      inf_le_right (wcSgE K N j i)) ^ (k + 1)) := by
    intro i j
    have h1 := (cocyc j i (b ⁻¹ᵁ wcSgD K N i ⊓ b ⁻¹ᵁ wcSgD K N j) inf_le_right inf_le_left).2
    exact (isUnit_iff_exists_inv.mpr ⟨_, h1⟩).pow _
  have htrans : ∀ i j J, X.presheaf.map (homOfLE (inf_le_right :
      b ⁻¹ᵁ wcSgD K N i ⊓ b ⁻¹ᵁ wcSgD K N j ≤ b ⁻¹ᵁ wcSgD K N j)).op (s j J) =
      (b.appLE (wcSgD K N j) (b ⁻¹ᵁ wcSgD K N i ⊓ b ⁻¹ᵁ wcSgD K N j)
        inf_le_right (wcSgE K N j i)) ^ (k + 1) *
      X.presheaf.map (homOfLE (inf_le_left :
        b ⁻¹ᵁ wcSgD K N i ⊓ b ⁻¹ᵁ wcSgD K N j ≤ b ⁻¹ᵁ wcSgD K N i)).op (s i J) := by
    intro i j J
    obtain ⟨t, rfl⟩ := e.surjective J
    rcases t with ⟨a, c⟩ | ⟨i', j'⟩
    · rw [ev1, ev1]
      simp only [map_mul, map_pow, hresA]
      rw [(cocyc j i _ inf_le_right inf_le_left).1 a, (cocyc j i _ inf_le_right inf_le_left).1 c]
      ring
    · rw [ev2, ev2, hrel i j i' j', hresA]

  obtain ⟨ψ, G1, G2, G3⟩ := HUP M X (b ≫ wcProjKStr K N) (fun l => b ⁻¹ᵁ wcSgD K N l) hU s hspan
    (fun i j => (b.appLE (wcSgD K N j) (b ⁻¹ᵁ wcSgD K N i ⊓ b ⁻¹ᵁ wcSgD K N j)
      inf_le_right (wcSgE K N j i)) ^ (k + 1)) hw htrans
  have hpre : ∀ l, ψ ⁻¹ᵁ wcSgD K M (e (Sum.inl (l, l))) = b ⁻¹ᵁ wcSgD K N l := by
    intro l
    calc ψ ⁻¹ᵁ wcSgD K M (e (Sum.inl (l, l)))
        = ψ ⁻¹ᵁ wcSgD K M (e (Sum.inl (l, l))) ⊓ ⨆ i, b ⁻¹ᵁ wcSgD K N i := by
          rw [hU, inf_top_eq]
      _ = ⨆ i, ψ ⁻¹ᵁ wcSgD K M (e (Sum.inl (l, l))) ⊓ b ⁻¹ᵁ wcSgD K N i := inf_iSup_eq _ _
      _ = ⨆ i, b ⁻¹ᵁ wcSgD K N i ⊓ b ⁻¹ᵁ wcSgD K N l :=
          iSup_congr (fun i => (G2 i _).trans (hbasic i l))
      _ = (⨆ i, b ⁻¹ᵁ wcSgD K N i) ⊓ b ⁻¹ᵁ wcSgD K N l := (iSup_inf_eq _ _).symm
      _ = b ⁻¹ᵁ wcSgD K N l := by rw [hU, top_inf_eq]
  have hco : ∀ l L (h : b ⁻¹ᵁ wcSgD K N l ≤ ψ ⁻¹ᵁ wcSgD K M (e (Sum.inl (l, l)))),
      ψ.appLE (wcSgD K M (e (Sum.inl (l, l)))) (b ⁻¹ᵁ wcSgD K N l) h
        (wcSgE K M (e (Sum.inl (l, l))) L) = s l L := by
    intro l L h
    have h3 := G3 l (e (Sum.inl (l, l))) L (b ⁻¹ᵁ wcSgD K N l) h le_rfl
    rw [hs1, map_one, mul_one, hid] at h3
    exact h3
  refine ⟨M, ψ, fun l => e (Sum.inl (l, l)), fun l => (hpre l).ge, G1, hpre, ?_, ?_⟩
  · intro l m
    exact ⟨e (Sum.inl (m, l)),
      (hco l (e (Sum.inl (m, l))) _).trans (by rw [ev1, hone, one_pow, mul_one])⟩
  · intro l j'
    exact ⟨e (Sum.inr (l, j')), (hco l (e (Sum.inr (l, j'))) _).trans (ev2 l l j')⟩

theorem wcpa_dj_gsfp_chart_surj : ∀ (K : Type u) [Field K] (N M : ℕ) {X : Scheme.{u}} (b : X ⟶ wcProjK K N) (ψ : X ⟶ wcProjK K M) (l : Fin (N + 1)) (J : Fin (M + 1)) (hψ : b ⁻¹ᵁ wcSgD K N l ≤ ψ ⁻¹ᵁ wcSgD K M J) (G : Set Γ(X, b ⁻¹ᵁ wcSgD K N l)), ψ ≫ wcProjKStr K M = b ≫ wcProjKStr K N → (∀ x : Γ(wcProjK K N, wcSgD K N l), x ∈ Subring.closure (Set.range (wcSgE K N l) ∪ Set.range (fun c : K => (wcProjK K N).presheaf.map (homOfLE (le_top : wcSgD K N l ≤ ⊤)).op ((wcProjKStr K N).appTop ((Scheme.ΓSpecIso (.of K)).inv c))))) → (∀ t : Γ(X, b ⁻¹ᵁ wcSgD K N l), t ∈ Subring.closure (Set.range (b.app (wcSgD K N l)) ∪ G)) → (∀ m : Fin (N + 1), ∃ c, ψ.appLE (wcSgD K M J) (b ⁻¹ᵁ wcSgD K N l) hψ c = b.app (wcSgD K N l) (wcSgE K N l m)) → (∀ g ∈ G, ∃ c, ψ.appLE (wcSgD K M J) (b ⁻¹ᵁ wcSgD K N l) hψ c = g) → ∀ t : Γ(X, b ⁻¹ᵁ wcSgD K N l), ∃ c, ψ.appLE (wcSgD K M J) (b ⁻¹ᵁ wcSgD K N l) hψ c = t :=
by
  intro K _ N M X b ψ l J hψ G H1 H2 H3 H4 H5
  have hconst : ∀ {W P : Scheme.{u}} (h : W ⟶ P) (U : P.Opens) (V : W.Opens) (e : V ≤ h ⁻¹ᵁ U)
      (x : Γ(P, ⊤)),
      h.appLE U V e (P.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op x) =
        W.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op (h.appTop x) := by
    intro W P h U V e x
    rw [← CategoryTheory.comp_apply, Scheme.Hom.map_appLE]
    rfl
  have hphi : ∀ x : Γ(wcProjK K N, wcSgD K N l),
      ∃ c, ψ.appLE (wcSgD K M J) (b ⁻¹ᵁ wcSgD K N l) hψ c = b.app (wcSgD K N l) x := by
    intro x
    have hle := (Subring.closure_le
      (t := ((ψ.appLE (wcSgD K M J) (b ⁻¹ᵁ wcSgD K N l) hψ).hom.range.comap
        (b.app (wcSgD K N l)).hom))
      (s := Set.range (wcSgE K N l) ∪ Set.range (fun c : K => (wcProjK K N).presheaf.map
        (homOfLE (le_top : wcSgD K N l ≤ ⊤)).op
          ((wcProjKStr K N).appTop ((Scheme.ΓSpecIso (.of K)).inv c))))).mpr (by
      rintro _ (⟨m, rfl⟩ | ⟨c, rfl⟩)
      · exact Subring.mem_comap.mpr (RingHom.mem_range.mpr (H4 m))
      · refine Subring.mem_comap.mpr (RingHom.mem_range.mpr ⟨(wcProjK K M).presheaf.map
          (homOfLE (le_top : wcSgD K M J ≤ ⊤)).op
            ((wcProjKStr K M).appTop ((Scheme.ΓSpecIso (.of K)).inv c)), ?_⟩)
        have hqc : ψ.appTop ((wcProjKStr K M).appTop ((Scheme.ΓSpecIso (.of K)).inv c)) =
            b.appTop ((wcProjKStr K N).appTop ((Scheme.ΓSpecIso (.of K)).inv c)) := by
          have := congrArg (fun h => (Scheme.Hom.appTop h).hom ((Scheme.ΓSpecIso (.of K)).inv c)) H1
          simpa only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] using this
        show (ψ.appLE (wcSgD K M J) (b ⁻¹ᵁ wcSgD K N l) hψ) ((wcProjK K M).presheaf.map
            (homOfLE (le_top : wcSgD K M J ≤ ⊤)).op
              ((wcProjKStr K M).appTop ((Scheme.ΓSpecIso (.of K)).inv c))) =
          (b.app (wcSgD K N l)) ((wcProjK K N).presheaf.map
            (homOfLE (le_top : wcSgD K N l ≤ ⊤)).op
              ((wcProjKStr K N).appTop ((Scheme.ΓSpecIso (.of K)).inv c)))
        rw [Scheme.Hom.app_eq_appLE, hconst, hconst, hqc])
    exact RingHom.mem_range.mp (Subring.mem_comap.mp (hle (H2 x)))
  have hle2 := (Subring.closure_le
    (t := (ψ.appLE (wcSgD K M J) (b ⁻¹ᵁ wcSgD K N l) hψ).hom.range)
    (s := Set.range (b.app (wcSgD K N l)) ∪ G)).mpr (by
      rintro _ (⟨x, rfl⟩ | hg)
      · exact RingHom.mem_range.mpr (hphi x)
      · exact RingHom.mem_range.mpr (H5 _ hg))
  intro t
  exact RingHom.mem_range.mp (hle2 (H3 t))

theorem wcpa_dj_gsfp_closed_imm : ∀ (K : Type u) [Field K] (M : ℕ) {X : Scheme.{u}} (fX : X ⟶ Spec (.of K)) [IsProper fX] (ψ : X ⟶ wcProjK K M) {ι : Type} (U : ι → X.Opens) (J0 : ι → Fin (M + 1)) (hψ : ∀ l, U l ≤ ψ ⁻¹ᵁ wcSgD K M (J0 l)), IsSeparated (wcProjKStr K M) → (∀ J : Fin (M + 1), IsAffineOpen (wcSgD K M J)) → ψ ≫ wcProjKStr K M = fX → (⨆ l, U l) = ⊤ → (∀ l, ψ ⁻¹ᵁ wcSgD K M (J0 l) = U l) → (∀ l, IsAffineOpen (U l)) → (∀ l (t : Γ(X, U l)), ∃ c, ψ.appLE (wcSgD K M (J0 l)) (U l) (hψ l) c = t) → IsClosedImmersion ψ :=
by
  intro K _ M X fX _ ψ ι U J0 hψ hsep haff hcomp hcov hpre haffU hsurj
  haveI : IsProper (ψ ≫ wcProjKStr K M) := by rw [hcomp]; infer_instance
  haveI := hsep
  haveI : IsProper ψ := IsProper.of_comp ψ (wcProjKStr K M)
  have hcl : IsClosed (Set.range ψ) := ψ.isClosedMap.isClosed_range
  let O : (wcProjK K M).Opens := ⟨(Set.range ψ)ᶜ, hcl.isOpen_compl⟩
  let V' : Option ι → (wcProjK K M).Opens := fun o => o.elim O (fun l => wcSgD K M (J0 l))
  have hcov' : iSup V' = ⊤ := by
    rw [eq_top_iff]
    intro y _
    rw [TopologicalSpace.Opens.mem_iSup]
    by_cases hy : y ∈ Set.range ψ
    · obtain ⟨x, rfl⟩ := hy
      have hx : x ∈ ⨆ l, U l := by rw [hcov]; trivial
      obtain ⟨l, hl⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
      exact ⟨some l, hψ l hl⟩
    · exact ⟨none, hy⟩
  refine IsZariskiLocalAtTarget.of_iSup_eq_top (P := @IsClosedImmersion) V' hcov' ?_
  intro o
  cases o with
  | none =>
    haveI : IsEmpty (ψ ⁻¹ᵁ O).toScheme := ⟨fun x => x.2 ⟨x.1, rfl⟩⟩
    show IsClosedImmersion (ψ ∣_ O)
    infer_instance
  | some l =>
    show IsClosedImmersion (ψ ∣_ wcSgD K M (J0 l))
    have key : ∀ (W : X.Opens) (hW : W ≤ ψ ⁻¹ᵁ wcSgD K M (J0 l)), IsAffineOpen W →
        ψ ⁻¹ᵁ wcSgD K M (J0 l) = W →
        (∀ t : Γ(X, W), ∃ c, ψ.appLE (wcSgD K M (J0 l)) W hW c = t) →
        IsClosedImmersion (ψ ∣_ wcSgD K M (J0 l)) := by
      intro W hW hWa heq hs
      subst heq
      rw [← Scheme.Hom.resLE_eq_morphismRestrict]
      haveI : IsAffine (wcSgD K M (J0 l)) := haff (J0 l)
      haveI : IsAffine (ψ ⁻¹ᵁ wcSgD K M (J0 l)) := hWa
      refine IsClosedImmersion.of_surjective_of_isAffine _ ?_
      intro t
      obtain ⟨c, hc⟩ := hs ((ψ ⁻¹ᵁ wcSgD K M (J0 l)).topIso.hom t)
      refine ⟨(wcSgD K M (J0 l)).topIso.inv c, ?_⟩
      rw [Scheme.Hom.appTop, Scheme.Hom.resLE_app_top]
      rw [CommRingCat.comp_apply, CommRingCat.comp_apply, Iso.inv_hom_id_apply, hc,
        Iso.hom_inv_id_apply]
    exact key (U l) (hψ l) (haffU l) (hpre l) (hsurj l)

theorem wcpa_dj_gs_finite_proj : ∀ (k : Type u) [Field k] {X R : Scheme.{u}} (b : X ⟶ R) (sR : R ⟶ Spec (.of k)), IsFinite b → wcpaDjIsProjOver k sR → wcpaDjIsProjOver k (b ≫ sR) :=
by
  intro k _ X R b sR hb hR

  obtain ⟨N, j, hj, hjs⟩ := hR
  haveI := hb
  haveI := hj
  have hjs' : j ≫ wcProjKStr k N = sR := hjs
  have hb'f : IsFinite (b ≫ j) := inferInstance

  obtain ⟨haffN, hcfN⟩ := wcpa_dj_gsfp_chart_facts k N
  have hcov : (⨆ a : Fin (N + 1), wcSgD k N a) = ⊤ := wc_pp_basicOpen_cover k N

  obtain ⟨E, r, γ, hE, hgen, hrel⟩ := wcpa_dj_gsfp_pre_tuples k N (b ≫ j) hb'f haffN hcfN
  obtain ⟨E', γ', hE', hdiag, hrel'⟩ :=
    wcpa_dj_gsfp_fix_tuples k N (b ≫ j) E r γ hb'f haffN hcfN hE hrel
  obtain ⟨M, ψ, J0, hψ, hover, hpre, hcE, hcγ⟩ :=
    wcpa_dj_gsfp_glue k N (b ≫ j) E' r γ' hE' hcov hcfN (wcpa_dj_gsfp_proj_up k) hrel'

  have hsurj : ∀ l (t : Γ(X, (b ≫ j) ⁻¹ᵁ wcSgD k N l)),
      ∃ c, ψ.appLE (wcSgD k M (J0 l)) ((b ≫ j) ⁻¹ᵁ wcSgD k N l) (hψ l) c = t := by
    intro l
    refine wcpa_dj_gsfp_chart_surj k N M (b ≫ j) ψ l (J0 l) (hψ l) (Set.range (γ l l)) hover
      (wc_ldpi_oai_proj_gen k N l) (hgen l) (fun m => (hcE l m).elim fun L hL => ⟨_, hL⟩) ?_
    rintro _ ⟨j', rfl⟩
    obtain ⟨L, hL⟩ := hcγ l j'
    exact ⟨_, hL.trans (hdiag l j')⟩

  haveI : IsProper (wcProjKStr k N) := wc_proj_space_isProper k N
  haveI : IsProper (wcProjKStr k M) := wc_proj_space_isProper k M
  haveI : IsProper ((b ≫ j) ≫ wcProjKStr k N) := inferInstance
  have hU : (⨆ l, (b ≫ j) ⁻¹ᵁ wcSgD k N l) = ⊤ := by
    rw [← Scheme.Hom.preimage_iSup, hcov, Scheme.Hom.preimage_top]
  have haffU : ∀ l, IsAffineOpen ((b ≫ j) ⁻¹ᵁ wcSgD k N l) := fun l => (haffN l).preimage (b ≫ j)

  have hci := wcpa_dj_gsfp_closed_imm k M ((b ≫ j) ≫ wcProjKStr k N) ψ
    (fun l => (b ≫ j) ⁻¹ᵁ wcSgD k N l) J0 hψ inferInstance (wcpa_dj_gsfp_chart_facts k M).1
    hover hU hpre haffU hsurj
  refine ⟨M, ψ, hci, ?_⟩
  show ψ ≫ wcProjKStr k M = b ≫ sR
  rw [hover, Category.assoc, hjs']

theorem wcpa_dj_gs_proj_restrict : ∀ (k k' : Type u) [Field k] [Field k'] [Algebra k k'] [FiniteDimensional k k'] {Y : Scheme.{u}} (t : Y ⟶ Spec (.of k')), wcpaDjIsProjOver k' t → wcpaDjIsProjOver k (t ≫ Spec.map (CommRingCat.ofHom (algebraMap k k'))) :=
by
  intro k k' _ _ _ _ Y t ht
  obtain ⟨N, j, hj, hjt⟩ := ht
  obtain ⟨e, he, heq⟩ := wcpa_proj_base_change k k' N
  haveI := he
  haveI hBk : IsFinite (Spec.map (CommRingCat.ofHom (algebraMap k k'))) := by
    refine (IsFinite.SpecMap_iff _).mpr ?_
    rw [CommRingCat.hom_ofHom]
    exact RingHom.finite_algebraMap.mpr inferInstance
  haveI hfst : IsFinite (Limits.pullback.fst
      (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
          MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
            (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0))))
      (Spec.map (CommRingCat.ofHom (algebraMap k k')))) := inferInstance
  have hb : IsFinite (j ≫ inv e ≫ Limits.pullback.fst _ _) := inferInstance
  have hP : wcpaDjIsProjOver k
      (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
          MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
            (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)))) :=
    ⟨N, 𝟙 _, inferInstance, Category.id_comp _⟩
  have key := wcpa_dj_gs_finite_proj k _ _ hb hP
  have hcomp : (j ≫ inv e ≫ Limits.pullback.fst _ _) ≫
      (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
          MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
            (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)))) =
      t ≫ Spec.map (CommRingCat.ofHom (algebraMap k k')) := by
    rw [Category.assoc, Category.assoc, Limits.pullback.condition, ← heq, ← hjt]
    simp only [Category.assoc, IsIso.inv_hom_id_assoc]
  rw [hcomp] at key
  exact key

theorem wcpa_dj_gsgp_gep_graded_noether : ∀ (k : Type u) [Field k] (N n : ℕ) (Y : Scheme.{u}) (j : Y ⟶ wcProjK k N), IsClosedImmersion j → topologicalKrullDim Y ≤ (n : WithBot ℕ∞) → ∃ (D : ℕ) (θ : Fin (n + 1) → MvPolynomial (Fin (N + 1)) k), 0 < D ∧ (∀ i, (θ i).IsHomogeneous D) ∧ ∀ y : Y, ∃ i, j y ∈ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra (θ i) :=
by
  intro k _ N n Y j hj hdim
  classical
  letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
    MvPolynomial.gradedAlgebra

  have hPS : TopologicalSpace.NoetherianSpace
      (ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)) := by
    let f : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) →
        PrimeSpectrum (MvPolynomial (Fin (N + 1)) k) :=
      fun x => ⟨x.asHomogeneousIdeal.toIdeal, x.isPrime⟩
    have hf : Topology.IsInducing f := by
      rw [Topology.isInducing_iff]
      apply TopologicalSpace.ext_isClosed
      intro s
      refine (ProjectiveSpectrum.isClosed_iff_zeroLocus _ s).trans
        (Iff.trans ?_ isClosed_induced_iff.symm)
      constructor
      · rintro ⟨t, rfl⟩
        exact ⟨PrimeSpectrum.zeroLocus t, PrimeSpectrum.isClosed_zeroLocus t,
          Set.ext fun x => Iff.rfl⟩
      · rintro ⟨t, ht, rfl⟩
        obtain ⟨u, rfl⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus t).mp ht
        exact ⟨u, Set.ext fun x => Iff.rfl⟩
    exact hf.noetherianSpace
  haveI : TopologicalSpace.NoetherianSpace ↥(wcProjK k N) := hPS

  have hsucc : ∀ (X : Type u) [TopologicalSpace X] (Z W : Set X), IsIrreducible Z → IsClosed W →
      W ⊆ Z → W ≠ Z → ∀ m : ℕ, (m : WithBot ℕ∞) ≤ topologicalKrullDim ↥W →
      ((m + 1 : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim ↥Z := by
    intro X _ Z W hZ hW hWZ hne m hm
    have hm' : (m : WithBot ℕ∞) ≤ Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥W) := hm
    obtain ⟨p, hp⟩ := Order.le_krullDim_iff.mp hm'
    have hι : Topology.IsClosedEmbedding (Set.inclusion hWZ) :=
      Topology.IsClosedEmbedding.inclusion hWZ hW.preimage_val
    let φ : TopologicalSpace.IrreducibleCloseds ↥W → TopologicalSpace.IrreducibleCloseds ↥Z :=
      fun S => ⟨Set.inclusion hWZ '' (S : Set ↥W),
        S.isIrreducible.image _ hι.continuous.continuousOn, hι.isClosedMap _ S.isClosed⟩
    have hφ : StrictMono φ := by
      intro S T hST
      have h1 : (S : Set ↥W) ⊂ (T : Set ↥W) := SetLike.coe_ssubset_coe.mpr hST
      have h2 := (Set.inclusion_injective hWZ).image_strictMono h1
      exact SetLike.coe_ssubset_coe.mp h2
    haveI : IrreducibleSpace ↥Z := Subtype.irreducibleSpace hZ
    let top : TopologicalSpace.IrreducibleCloseds ↥Z :=
      ⟨Set.univ, IrreducibleSpace.isIrreducible_univ ↥Z, isClosed_univ⟩
    obtain ⟨z, hzZ, hzW⟩ : ∃ z ∈ Z, z ∉ W := by
      by_contra h
      push_neg at h
      exact hne (Set.Subset.antisymm hWZ h)
    have hlast : (p.map φ hφ).last < top := by
      rw [LTSeries.last_map]
      apply SetLike.coe_ssubset_coe.mp
      show Set.inclusion hWZ '' (p.last : Set ↥W) ⊂ Set.univ
      refine ⟨Set.subset_univ _, fun h => ?_⟩
      obtain ⟨w, _, hw⟩ := h (Set.mem_univ (⟨z, hzZ⟩ : ↥Z))
      apply hzW
      have h3 : (w : X) = z := congrArg Subtype.val hw
      exact h3 ▸ w.2
    show ((m + 1 : ℕ) : WithBot ℕ∞) ≤ Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥Z)
    exact Order.le_krullDim_iff.mpr ⟨(p.map φ hφ).snoc top hlast, by simp [hp]⟩
  have hE : ∀ (X : Type u) [TopologicalSpace X] (S : Set X), S = ∅ →
      topologicalKrullDim ↥S = ⊥ := by
    intro X _ S hS
    subst hS
    unfold topologicalKrullDim
    rw [Order.krullDim_eq_bot_iff]
    constructor
    intro Z
    obtain ⟨p, _⟩ := Z.isIrreducible.nonempty
    exact p.2
  have hN : ∀ (X : Type u) [TopologicalSpace X] (S : Set X),
      topologicalKrullDim ↥S < ((0 : ℕ) : WithBot ℕ∞) → S = ∅ := by
    intro X _ S hS
    by_contra hne
    obtain ⟨a, ha⟩ := Set.nonempty_iff_ne_empty.mpr hne
    haveI : Nonempty (TopologicalSpace.IrreducibleCloseds ↥S) :=
      ⟨⟨closure {(⟨a, ha⟩ : ↥S)}, isIrreducible_singleton.closure, isClosed_closure⟩⟩
    have h0 : (0 : WithBot ℕ∞) ≤ topologicalKrullDim ↥S := Order.krullDim_nonneg
    rw [Nat.cast_zero] at hS
    exact absurd hS (not_lt.mpr h0)
  have hunion : ∀ (X : Type u) [TopologicalSpace X] {ι : Type u} (s : Finset ι) (A : ι → Set X)
      (n : ℕ), (∀ i ∈ s, IsClosed (A i)) → (∀ i ∈ s, topologicalKrullDim ↥(A i) < (n : WithBot ℕ∞)) →
      topologicalKrullDim ↥(⋃ i ∈ s, A i) < (n : WithBot ℕ∞) := by
    intro X _ ι s A n hc hd
    have wc_union : ∀ (A B : Set X) (n : ℕ),
        IsClosed A → IsClosed B → topologicalKrullDim ↥A ≤ (n : WithBot ℕ∞) →
        topologicalKrullDim ↥B ≤ (n : WithBot ℕ∞) →
        topologicalKrullDim ↥(A ∪ B) ≤ (n : WithBot ℕ∞) := by
      intro A B n hAc hBc hA hB
      have key : ∀ (S T : Set X) (h : S ⊆ T) (Z : TopologicalSpace.IrreducibleCloseds ↥T),
          (∀ z ∈ (Z : Set ↥T), (z : X) ∈ S) →
          Order.krullDim ↑(Set.Iic Z) ≤ topologicalKrullDim ↥S := by
        intro S T h Z hZ
        have hlift : ∀ P : Set ↥T, (∀ p ∈ P, (p : X) ∈ S) →
            Set.inclusion h '' (Set.inclusion h ⁻¹' P) = P := by
          intro P hP
          apply Set.image_preimage_eq_of_subset
          intro p hp
          exact ⟨⟨p.1, hP p hp⟩, rfl⟩
        have hirr : ∀ W : Set ↥T, IsIrreducible W → (∀ w ∈ W, (w : X) ∈ S) →
            IsIrreducible (Set.inclusion h ⁻¹' W) := by
          intro W hW hWS
          refine ⟨?_, ?_⟩
          · obtain ⟨w, hw⟩ := hW.nonempty
            exact ⟨⟨w.1, hWS w hw⟩, hw⟩
          · rw [isPreirreducible_iff_isClosed_union_isClosed]
            intro z₁ z₂ hz₁ hz₂ hsub
            have hind := (Topology.IsEmbedding.inclusion h).isInducing
            obtain ⟨c₁, hc₁, rfl⟩ := hind.isClosed_iff.mp hz₁
            obtain ⟨c₂, hc₂, rfl⟩ := hind.isClosed_iff.mp hz₂
            have hW' : W ⊆ c₁ ∪ c₂ := by
              intro w hw
              have hmem : (⟨w.1, hWS w hw⟩ : ↥S) ∈ Set.inclusion h ⁻¹' W := hw
              exact hsub hmem
            rcases (isPreirreducible_iff_isClosed_union_isClosed.mp hW.isPreirreducible)
                c₁ c₂ hc₁ hc₂ hW' with h1 | h1
            · left; exact Set.preimage_mono h1
            · right; exact Set.preimage_mono h1
        have hsubZ : ∀ W : ↑(Set.Iic Z), (W.1 : Set ↥T) ⊆ (Z : Set ↥T) := fun W =>
          SetLike.coe_subset_coe.mpr W.2
        let Φ : ↑(Set.Iic Z) → TopologicalSpace.IrreducibleCloseds ↥S := fun W =>
          ⟨Set.inclusion h ⁻¹' (W.1 : Set ↥T),
            hirr _ W.1.isIrreducible (fun w hw => hZ w (hsubZ W hw)),
            W.1.isClosed.preimage (continuous_inclusion h)⟩
        have hmono : Monotone Φ := by
          intro W W' hle
          have hle' : (W.1 : Set ↥T) ⊆ (W'.1 : Set ↥T) := SetLike.coe_subset_coe.mpr hle
          exact SetLike.coe_subset_coe.mp (Set.preimage_mono hle' :
            Set.inclusion h ⁻¹' (W.1 : Set ↥T) ⊆ Set.inclusion h ⁻¹' (W'.1 : Set ↥T))
        have hinj : Function.Injective Φ := by
          intro W W' hWW
          have e1 : Set.inclusion h ⁻¹' (W.1 : Set ↥T) = Set.inclusion h ⁻¹' (W'.1 : Set ↥T) :=
            congrArg (fun V : TopologicalSpace.IrreducibleCloseds ↥S => (V : Set ↥S)) hWW
          have e2 : (W.1 : Set ↥T) = (W'.1 : Set ↥T) := by
            calc (W.1 : Set ↥T) = Set.inclusion h '' (Set.inclusion h ⁻¹' (W.1 : Set ↥T)) :=
                  (hlift _ (fun w hw => hZ w (hsubZ W hw))).symm
              _ = Set.inclusion h '' (Set.inclusion h ⁻¹' (W'.1 : Set ↥T)) := by rw [e1]
              _ = (W'.1 : Set ↥T) := hlift _ (fun w hw => hZ w (hsubZ W' hw))
          exact Subtype.ext (TopologicalSpace.IrreducibleCloseds.ext e2)
        exact Order.krullDim_le_of_strictMono Φ (hmono.strictMono_of_injective hinj)
      have hU : topologicalKrullDim ↥(A ∪ B) =
          Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥(A ∪ B)) := rfl
      rw [hU, Order.krullDim_eq_iSup_height]
      refine iSup_le (fun Z => ?_)
      rw [Order.height_eq_krullDim_Iic]
      have himg : IsIrreducible (Subtype.val '' (Z : Set ↥(A ∪ B))) :=
        Z.isIrreducible.image _ continuous_subtype_val.continuousOn
      have hcov : Subtype.val '' (Z : Set ↥(A ∪ B)) ⊆ A ∪ B := by
        rintro _ ⟨z, _, rfl⟩
        exact z.2
      rcases (isPreirreducible_iff_isClosed_union_isClosed.mp himg.isPreirreducible)
          A B hAc hBc hcov with hZA | hZB
      · exact (key A (A ∪ B) Set.subset_union_left Z
          (fun z hz => hZA (Set.mem_image_of_mem _ hz))).trans hA
      · exact (key B (A ∪ B) Set.subset_union_right Z
          (fun z hz => hZB (Set.mem_image_of_mem _ hz))).trans hB
    have hS : ∀ (m : ℕ) (x : WithBot ℕ∞),
        x < ((m + 1 : ℕ) : WithBot ℕ∞) ↔ x ≤ ((m : ℕ) : WithBot ℕ∞) := by
      intro m x
      induction x using WithBot.recBotCoe with
      | bot => simp
      | coe e =>
        rw [← WithBot.coe_natCast, ← WithBot.coe_natCast, WithBot.coe_lt_coe, WithBot.coe_le_coe,
          Nat.cast_add, Nat.cast_one]
        exact ENat.lt_add_one_iff (by simp)
    rcases n with _ | m
    · have hAe : ∀ i ∈ s, A i = ∅ := fun i hi => hN X _ (hd i hi)
      have hU : (⋃ i ∈ s, A i) = ∅ := by
        ext x
        simp only [Set.mem_iUnion, Set.mem_empty_iff_false, iff_false]
        rintro ⟨i, hi, hx⟩
        rw [hAe i hi] at hx
        exact hx
      rw [hE X _ hU]
      exact bot_lt_iff_ne_bot.mpr (WithBot.natCast_ne_bot _)
    · rw [hS m]
      have hd' : ∀ i ∈ s, topologicalKrullDim ↥(A i) ≤ ((m : ℕ) : WithBot ℕ∞) :=
        fun i hi => (hS m _).mp (hd i hi)
      clear hd
      revert hc hd'
      induction s using Finset.induction_on with
      | empty =>
        intro _ _
        rw [hE X _ (by simp)]
        exact bot_le
      | insert a t hat ih =>
        intro hc hd'
        rw [Finset.set_biUnion_insert]
        apply wc_union (A a) (⋃ x ∈ t, A x) m
        · exact hc a (Finset.mem_insert_self a t)
        · exact isClosed_biUnion_finset (fun i hi => hc i (Finset.mem_insert_of_mem hi))
        · exact hd' a (Finset.mem_insert_self a t)
        · exact ih (fun i hi => hc i (Finset.mem_insert_of_mem hi))
            (fun i hi => hd' i (Finset.mem_insert_of_mem hi))

  have hmem : ∀ (f : MvPolynomial (Fin (N + 1)) k) (x : ↥(wcProjK k N)),
      x ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) f ↔
        f ∉ x.asHomogeneousIdeal.toIdeal := by
    intro f x
    rw [Proj.mem_basicOpen]
    rfl

  have hX : ∀ x : ↥(wcProjK k N), ∃ c : Fin (N + 1), x ∈ Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (MvPolynomial.X c) := by
    intro x
    by_contra hx
    push_neg at hx
    apply x.not_irrelevant_le
    intro a ha
    have hi : ∀ i, MvPolynomial.X i ∈ x.asHomogeneousIdeal.toIdeal := fun i => by
      have := hx i
      rw [Proj.mem_basicOpen, not_not] at this
      exact HomogeneousIdeal.mem_iff.mpr this
    rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply] at ha
    have ha' : MvPolynomial.homogeneousComponent 0 a = 0 :=
      (MvPolynomial.decomposition.decompose'_apply a 0).symm.trans ha
    rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at ha'
    have hspan : a ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (N + 1)))) := by
      rw [MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      by_contra hc
      push_neg at hc
      have hm0 : m = 0 := Finsupp.ext fun i => hc i (Set.mem_univ i)
      rw [hm0] at hm
      exact (MvPolynomial.mem_support_iff.mp hm) ha'
    have hle : Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (N + 1)))) ≤
        x.asHomogeneousIdeal.toIdeal := by
      rw [Ideal.span_le]
      rintro _ ⟨i, _, rfl⟩
      exact hi i
    exact HomogeneousIdeal.mem_iff.mp (hle hspan)

  have havoid : ∀ F : Finset ↥(wcProjK k N), ∃ (e : ℕ) (f : MvPolynomial (Fin (N + 1)) k),
      0 < e ∧ f.IsHomogeneous e ∧ ∀ x ∈ F, f ∉ x.asHomogeneousIdeal.toIdeal := by
    intro F
    induction F using Finset.strongInduction with
    | H F ih =>
      rcases F.eq_empty_or_nonempty with hF | hF
      · refine ⟨1, MvPolynomial.X 0, one_pos, MvPolynomial.isHomogeneous_X k 0, ?_⟩
        intro x hx
        rw [hF] at hx
        exact absurd hx (Finset.notMem_empty x)
      · obtain ⟨J, hJ⟩ := Finset.exists_minimal
          (hF.image (fun x : ↥(wcProjK k N) => x.asHomogeneousIdeal.toIdeal))
        obtain ⟨r, hrF, hrJ⟩ := Finset.mem_image.mp hJ.prop
        have hmin : ∀ s ∈ F, s.asHomogeneousIdeal.toIdeal ≤ r.asHomogeneousIdeal.toIdeal →
            s.asHomogeneousIdeal.toIdeal = r.asHomogeneousIdeal.toIdeal := by
          intro s hs hle
          have h1 := hJ.eq_of_le (Finset.mem_image_of_mem
            (fun x : ↥(wcProjK k N) => x.asHomogeneousIdeal.toIdeal) hs) (hrJ ▸ hle)
          exact h1.trans hrJ.symm
        set F' := F.filter (fun s => s.asHomogeneousIdeal.toIdeal ≠ r.asHomogeneousIdeal.toIdeal)
          with hF'
        have hF'ss : F' ⊂ F := by
          refine Finset.ssubset_iff_subset_ne.mpr ⟨Finset.filter_subset _ _, fun h => ?_⟩
          have hr' : r ∈ F' := h ▸ hrF
          exact (Finset.mem_filter.mp hr').2 rfl
        obtain ⟨e, g, he, hg, hgF⟩ := ih F' hF'ss
        have hrest : ∀ (f : MvPolynomial (Fin (N + 1)) k), f ∉ r.asHomogeneousIdeal.toIdeal →
            (∀ x ∈ F', f ∉ x.asHomogeneousIdeal.toIdeal) →
            ∀ x ∈ F, f ∉ x.asHomogeneousIdeal.toIdeal := by
          intro f hfr hfF' x hx
          by_cases hxr : x.asHomogeneousIdeal.toIdeal = r.asHomogeneousIdeal.toIdeal
          · rw [hxr]; exact hfr
          · exact hfF' x (Finset.mem_filter.mpr ⟨hx, hxr⟩)
        by_cases hgr : g ∈ r.asHomogeneousIdeal.toIdeal
        · haveI hrp : r.asHomogeneousIdeal.toIdeal.IsPrime := r.isPrime
          obtain ⟨c, hc⟩ := hX r
          rw [hmem] at hc
          have hB : ∀ s ∈ F', ∃ (d : ℕ) (h : MvPolynomial (Fin (N + 1)) k), h.IsHomogeneous d ∧
              h ∈ s.asHomogeneousIdeal.toIdeal ∧ h ∉ r.asHomogeneousIdeal.toIdeal := by
            intro s hs
            obtain ⟨hsF, hsr⟩ := Finset.mem_filter.mp hs
            have hnle : ¬ s.asHomogeneousIdeal.toIdeal ≤ r.asHomogeneousIdeal.toIdeal :=
              fun hle => hsr (hmin s hsF hle)
            obtain ⟨a, has, har⟩ := SetLike.not_le_iff_exists.mp hnle
            by_contra hcon
            push_neg at hcon
            apply har
            rw [← MvPolynomial.sum_homogeneousComponent a]
            refine Ideal.sum_mem _ (fun i _ => ?_)
            refine hcon i _ (MvPolynomial.homogeneousComponent_isHomogeneous i a) ?_
            have h1 := s.asHomogeneousIdeal.isHomogeneous i has
            rw [← MvPolynomial.decomposition.decompose'_apply]
            exact h1
          choose! dd hh hhH hhs hhr using hB
          obtain ⟨H, hHdef⟩ : ∃ H : MvPolynomial (Fin (N + 1)) k,
              H = MvPolynomial.X c * ∏ s ∈ F', hh s := ⟨_, rfl⟩
          obtain ⟨b, hbdef⟩ : ∃ b : ℕ, b = 1 + ∑ s ∈ F', dd s := ⟨_, rfl⟩
          have hb : 0 < b := by omega
          have hHH : H.IsHomogeneous b := by
            rw [hHdef, hbdef]
            exact (MvPolynomial.isHomogeneous_X k c).mul
              (MvPolynomial.IsHomogeneous.prod _ _ _ hhH)
          have hHr : H ∉ r.asHomogeneousIdeal.toIdeal := by
            intro hm
            rw [hHdef] at hm
            rcases hrp.mem_or_mem hm with h1 | h1
            · exact hc h1
            · obtain ⟨s, hs, h2⟩ := Ideal.IsPrime.prod_mem_iff.mp h1
              exact hhr s hs h2
          have hHs : ∀ s ∈ F', H ∈ s.asHomogeneousIdeal.toIdeal := by
            intro s hs
            rw [hHdef]
            apply Ideal.mul_mem_left
            rw [← Finset.mul_prod_erase _ _ hs]
            exact Ideal.mul_mem_right _ _ (hhs s hs)
          refine ⟨e * b, g ^ b + H ^ e, Nat.mul_pos he hb, ?_, ?_⟩
          · have h1 := hg.pow b
            have h2 := hHH.pow e
            rw [mul_comm b e] at h2
            exact h1.add h2
          · apply hrest
            · intro hm
              have hgb : g ^ b ∈ r.asHomogeneousIdeal.toIdeal := Ideal.pow_mem_of_mem _ hgr b hb
              have h3 : H ^ e ∈ r.asHomogeneousIdeal.toIdeal := by
                have h4 := Ideal.sub_mem _ hm hgb
                rwa [add_sub_cancel_left] at h4
              exact hHr (hrp.mem_of_pow_mem e h3)
            · intro x hx hm
              haveI hxp : x.asHomogeneousIdeal.toIdeal.IsPrime := x.isPrime
              have hHe : H ^ e ∈ x.asHomogeneousIdeal.toIdeal :=
                Ideal.pow_mem_of_mem _ (hHs x hx) e he
              have h3 : g ^ b ∈ x.asHomogeneousIdeal.toIdeal := by
                have h4 := Ideal.sub_mem _ hm hHe
                rwa [add_sub_cancel_right] at h4
              exact hgF x hx (hxp.mem_of_pow_mem b h3)
        · exact ⟨e, g, he, hg, hrest g hgr hgF⟩

  have hcut : ∀ (m : ℕ) (S : Set ↥(wcProjK k N)), IsClosed S →
      topologicalKrullDim ↥S < ((m + 1 : ℕ) : WithBot ℕ∞) →
      ∃ (e : ℕ) (f : MvPolynomial (Fin (N + 1)) k), 0 < e ∧ f.IsHomogeneous e ∧
        topologicalKrullDim ↥(S ∩ (Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) f : Set ↥(wcProjK k N))ᶜ) <
          (m : WithBot ℕ∞) := by
    intro m S hS hSd
    obtain ⟨𝒮, h𝒮f, h𝒮c, h𝒮i, hS𝒮⟩ :=
      TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible hS
    have hpt : ∀ t ∈ 𝒮, ∃ p, p ∈ t := fun t ht => (h𝒮i t ht).nonempty
    choose pt hpt using hpt
    obtain ⟨e, f, he, hf, hfF⟩ := havoid (h𝒮f.toFinset.attach.image
      (fun t : {x // x ∈ h𝒮f.toFinset} => pt t.1 ((Set.Finite.mem_toFinset h𝒮f).mp t.2)))
    refine ⟨e, f, he, hf, ?_⟩
    have hVc : IsClosed (Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) f : Set ↥(wcProjK k N))ᶜ :=
      (Proj.basicOpen _ _).isOpen.isClosed_compl
    have hpiece : ∀ t ∈ 𝒮, IsClosed (t ∩ (Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) f : Set ↥(wcProjK k N))ᶜ) ∧
        topologicalKrullDim ↥(t ∩ (Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) f : Set ↥(wcProjK k N))ᶜ) <
          (m : WithBot ℕ∞) := by
      intro t ht
      have hWc := (h𝒮c t ht).inter hVc
      refine ⟨hWc, ?_⟩
      by_contra hlt
      rw [not_lt] at hlt
      have hne' : t ∩ (Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) f : Set ↥(wcProjK k N))ᶜ ≠ t := by
        intro heq
        have h1 : pt t ht ∈ t ∩ (Proj.basicOpen
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) f : Set ↥(wcProjK k N))ᶜ := by
          rw [heq]; exact hpt t ht
        apply h1.2
        refine (hmem f (pt t ht)).mpr (hfF (pt t ht) ?_)
        exact Finset.mem_image.mpr ⟨⟨t, (Set.Finite.mem_toFinset h𝒮f).mpr ht⟩,
          Finset.mem_attach _ _, rfl⟩
      have h1 := hsucc _ t _ (h𝒮i t ht) hWc Set.inter_subset_left hne' m hlt
      have hts : t ⊆ S := by rw [hS𝒮]; exact Set.subset_sUnion_of_mem ht
      have h2 : topologicalKrullDim ↥t ≤ topologicalKrullDim ↥S :=
        (Topology.IsEmbedding.inclusion hts).isInducing.topologicalKrullDim_le
      exact absurd (lt_of_le_of_lt (h1.trans h2) hSd) (lt_irrefl _)
    have hSeq : S ∩ (Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) f : Set ↥(wcProjK k N))ᶜ =
        ⋃ t ∈ h𝒮f.toFinset, (t ∩ (Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) f : Set ↥(wcProjK k N))ᶜ) := by
      ext x
      simp only [Set.mem_inter_iff, Set.mem_iUnion, Set.Finite.mem_toFinset, exists_prop]
      constructor
      · rintro ⟨hx, hv⟩
        rw [hS𝒮, Set.mem_sUnion] at hx
        obtain ⟨t, ht, hxt⟩ := hx
        exact ⟨t, ht, hxt, hv⟩
      · rintro ⟨t, ht, hxt, hv⟩
        refine ⟨?_, hv⟩
        rw [hS𝒮]
        exact Set.mem_sUnion_of_mem hxt ht
    rw [hSeq]
    exact hunion _ h𝒮f.toFinset _ m
      (fun t ht => (hpiece t ((Set.Finite.mem_toFinset h𝒮f).mp ht)).1)
      (fun t ht => (hpiece t ((Set.Finite.mem_toFinset h𝒮f).mp ht)).2)

  have hiter : ∀ (n : ℕ) (S : Set ↥(wcProjK k N)), IsClosed S →
      topologicalKrullDim ↥S < ((n + 1 : ℕ) : WithBot ℕ∞) →
      ∃ (e : Fin (n + 1) → ℕ) (φ : Fin (n + 1) → MvPolynomial (Fin (N + 1)) k),
        (∀ i, 0 < e i) ∧ (∀ i, (φ i).IsHomogeneous (e i)) ∧
        ∀ x ∈ S, ∃ i, x ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (φ i) := by
    intro n
    induction n with
    | zero =>
      intro S hS hSd
      obtain ⟨e, f, he, hf, hd⟩ := hcut 0 S hS hSd
      have h0 := hN _ _ hd
      refine ⟨fun _ => e, fun _ => f, fun _ => he, fun _ => hf, fun x hx => ⟨0, ?_⟩⟩
      by_contra hc
      have hx' : x ∈ S ∩ (Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) f : Set ↥(wcProjK k N))ᶜ := ⟨hx, hc⟩
      rw [h0] at hx'
      exact hx'
    | succ n ih =>
      intro S hS hSd
      obtain ⟨e, f, he, hf, hd⟩ := hcut (n + 1) S hS hSd
      have hS'c : IsClosed (S ∩ (Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) f : Set ↥(wcProjK k N))ᶜ) :=
        hS.inter (Proj.basicOpen _ _).isOpen.isClosed_compl
      obtain ⟨e', φ', he', hφ', hcov⟩ := ih _ hS'c hd
      refine ⟨Fin.cons e e', Fin.cons f φ', ?_, ?_, ?_⟩
      · intro i
        refine Fin.cases ?_ (fun i => ?_) i
        · simpa using he
        · simpa using he' i
      · intro i
        refine Fin.cases ?_ (fun i => ?_) i
        · simpa using hf
        · simpa using hφ' i
      · intro x hx
        by_cases hxf : x ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) f
        · exact ⟨0, by simpa using hxf⟩
        · obtain ⟨i, hi⟩ := hcov x ⟨hx, hxf⟩
          exact ⟨i.succ, by simpa using hi⟩

  haveI := hj
  have hTc : IsClosed (Set.range j) := j.isClosedEmbedding.isClosed_range
  have hTd : topologicalKrullDim ↥(Set.range j) < ((n + 1 : ℕ) : WithBot ℕ∞) := by
    rw [← IsHomeomorph.topologicalKrullDim_eq _
      (j.isClosedEmbedding.isEmbedding.toHomeomorph.isHomeomorph)]
    exact lt_of_le_of_lt hdim (by exact_mod_cast Nat.lt_succ_self n)
  obtain ⟨e, φ, he, hφ, hcov⟩ := hiter n (Set.range j) hTc hTd
  have hDpos : 0 < ∏ i, e i := Finset.prod_pos (fun i _ => he i)
  have hdvd : ∀ i, e i ∣ ∏ i, e i := fun i => Finset.dvd_prod_of_mem _ (Finset.mem_univ i)
  refine ⟨∏ i, e i, fun i => φ i ^ ((∏ i, e i) / e i), hDpos, fun i => ?_, fun y => ?_⟩
  · have h1 := (hφ i).pow ((∏ i, e i) / e i)
    rwa [Nat.mul_div_cancel' (hdvd i)] at h1
  · obtain ⟨i, hi⟩ := hcov (j y) (Set.mem_range_self y)
    refine ⟨i, ?_⟩
    have hpos : 0 < (∏ i, e i) / e i := Nat.div_pos (Nat.le_of_dvd hDpos (hdvd i)) (he i)
    show j y ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      (φ i ^ ((∏ i, e i) / e i))
    rw [Proj.basicOpen_pow _ _ _ hpos]
    exact hi

theorem wcpa_dj_gsgp_gep_degree_projection : ∀ (k : Type u) [Field k] (N n D : ℕ) (Y : Scheme.{u}) (j : Y ⟶ wcProjK k N) (Θ : Fin (n + 1) → MvPolynomial (Fin (N + 1)) k) (hΘ : ∀ i, Θ i ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k D), IsClosedImmersion j → 0 < D → (∀ y : Y, ∃ i, j y ∈ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra (Θ i)) → ∃ π : Y ⟶ wcProjK k n, IsFinite π ∧ π ≫ wcProjKStr k n = j ≫ wcProjKStr k N ∧ (∀ i, π ⁻¹ᵁ wcSgD k n i = j ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra (Θ i)) ∧ ∀ (i l : Fin (n + 1)) (y : Y) (hy : y ∈ π ⁻¹ᵁ wcSgD k n i) (hy' : y ∈ j ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra (Θ i)), (Y.presheaf.germ _ y hy).hom ((π.app (wcSgD k n i)).hom (wcSgE k n i l)) = (Y.presheaf.germ _ y hy').hom ((j.app _).hom ((@Proj.awayToSection _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) MvPolynomial.gradedAlgebra (Θ i)).hom (letI := @MvPolynomial.gradedAlgebra (Fin (N + 1)) k _; HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (hΘ i) 1 (Θ l) (by rw [one_smul]; exact hΘ l)))) :=
by

  have LA : ∀ {σ : Type u} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
      (𝒜 : ℕ → σ) [GradedRing 𝒜] (m : ℕ) (f g : A) (hf : f ∈ 𝒜 m) (hg : g ∈ 𝒜 m)
      (hg1 : g ∈ 𝒜 (1 • m)), 0 < m →
      Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g =
        (Proj 𝒜).basicOpen (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg1)) := by
    intro σ A _ _ _ 𝒜 _ m f g hf hg hg1 hm
    have ha : HomogeneousLocalization.Away.isLocalizationElem hf hg =
        (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg1) ^ m := by
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.val_pow, HomogeneousLocalization.Away.val_mk,
        HomogeneousLocalization.Away.val_mk, Localization.mk_pow, Localization.mk_eq_mk_iff,
        Localization.r_iff_exists]
