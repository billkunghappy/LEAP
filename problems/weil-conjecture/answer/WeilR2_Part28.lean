  have hPhiId : ∀ (T : wcBlIdx n) (h : T.1 ⊆ T.1), wcBlPhi K n T.1 T.1 h = RingHom.id _ := by
    intro T h
    unfold wcBlPhi
    exact wc_bc_awayMap_calculus.2.1 _ _ _ _ _ _ (by simp)
