    intro g hg
    obtain ⟨t, ht0, htor⟩ := wcpa_dj_flrg_chart_torsion k X P P' sP f U N jX hcomm hZ e₀ r L Φ μ
      G β γ hjX hP hP' hU hμ hH hβiso hγ hcomp he c V' hV'le i hV'aff ⟨_, hxV'⟩
    obtain ⟨m, hm⟩ := htor g (RingHom.mem_ker.mp hg)
    haveI := hflatJ
    have hreg := Module.Flat.isSMulRegular_of_nonZeroDivisors
      (M := MvPolynomial (Fin (N + 1)) Γ(P', V') ⧸ J)
      (pow_mem (mem_nonZeroDivisors_of_ne_zero ht0) m)
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    apply hreg
    show t ^ m • (Ideal.Quotient.mk J g) = t ^ m • 0
    rw [smul_zero, Algebra.smul_def, ← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq,
      ← map_mul, Ideal.Quotient.eq_zero_iff_mem]
    exact hm
  have hJeq : RingHom.ker Θ = J := le_antisymm hker hJker
  have hφ : ((ι ≫ Limits.pullback.snd f β).appLE V' _ hVle).hom =
      (((RingHom.quotientKerEquivOfSurjective hΘs).toRingHom).comp
        (Ideal.quotEquivOfEq hJeq.symm).toRingHom).comp
        (algebraMap Γ(P', V') (MvPolynomial (Fin (N + 1)) Γ(P', V') ⧸ J)) := by
    refine RingHom.ext fun b => ?_
    simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom]
    rw [← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq, Ideal.quotEquivOfEq_mk,
      RingHom.quotientKerEquivOfSurjective_apply_mk]
    exact (hΘC b).symm
  rw [hφ]
  exact RingHom.Flat.comp (RingHom.flat_algebraMap_iff.mpr hflatJ)
    (RingHom.Flat.comp (RingHom.Flat.of_bijective (Ideal.quotEquivOfEq hJeq.symm).bijective)
      (RingHom.Flat.of_bijective (RingHom.quotientKerEquivOfSurjective hΘs).bijective))

theorem wcpa_dj_fl_raynaud_gruson : ∀ (k : Type u) [Field k] (X P : Scheme.{u}) [AlgebraicGeometry.IsIntegral P] (sP : P ⟶ Spec (.of k)) (f : X ⟶ P) (U : P.Opens), wcpaDjIsProjOver k (f ≫ sP) → wcpaDjIsProjOver k sP → U ≠ ⊥ → Flat (f ∣_ U) → ∃ (P' : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral P') (β : P' ⟶ P) (X' : Scheme.{u}) (ι : X' ⟶ Limits.pullback f β), wcpaDjIsProjOver k (β ≫ sP) ∧ IsIso (β ∣_ U) ∧ IsClosedImmersion ι ∧ IsIso (ι ∣_ ((Limits.pullback.snd f β) ⁻¹ᵁ (β ⁻¹ᵁ U))) ∧ Flat (ι ≫ Limits.pullback.snd f β) :=
by
  intro k _ X P _ sP f U hX hP hU hfl

  haveI hfsP : IsProper (f ≫ sP) := wcpa_dj_proj_proper k _ hX
  haveI hsP : IsProper sP := wcpa_dj_proj_proper k sP hP
  haveI hf : IsProper f := IsProper.of_comp f sP

  obtain ⟨N, jX, hjX, hcomm₀⟩ := hX
  have hcomm : jX ≫ wcProjKStr k N = f ≫ sP := hcomm₀
  have hZ : (Limits.pullback.fst f U.ι ≫ jX) ≫ wcProjKStr k N =
      Limits.pullback.snd f U.ι ≫ U.ι ≫ sP := by
    rw [Category.assoc, hcomm, ← Category.assoc, Limits.pullback.condition, Category.assoc]

  obtain ⟨e₀, r, L, Φ, μ, G, hμ, hH⟩ :=
    wcpa_dj_flrg_hilbert_point k X P sP f U N jX hcomm hZ hjX hP hU hfl

  have hQ : wcpaDjIsProjOver k (wcProjKStr k L) := ⟨L, 𝟙 _, inferInstance, Category.id_comp _⟩
  obtain ⟨P', iP', β, γ, hβproj, hβiso, hγ, hcomp⟩ :=
    wcpa_dj_flrg_graph_closure k P (wcProjK k L) sP (wcProjKStr k L) U μ hP hQ hU hμ
  haveI := iP'

  haveI hβsP : IsProper (β ≫ sP) := wcpa_dj_proj_proper k _ hβproj
  haveI hsnd : IsProper (Limits.pullback.snd f β) := by
    first
    | infer_instance
    | exact MorphismProperty.of_isPullback (P := @IsProper) (IsPullback.of_hasPullback f β).flip hf
    | exact MorphismProperty.of_isPullback (P := @IsProper) (IsPullback.of_hasPullback f β) hf
  haveI hq : IsProper (Limits.pullback.snd f β ≫ β ≫ sP) := inferInstance

  obtain ⟨hι, hιiso⟩ := wcpa_dj_flrg_open_closure k (Limits.pullback f β)
    (Limits.pullback.snd f β ≫ β ≫ sP) ((Limits.pullback.snd f β) ⁻¹ᵁ (β ⁻¹ᵁ U))

  have hflat := wcpa_dj_flrg_closure_flat k X P P' sP f U N jX hcomm hZ e₀ r L Φ μ G β γ hjX hP
    hβproj hU hμ hH hβiso hγ hcomp

  exact ⟨P', iP', β, _, _, hβproj, hβiso, hι, hιiso, hflat⟩

theorem wcpa_dj_tr_basechange_proj : ∀ (k : Type u) [Field k] (P' P'' C : Scheme.{u}) (sP' : P' ⟶ Spec (.of k)) (sP'' : P'' ⟶ Spec (.of k)) (β : P'' ⟶ P') (g : C ⟶ P'), β ≫ sP' = sP'' → wcpaDjIsProjOver k sP' → wcpaDjIsProjOver k sP'' → wcpaDjIsProjOver k (g ≫ sP') → wcpaDjIsProjOver k (Limits.pullback.snd g β ≫ sP'') :=
by
  intro k _ P' P'' C sP' sP'' β g hβ hP' hP'' hC
  subst hβ
  haveI : IsProper sP' := wcpa_dj_proj_proper k sP' hP'
  obtain ⟨N₂, j₂, hj₂, hj₂eq⟩ := hP''
  obtain ⟨N₃, j₃, hj₃, hj₃eq⟩ := hC
  haveI := hj₂
  haveI := hj₃
  haveI hι : IsClosedImmersion (Limits.pullback.map g β (g ≫ sP') (β ≫ sP') (𝟙 C) (𝟙 P'') sP'
      (by simp) (by simp)) :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion)
      (Limits.pullback_map_diagonal_isPullback g β sP') inferInstance
  haveI : MorphismProperty.IsStableUnderComposition
      (@IsClosedImmersion : MorphismProperty Scheme.{u}) :=
    MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  haveI hμ := MorphismProperty.pullbackMap (P := @IsClosedImmersion) (f := g ≫ sP')
    (g := β ≫ sP') hj₃ hj₂ hj₃eq.symm hj₂eq.symm
  obtain ⟨N', σ, hσ, hσeq⟩ := wc_pp_segre k N₃ N₂
  haveI := hσ
  refine ⟨N', Limits.pullback.map g β (g ≫ sP') (β ≫ sP') (𝟙 C) (𝟙 P'') sP'
      (by simp) (by simp) ≫ Limits.pullback.map (g ≫ sP') (β ≫ sP') _ _ j₃ j₂ (𝟙 _)
      (by rw [Category.comp_id]; exact hj₃eq.symm) (by rw [Category.comp_id]; exact hj₂eq.symm) ≫ σ,
    inferInstance, ?_⟩
  simp only [Category.assoc]
  rw [hσeq]
  simp only [Limits.pullback.map, Limits.pullback.lift_fst_assoc, Category.assoc]
  rw [hj₃eq]
  simp only [Limits.pullback.lift_fst_assoc, Category.id_comp]
  exact Limits.pullback.condition_assoc _

theorem wcpa_dj_ssp_integral_of_flat : ∀ {C P : Scheme.{u}} [AlgebraicGeometry.IsIntegral P]
    [IsLocallyNoetherian P] (g : C ⟶ P), Flat g → LocallyOfFiniteType g →
    ∀ V : P.Opens, V ≠ ⊥ → SmoothOfRelativeDimension 1 (g ∣_ V) →
    GeometricallyConnected (g ∣_ V) → AlgebraicGeometry.IsIntegral C :=
by
  intro C P _ _ g hg hlft V hV hsm hgc
  haveI hPirr : IrreducibleSpace P := irreducibleSpace_of_isIntegral P

  have s1 : ∃ (y : Spec (P.presheaf.stalk (genericPoint P)) ⟶ V)
      (l : Limits.pullback g (P.fromSpecStalk (genericPoint P)) ⟶ (g ⁻¹ᵁ V)),
      IsPullback l (Limits.pullback.snd g (P.fromSpecStalk (genericPoint P))) (g ∣_ V) y := by
    have hη : genericPoint P ∈ V := by
      obtain ⟨u, hu⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty V).mp hV
      exact (genericPoint_specializes u).mem_open V.isOpen hu
    have hrange : Set.range (P.fromSpecStalk (genericPoint P)) ⊆ Set.range V.ι := by
      rintro _ ⟨z, rfl⟩
      rw [Scheme.Opens.range_ι]
      have hz : P.fromSpecStalk (genericPoint P) z ⤳ genericPoint P := by
        have : P.fromSpecStalk (genericPoint P) z ∈
            Set.range (P.fromSpecStalk (genericPoint P)) := ⟨z, rfl⟩
        rwa [Scheme.range_fromSpecStalk] at this
      exact hz.mem_open V.isOpen hη
    let y := IsOpenImmersion.lift V.ι (P.fromSpecStalk (genericPoint P)) hrange
    have hy : y ≫ V.ι = P.fromSpecStalk (genericPoint P) :=
      IsOpenImmersion.lift_fac _ _ _
    have outer := IsPullback.of_hasPullback g (P.fromSpecStalk (genericPoint P))
    have sq3 := (isPullback_morphismRestrict g V).flip
    have w : Limits.pullback.fst g (P.fromSpecStalk (genericPoint P)) ≫ g =
        (Limits.pullback.snd g (P.fromSpecStalk (genericPoint P)) ≫ y) ≫ V.ι := by
      rw [Category.assoc _ y, hy]
      exact outer.w
    refine ⟨y, sq3.lift _ _ w, ?_⟩
    apply IsPullback.of_right ?_ (sq3.lift_snd _ _ w) sq3
    rw [sq3.lift_fst, hy]
    exact outer


  have s2 : ∀ (K : Type u) [Field K] (X Y : Scheme.{u}) (f : X ⟶ Y) (y : Spec (.of K) ⟶ Y)
      (Z : Scheme.{u}) (fst : Z ⟶ X) (snd : Z ⟶ Spec (.of K)), SmoothOfRelativeDimension 1 f →
      GeometricallyConnected f → IsPullback fst snd f y →
      IrreducibleSpace Z ∧ AlgebraicGeometry.IsReduced Z := by
    intro K _ X Y f y Z fst snd hsm' hgc' hpb
    haveI := hgc'
    haveI : SmoothOfRelativeDimension 1 snd :=
      MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hpb hsm'
    haveI : ConnectedSpace Z := GeometricallyConnected.geometrically_connectedSpace y fst snd hpb
    haveI : Smooth snd := SmoothOfRelativeDimension.smooth 1 snd
    haveI : LocallyOfFiniteType snd := inferInstance
    haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian snd
    have hd := wcpa_smooth_stalk_isDomain K Z snd 1
    refine ⟨wcpa_irreducible_of_connected_domain_stalks Z hd, ?_⟩
    haveI : ∀ z : Z, _root_.IsReduced (Z.presheaf.stalk z) := fun z => by
      haveI := hd z
      infer_instance
    exact isReduced_of_isReduced_stalk Z

  have s3 : ∀ (S X : Scheme.{u}) [AlgebraicGeometry.IsIntegral S] [IrreducibleSpace S] (f : X ⟶ S),
      Flat f →
      IrreducibleSpace ↥(Limits.pullback f (S.fromSpecStalk (genericPoint S))) →
      IrreducibleSpace X ∧ True := by
    intro S X _ _ f hf hG
    refine ⟨?_, trivial⟩
    have hgen : GeneralizingMap f := Flat.generalizingMap f
    have key : ∀ x : X, Limits.pullback.fst f (S.fromSpecStalk (genericPoint S))
        (genericPoint ↥(Limits.pullback f (S.fromSpecStalk (genericPoint S)))) ⤳ x := by
      intro x
      have h1 : genericPoint S ⤳ f x := genericPoint_specializes (f x)
      obtain ⟨x', hx', hfx'⟩ := hgen h1
      have hmem : f x' ∈ Set.range (S.fromSpecStalk (genericPoint S)) := by
        rw [Scheme.range_fromSpecStalk, hfx']
        exact specializes_refl _
      have hx'r : x' ∈ Set.range (Limits.pullback.fst f (S.fromSpecStalk (genericPoint S))) := by
        rw [Scheme.Pullback.range_fst]
        exact hmem
      obtain ⟨z, rfl⟩ := hx'r
      exact ((genericPoint_specializes z).map (Limits.pullback.fst f _).continuous).trans hx'
    rw [irreducibleSpace_def]
    have huniv : (Set.univ : Set X) = closure {Limits.pullback.fst f (S.fromSpecStalk (genericPoint S))
        (genericPoint ↥(Limits.pullback f (S.fromSpecStalk (genericPoint S))))} := by
      apply (Set.eq_univ_of_forall _).symm
      intro x
      exact specializes_iff_mem_closure.mp (key x)
    rw [Set.top_eq_univ, huniv]
    exact isIrreducible_singleton.closure

  have s4 : ∀ (S X : Scheme.{u}) [AlgebraicGeometry.IsIntegral S] [IrreducibleSpace S] (f : X ⟶ S)
      (V : S.Opens)
      (hV : IsAffineOpen V) (W : X.Opens) (hW : IsAffineOpen W) (e : W ≤ f ⁻¹ᵁ V)
      (hη : genericPoint S ∈ V),
      AlgebraicGeometry.IsReduced (Limits.pullback f (S.fromSpecStalk (genericPoint S))) →
      AlgebraicGeometry.IsReduced (Limits.pullback (Spec.map (f.appLE V W e))
        (Spec.map (S.presheaf.germ V (genericPoint S) hη))) ∧ True := by
    intro S X _ _ f V hV W hW e hη hG
    refine ⟨?_, trivial⟩
    have h0 : IsPullback (Limits.pullback.fst (Spec.map (f.appLE V W e))
        (Spec.map (S.presheaf.germ V (genericPoint S) hη)))
        (Limits.pullback.snd (Spec.map (f.appLE V W e))
          (Spec.map (S.presheaf.germ V (genericPoint S) hη)))
        (Spec.map (f.appLE V W e) ≫ hV.fromSpec)
        (Spec.map (S.presheaf.germ V (genericPoint S) hη) ≫ hV.fromSpec) :=
      IsPullback.of_isLimit (Limits.pullbackIsPullbackOfCompMono (Spec.map (f.appLE V W e))
        (Spec.map (S.presheaf.germ V (genericPoint S) hη)) hV.fromSpec)
    have e1 : Spec.map (S.presheaf.germ V (genericPoint S) hη) ≫ hV.fromSpec =
        S.fromSpecStalk (genericPoint S) := hV.fromSpecStalk_eq_fromSpecStalk hη
    rw [IsAffineOpen.SpecMap_appLE_fromSpec f hV hW e, e1] at h0
    have sqG := (IsPullback.of_hasPullback f (S.fromSpecStalk (genericPoint S))).flip
    have w : (Limits.pullback.fst (Spec.map (f.appLE V W e))
        (Spec.map (S.presheaf.germ V (genericPoint S) hη)) ≫ hW.fromSpec) ≫ f =
        Limits.pullback.snd (Spec.map (f.appLE V W e))
          (Spec.map (S.presheaf.germ V (genericPoint S) hη)) ≫ S.fromSpecStalk (genericPoint S) := by
      rw [Category.assoc]
      exact h0.w
    have Sq := IsPullback.of_right (h₁₁ := Limits.pullback.lift _ _ w) ?_
      (Limits.pullback.lift_fst _ _ w) sqG
    · haveI : IsOpenImmersion (Limits.pullback.lift _ _ w) :=
        MorphismProperty.of_isPullback (P := @IsOpenImmersion) Sq.flip inferInstance
      exact isReduced_of_isOpenImmersion (Limits.pullback.lift _ _ w)
    · rw [Limits.pullback.lift_snd]
      exact h0.flip

  have s5 : ∀ (S X : Scheme.{u}) [AlgebraicGeometry.IsIntegral S] [IrreducibleSpace S] (f : X ⟶ S),
      Flat f →
      (∀ (V : S.Opens) (_ : IsAffineOpen V) (W : X.Opens) (_ : IsAffineOpen W) (e : W ≤ f ⁻¹ᵁ V)
        (hη : genericPoint S ∈ V), AlgebraicGeometry.IsReduced (Limits.pullback
          (Spec.map (f.appLE V W e)) (Spec.map (S.presheaf.germ V (genericPoint S) hη)))) →
      AlgebraicGeometry.IsReduced X ∧ True := by
    intro S X _ _ f hf H
    haveI := hf
    have hst : ∀ x : X, _root_.IsReduced (X.presheaf.stalk x) := by
      intro x
      obtain ⟨V, hV, hxV, -⟩ := exists_isAffineOpen_mem_and_subset (x := f x) (U := ⊤) trivial
      obtain ⟨W, hW, hxW, hWV⟩ := exists_isAffineOpen_mem_and_subset (x := x) (U := f ⁻¹ᵁ V) hxV
      have hη : genericPoint S ∈ V := (genericPoint_specializes (f x)).mem_open V.isOpen hxV
      have hT := H V hV W hW hWV hη
      letI := (f.appLE V W hWV).hom.toAlgebra
      letI := (S.presheaf.germ V (genericPoint S) hη).hom.toAlgebra
      haveI : Module.Flat Γ(S, V) Γ(X, W) := Flat.flat_appLE f hV hW hWV
      have hinj : Function.Injective (algebraMap Γ(S, V) (S.presheaf.stalk (genericPoint S))) :=
        germ_injective_of_isIntegral S _ hη
      have hinc := Algebra.TensorProduct.includeLeft_injective (R := Γ(S, V)) (S := Γ(S, V))
        (A := Γ(X, W)) (B := S.presheaf.stalk (genericPoint S)) hinj
      haveI : AlgebraicGeometry.IsReduced
          (Spec (.of (TensorProduct Γ(S, V) Γ(X, W) (S.presheaf.stalk (genericPoint S))))) := by
        haveI : AlgebraicGeometry.IsReduced (Limits.pullback
            (Spec.map (CommRingCat.ofHom (algebraMap Γ(S, V) Γ(X, W))))
            (Spec.map (CommRingCat.ofHom
              (algebraMap Γ(S, V) (S.presheaf.stalk (genericPoint S)))))) := hT
        exact isReduced_of_isOpenImmersion (pullbackSpecIso _ _ _).inv
      haveI : _root_.IsReduced
          (TensorProduct Γ(S, V) Γ(X, W) (S.presheaf.stalk (genericPoint S))) :=
        (affine_isReduced_iff (CommRingCat.of
          (TensorProduct Γ(S, V) Γ(X, W) (S.presheaf.stalk (genericPoint S))))).mp inferInstance
      haveI : _root_.IsReduced Γ(X, W) := isReduced_of_injective _ hinc
      letI := TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨x, hxW⟩ : W)
      haveI := hW.isLocalization_stalk ⟨x, hxW⟩
      exact isReduced_localizationPreserves (hW.primeIdealOf ⟨x, hxW⟩).asIdeal.primeCompl
        (X.presheaf.stalk (⟨x, hxW⟩ : W)) ‹_›
    exact ⟨isReduced_of_isReduced_stalk X, trivial⟩

  haveI := hg
  obtain ⟨y, l, hl⟩ := s1
  have hBR : IrreducibleSpace ↥(Limits.pullback g (P.fromSpecStalk (genericPoint P))) ∧
      AlgebraicGeometry.IsReduced (Limits.pullback g (P.fromSpecStalk (genericPoint P))) :=
    s2 (P.presheaf.stalk (genericPoint P)) _ _ (g ∣_ V) y _ l _ hsm hgc hl
  haveI hI : IrreducibleSpace C := (s3 P C g hg hBR.1).1
  haveI hR : AlgebraicGeometry.IsReduced C :=
    (s5 P _ g hg (fun V' hV' W hW e hη => (s4 P _ _ V' hV' W hW e hη hBR.2).1)).1
  exact isIntegral_of_irreducibleSpace_of_isReduced C

theorem wcpa_dj_ssff_strict_package : ∀ (k : Type u) [Field k] (X P : Scheme.{u}) [AlgebraicGeometry.IsIntegral X] [AlgebraicGeometry.IsIntegral P] (sP : P ⟶ Spec (.of k)) (f : X ⟶ P), wcpaDjIsProjOver k (f ≫ sP) → wcpaDjIsProjOver k sP → ∀ U : P.Opens, U ≠ ⊥ → SmoothOfRelativeDimension 1 (f ∣_ U) → GeometricallyConnected (f ∣_ U) → ∀ (n : ℕ) (σ : Fin n → (P ⟶ X)), (∀ i, σ i ≫ f = 𝟙 P) → (∀ (i j : Fin n) (p : P), p ∈ U → i ≠ j → σ i p ≠ σ j p) → ∀ (P' : Scheme.{u}) [AlgebraicGeometry.IsIntegral P'] (β : P' ⟶ P) (X' : Scheme.{u}) (ι : X' ⟶ Limits.pullback f β), wcpaDjIsProjOver k (β ≫ sP) → IsProper β → IsIso (β ∣_ U) → IsClosedImmersion ι → IsIso (ι ∣_ ((Limits.pullback.snd f β) ⁻¹ᵁ (β ⁻¹ᵁ U))) → Flat (ι ≫ Limits.pullback.snd f β) → AlgebraicGeometry.IsIntegral X' ∧ wcpaDjIsProjOver k ((ι ≫ Limits.pullback.snd f β) ≫ β ≫ sP) ∧ IsProper (ι ≫ Limits.pullback.fst f β) ∧ Surjective (ι ≫ Limits.pullback.fst f β) ∧ (∃ V : X.Opens, V ≠ ⊥ ∧ IsFinite ((ι ≫ Limits.pullback.fst f β) ∣_ V)) ∧ SmoothOfRelativeDimension 1 ((ι ≫ Limits.pullback.snd f β) ∣_ (β ⁻¹ᵁ U)) ∧ GeometricallyConnected ((ι ≫ Limits.pullback.snd f β) ∣_ (β ⁻¹ᵁ U)) ∧ ∃ σ' : Fin n → (P' ⟶ X'), (∀ i, σ' i ≫ ι ≫ Limits.pullback.snd f β = 𝟙 P') ∧ (∀ (i j : Fin n) (p : P'), p ∈ β ⁻¹ᵁ U → i ≠ j → σ' i p ≠ σ' j p) ∧ ⇑(ι ≫ Limits.pullback.fst f β) ⁻¹' ((⋃ i, Set.range ⇑(σ i)) ∪ ⇑f ⁻¹' ((U : Set P)ᶜ)) ⊆ (⋃ i, Set.range ⇑(σ' i)) ∪ ⇑(ι ≫ Limits.pullback.snd f β) ⁻¹' (((β ⁻¹ᵁ U : P'.Opens) : Set P')ᶜ) :=
by
  intro k _ X P _ _ sP f hX hP U hU hsm hgc n σ hσ hσd P' _ β X' ι hβproj hβprop hβiso hι hιiso
    hflat
  haveI := hβprop
  haveI := hι
  haveI := hβiso
  haveI := hιiso
  haveI hsPp : IsProper sP := wcpa_dj_proj_proper k sP hP
  haveI hfsPp : IsProper (f ≫ sP) := wcpa_dj_proj_proper k (f ≫ sP) hX
  haveI hfp : IsProper f := IsProper.of_comp f sP
  haveI hβsPp : IsProper (β ≫ sP) := wcpa_dj_proj_proper k (β ≫ sP) hβproj
  haveI : IsLocallyNoetherian P' := LocallyOfFiniteType.isLocallyNoetherian (β ≫ sP)
  have hlft : LocallyOfFiniteType (ι ≫ Limits.pullback.snd f β) := inferInstance

  have hV : β ⁻¹ᵁ U ≠ ⊥ := by
    rw [TopologicalSpace.Opens.ne_bot_iff_nonempty] at hU ⊢
    obtain ⟨p, hp⟩ := hU
    obtain ⟨w, -⟩ := (β ∣_ U).surjective ⟨p, hp⟩
    exact ⟨w.1, w.2⟩

  have hpbV : ∃ h : ((Limits.pullback.snd f β) ⁻¹ᵁ (β ⁻¹ᵁ U) : Scheme.{u}) ⟶ (f ⁻¹ᵁ U : Scheme.{u}),
      IsPullback h ((Limits.pullback.snd f β) ∣_ (β ⁻¹ᵁ U)) (f ∣_ U) (β ∣_ U) := by
    have hA := isPullback_morphismRestrict f U
    have hB := isPullback_morphismRestrict (Limits.pullback.snd f β) (β ⁻¹ᵁ U)
    have hC : β ∣_ U ≫ U.ι = (β ⁻¹ᵁ U).ι ≫ β := morphismRestrict_ι β U
    have hD : (Limits.pullback.snd f β) ∣_ (β ⁻¹ᵁ U) ≫ (β ⁻¹ᵁ U).ι =
        ((Limits.pullback.snd f β) ⁻¹ᵁ (β ⁻¹ᵁ U)).ι ≫ Limits.pullback.snd f β :=
      morphismRestrict_ι _ _
    have hw : ((Limits.pullback.snd f β) ∣_ (β ⁻¹ᵁ U) ≫ β ∣_ U) ≫ U.ι =
        (((Limits.pullback.snd f β) ⁻¹ᵁ (β ⁻¹ᵁ U)).ι ≫ Limits.pullback.fst f β) ≫ f := by
      rw [Category.assoc, hC, ← Category.assoc, hD, Category.assoc, Category.assoc,
        Limits.pullback.condition]
    let h := hA.lift _ _ hw
    have hE : h ≫ f ∣_ U = (Limits.pullback.snd f β) ∣_ (β ⁻¹ᵁ U) ≫ β ∣_ U := hA.lift_fst _ _ hw
    have hF : h ≫ (f ⁻¹ᵁ U).ι =
        ((Limits.pullback.snd f β) ⁻¹ᵁ (β ⁻¹ᵁ U)).ι ≫ Limits.pullback.fst f β :=
      hA.lift_snd _ _ hw
    have hrect := IsPullback.paste_horiz hB.flip (IsPullback.of_hasPullback f β)
    rw [← hF, ← hC] at hrect
    exact ⟨h, IsPullback.of_right hrect hE hA.flip⟩
  obtain ⟨h0, hpb0⟩ := hpbV
  have hsm₀ : SmoothOfRelativeDimension 1 ((Limits.pullback.snd f β) ∣_ (β ⁻¹ᵁ U)) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hpb0 hsm
  have hgc₀ : GeometricallyConnected ((Limits.pullback.snd f β) ∣_ (β ⁻¹ᵁ U)) :=
    MorphismProperty.of_isPullback (P := @GeometricallyConnected) hpb0 hgc

  have hsq2 : IsPullback (ι ∣_ ((Limits.pullback.snd f β) ⁻¹ᵁ (β ⁻¹ᵁ U)))
      ((ι ≫ Limits.pullback.snd f β) ∣_ (β ⁻¹ᵁ U))
      ((Limits.pullback.snd f β) ∣_ (β ⁻¹ᵁ U)) (𝟙 _) := by
    apply IsPullback.of_horiz_isIso
    constructor
    rw [morphismRestrict_comp, Category.comp_id]
  have C6 : SmoothOfRelativeDimension 1 ((ι ≫ Limits.pullback.snd f β) ∣_ (β ⁻¹ᵁ U)) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hsq2 hsm₀
  have C7 : GeometricallyConnected ((ι ≫ Limits.pullback.snd f β) ∣_ (β ⁻¹ᵁ U)) :=
    MorphismProperty.of_isPullback (P := @GeometricallyConnected) hsq2 hgc₀

  have C1 : AlgebraicGeometry.IsIntegral X' :=
    wcpa_dj_ssp_integral_of_flat (ι ≫ Limits.pullback.snd f β) hflat hlft (β ⁻¹ᵁ U) hV C6 C7

  have C2 : wcpaDjIsProjOver k ((ι ≫ Limits.pullback.snd f β) ≫ β ≫ sP) := by
    obtain ⟨N, j, hj, hjeq⟩ :=
      wcpa_dj_tr_basechange_proj k P P' X sP (β ≫ sP) β f rfl hP hβproj hX
    haveI := hj
    refine ⟨N, ι ≫ j, inferInstance, ?_⟩
    rw [Category.assoc, hjeq]
    simp only [Category.assoc]

  have C3 : IsProper (ι ≫ Limits.pullback.fst f β) := inferInstance

  have hpre : Limits.pullback.fst f β ⁻¹ᵁ (f ⁻¹ᵁ U) =
      Limits.pullback.snd f β ⁻¹ᵁ (β ⁻¹ᵁ U) := by
    rw [← Scheme.Hom.comp_preimage, ← Scheme.Hom.comp_preimage, Limits.pullback.condition]
  have hfU : IsIso ((Limits.pullback.fst f β) ∣_ (f ⁻¹ᵁ U)) := by
    have sq : IsPullback (Limits.pullback.fst f β) (Limits.pullback.snd f β) f β :=
      IsPullback.of_hasPullback f β
    have hUY : Limits.pullback.fst f β ⁻¹ᵁ (f ⁻¹ᵁ U) =
        Limits.pullback.fst f β ⁻¹ᵁ (f ⁻¹ᵁ U) ⊓ Limits.pullback.snd f β ⁻¹ᵁ (β ⁻¹ᵁ U) := by
      rw [← hpre, inf_idem]
    have sq' := Scheme.Hom.isPullback_resLE sq (US := U) (UT := β ⁻¹ᵁ U) (UX := f ⁻¹ᵁ U)
      le_rfl le_rfl hUY
    simp only [Scheme.Hom.resLE_eq_morphismRestrict] at sq'
    exact sq'.isIso_fst_of_isIso
  have hαiso : IsIso ((ι ≫ Limits.pullback.fst f β) ∣_ (f ⁻¹ᵁ U)) := by
    have h2 : IsIso (ι ∣_ (Limits.pullback.fst f β ⁻¹ᵁ (f ⁻¹ᵁ U))) := by
      rw [hpre]; exact hιiso
    rw [morphismRestrict_comp]
    exact @IsIso.comp_isIso _ _ _ _ _ _ _ h2 hfU
  haveI := hαiso

  have hfne : f ⁻¹ᵁ U ≠ ⊥ := by
    rw [TopologicalSpace.Opens.ne_bot_iff_nonempty] at hU ⊢
    obtain ⟨p, hp⟩ := hU
    have hpb := IsPullback.of_hasPullback (f ∣_ U) ((U : Scheme.{u}).fromSpecResidueField ⟨p, hp⟩)
    have hc := GeometricallyConnected.geometrically_connectedSpace (f := f ∣_ U) _ _ _ hpb
    obtain ⟨z⟩ := hc.toNonempty
    let w : (f ⁻¹ᵁ U : Scheme.{u}) :=
      (Limits.pullback.fst (f ∣_ U) ((U : Scheme.{u}).fromSpecResidueField ⟨p, hp⟩) :
        Limits.pullback (f ∣_ U) ((U : Scheme.{u}).fromSpecResidueField ⟨p, hp⟩) ⟶
          (f ⁻¹ᵁ U : Scheme.{u})) z
    exact ⟨w.1, w.2⟩
  have C4 : Surjective (ι ≫ Limits.pullback.fst f β) := by
    constructor
    have hcl : IsClosed (Set.range ⇑(ι ≫ Limits.pullback.fst f β)) :=
      (Scheme.Hom.isClosedMap _).isClosed_range
    have hsub : ((f ⁻¹ᵁ U : X.Opens) : Set X) ⊆ Set.range ⇑(ι ≫ Limits.pullback.fst f β) := by
      intro x hx
      obtain ⟨w, hw⟩ := ((ι ≫ Limits.pullback.fst f β) ∣_ (f ⁻¹ᵁ U)).surjective ⟨x, hx⟩
      refine ⟨w.1, ?_⟩
      have := congrArg Subtype.val hw
      rwa [morphismRestrict_base_coe] at this
    have hdense : Dense ((f ⁻¹ᵁ U : X.Opens) : Set X) :=
      (f ⁻¹ᵁ U).isOpen.dense ((TopologicalSpace.Opens.ne_bot_iff_nonempty _).mp hfne)
    intro x
    have hx : x ∈ closure ((f ⁻¹ᵁ U : X.Opens) : Set X) := by
      rw [hdense.closure_eq]; exact Set.mem_univ x
    exact (hcl.closure_subset_iff.mpr hsub) hx
  have C5 : ∃ V : X.Opens, V ≠ ⊥ ∧ IsFinite ((ι ≫ Limits.pullback.fst f β) ∣_ V) :=
    ⟨f ⁻¹ᵁ U, hfne, inferInstance⟩

  have liftci : ∀ (R S C : Scheme.{u}) [IsReduced R] (a : R ⟶ S)
      (j : C ⟶ S) [IsClosedImmersion j], Set.range ⇑a ⊆ Set.range ⇑j →
      ∃ b : R ⟶ C, b ≫ j = a := by
    intro R S C _ a j _ hrange
    have H : Scheme.Hom.ker j ≤ Scheme.Hom.ker a := by
      rw [Scheme.Hom.ker.eq_1 a, Scheme.IdealSheafData.le_ofIdeals_iff]
      intro U s hs
      rw [Scheme.Hom.ker_apply, RingHom.mem_ker] at hs
      rw [RingHom.mem_ker]
      apply eq_zero_of_basicOpen_eq_bot
      rw [← Scheme.Hom.preimage_basicOpen]
      have hj : j ⁻¹ᵁ S.basicOpen s = ⊥ := by
        rw [Scheme.Hom.preimage_basicOpen, hs, Scheme.basicOpen_zero]
      rw [← TopologicalSpace.Opens.not_nonempty_iff_eq_bot]
      rintro ⟨x, hx⟩
      obtain ⟨c, hc⟩ := hrange ⟨x, rfl⟩
      have hc' : c ∈ j ⁻¹ᵁ S.basicOpen s := by
        show j c ∈ S.basicOpen s
        rw [hc]
        exact hx
      rw [hj] at hc'
      exact hc'
    exact ⟨IsClosedImmersion.lift j a H, IsClosedImmersion.lift_fac j a H⟩
  have hlift : ∀ i, ∃ t : P' ⟶ X', t ≫ ι ≫ Limits.pullback.snd f β = 𝟙 P' ∧
      t ≫ ι ≫ Limits.pullback.fst f β = β ≫ σ i := by
    intro i
    have e : (β ≫ σ i) ≫ f = 𝟙 P' ≫ β := by
      rw [Category.assoc, hσ i, Category.comp_id, Category.id_comp]
    have hs1 : Limits.pullback.lift (β ≫ σ i) (𝟙 P') e ≫ Limits.pullback.snd f β = 𝟙 P' :=
      Limits.pullback.lift_snd _ _ _
    have hs2 : Limits.pullback.lift (β ≫ σ i) (𝟙 P') e ≫ Limits.pullback.fst f β = β ≫ σ i :=
      Limits.pullback.lift_fst _ _ _
    have hrange : Set.range ⇑(Limits.pullback.lift (β ≫ σ i) (𝟙 P') e) ⊆ Set.range ⇑ι := by
      have hcl : IsClosed (⇑(Limits.pullback.lift (β ≫ σ i) (𝟙 P') e) ⁻¹' Set.range ⇑ι) :=
        ι.isClosedEmbedding.isClosed_range.preimage
          (Limits.pullback.lift (β ≫ σ i) (𝟙 P') e).continuous
      have hsub : ((β ⁻¹ᵁ U : P'.Opens) : Set P') ⊆
          ⇑(Limits.pullback.lift (β ≫ σ i) (𝟙 P') e) ⁻¹' Set.range ⇑ι := by
        intro p hp
        have hsp : Limits.pullback.snd f β (Limits.pullback.lift (β ≫ σ i) (𝟙 P') e p) = p := by
          rw [← Scheme.Hom.comp_apply, hs1]
          first | rfl | simp
        have hp' : Limits.pullback.lift (β ≫ σ i) (𝟙 P') e p ∈
            Limits.pullback.snd f β ⁻¹ᵁ (β ⁻¹ᵁ U) := by
          rw [Scheme.Hom.mem_preimage, hsp]; exact hp
        obtain ⟨w, hw⟩ := (ι ∣_ (Limits.pullback.snd f β ⁻¹ᵁ (β ⁻¹ᵁ U))).surjective ⟨_, hp'⟩
        refine ⟨w.1, ?_⟩
        have := congrArg Subtype.val hw
        rwa [morphismRestrict_base_coe] at this
      have hdense : Dense ((β ⁻¹ᵁ U : P'.Opens) : Set P') :=
        (β ⁻¹ᵁ U).isOpen.dense ((TopologicalSpace.Opens.ne_bot_iff_nonempty _).mp hV)
      rintro _ ⟨p, rfl⟩
      have hp : p ∈ closure ((β ⁻¹ᵁ U : P'.Opens) : Set P') := by
        rw [hdense.closure_eq]; exact Set.mem_univ p
      exact (hcl.closure_subset_iff.mpr hsub) hp
    obtain ⟨t, ht⟩ := liftci P' _ X' (Limits.pullback.lift (β ≫ σ i) (𝟙 P') e) ι hrange
    refine ⟨t, ?_, ?_⟩
    · rw [← Category.assoc, ht, hs1]
    · rw [← Category.assoc, ht, hs2]
  choose σ' hσ'snd hσ'fst using hlift

  have hsq : (ι ≫ Limits.pullback.fst f β) ≫ f = (ι ≫ Limits.pullback.snd f β) ≫ β := by
    simp only [Category.assoc, Limits.pullback.condition]
  have hsqpt : ∀ x : X', f ((ι ≫ Limits.pullback.fst f β) x) =
      β ((ι ≫ Limits.pullback.snd f β) x) := by
    intro x
    have h : ((ι ≫ Limits.pullback.fst f β) ≫ f) x = ((ι ≫ Limits.pullback.snd f β) ≫ β) x := by
      rw [hsq]
    rwa [Scheme.Hom.comp_apply (ι ≫ Limits.pullback.fst f β) f x,
      Scheme.Hom.comp_apply (ι ≫ Limits.pullback.snd f β) β x] at h
  have hσpt : ∀ i q, f (σ i q) = q := by
    intro i q
    have h : (σ i ≫ f) q = (𝟙 P : P ⟶ P) q := by rw [hσ i]
    rw [Scheme.Hom.comp_apply] at h
    simpa using h
  have hstar : ∀ i p, (ι ≫ Limits.pullback.fst f β) (σ' i p) = σ i (β p) := by
    intro i p
    have h : (σ' i ≫ ι ≫ Limits.pullback.fst f β) p = (β ≫ σ i) p := by rw [hσ'fst i]
    rwa [Scheme.Hom.comp_apply (σ' i) (ι ≫ Limits.pullback.fst f β) p,
      Scheme.Hom.comp_apply β (σ i) p] at h
  have hinj : ∀ x₁ x₂ : X', (ι ≫ Limits.pullback.fst f β) x₁ ∈ f ⁻¹ᵁ U →
      (ι ≫ Limits.pullback.fst f β) x₂ ∈ f ⁻¹ᵁ U →
      (ι ≫ Limits.pullback.fst f β) x₁ = (ι ≫ Limits.pullback.fst f β) x₂ → x₁ = x₂ := by
    intro x₁ x₂ h1 h2 h12
    let y₁ : ((ι ≫ Limits.pullback.fst f β) ⁻¹ᵁ (f ⁻¹ᵁ U) : Scheme.{u}) := ⟨x₁, h1⟩
    let y₂ : ((ι ≫ Limits.pullback.fst f β) ⁻¹ᵁ (f ⁻¹ᵁ U) : Scheme.{u}) := ⟨x₂, h2⟩
    have e1 := morphismRestrict_base_coe (ι ≫ Limits.pullback.fst f β) (f ⁻¹ᵁ U) y₁
    have e2 := morphismRestrict_base_coe (ι ≫ Limits.pullback.fst f β) (f ⁻¹ᵁ U) y₂
    have hI : y₁ = y₂ :=
      ((ι ≫ Limits.pullback.fst f β) ∣_ (f ⁻¹ᵁ U)).isOpenEmbedding.injective
        (Subtype.ext (by rw [e1, e2]; exact h12))
    exact congrArg Subtype.val hI
  have hdisj : ∀ (i j : Fin n) (p : P'), p ∈ β ⁻¹ᵁ U → i ≠ j → σ' i p ≠ σ' j p := by
    intro i j p hp hij heq
    have h := congrArg (⇑(ι ≫ Limits.pullback.fst f β)) heq
    rw [hstar, hstar] at h
    exact hσd i j (β p) hp hij h
  have hcont : ⇑(ι ≫ Limits.pullback.fst f β) ⁻¹' ((⋃ i, Set.range ⇑(σ i)) ∪ ⇑f ⁻¹' ((U : Set P)ᶜ)) ⊆
      (⋃ i, Set.range ⇑(σ' i)) ∪
        ⇑(ι ≫ Limits.pullback.snd f β) ⁻¹' (((β ⁻¹ᵁ U : P'.Opens) : Set P')ᶜ) := by
    intro x hx
    by_cases hxV : (ι ≫ Limits.pullback.snd f β) x ∈ β ⁻¹ᵁ U
    · have hpU : β ((ι ≫ Limits.pullback.snd f β) x) ∈ U := hxV
      have hαU : f ((ι ≫ Limits.pullback.fst f β) x) ∈ U := by rw [hsqpt]; exact hpU
      rcases hx with hx | hx
      · obtain ⟨i, q, hq⟩ := Set.mem_iUnion.mp hx
        have hqβ : q = β ((ι ≫ Limits.pullback.snd f β) x) := by
          rw [← hσpt i q, hq, hsqpt]
        refine Or.inl (Set.mem_iUnion.mpr ⟨i, (ι ≫ Limits.pullback.snd f β) x, ?_⟩)
        apply hinj
        · show f ((ι ≫ Limits.pullback.fst f β) (σ' i ((ι ≫ Limits.pullback.snd f β) x))) ∈ U
          rw [hstar, hσpt]; exact hpU
        · exact hαU
        · rw [hstar, ← hqβ, hq]
      · exact (hx hαU).elim
    · exact Or.inr hxV
  exact ⟨C1, C2, C3, C4, C5, C6, C7, σ', hσ'snd, hdisj, hcont⟩

theorem wcpa_dj_tr_basechange_smooth : ∀ (P' P'' C : Scheme.{u}) (β : P'' ⟶ P') (g : C ⟶ P') (U' : P'.Opens), SmoothOfRelativeDimension 1 (g ∣_ U') → SmoothOfRelativeDimension 1 ((Limits.pullback.snd g β) ∣_ (β ⁻¹ᵁ U')) :=
by
  intro P' P'' C β g U' hsm
  have hA := isPullback_morphismRestrict g U'
  have hB := isPullback_morphismRestrict (Limits.pullback.snd g β) (β ⁻¹ᵁ U')
  have hC : β ∣_ U' ≫ U'.ι = (β ⁻¹ᵁ U').ι ≫ β := morphismRestrict_ι β U'
  have hD : (Limits.pullback.snd g β) ∣_ (β ⁻¹ᵁ U') ≫ (β ⁻¹ᵁ U').ι =
      ((Limits.pullback.snd g β) ⁻¹ᵁ (β ⁻¹ᵁ U')).ι ≫ Limits.pullback.snd g β :=
    morphismRestrict_ι _ _
  have hw : ((Limits.pullback.snd g β) ∣_ (β ⁻¹ᵁ U') ≫ β ∣_ U') ≫ U'.ι =
      (((Limits.pullback.snd g β) ⁻¹ᵁ (β ⁻¹ᵁ U')).ι ≫ Limits.pullback.fst g β) ≫ g := by
    rw [Category.assoc, hC, ← Category.assoc, hD, Category.assoc, Category.assoc,
      Limits.pullback.condition]
  let h := hA.lift _ _ hw
  have hE : h ≫ g ∣_ U' = (Limits.pullback.snd g β) ∣_ (β ⁻¹ᵁ U') ≫ β ∣_ U' := hA.lift_fst _ _ hw
  have hF : h ≫ (g ⁻¹ᵁ U').ι =
      ((Limits.pullback.snd g β) ⁻¹ᵁ (β ⁻¹ᵁ U')).ι ≫ Limits.pullback.fst g β :=
    hA.lift_snd _ _ hw
  have hrect := IsPullback.paste_horiz hB.flip (IsPullback.of_hasPullback g β)
  rw [← hF, ← hC] at hrect
  have hpb : IsPullback h ((Limits.pullback.snd g β) ∣_ (β ⁻¹ᵁ U')) (g ∣_ U') (β ∣_ U') :=
    IsPullback.of_right hrect hE hA.flip
  exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hpb hsm

theorem wcpa_dj_tr_basechange_alteration : ∀ (P' P'' C : Scheme.{u}) [AlgebraicGeometry.IsIntegral P'] [AlgebraicGeometry.IsIntegral C] (β : P'' ⟶ P') (g : C ⟶ P'), Flat g → IsProper β → Surjective β → (∃ V : P'.Opens, V ≠ ⊥ ∧ IsFinite (β ∣_ V)) → IsProper (Limits.pullback.fst g β) ∧ Surjective (Limits.pullback.fst g β) ∧ ∃ V : C.Opens, V ≠ ⊥ ∧ IsFinite ((Limits.pullback.fst g β) ∣_ V) :=
by
  intro P' P'' C _ _ β g hg hβprop hβsurj hV
  obtain ⟨V, hV, hVfin⟩ := hV
  haveI := hβprop
  haveI := hβsurj
  haveI := hg
  refine ⟨inferInstance, inferInstance, g ⁻¹ᵁ V, ?_, ?_⟩
  · rw [TopologicalSpace.Opens.ne_bot_iff_nonempty] at hV ⊢
    obtain ⟨v, hv⟩ := hV
    have hη : genericPoint P' ∈ V :=
      ((genericPoint_spec P').mem_open_set_iff V.isOpen).mpr ⟨v, trivial, hv⟩
    obtain ⟨c⟩ := (IsIntegral.nonempty : Nonempty C)
    obtain ⟨c', -, hc'⟩ := Flat.generalizingMap g (genericPoint_specializes (g c))
    refine ⟨c', ?_⟩
    show c' ∈ g ⁻¹ᵁ V
    rw [Scheme.Hom.mem_preimage, hc']
    exact hη
  · have hA := (isPullback_morphismRestrict (Limits.pullback.fst g β) (g ⁻¹ᵁ V)).flip
    have hB := (IsPullback.of_hasPullback g β).flip
    have hRect := hA.paste_horiz hB
    rw [← morphismRestrict_ι g V] at hRect
    have hR := (isPullback_morphismRestrict β V).flip
    have w : ((Limits.pullback.fst g β ⁻¹ᵁ g ⁻¹ᵁ V).ι ≫ Limits.pullback.snd g β) ≫ β =
        (Limits.pullback.fst g β ∣_ (g ⁻¹ᵁ V) ≫ g ∣_ V) ≫ V.ι := by
      simp only [Category.assoc]
      rw [morphismRestrict_ι g V, ← Limits.pullback.condition]
      simp only [← Category.assoc, morphismRestrict_ι]
    rw [← hR.lift_fst _ _ w] at hRect
    have hPB := IsPullback.of_right hRect (hR.lift_snd _ _ w) hR
    exact MorphismProperty.of_isPullback (P := @IsFinite) hPB hVfin

theorem wcpa_dj_ssff_reduced_of_flat : ∀ {Y P' : Scheme.{u}} [AlgebraicGeometry.IsIntegral P'] (g : Y ⟶ P') (V : P'.Opens), Flat g → V ≠ ⊥ → AlgebraicGeometry.IsReduced (g ⁻¹ᵁ V) → AlgebraicGeometry.IsReduced Y :=
by
  intro Y P' _ g V hg hV hred

  have core : ∀ {A B Bs : Type u} [CommRing A] [IsDomain A] [CommRing B] [CommRing Bs]
      [Algebra B Bs] (φ : A →+* B), φ.Flat → ∀ a : A, a ≠ 0 →
      IsLocalization.Away (φ a) Bs → _root_.IsReduced Bs → _root_.IsReduced B := by
    intro A B Bs _ _ _ _ _ φ hφ a ha hloc hBs
    letI := φ.toAlgebra
    haveI : Module.Flat A B := hφ
    refine ⟨fun b hb => ?_⟩
    have h1 : algebraMap B Bs b = 0 := (hb.map (algebraMap B Bs)).eq_zero
    obtain ⟨⟨t, ht⟩, htb⟩ :=
      (IsLocalization.map_eq_zero_iff (Submonoid.powers (φ a)) Bs b).mp h1
    obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp ht
    have hreg : IsSMulRegular B (a ^ n) :=
      Module.Flat.isSMulRegular_of_nonZeroDivisors
        (mem_nonZeroDivisors_of_ne_zero (pow_ne_zero n ha))
    apply hreg
    show a ^ n • b = a ^ n • (0 : B)
    rw [smul_zero, Algebra.smul_def, map_pow]
    exact htb

  have secred : ∀ (O O' : Y.Opens), O ≤ O' → AlgebraicGeometry.IsReduced (O' : Scheme.{u}) →
      _root_.IsReduced Γ(Y, O) := by
    intro O O' h hO'
    haveI := isReduced_of_isOpenImmersion (Y.homOfLE h)
    haveI : _root_.IsReduced Γ((O : Scheme.{u}), ⊤) := IsReduced.component_reduced ⊤
    exact isReduced_of_injective (Scheme.Opens.topIso O).commRingCatIsoToRingEquiv.symm
      (RingEquiv.injective _)
  have hloc : ∀ y : Y, _root_.IsReduced (Y.presheaf.stalk y) := by
    intro y
    obtain ⟨U, hU, hyU, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens P')) (show g y ∈ (⊤ : P'.Opens) from trivial)
    obtain ⟨W, hW, hyW, hWU⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens Y)) (show y ∈ g ⁻¹ᵁ U from hyU)
    obtain ⟨x, hxU, hxV⟩ := nonempty_preirreducible_inter U.isOpen V.isOpen ⟨g y, hyU⟩
      ((TopologicalSpace.Opens.ne_bot_iff_nonempty V).mp hV)
    obtain ⟨a, haV, hxa⟩ := IsAffineOpen.exists_basicOpen_le hU (⟨x, hxV⟩ : V) hxU
    haveI : Nonempty U := ⟨⟨x, hxU⟩⟩
    haveI : IsDomain Γ(P', U) := IsIntegral.component_integral U
    have ha : a ≠ 0 := by
      rintro rfl
      rw [Scheme.basicOpen_zero] at hxa
      simp at hxa
    have hφ : (g.appLE U W hWU).hom.Flat :=
      HasRingHomProperty.appLE @Flat g hg ⟨U, hU⟩ ⟨W, hW⟩ hWU
    have hbo : Y.basicOpen ((g.appLE U W hWU).hom a) ≤ g ⁻¹ᵁ V :=
      (Scheme.basicOpen_appLE g W U hWU a).le.trans (le_trans inf_le_right (fun z hz => haV hz))
    have hBs : _root_.IsReduced Γ(Y, Y.basicOpen ((g.appLE U W hWU).hom a)) :=
      secred _ _ hbo hred
    haveI hWred : _root_.IsReduced Γ(Y, W) :=
      core (g.appLE U W hWU).hom hφ a ha (hW.isLocalization_basicOpen _) hBs
    haveI : IsAffine (W : Scheme.{u}) := hW
    haveI : _root_.IsReduced Γ((W : Scheme.{u}), ⊤) :=
      isReduced_of_injective (Scheme.Opens.topIso W).commRingCatIsoToRingEquiv
        (RingEquiv.injective _)
    haveI : AlgebraicGeometry.IsReduced (W : Scheme.{u}) := isReduced_of_isAffine_isReduced _
    haveI := isReduced_stalk_of_isReduced (W : Scheme.{u}) ⟨y, hyW⟩
    exact isReduced_of_injective
      (Scheme.Opens.stalkIso W ⟨y, hyW⟩).commRingCatIsoToRingEquiv.symm (RingEquiv.injective _)
  exact @isReduced_of_isReduced_stalk Y hloc

theorem wcpa_dj_ssff_multisection_package : ∀ (k : Type u) [Field k] (X P : Scheme.{u}) [AlgebraicGeometry.IsIntegral X] [AlgebraicGeometry.IsIntegral P] (sP : P ⟶ Spec (.of k)) (f : X ⟶ P), wcpaDjIsProjOver k (f ≫ sP) → wcpaDjIsProjOver k sP → Flat f → ∀ U : P.Opens, U ≠ ⊥ → SmoothOfRelativeDimension 1 (f ∣_ U) → GeometricallyConnected (f ∣_ U) → ∀ (n : ℕ) (σ : Fin n → (P ⟶ X)), (∀ i, σ i ≫ f = 𝟙 P) → (∀ (i j : Fin n) (p : P), p ∈ U → i ≠ j → σ i p ≠ σ j p) → ∀ (D₀ : Scheme.{u}) (ι₀ : D₀ ⟶ X), IsClosedImmersion ι₀ → AlgebraicGeometry.IsReduced D₀ → Set.range ⇑ι₀ = ⋃ i, Set.range ⇑(σ i) → ∀ (P' : Scheme.{u}) [AlgebraicGeometry.IsIntegral P'] (β : P' ⟶ P) (D' : Scheme.{u}) (ι : D' ⟶ Limits.pullback (ι₀ ≫ f) β), wcpaDjIsProjOver k (β ≫ sP) → IsProper β → Surjective β → (∃ V : P.Opens, V ≠ ⊥ ∧ IsFinite (β ∣_ V)) → IsIso (β ∣_ U) → IsClosedImmersion ι → IsIso (ι ∣_ ((Limits.pullback.snd (ι₀ ≫ f) β) ⁻¹ᵁ (β ⁻¹ᵁ U))) → Flat (ι ≫ Limits.pullback.snd (ι₀ ≫ f) β) → ∃ (X₃ : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral X₃) (f₃ : X₃ ⟶ P') (α₃ : X₃ ⟶ X), α₃ ≫ f = f₃ ≫ β ∧ wcpaDjIsProjOver k (f₃ ≫ β ≫ sP) ∧ Flat f₃ ∧ IsProper α₃ ∧ Surjective α₃ ∧ (∃ V : X.Opens, V ≠ ⊥ ∧ IsFinite (α₃ ∣_ V)) ∧ ∃ (U₂ : P'.Opens) (σ' : Fin n → (P' ⟶ X₃)) (D : Scheme.{u}) (ιD : D ⟶ X₃), U₂ ≠ ⊥ ∧ SmoothOfRelativeDimension 1 (f₃ ∣_ U₂) ∧ GeometricallyConnected (f₃ ∣_ U₂) ∧ (∀ i, σ' i ≫ f₃ = 𝟙 P') ∧ (∀ (i j : Fin n) (p : P'), p ∈ U₂ → i ≠ j → σ' i p ≠ σ' j p) ∧ IsClosedImmersion ιD ∧ AlgebraicGeometry.IsReduced D ∧ Flat (ιD ≫ f₃) ∧ Set.range ⇑ιD = ⋃ i, Set.range ⇑(σ' i) ∧ ⇑α₃ ⁻¹' ((⋃ i, Set.range ⇑(σ i)) ∪ ⇑f ⁻¹' ((U : Set P)ᶜ)) ⊆ (⋃ i, Set.range ⇑(σ' i)) ∪ ⇑f₃ ⁻¹' ((U₂ : Set P')ᶜ) :=
by
  intro k _ X P _ _ sP f hX hP hflat U hU hsm hgc n σ hσ hσd D₀ ι₀ hι₀ hD₀red hD₀range P' _ β D'
    ι hβproj hβprop hβsurj hβfin hβiso hι hιiso hιflat
  classical
  haveI := hD₀red
  haveI := hβprop
  haveI := hflat
  haveI := hι
  haveI := hι₀
  haveI := hβiso
  haveI := hιiso

  have hpt : ∀ {A B C : Scheme.{u}} (a : A ⟶ B) (b : B ⟶ C) (c : A ⟶ C), a ≫ b = c →
      ∀ x, b (a x) = c x := by
    intro A B C a b c h x
    subst h
    first
      | exact (Scheme.Hom.comp_apply a b x).symm
      | rfl
      | simp
  have hid : ∀ {A : Scheme.{u}} (x : A), (𝟙 A : A ⟶ A) x = x := by
    intro A x
    first
      | rfl
      | simp

  haveI hsPp : IsProper sP := wcpa_dj_proj_proper k sP hP
  haveI hfsPp : IsProper (f ≫ sP) := wcpa_dj_proj_proper k _ hX
  haveI hfp : IsProper f := IsProper.of_comp f sP
  haveI hβsPp : IsProper (β ≫ sP) := wcpa_dj_proj_proper k _ hβproj
  haveI : IsLocallyNoetherian P' := LocallyOfFiniteType.isLocallyNoetherian (β ≫ sP)
  have hpb : IsPullback (Limits.pullback.fst f β) (Limits.pullback.snd f β) f β :=
    IsPullback.of_hasPullback f β
  have hflat₃ : Flat (Limits.pullback.snd f β) :=
    MorphismProperty.of_isPullback (P := @Flat) hpb hflat
  have hlft : LocallyOfFiniteType (Limits.pullback.snd f β) :=
    MorphismProperty.of_isPullback (P := @LocallyOfFiniteType) hpb inferInstance
  have hcond : ∀ c : ((Limits.pullback f β : Scheme.{u}) : Type u),
      f (Limits.pullback.fst f β c) = β (Limits.pullback.snd f β c) := fun c =>
    (hpt (Limits.pullback.fst f β) f _ Limits.pullback.condition c).trans
      (hpt (Limits.pullback.snd f β) β _ rfl c).symm

  have hV : β ⁻¹ᵁ U ≠ ⊥ := by
    rw [TopologicalSpace.Opens.ne_bot_iff_nonempty] at hU ⊢
    obtain ⟨u, hu⟩ := hU
    let w : (β ⁻¹ᵁ U : Scheme.{u}) := inv (β ∣_ U) (⟨u, hu⟩ : ↥U)
    exact ⟨w.1, w.2⟩

  have hsm₂ : SmoothOfRelativeDimension 1 ((Limits.pullback.snd f β) ∣_ (β ⁻¹ᵁ U)) :=
    wcpa_dj_tr_basechange_smooth P P' X β f U hsm
  have hgc₂ : GeometricallyConnected ((Limits.pullback.snd f β) ∣_ (β ⁻¹ᵁ U)) := by
    have hA := isPullback_morphismRestrict f U
    have hB := isPullback_morphismRestrict (Limits.pullback.snd f β) (β ⁻¹ᵁ U)
    have hC : β ∣_ U ≫ U.ι = (β ⁻¹ᵁ U).ι ≫ β := morphismRestrict_ι β U
    have hD : (Limits.pullback.snd f β) ∣_ (β ⁻¹ᵁ U) ≫ (β ⁻¹ᵁ U).ι =
        ((Limits.pullback.snd f β) ⁻¹ᵁ (β ⁻¹ᵁ U)).ι ≫ Limits.pullback.snd f β :=
      morphismRestrict_ι _ _
    have hw : ((Limits.pullback.snd f β) ∣_ (β ⁻¹ᵁ U) ≫ β ∣_ U) ≫ U.ι =
        (((Limits.pullback.snd f β) ⁻¹ᵁ (β ⁻¹ᵁ U)).ι ≫ Limits.pullback.fst f β) ≫ f := by
      rw [Category.assoc, hC, ← Category.assoc, hD, Category.assoc, Category.assoc,
        Limits.pullback.condition]
    let h := hA.lift _ _ hw
    have hE : h ≫ f ∣_ U = (Limits.pullback.snd f β) ∣_ (β ⁻¹ᵁ U) ≫ β ∣_ U :=
      hA.lift_fst _ _ hw
    have hF : h ≫ (f ⁻¹ᵁ U).ι =
        ((Limits.pullback.snd f β) ⁻¹ᵁ (β ⁻¹ᵁ U)).ι ≫ Limits.pullback.fst f β :=
      hA.lift_snd _ _ hw
    have hrect := IsPullback.paste_horiz hB.flip (IsPullback.of_hasPullback f β)
    rw [← hF, ← hC] at hrect
    have hpb' : IsPullback h ((Limits.pullback.snd f β) ∣_ (β ⁻¹ᵁ U)) (f ∣_ U) (β ∣_ U) :=
      IsPullback.of_right hrect hE hA.flip
    exact MorphismProperty.of_isPullback (P := @GeometricallyConnected) hpb' hgc

  haveI hX₃ : AlgebraicGeometry.IsIntegral (Limits.pullback f β) :=
    wcpa_dj_ssp_integral_of_flat (Limits.pullback.snd f β) hflat₃ hlft (β ⁻¹ᵁ U) hV hsm₂ hgc₂

  obtain ⟨hαp, hαs, hαf⟩ := wcpa_dj_tr_basechange_alteration P P' X β f hflat hβprop hβsurj hβfin
  have hproj : wcpaDjIsProjOver k (Limits.pullback.snd f β ≫ β ≫ sP) :=
    wcpa_dj_tr_basechange_proj k P P' X sP (β ≫ sP) β f rfl hP hβproj hX

  let σ' : Fin n → (P' ⟶ Limits.pullback f β) := fun i =>
    Limits.pullback.lift (β ≫ σ i) (𝟙 P')
      (by rw [Category.assoc, hσ i, Category.comp_id, Category.id_comp])
  have hσ'snd : ∀ i, σ' i ≫ Limits.pullback.snd f β = 𝟙 P' := fun i =>
    Limits.pullback.lift_snd _ _ _
  have hσ'fst : ∀ i, σ' i ≫ Limits.pullback.fst f β = β ≫ σ i := fun i =>
    Limits.pullback.lift_fst _ _ _

  have hPU : ∀ (i : Fin n) (c : ((Limits.pullback f β : Scheme.{u}) : Type u)) (q : P), Limits.pullback.fst f β c = σ i q →
      c = σ' i (Limits.pullback.snd f β c) := by
    intro i c q hc
    have e1 : f (σ i q) = q := (hpt (σ i) f _ (hσ i) q).trans (hid q)
    have hq : q = β (Limits.pullback.snd f β c) := by rw [← e1, ← hc, hcond c]
    exact (wcpa_dj_mm_section_point_unique X P P' (Limits.pullback f β) f β
      (Limits.pullback.fst f β) (Limits.pullback.snd f β) (σ i) (σ' i) hpb (hσ i) (hσ'snd i)
      (hσ'fst i) c).mp (by rw [hc, hq])

  have hdisj : ∀ (i j : Fin n) (p : P'), p ∈ β ⁻¹ᵁ U → i ≠ j → σ' i p ≠ σ' j p := by
    intro i j p hp hij heq
    have a : ∀ l, σ l (β p) = Limits.pullback.fst f β (σ' l p) := fun l =>
      (hpt β (σ l) _ rfl p).trans (hpt (σ' l) (Limits.pullback.fst f β) _ (hσ'fst l) p).symm
    apply hσd i j (β p) hp hij
    rw [a i, a j, heq]

  have hbd : ⇑(Limits.pullback.fst f β) ⁻¹' ((⋃ i, Set.range ⇑(σ i)) ∪ ⇑f ⁻¹' ((U : Set P)ᶜ)) ⊆
      (⋃ i, Set.range ⇑(σ' i)) ∪
        ⇑(Limits.pullback.snd f β) ⁻¹' (((β ⁻¹ᵁ U : P'.Opens) : Set P')ᶜ) := by
    intro c hc
    by_cases hcV : Limits.pullback.snd f β c ∈ β ⁻¹ᵁ U
    · left
      rcases hc with h | h
      · obtain ⟨i, q, hq⟩ := Set.mem_iUnion.mp h
        exact Set.mem_iUnion.mpr ⟨i, _, (hPU i c q hq.symm).symm⟩
      · exfalso
        apply h
        show f (Limits.pullback.fst f β c) ∈ U
        rw [hcond c]
        exact hcV
    · right
      exact hcV

  let m : Limits.pullback (ι₀ ≫ f) β ⟶ Limits.pullback f β :=
    Limits.pullback.lift (Limits.pullback.fst (ι₀ ≫ f) β ≫ ι₀) (Limits.pullback.snd (ι₀ ≫ f) β)
      (by rw [Category.assoc, Limits.pullback.condition])
  have hm1 : m ≫ Limits.pullback.fst f β = Limits.pullback.fst (ι₀ ≫ f) β ≫ ι₀ :=
    Limits.pullback.lift_fst _ _ _
  have hm2 : m ≫ Limits.pullback.snd f β = Limits.pullback.snd (ι₀ ≫ f) β :=
    Limits.pullback.lift_snd _ _ _
  have hmpb : IsPullback m (Limits.pullback.fst (ι₀ ≫ f) β) (Limits.pullback.fst f β) ι₀ := by
    have houter : IsPullback (m ≫ Limits.pullback.snd f β) (Limits.pullback.fst (ι₀ ≫ f) β) β
        (ι₀ ≫ f) := by
      rw [hm2]
      exact (IsPullback.of_hasPullback (ι₀ ≫ f) β).flip
    exact IsPullback.of_right houter hm1 hpb.flip
  haveI hmci : IsClosedImmersion m :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hmpb.flip hι₀
  have hflatD : Flat ((ι ≫ m) ≫ Limits.pullback.snd f β) := by
    rw [Category.assoc, hm2]
    exact hιflat

  have hD'red : AlgebraicGeometry.IsReduced D' := by
    haveI h1 : AlgebraicGeometry.IsReduced ((ι₀ ≫ f) ⁻¹ᵁ U) :=
      isReduced_of_isOpenImmersion ((ι₀ ≫ f) ⁻¹ᵁ U).ι
    haveI : IsIso ((Limits.pullback.fst (ι₀ ≫ f) β) ∣_ ((ι₀ ≫ f) ⁻¹ᵁ U)) :=
      wc_isIso_restrict_pullback_fst (ι₀ ≫ f) β U hβiso
    haveI h2 : AlgebraicGeometry.IsReduced
        ((Limits.pullback.fst (ι₀ ≫ f) β) ⁻¹ᵁ ((ι₀ ≫ f) ⁻¹ᵁ U)) :=
      isReduced_of_isOpenImmersion ((Limits.pullback.fst (ι₀ ≫ f) β) ∣_ ((ι₀ ≫ f) ⁻¹ᵁ U))
    have hWeq : (Limits.pullback.snd (ι₀ ≫ f) β) ⁻¹ᵁ (β ⁻¹ᵁ U) =
        (Limits.pullback.fst (ι₀ ≫ f) β) ⁻¹ᵁ ((ι₀ ≫ f) ⁻¹ᵁ U) := by
      rw [← Scheme.Hom.comp_preimage, ← Scheme.Hom.comp_preimage, Limits.pullback.condition]
    haveI h3 : AlgebraicGeometry.IsReduced ((Limits.pullback.snd (ι₀ ≫ f) β) ⁻¹ᵁ (β ⁻¹ᵁ U)) := by
      rw [hWeq]
      exact h2
    haveI h4 : AlgebraicGeometry.IsReduced
        (ι ⁻¹ᵁ ((Limits.pullback.snd (ι₀ ≫ f) β) ⁻¹ᵁ (β ⁻¹ᵁ U))) :=
      isReduced_of_isOpenImmersion (ι ∣_ ((Limits.pullback.snd (ι₀ ≫ f) β) ⁻¹ᵁ (β ⁻¹ᵁ U)))
    have h5 : AlgebraicGeometry.IsReduced ((ι ≫ Limits.pullback.snd (ι₀ ≫ f) β) ⁻¹ᵁ (β ⁻¹ᵁ U)) := by
      rw [Scheme.Hom.comp_preimage]
      exact h4
    exact wcpa_dj_ssff_reduced_of_flat (ι ≫ Limits.pullback.snd (ι₀ ≫ f) β) (β ⁻¹ᵁ U) hιflat hV h5

  have hrange : Set.range ⇑(ι ≫ m) = ⋃ i, Set.range ⇑(σ' i) := by
    apply Set.Subset.antisymm
    · rintro _ ⟨x, rfl⟩
      have a := hpt ι m _ rfl x
      have b := hpt m (Limits.pullback.fst f β) _ hm1 (ι x)
      have c := hpt (Limits.pullback.fst (ι₀ ≫ f) β) ι₀ _ rfl (ι x)
      have h1 : Limits.pullback.fst f β ((ι ≫ m) x) =
          ι₀ (Limits.pullback.fst (ι₀ ≫ f) β (ι x)) := by
        rw [← a]
        exact b.trans c.symm
      have h2 : ι₀ (Limits.pullback.fst (ι₀ ≫ f) β (ι x)) ∈ ⋃ i, Set.range ⇑(σ i) := by
        rw [← hD₀range]
        exact ⟨_, rfl⟩
      obtain ⟨i, q, hq⟩ := Set.mem_iUnion.mp h2
      exact Set.mem_iUnion.mpr ⟨i, _, (hPU i _ q (h1.trans hq.symm)).symm⟩
    · intro y hy
      obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hy
      obtain ⟨p, rfl⟩ := hi
      have hcl : IsClosed (Set.range ⇑(ι ≫ m)) := (ι ≫ m).isClosedEmbedding.isClosed_range
      have hS : IsClosed (⇑(σ' i) ⁻¹' Set.range ⇑(ι ≫ m)) := hcl.preimage (σ' i).continuous
      have hVS : ((β ⁻¹ᵁ U : P'.Opens) : Set P') ⊆ ⇑(σ' i) ⁻¹' Set.range ⇑(ι ≫ m) := by
        intro r hr
        have hmem : σ i (β r) ∈ Set.range ⇑ι₀ := by
          rw [hD₀range]
          exact Set.mem_iUnion.mpr ⟨i, β r, rfl⟩
        obtain ⟨d, hd⟩ := hmem
        have hd2 : (ι₀ ≫ f) d = β r := by
          rw [← hpt ι₀ f _ rfl d, hd]
          exact (hpt (σ i) f _ (hσ i) (β r)).trans (hid _)
        obtain ⟨z, hz1, hz2⟩ :=
          Scheme.Pullback.exists_preimage_pullback (f := ι₀ ≫ f) (g := β) d r hd2
        have hzW : z ∈ (Limits.pullback.snd (ι₀ ≫ f) β) ⁻¹ᵁ (β ⁻¹ᵁ U) := by
          rw [Scheme.Hom.mem_preimage, hz2]
          exact hr
        obtain ⟨x', hx'⟩ : ∃ x', (ι ∣_ ((Limits.pullback.snd (ι₀ ≫ f) β) ⁻¹ᵁ (β ⁻¹ᵁ U))) x' =
            (⟨z, hzW⟩ : ↥((Limits.pullback.snd (ι₀ ≫ f) β) ⁻¹ᵁ (β ⁻¹ᵁ U))) :=
          ⟨inv (ι ∣_ ((Limits.pullback.snd (ι₀ ≫ f) β) ⁻¹ᵁ (β ⁻¹ᵁ U))) ⟨z, hzW⟩,
            (hpt _ _ _ (IsIso.inv_hom_id _) _).trans (hid _)⟩
        have hz : ι x'.1 = z := by
          rw [← morphismRestrict_base_coe ι _ x', hx']
        have hmz1 : Limits.pullback.fst f β (m z) = σ i (β r) := by
          rw [hpt _ _ _ hm1 z, ← hpt (Limits.pullback.fst (ι₀ ≫ f) β) ι₀ _ rfl z, hz1, hd]
        have hmz2 : Limits.pullback.snd f β (m z) = r := by
          rw [hpt _ _ _ hm2 z, hz2]
        have hmz := hPU i (m z) (β r) hmz1
        rw [hmz2] at hmz
        show σ' i r ∈ Set.range ⇑(ι ≫ m)
        refine ⟨x'.1, ?_⟩
        rw [← hpt ι m _ rfl x'.1, hz, hmz]
      have hne : ((β ⁻¹ᵁ U : P'.Opens) : Set P').Nonempty :=
        (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mp hV
      have hdense : Dense ((β ⁻¹ᵁ U : P'.Opens) : Set P') := (β ⁻¹ᵁ U).isOpen.dense hne
      have hall : ⇑(σ' i) ⁻¹' Set.range ⇑(ι ≫ m) = Set.univ := by
        apply Set.eq_univ_of_univ_subset
        rw [← hdense.closure_eq]
        exact closure_minimal hVS hS
      have hp' : p ∈ ⇑(σ' i) ⁻¹' Set.range ⇑(ι ≫ m) := by
        rw [hall]
        exact Set.mem_univ p
      exact hp'
  exact ⟨Limits.pullback f β, hX₃, Limits.pullback.snd f β, Limits.pullback.fst f β,
    Limits.pullback.condition, hproj, hflat₃, hαp, hαs, hαf, β ⁻¹ᵁ U, σ', D', ι ≫ m, hV, hsm₂,
    hgc₂, hσ'snd, hdisj, inferInstance, hD'red, hflatD, hrange, hbd⟩

theorem wcpa_dj_ssff_sections_union_flat : ∀ {Y B : Scheme.{u}} [AlgebraicGeometry.IsReduced B] (g : Y ⟶ B), IsSeparated g → ∀ (n : ℕ) (σ : Fin n → (B ⟶ Y)), (∀ i, σ i ≫ g = 𝟙 B) → ∀ V : B.Opens, (∀ (i j : Fin n) (p : B), p ∈ V → i ≠ j → σ i p ≠ σ j p) → ∀ (D : Scheme.{u}) (ιD : D ⟶ Y), IsClosedImmersion ιD → AlgebraicGeometry.IsReduced D → Set.range ⇑ιD = ⋃ i, Set.range ⇑(σ i) → Flat ((ιD ≫ g) ∣_ V) :=
by
  intro Y B _ g hsep n σ hσ V hdisj D ιD hιD hDred hrange
  have := hsep
  have := hιD
  have := hDred
  have hmemι : ∀ {X : Scheme.{u}} (W : X.Opens) (x : W.toScheme), W.ι x ∈ W := by
    intro X W x
    rw [← SetLike.mem_coe, ← Scheme.Opens.range_ι]
    exact ⟨x, rfl⟩

  have hlift : ∀ (R S C : Scheme.{u}) [AlgebraicGeometry.IsReduced R] (a : R ⟶ S)
      (j : C ⟶ S) [IsClosedImmersion j], Set.range ⇑a ⊆ Set.range ⇑j →
      ∃ b : R ⟶ C, b ≫ j = a := by
    intro R S C _ a j _ hra
    have H : Scheme.Hom.ker j ≤ Scheme.Hom.ker a := by
      rw [Scheme.Hom.ker.eq_1 a, Scheme.IdealSheafData.le_ofIdeals_iff]
      intro U s hs
      rw [Scheme.Hom.ker_apply, RingHom.mem_ker] at hs
      rw [RingHom.mem_ker]
      apply eq_zero_of_basicOpen_eq_bot
      rw [← Scheme.Hom.preimage_basicOpen]
      have hj : j ⁻¹ᵁ S.basicOpen s = ⊥ := by
        rw [Scheme.Hom.preimage_basicOpen, hs, Scheme.basicOpen_zero]
      rw [← TopologicalSpace.Opens.not_nonempty_iff_eq_bot]
      rintro ⟨x, hx⟩
      obtain ⟨c, hc⟩ := hra ⟨x, rfl⟩
      have hc' : c ∈ j ⁻¹ᵁ S.basicOpen s := by
        show j c ∈ S.basicOpen s
        rw [hc]
        exact hx
      rw [hj] at hc'
      exact hc'
    exact ⟨IsClosedImmersion.lift j a H, IsClosedImmersion.lift_fac j a H⟩

  have hloc : ∀ (σ0 : B ⟶ Y), σ0 ≫ g = 𝟙 B → IsClosedImmersion σ0 → ∀ O : Y.Opens,
      Set.range ⇑σ0 ⊆ Set.range ⇑ιD →
      (∀ y : Y, y ∈ O → y ∈ Set.range ⇑ιD → y ∈ Set.range ⇑σ0) →
      IsOpenImmersion ((ιD ⁻¹ᵁ O).ι ≫ ιD ≫ g) := by
    intro σ0 hσ0 hσ0c O hsub hO
    have := hσ0c
    obtain ⟨a, ha⟩ := hlift (ιD ⁻¹ᵁ O) Y B ((ιD ⁻¹ᵁ O).ι ≫ ιD) σ0 (by
      rintro _ ⟨r, rfl⟩
      apply hO
      · rw [Scheme.Hom.comp_apply, ← Scheme.Hom.mem_preimage]
        exact hmemι (ιD ⁻¹ᵁ O) r
      · exact ⟨_, rfl⟩)
    obtain ⟨b, hb⟩ := hlift (σ0 ⁻¹ᵁ O) Y D ((σ0 ⁻¹ᵁ O).ι ≫ σ0) ιD (by
      rintro _ ⟨r, rfl⟩
      exact hsub ⟨_, rfl⟩)
    have hra : Set.range ⇑a ⊆ Set.range ⇑(σ0 ⁻¹ᵁ O).ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨r, rfl⟩
      have e : σ0 (a r) = ιD ((ιD ⁻¹ᵁ O).ι r) := by
        rw [← Scheme.Hom.comp_apply, ha, Scheme.Hom.comp_apply]
      rw [SetLike.mem_coe, Scheme.Hom.mem_preimage, e, ← Scheme.Hom.mem_preimage]
      exact hmemι (ιD ⁻¹ᵁ O) r
    have hrb : Set.range ⇑b ⊆ Set.range ⇑(ιD ⁻¹ᵁ O).ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨r, rfl⟩
      have e : ιD (b r) = σ0 ((σ0 ⁻¹ᵁ O).ι r) := by
        rw [← Scheme.Hom.comp_apply, hb, Scheme.Hom.comp_apply]
      rw [SetLike.mem_coe, Scheme.Hom.mem_preimage, e, ← Scheme.Hom.mem_preimage]
      exact hmemι (σ0 ⁻¹ᵁ O) r
    set a' := IsOpenImmersion.lift (σ0 ⁻¹ᵁ O).ι a hra with ha'def
    set b' := IsOpenImmersion.lift (ιD ⁻¹ᵁ O).ι b hrb with hb'def
    have haf : a' ≫ (σ0 ⁻¹ᵁ O).ι = a := IsOpenImmersion.lift_fac _ _ _
    have hbf : b' ≫ (ιD ⁻¹ᵁ O).ι = b := IsOpenImmersion.lift_fac _ _ _
    have h1 : a' ≫ b' = 𝟙 _ := by
      rw [← cancel_mono ((ιD ⁻¹ᵁ O).ι ≫ ιD)]
      rw [Category.id_comp, Category.assoc, ← Category.assoc b', hbf, hb, ← Category.assoc,
        haf, ha]
    have h2 : b' ≫ a' = 𝟙 _ := by
      rw [← cancel_mono ((σ0 ⁻¹ᵁ O).ι ≫ σ0)]
      rw [Category.id_comp, Category.assoc, ← Category.assoc a', haf, ha, ← Category.assoc,
        hbf, hb]
    have : IsIso a' := ⟨⟨b', h1, h2⟩⟩
    have heq : (ιD ⁻¹ᵁ O).ι ≫ ιD ≫ g = a' ≫ (σ0 ⁻¹ᵁ O).ι := by
      rw [← Category.assoc, ← ha, Category.assoc, hσ0, Category.comp_id, haf]
    rw [heq]
    infer_instance

  have hflat : ∀ (R : Fin n → D.Opens), (∀ e : D, (ιD ≫ g) e ∈ V → ∃ i, e ∈ R i) →
      (∀ i, IsOpenImmersion ((R i).ι ≫ ιD ≫ g)) → Flat ((ιD ≫ g) ∣_ V) := by
    intro R hcov hR
    let U : Fin n → ((ιD ≫ g) ⁻¹ᵁ V).toScheme.Opens :=
      fun i => ((ιD ≫ g) ⁻¹ᵁ V).ι ⁻¹ᵁ (R i)
    have hU : iSup U = ⊤ := by
      rw [eq_top_iff]
      rintro x -
      rw [TopologicalSpace.Opens.mem_iSup]
      obtain ⟨i, hi⟩ := hcov (((ιD ≫ g) ⁻¹ᵁ V).ι x) (by
        rw [← Scheme.Hom.mem_preimage]
        exact hmemι ((ιD ≫ g) ⁻¹ᵁ V) x)
      exact ⟨i, hi⟩
    have hZL : IsZariskiLocalAtSource @Flat.{u} :=
      @HasRingHomProperty.instIsZariskiLocalAtSource _ _ Flat.instHasRingHomPropertyFlat
    refine @IsZariskiLocalAtSource.of_iSup_eq_top @Flat.{u} hZL _ _ _ _ U hU (fun i => ?_)
    have hrange' : Set.range ⇑((U i).ι ≫ ((ιD ≫ g) ⁻¹ᵁ V).ι) ⊆ Set.range ⇑(R i).ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨u, rfl⟩
      rw [Scheme.Hom.comp_apply, SetLike.mem_coe, ← Scheme.Hom.mem_preimage]
      exact hmemι (U i) u
    set c := IsOpenImmersion.lift (R i).ι ((U i).ι ≫ ((ιD ≫ g) ⁻¹ᵁ V).ι) hrange' with hcdef
    have hc : c ≫ (R i).ι = (U i).ι ≫ ((ιD ≫ g) ⁻¹ᵁ V).ι := IsOpenImmersion.lift_fac _ _ _
    have : IsOpenImmersion (c ≫ (R i).ι) := by rw [hc]; infer_instance
    have : IsOpenImmersion c := IsOpenImmersion.of_comp c (R i).ι
    have := hR i
    have : IsOpenImmersion (((U i).ι ≫ (ιD ≫ g) ∣_ V) ≫ V.ι) := by
      rw [Category.assoc, morphismRestrict_ι, ← Category.assoc, ← hc, Category.assoc]
      infer_instance
    have : IsOpenImmersion ((U i).ι ≫ (ιD ≫ g) ∣_ V) := IsOpenImmersion.of_comp _ V.ι
    infer_instance

  have hcl : ∀ i, IsClosedImmersion (σ i) := fun i => by
    have : IsClosedImmersion (σ i ≫ g) := by rw [hσ i]; infer_instance
    exact IsClosedImmersion.of_comp (σ i) g
  have hTcl : ∀ i, IsClosed (⋃ j, ⋃ (_ : j ≠ i), Set.range ⇑(σ j)) := fun i =>
    isClosed_iUnion_of_finite fun j => isClosed_iUnion_of_finite fun _ =>
      (@Scheme.Hom.isClosedEmbedding _ _ (σ j) (hcl j)).isClosed_range
  let O : Fin n → Y.Opens := fun i =>
    ⟨(⋃ j, ⋃ (_ : j ≠ i), Set.range ⇑(σ j))ᶜ, isOpen_compl_iff.mpr (hTcl i)⟩
  have hgp : ∀ k x, g (σ k x) = x := fun k x => by
    rw [← Scheme.Hom.comp_apply, hσ k]
    rfl
  refine hflat (fun i => ιD ⁻¹ᵁ O i) ?_ (fun i => hloc (σ i) (hσ i) (hcl i) (O i) ?_ ?_)
  · intro e he
    have hy : ιD e ∈ ⋃ i, Set.range ⇑(σ i) := hrange ▸ ⟨e, rfl⟩
    rw [Set.mem_iUnion] at hy
    obtain ⟨i, p, hp⟩ := hy
    refine ⟨i, ?_⟩
    rw [Scheme.Hom.mem_preimage]
    intro hmem
    obtain ⟨j, hji, p', hp'⟩ := Set.mem_iUnion₂.mp hmem
    have e1 : p = g (ιD e) := by rw [← hp, hgp]
    have e2 : p' = g (ιD e) := by rw [← hp', hgp]
    have hpV : p ∈ V := by
      rw [e1]
      rwa [Scheme.Hom.comp_apply] at he
    have e3 : p' = p := e2.trans e1.symm
    rw [e3] at hp'
    exact hdisj i j p hpV (Ne.symm hji) (hp.trans hp'.symm)
  · rw [hrange]
    exact Set.subset_iUnion (fun j => Set.range ⇑(σ j)) i
  · intro y hy hyD
    rw [hrange, Set.mem_iUnion] at hyD
    obtain ⟨j, hj⟩ := hyD
    by_cases hji : j = i
    · subst hji
      exact hj
    · exact (hy (Set.mem_iUnion₂.mpr ⟨j, hji, hj⟩)).elim

theorem wcpa_dj_ssff_sections_reduced_union : ∀ {Y B : Scheme.{u}} (g : Y ⟶ B), IsSeparated g → ∀ (n : ℕ) (σ : Fin n → (B ⟶ Y)), (∀ i, σ i ≫ g = 𝟙 B) → ∃ (D : Scheme.{u}) (ιD : D ⟶ Y), IsClosedImmersion ιD ∧ AlgebraicGeometry.IsReduced D ∧ Set.range ⇑ιD = ⋃ i, Set.range ⇑(σ i) :=
by
  intro Y B g hg n σ hσ
  haveI := hg
  have hci : ∀ i, IsClosedImmersion (σ i) := by
    intro i
    haveI : IsClosedImmersion (σ i ≫ g) := by rw [hσ i]; infer_instance
    exact IsClosedImmersion.of_comp (σ i) g
  have hZ : IsClosed (⋃ i, Set.range ⇑(σ i)) := by
    apply isClosed_iUnion_of_finite
    intro i
    exact (σ i).isClosedEmbedding.isClosed_range
  let I : Y.IdealSheafData :=
    Scheme.IdealSheafData.vanishingIdeal ⟨⋃ i, Set.range ⇑(σ i), hZ⟩
  have hring : ∀ U : Y.affineOpens, _root_.IsReduced (Γ(Y, (U : Y.Opens)) ⧸ I.ideal U) := by
    intro U
    rw [← Ideal.isRadical_iff_quotient_reduced]
    show Ideal.IsRadical ((Scheme.IdealSheafData.vanishingIdeal _).ideal U)
    rw [Scheme.IdealSheafData.vanishingIdeal_ideal]
    exact PrimeSpectrum.isRadical_vanishingIdeal _
  have hpieces : ∀ i, IsReduced (I.subschemeCover.openCover.X i) := fun (U : Y.affineOpens) => by
    haveI := hring U
    exact (inferInstance : IsReduced (Spec (CommRingCat.of (Γ(Y, (U : Y.Opens)) ⧸ I.ideal U))))
  have hD : IsReduced I.subscheme := IsReduced.of_openCover _ I.subschemeCover.openCover
  refine ⟨I.subscheme, I.subschemeι, inferInstance, hD, ?_⟩
  rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.coe_support_vanishingIdeal]
  rfl

theorem wcpa_dj_ssff_admissible_alteration : ∀ (k : Type u) [Field k] (P P' : Scheme.{u}) [AlgebraicGeometry.IsIntegral P] (sP : P ⟶ Spec (.of k)) (β : P' ⟶ P) (U : P.Opens), wcpaDjIsProjOver k sP → wcpaDjIsProjOver k (β ≫ sP) → U ≠ ⊥ → IsIso (β ∣_ U) → IsProper β ∧ Surjective β ∧ (∃ V : P.Opens, V ≠ ⊥ ∧ IsFinite (β ∣_ V)) ∧ β ⁻¹ᵁ U ≠ ⊥ :=
by
  intro k _ P P' _ sP β U hP hβP hU hiso
  have hpp : ∀ {Y : Scheme.{u}} (s : Y ⟶ Spec (.of k)), wcpaDjIsProjOver k s → IsProper s := by
    intro Y s hs
    obtain ⟨N, j, hj, rfl⟩ := hs
    haveI := hj
    haveI hst : IsScalarTower k (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0))
        (MvPolynomial (Fin (N + 1)) k) :=
      IsScalarTower.of_algebraMap_eq
        (S := ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)) (fun c => by
          rw [SetLike.GradeZero.algebraMap_apply]
          exact (SetLike.GradeZero.coe_algebraMap
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) c).symm)
    haveI : Algebra.FiniteType (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0))
        (MvPolynomial (Fin (N + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k _ _
    haveI : IsProper (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
        MvPolynomial.gradedAlgebra) := inferInstance
    have hkey : ∀ c : k, ((algebraMap k (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)) c :
        ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)) : MvPolynomial (Fin (N + 1)) k) =
        MvPolynomial.C c := by
      intro c
      rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
    have hbij : Function.Bijective
        (algebraMap k (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0))) := by
      constructor
      · intro a b hab
        have h1 := congrArg (fun x : ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0) =>
          (x : MvPolynomial (Fin (N + 1)) k)) hab
        simp only [hkey] at h1
        exact MvPolynomial.C_injective _ _ h1
      · intro p
        have hp : (p : MvPolynomial (Fin (N + 1)) k).IsHomogeneous 0 :=
          (MvPolynomial.mem_homogeneousSubmodule _ _).mp p.2
        have htd : (p : MvPolynomial (Fin (N + 1)) k).totalDegree = 0 :=
          Nat.le_zero.mp hp.totalDegree_le
        refine ⟨(p : MvPolynomial (Fin (N + 1)) k).coeff 0, Subtype.ext ?_⟩
        rw [hkey]
        exact ((MvPolynomial.totalDegree_eq_zero_iff_eq_C).mp htd).symm
    haveI : IsIso (CommRingCat.ofHom
        (algebraMap k (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)))) :=
      (ConcreteCategory.isIso_iff_bijective _).mpr hbij
    infer_instance
  haveI hsP : IsProper sP := hpp sP hP
  haveI hβsP : IsProper (β ≫ sP) := hpp (β ≫ sP) hβP
  haveI hβprop : IsProper β := IsProper.of_comp β sP
  haveI := hiso
  have hstar : ∀ u : P, u ∈ U → ∃ w : P', w ∈ β ⁻¹ᵁ U ∧ β w = u := by
    intro u hu
    obtain ⟨w', hw'⟩ := (β ∣_ U).surjective ⟨u, hu⟩
    refine ⟨w'.1, w'.2, ?_⟩
    have h1 := congrArg Subtype.val hw'
    rw [morphismRestrict_base_coe] at h1
    exact h1
  obtain ⟨u, hu⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).mp hU
  have hne : β ⁻¹ᵁ U ≠ ⊥ := by
    obtain ⟨w, hw, _⟩ := hstar u hu
    exact (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mpr ⟨w, hw⟩
  have hsurj : Surjective β := by
    constructor
    have hclosed : IsClosed (Set.range ⇑β) := β.isClosedMap.isClosed_range
    have hsub : (U : Set P) ⊆ Set.range ⇑β := fun x hx => by
      obtain ⟨w, _, hw⟩ := hstar x hx
      exact ⟨w, hw⟩
    have hdense : Dense (U : Set P) := U.isOpen.dense ⟨u, hu⟩
    intro x
    have hx : x ∈ closure (U : Set P) := by rw [hdense.closure_eq]; trivial
    exact closure_minimal hsub hclosed hx
  exact ⟨hβprop, hsurj, ⟨U, hU, inferInstance⟩, hne⟩

theorem wcpa_dj_ssf_flatten : ∀ (k : Type u) [Field k] [Finite k] (X₂ P₁ : Scheme.{u})
    [AlgebraicGeometry.IsIntegral X₂] [AlgebraicGeometry.IsIntegral P₁] (sP₁ : P₁ ⟶ Spec (.of k))
    (f₂ : X₂ ⟶ P₁), wcpaDjIsProjOver k (f₂ ≫ sP₁) → wcpaDjIsProjOver k sP₁ →
    ∀ U₁ : P₁.Opens, U₁ ≠ ⊥ → SmoothOfRelativeDimension 1 (f₂ ∣_ U₁) →
    GeometricallyConnected (f₂ ∣_ U₁) →
    ∀ (n : ℕ) (σ : Fin n → (P₁ ⟶ X₂)), (∀ i, σ i ≫ f₂ = 𝟙 P₁) →
    (∀ (i j : Fin n) (p : P₁), p ∈ U₁ → i ≠ j → σ i p ≠ σ j p) →
    ∃ (P₂ : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral P₂) (sP₂ : P₂ ⟶ Spec (.of k))
      (β₂ : P₂ ⟶ P₁),
      β₂ ≫ sP₁ = sP₂ ∧ wcpaDjIsProjOver k sP₂ ∧ IsProper β₂ ∧ Surjective β₂ ∧
      (∃ V : P₁.Opens, V ≠ ⊥ ∧ IsFinite (β₂ ∣_ V)) ∧
      ∃ (X₃ : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral X₃) (f₃ : X₃ ⟶ P₂) (α₃ : X₃ ⟶ X₂),
        α₃ ≫ f₂ = f₃ ≫ β₂ ∧ wcpaDjIsProjOver k (f₃ ≫ sP₂) ∧ Flat f₃ ∧
        IsProper α₃ ∧ Surjective α₃ ∧ (∃ V : X₂.Opens, V ≠ ⊥ ∧ IsFinite (α₃ ∣_ V)) ∧
        ∃ (U₂ : P₂.Opens) (σ' : Fin n → (P₂ ⟶ X₃)) (D : Scheme.{u}) (ιD : D ⟶ X₃),
          U₂ ≠ ⊥ ∧ SmoothOfRelativeDimension 1 (f₃ ∣_ U₂) ∧ GeometricallyConnected (f₃ ∣_ U₂) ∧
          (∀ i, σ' i ≫ f₃ = 𝟙 P₂) ∧
          (∀ (i j : Fin n) (p : P₂), p ∈ U₂ → i ≠ j → σ' i p ≠ σ' j p) ∧
          IsClosedImmersion ιD ∧ AlgebraicGeometry.IsReduced D ∧ Flat (ιD ≫ f₃) ∧
          Set.range ⇑ιD = ⋃ i, Set.range ⇑(σ' i) ∧
          ⇑α₃ ⁻¹' ((⋃ i, Set.range ⇑(σ i)) ∪ ⇑f₂ ⁻¹' ((U₁ : Set P₁)ᶜ)) ⊆
            (⋃ i, Set.range ⇑(σ' i)) ∪ ⇑f₃ ⁻¹' ((U₂ : Set P₂)ᶜ) :=
by
  intro k _ _ X₂ P₁ _ _ sP₁ f₂ hX hP U₁ hU hsm hgc n σ hσ hσd
  have hflat₁ : Flat (f₂ ∣_ U₁) := by
    haveI := hsm
    haveI : Smooth (f₂ ∣_ U₁) := SmoothOfRelativeDimension.smooth 1 (f₂ ∣_ U₁)
    infer_instance
  obtain ⟨Q, iQ, β₁, X', ι, hQproj, hβ₁iso, hι, hιiso, hflat⟩ :=
    wcpa_dj_fl_raynaud_gruson k X₂ P₁ sP₁ f₂ U₁ hX hP hU hflat₁
  haveI := iQ
  obtain ⟨hβ₁p, hβ₁s, hβ₁f, hU'⟩ :=
    wcpa_dj_ssff_admissible_alteration k P₁ Q sP₁ β₁ U₁ hP hQproj hU hβ₁iso
  obtain ⟨iX', hX'proj, hap, has, haf, hsm', hgc', σ', hσ', hσ'd, hT₁⟩ :=
    wcpa_dj_ssff_strict_package k X₂ P₁ sP₁ f₂ hX hP U₁ hU hsm hgc n σ hσ hσd Q β₁ X' ι
      hQproj hβ₁p hβ₁iso hι hιiso hflat
  haveI := iX'
  have hsep : IsSeparated (ι ≫ Limits.pullback.snd f₂ β₁) := by
    haveI : IsProper ((ι ≫ Limits.pullback.snd f₂ β₁) ≫ β₁ ≫ sP₁) :=
      wcpa_dj_proj_proper k _ hX'proj
    exact IsSeparated.of_comp (ι ≫ Limits.pullback.snd f₂ β₁) (β₁ ≫ sP₁)
  obtain ⟨D₀, ι₀, hι₀, hD₀red, hD₀range⟩ :=
    wcpa_dj_ssff_sections_reduced_union (ι ≫ Limits.pullback.snd f₂ β₁) hsep n σ' hσ'
  have hflatD : Flat ((ι₀ ≫ ι ≫ Limits.pullback.snd f₂ β₁) ∣_ (β₁ ⁻¹ᵁ U₁)) :=
    wcpa_dj_ssff_sections_union_flat (ι ≫ Limits.pullback.snd f₂ β₁) hsep n σ' hσ'
      (β₁ ⁻¹ᵁ U₁) hσ'd D₀ ι₀ hι₀ hD₀red hD₀range
  have hD₀proj : wcpaDjIsProjOver k ((ι₀ ≫ ι ≫ Limits.pullback.snd f₂ β₁) ≫ β₁ ≫ sP₁) := by
    obtain ⟨N, j, hj, hjeq⟩ := hX'proj
    haveI := hj
    haveI := hι₀
    refine ⟨N, ι₀ ≫ j, inferInstance, ?_⟩
    rw [Category.assoc, hjeq]
    simp only [Category.assoc]
  obtain ⟨P₂, iP₂, β₂', D', ιd, hP₂proj, hβ₂iso, hιd, hιdiso, hflatd⟩ :=
    wcpa_dj_fl_raynaud_gruson k D₀ Q (β₁ ≫ sP₁) (ι₀ ≫ ι ≫ Limits.pullback.snd f₂ β₁)
      (β₁ ⁻¹ᵁ U₁) hD₀proj hQproj hU' hflatD
  haveI := iP₂
  obtain ⟨hβ₂p, hβ₂s, hβ₂f, -⟩ :=
    wcpa_dj_ssff_admissible_alteration k Q P₂ (β₁ ≫ sP₁) β₂' (β₁ ⁻¹ᵁ U₁) hQproj hP₂proj hU'
      hβ₂iso
  obtain ⟨X₃, iX₃, f₃, α₃', hsq, hX₃proj, hflat₃, hα₃p, hα₃s, hα₃f, U₂, σ'', D, ιD, hU₂, hsm₂,
    hgc₂, hσ'', hσ''d, hιD, hDred, hDflat, hDrange, hT₂⟩ :=
    wcpa_dj_ssff_multisection_package k X' Q (β₁ ≫ sP₁) (ι ≫ Limits.pullback.snd f₂ β₁)
      hX'proj hQproj hflat (β₁ ⁻¹ᵁ U₁) hU' hsm' hgc' n σ' hσ' hσ'd D₀ ι₀ hι₀ hD₀red hD₀range
      P₂ β₂' D' ιd hP₂proj hβ₂p hβ₂s hβ₂f hβ₂iso hιd hιdiso hflatd
  haveI := iX₃
  haveI := hβ₁p
  haveI := hβ₂p
  haveI := hap
  haveI := hα₃p
  obtain ⟨hβs, hβf⟩ := wcpa_dj_alteration_comp β₁ β₂' hβ₁p hβ₁s hβ₂s hβ₁f hβ₂f
  obtain ⟨hαs, hαf⟩ :=
    wcpa_dj_alteration_comp (ι ≫ Limits.pullback.fst f₂ β₁) α₃' hap has hα₃s haf hα₃f
  refine ⟨P₂, iP₂, β₂' ≫ β₁ ≫ sP₁, β₂' ≫ β₁, Category.assoc _ _ _, hP₂proj, inferInstance,
    hβs, hβf, X₃, iX₃, f₃, α₃' ≫ ι ≫ Limits.pullback.fst f₂ β₁, ?_, hX₃proj, hflat₃,
    inferInstance, hαs, hαf, U₂, σ'', D, ιD, hU₂, hsm₂, hgc₂, hσ'', hσ''d, hιD, hDred, hDflat,
    hDrange, ?_⟩
  · have hc : Limits.pullback.fst f₂ β₁ ≫ f₂ = Limits.pullback.snd f₂ β₁ ≫ β₁ :=
      Limits.pullback.condition
    calc (α₃' ≫ ι ≫ Limits.pullback.fst f₂ β₁) ≫ f₂
        = α₃' ≫ ι ≫ (Limits.pullback.fst f₂ β₁ ≫ f₂) := by simp only [Category.assoc]
      _ = α₃' ≫ ι ≫ (Limits.pullback.snd f₂ β₁ ≫ β₁) := by rw [hc]
      _ = (α₃' ≫ ι ≫ Limits.pullback.snd f₂ β₁) ≫ β₁ := by simp only [Category.assoc]
      _ = (f₃ ≫ β₂') ≫ β₁ := by rw [hsq]
      _ = f₃ ≫ β₂' ≫ β₁ := Category.assoc _ _ _
  · intro x hx
    have hx1 : α₃' x ∈ ⇑(ι ≫ Limits.pullback.fst f₂ β₁) ⁻¹'
        ((⋃ i, Set.range ⇑(σ i)) ∪ ⇑f₂ ⁻¹' ((U₁ : Set P₁)ᶜ)) := by
      simpa only [Set.mem_preimage, Scheme.Hom.comp_apply] using hx
    exact hT₂ (hT₁ hx1)

theorem wcpa_dj_tr_basechange_integral : ∀ (P' P'' C : Scheme.{u}) [AlgebraicGeometry.IsIntegral P'] [AlgebraicGeometry.IsIntegral P''] [AlgebraicGeometry.IsIntegral C] (β : P'' ⟶ P') (g : C ⟶ P') (U' : P'.Opens), Flat g → Surjective β → U' ≠ ⊥ → SmoothOfRelativeDimension 1 (g ∣_ U') → GeometricallyConnected (g ∣_ U') → AlgebraicGeometry.IsIntegral (Limits.pullback g β) :=
by
  intro P' P'' C _ _ _ β g U' hg hβ hU hsm hgc
  haveI hP''irr : IrreducibleSpace P'' := irreducibleSpace_of_isIntegral P''

  have s1 : ∃ (y : Spec (P''.presheaf.stalk (genericPoint P'')) ⟶ U')
      (l : Limits.pullback (Limits.pullback.snd g β) (P''.fromSpecStalk (genericPoint P'')) ⟶
        (g ⁻¹ᵁ U')),
      IsPullback l (Limits.pullback.snd (Limits.pullback.snd g β)
        (P''.fromSpecStalk (genericPoint P''))) (g ∣_ U') y := by
    have hη : β (genericPoint P'') ∈ U' := by
      obtain ⟨u, hu⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U').mp hU
      obtain ⟨x, hx⟩ := β.surjective u
      have h1 : β (genericPoint P'') ⤳ β x := (genericPoint_specializes x).map β.continuous
      exact h1.mem_open U'.isOpen (hx ▸ hu)
    have hrange : Set.range (P''.fromSpecStalk (genericPoint P'') ≫ β) ⊆ Set.range U'.ι := by
      rintro _ ⟨z, rfl⟩
      rw [Scheme.Opens.range_ι]
      have hz : P''.fromSpecStalk (genericPoint P'') z ⤳ genericPoint P'' := by
        have : P''.fromSpecStalk (genericPoint P'') z ∈
            Set.range (P''.fromSpecStalk (genericPoint P'')) := ⟨z, rfl⟩
        rwa [Scheme.range_fromSpecStalk] at this
      rw [Scheme.Hom.comp_apply]
      exact (hz.map β.continuous).mem_open U'.isOpen hη
    let y := IsOpenImmersion.lift U'.ι (P''.fromSpecStalk (genericPoint P'') ≫ β) hrange
    have hy : y ≫ U'.ι = P''.fromSpecStalk (genericPoint P'') ≫ β :=
      IsOpenImmersion.lift_fac _ _ _
    have sq1 := IsPullback.of_hasPullback g β
    have sq2 := IsPullback.of_hasPullback (Limits.pullback.snd g β)
      (P''.fromSpecStalk (genericPoint P''))
    have outer := sq2.paste_horiz sq1
    have sq3 := (isPullback_morphismRestrict g U').flip
    have w : (Limits.pullback.fst (Limits.pullback.snd g β) (P''.fromSpecStalk (genericPoint P'')) ≫
        Limits.pullback.fst g β) ≫ g =
        (Limits.pullback.snd (Limits.pullback.snd g β) (P''.fromSpecStalk (genericPoint P'')) ≫ y) ≫
          U'.ι := by
      rw [Category.assoc _ y, hy]
      exact outer.w
    refine ⟨y, sq3.lift _ _ w, ?_⟩
    apply IsPullback.of_right ?_ (sq3.lift_snd _ _ w) sq3
    rw [sq3.lift_fst, hy]
    exact outer


  have s2 : ∀ (K : Type u) [Field K] (X Y : Scheme.{u}) (f : X ⟶ Y) (y : Spec (.of K) ⟶ Y)
      (Z : Scheme.{u}) (fst : Z ⟶ X) (snd : Z ⟶ Spec (.of K)), SmoothOfRelativeDimension 1 f →
      GeometricallyConnected f → IsPullback fst snd f y →
      IrreducibleSpace Z ∧ AlgebraicGeometry.IsReduced Z := by
    intro K _ X Y f y Z fst snd hsm' hgc' hpb
    haveI := hgc'
    haveI : SmoothOfRelativeDimension 1 snd :=
      MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hpb hsm'
    haveI : ConnectedSpace Z := GeometricallyConnected.geometrically_connectedSpace y fst snd hpb
    haveI : Smooth snd := SmoothOfRelativeDimension.smooth 1 snd
    haveI : LocallyOfFiniteType snd := inferInstance
    haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian snd
    have hd := wcpa_smooth_stalk_isDomain K Z snd 1
    refine ⟨wcpa_irreducible_of_connected_domain_stalks Z hd, ?_⟩
    haveI : ∀ z : Z, _root_.IsReduced (Z.presheaf.stalk z) := fun z => by
      haveI := hd z
      infer_instance
    exact isReduced_of_isReduced_stalk Z

  have s3 : ∀ (S X : Scheme.{u}) [AlgebraicGeometry.IsIntegral S] [IrreducibleSpace S] (f : X ⟶ S),
      Flat f →
      IrreducibleSpace ↥(Limits.pullback f (S.fromSpecStalk (genericPoint S))) →
      IrreducibleSpace X ∧ True := by
    intro S X _ _ f hf hG
    refine ⟨?_, trivial⟩
    have hgen : GeneralizingMap f := Flat.generalizingMap f
    have key : ∀ x : X, Limits.pullback.fst f (S.fromSpecStalk (genericPoint S))
        (genericPoint ↥(Limits.pullback f (S.fromSpecStalk (genericPoint S)))) ⤳ x := by
      intro x
      have h1 : genericPoint S ⤳ f x := genericPoint_specializes (f x)
      obtain ⟨x', hx', hfx'⟩ := hgen h1
      have hmem : f x' ∈ Set.range (S.fromSpecStalk (genericPoint S)) := by
        rw [Scheme.range_fromSpecStalk, hfx']
        exact specializes_refl _
      have hx'r : x' ∈ Set.range (Limits.pullback.fst f (S.fromSpecStalk (genericPoint S))) := by
        rw [Scheme.Pullback.range_fst]
        exact hmem
      obtain ⟨z, rfl⟩ := hx'r
      exact ((genericPoint_specializes z).map (Limits.pullback.fst f _).continuous).trans hx'
    rw [irreducibleSpace_def]
    have huniv : (Set.univ : Set X) = closure {Limits.pullback.fst f (S.fromSpecStalk (genericPoint S))
        (genericPoint ↥(Limits.pullback f (S.fromSpecStalk (genericPoint S))))} := by
      apply (Set.eq_univ_of_forall _).symm
      intro x
      exact specializes_iff_mem_closure.mp (key x)
    rw [Set.top_eq_univ, huniv]
    exact isIrreducible_singleton.closure

  have s4 : ∀ (S X : Scheme.{u}) [AlgebraicGeometry.IsIntegral S] [IrreducibleSpace S] (f : X ⟶ S)
      (V : S.Opens)
      (hV : IsAffineOpen V) (W : X.Opens) (hW : IsAffineOpen W) (e : W ≤ f ⁻¹ᵁ V)
      (hη : genericPoint S ∈ V),
      AlgebraicGeometry.IsReduced (Limits.pullback f (S.fromSpecStalk (genericPoint S))) →
      AlgebraicGeometry.IsReduced (Limits.pullback (Spec.map (f.appLE V W e))
        (Spec.map (S.presheaf.germ V (genericPoint S) hη))) ∧ True := by
    intro S X _ _ f V hV W hW e hη hG
    refine ⟨?_, trivial⟩
    have h0 : IsPullback (Limits.pullback.fst (Spec.map (f.appLE V W e))
        (Spec.map (S.presheaf.germ V (genericPoint S) hη)))
        (Limits.pullback.snd (Spec.map (f.appLE V W e))
          (Spec.map (S.presheaf.germ V (genericPoint S) hη)))
        (Spec.map (f.appLE V W e) ≫ hV.fromSpec)
        (Spec.map (S.presheaf.germ V (genericPoint S) hη) ≫ hV.fromSpec) :=
      IsPullback.of_isLimit (Limits.pullbackIsPullbackOfCompMono (Spec.map (f.appLE V W e))
        (Spec.map (S.presheaf.germ V (genericPoint S) hη)) hV.fromSpec)
    have e1 : Spec.map (S.presheaf.germ V (genericPoint S) hη) ≫ hV.fromSpec =
        S.fromSpecStalk (genericPoint S) := hV.fromSpecStalk_eq_fromSpecStalk hη
    rw [IsAffineOpen.SpecMap_appLE_fromSpec f hV hW e, e1] at h0
    have sqG := (IsPullback.of_hasPullback f (S.fromSpecStalk (genericPoint S))).flip
    have w : (Limits.pullback.fst (Spec.map (f.appLE V W e))
        (Spec.map (S.presheaf.germ V (genericPoint S) hη)) ≫ hW.fromSpec) ≫ f =
        Limits.pullback.snd (Spec.map (f.appLE V W e))
          (Spec.map (S.presheaf.germ V (genericPoint S) hη)) ≫ S.fromSpecStalk (genericPoint S) := by
      rw [Category.assoc]
      exact h0.w
    have Sq := IsPullback.of_right (h₁₁ := Limits.pullback.lift _ _ w) ?_
      (Limits.pullback.lift_fst _ _ w) sqG
    · haveI : IsOpenImmersion (Limits.pullback.lift _ _ w) :=
        MorphismProperty.of_isPullback (P := @IsOpenImmersion) Sq.flip inferInstance
      exact isReduced_of_isOpenImmersion (Limits.pullback.lift _ _ w)
    · rw [Limits.pullback.lift_snd]
      exact h0.flip

  have s5 : ∀ (S X : Scheme.{u}) [AlgebraicGeometry.IsIntegral S] [IrreducibleSpace S] (f : X ⟶ S),
      Flat f →
      (∀ (V : S.Opens) (_ : IsAffineOpen V) (W : X.Opens) (_ : IsAffineOpen W) (e : W ≤ f ⁻¹ᵁ V)
        (hη : genericPoint S ∈ V), AlgebraicGeometry.IsReduced (Limits.pullback
          (Spec.map (f.appLE V W e)) (Spec.map (S.presheaf.germ V (genericPoint S) hη)))) →
      AlgebraicGeometry.IsReduced X ∧ True := by
    intro S X _ _ f hf H
    haveI := hf
    have hst : ∀ x : X, _root_.IsReduced (X.presheaf.stalk x) := by
      intro x
      obtain ⟨V, hV, hxV, -⟩ := exists_isAffineOpen_mem_and_subset (x := f x) (U := ⊤) trivial
      obtain ⟨W, hW, hxW, hWV⟩ := exists_isAffineOpen_mem_and_subset (x := x) (U := f ⁻¹ᵁ V) hxV
      have hη : genericPoint S ∈ V := (genericPoint_specializes (f x)).mem_open V.isOpen hxV
      have hT := H V hV W hW hWV hη
      letI := (f.appLE V W hWV).hom.toAlgebra
      letI := (S.presheaf.germ V (genericPoint S) hη).hom.toAlgebra
      haveI : Module.Flat Γ(S, V) Γ(X, W) := Flat.flat_appLE f hV hW hWV
      have hinj : Function.Injective (algebraMap Γ(S, V) (S.presheaf.stalk (genericPoint S))) :=
        germ_injective_of_isIntegral S _ hη
      have hinc := Algebra.TensorProduct.includeLeft_injective (R := Γ(S, V)) (S := Γ(S, V))
        (A := Γ(X, W)) (B := S.presheaf.stalk (genericPoint S)) hinj
      haveI : AlgebraicGeometry.IsReduced
          (Spec (.of (TensorProduct Γ(S, V) Γ(X, W) (S.presheaf.stalk (genericPoint S))))) := by
        haveI : AlgebraicGeometry.IsReduced (Limits.pullback
            (Spec.map (CommRingCat.ofHom (algebraMap Γ(S, V) Γ(X, W))))
            (Spec.map (CommRingCat.ofHom
              (algebraMap Γ(S, V) (S.presheaf.stalk (genericPoint S)))))) := hT
        exact isReduced_of_isOpenImmersion (pullbackSpecIso _ _ _).inv
      haveI : _root_.IsReduced
          (TensorProduct Γ(S, V) Γ(X, W) (S.presheaf.stalk (genericPoint S))) :=
        (affine_isReduced_iff (CommRingCat.of
          (TensorProduct Γ(S, V) Γ(X, W) (S.presheaf.stalk (genericPoint S))))).mp inferInstance
      haveI : _root_.IsReduced Γ(X, W) := isReduced_of_injective _ hinc
      letI := TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨x, hxW⟩ : W)
      haveI := hW.isLocalization_stalk ⟨x, hxW⟩
      exact isReduced_localizationPreserves (hW.primeIdealOf ⟨x, hxW⟩).asIdeal.primeCompl
        (X.presheaf.stalk (⟨x, hxW⟩ : W)) ‹_›
    exact ⟨isReduced_of_isReduced_stalk X, trivial⟩

  haveI := hg
  obtain ⟨y, l, hl⟩ := s1
  have hBR : IrreducibleSpace ↥(Limits.pullback (Limits.pullback.snd g β)
        (P''.fromSpecStalk (genericPoint P''))) ∧
      AlgebraicGeometry.IsReduced (Limits.pullback (Limits.pullback.snd g β)
        (P''.fromSpecStalk (genericPoint P''))) :=
    s2 (P''.presheaf.stalk (genericPoint P'')) _ _ (g ∣_ U') y _ l _ hsm hgc hl
  have hfl : Flat (Limits.pullback.snd g β) := inferInstance
  haveI hI : IrreducibleSpace ↥(Limits.pullback g β) :=
    (s3 P'' (Limits.pullback g β) (Limits.pullback.snd g β) hfl hBR.1).1
  haveI hR : AlgebraicGeometry.IsReduced (Limits.pullback g β) :=
    (s5 P'' _ (Limits.pullback.snd g β) hfl
      (fun V hV W hW e hη => (s4 P'' _ _ V hV W hW e hη hBR.2).1)).1
  exact isIntegral_of_irreducibleSpace_of_isReduced (Limits.pullback g β)

theorem wcpa_dj_tr_basechange_sections : ∀ (P' P'' C : Scheme.{u}) (β : P'' ⟶ P') (g : C ⟶ P') (m : ℕ) (τ : Fin m → (P' ⟶ C)), wcpaDjSections g m τ → ∃ τ'' : Fin m → (P'' ⟶ Limits.pullback g β), wcpaDjSections (Limits.pullback.snd g β) m τ'' ∧ ⇑(Limits.pullback.fst g β) ⁻¹' (⋃ j, Set.range ⇑(τ j)) ⊆ ⋃ j, Set.range ⇑(τ'' j) :=
by
  intro P' P'' C β g m τ hsec
  obtain ⟨h1, h2, h3⟩ := hsec
  have key : ∀ j, ∃ t : P'' ⟶ Limits.pullback g β,
      t ≫ Limits.pullback.fst g β = β ≫ τ j ∧ t ≫ Limits.pullback.snd g β = 𝟙 P'' := by
    intro j
    have hw : (β ≫ τ j) ≫ g = 𝟙 P'' ≫ β := by
      rw [Category.assoc, h1 j, Category.comp_id, Category.id_comp]
    exact ⟨Limits.pullback.lift (β ≫ τ j) (𝟙 P'') hw, Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩
  choose τ'' hτ1 hτ2 using key
  have L1 : ∀ j (p : P''), Limits.pullback.fst g β (τ'' j p) = τ j (β p) := by
    intro j p
    rw [← Scheme.Hom.comp_apply, hτ1 j, Scheme.Hom.comp_apply]
  refine ⟨τ'', ⟨hτ2, ?_, ?_⟩, ?_⟩
  · intro i j p q hij heq
    apply h2 i j (β p) (β q) hij
    rw [← L1, ← L1, heq]
  · intro j p
    obtain ⟨W, hmem, hsm⟩ := h3 j (β p)
    refine ⟨Limits.pullback.fst g β ⁻¹ᵁ W, ?_, ?_⟩
    · rw [Scheme.Hom.mem_preimage, L1]
      exact hmem
    · have hpb := (isPullback_morphismRestrict (Limits.pullback.fst g β) W).paste_vert
        (IsPullback.of_hasPullback g β)
      exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hpb hsm
  · intro x hx
    rw [Set.mem_preimage, Set.mem_iUnion] at hx
    obtain ⟨j, p', hp'⟩ := hx
    have outer : IsPullback (τ'' j ≫ Limits.pullback.snd g β) β β (τ j ≫ g) := by
      rw [hτ2 j, h1 j]
      exact IsPullback.id_horiz β
    have hcart : IsPullback (τ'' j) β (Limits.pullback.fst g β) (τ j) :=
      IsPullback.of_right outer (hτ1 j) (IsPullback.of_hasPullback g β).flip
    obtain ⟨z, hz, -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := Limits.pullback.fst g β) (g := τ j) x p' hp'.symm
    refine Set.mem_iUnion.mpr ⟨j, hcart.isoPullback.inv z, ?_⟩
    rw [← Scheme.Hom.comp_apply, hcart.isoPullback_inv_fst, hz]

theorem wcpa_dj_lus_proj_ring_basechange : ∀ (R R' : Type u) [CommRing R] [CommRing R']
    (φ : R →+* R') (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of R)),
    (∃ (N : ℕ) (j : Z ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
        MvPolynomial.gradedAlgebra),
      IsClosedImmersion j ∧
      j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
        MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
          (algebraMap R ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R 0))) = uu) →
    ∃ (N : ℕ) (j : Limits.pullback uu (Spec.map (CommRingCat.ofHom φ)) ⟶
        @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R')
        MvPolynomial.gradedAlgebra),
      IsClosedImmersion j ∧
      j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R')
        MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
          (algebraMap R' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R' 0))) =
        Limits.pullback.snd uu (Spec.map (CommRingCat.ofHom φ)) :=
by
  refine (fun (hPB : ∀ (F F' : Type u) [CommRing F] [CommRing F'] [Algebra F F'] (N : ℕ),
      ∃ e : Limits.pullback (@Proj.toSpecZero _ _ _ _ _
              (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F)
              MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
                (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0))))
            (Spec.map (CommRingCat.ofHom (algebraMap F F'))) ⟶
          @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
            MvPolynomial.gradedAlgebra,
        IsIso e ∧
        e ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
              MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
                (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0))) =
          Limits.pullback.snd _ _) =>
    ?_) ?_
  have hAbs : ∀ {Z PR PR' S S' : Scheme.{u}} (uu : Z ⟶ S) (p : PR ⟶ S) (g : S' ⟶ S)
      (p' : PR' ⟶ S') (e : Limits.pullback p g ⟶ PR') (j : Z ⟶ PR),
      IsIso e → e ≫ p' = Limits.pullback.snd p g → IsClosedImmersion j → j ≫ p = uu →
      ∃ j' : Limits.pullback uu g ⟶ PR', IsClosedImmersion j' ∧
        j' ≫ p' = Limits.pullback.snd uu g := by
    intro Z PR PR' S S' uu p g p' e j he_iso he hj hjeq
    have w : (Limits.pullback.fst uu g ≫ j) ≫ p = Limits.pullback.snd uu g ≫ g := by
      rw [Category.assoc, hjeq, Limits.pullback.condition]
    obtain ⟨jb, hjb1, hjb2⟩ : ∃ jb : Limits.pullback uu g ⟶ Limits.pullback p g,
        jb ≫ Limits.pullback.fst p g = Limits.pullback.fst uu g ≫ j ∧
        jb ≫ Limits.pullback.snd p g = Limits.pullback.snd uu g :=
      ⟨Limits.pullback.lift _ _ w, Limits.pullback.lift_fst _ _ _,
        Limits.pullback.lift_snd _ _ _⟩
    have hsq : IsPullback jb (Limits.pullback.fst uu g) (Limits.pullback.fst p g) j := by
      have hout : IsPullback (jb ≫ Limits.pullback.snd p g) (Limits.pullback.fst uu g) g
          (j ≫ p) := by
        rw [hjb2, hjeq]
        exact (IsPullback.of_hasPullback uu g).flip
      exact IsPullback.of_right hout hjb1 (IsPullback.of_hasPullback p g).flip
    haveI hjb : IsClosedImmersion jb :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq.flip hj
    haveI := he_iso
    refine ⟨jb ≫ e, inferInstance, ?_⟩
    rw [Category.assoc, he, hjb2]
  rintro R R' _ _ φ Z uu ⟨N, j, hj, hjeq⟩
  letI iφ : Algebra R R' := φ.toAlgebra
  obtain ⟨e, he_iso, he⟩ := @hPB R R' _ _ iφ N
  obtain ⟨j', hj', hj'eq⟩ := hAbs uu _ (Spec.map (CommRingCat.ofHom φ)) _ e j he_iso he hj hjeq
  exact ⟨N, j', hj', hj'eq⟩

  have s6 : ∀ {W X Y Z : Scheme.{u}} (φ : W ⟶ X) (p' : W ⟶ Y) (p : X ⟶ Z) (g : Y ⟶ Z) {ι : Type}
      (U U' : ι → Scheme.{u}) (j : ∀ i, U i ⟶ X) (j' : ∀ i, U' i ⟶ W) (φi : ∀ i, U' i ⟶ U i)
      [∀ i, IsOpenImmersion (j i)] [∀ i, IsOpenImmersion (j' i)],
      (⨆ i, (j i).opensRange) = ⊤ → (∀ i, j' i ≫ φ = φi i ≫ j i) →
      (∀ i, φ ⁻¹ᵁ (j i).opensRange = (j' i).opensRange) →
      (∀ i, IsPullback (φi i) (j' i ≫ p') (j i ≫ p) g) → IsPullback φ p' p g := by
    intro W X Y Z φ p' p g ι U U' j j' φi hjI hj'I hcov hcomm hpre hpb
    have hc : ∀ x : X, ∃ i y, j i y = x := by
      intro x
      have hx : x ∈ (⨆ i, (j i).opensRange) := by rw [hcov]; trivial
      obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
      obtain ⟨y, hy⟩ := Scheme.Hom.mem_opensRange.mp hi
      exact ⟨i, y, hy⟩
    refine Scheme.isPullback_of_openCover φ p' p g
      (Scheme.Cover.mkOfCovers (P := @IsOpenImmersion) ι U j hc) ?_
    intro i
    have Q := (@IsOpenImmersion.isPullback _ _ _ _ (φi i) (j' i) (j i) φ (hj'I i) (hjI i)
      (hcomm i) (hpre i)).flip
    refine IsPullback.of_iso (hpb i) Q.isoPullback (Iso.refl _) (Iso.refl _) (Iso.refl _)
      ?_ ?_ ?_ ?_
    · show φi i ≫ 𝟙 _ = Q.isoPullback.hom ≫ Limits.pullback.snd φ (j i)
      rw [Category.comp_id, IsPullback.isoPullback_hom_snd]
    · show (j' i ≫ p') ≫ 𝟙 _ = Q.isoPullback.hom ≫ (Limits.pullback.fst φ (j i) ≫ p')
      rw [Category.comp_id, ← Category.assoc, IsPullback.isoPullback_hom_fst]
    · show (j i ≫ p) ≫ 𝟙 _ = 𝟙 _ ≫ (j i ≫ p)
      rw [Category.comp_id, Category.id_comp]
    · show g ≫ 𝟙 _ = 𝟙 _ ≫ g
