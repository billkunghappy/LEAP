    unfold wcpaDjFlrgPsi
    exact MvPolynomial.eval₂Hom_C _ _ _
  have hΘC : ∀ b, Θ (MvPolynomial.C b) = ((ι ≫ Limits.pullback.snd f β).appLE V' _ hVle).hom b := by
    intro b
    show ((ι ≫ e).appLE (wcpaDjFlrgChart k N (β ≫ sP) V' i)
      ((ι ≫ e) ⁻¹ᵁ wcpaDjFlrgChart k N (β ≫ sP) V' i) le_rfl).hom
