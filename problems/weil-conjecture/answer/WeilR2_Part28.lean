      (Spec.map (CommRingCat.ofHom (algebraMap F F'))) := by
    intro a
    obtain ⟨e, heC, heX⟩ := s2 F a (MvPolynomial.X a) rfl
    obtain ⟨e', he'C, he'X⟩ := s2 F' a (f (MvPolynomial.X a)) (hfX a)
    have hcompat : ∀ p : MvPolynomial (Fin N) F,
        HomogeneousLocalization.Away.map f (MvPolynomial.X a) (e p) =
          e' (MvPolynomial.map (algebraMap F F') p) := by
      have key : (HomogeneousLocalization.Away.map f (MvPolynomial.X a)).comp e.toRingHom =
          e'.toRingHom.comp (MvPolynomial.map (algebraMap F F')) := by
        apply MvPolynomial.ringHom_ext
        · intro c
          show HomogeneousLocalization.Away.map f (MvPolynomial.X a) (e (MvPolynomial.C c)) =
            e' (MvPolynomial.map (algebraMap F F') (MvPolynomial.C c))
          rw [MvPolynomial.map_C, heC, he'C]
          apply HomogeneousLocalization.val_injective _
          rw [HomogeneousLocalization.Away.map.eq_1, s3 _ _ (MvPolynomial.C c) 1 (V0 F _ c),
            V0 F' _ (algebraMap F F' c)]
          congr 1
          · rw [hfmap, MvPolynomial.map_C]
          · ext
            simp
        · intro j
          show HomogeneousLocalization.Away.map f (MvPolynomial.X a) (e (MvPolynomial.X j)) =
            e' (MvPolynomial.map (algebraMap F F') (MvPolynomial.X j))
          rw [MvPolynomial.map_X]
          apply HomogeneousLocalization.val_injective _
          rw [HomogeneousLocalization.Away.map.eq_1, s3 _ _ _ _ (heX j), he'X j]
          congr 1
          rw [hfmap, MvPolynomial.map_X]
      intro p
      exact RingHom.congr_fun key p
    have P : IsPushout
        (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (Submonoid.powers (MvPolynomial.X a))).comp
          (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0))))
        (CommRingCat.ofHom (algebraMap F F'))
        (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a)))
        (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
          (Submonoid.powers (f (MvPolynomial.X a)))).comp
          (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0)))) := by
      letI := (MvPolynomial.algebraMvPolynomial :
        Algebra (MvPolynomial (Fin N) F) (MvPolynomial (Fin N) F'))
      have P0 := CommRingCat.isPushout_of_isPushout F (MvPolynomial (Fin N) F) F'
        (MvPolynomial (Fin N) F')
      refine IsPushout.of_iso P0 (Iso.refl _) e.toCommRingCatIso (Iso.refl _) e'.toCommRingCatIso
        ?_ ?_ ?_ ?_
      · apply CommRingCat.hom_ext
        apply RingHom.ext
        intro c
        exact heC c
      · simp only [Iso.refl_hom, Category.comp_id, Category.id_comp]
      · apply CommRingCat.hom_ext
        apply RingHom.ext
        intro p
        exact (hcompat p).symm
      · apply CommRingCat.hom_ext
        apply RingHom.ext
        intro c
        exact he'C c
    have hj : Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a) (hX a)
          Nat.one_pos ≫
        (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) ≫ Spec.map
          (CommRingCat.ofHom (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0)))) =
        Spec.map (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (Submonoid.powers (MvPolynomial.X a))).comp
          (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0)))) := by
      rw [← Category.assoc, Proj.awayι_toSpecZero, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hj' : Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
          (f.map_mem (hX a)) Nat.one_pos ≫
        (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') ≫ Spec.map
          (CommRingCat.ofHom (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0)))) =
        Spec.map (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
          (Submonoid.powers (f (MvPolynomial.X a)))).comp
          (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0)))) := by
      rw [← Category.assoc, Proj.awayι_toSpecZero, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
    rw [hj, hj']
    exact isPullback_SpecMap_of_isPushout _ _ _ _ P
  have hcov : (⨆ a : Fin (N + 1), (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F)
      (MvPolynomial.X a) (hX a) Nat.one_pos).opensRange) = ⊤ := by
    simp only [Proj.opensRange_awayι]
    exact Proj.iSup_basicOpen_eq_top _ _ (hspan F)
  have hcomm : ∀ a : Fin (N + 1),
      Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
          (f.map_mem (hX a)) Nat.one_pos ≫ Proj.map f hf =
        Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a))) ≫
          Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a) (hX a)
            Nat.one_pos := fun a =>
    Proj.awayι_comp_map f hf Nat.one_pos (MvPolynomial.X a) (hX a)
  have hpre : ∀ a : Fin (N + 1), Proj.map f hf ⁻¹ᵁ
      (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a) (hX a)
        Nat.one_pos).opensRange =
      (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
          (f.map_mem (hX a)) Nat.one_pos).opensRange := fun a => by
    rw [Proj.opensRange_awayι, Proj.opensRange_awayι, Proj.map_preimage_basicOpen]
  have H := s6 (Proj.map f hf)
    (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') ≫ Spec.map
          (CommRingCat.ofHom (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0))))
    (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) ≫ Spec.map
          (CommRingCat.ofHom (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0))))
    (Spec.map (CommRingCat.ofHom (algebraMap F F')))
    (fun a : Fin (N + 1) => Spec (CommRingCat.of (HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a))))
    (fun a : Fin (N + 1) => Spec (CommRingCat.of (HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a)))))
    (fun a => Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a)
      (hX a) Nat.one_pos)
    (fun a => Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
      (f.map_mem (hX a)) Nat.one_pos)
    (fun a => Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a))))
    hcov hcomm hpre hchart
  exact ⟨H.isoPullback.inv, inferInstance, H.isoPullback_inv_snd⟩

theorem wcpa_dj_lcp_stableptd_basechange : ∀ {Z T T' : Scheme.{u}} (uu : Z ⟶ T) (n : ℕ)
    (τ : Fin n → (T ⟶ Z)) (b : T' ⟶ T), wcpaDjStablePtd uu n τ →
    ∃ τ' : Fin n → (T' ⟶ Limits.pullback uu b),
      wcpaDjStablePtd (Limits.pullback.snd uu b) n τ' ∧
      (∀ i, τ' i ≫ Limits.pullback.snd uu b = 𝟙 T') ∧
      (∀ i, τ' i ≫ Limits.pullback.fst uu b = b ≫ τ i) :=
by
  have wcpa_dj_mm_section_point_unique : ∀ (X P V C : Scheme.{u}) (f : X ⟶ P) (b : V ⟶ P)
      (ψ : C ⟶ X) (g : C ⟶ V) (σ : P ⟶ X) (τ : V ⟶ C), IsPullback ψ g f b → σ ≫ f = 𝟙 P →
      τ ≫ g = 𝟙 V → τ ≫ ψ = b ≫ σ → ∀ c : C, ψ c = σ (b (g c)) ↔ c = τ (g c) := by
    intro X P V C f b ψ g σ τ H1 H2 H3 H4 c
    have hcomp : ∀ x : V, ψ (τ x) = σ (b x) := by
      intro x
      rw [← Scheme.Hom.comp_apply, H4, Scheme.Hom.comp_apply]
    have hgτ : ∀ x : V, g (τ x) = x := by
      intro x
      rw [← Scheme.Hom.comp_apply, H3]
      rfl
    constructor
    · intro h
      have hout : IsPullback (τ ≫ g) b b (σ ≫ f) := by
        rw [H3, H2]
        exact IsPullback.id_horiz b
      have hsq : IsPullback τ b ψ σ := IsPullback.of_right hout H4 H1.flip
      obtain ⟨p, hp, _⟩ := Scheme.exists_preimage_of_isPullback hsq c (b (g c)) h
      have hg : g c = p := by rw [← hp, hgτ]
      rw [hg, hp]
    · intro h
      calc ψ c = ψ (τ (g c)) := congrArg ψ h
        _ = σ (b (g c)) := hcomp (g c)
  have wcpa_dj_mm_semistable_basechange : ∀ (M P'' Z : Scheme.{u}) (φ : P'' ⟶ M) (u : Z ⟶ M),
      wcpaDjSemistable u → wcpaDjSemistable (Limits.pullback.snd u φ) := by
    have hcomap : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
        (σ : A ≃+* B) (n : ℕ), IsLocalRing.maximalIdeal A ^ n ≤
          Ideal.comap (σ : A →+* B) (IsLocalRing.maximalIdeal B ^ n) := by
      intro A B _ _ _ _ σ n
      rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
      apply Ideal.pow_right_mono
      rw [Ideal.map_le_iff_le_comap]
      intro x hx
      simp only [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hx ⊢
      intro h
      exact hx ((MulEquiv.isUnit_map (σ : A ≃* B)).mp h)
    have hfac : ∀ (A : Type u) [CommRing A] (I : Ideal A) (m n : ℕ) (h : m ≤ n)
        (x : AdicCompletion I A),
        Ideal.Quotient.factorPow I h (AdicCompletion.evalₐ I n x) = AdicCompletion.evalₐ I m x := by
      intro A _ I m n h x
      obtain ⟨c, rfl⟩ := AdicCompletion.mk_surjective I A x
      rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk, Ideal.Quotient.factorPow,
        Ideal.Quotient.factor_mk, Ideal.Quotient.eq]
      have := (Submodule.Quotient.eq _).mp (AdicCompletion.AdicCauchySequence.mk_eq_mk h c)
      simpa [smul_eq_mul, Ideal.mul_top] using this
    have hmap : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
        (σ : A ≃+* B), ∃ Φ : AdicCompletion (IsLocalRing.maximalIdeal A) A →+*
          AdicCompletion (IsLocalRing.maximalIdeal B) B, ∀ (n : ℕ) x (a : A),
          AdicCompletion.evalₐ _ n x = Ideal.Quotient.mk _ a →
          AdicCompletion.evalₐ _ n (Φ x) = Ideal.Quotient.mk _ (σ a) := by
      intro A B _ _ _ _ σ
      let f : ∀ n : ℕ, AdicCompletion (IsLocalRing.maximalIdeal A) A →+*
          B ⧸ IsLocalRing.maximalIdeal B ^ n := fun n =>
        (Ideal.quotientMap (IsLocalRing.maximalIdeal B ^ n) (σ : A →+* B) (hcomap A B σ n)).comp
          (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n).toRingHom
      have hf : ∀ (n : ℕ) x (a : A), AdicCompletion.evalₐ _ n x = Ideal.Quotient.mk _ a →
          f n x = Ideal.Quotient.mk _ (σ a) := by
        intro n x a ha
        show Ideal.quotientMap (IsLocalRing.maximalIdeal B ^ n) (σ : A →+* B) (hcomap A B σ n)
          (AdicCompletion.evalₐ _ n x) = _
        rw [ha, Ideal.quotientMap_mk]
        rfl
      have hcompat : ∀ {m n : ℕ} (hle : m ≤ n),
          (Ideal.Quotient.factorPow (IsLocalRing.maximalIdeal B) hle).comp (f n) = f m := by
        intro m n hle
        ext x
        obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n x)
        have ha' : AdicCompletion.evalₐ _ m x = Ideal.Quotient.mk _ a := by
          rw [← hfac A _ m n hle x, ← ha, Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk]
        rw [RingHom.comp_apply, hf n x a ha.symm, hf m x a ha', Ideal.Quotient.factorPow,
          Ideal.Quotient.factor_mk]
      refine ⟨AdicCompletion.liftRingHom _ f hcompat, ?_⟩
      intro n x a ha
      rw [AdicCompletion.evalₐ_liftRingHom]
      exact hf n x a ha
    have s1 : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
        (σ : A ≃+* B), ∃ Φ : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+*
          AdicCompletion (IsLocalRing.maximalIdeal B) B, ∀ a : A,
          Φ (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a) =
            algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) (σ a) := by
      intro A B _ _ _ _ σ
      obtain ⟨Φ, hΦ⟩ := hmap A B σ
      obtain ⟨Ψ, hΨ⟩ := hmap B A σ.symm
      have h1 : Φ.comp Ψ = RingHom.id _ := by
        ext1 y
        apply AdicCompletion.ext_evalₐ
        intro n
        obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n y)
        rw [RingHom.comp_apply, hΦ n _ _ (hΨ n y b hb.symm), RingEquiv.apply_symm_apply,
          RingHom.id_apply, hb]
      have h2 : Ψ.comp Φ = RingHom.id _ := by
        ext1 y
        apply AdicCompletion.ext_evalₐ
        intro n
        obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n y)
        rw [RingHom.comp_apply, hΨ n _ _ (hΦ n y b hb.symm), RingEquiv.symm_apply_apply,
          RingHom.id_apply, hb]
      refine ⟨RingEquiv.ofRingHom Φ Ψ h1 h2, ?_⟩
      intro a
      apply AdicCompletion.ext_evalₐ
      intro n
      have hof : ∀ (R : Type u) [CommRing R] (I : Ideal R) (r : R),
          AdicCompletion.evalₐ I n (algebraMap R (AdicCompletion I R) r) =
            Ideal.Quotient.mk _ r := by
        intro R _ I r
        rw [AdicCompletion.algebraMap_apply, AdicCompletion.evalₐ_of, Algebra.algebraMap_self,
          RingHom.id_apply]
      show AdicCompletion.evalₐ _ n (Φ _) = _
      rw [hΦ n _ a (hof A _ a), hof B _ (σ a)]
    have s2 : ∀ (K : Type u) [Field K] {X Y : Scheme.{u}} (i : X ⟶ Y) (p : X ⟶ Spec (.of K))
        (q : Y ⟶ Spec (.of K)), i ≫ q = p → ∀ x : X,
        ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ Y.presheaf.germ ⊤ (i x) trivial) ≫
          i.stalkMap x =
        (Scheme.ΓSpecIso (.of K)).inv ≫ p.appTop ≫ X.presheaf.germ ⊤ x trivial := by
      intro K _ X Y i p q hi x
      have key : Y.presheaf.germ ⊤ (i x) trivial ≫ i.stalkMap x =
          i.appTop ≫ X.presheaf.germ ⊤ x trivial := Scheme.Hom.germ_stalkMap i ⊤ x trivial
      rw [← hi, Scheme.Hom.comp_appTop]
      simp only [Category.assoc]
      exact congrArg (fun t => (Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ t) key
    have s3 : ∀ {X Y S : Scheme.{u}} (i : X ⟶ Y) [IsIso i] (p : X ⟶ S) (q : Y ⟶ S), i ≫ q = p →
        ∀ (W' : Y.Opens), SmoothOfRelativeDimension 1 (W'.ι ≫ q) →
          SmoothOfRelativeDimension 1 ((i ⁻¹ᵁ W').ι ≫ p) := by
      intro X Y S i _ p q hi W' hW'
      have hfac' : (i ⁻¹ᵁ W').ι ≫ p = (i ∣_ W') ≫ (W'.ι ≫ q) := by
        rw [← hi, ← Category.assoc, ← morphismRestrict_ι, Category.assoc]
      have hpb : IsPullback (i ∣_ W') ((i ∣_ W') ≫ (W'.ι ≫ q)) (W'.ι ≫ q) (𝟙 S) :=
        IsPullback.of_horiz_isIso ⟨by rw [Category.comp_id]⟩
      rw [hfac']
      exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hpb hW'
    intro M P'' Z φ u hss
    obtain ⟨hflat, hprop, hfib⟩ := hss
    haveI := hflat
    haveI := hprop
    refine ⟨inferInstance, inferInstance, ?_⟩
    intro K _ _ s w
    set i := (Limits.pullbackLeftPullbackSndIso u φ s).hom with hi_def
    have hi : i ≫ Limits.pullback.snd u (s ≫ φ) =
        Limits.pullback.snd (Limits.pullback.snd u φ) s :=
      Limits.pullbackLeftPullbackSndIso_hom_snd u φ s
    rcases hfib K (s ≫ φ) (i w) with ⟨W', hw', hsm⟩ | ⟨e₀, he₀⟩
    · left
      refine ⟨i ⁻¹ᵁ W', hw', ?_⟩
      exact s3 i _ _ hi W' hsm
    · right
      let τ := Iso.commRingCatIsoToRingEquiv (asIso (i.stalkMap w))
      obtain ⟨Φ, hΦ⟩ := s1 _ _ τ.symm
      refine ⟨Φ.trans e₀, ?_⟩
      have h2 := s2 K i _ _ hi w
      ext1 k
      have hk : τ.symm (((Scheme.ΓSpecIso (.of K)).inv ≫
          (Limits.pullback.snd (Limits.pullback.snd u φ) s).appTop ≫
          (Limits.pullback (Limits.pullback.snd u φ) s).presheaf.germ ⊤ w trivial).hom k) =
          ((Scheme.ΓSpecIso (.of K)).inv ≫ (Limits.pullback.snd u (s ≫ φ)).appTop ≫
          (Limits.pullback u (s ≫ φ)).presheaf.germ ⊤ (i w) trivial).hom k := by
        rw [← h2, RingEquiv.symm_apply_eq]
        rfl
      have := RingHom.congr_fun he₀ k
      simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom] at this ⊢
      rw [RingEquiv.trans_apply, hΦ, hk]
      exact this
  intro Z T T' uu n τ b hst
  obtain ⟨hss, hsec, hstab⟩ := hst
  obtain ⟨hS1, hS2, hS3⟩ := hsec
  have pt : ∀ {A B C : Scheme.{u}} {a : A ⟶ B} {b : B ⟶ C} {c : A ⟶ C}, a ≫ b = c →
      ∀ x, b (a x) = c x := by
    intro A B C a b c h x
    rw [← Scheme.Hom.comp_apply, h]
  let τ' : Fin n → (T' ⟶ Limits.pullback uu b) := fun i =>
    Limits.pullback.lift (b ≫ τ i) (𝟙 T')
      (by rw [Category.assoc, hS1 i, Category.comp_id, Category.id_comp])
  have E1 : ∀ i, τ' i ≫ Limits.pullback.snd uu b = 𝟙 T' := fun i =>
    Limits.pullback.lift_snd _ _ _
  have E2 : ∀ i, τ' i ≫ Limits.pullback.fst uu b = b ≫ τ i := fun i =>
    Limits.pullback.lift_fst _ _ _
  have hpb : IsPullback (Limits.pullback.fst uu b) (Limits.pullback.snd uu b) uu b :=
    IsPullback.of_hasPullback uu b

  have hsec' : wcpaDjSections (Limits.pullback.snd uu b) n τ' := by
    refine ⟨E1, ?_, ?_⟩
    · intro i i' p q hii' heq
      apply hS2 i i' (b p) (b q) hii'
      have h1 := congrArg (fun x => Limits.pullback.fst uu b x) heq
      simp only at h1
      rw [pt (E2 i) p, pt (E2 i') q, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h1
      exact h1
    · intro i p
      obtain ⟨W, hW, hWsm⟩ := hS3 i (b p)
      refine ⟨Limits.pullback.fst uu b ⁻¹ᵁ W, ?_, ?_⟩
      · show Limits.pullback.fst uu b (τ' i p) ∈ W
        rw [pt (E2 i) p, Scheme.Hom.comp_apply]
        exact hW
      · have h1 : IsPullback (Limits.pullback.fst uu b ∣_ W) (Limits.pullback.fst uu b ⁻¹ᵁ W).ι
            W.ι (Limits.pullback.fst uu b) := isPullback_morphismRestrict _ W
        have h2 : IsPullback (Limits.pullback.fst uu b ∣_ W)
            ((Limits.pullback.fst uu b ⁻¹ᵁ W).ι ≫ Limits.pullback.snd uu b) (W.ι ≫ uu) b :=
          h1.paste_vert hpb
        exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) h2 hWsm

  have hstab' : ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ T')
      (E : Set ↥(Limits.pullback (Limits.pullback.snd uu b) s)),
      E ∈ irreducibleComponents ↥(Limits.pullback (Limits.pullback.snd uu b) s) →
      (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback (Limits.pullback.snd uu b) s)
          (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
            MvPolynomial.gradedAlgebra),
        IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E ∧
        θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
            MvPolynomial.gradedAlgebra ≫
          Spec.map (CommRingCat.ofHom
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
          ι ≫ Limits.pullback.snd (Limits.pullback.snd uu b) s) →
      3 ≤ (E ∩ closure Eᶜ).ncard +
        Nat.card {i : Fin n // ∃ x ∈ E, ∃ p : ↥(Spec (.of K)),
          Limits.pullback.fst (Limits.pullback.snd uu b) s x = τ' i (s p)} := by
    intro K _ _ s E hE hdat
    obtain ⟨Er, ι, θ, hci, hred, hrange, hθ⟩ := hdat
    obtain ⟨e, I1, I2⟩ : ∃ e : Limits.pullback (Limits.pullback.snd uu b) s ≅
        Limits.pullback uu (s ≫ b),
        e.hom ≫ Limits.pullback.fst uu (s ≫ b) =
          Limits.pullback.fst (Limits.pullback.snd uu b) s ≫ Limits.pullback.fst uu b ∧
        e.hom ≫ Limits.pullback.snd uu (s ≫ b) = Limits.pullback.snd (Limits.pullback.snd uu b) s :=
      ⟨_, Limits.pullbackLeftPullbackSndIso_hom_fst uu b s,
        Limits.pullbackLeftPullbackSndIso_hom_snd uu b s⟩
    obtain ⟨h, hh⟩ : ∃ h : ↥(Limits.pullback (Limits.pullback.snd uu b) s) ≃ₜ
        ↥(Limits.pullback uu (s ≫ b)), ∀ x, h x = e.hom x :=
      ⟨Scheme.homeoOfIso e, Scheme.homeoOfIso_apply e⟩
    have hE0 : h '' E ∈ irreducibleComponents ↥(Limits.pullback uu (s ≫ b)) := by
      refine image_mem_irreducibleComponents_of_isPreirreducible_fiber h h.continuous h.isOpenMap
        ?_ h.surjective hE
      intro y
      apply Set.Subsingleton.isPreirreducible
      intro a ha a' ha'
      exact h.injective (ha.trans ha'.symm)
    have hcnt : (h '' E ∩ closure (h '' E)ᶜ).ncard = (E ∩ closure Eᶜ).ncard := by
      rw [← h.image_compl, ← h.image_closure, ← Set.image_inter h.injective]
      exact Set.ncard_image_of_injective _ h.injective
    have hdat0 : ∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback uu (s ≫ b))
          (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
            MvPolynomial.gradedAlgebra),
        IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = h '' E ∧
        θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
            MvPolynomial.gradedAlgebra ≫
          Spec.map (CommRingCat.ofHom
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
          ι ≫ Limits.pullback.snd uu (s ≫ b) := by
      refine ⟨Er, ι ≫ e.hom, θ, inferInstance, hred, ?_, ?_⟩
      · ext y
        constructor
        · rintro ⟨x, rfl⟩
          refine ⟨ι x, ?_, ?_⟩
          · rw [← hrange]; exact ⟨x, rfl⟩
          · rw [hh, Scheme.Hom.comp_apply]
        · rintro ⟨z, hz, rfl⟩
          rw [← hrange] at hz
          obtain ⟨x, rfl⟩ := hz
          exact ⟨x, by rw [hh, Scheme.Hom.comp_apply]⟩
      · rw [hθ, Category.assoc, I2]
    have key := hstab K (s ≫ b) (h '' E) hE0 hdat0
    have hiff : ∀ i : Fin n,
        (∃ x ∈ E, ∃ p : ↥(Spec (.of K)),
          Limits.pullback.fst (Limits.pullback.snd uu b) s x = τ' i (s p)) ↔
        (∃ y ∈ h '' E, ∃ p : ↥(Spec (.of K)),
          Limits.pullback.fst uu (s ≫ b) y = τ i ((s ≫ b) p)) := by
      intro i
      constructor
      · rintro ⟨x, hx, p, hp⟩
        refine ⟨h x, ⟨x, hx, rfl⟩, p, ?_⟩
        rw [hh, pt I1 x, Scheme.Hom.comp_apply, hp, pt (E2 i) (s p), Scheme.Hom.comp_apply,
          Scheme.Hom.comp_apply]
      · rintro ⟨y, ⟨x, hx, rfl⟩, p, hp⟩
        refine ⟨x, hx, p, ?_⟩
        set c := Limits.pullback.fst (Limits.pullback.snd uu b) s x with hc
        have e1 : Limits.pullback.fst uu b c = τ i (b (s p)) := by
          have h1 := pt I1 x
          rw [Scheme.Hom.comp_apply, ← hh, hp, Scheme.Hom.comp_apply] at h1
          exact h1.symm
        have e2 : Limits.pullback.snd uu b c = s p := by
          rw [hc, pt (Limits.pullback.condition (f := Limits.pullback.snd uu b) (g := s)) x,
            Scheme.Hom.comp_apply,
            Subsingleton.elim (Limits.pullback.snd (Limits.pullback.snd uu b) s x) p]
        have hc1 : Limits.pullback.fst uu b c = τ i (b (Limits.pullback.snd uu b c)) := by
          rw [e2]; exact e1
        have key2 := (wcpa_dj_mm_section_point_unique Z T T' (Limits.pullback uu b) uu b
          (Limits.pullback.fst uu b) (Limits.pullback.snd uu b) (τ i) (τ' i) hpb (hS1 i) (E1 i)
          (E2 i) c).mp hc1
        rw [key2, e2]
    have hcard : Nat.card {i : Fin n // ∃ x ∈ E, ∃ p : ↥(Spec (.of K)),
          Limits.pullback.fst (Limits.pullback.snd uu b) s x = τ' i (s p)} =
        Nat.card {i : Fin n // ∃ y ∈ h '' E, ∃ p : ↥(Spec (.of K)),
          Limits.pullback.fst uu (s ≫ b) y = τ i ((s ≫ b) p)} :=
      Nat.card_congr (Equiv.subtypeEquivRight hiff)
    rw [hcard, ← hcnt]
    exact key
  exact ⟨τ', ⟨wcpa_dj_mm_semistable_basechange T T' Z b uu hss, hsec', hstab'⟩, E1, E2⟩

theorem wcpa_dj_lus_generic_fibre_stable : ∀ (k : Type u) [Field k] [Finite k] (X P : Scheme.{u})
    [AlgebraicGeometry.IsIntegral X] [AlgebraicGeometry.IsIntegral P] (sP : P ⟶ Spec (.of k))
    (f : X ⟶ P) (U : P.Opens) (n : ℕ) (σ : Fin n → (P ⟶ X)), wcpaDjSmIn k sP f U σ →
    wcpaDjIsProjOver (AlgebraicClosure P.functionField)
      (Limits.pullback.snd f (Spec.map (CommRingCat.ofHom (algebraMap P.functionField
        (AlgebraicClosure P.functionField))) ≫ P.fromSpecStalk (genericPoint P))) ∧
    ∃ x : Fin n → (Spec (.of (AlgebraicClosure P.functionField)) ⟶ Limits.pullback f
        (Spec.map (CommRingCat.ofHom (algebraMap P.functionField
          (AlgebraicClosure P.functionField))) ≫ P.fromSpecStalk (genericPoint P))),
      (∀ i, x i ≫ Limits.pullback.snd f (Spec.map (CommRingCat.ofHom (algebraMap P.functionField
          (AlgebraicClosure P.functionField))) ≫ P.fromSpecStalk (genericPoint P)) = 𝟙 _) ∧
      (∀ i, x i ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap P.functionField
          (AlgebraicClosure P.functionField))) ≫ P.fromSpecStalk (genericPoint P)) =
        (Spec.map (CommRingCat.ofHom (algebraMap P.functionField
          (AlgebraicClosure P.functionField))) ≫ P.fromSpecStalk (genericPoint P)) ≫ σ i) ∧
      wcpaDjStablePtd (Limits.pullback.snd f (Spec.map (CommRingCat.ofHom (algebraMap
        P.functionField (AlgebraicClosure P.functionField))) ≫ P.fromSpecStalk (genericPoint P)))
        n x :=
by

  have s2 : ∀ {X P T : Scheme.{u}} (f : X ⟶ P) (U : P.Opens) (a : T ⟶ P),
      Set.range ⇑a ⊆ (U : Set P) → SmoothOfRelativeDimension 1 (f ∣_ U) →
      GeometricallyConnected (f ∣_ U) →
      SmoothOfRelativeDimension 1 (Limits.pullback.snd f a) ∧
        GeometricallyConnected (Limits.pullback.snd f a) := by
    intro X P T f U a ha hsm hgc
    have h' : Set.range ⇑a ⊆ Set.range ⇑U.ι := by rw [Scheme.Opens.range_ι]; exact ha
    let aU := IsOpenImmersion.lift U.ι a h'
    have haU : aU ≫ U.ι = a := IsOpenImmersion.lift_fac _ _ _
    have hR := isPullback_morphismRestrict f U
    let h₁₁ := hR.lift (Limits.pullback.snd f a ≫ aU) (Limits.pullback.fst f a)
      (by rw [Category.assoc, haU]; exact Limits.pullback.condition.symm)
    have e1 : h₁₁ ≫ (f ∣_ U) = Limits.pullback.snd f a ≫ aU := hR.lift_fst _ _ _
    have e2 : h₁₁ ≫ (f ⁻¹ᵁ U).ι = Limits.pullback.fst f a := hR.lift_snd _ _ _
    have hsq : IsPullback h₁₁ (Limits.pullback.snd f a) (f ∣_ U) aU := by
      have hbig : IsPullback (h₁₁ ≫ (f ⁻¹ᵁ U).ι) (Limits.pullback.snd f a) f (aU ≫ U.ι) := by
        rw [e2, haU]; exact IsPullback.of_hasPullback f a
      exact IsPullback.of_right hbig e1 hR.flip
    exact ⟨MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hsq hsm,
      MorphismProperty.of_isPullback (P := @GeometricallyConnected) hsq hgc⟩

  have s3 : ∀ (k : Type u) [Field k] (X P : Scheme.{u}) (sP : P ⟶ Spec (.of k)) (f : X ⟶ P)
      (Ω : Type u) [Field Ω] (a : Spec (.of Ω) ⟶ P), wcpaDjIsProjOver k (f ≫ sP) →
      wcpaDjIsProjOver k sP → wcpaDjIsProjOver Ω (Limits.pullback.snd f a) := by
    intro k _ X P sP f Ω _ a hf hP
    haveI : IsProper sP := wcpa_dj_proj_proper k sP hP
    obtain ⟨N, j', hj', hj'eq⟩ := wcpa_dj_lus_proj_ring_basechange k Ω
      (Spec.preimage (a ≫ sP)).hom X (f ≫ sP) hf
    haveI := hj'
    have ht : Spec.map (CommRingCat.ofHom (Spec.preimage (a ≫ sP)).hom) = a ≫ sP := by
      rw [CommRingCat.ofHom_hom, Spec.map_preimage]
    have key : ∀ (t : Spec (.of Ω) ⟶ Spec (.of k)) (ht : a ≫ sP = t),
        IsClosedImmersion (Limits.pullback.map f a (f ≫ sP) t (𝟙 X) (𝟙 _) sP
          (by rw [Category.id_comp]) (by rw [Category.id_comp, ht])) := by
      intro t ht
      subst ht
      exact (inferInstance : IsClosedImmersion (Limits.pullback.mapDesc f a sP))
    let l := Limits.pullback.map f a (f ≫ sP)
      (Spec.map (CommRingCat.ofHom (Spec.preimage (a ≫ sP)).hom)) (𝟙 X) (𝟙 _) sP
      (by rw [Category.id_comp]) (by rw [Category.id_comp, ht])
    haveI : IsClosedImmersion l := key _ ht.symm
    refine ⟨N, l ≫ j', inferInstance, ?_⟩
    rw [Category.assoc, hj'eq]
    exact (Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _)

  have s4 : ∀ (Ω : Type u) [Field Ω] (C : Scheme.{u}) (c : C ⟶ Spec (.of Ω)) (n : ℕ)
      (x : Fin n → (Spec (.of Ω) ⟶ C)), wcpaDjIsProjOver Ω c → SmoothOfRelativeDimension 1 c →
      GeometricallyConnected c → 3 ≤ n → (∀ i, x i ≫ c = 𝟙 _) →
      (∀ (i j : Fin n) (p q : ↥(Spec (.of Ω))), i ≠ j → x i p ≠ x j q) →
      wcpaDjStablePtd c n x := by
    intro Ω _ C c n x hproj hsm hgc hn hxs hdisj
    have hW : ∀ {Y Z : Scheme.{u}} (g : Y ⟶ Z) [SmoothOfRelativeDimension 1 g] (y : Y),
        ∃ W : Y.Opens, y ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ g) := by
      intro Y Z g _ y
      have : SmoothOfRelativeDimension (0 + 1) ((⊤ : Y.Opens).ι ≫ g) := inferInstance
      exact ⟨⊤, trivial, this⟩
    haveI : Smooth c := SmoothOfRelativeDimension.smooth 1 c
    refine ⟨⟨inferInstance, wcpa_dj_proj_proper Ω c hproj, ?_⟩,
      ⟨hxs, hdisj, fun j p => hW c _⟩, ?_⟩
    · intro K _ _ s w
      haveI : SmoothOfRelativeDimension 1 (Limits.pullback.snd c s) :=
        MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1)
          (IsPullback.of_hasPullback c s) hsm
      exact Or.inl (hW _ w)
    · intro K _ _ s E hE _
      haveI : SmoothOfRelativeDimension 1 (Limits.pullback.snd c s) :=
        MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1)
          (IsPullback.of_hasPullback c s) hsm
      haveI : Smooth (Limits.pullback.snd c s) := SmoothOfRelativeDimension.smooth 1 _
      haveI : ConnectedSpace ↥(Limits.pullback c s) :=
        hgc.geometrically_connectedSpace s (Limits.pullback.fst c s) (Limits.pullback.snd c s)
          (IsPullback.of_hasPullback c s)
      haveI : IrreducibleSpace ↥(Limits.pullback c s) :=
        wc_smooth_algclosed_connected_irreducible K _ (Limits.pullback.snd c s)
      have hEu : E = Set.univ := by
        rw [irreducibleComponents_eq_singleton] at hE
        exact hE
      subst hEu
      have hall : ∀ i, ∃ x' ∈ (Set.univ : Set ↥(Limits.pullback c s)),
          ∃ p, (Limits.pullback.fst c s) x' = (x i) (s p) := by
        intro i
        let p : ↥(Spec (.of K)) := IsLocalRing.closedPoint K
        have hc : c (x i (s p)) = s p := by
          rw [← Scheme.Hom.comp_apply, hxs i]
          rfl
        obtain ⟨z, hz, _⟩ := Scheme.Pullback.exists_preimage_pullback (x i (s p)) p hc
        exact ⟨z, Set.mem_univ _, p, hz⟩
      have hcard : Nat.card {i // ∃ x' ∈ (Set.univ : Set ↥(Limits.pullback c s)),
          ∃ p, (Limits.pullback.fst c s) x' = (x i) (s p)} = n :=
        (Nat.card_congr (Equiv.subtypeUnivEquiv hall)).trans (Nat.card_fin n)
      simp only [Set.compl_univ, closure_empty, Set.inter_empty, Set.ncard_empty, zero_add]
      rw [hcard]
      exact hn
  intro k _ _ X P _ _ sP f U n σ hin
  obtain ⟨hfproj, hPproj, hU, hsm, hgc, hn, hσ, hσd⟩ := hin

  have hη : genericPoint P ∈ (U : Set P) := by
    rw [(genericPoint_spec P).mem_open_set_iff U.isOpen, Set.univ_inter]
    exact (TopologicalSpace.Opens.ne_bot_iff_nonempty U).mp hU
  have hrange : Set.range ⇑(Spec.map (CommRingCat.ofHom (algebraMap P.functionField
      (AlgebraicClosure P.functionField))) ≫ P.fromSpecStalk (genericPoint P)) ⊆ (U : Set P) := by
    rintro _ ⟨p, rfl⟩
    rw [Scheme.Hom.comp_apply]
    have hsp := Set.mem_range_self (f := ⇑(P.fromSpecStalk (genericPoint P)))
      ((Spec.map (CommRingCat.ofHom (algebraMap P.functionField
        (AlgebraicClosure P.functionField)))) p)
    rw [Scheme.range_fromSpecStalk] at hsp
    exact Specializes.mem_open hsp U.isOpen hη
  generalize (Spec.map (CommRingCat.ofHom (algebraMap P.functionField
      (AlgebraicClosure P.functionField))) ≫ P.fromSpecStalk (genericPoint P)) = a at hrange ⊢
  obtain ⟨hsmc, hgcc⟩ := s2 f U a hrange hsm hgc
  have hprojc := s3 k X P sP f (AlgebraicClosure P.functionField) a hfproj hPproj
  let x : Fin n → (Spec (.of (AlgebraicClosure P.functionField)) ⟶ Limits.pullback f a) :=
    fun i => Limits.pullback.lift (a ≫ σ i) (𝟙 _)
      (by rw [Category.assoc, hσ i, Category.comp_id, Category.id_comp])
  have hxs : ∀ i, x i ≫ Limits.pullback.snd f a = 𝟙 _ := fun i => Limits.pullback.lift_snd _ _ _
  have hxf : ∀ i, x i ≫ Limits.pullback.fst f a = a ≫ σ i := fun i =>
    Limits.pullback.lift_fst _ _ _
  have hdisj : ∀ (i j : Fin n) (p q : ↥(Spec (.of (AlgebraicClosure P.functionField)))),
      i ≠ j → x i p ≠ x j q := by
    intro i j p q hij hpq
    have hq : q = p := Subsingleton.elim _ _
    subst hq
    have h1 : (x i ≫ Limits.pullback.fst f a) q = (x j ≫ Limits.pullback.fst f a) q := by
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hpq]
    rw [hxf, hxf, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h1
    exact hσd i j (a q) (hrange ⟨q, rfl⟩) hij h1
  exact ⟨hprojc, x, hxs, hxf, s4 _ _ _ n x hprojc hsmc hgcc hn hxs hdisj⟩

theorem wcpa_dj_lus_coarsening : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω)
    (r : ℕ), ringKrullDim ↥W ≤ ((r + 1 : ℕ) : WithBot ℕ∞) →
    ∃ (W' : ValuationSubring Ω) (Wb : ValuationSubring (IsLocalRing.ResidueField ↥W')),
      W ≤ W' ∧ ringKrullDim ↥W' ≤ ((r : ℕ) : WithBot ℕ∞) ∧
      ringKrullDim ↥Wb ≤ ((1 : ℕ) : WithBot ℕ∞) ∧ IsAlgClosed (IsLocalRing.ResidueField ↥W') ∧
      ∀ x : Ω, x ∈ W ↔ ∃ h : x ∈ W',
        algebraMap ↥W' (IsLocalRing.ResidueField ↥W') ⟨x, h⟩ ∈ Wb :=
by
  intro Ω _ _ W r hW

  have F1 : ∀ (K : Type u) [Field K] (A : ValuationSubring K),
      ringKrullDim A = Order.krullDim {S : ValuationSubring K // A ≤ S} := by
    intro K _ A
    rw [ringKrullDim, ← Order.krullDim_orderDual]
    exact Order.krullDim_eq_of_orderIso (ValuationSubring.primeSpectrumOrderEquiv A)

  obtain ⟨W', hle, hdim, himm⟩ : ∃ W' : ValuationSubring Ω, W ≤ W' ∧
      ringKrullDim ↥W' ≤ ((r : ℕ) : WithBot ℕ∞) ∧
      ∀ S : ValuationSubring Ω, W < S → ¬ S < W' := by
    by_cases hA : ringKrullDim ↥W ≤ ((r : ℕ) : WithBot ℕ∞)
    · exact ⟨W, le_rfl, hA, fun S h1 h2 => lt_irrefl _ (h1.trans h2)⟩
    · rw [F1] at hA hW
      have hlt : ((r : ℕ) : WithBot ℕ∞) < Order.krullDim {S : ValuationSubring Ω // W ≤ S} :=
        not_le.mp hA
      rw [Order.krullDim, lt_iSup_iff] at hlt
      obtain ⟨l, hl⟩ := hlt
      have hlr : r < l.length := by exact_mod_cast hl
      have hlen : ∀ p : LTSeries {S : ValuationSubring Ω // W ≤ S}, p.length ≤ r + 1 := by
        intro p
        have := (Order.LTSeries.length_le_krullDim p).trans hW
        exact_mod_cast this
      have hl0 : l.length ≠ 0 := by omega
      have h01 : l ⟨0, by omega⟩ < l ⟨1, by omega⟩ := l.step ⟨0, by omega⟩
      have hW0 : W ≤ (l ⟨0, by omega⟩).val := (l ⟨0, by omega⟩).2
      have hWW' : W < (l ⟨1, by omega⟩).val := lt_of_le_of_lt hW0 h01
      refine ⟨(l ⟨1, by omega⟩).val, hWW'.le, ?_, ?_⟩
      · rw [F1, Order.krullDim]
        apply iSup_le
        intro p
        let ι : {S : ValuationSubring Ω // (l ⟨1, by omega⟩).val ≤ S} →
            {S : ValuationSubring Ω // W ≤ S} :=
          fun S => ⟨S.val, hWW'.le.trans S.2⟩
        have hι : StrictMono ι := fun a b hab => hab
        have hlt' : (⟨W, le_rfl⟩ : {S : ValuationSubring Ω // W ≤ S}) < (p.map ι hι).head := by
          rw [LTSeries.head_map]
          show W < p.head.val
          exact lt_of_lt_of_le hWW' p.head.2
        have := hlen ((p.map ι hι).cons ⟨W, le_rfl⟩ hlt')
        rw [RelSeries.cons_length, LTSeries.map_length] at this
        exact_mod_cast (by omega : p.length ≤ r)
      · intro S hWS hSW'
        have hlt2 : (⟨S, hWS.le⟩ : {S : ValuationSubring Ω // W ≤ S}) < (l.tail hl0).head := by
          rw [RelSeries.head_tail]
          show S < (l.toFun 1).val
          convert hSW' using 3
          apply Fin.ext
          have h2 : 1 < l.length + 1 := by omega
          simp only [Fin.val_one']
          exact Nat.mod_eq_of_lt h2
        have hlt3 : (⟨W, le_rfl⟩ : {S : ValuationSubring Ω // W ≤ S}) <
            ((l.tail hl0).cons ⟨S, hWS.le⟩ hlt2).head := by
          rw [RelSeries.head_cons]
          exact hWS
        have := hlen (((l.tail hl0).cons ⟨S, hWS.le⟩ hlt2).cons ⟨W, le_rfl⟩ hlt3)
        rw [RelSeries.cons_length, RelSeries.cons_length, RelSeries.tail_length] at this
        omega

  set κ := IsLocalRing.ResidueField ↥W' with hκdef
  set res : ↥W' →+* κ := algebraMap ↥W' κ with hres
  have hres0 : ∀ y : ↥W', res y = 0 ↔ y ∈ IsLocalRing.maximalIdeal ↥W' := by
    intro y
    rw [hres, IsLocalRing.ResidueField.algebraMap_eq]
    exact IsLocalRing.residue_eq_zero_iff y
  have hsurj : Function.Surjective res := by
    rw [hres, IsLocalRing.ResidueField.algebraMap_eq]
    exact IsLocalRing.residue_surjective
  have HI : ∀ (x : Ω) (h1 : x ∈ W') (h2 : x⁻¹ ∈ W'), res ⟨x⁻¹, h2⟩ = (res ⟨x, h1⟩)⁻¹ := by
    intro x h1 h2
    by_cases hx : x = 0
    · subst hx
      have e : (⟨(0:Ω)⁻¹, h2⟩ : ↥W') = 0 := Subtype.ext (by simp)
      have e' : (⟨(0:Ω), h1⟩ : ↥W') = 0 := rfl
      rw [e, e', map_zero, inv_zero]
    · apply eq_inv_of_mul_eq_one_left
      rw [← map_mul]
      have e : (⟨x⁻¹, h2⟩ : ↥W') * ⟨x, h1⟩ = 1 := Subtype.ext (by simp [hx])
      rw [e, map_one]
  have HM : ∀ (x : Ω) (h1 : x ∈ W'), x⁻¹ ∉ W' → res ⟨x, h1⟩ = 0 := by
    intro x h1 h2
    rw [hres0]
    by_contra hc
    obtain ⟨u, hu⟩ := (IsLocalRing.notMem_maximalIdeal.mp hc).exists_left_inv
    apply h2
    have e : (u : Ω) * x = 1 := congrArg Subtype.val hu
    have : (u : Ω) = x⁻¹ := eq_inv_of_mul_eq_one_left e
    rw [← this]
    exact u.2
  have Hmax : ∀ y : ↥W', y ∈ IsLocalRing.maximalIdeal ↥W' → (y : Ω) ∈ W := by
    intro y hy
    by_contra hc
    have h1 : (y : Ω)⁻¹ ∈ W := (W.mem_or_inv_mem _).resolve_left hc
    have hy0 : (y : Ω) ≠ 0 := fun h => hc (h ▸ zero_mem W)
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hy
    apply hy
    exact ⟨⟨y, ⟨(y : Ω)⁻¹, hle h1⟩, Subtype.ext (mul_inv_cancel₀ hy0),
      Subtype.ext (inv_mul_cancel₀ hy0)⟩, rfl⟩

  obtain ⟨Wb, hWb⟩ : ∃ Wb : ValuationSubring κ,
      ∀ z, z ∈ Wb ↔ ∃ y : ↥W', (y : Ω) ∈ W ∧ res y = z := by
    refine ⟨{ carrier := {z | ∃ y : ↥W', (y : Ω) ∈ W ∧ res y = z}
              mul_mem' := by
                rintro _ _ ⟨a, ha, rfl⟩ ⟨b, hb, rfl⟩
                exact ⟨a * b, mul_mem ha hb, map_mul _ _ _⟩
              one_mem' := ⟨1, one_mem _, map_one _⟩
              add_mem' := by
                rintro _ _ ⟨a, ha, rfl⟩ ⟨b, hb, rfl⟩
                exact ⟨a + b, add_mem ha hb, map_add _ _ _⟩
              zero_mem' := ⟨0, zero_mem _, map_zero _⟩
              neg_mem' := by
                rintro _ ⟨a, ha, rfl⟩
                exact ⟨-a, neg_mem ha, map_neg _ _⟩
              mem_or_inv_mem' := by
                intro z
                obtain ⟨y, rfl⟩ := hsurj z
                by_cases h2 : (y : Ω)⁻¹ ∈ W'
                · rcases W.mem_or_inv_mem (y : Ω) with h | h
                  · exact Or.inl ⟨y, h, rfl⟩
                  · exact Or.inr ⟨⟨(y : Ω)⁻¹, h2⟩, h, HI (y : Ω) y.2 h2⟩
                · refine Or.inl ⟨0, zero_mem _, ?_⟩
                  rw [map_zero]
                  exact (HM (y : Ω) y.2 h2).symm }, fun z => Iff.rfl⟩
  have hiff : ∀ x : Ω, x ∈ W ↔ ∃ h : x ∈ W', res ⟨x, h⟩ ∈ Wb := by
    intro x
    constructor
    · intro hx
      exact ⟨hle hx, (hWb _).2 ⟨⟨x, hle hx⟩, hx, rfl⟩⟩
    · rintro ⟨h, hz⟩
      obtain ⟨y, hy, he⟩ := (hWb _).1 hz
      have h0 : res (⟨x, h⟩ - y) = 0 := by rw [map_sub, he, sub_self]
      have h1 : ((⟨x, h⟩ - y : ↥W') : Ω) ∈ W := Hmax _ ((hres0 _).1 h0)
      have h2 := add_mem h1 hy
      have e : ((⟨x, h⟩ - y : ↥W') : Ω) + (y : Ω) = x := by
        show (x - (y : Ω)) + (y : Ω) = x
        exact sub_add_cancel x (y : Ω)
      rw [e] at h2
      exact h2

  obtain ⟨ST, hST⟩ : ∃ ST : ValuationSubring κ → ValuationSubring Ω,
      ∀ T x, x ∈ ST T ↔ ∃ h : x ∈ W', res ⟨x, h⟩ ∈ T := by
    refine ⟨fun T =>
      { carrier := {x | ∃ h : x ∈ W', res ⟨x, h⟩ ∈ T}
        mul_mem' := by
          rintro a b ⟨ha, ha'⟩ ⟨hb, hb'⟩
          refine ⟨mul_mem ha hb, ?_⟩
          have e : (⟨a * b, mul_mem ha hb⟩ : ↥W') = ⟨a, ha⟩ * ⟨b, hb⟩ := rfl
          rw [e, map_mul]
          exact mul_mem ha' hb'
        one_mem' := by
          refine ⟨one_mem _, ?_⟩
          have e : (⟨1, one_mem _⟩ : ↥W') = 1 := rfl
          rw [e, map_one]
          exact one_mem _
        add_mem' := by
          rintro a b ⟨ha, ha'⟩ ⟨hb, hb'⟩
          refine ⟨add_mem ha hb, ?_⟩
          have e : (⟨a + b, add_mem ha hb⟩ : ↥W') = ⟨a, ha⟩ + ⟨b, hb⟩ := rfl
          rw [e, map_add]
          exact add_mem ha' hb'
        zero_mem' := by
          refine ⟨zero_mem _, ?_⟩
          have e : (⟨0, zero_mem _⟩ : ↥W') = 0 := rfl
          rw [e, map_zero]
          exact zero_mem _
        neg_mem' := by
          rintro a ⟨ha, ha'⟩
          refine ⟨neg_mem ha, ?_⟩
          have e : (⟨-a, neg_mem ha⟩ : ↥W') = -⟨a, ha⟩ := rfl
          rw [e, map_neg]
          exact neg_mem ha'
        mem_or_inv_mem' := by
          intro x
          by_cases h1 : x ∈ W'
          · by_cases h2 : x⁻¹ ∈ W'
            · rcases T.mem_or_inv_mem (res ⟨x, h1⟩) with h | h
              · exact Or.inl ⟨h1, h⟩
              · refine Or.inr ⟨h2, ?_⟩
                rw [HI x h1 h2]
                exact h
            · refine Or.inl ⟨h1, ?_⟩
              rw [HM x h1 h2]
              exact zero_mem _
          · have h2 : x⁻¹ ∈ W' := (W'.mem_or_inv_mem x).resolve_left h1
            have h3 : x⁻¹⁻¹ ∉ W' := by rw [inv_inv]; exact h1
            refine Or.inr ⟨h2, ?_⟩
            rw [HM x⁻¹ h2 h3]
            exact zero_mem _ }, fun T x => Iff.rfl⟩
  have hdimb : ringKrullDim ↥Wb ≤ ((1 : ℕ) : WithBot ℕ∞) := by
    rw [F1]
    have hWST : ∀ T : ValuationSubring κ, Wb ≤ T → W ≤ ST T := by
      intro T hT x hx
      obtain ⟨h, hz⟩ := (hiff x).1 hx
      exact (hST T x).2 ⟨h, hT hz⟩
    have hSTW' : ∀ T, ST T ≤ W' := fun T x hx => ((hST T x).1 hx).1
    let Φ : {T : ValuationSubring κ // Wb ≤ T} → {S : ValuationSubring Ω // W ≤ S ∧ S ≤ W'} :=
      fun T => ⟨ST T.1, hWST T.1 T.2, hSTW' T.1⟩
    have hΦ : StrictMono Φ := by
      intro a b hab
      show ST a.1 < ST b.1
      have hab' : a.1 < b.1 := hab
      obtain ⟨hle', z, hzb, hza⟩ := SetLike.lt_iff_le_and_exists.mp hab'
      rw [SetLike.lt_iff_le_and_exists]
      refine ⟨fun x hx => ?_, ?_⟩
      · obtain ⟨h, h'⟩ := (hST _ x).1 hx
        exact (hST _ x).2 ⟨h, hle' h'⟩
      · obtain ⟨y, rfl⟩ := hsurj z
        refine ⟨(y : Ω), (hST _ _).2 ⟨y.2, hzb⟩, fun hc => hza ?_⟩
        obtain ⟨h, h'⟩ := (hST _ _).1 hc
        exact h'
    refine (Order.krullDim_le_of_strictMono Φ hΦ).trans ?_
    rw [Nat.cast_one, Order.krullDim_le_one_iff]
    intro s
    by_cases hs : s.1 = W
    · left
      intro b _
      show s.1 ≤ b.1
      rw [hs]
      exact b.2.1
    · right
      intro b _
      have h1 : W < s.1 := lt_of_le_of_ne s.2.1 (Ne.symm hs)
      have h2 : s.1 = W' := by
        by_contra hne
        exact himm s.1 h1 (lt_of_le_of_ne s.2.2 hne)
      show b.1 ≤ s.1
      rw [h2]
      exact b.2.2

  have hκ : IsAlgClosed κ := by
    apply IsAlgClosed.of_exists_root
    intro p hmon hirr
    obtain ⟨q0, hq0⟩ := Polynomial.map_surjective res hsurj p
    obtain ⟨q, hqmap, hqdeg, hqmon⟩ := Polynomial.lifts_and_natDegree_eq_and_monic
      ((Polynomial.mem_lifts p).mpr ⟨q0, hq0⟩) hmon
    have hpdeg : 0 < p.natDegree := Irreducible.natDegree_pos hirr
    have hdeg : (q.map (algebraMap ↥W' Ω)).degree ≠ 0 := by
      rw [hqmon.degree_map, Polynomial.degree_eq_natDegree hqmon.ne_zero, hqdeg]
      exact_mod_cast hpdeg.ne'
    obtain ⟨θ, hθ⟩ := IsAlgClosed.exists_root _ hdeg
    have hθ' : Polynomial.eval θ (q.map (algebraMap ↥W' Ω)) = 0 := hθ
    have hint : _root_.IsIntegral (↥W') θ :=
      ⟨q, hqmon, by rw [Polynomial.eval_map] at hθ'; exact hθ'⟩
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    refine ⟨res y, ?_⟩
    have hqy : Polynomial.eval y q = 0 := by
      have := Polynomial.eval₂_at_apply (p := q) (algebraMap ↥W' Ω) y
      rw [hy, ← Polynomial.eval_map, hθ'] at this
      exact (IsFractionRing.injective ↥W' Ω) (by rw [map_zero]; exact this.symm)
    rw [← hqmap, Polynomial.eval_map, Polynomial.eval₂_at_apply, hqy, map_zero]
  exact ⟨W', Wb, hle, hdim, hdimb, hκ, hiff⟩

theorem wcpa_dj_lus_valuation_finite_rank : ∀ (k : Type u) [Field k] [Finite k] (P : Scheme.{u})
    [AlgebraicGeometry.IsIntegral P] (sP : P ⟶ Spec (.of k)), wcpaDjIsProjOver k sP →
    ∀ W : ValuationSubring (AlgebraicClosure P.functionField),
      ∃ r : ℕ, ringKrullDim ↥W ≤ ((r : ℕ) : WithBot ℕ∞) :=
by
  intro k _ _ P _ sP hproj W
  classical
  haveI := wcpa_dj_proj_proper k sP hproj
  letI iK : Algebra k P.functionField := ((Scheme.ΓSpecIso (.of k)).inv ≫ sP.appTop ≫
    P.presheaf.germ ⊤ (genericPoint P) trivial).hom.toAlgebra
  obtain ⟨-, n, t, ht, -⟩ := wcpa_dj_cf_sp_function_field_trdeg k P sP

  have hsm : ∀ a b c : W.ValueGroup, a ≠ 0 → b < c → a * b < a * c := by
    intro a b c ha hbc
    by_contra hc
    push_neg at hc
    have h2 : a⁻¹ * (a * c) ≤ a⁻¹ * (a * b) := mul_le_mul' le_rfl hc
    rw [← mul_assoc, ← mul_assoc, inv_mul_cancel₀ ha, one_mul, one_mul] at h2
    exact absurd h2 (not_le.mpr hbc)

  have hmul2 : ∀ x y z : W.ValueGroup, (∀ N : ℕ, x < y ^ N) → (∀ N : ℕ, x < z ^ N) →
      ∀ N : ℕ, x < (y * z) ^ N := by
    intro x y z hy hz N
    rcases le_total y z with h | h
    · calc x < y ^ (N + N) := hy _
        _ = (y * y) ^ N := by rw [mul_pow, pow_add]
        _ ≤ (y * z) ^ N := pow_le_pow_left' (mul_le_mul' le_rfl h) N
    · calc x < z ^ (N + N) := hz _
        _ = (z * z) ^ N := by rw [mul_pow, pow_add]
        _ ≤ (y * z) ^ N := pow_le_pow_left' (mul_le_mul' h le_rfl) N
  have hprod : ∀ (m : ℕ) (x : W.ValueGroup) (g : Fin m → W.ValueGroup) (e : Fin m → ℕ), x < 1 →
      (∀ j, ∀ N : ℕ, x < g j ^ N) → ∀ N : ℕ, x < (∏ j, g j ^ e j) ^ N := by
    intro m x g e hx1 hg
    refine Finset.prod_induction (fun j => g j ^ e j) (fun y => ∀ N : ℕ, x < y ^ N) ?_ ?_ ?_
    · intro y z hy hz
      exact hmul2 x y z hy hz
    · intro N
      rw [one_pow]
      exact hx1
    · intro j _ N
      rw [← pow_mul]
      exact hg j _

  have hinj : ∀ (m : ℕ) (g : Fin m → W.ValueGroup), (∀ j, g j ≠ 0) → (∀ j, g j < 1) →
      (∀ j i : Fin m, j < i → ∀ N : ℕ, g j < g i ^ N) →
      ∀ e e' : Fin m → ℕ, ∏ j, g j ^ e j = ∏ j, g j ^ e' j → e = e' := by
    intro m
    induction m with
    | zero =>
      intro g _ _ _ e e' _
      funext j
      exact j.elim0
    | succ m ih =>
      intro g h0 h1 hd e e' he
      rw [Fin.prod_univ_succ, Fin.prod_univ_succ] at he
      have hR : ∀ e'' : Fin (m + 1) → ℕ, g 0 < ∏ j : Fin m, g j.succ ^ e'' j.succ := by
        intro e''
        have h2 := hprod m (g 0) (fun j => g j.succ) (fun j => e'' j.succ) (h1 0)
          (fun j N => hd 0 j.succ (Fin.succ_pos j) N) 1
        rw [pow_one] at h2
        exact h2
      have hR1 : ∀ e'' : Fin (m + 1) → ℕ, ∏ j : Fin m, g j.succ ^ e'' j.succ ≤ 1 := by
        intro e''
        exact Finset.prod_le_one' (fun j _ => pow_le_one' (h1 j.succ).le _)
      have key : ∀ e e' : Fin (m + 1) → ℕ, e 0 < e' 0 →
          g 0 ^ e 0 * ∏ j : Fin m, g j.succ ^ e j.succ ≠
            g 0 ^ e' 0 * ∏ j : Fin m, g j.succ ^ e' j.succ := by
        intro e e' hlt heq
        obtain ⟨c, hc⟩ := Nat.exists_eq_add_of_lt hlt
        have hc1 : g 0 ^ c ≤ 1 := pow_le_one' (h1 0).le c
        have hA : g 0 ^ e' 0 * ∏ j : Fin m, g j.succ ^ e' j.succ ≤ g 0 ^ e 0 * g 0 := by
          rw [hc, pow_add, pow_add, pow_one, mul_assoc, mul_assoc]
          refine mul_le_mul' le_rfl ?_
          calc g 0 ^ c * (g 0 * ∏ j : Fin m, g j.succ ^ e' j.succ) ≤ 1 * (g 0 * 1) :=
                mul_le_mul' hc1 (mul_le_mul' le_rfl (hR1 e'))
            _ = g 0 := by rw [one_mul, mul_one]
        have hB : g 0 ^ e 0 * g 0 < g 0 ^ e 0 * ∏ j : Fin m, g j.succ ^ e j.succ :=
          hsm _ _ _ (pow_ne_zero _ (h0 0)) (hR e)
        rw [← heq] at hA
        exact absurd hA (not_le.mpr hB)
      have h0e : e 0 = e' 0 := by
        rcases lt_trichotomy (e 0) (e' 0) with h | h | h
        · exact absurd he (key e e' h)
        · exact h
        · exact absurd he.symm (key e' e h)
      rw [h0e] at he
      have hcancel := mul_left_cancel₀ (pow_ne_zero _ (h0 0)) he
      have htail := ih (fun j => g j.succ) (fun j => h0 _) (fun j => h1 _)
        (fun j i hji N => hd j.succ i.succ (Fin.succ_lt_succ_iff.mpr hji) N)
        (fun j => e j.succ) (fun j => e' j.succ) hcancel
      funext j
      cases j using Fin.cases with
      | zero => exact h0e
      | succ j => exact congrFun htail j

  have hunit : ∀ c : k, c ≠ 0 →
      W.valuation (algebraMap k (AlgebraicClosure P.functionField) c) = 1 := by
    intro c hc
    haveI := Fintype.ofFinite k
    have hq : 1 < Fintype.card k := Fintype.one_lt_card
    have hn : Fintype.card k - 1 ≠ 0 := by omega
    have h1 : c ^ (Fintype.card k - 1) = 1 := FiniteField.pow_card_sub_one_eq_one c hc
    have h2 : (W.valuation (algebraMap k (AlgebraicClosure P.functionField) c)) ^
        (Fintype.card k - 1) = 1 := by
      have h3 := congrArg (fun y => W.valuation (algebraMap k (AlgebraicClosure P.functionField) y)) h1
      simpa using h3
    rcases lt_trichotomy (W.valuation (algebraMap k (AlgebraicClosure P.functionField) c)) 1
      with h | h | h
    · exact absurd h2 ((pow_lt_one_iff hn).mpr h).ne
    · exact h
    · exact absurd h2 (one_lt_pow₀ h hn).ne'

  have hindep : ∀ (m : ℕ) (a : Fin m → AlgebraicClosure P.functionField), (∀ j, a j ≠ 0) →
      (∀ j, W.valuation (a j) < 1) →
      (∀ j i : Fin m, j < i → ∀ N : ℕ, W.valuation (a j) < W.valuation (a i) ^ N) →
      AlgebraicIndependent k a := by
    intro m a ha0 ha1 had
    rw [algebraicIndependent_iff]
    intro p hp
    by_contra hp0
    have hS : p.support.Nonempty := by
      rw [Finset.nonempty_iff_ne_empty]
      intro h
      exact hp0 (MvPolynomial.support_eq_empty.mp h)
    obtain ⟨d0, hd0, hmax⟩ := Finset.exists_max_image p.support
      (fun d : Fin m →₀ ℕ => ∏ i, W.valuation (a i) ^ d i) hS
    have hterm : ∀ d ∈ p.support,
        W.valuation (algebraMap k (AlgebraicClosure P.functionField) (p.coeff d) *
          ∏ i, a i ^ d i) = ∏ i, W.valuation (a i) ^ d i := by
      intro d hd
      rw [map_mul, hunit _ (MvPolynomial.mem_support_iff.mp hd), one_mul, map_prod]
      simp only [map_pow]
    have hsum := Valuation.map_sum_eq_of_lt W.valuation (s := p.support)
      (f := fun d => algebraMap k (AlgebraicClosure P.functionField) (p.coeff d) *
        ∏ i, a i ^ d i) hd0 (by
        intro d hd
        rw [Finset.mem_sdiff, Finset.mem_singleton] at hd
        show W.valuation (algebraMap k (AlgebraicClosure P.functionField) (p.coeff d) *
          ∏ i, a i ^ d i) < W.valuation (algebraMap k (AlgebraicClosure P.functionField)
            (p.coeff d0) * ∏ i, a i ^ d0 i)
        rw [hterm d hd.1, hterm d0 hd0]
        refine lt_of_le_of_ne (hmax d hd.1) ?_
        intro heq
        apply hd.2
        have h4 := hinj m (fun j => W.valuation (a j))
          (fun j => (W.valuation.ne_zero_iff).mpr (ha0 j)) ha1 had d d0 heq
        exact DFunLike.coe_injective h4)
    have hev : MvPolynomial.aeval a p = ∑ d ∈ p.support,
        algebraMap k (AlgebraicClosure P.functionField) (p.coeff d) * ∏ i, a i ^ d i := by
      rw [MvPolynomial.aeval_def, MvPolynomial.eval₂_eq']
    rw [← hev, hp, map_zero, hterm d0 hd0] at hsum
    have hne : ∏ i, W.valuation (a i) ^ d0 i ≠ 0 :=
      Finset.prod_ne_zero_iff.mpr
        (fun i _ => pow_ne_zero _ ((W.valuation.ne_zero_iff).mpr (ha0 i)))
    exact hne hsum.symm
  refine ⟨n, ?_⟩
  show (⨆ l : LTSeries (PrimeSpectrum W), (l.length : WithBot ℕ∞)) ≤ _
  refine iSup_le (fun l => ?_)
  have hlen : l.length ≤ n := by
    have hstep : ∀ j : Fin l.length, ∃ b : W, b ∈ (l.toFun j.succ).asIdeal ∧
        b ∉ (l.toFun j.castSucc).asIdeal := by
      intro j
      have h : l.toFun j.castSucc < l.toFun j.succ := l.step j
      obtain ⟨x, hx, hx'⟩ := SetLike.exists_of_lt ((PrimeSpectrum.asIdeal_lt_asIdeal _ _).mpr h)
      exact ⟨x, hx, hx'⟩
    choose b hb1 hb2 using hstep
    have ha0 : ∀ j, ((b j : W) : AlgebraicClosure P.functionField) ≠ 0 := by
      intro j h
      apply hb2 j
      have hb0 : b j = 0 := Subtype.ext h
      rw [hb0]
      exact Ideal.zero_mem _
    have ha1 : ∀ j, W.valuation ((b j : W) : AlgebraicClosure P.functionField) < 1 := by
      intro j
      exact (W.valuation_lt_one_iff (b j)).mp
        (IsLocalRing.le_maximalIdeal (l.toFun j.succ).isPrime.ne_top (hb1 j))
    have had : ∀ j i : Fin l.length, j < i → ∀ N : ℕ,
        W.valuation ((b j : W) : AlgebraicClosure P.functionField) <
          W.valuation ((b i : W) : AlgebraicClosure P.functionField) ^ N := by
      intro j i hji N
      by_contra hc
      push_neg at hc
      have hsub : (l.toFun j.succ).asIdeal ≤ (l.toFun i.castSucc).asIdeal :=
        (PrimeSpectrum.asIdeal_le_asIdeal _ _).mpr (l.monotone (Fin.succ_le_castSucc_iff.mpr hji))
      have hy : ((b i : W) : AlgebraicClosure P.functionField) ^ N /
          ((b j : W) : AlgebraicClosure P.functionField) ∈ W := by
        rw [← W.valuation_le_one_iff, map_div₀, map_pow]
        exact (div_le_one₀ (zero_lt_iff.mpr ((W.valuation.ne_zero_iff).mpr (ha0 j)))).mpr hc
      have heq : b i ^ N = b j * ⟨_, hy⟩ := by
        apply Subtype.ext
        rw [MulMemClass.coe_mul, SubmonoidClass.coe_pow]
        field_simp [ha0 j]
      have hmem : b i ^ N ∈ (l.toFun j.succ).asIdeal := by
        rw [heq]
        exact Ideal.mul_mem_right _ _ (hb1 j)
      exact hb2 i (hsub ((l.toFun j.succ).isPrime.mem_of_pow_mem N hmem))
    have hind := hindep l.length (fun j => ((b j : W) : AlgebraicClosure P.functionField))
      ha0 ha1 had
    have ht' := ht.algebraMap_comp (A := AlgebraicClosure P.functionField)
    have e1 := ht'.lift_cardinalMk_eq_trdeg
    have e2 := hind.lift_cardinalMk_le_trdeg
    rw [← e1, Cardinal.lift_mk_fin, Cardinal.lift_mk_fin] at e2
    exact_mod_cast e2
  exact_mod_cast hlen

theorem wcpa_dj_ssp_bw_ns_transport : ∀ (K : Type u) [Field K] {X X' : Scheme.{u}} (Φ : X ≅ X') (a : X ⟶ Spec (.of K)) (a' : X' ⟶ Spec (.of K)), Φ.hom ≫ a' = a → ∀ x : ↥X, ((∃ W : X'.Opens, Φ.hom x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ a')) ∨ (∃ e : AdicCompletion (IsLocalRing.maximalIdeal (X'.presheaf.stalk (Φ.hom x))) (X'.presheaf.stalk (Φ.hom x)) ≃+* (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), e.toRingHom.comp ((algebraMap (X'.presheaf.stalk (Φ.hom x)) (AdicCompletion (IsLocalRing.maximalIdeal (X'.presheaf.stalk (Φ.hom x))) (X'.presheaf.stalk (Φ.hom x)))).comp ((Scheme.ΓSpecIso (.of K)).inv ≫ a'.appTop ≫ X'.presheaf.germ ⊤ (Φ.hom x) trivial).hom) = (Ideal.Quotient.mk _).comp MvPowerSeries.C)) → ((∃ W : X.Opens, x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ a)) ∨ (∃ e : AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk x)) (X.presheaf.stalk x) ≃+* (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), e.toRingHom.comp ((algebraMap (X.presheaf.stalk x) (AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk x)) (X.presheaf.stalk x))).comp ((Scheme.ΓSpecIso (.of K)).inv ≫ a.appTop ≫ X.presheaf.germ ⊤ x trivial).hom) = (Ideal.Quotient.mk _).comp MvPowerSeries.C)) :=
by

  have hfe : ∀ {R : Type u} [CommRing R] (I : Ideal R) {m n : ℕ} (hle : m ≤ n)
      (y : AdicCompletion I R),
      Ideal.Quotient.factorPow I hle (AdicCompletion.evalₐ I n y) =
        AdicCompletion.evalₐ I m y := by
    intro R _ I m n hle y
    obtain ⟨s, rfl⟩ := AdicCompletion.mk_surjective I R y
    rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk]
    have key := AdicCompletion.AdicCauchySequence.mk_eq_mk hle s
    rw [Submodule.Quotient.eq] at key
    rw [Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk, Ideal.Quotient.eq]
    simpa [smul_eq_mul, Ideal.mul_top] using key

  have hadic : ∀ {A B : Type u} [CommRing A] [CommRing B] (I : Ideal A) (J : Ideal B)
      (σ : A ≃+* B), Ideal.map σ I = J → ∃ τ : AdicCompletion I A ≃+* AdicCompletion J B,
        ∀ a : A, τ (algebraMap A (AdicCompletion I A) a) =
          algebraMap B (AdicCompletion J B) (σ a) := by
    intro A B _ _ I J σ hIJ
    subst hIJ
    have h1 : ∀ n, I ^ n ≤ ((Ideal.map σ I) ^ n).comap σ.toRingHom := by
      intro n x hx
      rw [Ideal.mem_comap, ← Ideal.map_pow]
      exact Ideal.mem_map_of_mem σ hx
    have h2 : ∀ n, (Ideal.map σ I) ^ n ≤ (I ^ n).comap σ.symm.toRingHom := by
      intro n
      have : Ideal.map σ (I ^ n) ≤ (I ^ n).comap σ.symm.toRingHom := by
        rw [Ideal.map_le_iff_le_comap]
        intro x hx
        simpa [Ideal.mem_comap] using hx
      rwa [Ideal.map_pow] at this
    let f : ∀ n, A ⧸ I ^ n →+* B ⧸ (Ideal.map σ I) ^ n := fun n =>
      Ideal.quotientMap ((Ideal.map σ I) ^ n) σ.toRingHom (h1 n)
    let g : ∀ n, B ⧸ (Ideal.map σ I) ^ n →+* A ⧸ I ^ n := fun n =>
      Ideal.quotientMap (I ^ n) σ.symm.toRingHom (h2 n)
    have hgf : ∀ n z, g n (f n z) = z := by
      intro n z
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective z
      simp [f, g, Ideal.quotientMap_mk]
    have hfg : ∀ n z, f n (g n z) = z := by
      intro n z
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective z
      simp [f, g, Ideal.quotientMap_mk]
    let F : ∀ n, AdicCompletion I A →+* B ⧸ (Ideal.map σ I) ^ n := fun n =>
      (f n).comp (AdicCompletion.evalₐ I n).toRingHom
    have hF : ∀ {m n : ℕ} (hle : m ≤ n),
        (Ideal.Quotient.factorPow (Ideal.map σ I) hle).comp (F n) = F m := by
      intro m n hle
      refine RingHom.ext fun y => ?_
      show Ideal.Quotient.factorPow (Ideal.map σ I) hle (f n (AdicCompletion.evalₐ I n y)) =
        f m (AdicCompletion.evalₐ I m y)
      rw [← hfe I hle y]
      obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ I n y)
      rw [← ha]
      simp only [f, Ideal.quotientMap_mk, Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk]
    let G : ∀ n, AdicCompletion (Ideal.map σ I) B →+* A ⧸ I ^ n := fun n =>
      (g n).comp (AdicCompletion.evalₐ (Ideal.map σ I) n).toRingHom
    have hG : ∀ {m n : ℕ} (hle : m ≤ n), (Ideal.Quotient.factorPow I hle).comp (G n) = G m := by
      intro m n hle
      refine RingHom.ext fun y => ?_
      show Ideal.Quotient.factorPow I hle (g n (AdicCompletion.evalₐ (Ideal.map σ I) n y)) =
        g m (AdicCompletion.evalₐ (Ideal.map σ I) m y)
      rw [← hfe (Ideal.map σ I) hle y]
      obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ (Ideal.map σ I) n y)
      rw [← ha]
      simp only [g, Ideal.quotientMap_mk, Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk]
    let φ := AdicCompletion.liftRingHom (Ideal.map σ I) F hF
    let ψ := AdicCompletion.liftRingHom I G hG
    have hφ : ∀ n y, AdicCompletion.evalₐ (Ideal.map σ I) n (φ y) =
        f n (AdicCompletion.evalₐ I n y) :=
      fun n y => AdicCompletion.evalₐ_liftRingHom (Ideal.map σ I) F hF n y
    have hψ : ∀ n y, AdicCompletion.evalₐ I n (ψ y) =
        g n (AdicCompletion.evalₐ (Ideal.map σ I) n y) :=
      fun n y => AdicCompletion.evalₐ_liftRingHom I G hG n y
    have e1 : φ.comp ψ = RingHom.id _ := by
      refine RingHom.ext fun y => ?_
      apply AdicCompletion.ext_evalₐ
      intro n
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hφ, hψ, hfg]
    have e2 : ψ.comp φ = RingHom.id _ := by
      refine RingHom.ext fun y => ?_
      apply AdicCompletion.ext_evalₐ
      intro n
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hψ, hφ, hgf]
    refine ⟨RingEquiv.ofRingHom φ ψ e1 e2, fun a => ?_⟩
    show φ (algebraMap A (AdicCompletion I A) a) =
      algebraMap B (AdicCompletion (Ideal.map σ I) B) (σ a)
    apply AdicCompletion.ext_evalₐ
    intro n
    rw [hφ, AlgHom.commutes, AlgHom.commutes, Ideal.Quotient.algebraMap_eq,
      Ideal.Quotient.algebraMap_eq]
    simp [f, Ideal.quotientMap_mk]

  intro K _ X X' Φ a a' hΦ x h
  rcases h with ⟨W', hW', hsm⟩ | ⟨e', he'⟩
  ·
    left
    refine ⟨Φ.hom ⁻¹ᵁ W', hW', ?_⟩
    have heq : (Φ.hom ⁻¹ᵁ W').ι ≫ a = (Φ.hom ∣_ W') ≫ (W'.ι ≫ a') := by
      rw [← hΦ, ← Category.assoc, ← morphismRestrict_ι, Category.assoc]
    have : SmoothOfRelativeDimension 1 (W'.ι ≫ a') := hsm
    have : SmoothOfRelativeDimension 0 (Φ.hom ∣_ W') := inferInstance
    have hc := smoothOfRelativeDimension_comp 0 1 (Φ.hom ∣_ W') (W'.ι ≫ a')
    rw [heq]
    simpa using hc
  · right
    let σ : X'.presheaf.stalk (Φ.hom x) ≃+* X.presheaf.stalk x :=
      (asIso (Φ.hom.stalkMap x)).commRingCatIsoToRingEquiv
    have hmax : Ideal.map σ (IsLocalRing.maximalIdeal (X'.presheaf.stalk (Φ.hom x))) =
        IsLocalRing.maximalIdeal (X.presheaf.stalk x) :=
      IsLocalRing.eq_maximalIdeal (Ideal.map_isMaximal_of_equiv σ)
    obtain ⟨τ, hτ⟩ := hadic _ _ σ hmax

    have hgs : X'.presheaf.germ ⊤ (Φ.hom x) trivial ≫ Φ.hom.stalkMap x =
        Φ.hom.appTop ≫ X.presheaf.germ ⊤ x trivial := by
      exact Scheme.Hom.germ_stalkMap Φ.hom ⊤ x trivial
    have hmor : ((Scheme.ΓSpecIso (.of K)).inv ≫ a'.appTop ≫
        X'.presheaf.germ ⊤ (Φ.hom x) trivial) ≫ Φ.hom.stalkMap x =
        (Scheme.ΓSpecIso (.of K)).inv ≫ a.appTop ≫ X.presheaf.germ ⊤ x trivial := by
      rw [← hΦ, Scheme.Hom.comp_appTop, Category.assoc, Category.assoc, hgs]
      simp only [Category.assoc]
    have hgerm : ∀ c : K, σ (((Scheme.ΓSpecIso (.of K)).inv ≫ a'.appTop ≫
        X'.presheaf.germ ⊤ (Φ.hom x) trivial).hom c) =
        ((Scheme.ΓSpecIso (.of K)).inv ≫ a.appTop ≫ X.presheaf.germ ⊤ x trivial).hom c := by
      intro c
      rw [← hmor]
      rfl
    refine ⟨τ.symm.trans e', ?_⟩
    refine RingHom.ext fun c => ?_
    have h1 := RingHom.congr_fun he' c
    have h2 := hτ (((Scheme.ΓSpecIso (.of K)).inv ≫ a'.appTop ≫
        X'.presheaf.germ ⊤ (Φ.hom x) trivial).hom c)
    simp only [RingHom.comp_apply] at h1 ⊢
    rw [← hgerm c, ← h2]
    simp only [RingEquiv.toRingHom_eq_coe, RingHom.coe_coe, RingEquiv.trans_apply,
      RingEquiv.symm_apply_apply] at h1 ⊢
    exact h1

theorem wcpa_dj_nn_node_ring : ∀ (Ω : Type u) [Field Ω] (A B : Type u) [CommRing A] [IsLocalRing A]
    [IsNoetherianRing A] [CommRing B] (φ : Ω →+* A) (j : A →+* B) (d : A),
    (∃ e : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+*
        (MvPowerSeries (Fin 2) Ω ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
      e.toRingHom.comp ((algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)).comp φ) =
        (Ideal.Quotient.mk _).comp MvPowerSeries.C) →
    ringKrullDim A ≤ 1 → Function.Injective j → j.Finite → d ∈ IsLocalRing.maximalIdeal A →
    d ∈ nonZeroDivisors A → j d ∈ nonZeroDivisors B → (∀ b : B, ∃ a : A, j a = j d * b) →
    (∀ (Q : Ideal B) [Q.IsPrime], IsDomain (Localization.AtPrime Q) ∧
      IsIntegrallyClosed (Localization.AtPrime Q)) →
    ∃ χ₀ χ₁ : B →+* Ω, χ₀.comp (j.comp φ) = RingHom.id Ω ∧ χ₁.comp (j.comp φ) = RingHom.id Ω ∧
      RingHom.ker χ₀ ≠ RingHom.ker χ₁ ∧
      (∀ M : Ideal B, M.IsMaximal → M = RingHom.ker χ₀ ∨ M = RingHom.ker χ₁) ∧
      ∀ b : B, (∃ a : A, j a = b) ↔ χ₀ b = χ₁ b :=
by
  intro Ω _ A B _ _ _ _ φ j d ⟨e, he⟩ hdim hj hfin hdm hdA hdB hdiv hnorm
  classical
  have hs1 : ∀ (Ω : Type u) [Field Ω], ∃ π₀ π₁ : (MvPowerSeries (Fin 2) Ω ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}) →+* PowerSeries Ω, (∀ c : Ω, π₀ (Ideal.Quotient.mk _ (MvPowerSeries.C c)) = PowerSeries.C c) ∧ (∀ c : Ω, π₁ (Ideal.Quotient.mk _ (MvPowerSeries.C c)) = PowerSeries.C c) ∧ (∀ r, PowerSeries.constantCoeff (π₀ r) = PowerSeries.constantCoeff (π₁ r)) ∧ (∀ r, π₀ r = 0 → π₁ r = 0 → r = 0) ∧ (∀ f g : PowerSeries Ω, PowerSeries.constantCoeff f = PowerSeries.constantCoeff g → ∃ r, π₀ r = f ∧ π₁ r = g)  := by
    intro Ω _
    classical

    let T : Fin 2 → MvPowerSeries (Fin 2) Ω →+* PowerSeries Ω := fun i =>
      { toFun := fun F => PowerSeries.mk (fun n => MvPowerSeries.coeff (Finsupp.single i n) F)
        map_one' := by
          ext n
          rw [PowerSeries.coeff_mk, MvPowerSeries.coeff_one, PowerSeries.coeff_one]
          simp only [Finsupp.single_eq_zero]
        map_mul' := fun F G => by
          ext n
          rw [PowerSeries.coeff_mk, MvPowerSeries.coeff_mul, PowerSeries.coeff_mul,
            Finsupp.antidiagonal_single, Finset.sum_map]
          apply Finset.sum_congr rfl
          intro x _
          rw [PowerSeries.coeff_mk, PowerSeries.coeff_mk]
          rfl
        map_zero' := by
          ext n
          rw [PowerSeries.coeff_mk, map_zero, map_zero]
        map_add' := fun F G => by
          ext n
          rw [PowerSeries.coeff_mk, map_add, map_add, PowerSeries.coeff_mk, PowerSeries.coeff_mk] }
    have hT : ∀ i F n, PowerSeries.coeff n (T i F) = MvPowerSeries.coeff (Finsupp.single i n) F :=
      fun i F n => PowerSeries.coeff_mk n (fun n => MvPowerSeries.coeff (Finsupp.single i n) F)
    have hXX : (MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) Ω) =
        MvPowerSeries.monomial (Finsupp.single 0 1 + Finsupp.single 1 1) 1 := by
      rw [MvPowerSeries.X_def, MvPowerSeries.X_def, MvPowerSeries.monomial_mul_monomial, mul_one]
    have hkill : ∀ i, ∀ a ∈ Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 :
        MvPowerSeries (Fin 2) Ω)}, T i a = 0 := by
      intro i a ha
      obtain ⟨G, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      ext n
      rw [hT, map_zero, mul_comm, hXX, MvPowerSeries.coeff_monomial_mul, if_neg]
      intro hle
      rw [Finsupp.le_def] at hle
      fin_cases i
      · have := hle 1; simp at this
      · have := hle 0; simp at this
    let π₀ := Ideal.Quotient.lift _ (T 0) (hkill 0)
    let π₁ := Ideal.Quotient.lift _ (T 1) (hkill 1)
    have hπ₀ : ∀ F, π₀ (Ideal.Quotient.mk _ F) = T 0 F := fun F => Ideal.Quotient.lift_mk _ _ _
    have hπ₁ : ∀ F, π₁ (Ideal.Quotient.mk _ F) = T 1 F := fun F => Ideal.Quotient.lift_mk _ _ _
    have hC : ∀ i (c : Ω), T i (MvPowerSeries.C c) = PowerSeries.C c := by
      intro i c
      ext n
      rw [hT, MvPowerSeries.coeff_C, PowerSeries.coeff_C]
      simp only [Finsupp.single_eq_zero]
    refine ⟨π₀, π₁, fun c => by rw [hπ₀, hC], fun c => by rw [hπ₁, hC], ?_, ?_, ?_⟩
    · intro r
      obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective r
      rw [hπ₀, hπ₁, ← PowerSeries.coeff_zero_eq_constantCoeff_apply,
        ← PowerSeries.coeff_zero_eq_constantCoeff_apply, hT, hT, Finsupp.single_zero,
        Finsupp.single_zero]
    · intro r h0 h1
      obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective r
      rw [hπ₀] at h0
      rw [hπ₁] at h1
      have hF0 : ∀ n, MvPowerSeries.coeff (Finsupp.single 0 n) F = 0 := fun n => by
        have := congrArg (PowerSeries.coeff n) h0
        rwa [hT, map_zero] at this
      have hF1 : ∀ n, MvPowerSeries.coeff (Finsupp.single 1 n) F = 0 := fun n => by
        have := congrArg (PowerSeries.coeff n) h1
        rwa [hT, map_zero] at this
      rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton']
      let G : MvPowerSeries (Fin 2) Ω := fun m =>
        MvPowerSeries.coeff (m + (Finsupp.single 0 1 + Finsupp.single 1 1)) F
      refine ⟨G, ?_⟩
      ext m
      rw [hXX, MvPowerSeries.coeff_mul_monomial, mul_one]
      split_ifs with hle
      · show MvPowerSeries.coeff (m - _ + _) F = _
        rw [tsub_add_cancel_of_le hle]
      · symm
        rw [Finsupp.le_def] at hle
        push_neg at hle
        obtain ⟨k, hk⟩ := hle
        fin_cases k
        · have hm0 : m 0 = 0 := by simpa using hk
          have : m = Finsupp.single 1 (m 1) := by
            ext k; fin_cases k <;> simp [hm0]
          rw [this, hF1]
        · have hm1 : m 1 = 0 := by simpa using hk
          have : m = Finsupp.single 0 (m 0) := by
            ext k; fin_cases k <;> simp [hm1]
          rw [this, hF0]
    · intro f g hfg
      let F : MvPowerSeries (Fin 2) Ω := fun m =>
        if m 1 = 0 then PowerSeries.coeff (m 0) f else
          if m 0 = 0 then PowerSeries.coeff (m 1) g else 0
      refine ⟨Ideal.Quotient.mk _ F, ?_, ?_⟩
      · rw [hπ₀]
        ext n
        rw [hT]
        show (if (Finsupp.single (0 : Fin 2) n) 1 = 0 then _ else _) = _
        simp
      · rw [hπ₁]
        ext n
        rw [hT]
        show (if (Finsupp.single (1 : Fin 2) n) 1 = 0 then _ else _) = _
        rcases Nat.eq_zero_or_pos n with hn | hn
        · subst hn
          simp only [Finsupp.single_zero, Finsupp.coe_zero, Pi.zero_apply, if_true,
            PowerSeries.coeff_zero_eq_constantCoeff_apply, hfg]
        · simp [hn.ne']
  have hs3 : ∀ (A : Type u) [CommRing A] (I : Ideal A) (π : A), I = Ideal.span {π} → π ∈ nonZeroDivisors A → ∀ x : AdicCompletion I A, AdicCompletion.evalₐ I 1 x = 0 → ∃ y : AdicCompletion I A, x = algebraMap A (AdicCompletion I A) π * y  := by
    intro A _ I π hI hπ x hx
    have hpow2 : ∀ n, I ^ n = Ideal.span {π ^ n} := by
      intro n; rw [hI, Ideal.span_singleton_pow]
    have hpow : ∀ n, I ^ n • (⊤ : Submodule A A) = Ideal.span {π ^ n} := by
      intro n; rw [smul_eq_mul, Ideal.mul_top, hpow2]
    obtain ⟨s, rfl⟩ := AdicCompletion.mk_surjective I A x
    rw [AdicCompletion.evalₐ_mk, Ideal.Quotient.eq_zero_iff_mem, pow_one] at hx
    have hcs : ∀ m n, m ≤ n → (s : ℕ → A) m - (s : ℕ → A) n ∈ Ideal.span {π ^ m} := by
      intro m n hmn
      rw [← hpow]; exact SModEq.sub_mem.mp (s.2 hmn)
    have hsI : ∀ n, (s : ℕ → A) (n+1) ∈ Ideal.span {π} := by
      intro n
      have h1 := hcs 1 (n+1) (by omega)
      rw [pow_one] at h1
      have hx' : (s : ℕ → A) 1 ∈ Ideal.span {π} := by
        rw [← pow_one π, ← hpow2, pow_one]; exact hx
      have h2 := Ideal.sub_mem _ hx' h1
      rwa [sub_sub_cancel] at h2
    choose a ha using fun n => Ideal.mem_span_singleton'.mp (hsI n)
    have hstep : ∀ n, a n - a (n+1) ∈ Ideal.span {π ^ n} := by
      intro n
      obtain ⟨u, hu⟩ := Ideal.mem_span_singleton'.mp (hcs (n+1) (n+2) (by omega))
      rw [Ideal.mem_span_singleton']
      refine ⟨u, ?_⟩
      have h3 : π * (u * π ^ n - (a n - a (n+1))) = 0 := by
        have e1 := ha n
        have e2 := ha (n+1)
        linear_combination hu - e1 + e2
      exact sub_eq_zero.mp ((mul_left_mem_nonZeroDivisors_eq_zero_iff hπ).mp h3)
    let a' : AdicCompletion.AdicCauchySequence I A :=
      AdicCompletion.AdicCauchySequence.mk I A a
        (fun n => SModEq.sub_mem.mpr (by rw [hpow]; exact hstep n))
    refine ⟨AdicCompletion.mk I A a', ?_⟩
    apply AdicCompletion.ext
    intro n
    have hle : I ^ n ≤ I ^ n • (⊤ : Submodule A A) := by rw [smul_eq_mul, Ideal.mul_top]
    rw [← AdicCompletion.eval_apply, ← AdicCompletion.eval_apply,
      ← AdicCompletion.factor_evalₐ_eq_eval I _ hle, ← AdicCompletion.factor_evalₐ_eq_eval I _ hle]
    congr 1
    rw [map_mul, AlgHom.commutes, AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk,
      Ideal.Quotient.algebraMap_eq, ← map_mul, Ideal.Quotient.eq]
    show (s : ℕ → A) n - π * a n ∈ I ^ n
    rw [mul_comm, ha n, hpow2]
    exact hcs n (n+1) (by omega)
  have hs5 : ∀ (Ω : Type u) [Field Ω] (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] [IsDomain A] [IsIntegrallyClosed A] (ρ₀ ρ₁ : AdicCompletion (IsLocalRing.maximalIdeal A) A →+* PowerSeries Ω), ringKrullDim A ≤ 1 → IsLocalRing.maximalIdeal A ≠ ⊥ → (∀ x, PowerSeries.constantCoeff (ρ₀ x) = PowerSeries.constantCoeff (ρ₁ x)) → (∀ x, ρ₀ x = 0 → ρ₁ x = 0 → x = 0) → (∀ f g : PowerSeries Ω, PowerSeries.constantCoeff f = PowerSeries.constantCoeff g → ∃ x, ρ₀ x = f ∧ ρ₁ x = g) → (∀ π : A, IsLocalRing.maximalIdeal A = Ideal.span {π} → π ∈ nonZeroDivisors A → ∀ x : AdicCompletion (IsLocalRing.maximalIdeal A) A, AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) 1 x = 0 → ∃ y, x = algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) π * y) → False  := by
    intro Ω _ A _ _ _ _ _ ρ₀ ρ₁ hdim hm hR2 hR3 hR4 hs3

    have hnf : ¬ IsField A := fun h => hm (IsLocalRing.isField_iff_maximalIdeal_eq.mp h)
    have hdl : Ring.KrullDimLE 1 A := Ring.krullDimLE_iff.mpr (by exact_mod_cast hdim)
    have h4 : IsIntegrallyClosed A ∧ ∃! P : Ideal A, P ≠ ⊥ ∧ P.IsPrime := by
      refine ⟨inferInstance, ⟨IsLocalRing.maximalIdeal A, ⟨hm, inferInstance⟩, ?_⟩⟩
      rintro P ⟨hP, hPp⟩
      rcases (Ring.krullDimLE_one_iff.mp hdl) P hPp with h | h
      · rw [IsDomain.minimalPrimes_eq_singleton_bot] at h
        exact absurd (Set.mem_singleton_iff.mp h) hP
      · exact IsLocalRing.eq_maximalIdeal h
    have h5 : Submodule.IsPrincipal (IsLocalRing.maximalIdeal A) :=
      ((IsDiscreteValuationRing.TFAE A hnf).out 4 5).mp h4
    obtain ⟨π, hπ⟩ := h5.principal
    have hπ' : IsLocalRing.maximalIdeal A = Ideal.span {π} := hπ
    have hπ0 : π ≠ 0 := by
      intro h
      apply hm
      rw [hπ', h, Ideal.span_singleton_eq_bot]
    have hπn : π ∈ nonZeroDivisors A := mem_nonZeroDivisors_of_ne_zero hπ0
    have hπm : π ∈ IsLocalRing.maximalIdeal A := by rw [hπ']; exact Ideal.subset_span rfl

    have hunit : ∀ y, PowerSeries.constantCoeff (ρ₀ y) ≠ 0 → IsUnit y := by
      intro y hy
      have hy1 : PowerSeries.constantCoeff (ρ₁ y) ≠ 0 := by rw [← hR2]; exact hy
      obtain ⟨u, hu0, hu1⟩ := hR4 (ρ₀ y)⁻¹ (ρ₁ y)⁻¹
        (by rw [PowerSeries.constantCoeff_inv, PowerSeries.constantCoeff_inv, hR2])
      have hyu : y * u = 1 := by
        rw [← sub_eq_zero]
        apply hR3
        · rw [map_sub, map_mul, map_one, hu0, PowerSeries.mul_inv_cancel _ hy, sub_self]
        · rw [map_sub, map_mul, map_one, hu1, PowerSeries.mul_inv_cancel _ hy1, sub_self]
      exact ⟨⟨y, u, hyu, by rw [mul_comm]; exact hyu⟩, rfl⟩

    have hne : (IsLocalRing.maximalIdeal A) ^ 1 ≠ ⊤ := by
      rw [pow_one]; exact Ideal.IsMaximal.ne_top inferInstance
    have hnt : Nontrivial (A ⧸ (IsLocalRing.maximalIdeal A) ^ 1) :=
      Ideal.Quotient.nontrivial_iff.mpr hne
    have hc1 : ∀ y, AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) 1 y = 0 →
        PowerSeries.constantCoeff (ρ₀ y) = 0 := by
      intro y hy
      by_contra h
      have hu := (hunit y h).map (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) 1)
      rw [hy] at hu
      exact not_isUnit_zero hu
    have hc2 : ∀ y, PowerSeries.constantCoeff (ρ₀ y) = 0 →
        AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) 1 y = 0 := by
      intro y hy
      obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective
        (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) 1 y)
      have h1 : AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) 1
          (y - algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a) = 0 := by
        rw [map_sub, AlgHom.commutes, Ideal.Quotient.algebraMap_eq, ha, sub_self]
      have h2 := hc1 _ h1
      rw [map_sub, map_sub, hy, zero_sub, neg_eq_zero] at h2
      have ham : a ∈ IsLocalRing.maximalIdeal A := by
        by_contra hna
        have hu : IsUnit a := IsLocalRing.notMem_maximalIdeal.mp hna
        exact (hu.map ((PowerSeries.constantCoeff (R := Ω)).comp
          (ρ₀.comp (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))))).ne_zero h2
      rw [← ha, Ideal.Quotient.eq_zero_iff_mem, pow_one]
      exact ham

    obtain ⟨x₀, hx₀0, hx₀1⟩ := hR4 PowerSeries.X 0 (by rw [PowerSeries.constantCoeff_X, map_zero])
    obtain ⟨y₀, hy₀0, hy₀1⟩ := hR4 0 PowerSeries.X (by rw [PowerSeries.constantCoeff_X, map_zero])
    obtain ⟨a', ha'⟩ := hs3 π hπ' hπn x₀ (hc2 x₀ (by rw [hx₀0, PowerSeries.constantCoeff_X]))
    obtain ⟨b', hb'⟩ := hs3 π hπ' hπn y₀
      (hc2 y₀ (by rw [hR2, hy₀1, PowerSeries.constantCoeff_X]))
    set g := algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) π with hg
    have hg0 : PowerSeries.constantCoeff (ρ₀ g) = 0 := by
      apply hc1
      rw [hg, AlgHom.commutes, Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem, pow_one]
      exact hπm
    obtain ⟨h, hh⟩ := PowerSeries.X_dvd_iff.mpr hg0
    have e1 : ρ₀ x₀ = PowerSeries.X * (h * ρ₀ a') := by
      rw [ha', map_mul, hh, mul_assoc]
    rw [hx₀0] at e1
    have e2 : h * ρ₀ a' = 1 :=
      mul_left_cancel₀ (PowerSeries.X_ne_zero (R := Ω)) (e1.symm.trans (mul_one _).symm)
    have e3 : PowerSeries.constantCoeff (ρ₀ a') ≠ 0 := by
      intro h0
      have := congrArg PowerSeries.constantCoeff e2
      rw [map_mul, h0, mul_zero, map_one] at this
      exact zero_ne_one this
    have e4 : ρ₁ g ≠ 0 := by
      intro h0
      have := hy₀1
      rw [hb', map_mul, h0, zero_mul] at this
      exact PowerSeries.X_ne_zero this.symm
    have e5 : ρ₁ a' = 0 := by
      have := hx₀1
      rw [ha', map_mul] at this
      exact (mul_eq_zero.mp this).resolve_left e4
    apply e3
    rw [hR2, e5, map_zero]

  have s4 : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsIntegrallyClosed R] (p : Polynomial R)
      (δ α : R), p.Monic → δ ≠ 0 → Polynomial.eval α (p.scaleRoots δ) = 0 → δ ∣ α := by
    intro R _ _ _ p δ α hp hδ hev
    have hf : Function.Injective (algebraMap R (FractionRing R)) := IsFractionRing.injective R _
    have hfδ : algebraMap R (FractionRing R) δ ≠ 0 := fun h => hδ (hf (h.trans (map_zero _).symm))
    set z : FractionRing R := algebraMap R (FractionRing R) α / algebraMap R (FractionRing R) δ
    have hz : algebraMap R (FractionRing R) δ * z = algebraMap R (FractionRing R) α :=
      mul_div_cancel₀ _ hfδ
    have h1 := Polynomial.scaleRoots_eval₂_mul (p := p) (algebraMap R (FractionRing R)) z δ
    rw [hz, Polynomial.eval₂_at_apply, hev, map_zero] at h1
    have h2 : Polynomial.eval₂ (algebraMap R (FractionRing R)) z p = 0 :=
      (mul_eq_zero.mp h1.symm).resolve_left (pow_ne_zero _ hfδ)
    have hint : IsIntegral R z := ⟨p, hp, h2⟩
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    refine ⟨y, hf ?_⟩
    rw [map_mul, hy, hz]

  have s9 : ∀ (A B : Type u) [CommRing A] [IsLocalRing A] [CommRing B] (j : A →+* B),
      Function.Bijective j → (∀ (Q : Ideal B) [Q.IsPrime], IsDomain (Localization.AtPrime Q) ∧
        IsIntegrallyClosed (Localization.AtPrime Q)) → IsDomain A ∧ IsIntegrallyClosed A := by
    intro A B _ _ _ j hj hQ
    let eq := RingEquiv.ofBijective j hj
    haveI : Nontrivial B := hj.1.nontrivial
    haveI : IsLocalRing B := IsLocalRing.of_surjective' j hj.2
    obtain ⟨hd, hic⟩ := hQ (IsLocalRing.maximalIdeal B)
    have hle : (IsLocalRing.maximalIdeal B).primeCompl ≤ IsUnit.submonoid B :=
      fun y hy => (IsUnit.mem_submonoid_iff y).mpr (IsLocalRing.notMem_maximalIdeal.mp hy)
    let e2 : B ≃ₐ[B] Localization.AtPrime (IsLocalRing.maximalIdeal B) :=
      IsLocalization.atUnits B (IsLocalRing.maximalIdeal B).primeCompl hle
    haveI : IsDomain B := MulEquiv.isDomain (Localization.AtPrime (IsLocalRing.maximalIdeal B))
      e2.toRingEquiv.toMulEquiv
    haveI : IsIntegrallyClosed B := IsIntegrallyClosed.of_equiv e2.toRingEquiv.symm
    haveI : IsDomain A := MulEquiv.isDomain B eq.toMulEquiv
    exact ⟨inferInstance, IsIntegrallyClosed.of_equiv eq.symm⟩

  have s8 : ∀ (χ₀ χ₁ : B →+* Ω), χ₀.comp (j.comp φ) = RingHom.id Ω →
      χ₁.comp (j.comp φ) = RingHom.id Ω → (∀ b : B, χ₀ b = χ₁ b → ∃ a : A, j a = b) →
      ∀ M : Ideal B, M.IsMaximal → M = RingHom.ker χ₀ ∨ M = RingHom.ker χ₁ := by
    intro χ₀ χ₁ h0 h1 hEq M hM
    have hs0 : Function.Surjective χ₀ := fun c => ⟨j (φ c), RingHom.congr_fun h0 c⟩
    have hs1 : Function.Surjective χ₁ := fun c => ⟨j (φ c), RingHom.congr_fun h1 c⟩
    have hk0 : (RingHom.ker χ₀).IsMaximal := RingHom.ker_isMaximal_of_surjective χ₀ hs0
    have hk1 : (RingHom.ker χ₁).IsMaximal := RingHom.ker_isMaximal_of_surjective χ₁ hs1
    have hcm : Ideal.comap j M = IsLocalRing.maximalIdeal A := by
      haveI := hM
      exact IsLocalRing.eq_maximalIdeal
        (Ideal.isMaximal_comap_of_isIntegral_of_isMaximal j hfin.to_isIntegral M)
    have hinf : RingHom.ker χ₀ * RingHom.ker χ₁ ≤ M := by
      refine le_trans Ideal.mul_le_inf ?_
      intro b hb
      obtain ⟨hb0, hb1⟩ := Ideal.mem_inf.mp hb
      rw [RingHom.mem_ker] at hb0 hb1
      obtain ⟨a, rfl⟩ := hEq b (hb0.trans hb1.symm)
      have ha : a ∈ IsLocalRing.maximalIdeal A := by
        by_contra hna
        have hu : IsUnit a := IsLocalRing.notMem_maximalIdeal.mp hna
        exact (hu.map (χ₀.comp j)).ne_zero hb0
      rw [← hcm] at ha
      exact ha
    rcases (Ideal.IsPrime.mul_le hM.isPrime).mp hinf with h | h
    · left; exact (hk0.eq_of_le hM.ne_top h).symm
    · right; exact (hk1.eq_of_le hM.ne_top h).symm

  have s6 : ∀ (σ : A →+* PowerSeries Ω), σ d ≠ 0 → ∃ ψ : B →+* PowerSeries Ω,
      (∀ a : A, ψ (j a) = σ a) ∧ ∀ (b : B) (a : A), j a = j d * b → σ a = σ d * ψ b := by
    intro σ hσd
    choose ab hab using hdiv
    have hdvd : ∀ b : B, σ d ∣ σ (ab b) := by
      intro b
      obtain ⟨p, hp, hpb⟩ := hfin.to_isIntegral b
      have h1 := Polynomial.scaleRoots_eval₂_mul (p := p) j b d
      rw [hpb, mul_zero, ← hab b, Polynomial.eval₂_at_apply] at h1
      have h2 : Polynomial.eval (ab b) (p.scaleRoots d) = 0 := hj (h1.trans (map_zero j).symm)
      have h3 : Polynomial.eval (σ (ab b)) ((p.map σ).scaleRoots (σ d)) = 0 := by
        rw [← Polynomial.map_scaleRoots p d σ (by rw [hp.leadingCoeff, map_one]; exact one_ne_zero),
          Polynomial.eval_map, Polynomial.eval₂_at_apply, h2, map_zero]
      exact s4 (PowerSeries Ω) (p.map σ) (σ d) (σ (ab b)) (hp.map σ) hσd h3
    choose ψ' hψ' using hdvd
    have key : ∀ (b : B) (a : A) (x : PowerSeries Ω), j a = j d * b → σ a = σ d * x →
        ψ' b = x := by
      intro b a x hja hσa
      have : a = ab b := hj (hja.trans (hab b).symm)
      subst this
      exact mul_left_cancel₀ hσd ((hψ' b).symm.trans hσa)
    refine ⟨{ toFun := ψ'
              map_one' := key 1 d 1 (by rw [mul_one]) (by rw [mul_one])
              map_mul' := fun b b' => key (b * b') (ab (b * b')) (ψ' b * ψ' b') (hab _) ?_
              map_zero' := key 0 0 0 (by rw [map_zero, mul_zero]) (by rw [map_zero, mul_zero])
              map_add' := fun b b' => key (b + b') (ab b + ab b') (ψ' b + ψ' b')
                (by rw [map_add, hab, hab, mul_add]) (by rw [map_add, hψ', hψ', mul_add]) },
      fun a => key (j a) (d * a) (σ a) (by rw [map_mul]) (by rw [map_mul]), ?_⟩
    · have h1 : d * ab (b * b') = ab b * ab b' := hj (by
        rw [map_mul, map_mul, hab, hab, hab]; ring)
      apply mul_left_cancel₀ hσd
      have h2 := congrArg σ h1
      rw [map_mul, map_mul, hψ' b, hψ' b'] at h2
      rw [h2]; ring
    · intro b a hja
      have : a = ab b := hj (hja.trans (hab b).symm)
      subst this
      exact hψ' b

  have s2 : Module.FaithfullyFlat A (AdicCompletion (IsLocalRing.maximalIdeal A) A) := by
    haveI : Module.Flat A (AdicCompletion (IsLocalRing.maximalIdeal A) A) :=
      AdicCompletion.flat_of_isNoetherian _
    refine Module.FaithfullyFlat.mk ?_
    intro n hn htop
    have hnm : n = IsLocalRing.maximalIdeal A := IsLocalRing.eq_maximalIdeal hn
    subst hnm
    have h1 : (1 : AdicCompletion (IsLocalRing.maximalIdeal A) A) ∈
        (IsLocalRing.maximalIdeal A) •
          (⊤ : Submodule A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) := by
      rw [htop]; exact Submodule.mem_top
    have h2 : AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) 1
        (1 : AdicCompletion (IsLocalRing.maximalIdeal A) A) = 0 := by
      refine Submodule.smul_induction_on h1 ?_ ?_
      · intro a ha x _
        rw [map_smul, Algebra.smul_def, Ideal.Quotient.algebraMap_eq,
          Ideal.Quotient.eq_zero_iff_mem.mpr (by rw [pow_one]; exact ha), zero_mul]
      · intro x y hx hy
        rw [map_add, hx, hy, add_zero]
    rw [map_one] at h2
    have hne : (IsLocalRing.maximalIdeal A) ^ 1 ≠ ⊤ := by
      rw [pow_one]; exact Ideal.IsMaximal.ne_top inferInstance
    have : Nontrivial (A ⧸ (IsLocalRing.maximalIdeal A) ^ 1) := Ideal.Quotient.nontrivial_iff.mpr hne
    exact one_ne_zero h2

  obtain ⟨π₀, π₁, P1, P1', P2, P3, P4⟩ := hs1 Ω
  set ι := algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) with hι
  let ρ₀ : AdicCompletion (IsLocalRing.maximalIdeal A) A →+* PowerSeries Ω := π₀.comp e.toRingHom
  let ρ₁ : AdicCompletion (IsLocalRing.maximalIdeal A) A →+* PowerSeries Ω := π₁.comp e.toRingHom
  have R2 : ∀ x, PowerSeries.constantCoeff (ρ₀ x) = PowerSeries.constantCoeff (ρ₁ x) :=
    fun x => P2 (e x)
  have R3 : ∀ x, ρ₀ x = 0 → ρ₁ x = 0 → x = 0 := fun x h0 h1 =>
    e.injective ((P3 (e x) h0 h1).trans (map_zero e).symm)
  have R4 : ∀ f g : PowerSeries Ω, PowerSeries.constantCoeff f = PowerSeries.constantCoeff g →
      ∃ x, ρ₀ x = f ∧ ρ₁ x = g := by
    intro f g h
    obtain ⟨r, hr0, hr1⟩ := P4 f g h
    refine ⟨e.symm r, ?_, ?_⟩
    · show π₀ (e (e.symm r)) = f
      rw [e.apply_symm_apply]; exact hr0
    · show π₁ (e (e.symm r)) = g
      rw [e.apply_symm_apply]; exact hr1
  have hec : ∀ c, e (ι (φ c)) = Ideal.Quotient.mk _ (MvPowerSeries.C c) :=
    fun c => RingHom.congr_fun he c
  have R1₀ : ∀ c, ρ₀ (ι (φ c)) = PowerSeries.C c := fun c => by
    show π₀ (e (ι (φ c))) = _
    rw [hec]; exact P1 c
  have R1₁ : ∀ c, ρ₁ (ι (φ c)) = PowerSeries.C c := fun c => by
    show π₁ (e (ι (φ c))) = _
    rw [hec]; exact P1' c

  haveI : Module.Flat A (AdicCompletion (IsLocalRing.maximalIdeal A) A) :=
    AdicCompletion.flat_of_isNoetherian _
  have hreg : IsSMulRegular (AdicCompletion (IsLocalRing.maximalIdeal A) A) d :=
    Module.Flat.isSMulRegular_of_nonZeroDivisors hdA
  have hιd : ∀ x, ι d * x = 0 → x = 0 := fun x hx =>
    hreg (show d • x = d • (0 : AdicCompletion (IsLocalRing.maximalIdeal A) A) by
      rw [smul_zero, Algebra.smul_def]; exact hx)
  obtain ⟨x₀, hx₀0, hx₀1⟩ := R4 PowerSeries.X 0 (by rw [PowerSeries.constantCoeff_X, map_zero])
  obtain ⟨y₀, hy₀0, hy₀1⟩ := R4 0 PowerSeries.X (by rw [PowerSeries.constantCoeff_X, map_zero])
  have hσ0 : ρ₀ (ι d) ≠ 0 := by
    intro h
    have h1 : ι d * x₀ = 0 := R3 _ (by rw [map_mul, h, zero_mul]) (by rw [map_mul, hx₀1, mul_zero])
    rw [hιd x₀ h1, map_zero] at hx₀0
    exact PowerSeries.X_ne_zero hx₀0.symm
  have hσ1 : ρ₁ (ι d) ≠ 0 := by
    intro h
    have h1 : ι d * y₀ = 0 := R3 _ (by rw [map_mul, hy₀0, mul_zero]) (by rw [map_mul, h, zero_mul])
    rw [hιd y₀ h1, map_zero] at hy₀1
    exact PowerSeries.X_ne_zero hy₀1.symm

  obtain ⟨ψ₀, hψ₀j, hψ₀d⟩ := s6 (ρ₀.comp ι) hσ0
  obtain ⟨ψ₁, hψ₁j, hψ₁d⟩ := s6 (ρ₁.comp ι) hσ1

  let χ₀ : B →+* Ω := (PowerSeries.constantCoeff (R := Ω)).comp ψ₀
  let χ₁ : B →+* Ω := (PowerSeries.constantCoeff (R := Ω)).comp ψ₁
  have hs₀ : ∀ c, χ₀ (j (φ c)) = c := fun c => by
    show PowerSeries.constantCoeff (ψ₀ (j (φ c))) = c
    rw [hψ₀j]
    show PowerSeries.constantCoeff (ρ₀ (ι (φ c))) = c
    rw [R1₀, PowerSeries.constantCoeff_C]
  have hs₁ : ∀ c, χ₁ (j (φ c)) = c := fun c => by
    show PowerSeries.constantCoeff (ψ₁ (j (φ c))) = c
    rw [hψ₁j]
    show PowerSeries.constantCoeff (ρ₁ (ι (φ c))) = c
    rw [R1₁, PowerSeries.constantCoeff_C]
  have sec₀ : χ₀.comp (j.comp φ) = RingHom.id Ω := RingHom.ext hs₀
  have sec₁ : χ₁.comp (j.comp φ) = RingHom.id Ω := RingHom.ext hs₁

  have hEq : ∀ b : B, χ₀ b = χ₁ b → ∃ a : A, j a = b := by
    intro b hb
    obtain ⟨a, ha⟩ := hdiv b
    obtain ⟨xh, hxh0, hxh1⟩ := R4 (ψ₀ b) (ψ₁ b) hb
    have h1 : ι a = ι d * xh := by
      rw [← sub_eq_zero]
      apply R3
      · rw [map_sub, map_mul, hxh0]
        have := hψ₀d b a ha
        exact sub_eq_zero.mpr this
      · rw [map_sub, map_mul, hxh1]
        have := hψ₁d b a ha
        exact sub_eq_zero.mpr this
    have h2 : a ∈ Ideal.comap ι (Ideal.map ι (Ideal.span {d})) := by
      rw [Ideal.mem_comap, Ideal.map_span, Set.image_singleton, h1]
      exact Ideal.mul_mem_right _ _ (Ideal.subset_span rfl)
    rw [Ideal.comap_map_eq_self_of_faithfullyFlat] at h2
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp h2
    refine ⟨c, ?_⟩
    have h3 : j d * (j c - b) = 0 := by
      rw [mul_sub, ← ha, map_mul]; ring
    exact sub_eq_zero.mp ((mul_left_mem_nonZeroDivisors_eq_zero_iff hdB).mp h3)
  have hiff : ∀ b : B, (∃ a : A, j a = b) ↔ χ₀ b = χ₁ b := by
    intro b
    refine ⟨?_, hEq b⟩
    rintro ⟨a, rfl⟩
    show PowerSeries.constantCoeff (ψ₀ (j a)) = PowerSeries.constantCoeff (ψ₁ (j a))
    rw [hψ₀j, hψ₁j]
    exact R2 (ι a)

  have hker : RingHom.ker χ₀ ≠ RingHom.ker χ₁ := by
    intro hK
    have hsurj : Function.Surjective j := by
      intro b
      apply hEq
      have hb' : b - j (φ (χ₁ b)) ∈ RingHom.ker χ₁ := by
        rw [RingHom.mem_ker, map_sub, hs₁, sub_self]
      rw [← hK, RingHom.mem_ker, map_sub, hs₀, sub_eq_zero] at hb'
      exact hb'
    obtain ⟨hAd, hAic⟩ := s9 A B j ⟨hj, hsurj⟩ hnorm
    have hm : IsLocalRing.maximalIdeal A ≠ ⊥ := by
      intro h
      rw [h, Ideal.mem_bot] at hdm
      exact nonZeroDivisors.ne_zero hdA hdm
    exact hs5 Ω A ρ₀ ρ₁ hdim hm R2 R3 R4
      (fun π hπ hπn x hx => hs3 A _ π hπ hπn x hx)
  exact ⟨χ₀, χ₁, sec₀, sec₁, hker, s8 χ₀ χ₁ sec₀ sec₁ hEq, hiff⟩

theorem wcpa_dj_nn_pinch_pushout : ∀ (Ω : Type u) [Field Ω] (C Ct : Scheme.{u}) (ν : Ct ⟶ C)
    (m : ℕ) (y : Fin m × Fin 2 → (Spec (.of Ω) ⟶ Ct)), IsFinite ν → Surjective ν →
    (∀ (a b : Fin m × Fin 2) (p q : ↥(Spec (.of Ω))), a ≠ b → y a p ≠ y b q) →
    (∀ e : Fin m, y (e, 0) ≫ ν = y (e, 1) ≫ ν) →
    (∀ x x' : Ct, ν x = ν x' → x = x' ∨ ∃ (e : Fin m) (p q : ↥(Spec (.of Ω))),
      (x = y (e, 0) p ∧ x' = y (e, 1) q) ∨ (x = y (e, 1) p ∧ x' = y (e, 0) q)) →
    (∀ V : C.affineOpens, Function.Injective (ν.app V.1).hom ∧
      ∀ s : Γ(Ct, ν ⁻¹ᵁ V.1), (∀ (e : Fin m) (h₀ : ⊤ ≤ y (e, 0) ⁻¹ᵁ (ν ⁻¹ᵁ V.1))
        (h₁ : ⊤ ≤ y (e, 1) ⁻¹ᵁ (ν ⁻¹ᵁ V.1)),
        ((y (e, 0)).appLE (ν ⁻¹ᵁ V.1) ⊤ h₀).hom s = ((y (e, 1)).appLE (ν ⁻¹ᵁ V.1) ⊤ h₁).hom s) →
        ∃ t : Γ(C, V.1), (ν.app V.1).hom t = s) →
    IsPushout (Limits.Sigma.desc fun e2 : Fin m × Fin 2 => y e2)
      (Limits.Sigma.desc fun e2 : Fin m × Fin 2 =>
        Limits.Sigma.ι (fun _ : Fin m => Spec (.of Ω)) e2.1)
      ν (Limits.Sigma.desc fun e : Fin m => y (e, 0) ≫ ν) :=
by
  intro Ω _ C Ct ν m y hfin hsurj _hdisj hyeq hfib hsec
  have T_s1 : ∀ {X Y T : Scheme.{u}} (π : X ⟶ Y), Surjective π →
      (∀ V : Y.affineOpens, Function.Injective (π.app V.1).hom) →
      ∀ k k' : Y ⟶ T, π ≫ k = π ≫ k' → k = k' := by
    intro X Y T π hs hinj k k' h
    have hpt : ∀ y, k y = k' y := by
      intro y
      obtain ⟨x, rfl⟩ := π.surjective y
      rw [← Scheme.Hom.comp_apply, h, Scheme.Hom.comp_apply]
    have hch : ∀ y : Y, ∃ (T' : T.Opens) (V : Y.Opens), IsAffineOpen T' ∧ IsAffineOpen V ∧
        y ∈ V ∧ V ≤ k ⁻¹ᵁ T' ∧ V ≤ k' ⁻¹ᵁ T' := by
      intro y
      obtain ⟨T', hT', hyT', -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
        T.isBasis_affineOpens) (show k y ∈ (⊤ : T.Opens) from trivial)
      have hy : y ∈ k ⁻¹ᵁ T' ⊓ k' ⁻¹ᵁ T' := by
        refine ⟨hyT', ?_⟩
        show k' y ∈ T'
        rw [← hpt]
        exact hyT'
      obtain ⟨V, hV, hyV, hVle⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
        Y.isBasis_affineOpens) hy
      exact ⟨T', V, hT', hV, hyV, hVle.trans inf_le_left, hVle.trans inf_le_right⟩
    choose T' V hT' hV hyV hk hk' using hch
    have hcov : TopologicalSpace.IsOpenCover V := by
      show iSup V = ⊤
      exact eq_top_iff.mpr fun y _ => TopologicalSpace.Opens.mem_iSup.mpr ⟨y, hyV y⟩
    apply (Y.openCoverOfIsOpenCover V hcov).hom_ext
    intro (y : Y)
    change (V y).ι ≫ k = (V y).ι ≫ k'
    rw [← Scheme.Hom.resLE_comp_ι k (hk y),
      ← Scheme.Hom.resLE_comp_ι k' (hk' y), cancel_mono,
      ← cancel_mono (hT' y).isoSpec.hom, IsAffineOpen.isoSpec_hom,
      ← Scheme.Opens.toSpecΓ_SpecMap_appLE, ← Scheme.Opens.toSpecΓ_SpecMap_appLE]
    congr 2
    ext r
    apply hinj ⟨V y, hV y⟩
    have hcg : ∀ (g g' : X ⟶ T) (hg : g = g') (U : T.Opens) (W : X.Opens) (e : W ≤ g ⁻¹ᵁ U)
        (e' : W ≤ g' ⁻¹ᵁ U), g.appLE U W e = g'.appLE U W e' := by
      intros g g' hg U W e e'
      subst hg
      rfl
    have e0 := Scheme.Hom.appLE_comp_appLE π k (T' y) (V y) (π ⁻¹ᵁ V y) (hk y) le_rfl
    have e1 := Scheme.Hom.appLE_comp_appLE π k' (T' y) (V y) (π ⁻¹ᵁ V y) (hk' y) le_rfl
    have := congrArg (fun φ => φ.hom r) (e0.trans ((hcg _ _ h _ _ _ _).trans e1.symm))
    rw [Scheme.Hom.app_eq_appLE]
    exact this
  have T_s2 : ∀ {X Y : Scheme.{u}} (π : X ⟶ Y), Surjective π →
      (∀ V : Y.affineOpens, Function.Injective (π.app V.1).hom) → ∀ W : Y.Opens,
      Surjective (π ∣_ W) ∧ ∀ V : W.toScheme.affineOpens, Function.Injective ((π ∣_ W).app V.1).hom := by
    intro X Y π hs hinj W
    refine ⟨MorphismProperty.of_isPullback (P := @Surjective) (isPullback_morphismRestrict π W).flip hs,
      fun V => ?_⟩
    have aux : ∀ {A B D : CommRingCat.{u}} (f : A ⟶ B) (g : B ⟶ D),
        Function.Injective f.hom → Function.Injective g.hom → Function.Injective (f ≫ g).hom := by
      intro A B D f g hf hg
      rw [CommRingCat.hom_comp]
      exact hg.comp hf
    have aux2 : ∀ {A B : CommRingCat.{u}} (h : A = B), Function.Injective (eqToHom h).hom := by
      intro A B h
      subst h
      intro x y hxy
      simpa using hxy
    rw [morphismRestrict_app, eqToHom_op, eqToHom_map]
    exact aux _ _ (hinj ⟨_, V.2.image_of_isOpenImmersion W.ι⟩) (aux2 _)
  have T_s3 : ∀ {C Ct T : Scheme.{u}} (ν : Ct ⟶ C) (a : Ct ⟶ T) (V : C.Opens) (T' : T.Opens)
      (_hT' : IsAffineOpen T') (hle : ν ⁻¹ᵁ V ≤ a ⁻¹ᵁ T'), Function.Injective (ν.app V).hom →
      (∀ r, ∃ t, (ν.app V).hom t = (a.appLE T' (ν ⁻¹ᵁ V) hle).hom r) →
      ∃ hV : V.toScheme ⟶ T, ν ∣_ V ≫ hV = (ν ⁻¹ᵁ V).ι ≫ a := by
    intro C Ct T ν a V T' hT' hle hj himg
    choose ψf hψf using himg
    let ψ : Γ(T, T') →+* Γ(C, V) :=
      { toFun := ψf
        map_one' := hj (by simp only [hψf, map_one])
        map_mul' := fun r s => hj (by simp only [hψf, map_mul])
        map_zero' := hj (by simp only [hψf, map_zero])
        map_add' := fun r s => hj (by simp only [hψf, map_add]) }
    have hΨ : CommRingCat.ofHom ψ ≫ ν.app V = a.appLE T' (ν ⁻¹ᵁ V) hle := by
      ext r
      exact hψf r
    refine ⟨V.toSpecΓ ≫ Spec.map (CommRingCat.ofHom ψ) ≫ hT'.isoSpec.inv ≫ T'.ι, ?_⟩
    rw [← Category.assoc (ν ∣_ V), ← Scheme.Opens.toSpecΓ_naturality, Category.assoc,
      ← Category.assoc (Spec.map (ν.app V)), ← Spec.map_comp, hΨ, ← Category.assoc,
      Scheme.Opens.toSpecΓ_SpecMap_appLE, Category.assoc, ← Category.assoc T'.toSpecΓ,
      ← IsAffineOpen.isoSpec_hom hT', Iso.hom_inv_id, Category.id_comp, Scheme.Hom.resLE_comp_ι]
  have T_s4 : ∀ {C Ct T : Scheme.{u}} (ν : Ct ⟶ C) (a : Ct ⟶ T), IsFinite ν →
      Function.Surjective ν → (∀ x x', ν x = ν x' → a x = a x') → ∀ c : C,
      ∃ (V : C.Opens) (T' : T.Opens), IsAffineOpen V ∧ IsAffineOpen T' ∧ c ∈ V ∧
        ν ⁻¹ᵁ V ≤ a ⁻¹ᵁ T' := by
    intro C Ct T ν a hfin hs hconst c
    obtain ⟨x₀, hx₀⟩ := hs c
    obtain ⟨T', hT', hxT', -⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp T.isBasis_affineOpens
      (show a x₀ ∈ (⊤ : T.Opens) from trivial)
    have hF : IsClosed (ν '' ((a ⁻¹ᵁ T' : Set Ct)ᶜ)) :=
      ν.isClosedMap _ (a ⁻¹ᵁ T').isOpen.isClosed_compl
    have hc : c ∉ ν '' ((a ⁻¹ᵁ T' : Set Ct)ᶜ) := by
      rintro ⟨x, hxF, hxc⟩
      apply hxF
      show a x ∈ T'
      rw [hconst x x₀ (hxc.trans hx₀.symm)]
      exact hxT'
    obtain ⟨V, hV, hcV, hVle⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp C.isBasis_affineOpens
      (show c ∈ (⟨(ν '' ((a ⁻¹ᵁ T' : Set Ct)ᶜ))ᶜ, hF.isOpen_compl⟩ : C.Opens) from hc)
    refine ⟨V, T', hV, hT', hcV, fun x hx => ?_⟩
    by_contra hxF
    exact hVle hx ⟨x, hxF, rfl⟩
  have T_s5 : ∀ {Ct C T : Scheme.{u}} (ν : Ct ⟶ C) (a : Ct ⟶ T),
      (∀ (W : C.Opens) (k k' : W.toScheme ⟶ T), ν ∣_ W ≫ k = ν ∣_ W ≫ k' → k = k') →
      (∀ c : C, ∃ (V : C.Opens) (hV : V.toScheme ⟶ T), c ∈ V ∧ ν ∣_ V ≫ hV = (ν ⁻¹ᵁ V).ι ≫ a) →
      ∃ h : C ⟶ T, ν ≫ h = a := by
    intro Ct C T ν a huniq hloc
    choose V hV hcV hfac using hloc
    have hcov : TopologicalSpace.IsOpenCover V := by
      show iSup V = ⊤
      exact eq_top_iff.mpr fun c _ => TopologicalSpace.Opens.mem_iSup.mpr ⟨c, hcV c⟩
    have key : ∀ c d : C, C.homOfLE (inf_le_left : V c ⊓ V d ≤ V c) ≫ hV c =
        C.homOfLE (inf_le_right : V c ⊓ V d ≤ V d) ≫ hV d := by
      intro c d
      apply huniq
      rw [← Category.assoc, morphismRestrict_homOfLE, Category.assoc, hfac, ← Category.assoc,
        Scheme.homOfLE_ι, ← Category.assoc, morphismRestrict_homOfLE, Category.assoc, hfac,
        ← Category.assoc, Scheme.homOfLE_ι]
    let 𝒰 := C.openCoverOfIsOpenCover V hcov
    have compat : ∀ c d : 𝒰.I₀, Limits.pullback.fst (𝒰.f c) (𝒰.f d) ≫ hV c =
        Limits.pullback.snd (𝒰.f c) (𝒰.f d) ≫ hV d := by
      intro (c : C) (d : C)
      have P := isPullback_opens_inf (V c) (V d)
      change Limits.pullback.fst (V c).ι (V d).ι ≫ hV c = Limits.pullback.snd (V c).ι (V d).ι ≫ hV d
      rw [← P.isoPullback_inv_fst, ← P.isoPullback_inv_snd, Category.assoc, Category.assoc, key]
    refine ⟨𝒰.glueMorphisms (fun c => hV c) compat, ?_⟩
    have hcov' : TopologicalSpace.IsOpenCover (fun c => ν ⁻¹ᵁ V c) := by
      show iSup (fun c => ν ⁻¹ᵁ V c) = ⊤
      exact eq_top_iff.mpr fun x _ => TopologicalSpace.Opens.mem_iSup.mpr ⟨ν x, hcV (ν x)⟩
    apply (Ct.openCoverOfIsOpenCover _ hcov').hom_ext
    intro (c : C)
    change (ν ⁻¹ᵁ V c).ι ≫ ν ≫ 𝒰.glueMorphisms (fun c => hV c) compat = (ν ⁻¹ᵁ V c).ι ≫ a
    have hg : (V c).ι ≫ 𝒰.glueMorphisms (fun c => hV c) compat = hV c :=
      𝒰.ι_glueMorphisms _ compat c
    rw [← Category.assoc, ← morphismRestrict_ι, Category.assoc, hg,
      hfac]
  have hinj : ∀ V : C.affineOpens, Function.Injective (ν.app V.1).hom := fun V => (hsec V).1
  have hcg : ∀ {X T : Scheme.{u}} (g g' : X ⟶ T) (hg : g = g') (U : T.Opens) (W : X.Opens)
      (e : W ≤ g ⁻¹ᵁ U) (e' : W ≤ g' ⁻¹ᵁ U), g.appLE U W e = g'.appLE U W e' := by
    intros X T g g' hg U W e e'
    subst hg
    rfl
  have comm : (Limits.Sigma.desc fun e2 : Fin m × Fin 2 => y e2) ≫ ν =
      (Limits.Sigma.desc fun e2 : Fin m × Fin 2 =>
        Limits.Sigma.ι (fun _ : Fin m => Spec (.of Ω)) e2.1) ≫
        (Limits.Sigma.desc fun e : Fin m => y (e, 0) ≫ ν) := by
    apply Limits.Sigma.hom_ext
    rintro ⟨e, i⟩
    rw [Limits.Sigma.ι_comp_desc_assoc, Limits.Sigma.ι_comp_desc_assoc, Limits.Sigma.ι_comp_desc]
    fin_cases i
    · rfl
    · exact (hyeq e).symm
  have hfac : ∀ (T : Scheme.{u}) (a : Ct ⟶ T), (∀ e : Fin m, y (e, 0) ≫ a = y (e, 1) ≫ a) →
      ∃ h : C ⟶ T, ν ≫ h = a := by
    intro T a hya
    have hconst : ∀ x x', ν x = ν x' → a x = a x' := by
      intro x x' hxx'
      rcases hfib x x' hxx' with h | ⟨e, p, q, ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩⟩
      · rw [h]
      · rw [Subsingleton.elim p q, ← Scheme.Hom.comp_apply, hya e, Scheme.Hom.comp_apply]
      · rw [Subsingleton.elim p q, ← Scheme.Hom.comp_apply, ← hya e, Scheme.Hom.comp_apply]
    apply T_s5 ν a
    · intro W k k' h
      obtain ⟨h1, h2⟩ := T_s2 ν hsurj hinj W
      exact T_s1 (ν ∣_ W) h1 h2 k k' h
    · intro c
      obtain ⟨V, T', hV, hT', hcV, hle⟩ := T_s4 ν a hfin (@Scheme.Hom.surjective _ _ ν hsurj) hconst c
      have himg : ∀ r, ∃ t, (ν.app V).hom t = (a.appLE T' (ν ⁻¹ᵁ V) hle).hom r := by
        intro r
        apply (hsec ⟨V, hV⟩).2
        intro e h₀ h₁
        have e0 := Scheme.Hom.appLE_comp_appLE (y (e, 0)) a T' (ν ⁻¹ᵁ V) ⊤ hle h₀
        have e1 := Scheme.Hom.appLE_comp_appLE (y (e, 1)) a T' (ν ⁻¹ᵁ V) ⊤ hle h₁
        have := congrArg (fun φ => φ.hom r) (e0.trans ((hcg _ _ (hya e) _ _ _ _).trans e1.symm))
        simpa only [CommRingCat.hom_comp, RingHom.comp_apply] using this
      obtain ⟨hVmap, hVeq⟩ := T_s3 ν a V T' hT' hle (hsec ⟨V, hV⟩).1 himg
      exact ⟨V, hVmap, hcV, hVeq⟩
  have hs : ∀ (s : Limits.PushoutCocone (Limits.Sigma.desc fun e2 : Fin m × Fin 2 => y e2)
      (Limits.Sigma.desc fun e2 : Fin m × Fin 2 =>
        Limits.Sigma.ι (fun _ : Fin m => Spec (.of Ω)) e2.1)) (e : Fin m) (i : Fin 2),
      y (e, i) ≫ s.inl = Limits.Sigma.ι (fun _ : Fin m => Spec (.of Ω)) e ≫ s.inr := by
    intro s e i
    have := Limits.Sigma.ι (fun e2 : Fin m × Fin 2 => Spec (.of Ω)) (e, i) ≫= s.condition
    simpa only [Limits.Sigma.ι_comp_desc_assoc] using this
  have hya : ∀ (s : Limits.PushoutCocone (Limits.Sigma.desc fun e2 : Fin m × Fin 2 => y e2)
      (Limits.Sigma.desc fun e2 : Fin m × Fin 2 =>
        Limits.Sigma.ι (fun _ : Fin m => Spec (.of Ω)) e2.1)) (e : Fin m),
      y (e, 0) ≫ s.inl = y (e, 1) ≫ s.inl := fun s e => (hs s e 0).trans (hs s e 1).symm
  exact IsPushout.of_isColimit (Limits.PushoutCocone.IsColimit.mk comm
    (fun s => Classical.choose (hfac s.pt s.inl (hya s)))
    (fun s => Classical.choose_spec (hfac s.pt s.inl (hya s)))
    (fun s => by
      apply Limits.Sigma.hom_ext
      intro e
      rw [Limits.Sigma.ι_comp_desc_assoc, Category.assoc,
        Classical.choose_spec (hfac s.pt s.inl (hya s)), hs s e 0])
    (fun s m' h1 _ => T_s1 ν hsurj hinj _ _
      (h1.trans (Classical.choose_spec (hfac s.pt s.inl (hya s))).symm)))

theorem wcpa_dj_nn_normalization : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (C : Scheme.{u})
    (c : C ⟶ Spec (.of Ω)) (U : C.Opens), IsProper c →
    (∀ w : C, w ∈ U ↔ ∃ W : C.Opens, w ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ c)) →
    (∀ w : C, w ∉ U → ∃ e : AdicCompletion (IsLocalRing.maximalIdeal (C.presheaf.stalk w))
        (C.presheaf.stalk w) ≃+*
        (MvPowerSeries (Fin 2) Ω ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
      e.toRingHom.comp ((algebraMap (C.presheaf.stalk w) (AdicCompletion
        (IsLocalRing.maximalIdeal (C.presheaf.stalk w)) (C.presheaf.stalk w))).comp
        ((Scheme.ΓSpecIso (.of Ω)).inv ≫ c.appTop ≫ C.presheaf.germ ⊤ w trivial).hom) =
        (Ideal.Quotient.mk _).comp MvPowerSeries.C) →
    ∃ (Ct : Scheme.{u}) (ν : Ct ⟶ C), IsFinite ν ∧ Surjective ν ∧ IsIso (ν ∣_ U) ∧
      (∀ x : Ct, IsDomain (Ct.presheaf.stalk x) ∧ IsIntegrallyClosed (Ct.presheaf.stalk x)) ∧
      (∀ x : Ct, ∃ x' : Ct, x' ⤳ x ∧ ν x' ∈ U) :=
by
  intro Ω _ _ C c U hprop hU hnode
  classical

  have p_s5 : ∀ (X : Scheme.{u}) (w : X), _root_.IsReduced (X.presheaf.stalk w) →
      ¬ IsField (X.presheaf.stalk w) → ∃ y : X, y ⤳ w ∧ y ≠ w := by
    intro X w hred hnf
    obtain ⟨p, hp, hpm⟩ : ∃ p : Ideal (X.presheaf.stalk w), p.IsPrime ∧
        p ≠ IsLocalRing.maximalIdeal (X.presheaf.stalk w) := by
      by_contra h
      push_neg at h
      apply hnf
      rw [IsLocalRing.isField_iff_maximalIdeal_eq]
      have e : nilradical (X.presheaf.stalk w) = IsLocalRing.maximalIdeal (X.presheaf.stalk w) := by
        rw [nilradical_eq_sInf]
        apply le_antisymm
        · exact sInf_le (IsLocalRing.maximalIdeal.isMaximal _).isPrime
        · exact le_sInf fun J hJ => (h J hJ).ge
      rw [← e, nilradical_eq_zero]
      exact Submodule.zero_eq_bot
    let q : PrimeSpectrum (X.presheaf.stalk w) := ⟨p, hp⟩
    refine ⟨X.fromSpecStalk w q, ?_, ?_⟩
    · have h1 : X.fromSpecStalk w q ∈ Set.range (X.fromSpecStalk w) := ⟨q, rfl⟩
      rw [Scheme.range_fromSpecStalk] at h1
      exact h1
    · intro heq
      have hc := Scheme.fromSpecStalk_closedPoint (X := X) (x := w)
      have h2 := (X.fromSpecStalk w).isEmbedding.injective (heq.trans hc.symm)
      apply hpm
      exact congrArg PrimeSpectrum.asIdeal h2

  have p_s6 : ∀ (X : Scheme.{u}) (V : X.Opens), (∀ w : X, w ∉ V → ∃ y : X, y ⤳ w ∧ y ≠ w) →
      ∀ w : X, ∃ η : X, η ⤳ w ∧ η ∈ V := by
    intro X V h w
    have hT := isIrreducible_irreducibleComponent (x := w)
    have hTc := isClosed_irreducibleComponent (x := w)
    have hη : IsGenericPoint hT.genericPoint (irreducibleComponent w) := by
      have := hT.isGenericPoint_genericPoint_closure
      rwa [hTc.closure_eq] at this
    refine ⟨hT.genericPoint, hη.specializes mem_irreducibleComponent, ?_⟩
    by_contra hηV
    obtain ⟨y, hy, hne⟩ := h _ hηV
    have hsub : irreducibleComponent w ⊆ closure {y} := by
      rw [← hη.def]
      exact closure_minimal (Set.singleton_subset_iff.mpr (specializes_iff_mem_closure.mp hy))
        isClosed_closure
    have heq := (irreducibleComponent_property w).2.2 (closure {y})
      isIrreducible_singleton.closure.isPreirreducible hsub
    have hyT : y ∈ irreducibleComponent w := by
      rw [← heq]; exact subset_closure rfl
    exact hne (hy.antisymm (hη.specializes hyT)).eq

  have p_s7 : ∀ (Ct C : Scheme.{u}) (ν : Ct ⟶ C) (V : C.Opens), IsIso (ν ∣_ V) →
      ∀ (x' : Ct) (η : C), ν x' ∈ V → η ⤳ ν x' → ∃ x'' : Ct, x'' ⤳ x' ∧ ν x'' = η := by
    intro Ct C ν V hV x' η hx' hη
    have hηV : η ∈ V := hη.mem_open V.isOpen hx'
    let h := (ν ∣_ V).homeomorph
    have hh : ∀ p, (h p).1 = ν p.1 := fun p => by
      show ((ν ∣_ V) p).1 = ν p.1
      rw [morphismRestrict_base_coe]
    let q := h.symm ⟨η, hηV⟩
    refine ⟨q.1, ?_, ?_⟩
    · have h1 : (⟨η, hηV⟩ : (V : Set C)) ⤳ ⟨ν x', hx'⟩ :=
        (Topology.IsInducing.subtypeVal.specializes_iff).mp hη
      have h2 := h1.map h.symm.continuous
      have h3 : h.symm ⟨ν x', hx'⟩ = ⟨x', hx'⟩ := by
        apply h.injective
        erw [h.apply_symm_apply]
        apply Subtype.ext
        erw [hh]
      rw [h3] at h2
      exact h2.map continuous_subtype_val
    · have e1 := hh q
      have e2 : h q = ⟨η, hηV⟩ := h.apply_symm_apply _
      rw [e2] at e1
      exact e1.symm

  have p_s8 : ∀ (Ct C : Scheme.{u}) (ν : Ct ⟶ C) (V : C.Opens), IsFinite ν → IsIso (ν ∣_ V) →
      (∀ w : C, ∃ η : C, η ⤳ w ∧ η ∈ V) → Surjective ν := by
    intro Ct C ν V hfin hV hgen
    have hcl : IsClosed (Set.range ν) := ν.isClosedMap.isClosed_range
    refine ⟨fun w => ?_⟩
    obtain ⟨η, hη, hηV⟩ := hgen w
    have hr : η ∈ Set.range ν := by
      obtain ⟨p, hp⟩ := (ν ∣_ V).surjective ⟨η, hηV⟩
      refine ⟨p.1, ?_⟩
      have := congrArg Subtype.val hp
      rw [morphismRestrict_base_coe] at this
      exact this
    exact hη.mem_closed hcl hr

  have p_s11 : ∀ (Ct C : Scheme.{u}) (ν : Ct ⟶ C) (U : C.Opens),
      (∀ w : C, w ∈ U → ∃ W : C.Opens, w ∈ W ∧ W ≤ U ∧ IsIso (ν ∣_ W)) → IsIso (ν ∣_ U) := by
    intro Ct C ν U h
    show MorphismProperty.isomorphisms Scheme (ν ∣_ U)
    apply IsZariskiLocalAtTarget.of_forall_exists_morphismRestrict
    intro x
    obtain ⟨W, hxW, hWU, hW⟩ := h x.1 x.2
    refine ⟨U.ι ⁻¹ᵁ W, hxW, ?_⟩
    have e1 := morphismRestrictRestrict ν U (U.ι ⁻¹ᵁ W)
    have e2 : U.ι ''ᵁ (U.ι ⁻¹ᵁ W) = W := by
      rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
      exact inf_eq_right.mpr hWU
    rw [MorphismProperty.arrow_mk_iso_iff (MorphismProperty.isomorphisms Scheme)
      (e1 ≪≫ morphismRestrictEq ν e2)]
    exact hW

  have p_s9 : ∀ (X : Scheme.{u}) [IsLocallyNoetherian X] (x : X) (O : X.Opens), x ∈ O →
      IsDomain (X.presheaf.stalk x) → ∃ W : X.Opens, x ∈ W ∧ W ≤ O ∧ IsIrreducible (W : Set X) := by
    intro X _ x O hxO hdom
    let q0 : PrimeSpectrum (X.presheaf.stalk x) := ⟨⊥, Ideal.isPrime_bot⟩
    have hgen : ∀ y : X, y ⤳ x → X.fromSpecStalk x q0 ⤳ y := by
      intro y hy
      have : y ∈ Set.range (X.fromSpecStalk x) := by rw [Scheme.range_fromSpecStalk]; exact hy
      obtain ⟨q, rfl⟩ := this
      have hle : q0 ⤳ q := (PrimeSpectrum.le_iff_specializes q0 q).mp
        (show (⊥ : Ideal (X.presheaf.stalk x)) ≤ q.asIdeal from bot_le)
      exact hle.map (X.fromSpecStalk x).continuous
    set η := X.fromSpecStalk x q0 with hηdef
    have hηx : η ⤳ x := hgen x specializes_rfl
    obtain ⟨A₀, hA₀aff, hxA₀, hA₀O⟩ := exists_isAffineOpen_mem_and_subset hxO
    haveI : IsNoetherianRing Γ(X, A₀) := IsLocallyNoetherian.component_noetherian ⟨A₀, hA₀aff⟩
    haveI : TopologicalSpace.NoetherianSpace (A₀ : Set X) :=
      noetherianSpace_of_isAffineOpen A₀ hA₀aff
    have hηA₀ : η ∈ A₀ := hηx.mem_open A₀.isOpen hxA₀
    let x' : (A₀ : Set X) := ⟨x, hxA₀⟩
    let η' : (A₀ : Set X) := ⟨η, hηA₀⟩
    let T : Set (A₀ : Set X) := Subtype.val ⁻¹' closure {η}
    have hTeq : T = closure {η'} := by
      rw [Topology.IsInducing.subtypeVal.closure_eq_preimage_closure_image, Set.image_singleton]
    have hTirr : IsIrreducible T := by rw [hTeq]; exact isIrreducible_singleton.closure
    have key : ∀ Sc ∈ irreducibleComponents (A₀ : Set X), x' ∈ Sc → Sc = T := by
      intro Sc hSc hxS
      have hSX : IsIrreducible (Subtype.val '' Sc) :=
        hSc.1.image _ continuous_subtype_val.continuousOn
      have hζ := hSX.isGenericPoint_genericPoint_closure
      have hζx : hSX.genericPoint ⤳ x := hζ.specializes (subset_closure ⟨x', hxS, rfl⟩)
      have hηζ : η ⤳ hSX.genericPoint := hgen _ hζx
      have hsub : Sc ⊆ T := by
        intro a ha
        show a.1 ∈ closure {η}
        have h1 : a.1 ∈ closure {hSX.genericPoint} := by
          rw [hζ.def]; exact subset_closure ⟨a, ha, rfl⟩
        exact (specializes_iff_closure_subset.mp hηζ) h1
      exact (hSc.eq_of_ge hTirr hsub).symm
    let F : Set (A₀ : Set X) :=
      ⋃ Sc ∈ {Sc ∈ irreducibleComponents (A₀ : Set X) | x' ∉ Sc}, Sc
    have hFcl : IsClosed F :=
      (TopologicalSpace.NoetherianSpace.finite_irreducibleComponents.subset
        (Set.sep_subset _ _)).isClosed_biUnion
        (fun Sc hSc => isClosed_of_mem_irreducibleComponents Sc hSc.1)
    have hxF : x' ∉ F := by
      intro h
      simp only [F, Set.mem_iUnion, Set.mem_setOf_eq] at h
      obtain ⟨Sc, ⟨_, hn⟩, hx⟩ := h
      exact hn hx
    have hW0T : Fᶜ ⊆ T := by
      intro a ha
      obtain ⟨Sc, hSc, haS⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible {a}
        isIrreducible_singleton
      by_cases hxS : x' ∈ Sc
      · rw [← key Sc hSc hxS]; exact haS rfl
      · exfalso; apply ha
        simp only [F, Set.mem_iUnion, Set.mem_setOf_eq]
        exact ⟨Sc, ⟨hSc, hxS⟩, haS rfl⟩
    have hW0irr : IsIrreducible (Fᶜ) := ⟨⟨x', hxF⟩, hTirr.2.open_subset hFcl.isOpen_compl hW0T⟩
    refine ⟨⟨Subtype.val '' Fᶜ, A₀.isOpen.isOpenMap_subtype_val _ hFcl.isOpen_compl⟩,
      ⟨x', hxF, rfl⟩, ?_, ?_⟩
    · rintro _ ⟨a, _, rfl⟩
      exact hA₀O a.2
    · exact hW0irr.image _ continuous_subtype_val.continuousOn

  have p_s10 : ∀ (Ct C : Scheme.{u}) (ν : Ct ⟶ C) (V W : C.Opens), IsFinite ν → IsIso (ν ∣_ V) →
      (∀ x : Ct, IsDomain (Ct.presheaf.stalk x)) → (∀ x : Ct, ∃ x' : Ct, x' ⤳ x ∧ ν x' ∈ V) →
      (∀ w : C, w ∉ V → ∃ y : C, y ⤳ w ∧ y ≠ w) → IsIrreducible (W : Set C) →
      (∀ w : C, w ∈ W → IsDomain (C.presheaf.stalk w) ∧ IsIntegrallyClosed (C.presheaf.stalk w)) →
      IsIso (ν ∣_ W) := by
    intro Ct C ν V W hfin hV hCt hXgen hVgen hW hWn
    haveI := hfin
    haveI := hV
    have hη := hW.isGenericPoint_genericPoint_closure
    set η := hW.genericPoint with hηdef
    obtain ⟨w0, hw0⟩ := hW.nonempty
    have hηW : η ∈ W := (hη.mem_open_set_iff W.isOpen).mpr ⟨w0, subset_closure hw0, hw0⟩
    have hηspec : ∀ w ∈ (W : Set C), η ⤳ w := fun w hw => hη.specializes (subset_closure hw)
    have hηV : η ∈ V := by
      by_contra hηV
      obtain ⟨y, hy, hne⟩ := hVgen η hηV
      have hyW : y ∈ W := hy.mem_open W.isOpen hηW
      exact hne (hy.antisymm (hηspec y hyW)).eq

    haveI hWdom : ∀ y : W.toScheme, IsDomain (W.toScheme.presheaf.stalk y) := fun y => by
      haveI := (hWn y.1 y.2).1
      exact MulEquiv.isDomain (C.presheaf.stalk y.1)
        (Scheme.Opens.stalkIso W y).commRingCatIsoToRingEquiv.toMulEquiv
    haveI : ∀ y : W.toScheme, _root_.IsReduced (W.toScheme.presheaf.stalk y) := fun y => by
      infer_instance
    haveI : IsReduced W.toScheme := isReduced_of_isReduced_stalk _
    haveI : IrreducibleSpace W.toScheme := Subtype.irreducibleSpace hW
    haveI : AlgebraicGeometry.IsIntegral W.toScheme := isIntegral_of_irreducibleSpace_of_isReduced _

    let hm := (ν ∣_ V).homeomorph
    have hh : ∀ p, (hm p).1 = ν p.1 := fun p => by
      show ((ν ∣_ V) p).1 = ν p.1
      rw [morphismRestrict_base_coe]
    let p := hm.symm ⟨η, hηV⟩
    have hp : ν p.1 = η := by
      have e1 := hh p
      have e2 : hm p = ⟨η, hηV⟩ := hm.apply_symm_apply _
      rw [e2] at e1
      exact e1.symm
    have hpuniq : ∀ a : Ct, ν a = η → a = p.1 := by
      intro a ha
      have haV : a ∈ ν ⁻¹ᵁ V := by show ν a ∈ V; rw [ha]; exact hηV
      have : (⟨a, haV⟩ : (ν ⁻¹ᵁ V : Set Ct)) = p := by
        apply hm.injective
        apply Subtype.ext
        refine (hh _).trans ?_
        rw [hh, hp]
        exact ha
      exact congrArg Subtype.val this
    have hpgen : ∀ x : Ct, x ∈ ν ⁻¹ᵁ W → p.1 ⤳ x := by
      intro x hx
      obtain ⟨x', hx'x, hx'V⟩ := hXgen x
      have hx'W : ν x' ∈ W := (hx'x.map ν.continuous).mem_open W.isOpen hx
      obtain ⟨x'', hx''x', hx''η⟩ := p_s7 Ct C ν V hV x' η hx'V (hηspec _ hx'W)
      rw [← hpuniq x'' hx''η]
      exact hx''x'.trans hx'x
    have hpW : p.1 ∈ ν ⁻¹ᵁ W := by show ν p.1 ∈ W; rw [hp]; exact hηW
    have hirr : IsIrreducible ((ν ⁻¹ᵁ W : Ct.Opens) : Set Ct) := by
      rw [← isIrreducible_iff_closure]
      have : closure ((ν ⁻¹ᵁ W : Ct.Opens) : Set Ct) = closure {p.1} := by
        apply le_antisymm
        · apply closure_minimal _ isClosed_closure
          intro x hx
          exact specializes_iff_mem_closure.mp (hpgen x hx)
        · exact closure_mono (Set.singleton_subset_iff.mpr hpW)
      rw [this]
      exact isIrreducible_singleton.closure
    haveI : ∀ y : (ν ⁻¹ᵁ W).toScheme, IsDomain ((ν ⁻¹ᵁ W).toScheme.presheaf.stalk y) := fun y => by
      haveI := hCt y.1
      exact MulEquiv.isDomain (Ct.presheaf.stalk y.1)
        (Scheme.Opens.stalkIso (ν ⁻¹ᵁ W) y).commRingCatIsoToRingEquiv.toMulEquiv
    haveI : ∀ y : (ν ⁻¹ᵁ W).toScheme, _root_.IsReduced ((ν ⁻¹ᵁ W).toScheme.presheaf.stalk y) :=
      fun y => by infer_instance
    haveI : IsReduced (ν ⁻¹ᵁ W).toScheme := isReduced_of_isReduced_stalk _
    haveI : IrreducibleSpace (ν ⁻¹ᵁ W).toScheme := Subtype.irreducibleSpace hirr
    haveI : AlgebraicGeometry.IsIntegral (ν ⁻¹ᵁ W).toScheme :=
      isIntegral_of_irreducibleSpace_of_isReduced _

    have hVW : IsIso (ν ∣_ (W ⊓ V)) := by
      have e2 : V.ι ''ᵁ (V.ι ⁻¹ᵁ W) = W ⊓ V := by
        rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι, inf_comm]
      have h0 : MorphismProperty.isomorphisms Scheme ((ν ∣_ V) ∣_ (V.ι ⁻¹ᵁ W)) :=
        (inferInstance : IsIso ((ν ∣_ V) ∣_ (V.ι ⁻¹ᵁ W)))
      rw [MorphismProperty.arrow_mk_iso_iff (MorphismProperty.isomorphisms Scheme)
        (morphismRestrictRestrict ν V (V.ι ⁻¹ᵁ W) ≪≫ morphismRestrictEq ν e2)] at h0
      exact h0
    have hU0 : IsIso ((ν ∣_ W) ∣_ (W.ι ⁻¹ᵁ V)) := by
      have e2 : W.ι ''ᵁ (W.ι ⁻¹ᵁ V) = W ⊓ V := by
        rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
      show MorphismProperty.isomorphisms Scheme _
      rw [MorphismProperty.arrow_mk_iso_iff (MorphismProperty.isomorphisms Scheme)
        (morphismRestrictRestrict ν W (W.ι ⁻¹ᵁ V) ≪≫ morphismRestrictEq ν e2)]
      exact hVW
    have hU0ne : W.ι ⁻¹ᵁ V ≠ ⊥ := by
      intro h0
      have hmem : (⟨η, hηW⟩ : W.toScheme) ∈ W.ι ⁻¹ᵁ V := hηV
      rw [h0] at hmem
      exact hmem
    have htop := wcpa_dj_gs_norm_iso_normal_locus (ν ⁻¹ᵁ W).toScheme W.toScheme (ν ∣_ W)
      inferInstance ⟨_, hU0ne, hU0⟩ ⊤ (fun y _ => by
        haveI := (hWn y.1 y.2).2
        exact IsIntegrallyClosed.of_equiv
          (Scheme.Opens.stalkIso W y).commRingCatIsoToRingEquiv.symm)
    show MorphismProperty.isomorphisms Scheme (ν ∣_ W)
    exact IsZariskiLocalAtTarget.of_iSup_eq_top (fun _ : Unit => (⊤ : W.toScheme.Opens))
      iSup_const (fun _ => htop)

  have hUn : ∀ w : C, w ∈ U → IsDomain (C.presheaf.stalk w) ∧
      IsIntegrallyClosed (C.presheaf.stalk w) := by
    intro w hw
    obtain ⟨W, hwW, hWsm⟩ := (hU w).1 hw
    haveI := hWsm
    haveI : Smooth (W.ι ≫ c) := SmoothOfRelativeDimension.smooth 1 _
    obtain ⟨h1, h2⟩ := wc_fntame_smooth_stalk_normal Ω W.toScheme (W.ι ≫ c) ⟨w, hwW⟩
    refine ⟨MulEquiv.isDomain _
      (Scheme.Opens.stalkIso W ⟨w, hwW⟩).commRingCatIsoToRingEquiv.symm.toMulEquiv, ?_⟩
    exact IsIntegrallyClosed.of_equiv (Scheme.Opens.stalkIso W ⟨w, hwW⟩).commRingCatIsoToRingEquiv

  haveI := hprop
  haveI : IsLocallyNoetherian C := LocallyOfFiniteType.isLocallyNoetherian c

  have hXprime : ∀ (i : Fin 2) (f g : MvPowerSeries (Fin 2) Ω),
      MvPowerSeries.X i ∣ f * g → MvPowerSeries.X i ∣ f ∨ MvPowerSeries.X i ∣ g := by
    intro i f g h
    let ρ : MvPowerSeries (Fin 2) Ω → MvPowerSeries (Fin 2) Ω :=
      fun φ m => if m i = 0 then MvPowerSeries.coeff m φ else 0
    have hρ : ∀ φ m, MvPowerSeries.coeff m (ρ φ) =
        if m i = 0 then MvPowerSeries.coeff m φ else 0 := fun φ m => rfl
    have hker : ∀ φ, MvPowerSeries.X i ∣ φ ↔ ρ φ = 0 := by
      intro φ
      rw [MvPowerSeries.X_dvd_iff]
      constructor
      · intro H
        ext m
        rw [hρ, map_zero]
        split_ifs with hm
        · exact H m hm
        · rfl
      · intro H m hm
        have := congrArg (MvPowerSeries.coeff m) H
        rw [hρ, if_pos hm, map_zero] at this
        exact this
    rw [hker] at h
    have hmul : ρ f * ρ g = 0 := by
      ext m
      rw [MvPowerSeries.coeff_mul, map_zero]
      by_cases hm : m i = 0
      · have := congrArg (MvPowerSeries.coeff m) h
        rw [hρ, if_pos hm, map_zero, MvPowerSeries.coeff_mul] at this
        rw [← this]
        apply Finset.sum_congr rfl
        intro p hp
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
        have h1 : p.1 i = 0 := by
          have := congrArg (fun q => q i) hp
          simp only [Finsupp.coe_add, Pi.add_apply] at this
          omega
        have h2 : p.2 i = 0 := by
          have := congrArg (fun q => q i) hp
          simp only [Finsupp.coe_add, Pi.add_apply] at this
          omega
        rw [hρ, hρ, if_pos h1, if_pos h2]
      · apply Finset.sum_eq_zero
        intro p hp
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
        have : p.1 i ≠ 0 ∨ p.2 i ≠ 0 := by
          by_contra hc
          push_neg at hc
          apply hm
          have := congrArg (fun q => q i) hp
          simp only [Finsupp.coe_add, Pi.add_apply] at this
          omega
        rcases this with h1 | h2
        · rw [hρ, if_neg h1, zero_mul]
        · rw [hρ g, if_neg h2, mul_zero]
    rcases mul_eq_zero.mp hmul with h1 | h2
    · exact Or.inl ((hker f).mpr h1)
    · exact Or.inr ((hker g).mpr h2)
  have hX10 : ¬ (MvPowerSeries.X 1 : MvPowerSeries (Fin 2) Ω) ∣ MvPowerSeries.X 0 := by
    intro h
    rw [MvPowerSeries.X_dvd_iff] at h
    have := h (Finsupp.single 0 1) (by simp)
    rw [MvPowerSeries.coeff_X, if_pos rfl] at this
    exact one_ne_zero this
  have hQred : _root_.IsReduced (MvPowerSeries (Fin 2) Ω ⧸
      Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) Ω)}) := by
    rw [← Ideal.isRadical_iff_quotient_reduced]
    intro f ⟨n, hn⟩
    rw [Ideal.mem_span_singleton] at hn ⊢
    have hpow : ∀ (i : Fin 2) (k : ℕ), MvPowerSeries.X i ∣ f ^ k → k ≠ 0 →
        MvPowerSeries.X i ∣ f := by
      intro i k
      induction k with
      | zero => intro _ h; exact absurd rfl h
      | succ k ih =>
        intro hk _
        rw [pow_succ] at hk
        rcases hXprime i _ _ hk with h1 | h2
        · by_cases hk0 : k = 0
          · subst hk0; rw [pow_zero] at h1
            rw [MvPowerSeries.X_dvd_iff] at h1
            have := h1 0 (by simp)
            simp at this
          · exact ih h1 hk0
        · exact h2
    have hn0 : n ≠ 0 := by
      rintro rfl
      rw [pow_zero] at hn
      have := dvd_trans (dvd_mul_right _ _) hn
      rw [MvPowerSeries.X_dvd_iff] at this
      have := this 0 (by simp)
      simp at this
    have h0 : MvPowerSeries.X 0 ∣ f := hpow 0 n (dvd_trans (dvd_mul_right _ _) hn) hn0
    have h1 : MvPowerSeries.X 1 ∣ f := hpow 1 n (dvd_trans (dvd_mul_left _ _) hn) hn0
    obtain ⟨g, rfl⟩ := h0
    rcases hXprime 1 _ _ h1 with h | h
    · exact absurd h hX10
    · exact mul_dvd_mul_left _ h
  have p_s3 : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A],
      (AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+* (MvPowerSeries (Fin 2) Ω ⧸
        Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) Ω)})) →
      _root_.IsReduced A := by
    intro A _ _ _ e
    have hinj : Function.Injective
        (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) := by
      intro a b hab
      rw [AdicCompletion.algebraMap_apply, AdicCompletion.algebraMap_apply] at hab
      exact AdicCompletion.of_injective _ _ hab
    exact isReduced_of_injective (e.toRingHom.comp
      (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))) (e.injective.comp hinj)
  have p_s4 : ∀ (A : Type u) [CommRing A] [IsLocalRing A],
      (AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+* (MvPowerSeries (Fin 2) Ω ⧸
        Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) Ω)})) →
      ¬ IsField A := by
    intro A _ _ e hA
    have hm : IsLocalRing.maximalIdeal A = ⊥ := (IsLocalRing.isField_iff_maximalIdeal_eq).mp hA
    haveI : IsAdicComplete (IsLocalRing.maximalIdeal A) A := by
      rw [hm]; exact IsAdicComplete.bot A
    have hsurj : Function.Surjective
        (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) := by
      intro y
      obtain ⟨a, ha⟩ := (AdicCompletion.ofLinearEquiv (IsLocalRing.maximalIdeal A) A).surjective y
      refine ⟨a, ?_⟩
      rw [AdicCompletion.algebraMap_apply, ← ha, AdicCompletion.ofLinearEquiv_apply]
      rfl
    have hinj : Function.Injective
        (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) := by
      intro a b hab
      rw [AdicCompletion.algebraMap_apply, AdicCompletion.algebraMap_apply] at hab
      exact AdicCompletion.of_injective _ _ hab
    let ψ := e.toRingHom.comp (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))
    have hψ : Function.Bijective ψ := ⟨e.injective.comp hinj, e.surjective.comp hsurj⟩
    have hQ : IsField (MvPowerSeries (Fin 2) Ω ⧸
        Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) Ω)}) :=
      MulEquiv.isField hA (RingEquiv.ofBijective ψ hψ).symm.toMulEquiv
    set x := Ideal.Quotient.mk
      (Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) Ω)})
      (MvPowerSeries.X 0 : MvPowerSeries (Fin 2) Ω) with hx
    have hx0 : x ≠ 0 := by
      intro h
      rw [hx, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton] at h
      exact hX10 (dvd_trans (dvd_mul_left _ _) h)
    obtain ⟨y, hy⟩ := hQ.mul_inv_cancel hx0
    obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective y
    rw [hx, ← map_mul, ← map_one (Ideal.Quotient.mk _), Ideal.Quotient.eq,
      Ideal.mem_span_singleton] at hy
    obtain ⟨h, hh⟩ := hy
    have := congrArg MvPowerSeries.constantCoeff hh
    simp at this

  have hnode' : ∀ w : C, w ∉ U → _root_.IsReduced (C.presheaf.stalk w) ∧
      ¬ IsField (C.presheaf.stalk w) := by
    intro w hw
    obtain ⟨e, -⟩ := hnode w hw
    exact ⟨p_s3 _ e, p_s4 _ e⟩
  have hgenU : ∀ w : C, w ∉ U → ∃ y : C, y ⤳ w ∧ y ≠ w := fun w hw =>
    p_s5 C w (hnode' w hw).1 (hnode' w hw).2

  haveI : ∀ x : C, _root_.IsReduced (C.presheaf.stalk x) := by
    intro x
    by_cases hx : x ∈ U
    · haveI := (hUn x hx).1
      infer_instance
    · exact (hnode' x hx).1
  haveI : IsReduced C := isReduced_of_isReduced_stalk C

  obtain ⟨Xt, b, Z, iZ, hfin, hci, hiso, hnorm, hZgen, hXgen⟩ := wcfd_reduced_normalization Ω C c
  haveI := hci
  let V : C.Opens := ⟨(Set.range iZ)ᶜ, iZ.isClosedEmbedding.isClosed_range.isOpen_compl⟩
  have hV : IsIso (b ∣_ V) := hiso V rfl
  have hVgen : ∀ w : C, w ∉ V → ∃ y : C, y ⤳ w ∧ y ≠ w := by
    intro w hw
    have hw' : w ∈ Set.range iZ := by
      by_contra h
      exact hw h
    obtain ⟨z, rfl⟩ := hw'
    exact hZgen z
  have hXgen' : ∀ x : Xt, ∃ x' : Xt, x' ⤳ x ∧ b x' ∈ V := hXgen

  have hsurj : Surjective b := p_s8 Xt C b V hfin hV (p_s6 C V hVgen)

  have hisoU : IsIso (b ∣_ U) := by
    apply p_s11 Xt C b U
    intro w hw
    obtain ⟨W, hwW, hWU, hWirr⟩ := p_s9 C w U hw (hUn w hw).1
    exact ⟨W, hwW, hWU, p_s10 Xt C b V W hfin hV (fun x => (hnorm x).1) hXgen' hVgen hWirr
      (fun w' hw' => hUn w' (hWU hw'))⟩

  have hgen : ∀ x : Xt, ∃ x' : Xt, x' ⤳ x ∧ b x' ∈ U := by
    intro x
    obtain ⟨x', hx'x, hx'V⟩ := hXgen' x
    obtain ⟨η, hη, hηU⟩ := p_s6 C U hgenU (b x')
    obtain ⟨x'', hx'', hbx''⟩ := p_s7 Xt C b V hV x' η hx'V hη
    exact ⟨x'', hx''.trans hx'x, by rw [hbx'']; exact hηU⟩
  exact ⟨Xt, b, hfin, hsurj, hisoU, hnorm, hgen⟩

theorem wcpa_dj_nn_normal_smooth : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (C : Scheme.{u})
    (c : C ⟶ Spec (.of Ω)) (U : C.Opens) (Ct : Scheme.{u}) (ν : Ct ⟶ C), IsProper c →
    (∀ w : C, w ∈ U ↔ ∃ W : C.Opens, w ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ c)) →
    (∀ w : C, w ∉ U → ∃ e : AdicCompletion (IsLocalRing.maximalIdeal (C.presheaf.stalk w))
        (C.presheaf.stalk w) ≃+*
        (MvPowerSeries (Fin 2) Ω ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
      e.toRingHom.comp ((algebraMap (C.presheaf.stalk w) (AdicCompletion
        (IsLocalRing.maximalIdeal (C.presheaf.stalk w)) (C.presheaf.stalk w))).comp
        ((Scheme.ΓSpecIso (.of Ω)).inv ≫ c.appTop ≫ C.presheaf.germ ⊤ w trivial).hom) =
        (Ideal.Quotient.mk _).comp MvPowerSeries.C) →
    IsFinite ν → IsIso (ν ∣_ U) →
    (∀ x : Ct, IsDomain (Ct.presheaf.stalk x) ∧ IsIntegrallyClosed (Ct.presheaf.stalk x)) →
    (∀ x : Ct, ∃ x' : Ct, x' ⤳ x ∧ ν x' ∈ U) →
    SmoothOfRelativeDimension 1 (ν ≫ c) :=
by
  intro Ω _ _ C c U Ct ν hprop hU hnode hfin hiso hnorm hgen
  haveI := hprop
  haveI := hfin
  haveI := hiso
  haveI : JacobsonSpace C := LocallyOfFiniteType.jacobsonSpace c
  haveI : LocallyOfFiniteType (ν ≫ c) := inferInstance
  haveI : IsLocallyNoetherian Ct := LocallyOfFiniteType.isLocallyNoetherian (ν ≫ c)
  haveI : PerfectField Ω := IsAlgClosed.perfectField Ω

  have s1 : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (φ : Ω →+* A),
      (∃ e : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+*
        (MvPowerSeries (Fin 2) Ω ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
        e.toRingHom.comp ((algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)).comp φ) =
          (Ideal.Quotient.mk _).comp MvPowerSeries.C) →
      ∀ a : A, ∃ l : Ω, a - φ l ∈ IsLocalRing.maximalIdeal A := by
    intro A _ _ φ ⟨e, he⟩ a
    have hker : Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} ≤
        RingHom.ker (MvPowerSeries.constantCoeff (σ := Fin 2) (R := Ω)) := by
      rw [Ideal.span_le, Set.singleton_subset_iff]
      simp [RingHom.mem_ker]
    let ε := Ideal.Quotient.lift _ (MvPowerSeries.constantCoeff (σ := Fin 2) (R := Ω))
      (fun x hx => RingHom.mem_ker.mp (hker hx))
    set ι := algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) with hι
    refine ⟨ε (e (ι a)), ?_⟩
    by_contra hb
    have hu : IsUnit (a - φ (ε (e (ι a)))) := IsLocalRing.notMem_maximalIdeal.mp hb
    have hu2 : IsUnit (ε (e (ι (a - φ (ε (e (ι a))))))) := ((hu.map ι).map e).map ε
    have hε : ∀ t : Ω, ε (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})
        (MvPowerSeries.C t)) = t := by
      intro t
      rw [Ideal.Quotient.lift_mk]
      exact MvPowerSeries.constantCoeff_C t
    have h0 : ε (e (ι (a - φ (ε (e (ι a)))))) = 0 := by
      have hl := RingHom.congr_fun he (ε (e (ι a)))
      simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe] at hl
      rw [map_sub, map_sub, map_sub, hl, hε, sub_self]
    rw [h0] at hu2
    exact not_isUnit_zero hu2

  have s2 : ∀ x : C, (∀ a : C.presheaf.stalk x, ∃ l : Ω,
      a - ((Scheme.ΓSpecIso (.of Ω)).inv ≫ c.appTop ≫ C.presheaf.germ ⊤ x trivial).hom l ∈
        IsLocalRing.maximalIdeal (C.presheaf.stalk x)) → IsClosed ({x} : Set C) := by
    intro x hx
    rw [isClosed_singleton_iff_locallyOfFiniteType]
    set g := C.fromSpecResidueField x ≫ c with hg
    have hψ : Spec.map (Spec.preimage g) = g := Spec.map_preimage g
    have hs2 : (C.fromSpecResidueField x).appTop ≫ (Scheme.ΓSpecIso (C.residueField x)).hom =
        C.evaluation ⊤ x trivial := by
      rw [Scheme.fromSpecResidueField, Scheme.Hom.comp_appTop, Scheme.fromSpecStalk_appTop]
      simp only [Category.assoc]
      erw [CategoryTheory.Functor.map_id, Category.id_comp, Scheme.ΓSpecIso_naturality,
        Iso.inv_hom_id_assoc, Scheme.germ_residue]
    have heq : Spec.preimage g = (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫ c.appTop ≫
        C.evaluation ⊤ x trivial := by
      rw [Iso.eq_inv_comp, ← Scheme.ΓSpecIso_naturality, hψ, hg, Scheme.Hom.comp_appTop,
        Category.assoc, hs2]
    have hsurj : Function.Surjective (Spec.preimage g).hom := by
      intro r
      obtain ⟨a, rfl⟩ := C.residue_surjective x r
      obtain ⟨l, hl⟩ := hx a
      refine ⟨l, ?_⟩
      have h1 : IsLocalRing.residue _ (a - ((Scheme.ΓSpecIso (.of Ω)).inv ≫ c.appTop ≫
          C.presheaf.germ ⊤ x trivial).hom l) = 0 := (IsLocalRing.residue_eq_zero_iff _).mpr hl
      rw [map_sub, sub_eq_zero] at h1
      have h3 : (Scheme.ΓSpecIso (.of Ω)).inv ≫ c.appTop ≫ C.evaluation ⊤ x trivial =
          ((Scheme.ΓSpecIso (.of Ω)).inv ≫ c.appTop ≫ C.presheaf.germ ⊤ x trivial) ≫
            C.residue x := by
        rw [Category.assoc, Category.assoc]
        exact congrArg (fun t => (Scheme.ΓSpecIso (.of Ω)).inv ≫ t)
          (congrArg (fun t => c.appTop ≫ t) (C.germ_residue (U := ⊤) x trivial).symm)
      have h2 : (Spec.preimage g).hom l = IsLocalRing.residue _
          (((Scheme.ΓSpecIso (.of Ω)).inv ≫ c.appTop ≫ C.presheaf.germ ⊤ x trivial).hom l) := by
        rw [heq, h3]
        rfl
      rw [h2, ← h1]
      rfl
    have hft : (Spec.preimage g).hom.FiniteType := RingHom.FiniteType.of_surjective _ hsurj
    haveI hg' : LocallyOfFiniteType g := by
      rw [← hψ]; exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mpr hft
    exact locallyOfFiniteType_of_comp (C.fromSpecResidueField x) c

  have s3 : ∀ a b : Ct, a ⤳ b → ν a = ν b → a = b := by
    intro a b hab heq
    haveI : DiscreteTopology (ν ⁻¹' {ν b} : Set Ct) :=
      (Scheme.Hom.fiberHomeo ν (ν b)).discreteTopology
    have ha : a ∈ ν ⁻¹' {ν b} := heq
    have hb : b ∈ ν ⁻¹' {ν b} := rfl
    have hs : (⟨a, ha⟩ : (ν ⁻¹' {ν b} : Set Ct)) ⤳ ⟨b, hb⟩ := (subtype_specializes_iff _ _).mpr hab
    exact congrArg Subtype.val (specializes_iff_eq.mp hs)

  have chain3 : ∀ (Y : Type u) [TopologicalSpace Y] [T0Space Y],
      topologicalKrullDim Y ≤ ((1 : ℕ) : WithBot ℕ∞) →
      ∀ a b d : Y, a ⤳ b → b ⤳ d → a ≠ b → b ≠ d → False := by
    intro Y _ _ hY a b d hab hbd hne1 hne2
    let I : Y → TopologicalSpace.IrreducibleCloseds Y := fun y =>
      ⟨closure {y}, isIrreducible_singleton.closure, isClosed_closure⟩
    have hle : ∀ x y : Y, x ⤳ y → I y ≤ I x := fun x y h => by
      change closure {y} ⊆ closure {x}
      exact specializes_iff_closure_subset.mp h
    have hne : ∀ x y : Y, x ≠ y → I x ≠ I y := fun x y h hI =>
      h (inseparable_iff_closure_eq.mpr
        (congrArg TopologicalSpace.IrreducibleCloseds.carrier hI)).eq
    rw [topologicalKrullDim, Nat.cast_one, Order.krullDim_le_one_iff] at hY
    rcases hY (I b) with h | h
    · exact hne b d hne2 (le_antisymm (h (hle b d hbd)) (hle b d hbd))
    · exact hne a b hne1 (le_antisymm (h (hle a b hab)) (hle a b hab))

  have hUsm : SmoothOfRelativeDimension 1 (U.ι ≫ c) := by
    apply wc_ldp_il_smooth_local
    intro z
    obtain ⟨W, hzW, hW⟩ := (hU z.1).1 z.2
    refine ⟨U.ι ⁻¹ᵁ W, ?_, ?_⟩
    · show U.ι z ∈ W
      convert hzW using 1
      exact Scheme.Opens.ι_apply U z
    have hr : Set.range ((U.ι ⁻¹ᵁ W).ι ≫ U.ι).base ⊆ Set.range W.ι.base := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨v, rfl⟩
      change U.ι ((U.ι ⁻¹ᵁ W).ι v) ∈ W
      have hv : U.ι v.1 ∈ W := v.2
      convert hv using 2
      exact Scheme.Opens.ι_apply (U.ι ⁻¹ᵁ W) v
    let j := IsOpenImmersion.lift W.ι ((U.ι ⁻¹ᵁ W).ι ≫ U.ι) hr
    have hj : j ≫ W.ι = (U.ι ⁻¹ᵁ W).ι ≫ U.ι := IsOpenImmersion.lift_fac _ _ _
    haveI : IsOpenImmersion (j ≫ W.ι) := by rw [hj]; infer_instance
    haveI : IsOpenImmersion j := IsOpenImmersion.of_comp j W.ι
    haveI := hW
    have h := smoothOfRelativeDimension_comp 0 1 j (W.ι ≫ c)
    rw [Nat.zero_add, ← Category.assoc, hj, Category.assoc] at h
    exact h
  have hUdim : topologicalKrullDim (U : Set C) ≤ ((1 : ℕ) : WithBot ℕ∞) :=
    wc_smooth_alg_closed_dim_le Ω U.toScheme (U.ι ≫ c) 1

  have s4 : ∀ w₀ w₁ : C, w₁ ∈ U → w₀ ⤳ w₁ → w₀ ≠ w₁ → IsClosed ({w₁} : Set C) := by
    intro w₀ w₁ h1 h01 hne
    have h0 : w₀ ∈ U := h01.mem_open U.isOpen h1
    have hset : ({w₁} : Set C) = (U : Set C) ∩ closure {w₁} := by
      ext y
      simp only [Set.mem_singleton_iff, Set.mem_inter_iff]
      constructor
      · rintro rfl; exact ⟨h1, subset_closure rfl⟩
      · rintro ⟨hyU, hy⟩
        by_contra hy1
        exact chain3 (U : Set C) hUdim ⟨w₀, h0⟩ ⟨w₁, h1⟩ ⟨y, hyU⟩
          ((subtype_specializes_iff _ _).mpr h01)
          ((subtype_specializes_iff _ _).mpr (specializes_iff_mem_closure.mpr hy))
          (fun h => hne (congrArg Subtype.val h))
          (fun h => hy1 (congrArg Subtype.val h).symm)
    apply isClosed_singleton_of_isLocallyClosed_singleton
    rw [hset]
    exact U.isOpen.isLocallyClosed.inter isClosed_closure.isLocallyClosed
  have hnodecl : ∀ w : C, w ∉ U → IsClosed ({w} : Set C) := fun w hw =>
    s2 w (s1 _ _ (hnode w hw))
  have hchain : ∀ y₀ y₁ y₂ : Ct, y₀ ⤳ y₁ → y₁ ⤳ y₂ → y₀ ≠ y₁ → y₁ ≠ y₂ → False := by
    intro y₀ y₁ y₂ h01 h12 n01 n12
    have m01 := h01.map ν.continuous
    have m12 := h12.map ν.continuous
    have d01 : ν y₀ ≠ ν y₁ := fun h => n01 (s3 _ _ h01 h)
    have d12 : ν y₁ ≠ ν y₂ := fun h => n12 (s3 _ _ h12 h)
    have hcl : IsClosed ({ν y₁} : Set C) := by
      by_cases hU1 : ν y₁ ∈ U
      · exact s4 _ _ hU1 m01 d01
      · exact hnodecl _ hU1
    have hm : ν y₂ ∈ closure {ν y₁} := specializes_iff_mem_closure.mp m12
    rw [hcl.closure_eq] at hm
    exact d12 hm.symm

  have s5 : ∀ z : Ct, (∃ y, y ⤳ z ∧ y ≠ z) →
      ringKrullDim (Ct.presheaf.stalk z) = ((1 : ℕ) : WithBot ℕ∞) := by
    intro z ⟨y, hyz, hne⟩
    have hemb := (Ct.fromSpecStalk z).isEmbedding
    have hinj := hemb.injective
    have hcont := (Ct.fromSpecStalk z).continuous
    rw [ringKrullDim, Nat.cast_one]
    apply le_antisymm
    · rw [Order.krullDim_le_one_iff]
      intro p
      by_contra h
      rw [not_or, not_isMin_iff, not_isMax_iff] at h
      obtain ⟨⟨p0, hp0⟩, ⟨p2, hp2⟩⟩ := h
      exact hchain (Ct.fromSpecStalk z p0) (Ct.fromSpecStalk z p) (Ct.fromSpecStalk z p2)
        (((PrimeSpectrum.le_iff_specializes _ _).mp hp0.le).map hcont)
        (((PrimeSpectrum.le_iff_specializes _ _).mp hp2.le).map hcont)
        (fun h => hp0.ne (hinj h)) (fun h => hp2.ne (hinj h))
    · rw [Order.one_le_krullDim_iff]
      have hy : y ∈ Set.range (Ct.fromSpecStalk z) := by
        rw [Scheme.range_fromSpecStalk]; exact hyz
      obtain ⟨p, rfl⟩ := hy
      refine ⟨p, IsLocalRing.closedPoint _, lt_of_le_of_ne ?_ ?_⟩
      · exact IsLocalRing.le_maximalIdeal p.isPrime.ne_top
      · intro h
        apply hne
        rw [h, Scheme.fromSpecStalk_closedPoint]

  have s6 : ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] [IsDomain R]
      [IsIntegrallyClosed R], ringKrullDim R = ((1 : ℕ) : WithBot ℕ∞) → IsRegularLocalRing R := by
    intro R _ _ _ _ _ hdim
    have hnf : ¬ IsField R := fun h => by
      have h0 := ringKrullDim_eq_zero_of_isField h
      rw [h0] at hdim
      exact absurd hdim (by decide)
    have hdvr : IsDiscreteValuationRing R := by
      apply ((IsDiscreteValuationRing.TFAE R hnf).out 1 4).mpr
      refine ⟨inferInstance, IsLocalRing.maximalIdeal R,
        ⟨fun h => hnf (IsLocalRing.isField_iff_maximalIdeal_eq.mpr h), inferInstance⟩, ?_⟩
      rintro P ⟨hP0, hP⟩
      have hle : Order.krullDim (PrimeSpectrum R) ≤ 1 := by
        rw [← ringKrullDim, hdim, Nat.cast_one]
      rw [Order.krullDim_le_one_iff] at hle
      rcases hle ⟨P, hP⟩ with h | h
      · exfalso
        have h1 : (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum R) ≤ ⟨P, hP⟩ :=
          (show (⊥ : Ideal R) ≤ P from bot_le)
        have h2 := h h1
        exact hP0 (le_bot_iff.mp h2)
      · exact IsLocalRing.eq_maximalIdeal (PrimeSpectrum.isMax_iff.mp h)
    infer_instance

  apply wc_odp_smooth_of_closed_regular Ω Ct (ν ≫ c) 1
  intro z _
  by_cases h : ν z ∈ U
  · left
    refine ⟨ν ⁻¹ᵁ U, U.toScheme, U.ι ≫ c, asIso (ν ∣_ U), h, hUsm, ?_⟩
    rw [asIso_hom, ← Category.assoc, morphismRestrict_ι, Category.assoc]
  · right
    obtain ⟨x', hx', hx'U⟩ := hgen z
    have hne : x' ≠ z := fun h' => h (h' ▸ hx'U)
    have hdim := s5 z ⟨x', hx', hne⟩
    haveI := (hnorm z).1
    haveI := (hnorm z).2
    exact ⟨s6 _ hdim, hdim⟩

theorem wcpa_dj_nf_node_residue : ∀ (Ω A : Type u) [Field Ω] [CommRing A] [IsLocalRing A] (φ : Ω →+* A), (∃ e : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+* (MvPowerSeries (Fin 2) Ω ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), e.toRingHom.comp ((algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)).comp φ) = (Ideal.Quotient.mk _).comp MvPowerSeries.C) → ∀ a : A, ∃ z : Ω, a - φ z ∈ IsLocalRing.maximalIdeal A :=
by
  intro Ω A _ _ _ φ ⟨e, he⟩ a
  have hκ : ∀ F ∈ Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) Ω)},
      MvPowerSeries.constantCoeff F = 0 := by
    intro F hF
    obtain ⟨G, rfl⟩ := Ideal.mem_span_singleton'.mp hF
    simp [MvPowerSeries.constantCoeff_X]
  let κ : (MvPowerSeries (Fin 2) Ω ⧸
      Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) Ω)}) →+* Ω :=
    Ideal.Quotient.lift _ MvPowerSeries.constantCoeff hκ
  let ψ : A →+* Ω :=
    κ.comp (e.toRingHom.comp (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)))
  have hψφ : ∀ z, ψ (φ z) = z := by
    intro z
    have h1 := RingHom.congr_fun he z
    have h2 : ψ (φ z) = κ (Ideal.Quotient.mk _ (MvPowerSeries.C z)) := by
      show κ (e.toRingHom (algebraMap A _ (φ z))) = _
      exact congrArg κ h1
    rw [h2]
    simp [κ, Ideal.Quotient.lift_mk]
  refine ⟨ψ a, IsLocalRing.le_maximalIdeal (RingHom.ker_ne_top ψ) ?_⟩
  rw [RingHom.mem_ker, map_sub, hψφ, sub_self]

theorem wcpa_dj_nf_node_reduced : ∀ (Ω A : Type u) [Field Ω] [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (φ : Ω →+* A), (∃ e : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+* (MvPowerSeries (Fin 2) Ω ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), e.toRingHom.comp ((algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)).comp φ) = (Ideal.Quotient.mk _).comp MvPowerSeries.C) → IsReduced A :=
by
  intro Ω A _ _ _ _ φ ⟨e, _⟩
  classical
  have hXprime : ∀ s : Fin 2, Prime (MvPowerSeries.X s : MvPowerSeries (Fin 2) Ω) := by
    intro s
    let ρ : MvPowerSeries (Fin 2) Ω → MvPowerSeries (Fin 2) Ω :=
      fun f => fun m => if m s = 0 then MvPowerSeries.coeff m f else 0
    have hρcoeff : ∀ f m, MvPowerSeries.coeff m (ρ f) =
        if m s = 0 then MvPowerSeries.coeff m f else 0 := fun f m => rfl
    have hdvd : ∀ f, MvPowerSeries.X s ∣ f ↔ ρ f = 0 := by
      intro f
      rw [MvPowerSeries.X_dvd_iff, MvPowerSeries.ext_iff]
      constructor
      · intro h m
        rw [hρcoeff, map_zero]
        split_ifs with hm
        · exact h m hm
        · rfl
      · intro h m hm
        have := h m
        rwa [hρcoeff, if_pos hm, map_zero] at this
    have hmul : ∀ f g, ρ (f * g) = ρ f * ρ g := by
      intro f g
      ext m
      rw [hρcoeff, MvPowerSeries.coeff_mul, MvPowerSeries.coeff_mul]
      split_ifs with hm
      · apply Finset.sum_congr rfl
        intro pq hpq
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at hpq
        have h1 : pq.1 s + pq.2 s = m s := by rw [← Finsupp.add_apply, hpq]
        rw [hρcoeff, hρcoeff, if_pos (by omega), if_pos (by omega)]
      · symm
        apply Finset.sum_eq_zero
        intro pq hpq
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at hpq
        have h1 : pq.1 s + pq.2 s = m s := by rw [← Finsupp.add_apply, hpq]
        rw [hρcoeff, hρcoeff]
        by_cases h2 : pq.1 s = 0
        · rw [if_neg (by omega : ¬ pq.2 s = 0), mul_zero]
        · rw [if_neg h2, zero_mul]
    have hρ1 : ρ 1 ≠ 0 := by
      intro h
      have h0 := congrArg (MvPowerSeries.coeff (0 : Fin 2 →₀ ℕ)) h
      rw [hρcoeff, if_pos (by simp), map_zero, MvPowerSeries.coeff_one, if_pos rfl] at h0
      exact one_ne_zero h0
    refine ⟨?_, ?_, ?_⟩
    · intro h
      have h1 : MvPowerSeries.coeff (Finsupp.single s 1) (MvPowerSeries.X s : MvPowerSeries (Fin 2) Ω) = 1 := by
        simp [MvPowerSeries.coeff_X]
      rw [h, map_zero] at h1
      exact zero_ne_one h1
    · intro h
      exact hρ1 ((hdvd 1).1 (isUnit_iff_dvd_one.mp h))
    · intro a b hab
      have h := (hdvd _).1 hab
      rw [hmul] at h
      rcases mul_eq_zero.mp h with h | h
      · exact Or.inl ((hdvd a).2 h)
      · exact Or.inr ((hdvd b).2 h)
  have hred : _root_.IsReduced (MvPowerSeries (Fin 2) Ω ⧸
      Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) Ω)}) := by
    rw [← Ideal.isRadical_iff_quotient_reduced]
    intro f hf
    obtain ⟨n, hn⟩ := hf
    rw [Ideal.mem_span_singleton] at hn ⊢
    have hx : MvPowerSeries.X 0 ∣ f :=
      (hXprime 0).dvd_of_dvd_pow (dvd_trans (dvd_mul_right _ _) hn)
    obtain ⟨g, rfl⟩ := hx
    have hy : MvPowerSeries.X 1 ∣ MvPowerSeries.X 0 * g :=
      (hXprime 1).dvd_of_dvd_pow (dvd_trans (dvd_mul_left _ _) hn)
    rcases (hXprime 1).dvd_or_dvd hy with h | h
    · exfalso
      rw [MvPowerSeries.X_dvd_iff] at h
      have h2 := h (Finsupp.single 0 1) (by simp)
      simp [MvPowerSeries.coeff_X] at h2
    · obtain ⟨k, rfl⟩ := h
      exact ⟨k, by ring⟩
  have hinj : Function.Injective
      (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) := by
    have h := AdicCompletion.of_injective (IsLocalRing.maximalIdeal A) A
    intro a b hab
    apply h
    simpa [AdicCompletion.algebraMap_apply] using hab
  have hψ : Function.Injective
      (e.toRingHom.comp (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))) :=
    e.injective.comp hinj
  exact isReduced_of_injective _ hψ

theorem wcpa_dj_nf_conductor : ∀ (A B : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] [IsReduced A] [CommRing B] (j : A →+* B), j.Finite → ringKrullDim A ≤ 1 → IsLocalRing.maximalIdeal A ∉ minimalPrimes A → (∀ (Q : Ideal B) [Q.IsPrime], IsDomain (Localization.AtPrime Q)) → (∀ Q ∈ minimalPrimes B, Ideal.comap j Q ≠ IsLocalRing.maximalIdeal A) → (∀ q : Ideal A, q.IsPrime → q ≠ IsLocalRing.maximalIdeal A → ∀ b : B, ∃ g : A, g ∉ q ∧ ∃ a : A, j a = j g * b) → (∀ q : Ideal A, q.IsPrime → q ≠ IsLocalRing.maximalIdeal A → ∀ a : A, j a = 0 → ∃ g : A, g ∉ q ∧ g * a = 0) → Function.Injective j ∧ ∃ d : A, d ∈ IsLocalRing.maximalIdeal A ∧ d ∈ nonZeroDivisors A ∧ j d ∈ nonZeroDivisors B ∧ ∀ b : B, ∃ a : A, j a = j d * b :=
by
  intro A B _ _ _ _ _ j hfin hdim hmin hdom hcomap hsurj hinj
  classical

  have s1 : ∀ (R : Type u) [CommRing R] [IsReduced R] (x : R),
      (∀ q ∈ minimalPrimes R, x ∈ q) → x = 0 := by
    intro R _ _ x hx
    have h1 : x ∈ sInf (minimalPrimes R) := Ideal.mem_sInf.mpr (fun {q} hq => hx q hq)
    have h2 : sInf (minimalPrimes R) = (⊥ : Ideal R) := by
      show sInf ((⊥ : Ideal R).minimalPrimes) = ⊥
      rw [Ideal.sInf_minimalPrimes, Ideal.radical_bot_of_isReduced]
    rw [h2] at h1
    exact (Ideal.mem_bot).mp h1
  have hminA : ∀ q ∈ minimalPrimes A, q.IsPrime ∧ q ≠ IsLocalRing.maximalIdeal A := by
    intro q hq
    exact ⟨Ideal.minimalPrimes_isPrime hq, fun h => hmin (h ▸ hq)⟩

  have hjinj : Function.Injective j := by
    rw [injective_iff_map_eq_zero]
    intro a ha
    apply s1 A a
    intro q hq
    obtain ⟨hqp, hqm⟩ := hminA q hq
    obtain ⟨g, hg, hga⟩ := hinj q hqp hqm a ha
    have : g * a ∈ q := by rw [hga]; exact q.zero_mem
    exact (hqp.mem_or_mem this).resolve_left hg

  have hcond : ∃ k : ℕ, k ≠ 0 ∧ ∀ d ∈ IsLocalRing.maximalIdeal A ^ k, ∀ b : B,
      ∃ a : A, j a = j d * b := by
    letI := j.toAlgebra
    have hmod : Module.Finite A B := hfin
    obtain ⟨n, s, hs⟩ := Module.Finite.exists_fin (R := A) (M := B)
    let I : Ideal A :=
      { carrier := {g | ∀ b : B, ∃ a : A, j a = j g * b}
        zero_mem' := fun b => ⟨0, by simp⟩
        add_mem' := fun {g₁ g₂} h₁ h₂ b => by
          obtain ⟨a₁, ha₁⟩ := h₁ b
          obtain ⟨a₂, ha₂⟩ := h₂ b
          exact ⟨a₁ + a₂, by rw [map_add, map_add, ha₁, ha₂, add_mul]⟩
        smul_mem' := fun c {g} h b => by
          obtain ⟨a, ha⟩ := h b
          exact ⟨c * a, by rw [smul_eq_mul, map_mul, map_mul, ha, mul_assoc]⟩ }
    have hkey : ∀ q : Ideal A, q.IsPrime → q ≠ IsLocalRing.maximalIdeal A → ∃ g ∈ I, g ∉ q := by
      intro q hq hqm
      choose g hg a ha using fun i : Fin n => hsurj q hq hqm (s i)
      refine ⟨∏ i, g i, ?_, ?_⟩
      · intro b
        let N : Submodule A B :=
          { carrier := {b' | ∃ a : A, j a = j (∏ i, g i) * b'}
            zero_mem' := ⟨0, by simp⟩
            add_mem' := fun {x y} hx hy => by
              obtain ⟨a₁, ha₁⟩ := hx
              obtain ⟨a₂, ha₂⟩ := hy
              exact ⟨a₁ + a₂, by rw [map_add, ha₁, ha₂, mul_add]⟩
            smul_mem' := fun c {x} hx => by
              obtain ⟨a₁, ha₁⟩ := hx
              refine ⟨c * a₁, ?_⟩
              rw [Algebra.smul_def, RingHom.algebraMap_toAlgebra, map_mul, ha₁]
              ring }
        have hsN : Submodule.span A (Set.range s) ≤ N := by
          rw [Submodule.span_le]
          rintro _ ⟨i, rfl⟩
          refine ⟨(∏ k ∈ Finset.univ.erase i, g k) * a i, ?_⟩
          rw [← Finset.mul_prod_erase Finset.univ g (Finset.mem_univ i)]
          simp only [map_mul]
          rw [ha i]
          ring
        rw [hs] at hsN
        exact hsN (Submodule.mem_top : b ∈ (⊤ : Submodule A B))
      · intro hmem
        obtain ⟨i, -, hi⟩ := (hq.prod_mem_iff).mp hmem
        exact hg i hi
    have hrad : IsLocalRing.maximalIdeal A ≤ I.radical := by
      rw [Ideal.radical_eq_sInf]
      intro x hx
      rw [Ideal.mem_sInf]
      rintro J ⟨hIJ, hJ⟩
      by_cases hJm : J = IsLocalRing.maximalIdeal A
      · rw [hJm]; exact hx
      · obtain ⟨g, hgI, hgJ⟩ := hkey J hJ hJm
        exact absurd (hIJ hgI) hgJ
    obtain ⟨n₀, hn₀⟩ :=
      Ideal.exists_pow_le_of_le_radical_of_fg hrad (IsNoetherian.noetherian _)
    refine ⟨n₀ + 1, Nat.succ_ne_zero _, fun d hd b => ?_⟩
    have hdI : d ∈ I := ((Ideal.pow_le_pow_right (Nat.le_succ n₀)).trans hn₀) hd
    exact (show ∀ b : B, ∃ a : A, j a = j d * b from hdI) b

  have havoid : ∀ k : ℕ, ∃ d ∈ IsLocalRing.maximalIdeal A ^ k, ∀ q ∈ minimalPrimes A, d ∉ q := by
    intro k
    by_contra hcon
    push_neg at hcon
    have hF := minimalPrimes.finite_of_isNoetherianRing A
    have hsub : ((IsLocalRing.maximalIdeal A ^ k : Ideal A) : Set A) ⊆
        ⋃ q ∈ (hF.toFinset : Set (Ideal A)), ((id q : Ideal A) : Set A) := by
      intro x hx
      obtain ⟨q, hq, hxq⟩ := hcon x hx
      exact Set.mem_biUnion (x := q) (by simpa using hq) hxq
    obtain ⟨q, hq, hle⟩ := (Ideal.subset_union_prime (f := id) (⊥ : Ideal A) ⊥
      (fun i hi _ _ => Ideal.minimalPrimes_isPrime (hF.mem_toFinset.mp hi))).mp hsub
    have hq' : q ∈ minimalPrimes A := hF.mem_toFinset.mp hq
    have hqp : q.IsPrime := Ideal.minimalPrimes_isPrime hq'
    have hmq : IsLocalRing.maximalIdeal A ≤ q := hqp.le_of_pow_le hle
    have heq : IsLocalRing.maximalIdeal A = q :=
      (IsLocalRing.maximalIdeal.isMaximal A).eq_of_le hqp.ne_top hmq
    exact hmin (heq ▸ hq')

  haveI hBred : IsReduced B := isReduced_ofLocalizationMaximal B (fun J hJ => by
    haveI := hJ.isPrime; haveI := hdom J; infer_instance)
  haveI : Ring.KrullDimLE 1 A := Ring.krullDimLE_iff.mpr (by exact_mod_cast hdim)
  have himg : ∀ d : A, (∀ q ∈ minimalPrimes A, d ∉ q) → j d ∈ nonZeroDivisors B := by
    intro d hd
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    apply s1 B x
    intro Q hQ
    have hQp : Q.IsPrime := Ideal.minimalPrimes_isPrime hQ
    have hPp : (Q.comap j).IsPrime := Ideal.IsPrime.comap j
    rcases Ring.krullDimLE_one_iff.mp inferInstance (Q.comap j) hPp with h | h
    · have hdQ : j d ∉ Q := fun h' => hd _ h (Ideal.mem_comap.mpr h')
      have : x * j d ∈ Q := by rw [hx]; exact Q.zero_mem
      exact (hQp.mem_or_mem this).resolve_right hdQ
    · exact absurd (IsLocalRing.eq_maximalIdeal h) (hcomap Q hQ)
  obtain ⟨k, hk0, hk⟩ := hcond
  obtain ⟨d, hdk, hdav⟩ := havoid k
  refine ⟨hjinj, d, Ideal.pow_le_self hk0 hdk, ?_, himg d hdav, hk d hdk⟩
  rw [mem_nonZeroDivisors_iff_right]
  intro x hx
  apply s1 A x
  intro q hq
  have hqp := Ideal.minimalPrimes_isPrime hq
  have : x * d ∈ q := by rw [hx]; exact q.zero_mem
  exact (hqp.mem_or_mem this).resolve_right (hdav q hq)

theorem wcpa_dj_nf_nodes_closed_finite : ∀ (Ω : Type u) [Field Ω] (C : Scheme.{u}) (c : C ⟶ Spec (.of Ω)) (U : C.Opens), IsProper c → (∀ w : C, w ∉ U → ∀ a : C.presheaf.stalk w, ∃ z : Ω, a - ((Scheme.ΓSpecIso (.of Ω)).inv ≫ c.appTop ≫ C.presheaf.germ ⊤ w trivial).hom z ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk w)) → (∀ w : C, w ∉ U → IsClosed ({w} : Set C)) ∧ ((U : Set C)ᶜ).Finite :=
by
  intro Ω _ C c U hprop hres
  haveI := hprop
  haveI : IsLocallyNoetherian C := LocallyOfFiniteType.isLocallyNoetherian c
  haveI : CompactSpace C := QuasiCompact.compactSpace_of_compactSpace c
  haveI : AlgebraicGeometry.IsNoetherian C := ⟨⟩
  haveI : JacobsonSpace C := LocallyOfFiniteType.jacobsonSpace c
  have hcl : ∀ w : C, w ∉ U → IsClosed ({w} : Set C) := by
    intro w hw
    obtain ⟨V, hV, hwV, -⟩ :=
      exists_isAffineOpen_mem_and_subset (show w ∈ (⊤ : C.Opens) from trivial)
    obtain ⟨y, hyw⟩ : ∃ y : PrimeSpectrum Γ(C, V), hV.fromSpec y = w :=
      ⟨_, hV.fromSpec_primeIdealOf ⟨w, hwV⟩⟩
    have hmem : ∀ r : Γ(C, V), r ∈ y.asIdeal ↔
        (C.presheaf.germ V w hwV).hom r ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk w) := by
      intro r
      have h1 : y ∈ hV.fromSpec ⁻¹ᵁ C.basicOpen r ↔ y ∈ PrimeSpectrum.basicOpen r := by
        rw [hV.fromSpec_preimage_basicOpen]; exact Iff.rfl
      have h2 : y ∈ hV.fromSpec ⁻¹ᵁ C.basicOpen r ↔ w ∈ C.basicOpen r := by
        rw [← hyw]; exact Iff.rfl
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, ← Scheme.mem_basicOpen C r w hwV, ← h2, h1,
        PrimeSpectrum.mem_basicOpen, not_not]
    obtain ⟨ρ, hρ⟩ : ∃ ρ : Ω →+* Γ(C, V), ∀ z, (C.presheaf.germ V w hwV).hom (ρ z) =
        ((Scheme.ΓSpecIso (.of Ω)).inv ≫ c.appTop ≫ C.presheaf.germ ⊤ w trivial).hom z := by
      refine ⟨((Scheme.ΓSpecIso (.of Ω)).inv ≫ c.appTop ≫
        C.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom, fun z => ?_⟩
      have := TopCat.Presheaf.germ_res C.presheaf (homOfLE (le_top : V ≤ ⊤)) w hwV
      rw [← this]
      rfl
    have hmax : y.asIdeal.IsMaximal := by
      rw [Ideal.isMaximal_iff]
      refine ⟨fun h1 => y.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1), ?_⟩
      intro J x hle hxp hxJ
      obtain ⟨z, hz⟩ := hres w hw ((C.presheaf.germ V w hwV).hom x)
      rw [← hρ z, ← map_sub, ← hmem] at hz
      have hz0 : z ≠ 0 := by
        rintro rfl
        apply hxp
        simpa using hz
      have key : x * ρ z⁻¹ - 1 = (x - ρ z) * ρ z⁻¹ := by
        have : ρ z * ρ z⁻¹ = 1 := by rw [← map_mul, mul_inv_cancel₀ hz0, map_one]
        linear_combination this
      have h2 : x * ρ z⁻¹ - 1 ∈ J := hle (key ▸ y.asIdeal.mul_mem_right _ hz)
      have h3 : x * ρ z⁻¹ ∈ J := J.mul_mem_right _ hxJ
      have := J.sub_mem h3 h2
      simpa using this
    apply isClosed_singleton_of_isLocallyClosed_singleton
    refine ⟨(V : Set C), closure {w}, V.isOpen, isClosed_closure, ?_⟩
    ext v
    simp only [Set.mem_singleton_iff, Set.mem_inter_iff]
    constructor
    · rintro rfl; exact ⟨hwV, subset_closure rfl⟩
    · rintro ⟨hvV, hvc⟩
      have hsp : w ⤳ v := specializes_iff_mem_closure.mpr hvc
      obtain ⟨y', rfl⟩ : v ∈ Set.range hV.fromSpec := by rw [hV.range_fromSpec]; exact hvV
      rw [← hyw] at hsp
      have hind := (hV.fromSpec.isOpenEmbedding).isInducing
      have hsp' : y ⤳ y' := hind.specializes_iff.mp hsp
      have hle : y.asIdeal ≤ (y' : PrimeSpectrum Γ(C, V)).asIdeal :=
        (PrimeSpectrum.le_iff_specializes y y').mpr hsp'
      have := hmax.eq_of_le (y' : PrimeSpectrum Γ(C, V)).isPrime.ne_top hle
      rw [← hyw]
      congr 1
      exact (PrimeSpectrum.ext this).symm
  refine ⟨hcl, ?_⟩
  obtain ⟨S, hSf, hSc, hSi, hSeq⟩ :=
    TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible U.isOpen.isClosed_compl
  rw [hSeq]
  refine hSf.sUnion fun t ht => ?_
  have hcl' := hSc t ht
  have hirr := hSi t ht
  have hg := hirr.isGenericPoint_genericPoint hcl'
  have hgZ : hirr.genericPoint ∈ (U : Set C)ᶜ := hSeq ▸ Set.mem_sUnion_of_mem hg.mem ht
  rw [← hg.def, (hcl _ hgZ).closure_eq]
  exact Set.finite_singleton _

theorem wcpa_dj_nf_node_dim_le_one : ∀ (Ω : Type u) [Field Ω] (C : Scheme.{u}) (c : C ⟶ Spec (.of Ω)) (U : C.Opens), LocallyOfFiniteType c → (∀ w : C, w ∈ U ↔ ∃ W : C.Opens, w ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ c)) → (∀ w : C, w ∉ U → IsClosed ({w} : Set C)) → ∀ p : C, p ∉ U → ringKrullDim (C.presheaf.stalk p) ≤ 1 :=
by
  intro Ω _ C c U hlft hU hcl p hp
  haveI := hlft
  by_contra hdim

  have hchain : ∃ w₁ w₂ : C, w₂ ⤳ w₁ ∧ w₁ ⤳ p ∧ w₂ ≠ w₁ ∧ w₁ ≠ p := by
    have h1 : ¬ Order.krullDim (PrimeSpectrum (C.presheaf.stalk p)) ≤ 1 := hdim
    rw [Order.krullDim_le_one_iff] at h1
    push_neg at h1
    obtain ⟨x, hxmin, hxmax⟩ := h1
    obtain ⟨a, hax⟩ := not_isMin_iff.mp hxmin
    obtain ⟨b, hxb⟩ := not_isMax_iff.mp hxmax
    have hinj : Function.Injective (C.fromSpecStalk p) :=
      (C.fromSpecStalk p).isEmbedding.injective
    have hbm : b ≤ IsLocalRing.closedPoint (C.presheaf.stalk p) :=
      (PrimeSpectrum.le_iff_specializes _ _).mpr (IsLocalRing.specializes_closedPoint b)
    have hxm : x ≠ IsLocalRing.closedPoint (C.presheaf.stalk p) := (lt_of_lt_of_le hxb hbm).ne
    refine ⟨C.fromSpecStalk p x, C.fromSpecStalk p a, ?_, ?_, ?_, ?_⟩
    · exact ((PrimeSpectrum.le_iff_specializes _ _).mp hax.le).map
        (C.fromSpecStalk p).continuous
    · have := (IsLocalRing.specializes_closedPoint x).map (C.fromSpecStalk p).continuous
      rwa [Scheme.fromSpecStalk_closedPoint] at this
    · exact fun h => hax.ne (hinj h)
    · intro h
      apply hxm
      apply hinj
      rw [h, Scheme.fromSpecStalk_closedPoint]
  obtain ⟨w₁, w₂, h21, h1p, hne21, hne1p⟩ := hchain

  have hw₁nc : ¬ IsClosed ({w₁} : Set C) := by
    intro h
    have hmem : p ∈ closure ({w₁} : Set C) := specializes_iff_mem_closure.mp h1p
    rw [h.closure_eq] at hmem
    exact hne1p (Set.mem_singleton_iff.mp hmem).symm
  have hw₁U : w₁ ∈ U := by
    by_contra h
    exact hw₁nc (hcl w₁ h)
  obtain ⟨W, hw₁W, hWsm⟩ := (hU w₁).1 hw₁U

  haveI : JacobsonSpace C := LocallyOfFiniteType.jacobsonSpace c
  have hz : ∃ z : C, z ∈ W ∧ IsClosed ({z} : Set C) ∧ w₁ ⤳ z := by
    have hT := closure_inter_closedPoints (isClosed_closure (s := ({w₁} : Set C)))
    have hw : w₁ ∈ closure (closure ({w₁} : Set C) ∩ closedPoints C) := by
      rw [hT]; exact subset_closure rfl
    obtain ⟨z, hzW, hzT, hzc⟩ := (mem_closure_iff.mp hw) (W : Set C) W.isOpen hw₁W
    exact ⟨z, hzW, mem_closedPoints_iff.mp hzc, specializes_iff_mem_closure.mpr hzT⟩
  obtain ⟨z, hzW, hzcl, h1z⟩ := hz
  have hne1z : w₁ ≠ z := by
    rintro rfl
    exact hw₁nc hzcl

  have hbig : ¬ ringKrullDim (C.presheaf.stalk z) ≤ 1 := by
    intro hle
    have hle' : Order.krullDim (PrimeSpectrum (C.presheaf.stalk z)) ≤ 1 := hle
    rw [Order.krullDim_le_one_iff] at hle'
    have hr1 : w₁ ∈ Set.range (C.fromSpecStalk z) := by
      rw [Scheme.range_fromSpecStalk]; exact h1z
    have hr2 : w₂ ∈ Set.range (C.fromSpecStalk z) := by
      rw [Scheme.range_fromSpecStalk]; exact h21.trans h1z
    obtain ⟨a', ha'⟩ : ∃ a' : PrimeSpectrum (C.presheaf.stalk z), C.fromSpecStalk z a' = w₁ := hr1
    obtain ⟨a'', ha''⟩ : ∃ a'' : PrimeSpectrum (C.presheaf.stalk z),
      C.fromSpecStalk z a'' = w₂ := hr2
    have hemb := (C.fromSpecStalk z).isEmbedding
    have hlt1 : a'' < a' := by
      refine lt_of_le_of_ne ((PrimeSpectrum.le_iff_specializes a'' a').mpr ?_) ?_
      · exact hemb.isInducing.specializes_iff.mp (by rw [ha', ha'']; exact h21)
      · intro h
        apply hne21
        rw [← ha', ← ha'', h]
    have hlt2 : a' < IsLocalRing.closedPoint (C.presheaf.stalk z) := by
      refine lt_of_le_of_ne ((PrimeSpectrum.le_iff_specializes _ _).mpr
        (IsLocalRing.specializes_closedPoint a')) ?_
      intro h
      apply hne1z
      rw [← ha', h, Scheme.fromSpecStalk_closedPoint]
    rcases hle' a' with h | h
    · exact (not_isMin_iff.mpr ⟨a'', hlt1⟩) h
    · exact (not_isMax_iff.mpr ⟨_, hlt2⟩) h

  haveI := hWsm
  let z' : (W : Scheme.{u}) := ⟨z, hzW⟩
  have hz'cl : IsClosed ({z'} : Set (W : Scheme.{u})) := by
    have hset : ({z'} : Set (W : Scheme.{u})) = W.ι ⁻¹' {z} := by
      ext y
      rw [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_singleton_iff]
      constructor
      · intro h
        rw [h]
        first | rfl | simp [z']
      · intro h
        apply Subtype.ext
        first | exact h | simpa using h
    rw [hset]
    exact hzcl.preimage W.ι.continuous
  have hd := wc_lfi_smooth_stalk_dim Ω W (W.ι ≫ c) 1 z' hz'cl
  have he := (W.stalkIso z').commRingCatIsoToRingEquiv.ringKrullDim
  rw [he] at hd
  exact hbig (le_of_eq (by rw [hd]; rfl))

theorem wcpa_dj_nf_loc_map : ∀ (C Ct : Scheme.{u}) (ν : Ct ⟶ C) (V : C.Opens) (hV : IsAffineOpen V) (p : C) (hp : p ∈ V), IsFinite ν → ∃ j : C.presheaf.stalk p →+* Localization (Submonoid.map (ν.app V).hom (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl), j.comp (C.presheaf.germ V p hp).hom = (algebraMap Γ(Ct, ν ⁻¹ᵁ V) (Localization (Submonoid.map (ν.app V).hom (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl))).comp (ν.app V).hom ∧ j.Finite :=
by
  intro C Ct ν V hV p hp hfin
  haveI := hfin
  letI : Algebra Γ(C, V) (C.presheaf.stalk p) := (C.presheaf.germ V p hp).hom.toAlgebra
  haveI : IsLocalization.AtPrime (C.presheaf.stalk p) (hV.primeIdealOf ⟨p, hp⟩).asIdeal :=
    hV.isLocalization_stalk ⟨p, hp⟩
  refine ⟨IsLocalization.map (S := C.presheaf.stalk p)
      (M := (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl)
      (T := Submonoid.map (ν.app V).hom (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl)
      (Localization (Submonoid.map (ν.app V).hom
      (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl)) (ν.app V).hom
      (Submonoid.le_comap_map _), ?_, ?_⟩
  · exact IsLocalization.map_comp _
  · exact RingHom.finite_localizationPreserves (ν.app V).hom
      (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl (C.presheaf.stalk p)
      (Localization (Submonoid.map (ν.app V).hom (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl))
      (IsFinite.finite_app ν V hV)

theorem wcpa_dj_nf_loc_normal : ∀ (C Ct : Scheme.{u}) (ν : Ct ⟶ C) (V : C.Opens) (hV : IsAffineOpen V) (p : C) (hp : p ∈ V), IsFinite ν → (∀ x : Ct, IsDomain (Ct.presheaf.stalk x) ∧ IsIntegrallyClosed (Ct.presheaf.stalk x)) → ∀ (Q : Ideal (Localization (Submonoid.map (ν.app V).hom (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl))) [Q.IsPrime], IsDomain (Localization.AtPrime Q) ∧ IsIntegrallyClosed (Localization.AtPrime Q) :=
by
  intro C Ct ν V hV p hp hfin hnorm Q _
  have hW : IsAffineOpen (ν ⁻¹ᵁ V) := hV.preimage ν
  let Q₀ : Ideal Γ(Ct, ν ⁻¹ᵁ V) := Ideal.comap (algebraMap _ (Localization
    (Submonoid.map (ν.app V).hom (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl))) Q
  have hQ₀ : Q₀.IsPrime := Ideal.comap_isPrime _ Q
  let y : PrimeSpectrum Γ(Ct, ν ⁻¹ᵁ V) := ⟨Q₀, hQ₀⟩
  have hx : hW.fromSpec y ∈ ν ⁻¹ᵁ V := by
    rw [← SetLike.mem_coe, ← hW.range_fromSpec]
    exact ⟨y, rfl⟩
  have hloc := hW.isLocalization_stalk' y hx
  let e₁ := IsLocalization.localizationLocalizationAtPrimeIsoLocalization
    (Submonoid.map (ν.app V).hom (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl) Q
  have key : ∀ (alg : Algebra Γ(Ct, ν ⁻¹ᵁ V) (Ct.presheaf.stalk (hW.fromSpec y))),
      @IsLocalization.AtPrime Γ(Ct, ν ⁻¹ᵁ V) _ (Ct.presheaf.stalk (hW.fromSpec y)) _ alg Q₀ _ →
      Nonempty (Localization.AtPrime Q₀ ≃+* Ct.presheaf.stalk (hW.fromSpec y)) :=
    fun alg h => ⟨(@IsLocalization.algEquiv _ _ Q₀.primeCompl (Localization.AtPrime Q₀) _ _ _
      (Ct.presheaf.stalk (hW.fromSpec y)) _ alg h).toRingEquiv⟩
  obtain ⟨e₂⟩ := key _ hloc
  let e : Localization.AtPrime Q ≃+* Ct.presheaf.stalk (hW.fromSpec y) :=
    e₁.symm.toRingEquiv.trans e₂
  obtain ⟨h1, h2⟩ := hnorm (hW.fromSpec y)
  exact ⟨MulEquiv.isDomain _ e.toMulEquiv, IsIntegrallyClosed.of_equiv e.symm⟩

theorem wcpa_dj_nf_loc_generic : ∀ (C Ct : Scheme.{u}) (ν : Ct ⟶ C) (U V : C.Opens) (hV : IsAffineOpen V) (p : C) (hp : p ∈ V) (j : C.presheaf.stalk p →+* Localization (Submonoid.map (ν.app V).hom (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl)), IsFinite ν → Surjective ν → p ∉ U → (∀ x : Ct, ∃ x' : Ct, x' ⤳ x ∧ ν x' ∈ U) → j.comp (C.presheaf.germ V p hp).hom = (algebraMap Γ(Ct, ν ⁻¹ᵁ V) (Localization (Submonoid.map (ν.app V).hom (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl))).comp (ν.app V).hom → IsLocalRing.maximalIdeal (C.presheaf.stalk p) ∉ minimalPrimes (C.presheaf.stalk p) ∧ ∀ Q ∈ minimalPrimes (Localization (Submonoid.map (ν.app V).hom (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl)), Ideal.comap j Q ≠ IsLocalRing.maximalIdeal (C.presheaf.stalk p) :=
by
  intro C Ct ν U V hV p hp j hfin hsurj hpU hgen hj
  classical

  have s1 : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] (M : Submonoid R)
      [IsLocalization M S] (Q : Ideal S) (P' : Ideal R), Q.IsPrime → P'.IsPrime →
      P' ≤ Q.comap (algebraMap R S) → P' ≠ Q.comap (algebraMap R S) → Q ∉ minimalPrimes S := by
    intro R S _ _ _ M _ Q P' hQp hP' hle hne hQ
    have hQ' : Minimal Ideal.IsPrime Q := by
      rw [minimalPrimes_eq_minimals] at hQ; exact hQ
    have hdisj : Disjoint (M : Set R) (P' : Set R) := by
      rw [Set.disjoint_left]
      intro m hmM hmP
      have h1 : algebraMap R S m ∈ Q := hle hmP
      exact hQp.ne_top (Ideal.eq_top_of_isUnit_mem _ h1 (IsLocalization.map_units S ⟨m, hmM⟩))
    have hQ'p := IsLocalization.isPrime_of_isPrime_disjoint M S P' hP' hdisj
    have hQ'le : Ideal.map (algebraMap R S) P' ≤ Q := Ideal.map_le_iff_le_comap.mpr hle
    have heq : Q = Ideal.map (algebraMap R S) P' := (hQ'.eq_of_le hQ'p hQ'le).symm
    have hu := IsLocalization.under_map_of_isPrime_disjoint M S hP' hdisj
    rw [Ideal.under_def, ← heq] at hu
    exact hne hu.symm

  have s2 : ∀ (X : Scheme.{u}) (W : X.Opens) (hW : IsAffineOpen W) (P P' : PrimeSpectrum Γ(X, W)),
      hW.fromSpec P' ⤳ hW.fromSpec P → hW.fromSpec P' ≠ hW.fromSpec P →
      P'.asIdeal ≤ P.asIdeal ∧ P'.asIdeal ≠ P.asIdeal := by
    intro X W hW P P' hsp hne
    haveI := hW.isOpenImmersion_fromSpec
    have hind : Topology.IsInducing hW.fromSpec := hW.fromSpec.isOpenEmbedding.isInducing
    have hsp' : P' ⤳ P := hind.specializes_iff.mp hsp
    refine ⟨(PrimeSpectrum.le_iff_specializes P' P).mpr hsp', ?_⟩
    intro h
    apply hne
    rw [PrimeSpectrum.ext h]

  have s3 : ∀ (hW : IsAffineOpen (ν ⁻¹ᵁ V)) (P : PrimeSpectrum Γ(Ct, ν ⁻¹ᵁ V)),
      ν (hW.fromSpec P) = hV.fromSpec (PrimeSpectrum.comap (ν.app V).hom P) := by
    intro hW P
    have h := IsAffineOpen.SpecMap_appLE_fromSpec ν hV hW (le_refl _)
    have h2 : hV.fromSpec (Spec.map (ν.appLE V (ν ⁻¹ᵁ V) (le_refl _)) (show ↥(Spec Γ(Ct, ν ⁻¹ᵁ V)) from P)) =
        ν (hW.fromSpec P) := by
      rw [← Scheme.Hom.comp_apply, h, Scheme.Hom.comp_apply]
    rw [← Scheme.Hom.app_eq_appLE, Spec.map_apply] at h2
    exact h2.symm

  haveI := hfin
  haveI := hsurj
  have hW : IsAffineOpen (ν ⁻¹ᵁ V) := hV.preimage ν
  have h𝔭 : hV.fromSpec (hV.primeIdealOf ⟨p, hp⟩) = p := hV.fromSpec_primeIdealOf ⟨p, hp⟩
  letI : Algebra Γ(C, V) (C.presheaf.stalk p) :=
    TopCat.Presheaf.algebra_section_stalk C.presheaf ⟨p, hp⟩
  haveI hloc : IsLocalization.AtPrime (C.presheaf.stalk p) (hV.primeIdealOf ⟨p, hp⟩).asIdeal :=
    hV.isLocalization_stalk ⟨p, hp⟩
  have hm : (IsLocalRing.maximalIdeal (C.presheaf.stalk p)).comap (C.presheaf.germ V p hp).hom =
      (hV.primeIdealOf ⟨p, hp⟩).asIdeal := by
    have := IsLocalization.AtPrime.under_maximalIdeal (C.presheaf.stalk p)
      (hV.primeIdealOf ⟨p, hp⟩).asIdeal
    rw [Ideal.under_def] at this
    exact this
  constructor
  ·
    obtain ⟨x, hx⟩ := ν.surjective p
    obtain ⟨x', hx'x, hx'U⟩ := hgen x
    have hwp : ν x' ⤳ p := by
      have := hx'x.map ν.continuous
      rw [hx] at this
      exact this
    have hwV : ν x' ∈ V := hwp.mem_open V.isOpen hp
    have hne : ν x' ≠ p := fun h => hpU (by rw [← h]; exact hx'U)
    have h𝔮 : hV.fromSpec (hV.primeIdealOf ⟨ν x', hwV⟩) = ν x' :=
      hV.fromSpec_primeIdealOf ⟨ν x', hwV⟩
    obtain ⟨hle, hne'⟩ := s2 C V hV (hV.primeIdealOf ⟨p, hp⟩) (hV.primeIdealOf ⟨ν x', hwV⟩)
      (by rw [h𝔮, h𝔭]; exact hwp) (by rw [h𝔮, h𝔭]; exact hne)
    exact s1 Γ(C, V) (C.presheaf.stalk p) (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl
      (IsLocalRing.maximalIdeal _) _ inferInstance inferInstance
      (le_of_le_of_eq hle hm.symm) (fun h => hne' (h.trans hm))
  ·
    intro Q hQ hQm
    have hQp : Q.IsPrime := by
      rw [minimalPrimes_eq_minimals] at hQ; exact hQ.prop
    have hQ₀p : (Q.comap (algebraMap Γ(Ct, ν ⁻¹ᵁ V)
        (Localization (Submonoid.map (ν.app V).hom (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl)))).IsPrime :=
      Ideal.IsPrime.comap _
    let PQ : PrimeSpectrum Γ(Ct, ν ⁻¹ᵁ V) := ⟨_, hQ₀p⟩
    have hQ0 : PQ.asIdeal.comap (ν.app V).hom = (hV.primeIdealOf ⟨p, hp⟩).asIdeal := by
      show Ideal.comap (ν.app V).hom (Ideal.comap (algebraMap _ _) Q) = _
      rw [Ideal.comap_comap, ← hj, ← Ideal.comap_comap, hQm, hm]
    have hcomap : PrimeSpectrum.comap (ν.app V).hom PQ = hV.primeIdealOf ⟨p, hp⟩ :=
      PrimeSpectrum.ext hQ0
    have hx : ν (hW.fromSpec PQ) = p := by rw [s3 hW PQ, hcomap, h𝔭]
    obtain ⟨x', hx'x, hx'U⟩ := hgen (hW.fromSpec PQ)
    have hxW : hW.fromSpec PQ ∈ ν ⁻¹ᵁ V := by
      show ν (hW.fromSpec PQ) ∈ V
      rw [hx]; exact hp
    have hx'W : x' ∈ ν ⁻¹ᵁ V := hx'x.mem_open (ν ⁻¹ᵁ V).isOpen hxW
    obtain ⟨P', rfl⟩ : x' ∈ Set.range hW.fromSpec := by rw [hW.range_fromSpec]; exact hx'W
    have hne : hW.fromSpec P' ≠ hW.fromSpec PQ := by
      intro h; apply hpU; rw [← hx, ← h]; exact hx'U
    obtain ⟨hle, hne'⟩ := s2 Ct (ν ⁻¹ᵁ V) hW PQ P' hx'x hne
    exact s1 Γ(Ct, ν ⁻¹ᵁ V) _ (Submonoid.map (ν.app V).hom (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl)
      Q P'.asIdeal hQp P'.isPrime hle hne' hQ

theorem wcpa_dj_nf_loc_iso : ∀ (C Ct : Scheme.{u}) (ν : Ct ⟶ C) (U V : C.Opens) (hV : IsAffineOpen V) (p : C) (hp : p ∈ V) (j : C.presheaf.stalk p →+* Localization (Submonoid.map (ν.app V).hom (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl)), IsFinite ν → IsIso (ν ∣_ U) → (∀ w : C, w ∉ U → IsClosed ({w} : Set C)) → j.comp (C.presheaf.germ V p hp).hom = (algebraMap Γ(Ct, ν ⁻¹ᵁ V) (Localization (Submonoid.map (ν.app V).hom (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl))).comp (ν.app V).hom → (∀ q : Ideal (C.presheaf.stalk p), q.IsPrime → q ≠ IsLocalRing.maximalIdeal (C.presheaf.stalk p) → ∀ b : Localization (Submonoid.map (ν.app V).hom (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl), ∃ g : C.presheaf.stalk p, g ∉ q ∧ ∃ a : C.presheaf.stalk p, j a = j g * b) ∧ (∀ q : Ideal (C.presheaf.stalk p), q.IsPrime → q ≠ IsLocalRing.maximalIdeal (C.presheaf.stalk p) → ∀ a : C.presheaf.stalk p, j a = 0 → ∃ g : C.presheaf.stalk p, g ∉ q ∧ g * a = 0) :=
by
  have s6 : ∀ (A₀ B₀ A : Type u) [CommRing A₀] [CommRing B₀] [CommRing A] (ι : A₀ →+* A) (f : A₀ →+* B₀) (T : Submonoid A₀) (j : A →+* Localization (Submonoid.map f T)) (g₀ : A₀) (q : Ideal A) (hq : q.IsPrime) (hunit : ∀ t ∈ T, IsUnit (ι t)) (hsurj : ∀ a : A, ∃ a₀ : A₀, ∃ t ∈ T, a * ι t = ι a₀) (hj : j.comp ι = (algebraMap B₀ (Localization (Submonoid.map f T))).comp f) (hg : ι g₀ ∉ q) (hcond : ∀ s : B₀, ∃ (N : ℕ) (a₀ : A₀), f (g₀ ^ N) * s = f a₀) (htors : ∀ a₀ : A₀, f a₀ = 0 → ∃ n : ℕ, g₀ ^ n * a₀ = 0), (∀ b : Localization (Submonoid.map f T), ∃ g : A, g ∉ q ∧ ∃ a : A, j a = j g * b) ∧ (∀ a : A, j a = 0 → ∃ g : A, g ∉ q ∧ g * a = 0) := by
    intro A₀ B₀ A _ _ _ ι f T j g₀ q hq hunit hsurj hj hg hcond htors
    have hj' : ∀ x, j (ι x) = algebraMap B₀ _ (f x) := fun x => RingHom.congr_fun hj x
    have hP1 : ∀ t ∈ T, ι t ∉ q := fun t ht h => hq.ne_top (Ideal.eq_top_of_isUnit_mem _ h (hunit t ht))
    have hP2 : ∀ k : ℕ, ι (g₀ ^ k) ∉ q := fun k h => hg (hq.mem_of_pow_mem k (by rwa [map_pow] at h))
    constructor
    · intro b
      obtain ⟨⟨s, m⟩, hb⟩ := IsLocalization.surj (Submonoid.map f T) b
      obtain ⟨t, ht, hmt⟩ := Submonoid.mem_map.mp m.2
      obtain ⟨N, a₀, hN⟩ := hcond s
      obtain ⟨u, hu⟩ := hunit t ht
      refine ⟨ι (g₀ ^ N), hP2 N, ι a₀ * ↑u⁻¹, ?_⟩
      have hunitj : IsUnit (j (ι t)) := (hunit t ht).map j
      apply (hunitj.mul_left_inj).mp
      simp only at hb
      rw [← map_mul, mul_assoc, ← hu, Units.inv_mul, mul_one, mul_assoc, hu, hj' t, hmt, hb, hj', hj',
        ← map_mul, hN]
    · intro a ha
      obtain ⟨a₀, t, ht, hat⟩ := hsurj a
      have h0 : algebraMap B₀ (Localization (Submonoid.map f T)) (f a₀) = 0 := by
        rw [← hj', ← hat, map_mul, ha, zero_mul]
      obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.map f T) _ (f a₀)).mp h0
      obtain ⟨u, hu, hmu⟩ := Submonoid.mem_map.mp m.2
      obtain ⟨n, hn⟩ := htors (u * a₀) (by rw [map_mul, hmu]; exact hm)
      refine ⟨ι (g₀ ^ n * u), ?_, ?_⟩
      · rw [map_mul]; intro h
        rcases hq.mem_or_mem h with h | h
        · exact hP2 n h
        · exact hP1 u hu h
      · apply (hunit t ht).mul_left_eq_zero.mp
        rw [mul_assoc, hat, ← map_mul, mul_assoc, hn, map_zero]
  have s1 : ∀ (C : Scheme.{u}) (V : C.Opens) (hV : IsAffineOpen V) (p : C) (hp : p ∈ V), (∀ t ∈ (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl, IsUnit ((C.presheaf.germ V p hp).hom t)) ∧ (∀ a : C.presheaf.stalk p, ∃ a₀ : Γ(C, V), ∃ t ∈ (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl, a * (C.presheaf.germ V p hp).hom t = (C.presheaf.germ V p hp).hom a₀) := by
    intro C V hV p hp
    letI : Algebra Γ(C, V) (C.presheaf.stalk p) := TopCat.Presheaf.algebra_section_stalk C.presheaf ⟨p, hp⟩
    have := hV.isLocalization_stalk ⟨p, hp⟩
    constructor
    · intro t ht
      exact IsLocalization.map_units (M := (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl) (C.presheaf.stalk p) ⟨t, ht⟩
    · intro a
      obtain ⟨⟨a₀, t⟩, h⟩ := IsLocalization.surj (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl a
      exact ⟨a₀, t, t.2, h⟩
  have s2 : ∀ (C : Scheme.{u}) (V : C.Opens) (hV : IsAffineOpen V) (p : C) (hp : p ∈ V), ∀ q : Ideal (C.presheaf.stalk p), q.IsPrime → q ≠ IsLocalRing.maximalIdeal (C.presheaf.stalk p) → Ideal.comap (C.presheaf.germ V p hp).hom q ≤ (hV.primeIdealOf ⟨p, hp⟩).asIdeal ∧ Ideal.comap (C.presheaf.germ V p hp).hom q ≠ (hV.primeIdealOf ⟨p, hp⟩).asIdeal := by
    intro C V hV p hp
    intro q hq hqm
    letI : Algebra Γ(C, V) (C.presheaf.stalk p) := TopCat.Presheaf.algebra_section_stalk C.presheaf ⟨p, hp⟩
    have := hV.isLocalization_stalk ⟨p, hp⟩
    obtain ⟨hunit, hsurj⟩ := s1 C V hV p hp
    have hm : Ideal.comap (C.presheaf.germ V p hp).hom (IsLocalRing.maximalIdeal _) = (hV.primeIdealOf ⟨p, hp⟩).asIdeal := by
      ext t
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      constructor
      · intro h; by_contra ht; exact h (hunit t ht)
      · intro ht hu
        exact ((IsLocalization.AtPrime.isUnit_to_map_iff (C.presheaf.stalk p) _ t).mp hu) ht
    have hle : Ideal.comap (C.presheaf.germ V p hp).hom q ≤ (hV.primeIdealOf ⟨p, hp⟩).asIdeal :=
      hm ▸ Ideal.comap_mono (IsLocalRing.le_maximalIdeal hq.ne_top)
    refine ⟨hle, fun heq => hqm ?_⟩
    apply le_antisymm (IsLocalRing.le_maximalIdeal hq.ne_top)
    intro x hx
    obtain ⟨a₀, t, ht, hxt⟩ := hsurj x
    have ha₀ : a₀ ∈ Ideal.comap (C.presheaf.germ V p hp).hom q := by
      rw [heq, ← hm, Ideal.mem_comap, ← hxt]; exact Ideal.mul_mem_right _ _ hx
    rw [Ideal.mem_comap, ← hxt] at ha₀
    rcases hq.mem_or_mem ha₀ with h | h
    · exact h
    · exact absurd (Ideal.eq_top_of_isUnit_mem _ h (hunit t ht)) hq.ne_top
  have s3 : ∀ (C : Scheme.{u}) (U V : C.Opens) (hV : IsAffineOpen V) (p : C) (hp : p ∈ V) (𝔮 : PrimeSpectrum Γ(C, V)) (hle : 𝔮.asIdeal ≤ (hV.primeIdealOf ⟨p, hp⟩).asIdeal) (hne : 𝔮.asIdeal ≠ (hV.primeIdealOf ⟨p, hp⟩).asIdeal) (hcl : ∀ w : C, w ∉ U → IsClosed ({w} : Set C)), ∃ g₀ : Γ(C, V), C.basicOpen g₀ ≤ U ∧ g₀ ∉ 𝔮.asIdeal := by
    intro C U V hV p hp 𝔮 hle hne hcl
    have hpeq : hV.fromSpec (hV.primeIdealOf ⟨p, hp⟩) = p := hV.fromSpec_primeIdealOf ⟨p, hp⟩
    have hspec : hV.fromSpec 𝔮 ⤳ p := by
      rw [← hpeq]
      exact ((PrimeSpectrum.le_iff_specializes _ _).mp hle).map hV.fromSpec.continuous
    have hwU : hV.fromSpec 𝔮 ∈ U := by
      by_contra hw
      have h1 := specializes_iff_mem_closure.mp hspec
      rw [(hcl _ hw).closure_eq] at h1
      apply hne
      have h2 := hV.fromSpec.isOpenEmbedding.injective (hpeq.trans h1)
      rw [← h2]
    have hwV : hV.fromSpec 𝔮 ∈ V := by
      have h4 : hV.fromSpec 𝔮 ∈ Set.range hV.fromSpec := ⟨𝔮, rfl⟩
      rw [hV.range_fromSpec] at h4
      exact h4
    obtain ⟨g₀, hg₀le, hwg⟩ := hV.exists_basicOpen_le (V := U ⊓ V) ⟨hV.fromSpec 𝔮, ⟨hwU, hwV⟩⟩ hwV
    refine ⟨g₀, le_trans hg₀le inf_le_left, ?_⟩
    have h3 : 𝔮 ∈ hV.fromSpec ⁻¹ᵁ C.basicOpen g₀ := hwg
    rw [hV.fromSpec_preimage_basicOpen] at h3
    exact h3
  have s4 : ∀ (C Ct : Scheme.{u}) (ν : Ct ⟶ C) (U D : C.Opens) (hiso : IsIso (ν ∣_ U)) (hDU : D ≤ U), Function.Bijective (ν.app D).hom := by
    intro C Ct ν U D hiso hDU
    have heq : U.ι ''ᵁ (U.ι ⁻¹ᵁ D) = D := by
      rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
      exact inf_eq_right.mpr hDU
    have hm : ∀ (X Y : Ct.Opens) (e : X = Y), IsIso (Ct.presheaf.map (eqToHom e).op) := by
      intro X Y e; subst e; rw [eqToHom_refl, op_id, CategoryTheory.Functor.map_id]; infer_instance
    have h1 : IsIso ((ν ∣_ U).app (U.ι ⁻¹ᵁ D)) := inferInstance
    rw [morphismRestrict_app] at h1
    have h3 : IsIso (ν.app (U.ι ''ᵁ U.ι ⁻¹ᵁ D)) :=
      @IsIso.of_isIso_comp_right _ _ _ _ _ _ _ (hm _ _ _) h1
    clear h1 hm
    revert h3
    generalize U.ι ''ᵁ (U.ι ⁻¹ᵁ D) = D' at heq ⊢
    subst heq
    intro h3
    exact ConcreteCategory.bijective_of_isIso _
  have s5 : ∀ (C Ct : Scheme.{u}) (ν : Ct ⟶ C) (V : C.Opens) (hV : IsAffineOpen V) (g₀ : Γ(C, V)) (hW : IsAffineOpen (ν ⁻¹ᵁ V)) (hbij : Function.Bijective (ν.app (C.basicOpen g₀)).hom), (∀ s : Γ(Ct, ν ⁻¹ᵁ V), ∃ (N : ℕ) (a₀ : Γ(C, V)), (ν.app V).hom (g₀ ^ N) * s = (ν.app V).hom a₀) ∧ ∀ a₀ : Γ(C, V), (ν.app V).hom a₀ = 0 → ∃ n : ℕ, g₀ ^ n * a₀ = 0 := by
    intro C Ct ν V hV g₀ hW hbij
    have hDV : C.basicOpen g₀ ≤ V := C.basicOpen_le g₀
    have hDV' : ν ⁻¹ᵁ C.basicOpen g₀ ≤ ν ⁻¹ᵁ V := fun x hx => hDV hx
    have hnat : ∀ x, (ν.app (C.basicOpen g₀)).hom ((C.presheaf.map (homOfLE hDV).op).hom x) =
        (Ct.presheaf.map (homOfLE hDV').op).hom ((ν.app V).hom x) := by
      intro x
      rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, ν.naturality]
      rfl
    have KV : ∀ X : Γ(Ct, ν ⁻¹ᵁ V), (Ct.presheaf.map (homOfLE hDV').op).hom X = 0 →
        ∃ M : ℕ, ((ν.app V).hom g₀) ^ M * X = 0 := by
      intro X hX
      apply exists_pow_mul_eq_zero_of_res_basicOpen_eq_zero_of_isAffineOpen Ct hW
      have e : ν ⁻¹ᵁ C.basicOpen g₀ = Ct.basicOpen ((ν.app V).hom g₀) := Scheme.preimage_basicOpen ν g₀
      have : (X |_ Ct.basicOpen ((ν.app V).hom g₀)) =
          (Ct.presheaf.map (homOfLE (le_of_eq e.symm)).op).hom
            ((Ct.presheaf.map (homOfLE hDV').op).hom X) := by
        rw [← CommRingCat.comp_apply, ← Functor.map_comp]; rfl
      rw [this, hX, map_zero]
    constructor
    · intro s
      obtain ⟨z, hz⟩ := hbij.2 ((Ct.presheaf.map (homOfLE hDV').op).hom s)
      haveI := hV.isLocalization_basicOpen g₀
      obtain ⟨⟨a₁, ⟨_, n, rfl⟩⟩, hza⟩ := IsLocalization.surj (Submonoid.powers g₀) z
      have hza' : (C.presheaf.map (homOfLE hDV).op).hom a₁ =
          z * (C.presheaf.map (homOfLE hDV).op).hom (g₀ ^ n) := hza.symm
      have h1 : (Ct.presheaf.map (homOfLE hDV').op).hom
          (s * (ν.app V).hom (g₀ ^ n) - (ν.app V).hom a₁) = 0 := by
        rw [map_sub, map_mul, ← hnat, ← hnat, ← hz, hza', map_mul, sub_self]
      obtain ⟨M, hM⟩ := KV _ h1
      refine ⟨M + n, g₀ ^ M * a₁, ?_⟩
      rw [mul_sub, sub_eq_zero] at hM
      simp only [map_mul, map_pow, pow_add] at hM ⊢
      rw [← hM]; ring
    · intro a₀ ha₀
      apply exists_pow_mul_eq_zero_of_res_basicOpen_eq_zero_of_isAffineOpen C hV
      apply hbij.1
      rw [map_zero]
      change (ν.app _).hom ((C.presheaf.map (homOfLE hDV).op).hom a₀) = 0
      rw [hnat, ha₀, map_zero]
  intro C Ct ν U V hV p hp j hfin hiso hcl hj
  haveI := hfin
  have hW : IsAffineOpen (ν ⁻¹ᵁ V) := hV.preimage ν
  obtain ⟨hunit, hsurj⟩ := s1 C V hV p hp
  have key : ∀ q : Ideal (C.presheaf.stalk p), q.IsPrime →
      q ≠ IsLocalRing.maximalIdeal (C.presheaf.stalk p) →
      (∀ b : Localization (Submonoid.map (ν.app V).hom (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl),
        ∃ g : C.presheaf.stalk p, g ∉ q ∧ ∃ a : C.presheaf.stalk p, j a = j g * b) ∧
      (∀ a : C.presheaf.stalk p, j a = 0 → ∃ g : C.presheaf.stalk p, g ∉ q ∧ g * a = 0) := by
    intro q hq hqm
    obtain ⟨hle, hne⟩ := s2 C V hV p hp q hq hqm
    haveI := hq
    obtain ⟨g₀, hg₀U, hg₀⟩ := s3 C U V hV p hp
      ⟨Ideal.comap (C.presheaf.germ V p hp).hom q, inferInstance⟩ hle hne hcl
    have hbij := s4 C Ct ν U (C.basicOpen g₀) hiso hg₀U
    obtain ⟨hcond, htors⟩ := s5 C Ct ν V hV g₀ hW hbij
    exact s6 _ _ _ (C.presheaf.germ V p hp).hom (ν.app V).hom _ j g₀ q hq hunit hsurj hj hg₀
      hcond htors
  exact ⟨fun q hq hqm => (key q hq hqm).1, fun q hq hqm => (key q hq hqm).2⟩

theorem wcpa_dj_nf_point_of_char : ∀ (Ω : Type u) [Field Ω] (C Ct : Scheme.{u}) (c : C ⟶ Spec (.of Ω)) (ν : Ct ⟶ C) (V : C.Opens) (hV : IsAffineOpen V) (p : C) (hp : p ∈ V) (j : C.presheaf.stalk p →+* Localization (Submonoid.map (ν.app V).hom (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl)) (χ : Localization (Submonoid.map (ν.app V).hom (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl) →+* Ω), IsFinite ν → j.comp (C.presheaf.germ V p hp).hom = (algebraMap Γ(Ct, ν ⁻¹ᵁ V) (Localization (Submonoid.map (ν.app V).hom (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl))).comp (ν.app V).hom → χ.comp (j.comp ((Scheme.ΓSpecIso (.of Ω)).inv ≫ c.appTop ≫ C.presheaf.germ ⊤ p trivial).hom) = RingHom.id Ω → ∃ y : Spec (.of Ω) ⟶ Ct, y ≫ ν ≫ c = 𝟙 _ ∧ (∀ q : ↥(Spec (.of Ω)), ν (y q) = p) ∧ ∀ (h₀ : ⊤ ≤ y ⁻¹ᵁ (ν ⁻¹ᵁ V)) (b : Γ(Ct, ν ⁻¹ᵁ V)), (y.appLE (ν ⁻¹ᵁ V) ⊤ h₀).hom b = (Scheme.ΓSpecIso (.of Ω)).inv.hom (χ (algebraMap Γ(Ct, ν ⁻¹ᵁ V) (Localization (Submonoid.map (ν.app V).hom (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl)) b)) :=
by
  intro Ω _ C Ct c ν V hV p hp j χ hfin hj hχ
  have : IsFinite ν := hfin
  have hW : IsAffineOpen (ν ⁻¹ᵁ V) := hV.preimage ν
  let φ : Γ(Ct, ν ⁻¹ᵁ V) →+* Ω := χ.comp (algebraMap Γ(Ct, ν ⁻¹ᵁ V)
    (Localization (Submonoid.map (ν.app V).hom (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl)))
  let ρ : C.presheaf.stalk p →+* Ω := χ.comp j

  have s1 : ∀ (X : Scheme.{u}) (W : X.Opens) (hW : IsAffineOpen W) (φ : Γ(X, W) →+* Ω)
      (h₀ : ⊤ ≤ (Spec.map (CommRingCat.ofHom φ) ≫ hW.fromSpec) ⁻¹ᵁ W) (b : Γ(X, W)),
      ((Spec.map (CommRingCat.ofHom φ) ≫ hW.fromSpec).appLE W ⊤ h₀).hom b =
        (Scheme.ΓSpecIso (.of Ω)).inv.hom (φ b) := by
    intro X W hW φ h₀ b
    have key : (Spec.map (CommRingCat.ofHom φ) ≫ hW.fromSpec).appLE W ⊤ h₀ =
        CommRingCat.ofHom φ ≫ (Scheme.ΓSpecIso (.of Ω)).inv := by
      have h₁ : (⊤ : (Spec (.of Ω)).Opens) ≤
          Spec.map (CommRingCat.ofHom φ) ⁻¹ᵁ (hW.fromSpec ⁻¹ᵁ W) := h₀
      have hc : (Spec.map (CommRingCat.ofHom φ) ≫ hW.fromSpec).appLE W ⊤ h₀ =
          hW.fromSpec.app W ≫ (Spec.map (CommRingCat.ofHom φ)).appLE (hW.fromSpec ⁻¹ᵁ W) ⊤ h₁ :=
        Scheme.Hom.comp_appLE _ _ _ _ _
      rw [hc, IsAffineOpen.fromSpec_app_self, Category.assoc, Scheme.Hom.map_appLE,
        Scheme.ΓSpecIso_inv_naturality]
      congr 1
    rw [key]
    rfl

  have hφρ : φ.comp (ν.app V).hom = ρ.comp (C.presheaf.germ V p hp).hom := by
    show χ.comp ((algebraMap _ _).comp (ν.app V).hom) = χ.comp (j.comp (C.presheaf.germ V p hp).hom)
    rw [hj]
  have hE : (Spec.map (CommRingCat.ofHom φ) ≫ hW.fromSpec) ≫ ν =
      Spec.map (CommRingCat.ofHom (ρ.comp (C.presheaf.germ V p hp).hom)) ≫ hV.fromSpec := by
    have h1 := IsAffineOpen.SpecMap_appLE_fromSpec ν hV hW le_rfl
    rw [Scheme.Hom.appLE_eq_app] at h1
    rw [Category.assoc, ← h1, ← Category.assoc, ← Spec.map_comp, ← hφρ]
    rfl

  have hle : V ≤ c ⁻¹ᵁ ⊤ := by simp
  have hc : hV.fromSpec ≫ c =
      Spec.map (c.appLE ⊤ V hle) ≫ Spec.map (Scheme.ΓSpecIso (.of Ω)).inv := by
    rw [← IsAffineOpen.SpecMap_appLE_fromSpec c (isAffineOpen_top (Spec (.of Ω))) hV hle,
      IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv]
  have e2 : c.appLE ⊤ V hle ≫ C.presheaf.germ V p hp = c.appTop ≫ C.presheaf.germ ⊤ p trivial := by
    rw [Scheme.Hom.appLE, Category.assoc, TopCat.Presheaf.germ_res]
    rfl
  refine ⟨Spec.map (CommRingCat.ofHom φ) ≫ hW.fromSpec, ?_, ?_, ?_⟩
  · rw [← Category.assoc, hE, Category.assoc, hc, ← Spec.map_comp, ← Spec.map_comp, ← Spec.map_id,
      Spec.map_inj]
    ext z
    have h3 : (C.presheaf.germ V p hp).hom ((c.appLE ⊤ V hle).hom
        ((Scheme.ΓSpecIso (.of Ω)).inv.hom z)) = (C.presheaf.germ ⊤ p trivial).hom
          (c.appTop.hom ((Scheme.ΓSpecIso (.of Ω)).inv.hom z)) :=
      congrArg (fun f => CommRingCat.Hom.hom f ((Scheme.ΓSpecIso (.of Ω)).inv.hom z)) e2
    show ρ ((C.presheaf.germ V p hp).hom ((c.appLE ⊤ V hle).hom
        ((Scheme.ΓSpecIso (.of Ω)).inv.hom z))) = z
    rw [h3]
    exact DFunLike.congr_fun hχ z
  · intro q
    rw [← Scheme.Hom.comp_apply, hE]
    have hsurj : Function.Surjective ρ := fun z =>
      ⟨((Scheme.ΓSpecIso (.of Ω)).inv ≫ c.appTop ≫ C.presheaf.germ ⊤ p trivial).hom z,
        DFunLike.congr_fun hχ z⟩
    have hker : RingHom.ker ρ = IsLocalRing.maximalIdeal _ :=
      IsLocalRing.eq_maximalIdeal (RingHom.ker_isMaximal_of_surjective ρ hsurj)
    have hq : (Spec.map (CommRingCat.ofHom (ρ.comp (C.presheaf.germ V p hp).hom))) q =
        hV.primeIdealOf ⟨p, hp⟩ := by
      rw [IsAffineOpen.primeIdealOf_eq_map_closedPoint]
      have e3 := Spec.map_apply (C.presheaf.germ V p hp)
        (IsLocalRing.closedPoint (C.presheaf.stalk p))
      have e4 := Spec.map_apply (CommRingCat.ofHom (ρ.comp (C.presheaf.germ V p hp).hom)) q
      have hqp : q.asIdeal.IsPrime := PrimeSpectrum.isPrime q
      have hq0 : q.asIdeal = ⊥ := Ideal.eq_bot_of_prime _
      have hid : Ideal.comap (ρ.comp (C.presheaf.germ V p hp).hom) q.asIdeal =
          Ideal.comap (C.presheaf.germ V p hp).hom (IsLocalRing.maximalIdeal _) := by
        rw [hq0, ← RingHom.ker_eq_comap_bot, ← RingHom.comap_ker, hker]
      refine e4.trans (Eq.trans ?_ e3.symm)
      apply PrimeSpectrum.ext
      exact hid
    rw [Scheme.Hom.comp_apply, hq, IsAffineOpen.fromSpec_primeIdealOf]
  · intro h₀ b
    exact s1 Ct (ν ⁻¹ᵁ V) hW φ h₀ b

theorem wcpa_dj_nf_fibre_points : ∀ (Ω : Type u) [Field Ω] (C Ct : Scheme.{u}) (ν : Ct ⟶ C) (V : C.Opens) (hV : IsAffineOpen V) (p : C) (hp : p ∈ V) (j : C.presheaf.stalk p →+* Localization (Submonoid.map (ν.app V).hom (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl)), IsFinite ν → j.Finite → j.comp (C.presheaf.germ V p hp).hom = (algebraMap Γ(Ct, ν ⁻¹ᵁ V) (Localization (Submonoid.map (ν.app V).hom (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl))).comp (ν.app V).hom → (∀ x : Ct, ν x = p → ∃ M : Ideal (Localization (Submonoid.map (ν.app V).hom (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl)), M.IsMaximal ∧ ∀ (χ : Localization (Submonoid.map (ν.app V).hom (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl) →+* Ω) (y : Spec (.of Ω) ⟶ Ct), (∀ q : ↥(Spec (.of Ω)), ν (y q) = p) → (∀ (h₀ : ⊤ ≤ y ⁻¹ᵁ (ν ⁻¹ᵁ V)) (b : Γ(Ct, ν ⁻¹ᵁ V)), (y.appLE (ν ⁻¹ᵁ V) ⊤ h₀).hom b = (Scheme.ΓSpecIso (.of Ω)).inv.hom (χ (algebraMap Γ(Ct, ν ⁻¹ᵁ V) (Localization (Submonoid.map (ν.app V).hom (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl)) b))) → RingHom.ker χ = M → ∀ q : ↥(Spec (.of Ω)), y q = x) ∧ ∀ (χ χ' : Localization (Submonoid.map (ν.app V).hom (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl) →+* Ω) (y y' : Spec (.of Ω) ⟶ Ct), (∀ q : ↥(Spec (.of Ω)), ν (y q) = p) → (∀ q : ↥(Spec (.of Ω)), ν (y' q) = p) → (∀ (h₀ : ⊤ ≤ y ⁻¹ᵁ (ν ⁻¹ᵁ V)) (b : Γ(Ct, ν ⁻¹ᵁ V)), (y.appLE (ν ⁻¹ᵁ V) ⊤ h₀).hom b = (Scheme.ΓSpecIso (.of Ω)).inv.hom (χ (algebraMap Γ(Ct, ν ⁻¹ᵁ V) (Localization (Submonoid.map (ν.app V).hom (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl)) b))) → (∀ (h₀ : ⊤ ≤ y' ⁻¹ᵁ (ν ⁻¹ᵁ V)) (b : Γ(Ct, ν ⁻¹ᵁ V)), (y'.appLE (ν ⁻¹ᵁ V) ⊤ h₀).hom b = (Scheme.ΓSpecIso (.of Ω)).inv.hom (χ' (algebraMap Γ(Ct, ν ⁻¹ᵁ V) (Localization (Submonoid.map (ν.app V).hom (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl)) b))) → ∀ q q' : ↥(Spec (.of Ω)), y q = y' q' → RingHom.ker χ = RingHom.ker χ' :=
by
  intro Ω _ C Ct ν V hV p hp j hfin hjfin hj
  haveI := hfin
  have hW : IsAffineOpen (ν ⁻¹ᵁ V) := hV.preimage ν

  have s1 : ∀ (X : Scheme.{u}) (U : X.Opens) (hU : IsAffineOpen U) (x : X) (hx : x ∈ U)
      (f : Γ(X, U)), f ∈ (hU.primeIdealOf ⟨x, hx⟩).asIdeal ↔ x ∉ X.basicOpen f := by
    intro X U hU x hx f
    have key : ∀ P : PrimeSpectrum Γ(X, U), hU.fromSpec P ∈ X.basicOpen f ↔ f ∉ P.asIdeal := by
      intro P
      have h4 := congrArg (fun O : (Spec Γ(X, U)).Opens =>
        (P : ↥(Spec Γ(X, U))) ∈ (O : Set ↥(Spec Γ(X, U)))) (hU.fromSpec_preimage_basicOpen f)
      exact (Iff.of_eq h4).trans (PrimeSpectrum.mem_basicOpen f P)
    have h1 : hU.fromSpec (hU.primeIdealOf ⟨x, hx⟩) = x :=
      IsAffineOpen.fromSpec_primeIdealOf hU ⟨x, hx⟩
    have h2 := key (hU.primeIdealOf ⟨x, hx⟩)
    rw [h1] at h2
    rw [h2, not_not]

  have s2 : ∀ (x : Ct) (hx : x ∈ ν ⁻¹ᵁ V) (hfx : ν x ∈ V),
      Ideal.comap (ν.app V).hom (hW.primeIdealOf ⟨x, hx⟩).asIdeal =
        (hV.primeIdealOf ⟨ν x, hfx⟩).asIdeal := by
    intro x hx hfx
    ext a
    rw [Ideal.mem_comap, s1 _ _ _ x hx, s1 _ _ _ (ν x) hfx, ← Scheme.preimage_basicOpen,
      Scheme.Hom.mem_preimage]

  have s3 : ∀ (y : Spec (.of Ω) ⟶ Ct) (ψ : Γ(Ct, ν ⁻¹ᵁ V) →+* Ω) (h₀ : ⊤ ≤ y ⁻¹ᵁ (ν ⁻¹ᵁ V)),
      (∀ b, (y.appLE (ν ⁻¹ᵁ V) ⊤ h₀).hom b = (Scheme.ΓSpecIso (.of Ω)).inv.hom (ψ b)) →
      ∀ (q : ↥(Spec (.of Ω))) (hq : y q ∈ ν ⁻¹ᵁ V),
        (hW.primeIdealOf ⟨y q, hq⟩).asIdeal = RingHom.ker ψ := by
    intro y ψ h₀ hψ q hq
    ext b
    rw [s1 _ _ _ _ hq, RingHom.mem_ker]
    have key : q ∈ (Spec (.of Ω)).basicOpen ((y.appLE (ν ⁻¹ᵁ V) ⊤ h₀).hom b) ↔
        y q ∈ Ct.basicOpen b := by
      rw [Scheme.basicOpen_appLE]
      simp only [top_inf_eq, Scheme.Hom.mem_preimage]
    rw [← key, hψ b]
    by_cases hb : ψ b = 0
    · simp [hb]
    · have hu : IsUnit ((Scheme.ΓSpecIso (.of Ω)).inv.hom (ψ b)) := (Ne.isUnit hb).map _
      rw [Scheme.basicOpen_of_isUnit _ hu]
      simp [hb]

  have s4 : ∀ (R A B : Type u) [CommRing R] [CommRing A] [IsLocalRing A] [CommRing B]
      (𝔭 : Ideal R) [𝔭.IsPrime] (g : R →+* A) (φ : R →+* B)
      (j : A →+* Localization (Submonoid.map φ 𝔭.primeCompl)) (Q : Ideal B), Q.IsPrime →
      Ideal.map g 𝔭 = IsLocalRing.maximalIdeal A → j.Finite →
      j.comp g = (algebraMap B (Localization (Submonoid.map φ 𝔭.primeCompl))).comp φ →
      Ideal.comap φ Q = 𝔭 →
      (Ideal.map (algebraMap B (Localization (Submonoid.map φ 𝔭.primeCompl))) Q).IsMaximal ∧
      Ideal.comap (algebraMap B (Localization (Submonoid.map φ 𝔭.primeCompl)))
        (Ideal.map (algebraMap B (Localization (Submonoid.map φ 𝔭.primeCompl))) Q) = Q := by
    intro R A B _ _ _ _ 𝔭 _ g φ j Q hQ hg hjf hjc hQc
    have hdisj : Disjoint ((Submonoid.map φ 𝔭.primeCompl : Submonoid B) : Set B) (Q : Set B) := by
      rw [Set.disjoint_left]
      rintro s' ⟨s, hs, rfl⟩ hsQ
      apply hs
      rw [← hQc]
      exact hsQ
    have hMp := IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.map φ 𝔭.primeCompl)
      (Localization (Submonoid.map φ 𝔭.primeCompl)) Q hQ hdisj
    have hMc : Ideal.comap (algebraMap B (Localization (Submonoid.map φ 𝔭.primeCompl)))
        (Ideal.map (algebraMap B (Localization (Submonoid.map φ 𝔭.primeCompl))) Q) = Q :=
      IsLocalization.under_map_of_isPrime_disjoint (Submonoid.map φ 𝔭.primeCompl) _ hQ hdisj
    refine ⟨?_, hMc⟩
    have hc : Ideal.comap g (Ideal.comap j
        (Ideal.map (algebraMap B (Localization (Submonoid.map φ 𝔭.primeCompl))) Q)) = 𝔭 := by
      rw [Ideal.comap_comap, hjc, ← Ideal.comap_comap, hMc, hQc]
    have hP : (Ideal.comap j
        (Ideal.map (algebraMap B (Localization (Submonoid.map φ 𝔭.primeCompl))) Q)).IsPrime :=
      Ideal.IsPrime.comap j
    have hPm : Ideal.comap j
        (Ideal.map (algebraMap B (Localization (Submonoid.map φ 𝔭.primeCompl))) Q) =
          IsLocalRing.maximalIdeal A := by
      apply le_antisymm (IsLocalRing.le_maximalIdeal hP.ne_top)
      rw [← hg]
      conv_lhs => rw [← hc]
      exact Ideal.map_comap_le
    have hint : j.IsIntegral := RingHom.IsIntegral.of_finite hjf
    haveI := hMp
    apply Ideal.isMaximal_of_isIntegral_of_isMaximal_comap j hint
    rw [hPm]
    exact IsLocalRing.maximalIdeal.isMaximal A

  have s5 : ∀ (z : C) (hz : z ∈ V), Ideal.map (C.presheaf.germ V z hz).hom
      (hV.primeIdealOf ⟨z, hz⟩).asIdeal = IsLocalRing.maximalIdeal (C.presheaf.stalk z) := by
    intro z hz
    letI : Algebra Γ(C, V) (C.presheaf.stalk z) := (C.presheaf.germ V z hz).hom.toAlgebra
    haveI : IsLocalization.AtPrime (C.presheaf.stalk z) (hV.primeIdealOf ⟨z, hz⟩).asIdeal :=
      hV.isLocalization_stalk ⟨z, hz⟩
    exact IsLocalization.AtPrime.map_eq_maximalIdeal (hV.primeIdealOf ⟨z, hz⟩).asIdeal
        (C.presheaf.stalk z)
  refine ⟨?_, ?_⟩
  ·
    intro x hxp
    subst hxp
    have hx : x ∈ ν ⁻¹ᵁ V := hp
    obtain ⟨hMmax, hMc⟩ := s4 Γ(C, V) (C.presheaf.stalk (ν x)) Γ(Ct, ν ⁻¹ᵁ V)
      (hV.primeIdealOf ⟨ν x, hp⟩).asIdeal (C.presheaf.germ V (ν x) hp).hom (ν.app V).hom j
      (hW.primeIdealOf ⟨x, hx⟩).asIdeal (PrimeSpectrum.isPrime _) (s5 (ν x) hp) hjfin hj
      (s2 x hx hp)
    refine ⟨_, hMmax, ?_⟩
    intro χ y hyp hval hker q
    have h₀ : ⊤ ≤ y ⁻¹ᵁ (ν ⁻¹ᵁ V) := fun q' _ => by
      rw [Scheme.Hom.mem_preimage, Scheme.Hom.mem_preimage, hyp q']
      exact hp
    have hyq : y q ∈ ν ⁻¹ᵁ V := by
      rw [Scheme.Hom.mem_preimage, hyp q]
      exact hp
    have h3 := s3 y (χ.comp (algebraMap Γ(Ct, ν ⁻¹ᵁ V) _)) h₀ (hval h₀) q hyq
    rw [← RingHom.comap_ker, hker, hMc] at h3
    have h4 : hW.primeIdealOf ⟨y q, hyq⟩ = hW.primeIdealOf ⟨x, hx⟩ := PrimeSpectrum.ext h3
    have h5 := congrArg (fun P => hW.fromSpec P) h4
    simp only [IsAffineOpen.fromSpec_primeIdealOf] at h5
    exact h5
  ·
    intro χ χ' y y' hyp hyp' hval hval' q q' he
    have h₀ : ⊤ ≤ y ⁻¹ᵁ (ν ⁻¹ᵁ V) := fun q'' _ => by
      rw [Scheme.Hom.mem_preimage, Scheme.Hom.mem_preimage, hyp q'']
      exact hp
    have h₀' : ⊤ ≤ y' ⁻¹ᵁ (ν ⁻¹ᵁ V) := fun q'' _ => by
      rw [Scheme.Hom.mem_preimage, Scheme.Hom.mem_preimage, hyp' q'']
      exact hp
    have hyq : y q ∈ ν ⁻¹ᵁ V := by
      rw [Scheme.Hom.mem_preimage, hyp q]
      exact hp
    have hyq' : y' q' ∈ ν ⁻¹ᵁ V := by
      rw [Scheme.Hom.mem_preimage, hyp' q']
      exact hp
    have h3 := s3 y (χ.comp (algebraMap Γ(Ct, ν ⁻¹ᵁ V) _)) h₀ (hval h₀) q hyq
    have h3' := s3 y' (χ'.comp (algebraMap Γ(Ct, ν ⁻¹ᵁ V) _)) h₀' (hval' h₀') q' hyq'
    have hpt : (⟨y q, hyq⟩ : ↥(ν ⁻¹ᵁ V)) = ⟨y' q', hyq'⟩ := Subtype.ext he
    have h6 : Ideal.comap (algebraMap Γ(Ct, ν ⁻¹ᵁ V) (Localization (Submonoid.map (ν.app V).hom
          (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl))) (RingHom.ker χ) =
        Ideal.comap (algebraMap Γ(Ct, ν ⁻¹ᵁ V) (Localization (Submonoid.map (ν.app V).hom
          (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl))) (RingHom.ker χ') := by
      rw [RingHom.comap_ker, RingHom.comap_ker, ← h3, ← h3', hpt]
    have e1 := IsLocalization.map_under (Submonoid.map (ν.app V).hom
      (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl) (Localization (Submonoid.map (ν.app V).hom
      (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl)) (RingHom.ker χ)
    have e2 := IsLocalization.map_under (Submonoid.map (ν.app V).hom
      (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl) (Localization (Submonoid.map (ν.app V).hom
      (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl)) (RingHom.ker χ')
    rw [← e1, ← e2]
    exact congrArg (Ideal.map _) h6

theorem wcpa_dj_nf_rational_point_unique : ∀ (Ω : Type u) [Field Ω] (C : Scheme.{u}) (c : C ⟶ Spec (.of Ω)) (p : C) (f g : Spec (.of Ω) ⟶ C), f ≫ c = 𝟙 _ → g ≫ c = 𝟙 _ → (∀ q : ↥(Spec (.of Ω)), f q = p) → (∀ q : ↥(Spec (.of Ω)), g q = p) → (∀ a : C.presheaf.stalk p, ∃ z : Ω, a - ((Scheme.ΓSpecIso (.of Ω)).inv ≫ c.appTop ≫ C.presheaf.germ ⊤ p trivial).hom z ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk p)) → f = g :=
by
  intro Ω _ C c p f g hfc hgc hf hg hres
  have s1 : ∀ (V : C.Opens), IsAffineOpen V → ∀ (hf' : ⊤ ≤ f ⁻¹ᵁ V) (hg' : ⊤ ≤ g ⁻¹ᵁ V),
      (∀ r : Γ(C, V), (f.appLE V ⊤ hf').hom r = (g.appLE V ⊤ hg').hom r) → f = g := by
    intro V hV hf' hg' H
    have hT : IsAffineOpen (⊤ : (Spec (.of Ω)).Opens) := isAffineOpen_top _
    have e1 := IsAffineOpen.SpecMap_appLE_fromSpec f hV hT hf'
    have e2 := IsAffineOpen.SpecMap_appLE_fromSpec g hV hT hg'
    have heq : f.appLE V ⊤ hf' = g.appLE V ⊤ hg' := by
      ext r; exact H r
    rw [heq, e2, IsAffineOpen.fromSpec_top] at e1
    exact (cancel_epi _).mp e1.symm
  have s2 : ∀ (f : Spec (.of Ω) ⟶ C) (V : C.Opens) (hpV : p ∈ V) (hf' : ⊤ ≤ f ⁻¹ᵁ V),
      (∀ q : ↥(Spec (.of Ω)), f q = p) → ∀ r : Γ(C, V),
      (C.presheaf.germ V p hpV).hom r ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk p) →
      (f.appLE V ⊤ hf').hom r = 0 := by
    intro f V hpV hf' hfp r hr
    by_contra hs
    have hunit : IsUnit ((f.appLE V ⊤ hf').hom r) := by
      have e : (f.appLE V ⊤ hf').hom r = (Scheme.ΓSpecIso (.of Ω)).inv.hom
          ((Scheme.ΓSpecIso (.of Ω)).hom.hom ((f.appLE V ⊤ hf').hom r)) := by
        rw [← CommRingCat.comp_apply, Iso.hom_inv_id]; rfl
      rw [e]
      apply IsUnit.map
      apply Ne.isUnit
      intro h0
      apply hs
      rw [e, h0, map_zero]
    have hb := (Spec (.of Ω)).basicOpen_of_isUnit hunit
    rw [Scheme.basicOpen_appLE] at hb
    have hq : ∀ q : ↥(Spec (.of Ω)), q ∈ f ⁻¹ᵁ C.basicOpen r := by
      intro q
      have : q ∈ (⊤ : (Spec (.of Ω)).Opens) := trivial
      rw [← hb] at this
      exact this.2
    have hp : p ∈ C.basicOpen r := by
      obtain ⟨q⟩ : Nonempty ↥(Spec (.of Ω)) := ⟨IsLocalRing.closedPoint Ω⟩
      have h : f q ∈ C.basicOpen r := hq q
      rw [hfp q] at h
      exact h
    rw [Scheme.mem_basicOpen _ _ _ hpV] at hp
    exact (IsLocalRing.mem_maximalIdeal _).mp hr hp
  have s3 : ∀ (f : Spec (.of Ω) ⟶ C) (V : C.Opens) (hf' : ⊤ ≤ f ⁻¹ᵁ V), f ≫ c = 𝟙 _ →
      ∀ x : Γ(Spec (.of Ω), ⊤), (f.appLE V ⊤ hf').hom
        ((C.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom (c.appTop.hom x)) = x := by
    intro f V hf' hfc x
    have h1 : C.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op ≫ f.appLE V ⊤ hf' =
        f.appLE ⊤ ⊤ le_top := Scheme.Hom.map_appLE _ _ _
    rw [← CommRingCat.comp_apply, h1, ← CommRingCat.comp_apply]
    have h2 : c.appTop ≫ f.appLE ⊤ ⊤ le_top = (f ≫ c).appTop := by
      rw [Scheme.Hom.comp_appTop]; congr 1
    rw [h2, hfc, Scheme.Hom.id_appTop]; rfl
  obtain ⟨V, hV, hpV, -⟩ :=
    exists_isAffineOpen_mem_and_subset (show p ∈ (⊤ : C.Opens) from trivial)
  have hF : ⊤ ≤ f ⁻¹ᵁ V := fun q _ => by
    show f q ∈ V
    rw [hf q]; exact hpV
  have hG : ⊤ ≤ g ⁻¹ᵁ V := fun q _ => by
    show g q ∈ V
    rw [hg q]; exact hpV
  apply s1 V hV hF hG
  intro r
  obtain ⟨z, hz⟩ := hres ((C.presheaf.germ V p hpV).hom r)
  set rz := (C.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom
    (c.appTop.hom ((Scheme.ΓSpecIso (.of Ω)).inv.hom z)) with hrz
  have hgerm : (C.presheaf.germ V p hpV).hom rz =
      ((Scheme.ΓSpecIso (.of Ω)).inv ≫ c.appTop ≫ C.presheaf.germ ⊤ p trivial).hom z := by
    rw [hrz, TopCat.Presheaf.germ_res_apply]
    rfl
  have hm : (C.presheaf.germ V p hpV).hom (r - rz) ∈
      IsLocalRing.maximalIdeal (C.presheaf.stalk p) := by
    rw [map_sub, hgerm]; exact hz
  have h1 := s2 f V hpV hF hf (r - rz) hm
  have h2 := s2 g V hpV hG hg (r - rz) hm
  rw [map_sub, sub_eq_zero] at h1 h2
  rw [h1, h2, hrz, s3 f V hF hfc, s3 g V hG hgc]

theorem wcpa_dj_nf_local_U : ∀ (C Ct : Scheme.{u}) (ν : Ct ⟶ C) (U : C.Opens), IsIso (ν ∣_ U) → ∀ p : C, p ∈ U → (∀ (O : C.Opens) (hpO : p ∈ O) (t : Γ(C, O)), (ν.app O).hom t = 0 → (C.presheaf.germ O p hpO).hom t = 0) ∧ ∀ (O : C.Opens), p ∈ O → ∀ s : Γ(Ct, ν ⁻¹ᵁ O), ∃ (O' : C.Opens) (hO' : O' ≤ O), p ∈ O' ∧ ∃ t : Γ(C, O'), (ν.app O').hom t = (Ct.presheaf.map (homOfLE (show ν ⁻¹ᵁ O' ≤ ν ⁻¹ᵁ O from fun x hx => hO' hx)).op).hom s :=
by
  intro C Ct ν U hiso p hp
  have hbij : ∀ O' : C.Opens, O' ≤ U → Function.Bijective (ν.app O').hom := by
    intro O' hO'
    have h1 : IsIso ((ν ∣_ U).app (U.ι ⁻¹ᵁ O')) := inferInstance
    rw [morphismRestrict_app, eqToHom_op, eqToHom_map] at h1
    have key : ∀ {X Y Z : CommRingCat.{u}} (f : X ⟶ Y) (h : Y = Z), IsIso (f ≫ eqToHom h) →
        IsIso f := by
      intro X Y Z f h hf
      subst h
      simpa using hf
    have h2 : IsIso (ν.app (U.ι ''ᵁ (U.ι ⁻¹ᵁ O'))) := key _ _ h1
    have hd : U.ι ''ᵁ (U.ι ⁻¹ᵁ O') = O' := by
      rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
      exact inf_eq_right.mpr hO'
    rw [hd] at h2
    exact ConcreteCategory.bijective_of_isIso (ν.app O')
  refine ⟨fun O hpO t ht => ?_, fun O hpO s => ?_⟩
  · have hO' : O ⊓ U ≤ O := inf_le_left
    have hnat : (ν.app (O ⊓ U)).hom ((C.presheaf.map (homOfLE hO').op).hom t) =
        (Ct.presheaf.map (homOfLE (show ν ⁻¹ᵁ (O ⊓ U) ≤ ν ⁻¹ᵁ O from fun _ hx => hO' hx)).op).hom
          ((ν.app O).hom t) := by
      rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, Scheme.Hom.naturality]
      rfl
    rw [ht, map_zero] at hnat
    have hz : (C.presheaf.map (homOfLE hO').op).hom t = 0 :=
      (hbij (O ⊓ U) inf_le_right).1 (hnat.trans (map_zero _).symm)
    rw [← TopCat.Presheaf.germ_res_apply C.presheaf (homOfLE hO') p ⟨hpO, hp⟩, hz, map_zero]
  · have hO' : O ⊓ U ≤ O := inf_le_left
    obtain ⟨t, ht⟩ := (hbij (O ⊓ U) inf_le_right).2
      ((Ct.presheaf.map (homOfLE (show ν ⁻¹ᵁ (O ⊓ U) ≤ ν ⁻¹ᵁ O from fun _ hx => hO' hx)).op).hom s)
    exact ⟨O ⊓ U, hO', ⟨hpO, hp⟩, t, ht⟩

theorem wcpa_dj_nf_local_node : ∀ (Ω : Type u) [Field Ω] (C Ct : Scheme.{u}) (ν : Ct ⟶ C) (V : C.Opens) (hV : IsAffineOpen V) (p : C) (hp : p ∈ V) (j : C.presheaf.stalk p →+* Localization (Submonoid.map (ν.app V).hom (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl)) (χ₀ χ₁ : Localization (Submonoid.map (ν.app V).hom (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl) →+* Ω) (y₀ y₁ : Spec (.of Ω) ⟶ Ct), IsFinite ν → j.comp (C.presheaf.germ V p hp).hom = (algebraMap Γ(Ct, ν ⁻¹ᵁ V) (Localization (Submonoid.map (ν.app V).hom (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl))).comp (ν.app V).hom → Function.Injective j → (∀ b, (∃ a, j a = b) ↔ χ₀ b = χ₁ b) → (∀ q : ↥(Spec (.of Ω)), ν (y₀ q) = p) → (∀ q : ↥(Spec (.of Ω)), ν (y₁ q) = p) → (∀ (h₀ : ⊤ ≤ y₀ ⁻¹ᵁ (ν ⁻¹ᵁ V)) (b : Γ(Ct, ν ⁻¹ᵁ V)), (y₀.appLE (ν ⁻¹ᵁ V) ⊤ h₀).hom b = (Scheme.ΓSpecIso (.of Ω)).inv.hom (χ₀ (algebraMap Γ(Ct, ν ⁻¹ᵁ V) (Localization (Submonoid.map (ν.app V).hom (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl)) b))) → (∀ (h₁ : ⊤ ≤ y₁ ⁻¹ᵁ (ν ⁻¹ᵁ V)) (b : Γ(Ct, ν ⁻¹ᵁ V)), (y₁.appLE (ν ⁻¹ᵁ V) ⊤ h₁).hom b = (Scheme.ΓSpecIso (.of Ω)).inv.hom (χ₁ (algebraMap Γ(Ct, ν ⁻¹ᵁ V) (Localization (Submonoid.map (ν.app V).hom (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl)) b))) → (∀ (O : C.Opens) (hpO : p ∈ O) (t : Γ(C, O)), (ν.app O).hom t = 0 → (C.presheaf.germ O p hpO).hom t = 0) ∧ ∀ (V' : C.Opens), p ∈ V' → ∀ s : Γ(Ct, ν ⁻¹ᵁ V'), (∀ (h₀ : ⊤ ≤ y₀ ⁻¹ᵁ (ν ⁻¹ᵁ V')) (h₁ : ⊤ ≤ y₁ ⁻¹ᵁ (ν ⁻¹ᵁ V')), (y₀.appLE (ν ⁻¹ᵁ V') ⊤ h₀).hom s = (y₁.appLE (ν ⁻¹ᵁ V') ⊤ h₁).hom s) → ∃ (O : C.Opens) (hO : O ≤ V'), p ∈ O ∧ ∃ t : Γ(C, O), (ν.app O).hom t = (Ct.presheaf.map (homOfLE (show ν ⁻¹ᵁ O ≤ ν ⁻¹ᵁ V' from fun x hx => hO hx)).op).hom s :=
by
  intro Ω _ C Ct ν V hV p hp j χ₀ χ₁ y₀ y₁ hfin hj hjinj hsep hpt0 hpt1 hval0 hval1
  haveI := hfin
  have hW : IsAffineOpen (ν ⁻¹ᵁ V) := hV.preimage ν
  have hjg : ∀ x : Γ(C, V), j ((C.presheaf.germ V p hp).hom x) =
      algebraMap Γ(Ct, ν ⁻¹ᵁ V) (Localization (Submonoid.map (ν.app V).hom
        (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl)) ((ν.app V).hom x) :=
    fun x => RingHom.congr_fun hj x

  have nat : ∀ (U U' : C.Opens) (h : U ≤ U') (x : Γ(C, U')),
      (ν.app U).hom ((C.presheaf.map (homOfLE h).op).hom x) =
        (Ct.presheaf.map (homOfLE (show ν ⁻¹ᵁ U ≤ ν ⁻¹ᵁ U' from fun y hy => h hy)).op).hom
          ((ν.app U').hom x) := by
    intro U U' h x
    exact congrArg (fun φ => φ.hom x) (ν.naturality (homOfLE h).op)

  have rrC : ∀ (U1 U2 U3 : Ct.Opens) (h12 : U2 ≤ U1) (h23 : U3 ≤ U2) (x : Γ(Ct, U1)),
      (Ct.presheaf.map (homOfLE h23).op).hom ((Ct.presheaf.map (homOfLE h12).op).hom x) =
        (Ct.presheaf.map (homOfLE (h23.trans h12)).op).hom x := by
    intro U1 U2 U3 h12 h23 x
    show (Ct.presheaf.map (homOfLE h12).op ≫ Ct.presheaf.map (homOfLE h23).op).hom x = _
    rw [← Functor.map_comp]
    rfl

  have key0 : ∀ (x f : Γ(C, V)), p ∈ C.basicOpen f →
      (Ct.presheaf.map (homOfLE (Ct.basicOpen_le ((ν.app V).hom f))).op).hom
        ((ν.app V).hom x) = 0 →
      (C.presheaf.germ V p hp).hom x = 0 := by
    intro x f hpf hx
    obtain ⟨M, hM⟩ :=
      exists_pow_mul_eq_zero_of_res_basicOpen_eq_zero_of_isAffineOpen Ct hW _ _ hx
    have h1 : j ((C.presheaf.germ V p hp).hom (f ^ M * x)) = 0 := by
      rw [hjg, map_mul, map_pow, hM, map_zero]
    have h2 := hjinj (h1.trans (map_zero j).symm)
    rw [map_mul, map_pow] at h2
    have hu : IsUnit ((C.presheaf.germ V p hp).hom f) := (C.mem_basicOpen f p hp).mp hpf
    exact (hu.pow M).mul_right_eq_zero.mp h2
  refine ⟨?_, ?_⟩
  · intro O hpO t ht
    obtain ⟨f, hfle, hpf⟩ := hV.exists_basicOpen_le (V := O ⊓ V) ⟨p, ⟨hpO, hp⟩⟩ hp
    have hfO : C.basicOpen f ≤ O := hfle.trans inf_le_left
    have hfV : C.basicOpen f ≤ V := C.basicOpen_le f
    obtain ⟨n, a, ha⟩ := exists_eq_pow_mul_of_isAffineOpen C V hV f
      ((C.presheaf.map (homOfLE hfO).op).hom t)
    change (C.presheaf.map (homOfLE hfV).op).hom a =
      ((C.presheaf.map (homOfLE hfV).op).hom f) ^ n *
        (C.presheaf.map (homOfLE hfO).op).hom t at ha
    have hpf' : p ∈ C.basicOpen f := hpf
    have hgerm := congrArg (C.presheaf.germ (C.basicOpen f) p hpf').hom ha
    rw [map_mul, map_pow, TopCat.Presheaf.germ_res_apply, TopCat.Presheaf.germ_res_apply,
      TopCat.Presheaf.germ_res_apply] at hgerm
    have hνa := congrArg (ν.app (C.basicOpen f)).hom ha
    rw [map_mul, map_pow, nat, nat, nat, ht, map_zero, mul_zero] at hνa
    have hle : Ct.basicOpen ((ν.app V).hom f) ≤ ν ⁻¹ᵁ C.basicOpen f :=
      (Scheme.preimage_basicOpen ν f).ge
    have h0 : (Ct.presheaf.map (homOfLE (Ct.basicOpen_le ((ν.app V).hom f))).op).hom
        ((ν.app V).hom a) = 0 := by
      have := congrArg (Ct.presheaf.map (homOfLE hle).op).hom hνa
      rw [rrC, map_zero] at this
      exact this
    have ha0 := key0 a f hpf' h0
    rw [ha0] at hgerm
    have hu : IsUnit ((C.presheaf.germ V p hp).hom f) := (C.mem_basicOpen f p hp).mp hpf'
    exact (hu.pow n).mul_right_eq_zero.mp hgerm.symm
  · intro V' hpV' s hs
    obtain ⟨g, hgle, hpg⟩ := hV.exists_basicOpen_le (V := V' ⊓ V) ⟨p, ⟨hpV', hp⟩⟩ hp
    have hgV' : C.basicOpen g ≤ V' := hgle.trans inf_le_left
    have hpg' : p ∈ C.basicOpen g := hpg
    have hDV' : Ct.basicOpen ((ν.app V).hom g) ≤ ν ⁻¹ᵁ V' := by
      rw [← Scheme.preimage_basicOpen]
      exact fun x hx => hgV' hx
    obtain ⟨n, b, hb⟩ := exists_eq_pow_mul_of_isAffineOpen Ct (ν ⁻¹ᵁ V) hW ((ν.app V).hom g)
      ((Ct.presheaf.map (homOfLE hDV').op).hom s)
    change (Ct.presheaf.map (homOfLE (Ct.basicOpen_le ((ν.app V).hom g))).op).hom b =
      ((Ct.presheaf.map (homOfLE (Ct.basicOpen_le ((ν.app V).hom g))).op).hom
        ((ν.app V).hom g)) ^ n * (Ct.presheaf.map (homOfLE hDV').op).hom s at hb
    have hmemD : ∀ x : Ct, ν x = p → x ∈ Ct.basicOpen ((ν.app V).hom g) := by
      intro x hx
      rw [← Scheme.preimage_basicOpen]
      show ν x ∈ C.basicOpen g
      rw [hx]
      exact hpg'
    have pull : ∀ (y : Spec (.of Ω) ⟶ Ct) (U1 U2 : Ct.Opens) (h : U2 ≤ U1)
        (e : ⊤ ≤ y ⁻¹ᵁ U2) (c : Γ(Ct, U1)),
        (y.appLE U2 ⊤ e).hom ((Ct.presheaf.map (homOfLE h).op).hom c) =
          (y.appLE U1 ⊤ (e.trans (fun q hq => h hq))).hom c := by
      intro y U1 U2 h e c
      exact congrArg (fun φ => φ.hom c) (Scheme.Hom.map_appLE y e (homOfLE h).op)
    have side : ∀ (y : Spec (.of Ω) ⟶ Ct) (χ : Localization (Submonoid.map (ν.app V).hom
        (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl) →+* Ω), (∀ q, ν (y q) = p) →
        (∀ (h : ⊤ ≤ y ⁻¹ᵁ (ν ⁻¹ᵁ V)) (b : Γ(Ct, ν ⁻¹ᵁ V)), (y.appLE (ν ⁻¹ᵁ V) ⊤ h).hom b =
          (Scheme.ΓSpecIso (.of Ω)).inv.hom (χ (algebraMap Γ(Ct, ν ⁻¹ᵁ V)
            (Localization (Submonoid.map (ν.app V).hom
              (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl)) b))) →
        ∀ (hV'' : ⊤ ≤ y ⁻¹ᵁ (ν ⁻¹ᵁ V')),
        (Scheme.ΓSpecIso (.of Ω)).inv.hom (χ (algebraMap Γ(Ct, ν ⁻¹ᵁ V)
            (Localization (Submonoid.map (ν.app V).hom
              (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl)) b)) =
          (Scheme.ΓSpecIso (.of Ω)).inv.hom (χ (algebraMap Γ(Ct, ν ⁻¹ᵁ V)
            (Localization (Submonoid.map (ν.app V).hom
              (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl)) ((ν.app V).hom g))) ^ n *
            (y.appLE (ν ⁻¹ᵁ V') ⊤ hV'').hom s := by
      intro y χ hy hval hV''
      have e : ⊤ ≤ y ⁻¹ᵁ Ct.basicOpen ((ν.app V).hom g) := fun q _ => hmemD _ (hy q)
      have := congrArg (y.appLE _ ⊤ e).hom hb
      rw [map_mul, map_pow, pull, pull, pull, hval, hval] at this
      exact this
    have Γinj : Function.Injective (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom := by
      intro x x' hxx
      have := congrArg (Scheme.ΓSpecIso (CommRingCat.of Ω)).hom.hom hxx
      simpa using this
    have hs' := hs (fun q _ => hDV' (hmemD _ (hpt0 q))) (fun q _ => hDV' (hmemD _ (hpt1 q)))
    have e0 := side y₀ χ₀ hpt0 hval0 (fun q _ => hDV' (hmemD _ (hpt0 q)))
    have e1 := side y₁ χ₁ hpt1 hval1 (fun q _ => hDV' (hmemD _ (hpt1 q)))
    have hG := (hsep _).mp ⟨_, hjg g⟩
    rw [hG, hs'] at e0
    have hχ := Γinj (e0.trans e1.symm)
    obtain ⟨a, ha⟩ := (hsep _).mpr hχ

    letI : Algebra Γ(C, V) (C.presheaf.stalk p) :=
      TopCat.Presheaf.algebra_section_stalk C.presheaf ⟨p, hp⟩
    haveI hloc : IsLocalization.AtPrime (C.presheaf.stalk p) (hV.primeIdealOf ⟨p, hp⟩).asIdeal :=
      hV.isLocalization_stalk ⟨p, hp⟩
    obtain ⟨⟨a₀, ⟨t₀, ht₀m⟩⟩, hat⟩ :=
      IsLocalization.surj (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl a
    have hat' : a * (C.presheaf.germ V p hp).hom t₀ =
        (C.presheaf.germ V p hp).hom a₀ := hat
    have h1 := congrArg j hat'
    rw [map_mul, hjg, hjg, ha, ← map_mul] at h1
    obtain ⟨⟨c, hc⟩, hc'⟩ := (IsLocalization.eq_iff_exists (Submonoid.map (ν.app V).hom
      (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl) _).mp h1
    obtain ⟨w, hw, rfl⟩ := Submonoid.mem_map.mp hc
    have hc'' : (ν.app V).hom w * (b * (ν.app V).hom t₀) =
        (ν.app V).hom w * (ν.app V).hom a₀ := hc'
    have heq : (ν.app V).hom w * (ν.app V).hom t₀ * b = (ν.app V).hom (w * a₀) := by
      rw [map_mul]
      linear_combination hc''
    have ht0 : p ∈ C.basicOpen t₀ :=
      (C.mem_basicOpen _ p hp).mpr (IsLocalization.map_units
        (M := (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl) (C.presheaf.stalk p) ⟨t₀, ht₀m⟩)
    have hw' : p ∈ C.basicOpen w :=
      (C.mem_basicOpen _ p hp).mpr (IsLocalization.map_units
        (M := (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl) (C.presheaf.stalk p) ⟨w, hw⟩)

    have hOle : C.basicOpen (g * t₀ * w) ≤ C.basicOpen g := by
      rw [Scheme.basicOpen_mul, Scheme.basicOpen_mul]
      exact inf_le_left.trans inf_le_left
    have hOV' : C.basicOpen (g * t₀ * w) ≤ V' := hOle.trans hgV'
    have hOV : C.basicOpen (g * t₀ * w) ≤ V := C.basicOpen_le _
    have hpO : p ∈ C.basicOpen (g * t₀ * w) := by
      rw [Scheme.basicOpen_mul, Scheme.basicOpen_mul]
      exact ⟨⟨hpg', ht0⟩, hw'⟩
    have hu0 : IsUnit ((C.presheaf.map (homOfLE hOV).op).hom (g * t₀ * w)) :=
      RingedSpace.isUnit_res_basicOpen C.toRingedSpace (g * t₀ * w)
    rw [map_mul, map_mul, IsUnit.mul_iff, IsUnit.mul_iff] at hu0
    obtain ⟨⟨hug, hut⟩, huw⟩ := hu0
    have hu' : IsUnit ((C.presheaf.map (homOfLE hOV).op).hom (w * t₀ * g ^ n)) := by
      rw [map_mul, map_mul, map_pow]
      exact (huw.mul hut).mul (hug.pow n)
    obtain ⟨uu, huu⟩ := hu'
    have hON : ν ⁻¹ᵁ C.basicOpen (g * t₀ * w) ≤ Ct.basicOpen ((ν.app V).hom g) := by
      rw [← Scheme.preimage_basicOpen]
      exact fun x hx => hOle hx
    have hrb : (Ct.presheaf.map (homOfLE (show ν ⁻¹ᵁ C.basicOpen (g * t₀ * w) ≤ ν ⁻¹ᵁ V from
          fun x hx => hOV hx)).op).hom b =
        ((Ct.presheaf.map (homOfLE (show ν ⁻¹ᵁ C.basicOpen (g * t₀ * w) ≤ ν ⁻¹ᵁ V from
          fun x hx => hOV hx)).op).hom ((ν.app V).hom g)) ^ n *
        (Ct.presheaf.map (homOfLE (show ν ⁻¹ᵁ C.basicOpen (g * t₀ * w) ≤ ν ⁻¹ᵁ V' from
          fun x hx => hOV' hx)).op).hom s := by
      have := congrArg (Ct.presheaf.map (homOfLE hON).op).hom hb
      rw [map_mul, map_pow, rrC, rrC, rrC] at this
      exact this
    have hmain : (ν.app (C.basicOpen (g * t₀ * w))).hom
          ((C.presheaf.map (homOfLE hOV).op).hom (w * a₀)) =
        (ν.app (C.basicOpen (g * t₀ * w))).hom
          ((C.presheaf.map (homOfLE hOV).op).hom (w * t₀ * g ^ n)) *
        (Ct.presheaf.map (homOfLE (show ν ⁻¹ᵁ C.basicOpen (g * t₀ * w) ≤ ν ⁻¹ᵁ V' from
          fun x hx => hOV' hx)).op).hom s := by
      rw [nat, nat, ← heq]
      simp only [map_mul, map_pow]
      rw [hrb]
      ring
    refine ⟨C.basicOpen (g * t₀ * w), hOV', hpO,
      (C.presheaf.map (homOfLE hOV).op).hom (w * a₀) * ↑uu⁻¹, ?_⟩
    have div : ∀ {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S) (u : Rˣ) (x : R) (σ : S),
        φ x = φ ↑u * σ → φ (x * ↑u⁻¹) = σ := by
      intro R S _ _ φ u x σ h
      rw [map_mul, h, mul_right_comm, ← map_mul, Units.mul_inv, map_one, one_mul]
    rw [← huu] at hmain
    exact div _ uu _ _ hmain

theorem wcpa_dj_nf_sections_glue : ∀ (C Ct : Scheme.{u}) (ν : Ct ⟶ C) (V : C.Opens) (E : Γ(Ct, ν ⁻¹ᵁ V) → Prop), (∀ p : C, p ∈ V → ∀ (O : C.Opens) (hpO : p ∈ O) (t : Γ(C, O)), (ν.app O).hom t = 0 → (C.presheaf.germ O p hpO).hom t = 0) → (∀ p : C, p ∈ V → ∀ s : Γ(Ct, ν ⁻¹ᵁ V), E s → ∃ (O : C.Opens) (hO : O ≤ V), p ∈ O ∧ ∃ t : Γ(C, O), (ν.app O).hom t = (Ct.presheaf.map (homOfLE (show ν ⁻¹ᵁ O ≤ ν ⁻¹ᵁ V from fun x hx => hO hx)).op).hom s) → Function.Injective (ν.app V).hom ∧ ∀ s : Γ(Ct, ν ⁻¹ᵁ V), E s → ∃ t : Γ(C, V), (ν.app V).hom t = s :=
by
  intro C Ct ν V E H1 H2
  have nat : ∀ (W W' : C.Opens) (h : W ≤ W') (a : Γ(C, W')),
      (ν.app W).hom ((C.presheaf.map (homOfLE h).op).hom a) =
        (Ct.presheaf.map (homOfLE (show ν ⁻¹ᵁ W ≤ ν ⁻¹ᵁ W' from fun x hx => h hx)).op).hom
          ((ν.app W').hom a) := by
    intro W W' h a
    have := congrArg (fun f => f.hom a) (ν.naturality (homOfLE h).op)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
    exact this
  have resres : ∀ (W W' W'' : Ct.Opens) (h1 : W ≤ W') (h2 : W' ≤ W'') (a : Γ(Ct, W'')),
      (Ct.presheaf.map (homOfLE h1).op).hom ((Ct.presheaf.map (homOfLE h2).op).hom a) =
        (Ct.presheaf.map (homOfLE (h1.trans h2)).op).hom a := by
    intro W W' W'' h1 h2 a
    change (Ct.presheaf.map (homOfLE h2).op ≫ Ct.presheaf.map (homOfLE h1).op).hom a = _
    rw [← Functor.map_comp]
    rfl
  have inj : ∀ O : C.Opens, O ≤ V → Function.Injective (ν.app O).hom := by
    intro O hO
    rw [injective_iff_map_eq_zero]
    intro t ht
    apply TopCat.Presheaf.section_ext (F := C.sheaf) (U := O)
    intro x hx
    have h0 := H1 x (hO hx) O hx t ht
    change (C.presheaf.germ O x hx).hom t = (C.presheaf.germ O x hx).hom 0
    rw [h0, map_zero]
  refine ⟨inj V le_rfl, ?_⟩
  intro s hs
  choose O hO hmem t hts using fun i : {p : C // p ∈ V} => H2 i.1 i.2 s hs
  have hcov : V ≤ iSup O := fun x hx =>
    TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨x, hx⟩, hmem ⟨x, hx⟩⟩
  have hcov' : ν ⁻¹ᵁ V ≤ ⨆ i, ν ⁻¹ᵁ O i := fun x hx =>
    TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨ν.base x, hx⟩, hmem ⟨ν.base x, hx⟩⟩
  have hcomp : TopCat.Presheaf.IsCompatible C.sheaf.obj O t := by
    intro i k
    apply inj _ (inf_le_left.trans (hO i))
    change (ν.app _).hom ((C.presheaf.map (homOfLE inf_le_left).op).hom (t i)) =
      (ν.app _).hom ((C.presheaf.map (homOfLE inf_le_right).op).hom (t k))
    rw [nat, nat, hts, hts, resres, resres]
  obtain ⟨t₀, ht₀, -⟩ := TopCat.Sheaf.existsUnique_gluing' C.sheaf O V
    (fun i => homOfLE (hO i)) hcov t hcomp
  refine ⟨t₀, ?_⟩
  apply TopCat.Sheaf.eq_of_locally_eq' Ct.sheaf (fun i => ν ⁻¹ᵁ O i) (ν ⁻¹ᵁ V)
    (fun i => homOfLE (fun _ hx => hO i hx)) hcov'
  intro i
  have e1 := nat (O i) V (hO i) t₀
  have e3 : (C.presheaf.map (homOfLE (hO i)).op).hom t₀ = t i := ht₀ i
  rw [e3] at e1
  exact e1.symm.trans (hts i)

theorem wcpa_dj_nn_node_fibres : (∀ (Ω : Type u) [Field Ω] (A B : Type u) [CommRing A] [IsLocalRing A]
      [IsNoetherianRing A] [CommRing B] (φ : Ω →+* A) (j : A →+* B) (d : A),
      (∃ e : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+*
          (MvPowerSeries (Fin 2) Ω ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
        e.toRingHom.comp ((algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)).comp φ) =
          (Ideal.Quotient.mk _).comp MvPowerSeries.C) →
      ringKrullDim A ≤ 1 → Function.Injective j → j.Finite → d ∈ IsLocalRing.maximalIdeal A →
      d ∈ nonZeroDivisors A → j d ∈ nonZeroDivisors B → (∀ b : B, ∃ a : A, j a = j d * b) →
      (∀ (Q : Ideal B) [Q.IsPrime], IsDomain (Localization.AtPrime Q) ∧
        IsIntegrallyClosed (Localization.AtPrime Q)) →
      ∃ χ₀ χ₁ : B →+* Ω, χ₀.comp (j.comp φ) = RingHom.id Ω ∧ χ₁.comp (j.comp φ) = RingHom.id Ω ∧
        RingHom.ker χ₀ ≠ RingHom.ker χ₁ ∧
        (∀ M : Ideal B, M.IsMaximal → M = RingHom.ker χ₀ ∨ M = RingHom.ker χ₁) ∧
        ∀ b : B, (∃ a : A, j a = b) ↔ χ₀ b = χ₁ b) →
    ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (C : Scheme.{u})
    (c : C ⟶ Spec (.of Ω)) (U : C.Opens) (Ct : Scheme.{u}) (ν : Ct ⟶ C), IsProper c →
    (∀ w : C, w ∈ U ↔ ∃ W : C.Opens, w ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ c)) →
    (∀ w : C, w ∉ U → ∃ e : AdicCompletion (IsLocalRing.maximalIdeal (C.presheaf.stalk w))
        (C.presheaf.stalk w) ≃+*
        (MvPowerSeries (Fin 2) Ω ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
      e.toRingHom.comp ((algebraMap (C.presheaf.stalk w) (AdicCompletion
        (IsLocalRing.maximalIdeal (C.presheaf.stalk w)) (C.presheaf.stalk w))).comp
        ((Scheme.ΓSpecIso (.of Ω)).inv ≫ c.appTop ≫ C.presheaf.germ ⊤ w trivial).hom) =
        (Ideal.Quotient.mk _).comp MvPowerSeries.C) →
    IsFinite ν → Surjective ν → IsIso (ν ∣_ U) →
    (∀ x : Ct, IsDomain (Ct.presheaf.stalk x) ∧ IsIntegrallyClosed (Ct.presheaf.stalk x)) →
    (∀ x : Ct, ∃ x' : Ct, x' ⤳ x ∧ ν x' ∈ U) →
    ∃ (m : ℕ) (y : Fin m × Fin 2 → (Spec (.of Ω) ⟶ Ct)),
      (∀ a, y a ≫ ν ≫ c = 𝟙 _) ∧
      (∀ (a b : Fin m × Fin 2) (p q : ↥(Spec (.of Ω))), a ≠ b → y a p ≠ y b q) ∧
      (∀ e : Fin m, y (e, 0) ≫ ν = y (e, 1) ≫ ν) ∧
      (∀ x : Ct, ν x ∉ U ↔ ∃ (a : Fin m × Fin 2) (p : ↥(Spec (.of Ω))), x = y a p) ∧
      (∀ x x' : Ct, ν x = ν x' → x = x' ∨ ∃ (e : Fin m) (p q : ↥(Spec (.of Ω))),
        (x = y (e, 0) p ∧ x' = y (e, 1) q) ∨ (x = y (e, 1) p ∧ x' = y (e, 0) q)) ∧
      (∀ V : C.affineOpens, Function.Injective (ν.app V.1).hom ∧
        ∀ s : Γ(Ct, ν ⁻¹ᵁ V.1), (∀ (e : Fin m) (h₀ : ⊤ ≤ y (e, 0) ⁻¹ᵁ (ν ⁻¹ᵁ V.1))
          (h₁ : ⊤ ≤ y (e, 1) ⁻¹ᵁ (ν ⁻¹ᵁ V.1)),
          ((y (e, 0)).appLE (ν ⁻¹ᵁ V.1) ⊤ h₀).hom s = ((y (e, 1)).appLE (ν ⁻¹ᵁ V.1) ⊤ h₁).hom s) →
          ∃ t : Γ(C, V.1), (ν.app V.1).hom t = s) :=
by
  intro hR Ω _ _ C c U Ct ν hprop hU hnode hfin hsurj hiso hnorm hgen
  classical
  haveI := hprop
  haveI hlft : LocallyOfFiniteType c := inferInstance
  haveI : IsLocallyNoetherian C := LocallyOfFiniteType.isLocallyNoetherian c

  have hres : ∀ w : C, w ∉ U → ∀ a : C.presheaf.stalk w, ∃ z : Ω,
      a - ((Scheme.ΓSpecIso (.of Ω)).inv ≫ c.appTop ≫ C.presheaf.germ ⊤ w trivial).hom z ∈
        IsLocalRing.maximalIdeal (C.presheaf.stalk w) :=
    fun w hw => wcpa_dj_nf_node_residue Ω (C.presheaf.stalk w) _ (hnode w hw)
  obtain ⟨hcl, hfinU⟩ := wcpa_dj_nf_nodes_closed_finite Ω C c U hprop hres
  haveI := hfinU.to_subtype
  obtain ⟨m, ⟨pt⟩⟩ : ∃ m : ℕ, Nonempty (Fin m ≃ ↥((U : Set C)ᶜ)) :=
    ⟨_, ⟨(Finite.equivFin _).symm⟩⟩
  have hpU : ∀ e : Fin m, (pt e : C) ∉ U := fun e h => (pt e).2 h
  have hpt_of : ∀ p : C, p ∉ U → ∃ e : Fin m, (pt e : C) = p := fun p hp =>
    ⟨pt.symm ⟨p, hp⟩, by rw [Equiv.apply_symm_apply]⟩

  have hVex : ∀ e : Fin m, ∃ V : C.Opens, IsAffineOpen V ∧ (pt e : C) ∈ V := by
    intro e
    obtain ⟨W, hW, hpW, -⟩ :=
      exists_isAffineOpen_mem_and_subset (show (pt e : C) ∈ (⊤ : C.Opens) from trivial)
    exact ⟨W, hW, hpW⟩
  choose V hVa hpV using hVex

  choose j hj hjfin using fun e => wcpa_dj_nf_loc_map C Ct ν (V e) (hVa e) (pt e) (hpV e) hfin
  have hnormB := fun e => wcpa_dj_nf_loc_normal C Ct ν (V e) (hVa e) (pt e) (hpV e) hfin hnorm
  have hgenB := fun e => wcpa_dj_nf_loc_generic C Ct ν U (V e) (hVa e) (pt e) (hpV e) (j e)
    hfin hsurj (hpU e) hgen (hj e)
  have hisoB := fun e => wcpa_dj_nf_loc_iso C Ct ν U (V e) (hVa e) (pt e) (hpV e) (j e)
    hfin hiso hcl (hj e)
  have hred := fun e => wcpa_dj_nf_node_reduced Ω (C.presheaf.stalk (pt e)) _ (hnode _ (hpU e))
  have hdim := fun e => wcpa_dj_nf_node_dim_le_one Ω C c U hlft hU hcl (pt e) (hpU e)
  have hcond := fun e => haveI := hred e
    wcpa_dj_nf_conductor (C.presheaf.stalk (pt e)) _ (j e) (hjfin e) (hdim e) (hgenB e).1
      (by intro Q _; exact (hnormB e Q).1) (hgenB e).2 (hisoB e).1 (hisoB e).2
  choose hjinj d hdm hdA hdB hdcond using hcond

  choose χ₀ χ₁ hid0 hid1 hker hmax hsep using fun e =>
    hR Ω (C.presheaf.stalk (pt e)) _ _ (j e) (d e) (hnode _ (hpU e)) (hdim e) (hjinj e)
      (hjfin e) (hdm e) (hdA e) (hdB e) (hdcond e) (hnormB e)

  choose y0 hsec0 hpt0 hval0 using fun e =>
    wcpa_dj_nf_point_of_char Ω C Ct c ν (V e) (hVa e) (pt e) (hpV e) (j e) (χ₀ e) hfin (hj e)
      (hid0 e)
  choose y1 hsec1 hpt1 hval1 using fun e =>
    wcpa_dj_nf_point_of_char Ω C Ct c ν (V e) (hVa e) (pt e) (hpV e) (j e) (χ₁ e) hfin (hj e)
      (hid1 e)
  have hfib := fun e => wcpa_dj_nf_fibre_points Ω C Ct ν (V e) (hVa e) (pt e) (hpV e) (j e)
    hfin (hjfin e) (hj e)
  let y : Fin m × Fin 2 → (Spec (.of Ω) ⟶ Ct) := fun a => ![y0 a.1, y1 a.1] a.2
  have hsec : ∀ a, y a ≫ ν ≫ c = 𝟙 _ := by
    rintro ⟨e, i⟩
    fin_cases i
    · exact hsec0 e
    · exact hsec1 e
  have hpt : ∀ a (q : ↥(Spec (.of Ω))), ν (y a q) = pt a.1 := by
    rintro ⟨e, i⟩ q
    fin_cases i
    · exact hpt0 e q
    · exact hpt1 e q
  have hd : ∀ x : Ct, ν x ∉ U ↔ ∃ (a : Fin m × Fin 2) (p : ↥(Spec (.of Ω))), x = y a p := by
    intro x
    constructor
    · intro hx
      obtain ⟨e, he⟩ := hpt_of (ν x) hx
      obtain ⟨M, hMmax, hM⟩ := (hfib e).1 x he.symm
      rcases hmax e M hMmax with h | h
      · exact ⟨(e, 0), IsLocalRing.closedPoint Ω,
          (hM (χ₀ e) (y0 e) (hpt0 e) (hval0 e) h.symm (IsLocalRing.closedPoint Ω)).symm⟩
      · exact ⟨(e, 1), IsLocalRing.closedPoint Ω,
          (hM (χ₁ e) (y1 e) (hpt1 e) (hval1 e) h.symm (IsLocalRing.closedPoint Ω)).symm⟩
    · rintro ⟨a, p, rfl⟩
      rw [hpt a p]
      exact hpU a.1
  have hsame : ∀ (a b : Fin m × Fin 2) (p q : ↥(Spec (.of Ω))), ν (y a p) = ν (y b q) →
      a.1 = b.1 := by
    intro a b p q h
    apply pt.injective
    apply Subtype.ext
    rw [← hpt a p, ← hpt b q, h]
  refine ⟨m, y, hsec, ?_, ?_, hd, ?_, ?_⟩
  ·
    rintro ⟨e, i⟩ ⟨e', i'⟩ p q hab heq
    have hee : e = e' := hsame (e, i) (e', i') p q (by rw [heq])
    subst hee
    fin_cases i <;> fin_cases i'
    · exact hab rfl
    · exact hker e ((hfib e).2 (χ₀ e) (χ₁ e) (y0 e) (y1 e) (hpt0 e) (hpt1 e) (hval0 e) (hval1 e)
        p q heq)
    · exact hker e ((hfib e).2 (χ₀ e) (χ₁ e) (y0 e) (y1 e) (hpt0 e) (hpt1 e) (hval0 e) (hval1 e)
        q p heq.symm)
    · exact hab rfl
  ·
    intro e
    exact wcpa_dj_nf_rational_point_unique Ω C c (pt e) (y0 e ≫ ν) (y1 e ≫ ν)
      (by rw [Category.assoc]; exact hsec0 e) (by rw [Category.assoc]; exact hsec1 e)
      (fun q => by rw [Scheme.Hom.comp_apply]; exact hpt0 e q)
      (fun q => by rw [Scheme.Hom.comp_apply]; exact hpt1 e q) (hres _ (hpU e))
  ·
    intro x x' hxx
    by_cases hx : ν x ∈ U
    · left
      have hx' : ν x' ∈ U := hxx ▸ hx
      haveI := hiso
      obtain ⟨a, rfl⟩ : x ∈ Set.range (ν ⁻¹ᵁ U).ι := by rw [Scheme.Opens.range_ι]; exact hx
      obtain ⟨a', rfl⟩ : x' ∈ Set.range (ν ⁻¹ᵁ U).ι := by
        rw [Scheme.Opens.range_ι]; exact hx'
      have e1 : ∀ z, U.ι ((ν ∣_ U) z) = ν ((ν ⁻¹ᵁ U).ι z) := by
        intro z
        rw [← Scheme.Hom.comp_apply, morphismRestrict_ι, Scheme.Hom.comp_apply]
      have h2 : (ν ∣_ U) a = (ν ∣_ U) a' :=
        U.ι.isOpenEmbedding.injective (by rw [e1, e1, hxx])
      rw [(ν ∣_ U).isOpenEmbedding.injective h2]
    · obtain ⟨⟨e, i⟩, p, rfl⟩ := (hd x).1 hx
      obtain ⟨⟨e', i'⟩, q, rfl⟩ := (hd x').1 (hxx ▸ hx)
      have hee : e = e' := hsame (e, i) (e', i') p q hxx
      subst hee
      fin_cases i <;> fin_cases i'
      · left; rw [Subsingleton.elim p q]
      · right; exact ⟨e, p, q, Or.inl ⟨rfl, rfl⟩⟩
      · right; exact ⟨e, p, q, Or.inr ⟨rfl, rfl⟩⟩
      · left; rw [Subsingleton.elim p q]
  ·
    intro W
    refine wcpa_dj_nf_sections_glue C Ct ν W.1
      (fun s => ∀ (e : Fin m) (h₀ : ⊤ ≤ y (e, 0) ⁻¹ᵁ (ν ⁻¹ᵁ W.1))
          (h₁ : ⊤ ≤ y (e, 1) ⁻¹ᵁ (ν ⁻¹ᵁ W.1)),
          ((y (e, 0)).appLE (ν ⁻¹ᵁ W.1) ⊤ h₀).hom s = ((y (e, 1)).appLE (ν ⁻¹ᵁ W.1) ⊤ h₁).hom s)
      ?_ ?_
    · intro p hpW O hpO t ht
      by_cases hp : p ∈ U
      · exact (wcpa_dj_nf_local_U C Ct ν U hiso p hp).1 O hpO t ht
      · obtain ⟨e, rfl⟩ := hpt_of p hp
        exact (wcpa_dj_nf_local_node Ω C Ct ν (V e) (hVa e) (pt e) (hpV e) (j e) (χ₀ e) (χ₁ e)
          (y0 e) (y1 e) hfin (hj e) (hjinj e) (hsep e) (hpt0 e) (hpt1 e) (hval0 e)
          (hval1 e)).1 O hpO t ht
    · intro p hpW s hs
      by_cases hp : p ∈ U
      · exact (wcpa_dj_nf_local_U C Ct ν U hiso p hp).2 W.1 hpW s
      · obtain ⟨e, rfl⟩ := hpt_of p hp
        exact (wcpa_dj_nf_local_node Ω C Ct ν (V e) (hVa e) (pt e) (hpV e) (j e) (χ₀ e) (χ₁ e)
          (y0 e) (y1 e) hfin (hj e) (hjinj e) (hsep e) (hpt0 e) (hpt1 e) (hval0 e)
          (hval1 e)).2 W.1 hpW s (fun h₀ h₁ => hs e h₀ h₁)

theorem wcpa_dj_lr1_normalize_nodal : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (C : Scheme.{u})
    (c : C ⟶ Spec (.of Ω)) (n : ℕ) (x : Fin n → (Spec (.of Ω) ⟶ C)),
    wcpaDjIsProjOver Ω c → wcpaDjSemistable c → wcpaDjSections c n x →
    ∃ (Ct : Scheme.{u}) (ct : Ct ⟶ Spec (.of Ω)) (ν : Ct ⟶ C) (m : ℕ)
      (r : (Fin m × Fin 2) ⊕ Fin n → (Spec (.of Ω) ⟶ Ct)),
      wcpaDjIsProjOver Ω ct ∧ SmoothOfRelativeDimension 1 ct ∧ ν ≫ c = ct ∧
      (∀ a, r a ≫ ct = 𝟙 _) ∧
      (∀ (a b : (Fin m × Fin 2) ⊕ Fin n) (p q : ↥(Spec (.of Ω))), a ≠ b → r a p ≠ r b q) ∧
      (∀ i, r (Sum.inr i) ≫ ν = x i) ∧
      IsPushout (Limits.Sigma.desc fun e2 : Fin m × Fin 2 => r (Sum.inl e2))
        (Limits.Sigma.desc fun e2 : Fin m × Fin 2 =>
          Limits.Sigma.ι (fun _ : Fin m => Spec (.of Ω)) e2.1)
        ν (Limits.Sigma.desc fun e : Fin m => r (Sum.inl (e, 0)) ≫ ν) :=
by
  intro Ω _ _ C c n x hc hss hsec

  have hprop : IsProper c := hss.2.1
  obtain ⟨U, hU⟩ : ∃ U : C.Opens,
      ∀ w : C, w ∈ U ↔ ∃ W : C.Opens, w ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ c) := by
    refine ⟨sSup {W : C.Opens | SmoothOfRelativeDimension 1 (W.ι ≫ c)}, fun w => ?_⟩
    rw [TopologicalSpace.Opens.mem_sSup]
    constructor
    · rintro ⟨W, hW, hw⟩
      exact ⟨W, hw, hW⟩
    · rintro ⟨W, hw, hW⟩
      exact ⟨W, hW, hw⟩
  let Φ : C ≅ Limits.pullback c (𝟙 (Spec (.of Ω))) :=
    { hom := Limits.pullback.lift (𝟙 C) c (by rw [Category.id_comp, Category.comp_id])
      inv := Limits.pullback.fst c (𝟙 _)
      hom_inv_id := Limits.pullback.lift_fst _ _ _
      inv_hom_id := by
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, Limits.pullback.lift_fst, Category.comp_id, Category.id_comp]
        · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.condition,
            Category.comp_id, Category.id_comp] }
  have hΦ : Φ.hom ≫ Limits.pullback.snd c (𝟙 _) = c := Limits.pullback.lift_snd _ _ _
  have hnode : ∀ w : C, w ∉ U → ∃ e : AdicCompletion (IsLocalRing.maximalIdeal (C.presheaf.stalk w))
        (C.presheaf.stalk w) ≃+*
        (MvPowerSeries (Fin 2) Ω ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
      e.toRingHom.comp ((algebraMap (C.presheaf.stalk w) (AdicCompletion
        (IsLocalRing.maximalIdeal (C.presheaf.stalk w)) (C.presheaf.stalk w))).comp
        ((Scheme.ΓSpecIso (.of Ω)).inv ≫ c.appTop ≫ C.presheaf.germ ⊤ w trivial).hom) =
        (Ideal.Quotient.mk _).comp MvPowerSeries.C := by
    intro w hw
    rcases wcpa_dj_ssp_bw_ns_transport Ω Φ c (Limits.pullback.snd c (𝟙 _)) hΦ w
      (hss.2.2 Ω (𝟙 _) (Φ.hom w)) with h | h
    · exact absurd ((hU w).2 h) hw
    · exact h

  obtain ⟨Ct, ν, hfin, hsurj, hiso, hnorm, hgen⟩ :=
    wcpa_dj_nn_normalization Ω C c U hprop hU hnode
  have hsm : SmoothOfRelativeDimension 1 (ν ≫ c) :=
    wcpa_dj_nn_normal_smooth Ω C c U Ct ν hprop hU hnode hfin hiso hnorm hgen
  obtain ⟨m, y, hys, hyd, hyeq, hyU, hfib, hsecs⟩ :=
    wcpa_dj_nn_node_fibres wcpa_dj_nn_node_ring Ω C c U Ct ν hprop hU hnode hfin hsurj hiso
      hnorm hgen
  have hproj : wcpaDjIsProjOver Ω (ν ≫ c) := wcpa_dj_gs_finite_proj Ω ν c hfin hc

  have hxinU : ∀ i (q : ↥(Spec (.of Ω))), x i q ∈ U := by
    intro i q
    obtain ⟨W, hW, hWsm⟩ := hsec.2.2 i q
    exact (hU _).2 ⟨W, hW, hWsm⟩
  have hxU : ∀ i, Set.range (x i).base ⊆ Set.range U.ι.base := by
    rintro i z ⟨q, rfl⟩
    rw [Scheme.Opens.range_ι]
    exact hxinU i q
  haveI := hiso
  let rx : Fin n → (Spec (.of Ω) ⟶ Ct) := fun i =>
    IsOpenImmersion.lift U.ι (x i) (hxU i) ≫ inv (ν ∣_ U) ≫ (ν ⁻¹ᵁ U).ι
  have hrx : ∀ i, rx i ≫ ν = x i := by
    intro i
    simp only [rx, Category.assoc]
    rw [← morphismRestrict_ι, IsIso.inv_hom_id_assoc, IsOpenImmersion.lift_fac]
  have hpt : ∀ i (q : ↥(Spec (.of Ω))), ν (rx i q) = x i q := by
    intro i q
    rw [← Scheme.Hom.comp_apply, hrx i]
  refine ⟨Ct, ν ≫ c, ν, m, Sum.elim y rx, hproj, hsm, rfl, ?_, ?_, ?_, ?_⟩
  · rintro (a | i)
    · exact hys a
    · show rx i ≫ ν ≫ c = 𝟙 _
      rw [← Category.assoc, hrx i]
      exact hsec.1 i
  · rintro (a | i) (b | j) p q hab
    · exact hyd a b p q (fun h => hab (by rw [h]))
    · intro h
      apply (hyU (y a p)).2 ⟨a, p, rfl⟩
      have h' : y a p = rx j q := h
      rw [h', hpt]
      exact hxinU j q
    · intro h
      apply (hyU (y b q)).2 ⟨b, q, rfl⟩
      have h' : rx i p = y b q := h
      rw [← h', hpt]
      exact hxinU i p
    · intro h
      have h' : rx i p = rx j q := h
      apply hsec.2.1 i j p q (fun hij => hab (by rw [hij]))
      rw [← hpt i p, ← hpt j q, h']
  · intro i
    exact hrx i
  · exact wcpa_dj_nn_pinch_pushout Ω C Ct ν m y hfin hsurj hyd hyeq hfib hsecs

theorem wcpa_cl_common_affine : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (Zt : Scheme.{u})
    (ut : Zt ⟶ Spec (.of R)),
    (∃ (N : ℕ) (j : Zt ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
        MvPolynomial.gradedAlgebra), IsClosedImmersion j ∧
      j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
        MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
          (algebraMap R ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R 0))) = ut) →
    ∀ (ι : Type) [Finite ι] (σ : ι → (Spec (.of R) ⟶ Zt)), (∀ a, σ a ≫ ut = 𝟙 _) →
    ∃ U : Zt.Opens, IsAffineOpen U ∧ ∀ a, Set.range (σ a) ⊆ (U : Set Zt) :=
by
  intro R _ _ Zt ut hj ι _ σ _
  obtain ⟨N, j, hj, -⟩ := hj
  classical
  haveI := Fintype.ofFinite ι

  have key : ∀ {A : Type u} {σ : Type u} [CommRing A] [SetLike σ A] [AddSubmonoidClass σ A]
      (𝒜 : ℕ → σ) [GradedRing 𝒜] {ι : Type} [Fintype ι] (y : ι → ProjectiveSpectrum 𝒜),
      ∃ (m : ℕ) (f : A), 0 < m ∧ f ∈ 𝒜 m ∧ ∀ a, f ∉ (y a).asHomogeneousIdeal.toIdeal := by
    intro A σ _ _ _ 𝒜 _ ι _ y
    have comp : ∀ (p : Ideal A) (b : A), b ∉ p →
        ∃ i, ((DirectSum.decompose 𝒜 b i : 𝒜 i) : A) ∉ p := by
      intro p b hb
      by_contra h
      push_neg at h
      apply hb
      have e := DirectSum.sum_support_decompose 𝒜 b
      rw [← e]
      exact Ideal.sum_mem _ (fun i _ => h i)
    set s : Finset (Ideal A) := Finset.univ.image (fun a => (y a).asHomogeneousIdeal.toIdeal)
      with hs
    have hprime : ∀ p ∈ s, p.IsPrime := by
      intro p hp
      obtain ⟨a, _, rfl⟩ := Finset.mem_image.mp hp
      exact (y a).isPrime
    have hpos : ∀ p ∈ s, ∃ (i : ℕ) (z : A), 0 < i ∧ z ∈ 𝒜 i ∧ z ∉ p := by
      intro p hp
      obtain ⟨a, _, rfl⟩ := Finset.mem_image.mp hp
      have h := (y a).not_irrelevant_le
      rw [SetLike.not_le_iff_exists] at h
      obtain ⟨b, hb, hbx⟩ := h
      obtain ⟨i, hi⟩ := comp _ b hbx
      refine ⟨i, _, ?_, SetLike.coe_mem _, hi⟩
      rcases Nat.eq_zero_or_pos i with h0 | h0
      · exfalso
        subst h0
        apply hi
        rw [← GradedRing.proj_apply, (HomogeneousIdeal.mem_irrelevant_iff 𝒜 b).mp hb]
        exact Ideal.zero_mem _
      · exact h0
    have hwit : ∀ p ∈ s, ∀ q ∈ s, ¬ q ≤ p → ∃ (k : ℕ) (w : A), w ∈ 𝒜 k ∧ w ∈ q ∧ w ∉ p := by
      intro p hp q hq hqp
      obtain ⟨b, _, rfl⟩ := Finset.mem_image.mp hq
      rw [SetLike.not_le_iff_exists] at hqp
      obtain ⟨c, hcq, hcp⟩ := hqp
      obtain ⟨i, hi⟩ := comp _ c hcp
      exact ⟨i, _, SetLike.coe_mem _, ((y b).asHomogeneousIdeal.isHomogeneous.mem_iff 𝒜).mp hcq i,
        hi⟩
    set M := s.filter (fun p => Maximal (· ∈ s) p) with hM
    have hMs : ∀ p ∈ M, p ∈ s := fun p hp => (Finset.mem_filter.mp hp).1
    have hinc : ∀ p ∈ M, ∀ q ∈ M, q ≠ p → ¬ q ≤ p := by
      intro p hp q hq hne hle
      have hqmax := (Finset.mem_filter.mp hq).2
      exact hne (le_antisymm hle (hqmax.2 (hMs p hp) hle))
    have hpos' : ∀ p : Ideal A, ∃ (i : ℕ) (z : A), p ∈ s → (0 < i ∧ z ∈ 𝒜 i ∧ z ∉ p) := by
      intro p
      by_cases hp : p ∈ s
      · obtain ⟨i, z, h⟩ := hpos p hp
        exact ⟨i, z, fun _ => h⟩
      · exact ⟨0, 0, fun h => absurd h hp⟩
    have hwit' : ∀ p q : Ideal A, ∃ (k : ℕ) (w : A),
        p ∈ s → q ∈ s → ¬ q ≤ p → (w ∈ 𝒜 k ∧ w ∈ q ∧ w ∉ p) := by
      intro p q
      by_cases h : p ∈ s ∧ q ∈ s ∧ ¬ q ≤ p
      · obtain ⟨k, w, hw⟩ := hwit p h.1 q h.2.1 h.2.2
        exact ⟨k, w, fun _ _ _ => hw⟩
      · exact ⟨0, 0, fun h1 h2 h3 => absurd ⟨h1, h2, h3⟩ h⟩
    choose iz z hz using hpos'
    choose ky yy hy using hwit'
    let x : Ideal A → A := fun p => z p * ∏ q ∈ M.erase p, yy p q
    let d : Ideal A → ℕ := fun p => iz p + ∑ q ∈ M.erase p, ky p q
    have hyM : ∀ p ∈ M, ∀ q ∈ M.erase p, yy p q ∈ 𝒜 (ky p q) ∧ yy p q ∈ q ∧ yy p q ∉ p := by
      intro p hp q hq
      have hqM := Finset.mem_of_mem_erase hq
      exact hy p q (hMs p hp) (hMs q hqM) (hinc p hp q hqM (Finset.ne_of_mem_erase hq))
    have hxd : ∀ p ∈ M, x p ∈ 𝒜 (d p) := by
      intro p hp
      exact SetLike.mul_mem_graded (hz p (hMs p hp)).2.1
        (SetLike.prod_mem_graded 𝒜 _ _ (fun q hq => (hyM p hp q hq).1))
    have hdpos : ∀ p ∈ M, 0 < d p := by
      intro p hp
      have := (hz p (hMs p hp)).1
      show 0 < iz p + ∑ q ∈ M.erase p, ky p q
      omega
    have hxp : ∀ p ∈ M, x p ∉ p := by
      intro p hp h
      have hpr := hprime p (hMs p hp)
      rcases Ideal.IsPrime.mem_or_mem hpr h with h1 | h2
      · exact (hz p (hMs p hp)).2.2 h1
      · obtain ⟨q, hq, hqp⟩ := Ideal.IsPrime.prod_mem_iff.mp h2
        exact (hyM p hp q hq).2.2 hqp
    have hxq : ∀ p ∈ M, ∀ q ∈ M, q ≠ p → x p ∈ q := by
      intro p hp q hq hqp
      have hqe : q ∈ M.erase p := Finset.mem_erase.mpr ⟨hqp, hq⟩
      apply Ideal.mul_mem_left
      rw [← Finset.mul_prod_erase (M.erase p) _ hqe]
      exact Ideal.mul_mem_right _ _ (hyM p hp q hqe).2.1
    let D : ℕ := ∏ p ∈ M, d p
    have hD : 0 < D := Finset.prod_pos (fun p hp => hdpos p hp)
    let e : Ideal A → ℕ := fun p => D / d p
    have hed : ∀ p ∈ M, e p * d p = D := fun p hp =>
      Nat.div_mul_cancel (Finset.dvd_prod_of_mem d hp)
    have hepos : ∀ p ∈ M, 0 < e p := fun p hp =>
      Nat.div_pos (Nat.le_of_dvd hD (Finset.dvd_prod_of_mem d hp)) (hdpos p hp)
    refine ⟨D, ∑ p ∈ M, x p ^ e p, hD, ?_, ?_⟩
    · refine sum_mem (fun p hp => ?_)
      have := SetLike.pow_mem_graded (e p) (hxd p hp)
      rwa [smul_eq_mul, hed p hp] at this
    · intro a hf0
      have hp₀ : (y a).asHomogeneousIdeal.toIdeal ∈ s :=
        Finset.mem_image_of_mem _ (Finset.mem_univ a)
      obtain ⟨m₀, hle, hmax⟩ := Finset.exists_le_maximal s hp₀
      have hm₀ : m₀ ∈ M := Finset.mem_filter.mpr ⟨hmax.1, hmax⟩
      have hf1 := hle hf0
      rw [← Finset.add_sum_erase M _ hm₀] at hf1
      have hrest : ∑ p ∈ M.erase m₀, x p ^ e p ∈ m₀ := by
        refine Ideal.sum_mem _ (fun p hp => ?_)
        have hpM := Finset.mem_of_mem_erase hp
        exact Ideal.pow_mem_of_mem _ (hxq p hpM m₀ hm₀ (Finset.ne_of_mem_erase hp).symm) _
          (hepos p hpM)
      have h2 := (Ideal.add_mem_iff_left _ hrest).mp hf1
      exact hxp m₀ hm₀ ((hprime m₀ hmax.1).mem_of_pow_mem _ h2)

  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) :=
    MvPolynomial.gradedAlgebra
  let pt : Spec (.of R) := IsLocalRing.closedPoint R
  obtain ⟨D, f, hD, hf, hfa⟩ := key (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
    (fun a => j (σ a pt))
  haveI : IsAffineHom j := inferInstance
  refine ⟨j ⁻¹ᵁ (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) f),
    (Proj.isAffineOpen_basicOpen _ f hf hD).preimage j, ?_⟩
  intro a
  rintro _ ⟨p, rfl⟩
  have hsp : σ a p ⤳ σ a pt := (IsLocalRing.specializes_closedPoint p).map (σ a).continuous
  have hpt : σ a pt ∈ j ⁻¹ᵁ (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) f) := by
    rw [Scheme.Hom.mem_preimage, Proj.mem_basicOpen]
    exact hfa a
  exact hsp.mem_open (TopologicalSpace.Opens.isOpen _) hpt

theorem wcpa_cl_pinch_exists : ∀ (R : Type u) [CommRing R] (Zt : Scheme.{u})
    (ut : Zt ⟶ Spec (.of R)) [IsSeparated ut] (m : ℕ)
    (σ : Fin m × Fin 2 → (Spec (.of R) ⟶ Zt)), (∀ a, σ a ≫ ut = 𝟙 _) →
    (∀ (a b : Fin m × Fin 2) (p q : ↥(Spec (.of R))), a ≠ b → σ a p ≠ σ b q) →
    ∀ U : Zt.Opens, IsAffineOpen U → (∀ a, Set.range (σ a) ⊆ (U : Set Zt)) →
    ∃ (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of R)) (π : Zt ⟶ Z) (O : Zt.Opens) (V O' : Z.Opens),
      wcpaClPinch ut uu m σ π O U V O' :=
by

  have S2 : ∀ (R : Type u) [CommRing R] (Zt : Scheme.{u}) (ut : Zt ⟶ Spec (.of R))
      [IsSeparated ut] (ι : Type) [Finite ι] (σ : ι → (Spec (.of R) ⟶ Zt)),
      (∀ a, σ a ≫ ut = 𝟙 _) → ∃ O : Zt.Opens, ∀ x : ↥Zt, x ∈ O ↔ ∀ a, x ∉ Set.range (σ a) := by
    intro R _ Zt ut _ ι _ σ hσ
    have hcl : ∀ a, IsClosed (Set.range (σ a)) := by
      intro a
      have : IsClosedImmersion (σ a ≫ ut) := by rw [hσ a]; infer_instance
      have : IsClosedImmersion (σ a) := IsClosedImmersion.of_comp (σ a) ut
      exact (σ a).isClosedEmbedding.isClosed_range
    refine ⟨⟨(⋃ a, Set.range (σ a))ᶜ, (isClosed_iUnion_of_finite hcl).isOpen_compl⟩, fun x => ?_⟩
    show x ∈ (⋃ a, Set.range (σ a))ᶜ ↔ _
    exact ⟨fun h a ha => h (Set.mem_iUnion.mpr ⟨a, ha⟩),
      fun h hx => by obtain ⟨a, ha⟩ := Set.mem_iUnion.mp hx; exact h a ha⟩

  have S4 : ∀ {X Y W : Scheme.{u}} (p : W ⟶ X) (q : W ⟶ Y) [IsOpenImmersion p]
      [IsOpenImmersion q],
      (∀ z : ↥(Limits.pushout p q), z ∈ Set.range (Limits.pushout.inl p q) ∨
        z ∈ Set.range (Limits.pushout.inr p q)) ∧
      ∀ (a : ↥X) (b : ↥Y), Limits.pushout.inl p q a = Limits.pushout.inr p q b →
        ∃ w : ↥W, p w = a ∧ q w = b := by
    intro X Y W p q _ _
    have hι0 : Limits.colimit.ι (Limits.span p q) Limits.WalkingSpan.zero =
        p ≫ Limits.pushout.inl p q := by
      rw [← Limits.colimit.w (Limits.span p q) Limits.WalkingSpan.Hom.fst, Limits.span_map_fst]
    refine ⟨?_, ?_⟩
    · intro x
      obtain ⟨i, xi, hx⟩ := Scheme.IsLocallyDirected.ι_jointly_surjective (Limits.span p q) x
      rcases i with _ | ⟨_ | _⟩
      · left
        refine ⟨p xi, ?_⟩
        rw [← hx]
        change _ = (Limits.colimit.ι (Limits.span p q) Limits.WalkingSpan.zero) xi
        rw [hι0, Scheme.Hom.comp_apply]
      · left
        exact ⟨xi, hx⟩
      · right
        exact ⟨xi, hx⟩
    · intro a b hab
      obtain ⟨k, fi, fj, z, hz1, hz2⟩ :=
        (Scheme.IsLocallyDirected.ι_eq_ι_iff (Limits.span p q) (i := Limits.WalkingSpan.left)
          (j := Limits.WalkingSpan.right)).mp hab
      rcases k with _ | ⟨_ | _⟩
      · have hfi : fi = Limits.WalkingSpan.Hom.fst := Subsingleton.elim _ _
        have hfj : fj = Limits.WalkingSpan.Hom.snd := Subsingleton.elim _ _
        subst hfi hfj
        rw [Limits.span_map_fst] at hz1
        rw [Limits.span_map_snd] at hz2
        exact ⟨z, hz1, hz2⟩
      · obtain ⟨⟩ : Limits.WidePushoutShape.Hom (some Limits.WalkingPair.left)
          (some Limits.WalkingPair.right) := fj
      · obtain ⟨⟩ : Limits.WidePushoutShape.Hom (some Limits.WalkingPair.right)
          (some Limits.WalkingPair.left) := fi

  have S5 : ∀ {X T S : Scheme.{u}} (O : X.Opens) (φ : S ⟶ X) [IsOpenImmersion φ],
      (∀ x : ↥X, x ∈ O ∨ x ∈ Set.range φ) →
      (∀ (fO : (O : Scheme.{u}) ⟶ T) (fS : S ⟶ T), (φ ∣_ O) ≫ fO = (φ ⁻¹ᵁ O).ι ≫ fS →
        ∃ π : X ⟶ T, O.ι ≫ π = fO ∧ φ ≫ π = fS) ∧
      (∀ g₁ g₂ : X ⟶ T, O.ι ≫ g₁ = O.ι ≫ g₂ → φ ≫ g₁ = φ ≫ g₂ → g₁ = g₂) := by
    intro X T S O φ _ hcov
    let obj : Bool → Scheme.{u} := fun b => cond b (O : Scheme.{u}) S
    let mp : (b : Bool) → obj b ⟶ X := fun b =>
      match b with
      | true => O.ι
      | false => φ
    have hmp : ∀ b, IsOpenImmersion (mp b) := by
      intro b
      cases b
      · exact (inferInstance : IsOpenImmersion φ)
      · exact (inferInstance : IsOpenImmersion O.ι)
    have hsurj : ∀ x : X, ∃ (b : Bool) (y : obj b), mp b y = x := by
      intro x
      rcases hcov x with h | ⟨s, hs⟩
      · exact ⟨true, (⟨x, h⟩ : (O : Scheme.{u})), rfl⟩
      · exact ⟨false, s, hs⟩
    let 𝒰 : X.OpenCover := Scheme.Cover.mkOfCovers Bool obj mp hsurj hmp
    have sq : IsPullback (φ ∣_ O) (φ ⁻¹ᵁ O).ι O.ι φ := isPullback_morphismRestrict φ O
    refine ⟨?_, ?_⟩
    · intro fO fS hc
      let F : (b : Bool) → 𝒰.X b ⟶ T := fun b =>
        match b with
        | true => fO
        | false => fS
      have hcompat : ∀ x y : 𝒰.I₀, Limits.pullback.fst (𝒰.f x) (𝒰.f y) ≫ F x =
          Limits.pullback.snd (𝒰.f x) (𝒰.f y) ≫ F y := by
        intro x y
        cases x <;> cases y
        · show Limits.pullback.fst φ φ ≫ fS = Limits.pullback.snd φ φ ≫ fS
          rw [Limits.fst_eq_snd_of_mono_eq]
        · show Limits.pullback.fst φ O.ι ≫ fS = Limits.pullback.snd φ O.ι ≫ fO
          rw [← cancel_epi sq.flip.isoPullback.hom]
          simp only [← Category.assoc, IsPullback.isoPullback_hom_fst,
            IsPullback.isoPullback_hom_snd]
          exact hc.symm
        · show Limits.pullback.fst O.ι φ ≫ fO = Limits.pullback.snd O.ι φ ≫ fS
          rw [← cancel_epi sq.isoPullback.hom]
          simp only [← Category.assoc, IsPullback.isoPullback_hom_fst,
            IsPullback.isoPullback_hom_snd]
          exact hc
        · show Limits.pullback.fst O.ι O.ι ≫ fO = Limits.pullback.snd O.ι O.ι ≫ fO
          rw [Limits.fst_eq_snd_of_mono_eq]
      exact ⟨𝒰.glueMorphisms F hcompat, 𝒰.ι_glueMorphisms F hcompat true,
        𝒰.ι_glueMorphisms F hcompat false⟩
    · intro g₁ g₂ h1 h2
      refine Scheme.Cover.hom_ext 𝒰 _ _ (fun b => ?_)
      cases b
      · exact h2
      · exact h1

  have S6 : ∀ {Zt S Y W' : Scheme.{u}} (O U : Zt.Opens) (φ : S ⟶ Zt) [IsOpenImmersion φ]
      (ψ : S ⟶ Y) (ι₁ : W' ⟶ (O : Scheme.{u})) (ι₂ : W' ⟶ Y) [IsOpenImmersion ι₁]
      [IsOpenImmersion ι₂] (π : Zt ⟶ Limits.pushout ι₁ ι₂), Set.range φ = (U : Set Zt) →
      (∀ x : ↥Zt, x ∈ O ∨ x ∈ U) → O.ι ≫ π = Limits.pushout.inl ι₁ ι₂ →
      φ ≫ π = ψ ≫ Limits.pushout.inr ι₁ ι₂ →
      (∀ z : ↥(Limits.pushout ι₁ ι₂), z ∈ Set.range (Limits.pushout.inl ι₁ ι₂) ∨
        z ∈ Set.range (Limits.pushout.inr ι₁ ι₂)) →
      (∀ (a : ↥(O : Scheme.{u})) (b : ↥Y), Limits.pushout.inl ι₁ ι₂ a =
        Limits.pushout.inr ι₁ ι₂ b → ∃ w : ↥W', ι₁ w = a ∧ ι₂ w = b) →
      (∀ w : ↥W', O.ι (ι₁ w) ∈ U) → (∀ (s : ↥S) (w : ↥W'), ψ s = ι₂ w → φ s ∈ O) →
      (Limits.pushout.inr ι₁ ι₂).opensRange ⊔ (Limits.pushout.inl ι₁ ι₂).opensRange = ⊤ ∧
      (∃ hO : π ⁻¹ᵁ (Limits.pushout.inl ι₁ ι₂).opensRange = O,
        IsIso (π.resLE (Limits.pushout.inl ι₁ ι₂).opensRange O hO.ge)) ∧
      π ⁻¹ᵁ (Limits.pushout.inr ι₁ ι₂).opensRange = U := by
    intro Zt S Y W' O U φ _ ψ ι₁ ι₂ _ _ π hφ hcov hπO hπS H4a H4b hW1 hW2
    have mr : ∀ {A B : Scheme.{u}} (f : A ⟶ B) [IsOpenImmersion f] (z : B),
        z ∈ f.opensRange ↔ z ∈ Set.range f := by
      intro A B f _ z
      rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange]
    have pO : ∀ y : (O : Scheme.{u}), π (O.ι y) = Limits.pushout.inl ι₁ ι₂ y := fun y => by
      rw [← Scheme.Hom.comp_apply, hπO]
    have pS : ∀ s : S, π (φ s) = Limits.pushout.inr ι₁ ι₂ (ψ s) := fun s => by
      rw [← Scheme.Hom.comp_apply, hπS, Scheme.Hom.comp_apply]
    have hUφ : ∀ x : Zt, x ∈ U → ∃ s, φ s = x := fun x hx => by
      rw [← SetLike.mem_coe, ← hφ] at hx
      exact hx
    have hO : π ⁻¹ᵁ (Limits.pushout.inl ι₁ ι₂).opensRange = O := by
      apply le_antisymm
      · intro x hx
        rw [Scheme.Hom.mem_preimage, mr] at hx
        obtain ⟨a, ha⟩ := hx
        by_contra hxO
        have hxU : x ∈ U := (hcov x).resolve_left hxO
        obtain ⟨s, rfl⟩ := hUφ x hxU
        rw [pS] at ha
        obtain ⟨w, hw1, hw2⟩ := H4b a (ψ s) ha
        exact hxO (hW2 s w hw2.symm)
      · intro x hx
        rw [Scheme.Hom.mem_preimage, mr]
        exact ⟨⟨x, hx⟩, (pO ⟨x, hx⟩).symm⟩
    refine ⟨?_, ⟨hO, ?_⟩, ?_⟩
    · refine eq_top_iff.mpr (fun z _ => ?_)
      rcases H4a z with h | h
      · exact TopologicalSpace.Opens.mem_sup.mpr (Or.inr ((mr _ z).mpr h))
      · exact TopologicalSpace.Opens.mem_sup.mpr (Or.inl ((mr _ z).mpr h))
    · have e : π.resLE (Limits.pushout.inl ι₁ ι₂).opensRange O hO.ge =
          (Limits.pushout.inl ι₁ ι₂).isoOpensRange.hom := by
        rw [← cancel_mono (Limits.pushout.inl ι₁ ι₂).opensRange.ι, Scheme.Hom.resLE_comp_ι,
          Scheme.Hom.isoOpensRange_hom_ι, hπO]
      rw [e]
      infer_instance
    · apply le_antisymm
      · intro x hx
        rw [Scheme.Hom.mem_preimage, mr] at hx
        obtain ⟨b, hb⟩ := hx
        by_contra hxU
        have hxO : x ∈ O := (hcov x).resolve_right hxU
        have e1 : π x = Limits.pushout.inl ι₁ ι₂ ⟨x, hxO⟩ := pO ⟨x, hxO⟩
        rw [e1] at hb
        obtain ⟨w, hw1, hw2⟩ := H4b ⟨x, hxO⟩ b hb.symm
        have := hW1 w
        rw [hw1] at this
        exact hxU this
      · intro x hx
        rw [Scheme.Hom.mem_preimage, mr]
        obtain ⟨s, rfl⟩ := hUφ x hx
        exact ⟨ψ s, (pS s).symm⟩

  have S1 : ∀ (R : Type u) [CommRing R] (Zt : Scheme.{u}) (ut : Zt ⟶ Spec (.of R))
      (U : Zt.Opens) (hU : IsAffineOpen U) (σ : Spec (.of R) ⟶ Zt), σ ≫ ut = 𝟙 _ →
      ∀ (h : ⊤ ≤ σ ⁻¹ᵁ U) (h' : U ≤ ut ⁻¹ᵁ ⊤),
      σ = (Spec (.of R)).isoSpec.hom ≫ Spec.map (σ.appLE U ⊤ h) ≫ hU.fromSpec ∧
      ut.appLE ⊤ U h' ≫ σ.appLE U ⊤ h = 𝟙 _ ∧
      hU.fromSpec ≫ ut = Spec.map (ut.appLE ⊤ U h') ≫ (Spec (.of R)).isoSpec.inv ∧
      ∀ x : ↥(Spec Γ(Zt, U)), hU.fromSpec x ∈ Set.range σ ↔
        RingHom.ker (σ.appLE U ⊤ h).hom ≤ x.asIdeal := by
    intro R _ Zt ut U hU σ hσ h h'
    have e1 := IsAffineOpen.SpecMap_appLE_fromSpec σ hU (isAffineOpen_top (Spec (.of R))) h
    rw [IsAffineOpen.fromSpec_top] at e1
    have hi : σ = (Spec (.of R)).isoSpec.hom ≫ Spec.map (σ.appLE U ⊤ h) ≫ hU.fromSpec := by
      rw [e1, ← Category.assoc, Iso.hom_inv_id, Category.id_comp]
    have hii : ut.appLE ⊤ U h' ≫ σ.appLE U ⊤ h = 𝟙 _ := by
      rw [Scheme.Hom.appLE_comp_appLE]
      have key : ∀ (f : Spec (.of R) ⟶ Spec (.of R)), f = 𝟙 _ → ∀ e,
          f.appLE ⊤ ⊤ e = 𝟙 _ := by
        rintro f rfl e
        show Scheme.Hom.appLE (𝟙 _) ⊤ ((𝟙 (Spec (.of R))) ⁻¹ᵁ ⊤) le_rfl = _
        rw [Scheme.Hom.appLE_eq_app, Scheme.Hom.id_app]
      exact key _ hσ _
    have e3 := IsAffineOpen.SpecMap_appLE_fromSpec ut (isAffineOpen_top (Spec (.of R))) hU h'
    rw [IsAffineOpen.fromSpec_top] at e3
    refine ⟨hi, hii, e3.symm, ?_⟩
    intro x
    have hsurj : Function.Surjective (σ.appLE U ⊤ h).hom := fun r =>
      ⟨(ut.appLE ⊤ U h').hom r, by rw [← CommRingCat.comp_apply, hii, CommRingCat.id_apply]⟩
    have hrange := range_comap_of_surjective _ _ hsurj
    have hsp : ∀ y, Spec.map (σ.appLE U ⊤ h) y = PrimeSpectrum.comap (σ.appLE U ⊤ h).hom y :=
      fun y => rfl
    constructor
    · rintro ⟨p, hp⟩
      rw [hi, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at hp
      have h2 := hU.fromSpec.isOpenEmbedding.injective hp
      rw [hsp] at h2
      have h3 : x ∈ Set.range (PrimeSpectrum.comap (σ.appLE U ⊤ h).hom) := ⟨_, h2⟩
      rw [hrange] at h3
      exact h3
    · intro hx
      have h3 : x ∈ PrimeSpectrum.zeroLocus (RingHom.ker (σ.appLE U ⊤ h).hom : Set _) := hx
      rw [← hrange] at h3
      obtain ⟨y, hy⟩ := h3
      let y' : ↥(Spec Γ(Spec (.of R), ⊤)) := y
      refine ⟨(Spec (.of R)).isoSpec.inv y', ?_⟩
      have hyy : (Spec (.of R)).isoSpec.hom ((Spec (.of R)).isoSpec.inv y') = y' := by
        rw [← Scheme.Hom.comp_apply, Iso.inv_hom_id]; rfl
      rw [hi, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hyy, hsp]
      exact congrArg hU.fromSpec hy

  have S3 : ∀ (A : Type u) [CommRing A] (A' : Subring A) (ι : Type) [Finite ι]
      (P : ι → Ideal A), (∀ g : A, (∀ i, g ∈ P i) → g ∈ A') →
      ∀ W : (Spec (.of A)).Opens, (∀ x : ↥(Spec (.of A)), x ∈ W ↔ ∀ i, ¬ P i ≤ x.asIdeal) →
      IsOpenImmersion (W.ι ≫ Spec.map (CommRingCat.ofHom A'.subtype)) ∧
      ∀ (x : ↥W) (y : ↥(Spec (.of A))), Spec.map (CommRingCat.ofHom A'.subtype) (W.ι x) =
        Spec.map (CommRingCat.ofHom A'.subtype) y → y ∈ W := by
    intro A _ A' ι _ P hP W hW
    classical
    have := Fintype.ofFinite ι
    set q := Spec.map (CommRingCat.ofHom A'.subtype) with hq
    have habs : ∀ g : A, (∀ i, g ∈ P i) → ∀ f : A, g * f ∈ A' := fun g hg f =>
      hP _ (fun i => Ideal.mul_mem_right f _ (hg i))
    have hwit : ∀ x : ↥(Spec (.of A)), x ∈ W → ∃ g : A, (∀ i, g ∈ P i) ∧ g ∉ x.asIdeal := by
      intro x hx
      have h1 := (hW x).mp hx
      choose gi hgi using fun i => SetLike.not_le_iff_exists.mp (h1 i)
      refine ⟨∏ i, gi i, fun i => ?_, ?_⟩
      · rw [← Finset.prod_erase_mul _ _ (Finset.mem_univ i)]
        exact Ideal.mul_mem_left _ _ (hgi i).1
      · intro hmem
        obtain ⟨i, _, hi⟩ := (Ideal.IsPrime.prod_mem_iff (hp := x.isPrime)).mp hmem
        exact (hgi i).2 hi
    have hD : ∀ g : A, (∀ i, g ∈ P i) → ∀ y : ↥(Spec (.of A)), g ∉ y.asIdeal → y ∈ W := by
      intro g hg y hy
      rw [hW]
      intro i hle
      exact hy (hle (hg i))
    have hqpt : ∀ y : ↥(Spec (.of A)), (q y).asIdeal = Ideal.comap A'.subtype y.asIdeal :=
      fun y => rfl
    have hfib : ∀ (x y : ↥(Spec (.of A))), x ∈ W → q x = q y → y ∈ W ∧ x = y := by
      intro x y hx hxy
      obtain ⟨g, hg, hgx⟩ := hwit x hx
      have hgA : g ∈ A' := by simpa using habs g hg 1
      have key : ∀ z : ↥(Spec (.of A)), g ∈ z.asIdeal ↔ (⟨g, hgA⟩ : A') ∈ (q z).asIdeal :=
        fun z => by rw [hqpt, Ideal.mem_comap]; rfl
      have hgy : g ∉ y.asIdeal := by
        rw [key, ← hxy, ← key]; exact hgx
      refine ⟨hD g hg y hgy, ?_⟩
      have sub : ∀ (a b : ↥(Spec (.of A))), g ∉ b.asIdeal → q a = q b →
          a.asIdeal ≤ b.asIdeal := by
        intro a b hgb hab r hr
        have h1 : g * r ∈ A' := habs g hg r
        have h2 : (⟨g * r, h1⟩ : A') ∈ (q a).asIdeal := by
          rw [hqpt]; exact Ideal.mem_comap.mpr (Ideal.mul_mem_left _ _ hr)
        rw [hab, hqpt, Ideal.mem_comap] at h2
        exact (b.isPrime.mem_or_mem h2).resolve_left hgb
      exact PrimeSpectrum.ext (le_antisymm (sub x y hgy hxy) (sub y x hgx hxy.symm))
    have hιW : ∀ x : ↥W, W.ι x ∈ W := fun x => by
      have : W.ι x ∈ Set.range W.ι := ⟨x, rfl⟩
      rwa [Scheme.Opens.range_ι] at this
    refine ⟨?_, fun x y hxy => (hfib (W.ι x) y (hιW x) hxy).1⟩
    apply IsOpenImmersion.of_forall_source_exists
    · intro x₁ x₂ h12
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h12
      exact W.ι.isOpenEmbedding.injective (hfib _ _ (hιW x₁) h12).2
    · intro x
      obtain ⟨g, hg, hgx⟩ := hwit (W.ι x) (hιW x)
      have hgA : g ∈ A' := by simpa using habs g hg 1
      let Ag := Localization.Away g
      let jg : Spec (.of Ag) ⟶ Spec (.of A) := Spec.map (CommRingCat.ofHom (algebraMap A Ag))
      have hjr : Set.range jg = (PrimeSpectrum.basicOpen g : Set (PrimeSpectrum A)) :=
        PrimeSpectrum.localization_away_comap_range Ag g
      have hsub : Set.range jg ⊆ Set.range W.ι := by
        intro z hz
        rw [hjr] at hz
        rw [Scheme.Opens.range_ι]
        exact hD g hg z hz
      let i := IsOpenImmersion.lift W.ι jg hsub
      have hi : i ≫ W.ι = jg := IsOpenImmersion.lift_fac W.ι jg hsub
      have : IsOpenImmersion (i ≫ W.ι) := by rw [hi]; infer_instance
      have : IsOpenImmersion i := IsOpenImmersion.of_comp i W.ι
      refine ⟨_, i, inferInstance, ?_, ?_⟩
      · have hxr : W.ι x ∈ Set.range jg := by rw [hjr]; exact hgx
        obtain ⟨y, hy⟩ := hxr
        rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange]
        refine ⟨y, W.ι.isOpenEmbedding.injective ?_⟩
        rw [← Scheme.Hom.comp_apply, hi, hy]
      · letI : Algebra A' Ag := ((algebraMap A Ag).comp A'.subtype).toAlgebra
        haveI : IsLocalization.Away (⟨g, hgA⟩ : A') Ag := by
          apply IsLocalization.Away.mk
          · exact IsLocalization.Away.algebraMap_isUnit g
          · intro s
            obtain ⟨n, a, ha⟩ := IsLocalization.Away.surj g s
            refine ⟨n + 1, ⟨g * a, habs g hg a⟩, ?_⟩
            show s * (algebraMap A Ag g) ^ (n + 1) = algebraMap A Ag (g * a)
            rw [pow_succ, ← mul_assoc, ha, map_mul, mul_comm]
          · intro a b hab
            obtain ⟨⟨_, n, rfl⟩, hc⟩ := IsLocalization.exists_of_eq (M := Submonoid.powers g) hab
            refine ⟨n, Subtype.ext ?_⟩
            simpa using hc
        have e : i ≫ W.ι ≫ q = Spec.map (CommRingCat.ofHom (algebraMap A' Ag)) := by
          rw [← Category.assoc, hi, hq, ← Spec.map_comp]
          rfl
        rw [e]
        exact IsOpenImmersion.of_isLocalization (⟨g, hgA⟩ : A')

  have S7 : ∀ {Zt Z : Scheme.{u}} (U : Zt.Opens) (hU : IsAffineOpen U) (A' : Subring Γ(Zt, U))
      (j : Spec (.of A') ⟶ Z) [IsOpenImmersion j] (π : Zt ⟶ Z),
      hU.fromSpec ≫ π = Spec.map (CommRingCat.ofHom A'.subtype) ≫ j →
      ∀ (h : U ≤ π ⁻¹ᵁ j.opensRange), Function.Injective (π.appLE j.opensRange U h).hom ∧
      ∀ g : Γ(Zt, U), (∃ f, (π.appLE j.opensRange U h).hom f = g) ↔ g ∈ A' := by
    intro Zt Z U hU A' j _ π hπ h
    have hle : (⊤ : (Spec Γ(Zt, U)).Opens) ≤ hU.fromSpec ⁻¹ᵁ U := hU.fromSpec_preimage_self.ge
    have hα : hU.fromSpec.appLE U ⊤ hle = (Scheme.ΓSpecIso Γ(Zt, U)).inv := by
      rw [Scheme.Hom.appLE, IsAffineOpen.fromSpec_app_self, Category.assoc, ← Functor.map_comp]
      convert Category.comp_id _ using 2
      exact (Spec Γ(Zt, U)).presheaf.map_id _
    have he : (⊤ : (Spec (.of A')).Opens) ≤ j ⁻¹ᵁ j.opensRange := by
      intro x _
      rw [Scheme.Hom.mem_preimage, ← SetLike.mem_coe, Scheme.Hom.coe_opensRange]
      exact ⟨x, rfl⟩
    have hle3 : (⊤ : (Spec Γ(Zt, U)).Opens) ≤
        (Spec.map (CommRingCat.ofHom A'.subtype)) ⁻¹ᵁ ⊤ := fun x _ => trivial
    have gen : ∀ (f g : Spec Γ(Zt, U) ⟶ Z), f = g → ∀ e e', f.appLE j.opensRange ⊤ e =
        g.appLE j.opensRange ⊤ e' := by
      rintro f _ rfl e e'; rfl
    have hcomp : π.appLE j.opensRange U h ≫ hU.fromSpec.appLE U ⊤ hle =
        j.appLE j.opensRange ⊤ he ≫
          (Spec.map (CommRingCat.ofHom A'.subtype)).appLE ⊤ ⊤ hle3 := by
      rw [Scheme.Hom.appLE_comp_appLE, Scheme.Hom.appLE_comp_appLE]
      exact gen _ _ hπ _ _
    have hγ : (Spec.map (CommRingCat.ofHom A'.subtype)).appLE ⊤ ⊤ hle3 =
        (Spec.map (CommRingCat.ofHom A'.subtype)).appTop := Scheme.Hom.appLE_eq_app _
    have hnat : (Spec.map (CommRingCat.ofHom A'.subtype)).appTop =
        (Scheme.ΓSpecIso (.of A')).hom ≫ CommRingCat.ofHom A'.subtype ≫
          (Scheme.ΓSpecIso Γ(Zt, U)).inv := by
      rw [← Category.assoc]
      exact (Iso.eq_comp_inv _).mpr (Scheme.ΓSpecIso_naturality _)
    have hcomp' : π.appLE j.opensRange U h ≫ (Scheme.ΓSpecIso Γ(Zt, U)).inv =
        ((j.appLE j.opensRange ⊤ he ≫ (Scheme.ΓSpecIso (.of A')).hom) ≫
          CommRingCat.ofHom A'.subtype) ≫ (Scheme.ΓSpecIso Γ(Zt, U)).inv := by
      calc π.appLE j.opensRange U h ≫ (Scheme.ΓSpecIso Γ(Zt, U)).inv
          = π.appLE j.opensRange U h ≫ hU.fromSpec.appLE U ⊤ hle := by rw [hα]
        _ = j.appLE j.opensRange ⊤ he ≫
              (Spec.map (CommRingCat.ofHom A'.subtype)).appLE ⊤ ⊤ hle3 := hcomp
        _ = _ := by rw [hγ, hnat]; simp only [Category.assoc]
    have hρ : π.appLE j.opensRange U h =
        (j.appLE j.opensRange ⊤ he ≫ (Scheme.ΓSpecIso (.of A')).hom) ≫
          CommRingCat.ofHom A'.subtype := (cancel_mono _).mp hcomp'
    have hβiso : IsIso (j.appLE j.opensRange ⊤ he) := by
      have h1 := Scheme.Hom.appLE_appIso_inv j he
      have heq : j ''ᵁ ⊤ = j.opensRange := Scheme.Hom.image_top_eq_opensRange j
      have key : ∀ (A B : Z.Opens) (hh : A ≤ B), A = B →
          IsIso (Z.presheaf.map (homOfLE hh).op) := by
        rintro A B hh rfl
        have : (homOfLE hh).op = 𝟙 (Opposite.op A) := rfl
        rw [this]
        infer_instance
      have : IsIso (j.appLE j.opensRange ⊤ he ≫ (j.appIso ⊤).inv) := by
        rw [h1]
        exact key _ _ _ heq
      exact IsIso.of_isIso_comp_right _ (j.appIso ⊤).inv
    set β' := j.appLE j.opensRange ⊤ he ≫ (Scheme.ΓSpecIso (.of A')).hom with hβ'
    have hbij : Function.Bijective β'.hom := ConcreteCategory.bijective_of_isIso β'
    have hpt : ∀ f, (π.appLE j.opensRange U h).hom f = ((β'.hom f : A') : Γ(Zt, U)) := by
      intro f; rw [hρ]; rfl
    refine ⟨fun f₁ f₂ h12 => ?_, fun g => ⟨?_, ?_⟩⟩
    · rw [hpt, hpt] at h12
      exact hbij.1 (Subtype.ext h12)
    · rintro ⟨f, rfl⟩
      rw [hpt]; exact (β'.hom f).2
    · intro hg
      obtain ⟨f, hf⟩ := hbij.2 ⟨g, hg⟩
      exact ⟨f, by rw [hpt, hf]⟩

  intro R _ Zt ut _ m σ hσs hσd U hU hσU
  classical
  have ha : ∀ a, (⊤ : (Spec (.of R)).Opens) ≤ σ a ⁻¹ᵁ U := fun a p _ => hσU a ⟨p, rfl⟩
  have h' : U ≤ ut ⁻¹ᵁ ⊤ := fun x _ => trivial
  obtain ⟨A', hA'⟩ : ∃ A' : Subring Γ(Zt, U), ∀ g, g ∈ A' ↔
      ∀ e : Fin m, ((σ (e, 0)).appLE U ⊤ (ha _)).hom g = ((σ (e, 1)).appLE U ⊤ (ha _)).hom g :=
    ⟨⨅ e : Fin m, RingHom.eqLocus ((σ (e, 0)).appLE U ⊤ (ha _)).hom
      ((σ (e, 1)).appLE U ⊤ (ha _)).hom, fun g => by
        simp only [Subring.mem_iInf, RingHom.mem_eqLocus]⟩
  obtain ⟨O, hO⟩ := S2 R Zt ut (Fin m × Fin 2) σ hσs
  have S1a := fun a => S1 R Zt ut U hU (σ a) (hσs a) (ha a) h'
  obtain ⟨q, hq⟩ : ∃ q : Spec Γ(Zt, U) ⟶ Spec (.of A'),
      q = Spec.map (CommRingCat.ofHom A'.subtype) := ⟨_, rfl⟩
  have hP : ∀ g : Γ(Zt, U), (∀ a, g ∈ RingHom.ker ((σ a).appLE U ⊤ (ha a)).hom) → g ∈ A' := by
    intro g hg
    rw [hA']
    intro e
    rw [RingHom.mem_ker.mp (hg (e, 0)), RingHom.mem_ker.mp (hg (e, 1))]
  have hW : ∀ x : ↥(Spec Γ(Zt, U)), x ∈ hU.fromSpec ⁻¹ᵁ O ↔
      ∀ a, ¬ RingHom.ker ((σ a).appLE U ⊤ (ha a)).hom ≤ x.asIdeal := by
    intro x
    rw [Scheme.Hom.mem_preimage, hO]
    exact forall_congr' fun a => not_congr ((S1a a).2.2.2 x)
  obtain ⟨hOI, hfib⟩ := S3 Γ(Zt, U) A' (Fin m × Fin 2)
    (fun a => RingHom.ker ((σ a).appLE U ⊤ (ha a)).hom) hP (hU.fromSpec ⁻¹ᵁ O) hW
  rw [← hq] at hOI hfib
  set ι₁ := hU.fromSpec ∣_ O with hι₁
  set ι₂ := (hU.fromSpec ⁻¹ᵁ O).ι ≫ q with hι₂

  have hcA : ∀ r, (ut.appLE ⊤ U h').hom r ∈ A' := by
    intro r
    rw [hA']
    intro e
    have k : ∀ a, ((σ a).appLE U ⊤ (ha a)).hom ((ut.appLE ⊤ U h').hom r) = r := by
      intro a
      rw [← CommRingCat.comp_apply, (S1a a).2.1]
      rfl
    rw [k, k]
  let c' : Γ(Spec (.of R), ⊤) →+* A' := (ut.appLE ⊤ U h').hom.codRestrict A' hcA
  let uS : Spec (.of A') ⟶ Spec (.of R) :=
    Spec.map (CommRingCat.ofHom c') ≫ (Spec (.of R)).isoSpec.inv
  have hqu : q ≫ uS = hU.fromSpec ≫ ut := by
    have e3 := IsAffineOpen.SpecMap_appLE_fromSpec ut (isAffineOpen_top (Spec (.of R))) hU h'
    rw [IsAffineOpen.fromSpec_top] at e3
    rw [← e3, hq, ← Category.assoc, ← Spec.map_comp]
    congr 2
  have hcompat : ι₁ ≫ (O.ι ≫ ut) = ι₂ ≫ uS := by
    rw [← Category.assoc, hι₁, morphismRestrict_ι, Category.assoc, ← hqu, hι₂, Category.assoc]
  let uu : Limits.pushout ι₁ ι₂ ⟶ Spec (.of R) := Limits.pushout.desc (O.ι ≫ ut) uS hcompat

  have hcov : ∀ x : ↥Zt, x ∈ O ∨ x ∈ Set.range hU.fromSpec := by
    intro x
    by_cases hx : x ∈ O
    · exact Or.inl hx
    · right
      rw [hO] at hx
      push_neg at hx
      obtain ⟨a, ha'⟩ := hx
      rw [hU.range_fromSpec]
      exact hσU a ha'
  have S5a := S5 O hU.fromSpec hcov (T := Limits.pushout ι₁ ι₂)
  obtain ⟨π, hπO, hπS⟩ := S5a.1 (Limits.pushout.inl ι₁ ι₂) (q ≫ Limits.pushout.inr ι₁ ι₂)
    ((Limits.pushout.condition).trans (Category.assoc _ _ _))
  have D1 : π ≫ uu = ut := by
    apply (S5 O hU.fromSpec hcov (T := Spec (.of R))).2
    · rw [← Category.assoc, hπO, Limits.pushout.inl_desc]
    · rw [← Category.assoc, hπS, Category.assoc, Limits.pushout.inr_desc, hqu]
  have hsq : ∀ a, σ a ≫ π = (Spec (.of R)).isoSpec.hom ≫
      Spec.map (CommRingCat.ofHom A'.subtype ≫ (σ a).appLE U ⊤ (ha a)) ≫
        Limits.pushout.inr ι₁ ι₂ := by
    intro a
    calc σ a ≫ π = ((Spec (.of R)).isoSpec.hom ≫ Spec.map ((σ a).appLE U ⊤ (ha a)) ≫
          hU.fromSpec) ≫ π := by rw [← (S1a a).1]
      _ = _ := by
        rw [Category.assoc, Category.assoc, hπS, hq, Spec.map_comp, Category.assoc]
  have D2 : ∀ e, σ (e, 0) ≫ π = σ (e, 1) ≫ π := by
    intro e
    rw [hsq, hsq]
    congr 3
    ext ⟨g, hg⟩
    exact (hA' g).mp hg e
  have hcov' : ∀ x : ↥Zt, x ∈ O ∨ x ∈ U := by
    intro x
    rcases hcov x with h | h
    · exact Or.inl h
    · right; rw [hU.range_fromSpec] at h; exact h
  haveI : IsOpenImmersion ι₂ := hOI
  have S4a := S4 ι₁ ι₂
  have hW1 : ∀ w, O.ι (ι₁ w) ∈ U := by
    intro w
    rw [← Scheme.Hom.comp_apply, hι₁, morphismRestrict_ι, Scheme.Hom.comp_apply,
      ← SetLike.mem_coe, ← hU.range_fromSpec]
    exact ⟨_, rfl⟩
  have hW2 : ∀ (s : ↥(Spec Γ(Zt, U))) (w : ↥(hU.fromSpec ⁻¹ᵁ O)), q s = ι₂ w →
      hU.fromSpec s ∈ O := by
    intro s w hsw
    exact hfib w s (by rw [hsw]; rfl)
  obtain ⟨hV, ⟨hO', hiso⟩, hUeq⟩ := S6 O U hU.fromSpec q ι₁ ι₂ π hU.range_fromSpec hcov'
    hπO hπS S4a.1 S4a.2 hW1 hW2
  have S7a := S7 U hU A' (Limits.pushout.inr ι₁ ι₂) π (by rw [hπS, hq]) hUeq.ge
  refine ⟨Limits.pushout ι₁ ι₂, uu, π, O, (Limits.pushout.inr ι₁ ι₂).opensRange,
    (Limits.pushout.inl ι₁ ι₂).opensRange, ?_⟩
  unfold wcpaClPinch
  refine ⟨D1, hσs, D2, hO, hU, isAffineOpen_opensRange _, hσU, hV, ⟨hO', hiso⟩, hUeq, S7a.1,
    fun g => (S7a.2 g).trans ((hA' g).trans ⟨fun H e h₀ h₁ => H e, fun H e => H e _ _⟩)⟩

theorem wcpa_clbc_crt_elements : ∀ (A B : Type u) [CommRing A] [CommRing B] {ι : Type} [Fintype ι] [DecidableEq ι] (s : ι → (A →+* B)), (∀ i j, i ≠ j → RingHom.ker (s i) ⊔ RingHom.ker (s j) = ⊤) → ∃ h : ι → A, ∀ i j, s i (h j) = if i = j then 1 else 0 :=
by
  intro A B _ _ ι _ _ s hcop
  have s1 : ∀ i j : ι, ∃ p : A, i ≠ j → (s i p = 0 ∧ s j p = 1) := by
    intro i j
    by_cases hij : i = j
    · exact ⟨1, fun h => absurd hij h⟩
    · have h1 : (1 : A) ∈ RingHom.ker (s i) ⊔ RingHom.ker (s j) := by
        rw [hcop i j hij]; exact Submodule.mem_top
      obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.mp h1
      refine ⟨y, fun _ => ⟨RingHom.mem_ker.mp hy, ?_⟩⟩
      have hy' : y = 1 - z := eq_sub_of_add_eq hyz
      rw [hy', map_sub, map_one, RingHom.mem_ker.mp hz, sub_zero]
  choose p hp using s1
  refine ⟨fun j => ∏ k ∈ Finset.univ.erase j, p k j, ?_⟩
  intro i j
  rw [map_prod]
  by_cases hij : i = j
  · subst hij
    rw [if_pos rfl]
    apply Finset.prod_eq_one
    intro k hk
    exact (hp k i (Finset.mem_erase.mp hk).1).2
  · rw [if_neg hij]
    apply Finset.prod_eq_zero (i := i)
    · exact Finset.mem_erase.mpr ⟨hij, Finset.mem_univ i⟩
    · exact (hp i j hij).1

theorem wcpa_clbc_kernels_comaximal : ∀ (R : Type u) [CommRing R] {Zt : Scheme.{u}} (ut : Zt ⟶ Spec (.of R)) (m : ℕ) (σ : Fin m × Fin 2 → (Spec (.of R) ⟶ Zt)) (U : Zt.Opens), IsAffineOpen U → (∀ a, σ a ≫ ut = 𝟙 _) → (∀ (a b : Fin m × Fin 2) (p q : ↥(Spec (.of R))), a ≠ b → σ a p ≠ σ b q) → ∀ (a b : Fin m × Fin 2) (ha : ⊤ ≤ σ a ⁻¹ᵁ U) (hb : ⊤ ≤ σ b ⁻¹ᵁ U), a ≠ b → RingHom.ker ((σ a).appLE U ⊤ ha).hom ⊔ RingHom.ker ((σ b).appLE U ⊤ hb).hom = ⊤ :=
by
  intro R _ Zt ut m σ U hU hσu hdisj a b ha hb hab
  have cong : ∀ {X Y : Scheme.{u}} {f g : X ⟶ Y}, f = g → ∀ (U : Y.Opens) (V : X.Opens)
      (e : V ≤ f ⁻¹ᵁ U) (e' : V ≤ g ⁻¹ᵁ U), f.appLE U V e = g.appLE U V e' := by
    rintro X Y f g rfl U V e e'
    rfl
  have idtop : ∀ (X : Scheme.{u}) (e : (⊤ : X.Opens) ≤ (𝟙 X : X ⟶ X) ⁻¹ᵁ ⊤),
      Scheme.Hom.appLE (𝟙 X) ⊤ ⊤ e = 𝟙 _ := by
    intro X e
    simp only [Scheme.Hom.appLE, Scheme.Hom.id_app]
    rw [show (homOfLE e).op = 𝟙 (Opposite.op (⊤ : X.Opens)) from Subsingleton.elim _ _]
    exact (Category.id_comp _).trans (X.presheaf.map_id _)
  have pt2 : ∀ {A B B' C : Scheme.{u}} {f : A ⟶ B} {g : B ⟶ C} {f' : A ⟶ B'} {g' : B' ⟶ C},
      f ≫ g = f' ≫ g' → ∀ x, g (f x) = g' (f' x) := by
    intro A B B' C f g f' g' e x
    rw [← Scheme.Hom.comp_apply, e, Scheme.Hom.comp_apply]
  have hUt : U ≤ ut ⁻¹ᵁ ⊤ := fun _ _ => trivial
  have surj : ∀ c (hc : ⊤ ≤ σ c ⁻¹ᵁ U), Function.Surjective ((σ c).appLE U ⊤ hc).hom := by
    intro c hc r
    refine ⟨(ut.appLE ⊤ U hUt).hom r, ?_⟩
    have h1 : ut.appLE ⊤ U hUt ≫ (σ c).appLE U ⊤ hc = 𝟙 _ := by
      rw [Scheme.Hom.appLE_comp_appLE]
      exact (cong (hσu c) ⊤ ⊤ _ (fun _ _ => trivial)).trans (idtop _ _)
    have h2 := congrArg (fun f => f.hom r) h1
    simpa using h2
  by_contra hI
  obtain ⟨M, hM, hIM⟩ := Ideal.exists_le_maximal _ hI
  have hMp : M.IsPrime := hM.isPrime
  have key : ∀ c (hc : ⊤ ≤ σ c ⁻¹ᵁ U), RingHom.ker ((σ c).appLE U ⊤ hc).hom ≤ M →
      ∃ P : ↥(Spec (.of R)), σ c P = hU.fromSpec (show PrimeSpectrum Γ(Zt, U) from ⟨M, hMp⟩) := by
    intro c hc hk
    have hp := Ideal.map_isPrime_of_surjective (surj c hc) hk
    have hcm : Ideal.comap ((σ c).appLE U ⊤ hc).hom
        (Ideal.map ((σ c).appLE U ⊤ hc).hom M) = M := by
      rw [Ideal.comap_map_of_surjective' _ (surj c hc), sup_eq_left.mpr hk]
    let xp : PrimeSpectrum Γ(Spec (.of R), ⊤) := ⟨Ideal.map ((σ c).appLE U ⊤ hc).hom M, hp⟩
    refine ⟨(isAffineOpen_top (Spec (.of R))).fromSpec xp, ?_⟩
    have E := pt2 (IsAffineOpen.SpecMap_appLE_fromSpec (σ c) hU (isAffineOpen_top _) hc) xp
    rw [← E]
    congr 1
    apply PrimeSpectrum.ext
    exact hcm
  obtain ⟨P, hP⟩ := key a ha (le_sup_left.trans hIM)
  obtain ⟨Q, hQ⟩ := key b hb (le_sup_right.trans hIM)
  exact hdisj a b P Q hab (hP.trans hQ.symm)

theorem wcpa_clbc_equalizer_pushout : ∀ {B B' A A' C C' : CommRingCat.{u}} (Θ : B ⟶ B') (α : B ⟶ A) (α' : B ⟶ A') (ι : A' ⟶ A) (κ : A ⟶ C) (β : B' ⟶ C) (κ' : A' ⟶ C') (β' : B' ⟶ C') (ι' : C' ⟶ C) (m : ℕ) (s : Fin m × Fin 2 → (A ⟶ B)) (s' : Fin m × Fin 2 → (C ⟶ B')) (h : Fin m → A), IsPushout α Θ κ β → IsPushout α' Θ κ' β' → α' ≫ ι = α → κ' ≫ ι' = ι ≫ κ → β' ≫ ι' = β → (∀ a, α ≫ s a = 𝟙 B) → (∀ a, κ ≫ s' a = s a ≫ Θ) → (∀ a, β ≫ s' a = 𝟙 B') → (∀ e e', (s (e', 0)).hom (h e) = 0) → (∀ e e', (s (e', 1)).hom (h e) = if e = e' then 1 else 0) → Function.Injective ι.hom → (∀ g : A, (∃ f, ι.hom f = g) ↔ ∀ e, (s (e, 0)).hom g = (s (e, 1)).hom g) → Function.Injective ι'.hom ∧ ∀ g : C, (∃ f, ι'.hom f = g) ↔ ∀ e, (s' (e, 0)).hom g = (s' (e, 1)).hom g :=
by
  intro B B' A A' C C' Θ α α' ι κ β κ' β' ι' m s s' h hP hP' H1 H2 H3 H4 H5 H6 H7 H8 H9 H10
  classical

  have bc : ∀ {B B' A C : CommRingCat.{u}} (Θ : B ⟶ B') (α : B ⟶ A) (κ : A ⟶ C) (β : B' ⟶ C),
      IsPushout α Θ κ β →
      (∀ (T : CommRingCat.{u}) (F G : C →+ T),
        (∀ b' a, F (β.hom b' * κ.hom a) = G (β.hom b' * κ.hom a)) → F = G) ∧
      (∀ (T : CommRingCat.{u}) (γ : B' ⟶ T) (φ : A →+ T),
        (∀ b a, φ (α.hom b * a) = γ.hom (Θ.hom b) * φ a) →
        ∃ ψ : C →+ T, (∀ a, ψ (κ.hom a) = φ a) ∧ ∀ b' c, ψ (β.hom b' * c) = γ.hom b' * ψ c) := by
    intro B B' A C Θ α κ β hP
    letI : Algebra B A := α.hom.toAlgebra
    letI : Algebra B B' := Θ.hom.toAlgebra
    letI : Algebra B' C := β.hom.toAlgebra
    letI : Algebra A C := κ.hom.toAlgebra
    letI : Algebra B C := (α ≫ κ).hom.toAlgebra
    haveI : IsScalarTower B A C := IsScalarTower.of_algebraMap_eq' rfl
    haveI : IsScalarTower B B' C := IsScalarTower.of_algebraMap_eq'
      (congrArg CommRingCat.Hom.hom hP.toCommSq.w)
    have hpo : Algebra.IsPushout B B' A C :=
      (CommRingCat.isPushout_iff_isPushout (R := B) (S := A) (R' := B') (S' := C)).mp hP.flip
    have hbc := hpo.out
    refine ⟨fun T F G H => ?_, fun T γ φ hφ => ?_⟩
    · have hFG : ∀ c : C, ∀ b' : B', F (β.hom b' * c) = G (β.hom b' * c) := by
        intro c
        refine hbc.inductionOn c ?_ ?_ ?_
        · intro a b'
          exact H b' a
        · intro x n ih b'
          have e : β.hom b' * (x • n) = β.hom (b' * x) * n := by
            show β.hom b' * (β.hom x * n) = _
            rw [map_mul, mul_assoc]
          rw [e]
          exact ih _
        · intro n₁ n₂ ih₁ ih₂ b'
          rw [mul_add, map_add, map_add, ih₁, ih₂]
      ext c
      have := hFG c 1
      rwa [map_one, one_mul] at this
    · letI : Algebra B' T := γ.hom.toAlgebra
      letI : Algebra B T := (Θ ≫ γ).hom.toAlgebra
      haveI : IsScalarTower B B' T := IsScalarTower.of_algebraMap_eq' rfl
      let g : A →ₗ[B] T :=
        { toFun := φ
          map_add' := φ.map_add
          map_smul' := fun b a => by
            show φ (α.hom b * a) = γ.hom (Θ.hom b) * φ a
            exact hφ b a }
      refine ⟨(hbc.lift g).toAddMonoidHom, fun a => hbc.lift_eq g a, fun b' c => ?_⟩
      show hbc.lift g (b' • c) = b' • hbc.lift g c
      exact (hbc.lift g).map_smul b' c

  have P1 : ∀ b, ι.hom (α'.hom b) = α.hom b := fun b => congrArg (fun φ : B ⟶ A => φ.hom b) H1
  have P2 : ∀ f, ι'.hom (κ'.hom f) = κ.hom (ι.hom f) := fun f =>
    congrArg (fun φ : A' ⟶ C => φ.hom f) H2
  have P3 : ∀ b', ι'.hom (β'.hom b') = β.hom b' := fun b' =>
    congrArg (fun φ : B' ⟶ C => φ.hom b') H3
  have P4 : ∀ a b, (s a).hom (α.hom b) = b := fun a b =>
    congrArg (fun φ : B ⟶ B => φ.hom b) (H4 a)
  have P5 : ∀ a g, (s' a).hom (κ.hom g) = Θ.hom ((s a).hom g) := fun a g =>
    congrArg (fun φ : A ⟶ B' => φ.hom g) (H5 a)
  have P6 : ∀ a b', (s' a).hom (β.hom b') = b' := fun a b' =>
    congrArg (fun φ : B' ⟶ B' => φ.hom b') (H6 a)
  have Pw : ∀ b, κ.hom (α.hom b) = β.hom (Θ.hom b) := fun b =>
    congrArg (fun φ : B ⟶ C => φ.hom b) hP.toCommSq.w
  have Pw' : ∀ b, κ'.hom (α'.hom b) = β'.hom (Θ.hom b) := fun b =>
    congrArg (fun φ : B ⟶ C' => φ.hom b) hP'.toCommSq.w

  have hu : ∀ g : A, ∀ e', (s (e', 0)).hom (g - ∑ e, α.hom ((s (e, 1)).hom g - (s (e, 0)).hom g) * h e)
      = (s (e', 1)).hom (g - ∑ e, α.hom ((s (e, 1)).hom g - (s (e, 0)).hom g) * h e) := by
    intro g e'
    simp only [map_sub, map_sum, map_mul, P4, H7, H8, mul_zero, Finset.sum_const_zero, sub_zero,
      mul_ite, mul_one, Finset.sum_ite_eq', Finset.mem_univ, if_true]
    ring
  choose r hr using fun g => (H10 _).mpr (hu g)
  have R2 : ∀ x y, r (x + y) = r x + r y := by
    intro x y
    apply H9
    rw [map_add, hr, hr, hr]
    simp only [map_add, map_sub, add_mul, sub_mul, Finset.sum_add_distrib, Finset.sum_sub_distrib]
    ring
  have R3 : ∀ b g, r (α.hom b * g) = α'.hom b * r g := by
    intro b g
    apply H9
    rw [map_mul, P1, hr, hr]
    simp only [map_mul, map_sub, P4, mul_sub, Finset.mul_sum, sub_mul, Finset.sum_sub_distrib,
      mul_assoc]
  have R4 : ∀ f, r (ι.hom f) = f := by
    intro f
    apply H9
    rw [hr]
    have e0 : ∀ e, (s (e, 1)).hom (ι.hom f) - (s (e, 0)).hom (ι.hom f) = 0 := fun e => by
      rw [(H10 _).mp ⟨f, rfl⟩ e, sub_self]
    simp only [e0, map_zero, zero_mul, Finset.sum_const_zero, sub_zero]

  let φ : A →+ C' := AddMonoidHom.mk' (fun g => κ'.hom (r g)) (fun x y => by rw [R2, map_add])
  have hφ : ∀ b a, φ (α.hom b * a) = β'.hom (Θ.hom b) * φ a := by
    intro b a
    show κ'.hom (r (α.hom b * a)) = β'.hom (Θ.hom b) * κ'.hom (r a)
    rw [R3, map_mul, Pw']
  obtain ⟨R', hR'κ, hR'β⟩ := (bc Θ α κ β hP).2 C' β' φ hφ

  have hinv : ∀ c : C', R' (ι'.hom c) = c := by
    have key := (bc Θ α' κ' β' hP').1 C' (R'.comp ι'.hom.toAddMonoidHom) (AddMonoidHom.id _)
      (fun b' f => by
        show R' (ι'.hom (β'.hom b' * κ'.hom f)) = β'.hom b' * κ'.hom f
        rw [map_mul, P3, P2, hR'β, hR'κ]
        show β'.hom b' * κ'.hom (r (ι.hom f)) = _
        rw [R4])
    intro c
    exact DFunLike.congr_fun key c

  have himg1 : ∀ e, ι' ≫ s' (e, 0) = ι' ≫ s' (e, 1) := by
    intro e
    have hι : ι ≫ s (e, 0) = ι ≫ s (e, 1) := by
      ext f
      exact (H10 _).mp ⟨f, rfl⟩ e
    apply hP'.hom_ext
    · rw [← Category.assoc, ← Category.assoc, H2, Category.assoc, Category.assoc, H5, H5,
        ← Category.assoc, ← Category.assoc, hι]
    · rw [← Category.assoc, ← Category.assoc, H3, H6, H6]

  have hstar : ∀ g : C, ι'.hom (R' g) +
      ∑ e, β.hom ((s' (e, 1)).hom g - (s' (e, 0)).hom g) * κ.hom (h e) = g := by
    let F : C →+ C :=
      { toFun := fun g => ι'.hom (R' g) +
          ∑ e, β.hom ((s' (e, 1)).hom g - (s' (e, 0)).hom g) * κ.hom (h e)
        map_zero' := by simp
        map_add' := by
          intro x y
          simp only [map_add, map_sub, add_mul, sub_mul, Finset.sum_add_distrib,
            Finset.sum_sub_distrib]
          abel }
    have key := (bc Θ α κ β hP).1 C F (AddMonoidHom.id _) (fun b' a => by
      show ι'.hom (R' (β.hom b' * κ.hom a)) +
          ∑ e, β.hom ((s' (e, 1)).hom (β.hom b' * κ.hom a) - (s' (e, 0)).hom (β.hom b' * κ.hom a))
            * κ.hom (h e) = β.hom b' * κ.hom a
      rw [hR'β, hR'κ]
      show ι'.hom (β'.hom b' * κ'.hom (r a)) + _ = _
      rw [map_mul, P3, P2, hr]
      simp only [map_mul, P6, P5, map_sub, map_sum, ← Pw, mul_sub, Finset.mul_sum, sub_mul,
        Finset.sum_sub_distrib, mul_assoc]
      ring)
    intro g
    exact DFunLike.congr_fun key g

  refine ⟨fun x y hxy => by rw [← hinv x, hxy, hinv y], fun g => ⟨?_, ?_⟩⟩
  · rintro ⟨f, rfl⟩ e
    exact congrArg (fun φ : C' ⟶ B' => φ.hom f) (himg1 e)
  · intro hg
    refine ⟨R' g, ?_⟩
    have := hstar g
    simp only [hg, sub_self, map_zero, zero_mul, Finset.sum_const_zero, add_zero] at this
    exact this

theorem wcpa_clbc_open_iso : ∀ {Zt Z S S' : Scheme.{u}} (ut : Zt ⟶ S) (uu : Z ⟶ S) (b : S' ⟶ S) (π : Zt ⟶ Z) (π' : Limits.pullback ut b ⟶ Limits.pullback uu b) (O : Zt.Opens) (O' : Z.Opens), π ≫ uu = ut → π' ≫ Limits.pullback.fst uu b = Limits.pullback.fst ut b ≫ π → π' ≫ Limits.pullback.snd uu b = Limits.pullback.snd ut b → ∀ hO : π ⁻¹ᵁ O' = O, IsIso (π.resLE O' O hO.ge) → ∃ hO' : π' ⁻¹ᵁ (Limits.pullback.fst uu b ⁻¹ᵁ O') = Limits.pullback.fst ut b ⁻¹ᵁ O, IsIso (π'.resLE (Limits.pullback.fst uu b ⁻¹ᵁ O') (Limits.pullback.fst ut b ⁻¹ᵁ O) hO'.ge) :=
by
  intro Zt Z S S' ut uu b π π' O O' H1 H2 H3 hO H5
  have pt : ∀ x, Limits.pullback.fst uu b (π' x) = π (Limits.pullback.fst ut b x) := by
    intro x
    rw [← Scheme.Hom.comp_apply, H2, Scheme.Hom.comp_apply]
  have hO' : π' ⁻¹ᵁ (Limits.pullback.fst uu b ⁻¹ᵁ O') = Limits.pullback.fst ut b ⁻¹ᵁ O := by
    rw [← hO]
    ext x
    simp only [SetLike.mem_coe, Scheme.Hom.mem_preimage]
    rw [pt x]
  refine ⟨hO', ?_⟩
  have QZ := (isPullback_morphismRestrict (Limits.pullback.fst uu b) O').paste_vert
    (IsPullback.of_hasPullback uu b)
  have Qt := (isPullback_morphismRestrict (Limits.pullback.fst ut b) O).paste_vert
    (IsPullback.of_hasPullback ut b)
  have s3 : π'.resLE (Limits.pullback.fst uu b ⁻¹ᵁ O') (Limits.pullback.fst ut b ⁻¹ᵁ O) hO'.ge ≫
      (Limits.pullback.fst uu b ∣_ O') =
      (Limits.pullback.fst ut b ∣_ O) ≫ π.resLE O' O hO.ge := by
    rw [← cancel_mono O'.ι]
    simp only [Category.assoc, morphismRestrict_ι, Scheme.Hom.resLE_comp_ι]
    rw [← Category.assoc, Scheme.Hom.resLE_comp_ι, Category.assoc, H2, ← Category.assoc,
      ← Category.assoc, morphismRestrict_ι]
  have e1 : π'.resLE (Limits.pullback.fst uu b ⁻¹ᵁ O') (Limits.pullback.fst ut b ⁻¹ᵁ O) hO'.ge ≫
      ((Limits.pullback.fst uu b ⁻¹ᵁ O').ι ≫ Limits.pullback.snd uu b) =
      (Limits.pullback.fst ut b ⁻¹ᵁ O).ι ≫ Limits.pullback.snd ut b := by
    rw [← Category.assoc, Scheme.Hom.resLE_comp_ι, Category.assoc, H3]
  have e2 : π.resLE O' O hO.ge ≫ (O'.ι ≫ uu) = O.ι ≫ ut := by
    rw [← Category.assoc, Scheme.Hom.resLE_comp_ι, Category.assoc, H1]
  have outer : IsPullback
      (π'.resLE (Limits.pullback.fst uu b ⁻¹ᵁ O') (Limits.pullback.fst ut b ⁻¹ᵁ O) hO'.ge ≫
        ((Limits.pullback.fst uu b ⁻¹ᵁ O').ι ≫ Limits.pullback.snd uu b))
      (Limits.pullback.fst ut b ∣_ O) b (π.resLE O' O hO.ge ≫ (O'.ι ≫ uu)) := by
    rw [e1, e2]; exact Qt.flip
  have hsq := IsPullback.of_right outer s3 QZ.flip
  exact hsq.isIso_fst_of_isIso H5

theorem wcpa_clbc_section_range : ∀ {Zt S S' : Scheme.{u}} (ut : Zt ⟶ S) (b : S' ⟶ S) (σ : S ⟶ Zt) (σ' : S' ⟶ Limits.pullback ut b), σ ≫ ut = 𝟙 S → σ' ≫ Limits.pullback.fst ut b = b ≫ σ → σ' ≫ Limits.pullback.snd ut b = 𝟙 S' → ∀ x : ↥(Limits.pullback ut b), x ∈ Set.range σ' ↔ Limits.pullback.fst ut b x ∈ Set.range σ :=
by
  intro Zt S S' ut b σ σ' h1 h2 h3 x
  constructor
  · rintro ⟨p, rfl⟩
    refine ⟨b p, ?_⟩
    rw [← Scheme.Hom.comp_apply, ← h2, Scheme.Hom.comp_apply]
  · rintro ⟨s, hs⟩
    have Hright : IsPullback (Limits.pullback.snd ut b) (Limits.pullback.fst ut b) b ut :=
      (IsPullback.of_hasPullback ut b).flip
    have Hcomp : IsPullback (σ' ≫ Limits.pullback.snd ut b) b b (σ ≫ ut) := by
      rw [h3, h1]; exact IsPullback.id_horiz b
    have Hsq : IsPullback σ' b (Limits.pullback.fst ut b) σ :=
      IsPullback.of_right Hcomp h2 Hright
    obtain ⟨p, hp, -⟩ := Scheme.exists_preimage_of_isPullback Hsq x s hs.symm
    exact ⟨p, hp⟩

theorem wcpa_cl_pinch_basechange : ∀ (R R' : Type u) [CommRing R] [CommRing R'] (φ : R →+* R')
    {Zt Z : Scheme.{u}} (ut : Zt ⟶ Spec (.of R)) (uu : Z ⟶ Spec (.of R)) (m : ℕ)
    (σ : Fin m × Fin 2 → (Spec (.of R) ⟶ Zt)) (π : Zt ⟶ Z) (O U : Zt.Opens) (V O' : Z.Opens),
    wcpaClPinch ut uu m σ π O U V O' →
    (∀ (a b : Fin m × Fin 2) (p q : ↥(Spec (.of R))), a ≠ b → σ a p ≠ σ b q) →
    ∃ (σ' : Fin m × Fin 2 → (Spec (.of R') ⟶ Limits.pullback ut (Spec.map (CommRingCat.ofHom φ))))
      (π' : Limits.pullback ut (Spec.map (CommRingCat.ofHom φ)) ⟶
        Limits.pullback uu (Spec.map (CommRingCat.ofHom φ))),
      wcpaClPinch (Limits.pullback.snd ut (Spec.map (CommRingCat.ofHom φ)))
        (Limits.pullback.snd uu (Spec.map (CommRingCat.ofHom φ))) m σ' π'
        (Limits.pullback.fst ut (Spec.map (CommRingCat.ofHom φ)) ⁻¹ᵁ O)
        (Limits.pullback.fst ut (Spec.map (CommRingCat.ofHom φ)) ⁻¹ᵁ U)
        (Limits.pullback.fst uu (Spec.map (CommRingCat.ofHom φ)) ⁻¹ᵁ V)
        (Limits.pullback.fst uu (Spec.map (CommRingCat.ofHom φ)) ⁻¹ᵁ O') ∧
      (∀ (a b : Fin m × Fin 2) (p q : ↥(Spec (.of R'))), a ≠ b → σ' a p ≠ σ' b q) ∧
      (∀ a, σ' a ≫ Limits.pullback.fst ut (Spec.map (CommRingCat.ofHom φ)) =
        Spec.map (CommRingCat.ofHom φ) ≫ σ a) ∧
      π' ≫ Limits.pullback.fst uu (Spec.map (CommRingCat.ofHom φ)) =
        Limits.pullback.fst ut (Spec.map (CommRingCat.ofHom φ)) ≫ π :=
by
  intro R R' _ _ φ Zt Z ut uu m σ π O U V O' hD hdisj
  obtain ⟨hπu, hσu, hσπ, hO, hUaff, hVaff, hrange, hVO, ⟨hOO, hOiso⟩, ⟨hUU, hinj, himg⟩⟩ := hD
  have pt : ∀ {A B C : Scheme.{u}} {a : A ⟶ B} {b : B ⟶ C} {c : A ⟶ C}, a ≫ b = c →
      ∀ x, b (a x) = c x := by
    intro A B C a b c h x
    rw [← Scheme.Hom.comp_apply, h]
  have cong : ∀ {X Y : Scheme.{u}} {f g : X ⟶ Y}, f = g → ∀ (U : Y.Opens) (V : X.Opens)
      (e : V ≤ f ⁻¹ᵁ U) (e' : V ≤ g ⁻¹ᵁ U), f.appLE U V e = g.appLE U V e' := by
    rintro X Y f g rfl U V e e'
    rfl
  have idtop : ∀ (X : Scheme.{u}) (e : (⊤ : X.Opens) ≤ (𝟙 X : X ⟶ X) ⁻¹ᵁ ⊤),
      Scheme.Hom.appLE (𝟙 X) ⊤ ⊤ e = 𝟙 _ := by
    intro X e
    simp only [Scheme.Hom.appLE, Scheme.Hom.id_app, Category.id_comp]
    rw [show (homOfLE e).op = 𝟙 (Opposite.op (⊤ : X.Opens)) from Subsingleton.elim _ _]
    exact (Category.id_comp _).trans (X.presheaf.map_id _)
  set b := Spec.map (CommRingCat.ofHom φ) with hb
  let σ' : Fin m × Fin 2 → (Spec (.of R') ⟶ Limits.pullback ut b) := fun a =>
    Limits.pullback.lift (b ≫ σ a) (𝟙 _)
      (by rw [Category.assoc, hσu, Category.comp_id, Category.id_comp])
  let π' : Limits.pullback ut b ⟶ Limits.pullback uu b :=
    Limits.pullback.lift (Limits.pullback.fst ut b ≫ π) (Limits.pullback.snd ut b)
      (by rw [Category.assoc, hπu, Limits.pullback.condition])
  have E1 : ∀ a, σ' a ≫ Limits.pullback.fst ut b = b ≫ σ a := fun a =>
    Limits.pullback.lift_fst _ _ _
  have E2 : ∀ a, σ' a ≫ Limits.pullback.snd ut b = 𝟙 _ := fun a =>
    Limits.pullback.lift_snd _ _ _
  have E3 : π' ≫ Limits.pullback.fst uu b = Limits.pullback.fst ut b ≫ π :=
    Limits.pullback.lift_fst _ _ _
  have E4 : π' ≫ Limits.pullback.snd uu b = Limits.pullback.snd ut b :=
    Limits.pullback.lift_snd _ _ _

  have D4c : ∀ a, Set.range (σ' a) ⊆ (Limits.pullback.fst ut b ⁻¹ᵁ U : Set _) := by
    rintro a _ ⟨p, rfl⟩
    show σ' a p ∈ Limits.pullback.fst ut b ⁻¹ᵁ U
    rw [Scheme.Hom.mem_preimage, pt (E1 a) p, Scheme.Hom.comp_apply]
    exact hrange a ⟨b p, rfl⟩

  have hT : (⊤ : (Spec (.of R')).Opens) ≤ b ⁻¹ᵁ ⊤ := fun _ _ => trivial
  have hUt : U ≤ ut ⁻¹ᵁ ⊤ := fun _ _ => trivial
  have hVu : V ≤ uu ⁻¹ᵁ ⊤ := fun _ _ => trivial
  have h2t : Limits.pullback.fst ut b ⁻¹ᵁ U ≤ Limits.pullback.snd ut b ⁻¹ᵁ ⊤ := fun _ _ => trivial
  have h2 : Limits.pullback.fst uu b ⁻¹ᵁ V ≤ Limits.pullback.snd uu b ⁻¹ᵁ ⊤ := fun _ _ => trivial
  obtain ⟨hUaff', hPt⟩ := wc_ccr_pullback_chart_pushout (Spec (.of R)) Zt (Spec (.of R')) ut b ⊤
    (isAffineOpen_top _) ⊤ (isAffineOpen_top _) hT U hUaff hUt _ le_rfl h2t
    (inf_eq_left.mpr h2t).symm
  obtain ⟨hVaff', hP⟩ := wc_ccr_pullback_chart_pushout (Spec (.of R)) Z (Spec (.of R')) uu b ⊤
    (isAffineOpen_top _) ⊤ (isAffineOpen_top _) hT V hVaff hVu _ le_rfl h2
    (inf_eq_left.mpr h2).symm
  have hU' : π' ⁻¹ᵁ (Limits.pullback.fst uu b ⁻¹ᵁ V) = Limits.pullback.fst ut b ⁻¹ᵁ U := by
    rw [← hUU]
    ext x
    simp only [SetLike.mem_coe, Scheme.Hom.mem_preimage]
    rw [pt E3 x, Scheme.Hom.comp_apply]
  have hσU : ∀ a, (⊤ : (Spec (.of R)).Opens) ≤ σ a ⁻¹ᵁ U := fun a p _ => hrange a ⟨p, rfl⟩
  have hσ'U : ∀ a, (⊤ : (Spec (.of R')).Opens) ≤ σ' a ⁻¹ᵁ (Limits.pullback.fst ut b ⁻¹ᵁ U) :=
    fun a p _ => D4c a ⟨p, rfl⟩

  obtain ⟨h₀, hh₀⟩ := wcpa_clbc_crt_elements Γ(Zt, U) Γ(Spec (.of R), ⊤)
    (fun a => ((σ a).appLE U ⊤ (hσU a)).hom)
    (fun i j hij => wcpa_clbc_kernels_comaximal R ut m σ U hUaff hσu hdisj i j (hσU i) (hσU j) hij)
  have hcore := wcpa_clbc_equalizer_pushout (b.appLE ⊤ ⊤ hT) (ut.appLE ⊤ U hUt)
    (uu.appLE ⊤ V hVu) (π.appLE V U hUU.ge)
    ((Limits.pullback.fst ut b).appLE U _ le_rfl) ((Limits.pullback.snd ut b).appLE ⊤ _ h2t)
    ((Limits.pullback.fst uu b).appLE V _ le_rfl) ((Limits.pullback.snd uu b).appLE ⊤ _ h2)
    (π'.appLE _ _ hU'.ge) m (fun a => (σ a).appLE U ⊤ (hσU a))
    (fun a => (σ' a).appLE _ ⊤ (hσ'U a)) (fun e => h₀ (e, 1)) hPt hP
    (by rw [Scheme.Hom.appLE_comp_appLE]; exact cong hπu _ _ _ _)
    (by rw [Scheme.Hom.appLE_comp_appLE, Scheme.Hom.appLE_comp_appLE]; exact cong E3 _ _ _ _)
    (by rw [Scheme.Hom.appLE_comp_appLE]; exact cong E4 _ _ _ _)
    (fun a => by
      rw [Scheme.Hom.appLE_comp_appLE]
      exact (cong (hσu a) (⊤ : (Spec (.of R)).Opens) ⊤ _ (fun _ _ => trivial)).trans (idtop _ _))
    (fun a => by
      rw [Scheme.Hom.appLE_comp_appLE, Scheme.Hom.appLE_comp_appLE]; exact cong (E1 a) _ _ _ _)
    (fun a => by
      rw [Scheme.Hom.appLE_comp_appLE]
      exact (cong (E2 a) (⊤ : (Spec (.of R')).Opens) ⊤ _ (fun _ _ => trivial)).trans (idtop _ _))
    (fun e e' => by
      show ((σ (e', 0)).appLE U ⊤ (hσU _)).hom (h₀ (e, 1)) = 0
      rw [hh₀]; simp)
    (fun e e' => by
      show ((σ (e', 1)).appLE U ⊤ (hσU _)).hom (h₀ (e, 1)) = _
      rw [hh₀]
      by_cases h : e = e'
      · subst h; simp
      · simp [h, Ne.symm h])
    hinj (fun g => (himg g).trans ⟨fun H e => H e _ _, fun H e _ _ => H e⟩)
  obtain ⟨hinj', himg'⟩ := hcore
  refine ⟨σ', π', ⟨E4, E2, ?_, ?_, hUaff', hVaff', D4c, ?_, ?_, hU', hinj',
    fun g => (himg' g).trans ⟨fun H e _ _ => H e, fun H e => H e _ _⟩⟩, ?_, E1, E3⟩
  · intro e
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Category.assoc, E3, ← Category.assoc, ← Category.assoc, E1, E1,
        Category.assoc, Category.assoc, hσπ]
    · rw [Category.assoc, Category.assoc, E4, E2, E2]
  · intro x
    rw [Scheme.Hom.mem_preimage, hO]
    exact forall_congr' fun a => not_congr
      (wcpa_clbc_section_range ut b (σ a) (σ' a) (hσu a) (E1 a) (E2 a) x).symm
  · rw [eq_top_iff]
    intro x _
    have hx : Limits.pullback.fst uu b x ∈ V ⊔ O' := by rw [hVO]; trivial
    rcases (TopologicalSpace.Opens.mem_sup).mp hx with h | h
    · exact (TopologicalSpace.Opens.mem_sup).mpr (Or.inl h)
    · exact (TopologicalSpace.Opens.mem_sup).mpr (Or.inr h)
  · exact wcpa_clbc_open_iso ut uu b π π' O O' hπu E3 E4 hOO hOiso
  · intro a a' p q hne heq
    apply hdisj a a' (b p) (b q) hne
    have h1 := congrArg (Limits.pullback.fst ut b) heq
    rw [pt (E1 a) p, pt (E1 a') q, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h1
    exact h1

theorem wcpa_cl_pinch_points : ∀ (R : Type u) [CommRing R] {Zt Z : Scheme.{u}}
    (ut : Zt ⟶ Spec (.of R)) (uu : Z ⟶ Spec (.of R)) (m : ℕ)
    (σ : Fin m × Fin 2 → (Spec (.of R) ⟶ Zt)) (π : Zt ⟶ Z) (O U : Zt.Opens) (V O' : Z.Opens),
    wcpaClPinch ut uu m σ π O U V O' →
    (∀ (a b : Fin m × Fin 2) (p q : ↥(Spec (.of R))), a ≠ b → σ a p ≠ σ b q) →
    LocallyOfFiniteType ut →
    IsFinite π ∧ Surjective π ∧ ∀ x x' : Zt, π x = π x' → x = x' ∨
      ∃ (e : Fin m) (p q : ↥(Spec (.of R))),
        (x = σ (e, 0) p ∧ x' = σ (e, 1) q) ∨ (x = σ (e, 1) p ∧ x' = σ (e, 0) q) :=
by
  intro R _ Zt Z ut uu m σ π O U V O' hD hdisj hlft

  have s1 : ∀ {X : Scheme.{u}} (ut : X ⟶ Spec (.of R)) (σ : Spec (.of R) ⟶ X) (U : X.Opens),
      σ ≫ ut = 𝟙 _ → ∀ (h : ⊤ ≤ σ ⁻¹ᵁ U) (e : U ≤ ut ⁻¹ᵁ ⊤) (b : Γ(Spec (.of R), ⊤)),
      (σ.appLE U ⊤ h).hom ((ut.appLE ⊤ U e).hom b) = b := by
    intro X ut σ U hσu h e b
    have h1 := Scheme.Hom.appLE_comp_appLE σ ut ⊤ U ⊤ e h
    have h2 := congrArg (fun φ => φ.hom b) h1
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h2
    rw [h2]
    have aux : ∀ (f : Spec (.of R) ⟶ Spec (.of R)) (hf : f = 𝟙 _)
        (e' : (⊤ : (Spec (.of R)).Opens) ≤ f ⁻¹ᵁ ⊤) (b : Γ(Spec (.of R), ⊤)),
        (f.appLE ⊤ ⊤ e').hom b = b := by
      intro f hf e' b
      subst hf
      simp [Scheme.Hom.appLE]
      rfl
    exact aux _ hσu _ b

  have s3 : ∀ {A B : Type u} [CommRing A] [CommRing B] {ι : Type} [Fintype ι] [DecidableEq ι]
      (s : ι → (A →+* B)), (∀ i j, i ≠ j → RingHom.ker (s i) ⊔ RingHom.ker (s j) = ⊤) →
      ∃ E : ι → A, ∀ i j, s i (E j) = if i = j then 1 else 0 := by
    intro A B _ _ ι _ _ s hcom
    have hz : ∀ i j, i ≠ j → ∃ z : A, s i z = 1 ∧ s j z = 0 := by
      intro i j hij
      have h1 : (1 : A) ∈ RingHom.ker (s i) ⊔ RingHom.ker (s j) := by
        rw [hcom i j hij]; exact Submodule.mem_top
      obtain ⟨y, hy, w, hw, hyw⟩ := Submodule.mem_sup.mp h1
      refine ⟨w, ?_, hw⟩
      have : w = 1 - y := by rw [← hyw]; ring
      rw [this, map_sub, map_one, RingHom.mem_ker.mp hy, sub_zero]
    classical
    let z : ι → ι → A := fun j k => if h : j = k then 1 else Classical.choose (hz j k h)
    have hz1 : ∀ j k, j ≠ k → s j (z j k) = 1 := by
      intro j k h
      simp only [z, dif_neg h]
      exact (Classical.choose_spec (hz j k h)).1
    have hz0 : ∀ j k, j ≠ k → s k (z j k) = 0 := by
      intro j k h
      simp only [z, dif_neg h]
      exact (Classical.choose_spec (hz j k h)).2
    refine ⟨fun j => ∏ k ∈ Finset.univ.erase j, z j k, ?_⟩
    intro i j
    rw [map_prod]
    split_ifs with hij
    · subst hij
      apply Finset.prod_eq_one
      intro k hk
      exact hz1 i k (Finset.ne_of_mem_erase hk).symm
    · apply Finset.prod_eq_zero (i := i)
      · exact Finset.mem_erase.mpr ⟨hij, Finset.mem_univ i⟩
      · exact hz0 j i (Ne.symm hij)

  have s4 : ∀ {A' A B : Type u} [CommRing A'] [CommRing A] [CommRing B] {ι : Type} [Fintype ι]
      (φ : A' →+* A) (μ : B →+* A') (s : ι → (A →+* B)), (∀ i b, s i (φ (μ b)) = b) →
      (∀ g : A, (∀ i, s i g = 0) → ∃ f : A', φ f = g) → φ.IsIntegral := by
    intro A' A B _ _ _ ι _ φ μ s hret hmem g
    classical
    let c : ι → A' := fun i => μ (s i g)
    obtain ⟨f, hf⟩ := hmem (g * ∏ i, (g - φ (c i))) (by
      intro j
      rw [map_mul, map_prod]
      apply mul_eq_zero_of_right
      apply Finset.prod_eq_zero (Finset.mem_univ j)
      rw [map_sub, hret, sub_self])
    refine ⟨Polynomial.X * ∏ i, (Polynomial.X - Polynomial.C (c i)) - Polynomial.C f, ?_, ?_⟩
    · rcases subsingleton_or_nontrivial A' with hA | hA
      · exact Polynomial.monic_of_subsingleton _
      · have hq : (Polynomial.X * ∏ i, (Polynomial.X - Polynomial.C (c i))).Monic :=
          Polynomial.monic_X.mul (Polynomial.monic_prod_of_monic _ _
            (fun i _ => Polynomial.monic_X_sub_C _))
        apply hq.sub_of_left
        have hdeg : 0 < (Polynomial.X * ∏ i, (Polynomial.X - Polynomial.C (c i))).degree := by
          rw [← Polynomial.natDegree_pos_iff_degree_pos, Polynomial.Monic.natDegree_mul
            Polynomial.monic_X (Polynomial.monic_prod_of_monic _ _
            (fun i _ => Polynomial.monic_X_sub_C _)), Polynomial.natDegree_X]
          omega
        exact lt_of_le_of_lt Polynomial.degree_C_le hdeg
    · rw [Polynomial.eval₂_sub, Polynomial.eval₂_mul, Polynomial.eval₂_X,
        Polynomial.eval₂_finsetProd, Polynomial.eval₂_C, hf]
      simp only [Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C]
      exact sub_self _

  have s9 : ∀ {Zt Z : Scheme.{u}} (π : Zt ⟶ Z) (uu : Z ⟶ Spec (.of R)) (U : Zt.Opens)
      (V : Z.Opens), IsAffineOpen U → LocallyOfFiniteType (π ≫ uu) →
      ∀ (e : U ≤ π ⁻¹ᵁ V), (π.appLE V U e).hom.FiniteType := by
    intro Zt Z π uu U V hU hlft e
    have e' : U ≤ (π ≫ uu) ⁻¹ᵁ ⊤ := by rw [Scheme.Hom.preimage_top]; exact le_top
    have e₁ : V ≤ uu ⁻¹ᵁ ⊤ := by rw [Scheme.Hom.preimage_top]; exact le_top
    have h1 := HasRingHomProperty.appLE @LocallyOfFiniteType (π ≫ uu) hlft
      ⟨⊤, isAffineOpen_top _⟩ ⟨U, hU⟩ e'
    have h2 := Scheme.Hom.appLE_comp_appLE π uu ⊤ V U e₁ e
    simp only at h1
    rw [← h2, CommRingCat.hom_comp] at h1
    exact RingHom.FiniteType.of_comp_finiteType h1

  have s7 : ∀ {X Y : Scheme.{u}} (π : X ⟶ Y) (O : X.Opens) (O' : Y.Opens) (hO : π ⁻¹ᵁ O' = O),
      IsIso (π.resLE O' O hO.ge) → ∀ x x' : X, x ∈ O → π x = π x' → x = x' := by
    intro X Y π O O' hO hiso x x' hx hxx
    have hx' : x' ∈ O := by
      rw [← hO, Scheme.Hom.mem_preimage, ← hxx, ← Scheme.Hom.mem_preimage, hO]; exact hx
    have hr : ∀ w : O.toScheme, O'.ι ((π.resLE O' O hO.ge) w) = π (O.ι w) := by
      intro w
      rw [← Scheme.Hom.comp_apply, Scheme.Hom.resLE_comp_ι, Scheme.Hom.comp_apply]
    let wx : O.toScheme := ⟨x, hx⟩
    let wx' : O.toScheme := ⟨x', hx'⟩
    have h1 : (π.resLE O' O hO.ge) wx = (π.resLE O' O hO.ge) wx' := by
      apply O'.ι.isOpenEmbedding.injective
      rw [hr, hr]; exact hxx
    have h2 : wx = wx' := (Scheme.Hom.homeomorph (π.resLE O' O hO.ge)).injective h1
    have h3 := congrArg O.ι h2
    simpa [wx, wx'] using h3

  have s8 : ∀ {X Y : Scheme.{u}} (π : X ⟶ Y) (U : X.Opens) (V : Y.Opens)
      (hU : U ≤ π ⁻¹ᵁ V) (k : Γ(Y, V)) (σ τ : Spec (.of R) ⟶ X) (hσ : ⊤ ≤ σ ⁻¹ᵁ U)
      (hτ : ⊤ ≤ τ ⁻¹ᵁ U), (σ.appLE U ⊤ hσ).hom ((π.appLE V U hU).hom k) = 1 →
      (τ.appLE U ⊤ hτ).hom ((π.appLE V U hU).hom k) = 0 → ∀ (p q : ↥(Spec (.of R))),
      π (σ p) ≠ π (τ q) := by
    intro X Y π U V hU k σ τ hσ hτ h1 h0 p q
    have e1 := congrArg (fun φ => φ.hom k) (Scheme.Hom.appLE_comp_appLE σ π V U ⊤ hU hσ)
    have e0 := congrArg (fun φ => φ.hom k) (Scheme.Hom.appLE_comp_appLE τ π V U ⊤ hU hτ)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e1 e0
    rw [h1] at e1
    rw [h0] at e0
    have b1 := Scheme.basicOpen_appLE (σ ≫ π) ⊤ V
      (by rw [Scheme.Hom.comp_preimage]; exact hσ.trans (σ.preimage_mono hU)) k
    have b0 := Scheme.basicOpen_appLE (τ ≫ π) ⊤ V
      (by rw [Scheme.Hom.comp_preimage]; exact hτ.trans (τ.preimage_mono hU)) k
    rw [← e1, Scheme.basicOpen_one] at b1
    rw [← e0, Scheme.basicOpen_zero] at b0
    have hp : π (σ p) ∈ Y.basicOpen k := by
      have : p ∈ (⊤ : (Spec (.of R)).Opens) := trivial
      rw [b1] at this
      have h2 : p ∈ (σ ≫ π) ⁻¹ᵁ Y.basicOpen k := this.2
      rw [Scheme.Hom.mem_preimage, Scheme.Hom.comp_apply] at h2
      exact h2
    have hq : π (τ q) ∉ Y.basicOpen k := by
      intro hq
      have h2 : q ∈ (τ ≫ π) ⁻¹ᵁ Y.basicOpen k := by
        rw [Scheme.Hom.mem_preimage, Scheme.Hom.comp_apply]
        exact hq
      have : q ∈ (⊤ : (Spec (.of R)).Opens) ⊓ (τ ≫ π) ⁻¹ᵁ Y.basicOpen k := ⟨trivial, h2⟩
      rw [← b0] at this
      exact this
    intro heq
    exact hq (heq ▸ hp)

  have s2 : ∀ {X : Scheme.{u}} (σ τ : Spec (.of R) ⟶ X) (U : X.Opens), IsAffineOpen U →
      ∀ (hσ : ⊤ ≤ σ ⁻¹ᵁ U) (hτ : ⊤ ≤ τ ⁻¹ᵁ U), Function.Surjective (σ.appLE U ⊤ hσ).hom →
      Function.Surjective (τ.appLE U ⊤ hτ).hom → (∀ p q : ↥(Spec (.of R)), σ p ≠ τ q) →
      RingHom.ker (σ.appLE U ⊤ hσ).hom ⊔ RingHom.ker (τ.appLE U ⊤ hτ).hom = ⊤ := by
    intro X σ τ U hU hσ hτ hsσ hsτ hd
    have key : ∀ (ρ : Spec (.of R) ⟶ X) (hρ : ⊤ ≤ ρ ⁻¹ᵁ U),
        Function.Surjective (ρ.appLE U ⊤ hρ).hom →
        ∀ (M : Ideal Γ(X, U)) (hMp : M.IsPrime), RingHom.ker (ρ.appLE U ⊤ hρ).hom ≤ M →
        ∃ p, hU.fromSpec (⟨M, hMp⟩ : PrimeSpectrum Γ(X, U)) = ρ p := by
      intro ρ hρ hs M hMp hM
      have hQ := Ideal.map_isPrime_of_surjective hs hM
      let y : ↥(Spec Γ(Spec (.of R), ⊤)) :=
        (⟨Ideal.map (ρ.appLE U ⊤ hρ).hom M, hQ⟩ : PrimeSpectrum Γ(Spec (.of R), ⊤))
      have hy : Spec.map (ρ.appLE U ⊤ hρ) y =
          ((⟨M, hMp⟩ : PrimeSpectrum Γ(X, U)) : ↥(Spec Γ(X, U))) := by
        rw [Spec.map_apply]
        apply PrimeSpectrum.ext
        rw [PrimeSpectrum.comap_asIdeal]
        show Ideal.comap _ (Ideal.map _ M) = M
        rw [Ideal.comap_map_of_surjective' _ hs, sup_eq_left.mpr hM]
      have h := congrArg (fun f : Spec Γ(Spec (.of R), ⊤) ⟶ X => f y)
        (IsAffineOpen.SpecMap_appLE_fromSpec ρ hU (isAffineOpen_top (Spec (.of R))) hρ)
      simp only [Scheme.Hom.comp_apply] at h
      rw [hy] at h
      exact ⟨_, h⟩
    by_contra hne
    obtain ⟨M, hMmax, hle⟩ := Ideal.exists_le_maximal _ hne
    obtain ⟨p, hp⟩ := key σ hσ hsσ M hMmax.isPrime (le_sup_left.trans hle)
    obtain ⟨q, hq⟩ := key τ hτ hsτ M hMmax.isPrime (le_sup_right.trans hle)
    exact hd p q (hp.symm.trans hq)

  have s5 : ∀ {X Y : Scheme.{u}} (π : X ⟶ Y) (O U : X.Opens) (V O' : Y.Opens),
      IsAffineOpen U → IsAffineOpen V → V ⊔ O' = ⊤ → ∀ (hO : π ⁻¹ᵁ O' = O),
      IsIso (π.resLE O' O hO.ge) → ∀ (hU : π ⁻¹ᵁ V = U),
      (π.appLE V U hU.ge).hom.Finite → IsFinite π := by
    intro X Y π O U V O' hUa hVa hcov hO hiso hU hfin
    have hZ : IsZariskiLocalAtTarget @IsFinite :=
      @HasAffineProperty.instIsZariskiLocalAtTarget @IsFinite _
        IsFinite.instHasAffinePropertyAndIsAffineFiniteCarrierObjOppositeOpensCarrierCarrierCommRingCatPresheafOpOpensTopHomAppTop
    let Uc : Bool → Y.Opens := fun b => cond b V O'
    have hsup : iSup Uc = ⊤ := by rw [iSup_bool_eq]; exact hcov
    rw [@IsZariskiLocalAtTarget.iff_of_iSup_eq_top @IsFinite hZ _ _ π _ Uc hsup]
    intro b
    cases b
    · show IsFinite (π ∣_ O')
      subst hO
      rw [Scheme.Hom.resLE_eq_morphismRestrict] at hiso
      haveI := hiso
      infer_instance
    · show IsFinite (π ∣_ V)
      subst hU
      haveI : IsAffine V := hVa
      rw [@HasAffineProperty.iff_of_isAffine @IsFinite _
        IsFinite.instHasAffinePropertyAndIsAffineFiniteCarrierObjOppositeOpensCarrierCarrierCommRingCatPresheafOpOpensTopHomAppTop
        _ _ (π ∣_ V) _]
      refine ⟨hUa, ?_⟩
      show ((π ∣_ V).app ⊤).hom.Finite
      rw [morphismRestrict_app']
      refine (Scheme.Hom.appLE_congr π _ (Scheme.Opens.ι_image_top V) ?_
        (fun f => f.hom.Finite)).mpr hfin
      rw [Scheme.Hom.preimage_top, Scheme.Opens.ι_image_top]

  have s6 : ∀ {X Y : Scheme.{u}} (π : X ⟶ Y) (O U : X.Opens) (V O' : Y.Opens),
      IsAffineOpen U → IsAffineOpen V → V ⊔ O' = ⊤ → ∀ (hO : π ⁻¹ᵁ O' = O),
      IsIso (π.resLE O' O hO.ge) → ∀ (hU : π ⁻¹ᵁ V = U),
      Function.Injective (π.appLE V U hU.ge).hom → (π.appLE V U hU.ge).hom.IsIntegral →
      Surjective π := by
    intro X Y π O U V O' hUa hVa hcov hO hiso hU hinj hint
    refine ⟨fun z => ?_⟩
    show ∃ a, π a = z
    have hz : z ∈ V ⊔ O' := by rw [hcov]; trivial
    rcases (TopologicalSpace.Opens.mem_sup.mp hz) with hzV | hzO
    · letI := (π.appLE V U hU.ge).hom.toAlgebra
      haveI : Algebra.IsIntegral Γ(Y, V) Γ(X, U) := ⟨hint⟩
      let P := hVa.primeIdealOf ⟨z, hzV⟩
      obtain ⟨Q, -, hQ, hQP⟩ := Ideal.exists_ideal_over_prime_of_isIntegral P.asIdeal
        (⊥ : Ideal Γ(X, U)) (by
          rw [Ideal.under_def, RingHom.algebraMap_toAlgebra, Ideal.comap_bot_of_injective _ hinj]
          exact bot_le)
      let y : ↥(Spec Γ(X, U)) := (⟨Q, hQ⟩ : PrimeSpectrum Γ(X, U))
      refine ⟨hUa.fromSpec y, ?_⟩
      have h := congrArg (fun f : Spec Γ(X, U) ⟶ Y => f y)
        (IsAffineOpen.SpecMap_appLE_fromSpec π hVa hUa hU.ge)
      simp only [Scheme.Hom.comp_apply] at h
      rw [← h, Spec.map_apply]
      have : PrimeSpectrum.comap (π.appLE V U hU.ge).hom y = P := by
        apply PrimeSpectrum.ext
        rw [PrimeSpectrum.comap_asIdeal]
        rw [Ideal.under_def, RingHom.algebraMap_toAlgebra] at hQP
        exact hQP
      rw [this]
      exact hVa.fromSpec_primeIdealOf ⟨z, hzV⟩
    · obtain ⟨w, hw⟩ := (Scheme.Hom.homeomorph (π.resLE O' O hO.ge)).surjective ⟨z, hzO⟩
      refine ⟨O.ι w, ?_⟩
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.resLE_comp_ι π hO.ge, Scheme.Hom.comp_apply]
      have hw' : (π.resLE O' O hO.ge) w = ⟨z, hzO⟩ := hw
      rw [hw']
      rfl

  obtain ⟨hD1, hσs, -, hD3, hUa, hVa, hσU, hcov, ⟨hO, hiso⟩, ⟨hU, hinj, heq⟩⟩ := hD
  subst hD1
  have hσ : ∀ a, ⊤ ≤ σ a ⁻¹ᵁ U := by
    intro a p _
    rw [Scheme.Hom.mem_preimage]
    exact hσU a ⟨p, rfl⟩
  have hμ : V ≤ uu ⁻¹ᵁ ⊤ := by rw [Scheme.Hom.preimage_top]; exact le_top
  let s : Fin m × Fin 2 → (Γ(Zt, U) →+* Γ(Spec (.of R), ⊤)) :=
    fun a => ((σ a).appLE U ⊤ (hσ a)).hom
  have hret : ∀ a b, s a ((π.appLE V U hU.ge).hom ((uu.appLE ⊤ V hμ).hom b)) = b := by
    intro a b
    have e' : U ≤ (π ≫ uu) ⁻¹ᵁ ⊤ := by rw [Scheme.Hom.preimage_top]; exact le_top
    have h1 := s1 (π ≫ uu) (σ a) U (hσs a) (hσ a) e' b
    have h2 := congrArg (fun f => f.hom b) (Scheme.Hom.appLE_comp_appLE π uu ⊤ V U hμ hU.ge)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h2
    show ((σ a).appLE U ⊤ (hσ a)).hom ((π.appLE V U hU.ge).hom ((uu.appLE ⊤ V hμ).hom b)) = b
    rw [h2]; exact h1
  have hsurj : ∀ a, Function.Surjective (s a) := fun a b => ⟨_, hret a b⟩
  have hcom : ∀ a b, a ≠ b → RingHom.ker (s a) ⊔ RingHom.ker (s b) = ⊤ := fun a b hab =>
    s2 (σ a) (σ b) U hUa (hσ a) (hσ b) (hsurj a) (hsurj b) (fun p q => hdisj a b p q hab)
  obtain ⟨E, hE⟩ := s3 s hcom
  have hmem : ∀ g, (∀ e, s (e, 0) g = s (e, 1) g) → ∃ f, (π.appLE V U hU.ge).hom f = g :=
    fun g H => (heq g).mpr (fun e _ _ => H e)
  have hint : (π.appLE V U hU.ge).hom.IsIntegral :=
    s4 (π.appLE V U hU.ge).hom (uu.appLE ⊤ V hμ).hom s hret
      (fun g hg => hmem g (fun e => by rw [hg, hg]))
  have hft := s9 π uu U V hUa hlft hU.ge
  have hfin := RingHom.Finite.of_isIntegral_of_finiteType hint hft
  refine ⟨s5 π O U V O' hUa hVa hcov hO hiso hU hfin,
    s6 π O U V O' hUa hVa hcov hO hiso hU hinj hint, ?_⟩
  intro x x' hxx
  by_cases hx : x ∈ O
  · left; exact s7 π O O' hO hiso x x' hx hxx
  by_cases hx' : x' ∈ O
  · left; exact (s7 π O O' hO hiso x' x hx' hxx.symm).symm
  rw [hD3] at hx hx'
  push_neg at hx hx'
  obtain ⟨⟨e, i⟩, p, rfl⟩ := hx
  obtain ⟨⟨e', j⟩, q, rfl⟩ := hx'
  by_cases hee : e = e'
  · subst hee
    by_cases hij : i = j
    · subst hij
      left
      have hp : ∀ r, uu (π (σ (e, i) r)) = r := by
        intro r
        rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hσs (e, i)]
        rfl
      have hpq : p = q := by
        calc p = uu (π (σ (e, i) p)) := (hp p).symm
          _ = uu (π (σ (e, i) q)) := by rw [hxx]
          _ = q := hp q
      rw [hpq]
    · right
      fin_cases i <;> fin_cases j
      · exact absurd rfl hij
      · exact ⟨e, p, q, Or.inl ⟨rfl, rfl⟩⟩
      · exact ⟨e, p, q, Or.inr ⟨rfl, rfl⟩⟩
      · exact absurd rfl hij
  · exfalso
    let k0 := E (e, 0) + E (e, 1)
    have hk : ∀ f b, s (f, b) k0 = if f = e then 1 else 0 := by
      intro f b
      simp only [k0, map_add, hE]
      fin_cases b <;> by_cases hf : f = e <;> simp [hf]
    obtain ⟨κ, hκ⟩ := hmem k0 (fun f => by rw [hk, hk])
    have h1 : s (e, i) ((π.appLE V U hU.ge).hom κ) = 1 := by rw [hκ, hk, if_pos rfl]
    have h0 : s (e', j) ((π.appLE V U hU.ge).hom κ) = 0 := by rw [hκ, hk, if_neg (Ne.symm hee)]
    exact s8 π U V hU.ge κ (σ (e, i)) (σ (e', j)) (hσ _) (hσ _) h1 h0 p q hxx

theorem wcpa_cl_fp_equalizer_finiteType : ∀ (R0 B A : Type u) [CommRing R0] [CommRing B] [CommRing A]
    (α : R0 →+* B) (ψ : B →+* A) (m : ℕ) (s : Fin m × Fin 2 → (A →+* R0)) (h : Fin m → A),
    Function.Injective ψ → (∀ a r, s a (ψ (α r)) = r) →
    (∀ g : A, (∃ b, ψ b = g) ↔ ∀ e, s (e, 0) g = s (e, 1) g) →
    (∀ e e' : Fin m, s (e', 0) (h e) = 0 ∧ s (e', 1) (h e) = if e' = e then 1 else 0) →
    (ψ.comp α).FiniteType → α.FiniteType :=
by
  intro R0 B A _ _ _ α ψ m s h Hinj Hret Himg Hcrt Hft
  classical
  letI : Algebra R0 B := α.toAlgebra
  letI : Algebra R0 A := (ψ.comp α).toAlgebra
  have hret : ∀ a r, s a (algebraMap R0 A r) = r := Hret
  have hsm : ∀ a (r : R0) (x : A), s a (r • x) = r * s a x := by
    intro a r x
    rw [Algebra.smul_def, map_mul, hret]
  have hιmul : ∀ (r : R0) (x : A), algebraMap R0 A r * x = r • x :=
    fun r x => (Algebra.smul_def r x).symm
  have hFT : Algebra.FiniteType R0 A := Hft
  obtain ⟨S, hS⟩ := hFT.out
  let ε : A → A := fun g => g - ∑ e, (s (e, 1) g - s (e, 0) g) • h e
  have hεdec : ∀ g, g = ε g + ∑ e, (s (e, 1) g - s (e, 0) g) • h e :=
    fun g => (sub_add_cancel _ _).symm
  have hsum0 : ∀ (c : Fin m → R0) e', s (e', 0) (∑ e, c e • h e) = 0 := by
    intro c e'
    simp only [map_sum, hsm, (Hcrt _ e').1, mul_zero, Finset.sum_const_zero]
  have hsum1 : ∀ (c : Fin m → R0) e', s (e', 1) (∑ e, c e • h e) = c e' := by
    intro c e'
    simp only [map_sum, hsm, (Hcrt _ e').2, mul_ite, mul_one, mul_zero]
    rw [Finset.sum_ite_eq]
    simp
  have hεE : ∀ g e, s (e, 0) (ε g) = s (e, 1) (ε g) := by
    intro g e
    simp only [ε, map_sub, hsum0, hsum1]
    ring
  let Y : Finset A := S.image ε ∪
    (Finset.univ : Finset (Fin m × Fin m)).image (fun p => ε (h p.1 * h p.2))
  let K : Finset A := (Y ×ˢ (Finset.univ : Finset (Fin m))).image
    (fun p => (p.1 - algebraMap R0 A (s (p.2, 1) p.1)) * h p.2)
  let G : Finset A := Y ∪ K
  let R : Subalgebra R0 A := Algebra.adjoin R0 (G : Set A)
  let W : Submodule R0 A := Subalgebra.toSubmodule R ⊔ Submodule.span R0 (Set.range h)
  have hYG : ∀ z ∈ Y, z ∈ R := fun z hz =>
    Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_union_left _ hz))
  have hKG : ∀ z ∈ K, z ∈ R := fun z hz =>
    Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_union_right _ hz))
  have hRW : ∀ x ∈ R, x ∈ W := fun x hx => Submodule.mem_sup_left hx
  have hhW : ∀ e, h e ∈ W := fun e => Submodule.mem_sup_right (Submodule.subset_span ⟨e, rfl⟩)
  have hsmW : ∀ (r : R0) e, r • h e ∈ W := fun r e => W.smul_mem r (hhW e)
  have hF0 : ∀ g, ε g ∈ R → g ∈ W := by
    intro g hg
    rw [hεdec g]
    exact W.add_mem (hRW _ hg) (W.sum_mem fun e _ => hsmW _ e)
  have hP2 : ∀ e f, h e * h f ∈ W := by
    intro e f
    apply hF0
    apply hYG
    exact Finset.mem_union_right _ (Finset.mem_image.mpr ⟨(e, f), Finset.mem_univ _, rfl⟩)
  have hL : ∀ x ∈ R, (∀ g, x * h g ∈ W) → ∀ w ∈ W, x * w ∈ W := by
    intro x hx hxh w hw
    obtain ⟨b, hb, c, hc, rfl⟩ := Submodule.mem_sup.mp hw
    rw [mul_add]
    refine W.add_mem (hRW _ (R.mul_mem hx hb)) ?_
    clear hw
    induction hc using Submodule.span_induction with
    | mem y hy => obtain ⟨g, rfl⟩ := hy; exact hxh g
    | zero => simp
    | add y z _ _ hy hz => rw [mul_add]; exact W.add_mem hy hz
    | smul r y _ hy => rw [mul_smul_comm]; exact W.smul_mem r hy
  have hPY : ∀ z ∈ Y, ∀ f, z * h f ∈ W := by
    intro z hz f
    have hk : (z - algebraMap R0 A (s (f, 1) z)) * h f ∈ K :=
      Finset.mem_image.mpr ⟨(z, f), Finset.mem_product.mpr ⟨hz, Finset.mem_univ _⟩, rfl⟩
    have heq : z * h f = (z - algebraMap R0 A (s (f, 1) z)) * h f + s (f, 1) z • h f := by
      rw [← hιmul]; ring
    rw [heq]
    exact W.add_mem (hRW _ (hKG _ hk)) (hsmW _ _)
  have hPK : ∀ z ∈ K, ∀ f, z * h f ∈ W := by
    intro z hz f
    obtain ⟨⟨y, e⟩, hy, rfl⟩ := Finset.mem_image.mp hz
    have hyY : y ∈ Y := (Finset.mem_product.mp hy).1
    have hxR : y - algebraMap R0 A (s (e, 1) y) ∈ R :=
      R.sub_mem (hYG y hyY) (R.algebraMap_mem _)
    dsimp only
    rw [mul_assoc]
    refine hL _ hxR ?_ _ (hP2 e f)
    intro g
    rw [sub_mul, hιmul]
    exact W.sub_mem (hPY y hyY g) (hsmW _ _)
  have hPG : ∀ x ∈ R, ∀ f, x * h f ∈ W := by
    intro x hx
    induction hx using Algebra.adjoin_induction with
    | mem z hz =>
      rcases Finset.mem_union.mp (Finset.mem_coe.mp hz) with hz | hz
      · exact hPY z hz
      · exact hPK z hz
    | algebraMap r => intro f; rw [hιmul]; exact hsmW r f
    | add x y _ _ hx hy => intro f; rw [add_mul]; exact W.add_mem (hx f) (hy f)
    | mul x y hx' _ hx hy => intro f; rw [mul_assoc]; exact hL x hx' hx _ (hy f)
  have hhWW : ∀ e, ∀ w ∈ W, h e * w ∈ W := by
    intro e w hw
    obtain ⟨b, hb, c, hc, rfl⟩ := Submodule.mem_sup.mp hw
    rw [mul_add]
    refine W.add_mem (by rw [mul_comm]; exact hPG b hb e) ?_
    clear hw
    induction hc using Submodule.span_induction with
    | mem y hy => obtain ⟨g, rfl⟩ := hy; exact hP2 e g
    | zero => simp
    | add y z _ _ hy hz => rw [mul_add]; exact W.add_mem hy hz
    | smul r y _ hy => rw [mul_smul_comm]; exact W.smul_mem r hy
  have hWmul : ∀ w ∈ W, ∀ w' ∈ W, w * w' ∈ W := by
    intro w hw w' hw'
    obtain ⟨b, hb, c, hc, rfl⟩ := Submodule.mem_sup.mp hw
    rw [add_mul]
    refine W.add_mem (hL b hb (hPG b hb) w' hw') ?_
    clear hw
    induction hc using Submodule.span_induction with
    | mem y hy => obtain ⟨g, rfl⟩ := hy; exact hhWW g w' hw'
    | zero => simp
    | add y z _ _ hy hz => rw [add_mul]; exact W.add_mem hy hz
    | smul r y _ hy => rw [smul_mul_assoc]; exact W.smul_mem r hy
  have hWtop : ∀ g, g ∈ W := by
    intro g
    have hg : g ∈ Algebra.adjoin R0 (S : Set A) := by rw [hS]; exact Algebra.mem_top
    induction hg using Algebra.adjoin_induction with
    | mem a ha =>
      apply hF0
      apply hYG
      exact Finset.mem_union_left _ (Finset.mem_image_of_mem _ (Finset.mem_coe.mp ha))
    | algebraMap r => exact hRW _ (R.algebraMap_mem r)
    | add x y _ _ hx hy => exact W.add_mem hx hy
    | mul x y _ _ hx hy => exact hWmul x hx y hy
  have hGE : ∀ z ∈ G, ∀ e, s (e, 0) z = s (e, 1) z := by
    intro z hz e
    rcases Finset.mem_union.mp hz with hz | hz
    · rcases Finset.mem_union.mp hz with hz | hz
      · obtain ⟨a, _, rfl⟩ := Finset.mem_image.mp hz
        exact hεE a e
      · obtain ⟨p, _, rfl⟩ := Finset.mem_image.mp hz
        exact hεE _ e
    · obtain ⟨⟨y, e'⟩, _, rfl⟩ := Finset.mem_image.mp hz
      simp only [map_mul, map_sub, hret, (Hcrt e' e).1, (Hcrt e' e).2, mul_zero]
      split_ifs with he
      · subst he; ring
      · ring
  have hRE : ∀ x ∈ R, ∀ e, s (e, 0) x = s (e, 1) x := by
    intro x hx e
    induction hx using Algebra.adjoin_induction with
    | mem z hz => exact hGE z (Finset.mem_coe.mp hz) e
    | algebraMap r => rw [hret, hret]
    | add x y _ _ hx hy => rw [map_add, map_add, hx, hy]
    | mul x y _ _ hx hy => rw [map_mul, map_mul, hx, hy]
  have hEsub : ∀ g, (∀ e, s (e, 0) g = s (e, 1) g) → g ∈ R := by
    intro g hg
    obtain ⟨b, hb, c, hc, rfl⟩ := Submodule.mem_sup.mp (hWtop g)
    obtain ⟨r, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun R0).mp hc
    have hr : ∀ e, r e = 0 := by
      intro e
      have h1 := hg e
      rw [map_add, map_add, hsum0, hsum1, hRE b hb e] at h1
      exact (add_left_cancel h1).symm
    have h0 : ∑ e, r e • h e = 0 := Finset.sum_eq_zero fun e _ => by rw [hr e, zero_smul]
    rw [h0, add_zero]
    exact hb
  let ψₐ : B →ₐ[R0] A := { ψ with commutes' := fun r => rfl }
  have hrange : ψₐ.range = R := by
    apply le_antisymm
    · intro x hx
      obtain ⟨b, rfl⟩ := hx
      exact hEsub _ ((Himg _).mp ⟨b, rfl⟩)
    · apply Algebra.adjoin_le
      intro z hz
      obtain ⟨b, hb⟩ := (Himg z).mpr (hGE z (Finset.mem_coe.mp hz))
      exact ⟨b, hb⟩
  show Algebra.FiniteType R0 B
  have hRfg : ψₐ.range.FG := hrange ▸ Subalgebra.fg_adjoin_finset G
  have hRft : Algebra.FiniteType R0 ψₐ.range := (Subalgebra.fg_iff_finiteType _).mp hRfg
  exact hRft.equiv (AlgEquiv.ofInjective ψₐ Hinj).symm

theorem wcpa_cl_pinch_flat_proper : ∀ (R : Type u) [CommRing R] {Zt Z : Scheme.{u}}
    (ut : Zt ⟶ Spec (.of R)) (uu : Z ⟶ Spec (.of R)) (m : ℕ)
    (σ : Fin m × Fin 2 → (Spec (.of R) ⟶ Zt)) (π : Zt ⟶ Z) (O U : Zt.Opens) (V O' : Z.Opens),
    wcpaClPinch ut uu m σ π O U V O' →
    (∀ (a b : Fin m × Fin 2) (p q : ↥(Spec (.of R))), a ≠ b → σ a p ≠ σ b q) →
    Flat ut → IsProper ut → Flat uu ∧ IsProper uu :=
by
  intro R _ Zt Z ut uu m σ π O U V O' hD hdisj hfl hpr
  classical
  haveI := hpr

  obtain ⟨hfin, hsurj, -⟩ :=
    wcpa_cl_pinch_points R ut uu m σ π O U V O' hD hdisj inferInstance
  haveI := hfin
  haveI := hsurj
  obtain ⟨hπu, hσu, hσπ, hO, hUa, hVa, hσU, hVO, ⟨hOO, hiso⟩, ⟨hUU, hinj, himg⟩⟩ := hD
  subst hπu
  haveI := hfl

  have s1 : ∀ {X Y S : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ S), IsSeparated (f ≫ g) →
      Surjective f → UniversallyClosed f → IsSeparated g := by
    intro X Y S f g h1 h2 h3
    constructor
    apply IsClosedImmersion.of_isPreimmersion
    let F := Limits.pullback.map (f ≫ g) (f ≫ g) g g f f (𝟙 S) (by simp) (by simp)
    have hF : UniversallyClosed F := by
      apply MorphismProperty.pullbackMap (P := @UniversallyClosed) <;>
        first | rfl | assumption
    have hid : Limits.pullback.diagonal (f ≫ g) ≫ F = f ≫ Limits.pullback.diagonal g := by
      apply Limits.pullback.hom_ext
      · erw [Category.assoc, Category.assoc, Limits.pullback.lift_fst,
          Limits.pullback.diagonal_fst, ← Category.assoc, Limits.pullback.diagonal_fst,
          Category.comp_id, Category.id_comp]
      · erw [Category.assoc, Category.assoc, Limits.pullback.lift_snd,
          Limits.pullback.diagonal_snd, ← Category.assoc, Limits.pullback.diagonal_snd,
          Category.comp_id, Category.id_comp]
    have hr : Set.range (Limits.pullback.diagonal g) =
        F '' Set.range (Limits.pullback.diagonal (f ≫ g)) := by
      rw [← Set.range_comp]
      have h4 : (F ∘ Limits.pullback.diagonal (f ≫ g)) = (Limits.pullback.diagonal g ∘ f) := by
        funext x
        simp only [Function.comp_apply]
        rw [← Scheme.Hom.comp_apply, hid, Scheme.Hom.comp_apply]
      rw [h4, Set.range_comp, f.surjective.range_eq, Set.image_univ]
    rw [hr]
    apply F.isClosedMap
    exact (Limits.pullback.diagonal (f ≫ g)).isClosedEmbedding.isClosed_range

  have s3 : ∀ (τ : Spec (.of R) ⟶ Zt) (h : ⊤ ≤ τ ⁻¹ᵁ U), τ ≫ (π ≫ uu) = 𝟙 _ →
      ∀ r : Γ(Spec (.of R), ⊤), (τ.appLE U ⊤ h).hom
        (((π ≫ uu).appLE ⊤ U (le_top.trans_eq (π ≫ uu).preimage_top.symm)).hom r) = r := by
    intro τ h hτ r
    rw [← CommRingCat.comp_apply, Scheme.Hom.appLE_comp_appLE]
    have : ∀ (g : Spec (.of R) ⟶ Spec (.of R)) (hg : g = 𝟙 _) (e : ⊤ ≤ g ⁻¹ᵁ ⊤),
        (g.appLE ⊤ ⊤ e).hom r = r := by
      intro g hg e
      subst hg
      simp only [Scheme.Hom.appLE, Scheme.Hom.id_app]
      have h1 : (homOfLE e).op = 𝟙 (Opposite.op (⊤ : (Spec (.of R)).Opens)) :=
        Subsingleton.elim _ _
      erw [h1, CategoryTheory.Functor.map_id, Category.comp_id]
      rfl
    exact this _ hτ _

  have s4 : ∀ (τ₁ τ₂ : Spec (.of R) ⟶ Zt) (h₁ : ⊤ ≤ τ₁ ⁻¹ᵁ U) (h₂ : ⊤ ≤ τ₂ ⁻¹ᵁ U),
      Function.Surjective (τ₁.appLE U ⊤ h₁).hom → Function.Surjective (τ₂.appLE U ⊤ h₂).hom →
      (∀ p q : ↥(Spec (.of R)), τ₁ p ≠ τ₂ q) →
      RingHom.ker (τ₁.appLE U ⊤ h₁).hom ⊔ RingHom.ker (τ₂.appLE U ⊤ h₂).hom = ⊤ := by
    intro τ₁ τ₂ h₁ h₂ hs₁ hs₂ hd
    by_contra hne
    obtain ⟨M, hM, hle⟩ := Ideal.exists_le_maximal _ hne
    have hMp := hM.isPrime
    have hT := isAffineOpen_top (Spec (.of R))
    let y : Spec Γ(Zt, U) := (⟨M, hMp⟩ : PrimeSpectrum Γ(Zt, U))
    have key : ∀ (τ : Spec (.of R) ⟶ Zt) (h : ⊤ ≤ τ ⁻¹ᵁ U),
        Function.Surjective (τ.appLE U ⊤ h).hom →
        RingHom.ker (τ.appLE U ⊤ h).hom ≤ M → ∃ p, τ p = hUa.fromSpec y := by
      intro τ h hs hk
      have hP : (Ideal.map (τ.appLE U ⊤ h).hom M).IsPrime :=
        Ideal.map_isPrime_of_surjective hs hk
      let x : Spec Γ(Spec (.of R), ⊤) :=
        (⟨Ideal.map (τ.appLE U ⊤ h).hom M, hP⟩ : PrimeSpectrum Γ(Spec (.of R), ⊤))
      refine ⟨hT.fromSpec x, ?_⟩
      have hsq := IsAffineOpen.SpecMap_appLE_fromSpec τ hUa hT h
      have hx : Spec.map (τ.appLE U ⊤ h) x = y := by
        rw [Spec.map_apply]
        apply PrimeSpectrum.ext
        rw [PrimeSpectrum.comap_asIdeal]
        show Ideal.comap _ (Ideal.map _ M) = M
        rw [Ideal.comap_map_of_surjective' _ hs, sup_eq_left.2 hk]
      calc τ (hT.fromSpec x) = (hT.fromSpec ≫ τ) x := (Scheme.Hom.comp_apply _ _ _).symm
        _ = (Spec.map (τ.appLE U ⊤ h) ≫ hUa.fromSpec) x := by rw [hsq]
        _ = hUa.fromSpec (Spec.map (τ.appLE U ⊤ h) x) := Scheme.Hom.comp_apply _ _ _
        _ = hUa.fromSpec y := by rw [hx]
    obtain ⟨p, hp⟩ := key τ₁ h₁ hs₁ (le_sup_left.trans hle)
    obtain ⟨q, hq⟩ := key τ₂ h₂ hs₂ (le_sup_right.trans hle)
    exact hd p q (hp.trans hq.symm)

  have s5 : ∀ (R0 A : Type u) [CommRing R0] [CommRing A] (s : Fin m × Fin 2 → (A →+* R0)),
      (∀ a b, a ≠ b → RingHom.ker (s a) ⊔ RingHom.ker (s b) = ⊤) →
      ∃ h : Fin m → A, ∀ e e' : Fin m, s (e', 0) (h e) = 0 ∧
        s (e', 1) (h e) = if e' = e then 1 else 0 := by
    intro R0 A _ _ s hc
    have hpw : Pairwise fun a b => IsCoprime (RingHom.ker (s a)) (RingHom.ker (s b)) :=
      fun a b hab => (Ideal.isCoprime_iff_sup_eq).2 (hc a b hab)
    have key : ∀ e : Fin m, ∃ r : A,
        ∀ a, r - (if a = (e, 1) then 1 else 0) ∈ RingHom.ker (s a) :=
      fun e => Ideal.exists_forall_sub_mem_ideal hpw _
    choose r hr using key
    refine ⟨r, fun e e' => ⟨?_, ?_⟩⟩
    · have := hr e (e', 0)
      rw [RingHom.mem_ker, map_sub, sub_eq_zero] at this
      rw [this]
      have hne : ((e', 0) : Fin m × Fin 2) ≠ (e, 1) := by
        intro h; simp [Prod.ext_iff] at h
      simp [hne]
    · have := hr e (e', 1)
      rw [RingHom.mem_ker, map_sub, sub_eq_zero] at this
      rw [this]
      by_cases he : e' = e
      · subst he; simp
      · have hne : ((e', 1) : Fin m × Fin 2) ≠ (e, 1) := by
          intro h; exact he (Prod.ext_iff.mp h).1
        simp [hne, he]

  have s6 : ∀ (R0 B A : Type u) [CommRing R0] [CommRing B] [CommRing A] (α : R0 →+* B)
      (ψ : B →+* A) (s : Fin m × Fin 2 → (A →+* R0)) (h : Fin m → A),
      Function.Injective ψ → (∀ a r, s a (ψ (α r)) = r) →
      (∀ g : A, (∃ b, ψ b = g) ↔ ∀ e, s (e, 0) g = s (e, 1) g) →
      (∀ e e' : Fin m, s (e', 0) (h e) = 0 ∧ s (e', 1) (h e) = if e' = e then 1 else 0) →
      (ψ.comp α).Flat → α.Flat := by
    intro R0 B A _ _ _ α ψ s h hψ hsr himg hh hfl
    letI : Algebra R0 B := α.toAlgebra
    letI : Algebra R0 A := (ψ.comp α).toAlgebra
    let ε : A → A := fun g => g - ∑ e, ψ (α (s (e, 1) g - s (e, 0) g)) * h e
    have hε : ∀ g e', s (e', 0) (ε g) = s (e', 0) g ∧ s (e', 1) (ε g) = s (e', 0) g := by
      intro g e'
      constructor
      · simp only [ε, map_sub, map_sum, map_mul, hsr, (hh _ e').1, mul_zero,
          Finset.sum_const_zero, sub_zero]
      · simp only [ε, map_sub, map_sum, map_mul, hsr, (hh _ e').2, mul_ite, mul_one, mul_zero]
        rw [Finset.sum_ite_eq]
        simp only [Finset.mem_univ, ite_true]
        ring
    have hmem : ∀ g, ∃ b, ψ b = ε g := fun g =>
      (himg _).2 (fun e => by rw [(hε g e).1, (hε g e).2])
    choose r hr using hmem
    have hεadd : ∀ x y, ε (x + y) = ε x + ε y := by
      intro x y
      have hs : ∀ e, ψ (α (s (e, 1) (x + y) - s (e, 0) (x + y))) * h e =
          ψ (α (s (e, 1) x - s (e, 0) x)) * h e + ψ (α (s (e, 1) y - s (e, 0) y)) * h e := by
        intro e; simp only [map_add, map_sub]; ring
      simp only [ε, hs, Finset.sum_add_distrib]
      ring
    have hεsmul : ∀ (c : R0) x, ε (ψ (α c) * x) = ψ (α c) * ε x := by
      intro c x
      simp only [ε, map_mul, hsr, mul_sub, Finset.mul_sum]
      congr 1
      refine Finset.sum_congr rfl fun e _ => ?_
      rw [← mul_sub, map_mul, map_mul]
      ring
    have hεE : ∀ b, ε (ψ b) = ψ b := by
      intro b
      have hb := (himg (ψ b)).1 ⟨b, rfl⟩
      simp only [ε, hb, sub_self, map_zero, zero_mul, Finset.sum_const_zero, sub_zero]
    let i : B →ₗ[R0] A :=
      { toFun := ψ
        map_add' := map_add ψ
        map_smul' := fun c b => by
          simp only [Algebra.smul_def, RingHom.algebraMap_toAlgebra, map_mul, RingHom.id_apply,
            RingHom.comp_apply] }
    let rl : A →ₗ[R0] B :=
      { toFun := r
        map_add' := fun x y => hψ (by rw [map_add, hr, hr, hr, hεadd])
        map_smul' := fun c x => hψ (by
          simp only [Algebra.smul_def, RingHom.algebraMap_toAlgebra, map_mul, RingHom.id_apply,
            RingHom.comp_apply, hr]
          exact hεsmul c x) }
    have hri : rl ∘ₗ i = LinearMap.id := by
      ext b
      exact hψ (by
        simp only [LinearMap.comp_apply, LinearMap.id_apply]; exact (hr _).trans (hεE b))
    show Module.Flat R0 B
    haveI : Module.Flat R0 A := hfl
    exact Module.Flat.of_retract i rl hri

  have s2 : ∀ (P : MorphismProperty Scheme.{u})
      {Q : ∀ {R S : Type u} [CommRing R] [CommRing S], (R →+* S) → Prop}
      [HasRingHomProperty P Q],
      Q (uu.appLE ⊤ V (le_top.trans_eq uu.preimage_top.symm)).hom → P (V.ι ≫ uu) := by
    intro P Q _ hQ
    haveI : IsAffine V.toScheme := hVa
    have htop : (⊤ : V.toScheme.Opens) ∈ V.toScheme.affineOpens := isAffineOpen_top _
    apply HasRingHomProperty.of_iSup_eq_top (P := P) (Q := Q) (fun _ : Unit => ⟨⊤, htop⟩)
    · simp
    · intro _
      have e2 : (⊤ : V.toScheme.Opens) ≤ V.ι ⁻¹ᵁ V := by intro x _; exact x.2
      rw [← Scheme.Hom.appLE_comp_appLE (V.ι) uu ⊤ V ⊤
        (le_top.trans_eq uu.preimage_top.symm) e2]
      have hiso : IsIso (V.ι.appLE V ⊤ e2) := by
        rw [Scheme.Opens.ι_appLE]
        have h1 : V.ι ''ᵁ ⊤ = V := Scheme.Opens.ι_image_top V
        have gen : ∀ (A B : Z.Opens) (hAB : A ≤ B) (hBA : B ≤ A),
            IsIso (Z.presheaf.map (homOfLE hAB).op) := by
          intro A B hAB hBA
          have : IsIso (homOfLE hAB).op :=
            ⟨⟨(homOfLE hBA).op, Subsingleton.elim _ _, Subsingleton.elim _ _⟩⟩
          infer_instance
        exact gen _ _ _ h1.ge
      exact ((HasRingHomProperty.isLocal_ringHomProperty P).respectsIso.cancel_right_isIso
        _ _).2 hQ

  have hσ : ∀ a, ⊤ ≤ σ a ⁻¹ᵁ U := fun a p _ => hσU a ⟨p, rfl⟩
  let s : Fin m × Fin 2 → (Γ(Zt, U) →+* Γ(Spec (.of R), ⊤)) :=
    fun a => ((σ a).appLE U ⊤ (hσ a)).hom
  let α := (uu.appLE ⊤ V (le_top.trans_eq uu.preimage_top.symm)).hom
  let ψ := (π.appLE V U hUU.ge).hom
  have hfac : ψ.comp α =
      ((π ≫ uu).appLE ⊤ U (le_top.trans_eq (π ≫ uu).preimage_top.symm)).hom := by
    show (uu.appLE ⊤ V (le_top.trans_eq uu.preimage_top.symm) ≫ π.appLE V U hUU.ge).hom = _
    rw [Scheme.Hom.appLE_comp_appLE]
  have hsr : ∀ a r, s a (ψ (α r)) = r := by
    intro a r
    show s a ((ψ.comp α) r) = r
    rw [hfac]
    exact s3 (σ a) (hσ a) (hσu a) r
  have hssurj : ∀ a, Function.Surjective (s a) := fun a r => ⟨ψ (α r), hsr a r⟩
  have hc : ∀ a b, a ≠ b → RingHom.ker (s a) ⊔ RingHom.ker (s b) = ⊤ := fun a b hab =>
    s4 (σ a) (σ b) (hσ a) (hσ b) (hssurj a) (hssurj b) (fun p q => hdisj a b p q hab)
  obtain ⟨h, hh⟩ := s5 _ _ s hc
  have himg' : ∀ g : Γ(Zt, U), (∃ b, ψ b = g) ↔ ∀ e, s (e, 0) g = s (e, 1) g := by
    intro g
    rw [himg g]
    exact ⟨fun H e => H e _ _, fun H e _ _ => H e⟩
  have hfl' : (ψ.comp α).Flat := by
    rw [hfac]
    exact HasRingHomProperty.appLE @Flat (π ≫ uu) hfl ⟨⊤, isAffineOpen_top _⟩ ⟨U, hUa⟩ _
  have hft' : (ψ.comp α).FiniteType := by
    rw [hfac]
    exact HasRingHomProperty.appLE @LocallyOfFiniteType (π ≫ uu) inferInstance
      ⟨⊤, isAffineOpen_top _⟩ ⟨U, hUa⟩ _
  have hαfl : α.Flat := s6 _ _ _ α ψ s h hinj hsr himg' hh hfl'
  have hαft : α.FiniteType :=
    wcpa_cl_fp_equalizer_finiteType _ _ _ α ψ m s h hinj hsr himg' hh hft'
  have hVfl : Flat (V.ι ≫ uu) := s2 @Flat hαfl
  have hVft : LocallyOfFiniteType (V.ι ≫ uu) := s2 @LocallyOfFiniteType hαft

  haveI := hiso
  have hO'eq : O'.ι ≫ uu =
      inv (π.resLE O' O hOO.ge) ≫ (O.ι ≫ (π ≫ uu)) := by
    rw [← Category.assoc O.ι, ← Scheme.Hom.resLE_comp_ι π hOO.ge, Category.assoc,
      IsIso.inv_hom_id_assoc]
  have hO'fl : Flat (O'.ι ≫ uu) := by
    rw [hO'eq]
    haveI : Flat (O.ι ≫ (π ≫ uu)) :=
      HasRingHomProperty.comp_of_isOpenImmersion @Flat O.ι _ hfl
    infer_instance
  have hO'ft : LocallyOfFiniteType (O'.ι ≫ uu) := by
    rw [hO'eq]
    haveI : LocallyOfFiniteType (O.ι ≫ (π ≫ uu)) :=
      HasRingHomProperty.comp_of_isOpenImmersion @LocallyOfFiniteType O.ι _ inferInstance
    infer_instance

  have hcov : (⨆ b : Bool, cond b V O') = ⊤ := by
    rw [iSup_bool_eq]; exact hVO
  haveI := HasRingHomProperty.instIsZariskiLocalAtSource (P := @Flat)
  haveI := HasRingHomProperty.instIsZariskiLocalAtSource (P := @LocallyOfFiniteType)
  have hFl : Flat uu :=
    IsZariskiLocalAtSource.of_iSup_eq_top (P := @Flat) (fun b : Bool => cond b V O') hcov
      (fun b => by cases b <;> assumption)
  have hFt : LocallyOfFiniteType uu :=
    IsZariskiLocalAtSource.of_iSup_eq_top (P := @LocallyOfFiniteType)
      (fun b : Bool => cond b V O') hcov (fun b => by cases b <;> assumption)

  have hUC : UniversallyClosed uu := UniversallyClosed.of_comp_surjective π uu
  have hSep : IsSeparated uu := s1 π uu inferInstance hsurj inferInstance
  exact ⟨hFl, @IsProper.mk _ _ _ hSep hUC hFt⟩

theorem wcpa_cl_ps_open_ns_iff : ∀ (K : Type u) [Field K] {X Y : Scheme.{u}} (j : Y ⟶ X) [IsOpenImmersion j] (a : X ⟶ Spec (.of K)) (y : ↥Y), ((∃ W : X.Opens, j y ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ a)) ∨ (∃ e : AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk (j y))) (X.presheaf.stalk (j y)) ≃+* (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), e.toRingHom.comp ((algebraMap (X.presheaf.stalk (j y)) (AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk (j y))) (X.presheaf.stalk (j y)))).comp ((Scheme.ΓSpecIso (.of K)).inv ≫ a.appTop ≫ X.presheaf.germ ⊤ (j y) trivial).hom) = (Ideal.Quotient.mk _).comp MvPowerSeries.C)) ↔ ((∃ W : Y.Opens, y ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ j ≫ a)) ∨ (∃ e : AdicCompletion (IsLocalRing.maximalIdeal (Y.presheaf.stalk y)) (Y.presheaf.stalk y) ≃+* (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), e.toRingHom.comp ((algebraMap (Y.presheaf.stalk y) (AdicCompletion (IsLocalRing.maximalIdeal (Y.presheaf.stalk y)) (Y.presheaf.stalk y))).comp ((Scheme.ΓSpecIso (.of K)).inv ≫ (j ≫ a).appTop ≫ Y.presheaf.germ ⊤ y trivial).hom) = (Ideal.Quotient.mk _).comp MvPowerSeries.C)) :=
by

  have hfe : ∀ {R : Type u} [CommRing R] (I : Ideal R) {m n : ℕ} (hle : m ≤ n)
      (y : AdicCompletion I R),
      Ideal.Quotient.factorPow I hle (AdicCompletion.evalₐ I n y) =
        AdicCompletion.evalₐ I m y := by
    intro R _ I m n hle y
    obtain ⟨s, rfl⟩ := AdicCompletion.mk_surjective I R y
    rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk]
    have key := AdicCompletion.AdicCauchySequence.mk_eq_mk hle s
    rw [Submodule.Quotient.eq] at key
    rw [Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk, Ideal.Quotient.eq]
    simpa [smul_eq_mul, Ideal.mul_top] using key

  have hadic : ∀ {A B : Type u} [CommRing A] [CommRing B] (I : Ideal A) (J : Ideal B)
      (σ : A ≃+* B), Ideal.map σ I = J → ∃ τ : AdicCompletion I A ≃+* AdicCompletion J B,
        ∀ a : A, τ (algebraMap A (AdicCompletion I A) a) =
          algebraMap B (AdicCompletion J B) (σ a) := by
    intro A B _ _ I J σ hIJ
    subst hIJ
    have h1 : ∀ n, I ^ n ≤ ((Ideal.map σ I) ^ n).comap σ.toRingHom := by
      intro n x hx
      rw [Ideal.mem_comap, ← Ideal.map_pow]
      exact Ideal.mem_map_of_mem σ hx
    have h2 : ∀ n, (Ideal.map σ I) ^ n ≤ (I ^ n).comap σ.symm.toRingHom := by
      intro n
      have : Ideal.map σ (I ^ n) ≤ (I ^ n).comap σ.symm.toRingHom := by
        rw [Ideal.map_le_iff_le_comap]
        intro x hx
        simpa [Ideal.mem_comap] using hx
      rwa [Ideal.map_pow] at this
    let f : ∀ n, A ⧸ I ^ n →+* B ⧸ (Ideal.map σ I) ^ n := fun n =>
      Ideal.quotientMap ((Ideal.map σ I) ^ n) σ.toRingHom (h1 n)
    let g : ∀ n, B ⧸ (Ideal.map σ I) ^ n →+* A ⧸ I ^ n := fun n =>
      Ideal.quotientMap (I ^ n) σ.symm.toRingHom (h2 n)
    have hgf : ∀ n z, g n (f n z) = z := by
      intro n z
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective z
      simp [f, g, Ideal.quotientMap_mk]
    have hfg : ∀ n z, f n (g n z) = z := by
      intro n z
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective z
      simp [f, g, Ideal.quotientMap_mk]
    let F : ∀ n, AdicCompletion I A →+* B ⧸ (Ideal.map σ I) ^ n := fun n =>
      (f n).comp (AdicCompletion.evalₐ I n).toRingHom
    have hF : ∀ {m n : ℕ} (hle : m ≤ n),
        (Ideal.Quotient.factorPow (Ideal.map σ I) hle).comp (F n) = F m := by
      intro m n hle
      refine RingHom.ext fun y => ?_
      show Ideal.Quotient.factorPow (Ideal.map σ I) hle (f n (AdicCompletion.evalₐ I n y)) =
        f m (AdicCompletion.evalₐ I m y)
      rw [← hfe I hle y]
      obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ I n y)
      rw [← ha]
      simp only [f, Ideal.quotientMap_mk, Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk]
    let G : ∀ n, AdicCompletion (Ideal.map σ I) B →+* A ⧸ I ^ n := fun n =>
      (g n).comp (AdicCompletion.evalₐ (Ideal.map σ I) n).toRingHom
    have hG : ∀ {m n : ℕ} (hle : m ≤ n), (Ideal.Quotient.factorPow I hle).comp (G n) = G m := by
      intro m n hle
      refine RingHom.ext fun y => ?_
      show Ideal.Quotient.factorPow I hle (g n (AdicCompletion.evalₐ (Ideal.map σ I) n y)) =
        g m (AdicCompletion.evalₐ (Ideal.map σ I) m y)
      rw [← hfe (Ideal.map σ I) hle y]
      obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ (Ideal.map σ I) n y)
      rw [← ha]
      simp only [g, Ideal.quotientMap_mk, Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk]
    let φ := AdicCompletion.liftRingHom (Ideal.map σ I) F hF
    let ψ := AdicCompletion.liftRingHom I G hG
    have hφ : ∀ n y, AdicCompletion.evalₐ (Ideal.map σ I) n (φ y) =
        f n (AdicCompletion.evalₐ I n y) :=
      fun n y => AdicCompletion.evalₐ_liftRingHom (Ideal.map σ I) F hF n y
    have hψ : ∀ n y, AdicCompletion.evalₐ I n (ψ y) =
        g n (AdicCompletion.evalₐ (Ideal.map σ I) n y) :=
      fun n y => AdicCompletion.evalₐ_liftRingHom I G hG n y
    have e1 : φ.comp ψ = RingHom.id _ := by
      refine RingHom.ext fun y => ?_
      apply AdicCompletion.ext_evalₐ
      intro n
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hφ, hψ, hfg]
    have e2 : ψ.comp φ = RingHom.id _ := by
      refine RingHom.ext fun y => ?_
      apply AdicCompletion.ext_evalₐ
      intro n
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hψ, hφ, hgf]
    refine ⟨RingEquiv.ofRingHom φ ψ e1 e2, fun a => ?_⟩
    show φ (algebraMap A (AdicCompletion I A) a) =
      algebraMap B (AdicCompletion (Ideal.map σ I) B) (σ a)
    apply AdicCompletion.ext_evalₐ
    intro n
    rw [hφ, AlgHom.commutes, AlgHom.commutes, Ideal.Quotient.algebraMap_eq,
      Ideal.Quotient.algebraMap_eq]
    simp [f, Ideal.quotientMap_mk]
  intro K _ X Y j _ a y

  let σ : X.presheaf.stalk (j y) ≃+* Y.presheaf.stalk y :=
    (asIso (j.stalkMap y)).commRingCatIsoToRingEquiv
  have hmax : Ideal.map σ (IsLocalRing.maximalIdeal (X.presheaf.stalk (j y))) =
      IsLocalRing.maximalIdeal (Y.presheaf.stalk y) :=
    IsLocalRing.eq_maximalIdeal (Ideal.map_isMaximal_of_equiv σ)
  obtain ⟨τ, hτ⟩ := hadic _ _ σ hmax
  have hgs : X.presheaf.germ ⊤ (j y) trivial ≫ j.stalkMap y =
      j.appTop ≫ Y.presheaf.germ ⊤ y trivial := by
    exact Scheme.Hom.germ_stalkMap j ⊤ y trivial
  have hmor : ((Scheme.ΓSpecIso (.of K)).inv ≫ a.appTop ≫
      X.presheaf.germ ⊤ (j y) trivial) ≫ j.stalkMap y =
      (Scheme.ΓSpecIso (.of K)).inv ≫ (j ≫ a).appTop ≫ Y.presheaf.germ ⊤ y trivial := by
    rw [Scheme.Hom.comp_appTop, Category.assoc, Category.assoc, hgs]
    simp only [Category.assoc]
  have hgerm : ∀ c : K, σ (((Scheme.ΓSpecIso (.of K)).inv ≫ a.appTop ≫
      X.presheaf.germ ⊤ (j y) trivial).hom c) =
      ((Scheme.ΓSpecIso (.of K)).inv ≫ (j ≫ a).appTop ≫ Y.presheaf.germ ⊤ y trivial).hom c := by
    intro c
    rw [← hmor]
    rfl
  constructor
  · rintro (⟨W, hW, hsm⟩ | ⟨eX, heX⟩)
    ·
      left
      refine ⟨j ⁻¹ᵁ W, hW, ?_⟩
      have heq : (j ⁻¹ᵁ W).ι ≫ j ≫ a = (j ∣_ W) ≫ (W.ι ≫ a) := by
        rw [← Category.assoc, ← morphismRestrict_ι, Category.assoc]
      have : SmoothOfRelativeDimension 1 (W.ι ≫ a) := hsm
      have : SmoothOfRelativeDimension 0 (j ∣_ W) := inferInstance
      have hc := smoothOfRelativeDimension_comp 0 1 (j ∣_ W) (W.ι ≫ a)
      rw [heq]
      simpa using hc
    · right
      refine ⟨τ.symm.trans eX, ?_⟩
      refine RingHom.ext fun c => ?_
      have h1 := RingHom.congr_fun heX c
      have h2 := hτ (((Scheme.ΓSpecIso (.of K)).inv ≫ a.appTop ≫
          X.presheaf.germ ⊤ (j y) trivial).hom c)
      simp only [RingHom.comp_apply] at h1 ⊢
      rw [← hgerm c, ← h2]
      simp only [RingEquiv.toRingHom_eq_coe, RingHom.coe_coe, RingEquiv.trans_apply,
        RingEquiv.symm_apply_apply] at h1 ⊢
      exact h1
  · rintro (⟨W', hW', hsm⟩ | ⟨eY, heY⟩)
    ·
      left
      refine ⟨j ''ᵁ W', ⟨y, hW', rfl⟩, ?_⟩
      have heq : (j ''ᵁ W').ι ≫ a = (j.isoImage W').inv ≫ (W'.ι ≫ j ≫ a) := by
        rw [← Scheme.Hom.isoImage_inv_ι j W']
        simp only [Category.assoc]
      have : SmoothOfRelativeDimension 1 (W'.ι ≫ j ≫ a) := hsm
      have : SmoothOfRelativeDimension 0 (j.isoImage W').inv := inferInstance
      have hc := smoothOfRelativeDimension_comp 0 1 (j.isoImage W').inv (W'.ι ≫ j ≫ a)
      rw [heq]
      simpa using hc
    · right
      refine ⟨τ.trans eY, ?_⟩
      refine RingHom.ext fun c => ?_
      have h1 := RingHom.congr_fun heY c
      have h2 := hτ (((Scheme.ΓSpecIso (.of K)).inv ≫ a.appTop ≫
          X.presheaf.germ ⊤ (j y) trivial).hom c)
      simp only [RingHom.comp_apply] at h1 ⊢
      simp only [RingEquiv.toRingHom_eq_coe, RingHom.coe_coe, RingEquiv.trans_apply] at h1 ⊢
      rw [h2, hgerm c]
      exact h1

theorem wcpa_cl_ps_point_prime : ∀ (K : Type u) [Field K] (Z : Scheme.{u}) (V : Z.Opens) (hV : IsAffineOpen V) (y : Spec (.of K) ⟶ Z) (h : ⊤ ≤ y ⁻¹ᵁ V) (hy : y (IsLocalRing.closedPoint K) ∈ V), (hV.primeIdealOf ⟨y (IsLocalRing.closedPoint K), hy⟩).asIdeal = RingHom.ker (y.appLE V ⊤ h).hom :=
by
  intro K _ Z V hV y h hy
  have hTop : IsAffineOpen (⊤ : (Spec (.of K)).Opens) := isAffineOpen_top _
  let P : ↥(Spec Γ(Spec (.of K), ⊤)) := hTop.primeIdealOf ⟨IsLocalRing.closedPoint K, trivial⟩
  have s1 := IsAffineOpen.SpecMap_appLE_fromSpec y hV hTop h
  have s2 : hV.fromSpec ((Spec.map (y.appLE V ⊤ h)) P) = y (IsLocalRing.closedPoint K) := by
    have e1 : hV.fromSpec ((Spec.map (y.appLE V ⊤ h)) P) = (Spec.map (y.appLE V ⊤ h) ≫ hV.fromSpec) P :=
      (Scheme.Hom.comp_apply _ _ _).symm
    have e2 : (hTop.fromSpec ≫ y) P = y (hTop.fromSpec P) := Scheme.Hom.comp_apply _ _ _
    have e3 : hTop.fromSpec P = IsLocalRing.closedPoint K :=
      hTop.fromSpec_primeIdealOf ⟨IsLocalRing.closedPoint K, trivial⟩
    rw [e1, s1, e2, e3]
  have s4 : hV.primeIdealOf ⟨_, hy⟩ = (Spec.map (y.appLE V ⊤ h)) P :=
    hV.fromSpec.isOpenEmbedding.injective (by rw [hV.fromSpec_primeIdealOf, s2])
  have s6 : P.asIdeal = ⊥ := by
    let e := (Scheme.ΓSpecIso (.of K)).commRingCatIsoToRingEquiv
    refine le_antisymm ?_ bot_le
    intro a ha
    rw [Ideal.mem_bot]
    by_contra hne
    have hu : IsUnit (e a) := IsUnit.mk0 _ ((RingEquiv.map_ne_zero_iff e).mpr hne)
    have hu' : IsUnit a := by
      have := hu.map e.symm
      simpa using this
    exact P.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ ha hu')
  rw [s4]
  ext g
  show g ∈ Ideal.comap (y.appLE V ⊤ h).hom P.asIdeal ↔ _
  rw [Ideal.mem_comap, s6, Ideal.mem_bot, RingHom.mem_ker]

theorem wcpa_cl_ps_smooth_hilbert : ∀ (K : Type u) [Field K] (X : Scheme.{u}) (a : X ⟶ Spec (.of K)) (τ : Spec (.of K) ⟶ X) (W U : X.Opens), τ ≫ a = 𝟙 _ → τ (IsLocalRing.closedPoint K) ∈ W → SmoothOfRelativeDimension 1 (W.ι ≫ a) → IsAffineOpen U → ∀ (h : ⊤ ≤ τ ⁻¹ᵁ U) (n : ℕ), letI : Algebra K Γ(X, U) := ((Scheme.ΓSpecIso (.of K)).inv ≫ a.appLE ⊤ U le_top).hom.toAlgebra; Module.finrank K (Γ(X, U) ⧸ RingHom.ker (τ.appLE U ⊤ h).hom ^ n) = n :=
by

  have L1 : ∀ (B R : Type u) [CommRing B] [CommRing R] [Algebra B R] [IsLocalRing R] (𝔪 : Ideal B)
      [𝔪.IsMaximal], IsLocalization.AtPrime R 𝔪 → ∀ n : ℕ,
      ∃ e : (B ⧸ 𝔪 ^ n) ≃+* (R ⧸ IsLocalRing.maximalIdeal R ^ n),
        ∀ b : B, e (Ideal.Quotient.mk _ b) = Ideal.Quotient.mk _ (algebraMap B R b) := by
    intro B R _ _ _ _ 𝔪 h𝔪 hloc n
    have hmap : Ideal.map (algebraMap B R) (𝔪 ^ n) = IsLocalRing.maximalIdeal R ^ n := by
      rw [Ideal.map_pow, IsLocalization.AtPrime.map_eq_maximalIdeal]
    have unit : ∀ t : B, t ∉ 𝔪 → ∃ u : B, 1 - u * t ∈ 𝔪 ^ n := by
      intro t ht
      obtain ⟨y, i, hi, hyi⟩ := h𝔪.exists_inv ht
      refine ⟨y * ∑ k ∈ Finset.range n, i ^ k, ?_⟩
      have hyt : y * t = 1 - i := by rw [← hyi]; ring
      have : 1 - y * (∑ k ∈ Finset.range n, i ^ k) * t = i ^ n := by
        calc 1 - y * (∑ k ∈ Finset.range n, i ^ k) * t
            = 1 - (∑ k ∈ Finset.range n, i ^ k) * (y * t) := by ring
          _ = 1 - (∑ k ∈ Finset.range n, i ^ k) * (1 - i) := by rw [hyt]
          _ = i ^ n := by rw [geom_sum_mul_neg]; ring
      rw [this]; exact Ideal.pow_mem_pow hi n
    set f : B →+* R ⧸ IsLocalRing.maximalIdeal R ^ n :=
      (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ n)).comp (algebraMap B R) with hf
    have hsurj : Function.Surjective f := by
      intro z
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective z
      obtain ⟨⟨b, t⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔪.primeCompl r
      have ht : (t : B) ∉ 𝔪 := t.2
      obtain ⟨u, hu⟩ := unit t ht
      refine ⟨b * u, ?_⟩
      rw [hf, RingHom.comp_apply, Ideal.Quotient.eq]
      have hspec := IsLocalization.mk'_spec R b t
      have hmem : algebraMap B R (1 - u * t) ∈ IsLocalRing.maximalIdeal R ^ n := by
        rw [← hmap]; exact Ideal.mem_map_of_mem _ hu
      have e : algebraMap B R (b * u) - IsLocalization.mk' R b t =
          -(IsLocalization.mk' R b t * algebraMap B R (1 - u * t)) := by
        rw [map_mul, ← hspec, map_sub, map_one, map_mul]; ring
      rw [e]
      exact neg_mem (Ideal.mul_mem_left _ _ hmem)
    have hker : 𝔪 ^ n = RingHom.ker f := by
      ext b
      rw [RingHom.mem_ker, hf, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem, ← hmap]
      constructor
      · intro hb; exact Ideal.mem_map_of_mem _ hb
      · intro hb
        obtain ⟨⟨x, s⟩, hxs⟩ := (IsLocalization.mem_map_algebraMap_iff 𝔪.primeCompl R).mp hb
        have h0 : algebraMap B R (b * s - x) = 0 := by
          rw [map_sub, map_mul]; simp only at hxs; rw [hxs, sub_self]
        obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff 𝔪.primeCompl R _).mp h0
        have hs : (s : B) ∉ 𝔪 := s.2
        have hm' : (m : B) ∉ 𝔪 := m.2
        have htn : (m : B) * s ∉ 𝔪 := fun hh => (h𝔪.isPrime.mem_or_mem hh).elim hm' hs
        obtain ⟨u, hu⟩ := unit _ htn
        have htb : (m : B) * s * b ∈ 𝔪 ^ n := by
          have : (m : B) * s * b = m * (b * s - x) + m * x := by ring
          rw [this, hm, zero_add]
          exact Ideal.mul_mem_left _ _ x.2
        have : b = u * ((m : B) * s * b) + (1 - u * ((m : B) * s)) * b := by ring
        rw [this]
        exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ htb) (Ideal.mul_mem_right _ _ hu)
    refine ⟨(Ideal.quotEquivOfEq hker).trans (RingHom.quotientKerEquivOfSurjective hsurj), ?_⟩
    intro b
    rfl

  have L2 : ∀ (K R : Type u) [Field K] [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
      (φ : K →+* R), (∀ r : R, ∃ c : K, r - φ c ∈ IsLocalRing.maximalIdeal R) → ∀ n : ℕ,
      letI : Algebra K R := φ.toAlgebra
      Module.finrank K (R ⧸ IsLocalRing.maximalIdeal R ^ n) = n := by
    intro K R _ _ _ _ φ hres n
    letI : Algebra K R := φ.toAlgebra
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
    have hmax : IsLocalRing.maximalIdeal R = Ideal.span {ϖ} := hϖ.maximalIdeal_eq
    have hpow : ∀ k : ℕ, IsLocalRing.maximalIdeal R ^ k = Ideal.span {ϖ ^ k} := by
      intro k; rw [hmax, Ideal.span_singleton_pow]
    have hϖ0 : ϖ ≠ 0 := hϖ.ne_zero
    have halg : ∀ (I : Ideal R) (c : K) (x : R),
        c • (Ideal.Quotient.mk I x) = Ideal.Quotient.mk I (φ c * x) := by
      intro I c x
      rw [Algebra.smul_def, map_mul]
      rfl
    have key : ∀ k : ℕ, Module.rank K (R ⧸ IsLocalRing.maximalIdeal R ^ k) = k := by
      intro k
      induction k with
      | zero =>
        rw [pow_zero, Ideal.one_eq_top]
        haveI : Subsingleton (R ⧸ (⊤ : Ideal R)) := Ideal.Quotient.subsingleton_iff.mpr rfl
        simp
      | succ k ih =>
        have hle : IsLocalRing.maximalIdeal R ^ (k + 1) ≤ IsLocalRing.maximalIdeal R ^ k :=
          Ideal.pow_le_pow_right (Nat.le_succ k)
        let π : (R ⧸ IsLocalRing.maximalIdeal R ^ (k + 1)) →ₗ[K]
            (R ⧸ IsLocalRing.maximalIdeal R ^ k) :=
          (Ideal.Quotient.factorₐ K hle).toLinearMap
        have hπ : ∀ x : R, π (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ x := fun x => rfl
        have hπs : Function.Surjective π := by
          intro z
          obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
          exact ⟨Ideal.Quotient.mk _ x, hπ x⟩
        set v : R ⧸ IsLocalRing.maximalIdeal R ^ (k + 1) := Ideal.Quotient.mk _ (ϖ ^ k) with hv
        have hv0 : v ≠ 0 := by
          intro h0
          rw [hv, Ideal.Quotient.eq_zero_iff_mem, hpow, Ideal.mem_span_singleton'] at h0
          obtain ⟨a, ha⟩ := h0
          have h1 : ϖ ^ k * (a * ϖ - 1) = 0 := by
            have e : ϖ ^ k * (a * ϖ - 1) = a * ϖ ^ (k + 1) - ϖ ^ k := by ring
            rw [e, ha, sub_self]
          have h2 : a * ϖ - 1 = 0 := (mul_eq_zero.mp h1).resolve_left (pow_ne_zero _ hϖ0)
          apply hϖ.not_isUnit
          exact isUnit_iff_exists_inv.mpr ⟨a, by rw [mul_comm]; exact sub_eq_zero.mp h2⟩
        have hkerπ : LinearMap.ker π = K ∙ v := by
          ext q
          obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective q
          rw [LinearMap.mem_ker, hπ, Submodule.mem_span_singleton, Ideal.Quotient.eq_zero_iff_mem,
            hpow, Ideal.mem_span_singleton']
          constructor
          · rintro ⟨r, rfl⟩
            obtain ⟨c, hc⟩ := hres r
            rw [hmax, Ideal.mem_span_singleton'] at hc
            obtain ⟨b, hb⟩ := hc
            refine ⟨c, ?_⟩
            rw [hv, halg, Ideal.Quotient.eq, hpow, Ideal.mem_span_singleton']
            refine ⟨-b, ?_⟩
            have e : φ c * ϖ ^ k - r * ϖ ^ k = -((r - φ c) * ϖ ^ k) := by ring
            rw [e, ← hb]; ring
          · rintro ⟨c, hc⟩
            rw [hv, halg, Ideal.Quotient.eq, hpow, Ideal.mem_span_singleton'] at hc
            obtain ⟨a, ha⟩ := hc
            refine ⟨φ c - a * ϖ, ?_⟩
            have e : (φ c - a * ϖ) * ϖ ^ k = φ c * ϖ ^ k - a * ϖ ^ (k + 1) := by ring
            rw [e, ha]; ring
        have hrn := LinearMap.rank_range_add_rank_ker π
        rw [LinearMap.range_eq_top.mpr hπs, rank_top, ih,
          (LinearEquiv.ofEq _ _ hkerπ).rank_eq,
          ← (LinearEquiv.toSpanNonzeroSingleton K _ v hv0).rank_eq, Module.rank_self] at hrn
        rw [← hrn]
        push_cast
        rfl
    exact Module.finrank_eq_of_rank_eq (key n)

  have L3 : ∀ (K : Type u) [Field K] (X : Scheme.{u}) (a : X ⟶ Spec (.of K))
      (τ : Spec (.of K) ⟶ X) (W : X.Opens), τ ≫ a = 𝟙 _ → τ (IsLocalRing.closedPoint K) ∈ W →
      SmoothOfRelativeDimension 1 (W.ι ≫ a) →
      ∃ _ : IsDomain (X.presheaf.stalk (τ (IsLocalRing.closedPoint K))),
        IsDiscreteValuationRing (X.presheaf.stalk (τ (IsLocalRing.closedPoint K))) := by
    intro K _ X a τ W hτa hxW hsm
    set s := W.ι ≫ a with hs
    set w : W := ⟨τ (IsLocalRing.closedPoint K), hxW⟩ with hw
    haveI hdom : IsDomain (W.toScheme.presheaf.stalk w) := wcpa_smooth_stalk_isDomain K W s 1 w
    haveI hval : ValuationRing (W.toScheme.presheaf.stalk w) :=
      wcpa_dj_sgt_smooth_curve_stalk_valuation K W s w
    haveI : Smooth s := SmoothOfRelativeDimension.smooth 1 s
    haveI : IsLocallyNoetherian W.toScheme := LocallyOfFiniteType.isLocallyNoetherian s
    haveI : IsClosedImmersion τ := isClosedImmersion_of_comp_eq_id a τ hτa
    have hrange : Set.range τ = {τ (IsLocalRing.closedPoint K)} := by
      ext y
      constructor
      · rintro ⟨p, rfl⟩
        rw [Subsingleton.elim p (IsLocalRing.closedPoint K)]
        rfl
      · rintro rfl; exact ⟨_, rfl⟩
    have hcl : IsClosed ({τ (IsLocalRing.closedPoint K)} : Set X) := by
      rw [← hrange]; exact τ.isClosedEmbedding.isClosed_range
    have hclw : IsClosed ({w} : Set W.toScheme) := by
      have : ({w} : Set W.toScheme) = W.ι ⁻¹' {τ (IsLocalRing.closedPoint K)} := by
        ext y
        simp only [Set.mem_singleton_iff, Set.mem_preimage, Scheme.Opens.ι_apply]
        constructor
        · rintro rfl; rfl
        · intro h; exact Subtype.ext h
      rw [this]
      exact hcl.preimage W.ι.continuous
    have hdim := wc_lfi_smooth_stalk_dim K W s 1 w hclw
    have hnf : ¬ IsField (W.toScheme.presheaf.stalk w) := by
      intro hf
      rw [ringKrullDim_eq_zero_of_isField hf] at hdim
      exact absurd hdim (by decide)
    have hnoeth : ∀ (Y : Scheme.{u}) [IsLocallyNoetherian Y] (y : Y),
        IsNoetherianRing (Y.presheaf.stalk y) := fun Y _ y => inferInstance
    haveI : IsNoetherianRing (W.toScheme.presheaf.stalk w) := hnoeth W.toScheme w
    haveI hdvr : IsDiscreteValuationRing (W.toScheme.presheaf.stalk w) :=
      ((IsDiscreteValuationRing.TFAE _ hnf).out 1 2).mpr hval
    let ε := (W.stalkIso w).commRingCatIsoToRingEquiv
    haveI : IsDomain (X.presheaf.stalk (τ (IsLocalRing.closedPoint K))) :=
      MulEquiv.isDomain _ ε.symm.toMulEquiv
    exact ⟨inferInstance, IsDiscreteValuationRing.RingEquivClass.isDiscreteValuationRing ε⟩

  intro K _ X a τ W U hτa hxW hsm hU h n
  letI : Algebra K Γ(X, U) := ((Scheme.ΓSpecIso (.of K)).inv ≫ a.appLE ⊤ U le_top).hom.toAlgebra
  have cong : ∀ {X Y : Scheme.{u}} {f g : X ⟶ Y}, f = g → ∀ (U : Y.Opens) (V : X.Opens)
      (e : V ≤ f ⁻¹ᵁ U) (e' : V ≤ g ⁻¹ᵁ U), f.appLE U V e = g.appLE U V e' := by
    rintro X Y f g rfl U V e e'
    rfl
  have idtop : ∀ (X : Scheme.{u}) (e : (⊤ : X.Opens) ≤ (𝟙 X : X ⟶ X) ⁻¹ᵁ ⊤),
      Scheme.Hom.appLE (𝟙 X) ⊤ ⊤ e = 𝟙 _ := by
    intro X e
    simp only [Scheme.Hom.appLE, Scheme.Hom.id_app, Category.id_comp]
    rw [show (homOfLE e).op = 𝟙 (Opposite.op (⊤ : X.Opens)) from Subsingleton.elim _ _]
    exact (Category.id_comp _).trans (X.presheaf.map_id _)
  have hΓinj : Function.Injective (Scheme.ΓSpecIso (.of K)).hom.hom :=
    (Scheme.ΓSpecIso (.of K)).commRingCatIsoToRingEquiv.injective

  have hsκ : ∀ c : K, (Scheme.ΓSpecIso (.of K)).hom.hom ((τ.appLE U ⊤ h).hom
      (((Scheme.ΓSpecIso (.of K)).inv ≫ a.appLE ⊤ U le_top).hom c)) = c := by
    intro c
    have h1' : a.appLE ⊤ U le_top ≫ τ.appLE U ⊤ h = 𝟙 _ :=
      ((Scheme.Hom.appLE_comp_appLE _ _ _ _ _ _ _).trans
        (cong hτa ⊤ ⊤ _ (fun _ _ => trivial))).trans (idtop _ _)
    have h2 : ∀ z, (τ.appLE U ⊤ h).hom ((a.appLE ⊤ U le_top).hom z) = z :=
      fun z => congrArg (fun f => CommRingCat.Hom.hom f z) h1'
    have h3 : ∀ z : K, (Scheme.ΓSpecIso (.of K)).hom.hom ((Scheme.ΓSpecIso (.of K)).inv.hom z) =
        z := fun z => congrArg (fun f => CommRingCat.Hom.hom f z)
          (Iso.inv_hom_id (Scheme.ΓSpecIso (.of K)))
    show (Scheme.ΓSpecIso (.of K)).hom.hom ((τ.appLE U ⊤ h).hom
      ((a.appLE ⊤ U le_top).hom ((Scheme.ΓSpecIso (.of K)).inv.hom c))) = c
    rw [h2, h3]

  have hkerS : RingHom.ker ((Scheme.ΓSpecIso (.of K)).hom.hom.comp (τ.appLE U ⊤ h).hom) =
      RingHom.ker (τ.appLE U ⊤ h).hom := RingHom.ker_comp_of_injective _ hΓinj
  have hsurjS : Function.Surjective
      ((Scheme.ΓSpecIso (.of K)).hom.hom.comp (τ.appLE U ⊤ h).hom) :=
    fun c => ⟨((Scheme.ΓSpecIso (.of K)).inv ≫ a.appLE ⊤ U le_top).hom c, hsκ c⟩
  haveI hPmax : (RingHom.ker (τ.appLE U ⊤ h).hom).IsMaximal :=
    hkerS ▸ RingHom.ker_isMaximal_of_surjective _ hsurjS

  have hy : τ (IsLocalRing.closedPoint K) ∈ U :=
    h (show IsLocalRing.closedPoint K ∈ (⊤ : (Spec (.of K)).Opens) from trivial)
  have hprime := wcpa_cl_ps_point_prime K X U hU τ h hy

  letI : Algebra Γ(X, U) (X.presheaf.stalk (τ (IsLocalRing.closedPoint K))) :=
    TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨_, hy⟩
  have hloc : IsLocalization.AtPrime (X.presheaf.stalk (τ (IsLocalRing.closedPoint K)))
      (RingHom.ker (τ.appLE U ⊤ h).hom) := by
    have h0 := hU.isLocalization_stalk ⟨_, hy⟩
    have hsub : (RingHom.ker (τ.appLE U ⊤ h).hom).primeCompl =
        (hU.primeIdealOf ⟨_, hy⟩).asIdeal.primeCompl := by
      ext z
      rw [Ideal.mem_primeCompl_iff, Ideal.mem_primeCompl_iff, hprime]
    show IsLocalization (RingHom.ker _).primeCompl _
    rw [hsub]
    exact h0

  obtain ⟨hdom, hdvr⟩ := L3 K X a τ W hτa hxW hsm

  let φ : K →+* X.presheaf.stalk (τ (IsLocalRing.closedPoint K)) :=
    (algebraMap Γ(X, U) (X.presheaf.stalk (τ (IsLocalRing.closedPoint K)))).comp
      ((Scheme.ΓSpecIso (.of K)).inv ≫ a.appLE ⊤ U le_top).hom
  obtain ⟨e, he⟩ := L1 Γ(X, U) (X.presheaf.stalk (τ (IsLocalRing.closedPoint K)))
    (RingHom.ker (τ.appLE U ⊤ h).hom) hloc n
  obtain ⟨e1, he1⟩ := L1 Γ(X, U) (X.presheaf.stalk (τ (IsLocalRing.closedPoint K)))
    (RingHom.ker (τ.appLE U ⊤ h).hom) hloc 1
  have hres : ∀ r : X.presheaf.stalk (τ (IsLocalRing.closedPoint K)), ∃ c : K,
      r - φ c ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk (τ (IsLocalRing.closedPoint K))) := by
    intro r
    obtain ⟨q, hq⟩ := e1.surjective (Ideal.Quotient.mk _ r)
    obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective q
    rw [he1, Ideal.Quotient.eq, pow_one] at hq
    refine ⟨(Scheme.ΓSpecIso (.of K)).hom.hom ((τ.appLE U ⊤ h).hom g), ?_⟩
    set c := (Scheme.ΓSpecIso (.of K)).hom.hom ((τ.appLE U ⊤ h).hom g) with hc
    have hg : g - ((Scheme.ΓSpecIso (.of K)).inv ≫ a.appLE ⊤ U le_top).hom c ∈
        RingHom.ker (τ.appLE U ⊤ h).hom := by
      rw [← hkerS, RingHom.mem_ker, map_sub]
      show c - (Scheme.ΓSpecIso (.of K)).hom.hom ((τ.appLE U ⊤ h).hom
        (((Scheme.ΓSpecIso (.of K)).inv ≫ a.appLE ⊤ U le_top).hom c)) = 0
      rw [hsκ, sub_self]
    have hg' : algebraMap Γ(X, U) (X.presheaf.stalk (τ (IsLocalRing.closedPoint K)))
        (g - ((Scheme.ΓSpecIso (.of K)).inv ≫ a.appLE ⊤ U le_top).hom c) ∈
        IsLocalRing.maximalIdeal (X.presheaf.stalk (τ (IsLocalRing.closedPoint K))) := by
      rw [← IsLocalization.AtPrime.map_eq_maximalIdeal (RingHom.ker (τ.appLE U ⊤ h).hom)
        (X.presheaf.stalk (τ (IsLocalRing.closedPoint K)))]
      exact Ideal.mem_map_of_mem _ hg
    have hsplit : r - φ c = algebraMap Γ(X, U) (X.presheaf.stalk (τ (IsLocalRing.closedPoint K)))
        (g - ((Scheme.ΓSpecIso (.of K)).inv ≫ a.appLE ⊤ U le_top).hom c) -
        (algebraMap Γ(X, U) (X.presheaf.stalk (τ (IsLocalRing.closedPoint K))) g - r) := by
      rw [map_sub]
      show r - algebraMap Γ(X, U) (X.presheaf.stalk (τ (IsLocalRing.closedPoint K)))
        (((Scheme.ΓSpecIso (.of K)).inv ≫ a.appLE ⊤ U le_top).hom c) = _
      ring
    rw [hsplit]
    exact sub_mem hg' hq
  letI : Algebra K (X.presheaf.stalk (τ (IsLocalRing.closedPoint K))) := φ.toAlgebra
  let eK : (Γ(X, U) ⧸ RingHom.ker (τ.appLE U ⊤ h).hom ^ n) ≃ₐ[K]
      (X.presheaf.stalk (τ (IsLocalRing.closedPoint K)) ⧸
        IsLocalRing.maximalIdeal (X.presheaf.stalk (τ (IsLocalRing.closedPoint K))) ^ n) :=
    AlgEquiv.ofRingEquiv (f := e) (fun c => by
      show e (Ideal.Quotient.mk _ (((Scheme.ΓSpecIso (.of K)).inv ≫ a.appLE ⊤ U le_top).hom c)) =
        Ideal.Quotient.mk _ (φ c)
      rw [he]
      rfl)
  exact (LinearEquiv.finrank_eq eK.toLinearEquiv).trans
    (L2 K (X.presheaf.stalk (τ (IsLocalRing.closedPoint K))) φ hres n)

theorem wcpa_dj_lq_completion_presentation : ∀ (K : Type u) [Field K] (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (φ : K →+* R), wcpaLqHilb K R φ → ∀ u v : R, wcpaLqBasis K R φ u v → ∀ a b c : K, (a ≠ 0 ∨ b ≠ 0 ∨ c ≠ 0) → φ a * u ^ 2 + φ b * (u * v) + φ c * v ^ 2 ∈ IsLocalRing.maximalIdeal R ^ 3 → ∃ f : MvPowerSeries (Fin 2) K, 3 ≤ MvPowerSeries.order (f - wcpaBscQuad K a b c) ∧ ∃ e : AdicCompletion (IsLocalRing.maximalIdeal R) R ≃+* (MvPowerSeries (Fin 2) K ⧸ Ideal.span {f}), e.toRingHom.comp ((algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)).comp φ) = (Ideal.Quotient.mk _).comp MvPowerSeries.C :=
by
  intro K _ R _ _ _ φ hHilb u v hbas a b c hne hrel
  classical
  have hu : u ∈ IsLocalRing.maximalIdeal R := hbas.1
  have hv : v ∈ IsLocalRing.maximalIdeal R := hbas.2.1

  have evalHigh : ∀ (I : Ideal R), u ∈ I → v ∈ I → ∀ (n : ℕ) (p : MvPolynomial (Fin 2) K),
      (∀ d : Fin 2 →₀ ℕ, Finsupp.degree d < n → p.coeff d = 0) →
      MvPolynomial.eval₂ φ ![u, v] p ∈ I ^ n := by
    intro I hu hv n p hp
    rw [MvPolynomial.eval₂_eq']
    refine Ideal.sum_mem _ (fun d hd => ?_)
    apply Ideal.mul_mem_left
    rw [Fin.prod_univ_two]
    have hdeg : n ≤ d 0 + d 1 := by
      by_contra h
      have := hp d (by rw [Finsupp.degree_eq_sum, Fin.sum_univ_two]; omega)
      exact (MvPolynomial.mem_support_iff.mp hd) this
    have h1 : (![u, v] 0) ^ d 0 * (![u, v] 1) ^ d 1 ∈ I ^ (d 0 + d 1) := by
      rw [pow_add]
      exact Ideal.mul_mem_mul (Ideal.pow_mem_pow hu _) (Ideal.pow_mem_pow hv _)
    exact Ideal.pow_le_pow_right hdeg h1
  have evalAgree : ∀ (I : Ideal R), u ∈ I → v ∈ I → ∀ (n : ℕ) (p q : MvPolynomial (Fin 2) K),
      (∀ d : Fin 2 →₀ ℕ, Finsupp.degree d < n → p.coeff d = q.coeff d) →
      Ideal.Quotient.mk (I ^ n) (MvPolynomial.eval₂ φ ![u, v] p) =
        Ideal.Quotient.mk (I ^ n) (MvPolynomial.eval₂ φ ![u, v] q) := by
    intro I hu hv n p q hpq
    rw [Ideal.Quotient.eq, ← MvPolynomial.eval₂_sub]
    exact evalHigh I hu hv n (p - q) (fun d hd => by
      rw [MvPolynomial.coeff_sub, hpq d hd, sub_self])
  have hEH : ∀ (j : ℕ) (H : MvPolynomial (Fin 2) K), H.IsHomogeneous j →
      MvPolynomial.eval₂ φ ![u, v] H ∈ IsLocalRing.maximalIdeal R ^ j := fun j H hH =>
    evalHigh _ hu hv j H (fun d hd => hH.coeff_eq_zero (by omega))

  have hspan : ∀ (j : ℕ) (y : R), y ∈ IsLocalRing.maximalIdeal R ^ j → ∃ H : MvPolynomial (Fin 2) K,
      H.IsHomogeneous j ∧ y - MvPolynomial.eval₂ φ ![u, v] H ∈ IsLocalRing.maximalIdeal R ^ (j + 1) := by
    have hres : ∀ r : R, ∃ c : K, r - φ c ∈ IsLocalRing.maximalIdeal R := by
      letI : Algebra K R := φ.toAlgebra
      have h1 : Module.finrank K (R ⧸ IsLocalRing.maximalIdeal R ^ 1) = 1 :=
        (hHilb 1 le_rfl).trans (by norm_num)
      have hmax : (IsLocalRing.maximalIdeal R).IsMaximal := inferInstance
      have hne1 : (1 : R ⧸ IsLocalRing.maximalIdeal R ^ 1) ≠ 0 := by
        intro h
        have h2 : (1 : R) ∈ IsLocalRing.maximalIdeal R ^ 1 :=
          Ideal.Quotient.eq_zero_iff_mem.mp (by rw [map_one]; exact h)
        rw [pow_one] at h2
        exact hmax.ne_top ((Ideal.eq_top_iff_one _).mpr h2)
      intro r
      obtain ⟨c, hc⟩ := (finrank_eq_one_iff_of_nonzero' (1 : R ⧸ IsLocalRing.maximalIdeal R ^ 1) hne1).mp h1
        (Ideal.Quotient.mk _ r)
      refine ⟨c, ?_⟩
      rw [Algebra.smul_def, mul_one, ← Ideal.Quotient.mk_algebraMap, RingHom.algebraMap_toAlgebra] at hc
      have h3 := Ideal.Quotient.eq.mp hc.symm
      rwa [pow_one] at h3
    intro j
    induction j with
    | zero =>
      intro y _
      obtain ⟨c, hc⟩ := hres y
      refine ⟨MvPolynomial.C c, MvPolynomial.isHomogeneous_C _ _, ?_⟩
      rw [MvPolynomial.eval₂_C, zero_add, pow_one]; exact hc
    | succ j ih =>
      intro y hy
      rw [pow_succ] at hy
      refine Submodule.mul_induction_on (C := fun y => ∃ H : MvPolynomial (Fin 2) K, H.IsHomogeneous (j + 1) ∧
        y - MvPolynomial.eval₂ φ ![u, v] H ∈ IsLocalRing.maximalIdeal R ^ (j + 1 + 1)) hy ?_ ?_
      · intro z hz m hm
        obtain ⟨H', hH', hz'⟩ := ih z hz
        obtain ⟨c₁, c₂, hm'⟩ := hbas.2.2.1 m hm
        refine ⟨H' * (MvPolynomial.C c₁ * MvPolynomial.X 0 + MvPolynomial.C c₂ * MvPolynomial.X 1), ?_, ?_⟩
        · exact hH'.mul (((MvPolynomial.isHomogeneous_C _ c₁).mul (MvPolynomial.isHomogeneous_X _ 0)).add
            ((MvPolynomial.isHomogeneous_C _ c₂).mul (MvPolynomial.isHomogeneous_X _ 1)))
        · have hevL : MvPolynomial.eval₂ φ ![u, v] (H' * (MvPolynomial.C c₁ * MvPolynomial.X 0 + MvPolynomial.C c₂ * MvPolynomial.X 1)) = MvPolynomial.eval₂ φ ![u, v] H' * (φ c₁ * u + φ c₂ * v) := by
            simp [MvPolynomial.eval₂_mul, MvPolynomial.eval₂_add, MvPolynomial.eval₂_C, MvPolynomial.eval₂_X]
          rw [hevL]
          have hL : φ c₁ * u + φ c₂ * v ∈ IsLocalRing.maximalIdeal R :=
            Ideal.add_mem _ (Ideal.mul_mem_left _ _ hu) (Ideal.mul_mem_left _ _ hv)
          have key : z * m - MvPolynomial.eval₂ φ ![u, v] H' * (φ c₁ * u + φ c₂ * v) =
              MvPolynomial.eval₂ φ ![u, v] H' * (m - (φ c₁ * u + φ c₂ * v)) +
              (z - MvPolynomial.eval₂ φ ![u, v] H') * (φ c₁ * u + φ c₂ * v) +
              (z - MvPolynomial.eval₂ φ ![u, v] H') * (m - (φ c₁ * u + φ c₂ * v)) := by ring
          rw [key]
          refine Ideal.add_mem _ (Ideal.add_mem _ ?_ ?_) ?_
          · have h := Ideal.mul_mem_mul (hEH j H' hH') hm'
            rwa [← pow_add] at h
          · have h := Ideal.mul_mem_mul hz' hL
            rwa [← pow_succ] at h
          · have h := Ideal.mul_mem_mul hz' hm'
            rw [← pow_add] at h
            exact Ideal.pow_le_pow_right (by omega) h
      · rintro x y ⟨H1, h1, hx⟩ ⟨H2, h2, hy⟩
        refine ⟨H1 + H2, h1.add h2, ?_⟩
        rw [MvPolynomial.eval₂_add]
        have e : x + y - (MvPolynomial.eval₂ φ ![u, v] H1 + MvPolynomial.eval₂ φ ![u, v] H2) =
            (x - MvPolynomial.eval₂ φ ![u, v] H1) + (y - MvPolynomial.eval₂ φ ![u, v] H2) := by ring
        rw [e]; exact Ideal.add_mem _ hx hy

  have hdim : ∀ j : ℕ, Module.finrank K (MvPolynomial.homogeneousSubmodule (Fin 2) K j) = j + 1 := by
    intro j
    let S : Set (Fin 2 →₀ ℕ) := {d | Finsupp.degree d = j}
    let A : Finset (ℕ × ℕ) := Finset.HasAntidiagonal.antidiagonal j
    let e : S ≃ A :=
      { toFun := fun d => ⟨(d.1 0, d.1 1), by
          show (d.1 0, d.1 1) ∈ Finset.HasAntidiagonal.antidiagonal j
          rw [Finset.HasAntidiagonal.mem_antidiagonal]
          have h := d.2
          simp only [S, Set.mem_setOf_eq, Finsupp.degree_eq_sum, Fin.sum_univ_two] at h
          exact h⟩
        invFun := fun p => ⟨Finsupp.equivFunOnFinite.symm ![p.1.1, p.1.2], by
          have h : p.1.1 + p.1.2 = j := Finset.HasAntidiagonal.mem_antidiagonal.mp p.2
          simp only [S, Set.mem_setOf_eq, Finsupp.degree_eq_sum, Fin.sum_univ_two]
          simpa using h⟩
        left_inv := fun d => by
          apply Subtype.ext
          ext i
          fin_cases i <;> simp
        right_inv := fun p => by
          apply Subtype.ext
          simp }
    haveI : Fintype S := Fintype.ofEquiv _ e.symm
    rw [MvPolynomial.homogeneousSubmodule_eq_finsupp_supported]
    unfold AddMonoidAlgebra.supported
    rw [Submodule.comap_equiv_eq_map_symm, LinearEquiv.finrank_map_eq]
    rw [LinearEquiv.finrank_eq (Finsupp.supportedEquivFinsupp (M := K) (R := K) S)]
    rw [Module.finrank_finsupp_self, Fintype.card_congr e]
    simp [A]

  have hker : ∀ (j : ℕ) (H : MvPolynomial (Fin 2) K), H.IsHomogeneous j →
      MvPolynomial.eval₂ φ ![u, v] H ∈ IsLocalRing.maximalIdeal R ^ (j + 1) →
      ∃ G : MvPolynomial (Fin 2) K, G.IsHomogeneous (j - 2) ∧
        H = (MvPolynomial.C a * MvPolynomial.X 0 ^ 2 + MvPolynomial.C b * (MvPolynomial.X 0 * MvPolynomial.X 1) + MvPolynomial.C c * MvPolynomial.X 1 ^ 2) * G := by
    intro j H hH hHev
    letI : Algebra K R := φ.toAlgebra
    have hA : ∀ n, 1 ≤ n → Module.finrank K (R ⧸ IsLocalRing.maximalIdeal R ^ n) = 2 * n - 1 := hHilb
    set Q0 : MvPolynomial (Fin 2) K := MvPolynomial.C a * MvPolynomial.X 0 ^ 2 + MvPolynomial.C b * (MvPolynomial.X 0 * MvPolynomial.X 1) + MvPolynomial.C c * MvPolynomial.X 1 ^ 2 with hQ0def
    have hQh : Q0.IsHomogeneous 2 := by
      have h1 : (MvPolynomial.C a * MvPolynomial.X 0 ^ 2 : MvPolynomial (Fin 2) K).IsHomogeneous 2 := by
        simpa using (MvPolynomial.isHomogeneous_C (Fin 2) a).mul ((MvPolynomial.isHomogeneous_X K (0 : Fin 2)).pow 2)
      have h2 : (MvPolynomial.C b * (MvPolynomial.X 0 * MvPolynomial.X 1) : MvPolynomial (Fin 2) K).IsHomogeneous 2 := by
        simpa using (MvPolynomial.isHomogeneous_C (Fin 2) b).mul ((MvPolynomial.isHomogeneous_X K (0 : Fin 2)).mul (MvPolynomial.isHomogeneous_X K (1 : Fin 2)))
      have h3 : (MvPolynomial.C c * MvPolynomial.X 1 ^ 2 : MvPolynomial (Fin 2) K).IsHomogeneous 2 := by
        simpa using (MvPolynomial.isHomogeneous_C (Fin 2) c).mul ((MvPolynomial.isHomogeneous_X K (1 : Fin 2)).pow 2)
      exact (h1.add h2).add h3
    have hevQ : MvPolynomial.eval₂ φ ![u, v] Q0 = φ a * u ^ 2 + φ b * (u * v) + φ c * v ^ 2 := by
      simp [hQ0def, MvPolynomial.eval₂_add, MvPolynomial.eval₂_mul, MvPolynomial.eval₂_pow,
        MvPolynomial.eval₂_C, MvPolynomial.eval₂_X]
    have hQne : Q0 ≠ 0 := by
      intro h0
      have ea := congrArg (MvPolynomial.eval ![(1 : K), 0]) h0
      have ec := congrArg (MvPolynomial.eval ![(0 : K), 1]) h0
      have eb := congrArg (MvPolynomial.eval ![(1 : K), 1]) h0
      simp [hQ0def] at ea ec eb
      rw [ea, ec] at eb
      simp at eb
      rcases hne with h | h | h
      · exact h ea
      · exact h eb
      · exact h ec
    have hevA : ∀ p : MvPolynomial (Fin 2) K, MvPolynomial.aeval ![u, v] p = MvPolynomial.eval₂ φ ![u, v] p := by
      intro p; rw [MvPolynomial.aeval_def, RingHom.algebraMap_toAlgebra]
    let ψ : MvPolynomial.homogeneousSubmodule (Fin 2) K j →ₗ[K] R ⧸ IsLocalRing.maximalIdeal R ^ (j + 1) :=
      (Ideal.Quotient.mkₐ K (IsLocalRing.maximalIdeal R ^ (j + 1))).toLinearMap ∘ₗ
        (MvPolynomial.aeval ![u, v]).toLinearMap ∘ₗ (MvPolynomial.homogeneousSubmodule (Fin 2) K j).subtype
    have hψ : ∀ x, ψ x = Ideal.Quotient.mk _ (MvPolynomial.eval₂ φ ![u, v] x.1) := by
      intro x
      show Ideal.Quotient.mkₐ K _ (MvPolynomial.aeval ![u, v] x.1) = _
      rw [Ideal.Quotient.mkₐ_eq_mk, hevA]
    let π : (R ⧸ IsLocalRing.maximalIdeal R ^ (j + 1)) →ₗ[K] R ⧸ IsLocalRing.maximalIdeal R ^ j :=
      (Ideal.Quotient.factorₐ K (Ideal.pow_le_pow_right (Nat.le_succ j))).toLinearMap
    have hπ : ∀ r, π (Ideal.Quotient.mk _ r) = Ideal.Quotient.mk _ r := by
      intro r
      show Ideal.Quotient.factorₐ K (Ideal.pow_le_pow_right (Nat.le_succ j) :
        IsLocalRing.maximalIdeal R ^ (j + 1) ≤ IsLocalRing.maximalIdeal R ^ j) (Ideal.Quotient.mk _ r) = _
      rw [Ideal.Quotient.factorₐ_apply, Ideal.Quotient.factor_mk]
    have hπsurj : Function.Surjective π := by
      intro x
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
      exact ⟨_, hπ r⟩
    have hrange : LinearMap.range ψ = LinearMap.ker π := by
      ext x
      constructor
      · rintro ⟨H', rfl⟩
        rw [LinearMap.mem_ker, hψ, hπ, Ideal.Quotient.eq_zero_iff_mem]
        exact hEH j H'.1 ((MvPolynomial.mem_homogeneousSubmodule _ _).mp H'.2)
      · intro hx
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
        rw [LinearMap.mem_ker, hπ, Ideal.Quotient.eq_zero_iff_mem] at hx
        obtain ⟨H', hH', hr⟩ := hspan j r hx
        exact ⟨⟨H', (MvPolynomial.mem_homogeneousSubmodule _ _).mpr hH'⟩,
          by rw [hψ]; exact (Ideal.Quotient.eq.mpr hr).symm⟩
    haveI : FiniteDimensional K (R ⧸ IsLocalRing.maximalIdeal R ^ (j + 1)) :=
      Module.finite_of_finrank_pos (by rw [hA (j + 1) (by omega)]; omega)
    haveI : FiniteDimensional K (MvPolynomial.homogeneousSubmodule (Fin 2) K j) :=
      Module.finite_of_finrank_pos (by rw [hdim j]; omega)
    have hπrk := LinearMap.finrank_range_add_finrank_ker π
    rw [LinearMap.range_eq_top.mpr hπsurj, finrank_top, hA (j + 1) (by omega)] at hπrk
    have hψrk := LinearMap.finrank_range_add_finrank_ker ψ
    rw [hrange, hdim j] at hψrk
    have hHker : (⟨H, (MvPolynomial.mem_homogeneousSubmodule _ _).mpr hH⟩ :
        MvPolynomial.homogeneousSubmodule (Fin 2) K j) ∈ LinearMap.ker ψ := by
      rw [LinearMap.mem_ker, hψ, Ideal.Quotient.eq_zero_iff_mem]
      exact hHev
    by_cases hj : j < 2
    · have hk0 : Module.finrank K (LinearMap.ker ψ) = 0 := by
        rcases Nat.lt_succ_iff_lt_or_eq.mp hj with h | h
        · have hj0 : j = 0 := by omega
          subst hj0
          have hA0 : Module.finrank K (R ⧸ IsLocalRing.maximalIdeal R ^ 0) = 0 := by
            haveI : Subsingleton (R ⧸ IsLocalRing.maximalIdeal R ^ 0) :=
              Ideal.Quotient.subsingleton_iff.mpr (by rw [pow_zero, Ideal.one_eq_top])
            exact Module.finrank_zero_of_subsingleton
          rw [hA0] at hπrk
          omega
        · subst h
          rw [hA 1 le_rfl] at hπrk
          omega
      rw [Submodule.finrank_eq_zero] at hk0
      rw [hk0, Submodule.mem_bot] at hHker
      have hH0 : H = 0 := congrArg Subtype.val hHker
      exact ⟨0, MvPolynomial.isHomogeneous_zero _ _ _, by rw [hH0, mul_zero]⟩
    · push_neg at hj
      have hk : Module.finrank K (LinearMap.ker ψ) = j - 1 := by
        rw [hA j (by omega)] at hπrk
        omega
      let μ : MvPolynomial.homogeneousSubmodule (Fin 2) K (j - 2) →ₗ[K] MvPolynomial.homogeneousSubmodule (Fin 2) K j :=
        LinearMap.codRestrict (MvPolynomial.homogeneousSubmodule (Fin 2) K j)
          ((LinearMap.mulLeft K Q0) ∘ₗ (MvPolynomial.homogeneousSubmodule (Fin 2) K (j - 2)).subtype)
          (fun x => by
            rw [MvPolynomial.mem_homogeneousSubmodule]
            have h := hQh.mul ((MvPolynomial.mem_homogeneousSubmodule _ _).mp x.2)
            rwa [show 2 + (j - 2) = j by omega] at h)
      have hμ : ∀ x, (μ x).1 = Q0 * x.1 := fun x => rfl
      have hμinj : Function.Injective μ := by
        intro x y hxy
        apply Subtype.ext
        have h := congrArg Subtype.val hxy
        rw [hμ, hμ] at h
        exact mul_left_cancel₀ hQne h
      have hle : LinearMap.range μ ≤ LinearMap.ker ψ := by
        rintro _ ⟨x, rfl⟩
        rw [LinearMap.mem_ker, hψ, Ideal.Quotient.eq_zero_iff_mem, hμ, MvPolynomial.eval₂_mul, hevQ]
        have h := Ideal.mul_mem_mul hrel (hEH (j - 2) x.1 ((MvPolynomial.mem_homogeneousSubmodule _ _).mp x.2))
        rwa [← pow_add, show 3 + (j - 2) = j + 1 by omega] at h
      have hrk : Module.finrank K (LinearMap.range μ) = Module.finrank K (LinearMap.ker ψ) := by
        rw [LinearMap.finrank_range_of_inj hμinj, hdim, hk]
        omega
      have heq := Submodule.eq_of_le_of_finrank_eq hle hrk
      rw [← heq] at hHker
      obtain ⟨x, hx⟩ := hHker
      refine ⟨x.1, (MvPolynomial.mem_homogeneousSubmodule _ _).mp x.2, ?_⟩
      have h := congrArg Subtype.val hx
      rw [hμ] at h
      exact h.symm

  obtain ⟨Θ, hΘ⟩ : ∃ Θ : MvPowerSeries (Fin 2) K →+* AdicCompletion (IsLocalRing.maximalIdeal R) R,
      ∀ (n : ℕ) (F : MvPowerSeries (Fin 2) K) (p : MvPolynomial (Fin 2) K),
        (∀ d : Fin 2 →₀ ℕ, Finsupp.degree d < n → MvPowerSeries.coeff d F = p.coeff d) →
        AdicCompletion.evalₐ (IsLocalRing.maximalIdeal R) n (Θ F) =
          Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ n) (MvPolynomial.eval₂ φ ![u, v] p) := by
    let δ : ℕ → (Fin 2 →₀ ℕ) := fun n => Finsupp.equivFunOnFinite.symm (fun _ => n)
    have hle : ∀ (n : ℕ) (d : Fin 2 →₀ ℕ), Finsupp.degree d < n → d ≤ δ n := by
      intro n d hd i
      have hi : (δ n) i = n := by simp [δ]
      rw [hi]
      rw [Finsupp.degree_eq_sum, Fin.sum_univ_two] at hd
      fin_cases i
      · show d 0 ≤ n; omega
      · show d 1 ≤ n; omega
    have htr : ∀ (n : ℕ) (F : MvPowerSeries (Fin 2) K) (d : Fin 2 →₀ ℕ), Finsupp.degree d < n →
        (MvPowerSeries.trunc' K (δ n) F).coeff d = MvPowerSeries.coeff d F := by
      intro n F d hd
      rw [MvPowerSeries.coeff_trunc', if_pos (hle n d hd)]
    have hAG := evalAgree (IsLocalRing.maximalIdeal R) hu hv
    let Θn : (n : ℕ) → MvPowerSeries (Fin 2) K →+* R ⧸ IsLocalRing.maximalIdeal R ^ n := fun n =>
      { toFun := fun F => Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ n)
          (MvPolynomial.eval₂ φ ![u, v] (MvPowerSeries.trunc' K (δ n) F))
        map_one' := by rw [MvPowerSeries.trunc'_one, MvPolynomial.eval₂_one, map_one]
        map_mul' := fun F G => by
          rw [← map_mul, ← MvPolynomial.eval₂_mul]
          apply hAG
          intro d hd
          rw [htr n _ d hd, MvPowerSeries.coeff_mul, MvPolynomial.coeff_mul]
          apply Finset.sum_congr rfl
          intro x hx
          rw [Finset.HasAntidiagonal.mem_antidiagonal] at hx
          have h0 := congrArg (fun f => f 0) hx
          have h1 := congrArg (fun f => f 1) hx
          simp only [Finsupp.coe_add, Pi.add_apply] at h0 h1
          rw [Finsupp.degree_eq_sum, Fin.sum_univ_two] at hd
          rw [htr n F x.1 (by rw [Finsupp.degree_eq_sum, Fin.sum_univ_two]; omega),
            htr n G x.2 (by rw [Finsupp.degree_eq_sum, Fin.sum_univ_two]; omega)]
        map_zero' := by rw [map_zero, MvPolynomial.eval₂_zero, map_zero]
        map_add' := fun F G => by rw [map_add, MvPolynomial.eval₂_add, map_add] }
    have hcompat : ∀ {m n : ℕ} (hmn : m ≤ n),
        (Ideal.Quotient.factorPow (IsLocalRing.maximalIdeal R) hmn).comp (Θn n) = Θn m := by
      intro m n hmn
      ext F
      show Ideal.Quotient.factorPow (IsLocalRing.maximalIdeal R) hmn
          (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ n) _) =
        Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ m) _
      rw [Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk]
      apply hAG
      intro d hd
      rw [htr m F d hd, htr n F d (lt_of_lt_of_le hd hmn)]
    refine ⟨AdicCompletion.liftRingHom (IsLocalRing.maximalIdeal R) Θn hcompat, ?_⟩
    intro n F p hp
    rw [AdicCompletion.evalₐ_liftRingHom]
    show Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ n) _ = _
    apply hAG
    intro d hd
    rw [htr n F d hd, hp d hd]

  have hlift : ∀ (s : ℕ → R) (k : ℕ), (∀ n : ℕ, s (n + 1) - s n ∈ IsLocalRing.maximalIdeal R ^ n) →
      (∀ n : ℕ, n ≤ k → s n ∈ IsLocalRing.maximalIdeal R ^ n) →
      ∃ F : MvPowerSeries (Fin 2) K, (∀ d : Fin 2 →₀ ℕ, Finsupp.degree d < k → MvPowerSeries.coeff d F = 0) ∧
        ∀ n : ℕ, ∃ p : MvPolynomial (Fin 2) K,
          (∀ d : Fin 2 →₀ ℕ, Finsupp.degree d < n → MvPowerSeries.coeff d F = p.coeff d) ∧
          s n - MvPolynomial.eval₂ φ ![u, v] p ∈ IsLocalRing.maximalIdeal R ^ n := by
    intro s k hs hk
    have hspan' := hspan
    choose Hc hHc using hspan'
    let ev : MvPolynomial (Fin 2) K → R := MvPolynomial.eval₂ φ ![u, v]
    let Hsel : ℕ → R → MvPolynomial (Fin 2) K := fun j y =>
      if y ∈ IsLocalRing.maximalIdeal R ^ (j + 1) then 0
      else if h : y ∈ IsLocalRing.maximalIdeal R ^ j then Hc j y h else 0
    have hsel : ∀ j y, y ∈ IsLocalRing.maximalIdeal R ^ j → (Hsel j y).IsHomogeneous j ∧
        y - ev (Hsel j y) ∈ IsLocalRing.maximalIdeal R ^ (j + 1) := by
      intro j y hy
      by_cases h1 : y ∈ IsLocalRing.maximalIdeal R ^ (j + 1)
      · simp only [Hsel, if_pos h1]
        refine ⟨MvPolynomial.isHomogeneous_zero _ _ _, ?_⟩
        simpa [ev] using h1
      · simp only [Hsel, if_neg h1, dif_pos hy]
        exact hHc j y hy
    let P : ℕ → MvPolynomial (Fin 2) K := fun n =>
      Nat.rec 0 (fun j Pj => Pj + Hsel j (s (j + 1) - ev Pj)) n
    have hPs : ∀ j, P (j + 1) = P j + Hsel j (s (j + 1) - ev (P j)) := fun j => rfl
    have hinv : ∀ j, s j - ev (P j) ∈ IsLocalRing.maximalIdeal R ^ j := by
      intro j
      induction j with
      | zero => rw [pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top
      | succ j ih =>
        have hy : s (j + 1) - ev (P j) ∈ IsLocalRing.maximalIdeal R ^ j := by
          have := Ideal.add_mem _ (hs j) ih
          rwa [sub_add_sub_cancel] at this
        have h2 := (hsel j _ hy).2
        rw [hPs, show ev (P j + Hsel j (s (j + 1) - ev (P j))) = ev (P j) + ev (Hsel j (s (j + 1) - ev (P j))) from
          MvPolynomial.eval₂_add _ _, ← sub_sub]
        exact h2
    have hhom : ∀ j, (Hsel j (s (j + 1) - ev (P j))).IsHomogeneous j := by
      intro j
      have hy : s (j + 1) - ev (P j) ∈ IsLocalRing.maximalIdeal R ^ j := by
        have := Ideal.add_mem _ (hs j) (hinv j)
        rwa [sub_add_sub_cancel] at this
      exact (hsel j _ hy).1
    have hstab : ∀ (d : Fin 2 →₀ ℕ) (m : ℕ),
        (P (Finsupp.degree d + 1 + m)).coeff d = (P (Finsupp.degree d + 1)).coeff d := by
      intro d m
      induction m with
      | zero => rfl
      | succ m ih =>
        rw [← add_assoc, hPs, MvPolynomial.coeff_add, ih,
          (hhom _).coeff_eq_zero (by omega), add_zero]
    let F : MvPowerSeries (Fin 2) K := fun d => (P (Finsupp.degree d + 1)).coeff d
    have hFc : ∀ d, MvPowerSeries.coeff d F = (P (Finsupp.degree d + 1)).coeff d := fun d =>
      MvPowerSeries.coeff_apply F d
    have hPz : ∀ j, j ≤ k → P j = 0 := by
      intro j
      induction j with
      | zero => intro _; rfl
      | succ j ih =>
        intro hj
        rw [hPs, ih (by omega)]
        have hmem : s (j + 1) - ev 0 ∈ IsLocalRing.maximalIdeal R ^ (j + 1) := by
          simpa [ev] using hk (j + 1) hj
        simp only [Hsel, if_pos hmem, add_zero]
    refine ⟨F, fun d hd => ?_, fun n => ⟨P n, fun d hd => ?_, hinv n⟩⟩
    · rw [hFc, hPz (Finsupp.degree d + 1) (by omega)]; simp
    · rw [hFc, ← hstab d (n - (Finsupp.degree d + 1)),
        show Finsupp.degree d + 1 + (n - (Finsupp.degree d + 1)) = n by omega]

  have hdivide : ∀ f : MvPowerSeries (Fin 2) K, 3 ≤ MvPowerSeries.order (f - wcpaBscQuad K a b c) →
      Θ f = 0 → ∀ F : MvPowerSeries (Fin 2) K, Θ F = 0 → F ∈ Ideal.span {f} := by
    intro f hf hΘf F hΘF
    have hker' := hker
    have hQh : (MvPolynomial.C a * MvPolynomial.X 0 ^ 2 + MvPolynomial.C b * (MvPolynomial.X 0 * MvPolynomial.X 1) + MvPolynomial.C c * MvPolynomial.X 1 ^ 2 : MvPolynomial (Fin 2) K).IsHomogeneous 2 := by
      have h1 : (MvPolynomial.C a * MvPolynomial.X 0 ^ 2 : MvPolynomial (Fin 2) K).IsHomogeneous 2 := by
        simpa using (MvPolynomial.isHomogeneous_C (Fin 2) a).mul ((MvPolynomial.isHomogeneous_X K (0 : Fin 2)).pow 2)
      have h2 : (MvPolynomial.C b * (MvPolynomial.X 0 * MvPolynomial.X 1) : MvPolynomial (Fin 2) K).IsHomogeneous 2 := by
        simpa using (MvPolynomial.isHomogeneous_C (Fin 2) b).mul ((MvPolynomial.isHomogeneous_X K (0 : Fin 2)).mul (MvPolynomial.isHomogeneous_X K (1 : Fin 2)))
      have h3 : (MvPolynomial.C c * MvPolynomial.X 1 ^ 2 : MvPolynomial (Fin 2) K).IsHomogeneous 2 := by
        simpa using (MvPolynomial.isHomogeneous_C (Fin 2) c).mul ((MvPolynomial.isHomogeneous_X K (1 : Fin 2)).pow 2)
      exact (h1.add h2).add h3
    have hQcoe : ((MvPolynomial.C a * MvPolynomial.X 0 ^ 2 + MvPolynomial.C b * (MvPolynomial.X 0 * MvPolynomial.X 1) + MvPolynomial.C c * MvPolynomial.X 1 ^ 2 : MvPolynomial (Fin 2) K) : MvPowerSeries (Fin 2) K) = wcpaBscQuad K a b c := by
      simp only [wcpaBscQuad, MvPolynomial.coe_add, MvPolynomial.coe_mul, MvPolynomial.coe_pow,
        MvPolynomial.coe_C, MvPolynomial.coe_X]
    obtain ⟨Q0, hQ0⟩ : ∃ Q0 : MvPolynomial (Fin 2) K, Q0 = MvPolynomial.C a * MvPolynomial.X 0 ^ 2 + MvPolynomial.C b * (MvPolynomial.X 0 * MvPolynomial.X 1) + MvPolynomial.C c * MvPolynomial.X 1 ^ 2 := ⟨_, rfl⟩
    rw [← hQ0] at hQh hQcoe
    simp only [← hQ0] at hker'
    have hfr : f = (Q0 : MvPowerSeries (Fin 2) K) + (f - wcpaBscQuad K a b c) := by
      rw [hQcoe]; ring
    have hordHom : ∀ (g : MvPolynomial (Fin 2) K) (e : ℕ), g.IsHomogeneous e →
        (e : ℕ∞) ≤ MvPowerSeries.order (g : MvPowerSeries (Fin 2) K) := by
      intro g e hg
      apply MvPowerSeries.nat_le_order
      intro d hd
      rw [MvPolynomial.coeff_coe]
      exact hg.coeff_eq_zero (by omega)
    have hrc : ∀ (g : MvPolynomial (Fin 2) K) (e : ℕ) (d : Fin 2 →₀ ℕ), g.IsHomogeneous e →
        Finsupp.degree d < e + 3 →
        MvPowerSeries.coeff d ((g : MvPowerSeries (Fin 2) K) * (f - wcpaBscQuad K a b c)) = 0 := by
      intro g e d hg hd
      apply MvPowerSeries.coeff_of_lt_order
      have h1 : (e : ℕ∞) + 3 ≤
          MvPowerSeries.order ((g : MvPowerSeries (Fin 2) K) * (f - wcpaBscQuad K a b c)) :=
        le_trans (add_le_add (hordHom g e hg) hf) MvPowerSeries.le_order_mul
      refine lt_of_lt_of_le ?_ h1
      have h2 : ((Finsupp.degree d : ℕ) : ℕ∞) < ((e + 3 : ℕ) : ℕ∞) := by exact_mod_cast hd
      simpa using h2
    have hfcoeff : ∀ d : Fin 2 →₀ ℕ, Finsupp.degree d < 2 → MvPowerSeries.coeff d f = 0 := by
      intro d hd
      have h := hrc 1 0 d (MvPolynomial.isHomogeneous_one _ _) (by omega)
      rw [MvPolynomial.coe_one, one_mul] at h
      rw [hfr, map_add, MvPolynomial.coeff_coe, hQh.coeff_eq_zero (by omega), zero_add, h]
    obtain ⟨δ, hδ⟩ : ∃ δ : ℕ → (Fin 2 →₀ ℕ), ∀ n i, δ n i = n :=
      ⟨fun n => Finsupp.equivFunOnFinite.symm (fun _ => n), fun n i => by simp⟩
    have hle : ∀ (n : ℕ) (d : Fin 2 →₀ ℕ), Finsupp.degree d < n → d ≤ δ n := by
      intro n d hd i
      rw [hδ]
      rw [Finsupp.degree_eq_sum, Fin.sum_univ_two] at hd
      fin_cases i
      · show d 0 ≤ n; omega
      · show d 1 ≤ n; omega
    have htr : ∀ (n : ℕ) (F : MvPowerSeries (Fin 2) K) (d : Fin 2 →₀ ℕ), Finsupp.degree d < n →
        (MvPowerSeries.trunc' K (δ n) F).coeff d = MvPowerSeries.coeff d F := by
      intro n F d hd
      rw [MvPowerSeries.coeff_trunc', if_pos (hle n d hd)]
    obtain ⟨low, hlowh, hlowc⟩ : ∃ low : ℕ → MvPowerSeries (Fin 2) K → MvPolynomial (Fin 2) K,
        (∀ j E, (low j E).IsHomogeneous j) ∧
        (∀ j E d, Finsupp.degree d = j → (low j E).coeff d = MvPowerSeries.coeff d E) := by
      refine ⟨fun j E => MvPolynomial.homogeneousComponent j (MvPowerSeries.trunc' K (δ (j + 1)) E),
        fun j E => MvPolynomial.homogeneousComponent_isHomogeneous j _, fun j E d hd => ?_⟩
      rw [MvPolynomial.coeff_homogeneousComponent, if_pos hd, htr (j + 1) E d (by omega)]
    obtain ⟨gsel, hgsel⟩ : ∃ gsel : ℕ → MvPowerSeries (Fin 2) K → MvPolynomial (Fin 2) K,
        ∀ j E, (gsel j E).IsHomogeneous (j - 2) ∧
          (2 ≤ j → MvPolynomial.eval₂ φ ![u, v] (low j E) ∈ IsLocalRing.maximalIdeal R ^ (j + 1) →
            low j E = Q0 * gsel j E) ∧
          (j < 2 → gsel j E = 0) := by
      refine ⟨fun j E => if h : 2 ≤ j ∧ MvPolynomial.eval₂ φ ![u, v] (low j E) ∈ IsLocalRing.maximalIdeal R ^ (j + 1) then
        Classical.choose (hker' j _ (hlowh j E) h.2) else 0, fun j E => ?_⟩
      by_cases h : 2 ≤ j ∧ MvPolynomial.eval₂ φ ![u, v] (low j E) ∈ IsLocalRing.maximalIdeal R ^ (j + 1)
      · simp only [dif_pos h]
        have hs := Classical.choose_spec (hker' j _ (hlowh j E) h.2)
        exact ⟨hs.1, fun _ _ => hs.2, fun h' => absurd h.1 (by omega)⟩
      · simp only [dif_neg h]
        exact ⟨MvPolynomial.isHomogeneous_zero _ _ _, fun h1 h2 => absurd ⟨h1, h2⟩ h,
          fun _ => by first | rfl | trivial⟩
    obtain ⟨Acc, hA0, hAs⟩ : ∃ Acc : ℕ → MvPolynomial (Fin 2) K, Acc 0 = 0 ∧
        ∀ j, Acc (j + 1) = Acc j + gsel j (F - (Acc j : MvPowerSeries (Fin 2) K) * f) :=
      ⟨fun n => Nat.rec 0 (fun j A => A + gsel j (F - (A : MvPowerSeries (Fin 2) K) * f)) n,
        rfl, fun j => rfl⟩
    have hΘE : ∀ j, Θ (F - (Acc j : MvPowerSeries (Fin 2) K) * f) = 0 := by
      intro j; rw [map_sub, map_mul, hΘF, hΘf, mul_zero, sub_zero]
    have hORD : ∀ j d, Finsupp.degree d < j →
        MvPowerSeries.coeff d (F - (Acc j : MvPowerSeries (Fin 2) K) * f) = 0 := by
      intro j
      induction j with
      | zero => intro d hd; omega
      | succ j ih =>
        have hagree : ∀ d, Finsupp.degree d < j + 1 →
            MvPowerSeries.coeff d (F - (Acc j : MvPowerSeries (Fin 2) K) * f) =
              (low j (F - (Acc j : MvPowerSeries (Fin 2) K) * f)).coeff d := by
          intro d hd
          rcases Nat.lt_succ_iff_lt_or_eq.mp hd with h | h
          · rw [ih d h, (hlowh j _).coeff_eq_zero (by omega)]
          · rw [hlowc j _ d h]
        have hev : MvPolynomial.eval₂ φ ![u, v] (low j (F - (Acc j : MvPowerSeries (Fin 2) K) * f)) ∈
            IsLocalRing.maximalIdeal R ^ (j + 1) := by
          have h1 := hΘ (j + 1) _ _ hagree
          rw [hΘE j, map_zero] at h1
          exact Ideal.Quotient.eq_zero_iff_mem.mp h1.symm
        obtain ⟨hgh, hgeq, hg0⟩ := hgsel j (F - (Acc j : MvPowerSeries (Fin 2) K) * f)
        intro d hd
        rw [hAs, MvPolynomial.coe_add, add_mul, ← sub_sub, map_sub, hagree d hd]
        by_cases hj : 2 ≤ j
        · have hlq := hgeq hj hev
          generalize gsel j (F - (Acc j : MvPowerSeries (Fin 2) K) * f) = g at hlq hgh ⊢
          have hsplit : (g : MvPowerSeries (Fin 2) K) * f =
              ((Q0 * g : MvPolynomial (Fin 2) K) : MvPowerSeries (Fin 2) K) +
                (g : MvPowerSeries (Fin 2) K) * (f - wcpaBscQuad K a b c) := by
            rw [MvPolynomial.coe_mul, hQcoe]; ring
          rw [hsplit, map_add, MvPolynomial.coeff_coe, ← hlq, hrc _ (j - 2) d hgh (by omega),
            add_zero, sub_self]
        · push_neg at hj
          rw [hg0 hj, MvPolynomial.coe_zero, zero_mul, map_zero, sub_zero]
          obtain ⟨G0, hG0h, hG0⟩ := hker' j _ (hlowh j _) hev
          rw [hG0]
          exact (hQh.mul hG0h).coeff_eq_zero (by omega)
    have hstab : ∀ (d : Fin 2 →₀ ℕ) (m : ℕ),
        (Acc (Finsupp.degree d + 3 + m)).coeff d = (Acc (Finsupp.degree d + 3)).coeff d := by
      intro d m
      induction m with
      | zero => rw [add_zero]
      | succ m ih =>
        rw [← add_assoc, hAs, MvPolynomial.coeff_add, ih,
          (hgsel _ _).1.coeff_eq_zero (by omega), add_zero]
    obtain ⟨G, hGcoef⟩ : ∃ G : MvPowerSeries (Fin 2) K,
        ∀ d, MvPowerSeries.coeff d G = (Acc (Finsupp.degree d + 3)).coeff d :=
      ⟨fun d => (Acc (Finsupp.degree d + 3)).coeff d, fun d => MvPowerSeries.coeff_apply _ d⟩
    rw [Ideal.mem_span_singleton']
    refine ⟨G, ?_⟩
    ext d
    have h1 := hORD (Finsupp.degree d + 1) d (by omega)
    rw [map_sub, sub_eq_zero] at h1
    rw [h1, MvPowerSeries.coeff_mul, MvPowerSeries.coeff_mul]
    apply Finset.sum_congr rfl
    intro x hx
    rw [Finset.HasAntidiagonal.mem_antidiagonal] at hx
    have h0 := congrArg (fun g => g 0) hx
    have h1' := congrArg (fun g => g 1) hx
    simp only [Finsupp.coe_add, Pi.add_apply] at h0 h1'
    have hdeg : Finsupp.degree x.1 + Finsupp.degree x.2 = Finsupp.degree d := by
      simp only [Finsupp.degree_eq_sum, Fin.sum_univ_two]; omega
    by_cases h2 : Finsupp.degree x.2 < 2
    · rw [hfcoeff x.2 h2, mul_zero, mul_zero]
    · have he : Finsupp.degree x.1 + 3 + (Finsupp.degree d + 1 - (Finsupp.degree x.1 + 3)) =
          Finsupp.degree d + 1 := by omega
      rw [MvPolynomial.coeff_coe, hGcoef, ← hstab x.1 (Finsupp.degree d + 1 - (Finsupp.degree x.1 + 3)), he]

  have hQcoe : ((MvPolynomial.C a * MvPolynomial.X 0 ^ 2 + MvPolynomial.C b * (MvPolynomial.X 0 * MvPolynomial.X 1) + MvPolynomial.C c * MvPolynomial.X 1 ^ 2 : MvPolynomial (Fin 2) K) : MvPowerSeries (Fin 2) K) = wcpaBscQuad K a b c := by
    simp only [wcpaBscQuad, MvPolynomial.coe_add, MvPolynomial.coe_mul, MvPolynomial.coe_pow,
      MvPolynomial.coe_C, MvPolynomial.coe_X]
  have hevQ : MvPolynomial.eval₂ φ ![u, v] (MvPolynomial.C a * MvPolynomial.X 0 ^ 2 + MvPolynomial.C b * (MvPolynomial.X 0 * MvPolynomial.X 1) + MvPolynomial.C c * MvPolynomial.X 1 ^ 2 : MvPolynomial (Fin 2) K) = φ a * u ^ 2 + φ b * (u * v) + φ c * v ^ 2 := by
    simp [MvPolynomial.eval₂_add, MvPolynomial.eval₂_mul, MvPolynomial.eval₂_pow,
      MvPolynomial.eval₂_C, MvPolynomial.eval₂_X]
  obtain ⟨F₃, hF₃0, hF₃⟩ := hlift (fun _ => φ a * u ^ 2 + φ b * (u * v) + φ c * v ^ 2) 3
    (fun n => by simp) (fun n hn => Ideal.pow_le_pow_right hn hrel)
  have horder : 3 ≤ MvPowerSeries.order ((wcpaBscQuad K a b c - F₃) - wcpaBscQuad K a b c) := by
    rw [sub_sub_cancel_left, MvPowerSeries.order_neg]
    exact_mod_cast MvPowerSeries.nat_le_order hF₃0
  refine ⟨wcpaBscQuad K a b c - F₃, horder, ?_⟩
  have hΘQ : ∀ n, AdicCompletion.evalₐ (IsLocalRing.maximalIdeal R) n (Θ (wcpaBscQuad K a b c)) =
      Ideal.Quotient.mk _ (φ a * u ^ 2 + φ b * (u * v) + φ c * v ^ 2) := by
    intro n
    rw [hΘ n _ _ (fun d _ => by rw [← hQcoe, MvPolynomial.coeff_coe]), hevQ]
  have hΘf : Θ (wcpaBscQuad K a b c - F₃) = 0 := by
    apply AdicCompletion.ext_evalₐ
    intro n
    obtain ⟨p, hp, hsp⟩ := hF₃ n
    rw [map_sub, map_sub, hΘQ n, hΘ n F₃ p hp, map_zero, sub_eq_zero]
    exact Ideal.Quotient.eq.mpr hsp
  have hsurj : Function.Surjective Θ := by
    intro x
    obtain ⟨s, rfl⟩ := AdicCompletion.mk_surjective (IsLocalRing.maximalIdeal R) R x
    have hcauchy : ∀ n, (s : ℕ → R) (n + 1) - (s : ℕ → R) n ∈ IsLocalRing.maximalIdeal R ^ n := by
      intro n
      have h := AdicCompletion.AdicCauchySequence.mk_eq_mk (Nat.le_succ n) s
      rw [Submodule.Quotient.eq] at h
      simpa [Ideal.smul_eq_mul, Ideal.mul_top] using h
    obtain ⟨F, -, hF⟩ := hlift (s : ℕ → R) 0 hcauchy (fun n hn => by
      rw [Nat.le_zero.mp hn, pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top)
    refine ⟨F, AdicCompletion.ext_evalₐ (fun n => ?_)⟩
    obtain ⟨p, hp, hsp⟩ := hF n
    rw [hΘ n F p hp, AdicCompletion.evalₐ_mk]
    exact (Ideal.Quotient.eq.mpr hsp).symm
  have hkereq : RingHom.ker Θ = Ideal.span {wcpaBscQuad K a b c - F₃} := by
    apply le_antisymm
    · intro F hF
      exact hdivide _ horder hΘf F (RingHom.mem_ker.mp hF)
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      exact RingHom.mem_ker.mpr hΘf
  have hΘC : ∀ c' : K, Θ (MvPowerSeries.C c') =
      algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R) (φ c') := by
    intro c'
    apply AdicCompletion.ext_evalₐ
    intro n
    rw [hΘ n _ (MvPolynomial.C c') (fun d _ => by rw [← MvPolynomial.coe_C, MvPolynomial.coeff_coe]),
      MvPolynomial.eval₂_C, AdicCompletion.algebraMap_apply, AdicCompletion.evalₐ_of]
    rfl
  refine ⟨(RingHom.quotientKerEquivOfSurjective hsurj).symm.trans (Ideal.quotEquivOfEq hkereq), ?_⟩
  refine RingHom.ext (fun c' => ?_)
  have h1 : (RingHom.quotientKerEquivOfSurjective hsurj).symm (Θ (MvPowerSeries.C c')) =
      Ideal.Quotient.mk _ (MvPowerSeries.C c') :=
    (RingEquiv.symm_apply_eq _).mpr (RingHom.quotientKerEquivOfSurjective_apply_mk hsurj _).symm
  simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom,
    RingEquiv.trans_apply]
  rw [← hΘC c', h1, Ideal.quotEquivOfEq_mk]

theorem wcpa_dj_ssp_bw_hensel_node : ∀ (K : Type u) [Field K] (f : MvPowerSeries (Fin 2) K), 3 ≤ MvPowerSeries.order (f - MvPowerSeries.X 0 * MvPowerSeries.X 1) → ∃ e : (MvPowerSeries (Fin 2) K ⧸ Ideal.span {f}) ≃+* (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), e.toRingHom.comp ((Ideal.Quotient.mk _).comp MvPowerSeries.C) = (Ideal.Quotient.mk _).comp MvPowerSeries.C :=
by
  intro K _ f hf
  classical



  have hfix : ∀ (ι : Type) (T : (ι → MvPowerSeries (Fin 2) K) → (ι → MvPowerSeries (Fin 2) K))
      (k : ℕ),
      (∀ p : ι → MvPowerSeries (Fin 2) K, (∀ i, (k : ℕ∞) ≤ (p i).order) →
        ∀ i, (k : ℕ∞) ≤ (T p i).order) →
      (∀ (n : ℕ) (p q : ι → MvPowerSeries (Fin 2) K), (∀ i, (k : ℕ∞) ≤ (p i).order) →
        (∀ i, (k : ℕ∞) ≤ (q i).order) → (∀ i, (n : ℕ∞) ≤ (p i - q i).order) →
        ∀ i, ((n + 1 : ℕ) : ℕ∞) ≤ (T p i - T q i).order) →
      ∃ p : ι → MvPowerSeries (Fin 2) K, (∀ i, (k : ℕ∞) ≤ (p i).order) ∧ T p = p := by
    intro ι T k hinv hcon
    let sq : ℕ → ι → MvPowerSeries (Fin 2) K :=
      fun j => Nat.rec (0 : ι → MvPowerSeries (Fin 2) K) (fun _ q => T q) j
    have hsq : ∀ j, sq (j + 1) = T (sq j) := fun j => rfl
    have ha : ∀ j i, (k : ℕ∞) ≤ (sq j i).order := by
      intro j
      induction j with
      | zero =>
        intro i
        show (k : ℕ∞) ≤ ((0 : ι → MvPowerSeries (Fin 2) K) i).order
        simp
      | succ j ih =>
        intro i
        rw [hsq]
        exact hinv _ ih i
    have hb : ∀ (j : ℕ) i, (j : ℕ∞) ≤ (sq (j + 1) i - sq j i).order := by
      intro j
      induction j with
      | zero => intro i; simp
      | succ j ih =>
        intro i
        have := hcon j (sq (j + 1)) (sq j) (ha (j + 1)) (ha j) ih i
        exact this
    have hc : ∀ (m j : ℕ) i, (j : ℕ∞) ≤ (sq (j + m) i - sq j i).order := by
      intro m
      induction m with
      | zero => intro j i; simp
      | succ m ih =>
        intro j i
        have e : sq (j + (m + 1)) i - sq j i
            = (sq (j + m + 1) i - sq (j + m) i) + (sq (j + m) i - sq j i) := by
          rw [← add_assoc]; abel
        rw [e]
        refine le_trans (le_min ?_ ?_) MvPowerSeries.min_order_le_add
        · exact le_trans (show (j : ℕ∞) ≤ ((j + m : ℕ) : ℕ∞) by exact_mod_cast Nat.le_add_right j m)
            (hb (j + m) i)
        · exact ih j i
    have hd : ∀ (d : Fin 2 →₀ ℕ) (a b : ℕ) (i : ι), Finsupp.degree d < a → a ≤ b →
        MvPowerSeries.coeff d (sq b i) = MvPowerSeries.coeff d (sq a i) := by
      intro d a b i hda hab
      obtain ⟨c, rfl⟩ := Nat.exists_eq_add_of_le hab
      have h2 : MvPowerSeries.coeff d (sq (a + c) i - sq a i) = 0 :=
        MvPowerSeries.coeff_of_lt_order
          (lt_of_lt_of_le (show ((Finsupp.degree d : ℕ) : ℕ∞) < (a : ℕ∞) by exact_mod_cast hda)
            (hc c a i))
      rw [map_sub, sub_eq_zero] at h2
      exact h2
    let p : ι → MvPowerSeries (Fin 2) K := fun i =>
      fun d => MvPowerSeries.coeff d (sq (Finsupp.degree d + 1) i)
    have hpc : ∀ i d, MvPowerSeries.coeff d (p i)
        = MvPowerSeries.coeff d (sq (Finsupp.degree d + 1) i) := fun _ _ => rfl
    have he : ∀ (j : ℕ) i, (j : ℕ∞) ≤ (p i - sq j i).order := by
      intro j i
      apply MvPowerSeries.le_order
      intro d hdj
      have hdj' : Finsupp.degree d < j := by exact_mod_cast hdj
      rw [map_sub, hpc, sub_eq_zero]
      rcases le_total (Finsupp.degree d + 1) j with h | h
      · exact (hd d _ j i (Nat.lt_succ_self _) h).symm
      · exact hd d j _ i hdj' h
    have hpk : ∀ i, (k : ℕ∞) ≤ (p i).order := by
      intro i
      apply MvPowerSeries.le_order
      intro d hdk
      rw [hpc]
      exact MvPowerSeries.coeff_of_lt_order (lt_of_lt_of_le hdk (ha (Finsupp.degree d + 1) i))
    refine ⟨p, hpk, ?_⟩
    funext i
    have hall : ∀ j : ℕ, (j : ℕ∞) ≤ (T p i - p i).order := by
      intro j
      have e : T p i - p i = (T p i - T (sq j) i) + -(p i - sq (j + 1) i) := by
        rw [hsq]; abel
      rw [e]
      refine le_trans (le_min ?_ ?_) MvPowerSeries.min_order_le_add
      · exact le_trans (show (j : ℕ∞) ≤ ((j + 1 : ℕ) : ℕ∞) by exact_mod_cast Nat.le_succ j)
          (hcon j p (sq j) hpk (ha j) (fun i' => he j i') i)
      · rw [MvPowerSeries.order_neg]
        exact le_trans (show (j : ℕ∞) ≤ ((j + 1 : ℕ) : ℕ∞) by exact_mod_cast Nat.le_succ j)
          (he (j + 1) i)
    have htop : (T p i - p i).order = ⊤ := by
      by_contra hne
      obtain ⟨m, hm⟩ := ENat.ne_top_iff_exists.mp hne
      have h1 := hall (m + 1)
      rw [← hm] at h1
      have h2 : m + 1 ≤ m := by exact_mod_cast h1
      omega
    exact sub_eq_zero.mp (MvPowerSeries.order_eq_top_iff.mp htop)



  let Dx : MvPowerSeries (Fin 2) K → MvPowerSeries (Fin 2) K :=
    fun R => fun d => MvPowerSeries.coeff (d + Finsupp.single 0 1) R
  let Dy : MvPowerSeries (Fin 2) K → MvPowerSeries (Fin 2) K :=
    fun R => fun d => if d 0 = 0 then MvPowerSeries.coeff (d + Finsupp.single 1 1) R else 0
  have hDx : ∀ R d, MvPowerSeries.coeff d (Dx R)
      = MvPowerSeries.coeff (d + Finsupp.single 0 1) R := fun _ _ => rfl
  have hDy : ∀ R d, MvPowerSeries.coeff d (Dy R)
      = if d 0 = 0 then MvPowerSeries.coeff (d + Finsupp.single 1 1) R else 0 :=
    fun _ _ => rfl
  have hDx_sub : ∀ a b, Dx (a - b) = Dx a - Dx b := by
    intro a b; ext d; simp only [map_sub, hDx]
  have hDy_sub : ∀ a b, Dy (a - b) = Dy a - Dy b := by
    intro a b; ext d
    by_cases h : d 0 = 0 <;> simp [hDy, h]
  have hdeg_add : ∀ (d : Fin 2 →₀ ℕ) (s : Fin 2),
      Finsupp.degree (d + Finsupp.single s 1) = Finsupp.degree d + 1 := by
    intro d s; rw [map_add, Finsupp.degree_single]
  have hDord : ∀ (n : ℕ) (R : MvPowerSeries (Fin 2) K), ((n + 1 : ℕ) : ℕ∞) ≤ R.order →
      (n : ℕ∞) ≤ (Dx R).order ∧ (n : ℕ∞) ≤ (Dy R).order := by
    intro n R hR
    constructor
    · apply MvPowerSeries.le_order
      intro d hd
      rw [hDx]
      apply MvPowerSeries.coeff_of_lt_order
      refine lt_of_lt_of_le ?_ hR
      rw [hdeg_add]
      have h1 : Finsupp.degree d < n := by exact_mod_cast hd
      have h2 : Finsupp.degree d + 1 < n + 1 := by omega
      exact_mod_cast h2
    · apply MvPowerSeries.le_order
      intro d hd
      rw [hDy]
      split_ifs
      · apply MvPowerSeries.coeff_of_lt_order
        refine lt_of_lt_of_le ?_ hR
        rw [hdeg_add]
        have h1 : Finsupp.degree d < n := by exact_mod_cast hd
        have h2 : Finsupp.degree d + 1 < n + 1 := by omega
        exact_mod_cast h2
      · rfl
  have hdec : ∀ R : MvPowerSeries (Fin 2) K, R = MvPowerSeries.C (MvPowerSeries.constantCoeff R)
      + MvPowerSeries.X 0 * Dx R + MvPowerSeries.X 1 * Dy R := by
    intro R
    ext d
    rw [map_add, map_add, MvPowerSeries.coeff_C, MvPowerSeries.X_def, MvPowerSeries.X_def,
      MvPowerSeries.coeff_monomial_mul, MvPowerSeries.coeff_monomial_mul, hDx, hDy]
    have hsub1 : (d - Finsupp.single (1 : Fin 2) 1 : Fin 2 →₀ ℕ) 0 = d 0 := by
      rw [Finsupp.tsub_apply]; simp
    rw [hsub1]
    simp only [Finsupp.single_le_iff, one_mul]
    rcases Nat.eq_zero_or_pos (d 0) with h0 | h0 <;>
      rcases Nat.eq_zero_or_pos (d 1) with h1 | h1
    · have hd0 : d = 0 :=
        Finsupp.ext (Fin.forall_fin_two.mpr ⟨by simp [h0], by simp [h1]⟩)
      subst hd0
      simp [MvPowerSeries.coeff_zero_eq_constantCoeff_apply]
    · have hne : d ≠ 0 := by intro h; rw [h] at h1; simp at h1
      have h1' : 1 ≤ d 1 := h1
      have h1n : d 1 ≠ 0 := by omega
      have hle : Finsupp.single 1 1 ≤ d := Finsupp.single_le_iff.mpr h1'
      simp [hne, h0, h1', h1n, h1, tsub_add_cancel_of_le hle]
    · have hne : d ≠ 0 := by intro h; rw [h] at h0; simp at h0
      have h0' : 1 ≤ d 0 := h0
      have h0n : d 0 ≠ 0 := by omega
      have hle : Finsupp.single 0 1 ≤ d := Finsupp.single_le_iff.mpr h0'
      simp [hne, h0', h0n, h0, h1, tsub_add_cancel_of_le hle]
    · have hne : d ≠ 0 := by intro h; rw [h] at h0; simp at h0
      have h0' : 1 ≤ d 0 := h0
      have h0n : d 0 ≠ 0 := by omega
      have h1' : 1 ≤ d 1 := h1
      have h1n : d 1 ≠ 0 := by omega
      have hle : Finsupp.single 0 1 ≤ d := Finsupp.single_le_iff.mpr h0'
      simp [hne, h0', h0n, h0, h1', h1n, h1, tsub_add_cancel_of_le hle]



  have hf3 : ((2 + 1 : ℕ) : ℕ∞) ≤ (f - MvPowerSeries.X 0 * MvPowerSeries.X 1).order := by
    exact_mod_cast hf
  have hR3 : ∀ p : Fin 2 → MvPowerSeries (Fin 2) K, (∀ i, ((2 : ℕ) : ℕ∞) ≤ (p i).order) →
      ((2 + 1 : ℕ) : ℕ∞) ≤ (f - MvPowerSeries.X 0 * MvPowerSeries.X 1 - p 0 * p 1).order := by
    intro p hp
    have e : f - MvPowerSeries.X 0 * MvPowerSeries.X 1 - p 0 * p 1
        = (f - MvPowerSeries.X 0 * MvPowerSeries.X 1) + -(p 0 * p 1) := sub_eq_add_neg _ _
    rw [e]
    refine le_trans (le_min hf3 ?_) MvPowerSeries.min_order_le_add
    rw [MvPowerSeries.order_neg]
    calc ((2 + 1 : ℕ) : ℕ∞) ≤ ((2 + 2 : ℕ) : ℕ∞) := by exact_mod_cast (show 2 + 1 ≤ 2 + 2 by norm_num)
      _ = ((2 : ℕ) : ℕ∞) + ((2 : ℕ) : ℕ∞) := Nat.cast_add 2 2
      _ ≤ (p 0).order + (p 1).order := add_le_add (hp 0) (hp 1)
      _ ≤ _ := MvPowerSeries.le_order_mul
  have hRdiff : ∀ (n : ℕ) (p q : Fin 2 → MvPowerSeries (Fin 2) K),
      (∀ i, ((2 : ℕ) : ℕ∞) ≤ (p i).order) → (∀ i, ((2 : ℕ) : ℕ∞) ≤ (q i).order) →
      (∀ i, (n : ℕ∞) ≤ (p i - q i).order) →
      ((n + 1 + 1 : ℕ) : ℕ∞) ≤ ((f - MvPowerSeries.X 0 * MvPowerSeries.X 1 - p 0 * p 1)
        - (f - MvPowerSeries.X 0 * MvPowerSeries.X 1 - q 0 * q 1)).order := by
    intro n p q hp hq hpq
    have e : (f - MvPowerSeries.X 0 * MvPowerSeries.X 1 - p 0 * p 1)
        - (f - MvPowerSeries.X 0 * MvPowerSeries.X 1 - q 0 * q 1)
        = -(p 0 - q 0) * q 1 + p 0 * -(p 1 - q 1) := by ring
    rw [e]
    refine le_trans (le_min ?_ ?_) MvPowerSeries.min_order_le_add
    · calc ((n + 1 + 1 : ℕ) : ℕ∞) = (n : ℕ∞) + ((2 : ℕ) : ℕ∞) := by push_cast; ring
        _ ≤ (-(p 0 - q 0)).order + (q 1).order := by
          rw [MvPowerSeries.order_neg]; exact add_le_add (hpq 0) (hq 1)
        _ ≤ _ := MvPowerSeries.le_order_mul
    · calc ((n + 1 + 1 : ℕ) : ℕ∞) = ((2 : ℕ) : ℕ∞) + (n : ℕ∞) := by push_cast; ring
        _ ≤ (p 0).order + (-(p 1 - q 1)).order := by
          rw [MvPowerSeries.order_neg]; exact add_le_add (hp 0) (hpq 1)
        _ ≤ _ := MvPowerSeries.le_order_mul
  let T : (Fin 2 → MvPowerSeries (Fin 2) K) → (Fin 2 → MvPowerSeries (Fin 2) K) := fun p =>
    ![Dy (f - MvPowerSeries.X 0 * MvPowerSeries.X 1 - p 0 * p 1),
      Dx (f - MvPowerSeries.X 0 * MvPowerSeries.X 1 - p 0 * p 1)]
  have hinvT : ∀ p : Fin 2 → MvPowerSeries (Fin 2) K, (∀ i, ((2 : ℕ) : ℕ∞) ≤ (p i).order) →
      ∀ i, ((2 : ℕ) : ℕ∞) ≤ (T p i).order := by
    intro p hp
    have h := hDord 2 _ (hR3 p hp)
    refine Fin.forall_fin_two.mpr ⟨?_, ?_⟩
    · exact h.2
    · exact h.1
  have hconT : ∀ (n : ℕ) (p q : Fin 2 → MvPowerSeries (Fin 2) K),
      (∀ i, ((2 : ℕ) : ℕ∞) ≤ (p i).order) → (∀ i, ((2 : ℕ) : ℕ∞) ≤ (q i).order) →
      (∀ i, (n : ℕ∞) ≤ (p i - q i).order) →
      ∀ i, ((n + 1 : ℕ) : ℕ∞) ≤ (T p i - T q i).order := by
    intro n p q hp hq hpq
    have h := hDord (n + 1) _ (hRdiff n p q hp hq hpq)
    refine Fin.forall_fin_two.mpr ⟨?_, ?_⟩
    · show ((n + 1 : ℕ) : ℕ∞) ≤ (Dy (f - MvPowerSeries.X 0 * MvPowerSeries.X 1 - p 0 * p 1)
        - Dy (f - MvPowerSeries.X 0 * MvPowerSeries.X 1 - q 0 * q 1)).order
      rw [← hDy_sub]; exact h.2
    · show ((n + 1 : ℕ) : ℕ∞) ≤ (Dx (f - MvPowerSeries.X 0 * MvPowerSeries.X 1 - p 0 * p 1)
        - Dx (f - MvPowerSeries.X 0 * MvPowerSeries.X 1 - q 0 * q 1)).order
      rw [← hDx_sub]; exact h.1
  obtain ⟨p, hp2, hTp⟩ := hfix (Fin 2) T 2 hinvT hconT
  have hp0 : Dy (f - MvPowerSeries.X 0 * MvPowerSeries.X 1 - p 0 * p 1) = p 0 := congrFun hTp 0
  have hp1 : Dx (f - MvPowerSeries.X 0 * MvPowerSeries.X 1 - p 0 * p 1) = p 1 := congrFun hTp 1
  have hconst : MvPowerSeries.constantCoeff
      (f - MvPowerSeries.X 0 * MvPowerSeries.X 1 - p 0 * p 1) = 0 :=
    MvPowerSeries.one_le_order_iff_constCoeff_eq_zero.mp
      (le_trans (by exact_mod_cast (show (1 : ℕ) ≤ 2 + 1 by norm_num)) (hR3 p hp2))
  let F : Fin 2 → MvPowerSeries (Fin 2) K := fun s => MvPowerSeries.X s + p s
  have hF2 : ∀ s, (2 : ℕ∞) ≤ (F s - MvPowerSeries.X s).order := by
    intro s
    have e : F s - MvPowerSeries.X s = p s := by
      show MvPowerSeries.X s + p s - MvPowerSeries.X s = p s
      ring
    rw [e]
    exact_mod_cast hp2 s
  have hFf : F 0 * F 1 = f := by
    have h1 := hdec (f - MvPowerSeries.X 0 * MvPowerSeries.X 1 - p 0 * p 1)
    rw [hconst, map_zero, hp1, hp0] at h1
    show (MvPowerSeries.X 0 + p 0) * (MvPowerSeries.X 1 + p 1) = f
    linear_combination -h1



  have hX1 : ∀ s : Fin 2, 1 ≤ (MvPowerSeries.X s : MvPowerSeries (Fin 2) K).order :=
    fun s => MvPowerSeries.one_le_order_iff_constCoeff_eq_zero.mpr (MvPowerSeries.constantCoeff_X s)
  have hF1 : ∀ s, 1 ≤ (F s).order := by
    intro s
    have e : F s = (F s - MvPowerSeries.X s) + MvPowerSeries.X s := by ring
    rw [e]
    exact le_trans (le_min (le_trans one_le_two (hF2 s)) (hX1 s)) MvPowerSeries.min_order_le_add
  have hFsub : MvPowerSeries.HasSubst F :=
    MvPowerSeries.hasSubst_of_constantCoeff_zero
      (fun s => MvPowerSeries.one_le_order_iff_constCoeff_eq_zero.mp (hF1 s))
  have hpow_ord : ∀ (u : MvPowerSeries (Fin 2) K) (a : ℕ), 1 ≤ u.order → (a : ℕ∞) ≤ (u ^ a).order := by
    intro u a hu
    induction a with
    | zero => simp
    | succ a ih =>
      rw [pow_succ]
      calc ((a + 1 : ℕ) : ℕ∞) = (a : ℕ∞) + 1 := Nat.cast_succ a
        _ ≤ (u ^ a).order + u.order := add_le_add ih hu
        _ ≤ (u ^ a * u).order := MvPowerSeries.le_order_mul
  have hpowdiff : ∀ (u v : MvPowerSeries (Fin 2) K), 2 ≤ (u - v).order → 1 ≤ u.order →
      1 ≤ v.order → ∀ a : ℕ, ((a + 1 : ℕ) : ℕ∞) ≤ (u ^ a - v ^ a).order := by
    intro u v huv hu hv a
    induction a with
    | zero => simp
    | succ a ih =>
      have e : u ^ (a + 1) - v ^ (a + 1) = u * (u ^ a - v ^ a) + (u - v) * v ^ a := by ring
      rw [e]
      refine le_trans (le_min ?_ ?_) MvPowerSeries.min_order_le_add
      · calc ((a + 1 + 1 : ℕ) : ℕ∞) = 1 + ((a + 1 : ℕ) : ℕ∞) := by push_cast; ring
          _ ≤ u.order + (u ^ a - v ^ a).order := add_le_add hu ih
          _ ≤ _ := MvPowerSeries.le_order_mul
      · calc ((a + 1 + 1 : ℕ) : ℕ∞) = 2 + (a : ℕ∞) := by push_cast; ring
          _ ≤ (u - v).order + (v ^ a).order := add_le_add huv (hpow_ord v a hv)
          _ ≤ _ := MvPowerSeries.le_order_mul
  have hprodF : ∀ d : Fin 2 →₀ ℕ, (d.prod fun s k => F s ^ k) = F 0 ^ d 0 * F 1 ^ d 1 := by
    intro d; rw [Finsupp.prod_pow, Fin.prod_univ_two]
  have hprodX : ∀ d : Fin 2 →₀ ℕ, (d.prod fun s k => (MvPowerSeries.X s : MvPowerSeries (Fin 2) K) ^ k)
      = MvPowerSeries.X 0 ^ d 0 * MvPowerSeries.X 1 ^ d 1 := by
    intro d; rw [Finsupp.prod_pow, Fin.prod_univ_two]
  have hFX : ∀ d : Fin 2 →₀ ℕ, ((Finsupp.degree d + 1 : ℕ) : ℕ∞) ≤
      ((d.prod fun s k => F s ^ k)
        - (d.prod fun s k => (MvPowerSeries.X s : MvPowerSeries (Fin 2) K) ^ k)).order := by
    intro d
    rw [hprodF, hprodX]
    have e : F 0 ^ d 0 * F 1 ^ d 1 - MvPowerSeries.X 0 ^ d 0 * MvPowerSeries.X 1 ^ d 1
        = (F 0 ^ d 0 - MvPowerSeries.X 0 ^ d 0) * F 1 ^ d 1
          + MvPowerSeries.X 0 ^ d 0 * (F 1 ^ d 1 - MvPowerSeries.X 1 ^ d 1) := by ring
    rw [e]
    have hdeg : Finsupp.degree d = d 0 + d 1 := by
      rw [Finsupp.degree_eq_sum, Fin.sum_univ_two]
    rw [hdeg]
    refine le_trans (le_min ?_ ?_) MvPowerSeries.min_order_le_add
    · calc ((d 0 + d 1 + 1 : ℕ) : ℕ∞) = ((d 0 + 1 : ℕ) : ℕ∞) + (d 1 : ℕ∞) := by push_cast; ring
        _ ≤ (F 0 ^ d 0 - MvPowerSeries.X 0 ^ d 0).order + (F 1 ^ d 1).order :=
          add_le_add (hpowdiff _ _ (hF2 0) (hF1 0) (hX1 0) _) (hpow_ord _ _ (hF1 1))
        _ ≤ _ := MvPowerSeries.le_order_mul
    · calc ((d 0 + d 1 + 1 : ℕ) : ℕ∞) = (d 0 : ℕ∞) + ((d 1 + 1 : ℕ) : ℕ∞) := by push_cast; ring
        _ ≤ (MvPowerSeries.X 0 ^ d 0).order + (F 1 ^ d 1 - MvPowerSeries.X 1 ^ d 1).order :=
          add_le_add (hpow_ord _ _ (hX1 0)) (hpowdiff _ _ (hF2 1) (hF1 1) (hX1 1) _)
        _ ≤ _ := MvPowerSeries.le_order_mul
  have hXc : ∀ (h : MvPowerSeries (Fin 2) K) (e : Fin 2 →₀ ℕ), MvPowerSeries.coeff e h
      = ∑ᶠ d : Fin 2 →₀ ℕ, MvPowerSeries.coeff d h • MvPowerSeries.coeff e
          (d.prod fun s k => (MvPowerSeries.X s : MvPowerSeries (Fin 2) K) ^ k) := by
    intro h e
    have := MvPowerSeries.coeff_subst (R := K)
      (a := (MvPowerSeries.X : Fin 2 → MvPowerSeries (Fin 2) K)) MvPowerSeries.HasSubst.X h e
    rw [MvPowerSeries.subst_self] at this
    exact this
  have hnear : ∀ (n : ℕ) (h : MvPowerSeries (Fin 2) K), (n : ℕ∞) ≤ h.order →
      ((n + 1 : ℕ) : ℕ∞) ≤ (MvPowerSeries.subst F h - h).order := by
    intro n h hn
    apply MvPowerSeries.le_order
    intro e he
    have he' : Finsupp.degree e < n + 1 := by exact_mod_cast he
    rw [map_sub, MvPowerSeries.coeff_subst hFsub, sub_eq_zero, hXc h e]
    apply finsum_congr
    intro d
    by_cases hd : MvPowerSeries.coeff d h = 0
    · simp [hd]
    · have hdn : n ≤ Finsupp.degree d := by
        by_contra hlt
        push_neg at hlt
        exact hd (MvPowerSeries.coeff_of_lt_order (lt_of_lt_of_le (by exact_mod_cast hlt) hn))
      have h2 : MvPowerSeries.coeff e ((d.prod fun s k => F s ^ k)
          - (d.prod fun s k => (MvPowerSeries.X s : MvPowerSeries (Fin 2) K) ^ k)) = 0 :=
        MvPowerSeries.coeff_of_lt_order (lt_of_lt_of_le
          (by exact_mod_cast (show Finsupp.degree e < Finsupp.degree d + 1 by omega)) (hFX d))
      rw [map_sub, sub_eq_zero] at h2
      rw [h2]



  let φ := MvPowerSeries.substAlgHom (R := K) hFsub
  have hφ : ∀ h, φ h = MvPowerSeries.subst F h :=
    fun h => congrFun (MvPowerSeries.coe_substAlgHom (R := K) hFsub) h
  have hnearφ : ∀ (n : ℕ) (h : MvPowerSeries (Fin 2) K), (n : ℕ∞) ≤ h.order →
      ((n + 1 : ℕ) : ℕ∞) ≤ (φ h - h).order := by
    intro n h hn; rw [hφ]; exact hnear n h hn
  have hinj : Function.Injective φ := by
    rw [injective_iff_map_eq_zero]
    intro h hh
    by_contra hne
    have htop : h.order ≠ ⊤ := fun ht => hne (MvPowerSeries.order_eq_top_iff.mp ht)
    obtain ⟨m, hm⟩ := ENat.ne_top_iff_exists.mp htop
    have h1 := hnearφ m h hm.le
    rw [hh, zero_sub, MvPowerSeries.order_neg, ← hm] at h1
    have : m + 1 ≤ m := by exact_mod_cast h1
    omega
  have hsurj : Function.Surjective φ := by
    intro t
    let T' : (Unit → MvPowerSeries (Fin 2) K) → (Unit → MvPowerSeries (Fin 2) K) :=
      fun q i => t - (φ (q i) - q i)
    have hinv' : ∀ q : Unit → MvPowerSeries (Fin 2) K, (∀ i, ((0 : ℕ) : ℕ∞) ≤ (q i).order) →
        ∀ i, ((0 : ℕ) : ℕ∞) ≤ (T' q i).order := fun _ _ _ => by simp
    have hcon' : ∀ (n : ℕ) (q r : Unit → MvPowerSeries (Fin 2) K),
        (∀ i, ((0 : ℕ) : ℕ∞) ≤ (q i).order) → (∀ i, ((0 : ℕ) : ℕ∞) ≤ (r i).order) →
        (∀ i, (n : ℕ∞) ≤ (q i - r i).order) →
        ∀ i, ((n + 1 : ℕ) : ℕ∞) ≤ (T' q i - T' r i).order := by
      intro n q r _ _ hqr i
      show ((n + 1 : ℕ) : ℕ∞) ≤ ((t - (φ (q i) - q i)) - (t - (φ (r i) - r i))).order
      have e : (t - (φ (q i) - q i)) - (t - (φ (r i) - r i))
          = -(φ (q i - r i) - (q i - r i)) := by rw [map_sub]; ring
      rw [e, MvPowerSeries.order_neg]
      exact hnearφ n _ (hqr i)
    obtain ⟨q, -, hq⟩ := hfix Unit T' 0 hinv' hcon'
    refine ⟨q (), ?_⟩
    have h2 : t - (φ (q ()) - q ()) = q () := congrFun hq ()
    linear_combination -h2



  let e₀ : MvPowerSeries (Fin 2) K ≃+* MvPowerSeries (Fin 2) K :=
    RingEquiv.ofBijective φ ⟨hinj, hsurj⟩
  have he₀ : ∀ x, e₀ x = φ x := fun x => rfl
  have hX01 : e₀ (MvPowerSeries.X 0 * MvPowerSeries.X 1) = f := by
    rw [he₀, map_mul, hφ, hφ, MvPowerSeries.subst_X hFsub, MvPowerSeries.subst_X hFsub]
    exact hFf
  have hJ : Ideal.span {f} = Ideal.map (e₀ : MvPowerSeries (Fin 2) K →+* MvPowerSeries (Fin 2) K)
      (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}) := by
    rw [Ideal.map_span, Set.image_singleton]
    show Ideal.span {f} = Ideal.span {e₀ (MvPowerSeries.X 0 * MvPowerSeries.X 1)}
    rw [hX01]
  have hC : ∀ c : K, e₀ (MvPowerSeries.C c) = MvPowerSeries.C c := by
    intro c
    have h1 := φ.commutes c
    rw [MvPowerSeries.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply] at h1
    exact h1
  refine ⟨(Ideal.quotientEquiv _ _ e₀ hJ).symm, ?_⟩
  apply RingHom.ext
  intro c
  show (Ideal.quotientEquiv _ _ e₀ hJ).symm (Ideal.Quotient.mk _ (MvPowerSeries.C c))
    = Ideal.Quotient.mk _ (MvPowerSeries.C c)
  rw [Ideal.quotientEquiv_symm_mk]
  congr 1
  rw [RingEquiv.symm_apply_eq]
  exact (hC c).symm

theorem wcpa_cl_na_hilbert : ∀ (K A B : Type u) [Field K] [CommRing A] [CommRing B] (κ : K →+* B) (κA : K →+* A) (ι : B →+* A) (m : ℕ) (s : Fin m × Fin 2 → (A →+* K)) (e₀ : Fin m), (∀ g : A, (∃ b, ι b = g) ↔ ∀ e, s (e, 0) g = s (e, 1) g) → ι.comp κ = κA → (∀ a (c : K), s a (κA c) = c) → (∀ a b, a ≠ b → RingHom.ker (s a) ⊔ RingHom.ker (s b) = ⊤) → (∀ (i : Fin 2) (n : ℕ), letI : Algebra K A := κA.toAlgebra; Module.finrank K (A ⧸ RingHom.ker (s (e₀, i)) ^ n) = n) → (∀ (n : ℕ) (b : B), ι b ∈ RingHom.ker (s (e₀, 0)) ^ n ⊓ RingHom.ker (s (e₀, 1)) ^ n ↔ b ∈ RingHom.ker ((s (e₀, 0)).comp ι) ^ n) → ∀ n : ℕ, 1 ≤ n → letI : Algebra K B := κ.toAlgebra; Module.finrank K (B ⧸ RingHom.ker ((s (e₀, 0)).comp ι) ^ n) = 2 * n - 1 :=
by
  intro K A B _ _ _ κ κA ι m s e₀ hEq hκ hsκ hcomax hfin hPI n hn
  classical
  letI iB : Algebra K B := κ.toAlgebra
  letI iA : Algebra K A := κA.toAlgebra
  have hn0 : n ≠ 0 := by omega

  obtain ⟨k, hk⟩ := Ideal.exists_forall_sub_mem_ideal
    (I := fun a : Fin m × Fin 2 => RingHom.ker (s a))
    (fun a b hab => Ideal.isCoprime_iff_sup_eq.mpr (hcomax a b hab))
    (fun a => if a.1 = e₀ then (1 : A) else 0)
  have hsk : ∀ (e : Fin m) (i : Fin 2), s (e, i) k = if e = e₀ then 1 else 0 := by
    intro e i
    have h1 := RingHom.mem_ker.mp (hk (e, i))
    rw [map_sub, sub_eq_zero] at h1
    rw [h1]
    by_cases he : e = e₀ <;> simp [he]
  have hcop : RingHom.ker (s (e₀, 0)) ⊔ RingHom.ker (s (e₀, 1)) = ⊤ :=
    hcomax _ _ (by simp [Prod.ext_iff])
  have hcopn : IsCoprime (RingHom.ker (s (e₀, 0)) ^ n) (RingHom.ker (s (e₀, 1)) ^ n) :=
    (Ideal.isCoprime_iff_sup_eq.mpr hcop).pow
  obtain ⟨p, hp, q, hq, hpq⟩ := Ideal.isCoprime_iff_exists.mp hcopn
  have hp0 : s (e₀, 0) p = 0 := RingHom.mem_ker.mp (Ideal.pow_le_self hn0 hp)
  have hq1 : s (e₀, 1) q = 0 := RingHom.mem_ker.mp (Ideal.pow_le_self hn0 hq)
  have hq0 : s (e₀, 0) q = 1 := by
    have := congrArg (s (e₀, 0)) hpq
    rw [map_add, map_one, hp0, zero_add] at this
    exact this
  have hp1 : s (e₀, 1) p = 1 := by
    have := congrArg (s (e₀, 1)) hpq
    rw [map_add, map_one, hq1, add_zero] at this
    exact this
  have hk0 : (1 - k) ^ n ∈ RingHom.ker (s (e₀, 0)) ^ n :=
    Ideal.pow_mem_pow (RingHom.mem_ker.mpr (by rw [map_sub, map_one, hsk]; simp)) n
  have hk1 : (1 - k) ^ n ∈ RingHom.ker (s (e₀, 1)) ^ n :=
    Ideal.pow_mem_pow (RingHom.mem_ker.mpr (by rw [map_sub, map_one, hsk]; simp)) n
  have hlift : ∀ x y : A, s (e₀, 0) x = s (e₀, 1) y → ∃ b : B,
      ι b - x ∈ RingHom.ker (s (e₀, 0)) ^ n ∧ ι b - y ∈ RingHom.ker (s (e₀, 1)) ^ n := by
    intro x y hxy
    have hg : ∀ e, s (e, 0) ((1 - (1 - k) ^ n) * (x * q + y * p)) =
        s (e, 1) ((1 - (1 - k) ^ n) * (x * q + y * p)) := by
      intro e
      simp only [map_mul, map_sub, map_one, map_pow, map_add, hsk]
      by_cases he : e = e₀
      · rw [he]
        simp [hp0, hq1, hq0, hp1, zero_pow hn0, hxy]
      · simp [he]
    obtain ⟨b, hb⟩ := (hEq _).mpr hg
    refine ⟨b, ?_, ?_⟩
    · have e1 : ι b - x = (y - x) * p - (1 - k) ^ n * (x * q + y * p) := by
        rw [hb]; linear_combination x * hpq
      rw [e1]
      exact Ideal.sub_mem _ (Ideal.mul_mem_left _ _ hp) (Ideal.mul_mem_right _ _ hk0)
    · have e1 : ι b - y = (x - y) * q - (1 - k) ^ n * (x * q + y * p) := by
        rw [hb]; linear_combination y * hpq
      rw [e1]
      exact Ideal.sub_mem _ (Ideal.mul_mem_left _ _ hq) (Ideal.mul_mem_right _ _ hk1)

  let ιₐ : B →ₐ[K] A :=
    { ι with
      commutes' := fun c => by
        show ι (κ c) = κA c
        rw [← hκ]; rfl }
  let φ₀ : (B ⧸ RingHom.ker ((s (e₀, 0)).comp ι) ^ n) →ₐ[K] (A ⧸ RingHom.ker (s (e₀, 0)) ^ n) :=
    Ideal.Quotient.liftₐ _ ((Ideal.Quotient.mkₐ K _).comp ιₐ)
      (fun b hb => Ideal.Quotient.eq_zero_iff_mem.mpr ((hPI n b).mpr hb).1)
  let φ₁ : (B ⧸ RingHom.ker ((s (e₀, 0)).comp ι) ^ n) →ₐ[K] (A ⧸ RingHom.ker (s (e₀, 1)) ^ n) :=
    Ideal.Quotient.liftₐ _ ((Ideal.Quotient.mkₐ K _).comp ιₐ)
      (fun b hb => Ideal.Quotient.eq_zero_iff_mem.mpr ((hPI n b).mpr hb).2)
  let Φ := φ₀.toLinearMap.prod φ₁.toLinearMap
  have hΦ : ∀ b : B, Φ (Ideal.Quotient.mk _ b) =
      (Ideal.Quotient.mk _ (ι b), Ideal.Quotient.mk _ (ι b)) := fun b => rfl
  let σ₀ : A →ₐ[K] K :=
    { s (e₀, 0) with commutes' := fun c => hsκ _ c }
  let σ₁ : A →ₐ[K] K :=
    { s (e₀, 1) with commutes' := fun c => hsκ _ c }
  let l₀ : (A ⧸ RingHom.ker (s (e₀, 0)) ^ n) →ₐ[K] K :=
    Ideal.Quotient.liftₐ _ σ₀ (fun a ha => RingHom.mem_ker.mp (Ideal.pow_le_self hn0 ha))
  let l₁ : (A ⧸ RingHom.ker (s (e₀, 1)) ^ n) →ₐ[K] K :=
    Ideal.Quotient.liftₐ _ σ₁ (fun a ha => RingHom.mem_ker.mp (Ideal.pow_le_self hn0 ha))
  let l := l₀.toLinearMap ∘ₗ LinearMap.fst K _ _ - l₁.toLinearMap ∘ₗ LinearMap.snd K _ _
  have hl : ∀ x y : A, l (Ideal.Quotient.mk _ x, Ideal.Quotient.mk _ y) =
      s (e₀, 0) x - s (e₀, 1) y := fun x y => rfl
  have hlsurj : Function.Surjective l := by
    intro c
    have := hl (κA c) 0
    simp only [map_zero, sub_zero, hsκ] at this
    exact ⟨_, this⟩
  have hΦinj : Function.Injective Φ := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro w hw
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective w
    rw [hΦ] at hw
    have h0 : Ideal.Quotient.mk (RingHom.ker (s (e₀, 0)) ^ n) (ι b) = 0 := congrArg Prod.fst hw
    have h1 : Ideal.Quotient.mk (RingHom.ker (s (e₀, 1)) ^ n) (ι b) = 0 := congrArg Prod.snd hw
    rw [Ideal.Quotient.eq_zero_iff_mem] at h0 h1
    exact Ideal.Quotient.eq_zero_iff_mem.mpr ((hPI n b).mp ⟨h0, h1⟩)
  have hrange : LinearMap.range Φ = LinearMap.ker l := by
    ext ⟨z₀, z₁⟩
    constructor
    · rintro ⟨w, hw⟩
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective w
      rw [hΦ] at hw
      rw [LinearMap.mem_ker, ← hw, hl, sub_eq_zero]
      exact (hEq (ι b)).mp ⟨b, rfl⟩ e₀
    · intro hz
      rw [LinearMap.mem_ker] at hz
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z₀
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective z₁
      rw [hl, sub_eq_zero] at hz
      obtain ⟨b, hb0, hb1⟩ := hlift x y hz
      refine ⟨Ideal.Quotient.mk _ b, ?_⟩
      rw [hΦ, Prod.mk.injEq]
      exact ⟨Ideal.Quotient.eq.mpr hb0, Ideal.Quotient.eq.mpr hb1⟩

  have hf0 : Module.finrank K (A ⧸ RingHom.ker (s (e₀, 0)) ^ n) = n := hfin 0 n
  have hf1 : Module.finrank K (A ⧸ RingHom.ker (s (e₀, 1)) ^ n) = n := hfin 1 n
  haveI : FiniteDimensional K (A ⧸ RingHom.ker (s (e₀, 0)) ^ n) :=
    Module.finite_of_finrank_pos (by rw [hf0]; omega)
  haveI : FiniteDimensional K (A ⧸ RingHom.ker (s (e₀, 1)) ^ n) :=
    Module.finite_of_finrank_pos (by rw [hf1]; omega)
  have hrn := LinearMap.finrank_range_add_finrank_ker l
  rw [LinearMap.range_eq_top_of_surjective l hlsurj, finrank_top, Module.finrank_self,
    Module.finrank_prod, hf0, hf1] at hrn
  rw [← LinearMap.finrank_range_of_inj hΦinj, hrange]
  omega

theorem wcpa_cl_na_cotangent : ∀ (K A B : Type u) [Field K] [CommRing A] [CommRing B] (κ : K →+* B) (κA : K →+* A) (ι : B →+* A) (m : ℕ) (s : Fin m × Fin 2 → (A →+* K)) (e₀ : Fin m), (∀ g : A, (∃ b, ι b = g) ↔ ∀ e, s (e, 0) g = s (e, 1) g) → ι.comp κ = κA → (∀ a (c : K), s a (κA c) = c) → (∀ a b, a ≠ b → RingHom.ker (s a) ⊔ RingHom.ker (s b) = ⊤) → (∀ (i : Fin 2) (n : ℕ), letI : Algebra K A := κA.toAlgebra; Module.finrank K (A ⧸ RingHom.ker (s (e₀, i)) ^ n) = n) → (∀ (n : ℕ) (b : B), ι b ∈ RingHom.ker (s (e₀, 0)) ^ n ⊓ RingHom.ker (s (e₀, 1)) ^ n ↔ b ∈ RingHom.ker ((s (e₀, 0)).comp ι) ^ n) → ∃ u v : B, u ∈ RingHom.ker ((s (e₀, 0)).comp ι) ∧ v ∈ RingHom.ker ((s (e₀, 0)).comp ι) ∧ u * v ∈ RingHom.ker ((s (e₀, 0)).comp ι) ^ 3 ∧ (∀ y ∈ RingHom.ker ((s (e₀, 0)).comp ι), ∃ c₁ c₂ : K, y - (κ c₁ * u + κ c₂ * v) ∈ RingHom.ker ((s (e₀, 0)).comp ι) ^ 2) ∧ (∀ c₁ c₂ : K, κ c₁ * u + κ c₂ * v ∈ RingHom.ker ((s (e₀, 0)).comp ι) ^ 2 → c₁ = 0 ∧ c₂ = 0) :=
by
  intro K A B _ _ _ κ κA ι m s e₀ hEq hκ hsκ hcomax hfin hPI
  classical

  have cancel : ∀ (c : K) (x : A) (I : Ideal A), κA c * x ∈ I → x ∉ I → c = 0 := by
    intro c x I hx hxI
    by_contra hc
    apply hxI
    have e : x = κA c⁻¹ * (κA c * x) := by
      rw [← mul_assoc, ← map_mul, inv_mul_cancel₀ hc, map_one, one_mul]
    rw [e]
    exact I.mul_mem_left _ hx

  have cotLine : ∀ σ : A →+* K, (∀ c : K, σ (κA c) = c) →
      (∀ n : ℕ, letI : Algebra K A := κA.toAlgebra;
        Module.finrank K (A ⧸ RingHom.ker σ ^ n) = n) →
      ∃ t ∈ RingHom.ker σ, t ∉ RingHom.ker σ ^ 2 ∧
        ∀ x ∈ RingHom.ker σ, ∃ c : K, x - κA c * t ∈ RingHom.ker σ ^ 2 := by
    intro σ hσ hn
    letI : Algebra K A := κA.toAlgebra
    have hP2le : RingHom.ker σ ^ 2 ≤ RingHom.ker σ := Ideal.pow_le_self two_ne_zero
    have hnot : ¬ RingHom.ker σ ≤ RingHom.ker σ ^ 2 := by
      intro h
      have heq : RingHom.ker σ ^ 2 = RingHom.ker σ ^ 1 := by
        rw [pow_one]; exact le_antisymm hP2le h
      have h2 := hn 2
      have h1 := hn 1
      rw [heq, h1] at h2
      omega
    obtain ⟨t, htP, htP2⟩ := SetLike.not_le_iff_exists.mp hnot
    have hσt : σ t = 0 := RingHom.mem_ker.mp htP
    have hsmul : ∀ (c : K) (x : A), c • (Ideal.Quotient.mk (RingHom.ker σ ^ 2) x) =
        Ideal.Quotient.mk (RingHom.ker σ ^ 2) (κA c * x) := by
      intro c x
      rw [Algebra.smul_def, map_mul]
      rfl
    have hli : LinearIndependent K
        ![Ideal.Quotient.mk (RingHom.ker σ ^ 2) 1, Ideal.Quotient.mk (RingHom.ker σ ^ 2) t] := by
      rw [LinearIndependent.pair_iff]
      intro a b hab
      rw [hsmul, hsmul, ← map_add, Ideal.Quotient.eq_zero_iff_mem] at hab
      have hσab : σ (κA a * 1 + κA b * t) = 0 := RingHom.mem_ker.mp (hP2le hab)
      simp only [map_add, map_mul, hσ, hσt, mul_zero, add_zero, mul_one] at hσab
      subst hσab
      refine ⟨rfl, ?_⟩
      rw [map_zero, zero_mul, zero_add] at hab
      exact cancel b t _ hab htP2
    have hfr : Fintype.card (Fin 2) = Module.finrank K (A ⧸ RingHom.ker σ ^ 2) := by
      rw [Fintype.card_fin]; exact (hn 2).symm
    have hspan := hli.span_eq_top_of_card_eq_finrank hfr
    refine ⟨t, htP, htP2, fun x hx => ?_⟩
    have hmem : Ideal.Quotient.mk (RingHom.ker σ ^ 2) x ∈ Submodule.span K (Set.range
        ![Ideal.Quotient.mk (RingHom.ker σ ^ 2) 1, Ideal.Quotient.mk (RingHom.ker σ ^ 2) t]) := by
      rw [hspan]; trivial
    obtain ⟨f, hf⟩ := (Submodule.mem_span_range_iff_exists_fun K).mp hmem
    simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one] at hf
    rw [hsmul, hsmul, ← map_add, Ideal.Quotient.eq] at hf
    have h0 : σ (κA (f 0) * 1 + κA (f 1) * t - x) = 0 := RingHom.mem_ker.mp (hP2le hf)
    simp only [map_sub, map_add, map_mul, hσ, hσt, mul_zero, add_zero, mul_one,
      RingHom.mem_ker.mp hx, sub_zero] at h0
    refine ⟨f 1, ?_⟩
    have e : x - κA (f 1) * t = -(κA (f 0) * 1 + κA (f 1) * t - x) := by
      rw [h0, map_zero]; ring
    rw [e]
    exact (RingHom.ker σ ^ 2).neg_mem hf
  obtain ⟨t₀, ht₀, ht₀2, line₀⟩ := cotLine (s (e₀, 0)) (hsκ (e₀, 0)) (hfin 0)
  obtain ⟨t₁, ht₁, ht₁2, line₁⟩ := cotLine (s (e₀, 1)) (hsκ (e₀, 1)) (hfin 1)

  have crt : ∀ j : Fin m × Fin 2, ∃ hj : A, ∀ i, s i hj = if i = j then 1 else 0 := by
    intro j
    have hx : ∀ i, ∃ x : A, i ≠ j → (s i x = 0 ∧ s j x = 1) := by
      intro i
      by_cases hij : i = j
      · exact ⟨0, fun h => absurd hij h⟩
      · have h1 : (1 : A) ∈ RingHom.ker (s i) ⊔ RingHom.ker (s j) := by
          rw [hcomax i j hij]; trivial
        obtain ⟨x, hx, y, hy, hxy⟩ := Submodule.mem_sup.mp h1
        refine ⟨x, fun _ => ⟨RingHom.mem_ker.mp hx, ?_⟩⟩
        have h2 : s j (x + y) = 1 := by rw [hxy, map_one]
        rwa [map_add, RingHom.mem_ker.mp hy, add_zero] at h2
    choose x hx using hx
    refine ⟨∏ i ∈ Finset.univ.erase j, x i, fun i => ?_⟩
    rw [map_prod]
    split_ifs with hij
    · subst hij
      exact Finset.prod_eq_one (fun a ha => (hx a (Finset.ne_of_mem_erase ha)).2)
    · exact Finset.prod_eq_zero (Finset.mem_erase.mpr ⟨hij, Finset.mem_univ i⟩) (hx i hij).1
  choose h hh using crt
  obtain ⟨k, hk⟩ : ∃ k : A, k = h (e₀, 0) + h (e₀, 1) := ⟨_, rfl⟩
  have hsk : ∀ (e : Fin m) (i : Fin 2), s (e, i) k = if e = e₀ then 1 else 0 := by
    intro e i
    rw [hk, map_add, hh, hh]
    by_cases he : e = e₀
    · subst he
      fin_cases i <;> simp
    · simp [Prod.ext_iff, he]
  have hk0 : k - 1 ∈ RingHom.ker (s (e₀, 0)) := by
    rw [RingHom.mem_ker, map_sub, map_one, hsk]; simp
  have hk1 : k - 1 ∈ RingHom.ker (s (e₀, 1)) := by
    rw [RingHom.mem_ker, map_sub, map_one, hsk]; simp

  have hne : ((e₀, 0) : Fin m × Fin 2) ≠ (e₀, 1) := by simp [Prod.ext_iff]
  have hcop : RingHom.ker (s (e₀, 0)) ^ 2 ⊔ RingHom.ker (s (e₀, 1)) ^ 2 = ⊤ :=
    Ideal.isCoprime_iff_sup_eq.mp ((Ideal.isCoprime_iff_sup_eq.mpr (hcomax _ _ hne)).pow)
  have h1mem : (1 : A) ∈ RingHom.ker (s (e₀, 0)) ^ 2 ⊔ RingHom.ker (s (e₀, 1)) ^ 2 := by
    rw [hcop]; trivial
  obtain ⟨p, hp, q, hq, hpq⟩ := Submodule.mem_sup.mp h1mem
  have hp' : p = 1 - q := by rw [← hpq]; ring
  have hq' : q = 1 - p := by rw [← hpq]; ring
  have mul2 : ∀ (I : Ideal A) (a b : A), a ∈ I → b ∈ I → a * b ∈ I ^ 2 := fun I a b ha hb => by
    rw [sq]; exact Ideal.mul_mem_mul ha hb
  have mul3 : ∀ (I : Ideal A) (a b : A), a ∈ I → b ∈ I ^ 2 → a * b ∈ I ^ 3 :=
    fun I a b ha hb => by
      have e : I ^ 3 = I * I ^ 2 := pow_succ' I 2
      rw [e]; exact Ideal.mul_mem_mul ha hb
  have hpP : s (e₀, 0) p = 0 := RingHom.mem_ker.mp (Ideal.pow_le_self two_ne_zero hp)
  have hqP : s (e₀, 1) q = 0 := RingHom.mem_ker.mp (Ideal.pow_le_self two_ne_zero hq)

  have hz₀ : ∀ a, s a (k * t₀ * q) = 0 := by
    rintro ⟨e, i⟩
    rw [map_mul, map_mul, hsk]
    by_cases he : e = e₀
    · subst he
      fin_cases i
      · simp [RingHom.mem_ker.mp ht₀]
      · simp [hqP]
    · simp [he]
  have hz₁ : ∀ a, s a (k * t₁ * p) = 0 := by
    rintro ⟨e, i⟩
    rw [map_mul, map_mul, hsk]
    by_cases he : e = e₀
    · subst he
      fin_cases i
      · simp [hpP]
      · simp [RingHom.mem_ker.mp ht₁]
    · simp [he]
  have j00 : k * t₀ * q - t₀ ∈ RingHom.ker (s (e₀, 0)) ^ 2 := by
    have e : k * t₀ * q - t₀ = (k - 1) * t₀ - (k * t₀) * p := by rw [hq']; ring
    rw [e]
    exact Ideal.sub_mem _ (mul2 _ _ _ hk0 ht₀) (Ideal.mul_mem_left _ _ hp)
  have j01 : k * t₀ * q ∈ RingHom.ker (s (e₀, 1)) ^ 2 := Ideal.mul_mem_left _ _ hq
  have j10 : k * t₁ * p ∈ RingHom.ker (s (e₀, 0)) ^ 2 := Ideal.mul_mem_left _ _ hp
  have j11 : k * t₁ * p - t₁ ∈ RingHom.ker (s (e₀, 1)) ^ 2 := by
    have e : k * t₁ * p - t₁ = (k - 1) * t₁ - (k * t₁) * q := by rw [hp']; ring
    rw [e]
    exact Ideal.sub_mem _ (mul2 _ _ _ hk1 ht₁) (Ideal.mul_mem_left _ _ hq)
  have pr0 : k * t₀ * q * (k * t₁ * p) ∈ RingHom.ker (s (e₀, 0)) ^ 3 := by
    have e : k * t₀ * q * (k * t₁ * p) = (t₀ * p) * (k * k * t₁ * q) := by ring
    rw [e]
    exact Ideal.mul_mem_right _ _ (mul3 _ _ _ ht₀ hp)
  have pr1 : k * t₀ * q * (k * t₁ * p) ∈ RingHom.ker (s (e₀, 1)) ^ 3 := by
    have e : k * t₀ * q * (k * t₁ * p) = (t₁ * q) * (k * k * t₀ * p) := by ring
    rw [e]
    exact Ideal.mul_mem_right _ _ (mul3 _ _ _ ht₁ hq)

  obtain ⟨u, hu⟩ := (hEq (k * t₀ * q)).mpr (fun e => by rw [hz₀, hz₀])
  obtain ⟨v, hv⟩ := (hEq (k * t₁ * p)).mpr (fun e => by rw [hz₁, hz₁])
  have hκ' : ∀ c, ι (κ c) = κA c := fun c => by rw [← RingHom.comp_apply, hκ]
  refine ⟨u, v, ?_, ?_, ?_, ?_, ?_⟩
  · rw [RingHom.mem_ker, RingHom.comp_apply, hu, hz₀]
  · rw [RingHom.mem_ker, RingHom.comp_apply, hv, hz₁]
  · apply (hPI 3 (u * v)).mp
    rw [map_mul, hu, hv]
    exact ⟨pr0, pr1⟩
  · intro y hy
    have hy0 : ι y ∈ RingHom.ker (s (e₀, 0)) := by
      rw [RingHom.mem_ker]; exact RingHom.mem_ker.mp hy
    have hy1 : ι y ∈ RingHom.ker (s (e₀, 1)) := by
      rw [RingHom.mem_ker, ← (hEq (ι y)).mp ⟨y, rfl⟩ e₀]
      exact RingHom.mem_ker.mp hy0
    obtain ⟨c₁, hc₁⟩ := line₀ _ hy0
    obtain ⟨c₂, hc₂⟩ := line₁ _ hy1
    refine ⟨c₁, c₂, (hPI 2 _).mp ?_⟩
    rw [map_sub, map_add, map_mul, map_mul, hκ', hκ', hu, hv]
    constructor
    · have e : ι y - (κA c₁ * (k * t₀ * q) + κA c₂ * (k * t₁ * p)) =
          (ι y - κA c₁ * t₀) - κA c₁ * (k * t₀ * q - t₀) - κA c₂ * (k * t₁ * p) := by ring
      rw [e]
      exact Ideal.sub_mem _ (Ideal.sub_mem _ hc₁ (Ideal.mul_mem_left _ _ j00))
        (Ideal.mul_mem_left _ _ j10)
    · have e : ι y - (κA c₁ * (k * t₀ * q) + κA c₂ * (k * t₁ * p)) =
          (ι y - κA c₂ * t₁) - κA c₂ * (k * t₁ * p - t₁) - κA c₁ * (k * t₀ * q) := by ring
      rw [e]
      exact Ideal.sub_mem _ (Ideal.sub_mem _ hc₂ (Ideal.mul_mem_left _ _ j11))
        (Ideal.mul_mem_left _ _ j01)
  · intro c₁ c₂ hc
    have hz := (hPI 2 _).mpr hc
    rw [map_add, map_mul, map_mul, hκ', hκ', hu, hv] at hz
    obtain ⟨hz0, hz1⟩ := hz
    constructor
    · apply cancel c₁ t₀ _ _ ht₀2
      have e : κA c₁ * t₀ = (κA c₁ * (k * t₀ * q) + κA c₂ * (k * t₁ * p)) -
          κA c₁ * (k * t₀ * q - t₀) - κA c₂ * (k * t₁ * p) := by ring
      rw [e]
      exact Ideal.sub_mem _ (Ideal.sub_mem _ hz0 (Ideal.mul_mem_left _ _ j00))
        (Ideal.mul_mem_left _ _ j10)
    · apply cancel c₂ t₁ _ _ ht₁2
      have e : κA c₂ * t₁ = (κA c₁ * (k * t₀ * q) + κA c₂ * (k * t₁ * p)) -
          κA c₂ * (k * t₁ * p - t₁) - κA c₁ * (k * t₀ * q) := by ring
      rw [e]
      exact Ideal.sub_mem _ (Ideal.sub_mem _ hz1 (Ideal.mul_mem_left _ _ j11))
        (Ideal.mul_mem_left _ _ j01)

theorem wcpa_cl_na_loc_quot : ∀ (B R : Type u) [CommRing B] [CommRing R] [Algebra B R] [IsLocalRing R] (P : Ideal B) [P.IsMaximal] [IsLocalization.AtPrime R P] (n : ℕ), ∃ ψ : B ⧸ P ^ n ≃+* R ⧸ IsLocalRing.maximalIdeal R ^ n, ∀ b : B, ψ (Ideal.Quotient.mk _ b) = Ideal.Quotient.mk _ (algebraMap B R b) :=
by
  intro B R _ _ _ _ P hPmax _ n

  have hunit : ∀ s : B, s ∉ P → ∃ u : B, u * s - 1 ∈ P ^ n := by
    intro s hs
    obtain ⟨t, i, hi, hti⟩ := hPmax.exists_inv hs
    refine ⟨t * ∑ k ∈ Finset.range n, i ^ k, ?_⟩
    have hgeom := mul_neg_geom_sum i n
    have heq : t * (∑ k ∈ Finset.range n, i ^ k) * s - 1 = -(i ^ n) := by
      have hts : t * s = 1 - i := by linear_combination hti
      linear_combination (∑ k ∈ Finset.range n, i ^ k) * hts + hgeom
    rw [heq]
    exact (P ^ n).neg_mem (Ideal.pow_mem_pow hi n)
  have hm : IsLocalRing.maximalIdeal R ^ n = Ideal.map (algebraMap B R) (P ^ n) := by
    rw [Ideal.map_pow, IsLocalization.AtPrime.map_eq_maximalIdeal]
  set f : B →+* R ⧸ IsLocalRing.maximalIdeal R ^ n :=
    (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ n)).comp (algebraMap B R) with hf
  have hsurj : Function.Surjective f := by
    intro y
    obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨⟨a, s⟩, hzs⟩ := IsLocalization.surj P.primeCompl z
    have hs : (s : B) ∉ P := s.2
    obtain ⟨u, hu⟩ := hunit s hs
    refine ⟨a * u, ?_⟩
    rw [hf, RingHom.comp_apply, Ideal.Quotient.eq, hm]
    have key : algebraMap B R (a * u) - z = z * algebraMap B R (u * s - 1) := by
      simp only [map_mul, map_sub, map_one] at hzs ⊢
      rw [← hzs]
      ring
    rw [key]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ hu)
  have hker : RingHom.ker f = P ^ n := by
    ext b
    rw [RingHom.mem_ker, hf, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem, hm]
    constructor
    · intro hb
      obtain ⟨⟨⟨a, ha⟩, ⟨s, hs⟩⟩, hbs⟩ :=
        (IsLocalization.mem_map_algebraMap_iff P.primeCompl R).mp hb
      simp only at hbs
      rw [← map_mul] at hbs
      obtain ⟨⟨c, hc⟩, hc'⟩ := (IsLocalization.eq_iff_exists P.primeCompl R).mp hbs
      simp only at hc'
      have hw : c * s ∉ P := by
        intro h
        rcases (Ideal.IsPrime.mem_or_mem inferInstance h) with h | h
        · exact hc h
        · exact hs h
      obtain ⟨u, hu⟩ := hunit (c * s) hw
      have hwb : c * s * b ∈ P ^ n := by
        have : c * s * b = c * a := by rw [← hc']; ring
        rw [this]
        exact Ideal.mul_mem_left _ _ ha
      have hb' : b = u * (c * s * b) - (u * (c * s) - 1) * b := by ring
      rw [hb']
      exact Ideal.sub_mem _ (Ideal.mul_mem_left _ _ hwb) (Ideal.mul_mem_right _ _ hu)
    · intro hb
      exact Ideal.mem_map_of_mem _ hb
  refine ⟨(Ideal.quotEquivOfEq hker).symm.trans (RingHom.quotientKerEquivOfSurjective hsurj), ?_⟩
  intro b
  rw [RingEquiv.trans_apply]
  have h1 : (Ideal.quotEquivOfEq hker).symm (Ideal.Quotient.mk (P ^ n) b) =
      Ideal.Quotient.mk (RingHom.ker f) b := by
    rw [RingEquiv.symm_apply_eq, Ideal.quotEquivOfEq_mk]
  rw [h1, RingHom.quotientKerEquivOfSurjective_apply_mk]
  rfl

theorem wcpa_cl_na_transfer : ∀ (K B R : Type u) [Field K] [CommRing B] [CommRing R] [Algebra B R] [IsLocalRing R] (κ : K →+* B) (𝔪 : Ideal B), (∀ n : ℕ, ∃ ψ : B ⧸ 𝔪 ^ n ≃+* R ⧸ IsLocalRing.maximalIdeal R ^ n, ∀ b : B, ψ (Ideal.Quotient.mk _ b) = Ideal.Quotient.mk _ (algebraMap B R b)) → (∀ n : ℕ, 1 ≤ n → letI : Algebra K B := κ.toAlgebra; Module.finrank K (B ⧸ 𝔪 ^ n) = 2 * n - 1) → ∀ u v : B, u ∈ 𝔪 → v ∈ 𝔪 → u * v ∈ 𝔪 ^ 3 → (∀ y ∈ 𝔪, ∃ c₁ c₂ : K, y - (κ c₁ * u + κ c₂ * v) ∈ 𝔪 ^ 2) → (∀ c₁ c₂ : K, κ c₁ * u + κ c₂ * v ∈ 𝔪 ^ 2 → c₁ = 0 ∧ c₂ = 0) → wcpaLqHilb K R ((algebraMap B R).comp κ) ∧ wcpaLqBasis K R ((algebraMap B R).comp κ) (algebraMap B R u) (algebraMap B R v) ∧ algebraMap B R u * algebraMap B R v ∈ IsLocalRing.maximalIdeal R ^ 3 :=
by
  intro K B R _ _ _ _ _ κ 𝔪 hψ hHB u v hu hv huv hspan hind
  have mt : ∀ (j : ℕ) (b : B),
      algebraMap B R b ∈ IsLocalRing.maximalIdeal R ^ j ↔ b ∈ 𝔪 ^ j := by
    intro j b
    obtain ⟨ψ, hψj⟩ := hψ j
    rw [← Ideal.Quotient.eq_zero_iff_mem, ← hψj, RingEquiv.map_eq_zero_iff,
      Ideal.Quotient.eq_zero_iff_mem]
  have mt1 : ∀ b : B, algebraMap B R b ∈ IsLocalRing.maximalIdeal R ↔ b ∈ 𝔪 := by
    intro b
    have h := mt 1 b
    rw [pow_one, pow_one] at h
    exact h
  refine ⟨?_, ⟨(mt1 u).mpr hu, (mt1 v).mpr hv, ?_, ?_⟩, ?_⟩
  · unfold wcpaLqHilb
    intro n hn
    letI : Algebra K B := κ.toAlgebra
    letI : Algebra K R := ((algebraMap B R).comp κ).toAlgebra
    obtain ⟨ψ, hψn⟩ := hψ n
    have compat : ∀ c : K, ψ (algebraMap K (B ⧸ 𝔪 ^ n) c) =
        algebraMap K (R ⧸ IsLocalRing.maximalIdeal R ^ n) c := by
      intro c
      exact hψn (κ c)
    let e := AlgEquiv.ofRingEquiv (f := ψ) compat
    exact (e.toLinearEquiv.finrank_eq).symm.trans (hHB n hn)
  · intro y hy
    obtain ⟨ψ, hψ2⟩ := hψ 2
    obtain ⟨x, hx⟩ := ψ.surjective (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ 2) y)
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective x
    rw [hψ2] at hx
    have hyb : y - algebraMap B R b ∈ IsLocalRing.maximalIdeal R ^ 2 :=
      (Ideal.Quotient.mk_eq_mk_iff_sub_mem y (algebraMap B R b)).mp hx.symm
    have hb : b ∈ 𝔪 := by
      apply (mt1 b).mp
      have e1 : algebraMap B R b = y - (y - algebraMap B R b) := by ring
      rw [e1]
      exact Ideal.sub_mem _ hy (Ideal.pow_le_self two_ne_zero hyb)
    obtain ⟨c₁, c₂, hc⟩ := hspan b hb
    have hd := (mt 2 _).mpr hc
    refine ⟨c₁, c₂, ?_⟩
    have e2 : y - ((algebraMap B R).comp κ c₁ * algebraMap B R u +
        (algebraMap B R).comp κ c₂ * algebraMap B R v) =
        (y - algebraMap B R b) + algebraMap B R (b - (κ c₁ * u + κ c₂ * v)) := by
      simp only [RingHom.comp_apply, map_sub, map_add, map_mul]
      ring
    rw [e2]
    exact Ideal.add_mem _ hyb hd
  · intro c₁ c₂ h
    apply hind
    rw [← mt 2]
    simpa only [RingHom.comp_apply, map_add, map_mul] using h
  · rw [← map_mul]
    exact (mt 3 _).mpr huv

theorem wcpa_cl_ps_node_algebra : ∀ (K A B R : Type u) [Field K] [CommRing A] [CommRing B] [CommRing R] [Algebra B R] [IsLocalRing R] [IsNoetherianRing R] (κ : K →+* B) (κA : K →+* A) (ι : B →+* A) (m : ℕ) (s : Fin m × Fin 2 → (A →+* K)) (e₀ : Fin m) [(RingHom.ker ((s (e₀, 0)).comp ι)).IsPrime], Function.Injective ι → (∀ g : A, (∃ b, ι b = g) ↔ ∀ e, s (e, 0) g = s (e, 1) g) → ι.comp κ = κA → (∀ a (c : K), s a (κA c) = c) → (∀ a b, a ≠ b → RingHom.ker (s a) ⊔ RingHom.ker (s b) = ⊤) → (∀ (i : Fin 2) (n : ℕ), letI : Algebra K A := κA.toAlgebra; Module.finrank K (A ⧸ RingHom.ker (s (e₀, i)) ^ n) = n) → IsLocalization.AtPrime R (RingHom.ker ((s (e₀, 0)).comp ι)) → ∃ e : AdicCompletion (IsLocalRing.maximalIdeal R) R ≃+* (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), e.toRingHom.comp ((algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)).comp ((algebraMap B R).comp κ)) = (Ideal.Quotient.mk _).comp MvPowerSeries.C :=
by
  intro K A B R _ _ _ _ _ _ _ κ κA ι m s e₀ _ hinj hEq hκ hsκ hcomax hfin hloc
  classical

  have hsurj : Function.Surjective ((s (e₀, 0)).comp ι) := by
    intro c
    refine ⟨κ c, ?_⟩
    rw [RingHom.comp_apply, ← RingHom.comp_apply ι κ, hκ, hsκ]
  haveI hmax : (RingHom.ker ((s (e₀, 0)).comp ι)).IsMaximal :=
    RingHom.ker_isMaximal_of_surjective _ hsurj

  have hPI : ∀ (n : ℕ) (b : B), ι b ∈ RingHom.ker (s (e₀, 0)) ^ n ⊓ RingHom.ker (s (e₀, 1)) ^ n ↔
      b ∈ RingHom.ker ((s (e₀, 0)).comp ι) ^ n := by
    obtain ⟨h, hh⟩ := wcpa_clbc_crt_elements A K s hcomax
    set k : A := h (e₀, 0) + h (e₀, 1) with hk
    have hsk : ∀ (e : Fin m) (i : Fin 2), s (e, i) k = if e = e₀ then 1 else 0 := by
      intro e i
      rw [hk, map_add, hh, hh]
      by_cases he : e = e₀
      · subst he
        fin_cases i <;> simp
      · simp [Prod.ext_iff, he]
    obtain ⟨kB, hkB⟩ := (hEq k).mpr (fun e => by rw [hsk, hsk])
    have hkB1 : 1 - kB ∈ RingHom.ker ((s (e₀, 0)).comp ι) := by
      rw [RingHom.mem_ker, RingHom.comp_apply, map_sub, map_one, hkB, map_sub, map_one, hsk]
      simp

    have hc : ∀ g : A, (∀ a, s a g = 0) → ∃ z ∈ RingHom.ker ((s (e₀, 0)).comp ι), ι z = g := by
      intro g hg
      obtain ⟨z, hz⟩ := (hEq g).mpr (fun e => by rw [hg, hg])
      refine ⟨z, ?_, hz⟩
      rw [RingHom.mem_ker, RingHom.comp_apply, hz, hg]

    have hm01 : ∀ b ∈ RingHom.ker ((s (e₀, 0)).comp ι),
        ι b ∈ RingHom.ker (s (e₀, 0)) ⊓ RingHom.ker (s (e₀, 1)) := by
      intro b hb
      rw [RingHom.mem_ker, RingHom.comp_apply] at hb
      have h1 := (hEq (ι b)).mp ⟨b, rfl⟩ e₀
      exact ⟨RingHom.mem_ker.mpr hb, RingHom.mem_ker.mpr (by rw [← h1, hb])⟩
    have hcop : RingHom.ker (s (e₀, 0)) ⊔ RingHom.ker (s (e₀, 1)) = ⊤ :=
      hcomax _ _ (by simp [Prod.ext_iff])

    have hbase : ∀ x ∈ RingHom.ker (s (e₀, 0)) ⊓ RingHom.ker (s (e₀, 1)), ∀ a : A,
        ∃ z ∈ RingHom.ker ((s (e₀, 0)).comp ι), ι z = k * a * x := by
      intro x hx a
      obtain ⟨hx0, hx1⟩ := hx
      replace hx0 : s (e₀, 0) x = 0 := RingHom.mem_ker.mp hx0
      replace hx1 : s (e₀, 1) x = 0 := RingHom.mem_ker.mp hx1
      apply hc
      rintro ⟨e, i⟩
      rw [map_mul, map_mul, hsk]
      by_cases he : e = e₀
      · subst he
        fin_cases i
        · simp [hx0]
        · simp [hx1]
      · simp [he]

    have habs : ∀ n : ℕ, ∀ g ∈ (RingHom.ker (s (e₀, 0)) ⊓ RingHom.ker (s (e₀, 1))) ^ (n + 1),
        ∀ a : A, ∃ z ∈ RingHom.ker ((s (e₀, 0)).comp ι) ^ (n + 1), ι z = k ^ (n + 1) * a * g := by
      intro n
      induction n with
      | zero =>
        intro g hg a
        rw [zero_add, pow_one] at hg ⊢
        obtain ⟨z, hz, hz'⟩ := hbase g hg a
        exact ⟨z, hz, by rw [hz', pow_one]⟩
      | succ n ih =>
        let T : Ideal A :=
          { carrier := {g | ∀ a : A, ∃ z ∈ RingHom.ker ((s (e₀, 0)).comp ι) ^ (n + 1 + 1),
              ι z = k ^ (n + 1 + 1) * a * g}
            add_mem' := by
              intro g g' hg hg'
              simp only [Set.mem_setOf_eq] at hg hg' ⊢
              intro a
              obtain ⟨z, hz, hz'⟩ := hg a
              obtain ⟨z', hz2, hz2'⟩ := hg' a
              exact ⟨z + z', Ideal.add_mem _ hz hz2, by rw [map_add, hz', hz2']; ring⟩
            zero_mem' := by
              simp only [Set.mem_setOf_eq]
              intro a
              exact ⟨0, Ideal.zero_mem _, by simp⟩
            smul_mem' := by
              intro c g hg
              simp only [Set.mem_setOf_eq] at hg ⊢
              intro a
              obtain ⟨z, hz, hz'⟩ := hg (a * c)
              exact ⟨z, hz, by rw [hz', smul_eq_mul]; ring⟩ }
        have hle : (RingHom.ker (s (e₀, 0)) ⊓ RingHom.ker (s (e₀, 1))) ^ (n + 1 + 1) ≤ T := by
          rw [pow_succ]
          apply Ideal.mul_le.mpr
          intro y hy x hx
          show ∀ a : A, ∃ z ∈ RingHom.ker ((s (e₀, 0)).comp ι) ^ (n + 1 + 1),
              ι z = k ^ (n + 1 + 1) * a * (y * x)
          intro a
          obtain ⟨z₁, hz₁, hz₁'⟩ := hbase x hx a
          obtain ⟨z₂, hz₂, hz₂'⟩ := ih y hy 1
          refine ⟨z₁ * z₂, ?_, ?_⟩
          · rw [pow_succ' (RingHom.ker ((s (e₀, 0)).comp ι)) (n + 1)]
            exact Ideal.mul_mem_mul hz₁ hz₂
          · rw [map_mul, hz₁', hz₂']
            ring
        intro g hg a
        exact hle hg a
    intro n b
    constructor
    · intro hb
      rcases n with _ | n
      · simp
      ·
        have hcopn : IsCoprime (RingHom.ker (s (e₀, 0)) ^ (n + 1))
            (RingHom.ker (s (e₀, 1)) ^ (n + 1)) :=
          (Ideal.isCoprime_iff_sup_eq.mpr hcop).pow
        have hinf : RingHom.ker (s (e₀, 0)) ^ (n + 1) ⊓ RingHom.ker (s (e₀, 1)) ^ (n + 1) ≤
            (RingHom.ker (s (e₀, 0)) ⊓ RingHom.ker (s (e₀, 1))) ^ (n + 1) := by
          rw [← Ideal.mul_eq_inf_of_coprime (Ideal.isCoprime_iff_sup_eq.mp hcopn), ← mul_pow]
          exact Ideal.pow_right_mono Ideal.mul_le_inf _
        obtain ⟨z, hz, hz'⟩ := habs n (ι b) (hinf hb) 1
        have hzb : z = kB ^ (n + 1) * b := by
          apply hinj
          rw [hz', map_mul, map_pow, hkB, mul_one]
        rw [hzb] at hz
        have h1k : (1 - kB) ^ (n + 1) ∈ RingHom.ker ((s (e₀, 0)).comp ι) ^ (n + 1) :=
          Ideal.pow_mem_pow hkB1 _
        obtain ⟨α, β, hαβ⟩ : IsCoprime (kB ^ (n + 1)) ((1 - kB) ^ (n + 1)) :=
          (show IsCoprime kB (1 - kB) from ⟨1, 1, by ring⟩).pow
        have hbeq : b = α * (kB ^ (n + 1) * b) + (β * b) * (1 - kB) ^ (n + 1) := by
          linear_combination (-b) * hαβ
        rw [hbeq]
        exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hz) (Ideal.mul_mem_left _ _ h1k)
    · intro hb
      have hmap : Ideal.map ι (RingHom.ker ((s (e₀, 0)).comp ι)) ≤
          RingHom.ker (s (e₀, 0)) ⊓ RingHom.ker (s (e₀, 1)) :=
        Ideal.map_le_iff_le_comap.mpr (fun b hb => hm01 b hb)
      have h1 : ι b ∈ (Ideal.map ι (RingHom.ker ((s (e₀, 0)).comp ι))) ^ n := by
        rw [← Ideal.map_pow]
        exact Ideal.mem_map_of_mem ι hb
      have h2 := Ideal.pow_right_mono hmap n h1
      exact ⟨Ideal.pow_right_mono inf_le_left n h2, Ideal.pow_right_mono inf_le_right n h2⟩

  have hHB := wcpa_cl_na_hilbert K A B κ κA ι m s e₀ hEq hκ hsκ hcomax hfin hPI
  obtain ⟨u, v, hu, hv, huv, hspan, hind⟩ :=
    wcpa_cl_na_cotangent K A B κ κA ι m s e₀ hEq hκ hsκ hcomax hfin hPI

  have hψ : ∀ n : ℕ, ∃ ψ : B ⧸ RingHom.ker ((s (e₀, 0)).comp ι) ^ n ≃+*
      R ⧸ IsLocalRing.maximalIdeal R ^ n, ∀ b : B,
        ψ (Ideal.Quotient.mk _ b) = Ideal.Quotient.mk _ (algebraMap B R b) := by
    intro n
    exact wcpa_cl_na_loc_quot B R (RingHom.ker ((s (e₀, 0)).comp ι)) n

  obtain ⟨hHilb, hBasis, hprod⟩ :=
    wcpa_cl_na_transfer K B R κ (RingHom.ker ((s (e₀, 0)).comp ι)) hψ hHB u v hu hv huv hspan hind

  obtain ⟨f, hord, e₁, he₁⟩ := wcpa_dj_lq_completion_presentation K R ((algebraMap B R).comp κ)
    hHilb (algebraMap B R u) (algebraMap B R v) hBasis 0 1 0 (Or.inr (Or.inl one_ne_zero))
    (by simp only [map_zero, map_one, zero_mul, one_mul, zero_add, add_zero]; exact hprod)
  have hq : wcpaBscQuad K 0 1 0 = MvPowerSeries.X 0 * MvPowerSeries.X 1 := by
    simp [wcpaBscQuad]
  rw [hq] at hord

  obtain ⟨e₂, he₂⟩ := wcpa_dj_ssp_bw_hensel_node K f hord
  refine ⟨e₁.trans e₂, ?_⟩
  rw [RingEquiv.toRingHom_trans, RingHom.comp_assoc, he₁, he₂]

theorem wcpa_cl_pinch_semistable : ∀ (R : Type u) [CommRing R] {Zt Z : Scheme.{u}}
    (ut : Zt ⟶ Spec (.of R)) (uu : Z ⟶ Spec (.of R)) (m : ℕ)
    (σ : Fin m × Fin 2 → (Spec (.of R) ⟶ Zt)) (π : Zt ⟶ Z) (O U : Zt.Opens) (V O' : Z.Opens),
    wcpaClPinch ut uu m σ π O U V O' →
    (∀ (a b : Fin m × Fin 2) (p q : ↥(Spec (.of R))), a ≠ b → σ a p ≠ σ b q) →
    wcpaDjSemistable ut →
    (∀ a (p : ↥(Spec (.of R))), ∃ U' : Zt.Opens, σ a p ∈ U' ∧
      SmoothOfRelativeDimension 1 (U'.ι ≫ ut)) →
    Flat uu → IsProper uu → wcpaDjSemistable uu :=
by
  intro R _ Zt Z ut uu m σ π O U V O' hD hdisj hsst hsm hfl hpr
  have pt : ∀ {A B C : Scheme.{u}} {a : A ⟶ B} {b : B ⟶ C} {c : A ⟶ C}, a ≫ b = c →
      ∀ x, b (a x) = c x := by
    intro A B C a b c h x
    rw [← Scheme.Hom.comp_apply, h]
  have cong : ∀ {X Y : Scheme.{u}} {f g : X ⟶ Y}, f = g → ∀ (U : Y.Opens) (V : X.Opens)
      (e : V ≤ f ⁻¹ᵁ U) (e' : V ≤ g ⁻¹ᵁ U), f.appLE U V e = g.appLE U V e' := by
    rintro X Y f g rfl U V e e'
    rfl
  have idtop : ∀ (X : Scheme.{u}) (e : (⊤ : X.Opens) ≤ (𝟙 X : X ⟶ X) ⁻¹ᵁ ⊤),
      Scheme.Hom.appLE (𝟙 X) ⊤ ⊤ e = 𝟙 _ := by
    intro X e
    simp only [Scheme.Hom.appLE, Scheme.Hom.id_app, Category.id_comp]
    rw [show (homOfLE e).op = 𝟙 (Opposite.op (⊤ : X.Opens)) from Subsingleton.elim _ _]
    exact (Category.id_comp _).trans (X.presheaf.map_id _)
  haveI : IsProper ut := hsst.2.1
  haveI : IsProper uu := hpr
  refine ⟨hfl, hpr, ?_⟩
  intro K _ _ s w

  obtain ⟨f, rfl⟩ := Spec.map_surjective s
  obtain ⟨φ, rfl⟩ : ∃ φ : R →+* K, f = CommRingCat.ofHom φ :=
    ⟨f.hom, (CommRingCat.ofHom_hom f).symm⟩

  obtain ⟨σ', π', hD', hdisj', hσ'f, hπ'f⟩ :=
    wcpa_cl_pinch_basechange R K φ ut uu m σ π O U V O' hD hdisj
  generalize Spec.map (CommRingCat.ofHom φ) = b at σ' π' hD' hdisj' hσ'f hπ'f w ⊢
  have hΓinj : Function.Injective (Scheme.ΓSpecIso (.of K)).hom.hom :=
    (Scheme.ΓSpecIso (.of K)).commRingCatIsoToRingEquiv.injective

  have hsm' : ∀ a, ∃ W : (Limits.pullback ut b).Opens, σ' a (IsLocalRing.closedPoint K) ∈ W ∧
      SmoothOfRelativeDimension 1 (W.ι ≫ Limits.pullback.snd ut b) := by
    intro a
    obtain ⟨U'', hU'', hU''sm⟩ := hsm a (b (IsLocalRing.closedPoint K))
    refine ⟨Limits.pullback.fst ut b ⁻¹ᵁ U'', ?_, ?_⟩
    · change (σ' a ≫ Limits.pullback.fst ut b) (IsLocalRing.closedPoint K) ∈ U''
      rw [hσ'f a]
      exact hU''
    · have h1 := isPullback_morphismRestrict (Limits.pullback.fst ut b) U''
      have h2 := h1.paste_vert (IsPullback.of_hasPullback ut b)
      exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) h2 hU''sm

  obtain ⟨_, hsurj, _⟩ := wcpa_cl_pinch_points K (Limits.pullback.snd ut b)
    (Limits.pullback.snd uu b) m σ' π' _ _ _ _ hD' hdisj' inferInstance
  obtain ⟨hπu', hσu', hσπ', hO', hUaff', hVaff', hrange', hVO', ⟨hOO', hOiso'⟩,
    ⟨hUU', hinj', himg'⟩⟩ := hD'
  by_cases hw : w ∈ Limits.pullback.fst uu b ⁻¹ᵁ O'
  ·
    haveI := hOiso'
    let Φ := asIso (π'.resLE (Limits.pullback.fst uu b ⁻¹ᵁ O') (Limits.pullback.fst ut b ⁻¹ᵁ O)
      hOO'.ge)
    have hc : π'.resLE (Limits.pullback.fst uu b ⁻¹ᵁ O') (Limits.pullback.fst ut b ⁻¹ᵁ O)
        hOO'.ge ≫ (Limits.pullback.fst uu b ⁻¹ᵁ O').ι =
        (Limits.pullback.fst ut b ⁻¹ᵁ O).ι ≫ π' := Scheme.Hom.resLE_comp_ι π' hOO'.ge
    have compat : Φ.symm.hom ≫ (Limits.pullback.fst ut b ⁻¹ᵁ O).ι ≫ Limits.pullback.snd ut b =
        (Limits.pullback.fst uu b ⁻¹ᵁ O').ι ≫ Limits.pullback.snd uu b := by
      rw [← hπu', ← Category.assoc (Limits.pullback.fst ut b ⁻¹ᵁ O).ι π', ← hc]
      simp only [Φ, Iso.symm_hom, asIso_inv, Category.assoc, IsIso.inv_hom_id_assoc]
    have i1 := hsst.2.2 K b ((Limits.pullback.fst ut b ⁻¹ᵁ O).ι (Φ.inv ⟨w, hw⟩))
    have i2 := (wcpa_cl_ps_open_ns_iff K (Limits.pullback.fst ut b ⁻¹ᵁ O).ι
      (Limits.pullback.snd ut b) (Φ.inv ⟨w, hw⟩)).mp i1
    have i3 := wcpa_dj_ssp_bw_ns_transport K Φ.symm
      ((Limits.pullback.fst uu b ⁻¹ᵁ O').ι ≫ Limits.pullback.snd uu b)
      ((Limits.pullback.fst ut b ⁻¹ᵁ O).ι ≫ Limits.pullback.snd ut b) compat ⟨w, hw⟩ i2
    exact (wcpa_cl_ps_open_ns_iff K (Limits.pullback.fst uu b ⁻¹ᵁ O').ι
      (Limits.pullback.snd uu b) ⟨w, hw⟩).mpr i3
  ·
    have hwV : w ∈ Limits.pullback.fst uu b ⁻¹ᵁ V := by
      have h1 : w ∈ Limits.pullback.fst uu b ⁻¹ᵁ V ⊔ Limits.pullback.fst uu b ⁻¹ᵁ O' := by
        rw [hVO']; simp
      rcases TopologicalSpace.Opens.mem_sup.mp h1 with h | h
      · exact h
      · exact absurd h hw
    haveI := hsurj
    obtain ⟨x, hx⟩ := π'.surjective w
    have hxO : x ∉ Limits.pullback.fst ut b ⁻¹ᵁ O := by
      intro hx'
      apply hw
      rw [← hOO'] at hx'
      rw [← hx]
      exact hx'
    have hex : ¬ ∀ a, x ∉ Set.range (σ' a) := fun h => hxO ((hO' x).mpr h)
    push_neg at hex
    obtain ⟨⟨e₀, i⟩, p, hp⟩ := hex
    have hσπ'' : ∀ i : Fin 2, σ' (e₀, i) ≫ π' = σ' (e₀, 0) ≫ π' := by
      intro i
      fin_cases i
      · rfl
      · exact (hσπ' e₀).symm
    have hp' : p = IsLocalRing.closedPoint K := Subsingleton.elim _ _
    have hwy : w = (σ' (e₀, 0) ≫ π') (IsLocalRing.closedPoint K) := by
      rw [← hx, ← hp, hp']
      exact pt (hσπ'' i) _
    subst hwy

    have hσ'U : ∀ a, (⊤ : (Spec (.of K)).Opens) ≤ σ' a ⁻¹ᵁ (Limits.pullback.fst ut b ⁻¹ᵁ U) :=
      fun a p _ => hrange' a ⟨p, rfl⟩
    have hyU : (⊤ : (Spec (.of K)).Opens) ≤
        (σ' (e₀, 0) ≫ π') ⁻¹ᵁ (Limits.pullback.fst uu b ⁻¹ᵁ V) := by
      intro q _
      have hq : q = IsLocalRing.closedPoint K := Subsingleton.elim _ _
      rw [hq]
      exact hwV
    obtain ⟨sK, hsK⟩ : ∃ sK : Fin m × Fin 2 →
        (Γ(Limits.pullback ut b, Limits.pullback.fst ut b ⁻¹ᵁ U) →+* K),
        ∀ a, sK a = (Scheme.ΓSpecIso (.of K)).hom.hom.comp ((σ' a).appLE _ ⊤ (hσ'U a)).hom :=
      ⟨_, fun a => rfl⟩
    have hker : ∀ a, RingHom.ker (sK a) = RingHom.ker ((σ' a).appLE _ ⊤ (hσ'U a)).hom := by
      intro a
      rw [hsK]
      exact RingHom.ker_comp_of_injective _ hΓinj

    have hEq : ∀ g, (∃ f, (π'.appLE _ _ hUU'.ge).hom f = g) ↔
        ∀ e, sK (e, 0) g = sK (e, 1) g := by
      intro g
      refine (himg' g).trans ⟨fun h e => ?_, fun h e h₀ h₁ => ?_⟩
      · rw [hsK, hsK, RingHom.comp_apply, RingHom.comp_apply, h e (hσ'U _) (hσ'U _)]
      · have h2 := h e
        rw [hsK, hsK, RingHom.comp_apply, RingHom.comp_apply] at h2
        exact hΓinj h2
    have hκ0 : (Limits.pullback.snd uu b).appLE ⊤ (Limits.pullback.fst uu b ⁻¹ᵁ V) le_top ≫
        π'.appLE _ _ hUU'.ge =
        (Limits.pullback.snd ut b).appLE ⊤ (Limits.pullback.fst ut b ⁻¹ᵁ U) le_top :=
      (Scheme.Hom.appLE_comp_appLE _ _ _ _ _ _ _).trans (cong hπu' _ _ _ _)
    have hκ : (π'.appLE _ _ hUU'.ge).hom.comp ((Scheme.ΓSpecIso (.of K)).inv ≫
        (Limits.pullback.snd uu b).appLE ⊤ (Limits.pullback.fst uu b ⁻¹ᵁ V) le_top).hom =
        ((Scheme.ΓSpecIso (.of K)).inv ≫
          (Limits.pullback.snd ut b).appLE ⊤ (Limits.pullback.fst ut b ⁻¹ᵁ U) le_top).hom := by
      refine RingHom.ext fun c => ?_
      exact congrArg (fun f => CommRingCat.Hom.hom f
        ((Scheme.ΓSpecIso (.of K)).inv.hom c)) hκ0
    have hsκ : ∀ a (c : K), sK a (((Scheme.ΓSpecIso (.of K)).inv ≫
        (Limits.pullback.snd ut b).appLE ⊤ (Limits.pullback.fst ut b ⁻¹ᵁ U) le_top).hom c) = c := by
      intro a c
      have h1' : (Limits.pullback.snd ut b).appLE ⊤ (Limits.pullback.fst ut b ⁻¹ᵁ U) le_top ≫
          (σ' a).appLE _ ⊤ (hσ'U a) = 𝟙 _ :=
        ((Scheme.Hom.appLE_comp_appLE _ _ _ _ _ _ _).trans
          (cong (hσu' a) ⊤ ⊤ _ (fun _ _ => trivial))).trans (idtop _ _)
      have h2 : ∀ z, ((σ' a).appLE _ ⊤ (hσ'U a)).hom
          (((Limits.pullback.snd ut b).appLE ⊤ (Limits.pullback.fst ut b ⁻¹ᵁ U) le_top).hom z) =
          z := fun z => congrArg (fun f => CommRingCat.Hom.hom f z) h1'
      have h3 : ∀ z : K, (Scheme.ΓSpecIso (.of K)).hom.hom ((Scheme.ΓSpecIso (.of K)).inv.hom z) =
          z := fun z => congrArg (fun f => CommRingCat.Hom.hom f z)
            (Iso.inv_hom_id (Scheme.ΓSpecIso (.of K)))
      rw [hsK]
      show (Scheme.ΓSpecIso (.of K)).hom.hom (((σ' a).appLE _ ⊤ (hσ'U a)).hom
          (((Limits.pullback.snd ut b).appLE ⊤ (Limits.pullback.fst ut b ⁻¹ᵁ U) le_top).hom
            ((Scheme.ΓSpecIso (.of K)).inv.hom c))) = c
      rw [h2, h3]
    have hcomax : ∀ a a', a ≠ a' → RingHom.ker (sK a) ⊔ RingHom.ker (sK a') = ⊤ := by
      intro a a' haa'
      rw [hker, hker]
      exact wcpa_clbc_kernels_comaximal K (Limits.pullback.snd ut b) m σ' _ hUaff' hσu' hdisj'
        a a' (hσ'U a) (hσ'U a') haa'
    have hfin : ∀ (i : Fin 2) (n : ℕ),
        letI : Algebra K Γ(Limits.pullback ut b, Limits.pullback.fst ut b ⁻¹ᵁ U) :=
          ((Scheme.ΓSpecIso (.of K)).inv ≫
            (Limits.pullback.snd ut b).appLE ⊤ (Limits.pullback.fst ut b ⁻¹ᵁ U) le_top).hom.toAlgebra
        Module.finrank K (Γ(Limits.pullback ut b, Limits.pullback.fst ut b ⁻¹ᵁ U) ⧸
          RingHom.ker (sK (e₀, i)) ^ n) = n := by
      intro i n
      obtain ⟨W, hW, hWsm⟩ := hsm' (e₀, i)
      rw [hker]
      exact wcpa_cl_ps_smooth_hilbert K _ (Limits.pullback.snd ut b) (σ' (e₀, i)) W _ (hσu' _)
        hW hWsm hUaff' (hσ'U _) n
    have hprime : (hVaff'.primeIdealOf ⟨_, hwV⟩).asIdeal =
        RingHom.ker ((sK (e₀, 0)).comp (π'.appLE _ _ hUU'.ge).hom) := by
      rw [wcpa_cl_ps_point_prime K _ _ hVaff' (σ' (e₀, 0) ≫ π') hyU hwV, hsK, RingHom.comp_assoc,
        RingHom.ker_comp_of_injective _ hΓinj, ← CommRingCat.hom_comp,
        Scheme.Hom.appLE_comp_appLE]
    letI : Algebra Γ(Limits.pullback uu b, Limits.pullback.fst uu b ⁻¹ᵁ V)
        ((Limits.pullback uu b).presheaf.stalk ((σ' (e₀, 0) ≫ π') (IsLocalRing.closedPoint K))) :=
      TopCat.Presheaf.algebra_section_stalk (Limits.pullback uu b).presheaf ⟨_, hwV⟩
    haveI : (RingHom.ker ((sK (e₀, 0)).comp (π'.appLE _ _ hUU'.ge).hom)).IsPrime :=
      RingHom.ker_isPrime _
    have hloc : IsLocalization.AtPrime
        ((Limits.pullback uu b).presheaf.stalk ((σ' (e₀, 0) ≫ π') (IsLocalRing.closedPoint K)))
        (RingHom.ker ((sK (e₀, 0)).comp (π'.appLE _ _ hUU'.ge).hom)) := by
      have h0 := hVaff'.isLocalization_stalk ⟨_, hwV⟩
      have hsub : (RingHom.ker ((sK (e₀, 0)).comp (π'.appLE _ _ hUU'.ge).hom)).primeCompl =
          (hVaff'.primeIdealOf ⟨_, hwV⟩).asIdeal.primeCompl := by
        ext z
        rw [Ideal.mem_primeCompl_iff, Ideal.mem_primeCompl_iff, hprime]
      show IsLocalization (RingHom.ker _).primeCompl _
      rw [hsub]
      exact h0
    haveI : IsLocallyNoetherian (Limits.pullback uu b) :=
      LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd uu b)
    obtain ⟨e, he⟩ := wcpa_cl_ps_node_algebra K _ _
      ((Limits.pullback uu b).presheaf.stalk ((σ' (e₀, 0) ≫ π') (IsLocalRing.closedPoint K)))
      ((Scheme.ΓSpecIso (.of K)).inv ≫
        (Limits.pullback.snd uu b).appLE ⊤ (Limits.pullback.fst uu b ⁻¹ᵁ V) le_top).hom
      ((Scheme.ΓSpecIso (.of K)).inv ≫
        (Limits.pullback.snd ut b).appLE ⊤ (Limits.pullback.fst ut b ⁻¹ᵁ U) le_top).hom
      (π'.appLE _ _ hUU'.ge).hom m sK e₀ hinj' hEq hκ hsκ hcomax hfin hloc
    have hK : (algebraMap Γ(Limits.pullback uu b, Limits.pullback.fst uu b ⁻¹ᵁ V)
        ((Limits.pullback uu b).presheaf.stalk
          ((σ' (e₀, 0) ≫ π') (IsLocalRing.closedPoint K)))).comp
        ((Scheme.ΓSpecIso (.of K)).inv ≫
          (Limits.pullback.snd uu b).appLE ⊤ (Limits.pullback.fst uu b ⁻¹ᵁ V) le_top).hom =
        ((Scheme.ΓSpecIso (.of K)).inv ≫ (Limits.pullback.snd uu b).appTop ≫
          (Limits.pullback uu b).presheaf.germ ⊤
            ((σ' (e₀, 0) ≫ π') (IsLocalRing.closedPoint K)) trivial).hom := by
      rw [← TopCat.Presheaf.germ_res (Limits.pullback uu b).presheaf (homOfLE le_top) _ hwV]
      rfl
    rw [hK] at he
    exact Or.inr ⟨e, he⟩

theorem wcpa_cl_pinch_sections : ∀ (R : Type u) [CommRing R] {Zt Z : Scheme.{u}}
    (ut : Zt ⟶ Spec (.of R)) (uu : Z ⟶ Spec (.of R)) (m : ℕ)
    (σ : Fin m × Fin 2 → (Spec (.of R) ⟶ Zt)) (π : Zt ⟶ Z) (O U : Zt.Opens) (V O' : Z.Opens),
    wcpaClPinch ut uu m σ π O U V O' →
    ∀ (n : ℕ) (μ : Fin n → (Spec (.of R) ⟶ Zt)), (∀ i, μ i ≫ ut = 𝟙 _) →
    (∀ (i j : Fin n) (p q : ↥(Spec (.of R))), i ≠ j → μ i p ≠ μ j q) →
    (∀ (i : Fin n) (a : Fin m × Fin 2) (p q : ↥(Spec (.of R))), μ i p ≠ σ a q) →
    (∀ (i : Fin n) (p : ↥(Spec (.of R))), ∃ U' : Zt.Opens, μ i p ∈ U' ∧
      SmoothOfRelativeDimension 1 (U'.ι ≫ ut)) →
    wcpaDjSections uu n (fun i => μ i ≫ π) :=
by
  intro R _ Zt Z ut uu m σ π O U V O' hD n μ hμs hμd hμσ hμsm
  obtain ⟨hπu, -, -, hO, -, -, -, -, ⟨hOO, hiso⟩, -⟩ := hD
  set ρ := π.resLE O' O hOO.ge with hρ
  have : IsIso ρ := hiso
  have hEρ : ρ ≫ O'.ι = O.ι ≫ π := Scheme.Hom.resLE_comp_ι _ _
  have hmO : ∀ i p, μ i p ∈ O := by
    intro i p
    refine (hO (μ i p)).mpr ?_
    rintro a ⟨q, hq⟩
    exact hμσ i a p q hq.symm
  have hval : ∀ y : (O : Scheme.{u}), O'.ι (ρ y) = π (O.ι y) := by
    intro y
    rw [← Scheme.Hom.comp_apply, hEρ, Scheme.Hom.comp_apply]
  have hpt : ∀ i p, ∃ y : (O : Scheme.{u}), O.ι y = μ i p := by
    intro i p
    exact Set.mem_range.mp (by rw [Scheme.Opens.range_ι]; exact hmO i p)
  refine ⟨?_, ?_, ?_⟩
  · intro j
    show (μ j ≫ π) ≫ uu = 𝟙 _
    rw [Category.assoc, hπu, hμs j]
  · intro i j p q hij heq
    have heq' : π (μ i p) = π (μ j q) := by
      simpa only [Scheme.Hom.comp_apply] using heq
    apply hμd i j p q hij
    obtain ⟨y1, hy1⟩ := hpt i p
    obtain ⟨y2, hy2⟩ := hpt j q
    have h2 : O'.ι (ρ y1) = O'.ι (ρ y2) := by
      rw [hval, hval, hy1, hy2, heq']
    have h3 : y1 = y2 := ρ.isOpenEmbedding.injective (O'.ι.isOpenEmbedding.injective h2)
    rw [← hy1, ← hy2, h3]
  · intro j p
    obtain ⟨U', hU'mem, hU'sm⟩ := hμsm j p
    have := hU'sm
    obtain ⟨y, hyx⟩ := hpt j p
    refine ⟨O'.ι ''ᵁ ((inv ρ ≫ O.ι) ⁻¹ᵁ U'), ?_, ?_⟩
    · have hinv : (inv ρ) (ρ y) = y := by
        rw [← Scheme.Hom.comp_apply, IsIso.hom_inv_id]
        rfl
      have hy : ρ y ∈ (inv ρ ≫ O.ι) ⁻¹ᵁ U' := by
        rw [Scheme.Hom.mem_preimage, Scheme.Hom.comp_apply, hinv, hyx]
        exact hU'mem
      have e : O'.ι (ρ y) = (μ j ≫ π) p := by
        rw [hval, hyx, Scheme.Hom.comp_apply]
      show (μ j ≫ π) p ∈ O'.ι ''ᵁ ((inv ρ ≫ O.ι) ⁻¹ᵁ U')
      rw [← e]
      show _ ∈ ((O'.ι ''ᵁ ((inv ρ ≫ O.ι) ⁻¹ᵁ U') : Z.Opens) : Set Z)
      rw [Scheme.Hom.coe_image]
      exact Set.mem_image_of_mem _ hy
    · have ha : (O'.ι.isoImage ((inv ρ ≫ O.ι) ⁻¹ᵁ U')).inv ≫ ((inv ρ ≫ O.ι) ⁻¹ᵁ U').ι ≫ O'.ι =
          (O'.ι ''ᵁ ((inv ρ ≫ O.ι) ⁻¹ᵁ U')).ι := Scheme.Hom.isoImage_inv_ι _ _
      have hb : O'.ι ≫ uu = (inv ρ ≫ O.ι) ≫ ut := by
        rw [← hπu]
        simp only [Category.assoc]
        rw [← Category.assoc O.ι π uu, ← hEρ]
        simp only [Category.assoc, IsIso.inv_hom_id_assoc]
      have hc : ((inv ρ ≫ O.ι) ∣_ U') ≫ U'.ι = ((inv ρ ≫ O.ι) ⁻¹ᵁ U').ι ≫ (inv ρ ≫ O.ι) :=
        morphismRestrict_ι _ _
      have hfac : (O'.ι ''ᵁ ((inv ρ ≫ O.ι) ⁻¹ᵁ U')).ι ≫ uu =
          ((O'.ι.isoImage ((inv ρ ≫ O.ι) ⁻¹ᵁ U')).inv ≫ ((inv ρ ≫ O.ι) ∣_ U')) ≫ (U'.ι ≫ ut) := by
        rw [← ha]
        simp only [Category.assoc]
        rw [hb, ← Category.assoc ((inv ρ ≫ O.ι) ⁻¹ᵁ U').ι, ← hc]
        simp only [Category.assoc]
      rw [hfac]
      exact smoothOfRelativeDimension_comp 0 1 _ _

theorem wcpa_cl_pinch_field_sections : ∀ (K : Type u) [Field K] {Zt Z : Scheme.{u}}
    (ut : Zt ⟶ Spec (.of K)) (uu : Z ⟶ Spec (.of K)) (m : ℕ)
    (σ : Fin m × Fin 2 → (Spec (.of K) ⟶ Zt)) (π : Zt ⟶ Z) (O U : Zt.Opens) (V O' : Z.Opens),
    wcpaClPinch ut uu m σ π O U V O' →
    (∀ (a b : Fin m × Fin 2) (p q : ↥(Spec (.of K))), a ≠ b → σ a p ≠ σ b q) →
    ∀ V' : Z.affineOpens, Function.Injective (π.app V'.1).hom ∧
      ∀ s : Γ(Zt, π ⁻¹ᵁ V'.1), (∀ (e : Fin m) (h₀ : ⊤ ≤ σ (e, 0) ⁻¹ᵁ (π ⁻¹ᵁ V'.1))
        (h₁ : ⊤ ≤ σ (e, 1) ⁻¹ᵁ (π ⁻¹ᵁ V'.1)),
        ((σ (e, 0)).appLE (π ⁻¹ᵁ V'.1) ⊤ h₀).hom s = ((σ (e, 1)).appLE (π ⁻¹ᵁ V'.1) ⊤ h₁).hom s) →
        ∃ t : Γ(Z, V'.1), (π.app V'.1).hom t = s :=
by
  intro K _ Zt Z ut uu m σ π O U V O' hD _hdisj V'
  obtain ⟨-, -, hσπ, -, hUaff, hVaff, -, hVO', ⟨hO, hiso⟩, ⟨hU, hinj0, himg0⟩⟩ := hD
  subst hU
  subst hO
  rw [Scheme.Hom.resLE_eq_morphismRestrict] at hiso
  have := hiso
  have hinj : Function.Injective (π.app V).hom := by
    rw [Scheme.Hom.app_eq_appLE]; exact hinj0
  have himg : ∀ x : Γ(Zt, π ⁻¹ᵁ V), (∀ (e : Fin m) (h₀ : ⊤ ≤ σ (e, 0) ⁻¹ᵁ (π ⁻¹ᵁ V))
      (h₁ : ⊤ ≤ σ (e, 1) ⁻¹ᵁ (π ⁻¹ᵁ V)),
      ((σ (e, 0)).appLE (π ⁻¹ᵁ V) ⊤ h₀).hom x = ((σ (e, 1)).appLE (π ⁻¹ᵁ V) ⊤ h₁).hom x) →
      ∃ f : Γ(Z, V), (π.app V).hom f = x := by
    intro x hx
    obtain ⟨f, hf⟩ := (himg0 x).mpr hx
    exact ⟨f, by rw [Scheme.Hom.app_eq_appLE]; exact hf⟩

  have resres : ∀ (S : Scheme.{u}) {A B C : S.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (h3 : C ≤ A)
      (x : Γ(S, A)), (S.presheaf.map (homOfLE h2).op).hom ((S.presheaf.map (homOfLE h1).op).hom x)
        = (S.presheaf.map (homOfLE h3).op).hom x := fun S A B C h1 h2 h3 x =>
    (congrArg (fun F => F.hom x) (S.presheaf.map_comp (homOfLE h1).op (homOfLE h2).op)).symm
  have resid : ∀ (S : Scheme.{u}) {A : S.Opens} (h : A ≤ A) (x : Γ(S, A)),
      (S.presheaf.map (homOfLE h).op).hom x = x := by
    intro S A h x
    have : (homOfLE h).op = 𝟙 (Opposite.op A) := rfl
    rw [this, S.presheaf.map_id]
    rfl
  have natu : ∀ {A B : Z.Opens} (h : B ≤ A) (z : Γ(Z, A)),
      (π.app B).hom ((Z.presheaf.map (homOfLE h).op).hom z) =
        (Zt.presheaf.map (homOfLE (π.preimage_mono h)).op).hom ((π.app A).hom z) :=
    fun h z => congrArg (fun F => F.hom z) (π.naturality (homOfLE h).op)
  have hev : ∀ (f : Spec (.of K) ⟶ Zt) {A B : Zt.Opens} (h : B ≤ A) (hB : ⊤ ≤ f ⁻¹ᵁ B)
      (hA : ⊤ ≤ f ⁻¹ᵁ A) (z : Γ(Zt, A)),
      (f.appLE B ⊤ hB).hom ((Zt.presheaf.map (homOfLE h).op).hom z) = (f.appLE A ⊤ hA).hom z :=
    fun f A B h hB hA z => congrArg (fun F => F.hom z) (Scheme.Hom.map_appLE f hB (homOfLE h).op)

  have s1 : ∀ W : Z.Opens, W ≤ O' → Function.Bijective (π.app W).hom := by
    intro W hW
    have hWeq : O'.ι ''ᵁ (O'.ι ⁻¹ᵁ W) = W := by
      rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
      exact inf_eq_right.mpr hW
    have h : IsIso ((π ∣_ O').app (O'.ι ⁻¹ᵁ W)) := inferInstance
    rw [morphismRestrict_app, eqToHom_op] at h
    have hiso' : ∀ {A B : (Zt.Opens)ᵒᵖ} (p : A = B), IsIso (Zt.presheaf.map (eqToHom p)) := by
      intro A B p
      subst p
      rw [eqToHom_refl, Zt.presheaf.map_id]
      infer_instance
    have h2 : IsIso (π.app (O'.ι ''ᵁ (O'.ι ⁻¹ᵁ W))) := by
      refine @IsIso.of_isIso_comp_right _ _ _ _ _ _ _ ?_ h
      exact hiso' _
    have h3 := ConcreteCategory.bijective_of_isIso (π.app (O'.ι ''ᵁ (O'.ι ⁻¹ᵁ W)))
    rw [hWeq] at h3
    exact h3

  have s2 : ∀ g : Γ(Z, V), Function.Injective (π.app (Z.basicOpen g)).hom := by
    intro g
    have hDV : Z.basicOpen g ≤ V := Z.basicOpen_le g
    have hED : Zt.basicOpen ((π.app V).hom g) ≤ π ⁻¹ᵁ (Z.basicOpen g) :=
      (Scheme.Hom.preimage_basicOpen π g).ge
    rw [injective_iff_map_eq_zero]
    intro t ht
    obtain ⟨n, y, hy⟩ := exists_eq_pow_mul_of_isAffineOpen Z V hVaff g t
    change (Z.presheaf.map (homOfLE hDV).op).hom y =
      ((Z.presheaf.map (homOfLE hDV).op).hom g) ^ n * t at hy
    have h1 : (Zt.presheaf.map (homOfLE (π.preimage_mono hDV)).op).hom ((π.app V).hom y) = 0 := by
      rw [← natu hDV y, hy, map_mul, ht, mul_zero]
    have h2 : (Zt.presheaf.map (homOfLE (Zt.basicOpen_le ((π.app V).hom g))).op).hom
        ((π.app V).hom y) = 0 := by
      rw [← resres Zt (π.preimage_mono hDV) hED, h1, map_zero]
    obtain ⟨k, hk⟩ :=
      exists_pow_mul_eq_zero_of_res_basicOpen_eq_zero_of_isAffineOpen Zt hUaff _ _ h2
    have h3 : g ^ k * y = 0 := by
      apply hinj
      rw [map_mul, map_pow, hk, map_zero]
    have hu : IsUnit ((Z.presheaf.map (homOfLE hDV).op).hom g) :=
      RingedSpace.isUnit_res_basicOpen Z.toRingedSpace g
    have h4 : ((Z.presheaf.map (homOfLE hDV).op).hom g) ^ (k + n) * t = 0 := by
      have := congrArg (Z.presheaf.map (homOfLE hDV).op).hom h3
      rw [map_mul, map_pow, map_zero, hy] at this
      rw [pow_add, mul_assoc]
      exact this
    exact (hu.pow (k + n)).mul_right_eq_zero.mp h4

  have s3 : ∀ (g : Γ(Z, V)) (s : Γ(Zt, π ⁻¹ᵁ Z.basicOpen g)),
      (∀ (e : Fin m) (h₀ : ⊤ ≤ σ (e, 0) ⁻¹ᵁ (π ⁻¹ᵁ Z.basicOpen g))
        (h₁ : ⊤ ≤ σ (e, 1) ⁻¹ᵁ (π ⁻¹ᵁ Z.basicOpen g)),
        ((σ (e, 0)).appLE (π ⁻¹ᵁ Z.basicOpen g) ⊤ h₀).hom s =
          ((σ (e, 1)).appLE (π ⁻¹ᵁ Z.basicOpen g) ⊤ h₁).hom s) →
      ∃ t : Γ(Z, Z.basicOpen g), (π.app (Z.basicOpen g)).hom t = s := by
    intro g s hs
    have hDV : Z.basicOpen g ≤ V := Z.basicOpen_le g
    have hDtV : π ⁻¹ᵁ Z.basicOpen g ≤ π ⁻¹ᵁ V := π.preimage_mono hDV
    have hEV : Zt.basicOpen ((π.app V).hom g) ≤ π ⁻¹ᵁ V := Zt.basicOpen_le _
    have hED : Zt.basicOpen ((π.app V).hom g) ≤ π ⁻¹ᵁ (Z.basicOpen g) :=
      (Scheme.Hom.preimage_basicOpen π g).ge
    have hDE : π ⁻¹ᵁ (Z.basicOpen g) ≤ Zt.basicOpen ((π.app V).hom g) :=
      (Scheme.Hom.preimage_basicOpen π g).le

    obtain ⟨n, y, hy⟩ := exists_eq_pow_mul_of_isAffineOpen Zt (π ⁻¹ᵁ V) hUaff ((π.app V).hom g)
      ((Zt.presheaf.map (homOfLE hED).op).hom s)
    change (Zt.presheaf.map (homOfLE hEV).op).hom y =
      ((Zt.presheaf.map (homOfLE hEV).op).hom ((π.app V).hom g)) ^ n *
        (Zt.presheaf.map (homOfLE hED).op).hom s at hy
    have hy' : (Zt.presheaf.map (homOfLE hDtV).op).hom y =
        ((Zt.presheaf.map (homOfLE hDtV).op).hom ((π.app V).hom g)) ^ n * s := by
      have := congrArg (Zt.presheaf.map (homOfLE hDE).op).hom hy
      rw [map_mul, map_pow, resres Zt hEV hDE hDtV, resres Zt hEV hDE hDtV,
        resres Zt hED hDE le_rfl, resid] at this
      exact this

    have hpair : ∀ (e : Fin m) (h₀ : ⊤ ≤ σ (e, 0) ⁻¹ᵁ (π ⁻¹ᵁ V))
        (h₁ : ⊤ ≤ σ (e, 1) ⁻¹ᵁ (π ⁻¹ᵁ V)) (z : Γ(Z, V)),
        ((σ (e, 0)).appLE (π ⁻¹ᵁ V) ⊤ h₀).hom ((π.app V).hom z) =
          ((σ (e, 1)).appLE (π ⁻¹ᵁ V) ⊤ h₁).hom ((π.app V).hom z) := by
      intro e h₀ h₁ z
      have e0 := congrArg (fun F => F.hom z) (Scheme.Hom.comp_appLE (σ (e, 0)) π V ⊤ h₀)
      have e1 := congrArg (fun F => F.hom z) (Scheme.Hom.comp_appLE (σ (e, 1)) π V ⊤ h₁)
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e0 e1
      rw [← e0, ← e1]
      have gen : ∀ (f f' : Spec (.of K) ⟶ Z) (_ : f = f') (hh : ⊤ ≤ f ⁻¹ᵁ V)
          (hh' : ⊤ ≤ f' ⁻¹ᵁ V), (f.appLE V ⊤ hh).hom z = (f'.appLE V ⊤ hh').hom z := by
        intro f f' hf hh hh'
        subst hf
        rfl
      exact gen _ _ (hσπ e) _ _

    have hfield : ∀ c : Γ(Spec (.of K), ⊤), c = 0 ∨ IsUnit c := by
      intro c
      by_cases hc : c = 0
      · exact Or.inl hc
      · right
        let ε := (Scheme.ΓSpecIso (.of K)).commRingCatIsoToRingEquiv
        have h1 : ε c ≠ 0 := (map_ne_zero_iff ε ε.injective).mpr hc
        exact (isUnit_map_iff ε c).mp (isUnit_iff_ne_zero.mpr h1)

    have hgy : ∀ (e : Fin m) (h₀ : ⊤ ≤ σ (e, 0) ⁻¹ᵁ (π ⁻¹ᵁ V))
        (h₁ : ⊤ ≤ σ (e, 1) ⁻¹ᵁ (π ⁻¹ᵁ V)),
        ((σ (e, 0)).appLE (π ⁻¹ᵁ V) ⊤ h₀).hom ((π.app V).hom g * y) =
          ((σ (e, 1)).appLE (π ⁻¹ᵁ V) ⊤ h₁).hom ((π.app V).hom g * y) := by
      intro e h₀ h₁
      rw [map_mul, map_mul, ← hpair e h₀ h₁ g]
      rcases hfield (((σ (e, 0)).appLE (π ⁻¹ᵁ V) ⊤ h₀).hom ((π.app V).hom g)) with hc | hc
      · rw [hc, zero_mul, zero_mul]
      · congr 1
        have hc1 : IsUnit (((σ (e, 1)).appLE (π ⁻¹ᵁ V) ⊤ h₁).hom ((π.app V).hom g)) := by
          rw [← hpair e h₀ h₁ g]; exact hc
        have hin : ∀ (b : Fin 2) (hb : ⊤ ≤ σ (e, b) ⁻¹ᵁ (π ⁻¹ᵁ V)),
            IsUnit (((σ (e, b)).appLE (π ⁻¹ᵁ V) ⊤ hb).hom ((π.app V).hom g)) →
            ⊤ ≤ σ (e, b) ⁻¹ᵁ (π ⁻¹ᵁ Z.basicOpen g) := by
          intro b hb hcb
          have h1 := Scheme.basicOpen_appLE (σ (e, b)) ⊤ (π ⁻¹ᵁ V) hb ((π.app V).hom g)
          rw [Scheme.basicOpen_of_isUnit _ hcb, top_inf_eq] at h1
          rw [h1]
          exact (σ (e, b)).preimage_mono hED
        have h₀' := hin 0 h₀ hc
        have h₁' := hin 1 h₁ hc1
        have hd : ∀ (b : Fin 2) (hb : ⊤ ≤ σ (e, b) ⁻¹ᵁ (π ⁻¹ᵁ V))
            (hb' : ⊤ ≤ σ (e, b) ⁻¹ᵁ (π ⁻¹ᵁ Z.basicOpen g)),
            ((σ (e, b)).appLE (π ⁻¹ᵁ V) ⊤ hb).hom y =
              (((σ (e, b)).appLE (π ⁻¹ᵁ V) ⊤ hb).hom ((π.app V).hom g)) ^ n *
                ((σ (e, b)).appLE (π ⁻¹ᵁ Z.basicOpen g) ⊤ hb').hom s := by
          intro b hb hb'
          rw [← hev (σ (e, b)) hDtV hb' hb, hy', map_mul, map_pow, hev (σ (e, b)) hDtV hb' hb]
        rw [hd 0 h₀ h₀', hd 1 h₁ h₁', hs e h₀' h₁', hpair e h₀ h₁ g]

    obtain ⟨f, hf⟩ := himg _ hgy

    have hu : IsUnit ((Z.presheaf.map (homOfLE hDV).op).hom g) :=
      RingedSpace.isUnit_res_basicOpen Z.toRingedSpace g
    refine ⟨(↑(hu.unit⁻¹) : Γ(Z, Z.basicOpen g)) ^ (n + 1) *
      (Z.presheaf.map (homOfLE hDV).op).hom f, ?_⟩
    have hw : (π.app (Z.basicOpen g)).hom (↑(hu.unit⁻¹) : Γ(Z, Z.basicOpen g)) *
        (Zt.presheaf.map (homOfLE hDtV).op).hom ((π.app V).hom g) = 1 := by
      rw [← natu hDV g, ← map_mul, IsUnit.val_inv_mul, map_one]
    rw [map_mul, map_pow, natu hDV f, hf, map_mul, hy']
    rw [show ∀ a w : Γ(Zt, π ⁻¹ᵁ Z.basicOpen g), a ^ (n + 1) * (w * (w ^ n * s)) =
      (a * w) ^ (n + 1) * s from fun a w => by ring, hw, one_pow, one_mul]

  let G : Z.Opens → Prop := fun W => W ≤ O' ∨ ∃ g : Γ(Z, V), W = Z.basicOpen g
  have hcov : ∀ (W : Z.Opens) (y : Z), y ∈ W → ∃ W' : Z.Opens, G W' ∧ W' ≤ W ∧ y ∈ W' := by
    intro W y hyW
    have hy : y ∈ V ⊔ O' := by rw [hVO']; trivial
    rcases TopologicalSpace.Opens.mem_sup.mp hy with hyV | hyO
    · obtain ⟨g, hg, hyg⟩ := hVaff.exists_basicOpen_le (V := W) ⟨y, hyW⟩ hyV
      exact ⟨Z.basicOpen g, Or.inr ⟨g, rfl⟩, hg, hyg⟩
    · exact ⟨W ⊓ O', Or.inl inf_le_right, inf_le_left, ⟨hyW, hyO⟩⟩
  have hGinj : ∀ W : Z.Opens, G W → Function.Injective (π.app W).hom := by
    rintro W (hW | ⟨g, rfl⟩)
    · exact (s1 W hW).1
    · exact s2 g
  have hGdesc : ∀ W : Z.Opens, G W → ∀ s : Γ(Zt, π ⁻¹ᵁ W), (∀ (e : Fin m)
      (h₀ : ⊤ ≤ σ (e, 0) ⁻¹ᵁ (π ⁻¹ᵁ W)) (h₁ : ⊤ ≤ σ (e, 1) ⁻¹ᵁ (π ⁻¹ᵁ W)),
      ((σ (e, 0)).appLE (π ⁻¹ᵁ W) ⊤ h₀).hom s = ((σ (e, 1)).appLE (π ⁻¹ᵁ W) ⊤ h₁).hom s) →
      ∃ t : Γ(Z, W), (π.app W).hom t = s := by
    rintro W (hW | ⟨g, rfl⟩) s hs
    · exact (s1 W hW).2 s
    · exact s3 g s hs

  have s4 : ∀ W : Z.Opens, Function.Injective (π.app W).hom := by
    intro W
    rw [injective_iff_map_eq_zero]
    intro t ht
    have hc : W ≤ iSup (fun i : {W' : Z.Opens // G W' ∧ W' ≤ W} => i.1) := by
      intro y hy
      obtain ⟨W', hG', hle, hyW'⟩ := hcov W y hy
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨W', hG', hle⟩, hyW'⟩
    apply TopCat.Sheaf.eq_of_locally_eq' Z.sheaf
      (fun i : {W' : Z.Opens // G W' ∧ W' ≤ W} => i.1) W (fun i => homOfLE i.2.2) hc
    intro i
    show (Z.presheaf.map (homOfLE i.2.2).op).hom t = (Z.presheaf.map (homOfLE i.2.2).op).hom 0
    rw [map_zero]
    apply hGinj i.1 i.2.1
    rw [map_zero, natu i.2.2 t, ht, map_zero]

  have s5 : ∀ (W : Z.Opens) (s : Γ(Zt, π ⁻¹ᵁ W)), (∀ (e : Fin m)
      (h₀ : ⊤ ≤ σ (e, 0) ⁻¹ᵁ (π ⁻¹ᵁ W)) (h₁ : ⊤ ≤ σ (e, 1) ⁻¹ᵁ (π ⁻¹ᵁ W)),
      ((σ (e, 0)).appLE (π ⁻¹ᵁ W) ⊤ h₀).hom s = ((σ (e, 1)).appLE (π ⁻¹ᵁ W) ⊤ h₁).hom s) →
      ∃ t : Γ(Z, W), (π.app W).hom t = s := by
    intro W s hs
    have hc : W ≤ iSup (fun i : {W' : Z.Opens // G W' ∧ W' ≤ W} => i.1) := by
      intro y hy
      obtain ⟨W', hG', hle, hyW'⟩ := hcov W y hy
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨W', hG', hle⟩, hyW'⟩
    have hres : ∀ i : {W' : Z.Opens // G W' ∧ W' ≤ W}, ∃ t : Γ(Z, i.1), (π.app i.1).hom t =
        (Zt.presheaf.map (homOfLE (π.preimage_mono i.2.2)).op).hom s := by
      intro i
      apply hGdesc i.1 i.2.1
      intro e h₀ h₁
      have h₀' : ⊤ ≤ σ (e, 0) ⁻¹ᵁ (π ⁻¹ᵁ W) :=
        h₀.trans ((σ (e, 0)).preimage_mono (π.preimage_mono i.2.2))
      have h₁' : ⊤ ≤ σ (e, 1) ⁻¹ᵁ (π ⁻¹ᵁ W) :=
        h₁.trans ((σ (e, 1)).preimage_mono (π.preimage_mono i.2.2))
      rw [hev (σ (e, 0)) (π.preimage_mono i.2.2) h₀ h₀',
        hev (σ (e, 1)) (π.preimage_mono i.2.2) h₁ h₁']
      exact hs e h₀' h₁'
    choose t ht using hres
    have key : ∀ (i : {W' : Z.Opens // G W' ∧ W' ≤ W}) (B : Z.Opens) (hk : B ≤ i.1),
        (π.app B).hom ((Z.presheaf.map (homOfLE hk).op).hom (t i)) =
          (Zt.presheaf.map (homOfLE (π.preimage_mono (hk.trans i.2.2))).op).hom s := by
      intro i B hk
      rw [natu hk, ht i, resres]
    have hcompat : TopCat.Presheaf.IsCompatible Z.presheaf
        (fun i : {W' : Z.Opens // G W' ∧ W' ≤ W} => i.1) t := by
      intro i j
      apply s4 (i.1 ⊓ j.1)
      change (π.app (i.1 ⊓ j.1)).hom ((Z.presheaf.map (homOfLE inf_le_left).op).hom (t i)) =
        (π.app (i.1 ⊓ j.1)).hom ((Z.presheaf.map (homOfLE inf_le_right).op).hom (t j))
      rw [key i _ inf_le_left, key j _ inf_le_right]
    obtain ⟨tW, htW, -⟩ := TopCat.Sheaf.existsUnique_gluing' Z.sheaf
      (fun i : {W' : Z.Opens // G W' ∧ W' ≤ W} => i.1) W (fun i => homOfLE i.2.2) hc t hcompat
    refine ⟨tW, ?_⟩
    have hc' : π ⁻¹ᵁ W ≤ iSup (fun i : {W' : Z.Opens // G W' ∧ W' ≤ W} => π ⁻¹ᵁ i.1) := by
      rw [← Scheme.Hom.preimage_iSup]
      exact π.preimage_mono hc
    apply TopCat.Sheaf.eq_of_locally_eq' Zt.sheaf
      (fun i : {W' : Z.Opens // G W' ∧ W' ≤ W} => π ⁻¹ᵁ i.1) (π ⁻¹ᵁ W)
      (fun i => homOfLE (π.preimage_mono i.2.2)) hc'
    intro i
    change (Zt.presheaf.map (homOfLE (π.preimage_mono i.2.2)).op).hom ((π.app W).hom tW) =
      (Zt.presheaf.map (homOfLE (π.preimage_mono i.2.2)).op).hom s
    rw [← natu i.2.2 tW, ← ht i]
    congr 1
    exact htW i
  exact ⟨s4 V'.1, s5 V'.1⟩

theorem wcpa_dj_lr1_clutch_model : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (C Ct : Scheme.{u}) (c : C ⟶ Spec (.of Ω)) (ct : Ct ⟶ Spec (.of Ω)) (ν : Ct ⟶ C) (m n : ℕ)
    (x : Fin n → (Spec (.of Ω) ⟶ C)) (r : (Fin m × Fin 2) ⊕ Fin n → (Spec (.of Ω) ⟶ Ct)),
    ν ≫ c = ct → (∀ a, r a ≫ ct = 𝟙 _) → (∀ i, r (Sum.inr i) ≫ ν = x i) →
    IsPushout (Limits.Sigma.desc fun e2 : Fin m × Fin 2 => r (Sum.inl e2))
        (Limits.Sigma.desc fun e2 : Fin m × Fin 2 =>
          Limits.Sigma.ι (fun _ : Fin m => Spec (.of Ω)) e2.1)
        ν (Limits.Sigma.desc fun e : Fin m => r (Sum.inl (e, 0)) ≫ ν) →
    ∀ (Zt : Scheme.{u}) (ut : Zt ⟶ Spec (.of ↥W))
      (τt : (Fin m × Fin 2) ⊕ Fin n → (Spec (.of ↥W) ⟶ Zt)) (ψt : Ct ⟶ Zt),
    wcpaDjSemistable ut →
    (∃ (N : ℕ) (j : Zt ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W)
        MvPolynomial.gradedAlgebra), IsClosedImmersion j ∧
      j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W)
        MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
          (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W 0))) = ut) →
    (∀ a, τt a ≫ ut = 𝟙 _) →
    (∀ (a b : (Fin m × Fin 2) ⊕ Fin n) (p q : ↥(Spec (.of ↥W))), a ≠ b → τt a p ≠ τt b q) →
    (∀ a (p : ↥(Spec (.of ↥W))), ∃ U : Zt.Opens, τt a p ∈ U ∧
      SmoothOfRelativeDimension 1 (U.ι ≫ ut)) →
    IsPullback ψt ct ut (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) →
    (∀ a, r a ≫ ψt = Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) ≫ τt a) →
    ∃ (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of ↥W)) (τ : Fin n → (Spec (.of ↥W) ⟶ Z)) (ψ : C ⟶ Z),
      wcpaDjSemistable uu ∧ wcpaDjSections uu n τ ∧
      IsPullback ψ c uu (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) ∧
      ∀ i, x i ≫ ψ = Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) ≫ τ i :=
by
  intro Ω _ W C Ct c ct ν m n x r hνc hrs hrx hpo Zt ut τt ψt hsst hprojt hτs hτd hτsm hpbt hct
  haveI : IsProper ut := hsst.2.1
  haveI : Flat ut := hsst.1
  have hσd : ∀ (a b : Fin m × Fin 2) (p q : ↥(Spec (.of ↥W))), a ≠ b →
      (fun a => τt (Sum.inl a)) a p ≠ (fun a => τt (Sum.inl a)) b q :=
    fun a b p q h => hτd _ _ p q (fun h' => h (Sum.inl_injective h'))

  obtain ⟨U, hU, hUσ⟩ := wcpa_cl_common_affine (↥W) Zt ut hprojt (Fin m × Fin 2)
    (fun a => τt (Sum.inl a)) (fun a => hτs _)
  obtain ⟨Z, uu, π, O, V, O', hD⟩ := wcpa_cl_pinch_exists (↥W) Zt ut m
    (fun a => τt (Sum.inl a)) (fun a => hτs _) hσd U hU hUσ

  obtain ⟨hfl, hpr⟩ := wcpa_cl_pinch_flat_proper (↥W) ut uu m _ π O U V O' hD hσd hsst.1 hsst.2.1
  have hss := wcpa_cl_pinch_semistable (↥W) ut uu m _ π O U V O' hD hσd hsst
    (fun a p => hτsm _ p) hfl hpr

  have hsec := wcpa_cl_pinch_sections (↥W) ut uu m _ π O U V O' hD n (fun i => τt (Sum.inr i))
    (fun i => hτs _) (fun i j p q h => hτd _ _ p q (fun h' => h (Sum.inr_injective h')))
    (fun i a p q => hτd _ _ p q Sum.inr_ne_inl) (fun i p => hτsm _ p)

  obtain ⟨σ', π', hD', hσ'd, hσ'f, hπ'f⟩ := wcpa_cl_pinch_basechange (↥W) Ω (algebraMap ↥W Ω)
    ut uu m _ π O U V O' hD hσd
  obtain ⟨hfin, hsurj, hfib⟩ := wcpa_cl_pinch_points Ω _ _ m σ' π' _ _ _ _ hD' hσ'd inferInstance
  have hfs := wcpa_cl_pinch_field_sections Ω _ _ m σ' π' _ _ _ _ hD' hσ'd
  have hpo' := wcpa_dj_nn_pinch_pushout Ω _ _ π' m σ' hfin hsurj hσ'd hD'.2.2.1 hfib hfs

  let it := hpbt.isoPullback
  have hit1 : it.hom ≫ Limits.pullback.fst ut (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) =
      ψt := hpbt.isoPullback_hom_fst
  have hit2 : it.hom ≫ Limits.pullback.snd ut (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) =
      ct := hpbt.isoPullback_hom_snd
  have hrσ : ∀ a, r (Sum.inl a) ≫ it.hom = σ' a := by
    intro a
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hit1, hct]
      exact (hσ'f a).symm
    · rw [Category.assoc, hit2, hrs, hD'.2.1 a]
  have hpoT : IsPushout (Limits.Sigma.desc fun e2 : Fin m × Fin 2 => σ' e2)
      (Limits.Sigma.desc fun e2 : Fin m × Fin 2 =>
        Limits.Sigma.ι (fun _ : Fin m => Spec (.of Ω)) e2.1)
      (it.inv ≫ ν) (Limits.Sigma.desc fun e : Fin m => r (Sum.inl (e, 0)) ≫ ν) := by
    refine IsPushout.of_iso hpo (Iso.refl _) it (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
    · apply Limits.Sigma.hom_ext
      intro b
      simp only [Iso.refl_hom, Category.id_comp, Limits.Sigma.ι_desc_assoc, Limits.Sigma.ι_desc]
      exact hrσ b
    · simp
    · simp
    · simp
  let j := IsPushout.isoIsPushout _ _ hpoT hpo'
  have hj1 : (it.inv ≫ ν) ≫ j.hom = π' := IsPushout.inl_isoIsPushout_hom _ _ hpoT hpo'
  have hj2 : (Limits.Sigma.desc fun e : Fin m => r (Sum.inl (e, 0)) ≫ ν) ≫ j.hom =
      Limits.Sigma.desc fun e : Fin m => σ' (e, 0) ≫ π' :=
    IsPushout.inr_isoIsPushout_hom _ _ hpoT hpo'
  have hνj : ν ≫ j.hom = it.hom ≫ π' := by
    rw [← hj1]
    simp
  have hc : j.hom ≫ Limits.pullback.snd uu (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) =
      c := by
    apply hpo.hom_ext
    · rw [← Category.assoc, hνj, Category.assoc, hD'.1, hit2, hνc]
    · rw [← Category.assoc, hj2]
      apply Limits.Sigma.hom_ext
      intro e
      simp only [Limits.Sigma.ι_desc_assoc, Category.assoc]
      rw [hD'.1, hD'.2.1, hνc, hrs]
  have hpb : IsPullback (j.hom ≫ Limits.pullback.fst uu
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)))) c uu
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) := by
    refine IsPullback.of_iso_pullback ⟨?_⟩ j rfl hc
    rw [← hc, Category.assoc, Category.assoc, Limits.pullback.condition]
  refine ⟨Z, uu, fun i => τt (Sum.inr i) ≫ π,
    j.hom ≫ Limits.pullback.fst uu (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))),
    hss, hsec, hpb, ?_⟩
  intro i
  have e1 : x i ≫ j.hom ≫ Limits.pullback.fst uu (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) =
      r (Sum.inr i) ≫ (ν ≫ j.hom) ≫
        Limits.pullback.fst uu (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) := by
    rw [← hrx i]
    simp only [Category.assoc]
  rw [e1, hνj]
  simp only [Category.assoc]
  rw [hπ'f, ← Category.assoc it.hom, hit1, ← Category.assoc, hct]
  simp only [Category.assoc]

theorem wcpa_dj_ms_generic_fibre : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (Ct Z' : Scheme.{u}) (ct : Ct ⟶ Spec (.of Ω)) (u' : Z' ⟶ Spec (.of ↥W)) (ψ' : Ct ⟶ Z'), SmoothOfRelativeDimension 1 ct → IsPullback ψ' ct u' (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) → (∀ p : ↥(Spec (.of ↥W)), p ∈ Set.range (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) ∨ p = IsLocalRing.closedPoint ↥W) ∧ IsOpenImmersion ψ' ∧ (∀ z : ↥Z', z ∈ Set.range ψ' ↔ u' z ∈ Set.range (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)))) ∧ ∀ z : ↥Z', z ∈ Set.range ψ' → ∃ U : Z'.Opens, z ∈ U ∧ SmoothOfRelativeDimension 1 (U.ι ≫ u') :=
by
  intro Ω _ W hW Ct Z' ct u' ψ' hsm hpb
  classical
  have ptw : ∀ {A B C : Scheme.{u}} {f : A ⟶ B} {g : B ⟶ C} {h : A ⟶ C}, f ≫ g = h →
      ∀ x, g (f x) = h x := by
    intro A B C f g h e x
    rw [← Scheme.Hom.comp_apply, e]

  have hKD : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hW
  have h2 : ∀ P : Ideal ↥W, P.IsPrime → P = ⊥ ∨ P = IsLocalRing.maximalIdeal ↥W := by
    intro P hP
    by_cases h : P = ⊥
    · exact Or.inl h
    · right
      have hmax : P.IsMaximal := (Ring.krullDimLE_one_iff_of_isPrime_bot.mp hKD) P h hP
      exact IsLocalRing.eq_maximalIdeal hmax

  have hinj : Function.Injective (algebraMap ↥W Ω) := IsFractionRing.injective ↥W Ω
  obtain ⟨r, hr0, hrJ⟩ : ∃ r : ↥W, r ≠ 0 ∧ ∀ J : Ideal ↥W, J.IsPrime → J ≠ ⊥ → r ∈ J := by
    by_cases hm : ∃ π ∈ IsLocalRing.maximalIdeal ↥W, π ≠ 0
    · obtain ⟨π, hπ, hπ0⟩ := hm
      refine ⟨π, hπ0, fun J hJ hJ0 => ?_⟩
      rcases h2 J hJ with h | h
      · exact absurd h hJ0
      · rw [h]; exact hπ
    · push_neg at hm
      refine ⟨1, one_ne_zero, fun J hJ hJ0 => ?_⟩
      exfalso
      apply hJ0
      rcases h2 J hJ with h | h
      · exact h
      · rw [h, eq_bot_iff]
        intro x hx
        rw [Ideal.mem_bot]
        exact hm x hx
  haveI hAway : IsLocalization.Away r Ω := by
    apply IsLocalization.Away.mk r
    · exact ((map_ne_zero_iff _ hinj).mpr hr0).isUnit
    · intro x
      by_cases hx : x ∈ W
      · refine ⟨0, ⟨x, hx⟩, ?_⟩
        rw [pow_zero, mul_one]
        rfl
      · have hxi : x⁻¹ ∈ W := (W.mem_or_inv_mem x).resolve_left hx
        have hx0 : x ≠ 0 := fun h => hx (h ▸ W.zero_mem)
        set w : ↥W := ⟨x⁻¹, hxi⟩ with hwdef
        have hw0 : w ≠ 0 := fun h => inv_ne_zero hx0 (congrArg Subtype.val h)
        have hrad : r ∈ (Ideal.span {w}).radical := by
          rw [Ideal.radical_eq_sInf, Ideal.mem_sInf]
          rintro J ⟨hJle, hJ⟩
          apply hrJ J hJ
          intro hJ0
          apply hw0
          have hwJ : w ∈ J := hJle (Ideal.mem_span_singleton_self w)
          rw [hJ0, Ideal.mem_bot] at hwJ
          exact hwJ
        obtain ⟨n, hn⟩ := hrad
        obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hn
        refine ⟨n, c, ?_⟩
        have hc' : (c : Ω) * x⁻¹ = (r : Ω) ^ n := by
          have h1 := congrArg Subtype.val hc
          simpa [hwdef] using h1
        show x * (r : Ω) ^ n = (c : Ω)
        rw [← hc', mul_comm (c : Ω), ← mul_assoc, mul_inv_cancel₀ hx0, one_mul]
    · intro a b hab
      exact ⟨0, by rw [hinj hab]⟩
  haveI heW : IsOpenImmersion (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) :=
    IsOpenImmersion.of_isLocalization r

  have hi : ∀ p : ↥(Spec (.of ↥W)), p ∈ Set.range (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) ∨
      p = IsLocalRing.closedPoint ↥W := by
    intro p
    let p' : PrimeSpectrum ↥W := p
    rcases h2 p'.asIdeal p'.isPrime with h | h
    · left
      refine ⟨(⟨⊥, inferInstance⟩ : PrimeSpectrum Ω), ?_⟩
      apply PrimeSpectrum.ext
      show Ideal.comap (algebraMap ↥W Ω) ⊥ = p'.asIdeal
      rw [h]
      exact Ideal.comap_bot_of_injective _ hinj
    · right
      apply PrimeSpectrum.ext
      exact h

  haveI := hsm
  have hψ : IsOpenImmersion ψ' :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hpb.flip heW
  haveI := hψ
  refine ⟨hi, hψ, ?_, ?_⟩

  · intro z
    constructor
    · rintro ⟨c, rfl⟩
      exact ⟨ct c, (ptw rfl c).trans (ptw hpb.w c).symm⟩
    · rintro ⟨q, hq⟩
      obtain ⟨w, hw1, _⟩ := Scheme.Pullback.exists_preimage_pullback z q hq.symm
      exact ⟨hpb.isoPullback.inv w, (ptw hpb.isoPullback_inv_fst w).trans hw1⟩

  · intro z hz
    refine ⟨ψ'.opensRange, ?_, ?_⟩
    · obtain ⟨c, rfl⟩ := hz
      exact ⟨c, rfl⟩
    · rw [← ψ'.isoOpensRange_inv_comp, Category.assoc, hpb.w]
      haveI : SmoothOfRelativeDimension 1 (ct ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) :=
        smoothOfRelativeDimension_comp 1 0 ct _
      exact smoothOfRelativeDimension_comp 0 1 _ _

theorem wcpa_dj_ms_blowup_exists_ft : ∀ (X : Scheme.{u}) (I : X.IdealSheafData), (∀ U : X.affineOpens, (I.ideal U).FG) → ∃ (X' : Scheme.{u}) (r : X' ⟶ X), wcCsdIsBlowup I r :=
by
  intro X I hI
  classical

  have hchartgen : ∀ (A : CommRingCat.{u}) (J : Ideal A) (a : A), a ∈ J →
      ∃ (R : CommRingCat.{u}) (φ : A ⟶ R), φ.hom a ∈ nonZeroDivisors R ∧
        Ideal.map φ.hom J = Ideal.span {φ.hom a} ∧
        ∀ (B : CommRingCat.{u}) (ρ : A ⟶ B), ρ.hom a ∈ nonZeroDivisors B →
          Ideal.map ρ.hom J = Ideal.span {ρ.hom a} → ∃! ψ : R ⟶ B, φ ≫ ψ = ρ := by
    intro A J a ha
    obtain ⟨L, _, _, _⟩ : ∃ (L : Type u) (_ : CommRing L) (_ : Algebra A L),
        IsLocalization.Away a L :=
      ⟨Localization.Away a, inferInstance, inferInstance, inferInstance⟩
    obtain ⟨inv, hinv⟩ : ∃ inv : L, algebraMap A L a * inv = 1 :=
      ⟨_, IsLocalization.Away.mul_invSelf a⟩
    obtain ⟨T, hTK, hTmem⟩ : ∃ T : Set L,
        (∀ t ∈ T, ∃ g ∈ J, t * algebraMap A L a = algebraMap A L g) ∧
        ∀ g ∈ J, algebraMap A L g * inv ∈ T := by
      refine ⟨(fun g => algebraMap A L g * inv) '' (J : Set A), ?_, fun g hg => ⟨g, hg, rfl⟩⟩
      rintro t ⟨g, hg, rfl⟩
      refine ⟨g, hg, ?_⟩
      show algebraMap A L g * inv * algebraMap A L a = algebraMap A L g
      rw [mul_assoc, mul_comm inv, hinv, mul_one]
    obtain ⟨R₀, hR₀⟩ : ∃ R₀ : Subalgebra A L, R₀ = Algebra.adjoin A T := ⟨_, rfl⟩
    have hmemR : ∀ x, x ∈ Algebra.adjoin A T → x ∈ R₀ := fun x hx => by rw [hR₀]; exact hx
    refine ⟨CommRingCat.of R₀, CommRingCat.ofHom (algebraMap A R₀), ?_, ?_, ?_⟩
    · show algebraMap A R₀ a ∈ nonZeroDivisors R₀
      rw [mem_nonZeroDivisors_iff]
      have key : ∀ z : R₀, algebraMap A R₀ a * z = 0 → z = 0 := by
        intro z hz
        apply Subtype.ext
        show (z : L) = 0
        have h1 : algebraMap A L a * (z : L) = 0 := congrArg Subtype.val hz
        calc (z : L) = (algebraMap A L a * inv) * z := by rw [hinv, one_mul]
          _ = inv * (algebraMap A L a * z) := by ring
          _ = 0 := by rw [h1, mul_zero]
      exact ⟨key, fun z hz => key z (by rw [mul_comm]; exact hz)⟩
    · show Ideal.map (algebraMap A R₀) J = Ideal.span {algebraMap A R₀ a}
      apply le_antisymm
      · rw [← Ideal.span_eq J, Ideal.map_span, Ideal.span_le]
        rintro _ ⟨g, hg, rfl⟩
        rw [SetLike.mem_coe, Ideal.mem_span_singleton']
        refine ⟨⟨algebraMap A L g * inv, hmemR _ (Algebra.subset_adjoin (hTmem g hg))⟩, ?_⟩
        apply Subtype.ext
        show algebraMap A L g * inv * algebraMap A L a = algebraMap A L g
        rw [mul_assoc, mul_comm inv, hinv, mul_one]
      · rw [Ideal.span_singleton_le_iff_mem]
        exact Ideal.mem_map_of_mem _ ha
    · intro B ρ hnz hid
      have uniq : ∀ ψ₁ ψ₂ : R₀ →+* B, (∀ x, ψ₁ (algebraMap A R₀ x) = ρ.hom x) →
          (∀ x, ψ₂ (algebraMap A R₀ x) = ρ.hom x) → ψ₁ = ψ₂ := by
        intro ψ₁ ψ₂ h1 h2
        ext ⟨z, hz⟩
        have hz' : z ∈ Algebra.adjoin A T := by rw [← hR₀]; exact hz
        revert hz
        induction hz' using Algebra.adjoin_induction with
        | mem x hx =>
          intro hz
          obtain ⟨g, hg, hxg⟩ := hTK x hx
          have e : (⟨x, hz⟩ : R₀) * algebraMap A R₀ a = algebraMap A R₀ g := Subtype.ext hxg
          have e1 := congrArg ψ₁ e
          have e2 := congrArg ψ₂ e
          simp only [map_mul, h1] at e1
          simp only [map_mul, h2] at e2
          have h0 := (mem_nonZeroDivisors_iff.mp hnz).2 (ψ₁ ⟨x, hz⟩ - ψ₂ ⟨x, hz⟩)
            (by rw [sub_mul, e1, e2, sub_self])
          exact sub_eq_zero.mp h0
        | algebraMap r =>
          intro hz
          have e : (⟨algebraMap A L r, hz⟩ : R₀) = algebraMap A R₀ r := rfl
          rw [e, h1, h2]
        | add x y hx hy ihx ihy =>
          intro hz
          have e : (⟨x + y, hz⟩ : R₀) = ⟨x, hmemR x hx⟩ + ⟨y, hmemR y hy⟩ := rfl
          rw [e, map_add, map_add, ihx, ihy]
        | mul x y hx hy ihx ihy =>
          intro hz
          have e : (⟨x * y, hz⟩ : R₀) = ⟨x, hmemR x hx⟩ * ⟨y, hmemR y hy⟩ := rfl
          rw [e, map_mul, map_mul, ihx, ihy]
      obtain ⟨LB, _, _, _⟩ : ∃ (LB : Type u) (_ : CommRing LB) (_ : Algebra B LB),
          IsLocalization.Away (ρ.hom a) LB :=
        ⟨Localization.Away (ρ.hom a), inferInstance, inferInstance, inferInstance⟩
      have hιB : Function.Injective (algebraMap B LB) :=
        IsLocalization.injective LB (Submonoid.powers_le.mpr hnz)
      have hu : IsUnit ((algebraMap B LB).comp ρ.hom a) :=
        IsLocalization.Away.algebraMap_isUnit (ρ.hom a)
      let ρ' : L →+* LB := IsLocalization.Away.lift a hu
      have hρ' : ∀ x, ρ' (algebraMap A L x) = algebraMap B LB (ρ.hom x) :=
        fun x => IsLocalization.Away.lift_eq a hu x
      have hu' : IsUnit (algebraMap B LB (ρ.hom a)) := hu
      have hrange : ∀ z, z ∈ Algebra.adjoin A T → ∃ b : B, algebraMap B LB b = ρ' z := by
        intro z hz
        induction hz using Algebra.adjoin_induction with
        | mem x hx =>
          obtain ⟨g, hg, hxg⟩ := hTK x hx
          have hgm : ρ.hom g ∈ Ideal.span {ρ.hom a} := by
            rw [← hid]; exact Ideal.mem_map_of_mem _ hg
          obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hgm
          refine ⟨c, ?_⟩
          have e1 : algebraMap B LB c * algebraMap B LB (ρ.hom a) =
              algebraMap B LB (ρ.hom g) := by
            rw [← map_mul, hc]
          have e2 : ρ' x * algebraMap B LB (ρ.hom a) = algebraMap B LB (ρ.hom g) := by
            rw [← hρ', ← hρ', ← map_mul, hxg]
          exact hu'.mul_left_inj.mp (e1.trans e2.symm)
        | algebraMap r => exact ⟨ρ.hom r, (hρ' r).symm⟩
        | add x y _ _ hx hy =>
          obtain ⟨b1, hb1⟩ := hx
          obtain ⟨b2, hb2⟩ := hy
          exact ⟨b1 + b2, by rw [map_add, map_add, hb1, hb2]⟩
        | mul x y _ _ hx hy =>
          obtain ⟨b1, hb1⟩ := hx
          obtain ⟨b2, hb2⟩ := hy
          exact ⟨b1 * b2, by rw [map_mul, map_mul, hb1, hb2]⟩
      choose f hf using hrange
      have hf' : ∀ z : R₀, algebraMap B LB (f z.1 (by rw [← hR₀]; exact z.2)) = ρ' z.1 :=
        fun z => hf _ _
      let ψ₀ : R₀ →+* B :=
        { toFun := fun z => f z.1 (by rw [← hR₀]; exact z.2)
          map_one' := hιB (by rw [hf']; simp)
          map_mul' := fun x y => hιB (by simp only [hf', map_mul]; simp)
          map_zero' := hιB (by rw [hf']; simp)
          map_add' := fun x y => hιB (by simp only [hf', map_add]; simp) }
      have hψ₀ : ∀ z : R₀, algebraMap B LB (ψ₀ z) = ρ' z.1 := fun z => hf' z
      have hψ₀alg : ∀ x, ψ₀ (algebraMap A R₀ x) = ρ.hom x := fun x =>
        hιB (by rw [hψ₀]; exact hρ' x)
      refine ⟨CommRingCat.ofHom ψ₀, ?_, ?_⟩
      · apply CommRingCat.hom_ext
        apply RingHom.ext
        intro x
        exact hψ₀alg x
      · intro ψ' hψ'
        apply CommRingCat.hom_ext
        show ψ'.hom = ψ₀
        apply uniq
        · intro x
          have := congrArg (fun φ' => φ'.hom x) hψ'
          exact this
        · exact hψ₀alg

  have hmapcomp : ∀ {A B C : CommRingCat.{u}} (φ : A ⟶ B) (σ : B ⟶ C) (J : Ideal A) (x : A),
      Ideal.map φ.hom J = Ideal.span {φ.hom x} →
      Ideal.map (φ ≫ σ).hom J = Ideal.span {(φ ≫ σ).hom x} := by
    intro A B C φ σ J x h
    rw [CommRingCat.hom_comp, ← Ideal.map_map, h, Ideal.map_span, Set.image_singleton]
    try rfl
  have hL5a : ∀ {A B C : CommRingCat.{u}} (φ : A ⟶ B) (σ : B ⟶ C) (J : Ideal A) (x y : A),
      Ideal.map φ.hom J = Ideal.span {φ.hom x} → (φ ≫ σ).hom y ∈ nonZeroDivisors C →
      Ideal.map (φ ≫ σ).hom J = Ideal.span {(φ ≫ σ).hom y} →
      (φ ≫ σ).hom x ∈ nonZeroDivisors C ∧
        Ideal.map (φ ≫ σ).hom J = Ideal.span {(φ ≫ σ).hom x} := by
    intro A B C φ σ J x y hx hy hJy
    have hJx := hmapcomp φ σ J x hx
    refine ⟨?_, hJx⟩
    have hm : (φ ≫ σ).hom y ∈ Ideal.span {(φ ≫ σ).hom x} := by
      rw [← hJx, hJy]; exact Ideal.subset_span (Set.mem_singleton _)
    obtain ⟨v, hv⟩ := Ideal.mem_span_singleton'.mp hm
    rw [← hv] at hy
    exact (mul_mem_nonZeroDivisors.mp hy).2
  have hisoNZD : ∀ {B C : CommRingCat.{u}} (ε : B ≅ C) (y : B), y ∈ nonZeroDivisors B →
      ε.hom.hom y ∈ nonZeroDivisors C := by
    intro B C ε y hy
    rw [← MulEquivClass.map_nonZeroDivisors ε.commRingCatIsoToRingEquiv]
    exact ⟨y, hy, rfl⟩
  have hInv : ∀ {T : Scheme.{u}} (h : T ⟶ X), wcCsdInvPull I h ↔
      ∀ t : T, ∃ (U : X.affineOpens) (a : Γ(X, U.1)), a ∈ I.ideal U ∧ wcCsdChartAt I h U a t := by
    intro T h
    unfold wcCsdInvPull
    constructor
    · intro H t
      obtain ⟨U, V, e, a, ht, ha, h1, h2⟩ := H t
      exact ⟨U, a, ha, V, e, ht, h1, h2⟩
    · intro H t
      obtain ⟨U, a, ha, V, e, ht, h1, h2⟩ := H t
      exact ⟨U, V, e, a, ht, ha, h1, h2⟩

  have hfg : ∀ U : X.affineOpens, ∃ (n : ℕ) (b : Fin n → Γ(X, U.1)),
      Ideal.span (Set.range b) = I.ideal U := fun U =>
    Submodule.fg_iff_exists_fin_generating_family.mp (hI U)
  choose n b hb using hfg

  let K : Type u := Σ U : X.affineOpens, Fin (n U)
  let Uk : K → X.affineOpens := fun k => k.1
  let ak : ∀ k : K, Γ(X, (Uk k).1) := fun k => b k.1 k.2
  have hak : ∀ k, ak k ∈ I.ideal (Uk k) := by
    intro k
    show b k.1 k.2 ∈ I.ideal k.1
    rw [← hb k.1]
    exact Ideal.subset_span ⟨k.2, rfl⟩
  have hcovK : ∀ (T : Scheme.{u}) (h : T ⟶ X), wcCsdInvPull I h → ∀ t : T,
      ∃ k, wcCsdChartAt I h (Uk k) (ak k) t := by
    intro T h hP t
    obtain ⟨W, hW, hxW, -⟩ :=
      exists_isAffineOpen_mem_and_subset (U := (⊤ : X.Opens)) (x := h t) trivial
    obtain ⟨j, hj⟩ := wc_csd_invpull_generator_chart X T I h hP ⟨W, hW⟩ (n ⟨W, hW⟩)
      (b ⟨W, hW⟩) (hb ⟨W, hW⟩) t hxW
    exact ⟨⟨⟨W, hW⟩, j⟩, hj⟩
  have hUa : ∀ k, IsAffineOpen (Uk k).1 := fun k => (Uk k).2
  have hchart : ∀ k, ∃ (R : CommRingCat.{u}) (φ : Γ(X, (Uk k).1) ⟶ R),
      φ.hom (ak k) ∈ nonZeroDivisors R ∧
      Ideal.map φ.hom (I.ideal (Uk k)) = Ideal.span {φ.hom (ak k)} ∧
      ∀ (B : CommRingCat.{u}) (ρ : Γ(X, (Uk k).1) ⟶ B), ρ.hom (ak k) ∈ nonZeroDivisors B →
        Ideal.map ρ.hom (I.ideal (Uk k)) = Ideal.span {ρ.hom (ak k)} →
        ∃! ψ : R ⟶ B, φ ≫ ψ = ρ := fun k =>
    hchartgen Γ(X, (Uk k).1) (I.ideal (Uk k)) (ak k) (hak k)
  choose R φ hnz hid hUP using hchart
  have htopk : ∀ k, (⊤ : (Spec (R k)).Opens) ≤
      (Spec.map (φ k) ≫ (hUa k).fromSpec) ⁻¹ᵁ (Uk k).1 := by
    intro k x _
    show (Spec.map (φ k) ≫ (hUa k).fromSpec) x ∈ ((Uk k).1 : Set X)
    rw [Scheme.Hom.comp_apply, ← (hUa k).range_fromSpec]
    exact ⟨_, rfl⟩
  have hL4c := fun k => wc_csd_chart_spec_maps X (Uk k).1 (hUa k) (R k) (φ k)

  have hPres : ∀ (T T' : Scheme.{u}) (j : T' ⟶ T) [IsOpenImmersion j] (h : T ⟶ X),
      wcCsdInvPull I h → wcCsdInvPull I (j ≫ h) := by
    intro T T' j _ h hP
    rw [hInv] at hP ⊢
    intro t'
    obtain ⟨U, a, ha, hc⟩ := hP (j t')
    exact ⟨U, a, ha, (wc_csd_chart_open_imm X T T' I j h U a t').mp hc⟩

  have hPloc : ∀ (T : Scheme.{u}) (h : T ⟶ X),
      (∀ t : T, ∃ W : T.Opens, t ∈ W ∧ wcCsdInvPull I (W.ι ≫ h)) → wcCsdInvPull I h := by
    intro T h H
    rw [hInv]
    intro t
    obtain ⟨W, htW, hW⟩ := H t
    rw [hInv] at hW
    obtain ⟨U, a, ha, hc⟩ := hW ⟨t, htW⟩
    exact ⟨U, a, ha, (wc_csd_chart_open_imm X T W.toScheme I W.ι h U a ⟨t, htW⟩).mpr hc⟩

  have hGres : ∀ (k : K) (T T' : Scheme.{u}) (j : T' ⟶ T) [IsOpenImmersion j] (h : T ⟶ X),
      (∀ t : T, wcCsdChartAt I h (Uk k) (ak k) t) →
      ∀ t' : T', wcCsdChartAt I (j ≫ h) (Uk k) (ak k) t' := by
    intro k T T' j _ h hG t'
    exact (wc_csd_chart_open_imm X T T' I j h (Uk k) (ak k) t').mp (hG (j t'))

  have hGloc : ∀ (k : K) (T : Scheme.{u}) (h : T ⟶ X),
      (∀ t : T, ∃ W : T.Opens, t ∈ W ∧
        ∀ w : W.toScheme, wcCsdChartAt I (W.ι ≫ h) (Uk k) (ak k) w) →
      ∀ t : T, wcCsdChartAt I h (Uk k) (ak k) t := by
    intro k T h H t
    obtain ⟨W, htW, hW⟩ := H t
    exact (wc_csd_chart_open_imm X T W.toScheme I W.ι h (Uk k) (ak k) ⟨t, htW⟩).mpr
      (hW ⟨t, htW⟩)

  have hCov : ∀ (T : Scheme.{u}) (h : T ⟶ X), wcCsdInvPull I h → ∀ t : T,
      ∃ (k : K) (W : T.Opens), t ∈ W ∧
        ∀ w : W.toScheme, wcCsdChartAt I (W.ι ≫ h) (Uk k) (ak k) w := by
    intro T h hP t
    obtain ⟨k, V, e, htV, h1, h2⟩ := hcovK T h hP t
    refine ⟨k, V.1, htV, fun w => ?_⟩
    exact (wc_csd_chart_open_imm X T V.1.toScheme I V.1.ι h (Uk k) (ak k) w).mp
      ⟨V, e, w.2, h1, h2⟩

  have hGp : ∀ k (y : Spec (R k)),
      wcCsdChartAt I (Spec.map (φ k) ≫ (hUa k).fromSpec) (Uk k) (ak k) y := by
    intro k y
    refine ⟨⟨⊤, isAffineOpen_top _⟩, htopk k, trivial, ?_, ?_⟩
    · show ((Spec.map (φ k) ≫ (hUa k).fromSpec).appLE (Uk k).1 ⊤ (htopk k)).hom (ak k) ∈
        nonZeroDivisors Γ(Spec (R k), ⊤)
      rw [(hL4c k).1 (htopk k)]
      exact hisoNZD (Scheme.ΓSpecIso (R k)).symm _ (hnz k)
    · show Ideal.map ((Spec.map (φ k) ≫ (hUa k).fromSpec).appLE (Uk k).1 ⊤ (htopk k)).hom
          (I.ideal (Uk k)) =
        Ideal.span {((Spec.map (φ k) ≫ (hUa k).fromSpec).appLE (Uk k).1 ⊤ (htopk k)).hom (ak k)}
      rw [(hL4c k).1 (htopk k)]
      exact hmapcomp (φ k) _ _ _ (hid k)

  have hGP : ∀ (k : K) (T : Scheme.{u}) (h : T ⟶ X),
      (∀ t : T, wcCsdChartAt I h (Uk k) (ak k) t) → wcCsdInvPull I h := by
    intro k T h hG
    rw [hInv]
    intro t
    exact ⟨Uk k, ak k, hak k, hG t⟩

  have hRep : ∀ (k : K) (T : Scheme.{u}) (h : T ⟶ X),
      (∀ t : T, wcCsdChartAt I h (Uk k) (ak k) t) →
      ∃! c : T ⟶ Spec (R k), c ≫ Spec.map (φ k) ≫ (hUa k).fromSpec = h := by
    intro k T h hG
    have e : (⊤ : T.Opens) ≤ h ⁻¹ᵁ (Uk k).1 := by
      intro t _
      obtain ⟨V, eV, htV, -, -⟩ := hG t
      exact eV htV
    obtain ⟨hnzT, hidT⟩ := wc_csd_chart_global_sections X T I h (Uk k) (ak k) (hak k) hG e
    obtain ⟨ψ, hψ, hψu⟩ := hUP k _ (h.appLE (Uk k).1 ⊤ e) hnzT hidT
    obtain ⟨c, hc, hcu⟩ := (hL4c k).2.2 T ψ
    refine ⟨c, ((hL4c k).2.1 T h e c).mpr (by rw [hc]; exact hψ), fun c' hc' => ?_⟩
    exact hcu c' (hψu _ (((hL4c k).2.1 T h e c').mp hc'))

  have hInto : ∀ (k : K) (T : Scheme.{u}) (c : T ⟶ Spec (R k)),
      wcCsdInvPull I (c ≫ Spec.map (φ k) ≫ (hUa k).fromSpec) →
      ∀ t : T, wcCsdChartAt I (c ≫ Spec.map (φ k) ≫ (hUa k).fromSpec) (Uk k) (ak k) t := by
    intro k T c hP t
    obtain ⟨j, V, e, htV, hnzb, hidb⟩ := wc_csd_invpull_generator_chart X T I _ hP (Uk k)
      (n (Uk k)) (b (Uk k)) (hb (Uk k)) t
      (htopk k (show c t ∈ (⊤ : (Spec (R k)).Opens) from trivial))
    have e2 : V.1 ≤ c ⁻¹ᵁ ⊤ := fun _ _ => trivial
    have hc : (c ≫ Spec.map (φ k) ≫ (hUa k).fromSpec).appLE (Uk k).1 V.1 e =
        φ k ≫ ((Scheme.ΓSpecIso (R k)).inv ≫ c.appLE ⊤ V.1 e2) := by
      rw [← Scheme.Hom.appLE_comp_appLE c (Spec.map (φ k) ≫ (hUa k).fromSpec) (Uk k).1 ⊤ V.1
        (htopk k) e2, (hL4c k).1 (htopk k), Category.assoc]
    rw [hc] at hnzb hidb
    obtain ⟨h1, h2⟩ := hL5a (φ k) _ _ (ak k) _ (hid k) hnzb hidb
    exact ⟨V, e, htV, by rw [hc]; exact h1, by rw [hc]; exact h2⟩

  have hOpen : ∀ (k : K) (T T' : Scheme.{u}) (h : T ⟶ X) (g : T' ⟶ T), wcCsdInvPull I h →
      (∀ t' : T', wcCsdChartAt I (g ≫ h) (Uk k) (ak k) t') →
      ∀ t' : T', ∃ W : T.Opens, g t' ∈ W ∧
        ∀ w : W.toScheme, wcCsdChartAt I (W.ι ≫ h) (Uk k) (ak k) w := by
    intro k T T' h g hP hG t'
    have hmem : h (g t') ∈ (Uk k).1 := by
      obtain ⟨V, eV, htV, -, -⟩ := hG t'
      exact eV htV
    obtain ⟨j, hcb⟩ := wc_csd_invpull_generator_chart X T I h hP (Uk k) (n (Uk k)) (b (Uk k))
      (hb (Uk k)) (g t') hmem
    obtain ⟨W, eW, hgW, h1, h2⟩ :=
      wc_csd_good_locus_open X T T' I h g (Uk k) (ak k) _ t' (hak k) hcb (hG t')
    refine ⟨W.1, hgW, fun w => ?_⟩
    exact (wc_csd_chart_open_imm X T W.1.toScheme I W.1.ι h (Uk k) (ak k) w).mp
      ⟨W, eW, w.2, h1, h2⟩

  obtain ⟨X', r, s, hbl, -, -, -⟩ := wc_csd_glue_local_universal X K (fun k => Spec (R k))
    (fun k => Spec.map (φ k) ≫ (hUa k).fromSpec) (fun T h => wcCsdInvPull I h)
    (fun k T h => ∀ t : T, wcCsdChartAt I h (Uk k) (ak k) t)
    hPres hPloc hGres hGloc hCov hGp hGP hRep hInto hOpen
  exact ⟨X', r, hbl⟩

theorem wcpa_dj_ms_bfp_ring_chart_generators : ∀ (R : Type u) [CommRing R] (N : ℕ) (X : Scheme.{u}) (j : X ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) MvPolynomial.gradedAlgebra) (I : X.IdealSheafData), IsClosedImmersion j → (∀ U : X.affineOpens, (I.ideal U).FG) → ∃ (m : ℕ) (g : ∀ J : Fin (N + 1), Fin (m + 1) → Γ(X, j ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) MvPolynomial.gradedAlgebra (MvPolynomial.X J))) (w : ∀ J L : Fin (N + 1), Γ(X, j ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) MvPolynomial.gradedAlgebra (MvPolynomial.X J) ⊓ j ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) MvPolynomial.gradedAlgebra (MvPolynomial.X L))), (∀ (J : Fin (N + 1)) (hJ : IsAffineOpen (j ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) MvPolynomial.gradedAlgebra (MvPolynomial.X J))), I.ideal ⟨j ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) MvPolynomial.gradedAlgebra (MvPolynomial.X J), hJ⟩ = Ideal.span (Set.range (g J))) ∧ (∀ J L, IsUnit (w J L)) ∧ (∀ J L (l : Fin (m + 1)), X.presheaf.map (homOfLE (inf_le_right : j ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) MvPolynomial.gradedAlgebra (MvPolynomial.X J) ⊓ j ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) MvPolynomial.gradedAlgebra (MvPolynomial.X L) ≤ j ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) MvPolynomial.gradedAlgebra (MvPolynomial.X L))).op (g L l) = w J L * X.presheaf.map (homOfLE (inf_le_left : j ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) MvPolynomial.gradedAlgebra (MvPolynomial.X J) ⊓ j ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) MvPolynomial.gradedAlgebra (MvPolynomial.X L) ≤ j ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) MvPolynomial.gradedAlgebra (MvPolynomial.X J))).op (g J l)) :=
by
  intro R _ N X j I hj hI
