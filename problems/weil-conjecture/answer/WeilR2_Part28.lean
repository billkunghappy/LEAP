theorem wcpa_dj_flrg_sc_psi_surj : ∀ (k : Type u) [Field k] (N : ℕ) (B : Scheme.{u}) (sB : B ⟶ Spec (.of k)) (V : B.Opens), IsAffineOpen V → ∀ i, Function.Surjective (wcpaDjFlrgPsi k N sB V i) :=
by

  have wc_closed_in_product_chart_gen : ∀ (S X Y Y' : Scheme.{u}) [IsAffine S] (f : X ⟶ S) (g : Y ⟶ S) (ι : Y' ⟶ Limits.pullback f g) [IsClosedImmersion ι] (U : X.Opens) (C : Y.Opens), IsAffineOpen U → IsAffineOpen C → IsAffineOpen ((ι ≫ Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (ι ≫ Limits.pullback.snd f g) ⁻¹ᵁ C) ∧ ∀ t : Γ(Y', (ι ≫ Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (ι ≫ Limits.pullback.snd f g) ⁻¹ᵁ C), t ∈ Subring.closure (Set.range ((Y'.presheaf.map (homOfLE (inf_le_left : (ι ≫ Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (ι ≫ Limits.pullback.snd f g) ⁻¹ᵁ C ≤ (ι ≫ Limits.pullback.fst f g) ⁻¹ᵁ U)).op).hom.comp ((ι ≫ Limits.pullback.fst f g).app U).hom) ∪ Set.range ((Y'.presheaf.map (homOfLE (inf_le_right : (ι ≫ Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (ι ≫ Limits.pullback.snd f g) ⁻¹ᵁ C ≤ (ι ≫ Limits.pullback.snd f g) ⁻¹ᵁ C)).op).hom.comp ((ι ≫ Limits.pullback.snd f g).app C).hom)) := by
    intro S X Y Y' _ f g ι _ U C hU hC

    have s2 : ∀ (R A B P : CommRingCat.{u}) (f : R ⟶ A) (g : R ⟶ B) (inl : A ⟶ P) (inr : B ⟶ P),
        IsPushout f g inl inr → ∀ x : P, x ∈ Subring.closure (Set.range inl.hom ∪ Set.range inr.hom) := by
      intro R A B P f g inl inr hP x
      let S := Subring.closure (Set.range inl.hom ∪ Set.range inr.hom)
      let inl' : A ⟶ CommRingCat.of S := CommRingCat.ofHom (RingHom.codRestrict inl.hom S
        (fun a => Subring.subset_closure (Or.inl ⟨a, rfl⟩)))
      let inr' : B ⟶ CommRingCat.of S := CommRingCat.ofHom (RingHom.codRestrict inr.hom S
        (fun b => Subring.subset_closure (Or.inr ⟨b, rfl⟩)))
      have hw : f ≫ inl' = g ≫ inr' := by
        ext y
        exact ConcreteCategory.congr_hom hP.w y
      let d := hP.desc inl' inr' hw
      have hε : d ≫ CommRingCat.ofHom S.subtype = 𝟙 P := by
        apply hP.hom_ext
        · rw [Category.comp_id, ← Category.assoc, hP.inl_desc]
          ext a
          rfl
        · rw [Category.comp_id, ← Category.assoc, hP.inr_desc]
          ext a
          rfl
      have hx : (S.subtype (d x)) = x := by
        have := ConcreteCategory.congr_hom hε x
        exact this
      rw [← hx]
      exact (d x).property

    have s3 : ∀ (X Y : Scheme.{u}) (f : X ⟶ Y) (U : Y.Opens) (V : X.Opens) (e : V ≤ f ⁻¹ᵁ U),
        (f.resLE U V e).appTop ≫ V.topIso.hom = U.topIso.hom ≫ f.appLE U V e := by
      intro X Y f U V e
      rw [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE, Scheme.Hom.resLE_appLE,
        Scheme.Opens.topIso_hom, Scheme.Opens.topIso_hom]
      erw [Scheme.Hom.appLE_map, Scheme.Hom.map_appLE]

    have hP : IsPullback
        ((Limits.pullback.fst f g).resLE U ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓
          (Limits.pullback.snd f g) ⁻¹ᵁ C) inf_le_left)
        ((Limits.pullback.snd f g).resLE C ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓
          (Limits.pullback.snd f g) ⁻¹ᵁ C) inf_le_right)
        (U.ι ≫ f) (C.ι ≫ g) := by
      have comm : (Limits.pullback.fst f g).resLE U ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓
          (Limits.pullback.snd f g) ⁻¹ᵁ C) inf_le_left ≫ (U.ι ≫ f) =
          (Limits.pullback.snd f g).resLE C ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓
          (Limits.pullback.snd f g) ⁻¹ᵁ C) inf_le_right ≫ (C.ι ≫ g) := by
        rw [← Category.assoc, Scheme.Hom.resLE_comp_ι, ← Category.assoc, Scheme.Hom.resLE_comp_ι,
          Category.assoc, Category.assoc, Limits.pullback.condition]
      have hc : ∀ (s : Limits.PullbackCone (U.ι ≫ f) (C.ι ≫ g)),
          (s.fst ≫ U.ι) ≫ f = (s.snd ≫ C.ι) ≫ g := by
        intro s
        rw [Category.assoc, Category.assoc]
        exact s.condition
      have hrange : ∀ (s : Limits.PullbackCone (U.ι ≫ f) (C.ι ≫ g)),
          Set.range (Limits.pullback.lift (s.fst ≫ U.ι) (s.snd ≫ C.ι) (hc s)) ⊆
            Set.range ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (Limits.pullback.snd f g) ⁻¹ᵁ C).ι := by
        intro s
        rw [Scheme.Opens.range_ι]
        rintro _ ⟨x, rfl⟩
        refine ⟨?_, ?_⟩
        · show (Limits.pullback.fst f g) (Limits.pullback.lift (s.fst ≫ U.ι) (s.snd ≫ C.ι) (hc s) x) ∈ U
          rw [← Scheme.Hom.comp_apply, Limits.pullback.lift_fst, Scheme.Hom.comp_apply]
          have h : U.ι (s.fst x) ∈ Set.range U.ι := ⟨_, rfl⟩
          rwa [Scheme.Opens.range_ι] at h
        · show (Limits.pullback.snd f g) (Limits.pullback.lift (s.fst ≫ U.ι) (s.snd ≫ C.ι) (hc s) x) ∈ C
          rw [← Scheme.Hom.comp_apply, Limits.pullback.lift_snd, Scheme.Hom.comp_apply]
          have h : C.ι (s.snd x) ∈ Set.range C.ι := ⟨_, rfl⟩
          rwa [Scheme.Opens.range_ι] at h
      refine IsPullback.of_isLimit (c := Limits.PullbackCone.mk _ _ comm) ?_
      refine Limits.PullbackCone.IsLimit.mk comm
        (fun s => IsOpenImmersion.lift _ _ (hrange s)) ?_ ?_ ?_
      · intro s
        rw [← cancel_mono U.ι, Category.assoc, Scheme.Hom.resLE_comp_ι, ← Category.assoc,
          IsOpenImmersion.lift_fac, Limits.pullback.lift_fst]
      · intro s
        rw [← cancel_mono C.ι, Category.assoc, Scheme.Hom.resLE_comp_ι, ← Category.assoc,
          IsOpenImmersion.lift_fac, Limits.pullback.lift_snd]
      · intro s m h1 h2
        apply IsOpenImmersion.lift_uniq
        apply Limits.pullback.hom_ext
        · rw [Limits.pullback.lift_fst, ← h1, Category.assoc, Category.assoc, Scheme.Hom.resLE_comp_ι]
        · rw [Limits.pullback.lift_snd, ← h2, Category.assoc, Category.assoc, Scheme.Hom.resLE_comp_ι]
    haveI : IsAffine (U : Scheme.{u}) := hU
    haveI : IsAffine (C : Scheme.{u}) := hC
    have hOaff : IsAffineOpen ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓
        (Limits.pullback.snd f g) ⁻¹ᵁ C) := IsAffine.of_isIso hP.isoPullback.hom
    have hgen := s2 _ _ _ _ _ _ _ _ (isPushout_appTop_of_isPullback hP)

    have hOgen : ∀ t : Γ(Limits.pullback f g, (Limits.pullback.fst f g) ⁻¹ᵁ U ⊓
        (Limits.pullback.snd f g) ⁻¹ᵁ C), t ∈ Subring.closure
          (Set.range (((Limits.pullback f g).presheaf.map (homOfLE (inf_le_left :
            (Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (Limits.pullback.snd f g) ⁻¹ᵁ C ≤
              (Limits.pullback.fst f g) ⁻¹ᵁ U)).op).hom.comp ((Limits.pullback.fst f g).app U).hom) ∪
          Set.range (((Limits.pullback f g).presheaf.map (homOfLE (inf_le_right :
            (Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (Limits.pullback.snd f g) ⁻¹ᵁ C ≤
              (Limits.pullback.snd f g) ⁻¹ᵁ C)).op).hom.comp ((Limits.pullback.snd f g).app C).hom)) := by
      intro t
      have ht : ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (Limits.pullback.snd f g) ⁻¹ᵁ C).topIso.hom
          (((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (Limits.pullback.snd f g) ⁻¹ᵁ C).topIso.inv t)
          = t := by
        exact ConcreteCategory.congr_hom
          ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (Limits.pullback.snd f g) ⁻¹ᵁ C).topIso.inv_hom_id t
      rw [← ht, ← Subring.mem_comap]
      refine (Subring.closure_le.mpr ?_) (hgen _)
      rintro _ (⟨y, rfl⟩ | ⟨z, rfl⟩)
      · rw [SetLike.mem_coe, Subring.mem_comap]
        apply Subring.subset_closure
        left
        refine ⟨U.topIso.hom y, ?_⟩
        have h := ConcreteCategory.congr_hom (s3 _ _ (Limits.pullback.fst f g) U
          ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (Limits.pullback.snd f g) ⁻¹ᵁ C) inf_le_left) y
        exact h.symm
      · rw [SetLike.mem_coe, Subring.mem_comap]
        apply Subring.subset_closure
        right
        refine ⟨C.topIso.hom z, ?_⟩
        have h := ConcreteCategory.congr_hom (s3 _ _ (Limits.pullback.snd f g) C
          ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (Limits.pullback.snd f g) ⁻¹ᵁ C) inf_le_right) z
        exact h.symm

    refine ⟨hOaff.preimage ι, fun t => ?_⟩
    let φ : Γ(Limits.pullback f g, (Limits.pullback.fst f g) ⁻¹ᵁ U ⊓
        (Limits.pullback.snd f g) ⁻¹ᵁ C) →+*
        Γ(Y', (ι ≫ Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (ι ≫ Limits.pullback.snd f g) ⁻¹ᵁ C) :=
      (ι.app ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (Limits.pullback.snd f g) ⁻¹ᵁ C)).hom
    obtain ⟨s, hs⟩ : ∃ s, φ s = t :=
      Scheme.Hom.app_surjective ι _ hOaff t
    rw [← hs, ← Subring.mem_comap]
    refine (Subring.closure_le.mpr ?_) (hOgen s)
    rintro _ (⟨a, rfl⟩ | ⟨b, rfl⟩)
    · rw [SetLike.mem_coe, Subring.mem_comap]
      apply Subring.subset_closure
      left
      refine ⟨a, ?_⟩
      have h := ConcreteCategory.congr_hom (ι.naturality (homOfLE (inf_le_left :
        (Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (Limits.pullback.snd f g) ⁻¹ᵁ C ≤
          (Limits.pullback.fst f g) ⁻¹ᵁ U)).op) ((Limits.pullback.fst f g).app U a)
      exact h.symm
    · rw [SetLike.mem_coe, Subring.mem_comap]
      apply Subring.subset_closure
      right
      refine ⟨b, ?_⟩
      have h := ConcreteCategory.congr_hom (ι.naturality (homOfLE (inf_le_right :
        (Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (Limits.pullback.snd f g) ⁻¹ᵁ C ≤
          (Limits.pullback.snd f g) ⁻¹ᵁ C)).op) ((Limits.pullback.snd f g).app C b)
      exact h.symm

  have wc_ldpi_oai_proj_gen : ∀ (K : Type u) [Field K] (n : ℕ) (J : Fin (n + 1))
      (x : Γ(wcProjK K n, wcSgD K n J)),
      x ∈ Subring.closure (Set.range (wcSgE K n J) ∪ Set.range (fun c : K => (wcProjK K n).presheaf.map
        (homOfLE (le_top : wcSgD K n J ≤ ⊤)).op ((wcProjKStr K n).appTop ((Scheme.ΓSpecIso (.of K)).inv c)))) := by
    intro K _ n J x
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) := MvPolynomial.gradedAlgebra
    have hX : ∀ k : Fin (n + 1), (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 1 := fun k =>
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)
    have GEN : ∀ (k : Fin (n + 1)) (d : ℕ) (F : MvPolynomial (Fin (n + 1)) K)
        (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K (d • 1)),
        MvPolynomial.eval₂ ((HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (Submonoid.powers (MvPolynomial.X k))).comp
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0)))
          (fun l => HomogeneousLocalization.Away.mk
            (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX k) 1
            (MvPolynomial.X l) (hX l)) F =
        HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX k) d F hF := by
      intro k d F hF
      have hFh : F.IsHomogeneous d := by
        have := (MvPolynomial.mem_homogeneousSubmodule (d • 1) F).mp hF
        simpa using this
      have scale : ∀ {L : Type u} [CommRing L] (χ : K →+* L) (g : Fin (n + 1) → L) (t : L),
          MvPolynomial.eval₂ χ (fun l => g l * t) F = t ^ d * MvPolynomial.eval₂ χ g F := by
        intro L _ χ g t
        rw [MvPolynomial.eval₂_eq, MvPolynomial.eval₂_eq, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun e he => ?_)
        have hdeg : ∑ i ∈ e.support, e i = d := by
          by_contra hne
          exact (MvPolynomial.mem_support_iff.mp he) (hFh.coeff_eq_zero hne)
        simp_rw [mul_pow]
        rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
        ring
      apply HomogeneousLocalization.val_injective
      rw [← HomogeneousLocalization.algebraMap_apply, ← HomogeneousLocalization.algebraMap_apply,
        MvPolynomial.eval₂_comp_left, HomogeneousLocalization.algebraMap_apply,
        HomogeneousLocalization.Away.val_mk]
      calc _ = MvPolynomial.eval₂
            ((algebraMap (MvPolynomial (Fin (n + 1)) K)
              (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K)))).comp
              MvPolynomial.C)
            (fun l => algebraMap (MvPolynomial (Fin (n + 1)) K)
              (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K)))
              (MvPolynomial.X l) * Localization.mk 1 (⟨MvPolynomial.X k ^ 1, ⟨1, rfl⟩⟩ :
                Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K))) F := by
            congr 1
            funext l
            simp only [Function.comp_apply, HomogeneousLocalization.algebraMap_apply,
              HomogeneousLocalization.Away.val_mk, ← Localization.mk_one_eq_algebraMap,
              Localization.mk_mul, mul_one, one_mul]
        _ = _ := by
            rw [scale]
            have h2 := MvPolynomial.eval₂_comp_left (algebraMap (MvPolynomial (Fin (n + 1)) K)
              (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K))))
              MvPolynomial.C MvPolynomial.X F
            rw [MvPolynomial.eval₂_eta] at h2
            rw [show (fun l => algebraMap (MvPolynomial (Fin (n + 1)) K)
                (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K)))
                (MvPolynomial.X l)) = ⇑(algebraMap (MvPolynomial (Fin (n + 1)) K)
                (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K)))) ∘
                MvPolynomial.X from rfl, ← h2, Localization.mk_pow,
              ← Localization.mk_one_eq_algebraMap, Localization.mk_mul, Localization.mk_eq_mk_iff,
              Localization.r_iff_exists]
            refine ⟨1, ?_⟩
            simp only [one_pow, one_mul, mul_one, OneMemClass.coe_one, SubmonoidClass.coe_pow, ← pow_mul]
    have hι : ∀ (U : (Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)).Opens) a,
        U.ι.appTop a = U.topIso.inv ((Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)).presheaf.map (homOfLE (le_top : U ≤ ⊤)).op a) := by
      intro U a
      rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_inv]
      erw [← CategoryTheory.comp_apply, ← Functor.map_comp]
      rfl
    have hconst : ∀ c : K, (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).hom
        (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
          (Submonoid.powers (MvPolynomial.X J)) (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0) c)) =
        ((Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)).presheaf.map (homOfLE (le_top : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)) ≤ ⊤)).op).hom ((Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥((MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) 0)))).appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c)) := by
      intro c
      have e0 : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).ι =
          (Proj.basicOpenIsoSpec _ (MvPolynomial.X J) (hX J) Nat.one_pos).hom ≫
            Proj.awayι _ (MvPolynomial.X J) (hX J) Nat.one_pos := by
        rw [← Proj.basicOpenIsoSpec_inv_ι, Iso.hom_inv_id_assoc]
      have e1 : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).ι ≫
          (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥((MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) 0)))) =
          (Proj.basicOpenIsoSpec _ (MvPolynomial.X J) (hX J) Nat.one_pos).hom ≫
            Spec.map (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (Submonoid.powers (MvPolynomial.X J))).comp
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0)))) := by
        rw [e0, Category.assoc, Proj.awayι_toSpecZero_assoc, ← Spec.map_comp]
        rfl
      have e2 := congrArg (fun g => (Scheme.Hom.appTop g).hom ((Scheme.ΓSpecIso (.of K)).inv.hom c)) e1
      simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at e2
      have e3 := congrArg (fun g => g.hom c) (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (Submonoid.powers (MvPolynomial.X J))).comp
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0)))))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e3
      rw [← e3] at e2
      have hi : ∀ y, (Proj.basicOpenIsoSpec _ (MvPolynomial.X J) (hX J) Nat.one_pos).hom.appTop
          ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)))).inv y) =
          (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.inv
            ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).hom y) := by
        intro y
        rw [Proj.basicOpenIsoSpec_hom]
        have hh := Proj.basicOpenToSpec_app_top (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)
        calc _ = ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)))).hom ≫ Proj.awayToSection _ (MvPolynomial.X J) ≫ (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.inv) ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)))).inv y) := by rw [← hh]
          _ = _ := by
            change (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.inv
              ((Proj.awayToSection _ (MvPolynomial.X J)) ((Scheme.ΓSpecIso _).hom ((Scheme.ΓSpecIso _).inv y))) = _
            rw [Iso.inv_hom_id_apply]
      have e4 := e2.trans (hi _)
      rw [hι] at e4
      have hinj : ∀ a b : Γ(Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K), Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)),
          (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.inv a =
            (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.inv b → a = b := by
        intro a b h
        have h' := congrArg (fun w => (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.hom w) h
        simp only [Iso.inv_hom_id_apply] at h'
        exact h'
      exact (hinj _ _ e4).symm
    have hs : Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        (MvPolynomial.X J) ((Proj.basicOpenIsoAway _ (MvPolynomial.X J) (hX J) Nat.one_pos).inv x) = x := by
      have := Iso.inv_hom_id_apply (Proj.basicOpenIsoAway _ (MvPolynomial.X J) (hX J) Nat.one_pos) x
      rwa [Proj.basicOpenIsoAway_hom] at this
    obtain ⟨d, F, hF, hmk⟩ := HomogeneousLocalization.Away.mk_surjective
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX J)
      ((Proj.basicOpenIsoAway _ (MvPolynomial.X J) (hX J) Nat.one_pos).inv x)
    rw [← hs, ← hmk, ← GEN J d F hF]
    change (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).hom _ ∈ _
    rw [MvPolynomial.eval₂_comp_left]
    apply MvPolynomial.eval₂_mem
    · intro i _
      apply Subring.subset_closure
      right
      exact ⟨F.coeff i, (hconst (F.coeff i)).symm⟩
    · intro l
      apply Subring.subset_closure
      left
      exact ⟨l, rfl⟩
  intro k _ N B sB V hV i

  have hU : IsAffineOpen (wcSgD k N i) :=
    @Proj.isAffineOpen_basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      MvPolynomial.gradedAlgebra (MvPolynomial.X i) 1
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k i)) one_pos

  have hgen := (wc_closed_in_product_chart_gen (Spec (.of k)) (wcProjK k N) B
    (Limits.pullback (wcProjKStr k N) sB) (wcProjKStr k N) sB (𝟙 _) (wcSgD k N i) V hU hV).2

  have key : ∀ s : Γ(Spec (.of k), ⊤),
      (Scheme.Hom.appLE (Limits.pullback.fst (wcProjKStr k N) sB) (wcSgD k N i)
        (wcpaDjFlrgChart k N sB V i) inf_le_left).hom
        (((wcProjK k N).presheaf.map (homOfLE (le_top : wcSgD k N i ≤ ⊤)).op).hom
          ((wcProjKStr k N).appTop.hom s)) =
      (Scheme.Hom.appLE (Limits.pullback.snd (wcProjKStr k N) sB) V
        (wcpaDjFlrgChart k N sB V i) inf_le_right).hom
        ((B.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom (sB.appTop.hom s)) := by
    intro s
    have e1 : (wcProjKStr k N).appTop ≫ (wcProjK k N).presheaf.map
        (homOfLE (le_top : wcSgD k N i ≤ ⊤)).op ≫
        Scheme.Hom.appLE (Limits.pullback.fst (wcProjKStr k N) sB) (wcSgD k N i)
          (wcpaDjFlrgChart k N sB V i) inf_le_left =
        Scheme.Hom.appLE (Limits.pullback.fst (wcProjKStr k N) sB ≫ wcProjKStr k N) ⊤
          (wcpaDjFlrgChart k N sB V i) (by rw [Scheme.Hom.preimage_top]; exact le_top) := by
      rw [Scheme.Hom.map_appLE, Scheme.Hom.comp_appLE]
      rfl
    have e2 : sB.appTop ≫ B.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op ≫
        Scheme.Hom.appLE (Limits.pullback.snd (wcProjKStr k N) sB) V
          (wcpaDjFlrgChart k N sB V i) inf_le_right =
        Scheme.Hom.appLE (Limits.pullback.snd (wcProjKStr k N) sB ≫ sB) ⊤
          (wcpaDjFlrgChart k N sB V i) (by rw [Scheme.Hom.preimage_top]; exact le_top) := by
      rw [Scheme.Hom.map_appLE, Scheme.Hom.comp_appLE]
      rfl
    have aux : ∀ (φ₁ φ₂ : Limits.pullback (wcProjKStr k N) sB ⟶ Spec (.of k)) (_ : φ₁ = φ₂)
        (h₁ : wcpaDjFlrgChart k N sB V i ≤ φ₁ ⁻¹ᵁ ⊤) (h₂ : wcpaDjFlrgChart k N sB V i ≤ φ₂ ⁻¹ᵁ ⊤),
        Scheme.Hom.appLE φ₁ ⊤ (wcpaDjFlrgChart k N sB V i) h₁ =
          Scheme.Hom.appLE φ₂ ⊤ (wcpaDjFlrgChart k N sB V i) h₂ := by
      rintro _ _ rfl _ _
      rfl
    have e3 := e1.trans ((aux _ _ Limits.pullback.condition _ _).trans e2.symm)
    have e4 := congrArg (fun φ => φ.hom s) e3
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e4
    exact e4
  intro t
  have ht := hgen t
  have hmem : t ∈ (wcpaDjFlrgPsi k N sB V i).range := by
    refine (Subring.closure_le.mpr ?_) ht
    rintro y (⟨x, rfl⟩ | ⟨a, rfl⟩)
    ·
      have hx := wc_ldpi_oai_proj_gen k N i x
      have hx' : x ∈ (wcpaDjFlrgPsi k N sB V i).range.comap
          (((Limits.pullback (wcProjKStr k N) sB).presheaf.map (homOfLE (inf_le_left :
            wcpaDjFlrgChart k N sB V i ≤ Limits.pullback.fst (wcProjKStr k N) sB ⁻¹ᵁ wcSgD k N i)).op).hom.comp
            ((Limits.pullback.fst (wcProjKStr k N) sB).app (wcSgD k N i)).hom) := by
        refine (Subring.closure_le.mpr ?_) hx
        rintro z (⟨l, rfl⟩ | ⟨c, rfl⟩)
        · refine ⟨MvPolynomial.X l, ?_⟩
          unfold wcpaDjFlrgPsi
          rw [MvPolynomial.eval₂Hom_X']
          rfl
        · refine ⟨MvPolynomial.C ((B.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom
            (sB.appTop.hom ((Scheme.ΓSpecIso (.of k)).inv.hom c))), ?_⟩
          unfold wcpaDjFlrgPsi
          rw [MvPolynomial.eval₂Hom_C]
          exact (key _).symm
      exact hx'
    · refine ⟨MvPolynomial.C a, ?_⟩
      unfold wcpaDjFlrgPsi
      rw [MvPolynomial.eval₂Hom_C]
      rfl
  exact RingHom.mem_range.mp hmem

theorem wcpa_dj_flrg_sc_dehomog_flat : ∀ (k : Type u) [Field k] (N : ℕ) (B Z : Scheme.{u}) (sB : B ⟶ Spec (.of k)) (jZ : Z ⟶ wcProjK k N) (g : Z ⟶ B) (hZ : jZ ≫ wcProjKStr k N = g ≫ sB), IsClosedImmersion (Limits.pullback.lift jZ g hZ) → Flat g → ∀ (V : B.Opens), IsAffineOpen V → ∀ i, Function.Surjective (wcpaDjFlrgPsi k N sB V i) → RingHom.ker (((Limits.pullback.lift jZ g hZ).app (wcpaDjFlrgChart k N sB V i)).hom.comp (wcpaDjFlrgPsi k N sB V i)) = wcpaDjFlrgSat k N sB jZ g hZ V ⊔ Ideal.span {MvPolynomial.X i - 1} → Module.Flat Γ(B, V) (MvPolynomial (Fin (N + 1)) Γ(B, V) ⧸ (wcpaDjFlrgSat k N sB jZ g hZ V ⊔ Ideal.span {MvPolynomial.X i - 1})) :=
by
  intro k _ N B Z sB jZ g hZ hε hg V hV i hψ hker
  set ε := Limits.pullback.lift jZ g hZ with hεdef
  set I := wcpaDjFlrgSat k N sB jZ g hZ V ⊔ Ideal.span {MvPolynomial.X i - 1} with hIdef
  haveI := hε

  have hXi : (MvPolynomial.X i : MvPolynomial (Fin (N + 1)) k) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1 :=
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k i)
  have hD : IsAffineOpen (wcSgD k N i) :=
    Proj.isAffineOpen_basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      (MvPolynomial.X i) hXi Nat.one_pos
  have hprod : ∀ (S X Y : Scheme.{u}) [IsAffine S] (f : X ⟶ S) (g : Y ⟶ S) (U : X.Opens)
      (W : Y.Opens), IsAffineOpen U → IsAffineOpen W →
      IsAffineOpen (Limits.pullback.fst f g ⁻¹ᵁ U ⊓ Limits.pullback.snd f g ⁻¹ᵁ W) := by
    intro S X Y _ f g U W hU hW
    haveI : IsAffine U := hU
    haveI : IsAffine W := hW
    let m := Limits.pullback.map (U.ι ≫ f) (W.ι ≫ g) f g U.ι W.ι (𝟙 S) (by simp) (by simp)
    haveI : IsOpenImmersion m := by
      unfold m
      infer_instance
    have hm : m.opensRange = Limits.pullback.fst f g ⁻¹ᵁ U ⊓ Limits.pullback.snd f g ⁻¹ᵁ W := by
      apply TopologicalSpace.Opens.ext
      rw [Scheme.Hom.coe_opensRange]
      have := Scheme.Pullback.range_map (U.ι ≫ f) (W.ι ≫ g) f g U.ι W.ι (𝟙 S) (by simp) (by simp)
      rw [this]
      simp
    rw [← hm]
    exact isAffineOpen_opensRange m
  have hC : IsAffineOpen (wcpaDjFlrgChart k N sB V i) :=
    hprod (Spec (.of k)) (wcProjK k N) B (wcProjKStr k N) sB (wcSgD k N i) V hD hV

  have hO : IsAffineOpen (ε ⁻¹ᵁ wcpaDjFlrgChart k N sB V i) := hC.preimage ε

  have h1 : Function.Surjective (ε.app (wcpaDjFlrgChart k N sB V i)).hom :=
    ε.app_surjective _ hC
  have hΦ : Function.Surjective
      ((ε.app (wcpaDjFlrgChart k N sB V i)).hom.comp (wcpaDjFlrgPsi k N sB V i)) := by
    rw [RingHom.coe_comp]; exact h1.comp hψ

  let θ : (MvPolynomial (Fin (N + 1)) Γ(B, V) ⧸ I) ≃+* Γ(Z, ε ⁻¹ᵁ wcpaDjFlrgChart k N sB V i) :=
    (Ideal.quotEquivOfEq hker.symm).trans (RingHom.quotientKerEquivOfSurjective hΦ)
  have hθ : ∀ F, θ (Ideal.Quotient.mk I F) =
      (ε.app (wcpaDjFlrgChart k N sB V i)).hom (wcpaDjFlrgPsi k N sB V i F) := by
    intro F
    simp only [θ, RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk,
      RingHom.quotientKerEquivOfSurjective_apply_mk, RingHom.comp_apply]

  have e : ε ⁻¹ᵁ wcpaDjFlrgChart k N sB V i ≤
      (ε ≫ Limits.pullback.snd (wcProjKStr k N) sB) ⁻¹ᵁ V := by
    rw [Scheme.Hom.comp_preimage]; exact ε.preimage_mono inf_le_right
  have hcomp : (Limits.pullback.snd (wcProjKStr k N) sB).appLE V (wcpaDjFlrgChart k N sB V i)
        inf_le_right ≫ ε.app (wcpaDjFlrgChart k N sB V i) =
      (ε ≫ Limits.pullback.snd (wcProjKStr k N) sB).appLE V
        (ε ⁻¹ᵁ wcpaDjFlrgChart k N sB V i) e := by
    rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE]
  have hψC : ∀ a : Γ(B, V), wcpaDjFlrgPsi k N sB V i (MvPolynomial.C a) =
      ((Limits.pullback.snd (wcProjKStr k N) sB).appLE V (wcpaDjFlrgChart k N sB V i)
        inf_le_right).hom a := by
    intro a
    simp only [wcpaDjFlrgPsi, MvPolynomial.eval₂Hom_C]
  have hstar : algebraMap Γ(B, V) (MvPolynomial (Fin (N + 1)) Γ(B, V) ⧸ I) =
      (θ.symm : Γ(Z, ε ⁻¹ᵁ wcpaDjFlrgChart k N sB V i) →+*
          (MvPolynomial (Fin (N + 1)) Γ(B, V) ⧸ I)).comp
        ((ε ≫ Limits.pullback.snd (wcProjKStr k N) sB).appLE V
          (ε ⁻¹ᵁ wcpaDjFlrgChart k N sB V i) e).hom := by
    apply RingHom.ext
    intro a
    rw [RingHom.comp_apply]
    apply θ.injective
    rw [RingEquiv.coe_toRingHom, RingEquiv.apply_symm_apply, ← Ideal.Quotient.mk_algebraMap,
      hθ, MvPolynomial.algebraMap_eq, hψC, ← hcomp, CommRingCat.hom_comp, RingHom.comp_apply]

  have hflat : Flat (ε ≫ Limits.pullback.snd (wcProjKStr k N) sB) := by
    rw [hεdef, Limits.pullback.lift_snd]; exact hg
  have hF : ((ε ≫ Limits.pullback.snd (wcProjKStr k N) sB).appLE V
      (ε ⁻¹ᵁ wcpaDjFlrgChart k N sB V i) e).hom.Flat :=
    HasRingHomProperty.appLE @Flat _ hflat ⟨V, hV⟩ ⟨ε ⁻¹ᵁ wcpaDjFlrgChart k N sB V i, hO⟩ e

  have hθflat : (θ.symm : Γ(Z, ε ⁻¹ᵁ wcpaDjFlrgChart k N sB V i) →+*
      (MvPolynomial (Fin (N + 1)) Γ(B, V) ⧸ I)).Flat :=
    RingHom.Flat.of_bijective θ.symm.bijective
  have hall : (algebraMap Γ(B, V) (MvPolynomial (Fin (N + 1)) Γ(B, V) ⧸ I)).Flat := by
    rw [hstar]; exact RingHom.Flat.comp hF hθflat
  exact RingHom.flat_algebraMap_iff.mp hall

theorem wcpa_dj_sf_frac_shift : ∀ (A : Type u) [CommRing A] (n : ℕ), (∀ (σ τ : Finset (Fin n)) (k j : ℕ) (f : MvPolynomial (Fin n) A), σ ⊆ τ → ∑ m ∈ ((∏ l ∈ σ, MvPolynomial.X l ^ j) * (∏ l ∈ τ \ σ, MvPolynomial.X l ^ (k + j)) * f).support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ τ then ((k + j : ℕ) : ℤ) else 0) (((∏ l ∈ σ, MvPolynomial.X l ^ j) * (∏ l ∈ τ \ σ, MvPolynomial.X l ^ (k + j)) * f).coeff m) = ∑ m ∈ f.support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0) (f.coeff m)) :=
by
  intro A _ n σ τ k j f hστ
  set s : Fin n →₀ ℕ := (∑ l ∈ σ, Finsupp.single l j) + (∑ l ∈ τ \ σ, Finsupp.single l (k + j))
    with hs_def
  have hprod : (∏ l ∈ σ, (MvPolynomial.X l : MvPolynomial (Fin n) A) ^ j) *
      (∏ l ∈ τ \ σ, (MvPolynomial.X l : MvPolynomial (Fin n) A) ^ (k + j)) =
      MvPolynomial.monomial s 1 := by
    simp only [MvPolynomial.X_pow_eq_monomial]
    rw [← MvPolynomial.monomial_sum_one, ← MvPolynomial.monomial_sum_one,
      MvPolynomial.monomial_mul, one_mul]
  have hs : ∀ i, (s i : ℤ) = (if i ∈ τ then ((k + j : ℕ) : ℤ) else 0) -
      (if i ∈ σ then (k : ℤ) else 0) := by
    intro i
    simp only [hs_def, Finsupp.add_apply, Finsupp.finset_sum_apply, Finsupp.single_apply,
      Finset.sum_ite_eq', Finset.mem_sdiff]
    by_cases h1 : i ∈ σ
    · have h2 : i ∈ τ := hστ h1
      simp [h1, h2]
    · by_cases h2 : i ∈ τ
      · simp [h1, h2]
      · simp [h1, h2]
  rw [hprod]
  have hcoeff : ∀ m, (MvPolynomial.monomial s (1 : A) * f).coeff (s + m) = f.coeff m := by
    intro m
    rw [MvPolynomial.coeff_monomial_mul, one_mul]
  symm
  refine Finset.sum_bij_ne_zero (fun m _ _ => s + m) ?_ ?_ ?_ ?_
  · intro m hm _
    rw [MvPolynomial.mem_support_iff, hcoeff]
    exact MvPolynomial.mem_support_iff.mp hm
  · intro a₁ _ _ a₂ _ _ h
    exact add_left_cancel h
  · intro b hb _
    have hb' := MvPolynomial.mem_support_iff.mp hb
    rw [MvPolynomial.coeff_monomial_mul'] at hb'
    by_cases hsb : s ≤ b
    · rw [if_pos hsb, one_mul] at hb'
      refine ⟨b - s, MvPolynomial.mem_support_iff.mpr hb', ?_, ?_⟩
      · exact Finsupp.single_ne_zero.mpr hb'
      · exact add_tsub_cancel_of_le hsb
    · rw [if_neg hsb] at hb'
      exact absurd rfl hb'
  · intro m _ _
    rw [hcoeff]
    congr 1
    funext i
    rw [Finsupp.add_apply, Nat.cast_add, hs i]
    ring

theorem wcpa_dj_sf_dehom_kernel : ∀ (A : Type u) [CommRing A] (N : ℕ) (J : Ideal (MvPolynomial (Fin (N + 1)) A)), (∀ F ∈ J, ∀ e : ℕ, MvPolynomial.homogeneousComponent e F ∈ J) → ∀ (i : Fin (N + 1)) (F : MvPolynomial (Fin (N + 1)) A) (t : ℕ), F.IsHomogeneous t → F ∈ J ⊔ Ideal.span {MvPolynomial.X i - 1} → ∃ M : ℕ, MvPolynomial.X i ^ M * F ∈ J :=
by
  intro A _ N J hJ i F t hF hmem
  classical
  obtain ⟨G, hG, z, hz, hGz⟩ := Submodule.mem_sup.mp hmem
  obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hz
  have hs : ∀ e : ℕ, MvPolynomial.homogeneousComponent (e + 1) (MvPolynomial.X i * a) =
      MvPolynomial.X i * MvPolynomial.homogeneousComponent e a := by
    intro e
    ext m
    rw [MvPolynomial.coeff_homogeneousComponent, MvPolynomial.coeff_X_mul',
      MvPolynomial.coeff_X_mul', MvPolynomial.coeff_homogeneousComponent]
    by_cases hm : i ∈ m.support
    · have hle : Finsupp.single i 1 ≤ m := by
        rw [Finsupp.single_le_iff]
        exact Nat.one_le_iff_ne_zero.mpr (Finsupp.mem_support_iff.mp hm)
      have hdeg : m.degree = (m - Finsupp.single i 1).degree + 1 := by
        conv_lhs => rw [← tsub_add_cancel_of_le hle]
        rw [map_add, Finsupp.degree_single]
      rw [if_pos hm, if_pos hm, hdeg]
      by_cases he : (m - Finsupp.single i 1).degree = e
      · rw [if_pos he, if_pos (by omega)]
      · rw [if_neg he, if_neg (by omega)]
    · rw [if_neg hm, if_neg hm, ite_self]
  have h0 : MvPolynomial.homogeneousComponent 0 (MvPolynomial.X i * a) = 0 := by
    ext m
    rw [MvPolynomial.coeff_homogeneousComponent, MvPolynomial.coeff_X_mul']
    by_cases hm : i ∈ m.support
    · have hdeg : m.degree ≠ 0 := by
        intro h
        rw [Finsupp.degree_eq_zero_iff] at h
        subst h
        simp at hm
      rw [if_neg hdeg]
      simp
    · rw [if_neg hm, ite_self]
      simp
  have hFc : ∀ n, MvPolynomial.homogeneousComponent n F = if n = t then F else 0 := fun n =>
    MvPolynomial.homogeneousComponent_of_mem ((MvPolynomial.mem_homogeneousSubmodule t F).mpr hF)
  have key : ∀ n, MvPolynomial.homogeneousComponent n F = MvPolynomial.homogeneousComponent n G
      + MvPolynomial.homogeneousComponent n (MvPolynomial.X i * a)
      - MvPolynomial.homogeneousComponent n a := by
    intro n
    rw [← hGz, show G + a * (MvPolynomial.X i - 1) = G + (MvPolynomial.X i * a - a) by ring,
      map_add, map_sub, add_sub_assoc]
  have Q : ∀ e : ℕ, MvPolynomial.homogeneousComponent e a +
      (if t ≤ e then MvPolynomial.X i ^ (e - t) * F else 0) ∈ J := by
    intro e
    induction e with
    | zero =>
      have k0 := key 0
      rw [h0, hFc 0] at k0
      by_cases ht : t = 0
      · subst ht
        rw [if_pos rfl] at k0
        rw [if_pos le_rfl, Nat.sub_self, pow_zero, one_mul]
        have : MvPolynomial.homogeneousComponent 0 a + F =
            MvPolynomial.homogeneousComponent 0 G := by
          linear_combination k0
        rw [this]
        exact hJ G hG 0
      · rw [if_neg (fun h => ht h.symm)] at k0
        rw [if_neg (by omega), add_zero]
        have : MvPolynomial.homogeneousComponent 0 a = MvPolynomial.homogeneousComponent 0 G := by
          linear_combination k0
        rw [this]
        exact hJ G hG 0
    | succ e ih =>
      have k1 := key (e + 1)
      rw [hs e, hFc (e + 1)] at k1
      have heq : MvPolynomial.homogeneousComponent (e + 1) a +
          (if t ≤ e + 1 then MvPolynomial.X i ^ (e + 1 - t) * F else 0) =
          MvPolynomial.homogeneousComponent (e + 1) G + MvPolynomial.X i *
            (MvPolynomial.homogeneousComponent e a +
              (if t ≤ e then MvPolynomial.X i ^ (e - t) * F else 0)) := by
        by_cases h1 : t ≤ e
        · rw [if_neg (by omega : ¬ e + 1 = t)] at k1
          rw [if_pos (by omega : t ≤ e + 1), if_pos h1,
            show e + 1 - t = (e - t) + 1 by omega, pow_succ']
          linear_combination k1
        · by_cases h2 : e + 1 = t
          · rw [if_pos h2] at k1
            rw [if_pos (by omega : t ≤ e + 1), if_neg h1, ← h2, Nat.sub_self, pow_zero, one_mul,
              add_zero]
            linear_combination k1
          · rw [if_neg h2] at k1
            rw [if_neg (by omega : ¬ t ≤ e + 1), if_neg h1, add_zero, add_zero]
            linear_combination k1
      rw [heq]
      exact J.add_mem (hJ G hG (e + 1)) (J.mul_mem_left _ ih)
  refine ⟨a.totalDegree + 1, ?_⟩
  have hQ := Q (t + (a.totalDegree + 1))
  rw [MvPolynomial.homogeneousComponent_eq_zero _ _ (by omega), zero_add,
    if_pos (by omega), Nat.add_sub_cancel_left] at hQ
  exact hQ

theorem wcpa_dj_sf_van_zero : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (n R : ℕ) (d : Fin R → ℕ) (K : Submodule (MvPolynomial (Fin n) A) (Fin R → MvPolynomial (Fin n) A)), (∀ f ∈ K, ∀ t : ℕ, (fun r => if d r ≤ t then MvPolynomial.homogeneousComponent (t - d r) (f r) else 0) ∈ K) → ∃ w₀ : ℤ, ∀ w : ℤ, w₀ ≤ w → wcCnUtlVan A n R d K 0 w :=
by
  classical
  intro A _ _ n R d K hK
  obtain ⟨R', d', g, hg1, hg2, hg3, hg4⟩ := wc_gc_graded_presentation A n R d K hK
  have h7 := wc_gc_graded_kernel_hc A n R R' d d' g hg1 hg2
  have hK' : ∀ f ∈ LinearMap.ker (Fintype.linearCombination (MvPolynomial (Fin n) A) g),
      ∀ t : ℕ, (fun j => if d' j ≤ t then
        MvPolynomial.homogeneousComponent (t - d' j) (f j) else 0) ∈
        LinearMap.ker (Fintype.linearCombination (MvPolynomial (Fin n) A) g) := by
    intro f hf t
    simp only [LinearMap.mem_ker, Fintype.linearCombination_apply] at hf ⊢
    rw [← h7 f t, hf]
    funext r
    simp
  obtain ⟨w₁, hw₁⟩ := wc_cn_laurent_serre_vanishing A n R' d' _ hK' 1 le_rfl
  refine ⟨max w₁ ((∑ r, (d r : ℤ)) - n + 1), fun w hw => ?_⟩
  have hw1 : w₁ ≤ w := le_trans (le_max_left _ _) hw
  have hw2 : (∑ r, (d r : ℤ)) - n + 1 ≤ w := le_trans (le_max_right _ _) hw
  have hb : ∀ r, (d r : ℤ) < w + n := by
    intro r
    have hle : (d r : ℤ) ≤ ∑ r', (d r' : ℤ) :=
      Finset.single_le_sum (f := fun r' => (d r' : ℤ))
        (fun i _ => Int.natCast_nonneg (d i)) (Finset.mem_univ r)
    linarith
  have hex := fun σ => wc_gc_phi_exact A n R R' d d' K g (wc_gc_laur_mul A n)
    (wc_gc_laur_add_inj A n) (wc_gc_laur_repr A n R') hg1 hg2 hg3 hg4 h7 w σ
  exact wc_cn_lsv_step A n R R' d d' K
    (LinearMap.ker (Fintype.linearCombination (MvPolynomial (Fin n) A) g)) _ 0 w
    (wc_gc_altD_sq_zero A (Fin R → (Fin n → ℤ) →₀ A) n)
    (wc_gc_laurK_sub_laurC A n R d K w)
    (fun σ => (hex σ).1) (fun σ => (hex σ).2.1) (fun σ => (hex σ).2.2.1)
    (fun σ => (hex σ).2.2.2)
    (hw₁ w hw1)
    (wc_cn_lsv_free_vanishing A n R d 0 w hb
      (wc_gc_cone_identity A (Fin R → (Fin n → ℤ) →₀ A) n)
      (wc_gc_altD_sq_zero A (Fin R → (Fin n → ℤ) →₀ A) n)
      (wc_gc_free_reduce_box A n R d 0 w
        (wc_gc_cone_identity A (Fin R → (Fin n → ℤ) →₀ A) n)))

theorem wcpa_dj_sf_cech_flat : ∀ (A : Type u) [CommRing A] (V : Type u) [AddCommGroup V] [Module A V] (n : ℕ) (P Q : Finset (Fin n) → Submodule A V), (∀ (M₁ M₂ M₃ : Type u) [AddCommGroup M₁] [Module A M₁] [AddCommGroup M₂] [Module A M₂] [AddCommGroup M₃] [Module A M₃] (f : M₁ →ₗ[A] M₂) (g : M₂ →ₗ[A] M₃), Function.Injective f → Function.Surjective g → Function.Exact f g → Module.Flat A M₂ → Module.Flat A M₃ → Module.Flat A M₁) → (∀ σ τ : Finset (Fin n), σ ⊆ τ → P σ ≤ P τ ∧ Q σ ≤ Q τ) → (∀ σ, Q σ ≤ P σ) → (∀ σ : Finset (Fin n), σ.Nonempty → wcpaSfQuotFlat A V (P σ) (Q σ)) → (∀ x ∈ P ∅, (∀ i : Fin n, x ∈ Q {i}) → x ∈ Q ∅) → (∀ (z : Finset (Fin n) → V) (τ : Finset (Fin n)), wcAltD (A := A) n (wcAltD (A := A) n z) τ = 0) → (∀ (p : ℕ) (z : Finset (Fin n) → V), (∀ σ, (σ.card = p + 1 → z σ ∈ P σ) ∧ (σ.card ≠ p + 1 → z σ = 0)) → (∀ τ : Finset (Fin n), τ.card = p + 2 → wcAltD (A := A) n z τ ∈ Q τ) → ∃ y : Finset (Fin n) → V, (∀ σ, (σ.card = p → y σ ∈ P σ) ∧ (σ.card ≠ p → y σ = 0)) ∧ ∀ σ : Finset (Fin n), σ.card = p + 1 → z σ - wcAltD (A := A) n y σ ∈ Q σ) → wcpaSfQuotFlat A V (P ∅) (Q ∅) :=
by
  intro A _ V _ _ n P Q hflatker hmono _hsub hflat hinj hdsq hvan
  classical

  have flat_of_subsingleton : ∀ (M : Type u) [AddCommGroup M] [Module A M], Subsingleton M →
      Module.Flat A M := by
    intro M _ _ hM
    haveI : Module.Flat A A := Module.Flat.self
    exact Module.Flat.of_retract (R := A) (M := A) (N := M) 0 0
      (LinearMap.ext fun x => Subsingleton.elim _ _)

  have s3 : ∀ (W : ℕ → Type u) [∀ k, AddCommGroup (W k)] [∀ k, Module A (W k)]
      (d : ∀ k, W k →ₗ[A] W (k + 1)) (m : ℕ),
      (∀ (k : ℕ) (x : W k), d (k + 1) (d k x) = 0) →
      (∀ (k : ℕ) (y : W (k + 1)), d (k + 1) y = 0 → ∃ x : W k, d k x = y) →
      (∀ k : ℕ, 1 ≤ k → Module.Flat A (W k)) → (∀ k : ℕ, m ≤ k → Subsingleton (W k)) →
      Function.Injective (d 0) → Module.Flat A (W 0) := by
    intro W _ _ d m hdd hex hfl hsubs hinj0
    have claim : ∀ j k, m ≤ k + j → 1 ≤ k → Module.Flat A (LinearMap.ker (d k)) := by
      intro j
      induction j with
      | zero =>
        intro k hk _
        haveI := hsubs k (by omega)
        exact flat_of_subsingleton _ inferInstance
      | succ j ih =>
        intro k hk hk1
        have h1 := ih (k + 1) (by omega) (by omega)
        refine hflatker _ _ _ (LinearMap.ker (d k)).subtype
          (LinearMap.codRestrict (LinearMap.ker (d (k + 1))) (d k)
            (fun x => LinearMap.mem_ker.mpr (hdd k x)))
          (Submodule.injective_subtype _) ?_ ?_ (hfl k hk1) h1
        · rintro ⟨y, hy⟩
          obtain ⟨x, hx⟩ := hex k y (LinearMap.mem_ker.mp hy)
          exact ⟨x, Subtype.ext hx⟩
        · rw [LinearMap.exact_iff, LinearMap.ker_codRestrict, Submodule.range_subtype]
    haveI hZ1 := claim m 1 (by omega) le_rfl
    let φ : W 0 →ₗ[A] LinearMap.ker (d 1) :=
      LinearMap.codRestrict (LinearMap.ker (d 1)) (d 0) (fun x => LinearMap.mem_ker.mpr (hdd 0 x))
    have hφi : Function.Injective φ := fun a b hab => hinj0 (congrArg Subtype.val hab)
    have hφs : Function.Surjective φ := by
      rintro ⟨y, hy⟩
      obtain ⟨x, hx⟩ := hex 0 y (LinearMap.mem_ker.mp hy)
      exact ⟨x, Subtype.ext hx⟩
    exact Module.Flat.of_linearEquiv (LinearEquiv.ofBijective φ ⟨hφi, hφs⟩)

  have s4 : ∀ (U : Type u) [AddCommGroup U] [Module A U] (D : U →ₗ[A] U) (C B : ℕ → Submodule A U),
      (∀ k, ∀ z ∈ C k, D z ∈ C (k + 1)) → (∀ k, ∀ z ∈ B k, D z ∈ B (k + 1)) →
      (∀ z, D (D z) = 0) →
      (∀ k, ∀ z ∈ C (k + 1), D z ∈ B (k + 2) → ∃ y ∈ C k, z - D y ∈ B (k + 1)) →
      (∀ y ∈ C 0, D y ∈ B 1 → y ∈ B 0) →
      ∃ d : ∀ k, (↥(C k) ⧸ Submodule.comap (C k).subtype (B k)) →ₗ[A]
          (↥(C (k + 1)) ⧸ Submodule.comap (C (k + 1)).subtype (B (k + 1))),
        (∀ k x, d (k + 1) (d k x) = 0) ∧ (∀ k y, d (k + 1) y = 0 → ∃ x, d k x = y) ∧
          Function.Injective (d 0) := by
    intro U _ _ D C B hC hB hDD hex hinj0
    have hk : ∀ k, Submodule.comap (C k).subtype (B k) ≤
        Submodule.comap (D.restrict (hC k)) (Submodule.comap (C (k + 1)).subtype (B (k + 1))) := by
      intro k x hx
      simp only [Submodule.mem_comap, Submodule.subtype_apply, LinearMap.restrict_coe_apply] at hx ⊢
      exact hB k _ hx
    refine ⟨fun k => Submodule.mapQ _ _ (D.restrict (hC k)) (hk k), ?_, ?_, ?_⟩
    · intro k x
      obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ x
      simp only [Submodule.mapQ_apply]
      rw [Submodule.Quotient.mk_eq_zero]
      simp only [Submodule.mem_comap, Submodule.subtype_apply, LinearMap.restrict_coe_apply, hDD]
      exact (B (k + 2)).zero_mem
    · intro k y hy
      obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective _ y
      simp only [Submodule.mapQ_apply, Submodule.Quotient.mk_eq_zero, Submodule.mem_comap,
        Submodule.subtype_apply, LinearMap.restrict_coe_apply] at hy
      obtain ⟨y', hy'C, hy'⟩ := hex k z z.2 hy
      refine ⟨Submodule.Quotient.mk ⟨y', hy'C⟩, ?_⟩
      simp only [Submodule.mapQ_apply]
      rw [Submodule.Quotient.eq]
      simp only [Submodule.mem_comap, Submodule.subtype_apply, Submodule.coe_sub,
        LinearMap.restrict_coe_apply]
      rw [← neg_sub]
      exact (B (k + 1)).neg_mem hy'
    · refine (injective_iff_map_eq_zero _).mpr ?_
      intro x hx
      obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ x
      simp only [Submodule.mapQ_apply, Submodule.Quotient.mk_eq_zero, Submodule.mem_comap,
        Submodule.subtype_apply, LinearMap.restrict_coe_apply] at hx ⊢
      exact hinj0 _ y.2 hx

  obtain ⟨Cs, hCs⟩ : ∃ Cs : (Finset (Fin n) → Submodule A V) → ℕ → Submodule A (Finset (Fin n) → V),
      ∀ R k z, z ∈ Cs R k ↔
        ∀ σ : Finset (Fin n), (σ.card = k → z σ ∈ R σ) ∧ (σ.card ≠ k → z σ = 0) :=
    ⟨fun R k =>
      { carrier := {z | ∀ σ : Finset (Fin n), (σ.card = k → z σ ∈ R σ) ∧ (σ.card ≠ k → z σ = 0)}
        add_mem' := fun {a b} ha hb σ => ⟨fun h => (R σ).add_mem ((ha σ).1 h) ((hb σ).1 h),
          fun h => by simp [Pi.add_apply, (ha σ).2 h, (hb σ).2 h]⟩
        zero_mem' := fun σ => ⟨fun _ => (R σ).zero_mem, fun _ => rfl⟩
        smul_mem' := fun c x hx σ => ⟨fun h => (R σ).smul_mem c ((hx σ).1 h),
          fun h => by simp [Pi.smul_apply, (hx σ).2 h]⟩ },
     fun _ _ _ => Iff.rfl⟩

  obtain ⟨D, hD⟩ : ∃ D : (Finset (Fin n) → V) →ₗ[A] (Finset (Fin n) → V),
      ∀ z, D z = wcAltD (A := A) n z :=
    ⟨{ toFun := fun z => wcAltD (A := A) n z
       map_add' := fun z z' => by
         funext τ
         simp only [wcAltD, Pi.add_apply, smul_add, Finset.sum_add_distrib]
       map_smul' := fun c z => by
         funext τ
         simp only [wcAltD, Pi.smul_apply, RingHom.id_apply, Finset.smul_sum]
         exact Finset.sum_congr rfl (fun i _ => smul_comm _ _ _) }, fun _ => rfl⟩
  have hDD : ∀ z, D (D z) = 0 := by
    intro z
    funext τ
    rw [hD, hD]
    exact hdsq z τ

  have hshape : ∀ (R : Finset (Fin n) → Submodule A V), (∀ σ τ, σ ⊆ τ → R σ ≤ R τ) →
      ∀ k, ∀ z ∈ Cs R k, D z ∈ Cs R (k + 1) := by
    intro R hR k z hz
    rw [hCs] at hz ⊢
    intro τ
    rw [hD]
    simp only [wcAltD]
    constructor
    · intro hτ
      refine Submodule.sum_mem _ (fun i hi => Submodule.smul_mem _ _ ?_)
      have hc : (τ.erase i).card = k := by rw [Finset.card_erase_of_mem hi]; omega
      exact hR _ _ (Finset.erase_subset i τ) ((hz _).1 hc)
    · intro hτ
      refine Finset.sum_eq_zero (fun i hi => ?_)
      have hc : (τ.erase i).card ≠ k := by
        rw [Finset.card_erase_of_mem hi]
        have := Finset.card_pos.mpr ⟨i, hi⟩
        omega
      rw [(hz _).2 hc, smul_zero]
  have hPm : ∀ σ τ : Finset (Fin n), σ ⊆ τ → P σ ≤ P τ := fun σ τ h => (hmono σ τ h).1
  have hQm : ∀ σ τ : Finset (Fin n), σ ⊆ τ → Q σ ≤ Q τ := fun σ τ h => (hmono σ τ h).2

  have hexact : ∀ k, ∀ z ∈ Cs P (k + 1), D z ∈ Cs Q (k + 2) →
      ∃ y ∈ Cs P k, z - D y ∈ Cs Q (k + 1) := by
    intro k z hz hDz
    have hz' := (hCs P (k + 1) z).mp hz
    have hDz' := (hCs Q (k + 2) (D z)).mp hDz
    obtain ⟨y, hy1, hy2⟩ := hvan k z hz' (fun τ hτ => by rw [← hD]; exact (hDz' τ).1 hτ)
    have hyC : y ∈ Cs P k := (hCs P k y).mpr hy1
    refine ⟨y, hyC, (hCs Q (k + 1) _).mpr (fun σ => ⟨fun hσ => ?_, fun hσ => ?_⟩)⟩
    · rw [Pi.sub_apply, hD]; exact hy2 σ hσ
    · rw [Pi.sub_apply, (hz' σ).2 hσ,
        ((hCs P (k + 1) (D y)).mp (hshape P hPm k y hyC) σ).2 hσ, sub_zero]

  have hinjective : ∀ y ∈ Cs P 0, D y ∈ Cs Q 1 → y ∈ Cs Q 0 := by
    intro y hy hDy
    have hy' := (hCs P 0 y).mp hy
    have hDy' := (hCs Q 1 (D y)).mp hDy
    have hsing : ∀ i : Fin n, D y {i} = y ∅ := by
      intro i
      rw [hD]
      simp only [wcAltD, Finset.sum_singleton, Finset.erase_singleton]
      rw [Finset.filter_singleton, if_neg (lt_irrefl i), Finset.card_empty, pow_zero, one_smul]
    have h0 : y ∅ ∈ Q ∅ := hinj _ ((hy' ∅).1 Finset.card_empty)
      (fun i => by rw [← hsing i]; exact (hDy' {i}).1 (Finset.card_singleton i))
    refine (hCs Q 0 y).mpr (fun σ => ⟨fun hσ => ?_, fun hσ => (hy' σ).2 hσ⟩)
    rw [Finset.card_eq_zero.mp hσ]
    exact h0
  obtain ⟨d, hdd2, hex2, hinj2⟩ := s4 _ D (Cs P) (Cs Q) (hshape P hPm) (hshape Q hQm) hDD hexact
    hinjective

  have s2 : ∀ k : ℕ, Nonempty ((↥(Cs P k) ⧸ Submodule.comap (Cs P k).subtype (Cs Q k)) ≃ₗ[A]
      ((σ : {σ : Finset (Fin n) // σ.card = k}) →
        ↥(P σ.1) ⧸ Submodule.comap (P σ.1).subtype (Q σ.1))) := by
    intro k
    let Φ : ↥(Cs P k) →ₗ[A] ((σ : {σ : Finset (Fin n) // σ.card = k}) →
        ↥(P σ.1) ⧸ Submodule.comap (P σ.1).subtype (Q σ.1)) :=
      LinearMap.pi (fun σ => (Submodule.mkQ _) ∘ₗ
        (LinearMap.codRestrict (P σ.1) ((LinearMap.proj σ.1) ∘ₗ (Cs P k).subtype)
          (fun z => ((hCs P k z).mp z.2 σ.1).1 σ.2)))
    have hΦ : ∀ z σ, Φ z σ = Submodule.Quotient.mk ⟨(z : Finset (Fin n) → V) σ.1,
        ((hCs P k z).mp z.2 σ.1).1 σ.2⟩ := fun _ _ => rfl
    have hΦs : Function.Surjective Φ := by
      intro f
      have hl : ∀ σ : {σ : Finset (Fin n) // σ.card = k}, ∃ x : ↥(P σ.1),
          Submodule.Quotient.mk x = f σ := fun σ => Submodule.Quotient.mk_surjective _ (f σ)
      choose x hx using hl
      have hz : (fun τ : Finset (Fin n) => if h : τ.card = k then ((x ⟨τ, h⟩ : ↥(P τ)) : V) else 0)
          ∈ Cs P k := by
        rw [hCs]
        intro τ
        constructor
        · intro h; rw [dif_pos h]; exact (x ⟨τ, h⟩).2
        · intro h; rw [dif_neg h]
      refine ⟨⟨_, hz⟩, ?_⟩
      funext σ
      rw [hΦ, ← hx σ]
      congr 1
      apply Subtype.ext
      show (if h : σ.1.card = k then ((x ⟨σ.1, h⟩ : ↥(P σ.1)) : V) else 0) = (x σ : V)
      rw [dif_pos σ.2]
    have hΦk : LinearMap.ker Φ = Submodule.comap (Cs P k).subtype (Cs Q k) := by
      ext z
      rw [LinearMap.mem_ker, Submodule.mem_comap, Submodule.subtype_apply, hCs]
      constructor
      · intro h τ
        constructor
        · intro hτ
          have h1 := congrFun h ⟨τ, hτ⟩
          rw [Pi.zero_apply, hΦ, Submodule.Quotient.mk_eq_zero, Submodule.mem_comap,
            Submodule.subtype_apply] at h1
          exact h1
        · intro hτ; exact ((hCs P k z).mp z.2 τ).2 hτ
      · intro h
        funext σ
        rw [hΦ, Pi.zero_apply, Submodule.Quotient.mk_eq_zero, Submodule.mem_comap,
          Submodule.subtype_apply]
        exact (h σ.1).1 σ.2
    exact ⟨(Submodule.quotEquivOfEq _ _ hΦk.symm).trans
      (LinearMap.quotKerEquivOfSurjective Φ hΦs)⟩
  have hflatk : ∀ k, 1 ≤ k →
      Module.Flat A (↥(Cs P k) ⧸ Submodule.comap (Cs P k).subtype (Cs Q k)) := by
    intro k hk
    obtain ⟨e⟩ := s2 k
    haveI : ∀ σ : {σ : Finset (Fin n) // σ.card = k},
        Module.Flat A (↥(P σ.1) ⧸ Submodule.comap (P σ.1).subtype (Q σ.1)) := fun σ =>
      hflat σ.1 (Finset.card_pos.mp (by rw [σ.2]; omega))
    haveI : Module.Flat A ((σ : {σ : Finset (Fin n) // σ.card = k}) →
        ↥(P σ.1) ⧸ Submodule.comap (P σ.1).subtype (Q σ.1)) :=
      Module.Flat.of_linearEquiv (DirectSum.linearEquivFunOnFintype A _ _).symm
    exact Module.Flat.of_linearEquiv e
  have hsubs : ∀ k, n + 1 ≤ k →
      Subsingleton (↥(Cs P k) ⧸ Submodule.comap (Cs P k).subtype (Cs Q k)) := by
    intro k hk
    have hC0 : ∀ a b : ↥(Cs P k), a = b := by
      intro a b
      apply Subtype.ext
      funext σ
      have h1 : σ.card ≠ k := by
        have := Finset.card_le_univ σ
        rw [Fintype.card_fin] at this
        omega
      rw [((hCs P k a).mp a.2 σ).2 h1, ((hCs P k b).mp b.2 σ).2 h1]
    constructor
    intro a b
    obtain ⟨a, rfl⟩ := Submodule.Quotient.mk_surjective _ a
    obtain ⟨b, rfl⟩ := Submodule.Quotient.mk_surjective _ b
    rw [hC0 a b]
  have hW0 := s3 (fun k => ↥(Cs P k) ⧸ Submodule.comap (Cs P k).subtype (Cs Q k)) d (n + 1)
    hdd2 hex2 hflatk hsubs hinj2
  obtain ⟨e0⟩ := s2 0
  haveI := hW0
  haveI : Module.Flat A ((σ : {σ : Finset (Fin n) // σ.card = 0}) →
      ↥(P σ.1) ⧸ Submodule.comap (P σ.1).subtype (Q σ.1)) := Module.Flat.of_linearEquiv e0.symm
  let σ0 : {σ : Finset (Fin n) // σ.card = 0} := ⟨∅, Finset.card_empty⟩
  have hfin := Module.Flat.of_retract (R := A)
    (LinearMap.single A (fun σ : {σ : Finset (Fin n) // σ.card = 0} =>
      ↥(P σ.1) ⧸ Submodule.comap (P σ.1).subtype (Q σ.1)) σ0)
    (LinearMap.proj σ0) (LinearMap.ext fun x => by simp)
  exact hfin

theorem wcpa_dj_sf_chart_ker : ∀ (A : Type u) [CommRing A] (N : ℕ) (J : Ideal (MvPolynomial (Fin (N + 1)) A)) (i : Fin (N + 1)) (σ : Finset (Fin (N + 1))) (w : ℤ), i ∈ σ → (∀ (σ τ : Finset (Fin (N + 1))) (k j : ℕ) (f : MvPolynomial (Fin (N + 1)) A), σ ⊆ τ → ∑ m ∈ ((∏ l ∈ σ, MvPolynomial.X l ^ j) * (∏ l ∈ τ \ σ, MvPolynomial.X l ^ (k + j)) * f).support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ τ then ((k + j : ℕ) : ℤ) else 0) (((∏ l ∈ σ, MvPolynomial.X l ^ j) * (∏ l ∈ τ \ σ, MvPolynomial.X l ^ (k + j)) * f).coeff m) = ∑ m ∈ f.support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0) (f.coeff m)) → (∀ (F : MvPolynomial (Fin (N + 1)) A) (t : ℕ), F.IsHomogeneous t → F ∈ J ⊔ Ideal.span {MvPolynomial.X i - 1} → ∃ M : ℕ, MvPolynomial.X i ^ M * F ∈ J) → ∀ v : Fin 1 → (Fin (N + 1) → ℤ) →₀ A, v ∈ wcLaurC A (N + 1) 1 (fun _ => 0) w σ → (wcLaurEval (N + 1) (algebraMap A (Localization.Away (Ideal.Quotient.mk (J ⊔ Ideal.span {MvPolynomial.X i - 1}) (∏ j ∈ σ, MvPolynomial.X j)))) (fun l => algebraMap (MvPolynomial (Fin (N + 1)) A ⧸ (J ⊔ Ideal.span {MvPolynomial.X i - 1})) (Localization.Away (Ideal.Quotient.mk (J ⊔ Ideal.span {MvPolynomial.X i - 1}) (∏ j ∈ σ, MvPolynomial.X j))) (Ideal.Quotient.mk (J ⊔ Ideal.span {MvPolynomial.X i - 1}) (MvPolynomial.X l))) (v 0) = 0 ↔ v ∈ wcLaurK A (N + 1) 1 (fun _ => 0) (Submodule.pi Set.univ (fun _ : Fin 1 => J)) w σ) :=
by
  intro A _ N J i σ w hi hshift hdehom v hv
  classical
  set I := J ⊔ Ideal.span {MvPolynomial.X i - 1} with hIdef

  have hlin : ∀ {T : Type u} [CommRing T] (α : A →+* T) (x : Fin (N + 1) → T),
      (∀ v v' : (Fin (N + 1) → ℤ) →₀ A,
        wcLaurEval (N + 1) α x (v + v') = wcLaurEval (N + 1) α x v + wcLaurEval (N + 1) α x v') ∧
      (∀ (a : A) (v : (Fin (N + 1) → ℤ) →₀ A),
        wcLaurEval (N + 1) α x (a • v) = α a * wcLaurEval (N + 1) α x v) ∧
      (∀ (β : Fin (N + 1) → ℤ) (c : A), wcLaurEval (N + 1) α x (Finsupp.single β c) =
        α c * ∏ l, (x l ^ (β l).toNat * Ring.inverse (x l) ^ (-β l).toNat)) ∧
      (∀ (s : Finset (Fin (N + 1) →₀ ℕ)) (g : (Fin (N + 1) →₀ ℕ) → (Fin (N + 1) → ℤ) →₀ A),
        wcLaurEval (N + 1) α x (∑ m ∈ s, g m) = ∑ m ∈ s, wcLaurEval (N + 1) α x (g m)) := by
    intro T _ α x
    have h0 : ∀ β : Fin (N + 1) → ℤ,
        α 0 * ∏ l, (x l ^ (β l).toNat * Ring.inverse (x l) ^ (-β l).toNat) = 0 :=
      fun β => by rw [map_zero, zero_mul]
    have hadd : ∀ (β : Fin (N + 1) → ℤ) (c₁ c₂ : A),
        α (c₁ + c₂) * ∏ l, (x l ^ (β l).toNat * Ring.inverse (x l) ^ (-β l).toNat) =
        α c₁ * ∏ l, (x l ^ (β l).toNat * Ring.inverse (x l) ^ (-β l).toNat) +
        α c₂ * ∏ l, (x l ^ (β l).toNat * Ring.inverse (x l) ^ (-β l).toNat) :=
      fun β c₁ c₂ => by rw [map_add, add_mul]
    refine ⟨fun v v' => ?_, fun a v => ?_, fun β c => ?_, fun s g => ?_⟩
    · unfold wcLaurEval
      exact Finsupp.sum_add_index' h0 hadd
    · unfold wcLaurEval
      rw [Finsupp.sum_smul_index' h0, Finsupp.mul_sum]
      refine Finset.sum_congr rfl (fun β _ => ?_)
      beta_reduce
      rw [smul_eq_mul, map_mul, mul_assoc]
    · unfold wcLaurEval
      exact Finsupp.sum_single_index (h0 β)
    · unfold wcLaurEval
      exact (Finsupp.sum_finsetSum_index h0 hadd).symm

  have hterm : ∀ {T : Type u} [CommRing T] (x : Fin (N + 1) → T) (k : ℕ)
      (m : Fin (N + 1) →₀ ℕ), (∀ l ∈ σ, IsUnit (x l)) →
      (∏ l, (x l ^ ((m l : ℤ) - (if l ∈ σ then (k : ℤ) else 0)).toNat *
        Ring.inverse (x l) ^ (-((m l : ℤ) - (if l ∈ σ then (k : ℤ) else 0))).toNat)) *
        ∏ l ∈ σ, x l ^ k = ∏ l, x l ^ m l := by
    intro T _ x k m hu
    have e : ∏ l ∈ σ, x l ^ k = ∏ l, (if l ∈ σ then x l ^ k else 1) := by
      rw [Finset.prod_ite_mem, Finset.univ_inter]
    rw [e, ← Finset.prod_mul_distrib]
    refine Finset.prod_congr rfl (fun l _ => ?_)
    by_cases hl : l ∈ σ
    · simp only [hl, if_true]
      rcases le_or_gt k (m l) with h | h
      · have e1 : ((m l : ℤ) - k).toNat = m l - k := by omega
        have e2 : (-((m l : ℤ) - k)).toNat = 0 := by omega
        rw [e1, e2, pow_zero, mul_one, pow_sub_mul_pow _ h]
      · have e1 : ((m l : ℤ) - k).toNat = 0 := by omega
        have e2 : (-((m l : ℤ) - k)).toNat = k - m l := by omega
        have e3 : x l ^ k = x l ^ (k - m l) * x l ^ m l := by
          rw [← pow_add, Nat.sub_add_cancel h.le]
        rw [e1, e2, pow_zero, one_mul, e3, ← mul_assoc, ← mul_pow,
          Ring.inverse_mul_cancel _ (hu l hl), one_pow, one_mul]
    · simp only [hl, if_false, sub_zero, mul_one]
      have e1 : ((m l : ℤ)).toNat = m l := by omega
      have e2 : (-(m l : ℤ)).toNat = 0 := by omega
      rw [e1, e2, pow_zero, mul_one]

  have hquot : ∀ (L : Type u) [CommRing L] [Algebra A L]
      [Algebra (MvPolynomial (Fin (N + 1)) A ⧸ I) L]
      [IsScalarTower A (MvPolynomial (Fin (N + 1)) A ⧸ I) L] (P : MvPolynomial (Fin (N + 1)) A),
      algebraMap (MvPolynomial (Fin (N + 1)) A ⧸ I) L (Ideal.Quotient.mk I P) =
        ∑ m ∈ P.support, algebraMap A L (P.coeff m) *
          ∏ l, (algebraMap (MvPolynomial (Fin (N + 1)) A ⧸ I) L
            (Ideal.Quotient.mk I (MvPolynomial.X l))) ^ m l := by
    intro L _ _ _ _ P
    have hφ : (algebraMap (MvPolynomial (Fin (N + 1)) A ⧸ I) L).comp (Ideal.Quotient.mk I) =
        MvPolynomial.eval₂Hom (algebraMap A L) (fun l =>
          algebraMap (MvPolynomial (Fin (N + 1)) A ⧸ I) L (Ideal.Quotient.mk I (MvPolynomial.X l))) := by
      apply MvPolynomial.ringHom_ext
      · intro a
        rw [RingHom.comp_apply, MvPolynomial.eval₂Hom_C, ← MvPolynomial.algebraMap_eq,
          Ideal.Quotient.mk_algebraMap, ← IsScalarTower.algebraMap_apply]
      · intro l
        rw [RingHom.comp_apply, MvPolynomial.eval₂Hom_X']
    have h1 := RingHom.congr_fun hφ P
    rw [RingHom.comp_apply, MvPolynomial.coe_eval₂Hom] at h1
    rw [h1, MvPolynomial.eval₂_eq']
  set L := Localization.Away (Ideal.Quotient.mk I (∏ j ∈ σ, MvPolynomial.X j)) with hL
  set U : Fin (N + 1) → L := fun l =>
    algebraMap (MvPolynomial (Fin (N + 1)) A ⧸ I) L (Ideal.Quotient.mk I (MvPolynomial.X l)) with hU
  have hprod : algebraMap (MvPolynomial (Fin (N + 1)) A ⧸ I) L
      (Ideal.Quotient.mk I (∏ j ∈ σ, MvPolynomial.X j)) = ∏ j ∈ σ, U j := by
    show _ = ∏ j ∈ σ, algebraMap (MvPolynomial (Fin (N + 1)) A ⧸ I) L
      (Ideal.Quotient.mk I (MvPolynomial.X j))
    rw [← map_prod (algebraMap (MvPolynomial (Fin (N + 1)) A ⧸ I) L)]
    exact congrArg (algebraMap (MvPolynomial (Fin (N + 1)) A ⧸ I) L)
      (map_prod (Ideal.Quotient.mk I) _ _)
  have hprodunit : IsUnit (∏ j ∈ σ, U j) := by
    have h1 : IsUnit (algebraMap (MvPolynomial (Fin (N + 1)) A ⧸ I) L
        (Ideal.Quotient.mk I (∏ j ∈ σ, MvPolynomial.X j))) :=
      IsLocalization.Away.algebraMap_isUnit _
    rwa [hprod] at h1
  have hunit : ∀ l ∈ σ, IsUnit (U l) := fun l hl =>
    isUnit_of_dvd_unit (Finset.dvd_prod_of_mem _ hl) hprodunit

  have hkey : ∀ (k : ℕ) (f : MvPolynomial (Fin (N + 1)) A),
      wcLaurEval (N + 1) (algebraMap A L) U (∑ m ∈ f.support, Finsupp.single
        (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0) (f.coeff m)) * (∏ j ∈ σ, U j) ^ k =
        algebraMap (MvPolynomial (Fin (N + 1)) A ⧸ I) L (Ideal.Quotient.mk I f) := by
    intro k f
    rw [hquot L f, (hlin (algebraMap A L) U).2.2.2, Finset.sum_mul]
    refine Finset.sum_congr rfl (fun m _ => ?_)
    rw [(hlin (algebraMap A L) U).2.2.1, mul_assoc]
    congr 1
    rw [← Finset.prod_pow]
    exact hterm U k m hunit
  have hweight : ∀ d : Fin (N + 1) →₀ ℕ, Finsupp.weight 1 d = ∑ l, d l := by
    intro d
    rw [Finsupp.weight_apply, Finsupp.sum_fintype] <;> simp
  have hsupdeg : ∀ (P : MvPolynomial (Fin (N + 1)) A) (D : ℕ), P.IsHomogeneous D →
      ∀ m ∈ P.support, (∑ l, (m l : ℤ)) = D := by
    intro P D hP m hm
    have h1 := hP (MvPolynomial.mem_support_iff.mp hm)
    rw [hweight] at h1
    exact_mod_cast h1
  constructor
  ·
    intro hev
    obtain ⟨x, hx⟩ : ∃ x, v 0 = x := ⟨_, rfl⟩
    rw [hx] at hev
    have hv' := hv
    unfold wcLaurC at hv'
    simp only [Set.mem_setOf_eq] at hv'
    have hsupp : ∀ β ∈ x.support, ∑ l, β l = w ∧ ∀ l, l ∉ σ → 0 ≤ β l := by
      intro β hβ
      rw [← hx] at hβ
      have h1 := (Finsupp.mem_supported A (v 0)).mp (hv' 0) hβ
      obtain ⟨h2, h3⟩ := h1
      exact ⟨by simpa using h2, h3⟩
    obtain ⟨k, hk⟩ : ∃ k : ℕ, k = ∑ β ∈ x.support, ∑ l, (-β l).toNat + (-w).toNat := ⟨_, rfl⟩
    have hkβ : ∀ β ∈ x.support, ∀ l, 0 ≤ β l + k := by
      intro β hβ l
      have h1 : (-β l).toNat ≤ ∑ l', (-β l').toNat :=
        Finset.single_le_sum (f := fun l' => (-β l').toNat) (fun _ _ => Nat.zero_le _)
          (Finset.mem_univ l)
      have h2 : ∑ l', (-β l').toNat ≤ ∑ β' ∈ x.support, ∑ l', (-β' l').toNat :=
        Finset.single_le_sum (f := fun β' => ∑ l', (-β' l').toNat) (fun _ _ => Nat.zero_le _) hβ
      omega
    have hcard : 0 < σ.card := Finset.card_pos.mpr ⟨i, hi⟩
    have hw : 0 ≤ w + (k : ℤ) * σ.card := by
      have h1 : (-w).toNat ≤ k := by omega
      have h2 : -w ≤ ((-w).toNat : ℤ) := Int.self_le_toNat _
      have h3 : (k : ℤ) ≤ (k : ℤ) * σ.card := by exact_mod_cast Nat.le_mul_of_pos_right k hcard
      have h4 : ((-w).toNat : ℤ) ≤ k := by exact_mod_cast h1
      linarith
    obtain ⟨t, ht⟩ := Int.eq_ofNat_of_zero_le hw
    let mexp : (Fin (N + 1) → ℤ) → (Fin (N + 1) →₀ ℕ) := fun β =>
      Finsupp.equivFunOnFinite.symm (fun l => (β l + if l ∈ σ then (k : ℤ) else 0).toNat)
    have hmexp_apply : ∀ β l, mexp β l = (β l + if l ∈ σ then (k : ℤ) else 0).toNat :=
      fun _ _ => rfl
    have hmexp_cast : ∀ β ∈ x.support, ∀ l,
        ((mexp β l : ℕ) : ℤ) = β l + if l ∈ σ then (k : ℤ) else 0 := by
      intro β hβ l
      rw [hmexp_apply]
      apply Int.toNat_of_nonneg
      by_cases hl : l ∈ σ
      · simp only [hl, if_true]; exact hkβ β hβ l
      · simp only [hl, if_false, add_zero]; exact (hsupp β hβ).2 l hl
    have hgm : ∀ β ∈ x.support,
        (fun l => ((mexp β l : ℕ) : ℤ) - if l ∈ σ then (k : ℤ) else 0) = β := by
      intro β hβ
      funext l
      rw [hmexp_cast β hβ l]
      ring
    have hinj : Set.InjOn mexp x.support := by
      intro a ha b hb hab
      rw [← hgm a ha, ← hgm b hb]
      simp only [hab]
    obtain ⟨h, hhdef⟩ : ∃ h : MvPolynomial (Fin (N + 1)) A,
        h = ∑ β ∈ x.support, MvPolynomial.monomial (mexp β) (x β) := ⟨_, rfl⟩
    have hcoeff : ∀ β ∈ x.support, h.coeff (mexp β) = x β := by
      intro β hβ
      rw [hhdef, MvPolynomial.coeff_sum]
      simp only [MvPolynomial.coeff_monomial]
      rw [Finset.sum_eq_single_of_mem β hβ (fun b hb hne => by
        rw [if_neg (fun he => hne (hinj hb hβ he))]), if_pos rfl]
    have hsuppH : h.support ⊆ x.support.image mexp := by
      intro m hm
      by_contra hcon
      apply MvPolynomial.mem_support_iff.mp hm
      rw [hhdef, MvPolynomial.coeff_sum]
      apply Finset.sum_eq_zero
      intro b hb
      rw [MvPolynomial.coeff_monomial, if_neg]
      intro he
      exact hcon (Finset.mem_image.mpr ⟨b, hb, he⟩)
    have hfrac : ∑ m ∈ h.support, Finsupp.single
        (fun l => (m l : ℤ) - if l ∈ σ then (k : ℤ) else 0) (h.coeff m) = x := by
      rw [Finset.sum_subset hsuppH (fun m _ hm => by
        rw [MvPolynomial.notMem_support_iff.mp hm, Finsupp.single_zero])]
      rw [Finset.sum_image hinj]
      calc ∑ β ∈ x.support, Finsupp.single
            (fun l => ((mexp β) l : ℤ) - if l ∈ σ then (k : ℤ) else 0) (h.coeff (mexp β))
          = ∑ β ∈ x.support, Finsupp.single β (x β) := by
            refine Finset.sum_congr rfl (fun β hβ => ?_)
            rw [hcoeff β hβ, hgm β hβ]
        _ = x := Finsupp.sum_single x
    have hsumβ : ∀ β ∈ x.support, (∑ l, ((mexp β l : ℕ) : ℤ)) = w + k * σ.card := by
      intro β hβ
      rw [Finset.sum_congr rfl (fun l _ => hmexp_cast β hβ l), Finset.sum_add_distrib,
        (hsupp β hβ).1, Finset.sum_ite_mem, Finset.univ_inter, Finset.sum_const, nsmul_eq_mul]
      ring
    have hhom : h.IsHomogeneous t := by
      intro d hd
      have hd' : d ∈ h.support := MvPolynomial.mem_support_iff.mpr hd
      obtain ⟨β, hβ, rfl⟩ := Finset.mem_image.mp (hsuppH hd')
      rw [hweight]
      have h1 := hsumβ β hβ
      rw [ht] at h1
      exact_mod_cast h1

    have hkey' := hkey k h
    rw [hfrac, hev, zero_mul] at hkey'
    obtain ⟨⟨a, hapow⟩, hm⟩ := (IsLocalization.map_eq_zero_iff
      (Submonoid.powers (Ideal.Quotient.mk I (∏ j ∈ σ, MvPolynomial.X j))) L
      (Ideal.Quotient.mk I h)).mp hkey'.symm
    obtain ⟨M, hM⟩ := (Submonoid.mem_powers_iff _ _).mp hapow
    have hmem : (∏ j ∈ σ, MvPolynomial.X j) ^ M * h ∈ I := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul, map_pow, hM]
      exact hm
    have hxσ : (∏ j ∈ σ, (MvPolynomial.X j : MvPolynomial (Fin (N + 1)) A)).IsHomogeneous
        (∑ j ∈ σ, 1) :=
      MvPolynomial.IsHomogeneous.prod σ (fun j => MvPolynomial.X j) (fun _ => 1)
        (fun j _ => MvPolynomial.isHomogeneous_X A j)
    obtain ⟨M', hM'⟩ := hdehom _ _ ((hxσ.pow M).mul hhom) hmem
    obtain ⟨G, hGdef⟩ : ∃ G : MvPolynomial (Fin (N + 1)) A,
        G = (∏ l ∈ σ, MvPolynomial.X l ^ (M + M')) *
          (∏ l ∈ σ \ σ, MvPolynomial.X l ^ (k + (M + M'))) * h := ⟨_, rfl⟩
    have hG : G ∈ J := by
      have e1 : ∏ l ∈ σ, (MvPolynomial.X l : MvPolynomial (Fin (N + 1)) A) ^ (M + M') =
          (∏ j ∈ σ, MvPolynomial.X j) ^ M * ∏ l ∈ σ, MvPolynomial.X l ^ M' := by
        rw [← Finset.prod_pow, ← Finset.prod_mul_distrib]
        exact Finset.prod_congr rfl (fun l _ => pow_add _ _ _)
      have e3 : (MvPolynomial.X i : MvPolynomial (Fin (N + 1)) A) ^ M' *
          ∏ l ∈ σ.erase i, MvPolynomial.X l ^ M' = ∏ l ∈ σ, MvPolynomial.X l ^ M' :=
        Finset.mul_prod_erase σ (fun l => (MvPolynomial.X l : MvPolynomial (Fin (N + 1)) A) ^ M') hi
      have e2 : G = (∏ l ∈ σ.erase i, MvPolynomial.X l ^ M') *
          (MvPolynomial.X i ^ M' * ((∏ j ∈ σ, MvPolynomial.X j) ^ M * h)) := by
        rw [hGdef, Finset.sdiff_self, Finset.prod_empty, mul_one, e1, ← e3]
        ring
      rw [e2]
      exact J.mul_mem_left _ hM'
    have hGhom : G.IsHomogeneous (∑ l ∈ σ, (M + M') + ∑ l ∈ σ \ σ, (k + (M + M')) + t) := by
      rw [hGdef]
      exact ((MvPolynomial.IsHomogeneous.prod σ _ _
        (fun l _ => MvPolynomial.isHomogeneous_X_pow l (M + M'))).mul
        (MvPolynomial.IsHomogeneous.prod (σ \ σ) _ _
          (fun l _ => MvPolynomial.isHomogeneous_X_pow l (k + (M + M'))))).mul hhom
    have hGdeg : ∀ m ∈ G.support,
        (∑ l, (m l : ℤ)) = w + ((k + (M + M') : ℕ) : ℤ) * σ.card := by
      intro m hm
      rw [hsupdeg G _ hGhom m hm, Finset.sdiff_self, Finset.sum_empty, Finset.sum_const,
        smul_eq_mul]
      push_cast
      linear_combination -ht
    have hvG : v = fun _ : Fin 1 => ∑ m ∈ G.support, Finsupp.single
        (fun l => (m l : ℤ) - if l ∈ σ then ((k + (M + M') : ℕ) : ℤ) else 0) (G.coeff m) := by
      funext r
      rw [Fin.fin_one_eq_zero r, hGdef, hshift σ σ k (M + M') h (Finset.Subset.refl σ), hfrac]
      exact hx
    rw [hvG]
    unfold wcLaurK
    exact Submodule.subset_span ⟨k + (M + M'), fun _ => G,
      Submodule.mem_pi.mpr (fun _ _ => hG),
      fun r m hm => by simp only [Nat.cast_zero, sub_zero]; exact hGdeg m hm, rfl⟩
  ·
    intro hvK
    have hback : ∀ y ∈ wcLaurK A (N + 1) 1 (fun _ => 0)
        (Submodule.pi Set.univ (fun _ : Fin 1 => J)) w σ,
        wcLaurEval (N + 1) (algebraMap A L) U (y 0) = 0 := by
      intro y hy
      unfold wcLaurK at hy
      induction hy using Submodule.span_induction with
      | mem z hz =>
        obtain ⟨k, f, hf, -, rfl⟩ := hz
        have hf0 : f 0 ∈ J := (Submodule.mem_pi.mp hf) 0 (Set.mem_univ _)
        have hmk : Ideal.Quotient.mk I (f 0) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_sup_left hf0)
        have h1 := hkey k (f 0)
        rw [hmk, map_zero] at h1
        exact (IsUnit.mul_left_eq_zero (hprodunit.pow k)).mp h1
      | zero =>
        show wcLaurEval (N + 1) (algebraMap A L) U 0 = 0
        unfold wcLaurEval
        exact Finsupp.sum_zero_index
      | add y₁ y₂ _ _ h₁ h₂ =>
        rw [Pi.add_apply, (hlin (algebraMap A L) U).1, h₁, h₂, add_zero]
      | smul a y _ hy' =>
        rw [Pi.smul_apply, (hlin (algebraMap A L) U).2.1, hy', mul_zero]
    exact hback v hvK

theorem wcpa_dj_sf_chart_surj : ∀ (A : Type u) [CommRing A] (N : ℕ) (J : Ideal (MvPolynomial (Fin (N + 1)) A)) (i : Fin (N + 1)) (σ : Finset (Fin (N + 1))) (w : ℤ), i ∈ σ → (∀ y : Localization.Away (Ideal.Quotient.mk (J ⊔ Ideal.span {MvPolynomial.X i - 1}) (∏ j ∈ σ, MvPolynomial.X j)), ∃ v ∈ wcLaurC A (N + 1) 1 (fun _ => 0) w σ, wcLaurEval (N + 1) (algebraMap A (Localization.Away (Ideal.Quotient.mk (J ⊔ Ideal.span {MvPolynomial.X i - 1}) (∏ j ∈ σ, MvPolynomial.X j)))) (fun l => algebraMap (MvPolynomial (Fin (N + 1)) A ⧸ (J ⊔ Ideal.span {MvPolynomial.X i - 1})) (Localization.Away (Ideal.Quotient.mk (J ⊔ Ideal.span {MvPolynomial.X i - 1}) (∏ j ∈ σ, MvPolynomial.X j))) (Ideal.Quotient.mk (J ⊔ Ideal.span {MvPolynomial.X i - 1}) (MvPolynomial.X l))) (v 0) = y) ∧ (∀ v v' : Fin 1 → (Fin (N + 1) → ℤ) →₀ A, wcLaurEval (N + 1) (algebraMap A (Localization.Away (Ideal.Quotient.mk (J ⊔ Ideal.span {MvPolynomial.X i - 1}) (∏ j ∈ σ, MvPolynomial.X j)))) (fun l => algebraMap (MvPolynomial (Fin (N + 1)) A ⧸ (J ⊔ Ideal.span {MvPolynomial.X i - 1})) (Localization.Away (Ideal.Quotient.mk (J ⊔ Ideal.span {MvPolynomial.X i - 1}) (∏ j ∈ σ, MvPolynomial.X j))) (Ideal.Quotient.mk (J ⊔ Ideal.span {MvPolynomial.X i - 1}) (MvPolynomial.X l))) ((v + v') 0) = wcLaurEval (N + 1) (algebraMap A (Localization.Away (Ideal.Quotient.mk (J ⊔ Ideal.span {MvPolynomial.X i - 1}) (∏ j ∈ σ, MvPolynomial.X j)))) (fun l => algebraMap (MvPolynomial (Fin (N + 1)) A ⧸ (J ⊔ Ideal.span {MvPolynomial.X i - 1})) (Localization.Away (Ideal.Quotient.mk (J ⊔ Ideal.span {MvPolynomial.X i - 1}) (∏ j ∈ σ, MvPolynomial.X j))) (Ideal.Quotient.mk (J ⊔ Ideal.span {MvPolynomial.X i - 1}) (MvPolynomial.X l))) (v 0) + wcLaurEval (N + 1) (algebraMap A (Localization.Away (Ideal.Quotient.mk (J ⊔ Ideal.span {MvPolynomial.X i - 1}) (∏ j ∈ σ, MvPolynomial.X j)))) (fun l => algebraMap (MvPolynomial (Fin (N + 1)) A ⧸ (J ⊔ Ideal.span {MvPolynomial.X i - 1})) (Localization.Away (Ideal.Quotient.mk (J ⊔ Ideal.span {MvPolynomial.X i - 1}) (∏ j ∈ σ, MvPolynomial.X j))) (Ideal.Quotient.mk (J ⊔ Ideal.span {MvPolynomial.X i - 1}) (MvPolynomial.X l))) (v' 0)) ∧ (∀ (a : A) (v : Fin 1 → (Fin (N + 1) → ℤ) →₀ A), wcLaurEval (N + 1) (algebraMap A (Localization.Away (Ideal.Quotient.mk (J ⊔ Ideal.span {MvPolynomial.X i - 1}) (∏ j ∈ σ, MvPolynomial.X j)))) (fun l => algebraMap (MvPolynomial (Fin (N + 1)) A ⧸ (J ⊔ Ideal.span {MvPolynomial.X i - 1})) (Localization.Away (Ideal.Quotient.mk (J ⊔ Ideal.span {MvPolynomial.X i - 1}) (∏ j ∈ σ, MvPolynomial.X j))) (Ideal.Quotient.mk (J ⊔ Ideal.span {MvPolynomial.X i - 1}) (MvPolynomial.X l))) ((a • v) 0) = algebraMap A (Localization.Away (Ideal.Quotient.mk (J ⊔ Ideal.span {MvPolynomial.X i - 1}) (∏ j ∈ σ, MvPolynomial.X j))) a * wcLaurEval (N + 1) (algebraMap A (Localization.Away (Ideal.Quotient.mk (J ⊔ Ideal.span {MvPolynomial.X i - 1}) (∏ j ∈ σ, MvPolynomial.X j)))) (fun l => algebraMap (MvPolynomial (Fin (N + 1)) A ⧸ (J ⊔ Ideal.span {MvPolynomial.X i - 1})) (Localization.Away (Ideal.Quotient.mk (J ⊔ Ideal.span {MvPolynomial.X i - 1}) (∏ j ∈ σ, MvPolynomial.X j))) (Ideal.Quotient.mk (J ⊔ Ideal.span {MvPolynomial.X i - 1}) (MvPolynomial.X l))) (v 0)) :=
by
  intro A _ N J i σ w hi
  classical
  have hXi : (MvPolynomial.X i - 1 : MvPolynomial (Fin (N + 1)) A) ∈
      J ⊔ Ideal.span {MvPolynomial.X i - 1} :=
    Ideal.mem_sup_right (Ideal.mem_span_singleton_self _)
  set I := J ⊔ Ideal.span {MvPolynomial.X i - 1} with hIdef

  have hlin : ∀ {T : Type u} [CommRing T] (α : A →+* T) (x : Fin (N + 1) → T),
      (∀ v v' : (Fin (N + 1) → ℤ) →₀ A,
        wcLaurEval (N + 1) α x (v + v') = wcLaurEval (N + 1) α x v + wcLaurEval (N + 1) α x v') ∧
      (∀ (a : A) (v : (Fin (N + 1) → ℤ) →₀ A),
        wcLaurEval (N + 1) α x (a • v) = α a * wcLaurEval (N + 1) α x v) ∧
      (∀ (β : Fin (N + 1) → ℤ) (c : A), wcLaurEval (N + 1) α x (Finsupp.single β c) =
        α c * ∏ l, (x l ^ (β l).toNat * Ring.inverse (x l) ^ (-β l).toNat)) ∧
      (∀ (s : Finset (Fin (N + 1) →₀ ℕ)) (g : (Fin (N + 1) →₀ ℕ) → (Fin (N + 1) → ℤ) →₀ A),
        wcLaurEval (N + 1) α x (∑ m ∈ s, g m) = ∑ m ∈ s, wcLaurEval (N + 1) α x (g m)) := by
    intro T _ α x
    have h0 : ∀ β : Fin (N + 1) → ℤ,
        α 0 * ∏ l, (x l ^ (β l).toNat * Ring.inverse (x l) ^ (-β l).toNat) = 0 :=
      fun β => by rw [map_zero, zero_mul]
    have hadd : ∀ (β : Fin (N + 1) → ℤ) (c₁ c₂ : A),
        α (c₁ + c₂) * ∏ l, (x l ^ (β l).toNat * Ring.inverse (x l) ^ (-β l).toNat) =
        α c₁ * ∏ l, (x l ^ (β l).toNat * Ring.inverse (x l) ^ (-β l).toNat) +
        α c₂ * ∏ l, (x l ^ (β l).toNat * Ring.inverse (x l) ^ (-β l).toNat) :=
      fun β c₁ c₂ => by rw [map_add, add_mul]
    refine ⟨fun v v' => ?_, fun a v => ?_, fun β c => ?_, fun s g => ?_⟩
    · unfold wcLaurEval
      exact Finsupp.sum_add_index' h0 hadd
    · unfold wcLaurEval
      rw [Finsupp.sum_smul_index' h0, Finsupp.mul_sum]
      refine Finset.sum_congr rfl (fun β _ => ?_)
      beta_reduce
      rw [smul_eq_mul, map_mul, mul_assoc]
    · unfold wcLaurEval
      exact Finsupp.sum_single_index (h0 β)
    · unfold wcLaurEval
      exact (Finsupp.sum_finsetSum_index h0 hadd).symm

  have hterm : ∀ {T : Type u} [CommRing T] (x : Fin (N + 1) → T) (k : ℕ) (c : ℤ)
      (m : Fin (N + 1) →₀ ℕ), x i = 1 → (∀ l ∈ σ, IsUnit (x l)) →
      (∏ l, (x l ^ ((m l : ℤ) - (if l ∈ σ then (k : ℤ) else 0) + (if l = i then c else 0)).toNat *
        Ring.inverse (x l) ^
          (-((m l : ℤ) - (if l ∈ σ then (k : ℤ) else 0) + (if l = i then c else 0))).toNat)) *
        ∏ l ∈ σ, x l ^ k = ∏ l, x l ^ m l := by
    intro T _ x k c m hxi hu
    have e : ∏ l ∈ σ, x l ^ k = ∏ l, (if l ∈ σ then x l ^ k else 1) := by
      rw [Finset.prod_ite_mem, Finset.univ_inter]
    rw [e, ← Finset.prod_mul_distrib]
    refine Finset.prod_congr rfl (fun l _ => ?_)
    by_cases hli : l = i
    · subst hli
      rw [hxi]
      simp [Ring.inverse_one]
    · by_cases hl : l ∈ σ
      · simp only [hl, hli, if_true, if_false, add_zero]
        rcases le_or_gt k (m l) with h | h
        · have e1 : ((m l : ℤ) - k).toNat = m l - k := by omega
          have e2 : (-((m l : ℤ) - k)).toNat = 0 := by omega
          rw [e1, e2, pow_zero, mul_one, pow_sub_mul_pow _ h]
        · have e1 : ((m l : ℤ) - k).toNat = 0 := by omega
          have e2 : (-((m l : ℤ) - k)).toNat = k - m l := by omega
          have e3 : x l ^ k = x l ^ (k - m l) * x l ^ m l := by
            rw [← pow_add, Nat.sub_add_cancel h.le]
          rw [e1, e2, pow_zero, one_mul, e3, ← mul_assoc, ← mul_pow,
            Ring.inverse_mul_cancel _ (hu l hl), one_pow, one_mul]
      · simp only [hl, hli, if_false, sub_zero, add_zero, mul_one]
        have e1 : ((m l : ℤ)).toNat = m l := by omega
        have e2 : (-(m l : ℤ)).toNat = 0 := by omega
        rw [e1, e2, pow_zero, mul_one]

  have hquot : ∀ (L : Type u) [CommRing L] [Algebra A L]
      [Algebra (MvPolynomial (Fin (N + 1)) A ⧸ I) L]
      [IsScalarTower A (MvPolynomial (Fin (N + 1)) A ⧸ I) L] (P : MvPolynomial (Fin (N + 1)) A),
      algebraMap (MvPolynomial (Fin (N + 1)) A ⧸ I) L (Ideal.Quotient.mk I P) =
        ∑ m ∈ P.support, algebraMap A L (P.coeff m) *
          ∏ l, (algebraMap (MvPolynomial (Fin (N + 1)) A ⧸ I) L
            (Ideal.Quotient.mk I (MvPolynomial.X l))) ^ m l := by
    intro L _ _ _ _ P
    have hφ : (algebraMap (MvPolynomial (Fin (N + 1)) A ⧸ I) L).comp (Ideal.Quotient.mk I) =
        MvPolynomial.eval₂Hom (algebraMap A L) (fun l =>
          algebraMap (MvPolynomial (Fin (N + 1)) A ⧸ I) L (Ideal.Quotient.mk I (MvPolynomial.X l))) := by
      apply MvPolynomial.ringHom_ext
      · intro a
        rw [RingHom.comp_apply, MvPolynomial.eval₂Hom_C, ← MvPolynomial.algebraMap_eq,
          Ideal.Quotient.mk_algebraMap, ← IsScalarTower.algebraMap_apply]
      · intro l
        rw [RingHom.comp_apply, MvPolynomial.eval₂Hom_X']
    have h1 := RingHom.congr_fun hφ P
    rw [RingHom.comp_apply, MvPolynomial.coe_eval₂Hom] at h1
    rw [h1, MvPolynomial.eval₂_eq']
  refine ⟨fun y => ?_, fun v v' => ?_, fun a v => ?_⟩
  rotate_left
  · rw [Pi.add_apply]
    exact (hlin _ _).1 _ _
  · rw [Pi.smul_apply]
    exact (hlin _ _).2.1 _ _
  obtain ⟨⟨d, s⟩, hds⟩ := IsLocalization.mk'_surjective
    (Submonoid.powers (Ideal.Quotient.mk I (∏ j ∈ σ, MvPolynomial.X j))) y
  obtain ⟨k, hk⟩ := s.2
  obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective d
  subst hds
  set L := Localization.Away (Ideal.Quotient.mk I (∏ j ∈ σ, MvPolynomial.X j)) with hL
  set x' : Fin (N + 1) → L := fun l =>
    algebraMap (MvPolynomial (Fin (N + 1)) A ⧸ I) L (Ideal.Quotient.mk I (MvPolynomial.X l)) with hx'
  have hx'i : x' i = 1 := by
    simp only [hx']
    rw [show Ideal.Quotient.mk I (MvPolynomial.X i) = Ideal.Quotient.mk I 1 from
      Ideal.Quotient.eq.mpr hXi, map_one, map_one]
  have hprod : algebraMap (MvPolynomial (Fin (N + 1)) A ⧸ I) L
      (Ideal.Quotient.mk I (∏ j ∈ σ, MvPolynomial.X j)) = ∏ j ∈ σ, x' j := by
    show _ = ∏ j ∈ σ, algebraMap (MvPolynomial (Fin (N + 1)) A ⧸ I) L
      (Ideal.Quotient.mk I (MvPolynomial.X j))
    rw [← map_prod (algebraMap (MvPolynomial (Fin (N + 1)) A ⧸ I) L)]
    exact congrArg (algebraMap (MvPolynomial (Fin (N + 1)) A ⧸ I) L)
      (map_prod (Ideal.Quotient.mk I) _ _)
  have hunit : ∀ l ∈ σ, IsUnit (x' l) := by
    intro l hl
    have h1 : IsUnit (algebraMap (MvPolynomial (Fin (N + 1)) A ⧸ I) L
        (Ideal.Quotient.mk I (∏ j ∈ σ, MvPolynomial.X j))) :=
      IsLocalization.Away.algebraMap_isUnit _
    rw [hprod] at h1
    exact isUnit_of_dvd_unit (Finset.dvd_prod_of_mem _ hl) h1
  have hLC : ∀ (v : Fin 1 → (Fin (N + 1) → ℤ) →₀ A),
      v ∈ wcLaurC A (N + 1) 1 (fun _ => 0) w σ ↔ ∀ r, v r ∈ Finsupp.supported A A
        {β : Fin (N + 1) → ℤ | ∑ i, β i = w - (((fun _ : Fin 1 => (0 : ℕ)) r : ℕ) : ℤ) ∧
          ∀ i, i ∉ σ → 0 ≤ β i} := fun _ => Iff.rfl
  let c : (Fin (N + 1) →₀ ℕ) → ℤ := fun m => w + (k : ℤ) * σ.card - ∑ l, (m l : ℤ)
  let β : (Fin (N + 1) →₀ ℕ) → Fin (N + 1) → ℤ := fun m l =>
    (m l : ℤ) - (if l ∈ σ then (k : ℤ) else 0) + (if l = i then c m else 0)
  refine ⟨fun _ => ∑ m ∈ P.support, Finsupp.single (β m) (P.coeff m), ?_, ?_⟩
  · rw [hLC]
    intro r
    refine Submodule.sum_mem _ (fun m _ => Finsupp.single_mem_supported A _ ?_)
    refine ⟨?_, ?_⟩
    · simp only [β, c, Finset.sum_add_distrib, Finset.sum_sub_distrib, Finset.sum_ite_mem,
        Finset.univ_inter, Finset.sum_const, nsmul_eq_mul, Fintype.sum_ite_eq', Nat.cast_zero,
        sub_zero, smul_eq_mul]
      ring
    · intro l hl
      have hli : l ≠ i := fun h => hl (h ▸ hi)
      simp only [β, if_neg hl, if_neg hli]
      omega
  · show wcLaurEval (N + 1) (algebraMap A L) x'
      (∑ m ∈ P.support, Finsupp.single (β m) (P.coeff m)) = _
    rw [IsLocalization.eq_mk'_iff_mul_eq, ← hk, map_pow, hprod, ← Finset.prod_pow, hquot L P,
      (hlin (algebraMap A L) x').2.2.2, Finset.sum_mul]
    refine Finset.sum_congr rfl (fun m _ => ?_)
    rw [(hlin (algebraMap A L) x').2.2.1, mul_assoc]
    congr 1
    exact hterm x' k (c m) m hx'i hunit

theorem wcpa_dj_sf_deg0_iso : ∀ (A : Type u) [CommRing A] (N : ℕ) (J : Ideal (MvPolynomial (Fin (N + 1)) A)) (e : ℕ) (P Q : Submodule A (Fin 1 → (Fin (N + 1) → ℤ) →₀ A)), (∀ v, v ∈ P ↔ v ∈ wcLaurC A (N + 1) 1 (fun _ => 0) (e : ℤ) ∅) → Q = wcLaurK A (N + 1) 1 (fun _ => 0) (Submodule.pi Set.univ (fun _ : Fin 1 => J)) (e : ℤ) ∅ → wcpaSfQuotFlat A (Fin 1 → (Fin (N + 1) → ℤ) →₀ A) P Q → Module.Flat A (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A e) ⧸ Submodule.comap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A e).subtype (Submodule.restrictScalars A J)) :=
by
  intro A _ N J e P Q hP hQ hflat
  classical

  have transfer : ∀ (M V : Type u) [AddCommGroup M] [Module A M] [AddCommGroup V] [Module A V]
      (S T : Submodule A M) (P Q : Submodule A V) (ι : M →ₗ[A] V),
      (∀ x ∈ S, ι x ∈ P) → (∀ v ∈ P, ∃ x ∈ S, ι x = v) → (∀ x ∈ S, ι x = 0 → x = 0) →
      (∀ x ∈ S, ι x ∈ Q ↔ x ∈ T) → wcpaSfQuotFlat A V P Q →
      Module.Flat A (↥S ⧸ Submodule.comap S.subtype T) := by
    intro M V _ _ _ _ S T P Q ι h1 h2 h3 h4 hfl
    let ι₀ : ↥S →ₗ[A] ↥P := LinearMap.codRestrict P (ι.comp S.subtype) (fun c => h1 c.1 c.2)
    have hι₀ : ∀ c, (ι₀ c : V) = ι c.1 := fun c => rfl
    have hinj : Function.Injective ι₀ := by
      intro x y hxy
      have h : ι (x.1 - y.1) = 0 := by
        rw [map_sub, ← hι₀, ← hι₀, hxy, sub_self]
      exact Subtype.ext (sub_eq_zero.mp (h3 _ (S.sub_mem x.2 y.2) h))
    have hsurj : Function.Surjective ι₀ := by
      intro y
      obtain ⟨x, hx, hxy⟩ := h2 y.1 y.2
      exact ⟨⟨x, hx⟩, Subtype.ext (by rw [hι₀]; exact hxy)⟩
    let e0 : ↥S ≃ₗ[A] ↥P := LinearEquiv.ofBijective ι₀ ⟨hinj, hsurj⟩
    have he0 : ∀ c, (e0 c : V) = ι c.1 := fun c => rfl
    have hmap : Submodule.map (e0 : ↥S →ₗ[A] ↥P) (Submodule.comap S.subtype T) =
        Submodule.comap P.subtype Q := by
      ext y
      rw [Submodule.mem_map_equiv, Submodule.mem_comap, Submodule.mem_comap,
        Submodule.subtype_apply, Submodule.subtype_apply, ← h4 _ (e0.symm y).2, ← he0,
        LinearEquiv.apply_symm_apply]
    haveI : Module.Flat A (↥P ⧸ Submodule.comap P.subtype Q) := hfl
    exact Module.Flat.of_linearEquiv (Submodule.Quotient.equiv _ _ e0 hmap)

  obtain ⟨c, hcdef⟩ : ∃ c : (Fin (N + 1) →₀ ℕ) → (Fin (N + 1) → ℤ),
      c = fun m i => ((m i : ℕ) : ℤ) := ⟨_, rfl⟩
  have hc : Function.Injective c := by
    intro a b h
    rw [hcdef] at h
    ext i
    have h1 : ((a i : ℕ) : ℤ) = ((b i : ℕ) : ℤ) := congrFun h i
    exact_mod_cast h1
  let L : MvPolynomial (Fin (N + 1)) A →ₗ[A] (Fin 1 → (Fin (N + 1) → ℤ) →₀ A) :=
    { toFun := fun F _ => Finsupp.mapDomain c (AddMonoidAlgebra.coeff F)
      map_add' := fun F G => by
        funext _
        rw [AddMonoidAlgebra.coeff_add]
        exact Finsupp.mapDomain_add
      map_smul' := fun a F => by
        funext _
        rw [AddMonoidAlgebra.coeff_smul]
        exact Finsupp.mapDomain_smul a (AddMonoidAlgebra.coeff F) }
  have hL : ∀ (F : MvPolynomial (Fin (N + 1)) A) (r : Fin 1),
      L F r = Finsupp.mapDomain c (AddMonoidAlgebra.coeff F) := fun _ _ => rfl
  have hLsum : ∀ (F : MvPolynomial (Fin (N + 1)) A) (r : Fin 1),
      L F r = ∑ m ∈ F.support, Finsupp.single (c m) (F.coeff m) := fun _ _ => rfl
  have hinjL : ∀ F : MvPolynomial (Fin (N + 1)) A, L F = 0 → F = 0 := by
    intro F hF
    have h0 : Finsupp.mapDomain c (AddMonoidAlgebra.coeff F) =
        Finsupp.mapDomain c (AddMonoidAlgebra.coeff (0 : MvPolynomial (Fin (N + 1)) A)) := by
      rw [← hL F 0, hF, ← hL 0 0, map_zero]
    exact AddMonoidAlgebra.coeff_injective (Finsupp.mapDomain_injective hc h0)

  have hdeg : ∀ F ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A e, ∀ m ∈ F.support,
      ∑ i, (m i : ℤ) = (e : ℤ) := by
    intro F hF m hm
    rw [MvPolynomial.homogeneousSubmodule_eq_finsupp_supported,
      AddMonoidAlgebra.mem_supported] at hF
    have h1 : m.degree = e := hF hm
    have h2 : ((m.degree : ℕ) : ℤ) = ∑ i, (m i : ℤ) := by
      rw [Finsupp.degree_eq_sum]; push_cast; rfl
    rw [← h2, h1]
  have hdeg' : ∀ F : MvPolynomial (Fin (N + 1)) A, (∀ m ∈ F.support, ∑ i, (m i : ℤ) = (e : ℤ)) →
      F ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A e := by
    intro F hF
    rw [MvPolynomial.homogeneousSubmodule_eq_finsupp_supported, AddMonoidAlgebra.mem_supported]
    intro m hm
    have h1 := hF m hm
    have h2 : ((m.degree : ℕ) : ℤ) = ∑ i, (m i : ℤ) := by
      rw [Finsupp.degree_eq_sum]; push_cast; rfl
    show m.degree = e
    exact_mod_cast h2.trans h1

  have hinto : ∀ F ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A e, L F ∈ P := by
    intro F hF
    rw [hP]
    show ∀ r, L F r ∈ Finsupp.supported A A {β : Fin (N + 1) → ℤ | ∑ i, β i =
      (e : ℤ) - (((fun _ : Fin 1 => (0 : ℕ)) r : ℕ) : ℤ) ∧
        ∀ i, i ∉ (∅ : Finset (Fin (N + 1))) → 0 ≤ β i}
    intro r
    rw [hLsum]
    refine Submodule.sum_mem _ (fun m hm => Finsupp.single_mem_supported A _ ?_)
    rw [Set.mem_setOf_eq]
    refine ⟨?_, fun i _ => ?_⟩
    · rw [hcdef]
      simp only [Nat.cast_zero, sub_zero]
      exact hdeg F hF m hm
    · rw [hcdef]
      exact Int.natCast_nonneg _

  have honto : ∀ v ∈ P, ∃ F ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A e, L F = v := by
    intro v hv
    have hv' : v 0 ∈ Finsupp.supported A A {β : Fin (N + 1) → ℤ | ∑ i, β i =
        (e : ℤ) - (((fun _ : Fin 1 => (0 : ℕ)) 0 : ℕ) : ℤ) ∧
          ∀ i, i ∉ (∅ : Finset (Fin (N + 1))) → 0 ≤ β i} := (hP v).mp hv 0
    rw [Finsupp.mem_supported] at hv'
    have hrange : ↑(v 0).support ⊆ Set.range c := by
      intro β hβ
      have h := hv' hβ
      rw [Set.mem_setOf_eq] at h
      refine ⟨Finsupp.equivFunOnFinite.symm (fun i => (β i).toNat), ?_⟩
      rw [hcdef]
      funext i
      simp only [Finsupp.coe_equivFunOnFinite_symm]
      exact Int.toNat_of_nonneg (h.2 i (Finset.notMem_empty i))
    let F : MvPolynomial (Fin (N + 1)) A :=
      AddMonoidAlgebra.ofCoeff (Finsupp.comapDomain c (v 0) hc.injOn)
    refine ⟨F, ?_, ?_⟩
    · apply hdeg'
      intro m hm
      have hcm : c m ∈ (v 0).support := by
        rw [Finsupp.mem_support_iff]
        rw [MvPolynomial.mem_support_iff] at hm
        exact hm
      have h := hv' hcm
      rw [Set.mem_setOf_eq] at h
      have h1 := h.1
      rw [hcdef] at h1
      simpa using h1
    · funext r
      have hr := Fin.fin_one_eq_zero r
      subst hr
      exact (hL F 0).trans (Finsupp.mapDomain_comapDomain c hc (v 0) hrange)

  have hgen : ∀ (F : MvPolynomial (Fin (N + 1)) A) (k : ℕ),
      (fun _ : Fin 1 => ∑ m ∈ F.support, Finsupp.single
        (fun i => (m i : ℤ) - if i ∈ (∅ : Finset (Fin (N + 1))) then (k : ℤ) else 0)
        (F.coeff m)) = L F := by
    intro F k
    funext r
    rw [hLsum]
    refine Finset.sum_congr rfl (fun m _ => ?_)
    congr 1
    rw [hcdef]
    funext i
    simp
  have hK : ∀ F ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A e,
      (L F ∈ Q ↔ F ∈ Submodule.restrictScalars A J) := by
    intro F hF
    rw [Submodule.restrictScalars_mem, hQ]
    constructor
    · intro hLF
      have hle : wcLaurK A (N + 1) 1 (fun _ => 0) (Submodule.pi Set.univ (fun _ : Fin 1 => J))
          (e : ℤ) ∅ ≤ Submodule.map L (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A e ⊓
            Submodule.restrictScalars A J) := by
        unfold wcLaurK
        rw [Submodule.span_le]
        rintro v ⟨k, f, hf, hdf, rfl⟩
        refine Submodule.mem_map.mpr ⟨f 0, Submodule.mem_inf.mpr ⟨?_, ?_⟩, ?_⟩
        · apply hdeg'
          intro m hm
          have h := hdf 0 m hm
          simpa using h
        · rw [Submodule.restrictScalars_mem]
          exact (Submodule.mem_pi.mp hf) 0 (Set.mem_univ 0)
        · funext r
          have hr := Fin.fin_one_eq_zero r
          subst hr
          exact (congrFun (hgen (f 0) k) 0).symm
      obtain ⟨G, hG, hGF⟩ := Submodule.mem_map.mp (hle hLF)
      have h0 : G - F = 0 := hinjL (G - F) (by rw [map_sub, hGF, sub_self])
      rw [sub_eq_zero] at h0
      rw [← h0]
      exact (Submodule.mem_inf.mp hG).2
    · intro hFJ
      unfold wcLaurK
      apply Submodule.subset_span
      rw [Set.mem_setOf_eq]
      refine ⟨0, fun _ => F, ?_, ?_, ?_⟩
      · rw [Submodule.mem_pi]
        intro _ _
        exact hFJ
      · intro r m hm
        have h := hdeg F hF m hm
        simpa using h
      · exact (hgen F 0).symm
  exact transfer (MvPolynomial (Fin (N + 1)) A) (Fin 1 → (Fin (N + 1) → ℤ) →₀ A)
    (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A e) (Submodule.restrictScalars A J) P Q L
    hinto honto (fun x _ hx => hinjL x hx) hK hflat

theorem wcpa_dj_sf_laurK_mono : ∀ (A : Type u) [CommRing A] (n R : ℕ) (d : Fin R → ℕ) (K : Submodule (MvPolynomial (Fin n) A) (Fin R → MvPolynomial (Fin n) A)) (w : ℤ) (σ τ : Finset (Fin n)), (∀ (σ τ : Finset (Fin n)) (k j : ℕ) (f : MvPolynomial (Fin n) A), σ ⊆ τ → ∑ m ∈ ((∏ l ∈ σ, MvPolynomial.X l ^ j) * (∏ l ∈ τ \ σ, MvPolynomial.X l ^ (k + j)) * f).support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ τ then ((k + j : ℕ) : ℤ) else 0) (((∏ l ∈ σ, MvPolynomial.X l ^ j) * (∏ l ∈ τ \ σ, MvPolynomial.X l ^ (k + j)) * f).coeff m) = ∑ m ∈ f.support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0) (f.coeff m)) → σ ⊆ τ → wcLaurK A n R d K w σ ≤ wcLaurK A n R d K w τ :=
by
  intro A _ n R d K w σ τ H hστ
  classical
  unfold wcLaurK
  rw [Submodule.span_le]
  rintro v ⟨k, f, hfK, hdeg, rfl⟩
  apply Submodule.subset_span
  have hchom : ((∏ l ∈ σ, MvPolynomial.X l ^ 0) * (∏ l ∈ τ \ σ, MvPolynomial.X l ^ (k + 0)) :
      MvPolynomial (Fin n) A).IsHomogeneous (k * (τ \ σ).card) := by
    have h1 : ((∏ l ∈ σ, MvPolynomial.X l ^ 0) * (∏ l ∈ τ \ σ, MvPolynomial.X l ^ (k + 0)) :
        MvPolynomial (Fin n) A) = ∏ l ∈ τ \ σ, MvPolynomial.X l ^ k := by
      simp
    rw [h1]
    have := MvPolynomial.IsHomogeneous.prod (τ \ σ) (fun l => (MvPolynomial.X l ^ k :
      MvPolynomial (Fin n) A)) (fun _ => k) (fun l _ => MvPolynomial.isHomogeneous_X_pow l k)
    simpa [Finset.sum_const, mul_comm] using this
  refine ⟨k, ((∏ l ∈ σ, MvPolynomial.X l ^ 0) * (∏ l ∈ τ \ σ, MvPolynomial.X l ^ (k + 0)) :
      MvPolynomial (Fin n) A) • f, K.smul_mem _ hfK, ?_, ?_⟩
  · intro r m hm
    rw [Pi.smul_apply, smul_eq_mul] at hm
    obtain ⟨a, ha, b, hb, rfl⟩ := Finset.mem_add.mp (MvPolynomial.support_mul _ _ hm)
    have hA := hchom (MvPolynomial.mem_support_iff.mp ha)
    have hB := hdeg r b hb
    have hcard := Finset.card_sdiff_add_card_eq_card hστ
    have hsum : (∑ i, ((a + b) i : ℤ)) = (∑ i, (a i : ℤ)) + ∑ i, (b i : ℤ) := by
      simp [Finsupp.add_apply, Finset.sum_add_distrib]
    have ha' : (∑ i, a i) = k * (τ \ σ).card := by
      rw [← Finsupp.degree_eq_sum, Finsupp.degree_eq_weight_one]
      exact hA
    have ha'' : (∑ i, (a i : ℤ)) = (k : ℤ) * ((τ \ σ).card : ℤ) := by
      exact_mod_cast ha'
    have hcard' : (((τ \ σ).card : ℕ) : ℤ) + ((σ.card : ℕ) : ℤ) = ((τ.card : ℕ) : ℤ) := by
      exact_mod_cast hcard
    rw [hsum, ha'', hB]
    linear_combination (k : ℤ) * hcard'
  · funext r
    rw [Pi.smul_apply, smul_eq_mul]
    exact (H σ τ k 0 (f r) hστ).symm

theorem wcpa_dj_sf_h0_inj : ∀ (A : Type u) [CommRing A] (N : ℕ) (J : Ideal (MvPolynomial (Fin (N + 1)) A)), (∀ (σ τ : Finset (Fin (N + 1))) (k j : ℕ) (f : MvPolynomial (Fin (N + 1)) A), σ ⊆ τ → ∑ m ∈ ((∏ l ∈ σ, MvPolynomial.X l ^ j) * (∏ l ∈ τ \ σ, MvPolynomial.X l ^ (k + j)) * f).support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ τ then ((k + j : ℕ) : ℤ) else 0) (((∏ l ∈ σ, MvPolynomial.X l ^ j) * (∏ l ∈ τ \ σ, MvPolynomial.X l ^ (k + j)) * f).coeff m) = ∑ m ∈ f.support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0) (f.coeff m)) → (∀ (F : MvPolynomial (Fin (N + 1)) A) (e : ℕ), F.IsHomogeneous e → (∀ i, ∃ M : ℕ, MvPolynomial.X i ^ M * F ∈ J) → F ∈ J) → (∀ (i : Fin (N + 1)) (w : ℤ) (v : Fin 1 → (Fin (N + 1) → ℤ) →₀ A), v ∈ wcLaurK A (N + 1) 1 (fun _ => 0) (Submodule.pi Set.univ (fun _ : Fin 1 => J)) w {i} → ∃ (k : ℕ) (f : MvPolynomial (Fin (N + 1)) A), f ∈ J ∧ v 0 = ∑ m ∈ f.support, Finsupp.single (fun l => (m l : ℤ) - if l ∈ ({i} : Finset (Fin (N + 1))) then (k : ℤ) else 0) (f.coeff m)) → ∀ (e : ℕ) (x : Fin 1 → (Fin (N + 1) → ℤ) →₀ A), x ∈ wcLaurC A (N + 1) 1 (fun _ => 0) (e : ℤ) ∅ → (∀ i, x ∈ wcLaurK A (N + 1) 1 (fun _ => 0) (Submodule.pi Set.univ (fun _ : Fin 1 => J)) (e : ℤ) {i}) → x ∈ wcLaurK A (N + 1) 1 (fun _ => 0) (Submodule.pi Set.univ (fun _ : Fin 1 => J)) (e : ℤ) ∅ :=
by
  have laur_repr : ∀ (A : Type u) [CommRing A] (n R' : ℕ) (e : Fin R' → ℤ) (σ : Finset (Fin n)) (v : Fin R' → (Fin n → ℤ) →₀ A), (∀ j, v j ∈ Finsupp.supported A A {β : Fin n → ℤ | ∑ i, β i = e j ∧ ∀ i, i ∉ σ → 0 ≤ β i}) → ∃ (k : ℕ) (h : Fin R' → MvPolynomial (Fin n) A), (∀ j, v j = ∑ m ∈ (h j).support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0) ((h j).coeff m)) ∧ ∀ j, ∀ m ∈ (h j).support, (∑ i, (m i : ℤ)) = e j + k * σ.card := by
    intro A _ n R' e σ v hv
    have hsupp : ∀ j, ∀ β ∈ (v j).support, ∑ i, β i = e j ∧ ∀ i, i ∉ σ → 0 ≤ β i := by
      intro j β hβ
      exact (Finsupp.mem_supported A (v j)).mp (hv j) hβ
    have single : ∀ (c : Fin n → ℤ) (w : (Fin n → ℤ) →₀ A), (∀ β ∈ w.support, ∀ i, 0 ≤ β i + c i) →
        ∃ h : MvPolynomial (Fin n) A,
          w = ∑ m ∈ h.support, Finsupp.single (fun i => (m i : ℤ) - c i) (h.coeff m) ∧
          ∀ m ∈ h.support, ∃ β ∈ w.support, ∀ i, (m i : ℤ) = β i + c i := by
      classical
      intro c w hw
      let ν : (Fin n → ℤ) → (Fin n →₀ ℕ) :=
        fun β => Finsupp.equivFunOnFinite.symm (fun i => (β i + c i).toNat)
      have hν : ∀ β i, ν β i = (β i + c i).toNat := fun β i => rfl
      have F1 : ∀ β ∈ w.support, ∀ i, ((ν β i : ℕ) : ℤ) = β i + c i := by
        intro β hβ i
        rw [hν]
        exact Int.toNat_of_nonneg (hw β hβ i)
      have F1' : ∀ β ∈ w.support, (fun i => ((ν β i : ℕ) : ℤ) - c i) = β := by
        intro β hβ
        funext i
        rw [F1 β hβ i]
        ring
      have F2 : Set.InjOn ν (w.support : Set (Fin n → ℤ)) := by
        intro β hβ β' hβ' heq
        funext i
        have h1 := F1 β hβ i
        have h2 := F1 β' hβ' i
        rw [heq] at h1
        linarith
      obtain ⟨h, hh⟩ : ∃ h : MvPolynomial (Fin n) A,
          h = ∑ β ∈ w.support, MvPolynomial.monomial (ν β) (w β) := ⟨_, rfl⟩
      have F3 : ∀ m, h.coeff m = ∑ β ∈ w.support, if ν β = m then w β else 0 := by
        intro m
        rw [hh, MvPolynomial.coeff_sum]
        refine Finset.sum_congr rfl (fun β _ => ?_)
        rw [MvPolynomial.coeff_monomial]
      have F3a : ∀ β₀ ∈ w.support, h.coeff (ν β₀) = w β₀ := by
        intro β₀ hβ₀
        rw [F3, Finset.sum_eq_single β₀]
        · simp
        · intro β hβ hne
          rw [if_neg]
          intro heq
          exact hne (F2 hβ hβ₀ heq)
        · intro h0
          exact absurd hβ₀ h0
      have F3b : ∀ m ∈ h.support, ∃ β ∈ w.support, ν β = m := by
        intro m hm
        rw [MvPolynomial.mem_support_iff, F3] at hm
        obtain ⟨β, hβ, hne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hm
        refine ⟨β, hβ, ?_⟩
        by_contra hc
        exact hne (if_neg hc)
      refine ⟨h, ?_, ?_⟩
      · have hsub : h.support ⊆ w.support.image ν := by
          intro m hm
          obtain ⟨β, hβ, rfl⟩ := F3b m hm
          exact Finset.mem_image_of_mem ν hβ
        rw [Finset.sum_subset hsub, Finset.sum_image F2]
        · conv_lhs => rw [← Finsupp.sum_single w]
          rw [Finsupp.sum]
          refine Finset.sum_congr rfl (fun β hβ => ?_)
          rw [F1' β hβ, F3a β hβ]
        · intro m _ hm
          rw [MvPolynomial.notMem_support_iff.mp hm, Finsupp.single_zero]
      · intro m hm
        obtain ⟨β, hβ, rfl⟩ := F3b m hm
        exact ⟨β, hβ, F1 β hβ⟩
    obtain ⟨k, hk⟩ : ∃ k : ℕ, ∀ j, ∀ β ∈ (v j).support, ∀ i,
        0 ≤ β i + (if i ∈ σ then (k : ℤ) else 0) := by
      classical
      let U : Finset (Fin n → ℤ) := Finset.univ.biUnion (fun j => (v j).support)
      refine ⟨∑ β ∈ U, ∑ i, (-(β i)).toNat, ?_⟩
      intro j β hβ i
      have hβU : β ∈ U := Finset.mem_biUnion.mpr ⟨j, Finset.mem_univ j, hβ⟩
      have h1 : (-(β i)).toNat ≤ ∑ i', (-(β i')).toNat :=
        Finset.single_le_sum (f := fun i' => (-(β i')).toNat) (fun _ _ => Nat.zero_le _)
          (Finset.mem_univ i)
      have h2 : ∑ i', (-(β i')).toNat ≤ ∑ β ∈ U, ∑ i, (-(β i)).toNat :=
        Finset.single_le_sum (f := fun β' : Fin n → ℤ => ∑ i', (-(β' i')).toNat)
          (fun _ _ => Nat.zero_le _) hβU
      have h3 : -(β i) ≤ ((-(β i)).toNat : ℤ) := Int.self_le_toNat _
      have h4 : (((-(β i)).toNat : ℕ) : ℤ) ≤ ((∑ β ∈ U, ∑ i, (-(β i)).toNat : ℕ) : ℤ) := by
        exact_mod_cast h1.trans h2
      split_ifs with hi
      · linarith
      · simpa using (hsupp j β hβ).2 i hi
    choose h hrep hdeg using fun j => single (fun i => if i ∈ σ then (k : ℤ) else 0) (v j) (hk j)
    refine ⟨k, h, fun j => hrep j, ?_⟩
    intro j m hm
    obtain ⟨β, hβ, hmβ⟩ := hdeg j m hm
    have hmβ' : ∀ i, (m i : ℤ) = β i + if i ∈ σ then (k : ℤ) else 0 := hmβ
    rw [Finset.sum_congr rfl (fun i _ => hmβ' i), Finset.sum_add_distrib, (hsupp j β hβ).1,
      Finset.sum_ite_mem, Finset.univ_inter, Finset.sum_const, nsmul_eq_mul]
    ring
  have laur_add_inj : ∀ (A : Type u) [CommRing A] (n : ℕ) (σ : Finset (Fin n)) (k : ℕ) (f₁ f₂ : MvPolynomial (Fin n) A), (∑ m ∈ (f₁ + f₂).support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0) ((f₁ + f₂).coeff m) = (∑ m ∈ f₁.support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0) (f₁.coeff m)) + ∑ m ∈ f₂.support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0) (f₂.coeff m)) ∧ ((∑ m ∈ f₁.support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0) (f₁.coeff m)) = 0 → f₁ = 0) := by
    intro A _ n σ k f₁ f₂
    classical
    set e : (Fin n →₀ ℕ) → (Fin n → ℤ) :=
      fun m i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0 with he
    have hinj : Function.Injective e := by
      intro m m' h
      ext i
      have h' := congrFun h i
      simp only [he] at h'
      exact_mod_cast (sub_left_inj.mp h')
    have hext : ∀ (S : Finset (Fin n →₀ ℕ)) (f : MvPolynomial (Fin n) A), f.support ⊆ S →
        ∑ m ∈ f.support, Finsupp.single (e m) (f.coeff m) =
          ∑ m ∈ S, Finsupp.single (e m) (f.coeff m) := by
      intro S f hS
      apply Finset.sum_subset hS
      intro m _ hm
      rw [MvPolynomial.notMem_support_iff.mp hm, Finsupp.single_zero]
    have hev : ∀ (f : MvPolynomial (Fin n) A) (m₀ : Fin n →₀ ℕ),
        (∑ m ∈ f.support, Finsupp.single (e m) (f.coeff m)) (e m₀) = f.coeff m₀ := by
      intro f m₀
      rw [Finsupp.finset_sum_apply]
      by_cases hm₀ : m₀ ∈ f.support
      · rw [Finset.sum_eq_single m₀]
        · rw [Finsupp.single_eq_same]
        · intro b _ hb
          rw [Finsupp.single_eq_of_ne]
          intro hbe
          exact hb (hinj hbe).symm
        · intro h; exact absurd hm₀ h
      · rw [MvPolynomial.notMem_support_iff.mp hm₀]
        apply Finset.sum_eq_zero
        intro b hb
        rw [Finsupp.single_eq_of_ne]
        intro hbe
        exact hm₀ ((hinj hbe) ▸ hb)
    refine ⟨?_, ?_⟩
    · have h1 : f₁.support ⊆ f₁.support ∪ f₂.support := Finset.subset_union_left
      have h2 : f₂.support ⊆ f₁.support ∪ f₂.support := Finset.subset_union_right
      have h12 : (f₁ + f₂).support ⊆ f₁.support ∪ f₂.support := MvPolynomial.support_add
      rw [hext _ _ h1, hext _ _ h2, hext _ _ h12, ← Finset.sum_add_distrib]
      apply Finset.sum_congr rfl
      intro m _
      rw [MvPolynomial.coeff_add, Finsupp.single_add]
    · intro h
      refine MvPolynomial.ext _ _ (fun m₀ => ?_)
      have := hev f₁ m₀
      rw [h, Finsupp.coe_zero, Pi.zero_apply] at this
      rw [MvPolynomial.coeff_zero]
      exact this.symm
  intro A _ N J hshift hsat hcoll e x hx hxi
  classical
  have hx' : ∀ j, x j ∈ Finsupp.supported A A {β : Fin (N + 1) → ℤ | ∑ i, β i =
      (fun _ : Fin 1 => (e : ℤ)) j ∧ ∀ i, i ∉ (∅ : Finset (Fin (N + 1))) → 0 ≤ β i} := by
    intro j
    refine Finsupp.supported_mono ?_ (hx j)
    intro β hβ
    simp only [Set.mem_setOf_eq] at hβ ⊢
    exact ⟨by simpa using hβ.1, hβ.2⟩
  obtain ⟨k₀, h, hxv, hdeg⟩ := laur_repr A (N + 1) 1 (fun _ => (e : ℤ)) ∅ x hx'
  have hx0 : x 0 = ∑ m ∈ (h 0).support, Finsupp.single (fun i => (m i : ℤ) -
      if i ∈ (∅ : Finset (Fin (N + 1))) then ((0 : ℕ) : ℤ) else 0) ((h 0).coeff m) := by
    rw [hxv 0]
    simp
  have hdegF : ∀ m ∈ (h 0).support, (∑ i, (m i : ℤ)) = (e : ℤ) := by
    intro m hm
    have := hdeg 0 m hm
    simpa using this
  have hhom : (h 0).IsHomogeneous e := by
    intro d hd
    have hdm : d ∈ (h 0).support := MvPolynomial.mem_support_iff.mpr hd
    have h1 := hdegF d hdm
    have h2 : (∑ i, d i : ℕ) = e := by exact_mod_cast h1
    rw [← h2, ← Finsupp.degree_eq_sum, Finsupp.degree_eq_weight_one]
    rfl
  have hstep : ∀ i, ∃ M : ℕ, MvPolynomial.X i ^ M * h 0 ∈ J := by
    intro i
    obtain ⟨ki, fi, hfi, hxi'⟩ := hcoll i (e : ℤ) x (hxi i)
    have hs := hshift ∅ {i} 0 ki (h 0) (Finset.empty_subset _)
    simp only [Finset.prod_empty, Finset.sdiff_empty, Finset.prod_singleton, zero_add,
      one_mul] at hs
    have hEq := hs.trans (hx0.symm.trans hxi')
    obtain ⟨hadd, hinj⟩ := laur_add_inj A (N + 1) {i} ki (MvPolynomial.X i ^ ki * h 0 - fi) fi
    simp only [sub_add_cancel] at hadd
    rw [hEq] at hadd
    have h0 := hadd.symm
    have h0' : (∑ m ∈ (MvPolynomial.X i ^ ki * h 0 - fi).support, Finsupp.single
        (fun l => (m l : ℤ) - if l ∈ ({i} : Finset (Fin (N + 1))) then (ki : ℤ) else 0)
        ((MvPolynomial.X i ^ ki * h 0 - fi).coeff m)) = 0 := by
      first
        | exact add_eq_right.mp h0
        | exact add_left_eq_self.mp h0
    have hG := sub_eq_zero.mp (hinj h0')
    exact ⟨ki, by rw [hG]; exact hfi⟩
  have hFJ : h 0 ∈ J := hsat (h 0) e hhom hstep
  unfold wcLaurK
  apply Submodule.subset_span
  refine ⟨0, fun _ => h 0, ?_, ?_, ?_⟩
  · exact Submodule.mem_pi.mpr (fun _ _ => hFJ)
  · intro r m hm
    rw [hdegF m hm]
    simp
  · funext r
    rw [Fin.fin_one_eq_zero r]
    exact hx0

theorem wcpa_dj_sf_laurK_collapse : ∀ (A : Type u) [CommRing A] (N : ℕ) (J : Ideal (MvPolynomial (Fin (N + 1)) A)) (σ : Finset (Fin (N + 1))) (w : ℤ), (∀ (σ τ : Finset (Fin (N + 1))) (k j : ℕ) (f : MvPolynomial (Fin (N + 1)) A), σ ⊆ τ → ∑ m ∈ ((∏ l ∈ σ, MvPolynomial.X l ^ j) * (∏ l ∈ τ \ σ, MvPolynomial.X l ^ (k + j)) * f).support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ τ then ((k + j : ℕ) : ℤ) else 0) (((∏ l ∈ σ, MvPolynomial.X l ^ j) * (∏ l ∈ τ \ σ, MvPolynomial.X l ^ (k + j)) * f).coeff m) = ∑ m ∈ f.support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0) (f.coeff m)) → ∀ v ∈ wcLaurK A (N + 1) 1 (fun _ => 0) (Submodule.pi Set.univ (fun _ : Fin 1 => J)) w σ, ∃ (k : ℕ) (f : MvPolynomial (Fin (N + 1)) A), f ∈ J ∧ (∀ m ∈ f.support, (∑ i, (m i : ℤ)) = w + k * σ.card) ∧ v 0 = ∑ m ∈ f.support, Finsupp.single (fun l => (m l : ℤ) - if l ∈ σ then (k : ℤ) else 0) (f.coeff m) :=
by
  intro A _ N J σ w hS v hv
  classical
  have s1 : ∀ (j : ℕ) (f : MvPolynomial (Fin (N + 1)) A) (e : ℤ),
      (∀ m ∈ f.support, (∑ i, (m i : ℤ)) = e) →
      ∀ m ∈ ((∏ l ∈ σ, MvPolynomial.X l ^ j) * f).support, (∑ i, (m i : ℤ)) = e + j * σ.card := by
    intro j f e hf m hm
    have hH : (∏ l ∈ σ, (MvPolynomial.X l : MvPolynomial (Fin (N + 1)) A) ^ j).IsHomogeneous
        (∑ l ∈ σ, j) :=
      MvPolynomial.IsHomogeneous.prod σ (fun l => MvPolynomial.X l ^ j) (fun _ => j)
        (fun l _ => MvPolynomial.isHomogeneous_X_pow l j)
    obtain ⟨a, ha, b, hb, hab⟩ := Finset.mem_add.mp (MvPolynomial.support_mul _ _ hm)
    have hadeg : Finsupp.degree a = ∑ l ∈ σ, j := by
      by_contra hne
      exact (MvPolynomial.mem_support_iff.mp ha) (hH.coeff_eq_zero hne)
    have hasum : ∑ i, (a i : ℤ) = (σ.card : ℤ) * j := by
      rw [Finsupp.degree_eq_sum, Finset.sum_const, smul_eq_mul] at hadeg
      exact_mod_cast hadeg
    subst hab
    simp only [Finsupp.add_apply, Nat.cast_add, Finset.sum_add_distrib]
    rw [hasum, hf b hb]
    ring
  have s2 : ∀ (k : ℕ) (a : A) (f : MvPolynomial (Fin (N + 1)) A),
      a • (∑ m ∈ f.support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0)
        (f.coeff m)) =
      ∑ m ∈ (a • f).support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0)
        ((a • f).coeff m) := by
    intro k a f
    rw [Finset.smul_sum]
    simp only [Finsupp.smul_single, MvPolynomial.coeff_smul]
    symm
    apply Finset.sum_subset MvPolynomial.support_smul
    intro m _ hm
    rw [MvPolynomial.notMem_support_iff, MvPolynomial.coeff_smul] at hm
    rw [hm, Finsupp.single_zero]
  have hadd : ∀ (k : ℕ) (f₁ f₂ : MvPolynomial (Fin (N + 1)) A),
      ∑ m ∈ (f₁ + f₂).support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0)
        ((f₁ + f₂).coeff m) =
      (∑ m ∈ f₁.support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0)
        (f₁.coeff m)) +
      ∑ m ∈ f₂.support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0)
        (f₂.coeff m) := by
    intro k f₁ f₂
    have e : ∀ g : MvPolynomial (Fin (N + 1)) A,
        g.support ⊆ f₁.support ∪ f₂.support ∪ (f₁ + f₂).support →
        ∑ m ∈ g.support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0)
          (g.coeff m) =
        ∑ m ∈ f₁.support ∪ f₂.support ∪ (f₁ + f₂).support,
          Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0) (g.coeff m) := by
      intro g hg
      apply Finset.sum_subset hg
      intro m _ hm
      rw [MvPolynomial.notMem_support_iff.mp hm, Finsupp.single_zero]
    rw [e (f₁ + f₂) Finset.subset_union_right,
      e f₁ (Finset.subset_union_left.trans Finset.subset_union_left),
      e f₂ (Finset.subset_union_right.trans Finset.subset_union_left), ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun m _ => ?_
    rw [MvPolynomial.coeff_add, Finsupp.single_add]
  unfold wcLaurK at hv
  induction hv using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨k, f, hfK, hdeg, rfl⟩ := hx
    refine ⟨k, f 0, ?_, ?_, rfl⟩
    · exact (Submodule.mem_pi.mp hfK) 0 (Set.mem_univ 0)
    · intro m hm
      simpa using hdeg 0 m hm
  | zero => exact ⟨0, 0, J.zero_mem, by simp, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨k₁, f₁, h₁, d₁, e₁⟩ := hx
    obtain ⟨k₂, f₂, h₂, d₂, e₂⟩ := hy
    refine ⟨k₁ + k₂, (∏ l ∈ σ, MvPolynomial.X l ^ k₂) * f₁ + (∏ l ∈ σ, MvPolynomial.X l ^ k₁) * f₂,
      J.add_mem (J.mul_mem_left _ h₁) (J.mul_mem_left _ h₂), ?_, ?_⟩
    · intro m hm
      rcases Finset.mem_union.mp (MvPolynomial.support_add hm) with hm | hm
      · rw [s1 k₂ f₁ _ d₁ m hm]; push_cast; ring
      · rw [s1 k₁ f₂ _ d₂ m hm]; push_cast; ring
    · have I1 := hS σ σ k₁ k₂ f₁ (Finset.Subset.refl σ)
      rw [Finset.sdiff_self, Finset.prod_empty, mul_one] at I1
      have I2 := hS σ σ k₂ k₁ f₂ (Finset.Subset.refl σ)
      rw [Finset.sdiff_self, Finset.prod_empty, mul_one, Nat.add_comm k₂ k₁] at I2
      rw [Pi.add_apply, e₁, e₂, hadd, I1, I2]
  | smul a x _ hx =>
    obtain ⟨k, f, hf, hdeg, hv0⟩ := hx
    refine ⟨k, a • f, ?_, ?_, ?_⟩
    · rw [MvPolynomial.smul_eq_C_mul]; exact J.mul_mem_left _ hf
    · intro m hm; exact hdeg m (MvPolynomial.support_smul hm)
    · rw [Pi.smul_apply, hv0, s2]

theorem wcpa_dj_flrg_sc_serre_flat : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (N : ℕ) (J : Ideal (MvPolynomial (Fin (N + 1)) A)), (∀ F ∈ J, ∀ e : ℕ, MvPolynomial.homogeneousComponent e F ∈ J) → (∀ (F : MvPolynomial (Fin (N + 1)) A) (e : ℕ), F.IsHomogeneous e → (∀ i, ∃ M : ℕ, MvPolynomial.X i ^ M * F ∈ J) → F ∈ J) → (∀ i : Fin (N + 1), Module.Flat A (MvPolynomial (Fin (N + 1)) A ⧸ (J ⊔ Ideal.span {MvPolynomial.X i - 1}))) → ∃ e₁ : ℕ, ∀ e, e₁ ≤ e → Module.Flat A (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A e) ⧸ Submodule.comap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A e).subtype (Submodule.restrictScalars A J)) :=
by
  intro A _ _ N J hJ hsat hflat
  have hshift := wcpa_dj_sf_frac_shift A (N + 1)

  have flatker : ∀ (M₁ M₂ M₃ : Type u) [AddCommGroup M₁] [Module A M₁] [AddCommGroup M₂]
      [Module A M₂] [AddCommGroup M₃] [Module A M₃] (f : M₁ →ₗ[A] M₂) (g : M₂ →ₗ[A] M₃),
      Function.Injective f → Function.Surjective g → Function.Exact f g → Module.Flat A M₂ →
      Module.Flat A M₃ → Module.Flat A M₁ := by
    intro M₁ M₂ M₃ _ _ _ _ _ _ f g hf hg hfg h2 h3
    haveI := h2
    haveI := h3
    rw [Module.Flat.iff_rTensor_injective']
    intro I
    have hl : Function.Injective (LinearMap.lTensor I f) :=
      LinearMap.lTensor_injective_of_exact_of_flat g hg f hf hfg I
    have hr : Function.Injective (LinearMap.rTensor M₂ I.subtype) :=
      Module.Flat.rTensor_preserves_injective_linearMap _ (Submodule.injective_subtype I)
    have hcomp : (LinearMap.lTensor A f).comp (LinearMap.rTensor M₁ I.subtype) =
        (LinearMap.rTensor M₂ I.subtype).comp (LinearMap.lTensor I f) := by
      rw [LinearMap.lTensor_comp_rTensor, LinearMap.rTensor_comp_lTensor]
    intro x y hxy
    apply hl
    apply hr
    have := congrArg (LinearMap.lTensor A f) hxy
    rw [← LinearMap.comp_apply (LinearMap.rTensor M₂ I.subtype),
      ← LinearMap.comp_apply (LinearMap.rTensor M₂ I.subtype), ← hcomp,
      LinearMap.comp_apply, LinearMap.comp_apply, this]

  set KJ : Submodule (MvPolynomial (Fin (N + 1)) A) (Fin 1 → MvPolynomial (Fin (N + 1)) A) :=
    Submodule.pi Set.univ (fun _ : Fin 1 => J) with hKJdef
  have hKJ : ∀ f ∈ KJ, ∀ t : ℕ, (fun r => if (fun _ : Fin 1 => (0 : ℕ)) r ≤ t then
      MvPolynomial.homogeneousComponent (t - (fun _ : Fin 1 => (0 : ℕ)) r) (f r) else 0) ∈ KJ := by
    intro f hf t
    rw [hKJdef, Submodule.mem_pi] at hf ⊢
    intro r _
    show (if 0 ≤ t then MvPolynomial.homogeneousComponent (t - 0) (f r) else 0) ∈ J
    rw [if_pos (Nat.zero_le t), Nat.sub_zero]
    exact hJ _ (hf r (Set.mem_univ r)) t
  obtain ⟨w0, hw0⟩ := wcpa_dj_sf_van_zero A (N + 1) 1 (fun _ => 0) KJ hKJ
  have hW : ∀ p : ℕ, ∃ W : ℤ, ∀ w : ℤ, W ≤ w → wcCnUtlVan A (N + 1) 1 (fun _ => 0) KJ p w := by
    intro p
    rcases Nat.eq_zero_or_pos p with hp | hp
    · subst hp
      exact ⟨w0, hw0⟩
    · exact wc_cn_laurent_serre_vanishing A (N + 1) 1 (fun _ => 0) KJ hKJ p hp
  choose W hW using hW
  refine ⟨∑ q ∈ Finset.range (N + 1), (W q).toNat, fun e he => ?_⟩
  have hLC : ∀ (w : ℤ) (σ : Finset (Fin (N + 1))) (v : Fin 1 → (Fin (N + 1) → ℤ) →₀ A),
      v ∈ wcLaurC A (N + 1) 1 (fun _ => 0) w σ ↔ ∀ r, v r ∈ Finsupp.supported A A
        {β : Fin (N + 1) → ℤ | ∑ i, β i = w - (((fun _ : Fin 1 => (0 : ℕ)) r : ℕ) : ℤ) ∧
          ∀ i, i ∉ σ → 0 ≤ β i} := fun _ _ _ => Iff.rfl
  have hvan : ∀ p : ℕ, wcCnUtlVan A (N + 1) 1 (fun _ => 0) KJ p (e : ℤ) := by
    intro p
    by_cases hpN : p < N + 1
    · apply hW p
      have h1 : (W p).toNat ≤ ∑ q ∈ Finset.range (N + 1), (W q).toNat :=
        Finset.single_le_sum (f := fun q => (W q).toNat) (fun _ _ => Nat.zero_le _)
          (Finset.mem_range.mpr hpN)
      have h2 : ((W p).toNat : ℤ) ≤ (e : ℤ) := by exact_mod_cast h1.trans he
      exact (Int.self_le_toNat (W p)).trans h2
    · unfold wcCnUtlVan
      intro z _ _
      refine ⟨0, fun σ => ⟨fun _ => (hLC _ _ _).mpr (fun r => Submodule.zero_mem _),
        fun _ => rfl⟩, fun σ hσ => ?_⟩
      exfalso
      have h1 := Finset.card_le_univ σ
      rw [Fintype.card_fin] at h1
      omega

  obtain ⟨P, hP⟩ : ∃ P : Finset (Fin (N + 1)) → Submodule A (Fin 1 → (Fin (N + 1) → ℤ) →₀ A),
      ∀ σ v, v ∈ P σ ↔ v ∈ wcLaurC A (N + 1) 1 (fun _ => 0) (e : ℤ) σ :=
    ⟨fun σ =>
      { carrier := wcLaurC A (N + 1) 1 (fun _ => 0) (e : ℤ) σ
        add_mem' := fun {a b} ha hb => (hLC _ _ _).mpr (fun r =>
          Submodule.add_mem _ ((hLC _ _ _).mp ha r) ((hLC _ _ _).mp hb r))
        zero_mem' := (hLC _ _ _).mpr (fun r => Submodule.zero_mem _)
        smul_mem' := fun c x hx => (hLC _ _ _).mpr (fun r =>
          Submodule.smul_mem _ c ((hLC _ _ _).mp hx r)) },
     fun σ v => Iff.rfl⟩

  have hmono : ∀ σ τ : Finset (Fin (N + 1)), σ ⊆ τ → P σ ≤ P τ ∧
      wcLaurK A (N + 1) 1 (fun _ => 0) KJ (e : ℤ) σ ≤ wcLaurK A (N + 1) 1 (fun _ => 0) KJ (e : ℤ) τ := by
    intro σ τ hστ
    refine ⟨fun v hv => ?_,
      wcpa_dj_sf_laurK_mono A (N + 1) 1 (fun _ => 0) KJ (e : ℤ) σ τ hshift hστ⟩
    rw [hP, hLC] at hv ⊢
    intro r
    refine Finsupp.supported_mono ?_ (hv r)
    intro β hβ
    simp only [Set.mem_setOf_eq] at hβ ⊢
    exact ⟨hβ.1, fun l hl => hβ.2 l (fun h => hl (hστ h))⟩
  have hsub : ∀ σ, wcLaurK A (N + 1) 1 (fun _ => 0) KJ (e : ℤ) σ ≤ P σ := fun σ v hv =>
    (hP σ v).mpr (wc_gc_laurK_sub_laurC A (N + 1) 1 (fun _ => 0) KJ (e : ℤ) σ v hv)

  have quotflat : ∀ (V M : Type u) [AddCommGroup V] [Module A V] [AddCommGroup M] [Module A M]
      (P' Q' : Submodule A V) (Θ : ↥P' →ₗ[A] M), Module.Flat A M → Function.Surjective Θ →
      LinearMap.ker Θ = Submodule.comap P'.subtype Q' → wcpaSfQuotFlat A V P' Q' := by
    intro V M _ _ _ _ P' Q' Θ hM hΘs hΘk
    haveI := hM
    unfold wcpaSfQuotFlat
    exact Module.Flat.of_linearEquiv ((Submodule.quotEquivOfEq _ _ hΘk.symm).trans
      (LinearMap.quotKerEquivOfSurjective Θ hΘs))
  have hflatσ : ∀ σ : Finset (Fin (N + 1)), σ.Nonempty → wcpaSfQuotFlat A
      (Fin 1 → (Fin (N + 1) → ℤ) →₀ A) (P σ) (wcLaurK A (N + 1) 1 (fun _ => 0) KJ (e : ℤ) σ) := by
    intro σ hσ
    obtain ⟨i, hi⟩ := hσ
    obtain ⟨hsurj, hadd, hsmul⟩ := wcpa_dj_sf_chart_surj A N J i σ (e : ℤ) hi
    have hker := wcpa_dj_sf_chart_ker A N J i σ (e : ℤ) hi hshift
      (wcpa_dj_sf_dehom_kernel A N J hJ i)
    obtain ⟨Θ, hΘ⟩ : ∃ Θ : ↥(P σ) →ₗ[A] Localization.Away (Ideal.Quotient.mk
        (J ⊔ Ideal.span {MvPolynomial.X i - 1}) (∏ j ∈ σ, MvPolynomial.X j)),
        ∀ v : ↥(P σ), Θ v = wcLaurEval (N + 1) (algebraMap A (Localization.Away
          (Ideal.Quotient.mk (J ⊔ Ideal.span {MvPolynomial.X i - 1}) (∏ j ∈ σ, MvPolynomial.X j))))
          (fun l => algebraMap (MvPolynomial (Fin (N + 1)) A ⧸ (J ⊔ Ideal.span {MvPolynomial.X i - 1}))
            (Localization.Away (Ideal.Quotient.mk (J ⊔ Ideal.span {MvPolynomial.X i - 1})
              (∏ j ∈ σ, MvPolynomial.X j)))
            (Ideal.Quotient.mk (J ⊔ Ideal.span {MvPolynomial.X i - 1}) (MvPolynomial.X l)))
          ((v : Fin 1 → (Fin (N + 1) → ℤ) →₀ A) 0) :=
      ⟨{ toFun := fun v => wcLaurEval (N + 1) (algebraMap A (Localization.Away
            (Ideal.Quotient.mk (J ⊔ Ideal.span {MvPolynomial.X i - 1}) (∏ j ∈ σ, MvPolynomial.X j))))
            (fun l => algebraMap (MvPolynomial (Fin (N + 1)) A ⧸ (J ⊔ Ideal.span {MvPolynomial.X i - 1}))
              (Localization.Away (Ideal.Quotient.mk (J ⊔ Ideal.span {MvPolynomial.X i - 1})
                (∏ j ∈ σ, MvPolynomial.X j)))
              (Ideal.Quotient.mk (J ⊔ Ideal.span {MvPolynomial.X i - 1}) (MvPolynomial.X l)))
            ((v : Fin 1 → (Fin (N + 1) → ℤ) →₀ A) 0)
         map_add' := fun v v' => hadd v.1 v'.1
         map_smul' := fun a v => (hsmul a v.1).trans (Algebra.smul_def a _).symm }, fun _ => rfl⟩
    have hΘs : Function.Surjective Θ := fun y => by
      obtain ⟨v, hv, hvy⟩ := hsurj y
      exact ⟨⟨v, (hP σ v).mpr hv⟩, by rw [hΘ]; exact hvy⟩
    have hΘk : LinearMap.ker Θ =
        Submodule.comap (P σ).subtype (wcLaurK A (N + 1) 1 (fun _ => 0) KJ (e : ℤ) σ) := by
      ext v
      rw [LinearMap.mem_ker, Submodule.mem_comap, Submodule.subtype_apply, hΘ]
      exact hker v.1 ((hP σ v.1).mp v.2)
    haveI : Module.Flat A (MvPolynomial (Fin (N + 1)) A ⧸ (J ⊔ Ideal.span {MvPolynomial.X i - 1})) :=
      hflat i
    haveI : Module.Flat A (Localization.Away (Ideal.Quotient.mk
        (J ⊔ Ideal.span {MvPolynomial.X i - 1}) (∏ j ∈ σ, MvPolynomial.X j))) :=
      Module.Flat.trans A (MvPolynomial (Fin (N + 1)) A ⧸ (J ⊔ Ideal.span {MvPolynomial.X i - 1})) _
    exact quotflat _ _ (P σ) _ Θ inferInstance hΘs hΘk
  have hinj : ∀ x ∈ P ∅, (∀ i : Fin (N + 1), x ∈ wcLaurK A (N + 1) 1 (fun _ => 0) KJ (e : ℤ) {i}) →
      x ∈ wcLaurK A (N + 1) 1 (fun _ => 0) KJ (e : ℤ) ∅ := by
    intro x hx hxi
    refine wcpa_dj_sf_h0_inj A N J hshift hsat ?_ e x ((hP ∅ x).mp hx) hxi
    intro i w v hv
    obtain ⟨k, f, hf, -, hv0⟩ := wcpa_dj_sf_laurK_collapse A N J {i} w hshift v hv
    exact ⟨k, f, hf, hv0⟩
  have hvan' : ∀ (p : ℕ) (z : Finset (Fin (N + 1)) → Fin 1 → (Fin (N + 1) → ℤ) →₀ A),
      (∀ σ, (σ.card = p + 1 → z σ ∈ P σ) ∧ (σ.card ≠ p + 1 → z σ = 0)) →
      (∀ τ : Finset (Fin (N + 1)), τ.card = p + 2 →
        wcAltD (A := A) (N + 1) z τ ∈ wcLaurK A (N + 1) 1 (fun _ => 0) KJ (e : ℤ) τ) →
      ∃ y : Finset (Fin (N + 1)) → Fin 1 → (Fin (N + 1) → ℤ) →₀ A,
        (∀ σ, (σ.card = p → y σ ∈ P σ) ∧ (σ.card ≠ p → y σ = 0)) ∧
        ∀ σ : Finset (Fin (N + 1)), σ.card = p + 1 →
          z σ - wcAltD (A := A) (N + 1) y σ ∈ wcLaurK A (N + 1) 1 (fun _ => 0) KJ (e : ℤ) σ := by
    intro p z hz hdz
    obtain ⟨y, hy1, hy2⟩ := hvan p z
      (fun σ => ⟨fun h => (hP σ (z σ)).mp ((hz σ).1 h), (hz σ).2⟩) hdz
    exact ⟨y, fun σ => ⟨fun h => (hP σ (y σ)).mpr ((hy1 σ).1 h), (hy1 σ).2⟩, hy2⟩

  have hfinal := wcpa_dj_sf_cech_flat A (Fin 1 → (Fin (N + 1) → ℤ) →₀ A) (N + 1) P
    (fun σ => wcLaurK A (N + 1) 1 (fun _ => 0) KJ (e : ℤ) σ) flatker hmono hsub hflatσ hinj
    (wc_gc_altD_sq_zero A _ (N + 1)) hvan'
  exact wcpa_dj_sf_deg0_iso A N J e (P ∅) (wcLaurK A (N + 1) 1 (fun _ => 0) KJ (e : ℤ) ∅) (hP ∅)
    rfl hfinal

theorem wcpa_dj_flrg_sc_gen_degree : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (N : ℕ) (J : Ideal (MvPolynomial (Fin (N + 1)) A)), (∀ F ∈ J, ∀ e : ℕ, MvPolynomial.homogeneousComponent e F ∈ J) → ∃ D : ℕ, ∀ e, D ≤ e → ∀ F ∈ J, F.IsHomogeneous (e + 1) → F ∈ Submodule.span A {H | ∃ (l : Fin (N + 1)) (G : MvPolynomial (Fin (N + 1)) A), G ∈ J ∧ G.IsHomogeneous e ∧ H = MvPolynomial.X l * G} :=
by
  intro A _ _ N J hJ
  classical
  have step : ∀ (t : MvPolynomial (Fin (N + 1)) A) (i e : ℕ), t ∈ J → t.IsHomogeneous i → i ≤ e →
      ∀ a : MvPolynomial (Fin (N + 1)) A, MvPolynomial.homogeneousComponent (e + 1) (a * t) ∈
        Submodule.span A {H | ∃ (l : Fin (N + 1)) (G : MvPolynomial (Fin (N + 1)) A),
          G ∈ J ∧ G.IsHomogeneous e ∧ H = MvPolynomial.X l * G} := by
    intro t i e ht hti hie a
    induction a using MvPolynomial.induction_on' with
    | monomial u c =>
      have hP : (MvPolynomial.monomial u c * t).IsHomogeneous (u.degree + i) :=
        (MvPolynomial.isHomogeneous_monomial c rfl).mul hti
      rw [MvPolynomial.homogeneousComponent_of_mem
        ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr hP)]
      split_ifs with h
      · have hu : u ≠ 0 := by
          rintro rfl
          simp at h
          omega
        obtain ⟨l, hl⟩ := Finsupp.support_nonempty_iff.mpr hu
        have hle : Finsupp.single l 1 ≤ u := by
          rw [Finsupp.single_le_iff]
          exact Nat.one_le_iff_ne_zero.mpr (Finsupp.mem_support_iff.mp hl)
        obtain ⟨u', hu'⟩ : ∃ u', u = Finsupp.single l 1 + u' :=
          ⟨u - Finsupp.single l 1, (add_tsub_cancel_of_le hle).symm⟩
        have hdeg : u.degree = 1 + u'.degree := by
          rw [hu', map_add, Finsupp.degree_single]
        apply Submodule.subset_span
        refine ⟨l, MvPolynomial.monomial u' c * t, J.mul_mem_left _ ht, ?_, ?_⟩
        · have := (MvPolynomial.isHomogeneous_monomial (σ := Fin (N + 1)) c
            (rfl : u'.degree = u'.degree)).mul hti
          convert this using 1
          omega
        · rw [← mul_assoc, MvPolynomial.X, MvPolynomial.monomial_mul_monomial, one_mul, ← hu']
      · exact Submodule.zero_mem _
    | add p q hp hq =>
      rw [add_mul, map_add]
      exact Submodule.add_mem _ hp hq
  obtain ⟨s, hs⟩ := (IsNoetherian.noetherian J : J.FG)
  refine ⟨s.sup MvPolynomial.totalDegree, ?_⟩
  intro e hDe F hF hFhom
  set T : Set (MvPolynomial (Fin (N + 1)) A) := {t | ∃ g ∈ s, ∃ i ≤ g.totalDegree,
    t = MvPolynomial.homogeneousComponent i g} with hT
  have hsJ : ∀ g ∈ s, g ∈ J := fun g hg => hs ▸ Submodule.subset_span hg
  have hTJ : J ≤ Ideal.span T := by
    rw [← hs]
    show Ideal.span (s : Set (MvPolynomial (Fin (N + 1)) A)) ≤ Ideal.span T
    rw [Ideal.span_le]
    intro g hg
    rw [← MvPolynomial.sum_homogeneousComponent g]
    exact Ideal.sum_mem _ (fun i hi => Ideal.subset_span
      ⟨g, hg, i, Nat.lt_succ_iff.mp (Finset.mem_range.mp hi), rfl⟩)
  have claim : ∀ x ∈ Ideal.span T, ∀ a : MvPolynomial (Fin (N + 1)) A,
      MvPolynomial.homogeneousComponent (e + 1) (a * x) ∈
        Submodule.span A {H | ∃ (l : Fin (N + 1)) (G : MvPolynomial (Fin (N + 1)) A),
          G ∈ J ∧ G.IsHomogeneous e ∧ H = MvPolynomial.X l * G} := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨g, hg, i, hi, rfl⟩ := hx
      exact step _ i e (hJ g (hsJ g hg) i) (MvPolynomial.homogeneousComponent_isHomogeneous i g)
        (le_trans hi (le_trans (Finset.le_sup (f := MvPolynomial.totalDegree) hg) hDe))
    | zero =>
      intro a
      rw [mul_zero, map_zero]
      exact Submodule.zero_mem _
    | add x y _ _ hx hy =>
      intro a
      rw [mul_add, map_add]
      exact Submodule.add_mem _ (hx a) (hy a)
    | smul b x _ hx =>
      intro a
      rw [smul_eq_mul, ← mul_assoc]
      exact hx (a * b)
  have := claim F (hTJ hF) 1
  rwa [one_mul, MvPolynomial.homogeneousComponent_of_mem
    ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr hFhom), if_pos rfl] at this

theorem wcpa_dj_flrg_serre_cover : ∀ (k : Type u) [Field k] (N : ℕ) (B Z : Scheme.{u}) (sB : B ⟶ Spec (.of k)) (jZ : Z ⟶ wcProjK k N) (g : Z ⟶ B) (hZ : jZ ≫ wcProjKStr k N = g ≫ sB), IsClosedImmersion (Limits.pullback.lift jZ g hZ) → Flat g → IsLocallyNoetherian B → CompactSpace B → ∃ (m : ℕ) (V : Fin m → B.Opens) (E : ℕ), 1 ≤ E ∧ (∀ j, IsAffineOpen (V j)) ∧ (⨆ j, V j) = ⊤ ∧ ∀ j e, E ≤ e → Module.Projective Γ(B, V j) (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Γ(B, V j) e) ⧸ wcpaDjDeg N (wcpaDjFlrgSat k N sB jZ g hZ (V j)) e) ∧ wcpaDjGen N (wcpaDjFlrgSat k N sB jZ g hZ (V j)) e :=
by
  intro k _ N B Z sB jZ g hZ hε hg hBnoeth hBcpt
  classical

  have s9 : ∀ (A : Type u) [CommRing A] (e : ℕ),
      Module.Finite A ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A e) := by
    intro A _ e
    have hfin : Set.Finite {d : Fin (N + 1) →₀ ℕ | d.degree = e} := by
      apply (Finset.finite_toSet
        (Finset.finsuppAntidiag (Finset.univ : Finset (Fin (N + 1))) e)).subset
      intro d hd
      rw [Set.mem_setOf_eq] at hd
      rw [Finset.mem_coe, Finset.mem_finsuppAntidiag]
      refine ⟨?_, Finset.subset_univ _⟩
      rw [← hd, Finsupp.degree_eq_sum]
    haveI : Finite {d : Fin (N + 1) →₀ ℕ | d.degree = e} := hfin.to_subtype
    rw [MvPolynomial.homogeneousSubmodule_eq_finsupp_supported]
    exact Module.Finite.equiv (AddMonoidAlgebra.supportedEquivFinsupp _).symm

  have hcov : ∃ (m : ℕ) (V : Fin m → B.Opens), (∀ j, IsAffineOpen (V j)) ∧ (⨆ j, V j) = ⊤ := by
    have hx : ∀ x : B, ∃ U : B.Opens, IsAffineOpen U ∧ x ∈ U := fun x => by
      obtain ⟨U', hU', hxU', -⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Scheme.isBasis_affineOpens B))
          (show x ∈ (⊤ : B.Opens) from trivial)
      exact ⟨U', hU', hxU'⟩
    choose U hUa hxU using hx
    obtain ⟨t, ht⟩ := CompactSpace.elim_nhds_subcover (fun x => (U x : Set B))
      (fun x => (U x).isOpen.mem_nhds (hxU x))
    refine ⟨t.card, fun j => U (t.equivFin.symm j), fun j => hUa _, ?_⟩
    rw [eq_top_iff]
    intro y _
    have hy : y ∈ ⋃ x ∈ t, (U x : Set B) := by rw [ht]; trivial
    simp only [Set.mem_iUnion] at hy
    obtain ⟨x, hxt, hyx⟩ := hy
    rw [TopologicalSpace.Opens.mem_iSup]
    exact ⟨t.equivFin ⟨x, hxt⟩, by simpa using hyx⟩
  obtain ⟨m, V, hV, hsup⟩ := hcov

  have key : ∀ j, ∃ E₀ : ℕ, ∀ e, E₀ ≤ e →
      Module.Projective Γ(B, V j) (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Γ(B, V j) e) ⧸
        wcpaDjDeg N (wcpaDjFlrgSat k N sB jZ g hZ (V j)) e) ∧
      wcpaDjGen N (wcpaDjFlrgSat k N sB jZ g hZ (V j)) e := by
    intro j
    haveI hA : IsNoetherianRing Γ(B, V j) := IsLocallyNoetherian.component_noetherian ⟨V j, hV j⟩
    obtain ⟨hhom, hmem, hsat⟩ := wcpa_dj_flrg_sc_sat_algebra Γ(B, V j) N
      (fun i => (Γ(Limits.pullback (wcProjKStr k N) sB, wcpaDjFlrgChart k N sB (V j) i) : Type u))
      (fun i => wcpaDjFlrgPsi k N sB (V j) i)
      (fun i => RingHom.ker ((Limits.pullback.lift jZ g hZ).app (wcpaDjFlrgChart k N sB (V j) i)).hom)
    have hX : ∀ i, wcpaDjFlrgPsi k N sB (V j) i (MvPolynomial.X i) = 1 := by
      intro i
      simp only [wcpaDjFlrgPsi, MvPolynomial.eval₂Hom_X']
      rw [(wc_ldpi_oai_sgE_facts k N i i).1, map_one]
    have hsat' := hsat hX
    have hker := wcpa_dj_flrg_sc_chart_kernel k N B Z sB jZ g hZ hε (V j) (hV j)
      (fun F e hF => hmem F e hF) (wcpa_dj_flrg_sc_psi_transition k N B sB (V j))
    have hflat : ∀ i : Fin (N + 1), Module.Flat Γ(B, V j)
        (MvPolynomial (Fin (N + 1)) Γ(B, V j) ⧸
          (wcpaDjFlrgSat k N sB jZ g hZ (V j) ⊔ Ideal.span {MvPolynomial.X i - 1})) := fun i =>
      wcpa_dj_flrg_sc_dehomog_flat k N B Z sB jZ g hZ hε hg (V j) (hV j) i
        (wcpa_dj_flrg_sc_psi_surj k N B sB (V j) (hV j) i) (hker i)
    obtain ⟨e₁, he₁⟩ := wcpa_dj_flrg_sc_serre_flat Γ(B, V j) N
      (wcpaDjFlrgSat k N sB jZ g hZ (V j)) hhom hsat' hflat
    obtain ⟨D, hD⟩ := wcpa_dj_flrg_sc_gen_degree Γ(B, V j) N
      (wcpaDjFlrgSat k N sB jZ g hZ (V j)) hhom
    refine ⟨e₁ + D, fun e he => ⟨?_, ?_⟩⟩
    · haveI : Module.Flat Γ(B, V j)
          (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Γ(B, V j) e) ⧸
            wcpaDjDeg N (wcpaDjFlrgSat k N sB jZ g hZ (V j)) e) := he₁ e (by omega)
      haveI := s9 Γ(B, V j) e
      haveI : Module.FinitePresentation Γ(B, V j)
          (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Γ(B, V j) e) ⧸
            wcpaDjDeg N (wcpaDjFlrgSat k N sB jZ g hZ (V j)) e) :=
        Module.finitePresentation_of_finite _ _
      exact Module.Flat.projective_of_finitePresentation
    · exact hD e (by omega)
  choose E₀ hE₀ using key
  refine ⟨m, V, 1 + ∑ j, E₀ j, by omega, hV, hsup, fun j e he => hE₀ j e ?_⟩
  have := Finset.single_le_sum (f := E₀) (fun i _ => Nat.zero_le _) (Finset.mem_univ j)
  omega

theorem wcpa_mac_rec : ∀ d k r : ℕ, r < Nat.choose k d → wcpaDjMacUp (d + 1) (Nat.choose k (d + 1) + r) = Nat.choose (k + 1) (d + 2) + wcpaDjMacUp d r ∧ ∀ a : ℕ, ∃ k r : ℕ, a = Nat.choose k (d + 1) + r ∧ r < Nat.choose k d :=
by
  have s1 : ∀ d j : ℕ, j ≤ Nat.choose j (d + 1) + d := by
    intro d j
    induction j with
    | zero => omega
    | succ j ih =>
      by_cases h : j + 1 ≤ d
      · omega
      · have hp := Nat.choose_succ_succ' j d
        have hpos := Nat.choose_pos (show d ≤ j by omega)
        omega
  have s2 : ∀ d k r : ℕ, r < Nat.choose k d →
      Nat.findGreatest (fun j => Nat.choose j (d + 1) ≤ Nat.choose k (d + 1) + r)
        (Nat.choose k (d + 1) + r + d + 1) = k := by
    intro d k r hr
    rw [Nat.findGreatest_eq_iff]
    refine ⟨?_, ?_, ?_⟩
    · have := s1 d k
      omega
    · intro _
      show Nat.choose k (d + 1) ≤ Nat.choose k (d + 1) + r
      omega
    · intro n' hn' _ hle
      have h1 := Nat.choose_le_choose (d + 1) (show k + 1 ≤ n' by omega)
      have hp := Nat.choose_succ_succ' k d
      have hle' : Nat.choose n' (d + 1) ≤ Nat.choose k (d + 1) + r := hle
      omega
  intro d k r hr
  refine ⟨?_, ?_⟩
  · rw [wcpaDjMacUp.eq_2, s2 d k r hr, Nat.add_sub_cancel_left]
  · intro a
    have ha : Nat.choose (Nat.findGreatest (fun j => Nat.choose j (d + 1) ≤ a) (a + d + 1)) (d + 1)
        ≤ a :=
      Nat.findGreatest_spec (P := fun j => Nat.choose j (d + 1) ≤ a) (Nat.zero_le _)
        (by simp [Nat.choose_zero_succ])
    have hc : a < Nat.choose
        (Nat.findGreatest (fun j => Nat.choose j (d + 1) ≤ a) (a + d + 1) + 1) (d + 1) := by
      by_cases hb : Nat.findGreatest (fun j => Nat.choose j (d + 1) ≤ a) (a + d + 1) + 1
          ≤ a + d + 1
      · have h := Nat.findGreatest_is_greatest (Nat.lt_succ_self _) hb
        exact Nat.lt_of_not_le h
      · have h1 := Nat.findGreatest_le (P := fun j => Nat.choose j (d + 1) ≤ a) (a + d + 1)
        have h2 := s1 d (Nat.findGreatest (fun j => Nat.choose j (d + 1) ≤ a) (a + d + 1) + 1)
        omega
    have hp := Nat.choose_succ_succ'
      (Nat.findGreatest (fun j => Nat.choose j (d + 1) ≤ a) (a + d + 1)) d
    generalize Nat.findGreatest (fun j => Nat.choose j (d + 1) ≤ a) (a + d + 1) = κ at ha hc hp
    exact ⟨κ, a - Nat.choose κ (d + 1), by omega, by omega⟩

theorem wcpa_mac_superadd : ∀ d x y : ℕ, wcpaDjMacUp d x + wcpaDjMacUp d y ≤ wcpaDjMacUp d (x + y) :=
by
  have hrec : ∀ d k r : ℕ, r < Nat.choose k d → wcpaDjMacUp (d + 1) (Nat.choose k (d + 1) + r) = Nat.choose (k + 1) (d + 2) + wcpaDjMacUp d r ∧ ∀ a : ℕ, ∃ k r : ℕ, a = Nat.choose k (d + 1) + r ∧ r < Nat.choose k d := by
    have s1 : ∀ d j : ℕ, j ≤ Nat.choose j (d + 1) + d := by
      intro d j
      induction j with
      | zero => omega
      | succ j ih =>
        by_cases h : j + 1 ≤ d
        · omega
        · have hp := Nat.choose_succ_succ' j d
          have hpos := Nat.choose_pos (show d ≤ j by omega)
          omega
    have s2 : ∀ d k r : ℕ, r < Nat.choose k d →
        Nat.findGreatest (fun j => Nat.choose j (d + 1) ≤ Nat.choose k (d + 1) + r)
          (Nat.choose k (d + 1) + r + d + 1) = k := by
      intro d k r hr
      rw [Nat.findGreatest_eq_iff]
      refine ⟨?_, ?_, ?_⟩
      · have := s1 d k
        omega
      · intro _
        show Nat.choose k (d + 1) ≤ Nat.choose k (d + 1) + r
        omega
      · intro n' hn' _ hle
        have h1 := Nat.choose_le_choose (d + 1) (show k + 1 ≤ n' by omega)
        have hp := Nat.choose_succ_succ' k d
        have hle' : Nat.choose n' (d + 1) ≤ Nat.choose k (d + 1) + r := hle
        omega
    intro d k r hr
    refine ⟨?_, ?_⟩
    · rw [wcpaDjMacUp.eq_2, s2 d k r hr, Nat.add_sub_cancel_left]
    · intro a
      have ha : Nat.choose (Nat.findGreatest (fun j => Nat.choose j (d + 1) ≤ a) (a + d + 1)) (d + 1)
          ≤ a :=
        Nat.findGreatest_spec (P := fun j => Nat.choose j (d + 1) ≤ a) (Nat.zero_le _)
          (by simp [Nat.choose_zero_succ])
      have hc : a < Nat.choose
          (Nat.findGreatest (fun j => Nat.choose j (d + 1) ≤ a) (a + d + 1) + 1) (d + 1) := by
        by_cases hb : Nat.findGreatest (fun j => Nat.choose j (d + 1) ≤ a) (a + d + 1) + 1
            ≤ a + d + 1
        · have h := Nat.findGreatest_is_greatest (Nat.lt_succ_self _) hb
          exact Nat.lt_of_not_le h
        · have h1 := Nat.findGreatest_le (P := fun j => Nat.choose j (d + 1) ≤ a) (a + d + 1)
          have h2 := s1 d (Nat.findGreatest (fun j => Nat.choose j (d + 1) ≤ a) (a + d + 1) + 1)
          omega
      have hp := Nat.choose_succ_succ'
        (Nat.findGreatest (fun j => Nat.choose j (d + 1) ≤ a) (a + d + 1)) d
      generalize Nat.findGreatest (fun j => Nat.choose j (d + 1) ≤ a) (a + d + 1) = κ at ha hc hp
      exact ⟨κ, a - Nat.choose κ (d + 1), by omega, by omega⟩
  have hM0 : ∀ d, wcpaDjMacUp d 0 = 0 := by
    intro d
    induction d with
    | zero => exact wcpaDjMacUp.eq_1 0
    | succ d ih =>
      have h1 : 0 < Nat.choose d d := by rw [Nat.choose_self]; exact Nat.one_pos
      have h := (hrec d d 0 h1).1
      rw [Nat.choose_eq_zero_of_lt (by omega : d < d + 1),
        Nat.choose_eq_zero_of_lt (by omega : d + 1 < d + 2), ih] at h
      simpa using h
  have hrep : ∀ e a : ℕ, ∃ k r : ℕ, a = Nat.choose k (e + 1) + r ∧ r < Nat.choose k e :=
    fun e a => (hrec e e 0 (by rw [Nat.choose_self]; exact Nat.one_pos)).2 a
  have hval : ∀ e k : ℕ, wcpaDjMacUp (e + 1) (Nat.choose k (e + 1)) = Nat.choose (k + 1) (e + 2) := by
    intro e k
    rcases Nat.eq_zero_or_pos (Nat.choose k e) with h | h
    · have hk : k < e := Nat.choose_eq_zero_iff.mp h
      have h1 : Nat.choose k (e + 1) = 0 := Nat.choose_eq_zero_of_lt (by omega)
      have h2 : Nat.choose (k + 1) (e + 2) = 0 := Nat.choose_eq_zero_of_lt (by omega)
      rw [h1, h2]
      exact hM0 (e + 1)
    · have := (hrec e k 0 h).1
      simp only [add_zero, hM0] at this
      exact this
  have hsh : ∀ d m c : ℕ, c ≤ Nat.choose m (d + 1) →
      wcpaDjMacUp (d + 2) (Nat.choose m (d + 2) + c) =
        Nat.choose (m + 1) (d + 3) + wcpaDjMacUp (d + 1) c := by
    intro d m c hc
    rcases Nat.lt_or_ge c (Nat.choose m (d + 1)) with h | h
    · exact (hrec (d + 1) m c h).1
    · have hc' : c = Nat.choose m (d + 1) := le_antisymm hc h
      subst hc'
      have p1 : Nat.choose (m + 1) (d + 2) = Nat.choose m (d + 1) + Nat.choose m (d + 2) :=
        Nat.choose_succ_succ' m (d + 1)
      have p2 : Nat.choose (m + 2) (d + 3) = Nat.choose (m + 1) (d + 2) + Nat.choose (m + 1) (d + 3) :=
        Nat.choose_succ_succ' (m + 1) (d + 2)
      have v1 : wcpaDjMacUp (d + 2) (Nat.choose (m + 1) (d + 2)) = Nat.choose (m + 2) (d + 3) :=
        hval (d + 1) (m + 1)
      have v2 : wcpaDjMacUp (d + 1) (Nat.choose m (d + 1)) = Nat.choose (m + 1) (d + 2) := hval d m
      rw [show Nat.choose m (d + 2) + Nat.choose m (d + 1) = Nat.choose (m + 1) (d + 2) by omega,
        v1, v2]
      omega
  have hU : ∀ m j : ℕ, Nat.choose m j ≤ Nat.choose m (j + 1) ∨
      Nat.choose m (j + 2) ≤ Nat.choose m (j + 1) := by
    intro m j
    have e1 : Nat.choose m (j + 1) * (j + 1) = Nat.choose m j * (m - j) := Nat.choose_succ_right_eq m j
    have e2 : Nat.choose m (j + 2) * (j + 2) = Nat.choose m (j + 1) * (m - (j + 1)) :=
      Nat.choose_succ_right_eq m (j + 1)
    by_cases h : j + 1 ≤ m - j
    · left
      have : Nat.choose m j * (j + 1) ≤ Nat.choose m (j + 1) * (j + 1) := by
        calc Nat.choose m j * (j + 1) ≤ Nat.choose m j * (m - j) := Nat.mul_le_mul_left _ h
          _ = Nat.choose m (j + 1) * (j + 1) := e1.symm
      exact Nat.le_of_mul_le_mul_right this (by omega)
    · right
      have : Nat.choose m (j + 2) * (j + 2) ≤ Nat.choose m (j + 1) * (j + 2) := by
        calc Nat.choose m (j + 2) * (j + 2) = Nat.choose m (j + 1) * (m - (j + 1)) := e2
          _ ≤ Nat.choose m (j + 1) * (j + 2) := Nat.mul_le_mul_left _ (by omega)
      exact Nat.le_of_mul_le_mul_right this (by omega)
  have hT : ∀ n : ℕ, 2 * Nat.choose (n + 1) 2 = n * (n + 1) := by
    intro n
    induction n with
    | zero => rfl
    | succ n ih =>
      have p : Nat.choose (n + 1 + 1) 2 = Nat.choose (n + 1) 1 + Nat.choose (n + 1) 2 :=
        Nat.choose_succ_succ' (n + 1) 1
      rw [p, Nat.choose_one_right]
      nlinarith [ih]
  have hM1 : ∀ a, wcpaDjMacUp 1 a = Nat.choose (a + 1) 2 := by
    intro a
    have h := (hrec 0 a 0 (by simp)).1
    simp only [zero_add, add_zero, Nat.choose_one_right, hM0] at h
    exact h
  have SA1 : ∀ x y : ℕ, wcpaDjMacUp 1 x + wcpaDjMacUp 1 y ≤ wcpaDjMacUp 1 (x + y) := by
    intro x y
    simp only [hM1]
    have h1 := hT x
    have h2 := hT y
    have h3 := hT (x + y)
    nlinarith [Nat.zero_le (x * y)]
  have MW1 : ∀ k s t : ℕ, s + t ≤ Nat.choose k 1 → wcpaDjMacUp 1 (s + t) +
      wcpaDjMacUp 1 (Nat.choose k 1 - t) ≤ wcpaDjMacUp 1 (Nat.choose k 1) + wcpaDjMacUp 1 s := by
    intro k s t hst
    rw [Nat.choose_one_right] at hst ⊢
    obtain ⟨w, rfl⟩ : ∃ w, k = s + t + w := ⟨k - s - t, by omega⟩
    rw [show s + t + w - t = s + w by omega]
    simp only [hM1]
    have h1 := hT (s + t)
    have h2 := hT (s + w)
    have h3 := hT (s + t + w)
    have h4 := hT s
    nlinarith [Nat.zero_le (t * w)]
  have claim : ∀ d : ℕ, (∀ x y : ℕ, wcpaDjMacUp (d + 1) x + wcpaDjMacUp (d + 1) y ≤
      wcpaDjMacUp (d + 1) (x + y)) ∧ (∀ k s t : ℕ, s + t ≤ Nat.choose k (d + 1) →
      wcpaDjMacUp (d + 1) (s + t) + wcpaDjMacUp (d + 1) (Nat.choose k (d + 1) - t) ≤
        wcpaDjMacUp (d + 1) (Nat.choose k (d + 1)) + wcpaDjMacUp (d + 1) s) := by
    intro d
    induction d with
    | zero => exact ⟨SA1, MW1⟩
    | succ d ih =>
      obtain ⟨SAg, MWg⟩ := ih
      have hg0 : wcpaDjMacUp (d + 1) 0 = 0 := hM0 (d + 1)
      have SAg' : ∀ x y z : ℕ, z = x + y →
          wcpaDjMacUp (d + 1) x + wcpaDjMacUp (d + 1) y ≤ wcpaDjMacUp (d + 1) z := by
        intro x y z h
        subst h
        exact SAg x y
      have MWg' : ∀ k B s t x y : ℕ, B = Nat.choose k (d + 1) → s + t ≤ B → x = s + t →
          y = B - t →
          wcpaDjMacUp (d + 1) x + wcpaDjMacUp (d + 1) y ≤
            wcpaDjMacUp (d + 1) B + wcpaDjMacUp (d + 1) s := by
        intro k B s t x y hB hst hx hy
        subst hx hy hB
        exact MWg k s t hst
      have shift' : ∀ m A c x : ℕ, A = Nat.choose m (d + 2) → c ≤ Nat.choose m (d + 1) →
          x = A + c → wcpaDjMacUp (d + 2) x = Nat.choose (m + 1) (d + 3) + wcpaDjMacUp (d + 1) c := by
        intro m A c x hA hc hx
        subst hx hA
        exact hsh d m c hc

      have binpt : ∀ k : ℕ, Nat.choose (k + 1) (d + 3) ≤ wcpaDjMacUp (d + 1) (Nat.choose k (d + 2)) := by
        intro k
        induction k with
        | zero =>
          have : Nat.choose (0 + 1) (d + 3) = 0 := Nat.choose_eq_zero_of_lt (by omega)
          omega
        | succ k ih =>
          have p1 : Nat.choose (k + 1) (d + 2) = Nat.choose k (d + 1) + Nat.choose k (d + 2) :=
            Nat.choose_succ_succ' k (d + 1)
          have p2 : Nat.choose (k + 1 + 1) (d + 3) =
              Nat.choose (k + 1) (d + 2) + Nat.choose (k + 1) (d + 3) :=
            Nat.choose_succ_succ' (k + 1) (d + 2)
          have h1 := SAg' (Nat.choose k (d + 1)) (Nat.choose k (d + 2)) (Nat.choose (k + 1) (d + 2)) p1
          have h2 : wcpaDjMacUp (d + 1) (Nat.choose k (d + 1)) = Nat.choose (k + 1) (d + 2) := hval d k
          omega
      have KLE : ∀ a : ℕ, wcpaDjMacUp (d + 2) a ≤ wcpaDjMacUp (d + 1) a := by
        intro a
        obtain ⟨k, r, ha, hr⟩ : ∃ k r : ℕ, a = Nat.choose k (d + 2) + r ∧ r < Nat.choose k (d + 1) :=
          hrep (d + 1) a
        have h1 := shift' k _ r a rfl hr.le ha
        have h2 := SAg' (Nat.choose k (d + 2)) r a ha
        have h3 := binpt k
        omega

      have TWC : ∀ n t : ℕ, t ≤ Nat.choose n (d + 2) → t ≤ Nat.choose n (d + 1) →
          wcpaDjMacUp (d + 2) (Nat.choose n (d + 2)) + wcpaDjMacUp (d + 1) (Nat.choose n (d + 1) - t) ≤
            wcpaDjMacUp (d + 1) (Nat.choose n (d + 1)) +
              wcpaDjMacUp (d + 2) (Nat.choose n (d + 2) - t) := by
        intro n
        induction n with
        | zero =>
          intro t h1 h2
          have h0 : Nat.choose 0 (d + 2) = 0 := Nat.choose_eq_zero_of_lt (by omega)
          have ht : t = 0 := by omega
          subst ht
          simp only [Nat.sub_zero]
          omega
        | succ n ih =>
          intro t htA htB
          obtain ⟨A1, hA1⟩ : ∃ X, X = Nat.choose n (d + 2) := ⟨_, rfl⟩
          obtain ⟨B1, hB1⟩ : ∃ X, X = Nat.choose n (d + 1) := ⟨_, rfl⟩
          obtain ⟨B0, hB0⟩ : ∃ X, X = Nat.choose n d := ⟨_, rfl⟩
          obtain ⟨A, hA⟩ : ∃ X, X = Nat.choose (n + 1) (d + 2) := ⟨_, rfl⟩
          obtain ⟨B, hB⟩ : ∃ X, X = Nat.choose (n + 1) (d + 1) := ⟨_, rfl⟩
          have pA : A = B1 + A1 := by
            rw [hA, hB1, hA1]
            exact Nat.choose_succ_succ' n (d + 1)
          have pB : B = B0 + B1 := by
            rw [hB, hB0, hB1]
            exact Nat.choose_succ_succ' n d
          rw [← hA] at htA ⊢
          rw [← hB] at htB ⊢
          have IH' : ∀ t x y : ℕ, t ≤ A1 → t ≤ B1 → x = B1 - t → y = A1 - t →
              wcpaDjMacUp (d + 2) A1 + wcpaDjMacUp (d + 1) x ≤
                wcpaDjMacUp (d + 1) B1 + wcpaDjMacUp (d + 2) y := by
            intro t x y h1 h2 hx hy
            subst hx hy hA1 hB1
            exact ih t h1 h2
          have hfA : wcpaDjMacUp (d + 2) A = Nat.choose (n + 1) (d + 3) + wcpaDjMacUp (d + 1) B1 :=
            shift' n A1 B1 A hA1 hB1.le (by omega)
          have hfA1 : wcpaDjMacUp (d + 2) A1 = Nat.choose (n + 1) (d + 3) + wcpaDjMacUp (d + 1) 0 :=
            shift' n A1 0 A1 hA1 (Nat.zero_le _) (by omega)
          by_cases ht : t ≤ B1
          · have h1 : wcpaDjMacUp (d + 2) (A - t) =
                Nat.choose (n + 1) (d + 3) + wcpaDjMacUp (d + 1) (B1 - t) :=
              shift' n A1 (B1 - t) (A - t) hA1 (by omega) (by omega)
            have h2 := MWg' (n + 1) B (B1 - t) t B1 (B - t) hB (by omega) (by omega) rfl
            omega
          · have hu : t - B1 ≤ B1 := by
              rcases hU n d with h | h <;> omega
            have h1 := IH' (t - B1) (B1 - (t - B1)) (A1 - (t - B1)) (by omega) hu rfl rfl
            have h1' : A - t = A1 - (t - B1) := by omega
            rw [h1']
            have h2 := SAg' (B - t) B1 (B - (t - B1)) (by omega)
            have h3 := MWg' (n + 1) B (B1 - (t - B1)) (t - B1) B1 (B - (t - B1)) hB (by omega)
              (by omega) rfl
            omega
      have TWC' : ∀ n A B t x y : ℕ, A = Nat.choose n (d + 2) → B = Nat.choose n (d + 1) →
          t ≤ A → t ≤ B → x = B - t → y = A - t →
          wcpaDjMacUp (d + 2) A + wcpaDjMacUp (d + 1) x ≤
            wcpaDjMacUp (d + 1) B + wcpaDjMacUp (d + 2) y := by
        intro n A B t x y hA hB h1 h2 hx hy
        subst hx hy hA hB
        exact TWC n t h1 h2

      have MWf : ∀ k s t : ℕ, s + t ≤ Nat.choose k (d + 2) →
          wcpaDjMacUp (d + 2) (s + t) + wcpaDjMacUp (d + 2) (Nat.choose k (d + 2) - t) ≤
            wcpaDjMacUp (d + 2) (Nat.choose k (d + 2)) + wcpaDjMacUp (d + 2) s := by
        intro k
        induction k with
        | zero =>
          intro s t hst
          have h0 : Nat.choose 0 (d + 2) = 0 := Nat.choose_eq_zero_of_lt (by omega)
          rw [h0] at hst ⊢
          have hs : s = 0 := by omega
          have ht : t = 0 := by omega
          subst hs ht
          simp
        | succ k ih =>
          intro s t hst
          obtain ⟨Bp, hBp⟩ : ∃ X, X = Nat.choose k (d + 2) := ⟨_, rfl⟩
          obtain ⟨Bpp, hBpp⟩ : ∃ X, X = Nat.choose k (d + 1) := ⟨_, rfl⟩
          obtain ⟨P, hP⟩ : ∃ X, X = Nat.choose (k + 1) (d + 2) := ⟨_, rfl⟩
          have pP : P = Bpp + Bp := by
            rw [hP, hBpp, hBp]
            exact Nat.choose_succ_succ' k (d + 1)
          rw [← hP] at hst ⊢
          have IH' : ∀ s t x y : ℕ, s + t ≤ Bp → x = s + t → y = Bp - t →
              wcpaDjMacUp (d + 2) x + wcpaDjMacUp (d + 2) y ≤
                wcpaDjMacUp (d + 2) Bp + wcpaDjMacUp (d + 2) s := by
            intro s t x y h hx hy
            subst hx hy hBp
            exact ih s t h
          have hfBp : wcpaDjMacUp (d + 2) Bp = Nat.choose (k + 1) (d + 3) + wcpaDjMacUp (d + 1) 0 :=
            shift' k Bp 0 Bp hBp (Nat.zero_le _) (by omega)
          have hfP : wcpaDjMacUp (d + 2) P = Nat.choose (k + 1) (d + 3) + wcpaDjMacUp (d + 1) Bpp :=
            shift' k Bp Bpp P hBp hBpp.le (by omega)
          rcases Nat.lt_or_ge s Bp with hs | hs
          · rcases Nat.lt_or_ge Bp (s + t) with hst2 | hst2
            ·
              have h1 : wcpaDjMacUp (d + 2) (s + t) =
                  Nat.choose (k + 1) (d + 3) + wcpaDjMacUp (d + 1) (s + t - Bp) :=
                shift' k Bp (s + t - Bp) (s + t) hBp (by omega) (by omega)
              by_cases ht : t ≤ Bpp
              · have h2 : wcpaDjMacUp (d + 2) (P - t) =
                    Nat.choose (k + 1) (d + 3) + wcpaDjMacUp (d + 1) (Bpp - t) :=
                  shift' k Bp (Bpp - t) (P - t) hBp (by omega) (by omega)
                have h3 := TWC' k Bp Bpp (Bp - s) (Bpp - (Bp - s)) s hBp hBpp (by omega) (by omega)
                  rfl (by omega)
                have h4 := SAg' (s + t - Bp) (Bpp - t) (Bpp - (Bp - s)) (by omega)
                omega
              · have h2 : P - t = Bp - (t - Bpp) := by omega
                rw [h2]
                have h3 := IH' s (Bpp - (s + t - Bp)) (Bp - (t - Bpp)) (Bp - (Bpp - (s + t - Bp)))
                  (by omega) (by omega) rfl
                have h4 := TWC' k Bp Bpp (Bpp - (s + t - Bp)) (s + t - Bp)
                  (Bp - (Bpp - (s + t - Bp))) hBp hBpp (by omega) (by omega) (by omega) rfl
                omega
            ·
              have h1 := IH' s t (s + t) (Bp - t) hst2 rfl rfl
              by_cases ht : t ≤ Bpp
              · have h2 : wcpaDjMacUp (d + 2) (P - t) =
                    Nat.choose (k + 1) (d + 3) + wcpaDjMacUp (d + 1) (Bpp - t) :=
                  shift' k Bp (Bpp - t) (P - t) hBp (by omega) (by omega)
                have h3 := TWC' k Bp Bpp t (Bpp - t) (Bp - t) hBp hBpp (by omega) ht rfl rfl
                omega
              · have h2 : P - t = Bp - t + Bpp := by omega
                rw [h2]
                have h3 := IH' (Bp - t) Bpp (Bp - t + Bpp) (Bp - Bpp) (by omega) rfl rfl
                have h4 := TWC' k Bp Bpp Bpp 0 (Bp - Bpp) hBp hBpp (by omega) le_rfl (by omega) rfl
                omega
          ·
            have ht : t ≤ Bpp := by omega
            have h1 : wcpaDjMacUp (d + 2) (s + t) =
                Nat.choose (k + 1) (d + 3) + wcpaDjMacUp (d + 1) (s - Bp + t) :=
              shift' k Bp (s - Bp + t) (s + t) hBp (by omega) (by omega)
            have h2 : wcpaDjMacUp (d + 2) s =
                Nat.choose (k + 1) (d + 3) + wcpaDjMacUp (d + 1) (s - Bp) :=
              shift' k Bp (s - Bp) s hBp (by omega) (by omega)
            have h3 : wcpaDjMacUp (d + 2) (P - t) =
                Nat.choose (k + 1) (d + 3) + wcpaDjMacUp (d + 1) (Bpp - t) :=
              shift' k Bp (Bpp - t) (P - t) hBp (by omega) (by omega)
            have h4 := MWg' k Bpp (s - Bp) t (s - Bp + t) (Bpp - t) hBpp (by omega) rfl rfl
            omega

      have SAf1 : ∀ x y : ℕ, y ≤ x →
          wcpaDjMacUp (d + 2) x + wcpaDjMacUp (d + 2) y ≤ wcpaDjMacUp (d + 2) (x + y) := by
        intro x y hxy
        obtain ⟨k, r, ha, hr⟩ : ∃ k r : ℕ, x + y = Nat.choose k (d + 2) + r ∧
            r < Nat.choose k (d + 1) := hrep (d + 1) (x + y)
        obtain ⟨i, ρ, hx, hρ⟩ : ∃ k r : ℕ, x = Nat.choose k (d + 2) + r ∧
            r < Nat.choose k (d + 1) := hrep (d + 1) x
        have hik : i ≤ k := by
          by_contra hcon
          have h1 : Nat.choose (k + 1) (d + 2) ≤ Nat.choose i (d + 2) :=
            Nat.choose_le_choose (d + 2) (by omega)
          have h2 : Nat.choose (k + 1) (d + 2) = Nat.choose k (d + 1) + Nat.choose k (d + 2) :=
            Nat.choose_succ_succ' k (d + 1)
          omega
        have hfa := shift' k (Nat.choose k (d + 2)) r (x + y) rfl hr.le ha
        rcases Nat.eq_or_lt_of_le hik with h | h
        · subst h
          have hfx := shift' i (Nat.choose i (d + 2)) ρ x rfl hρ.le hx
          have h1 := KLE y
          have h2 := SAg' ρ y r (by omega)
          omega
        · have h1 : Nat.choose (i + 1) (d + 2) ≤ Nat.choose k (d + 2) :=
            Nat.choose_le_choose (d + 2) (by omega)
          have h2 : Nat.choose (i + 1) (d + 2) = Nat.choose i (d + 1) + Nat.choose i (d + 2) :=
            Nat.choose_succ_succ' i (d + 1)
          have h3 := MWf k r (Nat.choose k (d + 2) - x) (by omega)
          rw [show r + (Nat.choose k (d + 2) - x) = y by omega,
            show Nat.choose k (d + 2) - (Nat.choose k (d + 2) - x) = x by omega] at h3
          have h4 := shift' k (Nat.choose k (d + 2)) 0 (Nat.choose k (d + 2)) rfl (Nat.zero_le _)
            (by omega)
          have h5 := KLE r
          omega
      have SAf : ∀ x y : ℕ,
          wcpaDjMacUp (d + 2) x + wcpaDjMacUp (d + 2) y ≤ wcpaDjMacUp (d + 2) (x + y) := by
        intro x y
        rcases le_total y x with h | h
        · exact SAf1 x y h
        · have := SAf1 y x h
          rw [Nat.add_comm y x] at this
          omega
      exact ⟨SAf, MWf⟩
  intro d x y
  rcases d with _ | d
  · simp [wcpaDjMacUp.eq_1]
  · exact (claim d).1 x y

theorem wcpa_mac_window : ∀ d k s t : ℕ, 1 ≤ d → s + t ≤ Nat.choose k d → wcpaDjMacUp d (s + t) + wcpaDjMacUp d (Nat.choose k d - t) ≤ wcpaDjMacUp d (Nat.choose k d) + wcpaDjMacUp d s :=
by
  have hrec : ∀ d k r : ℕ, r < Nat.choose k d → wcpaDjMacUp (d + 1) (Nat.choose k (d + 1) + r) = Nat.choose (k + 1) (d + 2) + wcpaDjMacUp d r ∧ ∀ a : ℕ, ∃ k r : ℕ, a = Nat.choose k (d + 1) + r ∧ r < Nat.choose k d := by
    have s1 : ∀ d j : ℕ, j ≤ Nat.choose j (d + 1) + d := by
      intro d j
      induction j with
      | zero => omega
      | succ j ih =>
        by_cases h : j + 1 ≤ d
        · omega
        · have hp := Nat.choose_succ_succ' j d
          have hpos := Nat.choose_pos (show d ≤ j by omega)
          omega
    have s2 : ∀ d k r : ℕ, r < Nat.choose k d →
        Nat.findGreatest (fun j => Nat.choose j (d + 1) ≤ Nat.choose k (d + 1) + r)
          (Nat.choose k (d + 1) + r + d + 1) = k := by
      intro d k r hr
      rw [Nat.findGreatest_eq_iff]
      refine ⟨?_, ?_, ?_⟩
      · have := s1 d k
        omega
      · intro _
        show Nat.choose k (d + 1) ≤ Nat.choose k (d + 1) + r
        omega
      · intro n' hn' _ hle
        have h1 := Nat.choose_le_choose (d + 1) (show k + 1 ≤ n' by omega)
        have hp := Nat.choose_succ_succ' k d
        have hle' : Nat.choose n' (d + 1) ≤ Nat.choose k (d + 1) + r := hle
        omega
    intro d k r hr
    refine ⟨?_, ?_⟩
    · rw [wcpaDjMacUp.eq_2, s2 d k r hr, Nat.add_sub_cancel_left]
    · intro a
      have ha : Nat.choose (Nat.findGreatest (fun j => Nat.choose j (d + 1) ≤ a) (a + d + 1)) (d + 1)
          ≤ a :=
        Nat.findGreatest_spec (P := fun j => Nat.choose j (d + 1) ≤ a) (Nat.zero_le _)
          (by simp [Nat.choose_zero_succ])
      have hc : a < Nat.choose
          (Nat.findGreatest (fun j => Nat.choose j (d + 1) ≤ a) (a + d + 1) + 1) (d + 1) := by
        by_cases hb : Nat.findGreatest (fun j => Nat.choose j (d + 1) ≤ a) (a + d + 1) + 1
            ≤ a + d + 1
        · have h := Nat.findGreatest_is_greatest (Nat.lt_succ_self _) hb
          exact Nat.lt_of_not_le h
        · have h1 := Nat.findGreatest_le (P := fun j => Nat.choose j (d + 1) ≤ a) (a + d + 1)
          have h2 := s1 d (Nat.findGreatest (fun j => Nat.choose j (d + 1) ≤ a) (a + d + 1) + 1)
          omega
      have hp := Nat.choose_succ_succ'
        (Nat.findGreatest (fun j => Nat.choose j (d + 1) ≤ a) (a + d + 1)) d
      generalize Nat.findGreatest (fun j => Nat.choose j (d + 1) ≤ a) (a + d + 1) = κ at ha hc hp
      exact ⟨κ, a - Nat.choose κ (d + 1), by omega, by omega⟩
  have hM0 : ∀ d, wcpaDjMacUp d 0 = 0 := by
    intro d
    induction d with
    | zero => exact wcpaDjMacUp.eq_1 0
    | succ d ih =>
      have h1 : 0 < Nat.choose d d := by rw [Nat.choose_self]; exact Nat.one_pos
      have h := (hrec d d 0 h1).1
      rw [Nat.choose_eq_zero_of_lt (by omega : d < d + 1),
        Nat.choose_eq_zero_of_lt (by omega : d + 1 < d + 2), ih] at h
      simpa using h
  have hrep : ∀ e a : ℕ, ∃ k r : ℕ, a = Nat.choose k (e + 1) + r ∧ r < Nat.choose k e :=
    fun e a => (hrec e e 0 (by rw [Nat.choose_self]; exact Nat.one_pos)).2 a
  have hval : ∀ e k : ℕ, wcpaDjMacUp (e + 1) (Nat.choose k (e + 1)) = Nat.choose (k + 1) (e + 2) := by
    intro e k
    rcases Nat.eq_zero_or_pos (Nat.choose k e) with h | h
    · have hk : k < e := Nat.choose_eq_zero_iff.mp h
      have h1 : Nat.choose k (e + 1) = 0 := Nat.choose_eq_zero_of_lt (by omega)
      have h2 : Nat.choose (k + 1) (e + 2) = 0 := Nat.choose_eq_zero_of_lt (by omega)
      rw [h1, h2]
      exact hM0 (e + 1)
    · have := (hrec e k 0 h).1
      simp only [add_zero, hM0] at this
      exact this
  have hsh : ∀ d m c : ℕ, c ≤ Nat.choose m (d + 1) →
      wcpaDjMacUp (d + 2) (Nat.choose m (d + 2) + c) =
        Nat.choose (m + 1) (d + 3) + wcpaDjMacUp (d + 1) c := by
    intro d m c hc
    rcases Nat.lt_or_ge c (Nat.choose m (d + 1)) with h | h
    · exact (hrec (d + 1) m c h).1
    · have hc' : c = Nat.choose m (d + 1) := le_antisymm hc h
      subst hc'
      have p1 : Nat.choose (m + 1) (d + 2) = Nat.choose m (d + 1) + Nat.choose m (d + 2) :=
        Nat.choose_succ_succ' m (d + 1)
      have p2 : Nat.choose (m + 2) (d + 3) = Nat.choose (m + 1) (d + 2) + Nat.choose (m + 1) (d + 3) :=
        Nat.choose_succ_succ' (m + 1) (d + 2)
      have v1 : wcpaDjMacUp (d + 2) (Nat.choose (m + 1) (d + 2)) = Nat.choose (m + 2) (d + 3) :=
        hval (d + 1) (m + 1)
      have v2 : wcpaDjMacUp (d + 1) (Nat.choose m (d + 1)) = Nat.choose (m + 1) (d + 2) := hval d m
      rw [show Nat.choose m (d + 2) + Nat.choose m (d + 1) = Nat.choose (m + 1) (d + 2) by omega,
        v1, v2]
      omega
  have hU : ∀ m j : ℕ, Nat.choose m j ≤ Nat.choose m (j + 1) ∨
      Nat.choose m (j + 2) ≤ Nat.choose m (j + 1) := by
    intro m j
    have e1 : Nat.choose m (j + 1) * (j + 1) = Nat.choose m j * (m - j) := Nat.choose_succ_right_eq m j
    have e2 : Nat.choose m (j + 2) * (j + 2) = Nat.choose m (j + 1) * (m - (j + 1)) :=
      Nat.choose_succ_right_eq m (j + 1)
    by_cases h : j + 1 ≤ m - j
    · left
      have : Nat.choose m j * (j + 1) ≤ Nat.choose m (j + 1) * (j + 1) := by
        calc Nat.choose m j * (j + 1) ≤ Nat.choose m j * (m - j) := Nat.mul_le_mul_left _ h
          _ = Nat.choose m (j + 1) * (j + 1) := e1.symm
      exact Nat.le_of_mul_le_mul_right this (by omega)
    · right
      have : Nat.choose m (j + 2) * (j + 2) ≤ Nat.choose m (j + 1) * (j + 2) := by
        calc Nat.choose m (j + 2) * (j + 2) = Nat.choose m (j + 1) * (m - (j + 1)) := e2
          _ ≤ Nat.choose m (j + 1) * (j + 2) := Nat.mul_le_mul_left _ (by omega)
      exact Nat.le_of_mul_le_mul_right this (by omega)
  have hT : ∀ n : ℕ, 2 * Nat.choose (n + 1) 2 = n * (n + 1) := by
    intro n
    induction n with
    | zero => rfl
    | succ n ih =>
      have p : Nat.choose (n + 1 + 1) 2 = Nat.choose (n + 1) 1 + Nat.choose (n + 1) 2 :=
        Nat.choose_succ_succ' (n + 1) 1
      rw [p, Nat.choose_one_right]
      nlinarith [ih]
  have hM1 : ∀ a, wcpaDjMacUp 1 a = Nat.choose (a + 1) 2 := by
    intro a
    have h := (hrec 0 a 0 (by simp)).1
    simp only [zero_add, add_zero, Nat.choose_one_right, hM0] at h
    exact h
  have SA1 : ∀ x y : ℕ, wcpaDjMacUp 1 x + wcpaDjMacUp 1 y ≤ wcpaDjMacUp 1 (x + y) := by
    intro x y
    simp only [hM1]
    have h1 := hT x
    have h2 := hT y
    have h3 := hT (x + y)
    nlinarith [Nat.zero_le (x * y)]
  have MW1 : ∀ k s t : ℕ, s + t ≤ Nat.choose k 1 → wcpaDjMacUp 1 (s + t) +
      wcpaDjMacUp 1 (Nat.choose k 1 - t) ≤ wcpaDjMacUp 1 (Nat.choose k 1) + wcpaDjMacUp 1 s := by
    intro k s t hst
    rw [Nat.choose_one_right] at hst ⊢
    obtain ⟨w, rfl⟩ : ∃ w, k = s + t + w := ⟨k - s - t, by omega⟩
    rw [show s + t + w - t = s + w by omega]
    simp only [hM1]
    have h1 := hT (s + t)
    have h2 := hT (s + w)
    have h3 := hT (s + t + w)
    have h4 := hT s
    nlinarith [Nat.zero_le (t * w)]
  have claim : ∀ d : ℕ, (∀ x y : ℕ, wcpaDjMacUp (d + 1) x + wcpaDjMacUp (d + 1) y ≤
      wcpaDjMacUp (d + 1) (x + y)) ∧ (∀ k s t : ℕ, s + t ≤ Nat.choose k (d + 1) →
      wcpaDjMacUp (d + 1) (s + t) + wcpaDjMacUp (d + 1) (Nat.choose k (d + 1) - t) ≤
        wcpaDjMacUp (d + 1) (Nat.choose k (d + 1)) + wcpaDjMacUp (d + 1) s) := by
    intro d
    induction d with
    | zero => exact ⟨SA1, MW1⟩
    | succ d ih =>
      obtain ⟨SAg, MWg⟩ := ih
      have hg0 : wcpaDjMacUp (d + 1) 0 = 0 := hM0 (d + 1)
      have SAg' : ∀ x y z : ℕ, z = x + y →
          wcpaDjMacUp (d + 1) x + wcpaDjMacUp (d + 1) y ≤ wcpaDjMacUp (d + 1) z := by
        intro x y z h
        subst h
        exact SAg x y
      have MWg' : ∀ k B s t x y : ℕ, B = Nat.choose k (d + 1) → s + t ≤ B → x = s + t →
          y = B - t →
          wcpaDjMacUp (d + 1) x + wcpaDjMacUp (d + 1) y ≤
            wcpaDjMacUp (d + 1) B + wcpaDjMacUp (d + 1) s := by
        intro k B s t x y hB hst hx hy
        subst hx hy hB
        exact MWg k s t hst
      have shift' : ∀ m A c x : ℕ, A = Nat.choose m (d + 2) → c ≤ Nat.choose m (d + 1) →
          x = A + c → wcpaDjMacUp (d + 2) x = Nat.choose (m + 1) (d + 3) + wcpaDjMacUp (d + 1) c := by
        intro m A c x hA hc hx
        subst hx hA
        exact hsh d m c hc

      have binpt : ∀ k : ℕ, Nat.choose (k + 1) (d + 3) ≤ wcpaDjMacUp (d + 1) (Nat.choose k (d + 2)) := by
        intro k
        induction k with
        | zero =>
          have : Nat.choose (0 + 1) (d + 3) = 0 := Nat.choose_eq_zero_of_lt (by omega)
          omega
        | succ k ih =>
          have p1 : Nat.choose (k + 1) (d + 2) = Nat.choose k (d + 1) + Nat.choose k (d + 2) :=
            Nat.choose_succ_succ' k (d + 1)
          have p2 : Nat.choose (k + 1 + 1) (d + 3) =
              Nat.choose (k + 1) (d + 2) + Nat.choose (k + 1) (d + 3) :=
            Nat.choose_succ_succ' (k + 1) (d + 2)
          have h1 := SAg' (Nat.choose k (d + 1)) (Nat.choose k (d + 2)) (Nat.choose (k + 1) (d + 2)) p1
          have h2 : wcpaDjMacUp (d + 1) (Nat.choose k (d + 1)) = Nat.choose (k + 1) (d + 2) := hval d k
          omega
      have KLE : ∀ a : ℕ, wcpaDjMacUp (d + 2) a ≤ wcpaDjMacUp (d + 1) a := by
        intro a
        obtain ⟨k, r, ha, hr⟩ : ∃ k r : ℕ, a = Nat.choose k (d + 2) + r ∧ r < Nat.choose k (d + 1) :=
          hrep (d + 1) a
        have h1 := shift' k _ r a rfl hr.le ha
        have h2 := SAg' (Nat.choose k (d + 2)) r a ha
        have h3 := binpt k
        omega

      have TWC : ∀ n t : ℕ, t ≤ Nat.choose n (d + 2) → t ≤ Nat.choose n (d + 1) →
          wcpaDjMacUp (d + 2) (Nat.choose n (d + 2)) + wcpaDjMacUp (d + 1) (Nat.choose n (d + 1) - t) ≤
            wcpaDjMacUp (d + 1) (Nat.choose n (d + 1)) +
              wcpaDjMacUp (d + 2) (Nat.choose n (d + 2) - t) := by
        intro n
        induction n with
        | zero =>
          intro t h1 h2
          have h0 : Nat.choose 0 (d + 2) = 0 := Nat.choose_eq_zero_of_lt (by omega)
          have ht : t = 0 := by omega
          subst ht
          simp only [Nat.sub_zero]
          omega
        | succ n ih =>
          intro t htA htB
          obtain ⟨A1, hA1⟩ : ∃ X, X = Nat.choose n (d + 2) := ⟨_, rfl⟩
          obtain ⟨B1, hB1⟩ : ∃ X, X = Nat.choose n (d + 1) := ⟨_, rfl⟩
          obtain ⟨B0, hB0⟩ : ∃ X, X = Nat.choose n d := ⟨_, rfl⟩
          obtain ⟨A, hA⟩ : ∃ X, X = Nat.choose (n + 1) (d + 2) := ⟨_, rfl⟩
          obtain ⟨B, hB⟩ : ∃ X, X = Nat.choose (n + 1) (d + 1) := ⟨_, rfl⟩
          have pA : A = B1 + A1 := by
            rw [hA, hB1, hA1]
            exact Nat.choose_succ_succ' n (d + 1)
          have pB : B = B0 + B1 := by
            rw [hB, hB0, hB1]
            exact Nat.choose_succ_succ' n d
          rw [← hA] at htA ⊢
          rw [← hB] at htB ⊢
          have IH' : ∀ t x y : ℕ, t ≤ A1 → t ≤ B1 → x = B1 - t → y = A1 - t →
              wcpaDjMacUp (d + 2) A1 + wcpaDjMacUp (d + 1) x ≤
                wcpaDjMacUp (d + 1) B1 + wcpaDjMacUp (d + 2) y := by
            intro t x y h1 h2 hx hy
            subst hx hy hA1 hB1
            exact ih t h1 h2
          have hfA : wcpaDjMacUp (d + 2) A = Nat.choose (n + 1) (d + 3) + wcpaDjMacUp (d + 1) B1 :=
            shift' n A1 B1 A hA1 hB1.le (by omega)
          have hfA1 : wcpaDjMacUp (d + 2) A1 = Nat.choose (n + 1) (d + 3) + wcpaDjMacUp (d + 1) 0 :=
            shift' n A1 0 A1 hA1 (Nat.zero_le _) (by omega)
          by_cases ht : t ≤ B1
          · have h1 : wcpaDjMacUp (d + 2) (A - t) =
                Nat.choose (n + 1) (d + 3) + wcpaDjMacUp (d + 1) (B1 - t) :=
              shift' n A1 (B1 - t) (A - t) hA1 (by omega) (by omega)
            have h2 := MWg' (n + 1) B (B1 - t) t B1 (B - t) hB (by omega) (by omega) rfl
            omega
          · have hu : t - B1 ≤ B1 := by
              rcases hU n d with h | h <;> omega
            have h1 := IH' (t - B1) (B1 - (t - B1)) (A1 - (t - B1)) (by omega) hu rfl rfl
            have h1' : A - t = A1 - (t - B1) := by omega
            rw [h1']
            have h2 := SAg' (B - t) B1 (B - (t - B1)) (by omega)
            have h3 := MWg' (n + 1) B (B1 - (t - B1)) (t - B1) B1 (B - (t - B1)) hB (by omega)
              (by omega) rfl
            omega
      have TWC' : ∀ n A B t x y : ℕ, A = Nat.choose n (d + 2) → B = Nat.choose n (d + 1) →
          t ≤ A → t ≤ B → x = B - t → y = A - t →
          wcpaDjMacUp (d + 2) A + wcpaDjMacUp (d + 1) x ≤
            wcpaDjMacUp (d + 1) B + wcpaDjMacUp (d + 2) y := by
        intro n A B t x y hA hB h1 h2 hx hy
        subst hx hy hA hB
        exact TWC n t h1 h2

      have MWf : ∀ k s t : ℕ, s + t ≤ Nat.choose k (d + 2) →
          wcpaDjMacUp (d + 2) (s + t) + wcpaDjMacUp (d + 2) (Nat.choose k (d + 2) - t) ≤
            wcpaDjMacUp (d + 2) (Nat.choose k (d + 2)) + wcpaDjMacUp (d + 2) s := by
        intro k
        induction k with
        | zero =>
          intro s t hst
          have h0 : Nat.choose 0 (d + 2) = 0 := Nat.choose_eq_zero_of_lt (by omega)
          rw [h0] at hst ⊢
          have hs : s = 0 := by omega
          have ht : t = 0 := by omega
          subst hs ht
          simp
        | succ k ih =>
          intro s t hst
          obtain ⟨Bp, hBp⟩ : ∃ X, X = Nat.choose k (d + 2) := ⟨_, rfl⟩
          obtain ⟨Bpp, hBpp⟩ : ∃ X, X = Nat.choose k (d + 1) := ⟨_, rfl⟩
          obtain ⟨P, hP⟩ : ∃ X, X = Nat.choose (k + 1) (d + 2) := ⟨_, rfl⟩
          have pP : P = Bpp + Bp := by
            rw [hP, hBpp, hBp]
            exact Nat.choose_succ_succ' k (d + 1)
          rw [← hP] at hst ⊢
          have IH' : ∀ s t x y : ℕ, s + t ≤ Bp → x = s + t → y = Bp - t →
              wcpaDjMacUp (d + 2) x + wcpaDjMacUp (d + 2) y ≤
                wcpaDjMacUp (d + 2) Bp + wcpaDjMacUp (d + 2) s := by
            intro s t x y h hx hy
            subst hx hy hBp
            exact ih s t h
          have hfBp : wcpaDjMacUp (d + 2) Bp = Nat.choose (k + 1) (d + 3) + wcpaDjMacUp (d + 1) 0 :=
            shift' k Bp 0 Bp hBp (Nat.zero_le _) (by omega)
          have hfP : wcpaDjMacUp (d + 2) P = Nat.choose (k + 1) (d + 3) + wcpaDjMacUp (d + 1) Bpp :=
            shift' k Bp Bpp P hBp hBpp.le (by omega)
          rcases Nat.lt_or_ge s Bp with hs | hs
          · rcases Nat.lt_or_ge Bp (s + t) with hst2 | hst2
            ·
              have h1 : wcpaDjMacUp (d + 2) (s + t) =
                  Nat.choose (k + 1) (d + 3) + wcpaDjMacUp (d + 1) (s + t - Bp) :=
                shift' k Bp (s + t - Bp) (s + t) hBp (by omega) (by omega)
              by_cases ht : t ≤ Bpp
              · have h2 : wcpaDjMacUp (d + 2) (P - t) =
                    Nat.choose (k + 1) (d + 3) + wcpaDjMacUp (d + 1) (Bpp - t) :=
                  shift' k Bp (Bpp - t) (P - t) hBp (by omega) (by omega)
                have h3 := TWC' k Bp Bpp (Bp - s) (Bpp - (Bp - s)) s hBp hBpp (by omega) (by omega)
                  rfl (by omega)
                have h4 := SAg' (s + t - Bp) (Bpp - t) (Bpp - (Bp - s)) (by omega)
                omega
              · have h2 : P - t = Bp - (t - Bpp) := by omega
                rw [h2]
                have h3 := IH' s (Bpp - (s + t - Bp)) (Bp - (t - Bpp)) (Bp - (Bpp - (s + t - Bp)))
                  (by omega) (by omega) rfl
                have h4 := TWC' k Bp Bpp (Bpp - (s + t - Bp)) (s + t - Bp)
                  (Bp - (Bpp - (s + t - Bp))) hBp hBpp (by omega) (by omega) (by omega) rfl
                omega
            ·
              have h1 := IH' s t (s + t) (Bp - t) hst2 rfl rfl
              by_cases ht : t ≤ Bpp
              · have h2 : wcpaDjMacUp (d + 2) (P - t) =
                    Nat.choose (k + 1) (d + 3) + wcpaDjMacUp (d + 1) (Bpp - t) :=
                  shift' k Bp (Bpp - t) (P - t) hBp (by omega) (by omega)
                have h3 := TWC' k Bp Bpp t (Bpp - t) (Bp - t) hBp hBpp (by omega) ht rfl rfl
                omega
              · have h2 : P - t = Bp - t + Bpp := by omega
                rw [h2]
                have h3 := IH' (Bp - t) Bpp (Bp - t + Bpp) (Bp - Bpp) (by omega) rfl rfl
                have h4 := TWC' k Bp Bpp Bpp 0 (Bp - Bpp) hBp hBpp (by omega) le_rfl (by omega) rfl
                omega
          ·
            have ht : t ≤ Bpp := by omega
            have h1 : wcpaDjMacUp (d + 2) (s + t) =
                Nat.choose (k + 1) (d + 3) + wcpaDjMacUp (d + 1) (s - Bp + t) :=
              shift' k Bp (s - Bp + t) (s + t) hBp (by omega) (by omega)
            have h2 : wcpaDjMacUp (d + 2) s =
                Nat.choose (k + 1) (d + 3) + wcpaDjMacUp (d + 1) (s - Bp) :=
              shift' k Bp (s - Bp) s hBp (by omega) (by omega)
            have h3 : wcpaDjMacUp (d + 2) (P - t) =
                Nat.choose (k + 1) (d + 3) + wcpaDjMacUp (d + 1) (Bpp - t) :=
              shift' k Bp (Bpp - t) (P - t) hBp (by omega) (by omega)
            have h4 := MWg' k Bpp (s - Bp) t (s - Bp + t) (Bpp - t) hBpp (by omega) rfl rfl
            omega

      have SAf1 : ∀ x y : ℕ, y ≤ x →
          wcpaDjMacUp (d + 2) x + wcpaDjMacUp (d + 2) y ≤ wcpaDjMacUp (d + 2) (x + y) := by
        intro x y hxy
        obtain ⟨k, r, ha, hr⟩ : ∃ k r : ℕ, x + y = Nat.choose k (d + 2) + r ∧
            r < Nat.choose k (d + 1) := hrep (d + 1) (x + y)
        obtain ⟨i, ρ, hx, hρ⟩ : ∃ k r : ℕ, x = Nat.choose k (d + 2) + r ∧
            r < Nat.choose k (d + 1) := hrep (d + 1) x
        have hik : i ≤ k := by
          by_contra hcon
          have h1 : Nat.choose (k + 1) (d + 2) ≤ Nat.choose i (d + 2) :=
            Nat.choose_le_choose (d + 2) (by omega)
          have h2 : Nat.choose (k + 1) (d + 2) = Nat.choose k (d + 1) + Nat.choose k (d + 2) :=
            Nat.choose_succ_succ' k (d + 1)
          omega
        have hfa := shift' k (Nat.choose k (d + 2)) r (x + y) rfl hr.le ha
        rcases Nat.eq_or_lt_of_le hik with h | h
        · subst h
          have hfx := shift' i (Nat.choose i (d + 2)) ρ x rfl hρ.le hx
          have h1 := KLE y
          have h2 := SAg' ρ y r (by omega)
          omega
        · have h1 : Nat.choose (i + 1) (d + 2) ≤ Nat.choose k (d + 2) :=
            Nat.choose_le_choose (d + 2) (by omega)
          have h2 : Nat.choose (i + 1) (d + 2) = Nat.choose i (d + 1) + Nat.choose i (d + 2) :=
            Nat.choose_succ_succ' i (d + 1)
          have h3 := MWf k r (Nat.choose k (d + 2) - x) (by omega)
          rw [show r + (Nat.choose k (d + 2) - x) = y by omega,
            show Nat.choose k (d + 2) - (Nat.choose k (d + 2) - x) = x by omega] at h3
          have h4 := shift' k (Nat.choose k (d + 2)) 0 (Nat.choose k (d + 2)) rfl (Nat.zero_le _)
            (by omega)
          have h5 := KLE r
          omega
      have SAf : ∀ x y : ℕ,
          wcpaDjMacUp (d + 2) x + wcpaDjMacUp (d + 2) y ≤ wcpaDjMacUp (d + 2) (x + y) := by
        intro x y
        rcases le_total y x with h | h
        · exact SAf1 x y h
        · have := SAf1 y x h
          rw [Nat.add_comm y x] at this
          omega
      exact ⟨SAf, MWf⟩
  intro d k s t hd hst
  obtain ⟨d', rfl⟩ : ∃ d', d = d' + 1 := ⟨d - 1, by omega⟩
  exact (claim d').2 k s t hst

theorem wcpa_mac_top : ∀ d k t r : ℕ, 1 ≤ d → 1 ≤ t → t ≤ Nat.choose k (d + 1) → r < Nat.choose k d → min (Nat.choose k (d + 1) + r) (wcpaDjMacUp d (r + t)) + wcpaDjMacUp (d + 1) (Nat.choose k (d + 1) - t) ≤ wcpaDjMacUp (d + 1) (Nat.choose k (d + 1)) + wcpaDjMacUp d r :=
by
  classical

  have hM0 : ∀ d, wcpaDjMacUp d 0 = 0 := by
    intro d
    induction d with
    | zero => exact wcpaDjMacUp.eq_1 0
    | succ d ih =>
      have h1 : 0 < Nat.choose d d := by rw [Nat.choose_self]; exact Nat.one_pos
      have h := (wcpa_mac_rec d d 0 h1).1
      rw [Nat.choose_eq_zero_of_lt (by omega : d < d + 1),
        Nat.choose_eq_zero_of_lt (by omega : d + 1 < d + 2), ih] at h
      simpa using h

  have hM1 : ∀ a, wcpaDjMacUp 1 a = Nat.choose (a + 1) 2 := by
    intro a
    have h := (wcpa_mac_rec 0 a 0 (by simp)).1
    simp only [zero_add, add_zero, Nat.choose_one_right, hM0] at h
    exact h
  have hrepr : ∀ d a : ℕ, ∃ k r : ℕ, a = Nat.choose k (d + 1) + r ∧ r < Nat.choose k d := by
    intro d a
    exact (wcpa_mac_rec d d 0 (by rw [Nat.choose_self]; exact Nat.one_pos)).2 a

  have hmono : ∀ e a b : ℕ, a ≤ b → wcpaDjMacUp e a ≤ wcpaDjMacUp e b := by
    intro e a b hab
    have h := wcpa_mac_superadd e a (b - a)
    rw [Nat.add_sub_cancel' hab] at h
    omega

  have hV : ∀ d m : ℕ, 1 ≤ d → d ≤ m →
      wcpaDjMacUp d (Nat.choose m d) = Nat.choose (m + 1) (d + 1) := by
    intro d m hd hdm
    obtain ⟨d0, rfl⟩ : ∃ d0, d = d0 + 1 := ⟨d - 1, by omega⟩
    have h := (wcpa_mac_rec d0 m 0 (Nat.choose_pos (by omega))).1
    simp only [add_zero, hM0] at h
    exact h

  have hfP : ∀ d m : ℕ, d ≤ m → wcpaDjMacUp (d + 1) (Nat.choose (m + 1) (d + 1)) =
      Nat.choose (m + 1) (d + 1) + Nat.choose (m + 1) (d + 2) := by
    intro d m hdm
    have h := (wcpa_mac_rec d (m + 1) 0 (Nat.choose_pos (by omega))).1
    simp only [add_zero, hM0] at h
    rw [h]
    exact Nat.choose_succ_succ (m + 1) (d + 1)

  have hfP' : ∀ d m : ℕ, d ≤ m →
      wcpaDjMacUp (d + 1) (Nat.choose m (d + 1)) = Nat.choose (m + 1) (d + 2) := by
    intro d m hdm
    have h := (wcpa_mac_rec d m 0 (Nat.choose_pos hdm)).1
    simp only [add_zero, hM0] at h
    exact h

  have hge : ∀ d, 1 ≤ d → ∀ a, a ≤ wcpaDjMacUp d a := by
    intro d hd
    induction d, hd using Nat.le_induction with
    | base =>
      intro a
      have h1 : Nat.choose (a + 1) 2 = Nat.choose a 1 + Nat.choose a 2 :=
        Nat.choose_succ_succ a 1
      rw [hM1, h1, Nat.choose_one_right]
      omega
    | succ d hd ih =>
      intro a
      obtain ⟨k, r, ha, hr⟩ := hrepr d a
      rw [ha, (wcpa_mac_rec d k r hr).1]
      have h1 := ih r
      have h2 : Nat.choose (k + 1) (d + 2) = Nat.choose k (d + 1) + Nat.choose k (d + 2) :=
        Nat.choose_succ_succ k (d + 1)
      omega

  have hfar : ∀ d m t r : ℕ, 1 ≤ d → Nat.choose m d < t → t ≤ Nat.choose (m + 1) (d + 1) →
      min (Nat.choose (m + 1) (d + 1) + r) (wcpaDjMacUp d (r + t)) +
        wcpaDjMacUp (d + 1) (Nat.choose (m + 1) (d + 1) - t) ≤
      wcpaDjMacUp (d + 1) (Nat.choose (m + 1) (d + 1)) + wcpaDjMacUp d r := by
    intro d m t r hd hlt htP
    have hdm : d ≤ m := by
      by_contra hc
      have : Nat.choose (m + 1) (d + 1) = 0 := Nat.choose_eq_zero_of_lt (by omega)
      omega
    have hP : Nat.choose (m + 1) (d + 1) = Nat.choose m d + Nat.choose m (d + 1) :=
      Nat.choose_succ_succ m d
    have e1 := hfP d m hdm
    have e2 := hfP' d m hdm
    have hmo := hmono (d + 1) (Nat.choose (m + 1) (d + 1) - t) (Nat.choose m (d + 1)) (by omega)
    have hg := hge d hd r
    have hmin := min_le_left (Nat.choose (m + 1) (d + 1) + r) (wcpaDjMacUp d (r + t))
    omega

  have hlow : ∀ d m t r : ℕ, 1 ≤ d → 1 ≤ t → r + t ≤ Nat.choose m d →
      min (Nat.choose (m + 1) (d + 1) + r) (wcpaDjMacUp d (r + t)) +
        wcpaDjMacUp (d + 1) (Nat.choose (m + 1) (d + 1) - t) ≤
      wcpaDjMacUp (d + 1) (Nat.choose (m + 1) (d + 1)) + wcpaDjMacUp d r := by
    intro d m t r hd ht hrt
    have hdm : d ≤ m := by
      by_contra hc
      have : Nat.choose m d = 0 := Nat.choose_eq_zero_of_lt (by omega)
      omega
    have hP : Nat.choose (m + 1) (d + 1) = Nat.choose m d + Nat.choose m (d + 1) :=
      Nat.choose_succ_succ m d
    have hu : Nat.choose m d - t < Nat.choose m d := by omega
    have e1 := (wcpa_mac_rec d m (Nat.choose m d - t) hu).1
    have e0 : Nat.choose (m + 1) (d + 1) - t = Nat.choose m (d + 1) + (Nat.choose m d - t) := by
      omega
    rw [e0, e1]
    have e2 := hfP d m hdm
    have e3 := hV d m hd hdm
    have hw := wcpa_mac_window d m r t hd hrt
    have hmin := min_le_right (Nat.choose (m + 1) (d + 1) + r) (wcpaDjMacUp d (r + t))
    omega

  have X : ∀ d, 1 ≤ d → ∀ k t r : ℕ, 1 ≤ t → t ≤ Nat.choose k (d + 1) → r < Nat.choose k d →
      min (Nat.choose k (d + 1) + r) (wcpaDjMacUp d (r + t)) +
        wcpaDjMacUp (d + 1) (Nat.choose k (d + 1) - t) ≤
      wcpaDjMacUp (d + 1) (Nat.choose k (d + 1)) + wcpaDjMacUp d r := by
    intro d hd
    induction d, hd using Nat.le_induction with
    | base =>
      intro k t r ht htP hr
      obtain ⟨m, rfl⟩ : ∃ m, k = m + 1 := by
        rcases k with _ | m
        · have : Nat.choose 0 (1 + 1) = 0 := Nat.choose_eq_zero_of_lt (by omega)
          omega
        · exact ⟨m, rfl⟩
      rcases Nat.lt_or_ge (Nat.choose m 1) t with h1 | h1
      · exact hfar 1 m t r le_rfl h1 htP
      rcases le_or_gt (r + t) (Nat.choose m 1) with h2 | h2
      · exact hlow 1 m t r le_rfl ht h2
      rw [Nat.choose_one_right] at h1 h2
      have hu : m - t < Nat.choose m 1 := by rw [Nat.choose_one_right]; omega
      have e1 := (wcpa_mac_rec 1 m (m - t) hu).1
      have hP : Nat.choose (m + 1) (1 + 1) = Nat.choose m 1 + Nat.choose m (1 + 1) :=
        Nat.choose_succ_succ m 1
      rw [Nat.choose_one_right] at hP
      have e0 : Nat.choose (m + 1) (1 + 1) - t = Nat.choose m (1 + 1) + (m - t) := by omega
      rw [e0, e1]
      have e2 := hfP 1 m (by omega)
      have e3 := hM1 (m - t)
      have e4 := hM1 r
      have e5 : Nat.choose (r + 1) 2 = Nat.choose r 1 + Nat.choose r 2 :=
        Nat.choose_succ_succ r 1
      rw [Nat.choose_one_right] at e5
      have e6 : Nat.choose (m - t + 1) 2 ≤ Nat.choose r 2 := Nat.choose_le_choose 2 (by omega)
      have hmin := min_le_left (Nat.choose (m + 1) (1 + 1) + r) (wcpaDjMacUp 1 (r + t))
      omega
    | succ d hd IH =>

      have hG : ∀ x y : ℕ, wcpaDjMacUp (d + 1) x + min (wcpaDjMacUp d y) (x + y) ≤
          wcpaDjMacUp (d + 1) (x + y) := by
        intro x y
        obtain ⟨k, r, ha, hr⟩ := hrepr d (x + y)
        obtain ⟨i, ρ, hx, hρ⟩ := hrepr d x
        have hpk : Nat.choose (k + 1) (d + 1) = Nat.choose k d + Nat.choose k (d + 1) :=
          Nat.choose_succ_succ k d
        have hpi : Nat.choose (i + 1) (d + 1) = Nat.choose i d + Nat.choose i (d + 1) :=
          Nat.choose_succ_succ i d
        have hik : i ≤ k := by
          by_contra hcon
          have : Nat.choose (k + 1) (d + 1) ≤ Nat.choose i (d + 1) :=
            Nat.choose_le_choose (d + 1) (by omega)
          omega
        rcases Nat.eq_or_lt_of_le hik with hik | hik
        · rw [hik] at hx hρ
          have hry : r = ρ + y := by omega
          have e1 := (wcpa_mac_rec d k ρ hρ).1
          have e2 := (wcpa_mac_rec d k r hr).1
          rw [← hx] at e1
          rw [← ha] at e2
          have hs := wcpa_mac_superadd d ρ y
          rw [← hry] at hs
          have hm := min_le_left (wcpaDjMacUp d y) (x + y)
          omega
        · have hle : Nat.choose (i + 1) (d + 1) ≤ Nat.choose k (d + 1) :=
            Nat.choose_le_choose (d + 1) (by omega)
          have hxP : x < Nat.choose k (d + 1) := by omega
          have htop := IH k (Nat.choose k (d + 1) - x) r (by omega) (by omega) hr
          have e0 : Nat.choose k (d + 1) - (Nat.choose k (d + 1) - x) = x := by omega
          have e3 : r + (Nat.choose k (d + 1) - x) = y := by omega
          have e4 : Nat.choose k (d + 1) + r = x + y := by omega
          rw [e0, e3, e4] at htop
          have e1 := (wcpa_mac_rec d k 0 (by omega)).1
          simp only [add_zero, hM0] at e1
          have e2 := (wcpa_mac_rec d k r hr).1
          rw [← ha] at e2
          rw [min_comm] at htop
          omega
      intro k t r ht htP hr
      obtain ⟨m, rfl⟩ : ∃ m, k = m + 1 := by
        rcases k with _ | m
        · have : Nat.choose 0 (d + 1 + 1) = 0 := Nat.choose_eq_zero_of_lt (by omega)
          omega
        · exact ⟨m, rfl⟩
      rcases Nat.lt_or_ge (Nat.choose m (d + 1)) t with h1 | h1
      · exact hfar (d + 1) m t r (by omega) h1 htP
      rcases le_or_gt (r + t) (Nat.choose m (d + 1)) with h2 | h2
      · exact hlow (d + 1) m t r (by omega) ht h2

      have hdm : d + 1 ≤ m := by
        by_contra hc
        have : Nat.choose m (d + 1) = 0 := Nat.choose_eq_zero_of_lt (by omega)
        omega
      obtain ⟨u, hu⟩ : ∃ u, u = Nat.choose m (d + 1) - t := ⟨_, rfl⟩
      obtain ⟨c, hc⟩ : ∃ c, c = r + t - Nat.choose m (d + 1) := ⟨_, rfl⟩
      have hur : u + c = r := by omega
      have hu' : u < Nat.choose m (d + 1) := by omega
      have e1 := (wcpa_mac_rec (d + 1) m u hu').1
      have hP : Nat.choose (m + 1) (d + 1 + 1) =
          Nat.choose m (d + 1) + Nat.choose m (d + 1 + 1) := Nat.choose_succ_succ m (d + 1)
      have e0 : Nat.choose (m + 1) (d + 1 + 1) - t = Nat.choose m (d + 1 + 1) + u := by omega
      rw [e0, e1]
      have e2 := hfP (d + 1) m hdm
      have hGuc := hG u c
      rw [hur] at hGuc
      have hmin1 := min_le_left (Nat.choose (m + 1) (d + 1 + 1) + r) (wcpaDjMacUp (d + 1) (r + t))
      have hmin2 := min_le_right (Nat.choose (m + 1) (d + 1 + 1) + r) (wcpaDjMacUp (d + 1) (r + t))
      by_cases hcK : c < Nat.choose m d
      · have e3 := (wcpa_mac_rec d m c hcK).1
        have e4 : r + t = Nat.choose m (d + 1) + c := by omega
        have e6 : wcpaDjMacUp (d + 1) (r + t) = Nat.choose (m + 1) (d + 2) + wcpaDjMacUp d c := by
          rw [e4]; exact e3
        have e5 : Nat.choose (m + 1) (d + 2) = Nat.choose (m + 1) (d + 1 + 1) := rfl
        rcases Nat.le_total (wcpaDjMacUp d c) r with h3 | h3
        · rw [min_eq_left h3] at hGuc
          omega
        · rw [min_eq_right h3] at hGuc
          omega
      · have e3 := hmono d (Nat.choose m d) c (by omega)
        have e4 := hV d m hd (by omega)
        have h3 : r ≤ wcpaDjMacUp d c := by omega
        rw [min_eq_right h3] at hGuc
        omega
  intro d k t r hd ht htP hr
  exact X d hd k t r ht htP hr

theorem wcpa_dj_flrg_macaulay_comb : ∀ (N e : ℕ) (U T : Finset (Fin (N + 1) →₀ ℕ)), 1 ≤ e → (∀ u ∈ U, u.degree = e) → (∀ v ∈ T, v.degree = e + 1 ∧ ∀ l, v l ≠ 0 → v - Finsupp.single l 1 ∈ U) → T.card ≤ wcpaDjMacUp e U.card :=
by
  classical

  have hM0 : ∀ d, wcpaDjMacUp d 0 = 0 := by
    intro d
    induction d with
    | zero => exact wcpaDjMacUp.eq_1 0
    | succ d ih =>
      have h1 : 0 < Nat.choose d d := by rw [Nat.choose_self]; exact Nat.one_pos
      have h := (wcpa_mac_rec d d 0 h1).1
      rw [Nat.choose_eq_zero_of_lt (by omega : d < d + 1),
        Nat.choose_eq_zero_of_lt (by omega : d + 1 < d + 2), ih] at h
      simpa using h
  have hM1 : ∀ a, wcpaDjMacUp 1 a = Nat.choose (a + 1) 2 := by
    intro a
    have h := (wcpa_mac_rec 0 a 0 (by simp)).1
    simp only [zero_add, add_zero, Nat.choose_one_right, hM0] at h
    exact h
  have hrepr : ∀ d a : ℕ, ∃ k r : ℕ, a = Nat.choose k (d + 1) + r ∧ r < Nat.choose k d := by
    intro d a
    exact (wcpa_mac_rec d d 0 (by rw [Nat.choose_self]; exact Nat.one_pos)).2 a

  have hG : ∀ d x y : ℕ, 1 ≤ d → wcpaDjMacUp (d + 1) x + min (wcpaDjMacUp d y) (x + y) ≤
      wcpaDjMacUp (d + 1) (x + y) := by
    intro d x y hd
    obtain ⟨k, r, ha, hr⟩ := hrepr d (x + y)
    obtain ⟨i, ρ, hx, hρ⟩ := hrepr d x
    have hpk : Nat.choose (k + 1) (d + 1) = Nat.choose k d + Nat.choose k (d + 1) :=
      Nat.choose_succ_succ k d
    have hpi : Nat.choose (i + 1) (d + 1) = Nat.choose i d + Nat.choose i (d + 1) :=
      Nat.choose_succ_succ i d
    have hik : i ≤ k := by
      by_contra hcon
      have : Nat.choose (k + 1) (d + 1) ≤ Nat.choose i (d + 1) :=
        Nat.choose_le_choose (d + 1) (by omega)
      omega
    rcases Nat.eq_or_lt_of_le hik with hik | hik
    · rw [hik] at hx hρ
      have hry : r = ρ + y := by omega
      have e1 := (wcpa_mac_rec d k ρ hρ).1
      have e2 := (wcpa_mac_rec d k r hr).1
      rw [← hx] at e1
      rw [← ha] at e2
      have hs := wcpa_mac_superadd d ρ y
      rw [← hry] at hs
      have hm := min_le_left (wcpaDjMacUp d y) (x + y)
      omega
    · have hle : Nat.choose (i + 1) (d + 1) ≤ Nat.choose k (d + 1) :=
        Nat.choose_le_choose (d + 1) (by omega)
      have hxP : x < Nat.choose k (d + 1) := by omega
      have htop := wcpa_mac_top d k (Nat.choose k (d + 1) - x) r hd (by omega) (by omega) hr
      have e0 : Nat.choose k (d + 1) - (Nat.choose k (d + 1) - x) = x := by omega
      have e3 : r + (Nat.choose k (d + 1) - x) = y := by omega
      have e4 : Nat.choose k (d + 1) + r = x + y := by omega
      rw [e0, e3, e4] at htop
      have e1 := (wcpa_mac_rec d k 0 (by omega)).1
      simp only [add_zero, hM0] at e1
      have e2 := (wcpa_mac_rec d k r hr).1
      rw [← ha] at e2
      rw [min_comm] at htop
      omega
  intro N

  have hle1 : ∀ (v : Fin (N + 1) →₀ ℕ) (l : Fin (N + 1)), v l ≠ 0 →
      v - Finsupp.single l 1 + Finsupp.single l 1 = v := fun v l h =>
    tsub_add_cancel_of_le (Finsupp.single_le_iff.mpr (Nat.one_le_iff_ne_zero.mpr h))
  have hdeg1 : ∀ (v : Fin (N + 1) →₀ ℕ) (l : Fin (N + 1)), v l ≠ 0 →
      (v - Finsupp.single l 1).degree + 1 = v.degree := by
    intro v l h
    have := congrArg Finsupp.degree (hle1 v l h)
    rwa [map_add, Finsupp.degree_single] at this
  have hsub_apply : ∀ (v : Fin (N + 1) →₀ ℕ) (l m : Fin (N + 1)),
      (v - Finsupp.single l (1 : ℕ)) m = v m - (if l = m then 1 else 0) := by
    intro v l m
    rw [Finsupp.tsub_apply, Finsupp.single_apply]

  have hE1 : ∀ U T : Finset (Fin (N + 1) →₀ ℕ), (∀ u ∈ U, u.degree = 1) →
      (∀ v ∈ T, v.degree = 1 + 1 ∧ ∀ l, v l ≠ 0 → v - Finsupp.single l 1 ∈ U) →
      T.card ≤ wcpaDjMacUp 1 U.card := by
    intro U T hU hT
    have hsub : T ⊆ U.sym2.image
        (Sym2.lift ⟨fun a b : Fin (N + 1) →₀ ℕ => a + b, fun a b => add_comm a b⟩ :
          Sym2 (Fin (N + 1) →₀ ℕ) → (Fin (N + 1) →₀ ℕ)) := by
      intro v hv
      obtain ⟨hvdeg, hvU⟩ := hT v hv
      have hv0 : v ≠ 0 := by
        intro h
        rw [h, map_zero] at hvdeg
        omega
      obtain ⟨i, hi⟩ : ∃ i, v i ≠ 0 := by
        by_contra h
        push_neg at h
        exact hv0 (Finsupp.ext h)
      have hui := hvU i hi
      have hv_eq := hle1 v i hi
      obtain ⟨u, hu⟩ : ∃ u, u = v - Finsupp.single i 1 := ⟨_, rfl⟩
      rw [← hu] at hui hv_eq
      have hudeg : u.degree = 1 := hU u hui
      have hu0 : u ≠ 0 := by
        intro h
        rw [h, map_zero] at hudeg
        omega
      obtain ⟨j, hj⟩ : ∃ j, u j ≠ 0 := by
        by_contra h
        push_neg at h
        exact hu0 (Finsupp.ext h)
      have hu_eq := hle1 u j hj
      have hdeg0 : (u - Finsupp.single j 1).degree = 0 := by
        have := hdeg1 u j hj
        omega
      have hu' : u = Finsupp.single j 1 := by
        rw [Finsupp.degree_eq_zero_iff] at hdeg0
        rw [hdeg0, zero_add] at hu_eq
        exact hu_eq.symm
      have hvj : v j ≠ 0 := by
        have : v j = u j + (Finsupp.single i 1) j := by
          rw [← Finsupp.add_apply, hv_eq]
        omega
      have hw := hvU j hvj
      have hw' : v - Finsupp.single j 1 = Finsupp.single i 1 := by
        rw [← hv_eq, hu', add_tsub_cancel_left]
      rw [hw'] at hw
      rw [Finset.mem_image]
      refine ⟨s(u, Finsupp.single i 1), Finset.mk_mem_sym2_iff.mpr ⟨hui, hw⟩, ?_⟩
      rw [Sym2.lift_mk]
      exact hv_eq
    calc T.card ≤ (U.sym2.image
        (Sym2.lift ⟨fun a b : Fin (N + 1) →₀ ℕ => a + b, fun a b => add_comm a b⟩ :
          Sym2 (Fin (N + 1) →₀ ℕ) → (Fin (N + 1) →₀ ℕ))).card := Finset.card_le_card hsub
      _ ≤ U.sym2.card := Finset.card_image_le
      _ = Nat.choose (U.card + 1) 2 := Finset.card_sym2 U
      _ = wcpaDjMacUp 1 U.card := (hM1 U.card).symm

  have key : ∀ n : ℕ, ∀ e : ℕ, 1 ≤ e → ∀ U T : Finset (Fin (N + 1) →₀ ℕ),
      (∀ v ∈ T, ∀ l : Fin (N + 1), n ≤ l.val → v l = 0) →
      (∀ u ∈ U, u.degree = e) →
      (∀ v ∈ T, v.degree = e + 1 ∧ ∀ l, v l ≠ 0 → v - Finsupp.single l 1 ∈ U) →
      T.card ≤ wcpaDjMacUp e U.card := by
    intro n
    induction n with
    | zero =>
      intro e he U T hsupp hU hT
      have hTe : T = ∅ := by
        apply Finset.eq_empty_of_forall_notMem
        intro v hv
        have h0 : v = 0 := Finsupp.ext (fun l => hsupp v hv l (Nat.zero_le _))
        have := (hT v hv).1
        rw [h0, map_zero] at this
        omega
      rw [hTe, Finset.card_empty]
      exact Nat.zero_le _
    | succ n ih =>
      by_cases hn : N + 1 ≤ n
      · intro e he U T hsupp hU hT
        exact ih e he U T (fun v _ l hl => absurd hl (by have := l.isLt; omega)) hU hT
      · obtain ⟨s, hs⟩ : ∃ s : Fin (N + 1), s.val = n := ⟨⟨n, by omega⟩, rfl⟩
        intro e he
        induction e, he using Nat.le_induction with
        | base =>
          intro U T _ hU hT
          exact hE1 U T hU hT
        | succ e he ihe =>
          intro U T hsupp hU hT
          obtain ⟨T1, hT1⟩ : ∃ X, X = T.filter (fun v => v s = 0) := ⟨_, rfl⟩
          obtain ⟨T2, hT2⟩ : ∃ X, X = T.filter (fun v => ¬ v s = 0) := ⟨_, rfl⟩
          obtain ⟨W, hW⟩ : ∃ X, X = T2.image (fun v => v - Finsupp.single s 1) := ⟨_, rfl⟩
          obtain ⟨U1, hU1⟩ : ∃ X, X = U.filter (fun u => u s = 0) := ⟨_, rfl⟩
          obtain ⟨U2, hU2⟩ : ∃ X, X = U.filter (fun u => ¬ u s = 0) := ⟨_, rfl⟩
          obtain ⟨V, hV⟩ : ∃ X, X = U2.image (fun u => u - Finsupp.single s 1) := ⟨_, rfl⟩
          have hT1mem : ∀ v, v ∈ T1 ↔ v ∈ T ∧ v s = 0 := fun v => by
            rw [hT1, Finset.mem_filter]
          have hU1mem : ∀ u, u ∈ U1 ↔ u ∈ U ∧ u s = 0 := fun u => by
            rw [hU1, Finset.mem_filter]
          have hT2mem : ∀ v, v ∈ T2 ↔ v ∈ T ∧ ¬ v s = 0 := fun v => by
            rw [hT2, Finset.mem_filter]
          have hU2mem : ∀ u, u ∈ U2 ↔ u ∈ U ∧ ¬ u s = 0 := fun u => by
            rw [hU2, Finset.mem_filter]
          have hWmem : ∀ w, w ∈ W ↔ ∃ v ∈ T2, v - Finsupp.single s 1 = w := fun w => by
            rw [hW, Finset.mem_image]
          have hVmem : ∀ w, w ∈ V ↔ ∃ v ∈ U2, v - Finsupp.single s 1 = w := fun w => by
            rw [hV, Finset.mem_image]
          have hinj : ∀ X : Finset (Fin (N + 1) →₀ ℕ), (∀ v ∈ X, ¬ v s = 0) →
              (X.image (fun v => v - Finsupp.single s 1)).card = X.card := by
            intro X hX
            apply Finset.card_image_of_injOn
            intro a ha b hb hab
            have hab' : a - Finsupp.single s 1 = b - Finsupp.single s 1 := hab
            calc a = a - Finsupp.single s 1 + Finsupp.single s 1 := (hle1 a s (hX a ha)).symm
              _ = b - Finsupp.single s 1 + Finsupp.single s 1 := by rw [hab']
              _ = b := hle1 b s (hX b hb)
          have hTc : T.card = T1.card + W.card := by
            rw [hW, hinj T2 (fun v hv => ((hT2mem v).mp hv).2), hT1, hT2]
            exact (Finset.card_filter_add_card_filter_not _).symm
          have hUc : U.card = U1.card + V.card := by
            rw [hV, hinj U2 (fun v hv => ((hU2mem v).mp hv).2), hU1, hU2]
            exact (Finset.card_filter_add_card_filter_not _).symm

          have hA : T1.card ≤ wcpaDjMacUp (e + 1) U1.card := by
            apply ih (e + 1) (by omega) U1 T1
            · intro v hv l hl
              rw [hT1mem] at hv
              rcases Nat.eq_or_lt_of_le hl with h | h
              · have : l = s := Fin.ext (by rw [hs]; omega)
                rw [this]
                exact hv.2
              · exact hsupp v hv.1 l h
            · intro u hu
              exact hU u ((hU1mem u).mp hu).1
            · intro v hv
              rw [hT1mem] at hv
              refine ⟨(hT v hv.1).1, fun l hl => ?_⟩
              rw [hU1mem]
              refine ⟨(hT v hv.1).2 l hl, ?_⟩
              rw [hsub_apply, hv.2]
              exact Nat.zero_sub _

          have hB : W.card ≤ wcpaDjMacUp e V.card := by
            apply ihe V W
            · intro w hw l hl
              obtain ⟨v, hv, rfl⟩ := (hWmem w).mp hw
              rw [hsub_apply, hsupp v ((hT2mem v).mp hv).1 l hl]
              exact Nat.zero_sub _
            · intro u hu
              obtain ⟨u0, hu0, rfl⟩ := (hVmem u).mp hu
              rw [hU2mem] at hu0
              have h1 := hdeg1 u0 s hu0.2
              rw [hU u0 hu0.1] at h1
              omega
            · intro w hw
              obtain ⟨v, hv, rfl⟩ := (hWmem w).mp hw
              rw [hT2mem] at hv
              obtain ⟨hvdeg, hvU⟩ := hT v hv.1
              refine ⟨?_, fun l hl => ?_⟩
              · have h1 := hdeg1 v s hv.2
                omega
              · have hvl : v l ≠ 0 := by
                  rw [hsub_apply] at hl
                  omega
                rw [hVmem]
                refine ⟨v - Finsupp.single l 1, (hU2mem _).mpr ⟨hvU l hvl, ?_⟩, tsub_right_comm⟩
                rw [hsub_apply] at hl ⊢
                by_cases hls : l = s
                · subst hls
                  rw [if_pos rfl] at hl ⊢
                  exact hl
                · rw [if_neg hls]
                  have := hv.2
                  omega
          have hWU : W ⊆ U := by
            intro w hw
            obtain ⟨v, hv, rfl⟩ := (hWmem w).mp hw
            rw [hT2mem] at hv
            exact (hT v hv.1).2 s hv.2
          have hWc : W.card ≤ U.card := Finset.card_le_card hWU
          have hGe := hG e U1.card V.card he
          have hmin : W.card ≤ min (wcpaDjMacUp e V.card) (U1.card + V.card) :=
            le_min hB (by omega)
          rw [hUc]
          omega
  intro e U T he hU hT
  exact key (N + 1) e he U T (fun v _ l hl => absurd hl (by have := l.isLt; omega)) hU hT

theorem wcpa_dj_flrg_lead_monomials : ∀ (K : Type u) [Field K] (N e : ℕ) (𝔞 : Ideal (MvPolynomial (Fin (N + 1)) K)), ∃ (U T : Finset (Fin (N + 1) →₀ ℕ)), (∀ u ∈ U, u.degree = e) ∧ U.card = wcpaDjHilbFn K N 𝔞 e ∧ (∀ v ∈ T, v.degree = e + 1 ∧ ∀ l, v l ≠ 0 → v - Finsupp.single l 1 ∈ U) ∧ wcpaDjHilbFn K N 𝔞 (e + 1) ≤ T.card :=
by
  intro K _ N e 𝔞
  classical

  have s3 : ∀ (v : Fin (N + 1) →₀ ℕ) (l : Fin (N + 1)), v.degree = e + 1 → v l ≠ 0 →
      (∀ f ∈ 𝔞, f.IsHomogeneous (e + 1) → f ≠ 0 → MonomialOrder.degLex.degree f ≠ v) →
      (v - Finsupp.single l 1).degree = e ∧ ∀ f ∈ 𝔞, f.IsHomogeneous e → f ≠ 0 →
        MonomialOrder.degLex.degree f ≠ v - Finsupp.single l 1 := by
    intro v l hv hl hstd
    have hle : Finsupp.single l 1 ≤ v := by
      rw [Finsupp.single_le_iff]; omega
    have hsum : v - Finsupp.single l 1 + Finsupp.single l 1 = v := tsub_add_cancel_of_le hle
    refine ⟨?_, ?_⟩
    · have h := congrArg Finsupp.degree hsum
      rw [map_add, Finsupp.degree_single, hv] at h
      omega
    · intro f hf hfh hf0 hdeg
      apply hstd (MvPolynomial.X l * f) (Ideal.mul_mem_left _ _ hf)
      · have := (MvPolynomial.isHomogeneous_X K l).mul hfh
        rwa [show 1 + e = e + 1 from by omega] at this
      · exact mul_ne_zero (MvPolynomial.X_ne_zero l) hf0
      · rw [MonomialOrder.degree_mul (MvPolynomial.X_ne_zero l) hf0, MonomialOrder.degree_X, hdeg]
        exact (add_comm _ _).trans hsum

  have s1 : ∀ (d : ℕ) (S : Finset (Fin (N + 1) →₀ ℕ)), (∀ μ ∈ S, μ.degree = d ∧ ∀ f ∈ 𝔞,
      f.IsHomogeneous d → f ≠ 0 → MonomialOrder.degLex.degree f ≠ μ) →
      Module.Finite K (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K d) ⧸
        Submodule.comap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K d).subtype
          (Submodule.restrictScalars K 𝔞)) → S.card ≤ wcpaDjHilbFn K N 𝔞 d := by
    intro d S hS hfin
    set Sd := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K d with hSd
    set Id := Submodule.comap Sd.subtype (Submodule.restrictScalars K 𝔞) with hId
    have hmem : ∀ μ : S, MvPolynomial.monomial (μ : Fin (N+1) →₀ ℕ) (1 : K) ∈ Sd := fun μ => by
      rw [hSd, MvPolynomial.mem_homogeneousSubmodule]
      exact MvPolynomial.isHomogeneous_monomial _ (hS μ μ.2).1
    let b : S → Sd ⧸ Id := fun μ => Id.mkQ ⟨_, hmem μ⟩
    have hli : LinearIndependent K b := by
      rw [Fintype.linearIndependent_iff]
      intro g hg
      set G : MvPolynomial (Fin (N+1)) K :=
        ∑ μ : S, MvPolynomial.monomial (μ : Fin (N+1) →₀ ℕ) (g μ) with hGdef
      have hGmem : G ∈ Sd := by
        refine Submodule.sum_mem _ (fun μ _ => ?_)
        rw [hSd, MvPolynomial.mem_homogeneousSubmodule]
        exact MvPolynomial.isHomogeneous_monomial _ (hS μ μ.2).1
      have hsum : ∑ μ, g μ • b μ = Id.mkQ ⟨G, hGmem⟩ := by
        have : (⟨G, hGmem⟩ : Sd) = ∑ μ : S, g μ • (⟨_, hmem μ⟩ : Sd) := by
          apply Subtype.ext
          simp only [Submodule.coe_sum, Submodule.coe_smul, MvPolynomial.smul_monomial,
            smul_eq_mul, mul_one, hGdef]
        rw [this, map_sum]
        simp only [map_smul, b]
      rw [hsum, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at hg
      have hGa : G ∈ 𝔞 := hg
      have hcoeff : ∀ μ : S, G.coeff μ = g μ := by
        intro μ
        rw [hGdef, MvPolynomial.coeff_sum, Finset.sum_eq_single μ]
        · simp [MvPolynomial.coeff_monomial]
        · intro ν _ hν
          rw [MvPolynomial.coeff_monomial, if_neg]
          intro h; exact hν (Subtype.ext h)
        · intro h; exact absurd (Finset.mem_univ μ) h
      have hcoeff' : ∀ ν, ν ∉ S → G.coeff ν = 0 := by
        intro ν hν
        rw [hGdef, MvPolynomial.coeff_sum]
        apply Finset.sum_eq_zero
        intro μ _
        rw [MvPolynomial.coeff_monomial, if_neg]
        intro h; exact hν (h ▸ μ.2)
      have hG0 : G = 0 := by
        by_contra hG0
        have hmem0 := MonomialOrder.degree_mem_support (m := MonomialOrder.degLex) hG0
        have hin : MonomialOrder.degLex.degree G ∈ S := by
          by_contra hn
          exact (MvPolynomial.mem_support_iff.mp hmem0) (hcoeff' _ hn)
        exact (hS _ hin).2 G hGa
          (by rw [← MvPolynomial.mem_homogeneousSubmodule]; exact hGmem) hG0 rfl
      intro μ
      rw [← hcoeff μ, hG0]; simp
    have := hli.fintype_card_le_finrank
    rw [Fintype.card_coe] at this
    exact this

  have s2 : ∀ (d : ℕ) (S : Finset (Fin (N + 1) →₀ ℕ)), (∀ μ : Fin (N + 1) →₀ ℕ, μ.degree = d →
      (∀ f ∈ 𝔞, f.IsHomogeneous d → f ≠ 0 → MonomialOrder.degLex.degree f ≠ μ) → μ ∈ S) →
      Module.Finite K (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K d) ⧸
        Submodule.comap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K d).subtype
          (Submodule.restrictScalars K 𝔞)) ∧ wcpaDjHilbFn K N 𝔞 d ≤ S.card := by
    intro d S hS
    set Sd := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K d with hSd
    set Id := Submodule.comap Sd.subtype (Submodule.restrictScalars K 𝔞) with hId
    set S' := S.filter (fun μ => μ.degree = d) with hS'
    have hmem : ∀ μ : S', MvPolynomial.monomial (μ : Fin (N+1) →₀ ℕ) (1 : K) ∈ Sd := fun μ => by
      rw [hSd, MvPolynomial.mem_homogeneousSubmodule]
      exact MvPolynomial.isHomogeneous_monomial _ (Finset.mem_filter.mp μ.2).2
    let b : S' → Sd ⧸ Id := fun μ => Id.mkQ ⟨_, hmem μ⟩
    set P := Submodule.span K (Set.range b) with hP
    have hR : ∀ a : (MonomialOrder.degLex : MonomialOrder (Fin (N+1))).syn,
        ∀ p : MvPolynomial (Fin (N+1)) K, ∀ hp : p ∈ Sd,
        MonomialOrder.degLex.toSyn (MonomialOrder.degLex.degree p) = a →
          Id.mkQ ⟨p, hp⟩ ∈ P := by
      intro a
      induction a using WellFoundedLT.induction with
      | _ a ih =>
      intro p hp ha
      by_cases hp0 : p = 0
      · have : (⟨p, hp⟩ : Sd) = 0 := Subtype.ext hp0
        rw [this, map_zero]; exact Submodule.zero_mem _
      set μ := MonomialOrder.degLex.degree p with hμ
      set c := p.coeff μ with hcdef
      have hc : c ≠ 0 :=
        MvPolynomial.mem_support_iff.mp
          (MonomialOrder.degree_mem_support (m := MonomialOrder.degLex) hp0)
      have hph : p.IsHomogeneous d := (MvPolynomial.mem_homogeneousSubmodule _ _).mp hp
      have hμd : μ.degree = d := by
        by_contra h; exact hc (hph.coeff_eq_zero h)
      obtain ⟨q, hq, hqc, hqs, hqP⟩ : ∃ q : MvPolynomial (Fin (N+1)) K, ∃ hq : q ∈ Sd,
          q.coeff μ = c ∧ (∀ ν ∈ q.support,
            MonomialOrder.degLex.toSyn ν ≤ MonomialOrder.degLex.toSyn μ) ∧
            Id.mkQ ⟨q, hq⟩ ∈ P := by
        by_cases hstd : ∀ f ∈ 𝔞, f.IsHomogeneous d → f ≠ 0 → MonomialOrder.degLex.degree f ≠ μ
        · have hμS' : μ ∈ S' := Finset.mem_filter.mpr ⟨hS μ hμd hstd, hμd⟩
          have hq : MvPolynomial.monomial μ c ∈ Sd := by
            rw [hSd, MvPolynomial.mem_homogeneousSubmodule]
            exact MvPolynomial.isHomogeneous_monomial _ hμd
          refine ⟨MvPolynomial.monomial μ c, hq, by simp [MvPolynomial.coeff_monomial], ?_, ?_⟩
          · intro ν hν
            rw [Finset.mem_singleton.mp (MvPolynomial.support_monomial_subset hν)]
          · have : Id.mkQ ⟨MvPolynomial.monomial μ c, hq⟩ = c • b ⟨μ, hμS'⟩ := by
              have e : (⟨MvPolynomial.monomial μ c, hq⟩ : Sd) =
                  c • ⟨MvPolynomial.monomial μ 1, hmem ⟨μ, hμS'⟩⟩ := by
                apply Subtype.ext
                simp [MvPolynomial.smul_monomial]
              rw [e, map_smul]
            rw [this]
            exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨_, rfl⟩)
        · push_neg at hstd
          obtain ⟨f, hfa, hfh, hf0, hfμ⟩ := hstd
          set cf := f.coeff μ with hcf_def
          have hcf : cf ≠ 0 := by
            have := MonomialOrder.degree_mem_support (m := MonomialOrder.degLex) hf0
            rw [hfμ] at this
            exact MvPolynomial.mem_support_iff.mp this
          have hq : MvPolynomial.C (c / cf) * f ∈ Sd := by
            rw [hSd, MvPolynomial.mem_homogeneousSubmodule]
            have := (MvPolynomial.isHomogeneous_C (Fin (N+1)) (c / cf)).mul hfh
            rwa [zero_add] at this
          refine ⟨MvPolynomial.C (c / cf) * f, hq, ?_, ?_, ?_⟩
          · rw [MvPolynomial.coeff_C_mul, ← hcf_def, div_mul_cancel₀ c hcf]
          · intro ν hν
            have hν' : ν ∈ f.support := by
              rw [MvPolynomial.mem_support_iff] at hν ⊢
              rw [MvPolynomial.coeff_C_mul] at hν
              exact right_ne_zero_of_mul hν
            rw [← hfμ]
            exact MonomialOrder.le_degree hν'
          · have : Id.mkQ ⟨MvPolynomial.C (c / cf) * f, hq⟩ = 0 := by
              rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
              show MvPolynomial.C (c / cf) * f ∈ 𝔞
              exact Ideal.mul_mem_left _ _ hfa
            rw [this]; exact Submodule.zero_mem _
      have hp'mem : p - q ∈ Sd := Submodule.sub_mem _ hp hq
      have hsplit : Id.mkQ ⟨p, hp⟩ = Id.mkQ ⟨p - q, hp'mem⟩ + Id.mkQ ⟨q, hq⟩ := by
        rw [← map_add]; congr 1; apply Subtype.ext; simp
      rw [hsplit]
      refine Submodule.add_mem _ ?_ hqP
      by_cases hp'0 : p - q = 0
      · have : (⟨p - q, hp'mem⟩ : Sd) = 0 := Subtype.ext hp'0
        rw [this, map_zero]; exact Submodule.zero_mem _
      · have hmem' := MonomialOrder.degree_mem_support (m := MonomialOrder.degLex) hp'0
        have hle : MonomialOrder.degLex.toSyn (MonomialOrder.degLex.degree (p - q)) ≤
            MonomialOrder.degLex.toSyn μ := by
          rcases Finset.mem_union.mp (MvPolynomial.support_sub _ _ _ hmem') with h | h
          · exact MonomialOrder.le_degree h
          · exact hqs _ h
        have hne : MonomialOrder.degLex.degree (p - q) ≠ μ := by
          intro h
          have := MvPolynomial.mem_support_iff.mp hmem'
          rw [h, MvPolynomial.coeff_sub, hqc, sub_self] at this
          exact this rfl
        have hlt : MonomialOrder.degLex.toSyn (MonomialOrder.degLex.degree (p - q)) < a := by
          rw [← ha]
          exact lt_of_le_of_ne hle (fun h => hne (MonomialOrder.degLex.toSyn.injective h))
        exact ih _ hlt (p - q) hp'mem rfl
    have htop : P = ⊤ := by
      rw [eq_top_iff]
      rintro x -
      obtain ⟨y, rfl⟩ := Id.mkQ_surjective x
      exact hR _ y.1 y.2 rfl
    have hfin : Module.Finite K (Sd ⧸ Id) := by
      rw [Module.finite_def, ← htop]
      exact Submodule.fg_span (Set.finite_range b)
    refine ⟨hfin, ?_⟩
    have h1 : Module.finrank K (Sd ⧸ Id) = Module.finrank K P := by rw [htop, finrank_top]
    have h2 : Module.finrank K P ≤ Fintype.card S' := finrank_range_le_card b
    have h3 : Fintype.card S' = S'.card := Fintype.card_coe S'
    have h4 : S'.card ≤ S.card := Finset.card_filter_le _ _
    show Module.finrank K (Sd ⧸ Id) ≤ S.card
    omega

  have hfinset : ∀ d : ℕ, {μ : Fin (N+1) →₀ ℕ | μ.degree = d ∧ ∀ f ∈ 𝔞, f.IsHomogeneous d →
      f ≠ 0 → MonomialOrder.degLex.degree f ≠ μ}.Finite := fun d =>
    (Finsupp.finite_of_degree_le d).subset (fun μ hμ => le_of_eq hμ.1)
  refine ⟨(hfinset e).toFinset, (hfinset (e+1)).toFinset, ?_, ?_, ?_, ?_⟩
  · intro u hu; exact ((hfinset e).mem_toFinset.mp hu).1
  · obtain ⟨hfin, hle⟩ := s2 e _ (fun μ h1 h2 => (hfinset e).mem_toFinset.mpr ⟨h1, h2⟩)
    exact le_antisymm (s1 e _ (fun μ hμ => (hfinset e).mem_toFinset.mp hμ) hfin) hle
  · intro v hv
    have hv' := (hfinset (e+1)).mem_toFinset.mp hv
    refine ⟨hv'.1, fun l hl => ?_⟩
    exact (hfinset e).mem_toFinset.mpr (s3 v l hv'.1 hl hv'.2)
  · exact (s2 (e+1) _ (fun μ h1 h2 => (hfinset (e+1)).mem_toFinset.mpr ⟨h1, h2⟩)).2

theorem wcpa_dj_flrg_gotzmann_descent : ∀ (h : ℕ → ℕ) (E : ℕ), 1 ≤ E → (∀ e, E ≤ e → h (e + 1) ≤ wcpaDjMacUp e (h e)) → ∃ D, E ≤ D ∧ ∀ e, D ≤ e → h (e + 1) = wcpaDjMacUp e (h e) :=
by
  classical
  obtain ⟨K, hK⟩ : ∃ K : ℕ → ℕ → ℕ, ∀ d a,
      K d a = Nat.findGreatest (fun k => Nat.choose k (d + 1) ≤ a) (a + d + 1) :=
    ⟨_, fun _ _ => rfl⟩
  have hMac0 : ∀ a, wcpaDjMacUp 0 a = 0 := by
    intro a
    first | rfl | simp [wcpaDjMacUp]
  have hMac : ∀ d a, wcpaDjMacUp (d + 1) a =
      Nat.choose (K d a + 1) (d + 1 + 1) + wcpaDjMacUp d (a - Nat.choose (K d a) (d + 1)) := by
    intro d a
    simp only [hK]
    first | rfl | (rw [wcpaDjMacUp]) | simp [wcpaDjMacUp]

  have H0 : ∀ a, wcpaDjGdRep 0 a = 0 := by
    intro a
    first | rfl | simp [wcpaDjGdRep]
  have H1 : ∀ d, wcpaDjGdRep (d + 1) 0 = 0 := by
    intro d
    simp [wcpaDjGdRep]
  have H2 : ∀ d a, 1 ≤ a → wcpaDjGdRep (d + 1) a =
      (K d a - (d + 1)) ::ₘ wcpaDjGdRep d (a - Nat.choose (K d a) (d + 1)) := by
    intro d a ha
    rw [hK, wcpaDjGdRep, if_neg (by omega)]

  have bnd : ∀ m d, m + 1 ≤ Nat.choose (m + d + 1) (d + 1) := by
    intro m d
    induction m with
    | zero => simp
    | succ m ih =>
      have h1 : Nat.choose (m + 1 + d + 1) (d + 1) =
          Nat.choose (m + d + 1) d + Nat.choose (m + d + 1) (d + 1) := by
        rw [show m + 1 + d + 1 = (m + d + 1) + 1 by ring]
        exact Nat.choose_succ_succ' _ _
      have h2 : 0 < Nat.choose (m + d + 1) d := Nat.choose_pos (by omega)
      omega

  have kspec : ∀ d a, 1 ≤ a → d + 1 ≤ K d a ∧ Nat.choose (K d a) (d + 1) ≤ a ∧
      a < Nat.choose (K d a + 1) (d + 1) := by
    intro d a ha
    rw [hK]
    have hP : Nat.choose (d + 1) (d + 1) ≤ a := by rw [Nat.choose_self]; exact ha
    have h1 : d + 1 ≤ Nat.findGreatest (fun k => Nat.choose k (d + 1) ≤ a) (a + d + 1) :=
      Nat.le_findGreatest (P := fun k => Nat.choose k (d + 1) ≤ a) (by omega) hP
    have h2 : Nat.choose (Nat.findGreatest (fun k => Nat.choose k (d + 1) ≤ a) (a + d + 1))
        (d + 1) ≤ a :=
      Nat.findGreatest_spec (P := fun k => Nat.choose k (d + 1) ≤ a)
        (by omega : d + 1 ≤ a + d + 1) hP
    have h3 := Nat.findGreatest_le (P := fun k => Nat.choose k (d + 1) ≤ a) (a + d + 1)
    refine ⟨h1, h2, ?_⟩
    have hne : Nat.findGreatest (fun k => Nat.choose k (d + 1) ≤ a) (a + d + 1) ≠ a + d + 1 := by
      intro heq
      rw [heq] at h2
      have := bnd a d
      omega
    by_contra hc
    push_neg at hc
    exact Nat.findGreatest_is_greatest (P := fun k => Nat.choose k (d + 1) ≤ a)
      (Nat.lt_succ_self _) (by omega) hc

  have keq : ∀ d a m, Nat.choose m (d + 1) ≤ a → a < Nat.choose (m + 1) (d + 1) → K d a = m := by
    intro d a m h1 h2
    rw [hK, Nat.findGreatest_eq_iff]
    refine ⟨?_, fun _ => h1, ?_⟩
    · by_contra hc
      push_neg at hc
      have := Nat.choose_le_choose (d + 1) (show a + d + 1 ≤ m by omega)
      have := bnd a d
      omega
    · intro n hn hn2 hP
      have hP' : Nat.choose n (d + 1) ≤ a := hP
      have := Nat.choose_le_choose (d + 1) (show m + 1 ≤ n by omega)
      omega

  have mac0 : ∀ d, wcpaDjMacUp d 0 = 0 := by
    intro d
    induction d with
    | zero => exact hMac0 0
    | succ d ih =>
      rw [hMac]
      have hk : K d 0 = d :=
        keq d 0 d (by rw [Nat.choose_eq_zero_of_lt (by omega)]) (by rw [Nat.choose_self]; omega)
      rw [hk, Nat.choose_eq_zero_of_lt (by omega : d + 1 < d + 1 + 1), Nat.zero_sub, ih]

  have maclt : ∀ d r m, r < Nat.choose m d → wcpaDjMacUp d r < Nat.choose (m + 1) (d + 1) := by
    intro d
    induction d with
    | zero =>
      intro r m hr
      rw [Nat.choose_zero_right] at hr
      have hr0 : r = 0 := by omega
      subst hr0
      rw [hMac0]
      simp
    | succ d ih =>
      intro r m hr
      rcases Nat.eq_zero_or_pos r with h0 | hpos
      · subst h0
        rw [mac0]
        have : d + 1 ≤ m := by
          by_contra hc
          push_neg at hc
          rw [Nat.choose_eq_zero_of_lt hc] at hr
          omega
        exact Nat.choose_pos (by omega)
      · obtain ⟨k1, k2, k3⟩ := kspec d r hpos
        have hkm : K d r < m := by
          by_contra hc
          push_neg at hc
          have := Nat.choose_le_choose (d + 1) hc
          omega
        have hpas : Nat.choose (K d r + 1) (d + 1) =
            Nat.choose (K d r) d + Nat.choose (K d r) (d + 1) := Nat.choose_succ_succ' _ _
        have hr' : r - Nat.choose (K d r) (d + 1) < Nat.choose (K d r) d := by omega
        have h1 := ih _ _ hr'
        have hpas2 : Nat.choose (K d r + 1 + 1) (d + 1 + 1) =
            Nat.choose (K d r + 1) (d + 1) + Nat.choose (K d r + 1) (d + 1 + 1) :=
          Nat.choose_succ_succ' _ _
        have h3 := Nat.choose_le_choose (d + 1 + 1) (show K d r + 1 + 1 ≤ m + 1 by omega)
        rw [hMac]
        omega

  have head : ∀ d a, 1 ≤ a → 1 ≤ wcpaDjMacUp (d + 1) a ∧
      K (d + 1) (wcpaDjMacUp (d + 1) a) = K d a + 1 ∧
      wcpaDjMacUp (d + 1) a - Nat.choose (K d a + 1) (d + 1 + 1) =
        wcpaDjMacUp d (a - Nat.choose (K d a) (d + 1)) := by
    intro d a ha
    obtain ⟨k1, k2, k3⟩ := kspec d a ha
    have hpas : Nat.choose (K d a + 1) (d + 1) =
        Nat.choose (K d a) d + Nat.choose (K d a) (d + 1) := Nat.choose_succ_succ' _ _
    have hr : a - Nat.choose (K d a) (d + 1) < Nat.choose (K d a) d := by omega
    have h4 := maclt d _ _ hr
    have hpas2 : Nat.choose (K d a + 1 + 1) (d + 1 + 1) =
        Nat.choose (K d a + 1) (d + 1) + Nat.choose (K d a + 1) (d + 1 + 1) :=
      Nat.choose_succ_succ' _ _
    have hpos : 0 < Nat.choose (K d a + 1) (d + 1 + 1) := Nat.choose_pos (by omega)
    rw [hMac]
    refine ⟨by omega, ?_, by omega⟩
    apply keq
    · omega
    · omega

  have shift : ∀ e a, wcpaDjGdRep (e + 1) (wcpaDjMacUp e a) = wcpaDjGdRep e a := by
    intro e
    induction e with
    | zero => intro a; rw [hMac0, H1, H0]
    | succ d ih =>
      intro a
      rcases Nat.eq_zero_or_pos a with h0 | ha
      · subst h0
        rw [mac0, H1, H1]
      · obtain ⟨m1, m2, m3⟩ := head d a ha
        rw [H2 (d + 1) _ m1, m2, m3, ih, H2 d a ha]
        congr 1
        omega

  have bound : ∀ d r m, r < Nat.choose m d → ∀ x ∈ wcpaDjGdRep d r, x + d + 1 ≤ m := by
    intro d
    induction d with
    | zero =>
      intro r m _ x hx
      rw [H0] at hx
      simp at hx
    | succ d ih =>
      intro r m hr x hx
      rcases Nat.eq_zero_or_pos r with h0 | hpos
      · subst h0
        rw [H1] at hx
        simp at hx
      · obtain ⟨k1, k2, k3⟩ := kspec d r hpos
        have hkm : K d r < m := by
          by_contra hc
          push_neg at hc
          have := Nat.choose_le_choose (d + 1) hc
          omega
        have hpas : Nat.choose (K d r + 1) (d + 1) =
            Nat.choose (K d r) d + Nat.choose (K d r) (d + 1) := Nat.choose_succ_succ' _ _
        have hr' : r - Nat.choose (K d r) (d + 1) < Nat.choose (K d r) d := by omega
        rw [H2 d r hpos, Multiset.mem_cons] at hx
        rcases hx with hx | hx
        · omega
        · have := ih _ _ hr' x hx
          omega

  have dm : ∀ d b b', b < b' →
      Multiset.IsDershowitzMannaLT (wcpaDjGdRep (d + 1) b) (wcpaDjGdRep (d + 1) b') := by
    intro d
    induction d using Nat.strong_induction_on with
    | _ d ihd =>
    intro b b' hbb'
    have hb'pos : 1 ≤ b' := by omega
    rcases Nat.eq_zero_or_pos b with h0 | hbpos
    · subst h0
      refine ⟨0, 0, wcpaDjGdRep (d + 1) b', ?_, ?_, ?_, ?_⟩
      · rw [H2 d b' hb'pos, Multiset.empty_eq_zero]
        exact Multiset.cons_ne_zero
      · simp [H1]
      · simp
      · intro y hy
        simp at hy
    · obtain ⟨k1, k2, k3⟩ := kspec d b hbpos
      obtain ⟨k1', k2', k3'⟩ := kspec d b' hb'pos
      have hkk : K d b ≤ K d b' := by
        by_contra hc
        push_neg at hc
        have := Nat.choose_le_choose (d + 1) (show K d b' + 1 ≤ K d b by omega)
        omega
      have hpas : Nat.choose (K d b + 1) (d + 1) =
          Nat.choose (K d b) d + Nat.choose (K d b) (d + 1) := Nat.choose_succ_succ' _ _
      have hpas' : Nat.choose (K d b' + 1) (d + 1) =
          Nat.choose (K d b') d + Nat.choose (K d b') (d + 1) := Nat.choose_succ_succ' _ _
      have hr : b - Nat.choose (K d b) (d + 1) < Nat.choose (K d b) d := by omega
      have hr' : b' - Nat.choose (K d b') (d + 1) < Nat.choose (K d b') d := by omega
      rcases Nat.lt_or_ge (K d b) (K d b') with hlt | hge
      · refine ⟨0, wcpaDjGdRep (d + 1) b, wcpaDjGdRep (d + 1) b', ?_, by simp, by simp, ?_⟩
        · rw [H2 d b' hb'pos, Multiset.empty_eq_zero]
          exact Multiset.cons_ne_zero
        · intro y hy
          refine ⟨K d b' - (d + 1), ?_, ?_⟩
          · rw [H2 d b' hb'pos]
            exact Multiset.mem_cons.mpr (Or.inl rfl)
          · rw [H2 d b hbpos, Multiset.mem_cons] at hy
            rcases hy with hy | hy
            · omega
            · have := bound d _ _ hr y hy
              omega
      · have heq : K d b = K d b' := le_antisymm hkk hge
        have hrr : b - Nat.choose (K d b) (d + 1) < b' - Nat.choose (K d b') (d + 1) := by
          rw [heq] at k2 ⊢
          omega
        rcases d with _ | d₀
        · rw [Nat.choose_zero_right] at hr hr'
          omega
        · obtain ⟨X, Y, Z, hZ, hM, hN, hYZ⟩ := ihd d₀ (by omega) _ _ hrr
          refine ⟨(K (d₀ + 1) b - (d₀ + 1 + 1)) ::ₘ X, Y, Z, hZ, ?_, ?_, hYZ⟩
          · rw [H2 (d₀ + 1) b hbpos, hM, Multiset.cons_add]
          · rw [H2 (d₀ + 1) b' hb'pos, hN, Multiset.cons_add, heq]

  intro h E _ hgrow
  have WF := Multiset.wellFounded_isDershowitzMannaLT (α := ℕ)
  have Q : ∀ L : Multiset ℕ, (∀ e, E ≤ e → wcpaDjGdRep e (h e) = L →
      ∃ D, e ≤ D ∧ ∀ e', D ≤ e' → h (e' + 1) = wcpaDjMacUp e' (h e')) := by
    intro L
    refine WellFounded.induction WF (C := fun L : Multiset ℕ => ∀ e, E ≤ e →
      wcpaDjGdRep e (h e) = L →
      ∃ D, e ≤ D ∧ ∀ e', D ≤ e' → h (e' + 1) = wcpaDjMacUp e' (h e')) L ?_
    intro L IH e he hL
    by_cases hA : ∀ e', e ≤ e' → h (e' + 1) = wcpaDjMacUp e' (h e')
    · exact ⟨e, le_rfl, hA⟩
    · push_neg at hA
      have hex : ∃ n, e ≤ n ∧ h (n + 1) ≠ wcpaDjMacUp n (h n) := hA
      have he₁ : e ≤ Nat.find hex ∧
          h (Nat.find hex + 1) ≠ wcpaDjMacUp (Nat.find hex) (h (Nat.find hex)) :=
        Nat.find_spec hex
      have hmin : ∀ n, n < Nat.find hex → ¬ (e ≤ n ∧ h (n + 1) ≠ wcpaDjMacUp n (h n)) :=
        fun n hn => Nat.find_min hex hn
      have hconst : ∀ t, e + t ≤ Nat.find hex → wcpaDjGdRep (e + t) (h (e + t)) = L := by
        intro t
        induction t with
        | zero => intro _; simpa using hL
        | succ t iht =>
          intro ht
          have h1 := hmin (e + t) (by omega)
          have h2 : h (e + t + 1) = wcpaDjMacUp (e + t) (h (e + t)) := by
            by_contra hc
            exact h1 ⟨by omega, hc⟩
          rw [show e + (t + 1) = e + t + 1 by omega, h2, shift]
          exact iht (by omega)
      have hcL : wcpaDjGdRep (Nat.find hex) (h (Nat.find hex)) = L := by
        have := hconst (Nat.find hex - e) (by omega)
        rwa [show e + (Nat.find hex - e) = Nat.find hex by omega] at this
      have hlt : h (Nat.find hex + 1) < wcpaDjMacUp (Nat.find hex) (h (Nat.find hex)) :=
        lt_of_le_of_ne (hgrow _ (by omega)) he₁.2
      have hdm := dm (Nat.find hex) _ _ hlt
      rw [shift, hcL] at hdm
      obtain ⟨D, hD1, hD2⟩ := IH _ hdm (Nat.find hex + 1) (by omega) rfl
      exact ⟨D, by omega, hD2⟩
  obtain ⟨D, hD1, hD2⟩ := Q _ E le_rfl rfl
  exact ⟨D, hD1, hD2⟩

theorem wcpa_dj_flrg_fibre_rank : ∀ (A : Type u) [CommRing A] [IsDomain A] (N e : ℕ) (J : Ideal (MvPolynomial (Fin (N + 1)) A)), Module.Projective A (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A e) ⧸ wcpaDjDeg N J e) → ∃ ρ : ℕ, ∀ (K : Type u) [Field K] (φ : A →+* K), wcpaDjHilbFn K N (Ideal.span ((MvPolynomial.map φ) '' {F | F ∈ J ∧ F.IsHomogeneous e})) e = ρ :=
by
  intro A _ _ N e J hproj
  classical
  let ι : Type := {d : Fin (N + 1) →₀ ℕ // d.degree = e}
  haveI hfin : Finite ι :=
    ((Finsupp.finite_of_degree_le e).subset (fun d (hd : d.degree = e) => le_of_eq hd)).to_subtype
  letI : Fintype ι := Fintype.ofFinite ι

  have hcoord : ∀ (R : Type u) [CommRing R],
      ∃ c : ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R e) ≃ₗ[R] (ι → R),
        ∀ x ν, c x ν = (x : MvPolynomial (Fin (N + 1)) R).coeff ν.1 := by
    intro R _
    let L : ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R e) →ₗ[R] (ι → R) :=
      LinearMap.pi fun ν => (MvPolynomial.lcoeff R ν.1).comp
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R e).subtype
    have hL : ∀ x ν, L x ν = (x : MvPolynomial (Fin (N + 1)) R).coeff ν.1 := fun x ν => rfl
    have hinj : Function.Injective L := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      apply Subtype.ext
      ext d
      by_cases hd : d.degree = e
      · have h1 := congrFun hx ⟨d, hd⟩
        rw [hL] at h1
        simpa using h1
      · simpa using ((MvPolynomial.mem_homogeneousSubmodule e _).mp x.2).coeff_eq_zero hd
    have hsurj : Function.Surjective L := by
      intro v
      refine ⟨⟨∑ ν : ι, MvPolynomial.monomial ν.1 (v ν), ?_⟩, ?_⟩
      · rw [MvPolynomial.mem_homogeneousSubmodule]
        exact MvPolynomial.IsHomogeneous.sum _ _ _
          (fun ν _ => MvPolynomial.isHomogeneous_monomial _ ν.2)
      · funext μ
        rw [hL]
        simp only [MvPolynomial.coeff_sum, MvPolynomial.coeff_monomial]
        rw [Finset.sum_eq_single μ]
        · simp
        · intro b _ hb
          rw [if_neg]
          intro h
          exact hb (Subtype.ext h)
        · intro h
          exact absurd (Finset.mem_univ μ) h
    exact ⟨LinearEquiv.ofBijective L ⟨hinj, hsurj⟩, fun x ν => rfl⟩

  have hmulc : ∀ (K : Type u) [Field K] (q g : MvPolynomial (Fin (N + 1)) K), g.IsHomogeneous e →
      ∀ ν : ι, (q * g).coeff ν.1 = q.coeff 0 * g.coeff ν.1 := by
    intro K _ q g hg ν
    rw [MvPolynomial.coeff_mul, Finset.sum_eq_single (0, ν.1)]
    · intro b hb hne
      rw [Finset.HasAntidiagonal.mem_antidiagonal] at hb
      by_cases hb2 : b.2.degree = e
      · exfalso
        apply hne
        have h1 := map_add (Finsupp.degree (σ := Fin (N + 1)) (R := ℕ)) b.1 b.2
        rw [hb, ν.2] at h1
        have h2 : b.1.degree = 0 := by omega
        have h3 : b.1 = 0 := (Finsupp.degree_eq_zero_iff _).mp h2
        refine Prod.ext h3 ?_
        show b.2 = ν.1
        rw [← hb, h3, zero_add]
      · rw [hg.coeff_eq_zero hb2, mul_zero]
    · intro h
      exfalso
      apply h
      rw [Finset.HasAntidiagonal.mem_antidiagonal, zero_add]

  have hidem : ∀ (K : Type u) [Field K] (M : Matrix ι ι K), M * M = M →
      M.charpoly = (Polynomial.X - 1) ^ M.rank * Polynomial.X ^ (Fintype.card ι - M.rank) := by
    intro K _ M hM
    set f := Matrix.toLin' M with hf
    have hff : IsIdempotentElem f := by
      show f * f = f
      rw [Module.End.mul_eq_comp, hf, ← Matrix.toLin'_mul, hM]
    obtain ⟨p, hp⟩ := (LinearMap.isProj_iff_isIdempotentElem f).mpr hff
    have hrank : M.rank = Module.finrank K p := by
      rw [← hp.range, hf, Matrix.toLin'_apply']
      rfl
    have hnull : Module.finrank K (LinearMap.ker f) = Fintype.card ι - M.rank := by
      have := LinearMap.finrank_range_add_finrank_ker f
      rw [Module.finrank_fintype_fun_eq_card, hp.range, ← hrank] at this
      omega
    have hcp : LinearMap.charpoly f = (Polynomial.X - 1) ^ Module.finrank K p *
        Polynomial.X ^ Module.finrank K (LinearMap.ker f) := by
      conv_lhs => rw [hp.eq_conj_prodMap]
      rw [LinearEquiv.charpoly_conj, LinearMap.charpoly_prodMap, ← Module.End.one_eq_id,
        LinearMap.charpoly_one, LinearMap.charpoly_zero]
    rw [← Matrix.charpoly_toLin', ← hf, hcp, ← hrank, hnull]

  have hroot : ∀ (K : Type u) [Field K] (a b c d : ℕ),
      ((Polynomial.X - 1 : Polynomial K) ^ a * Polynomial.X ^ b =
        (Polynomial.X - 1) ^ c * Polynomial.X ^ d) → a = c := by
    intro K _ a b c d h
    have hm : (Polynomial.X - 1 : Polynomial K).Monic := by
      simpa using Polynomial.monic_X_sub_C (1 : K)
    have key : ∀ a b : ℕ, Polynomial.rootMultiplicity (1 : K)
        ((Polynomial.X - 1) ^ a * Polynomial.X ^ b) = a := by
      intro a b
      have hne : ((Polynomial.X - 1 : Polynomial K) ^ a * Polynomial.X ^ b) ≠ 0 :=
        ((hm.pow a).mul (Polynomial.monic_X.pow b)).ne_zero
      rw [Polynomial.rootMultiplicity_mul hne,
        Polynomial.rootMultiplicity_eq_zero (p := Polynomial.X ^ b) (by simp [Polynomial.IsRoot])]
      simpa using Polynomial.rootMultiplicity_X_sub_C_pow (1 : K) a
    rw [← key a b, h, key c d]

  obtain ⟨P, hPW, hPid⟩ : ∃ P : ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A e) →ₗ[A]
      ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A e),
      (∀ x, P x ∈ wcpaDjDeg N J e) ∧ (∀ w ∈ wcpaDjDeg N J e, P w = w) := by
    obtain ⟨s, hs⟩ := Module.projective_lifting_property (wcpaDjDeg N J e).mkQ LinearMap.id
      (Submodule.mkQ_surjective _)
    refine ⟨LinearMap.id - s ∘ₗ (wcpaDjDeg N J e).mkQ, fun x => ?_, fun w hw => ?_⟩
    · have h1 : (wcpaDjDeg N J e).mkQ (s ((wcpaDjDeg N J e).mkQ x)) = (wcpaDjDeg N J e).mkQ x :=
        LinearMap.congr_fun hs _
      apply (Submodule.Quotient.mk_eq_zero (wcpaDjDeg N J e)).mp
      change (wcpaDjDeg N J e).mkQ (x - s ((wcpaDjDeg N J e).mkQ x)) = 0
      rw [map_sub, h1, sub_self]
    · have h0 : (wcpaDjDeg N J e).mkQ w = 0 := by
        rw [← LinearMap.mem_ker, Submodule.ker_mkQ]
        exact hw
      rw [LinearMap.sub_apply, LinearMap.id_apply, LinearMap.comp_apply, h0, map_zero, sub_zero]

  obtain ⟨cA, hcA⟩ := hcoord A
  let L : (ι → A) →ₗ[A] (ι → A) := cA.toLinearMap ∘ₗ P ∘ₗ cA.symm.toLinearMap
  have hL : ∀ v, L v = cA (P (cA.symm v)) := fun v => rfl
  set Q := LinearMap.toMatrix' L with hQ
  have hLL : L ∘ₗ L = L := by
    apply LinearMap.ext
    intro v
    rw [LinearMap.comp_apply, hL, hL, LinearEquiv.symm_apply_apply, hPid _ (hPW _)]
  have hQQ : Q * Q = Q := by rw [hQ, ← LinearMap.toMatrix'_comp, hLL]
  have hQW : ∀ y ∈ wcpaDjDeg N J e, Q.mulVec (cA y) = cA y := by
    intro y hy
    rw [hQ, LinearMap.toMatrix'_mulVec, hL, LinearEquiv.symm_apply_apply, hPid y hy]
  have hQcol : ∀ ν μ, Q ν μ = cA (P (cA.symm (Pi.single μ 1))) ν := by
    intro ν μ
    rw [hQ, LinearMap.toMatrix'_apply, hL]

  have hinjF := IsFractionRing.injective A (FractionRing A)
  set r₀ := (Q.map (algebraMap A (FractionRing A))).rank with hr₀
  have hQF : (Q.map (algebraMap A (FractionRing A))) * (Q.map (algebraMap A (FractionRing A))) =
      Q.map (algebraMap A (FractionRing A)) := by
    rw [← Matrix.map_mul, hQQ]
  have hcpA : Q.charpoly = (Polynomial.X - 1) ^ r₀ * Polynomial.X ^ (Fintype.card ι - r₀) := by
    apply Polynomial.map_injective (algebraMap A (FractionRing A)) hinjF
    rw [← Matrix.charpoly_map, hidem (FractionRing A) _ hQF]
    simp only [Polynomial.map_mul, Polynomial.map_pow, Polynomial.map_sub, Polynomial.map_X,
      Polynomial.map_one]
    rfl
  refine ⟨Fintype.card ι - r₀, ?_⟩
  intro K _ φ
  have hQK : (Q.map φ) * (Q.map φ) = Q.map φ := by rw [← Matrix.map_mul, hQQ]
  have hrk : (Q.map φ).rank = r₀ := by
    have h1 := hidem K _ hQK
    rw [Matrix.charpoly_map, hcpA] at h1
    simp only [Polynomial.map_mul, Polynomial.map_pow, Polynomial.map_sub, Polynomial.map_X,
      Polynomial.map_one] at h1
    exact (hroot K _ _ _ _ h1).symm

  obtain ⟨cK, hcK⟩ := hcoord K
  haveI : Module.Finite K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e) :=
    Module.Finite.equiv cK.symm
  set G' := (MvPolynomial.map φ) '' {F | F ∈ J ∧ F.IsHomogeneous e} with hG'
  set V' := Submodule.comap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e).subtype
    (Submodule.restrictScalars K (Ideal.span G')) with hV'

  have hcolW : ∀ y ∈ wcpaDjDeg N J e, ∀ ν, φ (cA y ν) = (Q.map φ).mulVec (⇑φ ∘ cA y) ν := by
    intro y hy ν
    have h := RingHom.map_mulVec φ Q (cA y) ν
    rw [hQW y hy] at h
    exact h
  have hle1 : LinearMap.range (Matrix.toLin' (Q.map φ)) ≤
      Submodule.map (cK : _ →ₗ[K] (ι → K)) V' := by
    rw [Matrix.toLin'_apply', Matrix.range_mulVecLin, Submodule.span_le]
    rintro _ ⟨μ, rfl⟩
    have hy : P (cA.symm (Pi.single μ 1)) ∈ wcpaDjDeg N J e := hPW _
    have hyJ : ((P (cA.symm (Pi.single μ 1)) : ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A e)) :
        MvPolynomial (Fin (N + 1)) A) ∈ J := hy
    have hyH : ((P (cA.symm (Pi.single μ 1)) : ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A e)) :
        MvPolynomial (Fin (N + 1)) A).IsHomogeneous e := (P (cA.symm (Pi.single μ 1))).2
    rw [SetLike.mem_coe, Submodule.mem_map]
    refine ⟨⟨MvPolynomial.map φ (P (cA.symm (Pi.single μ 1))).1,
      (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (hyH.map φ)⟩, ?_, ?_⟩
    · show MvPolynomial.map φ (P (cA.symm (Pi.single μ 1))).1 ∈ Ideal.span G'
      exact Ideal.subset_span ⟨_, ⟨hyJ, hyH⟩, rfl⟩
    · funext ν
      rw [LinearEquiv.coe_coe, hcK, Matrix.col_apply, Matrix.map_apply, hQcol,
        MvPolynomial.coeff_map, hcA]
  have hle2 : Submodule.map (cK : _ →ₗ[K] (ι → K)) V' ≤
      LinearMap.range (Matrix.toLin' (Q.map φ)) := by
    rintro _ ⟨x, hx, rfl⟩
    have hx' : (x : MvPolynomial (Fin (N + 1)) K) ∈ Ideal.span G' := hx
    obtain ⟨n, f, g, hsum⟩ := Submodule.mem_span_set'.mp hx'
    have hcx : (cK : _ →ₗ[K] (ι → K)) x =
        ∑ i, (f i).coeff 0 • (fun ν : ι => ((g i : MvPolynomial (Fin (N + 1)) K)).coeff ν.1) := by
      funext ν
      rw [LinearEquiv.coe_coe, hcK, ← hsum]
      simp only [MvPolynomial.coeff_sum, smul_eq_mul, Finset.sum_apply, Pi.smul_apply]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      obtain ⟨G, ⟨_, hGH⟩, hG⟩ := (g i).2
      exact hmulc K (f i) _ (hG ▸ hGH.map φ) ν
    rw [hcx]
    refine Submodule.sum_mem _ (fun i _ => Submodule.smul_mem _ _ ?_)
    obtain ⟨G, ⟨hGJ, hGH⟩, hG⟩ := (g i).2
    have hGW : (⟨G, (MvPolynomial.mem_homogeneousSubmodule _ _).mpr hGH⟩ :
        ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A e)) ∈ wcpaDjDeg N J e := hGJ
    refine ⟨⇑φ ∘ cA ⟨G, (MvPolynomial.mem_homogeneousSubmodule _ _).mpr hGH⟩, ?_⟩
    rw [Matrix.toLin'_apply]
    funext ν
    rw [← hcolW _ hGW ν, hcA, ← hG, MvPolynomial.coeff_map]
  have hkey := le_antisymm hle2 hle1
  have hfV : Module.finrank K V' = (Q.map φ).rank := by
    rw [← LinearEquiv.finrank_map_eq cK V', hkey, Matrix.toLin'_apply']
    rfl
  have hfS : Module.finrank K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e) =
      Fintype.card ι := by
    rw [LinearEquiv.finrank_eq cK, Module.finrank_fintype_fun_eq_card]
  have hsum := Submodule.finrank_quotient_add_finrank V'
  rw [hfV, hfS, hrk] at hsum
  show Module.finrank K (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e) ⧸ V') = _
  omega

theorem wcpa_dj_flrg_gen_span : ∀ (A : Type u) [CommRing A] (K : Type u) [Field K] (φ : A →+* K) (N : ℕ) (J : Ideal (MvPolynomial (Fin (N + 1)) A)) (e₁ e : ℕ), e₁ ≤ e → (∀ e', e₁ ≤ e' → e' < e → wcpaDjGen N J e') → wcpaDjHilbFn K N (Ideal.span ((MvPolynomial.map φ) '' {F | F ∈ J ∧ F.IsHomogeneous e₁})) e = wcpaDjHilbFn K N (Ideal.span ((MvPolynomial.map φ) '' {F | F ∈ J ∧ F.IsHomogeneous e})) e :=
by
  intro A _ K _ φ N J e₁ e he hGen
  classical

  have hiter : ∀ n, e₁ ≤ n → n ≤ e → ∀ G ∈ J, G.IsHomogeneous n →
      G ∈ Ideal.span {F | F ∈ J ∧ F.IsHomogeneous e₁} := by
    intro n hn
    induction n, hn using Nat.le_induction with
    | base => intro _ G hG hGh; exact Ideal.subset_span ⟨hG, hGh⟩
    | succ n hn ih =>
      intro hne G hG hGh
      have hgen := hGen n hn (by omega)
      unfold wcpaDjGen at hgen
      have hmem := hgen G hG hGh
      have hle : Submodule.span A {H | ∃ (l : Fin (N + 1)) (G' : MvPolynomial (Fin (N + 1)) A),
          G' ∈ J ∧ G'.IsHomogeneous n ∧ H = MvPolynomial.X l * G'} ≤
          (Ideal.span {F | F ∈ J ∧ F.IsHomogeneous e₁}).restrictScalars A := by
        rw [Submodule.span_le]
        rintro H ⟨l, G', hG', hG'h, rfl⟩
        exact Ideal.mul_mem_left _ _ (ih (by omega) G' hG' hG'h)
      exact hle hmem

  have hshift : ∀ F ∈ J, F.IsHomogeneous e₁ → ∀ q : MvPolynomial (Fin (N + 1)) K,
      q.IsHomogeneous (e - e₁) → q * MvPolynomial.map φ F ∈
        Ideal.span ((MvPolynomial.map φ) '' {F | F ∈ J ∧ F.IsHomogeneous e}) := by
    intro F hF hFh q hq
    rw [q.as_sum, Finset.sum_mul]
    refine Ideal.sum_mem _ (fun μ hμ => ?_)
    have hmon : (MvPolynomial.monomial μ (1 : A)).IsHomogeneous (e - e₁) := by
      intro ν hν
      rw [MvPolynomial.coeff_monomial] at hν
      split_ifs at hν with h
      · rw [← h]; exact hq (MvPolynomial.mem_support_iff.mp hμ)
      · exact absurd rfl hν
    have h1 : MvPolynomial.monomial μ (q.coeff μ) * MvPolynomial.map φ F =
        MvPolynomial.C (q.coeff μ) * MvPolynomial.map φ (MvPolynomial.monomial μ 1 * F) := by
      rw [map_mul, MvPolynomial.map_monomial, map_one, ← mul_assoc, MvPolynomial.C_mul_monomial,
        mul_one]
    rw [h1]
    have hh := hmon.mul hFh
    rw [Nat.sub_add_cancel he] at hh
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨_, ⟨J.mul_mem_left _ hF, hh⟩, rfl⟩)

  have key : ∀ P : MvPolynomial (Fin (N + 1)) K,
      P ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e →
      P ∈ Ideal.span ((MvPolynomial.map φ) '' {F | F ∈ J ∧ F.IsHomogeneous e₁}) →
      P ∈ Ideal.span ((MvPolynomial.map φ) '' {F | F ∈ J ∧ F.IsHomogeneous e}) := by
    intro P hPe hP
    obtain ⟨m, f, g, hfg⟩ := Submodule.mem_span_set'.mp hP
    have hP' : MvPolynomial.homogeneousComponent e P = P := by
      rw [MvPolynomial.homogeneousComponent_of_mem hPe, if_pos rfl]
    rw [← hP', ← hfg, map_sum]
    refine Ideal.sum_mem _ (fun i _ => ?_)
    obtain ⟨F, ⟨hF, hFh⟩, hFeq⟩ := (g i).2
    have hgmem : (g i).1 ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e₁ := by
      rw [← hFeq, MvPolynomial.mem_homogeneousSubmodule]
      exact hFh.map φ
    have hcomp : MvPolynomial.homogeneousComponent e (f i * (g i).1) =
        MvPolynomial.homogeneousComponent (e - e₁) (f i) * (g i).1 := by
      have := DirectSum.coe_decompose_mul_of_right_mem_of_le
        (𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (a := f i) hgmem he
      rw [← MvPolynomial.decomposition.decompose'_apply,
        ← MvPolynomial.decomposition.decompose'_apply]
      exact this
    rw [smul_eq_mul, hcomp, ← hFeq]
    exact hshift F hF hFh _ (MvPolynomial.homogeneousComponent_isHomogeneous _ _)
  have hEq : Submodule.comap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e).subtype
      (Submodule.restrictScalars K
        (Ideal.span ((MvPolynomial.map φ) '' {F | F ∈ J ∧ F.IsHomogeneous e₁}))) =
      Submodule.comap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e).subtype
      (Submodule.restrictScalars K
        (Ideal.span ((MvPolynomial.map φ) '' {F | F ∈ J ∧ F.IsHomogeneous e}))) := by
    ext x
    simp only [Submodule.mem_comap, Submodule.restrictScalars_mem, Submodule.coe_subtype]
    constructor
    · intro hx
      exact key x.1 x.2 hx
    · intro hx
      refine (Ideal.span_le.mpr ?_) hx
      rintro _ ⟨G, ⟨hG, hGh⟩, rfl⟩
      have h2 := Ideal.mem_map_of_mem (MvPolynomial.map φ) (hiter e he le_rfl G hG hGh)
      rwa [Ideal.map_span] at h2
  unfold wcpaDjHilbFn
  rw [hEq]

theorem wcpa_dj_flrg_sat_point : ∀ (k : Type u) [Field k] (N : ℕ) (B Z : Scheme.{u}) (sB : B ⟶ Spec (.of k)) (jZ : Z ⟶ wcProjK k N) (g : Z ⟶ B) (hZ : jZ ≫ wcProjKStr k N = g ≫ sB), IsClosedImmersion (Limits.pullback.lift jZ g hZ) → ∀ (V D : B.Opens) (hDV : D ≤ V) (f : Γ(B, V)) (x : B) (hx : x ∈ D) (e : ℕ), IsAffineOpen V → B.basicOpen f = D → Ideal.span ((MvPolynomial.map (B.presheaf.germ V x (hDV hx) ≫ B.residue x).hom) '' {F | F ∈ wcpaDjFlrgSat k N sB jZ g hZ V ∧ F.IsHomogeneous e}) = Ideal.span ((MvPolynomial.map (B.presheaf.germ D x hx ≫ B.residue x).hom) '' {F | F ∈ wcpaDjFlrgSat k N sB jZ g hZ D ∧ F.IsHomogeneous e}) :=
by
  intro k _ N B Z sB jZ g hZ hε V D hDV f x hx e hV hD
  subst hD
  classical
  set ε := Limits.pullback.lift jZ g hZ with hεdef

  have s1 : ∀ (W : B.Opens) (F : MvPolynomial (Fin (N + 1)) Γ(B, W)),
      F ∈ wcpaDjFlrgSat k N sB jZ g hZ W → ∀ i,
        (ε.app (wcpaDjFlrgChart k N sB W i)).hom (wcpaDjFlrgPsi k N sB W i F) = 0 := by
    intro W F hF i
    have hle : wcpaDjFlrgSat k N sB jZ g hZ W ≤ Ideal.comap (wcpaDjFlrgPsi k N sB W i)
        (RingHom.ker (ε.app (wcpaDjFlrgChart k N sB W i)).hom) := by
      apply Ideal.span_le.mpr
      rintro G ⟨e', _, hG⟩
      exact hG i
    exact RingHom.mem_ker.mp (hle hF)

  have s2 : ∀ (W W' : B.Opens) (hW : W' ≤ W) (i : Fin (N + 1))
      (hle : ε ⁻¹ᵁ wcpaDjFlrgChart k N sB W' i ≤ ε ⁻¹ᵁ wcpaDjFlrgChart k N sB W i)
      (F : MvPolynomial (Fin (N + 1)) Γ(B, W)),
      (ε.app (wcpaDjFlrgChart k N sB W' i)).hom
        (wcpaDjFlrgPsi k N sB W' i (MvPolynomial.map (B.presheaf.map (homOfLE hW).op).hom F)) =
      (Z.presheaf.map (homOfLE hle).op).hom
        ((ε.app (wcpaDjFlrgChart k N sB W i)).hom (wcpaDjFlrgPsi k N sB W i F)) := by
    intro W W' hW i hle F
    have hC : wcpaDjFlrgChart k N sB W' i ≤ wcpaDjFlrgChart k N sB W i :=
      inf_le_inf_left _ (Scheme.Hom.preimage_mono _ hW)
    have hnat : (wcpaDjFlrgPsi k N sB W' i).comp
        (MvPolynomial.map (B.presheaf.map (homOfLE hW).op).hom) =
        ((Limits.pullback (wcProjKStr k N) sB).presheaf.map (homOfLE hC).op).hom.comp
          (wcpaDjFlrgPsi k N sB W i) := by
      apply MvPolynomial.ringHom_ext
      · intro r
        have e1 := Scheme.Hom.map_appLE (Limits.pullback.snd (wcProjKStr k N) sB)
          (V := wcpaDjFlrgChart k N sB W' i)
          (inf_le_right : wcpaDjFlrgChart k N sB W' i ≤ _) (homOfLE hW).op
        have e2 := Scheme.Hom.appLE_map (Limits.pullback.snd (wcProjKStr k N) sB) (U := W)
          (inf_le_right : wcpaDjFlrgChart k N sB W i ≤ _) (homOfLE hC).op
        have f1 := congrArg (fun φ => φ.hom r) e1
        have f2 := congrArg (fun φ => φ.hom r) e2
        simp only [CommRingCat.hom_comp, RingHom.comp_apply] at f1 f2
        simp only [RingHom.comp_apply, MvPolynomial.map_C, wcpaDjFlrgPsi, MvPolynomial.eval₂Hom_C]
        exact f1.trans f2.symm
      · intro l
        have e2 := Scheme.Hom.appLE_map (Limits.pullback.fst (wcProjKStr k N) sB)
          (U := wcSgD k N i)
          (inf_le_left : wcpaDjFlrgChart k N sB W i ≤ _) (homOfLE hC).op
        have f2 := congrArg (fun φ => φ.hom (wcSgE k N i l)) e2
        simp only [CommRingCat.hom_comp, RingHom.comp_apply] at f2
        simp only [RingHom.comp_apply, MvPolynomial.map_X, wcpaDjFlrgPsi, MvPolynomial.eval₂Hom_X']
        exact f2.symm
    have h1 : wcpaDjFlrgPsi k N sB W' i (MvPolynomial.map (B.presheaf.map (homOfLE hW).op).hom F) =
        ((Limits.pullback (wcProjKStr k N) sB).presheaf.map (homOfLE hC).op).hom
          (wcpaDjFlrgPsi k N sB W i F) := RingHom.congr_fun hnat F
    rw [h1]
    have h2 := Scheme.Hom.naturality ε (homOfLE hC).op
    have h3 := congrArg (fun φ => φ.hom (wcpaDjFlrgPsi k N sB W i F)) h2
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h3
    exact h3

  have s3 : ∀ {A A' : Type u} [CommRing A] [CommRing A'] (ρ : A →+* A') (f : A),
      (∀ a' : A', ∃ (n : ℕ) (a : A), ρ a = ρ f ^ n * a') →
      ∀ (G : MvPolynomial (Fin (N + 1)) A') (e : ℕ), G.IsHomogeneous e →
      ∃ (n : ℕ) (F : MvPolynomial (Fin (N + 1)) A), F.IsHomogeneous e ∧
        MvPolynomial.map ρ F = MvPolynomial.C (ρ f ^ n) * G := by
    intro A A' _ _ ρ f hloc G e hG
    choose nf af haf using hloc
    obtain ⟨n, hn⟩ : ∃ n, ∀ d ∈ G.support, nf (G.coeff d) ≤ n :=
      ⟨G.support.sup (fun d => nf (G.coeff d)),
        fun d hd => Finset.le_sup (f := fun d => nf (G.coeff d)) hd⟩
    refine ⟨n, ∑ d ∈ G.support,
      MvPolynomial.monomial d (f ^ (n - nf (G.coeff d)) * af (G.coeff d)), ?_, ?_⟩
    · apply MvPolynomial.IsHomogeneous.sum
      intro d hd
      apply MvPolynomial.isHomogeneous_monomial
      by_contra hne
      exact (MvPolynomial.mem_support_iff.mp hd) (hG.coeff_eq_zero hne)
    · rw [map_sum]
      conv_rhs => rw [G.as_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun d hd => ?_)
      rw [MvPolynomial.map_monomial, MvPolynomial.C_mul_monomial, map_mul, map_pow, haf,
        ← mul_assoc, ← pow_add, Nat.sub_add_cancel (hn d hd)]

  have chartAff : ∀ (S X Y : Scheme.{u}) [IsAffine S] (f : X ⟶ S) (g : Y ⟶ S)
      (U : X.Opens) (C : Y.Opens), IsAffineOpen U → IsAffineOpen C →
      IsAffineOpen ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (Limits.pullback.snd f g) ⁻¹ᵁ C) := by
    intro S X Y _ f g U C hU hC
    have hP : IsPullback
        ((Limits.pullback.fst f g).resLE U ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓
          (Limits.pullback.snd f g) ⁻¹ᵁ C) inf_le_left)
        ((Limits.pullback.snd f g).resLE C ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓
          (Limits.pullback.snd f g) ⁻¹ᵁ C) inf_le_right)
        (U.ι ≫ f) (C.ι ≫ g) := by
      have comm : (Limits.pullback.fst f g).resLE U ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓
          (Limits.pullback.snd f g) ⁻¹ᵁ C) inf_le_left ≫ (U.ι ≫ f) =
          (Limits.pullback.snd f g).resLE C ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓
          (Limits.pullback.snd f g) ⁻¹ᵁ C) inf_le_right ≫ (C.ι ≫ g) := by
        rw [← Category.assoc, Scheme.Hom.resLE_comp_ι, ← Category.assoc, Scheme.Hom.resLE_comp_ι,
          Category.assoc, Category.assoc, Limits.pullback.condition]
      have hc : ∀ (s : Limits.PullbackCone (U.ι ≫ f) (C.ι ≫ g)),
          (s.fst ≫ U.ι) ≫ f = (s.snd ≫ C.ι) ≫ g := by
        intro s
        rw [Category.assoc, Category.assoc]
        exact s.condition
      have hrange : ∀ (s : Limits.PullbackCone (U.ι ≫ f) (C.ι ≫ g)),
          Set.range (Limits.pullback.lift (s.fst ≫ U.ι) (s.snd ≫ C.ι) (hc s)) ⊆
            Set.range ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (Limits.pullback.snd f g) ⁻¹ᵁ C).ι := by
        intro s
        rw [Scheme.Opens.range_ι]
        rintro _ ⟨x, rfl⟩
        refine ⟨?_, ?_⟩
        · show (Limits.pullback.fst f g) (Limits.pullback.lift (s.fst ≫ U.ι) (s.snd ≫ C.ι) (hc s) x) ∈ U
          rw [← Scheme.Hom.comp_apply, Limits.pullback.lift_fst, Scheme.Hom.comp_apply]
          have h : U.ι (s.fst x) ∈ Set.range U.ι := ⟨_, rfl⟩
          rwa [Scheme.Opens.range_ι] at h
        · show (Limits.pullback.snd f g) (Limits.pullback.lift (s.fst ≫ U.ι) (s.snd ≫ C.ι) (hc s) x) ∈ C
          rw [← Scheme.Hom.comp_apply, Limits.pullback.lift_snd, Scheme.Hom.comp_apply]
          have h : C.ι (s.snd x) ∈ Set.range C.ι := ⟨_, rfl⟩
          rwa [Scheme.Opens.range_ι] at h
      refine IsPullback.of_isLimit (c := Limits.PullbackCone.mk _ _ comm) ?_
      refine Limits.PullbackCone.IsLimit.mk comm
        (fun s => IsOpenImmersion.lift _ _ (hrange s)) ?_ ?_ ?_
      · intro s
        rw [← cancel_mono U.ι, Category.assoc, Scheme.Hom.resLE_comp_ι, ← Category.assoc,
          IsOpenImmersion.lift_fac, Limits.pullback.lift_fst]
      · intro s
        rw [← cancel_mono C.ι, Category.assoc, Scheme.Hom.resLE_comp_ι, ← Category.assoc,
          IsOpenImmersion.lift_fac, Limits.pullback.lift_snd]
      · intro s m h1 h2
        apply IsOpenImmersion.lift_uniq
        apply Limits.pullback.hom_ext
        · rw [Limits.pullback.lift_fst, ← h1, Category.assoc, Category.assoc, Scheme.Hom.resLE_comp_ι]
        · rw [Limits.pullback.lift_snd, ← h2, Category.assoc, Category.assoc, Scheme.Hom.resLE_comp_ι]
    haveI : IsAffine (U : Scheme.{u}) := hU
    haveI : IsAffine (C : Scheme.{u}) := hC
    exact IsAffine.of_isIso hP.isoPullback.hom

  have s4 : ∀ i : Fin (N + 1), Z.basicOpen ((ε.app (wcpaDjFlrgChart k N sB V i)).hom
      (wcpaDjFlrgPsi k N sB V i (MvPolynomial.C f))) =
      ε ⁻¹ᵁ wcpaDjFlrgChart k N sB (B.basicOpen f) i := by
    intro i
    rw [← Scheme.preimage_basicOpen]
    congr 1
    unfold wcpaDjFlrgPsi
    rw [MvPolynomial.eval₂Hom_C, Scheme.basicOpen_appLE]
    dsimp only [wcpaDjFlrgChart]
    rw [inf_assoc, inf_eq_right.mpr (Scheme.Hom.preimage_mono _ (B.basicOpen_le f))]

  have resTrans : ∀ (W1 W2 W3 : Z.Opens) (h12 : W1 ≤ W2) (h23 : W2 ≤ W3) (s : Γ(Z, W3)),
      (Z.presheaf.map (homOfLE (h12.trans h23)).op).hom s =
        (Z.presheaf.map (homOfLE h12).op).hom ((Z.presheaf.map (homOfLE h23).op).hom s) := by
    intro W1 W2 W3 h12 h23 s
    change _ = (Z.presheaf.map (homOfLE h23).op ≫ Z.presheaf.map (homOfLE h12).op).hom s
    rw [← Functor.map_comp]
    rfl

  have hU : ∀ i : Fin (N + 1), IsAffineOpen (wcSgD k N i) := fun i =>
    @Proj.isAffineOpen_basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      MvPolynomial.gradedAlgebra (MvPolynomial.X i) 1
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k i)) one_pos
  haveI := hε
  have hO : ∀ i : Fin (N + 1), IsAffineOpen (ε ⁻¹ᵁ wcpaDjFlrgChart k N sB V i) := fun i =>
    (chartAff (Spec (.of k)) (wcProjK k N) B (wcProjKStr k N) sB (wcSgD k N i) V (hU i) hV).preimage ε

  have hφρ : (B.presheaf.germ (B.basicOpen f) x hx ≫ B.residue x).hom.comp
      (B.presheaf.map (homOfLE hDV).op).hom = (B.presheaf.germ V x (hDV hx) ≫ B.residue x).hom := by
    rw [← CommRingCat.hom_comp, ← Category.assoc, TopCat.Presheaf.germ_res]
  set φV := (B.presheaf.germ V x (hDV hx) ≫ B.residue x).hom with hφV
  set φD := (B.presheaf.germ (B.basicOpen f) x hx ≫ B.residue x).hom with hφD
  have hle : ∀ i : Fin (N + 1), ε ⁻¹ᵁ wcpaDjFlrgChart k N sB (B.basicOpen f) i ≤
      ε ⁻¹ᵁ wcpaDjFlrgChart k N sB V i := fun i =>
    Scheme.Hom.preimage_mono ε (inf_le_inf_left _ (Scheme.Hom.preimage_mono _ hDV))
  apply le_antisymm
  ·
    apply Ideal.span_le.mpr
    rintro _ ⟨F, ⟨hF, hFe⟩, rfl⟩
    apply Ideal.subset_span
    have hFD : MvPolynomial.map (B.presheaf.map (homOfLE hDV).op).hom F ∈
        wcpaDjFlrgSat k N sB jZ g hZ (B.basicOpen f) := by
      apply Ideal.subset_span
      refine ⟨e, hFe.map _, fun i => ?_⟩
      rw [RingHom.mem_ker]
      rw [s2 V (B.basicOpen f) hDV i (hle i) F, s1 V F hF i, map_zero]
    refine ⟨MvPolynomial.map (B.presheaf.map (homOfLE hDV).op).hom F, ⟨hFD, hFe.map _⟩, ?_⟩
    rw [MvPolynomial.map_map, hφρ]
  ·
    apply Ideal.span_le.mpr
    rintro _ ⟨G, ⟨hG, hGe⟩, rfl⟩
    have hloc : ∀ a' : Γ(B, B.basicOpen f), ∃ (n : ℕ) (a : Γ(B, V)),
        (B.presheaf.map (homOfLE hDV).op).hom a = (B.presheaf.map (homOfLE hDV).op).hom f ^ n * a' := by
      intro a'
      obtain ⟨n, y, hy⟩ := exists_eq_pow_mul_of_isAffineOpen B V hV f a'
      exact ⟨n, y, hy⟩
    obtain ⟨n, F', hF'e, hF'⟩ := s3 (B.presheaf.map (homOfLE hDV).op).hom f hloc G e hGe
    have hkill : ∀ i : Fin (N + 1), ∃ t : ℕ,
        (ε.app (wcpaDjFlrgChart k N sB V i)).hom (wcpaDjFlrgPsi k N sB V i (MvPolynomial.C f)) ^ t *
          (ε.app (wcpaDjFlrgChart k N sB V i)).hom (wcpaDjFlrgPsi k N sB V i F') = 0 := by
      intro i
      apply exists_pow_mul_eq_zero_of_res_basicOpen_eq_zero_of_isAffineOpen Z (hO i)
      have hres : (Z.presheaf.map (homOfLE (hle i)).op).hom
          ((ε.app (wcpaDjFlrgChart k N sB V i)).hom (wcpaDjFlrgPsi k N sB V i F')) = 0 := by
        rw [← s2 V (B.basicOpen f) hDV i (hle i) F', hF', map_mul, map_mul, s1 _ G hG i, mul_zero]
      show (Z.presheaf.map (homOfLE _).op).hom _ = 0
      rw [resTrans _ _ _ (s4 i).le (hle i), hres, map_zero]
    choose t ht using hkill
    obtain ⟨T, hT⟩ : ∃ T, ∀ i, t i ≤ T :=
      ⟨Finset.univ.sup t, fun i => Finset.le_sup (Finset.mem_univ i)⟩
    have hFhom : (MvPolynomial.C (f ^ T) * F').IsHomogeneous e := by
      have h := (MvPolynomial.isHomogeneous_C (Fin (N + 1)) (f ^ T)).mul hF'e
      rwa [zero_add] at h
    have hFsat : MvPolynomial.C (f ^ T) * F' ∈ wcpaDjFlrgSat k N sB jZ g hZ V := by
      apply Ideal.subset_span
      refine ⟨e, hFhom, fun i => ?_⟩
      rw [RingHom.mem_ker, map_mul, map_mul, MvPolynomial.C_pow, map_pow, map_pow,
        ← Nat.sub_add_cancel (hT i), pow_add, mul_assoc, ht i, mul_zero]
    have hu : IsUnit (φV f) := by
      show IsUnit ((B.residue x).hom ((B.presheaf.germ V x (hDV hx)).hom f))
      exact ((Scheme.mem_basicOpen B f x (hDV hx)).mp hx).map _
    have hc : φV f ≠ 0 := hu.ne_zero
    have e1 : MvPolynomial.map φV F' = MvPolynomial.C (φV f ^ n) * MvPolynomial.map φD G := by
      rw [← hφρ, ← MvPolynomial.map_map, hF', map_mul, MvPolynomial.map_C, map_pow φD,
        RingHom.comp_apply]
    have hmem : MvPolynomial.map φV (MvPolynomial.C (f ^ T) * F') ∈
        Ideal.span ((MvPolynomial.map φV) ''
          {F | F ∈ wcpaDjFlrgSat k N sB jZ g hZ V ∧ F.IsHomogeneous e}) :=
      Ideal.subset_span ⟨_, ⟨hFsat, hFhom⟩, rfl⟩
    have key : MvPolynomial.map φD G = MvPolynomial.C ((φV f ^ T * φV f ^ n)⁻¹) *
        MvPolynomial.map φV (MvPolynomial.C (f ^ T) * F') := by
      rw [map_mul, MvPolynomial.map_C, e1, map_pow φV f T, ← mul_assoc, ← MvPolynomial.C_mul,
        ← mul_assoc, ← MvPolynomial.C_mul, mul_assoc (φV f ^ T * φV f ^ n)⁻¹,
        inv_mul_cancel₀ (mul_ne_zero (pow_ne_zero _ hc) (pow_ne_zero _ hc)), MvPolynomial.C_1,
        one_mul]
    rw [key]
    exact Ideal.mul_mem_left _ _ hmem

theorem wcpa_dj_flrg_hom_finrank : ∀ (K : Type u) [Field K] (N e : ℕ), Module.Finite K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e) ∧ Module.finrank K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e) = Nat.card {d : Fin (N + 1) →₀ ℕ // d.degree = e} :=
by
  intro K _ N e
  classical
  let S : Set (Fin (N + 1) →₀ ℕ) := {d | d.degree = e}
  have hS : S.Finite :=
    (Finsupp.finite_of_degree_le (σ := Fin (N + 1)) e).subset (fun d hd => le_of_eq hd)
  have : Finite ↥S := Set.finite_coe_iff.mpr hS
  have heq := MvPolynomial.homogeneousSubmodule_eq_finsupp_supported (Fin (N + 1)) K e
  let φ : ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e) ≃ₗ[K] (↥S →₀ K) :=
    (LinearEquiv.ofEq _ _ heq).trans (AddMonoidAlgebra.supportedEquivFinsupp S)
  let b : Module.Basis ↥S K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e) :=
    (Finsupp.basisSingleOne).map φ.symm
  refine ⟨Module.Finite.of_basis b, ?_⟩
  rw [Module.finrank_eq_nat_card_basis b]
  rfl

theorem wcpa_dj_flrg_numerics : ∀ (k : Type u) [Field k] (N : ℕ) (B Z : Scheme.{u}) (sB : B ⟶ Spec (.of k)) (jZ : Z ⟶ wcProjK k N) (g : Z ⟶ B) (hZ : jZ ≫ wcProjKStr k N = g ≫ sB), IsClosedImmersion (Limits.pullback.lift jZ g hZ) → AlgebraicGeometry.IsIntegral B → ∀ (m : ℕ) (V : Fin m → B.Opens) (E : ℕ), 1 ≤ E → (∀ j, IsAffineOpen (V j)) → (⨆ j, V j) = ⊤ → (∀ j e, E ≤ e → Module.Projective Γ(B, V j) (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Γ(B, V j) e) ⧸ wcpaDjDeg N (wcpaDjFlrgSat k N sB jZ g hZ (V j)) e) ∧ wcpaDjGen N (wcpaDjFlrgSat k N sB jZ g hZ (V j)) e) → ∃ (e₀ r : ℕ) (Φ : ℕ → ℕ), E ≤ e₀ ∧ (1 ≤ e₀ ∧ Φ e₀ + r = Module.finrank k (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k e₀) ∧ ∀ e, e₀ ≤ e → Φ (e + 1) = wcpaDjMacUp e (Φ e)) ∧ ∀ (j : Fin m) (p : B) (hp : p ∈ V j) (e : ℕ), e₀ ≤ e → wcpaDjHilbFn (B.residueField p) N (Ideal.span ((MvPolynomial.map (B.presheaf.germ (V j) p hp ≫ B.residue p).hom) '' {F | F ∈ wcpaDjFlrgSat k N sB jZ g hZ (V j) ∧ F.IsHomogeneous e₀})) e = Φ e :=
by
  intro k _ N B Z sB jZ g hZ hε hB m V E hE1 hVaff hVcov hVproj
  classical
  haveI := hB

  obtain ⟨η, hηgen⟩ : ∃ η : B, IsGenericPoint η Set.univ := ⟨_, genericPoint_spec B⟩
  have hmem : ∀ (W : B.Opens) (p : B), p ∈ W → η ∈ W := fun W p hp =>
    (hηgen.mem_open_set_iff W.isOpen).mpr ⟨p, Set.mem_univ _, hp⟩
  have hηtop : η ∈ (⨆ j, V j) := by rw [hVcov]; trivial
  obtain ⟨j₀, hj₀⟩ := TopologicalSpace.Opens.mem_iSup.mp hηtop

  obtain ⟨Φ, hΦ⟩ : ∃ Φ : ℕ → ℕ, ∀ e, Φ e = wcpaDjHilbFn (B.residueField η) N
      (Ideal.span ((MvPolynomial.map (B.presheaf.germ (V j₀) η hj₀ ≫ B.residue η).hom) ''
        {F | F ∈ wcpaDjFlrgSat k N sB jZ g hZ (V j₀) ∧ F.IsHomogeneous e})) e :=
    ⟨_, fun e => rfl⟩

  have hchart : ∀ (j : Fin m) (hj : η ∈ V j) (e : ℕ), wcpaDjHilbFn (B.residueField η) N
      (Ideal.span ((MvPolynomial.map (B.presheaf.germ (V j) η hj ≫ B.residue η).hom) ''
        {F | F ∈ wcpaDjFlrgSat k N sB jZ g hZ (V j) ∧ F.IsHomogeneous e})) e = Φ e := by
    intro j hj e
    rw [hΦ e]
    have hηinf : η ∈ V j ⊓ V j₀ := by
      first
      | exact ⟨hj, hj₀⟩
      | exact TopologicalSpace.Opens.mem_inf.mpr ⟨hj, hj₀⟩
      | simp [hj, hj₀]
    obtain ⟨f, g', hfg, hηf⟩ := exists_basicOpen_le_affine_inter (hVaff j) (hVaff j₀) η hηinf
    have hle₀ : B.basicOpen f ≤ V j₀ := by rw [hfg]; exact B.basicOpen_le g'
    have h1 := wcpa_dj_flrg_sat_point k N B Z sB jZ g hZ hε (V j) (B.basicOpen f)
      (B.basicOpen_le f) f η hηf e (hVaff j) rfl
    have h2 := wcpa_dj_flrg_sat_point k N B Z sB jZ g hZ hε (V j₀) (B.basicOpen f)
      hle₀ g' η hηf e (hVaff j₀) hfg.symm
    have key : Ideal.span ((MvPolynomial.map (B.presheaf.germ (V j) η hj ≫ B.residue η).hom) ''
          {F | F ∈ wcpaDjFlrgSat k N sB jZ g hZ (V j) ∧ F.IsHomogeneous e}) =
        Ideal.span ((MvPolynomial.map (B.presheaf.germ (V j₀) η hj₀ ≫ B.residue η).hom) ''
          {F | F ∈ wcpaDjFlrgSat k N sB jZ g hZ (V j₀) ∧ F.IsHomogeneous e}) :=
      h1.trans h2.symm
    rw [key]

  have hK : ∀ (j : Fin m) (p : B) (hp : p ∈ V j) (e : ℕ), E ≤ e →
      wcpaDjHilbFn (B.residueField p) N
        (Ideal.span ((MvPolynomial.map (B.presheaf.germ (V j) p hp ≫ B.residue p).hom) ''
          {F | F ∈ wcpaDjFlrgSat k N sB jZ g hZ (V j) ∧ F.IsHomogeneous e})) e = Φ e := by
    intro j p hp e he
    haveI hdom : IsDomain Γ(B, V j) :=
      @AlgebraicGeometry.IsIntegral.component_integral B hB (V j) ⟨⟨p, hp⟩⟩
    obtain ⟨ρ, hρ⟩ := wcpa_dj_flrg_fibre_rank Γ(B, V j) N e
      (wcpaDjFlrgSat k N sB jZ g hZ (V j)) (hVproj j e he).1
    have hjη : η ∈ V j := hmem (V j) p hp
    have a1 := hρ (B.residueField p) (B.presheaf.germ (V j) p hp ≫ B.residue p).hom
    have a2 := hρ (B.residueField η) (B.presheaf.germ (V j) η hjη ≫ B.residue η).hom
    have a3 := hchart j hjη e
    exact a1.trans (a2.symm.trans a3)

  have hK' : ∀ (j : Fin m) (p : B) (hp : p ∈ V j) (e₁ e : ℕ), E ≤ e₁ → e₁ ≤ e →
      wcpaDjHilbFn (B.residueField p) N
        (Ideal.span ((MvPolynomial.map (B.presheaf.germ (V j) p hp ≫ B.residue p).hom) ''
          {F | F ∈ wcpaDjFlrgSat k N sB jZ g hZ (V j) ∧ F.IsHomogeneous e₁})) e = Φ e := by
    intro j p hp e₁ e h1 h2
    have s := wcpa_dj_flrg_gen_span Γ(B, V j) (B.residueField p)
      (B.presheaf.germ (V j) p hp ≫ B.residue p).hom N (wcpaDjFlrgSat k N sB jZ g hZ (V j))
      e₁ e h2 (fun e' he' _ => (hVproj j e' (le_trans h1 he')).2)
    exact s.trans (hK j p hp e (le_trans h1 h2))

  have hgrow : ∀ e, E ≤ e → Φ (e + 1) ≤ wcpaDjMacUp e (Φ e) := by
    intro e he
    obtain ⟨U, T, hUdeg, hUcard, hT, hTcard⟩ := wcpa_dj_flrg_lead_monomials (B.residueField η) N e
      (Ideal.span ((MvPolynomial.map (B.presheaf.germ (V j₀) η hj₀ ≫ B.residue η).hom) ''
        {F | F ∈ wcpaDjFlrgSat k N sB jZ g hZ (V j₀) ∧ F.IsHomogeneous E}))
    have hmac := wcpa_dj_flrg_macaulay_comb N e U T (le_trans hE1 he) hUdeg hT
    have hKe := hK' j₀ η hj₀ E e le_rfl he
    have hKe1 := hK' j₀ η hj₀ E (e + 1) le_rfl (by omega)
    have hU' : U.card = Φ e := hUcard.trans hKe
    calc Φ (e + 1) ≤ T.card := hKe1.symm.trans_le hTcard
      _ ≤ wcpaDjMacUp e U.card := hmac
      _ = wcpaDjMacUp e (Φ e) := by rw [hU']

  obtain ⟨D, hED, hD⟩ := wcpa_dj_flrg_gotzmann_descent Φ E hE1 hgrow

  have hle : Φ D ≤ Module.finrank k (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k D) := by
    obtain ⟨hfin1, hr1⟩ := wcpa_dj_flrg_hom_finrank (B.residueField η) N D
    obtain ⟨_, hr2⟩ := wcpa_dj_flrg_hom_finrank k N D
    haveI := hfin1
    rw [hr2, ← hr1, hΦ D]
    unfold wcpaDjHilbFn
    exact Submodule.finrank_quotient_le _
  refine ⟨D, Module.finrank k (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k D) - Φ D, Φ,
    hED, ⟨by omega, by omega, hD⟩, ?_⟩
  intro j p hp e he
  exact hK' j p hp D e hED he

theorem wcpa_dj_flrg_gc_sat_restrict : ∀ (k : Type u) [Field k] (N : ℕ) (B Z : Scheme.{u}) (sB : B ⟶ Spec (.of k)) (jZ : Z ⟶ wcProjK k N) (g : Z ⟶ B) (hZ : jZ ≫ wcProjKStr k N = g ≫ sB) (V W : B.Opens) (h : W ≤ V) (F : MvPolynomial (Fin (N + 1)) Γ(B, V)), F ∈ wcpaDjFlrgSat k N sB jZ g hZ V → MvPolynomial.map (B.presheaf.map (homOfLE h).op).hom F ∈ wcpaDjFlrgSat k N sB jZ g hZ W :=
by
  intro k _ N B Z sB jZ g hZ V W h F hF
  classical
  have hgen : ∀ G ∈ {F : MvPolynomial (Fin (N + 1)) Γ(B, V) | ∃ e, F.IsHomogeneous e ∧
      ∀ i, wcpaDjFlrgPsi k N sB V i F ∈
        RingHom.ker ((Limits.pullback.lift jZ g hZ).app (wcpaDjFlrgChart k N sB V i)).hom},
      G ∈ Ideal.comap (MvPolynomial.map (B.presheaf.map (homOfLE h).op).hom)
        (wcpaDjFlrgSat k N sB jZ g hZ W) := by
    rintro G ⟨e, hGe, hGk⟩
    rw [Ideal.mem_comap]
    apply Ideal.subset_span
    refine ⟨e, hGe.map _, fun i => ?_⟩
    have hC : wcpaDjFlrgChart k N sB W i ≤ wcpaDjFlrgChart k N sB V i :=
      inf_le_inf_left _ (Scheme.Hom.preimage_mono _ h)
    have hnat : (wcpaDjFlrgPsi k N sB W i).comp
        (MvPolynomial.map (B.presheaf.map (homOfLE h).op).hom) =
        ((Limits.pullback (wcProjKStr k N) sB).presheaf.map (homOfLE hC).op).hom.comp
          (wcpaDjFlrgPsi k N sB V i) := by
      apply MvPolynomial.ringHom_ext
      · intro r
        have e1 := Scheme.Hom.map_appLE (Limits.pullback.snd (wcProjKStr k N) sB)
          (V := wcpaDjFlrgChart k N sB W i)
          (inf_le_right : wcpaDjFlrgChart k N sB W i ≤ _) (homOfLE h).op
        have e2 := Scheme.Hom.appLE_map (Limits.pullback.snd (wcProjKStr k N) sB) (U := V)
          (inf_le_right : wcpaDjFlrgChart k N sB V i ≤ _) (homOfLE hC).op
        have f1 := congrArg (fun φ => φ.hom r) e1
        have f2 := congrArg (fun φ => φ.hom r) e2
        simp only [CommRingCat.hom_comp, RingHom.comp_apply] at f1 f2
        simp only [RingHom.comp_apply, MvPolynomial.map_C, wcpaDjFlrgPsi, MvPolynomial.eval₂Hom_C]
        exact f1.trans f2.symm
      · intro l
        have e2 := Scheme.Hom.appLE_map (Limits.pullback.fst (wcProjKStr k N) sB)
          (U := wcSgD k N i)
          (inf_le_left : wcpaDjFlrgChart k N sB V i ≤ _) (homOfLE hC).op
        have f2 := congrArg (fun φ => φ.hom (wcSgE k N i l)) e2
        simp only [CommRingCat.hom_comp, RingHom.comp_apply] at f2
        simp only [RingHom.comp_apply, MvPolynomial.map_X, wcpaDjFlrgPsi, MvPolynomial.eval₂Hom_X']
        exact f2.symm
    have h1 : wcpaDjFlrgPsi k N sB W i (MvPolynomial.map (B.presheaf.map (homOfLE h).op).hom G) =
        ((Limits.pullback (wcProjKStr k N) sB).presheaf.map (homOfLE hC).op).hom
          (wcpaDjFlrgPsi k N sB V i G) := RingHom.congr_fun hnat G
    rw [RingHom.mem_ker, h1]
    have h2 := Scheme.Hom.naturality (Limits.pullback.lift jZ g hZ) (homOfLE hC).op
    have h3 := congrArg (fun φ => φ.hom (wcpaDjFlrgPsi k N sB V i G)) h2
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h3
    rw [h3, RingHom.mem_ker.mp (hGk i), map_zero]
  have hle : wcpaDjFlrgSat k N sB jZ g hZ V ≤
      Ideal.comap (MvPolynomial.map (B.presheaf.map (homOfLE h).op).hom)
        (wcpaDjFlrgSat k N sB jZ g hZ W) :=
    Ideal.span_le.mpr hgen
  exact hle hF

theorem wcpa_dj_flrg_gc_sat_basicOpen_lift : ∀ (k : Type u) [Field k] (N : ℕ) (B Z : Scheme.{u}) (sB : B ⟶ Spec (.of k)) (jZ : Z ⟶ wcProjK k N) (g : Z ⟶ B) (hZ : jZ ≫ wcProjKStr k N = g ≫ sB), IsClosedImmersion (Limits.pullback.lift jZ g hZ) → ∀ (V : B.Opens), IsAffineOpen V → ∀ (f : Γ(B, V)) (e : ℕ) (G : MvPolynomial (Fin (N + 1)) Γ(B, B.basicOpen f)), G ∈ wcpaDjFlrgSat k N sB jZ g hZ (B.basicOpen f) → G.IsHomogeneous e → ∃ (u : Γ(B, B.basicOpen f)) (F₀ : MvPolynomial (Fin (N + 1)) Γ(B, V)), IsUnit u ∧ F₀ ∈ wcpaDjFlrgSat k N sB jZ g hZ V ∧ F₀.IsHomogeneous e ∧ MvPolynomial.map (B.presheaf.map (homOfLE (B.basicOpen_le f)).op).hom F₀ = MvPolynomial.C u * G :=
by
  intro k _ N B Z sB jZ g hZ hε V hV f e G hG hGe
  classical
  haveI := hε

  have chart_aff : ∀ (S X Y : Scheme.{u}) [IsAffine S] (f : X ⟶ S) (g : Y ⟶ S) (U : X.Opens)
      (C : Y.Opens), IsAffineOpen U → IsAffineOpen C →
      IsAffineOpen ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (Limits.pullback.snd f g) ⁻¹ᵁ C) := by
    intro S X Y _ f g U C hU hC
    have hP : IsPullback
        ((Limits.pullback.fst f g).resLE U ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓
          (Limits.pullback.snd f g) ⁻¹ᵁ C) inf_le_left)
        ((Limits.pullback.snd f g).resLE C ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓
          (Limits.pullback.snd f g) ⁻¹ᵁ C) inf_le_right)
        (U.ι ≫ f) (C.ι ≫ g) := by
      have comm : (Limits.pullback.fst f g).resLE U ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓
          (Limits.pullback.snd f g) ⁻¹ᵁ C) inf_le_left ≫ (U.ι ≫ f) =
          (Limits.pullback.snd f g).resLE C ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓
          (Limits.pullback.snd f g) ⁻¹ᵁ C) inf_le_right ≫ (C.ι ≫ g) := by
        rw [← Category.assoc, Scheme.Hom.resLE_comp_ι, ← Category.assoc, Scheme.Hom.resLE_comp_ι,
          Category.assoc, Category.assoc, Limits.pullback.condition]
      have hc : ∀ (s : Limits.PullbackCone (U.ι ≫ f) (C.ι ≫ g)),
          (s.fst ≫ U.ι) ≫ f = (s.snd ≫ C.ι) ≫ g := by
        intro s
        rw [Category.assoc, Category.assoc]
        exact s.condition
      have hrange : ∀ (s : Limits.PullbackCone (U.ι ≫ f) (C.ι ≫ g)),
          Set.range (Limits.pullback.lift (s.fst ≫ U.ι) (s.snd ≫ C.ι) (hc s)) ⊆
            Set.range ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (Limits.pullback.snd f g) ⁻¹ᵁ C).ι := by
        intro s
        rw [Scheme.Opens.range_ι]
        rintro _ ⟨x, rfl⟩
        refine ⟨?_, ?_⟩
        · show (Limits.pullback.fst f g) (Limits.pullback.lift (s.fst ≫ U.ι) (s.snd ≫ C.ι) (hc s) x) ∈ U
          rw [← Scheme.Hom.comp_apply, Limits.pullback.lift_fst, Scheme.Hom.comp_apply]
          have h : U.ι (s.fst x) ∈ Set.range U.ι := ⟨_, rfl⟩
          rwa [Scheme.Opens.range_ι] at h
        · show (Limits.pullback.snd f g) (Limits.pullback.lift (s.fst ≫ U.ι) (s.snd ≫ C.ι) (hc s) x) ∈ C
          rw [← Scheme.Hom.comp_apply, Limits.pullback.lift_snd, Scheme.Hom.comp_apply]
          have h : C.ι (s.snd x) ∈ Set.range C.ι := ⟨_, rfl⟩
          rwa [Scheme.Opens.range_ι] at h
      refine IsPullback.of_isLimit (c := Limits.PullbackCone.mk _ _ comm) ?_
      refine Limits.PullbackCone.IsLimit.mk comm
        (fun s => IsOpenImmersion.lift _ _ (hrange s)) ?_ ?_ ?_
      · intro s
        rw [← cancel_mono U.ι, Category.assoc, Scheme.Hom.resLE_comp_ι, ← Category.assoc,
          IsOpenImmersion.lift_fac, Limits.pullback.lift_fst]
      · intro s
        rw [← cancel_mono C.ι, Category.assoc, Scheme.Hom.resLE_comp_ι, ← Category.assoc,
          IsOpenImmersion.lift_fac, Limits.pullback.lift_snd]
      · intro s m h1 h2
        apply IsOpenImmersion.lift_uniq
        apply Limits.pullback.hom_ext
        · rw [Limits.pullback.lift_fst, ← h1, Category.assoc, Category.assoc, Scheme.Hom.resLE_comp_ι]
        · rw [Limits.pullback.lift_snd, ← h2, Category.assoc, Category.assoc, Scheme.Hom.resLE_comp_ι]
    haveI : IsAffine (U : Scheme.{u}) := hU
    haveI : IsAffine (C : Scheme.{u}) := hC
    exact IsAffine.of_isIso hP.isoPullback.hom

  have clear : ∀ {A A' : Type u} [CommRing A] [CommRing A'] [Algebra A A'] (r : A)
      [IsLocalization.Away r A'] (H : MvPolynomial (Fin (N + 1)) A'), H.IsHomogeneous e →
      ∃ (a : ℕ) (H₀ : MvPolynomial (Fin (N + 1)) A), H₀.IsHomogeneous e ∧
        MvPolynomial.map (algebraMap A A') H₀ = MvPolynomial.C (algebraMap A A' r ^ a) * H := by
    intro A A' _ _ _ r _ H hH
    choose n c hc using fun d => IsLocalization.Away.surj r (H.coeff d)
    refine ⟨∑ d ∈ H.support, n d, ∑ d ∈ H.support,
      MvPolynomial.monomial d (r ^ (∑ d' ∈ H.support, n d' - n d) * c d), ?_, ?_⟩
    · apply MvPolynomial.IsHomogeneous.sum
      intro d hd
      exact MvPolynomial.isWeightedHomogeneous_monomial 1 d _
        (hH (MvPolynomial.mem_support_iff.mp hd))
    · ext m
      rw [MvPolynomial.coeff_map, MvPolynomial.coeff_sum, MvPolynomial.coeff_C_mul]
      simp only [MvPolynomial.coeff_monomial, Finset.sum_ite_eq, Finset.sum_ite_eq']
      split_ifs with hm
      · have hle : n m ≤ ∑ d' ∈ H.support, n d' :=
          Finset.single_le_sum (fun _ _ => Nat.zero_le _) hm
        rw [map_mul, map_pow, ← hc m, mul_comm (H.coeff m), ← mul_assoc, ← pow_add,
          Nat.sub_add_cancel hle]
      · rw [map_zero, MvPolynomial.notMem_support_iff.mp hm, mul_zero]

  have hC : ∀ i, wcpaDjFlrgChart k N sB (B.basicOpen f) i ≤ wcpaDjFlrgChart k N sB V i :=
    fun i => inf_le_inf_left _ (Scheme.Hom.preimage_mono _ (B.basicOpen_le f))
  have hnat : ∀ i, (wcpaDjFlrgPsi k N sB (B.basicOpen f) i).comp
      (MvPolynomial.map (B.presheaf.map (homOfLE (B.basicOpen_le f)).op).hom) =
      ((Limits.pullback (wcProjKStr k N) sB).presheaf.map (homOfLE (hC i)).op).hom.comp
        (wcpaDjFlrgPsi k N sB V i) := by
    intro i
    apply MvPolynomial.ringHom_ext
    · intro r
      have e1 := Scheme.Hom.map_appLE (Limits.pullback.snd (wcProjKStr k N) sB)
        (V := wcpaDjFlrgChart k N sB (B.basicOpen f) i)
        (inf_le_right : wcpaDjFlrgChart k N sB (B.basicOpen f) i ≤ _)
        (homOfLE (B.basicOpen_le f)).op
      have e2 := Scheme.Hom.appLE_map (Limits.pullback.snd (wcProjKStr k N) sB) (U := V)
        (inf_le_right : wcpaDjFlrgChart k N sB V i ≤ _) (homOfLE (hC i)).op
      have f1 := congrArg (fun φ => φ.hom r) e1
      have f2 := congrArg (fun φ => φ.hom r) e2
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at f1 f2
      simp only [RingHom.comp_apply, MvPolynomial.map_C, wcpaDjFlrgPsi, MvPolynomial.eval₂Hom_C]
      exact f1.trans f2.symm
    · intro l
      have e2 := Scheme.Hom.appLE_map (Limits.pullback.fst (wcProjKStr k N) sB)
        (U := wcSgD k N i)
        (inf_le_left : wcpaDjFlrgChart k N sB V i ≤ _) (homOfLE (hC i)).op
      have f2 := congrArg (fun φ => φ.hom (wcSgE k N i l)) e2
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at f2
      simp only [RingHom.comp_apply, MvPolynomial.map_X, wcpaDjFlrgPsi, MvPolynomial.eval₂Hom_X']
      exact f2.symm

  have hSatW : ∀ (i : Fin (N + 1)) (H : MvPolynomial (Fin (N + 1)) Γ(B, B.basicOpen f)),
      H ∈ wcpaDjFlrgSat k N sB jZ g hZ (B.basicOpen f) →
      wcpaDjFlrgPsi k N sB (B.basicOpen f) i H ∈ RingHom.ker
        ((Limits.pullback.lift jZ g hZ).app (wcpaDjFlrgChart k N sB (B.basicOpen f) i)).hom := by
    intro i H hH
    have hle : wcpaDjFlrgSat k N sB jZ g hZ (B.basicOpen f) ≤
        Ideal.comap (wcpaDjFlrgPsi k N sB (B.basicOpen f) i) (RingHom.ker
          ((Limits.pullback.lift jZ g hZ).app (wcpaDjFlrgChart k N sB (B.basicOpen f) i)).hom) := by
      apply Ideal.span_le.mpr
      rintro F ⟨e', _, hF⟩
      exact hF i
    exact hle hH

  haveI hloc := hV.isLocalization_basicOpen f
  obtain ⟨a, G₀, hG₀e, hG₀⟩ := clear f G hGe
  have hG₀' : MvPolynomial.map (B.presheaf.map (homOfLE (B.basicOpen_le f)).op).hom G₀ =
      MvPolynomial.C ((B.presheaf.map (homOfLE (B.basicOpen_le f)).op).hom f ^ a) * G := hG₀

  have key : ∀ i, ∃ n : ℕ, ((Limits.pullback.lift jZ g hZ).app (wcpaDjFlrgChart k N sB V i)).hom
      (wcpaDjFlrgPsi k N sB V i (MvPolynomial.C f) ^ n * wcpaDjFlrgPsi k N sB V i G₀) = 0 := by
    intro i
    have h1 : wcpaDjFlrgPsi k N sB (B.basicOpen f) i
        (MvPolynomial.map (B.presheaf.map (homOfLE (B.basicOpen_le f)).op).hom G₀) =
        ((Limits.pullback (wcProjKStr k N) sB).presheaf.map (homOfLE (hC i)).op).hom
          (wcpaDjFlrgPsi k N sB V i G₀) := RingHom.congr_fun (hnat i) G₀
    have hres0 : ((Limits.pullback.lift jZ g hZ).app
        (wcpaDjFlrgChart k N sB (B.basicOpen f) i)).hom
        (((Limits.pullback (wcProjKStr k N) sB).presheaf.map (homOfLE (hC i)).op).hom
          (wcpaDjFlrgPsi k N sB V i G₀)) = 0 := by
      rw [← h1, hG₀', map_mul, map_mul, RingHom.mem_ker.mp (hSatW i G hG), mul_zero]
    have h2 := Scheme.Hom.naturality (Limits.pullback.lift jZ g hZ) (homOfLE (hC i)).op
    have h3 := congrArg (fun φ => φ.hom (wcpaDjFlrgPsi k N sB V i G₀)) h2
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h3
    rw [h3] at hres0
    have hpsiC : wcpaDjFlrgPsi k N sB V i (MvPolynomial.C f) =
        ((Limits.pullback.snd (wcProjKStr k N) sB).appLE V (wcpaDjFlrgChart k N sB V i)
          inf_le_right).hom f := by
      simp only [wcpaDjFlrgPsi, MvPolynomial.eval₂Hom_C]
    have hCW : wcpaDjFlrgChart k N sB (B.basicOpen f) i =
        (Limits.pullback (wcProjKStr k N) sB).basicOpen
          (wcpaDjFlrgPsi k N sB V i (MvPolynomial.C f)) := by
      rw [hpsiC, Scheme.basicOpen_appLE]
      exact le_antisymm
        (le_inf (le_inf inf_le_left
          (inf_le_right.trans (Scheme.Hom.preimage_mono _ (B.basicOpen_le f)))) inf_le_right)
        (le_inf (inf_le_left.trans inf_le_left) inf_le_right)
    have hOeq : Z.basicOpen (((Limits.pullback.lift jZ g hZ).app
        (wcpaDjFlrgChart k N sB V i)).hom (wcpaDjFlrgPsi k N sB V i (MvPolynomial.C f))) =
        Limits.pullback.lift jZ g hZ ⁻¹ᵁ wcpaDjFlrgChart k N sB (B.basicOpen f) i := by
      rw [hCW, Scheme.preimage_basicOpen]
    have hgen : ∀ (O : Z.Opens)
        (hO : O ≤ Limits.pullback.lift jZ g hZ ⁻¹ᵁ wcpaDjFlrgChart k N sB V i),
        O = Limits.pullback.lift jZ g hZ ⁻¹ᵁ wcpaDjFlrgChart k N sB (B.basicOpen f) i →
        (Z.presheaf.map (homOfLE hO).op).hom
          (((Limits.pullback.lift jZ g hZ).app (wcpaDjFlrgChart k N sB V i)).hom
            (wcpaDjFlrgPsi k N sB V i G₀)) = 0 := by
      rintro O hO rfl
      have hh : homOfLE hO = (TopologicalSpace.Opens.map (Limits.pullback.lift jZ g hZ).base).map
          (homOfLE (hC i)) := Subsingleton.elim _ _
      rw [hh]
      exact hres0
    have hz : (Z.presheaf.map (homOfLE (Z.basicOpen_le (((Limits.pullback.lift jZ g hZ).app
        (wcpaDjFlrgChart k N sB V i)).hom (wcpaDjFlrgPsi k N sB V i (MvPolynomial.C f))))).op).hom
        (((Limits.pullback.lift jZ g hZ).app (wcpaDjFlrgChart k N sB V i)).hom
          (wcpaDjFlrgPsi k N sB V i G₀)) = 0 :=
      hgen _ _ hOeq
    have hcpt : IsCompact ((Limits.pullback.lift jZ g hZ ⁻¹ᵁ wcpaDjFlrgChart k N sB V i :
        Z.Opens) : Set Z) := by
      apply Scheme.Hom.isCompact_preimage
      apply IsAffineOpen.isCompact
      exact chart_aff _ _ _ _ _ _ _
        (Proj.isAffineOpen_basicOpen _ (MvPolynomial.X i)
          ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k i))
          Nat.one_pos) hV
    obtain ⟨n, hn⟩ := exists_pow_mul_eq_zero_of_res_basicOpen_eq_zero_of_isCompact Z hcpt
      (((Limits.pullback.lift jZ g hZ).app (wcpaDjFlrgChart k N sB V i)).hom
        (wcpaDjFlrgPsi k N sB V i G₀))
      (((Limits.pullback.lift jZ g hZ).app (wcpaDjFlrgChart k N sB V i)).hom
        (wcpaDjFlrgPsi k N sB V i (MvPolynomial.C f))) hz
    refine ⟨n, ?_⟩
    rw [map_mul, map_pow]
    exact hn

  choose n hn using key
  have hF₀e : (MvPolynomial.C (f ^ ∑ i, n i) * G₀).IsHomogeneous e := by
    have := (MvPolynomial.isHomogeneous_C (Fin (N + 1)) (f ^ ∑ i, n i)).mul hG₀e
    rwa [zero_add] at this
  refine ⟨(B.presheaf.map (homOfLE (B.basicOpen_le f)).op).hom f ^ (∑ i, n i + a),
    MvPolynomial.C (f ^ ∑ i, n i) * G₀, ?_, ?_, hF₀e, ?_⟩
  · exact (IsLocalization.Away.algebraMap_isUnit f).pow _
  · apply Ideal.subset_span
    refine ⟨e, hF₀e, fun i => ?_⟩
    rw [RingHom.mem_ker, map_mul, MvPolynomial.C_pow, map_pow,
      ← pow_sub_mul_pow _ (Finset.single_le_sum (fun j _ => Nat.zero_le (n j))
        (Finset.mem_univ i)), mul_assoc, map_mul, hn i, mul_zero]
  · rw [map_mul, MvPolynomial.map_C, hG₀', ← mul_assoc, ← MvPolynomial.C_mul, map_pow,
      ← pow_add]

theorem wcpa_dj_flrg_gc_fibre_rank : ∀ (k K : Type u) [Field k] [Field K] (N e r h : ℕ) (T : Set (MvPolynomial (Fin (N + 1)) K)), (∀ t ∈ T, t.IsHomogeneous e) → wcpaDjHilbFn K N (Ideal.span T) e = h → h + r = Module.finrank k (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k e) → FiniteDimensional K (Submodule.span K T) ∧ Module.finrank K (Submodule.span K T) = r :=
by
  intro k K _ _ N e r h T hT hH hr
  classical
  have key : ∀ (c t : MvPolynomial (Fin (N + 1)) K), t.IsHomogeneous e →
      MvPolynomial.homogeneousComponent e (c * t) = MvPolynomial.C (c.coeff 0) * t := by
    intro c t ht
    ext d
    rw [MvPolynomial.coeff_homogeneousComponent, MvPolynomial.coeff_C_mul]
    split_ifs with hd
    · rw [MvPolynomial.coeff_mul, Finset.sum_eq_single (0, d)]
      · intro x hx hne
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at hx
        by_cases hb : t.coeff x.2 = 0
        · rw [hb, mul_zero]
        · exfalso
          have h2 : x.2.degree = e := by
            by_contra hne2
            exact hb (ht.coeff_eq_zero hne2)
          have h3 : x.1.degree + x.2.degree = d.degree := by
            rw [← hx]
            exact (map_add Finsupp.degree x.1 x.2).symm
          have h4 : x.1 = 0 := by
            rw [← Finsupp.degree_eq_zero_iff]
            omega
          apply hne
          have h5 : x.2 = d := by rw [← hx, h4, zero_add]
          exact Prod.ext h4 h5
      · intro h0
        exfalso
        apply h0
        rw [Finset.HasAntidiagonal.mem_antidiagonal, zero_add]
    · rw [ht.coeff_eq_zero hd, mul_zero]
  have degpart : ∀ G ∈ Ideal.span T, G.IsHomogeneous e → G ∈ Submodule.span K T := by
    intro G hG hGh
    obtain ⟨n, f, g, rfl⟩ := Submodule.mem_span_set'.mp hG
    have hG' : MvPolynomial.homogeneousComponent e (∑ i, f i • (g i : MvPolynomial (Fin (N + 1)) K))
        = ∑ i, f i • (g i : MvPolynomial (Fin (N + 1)) K) := by
      rw [MvPolynomial.homogeneousComponent_of_mem (m := e)
        ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr hGh), if_pos rfl]
    rw [← hG', map_sum]
    refine Submodule.sum_mem _ (fun i _ => ?_)
    rw [smul_eq_mul, key _ _ (hT _ (g i).2), ← MvPolynomial.smul_eq_C_mul]
    exact Submodule.smul_mem _ _ (Submodule.subset_span (g i).2)
  have hWS : Submodule.span K T ≤ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e :=
    Submodule.span_le.mpr (fun t ht => (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (hT t ht))
  have hQ : Submodule.comap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e).subtype
        (Submodule.restrictScalars K (Ideal.span T)) =
      Submodule.comap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e).subtype
        (Submodule.span K T) := by
    ext x
    simp only [Submodule.mem_comap, Submodule.restrictScalars_mem, Submodule.coe_subtype]
    constructor
    · intro hx
      exact degpart _ hx ((MvPolynomial.mem_homogeneousSubmodule _ _).mp x.2)
    · intro hx
      exact Submodule.span_le_restrictScalars K (MvPolynomial (Fin (N + 1)) K) T hx
  have homfin : ∀ (L : Type u) [Field L],
      Module.Finite L ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) L e) ∧
      Module.finrank L ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) L e) =
        Nat.card {d : Fin (N + 1) →₀ ℕ // d.degree = e} := by
    intro L _
    have hS : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) L e =
        MvPolynomial.restrictSupport L {d : Fin (N + 1) →₀ ℕ | d.degree = e} := by
      rw [MvPolynomial.homogeneousSubmodule_eq_finsupp_supported]
      rfl
    let b := (MvPolynomial.basisRestrictSupport L {d : Fin (N + 1) →₀ ℕ | d.degree = e}).map
      (LinearEquiv.ofEq _ _ hS.symm)
    have hfin : Set.Finite {d : Fin (N + 1) →₀ ℕ | d.degree = e} :=
      (Finsupp.finite_of_degree_le e).subset (fun d hd => le_of_eq hd)
    have : Finite ↥{d : Fin (N + 1) →₀ ℕ | d.degree = e} := hfin.to_subtype
    exact ⟨Module.Finite.of_basis b, Module.finrank_eq_nat_card_basis b⟩
  obtain ⟨hfinK, hrkK⟩ := homfin K
  obtain ⟨_, hrkk⟩ := homfin k
  have := hfinK
  have hrn := Submodule.finrank_quotient_add_finrank
    (Submodule.comap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e).subtype
        (Submodule.span K T))
  have hH' : Module.finrank K (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e) ⧸
      Submodule.comap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e).subtype
        (Submodule.span K T)) = h := by
    rw [← hQ]
    exact hH
  have heq := LinearEquiv.finrank_eq (Submodule.comapSubtypeEquivOfLe hWS)
  have hfinW : FiniteDimensional K (Submodule.span K T) :=
    Module.Finite.equiv (Submodule.comapSubtypeEquivOfLe hWS)
  refine ⟨hfinW, ?_⟩
  omega

theorem wcpa_dj_flrg_gc_local_normal_form : ∀ (B : Scheme.{u}) [AlgebraicGeometry.IsReduced B] (V : B.Opens) (N e₀ r : ℕ) (Wset : Set (MvPolynomial (Fin (N + 1)) Γ(B, V))), (∀ w ∈ Wset, w.IsHomogeneous e₀) → (∀ (q : B) (hq : q ∈ V), FiniteDimensional (B.residueField q) (Submodule.span (B.residueField q) ((MvPolynomial.map (B.presheaf.germ V q hq ≫ B.residue q).hom) '' Wset)) ∧ Module.finrank (B.residueField q) (Submodule.span (B.residueField q) ((MvPolynomial.map (B.presheaf.germ V q hq ≫ B.residue q).hom) '' Wset)) = r) → ∀ (p : B), p ∈ V → ∃ s : Γ(B, V), p ∈ B.basicOpen s ∧ ∃ (m : Fin r → (Fin (N + 1) →₀ ℕ)) (F : Fin r → MvPolynomial (Fin (N + 1)) Γ(B, B.basicOpen s)), Function.Injective m ∧ (∀ a, (m a).degree = e₀) ∧ (∀ a, (F a).IsHomogeneous e₀) ∧ (∀ a a', (F a).coeff (m a') = if a = a' then 1 else 0) ∧ (∀ a, F a ∈ Submodule.span Γ(B, B.basicOpen s) ((MvPolynomial.map (B.presheaf.map (homOfLE (B.basicOpen_le s)).op).hom) '' Wset)) ∧ ∀ w ∈ Wset, MvPolynomial.map (B.presheaf.map (homOfLE (B.basicOpen_le s)).op).hom w ∈ Submodule.span Γ(B, B.basicOpen s) (Set.range F) :=
by
  have s1 : ∀ {K : Type u} [Field K] (N r e₀ : ℕ) (v : Fin r → MvPolynomial (Fin (N + 1)) K),
      LinearIndependent K v → (∀ b, (v b).IsHomogeneous e₀) →
      ∃ c : Fin r → (Fin (N + 1) →₀ ℕ), Function.Injective c ∧ (∀ a, (c a).degree = e₀) ∧
        (Matrix.of fun b a => (v b).coeff (c a)).det ≠ 0 := by
    intro K _ N r e₀ v hv hh
    let col : (Fin (N + 1) →₀ ℕ) → (Fin r → K) := fun d b => (v b).coeff d
    have hspan : Submodule.span K (Set.range col) = ⊤ := by
      by_contra hne
      obtain ⟨f, hf0, hfle⟩ := Submodule.exists_le_ker_of_lt_top _ (lt_top_iff_ne_top.mpr hne)
      have hform : ∀ x : Fin r → K,
          f x = ∑ b, x b * f (fun j => if b = j then 1 else 0) := by
        intro x
        conv_lhs => rw [pi_eq_sum_univ x]
        rw [map_sum]
        refine Finset.sum_congr rfl (fun b _ => ?_)
        rw [map_smul, smul_eq_mul]
      have hsum : ∑ b, f (fun j => if b = j then 1 else 0) • v b = 0 := by
        ext d
        have h1 : f (col d) = 0 := hfle (Submodule.subset_span ⟨d, rfl⟩)
        rw [hform] at h1
        have h2 : ∑ b, f (fun j => if b = j then 1 else 0) * (v b).coeff d = 0 :=
          calc ∑ b, f (fun j => if b = j then 1 else 0) * (v b).coeff d
              = ∑ b, col d b * f (fun j => if b = j then 1 else 0) :=
                Finset.sum_congr rfl (fun b _ => mul_comm _ _)
            _ = 0 := h1
        simpa [MvPolynomial.coeff_sum] using h2
      have hg := Fintype.linearIndependent_iff.mp hv _ hsum
      apply hf0
      refine LinearMap.ext fun x => ?_
      rw [hform x, LinearMap.zero_apply]
      exact Finset.sum_eq_zero fun b _ => by rw [hg b, mul_zero]
    obtain ⟨κ, a, ha, hspa, hli⟩ := exists_linearIndependent' K col
    haveI : Finite κ := hli.finite
    letI : Fintype κ := Fintype.ofFinite κ
    have hcard : Fintype.card κ = r := by
      have h1 := finrank_span_eq_card hli
      rw [hspa, hspan, finrank_top, Module.finrank_fin_fun] at h1
      exact h1.symm
    let e : Fin r ≃ κ := (Fintype.equivFinOfCardEq hcard).symm
    have hdet : (Matrix.of fun b a' => (v b).coeff ((a ∘ e) a')).det ≠ 0 := by
      have hcols : LinearIndependent K (Matrix.of fun b a' => (v b).coeff ((a ∘ e) a')).col := by
        have : (Matrix.of fun b a' => (v b).coeff ((a ∘ e) a')).col = (col ∘ a) ∘ e := by
          ext a' b; rfl
        rw [this]; exact hli.comp e e.injective
      exact ((Matrix.isUnit_iff_isUnit_det _).mp
        (Matrix.linearIndependent_cols_iff_isUnit.mp hcols)).ne_zero
    refine ⟨a ∘ e, ha.comp e.injective, ?_, hdet⟩
    intro a'
    by_contra hd
    apply hdet
    apply Matrix.det_eq_zero_of_column_eq_zero a'
    intro b
    exact (hh b).coeff_eq_zero hd
  have s2 : ∀ {A : Type u} [CommRing A] (N r e₀ : ℕ) (w : Fin r → MvPolynomial (Fin (N + 1)) A)
      (m : Fin r → (Fin (N + 1) →₀ ℕ)), (∀ b, (w b).IsHomogeneous e₀) →
      IsUnit (Matrix.of fun b a => (w b).coeff (m a)).det →
      ∃ F : Fin r → MvPolynomial (Fin (N + 1)) A, (∀ a, (F a).IsHomogeneous e₀) ∧
        (∀ a a', (F a).coeff (m a') = if a = a' then 1 else 0) ∧
        (∀ a, F a ∈ Submodule.span A (Set.range w)) := by
    intro A _ N r e₀ w m hw hu
    set M := Matrix.of fun b a => (w b).coeff (m a) with hM
    refine ⟨fun a => ∑ b, M⁻¹ a b • w b, ?_, ?_, ?_⟩
    · intro a
      have : (∑ b, M⁻¹ a b • w b) ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A e₀ :=
        Submodule.sum_mem _ (fun b _ => Submodule.smul_mem _ _
          ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (hw b)))
      exact (MvPolynomial.mem_homogeneousSubmodule _ _).mp this
    · intro a a'
      have h1 : (∑ b, M⁻¹ a b • w b).coeff (m a') = (M⁻¹ * M) a a' := by
        rw [MvPolynomial.coeff_sum, Matrix.mul_apply]
        refine Finset.sum_congr rfl (fun b _ => ?_)
        rw [MvPolynomial.coeff_smul, smul_eq_mul]
        rfl
      rw [h1, Matrix.nonsing_inv_mul _ hu, Matrix.one_apply]
    · intro a
      exact Submodule.sum_mem _ (fun b _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨b, rfl⟩))
  have s3 : ∀ (B : Scheme.{u}) [AlgebraicGeometry.IsReduced B] (V D : B.Opens) (hDV : D ≤ V) (N r : ℕ)
      (Wset : Set (MvPolynomial (Fin (N + 1)) Γ(B, V))),
      (∀ (q : B) (hq : q ∈ V), FiniteDimensional (B.residueField q) (Submodule.span (B.residueField q) ((MvPolynomial.map (B.presheaf.germ V q hq ≫ B.residue q).hom) '' Wset)) ∧ Module.finrank (B.residueField q) (Submodule.span (B.residueField q) ((MvPolynomial.map (B.presheaf.germ V q hq ≫ B.residue q).hom) '' Wset)) = r) →
      ∀ (m : Fin r → (Fin (N + 1) →₀ ℕ)) (F : Fin r → MvPolynomial (Fin (N + 1)) Γ(B, D)),
      (∀ a a', (F a).coeff (m a') = if a = a' then 1 else 0) →
      (∀ a, F a ∈ Submodule.span Γ(B, D) ((MvPolynomial.map (B.presheaf.map (homOfLE hDV).op).hom) '' Wset)) →
      ∀ (y : MvPolynomial (Fin (N + 1)) Γ(B, D)),
      y ∈ Submodule.span Γ(B, D) ((MvPolynomial.map (B.presheaf.map (homOfLE hDV).op).hom) '' Wset) →
      (∀ a, y.coeff (m a) = 0) → y = 0 := by
    intro B _ V D hDV N r Wset hrank m F hFc hFs y hy hy0
    ext d
    simp only [MvPolynomial.coeff_zero, Pi.zero_apply]
    apply eq_zero_of_basicOpen_eq_bot
    rw [eq_bot_iff]
    intro q hq
    exfalso
    have hqD : q ∈ D := B.basicOpen_le _ hq
    have hqV : q ∈ V := hDV hqD
    obtain ⟨hfd, hfr⟩ := hrank q hqV
    haveI := hfd
    have hcomp : (B.presheaf.germ D q hqD ≫ B.residue q).hom.comp
        (B.presheaf.map (homOfLE hDV).op).hom = (B.presheaf.germ V q hqV ≫ B.residue q).hom := by
      rw [← CommRingCat.hom_comp, TopCat.Presheaf.germ_res_assoc]
    have hfib : ∀ z ∈ Submodule.span Γ(B, D)
        ((MvPolynomial.map (B.presheaf.map (homOfLE hDV).op).hom) '' Wset),
        MvPolynomial.map (B.presheaf.germ D q hqD ≫ B.residue q).hom z ∈
          Submodule.span (B.residueField q)
            ((MvPolynomial.map (B.presheaf.germ V q hqV ≫ B.residue q).hom) '' Wset) := by
      intro z hz
      induction hz using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨w, hw, rfl⟩ := hx
        rw [MvPolynomial.map_map, hcomp]
        exact Submodule.subset_span ⟨w, hw, rfl⟩
      | zero => rw [map_zero]; exact Submodule.zero_mem _
      | add x z _ _ hx hz => rw [map_add]; exact Submodule.add_mem _ hx hz
      | smul c x _ hx =>
        rw [MvPolynomial.smul_eq_C_mul, map_mul, MvPolynomial.map_C, ← MvPolynomial.smul_eq_C_mul]
        exact Submodule.smul_mem _ _ hx
    let v : Fin r → MvPolynomial (Fin (N + 1)) (B.residueField q) :=
      fun a => MvPolynomial.map (B.presheaf.germ D q hqD ≫ B.residue q).hom (F a)
    have hvc : ∀ a a', (v a).coeff (m a') = if a = a' then 1 else 0 := by
      intro a a'
      simp only [v, MvPolynomial.coeff_map, hFc]
      split_ifs <;> simp
    have hvli : LinearIndependent (B.residueField q) v := by
      rw [Fintype.linearIndependent_iff]
      intro g hg a'
      have := congrArg (fun P : MvPolynomial (Fin (N + 1)) (B.residueField q) => P.coeff (m a')) hg
      simpa [MvPolynomial.coeff_sum, hvc] using this
    have hle : Submodule.span (B.residueField q) (Set.range v) ≤
        Submodule.span (B.residueField q)
            ((MvPolynomial.map (B.presheaf.germ V q hqV ≫ B.residue q).hom) '' Wset) := by
      rw [Submodule.span_le]; rintro _ ⟨a, rfl⟩; exact hfib _ (hFs a)
    have heq := Submodule.eq_of_le_of_finrank_eq hle
      (by rw [finrank_span_eq_card hvli, Fintype.card_fin, hfr])
    have hz : MvPolynomial.map (B.presheaf.germ D q hqD ≫ B.residue q).hom y ∈
        Submodule.span (B.residueField q) (Set.range v) := heq ▸ hfib y hy
    obtain ⟨g, hg⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hz
    have hg0 : ∀ a', g a' = 0 := by
      intro a'
      have := congrArg (fun P : MvPolynomial (Fin (N + 1)) (B.residueField q) => P.coeff (m a')) hg
      simpa [MvPolynomial.coeff_sum, MvPolynomial.coeff_map, hy0, hvc] using this
    have hz0 : MvPolynomial.map (B.presheaf.germ D q hqD ≫ B.residue q).hom y = 0 := by
      rw [← hg]; simp [hg0]
    have h1 : (B.presheaf.germ D q hqD ≫ B.residue q).hom (y.coeff d) = 0 := by
      rw [← MvPolynomial.coeff_map, hz0]
      simp
    have h2 := (Scheme.evaluation_ne_zero_iff_mem_basicOpen B q hqD (y.coeff d)).mpr hq
    rw [← Scheme.germ_residue] at h2
    exact h2 h1
  intro B _ V N e₀ r Wset hhom hrank p hp
  classical

  obtain ⟨hfd, hfr⟩ := hrank p hp
  haveI := hfd
  obtain ⟨f, hfS, -, hfli⟩ := Submodule.exists_fun_fin_finrank_span_eq (B.residueField p)
    ((MvPolynomial.map (B.presheaf.germ V p hp ≫ B.residue p).hom) '' Wset)
  let v : Fin r → MvPolynomial (Fin (N + 1)) (B.residueField p) := f ∘ Fin.cast hfr.symm
  have hvli : LinearIndependent (B.residueField p) v := hfli.comp _ (Fin.cast_injective _)
  have hvS : ∀ b, v b ∈ (MvPolynomial.map (B.presheaf.germ V p hp ≫ B.residue p).hom) '' Wset :=
    fun b => hfS _
  choose w hwW hwv using hvS

  have hvh : ∀ b, (v b).IsHomogeneous e₀ := fun b => by
    rw [← hwv b]; exact (hhom _ (hwW b)).map _
  obtain ⟨c, hcinj, hcdeg, hdet⟩ := s1 N r e₀ v hvli hvh

  set M : Matrix (Fin r) (Fin r) Γ(B, V) := Matrix.of fun b a => (w b).coeff (c a) with hM
  have hps : p ∈ B.basicOpen M.det := by
    rw [← Scheme.evaluation_ne_zero_iff_mem_basicOpen B p hp, ← Scheme.germ_residue,
      RingHom.map_det]
    convert hdet using 2
    ext b a
    simp [M, ← hwv b, MvPolynomial.coeff_map]
  refine ⟨M.det, hps, ?_⟩

  set ρ := (B.presheaf.map (homOfLE (B.basicOpen_le M.det)).op).hom with hρ
  have hρu : IsUnit (ρ M.det) := RingedSpace.isUnit_res_basicOpen B.toRingedSpace M.det
  have hu : IsUnit (Matrix.of fun b a => (MvPolynomial.map ρ (w b)).coeff (c a)).det := by
    have : (Matrix.of fun b a => (MvPolynomial.map ρ (w b)).coeff (c a)) = ρ.mapMatrix M := by
      ext b a; simp [M, MvPolynomial.coeff_map]
    rw [this, ← RingHom.map_det]; exact hρu
  obtain ⟨F, hFh, hFc, hFw⟩ := s2 N r e₀ (fun b => MvPolynomial.map ρ (w b)) c
    (fun b => (hhom _ (hwW b)).map _) hu
  have hFs : ∀ a, F a ∈ Submodule.span Γ(B, B.basicOpen M.det)
      ((MvPolynomial.map ρ) '' Wset) := by
    intro a
    refine Submodule.span_mono ?_ (hFw a)
    rintro _ ⟨b, rfl⟩
    exact ⟨w b, hwW b, rfl⟩
  refine ⟨c, F, hcinj, hcdeg, hFh, hFc, hFs, ?_⟩

  intro w₀ hw₀
  set y := MvPolynomial.map ρ w₀ with hy
  have hres : y - ∑ a, y.coeff (c a) • F a = 0 := by
    apply s3 B V _ (B.basicOpen_le M.det) N r Wset hrank c F hFc hFs
    · refine Submodule.sub_mem _ (Submodule.subset_span ⟨w₀, hw₀, rfl⟩) ?_
      exact Submodule.sum_mem _ (fun a _ => Submodule.smul_mem _ _ (hFs a))
    · intro a'
      simp [MvPolynomial.coeff_sum, hFc]
  rw [sub_eq_zero] at hres
  rw [hres]
  exact Submodule.sum_mem _ (fun a _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨a, rfl⟩))

theorem wcpa_dj_flrg_good_cover : ∀ (k : Type u) [Field k] (N : ℕ) (B Z : Scheme.{u}) (sB : B ⟶ Spec (.of k)) (jZ : Z ⟶ wcProjK k N) (g : Z ⟶ B) (hZ : jZ ≫ wcProjKStr k N = g ≫ sB), IsClosedImmersion (Limits.pullback.lift jZ g hZ) → AlgebraicGeometry.IsIntegral B → CompactSpace B → ∀ (m : ℕ) (V : Fin m → B.Opens) (E : ℕ), 1 ≤ E → (∀ j, IsAffineOpen (V j)) → (⨆ j, V j) = ⊤ → (∀ j e, E ≤ e → Module.Projective Γ(B, V j) (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Γ(B, V j) e) ⧸ wcpaDjDeg N (wcpaDjFlrgSat k N sB jZ g hZ (V j)) e) ∧ wcpaDjGen N (wcpaDjFlrgSat k N sB jZ g hZ (V j)) e) → ∀ (e₀ r : ℕ) (Φ : ℕ → ℕ), E ≤ e₀ → (1 ≤ e₀ ∧ Φ e₀ + r = Module.finrank k (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k e₀) ∧ ∀ e, e₀ ≤ e → Φ (e + 1) = wcpaDjMacUp e (Φ e)) → (∀ (j : Fin m) (p : B) (hp : p ∈ V j) (e : ℕ), e₀ ≤ e → wcpaDjHilbFn (B.residueField p) N (Ideal.span ((MvPolynomial.map (B.presheaf.germ (V j) p hp ≫ B.residue p).hom) '' {F | F ∈ wcpaDjFlrgSat k N sB jZ g hZ (V j) ∧ F.IsHomogeneous e₀})) e = Φ e) → ∃ (m' : ℕ) (D : Fin m' → B.Opens), (⨆ l, D l) = ⊤ ∧ ∀ l, wcpaDjFlrgGood k N sB jZ g hZ e₀ r Φ (D l) :=
by
  intro k _ N B Z sB jZ g hZ hε hBint hBcpt m V E hE1 hVaff hVcov hVproj e₀ r Φ hEe₀ hH0 hfib
  classical
  haveI : AlgebraicGeometry.IsIntegral B := hBint
  haveI : CompactSpace B := hBcpt

  have map_span : ∀ {A A' : Type u} [CommRing A] [CommRing A'] (ρ : A →+* A')
      (S : Set (MvPolynomial (Fin (N + 1)) A)) (x : MvPolynomial (Fin (N + 1)) A),
      x ∈ Submodule.span A S →
      MvPolynomial.map ρ x ∈ Submodule.span A' ((MvPolynomial.map ρ) '' S) := by
    intro A A' _ _ ρ S x hx
    induction hx using Submodule.span_induction with
    | mem y hy => exact Submodule.subset_span ⟨y, hy, rfl⟩
    | zero => simp
    | add y z _ _ hy hz => rw [map_add]; exact Submodule.add_mem _ hy hz
    | smul a y _ hy =>
      rw [MvPolynomial.smul_eq_C_mul, map_mul, MvPolynomial.map_C, ← MvPolynomial.smul_eq_C_mul]
      exact Submodule.smul_mem _ _ hy

  have span_sub : ∀ {A : Type u} [CommRing A] (I : Ideal (MvPolynomial (Fin (N + 1)) A))
      (S : Set (MvPolynomial (Fin (N + 1)) A)), S ⊆ I → ∀ x ∈ Submodule.span A S, x ∈ I := by
    intro A _ I S hS x hx
    induction hx using Submodule.span_induction with
    | mem y hy => exact hS hy
    | zero => exact I.zero_mem
    | add y z _ _ hy hz => exact I.add_mem hy hz
    | smul a y _ hy => rw [MvPolynomial.smul_eq_C_mul]; exact I.mul_mem_left _ hy

  have unit_rec : ∀ {A A' : Type u} [CommRing A] [CommRing A'] (ρ : A →+* A')
      (u : A') (F₀ : MvPolynomial (Fin (N + 1)) A) (G : MvPolynomial (Fin (N + 1)) A')
      (hu : IsUnit u), MvPolynomial.map ρ F₀ = MvPolynomial.C u * G →
      G = (↑hu.unit⁻¹ : A') • MvPolynomial.map ρ F₀ := by
    intro A A' _ _ ρ u F₀ G hu h
    rw [h, MvPolynomial.smul_eq_C_mul, ← mul_assoc, ← MvPolynomial.C_mul, IsUnit.val_inv_mul,
      MvPolynomial.C_1, one_mul]

  have transfer_gen : ∀ {A A' : Type u} [CommRing A] [CommRing A'] (ρ : A →+* A')
      (J : Ideal (MvPolynomial (Fin (N + 1)) A)) (J' : Ideal (MvPolynomial (Fin (N + 1)) A')),
      (∀ (e : ℕ) (G : MvPolynomial (Fin (N + 1)) A'), G ∈ J' → G.IsHomogeneous e →
        ∃ (u : A') (F₀ : MvPolynomial (Fin (N + 1)) A), IsUnit u ∧ F₀ ∈ J ∧
          F₀.IsHomogeneous e ∧ MvPolynomial.map ρ F₀ = MvPolynomial.C u * G) →
      (∀ F ∈ J, MvPolynomial.map ρ F ∈ J') → ∀ e, wcpaDjGen N J e → wcpaDjGen N J' e := by
    intro A A' _ _ ρ J J' hlift hmap e hgen G hG hGh
    obtain ⟨u, F₀, hu, hF₀, hF₀h, hF₀eq⟩ := hlift (e + 1) G hG hGh
    have h1 := hgen F₀ hF₀ hF₀h
    have h2 : MvPolynomial.map ρ F₀ ∈ Submodule.span A'
        {H | ∃ (l : Fin (N + 1)) (G' : MvPolynomial (Fin (N + 1)) A'),
          G' ∈ J' ∧ G'.IsHomogeneous e ∧ H = MvPolynomial.X l * G'} := by
      have h3 := map_span ρ _ F₀ h1
      refine Submodule.span_mono ?_ h3
      rintro _ ⟨H, ⟨l, G', hG'J, hG'h, rfl⟩, rfl⟩
      exact ⟨l, MvPolynomial.map ρ G', hmap G' hG'J, hG'h.map ρ,
        by rw [map_mul, MvPolynomial.map_X]⟩
    rw [unit_rec ρ u F₀ G hu hF₀eq]
    exact Submodule.smul_mem _ _ h2

  have transfer_span : ∀ {A A' : Type u} [CommRing A] [CommRing A'] (ρ : A →+* A')
      (J : Ideal (MvPolynomial (Fin (N + 1)) A)) (J' : Ideal (MvPolynomial (Fin (N + 1)) A')),
      (∀ (e : ℕ) (G : MvPolynomial (Fin (N + 1)) A'), G ∈ J' → G.IsHomogeneous e →
        ∃ (u : A') (F₀ : MvPolynomial (Fin (N + 1)) A), IsUnit u ∧ F₀ ∈ J ∧
          F₀.IsHomogeneous e ∧ MvPolynomial.map ρ F₀ = MvPolynomial.C u * G) →
      ∀ (e : ℕ) (T : Set (MvPolynomial (Fin (N + 1)) A')),
      (∀ F₀ ∈ J, F₀.IsHomogeneous e → MvPolynomial.map ρ F₀ ∈ Submodule.span A' T) →
      ∀ G ∈ J', G.IsHomogeneous e → G ∈ Submodule.span A' T := by
    intro A A' _ _ ρ J J' hlift e T hT G hG hGh
    obtain ⟨u, F₀, hu, hF₀, hF₀h, hF₀eq⟩ := hlift e G hG hGh
    rw [unit_rec ρ u F₀ G hu hF₀eq]
    exact Submodule.smul_mem _ _ (hT F₀ hF₀ hF₀h)

  have hilb_span : ∀ {A A' K : Type u} [CommRing A] [CommRing A'] [CommRing K] (r : ℕ)
      (ρ : A →+* A') (φ : A' →+* K) (Wset : Set (MvPolynomial (Fin (N + 1)) A))
      (F : Fin r → MvPolynomial (Fin (N + 1)) A'),
      (∀ a, F a ∈ Submodule.span A' ((MvPolynomial.map ρ) '' Wset)) →
      (∀ w ∈ Wset, MvPolynomial.map ρ w ∈ Submodule.span A' (Set.range F)) →
      Ideal.span (Set.range fun a => MvPolynomial.map φ (F a)) =
        Ideal.span ((MvPolynomial.map (φ.comp ρ)) '' Wset) := by
    intro A A' K _ _ _ r ρ φ Wset F hF hW
    have key : ∀ (S : Set (MvPolynomial (Fin (N + 1)) A')) (x : MvPolynomial (Fin (N + 1)) A'),
        x ∈ Submodule.span A' S → MvPolynomial.map φ x ∈ Ideal.span ((MvPolynomial.map φ) '' S) := by
      intro S x hx
      induction hx using Submodule.span_induction with
      | mem y hy => exact Ideal.subset_span ⟨y, hy, rfl⟩
      | zero => simp
      | add y z _ _ hy hz => rw [map_add]; exact Ideal.add_mem _ hy hz
      | smul a y _ hy =>
        rw [MvPolynomial.smul_eq_C_mul, map_mul]
        exact Ideal.mul_mem_left _ _ hy
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ ⟨a, rfl⟩
      have h1 := key _ _ (hF a)
      refine Ideal.span_mono ?_ h1
      rintro _ ⟨_, ⟨w, hw, rfl⟩, rfl⟩
      exact ⟨w, hw, by rw [MvPolynomial.map_map]⟩
    · rw [Ideal.span_le]
      rintro _ ⟨w, hw, rfl⟩
      have h1 := key _ _ (hW w hw)
      rw [← MvPolynomial.map_map]
      refine Ideal.span_mono ?_ h1
      rintro _ ⟨_, ⟨a, rfl⟩, rfl⟩
      exact ⟨a, rfl⟩

  have hC : ∀ p : B, ∃ D : B.Opens, p ∈ D ∧ wcpaDjFlrgGood k N sB jZ g hZ e₀ r Φ D := by
    intro p
    have hp : p ∈ (⨆ j, V j) := by rw [hVcov]; simp
    obtain ⟨j, hpj⟩ := TopologicalSpace.Opens.mem_iSup.mp hp
    have hrank : ∀ (q : B) (hq : q ∈ V j),
        FiniteDimensional (B.residueField q) (Submodule.span (B.residueField q)
          ((MvPolynomial.map (B.presheaf.germ (V j) q hq ≫ B.residue q).hom) ''
            {F | F ∈ wcpaDjFlrgSat k N sB jZ g hZ (V j) ∧ F.IsHomogeneous e₀})) ∧
        Module.finrank (B.residueField q) (Submodule.span (B.residueField q)
          ((MvPolynomial.map (B.presheaf.germ (V j) q hq ≫ B.residue q).hom) ''
            {F | F ∈ wcpaDjFlrgSat k N sB jZ g hZ (V j) ∧ F.IsHomogeneous e₀})) = r := by
      intro q hq
      exact wcpa_dj_flrg_gc_fibre_rank k (B.residueField q) N e₀ r (Φ e₀) _
        (by rintro _ ⟨w, hw, rfl⟩; exact hw.2.map _) (hfib j q hq e₀ le_rfl) hH0.2.1
    obtain ⟨s, hps, mm, F, hmi, hmd, hFh, hFc, hFspan, hWspan⟩ :=
      wcpa_dj_flrg_gc_local_normal_form B (V j) N e₀ r
        {F | F ∈ wcpaDjFlrgSat k N sB jZ g hZ (V j) ∧ F.IsHomogeneous e₀}
        (fun w hw => hw.2) hrank p hpj
    refine ⟨B.basicOpen s, hps, ?_⟩
    have hDaff : IsAffineOpen (B.basicOpen s) := (hVaff j).basicOpen s
    have hWsat : ∀ w ∈ {F | F ∈ wcpaDjFlrgSat k N sB jZ g hZ (V j) ∧ F.IsHomogeneous e₀},
        MvPolynomial.map (B.presheaf.map (homOfLE (B.basicOpen_le s)).op).hom w ∈
          wcpaDjFlrgSat k N sB jZ g hZ (B.basicOpen s) := fun w hw =>
      wcpa_dj_flrg_gc_sat_restrict k N B Z sB jZ g hZ (V j) (B.basicOpen s) (B.basicOpen_le s) w
        hw.1
    have hFsat : ∀ a, F a ∈ wcpaDjFlrgSat k N sB jZ g hZ (B.basicOpen s) := fun a =>
      span_sub _ _ (by rintro _ ⟨w, hw, rfl⟩; exact hWsat w hw) _ (hFspan a)
    have liftD := wcpa_dj_flrg_gc_sat_basicOpen_lift k N B Z sB jZ g hZ hε (V j) (hVaff j) s
    have hDgen : ∀ e, e₀ ≤ e → wcpaDjGen N (wcpaDjFlrgSat k N sB jZ g hZ (B.basicOpen s)) e :=
      fun e he => transfer_gen _ _ _ liftD
        (fun F' hF' => wcpa_dj_flrg_gc_sat_restrict k N B Z sB jZ g hZ (V j) (B.basicOpen s)
          (B.basicOpen_le s) F' hF') e (hVproj j e (hEe₀.trans he)).2
    have hDspan : ∀ G ∈ wcpaDjFlrgSat k N sB jZ g hZ (B.basicOpen s), G.IsHomogeneous e₀ →
        G ∈ Submodule.span Γ(B, B.basicOpen s) (Set.range F) :=
      transfer_span _ _ _ liftD e₀ (Set.range F) (fun F₀ hF₀ hF₀h => hWspan F₀ ⟨hF₀, hF₀h⟩)
    unfold wcpaDjFlrgGood
    refine ⟨hDaff, mm, F, hmi, hmd, hFh, hFc, ?_, ?_⟩
    · intro q hq e he
      have hqV : q ∈ V j := B.basicOpen_le s hq
      have h1 := hilb_span r (B.presheaf.map (homOfLE (B.basicOpen_le s)).op).hom
        (B.presheaf.germ (B.basicOpen s) q hq ≫ B.residue q).hom _ F hFspan hWspan
      have h2 : (B.presheaf.germ (B.basicOpen s) q hq ≫ B.residue q).hom.comp
          (B.presheaf.map (homOfLE (B.basicOpen_le s)).op).hom =
          (B.presheaf.germ (V j) q hqV ≫ B.residue q).hom := by
        rw [← CommRingCat.hom_comp, TopCat.Presheaf.germ_res_assoc]
      rw [h1, h2]
      exact hfib j q hqV e he
    · intro t
      have liftW :=
        wcpa_dj_flrg_gc_sat_basicOpen_lift k N B Z sB jZ g hZ hε (B.basicOpen s) hDaff t
      have hres : ∀ F' ∈ wcpaDjFlrgSat k N sB jZ g hZ (B.basicOpen s),
          MvPolynomial.map (B.presheaf.map (homOfLE (B.basicOpen_le t)).op).hom F' ∈
            wcpaDjFlrgSat k N sB jZ g hZ (B.basicOpen t) := fun F' hF' =>
        wcpa_dj_flrg_gc_sat_restrict k N B Z sB jZ g hZ (B.basicOpen s) (B.basicOpen t)
          (B.basicOpen_le t) F' hF'
      refine ⟨fun e he => transfer_gen _ _ _ liftW hres e (hDgen e he),
        fun a => hres _ (hFsat a), ?_⟩
      refine transfer_span _ _ _ liftW e₀ _ ?_
      intro F₀ hF₀ hF₀h
      have h1 := map_span (B.presheaf.map (homOfLE (B.basicOpen_le t)).op).hom _ _
        (hDspan F₀ hF₀ hF₀h)
      rw [← Set.range_comp] at h1
      exact h1

  choose Dp hpD hGood using hC
  obtain ⟨t₀, ht₀⟩ := CompactSpace.elim_nhds_subcover (fun p => (Dp p : Set B))
    (fun p => (Dp p).isOpen.mem_nhds (hpD p))
  refine ⟨t₀.card, fun l => Dp (t₀.equivFin.symm l), ?_, fun l => hGood _⟩
  apply eq_top_iff.mpr
  intro x _
  have hx : x ∈ ⋃ p ∈ t₀, (Dp p : Set B) := by rw [ht₀]; simp
  obtain ⟨p, hp, hxp⟩ := Set.mem_iUnion₂.mp hx
  rw [TopologicalSpace.Opens.mem_iSup]
  refine ⟨t₀.equivFin ⟨p, hp⟩, ?_⟩
  simpa using hxp

theorem wcpa_dj_flrg_overlap_transition : ∀ (k : Type u) [Field k] (N : ℕ) (B Z : Scheme.{u}) (sB : B ⟶ Spec (.of k)) (jZ : Z ⟶ wcProjK k N) (g : Z ⟶ B) (hZ : jZ ≫ wcProjKStr k N = g ≫ sB) (e₀ r : ℕ) (D D' : B.Opens) (m : Fin r → (Fin (N + 1) →₀ ℕ)) (F : Fin r → MvPolynomial (Fin (N + 1)) Γ(B, D)) (F' : Fin r → MvPolynomial (Fin (N + 1)) Γ(B, D')), IsAffineOpen D → IsAffineOpen D' → (∀ a a', (F a).coeff (m a') = if a = a' then 1 else 0) → (∀ (t : Γ(B, D)) (G : MvPolynomial (Fin (N + 1)) Γ(B, B.basicOpen t)), G ∈ wcpaDjFlrgSat k N sB jZ g hZ (B.basicOpen t) → G.IsHomogeneous e₀ → G ∈ Submodule.span Γ(B, B.basicOpen t) (Set.range fun a => MvPolynomial.map (B.presheaf.map (homOfLE (B.basicOpen_le t)).op).hom (F a))) → (∀ (t' : Γ(B, D')) (a : Fin r), MvPolynomial.map (B.presheaf.map (homOfLE (B.basicOpen_le t')).op).hom (F' a) ∈ wcpaDjFlrgSat k N sB jZ g hZ (B.basicOpen t')) → (∀ a, (F' a).IsHomogeneous e₀) → ∀ (O : B.Opens) (hO : O ≤ D) (hO' : O ≤ D') (a : Fin r) (b : Fin (N + 1) →₀ ℕ), (B.presheaf.map (homOfLE hO').op).hom ((F' a).coeff b) = ∑ a', (B.presheaf.map (homOfLE hO').op).hom ((F' a).coeff (m a')) * (B.presheaf.map (homOfLE hO).op).hom ((F a').coeff b) :=
by
  intro k _ N B Z sB jZ g hZ e₀ r D D' m F F' hD hD' hnorm hspan hmem hhom O hO hO' a b
  classical

  have s1 : ∀ {R : Type u} [CommRing R] (Fs : Fin r → MvPolynomial (Fin (N + 1)) R)
      (G : MvPolynomial (Fin (N + 1)) R),
      (∀ a a', (Fs a).coeff (m a') = if a = a' then 1 else 0) →
      G ∈ Submodule.span R (Set.range Fs) →
      ∀ b, G.coeff b = ∑ a', G.coeff (m a') * (Fs a').coeff b := by
    intro R _ Fs G hn hG b
    obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun R).mp hG
    have hc : ∀ b, (∑ i, c i • Fs i).coeff b = ∑ i, c i * (Fs i).coeff b := by
      intro b
      rw [MvPolynomial.coeff_sum]
      simp only [MvPolynomial.coeff_smul, smul_eq_mul]
    have hcm : ∀ a', (∑ i, c i • Fs i).coeff (m a') = c a' := by
      intro a'
      rw [hc]
      simp [hn]
    rw [hc b]
    simp only [hcm]

  have gr : ∀ (x : B) (U V : B.Opens) (i : U ≤ V) (hxU : x ∈ U) (s : Γ(B, V)),
      (B.presheaf.germ U x hxU).hom ((B.presheaf.map (homOfLE i).op).hom s) =
        (B.presheaf.germ V x (i hxU)).hom s := by
    intro x U V i hxU s
    exact congrArg (fun φ => φ.hom s) (B.presheaf.germ_res (homOfLE i) x hxU)
  refine TopCat.Presheaf.section_ext B.sheaf O _ _ (fun x hx => ?_)
  change (B.presheaf.germ O x hx).hom _ = (B.presheaf.germ O x hx).hom _
  obtain ⟨f, t', hft, hxf⟩ := exists_basicOpen_le_affine_inter hD hD' x ⟨hO hx, hO' hx⟩
  have hWD' : B.basicOpen f ≤ D' := hft ▸ B.basicOpen_le t'
  have key : ∀ (W₀ : B.Opens) (h : W₀ ≤ D'), W₀ = B.basicOpen t' →
      MvPolynomial.map (B.presheaf.map (homOfLE h).op).hom (F' a) ∈
        wcpaDjFlrgSat k N sB jZ g hZ W₀ := by
    rintro W₀ h rfl
    exact hmem t' a
  have hmemW := key _ hWD' hft
  have hspanW := hspan f _ hmemW ((hhom a).map _)
  have hnormW : ∀ a a', (MvPolynomial.map (B.presheaf.map (homOfLE (B.basicOpen_le f)).op).hom
      (F a)).coeff (m a') = if a = a' then 1 else 0 := by
    intro a a'
    rw [MvPolynomial.coeff_map, hnorm]
    split_ifs <;> simp
  have hW := s1 (fun a => MvPolynomial.map (B.presheaf.map (homOfLE (B.basicOpen_le f)).op).hom
      (F a)) _ hnormW hspanW b
  simp only [MvPolynomial.coeff_map] at hW
  have hW2 := congrArg (B.presheaf.germ (B.basicOpen f) x hxf).hom hW
  simp only [map_sum, map_mul, gr] at hW2
  simp only [map_sum, map_mul, gr]
  exact hW2

theorem wcpa_dj_flrg_h1_criterion : ∀ (k : Type u) [Field k] (N : ℕ) (B Z : Scheme.{u}) (sB : B ⟶ Spec (.of k)) (jZ : Z ⟶ wcProjK k N) (g : Z ⟶ B) (hZ : jZ ≫ wcProjKStr k N = g ≫ sB), IsClosedImmersion (Limits.pullback.lift jZ g hZ) → ∀ (e₀ r : ℕ) (V : B.Opens) (H : Fin r → MvPolynomial (Fin (N + 1)) Γ(B, V)), IsAffineOpen V → (∀ a, (H a).IsHomogeneous e₀) → (∀ p ∈ V, ∃ (W : B.Opens) (hW : W ≤ V) (f : Γ(B, V)), B.basicOpen f = W ∧ p ∈ W ∧ (∀ a, MvPolynomial.map (B.presheaf.map (homOfLE hW).op).hom (H a) ∈ wcpaDjFlrgSat k N sB jZ g hZ W) ∧ (∀ e, e₀ ≤ e → wcpaDjGen N (wcpaDjFlrgSat k N sB jZ g hZ W) e) ∧ (∀ G ∈ wcpaDjFlrgSat k N sB jZ g hZ W, G.IsHomogeneous e₀ → G ∈ Submodule.span Γ(B, W) (Set.range fun a => MvPolynomial.map (B.presheaf.map (homOfLE hW).op).hom (H a)))) → ∀ i : Fin (N + 1), RingHom.ker ((Limits.pullback.lift jZ g hZ).app (wcpaDjFlrgChart k N sB V i)).hom = Ideal.span (Set.range fun a => wcpaDjFlrgPsi k N sB V i (H a)) :=
by
  intro k _ N B Z sB jZ g hZ hε e₀ r V H hV hH hLOC i
  classical

  have sgE11 : ∀ j : Fin (N + 1), wcSgE k N j j = 1 := by
    intro j
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
      MvPolynomial.gradedAlgebra
    have hX : ∀ l : Fin (N + 1), (MvPolynomial.X l : MvPolynomial (Fin (N + 1)) k) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1 := fun l =>
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ l)
    have h1 : HomogeneousLocalization.Away.mk
