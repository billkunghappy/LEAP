theorem wc_flat_generic_lift_off_closed (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IrreducibleSpace Y]
    (n m : ℕ) (hmn : m < n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [SmoothOfRelativeDimension m (i ≫ pY)]
    {U : Scheme.{u}} (g : U ⟶ Y) [Flat g] :
    ∀ u : U, ∃ x : U, x ⤳ u ∧ g x ∉ Set.range i :=
by
  intro u
  obtain ⟨x, hxu, hxη⟩ := Flat.generalizingMap g (genericPoint_specializes (g u))
  refine ⟨x, hxu, ?_⟩
  rw [hxη]
  intro hη
  have hcl : IsClosed (Set.range i) := i.isClosedEmbedding.isClosed_range
  have hsurj : Function.Surjective i := fun y =>
    (genericPoint_specializes y).mem_closed hcl hη
  have hhom : IsHomeomorph i :=
    isHomeomorph_iff_isEmbedding_surjective.mpr ⟨i.isClosedEmbedding.isEmbedding, hsurj⟩
  have hdim : topologicalKrullDim Z = topologicalKrullDim Y :=
    IsHomeomorph.topologicalKrullDim_eq i hhom
  have h1 := wc_smooth_irreducible_dim_ge K Y pY n
  have h2 := wc_smooth_alg_closed_dim_le K Z (i ≫ pY) m
  rw [← hdim] at h1
  have h3 : (n : WithBot ℕ∞) ≤ (m : WithBot ℕ∞) := h1.trans h2
  have h4 : n ≤ m := by exact_mod_cast h3
  omega

theorem wc_supp_hom_zero_of_dense {T S : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (j : T ⟶ S) [IsClosedImmersion j] (D : wcHMPullData j ℓ) (hD : wcHMPullCanonical D)
    (hepi : Epi (wcSuppUnitMap D))
    (hdense : ∀ U : S.ProEt, Dense {x : ↥U.left | U.hom x ∉ Set.range j}) :
    ∀ φ : wcSuppObj D ⟶ SheafOfModules.unit (wcRingSheaf S ℓ), φ = 0 :=
by
  classical
  intro φ
  haveI := hepi
  let Os : S.Opens := ⟨(Set.range j)ᶜ, j.isClosedEmbedding.isClosed_range.isOpen_compl⟩
  have hψ : wcSuppUnitMap D ≫ φ = 0 := by
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext X
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    refine Eq.trans (b := (0 : ↑((SheafOfModules.unit (wcRingSheaf S ℓ)).val.obj X))) ?_ ?_
    swap
    · symm
      first
        | rfl
        | simp
    obtain ⟨U⟩ := X
    let U' : S.ProEt := wcOpenRestr S Os U
    let ι : U' ⟶ U := wcOpenRestrIncl S Os U
    have h2 : ∀ p : ↥(Limits.pullback Os.ι U.hom),
        (Limits.pullback.snd Os.ι U.hom ≫ U.hom) p = Os.ι ((Limits.pullback.fst Os.ι U.hom) p) := by
      intro p
      rw [← Limits.pullback.condition, Scheme.Hom.comp_apply]
    have hempty : IsEmpty ↥(Limits.pullback U'.hom j) := by
      refine ⟨fun q => ?_⟩
      have h1 : (Limits.pullback.fst U'.hom j ≫ U'.hom) q =
          (Limits.pullback.snd U'.hom j ≫ j) q := by
        rw [Limits.pullback.condition]
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h1
      have h5 := h2 ((Limits.pullback.fst U'.hom j) q)
      have h6 : Os.ι ((Limits.pullback.fst Os.ι U.hom) ((Limits.pullback.fst U'.hom j) q)) =
          j ((Limits.pullback.snd U'.hom j) q) := h5.symm.trans h1
      have h3 : Os.ι ((Limits.pullback.fst Os.ι U.hom) ((Limits.pullback.fst U'.hom j) q)) ∈
          (Os : Set ↥S) := by
        rw [← Scheme.Opens.range_ι]
        exact ⟨_, rfl⟩
      rw [h6] at h3
      exact h3 ⟨_, rfl⟩
    haveI hsub : Subsingleton ((wcSuppObj D).val.obj (Opposite.op U')) := by
      change Subsingleton C(↥(Limits.pullback U'.hom j), ULift.{u+1} ℚ_[ℓ])
      infer_instance
    have hU' : (ConcreteCategory.hom ((wcSuppUnitMap D ≫ φ).val.app (Opposite.op U')))
        (1 : C(↥U'.left, ULift.{u+1} ℚ_[ℓ])) = 0 := by
      have e : (ConcreteCategory.hom ((wcSuppUnitMap D ≫ φ).val.app (Opposite.op U')))
          (1 : C(↥U'.left, ULift.{u+1} ℚ_[ℓ])) =
          (ConcreteCategory.hom (φ.val.app (Opposite.op U')))
            ((ConcreteCategory.hom ((wcSuppUnitMap D).val.app (Opposite.op U')))
              (1 : C(↥U'.left, ULift.{u+1} ℚ_[ℓ]))) := rfl
      rw [e, Subsingleton.elim ((ConcreteCategory.hom ((wcSuppUnitMap D).val.app
        (Opposite.op U'))) (1 : C(↥U'.left, ULift.{u+1} ℚ_[ℓ]))) 0, map_zero]
    let σ : C(↥U.left, ULift.{u+1} ℚ_[ℓ]) :=
      (ConcreteCategory.hom ((wcSuppUnitMap D ≫ φ).val.app (Opposite.op U)))
        (1 : C(↥U.left, ULift.{u+1} ℚ_[ℓ]))
    have key : ∀ x' : ↥U'.left, σ (ι.left x') = 0 := by
      intro x'
      have hn := (PresheafOfModules.naturality_apply (wcSuppUnitMap D ≫ φ).val ι.op
        (1 : C(↥U.left, ULift.{u+1} ℚ_[ℓ]))).symm
      have h1 : (ConcreteCategory.hom ((SheafOfModules.unit (wcRingSheaf S ℓ)).val.map ι.op)) σ =
          0 := hn.trans hU'
      have h4 := congrArg (fun f : C(↥U'.left, ULift.{u+1} ℚ_[ℓ]) => f x') h1
      exact h4
    have hσ : σ = 0 := by
      have heq : (σ : ↥U.left → ULift.{u+1} ℚ_[ℓ]) =
          ((0 : C(↥U.left, ULift.{u+1} ℚ_[ℓ])) : ↥U.left → ULift.{u+1} ℚ_[ℓ]) :=
        Continuous.ext_on (hdense U) σ.continuous (map_continuous _) (fun x hx => by
          have hx' : x ∈ Set.range (Limits.pullback.snd Os.ι U.hom) := by
            rw [Scheme.Pullback.range_snd, Scheme.Opens.range_ι]
            exact hx
          obtain ⟨x', rfl⟩ := hx'
          exact key x')
      exact DFunLike.coe_injective heq
    exact hσ
  exact (cancel_epi (wcSuppUnitMap D)).mp (hψ.trans Limits.comp_zero.symm)

theorem wc_weaklyEtale_smooth_stalk_isDomain (K : Type u) [Field K] {Y : Scheme.{u}}
    (pY : Y ⟶ Spec (.of K)) (n : ℕ) [SmoothOfRelativeDimension n pY]
    (V : Y.ProEt) (z : V.left)
    (hsh : HenselianLocalRing (V.left.presheaf.stalk z) ∧ IsSepClosed (V.left.residueField z)) :
    IsDomain (V.left.presheaf.stalk z) :=
by
  classical

  have hL2 : ∀ {X' Y' : Scheme.{u}} (g : X' ⟶ Y'), WeaklyEtale g → ∀ x : X',
      @Algebra.WeaklyEtale (Y'.presheaf.stalk (g x)) (X'.presheaf.stalk x) _ _
        (g.stalkMap x).hom.toAlgebra := by
    intro X' Y' g hg x
    have h1 := wc_lfi_fromSpecStalk_weaklyEtale X' x
    have h2 := wc_lfi_fromSpecStalk_weaklyEtale Y' (g x)
    have h3 : WeaklyEtale (X'.fromSpecStalk x ≫ g) :=
      @MorphismProperty.comp_mem _ _ @WeaklyEtale
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ h1 hg
    rw [← Scheme.SpecMap_stalkMap_fromSpecStalk] at h3
    have h4 : WeaklyEtale (Spec.map (g.stalkMap x)) :=
      WeaklyEtale.of_comp _ (Y'.fromSpecStalk (g x))
    exact wc_lpkt_specMap_weaklyEtale_ring _ _ (g.stalkMap x).hom h4

  have hL1 : ∀ (C R : Type u) [CommRing C] [IsDomain C] [IsIntegrallyClosed C] [CommRing R]
      [IsLocalRing R] (σ : C →+* R), wcIndEtale σ → IsDomain R := by
    intro C R _ _ _ _ _ σ hσ
    letI : Algebra C R := σ.toAlgebra
    have hnzd : NoZeroDivisors R := by
      refine ⟨fun {a b} hab => ?_⟩
      let I : Ideal (MvPolynomial (Fin 2) C) :=
        Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) C)}
      haveI : Algebra.FinitePresentation C (MvPolynomial (Fin 2) C ⧸ I) :=
        Algebra.FinitePresentation.quotient (Submodule.fg_span_singleton _)
      have hI : ∀ p ∈ I, MvPolynomial.aeval ![a, b] p = 0 := by
        intro p hp
        obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hp
        simp [hab]
      obtain ⟨E, _, _, hEt, α, β, hβα⟩ :=
        hσ (MvPolynomial (Fin 2) C ⧸ I) (Ideal.Quotient.liftₐ I (MvPolynomial.aeval ![a, b]) hI)
      have hX0 : Ideal.Quotient.liftₐ I (MvPolynomial.aeval ![a, b]) hI
          (Ideal.Quotient.mk I (MvPolynomial.X 0)) = a := by
        show MvPolynomial.aeval ![a, b] (MvPolynomial.X 0) = a
        simp
      have hX1 : Ideal.Quotient.liftₐ I (MvPolynomial.aeval ![a, b]) hI
          (Ideal.Quotient.mk I (MvPolynomial.X 1)) = b := by
        show MvPolynomial.aeval ![a, b] (MvPolynomial.X 1) = b
        simp
      have hab' : α (Ideal.Quotient.mk I (MvPolynomial.X 0)) *
          α (Ideal.Quotient.mk I (MvPolynomial.X 1)) = 0 := by
        rw [← map_mul, ← map_mul,
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _), map_zero]
      let q : Ideal E := Ideal.comap β (IsLocalRing.maximalIdeal R)
      haveI : q.IsPrime := Ideal.comap_isPrime _ _
      haveI : IsDomain (Localization.AtPrime q) := wc_ring_etale_localization_isDomain C E q
      have hunit : ∀ s : q.primeCompl, IsUnit ((β : E →+* R) (s : E)) := by
        intro s
        exact IsLocalRing.notMem_maximalIdeal.mp
          (fun hm => (Ideal.mem_primeCompl_iff.mp s.2) (Ideal.mem_comap.mpr hm))
      have hβ' : ∀ e : E, IsLocalization.lift (M := q.primeCompl) (S := Localization.AtPrime q)
          hunit (algebraMap E (Localization.AtPrime q) e) = β e :=
        fun e => IsLocalization.lift_eq hunit e
      have hprod : algebraMap E (Localization.AtPrime q) (α (Ideal.Quotient.mk I (MvPolynomial.X 0))) *
          algebraMap E (Localization.AtPrime q) (α (Ideal.Quotient.mk I (MvPolynomial.X 1))) = 0 := by
        rw [← map_mul, hab', map_zero]
      rcases mul_eq_zero.mp hprod with h0 | h0
      · left
        rw [← hX0, ← hβα, AlgHom.comp_apply, ← hβ', h0, map_zero]
      · right
        rw [← hX1, ← hβα, AlgHom.comp_apply, ← hβ', h0, map_zero]
    exact NoZeroDivisors.to_isDomain R

  haveI hgWE : WeaklyEtale V.hom := V.prop
  haveI : Smooth pY := SmoothOfRelativeDimension.smooth n pY
  haveI hKdom : IsDomain K := DivisionRing.isDomain
  haveI hKic : IsIntegrallyClosed K := inferInstance
  haveI hKnoeth : IsNoetherianRing K := inferInstance
  obtain ⟨hCdom, hCic⟩ := @wc_fntame_smooth_stalk_normal K _ hKdom hKic hKnoeth Y pY _ (V.hom z)
  letI algCB : Algebra (Y.presheaf.stalk (V.hom z)) (V.left.presheaf.stalk z) :=
    (V.hom.stalkMap z).hom.toAlgebra
  have hWE_CB : Algebra.WeaklyEtale (Y.presheaf.stalk (V.hom z)) (V.left.presheaf.stalk z) :=
    hL2 V.hom hgWE z
  haveI : HenselianLocalRing (V.left.presheaf.stalk z) := hsh.1
  have hsep : IsSepClosed (IsLocalRing.ResidueField (V.left.presheaf.stalk z)) := hsh.2
  obtain ⟨R, _, σ, ρ, _, hρσ, hRh, hRsep, hρloc, hσ⟩ :=
    wc_strict_hull (Y.presheaf.stalk (V.hom z)) (V.left.presheaf.stalk z) hsep
  letI : Algebra (Y.presheaf.stalk (V.hom z)) R := σ.toAlgebra
  letI : Algebra R (V.left.presheaf.stalk z) := ρ.toAlgebra
  haveI : IsScalarTower (Y.presheaf.stalk (V.hom z)) R (V.left.presheaf.stalk z) :=
    IsScalarTower.of_algebraMap_eq' hρσ.symm
  have hWE_CR : Algebra.WeaklyEtale (Y.presheaf.stalk (V.hom z)) R :=
    wc_indEtale_weaklyEtale σ hσ
  have hWE_RB : Algebra.WeaklyEtale R (V.left.presheaf.stalk z) :=
    wc_weaklyEtale_cancel _ _ _ hWE_CR hWE_CB
  have hbij : Function.Bijective ρ :=
    wc_olivier R (V.left.presheaf.stalk z) hRh hRsep hρloc hWE_RB
  haveI : IsDomain R := hL1 _ R σ hσ
  exact MulEquiv.isDomain R (RingEquiv.ofBijective ρ hbij).symm.toMulEquiv

theorem wc_wlocal_open_contfun_extend {V : Scheme.{u}}
    (hV : IsAffine V ∧ IsClosed {x : V | IsClosed ({x} : Set V)} ∧
      (∀ x : V, ∃! y : V, IsClosed ({y} : Set V) ∧ x ⤳ y) ∧
      ExtremallyDisconnected {x : V | IsClosed ({x} : Set V)})
    (hdom : ∀ z : V, IsClosed ({z} : Set V) → IsDomain (V.presheaf.stalk z))
    (O : V.Opens) (hOc : IsCompact (O : Set V))
    (hgen : ∀ z : V, IsClosed ({z} : Set V) → ∃ x ∈ (O : Set V), x ⤳ z)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (f : C(↥O.toScheme, ULift.{u+1} ℚ_[ℓ])) :
    ∃ g : C(↥V, ULift.{u+1} ℚ_[ℓ]), g.comp O.ι.base.hom = f :=
by
  classical
  haveI : IsAffine V := hV.1

  have hcl : ∀ S : Set V, IsCompact S → IsOpen S → ∀ y ∈ closure S, ∃ x ∈ S, x ⤳ y := by
    intro S hSc hSo y hy
    let e : V ≃ₜ PrimeSpectrum Γ(V, ⊤) := Scheme.homeoOfIso V.isoSpec
    have key : ∀ S' : Set (PrimeSpectrum Γ(V, ⊤)), IsCompact S' → IsOpen S' →
        ∀ y' ∈ closure S', ∃ x' ∈ S', x' ⤳ y' := by
      intro S' hc ho y' hy'
      obtain ⟨t, ht⟩ := PrimeSpectrum.isCompact_isOpen_iff.mp ⟨hc, ho⟩
      have hU : S' = ⋃ a ∈ t, (PrimeSpectrum.basicOpen a : Set (PrimeSpectrum Γ(V, ⊤))) := by
        rw [← ht]
        ext p
        simp only [Set.mem_compl_iff, PrimeSpectrum.mem_zeroLocus, Set.not_subset,
          Set.mem_iUnion, SetLike.mem_coe, PrimeSpectrum.mem_basicOpen, exists_prop]
      rw [hU, Finset.closure_biUnion] at hy'
      obtain ⟨a, hat, hya⟩ := Set.mem_iUnion₂.mp hy'
      by_cases h0 : (0 : Γ(V, ⊤)) ∈ y'.asIdeal.primeCompl ⊔ Submonoid.powers a
      · exfalso
        obtain ⟨s, hs, w, hw, hsw⟩ := Submonoid.mem_sup.mp h0
        obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hw
        rw [mem_closure_iff] at hya
        have hs' : y' ∈ (PrimeSpectrum.basicOpen s : Set (PrimeSpectrum Γ(V, ⊤))) := by
          rw [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen]
          exact Ideal.mem_primeCompl_iff.mp hs
        obtain ⟨q, hqs, hqa⟩ := hya _ (PrimeSpectrum.basicOpen s).isOpen hs'
        rw [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen] at hqs hqa
        have hmem : s * a ^ n ∈ q.asIdeal := by rw [hsw]; exact q.asIdeal.zero_mem
        rcases q.isPrime.mem_or_mem hmem with h | h
        · exact hqs h
        · exact hqa (q.isPrime.mem_of_pow_mem n h)
      · obtain ⟨p, hp, -, hdisj⟩ := Ideal.exists_le_prime_disjoint (⊥ : Ideal Γ(V, ⊤))
          (y'.asIdeal.primeCompl ⊔ Submonoid.powers a) (by
            rw [Set.disjoint_left]
            intro r hr hrM
            rw [SetLike.mem_coe, Ideal.mem_bot] at hr
            subst hr
            exact h0 hrM)
        rw [hU]
        refine ⟨⟨p, hp⟩, Set.mem_iUnion₂.mpr ⟨a, hat, ?_⟩, ?_⟩
        · rw [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen]
          intro hap
          exact Set.disjoint_left.mp hdisj hap (Submonoid.mem_sup_right (Submonoid.mem_powers a))
        · rw [← PrimeSpectrum.le_iff_specializes]
          intro r hr
          by_contra hry
          exact Set.disjoint_left.mp hdisj hr
            (Submonoid.mem_sup_left (Ideal.mem_primeCompl_iff.mpr hry))
    obtain ⟨x', hx', hxy⟩ := key (e '' S) (hSc.image e.continuous) (e.isOpenMap S hSo) (e y)
      (by rw [← e.image_closure]; exact Set.mem_image_of_mem e hy)
    obtain ⟨x, hx, rfl⟩ := hx'
    exact ⟨x, hx, e.isInducing.specializes_iff.mp hxy⟩

  have hT : ∀ W : Set (ULift.{u+1} ℚ_[ℓ]), IsOpen W → ∀ t ∈ W,
      ∃ B : Set (ULift.{u+1} ℚ_[ℓ]), IsClopen B ∧ t ∈ B ∧ B ⊆ W := by
    intro W hW t ht
    let h : ULift.{u+1} ℚ_[ℓ] ≃ₜ ℚ_[ℓ] := Homeomorph.ulift
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.mp (h.isOpenMap W hW) (h t)
      (Set.mem_image_of_mem h ht)
    refine ⟨h ⁻¹' Metric.ball (h t) ε,
      IsClopen.preimage ⟨IsUltrametricDist.isClosed_ball _ _, Metric.isOpen_ball⟩ h.continuous,
      Metric.mem_ball_self hε, ?_⟩
    intro b hb
    obtain ⟨w, hw, hwb⟩ := hball hb
    rw [h.injective hwb] at hw
    exact hw

  have hgg : ∀ z : V, IsClosed ({z} : Set V) → ∃ η : V, ∀ y : V, y ⤳ z → η ⤳ y := by
    intro z hz
    haveI := hdom z hz
    refine ⟨V.fromSpecStalk z ⟨⊥, Ideal.isPrime_bot⟩, fun y hy => ?_⟩
    have hr : y ∈ Set.range (V.fromSpecStalk z) := by
      rw [Scheme.range_fromSpecStalk]; exact hy
    obtain ⟨p, rfl⟩ := hr
    exact ((PrimeSpectrum.le_iff_specializes _ _).mp bot_le).map (V.fromSpecStalk z).continuous

  choose c hc using fun x => (hV.2.2.1 x).exists
  choose η hη using hgg
  let e : V → V := fun x => η (c x) (hc x).1
  have he2 : ∀ x x', x' ⤳ x → e x ⤳ x' := fun x x' hx' =>
    hη (c x) (hc x).1 x' (hx'.trans (hc x).2)
  have he1 : ∀ x, e x ∈ (O : Set V) := by
    intro x
    obtain ⟨w, hwO, hwz⟩ := hgen (c x) (hc x).1
    exact (hη _ _ w hwz).mem_open O.isOpen hwO
  have he0 : ∀ x, e x ⤳ x := fun x => he2 x x specializes_rfl
  let f' : C(O, ULift.{u+1} ℚ_[ℓ]) := ⟨f, f.continuous⟩
  let G : V → ULift.{u+1} ℚ_[ℓ] := fun x => f' ⟨e x, he1 x⟩
  have hext : ∀ x : O, G x.1 = f' x := by
    intro x
    have h1 : (⟨e x.1, he1 x.1⟩ : O) ⤳ x :=
      Topology.IsInducing.subtypeVal.specializes_iff.mp (he0 x.1)
    exact (h1.map f'.continuous).eq
  have hpre : ∀ B : Set (ULift.{u+1} ℚ_[ℓ]), IsClopen B → IsOpen (G ⁻¹' B) := by
    intro B hB
    have hAc : IsClopen (f' ⁻¹' Bᶜ) := hB.compl.preimage f'.continuous
    have hSo : IsOpen (Subtype.val '' (f' ⁻¹' Bᶜ) : Set V) :=
      O.isOpen.isOpenMap_subtype_val _ hAc.isOpen
    haveI : CompactSpace O := isCompact_iff_compactSpace.mp hOc
    have hSc : IsCompact (Subtype.val '' (f' ⁻¹' Bᶜ) : Set V) :=
      hAc.isClosed.isCompact.image continuous_subtype_val
    have hmem : ∀ x, e x ∈ (Subtype.val '' (f' ⁻¹' Bᶜ) : Set V) ↔ G x ∉ B := by
      intro x
      constructor
      · rintro ⟨a, ha, hae⟩
        have : a = ⟨e x, he1 x⟩ := Subtype.ext hae
        subst this
        exact ha
      · intro h
        exact ⟨⟨e x, he1 x⟩, h, rfl⟩
    have hS : G ⁻¹' B = (closure (Subtype.val '' (f' ⁻¹' Bᶜ) : Set V))ᶜ := by
      ext x
      simp only [Set.mem_preimage, Set.mem_compl_iff]
      constructor
      · intro hGx hxS
        obtain ⟨x', hx'S, hx'x⟩ := hcl _ hSc hSo x hxS
        exact (hmem x).mp ((he2 x x' hx'x).mem_open hSo hx'S) hGx
      · intro hxS
        by_contra hGx
        exact hxS (closure_mono (Set.singleton_subset_iff.mpr ((hmem x).mpr hGx))
          (specializes_iff_mem_closure.mp (he0 x)))
    rw [hS]
    exact isClosed_closure.isOpen_compl
  have hGc : Continuous G := by
    rw [continuous_def]
    intro W hW
    rw [isOpen_iff_forall_mem_open]
    intro x hx
    obtain ⟨B, hB, hxB, hBW⟩ := hT W hW (G x) hx
    exact ⟨G ⁻¹' B, Set.preimage_mono hBW, hpre B hB, hxB⟩
  refine ⟨⟨G, hGc⟩, ContinuousMap.ext fun x => ?_⟩
  exact hext x

theorem wc_hm_zero_pull_surj_of_contfun_extend {S S' : Scheme.{u}} (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (h : S' ⟶ S) (Dh : wcHMPullData h ℓ) (hDh : wcHMPullCanonical Dh)
    (hext : ∀ f : C(↥S', ULift.{u+1} ℚ_[ℓ]), ∃ g : C(↥S, ULift.{u+1} ℚ_[ℓ]), g.comp h.base.hom = f) :
    ∀ α : wcHM S' ℓ 0, ∃ x : wcHM S ℓ 0, wcHMPull Dh 0 x = α :=
by
  classical
  intro α
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
  obtain ⟨ψ, rfl⟩ := (@Abelian.Ext.mk₀_bijective _ _ _ (HasExt.standard _) _ _).2 α

  let R := wcRingSheaf S' ℓ
  let sψ := (SheafOfModules.unit R).unitHomEquiv ψ
  let σ : ∀ X : (S'.ProEt)ᵒᵖ, R.obj.obj X := fun X => (sψ.1 X : R.obj.obj X)
  have hσ : ∀ {X Y : (S'.ProEt)ᵒᵖ} (f : X ⟶ Y), (R.obj.map f).hom (σ X) = σ Y :=
    fun f => PresheafOfModules.sections_property sψ f
  let T : S'.ProEt := MorphismProperty.Over.mk ⊤ (𝟙 S') (inferInstance : WeaklyEtale (𝟙 S'))
  let s : C(↥S', ULift.{u+1} ℚ_[ℓ]) := σ (Opposite.op T)
  have hψ : ψ = wcHMFun S' ℓ s := by
    apply (SheafOfModules.unit R).unitHomEquiv.injective
    unfold wcHMFun
    rw [Equiv.apply_symm_apply]
    apply PresheafOfModules.sections_ext
    intro X
    let V := X.unop
    let φ : V ⟶ T := MorphismProperty.Over.homMk (B := T) V.hom (Category.comp_id _) trivial
    have h1 : (s.comp V.hom.base.hom : C(↥V.left, ULift.{u+1} ℚ_[ℓ])) =
        (σ (Opposite.op V) : C(↥V.left, ULift.{u+1} ℚ_[ℓ])) := hσ φ.op
    exact h1.symm
  obtain ⟨r, hr⟩ := hext s
  refine ⟨Abelian.Ext.mk₀ (wcHMFun S ℓ r), ?_⟩

  have key : ∀ g : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC h) _ _ Dh.cont Dh.φ).obj
        (SheafOfModules.unit (wcRingSheaf S' ℓ)),
      wcHMFun S ℓ r ≫ g =
        g ≫ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC h) _ _ Dh.cont Dh.φ).map
          (wcHMFun S' ℓ (r.comp h.base.hom)) := by
    intro g
    apply (SheafOfModules.unitHomEquiv _).injective
    apply PresheafOfModules.sections_ext
    intro X
    cases X with
    | op V =>
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    obtain ⟨a, b, hab, ha1, ha2⟩ : ∃ (a : ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V)))
        (b : ↑((wcRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC h).obj V)))),
        @Eq ↑((wcRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC h).obj V)))
          ((Dh.φ.hom.app (Opposite.op V)).hom a) b ∧
        (∀ r' : ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V)),
          @Eq ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V))
            (((wcHMFun S ℓ r).val.app (Opposite.op V)).hom r') (r' * a)) ∧
        (∀ r' : ↑((wcRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC h).obj V))),
          @Eq ↑((wcRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC h).obj V)))
            (((wcHMFun S' ℓ (r.comp h.base.hom)).val.app
              (Opposite.op ((wcProEtBC h).obj V))).hom r') (r' * b)) :=
      ⟨(r.comp V.hom.base.hom : C(↥V.left, ULift.{u+1} ℚ_[ℓ])),
        ((r.comp h.base.hom).comp ((wcProEtBC h).obj V).hom.base.hom :
          C(↥((wcProEtBC h).obj V).left, ULift.{u+1} ℚ_[ℓ])),
        (hDh V _).trans (ContinuousMap.ext fun x =>
          congrArg (fun k => r (k.base x)) (Limits.pullback.condition (f := V.hom) (g := h))),
        fun r' => rfl, fun r' => rfl⟩
    change (g.val.app (Opposite.op V)).hom (((wcHMFun S ℓ r).val.app (Opposite.op V)).hom
          (@id ↑((SheafOfModules.unit (wcRingSheaf S ℓ)).val.obj (Opposite.op V))
            (1 : ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V))))) =
        ((wcHMFun S' ℓ (r.comp h.base.hom)).val.app (Opposite.op ((wcProEtBC h).obj V))).hom
          ((g.val.app (Opposite.op V)).hom
            (@id ↑((SheafOfModules.unit (wcRingSheaf S ℓ)).val.obj (Opposite.op V))
              (1 : ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V)))))
    have e1 : ((wcHMFun S ℓ r).val.app (Opposite.op V)).hom
          (@id ↑((SheafOfModules.unit (wcRingSheaf S ℓ)).val.obj (Opposite.op V))
            (1 : ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V)))) =
        a • (@id ↑((SheafOfModules.unit (wcRingSheaf S ℓ)).val.obj (Opposite.op V))
            (1 : ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V)))) := by
      have h0 := ha1 1
      change @Eq ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V))
        (((wcHMFun S ℓ r).val.app (Opposite.op V)).hom
          (1 : ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V))))
        (a * 1)
      rw [h0, one_mul, mul_one]
    rw [e1, LinearMap.map_smul]
    generalize (g.val.app (Opposite.op V)).hom
      (@id ↑((SheafOfModules.unit (wcRingSheaf S ℓ)).val.obj (Opposite.op V))
        (1 : ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V)))) = y
    have h2 := ha2 y
    refine Eq.trans ?_ h2.symm
    change @Eq ↑((wcRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC h).obj V)))
      (@HMul.hMul ↑((wcRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC h).obj V)))
        ↑((wcRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC h).obj V)))
        ↑((wcRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC h).obj V))) instHMul
        ((Dh.φ.hom.app (Opposite.op V)).hom a) y)
      (@HMul.hMul ↑((wcRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC h).obj V)))
        ↑((wcRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC h).obj V)))
        ↑((wcRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC h).obj V))) instHMul y b)
    rw [hab]
    exact @mul_comm C(↥(Limits.pullback V.hom h), ULift.{u+1} ℚ_[ℓ]) _ b y
  have hmate : Dh.Φ.map (wcHMFun S ℓ r) ≫ Dh.μ.hom =
      Dh.μ.hom ≫ wcHMFun S' ℓ (r.comp h.base.hom) := by
    apply (Dh.adj.homEquiv _ _).injective
    rw [Adjunction.homEquiv_naturality_left, Adjunction.homEquiv_naturality_right]
    exact key _
  haveI := Dh.additive
  haveI := Dh.presLim
  haveI := Dh.presColim
  show (Abelian.Ext.mk₀ Dh.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dh.Φ
        (Abelian.Ext.mk₀ (wcHMFun S ℓ r))).comp
        (Abelian.Ext.mk₀ Dh.μ.hom) (add_zero 0)) (zero_add 0) = Abelian.Ext.mk₀ ψ
  rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀,
    hmate, Iso.inv_hom_id_assoc, hr]
  exact congrArg Abelian.Ext.mk₀ hψ.symm

theorem wc_smooth_pair_wcontr_supp_low_vanish (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (V : Y.ProEt)
    (hV : IsAffine V.left ∧ IsClosed {x : V.left | IsClosed ({x} : Set V.left)} ∧
      (∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y) ∧
      ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)} ∧
      (∀ x : V.left, IsClosed ({x} : Set V.left) →
        HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x)))
    (DV : wcHMPullData (Limits.pullback.fst V.hom i) ℓ) (hDV : wcHMPullCanonical DV)
    (q : ℕ) (hq : q < 2 * r) :
    ∀ θ : wcSuppExt DV q, θ = 0 :=
by
  classical
  intro θ
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY
  haveI hVaff : IsAffine V.left := hV.1
  haveI hVwe : WeaklyEtale V.hom := V.prop
  have hVfl : Flat V.hom := inferInstance
  have hmn : m < n := by omega
  have hj : Set.range (Limits.pullback.fst V.hom i) = V.hom ⁻¹' Set.range i :=
    Scheme.Pullback.range_fst V.hom i

  have hqc : ∀ (W : Scheme.{u}) [IsAffine W] (p : W ⟶ V.left), ∃ (n : ℕ) (f : Fin n → Γ(W, ⊤)),
      ∀ x : ↥W, (p x ∉ Set.range (Limits.pullback.fst V.hom i) ↔ ∃ k, x ∈ W.basicOpen (f k)) := by
    intro W _ p
    obtain ⟨n', f, hf⟩ := wc_affine_complement_basicOpen_cover i W (p ≫ V.hom)
    refine ⟨n', f, fun x => ?_⟩
    have e : (p x ∉ Set.range (Limits.pullback.fst V.hom i)) ↔ ((p ≫ V.hom) x ∉ Set.range i) := by
      rw [hj, Scheme.Hom.comp_apply]
      exact Iff.rfl
    exact e.trans (hf x)
  have hrange_closed : IsClosed (Set.range (Limits.pullback.fst V.hom i)) :=
    (Limits.pullback.fst V.hom i).isClosedEmbedding.isClosed_range
  obtain ⟨O, hO⟩ : ∃ O : V.left.Opens,
      (O : Set V.left) = (Set.range (Limits.pullback.fst V.hom i))ᶜ :=
    ⟨⟨_, hrange_closed.isOpen_compl⟩, rfl⟩
  have hOc : IsCompact (O : Set V.left) := by
    obtain ⟨n', f, hf⟩ := wc_affine_complement_basicOpen_cover i V.left V.hom
    have e : (O : Set V.left) = ⋃ k, (V.left.basicOpen (f k) : Set V.left) := by
      ext x
      rw [hO, Set.mem_compl_iff, hj, Set.mem_iUnion]
      exact hf x
    rw [e]
    exact isCompact_iUnion fun k => ((isAffineOpen_top V.left).basicOpen (f k)).isCompact
  haveI hOcs : CompactSpace O.toScheme := isCompact_iff_compactSpace.mp hOc
  haveI hOsep : IsSeparated (Limits.terminal.from O.toScheme) := by
    have e : Limits.terminal.from O.toScheme = O.ι ≫ Limits.terminal.from V.left :=
      Limits.terminal.hom_ext _ _
    rw [e]
    infer_instance

  have c5 : ∀ (Y' : Scheme.{u}) [CompactSpace Y'] [IsSeparated (Limits.terminal.from Y')] (j' : ℕ),
      Subsingleton (wcEtCoh Y' ℓ (j' + 1)) → ∀ x : wcHM Y' ℓ (j' + 1), x = 0 := by
    intro Y' _ _ j' h5
    have hN4 : ∀ (m' : ℕ), Subsingleton (wcEtCoh Y' m' (j' + 1)) →
        ∀ y : Abelian.Ext (wcFreeSheaf Y' (Scheme.ProEt.mk (𝟙 Y'))) (wcZModSheaf Y' m') (j' + 1),
          y = 0 := by
      intro m' h y
      obtain ⟨-, hcont⟩ := wc_etToProEt_flat_cont Y'
      haveI := hcont
      letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y') AddCommGrpCat.{u+1}) := HasExt.standard _
      obtain ⟨E₀⟩ := wc_proet_etale_comparison_epsInv_qcsep Y'
        ((constantSheaf (Scheme.smallEtaleTopology Y') AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m')))) (j' + 1)
      let χ : (wcEpsInv Y').obj ((constantSheaf (Scheme.smallEtaleTopology Y')
            AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m')))) ≅
          wcZModSheaf Y' m' :=
        (wc_epsInv_const Y' (AddCommGrpCat.of (ULift.{u+1} (ZMod m')))).some ≪≫
          (wc_zmod_sheaf_const Y' m').some.symm
      have post : ∀ {A B B' : Sheaf (Scheme.ProEt.topology Y') AddCommGrpCat.{u+1}} (e : B ≅ B'),
          Nonempty (Abelian.Ext A B (j' + 1) ≃ Abelian.Ext A B' (j' + 1)) := by
        intro A B B' e
        refine ⟨{ toFun := fun y => y.comp (Abelian.Ext.mk₀ e.hom) (add_zero (j' + 1))
                  invFun := fun y => y.comp (Abelian.Ext.mk₀ e.inv) (add_zero (j' + 1))
                  left_inv := fun y => ?_
                  right_inv := fun y => ?_ }⟩
        · simp only
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero (j' + 1)) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
        · simp only
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero (j' + 1)) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
      obtain ⟨E₂⟩ := post (A := wcFreeSheaf Y' (Scheme.ProEt.mk (𝟙 Y'))) χ.symm
      let E : Abelian.Ext (wcFreeSheaf Y' (Scheme.ProEt.mk (𝟙 Y'))) (wcZModSheaf Y' m') (j' + 1) ≃
          wcEtCoh Y' m' (j' + 1) := E₂.trans E₀
      apply E.injective
      exact Subsingleton.elim _ _
    have h4 : ∀ k : ℕ, Subsingleton (wcEtCoh Y' (ℓ ^ (k + 1)) (j' + 1)) :=
      fun k => wc_et_coh_zmod_prime_pow_of_prime Y' ℓ (Fact.out) (j' + 1) h5 k
    haveI : QuasiSeparatedSpace Y' := (quasiSeparatedSpace_iff_quasiSeparated Y').2 inferInstance
    have h2 : ∀ k : ℕ, ∀ y : Abelian.Ext (wcFreeSheaf Y' (Scheme.ProEt.mk (𝟙 Y')))
        (wcZModSheaf Y' (ℓ ^ (k + 1))) (j' + 1), y = 0 :=
      fun k => hN4 (ℓ ^ (k + 1)) (h4 k)
    have h1 := wc_proet_int_ext_vanish_of_zmod_deg Y' ℓ (Scheme.ProEt.mk (𝟙 Y')) j' h2
    exact wc_hm_vanish_of_int_ext_vanish Y' ℓ j' h1

  have hgenY : ∀ {U' : Scheme.{u}} (g : U' ⟶ V.left), Flat (g ≫ V.hom) →
      ∀ u' : U', ∃ x : U', x ⤳ u' ∧ g x ∉ Set.range (Limits.pullback.fst V.hom i) := by
    intro U' g hfl u'
    haveI := hfl
    obtain ⟨x, hx, hxi⟩ := wc_flat_generic_lift_off_closed K pY n m hmn i (g ≫ V.hom) u'
    refine ⟨x, hx, ?_⟩
    rw [hj]
    exact fun h => hxi (by rw [Scheme.Hom.comp_apply]; exact h)
  obtain ⟨Do, hDo⟩ := wc_hm_pull_data_exists O.ι ℓ
  have hepi := wc_supp_unit_epi_of_closed (Limits.pullback.fst V.hom i) ℓ DV hDV
  rcases Nat.eq_zero_or_pos q with hq0 | hqpos
  ·
    subst hq0
    obtain ⟨φ, rfl⟩ := (@Abelian.Ext.mk₀_bijective _ _ _ (HasExt.standard _) _ _).2 θ
    have hφ := wc_supp_hom_zero_of_dense (Limits.pullback.fst V.hom i) DV hDV hepi (fun U => by
      rw [dense_iff_inter_open]
      rintro Ω hΩ ⟨u', hu'⟩
      haveI hUwe : WeaklyEtale U.hom := U.prop
      obtain ⟨x, hx, hxj⟩ := hgenY U.hom inferInstance u'
      exact ⟨x, hx.mem_open hΩ hu', hxj⟩) φ
    rw [hφ]
    exact @Abelian.Ext.mk₀_zero _ _ _ (HasExt.standard _) _ _
  · obtain ⟨n₀, rfl⟩ : ∃ n₀, q = n₀ + 1 := ⟨q - 1, by omega⟩
    obtain ⟨δ, hδ1, hδ2⟩ := wc_supp_les_open_boundary (Limits.pullback.fst V.hom i) DV hDV hepi
      (fun U k W g hW =>
        wc_supp_kernel_section_local_cover_qc (Limits.pullback.fst V.hom i) hqc DV hDV U k W g hW)
      O hO Do hDo n₀ (n₀ + 1) rfl
    have hcls : wcSuppClass DV (n₀ + 1) θ = 0 :=
      c5 V.left n₀ (wc_wstrictly_local_affine_et_vanish K ℓ hℓ (V.hom ≫ pY) hV n₀) _
    obtain ⟨α, rfl⟩ := hδ1 θ hcls
    rcases Nat.eq_zero_or_pos n₀ with h0 | hpos
    ·
      subst h0
      have hext := wc_wlocal_open_contfun_extend ⟨hV.1, hV.2.1, hV.2.2.1, hV.2.2.2.1⟩
        (fun z hz => wc_weaklyEtale_smooth_stalk_isDomain K pY n V z (hV.2.2.2.2 z hz))
        O hOc (fun z _ => by
          haveI : Flat V.hom := hVfl
          obtain ⟨x, hx, hxi⟩ := wc_flat_generic_lift_off_closed K pY n m hmn i V.hom z
          refine ⟨x, ?_, hx⟩
          rw [hO, Set.mem_compl_iff, hj]
          exact hxi) ℓ
      obtain ⟨x, rfl⟩ := wc_hm_zero_pull_surj_of_contfun_extend ℓ O.ι Do hDo hext α
      exact hδ2 x
    ·
      obtain ⟨j', rfl⟩ : ∃ j', n₀ = j' + 1 := ⟨n₀ - 1, by omega⟩
      have hs := wc_smooth_pair_wcontr_compl_et_low_vanish K pY n m r hmr i ℓ hℓ V hV O hO
        (j' + 1) (by omega) (by omega)
      rw [c5 O.toScheme j' hs α, map_zero]

theorem wc_smooth_pair_proet_shriek_low_vanish (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (Rs : SheafOfModules.{u+1} (wcRingSheaf Y ℓ) ⥤ SheafOfModules.{u+1} (wcRingSheaf Z ℓ))
    (adj : @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ ⊣ Rs)
    (I : InjectiveResolution (SheafOfModules.unit (wcRingSheaf Y ℓ))) (q : ℕ) (hq : q < 2 * r) :
    letI : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).Additive :=
      @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ Di.adj Di.additive
    letI : Rs.Additive := Adjunction.right_adjoint_additive adj
    Limits.IsZero (((Rs.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) :=
by
  classical
  haveI : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).Additive :=
    @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ Di.adj Di.additive
  haveI : Rs.Additive := Adjunction.right_adjoint_additive adj
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY
  refine rightAdj_homology_zero_of_free_ext_local (Scheme.ProEt.topology Z) (wcRingSheaf Z ℓ)
    (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ) Rs adj
    (SheafOfModules.unit (wcRingSheaf Y ℓ)) I q ?_
  intro W
  refine (Scheme.ProEt.topology Z).superset_covering ?_ (wc_proet_closed_bc_wcontr_cover i W)
  rw [Sieve.generate_le_iff]
  rintro W' f ⟨V, rfl, h1, h2, h3, h4, h5⟩
  refine ⟨_, 𝟙 _, f, ?_, Category.id_comp f⟩
  intro P ev hnat hadd x
  obtain ⟨DV, hDV⟩ := wc_hm_pull_data_exists (Limits.pullback.fst V.hom i) ℓ
  obtain ⟨e⟩ := wc_shriek_free_ext_slice_supp_equiv i ℓ Di hDi Rs adj V P ev hnat hadd DV hDV q
  have hc := wc_smooth_pair_wcontr_supp_low_vanish K pY n m r hmr i ℓ hℓ V
    ⟨h1, h2, h3, h4, h5⟩ DV hDV q hq
  exact e.injective ((hc (e x)).trans (hc (e 0)).symm)

theorem rightAdj_homology_iso_of_good_basis {C : Type (u+1)} [Category.{u} C]
    (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
    (S : Sheaf J RingCat.{u+1})
    {𝒟 : Type*} [Category 𝒟] [Abelian 𝒟] [HasExt 𝒟]
    (L : SheafOfModules.{u+1} S ⥤ 𝒟) [L.Additive]
    (R : 𝒟 ⥤ SheafOfModules.{u+1} S) [R.Additive] (adj : L ⊣ R)
    (A : 𝒟) (I : InjectiveResolution A) (t : ℕ)
    (τ : Abelian.Ext (L.obj (SheafOfModules.unit S)) A t)
    (hgood : ∀ W : C, Sieve.generate (fun (W' : C) (_ : W' ⟶ W) =>
        ∀ (P : SheafOfModules.{u+1} S)
          (ev : ∀ M : SheafOfModules.{u+1} S, (P ⟶ M) ≃ M.val.obj (Opposite.op W')),
          (∀ (M N : SheafOfModules.{u+1} S) (ψ : M ⟶ N) (g : P ⟶ M),
            ev N (g ≫ ψ) = (ψ.val.app (Opposite.op W')).hom (ev M g)) →
          (∀ (M : SheafOfModules.{u+1} S) (g g' : P ⟶ M), ev M (g + g') = ev M g + ev M g') →
          Function.Bijective
            (fun a : (SheafOfModules.unit S).val.obj (Opposite.op W') =>
              (Abelian.Ext.mk₀ (L.map ((ev (SheafOfModules.unit S)).symm a))).comp τ
                (zero_add t))) ∈ J W) :
    ∃ ψ : SheafOfModules.unit S ⟶
        ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology t,
      IsIso ψ :=
by
  classical

  have hcomp : ∀ {M N L : SheafOfModules.{u+1} S} (p : M ⟶ N) (p' : N ⟶ L) (V : Cᵒᵖ)
      (x : M.val.obj V), ((p ≫ p').val.app V).hom x = (p'.val.app V).hom ((p.val.app V).hom x) :=
    fun _ _ _ _ => rfl
  have hnat : ∀ {M N : SheafOfModules.{u+1} S} (p : M ⟶ N) {W W' : C} (g : W' ⟶ W)
      (x : M.val.obj (Opposite.op W)),
      (p.val.app (Opposite.op W')).hom ((M.val.map g.op).hom x) =
        (N.val.map g.op).hom ((p.val.app (Opposite.op W)).hom x) :=
    fun p _ _ g x => PresheafOfModules.naturality_apply p.val g.op x
  have hMmap : ∀ {M : SheafOfModules.{u+1} S} {W Y Z : C} (h₀ : Y ⟶ W) (g' : Z ⟶ Y)
      (x : M.val.obj (Opposite.op W)),
      (M.val.map (g' ≫ h₀).op).hom x = (M.val.map g'.op).hom ((M.val.map h₀.op).hom x) := by
    intro M W Y Z h₀ g' x
    rw [op_comp, PresheafOfModules.map_comp]
    rfl
  have hSmap : ∀ {W Y Z : C} (h₀ : Y ⟶ W) (g' : Z ⟶ Y) (x : S.obj.obj (Opposite.op W)),
      (S.obj.map (g' ≫ h₀).op).hom x = (S.obj.map g'.op).hom ((S.obj.map h₀.op).hom x) := by
    intro W Y Z h₀ g' x
    rw [op_comp, Functor.map_comp]
    rfl

  have hmono : ∀ {M N : SheafOfModules.{u+1} S} (p : M ⟶ N) [Mono p] (W : C),
      Function.Injective (p.val.app (Opposite.op W)).hom := by
    intro M N p _ W
    have h1 : Mono ((SheafOfModules.forget.{u+1} S ⋙
        PresheafOfModules.evaluation.{u+1} S.obj (Opposite.op W)).map p) := Functor.map_mono _ p
    exact (ModuleCat.mono_iff_injective _).1 h1

  have hTS : Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} S) := by
    constructor
    intro I _ _
    constructor
    intro K
    let adj := PresheafOfModules.sheafificationAdjunction (J := J) (𝟙 S.obj)
    haveI : IsIso adj.counit := inferInstance
    haveI hP : Limits.PreservesColimitsOfShape I
        (PresheafOfModules.sheafification (J := J) (𝟙 S.obj) ⋙ SheafOfModules.toSheaf.{u+1} S) :=
      Limits.preservesColimitsOfShape_of_natIso
        (PresheafOfModules.sheafificationCompToSheaf (J := J) (𝟙 S.obj)).symm
    let K₀ := K ⋙ (SheafOfModules.forget S ⋙ PresheafOfModules.restrictScalars (𝟙 S.obj))
    let c₀ := Limits.colimit.cocone K₀
    let h₀ : Limits.IsColimit c₀ := Limits.colimit.isColimit K₀
    have ht : Limits.IsColimit
        ((PresheafOfModules.sheafification (J := J) (𝟙 S.obj)).mapCocone c₀) :=
      Limits.isColimitOfPreserves _ h₀
    have ht' : Limits.IsColimit ((SheafOfModules.toSheaf.{u+1} S).mapCocone
        ((PresheafOfModules.sheafification (J := J) (𝟙 S.obj)).mapCocone c₀)) :=
      Limits.IsColimit.ofIsoColimit
        (Limits.isColimitOfPreserves
          (PresheafOfModules.sheafification (J := J) (𝟙 S.obj) ⋙ SheafOfModules.toSheaf.{u+1} S) h₀)
        (Functor.mapCoconeMapCocone c₀).symm
    haveI : Limits.PreservesColimit (K₀ ⋙ PresheafOfModules.sheafification (J := J) (𝟙 S.obj))
        (SheafOfModules.toSheaf.{u+1} S) :=
      Limits.preservesColimit_of_preserves_colimit_cocone ht ht'
    let e : K₀ ⋙ PresheafOfModules.sheafification (J := J) (𝟙 S.obj) ≅ K :=
      Functor.associator _ _ _ ≪≫ Functor.isoWhiskerLeft K (asIso adj.counit) ≪≫
        Functor.rightUnitor K
    exact Limits.preservesColimit_of_iso_diagram _ e

  have hepi : ∀ {M N : SheafOfModules.{u+1} S} (p : M ⟶ N) [Epi p] (W : C)
      (s : N.val.obj (Opposite.op W)),
      Sieve.generate (fun (W' : C) (g : W' ⟶ W) => ∃ t : M.val.obj (Opposite.op W'),
        (p.val.app (Opposite.op W')).hom t = (N.val.map g.op).hom s) ∈ J W := by
    intro M N p _ W s
    have := hTS
    have h1 : Epi ((SheafOfModules.toSheaf.{u+1} S).map p) := inferInstance
    have h2 := (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1}
      ((SheafOfModules.toSheaf.{u+1} S).map p)).2 h1
    have : Presheaf.IsLocallySurjective J ((SheafOfModules.toSheaf.{u+1} S).map p).hom := h2
    have h3 := Presheaf.imageSieve_mem J ((SheafOfModules.toSheaf.{u+1} S).map p).hom
      (U := Opposite.op W) s
    refine J.superset_covering ?_ h3
    intro W' g hg
    obtain ⟨t, ht⟩ := hg
    exact ⟨_, 𝟙 _, g, ⟨t, ht⟩, Category.id_comp _⟩

  have hker : ∀ (T : ShortComplex (SheafOfModules.{u+1} S)), T.Exact → Mono T.f → ∀ (W : C)
      (x₂ : T.X₂.val.obj (Opposite.op W)), (T.g.val.app (Opposite.op W)).hom x₂ = 0 →
      ∃ x₁ : T.X₁.val.obj (Opposite.op W), (T.f.val.app (Opposite.op W)).hom x₁ = x₂ := by
    intro T hT hf W x₂ hx
    have hE := hT.map_of_mono_of_preservesKernel (SheafOfModules.forget.{u+1} S ⋙
      PresheafOfModules.evaluation.{u+1} S.obj (Opposite.op W)) hf inferInstance
    exact (ShortComplex.moduleCat_exact_iff _).1 hE x₂ hx

  have hexact : ∀ (T : ShortComplex (SheafOfModules.{u+1} S)), T.Exact → ∀ (W : C)
      (x₂ : T.X₂.val.obj (Opposite.op W)), (T.g.val.app (Opposite.op W)).hom x₂ = 0 →
      Sieve.generate (fun (W' : C) (g : W' ⟶ W) => ∃ x₁ : T.X₁.val.obj (Opposite.op W'),
        (T.f.val.app (Opposite.op W')).hom x₁ = (T.X₂.val.map g.op).hom x₂) ∈ J W := by
    intro T hT W x₂ hx
    obtain ⟨z, hz⟩ := hker (ShortComplex.mk T.iCycles T.g T.iCycles_g)
      (ShortComplex.exact_of_f_is_kernel _ T.cyclesIsKernel) inferInstance W x₂ hx
    have := hT.epi_toCycles
    refine J.superset_covering ?_ (hepi T.toCycles W z)
    rw [Sieve.generate_le_iff]
    rintro W' g ⟨t, ht⟩
    apply Sieve.le_generate
    refine ⟨t, ?_⟩
    rw [← T.toCycles_i, hcomp, ht, hnat]
    exact congrArg _ hz

  have htrans : ∀ (W : C) (P₁ P₂ : Presieve W), Sieve.generate P₁ ∈ J W →
      (∀ (Y : C) (g₀ : Y ⟶ W), P₁ g₀ →
        Sieve.generate (fun (Y' : C) (g' : Y' ⟶ Y) => P₂ (g' ≫ g₀)) ∈ J Y) →
      Sieve.generate P₂ ∈ J W := by
    intro W P₁ P₂ h1 h2
    refine J.transitive h1 _ ?_
    intro Y' f hf
    obtain ⟨Y, k, g₀, hg₀, rfl⟩ := hf
    have h3 : Sieve.generate (fun (Y'' : C) (g' : Y'' ⟶ Y) => P₂ (g' ≫ g₀)) ≤
        (Sieve.generate P₂).pullback g₀ := by
      rw [Sieve.generate_le_iff]
      intro Y'' g' hg'
      exact ⟨_, 𝟙 _, g' ≫ g₀, hg', Category.id_comp _⟩
    have h4 := J.superset_covering h3 (h2 Y g₀ hg₀)
    rw [Sieve.pullback_comp]
    exact J.pullback_stable k h4

  have hsep : ∀ (W : C) (x : S.obj.obj (Opposite.op W)),
      Sieve.generate (fun (W' : C) (g : W' ⟶ W) => (S.obj.map g.op).hom x = 0) ∈ J W → x = 0 := by
    intro W x hx
    apply (Sheaf.isSeparated S) W _ hx x 0
    intro Y f hf
    obtain ⟨Z, k, k₀, hk₀, rfl⟩ := hf
    show (S.obj.map (k ≫ k₀).op).hom x = (S.obj.map (k ≫ k₀).op).hom 0
    rw [map_zero, hSmap, hk₀, map_zero]

  have hmain : ∀ (q : ℕ) (P : CochainComplex (SheafOfModules.{u+1} S) ℕ)
      (g : SheafOfModules.unit S ⟶ P.X q) (hg : g ≫ P.d q (q + 1) = 0),
      (∀ (W : C) (c : S.obj.obj (Opposite.op W))
        (y : (P.X ((ComplexShape.up ℕ).prev q)).val.obj (Opposite.op W)),
        (g.val.app (Opposite.op W)).hom c =
          ((P.d ((ComplexShape.up ℕ).prev q) q).val.app (Opposite.op W)).hom y →
        Sieve.generate (fun (W' : C) (h : W' ⟶ W) => (S.obj.map h.op).hom c = 0) ∈ J W) →
      (∀ (W : C) (s : (P.X q).val.obj (Opposite.op W)),
        ((P.d q (q + 1)).val.app (Opposite.op W)).hom s = 0 →
        Sieve.generate (fun (W' : C) (h : W' ⟶ W) => ∃ (c : S.obj.obj (Opposite.op W'))
            (y : (P.X ((ComplexShape.up ℕ).prev q)).val.obj (Opposite.op W')),
            ((P.X q).val.map h.op).hom s =
              (g.val.app (Opposite.op W')).hom c +
              ((P.d ((ComplexShape.up ℕ).prev q) q).val.app (Opposite.op W')).hom y) ∈ J W) →
      IsIso (P.liftCycles g (q + 1) (by simp) hg ≫ P.homologyπ q) := by
    intro q P g hg H2 H3
    have hLi : ∀ (V : Cᵒᵖ) (x : (SheafOfModules.unit S).val.obj V),
        ((P.iCycles q).val.app V).hom
          (((P.liftCycles g (q + 1) (by simp) hg).val.app V).hom x) =
        (g.val.app V).hom x := by
      intro V x
      rw [← hcomp, P.liftCycles_i]
    have hTi : ∀ (V : Cᵒᵖ) (y : (P.X ((ComplexShape.up ℕ).prev q)).val.obj V),
        ((P.iCycles q).val.app V).hom
          (((P.toCycles ((ComplexShape.up ℕ).prev q) q).val.app V).hom y) =
        ((P.d ((ComplexShape.up ℕ).prev q) q).val.app V).hom y := by
      intro V y
      rw [← hcomp, P.toCycles_i]
    have hTπ : ∀ (V : Cᵒᵖ) (y : (P.X ((ComplexShape.up ℕ).prev q)).val.obj V),
        ((P.homologyπ q).val.app V).hom
          (((P.toCycles ((ComplexShape.up ℕ).prev q) q).val.app V).hom y) = 0 := by
      intro V y
      rw [← hcomp, P.toCycles_comp_homologyπ]
      rfl

    have hinj : ∀ (W : C) (c : S.obj.obj (Opposite.op W)),
        ((P.liftCycles g (q + 1) (by simp) hg ≫ P.homologyπ q).val.app
          (Opposite.op W)).hom c = 0 → c = 0 := by
      intro W c hc
      obtain ⟨z, hz⟩ : ∃ z : (P.cycles q).val.obj (Opposite.op W), z =
          ((P.liftCycles g (q + 1) (by simp) hg).val.app (Opposite.op W)).hom c :=
        ⟨_, rfl⟩
      have hπz : ((P.homologyπ q).val.app (Opposite.op W)).hom z = 0 := by
        rw [hz, ← hc]
        rfl
      have hTex := ShortComplex.exact_of_g_is_cokernel
        (ShortComplex.mk (P.toCycles ((ComplexShape.up ℕ).prev q) q) (P.homologyπ q)
          (P.toCycles_comp_homologyπ _ q)) (P.homologyIsCokernel _ q rfl)
      apply hsep W c
      apply htrans W _ _ (hexact _ hTex W z hπz)
      rintro Y h₀ ⟨y, hy⟩
      have hd : (g.val.app (Opposite.op Y)).hom ((S.obj.map h₀.op).hom c) =
          ((P.d ((ComplexShape.up ℕ).prev q) q).val.app (Opposite.op Y)).hom y := by
        rw [← hTi]
        erw [hy]
        rw [hnat, hz]
        exact (hnat g h₀ c).trans (congrArg _ (hLi _ c).symm)
      refine J.superset_covering ?_ (H2 Y _ y hd)
      rw [Sieve.generate_le_iff]
      intro Z g' hg'
      apply Sieve.le_generate
      show (S.obj.map (g' ≫ h₀).op).hom c = 0
      rw [hSmap]
      exact hg'

    have hloc : ∀ (W : C) (x : (P.homology q).val.obj (Opposite.op W)),
        Sieve.generate (fun (W' : C) (h : W' ⟶ W) => ∃ c : S.obj.obj (Opposite.op W'),
          ((P.homology q).val.map h.op).hom x =
            ((P.liftCycles g (q + 1) (by simp) hg ≫ P.homologyπ q).val.app
              (Opposite.op W')).hom c) ∈ J W := by
      intro W x
      apply htrans W _ _ (hepi (P.homologyπ q) W x)
      rintro Y h₀ ⟨z, hz⟩
      have hs : ((P.d q (q + 1)).val.app (Opposite.op Y)).hom
          (((P.iCycles q).val.app (Opposite.op Y)).hom z) = 0 := by
        rw [← hcomp, P.iCycles_d]
        rfl
      refine J.superset_covering ?_ (H3 Y _ hs)
      rw [Sieve.generate_le_iff]
      rintro Z h' ⟨c, y, hcy⟩
      apply Sieve.le_generate
      refine ⟨c, ?_⟩
      have hw : ((P.cycles q).val.map h'.op).hom z =
          ((P.liftCycles g (q + 1) (by simp) hg).val.app (Opposite.op Z)).hom c +
            ((P.toCycles ((ComplexShape.up ℕ).prev q) q).val.app (Opposite.op Z)).hom y := by
        apply hmono (P.iCycles q) Z
        rw [map_add, hnat, hcy, hTi]
        congr 1
        exact (hLi _ c).symm
      rw [hMmap, ← hz, ← hnat, hw, map_add, hTπ, add_zero]
      rfl

    haveI hM : Mono (P.liftCycles g (q + 1) (by simp) hg ≫ P.homologyπ q) := by
      constructor
      intro X a b hab
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro V
      ext x
      have h1 : ((P.liftCycles g (q + 1) (by simp) hg ≫ P.homologyπ q).val.app V).hom
            ((a.val.app V).hom x) =
          ((P.liftCycles g (q + 1) (by simp) hg ≫ P.homologyπ q).val.app V).hom
            ((b.val.app V).hom x) := by
        rw [← hcomp, ← hcomp, hab]
      have hd0 : ((P.liftCycles g (q + 1) (by simp) hg ≫ P.homologyπ q).val.app V).hom
          ((a.val.app V).hom x - (b.val.app V).hom x) = 0 := by
        rw [map_sub, h1, sub_self]
      have h2 := hinj V.unop _ hd0
      exact sub_eq_zero.mp h2

    haveI hE : Epi (P.liftCycles g (q + 1) (by simp) hg ≫ P.homologyπ q) := by
      apply (SheafOfModules.toSheaf.{u+1} S).epi_of_epi_map
      apply (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} _).1
      have : Presheaf.IsLocallySurjective J ((SheafOfModules.toSheaf.{u+1} S).map
          (P.liftCycles g (q + 1) (by simp) hg ≫ P.homologyπ q)).hom := by
        refine ⟨fun {U} s => ?_⟩
        refine J.superset_covering ?_ (hloc U s)
        rw [Sieve.generate_le_iff]
        rintro W' k ⟨c, hc⟩
        exact ⟨c, hc.symm⟩
      exact this
    exact isIso_of_mono_of_epi _

  have hfree : ∀ U : C, ∃ (P : SheafOfModules.{u+1} S)
      (ev : ∀ M : SheafOfModules.{u+1} S, (P ⟶ M) ≃ M.val.obj (Opposite.op U)),
      (∀ (M N : SheafOfModules.{u+1} S) (ψ : M ⟶ N) (g : P ⟶ M),
        ev N (g ≫ ψ) = (ψ.val.app (Opposite.op U)).hom (ev M g)) ∧
      (∀ (M : SheafOfModules.{u+1} S) (g g' : P ⟶ M), ev M (g + g') = ev M g + ev M g') := by
    intro U
    let Y : Cᵒᵖ ⥤ Type (u+1) := uliftYoneda.{u+1}.obj U
    let F₀ := (PresheafOfModules.free.{u+1} S.val).obj Y
    let adjS := PresheafOfModules.sheafificationAdjunction (J := J) (R := S) (𝟙 S.val)
    let adjF := PresheafOfModules.freeAdjunction.{u+1} S.val
    let P := (PresheafOfModules.sheafification (J := J) (R := S) (𝟙 S.val)).obj F₀
    let ev : ∀ M : SheafOfModules.{u+1} S, (P ⟶ M) ≃ M.val.obj (Opposite.op U) := fun M =>
      (adjS.homEquiv F₀ M).trans ((adjF.homEquiv Y _).trans uliftYonedaEquiv)
    have hnatF : ∀ (M N : SheafOfModules.{u+1} S) (ψ : M ⟶ N) (g : P ⟶ M),
        ev N (g ≫ ψ) = (ψ.val.app (Opposite.op U)).hom (ev M g) := by
      intro M N ψ g
      change uliftYonedaEquiv (adjF.homEquiv Y _ (adjS.homEquiv F₀ N (g ≫ ψ))) =
        (ψ.val.app (Opposite.op U)).hom
          (uliftYonedaEquiv (adjF.homEquiv Y _ (adjS.homEquiv F₀ M g)))
      rw [adjS.homEquiv_naturality_right, adjF.homEquiv_naturality_right, uliftYonedaEquiv_comp]
      rfl
    refine ⟨P, ev, hnatF, ?_⟩
    intro M g g'
    have h0 : ∀ h : P ⟶ M, ev M h = (h.val.app (Opposite.op U)).hom (ev P (𝟙 P)) := by
      intro h
      rw [← hnatF, Category.id_comp]
    rw [h0, h0 g, h0 g', SheafOfModules.add_val, PresheafOfModules.add_app, ModuleCat.hom_add,
      LinearMap.add_apply]

  have hzero : ∀ {X : 𝒟} (f : X ⟶ I.cocomplex.X t) (hf : f ≫ I.cocomplex.d t (t + 1) = 0)
      (k : X ⟶ I.cocomplex.X ((ComplexShape.up ℕ).prev t)),
      f = k ≫ I.cocomplex.d ((ComplexShape.up ℕ).prev t) t → I.extMk f (t + 1) rfl hf = 0 := by
    intro X f hf k hk
    by_cases hr : (ComplexShape.up ℕ).Rel ((ComplexShape.up ℕ).prev t) t
    · exact (I.extMk_eq_zero_iff f (t + 1) rfl hf _ hr).2 ⟨k, hk.symm⟩
    · have h0 : I.cocomplex.d ((ComplexShape.up ℕ).prev t) t = 0 := I.cocomplex.shape _ _ hr
      rw [h0, Limits.comp_zero] at hk
      subst hk
      exact I.extMk_zero (t + 1) rfl
  have hcob : ∀ {X : 𝒟} (f : X ⟶ I.cocomplex.X t) (hf : f ≫ I.cocomplex.d t (t + 1) = 0),
      I.extMk f (t + 1) rfl hf = 0 → ∃ k : X ⟶ I.cocomplex.X ((ComplexShape.up ℕ).prev t),
        f = k ≫ I.cocomplex.d ((ComplexShape.up ℕ).prev t) t := by
    intro X f hf h0
    by_cases hr : (ComplexShape.up ℕ).Rel ((ComplexShape.up ℕ).prev t) t
    · obtain ⟨k, hk⟩ := (I.extMk_eq_zero_iff f (t + 1) rfl hf _ hr).1 h0
      exact ⟨k, hk.symm⟩
    · have ht : t = 0 := by
        rcases Nat.eq_zero_or_pos t with ht | ht
        · exact ht
        · exfalso
          have hr' : (ComplexShape.up ℕ).Rel (t - 1) t := by
            simp only [ComplexShape.up_Rel]; omega
          rw [ComplexShape.prev_eq' _ hr'] at hr
          exact hr hr'
      refine ⟨0, ?_⟩
      rw [Limits.zero_comp]
      subst ht
      have h1 := congrArg I.extEquivCohomologyClass h0
      rw [InjectiveResolution.extEquivCohomologyClass_extMk,
        InjectiveResolution.extEquivCohomologyClass_zero,
        CochainComplex.HomComplex.CohomologyClass.mk_eq_zero_iff,
        CochainComplex.HomComplex.Cocycle.fromSingleMk_mem_coboundaries_iff _ _ _ _ _ (-1)
          (by norm_num)] at h1
      obtain ⟨g', hg'⟩ := h1
      have hz : Limits.IsZero (I.cochainComplex.X (-1)) :=
        CochainComplex.isZero_of_isStrictlyGE I.cochainComplex 0 (-1)
      rw [hz.eq_of_tgt g' 0, Limits.zero_comp] at hg'
      rw [← cancel_mono (I.cochainComplexXIso ((0 : ℕ) : ℤ) 0 rfl).inv, Limits.zero_comp]
      exact hg'.symm

  obtain ⟨c, hc, hτ⟩ := I.extMk_surjective τ (t + 1) rfl
  have hg : adj.homEquiv _ _ c ≫
      ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).d t (t + 1) = 0 := by
    show adj.homEquiv _ _ c ≫ R.map (I.cocomplex.d t (t + 1)) = 0
    rw [← Adjunction.homEquiv_naturality_right, hc, Adjunction.homEquiv_unit, Functor.map_zero,
      Limits.comp_zero]

  have s2 : ∀ (W : C) (P : SheafOfModules.{u+1} S)
      (ev : ∀ M : SheafOfModules.{u+1} S, (P ⟶ M) ≃ M.val.obj (Opposite.op W)),
      (∀ (M N : SheafOfModules.{u+1} S) (ψ : M ⟶ N) (g : P ⟶ M),
        ev N (g ≫ ψ) = (ψ.val.app (Opposite.op W)).hom (ev M g)) →
      (∀ (M : SheafOfModules.{u+1} S) (g g' : P ⟶ M), ev M (g + g') = ev M g + ev M g') →
      Function.Injective (fun a : (SheafOfModules.unit S).val.obj (Opposite.op W) =>
        (Abelian.Ext.mk₀ (L.map ((ev (SheafOfModules.unit S)).symm a))).comp τ (zero_add t)) →
      ∀ (a : (SheafOfModules.unit S).val.obj (Opposite.op W))
        (y : (R.obj (I.cocomplex.X ((ComplexShape.up ℕ).prev t))).val.obj (Opposite.op W)),
        ((adj.homEquiv _ _ c).val.app (Opposite.op W)).hom a =
          ((R.map (I.cocomplex.d ((ComplexShape.up ℕ).prev t) t)).val.app
            (Opposite.op W)).hom y →
        a = 0 := by
    intro W P ev hn' ha' hinj a y hay
    have e1 : (ev _).symm a ≫ adj.homEquiv _ _ c =
        (ev _).symm y ≫ R.map (I.cocomplex.d ((ComplexShape.up ℕ).prev t) t) := by
      apply (ev _).injective
      rw [hn', hn', Equiv.apply_symm_apply, Equiv.apply_symm_apply, hay]
    have e2 : L.map ((ev _).symm a) ≫ c = (adj.homEquiv _ _).symm ((ev _).symm y) ≫
        I.cocomplex.d ((ComplexShape.up ℕ).prev t) t := by
      have h1 := congrArg (adj.homEquiv _ _).symm e1
      rw [Adjunction.homEquiv_naturality_left_symm, Equiv.symm_apply_apply,
        Adjunction.homEquiv_naturality_right_symm] at h1
      exact h1
    have hev0 : (ev (SheafOfModules.unit S)).symm 0 = 0 := by
      apply (ev _).injective
      rw [Equiv.apply_symm_apply]
      have h := ha' (SheafOfModules.unit S) 0 0
      rw [add_zero] at h
      exact (by simpa using h : ev (SheafOfModules.unit S) 0 = 0).symm
    have e3 : L.map ((ev (SheafOfModules.unit S)).symm 0) ≫ c =
        (0 : L.obj P ⟶ I.cocomplex.X ((ComplexShape.up ℕ).prev t)) ≫
          I.cocomplex.d ((ComplexShape.up ℕ).prev t) t := by
      rw [hev0, Functor.map_zero, Limits.zero_comp, Limits.zero_comp]
    apply hinj
    show (Abelian.Ext.mk₀ (L.map ((ev _).symm a))).comp τ (zero_add t) =
      (Abelian.Ext.mk₀ (L.map ((ev _).symm 0))).comp τ (zero_add t)
    rw [← hτ, InjectiveResolution.mk₀_comp_extMk, InjectiveResolution.mk₀_comp_extMk]
    exact (hzero _ _ _ e2).trans (hzero _ _ _ e3).symm

  have s3 : ∀ (W : C) (P : SheafOfModules.{u+1} S)
      (ev : ∀ M : SheafOfModules.{u+1} S, (P ⟶ M) ≃ M.val.obj (Opposite.op W)),
      (∀ (M N : SheafOfModules.{u+1} S) (ψ : M ⟶ N) (g : P ⟶ M),
        ev N (g ≫ ψ) = (ψ.val.app (Opposite.op W)).hom (ev M g)) →
      (∀ (M : SheafOfModules.{u+1} S) (g g' : P ⟶ M), ev M (g + g') = ev M g + ev M g') →
      Function.Surjective (fun a : (SheafOfModules.unit S).val.obj (Opposite.op W) =>
        (Abelian.Ext.mk₀ (L.map ((ev (SheafOfModules.unit S)).symm a))).comp τ (zero_add t)) →
      ∀ (s : (R.obj (I.cocomplex.X t)).val.obj (Opposite.op W)),
        ((R.map (I.cocomplex.d t (t + 1))).val.app (Opposite.op W)).hom s = 0 →
        ∃ (a : (SheafOfModules.unit S).val.obj (Opposite.op W))
          (y : (R.obj (I.cocomplex.X ((ComplexShape.up ℕ).prev t))).val.obj (Opposite.op W)),
          s = ((adj.homEquiv _ _ c).val.app (Opposite.op W)).hom a +
            ((R.map (I.cocomplex.d ((ComplexShape.up ℕ).prev t) t)).val.app
              (Opposite.op W)).hom y := by
    intro W P ev hn' ha' hsurj s hs
    have hev0 : ∀ M, ev M 0 = 0 := by
      intro M
      have h := ha' M 0 0
      rw [add_zero] at h
      simpa using h
    have hσ : (ev _).symm s ≫ R.map (I.cocomplex.d t (t + 1)) = 0 := by
      apply (ev _).injective
      rw [hn', Equiv.apply_symm_apply, hs, hev0]
    have hσ' : (adj.homEquiv _ _).symm ((ev _).symm s) ≫ I.cocomplex.d t (t + 1) = 0 := by
      rw [← Adjunction.homEquiv_naturality_right_symm, hσ, Adjunction.homEquiv_counit,
        Functor.map_zero, Limits.zero_comp]
    obtain ⟨a, ha⟩ := hsurj (I.extMk _ (t + 1) rfl hσ')
    have ha2 : (Abelian.Ext.mk₀ (L.map ((ev (SheafOfModules.unit S)).symm a))).comp τ
        (zero_add t) = I.extMk _ (t + 1) rfl hσ' := ha
    rw [← hτ, InjectiveResolution.mk₀_comp_extMk] at ha2
    have hmc : (L.map ((ev (SheafOfModules.unit S)).symm a) ≫ c) ≫
        I.cocomplex.d t (t + 1) = 0 := by
      rw [Category.assoc, hc, Limits.comp_zero]
    have hd := I.sub_extMk _ _ (t + 1) rfl hσ' hmc
    rw [← ha2, sub_self] at hd
    obtain ⟨k, hk⟩ := hcob _ _ hd.symm
    have e0 : (adj.homEquiv _ _).symm ((ev _).symm s) =
        L.map ((ev (SheafOfModules.unit S)).symm a) ≫ c +
          k ≫ I.cocomplex.d ((ComplexShape.up ℕ).prev t) t := by
      rw [← hk]
      abel
    have hadd' : ∀ {X : SheafOfModules.{u+1} S} {Y : 𝒟} (f₁ f₂ : L.obj X ⟶ Y),
        adj.homEquiv _ _ (f₁ + f₂) = adj.homEquiv _ _ f₁ + adj.homEquiv _ _ f₂ := by
      intro X Y f₁ f₂
      simp only [Adjunction.homEquiv_unit, Functor.map_add, Preadditive.comp_add]
    have e1 : (ev _).symm s = (ev _).symm a ≫ adj.homEquiv _ _ c +
        adj.homEquiv _ _ k ≫ R.map (I.cocomplex.d ((ComplexShape.up ℕ).prev t) t) := by
      have h1 : (ev _).symm s = adj.homEquiv _ _ ((adj.homEquiv _ _).symm ((ev _).symm s)) :=
        (Equiv.apply_symm_apply _ _).symm
      rw [h1, e0, hadd', Adjunction.homEquiv_naturality_left,
        Adjunction.homEquiv_naturality_right]
    refine ⟨a, ev _ (adj.homEquiv _ _ k), ?_⟩
    calc s = ev _ ((ev _).symm s) := (Equiv.apply_symm_apply _ _).symm
      _ = _ := by rw [e1, ha', hn', hn', Equiv.apply_symm_apply]

  refine ⟨_, hmain t ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex)
    (adj.homEquiv _ _ c) hg ?_ ?_⟩
  · intro W a y hay
    refine J.superset_covering ?_ (hgood W)
    rw [Sieve.generate_le_iff]
    intro W' h hgd
    apply Sieve.le_generate
    obtain ⟨P, ev, hn', ha'⟩ := hfree W'
    have e := hnat (adj.homEquiv _ _ c) h a
    have e' := hnat (R.map (I.cocomplex.d ((ComplexShape.up ℕ).prev t) t)) h y
    refine s2 W' P ev hn' ha' (hgd P ev hn' ha').1 ((S.obj.map h.op).hom a)
      (((R.obj (I.cocomplex.X ((ComplexShape.up ℕ).prev t))).val.map h.op).hom y) ?_
    refine e.trans (Eq.trans ?_ e'.symm)
    exact congrArg (fun z => ((R.obj (I.cocomplex.X t)).val.map h.op).hom z) hay
  · intro W s hs
    refine J.superset_covering ?_ (hgood W)
    rw [Sieve.generate_le_iff]
    intro W' h hgd
    apply Sieve.le_generate
    obtain ⟨P, ev, hn', ha'⟩ := hfree W'
    have hs' : ((R.map (I.cocomplex.d t (t + 1))).val.app (Opposite.op W')).hom
        (((R.obj (I.cocomplex.X t)).val.map h.op).hom s) = 0 := by
      rw [hnat]
      exact (congrArg ((R.obj (I.cocomplex.X (t + 1))).val.map h.op).hom hs).trans (map_zero _)
    obtain ⟨a, y, hay⟩ := s3 W' P ev hn' ha' (hgd P ev hn' ha').2 _ hs'
    exact ⟨a, y, hay⟩

theorem wc_fromSpecStalk_weaklyEtale (X : Scheme.{u}) (x : X) :
    WeaklyEtale (X.fromSpecStalk x) :=
by
  refine ⟨?_, inferInstance⟩
  obtain ⟨_, ⟨U, hU, rfl⟩, hx, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
  replace hU : IsAffineOpen U := hU
  rw [← hU.fromSpecStalk_eq_fromSpecStalk hx]
  show Flat (Spec.map (X.presheaf.germ U x hx) ≫ hU.fromSpec)
  have : Flat (Spec.map (X.presheaf.germ U x hx)) := by
    rw [HasRingHomProperty.Spec_iff (P := @Flat)]
    letI : Algebra Γ(X, U) (X.presheaf.stalk x) := (X.presheaf.germ U x hx).hom.toAlgebra
    haveI := hU.isLocalization_stalk ⟨x, hx⟩
    exact RingHom.flat_algebraMap_iff.mpr
      (IsLocalization.flat _ (hU.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl)
  have hoi : IsOpenImmersion hU.fromSpec := hU.isOpenImmersion_fromSpec
  have hfs : Flat hU.fromSpec := Flat.instOfIsOpenImmersion _
  exact MorphismProperty.comp_mem @Flat _ _ this hfs

theorem wc_closed_supp_base_change_weaklyEtale_affine {X Y Y' : Scheme.{u}} {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)] (i : X ⟶ Y) [IsClosedImmersion i] (f : Y' ⟶ Y) [WeaklyEtale f]
    [IsAffine Y'] (D : wcHMPullData i ℓ) (hD : wcHMPullCanonical D)
    (Df : wcHMPullData f ℓ) (hDf : wcHMPullCanonical Df) :
    ∃ (Di : wcHMPullData (Limits.pullback.fst f i) ℓ) (_ : wcHMPullCanonical Di)
      (γ : wcSuppObj Di ⟶ Df.Φ.obj (wcSuppObj D)),
      wcSuppUnitMap Di ≫ γ = Df.μ.inv ≫ Df.Φ.map (wcSuppUnitMap D) ∧
      Epi (wcSuppUnitMap Di) :=
by
  classical
  obtain ⟨Di, hDi⟩ := wc_hm_pull_data_exists (Limits.pullback.fst f i) ℓ
  haveI hE : Epi (wcSuppUnitMap Di) :=
    wc_supp_unit_epi_of_closed (Limits.pullback.fst f i) ℓ Di hDi
  let V : Y.ProEt := MorphismProperty.Over.mk ⊤ f inferInstance
  obtain ⟨hc, -, -⟩ := wc_lpsc_site Y V
  haveI := hc
  obtain ⟨θ⟩ := wc_hm_pull_Phi_slice_iso Y ℓ V Df hDf

  have hsec : ∀ (μ' : SheafOfModules.unit (wcRingSheaf Y' ℓ) ⟶
        (wcSliceRes Y ℓ V).obj (SheafOfModules.unit (wcRingSheaf Y ℓ)))
      (W : Y'.ProEt) (t : C(↥W.left, ULift.{u+1} ℚ_[ℓ])),
      ((wcSuppUnitMap Di).val.app (Opposite.op W)).hom t = 0 →
      (((wcSliceRes Y ℓ V).map (wcSuppUnitMap D)).val.app (Opposite.op W)).hom
        ((μ'.val.app (Opposite.op W)).hom t) = 0 := by
    intro μ' W t h0

    have hv : ∀ y : ↥W.left, W.hom y ∈ Set.range (Limits.pullback.fst f i) → t y = 0 := by
      intro y hy
      have hy' : y ∈ Set.range (Limits.pullback.fst W.hom (Limits.pullback.fst f i)) := by
        rw [Scheme.Pullback.range_fst]; exact hy
      obtain ⟨z, rfl⟩ := hy'
      obtain ⟨c', hc'⟩ := wc_supp_unit_twist_isUnit Di
      have htw := wc_supp_hom_twist_formula Di hDi (wcSuppUnitMap Di) W t
      rw [h0] at htw
      have h1 := congrArg
        (fun φ : C(↥(Limits.pullback W.hom (Limits.pullback.fst f i)), ULift.{u+1} ℚ_[ℓ]) =>
          φ z) htw
      have h2 := congrArg (fun φ : C(↥(Limits.pullback f i), ULift.{u+1} ℚ_[ℓ]) =>
        φ ((Limits.pullback.snd W.hom (Limits.pullback.fst f i)).base.hom z)) hc'
      simp only [ContinuousMap.mul_apply, ContinuousMap.comp_apply,
        ContinuousMap.one_apply] at h1 h2
      have h1' : (0 : ULift.{u+1} ℚ_[ℓ]) =
          t ((Limits.pullback.fst W.hom (Limits.pullback.fst f i)).base.hom z) *
            (wcSuppTwist (wcSuppUnitMap Di))
              ((Limits.pullback.snd W.hom (Limits.pullback.fst f i)).base.hom z) := h1
      show t ((Limits.pullback.fst W.hom (Limits.pullback.fst f i)).base.hom z) = 0
      linear_combination
        (-(c' ((Limits.pullback.snd W.hom (Limits.pullback.fst f i)).base.hom z))) * h1' -
        (t ((Limits.pullback.fst W.hom (Limits.pullback.fst f i)).base.hom z)) * h2

    have hsm1 := (μ'.val.app (Opposite.op W)).hom.map_smul t
      (1 : C(↥W.left, ULift.{u+1} ℚ_[ℓ]))
    have hsm2 := (((wcSliceRes Y ℓ V).map (wcSuppUnitMap D)).val.app (Opposite.op W)).hom.map_smul t
      ((μ'.val.app (Opposite.op W)).hom (1 : C(↥W.left, ULift.{u+1} ℚ_[ℓ])))
    refine ((congrArg (((wcSliceRes Y ℓ V).map (wcSuppUnitMap D)).val.app (Opposite.op W)).hom
      ((congrArg (μ'.val.app (Opposite.op W)).hom (mul_one t).symm).trans hsm1)).trans
        hsm2).trans ?_

    have hφ : (@id C(↥(Limits.pullback ((wcSliceFunctor Y V).obj W).hom i), ULift.{u+1} ℚ_[ℓ])
        ((D.φ.hom.app (Opposite.op ((wcSliceFunctor Y V).obj W))).hom t)) = 0 := by
      refine (hD ((wcSliceFunctor Y V).obj W) t).trans (ContinuousMap.ext fun z => ?_)
      have hz : W.hom ((Limits.pullback.fst ((wcSliceFunctor Y V).obj W).hom i).base z) ∈
          Set.range (Limits.pullback.fst f i) := by
        rw [Scheme.Pullback.range_fst]
        exact ⟨(Limits.pullback.snd ((wcSliceFunctor Y V).obj W).hom i).base z,
          (congrArg (fun φ => φ.base z)
            (Limits.pullback.condition (f := ((wcSliceFunctor Y V).obj W).hom) (g := i))).symm⟩
      exact hv _ hz
    calc _ = (@id C(↥(Limits.pullback ((wcSliceFunctor Y V).obj W).hom i), ULift.{u+1} ℚ_[ℓ])
          ((D.φ.hom.app (Opposite.op ((wcSliceFunctor Y V).obj W))).hom t)) *
        (@id C(↥(Limits.pullback ((wcSliceFunctor Y V).obj W).hom i), ULift.{u+1} ℚ_[ℓ])
          ((((wcSliceRes Y ℓ V).map (wcSuppUnitMap D)).val.app (Opposite.op W)).hom
            ((μ'.val.app (Opposite.op W)).hom (1 : C(↥W.left, ULift.{u+1} ℚ_[ℓ]))))) := rfl
      _ = 0 := by rw [hφ, zero_mul]
  have hnat : Df.Φ.map (wcSuppUnitMap D) =
      θ.hom.app _ ≫ (wcSliceRes Y ℓ V).map (wcSuppUnitMap D) ≫ θ.inv.app _ := by
    rw [← Category.assoc, ← θ.hom.naturality, Category.assoc, Iso.hom_inv_id_app,
      Category.comp_id]
  have hK : Limits.kernel.ι (wcSuppUnitMap Di) ≫ Df.μ.inv ≫ Df.Φ.map (wcSuppUnitMap D) = 0 := by
    rw [hnat]
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro W
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    induction W using Opposite.rec with
    | op W =>
    have hk := congrArg (fun φ => (φ.val.app (Opposite.op W)).hom x)
      (Limits.kernel.condition (wcSuppUnitMap Di))
    change ((wcSuppUnitMap Di).val.app (Opposite.op W)).hom
      (((Limits.kernel.ι (wcSuppUnitMap Di)).val.app (Opposite.op W)).hom x) = 0 at hk
    have h1 := hsec (Df.μ.inv ≫ θ.hom.app (SheafOfModules.unit (wcRingSheaf Y ℓ))) W _ hk
    first
      | (change ((Df.μ.inv ≫ θ.hom.app (SheafOfModules.unit (wcRingSheaf Y ℓ)) ≫
            (wcSliceRes Y ℓ V).map (wcSuppUnitMap D) ≫ θ.inv.app (wcSuppObj D)).val.app
              (Opposite.op W)).hom
            (((Limits.kernel.ι (wcSuppUnitMap Di)).val.app (Opposite.op W)).hom x) = 0
         change ((θ.inv.app (wcSuppObj D)).val.app (Opposite.op W)).hom
          ((((wcSliceRes Y ℓ V).map (wcSuppUnitMap D)).val.app (Opposite.op W)).hom
            (((Df.μ.inv ≫ θ.hom.app (SheafOfModules.unit (wcRingSheaf Y ℓ))).val.app
              (Opposite.op W)).hom
              (((Limits.kernel.ι (wcSuppUnitMap Di)).val.app (Opposite.op W)).hom x))) = 0
         rw [h1, map_zero])
      | (simp only [SheafOfModules.comp_val, PresheafOfModules.comp_app, ModuleCat.hom_comp,
          LinearMap.comp_apply] at h1 ⊢
         rw [h1, map_zero]
         rfl)
      | (simp only [SheafOfModules.comp_val, PresheafOfModules.comp_app, ModuleCat.hom_comp,
          LinearMap.comp_apply] at h1 ⊢
         rw [h1, map_zero])
      | simp [h1]
  exact ⟨Di, hDi, Abelian.epiDesc (wcSuppUnitMap Di) (Df.μ.inv ≫ Df.Φ.map (wcSuppUnitMap D)) hK,
    Abelian.comp_epiDesc _ _ _, hE⟩

theorem wc_closed_supp_bc_unit_ker_le {Y Z : Scheme.{u}} (i : Z ⟶ Y) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di) (V : Y.ProEt)
    (Dv : wcHMPullData V.hom ℓ) (hDv : wcHMPullCanonical Dv)
    (DV : wcHMPullData (Limits.pullback.fst V.hom i) ℓ) (hDV : wcHMPullCanonical DV)
    (W : V.left.ProEt) (c : (SheafOfModules.unit (wcRingSheaf V.left ℓ)).val.obj (Opposite.op W))
    (hc : ((Dv.μ.inv ≫ Dv.Φ.map (wcSuppUnitMap Di)).val.app (Opposite.op W)).hom c = 0) :
    ((wcSuppUnitMap DV).val.app (Opposite.op W)).hom c = 0 :=
by
  classical
  haveI hσ : (wcSliceToOver Y V).IsContinuous (Scheme.ProEt.topology V.left)
      ((Scheme.ProEt.topology Y).over V) := (wc_slice_over_sites_cont Y V).1
  haveI hj : (wcSliceFunctor Y V).IsContinuous (Scheme.ProEt.topology V.left)
      (Scheme.ProEt.topology Y) := by
    have h := Functor.isContinuous_comp (wcSliceToOver Y V) (Over.forget V)
      (Scheme.ProEt.topology V.left) ((Scheme.ProEt.topology Y).over V) (Scheme.ProEt.topology Y)
    exact h
  obtain ⟨θ⟩ := wc_hm_pull_Phi_slice_iso Y ℓ V Dv hDv
  obtain ⟨cDi, hcDi⟩ := wc_supp_unit_twist_isUnit Di

  let f₀ := Dv.μ.inv ≫ θ.hom.app (SheafOfModules.unit (wcRingSheaf Y ℓ))
  let g₀ := θ.inv.app (SheafOfModules.unit (wcRingSheaf Y ℓ)) ≫ Dv.μ.hom
  have hfg : f₀ ≫ g₀ = 𝟙 _ := by
    simp only [f₀, g₀, Category.assoc, Iso.hom_inv_id_app_assoc, Iso.inv_hom_id]
  have h2 : (Dv.μ.inv ≫ Dv.Φ.map (wcSuppUnitMap Di)) ≫ θ.hom.app (wcSuppObj Di) =
      f₀ ≫ (wcSliceRes Y ℓ V).map (wcSuppUnitMap Di) := by
    simp only [f₀, Category.assoc, NatTrans.naturality]
    rfl
  let d := (f₀.val.app (Opposite.op W)).hom c
  have hd : (((wcSliceRes Y ℓ V).map (wcSuppUnitMap Di)).val.app (Opposite.op W)).hom d = 0 := by
    have h := congrArg (fun φ => (φ.val.app (Opposite.op W)).hom c) h2
    have e1 : ((θ.hom.app (wcSuppObj Di)).val.app (Opposite.op W)).hom
        (((Dv.μ.inv ≫ Dv.Φ.map (wcSuppUnitMap Di)).val.app (Opposite.op W)).hom c) = 0 := by
      rw [hc, map_zero]
    exact h.symm.trans e1

  let sW : Y.ProEt := (wcSliceFunctor Y V).obj W
  let d' : C(↥sW.left, ULift.{u+1} ℚ_[ℓ]) := d
  have h3 := wc_supp_hom_twist_formula Di hDi (wcSuppUnitMap Di) sW d'
  have hd' : ((wcSuppUnitMap Di).val.app (Opposite.op sW)).hom d' = 0 := hd
  have s3 : ∀ (x : ↥sW.left) (z : ↥Z), sW.hom x = i z → d' x = 0 := by
    intro x z hx
    obtain ⟨p, hp1, hp2⟩ := Scheme.Pullback.exists_preimage_pullback (f := sW.hom) (g := i) x z hx
    have e : (d'.comp (Limits.pullback.fst sW.hom i).base.hom *
        (wcSuppTwist (wcSuppUnitMap Di)).comp (Limits.pullback.snd sW.hom i).base.hom) p = 0 := by
      rw [← h3, hd']
      rfl
    have e' : d' x * wcSuppTwist (wcSuppUnitMap Di) z = 0 := by
      rw [← hp1, ← hp2]
      exact e
    have e2 : wcSuppTwist (wcSuppUnitMap Di) z * cDi z = 1 := congrArg (fun φ => φ z) hcDi
    linear_combination (cDi z) * e' - (d' x) * e2

  let c' : C(↥W.left, ULift.{u+1} ℚ_[ℓ]) := c
  have hcd : (g₀.val.app (Opposite.op W)).hom d = c := by
    have h := congrArg (fun φ => (φ.val.app (Opposite.op W)).hom c) hfg
    exact h
  let d₂ : (wcRingSheaf V.left ℓ).obj.obj (Opposite.op W) := d
  let d₃ : C(↥W.left, ULift.{u+1} ℚ_[ℓ]) := d
  let w' : C(↥W.left, ULift.{u+1} ℚ_[ℓ]) :=
    (g₀.val.app (Opposite.op W)).hom (1 : C(↥W.left, ULift.{u+1} ℚ_[ℓ]))
  have hlin : c' = d₃ * w' := by
    have h := (g₀.val.app (Opposite.op W)).hom.map_smul d₂ (1 : C(↥W.left, ULift.{u+1} ℚ_[ℓ]))
    refine hcd.symm.trans ?_
    refine Eq.trans ?_ h
    exact congrArg (g₀.val.app (Opposite.op W)).hom (mul_one d₃).symm

  have h5 := wc_supp_hom_twist_formula DV hDV (wcSuppUnitMap DV) W c'
  refine h5.trans (ContinuousMap.ext fun p => ?_)
  have ha : W.hom ((Limits.pullback.fst W.hom (Limits.pullback.fst V.hom i)) p) =
      (Limits.pullback.fst V.hom i) ((Limits.pullback.snd W.hom (Limits.pullback.fst V.hom i)) p) := by
    rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
  have hb : V.hom ((Limits.pullback.fst V.hom i)
        ((Limits.pullback.snd W.hom (Limits.pullback.fst V.hom i)) p)) =
      i ((Limits.pullback.snd V.hom i)
        ((Limits.pullback.snd W.hom (Limits.pullback.fst V.hom i)) p)) := by
    rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
  have hx : (W.hom ≫ V.hom) ((Limits.pullback.fst W.hom (Limits.pullback.fst V.hom i)) p) =
      i ((Limits.pullback.snd V.hom i)
        ((Limits.pullback.snd W.hom (Limits.pullback.fst V.hom i)) p)) := by
    rw [Scheme.Hom.comp_apply, ha, hb]
  have hd0 : d₃ ((Limits.pullback.fst W.hom (Limits.pullback.fst V.hom i)) p) = 0 :=
    s3 ((Limits.pullback.fst W.hom (Limits.pullback.fst V.hom i)) p) _ hx
  have hc0 : c' ((Limits.pullback.fst W.hom (Limits.pullback.fst V.hom i)) p) = 0 := by
    rw [hlin, ContinuousMap.mul_apply, hd0, zero_mul]
  show c' ((Limits.pullback.fst W.hom (Limits.pullback.fst V.hom i)).base.hom p) *
      (wcSuppTwist (wcSuppUnitMap DV))
        ((Limits.pullback.snd W.hom (Limits.pullback.fst V.hom i)).base.hom p) = 0
  rw [show c' ((Limits.pullback.fst W.hom (Limits.pullback.fst V.hom i)).base.hom p) = 0
    from hc0, zero_mul]

theorem wc_supp_obj_fun_end_bijective {X Z' : Scheme.{u}} (i' : Z' ⟶ X) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (D : wcHMPullData i' ℓ) (hD : wcHMPullCanonical D) (hepi : Epi (wcSuppUnitMap D)) :
    Function.Bijective (fun b : C(↥Z', ULift.{u+1} ℚ_[ℓ]) =>
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i') _ _ D.cont D.φ).map
        (wcHMFun Z' ℓ b)) :=
by
  classical
  have hlam1 : Limits.pullback.lift i' (𝟙 Z')
      ((Category.comp_id i').trans (Category.id_comp i').symm) ≫
      Limits.pullback.fst (𝟙 X) i' = i' := Limits.pullback.lift_fst _ _ _
  have hlam2 : Limits.pullback.lift i' (𝟙 Z')
      ((Category.comp_id i').trans (Category.id_comp i').symm) ≫
      Limits.pullback.snd (𝟙 X) i' = 𝟙 Z' := Limits.pullback.lift_snd _ _ _
  let T : X.ProEt := MorphismProperty.Over.mk ⊤ (𝟙 X) (inferInstance : WeaklyEtale (𝟙 X))

  have TF : ∀ (ρ' : SheafOfModules.unit (wcRingSheaf X ℓ) ⟶ wcSuppObj D) (V : X.ProEt)
      (t : C(↥V.left, ULift.{u+1} ℚ_[ℓ])),
      ((ρ'.val.app (Opposite.op V)).hom t : C(↥(Limits.pullback V.hom i'), ULift.{u+1} ℚ_[ℓ])) =
        t.comp (Limits.pullback.fst V.hom i').base.hom *
          (wcSuppTwist ρ').comp (Limits.pullback.snd V.hom i').base.hom := by
    intro ρ' V t
    let e : V ⟶ T := MorphismProperty.Over.homMk V.hom (Category.comp_id V.hom) trivial
    let β : Limits.pullback V.hom i' ⟶ Limits.pullback (𝟙 X) i' := ((wcProEtBC i').map e).left
    have hβw : β ≫ Limits.pullback.snd (𝟙 X) i' = Limits.pullback.snd V.hom i' :=
      MorphismProperty.Over.w ((wcProEtBC i').map e)
    have hβ : β = Limits.pullback.snd V.hom i' ≫
        Limits.pullback.lift i' (𝟙 Z') ((Category.comp_id i').trans (Category.id_comp i').symm) := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hlam1, ← hβw, Category.assoc, ← Limits.pullback.condition,
          Category.comp_id]
      · rw [Category.assoc, hlam2, Category.comp_id, hβw]
    let m1 : C(↥(Limits.pullback V.hom i'), ULift.{u+1} ℚ_[ℓ]) :=
      (ρ'.val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))
    let mT : C(↥(Limits.pullback (𝟙 X) i'), ULift.{u+1} ℚ_[ℓ]) :=
      (ρ'.val.app (Opposite.op T)).hom (1 : C(↥X, ULift.{u+1} ℚ_[ℓ]))
    have e1 : m1 = mT.comp β.base.hom :=
      PresheafOfModules.naturality_apply ρ'.val e.op (1 : C(↥X, ULift.{u+1} ℚ_[ℓ]))
    let mt : C(↥(Limits.pullback V.hom i'), ULift.{u+1} ℚ_[ℓ]) :=
      (ρ'.val.app (Opposite.op V)).hom t
    let φt : C(↥(Limits.pullback V.hom i'), ULift.{u+1} ℚ_[ℓ]) :=
      (D.φ.hom.app (Opposite.op V)).hom t
    have hφ : φt = t.comp (Limits.pullback.fst V.hom i').base.hom := hD V t
    have e2 : mt = t.comp (Limits.pullback.fst V.hom i').base.hom * m1 := by
      have h := (ρ'.val.app (Opposite.op V)).hom.map_smul t (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))
      have h' : ((ρ'.val.app (Opposite.op V)).hom (t * 1) :
            C(↥(Limits.pullback V.hom i'), ULift.{u+1} ℚ_[ℓ])) = φt * m1 := h
      rw [hφ] at h'
      have h0 : ((ρ'.val.app (Opposite.op V)).hom (t * 1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ])) :
          C(↥(Limits.pullback V.hom i'), ULift.{u+1} ℚ_[ℓ])) = mt :=
        congrArg (fun x => (ρ'.val.app (Opposite.op V)).hom x) (mul_one t)
      exact h0.symm.trans h'
    have e3 : mT.comp (Limits.pullback.snd V.hom i' ≫
        Limits.pullback.lift i' (𝟙 Z')
          ((Category.comp_id i').trans (Category.id_comp i').symm)).base.hom =
        (wcSuppTwist ρ').comp (Limits.pullback.snd V.hom i').base.hom :=
      ContinuousMap.ext fun _ => rfl
    show mt = _
    rw [e2, e1, hβ, e3]

  obtain ⟨c', hc'⟩ : ∃ c' : C(↥Z', ULift.{u+1} ℚ_[ℓ]), wcSuppTwist (wcSuppUnitMap D) * c' = 1 := by
    letI := D.cont
    let u0 := SheafOfModules.unitToPushforwardObjUnit D.φ
    let ψ₁ := (D.adj.homEquiv _ _).symm u0
    let h : SheafOfModules.unit (wcRingSheaf Z' ℓ) ⟶ SheafOfModules.unit (wcRingSheaf Z' ℓ) :=
      D.μ.inv ≫ ψ₁
    have hfac : u0 = wcSuppUnitMap D ≫
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i') _ _ D.cont D.φ).map h := by
      have e1 : D.μ.hom ≫ h = ψ₁ := Iso.hom_inv_id_assoc _ _
      calc u0 = D.adj.homEquiv _ _ ψ₁ := (Equiv.apply_symm_apply _ _).symm
        _ = D.adj.homEquiv _ _ (D.μ.hom ≫ h) := by rw [e1]
        _ = D.adj.homEquiv _ _ D.μ.hom ≫
            (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i') _ _ D.cont D.φ).map h :=
          Adjunction.homEquiv_naturality_right _ _ _
        _ = wcSuppUnitMap D ≫
            (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i') _ _ D.cont D.φ).map h := by
          rw [Adjunction.homEquiv_unit]; rfl
    let cT : C(↥(Limits.pullback (𝟙 X) i'), ULift.{u+1} ℚ_[ℓ]) :=
      ((wcSuppUnitMap D).val.app (Opposite.op T)).hom (1 : C(↥X, ULift.{u+1} ℚ_[ℓ]))
    let a : C(↥(Limits.pullback (𝟙 X) i'), ULift.{u+1} ℚ_[ℓ]) :=
      (h.val.app (Opposite.op ((wcProEtBC i').obj T))).hom
        (1 : C(↥(Limits.pullback (𝟙 X) i'), ULift.{u+1} ℚ_[ℓ]))
    have hu1 : (u0.val.app (Opposite.op T)).hom (1 : C(↥X, ULift.{u+1} ℚ_[ℓ])) =
        (1 : C(↥(Limits.pullback (𝟙 X) i'), ULift.{u+1} ℚ_[ℓ])) :=
      (D.φ.hom.app (Opposite.op T)).hom.map_one
    have hev : (u0.val.app (Opposite.op T)).hom (1 : C(↥X, ULift.{u+1} ℚ_[ℓ])) =
        (h.val.app (Opposite.op ((wcProEtBC i').obj T))).hom cT := by
      rw [hfac]
      rfl
    have hlin : ∀ x : C(↥(Limits.pullback (𝟙 X) i'), ULift.{u+1} ℚ_[ℓ]),
        (h.val.app (Opposite.op ((wcProEtBC i').obj T))).hom x = x * a := by
      intro x
      have e := (h.val.app (Opposite.op ((wcProEtBC i').obj T))).hom.map_smul x
        (1 : C(↥(Limits.pullback (𝟙 X) i'), ULift.{u+1} ℚ_[ℓ]))
      have e2 : (h.val.app (Opposite.op ((wcProEtBC i').obj T))).hom x =
          (h.val.app (Opposite.op ((wcProEtBC i').obj T))).hom (x * 1) :=
        congrArg (fun y => (h.val.app (Opposite.op ((wcProEtBC i').obj T))).hom y) (mul_one x).symm
      exact e2.trans e
    have key : cT * a = 1 := by
      rw [← hlin cT, ← hev, hu1]
    refine ⟨a.comp (Limits.pullback.lift i' (𝟙 Z')
      ((Category.comp_id i').trans (Category.id_comp i').symm)).base.hom, ?_⟩
    show cT.comp (Limits.pullback.lift i' (𝟙 Z')
        ((Category.comp_id i').trans (Category.id_comp i').symm)).base.hom *
      a.comp (Limits.pullback.lift i' (𝟙 Z')
        ((Category.comp_id i').trans (Category.id_comp i').symm)).base.hom = 1
    rw [← ContinuousMap.mul_comp, key, ContinuousMap.one_comp]

  have S1 : ∀ ρ₁ ρ₂ : SheafOfModules.unit (wcRingSheaf X ℓ) ⟶ wcSuppObj D,
      wcSuppTwist ρ₁ = wcSuppTwist ρ₂ → ρ₁ = ρ₂ := by
    intro ρ₁ ρ₂ h
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro V'
    obtain ⟨V⟩ := V'
    refine ModuleCat.hom_ext (LinearMap.ext fun t => ?_)
    have e₁ := TF ρ₁ V t
    have e₂ := TF ρ₂ V t
    rw [h] at e₁
    exact e₁.trans e₂.symm

  have S2 : ∀ (ρ' : SheafOfModules.unit (wcRingSheaf X ℓ) ⟶ wcSuppObj D)
      (b : C(↥Z', ULift.{u+1} ℚ_[ℓ])),
      wcSuppTwist (D := D) (ρ' ≫
        (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i') _ _ D.cont D.φ).map
          (wcHMFun Z' ℓ b)) = wcSuppTwist ρ' * b := by
    intro ρ' b
    have F5 : (b.comp (Limits.pullback.snd (𝟙 X) i').base.hom).comp
        (Limits.pullback.lift i' (𝟙 Z')
          ((Category.comp_id i').trans (Category.id_comp i').symm)).base.hom = b :=
      ContinuousMap.ext fun z => congrArg (fun k : Z' ⟶ Z' => b (k.base z)) hlam2
    let mT : C(↥(Limits.pullback (𝟙 X) i'), ULift.{u+1} ℚ_[ℓ]) :=
      (ρ'.val.app (Opposite.op T)).hom (1 : C(↥X, ULift.{u+1} ℚ_[ℓ]))
    let mTb : C(↥(Limits.pullback (𝟙 X) i'), ULift.{u+1} ℚ_[ℓ]) :=
      ((ρ' ≫
        (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i') _ _ D.cont D.φ).map
          (wcHMFun Z' ℓ b)).val.app (Opposite.op T)).hom (1 : C(↥X, ULift.{u+1} ℚ_[ℓ]))
    have F : mTb = mT * b.comp (Limits.pullback.snd (𝟙 X) i').base.hom := by
      first
        | rfl
        | exact mul_comm _ _
    show mTb.comp (Limits.pullback.lift i' (𝟙 Z')
          ((Category.comp_id i').trans (Category.id_comp i').symm)).base.hom =
      (mT.comp (Limits.pullback.lift i' (𝟙 Z')
          ((Category.comp_id i').trans (Category.id_comp i').symm)).base.hom) * b
    rw [F, ContinuousMap.mul_comp, F5]

  haveI := hepi
  refine ⟨fun b₁ b₂ h => ?_, fun φ => ?_⟩
  · have h0 : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i') _ _ D.cont D.φ).map
        (wcHMFun Z' ℓ b₁) =
        (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i') _ _ D.cont D.φ).map
        (wcHMFun Z' ℓ b₂) := h
    have h' : wcSuppTwist (D := D) (wcSuppUnitMap D ≫
        (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i') _ _ D.cont D.φ).map
          (wcHMFun Z' ℓ b₁)) =
        wcSuppTwist (D := D) (wcSuppUnitMap D ≫
        (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i') _ _ D.cont D.φ).map
          (wcHMFun Z' ℓ b₂)) := by rw [h0]
    rw [S2, S2] at h'
    calc b₁ = (wcSuppTwist (wcSuppUnitMap D) * c') * b₁ := by rw [hc', one_mul]
      _ = c' * (wcSuppTwist (wcSuppUnitMap D) * b₁) := by ring
      _ = c' * (wcSuppTwist (wcSuppUnitMap D) * b₂) := by rw [h']
      _ = (wcSuppTwist (wcSuppUnitMap D) * c') * b₂ := by ring
      _ = b₂ := by rw [hc', one_mul]
  · let φ' : wcSuppObj D ⟶ wcSuppObj D := φ
    refine ⟨c' * wcSuppTwist (D := D) (wcSuppUnitMap D ≫ φ'), ?_⟩
    have htw : wcSuppTwist (D := D) (wcSuppUnitMap D ≫
        (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i') _ _ D.cont D.φ).map
          (wcHMFun Z' ℓ (c' * wcSuppTwist (D := D) (wcSuppUnitMap D ≫ φ')))) =
        wcSuppTwist (D := D) (wcSuppUnitMap D ≫ φ') := by
      rw [S2, ← mul_assoc, hc', one_mul]
    have key := S1 _ _ htw
    exact (cancel_epi (wcSuppUnitMap D)).mp key

