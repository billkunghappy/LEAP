    @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ Dg.adj Dg.additive
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf OU.toScheme ℓ)) := HasExt.standard _
  haveI := Dg.cont

  obtain ⟨j, rfl⟩ : ∃ j, n = j + 1 := ⟨n - 1, by omega⟩
  haveI : IsLocallyNoetherian (AffineSpace (ULift.{u} (Fin d)) U) :=
    (wc_tl_zero_section_facts F d qU).2.2.2 inferInstance
  haveI hgqc : QuasiCompact (OU.ι ≫ (AffineSpace (ULift.{u} (Fin d)) U ↘ U)) := inferInstance
  haveI hgsep : IsSeparated (OU.ι ≫ (AffineSpace (ULift.{u} (Fin d)) U ↘ U)) := inferInstance

  have hN4 : ∀ (Y : Scheme.{u}) [CompactSpace Y] [IsSeparated (Limits.terminal.from Y)] (m : ℕ),
