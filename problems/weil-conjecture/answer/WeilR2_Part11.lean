theorem wc_proet_closed_rightAdj_homology_zero_of_open_push {X Z : Scheme.{u}} (i : Z ⟶ X)
    [IsClosedImmersion i] [IsLocallyNoetherian X] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (Rs : SheafOfModules.{u+1} (wcRingSheaf X ℓ) ⥤ SheafOfModules.{u+1} (wcRingSheaf Z ℓ))
    (adj : @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ ⊣ Rs)
    (I : InjectiveResolution (SheafOfModules.unit (wcRingSheaf X ℓ)))
    (V : X.Opens) (hV : (V : Set X) = (Set.range i)ᶜ) (q : ℕ) (hq : 1 ≤ q)
    (h1 : q = 1 → IsOpen (Set.range i))
    (h2 : 2 ≤ q → ∀ (Dj : wcHMPullData V.ι ℓ)
      (J : InjectiveResolution (SheafOfModules.unit (wcRingSheaf (V : Scheme.{u}) ℓ))),
      letI : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC V.ι) _ _ Dj.cont Dj.φ).Additive :=
        @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ Dj.adj Dj.additive
      Limits.IsZero ((((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC V.ι) _ _ Dj.cont Dj.φ).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj J.cocomplex).homology (q - 1))) :
    letI : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).Additive :=
      @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ Di.adj Di.additive
    letI : Rs.Additive := Adjunction.right_adjoint_additive adj
    Limits.IsZero (((Rs.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) :=
by

  have abs_main : ∀ {C D E : Type (u+2)} [Category.{u+1} C] [Category.{u+1} D] [Category.{u+1} E]
      [Abelian C] [Abelian D] [Abelian E]
      (P : D ⥤ C) [P.Additive] [P.Full] [P.Faithful] [Limits.PreservesFiniteLimits P]
      [Limits.PreservesFiniteColimits P]
      (R : C ⥤ D) [R.Additive] (adj : P ⊣ R)
      (Φ : C ⥤ E) [Φ.Additive] [Limits.PreservesFiniteLimits Φ] [Limits.PreservesFiniteColimits Φ]
      (Pj : E ⥤ C) [Pj.Additive] (adjj : Φ ⊣ Pj),
      (∀ M : D, Limits.IsZero (Φ.obj (P.obj M))) →
      (∀ K : C, Limits.IsZero (Φ.obj K) → ∃ M : D, Nonempty (P.obj M ≅ K)) →
      (∀ G : C, Injective G → Epi (adjj.unit.app G)) →
      ∀ (A : C) (I : InjectiveResolution A) (m : ℕ), 1 ≤ m →
      (m = 1 → Epi (adjj.unit.app A)) →
      (2 ≤ m → Limits.IsZero (((Pj.mapHomologicalComplex (ComplexShape.up ℕ)).obj
        ((Φ.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex)).homology (m - 1))) →
      Limits.IsZero (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology m) := by
    intro C D E _ _ _ _ _ _ P _ _ _ _ _ R _ adj Φ _ _ _ Pj _ adjj h6 h7 h8 A I m hm h1 h2
    have K0 : ∀ {A' G : C} (f : A' ⟶ G), f ≫ adjj.unit.app G = 0 → Φ.map f = 0 := by
      intro A' G f hf
      apply (adjj.homEquiv A' (Φ.obj G)).injective
      rw [Adjunction.homEquiv_unit, Adjunction.homEquiv_unit, adjj.unit_naturality, hf,
        Functor.map_zero, Limits.comp_zero]
    have K0' : ∀ {A' G : C} (f : A' ⟶ G), Φ.map f = 0 → f ≫ adjj.unit.app G = 0 := by
      intro A' G f hf
      rw [← adjj.unit_naturality, hf, Functor.map_zero, Limits.comp_zero]
    have zero_of_mono_zero : ∀ {Y₁ Y₂ : E} (g : Y₁ ⟶ Y₂) [Mono g], g = 0 → Limits.IsZero Y₁ := by
      intro Y₁ Y₂ g _ hg
      rw [Limits.IsZero.iff_id_eq_zero]
      apply (cancel_mono g).1
      rw [hg, Limits.comp_zero, Limits.comp_zero]
    have hker : ∀ G : C, adj.counit.app G ≫ adjj.unit.app G = 0 ∧ Mono (adj.counit.app G) ∧
        ∀ (A' : C) (f : A' ⟶ G), f ≫ adjj.unit.app G = 0 →
          ∃ g : A' ⟶ P.obj (R.obj G), g ≫ adj.counit.app G = f := by
      intro G
      refine ⟨K0' _ ((h6 _).eq_of_src _ _), ?_, ?_⟩
      · apply Preadditive.mono_of_kernel_zero
        have hz : Limits.IsZero (Φ.obj (Limits.kernel (adj.counit.app G))) :=
          Limits.IsZero.of_mono (Φ.map (Limits.kernel.ι (adj.counit.app G))) (h6 _)
        obtain ⟨M, ⟨e⟩⟩ := h7 _ hz
        have hκ : P.preimage (e.hom ≫ Limits.kernel.ι (adj.counit.app G)) = 0 := by
          apply (adj.homEquiv M G).symm.injective
          rw [Adjunction.homEquiv_counit, Adjunction.homEquiv_counit, Functor.map_preimage,
            Category.assoc, Limits.kernel.condition, Limits.comp_zero, Functor.map_zero,
            Limits.zero_comp]
        have h3 : e.hom ≫ Limits.kernel.ι (adj.counit.app G) = 0 := by
          rw [← P.map_preimage (e.hom ≫ Limits.kernel.ι (adj.counit.app G)), hκ, Functor.map_zero]
        calc Limits.kernel.ι (adj.counit.app G)
            = e.inv ≫ (e.hom ≫ Limits.kernel.ι (adj.counit.app G)) := by simp
          _ = 0 := by rw [h3, Limits.comp_zero]
      · intro A' f hf
        have hΦf := K0 f hf
        have hm0 : Φ.map (Limits.image.ι f) = 0 := by
          apply (cancel_epi (Φ.map (Limits.factorThruImage f))).1
          rw [← Φ.map_comp, Limits.image.fac, hΦf, Limits.comp_zero]
        have hz : Limits.IsZero (Φ.obj (Limits.image f)) := zero_of_mono_zero _ hm0
        obtain ⟨M, ⟨e⟩⟩ := h7 _ hz
        refine ⟨Limits.factorThruImage f ≫ e.inv ≫
          P.map (adj.homEquiv M G (e.hom ≫ Limits.image.ι f)), ?_⟩
        have hc := adj.homEquiv_counit M G (adj.homEquiv M G (e.hom ≫ Limits.image.ι f))
        rw [Equiv.symm_apply_apply] at hc
        rw [Category.assoc, Category.assoc, ← hc, Iso.inv_hom_id_assoc, Limits.image.fac]
    let ψ : (P.mapHomologicalComplex (ComplexShape.up ℕ)).obj
        ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex) ⟶ I.cocomplex :=
      { f := fun p => adj.counit.app (I.cocomplex.X p)
        comm' := fun i j _ => (adj.counit_naturality (I.cocomplex.d i j)).symm }
    let φ : I.cocomplex ⟶ (Pj.mapHomologicalComplex (ComplexShape.up ℕ)).obj
        ((Φ.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex) :=
      { f := fun p => adjj.unit.app (I.cocomplex.X p)
        comm' := fun i j _ => (adjj.unit_naturality (I.cocomplex.d i j)) }
    have hψφ : ψ ≫ φ = 0 := by
      ext p
      exact (hker _).1
    let S := ShortComplex.mk ψ φ hψφ
    have hS : S.ShortExact := by
      apply HomologicalComplex.shortExact_of_degreewise_shortExact
      intro p
      obtain ⟨hz, hmono, hlift⟩ := hker (I.cocomplex.X p)
      let T := ShortComplex.mk (adj.counit.app (I.cocomplex.X p))
        (adjj.unit.app (I.cocomplex.X p)) hz
      have hT : T.ShortExact := by
        refine ShortComplex.ShortExact.mk' ?_ hmono (h8 _ (I.injective p))
        exact ShortComplex.exact_of_f_is_kernel T
          (Limits.KernelFork.IsLimit.ofι' T.f T.zero (fun k hk =>
            ⟨(hlift _ k hk).choose, (hlift _ k hk).choose_spec⟩))
      exact hT
    have hIz : ∀ n : ℕ, Limits.IsZero (I.cocomplex.homology (n + 1)) := fun n =>
      (HomologicalComplex.exactAt_iff_isZero_homology _ _).1 (I.cocomplex_exactAt_succ n)
    have hX1 : Limits.IsZero (S.X₁.homology m) := by
      obtain ⟨n, rfl⟩ : ∃ n, m = n + 1 := ⟨m - 1, by omega⟩
      rcases Nat.eq_zero_or_pos n with hn | hn
      · subst hn
        have hηA : Epi (adjj.unit.app (((CochainComplex.single₀ C).obj A).X 0)) := h1 rfl
        have hepi : Epi (HomologicalComplex.homologyMap φ 0) := by
          have hnx : (ComplexShape.up ℕ).next 0 = 1 := by simp
          have hk : I.ι.f 0 ≫ I.cocomplex.d 0 1 = 0 := I.ι_f_zero_comp_complex_d
          let a := I.cocomplex.liftCycles (I.ι.f 0) 1 hnx hk
          haveI : Limits.PreservesLimitsOfSize.{0, 0} Pj := adjj.rightAdjoint_preservesLimits
          have hl := Limits.KernelFork.mapIsLimit _ (I.exact₀.fIsKernel) (Φ ⋙ Pj)
          let X₃ := (Pj.mapHomologicalComplex (ComplexShape.up ℕ)).obj
            ((Φ.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex)
          let e := Limits.IsLimit.conePointUniqueUpToIso hl (X₃.cyclesIsKernel 0 1 hnx)
          let e' : (Φ ⋙ Pj).obj (((CochainComplex.single₀ C).obj A).X 0) ⟶ X₃.cycles 0 := e.hom
          haveI : IsIso e' := (inferInstance : IsIso e.hom)
          have he : e' ≫ X₃.iCycles 0 = Pj.map (Φ.map (I.ι.f 0)) :=
            Limits.IsLimit.conePointUniqueUpToIso_hom_comp hl (X₃.cyclesIsKernel 0 1 hnx)
              Limits.WalkingParallelPair.zero
          have hkey : a ≫ HomologicalComplex.cyclesMap φ 0 =
              adjj.unit.app (((CochainComplex.single₀ C).obj A).X 0) ≫ e' := by
            rw [← cancel_mono (X₃.iCycles 0), Category.assoc, Category.assoc, he,
              HomologicalComplex.cyclesMap_i, HomologicalComplex.liftCycles_i_assoc]
            exact (adjj.unit_naturality (I.ι.f 0)).symm
          have h3 : Epi (a ≫ HomologicalComplex.cyclesMap φ 0) := by
            rw [hkey]; infer_instance
          have h4 : Epi (HomologicalComplex.cyclesMap φ 0) := epi_of_epi a _
          exact epi_of_epi_fac (HomologicalComplex.homologyπ_naturality φ 0)
        have hδ0 : hS.δ 0 1 rfl = 0 := by
          apply (cancel_epi (HomologicalComplex.homologyMap φ 0)).1
          rw [Limits.comp_zero]
          exact hS.comp_δ 0 1 rfl
        have hδepi : Epi (hS.δ 0 1 rfl) :=
          (hS.homology_exact₁ 0 1 rfl).epi_f ((hIz 0).eq_of_tgt _ _)
        rw [Limits.IsZero.iff_id_eq_zero]
        apply (cancel_epi (hS.δ 0 1 rfl)).1
        rw [hδ0, Limits.zero_comp, Limits.zero_comp]
      · have h2' := h2 (by omega)
        rw [Nat.add_sub_cancel] at h2'
        exact (hS.homology_exact₁ n (n + 1) rfl).isZero_X₂ (h2'.eq_of_src _ _)
          ((hIz n).eq_of_tgt _ _)
    haveI : P.PreservesHomology := Functor.preservesHomologyOfExact P
    rw [← HomologicalComplex.exactAt_iff_isZero_homology, HomologicalComplex.exactAt_iff]
    rw [← HomologicalComplex.exactAt_iff_isZero_homology, HomologicalComplex.exactAt_iff] at hX1
    exact (ShortComplex.exact_map_iff_of_faithful _ P).1 hX1

  have s6 : ∀ (Dj : wcHMPullData V.ι ℓ) (hDj : wcHMPullCanonical Dj)
      (G : SheafOfModules.{u+1} (wcRingSheaf X ℓ)), Injective G → Injective (Dj.Φ.obj G) := by
    intro Dj hDj G hG
    haveI hσ : (wcSliceToOver X (Scheme.ProEt.mk V.ι)).IsContinuous
        (Scheme.ProEt.topology (Scheme.ProEt.mk V.ι).left)
        ((Scheme.ProEt.topology X).over (Scheme.ProEt.mk V.ι)) :=
      (wc_slice_over_sites_cont X (Scheme.ProEt.mk V.ι)).1
    haveI hj : (wcSliceFunctor X (Scheme.ProEt.mk V.ι)).IsContinuous
        (Scheme.ProEt.topology (Scheme.ProEt.mk V.ι).left) (Scheme.ProEt.topology X) :=
      Functor.isContinuous_comp (wcSliceToOver X (Scheme.ProEt.mk V.ι))
        (Over.forget (Scheme.ProEt.mk V.ι))
        (Scheme.ProEt.topology (Scheme.ProEt.mk V.ι).left)
        ((Scheme.ProEt.topology X).over (Scheme.ProEt.mk V.ι)) (Scheme.ProEt.topology X)
    obtain ⟨e⟩ := wc_hm_pull_Phi_slice_iso X ℓ (Scheme.ProEt.mk V.ι) Dj hDj
    haveI : IsOpenImmersion (Scheme.ProEt.mk V.ι).hom := (inferInstance : IsOpenImmersion V.ι)
    haveI := hG
    have hinj : Injective ((wcSliceRes X ℓ (Scheme.ProEt.mk V.ι)).obj G) :=
      wc_open_slice_res_preserves_injective (ℓ := ℓ) (Scheme.ProEt.mk V.ι) G
    exact Injective.of_iso (e.app G).symm hinj

  haveI := Di.additive
  haveI hPadd : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont
      Di.φ).Additive := @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ Di.adj Di.additive
  haveI hRadd : Rs.Additive := Adjunction.right_adjoint_additive adj
  haveI hPlim : Limits.PreservesFiniteLimits
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ) := by
    haveI := Di.adj.rightAdjoint_preservesLimits.{0, 0}
    exact Limits.PreservesLimitsOfSize.preservesFiniteLimits.{0, 0} _
  haveI hPcolim := wc_closed_pushforward_exact_of_noetherian i ℓ Di
  obtain ⟨hfull, hfaith⟩ := wc_proet_closed_push_modules_full_faithful i ℓ Di hDi
  obtain ⟨Dj, hDj⟩ := wc_hm_pull_data_exists V.ι ℓ
  haveI := Dj.additive
  haveI := Dj.presLim
  haveI := Dj.presColim
  letI hPjadd : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC V.ι) _ _ Dj.cont
      Dj.φ).Additive := @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ Dj.adj Dj.additive
  refine abs_main
    (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ) Rs adj Dj.Φ
    (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC V.ι) _ _ Dj.cont Dj.φ) Dj.adj
    (fun M => wc_proet_open_pull_closed_push_isZero i ℓ V hV Di Dj hDj M)
    (fun K hK => wc_proet_closed_push_essImage_of_open_pull_isZero i ℓ V hV Di hDi Dj hDj K hK)
    (fun G hG => wc_proet_open_unit_epi_of_injective V ℓ Dj hDj G hG)
    _ I q hq ?_ ?_
  · intro h
    have hcl : IsClosed (V : Set X) := by
      rw [hV]
      exact (h1 h).isClosed_compl
    exact wc_proet_open_unit_epi_of_isClosed V ℓ Dj hDj _ hcl
  · intro h2m
    haveI : Dj.Φ.PreservesHomology := Functor.preservesHomologyOfExact _
    haveI := I.quasiIso
    haveI : QuasiIso ((Dj.Φ.mapHomologicalComplex (ComplexShape.up ℕ)).map I.ι) :=
      HomologicalComplex.quasiIso_map_of_preservesHomology _ _
    let J : InjectiveResolution (SheafOfModules.unit (wcRingSheaf (V : Scheme.{u}) ℓ)) :=
      { cocomplex := (Dj.Φ.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex
        injective := fun n => s6 Dj hDj _ (I.injective n)
        ι := (CochainComplex.single₀ _).map Dj.μ.inv ≫
          (HomologicalComplex.singleMapHomologicalComplex Dj.Φ (ComplexShape.up ℕ) 0).inv.app _ ≫
          (Dj.Φ.mapHomologicalComplex (ComplexShape.up ℕ)).map I.ι
        quasiIso := by infer_instance }
    exact h2 h2m Dj J

theorem wc_weaklyEtale_strictHensel_prosystem {Y : Scheme.{u}} (A : Type u) [CommRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (c : Spec (.of A) ⟶ Y) (hc : WeaklyEtale c) :
    ∃ (Λ : Type u) (_ : SmallCategory Λ) (_ : IsCofiltered Λ) (D : Λ ⥤ Y.Etale)
      (φ : ∀ l, Spec (.of A) ⟶ (D.obj l).left),
      (∀ l, IsAffine (D.obj l).left) ∧
      (∀ {l l' : Λ} (t : l ⟶ l'), φ l ≫ (D.map t).left = φ l') ∧
      (∀ l, φ l ≫ (D.obj l).hom = c) ∧
      (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (D.obj l).left),
        (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (D.map t).left = z l') →
        ∃! z₀ : T ⟶ Spec (.of A), ∀ l, z₀ ≫ φ l = z l) :=
by

  have s1 : ∀ (R A : Type u) [CommRing R] [CommRing A] (σ : R →+* A), wcIndEtale σ → ∀ a : A, ∃ (E : Type u) (_ : CommRing E) (_ : Algebra R E) (β : E →+* A) (x : E), Algebra.Etale R E ∧ β.comp (algebraMap R E) = σ ∧ β x = a := by
    intro R A _ _ σ hσ a
    letI := σ.toAlgebra
    obtain ⟨E, _, _, hE, α, β, hαβ⟩ := hσ (Polynomial R) (Polynomial.aeval a)
    refine ⟨E, inferInstance, inferInstance, β.toRingHom, α Polynomial.X, hE, ?_, ?_⟩
    · ext r
      exact β.commutes r
    · have := congrArg (fun f => f Polynomial.X) hαβ
      simpa using this

  have s2 : ∀ (R A : Type u) [CommRing R] [CommRing A] (σ : R →+* A), wcIndEtale σ → ∀ (E : Type u) [CommRing E] [Algebra R E], Algebra.Etale R E → ∀ (β : E →+* A), β.comp (algebraMap R E) = σ → ∀ (m : ℕ) (x y : Fin m → E), (∀ i, β (x i) = β (y i)) → ∃ (E' : Type u) (_ : CommRing E') (_ : Algebra R E') (q : E →ₐ[R] E') (β' : E' →+* A), Algebra.Etale R E' ∧ β'.comp (algebraMap R E') = σ ∧ β'.comp q.toRingHom = β ∧ ∀ i, q (x i) = q (y i) := by
    intro R A _ _ σ hσ E _ _ hE β hβ m x y hxy
    letI := σ.toAlgebra
    let βₐ : E →ₐ[R] A := { β with commutes' := fun r => RingHom.congr_fun hβ r }
    let I : Ideal E := Ideal.span (Set.range (fun i => x i - y i))
    haveI : Algebra.FinitePresentation R E := inferInstance
    haveI : Algebra.FinitePresentation R (E ⧸ I) :=
      Algebra.FinitePresentation.quotient (Submodule.fg_span (Set.finite_range _))
    have hle : I ≤ RingHom.ker β := by
      rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      simp [RingHom.mem_ker, map_sub, hxy i]
    have hI : ∀ a ∈ I, βₐ a = 0 := fun a ha => hle ha
    obtain ⟨E', _, _, hE', α, β', hαβ'⟩ := hσ (E ⧸ I) (Ideal.Quotient.liftₐ I βₐ hI)
    refine ⟨E', inferInstance, inferInstance, α.comp (Ideal.Quotient.mkₐ R I), β'.toRingHom, hE',
      ?_, ?_, ?_⟩
    · ext r
      exact β'.commutes r
    · ext e
      have := congrArg (fun f => f (Ideal.Quotient.mk I e)) hαβ'
      simpa [βₐ] using this
    · intro i
      show α (Ideal.Quotient.mk I (x i)) = α (Ideal.Quotient.mk I (y i))
      rw [Ideal.Quotient.eq.mpr
        (Ideal.subset_span (⟨i, rfl⟩ : x i - y i ∈ Set.range (fun i => x i - y i)))]

  have s3 : ∀ (R A : Type u) [CommRing R] [CommRing A] (σ : R →+* A), (∀ a : A, ∃ (E : Type u) (_ : CommRing E) (_ : Algebra R E) (β : E →+* A) (x : E), Algebra.Etale R E ∧ β.comp (algebraMap R E) = σ ∧ β x = a) → (∀ (E : Type u) [CommRing E] [Algebra R E], Algebra.Etale R E → ∀ (β : E →+* A), β.comp (algebraMap R E) = σ → ∀ (m : ℕ) (x y : Fin m → E), (∀ i, β (x i) = β (y i)) → ∃ (E' : Type u) (_ : CommRing E') (_ : Algebra R E') (q : E →ₐ[R] E') (β' : E' →+* A), Algebra.Etale R E' ∧ β'.comp (algebraMap R E') = σ ∧ β'.comp q.toRingHom = β ∧ ∀ i, q (x i) = q (y i)) → ∃ (J : Type u) (_ : SmallCategory J) (_ : IsFiltered J) (D : J ⥤ CommRingCat.{u}) (s : ∀ j, R →+* D.obj j) (β : ∀ j, D.obj j ⟶ CommRingCat.of A), (∀ j, (s j).Etale) ∧ (∀ {j j' : J} (t : j ⟶ j'), (D.map t).hom.comp (s j) = s j') ∧ (∀ {j j' : J} (t : j ⟶ j'), D.map t ≫ β j' = β j) ∧ (∀ j, (β j).hom.comp (s j) = σ) ∧ (∀ a : A, ∃ (j : J) (x : D.obj j), (β j).hom x = a) ∧ (∀ (j j' : J) (x : D.obj j) (y : D.obj j'), (β j).hom x = (β j').hom y → ∃ (k : J) (t : j ⟶ k) (t' : j' ⟶ k), (D.map t).hom x = (D.map t').hom y) := by
    intro R A _ _ σ hCOV hEQ
    letI := σ.toAlgebra
    have hOBJ : ∀ (E : Type u) [CommRing E] [Algebra R E], Algebra.Etale R E → ∀ (b : E →ₐ[R] A),
        ∃ (j : wcShObj R A) (e : (MvPolynomial (Fin j.n) R ⧸ j.I) ≃ₐ[R] E),
          ∀ z, j.b z = b (e z) := by
      intro E _ _ hE b
      obtain ⟨n, f, hf⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp
        (inferInstance : Algebra.FiniteType R E)
      let e := Ideal.quotientKerAlgEquivOfSurjective hf
      exact ⟨⟨n, _, b.comp e.toAlgHom, Algebra.Etale.of_equiv e.symm⟩, e, fun _ => rfl⟩
    have toAlg : ∀ (E : Type u) [CommRing E] [Algebra R E] (β : E →+* A),
        β.comp (algebraMap R E) = σ → ∃ b : E →ₐ[R] A, ∀ z, b z = β z := by
      intro E _ _ β hβ
      exact ⟨{ β with commutes' := fun r => RingHom.congr_fun hβ r }, fun _ => rfl⟩
    have hEQ' : ∀ (k₀ : wcShObj R A) (m : ℕ) (x y : Fin m → (MvPolynomial (Fin k₀.n) R ⧸ k₀.I)),
        (∀ i, k₀.b (x i) = k₀.b (y i)) →
        ∃ (k : wcShObj R A) (u : k₀ ⟶ k), ∀ i, u.1 (x i) = u.1 (y i) := by
      intro k₀ m x y hxy
      haveI := k₀.et
      obtain ⟨E', _, _, q, β', hE', hβ', hβq, hq⟩ :=
        hEQ _ k₀.et k₀.b.toRingHom k₀.b.comp_algebraMap m x y hxy
      obtain ⟨b', hb'⟩ := toAlg E' β' hβ'
      obtain ⟨k, e, hk⟩ := hOBJ E' hE' b'
      refine ⟨k, ⟨e.symm.toAlgHom.comp q, ?_⟩, fun i => ?_⟩
      · apply AlgHom.ext
        intro z
        have := RingHom.congr_fun hβq z
        show k.b (e.symm (q z)) = k₀.b z
        rw [hk, AlgEquiv.apply_symm_apply, hb']
        exact this
      · show e.symm (q (x i)) = e.symm (q (y i))
        rw [hq i]
    have hobj : ∀ j₁ j₂ : wcShObj R A, ∃ (k : wcShObj R A) (_ : j₁ ⟶ k) (_ : j₂ ⟶ k), True := by
      intro j₁ j₂
      haveI := j₁.et
      haveI := j₂.et
      haveI : Algebra.Etale (MvPolynomial (Fin j₁.n) R ⧸ j₁.I)
          (TensorProduct R (MvPolynomial (Fin j₁.n) R ⧸ j₁.I) (MvPolynomial (Fin j₂.n) R ⧸ j₂.I)) :=
        Algebra.Etale.baseChange R _ _
      have hE3 : Algebra.Etale R
          (TensorProduct R (MvPolynomial (Fin j₁.n) R ⧸ j₁.I) (MvPolynomial (Fin j₂.n) R ⧸ j₂.I)) :=
        Algebra.Etale.comp R (MvPolynomial (Fin j₁.n) R ⧸ j₁.I) _
      obtain ⟨k, e, hk⟩ := hOBJ _ hE3 (Algebra.TensorProduct.lift j₁.b j₂.b
        (fun _ _ => Commute.all _ _))
      refine ⟨k, ⟨e.symm.toAlgHom.comp Algebra.TensorProduct.includeLeft, ?_⟩,
        ⟨e.symm.toAlgHom.comp Algebra.TensorProduct.includeRight, ?_⟩, trivial⟩
      · apply AlgHom.ext
        intro z
        show k.b (e.symm _) = _
        rw [hk, AlgEquiv.apply_symm_apply]
        simp
      · apply AlgHom.ext
        intro z
        show k.b (e.symm _) = _
        rw [hk, AlgEquiv.apply_symm_apply]
        simp
    haveI hfilt : IsFiltered (wcShObj R A) := by
      have hne : Nonempty (wcShObj R A) := by
        obtain ⟨E, _, _, β, x, hE, hβ, -⟩ := hCOV 0
        obtain ⟨b, -⟩ := toAlg E β hβ
        obtain ⟨j, -, -⟩ := hOBJ E hE b
        exact ⟨j⟩
      have hobj' : ∀ j₁ j₂ : wcShObj R A, ∃ (k : wcShObj R A) (_ : j₁ ⟶ k) (_ : j₂ ⟶ k), True :=
        hobj
      have hmaps : ∀ ⦃j₁ j₂ : wcShObj R A⦄ (f g : j₁ ⟶ j₂), ∃ (k : wcShObj R A) (h : j₂ ⟶ k),
          f ≫ h = g ≫ h := by
        intro j₁ j₂ f g
        obtain ⟨k, u, hu⟩ := hEQ' j₂ j₁.n (fun i => f.1 (Ideal.Quotient.mk _ (MvPolynomial.X i)))
          (fun i => g.1 (Ideal.Quotient.mk _ (MvPolynomial.X i))) (fun i => by
            have h1 := AlgHom.congr_fun f.2 (Ideal.Quotient.mk _ (MvPolynomial.X i))
            have h2 := AlgHom.congr_fun g.2 (Ideal.Quotient.mk _ (MvPolynomial.X i))
            simp only [AlgHom.comp_apply] at h1 h2
            rw [h1, h2])
        refine ⟨k, u, Subtype.ext ?_⟩
        apply Ideal.Quotient.algHom_ext R
        apply MvPolynomial.algHom_ext
        intro i
        exact hu i
      exact { cocone_objs := hobj', cocone_maps := hmaps, nonempty := hne }
    refine ⟨wcShObj R A, inferInstance, hfilt, wcShD R A,
      fun j => algebraMap R (MvPolynomial (Fin j.n) R ⧸ j.I),
      fun j => CommRingCat.ofHom j.b.toRingHom, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro j
      show (algebraMap R (MvPolynomial (Fin j.n) R ⧸ j.I)).Etale
      exact RingHom.etale_algebraMap.mpr j.et
    · intro j j' t
      exact t.1.comp_algebraMap
    · intro j j' t
      ext z
      exact AlgHom.congr_fun t.2 z
    · intro j
      exact j.b.comp_algebraMap
    · intro a
      obtain ⟨E, _, _, β, x, hE, hβ, hx⟩ := hCOV a
      obtain ⟨b, hb⟩ := toAlg E β hβ
      obtain ⟨j, e, hj⟩ := hOBJ E hE b
      refine ⟨j, e.symm x, ?_⟩
      show j.b (e.symm x) = a
      rw [hj, AlgEquiv.apply_symm_apply, hb, hx]
    · intro j j' x y hxy
      change MvPolynomial (Fin j.n) R ⧸ j.I at x
      change MvPolynomial (Fin j'.n) R ⧸ j'.I at y
      change j.b x = j'.b y at hxy
      obtain ⟨k₀, t₀, t₀', -⟩ := hobj j j'
      obtain ⟨k, u, hu⟩ := hEQ' k₀ 1 (fun _ => t₀.1 x) (fun _ => t₀'.1 y) (fun _ => by
        have h1 := AlgHom.congr_fun t₀.2 x
        have h2 := AlgHom.congr_fun t₀'.2 y
        simp only [AlgHom.comp_apply] at h1 h2
        rw [h1, h2]
        exact hxy)
      refine ⟨k, t₀ ≫ u, t₀' ≫ u, ?_⟩
      exact hu 0

  have s4 : ∀ (A : Type u) [CommRing A] (J : Type u) [SmallCategory J] [IsFiltered J] (D : J ⥤ CommRingCat.{u}) (β : ∀ j, D.obj j ⟶ CommRingCat.of A), (∀ {j j' : J} (t : j ⟶ j'), D.map t ≫ β j' = β j) → (∀ a : A, ∃ (j : J) (x : D.obj j), (β j).hom x = a) → (∀ (j j' : J) (x : D.obj j) (y : D.obj j'), (β j).hom x = (β j').hom y → ∃ (k : J) (t : j ⟶ k) (t' : j' ⟶ k), (D.map t).hom x = (D.map t').hom y) → ∀ (T : Scheme.{u}) (z : ∀ j, T ⟶ Spec (D.obj j)), (∀ {j j' : J} (t : j ⟶ j'), z j' ≫ Spec.map (D.map t) = z j) → ∃! z₀ : T ⟶ Spec (CommRingCat.of A), ∀ j, z₀ ≫ Spec.map (β j) = z j := by
    intro A _ J _ _ D β hDβ hsurj hinj T z hz
    let c : Limits.Cocone D :=
      { pt := CommRingCat.of A
        ι := { app := β
               naturality := fun j j' t => by
                 simp only [Functor.const_obj_obj, Functor.const_obj_map, Category.comp_id]
                 exact hDβ t } }
    have h1 : Limits.IsColimit ((forget CommRingCat).mapCocone c) := by
      apply Limits.Types.FilteredColimit.isColimitOf
      · intro a
        obtain ⟨j, x, hx⟩ := hsurj a
        exact ⟨j, x, hx.symm⟩
      · intro i j x y hxy
        exact hinj i j x y hxy
    haveI : Limits.ReflectsColimit D (forget CommRingCat) :=
      Limits.reflectsColimit_of_reflectsIsomorphisms D (forget CommRingCat)
    have hc : Limits.IsColimit c := Limits.isColimitOfReflects (forget CommRingCat) h1
    have hl := Limits.isLimitOfPreserves Scheme.Spec hc.op
    let s : Limits.Cone (D.op ⋙ Scheme.Spec) :=
      { pt := T
        π := { app := fun j => z j.unop
               naturality := fun j j' t => by
                 simp only [Functor.const_obj_obj, Functor.const_obj_map, Category.id_comp]
                 exact (hz t.unop).symm } }
    obtain ⟨z₀, hz₀, huniq⟩ := hl.existsUnique s
    exact ⟨z₀, fun j => hz₀ (Opposite.op j), fun w hw => huniq w (fun j => hw j.unop)⟩

  obtain ⟨U, hU, hyU, -⟩ := exists_isAffineOpen_mem_and_subset (X := Y)
    (x := c (IsLocalRing.closedPoint A)) (U := ⊤) trivial
  have H : Set.range c ⊆ Set.range U.ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨p, rfl⟩
    have hsp : p ⤳ IsLocalRing.closedPoint A := IsLocalRing.specializes_closedPoint p
    exact (hsp.map c.continuous).mem_open U.isOpen hyU
  obtain ⟨c', hc', hWc'⟩ : ∃ c' : Spec (.of A) ⟶ (U : Scheme.{u}), c' ≫ U.ι = c ∧ WeaklyEtale c' :=
    ⟨IsOpenImmersion.lift U.ι c H, IsOpenImmersion.lift_fac _ _ _,
      MorphismProperty.of_isPullback (P := @WeaklyEtale)
        (IsOpenImmersion.isPullback_lift_id c U.ι H).flip hc⟩
  obtain ⟨ψ', hψ'⟩ : ∃ ψ' : Γ(Y, U) ⟶ CommRingCat.of A, Spec.map ψ' = c' ≫ hU.isoSpec.hom :=
    ⟨Spec.preimage _, Spec.map_preimage _⟩
  have hψ'' : Spec.map (CommRingCat.ofHom ψ'.hom) = c' ≫ hU.isoSpec.hom := hψ'
  have hψc : Spec.map (CommRingCat.ofHom ψ'.hom) ≫ hU.fromSpec = c := by
    rw [hψ'', ← hU.isoSpec_inv_ι, Category.assoc, Iso.hom_inv_id_assoc, hc']
  have hψW : @Algebra.WeaklyEtale Γ(Y, U) A _ _ ψ'.hom.toAlgebra := by
    apply wc_lpkt_specMap_weaklyEtale_ring
    rw [hψ'']
    haveI := hWc'
    infer_instance

  have hind : wcIndEtale ψ'.hom := by
    letI : Algebra Γ(Y, U) A := ψ'.hom.toAlgebra
    obtain ⟨A', _, σ, ρ, hA'loc, hρσ, hH, hS, hloc, hindσ⟩ :=
      wc_strict_hull Γ(Y, U) A inferInstance
    haveI := hA'loc
    letI : Algebra Γ(Y, U) A' := σ.toAlgebra
    letI : Algebra A' A := ρ.toAlgebra
    haveI : IsScalarTower Γ(Y, U) A' A := IsScalarTower.of_algebraMap_eq' hρσ.symm
    have hW1 : Algebra.WeaklyEtale Γ(Y, U) A' := wc_indEtale_weaklyEtale σ hindσ
    have hW2 : Algebra.WeaklyEtale A' A := wc_weaklyEtale_cancel Γ(Y, U) A' A hW1 hψW
    have hbij : Function.Bijective (algebraMap A' A) := wc_olivier A' A hH hS hloc hW2
    let ρ' : A' ≃+* A := RingEquiv.ofBijective ρ hbij
    unfold wcIndEtale
    intro P _ _ _ h
    let h' : P →ₐ[Γ(Y, U)] A' :=
      { toRingHom := ρ'.symm.toRingHom.comp h.toRingHom
        commutes' := fun r => by
          change ρ'.symm (h (algebraMap _ P r)) = σ r
          rw [AlgHom.commutes]
          apply ρ'.injective
          rw [RingEquiv.apply_symm_apply]
          exact RingHom.congr_fun hρσ.symm r }
    obtain ⟨E, _, _, hE, α, β₀, hαβ⟩ := hindσ P h'
    refine ⟨E, inferInstance, inferInstance, hE, α,
      (IsScalarTower.toAlgHom Γ(Y, U) A' A).comp β₀, ?_⟩
    apply AlgHom.ext
    intro p
    have e1 : β₀ (α p) = h' p := by rw [← AlgHom.comp_apply, hαβ]
    show ρ (β₀ (α p)) = h p
    rw [e1]
    exact ρ'.apply_symm_apply (h p)

  obtain ⟨J, _, _, D, s, β, hs, hsD, hDβ, hβs, hsurj, hinj⟩ :=
    s3 _ A ψ'.hom (s1 _ A ψ'.hom hind) (s2 _ A ψ'.hom hind)
  have hlim := s4 A J D β hDβ hsurj hinj

  let S : ∀ j, Γ(Y, U) ⟶ D.obj j := fun j => CommRingCat.ofHom (s j)
  have hSD : ∀ {j j' : J} (t : j ⟶ j'), S j ≫ D.map t = S j' := by
    intro j j' t
    ext x
    exact RingHom.congr_fun (hsD t) x
  have hSβ : ∀ j, S j ≫ β j = CommRingCat.ofHom ψ'.hom := by
    intro j
    ext x
    exact RingHom.congr_fun (hβs j) x
  have hSet : ∀ j, Etale (Spec.map (S j)) := fun j =>
    HasRingHomProperty.Spec_iff.mpr (hs j)
  haveI := hU.isOpenImmersion_fromSpec
  let Wobj : J → Y.Etale := fun j => MorphismProperty.Over.mk ⊤
    (Spec.map (S j) ≫ hU.fromSpec) (by haveI := hSet j; infer_instance)
  let W : Jᵒᵖ ⥤ Y.Etale :=
    { obj := fun l => Wobj l.unop
      map := fun {l l'} t => MorphismProperty.Over.homMk (Spec.map (D.map t.unop)) (by
          show Spec.map (D.map t.unop) ≫ Spec.map (S l'.unop) ≫ hU.fromSpec =
            Spec.map (S l.unop) ≫ hU.fromSpec
          rw [← Category.assoc, ← Spec.map_comp, hSD]) trivial
      map_id := fun l => by
        apply MorphismProperty.Over.Hom.ext
        show Spec.map (D.map (𝟙 l.unop)) = 𝟙 _
        rw [D.map_id, Spec.map_id]
      map_comp := fun {l l' l''} f g => by
        apply MorphismProperty.Over.Hom.ext
        show Spec.map (D.map (g.unop ≫ f.unop)) = Spec.map (D.map f.unop) ≫ Spec.map (D.map g.unop)
        rw [D.map_comp, Spec.map_comp] }
  let φ : ∀ l, Spec (.of A) ⟶ (W.obj l).left := fun l => Spec.map (β l.unop)
  refine ⟨Jᵒᵖ, inferInstance, isCofiltered_op_of_isFiltered J, W, φ, ?_, ?_, ?_, ?_⟩
  · intro l
    show IsAffine (Spec (D.obj l.unop))
    infer_instance
  · intro l l' t
    show Spec.map (β l.unop) ≫ Spec.map (D.map t.unop) = Spec.map (β l'.unop)
    rw [← Spec.map_comp, hDβ]
  · intro l
    show Spec.map (β l.unop) ≫ Spec.map (S l.unop) ≫ hU.fromSpec = c
    rw [← Category.assoc, ← Spec.map_comp, hSβ]
    exact hψc
  · intro T z hz
    obtain ⟨z₀, hz₀, hu⟩ := hlim T (fun j => z (Opposite.op j)) (fun {j j'} t => hz t.op)
    exact ⟨z₀, fun l => hz₀ l.unop, fun w hw => hu w (fun j => hw (Opposite.op j))⟩

theorem wc_et_limit_pull_surj_qcqs_all : ∀ {S Z : Scheme.{u}} (p : Z ⟶ S) (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (D : Λ ⥤ S.Etale) (π : ∀ l, Z ⟶ (D.obj l).left), (∀ l, π l ≫ (D.obj l).hom = p) → (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ (D.map t).left = π l') → (∀ (T : Scheme.{u}) (w : ∀ l, T ⟶ (D.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), w l ≫ (D.map t).left = w l') → ∃! w₀ : T ⟶ Z, ∀ l, w₀ ≫ π l = w l) → (∀ l, CompactSpace (D.obj l).left) → (∀ l, QuasiSeparatedSpace (D.obj l).left) → (∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom (D.map t).left) → CompactSpace Z → QuasiSeparatedSpace Z → ∀ (m : ℕ) (q : ℕ) (y : wcEtZModExt Z m q), ∃ (l : Λ) (x : wcEtZModExt (D.obj l).left m q), ∀ (E : wcEtPullData (π l) m), wcEtPull E q x = y :=
by
  intro S Z p Λ _ _ D π hπ hπc hlim hcpt hqs haff hZc hZq m q y
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) := HasExt.standard _
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) := HasExt.standard _
  haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) :=
    wc_et_enough_injectives S
  obtain ⟨L, ⟨adj⟩, hLlim, -⟩ := wc_et_push_left_adjoint p
  haveI := hLlim
  haveI : L.IsLeftAdjoint := ⟨_, ⟨adj⟩⟩
  haveI : L.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint L
  haveI : L.Additive := Functor.additive_of_preserves_binary_products L
  haveI : Limits.PreservesColimits L := adj.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits L := inferInstance
