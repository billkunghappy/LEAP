      simp only [wcIntFun, Equiv.apply_symm_apply]
      rfl
    have hg : ((SheafOfModules.unitHomEquiv _) (wcHMFun S ℓ r')).1 V =
        (r'.comp (Opposite.unop V).hom.base.hom : C(↥((Opposite.unop V).left), ULift.{u+1} ℚ_[ℓ])) := by
      simp only [wcHMFun, Equiv.apply_symm_apply]
      rfl
    have hU1 : ((SheafOfModules.unitHomEquiv _) (wcUnitRestrict (wcIntRatRingSheafMap S ℓ))).1 V =
        (1 : (wcRingSheaf S ℓ).obj.obj V) := by
      simp only [wcUnitRestrict, Equiv.apply_symm_apply]
      rfl
    have e2 : (((SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap S ℓ)).map
        (wcHMFun S ℓ r')).val.app V).hom
          (((SheafOfModules.unitHomEquiv _) (wcUnitRestrict (wcIntRatRingSheafMap S ℓ))).1 V) =
        ((SheafOfModules.unitHomEquiv _) (wcHMFun S ℓ r')).1 V := by
      rw [hU1, SheafOfModules.unitHomEquiv_apply_coe]
      rfl
    rw [SheafOfModules.unitHomEquiv_comp_apply, SheafOfModules.unitHomEquiv_comp_apply]
    show ((wcUnitRestrict (wcIntRatRingSheafMap S ℓ)).val.app V).hom
        (((SheafOfModules.unitHomEquiv _) (wcIntFun S ℓ r)).1 V) =
      (((SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap S ℓ)).map
        (wcHMFun S ℓ r')).val.app V).hom
          (((SheafOfModules.unitHomEquiv _) (wcUnitRestrict (wcIntRatRingSheafMap S ℓ))).1 V)
    rw [e2]
    refine (hu _).trans (Eq.trans ?_ hg.symm)
    refine (congrArg (fun x => ((wcIntRatRingSheafMap S ℓ).hom.app V).hom x) hf).trans ?_
    exact ContinuousMap.ext (fun p => ULift.ext _ _ (hr _).symm)

  have s5 : ∀ (r : C(↥S, ULift.{u+1} ℤ_[ℓ])) (r' : C(↥S, ULift.{u+1} ℚ_[ℓ])),
      (∀ t, (r' t).down = ((r t).down : ℚ_[ℓ])) →
      E.μ.inv ≫ E.L.map (wcIntFun S ℓ r) ≫ E.μ.hom = wcHMFun S ℓ r' := by
    intro r r' hr
    have h1 : E.L.map (wcIntFun S ℓ r) ≫ E.μ.hom = E.μ.hom ≫ wcHMFun S ℓ r' := by
      apply (E.adj.homEquiv _ _).injective
      rw [Adjunction.homEquiv_naturality_left, Adjunction.homEquiv_naturality_right, hE]
      exact s1 r r' hr
    rw [h1, Iso.inv_hom_id_assoc]

  have hB : ∀ (r : C(↥S, ULift.{u+1} ℤ_[ℓ])) (r' : C(↥S, ULift.{u+1} ℚ_[ℓ])),
      (∀ t, (r' t).down = ((r t).down : ℚ_[ℓ])) → ∀ z : wcIntExt S ℓ q,
      wcIntRho E q (wcIntAct S ℓ q r z) =
        (Abelian.Ext.mk₀ (wcHMFun S ℓ r')).comp (wcIntRho E q z) (zero_add q) := by
    intro r r' hr z
    show wcIntRho E q ((Abelian.Ext.mk₀ (wcIntFun S ℓ r)).comp z (zero_add q)) = _
    rw [s2, s5 r r' hr]

  have s3 : ∀ c : ℚ_[ℓ], wcHMFun S ℓ (ContinuousMap.const _ (ULift.up c)) = wcHMConst S ℓ c := by
    intro c
    apply (SheafOfModules.unitHomEquiv _).injective
    apply PresheafOfModules.sections_ext
    intro V
    simp only [wcHMFun, wcHMConst, Equiv.apply_symm_apply]
    exact ContinuousMap.ext (fun _ => rfl)

  have hcomm : ∀ (X : (S.ProEt)ᵒᵖ) (a b : (wcRingSheaf S ℓ).obj.obj X), a * b = b * a := by
    intro X a b
    exact @mul_comm C(↥(Opposite.unop X).left, ULift.{u+1} ℚ_[ℓ]) _ a b
  have hcen : ∀ (e : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶ SheafOfModules.unit (wcRingSheaf S ℓ))
      (y : wcHM S ℓ q),
      (Abelian.Ext.mk₀ e).comp y (zero_add q) = y.comp (Abelian.Ext.mk₀ e) (add_zero q) := by
    intro e y
    have hext : ∃ m : 𝟭 (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) ⟶
        𝟭 (SheafOfModules.{u+1} (wcRingSheaf S ℓ)),
        m.app (SheafOfModules.unit (wcRingSheaf S ℓ)) = e := by
      let R := wcRingSheaf S ℓ
      let s := (SheafOfModules.unit R).unitHomEquiv e
      let σ : ∀ X : (S.ProEt)ᵒᵖ, R.obj.obj X := fun X => (s.1 X : R.obj.obj X)
      have hσ : ∀ {X Y : (S.ProEt)ᵒᵖ} (f : X ⟶ Y), (R.obj.map f).hom (σ X) = σ Y :=
        fun f => PresheafOfModules.sections_property s f
      let L : ∀ (M : SheafOfModules.{u+1} R) (X : (S.ProEt)ᵒᵖ), M.val.obj X ⟶ M.val.obj X :=
        fun M X => ModuleCat.ofHom
          { toFun := fun x => σ X • x
            map_add' := fun x y => smul_add _ _ _
            map_smul' := fun r x => by
              simp only [RingHom.id_apply, smul_smul]
              rw [hcomm X] }
      let mM : ∀ M : SheafOfModules.{u+1} R, M ⟶ M := fun M =>
        ⟨PresheafOfModules.Hom.mk (L M) (by
          intro X Y f
          ext x
          show σ Y • (M.val.map f).hom x = (M.val.map f).hom (σ X • x)
          rw [PresheafOfModules.map_smul, hσ])⟩
      refine ⟨{ app := mM, naturality := ?_ }, ?_⟩
      · intro M N g
        apply SheafOfModules.hom_ext
        apply PresheafOfModules.hom_ext
        intro X
        ext x
        show σ X • (g.val.app X).hom x = (g.val.app X).hom (σ X • x)
        exact ((g.val.app X).hom.map_smul _ _).symm
      · apply (SheafOfModules.unit R).unitHomEquiv.injective
        apply PresheafOfModules.sections_ext
        intro X
        rw [SheafOfModules.unitHomEquiv_apply_coe]
        show σ X • (1 : R.obj.obj X) = s.1 X
        rw [smul_eq_mul, mul_one]
    obtain ⟨m, hm⟩ := hext
    subst hm
    have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp y m
    simp only [Abelian.Ext.id_mapExactFunctor] at h
    exact h.symm

  refine ⟨fun c y => ?_, hB⟩
  rw [hB (ContinuousMap.const _ (ULift.up c)) (ContinuousMap.const _ (ULift.up (c : ℚ_[ℓ])))
    (fun _ => rfl) y, s3, hcen]
  rfl

theorem wc_int_pull_data_exists {S S' : Scheme.{u}} (f : S' ⟶ S) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    ∃ D : wcIntPullData f ℓ, wcIntPullCanonical D :=
by
  classical

  obtain ⟨hcont, hflat⟩ := wc_proet_pullback_continuous_flat f
  have hcont' : (wcProEtBC f).IsContinuous (Scheme.ProEt.topology S)
      (Scheme.ProEt.topology S') := hcont
  have hflat' : RepresentablyFlat (wcProEtBC f) := hflat
  letI := hcont'
  haveI := hflat'

  have key : ∀ {V W : S.ProEt} (g : W ⟶ V),
      ((wcProEtBC f).map g).left ≫ Limits.pullback.fst V.hom f =
        Limits.pullback.fst W.hom f ≫ g.left := by
    intro V W g
    exact Limits.pullback.lift_fst _ _ _
  let φp : (wcIntRingSheaf S ℓ).obj ⟶ (wcProEtBC f).op ⋙ (wcIntRingSheaf S' ℓ).obj :=
    { app := fun V => RingCat.ofHom (ContinuousMap.compRightAlgHom ℤ (ULift.{u+1} ℤ_[ℓ])
          (Limits.pullback.fst V.unop.hom f).base.hom).toRingHom
      naturality := fun V W g => by
        ext s
        apply ContinuousMap.ext
        intro x
        have hx := congrArg (fun k => k.base x) (key g.unop)
        let s' : C(↥(Opposite.unop V).left, ULift.{u+1} ℤ_[ℓ]) := s
        first
          | exact congrArg s' hx.symm
          | exact congrArg s' hx
          | (simp only [Scheme.Hom.comp_base] at hx; exact congrArg s' hx.symm)
          | (simp only [Scheme.Hom.comp_base] at hx; exact congrArg s' hx) }
  let φ : wcIntRingSheaf S ℓ ⟶ ((wcProEtBC f).sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')).obj (wcIntRingSheaf S' ℓ) :=
    ObjectProperty.homMk φp

  haveI : (PresheafOfModules.pushforward.{u+1} φ.hom).IsRightAdjoint :=
    wc_presheafOfModules_pushforward_isRightAdjoint _ φ.hom
  let Φ : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ) ⥤ SheafOfModules.{u+1} (wcIntRingSheaf S' ℓ) :=
    SheafOfModules.pullback φ
  let adj : Φ ⊣ SheafOfModules.pushforward φ := SheafOfModules.pullbackPushforwardAdjunction φ

  haveI : Φ.IsLeftAdjoint := adj.isLeftAdjoint
  haveI : Φ.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint Φ
  haveI : Limits.PreservesColimitsOfSize.{0, 0} Φ := adj.leftAdjoint_preservesColimits
  haveI hcol : Limits.PreservesFiniteColimits Φ :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits Φ
  haveI : Limits.PreservesBinaryBiproducts Φ :=
    Limits.preservesBinaryBiproducts_of_preservesBinaryCoproducts Φ
  haveI hadd : Φ.Additive := Functor.additive_of_preservesBinaryBiproducts Φ

  obtain ⟨P, p, hp, π, huniv, hσ⟩ := wc_profinite_universal_weaklyEtale S ℤ_[ℓ]

  have hsurj : ∀ (V' : S'.ProEt) (r' : C(↥V'.left, ULift.{u+1} ℤ_[ℓ])),
      ∃ T ∈ Scheme.ProEt.topology S' V', ∀ ⦃W' : S'.ProEt⦄ (g : W' ⟶ V'), T.arrows g →
        ∃ (V : S.ProEt) (a : W' ⟶ (wcProEtBC f).obj V) (r : C(↥V.left, ULift.{u+1} ℤ_[ℓ])),
          r'.comp g.left.base.hom =
            (r.comp (Limits.pullback.fst V.hom f).base.hom).comp a.left.base.hom := by
    intro V' r'
    refine ⟨⊤, (Scheme.ProEt.topology S').top_mem V', fun W' g _ => ?_⟩
    let c : C(↥W'.left, ℤ_[ℓ]) :=
      ⟨fun z => (r' (g.left.base z)).down,
        continuous_uliftDown.comp (r'.comp g.left.base.hom).continuous⟩
    obtain ⟨h, hhp, hhc⟩ := huniv W'.left (W'.hom ≫ f) c
    haveI := hp
    let V : S.ProEt := Scheme.ProEt.mk p
    let aL : W'.left ⟶ Limits.pullback p f := Limits.pullback.lift h W'.hom hhp
    let a : W' ⟶ (wcProEtBC f).obj V :=
      MorphismProperty.Over.homMk aL (Limits.pullback.lift_snd _ _ _) trivial
    let rfun : C(↥P, ULift.{u+1} ℤ_[ℓ]) :=
      ⟨fun y => ULift.up (π y), continuous_uliftUp.comp π.continuous⟩
    refine ⟨V, a, rfun, ?_⟩
    apply ContinuousMap.ext
    intro z
    apply ULift.ext
    have h1 : (Limits.pullback.fst p f).base (aL.base z) = h.base z :=
      congrArg (fun k : W'.left ⟶ P => k.base z) (Limits.pullback.lift_fst h W'.hom hhp)
    have h2 : π (h.base z) = c z :=
      congrArg (fun ψ : C(_, ℤ_[ℓ]) => ψ z) hhc
    change (r' (g.left.base z)).down = π ((Limits.pullback.fst p f).base (aL.base z))
    rw [h1, h2]
    try rfl

  have hinj : ∀ (V' : S'.ProEt) (V : S.ProEt) (a : V' ⟶ (wcProEtBC f).obj V)
      (r : C(↥V.left, ULift.{u+1} ℤ_[ℓ])),
      (r.comp (Limits.pullback.fst V.hom f).base.hom).comp a.left.base.hom = 0 →
      ∃ T ∈ Scheme.ProEt.topology S' V', ∀ ⦃W' : S'.ProEt⦄ (g : W' ⟶ V'), T.arrows g →
        ∃ (W : S.ProEt) (b : W ⟶ V) (a' : W' ⟶ (wcProEtBC f).obj W),
          a' ≫ (wcProEtBC f).map b = g ≫ a ∧ r.comp b.left.base.hom = 0 := by
    intro V' V a r hr
    obtain ⟨σ, hσW, -, hσπ, hσfac⟩ := hσ 0
    refine ⟨⊤, (Scheme.ProEt.topology S').top_mem V', fun W' g _ => ?_⟩
    have ha : a.left ≫ Limits.pullback.snd V.hom f = V'.hom := Over.w a.toCommaMorphism
    have hg : g.left ≫ V'.hom = W'.hom := Over.w g.toCommaMorphism
    have hGb1 : ∀ {W : S.ProEt} (b : W ⟶ V), ((wcProEtBC f).map b).left ≫
        Limits.pullback.fst V.hom f = Limits.pullback.fst W.hom f ≫ b.left := fun b =>
      Limits.pullback.lift_fst _ _ _
    have hGb2 : ∀ {W : S.ProEt} (b : W ⟶ V), ((wcProEtBC f).map b).left ≫
        Limits.pullback.snd V.hom f = Limits.pullback.snd W.hom f := fun b =>
      Limits.pullback.lift_snd _ _ _
    let c : C(↥V.left, ℤ_[ℓ]) := ⟨fun y => (r y).down, continuous_uliftDown.comp r.continuous⟩
    obtain ⟨h, -, hhc⟩ := huniv V.left V.hom c
    haveI := hσW
    haveI := hp
    haveI : WeaklyEtale V.hom := V.prop
    let W : S.ProEt := Scheme.ProEt.mk (Limits.pullback.fst h σ ≫ V.hom)
    let b : W ⟶ V := MorphismProperty.Over.homMk (Limits.pullback.fst h σ) rfl trivial
    have hb0 : r.comp b.left.base.hom = 0 := by
      apply ContinuousMap.ext
      intro w
      apply ULift.ext
      have e1 : h.base ((Limits.pullback.fst h σ).base w) =
          σ.base ((Limits.pullback.snd h σ).base w) :=
        congrArg (fun k : Limits.pullback h σ ⟶ P => k.base w)
          (Limits.pullback.condition (f := h) (g := σ))
      have e2 : π (h.base ((Limits.pullback.fst h σ).base w)) =
          c ((Limits.pullback.fst h σ).base w) :=
        congrArg (fun ψ : C(_, ℤ_[ℓ]) => ψ ((Limits.pullback.fst h σ).base w)) hhc
      rw [e1, hσπ] at e2
      exact e2.symm
    let φ : W'.left ⟶ V.left := g.left ≫ a.left ≫ Limits.pullback.fst V.hom f
    have hπ : ∀ x, π ((φ ≫ h).base x) = 0 := by
      intro x
      have e1 : π (h.base (φ.base x)) = c (φ.base x) :=
        congrArg (fun ψ : C(_, ℤ_[ℓ]) => ψ (φ.base x)) hhc
      have e6 : (r ((Limits.pullback.fst V.hom f).base (a.left.base (g.left.base x)))).down = 0 :=
        congrArg (fun ψ : C(_, ULift.{u+1} ℤ_[ℓ]) => (ψ (g.left.base x)).down) hr
      show π (h.base (φ.base x)) = 0
      rw [e1]
      exact e6
    have hfac := hσfac W'.left (φ ≫ h) hπ
    let q : W'.left ⟶ Limits.pullback h σ := Limits.pullback.lift φ ((φ ≫ h) ≫ p) hfac
    have hq1 : q ≫ Limits.pullback.fst h σ = φ := Limits.pullback.lift_fst _ _ _
    have hcond : Limits.pullback.fst V.hom f ≫ V.hom = Limits.pullback.snd V.hom f ≫ f :=
      Limits.pullback.condition
    have hw : q ≫ (Limits.pullback.fst h σ ≫ V.hom) = W'.hom ≫ f :=
      calc q ≫ (Limits.pullback.fst h σ ≫ V.hom)
          = (q ≫ Limits.pullback.fst h σ) ≫ V.hom := (Category.assoc _ _ _).symm
        _ = φ ≫ V.hom := congrArg (fun k => k ≫ V.hom) hq1
        _ = g.left ≫ a.left ≫ (Limits.pullback.fst V.hom f ≫ V.hom) :=
          (Category.assoc _ _ _).trans (congrArg (fun k => g.left ≫ k) (Category.assoc _ _ _))
        _ = g.left ≫ a.left ≫ (Limits.pullback.snd V.hom f ≫ f) :=
          congrArg (fun k => g.left ≫ a.left ≫ k) hcond
        _ = g.left ≫ (a.left ≫ Limits.pullback.snd V.hom f) ≫ f :=
          congrArg (fun k => g.left ≫ k) (Category.assoc _ _ _).symm
        _ = g.left ≫ V'.hom ≫ f := congrArg (fun k => g.left ≫ k ≫ f) ha
        _ = (g.left ≫ V'.hom) ≫ f := (Category.assoc _ _ _).symm
        _ = W'.hom ≫ f := congrArg (fun k => k ≫ f) hg
    let aL' : W'.left ⟶ Limits.pullback (Limits.pullback.fst h σ ≫ V.hom) f :=
      Limits.pullback.lift q W'.hom hw
    let a' : W' ⟶ (wcProEtBC f).obj W :=
      MorphismProperty.Over.homMk aL' (Limits.pullback.lift_snd _ _ _) trivial
    refine ⟨W, b, a', ?_, hb0⟩
    apply MorphismProperty.Over.Hom.ext
    change aL' ≫ ((wcProEtBC f).map b).left = g.left ≫ a.left
    have e1 : aL' ≫ Limits.pullback.fst W.hom f = q := Limits.pullback.lift_fst _ _ _
    have e2 : aL' ≫ Limits.pullback.snd W.hom f = W'.hom := Limits.pullback.lift_snd _ _ _
    refine Limits.pullback.hom_ext ?_ ?_
    · exact calc (aL' ≫ ((wcProEtBC f).map b).left) ≫ Limits.pullback.fst V.hom f
          = aL' ≫ (((wcProEtBC f).map b).left ≫ Limits.pullback.fst V.hom f) :=
            Category.assoc _ _ _
        _ = aL' ≫ (Limits.pullback.fst W.hom f ≫ b.left) := congrArg (fun k => aL' ≫ k) (hGb1 b)
        _ = (aL' ≫ Limits.pullback.fst W.hom f) ≫ b.left := (Category.assoc _ _ _).symm
        _ = q ≫ b.left := congrArg (fun k => k ≫ b.left) e1
        _ = q ≫ Limits.pullback.fst h σ := rfl
        _ = g.left ≫ a.left ≫ Limits.pullback.fst V.hom f := hq1
        _ = (g.left ≫ a.left) ≫ Limits.pullback.fst V.hom f := (Category.assoc _ _ _).symm
    · exact calc (aL' ≫ ((wcProEtBC f).map b).left) ≫ Limits.pullback.snd V.hom f
          = aL' ≫ (((wcProEtBC f).map b).left ≫ Limits.pullback.snd V.hom f) :=
            Category.assoc _ _ _
        _ = aL' ≫ Limits.pullback.snd W.hom f := congrArg (fun k => aL' ≫ k) (hGb2 b)
        _ = W'.hom := e2
        _ = g.left ≫ V'.hom := hg.symm
        _ = g.left ≫ (a.left ≫ Limits.pullback.snd V.hom f) :=
          congrArg (fun k => g.left ≫ k) ha.symm
        _ = (g.left ≫ a.left) ≫ Limits.pullback.snd V.hom f := (Category.assoc _ _ _).symm

  obtain ⟨ι⟩ := wc_sheafOfModules_pullback_toSheaf_iso (Scheme.ProEt.topology S)
    (Scheme.ProEt.topology S') (wcProEtBC f) (wcIntRingSheaf S ℓ) (wcIntRingSheaf S' ℓ) φ
    hsurj hinj Φ adj
  haveI := wc_sheafPullback_preservesFiniteLimits_of_flat (Scheme.ProEt.topology S)
    (Scheme.ProEt.topology S') (wcProEtBC f)
  haveI : Limits.PreservesFiniteLimits (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ) ⋙
      (wcProEtBC f).sheafPullback AddCommGrpCat.{u+1} (Scheme.ProEt.topology S)
        (Scheme.ProEt.topology S')) :=
    Limits.comp_preservesFiniteLimits _ _
  haveI : Limits.PreservesFiniteLimits (Φ ⋙ SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S' ℓ)) :=
    Limits.preservesFiniteLimits_of_natIso ι.symm
  haveI hlim : Limits.PreservesFiniteLimits Φ :=
    Limits.preservesFiniteLimits_of_reflects_of_preserves Φ
      (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S' ℓ))

  haveI : (wcProEtBC f).Final := final_of_representablyFlat _
  let μ : Φ.obj (SheafOfModules.unit (wcIntRingSheaf S ℓ)) ≅
      SheafOfModules.unit (wcIntRingSheaf S' ℓ) :=
    Φ.mapIso (Limits.coproductUniqueIso
        (fun _ : PUnit.{u+2} => SheafOfModules.unit (wcIntRingSheaf S ℓ))).symm ≪≫
      SheafOfModules.pullbackObjFreeIso φ PUnit.{u+2} ≪≫
      Limits.coproductUniqueIso (fun _ : PUnit.{u+2} => SheafOfModules.unit (wcIntRingSheaf S' ℓ))

  exact ⟨⟨hcont', φ, Φ, adj, hadd, hlim, hcol, μ⟩, fun V s => rfl⟩

theorem wc_int_rat_pull_compat {Y T : Scheme.{u}} (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (p : T ⟶ Y)
    (D : wcHMPullData p ℓ) (hD : wcHMPullCanonical D) (DΛ : wcIntPullData p ℓ)
    (hDΛ : wcIntPullCanonical DΛ) (EY : wcIntRatData Y ℓ)
    (hEY : EY.adj.homEquiv _ _ EY.μ.hom = wcUnitRestrict (wcIntRatRingSheafMap Y ℓ))
    (ET : wcIntRatData T ℓ)
    (hET : ET.adj.homEquiv _ _ ET.μ.hom = wcUnitRestrict (wcIntRatRingSheafMap T ℓ))
    (q : ℕ) (y : wcIntExt Y ℓ q) :
    wcIntRho ET q (wcIntPull DΛ q y) = wcHMPull D q (wcIntRho EY q y) :=
by
  classical
  haveI hc : (wcProEtBC p).IsContinuous (Scheme.ProEt.topology Y) (Scheme.ProEt.topology T) :=
    DΛ.cont

  have hsq : wcIntRatRingSheafMap Y ℓ ≫ D.φ =
      DΛ.φ ≫ ((wcProEtBC p).sheafPushforwardContinuous RingCat.{u+1}
        (Scheme.ProEt.topology Y) (Scheme.ProEt.topology T)).map (wcIntRatRingSheafMap T ℓ) := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext V
    induction V using Opposite.rec with
    | op V =>
    apply RingCat.hom_ext
    apply RingHom.ext
    intro s
    have e1 : (D.φ.hom.app (Opposite.op V)).hom
        (((wcIntRatRingSheafMap Y ℓ).hom.app (Opposite.op V)).hom s) =
        ((((wcIntRatRingSheafMap Y ℓ).hom.app (Opposite.op V)).hom s :
          C(↥V.left, ULift.{u+1} ℚ_[ℓ])).comp (Limits.pullback.fst V.hom p).base.hom) :=
      hD V _
    have e2 : (DΛ.φ.hom.app (Opposite.op V)).hom s =
        ((s : C(↥V.left, ULift.{u+1} ℤ_[ℓ])).comp (Limits.pullback.fst V.hom p).base.hom) :=
      hDΛ V s
    change (D.φ.hom.app (Opposite.op V)).hom
        (((wcIntRatRingSheafMap Y ℓ).hom.app (Opposite.op V)).hom s) =
      ((wcIntRatRingSheafMap T ℓ).hom.app (Opposite.op ((wcProEtBC p).obj V))).hom
        ((DΛ.φ.hom.app (Opposite.op V)).hom s)
    rw [e2]
    refine e1.trans ?_
    apply ContinuousMap.ext
    intro z
    rfl
  have hring : ∀ U : (Y.ProEt)ᵒᵖ,
      (D.φ.hom.app U).hom.comp ((wcIntRatRingSheafMap Y ℓ).hom.app U).hom =
        ((((wcProEtBC p).sheafPushforwardContinuous RingCat.{u+1}
          (Scheme.ProEt.topology Y) (Scheme.ProEt.topology T)).map
            (wcIntRatRingSheafMap T ℓ)).hom.app U).hom.comp (DΛ.φ.hom.app U).hom := by
    intro U
    have h := congrArg (fun f : wcIntRingSheaf Y ℓ ⟶
      ((wcProEtBC p).sheafPushforwardContinuous RingCat.{u+1}
        (Scheme.ProEt.topology Y) (Scheme.ProEt.topology T)).obj (wcRingSheaf T ℓ) =>
          (f.hom.app U).hom) hsq
    exact h

  let ι : SheafOfModules.pushforward.{u+1} D.φ ⋙
        SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap Y ℓ) ≅
      SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap T ℓ) ⋙
        SheafOfModules.pushforward.{u+1} DΛ.φ :=
    NatIso.ofComponents (fun M => (SheafOfModules.fullyFaithfulForget _).preimageIso
      (PresheafOfModules.isoMk (fun U =>
        (ModuleCat.restrictScalarsComp'App ((wcIntRatRingSheafMap Y ℓ).hom.app U).hom
          (D.φ.hom.app U).hom
          ((D.φ.hom.app U).hom.comp ((wcIntRatRingSheafMap Y ℓ).hom.app U).hom) rfl
          (M.val.obj (Opposite.op ((wcProEtBC p).obj U.unop)))).symm ≪≫
        ModuleCat.restrictScalarsComp'App (DΛ.φ.hom.app U).hom
          ((((wcProEtBC p).sheafPushforwardContinuous RingCat.{u+1}
            (Scheme.ProEt.topology Y) (Scheme.ProEt.topology T)).map
              (wcIntRatRingSheafMap T ℓ)).hom.app U).hom
          ((D.φ.hom.app U).hom.comp ((wcIntRatRingSheafMap Y ℓ).hom.app U).hom) (hring U)
          (M.val.obj (Opposite.op ((wcProEtBC p).obj U.unop))))
        (by intro U V f; ext x; rfl)))
      (by
        intro M M' g
        apply SheafOfModules.hom_ext
        apply PresheafOfModules.hom_ext
        intro U
        ext x
        rfl)

  have ν : DΛ.Φ ⋙ ET.L ≅ EY.L ⋙ D.Φ :=
    (DΛ.adj.comp ET.adj).leftAdjointUniq ((EY.adj.comp D.adj).ofNatIsoRight ι)

  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf T ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf T ℓ)) := HasExt.standard _
  haveI := D.additive
  haveI := D.presLim
  haveI := D.presColim
  haveI := DΛ.additive
  haveI := DΛ.presLim
  haveI := DΛ.presColim
  haveI := EY.additive
  haveI := EY.presLim
  haveI := EY.presColim
  haveI := ET.additive
  haveI := ET.presLim
  haveI := ET.presColim
  have h2 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf T ℓ)} {a : ℕ}
      (f : A ⟶ B) (g : B ⟶ C') (z : Abelian.Ext C' D' a),
      (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ g).comp z (zero_add a)) (zero_add a) =
        (Abelian.Ext.mk₀ (f ≫ g)).comp z (zero_add a) := by
    intro A B C' D' a f g z
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
  have h3 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf T ℓ)} {a : ℕ}
      (z : Abelian.Ext A B a) (f : B ⟶ C') (g : C' ⟶ D'),
      (z.comp (Abelian.Ext.mk₀ f) (add_zero a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        z.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero a) := by
    intro A B C' D' a z f g
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  have h4 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf T ℓ)} {a : ℕ}
      (f : A ⟶ B) (z : Abelian.Ext B C' a) (g : C' ⟶ D'),
      ((Abelian.Ext.mk₀ f).comp z (zero_add a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        (Abelian.Ext.mk₀ f).comp (z.comp (Abelian.Ext.mk₀ g) (add_zero a)) (zero_add a) := by
    intro A B C' D' a f z g
    exact Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _

  have central : ∀ (e : SheafOfModules.unit (wcRingSheaf T ℓ) ⟶
      SheafOfModules.unit (wcRingSheaf T ℓ)) (w : wcHM T ℓ q),
      (Abelian.Ext.mk₀ e).comp w (zero_add q) = w.comp (Abelian.Ext.mk₀ e) (add_zero q) := by
    intro e w
    have hcomm : ∀ (X : (T.ProEt)ᵒᵖ) (a b : (wcRingSheaf T ℓ).obj.obj X), a * b = b * a := by
      intro X a b
      exact @mul_comm C(↥(Opposite.unop X).left, ULift.{u+1} ℚ_[ℓ]) _ a b
    have hext : ∃ m : 𝟭 (SheafOfModules.{u+1} (wcRingSheaf T ℓ)) ⟶
        𝟭 (SheafOfModules.{u+1} (wcRingSheaf T ℓ)),
        m.app (SheafOfModules.unit (wcRingSheaf T ℓ)) = e := by
      let R := wcRingSheaf T ℓ
      let s := (SheafOfModules.unit R).unitHomEquiv e
      let σ : ∀ X : (T.ProEt)ᵒᵖ, R.obj.obj X := fun X => (s.1 X : R.obj.obj X)
      have hσ : ∀ {X Y : (T.ProEt)ᵒᵖ} (f : X ⟶ Y), (R.obj.map f).hom (σ X) = σ Y :=
        fun f => PresheafOfModules.sections_property s f
      let L : ∀ (M : SheafOfModules.{u+1} R) (X : (T.ProEt)ᵒᵖ), M.val.obj X ⟶ M.val.obj X :=
        fun M X => ModuleCat.ofHom
          { toFun := fun x => σ X • x
            map_add' := fun x y => smul_add _ _ _
            map_smul' := fun r x => by
              simp only [RingHom.id_apply, smul_smul]
              rw [hcomm X] }
      let mM : ∀ M : SheafOfModules.{u+1} R, M ⟶ M := fun M =>
        ⟨PresheafOfModules.Hom.mk (L M) (by
          intro X Y f
          ext x
          show σ Y • (M.val.map f).hom x = (M.val.map f).hom (σ X • x)
          rw [PresheafOfModules.map_smul, hσ])⟩
      refine ⟨{ app := mM, naturality := ?_ }, ?_⟩
      · intro M N g
        apply SheafOfModules.hom_ext
        apply PresheafOfModules.hom_ext
        intro X
        ext x
        show σ X • (g.val.app X).hom x = (g.val.app X).hom (σ X • x)
        exact ((g.val.app X).hom.map_smul _ _).symm
      · apply (SheafOfModules.unit R).unitHomEquiv.injective
        apply PresheafOfModules.sections_ext
        intro X
        rw [SheafOfModules.unitHomEquiv_apply_coe]
        show σ X • (1 : R.obj.obj X) = s.1 X
        rw [smul_eq_mul, mul_one]
    have hcen : ∀ (m : 𝟭 (SheafOfModules.{u+1} (wcRingSheaf T ℓ)) ⟶
        𝟭 (SheafOfModules.{u+1} (wcRingSheaf T ℓ))) (z : wcHM T ℓ q),
        (Abelian.Ext.mk₀ (m.app (SheafOfModules.unit (wcRingSheaf T ℓ)))).comp z (zero_add q) =
          z.comp (Abelian.Ext.mk₀ (m.app (SheafOfModules.unit (wcRingSheaf T ℓ)))) (add_zero q) := by
      intro m z
      have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp z m
      simp only [Abelian.Ext.id_mapExactFunctor] at h
      exact h.symm
    obtain ⟨m, hm⟩ := hext
    subst hm
    exact hcen m w
  have gen : ∀ {Z : SheafOfModules.{u+1} (wcRingSheaf T ℓ)} (z : Abelian.Ext Z Z q)
      (a a' : SheafOfModules.unit (wcRingSheaf T ℓ) ⟶ Z)
      (b b' : Z ⟶ SheafOfModules.unit (wcRingSheaf T ℓ)),
      a ≫ b = 𝟙 _ → b' ≫ a' = 𝟙 _ →
      (Abelian.Ext.mk₀ a).comp (z.comp (Abelian.Ext.mk₀ b) (add_zero q)) (zero_add q) =
        (Abelian.Ext.mk₀ a').comp (z.comp (Abelian.Ext.mk₀ b') (add_zero q)) (zero_add q) := by
    intro Z z a a' b b' hab hba
    have ea : (a ≫ b') ≫ a' = a := by rw [Category.assoc, hba, Category.comp_id]
    have eb : b' ≫ a' ≫ b = b := by rw [← Category.assoc, hba, Category.id_comp]
    have eE : (a ≫ b') ≫ (a' ≫ b) = 𝟙 _ := by rw [← Category.assoc, ea, hab]
    have hc' : (Abelian.Ext.mk₀ (a ≫ b')).comp ((Abelian.Ext.mk₀ a').comp
          (z.comp (Abelian.Ext.mk₀ b') (add_zero q)) (zero_add q)) (zero_add q) =
        ((Abelian.Ext.mk₀ a').comp (z.comp (Abelian.Ext.mk₀ b') (add_zero q)) (zero_add q)).comp
          (Abelian.Ext.mk₀ (a ≫ b')) (add_zero q) :=
      central _ _
    have e1 : (Abelian.Ext.mk₀ a).comp (z.comp (Abelian.Ext.mk₀ b) (add_zero q)) (zero_add q) =
        ((Abelian.Ext.mk₀ (a ≫ b')).comp ((Abelian.Ext.mk₀ a').comp
          (z.comp (Abelian.Ext.mk₀ b') (add_zero q)) (zero_add q)) (zero_add q)).comp
          (Abelian.Ext.mk₀ (a' ≫ b)) (add_zero q) := by
      rw [h2, h4, h3, ea, eb]
    rw [e1, hc', h3, eE, Abelian.Ext.comp_mk₀_id]
  show (Abelian.Ext.mk₀ ET.μ.inv).comp ((Abelian.Ext.mapExactFunctor ET.L
      ((Abelian.Ext.mk₀ DΛ.μ.inv).comp ((Abelian.Ext.mapExactFunctor DΛ.Φ y).comp
        (Abelian.Ext.mk₀ DΛ.μ.hom) (add_zero q)) (zero_add q))).comp
      (Abelian.Ext.mk₀ ET.μ.hom) (add_zero q)) (zero_add q) =
    (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ
      ((Abelian.Ext.mk₀ EY.μ.inv).comp ((Abelian.Ext.mapExactFunctor EY.L y).comp
        (Abelian.Ext.mk₀ EY.μ.hom) (add_zero q)) (zero_add q))).comp
      (Abelian.Ext.mk₀ D.μ.hom) (add_zero q)) (zero_add q)
  have hL : (Abelian.Ext.mk₀ ET.μ.inv).comp ((Abelian.Ext.mapExactFunctor ET.L
      ((Abelian.Ext.mk₀ DΛ.μ.inv).comp ((Abelian.Ext.mapExactFunctor DΛ.Φ y).comp
        (Abelian.Ext.mk₀ DΛ.μ.hom) (add_zero q)) (zero_add q))).comp
      (Abelian.Ext.mk₀ ET.μ.hom) (add_zero q)) (zero_add q) =
      (Abelian.Ext.mk₀ (ET.μ.inv ≫ ET.L.map DΛ.μ.inv)).comp
        ((Abelian.Ext.mapExactFunctor (DΛ.Φ ⋙ ET.L) y).comp
          (Abelian.Ext.mk₀ (ET.L.map DΛ.μ.hom ≫ ET.μ.hom)) (add_zero q)) (zero_add q) := by
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_mapExactFunctor, h4, h3, h2]
  have hR : (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ
      ((Abelian.Ext.mk₀ EY.μ.inv).comp ((Abelian.Ext.mapExactFunctor EY.L y).comp
        (Abelian.Ext.mk₀ EY.μ.hom) (add_zero q)) (zero_add q))).comp
      (Abelian.Ext.mk₀ D.μ.hom) (add_zero q)) (zero_add q) =
      (Abelian.Ext.mk₀ (D.μ.inv ≫ D.Φ.map EY.μ.inv)).comp
        ((Abelian.Ext.mapExactFunctor (EY.L ⋙ D.Φ) y).comp
          (Abelian.Ext.mk₀ (D.Φ.map EY.μ.hom ≫ D.μ.hom)) (add_zero q)) (zero_add q) := by
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_mapExactFunctor, h4, h3, h2]
  have nat' : (Abelian.Ext.mapExactFunctor (DΛ.Φ ⋙ ET.L) y).comp
      (Abelian.Ext.mk₀ (ν.hom.app (SheafOfModules.unit (wcIntRingSheaf Y ℓ)))) (add_zero q) =
      (Abelian.Ext.mk₀ (ν.hom.app (SheafOfModules.unit (wcIntRingSheaf Y ℓ)))).comp
        (Abelian.Ext.mapExactFunctor (EY.L ⋙ D.Φ) y) (zero_add q) :=
    Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp y ν.hom
  have step1 : (Abelian.Ext.mapExactFunctor (DΛ.Φ ⋙ ET.L) y).comp
      (Abelian.Ext.mk₀ (ET.L.map DΛ.μ.hom ≫ ET.μ.hom)) (add_zero q) =
      ((Abelian.Ext.mk₀ (ν.hom.app (SheafOfModules.unit (wcIntRingSheaf Y ℓ)))).comp
        (Abelian.Ext.mapExactFunctor (EY.L ⋙ D.Φ) y) (zero_add q)).comp
        (Abelian.Ext.mk₀ (ν.inv.app (SheafOfModules.unit (wcIntRingSheaf Y ℓ)) ≫
          ET.L.map DΛ.μ.hom ≫ ET.μ.hom)) (add_zero q) := by
    rw [← nat', h3, Iso.hom_inv_id_app_assoc]
  have hL' : (Abelian.Ext.mk₀ (ET.μ.inv ≫ ET.L.map DΛ.μ.inv)).comp
        ((Abelian.Ext.mapExactFunctor (DΛ.Φ ⋙ ET.L) y).comp
          (Abelian.Ext.mk₀ (ET.L.map DΛ.μ.hom ≫ ET.μ.hom)) (add_zero q)) (zero_add q) =
      (Abelian.Ext.mk₀ ((ET.μ.inv ≫ ET.L.map DΛ.μ.inv) ≫
          ν.hom.app (SheafOfModules.unit (wcIntRingSheaf Y ℓ)))).comp
        ((Abelian.Ext.mapExactFunctor (EY.L ⋙ D.Φ) y).comp
          (Abelian.Ext.mk₀ (ν.inv.app (SheafOfModules.unit (wcIntRingSheaf Y ℓ)) ≫
            ET.L.map DΛ.μ.hom ≫ ET.μ.hom)) (add_zero q)) (zero_add q) := by
    rw [step1, h4, h2]
  rw [hL, hL', hR]
  have hab : ((ET.μ.inv ≫ ET.L.map DΛ.μ.inv) ≫
      ν.hom.app (SheafOfModules.unit (wcIntRingSheaf Y ℓ))) ≫
      (ν.inv.app (SheafOfModules.unit (wcIntRingSheaf Y ℓ)) ≫ ET.L.map DΛ.μ.hom ≫ ET.μ.hom) =
        𝟙 _ := by
    rw [Category.assoc, Iso.hom_inv_id_app_assoc, Category.assoc,
      ← CategoryTheory.Functor.map_comp_assoc, Iso.inv_hom_id, CategoryTheory.Functor.map_id,
      Category.id_comp, Iso.inv_hom_id]
  have hba : (D.Φ.map EY.μ.hom ≫ D.μ.hom) ≫ (D.μ.inv ≫ D.Φ.map EY.μ.inv) =
      𝟙 (D.Φ.obj (EY.L.obj (SheafOfModules.unit (wcIntRingSheaf Y ℓ)))) := by
    rw [Category.assoc, Iso.hom_inv_id_assoc, ← CategoryTheory.Functor.map_comp, Iso.hom_inv_id,
      CategoryTheory.Functor.map_id]
  exact gen _ _ _ _ _ hab hba

theorem wc_int_red_transfer (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    (∀ k j : ℕ, Function.Bijective (wcIntRedTr S ℓ k j)) ∧
    ∀ k : ℕ, ∃ t : wcIntResUnit S ℓ (k + 1) ⟶ wcIntResUnit S ℓ k,
      wcUnitRestrict (wcIntZModRingSheafMap S ℓ (k + 1)) ≫ t =
        wcUnitRestrict (wcIntZModRingSheafMap S ℓ k) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
  have hℓpos : (0 : ℝ) < (ℓ : ℝ) := by exact_mod_cast (Fact.out : Nat.Prime ℓ).pos



  have hring : ∀ m : ℕ,
      (∀ (V : (S.ProEt)ᵒᵖ) (r' : (wcZModRingSheaf S (ℓ ^ m)).obj.obj V),
        ∃ r : (wcIntRingSheaf S ℓ).obj.obj V, ((wcIntZModRingSheafMap S ℓ m).hom.app V).hom r = r') ∧
      (∀ (V : (S.ProEt)ᵒᵖ) (r : (wcIntRingSheaf S ℓ).obj.obj V),
        ((wcIntZModRingSheafMap S ℓ m).hom.app V).hom r = 0 →
          ∃ s : (wcIntRingSheaf S ℓ).obj.obj V, r = (ℓ ^ m : ℕ) • s) ∧
      (∀ V : (S.ProEt)ᵒᵖ, ((ℓ ^ m : ℕ) : (wcZModRingSheaf S (ℓ ^ m)).obj.obj V) = 0) := by
    intro m
    have hdiv : ∀ (T : Type u) [TopologicalSpace T] (g : C(T, ℤ_[ℓ])),
        (∀ t, PadicInt.toZModPow m (g t) = 0) →
        ∃ c : C(T, ℤ_[ℓ]), ∀ t, g t = (ℓ : ℤ_[ℓ]) ^ m * c t := by
      intro T _ g hg
      have hb : ∀ t, ‖((g t : ℚ_[ℓ])) / (ℓ : ℚ_[ℓ]) ^ m‖ ≤ 1 := by
        intro t
        have h1 : g t ∈ Ideal.span {(ℓ : ℤ_[ℓ]) ^ m} := by
          rw [← PadicInt.ker_toZModPow, RingHom.mem_ker]; exact hg t
        have h2 := (PadicInt.norm_le_pow_iff_mem_span_pow _ _).mpr h1
        rw [PadicInt.norm_def] at h2
        rw [norm_div, Padic.norm_p_pow]
        exact (div_le_one (zpow_pos hℓpos _)).mpr h2
      refine ⟨⟨fun t => (⟨(g t : ℚ_[ℓ]) / (ℓ : ℚ_[ℓ]) ^ m, hb t⟩ : ℤ_[ℓ]),
        Continuous.subtype_mk ((continuous_subtype_val.comp g.continuous).div_const _) hb⟩, ?_⟩
      intro t
      apply PadicInt.ext
      rw [PadicInt.coe_mul, PadicInt.coe_pow, PadicInt.coe_natCast]
      change (g t : ℚ_[ℓ]) = (ℓ : ℚ_[ℓ]) ^ m * ((g t : ℚ_[ℓ]) / (ℓ : ℚ_[ℓ]) ^ m)
      have hl : ((ℓ : ℚ_[ℓ]) ^ m) ≠ 0 :=
        pow_ne_zero _ (Nat.cast_ne_zero.mpr (Fact.out : Nat.Prime ℓ).ne_zero)
      rw [mul_div_assoc']
      exact (mul_div_cancel_left₀ _ hl).symm
    refine ⟨?_, ?_, ?_⟩
    · intro V r'
      let f' : C(↥(Opposite.unop V).left, ULift.{u+1} (ZMod (ℓ ^ m))) := r'
      let f : C(↥(Opposite.unop V).left, ULift.{u+1} ℤ_[ℓ]) :=
        ⟨fun t => ULift.up (((f' t).down.val : ℕ) : ℤ_[ℓ]),
          (continuous_of_discreteTopology (f := fun b : ULift.{u+1} (ZMod (ℓ ^ m)) =>
            (ULift.up (((b.down).val : ℕ) : ℤ_[ℓ]) : ULift.{u+1} ℤ_[ℓ]))).comp f'.continuous⟩
      refine ⟨f, ?_⟩
      change (_ : C(↥(Opposite.unop V).left, ULift.{u+1} (ZMod (ℓ ^ m)))) = f'
      apply ContinuousMap.ext
      intro t
      apply ULift.ext
      change PadicInt.toZModPow m (((f' t).down.val : ℕ) : ℤ_[ℓ]) = (f' t).down
      rw [map_natCast, ZMod.natCast_zmod_val]
    · intro V r hr
      let f : C(↥(Opposite.unop V).left, ULift.{u+1} ℤ_[ℓ]) := r
      have hx : ∀ t, PadicInt.toZModPow m (f t).down = 0 := by
        intro t
        have := congrArg
          (fun z : C(↥(Opposite.unop V).left, ULift.{u+1} (ZMod (ℓ ^ m))) => (z t).down) hr
        exact this
      obtain ⟨c, hc⟩ := hdiv _ ⟨fun t => (f t).down, continuous_uliftDown.comp f.continuous⟩ hx
      let s : C(↥(Opposite.unop V).left, ULift.{u+1} ℤ_[ℓ]) :=
        ⟨fun t => ULift.up (c t), continuous_uliftUp.comp c.continuous⟩
      refine ⟨s, ?_⟩
      change f = (ℓ ^ m) • s
      apply ContinuousMap.ext
      intro t
      apply ULift.ext
      change (f t).down = (ℓ ^ m) • c t
      rw [nsmul_eq_mul, Nat.cast_pow]
      exact hc t
    · intro V
      change ((ℓ ^ m : ℕ) : C(↥(Opposite.unop V).left, ULift.{u+1} (ZMod (ℓ ^ m)))) = 0
      apply ContinuousMap.ext
      intro t
      apply ULift.ext
      change ((ℓ ^ m : ℕ) : ZMod (ℓ ^ m)) = 0
      exact ZMod.natCast_self _



  have hvan : ∀ (k : ℕ) (I : SheafOfModules.{u+1} (wcZModRingSheaf S (ℓ ^ k))) [Injective I] (n : ℕ)
      (e : Abelian.Ext (SheafOfModules.unit (wcIntRingSheaf S ℓ))
        ((SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap S ℓ k)).obj I) (n + 1)),
      e = 0 := by
    intro k I _ n e
    have hN : 0 < ℓ ^ k := pow_pos (Fact.out : Nat.Prime ℓ).pos k
    obtain ⟨α, h1, h2, h3⟩ := wc_proet_zmod_ring_locbij S (ℓ ^ k) hN
    obtain ⟨hF, hE⟩ := sheafOfModules_toSheaf_torsion_equiv (Scheme.ProEt.topology S)
      (wcZModRingSheaf S (ℓ ^ k)) (ℓ ^ k) α h1 h2
    haveI := hF
    haveI : EssentiallySmall.{u+1} S.ProEt := inferInstance
    haveI : IsGrothendieckAbelian.{u+1} (Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) :=
      Sheaf.isGrothendieckAbelian_of_essentiallySmall _ _
    haveI : EnoughInjectives (Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) :=
      IsGrothendieckAbelian.enoughInjectives
    obtain ⟨E0⟩ := wc_int_unit_ext_free_equiv S ℓ
