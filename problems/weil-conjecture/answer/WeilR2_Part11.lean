    haveI := wc_supp_unit_epi_of_noetherian i₀' ℓ D' hD'
    exact ⟨Abelian.epiDesc _ _
      (wc_supp_kernel_kill_of_noetherian i₀ g i₀' g₀ hsq ℓ D hD D' hD' Dg hDg),
      Abelian.comp_epiDesc _ _ _⟩

  have sq : ∀ (v : ULift.{u} (Fin 1) → Γ(N, ⊤)) (s : N ⟶ W),
      s ≫ jW = AffineSpace.homOfVector (𝟙 N) v →
      ∃ τ : T ⟶ AffineSpace (ULift.{u} (Fin 1)) T, IsPullback y τ s yW := by
    intro v s hs
    have hσ : AffineSpace.homOfVector (𝟙 N) v ≫ (AffineSpace (ULift.{u} (Fin 1)) N ↘ N) = 𝟙 N :=
      AffineSpace.homOfVector_over _ _
    have w : (y ≫ AffineSpace.homOfVector (𝟙 N) v) ≫ (AffineSpace (ULift.{u} (Fin 1)) N ↘ N) =
        𝟙 T ≫ y := by
      rw [Category.assoc, hσ, Category.comp_id, Category.id_comp]
    obtain ⟨τ, h1, h2⟩ : ∃ τ : T ⟶ AffineSpace (ULift.{u} (Fin 1)) T,
        τ ≫ AffineSpace.map (ULift.{u} (Fin 1)) y = y ≫ AffineSpace.homOfVector (𝟙 N) v ∧
        τ ≫ (AffineSpace (ULift.{u} (Fin 1)) T ↘ T) = 𝟙 T :=
      ⟨hP.lift _ _ w, hP.lift_fst _ _ w, hP.lift_snd _ _ w⟩
    refine ⟨τ, ?_⟩
    have hout0 : IsPullback (τ ≫ (AffineSpace (ULift.{u} (Fin 1)) T ↘ T)) y y
        (AffineSpace.homOfVector (𝟙 N) v ≫ (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)) := by
      rw [h2, hσ]
      exact IsPullback.id_horiz y
    have hii : IsPullback τ y (AffineSpace.map (ULift.{u} (Fin 1)) y)
        (AffineSpace.homOfVector (𝟙 N) v) :=
      IsPullback.of_right hout0 h1 hP.flip
    have hbot : IsPullback s (𝟙 N) jW (AffineSpace.homOfVector (𝟙 N) v) :=
      IsPullback.of_vert_isIso_mono ⟨by rw [hs, Category.id_comp]⟩
    have hcomm : τ ≫ yW = y ≫ s := by
      rw [← cancel_mono jW, Category.assoc, Category.assoc, hyW, hs, h1]
    have hout : IsPullback τ (y ≫ 𝟙 N) (yW ≫ jW) (AffineSpace.homOfVector (𝟙 N) v) := by
      rw [Category.comp_id, hyW]
      exact hii
    exact (IsPullback.of_bot hout hcomm hbot).flip

  have hQpW : IsPullback yW (AffineSpace (ULift.{u} (Fin 1)) T ↘ T)
      (jW ≫ (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)) y := by
    have htop : IsPullback yW (𝟙 _) jW (AffineSpace.map (ULift.{u} (Fin 1)) y) :=
      IsPullback.of_vert_isIso_mono ⟨by rw [hyW, Category.id_comp]⟩
    have := IsPullback.paste_vert htop hP
    rw [Category.id_comp] at this
    exact this

  obtain ⟨DG, hDG⟩ := wc_hm_pull_data_exists G ℓ
  obtain ⟨Ds0, hDs0⟩ := wc_hm_pull_data_exists s₀ ℓ
  obtain ⟨Ds1, hDs1⟩ := wc_hm_pull_data_exists s₁ ℓ
  obtain ⟨Dmy, hDmy⟩ := wc_hm_pull_data_exists (AffineSpace.map (ULift.{u} (Fin 1)) y) ℓ
  obtain ⟨DyW, hDyW⟩ := wc_hm_pull_data_exists yW ℓ
  obtain ⟨Dj, hDj⟩ := wc_hm_pull_data_exists jW ℓ
  obtain ⟨Dp, hDp⟩ := wc_hm_pull_data_exists (AffineSpace (ULift.{u} (Fin 1)) N ↘ N) ℓ
  obtain ⟨DpW, hDpW⟩ :=
    wc_hm_pull_data_exists (jW ≫ (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)) ℓ
  obtain ⟨Did, hDid⟩ := wc_hm_pull_data_exists (𝟙 N) ℓ
  have eDy := wc_supp_unit_epi_of_noetherian y ℓ Dy hDy
  have eDyW := wc_supp_unit_epi_of_noetherian yW ℓ DyW hDyW
  have eDmy := wc_supp_unit_epi_of_noetherian (AffineSpace.map (ULift.{u} (Fin 1)) y) ℓ Dmy hDmy

  obtain ⟨κG, hκG⟩ := kap i G yW g' hpb Di hDi DyW hDyW DG hDG
  obtain ⟨τ₀, hτ₀⟩ := sq _ s₀ hs₀
  obtain ⟨τ₁, hτ₁⟩ := sq _ s₁ hs₁
  obtain ⟨γ₀, hγ₀⟩ := kap yW s₀ y τ₀ hτ₀ DyW hDyW Dy hDy Ds0 hDs0
  obtain ⟨γ₁, hγ₁⟩ := kap yW s₁ y τ₁ hτ₁ DyW hDyW Dy hDy Ds1 hDs1
  obtain ⟨γp, hγp⟩ := kap y (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)
    (AffineSpace.map (ULift.{u} (Fin 1)) y) (AffineSpace (ULift.{u} (Fin 1)) T ↘ T) hP
    Dy hDy Dmy hDmy Dp hDp
  obtain ⟨γpW, hγpW⟩ := kap y (jW ≫ (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)) yW
    (AffineSpace (ULift.{u} (Fin 1)) T ↘ T) hQpW Dy hDy DyW hDyW DpW hDpW
  obtain ⟨γid, hγid⟩ := kap y (𝟙 N) y (𝟙 T) (IsPullback.id_vert y) Dy hDy Dy hDy Did hDid
  obtain ⟨κj, hκj, hbij⟩ := wc_supp_open_excision_exists (AffineSpace.map (ULift.{u} (Fin 1)) y)
    jW yW hyW Dmy hDmy DyW hDyW Dj hDj

  obtain ⟨ξ', hξ'⟩ :=
    (hbij n).2 ((Abelian.Ext.mk₀ κG).comp (wcSuppPullExt Di DG n θ) (zero_add _))
  have hsurj : Function.Surjective _ :=
    wc_supp_A1_invariance K ℓ hℓK qN y Dy hDy Dmy hDmy eDmy Dp hDp γp hγp n
  obtain ⟨η, hη⟩ := hsurj ξ'

  have F1₀ : _ = _ := wc_supp_pull_comp G s₀ k₀ hk₀ Di hDi DyW hDyW Dy hDy eDy DG hDG
    Ds0 hDs0 D₀ hD₀ κG hκG γ₀ hγ₀ κ₀ hκ₀ n θ
  have F1₁ : _ = _ := wc_supp_pull_comp G s₁ k₁ hk₁ Di hDi DyW hDyW Dy hDy eDy DG hDG
    Ds1 hDs1 D₁ hD₁ κG hκG γ₁ hγ₁ κ₁ hκ₁ n θ
  have F2 : _ = _ := wc_supp_pull_comp (AffineSpace (ULift.{u} (Fin 1)) N ↘ N) jW
    (jW ≫ (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)) rfl Dy hDy Dmy hDmy DyW hDyW eDyW
    Dp hDp Dj hDj DpW hDpW γp hγp κj hκj γpW hγpW n η
  have hk0' : s₀ ≫ jW ≫ (AffineSpace (ULift.{u} (Fin 1)) N ↘ N) = 𝟙 N := by
    rw [← Category.assoc, hs₀, AffineSpace.homOfVector_over]
  have hk1' : s₁ ≫ jW ≫ (AffineSpace (ULift.{u} (Fin 1)) N ↘ N) = 𝟙 N := by
    rw [← Category.assoc, hs₁, AffineSpace.homOfVector_over]
  have F3₀ : _ = _ := wc_supp_pull_comp (jW ≫ (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)) s₀ (𝟙 N)
    hk0' Dy hDy DyW hDyW Dy hDy eDy DpW hDpW Ds0 hDs0 Did hDid γpW hγpW γ₀ hγ₀ γid hγid n η
  have F3₁ : _ = _ := wc_supp_pull_comp (jW ≫ (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)) s₁ (𝟙 N)
    hk1' Dy hDy DyW hDyW Dy hDy eDy DpW hDpW Ds1 hDs1 Did hDid γpW hγpW γ₁ hγ₁ γid hγid n η

  have hX := F2.trans ((congrArg (fun z => (Abelian.Ext.mk₀ κj).comp
    (wcSuppPullExt Dmy Dj n z) (zero_add _)) hη).trans hξ')
  have L0 := F1₀.trans ((congrArg (fun z => (Abelian.Ext.mk₀ γ₀).comp
    (wcSuppPullExt DyW Ds0 n z) (zero_add _)) hX.symm).trans F3₀.symm)
  have L1 := F1₁.trans ((congrArg (fun z => (Abelian.Ext.mk₀ γ₁).comp
    (wcSuppPullExt DyW Ds1 n z) (zero_add _)) hX.symm).trans F3₁.symm)
  exact L0.trans L1.symm

theorem wc_proet_free_sheaf_yoneda : ∀ (S : Scheme.{u}), ∃ η : ∀ T : S.ProEt, (wcFreeSheaf S T).obj.obj (Opposite.op T),
    (∀ (T : S.ProEt) (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
        (s : G.obj.obj (Opposite.op T)),
      ∃! g : wcFreeSheaf S T ⟶ G, (g.hom.app (Opposite.op T)).hom (η T) = s) ∧
    ∀ (T T' : S.ProEt) (c : T' ⟶ T),
      ((wcFreeSheafMap S c).hom.app (Opposite.op T')).hom (η T') =
        ((wcFreeSheaf S T).obj.map c.op).hom (η T) :=
by
  intro S
  let J := Scheme.ProEt.topology S
  let η : ∀ T : S.ProEt, (wcFreeSheaf S T).obj.obj (Opposite.op T) :=
    fun T => ((toSheafify J (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
      (Opposite.op T)).hom (FreeAbelianGroup.of (ULift.up (𝟙 T)))
  let e : ∀ (T : S.ProEt) (G : Sheaf J AddCommGrpCat.{u+1}),
      (wcFreeSheaf S T ⟶ G) ≃ G.obj.obj (Opposite.op T) := fun T G =>
    ((sheafificationAdjunction J AddCommGrpCat.{u+1}).homEquiv
        (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) G).trans
      (((Adjunction.whiskerRight (S.ProEt)ᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u}) G.obj).trans
        (uliftYonedaEquiv.{u+1} (X := T) (F := G.obj ⋙ forget AddCommGrpCat.{u+1})))
  have he : ∀ (T : S.ProEt) (G : Sheaf J AddCommGrpCat.{u+1}) (g : wcFreeSheaf S T ⟶ G),
      e T G g = (g.hom.app (Opposite.op T)).hom (η T) := fun _ _ _ => rfl
  refine ⟨η, fun T G s => ⟨(e T G).symm s, ?_, fun g hg => (e T G).injective ?_⟩, fun T T' c => ?_⟩
  · exact (he T G _).symm.trans (Equiv.apply_symm_apply _ _)
  · exact (he T G g).trans (hg.trans (Equiv.apply_symm_apply _ _).symm)
  · let P := yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
    let P' := yoneda.obj T' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
    let w : P' ⟶ P := Functor.whiskerRight (yoneda.map c) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
    let x' : P'.obj (Opposite.op T') := FreeAbelianGroup.of (ULift.up (𝟙 T'))
    let x : P.obj (Opposite.op T) := FreeAbelianGroup.of (ULift.up (𝟙 T))
    have h1 : ((sheafifyMap J w).app (Opposite.op T')).hom (((toSheafify J P').app
        (Opposite.op T')).hom x') = ((toSheafify J P).app (Opposite.op T')).hom
          ((w.app (Opposite.op T')).hom x') :=
      (ConcreteCategory.congr_hom
        (congrArg (fun φ => φ.app (Opposite.op T')) (toSheafify_naturality J w)) x').symm
    have h2 : (w.app (Opposite.op T')).hom x' = (P.map c.op).hom x := by
      change FreeAbelianGroup.map _ (FreeAbelianGroup.of _) =
        FreeAbelianGroup.map _ (FreeAbelianGroup.of _)
      refine (FreeAbelianGroup.map_of_apply _).trans
        (Eq.trans ?_ (FreeAbelianGroup.map_of_apply _).symm)
      congr 1
    have hn : ((toSheafify J P).app (Opposite.op T')).hom ((P.map c.op).hom x) =
        ((sheafify J P).map c.op).hom (((toSheafify J P).app (Opposite.op T)).hom x) :=
      NatTrans.naturality_apply (toSheafify J P) c.op x
    change ((sheafifyMap J w).app (Opposite.op T')).hom (((toSheafify J P').app
        (Opposite.op T')).hom x') =
      ((sheafify J P).map c.op).hom (((toSheafify J P).app (Opposite.op T)).hom x)
    rw [h1, h2, hn]

theorem wc_point_supp_kernel_free (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [IsProper X.hom] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    {Z : Scheme.{u}} (a : Z ⟶ wcXbar F X) (ha : IsIso (a ≫ wcPi2 F X))
    (Da : wcHMPullData a ℓ) (hDa : wcHMPullCanonical Da)
    (L : Sheaf (Scheme.ProEt.topology (wcXbar F X)) AddCommGrpCat.{u+1} ⥤
      SheafOfModules.{u+1} (wcRingSheaf (wcXbar F X) ℓ))
    (adj : L ⊣ SheafOfModules.toSheaf (wcRingSheaf (wcXbar F X) ℓ))
    [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L]
    (O : (wcXbar F X).Opens) (hO : (O : Set (wcXbar F X)) = (Set.range a)ᶜ) :
    ∃ (ε : L.obj (wcFreeSheaf (wcXbar F X) (Scheme.ProEt.mk (𝟙 (wcXbar F X)))) ≅
        SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ))
      (h : (L.map (wcFreeSheafMap (wcXbar F X)
          (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
            Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 (wcXbar F X)))) ≫ ε.hom) ≫
          wcSuppUnitMap Da = 0),
      (ShortComplex.mk (L.map (wcFreeSheafMap (wcXbar F X)
          (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
            Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 (wcXbar F X)))) ≫ ε.hom)
        (wcSuppUnitMap Da) h).Exact :=
by
  classical
  haveI := ha
  haveI : IsProper (wcPi2 F X) := by unfold wcPi2; infer_instance
  haveI : IsClosedImmersion a := IsClosedImmersion.of_comp a (wcPi2 F X)
  haveI : IsLocallyNoetherian (wcXbar F X) :=
    LocallyOfFiniteType.isLocallyNoetherian (wcPi2 F X)
  let T : (wcXbar F X).ProEt := Scheme.ProEt.mk (𝟙 (wcXbar F X))
  let O' : (wcXbar F X).ProEt := Scheme.ProEt.mk O.ι
  let ι : O' ⟶ T := MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial

  have hT : Limits.IsTerminal T :=
    Limits.IsTerminal.ofUniqueHom
      (fun Y => MorphismProperty.Over.homMk Y.hom (Category.comp_id _) trivial)
      (fun Y m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id _).symm.trans (MorphismProperty.Over.w m)))

  obtain ⟨ε', hε'⟩ : ∃ ε' : wcFreeSheaf (wcXbar F X) T ⟶
      (SheafOfModules.toSheaf (wcRingSheaf (wcXbar F X) ℓ)).obj
        (SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ)),
      ∀ M : SheafOfModules (wcRingSheaf (wcXbar F X) ℓ),
        Function.Bijective (fun f : SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ) ⟶ M =>
          ε' ≫ (SheafOfModules.toSheaf (wcRingSheaf (wcXbar F X) ℓ)).map f) :=
    sheafOfModules_unit_corepresented_by_free_terminal
      (Scheme.ProEt.topology (wcXbar F X)) (wcRingSheaf (wcXbar F X) ℓ) T hT
  obtain ⟨φ, hφ⟩ : ∃ φ : L.obj (wcFreeSheaf (wcXbar F X) T) ⟶
      SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ), adj.homEquiv _ _ φ = ε' :=
    ⟨_, Equiv.apply_symm_apply _ _⟩
  have hφiso : IsIso φ := by
    apply isIso_of_coyoneda_map_bijective
    intro N
    have key : (fun x : SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ) ⟶ N => φ ≫ x) =
        (adj.homEquiv _ _).symm ∘
          (fun f => ε' ≫ (SheafOfModules.toSheaf (wcRingSheaf (wcXbar F X) ℓ)).map f) := by
      funext x
      apply (adj.homEquiv _ _).injective
      rw [Function.comp_apply, Equiv.apply_symm_apply, Adjunction.homEquiv_naturality_right, hφ]
    rw [key]
    exact (adj.homEquiv _ _).symm.bijective.comp (hε' N)
  suffices H : ∀ σ : L.obj (wcFreeSheaf (wcXbar F X) O') ⟶
      SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ),
      σ = L.map (wcFreeSheafMap (wcXbar F X) ι) ≫ φ →
      ∃ (h : σ ≫ wcSuppUnitMap Da = 0), (ShortComplex.mk σ (wcSuppUnitMap Da) h).Exact by
    obtain ⟨h, hex⟩ := H _ rfl
    exact ⟨asIso φ, h, hex⟩
  intro σ hσ
  obtain ⟨η, hηU, hηN⟩ := wc_proet_free_sheaf_yoneda (wcXbar F X)

  have hempty : IsEmpty ↥(Limits.pullback O.ι a) := by
    constructor
    intro p
    have h1 : O.ι (Limits.pullback.fst O.ι a p) = a (Limits.pullback.snd O.ι a p) := by
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
    have h2 : O.ι (Limits.pullback.fst O.ι a p) ∈ (O : Set (wcXbar F X)) := by
      rw [← Scheme.Opens.range_ι]; exact ⟨_, rfl⟩
    rw [hO, h1] at h2
    exact h2 ⟨_, rfl⟩
  have hsub : ∀ x y : ((SheafOfModules.toSheaf (wcRingSheaf (wcXbar F X) ℓ)).obj
      (wcSuppObj Da)).obj.obj (Opposite.op O'), x = y := by
    intro x y
    let x' : C(↥(Limits.pullback O.ι a), ULift.{u+1} ℚ_[ℓ]) := x
    let y' : C(↥(Limits.pullback O.ι a), ULift.{u+1} ℚ_[ℓ]) := y
    show x' = y'
    exact ContinuousMap.ext fun p => (hempty.false p).elim
  have hσρ : σ ≫ wcSuppUnitMap Da = 0 := by
    apply (adj.homEquiv _ _).injective
    exact (hηU O' _ 0).unique (hsub _ _) (hsub _ _)
  refine ⟨hσρ, ?_⟩

  obtain ⟨g₁, hg₁, -⟩ := hηU T ((SheafOfModules.toSheaf (wcRingSheaf (wcXbar F X) ℓ)).obj
    (SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ)))
    (1 : (wcRingSheaf (wcXbar F X) ℓ).obj.obj (Opposite.op T))
  obtain ⟨xu, hxu⟩ := (hε' (SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ))).2 g₁
  let s : (wcRingSheaf (wcXbar F X) ℓ).obj.obj (Opposite.op T) :=
    (ε'.hom.app (Opposite.op T)).hom (η T)
  let c : (wcRingSheaf (wcXbar F X) ℓ).obj.obj (Opposite.op T) :=
    (xu.val.app (Opposite.op T)).hom (1 : (wcRingSheaf (wcXbar F X) ℓ).obj.obj (Opposite.op T))
  have hxs : (xu.val.app (Opposite.op T)).hom s =
      (1 : (wcRingSheaf (wcXbar F X) ℓ).obj.obj (Opposite.op T)) := by
    have := congrArg (fun ψ => (ψ.hom.app (Opposite.op T)).hom (η T)) hxu
    exact this.trans hg₁
  have hsc : s * c = 1 := by
    have e := (xu.val.app (Opposite.op T)).hom.map_smul s
      (1 : (wcRingSheaf (wcXbar F X) ℓ).obj.obj (Opposite.op T))
    have e1 : (s • (1 : (wcRingSheaf (wcXbar F X) ℓ).obj.obj (Opposite.op T)) :
        (SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ)).val.obj (Opposite.op T)) = s :=
      mul_one s
    have e2 : (xu.val.app (Opposite.op T)).hom s = s • c :=
      (congrArg (fun z => (xu.val.app (Opposite.op T)).hom z) e1).symm.trans e
    exact e2.symm.trans hxs

  let y₀ : (L.obj (wcFreeSheaf (wcXbar F X) O')).val.obj (Opposite.op O') :=
    ((adj.unit.app (wcFreeSheaf (wcXbar F X) O')).hom.app (Opposite.op O')).hom (η O')
  have hhe : adj.homEquiv _ _ σ = wcFreeSheafMap (wcXbar F X) ι ≫ ε' := by
    rw [hσ, Adjunction.homEquiv_naturality_left, hφ]
  have hσy₀ : (σ.val.app (Opposite.op O')).hom y₀ =
      ((wcRingSheaf (wcXbar F X) ℓ).obj.map ι.op).hom s := by
    have e1 : (σ.val.app (Opposite.op O')).hom y₀ =
        ((adj.homEquiv _ _ σ).hom.app (Opposite.op O')).hom (η O') := by
      rw [Adjunction.homEquiv_unit]; rfl
    refine e1.trans ?_
    rw [hhe]
    have e2 := hηN T O' ι
    have e3 := NatTrans.naturality_apply ε'.hom ι.op (η T)
    exact (congrArg (fun z => (ε'.hom.app (Opposite.op O')).hom z) e2).trans e3

  rw [ShortComplex.exact_iff_epi_kernel_lift]
  show Epi (Limits.kernel.lift (wcSuppUnitMap Da) σ hσρ)
  apply Abelian.epi_of_cokernel_π_eq_zero
  have hl : ∀ (V : ((wcXbar F X).ProEt)ᵒᵖ) (z : (L.obj (wcFreeSheaf (wcXbar F X) O')).val.obj V),
      ((Limits.kernel.ι (wcSuppUnitMap Da)).val.app V).hom
        (((Limits.kernel.lift (wcSuppUnitMap Da) σ hσρ).val.app V).hom z) =
        (σ.val.app V).hom z := fun V z =>
    congrArg (fun ψ => (ψ.val.app V).hom z) (Limits.kernel.lift_ι (wcSuppUnitMap Da) σ hσρ)
  refine SheafOfModules.hom_ext (PresheafOfModules.hom_ext fun U => ?_)
  rcases U with ⟨U⟩
  ext k
  change ((Limits.cokernel.π (Limits.kernel.lift (wcSuppUnitMap Da) σ hσρ)).val.app
    (Opposite.op U)).hom k = 0
  apply wc_proet_module_section_eq_zero_of_affine_covers
    (Limits.cokernel (Limits.kernel.lift (wcSuppUnitMap Da) σ hσρ)) U
  intro W g hW
  obtain ⟨n, W', e, hW'aff, hcov, hcases⟩ :=
    wc_supp_kernel_section_local_cover a Da hDa U k W g hW
  refine ⟨n, W', e, hW'aff, hcov, fun j => ?_⟩
  have hn := PresheafOfModules.naturality_apply
    (Limits.cokernel.π (Limits.kernel.lift (wcSuppUnitMap Da) σ hσρ)).val (e j ≫ g).op k
  refine hn.symm.trans ?_
  let kj : (Limits.kernel (wcSuppUnitMap Da)).val.obj (Opposite.op (W' j)) :=
    ((Limits.kernel (wcSuppUnitMap Da)).val.map (e j ≫ g).op).hom k
  rcases hcases j with hoff | h0
  ·
    have hinj : Function.Injective
        ((Limits.kernel.ι (wcSuppUnitMap Da)).val.app (Opposite.op (W' j))).hom := by
      let G := SheafOfModules.forget (wcRingSheaf (wcXbar F X) ℓ) ⋙
        PresheafOfModules.evaluation _ (Opposite.op (W' j))
      have hmono : Mono (G.map (Limits.kernel.ι (wcSuppUnitMap Da))) := Functor.map_mono G _
      exact (ModuleCat.mono_iff_injective _).mp hmono
    have hsubset : Set.range (W' j).hom ⊆ Set.range O.ι := by
      rintro _ ⟨x, rfl⟩
      rw [Scheme.Opens.range_ι, hO]
      exact hoff x
    let lam := IsOpenImmersion.lift O.ι (W' j).hom hsubset
    have hlam : lam ≫ O.ι = (W' j).hom := IsOpenImmersion.lift_fac _ _ _
    let t : W' j ⟶ O' := MorphismProperty.Over.homMk lam hlam trivial
    let y₁ : (L.obj (wcFreeSheaf (wcXbar F X) O')).val.obj (Opposite.op (W' j)) :=
      ((L.obj (wcFreeSheaf (wcXbar F X) O')).val.map t.op).hom y₀
    let sW : (wcRingSheaf (wcXbar F X) ℓ).obj.obj (Opposite.op (W' j)) :=
      ((wcRingSheaf (wcXbar F X) ℓ).obj.map t.op).hom
        (((wcRingSheaf (wcXbar F X) ℓ).obj.map ι.op).hom s)
    let cW : (wcRingSheaf (wcXbar F X) ℓ).obj.obj (Opposite.op (W' j)) :=
      ((wcRingSheaf (wcXbar F X) ℓ).obj.map t.op).hom
        (((wcRingSheaf (wcXbar F X) ℓ).obj.map ι.op).hom c)
    have hcs : cW * sW = 1 := by
      show ((wcRingSheaf (wcXbar F X) ℓ).obj.map t.op).hom
          (((wcRingSheaf (wcXbar F X) ℓ).obj.map ι.op).hom c) *
        ((wcRingSheaf (wcXbar F X) ℓ).obj.map t.op).hom
          (((wcRingSheaf (wcXbar F X) ℓ).obj.map ι.op).hom s) = 1
      have hcomm : c * s = 1 := by
        let c' : C(↥T.left, ULift.{u+1} ℚ_[ℓ]) := c
        let s' : C(↥T.left, ULift.{u+1} ℚ_[ℓ]) := s
        have h1 : c' * s' = s' * c' := mul_comm c' s'
        exact h1.trans hsc
      rw [← map_mul, ← map_mul, hcomm, map_one, map_one]
    have e2 : (σ.val.app (Opposite.op (W' j))).hom y₁ = sW := by
      have hn' := PresheafOfModules.naturality_apply σ.val t.op y₀
      exact hn'.trans (congrArg (fun z =>
        ((SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ)).val.map t.op).hom z) hσy₀)
    let f : (wcRingSheaf (wcXbar F X) ℓ).obj.obj (Opposite.op (W' j)) :=
      ((Limits.kernel.ι (wcSuppUnitMap Da)).val.app (Opposite.op (W' j))).hom kj
    have hσy : (σ.val.app (Opposite.op (W' j))).hom ((f * cW) • y₁) = f := by
      have e1 := (σ.val.app (Opposite.op (W' j))).hom.map_smul (f * cW) y₁
      rw [e1, e2]
      show (f * cW) * sW = f
      rw [mul_assoc, hcs, mul_one]
    have hσ'y : ((Limits.kernel.lift (wcSuppUnitMap Da) σ hσρ).val.app
        (Opposite.op (W' j))).hom ((f * cW) • y₁) = kj := by
      apply hinj
      rw [hl]
      exact hσy
    have hc := congrArg (fun ψ => (ψ.val.app (Opposite.op (W' j))).hom ((f * cW) • y₁))
      (Limits.cokernel.condition (Limits.kernel.lift (wcSuppUnitMap Da) σ hσρ))
    refine (congrArg (fun z => ((Limits.cokernel.π (Limits.kernel.lift (wcSuppUnitMap Da) σ hσρ)).val.app
      (Opposite.op (W' j))).hom z) hσ'y.symm).trans ?_
    exact hc
  ·
    exact (congrArg (fun z => ((Limits.cokernel.π (Limits.kernel.lift (wcSuppUnitMap Da) σ hσρ)).val.app
      (Opposite.op (W' j))).hom z) h0).trans (map_zero _)

theorem wc_xbar_local_zmod_succ_vanish (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F))) [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F) (O : (wcXbar F X).Opens) (x : wcXbar F X) (hO : (O : Set (wcXbar F X)) = {x}ᶜ) : ∀ z : Abelian.Ext (Limits.cokernel (wcFreeSheafMap (wcXbar F X) (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial : Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 (wcXbar F X))))) (wcZModSheaf (wcXbar F X) ℓ) (2 * d + 1), z = 0 :=
by
  intro z
  have h : WeaklyEtale (Limits.pullback.fst X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F)
  let O' : (wcGeomPoint F X h).left.Opens := O
  have hV0 : WeaklyEtale (O'.ι ≫ (wcGeomPoint F X h).hom) := by
    first
      | (haveI := h; infer_instance)
      | exact (MorphismProperty.IsMultiplicative.toIsStableUnderComposition (W := @WeaklyEtale)).comp_mem
          O'.ι _ inferInstance h
  let V₀ : X.left.ProEt := MorphismProperty.Over.mk ⊤ (O'.ι ≫ (wcGeomPoint F X h).hom) hV0
  let ι₀ : V₀ ⟶ wcGeomPoint F X h := MorphismProperty.Over.homMk O'.ι rfl trivial
  have hι₀ : IsOpenImmersion ι₀.left := show IsOpenImmersion O'.ι from inferInstance
  have hpt : Set.range ι₀.left = {x}ᶜ := by
    show Set.range O'.ι = _
    rw [Scheme.Opens.range_ι]
    exact hO
  have hvan := wc_glc_local_succ_vanish F X d ℓ hℓ h V₀ ι₀ hι₀ x hpt
  haveI : IsOpenImmersion ι₀.left := hι₀
  obtain ⟨E⟩ := wc_glc_coker_slice X.left (wcGeomPoint F X h) V₀ ι₀ ℓ (2 * d + 1)
  have hsubA : Subsingleton (Abelian.Ext (Limits.cokernel (wcFreeSheafMap X.left ι₀))
      (wcZModSheaf X.left ℓ) (2 * d + 1)) := ⟨fun a b => (hvan a).trans (hvan b).symm⟩
  have hs := @Equiv.subsingleton _ _ E.symm hsubA
  exact @Subsingleton.elim _ hs z 0

theorem wc_xbar_local_zmod_card_ge (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F))) [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F) (O : (wcXbar F X).Opens) (x : wcXbar F X) (hO : (O : Set (wcXbar F X)) = {x}ᶜ) : ∀ n : ℕ, 1 ≤ n → Finite (Abelian.Ext (Limits.cokernel (wcFreeSheafMap (wcXbar F X) (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial : Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 (wcXbar F X))))) (wcZModSheaf (wcXbar F X) (ℓ ^ n)) (2 * d)) → ℓ ^ n ≤ Nat.card (Abelian.Ext (Limits.cokernel (wcFreeSheafMap (wcXbar F X) (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial : Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 (wcXbar F X))))) (wcZModSheaf (wcXbar F X) (ℓ ^ n)) (2 * d)) :=
by
  intro n hn hfin
  classical
  haveI hprop : IsProper (wcPi2 F X) := by unfold wcPi2; infer_instance
  haveI hsm : SmoothOfRelativeDimension d (wcPi2 F X) := by
    unfold wcPi2
    haveI := smoothOfRelativeDimension_isStableUnderBaseChange d
    exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension d)
      (IsPullback.of_hasPullback X.hom _) inferInstance
  haveI hirr : IrreducibleSpace ↥(wcXbar F X) :=
    GeometricallyIrreducible.geometrically_irreducibleSpace (f := X.hom)
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) _ _
      (IsPullback.of_hasPullback _ _)
  have hneℓ : ((ℓ : ℕ) : AlgebraicClosure F) ≠ 0 := by
    intro h0
    have hp : ringChar F ∣ ℓ :=
      (CharP.cast_eq_zero_iff (AlgebraicClosure F) (ringChar F) ℓ).mp h0
    have hpp : Nat.Prime (ringChar F) := CharP.char_is_prime F (ringChar F)
    have hpl : ringChar F = ℓ := (Nat.prime_dvd_prime_iff_eq hpp (Fact.out)).mp hp
    letI := Fintype.ofFinite F
    have hc : ((Nat.card F : ℕ) : F) = 0 := by
      rw [Nat.card_eq_fintype_card]; exact FiniteField.cast_card_eq_zero F
    have hdvd : ringChar F ∣ Nat.card F := (ringChar.spec F _).mp hc
    exact hℓ (hpl ▸ hdvd)
  have hdim : topologicalKrullDim (wcXbar F X) = (d : WithBot ℕ∞) :=
    le_antisymm (wc_smooth_alg_closed_dim_le (AlgebraicClosure F) (wcXbar F X) (wcPi2 F X) d)
      (wc_smooth_irreducible_dim_ge (AlgebraicClosure F) (wcXbar F X) (wcPi2 F X) d)
  set ι : Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 (wcXbar F X)) :=
    MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial with hιdef
  have hmono : Mono (wcFreeSheafMap (wcXbar F X) ι) :=
    wc_free_sheaf_map_mono (wcXbar F X) _ _ ι (IsOpenImmersion.mono O.ι)
  have hS : (ShortComplex.mk (wcFreeSheafMap (wcXbar F X) ι)
      (Limits.cokernel.π (wcFreeSheafMap (wcXbar F X) ι))
      (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) hmono inferInstance
  have hVUo : IsOpenImmersion (Scheme.ProEt.mk O.ι).hom :=
    inferInstanceAs (IsOpenImmersion O.ι)
  have hne : Set.range (Scheme.ProEt.mk O.ι).hom ≠ Set.univ := by
    change Set.range O.ι ≠ Set.univ
    rw [Scheme.Opens.range_ι, hO]
    intro h
    have hx : x ∈ ({x}ᶜ : Set (wcXbar F X)) := h ▸ Set.mem_univ x
    exact hx rfl
  have hvan := fun y => wc_xbar_open_zmod_top_vanish F X d ℓ hℓ (Scheme.ProEt.mk O.ι) hVUo hne n y
  let r : Abelian.Ext (Limits.cokernel (wcFreeSheafMap (wcXbar F X) ι))
      (wcZModSheaf (wcXbar F X) (ℓ ^ n)) (2 * d) →
      Abelian.Ext (wcFreeSheaf (wcXbar F X) (Scheme.ProEt.mk (𝟙 (wcXbar F X))))
      (wcZModSheaf (wcXbar F X) (ℓ ^ n)) (2 * d) :=
    fun t => (Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap (wcXbar F X) ι))).comp t
      (zero_add (2 * d))
  have hr : Function.Surjective r := by
    intro h
    obtain ⟨t, ht⟩ := Abelian.Ext.contravariant_sequence_exact₂ hS
      (wcZModSheaf (wcXbar F X) (ℓ ^ n)) h (hvan _)
    exact ⟨t, ht⟩
  obtain ⟨E⟩ := wc_proet_etale_comparison_zmod (AlgebraicClosure F) (wcXbar F X) (wcPi2 F X)
    (ℓ ^ n) (2 * d)
  have hge := wc_et_top_coh_card_ge (AlgebraicClosure F) (wcXbar F X) (wcPi2 F X) d hdim ℓ
    (Fact.out : ℓ.Prime) hneℓ n hn
  have hH := hge.trans_eq (Nat.card_congr E).symm
  exact hH.trans (Nat.card_le_card_of_surjective r hr)

theorem wc_local_tower_counts : ∀ (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (P : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (N : ℕ), Finite (Abelian.Ext P (wcZModSheaf S ℓ) N) → Nat.card (Abelian.Ext P (wcZModSheaf S ℓ) N) ≤ ℓ → (∀ z : Abelian.Ext P (wcZModSheaf S ℓ) (N + 1), z = 0) → (∀ n : ℕ, 1 ≤ n → Finite (Abelian.Ext P (wcZModSheaf S (ℓ ^ n)) N) → ℓ ^ n ≤ Nat.card (Abelian.Ext P (wcZModSheaf S (ℓ ^ n)) N)) → (∀ n : ℕ, Finite (Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ n))) N) ∧ Nat.card (Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ n))) N) = ℓ ^ n) ∧ (∀ (n : ℕ) (x : Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ n))) N), ∃ x' : Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ (n + 1)))) N, x'.comp (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerCast ℓ n) continuous_of_discreteTopology)) (add_zero N) = x) ∧ (∀ (n M : ℕ), M + 1 = N → ∀ e : Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ n))) M, ∃ e' : Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ (n + 1)))) M, e'.comp (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerCast ℓ n) continuous_of_discreteTopology)) (add_zero M) = e) :=
by
  intro S ℓ _ P N hBfin hBc hvan hge
  classical
  have hℓ0 : ℓ ≠ 0 := (Fact.out : Nat.Prime ℓ).ne_zero
  haveI : NeZero ℓ := ⟨hℓ0⟩

  have hcse : ∀ {A B C : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B] [AddCommGroup C]
      [TopologicalSpace C] [IsTopologicalAddGroup C] (φ : A →+ B) (hφ : Continuous φ) (ψ : B →+ C)
      (hψ : Continuous ψ), Topology.IsEmbedding φ → (∀ b : B, ψ b = 0 ↔ ∃ a : A, φ a = b) →
      (∃ σ : C → B, Continuous σ ∧ ∀ c, ψ (σ c) = c) →
      ∃ hzero : wcContSheafMap S φ hφ ≫ wcContSheafMap S ψ hψ = 0,
        (ShortComplex.mk (wcContSheafMap S φ hφ) (wcContSheafMap S ψ hψ) hzero).ShortExact := by
    intro A B C _ _ _ _ _ _ _ _ _ φ hφ ψ hψ hemb hker hsec
    obtain ⟨σ, hσc, hσ⟩ := hsec
    have crit : ∀ {F G H : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (f : F ⟶ G)
        (g : G ⟶ H),
        (∀ U (x : F.obj.obj U), g.hom.app U (f.hom.app U x) = 0) →
        (∀ U, Function.Injective (f.hom.app U)) →
        (∀ U, Function.Surjective (g.hom.app U)) →
        (∀ U (x : G.obj.obj U), g.hom.app U x = 0 → ∃ y, f.hom.app U y = x) →
        ∃ hzero : f ≫ g = 0, (ShortComplex.mk f g hzero).ShortExact := by
      intro F G H f g h1 h0 h2 h3
      have hzero : ∀ {X Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (U : S.ProEtᵒᵖ)
          (y : X.obj.obj U), (0 : X ⟶ Y).hom.app U y = 0 := by
        intro X Y U y
        rfl
      have hcomp : ∀ {X Y Z : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (p : X ⟶ Y)
          (q : Y ⟶ Z) (U : S.ProEtᵒᵖ) (y : X.obj.obj U),
          (p ≫ q).hom.app U y = q.hom.app U (p.hom.app U y) := by
        intro X Y Z p q U y
        rfl
      have w : f ≫ g = 0 := by
        apply Sheaf.hom_ext
        ext U x
        rw [hcomp, hzero, h1]
      haveI : Epi g := by
        haveI : ∀ U, Epi (g.hom.app U) := fun U => (AddCommGrpCat.epi_iff_surjective _).mpr (h2 U)
        haveI : Epi g.hom := NatTrans.epi_of_epi_app _
        exact Sheaf.Hom.epi_of_presheaf_epi _ _ _
      haveI : Mono f := by
        haveI : ∀ U, Mono (f.hom.app U) := fun U => (AddCommGrpCat.mono_iff_injective _).mpr (h0 U)
        haveI : Mono f.hom := NatTrans.mono_of_mono_app _
        exact Sheaf.Hom.mono_of_presheaf_mono _ _ _
      have fac : ∀ {A : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (k : G ⟶ A),
          f ≫ k = 0 → {l : H ⟶ A // g ≫ l = k} := by
        intro A k hk
        have hk' : ∀ U (y : F.obj.obj U), k.hom.app U (f.hom.app U y) = 0 := by
          intro U y
          have := congrArg (fun φ => φ.hom.app U y) hk
          simp only at this
          rw [hcomp, hzero] at this
          exact this
        have hd : ∀ U (x x' : G.obj.obj U), g.hom.app U x = g.hom.app U x' →
            k.hom.app U x = k.hom.app U x' := by
          intro U x x' hxx
          obtain ⟨y, hy⟩ := h3 U (x - x') (by rw [map_sub, hxx, sub_self])
          have := hk' U y
          rw [hy, map_sub, sub_eq_zero] at this
          exact this
        let σ : ∀ U, H.obj.obj U → G.obj.obj U := fun U => Function.surjInv (h2 U)
        have hσ : ∀ U φ, g.hom.app U (σ U φ) = φ := fun U φ => Function.surjInv_eq (h2 U) φ
        let lU : ∀ U, H.obj.obj U ⟶ A.obj.obj U := fun U => AddCommGrpCat.ofHom
          (AddMonoidHom.mk' (fun φ => k.hom.app U (σ U φ)) (by
            intro φ ψ
            rw [← map_add]
            apply hd
            rw [map_add, hσ, hσ, hσ]))
        have hlU : ∀ U φ, lU U φ = k.hom.app U (σ U φ) := fun U φ => rfl
        let l : H ⟶ A := ObjectProperty.homMk
          { app := lU
            naturality := by
              intro U V r
              ext φ
              rw [CategoryTheory.comp_apply, CategoryTheory.comp_apply, hlU, hlU,
                ← NatTrans.naturality_apply]
              apply hd
              rw [hσ, NatTrans.naturality_apply, hσ] }
        refine ⟨l, ?_⟩
        apply Sheaf.hom_ext
        ext U x
        rw [hcomp]
        change lU U (g.hom.app U x) = k.hom.app U x
        rw [hlU]
        apply hd
        rw [hσ]
      refine ⟨w, ShortComplex.ShortExact.mk' ?_ inferInstance inferInstance⟩
      exact ShortComplex.exact_of_g_is_cokernel _ (Limits.CokernelCofork.IsColimit.ofπ' g w fac)
    refine crit (wcContSheafMap S φ hφ) (wcContSheafMap S ψ hψ) ?_ ?_ ?_ ?_
    · intro U x
      let x0 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), A) := x.down
      apply ULift.ext
      apply ContinuousMap.ext
      intro t
      change ψ (φ (x0 t)) = 0
      exact (hker _).mpr ⟨_, rfl⟩
    · intro U x x' hxx
      let x0 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), A) := x.down
      let x1 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), A) := x'.down
      apply ULift.ext
      apply ContinuousMap.ext
      intro t
      have h := congrArg (fun z => (ULift.down z :
        C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), B)) t) hxx
      have h' : φ (x0 t) = φ (x1 t) := h
      exact hemb.injective h'
    · intro U z
      let z0 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), C) := z.down
      refine ⟨ULift.up (⟨fun t => σ (z0 t), hσc.comp z0.continuous⟩ :
        C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), B)), ?_⟩
      apply ULift.ext
      apply ContinuousMap.ext
      intro t
      change ψ (σ (z0 t)) = z0 t
      exact hσ _
    · intro U x hx
      let y0 : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), B) := x.down
      have hx' : ∀ t, ψ (y0 t) = 0 := by
        intro t
        have := congrArg (fun z => (ULift.down z :
          C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), C)) t) hx
        exact this
      choose k hk using fun t => (hker (y0 t)).mp (hx' t)
      have hkc : Continuous k := by
        rw [hemb.continuous_iff]
        have e : (⇑φ ∘ k) = ⇑y0 := funext hk
        rw [e]
        exact y0.continuous
      refine ⟨ULift.up (⟨k, hkc⟩ :
        C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), A)), ?_⟩
      apply ULift.ext
      apply ContinuousMap.ext
      intro t
      change φ (k t) = y0 t
      exact hk t

  have hses : ∀ n : ℕ, ∃ (μ : wcZModSheaf S ℓ ⟶ wcContSheaf S (ZMod (ℓ ^ (n + 1))))
      (hz : μ ≫ wcContSheafMap S (wcTowerCast ℓ n) continuous_of_discreteTopology = 0),
      (ShortComplex.mk μ (wcContSheafMap S (wcTowerCast ℓ n) continuous_of_discreteTopology)
        hz).ShortExact := by
    intro n
    obtain ⟨φ, hφ⟩ : ∃ φ : ZMod ℓ →+ ZMod (ℓ ^ (n + 1)), ∀ j : ℤ,
        φ (j : ZMod ℓ) = (j : ZMod (ℓ ^ (n + 1))) * ((ℓ ^ n : ℕ) : ZMod (ℓ ^ (n + 1))) :=
      ⟨ZMod.lift ℓ ⟨zmultiplesHom (ZMod (ℓ ^ (n + 1))) ((ℓ ^ n : ℕ) : ZMod (ℓ ^ (n + 1))),
        by
          rw [zmultiplesHom_apply, natCast_zsmul, nsmul_eq_mul, ← Nat.cast_mul]
          exact (ZMod.natCast_eq_zero_iff _ _).mpr ⟨1, by ring⟩⟩,
        fun j => by
          rw [ZMod.lift_coe]
          change zmultiplesHom (ZMod (ℓ ^ (n + 1))) ((ℓ ^ n : ℕ) : ZMod (ℓ ^ (n + 1))) j = _
          rw [zmultiplesHom_apply, zsmul_eq_mul]⟩
    have hφinj : Function.Injective φ := by
      intro a b hab
      obtain ⟨ka, rfl⟩ := ZMod.intCast_surjective a
      obtain ⟨kb, rfl⟩ := ZMod.intCast_surjective b
      rw [hφ, hφ] at hab
      have h1 : ((ka * ((ℓ ^ n : ℕ) : ℤ) : ℤ) : ZMod (ℓ ^ (n + 1))) =
          ((kb * ((ℓ ^ n : ℕ) : ℤ) : ℤ) : ZMod (ℓ ^ (n + 1))) := by
        push_cast at hab ⊢
        exact hab
      rw [ZMod.intCast_eq_intCast_iff_dvd_sub] at h1
      rw [ZMod.intCast_eq_intCast_iff_dvd_sub]
      have hl : ((ℓ ^ n : ℕ) : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr (pow_ne_zero _ hℓ0)
      have e1 : kb * ((ℓ ^ n : ℕ) : ℤ) - ka * ((ℓ ^ n : ℕ) : ℤ) =
          ((ℓ ^ n : ℕ) : ℤ) * (kb - ka) := by ring
      have e2 : ((ℓ ^ (n + 1) : ℕ) : ℤ) = ((ℓ ^ n : ℕ) : ℤ) * ((ℓ : ℕ) : ℤ) := by
        push_cast; ring
      rw [e1, e2] at h1
      exact Int.dvd_of_mul_dvd_mul_left hl h1
    have hemb : Topology.IsEmbedding φ :=
      (Topology.IsOpenEmbedding.of_continuous_injective_isOpenMap continuous_of_discreteTopology
        hφinj (fun s _ => isOpen_discrete _)).isEmbedding
    have hψ : ∀ j : ℤ, wcTowerCast ℓ n (j : ZMod (ℓ ^ (n + 1))) = (j : ZMod (ℓ ^ n)) := by
      intro j
      change (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ n)) (ZMod (ℓ ^ n)))
        (j : ZMod (ℓ ^ (n + 1))) = _
      exact map_intCast _ j
    have hexact : ∀ b, wcTowerCast ℓ n b = 0 ↔ ∃ a, φ a = b := by
      intro b
      obtain ⟨kb, rfl⟩ := ZMod.intCast_surjective b
      rw [hψ, ZMod.intCast_zmod_eq_zero_iff_dvd]
      constructor
      · rintro ⟨j, hj⟩
        refine ⟨(j : ZMod ℓ), ?_⟩
        rw [hφ, hj]
        push_cast
        ring
      · rintro ⟨a, ha⟩
        obtain ⟨j, rfl⟩ := ZMod.intCast_surjective a
        rw [hφ] at ha
        have h1 : ((j * ((ℓ ^ n : ℕ) : ℤ) : ℤ) : ZMod (ℓ ^ (n + 1))) = (kb : ZMod (ℓ ^ (n + 1))) := by
          push_cast at ha ⊢
          exact ha
        rw [ZMod.intCast_eq_intCast_iff_dvd_sub] at h1
        have h2 : ((ℓ ^ n : ℕ) : ℤ) ∣ kb - j * ((ℓ ^ n : ℕ) : ℤ) :=
          (Int.natCast_dvd_natCast.mpr (pow_dvd_pow ℓ (Nat.le_succ n))).trans h1
        have h3 : ((ℓ ^ n : ℕ) : ℤ) ∣ j * ((ℓ ^ n : ℕ) : ℤ) := Dvd.intro_left _ rfl
        have h4 := dvd_add h2 h3
        rwa [sub_add_cancel] at h4
    have hsurj : Function.Surjective (wcTowerCast ℓ n) :=
      ZMod.castHom_surjective (pow_dvd_pow ℓ (Nat.le_succ n))
    obtain ⟨hz, hS⟩ := hcse φ continuous_of_discreteTopology
      (wcTowerCast ℓ n) continuous_of_discreteTopology hemb hexact
      ⟨Function.surjInv hsurj, continuous_of_discreteTopology, Function.surjInv_eq hsurj⟩
    exact ⟨wcContSheafMap S φ continuous_of_discreteTopology, hz, hS⟩
  choose μ hz hSES using hses

  have hex : ∀ (n : ℕ) (a : Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ (n + 1)))) N),
      a.comp (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerCast ℓ n) continuous_of_discreteTopology))
        (add_zero N) = 0 ↔
      ∃ b : Abelian.Ext P (wcZModSheaf S ℓ) N, b.comp (Abelian.Ext.mk₀ (μ n)) (add_zero N) = a := by
    intro n a
    constructor
    · intro h
      exact Abelian.Ext.covariant_sequence_exact₂ P (hSES n) a h
    · rintro ⟨b, rfl⟩
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, hz n,
        Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]

  have G1 : ∀ {B A C : Type (u+1)} [AddCommGroup B] [AddCommGroup A] [AddCommGroup C]
      (f : B →+ A) (g : A →+ C), (∀ a, g a = 0 ↔ ∃ b, f b = a) → Finite B → Finite C →
      Finite A ∧ Nat.card A ≤ Nat.card B * Nat.card C := by
    intro B A C _ _ _ f g hfg hB hC
    let pre : C → A := fun z => if hz : ∃ y, g y = z then hz.choose else 0
    have hpre : ∀ y, g (pre (g y)) = g y := by
      intro y
      have hz : ∃ y', g y' = g y := ⟨y, rfl⟩
      simp only [pre, dif_pos hz]
      exact hz.choose_spec
    have hmem : ∀ y, y - pre (g y) ∈ Set.range f := by
      intro y
      exact Set.mem_range.mpr ((hfg _).mp (by rw [map_sub, hpre, sub_self]))
    haveI : Finite (Set.range f) := (Set.finite_range f).to_subtype
    let Fm : A → C × Set.range f := fun y => (g y, ⟨y - pre (g y), hmem y⟩)
    have hF : Function.Injective Fm := by
      intro y y' hyy
      simp only [Fm, Prod.mk.injEq, Subtype.mk.injEq] at hyy
      obtain ⟨e1, e2⟩ := hyy
      rw [e1] at e2
      exact sub_left_injective e2
    haveI hAfin : Finite A := Finite.of_injective Fm hF
    refine ⟨hAfin, ?_⟩
    calc Nat.card A ≤ Nat.card (C × Set.range f) := Nat.card_le_card_of_injective Fm hF
      _ = Nat.card C * Nat.card (Set.range f) := Nat.card_prod _ _
      _ ≤ Nat.card C * Nat.card B :=
          Nat.mul_le_mul_left _ (Nat.card_le_card_of_surjective (Set.rangeFactorization (⇑f))
            Set.rangeFactorization_surjective)
      _ = Nat.card B * Nat.card C := mul_comm _ _

  have G2 : ∀ {B A C : Type (u+1)} [AddCommGroup B] [AddCommGroup A] [AddCommGroup C]
      (f : B →+ A) (g : A →+ C) (k : ℕ), (∀ a, g a = 0 ↔ ∃ b, f b = a) →
      Function.Surjective g → Finite A → Finite B → Nat.card B ≤ k →
      Nat.card A = k * Nat.card C → Function.Injective f := by
    intro B A C _ _ _ f g k hfg hg hA hB hBk hAk
    haveI : Finite C := Finite.of_surjective g hg
    let f' : B → g.ker := fun b =>
      ⟨f b, (AddMonoidHom.mem_ker).mpr ((hfg (f b)).mpr ⟨b, rfl⟩)⟩
    have hf' : Function.Surjective f' := by
      intro x
      obtain ⟨b, hb⟩ := (hfg x.1).mp (AddMonoidHom.mem_ker.mp x.2)
      exact ⟨b, Subtype.ext hb⟩
    have hcardA : Nat.card A = Nat.card C * Nat.card g.ker := by
      rw [AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup g.ker,
        Nat.card_congr (QuotientAddGroup.quotientKerEquivOfSurjective g hg).toEquiv]
    have hCpos : 0 < Nat.card C := Nat.card_pos
    have hK : Nat.card g.ker = k := by
      apply Nat.eq_of_mul_eq_mul_left hCpos
      rw [← hcardA, hAk, mul_comm]
    have hbij := hf'.bijective_of_nat_card_le (by rw [hK]; exact hBk)
    intro b b' hbb
    apply hbij.1
    exact Subtype.ext hbb

  have hT0 : ∀ y : Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ 0))) N, y = 0 := by
    intro y
    haveI : Subsingleton (ZMod (ℓ ^ 0)) := ZMod.subsingleton_iff.mpr (pow_zero ℓ)
    have h0 : 𝟙 (wcContSheaf S (ZMod (ℓ ^ 0))) = 0 := by
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext U
      apply AddCommGrpCat.ext
      intro y
      apply ULift.ext
      apply ContinuousMap.ext
      intro t
      exact Subsingleton.elim _ _
    rw [← Abelian.Ext.comp_mk₀_id y, h0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
  haveI hsub0 : Subsingleton (Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ 0))) N) :=
    ⟨fun a b => by rw [hT0 a, hT0 b]⟩

  let μs : ∀ n : ℕ, Abelian.Ext P (wcZModSheaf S ℓ) N →+
      Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ (n + 1)))) N :=
    fun n => (Abelian.Ext.mk₀ (μ n)).postcomp P (add_zero N)
  let τs : ∀ n : ℕ, Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ (n + 1)))) N →+
      Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ n))) N :=
    fun n => (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerCast ℓ n)
      continuous_of_discreteTopology)).postcomp P (add_zero N)
  have hμs : ∀ (n : ℕ) (b : Abelian.Ext P (wcZModSheaf S ℓ) N),
      μs n b = b.comp (Abelian.Ext.mk₀ (μ n)) (add_zero N) := fun n b => rfl
  have hτs : ∀ (n : ℕ) (a : Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ (n + 1)))) N),
      τs n a = a.comp (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerCast ℓ n)
        continuous_of_discreteTopology)) (add_zero N) := fun n a => rfl
  have hexs : ∀ (n : ℕ) (a : Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ (n + 1)))) N),
      τs n a = 0 ↔ ∃ b, μs n b = a := by
    intro n a
    rw [hτs]
    simp only [hμs]
    exact hex n a

  have hup : ∀ n : ℕ, Finite (Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ n))) N) ∧
      Nat.card (Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ n))) N) ≤ ℓ ^ n := by
    intro n
    induction n with
    | zero =>
      exact ⟨Finite.of_subsingleton, le_of_eq (Nat.card_unique.trans (pow_zero ℓ).symm)⟩
    | succ n ih =>
      obtain ⟨hf, hc⟩ := G1 (μs n) (τs n) (hexs n) hBfin ih.1
      refine ⟨hf, ?_⟩
      calc _ ≤ _ := hc
        _ ≤ ℓ * ℓ ^ n := Nat.mul_le_mul hBc ih.2
        _ = ℓ ^ (n + 1) := (pow_succ' ℓ n).symm

  have hsurj : ∀ (n : ℕ) (x : Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ n))) N),
      ∃ x' : Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ (n + 1)))) N,
        x'.comp (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerCast ℓ n)
          continuous_of_discreteTopology)) (add_zero N) = x := by
    intro n x
    exact Abelian.Ext.covariant_sequence_exact₃ P (hSES n) x rfl (hvan _)

  have hcard : ∀ n : ℕ, Nat.card (Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ n))) N) = ℓ ^ n := by
    intro n
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · exact Nat.card_unique.trans (pow_zero ℓ).symm
    · exact le_antisymm (hup n).2 (hge n hn (hup n).1)

  have hinj : ∀ n : ℕ, Function.Injective (μs n) := by
    intro n
    refine G2 (μs n) (τs n) ℓ (hexs n) ?_ (hup (n + 1)).1 hBfin hBc ?_
    · intro x
      obtain ⟨x', hx'⟩ := hsurj n x
      exact ⟨x', by rw [hτs]; exact hx'⟩
    · rw [hcard, hcard, pow_succ']

  have hC3 : ∀ (n M : ℕ), M + 1 = N →
      ∀ e : Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ n))) M,
        ∃ e' : Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ (n + 1)))) M,
          e'.comp (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerCast ℓ n)
            continuous_of_discreteTopology)) (add_zero M) = e := by
    intro n M hM e
    apply Abelian.Ext.covariant_sequence_exact₃ P (hSES n) e hM
    have hc : (hSES n).extClass.comp (Abelian.Ext.mk₀ (μ n)) (add_zero 1) = 0 :=
      (hSES n).extClass_comp
    apply hinj n
    rw [map_zero, hμs, Abelian.Ext.comp_assoc_of_third_deg_zero, hc, Abelian.Ext.comp_zero]
  exact ⟨fun n => ⟨(hup n).1, hcard n⟩, hsurj, hC3⟩

theorem wc_zmod_local_nakayama_cyclic : ∀ (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (P : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (N : ℕ), Finite (Abelian.Ext P (wcZModSheaf S ℓ) N) → Nat.card (Abelian.Ext P (wcZModSheaf S ℓ) N) ≤ ℓ → (∀ z : Abelian.Ext P (wcZModSheaf S ℓ) (N + 1), z = 0) → (∀ (n : ℕ) (x : Abelian.Ext P (wcZModSheaf S (ℓ ^ n)) N), ℓ ^ n • x = 0) → ∀ n : ℕ, ∃ y : Abelian.Ext P (wcZModSheaf S (ℓ ^ n)) N, ∀ x : Abelian.Ext P (wcZModSheaf S (ℓ ^ n)) N, ∃ k : ℤ, x = k • y :=
by
  intro S ℓ _ P N hfin hcard hvan hkill n
  have hsm : ∀ {Q M : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} {i : ℕ}
      (v : Abelian.Ext Q M i) (m : ℕ),
      v.comp (Abelian.Ext.mk₀ (m • 𝟙 M)) (add_zero i) = m • v := by
    intro Q M i v m
    induction m with
    | zero => rw [zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero, zero_nsmul]
    | succ k ih =>
      rw [succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih, Abelian.Ext.comp_mk₀_id,
        succ_nsmul]
  cases n with
  | zero =>
    refine ⟨0, fun x => ⟨0, ?_⟩⟩
    have e : x = 0 :=
      calc x = 1 • x := (one_nsmul x).symm
        _ = ℓ ^ 0 • x := (congrArg (fun m : ℕ => m • x) (pow_zero ℓ)).symm
        _ = 0 := hkill 0 x
    rw [e, zero_smul]
  | succ k =>
    obtain ⟨f, g, f', p, hfg, hfp, hS₁, hS₂, hpf⟩ := wc_glc_zmod_ses S ℓ k
    let r : Abelian.Ext P (wcZModSheaf S (ℓ ^ (k + 1))) N →+ Abelian.Ext P (wcZModSheaf S ℓ) N :=
      AddMonoidHom.mk' (fun x => x.comp (Abelian.Ext.mk₀ g) (add_zero N))
        (fun a b => Abelian.Ext.add_comp _ _ _ _)
    have hr : ∀ x, r x = x.comp (Abelian.Ext.mk₀ g) (add_zero N) := fun x => rfl
    have hker : ∀ x, r x = 0 → ∃ w, x = ℓ • w := by
      intro x hx
      rw [hr] at hx
      obtain ⟨z₁, hz₁⟩ := Abelian.Ext.covariant_sequence_exact₂ P hS₁ x hx
      have hz₁' : z₁.comp (Abelian.Ext.mk₀ f) (add_zero N) = x := hz₁
      obtain ⟨z₂, hz₂⟩ := Abelian.Ext.covariant_sequence_exact₃ P hS₂ z₁ (n₁ := N + 1) rfl
        (hvan _)
      have hz₂' : z₂.comp (Abelian.Ext.mk₀ p) (add_zero N) = z₁ := hz₂
      refine ⟨z₂, ?_⟩
      rw [← hz₁', ← hz₂', Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
        hpf, hsm]
    have htor : ∀ x : Abelian.Ext P (wcZModSheaf S (ℓ ^ (k + 1))) N, ℓ ^ (k + 1) • x = 0 :=
      hkill (k + 1)
    have hstep : ∃ y : Abelian.Ext P (wcZModSheaf S (ℓ ^ (k + 1))) N, ∀ x, ∃ (c : ℤ)
        (w : Abelian.Ext P (wcZModSheaf S (ℓ ^ (k + 1))) N), x = c • y + ℓ • w := by
      by_cases h0 : ∀ x, r x = 0
      · refine ⟨0, fun x => ?_⟩
        obtain ⟨w, hw⟩ := hker x (h0 x)
        exact ⟨0, w, by rw [hw]; simp⟩
      · push_neg at h0
        obtain ⟨y, hy⟩ := h0
        refine ⟨y, fun x => ?_⟩
        have hord : addOrderOf (r y) ∣ ℓ ^ (k + 1) := by
          apply addOrderOf_dvd_of_nsmul_eq_zero
          have h1 := map_nsmul r (ℓ ^ (k + 1)) y
          rw [htor, map_zero] at h1
          exact h1.symm
        obtain ⟨j, _, hj'⟩ := (Nat.dvd_prime_pow (Fact.out : Nat.Prime ℓ)).mp hord
        have hj0 : j ≠ 0 := by
          rintro rfl
          rw [pow_zero, AddMonoid.addOrderOf_eq_one_iff] at hj'
          exact hy hj'
        have hle : Nat.card (Abelian.Ext P (wcZModSheaf S ℓ) N) ≤
            Nat.card (AddSubgroup.zmultiples (r y)) := by
          rw [Nat.card_zmultiples, hj']
          exact hcard.trans (Nat.le_self_pow hj0 ℓ)
        have htop := AddSubgroup.eq_top_of_le_card _ hle
        have hmem : r x ∈ AddSubgroup.zmultiples (r y) := by
          rw [htop]; exact AddSubgroup.mem_top _
        obtain ⟨c, hc⟩ := AddSubgroup.mem_zmultiples_iff.mp hmem
        have hz : r (x - c • y) = 0 := by rw [map_sub, map_zsmul, hc, sub_self]
        obtain ⟨w, hw⟩ := hker _ hz
        exact ⟨c, w, by rw [← hw]; abel⟩
    obtain ⟨y, hy⟩ := hstep
    have hiter : ∀ j : ℕ, ∀ x, ∃ (c : ℤ)
        (w : Abelian.Ext P (wcZModSheaf S (ℓ ^ (k + 1))) N), x = c • y + (ℓ ^ j) • w := by
      intro j
      induction j with
      | zero => intro x; exact ⟨0, x, by simp⟩
      | succ j ih =>
        intro x
        obtain ⟨c, w, hw⟩ := ih x
        obtain ⟨c', w', hw'⟩ := hy w
        refine ⟨c + ((ℓ ^ j : ℕ) : ℤ) * c', w', ?_⟩
        rw [hw, hw', smul_add, add_smul, mul_smul ((ℓ ^ j : ℕ) : ℤ) c' y, natCast_zsmul,
          pow_succ ℓ j, mul_smul (ℓ ^ j) ℓ w', add_assoc]
    refine ⟨y, fun x => ?_⟩
    obtain ⟨c, w, hw⟩ := hiter (k + 1) x
    exact ⟨c, by rw [hw, htor, add_zero]⟩

theorem ladic_tower_compatible_generators : ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (A : ℕ → Type*) [∀ n, AddCommGroup (A n)] (τ : ∀ n, A (n + 1) →+ A n), (∀ n, Finite (A n) ∧ Nat.card (A n) = ℓ ^ n) → (∀ n, ∃ y : A n, ∀ x : A n, ∃ k : ℤ, x = k • y) → (∀ n, Function.Surjective (τ n)) → ∃ g : ∀ n, A n, (∀ n, τ n (g (n + 1)) = g n) ∧ (∀ n (x : A n), ∃ k : ℤ, x = k • g n) ∧ (∀ n (k : ℤ), k • g n = 0 → (ℓ : ℤ) ^ n ∣ k) :=
by
  intro ℓ _ A _ τ hcard hcyc hsurj
  have hp : Nat.Prime ℓ := Fact.out
  have hord : ∀ n (y : A n), (∀ x : A n, ∃ k : ℤ, x = k • y) →
      ∀ k : ℤ, (k • y = 0 ↔ (ℓ : ℤ) ^ n ∣ k) := by
    intro n y hy k
    have h1 : addOrderOf y = Nat.card (A n) :=
      addOrderOf_eq_card_of_forall_mem_zmultiples (fun x => by
        obtain ⟨k, hk⟩ := hy x
        exact AddSubgroup.mem_zmultiples_iff.mpr ⟨k, hk.symm⟩)
    rw [← addOrderOf_dvd_iff_zsmul_eq_zero, h1, (hcard n).2, Nat.cast_pow]
  have hlift : ∀ n (c : A n), (∀ x : A n, ∃ k : ℤ, x = k • c) →
      ∃ b : A (n + 1), (∀ x : A (n + 1), ∃ k : ℤ, x = k • b) ∧ τ n b = c := by
    intro n c hc
    obtain ⟨y, hy⟩ := hcyc (n + 1)
    have hty : ∀ x : A n, ∃ k : ℤ, x = k • τ n y := by
      intro x
      obtain ⟨z, rfl⟩ := hsurj n x
      obtain ⟨k, rfl⟩ := hy z
      exact ⟨k, map_zsmul _ _ _⟩
    rcases n with _ | m
    · refine ⟨y, hy, ?_⟩
      have hs : Subsingleton (A 0) := by
        have h := (hcard 0).2
        rw [pow_zero] at h
        exact (Nat.card_eq_one_iff_unique.mp h).1
      exact Subsingleton.elim _ _
    · obtain ⟨a, ha⟩ := hty c
      obtain ⟨k, hk⟩ := hc (τ (m + 1) y)
      have hnd : ¬ (ℓ : ℤ) ∣ a := by
        rintro ⟨a', ha'⟩
        have h0 : (1 - k * a) • τ (m + 1) y = 0 := by
          rw [sub_smul, one_smul, mul_smul, ← ha, ← hk, sub_self]
        have h6 := (hord (m + 1) _ hty _).mp h0
        have h3 : (ℓ : ℤ) ∣ (ℓ : ℤ) ^ (m + 1) := dvd_pow_self _ (Nat.succ_ne_zero m)
        have h4 := h3.trans h6
        have h5 : (ℓ : ℤ) ∣ k * a := by
          rw [ha']
          exact Dvd.dvd.mul_left (dvd_mul_right _ _) _
        have h7 : (ℓ : ℤ) ∣ 1 := by
          have := dvd_add h4 h5
          simpa using this
        exact (Nat.prime_iff_prime_int.mp hp).not_dvd_one h7
      have hcop : IsCoprime ((ℓ : ℤ) ^ (m + 1 + 1)) a :=
        ((Nat.prime_iff_prime_int.mp hp).coprime_iff_not_dvd.mpr hnd).pow_left
      obtain ⟨u, v, huv⟩ := hcop
      have hy0 : ((ℓ : ℤ) ^ (m + 1 + 1)) • y = 0 := (hord (m + 1 + 1) y hy _).mpr dvd_rfl
      have hyv : y = v • (a • y) := by
        calc y = (1 : ℤ) • y := (one_smul _ _).symm
          _ = (u * (ℓ : ℤ) ^ (m + 1 + 1) + v * a) • y := by rw [huv]
          _ = v • (a • y) := by rw [add_smul, mul_smul, mul_smul, hy0, smul_zero, zero_add]
      refine ⟨a • y, ?_, ?_⟩
      · intro x
        obtain ⟨j, hj⟩ := hy x
        refine ⟨j * v, ?_⟩
        rw [mul_smul, ← hyv, hj]
      · rw [map_zsmul, ← ha]
  choose L hLgen hLτ using hlift
  let G : ∀ n, {y : A n // ∀ x : A n, ∃ k : ℤ, x = k • y} := fun n =>
    Nat.rec (motive := fun n => {y : A n // ∀ x : A n, ∃ k : ℤ, x = k • y})
      ⟨(hcyc 0).choose, (hcyc 0).choose_spec⟩
      (fun n g => ⟨L n g.1 g.2, hLgen n g.1 g.2⟩) n
  refine ⟨fun n => (G n).1, fun n => hLτ n (G n).1 (G n).2, fun n => (G n).2,
    fun n k hk => (hord n _ (G n).2 k).mp hk⟩

theorem wc_int_ext_procyclic_of_tower : ∀ (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (P : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (N : ℕ) (g : ∀ n : ℕ, Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ n))) N), (∀ n, (g (n + 1)).comp (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerCast ℓ n) continuous_of_discreteTopology)) (add_zero N) = g n) → (∀ (n : ℕ) (t : Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ n))) N), ∃ k : ℤ, t = k • g n) → (∀ (n : ℕ) (k : ℤ), k • g n = 0 → (ℓ : ℤ) ^ n ∣ k) → (∀ (n M : ℕ), M + 1 = N → ∀ e : Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ n))) M, ∃ e' : Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ (n + 1)))) M, e'.comp (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerCast ℓ n) continuous_of_discreteTopology)) (add_zero M) = e) → ∃ y₀ : Abelian.Ext P (wcIntSheaf S ℓ) N, ∀ w : Abelian.Ext P (wcIntSheaf S ℓ) N, ∃ a : ℤ_[ℓ], w = y₀.comp (Abelian.Ext.mk₀ (wcIntScalar S ℓ a)) (add_zero N) :=
by
  intro S ℓ _ P N g H1 H2 H3 H4
  classical
  have hℓpos : (0 : ℝ) < (ℓ : ℝ) := by exact_mod_cast (Fact.out : Nat.Prime ℓ).pos
  have hcongr : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B] (φ φ' : A →+ B)
      (e : φ = φ') (hφ : Continuous φ) (hφ' : Continuous φ'),
      wcContSheafMap S φ hφ = wcContSheafMap S φ' hφ' := by
    intro A B _ _ _ _ _ _ φ φ' e hφ hφ'
    subst e
    rfl

  have hc2 : ∀ {A B C D : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} {p : ℕ}
      (x : Abelian.Ext A B p) (f : B ⟶ C) (h : C ⟶ D),
      (x.comp (Abelian.Ext.mk₀ f) (add_zero p)).comp (Abelian.Ext.mk₀ h) (add_zero p) =
        x.comp (Abelian.Ext.mk₀ (f ≫ h)) (add_zero p) := by
    intro A B C D p x f h
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  have hsubmk : ∀ {A B : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (a b : A ⟶ B),
      Abelian.Ext.mk₀ (a - b) = Abelian.Ext.mk₀ a - Abelian.Ext.mk₀ b := by
    intro A B a b
    rw [sub_eq_add_neg, Abelian.Ext.mk₀_add, Abelian.Ext.mk₀_neg, ← sub_eq_add_neg]
  have hcompsub : ∀ {A B C : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} {p : ℕ}
      (α : Abelian.Ext A B p) (β₁ β₂ : Abelian.Ext B C 0),
      α.comp (β₁ - β₂) (add_zero p) = α.comp β₁ (add_zero p) - α.comp β₂ (add_zero p) := by
    intro A B C p α β₁ β₂
    rw [sub_eq_add_neg, Abelian.Ext.comp_add, Abelian.Ext.comp_neg, ← sub_eq_add_neg]
  have hsubcomp : ∀ {A B C : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} {p : ℕ}
      (α₁ α₂ : Abelian.Ext A B p) (β : Abelian.Ext B C 0),
      (α₁ - α₂).comp β (add_zero p) = α₁.comp β (add_zero p) - α₂.comp β (add_zero p) := by
    intro A B C p α₁ α₂ β
    rw [sub_eq_add_neg, Abelian.Ext.add_comp, Abelian.Ext.neg_comp, ← sub_eq_add_neg]

  obtain ⟨hci, hemb, hcs, hker, hsec⟩ := wc_padic_tower_facts ℓ
  obtain ⟨hz2, hS2⟩ := wc_contSheaf_shortExact S (wcTowerIncl ℓ) hci
    (wcTowerShift ℓ) hcs hemb hker hsec
  haveI := wc_proet_products_exact S
  have hY := (wc_contSheaf_pi_isLimit S (fun n => ZMod (ℓ ^ n))).some
  have hprod := fun M => wc_ext_prod_bijective P
    (wcContSheaf S ((n : ℕ) → ZMod (ℓ ^ n))) (fun n => wcContSheaf S (ZMod (ℓ ^ n)))
    (fun n => wcContSheafMap S (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n)
      (continuous_apply n)) hY M
  have hTn : ∀ n, wcContSheafMap S (wcTowerShift ℓ) hcs ≫
      wcContSheafMap S (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n) =
      wcContSheafMap S (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n) -
      wcContSheafMap S (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1))
        (continuous_apply (n + 1)) ≫
      wcContSheafMap S (wcTowerCast ℓ n) continuous_of_discreteTopology := by
    intro n
    have e1 := (wc_contSheafMap_comp_sub S (wcTowerShift ℓ) (wcTowerShift ℓ) hcs
      hcs (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n)).1
    have e2 := (wc_contSheafMap_comp_sub S
      (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1))
      (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1)) (continuous_apply (n + 1))
      (continuous_apply (n + 1)) (wcTowerCast ℓ n) continuous_of_discreteTopology).1
    have e3 := (wc_contSheafMap_comp_sub S
      (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n)
      ((wcTowerCast ℓ n).comp (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1)))
      (continuous_apply n)
      ((continuous_of_discreteTopology (f := ⇑(wcTowerCast ℓ n))).comp (continuous_apply (n + 1)))
      (AddMonoidHom.id (ZMod (ℓ ^ n))) continuous_id).2
    rw [← e1, ← e2, ← e3]
    exact hcongr _ _ (AddMonoidHom.ext fun a => rfl) _ _

  obtain ⟨red, hred⟩ : ∃ red : ∀ n, wcContSheaf S ℤ_[ℓ] ⟶ wcContSheaf S (ZMod (ℓ ^ n)),
      ∀ n, red n = wcContSheafMap S (wcTowerIncl ℓ) hci ≫
        wcContSheafMap S (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n) :=
    ⟨_, fun n => rfl⟩
  have hR1 : ∀ n, red (n + 1) ≫ wcContSheafMap S (wcTowerCast ℓ n) continuous_of_discreteTopology =
      red n := by
    intro n
    have h0 : wcContSheafMap S (wcTowerIncl ℓ) hci ≫ (wcContSheafMap S (wcTowerShift ℓ) hcs ≫
        wcContSheafMap S (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n)) =
        0 := by
      rw [← Category.assoc, hz2, Limits.zero_comp]
    rw [hTn n, Preadditive.comp_sub, sub_eq_zero] at h0
    rw [hred, hred, Category.assoc]
    exact h0.symm
  have hE : wcIntSheaf S ℓ = wcContSheaf S ℤ_[ℓ] := rfl
  have hR2 : ∀ n, wcIntScalar S ℓ ((ℓ : ℤ_[ℓ]) ^ n) ≫ eqToHom hE ≫ red n = 0 := by
    intro n
    have hρc : Continuous (PadicInt.toZModPow (p := ℓ) n) := by
      rw [continuous_discrete_rng]
      intro b
      rw [Metric.isOpen_iff]
      intro y hy
      refine ⟨(ℓ : ℝ) ^ (-(n : ℤ)), zpow_pos hℓpos _, ?_⟩
      intro z hz
      rw [Metric.mem_ball, dist_eq_norm] at hz
      have h1 : z - y ∈ Ideal.span {(ℓ : ℤ_[ℓ]) ^ n} :=
        (PadicInt.norm_le_pow_iff_mem_span_pow _ _).mp hz.le
      rw [← PadicInt.ker_toZModPow, RingHom.mem_ker, map_sub, sub_eq_zero] at h1
      simp only [Set.mem_preimage, Set.mem_singleton_iff] at hy ⊢
      rw [h1, hy]
    have e1 : red n = wcContSheafMap S (PadicInt.toZModPow (p := ℓ) n).toAddMonoidHom hρc := by
      rw [hred, ← (wc_contSheafMap_comp_sub S (wcTowerIncl ℓ) (wcTowerIncl ℓ) hci hci
        (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n)).1]
      exact hcongr _ _ (AddMonoidHom.ext fun a => rfl) _ _
    rw [e1]
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro t0
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    change PadicInt.toZModPow n ((ℓ : ℤ_[ℓ]) ^ n * (ULift.down t0 :
      C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), ℤ_[ℓ])) t) = 0
    rw [map_mul, map_pow, map_natCast, ← Nat.cast_pow, ZMod.natCast_self, zero_mul]

  have hdetect : ∀ (i : ℕ), (∀ (n M : ℕ), M + 1 = i →
      ∀ e : Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ n))) M,
        ∃ e' : Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ (n + 1)))) M,
          e'.comp (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerCast ℓ n)
            continuous_of_discreteTopology)) (add_zero M) = e) →
      ∀ x : Abelian.Ext P (wcContSheaf S ℤ_[ℓ]) i,
        (∀ n, x.comp (Abelian.Ext.mk₀ (red n)) (add_zero i) = 0) → x = 0 := by
    intro i hML x hx
    have hxf : x.comp (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerIncl ℓ) hci)) (add_zero i) = 0 := by
      apply (hprod i).1
      intro n
      rw [hc2, ← hred]
      exact hx n
    clear hx
    cases i with
    | zero =>
      haveI : Mono (wcContSheafMap S (wcTowerIncl ℓ) hci) := hS2.mono_f
      apply Abelian.Ext.postcomp_mk₀_injective_of_mono P (wcContSheafMap S (wcTowerIncl ℓ) hci)
      rw [map_zero]
      exact hxf
    | succ k =>
      obtain ⟨z, hz⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hS2 x hxf (n₀ := k) rfl
      choose lift hlift using fun (n : ℕ) (e : Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ n))) k) =>
        hML n k rfl e
      obtain ⟨v, -, hvs⟩ : ∃ v : ∀ n, Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ n))) k, v 0 = 0 ∧
          ∀ n, v (n + 1) = lift n (v n - z.comp (Abelian.Ext.mk₀
            (wcContSheafMap S (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n)
              (continuous_apply n))) (add_zero k)) :=
        ⟨fun n => Nat.rec (motive := fun n => Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ n))) k) 0
          (fun n vn => lift n (vn - z.comp (Abelian.Ext.mk₀
            (wcContSheafMap S (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n)
              (continuous_apply n))) (add_zero k))) n, rfl, fun n => rfl⟩
      have hv : ∀ n, z.comp (Abelian.Ext.mk₀
          (wcContSheafMap S (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n)))
          (add_zero k) = v n - (v (n + 1)).comp (Abelian.Ext.mk₀
            (wcContSheafMap S (wcTowerCast ℓ n) continuous_of_discreteTopology)) (add_zero k) := by
        intro n
        rw [hvs n, hlift, sub_sub_cancel]
      obtain ⟨W, hW⟩ := (hprod k).2 v
      have hWg : W.comp (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerShift ℓ) hcs))
          (add_zero k) = z := by
        rw [← sub_eq_zero]
        apply (hprod k).1
        intro n
        rw [hsubcomp, hc2, hTn n, hsubmk, hcompsub, ← hc2, hW, hW, hv n, sub_self]
      have hce : (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerShift ℓ) hcs)).comp
          hS2.extClass (zero_add 1) = 0 := hS2.comp_extClass
      rw [← hz, ← hWg, Abelian.Ext.comp_assoc _ _ _ (add_zero k) (zero_add 1) (by omega), hce,
        Abelian.Ext.comp_zero]

  obtain ⟨G, hG⟩ := (hprod N).2 g
  have hGs : G.comp (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerShift ℓ) hcs)) (add_zero N) = 0 := by
    apply (hprod N).1
    intro n
    rw [hc2, hTn n, hsubmk, hcompsub, ← hc2, hG, hG, H1, sub_self]
  obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₂ P hS2 G hGs
  have hyred : ∀ n, y.comp (Abelian.Ext.mk₀ (red n)) (add_zero N) = g n := by
    intro n
    rw [hred, ← hc2, hy, hG]
  obtain ⟨redI, hredI⟩ : ∃ r : ∀ n, wcIntSheaf S ℓ ⟶ wcContSheaf S (ZMod (ℓ ^ n)),
      ∀ n, r n = eqToHom hE ≫ red n := ⟨_, fun n => rfl⟩
  obtain ⟨y₀, hy₀def⟩ : ∃ y₀ : Abelian.Ext P (wcIntSheaf S ℓ) N,
      y₀ = y.comp (Abelian.Ext.mk₀ (eqToHom hE.symm)) (add_zero N) := ⟨_, rfl⟩
  have hy₀ : ∀ n, y₀.comp (Abelian.Ext.mk₀ (redI n)) (add_zero N) = g n := by
    intro n
    rw [hy₀def, hc2, hredI, eqToHom_trans_assoc, eqToHom_refl, Category.id_comp, hyred]

  obtain ⟨hs1, hsmul, hsadd, -⟩ := wc_int_scalar_ring S ℓ
  obtain ⟨H, hHapp⟩ : ∃ H : ∀ n, ℤ_[ℓ] →+ Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ n))) N,
      ∀ n c, H n c = y₀.comp (Abelian.Ext.mk₀ (wcIntScalar S ℓ c ≫ redI n)) (add_zero N) :=
    ⟨fun n => AddMonoidHom.mk'
      (fun c => y₀.comp (Abelian.Ext.mk₀ (wcIntScalar S ℓ c ≫ redI n)) (add_zero N))
      (fun c d => by
        rw [hsadd, Preadditive.add_comp, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add]),
      fun n c => rfl⟩
  have hH1 : ∀ n, H n 1 = g n := by
    intro n
    rw [hHapp, hs1, Category.id_comp, hy₀]
  have hHk : ∀ n (j : ℤ), H n (j : ℤ_[ℓ]) = j • g n := by
    intro n j
    rw [← zsmul_one (R := ℤ_[ℓ]) j, map_zsmul, hH1]
  have hHl : ∀ n (c : ℤ_[ℓ]), H n ((ℓ : ℤ_[ℓ]) ^ n * c) = 0 := by
    intro n c
    rw [hHapp, hsmul, Category.assoc, hredI, hR2, Limits.comp_zero, Abelian.Ext.mk₀_zero,
      Abelian.Ext.comp_zero]
  have hpz : ∀ n (j : ℤ) (t : Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ (n + 1)))) N),
      (j • t).comp (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerCast ℓ n)
        continuous_of_discreteTopology)) (add_zero N) =
      j • t.comp (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerCast ℓ n)
        continuous_of_discreteTopology)) (add_zero N) := by
    intro n j t
    exact map_zsmul ((Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerCast ℓ n)
      continuous_of_discreteTopology)).postcomp P (add_zero N)) j t
  have hback : ∀ x : Abelian.Ext P (wcIntSheaf S ℓ) N,
      x = (x.comp (Abelian.Ext.mk₀ (eqToHom hE)) (add_zero N)).comp
        (Abelian.Ext.mk₀ (eqToHom hE.symm)) (add_zero N) := by
    intro x
    rw [hc2, eqToHom_trans, eqToHom_refl, Abelian.Ext.comp_mk₀_id]

  refine ⟨y₀, fun w => ?_⟩
  choose k hk using fun n => H2 n (w.comp (Abelian.Ext.mk₀ (redI n)) (add_zero N))
  have hcompat : ∀ n, w.comp (Abelian.Ext.mk₀ (redI n)) (add_zero N) =
      (w.comp (Abelian.Ext.mk₀ (redI (n + 1))) (add_zero N)).comp (Abelian.Ext.mk₀
        (wcContSheafMap S (wcTowerCast ℓ n) continuous_of_discreteTopology)) (add_zero N) := by
    intro n
    rw [hc2, hredI, hredI, Category.assoc, hR1]
  have hdvd : ∀ n, (ℓ : ℤ) ^ n ∣ k (n + 1) - k n := by
    intro n
    apply H3
    have e : k n • g n = k (n + 1) • g n := by
      rw [← hk n, hcompat n, hk (n + 1), hpz, H1]
    rw [sub_zsmul, ← e, add_neg_cancel]
  have hb : wcTowerShift ℓ (fun n => ((k n : ℤ) : ZMod (ℓ ^ n))) = 0 := by
    funext n
    show ((k n : ℤ) : ZMod (ℓ ^ n)) -
      wcTowerCast ℓ n ((k (n + 1) : ℤ) : ZMod (ℓ ^ (n + 1))) = 0
    rw [sub_eq_zero]
    change _ = (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ n)) (ZMod (ℓ ^ n)))
      ((k (n + 1) : ℤ) : ZMod (ℓ ^ (n + 1)))
    rw [map_intCast, ZMod.intCast_eq_intCast_iff_dvd_sub]
    push_cast
    exact hdvd n
  obtain ⟨a, ha⟩ := (hker _).mp hb
  have ha' : ∀ n, PadicInt.toZModPow n a = ((k n : ℤ) : ZMod (ℓ ^ n)) := fun n => congrFun ha n
  have hcn : ∀ n, ∃ c : ℤ_[ℓ], a = (k n : ℤ_[ℓ]) + (ℓ : ℤ_[ℓ]) ^ n * c := by
    intro n
    have hmem : a - (k n : ℤ_[ℓ]) ∈ RingHom.ker (PadicInt.toZModPow (p := ℓ) n) := by
      rw [RingHom.mem_ker, map_sub, map_intCast, ha' n, sub_self]
    rw [PadicInt.ker_toZModPow, Ideal.mem_span_singleton'] at hmem
    obtain ⟨c, hc'⟩ := hmem
    exact ⟨c, by rw [mul_comm, hc']; ring⟩
  have hHa : ∀ n, H n a = k n • g n := by
    intro n
    obtain ⟨c, hcd⟩ := hcn n
    rw [hcd, map_add, hHk, hHl, add_zero]
  refine ⟨a, ?_⟩
  have hx'0 := hdetect N H4 ((w - y₀.comp (Abelian.Ext.mk₀ (wcIntScalar S ℓ a)) (add_zero N)).comp
      (Abelian.Ext.mk₀ (eqToHom hE)) (add_zero N)) (by
    intro n
    rw [hc2, ← hredI, hsubcomp, hk n, hc2, ← hHapp, hHa n, sub_self])
  have hx0 : w - y₀.comp (Abelian.Ext.mk₀ (wcIntScalar S ℓ a)) (add_zero N) = 0 := by
    rw [hback (w - y₀.comp (Abelian.Ext.mk₀ (wcIntScalar S ℓ a)) (add_zero N)), hx'0,
      Abelian.Ext.zero_comp]
  exact sub_eq_zero.mp hx0

theorem proet_free_coker_ladic_rationalization : ∀ (S : Scheme.{u}) (U V : S.ProEt) (g : V ⟶ U) [CompactSpace U.left] [QuasiSeparatedSpace U.left] [CompactSpace V.left] [QuasiSeparatedSpace V.left] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], Mono (wcFreeSheafMap S g) → ∀ (i : ℕ) (x : Abelian.Ext (Limits.cokernel (wcFreeSheafMap S g)) (wcLadicSheaf S ℓ) i), ∃ (n : ℕ) (y : Abelian.Ext (Limits.cokernel (wcFreeSheafMap S g)) (wcIntSheaf S ℓ) i), ℓ ^ n • x = y.comp (Abelian.Ext.mk₀ (wcIntToLadic S ℓ)) (add_zero i) :=
by
  intro S U V g _ _ _ _ ℓ _ hmono i x
  have nsmul_comp : ∀ {X Y Z : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} {a b c : ℕ}
      (α : Abelian.Ext X Y a) (β : Abelian.Ext Y Z b)
      (h : a + b = c) (m : ℕ), (m • α).comp β h = m • α.comp β h := by
    intro X Y Z a b c α β h m
    induction m with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.zero_comp]
    | succ m ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.add_comp, ih]
  have comp_nsmul : ∀ {X Y Z : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} {a b c : ℕ}
      (α : Abelian.Ext X Y a) (β : Abelian.Ext Y Z b)
      (h : a + b = c) (m : ℕ), α.comp (m • β) h = m • α.comp β h := by
    intro X Y Z a b c α β h m
    induction m with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.comp_zero]
    | succ m ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.comp_add, ih]
  have sub_comp : ∀ {X Y Z : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} {a b c : ℕ}
      (α α' : Abelian.Ext X Y a) (β : Abelian.Ext Y Z b)
      (h : a + b = c), (α - α').comp β h = α.comp β h - α'.comp β h := by
    intro X Y Z a b c α α' β h
    rw [sub_eq_add_neg, Abelian.Ext.add_comp, Abelian.Ext.neg_comp, ← sub_eq_add_neg]
  have comp_sub : ∀ {X Y Z : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} {a b c : ℕ}
      (α : Abelian.Ext X Y a) (β β' : Abelian.Ext Y Z b)
      (h : a + b = c), α.comp (β - β') h = α.comp β h - α.comp β' h := by
    intro X Y Z a b c α β β' h
    rw [sub_eq_add_neg, Abelian.Ext.comp_add, Abelian.Ext.comp_neg, ← sub_eq_add_neg]
  have hS₀ : (ShortComplex.mk (wcFreeSheafMap S g) (Limits.cokernel.π (wcFreeSheafMap S g))
      (Limits.cokernel.condition (wcFreeSheafMap S g))).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel (wcFreeSheafMap S g)) hmono
      inferInstance

  obtain ⟨n₁, y', hy'⟩ := (proet_qcqs_ladic_rationalization S U ℓ i).1
    ((Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap S g))).comp x (zero_add i))

  have ha : ((Abelian.Ext.mk₀ (wcFreeSheafMap S g)).comp y' (zero_add i)).comp
      (Abelian.Ext.mk₀ (wcIntToLadic S ℓ)) (add_zero i) = 0 := by
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, ← hy', comp_nsmul,
      ← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
      Limits.cokernel.condition, Abelian.Ext.mk₀_zero, Abelian.Ext.zero_comp, smul_zero]
  obtain ⟨r, hr⟩ := (proet_qcqs_ladic_rationalization S V ℓ i).2 _ ha

  have h0 : (Abelian.Ext.mk₀ (wcFreeSheafMap S g)).comp (ℓ ^ r • y') (zero_add i) = 0 := by
    rw [comp_nsmul]; exact hr
  obtain ⟨w, hw⟩ := Abelian.Ext.contravariant_sequence_exact₂ hS₀ (wcIntSheaf S ℓ) (ℓ ^ r • y') h0

  have hD : (Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap S g))).comp
      (w.comp (Abelian.Ext.mk₀ (wcIntToLadic S ℓ)) (add_zero i) - ℓ ^ (r + n₁) • x)
      (zero_add i) = 0 := by
    rw [comp_sub, comp_nsmul, ← Abelian.Ext.comp_assoc_of_third_deg_zero]
    erw [hw]
    rw [nsmul_comp, ← hy', smul_smul, ← pow_add, sub_self]
  cases i with
  | zero =>
    refine ⟨r + n₁, w, ?_⟩
    have hinj := Abelian.Ext.precomp_mk₀_injective_of_epi (wcLadicSheaf S ℓ)
      (Limits.cokernel.π (wcFreeSheafMap S g))
    have : w.comp (Abelian.Ext.mk₀ (wcIntToLadic S ℓ)) (add_zero 0) - ℓ ^ (r + n₁) • x = 0 := by
      apply hinj
      rw [map_zero]
      exact hD
    exact (sub_eq_zero.mp this).symm
  | succ i₀ =>
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS₀ (wcLadicSheaf S ℓ) _ hD
      (show 1 + i₀ = i₀ + 1 by omega)
    obtain ⟨n₂, e, he⟩ := (proet_qcqs_ladic_rationalization S V ℓ i₀).1 x₁
    refine ⟨n₂ + (r + n₁),
      ℓ ^ n₂ • w - hS₀.extClass.comp e (show 1 + i₀ = i₀ + 1 by omega), ?_⟩
    rw [sub_comp, nsmul_comp, Abelian.Ext.comp_assoc_of_third_deg_zero, ← he, comp_nsmul, hx₁,
      smul_sub, sub_sub_cancel, smul_smul, ← pow_add]

theorem wc_xbar_point_local_ext_cyclic (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (O : (wcXbar F X).Opens) (x : wcXbar F X) (hO : (O : Set (wcXbar F X)) = {x}ᶜ) :
    ∃ y : Abelian.Ext (Limits.cokernel (wcFreeSheafMap (wcXbar F X)
        (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 (wcXbar F X)))))
        (wcLadicSheaf (wcXbar F X) ℓ) (2 * d),
      ∀ z : Abelian.Ext (Limits.cokernel (wcFreeSheafMap (wcXbar F X)
          (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
            Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 (wcXbar F X)))))
          (wcLadicSheaf (wcXbar F X) ℓ) (2 * d),
        ∃ c : ℚ_[ℓ], z = y.comp (Abelian.Ext.mk₀ (wcLadicScalar (wcXbar F X) ℓ c)) (add_zero _) :=
by
  classical
  set P := Limits.cokernel (wcFreeSheafMap (wcXbar F X)
    (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
      Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 (wcXbar F X)))) with hP

  haveI : IsProper (wcPi2 F X) := by unfold wcPi2; infer_instance
  haveI : SmoothOfRelativeDimension d (wcPi2 F X) := by
    unfold wcPi2
    haveI := smoothOfRelativeDimension_isStableUnderBaseChange d
    exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension d)
      (IsPullback.of_hasPullback X.hom _) inferInstance
  have hℓK : ((ℓ : ℕ) : AlgebraicClosure F) ≠ 0 := by
    intro h
    have hF : ((ℓ : ℕ) : F) = 0 := by
      apply (algebraMap F (AlgebraicClosure F)).injective
      rw [map_natCast, map_zero]
      exact h
    have hcop : Nat.Coprime ℓ (Nat.card F) :=
      (Nat.Prime.coprime_iff_not_dvd (Fact.out : Nat.Prime ℓ)).mpr hℓ
    have hb := Nat.gcd_eq_gcd_ab ℓ (Nat.card F)
    rw [hcop.gcd_eq_one, Nat.cast_one] at hb
    have hc : ((Nat.card F : ℕ) : F) = 0 := by
      haveI := Fintype.ofFinite F
      rw [Nat.card_eq_fintype_card]
      exact FiniteField.cast_card_eq_zero F
    have hb' := congrArg (Int.cast : ℤ → F) hb
    push_cast at hb'
    rw [hF, hc] at hb'
    simp at hb'

  obtain ⟨hfin1, hcard1⟩ := wc_lpgi_smooth_point_local_card_le (AlgebraicClosure F) (wcXbar F X)
    (wcPi2 F X) d ℓ hℓK O x hO
  have hvan := wc_xbar_local_zmod_succ_vanish F X d ℓ hℓ O x hO
  have hge := wc_xbar_local_zmod_card_ge F X d ℓ hℓ O x hO

  obtain ⟨hcnt, hsN, hsM⟩ := wc_local_tower_counts (wcXbar F X) ℓ P (2 * d) hfin1 hcard1 hvan hge

  have hkill : ∀ (n : ℕ) (t : Abelian.Ext P (wcZModSheaf (wcXbar F X) (ℓ ^ n)) (2 * d)),
      ℓ ^ n • t = 0 := by
    intro n t
    have hc' : Nat.card (Abelian.Ext P (wcZModSheaf (wcXbar F X) (ℓ ^ n)) (2 * d)) = ℓ ^ n :=
      (hcnt n).2
    have h := card_nsmul_eq_zero' (G := Abelian.Ext P (wcZModSheaf (wcXbar F X) (ℓ ^ n)) (2 * d))
      (x := t)
    rw [hc'] at h
    exact h

  have hcyc := wc_zmod_local_nakayama_cyclic (wcXbar F X) ℓ P (2 * d) hfin1 hcard1 hvan hkill

  obtain ⟨g, hg1, hg2, hg3⟩ := ladic_tower_compatible_generators ℓ
    (fun n => Abelian.Ext P (wcContSheaf (wcXbar F X) (ZMod (ℓ ^ n))) (2 * d))
    (fun n => (Abelian.Ext.mk₀ (wcContSheafMap (wcXbar F X) (wcTowerCast ℓ n)
      continuous_of_discreteTopology)).postcomp P (add_zero (2 * d)))
    hcnt hcyc (fun n t => hsN n t)

  obtain ⟨y₀, hy₀⟩ := wc_int_ext_procyclic_of_tower (wcXbar F X) ℓ P (2 * d) g hg1 hg2 hg3 hsM

  haveI hXc : CompactSpace (wcXbar F X) := QuasiCompact.compactSpace_of_compactSpace (wcPi2 F X)
  haveI hXln : IsLocallyNoetherian (wcXbar F X) :=
    LocallyOfFiniteType.isLocallyNoetherian (wcPi2 F X)
  haveI hXqs : QuasiSeparatedSpace (wcXbar F X) := IsLocallyNoetherian.quasiSeparatedSpace
  haveI hOc : CompactSpace O.toScheme := QuasiCompact.compactSpace_of_compactSpace O.ι
  haveI hOln : IsLocallyNoetherian O.toScheme := isLocallyNoetherian_of_isOpenImmersion O.ι
  haveI hOqs : QuasiSeparatedSpace O.toScheme := IsLocallyNoetherian.quasiSeparatedSpace

  have hmono := wc_free_sheaf_map_mono (wcXbar F X) _ _
    (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
      Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 (wcXbar F X))) (IsOpenImmersion.mono O.ι)
  have hrat := @proet_free_coker_ladic_rationalization (wcXbar F X)
    (Scheme.ProEt.mk (𝟙 (wcXbar F X))) (Scheme.ProEt.mk O.ι)
    (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
      Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 (wcXbar F X))) hXc hXqs hOc hOqs ℓ _ hmono

  obtain ⟨hs1, hsmul, hsadd⟩ := wc_ladic_scalar_ring (wcXbar F X) ℓ
  have hi4 := (wc_int_scalar_ring (wcXbar F X) ℓ).2.2.2
  have hs0 : wcLadicScalar (wcXbar F X) ℓ 0 = 0 := by
    have h := hsadd 0 0
    rw [add_zero] at h
    exact add_left_cancel (h.symm.trans (add_zero _).symm)
  have hsnat : ∀ m : ℕ, wcLadicScalar (wcXbar F X) ℓ (m : ℚ_[ℓ]) = m • 𝟙 _ := by
    intro m
    induction m with
    | zero => rw [Nat.cast_zero, hs0, zero_nsmul]
    | succ k ih => rw [Nat.cast_succ, hsadd, ih, hs1, succ_nsmul]
  have hznat : ∀ (m : ℕ) (w : Abelian.Ext P (wcLadicSheaf (wcXbar F X) ℓ) (2 * d)),
      w.comp (Abelian.Ext.mk₀ (wcLadicScalar (wcXbar F X) ℓ (m : ℚ_[ℓ]))) (add_zero _) =
        m • w := by
    intro m w
    rw [hsnat m]
    induction m with
    | zero => rw [zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero, zero_nsmul]
    | succ k ih =>
      rw [succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih, Abelian.Ext.comp_mk₀_id,
        succ_nsmul]
  have e2 : ∀ {A B C' D' : Sheaf (Scheme.ProEt.topology (wcXbar F X)) AddCommGrpCat.{u+1}}
      (v : Abelian.Ext A B (2 * d)) (p : B ⟶ C') (q : C' ⟶ D'),
      (v.comp (Abelian.Ext.mk₀ p) (add_zero _)).comp (Abelian.Ext.mk₀ q) (add_zero _) =
        v.comp (Abelian.Ext.mk₀ (p ≫ q)) (add_zero _) := by
    intro A B C' D' v p q
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  refine ⟨y₀.comp (Abelian.Ext.mk₀ (wcIntToLadic (wcXbar F X) ℓ)) (add_zero _), fun z => ?_⟩
  obtain ⟨n, w, hw⟩ := hrat (2 * d) z
  obtain ⟨a, ha⟩ := hy₀ w
  have hℓ0 : ((ℓ : ℚ_[ℓ]) ^ n) ≠ 0 :=
    pow_ne_zero _ (Nat.cast_ne_zero.mpr (Fact.out : Nat.Prime ℓ).ne_zero)
  refine ⟨((ℓ : ℚ_[ℓ]) ^ n)⁻¹ * (a : ℚ_[ℓ]), ?_⟩
  have hya : (y₀.comp (Abelian.Ext.mk₀ (wcIntToLadic (wcXbar F X) ℓ)) (add_zero _)).comp
      (Abelian.Ext.mk₀ (wcLadicScalar (wcXbar F X) ℓ (a : ℚ_[ℓ]))) (add_zero _) = ℓ ^ n • z := by
    rw [e2, ← hi4, ← e2, ← ha, hw]
  have hz : z = (z.comp (Abelian.Ext.mk₀ (wcLadicScalar (wcXbar F X) ℓ ((ℓ ^ n : ℕ) : ℚ_[ℓ])))
      (add_zero _)).comp (Abelian.Ext.mk₀ (wcLadicScalar (wcXbar F X) ℓ (((ℓ : ℚ_[ℓ]) ^ n)⁻¹)))
      (add_zero _) := by
    rw [e2, ← hsmul, Nat.cast_pow, inv_mul_cancel₀ hℓ0, hs1, Abelian.Ext.comp_mk₀_id]
  rw [hsmul, ← e2, hya, ← hznat]
  exact hz

theorem wc_free_coker_module_ext_transfer (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (L : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⥤ SheafOfModules.{u+1} (wcRingSheaf S ℓ))
    (adj : L ⊣ SheafOfModules.toSheaf (wcRingSheaf S ℓ))
    [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L]
    (ε : L.obj (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S))) ≅ SheafOfModules.unit (wcRingSheaf S ℓ))
    {V : S.ProEt} (g : V ⟶ Scheme.ProEt.mk (𝟙 S)) (n : ℕ) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    ∃ Θ : Abelian.Ext (Limits.cokernel (L.map (wcFreeSheafMap S g) ≫ ε.hom))
        (SheafOfModules.unit (wcRingSheaf S ℓ)) n ≃+
      Abelian.Ext (Limits.cokernel (wcFreeSheafMap S g)) (wcLadicSheaf S ℓ) n,
      ∀ (c : ℚ_[ℓ]) (v : Abelian.Ext (Limits.cokernel (L.map (wcFreeSheafMap S g) ≫ ε.hom))
          (SheafOfModules.unit (wcRingSheaf S ℓ)) n),
        Θ (v.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero n)) =
          (Θ v).comp (Abelian.Ext.mk₀ (wcLadicScalar S ℓ c)) (add_zero n) :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
  classical

  have hGC := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.ProEt.topology S)
    (wcRingSheaf S ℓ)

  let φ : L.obj (Limits.cokernel (wcFreeSheafMap S g)) ≅
      Limits.cokernel (L.map (wcFreeSheafMap S g) ≫ ε.hom) :=
    Limits.PreservesCokernel.iso L (wcFreeSheafMap S g) ≪≫
      (Limits.cokernelCompIsIso (L.map (wcFreeSheafMap S g)) ε.hom).symm
  let ε' : Limits.cokernel (wcFreeSheafMap S g) ⟶
      (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)).obj
        (Limits.cokernel (L.map (wcFreeSheafMap S g) ≫ ε.hom)) :=
    adj.unit.app _ ≫ (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)).map φ.hom
  have Hε : ∀ M : SheafOfModules.{u+1} (wcRingSheaf S ℓ),
      Function.Bijective (fun h : Limits.cokernel (L.map (wcFreeSheafMap S g) ≫ ε.hom) ⟶ M =>
        ε' ≫ (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)).map h) := by
    intro M
    have hfun : (fun h : Limits.cokernel (L.map (wcFreeSheafMap S g) ≫ ε.hom) ⟶ M =>
        ε' ≫ (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)).map h) =
        (adj.homEquiv _ M) ∘ (fun h => φ.hom ≫ h) := by
      funext h
      show (adj.unit.app _ ≫ (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)).map φ.hom) ≫
          (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)).map h = adj.homEquiv _ M (φ.hom ≫ h)
      rw [Adjunction.homEquiv_unit, Functor.map_comp, Category.assoc]
    rw [hfun]
    refine (adj.homEquiv _ M).bijective.comp ?_
    refine ⟨fun a b hab => (cancel_epi φ.hom).mp hab, fun k => ⟨φ.inv ≫ k, ?_⟩⟩
    show φ.hom ≫ φ.inv ≫ k = k
    rw [Iso.hom_inv_id_assoc]

  let G1 := (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)).obj
    (SheafOfModules.unit (wcRingSheaf S ℓ))
  let eV : ∀ V : (S.ProEt)ᵒᵖ, G1.obj.obj V ≅ (wcLadicSheaf S ℓ).obj.obj V := fun V =>
    { hom := AddCommGrpCat.ofHom
        { toFun := fun r => (ULift.up ((ContinuousMap.mk ULift.down continuous_uliftDown).comp
              (r : C(↥V.unop.left, ULift.{u+1} ℚ_[ℓ]))) :
              ULift.{u+1} C(↥V.unop.left, ℚ_[ℓ]))
          map_zero' := ULift.ext _ _ (ContinuousMap.ext fun _ => rfl)
          map_add' := fun _ _ => ULift.ext _ _ (ContinuousMap.ext fun _ => rfl) }
      inv := AddCommGrpCat.ofHom
        { toFun := fun w => ((ContinuousMap.mk ULift.up continuous_uliftUp).comp
              (w.down : C(↥V.unop.left, ℚ_[ℓ])) : C(↥V.unop.left, ULift.{u+1} ℚ_[ℓ]))
          map_zero' := ContinuousMap.ext fun _ => rfl
          map_add' := fun _ _ => ContinuousMap.ext fun _ => rfl }
      hom_inv_id := by
        apply AddCommGrpCat.ext
        intro r
        rfl
      inv_hom_id := by
        apply AddCommGrpCat.ext
        intro w
        rfl }
  let NI : G1.obj ≅ (wcLadicSheaf S ℓ).obj := NatIso.ofComponents eV (fun {V W} g => by
    apply AddCommGrpCat.ext
    intro r
    rfl)
  let ι : G1 ≅ wcLadicSheaf S ℓ := ObjectProperty.isoMk _ NI
  have I1 : ∀ c : ℚ_[ℓ], (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)).map
      (wcHMConst S ℓ c) ≫ ι.hom = ι.hom ≫ wcLadicScalar S ℓ c := by
    intro c
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext V
    apply AddCommGrpCat.ext
    intro r
    change (ULift.up ((ContinuousMap.mk ULift.down continuous_uliftDown).comp
        ((@id C(↥V.unop.left, ULift.{u+1} ℚ_[ℓ]) r) * ContinuousMap.const _ (ULift.up c))) :
          ULift.{u+1} C(↥V.unop.left, ℚ_[ℓ])) =
      ULift.up (c • (ContinuousMap.mk ULift.down continuous_uliftDown).comp
        (@id C(↥V.unop.left, ULift.{u+1} ℚ_[ℓ]) r))
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    show ((@id C(↥V.unop.left, ULift.{u+1} ℚ_[ℓ]) r) t).down * c =
      c * ((@id C(↥V.unop.left, ULift.{u+1} ℚ_[ℓ]) r) t).down
    exact mul_comm _ _

  obtain ⟨Φ, hΦ⟩ : ∃ Φ : Abelian.Ext (Limits.cokernel (L.map (wcFreeSheafMap S g) ≫ ε.hom))
        (SheafOfModules.unit (wcRingSheaf S ℓ)) n →+
        Abelian.Ext (Limits.cokernel (wcFreeSheafMap S g)) G1 n,
      ∀ β, Φ β = (Abelian.Ext.mk₀ ε').comp (Abelian.Ext.mapExactFunctor
        (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)) β) (zero_add n) :=
    ⟨AddMonoidHom.mk' (fun β => (Abelian.Ext.mk₀ ε').comp (Abelian.Ext.mapExactFunctor
        (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)) β) (zero_add n))
      (fun a b => by rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.comp_add]), fun _ => rfl⟩
  have hB : Function.Bijective Φ := by
    have e : (⇑Φ) = fun β => (Abelian.Ext.mk₀ ε').comp (Abelian.Ext.mapExactFunctor
        (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)) β) (zero_add n) := funext hΦ
    rw [e]
    exact ext_transfer_of_hom_bijective L (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ))
      adj (Limits.cokernel (wcFreeSheafMap S g))
      (Limits.cokernel (L.map (wcFreeSheafMap S g) ≫ ε.hom)) ε' Hε
      (SheafOfModules.unit (wcRingSheaf S ℓ)) n
  let Pe : Abelian.Ext (Limits.cokernel (wcFreeSheafMap S g)) G1 n ≃+
      Abelian.Ext (Limits.cokernel (wcFreeSheafMap S g)) (wcLadicSheaf S ℓ) n :=
    { toFun := fun z => z.comp (Abelian.Ext.mk₀ ι.hom) (add_zero n)
      invFun := fun z => z.comp (Abelian.Ext.mk₀ ι.inv) (add_zero n)
      left_inv := fun z => by
        change (z.comp (Abelian.Ext.mk₀ ι.hom) (add_zero n)).comp (Abelian.Ext.mk₀ ι.inv)
          (add_zero n) = z
        rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
          Abelian.Ext.comp_mk₀_id]
      right_inv := fun z => by
        change (z.comp (Abelian.Ext.mk₀ ι.inv) (add_zero n)).comp (Abelian.Ext.mk₀ ι.hom)
          (add_zero n) = z
        rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
          Abelian.Ext.comp_mk₀_id]
      map_add' := fun a b => Abelian.Ext.add_comp _ _ _ _ }
  refine ⟨(AddEquiv.ofBijective Φ hB).trans Pe, fun c v => ?_⟩
  change (Φ (v.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero n))).comp
      (Abelian.Ext.mk₀ ι.hom) (add_zero n) =
    ((Φ v).comp (Abelian.Ext.mk₀ ι.hom) (add_zero n)).comp
      (Abelian.Ext.mk₀ (wcLadicScalar S ℓ c)) (add_zero n)
  have e2 : Φ (v.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero n)) =
      (Φ v).comp (Abelian.Ext.mk₀
        ((SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)).map (wcHMConst S ℓ c))) (add_zero n) := by
    rw [hΦ, hΦ, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
    exact (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).symm
  rw [e2, Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.comp_assoc_of_third_deg_zero,
    Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, I1]

theorem wc_point_supp_ext_line (F : Type u) [Finite F] [Field F]
    (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    {Z : Scheme.{u}} (a : Z ⟶ wcXbar F X) (ha : IsIso (a ≫ wcPi2 F X))
    (Da : wcHMPullData a ℓ) (hDa : wcHMPullCanonical Da) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcXbar F X) ℓ)) := HasExt.standard _
    ∀ v w : wcSuppExt Da (2 * d), v ≠ 0 →
      ∃ c : ℚ_[ℓ], w = v.comp (Abelian.Ext.mk₀ (wcHMConst (wcXbar F X) ℓ c)) (add_zero _) :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcXbar F X) ℓ)) := HasExt.standard _
  intro v w hv

  have key : ∀ (c : ℚ_[ℓ]) (U : ((wcXbar F X).ProEt)ᵒᵖ)
      (x : ((wcLadicSheaf (wcXbar F X) ℓ).obj.obj U : Type (u+1))),
      (wcLadicScalar (wcXbar F X) ℓ c).hom.app U x =
        (ULift.up (c • (ULift.down x : C(↥((Scheme.ProEt.forget (wcXbar F X) ⋙
          Over.forget (wcXbar F X)).obj (Opposite.unop U)), ℚ_[ℓ]))) : _) := by
    intro c U x
    rfl
  have hscmul : ∀ a b : ℚ_[ℓ], wcLadicScalar (wcXbar F X) ℓ a ≫ wcLadicScalar (wcXbar F X) ℓ b =
      wcLadicScalar (wcXbar F X) ℓ (b * a) := by
    intro a b
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply,
      key, key, key]
    exact congrArg ULift.up (mul_smul b a _).symm
  have hsc0 : wcLadicScalar (wcXbar F X) ℓ 0 = 0 := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [key]
    apply ULift.ext
    apply ContinuousMap.ext
    intro p
    exact zero_smul ℚ_[ℓ] _

  have htf : ∀ (V : ((wcXbar F X).ProEt)ᵒᵖ) (k : ℕ)
      (r : ↑((wcRingSheaf (wcXbar F X) ℓ).obj.obj V)), k ≠ 0 → k • r = 0 → r = 0 := by
    intro V k r hk hr
    have hc : ((k : ℕ) : ℚ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr hk
    have key2 : ∀ {T : Type u} [TopologicalSpace T] (a : C(T, ULift.{u+1} ℚ_[ℓ])),
        k • a = 0 → a = 0 := by
      intro T _ a h
      refine ContinuousMap.ext fun t => ULift.ext _ _ ?_
      have h1 : k • (a t).down = 0 :=
        congrArg (fun g : C(T, ULift.{u+1} ℚ_[ℓ]) => (g t).down) h
      rw [nsmul_eq_mul] at h1
      exact (mul_eq_zero.mp h1).resolve_left hc
    exact key2 (T := ↥((Scheme.ProEt.forget (wcXbar F X) ⋙ Over.forget (wcXbar F X)).obj
      (Opposite.unop V))) r hr
  obtain ⟨L, adj, hA, hL, hC⟩ := sheafOfModules_toSheaf_exact_left_adjoint_of_torsionFree
    (Scheme.ProEt.topology (wcXbar F X)) (wcRingSheaf (wcXbar F X) ℓ) htf
  haveI := hA
  haveI := hL
  haveI := hC

  haveI := ha
  have hinj : Function.Injective (a ≫ wcPi2 F X) := (a ≫ wcPi2 F X).isOpenEmbedding.injective
  have hZsub : ∀ z z' : Z, z = z' := fun z z' => hinj (Subsingleton.elim _ _)
  obtain ⟨z₀⟩ : Nonempty Z :=
    ⟨(inv (a ≫ wcPi2 F X)) (IsLocalRing.closedPoint (AlgebraicClosure F))⟩
  haveI : IsProper (wcPi2 F X) := by unfold wcPi2; infer_instance
  haveI : IsClosedImmersion a := IsClosedImmersion.of_comp a (wcPi2 F X)
  have hrange : Set.range a = ({a z₀} : Set (wcXbar F X)) := by
    ext y
    constructor
    · rintro ⟨z, rfl⟩
      rw [hZsub z z₀]
      exact Set.mem_singleton _
    · intro hy
      rw [Set.mem_singleton_iff] at hy
      exact ⟨z₀, hy.symm⟩
  have hcl : IsClosed ({a z₀} : Set (wcXbar F X)) := by
    have := a.isClosedEmbedding.isClosed_range
    rw [hrange] at this
    exact this
  let O : (wcXbar F X).Opens := ⟨({a z₀} : Set (wcXbar F X))ᶜ, hcl.isOpen_compl⟩
  have hO2 : (O : Set (wcXbar F X)) = {a z₀}ᶜ := rfl
  have hO1 : (O : Set (wcXbar F X)) = (Set.range a)ᶜ := by rw [hrange]; rfl

  obtain ⟨ε, hσρ, hex⟩ := wc_point_supp_kernel_free F X ℓ a ha Da hDa L adj O hO1
  haveI := wc_point_supp_unit_epi F X d ℓ a ha Da hDa
  have hc := hex.gIsCokernel
  let e := (Limits.cokernelIsCokernel _).coconePointUniqueUpToIso hc

  let Ψ := fun v' : wcSuppExt Da (2 * d) => (Abelian.Ext.mk₀ e.hom).comp v' (zero_add (2 * d))
  have hΨinj : Function.Injective Ψ := by
    intro v₁ v₂ h
    have k : ∀ v' : wcSuppExt Da (2 * d), (Abelian.Ext.mk₀ e.inv).comp (Ψ v') (zero_add _) = v' := by
      intro v'
      show (Abelian.Ext.mk₀ e.inv).comp ((Abelian.Ext.mk₀ e.hom).comp v' (zero_add _))
        (zero_add _) = v'
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add (2 * d)) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
    rw [← k v₁, ← k v₂, h]
  have hΨ0 : Ψ 0 = 0 := Abelian.Ext.comp_zero _ _ _ _ _
  have hΨc : ∀ (c : ℚ_[ℓ]) (v' : wcSuppExt Da (2 * d)),
      Ψ (v'.comp (Abelian.Ext.mk₀ (wcHMConst (wcXbar F X) ℓ c)) (add_zero _)) =
        (Ψ v').comp (Abelian.Ext.mk₀ (wcHMConst (wcXbar F X) ℓ c)) (add_zero _) := by
    intro c v'
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add _) (add_zero _) (by omega)).symm

  obtain ⟨Θ, hΘ⟩ := wc_free_coker_module_ext_transfer (wcXbar F X) ℓ L adj ε
    (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
      Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 (wcXbar F X))) (2 * d)

  obtain ⟨y, hy⟩ := wc_xbar_point_local_ext_cyclic F X d ℓ hℓ O (a z₀) hO2

  have hΦinj : ∀ v₁ v₂ : wcSuppExt Da (2 * d), Θ (Ψ v₁) = Θ (Ψ v₂) → v₁ = v₂ :=
    fun v₁ v₂ h => hΨinj (Θ.injective h)
  obtain ⟨α, hα⟩ := hy (Θ (Ψ v))
  obtain ⟨β, hβ⟩ := hy (Θ (Ψ w))
  have hα0 : α ≠ 0 := by
    rintro rfl
    apply hv
    apply hΦinj
    rw [hα, hsc0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero, hΨ0, map_zero]
  refine ⟨β / α, hΦinj _ _ ?_⟩
  rw [hΨc, hΘ, hα, hβ, Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
    hscmul, div_mul_cancel₀ _ hα0]

theorem wc_tl_zero_supp_line (F : Type u) [Finite F] [Field F] (d ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hℓ : ¬ ℓ ∣ Nat.card F)
    (D0 : wcHMPullData (wcTlZero F d) ℓ) (hD0 : wcHMPullCanonical D0) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcTlAff F d) ℓ)) := HasExt.standard _
    ∀ v w : wcSuppExt D0 (2 * d), v ≠ 0 →
      ∃ c : ℚ_[ℓ], w = v.comp (Abelian.Ext.mk₀ (wcHMConst (wcTlAff F d) ℓ c)) (add_zero _) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcTlAff F d) ℓ)) := HasExt.standard _
  intro v w hv

  have c3 : ∀ {T V T' V' : Scheme.{u}} {i : T ⟶ V} {i' : T' ⟶ V'} (f : V' ⟶ V)
      (D : wcHMPullData i ℓ) (D' : wcHMPullData i' ℓ)
      (Df : wcHMPullData f ℓ) (hDf : wcHMPullCanonical Df)
      (γ : wcSuppObj D' ⟶ Df.Φ.obj (wcSuppObj D)) (n : ℕ) (τ : wcSuppExt D n) (c : ℚ_[ℓ]),
      letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V ℓ)) := HasExt.standard _
      letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V' ℓ)) := HasExt.standard _
      (Abelian.Ext.mk₀ γ).comp (wcSuppPullExt D Df n
          (τ.comp (Abelian.Ext.mk₀ (wcHMConst V ℓ c)) (add_zero n))) (zero_add n) =
        ((Abelian.Ext.mk₀ γ).comp (wcSuppPullExt D Df n τ) (zero_add n)).comp
          (Abelian.Ext.mk₀ (wcHMConst V' ℓ c)) (add_zero n) := by
    intro T V T' V' i i' f D D' Df hDf γ n τ c
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V' ℓ)) := HasExt.standard _
    haveI := Df.additive
    haveI := Df.presLim
    haveI := Df.presColim
    have hk : Df.Φ.map (wcHMConst V ℓ c) ≫ Df.μ.hom = Df.μ.hom ≫ wcHMConst V' ℓ c := by
      rw [← wc_hm_pull_const Df hDf c, Iso.hom_inv_id_assoc]
    have e1 : (Abelian.Ext.mapExactFunctor Df.Φ
          (τ.comp (Abelian.Ext.mk₀ (wcHMConst V ℓ c)) (add_zero n))).comp
          (Abelian.Ext.mk₀ Df.μ.hom) (add_zero n) =
        ((Abelian.Ext.mapExactFunctor Df.Φ τ).comp (Abelian.Ext.mk₀ Df.μ.hom) (add_zero n)).comp
          (Abelian.Ext.mk₀ (wcHMConst V' ℓ c)) (add_zero n) := by
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.comp_assoc_of_third_deg_zero,
        Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, hk]
    show (Abelian.Ext.mk₀ γ).comp ((Abelian.Ext.mapExactFunctor Df.Φ
        (τ.comp (Abelian.Ext.mk₀ (wcHMConst V ℓ c)) (add_zero n))).comp
        (Abelian.Ext.mk₀ Df.μ.hom) (add_zero n)) (zero_add n) =
      ((Abelian.Ext.mk₀ γ).comp ((Abelian.Ext.mapExactFunctor Df.Φ τ).comp
        (Abelian.Ext.mk₀ Df.μ.hom) (add_zero n)) (zero_add n)).comp
        (Abelian.Ext.mk₀ (wcHMConst V' ℓ c)) (add_zero n)
    rw [e1]
    exact (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).symm

  have hAffGI : ∀ (K : Type u) [Field K] (σ : Type u),
      GeometricallyIrreducible (AffineSpace σ (Spec (.of K)) ↘ Spec (.of K)) := by
    intro K _ σ
    constructor
    intro K' _ y Z fst snd h
    let e2 : Z ≅ Spec (.of (MvPolynomial σ (CommRingCat.of K'))) :=
      h.isoIsPullback _ _ (AffineSpace.isPullback_map (n := σ) y) ≪≫
        AffineSpace.SpecIso σ (.of K')
    exact Function.Surjective.irreducibleSpace (Scheme.homeoOfIso e2.symm).continuous
      (Scheme.homeoOfIso e2.symm).surjective

  have hGI : GeometricallyIrreducible (wcProjKStr F d) := by
    obtain ⟨pt, -, hpt⟩ := wc_pp_rational_point F d
    refine wc_pp_geomIrred_of_charts (wcProjKStr F d)
      (fun a : Fin (d + 1) => @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) F) MvPolynomial.gradedAlgebra
        (MvPolynomial.X a)) 0 (wc_pp_basicOpen_cover F d) ?_ ?_
    · intro a
      obtain ⟨e, he⟩ := wc_pp_dehomogenize_ringEquiv F d a
      obtain ⟨φ, hφ⟩ := wc_pp_chart_iso F d a e he
      exact ⟨_, _, hAffGI F (ULift.{u} (Fin d)), φ, hφ⟩
    · have hmem : ∀ a : Fin (d + 1), pt (IsLocalRing.closedPoint F) ∈
          @Proj.basicOpen _ _ _ _ _
            (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) F) MvPolynomial.gradedAlgebra
            (MvPolynomial.X a) := by
        intro a
        have h1 : IsLocalRing.closedPoint F ∈ pt ⁻¹ᵁ (@Proj.basicOpen _ _ _ _ _
            (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) F) MvPolynomial.gradedAlgebra
            (MvPolynomial.X a)) := by
          rw [hpt a]; trivial
        exact h1
      intro a
      exact ⟨pt (IsLocalRing.closedPoint F), hmem a, hmem 0⟩

  haveI : IsProper (Over.mk (wcProjKStr F d)).hom := wc_proj_space_isProper F d
  haveI : SmoothOfRelativeDimension d (Over.mk (wcProjKStr F d)).hom := wc_proj_space_smooth F d
  haveI : GeometricallyIrreducible (Over.mk (wcProjKStr F d)).hom := hGI
  haveI : IsLocallyNoetherian (wcXbar F (Over.mk (wcProjKStr F d))) :=
    LocallyOfFiniteType.isLocallyNoetherian (wcPi2 F (Over.mk (wcProjKStr F d)))

  obtain ⟨e0, he0⟩ := wc_pp_dehomogenize_ringEquiv F d 0
  obtain ⟨φ0, hφ0⟩ := wc_pp_chart_iso F d 0 e0 he0
  have ho : (φ0.inv ≫ (@Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) F) MvPolynomial.gradedAlgebra
      (MvPolynomial.X 0)).ι) ≫ (Over.mk (wcProjKStr F d)).hom =
      AffineSpace (ULift.{u} (Fin d)) (Spec (.of F)) ↘ Spec (.of F) := by
    simp only [Over.mk_hom, wcProjKStr, Category.assoc]
    rw [hφ0, Iso.inv_hom_id_assoc]
  have hms := AffineSpace.isPullback_map (n := ULift.{u} (Fin d))
    (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
  have hcomm : (AffineSpace.map (ULift.{u} (Fin d))
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫
      (φ0.inv ≫ (@Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) F) MvPolynomial.gradedAlgebra
        (MvPolynomial.X 0)).ι)) ≫ (Over.mk (wcProjKStr F d)).hom =
      wcTlStr F d ≫ Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))) := by
    rw [Category.assoc, ho]
    exact hms.toCommSq.w
  obtain ⟨j, hj_def⟩ : ∃ j : wcTlAff F d ⟶ wcXbar F (Over.mk (wcProjKStr F d)),
      j = Limits.pullback.lift _ _ hcomm := ⟨_, rfl⟩
  have hjπ : j ≫ wcPi2 F (Over.mk (wcProjKStr F d)) = wcTlStr F d := by
    rw [hj_def]; exact Limits.pullback.lift_snd _ _ _
  have hjfst : j ≫ Limits.pullback.fst (Over.mk (wcProjKStr F d)).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
      AffineSpace.map (ULift.{u} (Fin d))
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫
      (φ0.inv ≫ (@Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) F) MvPolynomial.gradedAlgebra
        (MvPolynomial.X 0)).ι) := by
    rw [hj_def]; exact Limits.pullback.lift_fst _ _ _
  have hpbj : IsPullback j (AffineSpace.map (ULift.{u} (Fin d))
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
      (Limits.pullback.fst (Over.mk (wcProjKStr F d)).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
      (φ0.inv ≫ (@Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) F) MvPolynomial.gradedAlgebra
        (MvPolynomial.X 0)).ι) := by
    refine IsPullback.of_right (h₁₂ := wcPi2 F (Over.mk (wcProjKStr F d)))
      (h₂₂ := (Over.mk (wcProjKStr F d)).hom)
      (v₁₃ := Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ?_ hjfst
      (IsPullback.of_hasPullback _ _).flip
    rw [hjπ, ho]
    exact hms.flip
  haveI hjo : IsOpenImmersion j :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hpbj.flip inferInstance

  obtain ⟨i, hi_def⟩ : ∃ i : Spec (.of (AlgebraicClosure F)) ⟶
      wcXbar F (Over.mk (wcProjKStr F d)), i = wcTlZero F d ≫ j := ⟨_, rfl⟩
  have hi : i ≫ wcPi2 F (Over.mk (wcProjKStr F d)) = 𝟙 _ := by
    rw [hi_def, Category.assoc, hjπ]
    exact AffineSpace.homOfVector_over _ _
  haveI : IsClosedImmersion (i ≫ wcPi2 F (Over.mk (wcProjKStr F d))) := by
    rw [hi]; infer_instance
  haveI : IsClosedImmersion i := IsClosedImmersion.of_comp i (wcPi2 F (Over.mk (wcProjKStr F d)))
  have ha : IsIso (i ≫ wcPi2 F (Over.mk (wcProjKStr F d))) := by rw [hi]; infer_instance

  obtain ⟨Di, hDi⟩ := wc_hm_pull_data_exists i ℓ
  obtain ⟨Dj, hDj⟩ := wc_hm_pull_data_exists j ℓ
  obtain ⟨κ, -, hbij⟩ := wc_supp_open_excision_exists i j (wcTlZero F d) hi_def.symm
    Di hDi D0 hD0 Dj hDj
  have hb := hbij (2 * d)
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcXbar F (Over.mk (wcProjKStr F d))) ℓ)) :=
    HasExt.standard _
  have hΨ0 : (Abelian.Ext.mk₀ κ).comp (wcSuppPullExt Di Dj (2 * d) 0) (zero_add _) = 0 := by
    haveI := Dj.additive
    haveI := Dj.presLim
    haveI := Dj.presColim
    show (Abelian.Ext.mk₀ κ).comp ((Abelian.Ext.mapExactFunctor Dj.Φ 0).comp
      (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero _)) (zero_add _) = 0
    rw [Abelian.Ext.mapExactFunctor_zero, Abelian.Ext.zero_comp, Abelian.Ext.comp_zero]
  obtain ⟨θv, hθv⟩ := hb.2 v
  obtain ⟨θw, hθw⟩ := hb.2 w
  have hθv' : (Abelian.Ext.mk₀ κ).comp (wcSuppPullExt Di Dj (2 * d) θv) (zero_add _) = v := hθv
  have hθw' : (Abelian.Ext.mk₀ κ).comp (wcSuppPullExt Di Dj (2 * d) θw) (zero_add _) = w := hθw
  have hθv0 : θv ≠ 0 := by
    rintro rfl
    exact hv (hθv'.symm.trans hΨ0)
  obtain ⟨c, hc⟩ := wc_point_supp_ext_line F (Over.mk (wcProjKStr F d)) d ℓ hℓ i ha Di hDi
    θv θw hθv0
  refine ⟨c, ?_⟩
  rw [← hθw', hc, c3 j Di D0 Dj hDj κ (2 * d) θv c, hθv']

theorem wc_tl_lin_basic (F : Type u) [Field F] (d : ℕ) :
    (∀ A B : Matrix (ULift.{u} (Fin d)) (ULift.{u} (Fin d)) (AlgebraicClosure F),
      wcTlLin F d B ≫ wcTlLin F d A = wcTlLin F d (A * B)) ∧
    wcTlLin F d 1 = 𝟙 _ ∧
    (∀ A : Matrix (ULift.{u} (Fin d)) (ULift.{u} (Fin d)) (AlgebraicClosure F), IsUnit A.det →
      IsPullback (wcTlZero F d) (𝟙 _) (wcTlLin F d A) (wcTlZero F d)) :=
by
  classical
  have hover : ∀ M : Matrix (ULift.{u} (Fin d)) (ULift.{u} (Fin d)) (AlgebraicClosure F),
      wcTlLin F d M ≫ wcTlStr F d = wcTlStr F d := by
    intro M
    unfold wcTlLin
    exact AffineSpace.homOfVector_over _ _
  have hcoord : ∀ (M : Matrix (ULift.{u} (Fin d)) (ULift.{u} (Fin d)) (AlgebraicClosure F))
      (j : ULift.{u} (Fin d)),
      (wcTlLin F d M).appTop.hom (AffineSpace.coord (Spec (.of (AlgebraicClosure F))) j) =
        ∑ k, (wcTlStr F d).appTop.hom
          ((Scheme.ΓSpecIso (.of (AlgebraicClosure F))).inv.hom (M j k)) *
          AffineSpace.coord (Spec (.of (AlgebraicClosure F))) k := by
    intro M j
    unfold wcTlLin
    exact AffineSpace.homOfVector_appTop_coord _ _ j
  have hconst : ∀ (M : Matrix (ULift.{u} (Fin d)) (ULift.{u} (Fin d)) (AlgebraicClosure F))
      (x : Γ(Spec (.of (AlgebraicClosure F)), ⊤)),
      (wcTlLin F d M).appTop.hom ((wcTlStr F d).appTop.hom x) = (wcTlStr F d).appTop.hom x := by
    intro M x
    have h := congrArg (fun φ => φ.appTop.hom x) (hover M)
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at h
    exact h
  have hcomp : ∀ A B : Matrix (ULift.{u} (Fin d)) (ULift.{u} (Fin d)) (AlgebraicClosure F),
      wcTlLin F d B ≫ wcTlLin F d A = wcTlLin F d (A * B) := by
    intro A B
    apply AffineSpace.hom_ext
    · show (wcTlLin F d B ≫ wcTlLin F d A) ≫ wcTlStr F d = wcTlLin F d (A * B) ≫ wcTlStr F d
      rw [Category.assoc, hover, hover, hover]
    · intro i
      rw [Scheme.Hom.comp_appTop]
      show (wcTlLin F d B).appTop.hom ((wcTlLin F d A).appTop.hom
          (AffineSpace.coord (Spec (.of (AlgebraicClosure F))) i)) =
        (wcTlLin F d (A * B)).appTop.hom (AffineSpace.coord (Spec (.of (AlgebraicClosure F))) i)
      rw [hcoord, hcoord, map_sum]
      simp only [map_mul, hconst, hcoord, Matrix.mul_apply, map_sum, Finset.mul_sum,
        Finset.sum_mul]
      rw [Finset.sum_comm]
      exact Finset.sum_congr rfl (fun _ _ => Finset.sum_congr rfl (fun _ _ => by ring))
  have hone : wcTlLin F d 1 = 𝟙 _ := by
    apply AffineSpace.hom_ext
    · show wcTlLin F d 1 ≫ wcTlStr F d = 𝟙 _ ≫ wcTlStr F d
      rw [hover, Category.id_comp]
    · intro i
      rw [Scheme.Hom.id_appTop]
      show (wcTlLin F d 1).appTop.hom (AffineSpace.coord (Spec (.of (AlgebraicClosure F))) i) =
        AffineSpace.coord (Spec (.of (AlgebraicClosure F))) i
      rw [hcoord, Finset.sum_eq_single i]
      · rw [Matrix.one_apply_eq, map_one, map_one, one_mul]
      · intro j _ hj
        rw [Matrix.one_apply_ne hj.symm, map_zero, map_zero, zero_mul]
      · intro h
        exact absurd (Finset.mem_univ i) h
  refine ⟨hcomp, hone, ?_⟩
  intro A hA
  have : IsIso (wcTlLin F d A) :=
    ⟨⟨wcTlLin F d A⁻¹, by rw [hcomp, Matrix.nonsing_inv_mul A hA, hone],
      by rw [hcomp, Matrix.mul_nonsing_inv A hA, hone]⟩⟩
  have hz : ∀ j : ULift.{u} (Fin d),
      (wcTlZero F d).appTop.hom (AffineSpace.coord (Spec (.of (AlgebraicClosure F))) j) = 0 :=
    fun j => AffineSpace.homOfVector_appTop_coord _ _ j
  have hsq : wcTlZero F d ≫ wcTlLin F d A = 𝟙 _ ≫ wcTlZero F d := by
    rw [Category.id_comp]
    apply AffineSpace.hom_ext
    · show (wcTlZero F d ≫ wcTlLin F d A) ≫ wcTlStr F d = wcTlZero F d ≫ wcTlStr F d
      rw [Category.assoc, hover]
    · intro i
      rw [Scheme.Hom.comp_appTop]
      show (wcTlZero F d).appTop.hom ((wcTlLin F d A).appTop.hom
          (AffineSpace.coord (Spec (.of (AlgebraicClosure F))) i)) =
        (wcTlZero F d).appTop.hom (AffineSpace.coord (Spec (.of (AlgebraicClosure F))) i)
      rw [hcoord, map_sum, hz]
      simp only [map_mul, hz, mul_zero, Finset.sum_const_zero]
  exact IsPullback.of_vert_isIso ⟨hsq⟩

theorem wc_supp_pull_id {T V : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {i : T ⟶ V}
    (k : V ⟶ V) (hk : k = 𝟙 V)
    (D : wcHMPullData i ℓ) (hD : wcHMPullCanonical D) (hepi : Epi (wcSuppUnitMap D))
    (Dk : wcHMPullData k ℓ) (hDk : wcHMPullCanonical Dk)
    (γ : wcSuppObj D ⟶ Dk.Φ.obj (wcSuppObj D))
    (hγ : wcSuppUnitMap D ≫ γ = Dk.μ.inv ≫ Dk.Φ.map (wcSuppUnitMap D))
    (n : ℕ) (θ : wcSuppExt D n) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V ℓ)) := HasExt.standard _
    (Abelian.Ext.mk₀ γ).comp (wcSuppPullExt D Dk n θ) (zero_add _) = θ :=
by
  classical
  subst hk

  let eV : ∀ W : V.ProEt, Limits.pullback W.hom (𝟙 V) ≅ W.left := fun W =>
    { hom := Limits.pullback.fst W.hom (𝟙 V)
      inv := Limits.pullback.lift (𝟙 W.left) W.hom (by rw [Category.id_comp, Category.comp_id])
      hom_inv_id := by
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, Limits.pullback.lift_fst, Category.comp_id, Category.id_comp]
        · rw [Category.assoc, Limits.pullback.lift_snd, Category.id_comp,
            ← Category.comp_id (Limits.pullback.snd W.hom (𝟙 V)), ← Limits.pullback.condition]
      inv_hom_id := Limits.pullback.lift_fst _ _ _ }
  let β : ∀ W : V.ProEt, (wcProEtBC (𝟙 V)).obj W ≅ (𝟭 V.ProEt).obj W := fun W =>
    MorphismProperty.Over.isoMk (eV W)
      (by
        show Limits.pullback.fst W.hom (𝟙 V) ≫ W.hom = Limits.pullback.snd W.hom (𝟙 V)
        rw [Limits.pullback.condition, Category.comp_id])
  have hnat : ∀ {W W' : V.ProEt} (g : W ⟶ W'),
      (wcProEtBC (𝟙 V)).map g ≫ (β W').hom = (β W).hom ≫ (𝟭 V.ProEt).map g := by
    intro W W' g
    apply MorphismProperty.Over.Hom.ext
    show ((wcProEtBC (𝟙 V)).map g).left ≫ Limits.pullback.fst W'.hom (𝟙 V) =
      Limits.pullback.fst W.hom (𝟙 V) ≫ g.left
    exact Limits.pullback.lift_fst _ _ _
  let α : 𝟭 V.ProEt ≅ wcProEtBC (𝟙 V) := (NatIso.ofComponents β hnat).symm
  have hα : ∀ (W : V.ProEt) (z : ↥W.left),
      (Limits.pullback.fst W.hom (𝟙 V)) ((α.hom.app W).left z) = z := by
    intro W z
    have h1 : (α.hom.app W).left ≫ Limits.pullback.fst W.hom (𝟙 V) = 𝟙 W.left := by
      show (eV W).inv ≫ (eV W).hom = 𝟙 W.left
      exact (eV W).inv_hom_id
    calc (Limits.pullback.fst W.hom (𝟙 V)) ((α.hom.app W).left z)
        = ((α.hom.app W).left ≫ Limits.pullback.fst W.hom (𝟙 V)) z :=
          (Scheme.Hom.comp_apply _ _ z).symm
      _ = (𝟙 W.left : W.left ⟶ W.left) z := by rw [h1]
      _ = z := rfl
  haveI := Dk.cont
  let τ := (Functor.sheafPushforwardContinuousNatTrans α.hom RingCat.{u+1}
    (Scheme.ProEt.topology V) (Scheme.ProEt.topology V)).app (wcRingSheaf V ℓ)
  have hcompat : Dk.φ ≫ τ = (𝟙 (wcRingSheaf V ℓ) : wcRingSheaf V ℓ ⟶
      ((𝟭 V.ProEt).sheafPushforwardContinuous RingCat.{u+1} (Scheme.ProEt.topology V)
        (Scheme.ProEt.topology V)).obj (wcRingSheaf V ℓ)) := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext W
    induction W using Opposite.rec with
    | op W =>
    apply RingCat.hom_ext
    apply RingHom.ext
    intro s
    apply ContinuousMap.ext
    intro z
    refine (congrArg (fun g : C(↥(Limits.pullback W.hom (𝟙 V)), ULift.{u+1} ℚ_[ℓ]) =>
      g ((α.hom.app W).left.base z)) (hDk W s)).trans ?_
    let s' : C(↥W.left, ULift.{u+1} ℚ_[ℓ]) := s
    exact congrArg (fun p => s' p) (hα W z)
  let ι := SheafOfModules.pushforwardNatIso Dk.φ α ≪≫ SheafOfModules.pushforwardCongr hcompat ≪≫
    SheafOfModules.pushforwardId (wcRingSheaf V ℓ)
  let ψ : Dk.Φ ≅ 𝟭 (SheafOfModules.{u+1} (wcRingSheaf V ℓ)) :=
    Adjunction.leftAdjointUniq (Dk.adj.ofNatIsoRight ι) Adjunction.id

  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V ℓ)) := HasExt.standard _
  haveI := Dk.additive
  haveI := Dk.presLim
  haveI := Dk.presColim
  haveI := hepi
  have h2 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf V ℓ)} {a : ℕ}
      (p : A ⟶ B) (q : B ⟶ C') (z : Abelian.Ext C' D' a),
      (Abelian.Ext.mk₀ p).comp ((Abelian.Ext.mk₀ q).comp z (zero_add a)) (zero_add a) =
        (Abelian.Ext.mk₀ (p ≫ q)).comp z (zero_add a) := by
    intro A B C' D' a p q z
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
  have h3 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf V ℓ)} {a : ℕ}
      (z : Abelian.Ext A B a) (p : B ⟶ C') (q : C' ⟶ D'),
      (z.comp (Abelian.Ext.mk₀ p) (add_zero a)).comp (Abelian.Ext.mk₀ q) (add_zero a) =
        z.comp (Abelian.Ext.mk₀ (p ≫ q)) (add_zero a) := by
    intro A B C' D' a z p q
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  have h4 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf V ℓ)} {a : ℕ}
      (p : A ⟶ B) (z : Abelian.Ext B C' a) (q : C' ⟶ D'),
      ((Abelian.Ext.mk₀ p).comp z (zero_add a)).comp (Abelian.Ext.mk₀ q) (add_zero a) =
        (Abelian.Ext.mk₀ p).comp (z.comp (Abelian.Ext.mk₀ q) (add_zero a)) (zero_add a) := by
    intro A B C' D' a p z q
    exact Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _

  have hcomm : ∀ (X : (V.ProEt)ᵒᵖ) (a b : (wcRingSheaf V ℓ).obj.obj X), a * b = b * a := by
    intro X a b
    exact @mul_comm C(↥(Opposite.unop X).left, ULift.{u+1} ℚ_[ℓ]) _ a b
  have hext : ∀ (e : SheafOfModules.unit (wcRingSheaf V ℓ) ⟶
      SheafOfModules.unit (wcRingSheaf V ℓ)), ∃ m : 𝟭 (SheafOfModules.{u+1} (wcRingSheaf V ℓ)) ⟶
      𝟭 (SheafOfModules.{u+1} (wcRingSheaf V ℓ)),
      m.app (SheafOfModules.unit (wcRingSheaf V ℓ)) = e := by
    intro e
    let R := wcRingSheaf V ℓ
    let s := (SheafOfModules.unit R).unitHomEquiv e
    let σ : ∀ X : (V.ProEt)ᵒᵖ, R.obj.obj X := fun X => (s.1 X : R.obj.obj X)
    have hσ : ∀ {X Y : (V.ProEt)ᵒᵖ} (g : X ⟶ Y), (R.obj.map g).hom (σ X) = σ Y :=
      fun g => PresheafOfModules.sections_property s g
    let L : ∀ (M : SheafOfModules.{u+1} R) (X : (V.ProEt)ᵒᵖ), M.val.obj X ⟶ M.val.obj X :=
      fun M X => ModuleCat.ofHom
        { toFun := fun x => σ X • x
          map_add' := fun x y => smul_add _ _ _
          map_smul' := fun r x => by
            simp only [RingHom.id_apply, smul_smul]
            rw [hcomm X] }
    let mM : ∀ M : SheafOfModules.{u+1} R, M ⟶ M := fun M =>
      ⟨PresheafOfModules.Hom.mk (L M) (by
        intro X Y g
        ext x
        show σ Y • (M.val.map g).hom x = (M.val.map g).hom (σ X • x)
        rw [PresheafOfModules.map_smul, hσ])⟩
    refine ⟨{ app := mM, naturality := ?_ }, ?_⟩
    · intro M N g
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro X
      ext x
      show σ X • (g.val.app X).hom x = (g.val.app X).hom (σ X • x)
      exact ((g.val.app X).hom.map_smul _ _).symm
    · apply (SheafOfModules.unit R).unitHomEquiv.injective
      apply PresheafOfModules.sections_ext
      intro X
      rw [SheafOfModules.unitHomEquiv_apply_coe]
      show σ X • (1 : R.obj.obj X) = s.1 X
      rw [smul_eq_mul, mul_one]
  have hcen : ∀ (m : 𝟭 (SheafOfModules.{u+1} (wcRingSheaf V ℓ)) ⟶
      𝟭 (SheafOfModules.{u+1} (wcRingSheaf V ℓ)))
      {A B : SheafOfModules.{u+1} (wcRingSheaf V ℓ)} {a : ℕ} (z : Abelian.Ext A B a),
      (Abelian.Ext.mk₀ (m.app A)).comp z (zero_add a) =
        z.comp (Abelian.Ext.mk₀ (m.app B)) (add_zero a) := by
    intro m A B a z
    have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp z m
    simp only [Abelian.Ext.id_mapExactFunctor] at h
    exact h.symm

  show (Abelian.Ext.mk₀ γ).comp ((Abelian.Ext.mapExactFunctor Dk.Φ θ).comp
      (Abelian.Ext.mk₀ Dk.μ.hom) (add_zero n)) (zero_add n) = θ
  have nat' : (Abelian.Ext.mapExactFunctor Dk.Φ θ).comp
      (Abelian.Ext.mk₀ (ψ.hom.app (SheafOfModules.unit (wcRingSheaf V ℓ)))) (add_zero n) =
      (Abelian.Ext.mk₀ (ψ.hom.app (wcSuppObj D))).comp θ (zero_add n) := by
    rw [Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp θ ψ.hom, Abelian.Ext.id_mapExactFunctor]
  have step1 : (Abelian.Ext.mapExactFunctor Dk.Φ θ).comp (Abelian.Ext.mk₀ Dk.μ.hom) (add_zero n) =
      ((Abelian.Ext.mk₀ (ψ.hom.app (wcSuppObj D))).comp θ (zero_add n)).comp
        (Abelian.Ext.mk₀ (ψ.inv.app (SheafOfModules.unit (wcRingSheaf V ℓ)) ≫ Dk.μ.hom))
        (add_zero n) := by
    rw [← nat', h3, Iso.hom_inv_id_app_assoc]
  rw [step1, h4, h2]

  obtain ⟨m, hm⟩ := hext (Dk.μ.inv ≫ ψ.hom.app (SheafOfModules.unit (wcRingSheaf V ℓ)))
  have hmor : γ ≫ ψ.hom.app (wcSuppObj D) = m.app (wcSuppObj D) := by
    rw [← cancel_epi (wcSuppUnitMap D)]
    have n2 := m.naturality (wcSuppUnitMap D)
    have nψ := ψ.hom.naturality (wcSuppUnitMap D)
    simp only [Functor.id_map] at n2 nψ
    rw [reassoc_of% hγ, nψ, ← Category.assoc, ← hm, n2]

  have hmR : m.app (SheafOfModules.unit (wcRingSheaf V ℓ)) ≫
      (ψ.inv.app (SheafOfModules.unit (wcRingSheaf V ℓ)) ≫ Dk.μ.hom) =
        𝟙 (SheafOfModules.unit (wcRingSheaf V ℓ)) := by
    rw [hm]
    simp only [Category.assoc, Iso.hom_inv_id_app_assoc, Iso.inv_hom_id]
    rfl
  rw [hmor, ← h4, hcen m θ, h3, hmR]
  exact Abelian.Ext.comp_mk₀_id _

theorem padic_infinitely_divisible_eq_one (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (z : ℚ_[ℓ]) (hz : z ≠ 0)
    (hdiv : ∀ n : ℕ, 0 < n → ∃ w : ℚ_[ℓ], w ^ n = z) : z = 1 :=
by
  have hp : Nat.Prime ℓ := Fact.out
  have hℓ2 : 2 ≤ ℓ := hp.two_le
  have hℓR : (1 : ℝ) < ℓ := by exact_mod_cast hℓ2
  set q : ℝ := (ℓ : ℝ)⁻¹ with hq
  have hq0 : 0 < q := by positivity
  have hq1 : q < 1 := inv_lt_one_of_one_lt₀ hℓR

  have s1 : ‖z‖ = 1 := by
    obtain ⟨N, hN⟩ : ∃ N : ℕ, N = z.valuation.natAbs + 1 := ⟨_, rfl⟩
    obtain ⟨w, hw⟩ := hdiv N (by omega)
    have hv : (w ^ N).valuation = (N : ℤ) * w.valuation := Padic.valuation_pow w N
    rw [hw] at hv
    have hdvd : (N : ℤ) ∣ z.valuation := ⟨_, hv⟩
    have h0 : z.valuation = 0 := by
      apply Int.eq_zero_of_dvd_of_natAbs_lt_natAbs hdvd
      rw [Int.natAbs_natCast]
      omega
    rw [Padic.norm_eq_zpow_neg_valuation hz, h0]
    simp

  have disc : ∀ y : ℚ_[ℓ], ‖y‖ < 1 → ‖y‖ ≤ q := by
    intro y hy
    have h := (Padic.norm_le_pow_iff_norm_lt_pow_add_one y (-1)).mpr (by simpa using hy)
    simpa [zpow_neg_one] using h

  have s2 : ∀ w : ℚ_[ℓ], ‖w‖ = 1 → ‖w ^ (ℓ - 1) - 1‖ < 1 := by
    intro w hw
    let a : ℤ_[ℓ] := ⟨w, hw.le⟩
    have ha : IsUnit a := PadicInt.isUnit_iff.mpr (by rw [PadicInt.norm_def]; exact hw)
    have hne : PadicInt.toZMod a ≠ 0 := by
      intro h
      have hmem : a ∈ IsLocalRing.maximalIdeal ℤ_[ℓ] := by
        rw [← PadicInt.ker_toZMod]; exact RingHom.mem_ker.mpr h
      exact (IsLocalRing.mem_maximalIdeal _).mp hmem ha
    have h1 : PadicInt.toZMod (a ^ (ℓ - 1) - 1) = 0 := by
      rw [map_sub, map_pow, map_one, ZMod.pow_card_sub_one_eq_one hne, sub_self]
    have h2 : a ^ (ℓ - 1) - 1 ∈ IsLocalRing.maximalIdeal ℤ_[ℓ] := by
      rw [← PadicInt.ker_toZMod]; exact RingHom.mem_ker.mpr h1
    have h3 : ‖a ^ (ℓ - 1) - 1‖ < 1 :=
      PadicInt.mem_nonunits.mp ((IsLocalRing.mem_maximalIdeal _).mp h2)
    rw [PadicInt.norm_def] at h3
    have hc : ((a ^ (ℓ - 1) - 1 : ℤ_[ℓ]) : ℚ_[ℓ]) = w ^ (ℓ - 1) - 1 := by
      simp only [PadicInt.coe_sub, PadicInt.coe_pow, PadicInt.coe_one]
      rfl
    rw [hc] at h3
    exact h3

  have le_one : ∀ y : ℚ_[ℓ], ‖y - 1‖ ≤ q → ‖y‖ ≤ 1 := by
    intro y hy
    have e : y = (y - 1) + 1 := by ring
    calc ‖y‖ = ‖(y - 1) + 1‖ := by rw [← e]
      _ ≤ max ‖y - 1‖ ‖(1 : ℚ_[ℓ])‖ := Padic.nonarchimedean _ _
      _ ≤ 1 := by rw [norm_one]; exact max_le (hy.trans hq1.le) le_rfl
  have step : ∀ y : ℚ_[ℓ], ‖y - 1‖ ≤ q → ‖y ^ ℓ - 1‖ ≤ q * ‖y - 1‖ := by
    intro y hy
    have hy1 := le_one y hy
    have hpow1 : ∀ j : ℕ, ‖y ^ j‖ ≤ 1 := fun j => by
      rw [norm_pow]; exact pow_le_one₀ (norm_nonneg _) hy1
    have hgeom : ∀ i : ℕ, ‖∑ j ∈ Finset.range i, y ^ j‖ ≤ 1 := by
      intro i
      exact IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg zero_le_one
        (fun j _ => hpow1 j)
    have hi : ∀ i : ℕ, ‖y ^ i - 1‖ ≤ q := by
      intro i
      rw [← mul_geom_sum, norm_mul]
      calc ‖y - 1‖ * ‖∑ j ∈ Finset.range i, y ^ j‖ ≤ ‖y - 1‖ * 1 :=
            mul_le_mul_of_nonneg_left (hgeom i) (norm_nonneg _)
        _ ≤ q := by rw [mul_one]; exact hy
    have hS : ∑ i ∈ Finset.range ℓ, y ^ i =
        ∑ i ∈ Finset.range ℓ, (y ^ i - 1) + (ℓ : ℚ_[ℓ]) := by
      rw [Finset.sum_sub_distrib]; simp
    have hSn : ‖∑ i ∈ Finset.range ℓ, y ^ i‖ ≤ q := by
      rw [hS]
      calc _ ≤ max ‖∑ i ∈ Finset.range ℓ, (y ^ i - 1)‖ ‖(ℓ : ℚ_[ℓ])‖ :=
            Padic.nonarchimedean _ _
        _ ≤ q := by
          apply max_le
          · exact IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg hq0.le
              (fun i _ => hi i)
          · exact (Padic.norm_p).le
    rw [← mul_geom_sum, norm_mul, mul_comm]
    exact mul_le_mul_of_nonneg_right hSn (norm_nonneg _)
  have s3 : ∀ x : ℚ_[ℓ], ‖x - 1‖ < 1 → ∀ k : ℕ, ‖x ^ (ℓ ^ k) - 1‖ ≤ q ^ (k + 1) := by
    intro x hx k
    induction k with
    | zero =>
      simp only [pow_zero, pow_one, zero_add]
      exact disc _ hx
    | succ k ih =>
      have hle : ‖x ^ (ℓ ^ k) - 1‖ ≤ q :=
        ih.trans (pow_le_of_le_one hq0.le hq1.le (Nat.succ_ne_zero k))
      have h := step _ hle
      rw [show ℓ ^ (k + 1) = ℓ ^ k * ℓ from pow_succ ℓ k, pow_mul]
      calc ‖(x ^ ℓ ^ k) ^ ℓ - 1‖ ≤ q * ‖x ^ (ℓ ^ k) - 1‖ := h
        _ ≤ q * q ^ (k + 1) := mul_le_mul_of_nonneg_left ih hq0.le
        _ = q ^ (k + 1 + 1) := by ring

  have key : ∀ k : ℕ, ‖z - 1‖ ≤ q ^ (k + 1) := by
    intro k
    have hn : 0 < (ℓ - 1) * ℓ ^ k := Nat.mul_pos (by omega) (pow_pos (by omega) k)
    obtain ⟨w, hw⟩ := hdiv _ hn
    have hw1 : ‖w‖ = 1 := by
      have h : ‖w‖ ^ ((ℓ - 1) * ℓ ^ k) = 1 := by rw [← norm_pow, hw, s1]
      exact (pow_eq_one_iff_of_nonneg (norm_nonneg w) hn.ne').mp h
    have h := s3 _ (s2 w hw1) k
    rwa [← pow_mul, hw] at h
  by_contra hne
  have hε : 0 < ‖z - 1‖ := norm_pos_iff.mpr (sub_ne_zero.mpr hne)
  obtain ⟨m, hm⟩ := exists_pow_lt_of_lt_one hε hq1
  have h1 := key m
  have h2 : q ^ (m + 1) ≤ q ^ m := pow_le_pow_of_le_one hq0.le hq1.le (Nat.le_succ m)
  linarith

theorem wc_hm_const_ring (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    wcHMConst S ℓ 1 = 𝟙 _ ∧
    (∀ a b : ℚ_[ℓ], wcHMConst S ℓ (a * b) = wcHMConst S ℓ a ≫ wcHMConst S ℓ b) ∧
    (∀ a b : ℚ_[ℓ], wcHMConst S ℓ (a + b) = wcHMConst S ℓ a + wcHMConst S ℓ b) :=
by
  classical
  have hext : ∀ f g : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶
      SheafOfModules.unit (wcRingSheaf S ℓ),
      (∀ Y, (SheafOfModules.unitHomEquiv _ f).1 Y = (SheafOfModules.unitHomEquiv _ g).1 Y) →
        f = g := by
    intro f g h
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext Y
    exact h Y
  have hval : ∀ (c : ℚ_[ℓ]) Y,
      (SheafOfModules.unitHomEquiv _ (wcHMConst S ℓ c)).1 Y =
      (ContinuousMap.const _ (ULift.up c) :
        C(↥((Opposite.unop Y).left), ULift.{u+1} ℚ_[ℓ])) := by
    intro c Y
    unfold wcHMConst
    rw [Equiv.apply_symm_apply]
    rfl
  have hsum : ∀ (f g : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶
      SheafOfModules.unit (wcRingSheaf S ℓ)) Y,
      (SheafOfModules.unitHomEquiv _ (f + g)).1 Y =
        (SheafOfModules.unitHomEquiv _ f).1 Y + (SheafOfModules.unitHomEquiv _ g).1 Y := by
    intro f g Y
    simp only [SheafOfModules.unitHomEquiv_apply_coe]
    rfl
  have hid : ∀ Y, (SheafOfModules.unitHomEquiv _
      (𝟙 (SheafOfModules.unit (wcRingSheaf S ℓ)))).1 Y =
      (ContinuousMap.const _ (ULift.up 1) :
        C(↥((Opposite.unop Y).left), ULift.{u+1} ℚ_[ℓ])) := by
    intro Y
    simp only [SheafOfModules.unitHomEquiv_apply_coe]
    rfl
  have hcompv : ∀ (a b : ℚ_[ℓ]) Y,
      (SheafOfModules.unitHomEquiv _ (wcHMConst S ℓ a ≫ wcHMConst S ℓ b)).1 Y =
      ((1 * ContinuousMap.const _ (ULift.up a)) * ContinuousMap.const _ (ULift.up b) :
        C(↥((Opposite.unop Y).left), ULift.{u+1} ℚ_[ℓ])) := by
    intro a b Y
    rw [SheafOfModules.unitHomEquiv_apply_coe]
    rfl
  have h1 : wcHMConst S ℓ 1 = 𝟙 _ := by
    apply hext
    intro Y
    rw [hval, hid]
  have hadd : ∀ a b : ℚ_[ℓ], wcHMConst S ℓ (a + b) =
      wcHMConst S ℓ a + wcHMConst S ℓ b := by
    intro a b
    apply hext
    intro Y
    rw [hsum, hval, hval, hval]
    rfl
  have hmul : ∀ a b : ℚ_[ℓ], wcHMConst S ℓ (a * b) =
      wcHMConst S ℓ a ≫ wcHMConst S ℓ b := by
    intro a b
    apply hext
    intro Y
    rw [hval, hcompv]
    apply ContinuousMap.ext
    intro p
    apply ULift.ext
    show a * b = 1 * a * b
    rw [one_mul]
  exact ⟨h1, hmul, hadd⟩

theorem wc_line_matrix_action_trivial {K : Type*} [Field K] [IsAlgClosed K]
    {ι : Type*} [Fintype ι] [DecidableEq ι] {Q : Type*} [Field Q] {E : Type*} [AddCommGroup E]
    (s : Q → E → E) (hs1 : ∀ w, s 1 w = w) (hsmul : ∀ x y w, s (x * y) w = s y (s x w))
    (hsadd : ∀ x y w, s (x + y) w = s x w + s y w) (hs0 : ∀ x, s x 0 = 0)
    (hline : ∀ v w : E, v ≠ 0 → ∃ x : Q, w = s x v)
    (hdiv : ∀ z : Q, z ≠ 0 → (∀ n : ℕ, 0 < n → ∃ y : Q, y ^ n = z) → z = 1)
    (R : Matrix ι ι K → (E → E) → Prop)
    (hex : ∀ B : Matrix ι ι K, B.det ≠ 0 → ∃ T, R B T)
    (hmul : ∀ (A B : Matrix ι ι K) (TA TB TAB : E → E), A.det ≠ 0 → B.det ≠ 0 →
      R A TA → R B TB → R (A * B) TAB → ∀ w, TAB w = TB (TA w))
    (hone : ∀ T, R 1 T → ∀ w, T w = w)
    (hcomm : ∀ B T, R B T → ∀ (x : Q) (w : E), T (s x w) = s x (T w)) :
    ∀ (B : Matrix ι ι K) (T : E → E), B.det ≠ 0 → R B T → ∀ w, T w = w :=
by
  classical
  intro B T hB hBT w
  by_cases hE : ∃ v : E, v ≠ 0
  swap
  · push_neg at hE
    rw [hE (T w), hE w]
  obtain ⟨v, hv⟩ := hE

  have hfaith : ∀ c c' : Q, s c v = s c' v → c = c' := by
    intro c c' h
    by_contra hne
    have hδ : c - c' ≠ 0 := sub_ne_zero.mpr hne
    have h1 : s (c - c') v = 0 := by
      have h2 := hsadd (c - c') c' v
      rw [sub_add_cancel, h] at h2
      have h3 : s c' v - s c' v = s (c - c') v + s c' v - s c' v := by rw [← h2]
      rw [sub_self, add_sub_cancel_right] at h3
      exact h3.symm
    apply hv
    calc v = s 1 v := (hs1 v).symm
      _ = s ((c - c') * (c - c')⁻¹) v := by rw [mul_inv_cancel₀ hδ]
      _ = s (c - c')⁻¹ (s (c - c') v) := hsmul _ _ _
      _ = 0 := by rw [h1, hs0]
  have hdet1 : (1 : Matrix ι ι K).det ≠ 0 := by rw [Matrix.det_one]; exact one_ne_zero

  have huniq : ∀ (M : Matrix ι ι K) (T₁ T₂ : E → E), M.det ≠ 0 → R M T₁ → R M T₂ →
      ∀ u, T₁ u = T₂ u := by
    intro M T₁ T₂ hM hT₁ hT₂ u
    obtain ⟨T1, hT1⟩ := hex 1 hdet1
    have h := hmul M 1 T₂ T1 T₁ hM hdet1 hT₂ hT1 (by rwa [Matrix.mul_one]) u
    rw [h, hone T1 hT1]

  have hscal : ∀ (M : Matrix ι ι K) (T₁ : E → E) (c : Q), R M T₁ → T₁ v = s c v →
      ∀ u, T₁ u = s c u := by
    intro M T₁ c hT hc u
    obtain ⟨x, rfl⟩ := hline v u hv
    rw [hcomm M T₁ hT x v, hc, ← hsmul, ← hsmul, mul_comm]

  have hexc : ∀ M : Matrix ι ι K, M.det ≠ 0 → ∃ c : Q, ∀ T₁, R M T₁ → ∀ u, T₁ u = s c u := by
    intro M hM
    obtain ⟨T0, hT0⟩ := hex M hM
    obtain ⟨c, hc⟩ := hline v (T0 v) hv
    refine ⟨c, fun T₁ hT₁ u => ?_⟩
    rw [huniq M T₁ T0 hM hT₁ hT0 u]
    exact hscal M T0 c hT0 hc u
  choose cf hcf using hexc
  let χ : Matrix ι ι K → Q := fun M => if h : M.det ≠ 0 then cf M h else 1
  have hχact : ∀ (M : Matrix ι ι K) (T₁ : E → E), M.det ≠ 0 → R M T₁ →
      ∀ u, T₁ u = s (χ M) u := by
    intro M T₁ hM hT u
    have hχM : χ M = cf M hM := dif_pos hM
    rw [hχM]
    exact hcf M hM T₁ hT u
  have hχ1 : χ 1 = 1 := by
    obtain ⟨T1, hT1⟩ := hex 1 hdet1
    apply hfaith
    rw [← hχact 1 T1 hdet1 hT1 v, hone T1 hT1, hs1]
  have hχmul : ∀ A₁ B₁ : Matrix ι ι K, A₁.det ≠ 0 → B₁.det ≠ 0 →
      χ (A₁ * B₁) = χ A₁ * χ B₁ := by
    intro A₁ B₁ hA hB'
    have hAB : (A₁ * B₁).det ≠ 0 := by rw [Matrix.det_mul]; exact mul_ne_zero hA hB'
    obtain ⟨TA, hTA⟩ := hex A₁ hA
    obtain ⟨TB, hTB⟩ := hex B₁ hB'
    obtain ⟨TAB, hTAB⟩ := hex (A₁ * B₁) hAB
    apply hfaith
    rw [← hχact _ TAB hAB hTAB v, hmul A₁ B₁ TA TB TAB hA hB' hTA hTB hTAB v,
      hχact A₁ TA hA hTA v, hcomm B₁ TB hTB, hχact B₁ TB hB' hTB v, ← hsmul, mul_comm]

  have hχpow : ∀ M : Matrix ι ι K, M.det ≠ 0 → ∀ k : ℕ, χ (M ^ k) = χ M ^ k := by
    intro M hM k
    induction k with
    | zero => rw [pow_zero, pow_zero, hχ1]
    | succ k ih =>
      rw [pow_succ, pow_succ, hχmul _ _ (by rw [Matrix.det_pow]; exact pow_ne_zero _ hM) hM, ih]

  have hdiag : ∀ D : ι → K, (Matrix.diagonal D).det ≠ 0 → χ (Matrix.diagonal D) = 1 := by
    intro D hD
    have hDi : ∀ i, D i ≠ 0 := by
      rw [Matrix.det_diagonal] at hD
      exact fun i => (Finset.prod_ne_zero_iff.mp hD) i (Finset.mem_univ i)
    have hinv : (Matrix.diagonal (fun i => (D i)⁻¹)).det ≠ 0 := by
      rw [Matrix.det_diagonal]
      exact Finset.prod_ne_zero_iff.mpr (fun i _ => inv_ne_zero (hDi i))
    have hz : χ (Matrix.diagonal D) ≠ 0 := by
      intro h0
      have h1 := hχmul _ _ hD hinv
      rw [Matrix.diagonal_mul_diagonal, h0, zero_mul] at h1
      have h2 : Matrix.diagonal (fun i => D i * (D i)⁻¹) = 1 := by
        rw [← Matrix.diagonal_one]
        congr 1
        funext i
        exact mul_inv_cancel₀ (hDi i)
      rw [h2, hχ1] at h1
      exact one_ne_zero h1
    apply hdiv _ hz
    intro n hn
    have hr : ∀ i, ∃ r : K, r ^ n = D i := fun i => IsAlgClosed.exists_pow_nat_eq (D i) hn
    choose r hr using hr
    have hpow : Matrix.diagonal r ^ n = Matrix.diagonal D := by
      rw [Matrix.diagonal_pow]
      congr 1
      funext i
      rw [Pi.pow_apply]
      exact hr i
    have hr0 : (Matrix.diagonal r).det ≠ 0 := by
      intro h0
      apply hD
      rw [← hpow, Matrix.det_pow, h0, zero_pow (Nat.pos_iff_ne_zero.mp hn)]
    exact ⟨χ (Matrix.diagonal r), by rw [← hχpow _ hr0, hpow]⟩

  have htrans : ∀ (i j : ι), i ≠ j → ∀ c : K, χ (Matrix.transvection i j c) = 1 := by
    intro i j hij c
    have hdetτ : ∀ e : K, (Matrix.transvection i j e).det ≠ 0 := by
      intro e
      rw [Matrix.det_transvection_of_ne _ _ hij]
      exact one_ne_zero
    obtain ⟨a, ha⟩ := Infinite.exists_notMem_finset ({0, 1} : Finset K)
    have ha0 : a ≠ 0 := fun h => ha (by simp [h])
    have ha1 : a ≠ 1 := fun h => ha (by simp [h])
    let d : ι → K := fun k => if k = i then a else 1
    have hΔ : (Matrix.diagonal d).det ≠ 0 := by
      rw [Matrix.det_diagonal]
      refine Finset.prod_ne_zero_iff.mpr (fun k _ => ?_)
      show (if k = i then a else 1) ≠ 0
      split_ifs
      · exact ha0
      · exact one_ne_zero
    have hχΔ := hdiag d hΔ
    have hconj : ∀ e : K, Matrix.diagonal d * Matrix.transvection i j e =
        Matrix.transvection i j (a * e) * Matrix.diagonal d := by
      intro e
      ext r t
      rw [Matrix.diagonal_mul, Matrix.mul_diagonal]
      simp only [Matrix.transvection, Matrix.add_apply, Matrix.one_apply, Matrix.single_apply, d]
      by_cases hr : r = i
      · subst hr
        by_cases ht : t = j
        · subst ht
          have h1 : ¬ t = r := Ne.symm hij
          simp [hij, h1]
        · have ht' : ¬ j = t := Ne.symm ht
          by_cases hrt : r = t
          · subst hrt
            simp [ht']
          · simp [ht', hrt]
      · have hr' : ¬ i = r := Ne.symm hr
        by_cases hrt : r = t
        · subst hrt
          simp [hr, hr']
        · simp [hr, hr', hrt]
    have hstep : ∀ e : K, χ (Matrix.transvection i j e) =
        χ (Matrix.transvection i j (a * e)) := by
      intro e
      have h1 := hχmul _ _ hΔ (hdetτ e)
      have h2 := hχmul _ _ (hdetτ (a * e)) hΔ
      rw [hconj e, h2, hχΔ, mul_one, one_mul] at h1
      exact h1.symm
    have ha1' : a - 1 ≠ 0 := sub_ne_zero.mpr ha1
    have hce : a * (c / (a - 1)) + -(c / (a - 1)) = c := by
      have h3 : a * (c / (a - 1)) + -(c / (a - 1)) = (a - 1) * (c / (a - 1)) := by ring
      rw [h3, mul_div_cancel₀ c ha1']
    calc χ (Matrix.transvection i j c)
        = χ (Matrix.transvection i j (a * (c / (a - 1))) *
            Matrix.transvection i j (-(c / (a - 1)))) := by
          rw [Matrix.transvection_mul_transvection_same i j hij, hce]
      _ = χ (Matrix.transvection i j (a * (c / (a - 1)))) *
            χ (Matrix.transvection i j (-(c / (a - 1)))) := hχmul _ _ (hdetτ _) (hdetτ _)
      _ = χ (Matrix.transvection i j (c / (a - 1))) *
            χ (Matrix.transvection i j (-(c / (a - 1)))) := by rw [← hstep]
      _ = χ (Matrix.transvection i j (c / (a - 1)) *
            Matrix.transvection i j (-(c / (a - 1)))) := (hχmul _ _ (hdetτ _) (hdetτ _)).symm
      _ = 1 := by
          rw [Matrix.transvection_mul_transvection_same i j hij, add_neg_cancel,
            Matrix.transvection_zero, hχ1]

  have hχB : χ B = 1 := by
    refine Matrix.diagonal_transvection_induction_of_det_ne_zero (fun M => χ M = 1) B hB hdiag
      ?_ ?_
    · intro t
      exact htrans t.i t.j t.hij t.c
    · intro A₁ C₁ hA hC hA1 hC1
      show χ (A₁ * C₁) = 1
      rw [hχmul A₁ C₁ hA hC, hA1, hC1, one_mul]
  rw [hχact B T hB hBT w, hχB, hs1]

theorem wc_tl_linear_trivial_exists (F : Type u) [Finite F] [Field F] (d ℓ : ℕ)
    [Fact (Nat.Prime ℓ)]
    (A : Matrix (ULift.{u} (Fin d)) (ULift.{u} (Fin d)) (AlgebraicClosure F)) (hA : IsUnit A.det)
    (D0 : wcHMPullData (wcTlZero F d) ℓ) (hD0 : wcHMPullCanonical D0)
    (DA : wcHMPullData (wcTlLin F d A) ℓ) (hDA : wcHMPullCanonical DA)
    (hline : letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcTlAff F d) ℓ)) :=
        HasExt.standard _
      ∀ v w : wcSuppExt D0 (2 * d), v ≠ 0 →
        ∃ c' : ℚ_[ℓ], w = v.comp (Abelian.Ext.mk₀ (wcHMConst (wcTlAff F d) ℓ c')) (add_zero _)) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcTlAff F d) ℓ)) := HasExt.standard _
    ∃ γ : wcSuppObj D0 ⟶ DA.Φ.obj (wcSuppObj D0),
      wcSuppUnitMap D0 ≫ γ = DA.μ.inv ≫ DA.Φ.map (wcSuppUnitMap D0) ∧
      ∀ τ : wcSuppExt D0 (2 * d),
        (Abelian.Ext.mk₀ γ).comp (wcSuppPullExt D0 DA (2 * d) τ) (zero_add _) = τ :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcTlAff F d) ℓ)) := HasExt.standard _
  have hz : wcTlZero F d ≫ wcTlStr F d = 𝟙 _ := AffineSpace.homOfVector_over _ _
  haveI : IsClosedImmersion (wcTlZero F d ≫ wcTlStr F d) := by rw [hz]; infer_instance
  haveI : IsClosedImmersion (wcTlZero F d) := IsClosedImmersion.of_comp _ (wcTlStr F d)
  haveI : IsLocallyNoetherian (wcTlAff F d) := by
    first
      | exact LocallyOfFiniteType.isLocallyNoetherian (wcTlStr F d)
      | exact LocallyOfFiniteType.isLocallyNoetherian (f := wcTlStr F d)
      | infer_instance
  have hepi : Epi (wcSuppUnitMap D0) := wc_supp_unit_epi_of_noetherian (wcTlZero F d) ℓ D0 hD0
  haveI := hepi
  obtain ⟨hcomp, hone1, hpb⟩ := wc_tl_lin_basic F d

  have hκex : ∀ (B : Matrix (ULift.{u} (Fin d)) (ULift.{u} (Fin d)) (AlgebraicClosure F)),
      IsUnit B.det → ∀ (DB : wcHMPullData (wcTlLin F d B) ℓ), wcHMPullCanonical DB →
      ∃ κ : wcSuppObj D0 ⟶ DB.Φ.obj (wcSuppObj D0),
        wcSuppUnitMap D0 ≫ κ = DB.μ.inv ≫ DB.Φ.map (wcSuppUnitMap D0) := by
    intro B hB DB hDB
    have hK := wc_supp_kernel_kill_of_noetherian (wcTlZero F d) (wcTlLin F d B) (wcTlZero F d)
      (𝟙 _) (hpb B hB) ℓ D0 hD0 D0 hD0 DB hDB
    exact ⟨Abelian.epiDesc (f := wcSuppUnitMap D0) _ hK,
      Abelian.comp_epiDesc (f := wcSuppUnitMap D0) _ hK⟩

  let s : ℚ_[ℓ] → wcSuppExt D0 (2 * d) → wcSuppExt D0 (2 * d) := fun x w =>
    w.comp (Abelian.Ext.mk₀ (wcHMConst (wcTlAff F d) ℓ x)) (add_zero _)
  obtain ⟨hc1, hcmul, hcadd⟩ := wc_hm_const_ring (wcTlAff F d) ℓ
  have hs1 : ∀ w, s 1 w = w := by
    intro w
    simp only [s]
    rw [hc1, Abelian.Ext.comp_mk₀_id]
  have hsmul : ∀ x y w, s (x * y) w = s y (s x w) := by
    intro x y w
    simp only [s]
    rw [hcmul, ← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_third_deg_zero]
  have hsadd : ∀ x y w, s (x + y) w = s x w + s y w := by
    intro x y w
    simp only [s]
    rw [hcadd, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add]
  have hs0 : ∀ x, s x 0 = 0 := by
    intro x
    exact Abelian.Ext.zero_comp _ _ _ _ _
  have hline' : ∀ v w : wcSuppExt D0 (2 * d), v ≠ 0 → ∃ x : ℚ_[ℓ], w = s x v :=
    fun v w hv => hline v w hv
  have hdiv : ∀ z : ℚ_[ℓ], z ≠ 0 → (∀ n : ℕ, 0 < n → ∃ y : ℚ_[ℓ], y ^ n = z) → z = 1 :=
    fun z hz h => padic_infinitely_divisible_eq_one ℓ z hz h

  let R : Matrix (ULift.{u} (Fin d)) (ULift.{u} (Fin d)) (AlgebraicClosure F) →
      (wcSuppExt D0 (2 * d) → wcSuppExt D0 (2 * d)) → Prop := fun B T =>
    ∃ (D : wcHMPullData (wcTlLin F d B) ℓ) (_ : wcHMPullCanonical D)
      (κ : wcSuppObj D0 ⟶ D.Φ.obj (wcSuppObj D0))
      (_ : wcSuppUnitMap D0 ≫ κ = D.μ.inv ≫ D.Φ.map (wcSuppUnitMap D0)),
      ∀ τ, T τ = (Abelian.Ext.mk₀ κ).comp (wcSuppPullExt D0 D (2 * d) τ) (zero_add _)
  have hex : ∀ B : Matrix (ULift.{u} (Fin d)) (ULift.{u} (Fin d)) (AlgebraicClosure F),
      B.det ≠ 0 → ∃ T, R B T := by
    intro B hB
    obtain ⟨DB, hDB⟩ := wc_hm_pull_data_exists (wcTlLin F d B) ℓ
    obtain ⟨κ, hκ⟩ := hκex B (isUnit_iff_ne_zero.mpr hB) DB hDB
    exact ⟨_, DB, hDB, κ, hκ, fun _ => rfl⟩
  have hmul : ∀ (A' B : Matrix (ULift.{u} (Fin d)) (ULift.{u} (Fin d)) (AlgebraicClosure F))
      (TA TB TAB : wcSuppExt D0 (2 * d) → wcSuppExt D0 (2 * d)), A'.det ≠ 0 → B.det ≠ 0 →
      R A' TA → R B TB → R (A' * B) TAB → ∀ w, TAB w = TB (TA w) := by
    intro A' B TA TB TAB _ _ hRA hRB hRAB w
    obtain ⟨DA', hDA', κA', hκA', eA⟩ := hRA
    obtain ⟨DB, hDB, κB, hκB, eB⟩ := hRB
    obtain ⟨DAB, hDAB, κAB, hκAB, eAB⟩ := hRAB
    rw [eAB, eB, eA]
    exact wc_supp_pull_comp (wcTlLin F d A') (wcTlLin F d B) (wcTlLin F d (A' * B)) (hcomp A' B)
      D0 hD0 D0 hD0 D0 hD0 hepi DA' hDA' DB hDB DAB hDAB κA' hκA' κB hκB κAB hκAB (2 * d) w
  have hone : ∀ T, R 1 T → ∀ w, T w = w := by
    intro T hR w
    obtain ⟨D1, hD1, κ1, hκ1, e1⟩ := hR
    rw [e1]
    exact wc_supp_pull_id (wcTlLin F d 1) hone1 D0 hD0 hepi D1 hD1 κ1 hκ1 (2 * d) w
  have hcomm : ∀ B T, R B T → ∀ (x : ℚ_[ℓ]) (w : wcSuppExt D0 (2 * d)),
      T (s x w) = s x (T w) := by
    intro B T hR x w
    obtain ⟨DB, hDB, κ, hκ, e⟩ := hR
    rw [e, e]
    simp only [s]
    haveI := DB.additive
    haveI := DB.presLim
    haveI := DB.presColim
    have hk : DB.Φ.map (wcHMConst (wcTlAff F d) ℓ x) ≫ DB.μ.hom =
        DB.μ.hom ≫ wcHMConst (wcTlAff F d) ℓ x := by
      conv_rhs => rw [← wc_hm_pull_const DB hDB x]
      rw [Iso.hom_inv_id_assoc]
    have e2 : ∀ {X1 X2 X3 X4 : SheafOfModules.{u+1} (wcRingSheaf (wcTlAff F d) ℓ)}
        (z : Abelian.Ext X1 X2 (2 * d)) (a : X2 ⟶ X3) (b : X3 ⟶ X4),
        (z.comp (Abelian.Ext.mk₀ a) (add_zero _)).comp (Abelian.Ext.mk₀ b) (add_zero _) =
          z.comp (Abelian.Ext.mk₀ (a ≫ b)) (add_zero _) := by
      intro X1 X2 X3 X4 z a b
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
    have hP : wcSuppPullExt D0 DB (2 * d)
          (w.comp (Abelian.Ext.mk₀ (wcHMConst (wcTlAff F d) ℓ x)) (add_zero _)) =
        (wcSuppPullExt D0 DB (2 * d) w).comp
          (Abelian.Ext.mk₀ (wcHMConst (wcTlAff F d) ℓ x)) (add_zero _) := by
      show (Abelian.Ext.mapExactFunctor DB.Φ
          (w.comp (Abelian.Ext.mk₀ (wcHMConst (wcTlAff F d) ℓ x)) (add_zero _))).comp
          (Abelian.Ext.mk₀ DB.μ.hom) (add_zero _) =
        ((Abelian.Ext.mapExactFunctor DB.Φ w).comp (Abelian.Ext.mk₀ DB.μ.hom) (add_zero _)).comp
          (Abelian.Ext.mk₀ (wcHMConst (wcTlAff F d) ℓ x)) (add_zero _)
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀, e2, e2, hk]
    rw [hP, Abelian.Ext.comp_assoc_of_third_deg_zero]
  have key := wc_line_matrix_action_trivial (K := AlgebraicClosure F) s hs1 hsmul hsadd hs0
    hline' hdiv R hex hmul hone hcomm
  obtain ⟨κA, hκA⟩ := hκex A hA DA hDA
  exact ⟨κA, hκA, fun τ =>
    key A _ (isUnit_iff_ne_zero.mp hA) ⟨DA, hDA, κA, hκA, fun _ => rfl⟩ τ⟩

theorem wc_tl_linear_homotopy_chart (F : Type u) [Field F] (d : ℕ)
    {N : Scheme.{u}} (q : N ⟶ Spec (.of (AlgebraicClosure F)))
    (a b : N ⟶ wcTlAff F d) (ha : Etale a) (hb : Etale b)
    (haq : a ≫ wcTlStr F d = q) (hbq : b ≫ wcTlStr F d = q)
    (yN : Spec (.of (AlgebraicClosure F)) ⟶ N)
    (hpa : IsPullback yN (𝟙 _) a (wcTlZero F d)) (hpb : IsPullback yN (𝟙 _) b (wcTlZero F d)) :
    ∃ (N₀ : N.Opens) (_ : IsAffine N₀.toScheme)
      (y₀ : Spec (.of (AlgebraicClosure F)) ⟶ N₀.toScheme) (_ : y₀ ≫ N₀.ι = yN)
      (A : Matrix (ULift.{u} (Fin d)) (ULift.{u} (Fin d)) (AlgebraicClosure F)) (_ : IsUnit A.det)
      (W : Scheme.{u}) (jW : W ⟶ AffineSpace (ULift.{u} (Fin 1)) N₀.toScheme)
      (_ : IsOpenImmersion jW)
      (yW : AffineSpace (ULift.{u} (Fin 1)) (Spec (.of (AlgebraicClosure F))) ⟶ W)
      (_ : yW ≫ jW = AffineSpace.map (ULift.{u} (Fin 1)) y₀)
      (G : W ⟶ wcTlAff F d)
      (_ : IsPullback yW (AffineSpace (ULift.{u} (Fin 1)) (Spec (.of (AlgebraicClosure F))) ↘
              Spec (.of (AlgebraicClosure F))) G (wcTlZero F d))
      (s₀ s₁ : N₀.toScheme ⟶ W),
      s₀ ≫ jW = AffineSpace.homOfVector (𝟙 _) (fun _ => 0) ∧
      s₁ ≫ jW = AffineSpace.homOfVector (𝟙 _) (fun _ => 1) ∧
      s₀ ≫ G = N₀.ι ≫ a ∧ s₁ ≫ G = N₀.ι ≫ b ≫ wcTlLin F d A :=
by
  classical
  have hca : ∀ {X₁ X₂ X₃ : Scheme.{u}} (f : X₁ ⟶ X₂) (g : X₂ ⟶ X₃) (x : Γ(X₃, ⊤)),
      (f ≫ g).appTop.hom x = f.appTop.hom (g.appTop.hom x) := by
    intro X₁ X₂ X₃ f g x; rw [Scheme.Hom.comp_appTop]; rfl



  have tlh_s3 : ∀ (k : Type u) [CommRing k] (σ : Type u) [Fintype σ] [DecidableEq σ]
      (B : Type u) [CommRing B]
      (φ : MvPolynomial σ k →+* B) (hφ : φ.Etale) (ε : B →+* k)
      (hεC : ∀ c : k, ε (φ (MvPolynomial.C c)) = c) (hεX : ∀ j, ε (φ (MvPolynomial.X j)) = 0)
      (c : σ → B) (hc : ∑ j, c j * φ (MvPolynomial.X j) = 0), ∀ j, ε (c j) = 0 := by
    intro k _ σ _ _ B _ φ hφ ε hεC hεX c hc j₀
    letI : Algebra (MvPolynomial σ k) B := φ.toAlgebra
    haveI : Algebra.Etale (MvPolynomial σ k) B := hφ
    let c₀ : MvPolynomial σ k →+* k := MvPolynomial.constantCoeff
    letI : Algebra (MvPolynomial σ k) k := c₀.toAlgebra
    let ψ : MvPolynomial σ k →+* DualNumber k :=
      MvPolynomial.eval₂Hom (TrivSqZeroExt.inlHom k k)
        (fun j => if j = j₀ then DualNumber.eps else 0)
    letI : Algebra (MvPolynomial σ k) (DualNumber k) := ψ.toAlgebra
    let fstR : DualNumber k →+* k := (TrivSqZeroExt.fstHom k k k).toRingHom
    have hfst : fstR.comp ψ = c₀ := by
      apply MvPolynomial.ringHom_ext
      · intro r
        simp [fstR, ψ, c₀]
      · intro j
        simp only [RingHom.comp_apply, ψ, c₀, MvPolynomial.eval₂Hom_X',
          MvPolynomial.constantCoeff_X]
        split_ifs <;> simp [fstR]
    have hεφ : ε.comp φ = c₀ := by
      apply MvPolynomial.ringHom_ext
      · intro r
        simp only [RingHom.comp_apply, hεC, c₀, MvPolynomial.constantCoeff_C]
      · intro j
        simp only [RingHom.comp_apply, hεX, c₀, MvPolynomial.constantCoeff_X]
    let g : DualNumber k →ₐ[MvPolynomial σ k] k :=
      { fstR with commutes' := fun r => RingHom.congr_fun hfst r }
    let f : B →ₐ[MvPolynomial σ k] k :=
      { ε with commutes' := fun r => RingHom.congr_fun hεφ r }
    have hsurj : Function.Surjective g := fun x => ⟨TrivSqZeroExt.inl x, rfl⟩
    have hnil : IsNilpotent (RingHom.ker g) := by
      refine ⟨2, ?_⟩
      rw [Submodule.zero_eq_bot, eq_bot_iff]
      show RingHom.ker g ^ (1 + 1) ≤ ⊥
      rw [Ideal.IsTwoSided.pow_succ, Submodule.pow_one, Ideal.mul_le]
      intro x hx y hy
      rw [RingHom.mem_ker] at hx hy
      have hx' : x.fst = 0 := hx
      have hy' : y.fst = 0 := hy
      rw [Ideal.mem_bot]
      refine TrivSqZeroExt.ext ?_ ?_
      · rw [TrivSqZeroExt.fst_mul, hx', zero_mul]; rfl
      · rw [TrivSqZeroExt.snd_mul, hx', hy']; simp
    let θ := Algebra.FormallySmooth.liftOfSurjective f g hsurj hnil
    have hθ : ∀ x, (θ x).fst = ε x := fun x =>
      Algebra.FormallySmooth.liftOfSurjective_apply f g hsurj hnil x
    have hθX : ∀ j, θ (φ (MvPolynomial.X j)) = ψ (MvPolynomial.X j) := fun j =>
      θ.commutes (MvPolynomial.X j)
    have h0 := congrArg θ hc
    rw [map_sum, map_zero] at h0
    simp only [map_mul, hθX, ψ, MvPolynomial.eval₂Hom_X', mul_ite, mul_zero, Finset.sum_ite_eq',
      Finset.mem_univ, if_true] at h0
    have h1 := congrArg TrivSqZeroExt.snd h0
    rw [TrivSqZeroExt.snd_mul, DualNumber.snd_eps, DualNumber.fst_eps, TrivSqZeroExt.snd_zero,
      hθ] at h1
    simpa using h1



  have tlh_s4 : ∀ (k : Type u) [CommRing k] (σ : Type u) [Fintype σ] [DecidableEq σ]
      (B : Type u) [CommRing B] (ε : B →+* k) (a b : σ → B)
      (ha : RingHom.ker ε = Ideal.span (Set.range a))
      (hb : RingHom.ker ε = Ideal.span (Set.range b))
      (hind : ∀ c : σ → B, ∑ j, c j * a j = 0 → ∀ j, ε (c j) = 0),
      ∃ M : Matrix σ σ B, (∀ i, b i = ∑ j, M i j * a j) ∧ IsUnit (ε.mapMatrix M).det := by
    intro k _ σ _ _ B _ ε a b ha hb hind
    have hbm : ∀ i, b i ∈ Ideal.span (Set.range a) := fun i => by
      rw [← ha, hb]; exact Ideal.subset_span ⟨i, rfl⟩
    have ham : ∀ i, a i ∈ Ideal.span (Set.range b) := fun i => by
      rw [← hb, ha]; exact Ideal.subset_span ⟨i, rfl⟩
    choose M hM using fun i => Ideal.mem_span_range_iff_exists_fun.mp (hbm i)
    choose M' hM' using fun i => Ideal.mem_span_range_iff_exists_fun.mp (ham i)
    refine ⟨Matrix.of M, fun i => (hM i).symm, ?_⟩
    apply Matrix.isUnit_det_of_left_inverse (B := ε.mapMatrix (Matrix.of M'))
    rw [← map_mul]
    ext j l
    have hrel : ∑ l, ((Matrix.of M' * Matrix.of M) j l - (1 : Matrix σ σ B) j l) * a l = 0 := by
      simp only [sub_mul, Finset.sum_sub_distrib, Matrix.mul_apply, Matrix.of_apply,
        Finset.sum_mul, Matrix.one_apply, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq,
        Finset.mem_univ, if_true]
      rw [Finset.sum_comm]
      simp only [mul_assoc, ← Finset.mul_sum, hM, hM' j, sub_self]
    have := hind _ hrel l
    rw [map_sub, sub_eq_zero] at this
    rw [RingHom.mapMatrix_apply, Matrix.map_apply, this, Matrix.one_apply, Matrix.one_apply]
    split_ifs <;> simp



  have tlh_s8 : ∀ {Z Y S B W : Scheme.{u}}
      (f : Z ⟶ Y) (g : Z ⟶ S) (p : Y ⟶ B) (y : S ⟶ B) (hpb : IsPullback f g p y)
      (j : W ⟶ Y) [Mono j] (fW : Z ⟶ W) (hfW : fW ≫ j = f), IsPullback fW g (j ≫ p) y := by
    intro Z Y S B W f g p y hpb j _ fW hfW
    have hw : fW ≫ j ≫ p = g ≫ y := by rw [← Category.assoc, hfW, hpb.w]
    refine IsPullback.of_isLimit (c := Limits.PullbackCone.mk _ _ hw)
      (Limits.PullbackCone.IsLimit.mk hw (fun s => hpb.lift (s.fst ≫ j) s.snd
        (by rw [Category.assoc]; exact s.condition)) ?_ ?_ ?_)
    · intro s
      rw [← cancel_mono j, Category.assoc, hfW, IsPullback.lift_fst]
    · intro s; exact IsPullback.lift_snd _ _ _ _
    · intro s m hm1 hm2
      apply hpb.hom_ext
      · rw [IsPullback.lift_fst, ← hfW, ← Category.assoc, hm1]
      · rw [IsPullback.lift_snd, hm2]



  have tlh_s2 : ∀ {K : Type u} [Field K] {σ : Type u} {N₁ : Scheme.{u}} [IsAffine N₁]
      (q₁ : N₁ ⟶ Spec (.of K)) (y₁ : Spec (.of K) ⟶ N₁) (v : σ → Γ(N₁, ⊤))
      (hpb : IsPullback y₁ (𝟙 _) (AffineSpace.homOfVector q₁ v)
        (AffineSpace.homOfVector (𝟙 (Spec (.of K))) 0)),
      RingHom.ker y₁.appTop.hom = Ideal.span (Set.range v) := by
    intro K _ σ N₁ _ q₁ y₁ v hpb
    apply le_antisymm
    · set I := Ideal.span (Set.range v) with hI
      let qI : Γ(N₁, ⊤) →+* Γ(N₁, ⊤) ⧸ I := Ideal.Quotient.mk I
      let ιQ : Spec (.of (Γ(N₁, ⊤) ⧸ I)) ⟶ N₁ :=
        Spec.map (CommRingCat.ofHom qI) ≫ N₁.isoSpec.inv
      have hk : ιQ.appTop ≫ (Scheme.ΓSpecIso (.of (Γ(N₁, ⊤) ⧸ I))).hom =
          CommRingCat.ofHom qI := by
        simp only [ιQ, Scheme.Hom.comp_appTop, Category.assoc, Scheme.ΓSpecIso_naturality]
        have e : N₁.isoSpec.inv.appTop ≫ (Scheme.ΓSpecIso Γ(N₁, ⊤)).hom = 𝟙 _ := by
          rw [← Scheme.toSpecΓ_appTop, ← Scheme.isoSpec_hom, ← Scheme.Hom.comp_appTop,
            Iso.hom_inv_id, Scheme.Hom.id_appTop]
        erw [← Category.assoc, e]
        rw [Category.id_comp]
      have hk' : ∀ z, (Scheme.ΓSpecIso (.of (Γ(N₁, ⊤) ⧸ I))).hom.hom
          (ιQ.appTop.hom z) = qI z := by
        intro z
        have := congrArg (fun f => f.hom z) hk
        simpa using this
      have hkill : ∀ z ∈ I, ιQ.appTop.hom z = 0 := by
        intro z hz
        have h1 := hk' z
        rw [show qI z = 0 from Ideal.Quotient.eq_zero_iff_mem.mpr hz] at h1
        have h2 := congrArg (Scheme.ΓSpecIso (.of (Γ(N₁, ⊤) ⧸ I))).inv.hom h1
        rw [map_zero] at h2
        rw [← h2]
        show _ = ((Scheme.ΓSpecIso _).hom ≫ (Scheme.ΓSpecIso _).inv).hom _
        rw [Iso.hom_inv_id]
        rfl
      have hw : ιQ ≫ AffineSpace.homOfVector q₁ v =
          (ιQ ≫ q₁) ≫ AffineSpace.homOfVector (𝟙 (Spec (.of K))) 0 := by
        rw [AffineSpace.comp_homOfVector, AffineSpace.comp_homOfVector, Category.comp_id]
        congr 1
        funext i
        simp only [Function.comp_apply, Pi.zero_apply, map_zero]
        exact hkill _ (Ideal.subset_span ⟨i, rfl⟩)
      have hγ := hpb.lift_fst ιQ (ιQ ≫ q₁) hw
      intro x hx
      rw [RingHom.mem_ker] at hx
      have h1 : ιQ.appTop.hom x = 0 := by rw [← hγ, hca, hx, map_zero]
      have h2 := hk' x
      rw [h1, map_zero] at h2
      exact Ideal.Quotient.eq_zero_iff_mem.mp h2.symm
    · rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      rw [SetLike.mem_coe, RingHom.mem_ker]
      have h := congrArg (fun f => f.appTop.hom (AffineSpace.coord (Spec (.of K)) i)) hpb.w
      simp only [hca, AffineSpace.homOfVector_appTop_coord] at h
      simpa using h



  have tlh_s5b : ∀ {K : Type u} [Field K] {σ : Type u} [Fintype σ] [DecidableEq σ]
      {N₀ X Z : Scheme.{u}} (q₀ : N₀ ⟶ Spec (.of K)) (y₀ : Spec (.of K) ⟶ N₀)
      (a : σ → Γ(N₀, ⊤))
      (hz : IsPullback y₀ (𝟙 _) (AffineSpace.homOfVector q₀ a)
        (AffineSpace.homOfVector (𝟙 (Spec (.of K))) 0))
      (p : X ⟶ N₀) (Q : Matrix σ σ Γ(X, ⊤)) (hQ : IsUnit Q.det)
      (z : Z ⟶ X) (ζ : Z ⟶ Spec (.of K)) (hpb : IsPullback z ζ p y₀),
      IsPullback z ζ (AffineSpace.homOfVector (p ≫ q₀)
          (fun i => ∑ j, Q i j * p.appTop.hom (a j)))
        (AffineSpace.homOfVector (𝟙 (Spec (.of K))) 0) := by
    intro K _ σ _ _ N₀ X Z q₀ y₀ a hz p Q hQ z ζ hpb
    have h1 : IsPullback z ζ (p ≫ AffineSpace.homOfVector q₀ a)
        (AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : σ → Γ(Spec (.of K), ⊤))) := by
      have := hpb.paste_vert hz
      rwa [Category.comp_id] at this
    have hH₀ : ∀ {T : Scheme.{u}} (β : T ⟶ Spec (.of K)),
        β ≫ AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : σ → Γ(Spec (.of K), ⊤)) =
          AffineSpace.homOfVector β 0 := by
      intro T β
      rw [AffineSpace.comp_homOfVector, Category.comp_id]
      congr 1; funext i; simp
    have hchar : ∀ {T : Scheme.{u}} (f β : T ⟶ Spec (.of K)) (w : σ → Γ(T, ⊤)),
        AffineSpace.homOfVector f w = AffineSpace.homOfVector β 0 ↔ f = β ∧ w = 0 := by
      intro T f β w
      constructor
      · intro h
        refine ⟨?_, ?_⟩
        · have := congrArg (· ≫ AffineSpace σ (Spec (.of K)) ↘ Spec (.of K)) h
          simpa only [AffineSpace.homOfVector_over] using this
        · funext i
          have := congrArg (fun g => g.appTop.hom (AffineSpace.coord (Spec (.of K)) i)) h
          simpa only [AffineSpace.homOfVector_appTop_coord] using this
      · rintro ⟨rfl, rfl⟩; rfl
    have hHα : ∀ {T : Scheme.{u}} (α : T ⟶ X),
        α ≫ AffineSpace.homOfVector (p ≫ q₀) (fun i => ∑ j, Q i j * p.appTop.hom (a j)) =
        AffineSpace.homOfVector (α ≫ p ≫ q₀)
          ((α.appTop.hom.mapMatrix Q).mulVec (fun j => α.appTop.hom (p.appTop.hom (a j)))) := by
      intro T α
      rw [AffineSpace.comp_homOfVector]
      congr 1; funext i
      simp only [Function.comp_apply, map_sum, map_mul, Matrix.mulVec, dotProduct,
        RingHom.mapMatrix_apply, Matrix.map_apply]
    have hH'α : ∀ {T : Scheme.{u}} (α : T ⟶ X), α ≫ p ≫ AffineSpace.homOfVector q₀ a =
        AffineSpace.homOfVector (α ≫ p ≫ q₀) (fun j => α.appTop.hom (p.appTop.hom (a j))) := by
      intro T α
      rw [← Category.assoc, AffineSpace.comp_homOfVector, Category.assoc]
      congr 1
    have hinj : ∀ {T : Scheme.{u}} (α : T ⟶ X) (w : σ → Γ(T, ⊤)),
        (α.appTop.hom.mapMatrix Q).mulVec w = 0 ↔ w = 0 := by
      intro T α w
      constructor
      · intro h
        have hu : IsUnit (α.appTop.hom.mapMatrix Q).det := by
          rw [← RingHom.map_det]; exact hQ.map _
        have e : (α.appTop.hom.mapMatrix Q).adjugate.mulVec
            ((α.appTop.hom.mapMatrix Q).mulVec w) = (α.appTop.hom.mapMatrix Q).det • w := by
          rw [Matrix.mulVec_mulVec, Matrix.adjugate_mul, Matrix.smul_mulVec, Matrix.one_mulVec]
        have h2 : (α.appTop.hom.mapMatrix Q).det • w = 0 := by
          rw [← e, h, Matrix.mulVec_zero]
        exact (hu.smul_eq_zero).mp h2
      · rintro rfl; exact Matrix.mulVec_zero _
    have hkey : ∀ {T : Scheme.{u}} (α : T ⟶ X) (β : T ⟶ Spec (.of K)),
        α ≫ AffineSpace.homOfVector (p ≫ q₀) (fun i => ∑ j, Q i j * p.appTop.hom (a j)) =
          β ≫ AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : σ → Γ(Spec (.of K), ⊤)) ↔
        α ≫ p ≫ AffineSpace.homOfVector q₀ a =
          β ≫ AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : σ → Γ(Spec (.of K), ⊤)) := by
      intro T α β
      rw [hHα, hH'α, hH₀, hchar, hchar, hinj]
    have hw := (hkey z ζ).mpr h1.w
    refine IsPullback.of_isLimit (c := Limits.PullbackCone.mk _ _ hw)
      (Limits.PullbackCone.IsLimit.mk hw
        (fun s => h1.lift s.fst s.snd ((hkey _ _).mp s.condition)) ?_ ?_ ?_)
    · intro s; exact h1.lift_fst _ _ _
    · intro s; exact h1.lift_snd _ _ _
    · intro s m hm1 hm2
      apply h1.hom_ext
      · rw [h1.lift_fst]; exact hm1
      · rw [h1.lift_snd]; exact hm2



  have tlh_s1 : ∀ {n : Type u} {S N : Scheme.{u}} [IsAffine S] [IsAffine N]
      (q : N ⟶ S) (v : n → Γ(N, ⊤)) (h : Etale (AffineSpace.homOfVector q v)),
      (MvPolynomial.eval₂Hom q.appTop.hom v).Etale := by
    intro n S N _ _ q v h
    haveI := h
    have h2 : Etale (AffineSpace.homOfVector q v ≫ (AffineSpace.isoOfIsAffine n S).hom) :=
      inferInstance
    rw [HasRingHomProperty.iff_of_isAffine (P := @Etale), Scheme.Hom.comp_appTop,
      AffineSpace.isoOfIsAffine_hom_appTop, Category.assoc, CommRingCat.hom_comp,
      RingHom.RespectsIso.cancel_left_isIso RingHom.Etale.respectsIso, CommRingCat.hom_comp,
      CommRingCat.hom_ofHom, MvPolynomial.comp_eval₂Hom] at h2
    convert h2 using 2
    · rw [← CommRingCat.hom_comp, ← Scheme.Hom.comp_appTop, AffineSpace.homOfVector_over]
    · funext i
      exact (AffineSpace.homOfVector_appTop_coord _ _ _).symm



  have tlh_s6 : ∀ {Y : Scheme.{u}} (N₁ : Y.Opens) (hN₁ : IsAffineOpen N₁)
      (r : Γ(N₁.toScheme, ⊤)),
      ∃ (N₀ : Y.Opens) (hN₀₁ : N₀ ≤ N₁), IsAffineOpen N₀ ∧
        IsUnit ((Y.homOfLE hN₀₁).appTop.hom r) ∧
        ∀ (T : Scheme.{u}) (s : T ⟶ N₁.toScheme), IsUnit (s.appTop.hom r) →
          Set.range ⇑(s ≫ N₁.ι) ⊆ (N₀ : Set Y) := by
    intro Y N₁ hN₁ r
    have hNe : N₁.ι ''ᵁ (N₁.toScheme).basicOpen r = Y.basicOpen r :=
      Scheme.Opens.ι_image_basicOpen N₁ r
    have hT : N₁.ι ''ᵁ ⊤ = N₁ := Scheme.Opens.ι_image_top N₁
    have hA : IsAffineOpen (N₁.ι ''ᵁ ⊤) := by rw [hT]; exact hN₁
    have hle : Y.basicOpen r ≤ N₁ := (Y.basicOpen_le r).trans hT.le
    refine ⟨Y.basicOpen r, hle, hA.basicOpen r, ?_, ?_⟩
    · have hT' : (Y.basicOpen r).ι ''ᵁ ⊤ = Y.basicOpen r := Scheme.Opens.ι_image_top _
      have hle' : (Y.basicOpen r).ι ''ᵁ ⊤ ≤ N₁.ι ''ᵁ ⊤ := by rw [hT', hT]; exact hle
      have hloc := hA.isLocalization_of_eq_basicOpen r (homOfLE hle') hT'
      have hloc' : @IsLocalization.Away _ _ r Γ((Y.basicOpen r).toScheme, ⊤) _
          (Y.homOfLE hle).appTop.hom.toAlgebra := by
        rw [Scheme.homOfLE_appTop]
        exact hloc
      letI : Algebra Γ(N₁.toScheme, ⊤) Γ((Y.basicOpen r).toScheme, ⊤) :=
        (Y.homOfLE hle).appTop.hom.toAlgebra
      exact IsLocalization.Away.algebraMap_isUnit r
    · intro T s hs
      rintro _ ⟨x, rfl⟩
      rw [← hNe]
      refine ⟨s x, ?_, rfl⟩
      have h1 : s ⁻¹ᵁ (N₁.toScheme).basicOpen r = ⊤ := by
        rw [Scheme.Hom.preimage_basicOpen]
        exact T.basicOpen_of_isUnit hs
      have h2 : x ∈ s ⁻¹ᵁ (N₁.toScheme).basicOpen r := by rw [h1]; trivial
      exact h2



  have tlh_s5a : ∀ (K : Type u) [Field K] {σ : Type u} [Fintype σ] [DecidableEq σ]
      (N₀ : Scheme.{u}) (y₀ : Spec (.of K) ⟶ N₀)
      (P : Matrix σ σ Γ(N₀, ⊤)) (hP1 : y₀.appTop.hom.mapMatrix P = 1) (hPdet : IsUnit P.det),
      ∃ (W : (AffineSpace (ULift.{u} (Fin 1)) N₀).Opens) (Q : Matrix σ σ Γ(W.toScheme, ⊤))
        (yW : AffineSpace (ULift.{u} (Fin 1)) (Spec (.of K)) ⟶ W.toScheme)
        (s₀ s₁ : N₀ ⟶ W.toScheme),
        IsUnit Q.det ∧
        yW ≫ W.ι = AffineSpace.map (ULift.{u} (Fin 1)) y₀ ∧
        s₀ ≫ W.ι = AffineSpace.homOfVector (𝟙 N₀) (fun _ => 0) ∧
        s₁ ≫ W.ι = AffineSpace.homOfVector (𝟙 N₀) (fun _ => 1) ∧
        s₀.appTop.hom.mapMatrix Q = 1 ∧ s₁.appTop.hom.mapMatrix Q = P := by
    intro K _ σ _ _ N₀ y₀ P hP1 hPdet
    have hmm : ∀ {X₁ X₂ X₃ : Scheme.{u}} (f : X₁ ⟶ X₂) (g : X₂ ⟶ X₃)
        (M : Matrix σ σ Γ(X₃, ⊤)),
        (f ≫ g).appTop.hom.mapMatrix M = f.appTop.hom.mapMatrix (g.appTop.hom.mapMatrix M) := by
      intro X₁ X₂ X₃ f g M; ext i j
      simp only [RingHom.mapMatrix_apply, Matrix.map_apply, hca]
    have hid : ∀ {X₁ : Scheme.{u}} (M : Matrix σ σ Γ(X₁, ⊤)),
        (𝟙 X₁ : X₁ ⟶ X₁).appTop.hom.mapMatrix M = M := by
      intro X₁ M; ext i j
      simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Scheme.Hom.id_appTop]; rfl
    obtain ⟨Qt, hQt⟩ : ∃ Qt : Matrix σ σ Γ(AffineSpace (ULift.{u} (Fin 1)) N₀, ⊤),
        Qt = 1 + (AffineSpace.coord N₀ (⟨0⟩ : ULift.{u} (Fin 1))) •
          ((AffineSpace (ULift.{u} (Fin 1)) N₀ ↘ N₀).appTop.hom.mapMatrix P - 1) := ⟨_, rfl⟩
    have hpull : ∀ {T : Scheme.{u}} (e : T ⟶ AffineSpace (ULift.{u} (Fin 1)) N₀),
        e.appTop.hom.mapMatrix Qt =
          1 + (e.appTop.hom (AffineSpace.coord N₀ (⟨0⟩ : ULift.{u} (Fin 1)))) •
          ((e ≫ (AffineSpace (ULift.{u} (Fin 1)) N₀ ↘ N₀)).appTop.hom.mapMatrix P - 1) := by
      intro T e
      rw [hQt]
      ext i j
      simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.add_apply, Matrix.smul_apply,
        Matrix.sub_apply, smul_eq_mul, map_add, map_mul, map_sub, hca]
      by_cases hij : i = j
      · subst hij; simp only [Matrix.one_apply_eq, map_one]
      · simp only [Matrix.one_apply_ne hij, map_zero]
    have hunitW : IsUnit (((AffineSpace (ULift.{u} (Fin 1)) N₀).basicOpen Qt.det).ι.appTop.hom
        Qt.det) := by
      have key : ∀ (V : (AffineSpace (ULift.{u} (Fin 1)) N₀).Opens)
          (hV : V ≤ (AffineSpace (ULift.{u} (Fin 1)) N₀).basicOpen Qt.det),
          IsUnit (((AffineSpace (ULift.{u} (Fin 1)) N₀).presheaf.map (homOfLE (hV.trans
            ((AffineSpace (ULift.{u} (Fin 1)) N₀).basicOpen_le Qt.det))).op).hom Qt.det) := by
        intro V hV
        have e : (AffineSpace (ULift.{u} (Fin 1)) N₀).presheaf.map (homOfLE (hV.trans
            ((AffineSpace (ULift.{u} (Fin 1)) N₀).basicOpen_le Qt.det))).op =
            (AffineSpace (ULift.{u} (Fin 1)) N₀).presheaf.map
              (homOfLE ((AffineSpace (ULift.{u} (Fin 1)) N₀).basicOpen_le Qt.det)).op ≫
            (AffineSpace (ULift.{u} (Fin 1)) N₀).presheaf.map (homOfLE hV).op := by
          rw [← Functor.map_comp]; rfl
        rw [e, CommRingCat.hom_comp, RingHom.comp_apply]
        exact (RingedSpace.isUnit_res_basicOpen
          (AffineSpace (ULift.{u} (Fin 1)) N₀).toRingedSpace Qt.det).map _
      rw [Scheme.Opens.ι_appTop]
      exact key _ (Scheme.Opens.ι_image_top _).le
    have hrng : ∀ {T : Scheme.{u}} (e : T ⟶ AffineSpace (ULift.{u} (Fin 1)) N₀),
        IsUnit (e.appTop.hom Qt.det) →
        Set.range ⇑e ⊆ Set.range ⇑((AffineSpace (ULift.{u} (Fin 1)) N₀).basicOpen Qt.det).ι := by
      intro T e he
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨x, rfl⟩
      have h1 : e ⁻¹ᵁ (AffineSpace (ULift.{u} (Fin 1)) N₀).basicOpen Qt.det = ⊤ := by
        rw [Scheme.Hom.preimage_basicOpen]; exact T.basicOpen_of_isUnit he
      have h2 : x ∈ e ⁻¹ᵁ (AffineSpace (ULift.{u} (Fin 1)) N₀).basicOpen Qt.det := by
        rw [h1]; trivial
      exact h2
    have hdet1 : ∀ {T : Scheme.{u}} (e : T ⟶ AffineSpace (ULift.{u} (Fin 1)) N₀),
        e.appTop.hom.mapMatrix Qt = 1 → IsUnit (e.appTop.hom Qt.det) := by
      intro T e he; rw [RingHom.map_det, he, Matrix.det_one]; exact isUnit_one
    have hσ : ∀ c : Γ(N₀, ⊤),
        (AffineSpace.homOfVector (𝟙 N₀)
          (fun _ : ULift.{u} (Fin 1) => c)).appTop.hom.mapMatrix Qt = 1 + c • (P - 1) := by
      intro c
      rw [hpull, AffineSpace.homOfVector_appTop_coord, AffineSpace.homOfVector_over, hid]
    have hσ0 : (AffineSpace.homOfVector (𝟙 N₀)
        (fun _ : ULift.{u} (Fin 1) => (0 : Γ(N₀, ⊤)))).appTop.hom.mapMatrix Qt = 1 := by
      rw [hσ, zero_smul, add_zero]
    have hσ1 : (AffineSpace.homOfVector (𝟙 N₀)
        (fun _ : ULift.{u} (Fin 1) => (1 : Γ(N₀, ⊤)))).appTop.hom.mapMatrix Qt = P := by
      rw [hσ, one_smul, add_sub_cancel]
    have hmap : (AffineSpace.map (ULift.{u} (Fin 1)) y₀).appTop.hom.mapMatrix Qt = 1 := by
      rw [hpull, AffineSpace.map_over, hmm, hP1, map_one, sub_self, smul_zero, add_zero]
    refine ⟨(AffineSpace (ULift.{u} (Fin 1)) N₀).basicOpen Qt.det,
      ((AffineSpace (ULift.{u} (Fin 1)) N₀).basicOpen Qt.det).ι.appTop.hom.mapMatrix Qt,
      IsOpenImmersion.lift _ _ (hrng _ (hdet1 _ hmap)),
      IsOpenImmersion.lift _ _ (hrng _ (hdet1 _ hσ0)),
      IsOpenImmersion.lift _ _ (hrng _ (by rw [RingHom.map_det, hσ1]; exact hPdet)),
      ?_, IsOpenImmersion.lift_fac _ _ _, IsOpenImmersion.lift_fac _ _ _,
      IsOpenImmersion.lift_fac _ _ _, ?_, ?_⟩
    · rw [← RingHom.map_det]; exact hunitW
    · rw [← hmm, IsOpenImmersion.lift_fac, hσ0]
    · rw [← hmm, IsOpenImmersion.lift_fac, hσ1]



  have hcoordN : ∀ (c : N ⟶ wcTlAff F d), c ≫ wcTlStr F d = q → ∀ {T : Scheme.{u}} (f : T ⟶ N),
      f ≫ c = AffineSpace.homOfVector (f ≫ q) (fun j => (f ≫ c).appTop.hom
        (AffineSpace.coord (Spec (.of (AlgebraicClosure F))) j)) := by
    intro c hc T f
    apply AffineSpace.hom_ext
    · rw [AffineSpace.homOfVector_over, Category.assoc]
      exact congrArg (f ≫ ·) hc
    · intro i; rw [AffineSpace.homOfVector_appTop_coord]
  have hyq : yN ≫ q = 𝟙 _ := by
    rw [← haq, ← Category.assoc, hpa.w, Category.id_comp]
    exact AffineSpace.homOfVector_over _ _
  have hΓ : ∀ x, (Scheme.ΓSpecIso (.of (AlgebraicClosure F))).inv.hom
      ((Scheme.ΓSpecIso (.of (AlgebraicClosure F))).hom.hom x) = x := by
    intro x
    rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, Iso.hom_inv_id]; rfl

  let pt : Spec (.of (AlgebraicClosure F)) := default
  have hrange : ∀ V : N.Opens, yN pt ∈ V → Set.range ⇑yN ⊆ Set.range ⇑V.ι := by
    rintro V hV _ ⟨x, rfl⟩
    rw [Scheme.Opens.range_ι, Subsingleton.elim x pt]
    exact hV
  obtain ⟨N₁, hN₁, hzN₁, -⟩ := exists_isAffineOpen_mem_and_subset
    (show yN pt ∈ (⊤ : N.Opens) from trivial)
  haveI : IsAffine N₁.toScheme := hN₁
  obtain ⟨y₁, hy₁⟩ : ∃ y₁ : Spec (.of (AlgebraicClosure F)) ⟶ N₁.toScheme, y₁ ≫ N₁.ι = yN :=
    ⟨IsOpenImmersion.lift N₁.ι yN (hrange N₁ hzN₁), IsOpenImmersion.lift_fac _ _ _⟩

  obtain ⟨αv, hαv⟩ : ∃ v : ULift.{u} (Fin d) → Γ(N₁.toScheme, ⊤), v = fun j =>
      (N₁.ι ≫ a).appTop.hom (AffineSpace.coord (Spec (.of (AlgebraicClosure F))) j) := ⟨_, rfl⟩
  obtain ⟨βv, hβv⟩ : ∃ v : ULift.{u} (Fin d) → Γ(N₁.toScheme, ⊤), v = fun j =>
      (N₁.ι ≫ b).appTop.hom (AffineSpace.coord (Spec (.of (AlgebraicClosure F))) j) := ⟨_, rfl⟩
  have hA₁ : N₁.ι ≫ a = AffineSpace.homOfVector (N₁.ι ≫ q) αv := by
    rw [hαv]; exact hcoordN a haq N₁.ι
  have hB₁ : N₁.ι ≫ b = AffineSpace.homOfVector (N₁.ι ≫ q) βv := by
    rw [hβv]; exact hcoordN b hbq N₁.ι

  have hpa₁ : IsPullback y₁ (𝟙 _) (AffineSpace.homOfVector (N₁.ι ≫ q) αv) (wcTlZero F d) := by
    rw [← hA₁]; exact tlh_s8 yN (𝟙 _) a (wcTlZero F d) hpa N₁.ι y₁ hy₁
  have hpb₁ : IsPullback y₁ (𝟙 _) (AffineSpace.homOfVector (N₁.ι ≫ q) βv) (wcTlZero F d) := by
    rw [← hB₁]; exact tlh_s8 yN (𝟙 _) b (wcTlZero F d) hpb N₁.ι y₁ hy₁
  have hkA := tlh_s2 (N₁.ι ≫ q) y₁ αv hpa₁
  have hkB := tlh_s2 (N₁.ι ≫ q) y₁ βv hpb₁

  haveI : Etale a := ha
  have hetA : Etale (AffineSpace.homOfVector (N₁.ι ≫ q) αv) := by
    rw [← hA₁]; infer_instance
  have hφ := tlh_s1 (N₁.ι ≫ q) αv hetA
  have hsec₁ : ∀ x, y₁.appTop.hom ((N₁.ι ≫ q).appTop.hom x) = x := by
    intro x
    rw [← hca, ← Category.assoc, hy₁, hyq, Scheme.Hom.id_appTop]; rfl
  have hind : ∀ c : ULift.{u} (Fin d) → Γ(N₁.toScheme, ⊤), ∑ j, c j * αv j = 0 →
      ∀ j, y₁.appTop.hom (c j) = 0 := by
    intro c hc
    refine tlh_s3 _ _ _ _ hφ y₁.appTop.hom ?_ ?_ c ?_
    · intro c'; rw [MvPolynomial.eval₂Hom_C]; exact hsec₁ c'
    · intro j
      rw [MvPolynomial.eval₂Hom_X', ← RingHom.mem_ker, hkA]
      exact Ideal.subset_span ⟨j, rfl⟩
    · simp only [MvPolynomial.eval₂Hom_X']; exact hc

  obtain ⟨M, hM, hMdet⟩ := tlh_s4 _ _ _ y₁.appTop.hom αv βv hkA hkB hind

  obtain ⟨N₀, hN₀₁, hN₀, hρu, hpts⟩ := tlh_s6 N₁ hN₁ M.det
  haveI : IsAffine N₀.toScheme := hN₀
  have hyN₀ : Set.range ⇑yN ⊆ Set.range ⇑N₀.ι := by
    rw [Scheme.Opens.range_ι, ← hy₁]
    exact hpts _ y₁ (by rw [RingHom.map_det]; exact hMdet)
  obtain ⟨y₀, hy₀⟩ : ∃ y₀ : Spec (.of (AlgebraicClosure F)) ⟶ N₀.toScheme, y₀ ≫ N₀.ι = yN :=
    ⟨IsOpenImmersion.lift N₀.ι yN hyN₀, IsOpenImmersion.lift_fac _ _ _⟩
  have hy₀₁ : y₀ ≫ N.homOfLE hN₀₁ = y₁ := by
    rw [← cancel_mono N₁.ι, Category.assoc, Scheme.homOfLE_ι, hy₀, hy₁]
  obtain ⟨α0, hα0⟩ : ∃ v : ULift.{u} (Fin d) → Γ(N₀.toScheme, ⊤),
      v = fun j => (N.homOfLE hN₀₁).appTop.hom (αv j) := ⟨_, rfl⟩
  obtain ⟨β0, hβ0⟩ : ∃ v : ULift.{u} (Fin d) → Γ(N₀.toScheme, ⊤),
      v = fun j => (N.homOfLE hN₀₁).appTop.hom (βv j) := ⟨_, rfl⟩
  have hA₀ : N₀.ι ≫ a = AffineSpace.homOfVector (N₀.ι ≫ q) α0 := by
    rw [hα0, ← Scheme.homOfLE_ι N hN₀₁]
    simp only [Category.assoc]
    rw [hA₁, AffineSpace.comp_homOfVector]
    rfl
  have hB₀ : N₀.ι ≫ b = AffineSpace.homOfVector (N₀.ι ≫ q) β0 := by
    rw [hβ0, ← Scheme.homOfLE_ι N hN₀₁]
    simp only [Category.assoc]
    rw [hB₁, AffineSpace.comp_homOfVector]
    rfl
  have hpaz : IsPullback y₀ (𝟙 _) (AffineSpace.homOfVector (N₀.ι ≫ q) α0) (wcTlZero F d) := by
    rw [← hA₀]; exact tlh_s8 yN (𝟙 _) a (wcTlZero F d) hpa N₀.ι y₀ hy₀
  have hερ : ∀ x, y₀.appTop.hom ((N.homOfLE hN₀₁).appTop.hom x) = y₁.appTop.hom x := by
    intro x; rw [← hca, hy₀₁]
  have hsec₀ : ∀ x, y₀.appTop.hom ((N₀.ι ≫ q).appTop.hom x) = x := by
    intro x
    rw [← hca, ← Category.assoc, hy₀, hyq, Scheme.Hom.id_appTop]; rfl
  have hβM : ∀ i, β0 i = ∑ j, (N.homOfLE hN₀₁).appTop.hom (M i j) * α0 j := by
    intro i
    rw [hβ0, hα0]
    simp only [hM i, map_sum, map_mul]

  obtain ⟨A₀, hA₀def⟩ : ∃ A₀ : Matrix (ULift.{u} (Fin d)) (ULift.{u} (Fin d))
      Γ(Spec (.of (AlgebraicClosure F)), ⊤), A₀ = y₁.appTop.hom.mapMatrix M := ⟨_, rfl⟩
  have hA₀u : IsUnit A₀.det := by rw [hA₀def]; exact hMdet
  obtain ⟨P, hP⟩ : ∃ P : Matrix (ULift.{u} (Fin d)) (ULift.{u} (Fin d)) Γ(N₀.toScheme, ⊤),
      P = (N₀.ι ≫ q).appTop.hom.mapMatrix A₀⁻¹ * (N.homOfLE hN₀₁).appTop.hom.mapMatrix M :=
    ⟨_, rfl⟩
  have hP1 : y₀.appTop.hom.mapMatrix P = 1 := by
    have e1 : y₀.appTop.hom.mapMatrix ((N₀.ι ≫ q).appTop.hom.mapMatrix A₀⁻¹) = A₀⁻¹ := by
      ext i j; simp only [RingHom.mapMatrix_apply, Matrix.map_apply, hsec₀]
    have e2 : y₀.appTop.hom.mapMatrix ((N.homOfLE hN₀₁).appTop.hom.mapMatrix M) = A₀ := by
      ext i j; simp only [hA₀def, RingHom.mapMatrix_apply, Matrix.map_apply, hερ]
    rw [hP, map_mul, e1, e2, Matrix.nonsing_inv_mul _ hA₀u]
  have hPdet : IsUnit P.det := by
    rw [hP, Matrix.det_mul, ← RingHom.map_det, ← RingHom.map_det]
    exact ((Matrix.isUnit_nonsing_inv_det _ hA₀u).map _).mul hρu

  obtain ⟨W, Q, yW, s₀, s₁, hQ, hyW, hs₀, hs₁, hQ0, hQ1⟩ :=
    tlh_s5a (AlgebraicClosure F) N₀.toScheme y₀ P hP1 hPdet

  have hzW := tlh_s8 _ _ _ _ (AffineSpace.isPullback_map (n := ULift.{u} (Fin 1)) y₀) W.ι yW hyW
  have hG := tlh_s5b (N₀.ι ≫ q) y₀ α0 hpaz _ Q hQ yW _ hzW

  have hsp : ∀ (s : N₀.toScheme ⟶ W.toScheme) (c : Γ(N₀.toScheme, ⊤)),
      s ≫ W.ι = AffineSpace.homOfVector (𝟙 _) (fun _ : ULift.{u} (Fin 1) => c) →
      s ≫ W.ι ≫ (AffineSpace (ULift.{u} (Fin 1)) N₀.toScheme ↘ N₀.toScheme) = 𝟙 _ := by
    intro s c hs
    rw [← Category.assoc, hs, AffineSpace.homOfVector_over]
  have hspa : ∀ (s : N₀.toScheme ⟶ W.toScheme) (c : Γ(N₀.toScheme, ⊤)),
      s ≫ W.ι = AffineSpace.homOfVector (𝟙 _) (fun _ : ULift.{u} (Fin 1) => c) →
      ∀ {Z : Scheme.{u}} (h : N₀.toScheme ⟶ Z),
      s ≫ W.ι ≫ (AffineSpace (ULift.{u} (Fin 1)) N₀.toScheme ↘ N₀.toScheme) ≫ h = h := by
    intro s c hs Z h
    simp only [← Category.assoc]
    rw [hs, AffineSpace.homOfVector_over, Category.id_comp]
  have hQ0' : ∀ i j, s₀.appTop.hom (Q i j) = (1 : Matrix (ULift.{u} (Fin d)) (ULift.{u} (Fin d))
      Γ(N₀.toScheme, ⊤)) i j := fun i j => by rw [← hQ0]; rfl
  have hQ1' : ∀ i j, s₁.appTop.hom (Q i j) = P i j := fun i j => by rw [← hQ1]; rfl
  have key : ∀ i, ∑ j, P i j * α0 j =
      ∑ k, (N₀.ι ≫ q).appTop.hom (A₀⁻¹ i k) * β0 k := by
    intro i
    simp only [hP, hβM, Matrix.mul_apply, RingHom.mapMatrix_apply, Matrix.map_apply,
      Finset.sum_mul, Finset.mul_sum, mul_assoc]
    exact Finset.sum_comm
  refine ⟨N₀, hN₀, y₀, hy₀,
    (Scheme.ΓSpecIso (.of (AlgebraicClosure F))).hom.hom.mapMatrix A₀⁻¹, ?_, W.toScheme, W.ι,
    inferInstance, yW, hyW, _, hG, s₀, s₁, hs₀, hs₁, ?_, ?_⟩
  · rw [← RingHom.map_det]; exact (Matrix.isUnit_nonsing_inv_det _ hA₀u).map _
  · rw [hA₀, AffineSpace.comp_homOfVector]
    congr 1
    · simp only [Category.assoc]
      rw [hspa s₀ 0 hs₀]
    · funext i
      simp only [Function.comp_apply, map_sum, map_mul, ← hca, hsp s₀ 0 hs₀,
        Scheme.Hom.id_appTop, CommRingCat.hom_id, RingHom.id_apply, hQ0', Matrix.one_apply,
        ite_mul, one_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, if_true]
  · rw [← Category.assoc N₀.ι b, hB₀]
    unfold wcTlLin
    rw [AffineSpace.comp_homOfVector, AffineSpace.comp_homOfVector, AffineSpace.homOfVector_over]
    congr 1
    · simp only [Category.assoc]
      rw [hspa s₁ 1 hs₁]
    · funext i
      simp only [Function.comp_apply, map_sum, map_mul, ← hca, hsp s₁ 1 hs₁,
        Scheme.Hom.id_appTop, CommRingCat.hom_id, RingHom.id_apply, hQ1',
        AffineSpace.homOfVector_over, AffineSpace.homOfVector_appTop_coord,
        RingHom.mapMatrix_apply, Matrix.map_apply, hΓ]
      exact key i

theorem wc_tl_orientation_indep (F : Type u) [Finite F] [Field F] (d : ℕ)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    {N : Scheme.{u}} (q : N ⟶ Spec (.of (AlgebraicClosure F)))
    (a b : N ⟶ wcTlAff F d) (ha : Etale a) (hb : Etale b)
    (haq : a ≫ wcTlStr F d = q) (hbq : b ≫ wcTlStr F d = q)
    (yN : Spec (.of (AlgebraicClosure F)) ⟶ N)
    (hpa : IsPullback yN (𝟙 _) a (wcTlZero F d)) (hpb : IsPullback yN (𝟙 _) b (wcTlZero F d))
    (D0 : wcHMPullData (wcTlZero F d) ℓ) (hD0 : wcHMPullCanonical D0)
    (Da : wcHMPullData a ℓ) (hDa : wcHMPullCanonical Da)
    (Db : wcHMPullData b ℓ) (hDb : wcHMPullCanonical Db)
    (DN : wcHMPullData yN ℓ) (hDN : wcHMPullCanonical DN)
    (κa : wcSuppObj DN ⟶ Da.Φ.obj (wcSuppObj D0)) (κb : wcSuppObj DN ⟶ Db.Φ.obj (wcSuppObj D0))
    (hκa : wcSuppUnitMap DN ≫ κa = Da.μ.inv ≫ Da.Φ.map (wcSuppUnitMap D0))
    (hκb : wcSuppUnitMap DN ≫ κb = Db.μ.inv ≫ Db.Φ.map (wcSuppUnitMap D0))
    (τ : wcSuppExt D0 (2 * d)) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf N ℓ)) := HasExt.standard _
    (Abelian.Ext.mk₀ κa).comp (wcSuppPullExt D0 Da (2 * d) τ) (zero_add _) =
      (Abelian.Ext.mk₀ κb).comp (wcSuppPullExt D0 Db (2 * d) τ) (zero_add _) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf N ℓ)) := HasExt.standard _

  have hℓK : ((ℓ : ℕ) : AlgebraicClosure F) ≠ 0 := by
    intro h0
    haveI := Fintype.ofFinite F
    have hc : ((Nat.card F : ℕ) : F) = 0 := by
      rw [Nat.card_eq_fintype_card]
      first
        | exact CharP.cast_card_eq_zero F
        | exact FiniteField.cast_card_eq_zero F
    have hc' : ((Nat.card F : ℕ) : AlgebraicClosure F) = 0 := by
      have := congrArg (algebraMap F (AlgebraicClosure F)) hc
      rwa [map_natCast, map_zero] at this
    have hcop : Nat.Coprime ℓ (Nat.card F) :=
      (Nat.Prime.coprime_iff_not_dvd (Fact.out : Nat.Prime ℓ)).mpr hℓ
    obtain ⟨x, y, hxy⟩ := Nat.isCoprime_iff_coprime.mpr hcop
    have := congrArg (Int.cast : ℤ → AlgebraicClosure F) hxy
    simp only [Int.cast_add, Int.cast_mul, Int.cast_natCast, Int.cast_one, h0, hc', mul_zero,
      add_zero] at this
    exact zero_ne_one this

  have hz : wcTlZero F d ≫ wcTlStr F d = 𝟙 _ := AffineSpace.homOfVector_over _ _
  haveI : IsClosedImmersion (wcTlZero F d ≫ wcTlStr F d) := by rw [hz]; infer_instance
  haveI : IsClosedImmersion (wcTlZero F d) := IsClosedImmersion.of_comp _ (wcTlStr F d)
  haveI : Etale a := ha
  haveI : IsLocallyNoetherian (wcTlAff F d) := by
    first
      | exact LocallyOfFiniteType.isLocallyNoetherian (wcTlStr F d)
      | exact LocallyOfFiniteType.isLocallyNoetherian (f := wcTlStr F d)
      | infer_instance
  haveI : IsLocallyNoetherian N := by
    first
      | exact LocallyOfFiniteType.isLocallyNoetherian a
      | exact LocallyOfFiniteType.isLocallyNoetherian (f := a)
  haveI : IsClosedImmersion yN :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hpa.flip
      (inferInstance : IsClosedImmersion (wcTlZero F d))

  obtain ⟨N₀, hN₀, y₀, hy₀, A, hA, W, jW, hjW, yW, hyW, G, hG, s₀, s₁, hs₀, hs₁, hG₀, hG₁⟩ :=
    wc_tl_linear_homotopy_chart F d q a b ha hb haq hbq yN hpa hpb
  haveI := hN₀
  haveI := hjW
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf N₀.toScheme ℓ)) := HasExt.standard _
  haveI : IsClosedImmersion (y₀ ≫ N₀.ι) := by rw [hy₀]; infer_instance
  haveI : IsClosedImmersion y₀ := IsClosedImmersion.of_comp y₀ N₀.ι

  obtain ⟨Dy₀, hDy₀⟩ := wc_hm_pull_data_exists y₀ ℓ
  obtain ⟨Dι, hDι⟩ := wc_hm_pull_data_exists N₀.ι ℓ
  obtain ⟨Dk0, hDk0⟩ := wc_hm_pull_data_exists (N₀.ι ≫ a) ℓ
  obtain ⟨DA, hDA⟩ := wc_hm_pull_data_exists (wcTlLin F d A) ℓ
  obtain ⟨DbA, hDbA⟩ := wc_hm_pull_data_exists (b ≫ wcTlLin F d A) ℓ
  obtain ⟨Dk1, hDk1⟩ := wc_hm_pull_data_exists (N₀.ι ≫ b ≫ wcTlLin F d A) ℓ

  obtain ⟨κι, hκι, hbij⟩ :=
    wc_supp_open_excision_exists yN N₀.ι y₀ hy₀ DN hDN Dy₀ hDy₀ Dι hDι

  obtain ⟨κ0', hκ0', E1⟩ := wc_supp_pull_comp_exists a N₀.ι (N₀.ι ≫ a) rfl D0 DN Dy₀
    Da hDa Dι hDι Dk0 hDk0 κa hκa κι hκι
  obtain ⟨κA, hκA, hAτ⟩ := wc_tl_linear_trivial_exists F d ℓ A hA D0 hD0 DA hDA
    (wc_tl_zero_supp_line F d ℓ hℓ D0 hD0)
  obtain ⟨κbA, hκbA, E2⟩ := wc_supp_pull_comp_exists (wcTlLin F d A) b (b ≫ wcTlLin F d A) rfl
    D0 D0 DN DA hDA Db hDb DbA hDbA κA hκA κb hκb
  obtain ⟨κ1', hκ1', E3⟩ := wc_supp_pull_comp_exists (b ≫ wcTlLin F d A) N₀.ι
    (N₀.ι ≫ b ≫ wcTlLin F d A) rfl D0 DN Dy₀ DbA hDbA Dι hDι Dk1 hDk1 κbA hκbA κι hκι

  have H := wc_supp_homotopy_sections_agree (AlgebraicClosure F) ℓ hℓK (N₀.ι ≫ q) y₀ jW yW hyW
    (wcTlZero F d) G
    (AffineSpace (ULift.{u} (Fin 1)) (Spec (.of (AlgebraicClosure F))) ↘
      Spec (.of (AlgebraicClosure F))) hG s₀ s₁ hs₀ hs₁ (N₀.ι ≫ a) (N₀.ι ≫ b ≫ wcTlLin F d A)
    hG₀ hG₁ D0 hD0 Dy₀ hDy₀ Dk0 hDk0 Dk1 hDk1 κ0' hκ0' κ1' hκ1' (2 * d) τ
  have hchain :
      (Abelian.Ext.mk₀ κι).comp (wcSuppPullExt DN Dι (2 * d)
        ((Abelian.Ext.mk₀ κa).comp (wcSuppPullExt D0 Da (2 * d) τ) (zero_add _))) (zero_add _) =
      (Abelian.Ext.mk₀ κι).comp (wcSuppPullExt DN Dι (2 * d)
        ((Abelian.Ext.mk₀ κb).comp (wcSuppPullExt D0 Db (2 * d) τ) (zero_add _))) (zero_add _) := by
    have e1 := E1 (2 * d) τ
    have e2 := E2 (2 * d) τ
    have e3 := E3 (2 * d) τ
    rw [hAτ τ] at e2
    rw [← e1, H, e3, e2]
  exact (hbij (2 * d)).1 hchain

theorem wc_supp_split_points_ne {S Z : Scheme.{u}} {K : Type u} [Field K] {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)] {a : Z ⟶ S} (Da : wcHMPullData a ℓ) (hepi : Epi (wcSuppUnitMap Da))
    (y₁ y₂ : Spec (.of K) ⟶ S) (hyy : y₁ = y₂)
    (D₁ : wcHMPullData y₁ ℓ) (hD₁ : wcHMPullCanonical D₁)
    (D₂ : wcHMPullData y₂ ℓ) (hD₂ : wcHMPullCanonical D₂)
    (r₁ : wcSuppObj Da ⟶ wcSuppObj D₁) (r₂ : wcSuppObj Da ⟶ wcSuppObj D₂)
    (ι₁ : wcSuppObj D₁ ⟶ wcSuppObj Da)
    (hr₁ : wcSuppUnitMap Da ≫ r₁ = wcSuppUnitMap D₁)
    (hr₂ : wcSuppUnitMap Da ≫ r₂ = wcSuppUnitMap D₂)
    (hιr : ι₁ ≫ r₁ = 𝟙 _) :
    ι₁ ≫ r₂ ≠ 0 :=
by
  subst hyy

  have key : ∀ (E₁ E₂ : wcHMPullData y₁ ℓ), wcHMPullCanonical E₁ → wcHMPullCanonical E₂ →
      ∃ f : wcSuppObj E₁ ⟶ wcSuppObj E₂, wcSuppUnitMap E₁ ≫ f = wcSuppUnitMap E₂ := by
    intro E₁ E₂ h₁ h₂
    obtain ⟨c₁, φ₁, Φ₁, adj₁, a₁, l₁, cl₁, μ₁⟩ := E₁
    obtain ⟨c₂, φ₂, Φ₂, adj₂, a₂, l₂, cl₂, μ₂⟩ := E₂
    obtain rfl : c₁ = c₂ := rfl
    obtain rfl : φ₁ = φ₂ := by
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext V
      apply RingCat.hom_ext
      apply RingHom.ext
      intro s
      exact (h₁ V.unop s).trans (h₂ V.unop s).symm
    refine ⟨(@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC y₁) _ _ c₁ φ₁).map
      (μ₁.inv ≫ (adj₁.leftAdjointUniq adj₂).hom.app _ ≫ μ₂.hom), ?_⟩
    have gen : (adj₁.unit.app (SheafOfModules.unit (wcRingSheaf S ℓ)) ≫
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC y₁) _ _ c₁ φ₁).map μ₁.hom) ≫
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC y₁) _ _ c₁ φ₁).map
          (μ₁.inv ≫ (adj₁.leftAdjointUniq adj₂).hom.app _ ≫ μ₂.hom) =
        adj₂.unit.app (SheafOfModules.unit (wcRingSheaf S ℓ)) ≫
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC y₁) _ _ c₁ φ₁).map μ₂.hom := by
      rw [Category.assoc, ← Functor.map_comp, Iso.hom_inv_id_assoc, Functor.map_comp,
        ← Category.assoc, Adjunction.unit_leftAdjointUniq_hom_app]
    exact gen

  have hne : wcSuppUnitMap D₂ ≠ 0 := by
    intro h0
    haveI := D₂.additive
    have hμ : D₂.μ.hom = 0 := by
      have e : (D₂.adj.homEquiv _ _) D₂.μ.hom = 0 := by
        rw [Adjunction.homEquiv_unit]
        exact h0
      rw [← (D₂.adj.homEquiv _ _).symm_apply_apply D₂.μ.hom, e, Adjunction.homEquiv_counit,
        Functor.map_zero, Limits.zero_comp]
    have hid : 𝟙 (SheafOfModules.unit (wcRingSheaf (Spec (.of K)) ℓ)) = 0 := by
      rw [← D₂.μ.inv_hom_id, hμ, Limits.comp_zero]
    let V₀ : (Spec (.of K)).ProEt := MorphismProperty.Over.mk ⊤ (𝟙 (Spec (.of K)))
      (inferInstance : WeaklyEtale (𝟙 (Spec (.of K))))
    have h2 := congrArg (fun g : SheafOfModules.unit (wcRingSheaf (Spec (.of K)) ℓ) ⟶
        SheafOfModules.unit (wcRingSheaf (Spec (.of K)) ℓ) =>
      (fun t : C(↥(Spec (.of K)), ULift.{u+1} ℚ_[ℓ]) => (t (IsLocalRing.closedPoint K)).down)
        ((g.val.app (Opposite.op V₀)).hom (1 : C(↥(Spec (.of K)), ULift.{u+1} ℚ_[ℓ])))) hid
    change (1 : ℚ_[ℓ]) = 0 at h2
    exact one_ne_zero h2

  obtain ⟨f, hf⟩ := key D₁ D₂ hD₁ hD₂
  haveI := hepi
  have hr : r₂ = r₁ ≫ f := by
    rw [← cancel_epi (wcSuppUnitMap Da), hr₂, ← Category.assoc, hr₁, hf]
  intro h
  apply hne
  have hf0 : f = 0 := by
    rw [← Category.id_comp f, ← hιr, Category.assoc, ← hr, h]
  rw [← hf, hf0, Limits.comp_zero]

theorem wc_tl_localize (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [IsProper X.hom] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (n : ℕ)
    (DΔ : wcHMPullData (Limits.pullback.diagonal (wcPi2 F X)) ℓ) (hDΔ : wcHMPullCanonical DΔ)
    (θ : wcSuppExt DΔ n)
    (t : wcXbar F X ⟶ Limits.pullback (wcPi2 F X) (wcPi2 F X))
    (ht : t ≫ Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) = 𝟙 _)
    (Dt : wcHMPullData t ℓ) (hDt : wcHMPullCanonical Dt)
    (het : Etale (Limits.pullback.fst t (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X))
    (Da : wcHMPullData (Limits.pullback.fst t (Limits.pullback.diagonal (wcPi2 F X))) ℓ)
    (hDa : wcHMPullCanonical Da) (hepi : Epi (wcSuppUnitMap Da))
    (γ : wcSuppObj Da ⟶ Dt.Φ.obj (wcSuppObj DΔ))
    (hγ : wcSuppUnitMap Da ≫ γ = Dt.μ.inv ≫ Dt.Φ.map (wcSuppUnitMap DΔ))
    (m : ℕ) (x : Fin m → (Spec (.of (AlgebraicClosure F)) ⟶ wcXbar F X))
    (Dx : ∀ k, wcHMPullData (x k) ℓ) (hDx : ∀ k, wcHMPullCanonical (Dx k))
    (r : ∀ k, wcSuppObj Da ⟶ wcSuppObj (Dx k))
    (ι : ∀ k, wcSuppObj (Dx k) ⟶ wcSuppObj Da)
    (hx : ∀ k, ∃ z : Spec (.of (AlgebraicClosure F)) ⟶
        Limits.pullback t (Limits.pullback.diagonal (wcPi2 F X)),
      z ≫ Limits.pullback.fst t (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X = 𝟙 _ ∧
      z ≫ Limits.pullback.fst t (Limits.pullback.diagonal (wcPi2 F X)) = x k)
    (hr : ∀ k, wcSuppUnitMap Da ≫ r k = wcSuppUnitMap (Dx k))
    (hιr : ∀ k, ι k ≫ r k = 𝟙 _) (hιr0 : ∀ k j, k ≠ j → ι k ≫ r j = 0)
    (hsum : ∑ k, r k ≫ ι k = 𝟙 _)
    (k : Fin m) (N : (wcXbar F X).Opens) (yN : Spec (.of (AlgebraicClosure F)) ⟶ N.toScheme)
    (hyN : yN ≫ N.ι = x k)
    (hpb : IsPullback yN (x k) (N.ι ≫ t) (Limits.pullback.diagonal (wcPi2 F X)))
    (Dj : wcHMPullData N.ι ℓ) (hDj : wcHMPullCanonical Dj)
    (Djt : wcHMPullData (N.ι ≫ t) ℓ) (hDjt : wcHMPullCanonical Djt)
    (DN : wcHMPullData yN ℓ) (hDN : wcHMPullCanonical DN) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcXbar F X) ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf N.toScheme ℓ)) := HasExt.standard _
    ∃ (κk : wcSuppObj DN ⟶ Dj.Φ.obj (wcSuppObj (Dx k)))
      (κt : wcSuppObj DN ⟶ Djt.Φ.obj (wcSuppObj DΔ)),
      wcSuppUnitMap DN ≫ κk = Dj.μ.inv ≫ Dj.Φ.map (wcSuppUnitMap (Dx k)) ∧
      wcSuppUnitMap DN ≫ κt = Djt.μ.inv ≫ Djt.Φ.map (wcSuppUnitMap DΔ) ∧
      (Abelian.Ext.mk₀ κk).comp (wcSuppPullExt (Dx k) Dj n ((Abelian.Ext.mk₀ (ι k)).comp
          ((Abelian.Ext.mk₀ γ).comp (wcSuppPullExt DΔ Dt n θ) (zero_add _)) (zero_add _)))
          (zero_add _) =
        (Abelian.Ext.mk₀ κt).comp (wcSuppPullExt DΔ Djt n θ) (zero_add _) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcXbar F X) ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf N.toScheme ℓ)) := HasExt.standard _
  haveI : IsClosedImmersion (Limits.pullback.diagonal (wcPi2 F X)) := inferInstance
  haveI : IsLocallyNoetherian (wcXbar F X) := inferInstance
  haveI : IsLocallyNoetherian N.toScheme := inferInstance

  have hxπ : ∀ j, x j ≫ wcPi2 F X = 𝟙 _ := by
    intro j
    obtain ⟨z, hz1, hz2⟩ := hx j
    rw [← hz2, Category.assoc]
    exact hz1
  have hxci : ∀ j, IsClosedImmersion (x j) := by
    intro j
    haveI : IsClosedImmersion (x j ≫ wcPi2 F X) := by rw [hxπ j]; infer_instance
    exact IsClosedImmersion.of_comp (x j) (wcPi2 F X)
  have hab : Limits.pullback.fst t (Limits.pullback.diagonal (wcPi2 F X)) =
      Limits.pullback.snd t (Limits.pullback.diagonal (wcPi2 F X)) := by
    have hC : Limits.pullback.fst t (Limits.pullback.diagonal (wcPi2 F X)) ≫ t =
        Limits.pullback.snd t (Limits.pullback.diagonal (wcPi2 F X)) ≫
          Limits.pullback.diagonal (wcPi2 F X) :=
      Limits.pullback.condition
    have h := congrArg (· ≫ Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)) hC
    simp only [Category.assoc, ht, Category.comp_id, Limits.pullback.diagonal_fst] at h
    exact h
  have hxt : ∀ j, x j ≫ t = x j ≫ Limits.pullback.diagonal (wcPi2 F X) := by
    intro j
    obtain ⟨z, -, hz2⟩ := hx j
    rw [← hz2, Category.assoc, Category.assoc, Limits.pullback.condition, hab]
  haveI : IsClosedImmersion yN :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hpb.flip inferInstance
  haveI hepiN : Epi (wcSuppUnitMap DN) := wc_supp_unit_epi_of_noetherian yN ℓ DN hDN

  have hV : ∀ j, j ≠ k → Dj.μ.inv ≫ Dj.Φ.map (wcSuppUnitMap (Dx j)) = 0 := by
    intro j hjk
    haveI := hxci j
    apply (SheafOfModules.unitHomEquiv _).injective
    apply PresheafOfModules.sections_ext
    rintro ⟨V⟩
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    refine (wc_supp_pull_unit_vanish_off (x j) N.ι (Limits.pullback.fst N.ι (x j))
      (Limits.pullback.snd N.ι (x j)) (IsPullback.of_hasPullback N.ι (x j)) ℓ (Dx j) Dj V
      ?_).trans rfl
    rintro p ⟨w, -⟩
    have hwc : (Limits.pullback.fst N.ι (x j) ≫ N.ι) w =
        (Limits.pullback.snd N.ι (x j) ≫ x j) w := by
      rw [Limits.pullback.condition]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at hwc
    have hrange : Set.range ⇑(x j) ⊆ Set.range ⇑N.ι := by
      rintro _ ⟨q, rfl⟩
      rw [Subsingleton.elim q (Limits.pullback.snd N.ι (x j) w)]
      exact ⟨_, hwc⟩
    have hy' : IsOpenImmersion.lift N.ι (x j) hrange ≫ N.ι = x j :=
      IsOpenImmersion.lift_fac _ _ _
    have hw' : IsOpenImmersion.lift N.ι (x j) hrange ≫ (N.ι ≫ t) =
        x j ≫ Limits.pullback.diagonal (wcPi2 F X) := by
      rw [← Category.assoc, hy', hxt j]
    have hw2 := hpb.lift_snd _ _ hw'
    have hw1 : hpb.lift _ _ hw' = 𝟙 _ := by
      calc hpb.lift _ _ hw' = hpb.lift _ _ hw' ≫ (x k ≫ wcPi2 F X) := by
            rw [hxπ k, Category.comp_id]
        _ = x j ≫ wcPi2 F X := by rw [← Category.assoc, hw2]
        _ = 𝟙 _ := hxπ j
    rw [hw1, Category.id_comp] at hw2
    exact wc_supp_split_points_ne Da hepi (x k) (x j) hw2 (Dx k) (hDx k) (Dx j) (hDx j)
      (r k) (r j) (ι k) (hr k) (hr j) (hιr k) (hιr0 k j (Ne.symm hjk))

  have hρ : wcSuppUnitMap Da = ∑ j, wcSuppUnitMap (Dx j) ≫ ι j := by
    calc wcSuppUnitMap Da = wcSuppUnitMap Da ≫ ∑ j, r j ≫ ι j := by
          rw [hsum, Category.comp_id]
      _ = ∑ j, wcSuppUnitMap (Dx j) ≫ ι j := by
          rw [Preadditive.comp_sum]
          refine Finset.sum_congr rfl (fun j _ => ?_)
          rw [← Category.assoc, hr j]
  have hsplit : Dj.μ.inv ≫ Dj.Φ.map (wcSuppUnitMap Da) =
      Dj.μ.inv ≫ Dj.Φ.map (wcSuppUnitMap (Dx k) ≫ ι k) := by
    haveI := Dj.additive
    rw [hρ, Functor.map_sum, Preadditive.comp_sum, Finset.sum_eq_single k]
    · intro j _ hjk
      rw [Functor.map_comp, ← Category.assoc, hV j hjk, Limits.zero_comp]
    · intro h
      exact absurd (Finset.mem_univ k) h

  have hw : (yN ≫ N.ι) ≫ t = x k ≫ Limits.pullback.diagonal (wcPi2 F X) := by
    rw [Category.assoc]
    exact hpb.w
  obtain ⟨zN, hzNa, hzNb⟩ : ∃ zN : Spec (.of (AlgebraicClosure F)) ⟶
      Limits.pullback t (Limits.pullback.diagonal (wcPi2 F X)),
      zN ≫ Limits.pullback.fst t (Limits.pullback.diagonal (wcPi2 F X)) = yN ≫ N.ι ∧
      zN ≫ Limits.pullback.snd t (Limits.pullback.diagonal (wcPi2 F X)) = x k :=
    ⟨Limits.pullback.lift _ _ hw, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hSqa : IsPullback yN zN N.ι (Limits.pullback.fst t (Limits.pullback.diagonal (wcPi2 F X))) := by
    refine IsPullback.of_bot ?_ hzNa.symm
      (IsPullback.of_hasPullback t (Limits.pullback.diagonal (wcPi2 F X)))
    rw [hzNb]
    exact hpb

  have hKa := wc_supp_kernel_kill_of_noetherian
    (Limits.pullback.fst t (Limits.pullback.diagonal (wcPi2 F X))) N.ι yN zN hSqa ℓ
    Da hDa DN hDN Dj hDj
  have hKt := wc_supp_kernel_kill_of_noetherian (Limits.pullback.diagonal (wcPi2 F X))
    (N.ι ≫ t) yN (x k) hpb ℓ DΔ hDΔ DN hDN Djt hDjt
  obtain ⟨κa, hκa⟩ : ∃ κa : wcSuppObj DN ⟶ Dj.Φ.obj (wcSuppObj Da),
      wcSuppUnitMap DN ≫ κa = Dj.μ.inv ≫ Dj.Φ.map (wcSuppUnitMap Da) :=
    ⟨Abelian.epiDesc _ _ hKa, Abelian.comp_epiDesc _ _ _⟩
  obtain ⟨κt, hκt⟩ : ∃ κt : wcSuppObj DN ⟶ Djt.Φ.obj (wcSuppObj DΔ),
      wcSuppUnitMap DN ≫ κt = Djt.μ.inv ≫ Djt.Φ.map (wcSuppUnitMap DΔ) :=
    ⟨Abelian.epiDesc _ _ hKt, Abelian.comp_epiDesc _ _ _⟩

  have hG5 : (κa ≫ Dj.Φ.map (r k)) ≫ Dj.Φ.map (ι k) = κa := by
    rw [← cancel_epi (wcSuppUnitMap DN)]
    calc wcSuppUnitMap DN ≫ (κa ≫ Dj.Φ.map (r k)) ≫ Dj.Φ.map (ι k)
        = Dj.μ.inv ≫ Dj.Φ.map (wcSuppUnitMap Da ≫ r k ≫ ι k) := by
          simp only [Functor.map_comp, Category.assoc]
          rw [reassoc_of% hκa]
      _ = Dj.μ.inv ≫ Dj.Φ.map (wcSuppUnitMap (Dx k) ≫ ι k) := by
          rw [← Category.assoc (wcSuppUnitMap Da), hr k]
      _ = Dj.μ.inv ≫ Dj.Φ.map (wcSuppUnitMap Da) := hsplit.symm
      _ = wcSuppUnitMap DN ≫ κa := hκa.symm

  obtain ⟨κk, hκk, hκkι⟩ : ∃ κk : wcSuppObj DN ⟶ Dj.Φ.obj (wcSuppObj (Dx k)),
      wcSuppUnitMap DN ≫ κk = Dj.μ.inv ≫ Dj.Φ.map (wcSuppUnitMap (Dx k)) ∧
      κk ≫ Dj.Φ.map (ι k) = κa :=
    ⟨κa ≫ Dj.Φ.map (r k), by
      rw [← Category.assoc, hκa, Category.assoc, ← Functor.map_comp, hr k], hG5⟩
  refine ⟨κk, κt, hκk, hκt, ?_⟩

  have hA : wcSuppPullExt (Dx k) Dj n ((Abelian.Ext.mk₀ (ι k)).comp
        ((Abelian.Ext.mk₀ γ).comp (wcSuppPullExt DΔ Dt n θ) (zero_add _)) (zero_add _)) =
      (Abelian.Ext.mk₀ (Dj.Φ.map (ι k))).comp (wcSuppPullExt Da Dj n
        ((Abelian.Ext.mk₀ γ).comp (wcSuppPullExt DΔ Dt n θ) (zero_add _))) (zero_add _) := by
    haveI := Dj.additive
    haveI := Dj.presLim
    haveI := Dj.presColim
    show (Abelian.Ext.mapExactFunctor Dj.Φ ((Abelian.Ext.mk₀ (ι k)).comp
          ((Abelian.Ext.mk₀ γ).comp (wcSuppPullExt DΔ Dt n θ) (zero_add _)) (zero_add _))).comp
          (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero n) =
        (Abelian.Ext.mk₀ (Dj.Φ.map (ι k))).comp ((Abelian.Ext.mapExactFunctor Dj.Φ
          ((Abelian.Ext.mk₀ γ).comp (wcSuppPullExt DΔ Dt n θ) (zero_add _))).comp
          (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero n)) (zero_add _)
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero]
  have hassoc : ∀ {A B : SheafOfModules.{u+1} (wcRingSheaf N.toScheme ℓ)}
      (f : wcSuppObj DN ⟶ A) (g : A ⟶ B)
      (Q : Abelian.Ext B (SheafOfModules.unit (wcRingSheaf N.toScheme ℓ)) n),
      (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ g).comp Q (zero_add n)) (zero_add n) =
        (Abelian.Ext.mk₀ (f ≫ g)).comp Q (zero_add n) := by
    intro A B f g Q
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]

  have hc1 : (Abelian.Ext.mk₀ κt).comp (wcSuppPullExt DΔ Djt n θ) (zero_add _) =
      (Abelian.Ext.mk₀ κa).comp (wcSuppPullExt Da Dj n
        ((Abelian.Ext.mk₀ γ).comp (wcSuppPullExt DΔ Dt n θ) (zero_add _))) (zero_add _) :=
    wc_supp_pull_comp t N.ι (N.ι ≫ t) rfl DΔ hDΔ Da hDa DN hDN hepiN Dt hDt Dj hDj Djt hDjt
      γ hγ κa hκa κt hκt n θ

  rw [hA, hassoc, hκkι]
  exact hc1.symm

theorem wc_tl_sigma_of_restrict (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [IsProper X.hom] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (n : ℕ)
    (y y' : Spec (.of (AlgebraicClosure F)) ⟶ wcXbar F X) (hyy : y = y')
    (hy : y ≫ wcPi2 F X = 𝟙 _)
    (N : (wcXbar F X).Opens) (yN : Spec (.of (AlgebraicClosure F)) ⟶ N.toScheme)
    (hyN : yN ≫ N.ι = y)
    (D₁ : wcHMPullData y ℓ) (hD₁ : wcHMPullCanonical D₁)
    (D₂ : wcHMPullData y' ℓ) (hD₂ : wcHMPullCanonical D₂)
    (Dj : wcHMPullData N.ι ℓ) (hDj : wcHMPullCanonical Dj)
    (DN : wcHMPullData yN ℓ) (hDN : wcHMPullCanonical DN)
    (κ₁ : wcSuppObj DN ⟶ Dj.Φ.obj (wcSuppObj D₁)) (κ₂ : wcSuppObj DN ⟶ Dj.Φ.obj (wcSuppObj D₂))
    (hκ₁ : wcSuppUnitMap DN ≫ κ₁ = Dj.μ.inv ≫ Dj.Φ.map (wcSuppUnitMap D₁))
    (hκ₂ : wcSuppUnitMap DN ≫ κ₂ = Dj.μ.inv ≫ Dj.Φ.map (wcSuppUnitMap D₂))
    (w₁ : wcSuppExt D₁ n) (w₂ : wcSuppExt D₂ n) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf N.toScheme ℓ)) := HasExt.standard _
    (Abelian.Ext.mk₀ κ₁).comp (wcSuppPullExt D₁ Dj n w₁) (zero_add _) =
        (Abelian.Ext.mk₀ κ₂).comp (wcSuppPullExt D₂ Dj n w₂) (zero_add _) →
      wcSuppClass D₁ n w₁ = wcSuppClass D₂ n w₂ :=
by
  intro hres
  subst hyy
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcXbar F X) ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf N.toScheme ℓ)) := HasExt.standard _

  have s1 : ∀ (E₁ E₂ : wcHMPullData y ℓ), wcHMPullCanonical E₁ → wcHMPullCanonical E₂ →
      ∃ e : wcSuppObj E₁ ≅ wcSuppObj E₂, wcSuppUnitMap E₁ ≫ e.hom = wcSuppUnitMap E₂ := by
    intro E₁ E₂ h₁ h₂
    obtain ⟨c₁, φ₁, Φ₁, adj₁, a₁, l₁, cl₁, μ₁⟩ := E₁
    obtain ⟨c₂, φ₂, Φ₂, adj₂, a₂, l₂, cl₂, μ₂⟩ := E₂
    have hc : c₂ = c₁ := rfl
    subst hc
    have hφ : φ₁ = φ₂ := by
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext V
      apply RingCat.hom_ext
      apply RingHom.ext
      intro s
      exact (h₁ V.unop s).trans (h₂ V.unop s).symm
    subst hφ
    refine ⟨Functor.mapIso (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC y) _ _ c₂ φ₁)
      (μ₁.symm ≪≫ (adj₁.leftAdjointUniq adj₂).app _ ≪≫ μ₂), ?_⟩
    have hU := Adjunction.unit_leftAdjointUniq_hom_app adj₁ adj₂
      (SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ))
    let P := @SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC y) _ _ c₂ φ₁
    let R := SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ)
    let R' := SheafOfModules.unit (wcRingSheaf (Spec (.of (AlgebraicClosure F))) ℓ)
    let ψR := (adj₁.leftAdjointUniq adj₂).hom.app R
    show (adj₁.unit.app R ≫ P.map μ₁.hom) ≫ P.map (μ₁.inv ≫ ψR ≫ μ₂.hom) =
      adj₂.unit.app R ≫ P.map μ₂.hom
    calc (adj₁.unit.app R ≫ P.map μ₁.hom) ≫ P.map (μ₁.inv ≫ ψR ≫ μ₂.hom)
        = adj₁.unit.app R ≫ (P.map μ₁.hom ≫ P.map (μ₁.inv ≫ ψR ≫ μ₂.hom)) :=
          Category.assoc _ _ _
      _ = adj₁.unit.app R ≫ P.map (μ₁.hom ≫ μ₁.inv ≫ ψR ≫ μ₂.hom) :=
          congrArg (fun g : P.obj (Φ₁.obj R) ⟶ P.obj R' => adj₁.unit.app R ≫ g)
            (P.map_comp _ _).symm
      _ = adj₁.unit.app R ≫ P.map (ψR ≫ μ₂.hom) :=
          congrArg (fun g : Φ₁.obj R ⟶ R' => adj₁.unit.app R ≫ P.map g)
            (Iso.hom_inv_id_assoc μ₁ _)
      _ = adj₁.unit.app R ≫ (P.map ψR ≫ P.map μ₂.hom) :=
          congrArg (fun g : P.obj (Φ₁.obj R) ⟶ P.obj R' => adj₁.unit.app R ≫ g)
            (P.map_comp _ _)
      _ = (adj₁.unit.app R ≫ P.map ψR) ≫ P.map μ₂.hom := (Category.assoc _ _ _).symm
      _ = adj₂.unit.app R ≫ P.map μ₂.hom :=
          congrArg (fun g : R ⟶ P.obj (Φ₂.obj R) => g ≫ P.map μ₂.hom) hU

  haveI : IsClosedImmersion (y ≫ wcPi2 F X) := by rw [hy]; infer_instance
  haveI : IsClosedImmersion y := IsClosedImmersion.of_comp y (wcPi2 F X)
  haveI : IsClosedImmersion (yN ≫ N.ι ≫ wcPi2 F X) := by
    rw [← Category.assoc, hyN, hy]; infer_instance
  haveI : IsClosedImmersion yN := IsClosedImmersion.of_comp yN (N.ι ≫ wcPi2 F X)
  haveI : IsLocallyNoetherian (wcXbar F X) := inferInstance
  haveI : IsLocallyNoetherian N.toScheme := inferInstance
  haveI hepiN : Epi (wcSuppUnitMap DN) := wc_supp_unit_epi_of_noetherian yN ℓ DN hDN
  obtain ⟨e, he⟩ := s1 D₁ D₂ hD₁ hD₂

  have hκ : κ₂ = κ₁ ≫ Dj.Φ.map e.hom := by
    rw [← cancel_epi (wcSuppUnitMap DN), hκ₂, ← Category.assoc, hκ₁, Category.assoc,
      ← Functor.map_comp, he]

  have hP : wcSuppPullExt D₁ Dj n ((Abelian.Ext.mk₀ e.hom).comp w₂ (zero_add n)) =
      (Abelian.Ext.mk₀ (Dj.Φ.map e.hom)).comp (wcSuppPullExt D₂ Dj n w₂) (zero_add n) := by
    haveI := Dj.additive
    haveI := Dj.presLim
    haveI := Dj.presColim
    show (Abelian.Ext.mapExactFunctor Dj.Φ ((Abelian.Ext.mk₀ e.hom).comp w₂ (zero_add n))).comp
        (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero n) =
      (Abelian.Ext.mk₀ (Dj.Φ.map e.hom)).comp
        ((Abelian.Ext.mapExactFunctor Dj.Φ w₂).comp (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero n))
        (zero_add n)
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero]
  have hres' : (Abelian.Ext.mk₀ κ₁).comp (wcSuppPullExt D₁ Dj n w₁) (zero_add _) =
      (Abelian.Ext.mk₀ κ₁).comp
        (wcSuppPullExt D₁ Dj n ((Abelian.Ext.mk₀ e.hom).comp w₂ (zero_add n))) (zero_add _) := by
    rw [hres, hP, hκ, ← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]

  have hinj : w₁ = (Abelian.Ext.mk₀ e.hom).comp w₂ (zero_add n) :=
    (wc_supp_open_excision y N.ι yN hyN D₁ hD₁ DN hDN hepiN Dj hDj κ₁ hκ₁ n).1 hres'

  subst hinj
  show (Abelian.Ext.mk₀ (wcSuppUnitMap D₁)).comp ((Abelian.Ext.mk₀ e.hom).comp w₂ (zero_add n))
      (zero_add n) = (Abelian.Ext.mk₀ (wcSuppUnitMap D₂)).comp w₂ (zero_add n)
  rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀, he]

theorem wc_transversal_local_index_section_indep (F : Type u) [Finite F] [Field F]
    (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (DΔ : wcHMPullData (Limits.pullback.diagonal (wcPi2 F X)) ℓ) (hDΔ : wcHMPullCanonical DΔ)
    (θ : wcSuppExt DΔ (2 * d))
    (t : wcXbar F X ⟶ Limits.pullback (wcPi2 F X) (wcPi2 F X))
    (ht : t ≫ Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) = 𝟙 _)
    (Dt : wcHMPullData t ℓ) (hDt : wcHMPullCanonical Dt)
    (het : Etale (Limits.pullback.fst t (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X))
    (Da : wcHMPullData (Limits.pullback.fst t (Limits.pullback.diagonal (wcPi2 F X))) ℓ)
    (hDa : wcHMPullCanonical Da) (hepi : Epi (wcSuppUnitMap Da))
    (γ : wcSuppObj Da ⟶ Dt.Φ.obj (wcSuppObj DΔ))
    (hγ : wcSuppUnitMap Da ≫ γ = Dt.μ.inv ≫ Dt.Φ.map (wcSuppUnitMap DΔ))
    (m : ℕ) (x : Fin m → (Spec (.of (AlgebraicClosure F)) ⟶ wcXbar F X))
    (Dx : ∀ k, wcHMPullData (x k) ℓ) (hDx : ∀ k, wcHMPullCanonical (Dx k))
    (r : ∀ k, wcSuppObj Da ⟶ wcSuppObj (Dx k))
    (ι : ∀ k, wcSuppObj (Dx k) ⟶ wcSuppObj Da)
    (hx : ∀ k, ∃ z : Spec (.of (AlgebraicClosure F)) ⟶
        Limits.pullback t (Limits.pullback.diagonal (wcPi2 F X)),
      z ≫ Limits.pullback.fst t (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X = 𝟙 _ ∧
      z ≫ Limits.pullback.fst t (Limits.pullback.diagonal (wcPi2 F X)) = x k)
    (hr : ∀ k, wcSuppUnitMap Da ≫ r k = wcSuppUnitMap (Dx k))
    (hιr : ∀ k, ι k ≫ r k = 𝟙 _) (hιr0 : ∀ k j, k ≠ j → ι k ≫ r j = 0)
    (hsum : ∑ k, r k ≫ ι k = 𝟙 _)
    (t' : wcXbar F X ⟶ Limits.pullback (wcPi2 F X) (wcPi2 F X))
    (ht' : t' ≫ Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) = 𝟙 _)
    (Dt' : wcHMPullData t' ℓ) (hDt' : wcHMPullCanonical Dt')
    (het' : Etale (Limits.pullback.fst t' (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X))
    (Da' : wcHMPullData (Limits.pullback.fst t' (Limits.pullback.diagonal (wcPi2 F X))) ℓ)
    (hDa' : wcHMPullCanonical Da') (hepi' : Epi (wcSuppUnitMap Da'))
    (γ' : wcSuppObj Da' ⟶ Dt'.Φ.obj (wcSuppObj DΔ))
    (hγ' : wcSuppUnitMap Da' ≫ γ' = Dt'.μ.inv ≫ Dt'.Φ.map (wcSuppUnitMap DΔ))
    (m' : ℕ) (x' : Fin m' → (Spec (.of (AlgebraicClosure F)) ⟶ wcXbar F X))
    (Dx' : ∀ k, wcHMPullData (x' k) ℓ) (hDx' : ∀ k, wcHMPullCanonical (Dx' k))
    (r' : ∀ k, wcSuppObj Da' ⟶ wcSuppObj (Dx' k))
    (ι' : ∀ k, wcSuppObj (Dx' k) ⟶ wcSuppObj Da')
    (hx' : ∀ k, ∃ z : Spec (.of (AlgebraicClosure F)) ⟶
        Limits.pullback t' (Limits.pullback.diagonal (wcPi2 F X)),
      z ≫ Limits.pullback.fst t' (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X = 𝟙 _ ∧
      z ≫ Limits.pullback.fst t' (Limits.pullback.diagonal (wcPi2 F X)) = x' k)
    (hr' : ∀ k, wcSuppUnitMap Da' ≫ r' k = wcSuppUnitMap (Dx' k))
    (hιr' : ∀ k, ι' k ≫ r' k = 𝟙 _) (hιr0' : ∀ k j, k ≠ j → ι' k ≫ r' j = 0)
    (hsum' : ∑ k, r' k ≫ ι' k = 𝟙 _)
    (k : Fin m) (k' : Fin m') (hkk : x k = x' k') :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcXbar F X) ℓ)) := HasExt.standard _
    wcSuppClass (Dx k) (2 * d) ((Abelian.Ext.mk₀ (ι k)).comp
        ((Abelian.Ext.mk₀ γ).comp (wcSuppPullExt DΔ Dt (2 * d) θ) (zero_add _)) (zero_add _)) =
      wcSuppClass (Dx' k') (2 * d) ((Abelian.Ext.mk₀ (ι' k')).comp
        ((Abelian.Ext.mk₀ γ').comp (wcSuppPullExt DΔ Dt' (2 * d) θ) (zero_add _)) (zero_add _)) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcXbar F X) ℓ)) := HasExt.standard _

  have hfix : ∀ (s : wcXbar F X ⟶ Limits.pullback (wcPi2 F X) (wcPi2 F X)),
      s ≫ Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) = 𝟙 _ →
      ∀ w : Spec (.of (AlgebraicClosure F)) ⟶
        Limits.pullback s (Limits.pullback.diagonal (wcPi2 F X)),
      (w ≫ Limits.pullback.fst s (Limits.pullback.diagonal (wcPi2 F X))) ≫ s =
        (w ≫ Limits.pullback.fst s (Limits.pullback.diagonal (wcPi2 F X))) ≫
          Limits.pullback.diagonal (wcPi2 F X) := by
    intro s hs w
    have hC : Limits.pullback.fst s (Limits.pullback.diagonal (wcPi2 F X)) ≫ s =
        Limits.pullback.snd s (Limits.pullback.diagonal (wcPi2 F X)) ≫
          Limits.pullback.diagonal (wcPi2 F X) :=
      Limits.pullback.condition
    have hab : Limits.pullback.fst s (Limits.pullback.diagonal (wcPi2 F X)) =
        Limits.pullback.snd s (Limits.pullback.diagonal (wcPi2 F X)) := by
      have h := congrArg (· ≫ Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)) hC
      simp only [Category.assoc, hs, Category.comp_id, Limits.pullback.diagonal_fst] at h
      exact h
    rw [Category.assoc, Category.assoc, hC, hab]
  obtain ⟨z, hz1, hz2⟩ := hx k
  have hy : x k ≫ wcPi2 F X = 𝟙 _ := by
    rw [← hz2, Category.assoc]
    exact hz1
  have hyt : x k ≫ t = x k ≫ Limits.pullback.diagonal (wcPi2 F X) := by
    rw [← hz2]
    exact hfix t ht z
  obtain ⟨z', -, hz'2⟩ := hx' k'
  have hyt' : x k ≫ t' = x k ≫ Limits.pullback.diagonal (wcPi2 F X) := by
    rw [hkk, ← hz'2]
    exact hfix t' ht' z'

  obtain ⟨U, u, hu, huK, N, hNU, yN, g₂, g₂', hyN, hg₂, hg₂', hpbt, hpbt', heh, heh', hph,
      hph'⟩ := wc_tl_transversal_chart F X d t t' ht ht' het het' (x k) hy hyt hyt'

  obtain ⟨D0, hD0⟩ := wc_hm_pull_data_exists (wcTlZero F d) ℓ
  obtain ⟨Dj, hDj⟩ := wc_hm_pull_data_exists N.ι ℓ
  obtain ⟨Djt, hDjt⟩ := wc_hm_pull_data_exists (N.ι ≫ t) ℓ
  obtain ⟨Djt', hDjt'⟩ := wc_hm_pull_data_exists (N.ι ≫ t') ℓ
  obtain ⟨DN, hDN⟩ := wc_hm_pull_data_exists yN ℓ
  obtain ⟨Dh, hDh⟩ := wc_hm_pull_data_exists
    (wcTlDiff F d (N.ι ≫ wcPi2 F X) u ((wcXbar F X).homOfLE hNU) g₂) ℓ
  obtain ⟨Dh', hDh'⟩ := wc_hm_pull_data_exists
    (wcTlDiff F d (N.ι ≫ wcPi2 F X) u ((wcXbar F X).homOfLE hNU) g₂') ℓ

  obtain ⟨κk, κt, hκk, hκt, hloc⟩ := wc_tl_localize F X ℓ (2 * d) DΔ hDΔ θ t ht Dt hDt het
    Da hDa hepi γ hγ m x Dx hDx r ι hx hr hιr hιr0 hsum k N yN hyN hpbt Dj hDj Djt hDjt DN hDN
  obtain ⟨κk', κt', hκk', hκt', hloc'⟩ := wc_tl_localize F X ℓ (2 * d) DΔ hDΔ θ t' ht' Dt'
    hDt' het' Da' hDa' hepi' γ' hγ' m' x' Dx' hDx' r' ι' hx' hr' hιr' hιr0' hsum' k' N yN
    (hyN.trans hkk) (by rw [← hkk]; exact hpbt') Dj hDj Djt' hDjt' DN hDN

  obtain ⟨τ, hτ⟩ := wc_tl_diag_local_purity F X d ℓ hℓ DΔ hDΔ θ U u hu huK D0 hD0
  obtain ⟨κh, hκh, hpur⟩ := hτ N hNU (N.ι ≫ t) (by rw [Category.assoc, ht, Category.comp_id])
    g₂ hg₂ yN (x k) hpbt hph Djt hDjt Dh hDh DN hDN κt hκt
  obtain ⟨κh', hκh', hpur'⟩ := hτ N hNU (N.ι ≫ t') (by rw [Category.assoc, ht', Category.comp_id])
    g₂' hg₂' yN (x k) hpbt' hph' Djt' hDjt' Dh' hDh' DN hDN κt' hκt'

  have hor := wc_tl_orientation_indep F d ℓ hℓ (N.ι ≫ wcPi2 F X)
    (wcTlDiff F d (N.ι ≫ wcPi2 F X) u ((wcXbar F X).homOfLE hNU) g₂)
    (wcTlDiff F d (N.ι ≫ wcPi2 F X) u ((wcXbar F X).homOfLE hNU) g₂') heh heh'
    (by unfold wcTlDiff; exact AffineSpace.homOfVector_over _ _)
    (by unfold wcTlDiff; exact AffineSpace.homOfVector_over _ _)
    yN hph hph' D0 hD0 Dh hDh Dh' hDh' DN hDN κh κh' hκh hκh' τ

  exact wc_tl_sigma_of_restrict F X ℓ (2 * d) (x k) (x' k') hkk hy N yN hyN (Dx k) (hDx k)
    (Dx' k') (hDx' k') Dj hDj DN hDN κk κk' hκk hκk' _ _
    (hloc.trans (hpur.trans (hor.trans (hpur'.symm.trans hloc'.symm))))

theorem wc_diag_transversal_local_index (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (DΔ : wcHMPullData (Limits.pullback.diagonal (wcPi2 F X)) ℓ) (hDΔ : wcHMPullCanonical DΔ)
    (θ : wcSuppExt DΔ (2 * d)) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcXbar F X) ℓ)) := HasExt.standard _
    ∃ ζ : wcHM (wcXbar F X) ℓ (2 * d),
      ∀ (t : wcXbar F X ⟶ Limits.pullback (wcPi2 F X) (wcPi2 F X))
        (ht : t ≫ Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) = 𝟙 _)
        (Dt : wcHMPullData t ℓ) (hDt : wcHMPullCanonical Dt),
        Etale (Limits.pullback.fst t (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X) →
        ∀ (Da : wcHMPullData (Limits.pullback.fst t (Limits.pullback.diagonal (wcPi2 F X))) ℓ)
          (hDa : wcHMPullCanonical Da), Epi (wcSuppUnitMap Da) →
        ∀ (γ : wcSuppObj Da ⟶ Dt.Φ.obj (wcSuppObj DΔ)),
          wcSuppUnitMap Da ≫ γ = Dt.μ.inv ≫ Dt.Φ.map (wcSuppUnitMap DΔ) →
        ∀ (m : ℕ) (x : Fin m → (Spec (.of (AlgebraicClosure F)) ⟶ wcXbar F X))
          (Dx : ∀ k, wcHMPullData (x k) ℓ) (hDx : ∀ k, wcHMPullCanonical (Dx k))
          (r : ∀ k, wcSuppObj Da ⟶ wcSuppObj (Dx k))
          (ι : ∀ k, wcSuppObj (Dx k) ⟶ wcSuppObj Da),
          (∀ k, ∃ z : Spec (.of (AlgebraicClosure F)) ⟶
              Limits.pullback t (Limits.pullback.diagonal (wcPi2 F X)),
            z ≫ Limits.pullback.fst t (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X = 𝟙 _ ∧
            z ≫ Limits.pullback.fst t (Limits.pullback.diagonal (wcPi2 F X)) = x k) →
          (∀ k, wcSuppUnitMap Da ≫ r k = wcSuppUnitMap (Dx k)) →
          (∀ k, ι k ≫ r k = 𝟙 _) → (∀ k j, k ≠ j → ι k ≫ r j = 0) →
          ∑ k, r k ≫ ι k = 𝟙 _ →
          ∀ k, wcSuppClass (Dx k) (2 * d) ((Abelian.Ext.mk₀ (ι k)).comp
            ((Abelian.Ext.mk₀ γ).comp (wcSuppPullExt DΔ Dt (2 * d) θ) (zero_add _))
            (zero_add _)) = ζ :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcXbar F X) ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1}
      (wcRingSheaf (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ)) := HasExt.standard _
  haveI : IsClosedImmersion (Limits.pullback.diagonal (wcPi2 F X)) := inferInstance
  haveI : IsLocallyNoetherian (wcXbar F X) := inferInstance

  obtain ⟨x₀, hx₀⟩ := wc_xbar_geom_point_exists F X d
  obtain ⟨s₀, hs₀₁, hs₀₂⟩ : ∃ s₀ : wcXbar F X ⟶ Limits.pullback (wcPi2 F X) (wcPi2 F X),
      s₀ ≫ Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) = 𝟙 _ ∧
      s₀ ≫ Limits.pullback.snd (wcPi2 F X) (wcPi2 F X) = wcPi2 F X ≫ x₀ :=
    ⟨Limits.pullback.lift (𝟙 (wcXbar F X)) (wcPi2 F X ≫ x₀)
      (by rw [Category.assoc, hx₀, Category.comp_id, Category.id_comp]),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  obtain ⟨D₀, hD₀⟩ := wc_hm_pull_data_exists s₀ ℓ
  refine ⟨wcHMPull D₀ (2 * d) (wcSuppClass DΔ (2 * d) θ), ?_⟩
  intro t ht Dt hDt het Da hDa hepi γ hγ m x Dx hDx r ι hx hr hιr hιr0 hsum k

  obtain ⟨z, hz1, hz2⟩ := hx k
  have hxk : x k ≫ wcPi2 F X = 𝟙 _ := by
    rw [← hz2, Category.assoc]
    exact hz1

  obtain ⟨s, hs₁, hs₂⟩ : ∃ s : wcXbar F X ⟶ Limits.pullback (wcPi2 F X) (wcPi2 F X),
      s ≫ Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) = 𝟙 _ ∧
      s ≫ Limits.pullback.snd (wcPi2 F X) (wcPi2 F X) = wcPi2 F X ≫ x k :=
    ⟨Limits.pullback.lift (𝟙 (wcXbar F X)) (wcPi2 F X ≫ x k)
      (by rw [Category.assoc, hxk, Category.comp_id, Category.id_comp]),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  obtain ⟨Ds, hDs⟩ := wc_hm_pull_data_exists s ℓ
  have hC : Limits.pullback.fst s (Limits.pullback.diagonal (wcPi2 F X)) ≫ s =
      Limits.pullback.snd s (Limits.pullback.diagonal (wcPi2 F X)) ≫
        Limits.pullback.diagonal (wcPi2 F X) :=
    Limits.pullback.condition
  have hab : Limits.pullback.fst s (Limits.pullback.diagonal (wcPi2 F X)) =
      Limits.pullback.snd s (Limits.pullback.diagonal (wcPi2 F X)) := by
    have h := congrArg (· ≫ Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)) hC
    simp only [Category.assoc, hs₁, Category.comp_id, Limits.pullback.diagonal_fst] at h
    exact h
  have hab2 : Limits.pullback.fst s (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X ≫ x k =
      Limits.pullback.snd s (Limits.pullback.diagonal (wcPi2 F X)) := by
    have h := congrArg (· ≫ Limits.pullback.snd (wcPi2 F X) (wcPi2 F X)) hC
    simp only [Category.assoc, hs₂, Limits.pullback.diagonal_snd, Category.comp_id] at h
    exact h
  have w' : x k ≫ s = x k ≫ Limits.pullback.diagonal (wcPi2 F X) := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Category.assoc, hs₁, Limits.pullback.diagonal_fst]
    · rw [Category.assoc, Category.assoc, hs₂, Limits.pullback.diagonal_snd,
        ← Category.assoc, hxk, Category.id_comp, Category.comp_id]
  obtain ⟨j, hjfst, hjsnd⟩ : ∃ j : Spec (.of (AlgebraicClosure F)) ⟶
      Limits.pullback s (Limits.pullback.diagonal (wcPi2 F X)),
      j ≫ Limits.pullback.fst s (Limits.pullback.diagonal (wcPi2 F X)) = x k ∧
      j ≫ Limits.pullback.snd s (Limits.pullback.diagonal (wcPi2 F X)) = x k :=
    ⟨Limits.pullback.lift (x k) (x k) w', Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩
  have hj1 : j ≫ Limits.pullback.fst s (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X =
      𝟙 _ := by
    rw [← Category.assoc, hjfst, hxk]
  have hj2 : (Limits.pullback.fst s (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X) ≫ j =
      𝟙 _ := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Category.assoc, hjfst, Category.id_comp, hab2, ← hab]
    · rw [Category.assoc, Category.assoc, hjsnd, Category.id_comp, hab2]
  have hiso : IsIso (Limits.pullback.fst s (Limits.pullback.diagonal (wcPi2 F X)) ≫
      wcPi2 F X) := ⟨⟨j, hj2, hj1⟩⟩
  haveI := hiso
  haveI : IsOpenImmersion (Limits.pullback.fst s (Limits.pullback.diagonal (wcPi2 F X)) ≫
      wcPi2 F X) :=
    IsOpenImmersion.of_isIso _
  have hets : Etale (Limits.pullback.fst s (Limits.pullback.diagonal (wcPi2 F X)) ≫
      wcPi2 F X) := inferInstance
  have huniq : ∀ z' : Spec (.of (AlgebraicClosure F)) ⟶
      Limits.pullback s (Limits.pullback.diagonal (wcPi2 F X)),
      z' ≫ Limits.pullback.fst s (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X = 𝟙 _ →
      z' = j := fun z' hz' =>
    (cancel_mono (Limits.pullback.fst s (Limits.pullback.diagonal (wcPi2 F X)) ≫
      wcPi2 F X)).mp (hz'.trans hj1.symm)
  have hcard : Nat.card {z' : Spec (.of (AlgebraicClosure F)) ⟶
      Limits.pullback s (Limits.pullback.diagonal (wcPi2 F X)) //
      z' ≫ Limits.pullback.fst s (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X = 𝟙 _} =
      1 := by
    haveI : Unique {z' : Spec (.of (AlgebraicClosure F)) ⟶
        Limits.pullback s (Limits.pullback.diagonal (wcPi2 F X)) //
        z' ≫ Limits.pullback.fst s (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X = 𝟙 _} :=
      ⟨⟨⟨j, hj1⟩⟩, fun z' => Subtype.ext (huniq z'.1 z'.2)⟩
    exact Nat.card_unique
  haveI : IsClosedImmersion (Limits.pullback.fst s (Limits.pullback.diagonal (wcPi2 F X))) :=
    inferInstance

  obtain ⟨Da', hDa', γ', hγ', hepi'⟩ := wc_closed_supp_base_change_noeth
    (Limits.pullback.diagonal (wcPi2 F X)) s DΔ hDΔ Ds hDs
  obtain ⟨x', Dx', hDx', r', ι', hx', hr', hιr', hιr0', hsum'⟩ :=
    wc_closed_supp_finite_points_split F X ℓ
      (Limits.pullback.fst s (Limits.pullback.diagonal (wcPi2 F X))) hets 1 hcard Da' hDa'
  have hx'0 : x' 0 = x k := by
    obtain ⟨z', hz'1, hz'2⟩ := hx' 0
    rw [← hz'2, huniq z' hz'1, hjfst]

  have hB : wcHMPull Ds (2 * d) (wcSuppClass DΔ (2 * d) θ) =
      wcSuppClass Da' (2 * d) ((Abelian.Ext.mk₀ γ').comp (wcSuppPullExt DΔ Ds (2 * d) θ)
        (zero_add _)) := by
    have e1 : wcHMPull Ds (2 * d) (wcSuppClass DΔ (2 * d) θ) =
        (Abelian.Ext.mk₀ (Ds.μ.inv ≫ Ds.Φ.map (wcSuppUnitMap DΔ))).comp
          (wcSuppPullExt DΔ Ds (2 * d) θ) (zero_add _) := by
      haveI := Ds.additive
      haveI := Ds.presLim
      haveI := Ds.presColim
      show (Abelian.Ext.mk₀ Ds.μ.inv).comp ((Abelian.Ext.mapExactFunctor Ds.Φ
          ((Abelian.Ext.mk₀ (wcSuppUnitMap DΔ)).comp θ (zero_add _))).comp
          (Abelian.Ext.mk₀ Ds.μ.hom) (add_zero _)) (zero_add _) =
        (Abelian.Ext.mk₀ (Ds.μ.inv ≫ Ds.Φ.map (wcSuppUnitMap DΔ))).comp
          ((Abelian.Ext.mapExactFunctor Ds.Φ θ).comp (Abelian.Ext.mk₀ Ds.μ.hom) (add_zero _))
          (zero_add _)
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.comp_assoc_of_third_deg_zero, ← Abelian.Ext.mk₀_comp_mk₀,
        Abelian.Ext.comp_assoc_of_second_deg_zero]
    rw [e1, ← hγ']
    show (Abelian.Ext.mk₀ (wcSuppUnitMap Da' ≫ γ')).comp (wcSuppPullExt DΔ Ds (2 * d) θ)
        (zero_add _) =
      (Abelian.Ext.mk₀ (wcSuppUnitMap Da')).comp ((Abelian.Ext.mk₀ γ').comp
        (wcSuppPullExt DΔ Ds (2 * d) θ) (zero_add _)) (zero_add _)
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]

  have hD : wcSuppClass Da' (2 * d) ((Abelian.Ext.mk₀ γ').comp (wcSuppPullExt DΔ Ds (2 * d) θ)
        (zero_add _)) =
      ∑ k', wcSuppClass (Dx' k') (2 * d) ((Abelian.Ext.mk₀ (ι' k')).comp
        ((Abelian.Ext.mk₀ γ').comp (wcSuppPullExt DΔ Ds (2 * d) θ) (zero_add _))
        (zero_add _)) := by
    have hρ : wcSuppUnitMap Da' = ∑ k', wcSuppUnitMap (Dx' k') ≫ ι' k' := by
      calc wcSuppUnitMap Da' = wcSuppUnitMap Da' ≫ ∑ k', r' k' ≫ ι' k' := by
            rw [hsum', Category.comp_id]
        _ = ∑ k', wcSuppUnitMap (Dx' k') ≫ ι' k' := by
            rw [Preadditive.comp_sum]
            refine Finset.sum_congr rfl (fun k' _ => ?_)
            rw [← Category.assoc, hr' k']
    show (Abelian.Ext.mk₀ (wcSuppUnitMap Da')).comp
        ((Abelian.Ext.mk₀ γ').comp (wcSuppPullExt DΔ Ds (2 * d) θ) (zero_add _)) (zero_add _) =
      ∑ k', (Abelian.Ext.mk₀ (wcSuppUnitMap (Dx' k'))).comp ((Abelian.Ext.mk₀ (ι' k')).comp
        ((Abelian.Ext.mk₀ γ').comp (wcSuppPullExt DΔ Ds (2 * d) θ) (zero_add _))
        (zero_add _)) (zero_add _)
    rw [hρ, Abelian.Ext.mk₀_sum, Abelian.Ext.sum_comp]
    refine Finset.sum_congr rfl (fun k' _ => ?_)
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
  have hB' : wcHMPull Ds (2 * d) (wcSuppClass DΔ (2 * d) θ) =
      wcSuppClass (Dx' 0) (2 * d) ((Abelian.Ext.mk₀ (ι' 0)).comp
        ((Abelian.Ext.mk₀ γ').comp (wcSuppPullExt DΔ Ds (2 * d) θ) (zero_add _))
        (zero_add _)) := by
    rw [hB, hD, Fin.sum_univ_one]

  have hLC : _ = _ := wc_transversal_local_index_section_indep F X d ℓ hℓ DΔ hDΔ θ
    t ht Dt hDt het Da hDa hepi γ hγ m x Dx hDx r ι hx hr hιr hιr0 hsum
    s hs₁ Ds hDs hets Da' hDa' hepi' γ' hγ' 1 x' Dx' hDx' r' ι' hx' hr' hιr' hιr0' hsum'
    k 0 hx'0.symm

  have hindep := wc_const_section_pull_indep F X d ℓ hℓ (x k) x₀ hxk hx₀ s s₀ hs₁ hs₂
    hs₀₁ hs₀₂ Ds hDs D₀ hD₀ (wcSuppClass DΔ (2 * d) θ)
  exact hLC.trans (hB'.symm.trans hindep)

theorem wc_diag_supp_transversal_count (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (DΔ : wcHMPullData (Limits.pullback.diagonal (wcPi2 F X)) ℓ) (hDΔ : wcHMPullCanonical DΔ)
    (θ : wcSuppExt DΔ (2 * d)) :
    ∃ ζ : wcHM (wcXbar F X) ℓ (2 * d),
      ∀ (t : wcXbar F X ⟶ Limits.pullback (wcPi2 F X) (wcPi2 F X))
        (ht : t ≫ Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) = 𝟙 _)
        (Dt : wcHMPullData t ℓ) (hDt : wcHMPullCanonical Dt) (m : ℕ),
        Etale (Limits.pullback.fst t (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X) →
        Nat.card {z : Spec (.of (AlgebraicClosure F)) ⟶
            Limits.pullback t (Limits.pullback.diagonal (wcPi2 F X)) //
          z ≫ Limits.pullback.fst t (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X = 𝟙 _} = m →
        wcHMPull Dt (2 * d) (wcSuppClass DΔ (2 * d) θ) =
          wcHMScalar (wcXbar F X) ℓ (2 * d) (m : ℚ_[ℓ]) ζ :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcXbar F X) ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1}
      (wcRingSheaf (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ)) := HasExt.standard _

  have hscal : ∀ (m : ℕ) (y : wcHM (wcXbar F X) ℓ (2 * d)),
      wcHMScalar (wcXbar F X) ℓ (2 * d) (m : ℚ_[ℓ]) y = m • y := by
    have hext : ∀ f g : SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ) ⟶
        SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ),
        (∀ Y, (SheafOfModules.unitHomEquiv _ f).1 Y = (SheafOfModules.unitHomEquiv _ g).1 Y) →
          f = g := by
      intro f g h
      apply (SheafOfModules.unitHomEquiv _).injective
      apply Subtype.ext
      funext Y
      exact h Y
    have hval : ∀ (c : ℚ_[ℓ]) Y,
        (SheafOfModules.unitHomEquiv _ (wcHMConst (wcXbar F X) ℓ c)).1 Y =
        (ContinuousMap.const _ (ULift.up c) :
          C(↥((Opposite.unop Y).left), ULift.{u+1} ℚ_[ℓ])) := by
      intro c Y
      unfold wcHMConst
      rw [Equiv.apply_symm_apply]
      rfl
    have hsum : ∀ (f g : SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ) ⟶
        SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ)) Y,
        (SheafOfModules.unitHomEquiv _ (f + g)).1 Y =
          (SheafOfModules.unitHomEquiv _ f).1 Y + (SheafOfModules.unitHomEquiv _ g).1 Y := by
      intro f g Y
      simp only [SheafOfModules.unitHomEquiv_apply_coe]
      rfl
    have hzero : ∀ Y, (SheafOfModules.unitHomEquiv _
        (0 : SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ) ⟶
          SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ))).1 Y = 0 := by
      intro Y
      simp only [SheafOfModules.unitHomEquiv_apply_coe]
      rfl
    have hid : ∀ Y, (SheafOfModules.unitHomEquiv _
        (𝟙 (SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ)))).1 Y =
        (ContinuousMap.const _ (ULift.up 1) :
          C(↥((Opposite.unop Y).left), ULift.{u+1} ℚ_[ℓ])) := by
      intro Y
      simp only [SheafOfModules.unitHomEquiv_apply_coe]
      rfl
    have hadd : ∀ a b : ℚ_[ℓ], wcHMConst (wcXbar F X) ℓ (a + b) =
        wcHMConst (wcXbar F X) ℓ a + wcHMConst (wcXbar F X) ℓ b := by
      intro a b
      apply hext
      intro Y
      rw [hsum, hval, hval, hval]
      rfl
    have h0 : wcHMConst (wcXbar F X) ℓ 0 = 0 := by
      apply hext
      intro Y
      rw [hval, hzero]
      rfl
    have h1 : wcHMConst (wcXbar F X) ℓ 1 = 𝟙 _ := by
      apply hext
      intro Y
      rw [hval, hid]
    intro m y
    induction m with
    | zero =>
      show y.comp (Abelian.Ext.mk₀ (wcHMConst (wcXbar F X) ℓ ((0 : ℕ) : ℚ_[ℓ]))) (add_zero _) =
        0 • y
      rw [Nat.cast_zero, h0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero, zero_smul]
    | succ m ih =>
      show y.comp (Abelian.Ext.mk₀ (wcHMConst (wcXbar F X) ℓ ((m + 1 : ℕ) : ℚ_[ℓ])))
        (add_zero _) = (m + 1) • y
      rw [Nat.cast_succ, hadd, h1, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add,
        Abelian.Ext.comp_mk₀_id, succ_nsmul, ← ih]
      rfl

  obtain ⟨ζ, hζ⟩ := wc_diag_transversal_local_index F X d ℓ hℓ DΔ hDΔ θ
  refine ⟨ζ, ?_⟩
  intro t ht Dt hDt m het hcard
  haveI : IsClosedImmersion (Limits.pullback.diagonal (wcPi2 F X)) := inferInstance
  haveI : IsClosedImmersion (Limits.pullback.fst t (Limits.pullback.diagonal (wcPi2 F X))) :=
    inferInstance
  haveI : IsLocallyNoetherian (wcXbar F X) := inferInstance

  obtain ⟨Da, hDa, γ, hγ, hepi⟩ := wc_closed_supp_base_change_noeth
    (Limits.pullback.diagonal (wcPi2 F X)) t DΔ hDΔ Dt hDt

  obtain ⟨x, Dx, hDx, r, ι, hx, hr, hιr, hιr0, hsum⟩ := wc_closed_supp_finite_points_split F X ℓ
    (Limits.pullback.fst t (Limits.pullback.diagonal (wcPi2 F X))) het m hcard Da hDa
  have hloc := hζ t ht Dt hDt het Da hDa hepi γ hγ m x Dx hDx r ι hx hr hιr hιr0 hsum

  have hB : wcHMPull Dt (2 * d) (wcSuppClass DΔ (2 * d) θ) =
      wcSuppClass Da (2 * d) ((Abelian.Ext.mk₀ γ).comp (wcSuppPullExt DΔ Dt (2 * d) θ)
        (zero_add _)) := by
    have e1 : wcHMPull Dt (2 * d) (wcSuppClass DΔ (2 * d) θ) =
        (Abelian.Ext.mk₀ (Dt.μ.inv ≫ Dt.Φ.map (wcSuppUnitMap DΔ))).comp
          (wcSuppPullExt DΔ Dt (2 * d) θ) (zero_add _) := by
      haveI := Dt.additive
      haveI := Dt.presLim
      haveI := Dt.presColim
      show (Abelian.Ext.mk₀ Dt.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dt.Φ
          ((Abelian.Ext.mk₀ (wcSuppUnitMap DΔ)).comp θ (zero_add _))).comp
          (Abelian.Ext.mk₀ Dt.μ.hom) (add_zero _)) (zero_add _) =
        (Abelian.Ext.mk₀ (Dt.μ.inv ≫ Dt.Φ.map (wcSuppUnitMap DΔ))).comp
          ((Abelian.Ext.mapExactFunctor Dt.Φ θ).comp (Abelian.Ext.mk₀ Dt.μ.hom) (add_zero _))
          (zero_add _)
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.comp_assoc_of_third_deg_zero, ← Abelian.Ext.mk₀_comp_mk₀,
        Abelian.Ext.comp_assoc_of_second_deg_zero]
    rw [e1, ← hγ]
    show (Abelian.Ext.mk₀ (wcSuppUnitMap Da ≫ γ)).comp (wcSuppPullExt DΔ Dt (2 * d) θ)
        (zero_add _) =
      (Abelian.Ext.mk₀ (wcSuppUnitMap Da)).comp ((Abelian.Ext.mk₀ γ).comp
        (wcSuppPullExt DΔ Dt (2 * d) θ) (zero_add _)) (zero_add _)
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]

  have hD : wcSuppClass Da (2 * d) ((Abelian.Ext.mk₀ γ).comp (wcSuppPullExt DΔ Dt (2 * d) θ)
        (zero_add _)) =
      ∑ k, wcSuppClass (Dx k) (2 * d) ((Abelian.Ext.mk₀ (ι k)).comp
        ((Abelian.Ext.mk₀ γ).comp (wcSuppPullExt DΔ Dt (2 * d) θ) (zero_add _))
        (zero_add _)) := by
    have hρ : wcSuppUnitMap Da = ∑ k, wcSuppUnitMap (Dx k) ≫ ι k := by
      calc wcSuppUnitMap Da = wcSuppUnitMap Da ≫ ∑ k, r k ≫ ι k := by
            rw [hsum, Category.comp_id]
        _ = ∑ k, wcSuppUnitMap (Dx k) ≫ ι k := by
            rw [Preadditive.comp_sum]
            refine Finset.sum_congr rfl (fun k _ => ?_)
            rw [← Category.assoc, hr k]
    show (Abelian.Ext.mk₀ (wcSuppUnitMap Da)).comp
        ((Abelian.Ext.mk₀ γ).comp (wcSuppPullExt DΔ Dt (2 * d) θ) (zero_add _)) (zero_add _) =
      ∑ k, (Abelian.Ext.mk₀ (wcSuppUnitMap (Dx k))).comp ((Abelian.Ext.mk₀ (ι k)).comp
        ((Abelian.Ext.mk₀ γ).comp (wcSuppPullExt DΔ Dt (2 * d) θ) (zero_add _))
        (zero_add _)) (zero_add _)
    rw [hρ, Abelian.Ext.mk₀_sum, Abelian.Ext.sum_comp]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]

  rw [hB, hD, Finset.sum_congr rfl (fun k _ => hloc k), Finset.sum_const, Finset.card_univ,
    Fintype.card_fin, hscal]

theorem wc_ybar_diag_kunneth_class (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (D2 : wcHMPullData (Limits.pullback.snd (wcPi2 F X) (wcPi2 F X)) ℓ) (hD2 : wcHMPullCanonical D2)
    (DΔ : wcHMPullData (Limits.pullback.diagonal (wcPi2 F X)) ℓ) (hDΔ : wcHMPullCanonical DΔ)
    (ω : wcHM (wcXbar F X) ℓ (2 * d)) (hω : ω ≠ 0) :
    ∃ c : wcHM (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d),
      (∀ z : wcHM (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d),
        wcHMPull DΔ (2 * d) z = 0 →
        wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d) (by omega) z c = 0) ∧
      wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d) (by omega)
        (wcHMPull D2 (2 * d) ω) c ≠ 0 :=
by
  classical

  have hassoc : ∀ (S : Scheme.{u}) (a₁ a₂ a₃ a₁₂ a₂₃ a : ℕ) (h₁₂ : a₁ + a₂ = a₁₂)
      (h₂₃ : a₂ + a₃ = a₂₃) (h1 : a₁₂ + a₃ = a) (h2 : a₁ + a₂₃ = a)
      (x : wcHM S ℓ a₁) (y : wcHM S ℓ a₂) (z : wcHM S ℓ a₃),
      wcHMCup S ℓ a₁₂ a₃ a h1 (wcHMCup S ℓ a₁ a₂ a₁₂ h₁₂ x y) z =
        wcHMCup S ℓ a₁ a₂₃ a h2 x (wcHMCup S ℓ a₂ a₃ a₂₃ h₂₃ y z) := by
    intro S a₁ a₂ a₃ a₁₂ a₂₃ a h₁₂ h₂₃ h1 h2 x y z
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    simp only [wcHMCup, Abelian.Ext.bilinearComp_apply_apply]
    exact Abelian.Ext.comp_assoc x y z h₁₂ h₂₃ (by omega)
  have hscL : ∀ (S : Scheme.{u}) (p q r : ℕ) (h : p + q = r) (x : wcHM S ℓ p) (y : wcHM S ℓ q)
      (t : ℚ_[ℓ]), wcHMCup S ℓ p q r h (wcHMScalar S ℓ p t x) y =
        wcHMScalar S ℓ r t (wcHMCup S ℓ p q r h x y) := by
    intro S p q r h x y t
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    have hcen := wc_hm_unit_end_central S ℓ (wcHMConst S ℓ t) q y
    show (x.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ t)) (add_zero p)).comp y h =
      (x.comp y h).comp (Abelian.Ext.mk₀ (wcHMConst S ℓ t)) (add_zero r)
    rw [Abelian.Ext.comp_assoc_of_second_deg_zero, hcen,
      ← Abelian.Ext.comp_assoc_of_third_deg_zero]
  have F1 : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcHMPullData f ℓ) (hD : wcHMPullCanonical D)
      (n : ℕ) (t : ℚ_[ℓ]) (x : wcHM S ℓ n),
      wcHMPull D n (wcHMScalar S ℓ n t x) = wcHMScalar S' ℓ n t (wcHMPull D n x) := by
    intro S S' f D hD n t x
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    have hk : D.Φ.map (wcHMConst S ℓ t) ≫ D.μ.hom = D.μ.hom ≫ wcHMConst S' ℓ t := by
      rw [← wc_hm_pull_const D hD t, Iso.hom_inv_id_assoc]
    have e2 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf S' ℓ)} (z : Abelian.Ext A B n)
        (a : B ⟶ C') (b : C' ⟶ D'),
        (z.comp (Abelian.Ext.mk₀ a) (add_zero n)).comp (Abelian.Ext.mk₀ b) (add_zero n) =
          z.comp (Abelian.Ext.mk₀ (a ≫ b)) (add_zero n) := by
      intro A B C' D' z a b
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
    have e3 := Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mk₀ D.μ.inv)
      ((Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero n))
      (Abelian.Ext.mk₀ (wcHMConst S' ℓ t)) (zero_add n)
    show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ
        (x.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ t)) (add_zero n))).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero n)) (zero_add n) =
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ x).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero n)) (zero_add n)).comp
        (Abelian.Ext.mk₀ (wcHMConst S' ℓ t)) (add_zero n)
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀, e2, e3, e2, hk]
  have F3 : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcHMPullData f ℓ) (p q r : ℕ) (h : p + q = r)
      (x : wcHM S ℓ p) (y : wcHM S ℓ q),
      wcHMPull D r (wcHMCup S ℓ p q r h x y) =
        wcHMCup S' ℓ p q r h (wcHMPull D p x) (wcHMPull D q y) := by
    intro S S' f D p q r h x y
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ (x.comp y h)).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero r)) (zero_add r) =
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ x).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero p)) (zero_add p)).comp
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ y).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero q)) (zero_add q)) h
    have i1 := Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ D.μ.inv)
      ((Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero p))
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ y).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero q)) (zero_add q)) (zero_add p) h
      (by omega : 0 + p + q = r)
    have i2 := Abelian.Ext.comp_assoc_of_second_deg_zero (Abelian.Ext.mapExactFunctor D.Φ x)
      (Abelian.Ext.mk₀ D.μ.hom)
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ y).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero q)) (zero_add q)) h
    have i3 : (Abelian.Ext.mk₀ D.μ.hom).comp ((Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero q))
        (zero_add q)) (zero_add q) =
        (Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero q) := by
      rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
        Abelian.Ext.mk₀_id_comp]
    have i4 := Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mapExactFunctor D.Φ x)
      (Abelian.Ext.mapExactFunctor D.Φ y) (Abelian.Ext.mk₀ D.μ.hom) h
    rw [Abelian.Ext.mapExactFunctor_comp, i1, i2, i3, ← i4]

  obtain ⟨D1, hD1⟩ := wc_hm_pull_data_exists (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)) ℓ
  obtain ⟨D0, hD0⟩ := wc_hm_pull_data_exists (𝟙 (wcXbar F X)) ℓ
  have F4 : ∀ (p : Limits.pullback (wcPi2 F X) (wcPi2 F X) ⟶ wcXbar F X)
      (hp : Limits.pullback.diagonal (wcPi2 F X) ≫ p = 𝟙 _) (Dp : wcHMPullData p ℓ)
      (hDp : wcHMPullCanonical Dp) (n : ℕ) (x : wcHM (wcXbar F X) ℓ n),
      wcHMPull DΔ n (wcHMPull Dp n x) = x := by
    intro p hp Dp hDp n x
    exact (wc_hm_pull_comp p (Limits.pullback.diagonal (wcPi2 F X)) (𝟙 _) hp Dp hDp DΔ hDΔ
      D0 hD0 n x).symm.trans (wc_hm_pull_id (𝟙 _) rfl D0 hD0 n x)


  have h : WeaklyEtale (Limits.pullback.fst X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F)
  choose r e he using wc_coh_finite F X d ℓ hℓ h
  have hvan := wc_coh_vanishing F X d ℓ hℓ h
  obtain ⟨T, hTs, -⟩ := wc_hm_comparison F X h ℓ
  obtain ⟨⟨e₁, he₁⟩, -⟩ := wc_top_coh_frobenius F X d ℓ hℓ h
  have hTinv : ∀ (i : ℕ) (c : ℚ_[ℓ]) (y : wcHM (wcXbar F X) ℓ i),
      (T i).symm (wcHMScalar (wcXbar F X) ℓ i c y) = wcCohScalar F X h ℓ i c ((T i).symm y) := by
    intro i c y
    apply (T i).injective
    rw [AddEquiv.apply_symm_apply, hTs, AddEquiv.apply_symm_apply]
  let η₀ : wcHM (wcXbar F X) ℓ (2 * d) →+ ℚ_[ℓ] :=
    (Pi.evalAddMonoidHom (fun _ : Fin 1 => ℚ_[ℓ]) 0).comp
      (e₁.toAddMonoidHom.comp (T (2 * d)).symm.toAddMonoidHom)
  have hη₀app : ∀ y, η₀ y = e₁ ((T (2 * d)).symm y) 0 := fun y => rfl
  have hη₀inj : Function.Injective η₀ := by
    intro y y' hyy
    rw [hη₀app, hη₀app] at hyy
    have h1 : e₁ ((T (2 * d)).symm y) = e₁ ((T (2 * d)).symm y') := by
      funext k
      rw [Subsingleton.elim k 0]
      exact hyy
    exact (T (2 * d)).symm.injective (e₁.injective h1)
  have hη₀c : ∀ (c : ℚ_[ℓ]) (x : wcHM (wcXbar F X) ℓ (2 * d)),
      η₀ (wcHMScalar (wcXbar F X) ℓ (2 * d) c x) = c * η₀ x := by
    intro c x
    rw [hη₀app, hη₀app, hTinv, he₁]
    rfl
  have hκ : η₀ ω ≠ 0 := fun h0 => hω (hη₀inj (h0.trans (map_zero η₀).symm))
  let η : wcHM (wcXbar F X) ℓ (2 * d) →+ ℚ_[ℓ] := (AddMonoidHom.mulLeft (η₀ ω)⁻¹).comp η₀
  have hηapp : ∀ y, η y = (η₀ ω)⁻¹ * η₀ y := fun y => rfl
  have hηinj : Function.Injective η := by
    intro x y hxy
    rw [hηapp, hηapp] at hxy
    exact hη₀inj (mul_left_cancel₀ (inv_ne_zero hκ) hxy)
  have hηc : ∀ (c : ℚ_[ℓ]) (x : wcHM (wcXbar F X) ℓ (2 * d)),
      η (wcHMScalar (wcXbar F X) ℓ (2 * d) c x) = c * η x := by
    intro c x
    rw [hηapp, hηapp, hη₀c, mul_left_comm]
  have hηω : η ω = 1 := by
    rw [hηapp]
    exact inv_mul_cancel₀ hκ
  have F5 : ∀ z : wcHM (wcXbar F X) ℓ (2 * d),
      z = wcHMScalar (wcXbar F X) ℓ (2 * d) (η z) ω := by
    intro z
    apply hηinj
    rw [hηc, hηω, mul_one]

  have hvanHM : ∀ i : ℕ, 2 * d < i → ∀ x : wcHM (wcXbar F X) ℓ i, x = 0 := by
    intro i hi x
    have h0 := hvan i hi ((T i).symm x)
    calc x = T i ((T i).symm x) := (AddEquiv.apply_symm_apply _ _).symm
      _ = T i 0 := by rw [h0]
      _ = 0 := map_zero _
  let E : ∀ i : ℕ, wcHM (wcXbar F X) ℓ i ≃+ (Fin (r i) → ℚ_[ℓ]) := fun i => (T i).symm.trans (e i)
  have hE : ∀ i ≤ 2 * d, ∀ (c : ℚ_[ℓ]) (x : wcHM (wcXbar F X) ℓ i),
      E i (wcHMScalar (wcXbar F X) ℓ i c x) = c • E i x := by
    intro i _ c x
    show e i ((T i).symm (wcHMScalar (wcXbar F X) ℓ i c x)) = c • e i ((T i).symm x)
    rw [hTinv, he]
  have hF1 : 𝟙 (wcXbar F X) ≫ wcPi2 F X = wcPi2 F X := Category.id_comp _
  choose Dγ hDγ using fun m : ℕ =>
    wc_hm_pull_data_exists (wcGraph (wcPi2 F X) (𝟙 (wcXbar F X)) hF1 m) ℓ
  obtain ⟨c, hc, -⟩ := wc_lefschetz_diag_trace F X d ℓ hℓ (𝟙 (wcXbar F X)) hF1 D1 hD1 D2 hD2
    Dγ hDγ D0 hD0 η hηinj hηc ω hηω hvanHM r E hE

  have key : ∀ z : wcHM (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d),
      wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d) (by omega) z c =
        wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d) (by omega)
          (wcHMPull D1 (2 * d) (wcHMPull DΔ (2 * d) z)) (wcHMPull D2 (2 * d) ω) := by
    intro z
    have hz := wc_ybar_kunneth_span F X d ℓ hℓ D1 hD1 D2 hD2 z
    induction hz using AddSubgroup.closure_induction with
    | mem w hw =>
      obtain ⟨t, j, hj, a, b, rfl⟩ := hw
      have hsign : ((-1 : ℤ) ^ ((2 * d - j) * (2 * d))) = 1 :=
        Even.neg_one_pow ((even_two_mul d).mul_left _)
      have hinner :
          wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d) (by omega)
            (wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ j (2 * d - j) (2 * d) (by omega)
              (wcHMPull D1 j a) (wcHMPull D2 (2 * d - j) b)) c =
          wcHMScalar (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (4 * d)
            (η (wcHMCup (wcXbar F X) ℓ j (2 * d - j) (2 * d) (by omega) a b))
            (wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d)
              (by omega) (wcHMPull D1 (2 * d) ω) (wcHMPull D2 (2 * d) ω)) := by
        calc wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d) (by omega)
              (wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ j (2 * d - j) (2 * d) (by omega)
                (wcHMPull D1 j a) (wcHMPull D2 (2 * d - j) b)) c
            = wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ j (4 * d - j) (4 * d) (by omega)
                (wcHMPull D1 j a)
                (wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d - j) (2 * d)
                  (4 * d - j) (by omega) (wcHMPull D2 (2 * d - j) b) c) :=
              hassoc _ j (2 * d - j) (2 * d) (2 * d) (4 * d - j) (4 * d) (by omega) (by omega)
                (by omega) (by omega) _ _ _
          _ = wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ j (4 * d - j) (4 * d) (by omega)
                (wcHMPull D1 j a)
                (wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d - j)
                  (4 * d - j) (by omega) c (wcHMPull D2 (2 * d - j) b)) := by
              rw [wc_hm_graded_comm (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d - j) (2 * d)
                (4 * d - j) (by omega) (by omega) (wcHMPull D2 (2 * d - j) b) c, hsign, one_zsmul]
          _ = wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (j + 2 * d) (2 * d - j) (4 * d)
                (by omega)
                (wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ j (2 * d) (j + 2 * d) rfl
                  (wcHMPull D1 j a) c) (wcHMPull D2 (2 * d - j) b) :=
              (hassoc _ j (2 * d) (2 * d - j) (j + 2 * d) (4 * d - j) (4 * d) rfl (by omega)
                (by omega) (by omega) _ _ _).symm
          _ = _ := hc j hj a b
      have hΔ : wcHMPull DΔ (2 * d)
          (wcHMScalar (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) t
            (wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ j (2 * d - j) (2 * d) (by omega)
              (wcHMPull D1 j a) (wcHMPull D2 (2 * d - j) b))) =
          wcHMScalar (wcXbar F X) ℓ (2 * d) t (wcHMScalar (wcXbar F X) ℓ (2 * d)
            (η (wcHMCup (wcXbar F X) ℓ j (2 * d - j) (2 * d) (by omega) a b)) ω) := by
        rw [F1 DΔ hDΔ, F3 DΔ, F4 _ (Limits.pullback.diagonal_fst _) D1 hD1,
          F4 _ (Limits.pullback.diagonal_snd _) D2 hD2]
        exact congrArg (wcHMScalar (wcXbar F X) ℓ (2 * d) t) (F5 _)
      rw [hscL, hinner, hΔ, F1 D1 hD1, F1 D1 hD1, hscL, hscL]
    | zero =>
      simp only [map_zero, AddMonoidHom.zero_apply]
    | add x y _ _ hx hy =>
      simp only [map_add, AddMonoidHom.add_apply, hx, hy]
    | neg x _ hx =>
      simp only [map_neg, AddMonoidHom.neg_apply, hx]

  have hΔ2 : wcHMPull DΔ (2 * d) (wcHMPull D2 (2 * d) ω) = ω :=
    F4 _ (Limits.pullback.diagonal_snd _) D2 hD2 (2 * d) ω
  refine ⟨c, ?_, ?_⟩
  · intro z hz
    rw [key z, hz]
    simp only [map_zero, AddMonoidHom.zero_apply]
  · rw [key, hΔ2]
    exact wc_ybar_top_class_nonzero F X d ℓ hℓ D1 hD1 D2 hD2 ω hω

theorem wc_ybar_fibre_projection_swap (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (D1 : wcHMPullData (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)) ℓ) (hD1 : wcHMPullCanonical D1)
    (D2 : wcHMPullData (Limits.pullback.snd (wcPi2 F X) (wcPi2 F X)) ℓ) (hD2 : wcHMPullCanonical D2)
    (x₀ : Spec (.of (AlgebraicClosure F)) ⟶ wcXbar F X) (hx₀ : x₀ ≫ wcPi2 F X = 𝟙 _)
    (t : wcXbar F X ⟶ Limits.pullback (wcPi2 F X) (wcPi2 F X))
    (ht₁ : t ≫ Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) = 𝟙 _)
    (ht₂ : t ≫ Limits.pullback.snd (wcPi2 F X) (wcPi2 F X) = wcPi2 F X ≫ x₀)
    (Dt : wcHMPullData t ℓ) (hDt : wcHMPullCanonical Dt)
    (ω : wcHM (wcXbar F X) ℓ (2 * d))
    (y : wcHM (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d)) :
    wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d) (by omega)
        (wcHMPull D2 (2 * d) ω) y =
      wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d) (by omega)
        (wcHMPull D2 (2 * d) ω) (wcHMPull D1 (2 * d) (wcHMPull Dt (2 * d) y)) :=
by
  classical
  have F3 : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcHMPullData f ℓ) (p q r : ℕ) (h : p + q = r)
      (x : wcHM S ℓ p) (y : wcHM S ℓ q),
      wcHMPull D r (wcHMCup S ℓ p q r h x y) =
        wcHMCup S' ℓ p q r h (wcHMPull D p x) (wcHMPull D q y) := by
    intro S S' f D p q r h x y
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ (x.comp y h)).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero r)) (zero_add r) =
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ x).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero p)) (zero_add p)).comp
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ y).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero q)) (zero_add q)) h
    have i1 := Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ D.μ.inv)
      ((Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero p))
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ y).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero q)) (zero_add q)) (zero_add p) h
      (by omega : 0 + p + q = r)
    have i2 := Abelian.Ext.comp_assoc_of_second_deg_zero (Abelian.Ext.mapExactFunctor D.Φ x)
      (Abelian.Ext.mk₀ D.μ.hom)
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ y).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero q)) (zero_add q)) h
    have i3 : (Abelian.Ext.mk₀ D.μ.hom).comp ((Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero q))
        (zero_add q)) (zero_add q) =
        (Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero q) := by
      rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
        Abelian.Ext.mk₀_id_comp]
    have i4 := Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mapExactFunctor D.Φ x)
      (Abelian.Ext.mapExactFunctor D.Φ y) (Abelian.Ext.mk₀ D.μ.hom) h
    rw [Abelian.Ext.mapExactFunctor_comp, i1, i2, i3, ← i4]

  set s : Limits.pullback (wcPi2 F X) (wcPi2 F X) ⟶ Limits.pullback (wcPi2 F X) (wcPi2 F X) :=
    Limits.pullback.lift (Limits.pullback.snd (wcPi2 F X) (wcPi2 F X))
      (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)) Limits.pullback.condition.symm with hsdef
  have hs1 : s ≫ Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) =
      Limits.pullback.snd (wcPi2 F X) (wcPi2 F X) := Limits.pullback.lift_fst _ _ _
  have hs2 : s ≫ Limits.pullback.snd (wcPi2 F X) (wcPi2 F X) =
      Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) := Limits.pullback.lift_snd _ _ _
  have hss : s ≫ s = 𝟙 _ := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hs1, hs2, Category.id_comp]
    · rw [Category.assoc, hs2, hs1, Category.id_comp]
  set i : wcXbar F X ⟶ Limits.pullback (wcPi2 F X) (wcPi2 F X) := t ≫ s with hidef
  have hi1 : i ≫ Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) = wcPi2 F X ≫ x₀ := by
    rw [hidef, Category.assoc, hs1, ht₂]
  have hi2 : i ≫ Limits.pullback.snd (wcPi2 F X) (wcPi2 F X) = 𝟙 _ := by
    rw [hidef, Category.assoc, hs2, ht₁]
  have his : i ≫ s = t := by
    rw [hidef, Category.assoc, hss, Category.comp_id]
  obtain ⟨Ds, hDs⟩ := wc_hm_pull_data_exists s ℓ
  obtain ⟨Di, hDi⟩ := wc_hm_pull_data_exists i ℓ
  obtain ⟨D0, hD0⟩ := wc_hm_pull_data_exists (𝟙 (Limits.pullback (wcPi2 F X) (wcPi2 F X))) ℓ
  have R1 : ∀ x : wcHM (wcXbar F X) ℓ (2 * d),
      wcHMPull Ds (2 * d) (wcHMPull D1 (2 * d) x) = wcHMPull D2 (2 * d) x := fun x =>
    (wc_hm_pull_comp _ s _ hs1 D1 hD1 Ds hDs D2 hD2 (2 * d) x).symm
  have R2 : ∀ x : wcHM (wcXbar F X) ℓ (2 * d),
      wcHMPull Ds (2 * d) (wcHMPull D2 (2 * d) x) = wcHMPull D1 (2 * d) x := fun x =>
    (wc_hm_pull_comp _ s _ hs2 D2 hD2 Ds hDs D1 hD1 (2 * d) x).symm
  have R3 : ∀ z : wcHM (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d),
      wcHMPull Ds (2 * d) (wcHMPull Ds (2 * d) z) = z := fun z =>
    (wc_hm_pull_comp s s _ hss Ds hDs Ds hDs D0 hD0 (2 * d) z).symm.trans
      (wc_hm_pull_id _ rfl D0 hD0 (2 * d) z)
  have R4 : ∀ z : wcHM (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d),
      wcHMPull Di (2 * d) (wcHMPull Ds (2 * d) z) = wcHMPull Dt (2 * d) z := fun z =>
    (wc_hm_pull_comp s i t his Ds hDs Di hDi Dt hDt (2 * d) z).symm
  have hFP := wc_ybar_fibre_projection F X d ℓ hℓ D1 hD1 D2 hD2 x₀ hx₀ i hi1 hi2 Di hDi ω
    (wcHMPull Ds (2 * d) y)
  have h := congrArg (wcHMPull Ds (4 * d)) hFP
  rw [F3 Ds, F3 Ds, R1, R3, R4, R2] at h
  exact h

theorem wc_hm_top_line (K : Type u) [Field K] [IsAlgClosed K]
    {Y : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n : ℕ) [SmoothOfRelativeDimension n pY]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0) (k : ℕ) (hk : k = 2 * n) :
    ∃ η : wcHM Y ℓ k →+ ℚ_[ℓ], Function.Injective η ∧
      ∀ (c : ℚ_[ℓ]) (x : wcHM Y ℓ k), η (wcHMScalar Y ℓ k c x) = c * η x :=
by
  classical
  subst hk



  have hpowK : ∀ e : ℕ, ((ℓ ^ e : ℕ) : K) ≠ 0 := by
    intro e
    rw [Nat.cast_pow]
    exact pow_ne_zero e hℓ



  have hfinZ : ∀ e j : ℕ, Finite (Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
      (wcContSheaf Y (ZMod (ℓ ^ e))) j) := by
    intro e j
    obtain ⟨E⟩ := wc_proet_etale_comparison_zmod K Y pY (ℓ ^ e) j
    haveI := wc_etale_proper_finite K Y pY (ℓ ^ e) (hpowK e) j
    have h : Finite (Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
        (wcZModSheaf Y (ℓ ^ e)) j) := Finite.of_equiv _ E.symm
    exact h



  have hsep := wc_int_ext_separated_of_finite Y (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) ℓ
    hfinZ (2 * n)



  have hG : Finite (Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
        (Limits.cokernel (wcIntScalar Y ℓ (ℓ : ℤ_[ℓ]))) (2 * n)) ∧
      Nat.card (Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
        (Limits.cokernel (wcIntScalar Y ℓ (ℓ : ℤ_[ℓ]))) (2 * n)) ≤ ℓ := by
    have e0 := wc_int_coker_zmod Y ℓ 1 (ℓ : ℤ_[ℓ]) (pow_one _).symm
    rw [pow_one] at e0
    obtain ⟨e⟩ := e0
    let E₁ : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
        (Limits.cokernel (wcIntScalar Y ℓ (ℓ : ℤ_[ℓ]))) (2 * n) ≃
        Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) (wcZModSheaf Y ℓ) (2 * n) :=
      { toFun := fun x => x.comp (Abelian.Ext.mk₀ e.hom) (add_zero (2 * n))
        invFun := fun y => y.comp (Abelian.Ext.mk₀ e.inv) (add_zero (2 * n))
        left_inv := fun x => by
          simp only
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero (2 * n)) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
        right_inv := fun y => by
          simp only
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero (2 * n)) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id] }
    obtain ⟨E₃⟩ := wc_proet_etale_comparison_zmod K Y pY ℓ (2 * n)
    obtain ⟨hfin, hcard⟩ := wc_et_top_coh_card_le K Y pY n ℓ hℓ
    let E := E₁.trans E₃
    haveI := hfin
    refine ⟨Finite.of_equiv _ E.symm, ?_⟩
    rw [Nat.card_congr E]
    exact hcard



  haveI hcpt : CompactSpace ↥(Scheme.ProEt.mk (𝟙 Y)).left :=
    (QuasiCompact.compactSpace_of_compactSpace pY : CompactSpace ↥Y)
  haveI hqs : QuasiSeparatedSpace ↥(Scheme.ProEt.mk (𝟙 Y)).left :=
    (quasiSeparatedSpace_of_quasiSeparated pY : QuasiSeparatedSpace ↥Y)
  have hden := (proet_qcqs_ladic_rationalization Y (Scheme.ProEt.mk (𝟙 Y)) ℓ (2 * n)).1



  have descent : ∀ i : ℕ,
      Finite (Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
        (Limits.cokernel (wcIntScalar Y ℓ (ℓ : ℤ_[ℓ]))) i) →
      Nat.card (Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
        (Limits.cokernel (wcIntScalar Y ℓ (ℓ : ℤ_[ℓ]))) i) ≤ ℓ →
      (∀ x : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) (wcIntSheaf Y ℓ) i,
        (∀ e : ℕ, x.comp (Abelian.Ext.mk₀
          (Limits.cokernel.π (wcIntScalar Y ℓ ((ℓ : ℤ_[ℓ]) ^ e)))) (add_zero i) = 0) → x = 0) →
      (∀ x : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) (wcLadicSheaf Y ℓ) i,
        ∃ (e : ℕ) (y : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) (wcIntSheaf Y ℓ) i),
          ℓ ^ e • x = y.comp (Abelian.Ext.mk₀ (wcIntToLadic Y ℓ)) (add_zero i)) →
      ∃ ηV : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) (wcLadicSheaf Y ℓ) i →+ ℚ_[ℓ],
        Function.Injective ηV ∧
        ∀ (c : ℚ_[ℓ]) (x : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) (wcLadicSheaf Y ℓ) i),
          ηV (x.comp (Abelian.Ext.mk₀ (wcLadicScalar Y ℓ c)) (add_zero i)) = c * ηV x := by
    intro i hGfin hGcard hsepi hdeni
    haveI := hGfin

    have s4 : ∀ (R : Type) [Ring R] (G : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
        (s : R → (G ⟶ G)), s 1 = 𝟙 G → (∀ a b, s (a * b) = s b ≫ s a) →
        (∀ a b, s (a + b) = s a + s b) →
        (∀ x : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) G i,
            x.comp (Abelian.Ext.mk₀ (s 1)) (add_zero i) = x) ∧
        (∀ a b (x : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) G i),
            x.comp (Abelian.Ext.mk₀ (s (a * b))) (add_zero i) =
            (x.comp (Abelian.Ext.mk₀ (s b)) (add_zero i)).comp (Abelian.Ext.mk₀ (s a))
              (add_zero i)) ∧
        (∀ a b (x : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) G i),
            x.comp (Abelian.Ext.mk₀ (s (a + b))) (add_zero i) =
            x.comp (Abelian.Ext.mk₀ (s a)) (add_zero i) +
              x.comp (Abelian.Ext.mk₀ (s b)) (add_zero i)) := by
      intro R _ G s h1 hmul hadd
      refine ⟨fun x => ?_, fun a b x => ?_, fun a b x => ?_⟩
      · rw [h1, Abelian.Ext.comp_mk₀_id]
      · rw [hmul, ← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc _ _ _ (add_zero i)
          (add_zero 0) (by omega)]
      · rw [hadd, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add]
    obtain ⟨hs1, hsmul, hsadd, hscomm⟩ := wc_int_scalar_ring Y ℓ
    obtain ⟨hq1, hqmul, hqadd⟩ := wc_ladic_scalar_ring Y ℓ
    let M := Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) (wcIntSheaf Y ℓ) i
    letI smulM : SMul ℤ_[ℓ] M :=
      ⟨fun a m => m.comp (Abelian.Ext.mk₀ (wcIntScalar Y ℓ a)) (add_zero i)⟩
    obtain ⟨A1, Amul, Aadd⟩ := s4 ℤ_[ℓ] (wcIntSheaf Y ℓ) (wcIntScalar Y ℓ) hs1 hsmul hsadd
    letI modM : Module ℤ_[ℓ] M := Module.ofMinimalAxioms
      (fun a x y => Abelian.Ext.add_comp x y _ _)
      (fun a b x => Aadd a b x)
      (fun a b x => Amul a b x)
      (fun x => A1 x)
    let V := Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) (wcLadicSheaf Y ℓ) i
    letI smulV : SMul ℚ_[ℓ] V :=
      ⟨fun c x => x.comp (Abelian.Ext.mk₀ (wcLadicScalar Y ℓ c)) (add_zero i)⟩
    obtain ⟨B1, Bmul, Badd⟩ := s4 ℚ_[ℓ] (wcLadicSheaf Y ℓ) (wcLadicScalar Y ℓ) hq1 hqmul hqadd
    letI modV : Module ℚ_[ℓ] V := Module.ofMinimalAxioms
      (fun a x y => Abelian.Ext.add_comp x y _ _)
      (fun a b x => Badd a b x)
      (fun a b x => Bmul a b x)
      (fun x => B1 x)

    haveI hmono : Mono (wcIntScalar Y ℓ (ℓ : ℤ_[ℓ])) := wc_int_scalar_ell_mono Y ℓ
    let f := wcIntScalar Y ℓ (ℓ : ℤ_[ℓ])
    let S : ShortComplex (Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) :=
      ShortComplex.mk f (Limits.cokernel.π f) (Limits.cokernel.condition f)
    have hS : S.ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel f) hmono inferInstance
    let β : M →+ Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) (Limits.cokernel f) i :=
      (Abelian.Ext.mk₀ (Limits.cokernel.π f)).postcomp
        (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) (add_zero i)
    have hβtors : ∀ m : M, ℓ • β m = 0 := by
      intro m
      rw [← map_nsmul, ← Nat.cast_smul_eq_nsmul ℤ_[ℓ] ℓ m]
      change ((m.comp (Abelian.Ext.mk₀ f) (add_zero i)).comp
        (Abelian.Ext.mk₀ (Limits.cokernel.π f)) (add_zero i)) = 0
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Limits.cokernel.condition, Abelian.Ext.mk₀_zero,
        Abelian.Ext.comp_zero]

    obtain ⟨m₀, hm₀⟩ : ∃ m₀ : M, ∀ m, ∃ k : ℤ, β m = k • β m₀ := by
      by_cases hall : ∀ m, β m = 0
      · exact ⟨0, fun m => ⟨0, by rw [hall m, zero_zsmul]⟩⟩
      · push_neg at hall
        obtain ⟨m₀, hm₀⟩ := hall
        refine ⟨m₀, fun m => ?_⟩
        have hord : addOrderOf (β m₀) = ℓ := addOrderOf_eq_prime (hβtors m₀) hm₀
        have htop : AddSubgroup.zmultiples (β m₀) = ⊤ := by
          apply AddSubgroup.eq_top_of_le_card
          rw [Nat.card_zmultiples, hord]
          exact hGcard
        have hmem : β m ∈ AddSubgroup.zmultiples (β m₀) := by
          rw [htop]; exact AddSubgroup.mem_top _
        obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.mp hmem
        exact ⟨k, hk.symm⟩

    have hdecomp : ∀ m : M, ∃ (k : ℤ) (m' : M), m = k • m₀ + (ℓ : ℤ_[ℓ]) • m' := by
      intro m
      obtain ⟨k, hk⟩ := hm₀ m
      have h0 : (m - k • m₀).comp (Abelian.Ext.mk₀ S.g) (add_zero i) = 0 := by
        change β (m - k • m₀) = 0
        rw [map_sub, map_zsmul, hk, sub_self]
      obtain ⟨m', hm'⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hS (m - k • m₀) h0
      refine ⟨k, m', ?_⟩
      change m = k • m₀ + m'.comp (Abelian.Ext.mk₀ S.f) (add_zero i)
      rw [hm']
      abel

    have hT : ∃ T : Finset M, ∀ m : M, ∃ t ∈ T, ∃ m' : M, m = t + (ℓ : ℤ_[ℓ]) • m' := by
      have hfr : (Set.range β).Finite := Set.toFinite _
      let pre : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) (Limits.cokernel f) i → M :=
        fun y => if hy : ∃ m, β m = y then hy.choose else 0
      refine ⟨hfr.toFinset.image pre, fun m => ?_⟩
      refine ⟨pre (β m), Finset.mem_image_of_mem _ (hfr.mem_toFinset.mpr ⟨m, rfl⟩), ?_⟩
      have hpre : β (pre (β m)) = β m := by
        have hy : ∃ m', β m' = β m := ⟨m, rfl⟩
        simp only [pre, dif_pos hy]
        exact hy.choose_spec
      have h0 : (m - pre (β m)).comp (Abelian.Ext.mk₀ S.g) (add_zero i) = 0 := by
        change β (m - pre (β m)) = 0
        rw [map_sub, hpre, sub_self]
      obtain ⟨m', hm'⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hS (m - pre (β m)) h0
      refine ⟨m', ?_⟩
      change m = pre (β m) + m'.comp (Abelian.Ext.mk₀ S.f) (add_zero i)
      rw [hm']
      abel
    have hD : ∀ w : ℕ → M, (∀ e, w e = (ℓ : ℤ_[ℓ]) • w (e + 1)) → w 0 = 0 := by
      intro w hw
      have hpw : ∀ e : ℕ, w 0 = ((ℓ : ℤ_[ℓ]) ^ e) • w e := by
        intro e
        induction e with
        | zero => rw [pow_zero, one_smul]
        | succ e ih => rw [ih, hw e, ← mul_smul, ← pow_succ]
      apply hsepi (w 0)
      intro e
      rw [hpw e]
      change ((w e).comp (Abelian.Ext.mk₀ (wcIntScalar Y ℓ ((ℓ : ℤ_[ℓ]) ^ e))) (add_zero i)).comp
        (Abelian.Ext.mk₀ (Limits.cokernel.π (wcIntScalar Y ℓ ((ℓ : ℤ_[ℓ]) ^ e)))) (add_zero i) = 0
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Limits.cokernel.condition, Abelian.Ext.mk₀_zero,
        Abelian.Ext.comp_zero]
    haveI hMfin : Module.Finite ℤ_[ℓ] M := padic_fg_of_mod_ell_reps ℓ M hT hD

    have hcycM : ∀ m : M, ∃ a : ℤ_[ℓ], m = a • m₀ := by
      have hle : (⊤ : Submodule ℤ_[ℓ] M) ≤ Submodule.span ℤ_[ℓ] {m₀} := by
        apply Submodule.le_of_le_smul_of_le_jacobson_bot (I := IsLocalRing.maximalIdeal ℤ_[ℓ])
          Module.Finite.fg_top (IsLocalRing.maximalIdeal_le_jacobson ⊥)
        intro m _
        obtain ⟨k, m', hm⟩ := hdecomp m
        rw [hm]
        have h1 : k • m₀ ∈ Submodule.span ℤ_[ℓ] {m₀} := by
          rw [← Int.cast_smul_eq_zsmul ℤ_[ℓ] k m₀]
          exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self m₀)
        have h2 : (ℓ : ℤ_[ℓ]) • m' ∈ IsLocalRing.maximalIdeal ℤ_[ℓ] • (⊤ : Submodule ℤ_[ℓ] M) := by
          apply Submodule.smul_mem_smul
          · rw [PadicInt.maximalIdeal_eq_span_p]
            exact Ideal.mem_span_singleton_self _
          · exact Submodule.mem_top
        exact Submodule.mem_sup.mpr ⟨_, h1, _, h2, rfl⟩
      intro m
      obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp (hle Submodule.mem_top)
      exact ⟨a, ha.symm⟩

    let φ : M →+ V := (Abelian.Ext.mk₀ (wcIntToLadic Y ℓ)).postcomp
      (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) (add_zero i)
    have hφ : ∀ (a : ℤ_[ℓ]) (m : M), φ (a • m) = (a : ℚ_[ℓ]) • φ m := by
      intro a m
      change ((m.comp (Abelian.Ext.mk₀ (wcIntScalar Y ℓ a)) (add_zero i)).comp
          (Abelian.Ext.mk₀ (wcIntToLadic Y ℓ)) (add_zero i)) =
        (m.comp (Abelian.Ext.mk₀ (wcIntToLadic Y ℓ)) (add_zero i)).comp
          (Abelian.Ext.mk₀ (wcLadicScalar Y ℓ (a : ℚ_[ℓ]))) (add_zero i)
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
        Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, hscomm]
    have hcycV : ∀ x : V, ∃ c : ℚ_[ℓ], x = c • φ m₀ := by
      intro x
      obtain ⟨e, y, hy⟩ := hdeni x
      have hy' : (ℓ : ℚ_[ℓ]) ^ e • x = φ y := by
        rw [← Nat.cast_pow, Nat.cast_smul_eq_nsmul ℚ_[ℓ]]
        exact hy
      obtain ⟨a, rfl⟩ := hcycM y
      have hl : (ℓ : ℚ_[ℓ]) ^ e ≠ 0 :=
        pow_ne_zero _ (Nat.cast_ne_zero.mpr (Fact.out : Nat.Prime ℓ).ne_zero)
      refine ⟨((ℓ : ℚ_[ℓ]) ^ e)⁻¹ * (a : ℚ_[ℓ]), ?_⟩
      rw [mul_smul, ← hφ, ← hy', inv_smul_smul₀ hl]

    by_cases hv : φ m₀ = 0
    · refine ⟨0, fun x y _ => ?_, fun c x => by simp⟩
      obtain ⟨c, hc⟩ := hcycV x
      obtain ⟨c', hc'⟩ := hcycV y
      rw [hc, hc', hv, smul_zero, smul_zero]
    · have huniq : ∀ c c' : ℚ_[ℓ], c • φ m₀ = c' • φ m₀ → c = c' := by
        intro c c' hcc
        by_contra hne
        have h1 : (c - c') • φ m₀ = 0 := by rw [sub_smul, hcc, sub_self]
        apply hv
        rw [← inv_smul_smul₀ (sub_ne_zero.mpr hne) (φ m₀), h1, smul_zero]
      choose γ hγ using hcycV
      refine ⟨AddMonoidHom.mk' γ (fun x y => huniq _ _ (by
          rw [add_smul, ← hγ x, ← hγ y, ← hγ (x + y)])), fun x y hxy => ?_, fun c x => ?_⟩
      · have h' : γ x = γ y := hxy
        calc x = γ x • φ m₀ := hγ x
          _ = γ y • φ m₀ := by rw [h']
          _ = y := (hγ y).symm
      · show γ (c • x) = c * γ x
        exact huniq _ _ (by rw [mul_smul, ← hγ x, ← hγ (c • x)])



  obtain ⟨ηV, hVinj, hVlin⟩ := descent (2 * n) hG.1 hG.2 hsep hden
  obtain ⟨Θ, hΘ⟩ := wc_hm_ladic_bridge Y ℓ (2 * n)
  refine ⟨ηV.comp Θ.toAddMonoidHom, fun a b hab => Θ.injective (hVinj hab), fun c x => ?_⟩
  show ηV (Θ (wcHMScalar Y ℓ (2 * n) c x)) = c * ηV (Θ x)
  rw [hΘ, hVlin]

theorem wc_ac_open_zmod_top_vanish (K : Type u) [Field K] [IsAlgClosed K]
    {Y : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n : ℕ) [SmoothOfRelativeDimension n pY]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (VU : Y.ProEt) (hVUo : IsOpenImmersion VU.hom) (hne : Set.range VU.hom ≠ Set.univ)
    (m : ℕ) (x : Abelian.Ext (wcFreeSheaf Y VU) (wcZModSheaf Y (ℓ ^ m)) (2 * n)) :
    x = 0 :=
by
  classical

  have hdev : ∀ (W : Scheme.{u}) (p i : ℕ), p ≠ 0 → Subsingleton (wcEtCoh W p i) →
      ∀ k : ℕ, Subsingleton (wcEtCoh W (p ^ k) i) := by
    intro W p i hp hsp
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}) := HasExt.standard _
    have hsub : ∀ (X₀ : Sheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1})
        (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1})), S.ShortExact →
        ∀ m : ℕ, Subsingleton (Abelian.Ext X₀ S.X₁ m) → Subsingleton (Abelian.Ext X₀ S.X₃ m) →
          Subsingleton (Abelian.Ext X₀ S.X₂ m) := by
      intro X₀ S hS m h1 h3
      have hz : ∀ y : Abelian.Ext X₀ S.X₂ m, y = 0 := by
        intro y
        obtain ⟨y₁, hy₁⟩ := Abelian.Ext.covariant_sequence_exact₂ X₀ hS y (Subsingleton.elim _ _)
        rw [← hy₁, Subsingleton.elim y₁ 0, Abelian.Ext.zero_comp]
      exact ⟨fun a b => by rw [hz a, hz b]⟩
    have hzero : ∀ (X₀ Z : Sheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}),
        Limits.IsZero Z → ∀ m, Subsingleton (Abelian.Ext X₀ Z m) := by
      intro X₀ Z hZ m
      have hx : ∀ x : Abelian.Ext X₀ Z m, x = 0 := by
        intro x
        have := Abelian.Ext.comp_mk₀_id x
        rw [hZ.eq_of_tgt (𝟙 _) 0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero] at this
        exact this.symm
      exact ⟨fun x y => by rw [hx x, hx y]⟩
    have hses : ∀ (p k : ℕ), p ≠ 0 →
        ∃ (f : AddCommGrpCat.of (ULift.{u+1} (ZMod k)) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))))
          (g : AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod p)))
          (hw : f ≫ g = 0), (ShortComplex.mk f g hw).ShortExact := by
      intro p k hp
      have hk0 : (zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k))) (k : ℤ) = 0 := by
        rw [zmultiplesHom_apply, zsmul_eq_mul, Int.cast_natCast, ← Nat.cast_mul, mul_comm,
          ZMod.natCast_self]
      let α : ZMod k →+ ZMod (p * k) :=
        ZMod.lift k ⟨zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k)), hk0⟩
      have hα : ∀ z : ℤ, α (z : ZMod k) = ((z * p : ℤ) : ZMod (p * k)) := by
        intro z
        show (ZMod.lift k ⟨zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k)), hk0⟩) (z : ZMod k) = _
        rw [ZMod.lift_coe]
        change z • (p : ZMod (p * k)) = _
        rw [zsmul_eq_mul]
        push_cast
        ring
      let β : ZMod (p * k) →+ ZMod p := (ZMod.castHom (dvd_mul_right p k) (ZMod p)).toAddMonoidHom
      have hβ : ∀ z : ℤ, β (z : ZMod (p * k)) = (z : ZMod p) := fun z =>
        map_intCast (ZMod.castHom (dvd_mul_right p k) (ZMod p)) z
      have hαinj : Function.Injective α := by
        rw [injective_iff_map_eq_zero]
        intro x hx
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
        rw [hα, ZMod.intCast_zmod_eq_zero_iff_dvd] at hx
        rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
        have hp' : (p : ℤ) ≠ 0 := by exact_mod_cast hp
        push_cast at hx
        rw [mul_comm z] at hx
        exact (mul_dvd_mul_iff_left hp').mp hx
      have hβsurj : Function.Surjective β := by
        intro y
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
        exact ⟨(z : ZMod (p * k)), hβ z⟩
      have hβα : ∀ x, β (α x) = 0 := by
        intro x
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
        rw [hα, hβ]
        push_cast
        rw [ZMod.natCast_self, mul_zero]
      have hker : ∀ y, β y = 0 → ∃ x, α x = y := by
        intro y hy
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
        rw [hβ, ZMod.intCast_zmod_eq_zero_iff_dvd] at hy
        obtain ⟨t, rfl⟩ := hy
        refine ⟨(t : ZMod k), ?_⟩
        rw [hα]
        congr 1
        ring
      let f : AddCommGrpCat.of (ULift.{u+1} (ZMod k)) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) :=
        AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp α).comp
          AddEquiv.ulift.toAddMonoidHom)
      let g : AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod p)) :=
        AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp β).comp
          AddEquiv.ulift.toAddMonoidHom)
      have hw : f ≫ g = 0 := by
        ext x
        exact hβα x.down
      refine ⟨f, g, hw, ShortComplex.ShortExact.mk' ?_ ?_ ?_⟩
      · rw [ShortComplex.ab_exact_iff]
        intro x₂ hx₂
        obtain ⟨x₁, hx₁⟩ := hker x₂.down (congrArg ULift.down hx₂)
        exact ⟨ULift.up x₁, congrArg ULift.up hx₁⟩
      · rw [AddCommGrpCat.mono_iff_injective]
        intro a b hab
        exact ULift.ext _ _ (hαinj (congrArg ULift.down hab))
      · rw [AddCommGrpCat.epi_iff_surjective]
        intro y
        obtain ⟨x, hx⟩ := hβsurj y.down
        exact ⟨ULift.up x, congrArg ULift.up hx⟩
    haveI : Limits.PreservesFiniteLimits
        (constantSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}) :=
      Limits.comp_preservesFiniteLimits (Functor.const (Scheme.Etale W)ᵒᵖ)
        (presheafToSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1})
    intro k
    induction k with
    | zero =>
      rw [pow_zero]
      exact hzero _ _ (Functor.map_isZero _ (AddCommGrpCat.isZero_of_subsingleton _)) i
    | succ k ih =>
      obtain ⟨f, g, hw, hS₀⟩ := hses p (p ^ k) hp
      have hS := hS₀.map_of_exact (constantSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1})
      rw [pow_succ']
      exact hsub ((constantSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) _ hS i ih hsp

  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace pY
  haveI := hVUo
  haveI : CompactSpace VU.left := by
    have hqc : QuasiCompact (VU.hom : VU.left ⟶ Y) :=
      @instQuasiCompactOfIsLocallyNoetherianOfIsOpenImmersion Y VU.left _ VU.hom hVUo
    exact @QuasiCompact.compactSpace_of_compactSpace VU.left Y VU.hom hqc _
  haveI : IsSeparated (Limits.terminal.from VU.left) := by
    have e : Limits.terminal.from VU.left =
        VU.hom ≫ pY ≫ Limits.terminal.from (Spec (.of K)) :=
      Limits.terminal.hom_ext _ _
    rw [e]; infer_instance

  obtain ⟨E₁⟩ := wc_ext_free_slice_zmod Y VU (ℓ ^ m) (2 * n)

  obtain ⟨-, hcont⟩ := wc_etToProEt_flat_cont VU.left
  haveI := hcont
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology VU.left) AddCommGrpCat.{u+1}) := HasExt.standard _
  obtain ⟨E₀⟩ := wc_proet_etale_comparison_epsInv_qcsep VU.left
    ((constantSheaf (Scheme.smallEtaleTopology VU.left) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ m))))) (2 * n)
  let χ : (wcEpsInv VU.left).obj ((constantSheaf (Scheme.smallEtaleTopology VU.left)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ m))))) ≅
      wcZModSheaf VU.left (ℓ ^ m) :=
    (wc_epsInv_const VU.left (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ m))))).some ≪≫
      (wc_zmod_sheaf_const VU.left (ℓ ^ m)).some.symm
  have post : ∀ {A B B' : Sheaf (Scheme.ProEt.topology VU.left) AddCommGrpCat.{u+1}} (e : B ≅ B'),
      Nonempty (Abelian.Ext A B (2 * n) ≃ Abelian.Ext A B' (2 * n)) := by
    intro A B B' e
    refine ⟨{ toFun := fun y => y.comp (Abelian.Ext.mk₀ e.hom) (add_zero (2 * n))
              invFun := fun y => y.comp (Abelian.Ext.mk₀ e.inv) (add_zero (2 * n))
              left_inv := fun y => ?_
              right_inv := fun y => ?_ }⟩
    · simp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero (2 * n)) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    · simp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero (2 * n)) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
  obtain ⟨E₂⟩ := post (A := wcFreeSheaf VU.left (Scheme.ProEt.mk (𝟙 VU.left))) χ.symm

  have h1 := wc_et_open_top_vanishing K Y pY n VU.left VU.hom hne ℓ (Fact.out) hℓ
  haveI hn := hdev VU.left ℓ (2 * n) (Fact.out : ℓ.Prime).ne_zero h1 m

  let E : Abelian.Ext (wcFreeSheaf Y VU) (wcZModSheaf Y (ℓ ^ m)) (2 * n) ≃
      wcEtCoh VU.left (ℓ ^ m) (2 * n) := E₁.trans (E₂.trans E₀)
  apply E.injective
  exact Subsingleton.elim _ _

theorem wc_ac_int_supp_kernel_sections (K : Type u) [Field K] {Y : Scheme.{u}}
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (y₀ : Spec (.of K) ⟶ Y) (Dy : wcHMPullData y₀ ℓ) (hDy : wcHMPullCanonical Dy)
    (V : Y.ProEt) (f : (wcIntUnit Y ℓ).val.obj (Opposite.op V)) :
    (∃ k, ((Limits.kernel.ι (wcIntSuppπ Dy)).val.app (Opposite.op V)).hom k = f) ↔
      ∀ z : V.left, V.hom z = y₀ (IsLocalRing.closedPoint K) →
        (show C(↥V.left, ULift.{u+1} ℤ_[ℓ]) from f) z = 0 :=
by
  classical

  have s1 : ∀ {M N : SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)} (g : M ⟶ N)
      (W : (Y.ProEt)ᵒᵖ) (s : M.val.obj W),
      (∃ k, ((Limits.kernel.ι (Limits.factorThruImage g)).val.app W).hom k = s) ↔
        (g.val.app W).hom s = 0 := by
    intro M N g W s
    let G : SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ) ⥤
        ModuleCat.{u+1} ((wcIntRingSheaf Y ℓ).obj.obj W) :=
      SheafOfModules.forget _ ⋙ PresheafOfModules.evaluation _ W
    constructor
    · rintro ⟨k, rfl⟩
      have e : Limits.kernel.ι (Limits.factorThruImage g) ≫ g = 0 :=
        (congrArg (fun h => Limits.kernel.ι (Limits.factorThruImage g) ≫ h)
          (Limits.image.fac g)).symm.trans
          ((Limits.kernel.condition_assoc _ _).trans Limits.zero_comp)
      have e2 : G.map (Limits.kernel.ι (Limits.factorThruImage g)) ≫ G.map g = 0 := by
        rw [← G.map_comp, e, G.map_zero]
      have e3 := congrArg (fun h => h.hom k) e2
      simp only [ModuleCat.hom_comp, ModuleCat.hom_zero] at e3
      exact e3
    · intro hs
      have : Mono (G.map (Limits.image.ι g)) := Functor.map_mono G _
      have hinj := (ModuleCat.mono_iff_injective (G.map (Limits.image.ι g))).mp this
      have hfac : G.map (Limits.factorThruImage g) ≫ G.map (Limits.image.ι g) = G.map g := by
        rw [← G.map_comp, Limits.image.fac]
      have hπ : (G.map (Limits.factorThruImage g)).hom s = 0 := by
        apply hinj
        have h2 := congrArg (fun h => h.hom s) hfac
        simp only [ModuleCat.hom_comp] at h2
        refine h2.trans (hs.trans ?_)
        exact (map_zero _).symm
      let k' : ModuleCat.of ((wcIntRingSheaf Y ℓ).obj.obj W)
          ((wcIntRingSheaf Y ℓ).obj.obj W) ⟶ G.obj M :=
        ModuleCat.ofHom (LinearMap.toSpanSingleton _ _ s)
      have hk1 : k'.hom 1 = s := one_smul _ s
      have hk' : k' ≫ G.map (Limits.factorThruImage g) = 0 := by
        apply ModuleCat.hom_ext
        apply LinearMap.ext_ring
        show (G.map (Limits.factorThruImage g)).hom (k'.hom 1) = 0
        rw [hk1]
        exact hπ
      let hl := Limits.KernelFork.IsLimit.lift'
        (Limits.KernelFork.mapIsLimit _ (Limits.kernelIsKernel (Limits.factorThruImage g)) G) k' hk'
      refine ⟨hl.1.hom 1, ?_⟩
      have h3 := congrArg (fun h => h.hom (1 : (wcIntRingSheaf Y ℓ).obj.obj W)) hl.2
      exact h3.trans hk1

  have s3 : ∀ (g : V.left ⟶ Y) (φ : C(↥V.left, ULift.{u+1} ℤ_[ℓ]))
      (w : C(↥(Spec (.of K)), ULift.{u+1} ℚ_[ℓ])), IsUnit w →
      ((∀ p : ↥(Limits.pullback g y₀),
        ULift.up (((φ (Limits.pullback.fst g y₀ p)).down : ℤ_[ℓ]) : ℚ_[ℓ]) *
          w (Limits.pullback.snd g y₀ p) = 0) ↔
      ∀ z : ↥V.left, g z = y₀ (IsLocalRing.closedPoint K) → φ z = 0) := by
    intro g φ w hw
    obtain ⟨v, hv⟩ := hw.exists_right_inv
    have hne : ∀ q, w q ≠ 0 := by
      intro q h0
      have h1 := congrArg (fun G : C(↥(Spec (.of K)), ULift.{u+1} ℚ_[ℓ]) => G q) hv
      simp only [ContinuousMap.mul_apply, ContinuousMap.one_apply, h0, zero_mul] at h1
      exact zero_ne_one h1
    have hred : ∀ (a : ℤ_[ℓ]) (b : ULift.{u+1} ℚ_[ℓ]), b ≠ 0 →
        (ULift.up (a : ℚ_[ℓ]) * b = 0 ↔ ULift.up a = (0 : ULift.{u+1} ℤ_[ℓ])) := by
      intro a b hb
      rw [mul_eq_zero, or_iff_left hb]
      constructor
      · intro h
        exact ULift.ext _ _ (PadicInt.coe_eq_zero.mp (congrArg ULift.down h))
      · intro h
        have h' : a = 0 := congrArg ULift.down h
        rw [h']
        rfl
    constructor
    · intro H z hz
      have hz' : z ∈ Set.range (Limits.pullback.fst g y₀) := by
        rw [Scheme.Pullback.range_fst]
        exact ⟨_, hz.symm⟩
      obtain ⟨p, rfl⟩ := hz'
      exact (hred _ _ (hne _)).mp (H p)
    · intro H p
      have hp : g (Limits.pullback.fst g y₀ p) =
          y₀ (IsLocalRing.closedPoint K) := by
        rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply,
          Subsingleton.elim (Limits.pullback.snd g y₀ p) (IsLocalRing.closedPoint K)]
      exact (hred _ _ (hne _)).mpr (H _ hp)

  have hsec : ∀ {A B : Scheme.{u}} {i : A ⟶ B} (D : wcHMPullData i ℓ),
      ∃ u : C(↥A, ULift.{u+1} ℚ_[ℓ]), IsUnit u ∧ ∀ W : B.ProEt,
        ((SheafOfModules.unitHomEquiv _ (wcSuppUnitMap D)).1 (Opposite.op W) :
            C(↥(Limits.pullback W.hom i), ULift.{u+1} ℚ_[ℓ])) =
          u.comp (Limits.pullback.snd W.hom i).base.hom := by
    intro A B i D
    haveI := D.cont
    let T : B.ProEt := MorphismProperty.Over.mk ⊤ (𝟙 B) (inferInstance : WeaklyEtale (𝟙 B))
    let σ := SheafOfModules.unitHomEquiv (wcSuppObj D) (wcSuppUnitMap D)
    let v : C(↥(Limits.pullback (𝟙 B) i), ULift.{u+1} ℚ_[ℓ]) := σ.1 (Opposite.op T)
    let u : C(↥A, ULift.{u+1} ℚ_[ℓ]) := v.comp (inv (Limits.pullback.snd (𝟙 B) i)).base.hom
    have hfac : ∀ W : B.ProEt,
        (σ.1 (Opposite.op W) : C(↥(Limits.pullback W.hom i), ULift.{u+1} ℚ_[ℓ])) =
          u.comp (Limits.pullback.snd W.hom i).base.hom := by
      intro W
      let τ : W ⟶ T := MorphismProperty.Over.homMk (B := T) W.hom (Category.comp_id _) trivial
      have h1 : (v.comp ((wcProEtBC i).map τ).left.base.hom :
          C(↥(Limits.pullback W.hom i), ULift.{u+1} ℚ_[ℓ])) =
          (σ.1 (Opposite.op W) : C(↥(Limits.pullback W.hom i), ULift.{u+1} ℚ_[ℓ])) :=
        PresheafOfModules.sections_property σ τ.op
      have hw : ((wcProEtBC i).map τ).left ≫ Limits.pullback.snd (𝟙 B) i =
          Limits.pullback.snd W.hom i :=
        MorphismProperty.Over.w ((wcProEtBC i).map τ)
      have key : ((wcProEtBC i).map τ).left =
          Limits.pullback.snd W.hom i ≫ inv (Limits.pullback.snd (𝟙 B) i) :=
        (IsIso.eq_comp_inv (Limits.pullback.snd (𝟙 B) i)).mpr hw
      refine h1.symm.trans ?_
      apply ContinuousMap.ext
      intro p
      exact congrArg (fun f : Limits.pullback W.hom i ⟶ Limits.pullback (𝟙 B) i => v (f.base p)) key
    let ones : (wcSuppObj D).val.sections :=
      PresheafOfModules.sectionsMk (M := (wcSuppObj D).val)
        (fun W => (1 : C(↥(Limits.pullback W.unop.hom i), ULift.{u+1} ℚ_[ℓ])))
        (fun _ _ _ => rfl)
    let ρ₁ : SheafOfModules.unit (wcRingSheaf B ℓ) ⟶
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).obj
          (SheafOfModules.unit (wcRingSheaf A ℓ)) :=
      (SheafOfModules.unitHomEquiv (wcSuppObj D)).symm ones
    let c : SheafOfModules.unit (wcRingSheaf A ℓ) ⟶ SheafOfModules.unit (wcRingSheaf A ℓ) :=
      D.μ.inv ≫ (D.adj.homEquiv _ _).symm ρ₁
    have h2 : wcSuppUnitMap D = D.adj.homEquiv _ _ D.μ.hom :=
      (D.adj.homEquiv_unit _ _ _).symm
    have hc : wcSuppUnitMap D ≫
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).map c = ρ₁ := by
      rw [h2]
      refine (D.adj.homEquiv_naturality_right D.μ.hom c).symm.trans ?_
      have e3 : D.μ.hom ≫ c = (D.adj.homEquiv _ _).symm ρ₁ := Iso.hom_inv_id_assoc _ _
      rw [e3, Equiv.apply_symm_apply]
    let W : A.ProEt := (wcProEtBC i).obj T
    let h : C(↥(Limits.pullback (𝟙 B) i), ULift.{u+1} ℚ_[ℓ]) :=
      (c.val.app (Opposite.op W)).hom (1 : C(↥(Limits.pullback (𝟙 B) i), ULift.{u+1} ℚ_[ℓ]))
    have eR : (SheafOfModules.unitHomEquiv (wcSuppObj D) ρ₁).1 (Opposite.op T) =
        (1 : C(↥(Limits.pullback (𝟙 B) i), ULift.{u+1} ℚ_[ℓ])) := by
      show (SheafOfModules.unitHomEquiv (wcSuppObj D)
        ((SheafOfModules.unitHomEquiv (wcSuppObj D)).symm ones)).1 (Opposite.op T) = _
      rw [Equiv.apply_symm_apply]
      rfl
    have eL : (SheafOfModules.unitHomEquiv (wcSuppObj D) (wcSuppUnitMap D ≫
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).map c)).1
          (Opposite.op T) = (c.val.app (Opposite.op W)).hom v := rfl
    have eLin : (c.val.app (Opposite.op W)).hom v = v * h := by
      have hs := (c.val.app (Opposite.op W)).hom.map_smul
        (v : (wcRingSheaf A ℓ).obj.obj (Opposite.op W))
        (1 : C(↥(Limits.pullback (𝟙 B) i), ULift.{u+1} ℚ_[ℓ]))
      exact (congrArg (fun x => (c.val.app (Opposite.op W)).hom x) (mul_one v).symm).trans hs
    have hvh : v * h = 1 :=
      eLin.symm.trans (eL.symm.trans ((congrArg
        (fun f => (SheafOfModules.unitHomEquiv (wcSuppObj D) f).1 (Opposite.op T)) hc).trans eR))
    refine ⟨u, ?_, hfac⟩
    refine isUnit_iff_exists_inv.mpr
      ⟨h.comp (inv (Limits.pullback.snd (𝟙 B) i)).base.hom, ?_⟩
    show v.comp (inv (Limits.pullback.snd (𝟙 B) i)).base.hom *
      h.comp (inv (Limits.pullback.snd (𝟙 B) i)).base.hom = 1
    rw [← ContinuousMap.mul_comp, hvh, ContinuousMap.one_comp]

  obtain ⟨uu, huu, hsecV⟩ := hsec Dy
  let Φ := ((wcSuppUnitMap Dy).val.app (Opposite.op V)).hom
  have hΦ1 : (show C(↥(Limits.pullback V.hom y₀), ULift.{u+1} ℚ_[ℓ]) from
      Φ (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))) =
      uu.comp (Limits.pullback.snd V.hom y₀).base.hom :=
    (SheafOfModules.unitHomEquiv_apply_coe _ _ _).symm.trans (hsecV V)
  have hΦ : ∀ w : C(↥V.left, ULift.{u+1} ℚ_[ℓ]),
      (show C(↥(Limits.pullback V.hom y₀), ULift.{u+1} ℚ_[ℓ]) from Φ w) =
        w.comp (Limits.pullback.fst V.hom y₀).base.hom *
          uu.comp (Limits.pullback.snd V.hom y₀).base.hom := by
    intro w
    have hs := Φ.map_smul (w : (wcRingSheaf Y ℓ).obj.obj (Opposite.op V))
      (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))
    have e1 := (congrArg Φ (mul_one w).symm).trans hs
    refine e1.trans ?_
    show (show C(↥(Limits.pullback V.hom y₀), ULift.{u+1} ℚ_[ℓ]) from
        (Dy.φ.hom.app (Opposite.op V)).hom w) *
      (show C(↥(Limits.pullback V.hom y₀), ULift.{u+1} ℚ_[ℓ]) from
        Φ (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))) = _
    rw [hDy V w, hΦ1]
  let ψ := ((wcUnitRestrict (wcIntRatRingSheafMap Y ℓ)).val.app (Opposite.op V)).hom
  have hψ1 : (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from
      ψ (1 : C(↥V.left, ULift.{u+1} ℤ_[ℓ]))) = 1 := by
    have e : (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from (SheafOfModules.unitHomEquiv _
        (wcUnitRestrict (wcIntRatRingSheafMap Y ℓ))).1 (Opposite.op V)) = 1 := by
      unfold wcUnitRestrict
      rw [Equiv.apply_symm_apply]
      rfl
    exact (SheafOfModules.unitHomEquiv_apply_coe _ _ _).symm.trans e
  have hψ : (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from ψ f) =
      ((wcIntRatRingSheafMap Y ℓ).hom.app (Opposite.op V)).hom f := by
    have hs := ψ.map_smul (f : (wcIntRingSheaf Y ℓ).obj.obj (Opposite.op V))
      (1 : C(↥V.left, ULift.{u+1} ℤ_[ℓ]))
    have e1 := (congrArg ψ (mul_one (show C(↥V.left, ULift.{u+1} ℤ_[ℓ]) from f)).symm).trans hs
    refine e1.trans ?_
    show (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from
        ((wcIntRatRingSheafMap Y ℓ).hom.app (Opposite.op V)).hom f) *
      (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from ψ (1 : C(↥V.left, ULift.{u+1} ℤ_[ℓ]))) = _
    rw [hψ1, mul_one]
  have hgval : ∀ p : ↥(Limits.pullback V.hom y₀),
      (show C(↥(Limits.pullback V.hom y₀), ULift.{u+1} ℚ_[ℓ]) from
        ((wcIntSuppMap Dy).val.app (Opposite.op V)).hom f) p =
      ULift.up ((((show C(↥V.left, ULift.{u+1} ℤ_[ℓ]) from f)
          (Limits.pullback.fst V.hom y₀ p)).down : ℤ_[ℓ]) : ℚ_[ℓ]) *
        uu (Limits.pullback.snd V.hom y₀ p) := by
    intro p
    have e : (show C(↥(Limits.pullback V.hom y₀), ULift.{u+1} ℚ_[ℓ]) from
        ((wcIntSuppMap Dy).val.app (Opposite.op V)).hom f) =
        (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from
          ((wcIntRatRingSheafMap Y ℓ).hom.app (Opposite.op V)).hom f).comp
            (Limits.pullback.fst V.hom y₀).base.hom *
          uu.comp (Limits.pullback.snd V.hom y₀).base.hom := by
      refine (hΦ (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from ψ f)).trans ?_
      rw [hψ]
    rw [e]
    rfl
  have hzero : ((wcIntSuppMap Dy).val.app (Opposite.op V)).hom f = 0 ↔
      ∀ p : ↥(Limits.pullback V.hom y₀),
        ULift.up ((((show C(↥V.left, ULift.{u+1} ℤ_[ℓ]) from f)
            (Limits.pullback.fst V.hom y₀ p)).down : ℤ_[ℓ]) : ℚ_[ℓ]) *
          uu (Limits.pullback.snd V.hom y₀ p) = 0 := by
    show (show C(↥(Limits.pullback V.hom y₀), ULift.{u+1} ℚ_[ℓ]) from
        ((wcIntSuppMap Dy).val.app (Opposite.op V)).hom f) = 0 ↔ _
    rw [ContinuousMap.ext_iff]
    simp only [ContinuousMap.zero_apply, hgval]
  exact ((s1 (wcIntSuppMap Dy) (Opposite.op V) f).trans hzero).trans
    (s3 V.hom (show C(↥V.left, ULift.{u+1} ℤ_[ℓ]) from f) uu huu)

theorem wc_ac_int_open_part_divisible (K : Type u) [Field K] {Y : Scheme.{u}}
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (y₀ : Spec (.of K) ⟶ Y) (Dy : wcHMPullData y₀ ℓ)
    (hK : ∀ (V : Y.ProEt) (f : (wcIntUnit Y ℓ).val.obj (Opposite.op V)),
      (∃ k, ((Limits.kernel.ι (wcIntSuppπ Dy)).val.app (Opposite.op V)).hom k = f) ↔
        ∀ z : V.left, V.hom z = y₀ (IsLocalRing.closedPoint K) →
          (show C(↥V.left, ULift.{u+1} ℤ_[ℓ]) from f) z = 0)
    (VU : Y.ProEt) (hVUo : IsOpenImmersion VU.hom)
    (hVU : Set.range VU.hom = (Set.range y₀)ᶜ)
    (L : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1} ⥤
      SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ))
    (adj : L ⊣ SheafOfModules.toSheaf (wcIntRingSheaf Y ℓ))
    [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L] :
    ∃ j : L.obj (wcFreeSheaf Y VU) ⟶ Limits.kernel (wcIntSuppπ Dy),
      Mono j ∧ ∀ k : ℕ, IsIso ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel j)) :=
by
  classical

  have hEpi : ∀ (Jm : SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ))
      (j : Jm ⟶ Limits.kernel (wcIntSuppπ Dy))
      (hloc : ∀ (W : Y.ProEt) (a : W ⟶ VU)
          (f : (wcIntUnit Y ℓ).val.obj (Opposite.op W)),
        ∃ t : Jm.val.obj (Opposite.op W),
          ((Limits.kernel.ι (wcIntSuppπ Dy)).val.app (Opposite.op W)).hom
            ((j.val.app (Opposite.op W)).hom t) = f)
      (k : ℕ), Epi ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel j)) := by
    intro Jm j hloc k

    have s3 : ∀ n : ℕ, (∀ (W : Y.ProEt)
        (y : (Limits.kernel (wcIntSuppπ Dy)).val.obj (Opposite.op W)),
        ∃ (y' : (Limits.kernel (wcIntSuppπ Dy)).val.obj (Opposite.op W)) (Sv : Sieve W),
          Sv ∈ Scheme.ProEt.topology Y W ∧
          ∀ (W' : Y.ProEt) (e : W' ⟶ W), Sv.arrows e →
            ∃ t : Jm.val.obj (Opposite.op W'),
              (j.val.app (Opposite.op W')).hom t =
                ((Limits.kernel (wcIntSuppπ Dy)).val.map e.op).hom (y - n • y')) →
        Epi (n • 𝟙 (Limits.cokernel j)) := by
      intro n h
      have hnsmul : ∀ {A B : SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)} (f : A ⟶ B)
          (n : ℕ) (W : (Y.ProEt)ᵒᵖ) (x : A.val.obj W),
          ((n • f).val.app W).hom x = n • (f.val.app W).hom x := by
        intro A B f n W x
        induction n with
        | zero => rw [zero_nsmul, zero_nsmul]; rfl
        | succ n ih =>
          rw [succ_nsmul, succ_nsmul, SheafOfModules.add_val, PresheafOfModules.add_app,
            ModuleCat.hom_add, LinearMap.add_apply, ih]
      apply Preadditive.epi_of_cancel_zero
      intro T g hg
      rw [Preadditive.nsmul_comp, Category.id_comp] at hg
      have hng : ∀ (W : (Y.ProEt)ᵒᵖ) (q : (Limits.cokernel j).val.obj W),
          n • (g.val.app W).hom q = 0 := by
        intro W q
        rw [← hnsmul, hg]
        rfl
      set φ := Limits.cokernel.π j ≫ g with hφdef
      have hjφ : j ≫ φ = 0 := by rw [hφdef, Limits.cokernel.condition_assoc, Limits.zero_comp]
      have hsep := T.isSheaf.isSeparated
      have hφ : φ = 0 := by
        apply SheafOfModules.hom_ext
        apply PresheafOfModules.hom_ext
        intro Xo
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro y
        obtain ⟨y', Sv, hSv, hlift⟩ := h Xo.unop y
        have hd : (φ.val.app Xo).hom (y - n • y') = 0 := by
          apply hsep Xo.unop Sv hSv
          intro Y f hf
          obtain ⟨t, ht⟩ := hlift Y f hf
          change (T.val.map f.op).hom ((φ.val.app Xo).hom (y - n • y')) =
            (T.val.map f.op).hom 0
          rw [map_zero, ← PresheafOfModules.naturality_apply, ← ht]
          change ((j ≫ φ).val.app (Opposite.op Y)).hom t = 0
          rw [hjφ]
          rfl
        have hy' : (φ.val.app Xo).hom (n • y') = 0 := by
          rw [map_nsmul]
          exact hng Xo _
        have hyy : y = (y - n • y') + n • y' := by abel
        change (φ.val.app Xo).hom y = 0
        rw [hyy, map_add, hd, hy', add_zero]
      exact (cancel_epi (Limits.cokernel.π j)).1 (by rw [← hφdef, hφ, Limits.comp_zero])

    have inj : ∀ V : Y.ProEt,
        Function.Injective ((Limits.kernel.ι (wcIntSuppπ Dy)).val.app (Opposite.op V)).hom := by
      intro V
      haveI := adj.isRightAdjoint
      have h1 : Mono ((SheafOfModules.toSheaf (wcIntRingSheaf Y ℓ)).map
          (Limits.kernel.ι (wcIntSuppπ Dy))) := Functor.map_mono _ _
      have h2 : Mono ((sheafToPresheaf _ _).map ((SheafOfModules.toSheaf
          (wcIntRingSheaf Y ℓ)).map (Limits.kernel.ι (wcIntSuppπ Dy)))) :=
        Functor.map_mono _ _
      have h3 := (NatTrans.mono_iff_mono_app _).1 h2 (Opposite.op V)
      exact (AddCommGrpCat.mono_iff_injective _).1 h3

    have s1 : ∀ {Y : Type u} [TopologicalSpace Y] (f : C(Y, ULift.{u+1} ℤ_[ℓ])),
        ∃ (A : Set Y) (g : C(Y, ULift.{u+1} ℤ_[ℓ])), IsClopen A ∧
          (∀ z, (f z).down = 0 → z ∈ A) ∧ (∀ z, (f z).down = 0 → (g z).down = 0) ∧
          (∀ z ∈ A, (f z).down = (ℓ : ℤ_[ℓ]) ^ k * (g z).down) ∧
          (∀ z, z ∉ A → (g z).down = 0) := by
      intro Y _ f
      set r : ℝ := (ℓ : ℝ) ^ (-(k : ℤ)) with hr
      have hℓpos : (0 : ℝ) < ℓ := by exact_mod_cast (Fact.out : Nat.Prime ℓ).pos
      have hrpos : 0 < r := zpow_pos hℓpos _
      set B : Set ℤ_[ℓ] := Metric.closedBall 0 r with hB
      have hBc : IsClopen B := IsUltrametricDist.isClopen_closedBall 0 hrpos.ne'
      have hmemB : ∀ x : ℤ_[ℓ], x ∈ B ↔ x ∈ Ideal.span {(ℓ : ℤ_[ℓ]) ^ k} := by
        intro x
        rw [hB, mem_closedBall_zero_iff, hr]
        exact PadicInt.norm_le_pow_iff_mem_span_pow x k
      let D : ℤ_[ℓ] → ℤ_[ℓ] := fun x =>
        if h : x ∈ B then Classical.choose (Ideal.mem_span_singleton'.1 ((hmemB x).1 h)) else 0
      have hDspec : ∀ x ∈ B, D x * (ℓ : ℤ_[ℓ]) ^ k = x := by
        intro x hx
        simp only [D, dif_pos hx]
        exact Classical.choose_spec (Ideal.mem_span_singleton'.1 ((hmemB x).1 hx))
      have hDoff : ∀ x, x ∉ B → D x = 0 := by
        intro x hx
        simp only [D, dif_neg hx]
      have hℓk0 : ((ℓ : ℤ_[ℓ]) ^ k) ≠ 0 :=
        pow_ne_zero _ (Nat.cast_ne_zero.mpr (Fact.out : Nat.Prime ℓ).ne_zero)
      have hnormℓk : ‖((ℓ : ℤ_[ℓ]) ^ k)‖ = ((ℓ : ℝ) ^ k)⁻¹ := by
        rw [PadicInt.norm_p_pow, zpow_neg, zpow_natCast]
      have hLip : LipschitzOnWith ((ℓ : NNReal) ^ k) D B := by
        apply LipschitzOnWith.of_dist_le_mul
        intro x hx y hy
        rw [dist_eq_norm, dist_eq_norm]
        have e : x - y = (D x - D y) * (ℓ : ℤ_[ℓ]) ^ k := by
          rw [sub_mul, hDspec x hx, hDspec y hy]
        have e2 : ‖x - y‖ = ‖D x - D y‖ * ((ℓ : ℝ) ^ k)⁻¹ := by
          rw [e, norm_mul, hnormℓk]
        have hpk : (0 : ℝ) < (ℓ : ℝ) ^ k := pow_pos hℓpos k
        rw [e2, NNReal.coe_pow, NNReal.coe_natCast]
        rw [mul_comm ‖D x - D y‖, ← mul_assoc, mul_inv_cancel₀ hpk.ne', one_mul]
      have hDcont : Continuous D := by
        rw [continuous_iff_continuousAt]
        intro x
        by_cases hx : x ∈ B
        · exact hLip.continuousOn.continuousAt (hBc.isOpen.mem_nhds hx)
        · have hc : ContinuousOn D Bᶜ :=
            (continuousOn_const (c := (0 : ℤ_[ℓ]))).congr (fun z hz => hDoff z hz)
          exact hc.continuousAt (hBc.compl.isOpen.mem_nhds hx)
      have hD0 : D 0 = 0 := by
        have h0B : (0 : ℤ_[ℓ]) ∈ B := Metric.mem_closedBall_self hrpos.le
        have := hDspec 0 h0B
        exact (mul_eq_zero.mp this).resolve_right hℓk0
      set φ : Y → ℤ_[ℓ] := fun z => (f z).down with hφ
      have hφc : Continuous φ := continuous_uliftDown.comp f.continuous
      refine ⟨φ ⁻¹' B, ⟨fun z => ULift.up (D (φ z)),
        continuous_uliftUp.comp (hDcont.comp hφc)⟩, hBc.preimage hφc, ?_, ?_, ?_, ?_⟩
      · intro z hz
        show φ z ∈ B
        rw [show φ z = 0 from hz]
        exact Metric.mem_closedBall_self hrpos.le
      · intro z hz
        show D (φ z) = 0
        rw [show φ z = 0 from hz, hD0]
      · intro z hz
        show φ z = (ℓ : ℤ_[ℓ]) ^ k * D (φ z)
        rw [mul_comm, hDspec _ hz]
      · intro z hz
        exact hDoff _ hz

    have s2 : ∀ (W : Y.ProEt) (A : Set W.left), IsClopen A →
        ∃ Sv : Sieve W, Sv ∈ Scheme.ProEt.topology Y W ∧
          ∀ (W' : Y.ProEt) (e : W' ⟶ W), Sv.arrows e →
            Set.range e.left ⊆ A ∨ Set.range e.left ⊆ Aᶜ := by
      intro W A hA
      let O : ULift.{u+1} W.left → W.left.Opens := fun i =>
        if i.down ∈ A then ⟨A, hA.isOpen⟩ else ⟨Aᶜ, hA.compl.isOpen⟩
      have hOmem : ∀ i : ULift.{u+1} W.left, i.down ∈ O i := by
        intro i
        by_cases hi : i.down ∈ A
        · simp only [O, if_pos hi]; exact hi
        · simp only [O, if_neg hi]; exact hi
      have hOcases : ∀ i : ULift.{u+1} W.left,
          (O i : Set W.left) ⊆ A ∨ (O i : Set W.left) ⊆ Aᶜ := by
        intro i
        by_cases hi : i.down ∈ A
        · left; simp only [O, if_pos hi]; exact fun _ h => h
        · right; simp only [O, if_neg hi]; exact fun _ h => h
      haveI := W.prop
      let W' : ULift.{u+1} W.left → Y.ProEt := fun i =>
        Scheme.ProEt.mk ((O i).ι ≫ W.hom)
      let f : ∀ i, W' i ⟶ W := fun i => MorphismProperty.Over.homMk (O i).ι rfl trivial
      have hcov : ∀ x : ↥W.left, ∃ (i : ULift.{u+1} W.left) (y : ↥(O i).toScheme),
          (O i).ι y = x := fun x =>
        ⟨ULift.up x, ⟨x, hOmem (ULift.up x)⟩, Scheme.Opens.ι_apply _ _⟩
      let 𝒰 : Scheme.Cover (Scheme.precoverage @WeaklyEtale) W.left :=
        Scheme.Cover.mkOfCovers (P := @WeaklyEtale) (ULift.{u+1} W.left)
          (fun i => (O i).toScheme) (fun i => (O i).ι) hcov (fun i => inferInstance)
      have hqc : QuasiCompactCover 𝒰.toPreZeroHypercover :=
        @QuasiCompactCover.of_isOpenMap _ _ 𝒰 Scheme.instJointlySurjectivePrecoverage
          (fun i => (Scheme.Hom.isOpenEmbedding (O i).ι).isOpenMap)
      have hRb : Presieve.ofArrows (fun i : ULift.{u+1} W.left => (O i).toScheme)
          (fun i => (O i).ι) ∈ Scheme.proetalePrecoverage.coverings W.left :=
        Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover.mpr ⟨𝒰, hqc, rfl⟩
      have e := Presieve.map_ofArrows (F := Scheme.ProEt.forget Y ⋙
        Over.forget Y) (Y := W') f
      have hR' : Presieve.ofArrows W' f ∈ (Scheme.ProEt.precoverage Y).coverings W :=
        Precoverage.mem_comap_iff.mpr (e ▸ hRb)
      have hRJ : Sieve.generate (Presieve.ofArrows W' f) ∈ (Scheme.ProEt.topology Y) W :=
        Precoverage.generate_mem_toGrothendieck hR'
      refine ⟨Sieve.generate (Presieve.ofArrows W' f), hRJ, ?_⟩
      rintro T' _ ⟨Y', h', _, ⟨i⟩, rfl⟩
      have hsub : Set.range (h' ≫ f i).left ⊆ (O i : Set W.left) := by
        rintro _ ⟨z, rfl⟩
        have hr := Scheme.Opens.range_ι (O i)
        change (O i).ι (h'.left z) ∈ (O i : Set W.left)
        rw [← hr]
        exact ⟨_, rfl⟩
      rcases hOcases i with hc | hc
      · exact Or.inl (hsub.trans hc)
      · exact Or.inr (hsub.trans hc)

    apply s3
    intro W y
    set ιK := Limits.kernel.ι (wcIntSuppπ Dy) with hιK
    have hf0 := (hK W ((ιK.val.app (Opposite.op W)).hom y)).1 ⟨y, rfl⟩
    obtain ⟨A, g, hA, hzA, hzg, hAeq, hAc⟩ :=
      s1 (show C(↥W.left, ULift.{u+1} ℤ_[ℓ]) from (ιK.val.app (Opposite.op W)).hom y)
    obtain ⟨y', hy'⟩ := (hK W (show (wcIntUnit Y ℓ).val.obj (Opposite.op W) from g)).2
      (by
        intro z hz
        apply ULift.ext
        rw [ULift.zero_down]
        exact hzg z ((congrArg ULift.down (hf0 z hz)).trans ULift.zero_down))
    obtain ⟨Sv, hSv, hcases⟩ := s2 W A hA
    refine ⟨y', Sv, hSv, ?_⟩
    intro W' e he
    set w := ((Limits.kernel (wcIntSuppπ Dy)).val.map e.op).hom (y - (ℓ ^ k : ℕ) • y') with hw
    have key : ∀ z' : W'.left,
        ((show C(↥W'.left, ULift.{u+1} ℤ_[ℓ]) from (ιK.val.app (Opposite.op W')).hom w) z').down =
