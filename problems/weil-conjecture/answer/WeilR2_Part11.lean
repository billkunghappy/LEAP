    obtain ⟨αW, αZ, hr1, hr2, hαW⟩ := s3
    obtain ⟨αP, hr3, hfst⟩ := s4 (Γ(W, ⊤) ⧸ Ideal.span (Set.range h)) _ αZ (iW ≫ fW) hr2 hP hz0q
    have po1 := s1 (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span (Set.range h))))
