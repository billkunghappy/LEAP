theorem wc_int_rho_act (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (E : wcIntRatData S ℓ)
    (hE : E.adj.homEquiv _ _ E.μ.hom = wcUnitRestrict (wcIntRatRingSheafMap S ℓ)) (q : ℕ) :
    (∀ (c : ℤ_[ℓ]) (y : wcIntExt S ℓ q),
      wcIntRho E q (wcIntAct S ℓ q (ContinuousMap.const _ (ULift.up c)) y) =
        wcHMScalar S ℓ q (c : ℚ_[ℓ]) (wcIntRho E q y)) ∧
    ∀ (r : C(↥S, ULift.{u+1} ℤ_[ℓ])) (r' : C(↥S, ULift.{u+1} ℚ_[ℓ])),
      (∀ t, (r' t).down = ((r t).down : ℚ_[ℓ])) → ∀ z : wcIntExt S ℓ q,
      letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
      wcIntRho E q (wcIntAct S ℓ q r z) =
        (Abelian.Ext.mk₀ (wcHMFun S ℓ r')).comp (wcIntRho E q z) (zero_add q) :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
  haveI := E.additive
  haveI := E.presLim
  haveI := E.presColim

  have s2 : ∀ (f : SheafOfModules.unit (wcIntRingSheaf S ℓ) ⟶ SheafOfModules.unit (wcIntRingSheaf S ℓ))
