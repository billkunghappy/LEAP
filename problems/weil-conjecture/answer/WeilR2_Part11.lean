    obtain ⟨D', hD'⟩ := wc_hm_pull_data_exists (((wcProEtBC g).obj W').hom ≫ prO) ℓ
    choose Dk hDk using fun k : ℕ =>
      wc_zmod_pull_data_exists (((wcProEtBC g).obj W').hom ≫ prO) (ℓ ^ k)
