        (Abelian.Ext.mk₀ (E.μ.inv ≫ E.L.map f ≫ E.μ.hom)).comp (wcIntRho E q y) (zero_add q) := by
    intro f y
    show (Abelian.Ext.mk₀ E.μ.inv).comp ((Abelian.Ext.mapExactFunctor E.L
        ((Abelian.Ext.mk₀ f).comp y (zero_add q))).comp (Abelian.Ext.mk₀ E.μ.hom) (add_zero q))
        (zero_add q) =
