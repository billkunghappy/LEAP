theorem wc_mv_ladder_five_iff : ∀ {HZ HA HB HC HZ' HA' HB' HC' : ℕ → Type*} [∀ j, AddCommGroup (HZ j)] [∀ j, AddCommGroup (HA j)] [∀ j, AddCommGroup (HB j)] [∀ j, AddCommGroup (HC j)] [∀ j, AddCommGroup (HZ' j)] [∀ j, AddCommGroup (HA' j)] [∀ j, AddCommGroup (HB' j)] [∀ j, AddCommGroup (HC' j)] (rA : ∀ j, HZ j →+ HA j) (rB : ∀ j, HZ j →+ HB j) (sA : ∀ j, HA j →+ HC j) (sB : ∀ j, HB j →+ HC j) (d : ∀ j, HC j →+ HZ (j + 1)) (rA' : ∀ j, HZ' j →+ HA' j) (rB' : ∀ j, HZ' j →+ HB' j) (sA' : ∀ j, HA' j →+ HC' j) (sB' : ∀ j, HB' j →+ HC' j) (d' : ∀ j, HC' j →+ HZ' (j + 1)) (φZ : ∀ j, HZ j →+ HZ' j) (φA : ∀ j, HA j →+ HA' j) (φB : ∀ j, HB j →+ HB' j) (φC : ∀ j, HC j →+ HC' j), (∀ z : HZ 0, rA 0 z = 0 → rB 0 z = 0 → z = 0) → (∀ j (z : HZ j), sA j (rA j z) = sB j (rB j z)) → (∀ j (a : HA j) (b : HB j), sA j a = sB j b → ∃ z : HZ j, rA j z = a ∧ rB j z = b) → (∀ j (a : HA j), d j (sA j a) = 0) → (∀ j (b : HB j), d j (sB j b) = 0) → (∀ j (γ : HC j), d j γ = 0 → ∃ (a : HA j) (b : HB j), γ = sA j a - sB j b) → (∀ j (γ : HC j), rA (j + 1) (d j γ) = 0) → (∀ j (γ : HC j), rB (j + 1) (d j γ) = 0) → (∀ j (α : HZ (j + 1)), rA (j + 1) α = 0 → rB (j + 1) α = 0 → ∃ γ : HC j, d j γ = α) → (∀ z : HZ' 0, rA' 0 z = 0 → rB' 0 z = 0 → z = 0) → (∀ j (z : HZ' j), sA' j (rA' j z) = sB' j (rB' j z)) → (∀ j (a : HA' j) (b : HB' j), sA' j a = sB' j b → ∃ z : HZ' j, rA' j z = a ∧ rB' j z = b) → (∀ j (a : HA' j), d' j (sA' j a) = 0) → (∀ j (b : HB' j), d' j (sB' j b) = 0) → (∀ j (γ : HC' j), d' j γ = 0 → ∃ (a : HA' j) (b : HB' j), γ = sA' j a - sB' j b) → (∀ j (γ : HC' j), rA' (j + 1) (d' j γ) = 0) → (∀ j (γ : HC' j), rB' (j + 1) (d' j γ) = 0) → (∀ j (α : HZ' (j + 1)), rA' (j + 1) α = 0 → rB' (j + 1) α = 0 → ∃ γ : HC' j, d' j γ = α) → (∀ j (z : HZ j), φA j (rA j z) = rA' j (φZ j z)) → (∀ j (z : HZ j), φB j (rB j z) = rB' j (φZ j z)) → (∀ j (a : HA j), φC j (sA j a) = sA' j (φA j a)) → (∀ j (b : HB j), φC j (sB j b) = sB' j (φB j b)) → (∀ j (γ : HC j), φZ (j + 1) (d j γ) = d' j (φC j γ)) → (∀ j, Function.Bijective (φA j)) → (∀ j, Function.Bijective (φB j)) → ((∀ j, Function.Bijective (φC j)) ↔ (∀ j, Function.Bijective (φZ j))) :=
by
  intro HZ HA HB HC HZ' HA' HB' HC' _ _ _ _ _ _ _ _ rA rB sA sB d rA' rB' sA' sB' d' φZ φA φB φC
    R0 R2 R3 R4 R5 R6 R7 R8 R9 R0' R2' R3' R4' R5' R6' R7' R8' R9' Q1 Q2 Q3 Q4 Q5 hA hB
  constructor
  · intro hC j
    constructor
    · rw [injective_iff_map_eq_zero]
      intro z hz
      have ha : rA j z = 0 := by
        apply (hA j).1
        rw [Q1, hz, map_zero, map_zero]
      have hb : rB j z = 0 := by
        apply (hB j).1
        rw [Q2, hz, map_zero, map_zero]
      rcases j with _ | k
      · exact R0 z ha hb
      · obtain ⟨γ, rfl⟩ := R9 k z ha hb
        have h1 : d' k (φC k γ) = 0 := by rw [← Q5]; exact hz
        obtain ⟨a', b', hab⟩ := R6' k _ h1
        obtain ⟨a, rfl⟩ := (hA k).2 a'
        obtain ⟨b, rfl⟩ := (hB k).2 b'
        have h2 : γ = sA k a - sB k b := by
          apply (hC k).1
          rw [hab, map_sub, Q3, Q4]
        rw [h2, map_sub, R4, R5, sub_zero]
    · intro z'
      obtain ⟨a, ha⟩ := (hA j).2 (rA' j z')
      obtain ⟨b, hb⟩ := (hB j).2 (rB' j z')
      have hs : sA j a = sB j b := by
        apply (hC j).1
        rw [Q3, Q4, ha, hb, R2']
      obtain ⟨z, hza, hzb⟩ := R3 j a b hs
      have hwa : rA' j (z' - φZ j z) = 0 := by
        rw [map_sub, ← Q1, hza, ha, sub_self]
      have hwb : rB' j (z' - φZ j z) = 0 := by
        rw [map_sub, ← Q2, hzb, hb, sub_self]
      rcases j with _ | k
      · refine ⟨z, ?_⟩
        have h0 := R0' _ hwa hwb
        rw [sub_eq_zero] at h0
        exact h0.symm
      · obtain ⟨γ', hγ'⟩ := R9' k _ hwa hwb
        obtain ⟨γ, rfl⟩ := (hC k).2 γ'
        refine ⟨z + d k γ, ?_⟩
        rw [map_add, Q5, hγ']
        abel
  · intro hZ j
    constructor
    · rw [injective_iff_map_eq_zero]
      intro γ hγ
      have hd : d j γ = 0 := by
        apply (hZ (j + 1)).1
        rw [Q5, hγ, map_zero, map_zero]
      obtain ⟨a, b, rfl⟩ := R6 j γ hd
      have h1 : sA' j (φA j a) = sB' j (φB j b) := by
        have h' := hγ
        rw [map_sub, Q3, Q4, sub_eq_zero] at h'
        exact h'
      obtain ⟨z', hza, hzb⟩ := R3' j _ _ h1
      obtain ⟨z, rfl⟩ := (hZ j).2 z'
      have ha : rA j z = a := (hA j).1 (by rw [Q1, hza])
      have hb : rB j z = b := (hB j).1 (by rw [Q2, hzb])
      rw [← ha, ← hb, R2, sub_self]
    · intro γ'
      obtain ⟨α, hα⟩ := (hZ (j + 1)).2 (d' j γ')
      have ha : rA (j + 1) α = 0 := (hA (j + 1)).1 (by rw [Q1, hα, R7', map_zero])
      have hb : rB (j + 1) α = 0 := (hB (j + 1)).1 (by rw [Q2, hα, R8', map_zero])
      obtain ⟨γ, rfl⟩ := R9 j α ha hb
      have h1 : d' j (γ' - φC j γ) = 0 := by
        rw [map_sub, ← Q5, hα, sub_self]
      obtain ⟨a', b', hab⟩ := R6' j _ h1
      obtain ⟨a, rfl⟩ := (hA j).2 a'
      obtain ⟨b, rfl⟩ := (hB j).2 b'
      refine ⟨γ + sA j a - sB j b, ?_⟩
      rw [sub_eq_iff_eq_add] at hab
      rw [map_sub, map_add, Q3, Q4, hab]
      abel

theorem wc_et_pull_data_indep : ∀ {S S' : Scheme.{u}} {n : ℕ} (g : S' ⟶ S) (D₁ D₂ : wcEtPullData g n) (i : ℕ) (x : wcEtZModExt S n i), wcEtPull D₁ i x = wcEtPull D₂ i x :=
by
  intro S S' n g D₁ D₂ i x
  obtain ⟨Did⟩ := wc_et_zmod_pull_data_exists (𝟙 S') n
  have pid : ∀ y : wcEtZModExt S' n i, wcEtPull Did i y = y := by
    intro y
    have h1 := wc_et_pull_comp (𝟙 S') (𝟙 S') (𝟙 S') (Category.id_comp _) Did Did Did i y
    have h2 : wcEtPull Did i (wcEtPull Did i y - y) = 0 := by
      rw [map_sub, ← h1, sub_self]
    exact sub_eq_zero.mp (wc_et_pull_id_injective Did i _ h2)
  have h := wc_et_pull_comp g (𝟙 S') g (Category.id_comp g) D₁ Did D₂ i x
  rw [pid (wcEtPull D₁ i x)] at h
  exact h.symm

