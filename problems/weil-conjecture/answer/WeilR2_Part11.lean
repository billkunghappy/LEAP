    rw [Category.assoc] at key
    exact key

theorem wc_et_closed_rightAdj_cycle_class : ∀ {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (D : wcEtPullData i ℓ) (R : SheafOfModules.{u+1} (wcEtZModRing Y ℓ) ⥤ SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) [R.Additive] (adj : @SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ ⊣ R) (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing Y ℓ))) (q : ℕ) (DW : ∀ W : Y.Etale, wcEtPullData (Limits.pullback.fst W.hom i) ℓ), letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _; ∃ cl : ∀ W : Y.Etale, (R.obj (I.cocomplex.X q)).val.obj (Opposite.op ((wcEtBaseChange i).obj W)) → wcEtSuppExt (DW W) q, (∀ (W : Y.Etale) (x : (R.obj (I.cocomplex.X q)).val.obj (Opposite.op ((wcEtBaseChange i).obj W))) (k : ℕ), ((R.map (I.cocomplex.d q (q + 1))).val.app (Opposite.op ((wcEtBaseChange i).obj W))).hom x = 0 → cl W (k • x) = k • cl W x) ∧ (∀ (W : Y.Etale) (x y : (R.obj (I.cocomplex.X q)).val.obj (Opposite.op ((wcEtBaseChange i).obj W))), ((R.map (I.cocomplex.d q (q + 1))).val.app (Opposite.op ((wcEtBaseChange i).obj W))).hom x = 0 → ((R.map (I.cocomplex.d q (q + 1))).val.app (Opposite.op ((wcEtBaseChange i).obj W))).hom y = 0 → cl W x = cl W y → ∃ e : (R.obj (I.cocomplex.X ((ComplexShape.up ℕ).prev q))).val.obj (Opposite.op ((wcEtBaseChange i).obj W)), ((R.map (I.cocomplex.d ((ComplexShape.up ℕ).prev q) q)).val.app (Opposite.op ((wcEtBaseChange i).obj W))).hom e = x - y) ∧ (∀ (W W₂ : Y.Etale) (h : W₂ ⟶ W) (Eh : wcEtPullData h.left ℓ) (γ : wcEtSuppObj (DW W₂) ⟶ Eh.Φ.obj (wcEtSuppObj (DW W))), wcEtSuppUnitMap (DW W₂) ≫ γ = Eh.μ.inv ≫ Eh.Φ.map (wcEtSuppUnitMap (DW W)) → ∀ x : (R.obj (I.cocomplex.X q)).val.obj (Opposite.op ((wcEtBaseChange i).obj W)), ((R.map (I.cocomplex.d q (q + 1))).val.app (Opposite.op ((wcEtBaseChange i).obj W))).hom x = 0 → wcEtSuppRestr (DW W) Eh (DW W₂) γ q (cl W x) = cl W₂ (((R.obj (I.cocomplex.X q)).val.map ((wcEtBaseChange i).map h).op).hom x)) ∧ (∀ (W : Y.Etale) (EW : wcEtPullData W.hom ℓ) (γ : wcEtSuppObj (DW W) ⟶ EW.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap (DW W) ≫ γ = EW.μ.inv ≫ EW.Φ.map (wcEtSuppUnitMap D) → ∀ (c : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ).obj (SheafOfModules.unit (wcEtZModRing Z ℓ)) ⟶ I.cocomplex.X q) (hc : c ≫ I.cocomplex.d q (q + 1) = 0), cl W (((adj.homEquiv (SheafOfModules.unit (wcEtZModRing Z ℓ)) (I.cocomplex.X q) c).val.app (Opposite.op ((wcEtBaseChange i).obj W))).hom (1 : (wcEtZModRing Z ℓ).obj.obj (Opposite.op ((wcEtBaseChange i).obj W)))) = wcEtSuppRestr D EW (DW W) γ q (I.extMk c (q + 1) rfl hc)) :=
by
  intro Y Z i _ ℓ _ D R _ adj I q DW
  classical
  letI hExt : ∀ (S : Scheme.{u}), HasExt (SheafOfModules.{u+1} (wcEtZModRing S ℓ)) :=
    fun S => HasExt.standard _
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) :=
    sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology Y) (wcEtZModRing Y ℓ)
  obtain ⟨EW⟩ : Nonempty (∀ W : Y.Etale, wcEtPullData W.hom ℓ) :=
    ⟨fun W => (wc_et_zmod_pull_data_exists W.hom ℓ).some⟩
  haveI hEa : ∀ W : Y.Etale, (EW W).Φ.Additive := fun W => (EW W).additive
  haveI hEl : ∀ W : Y.Etale, Limits.PreservesFiniteLimits (EW W).Φ := fun W => (EW W).presLim
  haveI hEc : ∀ W : Y.Etale, Limits.PreservesFiniteColimits (EW W).Φ := fun W => (EW W).presColim
  obtain ⟨A, a, ε, Hnat, Hadd, Hbij, H4, H3⟩ :=
    wc_et_closed_rightAdj_supp_hom_dict i ℓ D R adj DW EW

  let aH : ∀ (W : Y.Etale) (M : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)),
      (A W ⟶ M) →+ (R.obj M).val.obj (Opposite.op ((wcEtBaseChange i).obj W)) :=
    fun W M => AddMonoidHom.mk' (a W M) (Hadd W M)
  have ha0 : ∀ (W : Y.Etale) (M : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)), a W M 0 = 0 := by
    intro W M
    have h := map_zero (aH W M)
    simpa [aH] using h
  have hsub : ∀ (W : Y.Etale) (M : SheafOfModules.{u+1} (wcEtZModRing Y ℓ))
      (x y : (R.obj M).val.obj (Opposite.op ((wcEtBaseChange i).obj W))),
      (a W M).symm (x - y) = (a W M).symm x - (a W M).symm y := by
    intro W M x y
    apply (a W M).injective
    have h := map_sub (aH W M) ((a W M).symm x) ((a W M).symm y)
    simp only [aH, AddMonoidHom.mk'_apply, Equiv.apply_symm_apply] at h
    rw [Equiv.apply_symm_apply, h]
  have hnsmul : ∀ (W : Y.Etale) (M : SheafOfModules.{u+1} (wcEtZModRing Y ℓ))
      (x : (R.obj M).val.obj (Opposite.op ((wcEtBaseChange i).obj W))) (k : ℕ),
      (a W M).symm (k • x) = k • (a W M).symm x := by
    intro W M x k
    apply (a W M).injective
    have h := map_nsmul (aH W M) k ((a W M).symm x)
    simp only [aH, AddMonoidHom.mk'_apply, Equiv.apply_symm_apply] at h
    rw [Equiv.apply_symm_apply, h]

  have hcyc : ∀ (W : Y.Etale)
      (x : (R.obj (I.cocomplex.X q)).val.obj (Opposite.op ((wcEtBaseChange i).obj W))),
      ((R.map (I.cocomplex.d q (q + 1))).val.app (Opposite.op ((wcEtBaseChange i).obj W))).hom x = 0 →
      (a W (I.cocomplex.X q)).symm x ≫ I.cocomplex.d q (q + 1) = 0 := by
    intro W x hx
    apply (a W _).injective
    rw [Hnat, Equiv.apply_symm_apply, hx, ha0]

  have hextcongr : ∀ {P : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)} (f g : P ⟶ I.cocomplex.X q)
      (hf : f ≫ I.cocomplex.d q (q + 1) = 0) (hg : g ≫ I.cocomplex.d q (q + 1) = 0),
      f = g → I.extMk f (q + 1) rfl hf = I.extMk g (q + 1) rfl hg := by
    intro P f g hf hg hfg
    subst hfg
    rfl
  have hext_add : ∀ {P : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)} (f g : P ⟶ I.cocomplex.X q)
      (hf : f ≫ I.cocomplex.d q (q + 1) = 0) (hg : g ≫ I.cocomplex.d q (q + 1) = 0)
      (hfg : (f + g) ≫ I.cocomplex.d q (q + 1) = 0),
      I.extMk (f + g) (q + 1) rfl hfg = I.extMk f (q + 1) rfl hf + I.extMk g (q + 1) rfl hg :=
    fun f g hf hg _ => (I.add_extMk f g (q + 1) rfl hf hg).symm
  have hext_nsmul : ∀ {P : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)} (f : P ⟶ I.cocomplex.X q)
      (hf : f ≫ I.cocomplex.d q (q + 1) = 0) (k : ℕ)
      (hk : (k • f) ≫ I.cocomplex.d q (q + 1) = 0),
      I.extMk (k • f) (q + 1) rfl hk = k • I.extMk f (q + 1) rfl hf := by
    intro P f hf k
    induction k with
    | zero =>
      intro hk
      rw [hextcongr (0 • f) 0 hk Limits.zero_comp (zero_smul ℕ f),
        InjectiveResolution.extMk_zero, zero_smul]
    | succ k ih =>
      intro hk
      have hk' : (k • f) ≫ I.cocomplex.d q (q + 1) = 0 := by
        rw [Preadditive.nsmul_comp, hf, smul_zero]
      rw [hextcongr ((k + 1) • f) (k • f + f) hk
          (by rw [Preadditive.add_comp, hk', hf, add_zero]) (succ_nsmul f k),
        hext_add _ _ hk' hf, ih hk', succ_nsmul]
  have hext_sub : ∀ {P : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)} (f g : P ⟶ I.cocomplex.X q)
      (hf : f ≫ I.cocomplex.d q (q + 1) = 0) (hg : g ≫ I.cocomplex.d q (q + 1) = 0)
      (hfg : (f - g) ≫ I.cocomplex.d q (q + 1) = 0),
      I.extMk (f - g) (q + 1) rfl hfg = I.extMk f (q + 1) rfl hf - I.extMk g (q + 1) rfl hg := by
    intro P f g hf hg hfg
    have h := I.add_extMk g (f - g) (q + 1) rfl hg hfg
    rw [hextcongr (g + (f - g)) f
      (by rw [Preadditive.add_comp, Preadditive.sub_comp, hf, hg, sub_zero, add_zero]) hf
      (by abel)] at h
    exact eq_sub_of_add_eq' h

  let Θ : ∀ (W : Y.Etale), Abelian.Ext (A W) (SheafOfModules.unit (wcEtZModRing Y ℓ)) q →
      wcEtSuppExt (DW W) q := fun W β =>
    (Abelian.Ext.mk₀ (ε W)).comp ((Abelian.Ext.mapExactFunctor (EW W).Φ β).comp
      (Abelian.Ext.mk₀ (EW W).μ.hom) (add_zero q)) (zero_add q)
  have hΘadd : ∀ (W : Y.Etale) (β₁ β₂ : Abelian.Ext (A W) (SheafOfModules.unit (wcEtZModRing Y ℓ)) q),
      Θ W (β₁ + β₂) = Θ W β₁ + Θ W β₂ := by
    intro W β₁ β₂
    simp only [Θ, Abelian.Ext.mapExactFunctor_add, Abelian.Ext.add_comp, Abelian.Ext.comp_add]
  have hΘzero : ∀ (W : Y.Etale), Θ W 0 = 0 := by
    intro W
    simp only [Θ, Abelian.Ext.mapExactFunctor_zero, Abelian.Ext.zero_comp, Abelian.Ext.comp_zero]
  have hΘnsmul : ∀ (W : Y.Etale) (β : Abelian.Ext (A W) (SheafOfModules.unit (wcEtZModRing Y ℓ)) q)
      (k : ℕ), Θ W (k • β) = k • Θ W β := by
    intro W β k
    induction k with
    | zero => rw [zero_nsmul, zero_nsmul, hΘzero]
    | succ k ih => rw [succ_nsmul, hΘadd, ih, succ_nsmul]
  have hΘmk : ∀ (W : Y.Etale) {M : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)} (p : A W ⟶ M)
      (β : Abelian.Ext M (SheafOfModules.unit (wcEtZModRing Y ℓ)) q),
      Θ W ((Abelian.Ext.mk₀ p).comp β (zero_add q)) =
        (Abelian.Ext.mk₀ (ε W ≫ (EW W).Φ.map p)).comp
          ((Abelian.Ext.mapExactFunctor (EW W).Φ β).comp (Abelian.Ext.mk₀ (EW W).μ.hom)
            (add_zero q)) (zero_add q) := by
    intro W M p β
    simp only [Θ]
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀_assoc]

  have hinjΦ : ∀ (W : Y.Etale) (J : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)),
      Injective J → Injective ((EW W).Φ.obj J) := by
    intro W J hJ
    haveI := (wc_et_slice_continuous W).1
    haveI := (wc_et_slice_continuous W).2
    obtain ⟨ψ, ⟨θ⟩⟩ := wc_et_etale_pull_restrict_iso W ℓ (EW W)
    have hJ' := wc_et_slice_module_restrict_injective W ℓ ψ J hJ
    exact Injective.of_iso (θ.app J).symm hJ'

  have hΘinj : ∀ (W : Y.Etale), Function.Injective (Θ W) := by
    intro W β₁ β₂ h
    haveI : EnoughInjectives (SheafOfModules.{u+1}
        (wcEtZModRing ((Functor.fromPUnit Y).obj W.right) ℓ)) :=
      sheafOfModules_enoughInjectives _ _
    have hinj := (ext_transfer_of_corep (EW W).Φ (A W) (wcEtSuppObj (DW W)) (ε W) (Hbij W)
      (by
        intro J hJ m x
        have hJ' : Injective ((EW W).Φ.obj J) := hinjΦ W J hJ
        exact @Abelian.Ext.eq_zero_of_injective _ _ _ _ _ _ _ hJ' x)
      (SheafOfModules.unit (wcEtZModRing Y ℓ)) q).1
    apply hinj
    have e : ∀ β : Abelian.Ext (A W) (SheafOfModules.unit (wcEtZModRing Y ℓ)) q,
        (Abelian.Ext.mk₀ (ε W)).comp (Abelian.Ext.mapExactFunctor (EW W).Φ β) (zero_add q) =
        (Θ W β).comp (Abelian.Ext.mk₀ (EW W).μ.inv) (add_zero q) := by
      intro β
      simp only [Θ]
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.comp_assoc_of_third_deg_zero,
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    change (Abelian.Ext.mk₀ (ε W)).comp (Abelian.Ext.mapExactFunctor (EW W).Φ β₁) (zero_add q) =
      (Abelian.Ext.mk₀ (ε W)).comp (Abelian.Ext.mapExactFunctor (EW W).Φ β₂) (zero_add q)
    rw [e, e, h]

  let cl : ∀ W : Y.Etale, (R.obj (I.cocomplex.X q)).val.obj (Opposite.op ((wcEtBaseChange i).obj W)) →
      wcEtSuppExt (DW W) q := fun W x =>
    if hx : ((R.map (I.cocomplex.d q (q + 1))).val.app
        (Opposite.op ((wcEtBaseChange i).obj W))).hom x = 0 then
      Θ W (I.extMk ((a W (I.cocomplex.X q)).symm x) (q + 1) rfl (hcyc W x hx)) else 0
  have hcl : ∀ (W : Y.Etale)
      (x : (R.obj (I.cocomplex.X q)).val.obj (Opposite.op ((wcEtBaseChange i).obj W)))
      (hx : ((R.map (I.cocomplex.d q (q + 1))).val.app
        (Opposite.op ((wcEtBaseChange i).obj W))).hom x = 0),
      cl W x = Θ W (I.extMk ((a W (I.cocomplex.X q)).symm x) (q + 1) rfl (hcyc W x hx)) :=
    fun W x hx => dif_pos hx
  refine ⟨cl, ?_, ?_, ?_, ?_⟩
  ·
    intro W x k hx
    have hkx : ((R.map (I.cocomplex.d q (q + 1))).val.app
        (Opposite.op ((wcEtBaseChange i).obj W))).hom (k • x) = 0 := by
      rw [map_nsmul, hx, smul_zero]
    rw [hcl W _ hkx, hcl W x hx]
    have hf : (k • (a W (I.cocomplex.X q)).symm x) ≫ I.cocomplex.d q (q + 1) = 0 := by
      rw [Preadditive.nsmul_comp, hcyc W x hx, smul_zero]
    rw [hextcongr _ _ (hcyc W _ hkx) hf (hnsmul W _ x k),
      hext_nsmul _ (hcyc W x hx) k hf, hΘnsmul]
  ·
    intro W x y hx hy hxy
    rw [hcl W x hx, hcl W y hy] at hxy
    have hβ := hΘinj W hxy
    have hfd : ((a W (I.cocomplex.X q)).symm x - (a W (I.cocomplex.X q)).symm y) ≫
        I.cocomplex.d q (q + 1) = 0 := by
      rw [Preadditive.sub_comp, hcyc W x hx, hcyc W y hy, sub_zero]
    have h0 : I.extMk ((a W (I.cocomplex.X q)).symm x - (a W (I.cocomplex.X q)).symm y)
        (q + 1) rfl hfd = 0 := by
      rw [hext_sub _ _ (hcyc W x hx) (hcyc W y hy) hfd, hβ, sub_self]
    rcases Nat.eq_zero_or_pos q with hq | hq
    · have hz := inj_res_extMk_deg_zero_injective I _ (q + 1) rfl hfd hq h0
      refine ⟨0, ?_⟩
      rw [map_zero]
      have h1 : (a W (I.cocomplex.X q)).symm (x - y) = 0 := by rw [hsub, hz]
      have h2 := congrArg (a W (I.cocomplex.X q)) h1
      rw [Equiv.apply_symm_apply, ha0] at h2
      exact h2.symm
    · obtain ⟨p, rfl⟩ : ∃ p, q = p + 1 := ⟨q - 1, by omega⟩
      obtain ⟨g, hg⟩ := (I.extMk_eq_zero_iff _ (p + 1 + 1) rfl hfd p rfl).mp h0
      rw [CochainComplex.prev_nat_succ]
      refine ⟨a W (I.cocomplex.X p) g, ?_⟩
      rw [← Hnat, hg, ← hsub, Equiv.apply_symm_apply]
  ·
    intro W W₂ h Eh γ hγ x hx
    haveI := Eh.additive
    haveI := Eh.presLim
    haveI := Eh.presColim
    obtain ⟨r, τ, hr, hμ, hε⟩ := H3 W W₂ h Eh γ hγ
    have hx₂ : ((R.map (I.cocomplex.d q (q + 1))).val.app
        (Opposite.op ((wcEtBaseChange i).obj W₂))).hom
        (((R.obj (I.cocomplex.X q)).val.map ((wcEtBaseChange i).map h).op).hom x) = 0 := by
      rw [PresheafOfModules.naturality_apply, hx]
      exact map_zero _
    rw [hcl W x hx, hcl W₂ _ hx₂]
    have hrs : (a W₂ (I.cocomplex.X q)).symm
        (((R.obj (I.cocomplex.X q)).val.map ((wcEtBaseChange i).map h).op).hom x) =
        r ≫ (a W (I.cocomplex.X q)).symm x := by
      apply (a W₂ _).injective
      refine ((a W₂ (I.cocomplex.X q)).apply_symm_apply _).trans ?_
      refine Eq.trans ?_ (hr (I.cocomplex.X q) ((a W (I.cocomplex.X q)).symm x)).symm
      exact congrArg _ ((a W (I.cocomplex.X q)).apply_symm_apply x).symm
    have hβ : I.extMk ((a W₂ (I.cocomplex.X q)).symm
        (((R.obj (I.cocomplex.X q)).val.map ((wcEtBaseChange i).map h).op).hom x)) (q + 1) rfl
        (hcyc W₂ _ hx₂) = (Abelian.Ext.mk₀ r).comp
          (I.extMk ((a W (I.cocomplex.X q)).symm x) (q + 1) rfl (hcyc W x hx)) (zero_add q) := by
      exact (hextcongr _ _ _ _ hrs).trans
        (I.mk₀_comp_extMk ((a W (I.cocomplex.X q)).symm x) (q + 1) rfl (hcyc W x hx) r).symm
    have h2 : ∀ {A₁ B₁ C₁ D₁ : SheafOfModules.{u+1} (wcEtZModRing W₂.left ℓ)} {n : ℕ}
        (f : A₁ ⟶ B₁) (g : B₁ ⟶ C₁) (z : Abelian.Ext C₁ D₁ n),
        (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ g).comp z (zero_add n)) (zero_add n) =
          (Abelian.Ext.mk₀ (f ≫ g)).comp z (zero_add n) := by
      intro A₁ B₁ C₁ D₁ n f g z
      exact Abelian.Ext.mk₀_comp_mk₀_assoc f g z
    have h3 : ∀ {A₁ B₁ C₁ D₁ : SheafOfModules.{u+1} (wcEtZModRing W₂.left ℓ)} {n : ℕ}
        (z : Abelian.Ext A₁ B₁ n) (f : B₁ ⟶ C₁) (g : C₁ ⟶ D₁),
        (z.comp (Abelian.Ext.mk₀ f) (add_zero n)).comp (Abelian.Ext.mk₀ g) (add_zero n) =
          z.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero n) := by
      intro A₁ B₁ C₁ D₁ n z f g
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
    have h4 : ∀ {A₁ B₁ C₁ D₁ : SheafOfModules.{u+1} (wcEtZModRing W₂.left ℓ)} {n : ℕ}
        (f : A₁ ⟶ B₁) (z : Abelian.Ext B₁ C₁ n) (g : C₁ ⟶ D₁),
        ((Abelian.Ext.mk₀ f).comp z (zero_add n)).comp (Abelian.Ext.mk₀ g) (add_zero n) =
          (Abelian.Ext.mk₀ f).comp (z.comp (Abelian.Ext.mk₀ g) (add_zero n)) (zero_add n) := by
      intro A₁ B₁ C₁ D₁ n f z g
      exact Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _
    have hL : ∀ β : Abelian.Ext (A W) (SheafOfModules.unit (wcEtZModRing Y ℓ)) q,
        wcEtSuppRestr (DW W) Eh (DW W₂) γ q (Θ W β) =
        (Abelian.Ext.mk₀ (γ ≫ Eh.Φ.map (ε W))).comp
          ((Abelian.Ext.mapExactFunctor Eh.Φ (Abelian.Ext.mapExactFunctor (EW W).Φ β)).comp
            (Abelian.Ext.mk₀ (Eh.Φ.map (EW W).μ.hom ≫ Eh.μ.hom)) (add_zero q)) (zero_add q) := by
      intro β
      show (Abelian.Ext.mk₀ γ).comp ((Abelian.Ext.mapExactFunctor Eh.Φ (Θ W β)).comp
        (Abelian.Ext.mk₀ Eh.μ.hom) (add_zero q)) (zero_add q) = _
      simp only [Θ]
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
        Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀, h4, h3, h2]
    have hR : ∀ β : Abelian.Ext (A W) (SheafOfModules.unit (wcEtZModRing Y ℓ)) q,
        Θ W₂ ((Abelian.Ext.mk₀ r).comp β (zero_add q)) =
        (Abelian.Ext.mk₀ (ε W₂ ≫ (EW W₂).Φ.map r ≫ τ.hom.app (A W))).comp
          ((Abelian.Ext.mapExactFunctor Eh.Φ (Abelian.Ext.mapExactFunctor (EW W).Φ β)).comp
            (Abelian.Ext.mk₀ (Eh.Φ.map (EW W).μ.hom ≫ Eh.μ.hom)) (add_zero q)) (zero_add q) := by
      intro β
      have hnat := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp β τ.hom
      rw [Abelian.Ext.comp_mapExactFunctor] at hnat
      simp only [Θ]
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀, hμ,
        ← h3 ((Abelian.Ext.mk₀ ((EW W₂).Φ.map r)).comp
          (Abelian.Ext.mapExactFunctor (EW W₂).Φ β) (zero_add q))
          (τ.hom.app (SheafOfModules.unit (wcEtZModRing Y ℓ)))
          (Eh.Φ.map (EW W).μ.hom ≫ Eh.μ.hom),
        h4, hnat, h2, h4, h2]
    rw [hβ, hL, hR, hε]
  ·
    intro W EW' γ' hγ' c hc
    obtain ⟨γW, hγW, -⟩ := wc_et_closed_supp_base_change i W.hom (Limits.pullback.fst W.hom i)
      (Limits.pullback.snd W.hom i) (IsPullback.of_hasPullback W.hom i).flip D (EW W) (DW W)

    have hindep : ∀ (E E' : wcEtPullData W.hom ℓ)
        (g₁ : wcEtSuppObj (DW W) ⟶ E.Φ.obj (wcEtSuppObj D))
        (g₂ : wcEtSuppObj (DW W) ⟶ E'.Φ.obj (wcEtSuppObj D)),
        wcEtSuppUnitMap (DW W) ≫ g₁ = E.μ.inv ≫ E.Φ.map (wcEtSuppUnitMap D) →
        wcEtSuppUnitMap (DW W) ≫ g₂ = E'.μ.inv ≫ E'.Φ.map (wcEtSuppUnitMap D) →
        ∀ θ : wcEtSuppExt D q,
          wcEtSuppRestr D E (DW W) g₁ q θ = wcEtSuppRestr D E' (DW W) g₂ q θ := by
      intro E E' g₁ g₂ hg₁ hg₂ θ
      obtain ⟨E₂⟩ := wc_et_zmod_pull_data_exists (𝟙 W.left) ℓ
      obtain ⟨γ₂, hγ₂, hep⟩ := wc_et_closed_supp_base_change (Limits.pullback.fst W.hom i)
        (𝟙 W.left) (Limits.pullback.fst W.hom i) (𝟙 _) IsPullback.of_id_fst (DW W) E₂ (DW W)
      have ha := wc_et_supp_restr_comp W.hom (𝟙 W.left) W.hom (Category.id_comp _) D (DW W) (DW W)
        E E₂ E' g₁ γ₂ g₂ hg₁ hγ₂ hg₂ hep q θ
      have hb := wc_et_supp_restr_comp W.hom (𝟙 W.left) W.hom (Category.id_comp _) D (DW W) (DW W)
        E E₂ E g₁ γ₂ g₁ hg₁ hγ₂ hg₁ hep q θ
      exact hb.trans ha.symm
    let P0 : SheafOfModules.{u+1} (wcEtZModRing Y ℓ) :=
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ).obj
        (SheafOfModules.unit (wcEtZModRing Z ℓ))
    let u1 : (R.obj P0).val.obj (Opposite.op ((wcEtBaseChange i).obj W)) :=
      ((adj.unit.app (SheafOfModules.unit (wcEtZModRing Z ℓ))).val.app
          (Opposite.op ((wcEtBaseChange i).obj W))).hom
          (1 : (wcEtZModRing Z ℓ).obj.obj (Opposite.op ((wcEtBaseChange i).obj W)))
    let π : A W ⟶ P0 := (a W P0).symm u1
    have H4' : ε W ≫ (EW W).Φ.map π = γW := H4 W γW hγW
    have hπ : a W P0 π = u1 := (a W P0).apply_symm_apply u1
    obtain ⟨y, hydef⟩ : ∃ y : (R.obj (I.cocomplex.X q)).val.obj
        (Opposite.op ((wcEtBaseChange i).obj W)),
        y = ((adj.homEquiv (SheafOfModules.unit (wcEtZModRing Z ℓ)) (I.cocomplex.X q) c).val.app
          (Opposite.op ((wcEtBaseChange i).obj W))).hom
          (1 : (wcEtZModRing Z ℓ).obj.obj (Opposite.op ((wcEtBaseChange i).obj W))) := ⟨_, rfl⟩
    rw [← hydef]
    have e1 := congrArg (fun φ : SheafOfModules.unit (wcEtZModRing Z ℓ) ⟶ R.obj (I.cocomplex.X q) =>
      (φ.val.app (Opposite.op ((wcEtBaseChange i).obj W))).hom
        (1 : (wcEtZModRing Z ℓ).obj.obj (Opposite.op ((wcEtBaseChange i).obj W))))
      (adj.homEquiv_unit (SheafOfModules.unit (wcEtZModRing Z ℓ)) (I.cocomplex.X q) c)
    have hy : y = a W (I.cocomplex.X q) (π ≫ c) :=
      hydef.trans (e1.trans ((Hnat W P0 (I.cocomplex.X q) π c).trans
        (congrArg (fun z => ((R.map c).val.app (Opposite.op ((wcEtBaseChange i).obj W))).hom z)
          hπ)).symm)
    have hπc : (π ≫ c) ≫ I.cocomplex.d q (q + 1) = 0 := by
      rw [Category.assoc, hc, Limits.comp_zero]
    have hyc : ((R.map (I.cocomplex.d q (q + 1))).val.app
        (Opposite.op ((wcEtBaseChange i).obj W))).hom y = 0 := by
      rw [hy]
      refine (Hnat W _ _ (π ≫ c) (I.cocomplex.d q (q + 1))).symm.trans ?_
      rw [hπc]
      exact ha0 W _
    have hsy : (a W (I.cocomplex.X q)).symm y = π ≫ c := by
      rw [hy]
      exact (a W (I.cocomplex.X q)).symm_apply_apply _
    have hβ : I.extMk ((a W (I.cocomplex.X q)).symm y) (q + 1) rfl (hcyc W y hyc) =
        (Abelian.Ext.mk₀ π).comp (I.extMk c (q + 1) rfl hc) (zero_add q) :=
      (hextcongr _ _ _ _ hsy).trans (I.mk₀_comp_extMk c (q + 1) rfl hc π).symm
    rw [hcl W y hyc, hβ, hΘmk W π, H4']
    refine Eq.trans ?_ (hindep (EW W) EW' γW γ' hγW hγ' _)
    rfl

theorem wc_et_closed_rightAdj_top_homology_unit_epi : ∀ (K : Type u) [Field K] [IsAlgClosed K] {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y] (n m r : ℕ), m + r = n → ∀ [SmoothOfRelativeDimension n pY] (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (D : wcEtPullData i ℓ) (R : SheafOfModules.{u+1} (wcEtZModRing Y ℓ) ⥤ SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) [R.Additive], (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ ⊣ R) → ∀ (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing Y ℓ))), (∀ (K' : Type u) [Field K'] [IsAlgClosed K'] (ℓ' : ℕ) [Fact (Nat.Prime ℓ')], (ℓ' : K') ≠ 0 → ∀ (T : wcEtLocThom K' ℓ'), wcEtThomGL T → wcEtThomNat T → wcEtThomPt T → ∀ (W ZW : Scheme.{u}) (fW : W ⟶ Spec (.of K')) (n' c : ℕ) [SmoothOfRelativeDimension n' fW] (iW : ZW ⟶ W) [IsClosedImmersion iW] [SmoothOfRelativeDimension (n' - c) (iW ≫ fW)], c ≤ n' → ∀ (D₁ : wcEtPullData iW ℓ') (θ α : wcEtSuppExt D₁ (2 * c)), wcEtIsThom T fW D₁ c θ → ∀ z : ZW, ∃ (W' : Scheme.{u}) (f : W' ⟶ W), Etale f ∧ iW z ∈ Set.range f ∧ ∃ k : ℕ, ∀ (Z' : Scheme.{u}) (iW' : Z' ⟶ W') (g : Z' ⟶ ZW), IsPullback g iW' iW f → ∀ (D' : wcEtPullData iW' ℓ') (Ef : wcEtPullData f ℓ') (γ : wcEtSuppObj D' ⟶ Ef.Φ.obj (wcEtSuppObj D₁)), wcEtSuppUnitMap D' ≫ γ = Ef.μ.inv ≫ Ef.Φ.map (wcEtSuppUnitMap D₁) → wcEtSuppRestr D₁ Ef D' γ (2 * c) α = k • wcEtSuppRestr D₁ Ef D' γ (2 * c) θ) → ∃ φ : SheafOfModules.unit (wcEtZModRing Z ℓ) ⟶ ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology (2 * r), Epi φ :=
by
  intro K _ _ Y Z pY _ _ n m r hmr _ i _ _ _ ℓ _ hℓ D R _ adj I LT
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _

  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace pY
  have hrn : r ≤ n := by omega
  have hnr : n - r = m := by omega
  haveI hsm : SmoothOfRelativeDimension (n - r) (i ≫ pY) := by rw [hnr]; infer_instance

  obtain ⟨T, hGL, hNat, hPt⟩ := wc_et_kummer_local_thom K ℓ hℓ
  obtain ⟨θ, hθ⟩ := wc_et_thom_class_glue K ℓ hℓ T hGL hNat Y Z pY n r i hrn D
  obtain ⟨c₀, hc₀, hcθ₀⟩ := I.extMk_surjective θ (2 * r + 1) rfl
  obtain ⟨c, hc, hcθ⟩ : ∃ (c : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i) _ _
      D.cont D.φ).obj (SheafOfModules.unit (wcEtZModRing Z ℓ)) ⟶ I.cocomplex.X (2 * r))
      (hc : c ≫ I.cocomplex.d (2 * r) (2 * r + 1) = 0), I.extMk c (2 * r + 1) rfl hc = θ :=
    ⟨c₀, hc₀, hcθ₀⟩
  obtain ⟨cb, hcb⟩ : ∃ cb : SheafOfModules.unit (wcEtZModRing Z ℓ) ⟶ R.obj (I.cocomplex.X (2 * r)),
      cb = adj.homEquiv (SheafOfModules.unit (wcEtZModRing Z ℓ)) (I.cocomplex.X (2 * r)) c :=
    ⟨_, rfl⟩
  have hk' : cb ≫ R.map (I.cocomplex.d (2 * r) (2 * r + 1)) = 0 := by
    have e := adj.homEquiv_naturality_right c (I.cocomplex.d (2 * r) (2 * r + 1))
    have hz : adj.homEquiv (SheafOfModules.unit (wcEtZModRing Z ℓ)) (I.cocomplex.X (2 * r + 1))
        (0 : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ).obj
          (SheafOfModules.unit (wcEtZModRing Z ℓ)) ⟶ I.cocomplex.X (2 * r + 1)) = 0 := by
      simp [Adjunction.homEquiv_unit]
    rw [hc, hz] at e
    rw [hcb]; exact e.symm
  have hk : cb ≫ ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).d (2 * r)
      (2 * r + 1) = 0 := hk'
  have hy0 : ∀ X : (Z.Etale)ᵒᵖ, ((R.map (I.cocomplex.d (2 * r) (2 * r + 1))).val.app X).hom
      ((cb.val.app X).hom (1 : (wcEtZModRing Z ℓ).obj.obj X)) = 0 := by
    intro X
    have h := congrArg (fun φ : SheafOfModules.unit (wcEtZModRing Z ℓ) ⟶
        R.obj (I.cocomplex.X (2 * r + 1)) =>
      (φ.val.app X).hom (1 : (wcEtZModRing Z ℓ).obj.obj X)) hk'
    exact h
  refine ⟨_, wc_et_mod_homology_epi_of_local_gen Z (wcEtZModRing Z ℓ)
    ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex) (2 * r) cb hk ?_⟩

  intro V s hs v
  have hs' : ((R.map (I.cocomplex.d (2 * r) (2 * r + 1))).val.app (Opposite.op V)).hom s = 0 := hs
  obtain ⟨W, hV, x, hx⟩ : ∃ (W : Y.Etale) (hV : (wcEtBaseChange i).obj W ⟶ V)
      (x : ((wcEtBaseChange i).obj W).left), hV.left x = v := by
