      rw [← hm2, Category.assoc, AffineSpace.homOfVector_over, Category.comp_id]

  have hgen : ∀ (B : Scheme.{u}) (qB : B ⟶ Spec (.of K)) [IsAffine B] [IrreducibleSpace B]
      [Smooth qB] (b : Spec (.of K) ⟶ B), b ≫ qB = 𝟙 _ →
      ∀ (DB : wcEtPullData (AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin c) → Γ(B, ⊤))) ℓ)
        (ω β : wcEtSuppExt DB (2 * c)), ω ≠ 0 → ∃ k : ℕ, β = k • ω := by
    intro B qB _ _ _ b hb DB ω β hω
