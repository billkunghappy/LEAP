  let Eh : wcEtPullData h₂.left ℓ := (wc_et_zmod_pull_data_exists h₂.left ℓ).some
  obtain ⟨γh, hγh, -⟩ := wc_et_closed_supp_base_change (Limits.pullback.fst W.hom i) h₂.left
    (Limits.pullback.fst W₂.hom i) ((wcEtBaseChange i).map h₂).left hP (DW W) Eh (DW W₂)
  have Hstar := H (Limits.pullback W₂.hom i) (Limits.pullback.fst W₂.hom i)
    ((wcEtBaseChange i).map h₂).left hP (DW W₂) Eh γh hγh
  have hyres : ((R.obj (I.cocomplex.X (2 * r))).val.map ((wcEtBaseChange i).map h₂).op).hom y =
      (cb.val.app (Opposite.op ((wcEtBaseChange i).obj W₂))).hom
        (1 : (wcEtZModRing Z ℓ).obj.obj (Opposite.op ((wcEtBaseChange i).obj W₂))) := by
    have h1 : ((SheafOfModules.unit (wcEtZModRing Z ℓ)).val.map ((wcEtBaseChange i).map h₂).op).hom
        (1 : (wcEtZModRing Z ℓ).obj.obj (Opposite.op ((wcEtBaseChange i).obj W))) =
        (1 : (wcEtZModRing Z ℓ).obj.obj (Opposite.op ((wcEtBaseChange i).obj W₂))) :=
      PresheafOfModules.unit_map_one _ _
    have h2 := PresheafOfModules.naturality_apply cb.val ((wcEtBaseChange i).map h₂).op
      (1 : (wcEtZModRing Z ℓ).obj.obj (Opposite.op ((wcEtBaseChange i).obj W)))
    rw [h1] at h2
    rw [hydef]
    exact h2.symm
  have hyc₂ : ((R.map (I.cocomplex.d (2 * r) (2 * r + 1))).val.app
      (Opposite.op ((wcEtBaseChange i).obj W₂))).hom
      (((R.obj (I.cocomplex.X (2 * r))).val.map ((wcEtBaseChange i).map h₂).op).hom y) = 0 := by
    rw [hyres]; exact hy0 _
  have hs₂ : ((R.map (I.cocomplex.d (2 * r) (2 * r + 1))).val.app
      (Opposite.op ((wcEtBaseChange i).obj W₂))).hom
      (((R.obj (I.cocomplex.X (2 * r))).val.map ((wcEtBaseChange i).map h₂).op).hom s₁) = 0 := by
    rw [PresheafOfModules.naturality_apply, hs₁]; exact map_zero _
  have hky₂ : ((R.map (I.cocomplex.d (2 * r) (2 * r + 1))).val.app
      (Opposite.op ((wcEtBaseChange i).obj W₂))).hom
      (k • ((R.obj (I.cocomplex.X (2 * r))).val.map ((wcEtBaseChange i).map h₂).op).hom y) = 0 :=
    (map_nsmul ((R.map (I.cocomplex.d (2 * r) (2 * r + 1))).val.app
      (Opposite.op ((wcEtBaseChange i).obj W₂))).hom k
      (((R.obj (I.cocomplex.X (2 * r))).val.map ((wcEtBaseChange i).map h₂).op).hom y)).trans
      ((congrArg (fun z => k • z) hyc₂).trans (smul_zero k))
  have key : cl W₂ (((R.obj (I.cocomplex.X (2 * r))).val.map ((wcEtBaseChange i).map h₂).op).hom s₁) =
      cl W₂ (k • ((R.obj (I.cocomplex.X (2 * r))).val.map ((wcEtBaseChange i).map h₂).op).hom y) :=
    (P3 W W₂ h₂ Eh γh hγh s₁ hs₁).symm.trans (Hstar.trans
