    apply AddCommGrpCat.ext
    intro y
    obtain ⟨k, hk⟩ := ZMod.intCast_surjective y.down
    have hy : y = π0 (ULift.up k) := ULift.ext _ _ hk.symm
    rw [hy]
    have e1 := congrArg (fun φ : AddCommGrpCat.of (ULift.{u+1} ℤ) ⟶ W => φ (ULift.up k)) hm
    have e2 := congrArg (fun φ : AddCommGrpCat.of (ULift.{u+1} ℤ) ⟶ W => φ (ULift.up k)) (fac g hg)
