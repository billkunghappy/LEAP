theorem wc_ybar_betti_bound (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (r : ℕ → ℕ) (E : ∀ j : ℕ, wcHM (wcXbar F X) ℓ j ≃+ (Fin (r j) → ℚ_[ℓ]))
    (hE : ∀ j ≤ 2 * d, ∀ (c : ℚ_[ℓ]) (x : wcHM (wcXbar F X) ℓ j),
      E j (wcHMScalar (wcXbar F X) ℓ j c x) = c • E j x) :
    ∃ (R : ℕ) (EY : wcHM (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) ≃+ (Fin R → ℚ_[ℓ])),
      (∀ (c : ℚ_[ℓ]) (x : wcHM (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d)),
        EY (wcHMScalar (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) c x) = c • EY x) ∧
      R ≤ ∑ j ∈ Finset.range (2 * d + 1), r j * r (2 * d - j) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcXbar F X) ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1}
    (wcRingSheaf (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ)) := HasExt.standard _

  have hConstMul : ∀ (S : Scheme.{u}) (a b : ℚ_[ℓ]),
      wcHMConst S ℓ a ≫ wcHMConst S ℓ b = wcHMConst S ℓ (a * b) := by
    intro S a b
    apply (SheafOfModules.unitHomEquiv _).injective
    rw [SheafOfModules.unitHomEquiv_comp_apply]
    apply Subtype.ext
    funext V
    have hvalP : ∀ (c : ℚ_[ℓ]), ((SheafOfModules.unitHomEquiv _) (wcHMConst S ℓ c)).1 V =
        (ContinuousMap.const _ (ULift.up c) : C(↥((Opposite.unop V).left), ULift.{u+1} ℚ_[ℓ])) := by
      intro c
      simp only [wcHMConst, Equiv.apply_symm_apply]
      rfl
    show ((wcHMConst S ℓ b).val.app V).hom (((SheafOfModules.unitHomEquiv _) (wcHMConst S ℓ a)).1 V) =
      ((SheafOfModules.unitHomEquiv _) (wcHMConst S ℓ (a * b))).1 V
    rw [hvalP, hvalP]
    apply ContinuousMap.ext
    intro x
    rfl
  have hConstOne : ∀ (S : Scheme.{u}), wcHMConst S ℓ 1 = 𝟙 _ := by
    intro S
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext V
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    rw [← SheafOfModules.unitHomEquiv_apply_coe]
    simp only [wcHMConst, Equiv.apply_symm_apply]
    rfl
  have hConstAdd : ∀ (S : Scheme.{u}) (a b : ℚ_[ℓ]),
      wcHMConst S ℓ (a + b) = wcHMConst S ℓ a + wcHMConst S ℓ b := by
    intro S a b
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext V
    have hvalP : ∀ (c : ℚ_[ℓ]), ((SheafOfModules.unitHomEquiv _) (wcHMConst S ℓ c)).1 V =
        (ContinuousMap.const _ (ULift.up c) : C(↥((Opposite.unop V).left), ULift.{u+1} ℚ_[ℓ])) := by
      intro c
      simp only [wcHMConst, Equiv.apply_symm_apply]
      rfl
    rw [hvalP, SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.add_val,
      PresheafOfModules.add_app]
    show _ = ((SheafOfModules.unitHomEquiv _) (wcHMConst S ℓ a)).1 V +
      ((SheafOfModules.unitHomEquiv _) (wcHMConst S ℓ b)).1 V
    rw [hvalP, hvalP]
    apply ContinuousMap.ext
    intro x
    rfl

  obtain ⟨D1, hD1⟩ := wc_hm_pull_data_exists (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)) ℓ
  haveI := D1.additive
  haveI := D1.presLim
  letI : (@SheafOfModules.pushforward _ _ _ _ _ _
      (wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))) _ _ D1.cont D1.φ).Additive :=
    @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D1.adj D1.additive
  haveI := sheafOfModules_enoughInjectives _ (wcRingSheaf (wcXbar F X) ℓ)
  haveI := sheafOfModules_enoughInjectives _
    (wcRingSheaf (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ)
  obtain ⟨I, -⟩ : ∃ I : InjectiveResolution
      (SheafOfModules.unit (wcRingSheaf (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ)), True :=
    ⟨InjectiveResolution.of _, trivial⟩

  have split : ∀ (Hh : SheafOfModules.{u+1} (wcRingSheaf (wcXbar F X) ℓ)) (m : ℕ)
      (ι : Fin m → (SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ) ⟶ Hh))
      (ρ : Fin m → (Hh ⟶ SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ))),
      (∀ a b : Fin m, ι a ≫ ρ b = if a = b then 𝟙 _ else 0) → ∑ a, ρ a ≫ ι a = 𝟙 _ →
      ∀ (p : ℕ), p ≤ 2 * d →
      ∃ e : Abelian.Ext (SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ)) Hh p ≃+
          (Fin (m * r p) → ℚ_[ℓ]),
        ∀ (c : ℚ_[ℓ]) (x : Abelian.Ext (SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ)) Hh p),
          e ((Abelian.Ext.mk₀ (wcHMConst (wcXbar F X) ℓ c)).comp x (zero_add p)) = c • e x := by
    intro Hh m ι ρ hιρ hsum p hp
    let T : Abelian.Ext (SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ)) Hh p ≃+
        (Fin m → wcHM (wcXbar F X) ℓ p) :=
      { toFun := fun x a => x.comp (Abelian.Ext.mk₀ (ρ a)) (add_zero p)
        invFun := fun y => ∑ a, (y a).comp (Abelian.Ext.mk₀ (ι a)) (add_zero p)
        left_inv := fun x => by
          simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
          rw [← Abelian.Ext.comp_sum, ← Abelian.Ext.mk₀_sum, hsum, Abelian.Ext.comp_mk₀_id]
        right_inv := fun y => by
          funext b
          simp only
          rw [Abelian.Ext.sum_comp]
          simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, hιρ]
          rw [Finset.sum_eq_single b]
          · rw [if_pos rfl, Abelian.Ext.comp_mk₀_id]
          · intro a _ hab
            rw [if_neg hab, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
          · intro h
            exact absurd (Finset.mem_univ b) h
        map_add' := fun x y => funext fun a => Abelian.Ext.add_comp _ _ _ _ }
    let Lq : (Fin m → Fin (r p) → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin (m * r p) → ℚ_[ℓ]) :=
      (LinearEquiv.curry ℚ_[ℓ] ℚ_[ℓ] (Fin m) (Fin (r p))).symm.trans
        (LinearEquiv.funCongrLeft ℚ_[ℓ] ℚ_[ℓ] finProdFinEquiv.symm)
    refine ⟨T.trans ((AddEquiv.piCongrRight fun _ => E p).trans Lq.toAddEquiv), fun c x => ?_⟩
    have hT : ∀ a, T ((Abelian.Ext.mk₀ (wcHMConst (wcXbar F X) ℓ c)).comp x (zero_add p)) a =
        wcHMScalar (wcXbar F X) ℓ p c (T x a) := by
      intro a
      show ((Abelian.Ext.mk₀ (wcHMConst (wcXbar F X) ℓ c)).comp x (zero_add p)).comp
          (Abelian.Ext.mk₀ (ρ a)) (add_zero p) =
        (x.comp (Abelian.Ext.mk₀ (ρ a)) (add_zero p)).comp
          (Abelian.Ext.mk₀ (wcHMConst (wcXbar F X) ℓ c)) (add_zero p)
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero,
        wc_hm_unit_end_central (wcXbar F X) ℓ (wcHMConst (wcXbar F X) ℓ c) p]
    show Lq (fun a => E p (T ((Abelian.Ext.mk₀ (wcHMConst (wcXbar F X) ℓ c)).comp x
        (zero_add p)) a)) = c • Lq (fun a => E p (T x a))
    rw [← map_smul]
    congr 1
    funext a
    rw [hT a, hE p hp]
    rfl

  obtain ⟨N, e, he, hN⟩ := wc_leray_ext_dim_bound D1.Φ
    (@SheafOfModules.pushforward _ _ _ _ _ _
      (wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))) _ _ D1.cont D1.φ) D1.adj
    (SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ)) (wcHMConst (wcXbar F X) ℓ)
    (hConstOne _) (fun a b => by rw [mul_comm]; exact (hConstMul _ b a).symm) (hConstAdd _)
    _ I (2 * d) (fun p => r p * r (2 * d - p)) (by
      intro p hp
      have hq : 2 * d - p ≤ 2 * d := Nat.sub_le _ _
      obtain ⟨m, eq, ι, ρ, heq, hιρ, hsum⟩ :=
        wc_ybar_leray_sheaf_free F X d ℓ hℓ D1 hD1 I (2 * d - p) hq
      have hm : r (2 * d - p) = m := by
        have hΛ : ∀ (c : ℚ_[ℓ]) (v : Fin (r (2 * d - p)) → ℚ_[ℓ]),
            ((E (2 * d - p)).symm.trans eq) (c • v) =
              c • ((E (2 * d - p)).symm.trans eq) v := by
          intro c v
          have h1 : (E (2 * d - p)).symm (c • v) =
              wcHMScalar (wcXbar F X) ℓ (2 * d - p) c ((E (2 * d - p)).symm v) := by
            apply (E (2 * d - p)).injective
            rw [AddEquiv.apply_symm_apply, hE _ hq, AddEquiv.apply_symm_apply]
          show eq ((E (2 * d - p)).symm (c • v)) = c • eq ((E (2 * d - p)).symm v)
          rw [h1, heq]
        have h2 := (((E (2 * d - p)).symm.trans eq).toLinearEquiv hΛ).finrank_eq
        simpa only [Module.finrank_fin_fun] using h2
      obtain ⟨e', he'⟩ := split _ m ι ρ hιρ hsum p hp
      refine ⟨m * r p, e', he', ?_⟩
      show m * r p ≤ r p * r (2 * d - p)
      rw [← hm]
      exact le_of_eq (Nat.mul_comm _ _))

  let Ψ : wcHM (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) ≃+
      Abelian.Ext (D1.Φ.obj (SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ)))
        (SheafOfModules.unit (wcRingSheaf (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ)) (2 * d) :=
    { toFun := fun y => (Abelian.Ext.mk₀ D1.μ.hom).comp y (zero_add _)
      invFun := fun x => (Abelian.Ext.mk₀ D1.μ.inv).comp x (zero_add _)
      left_inv := fun y => by
        simp only
        rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
      right_inv := fun x => by
        simp only
        rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
      map_add' := fun x y => Abelian.Ext.comp_add _ _ _ _ }
  have hΨ : ∀ (c : ℚ_[ℓ]) (y : wcHM (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d)),
      Ψ (wcHMScalar (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) c y) =
        (Abelian.Ext.mk₀ (D1.Φ.map (wcHMConst (wcXbar F X) ℓ c))).comp (Ψ y) (zero_add _) := by
    intro c y
    show (Abelian.Ext.mk₀ D1.μ.hom).comp (y.comp (Abelian.Ext.mk₀
        (wcHMConst (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ c)) (add_zero _)) (zero_add _) =
      (Abelian.Ext.mk₀ (D1.Φ.map (wcHMConst (wcXbar F X) ℓ c))).comp
        ((Abelian.Ext.mk₀ D1.μ.hom).comp y (zero_add _)) (zero_add _)
    rw [← wc_hm_unit_end_central (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ
        (wcHMConst (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ c) (2 * d) y,
      Abelian.Ext.mk₀_comp_mk₀_assoc, Abelian.Ext.mk₀_comp_mk₀_assoc,
      ← wc_hm_pull_const D1 hD1 c, Iso.hom_inv_id_assoc]
  refine ⟨N, Ψ.trans e, fun c y => ?_, hN⟩
  show e (Ψ (wcHMScalar (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) c y)) = c • e (Ψ y)
  rw [hΨ, he]

theorem wc_ybar_kunneth_span (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (D1 : wcHMPullData (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)) ℓ) (hD1 : wcHMPullCanonical D1)
    (D2 : wcHMPullData (Limits.pullback.snd (wcPi2 F X) (wcPi2 F X)) ℓ) (hD2 : wcHMPullCanonical D2)
    (z : wcHM (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d)) :
    z ∈ AddSubgroup.closure {w | ∃ (t : ℚ_[ℓ]) (j : ℕ) (hj : j ≤ 2 * d)
        (a : wcHM (wcXbar F X) ℓ j) (b : wcHM (wcXbar F X) ℓ (2 * d - j)),
        w = wcHMScalar (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) t
          (wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ j (2 * d - j) (2 * d) (by omega)
            (wcHMPull D1 j a) (wcHMPull D2 (2 * d - j) b))} :=
by
  classical

  have H_assoc : ∀ (S : Scheme.{u}) (a b c ab bc abc : ℕ) (hab : a + b = ab) (hbc : b + c = bc)
      (h1 : ab + c = abc) (h2 : a + bc = abc) (x : wcHM S ℓ a) (y : wcHM S ℓ b) (z : wcHM S ℓ c),
      wcHMCup S ℓ ab c abc h1 (wcHMCup S ℓ a b ab hab x y) z =
        wcHMCup S ℓ a bc abc h2 x (wcHMCup S ℓ b c bc hbc y z) := by
    intro S a b c ab bc abc hab hbc h1 h2 x y z
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    show (x.comp y hab).comp z h1 = x.comp (y.comp z hbc) h2
    exact Abelian.Ext.comp_assoc x y z hab hbc (by omega)
  have H_scR : ∀ (S : Scheme.{u}) (i j k : ℕ) (hk : i + j = k) (c : ℚ_[ℓ]) (x : wcHM S ℓ i)
      (y : wcHM S ℓ j), wcHMCup S ℓ i j k hk x (wcHMScalar S ℓ j c y) =
        wcHMScalar S ℓ k c (wcHMCup S ℓ i j k hk x y) := by
    intro S i j k hk c x y
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    show x.comp (y.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero j)) hk =
      (x.comp y hk).comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero k)
    exact (Abelian.Ext.comp_assoc x y _ hk (add_zero j) (by omega)).symm
  have H_scL : ∀ (S : Scheme.{u}) (i j k : ℕ) (hk : i + j = k) (c : ℚ_[ℓ]) (x : wcHM S ℓ i)
      (y : wcHM S ℓ j), wcHMCup S ℓ i j k hk (wcHMScalar S ℓ i c x) y =
        wcHMScalar S ℓ k c (wcHMCup S ℓ i j k hk x y) := by
    intro S i j k hk c x y
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    show (x.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero i)).comp y hk =
      (x.comp y hk).comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero k)
    rw [Abelian.Ext.comp_assoc_of_second_deg_zero, wc_hm_unit_end_central S ℓ (wcHMConst S ℓ c) j y]
    exact (Abelian.Ext.comp_assoc x y _ hk (add_zero j) (by omega)).symm
  have H_mul : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcHMPullData f ℓ) (i j k : ℕ) (hk : i + j = k)
      (x : wcHM S ℓ i) (y : wcHM S ℓ j),
      wcHMPull D k (wcHMCup S ℓ i j k hk x y) =
        wcHMCup S' ℓ i j k hk (wcHMPull D i x) (wcHMPull D j y) := by
    intro S S' f D i j k hk x y
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ (x.comp y hk)).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero k)) (zero_add k) =
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ x).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero i)) (zero_add i)).comp
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ y).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero j)) (zero_add j)) hk
    rw [Abelian.Ext.mapExactFunctor_comp]
    generalize Abelian.Ext.mapExactFunctor D.Φ x = z
    generalize Abelian.Ext.mapExactFunctor D.Φ y = w
    have e1 : (Abelian.Ext.mk₀ D.μ.hom).comp ((Abelian.Ext.mk₀ D.μ.inv).comp
        (w.comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero j)) (zero_add j)) (zero_add j) =
        w.comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero j) := by
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add j) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    rw [Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ D.μ.inv)
        (z.comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero i)) _ (zero_add i) hk (by omega),
      Abelian.Ext.comp_assoc z (Abelian.Ext.mk₀ D.μ.hom) _ (add_zero i) (zero_add j) (by omega), e1,
      Abelian.Ext.comp_assoc z w (Abelian.Ext.mk₀ D.μ.hom) hk (add_zero j) (by omega)]

  have hConstMul : ∀ (S : Scheme.{u}) (a b : ℚ_[ℓ]),
      wcHMConst S ℓ a ≫ wcHMConst S ℓ b = wcHMConst S ℓ (a * b) := by
    intro S a b
    apply (SheafOfModules.unitHomEquiv _).injective
    rw [SheafOfModules.unitHomEquiv_comp_apply]
    apply Subtype.ext
    funext V
    have hvalP : ∀ (c : ℚ_[ℓ]), ((SheafOfModules.unitHomEquiv _) (wcHMConst S ℓ c)).1 V =
        (ContinuousMap.const _ (ULift.up c) : C(↥((Opposite.unop V).left), ULift.{u+1} ℚ_[ℓ])) := by
      intro c
      simp only [wcHMConst, Equiv.apply_symm_apply]
      rfl
    show ((wcHMConst S ℓ b).val.app V).hom (((SheafOfModules.unitHomEquiv _) (wcHMConst S ℓ a)).1 V) =
      ((SheafOfModules.unitHomEquiv _) (wcHMConst S ℓ (a * b))).1 V
    rw [hvalP, hvalP]
    apply ContinuousMap.ext
    intro x
    rfl
  have hConstOne : ∀ (S : Scheme.{u}), wcHMConst S ℓ 1 = 𝟙 _ := by
    intro S
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext V
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    rw [← SheafOfModules.unitHomEquiv_apply_coe]
    simp only [wcHMConst, Equiv.apply_symm_apply]
    rfl
  have hsc : ∀ (S : Scheme.{u}) (n : ℕ) (a b : ℚ_[ℓ]) (x : wcHM S ℓ n),
      wcHMScalar S ℓ n a (wcHMScalar S ℓ n b x) = wcHMScalar S ℓ n (b * a) x := by
    intro S n a b x
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    show (x.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ b)) (add_zero n)).comp
        (Abelian.Ext.mk₀ (wcHMConst S ℓ a)) (add_zero n) =
      x.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ (b * a))) (add_zero n)
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, hConstMul]
  have hs1 : ∀ (S : Scheme.{u}) (n : ℕ) (x : wcHM S ℓ n), wcHMScalar S ℓ n 1 x = x := by
    intro S n x
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    show x.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ 1)) (add_zero n) = x
    rw [hConstOne, Abelian.Ext.comp_mk₀_id]

  have h : WeaklyEtale (Limits.pullback.fst X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F)
  choose r e he using wc_coh_finite F X d ℓ hℓ h
  obtain ⟨T, hTs, -⟩ := wc_hm_comparison F X h ℓ
  obtain ⟨⟨e₁, he₁⟩, -⟩ := wc_top_coh_frobenius F X d ℓ hℓ h
  have hvan := wc_coh_vanishing F X d ℓ hℓ h
  have hTinv : ∀ (i : ℕ) (c : ℚ_[ℓ]) (y : wcHM (wcXbar F X) ℓ i),
      (T i).symm (wcHMScalar (wcXbar F X) ℓ i c y) = wcCohScalar F X h ℓ i c ((T i).symm y) := by
    intro i c y
    apply (T i).injective
    rw [AddEquiv.apply_symm_apply, hTs, AddEquiv.apply_symm_apply]
  obtain ⟨η, hηapp⟩ : ∃ η : wcHM (wcXbar F X) ℓ (2 * d) →+ ℚ_[ℓ],
      ∀ y, η y = e₁ ((T (2 * d)).symm y) 0 :=
    ⟨(Pi.evalAddMonoidHom (fun _ : Fin 1 => ℚ_[ℓ]) 0).comp
      (e₁.toAddMonoidHom.comp (T (2 * d)).symm.toAddMonoidHom), fun y => rfl⟩
  have hηinj : Function.Injective η := by
    intro y y' hyy
    rw [hηapp, hηapp] at hyy
    have h1 : e₁ ((T (2 * d)).symm y) = e₁ ((T (2 * d)).symm y') := by
      funext k
      rw [Subsingleton.elim k 0]
      exact hyy
    exact (T (2 * d)).symm.injective (e₁.injective h1)
  have hηc : ∀ (c : ℚ_[ℓ]) (x : wcHM (wcXbar F X) ℓ (2 * d)),
      η (wcHMScalar (wcXbar F X) ℓ (2 * d) c x) = c * η x := by
    intro c x
    rw [hηapp, hηapp, hTinv, he₁]
    rfl
  obtain ⟨ω, hω⟩ : ∃ ω : wcHM (wcXbar F X) ℓ (2 * d), η ω = 1 :=
    ⟨T (2 * d) (e₁.symm (fun _ => 1)), by
      rw [hηapp]
      simp only [AddEquiv.symm_apply_apply, AddEquiv.apply_symm_apply]⟩
  have hω0 : ω ≠ 0 := by
    intro h0
    rw [h0, map_zero] at hω
    exact zero_ne_one hω
  have hvanHM : ∀ i : ℕ, 2 * d < i → ∀ x : wcHM (wcXbar F X) ℓ i, x = 0 := by
    intro i hi x
    have h0 := hvan i hi ((T i).symm x)
    calc x = T i ((T i).symm x) := (AddEquiv.apply_symm_apply _ _).symm
      _ = T i 0 := by rw [h0]
      _ = 0 := map_zero _
  obtain ⟨E, hEdef⟩ : ∃ E : ∀ i : ℕ, wcHM (wcXbar F X) ℓ i ≃+ (Fin (r i) → ℚ_[ℓ]),
      ∀ i, E i = (T i).symm.trans (e i) := ⟨_, fun i => rfl⟩
  have hE : ∀ (i : ℕ) (c : ℚ_[ℓ]) (x : wcHM (wcXbar F X) ℓ i),
      E i (wcHMScalar (wcXbar F X) ℓ i c x) = c • E i x := by
    intro i c x
    rw [hEdef]
    show e i ((T i).symm (wcHMScalar (wcXbar F X) ℓ i c x)) = c • e i ((T i).symm x)
    rw [hTinv, he]

  obtain ⟨Θ, hΘ⟩ := wc_modcoh_hm_cup_iso F X h ℓ
  have PDl : ∀ (i j : ℕ) (hij : i + j = 2 * d) (x : wcHM (wcXbar F X) ℓ i),
      (∀ y : wcHM (wcXbar F X) ℓ j, wcHMCup (wcXbar F X) ℓ i j (2 * d) hij x y = 0) → x = 0 := by
    intro i j hij x hx
    obtain rfl : j = 2 * d - i := by omega
    have hi : i ≤ 2 * d := by omega
    have h0 := (wc_modcup_perfect F X d ℓ hℓ h i hi).1 ((Θ i).symm x) (fun y' =>
      (Θ (2 * d)).injective (by rw [hΘ, map_zero, AddEquiv.apply_symm_apply]; exact hx _))
    rw [← (Θ i).apply_symm_apply x, h0, map_zero]
  have PDr : ∀ (i j : ℕ) (hij : i + j = 2 * d) (y : wcHM (wcXbar F X) ℓ j),
      (∀ x : wcHM (wcXbar F X) ℓ i, wcHMCup (wcXbar F X) ℓ i j (2 * d) hij x y = 0) → y = 0 := by
    intro i j hij y hy
    obtain rfl : j = 2 * d - i := by omega
    have hi : i ≤ 2 * d := by omega
    have h0 := (wc_modcup_perfect F X d ℓ hℓ h i hi).2 ((Θ (2 * d - i)).symm y) (fun x' =>
      (Θ (2 * d)).injective (by rw [hΘ, map_zero, AddEquiv.apply_symm_apply]; exact hy _))
    rw [← (Θ (2 * d - i)).apply_symm_apply y, h0, map_zero]

  have hLD : ∀ (j0 : ℕ) (hj0 : j0 ≤ 2 * d) (p0 : Fin (r j0)),
      ∃ a' : wcHM (wcXbar F X) ℓ (2 * d - j0), ∀ x : wcHM (wcXbar F X) ℓ j0,
        η (wcHMCup (wcXbar F X) ℓ (2 * d - j0) j0 (2 * d) (Nat.sub_add_cancel hj0) a' x) =
          E j0 x p0 := by
    intro j0 hj0 p0
    obtain ⟨w, hw⟩ := wc_pairing_right_dual (wcHMScalar (wcXbar F X) ℓ j0)
      (wcHMScalar (wcXbar F X) ℓ (2 * d - j0)) (E j0) (E (2 * d - j0)) (hE j0) (hE (2 * d - j0))
      ((wcHMCup (wcXbar F X) ℓ (2 * d - j0) j0 (2 * d) (Nat.sub_add_cancel hj0)).flip.compr₂ η)
      (fun c x y => by
        rw [AddMonoidHom.compr₂_apply, AddMonoidHom.compr₂_apply, AddMonoidHom.flip_apply,
          AddMonoidHom.flip_apply, H_scR, hηc])
      (fun c x y => by
        rw [AddMonoidHom.compr₂_apply, AddMonoidHom.compr₂_apply, AddMonoidHom.flip_apply,
          AddMonoidHom.flip_apply, H_scL, hηc])
      (fun x hx => PDr (2 * d - j0) j0 (Nat.sub_add_cancel hj0) x (fun y => hηinj (by
        rw [map_zero]
        have := hx y
        rwa [AddMonoidHom.compr₂_apply, AddMonoidHom.flip_apply] at this)))
      (fun y hy => PDl (2 * d - j0) j0 (Nat.sub_add_cancel hj0) y (fun x => hηinj (by
        rw [map_zero]
        have := hy x
        rwa [AddMonoidHom.compr₂_apply, AddMonoidHom.flip_apply] at this))) p0
    exact ⟨w, fun x => by
      have := hw x
      rwa [AddMonoidHom.compr₂_apply, AddMonoidHom.flip_apply] at this⟩
  have hRD : ∀ (j0 : ℕ) (hj0 : j0 ≤ 2 * d) (q0 : Fin (r (2 * d - j0))),
      ∃ b' : wcHM (wcXbar F X) ℓ j0, ∀ x : wcHM (wcXbar F X) ℓ (2 * d - j0),
        η (wcHMCup (wcXbar F X) ℓ (2 * d - j0) j0 (2 * d) (Nat.sub_add_cancel hj0) x b') =
          E (2 * d - j0) x q0 := by
    intro j0 hj0 q0
    obtain ⟨w, hw⟩ := wc_pairing_right_dual (wcHMScalar (wcXbar F X) ℓ (2 * d - j0))
      (wcHMScalar (wcXbar F X) ℓ j0) (E (2 * d - j0)) (E j0) (hE (2 * d - j0)) (hE j0)
      ((wcHMCup (wcXbar F X) ℓ (2 * d - j0) j0 (2 * d) (Nat.sub_add_cancel hj0)).compr₂ η)
      (fun c x y => by rw [AddMonoidHom.compr₂_apply, AddMonoidHom.compr₂_apply, H_scL, hηc])
      (fun c x y => by rw [AddMonoidHom.compr₂_apply, AddMonoidHom.compr₂_apply, H_scR, hηc])
      (fun x hx => PDl (2 * d - j0) j0 (Nat.sub_add_cancel hj0) x (fun y => hηinj (by
        rw [map_zero]
        have := hx y
        rwa [AddMonoidHom.compr₂_apply] at this)))
      (fun y hy => PDr (2 * d - j0) j0 (Nat.sub_add_cancel hj0) y (fun x => hηinj (by
        rw [map_zero]
        have := hy x
        rwa [AddMonoidHom.compr₂_apply] at this))) q0
    exact ⟨w, fun x => by
      have := hw x
      rwa [AddMonoidHom.compr₂_apply] at this⟩

  obtain ⟨v, hv⟩ : ∃ v : (Σ j : Fin (2 * d + 1), Fin (r j) × Fin (r (2 * d - j))) →
      wcHM (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d),
      ∀ (j : Fin (2 * d + 1)) (p : Fin (r j)) (q : Fin (r (2 * d - j))),
        v ⟨j, (p, q)⟩ = wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ j (2 * d - j) (2 * d)
          (Nat.add_sub_cancel' (Nat.le_of_lt_succ j.isLt))
          (wcHMPull D1 j ((E j).symm (Pi.single p 1)))
          (wcHMPull D2 (2 * d - j) ((E (2 * d - j)).symm (Pi.single q 1))) :=
    ⟨fun k => wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ k.1 (2 * d - k.1) (2 * d)
          (Nat.add_sub_cancel' (Nat.le_of_lt_succ k.1.isLt))
          (wcHMPull D1 k.1 ((E k.1).symm (Pi.single k.2.1 1)))
          (wcHMPull D2 (2 * d - k.1) ((E (2 * d - k.1)).symm (Pi.single k.2.2 1))),
      fun _ _ _ => rfl⟩

  have hind : ∀ c : (Σ j : Fin (2 * d + 1), Fin (r j) × Fin (r (2 * d - j))) → ℚ_[ℓ],
      ∑ k, wcHMScalar (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (c k) (v k) = 0 →
      ∀ k, c k = 0 := by
    intro c hc k0
    obtain ⟨j0, p0, q0⟩ := k0
    have hj0 : (j0 : ℕ) ≤ 2 * d := Nat.le_of_lt_succ j0.isLt
    obtain ⟨a', ha'⟩ := hLD j0 hj0 p0
    obtain ⟨b', hb'⟩ := hRD j0 hj0 q0
    obtain ⟨Λ, hΛ⟩ : ∃ Λ : wcHM (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) →+
        wcHM (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (4 * d), ∀ w, Λ w =
        wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ ((2 * d - j0) + 2 * d) j0 (4 * d)
          (by omega)
          (wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d - j0) (2 * d)
            ((2 * d - j0) + 2 * d) rfl (wcHMPull D1 (2 * d - j0) a') w)
          (wcHMPull D2 j0 b') :=
      ⟨((wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ ((2 * d - j0) + 2 * d) j0 (4 * d)
          (by omega)).flip (wcHMPull D2 j0 b')).comp
        (wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d - j0) (2 * d)
          ((2 * d - j0) + 2 * d) rfl (wcHMPull D1 (2 * d - j0) a')), fun w => rfl⟩
    have hΛs : ∀ (t : ℚ_[ℓ]) (w : wcHM (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d)),
        Λ (wcHMScalar (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) t w) =
          wcHMScalar (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (4 * d) t (Λ w) := by
      intro t w
      rw [hΛ, hΛ, H_scR, H_scL]
    have TG : ∀ (j : ℕ) (hj : j ≤ 2 * d) (x : wcHM (wcXbar F X) ℓ j)
        (y : wcHM (wcXbar F X) ℓ (2 * d - j)) (m1 m2 : ℕ) (h1 : (2 * d - j0) + j = m1)
        (h2 : (2 * d - j) + j0 = m2) (h3 : m1 + m2 = 4 * d),
        Λ (wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ j (2 * d - j) (2 * d)
            (Nat.add_sub_cancel' hj) (wcHMPull D1 j x) (wcHMPull D2 (2 * d - j) y)) =
          wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ m1 m2 (4 * d) h3
            (wcHMPull D1 m1 (wcHMCup (wcXbar F X) ℓ (2 * d - j0) j m1 h1 a' x))
            (wcHMPull D2 m2 (wcHMCup (wcXbar F X) ℓ (2 * d - j) j0 m2 h2 y b')) := by
      intro j hj x y m1 m2 h1 h2 h3
      rw [hΛ, H_mul D1, H_mul D2,
        ← H_assoc _ (2 * d - j0) j (2 * d - j) m1 (2 * d) ((2 * d - j0) + 2 * d) h1
          (Nat.add_sub_cancel' hj) (by omega) rfl,
        H_assoc _ m1 (2 * d - j) j0 ((2 * d - j0) + 2 * d) m2 (4 * d) (by omega) h2 (by omega) h3]
    have key : ∑ k, wcHMScalar (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (4 * d) (c k)
        (Λ (v k)) = 0 := by
      rw [← map_zero Λ, ← hc, map_sum]
      exact Finset.sum_congr rfl (fun k _ => (hΛs (c k) (v k)).symm)
    have hoff : ∀ k ∈ (Finset.univ : Finset (Σ j : Fin (2 * d + 1), Fin (r j) × Fin (r (2 * d - j)))),
        k ≠ ⟨j0, (p0, q0)⟩ →
        wcHMScalar (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (4 * d) (c k) (Λ (v k)) = 0 := by
      intro k _ hk
      obtain ⟨j, p, q⟩ := k
      have hj : (j : ℕ) ≤ 2 * d := Nat.le_of_lt_succ j.isLt
      rw [hv j p q]
      rcases lt_trichotomy (j : ℕ) (j0 : ℕ) with hlt | heq | hgt
      · rw [TG j hj _ _ ((2 * d - j0) + j) ((2 * d - j) + j0) rfl rfl (by omega)]
        have h0 : wcHMCup (wcXbar F X) ℓ (2 * d - j) j0 ((2 * d - j) + j0) rfl
            ((E (2 * d - j)).symm (Pi.single q 1)) b' = 0 := hvanHM _ (by omega) _
        simp only [h0, map_zero]
      · have hjj : j = j0 := Fin.ext heq
        subst hjj
        rw [TG j hj _ _ (2 * d) (2 * d) (Nat.sub_add_cancel hj0) (Nat.sub_add_cancel hj0) (by omega)]
        by_cases hp : p = p0
        · subst hp
          have hq : q ≠ q0 := fun hq => hk (by rw [hq])
          have h0 : wcHMCup (wcXbar F X) ℓ (2 * d - j) j (2 * d) (Nat.sub_add_cancel hj0)
              ((E (2 * d - j)).symm (Pi.single q 1)) b' = 0 := by
            apply hηinj
            rw [hb', map_zero, AddEquiv.apply_symm_apply, Pi.single_eq_of_ne (Ne.symm hq)]
          simp only [h0, map_zero]
        · have h0 : wcHMCup (wcXbar F X) ℓ (2 * d - j) j (2 * d) (Nat.sub_add_cancel hj0)
              a' ((E j).symm (Pi.single p 1)) = 0 := by
            apply hηinj
            rw [ha', map_zero, AddEquiv.apply_symm_apply, Pi.single_eq_of_ne (Ne.symm hp)]
          simp only [h0, map_zero, AddMonoidHom.zero_apply]
      · rw [TG j hj _ _ ((2 * d - j0) + j) ((2 * d - j) + j0) rfl rfl (by omega)]
        have h0 : wcHMCup (wcXbar F X) ℓ (2 * d - j0) j ((2 * d - j0) + j) rfl
            a' ((E j).symm (Pi.single p 1)) = 0 := hvanHM _ (by omega) _
        simp only [h0, map_zero, AddMonoidHom.zero_apply]
    rw [Finset.sum_eq_single _ hoff (fun hn => absurd (Finset.mem_univ _) hn)] at key
    have hk0 : Λ (v ⟨j0, (p0, q0)⟩) =
        wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d) (by omega)
          (wcHMPull D1 (2 * d) ω) (wcHMPull D2 (2 * d) ω) := by
      rw [hv j0 p0 q0,
        TG j0 hj0 _ _ (2 * d) (2 * d) (Nat.sub_add_cancel hj0) (Nat.sub_add_cancel hj0) (by omega)]
      have e1 : wcHMCup (wcXbar F X) ℓ (2 * d - j0) j0 (2 * d) (Nat.sub_add_cancel hj0)
          a' ((E j0).symm (Pi.single p0 1)) = ω :=
        hηinj (by rw [ha', hω, AddEquiv.apply_symm_apply, Pi.single_eq_same])
      have e2 : wcHMCup (wcXbar F X) ℓ (2 * d - j0) j0 (2 * d) (Nat.sub_add_cancel hj0)
          ((E (2 * d - j0)).symm (Pi.single q0 1)) b' = ω :=
        hηinj (by rw [hb', hω, AddEquiv.apply_symm_apply, Pi.single_eq_same])
      rw [e1, e2]
    rw [hk0] at key
    have hΩ := wc_ybar_top_class_nonzero F X d ℓ hℓ D1 hD1 D2 hD2 ω hω0
    by_contra hne
    apply hΩ
    have e : wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d) (by omega)
          (wcHMPull D1 (2 * d) ω) (wcHMPull D2 (2 * d) ω) =
        wcHMScalar (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (4 * d) (c ⟨j0, (p0, q0)⟩)⁻¹
          (wcHMScalar (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (4 * d) (c ⟨j0, (p0, q0)⟩)
            (wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d) (by omega)
              (wcHMPull D1 (2 * d) ω) (wcHMPull D2 (2 * d) ω))) := by
      rw [hsc, mul_inv_cancel₀ hne, hs1]
    rw [e, key, map_zero]

  obtain ⟨R, EY, hEY, hR⟩ := wc_ybar_betti_bound F X d ℓ hℓ r E (fun j _ c x => hE j c x)
  have hcard : Fintype.card (Σ j : Fin (2 * d + 1), Fin (r j) × Fin (r (2 * d - j))) =
      ∑ j ∈ Finset.range (2 * d + 1), r j * r (2 * d - j) := by
    rw [Fintype.card_sigma]
    simp only [Fintype.card_prod, Fintype.card_fin]
    exact Fin.sum_univ_eq_sum_range (fun j => r j * r (2 * d - j)) (2 * d + 1)
  have hli : LinearIndependent ℚ_[ℓ] (fun k => EY (v k)) := by
    rw [Fintype.linearIndependent_iff]
    intro g hg
    apply hind g
    apply EY.injective
    rw [map_sum, map_zero, ← hg]
    exact Finset.sum_congr rfl (fun k _ => hEY (g k) (v k))
  have hle := hli.fintype_card_le_finrank
  rw [Module.finrank_fin_fun] at hle
  have hspan := hli.span_eq_top_of_card_eq_finrank' (by rw [Module.finrank_fin_fun]; omega)
  have hz : EY z ∈ Submodule.span ℚ_[ℓ] (Set.range (fun k => EY (v k))) := by
    rw [hspan]
    trivial
  obtain ⟨cz, hcz⟩ := (Submodule.mem_span_range_iff_exists_fun ℚ_[ℓ]).mp hz
  have hzeq : z = ∑ k, wcHMScalar (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (cz k) (v k) := by
    apply EY.injective
    rw [map_sum, ← hcz]
    exact Finset.sum_congr rfl (fun k _ => (hEY (cz k) (v k)).symm)
  rw [hzeq]
  apply AddSubgroup.sum_mem
  intro k _
  apply AddSubgroup.subset_closure
  obtain ⟨j, p, q⟩ := k
  rw [Set.mem_setOf_eq]
  exact ⟨cz ⟨j, (p, q)⟩, j, Nat.le_of_lt_succ j.isLt, (E j).symm (Pi.single p 1),
    (E (2 * d - j)).symm (Pi.single q 1), by rw [hv j p q]⟩

theorem wc_diag_class_unique (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (D1 : wcHMPullData (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)) ℓ) (hD1 : wcHMPullCanonical D1)
    (D2 : wcHMPullData (Limits.pullback.snd (wcPi2 F X) (wcPi2 F X)) ℓ) (hD2 : wcHMPullCanonical D2)
    (η : wcHM (wcXbar F X) ℓ (2 * d) →+ ℚ_[ℓ]) (hηinj : Function.Injective η)
    (hηc : ∀ (c : ℚ_[ℓ]) (x : wcHM (wcXbar F X) ℓ (2 * d)),
      η (wcHMScalar (wcXbar F X) ℓ (2 * d) c x) = c * η x)
    (ω : wcHM (wcXbar F X) ℓ (2 * d)) (hω : η ω = 1)
    (c c' : wcHM (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d))
    (hc : wcDI D1 D2 d η ω c) (hc' : wcDI D1 D2 d η ω c') : c = c' :=
by
  classical

  have hassoc : ∀ (S : Scheme.{u}) (a₁ a₂ a₃ a₁₂ a₂₃ a : ℕ) (h₁₂ : a₁ + a₂ = a₁₂)
      (h₂₃ : a₂ + a₃ = a₂₃) (h1 : a₁₂ + a₃ = a) (h2 : a₁ + a₂₃ = a)
      (x : wcHM S ℓ a₁) (y : wcHM S ℓ a₂) (z : wcHM S ℓ a₃),
      wcHMCup S ℓ a₁₂ a₃ a h1 (wcHMCup S ℓ a₁ a₂ a₁₂ h₁₂ x y) z =
        wcHMCup S ℓ a₁ a₂₃ a h2 x (wcHMCup S ℓ a₂ a₃ a₂₃ h₂₃ y z) := by
    intro S a₁ a₂ a₃ a₁₂ a₂₃ a h₁₂ h₂₃ h1 h2 x y z
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    simp only [wcHMCup, Abelian.Ext.bilinearComp_apply_apply]
    exact Abelian.Ext.comp_assoc x y z h₁₂ h₂₃ (by omega)

  have s2 : ∀ (p q r : ℕ) (h : p + q = r)
      (x : wcHM (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ p)
      (w : wcHM (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ q) (t : ℚ_[ℓ]),
      wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ p q r h x
          (wcHMScalar (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ q t w) =
        wcHMScalar (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ r t
          (wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ p q r h x w) := by
    intro p q r h x w t
    exact (hassoc (Limits.pullback (wcPi2 F X) (wcPi2 F X)) p q 0 r q r h (add_zero q)
      (add_zero r) h x w
      (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
        (wcHMConst (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ t))).symm

  have s1 : ∀ (j : ℕ) (hj : j ≤ 2 * d) (a : wcHM (wcXbar F X) ℓ j)
      (b : wcHM (wcXbar F X) ℓ (2 * d - j)),
      wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (j + 2 * d) (2 * d - j) (4 * d)
          (by omega)
        (wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ j (2 * d) (j + 2 * d) rfl
          (wcHMPull D1 j a) (c - c')) (wcHMPull D2 (2 * d - j) b) = 0 := by
    intro j hj a b
    rw [map_sub, map_sub, AddMonoidHom.sub_apply, hc j hj a b, hc' j hj a b, sub_self]

  have s4 : ∀ (j : ℕ) (hj : j ≤ 2 * d) (a : wcHM (wcXbar F X) ℓ j)
      (b : wcHM (wcXbar F X) ℓ (2 * d - j)),
      wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d) (by omega)
        (c - c')
        (wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ j (2 * d - j) (2 * d) (by omega)
          (wcHMPull D1 j a) (wcHMPull D2 (2 * d - j) b)) = 0 := by
    intro j hj a b
    have e1 := hassoc (Limits.pullback (wcPi2 F X) (wcPi2 F X)) (2 * d) j (2 * d - j) (j + 2 * d)
      (2 * d) (4 * d) (by omega) (by omega) (by omega) (by omega) (c - c') (wcHMPull D1 j a)
      (wcHMPull D2 (2 * d - j) b)
    refine e1.symm.trans ?_
    have hgc := wc_hm_graded_comm (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) j (j + 2 * d)
      (by omega) rfl (c - c') (wcHMPull D1 j a)
    have hsign : ((-1 : ℤ) ^ (2 * d * j)) = 1 := by
      rw [mul_assoc]
      exact Even.neg_one_pow (even_two_mul _)
    rw [hgc, hsign, one_zsmul]
    exact s1 j hj a b

  have s6 : ∀ z : wcHM (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d),
      wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d) (by omega)
        (c - c') z = 0 := by
    intro z
    have hz := wc_ybar_kunneth_span F X d ℓ hℓ D1 hD1 D2 hD2 z
    refine AddMonoidHom.mem_ker.mp ((AddSubgroup.closure_le
      (wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d) (by omega)
        (c - c')).ker).mpr ?_ hz)
    rintro w ⟨t, j, hj, a, b, rfl⟩
    rw [SetLike.mem_coe, AddMonoidHom.mem_ker, s2, s4 j hj a b, map_zero]

  exact sub_eq_zero.mp (wc_ybar_poincare_middle F X d ℓ hℓ (c - c') s6)

theorem wc_lefschetz_diag_trace (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (Fr : wcXbar F X ⟶ wcXbar F X) (hF : Fr ≫ wcPi2 F X = wcPi2 F X)
    (D1 : wcHMPullData (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)) ℓ) (hD1 : wcHMPullCanonical D1)
    (D2 : wcHMPullData (Limits.pullback.snd (wcPi2 F X) (wcPi2 F X)) ℓ) (hD2 : wcHMPullCanonical D2)
    (Dγ : ∀ m : ℕ, wcHMPullData (wcGraph (wcPi2 F X) Fr hF m) ℓ)
    (hDγ : ∀ m : ℕ, wcHMPullCanonical (Dγ m))
    (DF : wcHMPullData Fr ℓ) (hDF : wcHMPullCanonical DF)
    (η : wcHM (wcXbar F X) ℓ (2 * d) →+ ℚ_[ℓ]) (hηinj : Function.Injective η)
    (hηc : ∀ (c : ℚ_[ℓ]) (x : wcHM (wcXbar F X) ℓ (2 * d)),
      η (wcHMScalar (wcXbar F X) ℓ (2 * d) c x) = c * η x)
    (ω : wcHM (wcXbar F X) ℓ (2 * d)) (hω : η ω = 1)
    (hvanHM : ∀ i : ℕ, 2 * d < i → ∀ x : wcHM (wcXbar F X) ℓ i, x = 0)
    (r : ℕ → ℕ) (E : ∀ i : ℕ, wcHM (wcXbar F X) ℓ i ≃+ (Fin (r i) → ℚ_[ℓ]))
    (hE : ∀ i ≤ 2 * d, ∀ (c : ℚ_[ℓ]) (x : wcHM (wcXbar F X) ℓ i),
      E i (wcHMScalar (wcXbar F X) ℓ i c x) = c • E i x) :
    ∃ c₀ : wcHM (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d),
      wcDI D1 D2 d η ω c₀ ∧
      ∀ n : ℕ, 1 ≤ n → η (wcHMPull (Dγ n) (2 * d) c₀) =
        ∑ i ∈ Finset.Iic (2 * d), (-1) ^ i * ((wcAddEquivMatrix (E i) (wcHMPull DF i)) ^ n).trace :=
by
  classical
  have H_assoc : ∀ (S : Scheme.{u}) (a b c ab bc abc : ℕ) (hab : a + b = ab) (hbc : b + c = bc)
      (h1 : ab + c = abc) (h2 : a + bc = abc) (x : wcHM S ℓ a) (y : wcHM S ℓ b) (z : wcHM S ℓ c),
      wcHMCup S ℓ ab c abc h1 (wcHMCup S ℓ a b ab hab x y) z =
        wcHMCup S ℓ a bc abc h2 x (wcHMCup S ℓ b c bc hbc y z) := by
    intro S a b c ab bc abc hab hbc h1 h2 x y z
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    show (x.comp y hab).comp z h1 = x.comp (y.comp z hbc) h2
    exact Abelian.Ext.comp_assoc x y z hab hbc (by omega)
  have H_scR : ∀ (S : Scheme.{u}) (i j k : ℕ) (hk : i + j = k) (c : ℚ_[ℓ]) (x : wcHM S ℓ i)
      (y : wcHM S ℓ j), wcHMCup S ℓ i j k hk x (wcHMScalar S ℓ j c y) =
        wcHMScalar S ℓ k c (wcHMCup S ℓ i j k hk x y) := by
    intro S i j k hk c x y
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    show x.comp (y.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero j)) hk =
      (x.comp y hk).comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero k)
    exact (Abelian.Ext.comp_assoc x y _ hk (add_zero j) (by omega)).symm
  have H_scL : ∀ (S : Scheme.{u}) (i j k : ℕ) (hk : i + j = k) (c : ℚ_[ℓ]) (x : wcHM S ℓ i)
      (y : wcHM S ℓ j), wcHMCup S ℓ i j k hk (wcHMScalar S ℓ i c x) y =
        wcHMScalar S ℓ k c (wcHMCup S ℓ i j k hk x y) := by
    intro S i j k hk c x y
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    show (x.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero i)).comp y hk =
      (x.comp y hk).comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero k)
    rw [Abelian.Ext.comp_assoc_of_second_deg_zero, wc_hm_unit_end_central S ℓ (wcHMConst S ℓ c) j y]
    exact (Abelian.Ext.comp_assoc x y _ hk (add_zero j) (by omega)).symm
  have H_mul : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcHMPullData f ℓ) (i j k : ℕ) (hk : i + j = k)
      (x : wcHM S ℓ i) (y : wcHM S ℓ j),
      wcHMPull D k (wcHMCup S ℓ i j k hk x y) =
        wcHMCup S' ℓ i j k hk (wcHMPull D i x) (wcHMPull D j y) := by
    intro S S' f D i j k hk x y
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ (x.comp y hk)).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero k)) (zero_add k) =
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ x).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero i)) (zero_add i)).comp
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ y).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero j)) (zero_add j)) hk
    rw [Abelian.Ext.mapExactFunctor_comp]
    generalize Abelian.Ext.mapExactFunctor D.Φ x = z
    generalize Abelian.Ext.mapExactFunctor D.Φ y = w
    have e1 : (Abelian.Ext.mk₀ D.μ.hom).comp ((Abelian.Ext.mk₀ D.μ.inv).comp
        (w.comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero j)) (zero_add j)) (zero_add j) =
        w.comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero j) := by
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add j) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    rw [Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ D.μ.inv)
        (z.comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero i)) _ (zero_add i) hk (by omega),
      Abelian.Ext.comp_assoc z (Abelian.Ext.mk₀ D.μ.hom) _ (add_zero i) (zero_add j) (by omega), e1,
      Abelian.Ext.comp_assoc z w (Abelian.Ext.mk₀ D.μ.hom) hk (add_zero j) (by omega)]
  have pullScalar : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcHMPullData f ℓ),
      wcHMPullCanonical D → ∀ (n : ℕ) (c : ℚ_[ℓ]) (x : wcHM S ℓ n),
      wcHMPull D n (wcHMScalar S ℓ n c x) = wcHMScalar S' ℓ n c (wcHMPull D n x) := by
    intro S S' f D hD n c x
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    have e0 : wcHMScalar S ℓ n c x =
        wcHMCup S ℓ n 0 n (add_zero n) x (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) := rfl
    have e0' : wcHMScalar S' ℓ n c (wcHMPull D n x) =
        wcHMCup S' ℓ n 0 n (add_zero n) (wcHMPull D n x) (Abelian.Ext.mk₀ (wcHMConst S' ℓ c)) := rfl
    rw [e0, e0', H_mul]
    congr 1
    show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ
        (Abelian.Ext.mk₀ (wcHMConst S ℓ c))).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero 0))
        (zero_add 0) = Abelian.Ext.mk₀ (wcHMConst S' ℓ c)
    rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀,
      wc_hm_pull_const D hD c]
  obtain ⟨D0, hD0⟩ := wc_hm_pull_data_exists (𝟙 (wcXbar F X)) ℓ
  choose DI hDI using fun m : ℕ => wc_hm_pull_data_exists (wcIter Fr m) ℓ
  have F1 : ∀ (n m : ℕ) (x : wcHM (wcXbar F X) ℓ m),
      wcHMPull (Dγ n) m (wcHMPull D1 m x) = x := by
    intro n m x
    have hk1 : wcGraph (wcPi2 F X) Fr hF n ≫ Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) =
        𝟙 (wcXbar F X) := Limits.pullback.lift_fst _ _ _
    exact (wc_hm_pull_comp _ _ _ hk1 D1 hD1 (Dγ n) (hDγ n) D0 hD0 m x).symm.trans
      (wc_hm_pull_id _ rfl D0 hD0 m x)
  have F2 : ∀ (m k : ℕ) (x : wcHM (wcXbar F X) ℓ k),
      wcHMPull (DI m) k x = (⇑(wcHMPull DF k))^[m] x := by
    intro m
    induction m with
    | zero => intro k x; exact wc_hm_pull_id _ rfl (DI 0) (hDI 0) k x
    | succ m ih =>
      intro k x
      rw [wc_hm_pull_comp Fr (wcIter Fr m) (wcIter Fr (m + 1)) rfl DF hDF (DI m) (hDI m)
        (DI (m + 1)) (hDI (m + 1)) k x, ih, Function.iterate_succ_apply]
  have F3 : ∀ (n m : ℕ) (x : wcHM (wcXbar F X) ℓ m),
      wcHMPull (Dγ n) m (wcHMPull D2 m x) = (⇑(wcHMPull DF m))^[n] x := by
    intro n m x
    have hk2 : wcGraph (wcPi2 F X) Fr hF n ≫ Limits.pullback.snd (wcPi2 F X) (wcPi2 F X) =
        wcIter Fr n := Limits.pullback.lift_snd _ _ _
    exact (wc_hm_pull_comp _ _ _ hk2 D2 hD2 (Dγ n) (hDγ n) (DI n) (hDI n) m x).symm.trans
      (F2 n m x)
  have hW : WeaklyEtale (Limits.pullback.fst X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F)
  obtain ⟨Θ, hΘ⟩ := wc_modcoh_hm_cup_iso F X hW ℓ
  have PDl : ∀ (i : ℕ) (hi : i ≤ 2 * d) (x : wcHM (wcXbar F X) ℓ i),
      (∀ y, wcHMCup (wcXbar F X) ℓ i (2 * d - i) (2 * d) (Nat.add_sub_cancel' hi) x y = 0) →
      x = 0 := by
    intro i hi x hx
    have h0 := (wc_modcup_perfect F X d ℓ hℓ hW i hi).1 ((Θ i).symm x) (fun y' =>
      (Θ (2 * d)).injective (by rw [hΘ, map_zero, AddEquiv.apply_symm_apply]; exact hx _))
    rw [← (Θ i).apply_symm_apply x, h0, map_zero]
  have PDr : ∀ (i : ℕ) (hi : i ≤ 2 * d) (y : wcHM (wcXbar F X) ℓ (2 * d - i)),
      (∀ x, wcHMCup (wcXbar F X) ℓ i (2 * d - i) (2 * d) (Nat.add_sub_cancel' hi) x y = 0) →
      y = 0 := by
    intro i hi y hy
    have h0 := (wc_modcup_perfect F X d ℓ hℓ hW i hi).2 ((Θ (2 * d - i)).symm y) (fun x' =>
      (Θ (2 * d)).injective (by rw [hΘ, map_zero, AddEquiv.apply_symm_apply]; exact hy _))
    rw [← (Θ (2 * d - i)).apply_symm_apply y, h0, map_zero]
  have hdual : ∀ (i : ℕ) (hi : i ≤ 2 * d) (k : Fin (r i)), ∃ w : wcHM (wcXbar F X) ℓ (2 * d - i),
      ∀ x, η (wcHMCup (wcXbar F X) ℓ i (2 * d - i) (2 * d) (Nat.add_sub_cancel' hi) x w) = E i x k := by
    intro i hi k
    obtain ⟨w, hw⟩ := wc_pairing_right_dual (wcHMScalar (wcXbar F X) ℓ i)
      (wcHMScalar (wcXbar F X) ℓ (2 * d - i)) (E i) (E (2 * d - i)) (hE i hi) (hE (2 * d - i) (by omega))
      ((wcHMCup (wcXbar F X) ℓ i (2 * d - i) (2 * d) (Nat.add_sub_cancel' hi)).compr₂ η)
      (fun c x y => by rw [AddMonoidHom.compr₂_apply, AddMonoidHom.compr₂_apply, H_scL, hηc])
      (fun c x y => by rw [AddMonoidHom.compr₂_apply, AddMonoidHom.compr₂_apply, H_scR, hηc])
      (fun x hx => PDl i hi x (fun y => hηinj (by
        rw [map_zero]; have := hx y; rwa [AddMonoidHom.compr₂_apply] at this)))
      (fun y hy => PDr i hi y (fun x => hηinj (by
        rw [map_zero]; have := hy x; rwa [AddMonoidHom.compr₂_apply] at this))) k
    exact ⟨w, fun x => by have := hw x; rwa [AddMonoidHom.compr₂_apply] at this⟩
  choose α hα using hdual
  have G1 : ∀ u : wcHM (wcXbar F X) ℓ (2 * d), u = wcHMScalar (wcXbar F X) ℓ (2 * d) (η u) ω := by
    intro u
    apply hηinj
    rw [hηc, hω, mul_one]
  have G2 : ∀ (i : ℕ) (hi : i ≤ 2 * d) (x : wcHM (wcXbar F X) ℓ i),
      x = ∑ k, wcHMScalar (wcXbar F X) ℓ i (E i x k) ((E i).symm (Pi.single k 1)) := by
    intro i hi x
    apply (E i).injective
    rw [map_sum]
    simp only [hE i hi, AddEquiv.apply_symm_apply]
    ext m
    simp [Finset.sum_apply, Pi.single_apply]
  have s10 : ∀ (i : ℕ) (hi : i ≤ 2 * d) (n : ℕ) (k : Fin (r i)),
      E i ((⇑(wcHMPull DF i))^[n] ((E i).symm (Pi.single k 1))) k =
        ((wcAddEquivMatrix (E i) (wcHMPull DF i)) ^ n) k k := by
    intro i hi n k
    have hes : ∀ (c : ℚ_[ℓ]) (v : Fin (r i) → ℚ_[ℓ]),
        (E i).symm (c • v) = wcHMScalar (wcXbar F X) ℓ i c ((E i).symm v) := fun c v =>
      (E i).injective (by rw [hE i hi, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
    let LA : (Fin (r i) → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin (r i) → ℚ_[ℓ]) :=
      { toFun := fun v => E i (wcHMPull DF i ((E i).symm v))
        map_add' := fun v w => by simp only [map_add]
        map_smul' := fun c v => by
          simp only [hes, pullScalar DF hDF, hE i hi, RingHom.id_apply] }
    have hA : wcAddEquivMatrix (E i) (wcHMPull DF i) = LinearMap.toMatrix' LA := by
      ext a b
      rw [LinearMap.toMatrix'_apply]
      rfl
    have hpow : ∀ m : ℕ, (LinearMap.toMatrix' LA) ^ m = LinearMap.toMatrix' (LA ^ m) := by
      intro m
      induction m with
      | zero => rw [pow_zero, pow_zero, Module.End.one_eq_id, LinearMap.toMatrix'_id]
      | succ m ih => rw [pow_succ, ih, pow_succ, LinearMap.toMatrix'_mul]
    have happ : ∀ (m : ℕ) (v : Fin (r i) → ℚ_[ℓ]),
        (LA ^ m) v = E i ((⇑(wcHMPull DF i))^[m] ((E i).symm v)) := by
      intro m
      induction m with
      | zero => intro v; simp
      | succ m ih =>
        intro v
        rw [pow_succ, Module.End.mul_apply, ih]
        show E i ((⇑(wcHMPull DF i))^[m] ((E i).symm (E i (wcHMPull DF i ((E i).symm v))))) = _
        rw [AddEquiv.symm_apply_apply, Function.iterate_succ_apply]
    rw [hA, hpow, LinearMap.toMatrix'_apply, happ]
  have hpar : ∀ i : ℕ, i ≤ 2 * d → ((-1 : ℚ_[ℓ]) ^ ((2 * d - i) * i)) = (-1) ^ i := by
    intro i hi
    rcases Nat.even_or_odd i with he | ho
    · rw [Even.neg_one_pow he, Even.neg_one_pow (he.mul_left _)]
    · have ho2 : Odd (2 * d - i) := by
        obtain ⟨t, ht⟩ := ho
        exact ⟨d - t - 1, by omega⟩
      rw [Odd.neg_one_pow ho, Odd.neg_one_pow (ho2.mul ho)]
  obtain ⟨ct, hct⟩ : ∃ ct : ∀ i : ℕ, Fin (r i) → wcHM (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d),
      ∀ (i : ℕ) (hi : i ≤ 2 * d) (k : Fin (r i)), ct i k =
        wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d - i) i (2 * d) (Nat.sub_add_cancel hi)
          (wcHMPull D1 (2 * d - i) (α i hi k)) (wcHMPull D2 i ((E i).symm (Pi.single k 1))) :=
    ⟨fun i k => if hi : i ≤ 2 * d then
        wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d - i) i (2 * d) (Nat.sub_add_cancel hi)
          (wcHMPull D1 (2 * d - i) (α i hi k)) (wcHMPull D2 i ((E i).symm (Pi.single k 1))) else 0,
      fun i hi k => dif_pos hi⟩
  have TG : ∀ (j : ℕ) (hj : j ≤ 2 * d) (a : wcHM (wcXbar F X) ℓ j)
      (b : wcHM (wcXbar F X) ℓ (2 * d - j)) (i : ℕ) (hi : i ≤ 2 * d)
      (a' : wcHM (wcXbar F X) ℓ (2 * d - i)) (e : wcHM (wcXbar F X) ℓ i) (m1 m2 : ℕ)
      (h1 : j + (2 * d - i) = m1) (h2 : i + (2 * d - j) = m2) (h3 : m1 + m2 = 4 * d),
      wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (j + 2 * d) (2 * d - j) (4 * d) (by omega)
        (wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ j (2 * d) (j + 2 * d) rfl
          (wcHMPull D1 j a)
          (wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d - i) i (2 * d)
            (Nat.sub_add_cancel hi) (wcHMPull D1 (2 * d - i) a') (wcHMPull D2 i e)))
        (wcHMPull D2 (2 * d - j) b) =
      wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ m1 m2 (4 * d) h3
        (wcHMPull D1 m1 (wcHMCup (wcXbar F X) ℓ j (2 * d - i) m1 h1 a a'))
        (wcHMPull D2 m2 (wcHMCup (wcXbar F X) ℓ i (2 * d - j) m2 h2 e b)) := by
    intro j hj a b i hi a' e m1 m2 h1 h2 h3
    rw [H_mul D1, H_mul D2,
      ← H_assoc _ j (2 * d - i) i m1 (2 * d) (j + 2 * d) h1 (Nat.sub_add_cancel hi) (by omega) rfl,
      H_assoc _ m1 i (2 * d - j) (j + 2 * d) m2 (4 * d) (by omega) h2 (by omega) h3]
  refine ⟨∑ i ∈ Finset.Iic (2 * d), ∑ k, ct i k, ?_, ?_⟩
  · intro j hj a b
    simp only [map_sum, AddMonoidHom.finset_sum_apply]
    rw [Finset.sum_eq_single_of_mem j (Finset.mem_Iic.mpr hj)]
    · have hk' : ∀ k : Fin (r j), wcHMCup (wcXbar F X) ℓ j (2 * d - j) (2 * d) (by omega) a (α j hj k) =
          wcHMScalar (wcXbar F X) ℓ (2 * d) (E j a k) ω := by
        intro k
        apply hηinj
        rw [hηc, hω, mul_one, hα]
      have hterm : ∀ k : Fin (r j),
          wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (j + 2 * d) (2 * d - j) (4 * d) (by omega)
            (wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ j (2 * d) (j + 2 * d) rfl
              (wcHMPull D1 j a) (ct j k)) (wcHMPull D2 (2 * d - j) b) =
          wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d) (by omega)
            (wcHMPull D1 (2 * d) ω)
            (wcHMPull D2 (2 * d) (wcHMCup (wcXbar F X) ℓ j (2 * d - j) (2 * d) (by omega)
              (wcHMScalar (wcXbar F X) ℓ j (E j a k) ((E j).symm (Pi.single k 1))) b)) := by
        intro k
        rw [hct j hj k, TG j hj a b j hj (α j hj k) ((E j).symm (Pi.single k 1)) (2 * d) (2 * d)
          (by omega) (by omega) (by omega), hk' k, pullScalar D1 hD1, H_scL, ← H_scR,
          ← pullScalar D2 hD2, ← H_scL]
      simp only [hterm]
      rw [← map_sum, ← map_sum, ← AddMonoidHom.finset_sum_apply, ← map_sum, ← G2 j hj a,
        G1 (wcHMCup (wcXbar F X) ℓ j (2 * d - j) (2 * d) _ a b), pullScalar D2 hD2, H_scR,
        hηc, hω, mul_one]
    · intro i hi hij
      have hi' := Finset.mem_Iic.mp hi
      apply Finset.sum_eq_zero
      intro k _
      rw [hct i hi' k, TG j hj a b i hi' (α i hi' k) ((E i).symm (Pi.single k 1))
        (j + (2 * d - i)) (i + (2 * d - j)) rfl rfl (by omega)]
      rcases Nat.lt_or_gt_of_ne hij with hlt | hgt
      · rw [hvanHM (j + (2 * d - i)) (by omega)
          (wcHMCup (wcXbar F X) ℓ j (2 * d - i) (j + (2 * d - i)) rfl a (α i hi' k)),
          map_zero, map_zero, AddMonoidHom.zero_apply]
      · rw [hvanHM (i + (2 * d - j)) (by omega)
          (wcHMCup (wcXbar F X) ℓ i (2 * d - j) (i + (2 * d - j)) rfl ((E i).symm (Pi.single k 1)) b),
          map_zero, map_zero]
  · intro n hn
    rw [map_sum, map_sum]
    refine Finset.sum_congr rfl (fun i hi => ?_)
    have hi' := Finset.mem_Iic.mp hi
    rw [map_sum, map_sum, Matrix.trace, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [hct i hi' k, H_mul (Dγ n), F1, F3,
      wc_hm_graded_comm (wcXbar F X) ℓ (2 * d - i) i (2 * d) (Nat.sub_add_cancel hi')
        (Nat.add_sub_cancel' hi'),
      map_zsmul, hα i hi' k, s10 i hi' n k, zsmul_eq_mul, Int.cast_pow, Int.cast_neg, Int.cast_one,
      hpar i hi']
    rfl

theorem wc_frob_fix_scheme_etale (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (φ : wcXbar F X ⟶ wcXbar F X) (hφ : wcIsAbsFrob φ (Nat.card F))
    (hF : (wcGeomFrobX F X h ≫ φ) ≫ wcPi2 F X = wcPi2 F X) :
    ∀ n : ℕ, 1 ≤ n →
      Etale (Limits.pullback.fst (wcGraph (wcPi2 F X) (wcGeomFrobX F X h ≫ φ) hF n)
        (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X) :=
by
  intro n hn
  have key : ∀ {K : Type u} [Field K] {Y : Scheme.{u}} (π : Y ⟶ Spec (.of K))
      [IsSeparated π] [LocallyOfFiniteType π] (Fr : Y ⟶ Y) (hF : Fr ≫ π = π) (k φ : Y ⟶ Y)
      (q : ℕ), wcIsAbsFrob φ q → (q : K) = 0 → ∀ n : ℕ, wcIter Fr n = k ≫ φ →
      Etale (Limits.pullback.fst (wcGraph π Fr hF n) (Limits.pullback.diagonal π) ≫ π) := by

    have s2 : ∀ {K A W B : Type u} [CommRing K] [CommRing A] [CommRing W] [CommRing B]
        [Algebra K B] [Algebra A W] (f : A) [IsLocalization.Away f W] (θ : A →+* W) (ι : W →+* B),
        Function.Surjective ι → ∀ (q : ℕ), (q : B) = 0 →
        (∀ a : A, ι (algebraMap A W a) = ι (θ a)) → (∀ a : A, ∃ b : W, θ a = b ^ q) →
        Subsingleton Ω[B⁄K] := by
      intro K A W B _ _ _ _ _ _ f _ θ ι hι q hq hfix hpow
      have ha : ∀ a : A, KaehlerDifferential.D K B (ι (algebraMap A W a)) = 0 := by
        intro a
        obtain ⟨b, hb⟩ := hpow a
        rw [hfix a, hb, map_pow, Derivation.leibniz_pow, ← Nat.cast_smul_eq_nsmul B, hq, zero_smul]
      have hw : ∀ w : W, KaehlerDifferential.D K B (ι w) = 0 := by
        intro w
        obtain ⟨⟨a, s⟩, hs⟩ := IsLocalization.surj (Submonoid.powers f) w
        have h1 := congrArg (fun x => KaehlerDifferential.D K B (ι x)) hs
        simp only [map_mul, Derivation.leibniz, ha, smul_zero, zero_add] at h1
        have hu : IsUnit (ι (algebraMap A W s)) := (IsLocalization.map_units W s).map ι
        exact (hu.smul_left_cancel).mp (by rw [h1, smul_zero])
      have hall : ∀ b : B, KaehlerDifferential.D K B b = 0 := fun b => by
        obtain ⟨w, rfl⟩ := hι b
        exact hw w
      have htop := KaehlerDifferential.span_range_derivation K B
      have hbot : Submodule.span B (Set.range (KaehlerDifferential.D K B)) = ⊥ := by
        rw [Submodule.span_eq_bot]
        rintro _ ⟨b, rfl⟩
        exact hall b
      rw [hbot] at htop
      refine ⟨fun x y => ?_⟩
      have hx : x ∈ (⊥ : Submodule B Ω[B⁄K]) := htop ▸ Submodule.mem_top
      have hy : y ∈ (⊥ : Submodule B Ω[B⁄K]) := htop ▸ Submodule.mem_top
      rw [Submodule.mem_bot] at hx hy
      rw [hx, hy]

    have s3 : ∀ {K : Type u} [Field K] {Z : Scheme.{u}} (p : Z ⟶ Spec (.of K))
        [LocallyOfFiniteType p],
        (∀ z : Z, ∃ (V : Z.Opens) (_ : IsAffineOpen V), z ∈ V ∧
          letI : Algebra K Γ(Z, V) :=
            ((p.appLE ⊤ V (le_top.trans_eq (Scheme.Hom.preimage_top p).symm)).hom.comp
              (Scheme.ΓSpecIso (.of K)).inv.hom).toAlgebra
          Subsingleton Ω[Γ(Z, V)⁄K]) → Etale p := by
      intro K _ Z p _ H
      rw [HasRingHomProperty.iff_exists_appLE (P := @Etale) (Q := RingHom.Etale)
        (RingHom.StableUnderComposition.stableUnderCompositionWithLocalizationAway
          RingHom.Etale.stableUnderComposition (RingHom.PropertyIsLocal.HoldsForLocalizationAway
            RingHom.Etale.propertyIsLocal RingHom.Etale.containsIdentities)).1]
      intro z
      obtain ⟨V, hV, hz, hΩ⟩ := H z
      refine ⟨⟨⊤, isAffineOpen_top _⟩, ⟨V, hV⟩, hz,
        le_top.trans_eq (Scheme.Hom.preimage_top p).symm, ?_⟩
      letI : Algebra K Γ(Z, V) :=
        ((p.appLE ⊤ V (le_top.trans_eq (Scheme.Hom.preimage_top p).symm)).hom.comp
          (Scheme.ΓSpecIso (.of K)).inv.hom).toAlgebra
      have hft : RingHom.FiniteType
          ((p.appLE ⊤ V (le_top.trans_eq (Scheme.Hom.preimage_top p).symm)).hom.comp
            (Scheme.ΓSpecIso (.of K)).inv.hom) :=
        RingHom.FiniteType.comp
          (HasRingHomProperty.appLE @LocallyOfFiniteType p ‹_› ⟨⊤, isAffineOpen_top _⟩ ⟨V, hV⟩ _)
          (RingHom.FiniteType.of_surjective _
            (Scheme.ΓSpecIso (.of K)).commRingCatIsoToRingEquiv.symm.surjective)
      have : Algebra.FiniteType K Γ(Z, V) := hft
      have : Algebra.FinitePresentation K Γ(Z, V) := Algebra.FinitePresentation.of_finiteType.mp this
      have : Algebra.FormallyUnramified K Γ(Z, V) := Algebra.FormallyUnramified.mk hΩ
      have hψ : RingHom.Etale
          ((p.appLE ⊤ V (le_top.trans_eq (Scheme.Hom.preimage_top p).symm)).hom.comp
            (Scheme.ΓSpecIso (.of K)).inv.hom) :=
        (Algebra.Etale.of_formallyUnramified_of_flat : Algebra.Etale K Γ(Z, V))
      have h2 := RingHom.Etale.respectsIso.2 _
        (Scheme.ΓSpecIso (.of K)).commRingCatIsoToRingEquiv hψ
      convert h2 using 1
      ext x
      exact congrArg
        (fun y => (p.appLE ⊤ V (le_top.trans_eq (Scheme.Hom.preimage_top p).symm)).hom y)
        (Iso.hom_inv_id_apply (Scheme.ΓSpecIso (.of K)) x).symm

    have s4 : ∀ {Y : Scheme.{u}} (φ k : Y ⟶ Y) (q : ℕ), wcIsAbsFrob φ q →
        ∀ (U W : Y.Opens) (hW : W ≤ (k ≫ φ) ⁻¹ᵁ U) (a : Γ(Y, U)),
        ∃ b : Γ(Y, W), ((k ≫ φ).appLE U W hW).hom a = b ^ q := by
      intro Y φ k q hφ U W hW a
      have hφU : U ≤ φ ⁻¹ᵁ U := fun y hy =>
        (Scheme.Hom.mem_preimage φ).mpr (by rw [hφ.1 y]; exact hy)
      have e₂ : W ≤ k ⁻¹ᵁ U := fun y hy => by
        have h1 := (Scheme.Hom.mem_preimage _).mp (hW hy)
        rw [Scheme.Hom.comp_apply, hφ.1] at h1
        exact (Scheme.Hom.mem_preimage k).mpr h1
      refine ⟨(k.appLE U W e₂).hom a, ?_⟩
      have e := Scheme.Hom.appLE_comp_appLE k φ U U W hφU e₂
      rw [← e, CommRingCat.hom_comp, RingHom.comp_apply, hφ.2 U hφU a, map_pow]
    have hcongr : ∀ {A B : Scheme.{u}} (f₁ f₂ : A ⟶ B) (_ : f₁ = f₂) (U : B.Opens) (V : A.Opens)
        (e₁ : V ≤ f₁ ⁻¹ᵁ U) (e₂ : V ≤ f₂ ⁻¹ᵁ U), f₁.appLE U V e₁ = f₂.appLE U V e₂ := by
      intro A B f₁ f₂ hf U V e₁ e₂
      subst hf
      rfl
    intro K _ Y π _ _ Fr hF k φ q hφ hq n hk
    have hγ1 : wcGraph π Fr hF n ≫ Limits.pullback.fst π π = 𝟙 _ := by
      unfold wcGraph; exact Limits.pullback.lift_fst _ _ _
    have hγ2 : wcGraph π Fr hF n ≫ Limits.pullback.snd π π = wcIter Fr n := by
      unfold wcGraph; exact Limits.pullback.lift_snd _ _ _

    have s1 : Limits.pullback.fst (wcGraph π Fr hF n) (Limits.pullback.diagonal π) ≫
        wcIter Fr n = Limits.pullback.fst (wcGraph π Fr hF n) (Limits.pullback.diagonal π) := by
      have c := Limits.pullback.condition (f := wcGraph π Fr hF n)
        (g := Limits.pullback.diagonal π)
      have c1 := congrArg (· ≫ Limits.pullback.fst π π) c
      have c2 := congrArg (· ≫ Limits.pullback.snd π π) c
      simp only [Category.assoc, hγ1, hγ2, Limits.pullback.diagonal_fst,
        Limits.pullback.diagonal_snd, Category.comp_id] at c1 c2
      rw [c2, c1]
    rw [hk] at s1
    have : IsClosedImmersion (Limits.pullback.diagonal π) :=
      IsSeparated.isClosedImmersion_diagonal
    have : IsClosedImmersion
        (Limits.pullback.fst (wcGraph π Fr hF n) (Limits.pullback.diagonal π)) :=
      inferInstance
    set i := Limits.pullback.fst (wcGraph π Fr hF n) (Limits.pullback.diagonal π) with hi
    refine s3 (i ≫ π) (fun z => ?_)
    obtain ⟨U, hU, hxU, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens Y)) (show i z ∈ (⊤ : Y.Opens) from trivial)
    have hU' : IsAffineOpen U := hU
    have hx' : i z ∈ (k ≫ φ) ⁻¹ᵁ U := by
      have e : (i ≫ k ≫ φ) z = i z := by rw [s1]
      rw [Scheme.Hom.comp_apply] at e
      exact (Scheme.Hom.mem_preimage _).mpr (by rw [e]; exact hxU)
    obtain ⟨f, hfW, hxW⟩ := hU'.exists_basicOpen_le (V := U ⊓ (k ≫ φ) ⁻¹ᵁ U)
      ⟨i z, TopologicalSpace.Opens.mem_inf.mpr ⟨hxU, hx'⟩⟩ hxU
    have hWU : Y.basicOpen f ≤ U := Y.basicOpen_le f
    have hWh : Y.basicOpen f ≤ (k ≫ φ) ⁻¹ᵁ U := hfW.trans inf_le_right
    have hWaff : IsAffineOpen (Y.basicOpen f) := hU'.basicOpen f
    refine ⟨i ⁻¹ᵁ Y.basicOpen f, IsAffineHom.isAffine_preimage _ hWaff,
      (Scheme.Hom.mem_preimage i).mpr hxW, ?_⟩
    letI : Algebra K Γ(Limits.pullback (wcGraph π Fr hF n) (Limits.pullback.diagonal π),
        i ⁻¹ᵁ Y.basicOpen f) :=
      (((i ≫ π).appLE ⊤ (i ⁻¹ᵁ Y.basicOpen f)
        (le_top.trans_eq (Scheme.Hom.preimage_top (i ≫ π)).symm)).hom.comp
        (Scheme.ΓSpecIso (.of K)).inv.hom).toAlgebra
    letI : Algebra Γ(Y, U) Γ(Y, Y.basicOpen f) := Scheme.algebra_section_section_basicOpen f
    have : IsLocalization.Away f Γ(Y, Y.basicOpen f) := hU'.isLocalization_basicOpen f
    refine s2 f ((k ≫ φ).appLE U (Y.basicOpen f) hWh).hom
      (i.appLE (Y.basicOpen f) (i ⁻¹ᵁ Y.basicOpen f) le_rfl).hom ?_ q ?_ ?_ ?_
    · have hs := Scheme.Hom.app_surjective i (Y.basicOpen f) hWaff
      rwa [Scheme.Hom.app_eq_appLE] at hs
    · rw [← map_natCast (algebraMap K Γ(Limits.pullback (wcGraph π Fr hF n)
        (Limits.pullback.diagonal π), i ⁻¹ᵁ Y.basicOpen f)) q, hq, map_zero]
    · intro a
      show (Y.presheaf.map (homOfLE hWU).op ≫
          i.appLE (Y.basicOpen f) (i ⁻¹ᵁ Y.basicOpen f) le_rfl).hom a =
        ((k ≫ φ).appLE U (Y.basicOpen f) hWh ≫
          i.appLE (Y.basicOpen f) (i ⁻¹ᵁ Y.basicOpen f) le_rfl).hom a
      rw [Scheme.Hom.map_appLE, Scheme.Hom.appLE_comp_appLE]
      exact congrArg (fun φ' => CommRingCat.Hom.hom φ' a)
        (hcongr i (i ≫ k ≫ φ) s1.symm U (i ⁻¹ᵁ Y.basicOpen f) _ _)
    · intro a
      exact s4 φ k q hφ U (Y.basicOpen f) hWh a
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  have hq : (Nat.card F : AlgebraicClosure F) = 0 := by
    letI := Fintype.ofFinite F
    rw [← map_natCast (algebraMap F (AlgebraicClosure F)), Nat.card_eq_fintype_card,
      FiniteField.cast_card_eq_zero, map_zero]
  exact key (wcPi2 F X) _ hF (wcIter (wcGeomFrobX F X h ≫ φ) m ≫ wcGeomFrobX F X h) φ
    (Nat.card F) hφ hq (m + 1) (by rw [Category.assoc]; rfl)

theorem wc_frob_fix_scheme_points (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (φ : wcXbar F X ⟶ wcXbar F X) (hφ : wcIsAbsFrob φ (Nat.card F))
    (hF : (wcGeomFrobX F X h ≫ φ) ≫ wcPi2 F X = wcPi2 F X) :
    ∀ n : ℕ,
      Nat.card {z : Spec (.of (AlgebraicClosure F)) ⟶
          Limits.pullback (wcGraph (wcPi2 F X) (wcGeomFrobX F X h ≫ φ) hF n)
            (Limits.pullback.diagonal (wcPi2 F X)) //
        z ≫ Limits.pullback.fst (wcGraph (wcPi2 F X) (wcGeomFrobX F X h ≫ φ) hF n)
            (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X = 𝟙 _} =
      Nat.card {x : Over.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F (AlgebraicClosure F)) ⟶ X //
          Spec.map (CommRingCat.ofHom
            (((@FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F)
                (AlgebraicClosure F) _ _ _) ^ n :
                AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) : AlgebraicClosure F →+* AlgebraicClosure F))
            ≫ x.left = x.left} :=
by
  classical

  have hnatK : ∀ {Y : Scheme.{u}} (φ' : Y ⟶ Y) (q : ℕ), wcIsAbsFrob φ' q →
      ∀ (K : Type u) [Field K] (τ : K →+* K), (∀ a : K, τ a = a ^ q) →
      ∀ y : Spec (CommRingCat.of K) ⟶ Y,
        y ≫ φ' = Spec.map (CommRingCat.ofHom τ) ≫ y := by
    intro Y φ' q hφ' K _ τ hτ y
    have hall : ∀ t t' : ↥(Spec (CommRingCat.of K)), t = t' := fun t t' => Subsingleton.elim t t'
    obtain ⟨W, hW, hxW, -⟩ := exists_isAffineOpen_mem_and_subset
      (x := y (default : ↥(Spec (CommRingCat.of K)))) (U := ⊤) (by simp)
    have eW : W ≤ φ' ⁻¹ᵁ W := by
      intro x hx
      rw [Scheme.Hom.mem_preimage, hφ'.1]
      exact hx
    have e1 : (⊤ : (Spec (CommRingCat.of K)).Opens) ≤ y ⁻¹ᵁ W := by
      intro t _
      rw [Scheme.Hom.mem_preimage, hall t default]
      exact hxW
    have e2 : (⊤ : (Spec (CommRingCat.of K)).Opens) ≤ (y ≫ φ') ⁻¹ᵁ W := by
      intro t _
      rw [Scheme.Hom.mem_preimage, Scheme.Hom.comp_apply, hφ'.1, hall t default]
      exact hxW
    have e3 : (⊤ : (Spec (CommRingCat.of K)).Opens) ≤
        (Spec.map (CommRingCat.ofHom τ) ≫ y) ⁻¹ᵁ W := by
      intro t _
      rw [Scheme.Hom.mem_preimage, Scheme.Hom.comp_apply,
        hall (Spec.map (CommRingCat.ofHom τ) t) default]
      exact hxW
    have e4 : (⊤ : (Spec (CommRingCat.of K)).Opens) ≤
        (Spec.map (CommRingCat.ofHom τ)) ⁻¹ᵁ ⊤ := by
      intro t _
      rw [Scheme.Hom.mem_preimage]
      trivial
    have cancel : ∀ (f₁ f₂ : Spec (CommRingCat.of K) ⟶ Y)
        (a₁ : (⊤ : (Spec (CommRingCat.of K)).Opens) ≤ f₁ ⁻¹ᵁ W)
        (a₂ : (⊤ : (Spec (CommRingCat.of K)).Opens) ≤ f₂ ⁻¹ᵁ W),
        f₁.appLE W ⊤ a₁ = f₂.appLE W ⊤ a₂ → f₁ = f₂ := by
      intro f₁ f₂ a₁ a₂ hh
      have h1 := IsAffineOpen.SpecMap_appLE_fromSpec f₁ hW
        (isAffineOpen_top (Spec (CommRingCat.of K))) a₁
      have h2 := IsAffineOpen.SpecMap_appLE_fromSpec f₂ hW
        (isAffineOpen_top (Spec (CommRingCat.of K))) a₂
      rw [hh, h2, IsAffineOpen.fromSpec_top] at h1
      exact ((Iso.cancel_iso_inv_left _ _ _).mp h1).symm
    have hA : (Spec.map (CommRingCat.ofHom τ)).appLE ⊤ ⊤ e4 =
        (Spec.map (CommRingCat.ofHom τ)).appTop :=
      (Scheme.Hom.app_eq_appLE _).symm
    have hS : ∀ u, ((Spec.map (CommRingCat.ofHom τ)).appLE ⊤ ⊤ e4).hom u = u ^ q := by
      intro u
      rw [hA]
      obtain ⟨a, rfl⟩ : ∃ a, (Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom a = u :=
        ⟨(Scheme.ΓSpecIso (CommRingCat.of K)).hom.hom u, by simp⟩
      have hn := congrArg (fun f => f.hom a)
        (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom τ))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at hn
      rw [← hn, hτ, map_pow]
    apply cancel (y ≫ φ') (Spec.map (CommRingCat.ofHom τ) ≫ y) e2 e3
    rw [← Scheme.Hom.appLE_comp_appLE y φ' W W ⊤ eW e1,
      ← Scheme.Hom.appLE_comp_appLE (Spec.map (CommRingCat.ofHom τ)) y W ⊤ ⊤ e1 e4]
    ext s
    simp only [CommRingCat.hom_comp, RingHom.comp_apply]
    rw [hφ'.2 W eW s, map_pow, hS]

  have L2 : ∀ {Y B : Scheme.{u}} (π : Y ⟶ B) (G : Y ⟶ Y) (γ : Y ⟶ Limits.pullback π π)
      (g1 : γ ≫ Limits.pullback.fst π π = 𝟙 Y) (g2 : γ ≫ Limits.pullback.snd π π = G),
      Nat.card {z : B ⟶ Limits.pullback γ (Limits.pullback.diagonal π) //
          z ≫ Limits.pullback.fst γ (Limits.pullback.diagonal π) ≫ π = 𝟙 _} =
        Nat.card {y : B ⟶ Y // y ≫ π = 𝟙 _ ∧ y ≫ G = y} := by
    intro Y B π G γ g1 g2
    have key : ∀ z : B ⟶ Limits.pullback γ (Limits.pullback.diagonal π),
        z ≫ Limits.pullback.fst γ (Limits.pullback.diagonal π) =
          z ≫ Limits.pullback.snd γ (Limits.pullback.diagonal π) ∧
        (z ≫ Limits.pullback.fst γ (Limits.pullback.diagonal π)) ≫ G =
          z ≫ Limits.pullback.fst γ (Limits.pullback.diagonal π) := by
      intro z
      have hc : (z ≫ Limits.pullback.fst γ (Limits.pullback.diagonal π)) ≫ γ =
          (z ≫ Limits.pullback.snd γ (Limits.pullback.diagonal π)) ≫
            Limits.pullback.diagonal π := by
        rw [Category.assoc, Limits.pullback.condition, Category.assoc]
      have h1 := congrArg (fun k => k ≫ Limits.pullback.fst π π) hc
      have h2 := congrArg (fun k => k ≫ Limits.pullback.snd π π) hc
      simp only [Category.assoc, g1, g2, Limits.pullback.diagonal_fst,
        Limits.pullback.diagonal_snd, Category.comp_id] at h1 h2
      exact ⟨h1, by rw [Category.assoc, h2, h1]⟩
    exact Nat.card_congr
      { toFun := fun z => ⟨z.1 ≫ Limits.pullback.fst γ (Limits.pullback.diagonal π),
          by rw [Category.assoc]; exact z.2, (key z.1).2⟩
        invFun := fun y => ⟨Limits.pullback.lift y.1 y.1 (by
            apply Limits.pullback.hom_ext
            · rw [Category.assoc, Category.assoc, g1, Limits.pullback.diagonal_fst]
            · rw [Category.assoc, Category.assoc, g2, Limits.pullback.diagonal_snd,
                Category.comp_id, y.2.2]),
          by rw [Limits.pullback.lift_fst_assoc]; exact y.2.1⟩
        left_inv := fun z => by
          apply Subtype.ext
          apply Limits.pullback.hom_ext
          · exact Limits.pullback.lift_fst _ _ _
          · rw [Limits.pullback.lift_snd]; exact (key z.1).1
        right_inv := fun y => by
          apply Subtype.ext
          exact Limits.pullback.lift_fst _ _ _ }

  have L3 : ∀ (σ : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) (Fr : wcXbar F X ⟶ wcXbar F X)
      (hFr : Fr ≫ wcPi2 F X = wcPi2 F X)
      (hFr1 : ∀ y : Spec (.of (AlgebraicClosure F)) ⟶ wcXbar F X,
        y ≫ Fr ≫ Limits.pullback.fst X.hom
            (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
          Spec.map (CommRingCat.ofHom (σ : AlgebraicClosure F →+* AlgebraicClosure F)) ≫ y ≫
            Limits.pullback.fst X.hom
              (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) (n : ℕ),
      Nat.card {y : Spec (.of (AlgebraicClosure F)) ⟶ wcXbar F X //
          y ≫ wcPi2 F X = 𝟙 _ ∧ y ≫ wcIter Fr n = y} =
      Nat.card {x : Over.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F (AlgebraicClosure F)) ⟶ X //
          Spec.map (CommRingCat.ofHom ((σ ^ n : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) :
            AlgebraicClosure F →+* AlgebraicClosure F)) ≫ x.left = x.left} := by
    intro σ Fr hFr hFr1 n
    have I1 : ∀ m : ℕ, wcIter Fr m ≫ wcPi2 F X = wcPi2 F X := by
      intro m
      induction m with
      | zero => exact Category.id_comp _
      | succ m ih =>
        show (wcIter Fr m ≫ Fr) ≫ wcPi2 F X = wcPi2 F X
        rw [Category.assoc, hFr, ih]
    have I2 : ∀ (m : ℕ) (y : Spec (.of (AlgebraicClosure F)) ⟶ wcXbar F X),
        y ≫ wcIter Fr m ≫ Limits.pullback.fst X.hom
            (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
          Spec.map (CommRingCat.ofHom ((σ ^ m : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) :
            AlgebraicClosure F →+* AlgebraicClosure F)) ≫ y ≫
            Limits.pullback.fst X.hom
              (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) := by
      intro m
      induction m with
      | zero =>
        intro y
        have e0 : ((σ ^ 0 : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) :
            AlgebraicClosure F →+* AlgebraicClosure F) = RingHom.id _ := by
          apply RingHom.ext
          intro a
          show (σ ^ 0) a = a
          rw [pow_zero]
          rfl
        rw [e0, CommRingCat.ofHom_id, Spec.map_id, Category.id_comp]
        show y ≫ 𝟙 _ ≫ _ = _
        rw [Category.id_comp]
      | succ m ih =>
        intro y
        have e : ((σ ^ (m + 1) : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) :
            AlgebraicClosure F →+* AlgebraicClosure F) =
            (σ : AlgebraicClosure F →+* AlgebraicClosure F).comp
              ((σ ^ m : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) :
                AlgebraicClosure F →+* AlgebraicClosure F) := by
          apply RingHom.ext
          intro a
          show (σ ^ (m + 1)) a = σ ((σ ^ m) a)
          rw [pow_succ']
          rfl
        show y ≫ (wcIter Fr m ≫ Fr) ≫ _ = _
        rw [Category.assoc, ← Category.assoc y, hFr1 (y ≫ wcIter Fr m), Category.assoc, ih, e,
          CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc]
    exact Nat.card_congr
      { toFun := fun y => ⟨Over.homMk (y.1 ≫ Limits.pullback.fst _ _) (by
            rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, y.2.1]
            exact Category.id_comp _), by
            show Spec.map _ ≫ (y.1 ≫ Limits.pullback.fst _ _) = y.1 ≫ Limits.pullback.fst _ _
            rw [← I2 n y.1, ← Category.assoc, y.2.2]⟩
        invFun := fun x => ⟨Limits.pullback.lift x.1.left (𝟙 _) (by
            rw [Category.id_comp]; exact Over.w x.1), Limits.pullback.lift_snd _ _ _, by
            apply Limits.pullback.hom_ext
            · rw [Category.assoc, I2 n, Limits.pullback.lift_fst, x.2]
            · rw [Category.assoc, I1 n]⟩
        left_inv := fun y => by
          apply Subtype.ext
          apply Limits.pullback.hom_ext
          · exact Limits.pullback.lift_fst _ _ _
          · rw [Limits.pullback.lift_snd]; exact y.2.1.symm
        right_inv := fun x => by
          apply Subtype.ext
          apply Over.OverMorphism.ext
          exact Limits.pullback.lift_fst _ _ _ }

  have hτ : ∀ a : AlgebraicClosure F,
      ((@FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F)
        (AlgebraicClosure F) _ _ _ : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) :
          AlgebraicClosure F →+* AlgebraicClosure F) a = a ^ Nat.card F := by
    intro a
    show (@FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F)
        (AlgebraicClosure F) _ _ _) a = _
    rw [FiniteField.frobeniusAlgEquivOfAlgebraic_apply, Fintype.card_eq_nat_card]
  have hg : wcGeomFrobX F X h ≫ Limits.pullback.fst X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
      Limits.pullback.fst X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) :=
    MorphismProperty.Over.w (wcGeomFrob F X h)
  have hFr1 : ∀ y : Spec (.of (AlgebraicClosure F)) ⟶ wcXbar F X,
      y ≫ (wcGeomFrobX F X h ≫ φ) ≫ Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
        Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F _
          (Fintype.ofFinite F) (AlgebraicClosure F) _ _ _ :
            AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) :
              AlgebraicClosure F →+* AlgebraicClosure F)) ≫ y ≫
          Limits.pullback.fst X.hom
            (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) := by
    intro y
    rw [← Category.assoc, ← Category.assoc,
      hnatK φ (Nat.card F) hφ (AlgebraicClosure F) _ hτ (y ≫ wcGeomFrobX F X h),
      Category.assoc, Category.assoc, hg]
  intro n
  have g1 : wcGraph (wcPi2 F X) (wcGeomFrobX F X h ≫ φ) hF n ≫
      Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) = 𝟙 _ := by
    unfold wcGraph
    exact Limits.pullback.lift_fst _ _ _
  have g2 : wcGraph (wcPi2 F X) (wcGeomFrobX F X h ≫ φ) hF n ≫
      Limits.pullback.snd (wcPi2 F X) (wcPi2 F X) = wcIter (wcGeomFrobX F X h ≫ φ) n := by
    unfold wcGraph
    exact Limits.pullback.lift_snd _ _ _
  exact (L2 (wcPi2 F X) (wcIter (wcGeomFrobX F X h ≫ φ) n) _ g1 g2).trans
    (L3 _ (wcGeomFrobX F X h ≫ φ) hF hFr1 n)

theorem wc_closed_supp_base_change_noeth {X Y Y' : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (i : X ⟶ Y) [IsClosedImmersion i] (f : Y' ⟶ Y) [IsLocallyNoetherian Y']
    (D : wcHMPullData i ℓ) (hD : wcHMPullCanonical D)
    (Df : wcHMPullData f ℓ) (hDf : wcHMPullCanonical Df) :
    ∃ (Di : wcHMPullData (Limits.pullback.fst f i) ℓ) (_ : wcHMPullCanonical Di)
      (γ : wcSuppObj Di ⟶ Df.Φ.obj (wcSuppObj D)),
      wcSuppUnitMap Di ≫ γ = Df.μ.inv ≫ Df.Φ.map (wcSuppUnitMap D) ∧
      Epi (wcSuppUnitMap Di) :=
by
  obtain ⟨Di, hDi⟩ := wc_hm_pull_data_exists (Limits.pullback.fst f i) ℓ
  haveI hE : Epi (wcSuppUnitMap Di) :=
    wc_supp_unit_epi_of_noetherian (Limits.pullback.fst f i) ℓ Di hDi
  have hK := wc_supp_kernel_kill_of_noetherian i f (Limits.pullback.fst f i)
    (Limits.pullback.snd f i) (IsPullback.of_hasPullback f i) ℓ D hD Di hDi Df hDf
  exact ⟨Di, hDi, Abelian.epiDesc (wcSuppUnitMap Di) (Df.μ.inv ≫ Df.Φ.map (wcSuppUnitMap D)) hK,
    Abelian.comp_epiDesc _ _ _, hE⟩

theorem wc_closed_etale_points_decomp (F : Type u) [Finite F] [Field F]
    (X : Over (Spec (.of F))) [IsProper X.hom]
    {Z : Scheme.{u}} (a : Z ⟶ wcXbar F X) [IsClosedImmersion a] (ha : Etale (a ≫ wcPi2 F X))
    (m : ℕ)
    (hm : Nat.card {z : Spec (.of (AlgebraicClosure F)) ⟶ Z // z ≫ a ≫ wcPi2 F X = 𝟙 _} = m) :
    ∃ z : Fin m → (Spec (.of (AlgebraicClosure F)) ⟶ Z),
      (∀ k, z k ≫ a ≫ wcPi2 F X = 𝟙 _) ∧ (∀ k, IsOpenImmersion (z k)) ∧
      (∀ k j, k ≠ j → Disjoint (Set.range ⇑(z k)) (Set.range ⇑(z j))) ∧
      ∀ p : Z, ∃ k, p ∈ Set.range ⇑(z k) :=
by
  classical

  have T_aux : ∀ {K : Type u} [Field K] {Z : Scheme.{u}} (g : Z ⟶ Spec (.of K)) {U : Z.Opens}
      (hU : IsAffineOpen U) (ψ : Γ(Z, U) ⟶ CommRingCat.of K),
      (Spec.map ψ ≫ hU.fromSpec) ≫ g =
        Spec.map (((Scheme.ΓSpecIso (.of K)).inv ≫ g.appLE ⊤ U le_top) ≫ ψ) := by
    intro K _ Z g U hU ψ
    have h1 := IsAffineOpen.SpecMap_appLE_fromSpec g (isAffineOpen_top (Spec (.of K))) hU le_top
    rw [IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv] at h1
    rw [Category.assoc, ← h1]
    simp only [Spec.map_comp, Category.assoc]

  have U_aux : ∀ {K : Type u} [Field K] {Z : Scheme.{u}} (g : Z ⟶ Spec (.of K))
      (s s' : Spec (.of K) ⟶ Z) (_ : s ≫ g = 𝟙 _) (_ : s' ≫ g = 𝟙 _)
      (x : Spec (.of K)) (_ : s x = s' x), s = s' := by
    intro K _ Z g s s' hs hs' x hxy
    obtain ⟨U, hU, hpU, -⟩ :=
      exists_isAffineOpen_mem_and_subset (U := ⊤) (x := s x) (Set.mem_univ _)
    have hr : ∀ t : Spec (.of K) ⟶ Z, t x = s x → Set.range t ⊆ Set.range hU.fromSpec := by
      intro t ht
      rw [hU.range_fromSpec]
      rintro _ ⟨y, rfl⟩
      rw [Subsingleton.elim y x, ht]
      exact hpU
    have := hU.isOpenImmersion_fromSpec
    have hl := IsOpenImmersion.lift_fac hU.fromSpec s (hr s rfl)
    have hl' := IsOpenImmersion.lift_fac hU.fromSpec s' (hr s' hxy.symm)
    set l := IsOpenImmersion.lift hU.fromSpec s (hr s rfl)
    set l' := IsOpenImmersion.lift hU.fromSpec s' (hr s' hxy.symm)
    have hψ : Spec.map (Spec.preimage l) = l := Spec.map_preimage l
    have hψ' : Spec.map (Spec.preimage l') = l' := Spec.map_preimage l'
    set ψ := Spec.preimage l
    set ψ' := Spec.preimage l'
    set α := (Scheme.ΓSpecIso (.of K)).inv ≫ g.appLE ⊤ U le_top with hαdef
    have hα : α ≫ ψ = 𝟙 _ := by
      apply Spec.map_inj.mp
      rw [Spec.map_id, ← T_aux g hU ψ, hψ, hl, hs]
    have hα' : α ≫ ψ' = 𝟙 _ := by
      apply Spec.map_inj.mp
      rw [Spec.map_id, ← T_aux g hU ψ', hψ', hl', hs']
    have hαc : ∀ c, ψ.hom (α.hom c) = c := fun c => by
      simpa using congrArg (fun f => CommRingCat.Hom.hom f c) hα
    have hαc' : ∀ c, ψ'.hom (α.hom c) = c := fun c => by
      simpa using congrArg (fun f => CommRingCat.Hom.hom f c) hα'
    have hlx : l x = l' x := by
      apply (Scheme.Hom.isOpenEmbedding hU.fromSpec).isEmbedding.injective
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hl, hl', hxy]
    have mem1 : ∀ (φ : Γ(Z, U) ⟶ CommRingCat.of K) (b : Γ(Z, U)),
        b ∈ (Spec.map φ x).asIdeal → φ.hom b = 0 := by
      intro φ b hb
      rw [Spec.map_apply] at hb
      have hb' : φ.hom b ∈ (x : PrimeSpectrum K).asIdeal := hb
      by_contra hne
      exact (x : PrimeSpectrum K).isPrime.ne_top
        (Ideal.eq_top_of_isUnit_mem _ hb' (IsUnit.mk0 _ hne))
    have mem2 : ∀ (φ : Γ(Z, U) ⟶ CommRingCat.of K) (b : Γ(Z, U)),
        φ.hom b = 0 → b ∈ (Spec.map φ x).asIdeal := by
      intro φ b hb
      have hb' : φ.hom b ∈ (x : PrimeSpectrum K).asIdeal := by
        rw [hb]; exact Ideal.zero_mem _
      rw [Spec.map_apply]
      exact hb'
    have hker : ∀ b, ψ.hom b = 0 → ψ'.hom b = 0 := by
      intro b hb
      have h1 := mem2 ψ b hb
      rw [hψ, hlx, ← hψ'] at h1
      exact mem1 ψ' b h1
    have hψψ : ψ = ψ' := by
      ext a
      have h0 : ψ.hom (a - α.hom (ψ.hom a)) = 0 := by rw [map_sub, hαc, sub_self]
      have h2 := hker _ h0
      rw [map_sub, hαc', sub_eq_zero] at h2
      exact h2.symm
    rw [← hl, ← hl', ← hψ, ← hψ', hψψ]

  have C_aux : ∀ {K : Type u} [Field K] {Z : Scheme.{u}} [CompactSpace Z]
      (g : Z ⟶ Spec (.of K))
      (_ : ∀ p : Z, ∃ s : Spec (.of K) ⟶ Z, s ≫ g = 𝟙 _ ∧ IsOpenImmersion s ∧ p ∈ Set.range s)
      (_ : ∀ s s' : Spec (.of K) ⟶ Z, s ≫ g = 𝟙 _ → s' ≫ g = 𝟙 _ →
        ∀ x : Spec (.of K), s x = s' x → s = s')
      (m : ℕ) (_ : Nat.card {s : Spec (.of K) ⟶ Z // s ≫ g = 𝟙 _} = m),
      ∃ z : Fin m → (Spec (.of K) ⟶ Z),
        (∀ k, z k ≫ g = 𝟙 _) ∧ (∀ k, IsOpenImmersion (z k)) ∧
        (∀ k j, k ≠ j → Disjoint (Set.range (z k)) (Set.range (z j))) ∧
        ∀ p : Z, ∃ k, p ∈ Set.range (z k) := by
    intro K _ Z _ g hex huniq m hm
    let pt : Spec (.of K) := default
    have hrange : ∀ t : Spec (.of K) ⟶ Z, Set.range t = {t pt} := by
      intro t
      ext y
      constructor
      · rintro ⟨x, rfl⟩
        rw [Subsingleton.elim x pt]
        rfl
      · rintro rfl
        exact ⟨pt, rfl⟩
    let ev : {s : Spec (.of K) ⟶ Z // s ≫ g = 𝟙 _} → Z := fun s => s.1 pt
    have hinj : Function.Injective ev := fun s s' h =>
      Subtype.ext (huniq s.1 s'.1 s.2 s'.2 pt h)
    have : DiscreteTopology Z := by
      rw [discreteTopology_iff_isOpen_singleton]
      intro p
      obtain ⟨s, -, hso, hp⟩ := hex p
      have : Set.range s = {p} := by
        rw [hrange s]
        obtain ⟨x, hx⟩ := hp
        rw [← hx, Subsingleton.elim x pt]
      rw [← this]
      exact (Scheme.Hom.isOpenEmbedding s).isOpen_range
    have : Finite Z := finite_of_compact_of_discrete
    have : Finite {s : Spec (.of K) ⟶ Z // s ≫ g = 𝟙 _} := Finite.of_injective ev hinj
    let E : Fin m ≃ {s : Spec (.of K) ⟶ Z // s ≫ g = 𝟙 _} :=
      ((Finite.equivFin _).trans (finCongr hm)).symm
    refine ⟨fun k => (E k).1, fun k => (E k).2, ?_, ?_, ?_⟩
    · intro k
      obtain ⟨s, hs, hso, x, hx⟩ := hex ((E k).1 pt)
      have hse : s = (E k).1 := huniq s _ hs (E k).2 pt (by rw [← hx, Subsingleton.elim x pt])
      change IsOpenImmersion (E k).1
      rw [← hse]
      exact hso
    · intro k j hkj
      rw [hrange, hrange, Set.disjoint_singleton]
      intro h
      exact hkj (E.injective (hinj h))
    · intro p
      obtain ⟨s, hs, -, x, hx⟩ := hex p
      refine ⟨E.symm ⟨s, hs⟩, ?_⟩
      simp only [Equiv.apply_symm_apply]
      exact ⟨x, hx⟩

  have A_aux : ∀ {K : Type u} [Field K] [IsAlgClosed K] (A : Type u) [CommRing A] [Algebra K A]
      [Algebra.Etale K A] (q : Spec (.of A)), ∃ φ : A →ₐ[K] K,
        IsOpenImmersion (Spec.map (CommRingCat.ofHom (φ : A →+* K))) ∧
        q ∈ Set.range (Spec.map (CommRingCat.ofHom (φ : A →+* K))) := by
    intro K _ _ A _ _ _ q
    obtain ⟨I, hI, Ai, _, _, e, hfin⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod K A).mp inferInstance
    have hbij : ∀ i, Function.Bijective (algebraMap K (Ai i)) := by
      intro i
      have := (hfin i).1
      have : Algebra.IsIntegral K (Ai i) := Algebra.IsIntegral.of_finite K (Ai i)
      exact IsAlgClosed.algebraMap_bijective_of_isIntegral
    let ε : ∀ i, Ai i ≃ₐ[K] K := fun i =>
      (AlgEquiv.ofBijective (Algebra.ofId K (Ai i)) (hbij i)).symm
    let Ψ : A ≃ₐ[K] (I → K) := e.trans (AlgEquiv.piCongrRight ε)
    let R : I → CommRingCat.{u} := fun _ => CommRingCat.of K
    let P : CommRingCat.of A ⟶ CommRingCat.of (I → K) :=
      CommRingCat.ofHom (Ψ.toRingEquiv : A →+* (I → K))
    have hPiso : IsIso (Spec.map P) := by
      have : IsIso P := by
        rw [show P = Ψ.toRingEquiv.toCommRingCatIso.hom from
          (RingEquiv.toCommRingCatIso_hom _).symm]
        infer_instance
      infer_instance
    have key : ∀ i, Spec.map (CommRingCat.ofHom
        (((Pi.evalAlgHom K (fun _ => K) i).comp Ψ.toAlgHom : A →ₐ[K] K) : A →+* K)) =
        Limits.Sigma.ι (fun i => Spec (R i)) i ≫ sigmaSpec R ≫ Spec.map P := by
      intro i
      rw [← Category.assoc, ι_sigmaSpec, ← Spec.map_comp]
      rfl
    have hΘ : IsIso (sigmaSpec R ≫ Spec.map P) := inferInstance
    obtain ⟨w, hw⟩ := (sigmaSpec R ≫ Spec.map P).surjective q
    obtain ⟨⟨i, x⟩, hix⟩ := (sigmaMk (fun i => Spec (R i))).surjective w
    refine ⟨(Pi.evalAlgHom K (fun _ => K) i).comp Ψ.toAlgHom, ?_, ⟨x, ?_⟩⟩
    · rw [key]
      have : IsOpenImmersion (sigmaSpec R ≫ Spec.map P) := IsOpenImmersion.of_isIso _
      infer_instance
    · rw [key, ← Category.assoc, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply,
        ← sigmaMk_mk, hix, ← Scheme.Hom.comp_apply, hw]

  have E_aux : ∀ {K : Type u} [Field K] [IsAlgClosed K] {Z : Scheme.{u}}
      (g : Z ⟶ Spec (.of K)) [Etale g] (p : Z),
      ∃ s : Spec (.of K) ⟶ Z, s ≫ g = 𝟙 _ ∧ IsOpenImmersion s ∧ p ∈ Set.range s := by
    intro K _ _ Z g _ p
    obtain ⟨U, hU, hpU, -⟩ :=
      exists_isAffineOpen_mem_and_subset (U := ⊤) (x := p) (Set.mem_univ _)
    set α := (Scheme.ΓSpecIso (.of K)).inv ≫ g.appLE ⊤ U le_top with hαdef
    have hαet : α.hom.Etale := by
      have h1 := Etale.etale_appLE g (isAffineOpen_top (Spec (.of K))) hU le_top
      rw [hαdef, CommRingCat.hom_comp]
      exact RingHom.Etale.respectsIso.2 _
        (Scheme.ΓSpecIso (.of K)).symm.commRingCatIsoToRingEquiv h1
    letI : Algebra K Γ(Z, U) := α.hom.toAlgebra
    have : Algebra.Etale K Γ(Z, U) := RingHom.etale_algebraMap.mp hαet
    obtain ⟨q, hq⟩ : p ∈ Set.range hU.fromSpec := by rw [hU.range_fromSpec]; exact hpU
    obtain ⟨φ, hφo, x, hx⟩ := A_aux (K := K) Γ(Z, U) q
    have := hU.isOpenImmersion_fromSpec
    refine ⟨Spec.map (CommRingCat.ofHom (φ : Γ(Z, U) →+* K)) ≫ hU.fromSpec, ?_, ?_, ⟨x, ?_⟩⟩
    · rw [T_aux g hU, ← Spec.map_id]
      congr 1
      ext c
      exact φ.commutes c
    · infer_instance
    · rw [Scheme.Hom.comp_apply, hx, hq]

  have : CompactSpace (wcXbar F X) := QuasiCompact.compactSpace_of_compactSpace (wcPi2 F X)
  have : CompactSpace Z := (IsClosedImmersion.isClosedEmbedding a).compactSpace
  have : Etale (a ≫ wcPi2 F X) := ha

  exact C_aux (a ≫ wcPi2 F X) (fun p => E_aux (a ≫ wcPi2 F X) p)
    (fun s s' hs hs' x h => U_aux (a ≫ wcPi2 F X) s s' hs hs' x h) m hm

theorem wc_supp_unit_section {X Y : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {i : X ⟶ Y}
    (D : wcHMPullData i ℓ) (hD : wcHMPullCanonical D) :
    ∃ u : C(↥X, ULift.{u+1} ℚ_[ℓ]), IsUnit u ∧ ∀ V : Y.ProEt,
      ((SheafOfModules.unitHomEquiv _ (wcSuppUnitMap D)).1 (Opposite.op V) :
          C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ])) =
        u.comp (Limits.pullback.snd V.hom i).base.hom :=
by
  classical
  haveI := D.cont
  let T : Y.ProEt := MorphismProperty.Over.mk ⊤ (𝟙 Y) (inferInstance : WeaklyEtale (𝟙 Y))
  let σ := SheafOfModules.unitHomEquiv (wcSuppObj D) (wcSuppUnitMap D)
  let v : C(↥(Limits.pullback (𝟙 Y) i), ULift.{u+1} ℚ_[ℓ]) := σ.1 (Opposite.op T)
  let u : C(↥X, ULift.{u+1} ℚ_[ℓ]) := v.comp (inv (Limits.pullback.snd (𝟙 Y) i)).base.hom

  have hfac : ∀ V : Y.ProEt,
      (σ.1 (Opposite.op V) : C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ])) =
        u.comp (Limits.pullback.snd V.hom i).base.hom := by
    intro V
    let τ : V ⟶ T := MorphismProperty.Over.homMk (B := T) V.hom (Category.comp_id _) trivial
    have h1 : (v.comp ((wcProEtBC i).map τ).left.base.hom :
        C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ])) =
        (σ.1 (Opposite.op V) : C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ])) :=
      PresheafOfModules.sections_property σ τ.op
    have hw : ((wcProEtBC i).map τ).left ≫ Limits.pullback.snd (𝟙 Y) i =
        Limits.pullback.snd V.hom i :=
      MorphismProperty.Over.w ((wcProEtBC i).map τ)
    have key : ((wcProEtBC i).map τ).left =
        Limits.pullback.snd V.hom i ≫ inv (Limits.pullback.snd (𝟙 Y) i) :=
      (IsIso.eq_comp_inv (Limits.pullback.snd (𝟙 Y) i)).mpr hw
    refine h1.symm.trans ?_
    apply ContinuousMap.ext
    intro p
    exact congrArg (fun f : Limits.pullback V.hom i ⟶ Limits.pullback (𝟙 Y) i => v (f.base p)) key

  let ones : (wcSuppObj D).val.sections :=
    PresheafOfModules.sectionsMk (M := (wcSuppObj D).val)
      (fun W => (1 : C(↥(Limits.pullback W.unop.hom i), ULift.{u+1} ℚ_[ℓ])))
      (fun _ _ _ => rfl)
  let ρ₁ : SheafOfModules.unit (wcRingSheaf Y ℓ) ⟶
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).obj
        (SheafOfModules.unit (wcRingSheaf X ℓ)) :=
    (SheafOfModules.unitHomEquiv (wcSuppObj D)).symm ones
  let c : SheafOfModules.unit (wcRingSheaf X ℓ) ⟶ SheafOfModules.unit (wcRingSheaf X ℓ) :=
    D.μ.inv ≫ (D.adj.homEquiv _ _).symm ρ₁
  have h2 : wcSuppUnitMap D = D.adj.homEquiv _ _ D.μ.hom :=
    (D.adj.homEquiv_unit _ _ _).symm
  have hc : wcSuppUnitMap D ≫
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).map c = ρ₁ := by
    rw [h2]
    refine (D.adj.homEquiv_naturality_right D.μ.hom c).symm.trans ?_
    have e3 : D.μ.hom ≫ c = (D.adj.homEquiv _ _).symm ρ₁ := Iso.hom_inv_id_assoc _ _
    rw [e3, Equiv.apply_symm_apply]
  let W : X.ProEt := (wcProEtBC i).obj T
  let h : C(↥(Limits.pullback (𝟙 Y) i), ULift.{u+1} ℚ_[ℓ]) :=
    (c.val.app (Opposite.op W)).hom (1 : C(↥(Limits.pullback (𝟙 Y) i), ULift.{u+1} ℚ_[ℓ]))
  have eR : (SheafOfModules.unitHomEquiv (wcSuppObj D) ρ₁).1 (Opposite.op T) =
      (1 : C(↥(Limits.pullback (𝟙 Y) i), ULift.{u+1} ℚ_[ℓ])) := by
    show (SheafOfModules.unitHomEquiv (wcSuppObj D)
      ((SheafOfModules.unitHomEquiv (wcSuppObj D)).symm ones)).1 (Opposite.op T) = _
    rw [Equiv.apply_symm_apply]
    rfl
  have eL : (SheafOfModules.unitHomEquiv (wcSuppObj D) (wcSuppUnitMap D ≫
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).map c)).1
        (Opposite.op T) = (c.val.app (Opposite.op W)).hom v := rfl
  have eLin : (c.val.app (Opposite.op W)).hom v = v * h := by
    have hs := (c.val.app (Opposite.op W)).hom.map_smul
      (v : (wcRingSheaf X ℓ).obj.obj (Opposite.op W))
      (1 : C(↥(Limits.pullback (𝟙 Y) i), ULift.{u+1} ℚ_[ℓ]))
    exact (congrArg (fun x => (c.val.app (Opposite.op W)).hom x) (mul_one v).symm).trans hs
  have hvh : v * h = 1 :=
    eLin.symm.trans (eL.symm.trans ((congrArg
      (fun f => (SheafOfModules.unitHomEquiv (wcSuppObj D) f).1 (Opposite.op T)) hc).trans eR))
  refine ⟨u, ?_, hfac⟩
  refine isUnit_iff_exists_inv.mpr
    ⟨h.comp (inv (Limits.pullback.snd (𝟙 Y) i)).base.hom, ?_⟩
  show v.comp (inv (Limits.pullback.snd (𝟙 Y) i)).base.hom *
    h.comp (inv (Limits.pullback.snd (𝟙 Y) i)).base.hom = 1
  rw [← ContinuousMap.mul_comp, hvh, ContinuousMap.one_comp]

theorem wc_supp_clopen_split {Y Z P : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (a : Z ⟶ Y) (m : ℕ) (z : Fin m → (P ⟶ Z)) (hz : ∀ k, IsOpenImmersion (z k))
    (hdisj : ∀ k j, k ≠ j → Disjoint (Set.range ⇑(z k)) (Set.range ⇑(z j)))
    (hcov : ∀ p : Z, ∃ k, p ∈ Set.range ⇑(z k))
    (Da : wcHMPullData a ℓ) (hDa : wcHMPullCanonical Da)
    (Dx : ∀ k, wcHMPullData (z k ≫ a) ℓ) (hDx : ∀ k, wcHMPullCanonical (Dx k))
    (ua : C(↥Z, ULift.{u+1} ℚ_[ℓ])) (hua : IsUnit ua)
    (hσa : ∀ V : Y.ProEt,
      ((SheafOfModules.unitHomEquiv _ (wcSuppUnitMap Da)).1 (Opposite.op V) :
          C(↥(Limits.pullback V.hom a), ULift.{u+1} ℚ_[ℓ])) =
        ua.comp (Limits.pullback.snd V.hom a).base.hom)
    (uk : Fin m → C(↥P, ULift.{u+1} ℚ_[ℓ])) (huk : ∀ k, IsUnit (uk k))
    (hσk : ∀ k (V : Y.ProEt),
      ((SheafOfModules.unitHomEquiv _ (wcSuppUnitMap (Dx k))).1 (Opposite.op V) :
          C(↥(Limits.pullback V.hom (z k ≫ a)), ULift.{u+1} ℚ_[ℓ])) =
        (uk k).comp (Limits.pullback.snd V.hom (z k ≫ a)).base.hom) :
    ∃ (r : ∀ k, wcSuppObj Da ⟶ wcSuppObj (Dx k)) (ι : ∀ k, wcSuppObj (Dx k) ⟶ wcSuppObj Da),
      (∀ k, wcSuppUnitMap Da ≫ r k = wcSuppUnitMap (Dx k)) ∧
      (∀ k, ι k ≫ r k = 𝟙 _) ∧ (∀ k j, k ≠ j → ι k ≫ r j = 0) ∧
      ∑ k, r k ≫ ι k = 𝟙 _ :=
by
  classical

  have s1 : ∀ {A B : Scheme.{u}} {a' : A ⟶ Y} {b' : B ⟶ Y} (Da' : wcHMPullData a' ℓ)
      (_ : wcHMPullCanonical Da') (Db' : wcHMPullData b' ℓ) (_ : wcHMPullCanonical Db')
      (T : ∀ V : Y.ProEt, C(↥(Limits.pullback V.hom a'), ULift.{u+1} ℚ_[ℓ]) →
        C(↥(Limits.pullback V.hom b'), ULift.{u+1} ℚ_[ℓ]))
      (_ : ∀ (V : Y.ProEt) (f g : C(↥(Limits.pullback V.hom a'), ULift.{u+1} ℚ_[ℓ])),
        T V (f + g) = T V f + T V g)
      (_ : ∀ (V : Y.ProEt) (s : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))
          (f : C(↥(Limits.pullback V.hom a'), ULift.{u+1} ℚ_[ℓ])),
        T V ((s.comp (Limits.pullback.fst V.hom a').base.hom) * f) =
          (s.comp (Limits.pullback.fst V.hom b').base.hom) * T V f)
      (_ : ∀ {W V : Y.ProEt} (g : W ⟶ V) (f : C(↥(Limits.pullback V.hom a'), ULift.{u+1} ℚ_[ℓ])),
        T W (f.comp ((wcProEtBC a').map g).left.base.hom) =
          (T V f).comp ((wcProEtBC b').map g).left.base.hom),
      ∃ φ : wcSuppObj Da' ⟶ wcSuppObj Db', ∀ (V : Y.ProEt) f,
        ((φ.val.app (Opposite.op V)).hom f : C(↥(Limits.pullback V.hom b'), ULift.{u+1} ℚ_[ℓ])) =
          T V f := by
    intro A B a' b' Da' hDa' Db' hDb' T hadd hlin hnat
    refine ⟨⟨PresheafOfModules.homMk
      { app := fun X => AddCommGrpCat.ofHom (AddMonoidHom.mk' (T X.unop) (hadd X.unop))
        naturality := fun X X' g => by
          ext x
          exact hnat g.unop x } ?_⟩, fun V f => rfl⟩
    intro X r x
    have h1 := hlin X.unop r x
    rw [← hDa' X.unop r, ← hDb' X.unop r] at h1
    exact h1

  have sext : ∀ {A B : Scheme.{u}} {a' : A ⟶ Y} {b' : B ⟶ Y} {Da' : wcHMPullData a' ℓ}
      {Db' : wcHMPullData b' ℓ} (φ ψ : wcSuppObj Da' ⟶ wcSuppObj Db'),
      (∀ (V : Y.ProEt) (f : C(↥(Limits.pullback V.hom a'), ULift.{u+1} ℚ_[ℓ])),
        (φ.val.app (Opposite.op V)).hom f = (ψ.val.app (Opposite.op V)).hom f) →
      φ = ψ := by
    intro A B a' b' Da' Db' φ ψ h
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro X
    obtain ⟨V⟩ := X
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro f
    exact h V f
  have hcomp : ∀ {A B A₃ : Scheme.{u}} {a' : A ⟶ Y} {b' : B ⟶ Y} {c' : A₃ ⟶ Y}
      {Da' : wcHMPullData a' ℓ} {Db' : wcHMPullData b' ℓ} {Dc' : wcHMPullData c' ℓ}
      (φ : wcSuppObj Da' ⟶ wcSuppObj Db') (ψ : wcSuppObj Db' ⟶ wcSuppObj Dc') (V : Y.ProEt)
      (f : C(↥(Limits.pullback V.hom a'), ULift.{u+1} ℚ_[ℓ])),
      ((φ ≫ ψ).val.app (Opposite.op V)).hom f =
        (ψ.val.app (Opposite.op V)).hom ((φ.val.app (Opposite.op V)).hom f) :=
    fun _ _ _ _ => rfl
  have hid : ∀ {A : Scheme.{u}} {a' : A ⟶ Y} {Da' : wcHMPullData a' ℓ} (V : Y.ProEt)
      (f : C(↥(Limits.pullback V.hom a'), ULift.{u+1} ℚ_[ℓ])),
      ((SheafOfModules.Hom.val (𝟙 (wcSuppObj Da'))).app (Opposite.op V)).hom f = f :=
    fun _ _ => rfl
  have hzero : ∀ {A B : Scheme.{u}} {a' : A ⟶ Y} {b' : B ⟶ Y} {Da' : wcHMPullData a' ℓ}
      {Db' : wcHMPullData b' ℓ} (V : Y.ProEt) (f : C(↥(Limits.pullback V.hom a'), ULift.{u+1} ℚ_[ℓ])),
      ((0 : wcSuppObj Da' ⟶ wcSuppObj Db').val.app (Opposite.op V)).hom f =
        (0 : C(↥(Limits.pullback V.hom b'), ULift.{u+1} ℚ_[ℓ])) := fun _ _ => rfl
  have hsumC : ∀ (s : Finset (Fin m)) (φ : Fin m → (wcSuppObj Da ⟶ wcSuppObj Da))
      (V : Y.ProEt) (f : C(↥(Limits.pullback V.hom a), ULift.{u+1} ℚ_[ℓ])),
      ((∑ k ∈ s, φ k).val.app (Opposite.op V)).hom f =
        ∑ k ∈ s, (((φ k).val.app (Opposite.op V)).hom f :
          C(↥(Limits.pullback V.hom a), ULift.{u+1} ℚ_[ℓ])) := by
    intro s φ V f
    induction s using Finset.induction_on with
    | empty => rw [Finset.sum_empty, Finset.sum_empty]; exact hzero V f
    | insert i s hi ih =>
      rw [Finset.sum_insert hi, Finset.sum_insert hi, ← ih]
      rfl

  obtain ⟨j, hjdef⟩ : ∃ j : ∀ (k : Fin m) (V : Y.ProEt),
      Limits.pullback V.hom (z k ≫ a) ⟶ Limits.pullback V.hom a,
      ∀ k V, j k V = Limits.pullback.map V.hom (z k ≫ a) V.hom a (𝟙 _) (z k) (𝟙 Y)
        (by simp) (by simp) := ⟨_, fun _ _ => rfl⟩
  have hF1f : ∀ k (V : Y.ProEt), j k V ≫ Limits.pullback.fst V.hom a =
      Limits.pullback.fst V.hom (z k ≫ a) := by
    intro k V
    rw [hjdef]
    dsimp only [Limits.pullback.map]
    rw [Limits.pullback.lift_fst, Category.comp_id]
  have hF1s : ∀ k (V : Y.ProEt), j k V ≫ Limits.pullback.snd V.hom a =
      Limits.pullback.snd V.hom (z k ≫ a) ≫ z k := by
    intro k V
    rw [hjdef]
    dsimp only [Limits.pullback.map]
    rw [Limits.pullback.lift_snd]
  have hF1f' : ∀ k (V : Y.ProEt) (q : ↥(Limits.pullback V.hom (z k ≫ a))),
      (Limits.pullback.fst V.hom a).base.hom ((j k V).base.hom q) =
        (Limits.pullback.fst V.hom (z k ≫ a)).base.hom q :=
    fun k V q => congrArg (fun h => h.base.hom q) (hF1f k V)
  have hF1s' : ∀ k (V : Y.ProEt) (q : ↥(Limits.pullback V.hom (z k ≫ a))),
      (Limits.pullback.snd V.hom a).base.hom ((j k V).base.hom q) =
        (z k).base.hom ((Limits.pullback.snd V.hom (z k ≫ a)).base.hom q) :=
    fun k V q => congrArg (fun h => h.base.hom q) (hF1s k V)
  have hrange : ∀ k (V : Y.ProEt) (p : ↥(Limits.pullback V.hom a)),
      p ∈ Set.range ⇑(j k V) ↔ Limits.pullback.snd V.hom a p ∈ Set.range ⇑(z k) := by
    intro k V p
    have h : Set.range ⇑(j k V) = ⇑(Limits.pullback.fst V.hom a) ⁻¹' Set.range ⇑(𝟙 V.left) ∩
        ⇑(Limits.pullback.snd V.hom a) ⁻¹' Set.range ⇑(z k) := by
      rw [hjdef]
      exact @Scheme.Pullback.range_map _ _ _ V.hom (z k ≫ a) _ _ _ V.hom a (𝟙 _) (z k) (𝟙 Y)
        (by simp) (by simp) (instMonoId _)
    rw [h]
    exact ⟨fun h => h.2, fun h => ⟨⟨Limits.pullback.fst V.hom a p, rfl⟩, h⟩⟩
  have hrange2 : ∀ k (V : Y.ProEt) (p : ↥(Limits.pullback V.hom a)),
      Limits.pullback.snd V.hom a p ∈ Set.range ⇑(z k) → ∃ q, (j k V).base.hom q = p :=
    fun k V p h => (hrange k V p).2 h
  have hjoe : ∀ k (V : Y.ProEt), Topology.IsOpenEmbedding ⇑(j k V) := by
    intro k V
    have hpb : IsPullback (j k V) (Limits.pullback.snd V.hom (z k ≫ a))
        (Limits.pullback.snd V.hom a) (z k) := by
      refine IsPullback.of_right ?_ (hF1s k V) (IsPullback.of_hasPullback V.hom a)
      rw [hF1f k V]
      exact IsPullback.of_hasPullback V.hom (z k ≫ a)
    have : IsOpenImmersion (j k V) :=
      MorphismProperty.of_isPullback (P := @IsOpenImmersion) hpb.flip (hz k)
    exact (j k V).isOpenEmbedding
  have hclosed : ∀ k, IsClosed (Set.range ⇑(z k)) := by
    intro k
    rw [← isOpen_compl_iff, isOpen_iff_forall_mem_open]
    intro x hx
    obtain ⟨i, hi⟩ := hcov x
    have hik : i ≠ k := by
      rintro rfl
      exact hx hi
    refine ⟨Set.range ⇑(z i), fun y hy hyk => ?_, (z i).isOpenEmbedding.isOpen_range, hi⟩
    exact Set.disjoint_left.1 (hdisj i k hik) hy hyk

  have hBCs : ∀ {A : Scheme.{u}} (c : A ⟶ Y) {W V : Y.ProEt} (g : W ⟶ V),
      ((wcProEtBC c).map g).left ≫ Limits.pullback.snd V.hom c = Limits.pullback.snd W.hom c :=
    fun c _ _ g => Limits.pullback.lift_snd _ _ _
  have hBCf : ∀ {A : Scheme.{u}} (c : A ⟶ Y) {W V : Y.ProEt} (g : W ⟶ V),
      ((wcProEtBC c).map g).left ≫ Limits.pullback.fst V.hom c =
        Limits.pullback.fst W.hom c ≫ g.left :=
    fun c _ _ g => Limits.pullback.lift_fst _ _ _
  have hBCs' : ∀ {A : Scheme.{u}} (c : A ⟶ Y) {W V : Y.ProEt} (g : W ⟶ V)
      (x : ↥(Limits.pullback W.hom c)),
      (Limits.pullback.snd V.hom c).base.hom (((wcProEtBC c).map g).left.base.hom x) =
        (Limits.pullback.snd W.hom c).base.hom x :=
    fun c _ _ g x => congrArg (fun h => h.base.hom x) (hBCs c g)
  obtain ⟨bc, hbc⟩ : ∃ bc : ∀ (A : Scheme.{u}) (c : A ⟶ Y) (W V : Y.ProEt) (g : W ⟶ V),
      Limits.pullback W.hom c ⟶ Limits.pullback V.hom c,
      ∀ (A : Scheme.{u}) (c : A ⟶ Y) (W V : Y.ProEt) (g : W ⟶ V),
        bc A c W V g = ((wcProEtBC c).map g).left :=
    ⟨fun _ c _ _ g => ((wcProEtBC c).map g).left, fun _ _ _ _ _ => rfl⟩
  have hBCs2 : ∀ {A : Scheme.{u}} (c : A ⟶ Y) {W V : Y.ProEt} (g : W ⟶ V),
      bc A c W V g ≫ Limits.pullback.snd V.hom c = Limits.pullback.snd W.hom c := by
    intro A c W V g
    rw [hbc]
    exact hBCs c g
  have hBCf2 : ∀ {A : Scheme.{u}} (c : A ⟶ Y) {W V : Y.ProEt} (g : W ⟶ V),
      bc A c W V g ≫ Limits.pullback.fst V.hom c = Limits.pullback.fst W.hom c ≫ g.left := by
    intro A c W V g
    rw [hbc]
    exact hBCf c g
  have hjBC : ∀ k {W V : Y.ProEt} (g : W ⟶ V),
      j k W ≫ bc Z a W V g = bc P (z k ≫ a) W V g ≫ j k V := by
    intro k W V g
    apply Limits.pullback.hom_ext
    · calc (j k W ≫ bc Z a W V g) ≫ Limits.pullback.fst V.hom a
            = j k W ≫ (bc Z a W V g ≫ Limits.pullback.fst V.hom a) := Category.assoc _ _ _
          _ = j k W ≫ (Limits.pullback.fst W.hom a ≫ g.left) := by rw [hBCf2 a g]
          _ = (j k W ≫ Limits.pullback.fst W.hom a) ≫ g.left := (Category.assoc _ _ _).symm
          _ = Limits.pullback.fst W.hom (z k ≫ a) ≫ g.left := by rw [hF1f k W]
          _ = bc P (z k ≫ a) W V g ≫ Limits.pullback.fst V.hom (z k ≫ a) :=
              (hBCf2 (z k ≫ a) g).symm
          _ = bc P (z k ≫ a) W V g ≫ (j k V ≫ Limits.pullback.fst V.hom a) := by rw [hF1f k V]
          _ = (bc P (z k ≫ a) W V g ≫ j k V) ≫ Limits.pullback.fst V.hom a :=
              (Category.assoc _ _ _).symm
    · calc (j k W ≫ bc Z a W V g) ≫ Limits.pullback.snd V.hom a
            = j k W ≫ (bc Z a W V g ≫ Limits.pullback.snd V.hom a) := Category.assoc _ _ _
          _ = j k W ≫ Limits.pullback.snd W.hom a := by rw [hBCs2 a g]
          _ = Limits.pullback.snd W.hom (z k ≫ a) ≫ z k := hF1s k W
          _ = (bc P (z k ≫ a) W V g ≫ Limits.pullback.snd V.hom (z k ≫ a)) ≫ z k := by
              rw [hBCs2 (z k ≫ a) g]
          _ = bc P (z k ≫ a) W V g ≫ (Limits.pullback.snd V.hom (z k ≫ a) ≫ z k) :=
              Category.assoc _ _ _
          _ = bc P (z k ≫ a) W V g ≫ (j k V ≫ Limits.pullback.snd V.hom a) := by rw [hF1s k V]
          _ = (bc P (z k ≫ a) W V g ≫ j k V) ≫ Limits.pullback.snd V.hom a :=
              (Category.assoc _ _ _).symm
  have hjBC' : ∀ k {W V : Y.ProEt} (g : W ⟶ V) (q : ↥(Limits.pullback W.hom (z k ≫ a))),
      ((wcProEtBC a).map g).left.base.hom ((j k W).base.hom q) =
        (j k V).base.hom (((wcProEtBC (z k ≫ a)).map g).left.base.hom q) := by
    intro k W V g q
    have h := hjBC k g
    rw [hbc, hbc] at h
    exact congrArg (fun h => h.base.hom q) h

  have hext : ∀ k (V : Y.ProEt) (g : C(↥(Limits.pullback V.hom (z k ≫ a)), ULift.{u+1} ℚ_[ℓ])),
      ∃ e : C(↥(Limits.pullback V.hom a), ULift.{u+1} ℚ_[ℓ]),
        (∀ q, e ((j k V).base.hom q) = g q) ∧
        (∀ p, Limits.pullback.snd V.hom a p ∉ Set.range ⇑(z k) → e p = 0) := by
    intro k V g
    have hoe := hjoe k V
    have hcomp' : Function.extend ⇑(j k V) ⇑g 0 ∘ ⇑(j k V) = ⇑g :=
      funext fun q => hoe.injective.extend_apply _ _ q
    refine ⟨⟨Function.extend ⇑(j k V) ⇑g 0, ?_⟩, fun q => hoe.injective.extend_apply _ _ q, ?_⟩
    · rw [continuous_iff_continuousAt]
      intro p
      by_cases hp : Limits.pullback.snd V.hom a p ∈ Set.range ⇑(z k)
      · obtain ⟨q, rfl⟩ := (hrange k V p).2 hp
        rw [← hoe.continuousAt_iff, hcomp']
        exact g.continuous.continuousAt
      · have hopen : IsOpen (⇑(Limits.pullback.snd V.hom a) ⁻¹' (Set.range ⇑(z k))ᶜ) :=
          (hclosed k).isOpen_compl.preimage (Limits.pullback.snd V.hom a).continuous
        refine (continuousAt_const (y := (0 : ULift.{u+1} ℚ_[ℓ]))).congr ?_
        filter_upwards [hopen.mem_nhds hp] with x hx
        rw [Function.extend_apply']
        · rfl
        · rintro ⟨q, hq⟩
          exact hx ((hrange k V x).1 ⟨q, hq⟩)
    · intro p hp
      show Function.extend ⇑(j k V) ⇑g 0 p = 0
      rw [Function.extend_apply']
      · rfl
      · rintro ⟨q, hq⟩
        exact hp ((hrange k V p).1 ⟨q, hq⟩)
  choose ext0 hE1 hE2 using hext

  obtain ⟨va, hva⟩ : ∃ va : C(↥Z, ULift.{u+1} ℚ_[ℓ]), ∀ x, ua x * va x = 1 :=
    ⟨_, fun x => DFunLike.congr_fun hua.mul_val_inv x⟩
  have hvk0 : ∀ k, ∃ v : C(↥P, ULift.{u+1} ℚ_[ℓ]), ∀ x, uk k x * v x = 1 :=
    fun k => ⟨_, fun x => DFunLike.congr_fun (huk k).mul_val_inv x⟩
  choose vk hvk using hvk0
  obtain ⟨w, w', hw1, hw⟩ : ∃ w w' : Fin m → C(↥P, ULift.{u+1} ℚ_[ℓ]),
      (∀ k x, ua ((z k).base.hom x) * w k x = uk k x) ∧ (∀ k x, w k x * w' k x = 1) := by
    refine ⟨fun k => uk k * va.comp (z k).base.hom, fun k => vk k * ua.comp (z k).base.hom, ?_, ?_⟩
    · intro k x
      show ua ((z k).base.hom x) * (uk k x * va ((z k).base.hom x)) = uk k x
      linear_combination (uk k x) * hva ((z k).base.hom x)
    · intro k x
      show (uk k x * va ((z k).base.hom x)) * (vk k x * ua ((z k).base.hom x)) = 1
      linear_combination (va ((z k).base.hom x) * ua ((z k).base.hom x)) * hvk k x +
        hva ((z k).base.hom x)

  have hrex : ∀ k, ∃ φ : wcSuppObj Da ⟶ wcSuppObj (Dx k), ∀ (V : Y.ProEt)
      (f : C(↥(Limits.pullback V.hom a), ULift.{u+1} ℚ_[ℓ])),
      ((φ.val.app (Opposite.op V)).hom f : C(↥(Limits.pullback V.hom (z k ≫ a)), ULift.{u+1} ℚ_[ℓ])) =
        f.comp (j k V).base.hom * (w k).comp (Limits.pullback.snd V.hom (z k ≫ a)).base.hom := by
    intro k
    refine s1 Da hDa (Dx k) (hDx k)
      (fun V f => f.comp (j k V).base.hom * (w k).comp (Limits.pullback.snd V.hom (z k ≫ a)).base.hom)
      ?_ ?_ ?_
    · intro V f g
      ext x
      simp only [ContinuousMap.add_apply, ContinuousMap.mul_apply, ContinuousMap.comp_apply]
      ring
    · intro V s f
      ext x
      simp only [ContinuousMap.mul_apply, ContinuousMap.comp_apply, hF1f']
      ring
    · intro W V g f
      refine ContinuousMap.ext fun x => ?_
      show f (((wcProEtBC a).map g).left.base.hom ((j k W).base.hom x)) *
          w k ((Limits.pullback.snd W.hom (z k ≫ a)).base.hom x) =
        f ((j k V).base.hom (((wcProEtBC (z k ≫ a)).map g).left.base.hom x)) *
          w k ((Limits.pullback.snd V.hom (z k ≫ a)).base.hom
            (((wcProEtBC (z k ≫ a)).map g).left.base.hom x))
      rw [hjBC', hBCs']
  choose r hr using hrex

  have hιex : ∀ k, ∃ φ : wcSuppObj (Dx k) ⟶ wcSuppObj Da, ∀ (V : Y.ProEt)
      (h : C(↥(Limits.pullback V.hom (z k ≫ a)), ULift.{u+1} ℚ_[ℓ])),
      ((φ.val.app (Opposite.op V)).hom h : C(↥(Limits.pullback V.hom a), ULift.{u+1} ℚ_[ℓ])) =
        ext0 k V (h * (w' k).comp (Limits.pullback.snd V.hom (z k ≫ a)).base.hom) := by
    intro k
    refine s1 (Dx k) (hDx k) Da hDa
      (fun V h => ext0 k V (h * (w' k).comp (Limits.pullback.snd V.hom (z k ≫ a)).base.hom))
      ?_ ?_ ?_
    · intro V f g
      ext p
      by_cases hp : Limits.pullback.snd V.hom a p ∈ Set.range ⇑(z k)
      · obtain ⟨q, rfl⟩ := hrange2 k V p hp
        simp only [ContinuousMap.add_apply, hE1, ContinuousMap.mul_apply, ContinuousMap.comp_apply]
        ring
      · simp only [ContinuousMap.add_apply, hE2 k V _ p hp, add_zero]
    · intro V s f
      ext p
      by_cases hp : Limits.pullback.snd V.hom a p ∈ Set.range ⇑(z k)
      · obtain ⟨q, rfl⟩ := hrange2 k V p hp
        simp only [hE1, ContinuousMap.mul_apply, ContinuousMap.comp_apply, hF1f']
        ring
      · simp only [ContinuousMap.mul_apply, hE2 k V _ p hp, mul_zero]
    · intro W V g f
      refine ContinuousMap.ext fun p => ?_
      by_cases hp : Limits.pullback.snd W.hom a p ∈ Set.range ⇑(z k)
      · obtain ⟨q, rfl⟩ := hrange2 k W p hp
        show ext0 k W ((f.comp ((wcProEtBC (z k ≫ a)).map g).left.base.hom :
            C(↥(Limits.pullback W.hom (z k ≫ a)), ULift.{u+1} ℚ_[ℓ])) *
            (w' k).comp (Limits.pullback.snd W.hom (z k ≫ a)).base.hom) ((j k W).base.hom q) =
          ext0 k V (f * (w' k).comp (Limits.pullback.snd V.hom (z k ≫ a)).base.hom)
            (((wcProEtBC a).map g).left.base.hom ((j k W).base.hom q))
        rw [hjBC', hE1]
        refine Eq.trans ?_ (hE1 k V _ _).symm
        show f (((wcProEtBC (z k ≫ a)).map g).left.base.hom q) *
            w' k ((Limits.pullback.snd W.hom (z k ≫ a)).base.hom q) =
          f (((wcProEtBC (z k ≫ a)).map g).left.base.hom q) *
            w' k ((Limits.pullback.snd V.hom (z k ≫ a)).base.hom
              (((wcProEtBC (z k ≫ a)).map g).left.base.hom q))
        rw [hBCs']
      · have hp' : Limits.pullback.snd V.hom a (((wcProEtBC a).map g).left.base.hom p) ∉
            Set.range ⇑(z k) := by
          rintro ⟨y, hy⟩
          exact hp ⟨y, hy.trans (hBCs' a g p)⟩
        show ext0 k W ((f.comp ((wcProEtBC (z k ≫ a)).map g).left.base.hom :
            C(↥(Limits.pullback W.hom (z k ≫ a)), ULift.{u+1} ℚ_[ℓ])) *
            (w' k).comp (Limits.pullback.snd W.hom (z k ≫ a)).base.hom) p =
          ext0 k V (f * (w' k).comp (Limits.pullback.snd V.hom (z k ≫ a)).base.hom)
            (((wcProEtBC a).map g).left.base.hom p)
        rw [hE2 k W _ p hp, hE2 k V _ _ hp']
  choose ι hι using hιex
  refine ⟨r, ι, ?_, ?_, ?_, ?_⟩
  ·
    intro k
    apply (SheafOfModules.unitHomEquiv _).injective
    rw [SheafOfModules.unitHomEquiv_comp_apply]
    apply Subtype.ext
    funext X
    obtain ⟨V⟩ := X
    show ((r k).val.app (Opposite.op V)).hom
        ((SheafOfModules.unitHomEquiv _ (wcSuppUnitMap Da)).1 (Opposite.op V)) =
      (SheafOfModules.unitHomEquiv _ (wcSuppUnitMap (Dx k))).1 (Opposite.op V)
    refine (hr k V _).trans ?_
    refine ContinuousMap.ext fun q => ?_
    have e1 := DFunLike.congr_fun
      (show @Eq C(↥(Limits.pullback V.hom a), ULift.{u+1} ℚ_[ℓ]) _ _ from hσa V) ((j k V).base.hom q)
    have e2 := DFunLike.congr_fun
      (show @Eq C(↥(Limits.pullback V.hom (z k ≫ a)), ULift.{u+1} ℚ_[ℓ]) _ _ from hσk k V) q
    refine (congrArg (· * w k ((Limits.pullback.snd V.hom (z k ≫ a)).base.hom q)) e1).trans ?_
    refine Eq.trans ?_ e2.symm
    show ua ((Limits.pullback.snd V.hom a).base.hom ((j k V).base.hom q)) *
        w k ((Limits.pullback.snd V.hom (z k ≫ a)).base.hom q) =
      uk k ((Limits.pullback.snd V.hom (z k ≫ a)).base.hom q)
    rw [hF1s']
    exact hw1 k _
  ·
    intro k
    apply sext
    intro V h
    rw [hcomp, hid, hι k V, hr k V]
    refine ContinuousMap.ext fun q => ?_
    simp only [ContinuousMap.mul_apply, ContinuousMap.comp_apply, hE1]
    linear_combination (h q) * hw k ((Limits.pullback.snd V.hom (z k ≫ a)).base.hom q)
  ·
    intro k i hki
    apply sext
    intro V h
    rw [hcomp, hzero, hι k V, hr i V]
    refine ContinuousMap.ext fun q => ?_
    have hq : Limits.pullback.snd V.hom a ((j i V).base.hom q) ∉ Set.range ⇑(z k) := by
      intro hmem
      have hmem' : Limits.pullback.snd V.hom a ((j i V).base.hom q) ∈ Set.range ⇑(z i) :=
        ⟨_, (hF1s' i V q).symm⟩
      exact Set.disjoint_left.1 (hdisj k i hki) hmem hmem'
    simp only [ContinuousMap.mul_apply, ContinuousMap.comp_apply, hE2 k V _ _ hq, zero_mul,
      ContinuousMap.zero_apply]
  ·
    apply sext
    intro V f
    have e : ∀ k, (((r k ≫ ι k).val.app (Opposite.op V)).hom f :
        C(↥(Limits.pullback V.hom a), ULift.{u+1} ℚ_[ℓ])) =
        ext0 k V ((f.comp (j k V).base.hom *
          (w k).comp (Limits.pullback.snd V.hom (z k ≫ a)).base.hom) *
          (w' k).comp (Limits.pullback.snd V.hom (z k ≫ a)).base.hom) := by
      intro k
      rw [hcomp, hr k V, hι k V]
    have hs : (((∑ k, r k ≫ ι k).val.app (Opposite.op V)).hom f :
        C(↥(Limits.pullback V.hom a), ULift.{u+1} ℚ_[ℓ])) =
        ∑ k, ext0 k V ((f.comp (j k V).base.hom *
          (w k).comp (Limits.pullback.snd V.hom (z k ≫ a)).base.hom) *
          (w' k).comp (Limits.pullback.snd V.hom (z k ≫ a)).base.hom) := by
      rw [hsumC]
      exact Finset.sum_congr rfl (fun k _ => e k)
    rw [hs, hid]
    refine ContinuousMap.ext fun p => ?_
    rw [ContinuousMap.sum_apply]
    obtain ⟨k₀, hk₀⟩ := hcov (Limits.pullback.snd V.hom a p)
    rw [Finset.sum_eq_single_of_mem k₀ (Finset.mem_univ _)]
    · obtain ⟨q, rfl⟩ := hrange2 k₀ V p hk₀
      simp only [hE1, ContinuousMap.mul_apply, ContinuousMap.comp_apply]
      linear_combination (f ((j k₀ V).base.hom q)) *
        hw k₀ ((Limits.pullback.snd V.hom (z k₀ ≫ a)).base.hom q)
    · intro k _ hk
      exact hE2 k V _ p (Set.disjoint_left.1 (hdisj k₀ k (Ne.symm hk)) hk₀)

theorem wc_closed_supp_finite_points_split (F : Type u) [Finite F] [Field F]
    (X : Over (Spec (.of F))) [IsProper X.hom] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    {Z : Scheme.{u}} (a : Z ⟶ wcXbar F X) [IsClosedImmersion a] (ha : Etale (a ≫ wcPi2 F X))
    (m : ℕ)
    (hm : Nat.card {z : Spec (.of (AlgebraicClosure F)) ⟶ Z // z ≫ a ≫ wcPi2 F X = 𝟙 _} = m)
    (Da : wcHMPullData a ℓ) (hDa : wcHMPullCanonical Da) :
    ∃ (x : Fin m → (Spec (.of (AlgebraicClosure F)) ⟶ wcXbar F X))
      (Dx : ∀ k, wcHMPullData (x k) ℓ) (_ : ∀ k, wcHMPullCanonical (Dx k))
      (r : ∀ k, wcSuppObj Da ⟶ wcSuppObj (Dx k)) (ι : ∀ k, wcSuppObj (Dx k) ⟶ wcSuppObj Da),
      (∀ k, ∃ z : Spec (.of (AlgebraicClosure F)) ⟶ Z, z ≫ a ≫ wcPi2 F X = 𝟙 _ ∧ z ≫ a = x k) ∧
      (∀ k, wcSuppUnitMap Da ≫ r k = wcSuppUnitMap (Dx k)) ∧
      (∀ k, ι k ≫ r k = 𝟙 _) ∧ (∀ k j, k ≠ j → ι k ≫ r j = 0) ∧
      ∑ k, r k ≫ ι k = 𝟙 _ :=
by
  obtain ⟨z, hsec, hopen, hdisj, hcov⟩ := wc_closed_etale_points_decomp F X a ha m hm
  choose Dx hDx using fun k : Fin m => wc_hm_pull_data_exists (z k ≫ a) ℓ
  obtain ⟨ua, hua, hσa⟩ := wc_supp_unit_section Da hDa
  choose uk huk hσk using fun k : Fin m => wc_supp_unit_section (Dx k) (hDx k)
  obtain ⟨r, ι, h1, h2, h3, h4⟩ := wc_supp_clopen_split a m z hopen hdisj hcov Da hDa Dx hDx
    ua hua hσa uk huk hσk
  exact ⟨fun k => z k ≫ a, Dx, hDx, r, ι, fun k => ⟨z k, hsec k, rfl⟩, h1, h2, h3, h4⟩

theorem wc_hm_unit_end_const (S : Scheme.{u}) [PreconnectedSpace S] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (e : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶ SheafOfModules.unit (wcRingSheaf S ℓ)) :
    ∃ t : ℚ_[ℓ], e = wcHMConst S ℓ t :=
by
  classical
  let R := wcRingSheaf S ℓ
  let s := (SheafOfModules.unit R).unitHomEquiv e
  let σ : ∀ X : (S.ProEt)ᵒᵖ, R.obj.obj X := fun X => (s.1 X : R.obj.obj X)
  have hσ : ∀ {X Y : (S.ProEt)ᵒᵖ} (f : X ⟶ Y), (R.obj.map f).hom (σ X) = σ Y :=
    fun f => PresheafOfModules.sections_property s f

  let T : S.ProEt := MorphismProperty.Over.mk ⊤ (𝟙 S) (inferInstance : WeaklyEtale (𝟙 S))
  let fT : C(↥S, ULift.{u+1} ℚ_[ℓ]) := σ (Opposite.op T)
  let g : ↥S → ℚ_[ℓ] := fun x => (fT x).down
  have hg : Continuous g := continuous_uliftDown.comp fT.continuous
  have hsub : (Set.range g).Subsingleton := (isPreconnected_range hg).subsingleton
  let t : ℚ_[ℓ] := if h : Nonempty ↥S then g (Classical.choice h) else 0
  have ht : ∀ y : ↥S, g y = t := by
    intro y
    have hne : Nonempty ↥S := ⟨y⟩
    simp only [t, dif_pos hne]
    exact hsub ⟨y, rfl⟩ ⟨_, rfl⟩

  have hV : ∀ V : S.ProEt, (σ (Opposite.op V) : C(↥V.left, ULift.{u+1} ℚ_[ℓ])) =
      ContinuousMap.const _ (ULift.up t) := by
    intro V
    let φ : V ⟶ T := MorphismProperty.Over.homMk (B := T) V.hom (Category.comp_id _) trivial
    have h1 : (fT.comp V.hom.base.hom : C(↥V.left, ULift.{u+1} ℚ_[ℓ])) =
        (σ (Opposite.op V) : C(↥V.left, ULift.{u+1} ℚ_[ℓ])) := hσ φ.op
    rw [← h1]
    apply ContinuousMap.ext
    intro v
    apply ULift.ext
    exact ht _
  refine ⟨t, ?_⟩
  apply (SheafOfModules.unit R).unitHomEquiv.injective
  unfold wcHMConst
  rw [Equiv.apply_symm_apply]
  apply PresheafOfModules.sections_ext
  intro X
  exact hV X.unop

theorem wc_const_section_pull_indep (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (x x' : Spec (.of (AlgebraicClosure F)) ⟶ wcXbar F X)
    (hx : x ≫ wcPi2 F X = 𝟙 _) (hx' : x' ≫ wcPi2 F X = 𝟙 _)
    (s s' : wcXbar F X ⟶ Limits.pullback (wcPi2 F X) (wcPi2 F X))
    (hs₁ : s ≫ Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) = 𝟙 _)
    (hs₂ : s ≫ Limits.pullback.snd (wcPi2 F X) (wcPi2 F X) = wcPi2 F X ≫ x)
    (hs₁' : s' ≫ Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) = 𝟙 _)
    (hs₂' : s' ≫ Limits.pullback.snd (wcPi2 F X) (wcPi2 F X) = wcPi2 F X ≫ x')
    (Ds : wcHMPullData s ℓ) (hDs : wcHMPullCanonical Ds)
    (Ds' : wcHMPullData s' ℓ) (hDs' : wcHMPullCanonical Ds')
    (z : wcHM (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d)) :
    wcHMPull Ds (2 * d) z = wcHMPull Ds' (2 * d) z :=
by
  classical

  have F1 : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcHMPullData f ℓ) (hD : wcHMPullCanonical D)
      (n : ℕ) (t : ℚ_[ℓ]) (x : wcHM S ℓ n),
      wcHMPull D n (wcHMScalar S ℓ n t x) = wcHMScalar S' ℓ n t (wcHMPull D n x) := by
    intro S S' f D hD n t x
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    have hk : D.Φ.map (wcHMConst S ℓ t) ≫ D.μ.hom = D.μ.hom ≫ wcHMConst S' ℓ t := by
      rw [← wc_hm_pull_const D hD t, Iso.hom_inv_id_assoc]
    have e2 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf S' ℓ)} (z : Abelian.Ext A B n)
        (a : B ⟶ C') (b : C' ⟶ D'),
        (z.comp (Abelian.Ext.mk₀ a) (add_zero n)).comp (Abelian.Ext.mk₀ b) (add_zero n) =
          z.comp (Abelian.Ext.mk₀ (a ≫ b)) (add_zero n) := by
      intro A B C' D' z a b
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
    have e3 := Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mk₀ D.μ.inv)
      ((Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero n))
      (Abelian.Ext.mk₀ (wcHMConst S' ℓ t)) (zero_add n)
    show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ
        (x.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ t)) (add_zero n))).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero n)) (zero_add n) =
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ x).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero n)) (zero_add n)).comp
        (Abelian.Ext.mk₀ (wcHMConst S' ℓ t)) (add_zero n)
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀, e2, e3, e2, hk]

  have F3 : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcHMPullData f ℓ) (p q r : ℕ) (h : p + q = r)
      (x : wcHM S ℓ p) (y : wcHM S ℓ q),
      wcHMPull D r (wcHMCup S ℓ p q r h x y) =
        wcHMCup S' ℓ p q r h (wcHMPull D p x) (wcHMPull D q y) := by
    intro S S' f D p q r h x y
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ (x.comp y h)).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero r)) (zero_add r) =
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ x).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero p)) (zero_add p)).comp
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ y).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero q)) (zero_add q)) h
    have i1 := Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ D.μ.inv)
      ((Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero p))
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ y).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero q)) (zero_add q)) (zero_add p) h
      (by omega : 0 + p + q = r)
    have i2 := Abelian.Ext.comp_assoc_of_second_deg_zero (Abelian.Ext.mapExactFunctor D.Φ x)
      (Abelian.Ext.mk₀ D.μ.hom)
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ y).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero q)) (zero_add q)) h
    have i3 : (Abelian.Ext.mk₀ D.μ.hom).comp ((Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero q))
        (zero_add q)) (zero_add q) =
        (Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero q) := by
      rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
        Abelian.Ext.mk₀_id_comp]
    have i4 := Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mapExactFunctor D.Φ x)
      (Abelian.Ext.mapExactFunctor D.Φ y) (Abelian.Ext.mk₀ D.μ.hom) h
    rw [Abelian.Ext.mapExactFunctor_comp, i1, i2, i3, ← i4]

  have hpc : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcHMPullData f ℓ) (hD : wcHMPullCanonical D)
      (c : ℚ_[ℓ]),
      wcHMPull D 0 (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _ (wcHMConst S ℓ c)) =
        @Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _ (wcHMConst S' ℓ c) := by
    intro S S' f D hD c
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ
        (Abelian.Ext.mk₀ (wcHMConst S ℓ c))).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero 0))
        (zero_add 0) = Abelian.Ext.mk₀ (wcHMConst S' ℓ c)
    rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀,
      wc_hm_pull_const D hD c]

  have hvan : ∀ (X : Over (Spec (.of F))) [GeometricallyIrreducible X.hom] [IsProper X.hom]
      (d : ℕ) [SmoothOfRelativeDimension d X.hom] (n : ℕ), 2 * d < n →
      ∀ x : wcHM (wcXbar F X) ℓ n, x = 0 := by
    intro X _ _ d _ n hn x
    have h : WeaklyEtale (Limits.pullback.fst X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) :=
      MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
        (wc_weaklyEtale_algebraicClosure F)
    obtain ⟨T, -, -⟩ := wc_hm_comparison F X h ℓ
    have h0 := wc_coh_vanishing F X d ℓ hℓ h n hn ((T n).symm x)
    calc x = T n ((T n).symm x) := (AddEquiv.apply_symm_apply _ _).symm
      _ = 0 := by rw [h0, map_zero]

  have hpt : ∀ j : ℕ, 1 ≤ j → ∀ x : wcHM (Spec (.of (AlgebraicClosure F))) ℓ j, x = 0 := by
    intro j hj x
    haveI : IsProper (Over.mk (𝟙 (Spec (.of F)))).hom :=
      show IsProper (𝟙 (Spec (.of F))) from inferInstance
    haveI : SmoothOfRelativeDimension 0 (Over.mk (𝟙 (Spec (.of F)))).hom :=
      show SmoothOfRelativeDimension 0 (𝟙 (Spec (.of F))) from inferInstance
    haveI : IsIso (Over.mk (𝟙 (Spec (.of F)))).hom :=
      show IsIso (𝟙 (Spec (.of F))) from inferInstance
    haveI : GeometricallyIrreducible (Over.mk (𝟙 (Spec (.of F)))).hom := by
      constructor
      intro K _ yK Z fst snd hpb
      let lft : Spec (.of K) ⟶ Z := hpb.lift yK (𝟙 _) (by simp)
      have e : snd ≫ lft = 𝟙 Z := by
        apply hpb.hom_ext
        · rw [Category.assoc, hpb.lift_fst, Category.id_comp, ← hpb.w]
          simp
        · rw [Category.assoc, hpb.lift_snd, Category.comp_id, Category.id_comp]
      have hs : Function.Surjective lft := fun z =>
        ⟨snd z, by rw [← Scheme.Hom.comp_apply, e] <;> first | rfl | simp⟩
      exact Function.Surjective.irreducibleSpace lft.continuous hs
    haveI : IsIso (wcPi2 F (Over.mk (𝟙 (Spec (.of F))))) :=
      Limits.pullback_snd_iso_of_left_iso _ _
    obtain ⟨De, hDe⟩ := wc_hm_pull_data_exists (wcPi2 F (Over.mk (𝟙 (Spec (.of F))))) ℓ
    obtain ⟨De', hDe'⟩ :=
      wc_hm_pull_data_exists (inv (wcPi2 F (Over.mk (𝟙 (Spec (.of F)))))) ℓ
    obtain ⟨D0, hD0⟩ := wc_hm_pull_data_exists (𝟙 (Spec (.of (AlgebraicClosure F)))) ℓ
    have h1 := wc_hm_pull_comp (wcPi2 F (Over.mk (𝟙 (Spec (.of F)))))
      (inv (wcPi2 F (Over.mk (𝟙 (Spec (.of F)))))) (𝟙 _) (IsIso.inv_hom_id _)
      De hDe De' hDe' D0 hD0 j x
    rw [wc_hm_pull_id _ rfl D0 hD0,
      hvan (Over.mk (𝟙 (Spec (.of F)))) 0 j (by omega) (wcHMPull De j x), map_zero] at h1
    exact h1

  have hdeg0 : ∀ a : wcHM (wcXbar F X) ℓ 0, ∃ c : ℚ_[ℓ],
      a = @Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _ (wcHMConst (wcXbar F X) ℓ c) := by
    intro a
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcXbar F X) ℓ)) := HasExt.standard _
    obtain ⟨e, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 a
    haveI : IrreducibleSpace (wcXbar F X) :=
      GeometricallyIrreducible.geometrically_irreducibleSpace (f := X.hom)
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) _ _
        (IsPullback.of_hasPullback _ _)
    obtain ⟨c, rfl⟩ := wc_hm_unit_end_const (wcXbar F X) ℓ e
    exact ⟨c, rfl⟩

  obtain ⟨Dx, hDx⟩ := wc_hm_pull_data_exists x ℓ
  obtain ⟨Dx', hDx'⟩ := wc_hm_pull_data_exists x' ℓ
  have PA : ∀ (n : ℕ) (b : wcHM (wcXbar F X) ℓ n), wcHMPull Dx n b = wcHMPull Dx' n b := by
    intro n b
    rcases n with _ | k
    · obtain ⟨c, rfl⟩ := hdeg0 b
      rw [hpc Dx hDx, hpc Dx' hDx']
    · rw [hpt (k + 1) (by omega) (wcHMPull Dx (k + 1) b),
        hpt (k + 1) (by omega) (wcHMPull Dx' (k + 1) b)]

  obtain ⟨D1, hD1⟩ := wc_hm_pull_data_exists (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)) ℓ
  obtain ⟨D2, hD2⟩ := wc_hm_pull_data_exists (Limits.pullback.snd (wcPi2 F X) (wcPi2 F X)) ℓ
  obtain ⟨Did, hDid⟩ := wc_hm_pull_data_exists (𝟙 (wcXbar F X)) ℓ
  obtain ⟨Dπ, hDπ⟩ := wc_hm_pull_data_exists (wcPi2 F X) ℓ
  obtain ⟨Dπx, hDπx⟩ := wc_hm_pull_data_exists (wcPi2 F X ≫ x) ℓ
  obtain ⟨Dπx', hDπx'⟩ := wc_hm_pull_data_exists (wcPi2 F X ≫ x') ℓ
  have RA : ∀ (n : ℕ) (a : wcHM (wcXbar F X) ℓ n), wcHMPull Ds n (wcHMPull D1 n a) = a :=
    fun n a => (wc_hm_pull_comp _ s (𝟙 _) hs₁ D1 hD1 Ds hDs Did hDid n a).symm.trans
      (wc_hm_pull_id _ rfl Did hDid n a)
  have RA' : ∀ (n : ℕ) (a : wcHM (wcXbar F X) ℓ n), wcHMPull Ds' n (wcHMPull D1 n a) = a :=
    fun n a => (wc_hm_pull_comp _ s' (𝟙 _) hs₁' D1 hD1 Ds' hDs' Did hDid n a).symm.trans
      (wc_hm_pull_id _ rfl Did hDid n a)
  have RB : ∀ (n : ℕ) (b : wcHM (wcXbar F X) ℓ n),
      wcHMPull Ds n (wcHMPull D2 n b) = wcHMPull Dπ n (wcHMPull Dx n b) :=
    fun n b => (wc_hm_pull_comp _ s (wcPi2 F X ≫ x) hs₂ D2 hD2 Ds hDs Dπx hDπx n b).symm.trans
      (wc_hm_pull_comp x (wcPi2 F X) (wcPi2 F X ≫ x) rfl Dx hDx Dπ hDπ Dπx hDπx n b)
  have RB' : ∀ (n : ℕ) (b : wcHM (wcXbar F X) ℓ n),
      wcHMPull Ds' n (wcHMPull D2 n b) = wcHMPull Dπ n (wcHMPull Dx' n b) :=
    fun n b => (wc_hm_pull_comp _ s' (wcPi2 F X ≫ x') hs₂' D2 hD2 Ds' hDs' Dπx' hDπx' n b).symm.trans
      (wc_hm_pull_comp x' (wcPi2 F X) (wcPi2 F X ≫ x') rfl Dx' hDx' Dπ hDπ Dπx' hDπx' n b)

  have hspan := wc_ybar_kunneth_span F X d ℓ hℓ D1 hD1 D2 hD2 z
  refine AddSubgroup.closure_induction
    (p := fun y _ => wcHMPull Ds (2 * d) y = wcHMPull Ds' (2 * d) y) ?_ ?_ ?_ ?_ hspan
  · rintro w ⟨t, j, hj, a, b, rfl⟩
    beta_reduce
    rw [F1 Ds hDs, F3 Ds, RA, RB, F1 Ds' hDs', F3 Ds', RA', RB', PA]
  · beta_reduce
    simp only [map_zero]
  · intro y w _ _ hy hw
    beta_reduce at hy hw ⊢
    simp only [map_add]
    rw [hy, hw]
  · intro y _ hy
    beta_reduce at hy ⊢
    simp only [map_neg]
    rw [hy]

theorem wc_tl_transversal_chart (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (t t' : wcXbar F X ⟶ Limits.pullback (wcPi2 F X) (wcPi2 F X))
    (ht : t ≫ Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) = 𝟙 _)
    (ht' : t' ≫ Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) = 𝟙 _)
    (het : Etale (Limits.pullback.fst t (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X))
    (het' : Etale (Limits.pullback.fst t' (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X))
    (y : Spec (.of (AlgebraicClosure F)) ⟶ wcXbar F X) (hy : y ≫ wcPi2 F X = 𝟙 _)
    (hyt : y ≫ t = y ≫ Limits.pullback.diagonal (wcPi2 F X))
    (hyt' : y ≫ t' = y ≫ Limits.pullback.diagonal (wcPi2 F X)) :
    ∃ (U : (wcXbar F X).Opens) (u : U.toScheme ⟶ wcTlAff F d) (_ : Etale u)
      (_ : u ≫ wcTlStr F d = U.ι ≫ wcPi2 F X)
      (N : (wcXbar F X).Opens) (hNU : N ≤ U)
      (yN : Spec (.of (AlgebraicClosure F)) ⟶ N.toScheme) (g₂ g₂' : N.toScheme ⟶ U.toScheme),
      yN ≫ N.ι = y ∧
      g₂ ≫ U.ι = (N.ι ≫ t) ≫ Limits.pullback.snd (wcPi2 F X) (wcPi2 F X) ∧
      g₂' ≫ U.ι = (N.ι ≫ t') ≫ Limits.pullback.snd (wcPi2 F X) (wcPi2 F X) ∧
      IsPullback yN y (N.ι ≫ t) (Limits.pullback.diagonal (wcPi2 F X)) ∧
      IsPullback yN y (N.ι ≫ t') (Limits.pullback.diagonal (wcPi2 F X)) ∧
      Etale (wcTlDiff F d (N.ι ≫ wcPi2 F X) u ((wcXbar F X).homOfLE hNU) g₂) ∧
      Etale (wcTlDiff F d (N.ι ≫ wcPi2 F X) u ((wcXbar F X).homOfLE hNU) g₂') ∧
      IsPullback yN (𝟙 _) (wcTlDiff F d (N.ι ≫ wcPi2 F X) u ((wcXbar F X).homOfLE hNU) g₂)
        (wcTlZero F d) ∧
      IsPullback yN (𝟙 _) (wcTlDiff F d (N.ι ≫ wcPi2 F X) u ((wcXbar F X).homOfLE hNU) g₂')
        (wcTlZero F d) :=
by
  classical
  have hca : ∀ {X₁ X₂ X₃ : Scheme.{u}} (f : X₁ ⟶ X₂) (g : X₂ ⟶ X₃) (x : Γ(X₃, ⊤)),
      (f ≫ g).appTop.hom x = f.appTop.hom (g.appTop.hom x) := by
    intro X₁ X₂ X₃ f g x; rw [Scheme.Hom.comp_appTop]; rfl
  have hcomp : ∀ {X₁ X₂ X₃ : Scheme.{u}} (f : X₁ ⟶ X₂) (g : X₂ ⟶ X₃),
      (f ≫ g).appTop.hom = f.appTop.hom.comp g.appTop.hom := by
    intro X₁ X₂ X₃ f g; rw [Scheme.Hom.comp_appTop, CommRingCat.hom_comp]



  have wc_tlc_cotangent_gen : ∀ (k σ A B : Type u) [CommRing k] [CommRing A] [CommRing B]
      (c : MvPolynomial σ k →+* A) (hc : c.FormallyUnramified) (φ ψ : A →+* B)
      (hφψ : φ.comp (c.comp MvPolynomial.C) = ψ.comp (c.comp MvPolynomial.C)),
      Ideal.span (Set.range fun x => φ x - ψ x) ≤
        Ideal.span (Set.range fun i => φ (c (MvPolynomial.X i)) - ψ (c (MvPolynomial.X i))) ⊔
          Ideal.span (Set.range fun x => φ x - ψ x) ^ 2 := by
    intro k σ A B _ _ _ c hc φ ψ hφψ
    set I := Ideal.span (Set.range fun x => φ x - ψ x) with hI
    set J₀ := Ideal.span (Set.range fun i => φ (c (MvPolynomial.X i)) -
      ψ (c (MvPolynomial.X i))) with hJ₀
    set J := J₀ ⊔ I ^ 2 with hJ
    let q : B →+* B ⧸ J := Ideal.Quotient.mk J
    have hcq : (q.comp φ).comp c = (q.comp ψ).comp c := by
      apply MvPolynomial.ringHom_ext
      · intro a
        have := RingHom.congr_fun hφψ a
        simp only [RingHom.comp_apply] at this ⊢
        rw [this]
      · intro i
        simp only [RingHom.comp_apply]
        rw [Ideal.Quotient.eq]
        exact Ideal.mem_sup_left (Ideal.subset_span ⟨i, rfl⟩)
    letI : Algebra (MvPolynomial σ k) A := c.toAlgebra
    letI : Algebra (MvPolynomial σ k) (B ⧸ J) := ((q.comp φ).comp c).toAlgebra
    haveI : Algebra.FormallyUnramified (MvPolynomial σ k) A := hc
    have hĪ : (I.map q) ^ 2 = ⊥ := by
      rw [← Ideal.map_pow, Ideal.map_eq_bot_iff_le_ker, Ideal.mk_ker]
      exact le_sup_right
    let f₁ : A →ₐ[MvPolynomial σ k] B ⧸ J :=
      { q.comp φ with commutes' := fun r => rfl }
    let f₂ : A →ₐ[MvPolynomial σ k] B ⧸ J :=
      { q.comp ψ with commutes' := fun r => (RingHom.congr_fun hcq r).symm }
    have heq : (Ideal.Quotient.mkₐ (MvPolynomial σ k) (I.map q)).comp f₁ =
        (Ideal.Quotient.mkₐ (MvPolynomial σ k) (I.map q)).comp f₂ := by
      apply AlgHom.ext
      intro x
      show Ideal.Quotient.mk (I.map q) (q (φ x)) = Ideal.Quotient.mk (I.map q) (q (ψ x))
      rw [Ideal.Quotient.eq, ← map_sub]
      exact Ideal.mem_map_of_mem q (Ideal.subset_span ⟨x, rfl⟩)
    have h12 := Algebra.FormallyUnramified.comp_injective _ hĪ heq
    refine Ideal.span_le.mpr ?_
    rintro _ ⟨x, rfl⟩
    have h := congrArg (fun f : A →ₐ[MvPolynomial σ k] B ⧸ J => f x) h12
    exact Ideal.Quotient.eq.mp h



  have wc_tlc_nakayama_localize : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B]
      (R' : Type u) [CommRing R'] (ε : B →+* R') (J : Ideal B)
      (hJ : RingHom.ker ε ≤ J ⊔ RingHom.ker ε ^ 2),
      ∃ r : B, ε r = 1 ∧ ∀ (M : Submonoid B) (C : Type u) [CommRing C] [Algebra B C]
        [IsLocalization M C] (εC : C →+* R'), εC.comp (algebraMap B C) = ε →
          IsUnit (algebraMap B C r) → RingHom.ker εC ≤ J.map (algebraMap B C) := by
    intro B _ _ R' _ ε J hJ
    set m := RingHom.ker ε with hm
    let Nm : Submodule B (B ⧸ J) := Submodule.map J.mkQ m
    have hfg : Nm.FG := (IsNoetherian.noetherian m).map _
    have hle : Nm ≤ m • Nm := by
      rintro _ ⟨x, hx, rfl⟩
      obtain ⟨j, hj, y, hy, rfl⟩ := Submodule.mem_sup.mp (hJ hx)
      have hj0 : J.mkQ j = 0 := (Submodule.Quotient.mk_eq_zero J).mpr hj
      rw [map_add, hj0, zero_add]
      have hy' : y ∈ m • m := by rw [pow_two] at hy; exact hy
      have := Submodule.mem_map_of_mem (f := J.mkQ) hy'
      rw [Submodule.map_smul''] at this
      exact this
    obtain ⟨r, hr1, hr⟩ :=
      Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul m Nm hfg hle
    have hεr : ε r = 1 := by
      have h := hr1
      rw [hm, RingHom.mem_ker, map_sub, map_one, sub_eq_zero] at h
      exact h
    have hrJ : ∀ x ∈ m, r * x ∈ J := by
      intro x hx
      have h := hr (J.mkQ x) ⟨x, hx, rfl⟩
      rw [← map_smul, smul_eq_mul] at h
      exact (Submodule.Quotient.mk_eq_zero J).mp h
    refine ⟨r, hεr, ?_⟩
    intro M C _ _ _ εC hεC hu z hz
    obtain ⟨⟨x, s⟩, rfl⟩ := IsLocalization.mk'_surjective M z
    have hx : x ∈ m := by
      rw [hm, RingHom.mem_ker]
      have e1 : ε x = εC (algebraMap B C x) := (RingHom.congr_fun hεC x).symm
      rw [e1, ← IsLocalization.mk'_spec C x s, map_mul]
      rw [RingHom.mem_ker] at hz
      rw [hz, zero_mul]
    have h1 : algebraMap B C r * algebraMap B C x ∈ J.map (algebraMap B C) := by
      rw [← map_mul]
      exact Ideal.mem_map_of_mem _ (hrJ x hx)
    obtain ⟨v, hv⟩ := hu
    have h2 : algebraMap B C x ∈ J.map (algebraMap B C) := by
      rw [← Units.inv_mul_cancel_left v (algebraMap B C x), hv]
      exact Ideal.mul_mem_left _ _ h1
    show IsLocalization.mk' C x s ∈ _
    rw [IsLocalization.mk'_eq_mul_mk'_one]
    exact Ideal.mul_mem_right _ _ h2



  have wc_tlc_unramified_localize : ∀ (k σ B : Type u) [CommRing k] [CommRing B]
      (b : MvPolynomial σ k →+* B) (hft : b.FiniteType)
      (ε : B →+* k) (hsec : ∀ c : k, ε (b (MvPolynomial.C c)) = c)
      (hb : ∀ i, b (MvPolynomial.X i) ∈ RingHom.ker ε)
      (hgen : RingHom.ker ε ≤ Ideal.span (Set.range fun i => b (MvPolynomial.X i)) ⊔
        RingHom.ker ε ^ 2),
      ∃ r : B, ε r = 1 ∧ ∀ (M : Submonoid B) (C : Type u) [CommRing C] [Algebra B C]
        [IsLocalization M C], IsUnit (algebraMap B C r) →
          ((algebraMap B C).comp b).FormallyUnramified := by
    intro k σ B _ _ b hft ε hsec hb hgen
    letI : Algebra (MvPolynomial σ k) B := b.toAlgebra
    haveI : Algebra.FiniteType (MvPolynomial σ k) B := hft
    set m := RingHom.ker ε with hm
    let D := KaehlerDifferential.D (MvPolynomial σ k) B
    let T : Ideal B :=
      { carrier := {y | y ∈ m ∧ D y ∈ m • (⊤ : Submodule B Ω[B⁄MvPolynomial σ k])}
        add_mem' := by
          rintro a c ⟨ha, hDa⟩ ⟨hc, hDc⟩
          exact ⟨m.add_mem ha hc, by rw [map_add]; exact Submodule.add_mem _ hDa hDc⟩
        zero_mem' := ⟨m.zero_mem, by rw [map_zero]; exact Submodule.zero_mem _⟩
        smul_mem' := by
          rintro c a ⟨ha, hDa⟩
          refine ⟨m.mul_mem_left c ha, ?_⟩
          rw [smul_eq_mul, Derivation.leibniz]
          exact Submodule.add_mem _ (Submodule.smul_mem _ c hDa)
            (Submodule.smul_mem_smul ha Submodule.mem_top) }
    have hmT : m ≤ T := by
      intro x hx
      obtain ⟨j, hj, z, hz, rfl⟩ := Submodule.mem_sup.mp (hgen hx)
      have hJT : Ideal.span (Set.range fun i => b (MvPolynomial.X i)) ≤ T := by
        rw [Ideal.span_le]
        rintro _ ⟨i, rfl⟩
        refine ⟨hb i, ?_⟩
        have : D (b (MvPolynomial.X i)) = 0 := D.map_algebraMap (MvPolynomial.X i)
        rw [this]
        exact Submodule.zero_mem _
      have hm2T : m ^ 2 ≤ T := by
        rw [pow_two, Ideal.mul_le]
        intro a ha c hc
        refine ⟨m.mul_mem_left a hc, ?_⟩
        rw [Derivation.leibniz]
        exact Submodule.add_mem _ (Submodule.smul_mem_smul ha Submodule.mem_top)
          (Submodule.smul_mem_smul hc Submodule.mem_top)
      exact T.add_mem (hJT hj) (hm2T hz)
    have hle : (⊤ : Submodule B Ω[B⁄MvPolynomial σ k]) ≤ m • ⊤ := by
      rw [← KaehlerDifferential.span_range_derivation, Submodule.span_le]
      rintro _ ⟨x, rfl⟩
      have hx0 : x - b (MvPolynomial.C (ε x)) ∈ m := by
        rw [hm, RingHom.mem_ker, map_sub, hsec, sub_self]
      have e : D x = D (x - b (MvPolynomial.C (ε x))) := by
        rw [map_sub]
        have : D (b (MvPolynomial.C (ε x))) = 0 := D.map_algebraMap _
        rw [this, sub_zero]
      show D x ∈ _
      rw [e, KaehlerDifferential.span_range_derivation]
      exact (hmT hx0).2
    have hfg : (⊤ : Submodule B Ω[B⁄MvPolynomial σ k]).FG := Module.Finite.fg_top
    obtain ⟨r, hr1, hr⟩ :=
      Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul m ⊤ hfg hle
    have hεr : ε r = 1 := by
      rw [hm, RingHom.mem_ker, map_sub, map_one, sub_eq_zero] at hr1
      exact hr1
    refine ⟨r, hεr, ?_⟩
    intro M C _ _ _ hu
    letI : Algebra (MvPolynomial σ k) C := ((algebraMap B C).comp b).toAlgebra
    haveI : IsScalarTower (MvPolynomial σ k) B C :=
      IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : Algebra.FormallyEtale B C := Algebra.FormallyEtale.of_isLocalization M
    show Algebra.FormallyUnramified (MvPolynomial σ k) C
    refine Algebra.FormallyUnramified.mk ?_
    let e := KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale (MvPolynomial σ k) B C
    have hsub : Subsingleton (TensorProduct B C Ω[B⁄MvPolynomial σ k]) := by
      refine ⟨fun a c => ?_⟩
      have hz : ∀ t : TensorProduct B C Ω[B⁄MvPolynomial σ k], r • t = 0 := by
        intro t
        induction t using TensorProduct.induction_on with
        | zero => exact smul_zero _
        | tmul x y => rw [TensorProduct.smul_tmul', TensorProduct.smul_tmul, hr y trivial,
            TensorProduct.tmul_zero]
        | add x y hx hy => rw [smul_add, hx, hy, add_zero]
      obtain ⟨v, hv⟩ := hu
      have h0 : ∀ t : TensorProduct B C Ω[B⁄MvPolynomial σ k], t = 0 := by
        intro t
        have h1 : (algebraMap B C r) • t = 0 := by
          rw [algebraMap_smul]; exact hz t
        rw [← hv] at h1
        have h2 := congrArg (fun s => (↑v⁻¹ : C) • s) h1
        simp only [smul_zero, smul_smul, Units.inv_mul, one_smul] at h2
        exact h2
      rw [h0 a, h0 c]
    exact e.symm.toEquiv.subsingleton



  have wc_tlc_etale_of_unramified : ∀ (k σ C : Type u) [CommRing k] [CommRing C] [Algebra k C]
      [Finite σ] (a b : MvPolynomial σ k →+* C) (ha : a.comp MvPolynomial.C = algebraMap k C)
      (hb : b.comp MvPolynomial.C = algebraMap k C) (hae : a.Etale)
      (hbu : b.FormallyUnramified), b.Etale := by
    intro k σ C _ _ _ _ a b ha hb hae hbu
    have hA : Nonempty (Module.Basis σ C Ω[C⁄k]) ∧ Algebra.FormallySmooth k C ∧
        Algebra.FinitePresentation k C := by
      letI : Algebra (MvPolynomial σ k) C := a.toAlgebra
      haveI : IsScalarTower k (MvPolynomial σ k) C := IsScalarTower.of_algebraMap_eq' (by
        rw [RingHom.algebraMap_toAlgebra, MvPolynomial.algebraMap_eq, ha])
      haveI : Algebra.Etale (MvPolynomial σ k) C := hae
      let e := KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale k (MvPolynomial σ k) C
      refine ⟨⟨((KaehlerDifferential.mvPolynomialBasis k σ).baseChange C).map e⟩,
        Algebra.FormallySmooth.comp k (MvPolynomial σ k) C,
        Algebra.FinitePresentation.trans k (MvPolynomial σ k) C⟩
    obtain ⟨⟨bΩ⟩, hsm, hfp⟩ := hA
    letI : Algebra (MvPolynomial σ k) C := b.toAlgebra
    haveI : IsScalarTower k (MvPolynomial σ k) C := IsScalarTower.of_algebraMap_eq' (by
      rw [RingHom.algebraMap_toAlgebra, MvPolynomial.algebraMap_eq, hb])
    haveI : Algebra.FormallyUnramified (MvPolynomial σ k) C := hbu
    let b1 := (KaehlerDifferential.mvPolynomialBasis k σ).baseChange C
    let f := KaehlerDifferential.mapBaseChange k (MvPolynomial σ k) C
    have hsurj : Function.Surjective f := by
      intro y
      have hex := KaehlerDifferential.exact_mapBaseChange_map k (MvPolynomial σ k) C
      have h0 : KaehlerDifferential.map k (MvPolynomial σ k) C C y = 0 := Subsingleton.elim _ _
      exact (hex y).mp h0
    let eq := bΩ.equiv b1 (Equiv.refl σ)
    haveI : Module.Finite C (TensorProduct (MvPolynomial σ k) C Ω[MvPolynomial σ k⁄k]) :=
      Module.Finite.of_basis b1
    have hinj : Function.Injective f := by
      have h := OrzechProperty.injective_of_surjective_endomorphism (eq.toLinearMap ∘ₗ f)
        (eq.surjective.comp hsurj)
      intro x y hxy
      apply h
      simp only [LinearMap.coe_comp, Function.comp_apply, hxy]
    haveI : Subsingleton (Algebra.H1Cotangent (MvPolynomial σ k) C) := by
      refine ⟨fun x y => ?_⟩
      have hz : ∀ x : Algebra.H1Cotangent (MvPolynomial σ k) C, x = 0 := by
        intro x
        have h1 : Algebra.H1Cotangent.δ k (MvPolynomial σ k) C x = 0 := by
          apply hinj
          rw [map_zero]
          exact (Algebra.H1Cotangent.exact_δ_mapBaseChange k (MvPolynomial σ k) C).apply_apply_eq_zero x
        obtain ⟨z, hz⟩ := (Algebra.H1Cotangent.exact_map_δ k (MvPolynomial σ k) C x).mp h1
        rw [← hz, Subsingleton.elim z 0, map_zero]
      rw [hz x, hz y]
    haveI : Algebra.FormallySmooth (MvPolynomial σ k) C :=
      Algebra.FormallySmooth.mk inferInstance inferInstance
    haveI : Algebra.FormallyEtale (MvPolynomial σ k) C :=
      Algebra.FormallyEtale.of_formallyUnramified_and_formallySmooth
    haveI : Algebra.FinitePresentation (MvPolynomial σ k) C :=
      Algebra.FinitePresentation.of_restrict_scalars_finitePresentation k (MvPolynomial σ k) C
    exact (⟨inferInstance, inferInstance⟩ : Algebra.Etale (MvPolynomial σ k) C)



  have s1 : ∀ {n : Type u} {S N : Scheme.{u}} [IsAffine S] [IsAffine N]
      (q : N ⟶ S) (v : n → Γ(N, ⊤)), (MvPolynomial.eval₂Hom q.appTop.hom v).Etale →
      Etale (AffineSpace.homOfVector q v) := by
    intro n S N _ _ q v hv
    have h2 : Etale (AffineSpace.homOfVector q v ≫ (AffineSpace.isoOfIsAffine n S).hom) := by
      rw [HasRingHomProperty.iff_of_isAffine (P := @Etale), Scheme.Hom.comp_appTop,
        AffineSpace.isoOfIsAffine_hom_appTop, Category.assoc, CommRingCat.hom_comp,
        RingHom.RespectsIso.cancel_left_isIso RingHom.Etale.respectsIso, CommRingCat.hom_comp,
        CommRingCat.hom_ofHom, MvPolynomial.comp_eval₂Hom]
      convert hv using 2
      · rw [← CommRingCat.hom_comp, ← Scheme.Hom.comp_appTop, AffineSpace.homOfVector_over]
      · funext i
        exact AffineSpace.homOfVector_appTop_coord _ _ _
    have h3 : AffineSpace.homOfVector q v =
        (AffineSpace.homOfVector q v ≫ (AffineSpace.isoOfIsAffine n S).hom) ≫
          (AffineSpace.isoOfIsAffine n S).inv := by
      rw [Category.assoc, Iso.hom_inv_id, Category.comp_id]
    rw [h3]
    infer_instance



  have s2 : ∀ (K : Type u) [Field K] (Z : Scheme.{u}) (sZ : Z ⟶ Spec (.of K)) (d : ℕ)
      [SmoothOfRelativeDimension d sZ] (z : Z),
      ∃ (U : Z.Opens) (_ : IsAffineOpen U) (_ : z ∈ U)
        (v : ULift.{u} (Fin d) → Γ(U.toScheme, ⊤)),
        (MvPolynomial.eval₂Hom (U.ι ≫ sZ).appTop.hom v).Etale := by
    intro K _ Z sZ d _ z
    obtain ⟨U', hU', V, hV, hzV, e, hsm⟩ :=
      SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := d) (f := sZ) z
    have hU'top : U' = ⊤ := by
      have hmem : sZ z ∈ U' := e hzV
      ext x
      simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
      rw [Subsingleton.elim x (sZ z)]
      exact hmem
    subst hU'top
    obtain ⟨g, hgC, hg⟩ := hsm.exists_etale_mvPolynomial
    have hkey : (V.ι ≫ sZ).appTop = sZ.appLE ⊤ V e ≫ V.topIso.inv := by
      rw [Scheme.Hom.comp_appTop, Scheme.Opens.ι_appTop, Scheme.Opens.topIso_inv,
        Scheme.Hom.appLE]
      erw [Category.assoc, ← Functor.map_comp]
      rfl
    refine ⟨V, hV, hzV, fun i => V.topIso.inv.hom (g (MvPolynomial.X i.down)), ?_⟩
    have heq : MvPolynomial.eval₂Hom (V.ι ≫ sZ).appTop.hom
        (fun i : ULift.{u} (Fin d) => V.topIso.inv.hom (g (MvPolynomial.X i.down))) =
        (V.topIso.inv.hom.comp g).comp
          (MvPolynomial.renameEquiv _
            (Equiv.ulift : ULift.{u} (Fin d) ≃ Fin d)).toRingEquiv.toRingHom := by
      apply MvPolynomial.ringHom_ext
      · intro r
        rw [MvPolynomial.eval₂Hom_C, hkey, CommRingCat.hom_comp, RingHom.comp_apply, ← hgC]
        simp
      · intro i
        simp [MvPolynomial.eval₂Hom_X', MvPolynomial.rename_X]
    rw [heq]
    apply RingHom.Etale.respectsIso.2
    exact RingHom.Etale.respectsIso.1 g V.topIso.symm.commRingCatIsoToRingEquiv hg



  have s3 : ∀ (t : wcXbar F X ⟶ Limits.pullback (wcPi2 F X) (wcPi2 F X))
      (het : Etale (Limits.pullback.fst t (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X))
      (y : Spec (.of (AlgebraicClosure F)) ⟶ wcXbar F X) (hy : y ≫ wcPi2 F X = 𝟙 _)
      (hyt : y ≫ t = y ≫ Limits.pullback.diagonal (wcPi2 F X)),
      ∃ W : (wcXbar F X).Opens, Set.range ⇑y ⊆ (W : Set _) ∧
        ∀ (N : (wcXbar F X).Opens) (_ : N ≤ W)
          (yN : Spec (.of (AlgebraicClosure F)) ⟶ N.toScheme),
          yN ≫ N.ι = y → IsPullback yN y (N.ι ≫ t) (Limits.pullback.diagonal (wcPi2 F X)) := by
    intro t het y hy hyt
    set a := Limits.pullback.fst t (Limits.pullback.diagonal (wcPi2 F X)) with ha_def
    haveI : IsClosedImmersion a := inferInstance
    obtain ⟨z, hz1, hzo, -, hzcov⟩ := wc_closed_etale_points_decomp F X a het _ rfl
    let pt : Spec (.of (AlgebraicClosure F)) := default
    let z₀ : Spec (.of (AlgebraicClosure F)) ⟶
        Limits.pullback t (Limits.pullback.diagonal (wcPi2 F X)) :=
      Limits.pullback.lift y y hyt
    have hz₀a : z₀ ≫ a = y := Limits.pullback.lift_fst _ _ _
    have hz₀s : z₀ ≫ Limits.pullback.snd t (Limits.pullback.diagonal (wcPi2 F X)) = y :=
      Limits.pullback.lift_snd _ _ _
    obtain ⟨k₀, hk₀⟩ := hzcov (z₀ pt)
    haveI := hzo k₀
    have hrz₀ : Set.range ⇑z₀ ⊆ Set.range ⇑(z k₀) := by
      rintro _ ⟨q, rfl⟩
      rw [Subsingleton.elim q pt]
      exact hk₀
    have hzz : z k₀ = z₀ := by
      have hσ := IsOpenImmersion.lift_fac (z k₀) z₀ hrz₀
      have hσ1 : IsOpenImmersion.lift (z k₀) z₀ hrz₀ = 𝟙 _ := by
        have h := congrArg (· ≫ a ≫ wcPi2 F X) hσ
        simp only [Category.assoc] at h
        rw [hz1 k₀, Category.comp_id, ← Category.assoc, hz₀a, hy] at h
        exact h
      rw [hσ1, Category.id_comp] at hσ
      exact hσ
    have hopen : IsOpen (Set.range ⇑(z k₀)) := (z k₀).isOpenEmbedding.isOpen_range
    have hcl : IsClosed (⇑a '' (Set.range ⇑(z k₀))ᶜ) :=
      a.isClosedEmbedding.isClosedMap _ hopen.isClosed_compl
    let W : (wcXbar F X).Opens := ⟨(⇑a '' (Set.range ⇑(z k₀))ᶜ)ᶜ, hcl.isOpen_compl⟩
    have hmemW : ∀ x, x ∈ W ↔ x ∉ ⇑a '' (Set.range ⇑(z k₀))ᶜ := fun x => Iff.rfl
    refine ⟨W, ?_, ?_⟩
    · rintro _ ⟨q, rfl⟩
      rw [SetLike.mem_coe, hmemW]
      rintro ⟨c, hc, hca'⟩
      apply hc
      have h1 : y q = a (z₀ q) := by rw [← Scheme.Hom.comp_apply, hz₀a]
      rw [h1] at hca'
      have := a.isClosedEmbedding.injective hca'
      rw [this, ← hzz]
      exact ⟨q, rfl⟩
    · intro N hNW yN hyN
      have hsq : yN ≫ N.ι ≫ t = y ≫ Limits.pullback.diagonal (wcPi2 F X) := by
        rw [← Category.assoc, hyN, hyt]
      have key : ∀ (T : Scheme.{u}) (α : T ⟶ N.toScheme) (β : T ⟶ wcXbar F X),
          α ≫ N.ι ≫ t = β ≫ Limits.pullback.diagonal (wcPi2 F X) →
          β ≫ wcPi2 F X ≫ y = β ∧ α ≫ N.ι = β := by
        intro T α β hαβ
        let w : T ⟶ Limits.pullback t (Limits.pullback.diagonal (wcPi2 F X)) :=
          Limits.pullback.lift (α ≫ N.ι) β (by rw [Category.assoc]; exact hαβ)
        have hwa : w ≫ a = α ≫ N.ι := Limits.pullback.lift_fst _ _ _
        have hws : w ≫ Limits.pullback.snd t (Limits.pullback.diagonal (wcPi2 F X)) = β :=
          Limits.pullback.lift_snd _ _ _
        have hwr : Set.range ⇑w ⊆ Set.range ⇑(z k₀) := by
          rintro _ ⟨q, rfl⟩
          by_contra hq
          have hin : a (w q) ∈ N := by
            rw [← Scheme.Hom.comp_apply, hwa, Scheme.Hom.comp_apply]
            rw [← SetLike.mem_coe, ← Scheme.Opens.range_ι]
            exact ⟨_, rfl⟩
          exact (hmemW _).mp (hNW hin) ⟨w q, hq, rfl⟩
        have hγ := IsOpenImmersion.lift_fac (z k₀) w hwr
        have hγ' : IsOpenImmersion.lift (z k₀) w hwr ≫ z₀ = w := by
          rw [← hzz]; exact hγ
        have hβ : IsOpenImmersion.lift (z k₀) w hwr ≫ y = β := by
          rw [← hz₀s, ← Category.assoc, hγ', hws]
        have hα : IsOpenImmersion.lift (z k₀) w hwr ≫ y = α ≫ N.ι := by
          rw [← hz₀a, ← Category.assoc, hγ', hwa]
        refine ⟨?_, hα.symm.trans hβ⟩
        rw [← hβ, Category.assoc, ← Category.assoc y, hy, Category.id_comp]
      refine IsPullback.of_isLimit (c := Limits.PullbackCone.mk _ _ hsq)
        (Limits.PullbackCone.IsLimit.mk hsq (fun s => s.snd ≫ wcPi2 F X) ?_ ?_ ?_)
      · intro s
        obtain ⟨hs, h1⟩ := key _ s.fst s.snd s.condition
        rw [← cancel_mono N.ι, Category.assoc, hyN, Category.assoc, hs, h1]
      · intro s
        exact (key _ s.fst s.snd s.condition).1
      · intro s m _ hm2
        rw [← hm2, Category.assoc, hy, Category.comp_id]



  have c1 : ∀ {Y S T : Scheme.{u}} (π : Y ⟶ S) (U N : Y.Opens) (hU : IsAffineOpen U)
      (hN : IsAffineOpen N) (hNU : N ≤ U) (t : Y ⟶ Limits.pullback π π)
      (ht : t ≫ Limits.pullback.fst π π = 𝟙 Y)
      (g : N.toScheme ⟶ U.toScheme) (hg : g ≫ U.ι = (N.ι ≫ t) ≫ Limits.pullback.snd π π)
      (y : T ⟶ Y) (yN : T ⟶ N.toScheme)
      (hpb : IsPullback yN y (N.ι ≫ t) (Limits.pullback.diagonal π)),
      RingHom.ker yN.appTop.hom ≤ Ideal.span (Set.range fun x : Γ(U.toScheme, ⊤) =>
        (Y.homOfLE hNU).appTop.hom x - g.appTop.hom x) := by
    intro Y S T π U N hU hN hNU t ht g hg y yN hpb
    haveI : IsAffine U.toScheme := hU
    haveI : IsAffine N.toScheme := hN
    set I := Ideal.span (Set.range fun x : Γ(U.toScheme, ⊤) =>
        (Y.homOfLE hNU).appTop.hom x - g.appTop.hom x) with hI
    let q : Γ(N.toScheme, ⊤) →+* Γ(N.toScheme, ⊤) ⧸ I := Ideal.Quotient.mk I
    let ιQ : Spec (.of (Γ(N.toScheme, ⊤) ⧸ I)) ⟶ N.toScheme :=
      Spec.map (CommRingCat.ofHom q) ≫ N.toScheme.isoSpec.inv
    have hk : ιQ.appTop ≫ (Scheme.ΓSpecIso (.of (Γ(N.toScheme, ⊤) ⧸ I))).hom =
        CommRingCat.ofHom q := by
      simp only [ιQ, Scheme.Hom.comp_appTop, Category.assoc, Scheme.ΓSpecIso_naturality]
      have e : N.toScheme.isoSpec.inv.appTop ≫ (Scheme.ΓSpecIso Γ(N.toScheme, ⊤)).hom =
          𝟙 _ := by
        rw [← Scheme.toSpecΓ_appTop, ← Scheme.isoSpec_hom, ← Scheme.Hom.comp_appTop,
          Iso.hom_inv_id, Scheme.Hom.id_appTop]
      erw [← Category.assoc, e]
      rw [Category.id_comp]
    have hk' : ∀ z, (Scheme.ΓSpecIso (.of (Γ(N.toScheme, ⊤) ⧸ I))).hom.hom
        (ιQ.appTop.hom z) = q z := by
      intro z
      have := congrArg (fun f => f.hom z) hk
      simpa using this
    have hkill : ∀ z ∈ I, ιQ.appTop.hom z = 0 := by
      intro z hz
      have h1 := hk' z
      rw [show q z = 0 from Ideal.Quotient.eq_zero_iff_mem.mpr hz] at h1
      have h2 := congrArg (Scheme.ΓSpecIso (.of (Γ(N.toScheme, ⊤) ⧸ I))).inv.hom h1
      rw [map_zero] at h2
      rw [← h2]
      show _ = ((Scheme.ΓSpecIso _).hom ≫ (Scheme.ΓSpecIso _).inv).hom _
      rw [Iso.hom_inv_id]
      rfl
    have hgQ : ιQ ≫ g = ιQ ≫ Y.homOfLE hNU := by
      apply ext_of_isAffine
      ext x
      rw [hca, hca]
      have h := hkill _ (Ideal.subset_span ⟨x, rfl⟩ : (Y.homOfLE hNU).appTop.hom x -
        g.appTop.hom x ∈ I)
      rw [map_sub, sub_eq_zero] at h
      exact h.symm
    have hw : ιQ ≫ N.ι ≫ t = (ιQ ≫ N.ι) ≫ Limits.pullback.diagonal π := by
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc, ht, Category.comp_id, Limits.pullback.diagonal_fst]
      · simp only [Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id]
        have h1 : N.ι ≫ t ≫ Limits.pullback.snd π π = g ≫ U.ι := by
          rw [hg, Category.assoc]
        rw [h1, ← Category.assoc, hgQ, Category.assoc, Scheme.homOfLE_ι]
    have hγ := hpb.lift_fst ιQ (ιQ ≫ N.ι) hw
    intro x hx
    rw [RingHom.mem_ker] at hx
    have h1 : ιQ.appTop.hom x = 0 := by
      rw [← hγ, hca, hx, map_zero]
    have h2 := hk' x
    rw [h1, map_zero] at h2
    exact Ideal.Quotient.eq_zero_iff_mem.mp h2.symm



  have c2 : ∀ (k σ A B : Type u) [CommRing k] [CommRing A] [CommRing B]
      [IsNoetherianRing B] [Finite σ]
      (c : MvPolynomial σ k →+* A) (hc : c.Etale) (φ ψ : A →+* B) (hφ : φ.Etale)
      (hφψ : φ.comp (c.comp MvPolynomial.C) = ψ.comp (c.comp MvPolynomial.C))
      (ε : B →+* k) (hsec : ∀ a : k, ε (φ (c (MvPolynomial.C a))) = a)
      (hεφψ : ε.comp φ = ε.comp ψ)
      (hker : RingHom.ker ε ≤ Ideal.span (Set.range fun x => φ x - ψ x)),
      ∃ r : B, ε r = 1 ∧ ∀ (r' : B) (D : Type u) [CommRing D] [Algebra B D]
        [IsLocalization.Away r' D], IsUnit (algebraMap B D r) →
        (∀ εD : D →+* k, εD.comp (algebraMap B D) = ε →
          RingHom.ker εD ≤ Ideal.span (Set.range fun i =>
            algebraMap B D (φ (c (MvPolynomial.X i)) - ψ (c (MvPolynomial.X i))))) ∧
        (MvPolynomial.eval₂Hom ((algebraMap B D).comp (φ.comp (c.comp MvPolynomial.C)))
          (fun i => algebraMap B D (φ (c (MvPolynomial.X i)) -
            ψ (c (MvPolynomial.X i))))).Etale := by
    intro k σ A B _ _ _ _ _ c hc φ ψ hφ hφψ ε hsec hεφψ hker
    set I := Ideal.span (Set.range fun x => φ x - ψ x) with hI
    set J₀ := Ideal.span (Set.range fun i => φ (c (MvPolynomial.X i)) -
      ψ (c (MvPolynomial.X i))) with hJ₀
    have hIm : I ≤ RingHom.ker ε := by
      rw [hI, Ideal.span_le]
      rintro _ ⟨x, rfl⟩
      rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, sub_eq_zero]
      exact RingHom.congr_fun hεφψ x
    have hmI : RingHom.ker ε = I := le_antisymm hker hIm
    have hC3 := wc_tlc_cotangent_gen k σ A B c hc.formallyUnramified φ ψ hφψ
    have hgen : RingHom.ker ε ≤ J₀ ⊔ RingHom.ker ε ^ 2 := by
      rw [hmI]; exact hC3
    obtain ⟨r₁, hr₁, hC4⟩ := wc_tlc_nakayama_localize B k ε J₀ hgen
    let b : MvPolynomial σ k →+* B := MvPolynomial.eval₂Hom (φ.comp (c.comp MvPolynomial.C))
      (fun i => φ (c (MvPolynomial.X i)) - ψ (c (MvPolynomial.X i)))
    have hbX : ∀ i, b (MvPolynomial.X i) =
        φ (c (MvPolynomial.X i)) - ψ (c (MvPolynomial.X i)) :=
      fun i => MvPolynomial.eval₂Hom_X' _ _ i
    have hbC : b.comp MvPolynomial.C = φ.comp (c.comp MvPolynomial.C) :=
      MvPolynomial.eval₂Hom_comp_C _ _
    have etFT : ∀ {R S : Type u} [CommRing R] [CommRing S] (f : R →+* S),
        f.Etale → f.FiniteType :=
      fun f hf => RingHom.FiniteType.of_finitePresentation
        (@Algebra.Etale.finitePresentation _ _ _ _ f.toAlgebra hf)
    have hCft : (MvPolynomial.C : k →+* MvPolynomial σ k).FiniteType := by
      rw [← MvPolynomial.algebraMap_eq, RingHom.finiteType_algebraMap]
      infer_instance
    have hft : b.FiniteType := by
      have h2 : (b.comp MvPolynomial.C).FiniteType := by
        rw [hbC]
        exact RingHom.FiniteType.comp (etFT φ hφ) (RingHom.FiniteType.comp (etFT c hc) hCft)
      exact RingHom.FiniteType.of_comp_finiteType h2
    have hsecb : ∀ a : k, ε (b (MvPolynomial.C a)) = a := by
      intro a
      rw [← RingHom.comp_apply b, hbC]
      exact hsec a
    have hbm : ∀ i, b (MvPolynomial.X i) ∈ RingHom.ker ε := by
      intro i
      rw [hbX, RingHom.mem_ker, map_sub, sub_eq_zero]
      exact RingHom.congr_fun hεφψ _
    have hgenb : RingHom.ker ε ≤ Ideal.span (Set.range fun i => b (MvPolynomial.X i)) ⊔
        RingHom.ker ε ^ 2 := by
      have : (fun i => b (MvPolynomial.X i)) =
          fun i => φ (c (MvPolynomial.X i)) - ψ (c (MvPolynomial.X i)) := funext hbX
      rw [this]; exact hgen
    obtain ⟨r₂, hr₂, hC5⟩ := wc_tlc_unramified_localize k σ B b hft ε hsecb hbm hgenb
    refine ⟨r₁ * r₂, by rw [map_mul, hr₁, hr₂, one_mul], ?_⟩
    intro r' D _ _ _ hunit
    rw [map_mul] at hunit
    have hu₁ : IsUnit (algebraMap B D r₁) := isUnit_of_mul_isUnit_left hunit
    have hu₂ : IsUnit (algebraMap B D r₂) := isUnit_of_mul_isUnit_right hunit
    refine ⟨?_, ?_⟩
    · intro εD hεD
      have h := hC4 (Submonoid.powers r') D εD hεD hu₁
      rw [hJ₀, Ideal.map_span, ← Set.range_comp] at h
      exact h
    · letI : Algebra k D := ((algebraMap B D).comp (φ.comp (c.comp MvPolynomial.C))).toAlgebra
      have hbu := hC5 (Submonoid.powers r') D hu₂
      have heq : (algebraMap B D).comp b =
          MvPolynomial.eval₂Hom ((algebraMap B D).comp (φ.comp (c.comp MvPolynomial.C)))
            (fun i => algebraMap B D (φ (c (MvPolynomial.X i)) - ψ (c (MvPolynomial.X i)))) :=
        MvPolynomial.comp_eval₂Hom _ _ _
      rw [heq] at hbu
      have hae : ((algebraMap B D).comp (φ.comp c)).Etale := by
        have hl : (algebraMap B D).Etale := by
          rw [RingHom.etale_algebraMap]
          exact Algebra.Etale.of_isLocalizationAway r'
        exact RingHom.Etale.stableUnderComposition _ _
          (RingHom.Etale.stableUnderComposition _ _ hc hφ) hl
      refine wc_tlc_etale_of_unramified k σ D ((algebraMap B D).comp (φ.comp c)) _ ?_ ?_ hae hbu
      · rfl
      · exact MvPolynomial.eval₂Hom_comp_C _ _



  have c7 : ∀ {Y : Scheme.{u}} (N₁ : Y.Opens) (hN₁ : IsAffineOpen N₁)
      (r : Γ(N₁.toScheme, ⊤)),
      ∃ (N : Y.Opens) (hNN : N ≤ N₁), IsAffineOpen N ∧
        @IsLocalization.Away _ _ r Γ(N.toScheme, ⊤) _ (Y.homOfLE hNN).appTop.hom.toAlgebra ∧
        ∀ (T : Scheme.{u}) (s : T ⟶ N₁.toScheme), IsUnit (s.appTop.hom r) →
          Set.range ⇑(s ≫ N₁.ι) ⊆ (N : Set Y) := by
    intro Y N₁ hN₁ r
    have hNe : N₁.ι ''ᵁ (N₁.toScheme).basicOpen r = Y.basicOpen r :=
      Scheme.Opens.ι_image_basicOpen N₁ r
    have hT : N₁.ι ''ᵁ ⊤ = N₁ := Scheme.Opens.ι_image_top N₁
    have hA : IsAffineOpen (N₁.ι ''ᵁ ⊤) := by rw [hT]; exact hN₁
    have hle : Y.basicOpen r ≤ N₁ := (Y.basicOpen_le r).trans hT.le
    refine ⟨Y.basicOpen r, hle, hA.basicOpen r, ?_, ?_⟩
    · have hT' : (Y.basicOpen r).ι ''ᵁ ⊤ = Y.basicOpen r := Scheme.Opens.ι_image_top _
      have hle' : (Y.basicOpen r).ι ''ᵁ ⊤ ≤ N₁.ι ''ᵁ ⊤ := by rw [hT', hT]; exact hle
      have := hA.isLocalization_of_eq_basicOpen r (homOfLE hle') hT'
      rw [Scheme.homOfLE_appTop]
      exact this
    · intro T s hs
      rintro _ ⟨x, rfl⟩
      rw [← hNe]
      refine ⟨s x, ?_, rfl⟩
      have h1 : s ⁻¹ᵁ (N₁.toScheme).basicOpen r = ⊤ := by
        rw [Scheme.Hom.preimage_basicOpen]
        exact T.basicOpen_of_isUnit hs
      have h2 : x ∈ s ⁻¹ᵁ (N₁.toScheme).basicOpen r := by rw [h1]; trivial
      exact h2



  have s4 : ∀ {K : Type u} [Field K] {Y : Scheme.{u}} (π : Y ⟶ Spec (.of K))
      [LocallyOfFiniteType π] {n : Type u} [Finite n] (U N₂ : Y.Opens) (hU : IsAffineOpen U)
      (hN₂ : IsAffineOpen N₂) (hN₂U : N₂ ≤ U)
      (v : n → Γ(U.toScheme, ⊤)) (hv : (MvPolynomial.eval₂Hom (U.ι ≫ π).appTop.hom v).Etale)
      (t : Y ⟶ Limits.pullback π π) (ht : t ≫ Limits.pullback.fst π π = 𝟙 Y)
      (g : N₂.toScheme ⟶ U.toScheme) (hg : g ≫ U.ι = (N₂.ι ≫ t) ≫ Limits.pullback.snd π π)
      (y : Spec (.of K) ⟶ Y) (hy : y ≫ π = 𝟙 _) (yN₂ : Spec (.of K) ⟶ N₂.toScheme)
      (hyN₂ : yN₂ ≫ N₂.ι = y)
      (hpb : IsPullback yN₂ y (N₂.ι ≫ t) (Limits.pullback.diagonal π)),
      ∃ (Nt : Y.Opens) (hNt : Nt ≤ N₂), Set.range ⇑y ⊆ (Nt : Set Y) ∧
        ∀ (N : Y.Opens) (hN : N ≤ Nt) (yN : Spec (.of K) ⟶ N.toScheme), yN ≫ N.ι = y →
          Etale (AffineSpace.homOfVector (N.ι ≫ π) (fun i =>
            (Y.homOfLE (hN.trans (hNt.trans hN₂U))).appTop.hom (v i) -
              (Y.homOfLE (hN.trans hNt) ≫ g).appTop.hom (v i))) ∧
          IsPullback yN (𝟙 _) (AffineSpace.homOfVector (N.ι ≫ π) (fun i =>
            (Y.homOfLE (hN.trans (hNt.trans hN₂U))).appTop.hom (v i) -
              (Y.homOfLE (hN.trans hNt) ≫ g).appTop.hom (v i)))
            (AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : n → Γ(Spec (.of K), ⊤))) := by
    intro K _ Y π _ n _ U N₂ hU hN₂ hN₂U v hv t ht g hg y hy yN₂ hyN₂ hpb
    haveI : IsAffine U.toScheme := hU
    haveI : IsAffine N₂.toScheme := hN₂

    have C8 : ∀ {N S : Scheme.{u}} [IsAffine N] (q : N ⟶ S) (w : n → Γ(N, ⊤))
        (s : S ⟶ N) (hs : s ≫ q = 𝟙 S) (hv0 : ∀ i, s.appTop.hom (w i) = 0)
        (hspan : ∀ f : Γ(N, ⊤), f - q.appTop.hom (s.appTop.hom f) ∈ Ideal.span (Set.range w)),
        IsPullback s (𝟙 S) (AffineSpace.homOfVector q w)
          (AffineSpace.homOfVector (𝟙 S) (0 : n → Γ(S, ⊤))) := by
      intro N S _ q w s hs hv0 hspan
      have hw : s ≫ AffineSpace.homOfVector q w =
          𝟙 S ≫ AffineSpace.homOfVector (𝟙 S) (0 : n → Γ(S, ⊤)) := by
        rw [AffineSpace.comp_homOfVector, hs, Category.id_comp]
        congr 1
        funext i
        exact hv0 i
      refine IsPullback.of_isLimit (c := Limits.PullbackCone.mk _ _ hw)
        (Limits.PullbackCone.IsLimit.mk hw (fun c => c.snd) ?_ ?_ ?_)
      · intro c
        have hcond := c.condition
        have hq : c.fst ≫ q = c.snd := by
          have h := congrArg (· ≫ AffineSpace (n) S ↘ S) hcond
          simp only [Category.assoc, AffineSpace.homOfVector_over, Category.comp_id] at h
          exact h
        have hα0 : ∀ i, c.fst.appTop.hom (w i) = 0 := by
          intro i
          have h : (c.fst ≫ AffineSpace.homOfVector q w).appTop.hom (AffineSpace.coord S i) =
              (c.snd ≫ AffineSpace.homOfVector (𝟙 S) (0 : n → Γ(S, ⊤))).appTop.hom
                (AffineSpace.coord S i) := by rw [hcond]
          rw [hca, hca, AffineSpace.homOfVector_appTop_coord,
            AffineSpace.homOfVector_appTop_coord] at h
          rw [h]
          simp
        have hle : Ideal.span (Set.range w) ≤ RingHom.ker c.fst.appTop.hom := by
          rw [Ideal.span_le]
          rintro _ ⟨i, rfl⟩
          exact hα0 i
        apply ext_of_isAffine
        ext f
        have h1 := hle (hspan f)
        rw [RingHom.mem_ker, map_sub, sub_eq_zero, ← hca, hq] at h1
        rw [hca, h1]
      · intro c
        exact Category.comp_id _
      · intro c m _ hm2
        rw [← hm2, Category.comp_id]

    have hφet : (Y.homOfLE hN₂U).appTop.hom.Etale :=
      (HasRingHomProperty.iff_of_isAffine (P := @Etale)).mp inferInstance
    have hcC : (MvPolynomial.eval₂Hom (U.ι ≫ π).appTop.hom v).comp MvPolynomial.C =
        (U.ι ≫ π).appTop.hom := MvPolynomial.eval₂Hom_comp_C _ _
    have hyt : y ≫ t = y ≫ Limits.pullback.diagonal π := by
      have h := hpb.w
      rw [← hyN₂, Category.assoc]; rw [← hyN₂] at h; exact h
    have hgπ : g ≫ U.ι ≫ π = N₂.ι ≫ π := by
      rw [← Category.assoc, hg]
      simp only [Category.assoc]
      rw [← Limits.pullback.condition, ← Category.assoc t, ht, Category.id_comp]
    have hφψ : (Y.homOfLE hN₂U).appTop.hom.comp
          ((MvPolynomial.eval₂Hom (U.ι ≫ π).appTop.hom v).comp MvPolynomial.C) =
        g.appTop.hom.comp
          ((MvPolynomial.eval₂Hom (U.ι ≫ π).appTop.hom v).comp MvPolynomial.C) := by
      rw [hcC, ← hcomp, ← hcomp, Scheme.homOfLE_ι_assoc, hgπ]
    have hyU : (yN₂ ≫ Y.homOfLE hN₂U) ≫ U.ι ≫ π = 𝟙 _ := by
      simp only [Category.assoc, Scheme.homOfLE_ι_assoc]
      rw [← Category.assoc, hyN₂, hy]
    have hsec : ∀ a, yN₂.appTop.hom ((Y.homOfLE hN₂U).appTop.hom
        ((MvPolynomial.eval₂Hom (U.ι ≫ π).appTop.hom v) (MvPolynomial.C a))) = a := by
      intro a
      rw [MvPolynomial.eval₂Hom_C, ← hca, ← hca, hyU, Scheme.Hom.id_appTop]
      rfl
    have hyg : yN₂ ≫ Y.homOfLE hN₂U = yN₂ ≫ g := by
      rw [← cancel_mono U.ι]
      simp only [Category.assoc]
      calc yN₂ ≫ Y.homOfLE hN₂U ≫ U.ι = y := by rw [Scheme.homOfLE_ι, hyN₂]
        _ = (y ≫ t) ≫ Limits.pullback.snd π π := by
            rw [hyt, Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id]
        _ = yN₂ ≫ g ≫ U.ι := by rw [hg, ← hyN₂]; simp only [Category.assoc]
    have hεφψ : yN₂.appTop.hom.comp (Y.homOfLE hN₂U).appTop.hom =
        yN₂.appTop.hom.comp g.appTop.hom := by
      rw [← hcomp, ← hcomp, hyg]
    have hker := c1 π U N₂ hU hN₂ hN₂U t ht g hg y yN₂ hpb
    haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian π
    haveI : IsNoetherianRing Γ(Y, N₂) := IsLocallyNoetherian.component_noetherian ⟨N₂, hN₂⟩
    haveI : IsNoetherianRing Γ(N₂.toScheme, ⊤) :=
      isNoetherianRing_of_ringEquiv _ N₂.topIso.symm.commRingCatIsoToRingEquiv

    obtain ⟨r, hεr, hr⟩ := c2 _ n _ _ (MvPolynomial.eval₂Hom (U.ι ≫ π).appTop.hom v)
      hv (Y.homOfLE hN₂U).appTop.hom g.appTop.hom hφet hφψ yN₂.appTop.hom hsec hεφψ hker

    obtain ⟨Nt, hNt, hNtA, hloc, hpts⟩ := c7 N₂ hN₂ r
    haveI : IsAffine Nt.toScheme := hNtA
    letI : Algebra Γ(N₂.toScheme, ⊤) Γ(Nt.toScheme, ⊤) := (Y.homOfLE hNt).appTop.hom.toAlgebra
    haveI := hloc
    have hunit : IsUnit (algebraMap Γ(N₂.toScheme, ⊤) Γ(Nt.toScheme, ⊤) r) :=
      IsLocalization.Away.algebraMap_isUnit r
    obtain ⟨hi, hii⟩ := hr r Γ(Nt.toScheme, ⊤) hunit
    have hyNt : Set.range ⇑y ⊆ (Nt : Set Y) := by
      have h := hpts _ yN₂ (by rw [hεr]; exact isUnit_one)
      rwa [hyN₂] at h
    have hyNtr : Set.range ⇑y ⊆ Set.range ⇑Nt.ι := by rw [Scheme.Opens.range_ι]; exact hyNt
    obtain ⟨yNt, hyNt1⟩ : ∃ yNt : Spec (.of K) ⟶ Nt.toScheme, yNt ≫ Nt.ι = y :=
      ⟨IsOpenImmersion.lift Nt.ι y hyNtr, IsOpenImmersion.lift_fac _ _ _⟩
    have hyNt2 : yNt ≫ Y.homOfLE hNt = yN₂ := by
      rw [← cancel_mono N₂.ι, Category.assoc, Scheme.homOfLE_ι, hyNt1, hyN₂]
    have hεD : yNt.appTop.hom.comp (algebraMap Γ(N₂.toScheme, ⊤) Γ(Nt.toScheme, ⊤)) =
        yN₂.appTop.hom := by
      show yNt.appTop.hom.comp (Y.homOfLE hNt).appTop.hom = _
      rw [← hcomp, hyNt2]
    have hqeq : (Nt.ι ≫ π).appTop.hom =
        (algebraMap Γ(N₂.toScheme, ⊤) Γ(Nt.toScheme, ⊤)).comp ((Y.homOfLE hN₂U).appTop.hom.comp
          ((MvPolynomial.eval₂Hom (U.ι ≫ π).appTop.hom v).comp MvPolynomial.C)) := by
      rw [hcC]
      show _ = (Y.homOfLE hNt).appTop.hom.comp ((Y.homOfLE hN₂U).appTop.hom.comp
        (U.ι ≫ π).appTop.hom)
      rw [← hcomp, ← hcomp, Scheme.homOfLE_ι_assoc, Scheme.homOfLE_ι_assoc]
    let w : n → Γ(Nt.toScheme, ⊤) := fun i =>
      algebraMap Γ(N₂.toScheme, ⊤) Γ(Nt.toScheme, ⊤)
        ((Y.homOfLE hN₂U).appTop.hom ((MvPolynomial.eval₂Hom (U.ι ≫ π).appTop.hom v)
          (MvPolynomial.X i)) -
         g.appTop.hom ((MvPolynomial.eval₂Hom (U.ι ≫ π).appTop.hom v) (MvPolynomial.X i)))
    have hhtet : Etale (AffineSpace.homOfVector (Nt.ι ≫ π) w) :=
      s1 _ w (by rw [hqeq]; exact hii)
    have hsq : yNt ≫ Nt.ι ≫ π = 𝟙 _ := by rw [← Category.assoc, hyNt1, hy]
    have hpbt : IsPullback yNt (𝟙 _) (AffineSpace.homOfVector (Nt.ι ≫ π) w)
        (AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : n → Γ(Spec (.of K), ⊤))) := by
      refine C8 (Nt.ι ≫ π) w yNt hsq ?_ ?_
      · intro i
        show yNt.appTop.hom (algebraMap Γ(N₂.toScheme, ⊤) Γ(Nt.toScheme, ⊤) _) = 0
        rw [← RingHom.comp_apply, hεD, map_sub, sub_eq_zero]
        exact RingHom.congr_fun hεφψ _
