    sheafOfModules_enoughInjectives _ _
  obtain ⟨eP⟩ := wc_etInv_unit_const O.ι
  have hvan : ∀ (I : SheafOfModules.{u+1} (wcEtZModRing O.toScheme ℓ)) [Injective I] (k : ℕ)
