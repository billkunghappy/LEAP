by
  classical
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY
  have hcases := wc_smooth_closed_reldim_cases K Y pY n m Z i
  obtain ⟨V, hV⟩ : ∃ V : Y.Opens, (V : Set Y) = (Set.range i)ᶜ :=
    ⟨⟨(Set.range i)ᶜ, i.isClosedEmbedding.isClosed_range.isOpen_compl⟩, rfl⟩
  refine wc_proet_closed_rightAdj_homology_zero_of_open_push i ℓ Di hDi Rs adj I V hV q (by omega)
    (fun hq1 => hcases.2 (by omega)) ?_
  intro hq2 Dj J
  obtain ⟨j, hj⟩ : ∃ j, q - 1 = j + 1 := ⟨q - 2, by omega⟩
  rw [hj]
  letI : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC V.ι) _ _ Dj.cont Dj.φ).Additive :=
    @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ Dj.adj Dj.additive
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (V : Scheme.{u}) ℓ)) := HasExt.standard _
  haveI := Dj.cont
