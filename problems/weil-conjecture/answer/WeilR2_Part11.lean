    [Fact (Nat.Prime ℓ)] (Dg : wcHMPullData g ℓ) (hDg : wcHMPullCanonical Dg)
    (I : InjectiveResolution (SheafOfModules.unit (wcRingSheaf O ℓ)))
    (t : ℕ) (ht : 1 ≤ t) (f : SheafOfModules.unit (wcRingSheaf O ℓ) ⟶ I.cocomplex.X t)
    (hf : f ≫ I.cocomplex.d t (t + 1) = 0)
    (W : U.ProEt) (DV : wcHMPullData ((wcProEtBC g).obj W).hom ℓ) (hDV : wcHMPullCanonical DV)
    (hK : letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf O ℓ)) := HasExt.standard _
      letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf ((wcProEtBC g).obj W).left ℓ)) :=
        HasExt.standard _
      Function.Bijective (fun x : C(↥W.left, ULift.{u+1} ℚ_[ℓ]) =>
        (Abelian.Ext.mk₀ (wcHMFun ((wcProEtBC g).obj W).left ℓ
          (x.comp (Limits.pullback.fst W.hom g).base.hom))).comp
          (wcHMPull DV t (I.extMk f (t + 1) rfl hf)) (zero_add t))) :
    (∀ s : (I.cocomplex.X t).val.obj (Opposite.op ((wcProEtBC g).obj W)),
      ((I.cocomplex.d t (t + 1)).val.app (Opposite.op ((wcProEtBC g).obj W))).hom s = 0 →
      ∃ (c : (wcRingSheaf U ℓ).obj.obj (Opposite.op W))
        (y : (I.cocomplex.X ((ComplexShape.up ℕ).prev t)).val.obj
          (Opposite.op ((wcProEtBC g).obj W))),
        s = (f.val.app (Opposite.op ((wcProEtBC g).obj W))).hom
            ((Dg.φ.hom.app (Opposite.op W)).hom c) +
          ((I.cocomplex.d ((ComplexShape.up ℕ).prev t) t).val.app
            (Opposite.op ((wcProEtBC g).obj W))).hom y) ∧
    (∀ (c : (wcRingSheaf U ℓ).obj.obj (Opposite.op W))
      (y : (I.cocomplex.X ((ComplexShape.up ℕ).prev t)).val.obj
        (Opposite.op ((wcProEtBC g).obj W))),
      (f.val.app (Opposite.op ((wcProEtBC g).obj W))).hom ((Dg.φ.hom.app (Opposite.op W)).hom c) =
        ((I.cocomplex.d ((ComplexShape.up ℕ).prev t) t).val.app
          (Opposite.op ((wcProEtBC g).obj W))).hom y →
      c = 0) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf O ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf ((wcProEtBC g).obj W).left ℓ)) :=
    HasExt.standard _

  obtain ⟨P, ev, hnat, hadd⟩ := sheafOfModules_free_yoneda (Scheme.ProEt.topology O)
    (wcRingSheaf O ℓ) ((wcProEtBC g).obj W)
  have hev0 : ∀ M, ev M 0 = 0 := fun M => map_zero (AddMonoidHom.mk' (ev M) (hadd M))

  obtain ⟨Θ, hΘ⟩ := wc_proet_free_slice_module_ext O ℓ ((wcProEtBC g).obj W) P ev hnat hadd
    DV hDV t
  have hΘK : ∀ x : C(↥W.left, ULift.{u+1} ℚ_[ℓ]),
      Θ ((Abelian.Ext.mk₀ ((ev (SheafOfModules.unit (wcRingSheaf O ℓ))).symm
          ((Dg.φ.hom.app (Opposite.op W)).hom x))).comp (I.extMk f (t + 1) rfl hf) (zero_add t)) =
        (Abelian.Ext.mk₀ (wcHMFun ((wcProEtBC g).obj W).left ℓ
          (x.comp (Limits.pullback.fst W.hom g).base.hom))).comp
          (wcHMPull DV t (I.extMk f (t + 1) rfl hf)) (zero_add t) := by
    intro x
    refine (hΘ _ _).trans ?_
    exact congrArg (fun r => (Abelian.Ext.mk₀ (wcHMFun ((wcProEtBC g).obj W).left ℓ r)).comp
      (wcHMPull DV t (I.extMk f (t + 1) rfl hf)) (zero_add t)) (hDg W x)

  have hcob : ∀ (n : ℕ) (g₀ : P ⟶ I.cocomplex.X n) (hg : g₀ ≫ I.cocomplex.d n (n + 1) = 0)
      (k' : P ⟶ I.cocomplex.X ((ComplexShape.up ℕ).prev n)),
      g₀ = k' ≫ I.cocomplex.d ((ComplexShape.up ℕ).prev n) n →
      I.extMk g₀ (n + 1) rfl hg = 0 := by
    intro n
    cases n with
    | zero =>
      intro g₀ hg k' hk'
      have hd : I.cocomplex.d ((ComplexShape.up ℕ).prev 0) 0 = 0 :=
        I.cocomplex.shape _ _ (by rw [ComplexShape.up_Rel]; omega)
      have hg0 : g₀ = 0 := by rw [hk', hd, Limits.comp_zero]
      subst hg0
      exact I.extMk_zero _ _
    | succ p =>
      intro g₀ hg k' hk'
      rw [I.extMk_eq_zero_iff g₀ (p + 1 + 1) rfl hg p rfl]
      refine ⟨k' ≫ (I.cocomplex.XIsoOfEq (CochainComplex.prev_nat_succ p)).hom, ?_⟩
      rw [Category.assoc, HomologicalComplex.XIsoOfEq_hom_comp_d, ← hk']
  have hfun0 : ∀ (S : Scheme.{u}), wcHMFun S ℓ 0 = 0 := by
    intro S
    apply (SheafOfModules.unitHomEquiv _).injective
    apply PresheafOfModules.sections_ext
    intro V
    simp only [wcHMFun, Equiv.apply_symm_apply]
    rw [SheafOfModules.unitHomEquiv_apply_coe]
    exact ContinuousMap.ext (fun x => rfl)
  refine ⟨fun s hs => ?_, fun c y hcy => ?_⟩
  ·
    obtain ⟨g', hgs⟩ : ∃ g' : P ⟶ I.cocomplex.X t, ev _ g' = s :=
      ⟨(ev _).symm s, Equiv.apply_symm_apply _ _⟩
    have hg' : g' ≫ I.cocomplex.d t (t + 1) = 0 := by
      apply (ev _).injective
      rw [hnat, hgs, hs, hev0]
    obtain ⟨x, hx⟩ := hK.2 (Θ (I.extMk g' (t + 1) rfl hg'))
    obtain ⟨ρ, hρ⟩ : ∃ ρ : P ⟶ SheafOfModules.unit (wcRingSheaf O ℓ),
        ρ = (ev _).symm ((Dg.φ.hom.app (Opposite.op W)).hom x) := ⟨_, rfl⟩
    have hu : (ρ ≫ f) ≫ I.cocomplex.d t (t + 1) = 0 := by
      rw [Category.assoc, hf, Limits.comp_zero]
    have e1 : I.extMk (ρ ≫ f) (t + 1) rfl hu =
        (Abelian.Ext.mk₀ ρ).comp (I.extMk f (t + 1) rfl hf) (zero_add t) := by
      rw [InjectiveResolution.mk₀_comp_extMk]
    have hext : I.extMk g' (t + 1) rfl hg' =
        ∑ a : Fin 1, I.extMk ((fun _ : Fin 1 => ρ ≫ f) a) (t + 1) rfl ((fun _ : Fin 1 => hu) a) := by
      rw [Fin.sum_univ_one]
      apply Θ.injective
      show Θ (I.extMk g' (t + 1) rfl hg') = Θ (I.extMk (ρ ≫ f) (t + 1) rfl hu)
      rw [e1, hρ, hΘK]
      exact hx.symm
    obtain ⟨k, hk⟩ := injectiveResolution_coboundary_of_extMk_eq_sum I t 1 g' hg'
      (fun _ : Fin 1 => ρ ≫ f) (fun _ : Fin 1 => hu) hext
    simp only [Fin.sum_univ_one] at hk
    have hρe : ev _ ρ = (Dg.φ.hom.app (Opposite.op W)).hom x := by
      rw [hρ]
      exact Equiv.apply_symm_apply _ _
    refine ⟨x, ev _ k, ?_⟩
    rw [← hgs, hk, hadd, hnat, hnat, hρe]
  ·
    obtain ⟨ρ, hρ⟩ : ∃ ρ : P ⟶ SheafOfModules.unit (wcRingSheaf O ℓ),
        ρ = (ev _).symm ((Dg.φ.hom.app (Opposite.op W)).hom c) := ⟨_, rfl⟩
    have hρe : ev _ ρ = (Dg.φ.hom.app (Opposite.op W)).hom c := by
      rw [hρ]
      exact Equiv.apply_symm_apply _ _
    obtain ⟨k, hk⟩ : ∃ k : P ⟶ I.cocomplex.X ((ComplexShape.up ℕ).prev t), ev _ k = y :=
      ⟨(ev _).symm y, Equiv.apply_symm_apply _ _⟩
    have hsum : ρ ≫ f = k ≫ I.cocomplex.d ((ComplexShape.up ℕ).prev t) t := by
      apply (ev (I.cocomplex.X t)).injective
      rw [hnat, hnat, hρe, hk]
      exact hcy
    have hu : (ρ ≫ f) ≫ I.cocomplex.d t (t + 1) = 0 := by
      rw [Category.assoc, hf, Limits.comp_zero]
    have hvan : (Abelian.Ext.mk₀ ρ).comp (I.extMk f (t + 1) rfl hf) (zero_add t) = 0 := by
      rw [InjectiveResolution.mk₀_comp_extMk]
      exact hcob t _ hu k hsum
    have hKc : (Abelian.Ext.mk₀ (wcHMFun ((wcProEtBC g).obj W).left ℓ
          ((c : C(↥W.left, ULift.{u+1} ℚ_[ℓ])).comp (Limits.pullback.fst W.hom g).base.hom))).comp
          (wcHMPull DV t (I.extMk f (t + 1) rfl hf)) (zero_add t) = 0 := by
      have h1 := hΘK c
      rw [← hρ, hvan, map_zero] at h1
      exact h1.symm
    have hK0 : (Abelian.Ext.mk₀ (wcHMFun ((wcProEtBC g).obj W).left ℓ
          ((0 : C(↥W.left, ULift.{u+1} ℚ_[ℓ])).comp (Limits.pullback.fst W.hom g).base.hom))).comp
          (wcHMPull DV t (I.extMk f (t + 1) rfl hf)) (zero_add t) = 0 := by
      have h0 : (0 : C(↥W.left, ULift.{u+1} ℚ_[ℓ])).comp (Limits.pullback.fst W.hom g).base.hom = 0 :=
        ContinuousMap.ext (fun _ => rfl)
      have hz : ∀ (r : C(↥((wcProEtBC g).obj W).left, ULift.{u+1} ℚ_[ℓ]))
          (z : wcHM ((wcProEtBC g).obj W).left ℓ t),
          r = 0 → (Abelian.Ext.mk₀ (wcHMFun ((wcProEtBC g).obj W).left ℓ r)).comp z
            (zero_add t) = 0 := by
        intro r z hr
        subst hr
        rw [hfun0, Abelian.Ext.mk₀_zero, Abelian.Ext.zero_comp]
      exact hz _ _ h0
    have hc : (c : C(↥W.left, ULift.{u+1} ℚ_[ℓ])) = 0 := hK.1 (hKc.trans hK0.symm)
    exact hc

theorem wc_supp_unit_map_twist_factor {S S' : Scheme.{u}} {f : S' ⟶ S} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (D : wcHMPullData f ℓ) (hD : wcHMPullCanonical D) :
    wcSuppUnitMap D = @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ ≫
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ).map
        (wcHMFun S' ℓ (wcSuppTwist (wcSuppUnitMap D))) :=
by
  classical
  letI := D.cont
  have hlam1 : Limits.pullback.lift f (𝟙 S') ((Category.comp_id f).trans (Category.id_comp f).symm) ≫
      Limits.pullback.fst (𝟙 S) f = f := Limits.pullback.lift_fst _ _ _
  have hlam2 : Limits.pullback.lift f (𝟙 S') ((Category.comp_id f).trans (Category.id_comp f).symm) ≫
      Limits.pullback.snd (𝟙 S) f = 𝟙 S' := Limits.pullback.lift_snd _ _ _
  apply (SheafOfModules.unitHomEquiv _).injective
  apply Subtype.ext
  funext X
  obtain ⟨V⟩ := X
  let T : S.ProEt := MorphismProperty.Over.mk ⊤ (𝟙 S) (inferInstance : WeaklyEtale (𝟙 S))
  let e : V ⟶ T := MorphismProperty.Over.homMk V.hom (Category.comp_id V.hom) trivial
  let β : Limits.pullback V.hom f ⟶ Limits.pullback (𝟙 S) f := ((wcProEtBC f).map e).left
  have hβw : β ≫ Limits.pullback.snd (𝟙 S) f = Limits.pullback.snd V.hom f :=
    MorphismProperty.Over.w ((wcProEtBC f).map e)
  have hβ : β = Limits.pullback.snd V.hom f ≫
      Limits.pullback.lift f (𝟙 S') ((Category.comp_id f).trans (Category.id_comp f).symm) := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hlam1, ← hβw, Category.assoc, ← Limits.pullback.condition,
        Category.comp_id]
    · rw [Category.assoc, hlam2, Category.comp_id, hβw]
  let m1 : C(↥(Limits.pullback V.hom f), ULift.{u+1} ℚ_[ℓ]) :=
    ((wcSuppUnitMap D).val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))
  let mT : C(↥(Limits.pullback (𝟙 S) f), ULift.{u+1} ℚ_[ℓ]) :=
    ((wcSuppUnitMap D).val.app (Opposite.op T)).hom (1 : C(↥S, ULift.{u+1} ℚ_[ℓ]))
  have e1 : m1 = mT.comp β.base.hom :=
    PresheafOfModules.naturality_apply (wcSuppUnitMap D).val e.op (1 : C(↥S, ULift.{u+1} ℚ_[ℓ]))
  have e3 : mT.comp (Limits.pullback.snd V.hom f ≫
      Limits.pullback.lift f (𝟙 S') ((Category.comp_id f).trans (Category.id_comp f).symm)).base.hom =
      (wcSuppTwist (wcSuppUnitMap D)).comp (Limits.pullback.snd V.hom f).base.hom :=
    ContinuousMap.ext fun _ => rfl
  have hL : m1 = (wcSuppTwist (wcSuppUnitMap D)).comp (Limits.pullback.snd V.hom f).base.hom := by
    rw [e1, hβ, e3]
  let h := wcHMFun S' ℓ (wcSuppTwist (wcSuppUnitMap D))
  let r1 : C(↥(Limits.pullback V.hom f), ULift.{u+1} ℚ_[ℓ]) :=
    (h.val.app (Opposite.op ((wcProEtBC f).obj V))).hom
      (1 : C(↥(Limits.pullback V.hom f), ULift.{u+1} ℚ_[ℓ]))
  have hR : r1 = (wcSuppTwist (wcSuppUnitMap D)).comp (Limits.pullback.snd V.hom f).base.hom := by
    have e4 : r1 = (SheafOfModules.unitHomEquiv _ h).1 (Opposite.op ((wcProEtBC f).obj V)) :=
      (SheafOfModules.unitHomEquiv_apply_coe _ _ _).symm
    rw [e4]
    simp only [h]
    unfold wcHMFun
    rw [Equiv.apply_symm_apply]
    rfl
  show m1 = (h.val.app (Opposite.op ((wcProEtBC f).obj V))).hom
    ((D.φ.hom.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ])))
  have key := congrArg (fun x => (h.val.app (Opposite.op ((wcProEtBC f).obj V))).hom x)
    ((D.φ.hom.app (Opposite.op V)).hom.map_one)
  exact hL.trans (hR.symm.trans key.symm)

theorem wc_hm_pull_fun {S S' : Scheme.{u}} {f : S' ⟶ S} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (D : wcHMPullData f ℓ) (hD : wcHMPullCanonical D) (r : C(↥S, ULift.{u+1} ℚ_[ℓ])) (j : ℕ)
    (x : wcHM S ℓ j) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    wcHMPull D j ((Abelian.Ext.mk₀ (wcHMFun S ℓ r)).comp x (zero_add j)) =
      (Abelian.Ext.mk₀ (wcHMFun S' ℓ (r.comp f.base.hom))).comp (wcHMPull D j x) (zero_add j) :=
by
  classical
  have key : ∀ g : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ).obj
        (SheafOfModules.unit (wcRingSheaf S' ℓ)),
      wcHMFun S ℓ r ≫ g =
        g ≫ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ).map
          (wcHMFun S' ℓ (r.comp f.base.hom)) := by
    intro g
    apply (SheafOfModules.unitHomEquiv _).injective
    apply PresheafOfModules.sections_ext
    intro X
    cases X with
    | op V =>
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    obtain ⟨a, b, hab, ha1, ha2⟩ : ∃ (a : ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V)))
        (b : ↑((wcRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj V)))),
        @Eq ↑((wcRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj V)))
          ((D.φ.hom.app (Opposite.op V)).hom a) b ∧
        (∀ r' : ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V)),
          @Eq ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V))
            (((wcHMFun S ℓ r).val.app (Opposite.op V)).hom r') (r' * a)) ∧
        (∀ r' : ↑((wcRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj V))),
          @Eq ↑((wcRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj V)))
            (((wcHMFun S' ℓ (r.comp f.base.hom)).val.app
              (Opposite.op ((wcProEtBC f).obj V))).hom r') (r' * b)) :=
      ⟨(r.comp V.hom.base.hom : C(↥V.left, ULift.{u+1} ℚ_[ℓ])),
        ((r.comp f.base.hom).comp ((wcProEtBC f).obj V).hom.base.hom :
          C(↥((wcProEtBC f).obj V).left, ULift.{u+1} ℚ_[ℓ])),
        (hD V _).trans (ContinuousMap.ext fun x =>
          congrArg (fun k => r (k.base x)) (Limits.pullback.condition (f := V.hom) (g := f))),
        fun r' => rfl, fun r' => rfl⟩
    change (g.val.app (Opposite.op V)).hom (((wcHMFun S ℓ r).val.app (Opposite.op V)).hom
          (@id ↑((SheafOfModules.unit (wcRingSheaf S ℓ)).val.obj (Opposite.op V))
            (1 : ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V))))) =
        ((wcHMFun S' ℓ (r.comp f.base.hom)).val.app (Opposite.op ((wcProEtBC f).obj V))).hom
          ((g.val.app (Opposite.op V)).hom
            (@id ↑((SheafOfModules.unit (wcRingSheaf S ℓ)).val.obj (Opposite.op V))
              (1 : ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V)))))
    have e1 : ((wcHMFun S ℓ r).val.app (Opposite.op V)).hom
          (@id ↑((SheafOfModules.unit (wcRingSheaf S ℓ)).val.obj (Opposite.op V))
            (1 : ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V)))) =
        a • (@id ↑((SheafOfModules.unit (wcRingSheaf S ℓ)).val.obj (Opposite.op V))
            (1 : ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V)))) := by
      have h := ha1 1
      change @Eq ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V))
        (((wcHMFun S ℓ r).val.app (Opposite.op V)).hom
          (1 : ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V))))
        (a * 1)
      rw [h, one_mul, mul_one]
    rw [e1, LinearMap.map_smul]
    generalize (g.val.app (Opposite.op V)).hom
      (@id ↑((SheafOfModules.unit (wcRingSheaf S ℓ)).val.obj (Opposite.op V))
        (1 : ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V)))) = y
    have h2 := ha2 y
    refine Eq.trans ?_ h2.symm
    change @Eq ↑((wcRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj V)))
      (@HMul.hMul ↑((wcRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj V)))
        ↑((wcRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj V)))
        ↑((wcRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj V))) instHMul
        ((D.φ.hom.app (Opposite.op V)).hom a) y)
      (@HMul.hMul ↑((wcRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj V)))
        ↑((wcRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj V)))
        ↑((wcRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj V))) instHMul y b)
    rw [hab]
    exact @mul_comm C(↥(Limits.pullback V.hom f), ULift.{u+1} ℚ_[ℓ]) _ b y
  have hmate : D.Φ.map (wcHMFun S ℓ r) ≫ D.μ.hom =
      D.μ.hom ≫ wcHMFun S' ℓ (r.comp f.base.hom) := by
    apply (D.adj.homEquiv _ _).injective
    rw [Adjunction.homEquiv_naturality_left, Adjunction.homEquiv_naturality_right]
    exact key _
  have hmate' : D.μ.inv ≫ D.Φ.map (wcHMFun S ℓ r) =
      wcHMFun S' ℓ (r.comp f.base.hom) ≫ D.μ.inv := by
    calc D.μ.inv ≫ D.Φ.map (wcHMFun S ℓ r)
        = D.μ.inv ≫ D.Φ.map (wcHMFun S ℓ r) ≫ D.μ.hom ≫ D.μ.inv := by
          rw [Iso.hom_inv_id, Category.comp_id]
      _ = D.μ.inv ≫ D.μ.hom ≫ wcHMFun S' ℓ (r.comp f.base.hom) ≫ D.μ.inv := by
          rw [← Category.assoc (D.Φ.map (wcHMFun S ℓ r)), hmate, Category.assoc]
      _ = wcHMFun S' ℓ (r.comp f.base.hom) ≫ D.μ.inv := by
          rw [Iso.inv_hom_id_assoc]
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
  haveI := D.additive
  haveI := D.presLim
  haveI := D.presColim
  show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ
        ((Abelian.Ext.mk₀ (wcHMFun S ℓ r)).comp x (zero_add j))).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero j)) (zero_add j) =
      (Abelian.Ext.mk₀ (wcHMFun S' ℓ (r.comp f.base.hom))).comp
        ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ x).comp
          (Abelian.Ext.mk₀ D.μ.hom) (add_zero j)) (zero_add j)) (zero_add j)
  rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
  generalize Abelian.Ext.mapExactFunctor D.Φ x = z
  rw [Abelian.Ext.comp_assoc_of_third_deg_zero]
  generalize z.comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero j) = w
  rw [← Abelian.Ext.comp_assoc_of_second_deg_zero (Abelian.Ext.mk₀ D.μ.inv)
      (Abelian.Ext.mk₀ (D.Φ.map (wcHMFun S ℓ r))) w,
    ← Abelian.Ext.comp_assoc_of_second_deg_zero
      (Abelian.Ext.mk₀ (wcHMFun S' ℓ (r.comp f.base.hom))) (Abelian.Ext.mk₀ D.μ.inv) w,
    Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, hmate']

theorem wc_hm_fun_one_mul (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    wcHMFun S ℓ 1 = 𝟙 _ ∧ ∀ r r' : C(↥S, ULift.{u+1} ℚ_[ℓ]),
      wcHMFun S ℓ (r * r') = wcHMFun S ℓ r ≫ wcHMFun S ℓ r' :=
by
  refine ⟨?_, ?_⟩
  · apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext V
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    rw [← SheafOfModules.unitHomEquiv_apply_coe]
    simp only [wcHMFun, Equiv.apply_symm_apply]
    rfl
  · intro r r'
    apply (SheafOfModules.unitHomEquiv _).injective
    rw [SheafOfModules.unitHomEquiv_comp_apply]
    apply Subtype.ext
    funext V
    have hvalP : ∀ c : C(↥S, ULift.{u+1} ℚ_[ℓ]),
        ((SheafOfModules.unitHomEquiv _) (wcHMFun S ℓ c)).1 V =
        (c.comp (Opposite.unop V).hom.base.hom :
          C(↥((Opposite.unop V).left), ULift.{u+1} ℚ_[ℓ])) := by
      intro c
      simp only [wcHMFun, Equiv.apply_symm_apply]
      rfl
    show _ = ((wcHMFun S ℓ r').val.app V).hom (((SheafOfModules.unitHomEquiv _) (wcHMFun S ℓ r)).1 V)
    rw [hvalP, hvalP]
    apply ContinuousMap.ext
    intro x
    rfl

theorem wc_punct_bundle_push_top_iso (F : Type u) [Finite F] [Field F] (d ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F) (hd : 1 ≤ d)
    {U : Scheme.{u}} (qU : U ⟶ Spec (.of (AlgebraicClosure F)))
    [IsLocallyNoetherian U] [CompactSpace U] [LocallyOfFiniteType qU] [Smooth qU]
    (OU : (AffineSpace (ULift.{u} (Fin d)) U).Opens)
    (hOU : (OU : Set ↥(AffineSpace (ULift.{u} (Fin d)) U)) =
      (Set.range (AffineSpace.homOfVector (𝟙 U) (0 : ULift.{u} (Fin d) → Γ(U, ⊤))))ᶜ)
    (OK : (wcTlAff F d).Opens) (hOK : (OK : Set ↥(wcTlAff F d)) = (Set.range (wcTlZero F d))ᶜ)
    (prO : OU.toScheme ⟶ OK.toScheme)
    (hprO : prO ≫ OK.ι = OU.ι ≫ AffineSpace.map (ULift.{u} (Fin d)) qU)
    (DprO : wcHMPullData prO ℓ) (hDprO : wcHMPullCanonical DprO)
    (Dg : wcHMPullData (OU.ι ≫ (AffineSpace (ULift.{u} (Fin d)) U ↘ U)) ℓ) (hDg : wcHMPullCanonical Dg) :
    ∃ ω : wcHM OK.toScheme ℓ (2 * d - 1),
      ∀ (I : InjectiveResolution (SheafOfModules.unit (wcRingSheaf OU.toScheme ℓ)))
        (c : Dg.Φ.obj (SheafOfModules.unit (wcRingSheaf U ℓ)) ⟶ I.cocomplex.X (2 * d - 1))
        (hc : c ≫ I.cocomplex.d (2 * d - 1) (2 * d - 1 + 1) = 0),
        letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf OU.toScheme ℓ)) := HasExt.standard _
        letI : (@SheafOfModules.pushforward _ _ _ _ _ _
            (wcProEtBC (OU.ι ≫ (AffineSpace (ULift.{u} (Fin d)) U ↘ U))) _ _ Dg.cont Dg.φ).Additive :=
          @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ Dg.adj Dg.additive
        I.extMk c (2 * d - 1 + 1) rfl hc =
            (Abelian.Ext.mk₀ Dg.μ.hom).comp (wcHMPull DprO (2 * d - 1) ω) (zero_add _) →
        ∀ (hf : Dg.adj.homEquiv _ _ c ≫ (((@SheafOfModules.pushforward _ _ _ _ _ _
            (wcProEtBC (OU.ι ≫ (AffineSpace (ULift.{u} (Fin d)) U ↘ U))) _ _ Dg.cont Dg.φ).mapHomologicalComplex
            (ComplexShape.up ℕ)).obj I.cocomplex).d (2 * d - 1) (2 * d - 1 + 1) = 0),
        IsIso ((((@SheafOfModules.pushforward _ _ _ _ _ _
            (wcProEtBC (OU.ι ≫ (AffineSpace (ULift.{u} (Fin d)) U ↘ U))) _ _ Dg.cont Dg.φ).mapHomologicalComplex
            (ComplexShape.up ℕ)).obj I.cocomplex).liftCycles (Dg.adj.homEquiv _ _ c) (2 * d - 1 + 1) (by simp) hf ≫
          (((@SheafOfModules.pushforward _ _ _ _ _ _
            (wcProEtBC (OU.ι ≫ (AffineSpace (ULift.{u} (Fin d)) U ↘ U))) _ _ Dg.cont Dg.φ).mapHomologicalComplex
            (ComplexShape.up ℕ)).obj I.cocomplex).homologyπ (2 * d - 1)) :=
by
  classical
  obtain ⟨ω, hω⟩ := wc_punct_K_top_line F d ℓ hℓ hd OK hOK
  refine ⟨ω, ?_⟩

  have hsq := wc_punct_bundle_open_isPullback F d qU OU hOU OK hOK prO hprO
  haveI : IsLocallyNoetherian (AffineSpace (ULift.{u} (Fin d)) U) :=
    (wc_tl_zero_section_facts F d qU).2.2.2 inferInstance
