    show _ = ((SheafOfModules.unitHomEquiv _) (wcZModFun S m r)).1 V +
      ((SheafOfModules.unitHomEquiv _) (wcZModFun S m r')).1 V
    rw [hvalP, hvalP]
    apply ContinuousMap.ext
    intro x
    rfl
  obtain ⟨χ, hχdef⟩ : ∃ χ : ∀ O : Set W.left, IsClopen O →
      C(↥(Limits.pullback W.hom V.ι : Scheme.{u}), ULift.{u+1} (ZMod ℓ)),
      ∀ (O : Set W.left) (hO : IsClopen O), χ O hO =
        (LocallyConstant.charFn (ULift.{u+1} (ZMod ℓ)) hO).toContinuousMap.comp
          (Limits.pullback.fst W.hom V.ι).base.hom :=
    ⟨_, fun _ _ => rfl⟩
  have hχ : ∀ (O : Set W.left) (hO : IsClopen O) (x : ↥(Limits.pullback W.hom V.ι : Scheme.{u})),
      χ O hO x = O.indicator 1 ((Limits.pullback.fst W.hom V.ι).base.hom x) := by
    intro O hO x
    rw [hχdef]
    show (LocallyConstant.charFn (ULift.{u+1} (ZMod ℓ)) hO)
      ((Limits.pullback.fst W.hom V.ι).base.hom x) = _
    rw [LocallyConstant.coe_charFn]
  obtain ⟨e, he⟩ : ∃ e : ∀ O : Set W.left, IsClopen O →
      (wcZModProEtExt (Limits.pullback W.hom V.ι) ℓ k →+
        wcZModProEtExt (Limits.pullback W.hom V.ι) ℓ k),
      ∀ (O : Set W.left) (hO : IsClopen O) h, e O hO h =
        (Abelian.Ext.mk₀ (wcZModFun (Limits.pullback W.hom V.ι) ℓ (χ O hO))).comp h (zero_add k) :=
    ⟨fun O hO => (Abelian.Ext.mk₀ (wcZModFun
      (Limits.pullback W.hom V.ι) ℓ (χ O hO))).precomp _ (zero_add k), fun _ _ _ => rfl⟩
  have G0 : ∀ (T : Scheme.{u}) (r r' : C(↥T, ULift.{u+1} (ZMod ℓ))), r = r' →
      ∀ h : wcZModProEtExt T ℓ k,
