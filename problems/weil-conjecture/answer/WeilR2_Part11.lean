            (τ.comp ((wcProEtBC g).obj W').hom.base.hom))).comp
            (wcHMPull D' (2 * d - 1) ω) (zero_add (2 * d - 1))) (zero_add (2 * d - 1))) =
        (fun z : wcHM ((wcProEtBC g).obj W').left ℓ (2 * d - 1) =>
          (Abelian.Ext.mk₀ (wcHMFun ((wcProEtBC g).obj W').left ℓ
            (τ.comp ((wcProEtBC g).obj W').hom.base.hom))).comp z (zero_add (2 * d - 1))) ∘
        (fun x : C(↥W'.left, ULift.{u+1} ℚ_[ℓ]) =>
          (Abelian.Ext.mk₀ (wcHMFun ((wcProEtBC g).obj W').left ℓ
            (x.comp (Limits.pullback.fst W'.hom g).base.hom))).comp
            (wcHMPull D' (2 * d - 1) ω) (zero_add (2 * d - 1))) := by
      funext x
      simp only [Function.comp_apply]
      rw [hFF, hFF]
      exact congrArg (fun r => (Abelian.Ext.mk₀ (wcHMFun ((wcProEtBC g).obj W').left ℓ r)).comp
        (wcHMPull D' (2 * d - 1) ω) (zero_add (2 * d - 1))) (mul_comm _ _)
    rw [heq]
