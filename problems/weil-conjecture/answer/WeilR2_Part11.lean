    (P := ObjectProperty.singleton (separator (SheafOfModules.{u+1} (wcRingSheaf Z ℓ))))
    (isSeparator_separator _)
    (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ)

theorem ext_shifted_degenerate_leray_injective {C : Type*} {D : Type*} [Category C] [Category D]
    [Abelian C] [Abelian D] (L : D ⥤ C) (R : C ⥤ D) [L.Additive] [Limits.PreservesFiniteLimits L]
    [Limits.PreservesFiniteColimits L] [R.Additive] (adj : L ⊣ R) (A : C)
    (I : InjectiveResolution A) (P : D) (t : ℕ)
    (ψ : P ⟶ ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology t) [IsIso ψ]
    (hvan : ∀ q : ℕ, q ≠ t →
      Limits.IsZero (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q)) :
    letI := HasExt.standard C; letI := HasExt.standard D;
    ∃ τ : Abelian.Ext (L.obj P) A t, ∀ (j N : ℕ) (h : j + t = N) (b : Abelian.Ext P P j),
      (Abelian.Ext.mapExactFunctor L b).comp τ h = 0 → b = 0 :=
by
  letI instC : HasExt C := HasExt.standard C
  letI instD : HasExt D := HasExt.standard D
  haveI := adj.rightAdjoint_preservesLimits
  haveI : L.PreservesMonomorphisms := inferInstance
  obtain ⟨ψinv, hψ1, -⟩ := (inferInstance : IsIso ψ)
  let J := (R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex

  let T : ∀ (Y : C) (m : ℕ), Abelian.Ext P (R.obj Y) m →+ Abelian.Ext (L.obj P) Y m :=
    fun Y m => AddMonoidHom.mk'
      (fun α => (Abelian.Ext.mapExactFunctor L α).comp (Abelian.Ext.mk₀ (adj.counit.app Y))
        (add_zero m))
      (fun a b => by rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.add_comp])
  have hT : ∀ (Y : C) (m : ℕ) (α : Abelian.Ext P (R.obj Y) m),
      T Y m α = (Abelian.Ext.mapExactFunctor L α).comp (Abelian.Ext.mk₀ (adj.counit.app Y))
        (add_zero m) := fun _ _ _ => rfl
  have s1a : ∀ {Y Y' : C} (g : Y ⟶ Y') (m : ℕ) (v : Abelian.Ext P (R.obj Y) m),
      T Y' m (v.comp (Abelian.Ext.mk₀ (R.map g)) (add_zero m)) =
        (T Y m v).comp (Abelian.Ext.mk₀ g) (add_zero m) := by
    intro Y Y' g m v
    have e1 : L.map (R.map g) ≫ adj.counit.app Y' = adj.counit.app Y ≫ g :=
      adj.counit_naturality g
    rw [hT, hT, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc _ _ _ (add_zero m) (zero_add 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, e1,
      Abelian.Ext.comp_assoc _ _ _ (add_zero m) (zero_add 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀]
  have s1b : ∀ (S : ShortComplex C) (hS : S.ShortExact) (hRS : (S.map R).ShortExact) (m : ℕ)
      (z : Abelian.Ext P (S.map R).X₃ m),
      (Abelian.Ext.mapExactFunctor L (z.comp hRS.extClass rfl)).comp
          (Abelian.Ext.mk₀ (adj.counit.app S.X₁)) (add_zero (m + 1)) =
        ((Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ (adj.counit.app S.X₃))
          (add_zero m)).comp hS.extClass rfl := by
    intro S hS hRS m z
    have h₁ : ((S.map R).map L).ShortExact := hRS.map_of_exact L
    have hnat : h₁.extClass.comp (Abelian.Ext.mk₀ (adj.counit.app S.X₁)) (add_zero 1) =
        (Abelian.Ext.mk₀ (adj.counit.app S.X₃)).comp hS.extClass (zero_add 1) :=
      h₁.extClass_naturality hS
        { τ₁ := adj.counit.app S.X₁
          τ₂ := adj.counit.app S.X₂
          τ₃ := adj.counit.app S.X₃
          comm₁₂ := (adj.counit_naturality S.f).symm
          comm₂₃ := (adj.counit_naturality S.g).symm }
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass,
      Abelian.Ext.comp_assoc _ _ _ rfl (add_zero 1) (by omega),
      Abelian.Ext.comp_assoc _ _ _ (add_zero m) (zero_add 1) (by omega), hnat]
  have base : ∀ Y : C, Function.Bijective (T Y 0) := by
    intro Y
    have e : ⇑(T Y 0) = fun x =>
        Abelian.Ext.mk₀ ((adj.homEquiv P Y).symm (Abelian.Ext.homEquiv₀ x)) := by
      funext x
      conv_lhs => rw [← Abelian.Ext.mk₀_homEquiv₀_apply x]
      rw [hT, Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀,
        Adjunction.homEquiv_counit]
    rw [e]
    exact (Abelian.Ext.mk₀_bijective _ _).comp
      ((adj.homEquiv P Y).symm.bijective.comp Abelian.Ext.homEquiv₀.bijective)

  obtain ⟨Y, f, g, w, hS, hRex, hgf, hfd, ⟨e⟩⟩ : ∃ (Y : ℕ → C) (f : ∀ n, Y n ⟶ I.cocomplex.X n)
      (g : ∀ n, I.cocomplex.X n ⟶ Y (n + 1)) (w : ∀ n, f n ≫ g n = 0),
      (∀ n, (ShortComplex.mk (f n) (g n) (w n)).ShortExact) ∧
      (∀ n, ((ShortComplex.mk (f n) (g n) (w n)).map R).Exact) ∧
      (∀ n, g n ≫ f (n + 1) = I.cocomplex.d n (n + 1)) ∧
      (∀ n, f n ≫ I.cocomplex.d n (n + 1) = 0) ∧ Nonempty (A ≅ Y 0) := by
    have hw : ∀ n, Limits.kernel.ι (I.cocomplex.d n (n + 1)) ≫
        Limits.kernel.lift (I.cocomplex.d (n + 1) (n + 2)) (I.cocomplex.d n (n + 1))
          (I.cocomplex.d_comp_d n (n + 1) (n + 2)) = 0 := by
      intro n
      rw [← cancel_mono (Limits.kernel.ι (I.cocomplex.d (n + 1) (n + 2))), Category.assoc,
        Limits.kernel.lift_ι, Limits.zero_comp]
      exact Limits.kernel.condition _
    have hSE : ∀ n, (ShortComplex.mk (Limits.kernel.ι (I.cocomplex.d n (n + 1)))
        (Limits.kernel.lift (I.cocomplex.d (n + 1) (n + 2)) (I.cocomplex.d n (n + 1))
          (I.cocomplex.d_comp_d n (n + 1) (n + 2))) (hw n)).ShortExact := by
      intro n
      have hex : (I.cocomplex.sc' n (n + 1) (n + 2)).Exact :=
        (I.cocomplex.exactAt_iff' n (n + 1) (n + 2) (by simp) (by simp)).1
          (I.cocomplex_exactAt_succ n)
      rw [ShortComplex.exact_iff_epi_kernel_lift] at hex
      have hlim : Limits.IsLimit (Limits.KernelFork.ofι
          (Limits.kernel.ι (I.cocomplex.d n (n + 1))) (hw n)) :=
        Limits.KernelFork.IsLimit.ofι _ _
          (fun g' hg' => Limits.kernel.lift _ g' (by
            rw [← Limits.kernel.lift_ι (I.cocomplex.d (n + 1) (n + 2)) (I.cocomplex.d n (n + 1))
              (I.cocomplex.d_comp_d n (n + 1) (n + 2)), ← Category.assoc, hg', Limits.zero_comp]))
          (fun g' hg' => Limits.kernel.lift_ι _ _ _)
          (fun g' hg' m hm => by
            rw [← cancel_mono (Limits.kernel.ι (I.cocomplex.d n (n + 1))), hm,
              Limits.kernel.lift_ι])
      refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
      · exact ShortComplex.exact_of_f_is_kernel _ hlim
      · exact (inferInstance : Mono (Limits.kernel.ι (I.cocomplex.d n (n + 1))))
      · exact hex
    refine ⟨fun n => Limits.kernel (I.cocomplex.d n (n + 1)),
      fun n => Limits.kernel.ι (I.cocomplex.d n (n + 1)),
      fun n => Limits.kernel.lift (I.cocomplex.d (n + 1) (n + 2)) (I.cocomplex.d n (n + 1))
        (I.cocomplex.d_comp_d n (n + 1) (n + 2)), hw, hSE, ?_, ?_, ?_, ?_⟩
    · intro n
      exact (hSE n).exact.map_of_mono_of_preservesKernel R (hSE n).mono_f inferInstance
    · intro n
      exact Limits.kernel.lift_ι _ _ _
    · intro n
      exact Limits.kernel.condition _
    · have h0 := I.exact₀.fIsKernel
      exact ⟨(HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 A).symm ≪≫
        Limits.IsLimit.conePointUniqueUpToIso h0 (Limits.limit.isLimit _)⟩
  have hIX : ∀ n, Injective (I.cocomplex.X n) := I.injective
  have hRJ : ∀ n, Injective (R.obj (I.cocomplex.X n)) := fun n => by
    haveI := hIX n
    exact Injective.injective_of_adjoint adj _
  have hmonoRf : ∀ n, Mono (R.map (f n)) := fun n => by
    haveI : Mono (f n) := (hS n).mono_f
    infer_instance

  obtain ⟨π, hgπ, hex, hπepi, hπ0⟩ : ∃ (π : ∀ n, R.obj (Y n) ⟶ J.homology n)
      (hgπ : ∀ n, R.map (g n) ≫ π (n + 1) = 0),
      (∀ n, (ShortComplex.mk (R.map (g n)) (π (n + 1)) (hgπ n)).Exact) ∧
      (∀ n, Epi (π n)) ∧ IsIso (π 0) := by
    have hk : ∀ n, R.map (f n) ≫ J.d n (n + 1) = 0 := fun n => by
      show R.map (f n) ≫ R.map (I.cocomplex.d n (n + 1)) = 0
      rw [← R.map_comp, hfd, R.map_zero]
    obtain ⟨c, hc⟩ : ∃ c : ∀ n, R.obj (Y n) ⟶ J.cycles n,
        ∀ n, c n ≫ J.iCycles n = R.map (f n) :=
      ⟨fun n => J.liftCycles (R.map (f n)) (n + 1) (by simp) (hk n),
        fun n => by simp⟩
    have hcI : ∀ n, IsIso (c n) := by
      intro n
      haveI := hmonoRf n
      have hz : J.iCycles n ≫ R.map (g n) = 0 := by
        haveI := hmonoRf (n + 1)
        rw [← cancel_mono (R.map (f (n + 1))), Category.assoc, ← R.map_comp, hgf,
          Limits.zero_comp]
        exact J.iCycles_d n (n + 1)
      haveI : Mono ((ShortComplex.mk (f n) (g n) (w n)).map R).f := hmonoRf n
      have hl : (hRex n).lift (J.iCycles n) hz ≫ R.map (f n) = J.iCycles n :=
        (hRex n).lift_f _ _
      refine ⟨⟨(hRex n).lift (J.iCycles n) hz, ?_, ?_⟩⟩
      · rw [← cancel_mono (R.map (f n)), Category.assoc, hl, hc, Category.id_comp]
      · rw [← cancel_mono (J.iCycles n), Category.assoc, hc, hl, Category.id_comp]
    have hK : ∀ n, R.map (g n) ≫ c (n + 1) = J.toCycles n (n + 1) := by
      intro n
      rw [← cancel_mono (J.iCycles (n + 1)), Category.assoc, hc, J.toCycles_i]
      show R.map (g n) ≫ R.map (f (n + 1)) = R.map (I.cocomplex.d n (n + 1))
      rw [← R.map_comp, hgf]
    have hgπ : ∀ n, R.map (g n) ≫ (c (n + 1) ≫ J.homologyπ (n + 1)) = 0 := by
      intro n
      rw [← Category.assoc, hK, J.toCycles_comp_homologyπ]
    refine ⟨fun n => c n ≫ J.homologyπ n, hgπ, fun n => ?_, fun n => ?_, ?_⟩
    · have hS₂ : (ShortComplex.mk (J.toCycles n (n + 1)) (J.homologyπ (n + 1))
          (J.toCycles_comp_homologyπ n (n + 1))).Exact :=
        ShortComplex.exact_of_g_is_cokernel _ (J.homologyIsCokernel n (n + 1) (by simp))
      haveI := hcI (n + 1)
      let φ : ShortComplex.mk (R.map (g n)) (c (n + 1) ≫ J.homologyπ (n + 1)) (hgπ n) ⟶
          ShortComplex.mk (J.toCycles n (n + 1)) (J.homologyπ (n + 1))
            (J.toCycles_comp_homologyπ n (n + 1)) :=
        { τ₁ := 𝟙 _
          τ₂ := c (n + 1)
          τ₃ := 𝟙 _
          comm₁₂ := by
            show 𝟙 _ ≫ J.toCycles n (n + 1) = R.map (g n) ≫ c (n + 1)
            rw [Category.id_comp, hK]
          comm₂₃ := by
            show c (n + 1) ≫ J.homologyπ (n + 1) = (c (n + 1) ≫ J.homologyπ (n + 1)) ≫ 𝟙 _
            rw [Category.comp_id] }
      haveI : Epi φ.τ₁ := by show Epi (𝟙 _); infer_instance
      haveI : IsIso φ.τ₂ := by show IsIso (c (n + 1)); infer_instance
      haveI : Mono φ.τ₃ := by show Mono (𝟙 _); infer_instance
      exact (ShortComplex.exact_iff_of_epi_of_isIso_of_mono φ).2 hS₂
    · haveI := hcI n
      exact epi_comp _ _
    · haveI := hcI 0
      haveI := J.isIso_homologyπ 0 0 CochainComplex.prev_nat_zero (J.shape 0 0 (by simp))
      exact inferInstance

  have hRSE : ∀ n, n + 1 ≠ t → ((ShortComplex.mk (f n) (g n) (w n)).map R).ShortExact := by
    intro n hn
    have hz : π (n + 1) = 0 := (hvan (n + 1) hn).eq_of_tgt _ _
    exact ShortComplex.ShortExact.mk' (hRex n) (hmonoRf n) ((hex n).epi_f hz)
  have s1b' : ∀ (n m : ℕ) (hRS : ((ShortComplex.mk (f n) (g n) (w n)).map R).ShortExact)
      (z : Abelian.Ext P (R.obj (Y (n + 1))) m),
      T (Y n) (m + 1) (z.comp hRS.extClass rfl) = (T (Y (n + 1)) m z).comp (hS n).extClass rfl :=
    fun n m hRS z => s1b _ (hS n) hRS m z
  have hJsurj : ∀ (n m : ℕ) (u : Abelian.Ext (L.obj P) (I.cocomplex.X n) m),
      ∃ v, T (I.cocomplex.X n) m v = u := by
    intro n m u
    cases m with
    | zero => exact (base _).2 u
    | succ m' =>
      haveI := hIX n
      exact ⟨0, by rw [map_zero]; exact (Abelian.Ext.eq_zero_of_injective u).symm⟩

  have tower : ∀ m n, t ≤ n → Function.Injective (T (Y n) m) := by
    intro m
    induction m with
    | zero => intro n _; exact (base (Y n)).1
    | succ m ih =>
      intro n hn
      have hRS := hRSE n (by omega)
      rw [injective_iff_map_eq_zero]
      intro w' hw'
      haveI := hRJ n
      have h0 : w'.comp (Abelian.Ext.mk₀ (R.map (f n))) (add_zero _) = 0 :=
        Abelian.Ext.eq_zero_of_injective _
      obtain ⟨z', hz'⟩ : ∃ z' : Abelian.Ext P (R.obj (Y (n + 1))) m,
          z'.comp hRS.extClass rfl = w' :=
        Abelian.Ext.covariant_sequence_exact₁ P hRS w' h0 rfl
      have h1 : (T (Y (n + 1)) m z').comp (hS n).extClass rfl = 0 := by
        rw [← s1b' n m hRS z', hz']
        exact hw'
      obtain ⟨u, hu⟩ : ∃ u : Abelian.Ext (L.obj P) (I.cocomplex.X n) m,
          u.comp (Abelian.Ext.mk₀ (g n)) (add_zero m) = T (Y (n + 1)) m z' :=
        Abelian.Ext.covariant_sequence_exact₃ (L.obj P) (hS n) _ rfl h1
      obtain ⟨v, hv⟩ := hJsurj n m u
      have hz2 : z' = v.comp (Abelian.Ext.mk₀ (R.map (g n))) (add_zero m) := by
        apply ih (n + 1) (by omega)
        rw [s1a, hv]
        exact hu.symm
      have hc : (Abelian.Ext.mk₀ (R.map (g n))).comp hRS.extClass (zero_add 1) = 0 :=
        hRS.comp_extClass
      rw [← hz', hz2, Abelian.Ext.comp_assoc _ _ _ (add_zero m) (zero_add 1) (by omega), hc,
        Abelian.Ext.comp_zero]

  obtain ⟨δ, hδ0, hδS⟩ : ∃ δ : ∀ n, Abelian.Ext (Y n) A n, δ 0 = Abelian.Ext.mk₀ e.inv ∧
      ∀ n, δ (n + 1) = (hS n).extClass.comp (δ n) (Nat.add_comm 1 n) :=
    ⟨fun n => Nat.rec (motive := fun n => Abelian.Ext (Y n) A n) (Abelian.Ext.mk₀ e.inv)
      (fun n d => (hS n).extClass.comp d (Nat.add_comm 1 n)) n, rfl, fun n => rfl⟩
  have hδinj : ∀ (M : C) (n m k : ℕ) (hk : m + 1 + n = k) (y : Abelian.Ext M (Y n) (m + 1)),
      y.comp (δ n) hk = 0 → y = 0 := by
    intro M n
    induction n with
    | zero =>
      intro m k hk y hy
      have hk' : k = m + 1 := by omega
      subst hk'
      rw [hδ0] at hy
      have h2 := congrArg (fun z => z.comp (Abelian.Ext.mk₀ e.hom) (add_zero (m + 1))) hy
      simp only [Abelian.Ext.zero_comp] at h2
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
        Abelian.Ext.comp_mk₀_id] at h2
      exact h2
    | succ n ih =>
      intro m k hk y hy
      rw [hδS n, ← Abelian.Ext.comp_assoc y (hS n).extClass (δ n) rfl (Nat.add_comm 1 n)
        (by omega)] at hy
      have h1 : y.comp (hS n).extClass rfl = 0 := ih (m + 1) k (by omega) _ hy
      obtain ⟨u, hu⟩ := Abelian.Ext.covariant_sequence_exact₃ M (hS n) y rfl h1
      haveI := hIX n
      rw [← hu, Abelian.Ext.eq_zero_of_injective u, Abelian.Ext.zero_comp]

  have injX₃ : ∀ (S : ShortComplex D), S.ShortExact → Injective S.X₁ → Injective S.X₂ →
      Injective S.X₃ := by
    intro S hS' h₁ h₂
    haveI := h₁
    haveI := h₂
    let sp := hS'.splittingOfInjective
    refine Injective.mk ?_
    intro X Y' g' f' _
    obtain ⟨h', hh'⟩ := Injective.factors (g' ≫ sp.s) f'
    exact ⟨h' ≫ S.g, by rw [← Category.assoc, hh', Category.assoc, sp.s_g, Category.comp_id]⟩

  have hsec : ∃ σ : P ⟶ R.obj (Y t), σ ≫ π t = ψ := by
    cases t with
    | zero =>
      haveI := hπ0
      exact ⟨ψ ≫ inv (π 0), by rw [Category.assoc, IsIso.inv_hom_id, Category.comp_id]⟩
    | succ t' =>
      have hlow : ∀ n, n ≤ t' → Injective (R.obj (Y n)) := by
        intro n
        induction n with
        | zero =>
          intro _
          haveI := hπ0
          have hz : Limits.IsZero (J.homology 0) := hvan 0 (by omega)
          exact (hz.of_iso (asIso (π 0))).injective
        | succ n ih =>
          intro hn
          exact injX₃ _ (hRSE n (by omega)) (ih (by omega)) (hRJ n)
      have hI1 := hlow t' le_rfl
      have hI2 := hRJ t'
      haveI := hπepi (t' + 1)
      have hqepi : Epi (Limits.kernel.lift (π (t' + 1)) (R.map (g t')) (hgπ t')) :=
        (ShortComplex.exact_iff_epi_kernel_lift _).1 (hex t')
      obtain ⟨q, hqm, hqe⟩ : ∃ q : R.obj (I.cocomplex.X t') ⟶ Limits.kernel (π (t' + 1)),
          q ≫ Limits.kernel.ι (π (t' + 1)) = R.map (g t') ∧ Epi q :=
        ⟨_, Limits.kernel.lift_ι _ _ _, hqepi⟩
      have haq : R.map (f t') ≫ q = 0 := by
        rw [← cancel_mono (Limits.kernel.ι (π (t' + 1))), Category.assoc, hqm, Limits.zero_comp,
          ← R.map_comp, w t', R.map_zero]
      have hSaq : (ShortComplex.mk (R.map (f t')) q haq).ShortExact := by
        refine ShortComplex.ShortExact.mk' ?_ (hmonoRf t') hqe
        let φ : ShortComplex.mk (R.map (f t')) q haq ⟶
            (ShortComplex.mk (f t') (g t') (w t')).map R :=
          { τ₁ := 𝟙 _
            τ₂ := 𝟙 _
            τ₃ := Limits.kernel.ι (π (t' + 1))
            comm₁₂ := by
              show 𝟙 _ ≫ R.map (f t') = R.map (f t') ≫ 𝟙 _
              rw [Category.id_comp, Category.comp_id]
            comm₂₃ := by
              show 𝟙 _ ≫ R.map (g t') = q ≫ Limits.kernel.ι (π (t' + 1))
              rw [Category.id_comp, hqm] }
        haveI : Epi φ.τ₁ := by show Epi (𝟙 _); infer_instance
        haveI : IsIso φ.τ₂ := by show IsIso (𝟙 _); infer_instance
        haveI : Mono φ.τ₃ := by show Mono (Limits.kernel.ι (π (t' + 1))); infer_instance
        exact (ShortComplex.exact_iff_of_epi_of_isIso_of_mono φ).2 (hRex t')
      have hKinj : Injective (Limits.kernel (π (t' + 1))) := injX₃ _ hSaq hI1 hI2
      have hSkp : (ShortComplex.mk (Limits.kernel.ι (π (t' + 1))) (π (t' + 1))
          (Limits.kernel.condition _)).ShortExact :=
        ShortComplex.ShortExact.mk'
          (ShortComplex.exact_of_f_is_kernel _ (Limits.kernelIsKernel (π (t' + 1))))
          (inferInstance : Mono (Limits.kernel.ι (π (t' + 1))))
          (inferInstance : Epi (π (t' + 1)))
      haveI : Injective (ShortComplex.mk (Limits.kernel.ι (π (t' + 1))) (π (t' + 1))
          (Limits.kernel.condition _)).X₁ := hKinj
      let sp := hSkp.splittingOfInjective
      have hs : sp.s ≫ π (t' + 1) = 𝟙 _ := sp.s_g
      exact ⟨ψ ≫ sp.s, by rw [Category.assoc, hs, Category.comp_id]⟩

  have key : ∀ (j : ℕ) (β : Abelian.Ext P (R.obj (Y t)) j) (N : ℕ) (h : j + t = N),
      (T (Y t) j β).comp (δ t) h = 0 → β.comp (Abelian.Ext.mk₀ (π t)) (add_zero j) = 0 := by
    intro j β N h hx
    cases t with
    | zero =>
      rw [hδ0] at hx
      have hN : j = N := by omega
      subst hN
      have h2 := congrArg (fun z => z.comp (Abelian.Ext.mk₀ e.hom) (add_zero j)) hx
      simp only [Abelian.Ext.zero_comp] at h2
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
        Abelian.Ext.comp_mk₀_id] at h2
      have hβ : β = 0 := tower j 0 le_rfl (by rw [h2, map_zero])
      rw [hβ, Abelian.Ext.zero_comp]
    | succ t' =>
      rw [hδS t', ← Abelian.Ext.comp_assoc _ _ _ rfl (Nat.add_comm 1 t') (by omega)] at hx
      have h1 := hδinj (L.obj P) t' j N (by omega) _ hx
      obtain ⟨u, hu⟩ := Abelian.Ext.covariant_sequence_exact₃ (L.obj P) (hS t') _ rfl h1
      obtain ⟨v, hv⟩ := hJsurj t' j u
      have hβ : β = v.comp (Abelian.Ext.mk₀ (R.map (g t'))) (add_zero j) := by
        apply tower j (t' + 1) le_rfl
        rw [s1a, hv]
        exact hu.symm
      rw [hβ, Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, hgπ t',
        Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]

  obtain ⟨σ, hσ⟩ := hsec
  refine ⟨(Abelian.Ext.mk₀ (L.map σ ≫ adj.counit.app (Y t))).comp (δ t) (zero_add t), ?_⟩
  intro j N h b hb
  have E1 : (Abelian.Ext.mapExactFunctor L b).comp
      (Abelian.Ext.mk₀ (L.map σ ≫ adj.counit.app (Y t))) (add_zero j) =
      T (Y t) j (b.comp (Abelian.Ext.mk₀ σ) (add_zero j)) := by
    rw [hT, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, E1] at hb
  have h2 := key j _ N h hb
  rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, hσ] at h2
  have h3 := congrArg (fun z => z.comp (Abelian.Ext.mk₀ ψinv) (add_zero j)) h2
  simp only [Abelian.Ext.zero_comp] at h3
  rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, hψ1,
    Abelian.Ext.comp_mk₀_id] at h3
  exact h3

theorem wcl_weaklyEtale_lift_tensor_surj : ∀ (A Abar Bbar : Type u) [CommRing A] [CommRing Abar] [CommRing Bbar] [Algebra A Abar] [Algebra Abar Bbar], Function.Surjective (algebraMap A Abar) → Algebra.WeaklyEtale Abar Bbar → ∃ (C : Type u) (_ : CommRing C) (_ : Algebra A C) (β : Bbar →+* TensorProduct A C Abar), Algebra.WeaklyEtale A C ∧ β.comp (algebraMap Abar Bbar) = (Algebra.TensorProduct.includeRight : Abar →ₐ[A] TensorProduct A C Abar).toRingHom ∧ Function.Surjective (PrimeSpectrum.comap β) :=
by
  classical
  intro A Abar Bbar _ _ _ _ _ hπ hW
  obtain ⟨T, _, _, hFF, hWT, hInd⟩ := wc_bs_weaklyEtale_indEtale_locally Abar Bbar hW
  obtain ⟨τ, hτ⟩ : ∃ τ : Abar →+* T, τ = (algebraMap Bbar T).comp (algebraMap Abar Bbar) :=
    ⟨_, rfl⟩
  rw [← hτ] at hInd
  have hτW : @Algebra.WeaklyEtale Abar T _ _ τ.toAlgebra := by
    letI : Algebra Abar T := τ.toAlgebra
    haveI := hW
    haveI := hWT
    haveI : IsScalarTower Abar Bbar T := IsScalarTower.of_algebraMap_eq' hτ
    exact Algebra.WeaklyEtale.trans Abar Bbar T
  have hdata : ∀ t : T, ∃ (n : ℕ) (F : Fin n → MvPolynomial (Fin n) A) (x : Fin n → T)
      (P : MvPolynomial (Fin n) A),
      (∃ g : MvPolynomial (Fin n) A,
        g * (Matrix.of fun a b => MvPolynomial.pderiv a (F b)).det - 1 ∈ Ideal.span (Set.range F)) ∧
      (∀ b, MvPolynomial.eval₂ (τ.comp (algebraMap A Abar)) x (F b) = 0) ∧
      MvPolynomial.eval₂ (τ.comp (algebraMap A Abar)) x P = t := by
    intro t
    obtain ⟨n, f, x, p, hf, hJ, hp⟩ := wcl_indEtale_point_data Abar T τ hInd t
    obtain ⟨F, hF, hFJ, hlift⟩ := wcl_lift_point_data A Abar T (algebraMap A Abar) τ hπ n f x hf hJ
    obtain ⟨P, hP⟩ := hlift p
    obtain ⟨F', x', hg, hF', hold⟩ :=
      wcl_standardize_point_data A T (τ.comp (algebraMap A Abar)) n F x hF hFJ
    obtain ⟨P', hP'⟩ := hold P
    exact ⟨n + 1, F', x', P', hg, hF', by rw [hP', hP, hp]⟩
  obtain ⟨C₀, _, _, ρ₀, hC₀W, hρ₀S, hρ₀⟩ :=
    wcl_weaklyEtale_surj_of_point_data A T (τ.comp (algebraMap A Abar)) hdata
  obtain ⟨C, _, _, ρ, Θ, hCW, -, -, hΘR⟩ :=
    wcl_localize_tensor_iso A Abar C₀ T τ ρ₀ hπ hρ₀S hρ₀ hC₀W hτW
  refine ⟨C, inferInstance, inferInstance, Θ.symm.toRingHom.comp (algebraMap Bbar T), hCW, ?_, ?_⟩
  · ext a
    show Θ.symm (algebraMap Bbar T (algebraMap Abar Bbar a)) =
      (Algebra.TensorProduct.includeRight : Abar →ₐ[A] TensorProduct A C Abar) a
    rw [RingEquiv.symm_apply_eq, hΘR a, hτ]
    rfl
  · intro q
    haveI := hFF
    obtain ⟨r, hr⟩ := PrimeSpectrum.comap_surjective_of_faithfullyFlat (A := Bbar) (B := T) q
    refine ⟨PrimeSpectrum.comap (Θ : TensorProduct A C Abar ≃+* T).toRingHom r, ?_⟩
    rw [← hr]
    apply PrimeSpectrum.ext
    ext b
    show Θ (Θ.symm (algebraMap Bbar T b)) ∈ r.asIdeal ↔ algebraMap Bbar T b ∈ r.asIdeal
    rw [RingEquiv.apply_symm_apply]

theorem wc_proet_closed_push_modules_full_faithful {X Z : Scheme.{u}} (i : Z ⟶ X)
    [IsClosedImmersion i] [IsLocallyNoetherian X] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (D : wcHMPullData i ℓ) (hD : wcHMPullCanonical D) :
    (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).Full ∧
    (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).Faithful :=
by
  classical
  haveI := D.cont

  have hcov : ∀ {S : Scheme.{u}} (T : S.ProEt) (R : Sieve T),
      (∀ (T' : S.ProEt) (t : T' ⟶ T), IsAffine T'.left →
        ∃ (n : ℕ) (W : Fin n → S.ProEt) (e : ∀ k, W k ⟶ T'),
          (∀ k, IsAffine (W k).left) ∧ (∀ k, R.arrows (e k ≫ t)) ∧
          ∀ x : T'.left, ∃ k, x ∈ Set.range (e k).left) →
      R ∈ Scheme.ProEt.topology S T := by
    intro S T R h
    have h0 := wc_proet_cover_of_affine_local (fun _ => True)
      (fun V hV => ⟨V, 𝟙 V, hV, inferInstance, inferInstance, trivial⟩) T
    refine (Scheme.ProEt.topology S).transitive h0 R ?_
    intro Y f hf
    obtain ⟨T'', g', g, ⟨hA, -⟩, rfl⟩ := hf
    rw [Sieve.pullback_comp]
    apply (Scheme.ProEt.topology S).pullback_stable
    haveI : IsAffine T''.left := hA
    obtain ⟨n, W, e, hW, hR, hsurj⟩ := h T'' g hA
    refine (Scheme.ProEt.topology S).superset_covering ?_
      (proet_finite_affine_jointly_surjective_covers S T'' n W e hW hsurj)
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨k⟩
    exact hR k

  have hgraph : ∀ (U V : X.ProEt) (f : (wcProEtBC i).obj U ⟶ (wcProEtBC i).obj V),
      ∃ (P : X.ProEt) (p₁ : P ⟶ U) (p₂ : P ⟶ V) (γ : (wcProEtBC i).obj U ⟶ (wcProEtBC i).obj P),
        γ ≫ (wcProEtBC i).map p₁ = 𝟙 _ ∧ γ ≫ (wcProEtBC i).map p₂ = f := by
    intro U V f
    haveI : WeaklyEtale U.hom := U.prop
    haveI : WeaklyEtale V.hom := V.prop
    let P : X.ProEt := Scheme.ProEt.mk (Limits.pullback.fst U.hom V.hom ≫ U.hom)
    let p₁ : P ⟶ U := MorphismProperty.Over.homMk (Limits.pullback.fst U.hom V.hom) rfl trivial
    let p₂ : P ⟶ V := MorphismProperty.Over.homMk (Limits.pullback.snd U.hom V.hom)
      Limits.pullback.condition.symm trivial
    obtain ⟨fl, hfl⟩ : ∃ fl : Limits.pullback U.hom i ⟶ Limits.pullback V.hom i, fl = f.left :=
      ⟨f.left, rfl⟩
    have hf : fl ≫ Limits.pullback.snd V.hom i = Limits.pullback.snd U.hom i := by
      rw [hfl]; exact MorphismProperty.Over.w f
    have e : Limits.pullback.fst U.hom i ≫ U.hom =
        (fl ≫ Limits.pullback.fst V.hom i) ≫ V.hom := by
      rw [Limits.pullback.condition, Category.assoc, Limits.pullback.condition, ← Category.assoc, hf]
    obtain ⟨x, hx1, hx2⟩ : ∃ x : Limits.pullback U.hom i ⟶ Limits.pullback U.hom V.hom,
        x ≫ Limits.pullback.fst U.hom V.hom = Limits.pullback.fst U.hom i ∧
        x ≫ Limits.pullback.snd U.hom V.hom = fl ≫ Limits.pullback.fst V.hom i :=
      ⟨Limits.pullback.lift _ _ e, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have e' : x ≫ (Limits.pullback.fst U.hom V.hom ≫ U.hom) = Limits.pullback.snd U.hom i ≫ i := by
      rw [← Category.assoc, hx1, Limits.pullback.condition]
    obtain ⟨γl, hγ1, hγ2⟩ : ∃ γl : Limits.pullback U.hom i ⟶
        Limits.pullback (Limits.pullback.fst U.hom V.hom ≫ U.hom) i,
        γl ≫ Limits.pullback.fst (Limits.pullback.fst U.hom V.hom ≫ U.hom) i = x ∧
        γl ≫ Limits.pullback.snd (Limits.pullback.fst U.hom V.hom ≫ U.hom) i =
          Limits.pullback.snd U.hom i :=
      ⟨Limits.pullback.lift _ _ e', Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    let γ : (wcProEtBC i).obj U ⟶ (wcProEtBC i).obj P := MorphismProperty.Over.homMk γl hγ2 trivial
    obtain ⟨m1, hm1⟩ : ∃ m1 : Limits.pullback (Limits.pullback.fst U.hom V.hom ≫ U.hom) i ⟶
        Limits.pullback U.hom i, m1 = ((wcProEtBC i).map p₁).left := ⟨_, rfl⟩
    obtain ⟨m2, hm2⟩ : ∃ m2 : Limits.pullback (Limits.pullback.fst U.hom V.hom ≫ U.hom) i ⟶
        Limits.pullback V.hom i, m2 = ((wcProEtBC i).map p₂).left := ⟨_, rfl⟩
    have hm1f : m1 ≫ Limits.pullback.fst U.hom i =
        Limits.pullback.fst (Limits.pullback.fst U.hom V.hom ≫ U.hom) i ≫
          Limits.pullback.fst U.hom V.hom := by
      rw [hm1]; exact Limits.pullback.lift_fst _ _ _
    have hm1s : m1 ≫ Limits.pullback.snd U.hom i =
        Limits.pullback.snd (Limits.pullback.fst U.hom V.hom ≫ U.hom) i := by
      rw [hm1]; exact MorphismProperty.Over.w ((wcProEtBC i).map p₁)
    have hm2f : m2 ≫ Limits.pullback.fst V.hom i =
        Limits.pullback.fst (Limits.pullback.fst U.hom V.hom ≫ U.hom) i ≫
          Limits.pullback.snd U.hom V.hom := by
      rw [hm2]; exact Limits.pullback.lift_fst _ _ _
    have hm2s : m2 ≫ Limits.pullback.snd V.hom i =
        Limits.pullback.snd (Limits.pullback.fst U.hom V.hom ≫ U.hom) i := by
      rw [hm2]; exact MorphismProperty.Over.w ((wcProEtBC i).map p₂)
    have k1 : γl ≫ m1 = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hm1f, ← Category.assoc, hγ1, hx1, Category.id_comp]
      · rw [Category.assoc, hm1s, hγ2, Category.id_comp]
    have k2 : γl ≫ m2 = fl := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hm2f, ← Category.assoc, hγ1, hx2]
      · rw [Category.assoc, hm2s, hγ2, hf]
    refine ⟨P, p₁, p₂, γ, ?_, ?_⟩
    · apply MorphismProperty.Over.Hom.ext
      rw [hm1] at k1
      exact k1
    · apply MorphismProperty.Over.Hom.ext
      rw [hm2, hfl] at k2
      exact k2

  have hchart : ∀ (U : X.ProEt), IsAffine U.left → ∀ (V' : Z.ProEt)
      (g' : V' ⟶ (wcProEtBC i).obj U),
      IsAffine V'.left → ∃ (W : X.ProEt) (w : W ⟶ U) (a : (wcProEtBC i).obj W ⟶ V'),
        IsAffine W.left ∧ Surjective a.left ∧ a ≫ g' = (wcProEtBC i).map w := by
    intro U hU V' g' hV'
    haveI : IsAffine U.left := hU
    have hlift := wcl_weaklyEtale_lift_tensor_surj
    haveI hV'i : IsAffine V'.left := hV'
    have toSch : ∀ (R' S' : Type u) [CommRing R'] [CommRing S'] [Algebra R' S'],
        Algebra.WeaklyEtale R' S' → WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) := by
      intro R' S' _ _ _ hW
      have hfl : Flat (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) := by
        rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
          RingHom.flat_algebraMap_iff]
        exact hW.flat
      have hmu : Flat (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom)) := by
        rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom]
        exact hW.flat_lmul'
      have hd : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap R' S')))) := by
        rw [diagonal_SpecMap]
        infer_instance
      exact ⟨hfl, hd⟩
    have toRing : ∀ (R' S' : Type u) [CommRing R'] [CommRing S'] [Algebra R' S'],
        WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) → Algebra.WeaklyEtale R' S' := by
      intro R' S' _ _ _ hW
      have hfl : Module.Flat R' S' := by
        have := hW.flat
        rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
          RingHom.flat_algebraMap_iff] at this
        exact this
      have hd := hW.flat_diagonal
      rw [diagonal_SpecMap] at hd
      have hmu : Flat (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom)) := by
        have e : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom) =
            (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom) ≫
              (pullbackSpecIso R' S' S').inv) ≫ (pullbackSpecIso R' S' S').hom := by
          rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
        rw [e]
        haveI := hd
        infer_instance
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom] at hmu
      exact Algebra.WeaklyEtale.mk hfl hmu
    have appTopWE : ∀ {X₁ Z₁ : Scheme.{u}} [IsAffine X₁] [IsAffine Z₁] (h : X₁ ⟶ Z₁), WeaklyEtale h →
        WeaklyEtale (Spec.map h.appTop) := by
      intro X₁ Z₁ _ _ h hh
      have e : Spec.map h.appTop = X₁.isoSpec.inv ≫ h ≫ Z₁.isoSpec.hom := by
        rw [← Scheme.isoSpec_hom_naturality, Iso.inv_hom_id_assoc]
      rw [e]
      infer_instance
    haveI hUaff' : IsAffine ((𝟭 Scheme.{u}).obj U.left) := inferInstanceAs (IsAffine U.left)
    haveI hjci : IsClosedImmersion (Limits.pullback.fst U.hom i) := inferInstance
    obtain ⟨hZaff, hjsurj⟩ :=
      IsClosedImmersion.isAffine_surjective_of_isAffine (Limits.pullback.fst U.hom i)
    haveI := hZaff
    obtain ⟨g0, hg0def⟩ : ∃ g0 : V'.left ⟶ Limits.pullback U.hom i, g0 = g'.left := ⟨_, rfl⟩
    have hw0 : g0 ≫ Limits.pullback.snd U.hom i = V'.hom := by
      rw [hg0def]; exact MorphismProperty.Over.w g'
    have hg0 : WeaklyEtale g0 := by
      have h1 : WeaklyEtale (g0 ≫ Limits.pullback.snd U.hom i) := by
        rw [hw0]; exact V'.prop
      have h2 : WeaklyEtale (Limits.pullback.snd U.hom i) := ((wcProEtBC i).obj U).prop
      exact @WeaklyEtale.of_comp _ _ _ g0 _ h1 h2
    letI alg1 : Algebra Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤) :=
      (Limits.pullback.fst U.hom i).appTop.hom.toAlgebra
    letI alg2 : Algebra Γ(Limits.pullback U.hom i, ⊤) Γ(V'.left, ⊤) := g0.appTop.hom.toAlgebra
    have hπ : Function.Surjective (algebraMap Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤)) := hjsurj
    have hW : Algebra.WeaklyEtale Γ(Limits.pullback U.hom i, ⊤) Γ(V'.left, ⊤) :=
      toRing _ _ (appTopWE g0 hg0)
    obtain ⟨C, _, _, β, hC, hβ, hsurj⟩ :=
      hlift Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤) Γ(V'.left, ⊤) hπ hW
    haveI := toSch _ _ hC
    haveI := U.prop
    obtain ⟨p, hpdef⟩ : ∃ p : Spec (CommRingCat.of C) ⟶ U.left,
        p = Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) C)) ≫ U.left.isoSpec.inv :=
      ⟨_, rfl⟩
    haveI hpwe : WeaklyEtale p := by rw [hpdef]; infer_instance
    have hp : p ≫ U.left.isoSpec.hom = Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) C)) := by
      rw [hpdef, Category.assoc, Iso.inv_hom_id, Category.comp_id]
    obtain ⟨m, hmdef⟩ : ∃ m : Limits.pullback (p ≫ U.hom) i ⟶ Limits.pullback U.hom i,
        m = ((wcProEtBC i).map
          (MorphismProperty.Over.homMk p rfl trivial : Scheme.ProEt.mk (p ≫ U.hom) ⟶ U)).left :=
      ⟨_, rfl⟩
    have hsq : m ≫ Limits.pullback.fst U.hom i = Limits.pullback.fst (p ≫ U.hom) i ≫ p := by
      rw [hmdef]
      exact Limits.pullback.lift_fst _ _ _
    have hmsnd : m ≫ Limits.pullback.snd U.hom i = Limits.pullback.snd (p ≫ U.hom) i := by
      rw [hmdef]
      exact MorphismProperty.Over.w ((wcProEtBC i).map
          (MorphismProperty.Over.homMk p rfl trivial : Scheme.ProEt.mk (p ≫ U.hom) ⟶ U))
    have eq₁ : p ≫ U.left.isoSpec.hom =
        𝟙 _ ≫ Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) C)) := by
      rw [hp, Category.id_comp]
    have eq₂ : Limits.pullback.fst U.hom i ≫ U.left.isoSpec.hom =
        (Limits.pullback U.hom i).isoSpec.hom ≫
          Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤))) := by
      have hnat := Scheme.isoSpec_hom_naturality (Limits.pullback.fst U.hom i)
      exact hnat.symm
    obtain ⟨M, hMdef⟩ : ∃ M : Limits.pullback p (Limits.pullback.fst U.hom i) ⟶
        Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) C)))
          (Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤)))),
        M = Limits.pullback.map p (Limits.pullback.fst U.hom i)
          (Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) C)))
          (Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤))))
          (𝟙 _) (Limits.pullback U.hom i).isoSpec.hom U.left.isoSpec.hom eq₁ eq₂ := ⟨_, rfl⟩
    haveI hMiso : IsIso M := by
      rw [hMdef]
      infer_instance
    have hMsnd : M ≫ Limits.pullback.snd
        (Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) C)))
        (Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤)))) =
        Limits.pullback.snd p (Limits.pullback.fst U.hom i) ≫ (Limits.pullback U.hom i).isoSpec.hom := by
      rw [hMdef]
      exact Limits.pullback.lift_snd _ _ _
    let e₁ := asIso M ≪≫ pullbackSpecIso Γ(U.left, ⊤) C Γ(Limits.pullback U.hom i, ⊤)
    have he₁ : e₁.hom ≫ Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
        Γ(Limits.pullback U.hom i, ⊤) →ₐ[Γ(U.left, ⊤)]
          TensorProduct Γ(U.left, ⊤) C Γ(Limits.pullback U.hom i, ⊤)).toRingHom) =
        Limits.pullback.snd p (Limits.pullback.fst U.hom i) ≫ (Limits.pullback U.hom i).isoSpec.hom := by
      show (M ≫ (pullbackSpecIso Γ(U.left, ⊤) C Γ(Limits.pullback U.hom i, ⊤)).hom) ≫ _ = _
      rw [Category.assoc]
      refine (congrArg (fun k => M ≫ k)
        (pullbackSpecIso_hom_snd Γ(U.left, ⊤) C Γ(Limits.pullback U.hom i, ⊤))).trans ?_
      exact hMsnd
    have hR : (Limits.pullbackRightPullbackFstIso U.hom i p).inv ≫
        Limits.pullback.snd p (Limits.pullback.fst U.hom i) = m := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullbackRightPullbackFstIso_inv_snd_fst, hsq]
      · rw [Category.assoc, Limits.pullbackRightPullbackFstIso_inv_snd_snd, hmsnd]
    let e := (Limits.pullbackRightPullbackFstIso U.hom i p).symm ≪≫ e₁
    have he : e.hom ≫ Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
        Γ(Limits.pullback U.hom i, ⊤) →ₐ[Γ(U.left, ⊤)]
          TensorProduct Γ(U.left, ⊤) C Γ(Limits.pullback U.hom i, ⊤)).toRingHom) =
        m ≫ (Limits.pullback U.hom i).isoSpec.hom := by
      show ((Limits.pullbackRightPullbackFstIso U.hom i p).inv ≫ e₁.hom) ≫ _ = _
      rw [Category.assoc, he₁, ← Category.assoc, hR]
    obtain ⟨βc, hβc⟩ : ∃ βc : Γ(V'.left, ⊤) ⟶
        CommRingCat.of (TensorProduct Γ(U.left, ⊤) C Γ(Limits.pullback U.hom i, ⊤)),
        βc.hom = β := ⟨CommRingCat.ofHom β, rfl⟩
    subst hβc
    obtain ⟨a₀, ha₀def⟩ : ∃ a₀ : Limits.pullback (p ≫ U.hom) i ⟶ V'.left,
        a₀ = e.hom ≫ Spec.map βc ≫ V'.left.isoSpec.inv := ⟨_, rfl⟩
    have h8a : a₀ ≫ g0 = m := by
      rw [← cancel_mono (Limits.pullback U.hom i).isoSpec.hom, ha₀def]
      simp only [Category.assoc]
      rw [← Scheme.isoSpec_hom_naturality g0, Iso.inv_hom_id_assoc, ← Spec.map_comp, ← he]
      refine congrArg (fun k => e.hom ≫ Spec.map k) ?_
      apply CommRingCat.hom_ext
      rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom]
      exact hβ
    have h8b : a₀ ≫ V'.hom = Limits.pullback.snd (p ≫ U.hom) i := by
      rw [← hw0, ← Category.assoc, h8a, hmsnd]
    have ha₀s : Surjective a₀ := by
      constructor
      intro v
      obtain ⟨P, hP⟩ := hsurj (V'.left.isoSpec.hom v)
      refine ⟨e.inv P, ?_⟩
      have h1 : (Spec.map βc) P = V'.left.isoSpec.hom v := hP
      have h2 : e.hom (e.inv P) = P := Scheme.inv_hom_apply e P
      have h3 : a₀ (e.inv P) = V'.left.isoSpec.inv ((Spec.map βc) (e.hom (e.inv P))) := by
        rw [ha₀def, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
      exact h3.trans ((congrArg (fun z => V'.left.isoSpec.inv ((Spec.map βc) z)) h2).trans
        ((congrArg V'.left.isoSpec.inv h1).trans (Scheme.hom_inv_apply _ _)))
    refine ⟨Scheme.ProEt.mk (p ≫ U.hom), MorphismProperty.Over.homMk p rfl trivial,
      MorphismProperty.Over.homMk a₀ h8b trivial, ?_, ha₀s, ?_⟩
    · show IsAffine (Spec (CommRingCat.of C))
      infer_instance
    · apply MorphismProperty.Over.Hom.ext
      have k := h8a.trans hmdef
      rw [hg0def] at k
      exact k

  have hrel : ∀ (P : X.ProEt) (T : Z.ProEt), IsAffine T.left → ∀ (φ : T ⟶ (wcProEtBC i).obj P),
      ∃ (n : ℕ) (W : Fin n → X.ProEt) (w : ∀ k, W k ⟶ P) (a : ∀ k, (wcProEtBC i).obj (W k) ⟶ T),
        (∀ k, IsAffine (W k).left) ∧ (∀ k, IsAffine ((wcProEtBC i).obj (W k)).left) ∧
        (∀ k, a k ≫ φ = (wcProEtBC i).map (w k)) ∧
        ∀ x : T.left, ∃ k, x ∈ Set.range (a k).left := by
    intro P T hT φ
    haveI : WeaklyEtale P.hom := P.prop
    haveI : WeaklyEtale T.hom := T.prop
    haveI : IsAffine T.left := hT
    obtain ⟨fl, hfl⟩ : ∃ fl : T.left ⟶ Limits.pullback P.hom i, fl = φ.left := ⟨_, rfl⟩
    obtain ⟨ψ, hψ⟩ : ∃ ψ : T.left ⟶ P.left, ψ = fl ≫ Limits.pullback.fst P.hom i := ⟨_, rfl⟩
    have hφw : fl ≫ Limits.pullback.snd P.hom i = T.hom := by
      rw [hfl]; exact MorphismProperty.Over.w φ
    have hO : ∀ t : T.left, ∃ O : P.left.Opens, IsAffineOpen O ∧ ψ t ∈ O := fun t => by
      obtain ⟨O, hO, ht, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := ψ t) trivial
      exact ⟨O, hO, ht⟩
    choose O hOa hOt using hO
    have hA : ∀ t : T.left, ∃ A : T.left.Opens, IsAffineOpen A ∧ t ∈ A ∧ ∀ y ∈ A, ψ y ∈ O t :=
      fun t => by
        obtain ⟨A, hA, ht, hsub⟩ := exists_isAffineOpen_mem_and_subset (U := ψ ⁻¹ᵁ O t) (x := t)
          (hOt t)
        exact ⟨A, hA, ht, fun y hy => hsub hy⟩
    choose A hAa hAt hAsub using hA
    have chart : ∀ t : T.left, ∃ (W : X.ProEt) (w : W ⟶ P) (a : (wcProEtBC i).obj W ⟶ T),
        IsAffine W.left ∧ a ≫ φ = (wcProEtBC i).map w ∧
        ∀ x ∈ A t, x ∈ Set.range a.left := by
      intro t
      let U : X.ProEt := Scheme.ProEt.mk ((O t).ι ≫ P.hom)
      let uk : U ⟶ P := MorphismProperty.Over.homMk (O t).ι rfl trivial
      let V' : Z.ProEt := Scheme.ProEt.mk ((A t).ι ≫ T.hom)
      let ιk : V' ⟶ T := MorphismProperty.Over.homMk (A t).ι rfl trivial
      have hr : Set.range ((A t).ι ≫ ψ) ⊆ Set.range (O t).ι := by
        rintro _ ⟨y, rfl⟩
        rw [Scheme.Opens.range_ι, Scheme.Hom.comp_apply]
        have hy : (A t).ι y ∈ Set.range (A t).ι := ⟨y, rfl⟩
        rw [Scheme.Opens.range_ι] at hy
        exact hAsub t _ hy
      have e : IsOpenImmersion.lift (O t).ι ((A t).ι ≫ ψ) hr ≫ ((O t).ι ≫ P.hom) =
          ((A t).ι ≫ fl ≫ Limits.pullback.snd P.hom i) ≫ i := by
        rw [← Category.assoc, IsOpenImmersion.lift_fac, hψ]
        simp only [Category.assoc, Limits.pullback.condition]
      obtain ⟨gl, hgl1, hgl2⟩ : ∃ gl : (A t : Scheme.{u}) ⟶ Limits.pullback ((O t).ι ≫ P.hom) i,
          gl ≫ Limits.pullback.fst ((O t).ι ≫ P.hom) i =
            IsOpenImmersion.lift (O t).ι ((A t).ι ≫ ψ) hr ∧
          gl ≫ Limits.pullback.snd ((O t).ι ≫ P.hom) i =
            (A t).ι ≫ fl ≫ Limits.pullback.snd P.hom i :=
        ⟨Limits.pullback.lift _ _ e, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
      have hglw : gl ≫ Limits.pullback.snd ((O t).ι ≫ P.hom) i = (A t).ι ≫ T.hom := by
        rw [hgl2, hφw]
      let g' : V' ⟶ (wcProEtBC i).obj U := MorphismProperty.Over.homMk gl hglw trivial
      obtain ⟨mu, hmu⟩ : ∃ mu : Limits.pullback ((O t).ι ≫ P.hom) i ⟶ Limits.pullback P.hom i,
          mu = ((wcProEtBC i).map uk).left := ⟨_, rfl⟩
      have hmuf : mu ≫ Limits.pullback.fst P.hom i =
          Limits.pullback.fst ((O t).ι ≫ P.hom) i ≫ (O t).ι := by
        rw [hmu]; exact Limits.pullback.lift_fst _ _ _
      have hmus : mu ≫ Limits.pullback.snd P.hom i = Limits.pullback.snd ((O t).ι ≫ P.hom) i := by
        rw [hmu]; exact MorphismProperty.Over.w ((wcProEtBC i).map uk)
      have hcompat : g' ≫ (wcProEtBC i).map uk = ιk ≫ φ := by
        apply MorphismProperty.Over.Hom.ext
        have k : gl ≫ mu = (A t).ι ≫ fl := by
          apply Limits.pullback.hom_ext
          · rw [Category.assoc, hmuf, ← Category.assoc, hgl1, IsOpenImmersion.lift_fac, hψ,
              Category.assoc]
          · rw [Category.assoc, hmus, hgl2, Category.assoc]
        rw [hmu, hfl] at k
        exact k
      have hUa : IsAffine U.left := hOa t
      obtain ⟨W, w', a', hWa, ha's, hcomm⟩ := hchart U hUa V' g' (hAa t)
      refine ⟨W, w' ≫ uk, a' ≫ ιk, hWa, ?_, ?_⟩
      · rw [Category.assoc, ← hcompat, ← Category.assoc, hcomm, Functor.map_comp]
      · intro x hx
        have hx' : x ∈ Set.range (A t).ι := by rw [Scheme.Opens.range_ι]; exact hx
        obtain ⟨y, rfl⟩ := hx'
        obtain ⟨al, hal⟩ : ∃ al : Limits.pullback W.hom i ⟶ (A t : Scheme.{u}), al = a'.left :=
          ⟨_, rfl⟩
        have hals : Function.Surjective al := by rw [hal]; exact ha's.surj
        obtain ⟨z, hz⟩ := hals y
        refine ⟨z, ?_⟩
        have hc : (a' ≫ ιk).left = al ≫ (A t).ι := by rw [hal]; rfl
        rw [hc]
        exact (Scheme.Hom.comp_apply al (A t).ι z).trans (congrArg (A t).ι hz)
    choose Wc wc ac hWc hac hcov' using chart
    obtain ⟨s, hs⟩ := isCompact_univ.elim_finite_subcover (fun t => (A t : Set T.left))
      (fun t => (A t).isOpen) (fun x _ => Set.mem_iUnion.2 ⟨x, hAt x⟩)
    let idx : Fin s.card → T.left := fun k => (s.equivFin.symm k : T.left)
    refine ⟨s.card, fun k => Wc (idx k), fun k => wc (idx k), fun k => ac (idx k),
      fun k => hWc (idx k), fun k => ?_, fun k => hac (idx k), fun x => ?_⟩
    · haveI : IsAffine (Wc (idx k)).left := hWc (idx k)
      haveI : IsAffine ((𝟭 Scheme.{u}).obj (Wc (idx k)).left) := hWc (idx k)
      exact (IsClosedImmersion.isAffine_surjective_of_isAffine
        (Limits.pullback.fst (Wc (idx k)).hom i)).1
    · obtain ⟨t, ht, hx⟩ := Set.mem_iUnion₂.1 (hs (Set.mem_univ x))
      have hk : idx (s.equivFin ⟨t, ht⟩) = t := by simp [idx]
      refine ⟨s.equivFin ⟨t, ht⟩, ?_⟩
      have hx' : x ∈ A (idx (s.equivFin ⟨t, ht⟩)) := by rw [hk]; exact hx
      exact hcov' _ x hx'

  let τ : ∀ T : Z.ProEt, T ⟶ (wcProEtBC i).obj (Scheme.ProEt.mk (𝟙 X)) := fun T =>
    MorphismProperty.Over.homMk (Limits.pullback.lift (T.hom ≫ i) T.hom (Category.comp_id _))
      (Limits.pullback.lift_snd _ _ _) trivial

  have hCD : (wcProEtBC i).IsCoverDense (Scheme.ProEt.topology Z) := by
    refine Functor.IsCoverDense.mk (fun T => hcov T _ ?_)
    intro T' t hT'
    obtain ⟨n, W, w, a, -, hGa, -, hsurj⟩ := hrel (Scheme.ProEt.mk (𝟙 X)) T' hT' (τ T')
    exact ⟨n, fun k => (wcProEtBC i).obj (W k), a, hGa,
      fun k => ⟨Presieve.CoverByImageStructure.mk (W k) (𝟙 _) (a k ≫ t) (Category.id_comp _)⟩,
      hsurj⟩
  have hLF : (wcProEtBC i).IsLocallyFull (Scheme.ProEt.topology Z) := by
    refine Functor.IsLocallyFull.mk (fun {U V} f => hcov _ _ ?_)
    intro T' t hT'
    obtain ⟨P, p₁, p₂, γ, h1, h2⟩ := hgraph U V f
    obtain ⟨n, W, w, a, -, hGa, hcomm, hsurj⟩ := hrel P T' hT' (t ≫ γ)
    refine ⟨n, fun k => (wcProEtBC i).obj (W k), a, hGa, fun k => ?_, hsurj⟩
    have e1 : (wcProEtBC i).map (w k ≫ p₁) = a k ≫ t := by
      rw [Functor.map_comp, ← hcomm, Category.assoc, Category.assoc, h1, Category.comp_id]
    have e2 : (wcProEtBC i).map (w k ≫ p₂) = (wcProEtBC i).map (w k ≫ p₁) ≫ f := by
      rw [e1, Functor.map_comp, ← hcomm, Category.assoc, Category.assoc, h2]
      exact (Category.assoc _ _ _).symm
    exact ⟨W k, w k ≫ p₁, 𝟙 _, ⟨w k ≫ p₂, e2⟩, by rw [e1, Category.id_comp]⟩
  haveI := hCD
  haveI := hLF
  have hF := Functor.IsCoverDense.full_sheafPushforwardContinuous (A := AddCommGrpCat.{u+1})
    (Scheme.ProEt.topology X) (Scheme.ProEt.topology Z) (wcProEtBC i)
  have hf := Functor.IsCoverDense.faithful_sheafPushforwardContinuous (A := AddCommGrpCat.{u+1})
    (Scheme.ProEt.topology X) (Scheme.ProEt.topology Z) (wcProEtBC i)

  have hloc : ∀ (T : Z.ProEt) (r : (wcRingSheaf Z ℓ).obj.obj (Opposite.op T)),
      Sieve.generate (fun (T' : Z.ProEt) (c : T' ⟶ T) => ∃ (W : X.ProEt)
          (k : T' ⟶ (wcProEtBC i).obj W)
          (c' : (wcProEtBC i).obj W ⟶ T) (s : (wcRingSheaf X ℓ).obj.obj (Opposite.op W)),
          k ≫ c' = c ∧
            ((wcRingSheaf Z ℓ).obj.map c'.op).hom r = (D.φ.hom.app (Opposite.op W)).hom s) ∈
        Scheme.ProEt.topology Z T := by
    intro T r
    apply hcov
    intro T' t hT'
    obtain ⟨n, W, w, a, hWa, hGa, -, hsurj⟩ := hrel (Scheme.ProEt.mk (𝟙 X)) T' hT' (τ T')
    have hext := fun k => wc_fibre_function_local_extension i ℓ (W k) (hWa k)
      (((wcRingSheaf Z ℓ).obj.map (a k ≫ t).op).hom r)
    choose W' g s hW' hgs hs using hext
    have hGs : ∀ k, Function.Surjective ((wcProEtBC i).map (g k)).left := by
      intro k
      obtain ⟨m, hm⟩ : ∃ m : Limits.pullback (W' k).hom i ⟶ Limits.pullback (W k).hom i,
          m = ((wcProEtBC i).map (g k)).left := ⟨_, rfl⟩
      obtain ⟨gl, hgl⟩ : ∃ gl : (W' k).left ⟶ (W k).left, gl = (g k).left := ⟨_, rfl⟩
      have hmf : m ≫ Limits.pullback.fst (W k).hom i = Limits.pullback.fst (W' k).hom i ≫ gl := by
        rw [hm, hgl]; exact Limits.pullback.lift_fst _ _ _
      have hms : m ≫ Limits.pullback.snd (W k).hom i = Limits.pullback.snd (W' k).hom i := by
        rw [hm]; exact MorphismProperty.Over.w ((wcProEtBC i).map (g k))
      have hgw : gl ≫ (W k).hom = (W' k).hom := by rw [hgl]; exact MorphismProperty.Over.w (g k)
      have outer : IsPullback (m ≫ Limits.pullback.snd (W k).hom i)
          (Limits.pullback.fst (W' k).hom i) i (gl ≫ (W k).hom) := by
        rw [hms, hgw]; exact (IsPullback.of_hasPullback _ _).flip
      have hpb := IsPullback.of_right outer hmf (IsPullback.of_hasPullback (W k).hom i).flip
      have hsg : Surjective gl := by rw [hgl]; exact hgs k
      rw [← hm]
      exact (MorphismProperty.of_isPullback (P := @Surjective) hpb.flip hsg).surj
    refine ⟨n, fun k => (wcProEtBC i).obj (W' k), fun k => (wcProEtBC i).map (g k) ≫ a k,
      fun k => ?_, fun k => ?_, fun x => ?_⟩
    · haveI : IsAffine (W' k).left := hW' k
      haveI : IsAffine ((𝟭 Scheme.{u}).obj (W' k).left) := hW' k
      exact (IsClosedImmersion.isAffine_surjective_of_isAffine
        (Limits.pullback.fst (W' k).hom i)).1
    · apply Sieve.le_generate
      refine ⟨W' k, 𝟙 _, (wcProEtBC i).map (g k) ≫ a k ≫ t, s k, ?_, ?_⟩
      · simp only [Category.id_comp, Category.assoc]
      · exact (hs k).symm.trans (hD (W' k) (s k)).symm
    · obtain ⟨k, z, hz⟩ := hsurj x
      obtain ⟨z', hz'⟩ := hGs k z
      refine ⟨k, z', ?_⟩
      obtain ⟨al, hal⟩ : ∃ al : Limits.pullback (W k).hom i ⟶ T'.left, al = (a k).left := ⟨_, rfl⟩
      obtain ⟨ml, hml⟩ : ∃ ml : Limits.pullback (W' k).hom i ⟶ Limits.pullback (W k).hom i,
          ml = ((wcProEtBC i).map (g k)).left := ⟨_, rfl⟩
      have hc : ((wcProEtBC i).map (g k) ≫ a k).left = ml ≫ al := by rw [hal, hml]; rfl
      rw [hc]
      rw [← hml] at hz'
      rw [← hal] at hz
      exact (Scheme.Hom.comp_apply ml al z').trans ((congrArg al hz').trans hz)

  have s4 : ∀ {C₁ C₂ : Type (u+1)} [Category.{u} C₁] [Category.{u} C₂]
      {J : GrothendieckTopology C₁} {K : GrothendieckTopology C₂} (G : C₁ ⥤ C₂) [G.IsContinuous J K]
      (S : Sheaf J RingCat.{u+1}) (R : Sheaf K RingCat.{u+1})
      (φ : S ⟶ (G.sheafPushforwardContinuous RingCat.{u+1} J K).obj R),
      (G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K).Full →
      (G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K).Faithful →
      (∀ (T : C₂) (r : R.obj.obj (Opposite.op T)),
        Sieve.generate (fun (T' : C₂) (c : T' ⟶ T) => ∃ (W : C₁) (k : T' ⟶ G.obj W)
          (c' : G.obj W ⟶ T) (s : S.obj.obj (Opposite.op W)), k ≫ c' = c ∧
            (R.obj.map c'.op).hom r = (φ.hom.app (Opposite.op W)).hom s) ∈ K T) →
      (SheafOfModules.pushforward.{u+1} φ).Full ∧ (SheafOfModules.pushforward.{u+1} φ).Faithful := by
    intro C₁ C₂ _ _ J K G _ S R φ hfull hfaith hloc'
    refine ⟨⟨fun {M N} h => ?_⟩, ⟨fun {M N} f g hfg => ?_⟩⟩
    · let hS : (G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K).obj
          ((SheafOfModules.toSheaf.{u+1} R).obj M) ⟶
          (G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K).obj
          ((SheafOfModules.toSheaf.{u+1} R).obj N) := (SheafOfModules.toSheaf.{u+1} S).map h
      obtain ⟨ht, hht⟩ := hfull.map_surjective hS
      let ψ : ∀ T : C₂ᵒᵖ, M.val.obj T → N.val.obj T := fun T x => (ht.hom.app T).hom x
      let φW : ∀ W : C₁, S.obj.obj (Opposite.op W) → R.obj.obj (Opposite.op (G.obj W)) :=
        fun W s => (φ.hom.app (Opposite.op W)).hom s
      have hcomp : ∀ (W : C₁) (x : M.val.obj (Opposite.op (G.obj W))),
          ψ (Opposite.op (G.obj W)) x = (h.val.app (Opposite.op W)).hom x := by
        intro W x
        have := congrArg (fun k => (k.hom.app (Opposite.op W)).hom x) hht
        exact this
      have hlinW : ∀ (W : C₁) (s : S.obj.obj (Opposite.op W))
          (x : M.val.obj (Opposite.op (G.obj W))),
          ψ (Opposite.op (G.obj W)) (φW W s • x) = φW W s • ψ (Opposite.op (G.obj W)) x := by
        intro W s x
        rw [hcomp, hcomp]
        exact (h.val.app (Opposite.op W)).hom.map_smul s x
      have hnat : ∀ {T T' : C₂} (c : T' ⟶ T) (z : M.val.obj (Opposite.op T)),
          (N.val.map c.op).hom (ψ (Opposite.op T) z) =
            ψ (Opposite.op T') ((M.val.map c.op).hom z) :=
        fun c z => (NatTrans.naturality_apply ht.hom c.op z).symm
      have lin : ∀ (T : C₂ᵒᵖ) (r : R.obj.obj T) (m : M.val.obj T),
          ψ T (r • m) = r • ψ T m := by
        intro T r m
        obtain ⟨T⟩ := T
        refine (Sheaf.isSeparated ((SheafOfModules.toSheaf.{u+1} R).obj N)) T _ (hloc' T r) _ _ ?_
        intro Y f hf
        obtain ⟨Y', h1, g, ⟨W, k, c', s, hkc, hr⟩, rfl⟩ := hf
        subst hkc
        have key : (N.val.map c'.op).hom (ψ (Opposite.op T) (r • m)) =
            (N.val.map c'.op).hom (r • ψ (Opposite.op T) m) := by
          rw [hnat, PresheafOfModules.map_smul, PresheafOfModules.map_smul, hnat]
          change ψ _ ((R.obj.map c'.op).hom r • _) = (R.obj.map c'.op).hom r • _
          rw [hr]
          exact hlinW W s _
        change (N.val.map (h1 ≫ k ≫ c').op).hom (ψ (Opposite.op T) (r • m)) =
          (N.val.map (h1 ≫ k ≫ c').op).hom (r • ψ (Opposite.op T) m)
        simp only [op_comp, PresheafOfModules.map_comp, ModuleCat.hom_comp, LinearMap.comp_apply]
        rw [key]
      let h' : M ⟶ N := ⟨PresheafOfModules.homMk ht.hom lin⟩
      refine ⟨h', ?_⟩
      apply Functor.map_injective (SheafOfModules.toSheaf.{u+1} S)
      exact hht
    · apply Functor.map_injective (SheafOfModules.toSheaf.{u+1} R)
      apply Functor.map_injective (G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K)
      exact congrArg (SheafOfModules.toSheaf.{u+1} S).map hfg
  exact s4 (wcProEtBC i) (wcRingSheaf X ℓ) (wcRingSheaf Z ℓ) D.φ hF hf hloc

theorem wc_proet_open_pull_closed_push_isZero {X Z : Scheme.{u}} (i : Z ⟶ X) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (V : X.Opens) (hV : (V : Set X) = (Set.range i)ᶜ)
    (D : wcHMPullData i ℓ) (Dj : wcHMPullData V.ι ℓ) (hDj : wcHMPullCanonical Dj)
    (M : SheafOfModules.{u+1} (wcRingSheaf Z ℓ)) :
    Limits.IsZero (Dj.Φ.obj ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).obj M)) :=
by
  haveI hσ : (wcSliceToOver X (Scheme.ProEt.mk V.ι)).IsContinuous
      (Scheme.ProEt.topology (Scheme.ProEt.mk V.ι).left)
      ((Scheme.ProEt.topology X).over (Scheme.ProEt.mk V.ι)) :=
    (wc_slice_over_sites_cont X (Scheme.ProEt.mk V.ι)).1
  haveI hj : (wcSliceFunctor X (Scheme.ProEt.mk V.ι)).IsContinuous
      (Scheme.ProEt.topology (Scheme.ProEt.mk V.ι).left) (Scheme.ProEt.topology X) :=
    Functor.isContinuous_comp (wcSliceToOver X (Scheme.ProEt.mk V.ι))
      (Over.forget (Scheme.ProEt.mk V.ι))
      (Scheme.ProEt.topology (Scheme.ProEt.mk V.ι).left)
      ((Scheme.ProEt.topology X).over (Scheme.ProEt.mk V.ι)) (Scheme.ProEt.topology X)
  obtain ⟨e⟩ := wc_hm_pull_Phi_slice_iso X ℓ (Scheme.ProEt.mk V.ι) Dj hDj
  refine Limits.IsZero.of_iso ?_ (e.app _)
  have hSubGen : ∀ B : Z.ProEt, IsEmpty B.left →
      Subsingleton ↑(((SheafOfModules.toSheaf (wcRingSheaf Z ℓ)).obj M).obj.obj
        (Opposite.op B)) := by
    intro B hE
    haveI := hE
    exact AddCommGrpCat.subsingleton_of_isZero
      (Sheaf.isTerminalOfBotCover ((SheafOfModules.toSheaf (wcRingSheaf Z ℓ)).obj M) B
        (Scheme.ProEt.bot_mem_topology B)).isZero
  have hSub : ∀ T : (Scheme.ProEt.mk V.ι).left.ProEt,
      Subsingleton ↑(((SheafOfModules.toSheaf (wcRingSheaf Z ℓ)).obj M).obj.obj
        (Opposite.op ((wcProEtBC i).obj ((wcSliceFunctor X (Scheme.ProEt.mk V.ι)).obj T)))) := by
    intro T
    have hEmpty : IsEmpty ↥(Limits.pullback (T.hom ≫ V.ι) i) :=
      Scheme.isEmpty_pullback (T.hom ≫ V.ι) i (Set.disjoint_left.2 (by
        rintro _ ⟨w, rfl⟩
        have h1 : (T.hom ≫ V.ι) w ∈ (V : Set X) := by
          rw [← Scheme.Opens.range_ι V]
          exact ⟨T.hom w, rfl⟩
        rw [hV] at h1
        exact h1))
    exact hSubGen _ hEmpty
  refine (Limits.IsZero.iff_id_eq_zero _).2 ?_
  apply SheafOfModules.hom_ext
  apply PresheafOfModules.hom_ext
  intro U
  haveI := hSub U.unop
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  exact @Subsingleton.elim _ (hSub U.unop) _ _

theorem wc_lan_flat_unit_eq_zero_factor : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D]
    (G : C ⥤ D) [RepresentablyFlat G] (F : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}) (U : D) (V₁ : C)
    (a : U ⟶ G.obj V₁) (t : F.obj (Opposite.op V₁)),
    (G.op.lan.obj F).map a.op ((G.op.lanUnit.app F).app (Opposite.op V₁) t) = 0 →
    ∃ (V₂ : C) (c : V₂ ⟶ V₁) (a' : U ⟶ G.obj V₂), a' ≫ G.map c = a ∧ F.map c.op t = 0 :=
by
  intro C D _ _ G _ F U V₁ a t ht
  haveI : IsCofiltered (StructuredArrow U G) := RepresentablyFlat.cofiltered U
  haveI hI : IsFiltered (CostructuredArrow G.op (Opposite.op U)) :=
    IsFiltered.of_equivalence (structuredArrowOpEquivalence G U)
  haveI : IsFiltered (ULiftHom.{u+1} (CostructuredArrow G.op (Opposite.op U))) :=
    IsFiltered.of_equivalence ULiftHom.equiv
  haveI := Limits.preservesColimitsOfShape_of_equiv
    (ULiftHom.equiv (C := CostructuredArrow G.op (Opposite.op U))).symm (forget AddCommGrpCat.{u+1})
  let E := Functor.LeftExtension.mk (G.op.leftKanExtension F) (G.op.leftKanExtensionUnit F)
  have hc : Limits.IsColimit (E.coconeAt (Opposite.op U)) :=
    G.op.isPointwiseLeftKanExtensionLeftKanExtensionUnit F (Opposite.op U)
  let j : CostructuredArrow G.op (Opposite.op U) := CostructuredArrow.mk (Y := Opposite.op V₁) a.op
  let t' : ToType ((CostructuredArrow.proj G.op (Opposite.op U) ⋙ F).obj j) := t
  have hleg : (E.coconeAt (Opposite.op U)).ι.app j t' =
      (G.op.lan.obj F).map a.op ((G.op.lanUnit.app F).app (Opposite.op V₁) t) := rfl
  have h0 : (E.coconeAt (Opposite.op U)).ι.app j t' =
      (E.coconeAt (Opposite.op U)).ι.app j 0 := by
    rw [map_zero]
    exact hleg.trans ht
  obtain ⟨k, f, g', hfg⟩ := Limits.Concrete.isColimit_exists_of_rep_eq _ hc t' 0 h0
  have hw : G.op.map f.left ≫ k.hom = a.op := CostructuredArrow.w f
  refine ⟨k.left.unop, f.left.unop, k.hom.unop, ?_, ?_⟩
  · apply Quiver.Hom.op_inj
    rw [op_comp]
    exact hw
  · exact hfg.trans (map_zero _)

theorem wc_proet_open_pull_isZero_vanish_off {X Z : Scheme.{u}} (i : Z ⟶ X) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (V : X.Opens) (hV : (V : Set X) = (Set.range i)ᶜ)
    (Dj : wcHMPullData V.ι ℓ) (hDj : wcHMPullCanonical Dj)
    (N : SheafOfModules.{u+1} (wcRingSheaf X ℓ)) (hN : Limits.IsZero (Dj.Φ.obj N)) :
    ∀ (W T : X.ProEt) (g : T ⟶ W) (s : N.val.obj (Opposite.op W)),
      (∀ t : T.left, T.hom t ∉ Set.range i) → (N.val.map g.op).hom s = 0 :=
by
  intro W T g s hoff
  haveI hσ : (wcSliceToOver X (Scheme.ProEt.mk V.ι)).IsContinuous
      (Scheme.ProEt.topology (Scheme.ProEt.mk V.ι).left)
      ((Scheme.ProEt.topology X).over (Scheme.ProEt.mk V.ι)) :=
    (wc_slice_over_sites_cont X (Scheme.ProEt.mk V.ι)).1
  haveI hj : (wcSliceFunctor X (Scheme.ProEt.mk V.ι)).IsContinuous
      (Scheme.ProEt.topology (Scheme.ProEt.mk V.ι).left) (Scheme.ProEt.topology X) :=
    Functor.isContinuous_comp (wcSliceToOver X (Scheme.ProEt.mk V.ι))
      (Over.forget (Scheme.ProEt.mk V.ι))
      (Scheme.ProEt.topology (Scheme.ProEt.mk V.ι).left)
      ((Scheme.ProEt.topology X).over (Scheme.ProEt.mk V.ι)) (Scheme.ProEt.topology X)
  obtain ⟨e⟩ := wc_hm_pull_Phi_slice_iso X ℓ (Scheme.ProEt.mk V.ι) Dj hDj
  have hN' : Limits.IsZero ((wcSliceRes X ℓ (Scheme.ProEt.mk V.ι)).obj N) :=
    Limits.IsZero.of_iso hN (e.app N).symm
  have hsub : ∀ T' : (Scheme.ProEt.mk V.ι).left.ProEt,
      ∀ y : N.val.obj (Opposite.op ((wcSliceFunctor X (Scheme.ProEt.mk V.ι)).obj T')), y = 0 := by
    intro T' y
    have hz : Limits.IsZero (((SheafOfModules.toSheaf (wcRingSheaf (Scheme.ProEt.mk V.ι).left ℓ)).obj
        ((wcSliceRes X ℓ (Scheme.ProEt.mk V.ι)).obj N)).obj.obj (Opposite.op T')) :=
      Functor.map_isZero (SheafOfModules.toSheaf (wcRingSheaf (Scheme.ProEt.mk V.ι).left ℓ) ⋙
        sheafToPresheaf _ _ ⋙ (evaluation _ _).obj (Opposite.op T')) hN'
    exact @Subsingleton.elim _ (AddCommGrpCat.subsingleton_of_isZero hz) y 0
  have hsubset : Set.range T.hom ⊆ Set.range V.ι := by
    rintro _ ⟨t, rfl⟩
    rw [Scheme.Opens.range_ι, hV]
    exact hoff t
  let l : T.left ⟶ (V : Scheme.{u}) := IsOpenImmersion.lift V.ι T.hom hsubset
  have hl : l ≫ V.ι = T.hom := IsOpenImmersion.lift_fac V.ι T.hom hsubset
  haveI : WeaklyEtale (l ≫ V.ι) := by rw [hl]; exact T.prop
  have hlw : WeaklyEtale l := WeaklyEtale.of_comp l V.ι
  let T' : (Scheme.ProEt.mk V.ι).left.ProEt :=
    @Scheme.ProEt.mk (Scheme.ProEt.mk V.ι).left T.left l hlw
  let B : X.ProEt := (wcSliceFunctor X (Scheme.ProEt.mk V.ι)).obj T'
  have hBl : B.left = T.left := rfl
  let φ : T ⟶ B := MorphismProperty.Over.homMk (𝟙 T.left : T.left ⟶ B.left)
    ((Category.id_comp (l ≫ V.ι)).trans hl) trivial
  let g' : B ⟶ W := MorphismProperty.Over.homMk (g.left : B.left ⟶ W.left)
    ((MorphismProperty.Over.w g).trans hl.symm) trivial
  have hfac : φ ≫ g' = g := by
    apply MorphismProperty.Over.Hom.ext
    exact Category.id_comp g.left
  have hy : (N.val.map g'.op).hom s = 0 := hsub T' _
  have h2 : (N.val.map g.op).hom s = (N.val.map φ.op).hom ((N.val.map g'.op).hom s) := by
    rw [← hfac, op_comp, PresheafOfModules.map_comp_apply]
  rw [h2, hy]
  exact (N.val.map φ.op).hom.map_zero

theorem wc_proet_closed_pull_isZero_local_factor {X Z : Scheme.{u}} (i : Z ⟶ X) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)]
    (hlan : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D]
      (G : C ⥤ D) [RepresentablyFlat G] (F : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}) (U : D) (V₁ : C)
      (a : U ⟶ G.obj V₁) (t : F.obj (Opposite.op V₁)),
      (G.op.lan.obj F).map a.op ((G.op.lanUnit.app F).app (Opposite.op V₁) t) = 0 →
      ∃ (V₂ : C) (c : V₂ ⟶ V₁) (a' : U ⟶ G.obj V₂), a' ≫ G.map c = a ∧ F.map c.op t = 0)
    (D : wcHMPullData i ℓ) (hD : wcHMPullCanonical D)
    (N : SheafOfModules.{u+1} (wcRingSheaf X ℓ)) (hN : Limits.IsZero (D.Φ.obj N)) :
    ∀ (W : X.ProEt) (s : N.val.obj (Opposite.op W)),
      ∃ Rs : Sieve ((wcProEtBC i).obj W), Rs ∈ Scheme.ProEt.topology Z ((wcProEtBC i).obj W) ∧
        ∀ (U : Z.ProEt) (e : U ⟶ (wcProEtBC i).obj W), Rs.arrows e →
          ∃ (V₂ : X.ProEt) (c : V₂ ⟶ W) (a : U ⟶ (wcProEtBC i).obj V₂),
            a ≫ (wcProEtBC i).map c = e ∧ (N.val.map c.op).hom s = 0 :=
by
  classical
  haveI := D.cont
  haveI hflat : RepresentablyFlat (wcProEtBC i) := (wc_proet_pullback_continuous_flat i).2
  obtain ⟨LS0, LI0⟩ := wc_proet_contfun_pullback_locally_bijective i ℓ
  have LS : ∀ (V' : Z.ProEt) (r' : (wcRingSheaf Z ℓ).obj.obj (Opposite.op V')),
      ∃ T ∈ Scheme.ProEt.topology Z V', ∀ ⦃W' : Z.ProEt⦄ (g : W' ⟶ V'), T.arrows g →
        ∃ (V : X.ProEt) (a : W' ⟶ (wcProEtBC i).obj V) (r : (wcRingSheaf X ℓ).obj.obj (Opposite.op V)),
          ((wcRingSheaf Z ℓ).obj.map g.op).hom r' =
            ((wcRingSheaf Z ℓ).obj.map a.op).hom ((D.φ.hom.app (Opposite.op V)).hom r) := by
    intro V' r'
    obtain ⟨T, hT, hTg⟩ := LS0 V' r'
    refine ⟨T, hT, fun W' g hg => ?_⟩
    obtain ⟨V, a, r, h⟩ := hTg g hg
    refine ⟨V, a, r, ?_⟩
    have e := hD V r
    show r'.comp g.left.base.hom = ((D.φ.hom.app (Opposite.op V)).hom r).comp a.left.base.hom
    rw [e]
    exact h
  have LI : ∀ (V' : Z.ProEt) (V : X.ProEt) (a : V' ⟶ (wcProEtBC i).obj V)
      (r : (wcRingSheaf X ℓ).obj.obj (Opposite.op V)),
      ((wcRingSheaf Z ℓ).obj.map a.op).hom ((D.φ.hom.app (Opposite.op V)).hom r) = 0 →
      ∃ T ∈ Scheme.ProEt.topology Z V', ∀ ⦃W' : Z.ProEt⦄ (g : W' ⟶ V'), T.arrows g →
        ∃ (W : X.ProEt) (b : W ⟶ V) (a' : W' ⟶ (wcProEtBC i).obj W),
          a' ≫ (wcProEtBC i).map b = g ≫ a ∧ ((wcRingSheaf X ℓ).obj.map b.op).hom r = 0 := by
    intro V' V a r h0
    have e := hD V r
    have h0' : ((D.φ.hom.app (Opposite.op V)).hom r).comp a.left.base.hom = 0 := h0
    rw [e] at h0'
    obtain ⟨T, hT, hTg⟩ := LI0 V' V a r h0'
    refine ⟨T, hT, fun W' g hg => ?_⟩
    obtain ⟨W, b, a', h1, h2⟩ := hTg g hg
    exact ⟨W, b, a', h1, h2⟩
  obtain ⟨τ⟩ := wc_sheafOfModules_pullback_toSheaf_iso (Scheme.ProEt.topology X)
    (Scheme.ProEt.topology Z) (wcProEtBC i) (wcRingSheaf X ℓ) (wcRingSheaf Z ℓ) D.φ
    LS LI D.Φ D.adj
  have h1 : Limits.IsZero ((SheafOfModules.toSheaf.{u+1} (wcRingSheaf Z ℓ)).obj (D.Φ.obj N)) :=
    Functor.map_isZero _ hN
  have h2 : Limits.IsZero (((wcProEtBC i).sheafPullback AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology X) (Scheme.ProEt.topology Z)).obj
      ((SheafOfModules.toSheaf.{u+1} (wcRingSheaf X ℓ)).obj N)) :=
    Limits.IsZero.of_iso h1 (τ.app N).symm
  have h3 : Limits.IsZero ((presheafToSheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}).obj
      ((wcProEtBC i).op.lan.obj ((SheafOfModules.toSheaf.{u+1} (wcRingSheaf X ℓ)).obj N).obj)) :=
    Limits.IsZero.of_iso h2 ((Functor.sheafPullbackConstruction.sheafPullbackIso (wcProEtBC i)
      AddCommGrpCat.{u+1} (Scheme.ProEt.topology X) (Scheme.ProEt.topology Z)).app
      ((SheafOfModules.toSheaf.{u+1} (wcRingSheaf X ℓ)).obj N)).symm
  intro W s
  set P : (X.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
    ((SheafOfModules.toSheaf.{u+1} (wcRingSheaf X ℓ)).obj N).obj with hP
  set K := Scheme.ProEt.topology Z with hK
  set P₀ := (wcProEtBC i).op.lan.obj P with hP₀
  let x : P₀.obj (Opposite.op ((wcProEtBC i).obj W)) :=
    ((wcProEtBC i).op.lanUnit.app P).app (Opposite.op W) s
  haveI hsub : Subsingleton ((sheafify K P₀).obj (Opposite.op ((wcProEtBC i).obj W))) :=
    AddCommGrpCat.subsingleton_of_isZero (Functor.map_isZero
      (sheafToPresheaf K AddCommGrpCat.{u+1} ⋙
        (evaluation _ _).obj (Opposite.op ((wcProEtBC i).obj W))) h3)
  have hx : (toSheafify K P₀).app (Opposite.op ((wcProEtBC i).obj W)) x =
      (toSheafify K P₀).app (Opposite.op ((wcProEtBC i).obj W)) 0 := Subsingleton.elim _ _
  have hRs : Presheaf.equalizerSieve (F := P₀) x 0 ∈ K ((wcProEtBC i).obj W) :=
    Presheaf.equalizerSieve_mem K (toSheafify K P₀) x 0 hx
  refine ⟨Presheaf.equalizerSieve (F := P₀) x 0, hRs, fun U e he => ?_⟩
  rw [Presheaf.equalizerSieve_apply, map_zero] at he
  obtain ⟨V₂, c, a', hc1, hc2⟩ := hlan (wcProEtBC i) P U W e s he
  exact ⟨V₂, c, a', hc1, hc2⟩

theorem wc_proet_closed_module_zero_of_local_vanishing {X Z : Scheme.{u}} (i : Z ⟶ X)
    [IsClosedImmersion i] [IsLocallyNoetherian X]
    (hfin : ∀ (S : Scheme.{u}) (U : S.ProEt), IsAffine U.left → ∀ (R : Sieve U),
      R ∈ Scheme.ProEt.topology S U → ∃ (n : ℕ) (W : Fin n → S.ProEt) (h : ∀ k, W k ⟶ U),
        (∀ k, R.arrows (h k)) ∧ (∀ k, IsAffine (W k).left) ∧ ∀ x : U.left, ∃ k, x ∈ Set.range (h k).left)
    (hcpt : ∀ (S : Scheme.{u}) (V : S.ProEt) (K : Set V.left), IsCompact K →
      ∃ (m : ℕ) (P : Fin m → S.ProEt) (d : ∀ j, P j ⟶ V),
        (∀ j, IsAffine (P j).left) ∧ K ⊆ ⋃ j, Set.range (d j).left)
    {R : Sheaf (Scheme.ProEt.topology X) RingCat.{u+1}} (N : SheafOfModules.{u+1} R)
    (hoff : ∀ (W T : X.ProEt) (g : T ⟶ W) (s : N.val.obj (Opposite.op W)),
      (∀ t : T.left, T.hom t ∉ Set.range i) → (N.val.map g.op).hom s = 0)
    (hZ : ∀ (W : X.ProEt) (s : N.val.obj (Opposite.op W)),
      ∃ Rs : Sieve ((wcProEtBC i).obj W), Rs ∈ Scheme.ProEt.topology Z ((wcProEtBC i).obj W) ∧
        ∀ (U : Z.ProEt) (e : U ⟶ (wcProEtBC i).obj W), Rs.arrows e →
          ∃ (V₂ : X.ProEt) (c : V₂ ⟶ W) (a : U ⟶ (wcProEtBC i).obj V₂),
            a ≫ (wcProEtBC i).map c = e ∧ (N.val.map c.op).hom s = 0) :
    ∀ (W : X.ProEt) (s : N.val.obj (Opposite.op W)), s = 0 :=
by
  classical


  have crit : ∀ (V : X.ProEt) (m : N.val.obj (Opposite.op V)),
      (∀ (W : X.ProEt) (g : W ⟶ V), IsAffine W.left →
        ∃ (n : ℕ) (W' : Fin n → X.ProEt) (e : ∀ k, W' k ⟶ W),
          (∀ k, IsAffine (W' k).left) ∧ (∀ x : ↥W.left, ∃ k, x ∈ Set.range (e k).left) ∧
          ∀ k, (N.val.map (e k ≫ g).op).hom m = 0) → m = 0 := by
    intro V m h
    have fin_covers : ∀ (U : X.ProEt) [QuasiSeparatedSpace U.left] (n : ℕ) (W : Fin n → X.ProEt)
        (h : ∀ i, W i ⟶ U), (∀ i, IsAffine (W i).left) →
        (∀ x : U.left, ∃ i, x ∈ Set.range (h i).left) →
        Sieve.generate (Presieve.ofArrows W h) ∈ Scheme.ProEt.topology X U := by
      intro U _ n W h hA hJ
      have hs : ∀ x : U.left, ∃ j y, (h j).left y = x := by
        intro x
        obtain ⟨j, y, hy⟩ := hJ x
        exact ⟨j, y, hy⟩
      have hq : ∀ i, QuasiCompact (h i).left := fun i => by
        haveI := hA i
        exact quasiCompact_of_compactSpace _
      have hw : ∀ i, WeaklyEtale (h i).left := fun i => by
        have h1 : WeaklyEtale ((h i).left ≫ U.hom) := by
          rw [MorphismProperty.Over.w (h i)]
          exact (W i).prop
        haveI := U.prop
        exact @WeaklyEtale.of_comp _ _ _ (h i).left U.hom h1 U.prop
      have H : Presieve.ofArrows (fun i => (W i).left) (fun i => (h i).left) ∈
          Scheme.proetalePrecoverage.coverings U.left :=
        ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr (@QuasiCompactCover.of_finite _ _
          (Scheme.Cover.mkOfCovers (P := ⊤) (Fin n) (fun i => (W i).left) (fun i => (h i).left)
            hs (fun _ => trivial)) _ hq
            (inferInstanceAs (Finite (Fin n)))),
          (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr
            ⟨fun x => by obtain ⟨j, y, hy⟩ := hs x; exact ⟨j, y, hy⟩, hw⟩⟩
      exact Precoverage.generate_mem_toGrothendieck
        (Precoverage.mem_comap_iff.mpr (by rw [Presieve.map_ofArrows]; exact H))
    have affine_local : ∀ (U : X.ProEt) (T : Sieve U),
        (∀ (V : X.ProEt) (f : V ⟶ U), IsAffine V.left → T.pullback f ∈ Scheme.ProEt.topology X V) →
        T ∈ Scheme.ProEt.topology X U := by
      intro U T hT
      have hU : WeaklyEtale U.hom := U.prop
      let W : U.left.affineCover.I₀ → X.ProEt := fun i =>
        MorphismProperty.Over.mk ⊤ (U.left.affineCover.f i ≫ U.hom) inferInstance
      let e : ∀ i, W i ⟶ U := fun i => MorphismProperty.Over.homMk (U.left.affineCover.f i) rfl trivial
      have hP : Presieve.ofArrows W e ∈ (Scheme.ProEt.precoverage X).coverings U := by
        show _ ∈ (Precoverage.comap (Scheme.ProEt.forget X ⋙ Over.forget X)
          Scheme.proetalePrecoverage).coverings U
        rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
        change U.left.affineCover.presieve₀ ∈ Scheme.proetalePrecoverage.coverings U.left
        exact ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage U.left U.left.affineCover.mem₀,
          U.left.affineCover.mem₀.1,
          MorphismProperty.ofArrows_mem_precoverage.mpr (fun i => inferInstance)⟩
      refine GrothendieckTopology.transitive _ (Precoverage.generate_mem_toGrothendieck hP) T ?_
      intro Y f hf
      obtain ⟨Y', h, g', hg', rfl⟩ := hf
      rcases hg' with ⟨i⟩
      rw [Sieve.pullback_comp]
      exact GrothendieckTopology.pullback_stable _ h
        (hT (W i) (e i) (show IsAffine (U.left.affineCover.X i) by infer_instance))
    let T0 : Sieve V :=
      { arrows := fun _ f => (N.val.map f.op).hom m = 0
        downward_closed := by
          intro Y Z f hf g
          have hf' : (N.val.map f.op).hom m = 0 := hf
          show (N.val.map (g ≫ f).op).hom m = 0
          rw [op_comp, PresheafOfModules.map_comp, ModuleCat.hom_comp, LinearMap.comp_apply, hf',
            map_zero] }
    have hT0 : T0 ∈ Scheme.ProEt.topology X V := by
      apply affine_local V T0
      intro W f hW
      obtain ⟨n, W', e, haff, hsurj, hzero⟩ := h W f hW
      haveI : IsAffine W.left := hW
      refine GrothendieckTopology.superset_covering _ ?_
        (fin_covers W n W' e haff hsurj)
      rw [Sieve.generate_le_iff]
      rintro _ _ ⟨k⟩
      show (N.val.map (e k ≫ f).op).hom m = 0
      exact hzero k
    refine N.isSheaf.isSeparated V T0 hT0 m (0 : N.val.obj (Opposite.op V)) ?_
    intro Y f hf
    have hf' : (N.val.map f.op).hom m = 0 := hf
    change (N.val.map f.op).hom m = (N.val.map f.op).hom 0
    rw [map_zero]
    exact hf'
  intro W₀ s₀
  apply crit W₀ s₀
  intro W g hWaff
  set s := (N.val.map g.op).hom s₀ with hsdef
  have hkillT : ∀ {T : X.ProEt} (e : T ⟶ W), (N.val.map e.op).hom s = 0 →
      (N.val.map (e ≫ g).op).hom s₀ = 0 := by
    intro T e he
    rw [op_comp, PresheafOfModules.map_comp_apply]
    exact he
  have hres : ∀ {A B C : X.ProEt} (f1 : A ⟶ B) (f2 : B ⟶ C) (t : N.val.obj (Opposite.op C)),
      (N.val.map f2.op).hom t = 0 → (N.val.map (f1 ≫ f2).op).hom t = 0 := by
    intro A B C f1 f2 t ht
    rw [op_comp, PresheafOfModules.map_comp, ModuleCat.hom_comp, LinearMap.comp_apply, ht,
      map_zero]
  haveI : IsAffine W.left := hWaff


  have offcov : ∀ (U : X.ProEt) [IsAffine U.left],
      ∃ (n : ℕ) (W : Fin n → X.ProEt) (w : ∀ k, W k ⟶ U),
        (∀ k, IsAffine (W k).left) ∧
        (∀ k, IsEmpty ((wcProEtBC i).obj (W k)).left) ∧
        ∀ y : U.left, y ∉ Set.range (Limits.pullback.fst U.hom i) →
          ∃ k, y ∈ Set.range (w k).left := by
    intro U _
    haveI hU : WeaklyEtale U.hom := U.prop
    obtain ⟨O, hO⟩ : ∃ O : X.Opens, (O : Set X) = (Set.range i)ᶜ :=
      ⟨⟨(Set.range i)ᶜ, (IsClosedImmersion.isClosedEmbedding i).isClosed_range.isOpen_compl⟩, rfl⟩
    have key : ∀ {Z' : Scheme.{u}} (f : Z' ⟶ X) [CompactSpace Z'],
        IsCompact (f ⁻¹' (O : Set X)) := by
      intro Z' f _
      haveI : QuasiCompact O.ι := inferInstance
      haveI : QuasiCompact (Limits.pullback.fst f O.ι) := inferInstance
      haveI : CompactSpace (Limits.pullback f O.ι : Scheme.{u}) :=
        QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.fst f O.ι)
      have h1 := isCompact_range (Limits.pullback.fst f O.ι).continuous
      rw [Scheme.Pullback.range_fst, Scheme.Opens.range_ι] at h1
      exact h1
    have hqc : IsCompact (U.hom ⁻¹' (O : Set X)) :=
      @key U.left U.hom (inferInstanceAs (CompactSpace U.left))
    obtain ⟨K, hK⟩ : ∃ K : U.left.Opens, (K : Set U.left) = U.hom ⁻¹' (O : Set X) :=
      ⟨⟨U.hom ⁻¹' (O : Set X), O.isOpen.preimage U.hom.continuous⟩, rfl⟩
    have hKc : IsCompact (K : Set U.left) := by rw [hK]; exact hqc
    obtain ⟨s, hs, hKs⟩ := isCompact_iff_finite_and_eq_biUnion_affineOpens.mp hKc
    obtain ⟨t, ht⟩ : ∃ t : Finset U.left.affineOpens, ∀ a, a ∈ t ↔ a ∈ s :=
      ⟨hs.toFinset, fun a => hs.mem_toFinset⟩
    obtain ⟨V, hVt, hVsurj⟩ : ∃ (V : Fin t.card → U.left.affineOpens), (∀ k, V k ∈ t) ∧
        ∀ a ∈ t, ∃ k, V k = a :=
      ⟨fun k => (t.equivFin.symm k).1, fun k => (t.equivFin.symm k).2,
       fun a ha => ⟨t.equivFin ⟨a, ha⟩, by simp⟩⟩
    have hVK : ∀ k, ((V k : U.left.Opens) : Set U.left) ⊆ U.hom ⁻¹' (O : Set X) := by
      intro k
      rw [← hK, hKs]
      intro x hx
      simp only [TopologicalSpace.Opens.coe_iSup, Set.mem_iUnion]
      exact ⟨V k, (ht _).mp (hVt k), hx⟩
    refine ⟨t.card, fun k => MorphismProperty.Over.mk ⊤ ((V k : U.left.Opens).ι ≫ U.hom)
      inferInstance, fun k => MorphismProperty.Over.homMk (V k : U.left.Opens).ι rfl trivial,
      ?_, ?_, ?_⟩
    · intro k
      exact (V k).2
    · intro k
      show IsEmpty (Limits.pullback (C := Scheme.{u}) ((V k : U.left.Opens).ι ≫ U.hom) i)
      apply Scheme.isEmpty_pullback
      rw [Set.disjoint_left]
      rintro a ⟨z, rfl⟩ ⟨x, hx⟩
      have h1 : ((V k : U.left.Opens).ι z) ∈ U.hom ⁻¹' (O : Set X) :=
        hVK k (by rw [← Scheme.Opens.range_ι]; exact ⟨z, rfl⟩)
      rw [Set.mem_preimage, hO] at h1
      exact h1 ⟨x, by rw [hx]; rfl⟩
    · intro y hy
      rw [Scheme.Pullback.range_fst] at hy
      have hyK : y ∈ (K : Set U.left) := by
        rw [hK, Set.mem_preimage, hO]; exact hy
      rw [hKs] at hyK
      simp only [TopologicalSpace.Opens.coe_iSup, Set.mem_iUnion] at hyK
      obtain ⟨a, ha, hya⟩ := hyK
      obtain ⟨k, rfl⟩ := hVsurj a ((ht a).mpr ha)
      refine ⟨k, ?_⟩
      show y ∈ Set.range (V k : U.left.Opens).ι
      rw [Scheme.Opens.range_ι]
      exact hya
  obtain ⟨n₁, A₁, a₁, hA₁, hemp, hc₁⟩ := offcov W
  have hk₁ : ∀ k, (N.val.map (a₁ k).op).hom s = 0 := by
    intro k
    apply hoff W (A₁ k) (a₁ k) s
    rintro t ⟨z, hz⟩
    obtain ⟨p, -, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := (A₁ k).hom) (g := i)
      t z hz.symm
    exact (hemp k).false p

  have hGW : IsAffine ((wcProEtBC i).obj W).left := by
    haveI : IsAffine ((𝟭 Scheme.{u}).obj W.left) := hWaff
    show IsAffine (Limits.pullback W.hom i)
    exact (IsClosedImmersion.isAffine_surjective_of_isAffine (Limits.pullback.fst W.hom i)).1
  obtain ⟨Rs, hRs, hfac⟩ := hZ W s
  obtain ⟨n, U, e, heR, hUaff, hsurj⟩ := hfin Z ((wcProEtBC i).obj W) hGW Rs hRs
  choose V₂ c a hac hcs using fun k : Fin n => hfac (U k) (e k) (heR k)
  have hK : ∀ k, IsCompact (Set.range ((a k).left ≫ Limits.pullback.fst (V₂ k).hom i)) := by
    intro k
    haveI : IsAffine (U k).left := hUaff k
    exact isCompact_range (Scheme.Hom.continuous _)
  choose m P d hPaff hdcov using fun k : Fin n => hcpt X (V₂ k) _ (hK k)
  have hbc : ∀ {V W : X.ProEt} (c : V ⟶ W),
      ((wcProEtBC i).map c).left ≫ Limits.pullback.fst W.hom i =
        Limits.pullback.fst V.hom i ≫ c.left := by
    intro V W c
    have h0 : (Limits.pullback.fst V.hom i ≫ c.left) ≫ W.hom =
        Limits.pullback.snd V.hom i ≫ i := by
      rw [Category.assoc, MorphismProperty.Over.w c]; exact Limits.pullback.condition
    have hmap : ((wcProEtBC i).map c).left = Limits.pullback.lift
        (Limits.pullback.fst V.hom i ≫ c.left) (Limits.pullback.snd V.hom i) h0 := by
      first
        | rfl
        | (unfold wcProEtBC; exact MorphismProperty.Over.pullback_map_left _ _ i c)
    rw [hmap]; exact Limits.pullback.lift_fst _ _ _

  let ι : Type := Fin n₁ ⊕ (Σ k : Fin n, Fin (m k))
  let F : ι → Σ T : X.ProEt, T ⟶ W :=
    Sum.elim (fun k => ⟨A₁ k, a₁ k⟩) (fun q => ⟨P q.1 q.2, d q.1 q.2 ≫ c q.1⟩)
  have hBaff : ∀ p, IsAffine (F p).1.left := by
    rintro (k | ⟨k, j⟩)
    · exact hA₁ k
    · exact hPaff k j
  have hBkill : ∀ p, (N.val.map ((F p).2 ≫ g).op).hom s₀ = 0 := by
    rintro (k | ⟨k, j⟩)
    · exact hkillT (a₁ k) (hk₁ k)
    · exact hkillT (d k j ≫ c k) (hres (d k j) (c k) s (hcs k))
  have hBcov : ∀ x : W.left, ∃ p, x ∈ Set.range (F p).2.left := by
    intro x
    by_cases hx : x ∈ Set.range (Limits.pullback.fst W.hom i)
    · obtain ⟨p₀, rfl⟩ := hx
      obtain ⟨k, u, hu⟩ := hsurj p₀
      obtain ⟨j, w, hw⟩ := Set.mem_iUnion.mp (hdcov k ⟨u, rfl⟩)
      refine ⟨Sum.inr ⟨k, j⟩, w, ?_⟩
      show (d k j ≫ c k).left w = _
      have key2 : (e k).left = (a k).left ≫ ((wcProEtBC i).map (c k)).left := by
        rw [← hac k]; rfl
      have k4 := congrArg (fun φ => φ ((a k).left u)) (hbc (c k))
      simp only [Scheme.Hom.comp_apply] at k4
      have hu' : p₀ = ((wcProEtBC i).map (c k)).left ((a k).left u) := by
        rw [← hu, key2, Scheme.Hom.comp_apply]
      change (c k).left ((d k j).left w) = _
      rw [hw, hu']
      have k5 : Limits.pullback.fst W.hom i (((wcProEtBC i).map (c k)).left ((a k).left u)) =
          (c k).left (Limits.pullback.fst (V₂ k).hom i ((a k).left u)) := by
        first
          | exact k4
          | exact (Scheme.Hom.comp_apply _ _ _).symm.trans (k4.trans (Scheme.Hom.comp_apply _ _ _))
          | (erw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply]; exact k4)
      have e1 : ((a k).left ≫ Limits.pullback.fst (V₂ k).hom i) u =
          Limits.pullback.fst (V₂ k).hom i ((a k).left u) := by
        first
          | rfl
          | exact Scheme.Hom.comp_apply _ _ _
          | erw [Scheme.Hom.comp_apply]
      exact (congrArg (c k).left e1).trans k5.symm
    · obtain ⟨k, hk⟩ := hc₁ x hx
      exact ⟨Sum.inl k, hk⟩
  let eqv := Fintype.equivFin ι
  refine ⟨Fintype.card ι, fun j => (F (eqv.symm j)).1, fun j => (F (eqv.symm j)).2,
    fun j => hBaff _, fun x => ?_, fun j => hBkill _⟩
  obtain ⟨p, hp⟩ := hBcov x
  obtain ⟨j, rfl⟩ := eqv.symm.surjective p
  exact ⟨j, hp⟩

theorem wc_proet_affine_sieve_finite_jointly_surjective : ∀ (S : Scheme.{u}) (U : S.ProEt),
    IsAffine U.left → ∀ (R : Sieve U), R ∈ Scheme.ProEt.topology S U →
    ∃ (n : ℕ) (W : Fin n → S.ProEt) (h : ∀ k, W k ⟶ U), (∀ k, R.arrows (h k)) ∧
      (∀ k, IsAffine (W k).left) ∧ ∀ x : U.left, ∃ k, x ∈ Set.range (h k).left :=
by
  intro S U hU R hR
  have h1 := (CoverPreserving.of_isContinuous (Scheme.ProEt.forget S) (Scheme.ProEt.topology S)
    (Scheme.proetaleTopology.over S)).cover_preserve hR
  rw [GrothendieckTopology.mem_over_iff] at h1
  obtain ⟨R', hR', hle⟩ := Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition.mp h1
  obtain ⟨𝒰, hqc, rfl⟩ :=
    (Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover (P := @WeaklyEtale)).mp hR'
  haveI := hqc
  haveI : IsAffine ((Scheme.ProEt.forget S).obj U).left := hU
  obtain ⟨n, a, V, hV, hcov⟩ := QuasiCompactCover.exists_isAffineOpen_of_isCompact
    𝒰.toPreZeroHypercover (U := ⊤) (by rw [TopologicalSpace.Opens.coe_top]; exact isCompact_univ)
  have hwe : ∀ i, WeaklyEtale ((V i).ι ≫ 𝒰.f (a i) ≫ U.hom) := by
    intro i
    have h1 : WeaklyEtale (𝒰.f (a i)) := 𝒰.map_prop (a i)
    have h2 : WeaklyEtale U.hom := U.prop
    have h0 : WeaklyEtale (V i).ι := inferInstance
    have comp : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z), WeaklyEtale f → WeaklyEtale g →
        WeaklyEtale (f ≫ g) := by
      intro X Y Z f g _ _; infer_instance
    exact comp _ _ h0 (comp _ _ h1 h2)
  let W : Fin n → S.ProEt := fun i => MorphismProperty.Over.mk ⊤ ((V i).ι ≫ 𝒰.f (a i) ≫ U.hom) (hwe i)
  let h : ∀ i, W i ⟶ U := fun i =>
    MorphismProperty.Over.homMk ((V i).ι ≫ 𝒰.f (a i)) (Category.assoc _ _ _) trivial
  refine ⟨n, W, h, ?_, ?_, ?_⟩
  · intro i
    have hmem : (Sieve.overEquiv _ (Sieve.functorPushforward (Scheme.ProEt.forget S) R)).arrows
        (𝒰.f (a i)) := by
      apply hle
      exact Presieve.ofArrows.mk (a i)
    rw [Sieve.overEquiv_iff] at hmem
    obtain ⟨Z, φ, ψ, hφ, heq⟩ := hmem
    have hl : 𝒰.f (a i) = ψ.left ≫ φ.left := congrArg (fun m => m.left) heq
    have hw : ψ.left ≫ Z.hom = 𝒰.f (a i) ≫ U.hom := Over.w ψ
    let k : W i ⟶ Z := MorphismProperty.Over.homMk ((V i).ι ≫ ψ.left)
      (by exact (Category.assoc _ _ _).trans (congrArg ((V i).ι ≫ ·) hw)) trivial
    have hk : k ≫ φ = h i := by
      apply MorphismProperty.Over.Hom.ext
      show ((V i).ι ≫ ψ.left) ≫ φ.left = (V i).ι ≫ 𝒰.f (a i)
      exact (Category.assoc _ _ _).trans (congrArg ((V i).ι ≫ ·) hl.symm)
    rw [← hk]
    exact R.downward_closed hφ k
  · intro i
    exact (hV i)
  · intro x
    have hx : (show ((Scheme.ProEt.forget S).obj U).left from x) ∈
        ⋃ i, (𝒰.f (a i)) '' ((V i : (𝒰.X (a i)).Opens) : Set (𝒰.X (a i))) := by
      rw [hcov]; trivial
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hx
    obtain ⟨z, hz, hzx⟩ := hi
    obtain ⟨w, rfl⟩ : z ∈ Set.range (V i).ι := by rw [Scheme.Opens.range_ι]; exact hz
    refine ⟨i, w, ?_⟩
    show ((V i).ι ≫ 𝒰.f (a i)) w = x
    rw [Scheme.Hom.comp_apply]
    exact hzx

theorem wc_proet_compact_affine_open_cover : ∀ (S : Scheme.{u}) (V : S.ProEt) (K : Set V.left),
    IsCompact K → ∃ (m : ℕ) (P : Fin m → S.ProEt) (d : ∀ j, P j ⟶ V),
      (∀ j, IsAffine (P j).left) ∧ K ⊆ ⋃ j, Set.range (d j).left :=
by
  intro S V K hK
  choose A hAaff hxA _ using fun x : V.left =>
    exists_isAffineOpen_mem_and_subset (x := x) (U := ⊤)
      (show x ∈ (⊤ : V.left.Opens) from trivial)
  obtain ⟨t, ht⟩ := hK.elim_finite_subcover (fun x => ((A x : V.left.Opens) : Set V.left))
    (fun x => (A x).isOpen) (fun y _ => Set.mem_iUnion.2 ⟨y, hxA y⟩)
  let e := t.equivFin
  refine ⟨t.card, fun j => MorphismProperty.Over.mk ⊤ ((A (e.symm j).1).ι ≫ V.hom) inferInstance,
    fun j => MorphismProperty.Over.homMk (A (e.symm j).1).ι rfl trivial, fun j => hAaff _, ?_⟩
  intro y hy
  obtain ⟨x, hx, hyx⟩ := Set.mem_iUnion₂.1 (ht hy)
  refine Set.mem_iUnion.2 ⟨e ⟨x, hx⟩, ?_⟩
  have hk : (e.symm (e ⟨x, hx⟩)).1 = x := by simp
  show y ∈ Set.range (A (e.symm (e ⟨x, hx⟩)).1).ι
  rw [hk, Scheme.Opens.range_ι]
  exact hyx

theorem wc_proet_closed_push_essImage_of_open_pull_isZero {X Z : Scheme.{u}} (i : Z ⟶ X)
    [IsClosedImmersion i] [IsLocallyNoetherian X] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (V : X.Opens) (hV : (V : Set X) = (Set.range i)ᶜ)
    (D : wcHMPullData i ℓ) (hD : wcHMPullCanonical D)
    (Dj : wcHMPullData V.ι ℓ) (hDj : wcHMPullCanonical Dj)
    (K : SheafOfModules.{u+1} (wcRingSheaf X ℓ)) (hK : Limits.IsZero (Dj.Φ.obj K)) :
    ∃ M : SheafOfModules.{u+1} (wcRingSheaf Z ℓ),
      Nonempty ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).obj M ≅ K) :=
by
  classical
  haveI := D.additive
  haveI := D.presLim
  haveI := D.presColim
  haveI := Dj.additive
  haveI := Dj.presLim
  haveI := Dj.presColim

  have hstar : ∀ N : SheafOfModules.{u+1} (wcRingSheaf X ℓ),
      Limits.IsZero (Dj.Φ.obj N) → Limits.IsZero (D.Φ.obj N) → Limits.IsZero N := by
    intro N hj hi
    have hall := wc_proet_closed_module_zero_of_local_vanishing i
      wc_proet_affine_sieve_finite_jointly_surjective wc_proet_compact_affine_open_cover N
      (wc_proet_open_pull_isZero_vanish_off i ℓ V hV Dj hDj N hj)
      (wc_proet_closed_pull_isZero_local_factor i ℓ wc_lan_flat_unit_eq_zero_factor D hD N hi)
    rw [Limits.IsZero.iff_id_eq_zero]
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro W
    ext x
    rw [hall W.unop x]
    simp only [map_zero]
  haveI : Dj.Φ.PreservesMonomorphisms := preservesMonomorphisms_of_preservesLimitsOfShape _
  haveI : Dj.Φ.PreservesEpimorphisms := preservesEpimorphisms_of_preservesColimitsOfShape _
  haveI : D.Φ.PreservesMonomorphisms := preservesMonomorphisms_of_preservesLimitsOfShape _
  haveI : D.Φ.PreservesEpimorphisms := preservesEpimorphisms_of_preservesColimitsOfShape _
  obtain ⟨hfull, hfaith⟩ := wc_proet_closed_push_modules_full_faithful i ℓ D hD
  haveI := hfull
  haveI := hfaith
  haveI hε : IsIso D.adj.counit := D.adj.counit_isIso_of_R_fully_faithful
  have hΦη : IsIso (D.Φ.map (D.adj.unit.app K)) := by
    have h := D.adj.left_triangle_components K
    have hc : IsIso (D.Φ.map (D.adj.unit.app K) ≫ D.adj.counit.app (D.Φ.obj K)) := by
      rw [h]; infer_instance
    exact IsIso.of_isIso_comp_right _ (D.adj.counit.app (D.Φ.obj K))
  haveI := hΦη
  have hmono : Mono (D.adj.unit.app K) := by
    apply Abelian.mono_of_kernel_ι_eq_zero
    have h1 : Limits.IsZero (Dj.Φ.obj (Limits.kernel (D.adj.unit.app K))) :=
      Limits.IsZero.of_mono (Dj.Φ.map (Limits.kernel.ι (D.adj.unit.app K))) hK
    have h2 : D.Φ.map (Limits.kernel.ι (D.adj.unit.app K)) = 0 := by
      rw [← cancel_mono (D.Φ.map (D.adj.unit.app K)), ← D.Φ.map_comp, Limits.kernel.condition,
        D.Φ.map_zero, Limits.zero_comp]
    have h3 : Limits.IsZero (D.Φ.obj (Limits.kernel (D.adj.unit.app K))) :=
      Limits.IsZero.of_mono_eq_zero _ h2
    exact (hstar _ h1 h3).eq_of_src _ _
  have hepi : Epi (D.adj.unit.app K) := by
    apply Abelian.epi_of_cokernel_π_eq_zero
    have h0 := wc_proet_open_pull_closed_push_isZero i ℓ V hV D Dj hDj (D.Φ.obj K)
    have h1 : Limits.IsZero (Dj.Φ.obj (Limits.cokernel (D.adj.unit.app K))) :=
      Limits.IsZero.of_epi (Dj.Φ.map (Limits.cokernel.π (D.adj.unit.app K))) h0
    have h2 : D.Φ.map (Limits.cokernel.π (D.adj.unit.app K)) = 0 := by
      rw [← cancel_epi (D.Φ.map (D.adj.unit.app K)), ← D.Φ.map_comp, Limits.cokernel.condition,
        D.Φ.map_zero, Limits.comp_zero]
    have h3 : Limits.IsZero (D.Φ.obj (Limits.cokernel (D.adj.unit.app K))) :=
      Limits.IsZero.of_epi_eq_zero _ h2
    exact (hstar _ h1 h3).eq_of_tgt _ _
  haveI := hmono
  haveI := hepi
  haveI := isIso_of_mono_of_epi (D.adj.unit.app K)
  exact ⟨D.Φ.obj K, ⟨(asIso (D.adj.unit.app K)).symm⟩⟩

theorem wc_proet_open_unit_epi_of_injective {X : Scheme.{u}} (V : X.Opens) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (Dj : wcHMPullData V.ι ℓ) (hDj : wcHMPullCanonical Dj)
    (G : SheafOfModules.{u+1} (wcRingSheaf X ℓ)) (hG : Injective G) :
    Epi (Dj.adj.unit.app G) :=
by

  have s4 : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
      [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
      (R : Sheaf J RingCat.{u+1}) (I : SheafOfModules.{u+1} R) [Injective I] {U V : C}
      (m : U ⟶ V) [Mono m], Function.Surjective (((SheafOfModules.toSheaf R).obj I).obj.map m.op).hom := by
    intro C _ J _ _ R I _ U V m _
    let adj := (PresheafOfModules.freeAdjunction.{u+1} R.obj).comp
      (PresheafOfModules.sheafificationAdjunction (𝟙 R.obj))
    have hfree : Mono ((PresheafOfModules.free.{u+1} R.obj).map (uliftYoneda.{u+1}.map m)) := by
      rw [PresheafOfModules.mono_iff_surjective]
      intro X
      have h1 : Mono ((uliftYoneda.{u+1}.map m).app X) :=
        (NatTrans.mono_iff_mono_app _).mp inferInstance X
      have h2 : Function.Injective ((uliftYoneda.{u+1}.map m).app X) := (mono_iff_injective _).mp h1
      rw [PresheafOfModules.free_map_app]
      exact Finsupp.mapDomain_injective h2
    have hL : Mono ((PresheafOfModules.free.{u+1} R.obj ⋙
        PresheafOfModules.sheafification (𝟙 R.obj)).map (uliftYoneda.{u+1}.map m)) := by
      rw [Functor.comp_map]
      exact Functor.map_mono _ _
    intro x
    let b := (adj.homEquiv (uliftYoneda.{u+1}.obj U) I).symm (uliftYonedaEquiv.symm x)
    let c := Injective.factorThru b ((PresheafOfModules.free.{u+1} R.obj ⋙
        PresheafOfModules.sheafification (𝟙 R.obj)).map (uliftYoneda.{u+1}.map m))
    have hc : _ ≫ c = b := Injective.comp_factorThru b _
    have key : uliftYoneda.{u+1}.map m ≫ adj.homEquiv _ I c = uliftYonedaEquiv.symm x := by
      rw [← Adjunction.homEquiv_naturality_left, hc, Equiv.apply_symm_apply]
    refine ⟨uliftYonedaEquiv (adj.homEquiv _ I c), ?_⟩
    have nat := uliftYonedaEquiv_naturality (adj.homEquiv _ I c) m.op
    have e2 : uliftYonedaEquiv (uliftYoneda.{u+1}.map m ≫ adj.homEquiv _ I c) = x := by
      rw [key]; exact Equiv.apply_symm_apply _ _
    exact nat.trans e2

  have s2 : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
      [J.HasSheafCompose (forget AddCommGrpCat.{u+1})] (R : Sheaf J RingCat.{u+1})
      {M N : SheafOfModules.{u+1} R} (f : M ⟶ N),
      (∀ U : Cᵒᵖ, Function.Surjective (f.val.app U).hom) → Epi f := by
    intro C _ J _ R M N f hf
    have hrefl : (SheafOfModules.toSheaf R).ReflectsEpimorphisms :=
      Functor.reflectsEpimorphisms_of_faithful _
    apply Functor.epi_of_epi_map (SheafOfModules.toSheaf R)
    haveI : Sheaf.IsLocallySurjective ((SheafOfModules.toSheaf R).map f) :=
      Presheaf.isLocallySurjective_of_surjective J _ (fun U x => by
        obtain ⟨y, hy⟩ := hf U x
        exact ⟨y, hy⟩)
    exact Sheaf.epi_of_isLocallySurjective _

  have gen : ∀ (Vo : X.ProEt)
      (hj : (wcSliceFunctor X Vo).IsContinuous (Scheme.ProEt.topology Vo.left)
        (Scheme.ProEt.topology X))
      (D : wcHMPullData Vo.hom ℓ), wcHMPullCanonical D → Mono Vo.hom →
      Epi (D.adj.unit.app G) := by
    intro Vo hj D hD hmonoV
    haveI hj' : (wcSliceFunctor X Vo).IsContinuous (Scheme.ProEt.topology ((𝟭 Scheme.{u}).obj Vo.left))
        (Scheme.ProEt.topology ((Functor.fromPUnit X).obj Vo.right)) := hj
    letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) Vo.hom :=
      ⟨fun _ _ => inferInstance⟩
    letI : MorphismProperty.IsStableUnderBaseChangeAlong
        (@WeaklyEtale : MorphismProperty Scheme.{u}) Vo.hom :=
      (fun (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange] =>
        (inferInstance : P.IsStableUnderBaseChangeAlong Vo.hom)) (@WeaklyEtale : MorphismProperty Scheme.{u})
    let adj₀ : wcSliceFunctor X Vo ⊣ wcProEtBC Vo.hom :=
      @MorphismProperty.Over.mapPullbackAdj Scheme.{u} _ @WeaklyEtale ⊤ _ Vo.left X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ Vo.hom _ _ _ Vo.prop trivial
    have hc : ∀ W : X.ProEt, (adj₀.counit.app W).left = Limits.pullback.fst W.hom Vo.hom :=
      fun W => rfl
    have hu : ∀ W' : Vo.left.ProEt, (adj₀.unit.app W').left ≫
        Limits.pullback.fst ((wcSliceFunctor X Vo).obj W').hom Vo.hom = 𝟙 W'.left :=
      fun W' => Limits.pullback.lift_fst _ _ _
    letI := D.cont
    have H1 : Functor.whiskerRight (NatTrans.op adj₀.counit) (wcRingSheaf X ℓ).obj =
        D.φ.hom ≫ (wcProEtBC Vo.hom).op.whiskerLeft
          (𝟙 (wcRingSheaf Vo.left ℓ) : wcRingSheaf Vo.left ℓ ⟶
            ((wcSliceFunctor X Vo).sheafPushforwardContinuous RingCat.{u+1}
              (Scheme.ProEt.topology Vo.left) (Scheme.ProEt.topology X)).obj
              (wcRingSheaf X ℓ)).hom := by
      ext V' s
      obtain ⟨W⟩ := V'
      show s.comp (adj₀.counit.app W).left.base.hom = (D.φ.hom.app (Opposite.op W)).hom s
      rw [hD W s, hc W]
      rfl
    have H2 : (𝟙 (wcRingSheaf Vo.left ℓ) : wcRingSheaf Vo.left ℓ ⟶
            ((wcSliceFunctor X Vo).sheafPushforwardContinuous RingCat.{u+1}
              (Scheme.ProEt.topology Vo.left) (Scheme.ProEt.topology X)).obj
              (wcRingSheaf X ℓ)).hom ≫
        (wcSliceFunctor X Vo).op.whiskerLeft D.φ.hom ≫
        Functor.whiskerRight (NatTrans.op adj₀.unit) (wcRingSheaf Vo.left ℓ).obj =
        𝟙 (wcRingSheaf Vo.left ℓ).obj := by
      ext V' t
      obtain ⟨W'⟩ := V'
      show ((D.φ.hom.app (Opposite.op ((wcSliceFunctor X Vo).obj W'))).hom t).comp
          (adj₀.unit.app W').left.base.hom = t
      refine (congrArg (fun g => ContinuousMap.comp g (adj₀.unit.app W').left.base.hom)
        (hD ((wcSliceFunctor X Vo).obj W') t)).trans ?_
      have key : ∀ t : C(↥W'.left, ULift.{u+1} ℚ_[ℓ]),
          ContinuousMap.comp (ContinuousMap.comp t (Limits.pullback.fst
            ((wcSliceFunctor X Vo).obj W').hom Vo.hom).base.hom)
            (adj₀.unit.app W').left.base.hom = t := by
        intro t
        first
        | (refine ContinuousMap.ext fun x => ?_
           change t _ = t x
           congr 1
           exact congrArg (fun k : W'.left ⟶ W'.left => k.base x) (hu W'))
        | (refine ContinuousMap.ext fun x => ?_
           change t _ = t x
           congr 1
           have e := congrArg (fun k : W'.left ⟶ W'.left => k x) (hu W')
           simpa only [Scheme.Hom.comp_apply, Scheme.Hom.id_apply] using e)
      exact key t

    have hmono : ∀ W : X.ProEt, Mono (adj₀.counit.app W) := by
      intro W
      haveI := hmonoV
      haveI : Mono (Limits.pullback.fst W.hom Vo.hom) := Limits.pullback.fst_of_mono
      constructor
      intro Z g h hgh
      apply MorphismProperty.Over.Hom.ext
      have h1 := congrArg (fun k => k.left) hgh
      change g.left ≫ (adj₀.counit.app W).left = h.left ≫ (adj₀.counit.app W).left at h1
      rw [hc] at h1
      exact (cancel_mono (Limits.pullback.fst W.hom Vo.hom)).1 h1
    let adjP := @SheafOfModules.pushforwardPushforwardAdj _ _ _ _ _ _ _ _ _ _ hj D.cont adj₀ _
      D.φ H1 H2
    have hres : ∀ W : X.ProEt, Function.Surjective
        (((SheafOfModules.toSheaf (wcRingSheaf X ℓ)).obj G).obj.map (adj₀.counit.app W).op).hom := by
      intro W
      haveI := hmono W
      haveI := hG
      exact s4 (Scheme.ProEt.topology X) (wcRingSheaf X ℓ) G (adj₀.counit.app W)
    have hsurj : ∀ U : (X.ProEt)ᵒᵖ, Function.Surjective ((adjP.unit.app G).val.app U).hom := by
      intro U y
      obtain ⟨x, hx⟩ := hres U.unop y
      refine ⟨x, ?_⟩
      exact (SheafOfModules.pushforwardPushforwardAdj_unit_app_val_app adj₀ _ D.φ H1 H2 G U x).trans hx
    have hepiP : Epi (adjP.unit.app G) :=
      s2 (Scheme.ProEt.topology X) (wcRingSheaf X ℓ) (adjP.unit.app G) hsurj
    have hst := Adjunction.unit_leftAdjointUniq_hom_app D.adj adjP G
    rw [← hst] at hepiP
    have cancel : ∀ {A B C : SheafOfModules.{u+1} (wcRingSheaf X ℓ)} (f : A ⟶ B) (g : B ⟶ C)
        [IsIso g], Epi (f ≫ g) → Epi f := by
      intro A B C f g _ h
      have hf : f = (f ≫ g) ≫ inv g := by simp
      rw [hf]
      exact epi_comp _ _
    exact cancel _ _ hepiP

  have slice_over_cont : ∀ (S : Scheme.{u}) (U : S.ProEt),
      (wcSliceToOver S U).IsContinuous (Scheme.ProEt.topology U.left)
        ((Scheme.ProEt.topology S).over U) := by
    intro S U
    have hmem : ∀ (T : Scheme.{u}) (V : T.ProEt) (R : Sieve V),
        R ∈ Scheme.ProEt.topology T V ↔
          Sieve.functorPushforward (Scheme.ProEt.forget T ⋙ Over.forget T) R ∈
            Scheme.proetaleTopology V.left := by
      intro T V R
      letI := MorphismProperty.IsMultiplicative.toIsStableUnderComposition (W := @WeaklyEtale)
      have hT : Scheme.ProEt.topology T =
          (Scheme.ProEt.forget T).restrictedTopology (Scheme.proetaleTopology.over T) :=
        MorphismProperty.toGrothendieck_comap_forget_eq_restrictedTopology (S := T)
          (P := @WeaklyEtale) Scheme.proetalePrecoverage
          Scheme.proetalePrecoverage_le_precoverage_weaklyEtale
      rw [hT, Functor.mem_restrictedTopology_iff, GrothendieckTopology.mem_over_iff,
        Sieve.overEquiv_apply, ← Sieve.functorPushforward_comp]
      rfl
    let εapp : ∀ V : Over U, (wcOverToSlice S U ⋙ wcSliceToOver S U).obj V ≅ V := fun V =>
      Over.isoMk (MorphismProperty.Over.isoMk (Iso.refl V.left.left)
          ((Category.id_comp _).trans (MorphismProperty.Over.w V.hom).symm))
        (MorphismProperty.Over.Hom.ext (Category.id_comp V.hom.left))
    let ε : wcOverToSlice S U ⋙ wcSliceToOver S U ≅ 𝟭 (Over U) :=
      NatIso.ofComponents εapp (fun {V V'} g => by
        apply Over.OverMorphism.ext
        apply MorphismProperty.Over.Hom.ext
        exact (Category.comp_id g.left.left).trans (Category.id_comp g.left.left).symm)
    have hmemD : ∀ (V : Over U) (R : Sieve V), R ∈ (Scheme.ProEt.topology S).over U V ↔
        Sieve.functorPushforward (Over.forget U ⋙ Scheme.ProEt.forget S ⋙ Over.forget S) R ∈
          Scheme.proetaleTopology V.left.left := by
      intro V R
      rw [GrothendieckTopology.mem_over_iff, Sieve.overEquiv_apply, hmem S V.left,
        ← Sieve.functorPushforward_comp]
    have hFc : (wcSliceToOver S U).IsCocontinuous (Scheme.ProEt.topology U.left)
        ((Scheme.ProEt.topology S).over U) := by
      constructor
      intro W T hT
      rw [hmem U.left W]
      rw [hmemD] at hT
      refine GrothendieckTopology.superset_covering _ ?_ hT
      rintro Z f ⟨V', t, a, ht, rfl⟩
      refine ⟨(wcOverToSlice S U).obj V', (wcOverToSlice S U).map t, a, ?_, rfl⟩
      show T.arrows ((wcSliceToOver S U).map ((wcOverToSlice S U).map t))
      have hft : (wcSliceToOver S U).map ((wcOverToSlice S U).map t) = (εapp V').hom ≫ t := by
        apply Over.OverMorphism.ext
        apply MorphismProperty.Over.Hom.ext
        exact (Category.id_comp t.left.left).symm
      exact (congrArg (fun g => T.arrows g) hft).mpr (T.downward_closed ht _)
    have hGc : (wcOverToSlice S U).IsCocontinuous ((Scheme.ProEt.topology S).over U)
        (Scheme.ProEt.topology U.left) := by
      constructor
      intro V T hT
      rw [hmemD]
      rw [hmem U.left] at hT
      refine GrothendieckTopology.superset_covering _ ?_ hT
      rintro Z f ⟨W', t, a, ht, rfl⟩
      refine ⟨(wcSliceToOver S U).obj W', (wcSliceToOver S U).map t ≫ (εapp V).hom, a, ?_, ?_⟩
      · show T.arrows ((wcOverToSlice S U).map ((wcSliceToOver S U).map t ≫ (εapp V).hom))
        have hgt : (wcOverToSlice S U).map ((wcSliceToOver S U).map t ≫ (εapp V).hom) = t := by
          apply MorphismProperty.Over.Hom.ext
          exact Category.comp_id t.left
        exact (congrArg (fun g => T.arrows g) hgt).mpr ht
      · exact (congrArg (a ≫ ·) (Category.comp_id t.left)).symm
    let eqv : U.left.ProEt ≌ Over U :=
      Equivalence.mk' (wcSliceToOver S U) (wcOverToSlice S U) (Iso.refl _) ε (fun W => by
        apply Over.OverMorphism.ext
        apply MorphismProperty.Over.Hom.ext
        exact Category.comp_id (𝟙 W.left))
    haveI : eqv.functor.IsCocontinuous (Scheme.ProEt.topology U.left)
        ((Scheme.ProEt.topology S).over U) := hFc
    haveI : eqv.inverse.IsCocontinuous ((Scheme.ProEt.topology S).over U)
        (Scheme.ProEt.topology U.left) := hGc
    haveI := Equivalence.isDenseSubsite_functor_of_isCocontinuous (Scheme.ProEt.topology U.left)
      ((Scheme.ProEt.topology S).over U) eqv
    haveI := Equivalence.isDenseSubsite_inverse_of_isCocontinuous (Scheme.ProEt.topology U.left)
      ((Scheme.ProEt.topology S).over U) eqv
    exact (inferInstance : eqv.functor.IsContinuous (Scheme.ProEt.topology U.left)
      ((Scheme.ProEt.topology S).over U))
  haveI hσ : (wcSliceToOver X (Scheme.ProEt.mk V.ι)).IsContinuous
      (Scheme.ProEt.topology (Scheme.ProEt.mk V.ι).left)
      ((Scheme.ProEt.topology X).over (Scheme.ProEt.mk V.ι)) :=
    slice_over_cont X (Scheme.ProEt.mk V.ι)
  have hj : (wcSliceFunctor X (Scheme.ProEt.mk V.ι)).IsContinuous
      (Scheme.ProEt.topology (Scheme.ProEt.mk V.ι).left) (Scheme.ProEt.topology X) :=
    Functor.isContinuous_comp (wcSliceToOver X (Scheme.ProEt.mk V.ι))
      (Over.forget (Scheme.ProEt.mk V.ι))
      (Scheme.ProEt.topology (Scheme.ProEt.mk V.ι).left)
      ((Scheme.ProEt.topology X).over (Scheme.ProEt.mk V.ι)) (Scheme.ProEt.topology X)
  exact gen (Scheme.ProEt.mk V.ι) hj Dj hDj (show Mono V.ι from inferInstance)

theorem wc_proet_open_unit_epi_of_isClosed {X : Scheme.{u}} (V : X.Opens) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (Dj : wcHMPullData V.ι ℓ) (hDj : wcHMPullCanonical Dj)
    (G : SheafOfModules.{u+1} (wcRingSheaf X ℓ)) (hcl : IsClosed (V : Set X)) :
    Epi (Dj.adj.unit.app G) :=
by
  classical

  have hfam : ∀ (S : Scheme.{u}) (Q : S.ProEt) (n : ℕ) (W : Fin n → S.ProEt) (h : ∀ k, W k ⟶ Q),
      (∀ k, IsOpenMap ⇑(h k).left) → (∀ x : ↥Q.left, ∃ k, x ∈ Set.range ⇑(h k).left) →
      Sieve.generate (Presieve.ofArrows W h) ∈ Scheme.ProEt.topology S Q := by
    intro S Q n W h hO hJ
    have hs : ∀ x : Q.left, ∃ j y, (h j).left y = x := by
      intro x; obtain ⟨j, y, hy⟩ := hJ x; exact ⟨j, y, hy⟩
    have hw : ∀ i, WeaklyEtale (h i).left := fun i => by
      have h1 : WeaklyEtale ((h i).left ≫ Q.hom) := by
        rw [MorphismProperty.Over.w (h i)]; exact (W i).prop
      exact @WeaklyEtale.of_comp _ _ _ (h i).left Q.hom h1 Q.prop
    have H : Presieve.ofArrows (fun i => (W i).left) (fun i => (h i).left) ∈
        Scheme.proetalePrecoverage.coverings Q.left :=
      ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr (QuasiCompactCover.of_isOpenMap
        (𝒰 := Scheme.Cover.mkOfCovers (P := ⊤) (Fin n) (fun i => (W i).left) (fun i => (h i).left)
          hs (fun _ => trivial)) (fun i => hO i)),
        (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr
          ⟨fun x => by obtain ⟨j, y, hy⟩ := hs x; exact ⟨j, y, hy⟩, hw⟩⟩
    exact Precoverage.generate_mem_toGrothendieck
      (Precoverage.mem_comap_iff.mpr (by rw [Presieve.map_ofArrows]; exact H))

  have hempty : ∀ (F : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}) (T : X.ProEt),
      IsEmpty T.left → Subsingleton ↑(F.obj.obj (Opposite.op T)) := by
    intro F T hT
    have hmem := hfam X T 0 (fun k => k.elim0) (fun k => k.elim0) (fun k => k.elim0)
      (fun x => isEmptyElim x)
    have hbot : (⊥ : Sieve T) ∈ Scheme.ProEt.topology X T := by
      refine GrothendieckTopology.superset_covering _ ?_ hmem
      rintro Z g ⟨Y, g', k, hk, -⟩
      rcases hk with ⟨i⟩
      exact i.elim0
    exact AddCommGrpCat.subsingleton_of_isZero (Sheaf.isTerminalOfBotCover F T hbot).isZero

  have hrestr : ∀ (F : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}) {U₁ U : X.ProEt}
      (c : U₁ ⟶ U), IsOpenImmersion c.left → IsClosed (Set.range c.left) →
      Function.Surjective (F.obj.map c.op).hom := by
    intro F U₁ U c hc hZ s
    haveI := hc
    let W : U.left.Opens := ⟨(Set.range c.left)ᶜ, hZ.isOpen_compl⟩
    haveI : WeaklyEtale U.hom := U.prop
    let U₂ : X.ProEt := Scheme.ProEt.mk (W.ι ≫ U.hom)
    let c₂ : U₂ ⟶ U := MorphismProperty.Over.homMk W.ι rfl trivial
    let Yf : Fin 2 → X.ProEt := Fin.cases U₁ (fun _ => U₂)
    let π : ∀ k, Yf k ⟶ U := Fin.cases (motive := fun k => Yf k ⟶ U) c (fun _ => c₂)
    let P := F.obj ⋙ forget AddCommGrpCat.{u+1}
    have hP : Presheaf.IsSheaf (Scheme.ProEt.topology X) P :=
      (Presheaf.isSheaf_iff_isSheaf_forget (Scheme.ProEt.topology X) F.obj
        (forget AddCommGrpCat.{u+1})).1 F.cond
    have hopen : ∀ k, IsOpenMap ⇑(π k).left := by
      intro k
      refine Fin.cases ?_ (fun _ => ?_) k
      · show IsOpenMap ⇑c.left
        exact c.left.isOpenEmbedding.isOpenMap
      · show IsOpenMap ⇑W.ι
        exact W.ι.isOpenEmbedding.isOpenMap
    have hsurj : ∀ y : U.left, ∃ k, y ∈ Set.range ⇑(π k).left := by
      intro y
      by_cases hy : y ∈ Set.range c.left
      · refine ⟨0, ?_⟩
        show y ∈ Set.range ⇑c.left
        exact hy
      · refine ⟨1, ?_⟩
        show y ∈ Set.range ⇑W.ι
        exact ⟨(⟨y, hy⟩ : (W : Scheme.{u})), Scheme.Opens.ι_apply W ⟨y, hy⟩⟩
    have hS := hfam X U 2 Yf π hopen hsurj
    have hSF : Presieve.IsSheafFor P (Presieve.ofArrows Yf π) :=
      (Presieve.isSheafFor_iff_generate _).2 (hP.isSheafFor _ hS)
    let x : ∀ k, P.obj (Opposite.op (Yf k)) :=
      Fin.cases (motive := fun k => P.obj (Opposite.op (Yf k))) s
        (fun _ => (0 : F.obj.obj (Opposite.op U₂)))
    have hmixed : ∀ (Z : X.ProEt) (g₁ : Z ⟶ U₂) (g₂ : Z ⟶ U₁),
        g₁.left ≫ W.ι = g₂.left ≫ c.left → IsEmpty Z.left := by
      intro Z g₁ g₂ h'
      refine ⟨fun z => ?_⟩
      have hz : W.ι (g₁.left z) = c.left (g₂.left z) :=
        (Scheme.Hom.comp_apply g₁.left W.ι z).symm.trans
          ((congrArg (fun k => k z) h').trans (Scheme.Hom.comp_apply g₂.left c.left z))
      have hm : W.ι (g₁.left z) ∈ Set.range W.ι := ⟨_, rfl⟩
      rw [Scheme.Opens.range_ι] at hm
      exact absurd (⟨g₂.left z, hz.symm⟩ : W.ι (g₁.left z) ∈ Set.range c.left) hm
    have h2 : ∀ k : Fin 2, k = 0 ∨ k = 1 := by decide
    have hx : Presieve.Arrows.Compatible P π x := by
      intro i j
      rcases h2 i with rfl | rfl <;> rcases h2 j with rfl | rfl
      · intro Z gi gj hij
        have h' : gi.left ≫ c.left = gj.left ≫ c.left := congrArg (fun k => k.left) hij
        have hg : gi = gj := MorphismProperty.Over.Hom.ext ((cancel_mono c.left).1 h')
        rw [hg]
      · intro Z gi gj hij
        have hZ : IsEmpty Z.left := hmixed Z gj gi (congrArg (fun k => k.left) hij).symm
        exact @Subsingleton.elim _ (hempty F Z hZ) _ _
      · intro Z gi gj hij
        have hZ : IsEmpty Z.left := hmixed Z gi gj (congrArg (fun k => k.left) hij)
        exact @Subsingleton.elim _ (hempty F Z hZ) _ _
      · intro Z gi gj hij
        show (F.obj.map gi.op).hom 0 = (F.obj.map gj.op).hom 0
        rw [map_zero, map_zero]
    obtain ⟨t, ht, -⟩ := (Presieve.isSheafFor_arrows_iff P π).1 hSF x hx
    exact ⟨t, ht 0⟩

  have gen : ∀ (T : X.ProEt) (E : wcHMPullData T.hom ℓ) (hE : wcHMPullCanonical E)
      [hF : (wcSliceFunctor X T).IsContinuous (Scheme.ProEt.topology T.left)
        (Scheme.ProEt.topology X)]
      [hT : IsOpenImmersion T.hom], IsClosed (Set.range T.hom) → Epi (E.adj.unit.app G) := by
    intro T E hE hF hT hTc
    letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) T.hom :=
      ⟨fun _ _ => inferInstance⟩
    letI : MorphismProperty.IsStableUnderBaseChangeAlong
        (@WeaklyEtale : MorphismProperty Scheme.{u}) T.hom :=
      (fun (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange] =>
        (inferInstance : P.IsStableUnderBaseChangeAlong T.hom)) (@WeaklyEtale : MorphismProperty Scheme.{u})
    let adj₀ : wcSliceFunctor X T ⊣ wcProEtBC T.hom :=
      @MorphismProperty.Over.mapPullbackAdj Scheme.{u} _ @WeaklyEtale ⊤ _ T.left X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ T.hom _ _ _ T.prop trivial
    have hc : ∀ W : X.ProEt, (adj₀.counit.app W).left = Limits.pullback.fst W.hom T.hom :=
      fun W => rfl
    have hu : ∀ W' : T.left.ProEt, (adj₀.unit.app W').left ≫
        Limits.pullback.fst ((wcSliceFunctor X T).obj W').hom T.hom = 𝟙 W'.left :=
      fun W' => Limits.pullback.lift_fst _ _ _
    letI := E.cont
    have H1 : Functor.whiskerRight (NatTrans.op adj₀.counit) (wcRingSheaf X ℓ).obj =
        E.φ.hom ≫ (wcProEtBC T.hom).op.whiskerLeft
          (𝟙 (wcRingSheaf T.left ℓ) : wcRingSheaf T.left ℓ ⟶
            ((wcSliceFunctor X T).sheafPushforwardContinuous RingCat.{u+1}
              (Scheme.ProEt.topology T.left) (Scheme.ProEt.topology X)).obj
              (wcRingSheaf X ℓ)).hom := by
      ext V' s
      obtain ⟨W⟩ := V'
      show s.comp (adj₀.counit.app W).left.base.hom = (E.φ.hom.app (Opposite.op W)).hom s
      rw [hE W s, hc W]
      rfl
    have H2 : (𝟙 (wcRingSheaf T.left ℓ) : wcRingSheaf T.left ℓ ⟶
            ((wcSliceFunctor X T).sheafPushforwardContinuous RingCat.{u+1}
              (Scheme.ProEt.topology T.left) (Scheme.ProEt.topology X)).obj
              (wcRingSheaf X ℓ)).hom ≫
        (wcSliceFunctor X T).op.whiskerLeft E.φ.hom ≫
        Functor.whiskerRight (NatTrans.op adj₀.unit) (wcRingSheaf T.left ℓ).obj =
        𝟙 (wcRingSheaf T.left ℓ).obj := by
      ext V' t
      obtain ⟨W'⟩ := V'
      show ((E.φ.hom.app (Opposite.op ((wcSliceFunctor X T).obj W'))).hom t).comp
          (adj₀.unit.app W').left.base.hom = t
      refine (congrArg (fun g => ContinuousMap.comp g (adj₀.unit.app W').left.base.hom)
        (hE ((wcSliceFunctor X T).obj W') t)).trans ?_
      have key : ∀ t : C(↥W'.left, ULift.{u+1} ℚ_[ℓ]),
          ContinuousMap.comp (ContinuousMap.comp t (Limits.pullback.fst
            ((wcSliceFunctor X T).obj W').hom T.hom).base.hom)
            (adj₀.unit.app W').left.base.hom = t := by
        intro t
        first
        | (rw [ContinuousMap.comp_assoc, ← TopCat.hom_comp, ← Scheme.Hom.comp_base, hu W',
            Scheme.Hom.id_base, TopCat.hom_id, ContinuousMap.comp_id])
        | (refine ContinuousMap.ext fun x => ?_
           change t _ = t x
           congr 1
           exact congrArg (fun k : W'.left ⟶ W'.left => k.base x) (hu W'))
        | (refine ContinuousMap.ext fun x => ?_
           change t _ = t x
           congr 1
           have e := congrArg (fun k : W'.left ⟶ W'.left => k x) (hu W')
           simpa only [Scheme.Hom.comp_apply, Scheme.Hom.id_apply] using e)
      exact key t
    let A2 := @SheafOfModules.pushforwardPushforwardAdj _ _ _ _ _ _ _ _ _ _ hF E.cont adj₀ _ E.φ H1 H2
    have hA2 : Epi (A2.unit.app G) := by
      haveI := Functor.reflectsEpimorphisms_of_faithful
        (SheafOfModules.toSheaf (wcRingSheaf X ℓ))
      apply Functor.epi_of_epi_map (SheafOfModules.toSheaf (wcRingSheaf X ℓ))
      haveI : Sheaf.IsLocallySurjective
