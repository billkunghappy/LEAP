  haveI : QuasiCompact t := MorphismProperty.of_isPullback (P := @QuasiCompact) hP inferInstance
  haveI : QuasiSeparated t :=
    MorphismProperty.of_isPullback (P := @QuasiSeparated) hP inferInstance
  have hPc : CompactSpace Pq := QuasiCompact.compactSpace_of_compactSpace t
  have hPs : QuasiSeparatedSpace Pq := quasiSeparatedSpace_of_quasiSeparated t

  have g4 : ∀ y : wcEtZModExt Pq ℓ k, y = 0 := by
