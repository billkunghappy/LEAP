    have O : IsPullback (((D₀ ⋙ wcEtBaseChange V.ι).map t').left ≫
        Limits.pullback.snd (D₀.obj l').hom V.ι) (Limits.pullback.fst (D₀.obj l).hom V.ι) V.ι
        ((D₀.map t').left ≫ (D₀.obj l').hom) := by
      rw [M2 t', MorphismProperty.Over.w (D₀.map t')]
