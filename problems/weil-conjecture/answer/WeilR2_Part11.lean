           simp only [MorphismProperty.Over.pullback_obj_left])
    have hYC : CompactSpace
        ((wcProEtBC (OU.ι ≫ (AffineSpace (ULift.{u} (Fin d)) U ↘ U))).obj W').left := by
      rw [hYeq]
      exact QuasiCompact.compactSpace_of_compactSpace
        (Limits.pullback.fst W'.hom (OU.ι ≫ (AffineSpace (ULift.{u} (Fin d)) U ↘ U)))
    have hYS : IsSeparated (Limits.terminal.from
        ((wcProEtBC (OU.ι ≫ (AffineSpace (ULift.{u} (Fin d)) U ↘ U))).obj W').left) := by
      rw [hYeq]
      have e : Limits.terminal.from
          (Limits.pullback W'.hom (OU.ι ≫ (AffineSpace (ULift.{u} (Fin d)) U ↘ U))) =
          Limits.pullback.fst W'.hom (OU.ι ≫ (AffineSpace (ULift.{u} (Fin d)) U ↘ U)) ≫
            Limits.terminal.from ((𝟭 Scheme.{u}).obj W'.left) := Limits.terminal.hom_ext _ _
      rw [e]
      infer_instance
    generalize ((wcProEtBC (OU.ι ≫ (AffineSpace (ULift.{u} (Fin d)) U ↘ U))).obj W').left = Y
      at h4 hYC hYS ⊢
    haveI := hYC
    haveI := hYS
    haveI : QuasiSeparatedSpace Y := (quasiSeparatedSpace_iff_quasiSeparated Y).2 inferInstance
    have h2 : ∀ k : ℕ, ∀ y : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
        (wcZModSheaf Y (ℓ ^ (k + 1))) (j + 1), y = 0 :=
      fun k => hN4 Y (ℓ ^ (k + 1)) (h4 k)
    have h1 := wc_proet_int_ext_vanish_of_zmod_deg Y ℓ (Scheme.ProEt.mk (𝟙 Y)) j h2
    exact wc_hm_vanish_of_int_ext_vanish Y ℓ j h1

  refine (fun key => ?_) (pushforward_homology_local_basis
    (wcProEtBC (OU.ι ≫ (AffineSpace (ULift.{u} (Fin d)) U ↘ U)))
    (wcRingSheaf U ℓ) (wcRingSheaf OU.toScheme ℓ)
    Dg.φ I.cocomplex (j + 1) 0 (fun a => a.elim0) (fun a => a.elim0) ?_ ?_)
  · obtain ⟨ι, hinj, hloc⟩ := key
    obtain ⟨ρ, -, hsum⟩ := sheafOfModules_split_of_local_basis _ _ 0 ι hinj hloc
    rw [Fin.sum_univ_zero] at hsum
    exact (Limits.IsZero.iff_id_eq_zero _).2 hsum.symm
  ·
    intro W s hs
    have hcov := wc_proet_cover_of_affine_local
      (fun Δ : Scheme.{u} => IsClosed {x : Δ | IsClosed ({x} : Set Δ)} ∧
        (∀ x : Δ, ∃! y : Δ, IsClosed ({y} : Set Δ) ∧ x ⤳ y) ∧
        ExtremallyDisconnected {x : Δ | IsClosed ({x} : Set Δ)} ∧
        (∀ x : Δ, IsClosed ({x} : Set Δ) →
          HenselianLocalRing (Δ.presheaf.stalk x) ∧ IsSepClosed (Δ.residueField x)))
      (fun V hV => by
        obtain ⟨Δ, δ, h1, h2, h3, h4, h5, h6, h7⟩ := wc_exists_wcontractible_cover V hV
        exact ⟨Δ, δ, h1, h2, h3, h4, h5, h6, h7⟩) W
    refine (Scheme.ProEt.topology U).superset_covering ((Sieve.generate_le_iff _ _).2 ?_) hcov
    intro W' g hg
    obtain ⟨hA, hQW⟩ := hg
    refine ⟨W', 𝟙 _, g, ?_, Category.id_comp g⟩
    have hds' : ((I.cocomplex.d (j + 1) (j + 1 + 1)).val.app
        (Opposite.op ((wcProEtBC (OU.ι ≫ (AffineSpace (ULift.{u} (Fin d)) U ↘ U))).obj W'))).hom
        (((I.cocomplex.X (j + 1)).val.map
          ((wcProEtBC (OU.ι ≫ (AffineSpace (ULift.{u} (Fin d)) U ↘ U))).map g).op).hom s) = 0 := by
      erw [PresheafOfModules.naturality_apply, hs, map_zero]
      all_goals rfl
    obtain ⟨P, ev, hnat, hevadd⟩ := sheafOfModules_free_yoneda
      (Scheme.ProEt.topology OU.toScheme)
      (wcRingSheaf OU.toScheme ℓ)
      ((wcProEtBC (OU.ι ≫ (AffineSpace (ULift.{u} (Fin d)) U ↘ U))).obj W')
    have hev0 : ∀ M, ev M 0 = 0 := fun M => by
      have h := hevadd M 0 0
      rw [add_zero] at h
      exact add_left_cancel (h.symm.trans (add_zero _).symm)
    obtain ⟨fP, hfPdef⟩ : ∃ fP : P ⟶ I.cocomplex.X (j + 1), ev _ fP =
        ((I.cocomplex.X (j + 1)).val.map
          ((wcProEtBC (OU.ι ≫ (AffineSpace (ULift.{u} (Fin d)) U ↘ U))).map g).op).hom s :=
      ⟨(ev _).symm _, Equiv.apply_symm_apply _ _⟩
    have hfP : fP ≫ I.cocomplex.d (j + 1) (j + 1 + 1) = 0 := by
      apply (ev _).injective
      rw [hnat, hfPdef, hds', hev0]
    obtain ⟨DV, hDV⟩ := wc_hm_pull_data_exists
      ((wcProEtBC (OU.ι ≫ (AffineSpace (ULift.{u} (Fin d)) U ↘ U))).obj W').hom ℓ
    obtain ⟨Θ, -⟩ := wc_proet_free_slice_module_ext OU.toScheme ℓ
      ((wcProEtBC (OU.ι ≫ (AffineSpace (ULift.{u} (Fin d)) U ↘ U))).obj W') P ev hnat hevadd
      DV hDV (j + 1)
    have hext0 : I.extMk fP (j + 1 + 1) rfl hfP = 0 := by
      apply Θ.injective
      rw [map_zero]
      exact hvan W' ⟨hA, hQW⟩ _
    obtain ⟨κ, hκ⟩ := injectiveResolution_coboundary_of_extMk_eq_sum I (j + 1) 0 fP hfP
      (fun a => a.elim0) (fun a => a.elim0) (by rw [hext0]; simp)
    refine ⟨fun a => a.elim0, ev _ κ, ?_⟩
    rw [Fin.sum_univ_zero, zero_add, ← hnat, ← hfPdef, hκ, Fin.sum_univ_zero, zero_add]
  ·
    intro W c y _
    refine (Scheme.ProEt.topology U).superset_covering ?_ ((Scheme.ProEt.topology U).top_mem W)
    intro W' g _
    exact ⟨W', 𝟙 _, g, fun a => a.elim0, Category.id_comp g⟩

theorem sheafOfModules_pushforward_homology_iso_of_local_gen_ind {C D : Type (u+1)} [Category.{u} C]
    [Category.{u} D] {J : GrothendieckTopology C} {K : GrothendieckTopology D} (G : C ⥤ D)
    [G.IsContinuous J K]
    [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
    [HasSheafify K AddCommGrpCat.{u+1}] [K.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
    (S : Sheaf J RingCat.{u+1}) (R : Sheaf K RingCat.{u+1})
    (φ : S ⟶ (G.sheafPushforwardContinuous RingCat.{u+1} J K).obj R)
    [(SheafOfModules.pushforward.{u+1} φ).Additive]
    (Kc : CochainComplex (SheafOfModules.{u+1} R) ℕ) (q : ℕ)
    (f : SheafOfModules.unit R ⟶ Kc.X q) (hcyc : f ≫ Kc.d q (q + 1) = 0)
    (hg : (SheafOfModules.unitToPushforwardObjUnit φ ≫ (SheafOfModules.pushforward.{u+1} φ).map f) ≫
      (((SheafOfModules.pushforward.{u+1} φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj Kc).d q
        (q + 1) = 0)
    (hgen : ∀ (W : C) (s : (Kc.X q).val.obj (Opposite.op (G.obj W))),
        ((Kc.d q (q + 1)).val.app (Opposite.op (G.obj W))).hom s = 0 →
        Sieve.generate (fun (W' : C) (g : W' ⟶ W) => ∃ (c : S.obj.obj (Opposite.op W'))
            (y : (Kc.X ((ComplexShape.up ℕ).prev q)).val.obj (Opposite.op (G.obj W'))),
            ((Kc.X q).val.map (G.map g).op).hom s =
              (f.val.app (Opposite.op (G.obj W'))).hom ((φ.hom.app (Opposite.op W')).hom c) +
              ((Kc.d ((ComplexShape.up ℕ).prev q) q).val.app (Opposite.op (G.obj W'))).hom y) ∈ J W)
    (hind : ∀ (W : C) (c : S.obj.obj (Opposite.op W))
        (y : (Kc.X ((ComplexShape.up ℕ).prev q)).val.obj (Opposite.op (G.obj W))),
        (f.val.app (Opposite.op (G.obj W))).hom ((φ.hom.app (Opposite.op W)).hom c) =
          ((Kc.d ((ComplexShape.up ℕ).prev q) q).val.app (Opposite.op (G.obj W))).hom y →
        Sieve.generate (fun (W' : C) (g : W' ⟶ W) => (S.obj.map g.op).hom c = 0) ∈ J W) :
    IsIso ((((SheafOfModules.pushforward.{u+1} φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj
        Kc).liftCycles
        (SheafOfModules.unitToPushforwardObjUnit φ ≫ (SheafOfModules.pushforward.{u+1} φ).map f)
        (q + 1) (by simp) hg ≫
      (((SheafOfModules.pushforward.{u+1} φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj
        Kc).homologyπ q) :=
by
  classical

  have hcomp : ∀ {M N L : SheafOfModules.{u+1} S} (p : M ⟶ N) (p' : N ⟶ L) (V : Cᵒᵖ)
      (x : M.val.obj V), ((p ≫ p').val.app V).hom x = (p'.val.app V).hom ((p.val.app V).hom x) :=
    fun _ _ _ _ => rfl
  have hnat : ∀ {M N : SheafOfModules.{u+1} S} (p : M ⟶ N) {W W' : C} (g : W' ⟶ W)
      (x : M.val.obj (Opposite.op W)),
      (p.val.app (Opposite.op W')).hom ((M.val.map g.op).hom x) =
        (N.val.map g.op).hom ((p.val.app (Opposite.op W)).hom x) :=
    fun p _ _ g x => PresheafOfModules.naturality_apply p.val g.op x
  have hMmap : ∀ {M : SheafOfModules.{u+1} S} {W Y Z : C} (h₀ : Y ⟶ W) (g' : Z ⟶ Y)
      (x : M.val.obj (Opposite.op W)),
      (M.val.map (g' ≫ h₀).op).hom x = (M.val.map g'.op).hom ((M.val.map h₀.op).hom x) := by
    intro M W Y Z h₀ g' x
    rw [op_comp, PresheafOfModules.map_comp]
    rfl
  have hSmap : ∀ {W Y Z : C} (h₀ : Y ⟶ W) (g' : Z ⟶ Y) (x : S.obj.obj (Opposite.op W)),
      (S.obj.map (g' ≫ h₀).op).hom x = (S.obj.map g'.op).hom ((S.obj.map h₀.op).hom x) := by
    intro W Y Z h₀ g' x
    rw [op_comp, Functor.map_comp]
    rfl

  have hmono : ∀ {M N : SheafOfModules.{u+1} S} (p : M ⟶ N) [Mono p] (W : C),
      Function.Injective (p.val.app (Opposite.op W)).hom := by
    intro M N p _ W
    have h1 : Mono ((SheafOfModules.forget.{u+1} S ⋙
        PresheafOfModules.evaluation.{u+1} S.obj (Opposite.op W)).map p) := Functor.map_mono _ p
    exact (ModuleCat.mono_iff_injective _).1 h1

  have hTS : Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} S) := by
    constructor
    intro I _ _
    constructor
    intro K
    let adj := PresheafOfModules.sheafificationAdjunction (J := J) (𝟙 S.obj)
    haveI : IsIso adj.counit := inferInstance
    haveI hP : Limits.PreservesColimitsOfShape I
        (PresheafOfModules.sheafification (J := J) (𝟙 S.obj) ⋙ SheafOfModules.toSheaf.{u+1} S) :=
      Limits.preservesColimitsOfShape_of_natIso
        (PresheafOfModules.sheafificationCompToSheaf (J := J) (𝟙 S.obj)).symm
    let K₀ := K ⋙ (SheafOfModules.forget S ⋙ PresheafOfModules.restrictScalars (𝟙 S.obj))
    let c₀ := Limits.colimit.cocone K₀
    let h₀ : Limits.IsColimit c₀ := Limits.colimit.isColimit K₀
    have ht : Limits.IsColimit
        ((PresheafOfModules.sheafification (J := J) (𝟙 S.obj)).mapCocone c₀) :=
      Limits.isColimitOfPreserves _ h₀
    have ht' : Limits.IsColimit ((SheafOfModules.toSheaf.{u+1} S).mapCocone
        ((PresheafOfModules.sheafification (J := J) (𝟙 S.obj)).mapCocone c₀)) :=
      Limits.IsColimit.ofIsoColimit
        (Limits.isColimitOfPreserves
          (PresheafOfModules.sheafification (J := J) (𝟙 S.obj) ⋙ SheafOfModules.toSheaf.{u+1} S) h₀)
        (Functor.mapCoconeMapCocone c₀).symm
    haveI : Limits.PreservesColimit (K₀ ⋙ PresheafOfModules.sheafification (J := J) (𝟙 S.obj))
        (SheafOfModules.toSheaf.{u+1} S) :=
      Limits.preservesColimit_of_preserves_colimit_cocone ht ht'
    let e : K₀ ⋙ PresheafOfModules.sheafification (J := J) (𝟙 S.obj) ≅ K :=
      Functor.associator _ _ _ ≪≫ Functor.isoWhiskerLeft K (asIso adj.counit) ≪≫
        Functor.rightUnitor K
    exact Limits.preservesColimit_of_iso_diagram _ e

  have hepi : ∀ {M N : SheafOfModules.{u+1} S} (p : M ⟶ N) [Epi p] (W : C)
      (s : N.val.obj (Opposite.op W)),
      Sieve.generate (fun (W' : C) (g : W' ⟶ W) => ∃ t : M.val.obj (Opposite.op W'),
        (p.val.app (Opposite.op W')).hom t = (N.val.map g.op).hom s) ∈ J W := by
    intro M N p _ W s
    have := hTS
    have h1 : Epi ((SheafOfModules.toSheaf.{u+1} S).map p) := inferInstance
    have h2 := (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1}
      ((SheafOfModules.toSheaf.{u+1} S).map p)).2 h1
    have : Presheaf.IsLocallySurjective J ((SheafOfModules.toSheaf.{u+1} S).map p).hom := h2
    have h3 := Presheaf.imageSieve_mem J ((SheafOfModules.toSheaf.{u+1} S).map p).hom
      (U := Opposite.op W) s
    refine J.superset_covering ?_ h3
    intro W' g hg
    obtain ⟨t, ht⟩ := hg
    exact ⟨_, 𝟙 _, g, ⟨t, ht⟩, Category.id_comp _⟩

  have hker : ∀ (T : ShortComplex (SheafOfModules.{u+1} S)), T.Exact → Mono T.f → ∀ (W : C)
      (x₂ : T.X₂.val.obj (Opposite.op W)), (T.g.val.app (Opposite.op W)).hom x₂ = 0 →
      ∃ x₁ : T.X₁.val.obj (Opposite.op W), (T.f.val.app (Opposite.op W)).hom x₁ = x₂ := by
    intro T hT hf W x₂ hx
    have hE := hT.map_of_mono_of_preservesKernel (SheafOfModules.forget.{u+1} S ⋙
      PresheafOfModules.evaluation.{u+1} S.obj (Opposite.op W)) hf inferInstance
    exact (ShortComplex.moduleCat_exact_iff _).1 hE x₂ hx

  have hexact : ∀ (T : ShortComplex (SheafOfModules.{u+1} S)), T.Exact → ∀ (W : C)
      (x₂ : T.X₂.val.obj (Opposite.op W)), (T.g.val.app (Opposite.op W)).hom x₂ = 0 →
      Sieve.generate (fun (W' : C) (g : W' ⟶ W) => ∃ x₁ : T.X₁.val.obj (Opposite.op W'),
        (T.f.val.app (Opposite.op W')).hom x₁ = (T.X₂.val.map g.op).hom x₂) ∈ J W := by
    intro T hT W x₂ hx
    obtain ⟨z, hz⟩ := hker (ShortComplex.mk T.iCycles T.g T.iCycles_g)
      (ShortComplex.exact_of_f_is_kernel _ T.cyclesIsKernel) inferInstance W x₂ hx
    have := hT.epi_toCycles
    refine J.superset_covering ?_ (hepi T.toCycles W z)
    rw [Sieve.generate_le_iff]
    rintro W' g ⟨t, ht⟩
    apply Sieve.le_generate
    refine ⟨t, ?_⟩
    rw [← T.toCycles_i, hcomp, ht, hnat]
    exact congrArg _ hz

  have htrans : ∀ (W : C) (P₁ P₂ : Presieve W), Sieve.generate P₁ ∈ J W →
      (∀ (Y : C) (g₀ : Y ⟶ W), P₁ g₀ →
        Sieve.generate (fun (Y' : C) (g' : Y' ⟶ Y) => P₂ (g' ≫ g₀)) ∈ J Y) →
      Sieve.generate P₂ ∈ J W := by
    intro W P₁ P₂ h1 h2
    refine J.transitive h1 _ ?_
    intro Y' f hf
    obtain ⟨Y, k, g₀, hg₀, rfl⟩ := hf
    have h3 : Sieve.generate (fun (Y'' : C) (g' : Y'' ⟶ Y) => P₂ (g' ≫ g₀)) ≤
        (Sieve.generate P₂).pullback g₀ := by
      rw [Sieve.generate_le_iff]
      intro Y'' g' hg'
      exact ⟨_, 𝟙 _, g' ≫ g₀, hg', Category.id_comp _⟩
    have h4 := J.superset_covering h3 (h2 Y g₀ hg₀)
    rw [Sieve.pullback_comp]
    exact J.pullback_stable k h4

  have hsep : ∀ (W : C) (x : S.obj.obj (Opposite.op W)),
      Sieve.generate (fun (W' : C) (g : W' ⟶ W) => (S.obj.map g.op).hom x = 0) ∈ J W → x = 0 := by
    intro W x hx
    apply (Sheaf.isSeparated S) W _ hx x 0
    intro Y f hf
    obtain ⟨Z, k, k₀, hk₀, rfl⟩ := hf
    show (S.obj.map (k ≫ k₀).op).hom x = (S.obj.map (k ≫ k₀).op).hom 0
    rw [map_zero, hSmap, hk₀, map_zero]

  have hmain : ∀ (P : CochainComplex (SheafOfModules.{u+1} S) ℕ)
      (g : SheafOfModules.unit S ⟶ P.X q) (hg : g ≫ P.d q (q + 1) = 0),
      (∀ (W : C) (c : S.obj.obj (Opposite.op W))
        (y : (P.X ((ComplexShape.up ℕ).prev q)).val.obj (Opposite.op W)),
        (g.val.app (Opposite.op W)).hom c =
          ((P.d ((ComplexShape.up ℕ).prev q) q).val.app (Opposite.op W)).hom y →
        Sieve.generate (fun (W' : C) (h : W' ⟶ W) => (S.obj.map h.op).hom c = 0) ∈ J W) →
      (∀ (W : C) (s : (P.X q).val.obj (Opposite.op W)),
        ((P.d q (q + 1)).val.app (Opposite.op W)).hom s = 0 →
        Sieve.generate (fun (W' : C) (h : W' ⟶ W) => ∃ (c : S.obj.obj (Opposite.op W'))
            (y : (P.X ((ComplexShape.up ℕ).prev q)).val.obj (Opposite.op W')),
            ((P.X q).val.map h.op).hom s =
              (g.val.app (Opposite.op W')).hom c +
              ((P.d ((ComplexShape.up ℕ).prev q) q).val.app (Opposite.op W')).hom y) ∈ J W) →
      IsIso (P.liftCycles g (q + 1) (by simp) hg ≫ P.homologyπ q) := by
    intro P g hg H2 H3
    have hLi : ∀ (V : Cᵒᵖ) (x : (SheafOfModules.unit S).val.obj V),
        ((P.iCycles q).val.app V).hom
          (((P.liftCycles g (q + 1) (by simp) hg).val.app V).hom x) =
        (g.val.app V).hom x := by
      intro V x
      rw [← hcomp, P.liftCycles_i]
    have hTi : ∀ (V : Cᵒᵖ) (y : (P.X ((ComplexShape.up ℕ).prev q)).val.obj V),
        ((P.iCycles q).val.app V).hom
          (((P.toCycles ((ComplexShape.up ℕ).prev q) q).val.app V).hom y) =
        ((P.d ((ComplexShape.up ℕ).prev q) q).val.app V).hom y := by
      intro V y
      rw [← hcomp, P.toCycles_i]
    have hTπ : ∀ (V : Cᵒᵖ) (y : (P.X ((ComplexShape.up ℕ).prev q)).val.obj V),
        ((P.homologyπ q).val.app V).hom
          (((P.toCycles ((ComplexShape.up ℕ).prev q) q).val.app V).hom y) = 0 := by
      intro V y
      rw [← hcomp, P.toCycles_comp_homologyπ]
      rfl

    have hinj : ∀ (W : C) (c : S.obj.obj (Opposite.op W)),
        ((P.liftCycles g (q + 1) (by simp) hg ≫ P.homologyπ q).val.app
          (Opposite.op W)).hom c = 0 → c = 0 := by
      intro W c hc
      obtain ⟨z, hz⟩ : ∃ z : (P.cycles q).val.obj (Opposite.op W), z =
          ((P.liftCycles g (q + 1) (by simp) hg).val.app (Opposite.op W)).hom c :=
        ⟨_, rfl⟩
      have hπz : ((P.homologyπ q).val.app (Opposite.op W)).hom z = 0 := by
        rw [hz, ← hc]
        rfl
      have hTex := ShortComplex.exact_of_g_is_cokernel
        (ShortComplex.mk (P.toCycles ((ComplexShape.up ℕ).prev q) q) (P.homologyπ q)
          (P.toCycles_comp_homologyπ _ q)) (P.homologyIsCokernel _ q rfl)
      apply hsep W c
      apply htrans W _ _ (hexact _ hTex W z hπz)
      rintro Y h₀ ⟨y, hy⟩
      have hd : (g.val.app (Opposite.op Y)).hom ((S.obj.map h₀.op).hom c) =
          ((P.d ((ComplexShape.up ℕ).prev q) q).val.app (Opposite.op Y)).hom y := by
        rw [← hTi]
        erw [hy]
        rw [hnat, hz]
        exact (hnat g h₀ c).trans (congrArg _ (hLi _ c).symm)
      refine J.superset_covering ?_ (H2 Y _ y hd)
      rw [Sieve.generate_le_iff]
      intro Z g' hg'
      apply Sieve.le_generate
      show (S.obj.map (g' ≫ h₀).op).hom c = 0
      rw [hSmap]
      exact hg'

    have hloc : ∀ (W : C) (x : (P.homology q).val.obj (Opposite.op W)),
        Sieve.generate (fun (W' : C) (h : W' ⟶ W) => ∃ c : S.obj.obj (Opposite.op W'),
          ((P.homology q).val.map h.op).hom x =
            ((P.liftCycles g (q + 1) (by simp) hg ≫ P.homologyπ q).val.app
              (Opposite.op W')).hom c) ∈ J W := by
      intro W x
      apply htrans W _ _ (hepi (P.homologyπ q) W x)
      rintro Y h₀ ⟨z, hz⟩
      have hs : ((P.d q (q + 1)).val.app (Opposite.op Y)).hom
          (((P.iCycles q).val.app (Opposite.op Y)).hom z) = 0 := by
        rw [← hcomp, P.iCycles_d]
        rfl
      refine J.superset_covering ?_ (H3 Y _ hs)
      rw [Sieve.generate_le_iff]
      rintro Z h' ⟨c, y, hcy⟩
      apply Sieve.le_generate
      refine ⟨c, ?_⟩
      have hw : ((P.cycles q).val.map h'.op).hom z =
          ((P.liftCycles g (q + 1) (by simp) hg).val.app (Opposite.op Z)).hom c +
            ((P.toCycles ((ComplexShape.up ℕ).prev q) q).val.app (Opposite.op Z)).hom y := by
        apply hmono (P.iCycles q) Z
        rw [map_add, hnat, hcy, hTi]
        congr 1
        exact (hLi _ c).symm
      rw [hMmap, ← hz, ← hnat, hw, map_add, hTπ, add_zero]
      rfl

    haveI hM : Mono (P.liftCycles g (q + 1) (by simp) hg ≫ P.homologyπ q) := by
      constructor
      intro X a b hab
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro V
      ext x
      have h1 : ((P.liftCycles g (q + 1) (by simp) hg ≫ P.homologyπ q).val.app V).hom
            ((a.val.app V).hom x) =
          ((P.liftCycles g (q + 1) (by simp) hg ≫ P.homologyπ q).val.app V).hom
            ((b.val.app V).hom x) := by
        rw [← hcomp, ← hcomp, hab]
      have hd0 : ((P.liftCycles g (q + 1) (by simp) hg ≫ P.homologyπ q).val.app V).hom
          ((a.val.app V).hom x - (b.val.app V).hom x) = 0 := by
        rw [map_sub, h1, sub_self]
      have h2 := hinj V.unop _ hd0
      exact sub_eq_zero.mp h2

    haveI hE : Epi (P.liftCycles g (q + 1) (by simp) hg ≫ P.homologyπ q) := by
      apply (SheafOfModules.toSheaf.{u+1} S).epi_of_epi_map
      apply (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} _).1
      have : Presheaf.IsLocallySurjective J ((SheafOfModules.toSheaf.{u+1} S).map
          (P.liftCycles g (q + 1) (by simp) hg ≫ P.homologyπ q)).hom := by
        refine ⟨fun {U} s => ?_⟩
        refine J.superset_covering ?_ (hloc U s)
        rw [Sieve.generate_le_iff]
        rintro W' k ⟨c, hc⟩
        exact ⟨c, hc.symm⟩
      exact this
    exact isIso_of_mono_of_epi _
  refine hmain _ _ hg ?_ ?_
  · intro W c y h
    exact hind W c y h
  · intro W s hs
    refine J.superset_covering ?_ (hgen W s hs)
    rw [Sieve.generate_le_iff]
    rintro W' k ⟨c, y, hcy⟩
    apply Sieve.le_generate
    exact ⟨c, y, hcy⟩

theorem wc_punct_K_zmod_coh_finite (F : Type u) [Finite F] [Field F] (d ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F) (hd : 1 ≤ d)
    (OK : (wcTlAff F d).Opens) (hOK : (OK : Set ↥(wcTlAff F d)) = (Set.range (wcTlZero F d))ᶜ) :
    ∀ k j : ℕ, 1 ≤ k → Finite (wcZModProEtExt OK.toScheme (ℓ ^ k) j) :=
by
  classical

  have hℓF : ((ℓ : ℕ) : F) ≠ 0 := by
    intro h0
    haveI : Fact (Nat.Prime (ringChar F)) := ⟨CharP.char_is_prime F (ringChar F)⟩
    have h1 : ringChar F ∣ ℓ := (ringChar.spec F ℓ).mp h0
    have h2 : ringChar F = ℓ :=
      (Nat.prime_dvd_prime_iff_eq (Fact.out : Nat.Prime (ringChar F)) Fact.out).mp h1
    letI := Fintype.ofFinite F
    have h3 : ((Fintype.card F : ℕ) : F) = 0 := FiniteField.cast_card_eq_zero F
    have h4 : ringChar F ∣ Fintype.card F := (ringChar.spec F _).mp h3
    apply hℓ
    rw [← h2, Nat.card_eq_fintype_card]
    exact h4
  have hℓK : ((ℓ : ℕ) : AlgebraicClosure F) ≠ 0 := by
    rw [← map_natCast (algebraMap F (AlgebraicClosure F))]
    exact (map_ne_zero (algebraMap F (AlgebraicClosure F))).mpr hℓF

  obtain ⟨q, hP, hz⟩ := wc_affine_space_ulift_mvpoly_zero_pullback (AlgebraicClosure F)
    (Spec (.of (AlgebraicClosure F))) (𝟙 _) d
  haveI : IsIso q := hP.isIso_snd_of_isIso

  haveI : IsLocallyNoetherian (wcTlAff F d) := isLocallyNoetherian_of_isOpenImmersion q
  haveI : CompactSpace ↥OK.toScheme := QuasiCompact.compactSpace_of_compactSpace OK.ι
  haveI : QuasiSeparatedSpace ↥OK.toScheme := quasiSeparatedSpace_of_quasiSeparated OK.ι
  have hrc : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z),
      Set.range (f ≫ g) = g '' Set.range f := by
    intro X Y Z f g
    ext y
    constructor
    · rintro ⟨x, rfl⟩
      exact ⟨f x, ⟨x, rfl⟩, (Scheme.Hom.comp_apply f g x).symm⟩
    · rintro ⟨_, ⟨x, rfl⟩, rfl⟩
      exact ⟨x, Scheme.Hom.comp_apply f g x⟩

  have hstar : ∀ i : ℕ, Finite (wcEtCoh OK.toScheme ℓ i) := by
    intro i
    rcases (by omega : i + 2 ≤ 2 * d ∨ i = 2 * d - 1 ∨ 2 * d ≤ i) with hi | hi | hi
    ·
      obtain ⟨D⟩ := wc_et_zmod_pull_data_exists (OK.ι ≫ wcTlStr F d) ℓ
      have hsurj := (wc_et_pull_punctured_bundle (AlgebraicClosure F)
        (Spec (.of (AlgebraicClosure F))) (𝟙 _) 0 d (wcTlAff F d) (wcTlStr F d) q (wcTlZero F d)
        hP (AffineSpace.homOfVector_over _ _) hz hd OK hOK ℓ hℓK D i).2 hi
      haveI : Finite (wcEtCoh (Spec (.of (AlgebraicClosure F))) ℓ i) :=
        wc_et_coh_sepClosed_point_finite (AlgebraicClosure F) ℓ (Nat.Prime.ne_zero Fact.out) i
      obtain ⟨e1⟩ := wc_et_zmodext_coh_equiv (Spec (.of (AlgebraicClosure F))) ℓ i
      haveI : Finite (wcEtZModExt (Spec (.of (AlgebraicClosure F))) ℓ i) := Finite.of_equiv _ e1.symm
      haveI : Finite (wcEtZModExt OK.toScheme ℓ i) := Finite.of_surjective _ hsurj
      obtain ⟨e2⟩ := wc_et_zmodext_coh_equiv OK.toScheme ℓ i
      exact Finite.of_equiv _ e2
    ·
      subst hi
      let f : OK.toScheme ⟶ Spec (.of (MvPolynomial (Fin d) (AlgebraicClosure F))) := OK.ι ≫ q
      have hb : Function.Bijective q := (Scheme.Hom.homeomorph q).bijective
      have hU₀ : ((Scheme.Hom.opensRange f : (Spec (.of (MvPolynomial (Fin d) (AlgebraicClosure F)))).Opens) :
          Set (Spec (.of (MvPolynomial (Fin d) (AlgebraicClosure F))))) =
          (Set.range (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff :
            MvPolynomial (Fin d) (AlgebraicClosure F) →+* AlgebraicClosure F))))ᶜ := by
        rw [Scheme.Hom.coe_opensRange]
        calc Set.range ⇑f = q '' Set.range OK.ι := hrc OK.ι q
          _ = q '' (Set.range (wcTlZero F d))ᶜ := by rw [Scheme.Opens.range_ι, hOK]
          _ = (q '' Set.range (wcTlZero F d))ᶜ := Set.image_compl_eq hb
          _ = (Set.range (wcTlZero F d ≫ q))ᶜ := by rw [hrc]
          _ = _ := by rw [show wcTlZero F d ≫ q = _ from hz, Category.id_comp]
      haveI := (wc_et_punctured_affine_coh_card_le (AlgebraicClosure F) d hd ℓ Fact.out hℓK
        (Scheme.Hom.opensRange f) hU₀).1
      obtain ⟨e⟩ := wc_et_coh_iso_invariance (Scheme.Hom.isoOpensRange f).hom ℓ (2 * d - 1)
      exact Finite.of_equiv _ e
    ·
      have hvan : ∀ α : wcEtZModExt OK.toScheme ℓ i, α = 0 := by
        intro α
        obtain ⟨S', s', hs'et, ⟨v, hv⟩, hkill⟩ := wc_et_punct_high_local_death (AlgebraicClosure F)
          ℓ hℓK d hd (Spec (.of (AlgebraicClosure F))) (𝟙 _) 0 (wcTlAff F d) (wcTlStr F d) q
          (wcTlZero F d) hP (AffineSpace.homOfVector_over _ _) hz OK hOK i hi α
          (IsLocalRing.closedPoint (AlgebraicClosure F))
        let ε : AlgebraicClosure F →ₐ[AlgebraicClosure F]
            IsLocalRing.ResidueField (AlgebraicClosure F) := Algebra.ofId _ _
        have hεb : Function.Bijective ε := by
          refine ⟨(algebraMap (AlgebraicClosure F)
            (IsLocalRing.ResidueField (AlgebraicClosure F))).injective, ?_⟩
          intro y
          obtain ⟨x, hx⟩ := IsLocalRing.residue_surjective y
          refine ⟨x, ?_⟩
          rw [← hx]
          show algebraMap (AlgebraicClosure F) (IsLocalRing.ResidueField (AlgebraicClosure F)) x = _
          rw [IsLocalRing.ResidueField.algebraMap_eq]
        haveI : IsAlgClosed (IsLocalRing.ResidueField (AlgebraicClosure F)) :=
          IsAlgClosed.of_ringEquiv (AlgebraicClosure F) _ (RingEquiv.ofBijective ε hεb)
        have hstrict : ∀ (E : Type u) [CommRing E] [Algebra (AlgebraicClosure F) E],
            Algebra.Etale (AlgebraicClosure F) E →
            ∀ φ : E →ₐ[AlgebraicClosure F] IsLocalRing.ResidueField (AlgebraicClosure F),
            ∃ τ : E →ₐ[AlgebraicClosure F] AlgebraicClosure F,
              (Algebra.ofId (AlgebraicClosure F)
                (IsLocalRing.ResidueField (AlgebraicClosure F))).comp τ = φ := by
          intro E _ _ _ φ
          refine ⟨(AlgEquiv.ofBijective ε hεb).symm.toAlgHom.comp φ, ?_⟩
          ext x
          exact (AlgEquiv.ofBijective ε hεb).apply_symm_apply (φ x)
        haveI : Etale s' := hs'et
        obtain ⟨σ, hσ⟩ := wc_etale_section_strict_local (AlgebraicClosure F) hstrict
          (Iso.refl _) s' v (Subsingleton.elim _ _)
        obtain ⟨D'⟩ := wc_et_zmod_pull_data_exists
          (Limits.pullback.fst (OK.ι ≫ wcTlStr F d) s') ℓ
        have h0 := hkill (Limits.pullback (OK.ι ≫ wcTlStr F d) s') (Limits.pullback.snd _ _)
          (Limits.pullback.fst _ _) (IsPullback.of_hasPullback _ _) D'
        let lam : OK.toScheme ⟶ Limits.pullback (OK.ι ≫ wcTlStr F d) s' :=
          Limits.pullback.lift (𝟙 _) (OK.ι ≫ wcTlStr F d ≫ σ)
            (by rw [Category.id_comp, Category.assoc, Category.assoc, hσ, Category.comp_id])
        have hl : lam ≫ Limits.pullback.fst (OK.ι ≫ wcTlStr F d) s' = 𝟙 _ :=
          Limits.pullback.lift_fst _ _ _
        obtain ⟨Dl⟩ := wc_et_zmod_pull_data_exists lam ℓ
        obtain ⟨Did⟩ := wc_et_zmod_pull_data_exists (𝟙 OK.toScheme) ℓ
        have hc := wc_et_pull_comp (Limits.pullback.fst (OK.ι ≫ wcTlStr F d) s') lam (𝟙 _) hl
          D' Dl Did i α
        rw [h0, map_zero] at hc
        exact wc_et_pull_id_injective Did i α hc
      haveI : Subsingleton (wcEtZModExt OK.toScheme ℓ i) :=
        ⟨fun a b => (hvan a).trans (hvan b).symm⟩
      haveI : Finite (wcEtZModExt OK.toScheme ℓ i) := Finite.of_subsingleton
      obtain ⟨e2⟩ := wc_et_zmodext_coh_equiv OK.toScheme ℓ i
      exact Finite.of_equiv _ e2

  have hfinall : ∀ k j : ℕ, Finite (wcEtCoh OK.toScheme (ℓ ^ k) j) := by
    intro k j
    refine wc_et_coh_coeff_devissage OK.toScheme (ℓ ^ k)
      (pow_ne_zero _ (Nat.Prime.ne_zero Fact.out)) ?_ j
    intro p hp hpd i
    have hpl : p = ℓ := (Nat.prime_dvd_prime_iff_eq hp Fact.out).mp (hp.dvd_of_dvd_pow hpd)
    rw [hpl]
    exact hstar i

  intro k j _
  obtain ⟨Θ, hΘ, -⟩ := wc_zmod_et_proet_natural_comparison_all (ℓ ^ k) j
  haveI : Finite (wcEtZModExt OK.toScheme (ℓ ^ k) j) := by
    obtain ⟨e⟩ := wc_et_zmodext_coh_equiv OK.toScheme (ℓ ^ k) j
    haveI := hfinall k j
    exact Finite.of_equiv _ e.symm
  exact Finite.of_surjective _ (hΘ OK.toScheme inferInstance inferInstance).2

theorem wc_supp_open_excision_exists {T V W : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (i : T ⟶ V) [IsClosedImmersion i] (j : W ⟶ V) [IsOpenImmersion j]
    (iW : T ⟶ W) (hiW : iW ≫ j = i) [IsLocallyNoetherian V]
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (DiW : wcHMPullData iW ℓ) (hDiW : wcHMPullCanonical DiW)
    (Dj : wcHMPullData j ℓ) (hDj : wcHMPullCanonical Dj) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf W ℓ)) := HasExt.standard _
    ∃ κ : wcSuppObj DiW ⟶ Dj.Φ.obj (wcSuppObj Di),
      wcSuppUnitMap DiW ≫ κ = Dj.μ.inv ≫ Dj.Φ.map (wcSuppUnitMap Di) ∧
      ∀ n : ℕ, Function.Bijective (fun θ : wcSuppExt Di n =>
        (Abelian.Ext.mk₀ κ).comp (wcSuppPullExt Di Dj n θ) (zero_add _)) :=
by
  classical

  haveI : IsLocallyNoetherian W := isLocallyNoetherian_of_isOpenImmersion j
  haveI : IsClosedImmersion (iW ≫ j) := by rw [hiW]; infer_instance
  haveI : IsClosedImmersion iW := IsClosedImmersion.of_comp iW j
  have hU : Etale j := inferInstance
  have hwe : WeaklyEtale j := inferInstance
  have hsq : IsPullback iW (𝟙 T) j i :=
    IsPullback.of_vert_isIso_mono ⟨hiW.trans (Category.id_comp i).symm⟩
  have hgI : IsIso (𝟙 T) := inferInstance

  have hepiW : Epi (wcSuppUnitMap DiW) := wc_supp_unit_epi_of_noetherian iW ℓ DiW hDiW
  have hK := wc_supp_kernel_kill_of_noetherian i j iW (𝟙 T) hsq ℓ Di hDi DiW hDiW Dj hDj
  let κ : wcSuppObj DiW ⟶ Dj.Φ.obj (wcSuppObj Di) :=
    Abelian.epiDesc (wcSuppUnitMap DiW) (Dj.μ.inv ≫ Dj.Φ.map (wcSuppUnitMap Di)) hK
  have hκ : wcSuppUnitMap DiW ≫ κ = Dj.μ.inv ≫ Dj.Φ.map (wcSuppUnitMap Di) :=
    Abelian.comp_epiDesc _ _ _

  suffices main : ∀ (U : V.ProEt) (hU : Etale U.hom) (i₁ : T ⟶ U.left)
      (hsq₁ : IsPullback i₁ (𝟙 T) U.hom i)
      (Di₁ : wcHMPullData i₁ ℓ) (hDi₁ : wcHMPullCanonical Di₁) (hepi₁ : Epi (wcSuppUnitMap Di₁))
      (De₁ : wcHMPullData (S := V) (S' := U.left) U.hom ℓ) (hDe₁ : wcHMPullCanonical De₁)
      (κ₁ : wcSuppObj Di₁ ⟶ De₁.Φ.obj (wcSuppObj Di))
      (hκ₁ : wcSuppUnitMap Di₁ ≫ κ₁ = De₁.μ.inv ≫ De₁.Φ.map (wcSuppUnitMap Di)) (n : ℕ),
      letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf U.left ℓ)) := HasExt.standard _
      Function.Bijective (fun θ : wcSuppExt Di n =>
        (Abelian.Ext.mk₀ κ₁).comp (wcSuppPullExt Di De₁ n θ) (zero_add _)) from
    ⟨κ, hκ, fun n => main (MorphismProperty.Over.mk ⊤ j hwe) hU iW hsq DiW hDiW hepiW Dj hDj
      κ hκ n⟩
  intro U hU i₁ hsq₁ Di₁ hDi₁ hepi₁ De₁ hDe₁ κ₁ hκ₁ n
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf U.left ℓ)) := HasExt.standard _
  haveI := De₁.additive
  haveI := De₁.presLim
  haveI := De₁.presColim
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf V ℓ)) :=
    sheafOfModules_enoughInjectives (Scheme.ProEt.topology V) (wcRingSheaf V ℓ)
  haveI hσ : (wcSliceToOver V U).IsContinuous (Scheme.ProEt.topology U.left)
      ((Scheme.ProEt.topology V).over U) := (wc_slice_over_sites_cont V U).1
  haveI hj : (wcSliceFunctor V U).IsContinuous (Scheme.ProEt.topology U.left)
      (Scheme.ProEt.topology V) := by
    have h := Functor.isContinuous_comp (wcSliceToOver V U) (Over.forget U)
      (Scheme.ProEt.topology U.left) ((Scheme.ProEt.topology V).over U) (Scheme.ProEt.topology V)
    exact h
  obtain ⟨θe⟩ := wc_hm_pull_Phi_slice_iso V ℓ U De₁ hDe₁
  have hepiD : Epi (wcSuppUnitMap Di) := wc_supp_unit_epi_of_noetherian i ℓ Di hDi
  let R := wcSliceRes V ℓ U
  let γ' : wcSuppObj Di₁ ⟶ R.obj (wcSuppObj Di) := κ₁ ≫ θe.hom.app (wcSuppObj Di)
  let μ' : R.obj (SheafOfModules.unit (wcRingSheaf V ℓ)) ≅
      SheafOfModules.unit (wcRingSheaf U.left ℓ) :=
    (θe.app (SheafOfModules.unit (wcRingSheaf V ℓ))).symm ≪≫ De₁.μ
  have hnat : ∀ {A B : SheafOfModules.{u+1} (wcRingSheaf V ℓ)} (f : A ⟶ B),
      De₁.Φ.map f ≫ θe.hom.app B = θe.hom.app A ≫ R.map f := fun f => θe.hom.naturality f
  have hnat' : ∀ {A B : SheafOfModules.{u+1} (wcRingSheaf V ℓ)} (f : A ⟶ B),
      R.map f ≫ θe.inv.app B = θe.inv.app A ≫ De₁.Φ.map f := fun f => θe.inv.naturality f
  have hγ' : wcSuppUnitMap Di₁ ≫ γ' = μ'.inv ≫ R.map (wcSuppUnitMap Di) := by
    calc wcSuppUnitMap Di₁ ≫ γ' = (wcSuppUnitMap Di₁ ≫ κ₁) ≫ θe.hom.app (wcSuppObj Di) :=
          (Category.assoc _ _ _).symm
      _ = (De₁.μ.inv ≫ De₁.Φ.map (wcSuppUnitMap Di)) ≫ θe.hom.app (wcSuppObj Di) := by rw [hκ₁]
      _ = De₁.μ.inv ≫ (De₁.Φ.map (wcSuppUnitMap Di) ≫ θe.hom.app (wcSuppObj Di)) :=
          Category.assoc _ _ _
      _ = De₁.μ.inv ≫ (θe.hom.app _ ≫ R.map (wcSuppUnitMap Di)) := by rw [hnat]
      _ = μ'.inv ≫ R.map (wcSuppUnitMap Di) := (Category.assoc _ _ _).symm
  have hhom : ∀ N : SheafOfModules.{u+1} (wcRingSheaf V ℓ),
      Function.Bijective (fun f : wcSuppObj Di ⟶ N => κ₁ ≫ De₁.Φ.map f) := by
    intro N
    have hinj := wc_slice_res_supp_hom_injective V ℓ U hU i i₁ (𝟙 T) hsq₁ hgI Di hDi hepiD
      Di₁ hDi₁ μ' γ' hγ' N
    have hsurj := wc_slice_res_supp_hom_surjective V ℓ U hU i i₁ (𝟙 T) hsq₁ hgI Di hDi hepiD
      Di₁ hDi₁ hepi₁ μ' γ' hγ' N
    have hhi : ∀ (A : SheafOfModules.{u+1} (wcRingSheaf V ℓ)),
        θe.hom.app A ≫ θe.inv.app A = 𝟙 _ := fun A => θe.hom_inv_id_app A
    have hih : ∀ (A : SheafOfModules.{u+1} (wcRingSheaf V ℓ)),
        θe.inv.app A ≫ θe.hom.app A = 𝟙 _ := fun A => θe.inv_hom_id_app A
    have hfac : ∀ f : wcSuppObj Di ⟶ N,
        κ₁ ≫ De₁.Φ.map f = (γ' ≫ R.map f) ≫ θe.inv.app N := by
      intro f
      calc κ₁ ≫ De₁.Φ.map f = κ₁ ≫ (𝟙 _ ≫ De₁.Φ.map f) := by rw [Category.id_comp]
        _ = κ₁ ≫ ((θe.hom.app (wcSuppObj Di) ≫ θe.inv.app (wcSuppObj Di)) ≫ De₁.Φ.map f) := by
            rw [hhi]
        _ = κ₁ ≫ (θe.hom.app (wcSuppObj Di) ≫ (θe.inv.app (wcSuppObj Di) ≫ De₁.Φ.map f)) := by
            rw [Category.assoc]
        _ = κ₁ ≫ (θe.hom.app (wcSuppObj Di) ≫ (R.map f ≫ θe.inv.app N)) := by rw [hnat']
        _ = (γ' ≫ R.map f) ≫ θe.inv.app N := by
            simp only [γ', Category.assoc]
    have hcanc : ∀ a b : wcSuppObj Di₁ ⟶ R.obj N,
        a ≫ θe.inv.app N = b ≫ θe.inv.app N → a = b := by
      intro a b hab
      calc a = a ≫ 𝟙 _ := (Category.comp_id a).symm
        _ = a ≫ (θe.inv.app N ≫ θe.hom.app N) := by rw [hih]
        _ = (a ≫ θe.inv.app N) ≫ θe.hom.app N := (Category.assoc _ _ _).symm
        _ = (b ≫ θe.inv.app N) ≫ θe.hom.app N := by rw [hab]
        _ = b ≫ (θe.inv.app N ≫ θe.hom.app N) := Category.assoc _ _ _
        _ = b ≫ 𝟙 _ := by rw [hih]
        _ = b := Category.comp_id b
    refine ⟨fun f₁ f₂ h => hinj (hcanc _ _ ?_), fun h => ?_⟩
    · have h' : κ₁ ≫ De₁.Φ.map f₁ = κ₁ ≫ De₁.Φ.map f₂ := h
      rw [hfac, hfac] at h'
      exact h'
    · obtain ⟨f, hf⟩ := hsurj (h ≫ θe.hom.app N)
      refine ⟨f, ?_⟩
      have hf' : γ' ≫ R.map f = h ≫ θe.hom.app N := hf
      show κ₁ ≫ De₁.Φ.map f = h
      calc κ₁ ≫ De₁.Φ.map f = (γ' ≫ R.map f) ≫ θe.inv.app N := hfac f
        _ = (h ≫ θe.hom.app N) ≫ θe.inv.app N := by rw [hf']
        _ = h ≫ (θe.hom.app N ≫ θe.inv.app N) := Category.assoc _ _ _
        _ = h ≫ 𝟙 _ := by rw [hhi]
        _ = h := Category.comp_id h
  have hvan : ∀ (I : SheafOfModules.{u+1} (wcRingSheaf V ℓ)) [Injective I] (k : ℕ)
      (x : Abelian.Ext (wcSuppObj Di₁) (De₁.Φ.obj I) (k + 1)), x = 0 := by
    intro I _ k x
    have hRI : Injective (R.obj I) := wc_slice_res_preserves_injective V ℓ U I
    haveI : Injective (De₁.Φ.obj I) := Injective.of_iso (θe.app I).symm hRI
    exact Abelian.Ext.eq_zero_of_injective x
  have hΨ := ext_transfer_of_corep De₁.Φ (wcSuppObj Di) (wcSuppObj Di₁) κ₁ hhom hvan
    (SheafOfModules.unit (wcRingSheaf V ℓ)) n
  have key : ∀ θ : wcSuppExt Di n,
      (Abelian.Ext.mk₀ κ₁).comp (wcSuppPullExt Di De₁ n θ) (zero_add _) =
        ((Abelian.Ext.mk₀ κ₁).comp (Abelian.Ext.mapExactFunctor De₁.Φ θ) (zero_add n)).comp
          (Abelian.Ext.mk₀ De₁.μ.hom) (add_zero n) := by
    intro θ
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero]
    rfl

  have hPQ : ∀ z : Abelian.Ext (wcSuppObj Di₁)
      (De₁.Φ.obj (SheafOfModules.unit (wcRingSheaf V ℓ))) n,
      (z.comp (Abelian.Ext.mk₀ De₁.μ.hom) (add_zero n)).comp (Abelian.Ext.mk₀ De₁.μ.inv)
        (add_zero n) = z := by
    intro z
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
      Abelian.Ext.comp_mk₀_id]
  refine ⟨fun θ₁ θ₂ h => ?_, fun w => ?_⟩
  · have h' : (Abelian.Ext.mk₀ κ₁).comp (wcSuppPullExt Di De₁ n θ₁) (zero_add _) =
        (Abelian.Ext.mk₀ κ₁).comp (wcSuppPullExt Di De₁ n θ₂) (zero_add _) := h
    rw [key, key] at h'
    have h'' := congrArg (fun z => z.comp (Abelian.Ext.mk₀ De₁.μ.inv) (add_zero n)) h'
    simp only [hPQ] at h''
    exact hΨ.1 h''
  · obtain ⟨θ, hθ⟩ := hΨ.2 (w.comp (Abelian.Ext.mk₀ De₁.μ.inv) (add_zero n))
    refine ⟨θ, ?_⟩
    have hθ' : (Abelian.Ext.mk₀ κ₁).comp (Abelian.Ext.mapExactFunctor De₁.Φ θ) (zero_add n) =
        w.comp (Abelian.Ext.mk₀ De₁.μ.inv) (add_zero n) := hθ
    show (Abelian.Ext.mk₀ κ₁).comp (wcSuppPullExt Di De₁ n θ) (zero_add _) = w
    rw [key θ, hθ', Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
      Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]

theorem wc_point_supp_class_nonzero (F : Type u) [Finite F] [Field F]
    (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    {Z : Scheme.{u}} (a : Z ⟶ wcXbar F X) (ha : IsIso (a ≫ wcPi2 F X))
    (Da : wcHMPullData a ℓ) (hDa : wcHMPullCanonical Da) :
    ∃ u : wcSuppExt Da (2 * d), wcSuppClass Da (2 * d) u ≠ 0 :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcXbar F X) ℓ)) := HasExt.standard _
  haveI := ha
  obtain ⟨Dx, hDx⟩ := wc_hm_pull_data_exists (inv (a ≫ wcPi2 F X) ≫ a) ℓ
  obtain ⟨ua, hua, hσa⟩ := wc_supp_unit_section Da hDa
  obtain ⟨u0, hu0, hσ0⟩ := wc_supp_unit_section Dx hDx
  obtain ⟨r, ι, hr, -, -, -⟩ := wc_supp_clopen_split a 1 (fun _ => inv (a ≫ wcPi2 F X))
    (fun _ => IsOpenImmersion.of_isIso _) (fun k j hkj => absurd (Subsingleton.elim k j) hkj)
    (fun p => ⟨0, Scheme.Hom.surjective (inv (a ≫ wcPi2 F X)) p⟩) Da hDa (fun _ => Dx)
    (fun _ => hDx) ua hua hσa (fun _ => u0) (fun _ => hu0) (fun _ => hσ0)
  have hx₀ : (inv (a ≫ wcPi2 F X) ≫ a) ≫ wcPi2 F X = 𝟙 _ := by
    rw [Category.assoc, IsIso.inv_hom_id]
  obtain ⟨θ, hθ⟩ := wc_xbar_point_supp_class_nonzero F X d ℓ hℓ (inv (a ≫ wcPi2 F X) ≫ a) hx₀
    Dx hDx
  refine ⟨(Abelian.Ext.mk₀ (r 0)).comp θ (zero_add _), ?_⟩
  have key : wcSuppClass Da (2 * d) ((Abelian.Ext.mk₀ (r 0)).comp θ (zero_add _)) =
      wcSuppClass Dx (2 * d) θ := by
    show (Abelian.Ext.mk₀ (wcSuppUnitMap Da)).comp ((Abelian.Ext.mk₀ (r 0)).comp θ _) _ =
      (Abelian.Ext.mk₀ (wcSuppUnitMap Dx)).comp θ _
    rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
    exact congrArg (fun g => (Abelian.Ext.mk₀ g).comp θ (zero_add _)) (hr 0)
  rw [key]
  exact hθ

theorem wc_pp_geomIrred_of_charts : ∀ {K : Type u} [Field K] {X : Scheme.{u}} (f : X ⟶ Spec (.of K)) {ι : Type*} (U : ι → X.Opens) (i₀ : ι), (⨆ i, U i) = ⊤ → (∀ i, ∃ (Z : Scheme.{u}) (g : Z ⟶ Spec (.of K)) (_ : GeometricallyIrreducible g) (φ : (U i : Scheme.{u}) ≅ Z), (U i).ι ≫ f = φ.hom ≫ g) → (∀ i, ((U i : Set X) ∩ U i₀).Nonempty) → GeometricallyIrreducible f :=
by
  intro K _ X f ι U i₀ hcov hchart hmeet

  have s1 : ∀ {T : Type u} [TopologicalSpace T] (V : ι → Set T),
      (∀ i, IsOpen (V i)) → (∀ i, IsIrreducible (V i)) → (⋃ i, V i) = Set.univ →
      (∀ i, (V i ∩ V i₀).Nonempty) → IrreducibleSpace T := by
    intro T _ V hopen hirr hcov' hmeet'
    have hC : closure (V i₀) = Set.univ := by
      apply Set.eq_univ_of_forall
      intro z
      have hz : z ∈ ⋃ i, V i := by rw [hcov']; trivial
      obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hz
      rw [mem_closure_iff]
      intro o ho hzo
      obtain ⟨w, _, hwo, hw0⟩ :=
        (hirr i).isPreirreducible o (V i₀) ho (hopen i₀) ⟨z, hi, hzo⟩ (hmeet' i)
      exact ⟨w, hwo, hw0⟩
    have hI := (hirr i₀).closure
    rw [hC] at hI
    exact (irreducibleSpace_def T).mpr hI
  rw [geometricallyIrreducible_iff]
  intro L _ y P' fst snd h

  have hysurj : Surjective y := by
    constructor
    intro p
    obtain ⟨q⟩ := (inferInstance : Nonempty (Spec (.of L)))
    exact ⟨q, Subsingleton.elim _ _⟩
  have hfst : Surjective fst := MorphismProperty.of_isPullback h.flip hysurj

  have s3 : ∀ i, IsIrreducible ((fst ⁻¹ᵁ U i : P'.Opens) : Set P') := by
    intro i
    obtain ⟨Z, g, hg, φ, hφ⟩ := hchart i
    have h1 := isPullback_morphismRestrict fst (U i)
    have h2 := h1.paste_vert h
    have h3 : IsPullback (fst ∣_ U i ≫ φ.hom) ((fst ⁻¹ᵁ U i).ι ≫ snd) g y :=
      IsPullback.of_iso h2 (Iso.refl _) φ (Iso.refl _) (Iso.refl _)
        (by simp) (by simp) (by rw [Iso.refl_hom, Category.comp_id]; exact hφ) (by simp)
    have hgi := (geometricallyIrreducible_iff g).mp hg
    have h4 := hgi y _ _ h3
    have h5 := (IrreducibleSpace.isIrreducible_univ (X := (fst ⁻¹ᵁ U i : Scheme))).image _
      (fst ⁻¹ᵁ U i).ι.continuous.continuousOn
    rwa [Set.image_univ, Scheme.Opens.range_ι] at h5

  apply s1 (fun i => ((fst ⁻¹ᵁ U i : P'.Opens) : Set P'))
  · intro i
    exact (fst ⁻¹ᵁ U i).isOpen
  · exact s3
  · apply Set.eq_univ_of_forall
    intro z
    have hz : fst z ∈ (⨆ i, U i) := by rw [hcov]; trivial
    obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hz
    exact Set.mem_iUnion.mpr ⟨i, hi⟩
  · intro i
    obtain ⟨x, hx1, hx2⟩ := hmeet i
    obtain ⟨z, rfl⟩ := hfst.surj x
    exact ⟨z, hx1, hx2⟩

theorem wc_pp_rational_point : ∀ (K : Type u) [Field K] (m : ℕ), ∃ pt : Spec (.of K) ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) MvPolynomial.gradedAlgebra, pt ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0))) = 𝟙 _ ∧ ∀ a : Fin (m + 1), pt ⁻¹ᵁ (@Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) MvPolynomial.gradedAlgebra (MvPolynomial.X a)) = ⊤ :=
by
  intro K _ m
  letI := (MvPolynomial.gradedAlgebra :
    GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K))
  let f : MvPolynomial (Fin (m + 1)) K →+* Γ(Spec (CommRingCat.of K), ⊤) :=
    (Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom.comp (MvPolynomial.eval (fun _ => (1 : K)))
  have f1 : ∀ a, f (MvPolynomial.X a) = 1 := by
    intro a
    show (Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom
      (MvPolynomial.eval (fun _ => (1 : K)) (MvPolynomial.X a)) = 1
    rw [MvPolynomial.eval_X, map_one]
  have f2 : ∀ c : K, f (MvPolynomial.C c) = (Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom c := by
    intro c
    show (Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom
      (MvPolynomial.eval (fun _ => (1 : K)) (MvPolynomial.C c)) = _
    rw [MvPolynomial.eval_C]
  have hX0 : MvPolynomial.X (0 : Fin (m + 1)) ∈
      HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) := by
    rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
    exact DirectSum.decompose_of_mem_ne _
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K 0))
      one_ne_zero
  have hf : Ideal.map f
      (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)).toIdeal
      = ⊤ := by
    apply Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_map_of_mem f hX0)
    rw [f1]
    exact isUnit_one
  refine ⟨Proj.fromOfGlobalSections _ f hf, ?_, ?_⟩
  · have hkey : (f.comp (algebraMap ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0)
          (MvPolynomial (Fin (m + 1)) K))).comp
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0)) =
        (Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom := by
      apply RingHom.ext
      intro c
      rw [RingHom.comp_apply, RingHom.comp_apply, SetLike.GradeZero.algebraMap_apply,
        SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq, f2]
    rw [← Category.assoc, Proj.fromOfGlobalSections_toSpecZero, Category.assoc, ← Spec.map_comp,
      ← CommRingCat.ofHom_comp, hkey, CommRingCat.ofHom_hom]
    exact toSpecΓ_SpecMap_ΓSpecIso_inv _
  · intro a
    rw [Proj.fromOfGlobalSections_preimage_basicOpen _ f hf zero_lt_one
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K a))]
    exact Scheme.basicOpen_of_isUnit _ (by rw [f1]; exact isUnit_one)

theorem wc_int_ext_separated_of_finite : ∀ (S : Scheme.{u})
    (P : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)],
    (∀ n k : ℕ, Finite (Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ n))) k)) →
    ∀ (i : ℕ) (x : Abelian.Ext P (wcIntSheaf S ℓ) i),
      (∀ n : ℕ, x.comp (Abelian.Ext.mk₀ (Limits.cokernel.π (wcIntScalar S ℓ ((ℓ : ℤ_[ℓ]) ^ n))))
        (add_zero i) = 0) → x = 0 :=
by
  intro S P ℓ _ hfin
  classical
  have hℓpos : (0 : ℝ) < (ℓ : ℝ) := by exact_mod_cast (Fact.out : Nat.Prime ℓ).pos
  have hcongr : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B] (φ φ' : A →+ B)
      (e : φ = φ') (hφ : Continuous φ) (hφ' : Continuous φ'),
      wcContSheafMap S φ hφ = wcContSheafMap S φ' hφ' := by
    intro A B _ _ _ _ _ _ φ φ' e hφ hφ'
    subst e
    rfl



  have hlim1 : ∀ (k : ℕ) (w : ∀ n, Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ n))) k),
      ∃ v : ∀ n, Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ n))) k,
      ∀ n, w n = v n - (v (n + 1)).comp (Abelian.Ext.mk₀
        (wcContSheafMap S (wcTowerCast ℓ n) continuous_of_discreteTopology)) (add_zero k) := by
    intro k w
    let E : ℕ → Type (u+1) := fun n => Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ n))) k
    obtain ⟨s, hs⟩ := @nonempty_sections_of_finite_inverse_system ℕ _ _
      (Functor.ofOpSequence (X := E)
        (fun n => TypeCat.ofHom (fun a => w n + a.comp (Abelian.Ext.mk₀
          (wcContSheafMap S (wcTowerCast ℓ n) continuous_of_discreteTopology)) (add_zero k))))
      (fun j => hfin j.unop k) (fun j => ⟨(0 : E j.unop)⟩)
    refine ⟨fun n => (s (Opposite.op n) : E n), fun n => ?_⟩
    have h1 := hs (homOfLE (Nat.le_succ n)).op
    rw [Functor.ofOpSequence_map_homOfLE_succ] at h1
    exact eq_sub_of_add_eq h1



  obtain ⟨hcont_incl, hemb_incl, hcont_shift, hker, hsec⟩ := wc_padic_tower_facts ℓ
  obtain ⟨hz2, hS2⟩ := wc_contSheaf_shortExact S (wcTowerIncl ℓ) hcont_incl
    (wcTowerShift ℓ) hcont_shift hemb_incl hker hsec
  haveI := wc_proet_products_exact S
  have hY := (wc_contSheaf_pi_isLimit S (fun n => ZMod (ℓ ^ n))).some
  have hprod := fun N => wc_ext_prod_bijective P
    (wcContSheaf S ((n : ℕ) → ZMod (ℓ ^ n))) (fun n => wcContSheaf S (ZMod (ℓ ^ n)))
    (fun n => wcContSheafMap S (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n)
      (continuous_apply n)) hY N
  have hTn : ∀ n, wcContSheafMap S (wcTowerShift ℓ) hcont_shift ≫
      wcContSheafMap S (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n) =
      wcContSheafMap S (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n) -
      wcContSheafMap S (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1))
        (continuous_apply (n + 1)) ≫
      wcContSheafMap S (wcTowerCast ℓ n) continuous_of_discreteTopology := by
    intro n
    have e1 := (wc_contSheafMap_comp_sub S (wcTowerShift ℓ) (wcTowerShift ℓ) hcont_shift
      hcont_shift (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n)).1
    have e2 := (wc_contSheafMap_comp_sub S
      (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1))
      (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1)) (continuous_apply (n + 1))
      (continuous_apply (n + 1)) (wcTowerCast ℓ n) continuous_of_discreteTopology).1
    have e3 := (wc_contSheafMap_comp_sub S
      (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n)
      ((wcTowerCast ℓ n).comp (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1)))
      (continuous_apply n)
      ((continuous_of_discreteTopology (f := ⇑(wcTowerCast ℓ n))).comp (continuous_apply (n + 1)))
      (AddMonoidHom.id (ZMod (ℓ ^ n))) continuous_id).2
    rw [← e1, ← e2, ← e3]
    exact hcongr _ _ (AddMonoidHom.ext fun a => rfl) _ _



  intro i x hx
  have hE : wcIntSheaf S ℓ = wcContSheaf S ℤ_[ℓ] := rfl
  let x' : Abelian.Ext P (wcContSheaf S ℤ_[ℓ]) i :=
    x.comp (Abelian.Ext.mk₀ (eqToHom hE)) (add_zero i)
  have hred : ∀ n, x'.comp (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerIncl ℓ) hcont_incl ≫
      wcContSheafMap S (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n)))
      (add_zero i) = 0 := by
    intro n
    have hρc : Continuous (PadicInt.toZModPow (p := ℓ) n) := by
      rw [continuous_discrete_rng]
      intro b
      rw [Metric.isOpen_iff]
      intro y hy
      refine ⟨(ℓ : ℝ) ^ (-(n : ℤ)), zpow_pos hℓpos _, ?_⟩
      intro z hz
      rw [Metric.mem_ball, dist_eq_norm] at hz
      have h1 : z - y ∈ Ideal.span {(ℓ : ℤ_[ℓ]) ^ n} :=
        (PadicInt.norm_le_pow_iff_mem_span_pow _ _).mp hz.le
      rw [← PadicInt.ker_toZModPow, RingHom.mem_ker, map_sub, sub_eq_zero] at h1
      simp only [Set.mem_preimage, Set.mem_singleton_iff] at hy ⊢
      rw [h1, hy]
    let red := wcContSheafMap S (PadicInt.toZModPow (p := ℓ) n).toAddMonoidHom hρc
    have e1 : wcContSheafMap S (wcTowerIncl ℓ) hcont_incl ≫
        wcContSheafMap S (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n) =
        red := by
      rw [← (wc_contSheafMap_comp_sub S (wcTowerIncl ℓ) (wcTowerIncl ℓ) hcont_incl hcont_incl
        (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n)).1]
      exact hcongr _ _ (AddMonoidHom.ext fun a => rfl) _ _
    let red' := eqToHom hE ≫ red
    have hw : wcIntScalar S ℓ ((ℓ : ℤ_[ℓ]) ^ n) ≫ red' = 0 := by
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext U
      apply AddCommGrpCat.ext
      intro y
      apply ULift.ext
      apply ContinuousMap.ext
      intro t
      change PadicInt.toZModPow n ((ℓ : ℤ_[ℓ]) ^ n * (ULift.down y :
        C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), ℤ_[ℓ])) t) = 0
      rw [map_mul, map_pow, map_natCast, ← Nat.cast_pow, ZMod.natCast_self, zero_mul]
    have key : eqToHom hE ≫ (wcContSheafMap S (wcTowerIncl ℓ) hcont_incl ≫
        wcContSheafMap S (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n)) =
        Limits.cokernel.π (wcIntScalar S ℓ ((ℓ : ℤ_[ℓ]) ^ n)) ≫
          Limits.cokernel.desc _ red' hw := by
      rw [Limits.cokernel.π_desc, e1]
    change (x.comp (Abelian.Ext.mk₀ (eqToHom hE)) (add_zero i)).comp
      (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerIncl ℓ) hcont_incl ≫
        wcContSheafMap S (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n)))
      (add_zero i) = 0
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, key, ← Abelian.Ext.mk₀_comp_mk₀,
      ← Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega), hx n,
      Abelian.Ext.zero_comp]
  have hxf : x'.comp (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerIncl ℓ) hcont_incl))
      (add_zero i) = 0 := by
    apply (hprod i).1
    intro n
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀]
    exact hred n

  have hback : x = x'.comp (Abelian.Ext.mk₀ (eqToHom hE.symm)) (add_zero i) := by
    change x = (x.comp (Abelian.Ext.mk₀ (eqToHom hE)) (add_zero i)).comp
      (Abelian.Ext.mk₀ (eqToHom hE.symm)) (add_zero i)
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, eqToHom_trans, eqToHom_refl, Abelian.Ext.comp_mk₀_id]
  suffices hx0 : x' = 0 by
    rw [hback, hx0, Abelian.Ext.zero_comp]



  have hsubmk : ∀ {A B : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (a b : A ⟶ B),
      Abelian.Ext.mk₀ (a - b) = Abelian.Ext.mk₀ a - Abelian.Ext.mk₀ b := by
    intro A B a b
    rw [sub_eq_add_neg, Abelian.Ext.mk₀_add, Abelian.Ext.mk₀_neg, ← sub_eq_add_neg]
  have hcompsub : ∀ {A B C : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} {p : ℕ}
      (α : Abelian.Ext A B p) (β₁ β₂ : Abelian.Ext B C 0),
      α.comp (β₁ - β₂) (add_zero p) = α.comp β₁ (add_zero p) - α.comp β₂ (add_zero p) := by
    intro A B C p α β₁ β₂
    rw [sub_eq_add_neg, Abelian.Ext.comp_add, Abelian.Ext.comp_neg, ← sub_eq_add_neg]
  clear_value x'
  clear hback hred hx
  cases i with
  | zero =>
    haveI : Mono (wcContSheafMap S (wcTowerIncl ℓ) hcont_incl) := hS2.mono_f
    apply Abelian.Ext.postcomp_mk₀_injective_of_mono P
      (wcContSheafMap S (wcTowerIncl ℓ) hcont_incl)
    rw [map_zero]
    exact hxf
  | succ k =>
    obtain ⟨z, hz⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hS2 x' hxf (n₀ := k) rfl
    obtain ⟨v, hv⟩ := hlim1 k (fun n => z.comp (Abelian.Ext.mk₀
      (wcContSheafMap S (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n)))
      (add_zero k))
    have hv' : ∀ n, z.comp (Abelian.Ext.mk₀
        (wcContSheafMap S (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n)))
        (add_zero k) = v n - (v (n + 1)).comp (Abelian.Ext.mk₀
          (wcContSheafMap S (wcTowerCast ℓ n) continuous_of_discreteTopology)) (add_zero k) := hv
    obtain ⟨W, hW⟩ := (hprod k).2 v
    have hWg : W.comp (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerShift ℓ) hcont_shift))
        (add_zero k) = z := by
      rw [← sub_eq_zero]
      apply (hprod k).1
      intro n
      have hpost : ∀ (a b : Abelian.Ext P (wcContSheaf S ((n : ℕ) → ZMod (ℓ ^ n))) k),
          (a - b).comp (Abelian.Ext.mk₀ (wcContSheafMap S
            (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n))) (add_zero k) =
          a.comp (Abelian.Ext.mk₀ (wcContSheafMap S
            (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n))) (add_zero k) -
          b.comp (Abelian.Ext.mk₀ (wcContSheafMap S
            (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n))) (add_zero k) := by
        intro a b
        rw [sub_eq_add_neg, Abelian.Ext.add_comp, Abelian.Ext.neg_comp, ← sub_eq_add_neg]
      rw [hpost, Abelian.Ext.comp_assoc _ _ _ (add_zero k) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, hTn n, hsubmk, hcompsub, ← Abelian.Ext.mk₀_comp_mk₀,
        ← Abelian.Ext.comp_assoc _ _ _ (add_zero k) (add_zero 0) (by omega), hW, hW, hv' n,
        sub_self]
    have hce : (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerShift ℓ) hcont_shift)).comp
        hS2.extClass (zero_add 1) = 0 := hS2.comp_extClass
    rw [← hz, ← hWg, Abelian.Ext.comp_assoc _ _ _ (add_zero k) (zero_add 1) (by omega), hce,
      Abelian.Ext.comp_zero]

theorem wc_punct_K_top_line (F : Type u) [Finite F] [Field F] (d ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F) (hd : 1 ≤ d)
    (OK : (wcTlAff F d).Opens) (hOK : (OK : Set ↥(wcTlAff F d)) = (Set.range (wcTlZero F d))ᶜ) :
    ∃ ω : wcHM OK.toScheme ℓ (2 * d - 1),
      Function.Bijective (fun c : ℚ_[ℓ] => wcHMScalar OK.toScheme ℓ (2 * d - 1) c ω) :=
by
  classical

  have hℓF : ((ℓ : ℕ) : F) ≠ 0 := by
    intro h0
    haveI : Fact (Nat.Prime (ringChar F)) := ⟨CharP.char_is_prime F (ringChar F)⟩
    have h1 : ringChar F ∣ ℓ := (ringChar.spec F ℓ).mp h0
    have h2 : ringChar F = ℓ :=
      (Nat.prime_dvd_prime_iff_eq (Fact.out : Nat.Prime (ringChar F)) Fact.out).mp h1
    letI := Fintype.ofFinite F
    have h3 : ((Fintype.card F : ℕ) : F) = 0 := FiniteField.cast_card_eq_zero F
    have h4 : ringChar F ∣ Fintype.card F := (ringChar.spec F _).mp h3
    apply hℓ
    rw [← h2, Nat.card_eq_fintype_card]
    exact h4
  have hℓK : ((ℓ : ℕ) : AlgebraicClosure F) ≠ 0 := by
    rw [← map_natCast (algebraMap F (AlgebraicClosure F))]
    exact (map_ne_zero (algebraMap F (AlgebraicClosure F))).mpr hℓF
  obtain ⟨q, hP, hz⟩ := wc_affine_space_ulift_mvpoly_zero_pullback (AlgebraicClosure F)
    (Spec (.of (AlgebraicClosure F))) (𝟙 _) d
  haveI : IsIso q := hP.isIso_snd_of_isIso
  haveI : IsLocallyNoetherian (wcTlAff F d) := isLocallyNoetherian_of_isOpenImmersion q
  haveI : CompactSpace ↥OK.toScheme := QuasiCompact.compactSpace_of_compactSpace OK.ι
  haveI : QuasiSeparatedSpace ↥OK.toScheme := quasiSeparatedSpace_of_quasiSeparated OK.ι
  haveI : IsSeparated (Limits.terminal.from OK.toScheme) := by
    rw [show Limits.terminal.from OK.toScheme = OK.ι ≫ Limits.terminal.from (wcTlAff F d) from
      Limits.terminal.hom_ext _ _]
    infer_instance
  have hrc : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z),
      Set.range (f ≫ g) = g '' Set.range f := by
    intro X Y Z f g
    ext y
    constructor
    · rintro ⟨x, rfl⟩
      exact ⟨f x, ⟨x, rfl⟩, (Scheme.Hom.comp_apply f g x).symm⟩
    · rintro ⟨_, ⟨x, rfl⟩, rfl⟩
      exact ⟨x, Scheme.Hom.comp_apply f g x⟩

  have htop : Finite (wcEtCoh OK.toScheme ℓ (2 * d - 1)) ∧
      Nat.card (wcEtCoh OK.toScheme ℓ (2 * d - 1)) ≤ ℓ := by
    let f : OK.toScheme ⟶ Spec (.of (MvPolynomial (Fin d) (AlgebraicClosure F))) := OK.ι ≫ q
    have hb : Function.Bijective q := (Scheme.Hom.homeomorph q).bijective
    have hU₀ : ((Scheme.Hom.opensRange f : (Spec (.of (MvPolynomial (Fin d) (AlgebraicClosure F)))).Opens) :
        Set (Spec (.of (MvPolynomial (Fin d) (AlgebraicClosure F))))) =
        (Set.range (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff :
          MvPolynomial (Fin d) (AlgebraicClosure F) →+* AlgebraicClosure F))))ᶜ := by
      rw [Scheme.Hom.coe_opensRange]
      calc Set.range ⇑f = q '' Set.range OK.ι := hrc OK.ι q
        _ = q '' (Set.range (wcTlZero F d))ᶜ := by rw [Scheme.Opens.range_ι, hOK]
        _ = (q '' Set.range (wcTlZero F d))ᶜ := Set.image_compl_eq hb
        _ = (Set.range (wcTlZero F d ≫ q))ᶜ := by rw [hrc]
        _ = _ := by rw [show wcTlZero F d ≫ q = _ from hz, Category.id_comp]
    obtain ⟨hfin, hcard⟩ := wc_et_punctured_affine_coh_card_le (AlgebraicClosure F) d hd ℓ Fact.out
      hℓK (Scheme.Hom.opensRange f) hU₀
    obtain ⟨e⟩ := wc_et_coh_iso_invariance (Scheme.Hom.isoOpensRange f).hom ℓ (2 * d - 1)
    haveI := hfin
    refine ⟨Finite.of_equiv _ e, ?_⟩
    rw [← Nat.card_congr e]
    exact hcard
  have hstar : ∀ j : ℕ, Finite (wcEtCoh OK.toScheme ℓ j) := by
    intro j
    have h1 := wc_punct_K_zmod_coh_finite F d ℓ hℓ hd OK hOK 1 j le_rfl
    rw [pow_one] at h1
    obtain ⟨Θ, hΘ, -⟩ := wc_zmod_et_proet_natural_comparison_all ℓ j
    haveI := h1
    haveI : Finite (wcEtZModExt OK.toScheme ℓ j) :=
      Finite.of_injective _ (hΘ OK.toScheme inferInstance inferInstance).1
    obtain ⟨e⟩ := wc_et_zmodext_coh_equiv OK.toScheme ℓ j
    exact Finite.of_equiv _ e
  have hfinall : ∀ k j : ℕ, Finite (wcEtCoh OK.toScheme (ℓ ^ k) j) := by
    intro k j
    refine wc_et_coh_coeff_devissage OK.toScheme (ℓ ^ k)
      (pow_ne_zero _ (Nat.Prime.ne_zero Fact.out)) ?_ j
    intro p hp hpd i
    have hpl : p = ℓ := (Nat.prime_dvd_prime_iff_eq hp Fact.out).mp (hp.dvd_of_dvd_pow hpd)
    rw [hpl]
    exact hstar i

  have hE : ∀ m i : ℕ, Nonempty (Abelian.Ext (wcFreeSheaf OK.toScheme (Scheme.ProEt.mk (𝟙 OK.toScheme)))
      (wcZModSheaf OK.toScheme m) i ≃ wcEtCoh OK.toScheme m i) := by
    intro m i
    obtain ⟨-, hcont⟩ := wc_etToProEt_flat_cont OK.toScheme
    haveI := hcont
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology OK.toScheme) AddCommGrpCat.{u+1}) :=
      HasExt.standard _
    obtain ⟨E₀⟩ := wc_proet_etale_comparison_epsInv_qcsep OK.toScheme
      ((constantSheaf (Scheme.smallEtaleTopology OK.toScheme) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) i
    let χ : (wcEpsInv OK.toScheme).obj ((constantSheaf (Scheme.smallEtaleTopology OK.toScheme)
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) ≅
        wcZModSheaf OK.toScheme m :=
      (wc_epsInv_const OK.toScheme (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).some ≪≫
        (wc_zmod_sheaf_const OK.toScheme m).some.symm
    let E₂ : Abelian.Ext (wcFreeSheaf OK.toScheme (Scheme.ProEt.mk (𝟙 OK.toScheme)))
          (wcZModSheaf OK.toScheme m) i ≃
        Abelian.Ext (wcFreeSheaf OK.toScheme (Scheme.ProEt.mk (𝟙 OK.toScheme)))
          ((wcEpsInv OK.toScheme).obj ((constantSheaf (Scheme.smallEtaleTopology OK.toScheme)
            AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) i :=
      { toFun := fun y => y.comp (Abelian.Ext.mk₀ χ.inv) (add_zero i)
        invFun := fun y => y.comp (Abelian.Ext.mk₀ χ.hom) (add_zero i)
        left_inv := fun y => by
          simp only
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
        right_inv := fun y => by
          simp only
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id] }
    let E : Abelian.Ext (wcFreeSheaf OK.toScheme (Scheme.ProEt.mk (𝟙 OK.toScheme)))
        (wcZModSheaf OK.toScheme m) i ≃ wcEtCoh OK.toScheme m i := E₂.trans E₀
    exact ⟨E⟩

  have hfinZ : ∀ e j : ℕ, Finite (Abelian.Ext (wcFreeSheaf OK.toScheme (Scheme.ProEt.mk (𝟙 OK.toScheme)))
      (wcContSheaf OK.toScheme (ZMod (ℓ ^ e))) j) := by
    intro e j
    obtain ⟨E⟩ := hE (ℓ ^ e) j
    haveI := hfinall e j
    have h : Finite (Abelian.Ext (wcFreeSheaf OK.toScheme (Scheme.ProEt.mk (𝟙 OK.toScheme)))
        (wcZModSheaf OK.toScheme (ℓ ^ e)) j) := Finite.of_equiv _ E.symm
    exact h
  have hsep := wc_int_ext_separated_of_finite OK.toScheme
    (wcFreeSheaf OK.toScheme (Scheme.ProEt.mk (𝟙 OK.toScheme))) ℓ hfinZ (2 * d - 1)
  have hG : Finite (Abelian.Ext (wcFreeSheaf OK.toScheme (Scheme.ProEt.mk (𝟙 OK.toScheme)))
        (Limits.cokernel (wcIntScalar OK.toScheme ℓ (ℓ : ℤ_[ℓ]))) (2 * d - 1)) ∧
      Nat.card (Abelian.Ext (wcFreeSheaf OK.toScheme (Scheme.ProEt.mk (𝟙 OK.toScheme)))
        (Limits.cokernel (wcIntScalar OK.toScheme ℓ (ℓ : ℤ_[ℓ]))) (2 * d - 1)) ≤ ℓ := by
    have e0 := wc_int_coker_zmod OK.toScheme ℓ 1 (ℓ : ℤ_[ℓ]) (pow_one _).symm
    rw [pow_one] at e0
    obtain ⟨e⟩ := e0
    let E₁ : Abelian.Ext (wcFreeSheaf OK.toScheme (Scheme.ProEt.mk (𝟙 OK.toScheme)))
        (Limits.cokernel (wcIntScalar OK.toScheme ℓ (ℓ : ℤ_[ℓ]))) (2 * d - 1) ≃
        Abelian.Ext (wcFreeSheaf OK.toScheme (Scheme.ProEt.mk (𝟙 OK.toScheme)))
          (wcZModSheaf OK.toScheme ℓ) (2 * d - 1) :=
      { toFun := fun x => x.comp (Abelian.Ext.mk₀ e.hom) (add_zero (2 * d - 1))
        invFun := fun y => y.comp (Abelian.Ext.mk₀ e.inv) (add_zero (2 * d - 1))
        left_inv := fun x => by
          simp only
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero (2 * d - 1)) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
        right_inv := fun y => by
          simp only
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero (2 * d - 1)) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id] }
    obtain ⟨E₃⟩ := hE ℓ (2 * d - 1)
    obtain ⟨hfin, hcard⟩ := htop
    let E := E₁.trans E₃
    haveI := hfin
    refine ⟨Finite.of_equiv _ E.symm, ?_⟩
    rw [Nat.card_congr E]
    exact hcard
  haveI hcpt : CompactSpace ↥(Scheme.ProEt.mk (𝟙 OK.toScheme)).left :=
    (inferInstance : CompactSpace ↥OK.toScheme)
  haveI hqs : QuasiSeparatedSpace ↥(Scheme.ProEt.mk (𝟙 OK.toScheme)).left :=
    (inferInstance : QuasiSeparatedSpace ↥OK.toScheme)
  have hden := (proet_qcqs_ladic_rationalization OK.toScheme (Scheme.ProEt.mk (𝟙 OK.toScheme)) ℓ
    (2 * d - 1)).1

  have descent : ∀ i : ℕ,
      Finite (Abelian.Ext (wcFreeSheaf OK.toScheme (Scheme.ProEt.mk (𝟙 OK.toScheme)))
        (Limits.cokernel (wcIntScalar OK.toScheme ℓ (ℓ : ℤ_[ℓ]))) i) →
      Nat.card (Abelian.Ext (wcFreeSheaf OK.toScheme (Scheme.ProEt.mk (𝟙 OK.toScheme)))
        (Limits.cokernel (wcIntScalar OK.toScheme ℓ (ℓ : ℤ_[ℓ]))) i) ≤ ℓ →
      (∀ x : Abelian.Ext (wcFreeSheaf OK.toScheme (Scheme.ProEt.mk (𝟙 OK.toScheme)))
          (wcIntSheaf OK.toScheme ℓ) i,
        (∀ e : ℕ, x.comp (Abelian.Ext.mk₀
          (Limits.cokernel.π (wcIntScalar OK.toScheme ℓ ((ℓ : ℤ_[ℓ]) ^ e)))) (add_zero i) = 0) →
          x = 0) →
      (∀ x : Abelian.Ext (wcFreeSheaf OK.toScheme (Scheme.ProEt.mk (𝟙 OK.toScheme)))
          (wcLadicSheaf OK.toScheme ℓ) i,
        ∃ (e : ℕ) (y : Abelian.Ext (wcFreeSheaf OK.toScheme (Scheme.ProEt.mk (𝟙 OK.toScheme)))
            (wcIntSheaf OK.toScheme ℓ) i),
          ℓ ^ e • x = y.comp (Abelian.Ext.mk₀ (wcIntToLadic OK.toScheme ℓ)) (add_zero i)) →
      ∃ ηV : Abelian.Ext (wcFreeSheaf OK.toScheme (Scheme.ProEt.mk (𝟙 OK.toScheme)))
          (wcLadicSheaf OK.toScheme ℓ) i →+ ℚ_[ℓ],
        Function.Injective ηV ∧
        ∀ (c : ℚ_[ℓ]) (x : Abelian.Ext (wcFreeSheaf OK.toScheme (Scheme.ProEt.mk (𝟙 OK.toScheme)))
            (wcLadicSheaf OK.toScheme ℓ) i),
          ηV (x.comp (Abelian.Ext.mk₀ (wcLadicScalar OK.toScheme ℓ c)) (add_zero i)) = c * ηV x := by
    intro i hGfin hGcard hsepi hdeni
    haveI := hGfin
    have s4 : ∀ (R : Type) [Ring R] (G : Sheaf (Scheme.ProEt.topology OK.toScheme) AddCommGrpCat.{u+1})
        (s : R → (G ⟶ G)), s 1 = 𝟙 G → (∀ a b, s (a * b) = s b ≫ s a) →
        (∀ a b, s (a + b) = s a + s b) →
        (∀ x : Abelian.Ext (wcFreeSheaf OK.toScheme (Scheme.ProEt.mk (𝟙 OK.toScheme))) G i,
            x.comp (Abelian.Ext.mk₀ (s 1)) (add_zero i) = x) ∧
        (∀ a b (x : Abelian.Ext (wcFreeSheaf OK.toScheme (Scheme.ProEt.mk (𝟙 OK.toScheme))) G i),
            x.comp (Abelian.Ext.mk₀ (s (a * b))) (add_zero i) =
            (x.comp (Abelian.Ext.mk₀ (s b)) (add_zero i)).comp (Abelian.Ext.mk₀ (s a))
              (add_zero i)) ∧
        (∀ a b (x : Abelian.Ext (wcFreeSheaf OK.toScheme (Scheme.ProEt.mk (𝟙 OK.toScheme))) G i),
            x.comp (Abelian.Ext.mk₀ (s (a + b))) (add_zero i) =
            x.comp (Abelian.Ext.mk₀ (s a)) (add_zero i) +
              x.comp (Abelian.Ext.mk₀ (s b)) (add_zero i)) := by
      intro R _ G s h1 hmul hadd
      refine ⟨fun x => ?_, fun a b x => ?_, fun a b x => ?_⟩
      · rw [h1, Abelian.Ext.comp_mk₀_id]
      · rw [hmul, ← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc _ _ _ (add_zero i)
          (add_zero 0) (by omega)]
      · rw [hadd, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add]
    obtain ⟨hs1, hsmul, hsadd, hscomm⟩ := wc_int_scalar_ring OK.toScheme ℓ
    obtain ⟨hq1, hqmul, hqadd⟩ := wc_ladic_scalar_ring OK.toScheme ℓ
    let M := Abelian.Ext (wcFreeSheaf OK.toScheme (Scheme.ProEt.mk (𝟙 OK.toScheme)))
      (wcIntSheaf OK.toScheme ℓ) i
    letI smulM : SMul ℤ_[ℓ] M :=
      ⟨fun a m => m.comp (Abelian.Ext.mk₀ (wcIntScalar OK.toScheme ℓ a)) (add_zero i)⟩
    obtain ⟨A1, Amul, Aadd⟩ := s4 ℤ_[ℓ] (wcIntSheaf OK.toScheme ℓ) (wcIntScalar OK.toScheme ℓ)
      hs1 hsmul hsadd
    letI modM : Module ℤ_[ℓ] M := Module.ofMinimalAxioms
      (fun a x y => Abelian.Ext.add_comp x y _ _)
      (fun a b x => Aadd a b x)
      (fun a b x => Amul a b x)
      (fun x => A1 x)
    let V := Abelian.Ext (wcFreeSheaf OK.toScheme (Scheme.ProEt.mk (𝟙 OK.toScheme)))
      (wcLadicSheaf OK.toScheme ℓ) i
    letI smulV : SMul ℚ_[ℓ] V :=
      ⟨fun c x => x.comp (Abelian.Ext.mk₀ (wcLadicScalar OK.toScheme ℓ c)) (add_zero i)⟩
    obtain ⟨B1, Bmul, Badd⟩ := s4 ℚ_[ℓ] (wcLadicSheaf OK.toScheme ℓ) (wcLadicScalar OK.toScheme ℓ)
      hq1 hqmul hqadd
    letI modV : Module ℚ_[ℓ] V := Module.ofMinimalAxioms
      (fun a x y => Abelian.Ext.add_comp x y _ _)
      (fun a b x => Badd a b x)
      (fun a b x => Bmul a b x)
      (fun x => B1 x)
    haveI hmono : Mono (wcIntScalar OK.toScheme ℓ (ℓ : ℤ_[ℓ])) := wc_int_scalar_ell_mono OK.toScheme ℓ
    let f := wcIntScalar OK.toScheme ℓ (ℓ : ℤ_[ℓ])
    let S : ShortComplex (Sheaf (Scheme.ProEt.topology OK.toScheme) AddCommGrpCat.{u+1}) :=
      ShortComplex.mk f (Limits.cokernel.π f) (Limits.cokernel.condition f)
    have hS : S.ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel f) hmono inferInstance
    let β : M →+ Abelian.Ext (wcFreeSheaf OK.toScheme (Scheme.ProEt.mk (𝟙 OK.toScheme)))
        (Limits.cokernel f) i :=
      (Abelian.Ext.mk₀ (Limits.cokernel.π f)).postcomp
        (wcFreeSheaf OK.toScheme (Scheme.ProEt.mk (𝟙 OK.toScheme))) (add_zero i)
    have hβtors : ∀ m : M, ℓ • β m = 0 := by
      intro m
      rw [← map_nsmul, ← Nat.cast_smul_eq_nsmul ℤ_[ℓ] ℓ m]
      change ((m.comp (Abelian.Ext.mk₀ f) (add_zero i)).comp
        (Abelian.Ext.mk₀ (Limits.cokernel.π f)) (add_zero i)) = 0
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Limits.cokernel.condition, Abelian.Ext.mk₀_zero,
        Abelian.Ext.comp_zero]
    obtain ⟨m₀, hm₀⟩ : ∃ m₀ : M, ∀ m, ∃ k : ℤ, β m = k • β m₀ := by
      by_cases hall : ∀ m, β m = 0
      · exact ⟨0, fun m => ⟨0, by rw [hall m, zero_zsmul]⟩⟩
      · push_neg at hall
        obtain ⟨m₀, hm₀⟩ := hall
        refine ⟨m₀, fun m => ?_⟩
        have hord : addOrderOf (β m₀) = ℓ := addOrderOf_eq_prime (hβtors m₀) hm₀
        have htop' : AddSubgroup.zmultiples (β m₀) = ⊤ := by
          apply AddSubgroup.eq_top_of_le_card
          rw [Nat.card_zmultiples, hord]
          exact hGcard
        have hmem : β m ∈ AddSubgroup.zmultiples (β m₀) := by
          rw [htop']; exact AddSubgroup.mem_top _
        obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.mp hmem
        exact ⟨k, hk.symm⟩
    have hdecomp : ∀ m : M, ∃ (k : ℤ) (m' : M), m = k • m₀ + (ℓ : ℤ_[ℓ]) • m' := by
      intro m
      obtain ⟨k, hk⟩ := hm₀ m
      have h0 : (m - k • m₀).comp (Abelian.Ext.mk₀ S.g) (add_zero i) = 0 := by
        change β (m - k • m₀) = 0
        rw [map_sub, map_zsmul, hk, sub_self]
      obtain ⟨m', hm'⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hS (m - k • m₀) h0
      refine ⟨k, m', ?_⟩
      change m = k • m₀ + m'.comp (Abelian.Ext.mk₀ S.f) (add_zero i)
      rw [hm']
