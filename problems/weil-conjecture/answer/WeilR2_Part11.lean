    obtain ⟨V', e, he, h, x', hh, hx'⟩ :=
      wc_etale_lift_closed_immersion wc_etale_lift_quotient_alg i V.hom v
    exact ⟨MorphismProperty.Over.mk ⊤ e he, MorphismProperty.Over.homMk h hh trivial, x', hx'⟩
  obtain ⟨s₁, hs₁def⟩ : ∃ s₁ : (R.obj (I.cocomplex.X (2 * r))).val.obj
      (Opposite.op ((wcEtBaseChange i).obj W)),
      s₁ = ((R.obj (I.cocomplex.X (2 * r))).val.map hV.op).hom s := ⟨_, rfl⟩
  have hs₁ : ((R.map (I.cocomplex.d (2 * r) (2 * r + 1))).val.app
      (Opposite.op ((wcEtBaseChange i).obj W))).hom s₁ = 0 := by
    rw [hs₁def, PresheafOfModules.naturality_apply, hs']; exact map_zero _
  let DW : ∀ W : Y.Etale, wcEtPullData (Limits.pullback.fst W.hom i) ℓ :=
    fun W => (wc_et_zmod_pull_data_exists (Limits.pullback.fst W.hom i) ℓ).some
  obtain ⟨cl, P1, P2, P3, P4⟩ := wc_et_closed_rightAdj_cycle_class i ℓ D R adj I (2 * r) DW
  obtain ⟨y, hydef⟩ : ∃ y : (R.obj (I.cocomplex.X (2 * r))).val.obj
      (Opposite.op ((wcEtBaseChange i).obj W)),
      y = (cb.val.app (Opposite.op ((wcEtBaseChange i).obj W))).hom
        (1 : (wcEtZModRing Z ℓ).obj.obj (Opposite.op ((wcEtBaseChange i).obj W))) := ⟨_, rfl⟩
  have hyc : ((R.map (I.cocomplex.d (2 * r) (2 * r + 1))).val.app
      (Opposite.op ((wcEtBaseChange i).obj W))).hom y = 0 := by
    rw [hydef]; exact hy0 _

  haveI : Etale W.hom := W.prop
  haveI hWsm : SmoothOfRelativeDimension n (W.hom ≫ pY) := by
    have := smoothOfRelativeDimension_comp 0 n W.hom pY
    rwa [Nat.zero_add] at this
  haveI hZWsm : SmoothOfRelativeDimension (n - r) (Limits.pullback.fst W.hom i ≫ W.hom ≫ pY) := by
    rw [← Category.assoc, Limits.pullback.condition, Category.assoc, hnr]
    have := smoothOfRelativeDimension_comp 0 m (Limits.pullback.snd W.hom i) (i ≫ pY)
    rwa [Nat.zero_add] at this
  let EW : wcEtPullData W.hom ℓ := (wc_et_zmod_pull_data_exists W.hom ℓ).some
  obtain ⟨γW, hγW, -⟩ := wc_et_closed_supp_base_change i W.hom (Limits.pullback.fst W.hom i)
    (Limits.pullback.snd W.hom i) (IsPullback.of_hasPullback W.hom i).flip D EW (DW W)
  have hθW : wcEtIsThom T (W.hom ≫ pY) (DW W) r (wcEtSuppRestr D EW (DW W) γW (2 * r) θ) :=
    wc_et_thom_class_restrict K ℓ hℓ T hGL hNat pY (W.hom ≫ pY) W.hom rfl n n r i
      (Limits.pullback.fst W.hom i) hrn hrn (Limits.pullback.snd W.hom i)
      (IsPullback.of_hasPullback W.hom i).flip D EW (DW W) γW hγW θ hθ
  have hclW : cl W y = wcEtSuppRestr D EW (DW W) γW (2 * r) θ := by
    rw [hydef, hcb, P4 W EW γW hγW c hc]
    exact congrArg (fun z => wcEtSuppRestr D EW (DW W) γW (2 * r) z) hcθ
  obtain ⟨W', f, hf, ⟨w, hw⟩, k, H⟩ := LT K ℓ hℓ T hGL hNat hPt W.left (Limits.pullback W.hom i)
    (W.hom ≫ pY) n r (Limits.pullback.fst W.hom i) hrn (DW W)
    (wcEtSuppRestr D EW (DW W) γW (2 * r) θ) (cl W s₁) hθW x

  haveI := hf
  let W₂ : Y.Etale := MorphismProperty.Over.mk ⊤ (f ≫ W.hom) (by infer_instance)
  let h₂ : W₂ ⟶ W := MorphismProperty.Over.homMk f rfl trivial
  have hg1 : ((wcEtBaseChange i).map h₂).left ≫ Limits.pullback.fst W.hom i =
      Limits.pullback.fst W₂.hom i ≫ h₂.left := Limits.pullback.lift_fst _ _ _
  have hg2 : ((wcEtBaseChange i).map h₂).left ≫ Limits.pullback.snd W.hom i =
      Limits.pullback.snd W₂.hom i := Limits.pullback.lift_snd _ _ _
  have hw₂ : h₂.left ≫ W.hom = W₂.hom := MorphismProperty.Over.w h₂
  have hsq : IsPullback (((wcEtBaseChange i).map h₂).left ≫ Limits.pullback.snd W.hom i)
      (Limits.pullback.fst W₂.hom i) i (h₂.left ≫ W.hom) := by
    rw [hg2, hw₂]; exact (IsPullback.of_hasPullback W₂.hom i).flip
  have hP : IsPullback ((wcEtBaseChange i).map h₂).left (Limits.pullback.fst W₂.hom i)
      (Limits.pullback.fst W.hom i) h₂.left :=
    IsPullback.of_right hsq hg1 (IsPullback.of_hasPullback W.hom i).flip
  obtain ⟨t, ht⟩ : ∃ t : ↥(Limits.pullback W₂.hom i), ((wcEtBaseChange i).map h₂).left t = x := by
    obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := Limits.pullback.fst W.hom i)
      (g := h₂.left) x w hw.symm
    refine ⟨hP.isoPullback.inv z, ?_⟩
    have e := Scheme.Hom.comp_apply hP.isoPullback.inv ((wcEtBaseChange i).map h₂).left z
    rw [hP.isoPullback_inv_fst] at e
