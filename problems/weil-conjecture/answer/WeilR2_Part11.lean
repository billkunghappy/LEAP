  have C6 : ∀ {l l' : Λ} (t' : l ⟶ l'), IsAffineHom ((D₀ ⋙ wcEtBaseChange V.ι).map t').left := by
    intro l l' t'
    have := hAff l
    have := hAff l'
    have Rr : IsPullback (Limits.pullback.snd (D₀.obj l').hom V.ι)
        (Limits.pullback.fst (D₀.obj l').hom V.ι) V.ι (D₀.obj l').hom :=
