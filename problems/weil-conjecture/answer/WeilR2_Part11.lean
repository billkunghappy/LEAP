  obtain ⟨jA⟩ := wc_et_pull_data_comp_iso A.ι (Z.homOfLE (inf_le_left : A ⊓ B ≤ A)) (A ⊓ B).ι
    (Scheme.homOfLE_ι Z _) EA Da EC
  have hA := wc_et_extzero_transfer_natural ℓ A (A ⊓ B)
    (Z.homOfLE (inf_le_left : A ⊓ B ≤ A)) EA EC Da LA adjA LC adjC
    (𝟭 _) (Iso.refl _) (Functor.leftUnitor _ ≪≫ jA) u (mA _)
    (by
      rw [Functor.id_map, Iso.refl_hom]
      first
        | exact (congrArg (fun t => u ≫ t) (Category.comp_id _)).trans hu
        | simpa only [Functor.id_obj, Category.comp_id] using hu) n a₀
  rw [Abelian.Ext.id_mapExactFunctor, Iso.refl_hom, Abelian.Ext.comp_mk₀_id] at hA
  obtain ⟨jB⟩ := wc_et_pull_data_comp_iso B.ι (Z.homOfLE (inf_le_right : A ⊓ B ≤ B)) (A ⊓ B).ι
    (Scheme.homOfLE_ι Z _) EB Db EC
  have hB := wc_et_extzero_transfer_natural ℓ B (A ⊓ B)
    (Z.homOfLE (inf_le_right : A ⊓ B ≤ B)) EB EC Db LB adjB LC adjC
    (𝟭 _) (Iso.refl _) (Functor.leftUnitor _ ≪≫ jB) v (mB _)
    (by
      rw [Functor.id_map, Iso.refl_hom]
      first
        | exact (congrArg (fun t => v ≫ t) (Category.comp_id _)).trans hv
        | simpa only [Functor.id_obj, Category.comp_id] using hv) n b₀
  rw [Abelian.Ext.id_mapExactFunctor, Iso.refl_hom, Abelian.Ext.comp_mk₀_id] at hB
  have hfin : TC x = TC ((Abelian.Ext.mk₀ u).comp a₀ (zero_add n)) -
      TC ((Abelian.Ext.mk₀ v).comp b₀ (zero_add n)) := by
    rw [← map_sub, ← hK]
  rw [hTC ((Abelian.Ext.mk₀ u).comp a₀ (zero_add n)),
    hTC ((Abelian.Ext.mk₀ v).comp b₀ (zero_add n)), hA, hB] at hfin
  exact ⟨_, _, hfin⟩

theorem wc_et_mv_restr_kills_boundary : ∀ (ℓ n : ℕ) (Z : Scheme.{u}) (A B : Z.Opens) (δ₀ : wcEtZModExt ((A ⊓ B : Z.Opens) : Scheme.{u}) ℓ n →+ wcEtZModExt Z ℓ (n + 1)), (letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) := HasExt.standard _; letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing ((A ⊓ B : Z.Opens) : Scheme.{u}) ℓ)) := HasExt.standard _; ∃ (EA : wcEtPullData A.ι ℓ) (EB : wcEtPullData B.ι ℓ) (EC : wcEtPullData (A ⊓ B).ι ℓ) (LA : SheafOfModules.{u+1} (wcEtZModRing (A : Scheme.{u}) ℓ) ⥤ SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) (adjA : LA ⊣ EA.Φ) (LB : SheafOfModules.{u+1} (wcEtZModRing (B : Scheme.{u}) ℓ) ⥤ SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) (adjB : LB ⊣ EB.Φ) (LC : SheafOfModules.{u+1} (wcEtZModRing ((A ⊓ B : Z.Opens) : Scheme.{u}) ℓ) ⥤ SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) (adjC : LC ⊣ EC.Φ), Limits.PreservesFiniteLimits LA ∧ Limits.PreservesFiniteLimits LB ∧ Limits.PreservesFiniteLimits LC ∧ (∀ N, Mono (adjA.counit.app N)) ∧ (∀ N, Mono (adjB.counit.app N)) ∧ (∀ N, Mono (adjC.counit.app N)) ∧ ∃ (u : LC.obj (EC.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ))) ⟶ LA.obj (EA.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ)))) (v : LC.obj (EC.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ))) ⟶ LB.obj (EB.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ)))), u ≫ adjA.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)) = adjC.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)) ∧ v ≫ adjB.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)) = adjC.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)) ∧ ∃ (w : Limits.biprod.lift u (-v) ≫ Limits.biprod.desc (adjA.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ))) (adjB.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ))) = 0) (hS : (ShortComplex.mk _ _ w).ShortExact), haveI := EC.additive; haveI := EC.presLim; haveI := EC.presColim; ∀ x : Abelian.Ext (LC.obj (EC.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ)))) (SheafOfModules.unit (wcEtZModRing Z ℓ)) n, δ₀ ((Abelian.Ext.mk₀ (EC.μ.inv ≫ adjC.unit.app (EC.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ))))).comp ((Abelian.Ext.mapExactFunctor EC.Φ x).comp (Abelian.Ext.mk₀ EC.μ.hom) (add_zero n)) (zero_add n)) = hS.extClass.comp x (add_comm 1 n)) → (∀ (γ : wcEtZModExt ((A ⊓ B : Z.Opens) : Scheme.{u}) ℓ n) (DA : wcEtPullData A.ι ℓ), wcEtPull DA (n + 1) (δ₀ γ) = 0) ∧ (∀ (γ : wcEtZModExt ((A ⊓ B : Z.Opens) : Scheme.{u}) ℓ n) (DB : wcEtPullData B.ι ℓ), wcEtPull DB (n + 1) (δ₀ γ) = 0) :=
by
  classical
  intro ℓ n Z A B δ₀ hG
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing ((A ⊓ B : Z.Opens) : Scheme.{u}) ℓ)) :=
    HasExt.standard _
  obtain ⟨EA, EB, EC, LA, adjA, LB, adjB, LC, adjC, hLA, hLB, hLC, mA, mB, mC, u, v, hu, hv, w,
    hS, hδ⟩ := hG
  haveI := EC.additive
  haveI := EC.presLim
  haveI := EC.presColim
  have h0 : (Abelian.Ext.mk₀ (Limits.biprod.desc
      (adjA.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)))
      (adjB.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ))))).comp hS.extClass
      (zero_add 1) = 0 :=
    hS.comp_extClass
  obtain ⟨TC, hTC, bTC, -⟩ := wc_et_extzero_transfer_bijective (A ⊓ B) ℓ EC LC adjC hLC n
  refine ⟨?_, ?_⟩
  · intro γ DA
    obtain ⟨x, rfl⟩ := bTC.2 γ
    rw [hTC x, hδ x]
    obtain ⟨Did⟩ := wc_et_zmod_pull_data_exists (𝟙 (A : Scheme.{u})) ℓ
    rw [wc_et_pull_comp A.ι (𝟙 _) A.ι (Category.id_comp _) EA Did DA (n + 1)]
    obtain ⟨TA, -, -, hTA3⟩ := wc_et_extzero_transfer_bijective A ℓ EA LA adjA hLA (n + 1)
    have e : Abelian.Ext.mk₀ (adjA.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ))) =
