    have hpull : wcHMPull DV (2 * d - 1) (I.extMk f (2 * d - 1 + 1) rfl hf') =
        (Abelian.Ext.mk₀ (wcHMFun ((wcProEtBC g).obj W').left ℓ
          (τ.comp ((wcProEtBC g).obj W').hom.base.hom))).comp
