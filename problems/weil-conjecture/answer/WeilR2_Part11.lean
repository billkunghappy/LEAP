  classical
  haveI : IsAffine W.left := hW.1
  haveI : IsAffine ((𝟭 Scheme.{u}).obj W.left) := hW.1
  haveI : QuasiCompact V.ι := inferInstance
  haveI hQC : QuasiCompact (Limits.pullback.fst W.hom V.ι) := inferInstance
  haveI hQS : QuasiSeparated (Limits.pullback.fst W.hom V.ι) := inferInstance
  haveI hP0c : CompactSpace (Limits.pullback W.hom V.ι : Scheme.{u}) :=
    QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.fst W.hom V.ι)
  haveI hP0q : QuasiSeparatedSpace (Limits.pullback W.hom V.ι : Scheme.{u}) :=
    quasiSeparatedSpace_of_quasiSeparated (Limits.pullback.fst W.hom V.ι)
  obtain ⟨Θ, hΘ, -⟩ := wc_zmod_et_proet_natural_comparison_all ℓ k

  have hstalk : ∀ z : W.left, IsClosed ({z} : Set W.left) →
      Subsingleton (wcZModProEtExt (Limits.pullback (W.left.fromSpecStalk z)
        (Limits.pullback.fst W.hom V.ι)) ℓ k) := by
    intro z hz
    haveI : HenselianLocalRing (W.left.presheaf.stalk z) := (hW.2.2.2.2 z hz).1
    haveI : IsSepClosed (IsLocalRing.ResidueField (W.left.presheaf.stalk z)) :=
      (hW.2.2.2.2 z hz).2
    have hP : IsPullback
        (Limits.pullback.snd (W.left.fromSpecStalk z) (Limits.pullback.fst W.hom V.ι) ≫
          Limits.pullback.snd W.hom V.ι)
        (Limits.pullback.fst (W.left.fromSpecStalk z) (Limits.pullback.fst W.hom V.ι))
        V.ι (W.left.fromSpecStalk z ≫ W.hom) :=
      (IsPullback.of_hasPullback (W.left.fromSpecStalk z)
          (Limits.pullback.fst W.hom V.ι)).flip.paste_horiz
        (IsPullback.of_hasPullback W.hom V.ι).flip
