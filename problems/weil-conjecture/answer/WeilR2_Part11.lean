        ((Abelian.Ext.mapExactFunctor E.L y).comp (Abelian.Ext.mk₀ E.μ.hom) (add_zero q))
        (zero_add q)) (zero_add q)
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀_assoc,
      Abelian.Ext.mk₀_comp_mk₀_assoc]
    simp only [Category.assoc, Iso.hom_inv_id, Category.comp_id]

  have s1 : ∀ (r : C(↥S, ULift.{u+1} ℤ_[ℓ])) (r' : C(↥S, ULift.{u+1} ℚ_[ℓ])),
      (∀ t, (r' t).down = ((r t).down : ℚ_[ℓ])) →
      wcIntFun S ℓ r ≫ wcUnitRestrict (wcIntRatRingSheafMap S ℓ) =
        wcUnitRestrict (wcIntRatRingSheafMap S ℓ) ≫
          (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap S ℓ)).map (wcHMFun S ℓ r') := by
    intro r r' hr
