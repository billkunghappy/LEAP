  classical
  letI : HasExt (SheafOfModules.{u+1}
    (wcRingSheaf (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf
    ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W).left ℓ)) := HasExt.standard _

  obtain ⟨P, ev, hnat, hadd⟩ := sheafOfModules_free_yoneda
    (Scheme.ProEt.topology (Limits.pullback (wcPi2 F X) (wcPi2 F X)))
    (wcRingSheaf (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ)
    ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W)
  have hevsum : ∀ (M : SheafOfModules.{u+1} (wcRingSheaf (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ))
