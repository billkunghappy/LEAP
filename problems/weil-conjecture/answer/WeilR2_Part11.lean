theorem wc_et_affine_bundle_thom_ne_zero : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (T : wcEtLocThom K ℓ), wcEtThomGL T → wcEtThomNat T → wcEtThomPt T → ∀ (B : Scheme.{u}) (qB : B ⟶ Spec (.of K)) (m c : ℕ) [SmoothOfRelativeDimension m qB] (b : Spec (.of K) ⟶ B), b ≫ qB = 𝟙 _ → ∀ (DB : wcEtPullData (AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin c) → Γ(B, ⊤))) ℓ) (θ : wcEtSuppExt DB (2 * c)), wcEtIsThom T ((AffineSpace (ULift.{u} (Fin c)) B ↘ B) ≫ qB) DB c θ → θ ≠ 0 :=
