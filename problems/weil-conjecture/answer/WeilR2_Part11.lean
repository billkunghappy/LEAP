theorem wc_et_mod_homology_epi_of_local_gen : ∀ (S : Scheme.{u}) (R : Sheaf (Scheme.smallEtaleTopology S) RingCat.{u+1}) (Kc : CochainComplex (SheafOfModules.{u+1} R) ℕ) (n : ℕ) (k : SheafOfModules.unit R ⟶ Kc.X n) (hk : k ≫ Kc.d n (n + 1) = 0), (∀ (V : S.Etale) (s : (Kc.X n).val.obj (Opposite.op V)), ((Kc.d n (n + 1)).val.app (Opposite.op V)).hom s = 0 → ∀ v : V.left, ∃ (T : S.Etale) (h : T ⟶ V) (t : T.left) (a : ℕ) (e : (Kc.X ((ComplexShape.up ℕ).prev n)).val.obj (Opposite.op T)), h.left t = v ∧ ((Kc.X n).val.map h.op).hom s = a • (k.val.app (Opposite.op T)).hom (1 : R.obj.obj (Opposite.op T)) + ((Kc.d ((ComplexShape.up ℕ).prev n) n).val.app (Opposite.op T)).hom e) → Epi (Kc.liftCycles k (n + 1) (by simp) hk ≫ Kc.homologyπ n) :=
by
  intro S R Kc n k hk HYP

  have s1 : ∀ (M : SheafOfModules.{u+1} R) (V : S.Etale) (x : M.val.obj (Opposite.op V)),
      (∀ v : V.left, ∃ (T : S.Etale) (h : T ⟶ V) (t : T.left), h.left t = v ∧
        (M.val.map h.op).hom x = 0) → x = 0 := by
    intro M V x H
    let Sv : Sieve V :=
      { arrows := fun T f => (M.val.map f.op).hom x = 0
        downward_closed := by
          intro T Z f hf g
          show (M.val.map (g ≫ f).op).hom x = 0
          rw [op_comp, PresheafOfModules.map_comp_apply]
          rw [show (M.val.map f.op).hom x = 0 from hf]
          exact map_zero _ }
    have hcov : Sv ∈ Scheme.smallEtaleTopology S V := by
      have h1 := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale S
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V Sv).mpr
        (fun v => by
          obtain ⟨T, h, t, ht, hx⟩ := H v
          exact ⟨T, h, t, hx, inferInstance, ht⟩)
      rw [← @Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale S
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at h1
      exact h1
    exact Sheaf.isSeparated ((SheafOfModules.toSheaf.{u+1} R).obj M) V Sv hcov x 0
      (fun T f hf => by
        change (M.val.map f.op).hom x = (M.val.map f.op).hom 0
        rw [map_zero]
        exact hf)

  have hinj : ∀ (T : S.Etale), Function.Injective ((Kc.iCycles n).val.app (Opposite.op T)).hom := by
    intro T
    haveI := preservesMonomorphisms_of_preservesLimitsOfShape
      (SheafOfModules.evaluation R (Opposite.op T))
    exact (ModuleCat.mono_iff_injective _).mp
      (Functor.map_mono (SheafOfModules.evaluation R (Opposite.op T)) (Kc.iCycles n))
  apply Preadditive.epi_of_cancel_zero
  intro Q g hg
  have hL : Kc.liftCycles k (n + 1) (by simp) hk ≫ (Kc.homologyπ n ≫ g) = 0 := by
    rw [← Category.assoc]; exact hg
  have hτ : Kc.toCycles ((ComplexShape.up ℕ).prev n) n ≫ (Kc.homologyπ n ≫ g) = 0 := by
    rw [← Category.assoc, HomologicalComplex.toCycles_comp_homologyπ, Limits.zero_comp]
  have hu : Kc.homologyπ n ≫ g = 0 := by
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro X
    obtain ⟨V⟩ := X
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro c
    change ((Kc.homologyπ n ≫ g).val.app (Opposite.op V)).hom c = 0
    apply s1 Q V
    intro v
    have hs : ((Kc.d n (n + 1)).val.app (Opposite.op V)).hom
        (((Kc.iCycles n).val.app (Opposite.op V)).hom c) = 0 := by
      have := congrArg (fun f : Kc.cycles n ⟶ Kc.X (n + 1) => (f.val.app (Opposite.op V)).hom c)
        (HomologicalComplex.iCycles_d Kc n (n + 1))
      exact this
    obtain ⟨T, h, t, a, e, ht, hse⟩ := HYP V _ hs v
    have e1 : ((Kc.iCycles n).val.app (Opposite.op T)).hom
        (((Kc.liftCycles k (n + 1) (by simp) hk).val.app (Opposite.op T)).hom
          (1 : R.obj.obj (Opposite.op T))) =
        (k.val.app (Opposite.op T)).hom (1 : R.obj.obj (Opposite.op T)) :=
      congrArg (fun f : SheafOfModules.unit R ⟶ Kc.X n =>
        (f.val.app (Opposite.op T)).hom (1 : R.obj.obj (Opposite.op T)))
        (HomologicalComplex.liftCycles_i Kc k (n + 1) (by simp) hk)
    have e2 : ((Kc.iCycles n).val.app (Opposite.op T)).hom
        (((Kc.toCycles ((ComplexShape.up ℕ).prev n) n).val.app (Opposite.op T)).hom e) =
        ((Kc.d ((ComplexShape.up ℕ).prev n) n).val.app (Opposite.op T)).hom e :=
      congrArg (fun f : Kc.X ((ComplexShape.up ℕ).prev n) ⟶ Kc.X n =>
        (f.val.app (Opposite.op T)).hom e)
        (HomologicalComplex.toCycles_i Kc ((ComplexShape.up ℕ).prev n) n)
    have hc' : ((Kc.cycles n).val.map h.op).hom c =
        a • ((Kc.liftCycles k (n + 1) (by simp) hk).val.app (Opposite.op T)).hom
          (1 : R.obj.obj (Opposite.op T)) +
        ((Kc.toCycles ((ComplexShape.up ℕ).prev n) n).val.app (Opposite.op T)).hom e := by
      apply hinj T
      rw [map_add, map_nsmul, e1, e2, PresheafOfModules.naturality_apply, hse]
    have z1 : ((Kc.homologyπ n ≫ g).val.app (Opposite.op T)).hom
        (((Kc.liftCycles k (n + 1) (by simp) hk).val.app (Opposite.op T)).hom
          (1 : R.obj.obj (Opposite.op T))) = 0 :=
      congrArg (fun f : SheafOfModules.unit R ⟶ Q =>
        (f.val.app (Opposite.op T)).hom (1 : R.obj.obj (Opposite.op T))) hL
    have z2 : ((Kc.homologyπ n ≫ g).val.app (Opposite.op T)).hom
        (((Kc.toCycles ((ComplexShape.up ℕ).prev n) n).val.app (Opposite.op T)).hom e) = 0 :=
      congrArg (fun f : Kc.X ((ComplexShape.up ℕ).prev n) ⟶ Q =>
        (f.val.app (Opposite.op T)).hom e) hτ
    refine ⟨T, h, t, ht, ?_⟩
    have hnat := PresheafOfModules.naturality_apply (Kc.homologyπ n ≫ g).val h.op c
    rw [← hnat, hc', map_add, map_nsmul, z1, z2, smul_zero, add_zero]
    exact rfl
  exact (cancel_epi (Kc.homologyπ n)).mp (hu.trans Limits.comp_zero.symm)

theorem inj_res_extMk_deg_zero_injective {C : Type*} [Category C] [Abelian C] [HasExt C] {X Y : C}
    (I : InjectiveResolution Y) {n : ℕ} (f : X ⟶ I.cocomplex.X n) (m : ℕ) (hm : n + 1 = m)
    (hf : f ≫ I.cocomplex.d n m = 0) : n = 0 → I.extMk f m hm hf = 0 → f = 0 :=
by
  intro hn h0
  subst hn
  simp only [← I.extEquivCohomologyClass.apply_eq_iff_eq,
    InjectiveResolution.extEquivCohomologyClass_extMk,
    InjectiveResolution.extEquivCohomologyClass_zero,
    CochainComplex.HomComplex.CohomologyClass.mk_eq_zero_iff] at h0
  rw [CochainComplex.HomComplex.Cocycle.fromSingleMk_mem_coboundaries_iff _ _ _ _ _ (-1)
    (by simp)] at h0
  obtain ⟨g, hg⟩ := h0
  have hz : Limits.IsZero (I.cochainComplex.X (-1)) :=
    CochainComplex.isZero_of_isStrictlyGE _ 0 _ (by norm_num)
  rw [hz.eq_of_tgt g 0, Limits.zero_comp] at hg
  rw [← cancel_mono (I.cochainComplexXIso _ 0 rfl).inv, Limits.zero_comp]
  exact hg.symm

theorem wc_et_closed_rightAdj_corep_pack : ∀ {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i] (ℓ : ℕ) (D : wcEtPullData i ℓ) (R : SheafOfModules.{u+1} (wcEtZModRing Y ℓ) ⥤ SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) [R.Additive] (adj : @SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ ⊣ R), ∃ (A : Y.Etale → SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) (a : ∀ (W : Y.Etale) (M : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)), (A W ⟶ M) ≃ (R.obj M).val.obj (Opposite.op ((wcEtBaseChange i).obj W))), (∀ (W : Y.Etale) (M N : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) (f : A W ⟶ M) (g : M ⟶ N), a W N (f ≫ g) = ((R.map g).val.app (Opposite.op ((wcEtBaseChange i).obj W))).hom (a W M f)) ∧ (∀ (W : Y.Etale) (M : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) (f f' : A W ⟶ M), a W M (f + f') = a W M f + a W M f') ∧ (∀ (W W₂ : Y.Etale) (h : W₂ ⟶ W), ∃ r : A W₂ ⟶ A W, ∀ (M : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) (f : A W ⟶ M), a W₂ M (r ≫ f) = ((R.obj M).val.map ((wcEtBaseChange i).map h).op).hom (a W M f)) :=
by
  intro Y Z i _ ℓ D R _ adj
  classical
  have corep : ∀ (V : Z.Etale), ∃ (Q : SheafOfModules.{u+1} (wcEtZModRing Z ℓ))
      (e : Q.val.obj (Opposite.op V)), ∀ M : SheafOfModules.{u+1} (wcEtZModRing Z ℓ),
      Function.Bijective (fun φ : Q ⟶ M => (φ.val.app (Opposite.op V)).hom e) := by
    intro W
    let adj1 := PresheafOfModules.sheafificationAdjunction.{u+1} (𝟙 (wcEtZModRing Z ℓ).obj)
    let adj2 := PresheafOfModules.freeAdjunction.{u+1} (wcEtZModRing Z ℓ).obj
    let F0 := uliftYoneda.{u+1}.obj W
    let P := (PresheafOfModules.free.{u+1} (wcEtZModRing Z ℓ).obj).obj F0
    let Q : SheafOfModules.{u+1} (wcEtZModRing Z ℓ) :=
      (PresheafOfModules.sheafification.{u+1} (𝟙 (wcEtZModRing Z ℓ).obj)).obj P
    let B : ∀ M : SheafOfModules.{u+1} (wcEtZModRing Z ℓ), (Q ⟶ M) → M.val.obj (Opposite.op W) :=
      fun M φ => uliftYonedaEquiv (adj2.homEquiv F0 _ (adj1.homEquiv P M φ))
    have hB : ∀ M : SheafOfModules.{u+1} (wcEtZModRing Z ℓ), Function.Bijective (B M) := fun M =>
      uliftYonedaEquiv.bijective.comp ((adj2.homEquiv F0 _).bijective.comp
        (adj1.homEquiv P M).bijective)
    refine ⟨Q, B Q (𝟙 Q), fun M => ?_⟩
    have key : ∀ φ : Q ⟶ M, B M φ = (φ.val.app (Opposite.op W)).hom (B Q (𝟙 Q)) := by
      intro φ
      have h1 := adj1.homEquiv_naturality_right (𝟙 Q) φ
      rw [Category.id_comp] at h1
      have h2 := adj2.homEquiv_naturality_right (adj1.homEquiv P Q (𝟙 Q))
        ((SheafOfModules.forget (wcEtZModRing Z ℓ) ⋙
          PresheafOfModules.restrictScalars (𝟙 (wcEtZModRing Z ℓ).obj)).map φ)
      show uliftYonedaEquiv (adj2.homEquiv F0 _ (adj1.homEquiv P M φ)) = _
      rw [h1, h2, uliftYonedaEquiv_comp]
      rfl
    have hfun : (fun φ : Q ⟶ M => (φ.val.app (Opposite.op W)).hom (B Q (𝟙 Q))) = B M :=
      funext fun φ => (key φ).symm
    rw [hfun]
    exact hB M
  choose Q e hQ using fun W : Y.Etale => corep ((wcEtBaseChange i).obj W)
  let Pf := @SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ
  let b : ∀ (W : Y.Etale) (M : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)),
      (Pf.obj (Q W) ⟶ M) → (R.obj M).val.obj (Opposite.op ((wcEtBaseChange i).obj W)) :=
    fun W M f => ((adj.homEquiv (Q W) M f).val.app
      (Opposite.op ((wcEtBaseChange i).obj W))).hom (e W)
  have hb : ∀ (W : Y.Etale) (M : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)),
      Function.Bijective (b W M) :=
    fun W M => (hQ W (R.obj M)).comp (adj.homEquiv (Q W) M).bijective
  refine ⟨fun W => Pf.obj (Q W), fun W M => Equiv.ofBijective (b W M) (hb W M), ?_, ?_, ?_⟩
  · intro W M N f g
    show b W N (f ≫ g) = ((R.map g).val.app (Opposite.op ((wcEtBaseChange i).obj W))).hom (b W M f)
    dsimp only [b]
    rw [adj.homEquiv_naturality_right]
    rfl
  · intro W M f f'
    show b W M (f + f') = b W M f + b W M f'
    dsimp only [b]
    rw [Adjunction.homEquiv_unit, Adjunction.homEquiv_unit, Adjunction.homEquiv_unit,
      Functor.map_add, Preadditive.comp_add]
    rfl
  · intro W W₂ h
    obtain ⟨r₀, hr₀⟩ := (hQ W₂ (Q W)).2
      (((Q W).val.map ((wcEtBaseChange i).map h).op).hom (e W))
    have hr₀' : (r₀.val.app (Opposite.op ((wcEtBaseChange i).obj W₂))).hom (e W₂) =
        ((Q W).val.map ((wcEtBaseChange i).map h).op).hom (e W) := hr₀
    refine ⟨Pf.map r₀, fun M f => ?_⟩
    show b W₂ M (Pf.map r₀ ≫ f) =
      ((R.obj M).val.map ((wcEtBaseChange i).map h).op).hom (b W M f)
    dsimp only [b]
    rw [adj.homEquiv_naturality_left]
    change ((adj.homEquiv (Q W) M f).val.app (Opposite.op ((wcEtBaseChange i).obj W₂))).hom
        ((r₀.val.app (Opposite.op ((wcEtBaseChange i).obj W₂))).hom (e W₂)) = _
    rw [hr₀']
    exact PresheafOfModules.naturality_apply (adj.homEquiv (Q W) M f).val _ (e W)

