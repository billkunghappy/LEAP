        ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing O.toScheme ℓ)).obj I) (k + 1)), e = 0 := by
    intro I _ k e
    have h0 : (Abelian.Ext.mk₀ eP.inv).comp e (zero_add (k + 1)) = 0 :=
      sheafOfModules_torsion_injective_acyclic (Scheme.smallEtaleTopology O.toScheme)
        (wcEtZModRing O.toScheme ℓ) ℓ hℓ hR hess I k _
    calc e = (Abelian.Ext.mk₀ (𝟙 _)).comp e (zero_add (k + 1)) := (Abelian.Ext.mk₀_id_comp e).symm
      _ = ((Abelian.Ext.mk₀ eP.hom).comp (Abelian.Ext.mk₀ eP.inv) (add_zero 0)).comp e
            (zero_add (k + 1)) := by rw [Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id]
      _ = (Abelian.Ext.mk₀ eP.hom).comp ((Abelian.Ext.mk₀ eP.inv).comp e (zero_add (k + 1)))
            (zero_add (k + 1)) :=
          Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add (k + 1)) (by omega)
      _ = 0 := by rw [h0, Abelian.Ext.comp_zero]
  have hhom : ∀ N : SheafOfModules.{u+1} (wcEtZModRing O.toScheme ℓ),
      Function.Bijective (fun f : SheafOfModules.unit (wcEtZModRing O.toScheme ℓ) ⟶ N =>
        ((wcEtInv O.ι).map p ≫ k'.hom) ≫
          (SheafOfModules.toSheaf.{u+1} (wcEtZModRing O.toScheme ℓ)).map f) := by
    intro N
    constructor
    · intro f g hfg
      apply (SheafOfModules.toSheaf.{u+1} (wcEtZModRing O.toScheme ℓ)).map_injective
      exact Limits.Cofork.IsColimit.hom_ext hp' hfg
    · intro g
      have hz : (ℓ • 𝟙 ((wcEtInv O.ι).obj (wcEtUnitSheaf Y))) ≫ g = 0 := by
        have h0 : g ≫ (ℓ • 𝟙 _) = 0 := by
          rw [s1 (Scheme.smallEtaleTopology O.toScheme) (wcEtZModRing O.toScheme ℓ) ℓ hR N,
            Limits.comp_zero]
        rw [Preadditive.nsmul_comp, Category.id_comp, ← h0, Preadditive.comp_nsmul,
          Category.comp_id]
      obtain ⟨l, hl⟩ := Limits.CokernelCofork.IsColimit.desc' hp' g hz
      refine ⟨(SheafOfModules.toSheaf.{u+1} (wcEtZModRing O.toScheme ℓ)).preimage
        (l : (SheafOfModules.toSheaf.{u+1} (wcEtZModRing O.toScheme ℓ)).obj
          (SheafOfModules.unit (wcEtZModRing O.toScheme ℓ)) ⟶
          (SheafOfModules.toSheaf.{u+1} (wcEtZModRing O.toScheme ℓ)).obj N), ?_⟩
      dsimp only
      rw [Functor.map_preimage]
      exact hl
  have hbij := ext_transfer_of_corep
    (SheafOfModules.toSheaf.{u+1} (wcEtZModRing O.toScheme ℓ))
    (SheafOfModules.unit (wcEtZModRing O.toScheme ℓ)) ((wcEtInv O.ι).obj (wcEtUnitSheaf Y))
    ((wcEtInv O.ι).map p ≫ k'.hom) hhom hvan (SheafOfModules.unit (wcEtZModRing O.toScheme ℓ)) s

  intro y
  obtain ⟨w₀, hw₀⟩ := hbij.2 (y.comp (Abelian.Ext.mk₀ q'.inv) (add_zero s))
  have hw₀' : (Abelian.Ext.mk₀ ((wcEtInv O.ι).map p ≫ k'.hom)).comp
      (Abelian.Ext.mapExactFunctor (SheafOfModules.toSheaf.{u+1} (wcEtZModRing O.toScheme ℓ)) w₀)
        (zero_add s) = y.comp (Abelian.Ext.mk₀ q'.inv) (add_zero s) := hw₀
  obtain ⟨v, hv⟩ := h Dj w₀
  have hpull : wcEtPull Dj s v = (Abelian.Ext.mk₀ Dj.μ.inv).comp
      ((Abelian.Ext.mapExactFunctor Dj.Φ v).comp (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero s))
      (zero_add s) := rfl
  have hy : y = ((Abelian.Ext.mk₀ ((wcEtInv O.ι).map p ≫ k'.hom)).comp
      (Abelian.Ext.mapExactFunctor (SheafOfModules.toSheaf.{u+1} (wcEtZModRing O.toScheme ℓ)) w₀)
        (zero_add s)).comp (Abelian.Ext.mk₀ q'.hom) (add_zero s) := by
    rw [hw₀', h3, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
  have hnatκ := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp v κ.hom
  have hUj : Abelian.Ext.mapExactFunctor
      (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y ℓ) ⋙ wcEtInv O.ι) v =
      (Abelian.Ext.mk₀ (κ.inv.app (SheafOfModules.unit (wcEtZModRing Y ℓ)))).comp
        ((Abelian.Ext.mapExactFunctor
          (Dj.Φ ⋙ SheafOfModules.toSheaf.{u+1} (wcEtZModRing O.toScheme ℓ)) v).comp
          (Abelian.Ext.mk₀ (κ.hom.app (SheafOfModules.unit (wcEtZModRing Y ℓ)))) (add_zero s))
        (zero_add s) := by
    rw [hnatκ, h2, Iso.inv_hom_id_app, Abelian.Ext.mk₀_id_comp]
  have e1 : ((wcEtInv O.ι).map p ≫ k'.hom) ≫
      (SheafOfModules.toSheaf.{u+1} (wcEtZModRing O.toScheme ℓ)).map Dj.μ.inv =
      (wcEtInv O.ι).map p ≫ κ.inv.app (SheafOfModules.unit (wcEtZModRing Y ℓ)) := by
    rw [hk']
    simp
  have e2 : (SheafOfModules.toSheaf.{u+1} (wcEtZModRing O.toScheme ℓ)).map Dj.μ.hom ≫ q'.hom =
      κ.hom.app (SheafOfModules.unit (wcEtZModRing Y ℓ)) ≫ (wcEtInv O.ι).map ιY.hom := by
    rw [hq', hk']
    simp
  refine ⟨Abelian.Ext.mapExactFunctor (wcEtInv (𝟙 Y))
    ((Abelian.Ext.mk₀ p).comp ((Abelian.Ext.mapExactFunctor
      (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y ℓ)) v).comp (Abelian.Ext.mk₀ ιY.hom)
        (add_zero s)) (zero_add s)), ?_⟩
  rw [hid, hy, ← hv, hpull]
  simp only [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
  rw [← Abelian.Ext.comp_mapExactFunctor v (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y ℓ))
      (wcEtInv O.ι), hUj,
    ← Abelian.Ext.comp_mapExactFunctor v Dj.Φ
      (SheafOfModules.toSheaf.{u+1} (wcEtZModRing O.toScheme ℓ))]
  simp only [h2, h3, h4]
  rw [e1, e2]

theorem wc_smooth_pair_local_zmod_card_le_of_et (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n : ℕ) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (O : Y.Opens) (hO : (O : Set Y) = (Set.range i)ᶜ)
    (hD : ∀ D : wcEtPullData i ℓ,
      Finite (wcEtSuppExt D (2 * n)) ∧ Nat.card (wcEtSuppExt D (2 * n)) ≤ ℓ) :
    Finite (Abelian.Ext (Limits.cokernel (wcFreeSheafMap Y
      (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y)))) (wcZModSheaf Y ℓ) (2 * n)) ∧
    Nat.card (Abelian.Ext (Limits.cokernel (wcFreeSheafMap Y
      (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y)))) (wcZModSheaf Y ℓ) (2 * n)) ≤ ℓ :=
by
  classical
  let ιO : Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y) :=
    MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial
  haveI hYln : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY
  haveI hYc : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace pY
  haveI hYqs : QuasiSeparatedSpace Y := IsLocallyNoetherian.quasiSeparatedSpace
  haveI hOc : CompactSpace O.toScheme := QuasiCompact.compactSpace_of_compactSpace O.ι
  haveI hOln : IsLocallyNoetherian O.toScheme := isLocallyNoetherian_of_isOpenImmersion O.ι
  haveI hOqs : QuasiSeparatedSpace O.toScheme := IsLocallyNoetherian.quasiSeparatedSpace
  have hmono : Mono (wcFreeSheafMap Y ιO) :=
    wc_free_sheaf_map_mono Y _ _ ιO (IsOpenImmersion.mono O.ι)
  have hS₀ : (ShortComplex.mk (wcFreeSheafMap Y ιO) (Limits.cokernel.π (wcFreeSheafMap Y ιO))
      (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) hmono inferInstance
  obtain ⟨EY⟩ := wc_proet_etale_comparison_zmod K Y pY ℓ (2 * n)
  obtain ⟨hfinY, hcardY⟩ := wc_et_top_coh_card_le K Y pY n ℓ hℓ
  by_cases hn0 : n = 0
  ·
    rw [show 2 * n = 0 by omega] at EY hfinY hcardY ⊢
    haveI := hfinY
    let r : Abelian.Ext (Limits.cokernel (wcFreeSheafMap Y ιO)) (wcZModSheaf Y ℓ) 0 →
        Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) (wcZModSheaf Y ℓ) 0 :=
      fun x => (Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap Y ιO))).comp x (zero_add 0)
    have hr : Function.Injective r := by
      intro x y hxy
      obtain ⟨f, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 x
      obtain ⟨g, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 y
      have h1 : Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap Y ιO) ≫ f) =
          Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap Y ιO) ≫ g) := by
        rw [← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.mk₀_comp_mk₀]
        exact hxy
      have h2 := (Abelian.Ext.mk₀_bijective _ _).1 h1
      rw [cancel_epi] at h2
      rw [h2]
    have hEr : Function.Injective (EY ∘ r) := EY.injective.comp hr
    exact ⟨Finite.of_injective _ hEr, (Nat.card_le_card_of_injective _ hEr).trans hcardY⟩
  · haveI := hfinY
    obtain ⟨s, hs⟩ : ∃ s, s + 1 = 2 * n := ⟨2 * n - 1, by omega⟩
    have h1 : 1 + s = 2 * n := by omega

    have hsurjE := wc_et_inv_ext_pull_open_surj_of_et_pull Y O ℓ s
      (fun Dj => wc_et_smooth_pair_open_restr_surj K pY n i ℓ hℓ O hO hD s hs Dj)
    obtain ⟨Θ, hbij, hnat⟩ := wc_etale_proet_comparison Y
      ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) s
    obtain ⟨-, hcont⟩ := wc_etToProEt_flat_cont Y
    haveI := hcont
    let χ : (wcEpsInv Y).obj ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) ≅ wcZModSheaf Y ℓ :=
      (wc_epsInv_const Y _).some ≪≫ (wc_zmod_sheaf_const Y ℓ).some.symm

    have hres : ∀ y : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk O.ι)) (wcZModSheaf Y ℓ) s,
        ∃ x : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) (wcZModSheaf Y ℓ) s,
          (Abelian.Ext.mk₀ (wcFreeSheafMap Y ιO)).comp x (zero_add s) = y := by
      intro y
      obtain ⟨e', he'⟩ := (hbij (Scheme.ProEt.mk O.ι) hOc hOqs).2
        (y.comp (Abelian.Ext.mk₀ χ.inv) (add_zero s))
      obtain ⟨e, he⟩ := hsurjE e'
      refine ⟨(Θ (Scheme.ProEt.mk (𝟙 Y)) e).comp (Abelian.Ext.mk₀ χ.hom) (add_zero s), ?_⟩
      have hn' := hnat (Scheme.ProEt.mk (𝟙 Y)) (Scheme.ProEt.mk O.ι) ιO hYc hYqs hOc hOqs e
      have key : (Abelian.Ext.mk₀ (wcFreeSheafMap Y ιO)).comp (Θ (Scheme.ProEt.mk (𝟙 Y)) e)
          (zero_add s) = y.comp (Abelian.Ext.mk₀ χ.inv) (add_zero s) :=
        hn'.symm.trans ((congrArg (Θ (Scheme.ProEt.mk O.ι)) he).trans he')
      rw [← Abelian.Ext.comp_assoc_of_third_deg_zero, key,
        Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
        Abelian.Ext.comp_mk₀_id]
    let R := (Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap Y ιO))).precomp
      (wcZModSheaf Y ℓ) (zero_add (2 * n))
    have hker : ∀ z, R z = 0 → z = 0 := by
      intro z hz
      have hz' : (Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap Y ιO))).comp z
          (zero_add (2 * n)) = 0 := hz
      obtain ⟨z₁, hz₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS₀ (wcZModSheaf Y ℓ) z hz' h1
      obtain ⟨x₁, hx₁⟩ := hres z₁
      have hc : hS₀.extClass.comp (Abelian.Ext.mk₀ (wcFreeSheafMap Y ιO)) (add_zero 1) = 0 :=
        hS₀.extClass_comp
      rw [← hz₁, ← hx₁, ← Abelian.Ext.comp_assoc_of_second_deg_zero, hc, Abelian.Ext.zero_comp]
    have hRi : Function.Injective R := (injective_iff_map_eq_zero R).2 hker
    have hEr : Function.Injective (EY ∘ R) := EY.injective.comp hRi
    exact ⟨Finite.of_injective _ hEr, (Nat.card_le_card_of_injective _ hEr).trans hcardY⟩

theorem wc_smooth_pair_local_zmod_succ_vanish (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n : ℕ) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (O : Y.Opens) (hO : (O : Set Y) = (Set.range i)ᶜ) :
    ∀ z : Abelian.Ext (Limits.cokernel (wcFreeSheafMap Y
      (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y)))) (wcZModSheaf Y ℓ) (2 * n + 1), z = 0 :=
by
  classical

  have hVUo : IsOpenImmersion (Scheme.ProEt.mk O.ι).hom :=
    inferInstanceAs (IsOpenImmersion O.ι)
  have hne : Set.range (Scheme.ProEt.mk O.ι).hom ≠ Set.univ := by
    change Set.range O.ι ≠ Set.univ
    rw [Scheme.Opens.range_ι, hO]
    obtain ⟨z₀⟩ := (IrreducibleSpace.toNonempty : Nonempty Z)
    intro h
    have hz : i z₀ ∈ (Set.range i)ᶜ := h ▸ Set.mem_univ _
    exact hz ⟨z₀, rfl⟩

  set ι : Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y) :=
    MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial with hιdef
  have hmono : Mono (wcFreeSheafMap Y ι) :=
    wc_free_sheaf_map_mono Y _ _ ι (IsOpenImmersion.mono O.ι)
  have hS : (ShortComplex.mk (wcFreeSheafMap Y ι)
      (Limits.cokernel.π (wcFreeSheafMap Y ι))
      (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) hmono inferInstance

  haveI hsubEt : Subsingleton (wcEtCoh Y ℓ (2 * n + 1)) := by
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    have hv := wc_et_cd_proper_torsion K Y pY n (wc_smooth_alg_closed_dim_le K Y pY n) ℓ
      hℓ ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))
      (wc_et_const_zmod_nsmul_zero Y ℓ) (2 * n + 1) (by omega)
    show Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) (2 * n + 1))
    exact ⟨fun a b => (hv a).trans (hv b).symm⟩
  obtain ⟨E3⟩ := wc_proet_etale_comparison_zmod K Y pY ℓ (2 * n + 1)
  haveI hsub1 : Subsingleton (Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
      (wcZModSheaf Y ℓ) (2 * n + 1)) := E3.subsingleton

  have h1 : ∀ x : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk O.ι))
      (wcZModSheaf Y (ℓ ^ 1)) (2 * n), x = 0 :=
    fun x => wc_ac_open_zmod_top_vanish K pY n ℓ hℓ (Scheme.ProEt.mk O.ι) hVUo hne 1 x
  rw [pow_one] at h1

  intro z
  obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS
    (wcZModSheaf Y ℓ) z (Subsingleton.elim _ _) (n₀ := 2 * n) (by omega)
  rw [← hx₁, h1 x₁, Abelian.Ext.comp_zero]

theorem wc_smooth_pair_local_zmod_card_ge (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n : ℕ) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (O : Y.Opens) (hO : (O : Set Y) = (Set.range i)ᶜ) :
    ∀ k : ℕ, 1 ≤ k → Finite (Abelian.Ext (Limits.cokernel (wcFreeSheafMap Y
      (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y)))) (wcZModSheaf Y (ℓ ^ k)) (2 * n)) →
      ℓ ^ k ≤ Nat.card (Abelian.Ext (Limits.cokernel (wcFreeSheafMap Y
        (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y)))) (wcZModSheaf Y (ℓ ^ k)) (2 * n)) :=
by
  intro k hk hfin
  classical
  have hdim : topologicalKrullDim Y = (n : WithBot ℕ∞) :=
    le_antisymm (wc_smooth_alg_closed_dim_le K Y pY n) (wc_smooth_irreducible_dim_ge K Y pY n)
  set ι : Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y) :=
    MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial with hιdef
  have hmono : Mono (wcFreeSheafMap Y ι) :=
    wc_free_sheaf_map_mono Y _ _ ι (IsOpenImmersion.mono O.ι)
  have hS : (ShortComplex.mk (wcFreeSheafMap Y ι)
      (Limits.cokernel.π (wcFreeSheafMap Y ι))
      (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) hmono inferInstance
  have hVUo : IsOpenImmersion (Scheme.ProEt.mk O.ι).hom :=
    inferInstanceAs (IsOpenImmersion O.ι)
  have hne : Set.range (Scheme.ProEt.mk O.ι).hom ≠ Set.univ := by
    change Set.range O.ι ≠ Set.univ
    rw [Scheme.Opens.range_ι, hO]
    intro h
    obtain ⟨z₀⟩ := (IrreducibleSpace.toNonempty : Nonempty Z)
    have hz := Set.ext_iff.mp h (i z₀)
    simp only [Set.mem_compl_iff, Set.mem_univ, iff_true] at hz
    exact hz ⟨z₀, rfl⟩
  have hvan := fun y => wc_ac_open_zmod_top_vanish K pY n ℓ hℓ (Scheme.ProEt.mk O.ι) hVUo hne k y
  let r : Abelian.Ext (Limits.cokernel (wcFreeSheafMap Y ι))
      (wcZModSheaf Y (ℓ ^ k)) (2 * n) →
      Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
      (wcZModSheaf Y (ℓ ^ k)) (2 * n) :=
    fun t => (Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap Y ι))).comp t
      (zero_add (2 * n))
  have hr : Function.Surjective r := by
    intro h
    obtain ⟨t, ht⟩ := Abelian.Ext.contravariant_sequence_exact₂ hS
      (wcZModSheaf Y (ℓ ^ k)) h (hvan _)
    exact ⟨t, ht⟩
  obtain ⟨E⟩ := wc_proet_etale_comparison_zmod K Y pY (ℓ ^ k) (2 * n)
  have hge := wc_et_top_coh_card_ge K Y pY n hdim ℓ (Fact.out : ℓ.Prime) hℓ k hk
  have hH := hge.trans_eq (Nat.card_congr E).symm
  exact hH.trans (Nat.card_le_card_of_surjective r hr)

theorem wc_smooth_pair_supp_top_line (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di) (N : ℕ) (hN : N = 2 * n) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
    ∀ v w : wcSuppExt Di N, v ≠ 0 →
      ∃ c : ℚ_[ℓ], w = v.comp (Abelian.Ext.mk₀ (wcHMConst Y ℓ c)) (add_zero N) :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
  subst hN
  intro v w hv

  have key : ∀ (c : ℚ_[ℓ]) (U : (Y.ProEt)ᵒᵖ)
      (x : ((wcLadicSheaf Y ℓ).obj.obj U : Type (u+1))),
      (wcLadicScalar Y ℓ c).hom.app U x =
        (ULift.up (c • (ULift.down x : C(↥((Scheme.ProEt.forget Y ⋙
          Over.forget Y).obj (Opposite.unop U)), ℚ_[ℓ]))) : _) := by
    intro c U x
    rfl
  have hscmul : ∀ a b : ℚ_[ℓ], wcLadicScalar Y ℓ a ≫ wcLadicScalar Y ℓ b =
      wcLadicScalar Y ℓ (b * a) := by
    intro a b
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply,
      key, key, key]
    exact congrArg ULift.up (mul_smul b a _).symm
  have hsc0 : wcLadicScalar Y ℓ 0 = 0 := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [key]
    apply ULift.ext
    apply ContinuousMap.ext
    intro p
    exact zero_smul ℚ_[ℓ] _

  have htf : ∀ (V : (Y.ProEt)ᵒᵖ) (k : ℕ)
      (r : ↑((wcRingSheaf Y ℓ).obj.obj V)), k ≠ 0 → k • r = 0 → r = 0 := by
    intro V k r hk hr
    have hc : ((k : ℕ) : ℚ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr hk
    have key2 : ∀ {T : Type u} [TopologicalSpace T] (a : C(T, ULift.{u+1} ℚ_[ℓ])),
        k • a = 0 → a = 0 := by
      intro T _ a h
      refine ContinuousMap.ext fun t => ULift.ext _ _ ?_
      have h1 : k • (a t).down = 0 :=
        congrArg (fun g : C(T, ULift.{u+1} ℚ_[ℓ]) => (g t).down) h
      rw [nsmul_eq_mul] at h1
      exact (mul_eq_zero.mp h1).resolve_left hc
    exact key2 (T := ↥((Scheme.ProEt.forget Y ⋙ Over.forget Y).obj
      (Opposite.unop V))) r hr
  obtain ⟨L, adj, hA, hL, hC⟩ := sheafOfModules_toSheaf_exact_left_adjoint_of_torsionFree
    (Scheme.ProEt.topology Y) (wcRingSheaf Y ℓ) htf
  haveI := hA
  haveI := hL
  haveI := hC

  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace pY
  let O : Y.Opens := ⟨(Set.range i)ᶜ, i.isClosedEmbedding.isClosed_range.isOpen_compl⟩
  have hO : (O : Set Y) = (Set.range i)ᶜ := rfl

  obtain ⟨ε, hσρ, hex⟩ := wc_closed_supp_kernel_free i ℓ Di hDi L adj O hO
  haveI := wc_supp_unit_epi_of_noetherian i ℓ Di hDi
  have hc := hex.gIsCokernel
  let e := (Limits.cokernelIsCokernel _).coconePointUniqueUpToIso hc
  let Ψ := fun v' : wcSuppExt Di (2 * n) => (Abelian.Ext.mk₀ e.hom).comp v' (zero_add (2 * n))
  have hΨinj : Function.Injective Ψ := by
    intro v₁ v₂ h
    have k : ∀ v' : wcSuppExt Di (2 * n),
        (Abelian.Ext.mk₀ e.inv).comp (Ψ v') (zero_add _) = v' := by
      intro v'
      show (Abelian.Ext.mk₀ e.inv).comp ((Abelian.Ext.mk₀ e.hom).comp v' (zero_add _))
        (zero_add _) = v'
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add (2 * n)) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
    rw [← k v₁, ← k v₂, h]
  have hΨ0 : Ψ 0 = 0 := Abelian.Ext.comp_zero _ _ _ _ _
  have hΨc : ∀ (c : ℚ_[ℓ]) (v' : wcSuppExt Di (2 * n)),
      Ψ (v'.comp (Abelian.Ext.mk₀ (wcHMConst Y ℓ c)) (add_zero _)) =
        (Ψ v').comp (Abelian.Ext.mk₀ (wcHMConst Y ℓ c)) (add_zero _) := by
    intro c v'
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add _) (add_zero _) (by omega)).symm

  obtain ⟨Θ, hΘ⟩ := wc_free_coker_module_ext_transfer Y ℓ L adj ε
    (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
      Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y)) (2 * n)

  obtain ⟨hfin1, hcard1⟩ := wc_smooth_pair_local_zmod_card_le_of_et K pY n i ℓ hℓ O hO
    (fun D => wc_et_smooth_pair_supp_top_card_le K pY n m r hmr i ℓ hℓ D)
  have hvan := wc_smooth_pair_local_zmod_succ_vanish K pY n i ℓ hℓ O hO
  have hge := wc_smooth_pair_local_zmod_card_ge K pY n i ℓ hℓ O hO
  obtain ⟨y, hy⟩ := wc_free_coker_ladic_line_of_counts Y O ℓ (2 * n) hfin1 hcard1 hvan hge

  have hΦinj : ∀ v₁ v₂ : wcSuppExt Di (2 * n), Θ (Ψ v₁) = Θ (Ψ v₂) → v₁ = v₂ :=
    fun v₁ v₂ h => hΨinj (Θ.injective h)
  obtain ⟨α, hα⟩ := hy (Θ (Ψ v))
  obtain ⟨β, hβ⟩ := hy (Θ (Ψ w))
  have hα0 : α ≠ 0 := by
    rintro rfl
    apply hv
    apply hΦinj
    rw [hα, hsc0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero, hΨ0, map_zero]
  refine ⟨β / α, hΦinj _ _ ?_⟩
  rw [hΨc, hΘ, hα, hβ, Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
    hscmul, div_mul_cancel₀ _ hα0]

theorem wc_proet_closed_push_isLeftAdjoint {X Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i]
    [IsLocallyNoetherian X] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (D : wcHMPullData i ℓ) (hD : wcHMPullCanonical D) :
    (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).IsLeftAdjoint :=
by
  classical

  have t_s1 : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
      [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
      (R : Sheaf J RingCat.{u+1}), IsGrothendieckAbelian.{u+1} (SheafOfModules.{u+1} R) := by
    intro C _ J _ _ R
    have s2 : HasSeparator (PresheafOfModules.{u+1} R.obj) := by
      let G : C → PresheafOfModules.{u+1} R.obj := fun X =>
        (PresheafOfModules.free.{u+1} R.obj).obj (uliftYoneda.{u+1}.obj X)
      have key : ∀ (X : C) (M N : PresheafOfModules.{u+1} R.obj) (φ : M ⟶ N) (h : G X ⟶ M),
          uliftYonedaEquiv.{u+1}
            ((PresheafOfModules.freeAdjunction.{u+1} R.obj).homEquiv _ N (h ≫ φ)) =
            φ.app (Opposite.op X) (uliftYonedaEquiv.{u+1}
              ((PresheafOfModules.freeAdjunction.{u+1} R.obj).homEquiv _ M h)) := by
        intro X M N φ h
        rw [Adjunction.homEquiv_naturality_right, uliftYonedaEquiv_comp]
        rfl
      have hsep : (ObjectProperty.ofObj G).IsSeparating := by
        intro M N f g hfg
        apply PresheafOfModules.hom_ext
        intro Y
        obtain ⟨X⟩ := Y
        ext m
        let e := ((PresheafOfModules.freeAdjunction.{u+1} R.obj).homEquiv
          (uliftYoneda.{u+1}.obj X) M).trans uliftYonedaEquiv.{u+1}
        have h1 := hfg _ (ObjectProperty.ofObj_apply G X) (e.symm m)
        have h2 := congrArg (fun k => uliftYonedaEquiv.{u+1}
          ((PresheafOfModules.freeAdjunction.{u+1} R.obj).homEquiv _ N k)) h1
        rw [key, key] at h2
        have h3 : uliftYonedaEquiv.{u+1}
            ((PresheafOfModules.freeAdjunction.{u+1} R.obj).homEquiv _ M (e.symm m)) = m :=
          e.apply_symm_apply m
        rw [h3] at h2
        exact h2
      exact HasSeparator.mk ⟨_, hsep.isSeparator_coproduct⟩
    have h5 : AB5OfSize.{u+1, u+1} (SheafOfModules.{u+1} R) :=
      ⟨fun K _ _ =>
        haveI := HasExactColimitsOfShape.domain_of_functor K
          (PresheafOfModules.toPresheaf.{u+1} R.obj)
        (PresheafOfModules.sheafificationAdjunction.{u+1} (𝟙 R.obj)).hasExactColimitsOfShape K⟩
    have hs : HasSeparator (SheafOfModules.{u+1} R) :=
      HasSeparator.of_adjunction (PresheafOfModules.sheafificationAdjunction.{u+1} (𝟙 R.obj))
    exact IsGrothendieckAbelian.mk.{u+1} (C := SheafOfModules.{u+1} R) inferInstance inferInstance h5 hs

  have t_s2 : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
      [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
      (R : Sheaf J RingCat.{u+1}),
      Limits.PreservesColimitsOfSize.{u+1, u+1} (SheafOfModules.toSheaf.{u+1} R) := by
    intro C _ J _ _ R
    constructor
    intro I _
    constructor
    intro K
    let adj := PresheafOfModules.sheafificationAdjunction (J := J) (𝟙 R.obj)
    haveI : IsIso adj.counit := inferInstance
    haveI hP : Limits.PreservesColimitsOfShape I
        (PresheafOfModules.sheafification (J := J) (𝟙 R.obj) ⋙ SheafOfModules.toSheaf.{u+1} R) :=
      Limits.preservesColimitsOfShape_of_natIso
        (PresheafOfModules.sheafificationCompToSheaf (J := J) (𝟙 R.obj)).symm
    let K₀ := K ⋙ (SheafOfModules.forget R ⋙ PresheafOfModules.restrictScalars (𝟙 R.obj))
    let c₀ := Limits.colimit.cocone K₀
    let h₀ : Limits.IsColimit c₀ := Limits.colimit.isColimit K₀
    have ht : Limits.IsColimit
        ((PresheafOfModules.sheafification (J := J) (𝟙 R.obj)).mapCocone c₀) :=
      Limits.isColimitOfPreserves _ h₀
    have ht' : Limits.IsColimit ((SheafOfModules.toSheaf.{u+1} R).mapCocone
        ((PresheafOfModules.sheafification (J := J) (𝟙 R.obj)).mapCocone c₀)) :=
      Limits.IsColimit.ofIsoColimit
        (Limits.isColimitOfPreserves
          (PresheafOfModules.sheafification (J := J) (𝟙 R.obj) ⋙ SheafOfModules.toSheaf.{u+1} R) h₀)
        (Functor.mapCoconeMapCocone c₀).symm
    haveI : Limits.PreservesColimit (K₀ ⋙ PresheafOfModules.sheafification (J := J) (𝟙 R.obj))
        (SheafOfModules.toSheaf.{u+1} R) :=
      Limits.preservesColimit_of_preserves_colimit_cocone ht ht'
    let e : K₀ ⋙ PresheafOfModules.sheafification (J := J) (𝟙 R.obj) ≅ K :=
      Functor.associator _ _ _ ≪≫ Functor.isoWhiskerLeft K (asIso adj.counit) ≪≫ Functor.rightUnitor K
    exact Limits.preservesColimit_of_iso_diagram _ e

  have t_s3d : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (J : GrothendieckTopology C)
      (K : GrothendieckTopology D) [HasSheafify J AddCommGrpCat.{u+1}]
      [HasSheafify K AddCommGrpCat.{u+1}]
      (G : C ⥤ D) {I : Type (u+1)} [Category.{u+1} I] (F : I ⥤ Sheaf K AddCommGrpCat.{u+1}),
      IsIso ((presheafToSheaf J AddCommGrpCat.{u+1}).map (Functor.whiskerLeft G.op
        (toSheafify K (Limits.colimit (F ⋙ sheafToPresheaf K AddCommGrpCat.{u+1}))))) →
      Limits.PreservesColimit F (sheafToPresheaf K AddCommGrpCat.{u+1} ⋙
        (Functor.whiskeringLeft Cᵒᵖ Dᵒᵖ AddCommGrpCat.{u+1}).obj G.op ⋙
          presheafToSheaf J AddCommGrpCat.{u+1}) := by
    intro C D _ _ J K _ _ G I _ F hiso
    let W := (Functor.whiskeringLeft Cᵒᵖ Dᵒᵖ AddCommGrpCat.{u+1}).obj G.op
    let a := presheafToSheaf J AddCommGrpCat.{u+1}
    let c := Limits.colimit.cocone (F ⋙ sheafToPresheaf K AddCommGrpCat.{u+1})
    let s := Sheaf.sheafifyCocone c
    have hs : Limits.IsColimit s := Sheaf.isColimitSheafifyCocone c (Limits.colimit.isColimit _)
    have hc' : Limits.IsColimit ((W ⋙ a).mapCocone c) :=
      Limits.isColimitOfPreserves (W ⋙ a) (Limits.colimit.isColimit _)
    apply Limits.preservesColimit_of_preserves_colimit_cocone hs
    refine Limits.IsColimit.ofIsoColimit hc' (Limits.Cocone.ext (@asIso _ _ _ _ _ hiso) ?_)
    intro k
    change a.map (W.map (c.ι.app k)) ≫ a.map (W.map (toSheafify K _)) =
      a.map (W.map ((s.ι.app k).hom))
    rw [Sheaf.sheafifyCocone_ι_app_val, ← a.map_comp, ← W.map_comp]
    rfl

  have t_s4 : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] {J : GrothendieckTopology C}
      {K : GrothendieckTopology D} (G : C ⥤ D) [G.IsContinuous J K] [HasSheafify J AddCommGrpCat.{u+1}]
      [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}] [HasSheafify K AddCommGrpCat.{u+1}]
      [K.WEqualsLocallyBijective AddCommGrpCat.{u+1}] (S : Sheaf J RingCat.{u+1})
      (R : Sheaf K RingCat.{u+1})
      (φ : S ⟶ (G.sheafPushforwardContinuous RingCat.{u+1} J K).obj R)
      [Limits.HasColimitsOfSize.{u+1, u+1} (SheafOfModules.{u+1} S)]
      [Limits.PreservesColimitsOfSize.{u+1, u+1} (SheafOfModules.toSheaf.{u+1} S)]
      [Limits.PreservesColimitsOfSize.{u+1, u+1} (SheafOfModules.toSheaf.{u+1} R)]
      [Limits.PreservesColimitsOfSize.{u+1, u+1} (sheafToPresheaf K AddCommGrpCat.{u+1} ⋙
        (Functor.whiskeringLeft Cᵒᵖ Dᵒᵖ AddCommGrpCat.{u+1}).obj G.op ⋙
          presheafToSheaf J AddCommGrpCat.{u+1})],
      Limits.PreservesColimitsOfSize.{u+1, u+1} (SheafOfModules.pushforward.{u+1} φ) := by
    intro C D _ _ J K G _ _ _ _ _ S R φ _ _ _ _
    have e1 : G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K ≅
        sheafToPresheaf K AddCommGrpCat.{u+1} ⋙
          (Functor.whiskeringLeft Cᵒᵖ Dᵒᵖ AddCommGrpCat.{u+1}).obj G.op ⋙
            presheafToSheaf J AddCommGrpCat.{u+1} :=
      (Functor.rightUnitor _).symm ≪≫
        Functor.isoWhiskerLeft _ (sheafificationNatIso J AddCommGrpCat.{u+1}) ≪≫
        (Functor.associator _ _ _).symm ≪≫
        Functor.isoWhiskerRight
          (G.sheafPushforwardContinuousCompSheafToPresheafIso AddCommGrpCat.{u+1} J K) _ ≪≫
        Functor.associator _ _ _
    constructor
    intro I _
    haveI : Limits.PreservesColimitsOfShape I
        (G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K) :=
      Limits.preservesColimitsOfShape_of_natIso e1.symm
    haveI : Limits.PreservesColimitsOfShape I
        (SheafOfModules.pushforward.{u+1} φ ⋙ SheafOfModules.toSheaf.{u+1} S) :=
      Limits.preservesColimitsOfShape_of_natIso (F := SheafOfModules.toSheaf.{u+1} R ⋙
        G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K) (Iso.refl _)
    haveI : Limits.ReflectsColimitsOfShape I (SheafOfModules.toSheaf.{u+1} S) :=
      Limits.reflectsColimitsOfShape_of_reflectsIsomorphisms
    exact Limits.preservesColimitsOfShape_of_reflects_of_preserves
      (SheafOfModules.pushforward.{u+1} φ) (SheafOfModules.toSheaf.{u+1} S)

  have c1 : ∀ (S : Scheme.{u}) (U : S.ProEt) (n : ℕ) (W : Fin n → S.ProEt) (f : ∀ k, W k ⟶ U),
      (∀ k, IsOpenImmersion (f k).left) → (∀ x : U.left, ∃ k, x ∈ Set.range (f k).left) →
      Sieve.generate (Presieve.ofArrows W f) ∈ Scheme.ProEt.topology S U := by
    intro S U n W f hf hsurj
    apply Precoverage.generate_mem_toGrothendieck
    show _ ∈ (Precoverage.comap (Scheme.ProEt.forget S ⋙ Over.forget S)
      Scheme.proetalePrecoverage).coverings U
    rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
    have hZ : Presieve.ofArrows (fun k => (W k).left) (fun k => (f k).left) ∈
        Scheme.zariskiPrecoverage.coverings U.left :=
      (Scheme.ofArrows_mem_precoverage_iff IsOpenImmersion).mpr ⟨hsurj, hf⟩
    exact (⟨Scheme.zariskiPrecoverage_le_qcPrecoverage U.left hZ, hZ.1,
      MorphismProperty.ofArrows_mem_precoverage.mpr (fun k => inferInstance)⟩ :
      Presieve.ofArrows (fun k => (W k).left) (fun k => (f k).left) ∈
        Scheme.proetalePrecoverage.coverings U.left)

  have c2 : ∀ (S : Scheme.{u}) (U : S.ProEt), IsAffine U.left → ∀ (R : Sieve U),
      R ∈ Scheme.ProEt.topology S U → ∃ (n : ℕ) (W : Fin n → S.ProEt) (h : ∀ k, W k ⟶ U),
        (∀ k, R.arrows (h k)) ∧ (∀ k, IsAffine (W k).left) ∧
        ∀ x : U.left, ∃ k, x ∈ Set.range (h k).left := by
    intro S U hU R hR
    have h1 := (CoverPreserving.of_isContinuous (Scheme.ProEt.forget S) (Scheme.ProEt.topology S)
      (Scheme.proetaleTopology.over S)).cover_preserve hR
    rw [GrothendieckTopology.mem_over_iff] at h1
    obtain ⟨R', hR', hle⟩ := Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition.mp h1
    obtain ⟨𝒰, hqc, rfl⟩ :=
      (Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover (P := @WeaklyEtale)).mp hR'
    haveI := hqc
    haveI : IsAffine ((Scheme.ProEt.forget S).obj U).left := hU
    obtain ⟨n, a, V, hV, hcov⟩ := QuasiCompactCover.exists_isAffineOpen_of_isCompact
      𝒰.toPreZeroHypercover (U := ⊤) (by rw [TopologicalSpace.Opens.coe_top]; exact isCompact_univ)
    have hwe : ∀ i, WeaklyEtale ((V i).ι ≫ 𝒰.f (a i) ≫ U.hom) := by
      intro i
      have h1 : WeaklyEtale (𝒰.f (a i)) := 𝒰.map_prop (a i)
      have h2 : WeaklyEtale U.hom := U.prop
      have h0 : WeaklyEtale (V i).ι := inferInstance
      have comp : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z), WeaklyEtale f → WeaklyEtale g →
          WeaklyEtale (f ≫ g) := by
        intro X Y Z f g _ _; infer_instance
      exact comp _ _ h0 (comp _ _ h1 h2)
    let W : Fin n → S.ProEt := fun i =>
      MorphismProperty.Over.mk ⊤ ((V i).ι ≫ 𝒰.f (a i) ≫ U.hom) (hwe i)
    let h : ∀ i, W i ⟶ U := fun i =>
      MorphismProperty.Over.homMk ((V i).ι ≫ 𝒰.f (a i)) (Category.assoc _ _ _) trivial
    refine ⟨n, W, h, ?_, ?_, ?_⟩
    · intro i
      have hmem : (Sieve.overEquiv _ (Sieve.functorPushforward (Scheme.ProEt.forget S) R)).arrows
          (𝒰.f (a i)) := by
        apply hle
        exact Presieve.ofArrows.mk (a i)
      rw [Sieve.overEquiv_iff] at hmem
      obtain ⟨Z, φ, ψ, hφ, heq⟩ := hmem
      have hl : 𝒰.f (a i) = ψ.left ≫ φ.left := congrArg (fun m => m.left) heq
      have hw : ψ.left ≫ Z.hom = 𝒰.f (a i) ≫ U.hom := Over.w ψ
      let k : W i ⟶ Z := MorphismProperty.Over.homMk ((V i).ι ≫ ψ.left)
        (by exact (Category.assoc _ _ _).trans (congrArg ((V i).ι ≫ ·) hw)) trivial
      have hk : k ≫ φ = h i := by
        apply MorphismProperty.Over.Hom.ext
        show ((V i).ι ≫ ψ.left) ≫ φ.left = (V i).ι ≫ 𝒰.f (a i)
        exact (Category.assoc _ _ _).trans (congrArg ((V i).ι ≫ ·) hl.symm)
      rw [← hk]
      exact R.downward_closed hφ k
    · intro i
      exact (hV i)
    · intro x
      have hx : (show ((Scheme.ProEt.forget S).obj U).left from x) ∈
          ⋃ i, (𝒰.f (a i)) '' ((V i : (𝒰.X (a i)).Opens) : Set (𝒰.X (a i))) := by
        rw [hcov]; trivial
      obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hx
      obtain ⟨z, hz, hzx⟩ := hi
      obtain ⟨w, rfl⟩ : z ∈ Set.range (V i).ι := by rw [Scheme.Opens.range_ι]; exact hz
      refine ⟨i, w, ?_⟩
      show ((V i).ι ≫ 𝒰.f (a i)) w = x
      rw [Scheme.Hom.comp_apply]
      exact hzx

  have c3 : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (J : GrothendieckTopology C)
      (K : GrothendieckTopology D) (G : C ⥤ D),
      (∀ (V : C) (R : Sieve (G.obj V)), R ∈ K (G.obj V) → ∃ S : Sieve V, S ∈ J V ∧
        ∀ (W : C) (f : W ⟶ V), S.arrows f →
