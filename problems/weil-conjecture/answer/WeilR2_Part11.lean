theorem wc_ybar_local_kunneth (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (D1 : wcHMPullData (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)) ℓ) (hD1 : wcHMPullCanonical D1)
    (D2 : wcHMPullData (Limits.pullback.snd (wcPi2 F X) (wcPi2 F X)) ℓ) (hD2 : wcHMPullCanonical D2)
    (I : InjectiveResolution
      (SheafOfModules.unit (wcRingSheaf (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ)))
    (q m : ℕ) (hq : q ≤ 2 * d) (e : Fin m → wcHM (wcXbar F X) ℓ q)
    (he : Function.Bijective
      (fun c : Fin m → ℚ_[ℓ] => ∑ a, wcHMScalar (wcXbar F X) ℓ q (c a) (e a)))
    (f : Fin m → (SheafOfModules.unit (wcRingSheaf (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ) ⟶
      I.cocomplex.X q))
    (hf : ∀ a, f a ≫ I.cocomplex.d q (q + 1) = 0)
    (hfe : ∀ a, @InjectiveResolution.extMk _ _ _ (HasExt.standard _) _ _ I q (f a) (q + 1) rfl (hf a) =
      wcHMPull D2 q (e a)) :
    (∀ (W : (wcXbar F X).ProEt)
        (s : (I.cocomplex.X q).val.obj
          (Opposite.op ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W))),
        ((I.cocomplex.d q (q + 1)).val.app
          (Opposite.op ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W))).hom s = 0 →
        Sieve.generate (fun (W' : (wcXbar F X).ProEt) (g : W' ⟶ W) =>
          ∃ (c : Fin m → (wcRingSheaf (wcXbar F X) ℓ).obj.obj (Opposite.op W'))
            (y : (I.cocomplex.X ((ComplexShape.up ℕ).prev q)).val.obj
              (Opposite.op ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W'))),
            ((I.cocomplex.X q).val.map
                ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).map g).op).hom s =
              ∑ a, ((f a).val.app (Opposite.op
                  ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W'))).hom
                ((D1.φ.hom.app (Opposite.op W')).hom (c a)) +
              ((I.cocomplex.d ((ComplexShape.up ℕ).prev q) q).val.app (Opposite.op
                ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W'))).hom y) ∈
          Scheme.ProEt.topology (wcXbar F X) W) ∧
    (∀ (W : (wcXbar F X).ProEt) (c : Fin m → (wcRingSheaf (wcXbar F X) ℓ).obj.obj (Opposite.op W))
        (y : (I.cocomplex.X ((ComplexShape.up ℕ).prev q)).val.obj
          (Opposite.op ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W))),
        ∑ a, ((f a).val.app (Opposite.op
            ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W))).hom
          ((D1.φ.hom.app (Opposite.op W)).hom (c a)) =
          ((I.cocomplex.d ((ComplexShape.up ℕ).prev q) q).val.app (Opposite.op
            ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W))).hom y →
        Sieve.generate (fun (W' : (wcXbar F X).ProEt) (g : W' ⟶ W) =>
          ∀ a, ((wcRingSheaf (wcXbar F X) ℓ).obj.map g.op).hom (c a) = 0) ∈
          Scheme.ProEt.topology (wcXbar F X) W) :=
by
  classical

  have hcov : ∀ W : (wcXbar F X).ProEt,
      Sieve.generate (fun (W' : (wcXbar F X).ProEt) (_ : W' ⟶ W) =>
        IsAffine W'.left ∧ IsClosed {x : W'.left | IsClosed ({x} : Set W'.left)} ∧
          (∀ x : W'.left, ∃! y : W'.left, IsClosed ({y} : Set W'.left) ∧ x ⤳ y) ∧
          ExtremallyDisconnected {x : W'.left | IsClosed ({x} : Set W'.left)} ∧
          (∀ x : W'.left, IsClosed ({x} : Set W'.left) →
            HenselianLocalRing (W'.left.presheaf.stalk x) ∧ IsSepClosed (W'.left.residueField x))) ∈
        Scheme.ProEt.topology (wcXbar F X) W := by
    intro W
    refine wc_proet_cover_of_affine_local (fun Δ : Scheme.{u} =>
      IsClosed {x : Δ | IsClosed ({x} : Set Δ)} ∧
        (∀ x : Δ, ∃! y : Δ, IsClosed ({y} : Set Δ) ∧ x ⤳ y) ∧
        ExtremallyDisconnected {x : Δ | IsClosed ({x} : Set Δ)} ∧
        (∀ x : Δ, IsClosed ({x} : Set Δ) →
          HenselianLocalRing (Δ.presheaf.stalk x) ∧ IsSepClosed (Δ.residueField x))) ?_ W
    intro V hV
    obtain ⟨Δ, δ, h1, h2, h3, h4, h5, h6, h7⟩ := wc_exists_wcontractible_cover V hV
    exact ⟨Δ, δ, h1, h2, h3, h4, h5, h6, h7⟩
  refine ⟨fun W s hs => ?_, fun W c y hcy => ?_⟩
  ·
    refine (Scheme.ProEt.topology (wcXbar F X)).superset_covering ?_ (hcov W)
    rw [Sieve.generate_le_iff]
    intro W' g hg
    have hs' : ((I.cocomplex.d q (q + 1)).val.app (Opposite.op
        ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W'))).hom
        (((I.cocomplex.X q).val.map
          ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).map g).op).hom s) = 0 := by
      refine (PresheafOfModules.naturality_apply (I.cocomplex.d q (q + 1)).val
        ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).map g).op s).trans ?_
      show ((I.cocomplex.X (q + 1)).val.map
          ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).map g).op).hom
        (((I.cocomplex.d q (q + 1)).val.app (Opposite.op
          ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W))).hom s) = 0
      rw [hs, map_zero]
    exact ⟨W', 𝟙 _, g,
      wc_ybar_wcontr_kunneth_gen F X d ℓ hℓ D1 hD1 D2 hD2 I q m hq e he f hf hfe W' hg _ hs',
      Category.id_comp g⟩
  ·
    refine (Scheme.ProEt.topology (wcXbar F X)).superset_covering ?_ (hcov W)
    rw [Sieve.generate_le_iff]
    intro W' g hg
    refine ⟨W', 𝟙 _, g, ?_, Category.id_comp g⟩
    have key : ∀ a, ((f a).val.app (Opposite.op
        ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W'))).hom
        ((D1.φ.hom.app (Opposite.op W')).hom
          (((wcRingSheaf (wcXbar F X) ℓ).obj.map g.op).hom (c a))) =
        ((I.cocomplex.X q).val.map
          ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).map g).op).hom
          (((f a).val.app (Opposite.op
            ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W))).hom
            ((D1.φ.hom.app (Opposite.op W)).hom (c a))) := by
      intro a
      have h1 : (D1.φ.hom.app (Opposite.op W')).hom
          (((wcRingSheaf (wcXbar F X) ℓ).obj.map g.op).hom (c a)) =
          ((wcRingSheaf (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ).obj.map
            ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).map g).op).hom
            ((D1.φ.hom.app (Opposite.op W)).hom (c a)) :=
        NatTrans.naturality_apply D1.φ.hom g.op (c a)
      rw [h1]
      exact PresheafOfModules.naturality_apply (f a).val
        ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).map g).op
        ((D1.φ.hom.app (Opposite.op W)).hom (c a))
    have hd : ((I.cocomplex.d ((ComplexShape.up ℕ).prev q) q).val.app (Opposite.op
        ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W'))).hom
        (((I.cocomplex.X ((ComplexShape.up ℕ).prev q)).val.map
          ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).map g).op).hom y) =
        ((I.cocomplex.X q).val.map
          ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).map g).op).hom
          (((I.cocomplex.d ((ComplexShape.up ℕ).prev q) q).val.app (Opposite.op
            ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W))).hom y) :=
      PresheafOfModules.naturality_apply _ _ _
    refine wc_ybar_wcontr_kunneth_ind F X d ℓ hℓ D1 hD1 D2 hD2 I q m hq e he f hf hfe W' hg
      (fun a => ((wcRingSheaf (wcXbar F X) ℓ).obj.map g.op).hom (c a))
      (((I.cocomplex.X ((ComplexShape.up ℕ).prev q)).val.map
        ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).map g).op).hom y) ?_
    beta_reduce
    rw [hd, ← hcy, map_sum]
    exact Finset.sum_congr rfl (fun a _ => key a)

theorem wc_ybar_leray_sheaf_free (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (D1 : wcHMPullData (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)) ℓ) (hD1 : wcHMPullCanonical D1)
    (I : InjectiveResolution
      (SheafOfModules.unit (wcRingSheaf (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ)))
    (q : ℕ) (hq : q ≤ 2 * d) :
    letI : (@SheafOfModules.pushforward _ _ _ _ _ _
        (wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))) _ _ D1.cont D1.φ).Additive :=
      @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D1.adj D1.additive
    ∃ (m : ℕ) (eq : wcHM (wcXbar F X) ℓ q ≃+ (Fin m → ℚ_[ℓ]))
      (ι : Fin m → (SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ) ⟶
        (((@SheafOfModules.pushforward _ _ _ _ _ _
            (wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))) _ _ D1.cont D1.φ).mapHomologicalComplex
            (ComplexShape.up ℕ)).obj I.cocomplex).homology q))
      (ρ : Fin m → ((((@SheafOfModules.pushforward _ _ _ _ _ _
            (wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))) _ _ D1.cont D1.φ).mapHomologicalComplex
            (ComplexShape.up ℕ)).obj I.cocomplex).homology q ⟶
        SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ))),
      (∀ (c : ℚ_[ℓ]) (x : wcHM (wcXbar F X) ℓ q),
        eq (wcHMScalar (wcXbar F X) ℓ q c x) = c • eq x) ∧
      (∀ a b : Fin m, ι a ≫ ρ b = if a = b then 𝟙 _ else 0) ∧ ∑ a, ρ a ≫ ι a = 𝟙 _ :=
by
  classical
  letI : (@SheafOfModules.pushforward _ _ _ _ _ _
      (wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))) _ _ D1.cont D1.φ).Additive :=
    @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D1.adj D1.additive

  have h : WeaklyEtale (Limits.pullback.fst X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F)
  obtain ⟨m, eC, heC⟩ := wc_coh_finite F X d ℓ hℓ h q
  obtain ⟨T, hTs, -⟩ := wc_hm_comparison F X h ℓ
  have hTinv : ∀ (c : ℚ_[ℓ]) (y : wcHM (wcXbar F X) ℓ q),
      (T q).symm (wcHMScalar (wcXbar F X) ℓ q c y) = wcCohScalar F X h ℓ q c ((T q).symm y) := by
    intro c y
    apply (T q).injective
    rw [AddEquiv.apply_symm_apply, hTs, AddEquiv.apply_symm_apply]
  obtain ⟨eq, heqdef⟩ : ∃ eq : wcHM (wcXbar F X) ℓ q ≃+ (Fin m → ℚ_[ℓ]),
      ∀ x, eq x = eC ((T q).symm x) := ⟨(T q).symm.trans eC, fun _ => rfl⟩
  have heq : ∀ (c : ℚ_[ℓ]) (x : wcHM (wcXbar F X) ℓ q),
