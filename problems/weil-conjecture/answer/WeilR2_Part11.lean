        simp only
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero p) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
      map_add' := fun x y => Abelian.Ext.add_comp x y _ _ }
  let E : Abelian.Ext (wcIntUnit S ℓ) (wcIntUnit S ℓ) p ≃+ M := Φ.trans Ψ



  letI smulA : SMul ℤ_[ℓ] (Abelian.Ext (wcIntUnit S ℓ) (wcIntUnit S ℓ) p) :=
    ⟨fun c x => E.symm (c • E x)⟩
  have hE : ∀ (c : ℤ_[ℓ]) (x : Abelian.Ext (wcIntUnit S ℓ) (wcIntUnit S ℓ) p),
      E (c • x) = c • E x :=
    fun c x => E.apply_symm_apply (c • E x)
  letI modA : Module ℤ_[ℓ] (Abelian.Ext (wcIntUnit S ℓ) (wcIntUnit S ℓ) p) :=
    Function.Injective.module ℤ_[ℓ] E.toAddMonoidHom E.injective hE
  exact ⟨modA, Module.Finite.equiv (E.toLinearEquiv hE).symm⟩

theorem wc_alg_closed_point_supp_class_nonzero (K : Type u) [Field K] [IsAlgClosed K]
    {Y : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n : ℕ) [SmoothOfRelativeDimension n pY]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (y₀ : Spec (.of K) ⟶ Y) (hy₀ : y₀ ≫ pY = 𝟙 _)
    (Dy : wcHMPullData y₀ ℓ) (hDy : wcHMPullCanonical Dy) :
    ∃ θ : wcSuppExt Dy (2 * n), wcSuppClass Dy (2 * n) θ ≠ 0 :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _

  obtain ⟨inst, hfin⟩ := wc_hm_int_fg K pY ℓ hℓ (2 * n)
  letI := inst
  haveI := hfin
  obtain ⟨e, he⟩ := (padic_fg_torsion_primitive ℓ
    (Abelian.Ext (wcIntUnit Y ℓ) (wcIntUnit Y ℓ) (2 * n))).1

  have hvan := wc_ac_int_tors_succ_top_vanish K pY n ℓ hℓ
  obtain ⟨hf1, hle1, hge⟩ := wc_ac_int_tors_top_card K pY n ℓ hℓ
  obtain ⟨b, hb⟩ :=
    wc_int_tors_ext_growth_of_card Y ℓ (wcIntUnit Y ℓ) (2 * n) hvan hf1 hle1 hge e

  have hS' : (ShortComplex.mk (Limits.kernel.ι (wcIntSuppπ Dy)) (wcIntSuppπ Dy)
      (Limits.kernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel _)
      (inferInstance : Mono (Limits.kernel.ι (wcIntSuppπ Dy)))
      (inferInstance : Epi (Limits.factorThruImage (wcIntSuppMap Dy)))

  have hvanC : ∀ w : Abelian.Ext (wcIntSuppObj Dy) (wcIntTors Y ℓ 1) (2 * n + 1), w = 0 := by
    intro w
    have h0 : (Abelian.Ext.mk₀ (wcIntSuppπ Dy)).comp w (zero_add (2 * n + 1)) = 0 := hvan _
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS' (wcIntTors Y ℓ 1) w h0
      (by omega : 1 + 2 * n = 2 * n + 1)
    rw [← hx₁, wc_ac_int_supp_kernel_tors_vanish K pY n ℓ hℓ y₀ hy₀ Dy hDy 1 le_rfl x₁,
      Abelian.Ext.comp_zero]

  have h0b : (Abelian.Ext.mk₀ (Limits.kernel.ι (wcIntSuppπ Dy))).comp b (zero_add (2 * n)) = 0 :=
    wc_ac_int_supp_kernel_tors_vanish K pY n ℓ hℓ y₀ hy₀ Dy hDy (e + 1) (by omega) _
  obtain ⟨a₀, ha₀⟩ :=
    Abelian.Ext.contravariant_sequence_exact₂ hS' (wcIntTors Y ℓ (e + 1)) b h0b

  have hlift := wc_int_tors_ext_lift_of_vanish Y ℓ (wcIntSuppObj Dy) (2 * n) hvanC
  choose f hf using hlift
  let a : ∀ k : ℕ, Abelian.Ext (wcIntSuppObj Dy) (wcIntTors Y ℓ (e + 1 + k)) (2 * n) :=
    fun k => Nat.rec
      (motive := fun k => Abelian.Ext (wcIntSuppObj Dy) (wcIntTors Y ℓ (e + 1 + k)) (2 * n))
      a₀ (fun k ak => f (e + 1 + k) (by omega) ak) k
  have ha : ∀ (k : ℕ) (t : wcIntTors Y ℓ (e + 1 + k + 1) ⟶ wcIntTors Y ℓ (e + 1 + k)),
      Limits.cokernel.π ((ℓ ^ (e + 1 + k + 1) : ℕ) • 𝟙 (wcIntUnit Y ℓ)) ≫ t =
        Limits.cokernel.π ((ℓ ^ (e + 1 + k) : ℕ) • 𝟙 (wcIntUnit Y ℓ)) →
      (a (k + 1)).comp (Abelian.Ext.mk₀ t) (add_zero (2 * n)) = a k := by
    intro k t ht
    exact hf (e + 1 + k) (by omega) (a k) t ht

  obtain ⟨θz, hθz⟩ := wc_int_ext_tower_milnor Y ℓ (wcIntSuppObj Dy) (2 * n) (e + 1) a ha
  have hθ0 : θz.comp (Abelian.Ext.mk₀
      (Limits.cokernel.π ((ℓ ^ (e + 1) : ℕ) • 𝟙 (wcIntUnit Y ℓ)))) (add_zero (2 * n)) = a₀ :=
    hθz 0

  obtain ⟨y, hy⟩ : ∃ y : Abelian.Ext (wcIntUnit Y ℓ) (wcIntUnit Y ℓ) (2 * n),
      y = (Abelian.Ext.mk₀ (wcIntSuppπ Dy)).comp θz (zero_add (2 * n)) := ⟨_, rfl⟩
  have hred : y.comp (Abelian.Ext.mk₀
      (Limits.cokernel.π ((ℓ ^ (e + 1) : ℕ) • 𝟙 (wcIntUnit Y ℓ)))) (add_zero (2 * n)) = b := by
    rw [hy, Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (wcIntSuppπ Dy)) θz
      (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ (e + 1) : ℕ) • 𝟙 (wcIntUnit Y ℓ))))
      (zero_add (2 * n)) (add_zero (2 * n)) (by omega), hθ0]
    exact ha₀

  obtain ⟨rat, ratB, hsq, hker⟩ := wc_ac_int_supp_rational K pY n ℓ hℓ y₀ hy₀ Dy hDy
  refine ⟨rat θz, fun h0 => ?_⟩
  have hy0 : ratB y = 0 := by rw [hy, ← hsq θz]; exact h0
  obtain ⟨r, hr⟩ := hker y hy0
  have hey : ℓ ^ e • y = 0 := he y ⟨r, hr⟩
  apply hb
  rw [← hred]
  have hpost := map_nsmul ((Abelian.Ext.mk₀
      (Limits.cokernel.π ((ℓ ^ (e + 1) : ℕ) • 𝟙 (wcIntUnit Y ℓ)))).postcomp
        (wcIntUnit Y ℓ) (add_zero (2 * n))) (ℓ ^ e) y
  rw [hey, map_zero] at hpost
  exact hpost.symm

theorem wc_closed_supp_point_restriction (K : Type u) [Field K]
    {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i] [IsLocallyNoetherian Y]
    (z₀ : Spec (.of K) ⟶ Z) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (Dy : wcHMPullData (z₀ ≫ i) ℓ) (hDy : wcHMPullCanonical Dy) :
    ∃ q : wcSuppObj Di ⟶ wcSuppObj Dy, wcSuppUnitMap Di ≫ q = wcSuppUnitMap Dy :=
by
  classical


  have s1 : ∀ {X : Scheme.{u}} {j : X ⟶ Y} (D : wcHMPullData j ℓ),
      ∃ u : C(↥X, ULift.{u+1} ℚ_[ℓ]), IsUnit u ∧ ∀ V : Y.ProEt,
        ((SheafOfModules.unitHomEquiv _ (wcSuppUnitMap D)).1 (Opposite.op V) :
            C(↥(Limits.pullback V.hom j), ULift.{u+1} ℚ_[ℓ])) =
          u.comp (Limits.pullback.snd V.hom j).base.hom := by
    intro X j D
    haveI := D.cont
    let T : Y.ProEt := MorphismProperty.Over.mk ⊤ (𝟙 Y) (inferInstance : WeaklyEtale (𝟙 Y))
    let σ := SheafOfModules.unitHomEquiv (wcSuppObj D) (wcSuppUnitMap D)
    let v : C(↥(Limits.pullback (𝟙 Y) j), ULift.{u+1} ℚ_[ℓ]) := σ.1 (Opposite.op T)
    let u : C(↥X, ULift.{u+1} ℚ_[ℓ]) := v.comp (inv (Limits.pullback.snd (𝟙 Y) j)).base.hom
    have hfac : ∀ V : Y.ProEt,
        (σ.1 (Opposite.op V) : C(↥(Limits.pullback V.hom j), ULift.{u+1} ℚ_[ℓ])) =
          u.comp (Limits.pullback.snd V.hom j).base.hom := by
      intro V
      let τ : V ⟶ T := MorphismProperty.Over.homMk (B := T) V.hom (Category.comp_id _) trivial
      have h1 : (v.comp ((wcProEtBC j).map τ).left.base.hom :
          C(↥(Limits.pullback V.hom j), ULift.{u+1} ℚ_[ℓ])) =
          (σ.1 (Opposite.op V) : C(↥(Limits.pullback V.hom j), ULift.{u+1} ℚ_[ℓ])) :=
        PresheafOfModules.sections_property σ τ.op
      have hw : ((wcProEtBC j).map τ).left ≫ Limits.pullback.snd (𝟙 Y) j =
          Limits.pullback.snd V.hom j :=
        MorphismProperty.Over.w ((wcProEtBC j).map τ)
      have key : ((wcProEtBC j).map τ).left =
          Limits.pullback.snd V.hom j ≫ inv (Limits.pullback.snd (𝟙 Y) j) :=
        (IsIso.eq_comp_inv (Limits.pullback.snd (𝟙 Y) j)).mpr hw
      refine h1.symm.trans ?_
      apply ContinuousMap.ext
      intro p
      exact congrArg (fun f : Limits.pullback V.hom j ⟶ Limits.pullback (𝟙 Y) j =>
        v (f.base p)) key
    let ones : (wcSuppObj D).val.sections :=
      PresheafOfModules.sectionsMk (M := (wcSuppObj D).val)
        (fun W => (1 : C(↥(Limits.pullback W.unop.hom j), ULift.{u+1} ℚ_[ℓ])))
        (fun _ _ _ => rfl)
    let ρ₁ : SheafOfModules.unit (wcRingSheaf Y ℓ) ⟶
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC j) _ _ D.cont D.φ).obj
          (SheafOfModules.unit (wcRingSheaf X ℓ)) :=
      (SheafOfModules.unitHomEquiv (wcSuppObj D)).symm ones
    let c : SheafOfModules.unit (wcRingSheaf X ℓ) ⟶ SheafOfModules.unit (wcRingSheaf X ℓ) :=
      D.μ.inv ≫ (D.adj.homEquiv _ _).symm ρ₁
    have h2 : wcSuppUnitMap D = D.adj.homEquiv _ _ D.μ.hom :=
      (D.adj.homEquiv_unit _ _ _).symm
    have hc : wcSuppUnitMap D ≫
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC j) _ _ D.cont D.φ).map c = ρ₁ := by
      rw [h2]
      refine (D.adj.homEquiv_naturality_right D.μ.hom c).symm.trans ?_
      have e3 : D.μ.hom ≫ c = (D.adj.homEquiv _ _).symm ρ₁ := Iso.hom_inv_id_assoc _ _
      rw [e3, Equiv.apply_symm_apply]
    let W : X.ProEt := (wcProEtBC j).obj T
    let h : C(↥(Limits.pullback (𝟙 Y) j), ULift.{u+1} ℚ_[ℓ]) :=
      (c.val.app (Opposite.op W)).hom (1 : C(↥(Limits.pullback (𝟙 Y) j), ULift.{u+1} ℚ_[ℓ]))
    have eR : (SheafOfModules.unitHomEquiv (wcSuppObj D) ρ₁).1 (Opposite.op T) =
        (1 : C(↥(Limits.pullback (𝟙 Y) j), ULift.{u+1} ℚ_[ℓ])) := by
      show (SheafOfModules.unitHomEquiv (wcSuppObj D)
        ((SheafOfModules.unitHomEquiv (wcSuppObj D)).symm ones)).1 (Opposite.op T) = _
      rw [Equiv.apply_symm_apply]
      rfl
    have eL : (SheafOfModules.unitHomEquiv (wcSuppObj D) (wcSuppUnitMap D ≫
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC j) _ _ D.cont D.φ).map c)).1
          (Opposite.op T) = (c.val.app (Opposite.op W)).hom v := rfl
    have eLin : (c.val.app (Opposite.op W)).hom v = v * h := by
      have hs := (c.val.app (Opposite.op W)).hom.map_smul
        (v : (wcRingSheaf X ℓ).obj.obj (Opposite.op W))
        (1 : C(↥(Limits.pullback (𝟙 Y) j), ULift.{u+1} ℚ_[ℓ]))
      exact (congrArg (fun x => (c.val.app (Opposite.op W)).hom x) (mul_one v).symm).trans hs
    have hvh : v * h = 1 :=
      eLin.symm.trans (eL.symm.trans ((congrArg
        (fun f => (SheafOfModules.unitHomEquiv (wcSuppObj D) f).1 (Opposite.op T)) hc).trans eR))
    refine ⟨u, ?_, hfac⟩
    refine isUnit_iff_exists_inv.mpr
      ⟨h.comp (inv (Limits.pullback.snd (𝟙 Y) j)).base.hom, ?_⟩
    show v.comp (inv (Limits.pullback.snd (𝟙 Y) j)).base.hom *
      h.comp (inv (Limits.pullback.snd (𝟙 Y) j)).base.hom = 1
    rw [← ContinuousMap.mul_comp, hvh, ContinuousMap.one_comp]

  obtain ⟨ui, hui, hsi⟩ := s1 Di
  obtain ⟨uy, -, hsy⟩ := s1 Dy
  obtain ⟨w, hw⟩ : ∃ w : C(↥Z, ULift.{u+1} ℚ_[ℓ]), ui * w = 1 := ⟨_, hui.mul_val_inv⟩
  let c : C(↥(Spec (.of K)), ULift.{u+1} ℚ_[ℓ]) := uy * w.comp z₀.base.hom

  let κ : ∀ V : Y.ProEt, Limits.pullback V.hom (z₀ ≫ i) ⟶ Limits.pullback V.hom i := fun V =>
    Limits.pullback.lift (Limits.pullback.fst V.hom (z₀ ≫ i))
      (Limits.pullback.snd V.hom (z₀ ≫ i) ≫ z₀)
      (Limits.pullback.condition.trans (Category.assoc _ _ _).symm)
  have hκ1 : ∀ V : Y.ProEt,
      κ V ≫ Limits.pullback.fst V.hom i = Limits.pullback.fst V.hom (z₀ ≫ i) :=
    fun V => Limits.pullback.lift_fst _ _ _
  have hκ2 : ∀ V : Y.ProEt,
      κ V ≫ Limits.pullback.snd V.hom i = Limits.pullback.snd V.hom (z₀ ≫ i) ≫ z₀ :=
    fun V => Limits.pullback.lift_snd _ _ _

  have hL1 : ∀ {W : Scheme.{u}} (g : W ⟶ Y) {V V' : Y.ProEt} (h : V' ⟶ V),
      ((wcProEtBC g).map h).left ≫ Limits.pullback.fst V.hom g =
        Limits.pullback.fst V'.hom g ≫ h.left :=
    by intro W g V V' h; exact Limits.pullback.lift_fst _ _ _
  have hL2 : ∀ {W : Scheme.{u}} (g : W ⟶ Y) {V V' : Y.ProEt} (h : V' ⟶ V),
      ((wcProEtBC g).map h).left ≫ Limits.pullback.snd V.hom g = Limits.pullback.snd V'.hom g :=
    by intro W g V V' h; exact MorphismProperty.Over.w ((wcProEtBC g).map h)

  let F : ∀ V : Y.ProEt, C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ]) →
      C(↥(Limits.pullback V.hom (z₀ ≫ i)), ULift.{u+1} ℚ_[ℓ]) :=
    fun V s => s.comp (κ V).base.hom * c.comp (Limits.pullback.snd V.hom (z₀ ≫ i)).base.hom
  have Fadd : ∀ (V : Y.ProEt) (s t : C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ])),
      F V (s + t) = F V s + F V t := by
    intro V s t
    simp only [F, ContinuousMap.add_comp, add_mul]
  have Fsmul : ∀ (V : Y.ProEt) (r : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))
      (s : C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ])),
      F V (r.comp (Limits.pullback.fst V.hom i).base.hom * s) =
        r.comp (Limits.pullback.fst V.hom (z₀ ≫ i)).base.hom * F V s := by
    intro V r s
    apply ContinuousMap.ext
    intro p
    have h1 : (Limits.pullback.fst V.hom i).base.hom ((κ V).base.hom p) =
        (Limits.pullback.fst V.hom (z₀ ≫ i)).base.hom p :=
      congrArg (fun g : Limits.pullback V.hom (z₀ ≫ i) ⟶ V.left => g.base.hom p) (hκ1 V)
    simp only [F, ContinuousMap.mul_apply, ContinuousMap.comp_apply, h1, mul_assoc]
  have Fnat : ∀ {V V' : Y.ProEt} (h : V' ⟶ V)
      (s : C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ])),
      F V' (s.comp ((wcProEtBC i).map h).left.base.hom) =
        (F V s).comp ((wcProEtBC (z₀ ≫ i)).map h).left.base.hom := by
    intro V V' h s
    have key1 : κ V' ≫ ((wcProEtBC i).map h).left =
        ((wcProEtBC (z₀ ≫ i)).map h).left ≫ κ V := by
      apply Limits.pullback.hom_ext
      · exact (Category.assoc _ _ _).trans ((whisker_eq (κ V') (hL1 i h)).trans
          ((Category.assoc _ _ _).symm.trans ((eq_whisker (hκ1 V') h.left).trans
            ((hL1 (z₀ ≫ i) h).symm.trans ((whisker_eq _ (hκ1 V)).symm.trans
              (Category.assoc _ _ _).symm)))))
      · exact (Category.assoc _ _ _).trans ((whisker_eq (κ V') (hL2 i h)).trans
          ((hκ2 V').trans ((eq_whisker (hL2 (z₀ ≫ i) h).symm z₀).trans
            ((Category.assoc _ _ _).trans ((whisker_eq _ (hκ2 V)).symm.trans
              (Category.assoc _ _ _).symm)))))
    have key2 := hL2 (z₀ ≫ i) h
    apply ContinuousMap.ext
    intro p
    have e1 : s (((wcProEtBC i).map h).left.base.hom ((κ V').base.hom p)) =
        s ((κ V).base.hom (((wcProEtBC (z₀ ≫ i)).map h).left.base.hom p)) :=
      congrArg (fun g : Limits.pullback V'.hom (z₀ ≫ i) ⟶ Limits.pullback V.hom i =>
        s (g.base.hom p)) key1
    have e2 : c ((Limits.pullback.snd V'.hom (z₀ ≫ i)).base.hom p) =
        c ((Limits.pullback.snd V.hom (z₀ ≫ i)).base.hom
          (((wcProEtBC (z₀ ≫ i)).map h).left.base.hom p)) :=
      congrArg (fun g : Limits.pullback V'.hom (z₀ ≫ i) ⟶ Spec (.of K) =>
        c (g.base.hom p)) key2.symm
    show s (((wcProEtBC i).map h).left.base.hom ((κ V').base.hom p)) *
        c ((Limits.pullback.snd V'.hom (z₀ ≫ i)).base.hom p) =
      s ((κ V).base.hom (((wcProEtBC (z₀ ≫ i)).map h).left.base.hom p)) *
        c ((Limits.pullback.snd V.hom (z₀ ≫ i)).base.hom
          (((wcProEtBC (z₀ ≫ i)).map h).left.base.hom p))
    rw [e1, e2]

  let G : ∀ V : Y.ProEt,
      (wcSuppObj Di).val.obj (Opposite.op V) →+ (wcSuppObj Dy).val.obj (Opposite.op V) :=
    fun V => AddMonoidHom.mk' (F V) (Fadd V)
  let qa : (PresheafOfModules.toPresheaf _).obj (wcSuppObj Di).val ⟶
      (PresheafOfModules.toPresheaf _).obj (wcSuppObj Dy).val :=
    { app := fun X => AddCommGrpCat.ofHom (G X.unop)
      naturality := fun {X X'} f => by
        ext s
        exact Fnat f.unop s }
  let qp : (wcSuppObj Di).val ⟶ (wcSuppObj Dy).val :=
    PresheafOfModules.homMk qa (fun X r s => by
      obtain ⟨V⟩ := X
      show F V (@HMul.hMul C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ])
          C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ])
          C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ]) _
          ((Di.φ.hom.app (Opposite.op V)).hom r) s) =
        @HMul.hMul C(↥(Limits.pullback V.hom (z₀ ≫ i)), ULift.{u+1} ℚ_[ℓ])
          C(↥(Limits.pullback V.hom (z₀ ≫ i)), ULift.{u+1} ℚ_[ℓ])
          C(↥(Limits.pullback V.hom (z₀ ≫ i)), ULift.{u+1} ℚ_[ℓ]) _
          ((Dy.φ.hom.app (Opposite.op V)).hom r) (F V s)
      rw [hDi V r, hDy V r]
      exact Fsmul V r s)
  refine ⟨⟨qp⟩, ?_⟩
  apply (SheafOfModules.unitHomEquiv (wcSuppObj Dy)).injective
  apply Subtype.ext
  funext X
  obtain ⟨V⟩ := X
  change F V ((SheafOfModules.unitHomEquiv (wcSuppObj Di) (wcSuppUnitMap Di)).1
      (Opposite.op V)) =
    (SheafOfModules.unitHomEquiv (wcSuppObj Dy) (wcSuppUnitMap Dy)).1 (Opposite.op V)
  rw [hsi V, hsy V]
  apply ContinuousMap.ext
  intro p
  have h2 : (Limits.pullback.snd V.hom i).base.hom ((κ V).base.hom p) =
      z₀.base.hom ((Limits.pullback.snd V.hom (z₀ ≫ i)).base.hom p) :=
    congrArg (fun g : Limits.pullback V.hom (z₀ ≫ i) ⟶ Z => g.base.hom p) (hκ2 V)
  have h3 : ∀ x : ↥Z, ui x * w x = 1 := fun x => by
    have := congrArg (fun g : C(↥Z, ULift.{u+1} ℚ_[ℓ]) => g x) hw
    simpa only [ContinuousMap.mul_apply, ContinuousMap.one_apply] using this
  simp only [F, c, ContinuousMap.mul_apply, ContinuousMap.comp_apply, h2]
  rw [mul_left_comm, h3, mul_one]

theorem wc_supp_ext_scalar_central {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (k : ℕ) (τ : wcSuppExt Di k) (c : ℚ_[ℓ]) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
    (Abelian.Ext.mk₀
      ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).map
        (wcHMConst Z ℓ c))).comp τ (zero_add k) =
      τ.comp (Abelian.Ext.mk₀ (wcHMConst Y ℓ c)) (add_zero k) :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _

  have hcommY : ∀ (X : (Y.ProEt)ᵒᵖ) (a b : (wcRingSheaf Y ℓ).obj.obj X), a * b = b * a := by
    intro X a b
    exact @mul_comm C(↥(Opposite.unop X).left, ULift.{u+1} ℚ_[ℓ]) _ a b
  have hcommZ : ∀ (X : (Z.ProEt)ᵒᵖ) (a b : (wcRingSheaf Z ℓ).obj.obj X), a * b = b * a := by
    intro X a b
    exact @mul_comm C(↥(Opposite.unop X).left, ULift.{u+1} ℚ_[ℓ]) _ a b

  let κZ : ∀ W : (Z.ProEt)ᵒᵖ, (wcRingSheaf Z ℓ).obj.obj W := fun W =>
    (ContinuousMap.const (↥(Opposite.unop W).left) (ULift.up c) :
      C(↥(Opposite.unop W).left, ULift.{u+1} ℚ_[ℓ]))
  have hZc : ∀ (W : (Z.ProEt)ᵒᵖ) (x : (wcRingSheaf Z ℓ).obj.obj W),
      ((ConcreteCategory.hom ((wcHMConst Z ℓ c).val.app W)) x : (wcRingSheaf Z ℓ).obj.obj W) =
        x * κZ W := by
    intro W x
    have h1 := map_smul (ConcreteCategory.hom ((wcHMConst Z ℓ c).val.app W)) x
      (1 : (wcRingSheaf Z ℓ).obj.obj W)
    have h2 := SheafOfModules.unitHomEquiv_apply_coe (SheafOfModules.unit (wcRingSheaf Z ℓ))
      (wcHMConst Z ℓ c) W
    have h3 : ((SheafOfModules.unit (wcRingSheaf Z ℓ)).unitHomEquiv (wcHMConst Z ℓ c)).1 W =
        κZ W := by
      simp only [wcHMConst, Equiv.apply_symm_apply]
      rfl
    exact (congrArg (ConcreteCategory.hom ((wcHMConst Z ℓ c).val.app W)) (mul_one x).symm).trans
      (h1.trans (congrArg (fun y => x • y) (h3.symm.trans h2).symm))

  have hext : ∃ m : 𝟭 (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) ⟶ 𝟭 (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)),
      m.app (SheafOfModules.unit (wcRingSheaf Y ℓ)) = wcHMConst Y ℓ c ∧
      m.app (wcSuppObj Di) =
        (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).map
          (wcHMConst Z ℓ c) := by
    let R := wcRingSheaf Y ℓ
    let s := (SheafOfModules.unit R).unitHomEquiv (wcHMConst Y ℓ c)
    let σ : ∀ X : (Y.ProEt)ᵒᵖ, R.obj.obj X := fun X => (s.1 X : R.obj.obj X)
    have hσ : ∀ {X Y : (Y.ProEt)ᵒᵖ} (f : X ⟶ Y), (R.obj.map f).hom (σ X) = σ Y :=
      fun f => PresheafOfModules.sections_property s f
    have hσc : ∀ X : (Y.ProEt)ᵒᵖ, σ X =
        (ContinuousMap.const _ (ULift.up c) : C(↥(Opposite.unop X).left, ULift.{u+1} ℚ_[ℓ])) := by
      intro X
      simp only [σ, s, R, wcHMConst, Equiv.apply_symm_apply]
      rfl
    let L : ∀ (M : SheafOfModules.{u+1} R) (X : (Y.ProEt)ᵒᵖ), M.val.obj X ⟶ M.val.obj X :=
      fun M X => ModuleCat.ofHom
        { toFun := fun x => σ X • x
          map_add' := fun x y => smul_add _ _ _
          map_smul' := fun r x => by
            simp only [RingHom.id_apply, smul_smul]
            rw [hcommY X] }
    let mM : ∀ M : SheafOfModules.{u+1} R, M ⟶ M := fun M =>
      ⟨PresheafOfModules.Hom.mk (L M) (by
        intro X Y f
        ext x
        show σ Y • (M.val.map f).hom x = (M.val.map f).hom (σ X • x)
        rw [PresheafOfModules.map_smul, hσ])⟩
    refine ⟨{ app := mM, naturality := ?_ }, ?_, ?_⟩
    · intro M N g
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro X
      ext x
      show σ X • (g.val.app X).hom x = (g.val.app X).hom (σ X • x)
      exact ((g.val.app X).hom.map_smul _ _).symm
    · apply (SheafOfModules.unit R).unitHomEquiv.injective
      apply PresheafOfModules.sections_ext
      intro X
      rw [SheafOfModules.unitHomEquiv_apply_coe]
      show σ X • (1 : R.obj.obj X) = s.1 X
      rw [smul_eq_mul, mul_one]
    · apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro X
      obtain ⟨V⟩ := X
      ext x
      let x' : (wcRingSheaf Z ℓ).obj.obj (Opposite.op ((wcProEtBC i).obj V)) := x
      show @HMul.hMul ((wcRingSheaf Z ℓ).obj.obj (Opposite.op ((wcProEtBC i).obj V)))
          ((wcRingSheaf Z ℓ).obj.obj (Opposite.op ((wcProEtBC i).obj V)))
          ((wcRingSheaf Z ℓ).obj.obj (Opposite.op ((wcProEtBC i).obj V))) _
          ((Di.φ.hom.app (Opposite.op V)).hom (σ (Opposite.op V))) x' =
        (ConcreteCategory.hom ((wcHMConst Z ℓ c).val.app
          (Opposite.op ((wcProEtBC i).obj V)))) x'
      rw [hσc (Opposite.op V), hDi V, ContinuousMap.const_comp, hZc]
      exact hcommZ _ _ _

  obtain ⟨m, hm1, hm2⟩ := hext
  have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp τ m
  simp only [Abelian.Ext.id_mapExactFunctor] at h
  rw [hm1, hm2] at h
  exact h.symm

theorem wc_closed_supp_kernel_free {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i]
    [IsLocallyNoetherian Y] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (Di : wcHMPullData i ℓ)
    (hDi : wcHMPullCanonical Di)
    (L : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1} ⥤ SheafOfModules.{u+1} (wcRingSheaf Y ℓ))
    (adj : L ⊣ SheafOfModules.toSheaf (wcRingSheaf Y ℓ))
    [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L]
    (O : Y.Opens) (hO : (O : Set Y) = (Set.range i)ᶜ) :
    ∃ (ε : L.obj (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) ≅ SheafOfModules.unit (wcRingSheaf Y ℓ))
      (h : (L.map (wcFreeSheafMap Y (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y))) ≫ ε.hom) ≫ wcSuppUnitMap Di = 0),
      (ShortComplex.mk (L.map (wcFreeSheafMap Y (MorphismProperty.Over.homMk O.ι (Category.comp_id _)
          trivial : Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y))) ≫ ε.hom)
        (wcSuppUnitMap Di) h).Exact :=
by
  classical
  let T : Y.ProEt := Scheme.ProEt.mk (𝟙 Y)
  let O' : Y.ProEt := Scheme.ProEt.mk O.ι
  let ι : O' ⟶ T := MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial

  have hT : Limits.IsTerminal T :=
    Limits.IsTerminal.ofUniqueHom
      (fun Y' => MorphismProperty.Over.homMk Y'.hom (Category.comp_id _) trivial)
      (fun Y' m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id _).symm.trans (MorphismProperty.Over.w m)))

  obtain ⟨ε', hε'⟩ : ∃ ε' : wcFreeSheaf Y T ⟶
      (SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).obj
        (SheafOfModules.unit (wcRingSheaf Y ℓ)),
      ∀ M : SheafOfModules (wcRingSheaf Y ℓ),
        Function.Bijective (fun f : SheafOfModules.unit (wcRingSheaf Y ℓ) ⟶ M =>
          ε' ≫ (SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).map f) :=
    sheafOfModules_unit_corepresented_by_free_terminal
      (Scheme.ProEt.topology Y) (wcRingSheaf Y ℓ) T hT
  obtain ⟨φ, hφ⟩ : ∃ φ : L.obj (wcFreeSheaf Y T) ⟶
      SheafOfModules.unit (wcRingSheaf Y ℓ), adj.homEquiv _ _ φ = ε' :=
    ⟨_, Equiv.apply_symm_apply _ _⟩
  have hφiso : IsIso φ := by
    apply isIso_of_coyoneda_map_bijective
    intro N
    have key : (fun x : SheafOfModules.unit (wcRingSheaf Y ℓ) ⟶ N => φ ≫ x) =
        (adj.homEquiv _ _).symm ∘
          (fun f => ε' ≫ (SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).map f) := by
      funext x
      apply (adj.homEquiv _ _).injective
      rw [Function.comp_apply, Equiv.apply_symm_apply, Adjunction.homEquiv_naturality_right, hφ]
    rw [key]
    exact (adj.homEquiv _ _).symm.bijective.comp (hε' N)
  suffices H : ∀ σ : L.obj (wcFreeSheaf Y O') ⟶
      SheafOfModules.unit (wcRingSheaf Y ℓ),
      σ = L.map (wcFreeSheafMap Y ι) ≫ φ →
      ∃ (h : σ ≫ wcSuppUnitMap Di = 0), (ShortComplex.mk σ (wcSuppUnitMap Di) h).Exact by
    obtain ⟨h, hex⟩ := H _ rfl
    exact ⟨asIso φ, h, hex⟩
  intro σ hσ
  obtain ⟨η, hηU, hηN⟩ := wc_proet_free_sheaf_yoneda Y

  have hempty : IsEmpty ↥(Limits.pullback O.ι i) := by
    constructor
    intro p
    have h1 : O.ι (Limits.pullback.fst O.ι i p) = i (Limits.pullback.snd O.ι i p) := by
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
    have h2 : O.ι (Limits.pullback.fst O.ι i p) ∈ (O : Set Y) := by
      rw [← Scheme.Opens.range_ι]; exact ⟨_, rfl⟩
    rw [hO, h1] at h2
    exact h2 ⟨_, rfl⟩
  have hsub : ∀ x y : ((SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).obj
      (wcSuppObj Di)).obj.obj (Opposite.op O'), x = y := by
    intro x y
    let x' : C(↥(Limits.pullback O.ι i), ULift.{u+1} ℚ_[ℓ]) := x
    let y' : C(↥(Limits.pullback O.ι i), ULift.{u+1} ℚ_[ℓ]) := y
    show x' = y'
    exact ContinuousMap.ext fun p => (hempty.false p).elim
  have hσρ : σ ≫ wcSuppUnitMap Di = 0 := by
    apply (adj.homEquiv _ _).injective
    exact (hηU O' _ 0).unique (hsub _ _) (hsub _ _)
  refine ⟨hσρ, ?_⟩

  obtain ⟨g₁, hg₁, -⟩ := hηU T ((SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).obj
    (SheafOfModules.unit (wcRingSheaf Y ℓ)))
    (1 : (wcRingSheaf Y ℓ).obj.obj (Opposite.op T))
  obtain ⟨xu, hxu⟩ := (hε' (SheafOfModules.unit (wcRingSheaf Y ℓ))).2 g₁
  let s : (wcRingSheaf Y ℓ).obj.obj (Opposite.op T) :=
    (ε'.hom.app (Opposite.op T)).hom (η T)
  let c : (wcRingSheaf Y ℓ).obj.obj (Opposite.op T) :=
    (xu.val.app (Opposite.op T)).hom (1 : (wcRingSheaf Y ℓ).obj.obj (Opposite.op T))
  have hxs : (xu.val.app (Opposite.op T)).hom s =
      (1 : (wcRingSheaf Y ℓ).obj.obj (Opposite.op T)) := by
    have := congrArg (fun ψ => (ψ.hom.app (Opposite.op T)).hom (η T)) hxu
    exact this.trans hg₁
  have hsc : s * c = 1 := by
    have e := (xu.val.app (Opposite.op T)).hom.map_smul s
      (1 : (wcRingSheaf Y ℓ).obj.obj (Opposite.op T))
    have e1 : (s • (1 : (wcRingSheaf Y ℓ).obj.obj (Opposite.op T)) :
        (SheafOfModules.unit (wcRingSheaf Y ℓ)).val.obj (Opposite.op T)) = s :=
      mul_one s
    have e2 : (xu.val.app (Opposite.op T)).hom s = s • c :=
      (congrArg (fun z => (xu.val.app (Opposite.op T)).hom z) e1).symm.trans e
    exact e2.symm.trans hxs

  let y₀ : (L.obj (wcFreeSheaf Y O')).val.obj (Opposite.op O') :=
    ((adj.unit.app (wcFreeSheaf Y O')).hom.app (Opposite.op O')).hom (η O')
  have hhe : adj.homEquiv _ _ σ = wcFreeSheafMap Y ι ≫ ε' := by
    rw [hσ, Adjunction.homEquiv_naturality_left, hφ]
  have hσy₀ : (σ.val.app (Opposite.op O')).hom y₀ =
      ((wcRingSheaf Y ℓ).obj.map ι.op).hom s := by
    have e1 : (σ.val.app (Opposite.op O')).hom y₀ =
        ((adj.homEquiv _ _ σ).hom.app (Opposite.op O')).hom (η O') := by
      rw [Adjunction.homEquiv_unit]; rfl
    refine e1.trans ?_
    rw [hhe]
    have e2 := hηN T O' ι
    have e3 := NatTrans.naturality_apply ε'.hom ι.op (η T)
    exact (congrArg (fun z => (ε'.hom.app (Opposite.op O')).hom z) e2).trans e3

  rw [ShortComplex.exact_iff_epi_kernel_lift]
  show Epi (Limits.kernel.lift (wcSuppUnitMap Di) σ hσρ)
  apply Abelian.epi_of_cokernel_π_eq_zero
  have hl : ∀ (V : (Y.ProEt)ᵒᵖ) (z : (L.obj (wcFreeSheaf Y O')).val.obj V),
      ((Limits.kernel.ι (wcSuppUnitMap Di)).val.app V).hom
        (((Limits.kernel.lift (wcSuppUnitMap Di) σ hσρ).val.app V).hom z) =
        (σ.val.app V).hom z := fun V z =>
    congrArg (fun ψ => (ψ.val.app V).hom z) (Limits.kernel.lift_ι (wcSuppUnitMap Di) σ hσρ)
  refine SheafOfModules.hom_ext (PresheafOfModules.hom_ext fun U => ?_)
  rcases U with ⟨U⟩
  ext k
  change ((Limits.cokernel.π (Limits.kernel.lift (wcSuppUnitMap Di) σ hσρ)).val.app
    (Opposite.op U)).hom k = 0
  apply wc_proet_module_section_eq_zero_of_affine_covers
    (Limits.cokernel (Limits.kernel.lift (wcSuppUnitMap Di) σ hσρ)) U
  intro W g hW
  obtain ⟨n, W', e, hW'aff, hcov, hcases⟩ :=
    wc_supp_kernel_section_local_cover i Di hDi U k W g hW
  refine ⟨n, W', e, hW'aff, hcov, fun j => ?_⟩
  have hn := PresheafOfModules.naturality_apply
    (Limits.cokernel.π (Limits.kernel.lift (wcSuppUnitMap Di) σ hσρ)).val (e j ≫ g).op k
  refine hn.symm.trans ?_
  let kj : (Limits.kernel (wcSuppUnitMap Di)).val.obj (Opposite.op (W' j)) :=
    ((Limits.kernel (wcSuppUnitMap Di)).val.map (e j ≫ g).op).hom k
  rcases hcases j with hoff | h0
  ·
    have hinj : Function.Injective
        ((Limits.kernel.ι (wcSuppUnitMap Di)).val.app (Opposite.op (W' j))).hom := by
      let G := SheafOfModules.forget (wcRingSheaf Y ℓ) ⋙
        PresheafOfModules.evaluation _ (Opposite.op (W' j))
      have hmono : Mono (G.map (Limits.kernel.ι (wcSuppUnitMap Di))) := Functor.map_mono G _
      exact (ModuleCat.mono_iff_injective _).mp hmono
    have hsubset : Set.range (W' j).hom ⊆ Set.range O.ι := by
      rintro _ ⟨x, rfl⟩
      rw [Scheme.Opens.range_ι, hO]
      exact hoff x
    let lam := IsOpenImmersion.lift O.ι (W' j).hom hsubset
    have hlam : lam ≫ O.ι = (W' j).hom := IsOpenImmersion.lift_fac _ _ _
    let t : W' j ⟶ O' := MorphismProperty.Over.homMk lam hlam trivial
    let y₁ : (L.obj (wcFreeSheaf Y O')).val.obj (Opposite.op (W' j)) :=
      ((L.obj (wcFreeSheaf Y O')).val.map t.op).hom y₀
    let sW : (wcRingSheaf Y ℓ).obj.obj (Opposite.op (W' j)) :=
      ((wcRingSheaf Y ℓ).obj.map t.op).hom
        (((wcRingSheaf Y ℓ).obj.map ι.op).hom s)
    let cW : (wcRingSheaf Y ℓ).obj.obj (Opposite.op (W' j)) :=
      ((wcRingSheaf Y ℓ).obj.map t.op).hom
        (((wcRingSheaf Y ℓ).obj.map ι.op).hom c)
    have hcs : cW * sW = 1 := by
      show ((wcRingSheaf Y ℓ).obj.map t.op).hom
          (((wcRingSheaf Y ℓ).obj.map ι.op).hom c) *
        ((wcRingSheaf Y ℓ).obj.map t.op).hom
          (((wcRingSheaf Y ℓ).obj.map ι.op).hom s) = 1
      have hcomm : c * s = 1 := by
        let c' : C(↥T.left, ULift.{u+1} ℚ_[ℓ]) := c
        let s' : C(↥T.left, ULift.{u+1} ℚ_[ℓ]) := s
        have h1 : c' * s' = s' * c' := mul_comm c' s'
        exact h1.trans hsc
      rw [← map_mul, ← map_mul, hcomm, map_one, map_one]
    have e2 : (σ.val.app (Opposite.op (W' j))).hom y₁ = sW := by
      have hn' := PresheafOfModules.naturality_apply σ.val t.op y₀
      exact hn'.trans (congrArg (fun z =>
        ((SheafOfModules.unit (wcRingSheaf Y ℓ)).val.map t.op).hom z) hσy₀)
    let f : (wcRingSheaf Y ℓ).obj.obj (Opposite.op (W' j)) :=
      ((Limits.kernel.ι (wcSuppUnitMap Di)).val.app (Opposite.op (W' j))).hom kj
    have hσy : (σ.val.app (Opposite.op (W' j))).hom ((f * cW) • y₁) = f := by
      have e1 := (σ.val.app (Opposite.op (W' j))).hom.map_smul (f * cW) y₁
      rw [e1, e2]
      show (f * cW) * sW = f
      rw [mul_assoc, hcs, mul_one]
    have hσ'y : ((Limits.kernel.lift (wcSuppUnitMap Di) σ hσρ).val.app
        (Opposite.op (W' j))).hom ((f * cW) • y₁) = kj := by
      apply hinj
      rw [hl]
      exact hσy
    have hc := congrArg (fun ψ => (ψ.val.app (Opposite.op (W' j))).hom ((f * cW) • y₁))
      (Limits.cokernel.condition (Limits.kernel.lift (wcSuppUnitMap Di) σ hσρ))
    refine (congrArg (fun z => ((Limits.cokernel.π (Limits.kernel.lift (wcSuppUnitMap Di) σ hσρ)).val.app
      (Opposite.op (W' j))).hom z) hσ'y.symm).trans ?_
    exact hc
  ·
    exact (congrArg (fun z => ((Limits.cokernel.π (Limits.kernel.lift (wcSuppUnitMap Di) σ hσρ)).val.app
      (Opposite.op (W' j))).hom z) h0).trans (map_zero _)

theorem wc_free_coker_ladic_line_of_counts (S : Scheme.{u}) [CompactSpace S] [IsLocallyNoetherian S]
    (O : S.Opens) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (N : ℕ)
    (hfin1 : Finite (Abelian.Ext (Limits.cokernel (wcFreeSheafMap S
      (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S)))) (wcZModSheaf S ℓ) N))
    (hcard1 : Nat.card (Abelian.Ext (Limits.cokernel (wcFreeSheafMap S
      (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S)))) (wcZModSheaf S ℓ) N) ≤ ℓ)
    (hvan : ∀ z : Abelian.Ext (Limits.cokernel (wcFreeSheafMap S
      (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S)))) (wcZModSheaf S ℓ) (N + 1), z = 0)
    (hge : ∀ k : ℕ, 1 ≤ k → Finite (Abelian.Ext (Limits.cokernel (wcFreeSheafMap S
      (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S)))) (wcZModSheaf S (ℓ ^ k)) N) →
      ℓ ^ k ≤ Nat.card (Abelian.Ext (Limits.cokernel (wcFreeSheafMap S
        (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S)))) (wcZModSheaf S (ℓ ^ k)) N)) :
    ∃ y : Abelian.Ext (Limits.cokernel (wcFreeSheafMap S
      (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S)))) (wcLadicSheaf S ℓ) N,
      ∀ z : Abelian.Ext (Limits.cokernel (wcFreeSheafMap S
        (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S)))) (wcLadicSheaf S ℓ) N,
        ∃ c : ℚ_[ℓ], z = y.comp (Abelian.Ext.mk₀ (wcLadicScalar S ℓ c)) (add_zero N) :=
by
  classical
  set P := Limits.cokernel (wcFreeSheafMap S
    (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
      Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S))) with hP

  obtain ⟨hcnt, hsN, hsM⟩ := wc_local_tower_counts S ℓ P N hfin1 hcard1 hvan hge

  have hkill : ∀ (n : ℕ) (t : Abelian.Ext P (wcZModSheaf S (ℓ ^ n)) N), ℓ ^ n • t = 0 := by
    intro n t
    have hc' : Nat.card (Abelian.Ext P (wcZModSheaf S (ℓ ^ n)) N) = ℓ ^ n := (hcnt n).2
    have h := card_nsmul_eq_zero' (G := Abelian.Ext P (wcZModSheaf S (ℓ ^ n)) N) (x := t)
    rw [hc'] at h
    exact h

  have hcyc := wc_zmod_local_nakayama_cyclic S ℓ P N hfin1 hcard1 hvan hkill

  obtain ⟨g, hg1, hg2, hg3⟩ := ladic_tower_compatible_generators ℓ
    (fun n => Abelian.Ext P (wcContSheaf S (ZMod (ℓ ^ n))) N)
    (fun n => (Abelian.Ext.mk₀ (wcContSheafMap S (wcTowerCast ℓ n)
      continuous_of_discreteTopology)).postcomp P (add_zero N))
    hcnt hcyc (fun n t => hsN n t)

  obtain ⟨y₀, hy₀⟩ := wc_int_ext_procyclic_of_tower S ℓ P N g hg1 hg2 hg3 hsM

  haveI hXc : CompactSpace S := inferInstance
  haveI hXqs : QuasiSeparatedSpace S := IsLocallyNoetherian.quasiSeparatedSpace
  haveI hOc : CompactSpace O.toScheme := QuasiCompact.compactSpace_of_compactSpace O.ι
  haveI hOln : IsLocallyNoetherian O.toScheme := isLocallyNoetherian_of_isOpenImmersion O.ι
  haveI hOqs : QuasiSeparatedSpace O.toScheme := IsLocallyNoetherian.quasiSeparatedSpace

  have hmono := wc_free_sheaf_map_mono S _ _
    (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
      Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S)) (IsOpenImmersion.mono O.ι)
  have hrat := @proet_free_coker_ladic_rationalization S
    (Scheme.ProEt.mk (𝟙 S)) (Scheme.ProEt.mk O.ι)
    (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
      Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S)) hXc hXqs hOc hOqs ℓ _ hmono

  obtain ⟨hs1, hsmul, hsadd⟩ := wc_ladic_scalar_ring S ℓ
  have hi4 := (wc_int_scalar_ring S ℓ).2.2.2
  have hs0 : wcLadicScalar S ℓ 0 = 0 := by
    have h := hsadd 0 0
    rw [add_zero] at h
    exact add_left_cancel (h.symm.trans (add_zero _).symm)
  have hsnat : ∀ m : ℕ, wcLadicScalar S ℓ (m : ℚ_[ℓ]) = m • 𝟙 _ := by
    intro m
    induction m with
    | zero => rw [Nat.cast_zero, hs0, zero_nsmul]
    | succ k ih => rw [Nat.cast_succ, hsadd, ih, hs1, succ_nsmul]
  have hznat : ∀ (m : ℕ) (w : Abelian.Ext P (wcLadicSheaf S ℓ) N),
      w.comp (Abelian.Ext.mk₀ (wcLadicScalar S ℓ (m : ℚ_[ℓ]))) (add_zero _) = m • w := by
    intro m w
    rw [hsnat m]
    induction m with
    | zero => rw [zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero, zero_nsmul]
    | succ k ih =>
      rw [succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih, Abelian.Ext.comp_mk₀_id,
        succ_nsmul]
  have e2 : ∀ {A B C' D' : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}}
      (v : Abelian.Ext A B N) (p : B ⟶ C') (q : C' ⟶ D'),
      (v.comp (Abelian.Ext.mk₀ p) (add_zero _)).comp (Abelian.Ext.mk₀ q) (add_zero _) =
        v.comp (Abelian.Ext.mk₀ (p ≫ q)) (add_zero _) := by
    intro A B C' D' v p q
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  refine ⟨y₀.comp (Abelian.Ext.mk₀ (wcIntToLadic S ℓ)) (add_zero _), fun z => ?_⟩
  obtain ⟨n, w, hw⟩ := hrat N z
  obtain ⟨a, ha⟩ := hy₀ w
  have hℓ0 : ((ℓ : ℚ_[ℓ]) ^ n) ≠ 0 :=
    pow_ne_zero _ (Nat.cast_ne_zero.mpr (Fact.out : Nat.Prime ℓ).ne_zero)
  refine ⟨((ℓ : ℚ_[ℓ]) ^ n)⁻¹ * (a : ℚ_[ℓ]), ?_⟩
  have hya : (y₀.comp (Abelian.Ext.mk₀ (wcIntToLadic S ℓ)) (add_zero _)).comp
      (Abelian.Ext.mk₀ (wcLadicScalar S ℓ (a : ℚ_[ℓ]))) (add_zero _) = ℓ ^ n • z := by
    rw [e2, ← hi4, ← e2, ← ha, hw]
  have hz : z = (z.comp (Abelian.Ext.mk₀ (wcLadicScalar S ℓ ((ℓ ^ n : ℕ) : ℚ_[ℓ])))
      (add_zero _)).comp (Abelian.Ext.mk₀ (wcLadicScalar S ℓ (((ℓ : ℚ_[ℓ]) ^ n)⁻¹)))
      (add_zero _) := by
    rw [e2, ← hsmul, Nat.cast_pow, inv_mul_cancel₀ hℓ0, hs1, Abelian.Ext.comp_mk₀_id]
  rw [hsmul, ← e2, hya, ← hznat]
  exact hz

theorem wc_zmod_ext_linear_equiv_of_finite : ∀ {D : Type*} [Category D] [Abelian D] [HasExt D] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (P H : D) (γ : ZMod ℓ → (P ⟶ P)), γ 1 = 𝟙 P → (∀ a b : ZMod ℓ, γ (a * b) = γ b ≫ γ a) → (∀ a b : ZMod ℓ, γ (a + b) = γ a + γ b) → ∀ (p : ℕ), Finite (Abelian.Ext P H p) → ∃ (np : ℕ) (e : Abelian.Ext P H p ≃+ (Fin np → ZMod ℓ)), (∀ (c : ZMod ℓ) (x : Abelian.Ext P H p), e ((Abelian.Ext.mk₀ (γ c)).comp x (zero_add p)) = c • e x) ∧ ℓ ^ np = Nat.card (Abelian.Ext P H p) :=
by
  intro D _ _ _ ℓ _ P H γ h1 hmul hadd p hfin
  classical
  have hγ0 : γ 0 = 0 := by
    have h := hadd 0 0
    rw [add_zero] at h
    simpa using h
  letI inst : Module (ZMod ℓ) (Abelian.Ext P H p) :=
    { smul := fun c x => (Abelian.Ext.mk₀ (γ c)).comp x (zero_add p)
      one_smul := fun x => by
        show (Abelian.Ext.mk₀ (γ 1)).comp x (zero_add p) = x
        rw [h1, Abelian.Ext.mk₀_id_comp]
      mul_smul := fun a b x => by
        show (Abelian.Ext.mk₀ (γ (a * b))).comp x (zero_add p) =
          (Abelian.Ext.mk₀ (γ a)).comp
            ((Abelian.Ext.mk₀ (γ b)).comp x (zero_add p)) (zero_add p)
        rw [Abelian.Ext.mk₀_comp_mk₀_assoc, mul_comm, hmul]
      smul_zero := fun a => by
        show (Abelian.Ext.mk₀ (γ a)).comp (0 : Abelian.Ext P H p) (zero_add p) = 0
        exact Abelian.Ext.comp_zero _ _ _ _ _
      smul_add := fun a x y => by
        show (Abelian.Ext.mk₀ (γ a)).comp (x + y) (zero_add p) =
          (Abelian.Ext.mk₀ (γ a)).comp x (zero_add p) +
            (Abelian.Ext.mk₀ (γ a)).comp y (zero_add p)
        exact Abelian.Ext.comp_add _ _ _ _
      add_smul := fun a b x => by
        show (Abelian.Ext.mk₀ (γ (a + b))).comp x (zero_add p) =
          (Abelian.Ext.mk₀ (γ a)).comp x (zero_add p) +
            (Abelian.Ext.mk₀ (γ b)).comp x (zero_add p)
        rw [hadd, Abelian.Ext.mk₀_add, Abelian.Ext.add_comp]
      zero_smul := fun x => by
        show (Abelian.Ext.mk₀ (γ 0)).comp x (zero_add p) = 0
        rw [hγ0, Abelian.Ext.mk₀_zero, Abelian.Ext.zero_comp] }
  haveI := hfin
  haveI hMF : Module.Finite (ZMod ℓ) (Abelian.Ext P H p) := Module.Finite.of_finite
  let b := Module.finBasis (ZMod ℓ) (Abelian.Ext P H p)
  refine ⟨Module.finrank (ZMod ℓ) (Abelian.Ext P H p), b.equivFun.toAddEquiv, ?_, ?_⟩
  · intro c x
    show b.equivFun (c • x) = c • b.equivFun x
    exact b.equivFun.map_smul c x
  · rw [Module.natCard_eq_pow_finrank (K := ZMod ℓ) (V := Abelian.Ext P H p), Nat.card_zmod]

theorem wc_et_ext_top_card_le_of_unit_epi : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Z : Scheme.{u}) (pZ : Z ⟶ Spec (.of K)) [IsProper pZ] (m : ℕ) [SmoothOfRelativeDimension m pZ] [IrreducibleSpace Z] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (G : SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) (φ : SheafOfModules.unit (wcEtZModRing Z ℓ) ⟶ G), Epi φ → Finite (@Abelian.Ext (SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) _ _ (HasExt.standard _) (SheafOfModules.unit (wcEtZModRing Z ℓ)) G (2 * m)) ∧ Nat.card (@Abelian.Ext (SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) _ _ (HasExt.standard _) (SheafOfModules.unit (wcEtZModRing Z ℓ)) G (2 * m)) ≤ ℓ :=
by
  intro K _ _ Z pZ _ m _ _ ℓ _ hℓ G φ hφ
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) := HasExt.standard _
  let S := ShortComplex.mk (Limits.kernel.ι φ) φ (Limits.kernel.condition φ)
  have hS : S.ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel φ) inferInstance hφ
  let ρ : wcEtZModExt Z ℓ (2 * m) →
      Abelian.Ext (SheafOfModules.unit (wcEtZModRing Z ℓ)) G (2 * m) :=
    fun x => x.comp (Abelian.Ext.mk₀ φ) (add_zero (2 * m))
  have hρ : Function.Surjective ρ := by
    intro y
    have h0 : y.comp hS.extClass (rfl : 2 * m + 1 = 2 * m + 1) = 0 :=
      wc_et_smooth_qcqs_module_cd K Z pZ m ℓ hℓ (Limits.kernel φ) (2 * m + 1) (by omega) _
    obtain ⟨x, hx⟩ := Abelian.Ext.covariant_sequence_exact₃ _ hS y rfl h0
    exact ⟨x, hx⟩
  obtain ⟨e⟩ := wc_et_zmodext_coh_equiv Z ℓ (2 * m)
  obtain ⟨hfin, hcard⟩ := wc_et_top_coh_card_le K Z pZ m ℓ hℓ
  haveI : Finite (wcEtZModExt Z ℓ (2 * m)) := Finite.of_equiv _ e.symm
  refine ⟨Finite.of_surjective ρ hρ, ?_⟩
  calc _ ≤ Nat.card (wcEtZModExt Z ℓ (2 * m)) := Nat.card_le_card_of_surjective ρ hρ
    _ = Nat.card (wcEtCoh Z ℓ (2 * m)) := Nat.card_congr e
    _ ≤ ℓ := hcard

theorem wc_smooth_pair_etale_tube_over_base : ∀ (K : Type u) [Field K] [IsAlgClosed K] (X Z : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n c : ℕ) [SmoothOfRelativeDimension n fX] (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension (n - c) (i ≫ fX)], c ≤ n → ∀ (V : X.Opens) (z : Z), i z ∈ V → ∃ W : X.Opens, W ≤ V ∧ i z ∈ W ∧ ∀ (ZW : Scheme.{u}) (iW : ZW ⟶ W) (gW : ZW ⟶ Z), IsPullback gW iW i W.ι → ∀ (P : Scheme.{u}) (p : P ⟶ ZW) (q : P ⟶ Spec (.of (MvPolynomial (Fin c) K))) (z0 : ZW ⟶ P), IsPullback p q (iW ≫ W.ι ≫ fX) (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) → z0 ≫ p = 𝟙 ZW → z0 ≫ q = (iW ≫ W.ι ≫ fX) ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) → IsClosedImmersion z0 ∧ ∃ (V' : Scheme.{u}) (π : V' ⟶ W) (σ : V' ⟶ P) (e : ZW ⟶ V'), Etale π ∧ Etale σ ∧ IsPullback (𝟙 ZW) e iW π ∧ IsPullback (𝟙 ZW) e z0 σ ∧ σ ≫ p ≫ iW ≫ W.ι ≫ fX = π ≫ W.ι ≫ fX :=
by
  classical

  have R1 : ∀ (R A : Type u) [CommRing R] [CommRing A] (φ : R →+* A) (c m : ℕ) (h : Fin c → A) (g : Fin m → A), (MvPolynomial.eval₂Hom φ (Sum.elim h g)).Etale → ∃ (C : Type u) (_ : CommRing C) (f : A →+* C) (σ : MvPolynomial (Fin c) (A ⧸ Ideal.span (Set.range h)) →+* C) (ε : C →+* A ⧸ Ideal.span (Set.range h)), f.Etale ∧ σ.Etale ∧ Function.Surjective ε ∧ ε.comp f = Ideal.Quotient.mk _ ∧ ε.comp σ = MvPolynomial.constantCoeff ∧ RingHom.ker ε = Ideal.map f (Ideal.span (Set.range h)) ∧ RingHom.ker ε = Ideal.map σ (RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin c) (A ⧸ Ideal.span (Set.range h)) →+* _)) ∧ f.comp φ = σ.comp (MvPolynomial.C.comp ((Ideal.Quotient.mk (Ideal.span (Set.range h))).comp φ)) := by
    have s1 : ∀ (S : Type u) [CommRing S] (ι : Type), RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial ι S →+* S) = Ideal.span (Set.range (MvPolynomial.X : ι → MvPolynomial ι S)) := by
      intro S _ ι
      apply le_antisymm
      · intro x hx
        rw [RingHom.mem_ker] at hx
        rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
        intro m hm
        rw [MvPolynomial.mem_support_iff] at hm
        by_cases h0 : m = 0
        · subst h0
          exact absurd (by rw [← MvPolynomial.constantCoeff_eq]; exact hx) hm
        · obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp h0
          exact ⟨i, Set.mem_univ _, hi⟩
      · rw [Ideal.span_le]
        rintro _ ⟨i, rfl⟩
        show _ ∈ RingHom.ker _
        rw [RingHom.mem_ker]
        exact MvPolynomial.constantCoeff_X S i
    have s3 : ∀ (R S : Type u) [CommRing R] [CommRing S] (σ : Type) (φ : R →+* S), φ.Etale → (MvPolynomial.map φ : MvPolynomial σ R →+* MvPolynomial σ S).Etale := by
      intro R S _ _ σ φ hφ
      letI := φ.toAlgebra
      have h1 : (algebraMap R S).Etale := hφ
      have h2 := RingHom.Etale.isStableUnderBaseChange.tensorProduct (MvPolynomial σ R) h1
      let e : TensorProduct R (MvPolynomial σ R) S ≃+* MvPolynomial σ S :=
        (Algebra.TensorProduct.comm R (MvPolynomial σ R) S).toRingEquiv.trans
          (MvPolynomial.algebraTensorAlgEquiv R S).toRingEquiv
      have h3 := RingHom.Etale.respectsIso.1 _ e h2
      convert h3 using 1
      refine MvPolynomial.ringHom_ext (fun r => ?_) (fun i => ?_)
      · simp [e, Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.comm_tmul,
          MvPolynomial.algebraTensorAlgEquiv_tmul]
        rfl
      · simp [e, Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.comm_tmul,
          MvPolynomial.algebraTensorAlgEquiv_tmul]
    have s4 : ∀ (R₀ A P : Type u) [CommRing R₀] [CommRing A] [CommRing P] (Ψ : R₀ →+* A) (θ : R₀ →+* P), Ψ.Etale → θ.Etale → ∃ (C₀ : Type u) (_ : CommRing C₀) (f₀ : A →+* C₀) (σ₀ : P →+* C₀), f₀.Etale ∧ σ₀.Etale ∧ f₀.comp Ψ = σ₀.comp θ ∧ ∀ (D : Type u) [CommRing D] (u : A →+* D) (v : P →+* D), u.comp Ψ = v.comp θ → ∃ w : C₀ →+* D, w.comp f₀ = u ∧ w.comp σ₀ = v := by
      intro R₀ A P _ _ _ Ψ θ hΨ hθ
      letI := Ψ.toAlgebra
      letI := θ.toAlgebra
      refine ⟨TensorProduct R₀ A P, inferInstance, Algebra.TensorProduct.includeLeftRingHom,
        Algebra.TensorProduct.includeRight.toRingHom, ?_, ?_, ?_, ?_⟩
      · have h := RingHom.Etale.isStableUnderBaseChange.tensorProduct A
          (show (algebraMap R₀ P).Etale from hθ)
        convert h using 1
      · have h := RingHom.Etale.isStableUnderBaseChange.tensorProduct P
          (show (algebraMap R₀ A).Etale from hΨ)
        have h2 := RingHom.Etale.respectsIso.1 _ (Algebra.TensorProduct.comm R₀ P A).toRingEquiv h
        convert h2 using 1
        ext1 p
        simp [Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.comm_tmul]
      · exact Algebra.TensorProduct.includeLeftRingHom_comp_algebraMap
      · intro D _ u v huv
        letI : Algebra R₀ D := (u.comp Ψ).toAlgebra
        let u' : A →ₐ[R₀] D := { u with commutes' := fun r => rfl }
        let v' : P →ₐ[R₀] D := { v with commutes' := fun r => (RingHom.congr_fun huv r).symm }
        refine ⟨(Algebra.TensorProduct.productMap u' v').toRingHom, ?_, ?_⟩
        · ext1 a
          simp [u', v', Algebra.TensorProduct.productMap_apply_tmul]
        · ext1 p
          simp [u', v', Algebra.TensorProduct.productMap_apply_tmul]
    have s5 : ∀ (R S R' : Type u) [CommRing R] [CommRing S] [CommRing R'] (σ : R →+* S) (ρ : R →+* R') (ε : S →+* R'), σ.Etale → Function.Surjective ρ → ε.comp σ = ρ → ∃ t : S, ε t = 1 ∧ ∀ x : S, ε x = 0 → t * x ∈ Ideal.map σ (RingHom.ker ρ) := by
      intro R S R' _ _ _ σ ρ ε hσ hρ hε
      letI := σ.toAlgebra
      haveI : Algebra.Etale R S := hσ.toAlgebra
      obtain ⟨t₀, ht₁, ht₂⟩ :=
        (Algebra.FormallyUnramified.iff_exists_tensorProduct (R := R) (S := S)).mp inferInstance
      set N := Ideal.map σ (RingHom.ker ρ) with hNdef
      have hN : ∀ a ∈ RingHom.ker ρ, ((Ideal.Quotient.mk N).comp σ) a = 0 := fun a ha =>
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem σ ha)
      let ι0 : R ⧸ RingHom.ker ρ →+* S ⧸ N := Ideal.Quotient.lift _ ((Ideal.Quotient.mk N).comp σ) hN
      let ι : R' →+* S ⧸ N := ι0.comp (RingHom.quotientKerEquivOfSurjective hρ).symm.toRingHom
      have hι : ∀ r, ι (ρ r) = Ideal.Quotient.mk N (σ r) := by
        intro r
        have e1 : (RingHom.quotientKerEquivOfSurjective hρ).symm (ρ r) =
            Ideal.Quotient.mk (RingHom.ker ρ) r := by
          rw [RingEquiv.symm_apply_eq, RingHom.quotientKerEquivOfSurjective_apply_mk]
        show ι0 ((RingHom.quotientKerEquivOfSurjective hρ).symm (ρ r)) = _
        rw [e1]
        exact Ideal.Quotient.lift_mk _ _ _
      have hNε : N ≤ RingHom.ker ε := by
        rw [hNdef, Ideal.map_le_iff_le_comap]
        intro b hb
        rw [Ideal.mem_comap, RingHom.mem_ker, ← RingHom.comp_apply, hε]
        exact hb
      let εb : S ⧸ N →+* R' := Ideal.Quotient.lift N ε (fun a ha => hNε ha)
      have hεb : ∀ s, εb (Ideal.Quotient.mk N s) = ε s := fun s => Ideal.Quotient.lift_mk _ _ _
      have hεbι : ∀ y, εb (ι y) = y := by
        intro y
        obtain ⟨r, rfl⟩ := hρ y
        rw [hι, hεb, ← RingHom.comp_apply, hε]
      let F : S →ₐ[R] S ⧸ N :=
        { (ι.comp ε) with
          commutes' := fun r => by
            show ι (ε (σ r)) = Ideal.Quotient.mk N (σ r)
            rw [← RingHom.comp_apply ε σ, hε, hι] }
      let G : S →ₐ[R] S ⧸ N := Ideal.Quotient.mkₐ R N
      let Φ := Algebra.TensorProduct.productMap F G
      have hΦ : ∀ a b : S, Φ (a ⊗ₜ[R] b) = ι (ε a) * Ideal.Quotient.mk N b := by
        intro a b
        rw [Algebra.TensorProduct.productMap_apply_tmul]
        rfl
      have hkey : ∀ z : TensorProduct R S S, εb (Φ z) = ε (Algebra.TensorProduct.lmul' R z) := by
        intro z
        induction z using TensorProduct.induction_on with
        | zero => simp
        | tmul a b =>
          rw [hΦ, map_mul, hεbι, hεb, Algebra.TensorProduct.lmul'_apply_tmul, map_mul]
        | add x y hx hy => rw [map_add, map_add, hx, hy, map_add, map_add]
      obtain ⟨t, ht⟩ := Ideal.Quotient.mk_surjective (I := N) (Φ t₀)
      refine ⟨t, ?_, ?_⟩
      · rw [← hεb, ht, hkey, ht₂, map_one]
      · intro x hx
        have h1 := congrArg Φ (ht₁ x)
        rw [map_mul, map_sub, map_zero, hΦ, hΦ, hx, map_zero, map_one, map_one, one_mul,
          zero_mul, sub_zero] at h1
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul, ht, mul_comm]
        exact h1
    have s6 : ∀ (R : Type u) [CommRing R] (σ τ : Type), Function.Surjective (MvPolynomial.eval₂Hom MvPolynomial.C (Sum.elim (fun _ : σ => (0 : MvPolynomial τ R)) MvPolynomial.X) : MvPolynomial (σ ⊕ τ) R →+* MvPolynomial τ R) ∧ RingHom.ker (MvPolynomial.eval₂Hom MvPolynomial.C (Sum.elim (fun _ : σ => (0 : MvPolynomial τ R)) MvPolynomial.X) : MvPolynomial (σ ⊕ τ) R →+* MvPolynomial τ R) = Ideal.span (Set.range (fun j : σ => (MvPolynomial.X (Sum.inl j) : MvPolynomial (σ ⊕ τ) R))) := by
      intro R _ σ τ
      set ρ := (MvPolynomial.eval₂Hom MvPolynomial.C (Sum.elim (fun _ : σ => (0 : MvPolynomial τ R)) MvPolynomial.X) : MvPolynomial (σ ⊕ τ) R →+* MvPolynomial τ R) with hρ
      set J := Ideal.span (Set.range (fun j : σ => (MvPolynomial.X (Sum.inl j) : MvPolynomial (σ ⊕ τ) R))) with hJ
      have hr : ∀ p : MvPolynomial τ R, ρ (MvPolynomial.rename Sum.inr p) = p := by
        intro p
        rw [hρ, MvPolynomial.eval₂Hom_rename]
        have : (Sum.elim (fun _ : σ => (0 : MvPolynomial τ R)) MvPolynomial.X ∘ Sum.inr) =
            (MvPolynomial.X : τ → MvPolynomial τ R) := by
          funext k; rfl
        rw [this]
        exact MvPolynomial.eval₂_eta p
      have key : ∀ p, p - MvPolynomial.rename Sum.inr (ρ p) ∈ J := by
        intro p
        induction p using MvPolynomial.induction_on with
        | C a =>
          simp [ρ]
        | add p q hp hq =>
          rw [map_add, map_add]
          convert add_mem hp hq using 1
          ring
        | mul_X p n hp =>
          rw [map_mul, map_mul]
          have e : p * MvPolynomial.X n - MvPolynomial.rename Sum.inr (ρ p) *
              MvPolynomial.rename Sum.inr (ρ (MvPolynomial.X n)) =
              (p - MvPolynomial.rename Sum.inr (ρ p)) * MvPolynomial.X n +
              MvPolynomial.rename Sum.inr (ρ p) *
                (MvPolynomial.X n - MvPolynomial.rename Sum.inr (ρ (MvPolynomial.X n))) := by ring
          rw [e]
          refine add_mem (Ideal.mul_mem_right _ _ hp) (Ideal.mul_mem_left _ _ ?_)
          cases n with
          | inl i =>
            simp only [ρ, MvPolynomial.eval₂Hom_X', Sum.elim_inl, map_zero, sub_zero]
            exact Ideal.subset_span ⟨i, rfl⟩
