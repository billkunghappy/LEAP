      rw [Abelian.Ext.mk₀_comp_mk₀, Limits.biprod.inr_desc]
    have h1 : (Abelian.Ext.mk₀ (adjB.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)))).comp
