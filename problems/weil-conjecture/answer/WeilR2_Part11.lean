theorem rightAdj_homology_zero_of_free_ext_local {C : Type (u+1)} [Category.{u} C]
    (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
    (S : Sheaf J RingCat.{u+1})
    {𝒟 : Type*} [Category 𝒟] [Abelian 𝒟] [HasExt 𝒟]
    (L : SheafOfModules.{u+1} S ⥤ 𝒟)
    (R : 𝒟 ⥤ SheafOfModules.{u+1} S) [R.Additive] (adj : L ⊣ R)
    (A : 𝒟) (I : InjectiveResolution A) (q : ℕ)
    (hgood : ∀ W : C, Sieve.generate (fun (W' : C) (_ : W' ⟶ W) =>
        ∀ (P : SheafOfModules.{u+1} S)
          (ev : ∀ M : SheafOfModules.{u+1} S, (P ⟶ M) ≃ M.val.obj (Opposite.op W')),
          (∀ (M N : SheafOfModules.{u+1} S) (ψ : M ⟶ N) (g : P ⟶ M),
            ev N (g ≫ ψ) = (ψ.val.app (Opposite.op W')).hom (ev M g)) →
          (∀ (M : SheafOfModules.{u+1} S) (g g' : P ⟶ M), ev M (g + g') = ev M g + ev M g') →
          ∀ x : Abelian.Ext (L.obj P) A q, x = 0) ∈ J W) :
    Limits.IsZero (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) :=
by
  classical

  have hcomp : ∀ {M N L : SheafOfModules.{u+1} S} (p : M ⟶ N) (p' : N ⟶ L) (V : Cᵒᵖ)
      (x : M.val.obj V), ((p ≫ p').val.app V).hom x = (p'.val.app V).hom ((p.val.app V).hom x) :=
    fun _ _ _ _ => rfl
  have hnat : ∀ {M N : SheafOfModules.{u+1} S} (p : M ⟶ N) {W W' : C} (g : W' ⟶ W)
      (x : M.val.obj (Opposite.op W)),
      (p.val.app (Opposite.op W')).hom ((M.val.map g.op).hom x) =
        (N.val.map g.op).hom ((p.val.app (Opposite.op W)).hom x) :=
    fun p _ _ g x => PresheafOfModules.naturality_apply p.val g.op x
  have hMmap : ∀ {M : SheafOfModules.{u+1} S} {W Y Z : C} (h₀ : Y ⟶ W) (g' : Z ⟶ Y)
      (x : M.val.obj (Opposite.op W)),
      (M.val.map (g' ≫ h₀).op).hom x = (M.val.map g'.op).hom ((M.val.map h₀.op).hom x) := by
    intro M W Y Z h₀ g' x
    rw [op_comp, PresheafOfModules.map_comp]
    rfl
  have hmono : ∀ {M N : SheafOfModules.{u+1} S} (p : M ⟶ N) [Mono p] (W : C),
      Function.Injective (p.val.app (Opposite.op W)).hom := by
    intro M N p _ W
    have h1 : Mono ((SheafOfModules.forget.{u+1} S ⋙
        PresheafOfModules.evaluation.{u+1} S.obj (Opposite.op W)).map p) := Functor.map_mono _ p
    exact (ModuleCat.mono_iff_injective _).1 h1

  have s1 : ∀ (P : CochainComplex (SheafOfModules.{u+1} S) ℕ),
      (∀ (W : C) (s : (P.X q).val.obj (Opposite.op W)),
        ((P.d q (q + 1)).val.app (Opposite.op W)).hom s = 0 →
        Sieve.generate (fun (W' : C) (g : W' ⟶ W) =>
          ∃ y : (P.X ((ComplexShape.up ℕ).prev q)).val.obj (Opposite.op W'),
            ((P.X q).val.map g.op).hom s =
              ((P.d ((ComplexShape.up ℕ).prev q) q).val.app (Opposite.op W')).hom y) ∈ J W) →
      Limits.IsZero (P.homology q) := by
    intro P hloc
    have hTi : ∀ (V : Cᵒᵖ) (y : (P.X ((ComplexShape.up ℕ).prev q)).val.obj V),
        ((P.iCycles q).val.app V).hom
          (((P.toCycles ((ComplexShape.up ℕ).prev q) q).val.app V).hom y) =
        ((P.d ((ComplexShape.up ℕ).prev q) q).val.app V).hom y := by
      intro V y
      rw [← hcomp, P.toCycles_i]
    have hTπ : ∀ (V : Cᵒᵖ) (y : (P.X ((ComplexShape.up ℕ).prev q)).val.obj V),
        ((P.homologyπ q).val.app V).hom
          (((P.toCycles ((ComplexShape.up ℕ).prev q) q).val.app V).hom y) = 0 := by
      intro V y
      rw [← hcomp, P.toCycles_comp_homologyπ]
      rfl
    have hzero : ∀ (W : C) (z : (P.cycles q).val.obj (Opposite.op W)),
        ((P.homologyπ q).val.app (Opposite.op W)).hom z = 0 := by
      intro W z
      have hs : ((P.d q (q + 1)).val.app (Opposite.op W)).hom
          (((P.iCycles q).val.app (Opposite.op W)).hom z) = 0 := by
        rw [← hcomp, P.iCycles_d]
        rfl
      refine (Presheaf.IsSheaf.isSeparated (P.homology q).isSheaf) W _ (hloc W _ hs)
        (((P.homologyπ q).val.app (Opposite.op W)).hom z) 0 ?_
      rintro Y f ⟨Z, k, g₀, ⟨y, hy⟩, rfl⟩
      have hw : ((P.cycles q).val.map g₀.op).hom z =
          ((P.toCycles ((ComplexShape.up ℕ).prev q) q).val.app (Opposite.op Z)).hom y := by
        apply hmono (P.iCycles q) Z
        rw [hnat, hy, hTi]
      have h1 : ((P.homology q).val.map (k ≫ g₀).op).hom
          (((P.homologyπ q).val.app (Opposite.op W)).hom z) = 0 := by
        rw [hMmap, ← hnat, hw, hTπ]
        exact map_zero _
      change ((P.homology q).val.map (k ≫ g₀).op).hom
          (((P.homologyπ q).val.app (Opposite.op W)).hom z) =
        ((P.homology q).val.map (k ≫ g₀).op).hom 0
      rw [h1, map_zero]
    have hπ0 : P.homologyπ q = 0 := by
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro V
      obtain ⟨W⟩ := V
      ext z
      rw [hzero W z]
      rfl
    exact Limits.IsZero.of_epi_eq_zero _ hπ0

  have hfree : ∀ U : C, ∃ (P : SheafOfModules.{u+1} S)
      (ev : ∀ M : SheafOfModules.{u+1} S, (P ⟶ M) ≃ M.val.obj (Opposite.op U)),
      (∀ (M N : SheafOfModules.{u+1} S) (ψ : M ⟶ N) (g : P ⟶ M),
        ev N (g ≫ ψ) = (ψ.val.app (Opposite.op U)).hom (ev M g)) ∧
      (∀ (M : SheafOfModules.{u+1} S) (g g' : P ⟶ M), ev M (g + g') = ev M g + ev M g') := by
    intro U
    let Y : Cᵒᵖ ⥤ Type (u+1) := uliftYoneda.{u+1}.obj U
    let F₀ := (PresheafOfModules.free.{u+1} S.val).obj Y
    let adjS := PresheafOfModules.sheafificationAdjunction (J := J) (R := S) (𝟙 S.val)
    let adjF := PresheafOfModules.freeAdjunction.{u+1} S.val
    let P := (PresheafOfModules.sheafification (J := J) (R := S) (𝟙 S.val)).obj F₀
    let ev : ∀ M : SheafOfModules.{u+1} S, (P ⟶ M) ≃ M.val.obj (Opposite.op U) := fun M =>
      (adjS.homEquiv F₀ M).trans ((adjF.homEquiv Y _).trans uliftYonedaEquiv)
    have hnatF : ∀ (M N : SheafOfModules.{u+1} S) (ψ : M ⟶ N) (g : P ⟶ M),
        ev N (g ≫ ψ) = (ψ.val.app (Opposite.op U)).hom (ev M g) := by
      intro M N ψ g
      change uliftYonedaEquiv (adjF.homEquiv Y _ (adjS.homEquiv F₀ N (g ≫ ψ))) =
        (ψ.val.app (Opposite.op U)).hom
          (uliftYonedaEquiv (adjF.homEquiv Y _ (adjS.homEquiv F₀ M g)))
      rw [adjS.homEquiv_naturality_right, adjF.homEquiv_naturality_right, uliftYonedaEquiv_comp]
      rfl
    refine ⟨P, ev, hnatF, ?_⟩
    intro M g g'
    have h0 : ∀ h : P ⟶ M, ev M h = (h.val.app (Opposite.op U)).hom (ev P (𝟙 P)) := by
      intro h
      rw [← hnatF, Category.id_comp]
    rw [h0, h0 g, h0 g', SheafOfModules.add_val, PresheafOfModules.add_app, ModuleCat.hom_add,
      LinearMap.add_apply]

  have hcob : ∀ {X : 𝒟} (f : X ⟶ I.cocomplex.X q) (hf : f ≫ I.cocomplex.d q (q + 1) = 0),
      I.extMk f (q + 1) rfl hf = 0 → ∃ k : X ⟶ I.cocomplex.X ((ComplexShape.up ℕ).prev q),
        f = k ≫ I.cocomplex.d ((ComplexShape.up ℕ).prev q) q := by
    intro X f hf h0
    by_cases hr : (ComplexShape.up ℕ).Rel ((ComplexShape.up ℕ).prev q) q
    · obtain ⟨k, hk⟩ := (I.extMk_eq_zero_iff f (q + 1) rfl hf _ hr).1 h0
      exact ⟨k, hk.symm⟩
    · have ht : q = 0 := by
        rcases Nat.eq_zero_or_pos q with ht | ht
        · exact ht
        · exfalso
          have hr' : (ComplexShape.up ℕ).Rel (q - 1) q := by
            simp only [ComplexShape.up_Rel]; omega
          rw [ComplexShape.prev_eq' _ hr'] at hr
          exact hr hr'
      refine ⟨0, ?_⟩
      rw [Limits.zero_comp]
      subst ht
      have h1 := congrArg I.extEquivCohomologyClass h0
      rw [InjectiveResolution.extEquivCohomologyClass_extMk,
        InjectiveResolution.extEquivCohomologyClass_zero,
        CochainComplex.HomComplex.CohomologyClass.mk_eq_zero_iff,
        CochainComplex.HomComplex.Cocycle.fromSingleMk_mem_coboundaries_iff _ _ _ _ _ (-1)
          (by norm_num)] at h1
      obtain ⟨g', hg'⟩ := h1
      have hz : Limits.IsZero (I.cochainComplex.X (-1)) :=
        CochainComplex.isZero_of_isStrictlyGE I.cochainComplex 0 (-1)
      rw [hz.eq_of_tgt g' 0, Limits.zero_comp] at hg'
      rw [← cancel_mono (I.cochainComplexXIso ((0 : ℕ) : ℤ) 0 rfl).inv, Limits.zero_comp]
      exact hg'.symm

  have s2 : ∀ (W : C) (P : SheafOfModules.{u+1} S)
      (ev : ∀ M : SheafOfModules.{u+1} S, (P ⟶ M) ≃ M.val.obj (Opposite.op W)),
      (∀ (M N : SheafOfModules.{u+1} S) (ψ : M ⟶ N) (g : P ⟶ M),
        ev N (g ≫ ψ) = (ψ.val.app (Opposite.op W)).hom (ev M g)) →
      (∀ (M : SheafOfModules.{u+1} S) (g g' : P ⟶ M), ev M (g + g') = ev M g + ev M g') →
      (∀ x : Abelian.Ext (L.obj P) A q, x = 0) →
      ∀ (s : (R.obj (I.cocomplex.X q)).val.obj (Opposite.op W)),
        ((R.map (I.cocomplex.d q (q + 1))).val.app (Opposite.op W)).hom s = 0 →
        ∃ y : (R.obj (I.cocomplex.X ((ComplexShape.up ℕ).prev q))).val.obj (Opposite.op W),
          s = ((R.map (I.cocomplex.d ((ComplexShape.up ℕ).prev q) q)).val.app
            (Opposite.op W)).hom y := by
    intro W P ev hn' ha' hext s hs
    have hev0 : ∀ M, ev M 0 = 0 := by
      intro M
      have h := ha' M 0 0
      rw [add_zero] at h
      simpa using h
    have hσ : (ev _).symm s ≫ R.map (I.cocomplex.d q (q + 1)) = 0 := by
      apply (ev _).injective
      rw [hn', Equiv.apply_symm_apply, hs, hev0]
    have hσ' : (adj.homEquiv _ _).symm ((ev _).symm s) ≫ I.cocomplex.d q (q + 1) = 0 := by
      apply (adj.homEquiv _ _).injective
      rw [Adjunction.homEquiv_naturality_right, Equiv.apply_symm_apply, hσ,
        Adjunction.homEquiv_unit, Functor.map_zero, Limits.comp_zero]
    obtain ⟨k, hk⟩ := hcob _ _ (hext (I.extMk _ (q + 1) rfl hσ'))
    refine ⟨ev _ (adj.homEquiv _ _ k), ?_⟩
    have e1 : (ev _).symm s = adj.homEquiv _ _ k ≫
        R.map (I.cocomplex.d ((ComplexShape.up ℕ).prev q) q) := by
      rw [← Adjunction.homEquiv_naturality_right, ← hk, Equiv.apply_symm_apply]
    calc s = ev _ ((ev _).symm s) := (Equiv.apply_symm_apply _ _).symm
      _ = _ := by rw [e1, hn']

  refine s1 ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex) ?_
  intro W s hs
  refine J.superset_covering ?_ (hgood W)
  rw [Sieve.generate_le_iff]
  intro W' g hgd
  apply Sieve.le_generate
  obtain ⟨P, ev, hn', ha'⟩ := hfree W'
  have hs' : ((R.map (I.cocomplex.d q (q + 1))).val.app (Opposite.op W')).hom
      (((R.obj (I.cocomplex.X q)).val.map g.op).hom s) = 0 := by
    rw [hnat]
    exact (congrArg ((R.obj (I.cocomplex.X (q + 1))).val.map g.op).hom hs).trans (map_zero _)
  exact s2 W' P ev hn' ha' (hgd P ev hn' ha') _ hs'

theorem wc_proet_closed_affine_lift_surj {X Y : Scheme.{u}} (i : X ⟶ Y) [IsClosedImmersion i] (U : Y.ProEt) [IsAffine U.left] (V' : X.ProEt) (g' : V' ⟶ (wcProEtBC i).obj U) (hV' : IsAffine V'.left) (hlift : ∀ (A Abar Bbar : Type u) [CommRing A] [CommRing Abar] [CommRing Bbar] [Algebra A Abar] [Algebra Abar Bbar], Function.Surjective (algebraMap A Abar) → Algebra.WeaklyEtale Abar Bbar → ∃ (C : Type u) (_ : CommRing C) (_ : Algebra A C) (β : Bbar →+* TensorProduct A C Abar), Algebra.WeaklyEtale A C ∧ β.comp (algebraMap Abar Bbar) = (Algebra.TensorProduct.includeRight : Abar →ₐ[A] TensorProduct A C Abar).toRingHom ∧ Function.Surjective (PrimeSpectrum.comap β)) : ∃ (W : Y.ProEt) (a : (wcProEtBC i).obj W ⟶ V'), IsAffine W.left ∧ Surjective a.left :=
by
  classical
  haveI hV'i : IsAffine V'.left := hV'

  have toSch : ∀ (R' S' : Type u) [CommRing R'] [CommRing S'] [Algebra R' S'],
      Algebra.WeaklyEtale R' S' → WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) := by
    intro R' S' _ _ _ hW
    have hfl : Flat (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
        RingHom.flat_algebraMap_iff]
      exact hW.flat
    have hmu : Flat (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom)) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom]
      exact hW.flat_lmul'
    have hd : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap R' S')))) := by
      rw [diagonal_SpecMap]
      infer_instance
    exact ⟨hfl, hd⟩

  have toRing : ∀ (R' S' : Type u) [CommRing R'] [CommRing S'] [Algebra R' S'],
      WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) → Algebra.WeaklyEtale R' S' := by
    intro R' S' _ _ _ hW
    have hfl : Module.Flat R' S' := by
      have := hW.flat
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
        RingHom.flat_algebraMap_iff] at this
      exact this
    have hd := hW.flat_diagonal
    rw [diagonal_SpecMap] at hd
    have hmu : Flat (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom)) := by
      have e : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom) =
          (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom) ≫
            (pullbackSpecIso R' S' S').inv) ≫ (pullbackSpecIso R' S' S').hom := by
        rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
      rw [e]
      haveI := hd
      infer_instance
    rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom] at hmu
    exact Algebra.WeaklyEtale.mk hfl hmu
  have appTopWE : ∀ {X Z : Scheme.{u}} [IsAffine X] [IsAffine Z] (h : X ⟶ Z), WeaklyEtale h →
      WeaklyEtale (Spec.map h.appTop) := by
    intro X Z _ _ h hh
    have e : Spec.map h.appTop = X.isoSpec.inv ≫ h ≫ Z.isoSpec.hom := by
      rw [← Scheme.isoSpec_hom_naturality, Iso.inv_hom_id_assoc]
    rw [e]
    infer_instance

  haveI hUaff' : IsAffine ((𝟭 Scheme.{u}).obj U.left) := inferInstanceAs (IsAffine U.left)
  haveI hjci : IsClosedImmersion (Limits.pullback.fst U.hom i) := inferInstance
  obtain ⟨hZaff, hjsurj⟩ :=
    IsClosedImmersion.isAffine_surjective_of_isAffine (Limits.pullback.fst U.hom i)
  haveI := hZaff
  obtain ⟨g0, hg0def⟩ : ∃ g0 : V'.left ⟶ Limits.pullback U.hom i, g0 = g'.left := ⟨_, rfl⟩
  have hw0 : g0 ≫ Limits.pullback.snd U.hom i = V'.hom := by
    rw [hg0def]; exact MorphismProperty.Over.w g'
  have hg0 : WeaklyEtale g0 := by
    have h1 : WeaklyEtale (g0 ≫ Limits.pullback.snd U.hom i) := by
      rw [hw0]; exact V'.prop
    have h2 : WeaklyEtale (Limits.pullback.snd U.hom i) := ((wcProEtBC i).obj U).prop
    exact @WeaklyEtale.of_comp _ _ _ g0 _ h1 h2
  letI alg1 : Algebra Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤) :=
    (Limits.pullback.fst U.hom i).appTop.hom.toAlgebra
  letI alg2 : Algebra Γ(Limits.pullback U.hom i, ⊤) Γ(V'.left, ⊤) := g0.appTop.hom.toAlgebra
  have hπ : Function.Surjective (algebraMap Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤)) := hjsurj
  have hW : Algebra.WeaklyEtale Γ(Limits.pullback U.hom i, ⊤) Γ(V'.left, ⊤) :=
    toRing _ _ (appTopWE g0 hg0)

  obtain ⟨C, _, _, β, hC, hβ, hsurj⟩ :=
    hlift Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤) Γ(V'.left, ⊤) hπ hW
  haveI := toSch _ _ hC
  haveI := U.prop
  obtain ⟨p, hpdef⟩ : ∃ p : Spec (CommRingCat.of C) ⟶ U.left,
      p = Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) C)) ≫ U.left.isoSpec.inv :=
    ⟨_, rfl⟩
  haveI hpwe : WeaklyEtale p := by rw [hpdef]; infer_instance
  have hp : p ≫ U.left.isoSpec.hom = Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) C)) := by
    rw [hpdef, Category.assoc, Iso.inv_hom_id, Category.comp_id]

  obtain ⟨m, hmdef⟩ : ∃ m : Limits.pullback (p ≫ U.hom) i ⟶ Limits.pullback U.hom i,
      m = ((wcProEtBC i).map
        (MorphismProperty.Over.homMk p rfl trivial : Scheme.ProEt.mk (p ≫ U.hom) ⟶ U)).left :=
    ⟨_, rfl⟩
  have hsq : m ≫ Limits.pullback.fst U.hom i = Limits.pullback.fst (p ≫ U.hom) i ≫ p := by
    rw [hmdef]
    exact Limits.pullback.lift_fst _ _ _
  have hmsnd : m ≫ Limits.pullback.snd U.hom i = Limits.pullback.snd (p ≫ U.hom) i := by
    rw [hmdef]
    exact MorphismProperty.Over.w ((wcProEtBC i).map
        (MorphismProperty.Over.homMk p rfl trivial : Scheme.ProEt.mk (p ≫ U.hom) ⟶ U))

  have eq₁ : p ≫ U.left.isoSpec.hom =
      𝟙 _ ≫ Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) C)) := by
    rw [hp, Category.id_comp]
  have eq₂ : Limits.pullback.fst U.hom i ≫ U.left.isoSpec.hom =
      (Limits.pullback U.hom i).isoSpec.hom ≫
        Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤))) := by
    have hnat := Scheme.isoSpec_hom_naturality (Limits.pullback.fst U.hom i)
    exact hnat.symm
  obtain ⟨M, hMdef⟩ : ∃ M : Limits.pullback p (Limits.pullback.fst U.hom i) ⟶
      Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) C)))
        (Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤)))),
      M = Limits.pullback.map p (Limits.pullback.fst U.hom i)
        (Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) C)))
        (Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤))))
        (𝟙 _) (Limits.pullback U.hom i).isoSpec.hom U.left.isoSpec.hom eq₁ eq₂ := ⟨_, rfl⟩
  haveI hMiso : IsIso M := by
    rw [hMdef]
    infer_instance
  have hMsnd : M ≫ Limits.pullback.snd
      (Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) C)))
      (Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤)))) =
      Limits.pullback.snd p (Limits.pullback.fst U.hom i) ≫ (Limits.pullback U.hom i).isoSpec.hom := by
    rw [hMdef]
    exact Limits.pullback.lift_snd _ _ _
  let e₁ := asIso M ≪≫ pullbackSpecIso Γ(U.left, ⊤) C Γ(Limits.pullback U.hom i, ⊤)
  have he₁ : e₁.hom ≫ Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
      Γ(Limits.pullback U.hom i, ⊤) →ₐ[Γ(U.left, ⊤)]
        TensorProduct Γ(U.left, ⊤) C Γ(Limits.pullback U.hom i, ⊤)).toRingHom) =
      Limits.pullback.snd p (Limits.pullback.fst U.hom i) ≫ (Limits.pullback U.hom i).isoSpec.hom := by
    show (M ≫ (pullbackSpecIso Γ(U.left, ⊤) C Γ(Limits.pullback U.hom i, ⊤)).hom) ≫ _ = _
    rw [Category.assoc]
    refine (congrArg (fun k => M ≫ k)
      (pullbackSpecIso_hom_snd Γ(U.left, ⊤) C Γ(Limits.pullback U.hom i, ⊤))).trans ?_
    exact hMsnd
  have hR : (Limits.pullbackRightPullbackFstIso U.hom i p).inv ≫
      Limits.pullback.snd p (Limits.pullback.fst U.hom i) = m := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Limits.pullbackRightPullbackFstIso_inv_snd_fst, hsq]
    · rw [Category.assoc, Limits.pullbackRightPullbackFstIso_inv_snd_snd, hmsnd]
  let e := (Limits.pullbackRightPullbackFstIso U.hom i p).symm ≪≫ e₁
  have he : e.hom ≫ Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
      Γ(Limits.pullback U.hom i, ⊤) →ₐ[Γ(U.left, ⊤)]
        TensorProduct Γ(U.left, ⊤) C Γ(Limits.pullback U.hom i, ⊤)).toRingHom) =
      m ≫ (Limits.pullback U.hom i).isoSpec.hom := by
    show ((Limits.pullbackRightPullbackFstIso U.hom i p).inv ≫ e₁.hom) ≫ _ = _
    rw [Category.assoc, he₁, ← Category.assoc, hR]

  obtain ⟨βc, hβc⟩ : ∃ βc : Γ(V'.left, ⊤) ⟶
      CommRingCat.of (TensorProduct Γ(U.left, ⊤) C Γ(Limits.pullback U.hom i, ⊤)),
      βc.hom = β := ⟨CommRingCat.ofHom β, rfl⟩
  subst hβc
  obtain ⟨a₀, ha₀def⟩ : ∃ a₀ : Limits.pullback (p ≫ U.hom) i ⟶ V'.left,
      a₀ = e.hom ≫ Spec.map βc ≫ V'.left.isoSpec.inv := ⟨_, rfl⟩
  have h8a : a₀ ≫ g0 = m := by
    rw [← cancel_mono (Limits.pullback U.hom i).isoSpec.hom, ha₀def]
    simp only [Category.assoc]
    rw [← Scheme.isoSpec_hom_naturality g0, Iso.inv_hom_id_assoc, ← Spec.map_comp, ← he]
    refine congrArg (fun k => e.hom ≫ Spec.map k) ?_
    apply CommRingCat.hom_ext
    rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom]
    exact hβ
  have h8b : a₀ ≫ V'.hom = Limits.pullback.snd (p ≫ U.hom) i := by
    rw [← hw0, ← Category.assoc, h8a, hmsnd]
  have ha₀s : Surjective a₀ := by
    constructor
    intro v
    obtain ⟨P, hP⟩ := hsurj (V'.left.isoSpec.hom v)
    refine ⟨e.inv P, ?_⟩
    have h1 : (Spec.map βc) P = V'.left.isoSpec.hom v := hP
    have h2 : e.hom (e.inv P) = P := Scheme.inv_hom_apply e P
    have h3 : a₀ (e.inv P) = V'.left.isoSpec.inv ((Spec.map βc) (e.hom (e.inv P))) := by
      rw [ha₀def, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
    exact h3.trans ((congrArg (fun z => V'.left.isoSpec.inv ((Spec.map βc) z)) h2).trans
      ((congrArg V'.left.isoSpec.inv h1).trans (Scheme.hom_inv_apply _ _)))
  refine ⟨Scheme.ProEt.mk (p ≫ U.hom), MorphismProperty.Over.homMk a₀ h8b trivial, ?_, ?_⟩
  · show IsAffine (Spec (CommRingCat.of C))
    infer_instance
  · exact ha₀s

theorem wc_proet_affine_open_chart_cover : ∀ {Y Z : Scheme.{u}} (i : Z ⟶ Y) (Q : Z.ProEt), IsAffine Q.left → ∃ (n : ℕ) (U : Fin n → Y.ProEt) (V' : Fin n → Z.ProEt) (g' : ∀ k, V' k ⟶ (wcProEtBC i).obj (U k)) (ι : ∀ k, V' k ⟶ Q), (∀ k, IsAffine (U k).left) ∧ (∀ k, IsAffine (V' k).left) ∧ ∀ x : Q.left, ∃ k, x ∈ Set.range (ι k).left :=
by
  intro Y Z i Q hQ
  classical
  haveI : IsAffine Q.left := hQ
  haveI := Q.prop
  have hch : ∀ x : Q.left, ∃ O : Y.Opens, IsAffineOpen O ∧ ∃ N : Q.left.Opens, IsAffineOpen N ∧
      x ∈ N ∧ N ≤ (Q.hom ≫ i) ⁻¹ᵁ O := by
    intro x
    obtain ⟨O, hO, hyO, -⟩ :=
      TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Scheme.isBasis_affineOpens Y)
        (show (Q.hom ≫ i) x ∈ (⊤ : Y.Opens) from trivial)
    obtain ⟨N, hN, hxN, hNO⟩ :=
      TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Scheme.isBasis_affineOpens Q.left)
        (show x ∈ (Q.hom ≫ i) ⁻¹ᵁ O from (Scheme.Hom.mem_preimage _).mpr hyO)
    exact ⟨O, hO, N, hN, hxN, hNO⟩
  choose O hO N hN hxN hNO using hch
  obtain ⟨t, ht⟩ := CompactSpace.elim_nhds_subcover (fun x => (N x : Set Q.left))
    (fun x => IsOpen.mem_nhds (N x).isOpen (hxN x))
  let xs : Fin t.card → Q.left := fun k => (t.equivFin.symm k).1
  have hxs : ∀ x : Q.left, ∃ k, x ∈ N (xs k) := by
    intro x
    have hx : x ∈ ⋃ y ∈ t, (N y : Set Q.left) := by rw [ht]; trivial
    obtain ⟨y, hy, hxy⟩ := Set.mem_iUnion₂.mp hx
    refine ⟨t.equivFin ⟨y, hy⟩, ?_⟩
    simp only [xs, Equiv.symm_apply_apply]
    exact hxy
  let U : Fin t.card → Y.ProEt := fun k => Scheme.ProEt.mk (O (xs k)).ι
  let V' : Fin t.card → Z.ProEt := fun k => Scheme.ProEt.mk ((N (xs k)).ι ≫ Q.hom)
  let g' : ∀ k, V' k ⟶ (wcProEtBC i).obj (U k) := fun k =>
    MorphismProperty.Over.homMk
      (Limits.pullback.lift
        (Scheme.Hom.resLE (Q.hom ≫ i) (O (xs k)) (N (xs k)) (hNO (xs k)))
        ((N (xs k)).ι ≫ Q.hom)
        ((Scheme.Hom.resLE_comp_ι (Q.hom ≫ i) (hNO (xs k))).trans (Category.assoc _ _ _).symm))
      (Limits.pullback.lift_snd _ _ _) trivial
  let ι : ∀ k, V' k ⟶ Q := fun k => MorphismProperty.Over.homMk (N (xs k)).ι rfl trivial
  refine ⟨t.card, U, V', g', ι, fun k => hO (xs k), fun k => hN (xs k), ?_⟩
  intro x
  obtain ⟨k, hk⟩ := hxs x
  refine ⟨k, ?_⟩
  show x ∈ Set.range ⇑(N (xs k)).ι
  rw [Scheme.Opens.range_ι]
  exact hk

theorem wc_proet_closed_bc_wcontr_cover {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i]
    (W : Z.ProEt) :
    Sieve.generate (fun (W' : Z.ProEt) (_ : W' ⟶ W) => ∃ V : Y.ProEt,
      W' = (wcProEtBC i).obj V ∧
      IsAffine V.left ∧ IsClosed {x : V.left | IsClosed ({x} : Set V.left)} ∧
      (∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y) ∧
      ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)} ∧
      (∀ x : V.left, IsClosed ({x} : Set V.left) →
        HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x))) ∈
      Scheme.ProEt.topology Z W :=
by
  classical

  have s3 : ∀ (W0 : Y.ProEt) (Δ : Scheme.{u}) (δ : Δ ⟶ W0.left), WeaklyEtale δ → Surjective δ →
      ∃ (V : Y.ProEt) (b : (wcProEtBC i).obj V ⟶ (wcProEtBC i).obj W0),
        V.left = Δ ∧ Surjective b.left := by
    intro W0 Δ δ hδW hδS
    haveI := W0.prop
    haveI := hδW
    refine ⟨Scheme.ProEt.mk (δ ≫ W0.hom), (wcProEtBC i).map
      (MorphismProperty.Over.homMk δ rfl trivial : Scheme.ProEt.mk (δ ≫ W0.hom) ⟶ W0), rfl, ?_⟩
    obtain ⟨m, hmdef⟩ : ∃ m : Limits.pullback (δ ≫ W0.hom) i ⟶ Limits.pullback W0.hom i,
        m = ((wcProEtBC i).map
          (MorphismProperty.Over.homMk δ rfl trivial : Scheme.ProEt.mk (δ ≫ W0.hom) ⟶ W0)).left :=
      ⟨_, rfl⟩
    rw [← hmdef]
    have hsq : m ≫ Limits.pullback.fst W0.hom i = Limits.pullback.fst (δ ≫ W0.hom) i ≫ δ := by
      rw [hmdef]
      exact Limits.pullback.lift_fst _ _ _
    have hsnd : m ≫ Limits.pullback.snd W0.hom i = Limits.pullback.snd (δ ≫ W0.hom) i := by
      rw [hmdef]
      exact MorphismProperty.Over.w ((wcProEtBC i).map
        (MorphismProperty.Over.homMk δ rfl trivial : Scheme.ProEt.mk (δ ≫ W0.hom) ⟶ W0))
    have hout : IsPullback (m ≫ Limits.pullback.snd W0.hom i)
        (Limits.pullback.fst (δ ≫ W0.hom) i) i (δ ≫ W0.hom) := by
      rw [hsnd]
      exact (IsPullback.of_hasPullback (δ ≫ W0.hom) i).flip
    have hleft : IsPullback m (Limits.pullback.fst (δ ≫ W0.hom) i)
        (Limits.pullback.fst W0.hom i) δ :=
      IsPullback.of_right hout hsq (IsPullback.of_hasPullback W0.hom i).flip
    exact MorphismProperty.of_isPullback (P := @Surjective) hleft.flip hδS

  have hA := wc_proet_cover_of_affine_local (fun _ => True)
    (fun V hV => ⟨V, 𝟙 V, hV, inferInstance, inferInstance, trivial⟩) W
  refine (Scheme.ProEt.topology Z).transitive hA _ ?_
  rintro Q' f ⟨Q, h, g, ⟨hQ, -⟩, rfl⟩
  rw [Sieve.pullback_comp]
  refine (Scheme.ProEt.topology Z).pullback_stable h ?_

  obtain ⟨n, U, V', g', ι, hU, hV', hcov⟩ := wc_proet_affine_open_chart_cover i Q hQ
  have step : ∀ k : Fin n, ∃ (Vw : Y.ProEt) (hh : (wcProEtBC i).obj Vw ⟶ V' k),
      (IsAffine Vw.left ∧ IsClosed {x : Vw.left | IsClosed ({x} : Set Vw.left)} ∧
        (∀ x : Vw.left, ∃! y : Vw.left, IsClosed ({y} : Set Vw.left) ∧ x ⤳ y) ∧
        ExtremallyDisconnected {x : Vw.left | IsClosed ({x} : Set Vw.left)} ∧
        (∀ x : Vw.left, IsClosed ({x} : Set Vw.left) →
          HenselianLocalRing (Vw.left.presheaf.stalk x) ∧ IsSepClosed (Vw.left.residueField x))) ∧
      Surjective hh.left := by
    intro k
    haveI := hU k
    obtain ⟨Wk, a, hWa, ha⟩ := wc_proet_closed_affine_lift_surj i (U k) (V' k) (g' k) (hV' k)
      wcl_weaklyEtale_lift_tensor_surj
    obtain ⟨Δ, δ, hΔa, hδW, hδS, h1, h2, h3, h4⟩ := wc_exists_wcontractible_cover Wk.left hWa
    obtain ⟨Vw, b, hVΔ, hb⟩ := s3 Wk Δ δ hδW hδS
    subst hVΔ
    refine ⟨Vw, b ≫ a, ⟨hΔa, h1, h2, h3, h4⟩, ?_⟩
    haveI := hb
    haveI := ha
    show Surjective (b.left ≫ a.left)
    infer_instance
  choose Vw hh hwcc hsurj using step
  haveI : IsAffine Q.left := hQ
  have hPaff : ∀ k, IsAffine ((wcProEtBC i).obj (Vw k)).left := by
    intro k
    haveI := (hwcc k).1
    haveI : IsAffine ((𝟭 Scheme.{u}).obj (Vw k).left) := inferInstanceAs (IsAffine (Vw k).left)
    exact (IsClosedImmersion.isAffine_surjective_of_isAffine (Limits.pullback.fst (Vw k).hom i)).1
  have hjs : ∀ x : Q.left, ∃ k, x ∈ Set.range (hh k ≫ ι k).left := by
    intro x
    obtain ⟨k, v, hv⟩ := hcov x
    haveI := hsurj k
    obtain ⟨s, hs⟩ := (hh k).left.surjective v
    refine ⟨k, s, ?_⟩
    show ((hh k).left ≫ (ι k).left) s = x
    rw [Scheme.Hom.comp_apply, hs, hv]
  have hcovQ := proet_finite_affine_jointly_surjective_covers Z Q n
    (fun k => (wcProEtBC i).obj (Vw k)) (fun k => hh k ≫ ι k) hPaff hjs
  refine (Scheme.ProEt.topology Z).superset_covering ?_ hcovQ
  rw [Sieve.generate_le_iff]
  rintro _ _ ⟨k⟩
  exact ⟨_, 𝟙 _, (hh k ≫ ι k) ≫ g, ⟨Vw k, rfl, hwcc k⟩, Category.id_comp _⟩

theorem wc_supp_slice_hom_supported {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i]
    [IsLocallyNoetherian Y] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (V : Y.ProEt)
    [(wcSliceFunctor Y V).IsContinuous (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology Y)]
    (DV : wcHMPullData (Limits.pullback.fst V.hom i) ℓ) (hDV : wcHMPullCanonical DV) :
    ∃ κ : ∀ T : SheafOfModules.{u+1} (wcRingSheaf Y ℓ),
        (wcSuppObj DV ⟶ (wcSliceRes Y ℓ V).obj T) → T.val.obj (Opposite.op V),
      (∀ (T T' : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) (g : T ⟶ T')
          (φ : wcSuppObj DV ⟶ (wcSliceRes Y ℓ V).obj T),
        κ T' (φ ≫ (wcSliceRes Y ℓ V).map g) = (g.val.app (Opposite.op V)).hom (κ T φ)) ∧
      (∀ T : SheafOfModules.{u+1} (wcRingSheaf Y ℓ), Function.Injective (κ T)) ∧
      ∀ (T : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) (t : T.val.obj (Opposite.op V)),
        (∃ φ, κ T φ = t) ↔ wcClosedSuppSec i ℓ T V t :=
by
  classical
  have hepiGen : ∀ {Z' Y' : Scheme.{u}} (i' : Z' ⟶ Y') [IsClosedImmersion i']
      (D : wcHMPullData i' ℓ), wcHMPullCanonical D → Epi (wcSuppUnitMap D) := by
    intro Z' Y' i' _ D hD
    have : (SheafOfModules.toSheaf (wcRingSheaf Y' ℓ)).ReflectsEpimorphisms :=
      Functor.reflectsEpimorphisms_of_faithful _
    apply Functor.epi_of_epi_map (SheafOfModules.toSheaf (wcRingSheaf Y' ℓ))
    apply wc_proet_epi_of_affine_lift Y'
    intro U hU y
    obtain ⟨c', hc'⟩ := wc_supp_unit_twist_isUnit D
    let y' : C(↥(Limits.pullback U.hom i'), ULift.{u+1} ℚ_[ℓ]) := y
    obtain ⟨W, g, t, hW, hg, ht⟩ := wc_fibre_function_local_extension i' ℓ U hU
      (y' * c'.comp (Limits.pullback.snd U.hom i').base.hom)
    refine ⟨W, g, t, hW, hg, ?_⟩
    have key : ((wcProEtBC i').map g).left ≫ Limits.pullback.snd U.hom i' =
        Limits.pullback.snd W.hom i' := MorphismProperty.Over.w ((wcProEtBC i').map g)
    have hk : ∀ z, (Limits.pullback.snd U.hom i').base.hom (((wcProEtBC i').map g).left.base.hom z) =
        (Limits.pullback.snd W.hom i').base.hom z := fun z => by rw [← key]; rfl
    have h3 := wc_supp_hom_twist_formula D hD (wcSuppUnitMap D) W t
    change ((wcSuppUnitMap D).val.app (Opposite.op W)).hom t =
      y'.comp ((wcProEtBC i').map g).left.base.hom
    refine h3.trans (ContinuousMap.ext fun z => ?_)
    have e1 : t ((Limits.pullback.fst W.hom i').base.hom z) =
        y' (((wcProEtBC i').map g).left.base.hom z) *
          c' ((Limits.pullback.snd U.hom i').base.hom (((wcProEtBC i').map g).left.base.hom z)) :=
      congrArg (fun φ => φ z) ht
    have e2 : wcSuppTwist (wcSuppUnitMap D) ((Limits.pullback.snd W.hom i').base.hom z) *
        c' ((Limits.pullback.snd W.hom i').base.hom z) = 1 :=
      congrArg (fun φ => φ ((Limits.pullback.snd W.hom i').base.hom z)) hc'
    show t ((Limits.pullback.fst W.hom i').base.hom z) *
        wcSuppTwist (wcSuppUnitMap D) ((Limits.pullback.snd W.hom i').base.hom z) =
      y' (((wcProEtBC i').map g).left.base.hom z)
    rw [e1, hk z]
    linear_combination (y' (((wcProEtBC i').map g).left.base.hom z)) * e2
  haveI : Epi (wcSuppUnitMap DV) := hepiGen _ DV hDV
  have k1 : ∀ (W : V.left.ProEt) (c : C(↥W.left, ULift.{u+1} ℚ_[ℓ])),
      ((wcSuppUnitMap DV).val.app (Opposite.op W)).hom c = 0 ↔
        ∀ x : ↥W.left, W.hom x ∈ Set.range (Limits.pullback.fst V.hom i) → c x = 0 := by
    intro W c
    obtain ⟨c', hc'⟩ := wc_supp_unit_twist_isUnit DV
    have h3 := wc_supp_hom_twist_formula DV hDV (wcSuppUnitMap DV) W c
    constructor
    · rintro h x ⟨y, hy⟩
      obtain ⟨z, hz1, hz2⟩ := Scheme.Pullback.exists_preimage_pullback (f := W.hom)
        (g := Limits.pullback.fst V.hom i) x y hy.symm
      have e : (c.comp (Limits.pullback.fst W.hom (Limits.pullback.fst V.hom i)).base.hom *
          (wcSuppTwist (wcSuppUnitMap DV)).comp
            (Limits.pullback.snd W.hom (Limits.pullback.fst V.hom i)).base.hom) z = 0 := by
        rw [← h3, h]
        rfl
      have e' : c x * wcSuppTwist (wcSuppUnitMap DV) y = 0 := by
        rw [← hz1, ← hz2]
        exact e
      have e2 : wcSuppTwist (wcSuppUnitMap DV) y * c' y = 1 :=
        congrArg (fun φ => φ y) hc'
      linear_combination (c' y) * e' - (c x) * e2
    · intro hc
      refine h3.trans (ContinuousMap.ext fun z => ?_)
      have hx : W.hom ((Limits.pullback.fst W.hom (Limits.pullback.fst V.hom i)) z) ∈
          Set.range (Limits.pullback.fst V.hom i) :=
        ⟨(Limits.pullback.snd W.hom (Limits.pullback.fst V.hom i)) z, by
          rw [← Scheme.Hom.comp_apply, ← Limits.pullback.condition, Scheme.Hom.comp_apply]⟩
      have h0 := hc _ hx
      show c ((Limits.pullback.fst W.hom (Limits.pullback.fst V.hom i)).base.hom z) *
          (wcSuppTwist (wcSuppUnitMap DV))
            ((Limits.pullback.snd W.hom (Limits.pullback.fst V.hom i)).base.hom z) = 0
      rw [show c ((Limits.pullback.fst W.hom (Limits.pullback.fst V.hom i)).base.hom z) = 0
        from h0, zero_mul]
  let topV : V.left.ProEt :=
    MorphismProperty.Over.mk ⊤ (𝟙 V.left) (inferInstance : WeaklyEtale (𝟙 V.left))
  let V₀ : Y.ProEt := (wcSliceFunctor Y V).obj topV
  let α : V ⟶ V₀ := MorphismProperty.Over.homMk (𝟙 V.left)
    (by change 𝟙 V.left ≫ 𝟙 V.left ≫ V.hom = V.hom; simp) trivial
  let β : V₀ ⟶ V := MorphismProperty.Over.homMk (𝟙 V.left)
    (by change 𝟙 V.left ≫ V.hom = 𝟙 V.left ≫ 𝟙 V.left ≫ V.hom; simp) trivial
  have hβα : β ≫ α = 𝟙 V₀ := MorphismProperty.Over.Hom.ext (Category.comp_id (𝟙 V.left))
  have hαβ : α ≫ β = 𝟙 V := MorphismProperty.Over.Hom.ext (Category.comp_id (𝟙 V.left))
  have mapid : ∀ (T : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) (X : (Y.ProEt)ᵒᵖ)
      (y : T.val.obj X), (T.val.map (𝟙 X)).hom y = y := by
    intro T X y
    rw [PresheafOfModules.map_id]
    rfl
  have hinv : ∀ (T : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) (y : T.val.obj (Opposite.op V₀)),
      (T.val.map β.op).hom ((T.val.map α.op).hom y) = y := by
    intro T y
    rw [← PresheafOfModules.map_comp_apply, ← op_comp, hβα, op_id, mapid]
  let πW : ∀ W : V.left.ProEt, W ⟶ topV := fun W =>
    MorphismProperty.Over.homMk W.hom (Category.comp_id _) trivial
  have hT : ∀ {W : V.left.ProEt} (π π' : W ⟶ topV), π = π' := by
    intro W π π'
    apply MorphismProperty.Over.Hom.ext
    have h1 := MorphismProperty.Over.w π
    have h2 := MorphismProperty.Over.w π'
    change π.left ≫ 𝟙 _ = W.hom at h1
    change π'.left ≫ 𝟙 _ = W.hom at h2
    rw [Category.comp_id] at h1 h2
    rw [h1, h2]
  have u1ext : ∀ (M : SheafOfModules.{u+1} (wcRingSheaf V.left ℓ))
      (ψ ψ' : SheafOfModules.unit (wcRingSheaf V.left ℓ) ⟶ M),
      (ψ.val.app (Opposite.op topV)).hom (1 : C(↥topV.left, ULift.{u+1} ℚ_[ℓ])) =
        (ψ'.val.app (Opposite.op topV)).hom (1 : C(↥topV.left, ULift.{u+1} ℚ_[ℓ])) → ψ = ψ' := by
    intro M ψ ψ' h
    apply M.unitHomEquiv.injective
    apply Subtype.ext
    funext X
    obtain ⟨W⟩ := X
    have e1 := PresheafOfModules.sections_property (M.unitHomEquiv ψ) (πW W).op
    have e2 := PresheafOfModules.sections_property (M.unitHomEquiv ψ') (πW W).op
    have c1 := SheafOfModules.unitHomEquiv_apply_coe M ψ (Opposite.op topV)
    have c2 := SheafOfModules.unitHomEquiv_apply_coe M ψ' (Opposite.op topV)
    show (M.unitHomEquiv ψ).1 (Opposite.op W) = (M.unitHomEquiv ψ').1 (Opposite.op W)
    rw [← e1, ← e2, c1, c2]
    exact congrArg (M.val.map (πW W).op).hom h
  have u1ex : ∀ (M : SheafOfModules.{u+1} (wcRingSheaf V.left ℓ))
      (m : M.val.obj (Opposite.op topV)),
      ∃ ψ : SheafOfModules.unit (wcRingSheaf V.left ℓ) ⟶ M, ∀ (W : V.left.ProEt) (π : W ⟶ topV),
        (ψ.val.app (Opposite.op W)).hom (1 : C(↥W.left, ULift.{u+1} ℚ_[ℓ])) =
          (M.val.map π.op).hom m := by
    intro M m
    let s : M.sections := PresheafOfModules.sectionsMk
      (fun X => (M.val.map (πW X.unop).op).hom m) (by
        intro X X' f
        rw [← PresheafOfModules.map_comp_apply]
        have : (πW X.unop).op ≫ f = (πW X'.unop).op := Quiver.Hom.unop_inj (hT _ _)
        rw [this])
    refine ⟨M.unitHomEquiv.symm s, fun W π => ?_⟩
    have e := SheafOfModules.unitHomEquiv_apply_coe M (M.unitHomEquiv.symm s) (Opposite.op W)
    rw [Equiv.apply_symm_apply] at e
    rw [hT π (πW W)]
    refine e.symm.trans ?_
    rfl
  refine ⟨fun T φ => (T.val.map α.op).hom
    (((wcSuppUnitMap DV ≫ φ).val.app (Opposite.op topV)).hom
      (1 : C(↥topV.left, ULift.{u+1} ℚ_[ℓ]))), ?_, ?_, ?_⟩
  · intro T T' g φ
    exact (PresheafOfModules.naturality_apply g.val α.op _).symm
  · intro T φ φ' h
    apply (cancel_epi (wcSuppUnitMap DV)).mp
    apply u1ext
    have h' := congrArg (T.val.map β.op).hom h
    exact (hinv T _).symm.trans (h'.trans (hinv T _))
  · intro T t
    constructor
    · rintro ⟨φ, rfl⟩ W g c hc
      beta_reduce
      have hg : g.left ≫ V.hom = W.hom := MorphismProperty.Over.w g
      haveI : WeaklyEtale V.hom := V.prop
      haveI : WeaklyEtale (g.left ≫ V.hom) := by rw [hg]; exact W.prop
      haveI hge : WeaklyEtale g.left := WeaklyEtale.of_comp g.left V.hom
      let W' : V.left.ProEt := MorphismProperty.Over.mk ⊤ g.left hge
      let π' : W' ⟶ topV := MorphismProperty.Over.homMk g.left (Category.comp_id _) trivial
      let γ : W ⟶ (wcSliceFunctor Y V).obj W' := MorphismProperty.Over.homMk (𝟙 W.left)
        (by change 𝟙 W.left ≫ g.left ≫ V.hom = W.hom; rw [Category.id_comp, hg]) trivial
      have hid : g ≫ α = γ ≫ (wcSliceFunctor Y V).map π' := MorphismProperty.Over.Hom.ext
        (by change g.left ≫ 𝟙 V.left = 𝟙 W.left ≫ g.left; rw [Category.comp_id, Category.id_comp])
      let ψ := wcSuppUnitMap DV ≫ φ
      let x : T.val.obj (Opposite.op V₀) :=
        (ψ.val.app (Opposite.op topV)).hom (1 : C(↥topV.left, ULift.{u+1} ℚ_[ℓ]))
      let y : T.val.obj (Opposite.op ((wcSliceFunctor Y V).obj W')) :=
        (ψ.val.app (Opposite.op W')).hom (1 : C(↥W'.left, ULift.{u+1} ℚ_[ℓ]))
      let sm : (wcRingSheaf Y ℓ).obj.obj (Opposite.op W) → T.val.obj (Opposite.op W) →
          T.val.obj (Opposite.op W) := fun a b => a • b
      have e1 : (T.val.map g.op).hom ((T.val.map α.op).hom x) =
          (T.val.map γ.op).hom ((T.val.map ((wcSliceFunctor Y V).map π').op).hom x) := by
        rw [← PresheafOfModules.map_comp_apply, ← PresheafOfModules.map_comp_apply, ← op_comp,
          ← op_comp, hid]
      have e2 : (T.val.map ((wcSliceFunctor Y V).map π').op).hom x = y := by
        have h := PresheafOfModules.naturality_apply ψ.val π'.op
          (1 : C(↥topV.left, ULift.{u+1} ℚ_[ℓ]))
        have hu : ((SheafOfModules.unit (wcRingSheaf V.left ℓ)).val.map π'.op).hom
            (1 : C(↥topV.left, ULift.{u+1} ℚ_[ℓ])) = (1 : C(↥W'.left, ULift.{u+1} ℚ_[ℓ])) :=
          PresheafOfModules.unit_map_one _ _
        exact h.symm.trans (congrArg (ψ.val.app (Opposite.op W')).hom hu)
      let c₁ : ((wcRingSheaf Y ℓ).obj.obj (Opposite.op ((wcSliceFunctor Y V).obj W'))) := c
      let c₂ : ((wcRingSheaf V.left ℓ).obj.obj (Opposite.op W')) := c
      have hR : ((wcRingSheaf Y ℓ).obj.map γ.op).hom c₁ = c := ContinuousMap.ext fun _ => rfl
      have e3 : (T.val.map γ.op).hom (c₁ • y) = sm c ((T.val.map γ.op).hom y) :=
        (PresheafOfModules.map_smul T.val γ.op c₁ y).trans
          (congrArg (fun a => sm a ((T.val.map γ.op).hom y)) hR)
      have hk : ((wcSuppUnitMap DV).val.app (Opposite.op W')).hom c₂ = 0 := by
        refine (k1 W' c₂).2 (fun x hx => ?_)
        rw [Scheme.Pullback.range_fst] at hx
        let x' : ↥W.left := x
        have e : (g.left ≫ V.hom) x' = W.hom x' := by rw [hg]
        rw [Scheme.Hom.comp_apply] at e
        have hx2 : V.hom (g.left x') ∈ Set.range i := hx
        rw [e] at hx2
        exact hc x' hx2
      have hE : (ψ.val.app (Opposite.op W')).hom c₂ = 0 := by
        show (φ.val.app (Opposite.op W')).hom
          (((wcSuppUnitMap DV).val.app (Opposite.op W')).hom c₂) = 0
        rw [hk, map_zero]
      have hD : c₁ • y = 0 := by
        have h := (ψ.val.app (Opposite.op W')).hom.map_smul c₂
          (1 : C(↥W'.left, ULift.{u+1} ℚ_[ℓ]))
        refine h.symm.trans ?_
        exact Eq.trans (congrArg (ψ.val.app (Opposite.op W')).hom (mul_one c)) hE
      show sm c ((T.val.map g.op).hom ((T.val.map α.op).hom x)) = 0
      rw [e1, e2, ← e3, hD, map_zero]
      rfl
    · intro ht
      obtain ⟨ψ, hψ⟩ := u1ex ((wcSliceRes Y ℓ V).obj T) ((T.val.map β.op).hom t)
      have hker : Limits.kernel.ι (wcSuppUnitMap DV) ≫ ψ = 0 := by
        apply SheafOfModules.hom_ext
        apply PresheafOfModules.hom_ext
        intro X
        obtain ⟨W'⟩ := X
        ext x
        let k : C(↥W'.left, ULift.{u+1} ℚ_[ℓ]) :=
          ((Limits.kernel.ι (wcSuppUnitMap DV)).val.app (Opposite.op W')).hom x
        let k₂ : ((wcRingSheaf V.left ℓ).obj.obj (Opposite.op W')) := k
        have hk0 : ((wcSuppUnitMap DV).val.app (Opposite.op W')).hom k = 0 := by
          have := congrArg (fun f => (f.val.app (Opposite.op W')).hom x)
            (Limits.kernel.condition (wcSuppUnitMap DV))
          exact this
        have hk := (k1 W' k).1 hk0
        let Wy : Y.ProEt := (wcSliceFunctor Y V).obj W'
        let gy : Wy ⟶ V := (wcSliceFunctor Y V).map (πW W') ≫ β
        have hk' : ∀ x : ↥Wy.left, Wy.hom x ∈ Set.range i → k x = 0 := by
          intro x hx
          apply hk
          rw [Scheme.Pullback.range_fst]
          let x' : ↥W'.left := x
          have e : (W'.hom ≫ V.hom) x' = V.hom (W'.hom x') := Scheme.Hom.comp_apply _ _ _
          have hx2 : (W'.hom ≫ V.hom) x' ∈ Set.range i := hx
          rw [e] at hx2
          exact hx2
        have e4 : (ψ.val.app (Opposite.op W')).hom k =
            k₂ • (ψ.val.app (Opposite.op W')).hom (1 : C(↥W'.left, ULift.{u+1} ℚ_[ℓ])) := by
          have h := (ψ.val.app (Opposite.op W')).hom.map_smul k₂
            (1 : C(↥W'.left, ULift.{u+1} ℚ_[ℓ]))
          refine Eq.trans ?_ h
          exact congrArg (ψ.val.app (Opposite.op W')).hom (mul_one k).symm
        have e5 : (((wcSliceRes Y ℓ V).obj T).val.map (πW W').op).hom ((T.val.map β.op).hom t) =
            (T.val.map gy.op).hom t := by
          show (T.val.map ((wcSliceFunctor Y V).map (πW W')).op).hom ((T.val.map β.op).hom t) = _
          rw [← PresheafOfModules.map_comp_apply]
          rfl
        have hz : ((0 : Limits.kernel (wcSuppUnitMap DV) ⟶ (wcSliceRes Y ℓ V).obj T).val.app
            (Opposite.op W')).hom x = 0 := rfl
        refine Eq.trans ?_ hz.symm
        show (ψ.val.app (Opposite.op W')).hom k = 0
        rw [e4, hψ W' (πW W'), e5]
        exact ht Wy gy k hk'
      refine ⟨Abelian.epiDesc (wcSuppUnitMap DV) ψ hker, ?_⟩
      show (T.val.map α.op).hom
        (((wcSuppUnitMap DV ≫ Abelian.epiDesc (wcSuppUnitMap DV) ψ hker).val.app
          (Opposite.op topV)).hom (1 : C(↥topV.left, ULift.{u+1} ℚ_[ℓ]))) = t
      rw [Abelian.comp_epiDesc, hψ topV (𝟙 topV)]
      show (T.val.map α.op).hom ((T.val.map ((wcSliceFunctor Y V).map (𝟙 topV)).op).hom
        ((T.val.map β.op).hom t)) = t
      rw [CategoryTheory.Functor.map_id, op_id]
      have e6 := mapid T (Opposite.op V₀) ((T.val.map β.op).hom t)
      refine Eq.trans (congrArg (T.val.map α.op).hom e6) ?_
      rw [← PresheafOfModules.map_comp_apply, ← op_comp, hαβ, op_id]
      exact mapid T (Opposite.op V) t

theorem wc_proet_open_unit_kills_vanishing_section {Y : Scheme.{u}} (V' : Y.Opens) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (Dj : wcHMPullData V'.ι ℓ) (hDj : wcHMPullCanonical Dj)
    (T : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) (V : Y.ProEt)
    (t : T.val.obj (Opposite.op V))
    (ht : ∀ (W : Y.ProEt) (g : W ⟶ V), (∀ x : ↥W.left, W.hom x ∈ (V' : Set ↥Y)) →
      (T.val.map g.op).hom t = 0) :
    ((Dj.adj.unit.app T).val.app (Opposite.op V)).hom t = 0 :=
by
  have aux : ∀ {A B C : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)} (f : A ⟶ B) (g : B ⟶ C)
      [IsIso g] (U : (Y.ProEt)ᵒᵖ) (x : A.val.obj U),
      ((f ≫ g).val.app U).hom x = 0 → (f.val.app U).hom x = 0 := by
    intro A B C f g _ U x h
    have hf : f = (f ≫ g) ≫ inv g := by simp
    rw [hf]
    change ((inv g).val.app U).hom (((f ≫ g).val.app U).hom x) = 0
    rw [h, map_zero]
  have gen : ∀ (Vo : Y.ProEt)
      (hj : (wcSliceFunctor Y Vo).IsContinuous (Scheme.ProEt.topology Vo.left)
        (Scheme.ProEt.topology Y))
      (D : wcHMPullData Vo.hom ℓ), wcHMPullCanonical D →
      (∀ (W : Y.ProEt) (g : W ⟶ V), (∀ x : ↥W.left, W.hom x ∈ Set.range Vo.hom) →
        (T.val.map g.op).hom t = 0) →
      ((D.adj.unit.app T).val.app (Opposite.op V)).hom t = 0 := by
    intro Vo hj D hD hvan
    haveI hj' : (wcSliceFunctor Y Vo).IsContinuous (Scheme.ProEt.topology ((𝟭 Scheme.{u}).obj Vo.left))
        (Scheme.ProEt.topology ((Functor.fromPUnit Y).obj Vo.right)) := hj
    letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) Vo.hom :=
      ⟨fun _ _ => inferInstance⟩
    letI : MorphismProperty.IsStableUnderBaseChangeAlong
        (@WeaklyEtale : MorphismProperty Scheme.{u}) Vo.hom :=
      (fun (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange] =>
        (inferInstance : P.IsStableUnderBaseChangeAlong Vo.hom)) (@WeaklyEtale : MorphismProperty Scheme.{u})
    let adj₀ : wcSliceFunctor Y Vo ⊣ wcProEtBC Vo.hom :=
      @MorphismProperty.Over.mapPullbackAdj Scheme.{u} _ @WeaklyEtale ⊤ _ Vo.left Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ Vo.hom _ _ _ Vo.prop trivial
    have hc : ∀ W : Y.ProEt, (adj₀.counit.app W).left = Limits.pullback.fst W.hom Vo.hom :=
      fun W => rfl
    have hu : ∀ W' : Vo.left.ProEt, (adj₀.unit.app W').left ≫
        Limits.pullback.fst ((wcSliceFunctor Y Vo).obj W').hom Vo.hom = 𝟙 W'.left :=
      fun W' => Limits.pullback.lift_fst _ _ _
    letI := D.cont
    have H1 : Functor.whiskerRight (NatTrans.op adj₀.counit) (wcRingSheaf Y ℓ).obj =
        D.φ.hom ≫ (wcProEtBC Vo.hom).op.whiskerLeft
          (𝟙 (wcRingSheaf Vo.left ℓ) : wcRingSheaf Vo.left ℓ ⟶
            ((wcSliceFunctor Y Vo).sheafPushforwardContinuous RingCat.{u+1}
              (Scheme.ProEt.topology Vo.left) (Scheme.ProEt.topology Y)).obj
              (wcRingSheaf Y ℓ)).hom := by
      ext V₁ s
      obtain ⟨W⟩ := V₁
      show s.comp (adj₀.counit.app W).left.base.hom = (D.φ.hom.app (Opposite.op W)).hom s
      rw [hD W s, hc W]
      rfl
    have H2 : (𝟙 (wcRingSheaf Vo.left ℓ) : wcRingSheaf Vo.left ℓ ⟶
            ((wcSliceFunctor Y Vo).sheafPushforwardContinuous RingCat.{u+1}
              (Scheme.ProEt.topology Vo.left) (Scheme.ProEt.topology Y)).obj
              (wcRingSheaf Y ℓ)).hom ≫
        (wcSliceFunctor Y Vo).op.whiskerLeft D.φ.hom ≫
        Functor.whiskerRight (NatTrans.op adj₀.unit) (wcRingSheaf Vo.left ℓ).obj =
        𝟙 (wcRingSheaf Vo.left ℓ).obj := by
      ext V₁ t₁
      obtain ⟨W'⟩ := V₁
      show ((D.φ.hom.app (Opposite.op ((wcSliceFunctor Y Vo).obj W'))).hom t₁).comp
          (adj₀.unit.app W').left.base.hom = t₁
      refine (congrArg (fun g => ContinuousMap.comp g (adj₀.unit.app W').left.base.hom)
        (hD ((wcSliceFunctor Y Vo).obj W') t₁)).trans ?_
      have key : ∀ t₂ : C(↥W'.left, ULift.{u+1} ℚ_[ℓ]),
          ContinuousMap.comp (ContinuousMap.comp t₂ (Limits.pullback.fst
            ((wcSliceFunctor Y Vo).obj W').hom Vo.hom).base.hom)
            (adj₀.unit.app W').left.base.hom = t₂ := by
        intro t₂
        first
        | (refine ContinuousMap.ext fun x => ?_
           change t₂ _ = t₂ x
           congr 1
           exact congrArg (fun k : W'.left ⟶ W'.left => k.base x) (hu W'))
        | (refine ContinuousMap.ext fun x => ?_
           change t₂ _ = t₂ x
           congr 1
           have e := congrArg (fun k : W'.left ⟶ W'.left => k x) (hu W')
           simpa only [Scheme.Hom.comp_apply, Scheme.Hom.id_apply] using e)
      exact key t₁
    let adjP := @SheafOfModules.pushforwardPushforwardAdj _ _ _ _ _ _ _ _ _ _ hj D.cont adj₀ _
      D.φ H1 H2
    have hpts : ∀ x : ↥((wcSliceFunctor Y Vo).obj ((wcProEtBC Vo.hom).obj V)).left,
        ((wcSliceFunctor Y Vo).obj ((wcProEtBC Vo.hom).obj V)).hom x ∈ Set.range Vo.hom := by
      intro x
      first
      | exact ⟨(Limits.pullback.snd V.hom Vo.hom) x, rfl⟩
      | (have e : ((wcSliceFunctor Y Vo).obj ((wcProEtBC Vo.hom).obj V)).hom =
            Limits.pullback.snd V.hom Vo.hom ≫ Vo.hom := by
           rw [← Limits.pullback.condition, ← hc V]
           exact (MorphismProperty.Over.w (adj₀.counit.app V)).symm
         rw [e, Scheme.Hom.comp_apply]
         exact ⟨_, rfl⟩)
    have h0 : ((adjP.unit.app T).val.app (Opposite.op V)).hom t = 0 :=
      (SheafOfModules.pushforwardPushforwardAdj_unit_app_val_app adj₀ _ D.φ H1 H2 T
        (Opposite.op V) t).trans (hvan _ (adj₀.counit.app V) hpts)
    have hst := Adjunction.unit_leftAdjointUniq_hom_app D.adj adjP T
    rw [← hst] at h0
    exact aux _ _ _ _ h0
  have slice_over_cont : ∀ (S : Scheme.{u}) (U : S.ProEt),
      (wcSliceToOver S U).IsContinuous (Scheme.ProEt.topology U.left)
        ((Scheme.ProEt.topology S).over U) := by
    intro S U
    have hmem : ∀ (T : Scheme.{u}) (V : T.ProEt) (R : Sieve V),
        R ∈ Scheme.ProEt.topology T V ↔
          Sieve.functorPushforward (Scheme.ProEt.forget T ⋙ Over.forget T) R ∈
            Scheme.proetaleTopology V.left := by
      intro T V R
      letI := MorphismProperty.IsMultiplicative.toIsStableUnderComposition (W := @WeaklyEtale)
      have hT : Scheme.ProEt.topology T =
          (Scheme.ProEt.forget T).restrictedTopology (Scheme.proetaleTopology.over T) :=
        MorphismProperty.toGrothendieck_comap_forget_eq_restrictedTopology (S := T)
          (P := @WeaklyEtale) Scheme.proetalePrecoverage
          Scheme.proetalePrecoverage_le_precoverage_weaklyEtale
      rw [hT, Functor.mem_restrictedTopology_iff, GrothendieckTopology.mem_over_iff,
        Sieve.overEquiv_apply, ← Sieve.functorPushforward_comp]
      rfl
    let εapp : ∀ V : Over U, (wcOverToSlice S U ⋙ wcSliceToOver S U).obj V ≅ V := fun V =>
      Over.isoMk (MorphismProperty.Over.isoMk (Iso.refl V.left.left)
          ((Category.id_comp _).trans (MorphismProperty.Over.w V.hom).symm))
        (MorphismProperty.Over.Hom.ext (Category.id_comp V.hom.left))
    let ε : wcOverToSlice S U ⋙ wcSliceToOver S U ≅ 𝟭 (Over U) :=
      NatIso.ofComponents εapp (fun {V V'} g => by
        apply Over.OverMorphism.ext
        apply MorphismProperty.Over.Hom.ext
        exact (Category.comp_id g.left.left).trans (Category.id_comp g.left.left).symm)
    have hmemD : ∀ (V : Over U) (R : Sieve V), R ∈ (Scheme.ProEt.topology S).over U V ↔
        Sieve.functorPushforward (Over.forget U ⋙ Scheme.ProEt.forget S ⋙ Over.forget S) R ∈
          Scheme.proetaleTopology V.left.left := by
      intro V R
      rw [GrothendieckTopology.mem_over_iff, Sieve.overEquiv_apply, hmem S V.left,
        ← Sieve.functorPushforward_comp]
    have hFc : (wcSliceToOver S U).IsCocontinuous (Scheme.ProEt.topology U.left)
        ((Scheme.ProEt.topology S).over U) := by
      constructor
      intro W T hT
      rw [hmem U.left W]
      rw [hmemD] at hT
      refine GrothendieckTopology.superset_covering _ ?_ hT
      rintro Z f ⟨V', t, a, ht, rfl⟩
      refine ⟨(wcOverToSlice S U).obj V', (wcOverToSlice S U).map t, a, ?_, rfl⟩
      show T.arrows ((wcSliceToOver S U).map ((wcOverToSlice S U).map t))
      have hft : (wcSliceToOver S U).map ((wcOverToSlice S U).map t) = (εapp V').hom ≫ t := by
        apply Over.OverMorphism.ext
        apply MorphismProperty.Over.Hom.ext
        exact (Category.id_comp t.left.left).symm
      exact (congrArg (fun g => T.arrows g) hft).mpr (T.downward_closed ht _)
    have hGc : (wcOverToSlice S U).IsCocontinuous ((Scheme.ProEt.topology S).over U)
        (Scheme.ProEt.topology U.left) := by
      constructor
      intro V T hT
      rw [hmemD]
      rw [hmem U.left] at hT
      refine GrothendieckTopology.superset_covering _ ?_ hT
      rintro Z f ⟨W', t, a, ht, rfl⟩
      refine ⟨(wcSliceToOver S U).obj W', (wcSliceToOver S U).map t ≫ (εapp V).hom, a, ?_, ?_⟩
      · show T.arrows ((wcOverToSlice S U).map ((wcSliceToOver S U).map t ≫ (εapp V).hom))
        have hgt : (wcOverToSlice S U).map ((wcSliceToOver S U).map t ≫ (εapp V).hom) = t := by
          apply MorphismProperty.Over.Hom.ext
          exact Category.comp_id t.left
        exact (congrArg (fun g => T.arrows g) hgt).mpr ht
      · exact (congrArg (a ≫ ·) (Category.comp_id t.left)).symm
    let eqv : U.left.ProEt ≌ Over U :=
      Equivalence.mk' (wcSliceToOver S U) (wcOverToSlice S U) (Iso.refl _) ε (fun W => by
        apply Over.OverMorphism.ext
        apply MorphismProperty.Over.Hom.ext
        exact Category.comp_id (𝟙 W.left))
    haveI : eqv.functor.IsCocontinuous (Scheme.ProEt.topology U.left)
        ((Scheme.ProEt.topology S).over U) := hFc
    haveI : eqv.inverse.IsCocontinuous ((Scheme.ProEt.topology S).over U)
        (Scheme.ProEt.topology U.left) := hGc
    haveI := Equivalence.isDenseSubsite_functor_of_isCocontinuous (Scheme.ProEt.topology U.left)
      ((Scheme.ProEt.topology S).over U) eqv
    haveI := Equivalence.isDenseSubsite_inverse_of_isCocontinuous (Scheme.ProEt.topology U.left)
      ((Scheme.ProEt.topology S).over U) eqv
    exact (inferInstance : eqv.functor.IsContinuous (Scheme.ProEt.topology U.left)
      ((Scheme.ProEt.topology S).over U))
  haveI hσ : (wcSliceToOver Y (Scheme.ProEt.mk V'.ι)).IsContinuous
      (Scheme.ProEt.topology (Scheme.ProEt.mk V'.ι).left)
      ((Scheme.ProEt.topology Y).over (Scheme.ProEt.mk V'.ι)) :=
    slice_over_cont Y (Scheme.ProEt.mk V'.ι)
  have hj : (wcSliceFunctor Y (Scheme.ProEt.mk V'.ι)).IsContinuous
      (Scheme.ProEt.topology (Scheme.ProEt.mk V'.ι).left) (Scheme.ProEt.topology Y) :=
    Functor.isContinuous_comp (wcSliceToOver Y (Scheme.ProEt.mk V'.ι))
      (Over.forget (Scheme.ProEt.mk V'.ι))
      (Scheme.ProEt.topology (Scheme.ProEt.mk V'.ι).left)
      ((Scheme.ProEt.topology Y).over (Scheme.ProEt.mk V'.ι)) (Scheme.ProEt.topology Y)
  refine gen (Scheme.ProEt.mk V'.ι) hj Dj hDj ?_
  intro W g hW
  apply ht W g
  intro x
  have hx := hW x
  have hr : Set.range (Scheme.ProEt.mk V'.ι).hom = (V' : Set ↥Y) := Scheme.Opens.range_ι V'
  rw [hr] at hx
  exact hx

theorem wc_closed_push_free_hom_supported {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i]
    [IsLocallyNoetherian Y] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (Rs : SheafOfModules.{u+1} (wcRingSheaf Y ℓ) ⥤ SheafOfModules.{u+1} (wcRingSheaf Z ℓ))
    (adj : @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ ⊣ Rs)
    (V : Y.ProEt)
    (P : SheafOfModules.{u+1} (wcRingSheaf Z ℓ))
    (ev : ∀ M : SheafOfModules.{u+1} (wcRingSheaf Z ℓ),
      (P ⟶ M) ≃ M.val.obj (Opposite.op ((wcProEtBC i).obj V)))
    (hnat : ∀ (M N : SheafOfModules.{u+1} (wcRingSheaf Z ℓ)) (ψ : M ⟶ N) (g : P ⟶ M),
      ev N (g ≫ ψ) = (ψ.val.app (Opposite.op ((wcProEtBC i).obj V))).hom (ev M g))
    (hadd : ∀ (M : SheafOfModules.{u+1} (wcRingSheaf Z ℓ)) (g g' : P ⟶ M),
      ev M (g + g') = ev M g + ev M g')
    (T : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) :
    (∀ f f' : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).obj P ⟶ T,
      (f.val.app (Opposite.op V)).hom (ev P (𝟙 P)) =
        (f'.val.app (Opposite.op V)).hom (ev P (𝟙 P)) → f = f') ∧
    ∀ t : T.val.obj (Opposite.op V),
      (∃ f : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).obj P ⟶ T,
        (f.val.app (Opposite.op V)).hom (ev P (𝟙 P)) = t) ↔
      wcClosedSuppSec i ℓ T V t :=
by
  classical
  haveI := Di.additive
  letI hLadd : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).Additive :=
    Adjunction.right_adjoint_additive Di.adj
  haveI : Rs.Additive := Adjunction.right_adjoint_additive adj

  obtain ⟨V', hV'⟩ : ∃ V' : Y.Opens, (V' : Set Y) = (Set.range i)ᶜ :=
    ⟨⟨_, i.isClosedEmbedding.isClosed_range.isOpen_compl⟩, rfl⟩
  obtain ⟨Dj, hDj⟩ := wc_hm_pull_data_exists V'.ι ℓ
  haveI := Dj.additive
  haveI := Dj.presLim
  haveI := Dj.presColim
  haveI : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC V'.ι) _ _ Dj.cont Dj.φ).Additive :=
    Adjunction.right_adjoint_additive Dj.adj

  obtain ⟨PY, evY, hnatY, haddY⟩ :=
    sheafOfModules_free_yoneda (Scheme.ProEt.topology Y) (wcRingSheaf Y ℓ) V
  have evY0 : ∀ M : SheafOfModules.{u+1} (wcRingSheaf Y ℓ), evY M 0 = 0 := by
    intro M
    have h := haddY M 0 0
    rw [add_zero] at h
    have h2 : evY M 0 + evY M 0 = evY M 0 + 0 := by rw [add_zero]; exact h.symm
    exact add_left_cancel h2

  have G1 : ∀ (T' : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) (g : P ⟶ Rs.obj T'),
      ((((adj.homEquiv P T').symm g).val.app (Opposite.op V)).hom (ev P (𝟙 P))) =
        ((adj.counit.app T').val.app (Opposite.op V)).hom (ev (Rs.obj T') g) := by
    intro T' g
    have e2 := hnat P (Rs.obj T') g (𝟙 P)
    rw [Category.id_comp] at e2
    rw [e2, Adjunction.homEquiv_counit]
    rfl

  have L1 : ∀ T' : SheafOfModules.{u+1} (wcRingSheaf Y ℓ), Mono (adj.counit.app T') := by
    intro T'
    apply Preadditive.mono_of_cancel_zero
    intro A g hg
    have hι : Limits.image.ι g ≫ adj.counit.app T' = 0 := by
      apply Limits.zero_of_epi_comp (Limits.factorThruImage g)
      rw [← Category.assoc, Limits.image.fac, hg]
    have h0 : Limits.IsZero (Dj.Φ.obj (Limits.image g)) :=
      Limits.IsZero.of_mono (Dj.Φ.map (Limits.image.ι g))
        (wc_proet_open_pull_closed_push_isZero i ℓ V' hV' Di Dj hDj (Rs.obj T'))
    obtain ⟨M, ⟨α⟩⟩ :=
      wc_proet_closed_push_essImage_of_open_pull_isZero i ℓ V' hV' Di hDi Dj hDj _ h0
    obtain ⟨h, hh⟩ := (wc_proet_closed_push_modules_full_faithful i ℓ Di hDi).1.map_surjective
      (α.hom ≫ Limits.image.ι g)
    have h0' : h = 0 := by
      have e : (adj.homEquiv M T').symm h = 0 := by
        rw [Adjunction.homEquiv_counit, hh, Category.assoc, hι, Limits.comp_zero]
      rw [← (adj.homEquiv M T').apply_symm_apply h, e, Adjunction.homEquiv_unit,
        Functor.map_zero, Limits.comp_zero]
    have hι0 : Limits.image.ι g = 0 := by
      have e : α.hom ≫ Limits.image.ι g = 0 := by rw [← hh, h0', Functor.map_zero]
      rw [← Iso.inv_hom_id_assoc α (Limits.image.ι g), e, Limits.comp_zero]
    rw [← Limits.image.fac g, hι0, Limits.comp_zero]

  have G2 : ∀ r r' : ↑(((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _
        Di.cont Di.φ).obj (Rs.obj T)).val.obj (Opposite.op V)),
      ((adj.counit.app T).val.app (Opposite.op V)).hom r =
        ((adj.counit.app T).val.app (Opposite.op V)).hom r' → r = r' := by
    intro r r' hr
    haveI := L1 T
    have h1 : evY T ((evY _).symm r ≫ adj.counit.app T) =
        evY T ((evY _).symm r' ≫ adj.counit.app T) := by
      rw [hnatY, hnatY, Equiv.apply_symm_apply, Equiv.apply_symm_apply]
      exact hr
    have h3 := (cancel_mono (adj.counit.app T)).1 ((evY T).injective h1)
    have h4 := congrArg (evY _) h3
    rwa [Equiv.apply_symm_apply, Equiv.apply_symm_apply] at h4

  refine ⟨fun f f' hff => ?_, fun t => ⟨fun ⟨f, hf⟩ => ?_, fun hs => ?_⟩⟩
  · have e1 := G1 T (adj.homEquiv P T f)
    have e2 := G1 T (adj.homEquiv P T f')
    rw [Equiv.symm_apply_apply] at e1 e2
    rw [e1, e2] at hff
    exact (adj.homEquiv P T).injective ((ev _).injective (G2 _ _ hff))
  · intro W g c hc
    beta_reduce
    have hc0 : (Di.φ.hom.app (Opposite.op W)).hom c = 0 := by
      rw [hDi W c]
      refine ContinuousMap.ext fun p => ?_
      have hp : W.hom ((Limits.pullback.fst W.hom i) p) = i ((Limits.pullback.snd W.hom i) p) := by
        have := congrArg (fun k : Limits.pullback W.hom i ⟶ Y => k.base p) Limits.pullback.condition
        simpa using this
      exact hc _ ⟨_, hp.symm⟩
    have hcm : ∀ (c' : ↑((wcRingSheaf Y ℓ).obj.obj (Opposite.op W)))
        (m : ↑(((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _
          Di.cont Di.φ).obj P).val.obj (Opposite.op W))),
        (Di.φ.hom.app (Opposite.op W)).hom c' = 0 → c' • m = 0 := by
      intro c' m h
      let m' : ↑(P.val.obj (Opposite.op ((wcProEtBC i).obj W))) := m
      let a : ↑((wcRingSheaf Z ℓ).obj.obj (Opposite.op ((wcProEtBC i).obj W))) :=
        (Di.φ.hom.app (Opposite.op W)).hom c'
      have ha : a = 0 := h
      have e : c' • m = a • m' := rfl
      rw [e, ha, zero_smul]
      rfl
    have hnatf : (T.val.map g.op).hom ((f.val.app (Opposite.op V)).hom (ev P (𝟙 P))) =
        (f.val.app (Opposite.op W)).hom
          ((((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _
            Di.cont Di.φ).obj P).val.map g.op).hom (ev P (𝟙 P))) :=
      (PresheafOfModules.naturality_apply f.val g.op _).symm
    let c' : ↑((wcRingSheaf Y ℓ).obj.obj (Opposite.op W)) := c
    let m : ↑(((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _
          Di.cont Di.φ).obj P).val.obj (Opposite.op W)) :=
      ((((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _
            Di.cont Di.φ).obj P).val.map g.op).hom (ev P (𝟙 P)))
    have h1 : c' • (f.val.app (Opposite.op W)).hom m = (f.val.app (Opposite.op W)).hom (c' • m) :=
      (map_smul _ c' m).symm
    have h2 : (f.val.app (Opposite.op W)).hom (c' • m) = 0 := by
      rw [hcm c' m hc0, map_zero]
    rw [← hf, hnatf]
    exact h1.trans h2
  ·
    have hvan : ∀ (W : Y.ProEt) (g : W ⟶ V), (∀ x : ↥W.left, W.hom x ∈ (V' : Set ↥Y)) →
        (T.val.map g.op).hom t = 0 := by
      intro W g hW
      have h1 := hs W g 1 (fun x hx => by
        have := hW x
        rw [hV'] at this
        exact absurd hx this)
      have h2 : (1 : ↑((wcRingSheaf Y ℓ).obj.obj (Opposite.op W))) • (T.val.map g.op).hom t = 0 :=
        h1
      rwa [one_smul] at h2
    have hu := wc_proet_open_unit_kills_vanishing_section V' ℓ Dj hDj T V t hvan
    obtain ⟨τ, hτ⟩ : ∃ τ : PY ⟶ T, evY T τ = t := ⟨_, Equiv.apply_symm_apply _ _⟩

    have hτu : τ ≫ Dj.adj.unit.app T = 0 := by
      apply (evY _).injective
      rw [hnatY, evY0, hτ]
      exact hu

    have hΦτ : Dj.Φ.map τ = 0 := by
      apply (Dj.adj.homEquiv PY (Dj.Φ.obj T)).injective
      have e := Dj.adj.homEquiv_naturality_left τ (𝟙 (Dj.Φ.obj T))
      rw [Category.comp_id, Adjunction.homEquiv_id] at e
      rw [e, hτu, Adjunction.homEquiv_unit, Functor.map_zero, Limits.comp_zero]

    have hΦp : Dj.Φ.map (Limits.factorThruImage τ) = 0 := by
      apply Limits.zero_of_comp_mono (Dj.Φ.map (Limits.image.ι τ))
      rw [← Functor.map_comp, Limits.image.fac, hΦτ]
    have hK : Limits.IsZero (Dj.Φ.obj (Limits.image τ)) :=
      Limits.IsZero.of_epi_eq_zero _ hΦp

    obtain ⟨M, ⟨α⟩⟩ :=
      wc_proet_closed_push_essImage_of_open_pull_isZero i ℓ V' hV' Di hDi Dj hDj _ hK

    have ht1 : t = (τ.val.app (Opposite.op V)).hom (evY PY (𝟙 PY)) := by
      have := hnatY PY T τ (𝟙 PY)
      rw [Category.id_comp, hτ] at this
      exact this
    have ht2 : (τ.val.app (Opposite.op V)).hom (evY PY (𝟙 PY)) =
        ((α.hom ≫ Limits.image.ι τ).val.app (Opposite.op V)).hom
          (((Limits.factorThruImage τ ≫ α.inv).val.app (Opposite.op V)).hom (evY PY (𝟙 PY))) := by
      have e : τ = (Limits.factorThruImage τ ≫ α.inv) ≫ (α.hom ≫ Limits.image.ι τ) := by
        rw [Category.assoc, Iso.inv_hom_id_assoc, Limits.image.fac]
      conv_lhs => rw [e]
      rfl
    have ht3 : ∀ (k : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _
          Di.cont Di.φ).obj M ⟶ T)
        (y : ↑(((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _
          Di.cont Di.φ).obj M).val.obj (Opposite.op V))),
        (k.val.app (Opposite.op V)).hom y =
          ((adj.counit.app T).val.app (Opposite.op V)).hom
            (((adj.homEquiv M T k).val.app (Opposite.op ((wcProEtBC i).obj V))).hom y) := by
      intro k y
      conv_lhs => rw [← (adj.homEquiv M T).symm_apply_apply k, Adjunction.homEquiv_counit]
      rfl
    refine ⟨(adj.homEquiv P T).symm ((ev (Rs.obj T)).symm
      (((adj.homEquiv M T (α.hom ≫ Limits.image.ι τ)).val.app
        (Opposite.op ((wcProEtBC i).obj V))).hom
        (((Limits.factorThruImage τ ≫ α.inv).val.app (Opposite.op V)).hom
          (evY PY (𝟙 PY))))), ?_⟩
    rw [G1, Equiv.apply_symm_apply, ← ht3, ← ht2, ← ht1]

theorem wc_shriek_free_ext_slice_supp_equiv {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i]
    [IsLocallyNoetherian Y] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (Rs : SheafOfModules.{u+1} (wcRingSheaf Y ℓ) ⥤ SheafOfModules.{u+1} (wcRingSheaf Z ℓ))
    (adj : @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ ⊣ Rs)
    (V : Y.ProEt)
    (P : SheafOfModules.{u+1} (wcRingSheaf Z ℓ))
    (ev : ∀ M : SheafOfModules.{u+1} (wcRingSheaf Z ℓ),
      (P ⟶ M) ≃ M.val.obj (Opposite.op ((wcProEtBC i).obj V)))
    (hnat : ∀ (M N : SheafOfModules.{u+1} (wcRingSheaf Z ℓ)) (ψ : M ⟶ N) (g : P ⟶ M),
      ev N (g ≫ ψ) = (ψ.val.app (Opposite.op ((wcProEtBC i).obj V))).hom (ev M g))
    (hadd : ∀ (M : SheafOfModules.{u+1} (wcRingSheaf Z ℓ)) (g g' : P ⟶ M),
      ev M (g + g') = ev M g + ev M g')
    (DV : wcHMPullData (Limits.pullback.fst V.hom i) ℓ) (hDV : wcHMPullCanonical DV) (q : ℕ) :
    Nonempty (@Abelian.Ext (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) _ _ (HasExt.standard _)
        ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).obj P)
        (SheafOfModules.unit (wcRingSheaf Y ℓ)) q ≃ wcSuppExt DV q) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V.left ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf ((Functor.fromPUnit Y).obj V.right) ℓ)) :=
    HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf ((𝟭 Scheme).obj V.left) ℓ)) :=
    HasExt.standard _

  haveI hσ : (wcSliceToOver Y V).IsContinuous (Scheme.ProEt.topology V.left)
      ((Scheme.ProEt.topology Y).over V) := (wc_slice_over_sites_cont Y V).1
  haveI hj : (wcSliceFunctor Y V).IsContinuous (Scheme.ProEt.topology V.left)
      (Scheme.ProEt.topology Y) := by
    have h := Functor.isContinuous_comp (wcSliceToOver Y V) (Over.forget V)
      (Scheme.ProEt.topology V.left) ((Scheme.ProEt.topology Y).over V) (Scheme.ProEt.topology Y)
    exact h

  obtain ⟨DV', hDV'⟩ := wc_hm_pull_data_exists V.hom ℓ
  obtain ⟨θ⟩ := wc_hm_pull_Phi_slice_iso Y ℓ V DV' hDV'
  haveI := DV'.additive
  haveI := DV'.presLim
  haveI := DV'.presColim
  haveI : (wcSliceRes Y ℓ V).Additive := Functor.additive_of_iso θ
  haveI : Limits.PreservesFiniteLimits (wcSliceRes Y ℓ V) :=
    Limits.preservesFiniteLimits_of_natIso θ
  haveI : Limits.PreservesFiniteColimits (wcSliceRes Y ℓ V) :=
    Limits.preservesFiniteColimits_of_natIso θ
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) :=
    sheafOfModules_enoughInjectives (Scheme.ProEt.topology Y) (wcRingSheaf Y ℓ)
  haveI := wc_slice_unit_isIso Y ℓ V

  have hb1 := wc_closed_push_free_hom_supported i ℓ Di hDi Rs adj V P ev hnat hadd
  obtain ⟨κ, hκnat, hκinj, hκim⟩ := wc_supp_slice_hom_supported i ℓ V DV hDV

  have he : wcClosedSuppSec i ℓ
      ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).obj P) V
      (ev P (𝟙 P)) :=
    ((hb1 ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).obj P)).2
      (ev P (𝟙 P))).1 ⟨𝟙 _, rfl⟩
  obtain ⟨ε, hε⟩ := (hκim
    ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).obj P)
    (ev P (𝟙 P))).2 he

  have hcomp : ∀ (T : SheafOfModules.{u+1} (wcRingSheaf Y ℓ))
      (f : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).obj P ⟶ T),
      κ T (ε ≫ (wcSliceRes Y ℓ V).map f) = (f.val.app (Opposite.op V)).hom (ev P (𝟙 P)) := by
    intro T f
    rw [hκnat, hε]

  have hhom : ∀ T : SheafOfModules.{u+1} (wcRingSheaf Y ℓ), Function.Bijective
      (fun f : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).obj P
        ⟶ T => ε ≫ (wcSliceRes Y ℓ V).map f) := by
    intro T
    refine ⟨fun f f' h => ?_, fun φ => ?_⟩
    · have h' : κ T (ε ≫ (wcSliceRes Y ℓ V).map f) = κ T (ε ≫ (wcSliceRes Y ℓ V).map f') :=
        congrArg (κ T) h
      rw [hcomp, hcomp] at h'
      exact (hb1 T).1 f f' h'
    · obtain ⟨f, hf⟩ := ((hb1 T).2 (κ T φ)).2 ((hκim T (κ T φ)).1 ⟨φ, rfl⟩)
      refine ⟨f, hκinj T ?_⟩
      show κ T (ε ≫ (wcSliceRes Y ℓ V).map f) = κ T φ
      rw [hcomp, hf]

  have hvan : ∀ (I : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) [Injective I] (n : ℕ)
      (e : Abelian.Ext (wcSuppObj DV) ((wcSliceRes Y ℓ V).obj I) (n + 1)), e = 0 := by
    intro I _ n e
    haveI := wc_slice_res_preserves_injective Y ℓ V I
    exact Abelian.Ext.eq_zero_of_injective e

  have hbij := ext_transfer_of_corep (wcSliceRes Y ℓ V)
    ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).obj P)
    (wcSuppObj DV) ε hhom hvan (SheafOfModules.unit (wcRingSheaf Y ℓ)) q
  have hpost : Function.Bijective (fun x : Abelian.Ext (wcSuppObj DV)
      ((wcSliceRes Y ℓ V).obj (SheafOfModules.unit (wcRingSheaf Y ℓ))) q =>
        x.comp (Abelian.Ext.mk₀ (inv (wcSliceUnit Y ℓ V))) (add_zero q)) := by
    refine Function.bijective_iff_has_inverse.mpr
      ⟨fun z => z.comp (Abelian.Ext.mk₀ (wcSliceUnit Y ℓ V)) (add_zero q), fun x => ?_, fun z => ?_⟩
    · show (x.comp (Abelian.Ext.mk₀ (inv (wcSliceUnit Y ℓ V))) (add_zero q)).comp
        (Abelian.Ext.mk₀ (wcSliceUnit Y ℓ V)) (add_zero q) = x
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, IsIso.inv_hom_id,
        Abelian.Ext.comp_mk₀_id]
    · show (z.comp (Abelian.Ext.mk₀ (wcSliceUnit Y ℓ V)) (add_zero q)).comp
        (Abelian.Ext.mk₀ (inv (wcSliceUnit Y ℓ V))) (add_zero q) = z
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, IsIso.hom_inv_id,
        Abelian.Ext.comp_mk₀_id]
  exact ⟨(Equiv.ofBijective _ hbij).trans (Equiv.ofBijective _ hpost)⟩

theorem wc_supp_unit_epi_of_closed {Z' Y' : Scheme.{u}} (i' : Z' ⟶ Y') [IsClosedImmersion i']
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (D : wcHMPullData i' ℓ) (hD : wcHMPullCanonical D) :
    Epi (wcSuppUnitMap D) :=
by
  classical
  have : (SheafOfModules.toSheaf (wcRingSheaf Y' ℓ)).ReflectsEpimorphisms :=
    Functor.reflectsEpimorphisms_of_faithful _
  apply Functor.epi_of_epi_map (SheafOfModules.toSheaf (wcRingSheaf Y' ℓ))
  apply wc_proet_epi_of_affine_lift Y'
  intro U hU y
  obtain ⟨c', hc'⟩ := wc_supp_unit_twist_isUnit D
  let y' : C(↥(Limits.pullback U.hom i'), ULift.{u+1} ℚ_[ℓ]) := y
  obtain ⟨W, g, t, hW, hg, ht⟩ := wc_fibre_function_local_extension i' ℓ U hU
    (y' * c'.comp (Limits.pullback.snd U.hom i').base.hom)
  refine ⟨W, g, t, hW, hg, ?_⟩
  have key : ((wcProEtBC i').map g).left ≫ Limits.pullback.snd U.hom i' =
      Limits.pullback.snd W.hom i' := MorphismProperty.Over.w ((wcProEtBC i').map g)
  have hk : ∀ z, (Limits.pullback.snd U.hom i').base.hom (((wcProEtBC i').map g).left.base.hom z) =
      (Limits.pullback.snd W.hom i').base.hom z := fun z => by rw [← key]; rfl
  have h3 := wc_supp_hom_twist_formula D hD (wcSuppUnitMap D) W t
  change ((wcSuppUnitMap D).val.app (Opposite.op W)).hom t =
    y'.comp ((wcProEtBC i').map g).left.base.hom
  refine h3.trans (ContinuousMap.ext fun z => ?_)
  have e1 : t ((Limits.pullback.fst W.hom i').base.hom z) =
      y' (((wcProEtBC i').map g).left.base.hom z) *
        c' ((Limits.pullback.snd U.hom i').base.hom (((wcProEtBC i').map g).left.base.hom z)) :=
    congrArg (fun φ => φ z) ht
  have e2 : wcSuppTwist (wcSuppUnitMap D) ((Limits.pullback.snd W.hom i').base.hom z) *
      c' ((Limits.pullback.snd W.hom i').base.hom z) = 1 :=
    congrArg (fun φ => φ ((Limits.pullback.snd W.hom i').base.hom z)) hc'
  show t ((Limits.pullback.fst W.hom i').base.hom z) *
      wcSuppTwist (wcSuppUnitMap D) ((Limits.pullback.snd W.hom i').base.hom z) =
    y' (((wcProEtBC i').map g).left.base.hom z)
  rw [e1, hk z]
  linear_combination (y' (((wcProEtBC i').map g).left.base.hom z)) * e2

theorem wc_supp_kernel_section_local_cover_qc {T V : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (i : T ⟶ V) [IsClosedImmersion i]
    (hqc : ∀ (W : Scheme.{u}) [IsAffine W] (p : W ⟶ V), ∃ (n : ℕ) (f : Fin n → Γ(W, ⊤)),
      ∀ x : ↥W, (p x ∉ Set.range i ↔ ∃ k, x ∈ W.basicOpen (f k)))
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (U : V.ProEt) (k : (Limits.kernel (wcSuppUnitMap Di)).val.obj (Opposite.op U))
    (W : V.ProEt) (g : W ⟶ U) (hW : IsAffine W.left) :
    ∃ (n : ℕ) (W' : Fin n → V.ProEt) (e : ∀ j, W' j ⟶ W),
      (∀ j, IsAffine (W' j).left) ∧ (∀ x : ↥W.left, ∃ j, x ∈ Set.range (e j).left) ∧
      ∀ j, (∀ x : ↥(W' j).left, (W' j).hom x ∉ Set.range i) ∨
        ((Limits.kernel (wcSuppUnitMap Di)).val.map (e j ≫ g).op).hom k = 0 :=
by
  classical
  haveI : IsAffine W.left := hW
  haveI : WeaklyEtale W.hom := W.prop
  let t : C(↥U.left, ULift.{u+1} ℚ_[ℓ]) :=
    ((Limits.kernel.ι (wcSuppUnitMap Di)).val.app (Opposite.op U)).hom k
  have hk0 : ((wcSuppUnitMap Di).val.app (Opposite.op U)).hom t = 0 := by
    have hk := congrArg (fun φ => (φ.val.app (Opposite.op U)).hom k)
      (Limits.kernel.condition (wcSuppUnitMap Di))
    change ((wcSuppUnitMap Di).val.app (Opposite.op U)).hom
      (((Limits.kernel.ι (wcSuppUnitMap Di)).val.app (Opposite.op U)).hom k) = 0 at hk
    exact hk
  have vanish : ∀ y : ↥U.left, U.hom y ∈ Set.range i → t y = 0 := by
    intro y hy
    have hy' : y ∈ Set.range (Limits.pullback.fst U.hom i) := by
      rw [Scheme.Pullback.range_fst]; exact hy
    obtain ⟨z, rfl⟩ := hy'
    obtain ⟨c', hc'⟩ := wc_supp_unit_twist_isUnit Di
    have htw := wc_supp_hom_twist_formula Di hDi (wcSuppUnitMap Di) U t
    rw [hk0] at htw
    have h1 := congrArg
      (fun φ : C(↥(Limits.pullback U.hom i), ULift.{u+1} ℚ_[ℓ]) => φ z) htw
    have h2 := congrArg (fun φ : C(↥T, ULift.{u+1} ℚ_[ℓ]) =>
      φ ((Limits.pullback.snd U.hom i).base.hom z)) hc'
    simp only [ContinuousMap.mul_apply, ContinuousMap.comp_apply,
      ContinuousMap.one_apply] at h1 h2
    have h1' : (0 : ULift.{u+1} ℚ_[ℓ]) =
        t ((Limits.pullback.fst U.hom i).base.hom z) *
          (wcSuppTwist (wcSuppUnitMap Di)) ((Limits.pullback.snd U.hom i).base.hom z) := h1
    show t ((Limits.pullback.fst U.hom i).base.hom z) = 0
    linear_combination (-(c' ((Limits.pullback.snd U.hom i).base.hom z))) * h1' -
      (t ((Limits.pullback.fst U.hom i).base.hom z)) * h2
  have htW : ∀ x : ↥W.left, W.hom x ∈ Set.range i → (t.comp g.left.base.hom) x = 0 := by
    intro x hx
    apply vanish
    have e : U.hom (g.left x) = W.hom x := by
      rw [← MorphismProperty.Over.w g]; rfl
    rw [e]; exact hx
  obtain ⟨W₀, q, hW₀, hq, hq0, hqr⟩ :=
    wc_affine_zero_locus_weaklyEtale W.left ℓ (t.comp g.left.base.hom)
  obtain ⟨n, f, hf⟩ := hqc W.left W.hom
  haveI := hq
  let W' : Fin (n + 1) → V.ProEt :=
    Fin.cases (MorphismProperty.Over.mk ⊤ (q ≫ W.hom) inferInstance)
      (fun k => MorphismProperty.Over.mk ⊤ ((W.left.basicOpen (f k)).ι ≫ W.hom) inferInstance)
  let e : ∀ k, W' k ⟶ W := Fin.cases (motive := fun k => W' k ⟶ W)
    (MorphismProperty.Over.homMk q rfl trivial)
    (fun k => MorphismProperty.Over.homMk (W.left.basicOpen (f k)).ι rfl trivial)
  refine ⟨n + 1, W', e, ?_, ?_, ?_⟩
  · intro j
    induction j using Fin.cases with
    | zero => exact hW₀
    | succ j => exact (isAffineOpen_top W.left).basicOpen (f j)
  · intro x
    by_cases hx : W.hom x ∈ Set.range i
    · exact ⟨0, hqr x (htW x hx)⟩
    · obtain ⟨j, hj⟩ := (hf x).mp hx
      refine ⟨j.succ, ?_⟩
      show x ∈ Set.range (W.left.basicOpen (f j)).ι
      rw [Scheme.Opens.range_ι]
      exact hj
  · intro j
    induction j using Fin.cases with
    | zero =>
      right
      let G := SheafOfModules.forget (wcRingSheaf V ℓ) ⋙
        PresheafOfModules.evaluation _ (Opposite.op (W' 0))
      have hmono : Mono (G.map (Limits.kernel.ι (wcSuppUnitMap Di))) := Functor.map_mono G _
      have hinj := (ModuleCat.mono_iff_injective _).mp hmono
      apply hinj
      have hn := PresheafOfModules.naturality_apply (Limits.kernel.ι (wcSuppUnitMap Di)).val
        (e 0 ≫ g).op k
      have h0 : (t.comp ((e 0 ≫ g).left.base.hom) : C(↥(W' 0).left, ULift.{u+1} ℚ_[ℓ])) = 0 := by
        ext w
        exact congrArg ULift.down (hq0 w)
      refine (hn.trans ?_).trans (map_zero _).symm
      change t.comp ((e 0 ≫ g).left.base.hom) = 0
      exact h0
    | succ j =>
      left
      intro x
      have hx : (W.left.basicOpen (f j)).ι x ∈ (W.left.basicOpen (f j) : Set ↥W.left) := by
        rw [← Scheme.Opens.range_ι]; exact ⟨x, rfl⟩
      exact (hf _).mpr ⟨j, hx⟩

theorem wc_supp_les_open_boundary {T V : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (j : T ⟶ V) [IsClosedImmersion j] (Dj : wcHMPullData j ℓ) (hDj : wcHMPullCanonical Dj)
    (hepi : Epi (wcSuppUnitMap Dj))
    (hker : ∀ (U : V.ProEt) (k : (Limits.kernel (wcSuppUnitMap Dj)).val.obj (Opposite.op U))
      (W : V.ProEt) (g : W ⟶ U), IsAffine W.left →
      ∃ (n : ℕ) (W' : Fin n → V.ProEt) (e : ∀ a, W' a ⟶ W),
        (∀ a, IsAffine (W' a).left) ∧ (∀ x : ↥W.left, ∃ a, x ∈ Set.range (e a).left) ∧
        ∀ a, (∀ x : ↥(W' a).left, (W' a).hom x ∉ Set.range j) ∨
          ((Limits.kernel (wcSuppUnitMap Dj)).val.map (e a ≫ g).op).hom k = 0)
    (Wo : V.Opens) (hW : (Wo : Set ↥V) = (Set.range j)ᶜ)
    (Dw : wcHMPullData Wo.ι ℓ) (hDw : wcHMPullCanonical Dw) (n₀ n₁ : ℕ) (hn : n₀ + 1 = n₁) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V ℓ)) := HasExt.standard _
    ∃ δ : wcHM Wo.toScheme ℓ n₀ →+ wcSuppExt Dj n₁,
      (∀ θ : wcSuppExt Dj n₁, wcSuppClass Dj n₁ θ = 0 → ∃ α : wcHM Wo.toScheme ℓ n₀, δ α = θ) ∧
      (∀ x : wcHM V ℓ n₀, δ (wcHMPull Dw n₀ x) = 0) :=
by
  classical
  letI instV : HasExt (SheafOfModules.{u+1} (wcRingSheaf V ℓ)) := HasExt.standard _
  letI instW : HasExt (SheafOfModules.{u+1} (wcRingSheaf Wo.toScheme ℓ)) := HasExt.standard _
  haveI := Dw.additive
  haveI := Dw.presLim
  haveI := Dw.presColim

  have hdisj : ∀ (t : ↥Wo.toScheme) (z : ↥T), Wo.ι t ≠ j z := by
    intro t z h
    have h1 : Wo.ι t ∈ (Wo : Set ↥V) := by
      rw [← Scheme.Opens.range_ι]
      exact ⟨t, rfl⟩
    rw [hW, h] at h1
    exact h1 ⟨z, rfl⟩
  have hempty : IsEmpty ↥(Limits.pullback Wo.ι j) := by
    refine ⟨fun q => hdisj ((Limits.pullback.fst Wo.ι j) q) ((Limits.pullback.snd Wo.ι j) q) ?_⟩
    have h : (Limits.pullback.fst Wo.ι j ≫ Wo.ι) q = (Limits.pullback.snd Wo.ι j ≫ j) q := by
      rw [Limits.pullback.condition]
    rwa [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h

  have hkey : Dw.μ.inv ≫ Dw.Φ.map (wcSuppUnitMap Dj) = 0 := by
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext X
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    have h7 := wc_supp_pull_unit_vanish_off j Wo.ι (Limits.pullback.fst Wo.ι j)
      (Limits.pullback.snd Wo.ι j) (IsPullback.of_hasPullback Wo.ι j) ℓ Dj Dw (Opposite.unop X)
      (fun x hx => by
        obtain ⟨q, _⟩ := hx
        exact hempty.false q)
    refine Eq.trans h7 ?_
    first
      | rfl
      | simp

  obtain ⟨ε, hε⟩ : ∃ ε : SheafOfModules.unit (wcRingSheaf Wo.toScheme ℓ) ⟶
      Dw.Φ.obj (Limits.kernel (wcSuppUnitMap Dj)),
      ε ≫ Dw.Φ.map (Limits.kernel.ι (wcSuppUnitMap Dj)) = Dw.μ.inv := by
    obtain ⟨ε0, hε0⟩ := Limits.KernelFork.IsLimit.lift'
      (Limits.KernelFork.mapIsLimit _ (Limits.kernelIsKernel (wcSuppUnitMap Dj)) Dw.Φ)
      Dw.μ.inv hkey
    exact ⟨ε0, hε0⟩
  haveI hmonoΦι : Mono (Dw.Φ.map (Limits.kernel.ι (wcSuppUnitMap Dj))) := inferInstance
  have h1 : ε ≫ (Dw.Φ.map (Limits.kernel.ι (wcSuppUnitMap Dj)) ≫ Dw.μ.hom) = 𝟙 _ := by
    rw [← Category.assoc, hε, Iso.inv_hom_id]
  have h2 : (Dw.Φ.map (Limits.kernel.ι (wcSuppUnitMap Dj)) ≫ Dw.μ.hom) ≫ ε = 𝟙 _ := by
    rw [← cancel_mono (Dw.Φ.map (Limits.kernel.ι (wcSuppUnitMap Dj)))]
    simp only [Category.assoc, hε, Iso.hom_inv_id, Category.comp_id, Category.id_comp]
  haveI hεiso : IsIso ε := ⟨⟨_, h1, h2⟩⟩
  let Vo : V.ProEt := Scheme.ProEt.mk Wo.ι
  haveI hVo : IsOpenImmersion Vo.hom := (inferInstance : IsOpenImmersion Wo.ι)
  haveI hG : (wcSliceFunctor V Vo).IsContinuous (Scheme.ProEt.topology Vo.left)
      (Scheme.ProEt.topology V) := by
    haveI h1' := (wc_slice_over_sites_cont V Vo).1
    haveI h0 : (Over.forget Vo).IsContinuous ((Scheme.ProEt.topology V).over Vo)
        (Scheme.ProEt.topology V) := inferInstance
    have h3 : (wcSliceToOver V Vo ⋙ Over.forget Vo).IsContinuous (Scheme.ProEt.topology Vo.left)
        (Scheme.ProEt.topology V) :=
      Functor.isContinuous_comp _ _ _ ((Scheme.ProEt.topology V).over Vo) _
    exact h3
  have hVorange : Set.range Vo.hom = (Set.range j)ᶜ := by
    show Set.range Wo.ι = _
    rw [Scheme.Opens.range_ι, hW]
  obtain ⟨Φiso⟩ := wc_hm_pull_Phi_slice_iso V ℓ Vo Dw hDw

  have fin_covers : ∀ (U : V.ProEt) [QuasiSeparatedSpace U.left] (n : ℕ) (W : Fin n → V.ProEt)
      (h : ∀ i, W i ⟶ U), (∀ i, IsAffine (W i).left) →
      (∀ x : U.left, ∃ i, x ∈ Set.range (h i).left) →
      Sieve.generate (Presieve.ofArrows W h) ∈ Scheme.ProEt.topology V U := by
    intro U _ n W h hA hJ
    have hs : ∀ x : U.left, ∃ j y, (h j).left y = x := by
      intro x
      obtain ⟨j, y, hy⟩ := hJ x
      exact ⟨j, y, hy⟩
    have hq : ∀ i, QuasiCompact (h i).left := fun i => by
      haveI := hA i
      exact quasiCompact_of_compactSpace _
    have hw : ∀ i, WeaklyEtale (h i).left := fun i => by
      have h1 : WeaklyEtale ((h i).left ≫ U.hom) := by
        rw [MorphismProperty.Over.w (h i)]
        exact (W i).prop
      haveI := U.prop
      exact @WeaklyEtale.of_comp _ _ _ (h i).left U.hom h1 U.prop
    have H : Presieve.ofArrows (fun i => (W i).left) (fun i => (h i).left) ∈
        Scheme.proetalePrecoverage.coverings U.left :=
      ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr (@QuasiCompactCover.of_finite _ _
        (Scheme.Cover.mkOfCovers (P := ⊤) (Fin n) (fun i => (W i).left) (fun i => (h i).left)
          hs (fun _ => trivial)) _ hq
          (inferInstanceAs (Finite (Fin n)))),
        (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr
          ⟨fun x => by obtain ⟨j, y, hy⟩ := hs x; exact ⟨j, y, hy⟩, hw⟩⟩
    exact Precoverage.generate_mem_toGrothendieck
      (Precoverage.mem_comap_iff.mpr (by rw [Presieve.map_ofArrows]; exact H))
  have affine_local : ∀ (U : V.ProEt) (T' : Sieve U),
      (∀ (V' : V.ProEt) (f : V' ⟶ U), IsAffine V'.left →
        T'.pullback f ∈ Scheme.ProEt.topology V V') →
      T' ∈ Scheme.ProEt.topology V U := by
    intro U T' hT
    have hU : WeaklyEtale U.hom := U.prop
    let W : U.left.affineCover.I₀ → V.ProEt := fun i =>
      MorphismProperty.Over.mk ⊤ (U.left.affineCover.f i ≫ U.hom) inferInstance
    let e : ∀ i, W i ⟶ U := fun i =>
      MorphismProperty.Over.homMk (U.left.affineCover.f i) rfl trivial
    have hP : Presieve.ofArrows W e ∈ (Scheme.ProEt.precoverage V).coverings U := by
      show _ ∈ (Precoverage.comap (Scheme.ProEt.forget V ⋙ Over.forget V)
        Scheme.proetalePrecoverage).coverings U
      rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
      change U.left.affineCover.presieve₀ ∈ Scheme.proetalePrecoverage.coverings U.left
      exact ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage U.left U.left.affineCover.mem₀,
        U.left.affineCover.mem₀.1,
        MorphismProperty.ofArrows_mem_precoverage.mpr (fun i => inferInstance)⟩
    refine GrothendieckTopology.transitive _ (Precoverage.generate_mem_toGrothendieck hP) T' ?_
    intro Y₀ f hf
    obtain ⟨Y', h, g', hg', rfl⟩ := hf
    rcases hg' with ⟨i⟩
    rw [Sieve.pullback_comp]
    exact GrothendieckTopology.pullback_stable _ h
      (hT (W i) (e i) (show IsAffine (U.left.affineCover.X i) by infer_instance))
  have hcov : ∀ (U : V.ProEt) (k : (Limits.kernel (wcSuppUnitMap Dj)).val.obj (Opposite.op U))
      (R : Sieve U), (∀ (U' : V.ProEt) (a : U' ⟶ U),
        ((∀ x : ↥U'.left, U'.hom x ∉ Set.range j) ∨
          ((Limits.kernel (wcSuppUnitMap Dj)).val.map a.op).hom k = 0) → R.arrows a) →
      R ∈ Scheme.ProEt.topology V U := by
    intro U k R hR
    apply affine_local U R
    intro W' g hW'
    obtain ⟨n, W'', e, haff, hsurj, hdis⟩ := hker U k W' g hW'
    haveI : IsAffine W'.left := hW'
    refine GrothendieckTopology.superset_covering _ ?_ (fin_covers W' n W'' e haff hsurj)
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨m⟩
    exact hR _ _ (hdis m)

  have hhom : ∀ N : SheafOfModules.{u+1} (wcRingSheaf V ℓ),
      Function.Bijective (fun φ : Limits.kernel (wcSuppUnitMap Dj) ⟶ N => ε ≫ Dw.Φ.map φ) := by
    intro N
    obtain ⟨hinj, hsurj⟩ := wc_supp_kernel_open_res_bijective j Dj Vo hVorange hcov N
    have e : ∀ φ : Limits.kernel (wcSuppUnitMap Dj) ⟶ N, (wcSliceRes V ℓ Vo).map φ =
        Φiso.inv.app _ ≫ Dw.Φ.map φ ≫ Φiso.hom.app N :=
      fun φ => (NatIso.naturality_1 Φiso φ).symm
    refine ⟨fun φ₁ φ₂ h => hinj ?_, fun g => ?_⟩
    · have h' : Dw.Φ.map φ₁ = Dw.Φ.map φ₂ := (cancel_epi ε).mp h
      show (wcSliceRes V ℓ Vo).map φ₁ = (wcSliceRes V ℓ Vo).map φ₂
      rw [e, e, h']
    · obtain ⟨φ, hφ⟩ := hsurj (Φiso.inv.app _ ≫
        ((Dw.Φ.map (Limits.kernel.ι (wcSuppUnitMap Dj)) ≫ Dw.μ.hom) ≫ g) ≫ Φiso.hom.app N)
      refine ⟨φ, ?_⟩
      have hφ' : (wcSliceRes V ℓ Vo).map φ = Φiso.inv.app _ ≫
          ((Dw.Φ.map (Limits.kernel.ι (wcSuppUnitMap Dj)) ≫ Dw.μ.hom) ≫ g) ≫
            Φiso.hom.app N := hφ
      have k0 := (e φ).symm.trans hφ'
      have k : Dw.Φ.map φ =
          (Dw.Φ.map (Limits.kernel.ι (wcSuppUnitMap Dj)) ≫ Dw.μ.hom) ≫ g :=
        (cancel_mono (Φiso.hom.app N)).mp ((cancel_epi (Φiso.inv.app _)).mp k0)
      show ε ≫ Dw.Φ.map φ = g
      rw [k, ← Category.assoc, h1, Category.id_comp]
  have hvan : ∀ (I : SheafOfModules.{u+1} (wcRingSheaf V ℓ)) [Injective I] (k : ℕ)
      (e : Abelian.Ext (SheafOfModules.unit (wcRingSheaf Wo.toScheme ℓ)) (Dw.Φ.obj I) (k + 1)),
      e = 0 := by
    intro I hI k e
    have hRI : Injective ((wcSliceRes V ℓ Vo).obj I) :=
      @wc_open_slice_res_preserves_injective V ℓ _ Vo hVo hG I hI
    haveI : Injective (Dw.Φ.obj I) := Injective.of_iso (Φiso.app I).symm hRI
    exact Abelian.Ext.eq_zero_of_injective e
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf V ℓ)) :=
    sheafOfModules_enoughInjectives (Scheme.ProEt.topology V) (wcRingSheaf V ℓ)
  have hT := ext_transfer_of_corep Dw.Φ (Limits.kernel (wcSuppUnitMap Dj))
    (SheafOfModules.unit (wcRingSheaf Wo.toScheme ℓ)) ε hhom hvan
    (SheafOfModules.unit (wcRingSheaf V ℓ)) n₀
  have hP : Function.Bijective
      (fun x : Abelian.Ext (SheafOfModules.unit (wcRingSheaf Wo.toScheme ℓ))
          (Dw.Φ.obj (SheafOfModules.unit (wcRingSheaf V ℓ))) n₀ =>
        x.comp (Abelian.Ext.mk₀ Dw.μ.hom) (add_zero n₀)) := by
    refine ⟨fun x y h => ?_, fun y => ⟨y.comp (Abelian.Ext.mk₀ Dw.μ.inv) (add_zero n₀), ?_⟩⟩
    · have h' := congrArg (fun z => z.comp (Abelian.Ext.mk₀ Dw.μ.inv) (add_zero n₀)) h
      simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
        Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id] at h'
      exact h'
    · simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
        Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]

  have h10 : 1 + n₀ = n₁ := by omega
  have hS : (ShortComplex.mk (Limits.kernel.ι (wcSuppUnitMap Dj)) (wcSuppUnitMap Dj)
      (Limits.kernel.condition (wcSuppUnitMap Dj))).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel (wcSuppUnitMap Dj)) inferInstance hepi
  let Ψh : Abelian.Ext (Limits.kernel (wcSuppUnitMap Dj)) (SheafOfModules.unit (wcRingSheaf V ℓ)) n₀ →+
      wcHM Wo.toScheme ℓ n₀ :=
    ((Abelian.Ext.mk₀ ε).precomp _ (zero_add n₀)).comp
      (((Abelian.Ext.mk₀ Dw.μ.hom).postcomp _ (add_zero n₀)).comp (Dw.Φ.mapExtAddHom _ _ n₀))
  have hΨb : Function.Bijective Ψh := by
    show Function.Bijective _
    convert hP.comp hT using 1
    funext x
    exact (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).symm
  let Ψe := AddEquiv.ofBijective Ψh hΨb
  have hfree : ∀ x : wcHM V ℓ n₀,
      Ψe ((Abelian.Ext.mk₀ (Limits.kernel.ι (wcSuppUnitMap Dj))).comp x (zero_add n₀)) =
        wcHMPull Dw n₀ x := by
    intro x
    show (Abelian.Ext.mk₀ ε).comp ((Abelian.Ext.mapExactFunctor Dw.Φ
        ((Abelian.Ext.mk₀ (Limits.kernel.ι (wcSuppUnitMap Dj))).comp x (zero_add n₀))).comp
        (Abelian.Ext.mk₀ Dw.μ.hom) (add_zero n₀)) (zero_add n₀) =
      (Abelian.Ext.mk₀ Dw.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dw.Φ x).comp
        (Abelian.Ext.mk₀ Dw.μ.hom) (add_zero n₀)) (zero_add n₀)
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero, ← hε, ← Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.comp_assoc_of_second_deg_zero]
  let δ : wcHM Wo.toScheme ℓ n₀ →+ wcSuppExt Dj n₁ :=
    (hS.extClass.precomp (SheafOfModules.unit (wcRingSheaf V ℓ)) h10).comp
      Ψe.symm.toAddMonoidHom
  refine ⟨δ, ?_, ?_⟩
  · intro θ hθ
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS
      (SheafOfModules.unit (wcRingSheaf V ℓ)) θ hθ h10
    refine ⟨Ψe x₁, ?_⟩
    show hS.extClass.comp (Ψe.symm (Ψe x₁)) h10 = θ
    rw [AddEquiv.symm_apply_apply]
    exact hx₁
  · intro x
    have hc : hS.extClass.comp (Abelian.Ext.mk₀ (Limits.kernel.ι (wcSuppUnitMap Dj)))
        (add_zero 1) = 0 := hS.extClass_comp
    show hS.extClass.comp (Ψe.symm (wcHMPull Dw n₀ x)) h10 = 0
    rw [← hfree x, AddEquiv.symm_apply_apply, ← Abelian.Ext.comp_assoc_of_second_deg_zero, hc,
      Abelian.Ext.zero_comp]

theorem wc_wstrictly_local_affine_et_vanish (K : Type u) [Field K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hℓK : (ℓ : K) ≠ 0) {T : Scheme.{u}} (qT : T ⟶ Spec (.of K))
    (hT : IsAffine T ∧ IsClosed {x : T | IsClosed ({x} : Set T)} ∧
      (∀ x : T, ∃! y : T, IsClosed ({y} : Set T) ∧ x ⤳ y) ∧
      ExtremallyDisconnected {x : T | IsClosed ({x} : Set T)} ∧
      (∀ x : T, IsClosed ({x} : Set T) →
        HenselianLocalRing (T.presheaf.stalk x) ∧ IsSepClosed (T.residueField x)))
    (j : ℕ) : Subsingleton (wcEtCoh T ℓ (j + 1)) :=
by
  classical
  haveI hTA : IsAffine T := hT.1
  letI : Algebra K Γ(T, ⊤) :=
    ((Scheme.ΓSpecIso (.of K)).inv ≫ qT.appTop).hom.toAlgebra
  obtain ⟨hcl, huniq, -⟩ := wc_wl_conditions_homeomorph T (Spec Γ(T, ⊤))
    (Scheme.Hom.homeomorph T.isoSpec.hom) hT.2.1 hT.2.2.1 hT.2.2.2.1
  have hsh := wc_affine_closedPt_strictHensel T hT.2.2.2.2
  have hBv := wc_idem_adjoin_vnr K Γ(T, ⊤)
  have htr : ∀ {S T : Type u} [CommRing S] [CommRing T] (ε : S ≃+* T),
      (∀ f : T, ∃ t : T, f * f * t = f) → ∀ f : S, ∃ t : S, f * f * t = f := by
    intro S T _ _ ε hT f
    obtain ⟨t₀, ht₀⟩ := hT (ε f)
    refine ⟨ε.symm t₀, ε.injective ?_⟩
    rw [map_mul, map_mul, RingEquiv.apply_symm_apply]
    exact ht₀
  have hP : ∀ f : Γ(Spec (.of (Algebra.adjoin K {e : Γ(T, ⊤) | IsIdempotentElem e})), ⊤),
      ∃ t : Γ(Spec (.of (Algebra.adjoin K {e : Γ(T, ⊤) | IsIdempotentElem e})), ⊤),
        f * f * t = f :=
    htr (Scheme.ΓSpecIso
      (.of (Algebra.adjoin K {e : Γ(T, ⊤) | IsIdempotentElem e}))).commRingCatIsoToRingEquiv hBv
  have hfib : ∀ p₀ : Spec (.of (Algebra.adjoin K {e : Γ(T, ⊤) | IsIdempotentElem e})),
      Subsingleton (wcEtCoh (Limits.pullback
        (T.toSpecΓ ≫ Spec.map (CommRingCat.ofHom
            (algebraMap (Algebra.adjoin K {e : Γ(T, ⊤) | IsIdempotentElem e}) Γ(T, ⊤))))
        ((Spec (.of (Algebra.adjoin K {e : Γ(T, ⊤) | IsIdempotentElem e}))).fromSpecResidueField
          p₀)) ℓ (j + 1)) := by
    intro p₀
    obtain ⟨e⟩ := wc_affine_vnr_spec_fibre_iso T
      (Algebra.adjoin K {e : Γ(T, ⊤) | IsIdempotentElem e})
      (algebraMap (Algebra.adjoin K {e : Γ(T, ⊤) | IsIdempotentElem e}) Γ(T, ⊤)) hBv p₀
    obtain ⟨hH, hS⟩ := wc_wl_idem_fibre_strictHensel K Γ(T, ⊤) hBv hcl huniq hsh
      p₀.asIdeal p₀.isPrime
    have hR := @wc_et_strictly_local_ext_vanishing _ _ hH hS
      ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of (Γ(T, ⊤) ⧸ Ideal.map
        (algebraMap (Algebra.adjoin K {e : Γ(T, ⊤) | IsIdempotentElem e}) Γ(T, ⊤))
        p₀.asIdeal)))) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) j
    have hR' : Subsingleton (wcEtCoh (Spec (.of (Γ(T, ⊤) ⧸ Ideal.map
        (algebraMap (Algebra.adjoin K {e : Γ(T, ⊤) | IsIdempotentElem e}) Γ(T, ⊤))
        p₀.asIdeal))) ℓ (j + 1)) := by
      exact hR
    obtain ⟨E⟩ := wc_et_coh_iso_invariance e.hom ℓ (j + 1)
    exact E.symm.subsingleton
  exact wc_et_coh_vanish_of_vnr_fibres _ _ _ hP ℓ (j + 1) (Nat.succ_pos j) hfib

theorem wc_smooth_pair_wcontr_compl_et_low_vanish (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (V : Y.ProEt)
    (hV : IsAffine V.left ∧ IsClosed {x : V.left | IsClosed ({x} : Set V.left)} ∧
      (∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y) ∧
      ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)} ∧
      (∀ x : V.left, IsClosed ({x} : Set V.left) →
        HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x)))
    (O : V.left.Opens) (hO : (O : Set ↥V.left) = (Set.range (Limits.pullback.fst V.hom i))ᶜ)
    (k : ℕ) (hk1 : 1 ≤ k) (hk2 : k + 2 ≤ 2 * r) :
    Subsingleton (wcEtCoh O.toScheme ℓ k) :=
by
  classical
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY
  have hrc : IsClosed (Set.range i) := i.isClosedEmbedding.isClosed_range
  obtain ⟨U, hU⟩ : ∃ U : Y.Opens, (U : Set Y) = (Set.range i)ᶜ := ⟨⟨_, hrc.isOpen_compl⟩, rfl⟩
  have hℓ0 : ℓ ≠ 0 := (Fact.out : Nat.Prime ℓ).ne_zero

  have L1 : ∀ (W : Scheme.{u}) (v : W ⟶ Y), Etale v → ∀ (YV : Scheme.{u}) (gV : YV ⟶ W)
      (w : YV ⟶ (U : Scheme.{u})), IsPullback w gV U.ι v → ∀ (α : wcEtZModExt YV ℓ k) (x : W),
      ∃ (W' : Scheme.{u}) (v' : W' ⟶ W), Etale v' ∧ x ∈ Set.range v' ∧
        ∀ (YV' : Scheme.{u}) (gV' : YV' ⟶ W') (w' : YV' ⟶ YV), IsPullback w' gV' gV v' →
          ∀ (Dw' : wcEtPullData w' ℓ), wcEtPull Dw' k α = 0 := by
    intro W v hv YV gV w hpb α x
    haveI : Etale v := hv
    haveI hgVo : IsOpenImmersion gV :=
      MorphismProperty.of_isPullback (P := @IsOpenImmersion) hpb inferInstance
    have hptw : ∀ {P A B S : Scheme.{u}} {fst : P ⟶ A} {snd : P ⟶ B} {f : A ⟶ S} {g : B ⟶ S},
        fst ≫ f = snd ≫ g → ∀ t : P, f (fst t) = g (snd t) := by
      intro P A B S fst snd f g h t
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, h]
    have hpts : ∀ {P A B S : Scheme.{u}} {fst : P ⟶ A} {snd : P ⟶ B} {f : A ⟶ S} {g : B ⟶ S},
        IsPullback fst snd f g → ∀ (a : A) (b : B), f a = g b → ∃ t : P, fst t = a ∧ snd t = b := by
      intro P A B S fst snd f g h a b hab
      obtain ⟨t, h1, h2⟩ := Scheme.Pullback.exists_preimage_pullback a b hab
      refine ⟨h.isoPullback.inv t, ?_, ?_⟩
      · rw [← Scheme.Hom.comp_apply, h.isoPullback_inv_fst]; exact h1
      · rw [← Scheme.Hom.comp_apply, h.isoPullback_inv_snd]; exact h2
    by_cases hx : v x ∈ Set.range i
    · obtain ⟨z0, hz0⟩ := hx
      obtain ⟨hlt, -⟩ := wc_smooth_closed_reldim_cases K Y pY n m Z i
      rcases lt_trichotomy m n with hen | hen | hen
      ·
        obtain ⟨c, hc⟩ : ∃ c, c = n - m := ⟨_, rfl⟩
        have hcn : c ≤ n := by omega
        have hnce : n - c = m := by omega
        have hkc : k + 1 < 2 * c := by omega
        obtain ⟨ZW, gZ, iW, hZpb⟩ : ∃ (ZW : Scheme.{u}) (gZ : ZW ⟶ Z) (iW : ZW ⟶ W),
            IsPullback gZ iW i v := ⟨_, _, _, IsPullback.of_hasPullback i v⟩
        haveI : IsClosedImmersion iW :=
          MorphismProperty.of_isPullback (P := @IsClosedImmersion) hZpb inferInstance
        haveI : Etale gZ := MorphismProperty.of_isPullback (P := @Etale) hZpb.flip inferInstance
        haveI hsmW : SmoothOfRelativeDimension n (v ≫ pY) := by
          have h : SmoothOfRelativeDimension (0 + n) (v ≫ pY) := inferInstance
          rwa [Nat.zero_add] at h
        haveI hsmZ : SmoothOfRelativeDimension (n - c) (iW ≫ v ≫ pY) := by
          have h : SmoothOfRelativeDimension (0 + m) (gZ ≫ i ≫ pY) := inferInstance
          rw [Nat.zero_add, ← Category.assoc, hZpb.w, Category.assoc] at h
          rw [hnce]; exact h
        have hrange : Set.range gV = (Set.range iW)ᶜ := by
          ext y
          constructor
          · rintro ⟨t, rfl⟩ ⟨s, hs⟩
            have h1 : U.ι (w t) ∈ (U : Set Y) := by
              rw [← Scheme.Opens.range_ι]; exact ⟨_, rfl⟩
            rw [hU] at h1
            apply h1
            refine ⟨gZ s, ?_⟩
            rw [hptw hZpb.w s, hs, ← hptw hpb.w t]
          · intro hy
            have hvy : v y ∈ (U : Set Y) := by
              rw [hU]
              rintro ⟨z, hz⟩
              obtain ⟨s, -, hs⟩ := hpts hZpb z y hz
              exact hy ⟨s, hs⟩
            rw [← Scheme.Opens.range_ι] at hvy
            obtain ⟨a, ha⟩ := hvy
            obtain ⟨t, -, ht⟩ := hpts hpb a y ha
            exact ⟨t, ht⟩
        obtain ⟨D⟩ := wc_et_zmod_pull_data_exists iW ℓ
        obtain ⟨θ, hθ⟩ := wc_et_punct_supp_boundary_lift iW gV hrange ℓ D k α
        have hkill : ∀ (Z' : Scheme.{u}) (iW' : Z' ⟶ W) (g : Z' ⟶ ZW),
            IsPullback g iW' iW (𝟙 W) → ∀ (D' : wcEtPullData iW' ℓ) (Ef : wcEtPullData (𝟙 W) ℓ)
            (γ : wcEtSuppObj D' ⟶ Ef.Φ.obj (wcEtSuppObj D)),
            wcEtSuppUnitMap D' ≫ γ = Ef.μ.inv ≫ Ef.Φ.map (wcEtSuppUnitMap D) →
            wcEtSuppRestr D Ef D' γ (k + 1) θ = 0 := by
          intro Z' iW' g hp D' Ef γ _
          haveI : IsClosedImmersion iW' :=
            MorphismProperty.of_isPullback (P := @IsClosedImmersion) hp inferInstance
          haveI : Etale g := MorphismProperty.of_isPullback (P := @Etale) hp.flip inferInstance
          have hiW' : iW' = g ≫ iW := (Category.comp_id iW').symm.trans hp.w.symm
          haveI : SmoothOfRelativeDimension (n - c) (iW' ≫ v ≫ pY) := by
            have h : SmoothOfRelativeDimension (0 + (n - c)) (g ≫ iW ≫ v ≫ pY) := inferInstance
            rw [Nat.zero_add] at h
            rw [hiW', Category.assoc]; exact h
          exact wc_et_supp_semipurity K W Z' (v ≫ pY) n c iW' hcn ℓ hℓ D' (k + 1) hkc _
        obtain ⟨β, hβ⟩ := hθ W (𝟙 W) inferInstance hkill (Limits.pullback gV (𝟙 W))
          (Limits.pullback.snd gV (𝟙 W)) (Limits.pullback.fst gV (𝟙 W))
          (IsPullback.of_hasPullback gV (𝟙 W))
        obtain ⟨S'', s'', hs'', hxs'', hdie⟩ := wc_et_zmodext_pos_locally_zero W ℓ hℓ0 k hk1 β x
        haveI : Etale s'' := hs''
        refine ⟨S'', s'' ≫ 𝟙 W, inferInstance, ?_, ?_⟩
        · obtain ⟨y, hy⟩ := hxs''
          exact ⟨y, by rw [Category.comp_id]; exact hy⟩
        · intro YV' gV' w' hpb' Dw'
          have hu : w' ≫ gV = (gV' ≫ s'') ≫ 𝟙 W := by rw [hpb'.w, Category.assoc]
          obtain ⟨Dfst⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.fst gV (𝟙 W)) ℓ
          obtain ⟨Dsnd⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.snd gV (𝟙 W)) ℓ
          obtain ⟨Du⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.lift w' (gV' ≫ s'') hu) ℓ
          obtain ⟨Dg⟩ := wc_et_zmod_pull_data_exists gV' ℓ
          obtain ⟨Ds⟩ := wc_et_zmod_pull_data_exists s'' ℓ
          obtain ⟨Dgs⟩ := wc_et_zmod_pull_data_exists (gV' ≫ s'') ℓ
          rw [wc_et_pull_comp (Limits.pullback.fst gV (𝟙 W)) (Limits.pullback.lift w' (gV' ≫ s'') hu) w'
              (Limits.pullback.lift_fst _ _ _) Dfst Du Dw' k α,
            hβ Dfst Dsnd,
            ← wc_et_pull_comp (Limits.pullback.snd gV (𝟙 W)) (Limits.pullback.lift w' (gV' ≫ s'') hu)
              (gV' ≫ s'') (Limits.pullback.lift_snd _ _ _) Dsnd Du Dgs k β,
            wc_et_pull_comp s'' gV' (gV' ≫ s'') rfl Ds Dg Dgs k β, hdie Ds, map_zero]
      · exfalso; omega
      · exact ((hlt hen).false z0).elim
    ·
      have hxV : v x ∈ (U : Set Y) := by rw [hU]; exact hx
      let Ow : W.Opens := v ⁻¹ᵁ U
      have hxO : x ∈ Ow := hxV
      let ρ : (Ow : Scheme.{u}) ⟶ YV := hpb.lift (v ∣_ U) Ow.ι (morphismRestrict_ι v U)
      have hρ : ρ ≫ gV = Ow.ι := hpb.lift_snd _ _ _
      obtain ⟨Dρ⟩ := wc_et_zmod_pull_data_exists ρ ℓ
      obtain ⟨S', s', hs', hxs', hdie⟩ :=
        wc_et_zmodext_pos_locally_zero (Ow : Scheme.{u}) ℓ hℓ0 k hk1 (wcEtPull Dρ k α) ⟨x, hxO⟩
      haveI : Etale s' := hs'
      refine ⟨S', s' ≫ Ow.ι, inferInstance, ?_, ?_⟩
      · obtain ⟨y, hy⟩ := hxs'
        exact ⟨y, by rw [Scheme.Hom.comp_apply, hy]; rfl⟩
      · intro YV' gV' w' hpb' Dw'
        have hw' : gV' ≫ s' ≫ ρ = w' := by
          rw [← cancel_mono gV, hpb'.w]
          simp only [Category.assoc, hρ]
        obtain ⟨Ds'⟩ := wc_et_zmod_pull_data_exists s' ℓ
        obtain ⟨Dg⟩ := wc_et_zmod_pull_data_exists gV' ℓ
        obtain ⟨Dsρ⟩ := wc_et_zmod_pull_data_exists (s' ≫ ρ) ℓ
        rw [wc_et_pull_comp (s' ≫ ρ) gV' w' hw' Dsρ Dg Dw' k α,
          wc_et_pull_comp ρ s' (s' ≫ ρ) rfl Dρ Ds' Dsρ k α, hdie Ds', map_zero]

  have L2 : ∀ (R : CommRingCat.{u}) [HenselianLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)]
      (c : Spec R ⟶ Y) (hc : WeaklyEtale c) {Pq : Scheme.{u}} (q : Pq ⟶ (U : Scheme.{u}))
      (t : Pq ⟶ Spec R) (hP : IsPullback q t U.ι c), Subsingleton (wcEtCoh Pq ℓ k) := by
    intro R _ _ c hc Pq q t hP
    obtain ⟨Λ, _, _, D₀, φ, hAff, hφc, hφa, hlim⟩ :=
      wc_weaklyEtale_strictHensel_prosystem (R : Type u) c hc
    obtain ⟨π, hπ1, hπ2, hπ3, hπ4⟩ :=
      wc_et_baseChange_limit_cone U.ι (R : Type u) Λ D₀ φ c hφc hφa hlim Pq q t hP
    haveI : QuasiCompact U.ι := inferInstance
    have hfstQC : ∀ l, QuasiCompact (Limits.pullback.fst (D₀.obj l).hom U.ι) := fun l =>
      MorphismProperty.of_isPullback (P := @QuasiCompact)
        (IsPullback.of_hasPullback (D₀.obj l).hom U.ι).flip inferInstance
    have hfstQS : ∀ l, QuasiSeparated (Limits.pullback.fst (D₀.obj l).hom U.ι) := fun l =>
      MorphismProperty.of_isPullback (P := @QuasiSeparated)
        (IsPullback.of_hasPullback (D₀.obj l).hom U.ι).flip inferInstance
    have hLc : ∀ l, CompactSpace ((D₀ ⋙ wcEtBaseChange U.ι).obj l).left := fun l => by
      haveI : IsAffine ((𝟭 Scheme.{u}).obj (D₀.obj l).left) := hAff l
      haveI : IsAffine (D₀.obj l).left := hAff l
      exact @QuasiCompact.compactSpace_of_compactSpace _ _
        (Limits.pullback.fst (D₀.obj l).hom U.ι) (hfstQC l) inferInstance
    have hLq : ∀ l, QuasiSeparatedSpace ((D₀ ⋙ wcEtBaseChange U.ι).obj l).left := fun l => by
      haveI : IsAffine ((𝟭 Scheme.{u}).obj (D₀.obj l).left) := hAff l
      haveI : IsAffine (D₀.obj l).left := hAff l
      exact @quasiSeparatedSpace_of_quasiSeparated _ _
        (Limits.pullback.fst (D₀.obj l).hom U.ι) inferInstance (hfstQS l)
    have M1 : ∀ {l l' : Λ} (t' : l ⟶ l'),
        ((D₀ ⋙ wcEtBaseChange U.ι).map t').left ≫ Limits.pullback.fst (D₀.obj l').hom U.ι =
          Limits.pullback.fst (D₀.obj l).hom U.ι ≫ (D₀.map t').left := by
      intro l l' t'
      exact Limits.pullback.lift_fst _ _ _
    have M2 : ∀ {l l' : Λ} (t' : l ⟶ l'),
        ((D₀ ⋙ wcEtBaseChange U.ι).map t').left ≫ Limits.pullback.snd (D₀.obj l').hom U.ι =
          Limits.pullback.snd (D₀.obj l).hom U.ι := by
      intro l l' t'
      exact Limits.pullback.lift_snd _ _ _
    have C6 : ∀ {l l' : Λ} (t' : l ⟶ l'), IsAffineHom ((D₀ ⋙ wcEtBaseChange U.ι).map t').left := by
      intro l l' t'
      have := hAff l
      have := hAff l'
      have Rr : IsPullback (Limits.pullback.snd (D₀.obj l').hom U.ι)
          (Limits.pullback.fst (D₀.obj l').hom U.ι) U.ι (D₀.obj l').hom :=
        (IsPullback.of_hasPullback (D₀.obj l').hom U.ι).flip
      have Osq : IsPullback (((D₀ ⋙ wcEtBaseChange U.ι).map t').left ≫
          Limits.pullback.snd (D₀.obj l').hom U.ι) (Limits.pullback.fst (D₀.obj l).hom U.ι) U.ι
          ((D₀.map t').left ≫ (D₀.obj l').hom) := by
        rw [M2 t', MorphismProperty.Over.w (D₀.map t')]
        exact (IsPullback.of_hasPullback (D₀.obj l).hom U.ι).flip
      have L : IsPullback ((D₀ ⋙ wcEtBaseChange U.ι).map t').left
          (Limits.pullback.fst (D₀.obj l).hom U.ι) (Limits.pullback.fst (D₀.obj l').hom U.ι)
          (D₀.map t').left :=
        IsPullback.of_right Osq (M1 t') Rr
      exact MorphismProperty.of_isPullback (P := @IsAffineHom) L.flip
        (isAffineHom_of_isAffine (D₀.map t').left)
    haveI : QuasiCompact t := MorphismProperty.of_isPullback (P := @QuasiCompact) hP inferInstance
    haveI : QuasiSeparated t :=
      MorphismProperty.of_isPullback (P := @QuasiSeparated) hP inferInstance
    have hPc : CompactSpace Pq := QuasiCompact.compactSpace_of_compactSpace t
    have hPs : QuasiSeparatedSpace Pq := quasiSeparatedSpace_of_quasiSeparated t
    have g4 : ∀ y : wcEtZModExt Pq ℓ k, y = 0 := by
      intro y
      obtain ⟨l, x, hx⟩ := wc_et_limit_pull_surj_qcqs_all q Λ (D₀ ⋙ wcEtBaseChange U.ι) π hπ1 hπ3
        hπ4 hLc hLq C6 hPc hPs ℓ k y
      have hsq : IsPullback (Limits.pullback.snd (D₀.obj l).hom U.ι)
          (Limits.pullback.fst (D₀.obj l).hom U.ι) U.ι (D₀.obj l).hom :=
        (IsPullback.of_hasPullback (D₀.obj l).hom U.ι).flip
      obtain ⟨W', v', hv', ⟨w₀, hw₀⟩, kill⟩ := L1 (D₀.obj l).left (D₀.obj l).hom (D₀.obj l).prop
        (Limits.pullback (D₀.obj l).hom U.ι) (Limits.pullback.fst (D₀.obj l).hom U.ι)
        (Limits.pullback.snd (D₀.obj l).hom U.ι) hsq x (φ l (IsLocalRing.closedPoint (R : Type u)))
      haveI := hv'
      obtain ⟨σ, hσ⟩ := wc_strictHensel_etale_point_lift (R : Type u) (φ l) v' w₀ hw₀
      have h₀ : π l ≫ Limits.pullback.fst (D₀.obj l).hom U.ι = (t ≫ σ) ≫ v' := by
        rw [hπ2 l, Category.assoc, hσ]
      let ρ : Pq ⟶ Limits.pullback (Limits.pullback.fst (D₀.obj l).hom U.ι) v' :=
        Limits.pullback.lift (f := Limits.pullback.fst (D₀.obj l).hom U.ι) (g := v') (π l)
          (t ≫ σ) h₀
      have hρ : ρ ≫ Limits.pullback.fst (Limits.pullback.fst (D₀.obj l).hom U.ι) v' = π l :=
        Limits.pullback.lift_fst _ _ _
      have hsq' := IsPullback.of_hasPullback (Limits.pullback.fst (D₀.obj l).hom U.ι) v'
      obtain ⟨Dw'⟩ := wc_et_zmod_pull_data_exists
        (Limits.pullback.fst (Limits.pullback.fst (D₀.obj l).hom U.ι) v') ℓ
      obtain ⟨Dρ⟩ := wc_et_zmod_pull_data_exists ρ ℓ
      obtain ⟨E⟩ := wc_et_zmod_pull_data_exists (π l) ℓ
      rw [← hx E, wc_et_pull_comp _ ρ (π l) hρ Dw' Dρ E k x]
      exact (congrArg (wcEtPull Dρ k) (kill _ _ _ hsq' Dw')).trans (map_zero _)
    haveI : Subsingleton (wcEtZModExt Pq ℓ k) := ⟨fun a b => (g4 a).trans (g4 b).symm⟩
    obtain ⟨E⟩ := wc_et_zmodext_coh_equiv Pq ℓ k
    exact E.symm.subsingleton

  have key3 : Subsingleton (wcEtCoh (Limits.pullback V.hom U.ι) ℓ k) := by
    haveI : IsAffine V.left := hV.1
    haveI : IsAffine ((𝟭 Scheme.{u}).obj V.left) := hV.1
    haveI : QuasiCompact U.ι := inferInstance
    haveI hQC : QuasiCompact (Limits.pullback.fst V.hom U.ι) := inferInstance
    haveI hQS : QuasiSeparated (Limits.pullback.fst V.hom U.ι) := inferInstance
    haveI hP0c : CompactSpace (Limits.pullback V.hom U.ι : Scheme.{u}) :=
      QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.fst V.hom U.ι)
    haveI hP0q : QuasiSeparatedSpace (Limits.pullback V.hom U.ι : Scheme.{u}) :=
      quasiSeparatedSpace_of_quasiSeparated (Limits.pullback.fst V.hom U.ι)
    obtain ⟨Θ, hΘ, -⟩ := wc_zmod_et_proet_natural_comparison_all ℓ k
    have hstalk : ∀ z : V.left, IsClosed ({z} : Set V.left) →
        Subsingleton (wcZModProEtExt (Limits.pullback (V.left.fromSpecStalk z)
          (Limits.pullback.fst V.hom U.ι)) ℓ k) := by
      intro z hz
      haveI : HenselianLocalRing (V.left.presheaf.stalk z) := (hV.2.2.2.2 z hz).1
      haveI : IsSepClosed (IsLocalRing.ResidueField (V.left.presheaf.stalk z)) :=
        (hV.2.2.2.2 z hz).2
      have hP : IsPullback
