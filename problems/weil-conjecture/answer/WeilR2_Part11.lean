      have h1 : wcHMPull DfO n₀ α = wcHMPull DfO n₀ (Ψe (Ψe.symm α)) := by
        rw [AddEquiv.apply_symm_apply]
      rw [h1]
      exact hC7.symm
    calc δ' (wcHMPull DfO n₀ α)
        = hS'.extClass.comp ((Abelian.Ext.mk₀ τ₁).comp
            ((Abelian.Ext.mapExactFunctor Df.Φ (Ψe.symm α)).comp (Abelian.Ext.mk₀ Df.μ.hom)
              (add_zero n₀)) (zero_add n₀)) h10 :=
          congrArg (fun z => hS'.extClass.comp z h10) hx'
      _ = (hS'.extClass.comp (Abelian.Ext.mk₀ τ₁) (add_zero 1)).comp
            ((Abelian.Ext.mapExactFunctor Df.Φ (Ψe.symm α)).comp (Abelian.Ext.mk₀ Df.μ.hom)
              (add_zero n₀)) h10 :=
          (Abelian.Ext.comp_assoc_of_second_deg_zero _ _ _ _).symm
      _ = ((Abelian.Ext.mk₀ γ).comp hSΦ.extClass (zero_add 1)).comp
            ((Abelian.Ext.mapExactFunctor Df.Φ (Ψe.symm α)).comp (Abelian.Ext.mk₀ Df.μ.hom)
              (add_zero n₀)) h10 :=
          congrArg (fun z => Abelian.Ext.comp z
            ((Abelian.Ext.mapExactFunctor Df.Φ (Ψe.symm α)).comp (Abelian.Ext.mk₀ Df.μ.hom)
              (add_zero n₀)) h10) hnatE
      _ = (Abelian.Ext.mk₀ γ).comp (hSΦ.extClass.comp
            ((Abelian.Ext.mapExactFunctor Df.Φ (Ψe.symm α)).comp (Abelian.Ext.mk₀ Df.μ.hom)
              (add_zero n₀)) h10) (zero_add n₁) :=
          Abelian.Ext.comp_assoc _ _ _ (zero_add 1) h10 (by omega)
      _ = (Abelian.Ext.mk₀ γ).comp ((hSΦ.extClass.comp
            (Abelian.Ext.mapExactFunctor Df.Φ (Ψe.symm α)) h10).comp (Abelian.Ext.mk₀ Df.μ.hom)
              (add_zero n₁)) (zero_add n₁) :=
          congrArg (fun z => (Abelian.Ext.mk₀ γ).comp z (zero_add n₁))
            (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).symm
      _ = (Abelian.Ext.mk₀ γ).comp ((Abelian.Ext.mapExactFunctor Df.Φ
            (hS.extClass.comp (Ψe.symm α) h10)).comp (Abelian.Ext.mk₀ Df.μ.hom)
              (add_zero n₁)) (zero_add n₁) := by
          rw [Abelian.Ext.mapExactFunctor_comp, hmapE]
      _ = (Abelian.Ext.mk₀ γ).comp (wcSuppPullExt D Df n₁ (δ α)) (zero_add _) := rfl

theorem wc_A1_proj_supp_unit_iso {N : Scheme.{u}} (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Dp : wcHMPullData (AffineSpace (ULift.{u} (Fin 1)) N ↘ N) ℓ) (hDp : wcHMPullCanonical Dp) :
    IsIso (wcSuppUnitMap Dp) :=
by
  classical

  have s1 : ∀ {M M' : SheafOfModules.{u+1} (wcRingSheaf N ℓ)} (φ : M ⟶ M'),
      (∀ X, Function.Bijective (φ.val.app X).hom) → IsIso φ := by
    intro M M' φ h
    have h2 : ∀ X, IsIso (((PresheafOfModules.toPresheaf (wcRingSheaf N ℓ).val).map
        ((SheafOfModules.forget (wcRingSheaf N ℓ)).map φ)).app X) := by
      intro X
      rw [ConcreteCategory.isIso_iff_bijective]
      exact h X
    have : IsIso ((PresheafOfModules.toPresheaf (wcRingSheaf N ℓ).val).map
        ((SheafOfModules.forget (wcRingSheaf N ℓ)).map φ)) := NatIso.isIso_of_isIso_app _
    have : IsIso ((SheafOfModules.forget (wcRingSheaf N ℓ)).map φ) :=
      isIso_of_reflects_iso _ (PresheafOfModules.toPresheaf (wcRingSheaf N ℓ).val)
    exact isIso_of_reflects_iso φ (SheafOfModules.forget (wcRingSheaf N ℓ))

  have hfib : ∀ {V : Scheme.{u}} (g : V ⟶ N) (v : V),
      _root_.IsPreconnected
        ((Limits.pullback.fst g (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)).base.hom ⁻¹' {v}) := by
    intro V g v
    let ι := V.fromSpecResidueField v
    let f₀ := ι ≫ g
    let π := AffineSpace (ULift.{u} (Fin 1)) (Spec (V.residueField v)) ↘ Spec (V.residueField v)
    let m := AffineSpace.map (ULift.{u} (Fin 1)) f₀
    have w : (π ≫ ι) ≫ g = m ≫ (AffineSpace (ULift.{u} (Fin 1)) N ↘ N) := by
      rw [AffineSpace.map_over, Category.assoc]
    let h := Limits.pullback.lift (π ≫ ι) m w
    have hfst : h ≫ Limits.pullback.fst g (AffineSpace (ULift.{u} (Fin 1)) N ↘ N) = π ≫ ι :=
      Limits.pullback.lift_fst _ _ _
    have hsnd : h ≫ Limits.pullback.snd g (AffineSpace (ULift.{u} (Fin 1)) N ↘ N) = m :=
      Limits.pullback.lift_snd _ _ _
    have hout : IsPullback (h ≫ Limits.pullback.snd g (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)) π
        (AffineSpace (ULift.{u} (Fin 1)) N ↘ N) (ι ≫ g) := by
      rw [hsnd]; exact AffineSpace.isPullback_map f₀
    have hL : IsPullback h π (Limits.pullback.fst g (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)) ι :=
      IsPullback.of_right hout hfst (IsPullback.of_hasPullback g _).flip
    have e1 : hL.isoPullback.hom ≫
        Limits.pullback.fst (Limits.pullback.fst g (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)) ι = h :=
      hL.isoPullback_hom_fst
    have e1' : ∀ y, (Limits.pullback.fst (Limits.pullback.fst g
        (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)) ι).base.hom (hL.isoPullback.hom.base.hom y) =
        h.base.hom y := fun y =>
      congrArg (fun f : AffineSpace (ULift.{u} (Fin 1)) (Spec (V.residueField v)) ⟶
        Limits.pullback g (AffineSpace (ULift.{u} (Fin 1)) N ↘ N) => f.base.hom y) e1
    have hrange : Set.range h.base.hom =
        (Limits.pullback.fst g (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)).base.hom ⁻¹' {v} := by
      have hr2 : Set.range h.base.hom = Set.range
          (Limits.pullback.fst (Limits.pullback.fst g (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)) ι) := by
        ext x
        constructor
        · rintro ⟨y, rfl⟩
          exact ⟨hL.isoPullback.hom y, e1' y⟩
        · rintro ⟨y, rfl⟩
          obtain ⟨z, rfl⟩ := hL.isoPullback.hom.surjective y
          exact ⟨z, (e1' z).symm⟩
      rw [hr2, Scheme.Pullback.range_fst, Scheme.range_fromSpecResidueField]
    rw [← hrange]
    exact isPreconnected_range h.base.hom.continuous

  have hsurjG : ∀ {W : Scheme.{u}} (g : W ⟶ N),
      Function.Surjective (Limits.pullback.fst g (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)).base.hom :=
    fun g => Scheme.Hom.surjective (Limits.pullback.fst g (AffineSpace (ULift.{u} (Fin 1)) N ↘ N))
  have hopenG : ∀ {W : Scheme.{u}} (g : W ⟶ N),
      IsOpenMap (Limits.pullback.fst g (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)).base.hom :=
    fun g => Scheme.Hom.isOpenMap (Limits.pullback.fst g (AffineSpace (ULift.{u} (Fin 1)) N ↘ N))
  obtain ⟨c', hc'⟩ := wc_supp_unit_twist_isUnit Dp
  haveI hTD : TotallyDisconnectedSpace (ULift.{u+1} ℚ_[ℓ]) :=
    Homeomorph.totallyDisconnectedSpace Homeomorph.ulift.symm
  apply s1
  intro X
  rcases X with ⟨V⟩
  have htw := fun t => wc_supp_hom_twist_formula Dp hDp (wcSuppUnitMap Dp) V t
  let fstV := (Limits.pullback.fst V.hom (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)).base.hom
  let sndV := (Limits.pullback.snd V.hom (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)).base.hom
  have e2 : ∀ z, wcSuppTwist (wcSuppUnitMap Dp) (sndV z) * c' (sndV z) = 1 := fun z =>
    congrArg (fun φ => φ (sndV z)) hc'
  constructor
  · intro t t' htt
    let t0 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]) := t
    let t0' : C(↥V.left, ULift.{u+1} ℚ_[ℓ]) := t'
    have H : ContinuousMap.comp t0 fstV * (wcSuppTwist (wcSuppUnitMap Dp)).comp sndV =
        ContinuousMap.comp t0' fstV * (wcSuppTwist (wcSuppUnitMap Dp)).comp sndV :=
      (htw t).symm.trans (htt.trans (htw t'))
    change t0 = t0'
    apply ContinuousMap.ext
    intro x
    obtain ⟨z, hz⟩ := hsurjG V.hom x
    have hz' : fstV z = x := hz
    have H1 := congrArg (fun φ : C(↥(Limits.pullback V.hom (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)),
        ULift.{u+1} ℚ_[ℓ]) => φ z) H
    simp only [ContinuousMap.mul_apply, ContinuousMap.comp_apply] at H1
    rw [← hz']
    change t0 (fstV z) = t0' (fstV z)
    linear_combination (c' (sndV z)) * H1 - (t0 (fstV z) - t0' (fstV z)) * e2 z
  · intro s
    let s0 : C(↥(Limits.pullback V.hom (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)),
        ULift.{u+1} ℚ_[ℓ]) := s
    let s' := s0 * c'.comp sndV
    have hq : Topology.IsQuotientMap fstV :=
      IsOpenMap.isQuotientMap (hopenG V.hom) fstV.continuous (hsurjG V.hom)
    have hfac : Function.FactorsThrough s' fstV := by
      intro a b hab
      have hpc := (hfib V.hom (fstV b)).image s' s'.continuous.continuousOn
      exact hpc.subsingleton (Set.mem_image_of_mem _ hab) (Set.mem_image_of_mem _ rfl)
    refine ⟨hq.lift s' hfac, ?_⟩
    have hl := hq.lift_comp s' hfac
    change ((wcSuppUnitMap Dp).val.app (Opposite.op V)).hom (hq.lift s' hfac) = s0
    rw [htw, hl]
    apply ContinuousMap.ext
    intro z
    simp only [s', ContinuousMap.mul_apply, ContinuousMap.comp_apply]
    linear_combination (s0 z) * e2 z

theorem wc_hm_ladic_bridge : ∀ (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (i : ℕ),
    ∃ Θ : wcHM S ℓ i ≃+ Abelian.Ext (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S))) (wcLadicSheaf S ℓ) i,
      ∀ (c : ℚ_[ℓ]) (x : wcHM S ℓ i),
        Θ (wcHMScalar S ℓ i c x) = (Θ x).comp (Abelian.Ext.mk₀ (wcLadicScalar S ℓ c)) (add_zero i) :=
by
  intro S ℓ _ i
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _

  have hGC := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.ProEt.topology S)
    (wcRingSheaf S ℓ)
  have hunit : ∀ (V : (S.ProEt)ᵒᵖ) (k : ℕ), k ≠ 0 →
      IsUnit (k : ↑((wcRingSheaf S ℓ).obj.obj V)) := by
    intro V k hk
    have hk' : (k : ℚ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr hk
    change IsUnit (k : C(↥((Opposite.unop V).left), ULift.{u+1} ℚ_[ℓ]))
    refine isUnit_iff_exists_inv.mpr ⟨ContinuousMap.const _ (ULift.up ((k : ℚ_[ℓ])⁻¹)), ?_⟩
    refine ContinuousMap.ext fun t => ULift.ext _ _ ?_
    simp [hk']
  obtain ⟨L, adj, hLA, hLL, hLC⟩ := sheafOfModules_toSheaf_exact_left_adjoint
    (Scheme.ProEt.topology S) (wcRingSheaf S ℓ) hunit

  have s1 : ∀ (T : S.ProEt) (Fs : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}),
      Function.Bijective (fun φ : (presheafToSheaf (Scheme.ProEt.topology S)
          AddCommGrpCat.{u+1}).obj (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙
            AddCommGrpCat.free) ⟶ Fs =>
        φ.hom.app (Opposite.op T)
          ((toSheafify (Scheme.ProEt.topology S)
            (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
            (Opposite.op T) (FreeAbelianGroup.of (ULift.up (𝟙 T))))) := by
    intro T Fs
    let e2 : ∀ G : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1},
        (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ G) ≃
          G.obj (Opposite.op T) :=
      fun G => ((Adjunction.whiskerRight (S.ProEt)ᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u}) G).trans
          (uliftYonedaEquiv.{u+1} (X := T) (F := G ⋙ forget AddCommGrpCat.{u+1}))
    have he2 : ∀ (G : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})
        (ψ : yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ G),
        e2 G ψ = ψ.app (Opposite.op T) (FreeAbelianGroup.of (ULift.up (𝟙 T))) := by
      intro G ψ
      rfl
    let e : ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).obj
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Fs) ≃
          Fs.obj.obj (Opposite.op T) :=
      ((sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).homEquiv
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) Fs).trans (e2 Fs.obj)
    have he : ∀ φ, e φ = φ.hom.app (Opposite.op T)
          ((toSheafify (Scheme.ProEt.topology S)
            (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
            (Opposite.op T) (FreeAbelianGroup.of (ULift.up (𝟙 T)))) := by
      intro φ
      show e2 Fs.obj ((sheafificationAdjunction (Scheme.ProEt.topology S)
          AddCommGrpCat.{u+1}).homEquiv
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) Fs φ) = _
      rw [he2, Adjunction.homEquiv_unit, sheafificationAdjunction_unit_app]
      rfl
    have hfun : (fun φ : (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).obj
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Fs =>
        φ.hom.app (Opposite.op T)
          ((toSheafify (Scheme.ProEt.topology S)
            (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
            (Opposite.op T) (FreeAbelianGroup.of (ULift.up (𝟙 T))))) = ⇑e :=
      funext fun φ => (he φ).symm
    rw [hfun]
    exact e.bijective
  have s3 : ∀ (T : S.ProEt), Limits.IsTerminal T →
      ∀ M : SheafOfModules.{u+1} (wcRingSheaf S ℓ),
      Function.Bijective (fun g : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶ M =>
        g.val.app (Opposite.op T) (1 : (wcRingSheaf S ℓ).obj.obj (Opposite.op T))) := by
    intro T hT M
    have hev : Function.Bijective (fun s : M.val.sections =>
        (show M.val.obj (Opposite.op T) from s.1 (Opposite.op T))) := by
      constructor
      · intro s s' hss
        apply Subtype.ext
        funext X
        have e1 := s.2 (hT.from X.unop).op
        have e2 := s'.2 (hT.from X.unop).op
        simp only at hss
        rw [← e1, ← e2, hss]
      · intro w
        refine ⟨PresheafOfModules.sectionsMk (fun X => M.val.map (hT.from X.unop).op w) ?_, ?_⟩
        · intro X Y g
          rw [← PresheafOfModules.map_comp_apply]
          exact PresheafOfModules.congr_map_apply M.val
            (Quiver.Hom.unop_inj (hT.hom_ext _ _)) w
        · change M.val.map (hT.from T).op w = w
          rw [show hT.from T = 𝟙 T from hT.hom_ext _ _]
          simp only [op_id, PresheafOfModules.map_id]
          rfl
    have hfun : (fun g : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶ M =>
        g.val.app (Opposite.op T) (1 : (wcRingSheaf S ℓ).obj.obj (Opposite.op T))) =
        (fun s : M.val.sections =>
          (show M.val.obj (Opposite.op T) from s.1 (Opposite.op T))) ∘
            ⇑(SheafOfModules.unitHomEquiv M) := by
      funext g
      simp [SheafOfModules.unitHomEquiv_apply_coe]
    rw [hfun]
    exact hev.comp (SheafOfModules.unitHomEquiv M).bijective
  have bij_help : ∀ {α β γ : Type (u+1)} (ev : β → γ) (Θ : α → β) (e : α → γ),
      Function.Bijective ev → Function.Bijective e → (∀ a, ev (Θ a) = e a) →
      Function.Bijective Θ := by
    intro α β γ ev Θ e hev he hc
    refine ⟨fun a b hab => he.1 ((hc a).symm.trans ((congrArg ev hab).trans (hc b))),
      fun b => ?_⟩
    obtain ⟨a, ha⟩ := he.2 (ev b)
    exact ⟨a, hev.1 ((hc a).trans ha)⟩
  have hTerm : Limits.IsTerminal (Scheme.ProEt.mk (𝟙 S)) := by
    refine Limits.IsTerminal.ofUniqueHom
      (fun V => MorphismProperty.Over.homMk V.hom (Category.comp_id _) trivial) ?_
    intro V g
    apply MorphismProperty.Over.Hom.ext
    exact (Category.comp_id g.left).symm.trans (MorphismProperty.Over.w g)
  obtain ⟨ε₀, hε⟩ := (s1 (Scheme.ProEt.mk (𝟙 S)) ((SheafOfModules.toSheaf.{u+1}
    (wcRingSheaf S ℓ)).obj (SheafOfModules.unit (wcRingSheaf S ℓ)))).2
    (1 : (wcRingSheaf S ℓ).obj.obj (Opposite.op (Scheme.ProEt.mk (𝟙 S))))
  let ε : wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S)) ⟶ (SheafOfModules.toSheaf.{u+1}
    (wcRingSheaf S ℓ)).obj (SheafOfModules.unit (wcRingSheaf S ℓ)) := ε₀
  have Hε : ∀ M : SheafOfModules.{u+1} (wcRingSheaf S ℓ),
      Function.Bijective (fun g : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶ M =>
        ε ≫ (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)).map g) := by
    intro M
    refine bij_help
      (fun φ : wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S)) ⟶
          (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)).obj M =>
        φ.hom.app (Opposite.op (Scheme.ProEt.mk (𝟙 S)))
          ((toSheafify (Scheme.ProEt.topology S)
            (yoneda.obj (Scheme.ProEt.mk (𝟙 S)) ⋙ uliftFunctor.{u+1, u} ⋙
              AddCommGrpCat.free)).app
            (Opposite.op (Scheme.ProEt.mk (𝟙 S)))
            (FreeAbelianGroup.of (ULift.up (𝟙 (Scheme.ProEt.mk (𝟙 S)))))))
      (fun g : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶ M =>
        ε ≫ (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)).map g)
      (fun g : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶ M =>
        g.val.app (Opposite.op (Scheme.ProEt.mk (𝟙 S)))
          (1 : (wcRingSheaf S ℓ).obj.obj (Opposite.op (Scheme.ProEt.mk (𝟙 S)))))
      (s1 _ _) (s3 _ hTerm M) (fun g => ?_)
    exact congrArg (fun y => ((SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)).map
      g).hom.app (Opposite.op (Scheme.ProEt.mk (𝟙 S))) y) hε

  let G1 := (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)).obj
    (SheafOfModules.unit (wcRingSheaf S ℓ))
  let eV : ∀ V : (S.ProEt)ᵒᵖ, G1.obj.obj V ≅ (wcLadicSheaf S ℓ).obj.obj V := fun V =>
    { hom := AddCommGrpCat.ofHom
        { toFun := fun r => (ULift.up ((ContinuousMap.mk ULift.down continuous_uliftDown).comp
              (r : C(↥V.unop.left, ULift.{u+1} ℚ_[ℓ]))) :
              ULift.{u+1} C(↥V.unop.left, ℚ_[ℓ]))
          map_zero' := ULift.ext _ _ (ContinuousMap.ext fun _ => rfl)
          map_add' := fun _ _ => ULift.ext _ _ (ContinuousMap.ext fun _ => rfl) }
      inv := AddCommGrpCat.ofHom
        { toFun := fun w => ((ContinuousMap.mk ULift.up continuous_uliftUp).comp
              (w.down : C(↥V.unop.left, ℚ_[ℓ])) : C(↥V.unop.left, ULift.{u+1} ℚ_[ℓ]))
          map_zero' := ContinuousMap.ext fun _ => rfl
          map_add' := fun _ _ => ContinuousMap.ext fun _ => rfl }
      hom_inv_id := by
        apply AddCommGrpCat.ext
        intro r
        rfl
      inv_hom_id := by
        apply AddCommGrpCat.ext
        intro w
        rfl }
  let NI : G1.obj ≅ (wcLadicSheaf S ℓ).obj := NatIso.ofComponents eV (fun {V W} g => by
    apply AddCommGrpCat.ext
    intro r
    rfl)
  let ι : G1 ≅ wcLadicSheaf S ℓ := ObjectProperty.isoMk _ NI
  have I1 : ∀ c : ℚ_[ℓ], (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)).map
      (wcHMConst S ℓ c) ≫ ι.hom = ι.hom ≫ wcLadicScalar S ℓ c := by
    intro c
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext V
    apply AddCommGrpCat.ext
    intro r
    change (ULift.up ((ContinuousMap.mk ULift.down continuous_uliftDown).comp
        ((@id C(↥V.unop.left, ULift.{u+1} ℚ_[ℓ]) r) * ContinuousMap.const _ (ULift.up c))) :
          ULift.{u+1} C(↥V.unop.left, ℚ_[ℓ])) =
      ULift.up (c • (ContinuousMap.mk ULift.down continuous_uliftDown).comp
        (@id C(↥V.unop.left, ULift.{u+1} ℚ_[ℓ]) r))
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    show ((@id C(↥V.unop.left, ULift.{u+1} ℚ_[ℓ]) r) t).down * c =
      c * ((@id C(↥V.unop.left, ULift.{u+1} ℚ_[ℓ]) r) t).down
    exact mul_comm _ _

  obtain ⟨Φ, hΦ⟩ : ∃ Φ : wcHM S ℓ i →+ Abelian.Ext (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S))) G1 i,
      ∀ β, Φ β = (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor
        (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)) β) (zero_add i) :=
    ⟨AddMonoidHom.mk' (fun β => (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor
        (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)) β) (zero_add i))
      (fun a b => by rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.comp_add]), fun _ => rfl⟩
  have hB : Function.Bijective Φ := by
    have e : (⇑Φ) = fun β => (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor
        (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)) β) (zero_add i) := funext hΦ
    rw [e]
    exact ext_transfer_of_hom_bijective L (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ))
      adj (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S))) (SheafOfModules.unit (wcRingSheaf S ℓ)) ε Hε
      (SheafOfModules.unit (wcRingSheaf S ℓ)) i
  let Pe : Abelian.Ext (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S))) G1 i ≃+
      Abelian.Ext (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S))) (wcLadicSheaf S ℓ) i :=
    { toFun := fun z => z.comp (Abelian.Ext.mk₀ ι.hom) (add_zero i)
      invFun := fun z => z.comp (Abelian.Ext.mk₀ ι.inv) (add_zero i)
      left_inv := fun z => by
        change (z.comp (Abelian.Ext.mk₀ ι.hom) (add_zero i)).comp (Abelian.Ext.mk₀ ι.inv)
          (add_zero i) = z
        rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
          Abelian.Ext.comp_mk₀_id]
      right_inv := fun z => by
        change (z.comp (Abelian.Ext.mk₀ ι.inv) (add_zero i)).comp (Abelian.Ext.mk₀ ι.hom)
          (add_zero i) = z
        rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
          Abelian.Ext.comp_mk₀_id]
      map_add' := fun a b => Abelian.Ext.add_comp _ _ _ _ }
  refine ⟨(AddEquiv.ofBijective Φ hB).trans Pe, fun c x => ?_⟩
  change (Φ (wcHMScalar S ℓ i c x)).comp (Abelian.Ext.mk₀ ι.hom) (add_zero i) =
    ((Φ x).comp (Abelian.Ext.mk₀ ι.hom) (add_zero i)).comp
      (Abelian.Ext.mk₀ (wcLadicScalar S ℓ c)) (add_zero i)
  have hSc : wcHMScalar S ℓ i c x =
      x.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero i) := rfl
  have e2 : Φ (x.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero i)) =
      (Φ x).comp (Abelian.Ext.mk₀
        ((SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)).map (wcHMConst S ℓ c))) (add_zero i) := by
    rw [hΦ, hΦ, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
    exact (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).symm
  rw [hSc, e2, Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.comp_assoc_of_third_deg_zero,
    Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, I1]

theorem wc_hm_vanish_of_int_ext_vanish (Y : Scheme.{u}) [CompactSpace Y] [QuasiSeparatedSpace Y]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (j : ℕ)
    (h : ∀ y : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) (wcIntSheaf Y ℓ) (j + 1), y = 0) :
    ∀ x : wcHM Y ℓ (j + 1), x = 0 :=
by
  intro x
  haveI hcpt : CompactSpace ↥(Scheme.ProEt.mk (𝟙 Y)).left := (inferInstance : CompactSpace ↥Y)
  haveI hqs : QuasiSeparatedSpace ↥(Scheme.ProEt.mk (𝟙 Y)).left :=
    (inferInstance : QuasiSeparatedSpace ↥Y)
  obtain ⟨Θ, -⟩ := wc_hm_ladic_bridge Y ℓ (j + 1)
  obtain ⟨h1, hmul, hadd⟩ := wc_ladic_scalar_ring Y ℓ
  obtain ⟨n, y, hy⟩ := (proet_qcqs_ladic_rationalization Y (Scheme.ProEt.mk (𝟙 Y)) ℓ (j + 1)).1 (Θ x)
  rw [h y, Abelian.Ext.zero_comp] at hy
  have hs0 : wcLadicScalar Y ℓ 0 = 0 := by
    have e := hadd 0 0
    rw [add_zero] at e
    exact left_eq_add.mp e
  have hnat : ∀ (m : ℕ) (w : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
      (wcLadicSheaf Y ℓ) (j + 1)),
      w.comp (Abelian.Ext.mk₀ (wcLadicScalar Y ℓ (m : ℚ_[ℓ]))) (add_zero (j + 1)) = m • w := by
    intro m w
    induction m with
    | zero => rw [Nat.cast_zero, hs0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero, zero_smul]
    | succ m ih =>
      rw [Nat.cast_succ, hadd, h1, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih,
        Abelian.Ext.comp_mk₀_id, succ_nsmul]
  have hc : ((ℓ ^ n : ℕ) : ℚ_[ℓ]) ≠ 0 :=
    Nat.cast_ne_zero.mpr (pow_ne_zero n (Fact.out : Nat.Prime ℓ).ne_zero)
  have hz : Θ x = 0 := by
    calc Θ x = (Θ x).comp (Abelian.Ext.mk₀ (wcLadicScalar Y ℓ 1)) (add_zero (j + 1)) := by
          rw [h1, Abelian.Ext.comp_mk₀_id]
      _ = (Θ x).comp (Abelian.Ext.mk₀ (wcLadicScalar Y ℓ
            (((ℓ ^ n : ℕ) : ℚ_[ℓ])⁻¹ * ((ℓ ^ n : ℕ) : ℚ_[ℓ])))) (add_zero (j + 1)) := by
          rw [inv_mul_cancel₀ hc]
      _ = ((Θ x).comp (Abelian.Ext.mk₀ (wcLadicScalar Y ℓ ((ℓ ^ n : ℕ) : ℚ_[ℓ])))
            (add_zero (j + 1))).comp
            (Abelian.Ext.mk₀ (wcLadicScalar Y ℓ (((ℓ ^ n : ℕ) : ℚ_[ℓ])⁻¹))) (add_zero (j + 1)) := by
          rw [hmul, ← Abelian.Ext.mk₀_comp_mk₀,
            Abelian.Ext.comp_assoc _ _ _ (add_zero (j + 1)) (add_zero 0) (by omega)]
      _ = 0 := by
          rw [hnat, hy, Abelian.Ext.zero_comp]
  apply Θ.injective
  rw [hz, map_zero]

theorem wc_proet_int_ext_vanish_of_zmod (Y : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (U : Y.ProEt)
    (h : ∀ k j : ℕ, ∀ y : Abelian.Ext (wcFreeSheaf Y U) (wcZModSheaf Y (ℓ ^ (k + 1))) (j + 1), y = 0)
    (j : ℕ) : ∀ y : Abelian.Ext (wcFreeSheaf Y U) (wcIntSheaf Y ℓ) (j + 1), y = 0 :=
by

  have hlift : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]
      (φ : A →+ B) (hφ : Continuous φ) (σ : B → A) (hσ : Continuous σ)
      (_ : ∀ b, φ (σ b) = b) (g : wcFreeSheaf Y U ⟶ wcContSheaf Y B),
      ∃ g' : wcFreeSheaf Y U ⟶ wcContSheaf Y A, g' ≫ wcContSheafMap Y φ hφ = g := by
    intro A B _ _ _ _ _ _ φ hφ σ hσ hφσ g
    obtain ⟨e, hnat, -⟩ := proet_free_sheaf_hom_equiv Y U
    let s := e (wcContSheaf Y B) g
    let s' : (wcContSheaf Y A).obj.obj (Opposite.op U) :=
      ULift.up ((⟨σ, hσ⟩ : C(B, A)).comp (ULift.down s))
    refine ⟨(e (wcContSheaf Y A)).symm s', ?_⟩
    apply (e (wcContSheaf Y B)).injective
    rw [hnat, Equiv.apply_symm_apply]
    apply ULift.ext
    apply ContinuousMap.ext
    intro x
    exact hφσ _

  have hzero0 : (𝟙 (wcContSheaf Y (ZMod (ℓ ^ 0))) : _ ⟶ _) = 0 := by
    haveI : Subsingleton (ZMod (ℓ ^ 0)) := ZMod.subsingleton_iff.mpr (pow_zero ℓ)
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext V
    apply AddCommGrpCat.ext
    intro x
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    exact Subsingleton.elim _ _

  haveI := wc_proet_products_exact Y

  obtain ⟨hcont_incl, hemb, hcont_shift, hker, hsec⟩ := wc_padic_tower_facts ℓ
  obtain ⟨hz2, hS2⟩ := wc_contSheaf_shortExact Y (wcTowerIncl ℓ) hcont_incl
    (wcTowerShift ℓ) hcont_shift hemb hker hsec

  have hY := (wc_contSheaf_pi_isLimit Y (fun n => ZMod (ℓ ^ n))).some
  have hprod := fun N => wc_ext_prod_bijective (wcFreeSheaf Y U)
    (wcContSheaf Y ((n : ℕ) → ZMod (ℓ ^ n))) (fun n => wcContSheaf Y (ZMod (ℓ ^ n)))
    (fun n => wcContSheafMap Y (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n)
      (continuous_apply n)) hY N

  have hcongr : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B] (φ φ' : A →+ B)
      (e : φ = φ') (hφ : Continuous φ) (hφ' : Continuous φ'),
      wcContSheafMap Y φ hφ = wcContSheafMap Y φ' hφ' := by
    intro A B _ _ _ _ _ _ φ φ' e hφ hφ'
    subst e
    rfl
  have hTn : ∀ n, wcContSheafMap Y (wcTowerShift ℓ) hcont_shift ≫
      wcContSheafMap Y (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n) =
      wcContSheafMap Y (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n) -
      wcContSheafMap Y (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1))
        (continuous_apply (n + 1)) ≫
      wcContSheafMap Y (wcTowerCast ℓ n) continuous_of_discreteTopology := by
    intro n
    have e1 := (wc_contSheafMap_comp_sub Y (wcTowerShift ℓ) (wcTowerShift ℓ) hcont_shift
      hcont_shift (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n)).1
    have e2 := (wc_contSheafMap_comp_sub Y
      (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1))
      (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1)) (continuous_apply (n + 1))
      (continuous_apply (n + 1)) (wcTowerCast ℓ n) continuous_of_discreteTopology).1
    have e3 := (wc_contSheafMap_comp_sub Y
      (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n)
      ((wcTowerCast ℓ n).comp (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1)))
      (continuous_apply n)
      ((continuous_of_discreteTopology (f := ⇑(wcTowerCast ℓ n))).comp (continuous_apply (n + 1)))
      (AddMonoidHom.id (ZMod (ℓ ^ n))) continuous_id).2
    rw [← e1, ← e2, ← e3]
    exact hcongr _ _ (AddMonoidHom.ext fun a => rfl) _ _

  have hB : ∀ (n i : ℕ), 0 < i → ∀ x : Abelian.Ext (wcFreeSheaf Y U)
      (wcContSheaf Y (ZMod (ℓ ^ n))) i, x = 0 := by
    intro n i hi x
    cases n with
    | zero =>
      calc x = x.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero i) := (Abelian.Ext.comp_mk₀_id x).symm
        _ = 0 := by rw [hzero0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    | succ k =>
      obtain ⟨j', rfl⟩ : ∃ j', i = j' + 1 := ⟨i - 1, by omega⟩
      exact h k j' x

  have hc : ∀ (n : ℕ) (y : Abelian.Ext (wcFreeSheaf Y U) (wcContSheaf Y (ZMod (ℓ ^ n))) 0),
      ∃ z : Abelian.Ext (wcFreeSheaf Y U) (wcContSheaf Y (ZMod (ℓ ^ (n + 1)))) 0,
        z.comp (Abelian.Ext.mk₀ (wcContSheafMap Y (wcTowerCast ℓ n)
          continuous_of_discreteTopology)) (add_zero 0) = y := by
    intro n y
    have hsurj : Function.Surjective (wcTowerCast ℓ n) :=
      ZMod.castHom_surjective (pow_dvd_pow ℓ (Nat.le_succ n))
    obtain ⟨g', hg'⟩ := hlift (wcTowerCast ℓ n) continuous_of_discreteTopology
      (Function.surjInv hsurj) continuous_of_discreteTopology (Function.surjInv_eq hsurj)
      (Abelian.Ext.homEquiv₀ y)
    refine ⟨Abelian.Ext.mk₀ g', ?_⟩
    rw [Abelian.Ext.mk₀_comp_mk₀, hg', Abelian.Ext.mk₀_homEquiv₀_apply]

  have hvan := wc_ext_tower_vanishing (wcFreeSheaf Y U) _ _
    (fun n => wcContSheaf Y (ZMod (ℓ ^ n)))
    (fun n => wcContSheafMap Y (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n)
      (continuous_apply n))
    (fun n => wcContSheafMap Y (wcTowerCast ℓ n) continuous_of_discreteTopology)
    _ hTn _ hz2 hS2 0 (fun N => (hprod N).1) (fun N => (hprod N).2) hB hc
  intro y
  exact hvan (j + 1) (Nat.succ_pos j) y

theorem wc_proet_zmod_ext_vanish_of_et (Y : Scheme.{u}) [IsAffine Y] (n j : ℕ)
    (h : Subsingleton (wcEtCoh Y n (j + 1))) :
    ∀ y : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) (wcZModSheaf Y n) (j + 1), y = 0 :=
by
  classical
  intro y
  haveI : CompactSpace Y := inferInstance
  haveI : IsSeparated (Limits.terminal.from Y) := inferInstance
  obtain ⟨-, hcont⟩ := wc_etToProEt_flat_cont Y
  haveI := hcont
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  obtain ⟨E₀⟩ := wc_proet_etale_comparison_epsInv_qcsep Y
    ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod n)))) (j + 1)
  let χ : (wcEpsInv Y).obj ((constantSheaf (Scheme.smallEtaleTopology Y)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod n)))) ≅
      wcZModSheaf Y n :=
    (wc_epsInv_const Y (AddCommGrpCat.of (ULift.{u+1} (ZMod n)))).some ≪≫
      (wc_zmod_sheaf_const Y n).some.symm
  have post : ∀ {A B B' : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}} (e : B ≅ B'),
      Nonempty (Abelian.Ext A B (j + 1) ≃ Abelian.Ext A B' (j + 1)) := by
    intro A B B' e
    refine ⟨{ toFun := fun y => y.comp (Abelian.Ext.mk₀ e.hom) (add_zero (j + 1))
              invFun := fun y => y.comp (Abelian.Ext.mk₀ e.inv) (add_zero (j + 1))
              left_inv := fun y => ?_
              right_inv := fun y => ?_ }⟩
    · simp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero (j + 1)) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    · simp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero (j + 1)) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
  obtain ⟨E₂⟩ := post (A := wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) χ.symm
  let E : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) (wcZModSheaf Y n) (j + 1) ≃
      wcEtCoh Y n (j + 1) := E₂.trans E₀
  apply E.injective
  exact Subsingleton.elim _ _

theorem wc_wl_conditions_homeomorph : ∀ (X Y : Type u) [TopologicalSpace X] [TopologicalSpace Y] (_h : X ≃ₜ Y), IsClosed {x : X | IsClosed ({x} : Set X)} → (∀ x : X, ∃! y : X, IsClosed ({y} : Set X) ∧ x ⤳ y) → ExtremallyDisconnected {x : X | IsClosed ({x} : Set X)} → IsClosed {x : Y | IsClosed ({x} : Set Y)} ∧ (∀ x : Y, ∃! y : Y, IsClosed ({y} : Set Y) ∧ x ⤳ y) ∧ ExtremallyDisconnected {x : Y | IsClosed ({x} : Set Y)} :=
by
  intro X Y _ _ h ha hb hc
  have K : ∀ x : X, IsClosed ({h x} : Set Y) ↔ IsClosed ({x} : Set X) := by
    intro x
    rw [← Set.image_singleton]
    exact h.isClosed_image
  have K' : ∀ y : Y, IsClosed ({y} : Set Y) ↔ IsClosed ({h.symm y} : Set X) := by
    intro y
    have := K (h.symm y)
    rwa [Homeomorph.apply_symm_apply] at this
  refine ⟨?_, ?_, ?_⟩
  · have hpre : (⇑h ⁻¹' {x : Y | IsClosed ({x} : Set Y)}) = {x : X | IsClosed ({x} : Set X)} := by
      ext x
      simp only [Set.mem_preimage, Set.mem_setOf_eq]
      exact K x
    rw [← h.isClosed_preimage, hpre]
    exact ha
  · intro y
    obtain ⟨z, ⟨hzcl, hxz⟩, hzu⟩ := hb (h.symm y)
    refine ⟨h z, ⟨(K z).mpr hzcl, ?_⟩, ?_⟩
    · have := hxz.map h.continuous
      rwa [Homeomorph.apply_symm_apply] at this
    · rintro w ⟨hwcl, hyw⟩
      have h1 : h.symm w = z := hzu (h.symm w) ⟨(K' w).mp hwcl, hyw.map h.continuous_symm⟩
      rw [← h1, Homeomorph.apply_symm_apply]
  · haveI := hc
    exact extremallyDisconnected_of_homeo
      (Homeomorph.subtype h (p := fun x => x ∈ {x : X | IsClosed ({x} : Set X)})
        (q := fun y => y ∈ {x : Y | IsClosed ({x} : Set Y)}) (fun x => (K x).symm))

theorem wc_affine_closedPt_strictHensel : ∀ (Δ : Scheme.{u}) [IsAffine Δ], (∀ x : Δ, IsClosed ({x} : Set Δ) → HenselianLocalRing (Δ.presheaf.stalk x) ∧ IsSepClosed (Δ.residueField x)) → ∀ m : PrimeSpectrum Γ(Δ, ⊤), IsClosed ({m} : Set (PrimeSpectrum Γ(Δ, ⊤))) → HenselianLocalRing (Localization.AtPrime m.asIdeal) ∧ IsSepClosed (IsLocalRing.ResidueField (Localization.AtPrime m.asIdeal)) :=
by
  have s1 : ∀ (R S : Type u) [CommRing R] [CommRing S] [IsLocalRing S], R ≃+* S →
      HenselianLocalRing R → HenselianLocalRing S := by
    intro R S _ _ _ e hR
    refine { toIsLocalRing := ‹IsLocalRing S›, is_henselian := ?_ }
    intro f hf a₀ h1 h2
    have hg : (f.map (e.symm : S →+* R)).Monic := hf.map _
    have hb1 : Polynomial.eval ((e.symm : S →+* R) a₀) (f.map (e.symm : S →+* R)) ∈
        IsLocalRing.maximalIdeal R := by
      rw [Polynomial.eval_map_apply]
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at h1 ⊢
      intro hu
      apply h1
      simpa using hu.map (e : R →+* S)
    have hb2 : IsUnit (Polynomial.eval ((e.symm : S →+* R) a₀)
        (Polynomial.derivative (f.map (e.symm : S →+* R)))) := by
      rw [Polynomial.derivative_map, Polynomial.eval_map_apply]
      exact h2.map _
    obtain ⟨a, ha, ha'⟩ := HenselianLocalRing.is_henselian _ hg _ hb1 hb2
    have hfm : (f.map (e.symm : S →+* R)).map (e : R →+* S) = f := by
      ext n
      simp
    refine ⟨e a, ?_, ?_⟩
    · show Polynomial.eval (e a) f = 0
      rw [← hfm]
      refine (Polynomial.eval_map_apply (e : R →+* S) a).trans ?_
      rw [ha.eq_zero, map_zero]
    · have heq : e a - a₀ = (e : R →+* S) (a - (e.symm : S →+* R) a₀) := by simp
      rw [heq]
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at ha' ⊢
      intro hu
      apply ha'
      simpa using hu.map (e.symm : S →+* R)
  have s2 : ∀ (K L : Type u) [Field K] [Field L], K ≃+* L → IsSepClosed K → IsSepClosed L := by
    intro K L _ _ e hK
    apply IsSepClosed.of_exists_root
    intro p _ hirr hsep
    have hdeg : (p.map (e.symm : L →+* K)).degree ≠ 0 := by
      rw [Polynomial.degree_map_eq_of_injective e.symm.injective]
      exact (hirr.degree_pos).ne'
    obtain ⟨y, hy⟩ := IsSepClosed.exists_root (p.map (e.symm : L →+* K)) hdeg hsep.map
    have hpm : (p.map (e.symm : L →+* K)).map (e : K →+* L) = p := by
      ext n
      simp
    refine ⟨e y, ?_⟩
    rw [← hpm]
    refine (Polynomial.eval_map_apply (e : K →+* L) y).trans ?_
    rw [hy.eq_zero, map_zero]
  intro Δ _ hd m hm
  have hcl : IsClosed ({Δ.isoSpec.inv m} : Set Δ) := by
    have := (Scheme.homeoOfIso Δ.isoSpec.symm).isClosedMap ({m} : Set (Spec Γ(Δ, ⊤))) hm
    convert this using 1
    exact (Set.image_singleton (f := (Scheme.homeoOfIso Δ.isoSpec.symm)) (a := m)).symm
  let e : Δ.presheaf.stalk (Δ.isoSpec.inv m) ≃+* Localization.AtPrime m.asIdeal :=
    (asIso (Scheme.Hom.stalkMap Δ.isoSpec.inv (show (Spec Γ(Δ, ⊤) : Scheme.{u}) from m)) ≪≫
      Spec.stalkIso Γ(Δ, ⊤) m).commRingCatIsoToRingEquiv
  obtain ⟨h1, h2⟩ := hd _ hcl
  exact ⟨s1 _ _ e h1, s2 _ _ (IsLocalRing.ResidueField.mapEquiv e) h2⟩

theorem wc_idem_adjoin_vnr (K A : Type u) [Field K] [CommRing A] [Algebra K A]
    (f : Algebra.adjoin K {e : A | IsIdempotentElem e}) :
    ∃ t : Algebra.adjoin K {e : A | IsIdempotentElem e}, f * f * t = f :=
by
  classical
  have hmul : ∀ {ι : Type} [Fintype ι] (e : ι → A) (a b : ι → K),
      (∀ i, IsIdempotentElem (e i)) → (∀ i j, i ≠ j → e i * e j = 0) →
      (∑ i, a i • e i) * (∑ i, b i • e i) = ∑ i, (a i * b i) • e i := by
    intro ι _ e a b h1 h2
    rw [Finset.sum_mul_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [Finset.sum_eq_single i]
    · rw [smul_mul_smul_comm, (h1 i).eq]
    · intro j _ hj
      rw [smul_mul_smul_comm, h2 i j (Ne.symm hj), smul_zero]
    · intro h
      exact absurd (Finset.mem_univ i) h
  have hrefine : ∀ {ι κ : Type} [Fintype ι] [Fintype κ] (e : ι → A) (f : κ → A),
      (∀ i, IsIdempotentElem (e i)) → (∀ i j, i ≠ j → e i * e j = 0) → ∑ i, e i = 1 →
      (∀ j, IsIdempotentElem (f j)) → (∀ i j, i ≠ j → f i * f j = 0) → ∑ j, f j = 1 →
      (∀ p : ι × κ, IsIdempotentElem (e p.1 * f p.2)) ∧
      (∀ p q : ι × κ, p ≠ q → (e p.1 * f p.2) * (e q.1 * f q.2) = 0) ∧
      ∑ p : ι × κ, e p.1 * f p.2 = 1 ∧
      (∀ a : ι → K, ∑ i, a i • e i = ∑ p : ι × κ, a p.1 • (e p.1 * f p.2)) ∧
      (∀ b : κ → K, ∑ j, b j • f j = ∑ p : ι × κ, b p.2 • (e p.1 * f p.2)) := by
    intro ι κ _ _ e f he1 he2 he3 hf1 hf2 hf3
    refine ⟨fun p => (he1 p.1).mul (hf1 p.2), ?_, ?_, ?_, ?_⟩
    · rintro ⟨i, j⟩ ⟨i', j'⟩ hne
      dsimp only
      rw [mul_mul_mul_comm]
      by_cases hi : i = i'
      · subst hi
        have hj : j ≠ j' := fun h => hne (by rw [h])
        rw [hf2 j j' hj, mul_zero]
      · rw [he2 i i' hi, zero_mul]
    · rw [Fintype.sum_prod_type]
      dsimp only
      simp_rw [← Finset.mul_sum, hf3, mul_one, he3]
    · intro a
      rw [Fintype.sum_prod_type]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      dsimp only
      rw [← Finset.smul_sum, ← Finset.mul_sum, hf3, mul_one]
    · intro b
      rw [Fintype.sum_prod_type, Finset.sum_comm]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      dsimp only
      rw [← Finset.smul_sum, ← Finset.sum_mul, he3, one_mul]
  have hgenstep : ∀ x : A, IsIdempotentElem x →
      ∃ (ι : Type) (_ : Fintype ι) (e : ι → A) (a : ι → K),
      (∀ i, IsIdempotentElem (e i)) ∧ (∀ i j, i ≠ j → e i * e j = 0) ∧ ∑ i, e i = 1 ∧
      x = ∑ i, a i • e i := by
    intro x hx
    have hx' : x * x = x := hx
    refine ⟨Bool, inferInstance, fun b => if b then x else 1 - x,
      fun b => if b then 1 else 0, ?_, ?_, ?_, ?_⟩
    · intro b
      cases b
      · exact IsIdempotentElem.one_sub hx
      · exact hx
    · intro i j hij
      cases i <;> cases j
      · exact absurd rfl hij
      · simp only [Bool.false_eq_true, ↓reduceIte]
        linear_combination (-1 : A) * hx'
      · simp only [Bool.false_eq_true, ↓reduceIte]
        linear_combination (-1 : A) * hx'
      · exact absurd rfl hij
    · rw [Fintype.sum_bool]
      simp only [Bool.false_eq_true, ↓reduceIte]
      ring
    · rw [Fintype.sum_bool]
      simp only [Bool.false_eq_true, ↓reduceIte]
      rw [one_smul, zero_smul, add_zero]
  have halgstep : ∀ r : K,
      ∃ (ι : Type) (_ : Fintype ι) (e : ι → A) (a : ι → K),
      (∀ i, IsIdempotentElem (e i)) ∧ (∀ i j, i ≠ j → e i * e j = 0) ∧ ∑ i, e i = 1 ∧
      algebraMap K A r = ∑ i, a i • e i := by
    intro r
    refine ⟨Unit, inferInstance, fun _ => 1, fun _ => r, fun _ => IsIdempotentElem.one,
      fun i j h => absurd (Subsingleton.elim i j) h, ?_, ?_⟩
    · simp
    · simp [Algebra.algebraMap_eq_smul_one]
  have hstep : ∀ x ∈ Algebra.adjoin K {e : A | IsIdempotentElem e},
      ∃ (ι : Type) (_ : Fintype ι) (e : ι → A) (a : ι → K),
      (∀ i, IsIdempotentElem (e i)) ∧ (∀ i j, i ≠ j → e i * e j = 0) ∧ ∑ i, e i = 1 ∧
      x = ∑ i, a i • e i := by
    intro x hx
    induction hx using Algebra.adjoin_induction with
    | mem x hx => exact hgenstep x hx
    | algebraMap r => exact halgstep r
    | add x y _ _ hx hy =>
      obtain ⟨ι, _, e, a, he1, he2, he3, rfl⟩ := hx
      obtain ⟨κ, _, f, b, hf1, hf2, hf3, rfl⟩ := hy
      obtain ⟨g1, g2, g3, ga, gb⟩ := hrefine e f he1 he2 he3 hf1 hf2 hf3
      refine ⟨ι × κ, inferInstance, fun p => e p.1 * f p.2, fun p => a p.1 + b p.2,
        g1, g2, g3, ?_⟩
      rw [ga a, gb b, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl (fun p _ => (add_smul _ _ _).symm)
    | mul x y _ _ hx hy =>
      obtain ⟨ι, _, e, a, he1, he2, he3, rfl⟩ := hx
      obtain ⟨κ, _, f, b, hf1, hf2, hf3, rfl⟩ := hy
      obtain ⟨g1, g2, g3, ga, gb⟩ := hrefine e f he1 he2 he3 hf1 hf2 hf3
      refine ⟨ι × κ, inferInstance, fun p => e p.1 * f p.2, fun p => a p.1 * b p.2,
        g1, g2, g3, ?_⟩
      rw [ga a, gb b]
      exact hmul (fun p : ι × κ => e p.1 * f p.2) (fun p : ι × κ => a p.1)
        (fun p : ι × κ => b p.2) g1 g2
  obtain ⟨ι, _, e, a, he1, he2, _, hfx⟩ := hstep f.1 f.2
  have hgen : ∀ i, e i ∈ Algebra.adjoin K {e : A | IsIdempotentElem e} := by
    intro i
    apply Algebra.subset_adjoin
    exact Set.mem_setOf.mpr (he1 i)
  have hmem : ∀ c : ι → K, ∑ i, c i • e i ∈ Algebra.adjoin K {e : A | IsIdempotentElem e} := by
    intro c
    apply Subalgebra.sum_mem
    intro i _
    exact Subalgebra.smul_mem (Algebra.adjoin K {e : A | IsIdempotentElem e}) (hgen i) (c i)
  refine ⟨⟨∑ i, (a i)⁻¹ • e i, hmem (fun i => (a i)⁻¹)⟩, Subtype.ext ?_⟩
  rw [Subalgebra.coe_mul, Subalgebra.coe_mul]
  change f.1 * f.1 * (∑ i, (a i)⁻¹ • e i) = f.1
  rw [hfx, hmul e a a he1 he2, hmul e _ _ he1 he2]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  rw [mul_self_mul_inv]

theorem wc_wl_idem_fibre_strictHensel (K A : Type u) [Field K] [CommRing A] [Algebra K A]
    (hB : ∀ f : Algebra.adjoin K {e : A | IsIdempotentElem e},
      ∃ t : Algebra.adjoin K {e : A | IsIdempotentElem e}, f * f * t = f)
    (hcl : IsClosed {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))})
    (huniq : ∀ x : PrimeSpectrum A, ∃! y : PrimeSpectrum A, IsClosed ({y} : Set (PrimeSpectrum A)) ∧ x ⤳ y)
    (hsh : ∀ m : PrimeSpectrum A, IsClosed ({m} : Set (PrimeSpectrum A)) →
      HenselianLocalRing (Localization.AtPrime m.asIdeal) ∧
        IsSepClosed (IsLocalRing.ResidueField (Localization.AtPrime m.asIdeal)))
    (𝔭 : Ideal (Algebra.adjoin K {e : A | IsIdempotentElem e})) (h𝔭 : 𝔭.IsPrime) :
    ∃ (_ : HenselianLocalRing (A ⧸ 𝔭.map (algebraMap (Algebra.adjoin K {e : A | IsIdempotentElem e}) A))),
      IsSepClosed (IsLocalRing.ResidueField
        (A ⧸ 𝔭.map (algebraMap (Algebra.adjoin K {e : A | IsIdempotentElem e}) A))) :=
by
  classical

  have t_s1 : ∀ (B : Type u) [CommRing B] [Algebra B A],
      Function.Injective (algebraMap B A) → (∀ f : B, ∃ t : B, f * f * t = f) →
      ∀ (𝔭 : Ideal B), 𝔭.IsPrime → 𝔭.map (algebraMap B A) ≠ ⊤ := by
    intro B _ _ hinj hB 𝔭 h𝔭
    have key : ∀ x ∈ 𝔭.map (algebraMap B A), ∃ e ∈ 𝔭, x * algebraMap B A e = x := by
      intro x hx
      have hx' : x ∈ Submodule.span A (algebraMap B A '' (𝔭 : Set B)) := hx
      clear hx
      induction hx' using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨p, hp, rfl⟩ := hx
        obtain ⟨t, ht⟩ := hB p
        refine ⟨p * t, 𝔭.mul_mem_right t hp, ?_⟩
        rw [← map_mul, ← mul_assoc, ht]
      | zero => exact ⟨0, 𝔭.zero_mem, by simp⟩
      | add x y _ _ hx hy =>
        obtain ⟨e₁, he₁, h₁⟩ := hx
        obtain ⟨e₂, he₂, h₂⟩ := hy
        refine ⟨e₁ + e₂ - e₁ * e₂, 𝔭.sub_mem (𝔭.add_mem he₁ he₂) (𝔭.mul_mem_right _ he₁), ?_⟩
        rw [map_sub, map_add, map_mul]
        linear_combination (1 - algebraMap B A e₂) * h₁ + (1 - algebraMap B A e₁) * h₂
      | smul a x _ hx =>
        obtain ⟨e, he, h⟩ := hx
        refine ⟨e, he, ?_⟩
        rw [smul_eq_mul, mul_assoc, h]
    intro htop
    have h1 : (1 : A) ∈ 𝔭.map (algebraMap B A) := by rw [htop]; exact Submodule.mem_top
    obtain ⟨e, he, h⟩ := key 1 h1
    rw [one_mul, ← map_one (algebraMap B A)] at h
    have he1 : e = 1 := hinj h
    rw [he1] at he
    exact h𝔭.ne_top ((Ideal.eq_top_iff_one _).2 he)

  have t_s2 : ∀ (m₁ m₂ : Ideal A), m₁.IsMaximal → m₂.IsMaximal → m₁ ≠ m₂ →
      ∃ a : A, a ∈ m₁ ∧ 1 - a ∈ m₂ ∧ ∀ m : Ideal A, m.IsMaximal → a ∈ m ∨ 1 - a ∈ m := by
    intro m₁ m₂ h₁ h₂ hne
    obtain ⟨s, hs1, hs2⟩ : ∃ s ∈ m₁, s ∉ m₂ := by
      by_contra h
      push_neg at h
      exact hne (h₁.eq_of_le h₂.ne_top h)
    let M : Submonoid A :=
      { carrier := {x | ∃ (n : ℕ) (t : A), x = s ^ n * (1 - s * t)}
        one_mem' := ⟨0, 0, by simp⟩
        mul_mem' := by
          rintro _ _ ⟨n, t, rfl⟩ ⟨k, t', rfl⟩
          exact ⟨n + k, t + t' - s * t * t', by ring⟩ }
    have hJ : ∀ f ∈ PrimeSpectrum.vanishingIdeal
        {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))},
        ∀ m : Ideal A, m.IsMaximal → f ∈ m := by
      intro f hf m hm
      rw [PrimeSpectrum.mem_vanishingIdeal] at hf
      exact hf ⟨m, hm.isPrime⟩ ((PrimeSpectrum.isClosed_singleton_iff_isMaximal _).2 hm)
    have hnd : ¬ Disjoint ((PrimeSpectrum.vanishingIdeal
        {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} : Ideal A) : Set A)
        (M : Set A) := by
      intro hdis
      obtain ⟨q, hq, hJq, hqM⟩ := Ideal.exists_le_prime_disjoint _ M hdis
      have hqcl : IsClosed ({(⟨q, hq⟩ : PrimeSpectrum A)} : Set (PrimeSpectrum A)) := by
        have hmem : (⟨q, hq⟩ : PrimeSpectrum A) ∈
            closure {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} := by
          rw [← PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure, PrimeSpectrum.mem_zeroLocus]
          exact hJq
        rw [hcl.closure_eq] at hmem
        exact hmem
      have hqmax : q.IsMaximal := (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).1 hqcl
      have hsM : s ∈ M := ⟨1, 0, by simp⟩
      have hsq : s ∉ q := fun h => Set.disjoint_left.1 hqM h hsM
      obtain ⟨y, i, hi, hyi⟩ := hqmax.exists_inv hsq
      have h1 : 1 - s * y ∈ M := ⟨0, y, by simp⟩
      have h2 : 1 - s * y ∈ q := by
        have : 1 - s * y = i := by linear_combination (-1 : A) * hyi
        rw [this]; exact hi
      exact Set.disjoint_left.1 hqM h2 h1
    rw [Set.not_disjoint_iff] at hnd
    obtain ⟨x, hxJ, hxM⟩ := hnd
    obtain ⟨n, t, rfl⟩ := hxM
    refine ⟨s * t, m₁.mul_mem_right t hs1, ?_, ?_⟩
    · have := hJ _ hxJ m₂ h₂
      rcases h₂.isPrime.mem_or_mem this with h | h
      · exact absurd (h₂.isPrime.mem_of_pow_mem n h) hs2
      · exact h
    · intro m hm
      have := hJ _ hxJ m hm
      rcases hm.isPrime.mem_or_mem this with h | h
      · exact Or.inl (m.mul_mem_right t (hm.isPrime.mem_of_pow_mem n h))
      · exact Or.inr h

  have t_s3 : ∀ (a : A), (∀ m : Ideal A, m.IsMaximal → a ∈ m ∨ 1 - a ∈ m) →
      ∃ e : A, IsIdempotentElem e ∧ ∀ m : Ideal A, m.IsMaximal →
        (a ∈ m → 1 - e ∈ m) ∧ (1 - a ∈ m → e ∈ m) := by
    intro a ha
    let M : Submonoid A :=
      { carrier := {x | ∃ b c : A, x = (1 - a * b) * (1 - (1 - a) * c)}
        one_mem' := ⟨0, 0, by simp⟩
        mul_mem' := by
          rintro _ _ ⟨b, c, rfl⟩ ⟨b', c', rfl⟩
          exact ⟨b + b' - a * b * b', c + c' - (1 - a) * c * c', by ring⟩ }
    have h0 : (0 : A) ∈ M := by
      by_contra h0
      have hdis : Disjoint ((⊥ : Ideal A) : Set A) (M : Set A) := by
        rw [Set.disjoint_left]
        intro x hx hxM
        have hx0 : x = 0 := (Submodule.mem_bot A).1 hx
        rw [hx0] at hxM
        exact h0 hxM
      obtain ⟨q, hq, -, hqM⟩ := Ideal.exists_le_prime_disjoint ⊥ M hdis
      have hne1 : q ⊔ Ideal.span {a} ≠ ⊤ := by
        intro htop
        have h1 : (1 : A) ∈ q ⊔ Ideal.span {a} := by rw [htop]; exact Submodule.mem_top
        obtain ⟨i, hi, j, hj, hij⟩ := Submodule.mem_sup.1 h1
        obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton'.1 hj
        have hM : 1 - a * y ∈ M := ⟨y, 0, by ring⟩
        have hq' : 1 - a * y ∈ q := by
          have : 1 - a * y = i := by linear_combination (-1 : A) * hij
          rw [this]; exact hi
        exact Set.disjoint_left.1 hqM hq' hM
      have hne2 : q ⊔ Ideal.span {1 - a} ≠ ⊤ := by
        intro htop
        have h1 : (1 : A) ∈ q ⊔ Ideal.span {1 - a} := by rw [htop]; exact Submodule.mem_top
        obtain ⟨i, hi, j, hj, hij⟩ := Submodule.mem_sup.1 h1
        obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton'.1 hj
        have hM : 1 - (1 - a) * y ∈ M := ⟨0, y, by ring⟩
        have hq' : 1 - (1 - a) * y ∈ q := by
          have : 1 - (1 - a) * y = i := by linear_combination (-1 : A) * hij
          rw [this]; exact hi
        exact Set.disjoint_left.1 hqM hq' hM
      obtain ⟨m₁, hm₁, hle₁⟩ := Ideal.exists_le_maximal _ hne1
      obtain ⟨m₂, hm₂, hle₂⟩ := Ideal.exists_le_maximal _ hne2
      obtain ⟨y, -, hy⟩ := huniq ⟨q, hq⟩
      have hq1 : (⟨q, hq⟩ : PrimeSpectrum A) ≤ ⟨m₁, hm₁.isPrime⟩ :=
        (PrimeSpectrum.asIdeal_le_asIdeal _ _).1 (le_trans le_sup_left hle₁)
      have hq2 : (⟨q, hq⟩ : PrimeSpectrum A) ≤ ⟨m₂, hm₂.isPrime⟩ :=
        (PrimeSpectrum.asIdeal_le_asIdeal _ _).1 (le_trans le_sup_left hle₂)
      have e1 : (⟨m₁, hm₁.isPrime⟩ : PrimeSpectrum A) = y :=
        hy _ ⟨(PrimeSpectrum.isClosed_singleton_iff_isMaximal _).2 hm₁,
          (PrimeSpectrum.le_iff_specializes _ _).1 hq1⟩
      have e2 : (⟨m₂, hm₂.isPrime⟩ : PrimeSpectrum A) = y :=
        hy _ ⟨(PrimeSpectrum.isClosed_singleton_iff_isMaximal _).2 hm₂,
          (PrimeSpectrum.le_iff_specializes _ _).1 hq2⟩
      have hm : m₁ = m₂ := congrArg PrimeSpectrum.asIdeal (e1.trans e2.symm)
      have ha1 : a ∈ m₁ := hle₁ (Ideal.mem_sup_right (Ideal.mem_span_singleton_self a))
      have ha2 : 1 - a ∈ m₁ := by
        rw [hm]; exact hle₂ (Ideal.mem_sup_right (Ideal.mem_span_singleton_self _))
      have h1 := m₁.add_mem ha1 ha2
      have e3 : a + (1 - a) = 1 := by ring
      rw [e3] at h1
      exact hm₁.ne_top ((Ideal.eq_top_iff_one _).2 h1)
    obtain ⟨b, c, hbc⟩ := h0
    have huv_top : Ideal.span {1 - a * b, 1 - (1 - a) * c} = ⊤ := by
      by_contra hne
      obtain ⟨m, hm, hle⟩ := Ideal.exists_le_maximal _ hne
      have hu' : 1 - a * b ∈ m := hle (Ideal.subset_span (by simp))
      have hv' : 1 - (1 - a) * c ∈ m := hle (Ideal.subset_span (by simp))
      apply hm.ne_top
      rw [Ideal.eq_top_iff_one]
      rcases ha m hm with h | h
      · have : (1 : A) = (1 - a * b) + a * b := by ring
        rw [this]; exact m.add_mem hu' (m.mul_mem_right b h)
      · have : (1 : A) = (1 - (1 - a) * c) + (1 - a) * c := by ring
        rw [this]; exact m.add_mem hv' (m.mul_mem_right c h)
    have h1mem : (1 : A) ∈ Ideal.span {1 - a * b, 1 - (1 - a) * c} := by
      rw [huv_top]; exact Submodule.mem_top
    obtain ⟨p, r, hpr⟩ := Ideal.mem_span_pair.1 h1mem
    refine ⟨p * (1 - a * b), ?_, ?_⟩
    · unfold IsIdempotentElem
      linear_combination (p * (1 - a * b)) * hpr + (p * r) * hbc
    · intro m hm
      have hprod : (1 - a * b) * (1 - (1 - a) * c) ∈ m := by rw [← hbc]; exact m.zero_mem
      constructor
      · intro ham
        have hu_nm : (1 - a * b) ∉ m := by
          intro h
          apply hm.ne_top
          rw [Ideal.eq_top_iff_one]
          have : (1 : A) = (1 - a * b) + a * b := by ring
          rw [this]; exact m.add_mem h (m.mul_mem_right b ham)
        have hv' := (hm.isPrime.mem_or_mem hprod).resolve_left hu_nm
        have : 1 - p * (1 - a * b) = r * (1 - (1 - a) * c) := by
          linear_combination (-1 : A) * hpr
        rw [this]; exact m.mul_mem_left r hv'
      · intro ham
        have hv_nm : (1 - (1 - a) * c) ∉ m := by
          intro h
          apply hm.ne_top
          rw [Ideal.eq_top_iff_one]
          have : (1 : A) = (1 - (1 - a) * c) + (1 - a) * c := by ring
          rw [this]; exact m.add_mem h (m.mul_mem_right c ham)
        have hu' := (hm.isPrime.mem_or_mem hprod).resolve_right hv_nm
        exact m.mul_mem_left p hu'

  have t_s6 : ∀ (R S : Type u) [CommRing R] [CommRing S]
      [HenselianLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)] [Nontrivial S]
      (φ : R →+* S), Function.Surjective φ →
      ∃ (_ : HenselianLocalRing S), IsSepClosed (IsLocalRing.ResidueField S) := by
    intro R S _ _ _ _ _ φ hφ
    haveI : IsLocalRing S := IsLocalRing.of_surjective' φ hφ
    haveI : IsLocalHom φ := IsLocalHom.of_surjective φ hφ
    have hK : ∀ x ∈ IsLocalRing.maximalIdeal R, φ x ∈ IsLocalRing.maximalIdeal S := by
      intro x hx
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hx ⊢
      exact fun h => hx (isUnit_of_map_unit φ x h)
    have hH : HenselianLocalRing S := by
      refine { toIsLocalRing := inferInstance, is_henselian := ?_ }
      intro f hf a₀ h1 h2
      obtain ⟨F0, hF0⟩ := Polynomial.map_surjective φ hφ f
      obtain ⟨F, hFmap, -, hFmon⟩ :=
        Polynomial.lifts_and_natDegree_eq_and_monic ((Polynomial.mem_lifts f).2 ⟨F0, hF0⟩) hf
      obtain ⟨b₀, rfl⟩ := hφ a₀
      have e1 : φ (F.eval b₀) = f.eval (φ b₀) := by rw [← hFmap, Polynomial.eval_map_apply]
      have e2 : φ (F.derivative.eval b₀) = f.derivative.eval (φ b₀) := by
        rw [← hFmap, Polynomial.derivative_map, Polynomial.eval_map_apply]
      have h1' : F.eval b₀ ∈ IsLocalRing.maximalIdeal R := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hu
        have hu2 := hu.map φ
        rw [e1] at hu2
        exact (mem_nonunits_iff.1 ((IsLocalRing.mem_maximalIdeal _).1 h1)) hu2
      have h2' : IsUnit (F.derivative.eval b₀) := isUnit_of_map_unit φ _ (by rw [e2]; exact h2)
      obtain ⟨b, hb, hbb⟩ := HenselianLocalRing.is_henselian F hFmon b₀ h1' h2'
      refine ⟨φ b, ?_, ?_⟩
      · rw [← hFmap]; exact hb.map
      · rw [← map_sub]; exact hK _ hbb
    refine ⟨hH, ?_⟩
    let ψ := IsLocalRing.ResidueField.map φ
    have hsurj : Function.Surjective ψ := by
      intro z
      obtain ⟨s, rfl⟩ := IsLocalRing.residue_surjective z
      obtain ⟨r, rfl⟩ := hφ s
      exact ⟨IsLocalRing.residue R r, IsLocalRing.ResidueField.map_residue φ r⟩
    have hinj : Function.Injective ψ := ψ.injective
    let e := RingEquiv.ofBijective ψ ⟨hinj, hsurj⟩
    apply IsSepClosed.of_exists_root
    intro p hmon hirr hsep
    let q := p.map (e.symm : IsLocalRing.ResidueField S →+* IsLocalRing.ResidueField R)
    have hdeg : q.degree ≠ 0 := by
      rw [Polynomial.degree_map_eq_of_injective e.symm.injective]
      exact (Polynomial.degree_pos_of_irreducible hirr).ne'
    have hqsep : q.Separable := hsep.map
    obtain ⟨x, hx⟩ := IsSepClosed.exists_root q hdeg hqsep
    refine ⟨e x, ?_⟩
    have hpq : p = q.map (e : IsLocalRing.ResidueField R →+* IsLocalRing.ResidueField S) := by
      ext n
      simp [q, Polynomial.coeff_map]
    rw [hpq]
    calc _ = (e : IsLocalRing.ResidueField R →+* IsLocalRing.ResidueField S) (q.eval x) :=
          Polynomial.eval_map_apply _ x
      _ = 0 := by rw [hx.eq_zero, map_zero]

  have hinj : Function.Injective
      (algebraMap (Algebra.adjoin K {e : A | IsIdempotentElem e}) A) := Subtype.val_injective
  have hI := t_s1 _ hinj hB 𝔭 h𝔭
  obtain ⟨𝔪, h𝔪, hI𝔪⟩ := Ideal.exists_le_maximal _ hI

  have hU : ∀ 𝔫 : Ideal A, 𝔫.IsMaximal →
      𝔭.map (algebraMap (Algebra.adjoin K {e : A | IsIdempotentElem e}) A) ≤ 𝔫 → 𝔫 = 𝔪 := by
    intro 𝔫 h𝔫 hI𝔫
    by_contra hne
    obtain ⟨a, ha1, ha2, ha⟩ := t_s2 𝔫 𝔪 h𝔫 h𝔪 hne
    obtain ⟨e, he, hem⟩ := t_s3 a ha
    have h1e : 1 - e ∈ 𝔫 := (hem 𝔫 h𝔫).1 ha1
    have he𝔪 : e ∈ 𝔪 := (hem 𝔪 h𝔪).2 ha2
    let eB : Algebra.adjoin K {e : A | IsIdempotentElem e} := ⟨e, Algebra.subset_adjoin he⟩
    have hprod : eB * (1 - eB) = 0 := by
      apply Subtype.ext
      show e * (1 - e) = 0
      rw [mul_sub, mul_one, he.eq, sub_self]
    have hmem : eB * (1 - eB) ∈ 𝔭 := by rw [hprod]; exact 𝔭.zero_mem
    rcases h𝔭.mem_or_mem hmem with h | h
    · have h2 : e ∈ 𝔭.map (algebraMap (Algebra.adjoin K {e : A | IsIdempotentElem e}) A) :=
        Ideal.mem_map_of_mem _ h
      apply h𝔫.ne_top
      rw [Ideal.eq_top_iff_one]
      have : (1 : A) = e + (1 - e) := by ring
      rw [this]; exact 𝔫.add_mem (hI𝔫 h2) h1e
    · have h2 := Ideal.mem_map_of_mem
        (algebraMap (Algebra.adjoin K {e : A | IsIdempotentElem e}) A) h
      rw [map_sub, map_one] at h2
      have h3 : 1 - e ∈ 𝔭.map (algebraMap (Algebra.adjoin K {e : A | IsIdempotentElem e}) A) := h2
      apply h𝔪.ne_top
      rw [Ideal.eq_top_iff_one]
      have : (1 : A) = (1 - e) + e := by ring
      rw [this]; exact 𝔪.add_mem (hI𝔪 h3) he𝔪
  let m : PrimeSpectrum A := ⟨𝔪, h𝔪.isPrime⟩
  have hm : IsClosed ({m} : Set (PrimeSpectrum A)) :=
    (PrimeSpectrum.isClosed_singleton_iff_isMaximal m).2 h𝔪
  obtain ⟨hH, hS⟩ := hsh m hm

  have hunit : ∀ y : 𝔪.primeCompl, IsUnit (Ideal.Quotient.mk
      (𝔭.map (algebraMap (Algebra.adjoin K {e : A | IsIdempotentElem e}) A)) (y : A)) := by
    rintro ⟨s, hs⟩
    have hs' : s ∉ 𝔪 := hs
    by_cases htop : 𝔭.map (algebraMap (Algebra.adjoin K {e : A | IsIdempotentElem e}) A) ⊔
        Ideal.span {s} = ⊤
    · have h1 : (1 : A) ∈ 𝔭.map (algebraMap (Algebra.adjoin K {e : A | IsIdempotentElem e}) A) ⊔
          Ideal.span {s} := by rw [htop]; exact Submodule.mem_top
      obtain ⟨i, hi, j, hj, hij⟩ := Submodule.mem_sup.1 h1
      obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton'.1 hj
      refine isUnit_iff_exists_inv.2 ⟨Ideal.Quotient.mk _ y, ?_⟩
      rw [← map_mul, ← map_one (Ideal.Quotient.mk _), Ideal.Quotient.eq]
      have : s * y - 1 = -i := by linear_combination hij
      rw [this]; exact neg_mem hi
    · obtain ⟨𝔫, h𝔫, hle⟩ := Ideal.exists_le_maximal _ htop
      have h𝔫𝔪 := hU 𝔫 h𝔫 (le_trans le_sup_left hle)
      have h2 : s ∈ 𝔫 := hle (Ideal.mem_sup_right (Ideal.mem_span_singleton_self s))
      rw [h𝔫𝔪] at h2
      exact absurd h2 hs'
  haveI : Nontrivial (A ⧸ 𝔭.map (algebraMap (Algebra.adjoin K {e : A | IsIdempotentElem e}) A)) :=
    Ideal.Quotient.nontrivial_iff.2 hI
  let φ : Localization.AtPrime 𝔪 →+*
      A ⧸ 𝔭.map (algebraMap (Algebra.adjoin K {e : A | IsIdempotentElem e}) A) :=
    IsLocalization.lift (M := 𝔪.primeCompl) (S := Localization.AtPrime 𝔪) hunit
  have hφ : Function.Surjective φ := by
    intro z
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective z
    exact ⟨algebraMap A _ a, IsLocalization.lift_eq hunit a⟩
  exact @t_s6 (Localization.AtPrime m.asIdeal) _ _ _ hH hS _ φ hφ

theorem wc_affine_vnr_spec_fibre_iso (W : Scheme.{u}) [IsAffine W] (B : Type u) [CommRing B]
    (φ : B →+* Γ(W, ⊤)) (hB : ∀ f : B, ∃ t : B, f * f * t = f) (𝔭 : PrimeSpectrum B) :
    Nonempty (Limits.pullback (W.toSpecΓ ≫ Spec.map (CommRingCat.ofHom φ))
        ((Spec (.of B)).fromSpecResidueField 𝔭) ≅
      Spec (.of (Γ(W, ⊤) ⧸ Ideal.map φ 𝔭.asIdeal))) :=
by
  classical

  have hmax : 𝔭.asIdeal.IsMaximal := by
    apply Ideal.Quotient.maximal_of_isField
    refine ⟨⟨0, 1, zero_ne_one⟩, mul_comm, ?_⟩
    intro a ha
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective a
    obtain ⟨t, ht⟩ := hB x
    refine ⟨Ideal.Quotient.mk 𝔭.asIdeal t, ?_⟩
    have hx : x ∉ 𝔭.asIdeal := fun h => ha (Ideal.Quotient.eq_zero_iff_mem.mpr h)
    have h1 : x * (x * t - 1) ∈ 𝔭.asIdeal := by
      have h0 : x * (x * t - 1) = 0 := by rw [mul_sub, ← mul_assoc, ht, mul_one, sub_self]
      rw [h0]; exact 𝔭.asIdeal.zero_mem
    rcases 𝔭.isPrime.mem_or_mem h1 with h | h
    · exact absurd h hx
    · rw [← map_mul, ← sub_eq_zero, ← map_one (Ideal.Quotient.mk 𝔭.asIdeal), ← map_sub]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr h

  letI iA : Algebra B ((Spec (.of B)).presheaf.stalk 𝔭) := StructureSheaf.stalkAlgebra B 𝔭
  haveI iL : IsLocalization.AtPrime ((Spec (.of B)).presheaf.stalk 𝔭) 𝔭.asIdeal :=
    StructureSheaf.IsLocalization.to_stalk B 𝔭
  haveI iR : IsLocalRing ((Spec (.of B)).presheaf.stalk 𝔭) :=
    IsLocalization.AtPrime.isLocalRing _ 𝔭.asIdeal
  let e0 : B ⧸ 𝔭.asIdeal ≃+* IsLocalRing.ResidueField ((Spec (.of B)).presheaf.stalk 𝔭) :=
    IsLocalization.AtPrime.equivQuotMaximalIdeal 𝔭.asIdeal _
  let e : CommRingCat.of (B ⧸ 𝔭.asIdeal) ≅ (Spec (.of B)).residueField 𝔭 :=
    e0.toCommRingCatIso
  have hgerm : (Scheme.ΓSpecIso (.of B)).inv ≫ (Spec (.of B)).presheaf.germ ⊤ 𝔭 trivial =
      StructureSheaf.toStalk B 𝔭 := by
    rw [Scheme.ΓSpecIso_inv]
    exact StructureSheaf.algebraMap_germ ⊤ 𝔭 trivial
  have he : CommRingCat.ofHom (Ideal.Quotient.mk 𝔭.asIdeal) ≫ e.hom =
      (Scheme.ΓSpecIso (.of B)).inv ≫ (Spec (.of B)).presheaf.germ ⊤ 𝔭 trivial ≫
        (Spec (.of B)).residue 𝔭 := by
    rw [← Category.assoc (Scheme.ΓSpecIso (.of B)).inv, hgerm]
    refine CommRingCat.hom_ext (RingHom.ext fun x => ?_)
    show e0 (Ideal.Quotient.mk 𝔭.asIdeal x) =
      IsLocalRing.residue ((Spec (.of B)).presheaf.stalk 𝔭)
        (algebraMap B ((Spec (.of B)).presheaf.stalk 𝔭) x)
    exact IsLocalization.AtPrime.equivQuotMaximalIdeal_apply_mk 𝔭.asIdeal _ x

  have hres : (Spec (.of B)).fromSpecResidueField 𝔭 =
      Spec.map e.hom ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk 𝔭.asIdeal)) := by
    rw [← Spec.map_comp, he]
    exact (congrArg (Spec.map ((Spec (.of B)).residue 𝔭) ≫ ·)
      (Spec.fromSpecStalk_eq (.of B) 𝔭)).trans
      ((Spec.map_comp _ _).symm.trans (congrArg Spec.map (Category.assoc _ _ _)))

  letI : Algebra B Γ(W, ⊤) := φ.toAlgebra
  let m := Limits.pullback.map (W.toSpecΓ ≫ Spec.map (CommRingCat.ofHom φ))
    ((Spec (.of B)).fromSpecResidueField 𝔭)
    (Spec.map (CommRingCat.ofHom (algebraMap B Γ(W, ⊤))))
    (Spec.map (CommRingCat.ofHom (algebraMap B (B ⧸ 𝔭.asIdeal))))
    W.toSpecΓ (Spec.map e.hom) (𝟙 _) (by rw [Category.comp_id]; try rfl)
    (by rw [Category.comp_id, hres]; try rfl)
  haveI : IsIso m := Limits.pullback.map_isIso _ _ _ _ _ _ _ _ _
  let ε : CommRingCat.of (Γ(W, ⊤) ⧸ Ideal.map (algebraMap B Γ(W, ⊤)) 𝔭.asIdeal) ≅
      CommRingCat.of (TensorProduct B Γ(W, ⊤) (B ⧸ 𝔭.asIdeal)) :=
    (Algebra.TensorProduct.quotIdealMapEquivTensorQuot (Γ(W, ⊤) : Type u)
      𝔭.asIdeal).toRingEquiv.toCommRingCatIso
  exact ⟨asIso m ≪≫ pullbackSpecIso B Γ(W, ⊤) (B ⧸ 𝔭.asIdeal) ≪≫ asIso (Spec.map ε.hom)⟩

theorem wc_A1_fibre_pullback_spec_poly {N W P Y : Scheme.{u}} (v : W ⟶ N) (g : W ⟶ P)
    (y : Y ⟶ P) (R : Type u) [CommRing R]
    (e : Nonempty (Limits.pullback g y ≅ Spec (.of R))) :
    Nonempty (Limits.pullback (Limits.pullback.fst v (AffineSpace (ULift.{u} (Fin 1)) N ↘ N) ≫ g) y ≅
      Spec (.of (Polynomial R))) :=
by
  obtain ⟨e⟩ := e
  let L := Limits.pullback.fst v (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)
  let a := Limits.pullback.fst g y
  let i1 : Limits.pullback (L ≫ g) y ≅ Limits.pullback L a :=
    (Limits.pullbackRightPullbackFstIso g y L).symm
  let i2 : Limits.pullback L a ≅ Limits.pullback a L := Limits.pullbackSymmetry L a
  let i3 : Limits.pullback a L ≅
      Limits.pullback (a ≫ v) (AffineSpace (ULift.{u} (Fin 1)) N ↘ N) :=
    Limits.pullbackRightPullbackFstIso v (AffineSpace (ULift.{u} (Fin 1)) N ↘ N) a
  let i4 : Limits.pullback (a ≫ v) (AffineSpace (ULift.{u} (Fin 1)) N ↘ N) ≅
      AffineSpace (ULift.{u} (Fin 1)) (Limits.pullback g y) :=
    (AffineSpace.isPullback_map (n := ULift.{u} (Fin 1)) (a ≫ v)).flip.isoPullback.symm
  let i5 : AffineSpace (ULift.{u} (Fin 1)) (Limits.pullback g y) ≅
      AffineSpace (ULift.{u} (Fin 1)) (Spec (.of R)) :=
    { hom := AffineSpace.map (ULift.{u} (Fin 1)) e.hom
      inv := AffineSpace.map (ULift.{u} (Fin 1)) e.inv
      hom_inv_id := by rw [← AffineSpace.map_comp, e.hom_inv_id, AffineSpace.map_id]
      inv_hom_id := by rw [← AffineSpace.map_comp, e.inv_hom_id, AffineSpace.map_id] }
  let i6 : AffineSpace (ULift.{u} (Fin 1)) (Spec (.of R)) ≅
      Spec (.of (MvPolynomial (ULift.{u} (Fin 1)) R)) :=
    AffineSpace.SpecIso (ULift.{u} (Fin 1)) (.of R)
  let φ : Polynomial R ≃+* MvPolynomial (ULift.{u} (Fin 1)) R :=
    (MvPolynomial.uniqueAlgEquiv R (ULift.{u} (Fin 1))).symm.toRingEquiv
  let i7 : Spec (.of (MvPolynomial (ULift.{u} (Fin 1)) R)) ≅ Spec (.of (Polynomial R)) :=
    Scheme.Spec.mapIso (RingEquiv.toCommRingCatIso φ).op
  exact ⟨i1 ≪≫ i2 ≪≫ i3 ≪≫ i4 ≪≫ i5 ≪≫ i6 ≪≫ i7⟩

theorem wc_et_strictHensel_A1_vanish_any_field (K C : Type u) [Field K] [CommRing C] [Algebra K C]
    [HenselianLocalRing C] [IsSepClosed (IsLocalRing.ResidueField C)] (ℓ : ℕ) (hℓ : ℓ.Prime)
    (hℓK : (ℓ : K) ≠ 0) (q : ℕ) (hq : 1 ≤ q) :
    Subsingleton (wcEtCoh (Spec (.of (Polynomial C))) ℓ q) :=
by
  classical

  have s1 : ∃ (k₀ : Type) (_ : Field k₀) (_ : PerfectField k₀), Nonempty (k₀ →+* K) := by
    rcases CharP.char_is_prime_or_zero K (ringChar K) with h | h
    · haveI : Fact (ringChar K).Prime := ⟨h⟩
      exact ⟨ZMod (ringChar K), inferInstance, inferInstance, ⟨ZMod.castHom (dvd_refl _) K⟩⟩
    · haveI : CharZero K := by
        have := ringChar.charP K
        rw [h] at this
        exact CharP.charP_zero_iff_charZero K |>.mp this
      exact ⟨ℚ, inferInstance, inferInstance, ⟨algebraMap ℚ K⟩⟩

  have s2 : ∀ (k₀ : Type) [Field k₀] [Algebra k₀ C],
      ∃ F : Subalgebra k₀ C, (∀ x ∈ F, x ≠ 0 → ∃ y ∈ F, x * y = 1) ∧ (∀ x ∈ F, IsIntegral k₀ x) ∧
        ∀ F' : Subalgebra k₀ C, (∀ x ∈ F', x ≠ 0 → ∃ y ∈ F', x * y = 1) →
          (∀ x ∈ F', IsIntegral k₀ x) → F ≤ F' → F' ≤ F := by
    intro k₀ _ _
    let S : Set (Subalgebra k₀ C) :=
      {F | (∀ x ∈ F, x ≠ 0 → ∃ y ∈ F, x * y = 1) ∧ (∀ x ∈ F, IsIntegral k₀ x)}
    have hbot : (⊥ : Subalgebra k₀ C) ∈ S := by
      refine ⟨?_, ?_⟩
      · intro x hx hx0
        obtain ⟨c, rfl⟩ := Algebra.mem_bot.mp hx
        have hc : c ≠ 0 := by rintro rfl; exact hx0 (map_zero _)
        exact ⟨algebraMap k₀ C c⁻¹, Subalgebra.algebraMap_mem _ _,
          by rw [← map_mul, mul_inv_cancel₀ hc, map_one]⟩
      · intro x hx
        obtain ⟨c, rfl⟩ := Algebra.mem_bot.mp hx
        exact isIntegral_algebraMap
    have hch : ∀ c ⊆ S, IsChain (· ≤ ·) c → ∀ y ∈ c, ∃ ub ∈ S, ∀ z ∈ c, z ≤ ub := by
      intro c hcS hc y hy
      haveI : Nonempty c := ⟨⟨y, hy⟩⟩
      have hdir : Directed (· ≤ ·) (fun F : c => (F : Subalgebra k₀ C)) :=
        hc.directedOn.directed_val
      have hmem : ∀ x, x ∈ (⨆ F : c, (F : Subalgebra k₀ C)) →
          ∃ F : c, x ∈ (F : Subalgebra k₀ C) := by
        intro x hx
        have : x ∈ ((⨆ F : c, (F : Subalgebra k₀ C) : Subalgebra k₀ C) : Set C) := hx
        rw [Subalgebra.coe_iSup_of_directed hdir] at this
        simpa using this
      refine ⟨⨆ F : c, (F : Subalgebra k₀ C), ⟨?_, ?_⟩,
        fun z hz => le_iSup (fun F : c => (F : Subalgebra k₀ C)) ⟨z, hz⟩⟩
      · intro x hx hx0
        obtain ⟨F, hF⟩ := hmem x hx
        obtain ⟨y', hy', hxy⟩ := (hcS F.2).1 x hF hx0
        exact ⟨y', le_iSup (fun F : c => (F : Subalgebra k₀ C)) F hy', hxy⟩
      · intro x hx
        obtain ⟨F, hF⟩ := hmem x hx
        exact (hcS F.2).2 x hF
    obtain ⟨m, -, hm⟩ := zorn_le_nonempty₀ S hch ⊥ hbot
    exact ⟨m, hm.prop.1, hm.prop.2, fun F' h1 h2 hle => hm.le_of_ge ⟨h1, h2⟩ hle⟩

  have s3 : ∀ (R : Type u) [CommRing R] (j : R →+* C) (p : Polynomial R),
      p.Monic → p.Separable → 0 < p.natDegree → ∃ a : C, Polynomial.eval₂ j a p = 0 := by
    intro R _ j p hm hs hd
    set π := IsLocalRing.residue C with hπ
    set f := p.map j with hf
    have hfm : f.Monic := hm.map j
    have hfs : (f.map π).Separable := (hs.map).map
    have hdeg : (f.map π).degree ≠ 0 := by
      intro h0
      have hnd : (f.map π).natDegree = p.natDegree := by
        rw [hfm.natDegree_map, hm.natDegree_map]
      rw [Polynomial.degree_eq_natDegree (hfm.map π).ne_zero, hnd] at h0
      have : p.natDegree = 0 := by exact_mod_cast h0
      omega
    obtain ⟨b, hb⟩ := IsSepClosed.exists_root (f.map π) hdeg hfs
    obtain ⟨a₀, rfl⟩ := IsLocalRing.residue_surjective b
    have h1 : f.eval a₀ ∈ IsLocalRing.maximalIdeal C := by
      rw [← IsLocalRing.residue_eq_zero_iff]
      have := hb
      rw [Polynomial.IsRoot, Polynomial.eval_map, Polynomial.eval₂_hom] at this
      exact this
    have h2 : IsUnit (f.derivative.eval a₀) := by
      rw [← IsLocalRing.residue_ne_zero_iff_isUnit]
      have := hfs.aeval_derivative_ne_zero (x := π a₀) (by
        rw [Polynomial.aeval_def, Algebra.algebraMap_self, Polynomial.eval₂_eq_eval_map,
          Polynomial.map_id]; exact hb)
      rw [Polynomial.aeval_def, Algebra.algebraMap_self, Polynomial.derivative_map,
        Polynomial.eval₂_map, RingHom.id_comp, Polynomial.eval₂_hom] at this
      exact this
    obtain ⟨a, ha, -⟩ := HenselianLocalRing.is_henselian f hfm a₀ h1 h2
    refine ⟨a, ?_⟩
    rw [← Polynomial.eval_map]
    exact ha

  have s4 : ∀ (Ω : Type u) [Field Ω] (j : Ω →+* C) (a : C) (p : Polynomial Ω),
      Irreducible p → Polynomial.eval₂ j a p = 0 → ∀ g : Polynomial Ω,
        Polynomial.eval₂ j a g ≠ 0 →
          ∃ h : Polynomial Ω, Polynomial.eval₂ j a g * Polynomial.eval₂ j a h = 1 := by
    intro Ω _ j a p hp hpa g hg
    have hnd : ¬ p ∣ g := by
      rintro ⟨r, rfl⟩
      exact hg (by rw [Polynomial.eval₂_mul, hpa, zero_mul])
    obtain ⟨u, v, huv⟩ := (hp.coprime_iff_not_dvd).mpr hnd
    refine ⟨v, ?_⟩
    have := congrArg (Polynomial.eval₂ j a) huv
    rw [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_mul, hpa, mul_zero,
      zero_add, Polynomial.eval₂_one] at this
    rw [mul_comm]; exact this

  have s5 : ∀ (k₀ : Type) [CommRing k₀] [Algebra k₀ C] (Ω : Type u) [CommRing Ω] (j : Ω →+* C),
      (∀ x : Ω, IsIntegral k₀ (j x)) → ∀ (a : C) (p : Polynomial Ω), p.Monic →
        Polynomial.eval₂ j a p = 0 → ∀ g : Polynomial Ω,
          IsIntegral k₀ (Polynomial.eval₂ j a g) := by
    intro k₀ _ _ Ω _ j hj a p hm hpa g
    set A := integralClosure k₀ C
    let j' : Ω →+* A := j.codRestrict A.toSubsemiring (fun x => hj x)
    have hjj : (algebraMap A C).comp j' = j := by ext x; rfl
    have haA : IsIntegral A a := by
      refine ⟨p.map j', hm.map j', ?_⟩
      rw [Polynomial.eval₂_map, hjj, hpa]
    have hak : IsIntegral k₀ a := isIntegral_trans a haA
    have haA' : a ∈ A := hak
    have key := Polynomial.hom_eval₂ g j' (algebraMap A C) ⟨a, haA'⟩
    rw [hjj] at key
    have hmem : Polynomial.eval₂ j a g ∈ A := by
      have e : Polynomial.eval₂ j a g = algebraMap A C (Polynomial.eval₂ j' ⟨a, haA'⟩ g) := by
        rw [key]; rfl
      rw [e]
      exact (Polynomial.eval₂ j' ⟨a, haA'⟩ g).2
    exact hmem

  have s6 : ∀ (k₀ : Type) [Field k₀] [PerfectField k₀] [Algebra k₀ C] (F : Subalgebra k₀ C),
      IsField F → (∀ x ∈ F, IsIntegral k₀ x) →
      (∀ F' : Subalgebra k₀ C, (∀ x ∈ F', x ≠ 0 → ∃ y ∈ F', x * y = 1) →
        (∀ x ∈ F', IsIntegral k₀ x) → F ≤ F' → F' ≤ F) →
      ∃ (Ω : Type u) (_ : Field Ω) (_ : IsAlgClosed Ω), Nonempty (Ω →+* C) := by
    intro k₀ _ _ _ F hF hInt hMax
    letI : Field F := hF.toField
    have hHen : ∀ p : Polynomial F, p.Monic → p.Separable → 0 < p.natDegree →
        ∃ a : C, Polynomial.eval₂ (F.val : F →+* C) a p = 0 :=
      fun p => s3 F (F.val : F →+* C) p
    have hInv : ∀ (a : C) (p : Polynomial F), Irreducible p →
        Polynomial.eval₂ (F.val : F →+* C) a p = 0 →
        ∀ g : Polynomial F, Polynomial.eval₂ (F.val : F →+* C) a g ≠ 0 →
          ∃ h : Polynomial F, Polynomial.eval₂ (F.val : F →+* C) a g *
            Polynomial.eval₂ (F.val : F →+* C) a h = 1 :=
      fun a p hp hpa g hg => s4 F (F.val : F →+* C) a p hp hpa g hg
    have hIntAdj : ∀ (a : C) (p : Polynomial F), p.Monic →
        Polynomial.eval₂ (F.val : F →+* C) a p = 0 →
        ∀ g : Polynomial F, IsIntegral k₀ (Polynomial.eval₂ (F.val : F →+* C) a g) :=
      fun a p hm hpa g => s5 k₀ F (F.val : F →+* C) (fun x => hInt x x.2) a p hm hpa g
    haveI : Algebra.IsIntegral k₀ F := ⟨fun x =>
      (isIntegral_algHom_iff F.val Subtype.val_injective).mp (hInt x x.2)⟩
    haveI : PerfectField F := Algebra.IsAlgebraic.perfectField (K := k₀)
    haveI : IsAlgClosed F := by
      apply IsAlgClosed.of_exists_root
      intro p hpm hpirr
      have hsep : p.Separable := PerfectField.separable_of_irreducible hpirr
      have hdeg : 0 < p.natDegree :=
        Polynomial.natDegree_pos_iff_degree_pos.mpr (Polynomial.degree_pos_of_irreducible hpirr)
      obtain ⟨a, ha⟩ := hHen p hpm hsep hdeg
      let F' : Subalgebra k₀ C :=
        { toSubsemiring := (Polynomial.eval₂RingHom (F.val : F →+* C) a).rangeS
          algebraMap_mem' := fun r => ⟨Polynomial.C (algebraMap k₀ F r), by simp⟩ }
      have hmemF' : ∀ x, x ∈ F' ↔
          ∃ g : Polynomial F, Polynomial.eval₂ (F.val : F →+* C) a g = x := by
        intro x
        show x ∈ (Polynomial.eval₂RingHom (F.val : F →+* C) a).rangeS ↔ _
        rw [RingHom.mem_rangeS]
        rfl
      have hle : F ≤ F' := by
        intro x hx
        rw [hmemF']
        exact ⟨Polynomial.C ⟨x, hx⟩, by rw [Polynomial.eval₂_C]; rfl⟩
      have hF'le := hMax F' (by
          intro x hx hx0
          obtain ⟨g, rfl⟩ := (hmemF' x).mp hx
          obtain ⟨h, hh⟩ := hInv a p hpirr ha g hx0
          exact ⟨_, (hmemF' _).mpr ⟨h, rfl⟩, hh⟩)
        (by
          intro x hx
          obtain ⟨g, rfl⟩ := (hmemF' x).mp hx
          exact hIntAdj a p hpm ha g) hle
      have haF : a ∈ F := hF'le ((hmemF' a).mpr ⟨Polynomial.X, Polynomial.eval₂_X _ _⟩)
      refine ⟨⟨a, haF⟩, ?_⟩
      apply Subtype.val_injective
      have := Polynomial.hom_eval₂ p (RingHom.id F) (F.val : F →+* C) ⟨a, haF⟩
      rw [RingHom.comp_id] at this
      show (F.val : F →+* C) (Polynomial.eval₂ (RingHom.id F) ⟨a, haF⟩ p) = (F.val : F →+* C) 0
      rw [map_zero]
      exact this.trans ha
    exact ⟨F, hF.toField, inferInstance, ⟨(F.val : F →+* C)⟩⟩

  obtain ⟨k₀, _, _, ⟨κ⟩⟩ := s1
  letI : Algebra k₀ C := ((algebraMap K C).comp κ).toAlgebra
  obtain ⟨F, hFinv, hFint, hFmax⟩ := s2 k₀
  have hF : IsField F := by
    refine ⟨⟨0, 1, fun h => zero_ne_one (congrArg Subtype.val h)⟩, fun a b => mul_comm a b, ?_⟩
    intro a ha
    have ha' : (a : C) ≠ 0 := fun h => ha (Subtype.ext h)
    obtain ⟨y, hy, hay⟩ := hFinv a a.2 ha'
    exact ⟨⟨y, hy⟩, Subtype.ext hay⟩
  obtain ⟨Ω, _, _, ⟨ι⟩⟩ := s6 k₀ F hF hFint hFmax

  have hℓΩ : (ℓ : Ω) ≠ 0 := by
    intro h0
    have h1 : (ℓ : C) = 0 := by rw [← map_natCast ι, h0, map_zero]
    have h2 : algebraMap K C (ℓ : K) = 0 := by rw [map_natCast]; exact h1
    exact hℓK ((algebraMap K C).injective (h2.trans (map_zero _).symm))

  haveI hsub := wc_et_henselian_affine_line_acyclic Ω ℓ hℓ hℓΩ C
    (Spec.map (CommRingCat.ofHom ι)) q hq

  letI : Algebra Ω C := ι.toAlgebra
  let e : Limits.pullback (Spec.map (CommRingCat.ofHom ι))
      (Spec.map (CommRingCat.ofHom (algebraMap Ω (Polynomial Ω)))) ≅ Spec (.of (Polynomial C)) :=
    pullbackSpecIso Ω C (Polynomial Ω) ≪≫
      Scheme.Spec.mapIso ((polyEquivTensor Ω C).toRingEquiv.toCommRingCatIso).op
  obtain ⟨E⟩ := wc_et_coh_iso_invariance e.hom ℓ q
  exact E.subsingleton

theorem wc_et_coh_zmod_prime_pow_of_prime (Y : Scheme.{u}) (ℓ : ℕ) (hℓ : ℓ.Prime) (j : ℕ)
    (h : Subsingleton (wcEtCoh Y ℓ j)) (n : ℕ) :
    Subsingleton (wcEtCoh Y (ℓ ^ (n + 1)) j) :=
by
  classical
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _

  have hmid : ∀ (X : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})), S.ShortExact →
      ∀ m : ℕ, Subsingleton (Abelian.Ext X S.X₁ m) → Subsingleton (Abelian.Ext X S.X₃ m) →
        Subsingleton (Abelian.Ext X S.X₂ m) := by
    intro X S hS m h1 h3
    let ψ : Abelian.Ext X S.X₂ m →+ Abelian.Ext X S.X₃ m :=
      (Abelian.Ext.mk₀ S.g).postcomp X (add_zero m)
    let φ : Abelian.Ext X S.X₁ m →+ Abelian.Ext X S.X₂ m :=
      (Abelian.Ext.mk₀ S.f).postcomp X (add_zero m)
    have hex : ∀ b, ψ b = 0 → ∃ a, φ a = b := fun b hb =>
      Abelian.Ext.covariant_sequence_exact₂ X hS b hb
    have hz : ∀ b : Abelian.Ext X S.X₂ m, b = 0 := by
      intro b
      obtain ⟨a, ha⟩ := hex b (Subsingleton.elim _ _)
      rw [← ha, Subsingleton.elim a 0, map_zero]
    exact ⟨fun a b => by rw [hz a, hz b]⟩

  have hses : ∀ (p k : ℕ), p ≠ 0 →
      ∃ (f : AddCommGrpCat.of (ULift.{u+1} (ZMod k)) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))))
        (g : AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod p)))
        (hw : f ≫ g = 0), (ShortComplex.mk f g hw).ShortExact := by
    intro p k hp
    have hk0 : (zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k))) (k : ℤ) = 0 := by
      rw [zmultiplesHom_apply, zsmul_eq_mul, Int.cast_natCast, ← Nat.cast_mul, mul_comm,
        ZMod.natCast_self]
    let α : ZMod k →+ ZMod (p * k) :=
      ZMod.lift k ⟨zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k)), hk0⟩
    have hα : ∀ z : ℤ, α (z : ZMod k) = ((z * p : ℤ) : ZMod (p * k)) := by
      intro z
      show (ZMod.lift k ⟨zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k)), hk0⟩) (z : ZMod k) = _
      rw [ZMod.lift_coe]
      change z • (p : ZMod (p * k)) = _
      rw [zsmul_eq_mul]
      push_cast
      ring
    let β : ZMod (p * k) →+ ZMod p := (ZMod.castHom (dvd_mul_right p k) (ZMod p)).toAddMonoidHom
    have hβ : ∀ z : ℤ, β (z : ZMod (p * k)) = (z : ZMod p) := fun z =>
      map_intCast (ZMod.castHom (dvd_mul_right p k) (ZMod p)) z
    have hαinj : Function.Injective α := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
      rw [hα, ZMod.intCast_zmod_eq_zero_iff_dvd] at hx
      rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
      have hp' : (p : ℤ) ≠ 0 := by exact_mod_cast hp
      push_cast at hx
      rw [mul_comm z] at hx
      exact (mul_dvd_mul_iff_left hp').mp hx
    have hβsurj : Function.Surjective β := by
      intro y
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
      exact ⟨(z : ZMod (p * k)), hβ z⟩
    have hβα : ∀ x, β (α x) = 0 := by
      intro x
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
      rw [hα, hβ]
      push_cast
      rw [ZMod.natCast_self, mul_zero]
    have hker : ∀ y, β y = 0 → ∃ x, α x = y := by
      intro y hy
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
      rw [hβ, ZMod.intCast_zmod_eq_zero_iff_dvd] at hy
      obtain ⟨t, rfl⟩ := hy
      refine ⟨(t : ZMod k), ?_⟩
      rw [hα]
      congr 1
      ring
    let f : AddCommGrpCat.of (ULift.{u+1} (ZMod k)) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) :=
      AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp α).comp
        AddEquiv.ulift.toAddMonoidHom)
    let g : AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod p)) :=
      AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp β).comp
        AddEquiv.ulift.toAddMonoidHom)
    have hw : f ≫ g = 0 := by
      ext x
      exact hβα x.down
    refine ⟨f, g, hw, ShortComplex.ShortExact.mk' ?_ ?_ ?_⟩
    · rw [ShortComplex.ab_exact_iff]
      intro x₂ hx₂
      obtain ⟨x₁, hx₁⟩ := hker x₂.down (congrArg ULift.down hx₂)
      exact ⟨ULift.up x₁, congrArg ULift.up hx₁⟩
    · rw [AddCommGrpCat.mono_iff_injective]
      intro a b hab
      exact ULift.ext _ _ (hαinj (congrArg ULift.down hab))
    · rw [AddCommGrpCat.epi_iff_surjective]
      intro y
      obtain ⟨x, hx⟩ := hβsurj y.down
      exact ⟨ULift.up x, congrArg ULift.up hx⟩

  haveI : Limits.PreservesFiniteLimits
      (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
    Limits.comp_preservesFiniteLimits (Functor.const (Scheme.Etale Y)ᵒᵖ)
      (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})

  induction n with
  | zero =>
    rw [zero_add, pow_one]
    exact h
  | succ n IH =>
    rw [pow_succ' ℓ (n + 1)]
    obtain ⟨f, g, hw, hS₀⟩ := hses ℓ (ℓ ^ (n + 1)) hℓ.ne_zero
    have hS := hS₀.map_of_exact (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
    exact hmid _ _ hS j IH h

theorem wc_et_A1_wstrictly_local_vanish (K : Type u) [Field K] {N : Scheme.{u}} (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (hℓK : (ℓ : K) ≠ 0) (qN : N ⟶ Spec (.of K)) (V : N.ProEt)
    (hV : IsAffine V.left ∧ IsClosed {x : V.left | IsClosed ({x} : Set V.left)} ∧
      (∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y) ∧
      ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)} ∧
      (∀ x : V.left, IsClosed ({x} : Set V.left) →
        HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x)))
    (k q : ℕ) (hq : 1 ≤ q) :
    Subsingleton (wcEtCoh ((wcProEtBC (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)).obj V).left
      (ℓ ^ (k + 1)) q) :=
by
  classical
  haveI hWA : IsAffine V.left := hV.1
  first
    | change Subsingleton (wcEtCoh
        (Limits.pullback V.hom (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)) (ℓ ^ (k + 1)) q)
    | (unfold wcProEtBC
       erw [MorphismProperty.Over.pullback_obj_left])
    | (unfold wcProEtBC
       simp only [MorphismProperty.Over.pullback_obj_left])
  have hAffKey : ∀ (W : Scheme.{u}) (_ : IsAffine W) (v : W ⟶ N),
      IsAffine (Limits.pullback v (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)) :=
    fun W hW v => inferInstance
  haveI hXA : IsAffine (Limits.pullback V.hom (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)) :=
    hAffKey _ hV.1 V.hom

  letI : Algebra K Γ(V.left, ⊤) :=
    ((Scheme.ΓSpecIso (.of K)).inv ≫ (V.hom ≫ qN).appTop).hom.toAlgebra

  obtain ⟨hcl, huniq, -⟩ := wc_wl_conditions_homeomorph V.left (Spec Γ(V.left, ⊤))
    (Scheme.Hom.homeomorph V.left.isoSpec.hom) hV.2.1 hV.2.2.1 hV.2.2.2.1
  have hsh := wc_affine_closedPt_strictHensel V.left hV.2.2.2.2

  have hBv := wc_idem_adjoin_vnr K Γ(V.left, ⊤)

  have htr : ∀ {S T : Type u} [CommRing S] [CommRing T] (ε : S ≃+* T),
      (∀ f : T, ∃ t : T, f * f * t = f) → ∀ f : S, ∃ t : S, f * f * t = f := by
    intro S T _ _ ε hT f
    obtain ⟨t₀, ht₀⟩ := hT (ε f)
    refine ⟨ε.symm t₀, ε.injective ?_⟩
    rw [map_mul, map_mul, RingEquiv.apply_symm_apply]
    exact ht₀
  have hP : ∀ f : Γ(Spec (.of (Algebra.adjoin K {e : Γ(V.left, ⊤) | IsIdempotentElem e})), ⊤),
      ∃ t : Γ(Spec (.of (Algebra.adjoin K {e : Γ(V.left, ⊤) | IsIdempotentElem e})), ⊤),
        f * f * t = f :=
    htr (Scheme.ΓSpecIso
      (.of (Algebra.adjoin K {e : Γ(V.left, ⊤) | IsIdempotentElem e}))).commRingCatIsoToRingEquiv hBv

  have hfib : ∀ j : ℕ, 1 ≤ j →
      ∀ p₀ : Spec (.of (Algebra.adjoin K {e : Γ(V.left, ⊤) | IsIdempotentElem e})),
      Subsingleton (wcEtCoh (Limits.pullback
        (Limits.pullback.fst V.hom (AffineSpace (ULift.{u} (Fin 1)) N ↘ N) ≫
          (V.left.toSpecΓ ≫ Spec.map (CommRingCat.ofHom
            (algebraMap (Algebra.adjoin K {e : Γ(V.left, ⊤) | IsIdempotentElem e}) Γ(V.left, ⊤)))))
        ((Spec (.of (Algebra.adjoin K {e : Γ(V.left, ⊤) | IsIdempotentElem e}))).fromSpecResidueField
          p₀)) ℓ j) := by
    intro j hj p₀
    have e1 := wc_affine_vnr_spec_fibre_iso V.left
      (Algebra.adjoin K {e : Γ(V.left, ⊤) | IsIdempotentElem e})
      (algebraMap (Algebra.adjoin K {e : Γ(V.left, ⊤) | IsIdempotentElem e}) Γ(V.left, ⊤)) hBv p₀
    obtain ⟨e2⟩ := wc_A1_fibre_pullback_spec_poly V.hom _ _ _ e1
    obtain ⟨hH, hS⟩ := wc_wl_idem_fibre_strictHensel K Γ(V.left, ⊤) hBv hcl huniq hsh
      p₀.asIdeal p₀.isPrime
    have hA1 := @wc_et_strictHensel_A1_vanish_any_field K _ _ _ _ hH hS ℓ Fact.out hℓK j hj
    obtain ⟨E⟩ := wc_et_coh_iso_invariance e2.hom ℓ j
    exact E.symm.subsingleton

  have hglob : Subsingleton (wcEtCoh
      (Limits.pullback V.hom (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)) ℓ q) :=
    wc_et_coh_vanish_of_vnr_fibres _ _ _ hP ℓ q hq (hfib q hq)

  exact wc_et_coh_zmod_prime_pow_of_prime _ ℓ Fact.out q hglob k

theorem wc_A1_proj_higher_vanish_gen (K : Type u) [Field K] {N : Scheme.{u}} (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (hℓK : (ℓ : K) ≠ 0) (qN : N ⟶ Spec (.of K))
    (Dp : wcHMPullData (AffineSpace (ULift.{u} (Fin 1)) N ↘ N) ℓ) (hDp : wcHMPullCanonical Dp)
    (I : InjectiveResolution
      (SheafOfModules.unit (wcRingSheaf (AffineSpace (ULift.{u} (Fin 1)) N) ℓ)))
    (q : ℕ) (hq : 1 ≤ q) :
    letI : (@SheafOfModules.pushforward _ _ _ _ _ _
        (wcProEtBC (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)) _ _ Dp.cont Dp.φ).Additive :=
      @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ Dp.adj Dp.additive
    Limits.IsZero ((((@SheafOfModules.pushforward _ _ _ _ _ _
        (wcProEtBC (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)) _ _ Dp.cont Dp.φ).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj I.cocomplex).homology q) :=
by
  classical
  letI : (@SheafOfModules.pushforward _ _ _ _ _ _
      (wcProEtBC (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)) _ _ Dp.cont Dp.φ).Additive :=
    @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ Dp.adj Dp.additive
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (AffineSpace (ULift.{u} (Fin 1)) N) ℓ)) :=
    HasExt.standard _
  haveI := Dp.cont

  obtain ⟨j, rfl⟩ : ∃ j, q = j + 1 := ⟨q - 1, by omega⟩

  have hvan : ∀ W' : N.ProEt,
      (IsAffine W'.left ∧ IsClosed {x : W'.left | IsClosed ({x} : Set W'.left)} ∧
        (∀ x : W'.left, ∃! y : W'.left, IsClosed ({y} : Set W'.left) ∧ x ⤳ y) ∧
        ExtremallyDisconnected {x : W'.left | IsClosed ({x} : Set W'.left)} ∧
        (∀ x : W'.left, IsClosed ({x} : Set W'.left) →
          HenselianLocalRing (W'.left.presheaf.stalk x) ∧ IsSepClosed (W'.left.residueField x))) →
      ∀ x : wcHM ((wcProEtBC (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)).obj W').left ℓ (j + 1),
        x = 0 := by
    intro W' hV
    haveI : IsAffine W'.left := hV.1
    have hYA : IsAffine ((wcProEtBC (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)).obj W').left := by
      first
        | exact (inferInstance :
            IsAffine (Limits.pullback W'.hom (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)))
        | (unfold wcProEtBC
           erw [MorphismProperty.Over.pullback_obj_left]
           infer_instance)
        | (unfold wcProEtBC
           simp only [MorphismProperty.Over.pullback_obj_left]
           infer_instance)
        | (unfold wcProEtBC
           dsimp only [MorphismProperty.Over.pullback]
           infer_instance)
    have h4 : ∀ k j' : ℕ, Subsingleton (wcEtCoh
        ((wcProEtBC (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)).obj W').left (ℓ ^ (k + 1)) (j' + 1)) :=
      fun k j' => wc_et_A1_wstrictly_local_vanish K ℓ hℓK qN W' hV k (j' + 1) (by omega)
    generalize ((wcProEtBC (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)).obj W').left = Y at h4 hYA ⊢
    haveI := hYA
    have h3 := fun k j' => wc_proet_zmod_ext_vanish_of_et Y (ℓ ^ (k + 1)) j' (h4 k j')
    have h2 := wc_proet_int_ext_vanish_of_zmod Y ℓ (Scheme.ProEt.mk (𝟙 Y)) h3 j
    exact wc_hm_vanish_of_int_ext_vanish Y ℓ j h2

  refine (fun key => ?_) (pushforward_homology_local_basis
    (wcProEtBC (AffineSpace (ULift.{u} (Fin 1)) N ↘ N))
    (wcRingSheaf N ℓ) (wcRingSheaf (AffineSpace (ULift.{u} (Fin 1)) N) ℓ)
    Dp.φ I.cocomplex (j + 1) 0 (fun a => a.elim0) (fun a => a.elim0) ?_ ?_)
  · obtain ⟨ι, hinj, hloc⟩ := key
    obtain ⟨ρ, -, hsum⟩ := sheafOfModules_split_of_local_basis _ _ 0 ι hinj hloc
    rw [Fin.sum_univ_zero] at hsum
    exact (Limits.IsZero.iff_id_eq_zero _).2 hsum.symm
  ·
    intro W s hs
    have hcov := wc_proet_cover_of_affine_local
      (fun Δ : Scheme.{u} => IsClosed {x : Δ | IsClosed ({x} : Set Δ)} ∧
        (∀ x : Δ, ∃! y : Δ, IsClosed ({y} : Set Δ) ∧ x ⤳ y) ∧
        ExtremallyDisconnected {x : Δ | IsClosed ({x} : Set Δ)} ∧
        (∀ x : Δ, IsClosed ({x} : Set Δ) →
          HenselianLocalRing (Δ.presheaf.stalk x) ∧ IsSepClosed (Δ.residueField x)))
      (fun V hV => by
        obtain ⟨Δ, δ, h1, h2, h3, h4, h5, h6, h7⟩ := wc_exists_wcontractible_cover V hV
        exact ⟨Δ, δ, h1, h2, h3, h4, h5, h6, h7⟩) W
    refine (Scheme.ProEt.topology N).superset_covering ((Sieve.generate_le_iff _ _).2 ?_) hcov
    intro W' g hg
    obtain ⟨hA, hQW⟩ := hg
    refine ⟨W', 𝟙 _, g, ?_, Category.id_comp g⟩
    have hds' : ((I.cocomplex.d (j + 1) (j + 1 + 1)).val.app
        (Opposite.op ((wcProEtBC (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)).obj W'))).hom
        (((I.cocomplex.X (j + 1)).val.map
          ((wcProEtBC (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)).map g).op).hom s) = 0 := by
      erw [PresheafOfModules.naturality_apply, hs, map_zero]
      all_goals rfl
    obtain ⟨P, ev, hnat, hevadd⟩ := sheafOfModules_free_yoneda
      (Scheme.ProEt.topology (AffineSpace (ULift.{u} (Fin 1)) N))
      (wcRingSheaf (AffineSpace (ULift.{u} (Fin 1)) N) ℓ)
      ((wcProEtBC (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)).obj W')
    have hev0 : ∀ M, ev M 0 = 0 := fun M => by
      have h := hevadd M 0 0
      rw [add_zero] at h
      exact add_left_cancel (h.symm.trans (add_zero _).symm)
    obtain ⟨fP, hfPdef⟩ : ∃ fP : P ⟶ I.cocomplex.X (j + 1), ev _ fP =
        ((I.cocomplex.X (j + 1)).val.map
          ((wcProEtBC (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)).map g).op).hom s :=
      ⟨(ev _).symm _, Equiv.apply_symm_apply _ _⟩
    have hfP : fP ≫ I.cocomplex.d (j + 1) (j + 1 + 1) = 0 := by
      apply (ev _).injective
      rw [hnat, hfPdef, hds', hev0]
    obtain ⟨DV, hDV⟩ := wc_hm_pull_data_exists
      ((wcProEtBC (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)).obj W').hom ℓ
    obtain ⟨Θ, -⟩ := wc_proet_free_slice_module_ext (AffineSpace (ULift.{u} (Fin 1)) N) ℓ
      ((wcProEtBC (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)).obj W') P ev hnat hevadd DV hDV (j + 1)
    have hext0 : I.extMk fP (j + 1 + 1) rfl hfP = 0 := by
      apply Θ.injective
      rw [map_zero]
      exact hvan W' ⟨hA, hQW⟩ _
    obtain ⟨κ, hκ⟩ := injectiveResolution_coboundary_of_extMk_eq_sum I (j + 1) 0 fP hfP
      (fun a => a.elim0) (fun a => a.elim0) (by rw [hext0]; simp)
    refine ⟨fun a => a.elim0, ev _ κ, ?_⟩
    rw [Fin.sum_univ_zero, zero_add, ← hnat, ← hfPdef, hκ, Fin.sum_univ_zero, zero_add]
  ·
    intro W c y _
    refine (Scheme.ProEt.topology N).superset_covering ?_ ((Scheme.ProEt.topology N).top_mem W)
    intro W' g _
    exact ⟨W', 𝟙 _, g, fun a => a.elim0, Category.id_comp g⟩

theorem wc_hm_affine_space_pull_surj (K : Type u) [Field K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hℓK : (ℓ : K) ≠ 0) {U : Scheme.{u}} (qU : U ⟶ Spec (.of K))
    [IsLocallyNoetherian U] [CompactSpace U] (d : ℕ)
    (Dp : wcHMPullData (AffineSpace (ULift.{u} (Fin d)) U ↘ U) ℓ) (hDp : wcHMPullCanonical Dp)
    (n : ℕ) : Function.Surjective (wcHMPull Dp n) :=
by
  classical

  have L2 : ∀ {S S' : Scheme.{u}} (f : S' ⟶ S) [IsIso f] (D : wcHMPullData f ℓ)
      (_ : wcHMPullCanonical D) (m : ℕ), Function.Bijective (wcHMPull D m) := by
    intro S S' f _ D hD m
    obtain ⟨Dh, hDh⟩ := wc_hm_pull_data_exists (inv f) ℓ
    obtain ⟨D1, hD1⟩ := wc_hm_pull_data_exists (𝟙 S) ℓ
    obtain ⟨D1', hD1'⟩ := wc_hm_pull_data_exists (𝟙 S') ℓ
    constructor
    · intro x x' hxx
      have e1 := wc_hm_pull_comp f (inv f) (𝟙 S) (IsIso.inv_hom_id f) D hD Dh hDh D1 hD1 m x
      have e2 := wc_hm_pull_comp f (inv f) (𝟙 S) (IsIso.inv_hom_id f) D hD Dh hDh D1 hD1 m x'
      rw [wc_hm_pull_id (𝟙 S) rfl D1 hD1] at e1 e2
      calc x = wcHMPull Dh m (wcHMPull D m x) := e1
        _ = wcHMPull Dh m (wcHMPull D m x') := by rw [hxx]
        _ = x' := e2.symm
    · intro y
      refine ⟨wcHMPull Dh m y, ?_⟩
      have e := wc_hm_pull_comp (inv f) f (𝟙 S') (IsIso.hom_inv_id f) Dh hDh D hD D1' hD1' m y
      rw [wc_hm_pull_id (𝟙 S') rfl D1' hD1'] at e
      exact e.symm

  have s1 : ∀ {N : Scheme.{u}} (qN : N ⟶ Spec (.of K))
      (Dπ : wcHMPullData (AffineSpace (ULift.{u} (Fin 1)) N ↘ N) ℓ) (_ : wcHMPullCanonical Dπ)
      (m : ℕ), Function.Bijective (wcHMPull Dπ m) := by
    intro N qN Dπ hDπ m
    haveI := Dπ.additive
    haveI := Dπ.presLim
    haveI := Dπ.presColim
    letI : (@SheafOfModules.pushforward _ _ _ _ _ _
        (wcProEtBC (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)) _ _ Dπ.cont Dπ.φ).Additive :=
      @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ Dπ.adj Dπ.additive
    have hunit : IsIso (Dπ.adj.unit.app (SheafOfModules.unit (wcRingSheaf N ℓ))) := by
      have h : IsIso (wcSuppUnitMap Dπ) := wc_A1_proj_supp_unit_iso ℓ Dπ hDπ
      exact @IsIso.of_isIso_comp_right _ _ _ _ _
        (Dπ.adj.unit.app (SheafOfModules.unit (wcRingSheaf N ℓ)))
        ((@SheafOfModules.pushforward _ _ _ _ _ _
          (wcProEtBC (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)) _ _ Dπ.cont Dπ.φ).map Dπ.μ.hom)
        inferInstance h
    haveI := sheafOfModules_enoughInjectives
      (Scheme.ProEt.topology (AffineSpace (ULift.{u} (Fin 1)) N))
      (wcRingSheaf (AffineSpace (ULift.{u} (Fin 1)) N) ℓ)
    have key := wc_ext_map_bijective_of_degenerate_leray Dπ.Φ
      (@SheafOfModules.pushforward _ _ _ _ _ _
        (wcProEtBC (AffineSpace (ULift.{u} (Fin 1)) N ↘ N)) _ _ Dπ.cont Dπ.φ)
      Dπ.adj (SheafOfModules.unit (wcRingSheaf N ℓ)) _ Dπ.μ hunit
      (InjectiveResolution.of _)
      (fun q hq => wc_A1_proj_higher_vanish_gen K ℓ hℓK qN Dπ hDπ _ q hq) m
    exact key

  have hcomp : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (x : Γ(Z, ⊤)),
      ConcreteCategory.hom (Scheme.Hom.appTop (f ≫ g)) x =
        ConcreteCategory.hom (Scheme.Hom.appTop f) (ConcreteCategory.hom (Scheme.Hom.appTop g) x) := by
    intro X Y Z f g x
    rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply]
  have hid : ∀ {X : Scheme.{u}} (x : Γ(X, ⊤)),
      ConcreteCategory.hom (Scheme.Hom.appTop (𝟙 X)) x = x := by
    intro X x
    rw [Scheme.Hom.id_appTop]
    rfl
  have L3 : ∀ c : ℕ, ∃ e : AffineSpace (ULift.{u} (Fin (c + 1))) U ⟶
        AffineSpace (ULift.{u} (Fin 1)) (AffineSpace (ULift.{u} (Fin c)) U),
      IsIso e ∧ e ≫ (AffineSpace (ULift.{u} (Fin 1)) (AffineSpace (ULift.{u} (Fin c)) U) ↘
            AffineSpace (ULift.{u} (Fin c)) U) ≫ (AffineSpace (ULift.{u} (Fin c)) U ↘ U) =
        AffineSpace (ULift.{u} (Fin (c + 1))) U ↘ U := by
    intro c
    obtain ⟨q, hq_over, hq_coord⟩ : ∃ q : AffineSpace (ULift.{u} (Fin (c + 1))) U ⟶
        AffineSpace (ULift.{u} (Fin c)) U,
        q ≫ (AffineSpace (ULift.{u} (Fin c)) U ↘ U) = AffineSpace (ULift.{u} (Fin (c + 1))) U ↘ U ∧
        ∀ j : Fin c, ConcreteCategory.hom (Scheme.Hom.appTop q) (AffineSpace.coord U ⟨j⟩) =
          AffineSpace.coord U ⟨j.castSucc⟩ :=
      ⟨AffineSpace.homOfVector (AffineSpace (ULift.{u} (Fin (c + 1))) U ↘ U)
          (fun j : ULift.{u} (Fin c) => AffineSpace.coord U ⟨j.down.castSucc⟩),
        AffineSpace.homOfVector_over _ _, fun j => AffineSpace.homOfVector_appTop_coord _ _ _⟩
    obtain ⟨e, he_over, he_coord⟩ : ∃ e : AffineSpace (ULift.{u} (Fin (c + 1))) U ⟶
        AffineSpace (ULift.{u} (Fin 1)) (AffineSpace (ULift.{u} (Fin c)) U),
        e ≫ (AffineSpace (ULift.{u} (Fin 1)) (AffineSpace (ULift.{u} (Fin c)) U) ↘
            AffineSpace (ULift.{u} (Fin c)) U) = q ∧
        ∀ i : ULift.{u} (Fin 1), ConcreteCategory.hom (Scheme.Hom.appTop e)
            (AffineSpace.coord (AffineSpace (ULift.{u} (Fin c)) U) i) =
          AffineSpace.coord U ⟨Fin.last c⟩ :=
      ⟨AffineSpace.homOfVector q (fun _ : ULift.{u} (Fin 1) => AffineSpace.coord U ⟨Fin.last c⟩),
        AffineSpace.homOfVector_over _ _, fun i => AffineSpace.homOfVector_appTop_coord _ _ _⟩
    obtain ⟨v, hv_last, hv_cast⟩ : ∃ v : ULift.{u} (Fin (c + 1)) →
        Γ(AffineSpace (ULift.{u} (Fin 1)) (AffineSpace (ULift.{u} (Fin c)) U), ⊤),
        v ⟨Fin.last c⟩ = AffineSpace.coord (AffineSpace (ULift.{u} (Fin c)) U) ⟨0⟩ ∧
        ∀ j : Fin c, v ⟨j.castSucc⟩ = ConcreteCategory.hom (Scheme.Hom.appTop
            (AffineSpace (ULift.{u} (Fin 1)) (AffineSpace (ULift.{u} (Fin c)) U) ↘
              AffineSpace (ULift.{u} (Fin c)) U)) (AffineSpace.coord U ⟨j⟩) :=
      ⟨fun i => Fin.lastCases
          (motive := fun _ => Γ(AffineSpace (ULift.{u} (Fin 1)) (AffineSpace (ULift.{u} (Fin c)) U), ⊤))
          (AffineSpace.coord (AffineSpace (ULift.{u} (Fin c)) U) ⟨0⟩)
          (fun j => ConcreteCategory.hom (Scheme.Hom.appTop
            (AffineSpace (ULift.{u} (Fin 1)) (AffineSpace (ULift.{u} (Fin c)) U) ↘
              AffineSpace (ULift.{u} (Fin c)) U)) (AffineSpace.coord U ⟨j⟩)) i.down,
        Fin.lastCases_last, fun j => Fin.lastCases_castSucc j⟩
    obtain ⟨e', he'_over, he'_coord⟩ : ∃ e' : AffineSpace (ULift.{u} (Fin 1))
        (AffineSpace (ULift.{u} (Fin c)) U) ⟶ AffineSpace (ULift.{u} (Fin (c + 1))) U,
        e' ≫ (AffineSpace (ULift.{u} (Fin (c + 1))) U ↘ U) =
          (AffineSpace (ULift.{u} (Fin 1)) (AffineSpace (ULift.{u} (Fin c)) U) ↘
            AffineSpace (ULift.{u} (Fin c)) U) ≫ (AffineSpace (ULift.{u} (Fin c)) U ↘ U) ∧
        ∀ i : ULift.{u} (Fin (c + 1)),
          ConcreteCategory.hom (Scheme.Hom.appTop e') (AffineSpace.coord U i) = v i :=
      ⟨AffineSpace.homOfVector _ v, AffineSpace.homOfVector_over _ _,
        fun i => AffineSpace.homOfVector_appTop_coord _ _ _⟩
    have h1 : e ≫ e' = 𝟙 _ := by
      apply AffineSpace.hom_ext
      · rw [Category.assoc, he'_over, ← Category.assoc, he_over, hq_over, Category.id_comp]
      · rintro ⟨i⟩
        rw [hcomp, hid, he'_coord]
        induction i using Fin.lastCases with
        | last => rw [hv_last, he_coord]
        | cast j => rw [hv_cast, ← hcomp, he_over, hq_coord]
    have h2 : e' ≫ q = AffineSpace (ULift.{u} (Fin 1)) (AffineSpace (ULift.{u} (Fin c)) U) ↘
        AffineSpace (ULift.{u} (Fin c)) U := by
      apply AffineSpace.hom_ext
      · rw [Category.assoc, hq_over, he'_over]
      · rintro ⟨j⟩
        rw [hcomp, hq_coord, he'_coord, hv_cast]
    have h3 : e' ≫ e = 𝟙 _ := by
      apply AffineSpace.hom_ext
      · rw [Category.assoc, he_over, h2, Category.id_comp]
      · intro i
        rw [hcomp, hid, Subsingleton.elim i ⟨0⟩, he_coord, he'_coord, hv_last]
    refine ⟨e, ⟨⟨e', h1, h3⟩⟩, ?_⟩
    rw [← Category.assoc, he_over, hq_over]

  have P : ∀ (c : ℕ) (D : wcHMPullData (AffineSpace (ULift.{u} (Fin c)) U ↘ U) ℓ),
      wcHMPullCanonical D → ∀ m, Function.Surjective (wcHMPull D m) := by
    intro c
    induction c with
    | zero => intro D hD m; exact (L2 _ D hD m).2
    | succ c ih =>
      intro D hD m z
      obtain ⟨e, he_iso, he⟩ := L3 c
      haveI := he_iso
      obtain ⟨Dpd, hDpd⟩ := wc_hm_pull_data_exists (AffineSpace (ULift.{u} (Fin c)) U ↘ U) ℓ
      obtain ⟨Dπ, hDπ⟩ := wc_hm_pull_data_exists
        (AffineSpace (ULift.{u} (Fin 1)) (AffineSpace (ULift.{u} (Fin c)) U) ↘
          AffineSpace (ULift.{u} (Fin c)) U) ℓ
      obtain ⟨Dπp, hDπp⟩ := wc_hm_pull_data_exists
        ((AffineSpace (ULift.{u} (Fin 1)) (AffineSpace (ULift.{u} (Fin c)) U) ↘
          AffineSpace (ULift.{u} (Fin c)) U) ≫ (AffineSpace (ULift.{u} (Fin c)) U ↘ U)) ℓ
      obtain ⟨De, hDe⟩ := wc_hm_pull_data_exists e ℓ
      obtain ⟨w, hw⟩ := (L2 e De hDe m).2 z
      obtain ⟨v, hv⟩ := (s1 ((AffineSpace (ULift.{u} (Fin c)) U ↘ U) ≫ qU) Dπ hDπ m).2 w
      obtain ⟨x, hx⟩ := ih Dpd hDpd m v
      refine ⟨x, ?_⟩
      rw [wc_hm_pull_comp _ e _ he Dπp hDπp De hDe D hD m x,
        wc_hm_pull_comp _ _ _ rfl Dpd hDpd Dπ hDπ Dπp hDπp m x, hx, hv, hw]
  exact P d Dp hDp n

theorem wc_ext_two_class_leray_hirsch : ∀ {C : Type*} {D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] [EnoughInjectives D] (L : D ⥤ C) (R : C ⥤ D) [L.Additive] [R.Additive] (adj : L ⊣ R) [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L] (P : D) (A : C) (φ : L.obj P ≅ A) (I : InjectiveResolution A) (t : ℕ) (ht : 1 ≤ t) (g : L.obj P ⟶ I.cocomplex.X t) (hg : g ≫ I.cocomplex.d t (t + 1) = 0) (hf : adj.homEquiv _ _ g ≫ ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).d t (t + 1) = 0), letI := HasExt.standard C; letI := HasExt.standard D; IsIso (adj.unit.app P ≫ R.map φ.hom) → (∀ n : ℕ, 1 ≤ n → n ≤ t + 1 → n ≠ t → Limits.IsZero (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology n)) → IsIso (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).liftCycles (adj.homEquiv _ _ g) (t + 1) (by simp) hf ≫ ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homologyπ t) → ∀ x : Abelian.Ext (L.obj P) A t, ∃ (y : Abelian.Ext P P t) (b : Abelian.Ext P P 0), x = (Abelian.Ext.mapExactFunctor L y).comp (Abelian.Ext.mk₀ φ.hom) (add_zero t) + (Abelian.Ext.mapExactFunctor L b).comp (I.extMk g (t + 1) rfl hg) (zero_add t) :=
by
  classical
  intro C D _ _ _ _ _ L R _ _ adj _ _ P A φ I t ht g hg hf
  intro hU hvan hiso x
  letI : HasExt C := HasExt.standard C
  letI : HasExt D := HasExt.standard D

  obtain ⟨r, hr0, hrt, hrn⟩ : ∃ r : ℕ → ℕ, r 0 = 1 ∧ r t = 1 ∧ ∀ n, n ≠ 0 → n ≠ t → r n = 0 :=
    ⟨fun n => if n = 0 ∨ n = t then 1 else 0, by simp, by simp,
      fun n h0 h1 => by simp [h0, h1]⟩
  have ht0 : t ≠ 0 := by omega
  obtain ⟨gen, hgen0, hgent⟩ : ∃ gen : (n : ℕ) → Fin (r n) → (L.obj P ⟶ I.cocomplex.X n),
      (∀ i, gen 0 i = φ.hom ≫ I.ι.f 0) ∧ (∀ i, gen t i = g) :=
    ⟨fun n _ => if h0 : n = 0 then (φ.hom ≫ I.ι.f 0) ≫ eqToHom (congrArg I.cocomplex.X h0.symm)
      else if h1 : n = t then g ≫ eqToHom (congrArg I.cocomplex.X h1.symm) else 0,
      fun i => by simp, fun i => by simp [ht0]⟩

  have TrE : ∀ {n : ℕ} (f f' : L.obj P ⟶ I.cocomplex.X n) (_ : f = f')
      (h1 : f ≫ I.cocomplex.d n (n + 1) = 0) (h2 : f' ≫ I.cocomplex.d n (n + 1) = 0),
      I.extMk f (n + 1) rfl h1 = I.extMk f' (n + 1) rfl h2 := by
    intro n f f' e h1 h2
    subst e
    rfl
  have TrL : ∀ {n : ℕ} (f f' : L.obj P ⟶ I.cocomplex.X n) (_ : f = f')
      (h1 : adj.homEquiv _ _ f ≫
        ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).d n (n + 1) = 0)
      (h2 : adj.homEquiv _ _ f' ≫
        ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).d n (n + 1) = 0),
      ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).liftCycles
          (adj.homEquiv _ _ f) (n + 1) (by simp) h1 ≫
        ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homologyπ n =
      ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).liftCycles
          (adj.homEquiv _ _ f') (n + 1) (by simp) h2 ≫
        ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homologyπ n := by
    intro n f f' e h1 h2
    subst e
    rfl

  have hgen : ∀ (n : ℕ) (i : Fin (r n)), gen n i ≫ I.cocomplex.d n (n + 1) = 0 := by
    intro n i
    by_cases h0 : n = 0
    · subst h0
      rw [hgen0 i]
      show (φ.hom ≫ I.ι.f 0) ≫ I.cocomplex.d 0 1 = 0
      first
        | exact (Category.assoc _ _ _).trans ((congrArg (fun z => φ.hom ≫ z)
            I.ι_f_zero_comp_complex_d).trans Limits.comp_zero)
        | (erw [Category.assoc, I.ι_f_zero_comp_complex_d]; exact Limits.comp_zero)
    · by_cases h1 : n = t
      · subst h1
        rw [hgent i]
        exact hg
      · exact absurd i.isLt (by have := hrn n h0 h1; omega)
  have hfgen : ∀ (n : ℕ) (i : Fin (r n)), adj.homEquiv _ _ (gen n i) ≫
      ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).d n (n + 1) = 0 := by
    intro n i
    rw [Functor.mapHomologicalComplex_obj_d, ← Adjunction.homEquiv_naturality_right, hgen n i,
      Adjunction.homEquiv_unit, Functor.map_zero, Limits.comp_zero]

  have hsub : ∀ {β : Type} (i₀ : β), (∀ a b : β, a = b) → ∀ {X Y : D}
      [Limits.HasCoproduct (fun _ : β => X)] (f : β → (X ⟶ Y)), IsIso (f i₀) →
      IsIso (Limits.Sigma.desc f) := by
    intro β i₀ hβ X Y _ f hfi
    refine ⟨⟨inv (f i₀) ≫ Limits.Sigma.ι (fun _ : β => X) i₀, ?_, ?_⟩⟩
    · apply Limits.Sigma.hom_ext
      intro b
      rw [hβ b i₀]
      simp
    · simp
  have hext1 : ∀ {X Y : D} (m : X ⟶ Y), IsIso (Limits.Sigma.desc (fun _ : Fin 1 => m)) →
      IsIso m := by
    intro X Y m h
    haveI : IsIso (Limits.Sigma.ι (fun _ : Fin 1 => X) 0) :=
      ⟨⟨Limits.Sigma.desc (fun _ => 𝟙 X), by simp, by
        apply Limits.Sigma.hom_ext
        intro b
        rw [Subsingleton.elim b 0]
        simp⟩⟩
    have e := Limits.Sigma.ι_comp_desc (fun _ : Fin 1 => m) 0
    rw [← e]
    exact IsIso.comp_isIso

  have hIso : ∀ n : ℕ, n ≤ t + 1 → IsIso (Limits.Sigma.desc (fun i : Fin (r n) =>
      ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).liftCycles
        (adj.homEquiv _ _ (gen n i)) (n + 1) (by simp) (hfgen n i) ≫
      ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homologyπ n)) := by
    intro n hn
    by_cases h0 : n = 0
    · subst h0
      have hf0 : adj.homEquiv _ _ (φ.hom ≫ I.ι.f 0) ≫
          ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).d 0 (0 + 1) = 0 := by
        rw [← hgen0 ⟨0, by omega⟩]
        exact hfgen 0 _
      have hm0 := hext1 _ (wc_lh_degree_zero_isIso L R adj P A φ I hf0 hU)
      refine hsub ⟨0, by omega⟩ (fun a b => Fin.ext (by have := a.isLt; have := b.isLt; omega))
        _ ?_
      exact (congrArg IsIso (TrL _ _ (hgen0 ⟨0, by omega⟩) _ hf0)).mpr hm0
    · by_cases h1 : n = t
      · subst h1
        refine hsub ⟨0, by omega⟩
          (fun a b => Fin.ext (by have := a.isLt; have := b.isLt; omega)) _ ?_
        exact (congrArg IsIso (TrL _ _ (hgent ⟨0, by omega⟩) _ hf)).mpr hiso
      · have hT := hvan n (by omega) hn h1
        have hr := hrn n h0 h1
        exact ⟨⟨0, Limits.Sigma.hom_ext _ _ (fun b => absurd b.isLt (by omega)),
          hT.eq_of_src _ _⟩⟩

  obtain ⟨hSp, -⟩ := wc_ext_leray_hirsch.{_, _, 0} L R adj P A I (t + 1) r gen hgen hfgen hIso t
    (Nat.lt_succ_self t)

  let Φh : Abelian.Ext P P t × Abelian.Ext P P 0 →+ Abelian.Ext (L.obj P) A t :=
    ((Abelian.Ext.bilinearComp (L.obj P) (L.obj P) A t 0 t (add_zero t)).flip
        (Abelian.Ext.mk₀ φ.hom)).comp ((L.mapExtAddHom P P t).comp (AddMonoidHom.fst _ _)) +
      ((Abelian.Ext.bilinearComp (L.obj P) (L.obj P) A 0 t t (zero_add t)).flip
        (I.extMk g (t + 1) rfl hg)).comp ((L.mapExtAddHom P P 0).comp (AddMonoidHom.snd _ _))
  have hΦ : ∀ y b, Φh (y, b) =
      (Abelian.Ext.mapExactFunctor L y).comp (Abelian.Ext.mk₀ φ.hom) (add_zero t) +
        (Abelian.Ext.mapExactFunctor L b).comp (I.extMk g (t + 1) rfl hg) (zero_add t) :=
    fun _ _ => rfl

  have hmem := eq_top_iff.mp hSp (AddSubgroup.mem_top x)
  have hx : x ∈ Φh.range := by
    refine AddSubgroup.closure_induction (fun w hw => ?_) ?_ (fun w₁ w₂ _ _ h₁ h₂ => ?_)
      (fun w _ h₁ => ?_) hmem
    · obtain ⟨a, n, h, i, b, rfl⟩ := hw
      by_cases h0 : n = 0
      · subst h0
        have hc0 : (φ.hom ≫ I.ι.f 0) ≫ I.cocomplex.d 0 (0 + 1) = 0 := by
          rw [← hgen0 i]
          exact hgen 0 i
        have e : I.extMk (gen 0 i) (0 + 1) rfl (hgen 0 i) = Abelian.Ext.mk₀ φ.hom :=
          (TrE _ _ (hgen0 i) (hgen 0 i) hc0).trans (wc_ext_extMk_iota_zero I φ.hom hc0)
        rw [e]
        obtain rfl : a = t := by omega
        refine ⟨(b, 0), ?_⟩
        rw [hΦ, Abelian.Ext.mapExactFunctor_zero, Abelian.Ext.zero_comp, add_zero]
      · by_cases h1 : n = t
        · subst h1
          have e : I.extMk (gen n i) (n + 1) rfl (hgen n i) = I.extMk g (n + 1) rfl hg :=
            TrE _ _ (hgent i) _ _
          rw [e]
          obtain rfl : a = 0 := by omega
          refine ⟨(0, b), ?_⟩
          rw [hΦ, Abelian.Ext.mapExactFunctor_zero, Abelian.Ext.zero_comp, zero_add]
        · exact absurd i.isLt (by have := hrn n h0 h1; omega)
    · exact zero_mem _
    · exact add_mem h₁ h₂
    · exact neg_mem h₁

  obtain ⟨⟨y, b⟩, hyb⟩ := hx
  exact ⟨y, b, hyb.symm.trans (hΦ y b)⟩

theorem wc_punct_bundle_supp_unit_iso {N : Scheme.{u}} (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (d : ℕ) (hd : 1 ≤ d)
    (O : (AffineSpace (ULift.{u} (Fin d)) N).Opens)
    (hO : (O : Set ↥(AffineSpace (ULift.{u} (Fin d)) N)) =
      (Set.range (AffineSpace.homOfVector (𝟙 N) (0 : ULift.{u} (Fin d) → Γ(N, ⊤))))ᶜ)
    (Dg : wcHMPullData (O.ι ≫ (AffineSpace (ULift.{u} (Fin d)) N ↘ N)) ℓ) (hDg : wcHMPullCanonical Dg) :
    IsIso (wcSuppUnitMap Dg) :=
by
  classical

  have s1 : ∀ {M M' : SheafOfModules.{u+1} (wcRingSheaf N ℓ)} (φ : M ⟶ M'),
      (∀ X, Function.Bijective (φ.val.app X).hom) → IsIso φ := by
    intro M M' φ h
    have h2 : ∀ X, IsIso (((PresheafOfModules.toPresheaf (wcRingSheaf N ℓ).val).map
        ((SheafOfModules.forget (wcRingSheaf N ℓ)).map φ)).app X) := by
      intro X
      rw [ConcreteCategory.isIso_iff_bijective]
      exact h X
    have : IsIso ((PresheafOfModules.toPresheaf (wcRingSheaf N ℓ).val).map
        ((SheafOfModules.forget (wcRingSheaf N ℓ)).map φ)) := NatIso.isIso_of_isIso_app _
    have : IsIso ((SheafOfModules.forget (wcRingSheaf N ℓ)).map φ) :=
      isIso_of_reflects_iso _ (PresheafOfModules.toPresheaf (wcRingSheaf N ℓ).val)
    exact isIso_of_reflects_iso φ (SheafOfModules.forget (wcRingSheaf N ℓ))

  have hsurj : AlgebraicGeometry.Surjective (O.ι ≫ (AffineSpace (ULift.{u} (Fin d)) N ↘ N)) := by
    constructor
    intro x
    have hdisj : ∀ (t z : ↥N),
        (AffineSpace.homOfVector (𝟙 N) (fun _ => (1 : Γ(N, ⊤))) :
          N ⟶ AffineSpace (ULift.{u} (Fin d)) N) t ≠
        (AffineSpace.homOfVector (𝟙 N) (0 : ULift.{u} (Fin d) → Γ(N, ⊤))) z := by
      intro t z h
      have key : ∀ (v : ULift.{u} (Fin d) → Γ(N, ⊤)),
          AffineSpace.homOfVector (𝟙 N) v ⁻¹ᵁ
            (AffineSpace (ULift.{u} (Fin d)) N).basicOpen (AffineSpace.coord N ⟨⟨0, hd⟩⟩) =
            N.basicOpen (v ⟨⟨0, hd⟩⟩) := by
        intro v
        rw [Scheme.preimage_basicOpen]
        erw [AffineSpace.homOfVector_appTop_coord]
        exact rfl
      have ht : t ∈ AffineSpace.homOfVector (𝟙 N) (fun _ => (1 : Γ(N, ⊤))) ⁻¹ᵁ
            (AffineSpace (ULift.{u} (Fin d)) N).basicOpen (AffineSpace.coord N ⟨⟨0, hd⟩⟩) := by
        rw [key]
        show t ∈ N.basicOpen (1 : Γ(N, ⊤))
        rw [Scheme.basicOpen_one]
        trivial
      have hz : z ∈ AffineSpace.homOfVector (𝟙 N) (0 : ULift.{u} (Fin d) → Γ(N, ⊤)) ⁻¹ᵁ
            (AffineSpace (ULift.{u} (Fin d)) N).basicOpen (AffineSpace.coord N ⟨⟨0, hd⟩⟩) := by
        rw [Scheme.Hom.mem_preimage, ← h]
        exact (Scheme.Hom.mem_preimage _).mp ht
      rw [key] at hz
      have h0 : N.basicOpen (0 : Γ(N, ⊤)) = ⊥ := Scheme.basicOpen_zero _ _
      rw [show (0 : ULift.{u} (Fin d) → Γ(N, ⊤)) ⟨⟨0, hd⟩⟩ = 0 from rfl, h0] at hz
      simp at hz
    have hmem : (AffineSpace.homOfVector (𝟙 N) (fun _ => (1 : Γ(N, ⊤))) :
        N ⟶ AffineSpace (ULift.{u} (Fin d)) N) x ∈ (O : Set ↥(AffineSpace (ULift.{u} (Fin d)) N)) := by
      rw [hO]
      rintro ⟨z, hz⟩
      exact hdisj x z hz.symm
    rw [← Scheme.Opens.range_ι] at hmem
    obtain ⟨y, hy⟩ := hmem
    refine ⟨y, ?_⟩
    rw [Scheme.Hom.comp_apply, hy, ← Scheme.Hom.comp_apply, AffineSpace.homOfVector_over]
    rfl
  haveI := hsurj

  have hfib : ∀ {V : Scheme.{u}} (g : V ⟶ N) (v : V),
      _root_.IsPreconnected
        ((Limits.pullback.fst g (O.ι ≫ (AffineSpace (ULift.{u} (Fin d)) N ↘ N))).base.hom ⁻¹'
          {v}) := by
    intro V g v
    let ι := V.fromSpecResidueField v
    let f₀ := ι ≫ g
    let π := AffineSpace (ULift.{u} (Fin d)) (Spec (V.residueField v)) ↘ Spec (V.residueField v)
    let m := AffineSpace.map (ULift.{u} (Fin d)) f₀
    have hout0 : IsPullback (m ∣_ O) ((m ⁻¹ᵁ O).ι ≫ π)
        (O.ι ≫ (AffineSpace (ULift.{u} (Fin d)) N ↘ N)) f₀ :=
      IsPullback.paste_vert (isPullback_morphismRestrict m O) (AffineSpace.isPullback_map f₀)
    have w : ((m ⁻¹ᵁ O).ι ≫ π ≫ ι) ≫ g =
        (m ∣_ O) ≫ O.ι ≫ (AffineSpace (ULift.{u} (Fin d)) N ↘ N) := by
      have := hout0.w
      simp only [Category.assoc] at this ⊢
      exact this.symm
    let h := Limits.pullback.lift ((m ⁻¹ᵁ O).ι ≫ π ≫ ι) (m ∣_ O) w
    have hfst : h ≫ Limits.pullback.fst g (O.ι ≫ (AffineSpace (ULift.{u} (Fin d)) N ↘ N)) =
        ((m ⁻¹ᵁ O).ι ≫ π) ≫ ι := by
      rw [Category.assoc]
      exact Limits.pullback.lift_fst _ _ _
    have hsnd : h ≫ Limits.pullback.snd g (O.ι ≫ (AffineSpace (ULift.{u} (Fin d)) N ↘ N)) =
        m ∣_ O :=
      Limits.pullback.lift_snd _ _ _
    have hout : IsPullback
        (h ≫ Limits.pullback.snd g (O.ι ≫ (AffineSpace (ULift.{u} (Fin d)) N ↘ N)))
        ((m ⁻¹ᵁ O).ι ≫ π) (O.ι ≫ (AffineSpace (ULift.{u} (Fin d)) N ↘ N)) (ι ≫ g) := by
      rw [hsnd]; exact hout0
    have hL : IsPullback h ((m ⁻¹ᵁ O).ι ≫ π)
        (Limits.pullback.fst g (O.ι ≫ (AffineSpace (ULift.{u} (Fin d)) N ↘ N))) ι :=
      IsPullback.of_right hout hfst (IsPullback.of_hasPullback g _).flip
    have e1 : hL.isoPullback.hom ≫
        Limits.pullback.fst (Limits.pullback.fst g (O.ι ≫ (AffineSpace (ULift.{u} (Fin d)) N ↘ N)))
          ι = h :=
      hL.isoPullback_hom_fst
    have e1' : ∀ y, (Limits.pullback.fst (Limits.pullback.fst g
        (O.ι ≫ (AffineSpace (ULift.{u} (Fin d)) N ↘ N))) ι).base.hom
          (hL.isoPullback.hom.base.hom y) = h.base.hom y := fun y =>
      congrArg (fun f : (m ⁻¹ᵁ O).toScheme ⟶
        Limits.pullback g (O.ι ≫ (AffineSpace (ULift.{u} (Fin d)) N ↘ N)) => f.base.hom y) e1
    have hrange : Set.range h.base.hom =
        (Limits.pullback.fst g (O.ι ≫ (AffineSpace (ULift.{u} (Fin d)) N ↘ N))).base.hom ⁻¹'
          {v} := by
      have hr2 : Set.range h.base.hom = Set.range
          (Limits.pullback.fst (Limits.pullback.fst g
            (O.ι ≫ (AffineSpace (ULift.{u} (Fin d)) N ↘ N))) ι) := by
        ext x
        constructor
        · rintro ⟨y, rfl⟩
          exact ⟨hL.isoPullback.hom y, e1' y⟩
        · rintro ⟨y, rfl⟩
          obtain ⟨z, rfl⟩ := hL.isoPullback.hom.surjective y
          exact ⟨z, (e1' z).symm⟩
      rw [hr2, Scheme.Pullback.range_fst, Scheme.range_fromSpecResidueField]
    rw [← hrange]
    have hirr : IsPreirreducible (Set.univ :
        Set ↥(AffineSpace (ULift.{u} (Fin d)) (Spec (V.residueField v)))) :=
      (IrreducibleSpace.isIrreducible_univ _).isPreirreducible
    have h2 := hirr.preimage (m ⁻¹ᵁ O).ι.isOpenEmbedding
    rw [Set.preimage_univ] at h2
    have h3 := h2.image h.base.hom h.base.hom.continuous.continuousOn
    rw [Set.image_univ] at h3
    exact h3.isPreconnected

  have hsurjG : ∀ {W : Scheme.{u}} (g : W ⟶ N),
      Function.Surjective
        (Limits.pullback.fst g (O.ι ≫ (AffineSpace (ULift.{u} (Fin d)) N ↘ N))).base.hom :=
    fun g => Scheme.Hom.surjective
      (Limits.pullback.fst g (O.ι ≫ (AffineSpace (ULift.{u} (Fin d)) N ↘ N)))
  have hopenG : ∀ {W : Scheme.{u}} (g : W ⟶ N),
      IsOpenMap (Limits.pullback.fst g (O.ι ≫ (AffineSpace (ULift.{u} (Fin d)) N ↘ N))).base.hom :=
    fun g => Scheme.Hom.isOpenMap
      (Limits.pullback.fst g (O.ι ≫ (AffineSpace (ULift.{u} (Fin d)) N ↘ N)))
  obtain ⟨c', hc'⟩ := wc_supp_unit_twist_isUnit Dg
  haveI hTD : TotallyDisconnectedSpace (ULift.{u+1} ℚ_[ℓ]) :=
    Homeomorph.totallyDisconnectedSpace Homeomorph.ulift.symm
  apply s1
  intro X
  rcases X with ⟨V⟩
  have htw := fun t => wc_supp_hom_twist_formula Dg hDg (wcSuppUnitMap Dg) V t
  let fstV := (Limits.pullback.fst V.hom (O.ι ≫ (AffineSpace (ULift.{u} (Fin d)) N ↘ N))).base.hom
  let sndV := (Limits.pullback.snd V.hom (O.ι ≫ (AffineSpace (ULift.{u} (Fin d)) N ↘ N))).base.hom
  have e2 : ∀ z, wcSuppTwist (wcSuppUnitMap Dg) (sndV z) * c' (sndV z) = 1 := fun z =>
    congrArg (fun φ => φ (sndV z)) hc'
  constructor
  · intro t t' htt
    let t0 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]) := t
    let t0' : C(↥V.left, ULift.{u+1} ℚ_[ℓ]) := t'
    have H : ContinuousMap.comp t0 fstV * (wcSuppTwist (wcSuppUnitMap Dg)).comp sndV =
        ContinuousMap.comp t0' fstV * (wcSuppTwist (wcSuppUnitMap Dg)).comp sndV :=
      (htw t).symm.trans (htt.trans (htw t'))
    change t0 = t0'
    apply ContinuousMap.ext
    intro x
    obtain ⟨z, hz⟩ := hsurjG V.hom x
    have hz' : fstV z = x := hz
    have H1 := congrArg (fun φ : C(↥(Limits.pullback V.hom
        (O.ι ≫ (AffineSpace (ULift.{u} (Fin d)) N ↘ N))), ULift.{u+1} ℚ_[ℓ]) => φ z) H
    simp only [ContinuousMap.mul_apply, ContinuousMap.comp_apply] at H1
    rw [← hz']
    change t0 (fstV z) = t0' (fstV z)
    linear_combination (c' (sndV z)) * H1 - (t0 (fstV z) - t0' (fstV z)) * e2 z
  · intro s
    let s0 : C(↥(Limits.pullback V.hom (O.ι ≫ (AffineSpace (ULift.{u} (Fin d)) N ↘ N))),
        ULift.{u+1} ℚ_[ℓ]) := s
    let s' := s0 * c'.comp sndV
    have hq : Topology.IsQuotientMap fstV :=
      IsOpenMap.isQuotientMap (hopenG V.hom) fstV.continuous (hsurjG V.hom)
    have hfac : Function.FactorsThrough s' fstV := by
      intro a b hab
      have hpc := (hfib V.hom (fstV b)).image s' s'.continuous.continuousOn
      exact hpc.subsingleton (Set.mem_image_of_mem _ hab) (Set.mem_image_of_mem _ rfl)
    refine ⟨hq.lift s' hfac, ?_⟩
    have hl := hq.lift_comp s' hfac
    change ((wcSuppUnitMap Dg).val.app (Opposite.op V)).hom (hq.lift s' hfac) = s0
    rw [htw, hl]
    apply ContinuousMap.ext
    intro z
    simp only [s', ContinuousMap.mul_apply, ContinuousMap.comp_apply]
    linear_combination (s0 z) * e2 z

theorem wc_proet_int_ext_vanish_of_zmod_deg (Y : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (U : Y.ProEt)
    (j : ℕ) (h : ∀ k : ℕ, ∀ y : Abelian.Ext (wcFreeSheaf Y U) (wcZModSheaf Y (ℓ ^ (k + 1))) (j + 1), y = 0) :
    ∀ y : Abelian.Ext (wcFreeSheaf Y U) (wcIntSheaf Y ℓ) (j + 1), y = 0 :=
by

  have N1 : ∀ (P Z Y' : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
      (B : ℕ → Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (pr : ∀ n, Y' ⟶ B n)
      (c : ∀ n, B (n + 1) ⟶ B n) (T : Y' ⟶ Y') (hT : ∀ n, T ≫ pr n = pr n - pr (n + 1) ≫ c n)
      (f : Z ⟶ Y') (hzero : f ≫ T = 0) (hS : (ShortComplex.mk f T hzero).ShortExact)
      (hinj : ∀ (N : ℕ) (x : Abelian.Ext P Y' N),
        (∀ n, x.comp (Abelian.Ext.mk₀ (pr n)) (add_zero N) = 0) → x = 0)
      (hsurj : ∀ (N : ℕ) (y : ∀ n, Abelian.Ext P (B n) N), ∃ x : Abelian.Ext P Y' N,
        ∀ n, x.comp (Abelian.Ext.mk₀ (pr n)) (add_zero N) = y n)
      (hB : ∀ (n : ℕ) (x : Abelian.Ext P (B n) (j + 1)), x = 0)
      (hc : ∀ (n : ℕ) (y : Abelian.Ext P (B n) j), ∃ z : Abelian.Ext P (B (n + 1)) j,
        z.comp (Abelian.Ext.mk₀ (c n)) (add_zero j) = y),
      ∀ x : Abelian.Ext P Z (j + 1), x = 0 := by
    intro P Z Y' B pr c T hT f hzero hS hinj hsurj hB hc
    have s4 : ∀ y : Abelian.Ext P Y' j, ∃ w : Abelian.Ext P Y' j,
        w.comp (Abelian.Ext.mk₀ T) (add_zero j) = y := by
      intro y
      choose g hg using hc
      let x : ∀ n, Abelian.Ext P (B n) j := fun n =>
        Nat.rec (motive := fun n => Abelian.Ext P (B n) j) 0
          (fun n xn => g n (xn - y.comp (Abelian.Ext.mk₀ (pr n)) (add_zero j))) n
      have hx : ∀ n, (x (n + 1)).comp (Abelian.Ext.mk₀ (c n)) (add_zero j) =
          x n - y.comp (Abelian.Ext.mk₀ (pr n)) (add_zero j) := fun n => hg n _
      obtain ⟨w, hw⟩ := hsurj j x
      refine ⟨w, ?_⟩
      rw [← sub_eq_zero]
      apply hinj j
      intro n
      have key : ∀ (a b : Abelian.Ext P Y' j) (g : Y' ⟶ B n),
          (a - b).comp (Abelian.Ext.mk₀ g) (add_zero j) =
            a.comp (Abelian.Ext.mk₀ g) (add_zero j) - b.comp (Abelian.Ext.mk₀ g) (add_zero j) := by
        intro a b g
        rw [sub_eq_add_neg, Abelian.Ext.add_comp, Abelian.Ext.neg_comp, ← sub_eq_add_neg]
      have h1 : (w.comp (Abelian.Ext.mk₀ T) (add_zero j)).comp (Abelian.Ext.mk₀ (pr n)) (add_zero j) =
          w.comp (Abelian.Ext.mk₀ (pr n)) (add_zero j) -
            (w.comp (Abelian.Ext.mk₀ (pr (n + 1))) (add_zero j)).comp (Abelian.Ext.mk₀ (c n))
              (add_zero j) := by
        rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, hT n,
          Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
          sub_eq_add_neg, Abelian.Ext.mk₀_add, Abelian.Ext.mk₀_neg, Abelian.Ext.comp_add,
          Abelian.Ext.comp_neg, ← sub_eq_add_neg]
      rw [key, h1, hw, hw, hx]
      abel
    intro z
    have h0 : z.comp (Abelian.Ext.mk₀ f) (add_zero (j + 1)) = 0 := hinj _ _ (fun n => hB n _)
    obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ P hS z h0 (rfl : j + 1 = j + 1)
    rw [← hx₃]
    obtain ⟨w, hw⟩ := s4 x₃
    rw [← hw, Abelian.Ext.comp_assoc_of_second_deg_zero]
    have h2 := hS.comp_extClass
    erw [h2, Abelian.Ext.comp_zero]

  have N3 : ∀ k : ℕ, ∃ φ : ZMod (ℓ ^ (0 + 1)) →+ ZMod (ℓ ^ (k + 1 + 1)),
      Function.Injective φ ∧
        ∀ b : ZMod (ℓ ^ (k + 1 + 1)), wcTowerCast ℓ (k + 1) b = 0 ↔ ∃ a, φ a = b := by
    intro k
    have hℓ1 : 1 < ℓ := (Fact.out : Nat.Prime ℓ).one_lt
    have hℓ0 : ℓ ≠ 0 := by omega
    have hqpos : 0 < ℓ ^ (k + 1) := pow_pos (by omega) _
    haveI : NeZero (ℓ ^ (0 + 1)) := ⟨pow_ne_zero _ hℓ0⟩
    haveI : NeZero (ℓ ^ (k + 1 + 1)) := ⟨pow_ne_zero _ hℓ0⟩
    have hφc : (zmultiplesHom (ZMod (ℓ ^ (k + 1 + 1))) ((ℓ ^ (k + 1) : ℕ) : ZMod (ℓ ^ (k + 1 + 1))))
        ((ℓ ^ (0 + 1) : ℕ) : ℤ) = 0 := by
      rw [zmultiplesHom_apply, natCast_zsmul, nsmul_eq_mul, ← Nat.cast_mul,
        ZMod.natCast_eq_zero_iff]
      exact ⟨1, by ring⟩
    obtain ⟨φ, hφdef⟩ : ∃ φ : ZMod (ℓ ^ (0 + 1)) →+ ZMod (ℓ ^ (k + 1 + 1)),
        φ = ZMod.lift (ℓ ^ (0 + 1)) ⟨zmultiplesHom (ZMod (ℓ ^ (k + 1 + 1)))
          ((ℓ ^ (k + 1) : ℕ) : ZMod (ℓ ^ (k + 1 + 1))), hφc⟩ := ⟨_, rfl⟩
    have hF : ∀ m : ℕ, φ (m : ZMod (ℓ ^ (0 + 1))) =
        ((m * ℓ ^ (k + 1) : ℕ) : ZMod (ℓ ^ (k + 1 + 1))) := by
      intro m
      rw [show ((m : ℕ) : ZMod (ℓ ^ (0 + 1))) = ((m : ℤ) : ZMod (ℓ ^ (0 + 1))) from
        (Int.cast_natCast m).symm, hφdef, ZMod.lift_coe]
      show (zmultiplesHom (ZMod (ℓ ^ (k + 1 + 1))) ((ℓ ^ (k + 1) : ℕ) : ZMod (ℓ ^ (k + 1 + 1))))
        ((m : ℕ) : ℤ) = _
      rw [zmultiplesHom_apply, natCast_zsmul, nsmul_eq_mul, Nat.cast_mul]
    have hcast : ∀ m : ℕ, wcTowerCast ℓ (k + 1) (m : ZMod (ℓ ^ (k + 1 + 1))) =
        (m : ZMod (ℓ ^ (k + 1))) := by
      intro m
      show (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (k + 1))) (ZMod (ℓ ^ (k + 1))))
        (m : ZMod (ℓ ^ (k + 1 + 1))) = _
      exact map_natCast _ m
    refine ⟨φ, ?_, ?_⟩
    · rw [injective_iff_map_eq_zero]
      intro a ha
      have e := hF a.val
      rw [ZMod.natCast_zmod_val] at e
      rw [e, ZMod.natCast_eq_zero_iff] at ha
      have hN : ℓ ^ (k + 1 + 1) = ℓ * ℓ ^ (k + 1) := by ring
      rw [hN] at ha
      have hdvd : ℓ ∣ a.val := Nat.dvd_of_mul_dvd_mul_right hqpos ha
      have hlt : a.val < ℓ := by
        have := ZMod.val_lt a
        simpa using this
      have h0 : a.val = 0 := Nat.eq_zero_of_dvd_of_lt hdvd hlt
      exact (ZMod.val_eq_zero a).mp h0
    · intro b
      constructor
      · intro hb
        rw [← ZMod.natCast_zmod_val b, hcast, ZMod.natCast_eq_zero_iff] at hb
        obtain ⟨m, hm⟩ := hb
        refine ⟨(m : ZMod (ℓ ^ (0 + 1))), ?_⟩
        rw [hF, ← ZMod.natCast_zmod_val b, hm]
        push_cast
        ring
      · rintro ⟨a, rfl⟩
        have e := hF a.val
        rw [ZMod.natCast_zmod_val] at e
        rw [e, hcast, ZMod.natCast_eq_zero_iff]
        exact dvd_mul_left _ _

  have hzero0 : (𝟙 (wcContSheaf Y (ZMod (ℓ ^ 0))) : _ ⟶ _) = 0 := by
    haveI : Subsingleton (ZMod (ℓ ^ 0)) := ZMod.subsingleton_iff.mpr (pow_zero ℓ)
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext V
    apply AddCommGrpCat.ext
    intro x
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    exact Subsingleton.elim _ _
  have hB0 : ∀ (N : ℕ) (x : Abelian.Ext (wcFreeSheaf Y U) (wcContSheaf Y (ZMod (ℓ ^ 0))) N),
      x = 0 := by
    intro N x
    calc x = x.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero N) := (Abelian.Ext.comp_mk₀_id x).symm
      _ = 0 := by rw [hzero0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]

  haveI := wc_proet_products_exact Y
  obtain ⟨hcont_incl, hemb, hcont_shift, hker, hsec⟩ := wc_padic_tower_facts ℓ
  obtain ⟨hz2, hS2⟩ := wc_contSheaf_shortExact Y (wcTowerIncl ℓ) hcont_incl
    (wcTowerShift ℓ) hcont_shift hemb hker hsec
  have hY := (wc_contSheaf_pi_isLimit Y (fun n => ZMod (ℓ ^ n))).some
  have hprod := fun N => wc_ext_prod_bijective (wcFreeSheaf Y U)
    (wcContSheaf Y ((n : ℕ) → ZMod (ℓ ^ n))) (fun n => wcContSheaf Y (ZMod (ℓ ^ n)))
    (fun n => wcContSheafMap Y (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n)
      (continuous_apply n)) hY N
  have hcongr : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B] (φ φ' : A →+ B)
      (e : φ = φ') (hφ : Continuous φ) (hφ' : Continuous φ'),
      wcContSheafMap Y φ hφ = wcContSheafMap Y φ' hφ' := by
    intro A B _ _ _ _ _ _ φ φ' e hφ hφ'
    subst e
    rfl
  have hTn : ∀ n, wcContSheafMap Y (wcTowerShift ℓ) hcont_shift ≫
      wcContSheafMap Y (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n) =
      wcContSheafMap Y (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n) -
      wcContSheafMap Y (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1))
        (continuous_apply (n + 1)) ≫
      wcContSheafMap Y (wcTowerCast ℓ n) continuous_of_discreteTopology := by
    intro n
    have e1 := (wc_contSheafMap_comp_sub Y (wcTowerShift ℓ) (wcTowerShift ℓ) hcont_shift
      hcont_shift (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n)).1
    have e2 := (wc_contSheafMap_comp_sub Y
      (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1))
      (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1)) (continuous_apply (n + 1))
      (continuous_apply (n + 1)) (wcTowerCast ℓ n) continuous_of_discreteTopology).1
    have e3 := (wc_contSheafMap_comp_sub Y
      (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n)
      ((wcTowerCast ℓ n).comp (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) (n + 1)))
      (continuous_apply n)
      ((continuous_of_discreteTopology (f := ⇑(wcTowerCast ℓ n))).comp (continuous_apply (n + 1)))
      (AddMonoidHom.id (ZMod (ℓ ^ n))) continuous_id).2
    rw [← e1, ← e2, ← e3]
    exact hcongr _ _ (AddMonoidHom.ext fun a => rfl) _ _

  have hB : ∀ (n : ℕ) (x : Abelian.Ext (wcFreeSheaf Y U) (wcContSheaf Y (ZMod (ℓ ^ n))) (j + 1)),
      x = 0 := by
    intro n x
    cases n with
    | zero => exact hB0 _ x
    | succ k => exact h k x

  have hc : ∀ (n : ℕ) (y : Abelian.Ext (wcFreeSheaf Y U) (wcContSheaf Y (ZMod (ℓ ^ n))) j),
      ∃ z : Abelian.Ext (wcFreeSheaf Y U) (wcContSheaf Y (ZMod (ℓ ^ (n + 1)))) j,
        z.comp (Abelian.Ext.mk₀ (wcContSheafMap Y (wcTowerCast ℓ n)
          continuous_of_discreteTopology)) (add_zero j) = y := by
    intro n y
    cases n with
    | zero =>
      refine ⟨0, ?_⟩
      rw [Abelian.Ext.zero_comp, hB0 j y]
    | succ k =>
      obtain ⟨φ, hφinj, hker'⟩ := N3 k
      have hφemb : Topology.IsEmbedding φ :=
        (Topology.IsClosedEmbedding.of_continuous_injective_isClosedMap
          continuous_of_discreteTopology hφinj (fun s _ => isClosed_discrete _)).isEmbedding
      have hsurj : Function.Surjective (wcTowerCast ℓ (k + 1)) :=
        ZMod.castHom_surjective (pow_dvd_pow ℓ (Nat.le_succ (k + 1)))
      obtain ⟨hzk, hSk⟩ := wc_contSheaf_shortExact Y φ continuous_of_discreteTopology
        (wcTowerCast ℓ (k + 1)) continuous_of_discreteTopology hφemb hker'
        ⟨Function.surjInv hsurj, continuous_of_discreteTopology, Function.surjInv_eq hsurj⟩
      have hob : y.comp hSk.extClass (rfl : j + 1 = j + 1) = 0 := h 0 _
      obtain ⟨z, hz⟩ := Abelian.Ext.covariant_sequence_exact₃ (wcFreeSheaf Y U) hSk y rfl hob
      exact ⟨z, hz⟩
  have hvan := N1 (wcFreeSheaf Y U) _ _
    (fun n => wcContSheaf Y (ZMod (ℓ ^ n)))
    (fun n => wcContSheafMap Y (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n)
      (continuous_apply n))
    (fun n => wcContSheafMap Y (wcTowerCast ℓ n) continuous_of_discreteTopology)
    _ hTn _ hz2 hS2 (fun N => (hprod N).1) (fun N => (hprod N).2) hB hc
  intro y
  exact hvan y

theorem wc_et_invsh_affine_line : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of K)) (n : ℕ), (n : K) ≠ 0 → wcEtInvSH K Y fY n → ∀ (Y₁ : Scheme.{u}) (a : Y₁ ⟶ Y) (b : Y₁ ⟶ Spec (.of (Polynomial K))), IsPullback a b fY (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) → wcEtInvSH K Y₁ (a ≫ fY) n :=
by
  classical
  intro K _ _ Y fY n hn hInv Y₁ a b h

  have hn0 : 0 < n := by
    rcases Nat.eq_zero_or_pos n with h0 | h0
    · exact absurd (by rw [h0, Nat.cast_zero]) hn
    · exact h0
  have hpK : ∀ p : ℕ, p ∣ n → (p : K) ≠ 0 := by
    intro p hp hp0
    obtain ⟨c, hc⟩ := hp
    apply hn
    rw [hc, Nat.cast_mul, hp0, zero_mul]

  have s1 : ∀ (Z : Scheme.{u}) (j : ℕ) (m : ℕ), 0 < m →
      (∀ p : ℕ, p.Prime → p ∣ m → Subsingleton (wcEtCoh Z p j)) →
      Subsingleton (wcEtCoh Z m j) := by
    intro Z j m
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) := HasExt.standard _
    have hmid : ∀ (X : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
        (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})), S.ShortExact →
        ∀ m : ℕ, Subsingleton (Abelian.Ext X S.X₁ m) → Subsingleton (Abelian.Ext X S.X₃ m) →
          Subsingleton (Abelian.Ext X S.X₂ m) := by
      intro X S hS m h1 h3
      let ψ : Abelian.Ext X S.X₂ m →+ Abelian.Ext X S.X₃ m :=
        (Abelian.Ext.mk₀ S.g).postcomp X (add_zero m)
      let φ : Abelian.Ext X S.X₁ m →+ Abelian.Ext X S.X₂ m :=
        (Abelian.Ext.mk₀ S.f).postcomp X (add_zero m)
      have hex : ∀ b, ψ b = 0 → ∃ a, φ a = b := fun b hb =>
        Abelian.Ext.covariant_sequence_exact₂ X hS b hb
      have hz : ∀ b : Abelian.Ext X S.X₂ m, b = 0 := by
        intro b
        obtain ⟨a, ha⟩ := hex b (Subsingleton.elim _ _)
        rw [← ha, Subsingleton.elim a 0, map_zero]
      exact ⟨fun a b => by rw [hz a, hz b]⟩
    have hses : ∀ (p k : ℕ), p ≠ 0 →
        ∃ (f : AddCommGrpCat.of (ULift.{u+1} (ZMod k)) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))))
          (g : AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod p)))
          (hw : f ≫ g = 0), (ShortComplex.mk f g hw).ShortExact := by
      intro p k hp
      have hk0 : (zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k))) (k : ℤ) = 0 := by
        rw [zmultiplesHom_apply, zsmul_eq_mul, Int.cast_natCast, ← Nat.cast_mul, mul_comm,
          ZMod.natCast_self]
      let α : ZMod k →+ ZMod (p * k) :=
        ZMod.lift k ⟨zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k)), hk0⟩
      have hα : ∀ z : ℤ, α (z : ZMod k) = ((z * p : ℤ) : ZMod (p * k)) := by
        intro z
        show (ZMod.lift k ⟨zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k)), hk0⟩) (z : ZMod k) = _
        rw [ZMod.lift_coe]
        change z • (p : ZMod (p * k)) = _
        rw [zsmul_eq_mul]
        push_cast
        ring
      let β : ZMod (p * k) →+ ZMod p := (ZMod.castHom (dvd_mul_right p k) (ZMod p)).toAddMonoidHom
      have hβ : ∀ z : ℤ, β (z : ZMod (p * k)) = (z : ZMod p) := fun z =>
        map_intCast (ZMod.castHom (dvd_mul_right p k) (ZMod p)) z
      have hαinj : Function.Injective α := by
        rw [injective_iff_map_eq_zero]
        intro x hx
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
        rw [hα, ZMod.intCast_zmod_eq_zero_iff_dvd] at hx
        rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
        have hp' : (p : ℤ) ≠ 0 := by exact_mod_cast hp
        push_cast at hx
        rw [mul_comm z] at hx
        exact (mul_dvd_mul_iff_left hp').mp hx
      have hβsurj : Function.Surjective β := by
        intro y
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
        exact ⟨(z : ZMod (p * k)), hβ z⟩
      have hβα : ∀ x, β (α x) = 0 := by
        intro x
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
        rw [hα, hβ]
        push_cast
        rw [ZMod.natCast_self, mul_zero]
      have hker : ∀ y, β y = 0 → ∃ x, α x = y := by
        intro y hy
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
        rw [hβ, ZMod.intCast_zmod_eq_zero_iff_dvd] at hy
        obtain ⟨t, rfl⟩ := hy
        refine ⟨(t : ZMod k), ?_⟩
        rw [hα]
        congr 1
        ring
      let f : AddCommGrpCat.of (ULift.{u+1} (ZMod k)) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) :=
        AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp α).comp
          AddEquiv.ulift.toAddMonoidHom)
      let g : AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod p)) :=
        AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp β).comp
          AddEquiv.ulift.toAddMonoidHom)
      have hw : f ≫ g = 0 := by
        ext x
        exact hβα x.down
      refine ⟨f, g, hw, ShortComplex.ShortExact.mk' ?_ ?_ ?_⟩
      · rw [ShortComplex.ab_exact_iff]
        intro x₂ hx₂
        obtain ⟨x₁, hx₁⟩ := hker x₂.down (congrArg ULift.down hx₂)
        exact ⟨ULift.up x₁, congrArg ULift.up hx₁⟩
      · rw [AddCommGrpCat.mono_iff_injective]
        intro a b hab
        exact ULift.ext _ _ (hαinj (congrArg ULift.down hab))
      · rw [AddCommGrpCat.epi_iff_surjective]
        intro y
        obtain ⟨x, hx⟩ := hβsurj y.down
        exact ⟨ULift.up x, congrArg ULift.up hx⟩
    haveI : Limits.PreservesFiniteLimits
        (constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) :=
      Limits.comp_preservesFiniteLimits (Functor.const (Scheme.Etale Z)ᵒᵖ)
        (presheafToSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
    have key0 : ∀ (X W : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}),
        Limits.IsZero W → ∀ (x : Abelian.Ext X W j), x = 0 := by
      intro X W hW x
      rw [← Abelian.Ext.comp_mk₀_id x, hW.eq_of_src (𝟙 W) 0, Abelian.Ext.mk₀_zero,
        Abelian.Ext.comp_zero]
    revert m
    intro m
    induction m using Nat.strong_induction_on with
    | _ m IH =>
      intro hm hp
      by_cases hm1 : m = 1
      · subst hm1
        haveI : Subsingleton (ZMod 1) := ZMod.subsingleton_iff.mpr rfl
        have hG : Limits.IsZero (AddCommGrpCat.of (ULift.{u+1} (ZMod 1))) :=
          @AddCommGrpCat.isZero_of_subsingleton _ (inferInstanceAs (Subsingleton (ULift.{u+1} (ZMod 1))))
        have hF := Functor.map_isZero
          (constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) hG
        exact ⟨fun x y => (key0 _ _ hF x).trans (key0 _ _ hF y).symm⟩
      · obtain ⟨p, hpdef⟩ : ∃ p, p = Nat.minFac m := ⟨_, rfl⟩
        have hpr : p.Prime := by rw [hpdef]; exact Nat.minFac_prime hm1
        have hpm : p ∣ m := by rw [hpdef]; exact Nat.minFac_dvd m
        have hk : p * (m / p) = m := Nat.mul_div_cancel' hpm
        have hk0 : 0 < m / p := by
          rcases Nat.eq_zero_or_pos (m / p) with h0 | h0
          · rw [h0, mul_zero] at hk
            omega
          · exact h0
        have hklt : m / p < m := Nat.div_lt_self hm hpr.one_lt
        have IHk := IH (m / p) hklt hk0
          (fun q hq hqk => hp q hq (dvd_trans hqk (Dvd.intro_left p hk)))
        have Hp := hp p hpr hpm
        obtain ⟨f, g, hw, hS₀⟩ := hses p (m / p) hpr.ne_zero
        have hS := hS₀.map_of_exact (constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
        rw [← hk]
        exact hmid _ _ hS j IHk Hp

  have hV : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A]
      [IsSepClosed (IsLocalRing.ResidueField A)] (s : Spec (.of A) ⟶ Spec (.of K)) (q : ℕ), 1 ≤ q →
      Subsingleton (wcEtCoh (Limits.pullback s
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) n q) := by
    intro A _ _ _ s q hq
    exact s1 _ q n hn0 (fun p hp hpn =>
      wc_et_henselian_affine_line_acyclic K p hp (hpK p hpn) A s q hq)

  have s2 : ∀ (X : Scheme.{u}) (fX : X ⟶ Spec (.of K))
      (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod n))))) (m : ℕ), 1 ≤ m →
      Limits.IsZero ((((wcEtPush (Limits.pullback.fst fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))).mapHomologicalComplex
          (ComplexShape.up ℕ)).obj I.cocomplex).homology m) := by
    intro X fX I m hm
    haveI hπaff : IsAffineHom (Limits.pullback.fst fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) :=
      MorphismProperty.of_isPullback (P := @IsAffineHom) (IsPullback.of_hasPullback fX _).flip
        inferInstance
    apply wc_et_stalks_zero
    intro b'
    obtain ⟨A, _, _, _, Λ, _, _, W', φ, a', e, hinit, haff, hφ, hφa, hlim, -, -⟩ :=
      wc_et_geom_strict_henselization b'
    obtain ⟨E₁⟩ := wc_et_stalk_push_homology (Limits.pullback.fst fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) b' Λ W' hinit I.cocomplex m
    obtain ⟨E₂⟩ := wc_et_limit_push_homology_affine (Limits.pullback.fst fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) A Λ
      (W' ⋙ StructuredArrow.proj (Over.mk (wcEtGeomPt X b')) (Scheme.Etale.forget X)) φ a'
      haff hφ hφa hlim n I m
    obtain ⟨E₃⟩ := wc_et_coh_iso_invariance
      ((Limits.pullbackSymmetry (Limits.pullback.fst fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) a').hom ≫
        (Limits.pullbackRightPullbackFstIso fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) a').hom) n m
    haveI := hV A (a' ≫ fX) m hm
    exact (E₁.trans (E₂.trans E₃.symm)).subsingleton

  have s3 : ∀ {T Q : Scheme.{u}} (r : Q ⟶ T) (D : wcEtPullData r n),
      (∀ (J : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology Q) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod n))))) (k : ℕ), 1 ≤ k →
        Limits.IsZero ((((wcEtPush r).mapHomologicalComplex (ComplexShape.up ℕ)).obj
          J.cocomplex).homology k)) →
      letI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ).Additive :=
        @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D.adj D.additive
      ∃ I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing Q n)), ∀ k : ℕ, 1 ≤ k →
        Limits.IsZero ((((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont
          D.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology k) := by
    intro T Q r D hJ
    letI hPadd : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ).Additive :=
      @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D.adj D.additive
    haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology Q) AddCommGrpCat.{u+1}) :=
      wc_et_enough_injectives Q
    haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) :=
      wc_et_enough_injectives T
    haveI := sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology Q) (wcEtZModRing Q n)
    haveI := sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology T) (wcEtZModRing T n)
    haveI hIRQ : HasInjectiveResolutions (SheafOfModules.{u+1} (wcEtZModRing Q n)) :=
      ⟨fun Z => ⟨⟨InjectiveResolution.of Z⟩⟩⟩
    haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.smallEtaleTopology Q)
      (wcEtZModRing Q n)
    haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.smallEtaleTopology T)
      (wcEtZModRing T n)
    have hnpos : 0 < n := hn0
    have sdiv : ∀ (X : Scheme.{u}) (E : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
        [Injective E], Epi (n • 𝟙 E) := by
      intro X E _
