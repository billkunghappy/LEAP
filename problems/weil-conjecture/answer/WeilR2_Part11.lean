          (adjB.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ))))) (add_zero 0) := by
      rw [Abelian.Ext.mk₀_comp_mk₀, Limits.biprod.inl_desc]
    have h1 : (Abelian.Ext.mk₀ (adjA.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)))).comp
        hS.extClass (zero_add 1) = 0 := by
      rw [e, Abelian.Ext.comp_assoc_of_second_deg_zero, h0, Abelian.Ext.comp_zero]
    have hk : (Abelian.Ext.mk₀ (adjA.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)))).comp
        (hS.extClass.comp x (add_comm 1 n)) (zero_add (n + 1)) = 0 := by
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 1) (add_comm 1 n) (by omega), h1,
        Abelian.Ext.zero_comp]
    rw [← hTA3, hk, map_zero, map_zero]
  · intro γ DB
    obtain ⟨x, rfl⟩ := bTC.2 γ
    rw [hTC x, hδ x]
    obtain ⟨Did⟩ := wc_et_zmod_pull_data_exists (𝟙 (B : Scheme.{u})) ℓ
    rw [wc_et_pull_comp B.ι (𝟙 _) B.ι (Category.id_comp _) EB Did DB (n + 1)]
    obtain ⟨TB, -, -, hTB3⟩ := wc_et_extzero_transfer_bijective B ℓ EB LB adjB hLB (n + 1)
    have e : Abelian.Ext.mk₀ (adjB.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ))) =
