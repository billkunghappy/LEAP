theorem wc_et_smooth_pair_supp_local_thom_gen : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (T : wcEtLocThom K ℓ), wcEtThomGL T → wcEtThomNat T → wcEtThomPt T → ∀ (W ZW : Scheme.{u}) (fW : W ⟶ Spec (.of K)) (n c : ℕ) [SmoothOfRelativeDimension n fW] (iW : ZW ⟶ W) [IsClosedImmersion iW] [SmoothOfRelativeDimension (n - c) (iW ≫ fW)], c ≤ n → ∀ (D : wcEtPullData iW ℓ) (θ α : wcEtSuppExt D (2 * c)), wcEtIsThom T fW D c θ → ∀ z : ZW, ∃ (W' : Scheme.{u}) (f : W' ⟶ W), Etale f ∧ iW z ∈ Set.range f ∧ ∃ k : ℕ, ∀ (Z' : Scheme.{u}) (iW' : Z' ⟶ W') (g : Z' ⟶ ZW), IsPullback g iW' iW f → ∀ (D' : wcEtPullData iW' ℓ) (Ef : wcEtPullData f ℓ) (γ : wcEtSuppObj D' ⟶ Ef.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap D' ≫ γ = Ef.μ.inv ≫ Ef.Φ.map (wcEtSuppUnitMap D) → wcEtSuppRestr D Ef D' γ (2 * c) α = k • wcEtSuppRestr D Ef D' γ (2 * c) θ :=
