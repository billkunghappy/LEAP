    L ⟨adj⟩ ρ hu hn ε hε0
  have hsub := wc_et_pullback_injective_limit_acyclic_qcqs p L ⟨adj⟩ Λ D π hπ hπc hlim hcpt hqs
    haff hZc hZq
  have hacyc : ∀ (I : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) [Injective I]
