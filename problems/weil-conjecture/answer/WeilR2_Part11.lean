    haveI : WeaklyEtale W.hom := W.prop
    have hc : WeaklyEtale (W.left.fromSpecStalk z ≫ W.hom) := inferInstance
    haveI h5 := wc_smooth_pair_compl_strict_stalk_et_vanish K pY n m i ℓ hℓ V hV
      (W.left.presheaf.stalk z) (W.left.fromSpecStalk z ≫ W.hom) hc _ _ hP k hk1 hk2
    obtain ⟨E⟩ := wc_et_zmodext_coh_equiv (Limits.pullback (W.left.fromSpecStalk z)
      (Limits.pullback.fst W.hom V.ι)) ℓ k
    haveI : Subsingleton (wcEtZModExt (Limits.pullback (W.left.fromSpecStalk z)
        (Limits.pullback.fst W.hom V.ι)) ℓ k) := E.subsingleton
    have hzc : CompactSpace (Limits.pullback (W.left.fromSpecStalk z)
        (Limits.pullback.fst W.hom V.ι) : Scheme.{u}) :=
      QuasiCompact.compactSpace_of_compactSpace
        (Limits.pullback.fst (W.left.fromSpecStalk z) (Limits.pullback.fst W.hom V.ι))
    have hzq : QuasiSeparatedSpace (Limits.pullback (W.left.fromSpecStalk z)
        (Limits.pullback.fst W.hom V.ι) : Scheme.{u}) :=
      quasiSeparatedSpace_of_quasiSeparated
        (Limits.pullback.fst (W.left.fromSpecStalk z) (Limits.pullback.fst W.hom V.ι))
    exact (hΘ _ hzc hzq).2.subsingleton

  letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf (Limits.pullback W.hom V.ι) ℓ)) :=
    HasExt.standard _
  have hFunOne : ∀ (S : Scheme.{u}) (m : ℕ), wcZModFun S m 1 = 𝟙 _ := by
    intro S m
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext V
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    rw [← SheafOfModules.unitHomEquiv_apply_coe]
    simp only [wcZModFun, Equiv.apply_symm_apply]
    rfl
  have hFunMul : ∀ (S : Scheme.{u}) (m : ℕ) (r r' : C(↥S, ULift.{u+1} (ZMod m))),
      wcZModFun S m (r * r') = wcZModFun S m r ≫ wcZModFun S m r' := by
    intro S m r r'
    apply (SheafOfModules.unitHomEquiv _).injective
    rw [SheafOfModules.unitHomEquiv_comp_apply]
    apply Subtype.ext
    funext V
    have hvalP : ∀ c : C(↥S, ULift.{u+1} (ZMod m)),
        ((SheafOfModules.unitHomEquiv _) (wcZModFun S m c)).1 V =
        (c.comp (Opposite.unop V).hom.base.hom :
          C(↥((Opposite.unop V).left), ULift.{u+1} (ZMod m))) := by
      intro c
      simp only [wcZModFun, Equiv.apply_symm_apply]
      rfl
    show _ = ((wcZModFun S m r').val.app V).hom (((SheafOfModules.unitHomEquiv _) (wcZModFun S m r)).1 V)
    rw [hvalP, hvalP]
    apply ContinuousMap.ext
    intro x
    rfl
  have hFunAdd : ∀ (S : Scheme.{u}) (m : ℕ) (r r' : C(↥S, ULift.{u+1} (ZMod m))),
      wcZModFun S m (r + r') = wcZModFun S m r + wcZModFun S m r' := by
    intro S m r r'
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext V
    have hvalP : ∀ c : C(↥S, ULift.{u+1} (ZMod m)),
        ((SheafOfModules.unitHomEquiv _) (wcZModFun S m c)).1 V =
        (c.comp (Opposite.unop V).hom.base.hom :
          C(↥((Opposite.unop V).left), ULift.{u+1} (ZMod m))) := by
      intro c
      simp only [wcZModFun, Equiv.apply_symm_apply]
      rfl
    rw [hvalP, SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.add_val,
