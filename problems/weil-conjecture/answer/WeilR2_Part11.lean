  have h2 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf V'' ℓ)} {a : ℕ}
      (p : A ⟶ B) (q : B ⟶ C') (z : Abelian.Ext C' D' a),
      (Abelian.Ext.mk₀ p).comp ((Abelian.Ext.mk₀ q).comp z (zero_add a)) (zero_add a) =
        (Abelian.Ext.mk₀ (p ≫ q)).comp z (zero_add a) := by
    intro A B C' D' a p q z
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
  have h3 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf V'' ℓ)} {a : ℕ}
      (z : Abelian.Ext A B a) (p : B ⟶ C') (q : C' ⟶ D'),
      (z.comp (Abelian.Ext.mk₀ p) (add_zero a)).comp (Abelian.Ext.mk₀ q) (add_zero a) =
        z.comp (Abelian.Ext.mk₀ (p ≫ q)) (add_zero a) := by
    intro A B C' D' a z p q
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  have h4 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf V'' ℓ)} {a : ℕ}
      (p : A ⟶ B) (z : Abelian.Ext B C' a) (q : C' ⟶ D'),
      ((Abelian.Ext.mk₀ p).comp z (zero_add a)).comp (Abelian.Ext.mk₀ q) (add_zero a) =
        (Abelian.Ext.mk₀ p).comp (z.comp (Abelian.Ext.mk₀ q) (add_zero a)) (zero_add a) := by
    intro A B C' D' a p z q
    exact Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _

  have hcomm : ∀ (X : (V''.ProEt)ᵒᵖ) (a b : (wcRingSheaf V'' ℓ).obj.obj X), a * b = b * a := by
    intro X a b
    exact @mul_comm C(↥(Opposite.unop X).left, ULift.{u+1} ℚ_[ℓ]) _ a b
  have hext : ∀ (e : SheafOfModules.unit (wcRingSheaf V'' ℓ) ⟶
      SheafOfModules.unit (wcRingSheaf V'' ℓ)), ∃ m : 𝟭 (SheafOfModules.{u+1} (wcRingSheaf V'' ℓ)) ⟶
      𝟭 (SheafOfModules.{u+1} (wcRingSheaf V'' ℓ)),
      m.app (SheafOfModules.unit (wcRingSheaf V'' ℓ)) = e := by
    intro e
    let R := wcRingSheaf V'' ℓ
    let s := (SheafOfModules.unit R).unitHomEquiv e
    let σ : ∀ X : (V''.ProEt)ᵒᵖ, R.obj.obj X := fun X => (s.1 X : R.obj.obj X)
    have hσ : ∀ {X Y : (V''.ProEt)ᵒᵖ} (g : X ⟶ Y), (R.obj.map g).hom (σ X) = σ Y :=
      fun g => PresheafOfModules.sections_property s g
    let L : ∀ (M : SheafOfModules.{u+1} R) (X : (V''.ProEt)ᵒᵖ), M.val.obj X ⟶ M.val.obj X :=
      fun M X => ModuleCat.ofHom
        { toFun := fun x => σ X • x
          map_add' := fun x y => smul_add _ _ _
          map_smul' := fun r x => by
            simp only [RingHom.id_apply, smul_smul]
            rw [hcomm X] }
    let mM : ∀ M : SheafOfModules.{u+1} R, M ⟶ M := fun M =>
      ⟨PresheafOfModules.Hom.mk (L M) (by
        intro X Y g
        ext x
        show σ Y • (M.val.map g).hom x = (M.val.map g).hom (σ X • x)
        rw [PresheafOfModules.map_smul, hσ])⟩
    refine ⟨{ app := mM, naturality := ?_ }, ?_⟩
    · intro M N g
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro X
      ext x
      show σ X • (g.val.app X).hom x = (g.val.app X).hom (σ X • x)
      exact ((g.val.app X).hom.map_smul _ _).symm
    · apply (SheafOfModules.unit R).unitHomEquiv.injective
      apply PresheafOfModules.sections_ext
      intro X
      rw [SheafOfModules.unitHomEquiv_apply_coe]
      show σ X • (1 : R.obj.obj X) = s.1 X
      rw [smul_eq_mul, mul_one]
  have hcen : ∀ (m : 𝟭 (SheafOfModules.{u+1} (wcRingSheaf V'' ℓ)) ⟶
      𝟭 (SheafOfModules.{u+1} (wcRingSheaf V'' ℓ))) {A : SheafOfModules.{u+1} (wcRingSheaf V'' ℓ)}
      (z : Abelian.Ext A (SheafOfModules.unit (wcRingSheaf V'' ℓ)) n),
      (Abelian.Ext.mk₀ (m.app A)).comp z (zero_add n) =
        z.comp (Abelian.Ext.mk₀ (m.app (SheafOfModules.unit (wcRingSheaf V'' ℓ)))) (add_zero n) := by
    intro m A z
    have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp z m
    simp only [Abelian.Ext.id_mapExactFunctor] at h
    exact h.symm

  show (Abelian.Ext.mk₀ γ₁₂).comp ((Abelian.Ext.mapExactFunctor Dk.Φ θ).comp
      (Abelian.Ext.mk₀ Dk.μ.hom) (add_zero n)) (zero_add n) =
    (Abelian.Ext.mk₀ γ₂).comp ((Abelian.Ext.mapExactFunctor Df'.Φ
      ((Abelian.Ext.mk₀ γ₁).comp ((Abelian.Ext.mapExactFunctor Df.Φ θ).comp
        (Abelian.Ext.mk₀ Df.μ.hom) (add_zero n)) (zero_add n))).comp
      (Abelian.Ext.mk₀ Df'.μ.hom) (add_zero n)) (zero_add n)
  have nat' : (Abelian.Ext.mapExactFunctor Dk.Φ θ).comp
      (Abelian.Ext.mk₀ (ψ.hom.app (SheafOfModules.unit (wcRingSheaf V ℓ)))) (add_zero n) =
      (Abelian.Ext.mk₀ (ψ.hom.app (wcSuppObj D))).comp
        (Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Df'.Φ) θ) (zero_add n) :=
    Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp θ ψ.hom
  have step1 : (Abelian.Ext.mapExactFunctor Dk.Φ θ).comp (Abelian.Ext.mk₀ Dk.μ.hom) (add_zero n) =
      ((Abelian.Ext.mk₀ (ψ.hom.app (wcSuppObj D))).comp
        (Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Df'.Φ) θ) (zero_add n)).comp
        (Abelian.Ext.mk₀ (ψ.inv.app (SheafOfModules.unit (wcRingSheaf V ℓ)) ≫ Dk.μ.hom))
        (add_zero n) := by
    rw [← nat', h3, Iso.hom_inv_id_app_assoc]
  have hL : (Abelian.Ext.mk₀ γ₁₂).comp ((Abelian.Ext.mapExactFunctor Dk.Φ θ).comp
      (Abelian.Ext.mk₀ Dk.μ.hom) (add_zero n)) (zero_add n) =
      (Abelian.Ext.mk₀ (γ₁₂ ≫ ψ.hom.app (wcSuppObj D))).comp
        ((Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Df'.Φ) θ).comp
          (Abelian.Ext.mk₀ (ψ.inv.app (SheafOfModules.unit (wcRingSheaf V ℓ)) ≫ Dk.μ.hom))
          (add_zero n)) (zero_add n) := by
    rw [step1, h4, h2]
  have hR : (Abelian.Ext.mk₀ γ₂).comp ((Abelian.Ext.mapExactFunctor Df'.Φ
      ((Abelian.Ext.mk₀ γ₁).comp ((Abelian.Ext.mapExactFunctor Df.Φ θ).comp
        (Abelian.Ext.mk₀ Df.μ.hom) (add_zero n)) (zero_add n))).comp
      (Abelian.Ext.mk₀ Df'.μ.hom) (add_zero n)) (zero_add n) =
      (Abelian.Ext.mk₀ (γ₂ ≫ Df'.Φ.map γ₁)).comp
        ((Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Df'.Φ) θ).comp
          (Abelian.Ext.mk₀ (Df'.Φ.map Df.μ.hom ≫ Df'.μ.hom)) (add_zero n)) (zero_add n) := by
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_mapExactFunctor, h4, h3, h2]
  rw [hL, hR]

  obtain ⟨m, hm⟩ := hext ((Df'.μ.inv ≫ Df'.Φ.map Df.μ.inv) ≫
    ψ.inv.app (SheafOfModules.unit (wcRingSheaf V ℓ)) ≫ Dk.μ.hom)
  have hbb : (Df'.Φ.map Df.μ.hom ≫ Df'.μ.hom) ≫
      m.app (SheafOfModules.unit (wcRingSheaf V'' ℓ)) =
      ψ.inv.app (SheafOfModules.unit (wcRingSheaf V ℓ)) ≫ Dk.μ.hom := by
    rw [hm]
    simp only [Category.assoc, Iso.hom_inv_id_assoc]
    rw [← Functor.map_comp_assoc, Iso.hom_inv_id, CategoryTheory.Functor.map_id, Category.id_comp]

  have hmor : (γ₁₂ ≫ ψ.hom.app (wcSuppObj D)) ≫ m.app ((Df.Φ ⋙ Df'.Φ).obj (wcSuppObj D)) =
      γ₂ ≫ Df'.Φ.map γ₁ := by
    rw [← cancel_epi (wcSuppUnitMap D'')]
    have n1 := m.naturality (γ₁₂ ≫ ψ.hom.app (wcSuppObj D))
    have n2 := m.naturality (wcSuppUnitMap D'')
    have nψ := ψ.hom.naturality (wcSuppUnitMap D)
    simp only [Functor.id_map] at n1 n2
    rw [Functor.comp_map] at nψ
    calc wcSuppUnitMap D'' ≫ (γ₁₂ ≫ ψ.hom.app (wcSuppObj D)) ≫
          m.app ((Df.Φ ⋙ Df'.Φ).obj (wcSuppObj D))
        = (wcSuppUnitMap D'' ≫ m.app (wcSuppObj D'')) ≫ γ₁₂ ≫ ψ.hom.app (wcSuppObj D) := by
          rw [n1, Category.assoc]
      _ = m.app (SheafOfModules.unit (wcRingSheaf V'' ℓ)) ≫ wcSuppUnitMap D'' ≫ γ₁₂ ≫
          ψ.hom.app (wcSuppObj D) := by
          rw [n2, Category.assoc]
      _ = ((Df'.μ.inv ≫ Df'.Φ.map Df.μ.inv) ≫
            ψ.inv.app (SheafOfModules.unit (wcRingSheaf V ℓ)) ≫ Dk.μ.hom) ≫
          Dk.μ.inv ≫ Dk.Φ.map (wcSuppUnitMap D) ≫ ψ.hom.app (wcSuppObj D) := by
          rw [hm, reassoc_of% hγ₁₂]
      _ = ((Df'.μ.inv ≫ Df'.Φ.map Df.μ.inv) ≫
            ψ.inv.app (SheafOfModules.unit (wcRingSheaf V ℓ)) ≫ Dk.μ.hom) ≫
          Dk.μ.inv ≫ ψ.hom.app (SheafOfModules.unit (wcRingSheaf V ℓ)) ≫
            Df'.Φ.map (Df.Φ.map (wcSuppUnitMap D)) := by
          rw [nψ]
      _ = Df'.μ.inv ≫ Df'.Φ.map Df.μ.inv ≫ Df'.Φ.map (Df.Φ.map (wcSuppUnitMap D)) := by
          simp only [Category.assoc, Iso.hom_inv_id_assoc, Iso.inv_hom_id_app_assoc]
      _ = Df'.μ.inv ≫ Df'.Φ.map (wcSuppUnitMap D' ≫ γ₁) := by
          rw [hγ₁, Functor.map_comp]
      _ = wcSuppUnitMap D'' ≫ γ₂ ≫ Df'.Φ.map γ₁ := by
          rw [reassoc_of% hγ₂, Functor.map_comp]
  have hmove : (Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Df'.Φ) θ).comp
      (Abelian.Ext.mk₀ (ψ.inv.app (SheafOfModules.unit (wcRingSheaf V ℓ)) ≫ Dk.μ.hom))
      (add_zero n) =
      (Abelian.Ext.mk₀ (m.app ((Df.Φ ⋙ Df'.Φ).obj (wcSuppObj D)))).comp
        ((Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Df'.Φ) θ).comp
          (Abelian.Ext.mk₀ (Df'.Φ.map Df.μ.hom ≫ Df'.μ.hom)) (add_zero n)) (zero_add n) := by
    rw [← hbb]
    exact (h3 (Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Df'.Φ) θ) (Df'.Φ.map Df.μ.hom ≫ Df'.μ.hom)
      (m.app (SheafOfModules.unit (wcRingSheaf V'' ℓ)))).symm.trans (hcen m _).symm
  rw [hmove, h2, hmor]

theorem wc_slice_res_preserves_injective (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (V : S.ProEt)
    [(wcSliceFunctor S V).IsContinuous (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)]
    (I : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) [Injective I] :
    Injective ((wcSliceRes S ℓ V).obj I) :=
by
  classical
  let j := wcSliceFunctor S V
  let RS := (wcRingSheaf S ℓ).obj
  let RT := (wcRingSheaf V.left ℓ).obj
  let φs : wcRingSheaf V.left ℓ ⟶ (j.sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)).obj (wcRingSheaf S ℓ) := 𝟙 _
  let Rp := PresheafOfModules.pushforward.{u+1} (F := j) φs.hom

  have key : ∀ (A : PresheafOfModules.{u+1} RT) {Y : S.ProEt} {Z : V.left.ProEt}
      (b b' : Y ⟶ V) (_ : b = b') (m : wcXzObj S V b ⟶ Z) (m' : wcXzObj S V b' ⟶ Z)
      (_ : m.left = m'.left) (x : A.obj (Opposite.op Z)),
      DirectSum.of (fun c : Y ⟶ V => (A.obj (Opposite.op (wcXzObj S V c)) : Type (u+1))) b
        ((A.map m.op).hom x) =
      DirectSum.of (fun c : Y ⟶ V => (A.obj (Opposite.op (wcXzObj S V c)) : Type (u+1))) b'
        ((A.map m'.op).hom x) := by
    intro A Y Z b b' hb m m' hm x
    subst hb
    obtain rfl : m = m' := MorphismProperty.Over.Hom.ext hm
    rfl
  have hof : ∀ (A : PresheafOfModules.{u+1} RT) {X Y : S.ProEt} (g : Y ⟶ X) (a : X ⟶ V)
      (y : A.obj (Opposite.op (wcXzObj S V a))),
      wcXzMap S ℓ V A g
        (DirectSum.of (fun c : X ⟶ V => (A.obj (Opposite.op (wcXzObj S V c)) : Type (u+1))) a y) =
      DirectSum.of (fun c : Y ⟶ V => (A.obj (Opposite.op (wcXzObj S V c)) : Type (u+1))) (g ≫ a)
        ((A.map (wcXzRes S V g a).op).hom y) :=
    fun A X Y g a y => DirectSum.toAddMonoid_of _ _ _
  have hca : ∀ {X : S.ProEt} (a : X ⟶ V), wcXzC S V a ≫ wcXzPt S V (wcXzObj S V a) = a :=
    fun a => MorphismProperty.Over.Hom.ext (by exact Category.id_comp _)
  have hcpt : ∀ W : V.left.ProEt, wcXzC S V (wcXzPt S V W) = 𝟙 _ :=
    fun W => MorphismProperty.Over.Hom.ext rfl

  let sharpApp : ∀ (A : PresheafOfModules.{u+1} RT) (M : PresheafOfModules.{u+1} RS)
      (θ : A ⟶ Rp.obj M) (X : (S.ProEt)ᵒᵖ), wcXzSum S ℓ V A X.unop →+ M.obj X :=
    fun A M θ X => DirectSum.toAddMonoid (fun a =>
      (M.map (wcXzC S V a).op).hom.toAddMonoidHom.comp
        (θ.app (Opposite.op (wcXzObj S V a))).hom.toAddMonoidHom)
  have sharp_of : ∀ (A : PresheafOfModules.{u+1} RT) (M : PresheafOfModules.{u+1} RS)
      (θ : A ⟶ Rp.obj M) (X : (S.ProEt)ᵒᵖ) (a : X.unop ⟶ V)
      (y : A.obj (Opposite.op (wcXzObj S V a))),
      sharpApp A M θ X
        (DirectSum.of (fun c : X.unop ⟶ V => (A.obj (Opposite.op (wcXzObj S V c)) : Type (u+1))) a y) =
      (M.map (wcXzC S V a).op).hom ((θ.app (Opposite.op (wcXzObj S V a))).hom y) :=
    fun A M θ X a y => DirectSum.toAddMonoid_of _ _ _
  let sharpHom : ∀ (A : PresheafOfModules.{u+1} RT) (M : PresheafOfModules.{u+1} RS),
      (A ⟶ Rp.obj M) → (wcXzLp0 S ℓ V A ⟶ M) := fun A M θ =>
    PresheafOfModules.homMk
      { app := fun X => AddCommGrpCat.ofHom (sharpApp A M θ X)
        naturality := fun X Y f => by
          apply AddCommGrpCat.hom_ext
          apply DirectSum.addHom_ext
          intro a y
          show sharpApp A M θ Y (wcXzMap S ℓ V A f.unop (DirectSum.of _ a y)) =
            (M.map f).hom (sharpApp A M θ X (DirectSum.of _ a y))
          have hcc0 : wcXzC S V (f.unop ≫ a) ≫ j.map (wcXzRes S V f.unop a) =
              f.unop ≫ wcXzC S V a :=
            MorphismProperty.Over.Hom.ext
              (by exact (Category.id_comp _).trans (Category.comp_id _).symm)
          have hcc : (j.map (wcXzRes S V f.unop a)).op ≫ (wcXzC S V (f.unop ≫ a)).op =
              (wcXzC S V a).op ≫ f := by
            rw [← op_comp, hcc0, op_comp, Quiver.Hom.op_unop]
          rw [hof]
          refine (sharp_of A M θ Y (f.unop ≫ a) _).trans ?_
          refine Eq.trans ?_ (congrArg (M.map f).hom (sharp_of A M θ X a y)).symm
          refine (congrArg (M.map (wcXzC S V (f.unop ≫ a)).op).hom
            (PresheafOfModules.naturality_apply θ (wcXzRes S V f.unop a).op y)).trans ?_
          refine (PresheafOfModules.map_comp_apply M (j.map (wcXzRes S V f.unop a)).op
            (wcXzC S V (f.unop ≫ a)).op _).symm.trans ?_
          refine Eq.trans ?_ (PresheafOfModules.map_comp_apply M (wcXzC S V a).op f _)
          rw [hcc] }
      (by
        intro X r
        letI := wcXzSMod S ℓ V A X.unop
        show ∀ m : wcXzSum S ℓ V A X.unop, sharpApp A M θ X (r • m) = r • sharpApp A M θ X m
        intro m
        induction m using DirectSum.induction_on with
        | zero => rw [smul_zero, map_zero, smul_zero]
        | of a y =>
          have h2 : (r • DirectSum.of (fun b : X.unop ⟶ V =>
                (A.obj (Opposite.op (wcXzObj S V b)) : Type (u+1))) a y : wcXzSum S ℓ V A X.unop) =
              DirectSum.of (fun b : X.unop ⟶ V =>
                (A.obj (Opposite.op (wcXzObj S V b)) : Type (u+1))) a (r • y) :=
            (DirectSum.of_smul _ _ _ _).symm
          rw [h2, sharp_of, sharp_of]
          have h1 := (θ.app (Opposite.op (wcXzObj S V a))).hom.map_smul r y
          have h3 := PresheafOfModules.map_smul M (wcXzC S V a).op r
            ((θ.app (Opposite.op (wcXzObj S V a))).hom y)
          exact (congrArg (M.map (wcXzC S V a).op).hom h1).trans h3
        | add x y hx hy => rw [smul_add, map_add, map_add, hx, hy, smul_add])

  let flatHom : ∀ (A : PresheafOfModules.{u+1} RT) (M : PresheafOfModules.{u+1} RS),
      (wcXzLp0 S ℓ V A ⟶ M) → (A ⟶ Rp.obj M) := fun A M φ =>
    PresheafOfModules.homMk
      { app := fun W => AddCommGrpCat.ofHom
          ((φ.app (Opposite.op (j.obj W.unop))).hom.toAddMonoidHom.comp
            (DirectSum.of (fun c : j.obj W.unop ⟶ V =>
              (A.obj (Opposite.op (wcXzObj S V c)) : Type (u+1))) (wcXzPt S V W.unop)))
        naturality := fun W1 W2 g => by
          apply AddCommGrpCat.hom_ext
          apply AddMonoidHom.ext
          intro y
          show (φ.app (Opposite.op (j.obj W2.unop))).hom
              (DirectSum.of _ (wcXzPt S V W2.unop) ((A.map g).hom y)) =
            (M.map (j.map g.unop).op).hom ((φ.app (Opposite.op (j.obj W1.unop))).hom
              (DirectSum.of _ (wcXzPt S V W1.unop) y))
          refine Eq.trans ?_ (PresheafOfModules.naturality_apply φ (j.map g.unop).op _)
          refine congrArg (φ.app (Opposite.op (j.obj W2.unop))).hom ?_
          refine Eq.symm ((hof A (j.map g.unop) (wcXzPt S V W1.unop) y).trans ?_)
          have hb : j.map g.unop ≫ wcXzPt S V W1.unop = wcXzPt S V W2.unop :=
            MorphismProperty.Over.Hom.ext (by exact MorphismProperty.Over.w g.unop)
          exact key A (Z := W1.unop) _ _ hb (wcXzRes S V (j.map g.unop) (wcXzPt S V W1.unop))
            g.unop rfl y }
      (by
        intro W r y
        letI := wcXzSMod S ℓ V A (j.obj W.unop)
        exact (congrArg (φ.app (Opposite.op (j.obj W.unop))).hom
          (DirectSum.of_smul _ _ _ _)).trans
          ((φ.app (Opposite.op (j.obj W.unop))).hom.map_smul r _))

  have hmidM : ∀ (M : PresheafOfModules.{u+1} RS) {X : S.ProEt} (m : X ⟶ X), m = 𝟙 X →
      ∀ z : M.obj (Opposite.op X), (M.map m.op).hom z = z := by
    intro M X m hm z
    subst hm
    rw [op_id, ← PresheafOfModules.presheaf_map_apply_coe, M.presheaf.map_id]
    rfl
  have hmidA : ∀ (A : PresheafOfModules.{u+1} RT) {W : V.left.ProEt} (m : W ⟶ W), m = 𝟙 W →
      ∀ z : A.obj (Opposite.op W), (A.map m.op).hom z = z := by
    intro A W m hm z
    subst hm
    rw [op_id, ← PresheafOfModules.presheaf_map_apply_coe, A.presheaf.map_id]
    rfl
  have hcomp : ∀ (A : PresheafOfModules.{u+1} RT) {X : S.ProEt} (a : X ⟶ V)
      (z : A.obj (Opposite.op (wcXzObj S V a))),
      wcXzMap S ℓ V A (wcXzC S V a)
        (DirectSum.of (fun c : j.obj (wcXzObj S V a) ⟶ V =>
          (A.obj (Opposite.op (wcXzObj S V c)) : Type (u+1))) (wcXzPt S V (wcXzObj S V a)) z) =
      DirectSum.of (fun c : X ⟶ V => (A.obj (Opposite.op (wcXzObj S V c)) : Type (u+1))) a z := by
    intro A X a z
    refine (hof A (wcXzC S V a) (wcXzPt S V (wcXzObj S V a)) z).trans ?_
    refine (key A (Z := wcXzObj S V a) _ _ (hca a)
      (wcXzRes S V (wcXzC S V a) (wcXzPt S V (wcXzObj S V a))) (𝟙 (wcXzObj S V a)) rfl z).trans ?_
    exact congrArg _ (hmidA A (𝟙 _) rfl z)

  have hls : ∀ (A : PresheafOfModules.{u+1} RT) (M : PresheafOfModules.{u+1} RS)
      (φ : wcXzLp0 S ℓ V A ⟶ M), sharpHom A M (flatHom A M φ) = φ := by
    intro A M φ
    apply PresheafOfModules.hom_ext
    intro X
    apply ModuleCat.hom_ext
    apply LinearMap.toAddMonoidHom_injective
    apply DirectSum.addHom_ext
    intro a y
    show sharpApp A M (flatHom A M φ) X (DirectSum.of _ a y) = (φ.app X).hom (DirectSum.of _ a y)
    refine (sharp_of A M (flatHom A M φ) X a y).trans ?_
    show (M.map (wcXzC S V a).op).hom ((φ.app (Opposite.op (j.obj (wcXzObj S V a)))).hom
      (DirectSum.of _ (wcXzPt S V (wcXzObj S V a)) y)) = _
    refine (PresheafOfModules.naturality_apply φ (wcXzC S V a).op _).symm.trans ?_
    exact congrArg (φ.app X).hom (hcomp A a y)
  have hrs : ∀ (A : PresheafOfModules.{u+1} RT) (M : PresheafOfModules.{u+1} RS)
      (θ : A ⟶ Rp.obj M), flatHom A M (sharpHom A M θ) = θ := by
    intro A M θ
    apply PresheafOfModules.hom_ext
    intro W
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro y
    show sharpApp A M θ (Opposite.op (j.obj W.unop)) (DirectSum.of _ (wcXzPt S V W.unop) y) =
      (θ.app W).hom y
    refine (sharp_of A M θ (Opposite.op (j.obj W.unop)) (wcXzPt S V W.unop) y).trans ?_
    exact hmidM M (X := j.obj W.unop) (wcXzC S V (wcXzPt S V W.unop)) (hcpt W.unop) _
  let e : ∀ (A : PresheafOfModules.{u+1} RT) (M : PresheafOfModules.{u+1} RS),
      (wcXzLp0 S ℓ V A ⟶ M) ≃ (A ⟶ Rp.obj M) := fun A M =>
    { toFun := flatHom A M
      invFun := sharpHom A M
      left_inv := hls A M
      right_inv := hrs A M }
  have he : ∀ (A : PresheafOfModules.{u+1} RT) (M M' : PresheafOfModules.{u+1} RS)
      (g : M ⟶ M') (h : wcXzLp0 S ℓ V A ⟶ M), e A M' (h ≫ g) = e A M h ≫ Rp.map g := by
    intro A M M' g h
    apply PresheafOfModules.hom_ext
    intro W
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro y
    rfl
  let Lp := Adjunction.leftAdjointOfEquiv (G := Rp) (F_obj := wcXzLp0 S ℓ V) e he
  let adjP : Lp ⊣ Rp := Adjunction.adjunctionOfEquivLeft e he
  haveI hmono : Lp.PreservesMonomorphisms := ⟨fun {A A'} f hf => by
    have hf' := (PresheafOfModules.mono_iff_surjective f).1 hf
    apply PresheafOfModules.mono_of_injective
    intro X
    have hLmap : Lp.map f = sharpHom A (wcXzLp0 S ℓ V A')
        (f ≫ flatHom A' (wcXzLp0 S ℓ V A') (𝟙 _)) :=
      Adjunction.leftAdjointOfEquiv_map e he f
    have hEq : ((Lp.map f).app X).hom.toAddMonoidHom =
        DirectSum.map (fun a : X.unop ⟶ V =>
          (f.app (Opposite.op (wcXzObj S V a))).hom.toAddMonoidHom) := by
      apply DirectSum.addHom_ext
      intro a y
      refine Eq.trans ?_ (DirectSum.map_of (fun a : X.unop ⟶ V =>
          (f.app (Opposite.op (wcXzObj S V a))).hom.toAddMonoidHom) a y).symm
      rw [hLmap]
      show sharpApp A (wcXzLp0 S ℓ V A') (f ≫ flatHom A' (wcXzLp0 S ℓ V A') (𝟙 _)) X
        (DirectSum.of _ a y) = _
      refine (sharp_of A _ _ X a y).trans ?_
      exact hcomp A' a ((f.app (Opposite.op (wcXzObj S V a))).hom y)
    intro x y hxy
    have h2 : (DirectSum.map (fun a : X.unop ⟶ V =>
        (f.app (Opposite.op (wcXzObj S V a))).hom.toAddMonoidHom)) x =
        (DirectSum.map (fun a : X.unop ⟶ V =>
        (f.app (Opposite.op (wcXzObj S V a))).hom.toAddMonoidHom)) y := by
      rw [← hEq]
      exact hxy
    exact (DirectSum.map_injective _).2 (fun a => hf' (X := Opposite.op (wcXzObj S V a))) h2⟩

  have s1 : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (J : GrothendieckTopology C)
      (K : GrothendieckTopology D) [HasSheafify K AddCommGrpCat.{u+1}]
      [K.WEqualsLocallyBijective AddCommGrpCat.{u+1}] (F : C ⥤ D) [F.IsContinuous J K]
      (S₀ : Sheaf J RingCat.{u+1}) (R₀ : Sheaf K RingCat.{u+1})
      (φ : S₀ ⟶ (F.sheafPushforwardContinuous RingCat.{u+1} J K).obj R₀)
      (L₀ : PresheafOfModules.{u+1} S₀.obj ⥤ PresheafOfModules.{u+1} R₀.obj)
      (_ : L₀ ⊣ PresheafOfModules.pushforward.{u+1} (F := F) φ.hom) [L₀.PreservesMonomorphisms]
      (I₀ : SheafOfModules.{u+1} R₀) [Injective I₀],
      Injective ((SheafOfModules.pushforward.{u+1} φ).obj I₀) := by
    intro C D _ _ J K _ _ F _ S₀ R₀ φ L₀ adj₀ _ I₀ _
    let adjS := adj₀.comp (PresheafOfModules.sheafificationAdjunction.{u+1} (𝟙 R₀.obj))
    let adjL := Adjunction.restrictFullyFaithful
      (iC := SheafOfModules.forget S₀) (iD := 𝟭 (SheafOfModules.{u+1} R₀))
      (L := SheafOfModules.forget S₀ ⋙ L₀ ⋙ PresheafOfModules.sheafification.{u+1} (𝟙 R₀.obj))
      (R := SheafOfModules.pushforward.{u+1} φ)
      adjS (SheafOfModules.fullyFaithfulForget _) (Functor.FullyFaithful.id _)
      (Iso.refl _) (Iso.refl _)
    exact Injective.injective_of_adjoint adjL I₀
  exact s1 (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S) j
    (wcRingSheaf V.left ℓ) (wcRingSheaf S ℓ) φs Lp adjP I

theorem wc_open_slice_res_preserves_injective {V : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (Vo : V.ProEt) [IsOpenImmersion Vo.hom]
    [(wcSliceFunctor V Vo).IsContinuous (Scheme.ProEt.topology Vo.left) (Scheme.ProEt.topology V)]
    (I : SheafOfModules.{u+1} (wcRingSheaf V ℓ)) [Injective I] :
    Injective ((wcSliceRes V ℓ Vo).obj I) :=
by
  exact wc_slice_res_preserves_injective V ℓ Vo I

theorem wc_open_slice_res_supp_hom_injective {T V : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (i : T ⟶ V) [IsClosedImmersion i] [IsLocallyNoetherian V]
    (Vo : V.ProEt) [IsOpenImmersion Vo.hom]
    [(wcSliceFunctor V Vo).IsContinuous (Scheme.ProEt.topology Vo.left) (Scheme.ProEt.topology V)]
    (iW : T ⟶ Vo.left) (hiW : iW ≫ Vo.hom = i)
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di) (DiW : wcHMPullData iW ℓ)
    (μ : (wcSliceRes V ℓ Vo).obj (SheafOfModules.unit (wcRingSheaf V ℓ)) ≅
      SheafOfModules.unit (wcRingSheaf Vo.left ℓ))
    (γ : wcSuppObj DiW ⟶ (wcSliceRes V ℓ Vo).obj (wcSuppObj Di))
    (hγ : wcSuppUnitMap DiW ≫ γ = μ.inv ≫ (wcSliceRes V ℓ Vo).map (wcSuppUnitMap Di))
    (N : SheafOfModules.{u+1} (wcRingSheaf V ℓ)) :
    Function.Injective (fun f : wcSuppObj Di ⟶ N => γ ≫ (wcSliceRes V ℓ Vo).map f) :=
by
  classical

  haveI hepi := wc_supp_unit_epi_of_noetherian i ℓ Di hDi
  intro f₁ f₂ H
  have H' : γ ≫ (wcSliceRes V ℓ Vo).map f₁ = γ ≫ (wcSliceRes V ℓ Vo).map f₂ := H

  have e : μ.hom ≫ wcSuppUnitMap DiW ≫ γ = (wcSliceRes V ℓ Vo).map (wcSuppUnitMap Di) := by
    rw [hγ, Iso.hom_inv_id_assoc]
  have hres : (wcSliceRes V ℓ Vo).map (wcSuppUnitMap Di ≫ f₁) =
      (wcSliceRes V ℓ Vo).map (wcSuppUnitMap Di ≫ f₂) := by
    rw [Functor.map_comp, Functor.map_comp, ← e]
    simp only [Category.assoc]
    rw [H']

  have unit_ext : ∀ (w₁ w₂ : SheafOfModules.unit (wcRingSheaf V ℓ) ⟶ N),
      (∀ U : V.ProEt, (w₁.val.app (Opposite.op U)).hom (1 : C(↥U.left, ULift.{u+1} ℚ_[ℓ])) =
        (w₂.val.app (Opposite.op U)).hom (1 : C(↥U.left, ULift.{u+1} ℚ_[ℓ]))) → w₁ = w₂ := by
    intro w₁ w₂ h
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro X
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro a
    induction X using Opposite.rec with
    | op U =>
    let a' : C(↥U.left, ULift.{u+1} ℚ_[ℓ]) := a
    show (w₁.val.app (Opposite.op U)).hom a' = (w₂.val.app (Opposite.op U)).hom a'
    have e1 : (w₁.val.app (Opposite.op U)).hom a' = (w₁.val.app (Opposite.op U)).hom (a' * 1) :=
      congrArg (fun y => (w₁.val.app (Opposite.op U)).hom y) (mul_one a').symm
    have e2 : (w₂.val.app (Opposite.op U)).hom a' = (w₂.val.app (Opposite.op U)).hom (a' * 1) :=
      congrArg (fun y => (w₂.val.app (Opposite.op U)).hom y) (mul_one a').symm
    have s1 := (w₁.val.app (Opposite.op U)).hom.map_smul a' (1 : C(↥U.left, ULift.{u+1} ℚ_[ℓ]))
    have s2 := (w₂.val.app (Opposite.op U)).hom.map_smul a' (1 : C(↥U.left, ULift.{u+1} ℚ_[ℓ]))
    refine (e1.trans s1).trans ?_
    refine Eq.trans ?_ (e2.trans s2).symm
    rw [h U]

  have res1 : ∀ (w : SheafOfModules.unit (wcRingSheaf V ℓ) ⟶ N) {U Y : V.ProEt} (e : Y ⟶ U),
      (N.val.map e.op).hom ((w.val.app (Opposite.op U)).hom (1 : C(↥U.left, ULift.{u+1} ℚ_[ℓ]))) =
        (w.val.app (Opposite.op Y)).hom (1 : C(↥Y.left, ULift.{u+1} ℚ_[ℓ])) := by
    intro w U Y e
    have h1 : ((SheafOfModules.unit (wcRingSheaf V ℓ)).val.map e.op).hom
        (1 : C(↥U.left, ULift.{u+1} ℚ_[ℓ])) = (1 : C(↥Y.left, ULift.{u+1} ℚ_[ℓ])) := by
      change (1 : C(↥U.left, ULift.{u+1} ℚ_[ℓ])).comp e.left.base.hom = 1
      exact ContinuousMap.one_comp _
    refine (PresheafOfModules.naturality_apply w.val e.op _).symm.trans ?_
    exact congrArg (fun y => (w.val.app (Opposite.op Y)).hom y) h1

  have vanish : ∀ (Y : V.ProEt), (∀ x : ↥Y.left, Y.hom x ∉ Set.range i) →
      ((wcSuppUnitMap Di).val.app (Opposite.op Y)).hom (1 : C(↥Y.left, ULift.{u+1} ℚ_[ℓ])) = 0 := by
    intro Y hY
    have hempty : ∀ z : ↥(Limits.pullback Y.hom i), False := by
      intro z
      have e : (Limits.pullback.fst Y.hom i ≫ Y.hom) z = (Limits.pullback.snd Y.hom i ≫ i) z := by
        rw [Limits.pullback.condition]
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at e
      exact hY (Limits.pullback.fst Y.hom i z) ⟨Limits.pullback.snd Y.hom i z, e.symm⟩
    change (((wcSuppUnitMap Di).val.app (Opposite.op Y)).hom (1 : C(↥Y.left, ULift.{u+1} ℚ_[ℓ])) :
      C(↥(Limits.pullback Y.hom i), ULift.{u+1} ℚ_[ℓ])) = 0
    exact ContinuousMap.ext (fun z => (hempty z).elim)

  have caseA : ∀ (w₁ w₂ : SheafOfModules.unit (wcRingSheaf V ℓ) ⟶ N),
      (wcSliceRes V ℓ Vo).map w₁ = (wcSliceRes V ℓ Vo).map w₂ →
      ∀ (Y : V.ProEt), Set.range Y.hom ⊆ Set.range Vo.hom →
      (w₁.val.app (Opposite.op Y)).hom (1 : C(↥Y.left, ULift.{u+1} ℚ_[ℓ])) =
        (w₂.val.app (Opposite.op Y)).hom (1 : C(↥Y.left, ULift.{u+1} ℚ_[ℓ])) := by
    intro w₁ w₂ hw Y hY
    let l : Y.left ⟶ Vo.left := IsOpenImmersion.lift Vo.hom Y.hom hY
    have hl : l ≫ Vo.hom = Y.hom := IsOpenImmersion.lift_fac _ _ _
    haveI : WeaklyEtale Vo.hom := Vo.prop
    haveI : WeaklyEtale (l ≫ Vo.hom) := by rw [hl]; exact Y.prop
    haveI : WeaklyEtale l := WeaklyEtale.of_comp l Vo.hom
    let Y' : Vo.left.ProEt := Scheme.ProEt.mk l
    let φ : Y ⟶ (wcSliceFunctor V Vo).obj Y' :=
      MorphismProperty.Over.homMk (𝟙 Y.left) (by
        change 𝟙 Y.left ≫ (l ≫ Vo.hom) = Y.hom
        rw [Category.id_comp, hl]) trivial
    have hw' : (w₁.val.app (Opposite.op ((wcSliceFunctor V Vo).obj Y'))).hom
        (1 : C(↥((wcSliceFunctor V Vo).obj Y').left, ULift.{u+1} ℚ_[ℓ])) =
        (w₂.val.app (Opposite.op ((wcSliceFunctor V Vo).obj Y'))).hom
        (1 : C(↥((wcSliceFunctor V Vo).obj Y').left, ULift.{u+1} ℚ_[ℓ])) :=
      congrArg (fun ψ : (wcSliceRes V ℓ Vo).obj (SheafOfModules.unit (wcRingSheaf V ℓ)) ⟶
          (wcSliceRes V ℓ Vo).obj N =>
        (ψ.val.app (Opposite.op Y')).hom (1 : C(↥Y'.left, ULift.{u+1} ℚ_[ℓ]))) hw
    exact (res1 w₁ φ).symm.trans
      ((congrArg (fun y => (N.val.map φ.op).hom y) hw').trans (res1 w₂ φ))

  apply (cancel_epi (wcSuppUnitMap Di)).mp
  apply unit_ext
  intro U
  let m : N.val.obj (Opposite.op U) :=
    ((wcSuppUnitMap Di ≫ f₁).val.app (Opposite.op U)).hom (1 : C(↥U.left, ULift.{u+1} ℚ_[ℓ])) -
      ((wcSuppUnitMap Di ≫ f₂).val.app (Opposite.op U)).hom (1 : C(↥U.left, ULift.{u+1} ℚ_[ℓ]))

  let T0 : Sieve U :=
    { arrows := fun _ e => (N.val.map e.op).hom m = 0
      downward_closed := by
        intro Y Z f hf g
        have hf' : (N.val.map f.op).hom m = 0 := hf
        show (N.val.map (g ≫ f).op).hom m = 0
        rw [op_comp, PresheafOfModules.map_comp, ModuleCat.hom_comp, LinearMap.comp_apply, hf',
          map_zero] }

  have hR : ∀ y : ↥U.left, ∃ O : U.left.Opens, y ∈ O ∧
      ∀ (Y : V.ProEt) (e : Y ⟶ U), Set.range e.left ⊆ (O : Set ↥U.left) → T0.arrows e := by
    intro y
    by_cases hy : U.hom y ∈ Set.range Vo.hom
    · refine ⟨U.hom ⁻¹ᵁ Vo.hom.opensRange,
        (Scheme.Hom.mem_preimage U.hom).mpr (by rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange]; exact hy), ?_⟩
      intro Y e he
      have hYr : Set.range Y.hom ⊆ Set.range Vo.hom := by
        rintro _ ⟨x, rfl⟩
        have hx : e.left x ∈ U.hom ⁻¹ᵁ Vo.hom.opensRange := he ⟨x, rfl⟩
        have hx' := (Scheme.Hom.mem_preimage U.hom).mp hx
        rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange] at hx'
        have htri : U.hom (e.left x) = Y.hom x := by
          rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w e]
        rw [← htri]; exact hx'
      show (N.val.map e.op).hom m = 0
      have hA := caseA (wcSuppUnitMap Di ≫ f₁) (wcSuppUnitMap Di ≫ f₂) hres Y hYr
      rw [map_sub, res1, res1, hA]
      exact sub_self _
    · have hyi : U.hom y ∉ Set.range i := by
        rintro ⟨t, ht⟩
        exact hy ⟨iW t, by rw [← ht, ← hiW, Scheme.Hom.comp_apply]⟩
      let OT : V.Opens := ⟨(Set.range i)ᶜ, i.isClosedEmbedding.isClosed_range.isOpen_compl⟩
      refine ⟨U.hom ⁻¹ᵁ OT, (Scheme.Hom.mem_preimage U.hom).mpr hyi, ?_⟩
      intro Y e he
      have hYi : ∀ x : ↥Y.left, Y.hom x ∉ Set.range i := by
        intro x
        have hx : e.left x ∈ U.hom ⁻¹ᵁ OT := he ⟨x, rfl⟩
        have hx' := (Scheme.Hom.mem_preimage U.hom).mp hx
        have htri : U.hom (e.left x) = Y.hom x := by
          rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w e]
        rw [← htri]; exact hx'
      have z1 : ((wcSuppUnitMap Di ≫ f₁).val.app (Opposite.op Y)).hom
          (1 : C(↥Y.left, ULift.{u+1} ℚ_[ℓ])) = 0 := by
        change (f₁.val.app (Opposite.op Y)).hom (((wcSuppUnitMap Di).val.app (Opposite.op Y)).hom
          (1 : C(↥Y.left, ULift.{u+1} ℚ_[ℓ]))) = 0
        rw [vanish Y hYi, map_zero]
      have z2 : ((wcSuppUnitMap Di ≫ f₂).val.app (Opposite.op Y)).hom
          (1 : C(↥Y.left, ULift.{u+1} ℚ_[ℓ])) = 0 := by
        change (f₂.val.app (Opposite.op Y)).hom (((wcSuppUnitMap Di).val.app (Opposite.op Y)).hom
          (1 : C(↥Y.left, ULift.{u+1} ℚ_[ℓ]))) = 0
        rw [vanish Y hYi, map_zero]
      show (N.val.map e.op).hom m = 0
      rw [map_sub, res1, res1, z1, z2]
      exact sub_self _

  have hcov : T0 ∈ Scheme.ProEt.topology V U := by
    choose O hyO hO using hR
    haveI : WeaklyEtale U.hom := U.prop
    let W' : ULift.{u+1} U.left → V.ProEt := fun j =>
      Scheme.ProEt.mk ((O j.down).ι ≫ U.hom)
    let fa : ∀ j, W' j ⟶ U := fun j => MorphismProperty.Over.homMk (O j.down).ι rfl trivial
    have hcv : ∀ x : ↥U.left, ∃ (j : ULift.{u+1} U.left) (y : ↥(O j.down).toScheme),
        (O j.down).ι y = x := fun x =>
      ⟨ULift.up x, ⟨x, hyO x⟩, Scheme.Opens.ι_apply _ _⟩
    let 𝒰 : Scheme.Cover (Scheme.precoverage @WeaklyEtale) U.left :=
      Scheme.Cover.mkOfCovers (P := @WeaklyEtale) (ULift.{u+1} U.left)
        (fun j => (O j.down).toScheme) (fun j => (O j.down).ι) hcv (fun j => inferInstance)
    have hqc : QuasiCompactCover 𝒰.toPreZeroHypercover :=
      @QuasiCompactCover.of_isOpenMap _ _ 𝒰 Scheme.instJointlySurjectivePrecoverage
        (fun j => (Scheme.Hom.isOpenEmbedding (O j.down).ι).isOpenMap)
    have hRb : Presieve.ofArrows (fun j : ULift.{u+1} U.left => (O j.down).toScheme)
        (fun j => (O j.down).ι) ∈ Scheme.proetalePrecoverage.coverings U.left :=
      Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover.mpr ⟨𝒰, hqc, rfl⟩
    have e := Presieve.map_ofArrows (F := Scheme.ProEt.forget V ⋙ Over.forget V) (Y := W') fa
    have hR' : Presieve.ofArrows W' fa ∈ (Scheme.ProEt.precoverage V).coverings U :=
      Precoverage.mem_comap_iff.mpr (e ▸ hRb)
    have hRJ : Sieve.generate (Presieve.ofArrows W' fa) ∈ (Scheme.ProEt.topology V) U :=
      Precoverage.generate_mem_toGrothendieck hR'
    refine (Scheme.ProEt.topology V).superset_covering ?_ hRJ
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨j⟩
    apply hO j.down
    change Set.range (O j.down).ι ⊆ _
    rw [Scheme.Opens.range_ι]

  have hm : m = 0 := by
    refine N.isSheaf.isSeparated U T0 hcov m 0 ?_
    intro Y g hg
    have hg' : (N.val.map g.op).hom m = 0 := hg
    change (N.val.map g.op).hom m = (N.val.map g.op).hom 0
    rw [map_zero]
    exact hg'
  exact sub_eq_zero.mp hm

theorem wc_open_slice_res_supp_hom_surjective {T V : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (i : T ⟶ V) [IsClosedImmersion i] [IsLocallyNoetherian V]
    (Vo : V.ProEt) [IsOpenImmersion Vo.hom]
    [(wcSliceFunctor V Vo).IsContinuous (Scheme.ProEt.topology Vo.left) (Scheme.ProEt.topology V)]
    (iW : T ⟶ Vo.left) (hiW : iW ≫ Vo.hom = i)
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di) (DiW : wcHMPullData iW ℓ)
    (hepi : Epi (wcSuppUnitMap DiW))
    (μ : (wcSliceRes V ℓ Vo).obj (SheafOfModules.unit (wcRingSheaf V ℓ)) ≅
      SheafOfModules.unit (wcRingSheaf Vo.left ℓ))
    (γ : wcSuppObj DiW ⟶ (wcSliceRes V ℓ Vo).obj (wcSuppObj Di))
    (hγ : wcSuppUnitMap DiW ≫ γ = μ.inv ≫ (wcSliceRes V ℓ Vo).map (wcSuppUnitMap Di))
    (N : SheafOfModules.{u+1} (wcRingSheaf V ℓ)) :
    Function.Surjective (fun f : wcSuppObj Di ⟶ N => γ ≫ (wcSliceRes V ℓ Vo).map f) :=
by
  classical
  intro h
  haveI : Epi (wcSuppUnitMap Di) := wc_supp_unit_epi_of_noetherian i ℓ Di hDi
  haveI := hepi
  haveI hVoW : WeaklyEtale Vo.hom := Vo.prop
  haveI : Mono Vo.hom := inferInstance
  let jV : Vo.left ⟶ V := Vo.hom
