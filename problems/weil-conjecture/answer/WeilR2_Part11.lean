    simp only [Category.assoc]
    rw [reassoc_of% hp', hz', hαW, ← Spec.map_comp, ← Spec.map_comp, ← Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    congr 2
    ext x
    have e := RingHom.congr_fun hcompat ((Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom x)
