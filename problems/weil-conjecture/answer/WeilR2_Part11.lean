theorem wc_supp_pull_comp_exists {T V T' V' T'' V'' : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    {i : T ⟶ V} {i' : T' ⟶ V'} {i'' : T'' ⟶ V''}
    (f : V' ⟶ V) (f' : V'' ⟶ V') (k : V'' ⟶ V) (hk : f' ≫ f = k)
    (D : wcHMPullData i ℓ) (D' : wcHMPullData i' ℓ) (D'' : wcHMPullData i'' ℓ)
    (Df : wcHMPullData f ℓ) (hDf : wcHMPullCanonical Df)
    (Df' : wcHMPullData f' ℓ) (hDf' : wcHMPullCanonical Df')
    (Dk : wcHMPullData k ℓ) (hDk : wcHMPullCanonical Dk)
    (γ₁ : wcSuppObj D' ⟶ Df.Φ.obj (wcSuppObj D))
    (hγ₁ : wcSuppUnitMap D' ≫ γ₁ = Df.μ.inv ≫ Df.Φ.map (wcSuppUnitMap D))
    (γ₂ : wcSuppObj D'' ⟶ Df'.Φ.obj (wcSuppObj D'))
    (hγ₂ : wcSuppUnitMap D'' ≫ γ₂ = Df'.μ.inv ≫ Df'.Φ.map (wcSuppUnitMap D')) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V' ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V'' ℓ)) := HasExt.standard _
    ∃ γ₁₂ : wcSuppObj D'' ⟶ Dk.Φ.obj (wcSuppObj D),
      wcSuppUnitMap D'' ≫ γ₁₂ = Dk.μ.inv ≫ Dk.Φ.map (wcSuppUnitMap D) ∧
      ∀ (n : ℕ) (θ : wcSuppExt D n),
        (Abelian.Ext.mk₀ γ₁₂).comp (wcSuppPullExt D Dk n θ) (zero_add _) =
          (Abelian.Ext.mk₀ γ₂).comp (wcSuppPullExt D' Df' n
            ((Abelian.Ext.mk₀ γ₁).comp (wcSuppPullExt D Df n θ) (zero_add _))) (zero_add _) :=
by
  classical
  subst hk

  have hmap : ∀ {A B : Scheme.{u}} (h : A ⟶ B) {W W' : B.ProEt} (u : W ⟶ W'),
      ((wcProEtBC h).map u).left ≫ Limits.pullback.fst W'.hom h =
        Limits.pullback.fst W.hom h ≫ u.left ∧
      ((wcProEtBC h).map u).left ≫ Limits.pullback.snd W'.hom h = Limits.pullback.snd W.hom h := by
    intro A B h W W' u
    exact ⟨Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hsnd : ∀ W : V.ProEt, (Limits.pullbackLeftPullbackSndIso W.hom f f').symm.hom ≫
      Limits.pullback.snd (Limits.pullback.snd W.hom f) f' =
        Limits.pullback.snd W.hom (f' ≫ f) := by
    intro W
    rw [Iso.symm_hom, Iso.inv_comp_eq, Limits.pullbackLeftPullbackSndIso_hom_snd]
  choose c hc using fun W : V.ProEt =>
    (⟨MorphismProperty.Over.isoMk (A := (wcProEtBC (f' ≫ f)).obj W)
        (B := (wcProEtBC f ⋙ wcProEtBC f').obj W)
        (Limits.pullbackLeftPullbackSndIso W.hom f f').symm (hsnd W),
      MorphismProperty.Over.isoMk_hom_left _ _⟩ :
      ∃ c : (wcProEtBC (f' ≫ f)).obj W ≅ (wcProEtBC f ⋙ wcProEtBC f').obj W,
        c.hom.left = (Limits.pullbackLeftPullbackSndIso W.hom f f').inv)
  have nat : ∀ {W W' : V.ProEt} (u : W ⟶ W'),
      (wcProEtBC (f' ≫ f)).map u ≫ (c W').hom =
        (c W).hom ≫ (wcProEtBC f ⋙ wcProEtBC f').map u := by
    intro W W' u
    have key : ∀ (L : Limits.pullback W.hom (f' ≫ f) ⟶ Limits.pullback W'.hom (f' ≫ f))
        (M1 : Limits.pullback W.hom f ⟶ Limits.pullback W'.hom f)
        (M2 : Limits.pullback (Limits.pullback.snd W.hom f) f' ⟶
          Limits.pullback (Limits.pullback.snd W'.hom f) f'),
        L ≫ Limits.pullback.fst W'.hom (f' ≫ f) = Limits.pullback.fst W.hom (f' ≫ f) ≫ u.left →
        L ≫ Limits.pullback.snd W'.hom (f' ≫ f) = Limits.pullback.snd W.hom (f' ≫ f) →
        M1 ≫ Limits.pullback.fst W'.hom f = Limits.pullback.fst W.hom f ≫ u.left →
        M1 ≫ Limits.pullback.snd W'.hom f = Limits.pullback.snd W.hom f →
        M2 ≫ Limits.pullback.fst (Limits.pullback.snd W'.hom f) f' =
          Limits.pullback.fst (Limits.pullback.snd W.hom f) f' ≫ M1 →
        M2 ≫ Limits.pullback.snd (Limits.pullback.snd W'.hom f) f' =
          Limits.pullback.snd (Limits.pullback.snd W.hom f) f' →
        L ≫ (Limits.pullbackLeftPullbackSndIso W'.hom f f').inv =
          (Limits.pullbackLeftPullbackSndIso W.hom f f').inv ≫ M2 := by
      intro L M1 M2 hL1 hL2 hM1 _ hM2 hM2'
      rw [Iso.comp_inv_eq, Category.assoc, Iso.eq_inv_comp]
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hL1, Category.assoc, Limits.pullbackLeftPullbackSndIso_hom_fst,
          reassoc_of% hM2, hM1, reassoc_of% (Limits.pullbackLeftPullbackSndIso_hom_fst W.hom f f')]
      · rw [Category.assoc, hL2, Limits.pullbackLeftPullbackSndIso_hom_snd, Category.assoc,
          Limits.pullbackLeftPullbackSndIso_hom_snd, hM2']
    apply MorphismProperty.Over.Hom.ext
    change ((wcProEtBC (f' ≫ f)).map u).left ≫ (c W').hom.left =
      (c W).hom.left ≫ ((wcProEtBC f').map ((wcProEtBC f).map u)).left
    rw [hc W, hc W']
    exact key _ _ _ (hmap (f' ≫ f) u).1 (hmap (f' ≫ f) u).2 (hmap f u).1 (hmap f u).2
      (hmap f' ((wcProEtBC f).map u)).1 (hmap f' ((wcProEtBC f).map u)).2
  let α : wcProEtBC (f' ≫ f) ≅ wcProEtBC f ⋙ wcProEtBC f' := NatIso.ofComponents c nat
  have hα : ∀ (W : V.ProEt) (z : ↥((wcProEtBC (f' ≫ f)).obj W).left),
      (Limits.pullback.fst W.hom f) ((Limits.pullback.fst (Limits.pullback.snd W.hom f) f')
        ((α.hom.app W).left z)) = (Limits.pullback.fst W.hom (f' ≫ f)) z := by
    intro W z
    change (Limits.pullback.fst W.hom f) ((Limits.pullback.fst (Limits.pullback.snd W.hom f) f')
      ((c W).hom.left z)) = _
    rw [hc W]
    have key : ∀ z' : ↥(Limits.pullback W.hom (f' ≫ f)),
        (Limits.pullback.fst W.hom f) ((Limits.pullback.fst (Limits.pullback.snd W.hom f) f')
          ((Limits.pullbackLeftPullbackSndIso W.hom f f').inv z')) =
        (Limits.pullback.fst W.hom (f' ≫ f)) z' := by
      intro z'
      calc (Limits.pullback.fst W.hom f) ((Limits.pullback.fst (Limits.pullback.snd W.hom f) f')
            ((Limits.pullbackLeftPullbackSndIso W.hom f f').inv z'))
          = ((Limits.pullbackLeftPullbackSndIso W.hom f f').inv ≫
              Limits.pullback.fst (Limits.pullback.snd W.hom f) f' ≫
                Limits.pullback.fst W.hom f) z' := rfl
        _ = (Limits.pullback.fst W.hom (f' ≫ f)) z' := by
          rw [Limits.pullbackLeftPullbackSndIso_inv_fst]
    exact key z
  haveI := Df.cont
  haveI := Df'.cont
  haveI := Dk.cont
  haveI : (wcProEtBC f ⋙ wcProEtBC f').IsContinuous (Scheme.ProEt.topology V)
      (Scheme.ProEt.topology V'') :=
    Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology V') _
  let τ := (Functor.sheafPushforwardContinuousNatTrans α.hom RingCat.{u+1}
    (Scheme.ProEt.topology V) (Scheme.ProEt.topology V'')).app (wcRingSheaf V'' ℓ)
  let φfg : wcRingSheaf V ℓ ⟶ ((wcProEtBC f ⋙ wcProEtBC f').sheafPushforwardContinuous
      RingCat.{u+1} (Scheme.ProEt.topology V) (Scheme.ProEt.topology V'')).obj
        (wcRingSheaf V'' ℓ) :=
    Df.φ ≫ ((wcProEtBC f).sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.ProEt.topology V) (Scheme.ProEt.topology V')).map Df'.φ
  have hcompat : φfg ≫ τ = Dk.φ := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext W
    induction W using Opposite.rec with
    | op W =>
    apply RingCat.hom_ext
    apply RingHom.ext
    intro s
    rw [hDk W s]
    apply ContinuousMap.ext
    intro z
    refine (congrArg (fun h : C(↥(Limits.pullback (Limits.pullback.snd W.hom f) f'),
        ULift.{u+1} ℚ_[ℓ]) => h ((α.hom.app W).left.base z))
      (hDf' ((wcProEtBC f).obj W) ((Df.φ.hom.app (Opposite.op W)).hom s :
        C(↥(Limits.pullback W.hom f), ULift.{u+1} ℚ_[ℓ])))).trans ?_
    refine (congrArg (fun h : C(↥(Limits.pullback W.hom f), ULift.{u+1} ℚ_[ℓ]) =>
        h ((Limits.pullback.fst (Limits.pullback.snd W.hom f) f').base
          ((α.hom.app W).left.base z))) (hDf W s)).trans ?_
    let s' : C(↥W.left, ULift.{u+1} ℚ_[ℓ]) := s
    exact congrArg (fun p => s' p) (hα W z)
  let ιc : SheafOfModules.pushforward Df'.φ ⋙ SheafOfModules.pushforward Df.φ ≅
      SheafOfModules.pushforward Dk.φ :=
    SheafOfModules.pushforwardComp Df.φ Df'.φ ≪≫
      SheafOfModules.pushforwardNatIso φfg α ≪≫ SheafOfModules.pushforwardCongr hcompat
  have ψ : Dk.Φ ≅ Df.Φ ⋙ Df'.Φ :=
    Dk.adj.leftAdjointUniq ((Df.adj.comp Df'.adj).ofNatIsoRight ιc)

  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V' ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V'' ℓ)) := HasExt.standard _
  haveI := Df.additive
  haveI := Df.presLim
  haveI := Df.presColim
  haveI := Df'.additive
  haveI := Df'.presLim
  haveI := Df'.presColim
  haveI := Dk.additive
  haveI := Dk.presLim
  haveI := Dk.presColim
  have h2 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf V'' ℓ)} {a : ℕ}
      (p : A ⟶ B) (q : B ⟶ C') (z : Abelian.Ext C' D' a),
      (Abelian.Ext.mk₀ p).comp ((Abelian.Ext.mk₀ q).comp z (zero_add a)) (zero_add a) =
        (Abelian.Ext.mk₀ (p ≫ q)).comp z (zero_add a) := by
    intro A B C' D' a p q z
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
  have h3 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf V'' ℓ)} {a : ℕ}
      (z : Abelian.Ext A B a) (p : B ⟶ C') (q : C' ⟶ D'),
      (z.comp (Abelian.Ext.mk₀ p) (add_zero a)).comp (Abelian.Ext.mk₀ q) (add_zero a) =
        z.comp (Abelian.Ext.mk₀ (p ≫ q)) (add_zero a) := by
    intro A B C' D' a z p q
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  have h4 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf V'' ℓ)} {a : ℕ}
      (p : A ⟶ B) (z : Abelian.Ext B C' a) (q : C' ⟶ D'),
      ((Abelian.Ext.mk₀ p).comp z (zero_add a)).comp (Abelian.Ext.mk₀ q) (add_zero a) =
        (Abelian.Ext.mk₀ p).comp (z.comp (Abelian.Ext.mk₀ q) (add_zero a)) (zero_add a) := by
    intro A B C' D' a p z q
    exact Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _

  have hcomm : ∀ (X : (V''.ProEt)ᵒᵖ) (a b : (wcRingSheaf V'' ℓ).obj.obj X), a * b = b * a := by
    intro X a b
    exact @mul_comm C(↥(Opposite.unop X).left, ULift.{u+1} ℚ_[ℓ]) _ a b
  have hext : ∀ (e : SheafOfModules.unit (wcRingSheaf V'' ℓ) ⟶
      SheafOfModules.unit (wcRingSheaf V'' ℓ)), ∃ m : 𝟭 (SheafOfModules.{u+1} (wcRingSheaf V'' ℓ)) ⟶
      𝟭 (SheafOfModules.{u+1} (wcRingSheaf V'' ℓ)),
      m.app (SheafOfModules.unit (wcRingSheaf V'' ℓ)) = e := by
    intro e
    let R := wcRingSheaf V'' ℓ
    let s := (SheafOfModules.unit R).unitHomEquiv e
    let σ : ∀ X : (V''.ProEt)ᵒᵖ, R.obj.obj X := fun X => (s.1 X : R.obj.obj X)
    have hσ : ∀ {X Y : (V''.ProEt)ᵒᵖ} (g : X ⟶ Y), (R.obj.map g).hom (σ X) = σ Y :=
      fun g => PresheafOfModules.sections_property s g
    let L : ∀ (M : SheafOfModules.{u+1} R) (X : (V''.ProEt)ᵒᵖ), M.val.obj X ⟶ M.val.obj X :=
      fun M X => ModuleCat.ofHom
        { toFun := fun x => σ X • x
          map_add' := fun x y => smul_add _ _ _
          map_smul' := fun r x => by
            simp only [RingHom.id_apply, smul_smul]
            rw [hcomm X] }
    let mM : ∀ M : SheafOfModules.{u+1} R, M ⟶ M := fun M =>
      ⟨PresheafOfModules.Hom.mk (L M) (by
        intro X Y g
        ext x
        show σ Y • (M.val.map g).hom x = (M.val.map g).hom (σ X • x)
        rw [PresheafOfModules.map_smul, hσ])⟩
    refine ⟨{ app := mM, naturality := ?_ }, ?_⟩
    · intro M N g
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro X
      ext x
      show σ X • (g.val.app X).hom x = (g.val.app X).hom (σ X • x)
      exact ((g.val.app X).hom.map_smul _ _).symm
    · apply (SheafOfModules.unit R).unitHomEquiv.injective
      apply PresheafOfModules.sections_ext
      intro X
      rw [SheafOfModules.unitHomEquiv_apply_coe]
      show σ X • (1 : R.obj.obj X) = s.1 X
      rw [smul_eq_mul, mul_one]

  have hcen : ∀ (m : 𝟭 (SheafOfModules.{u+1} (wcRingSheaf V'' ℓ)) ⟶
      𝟭 (SheafOfModules.{u+1} (wcRingSheaf V'' ℓ)))
      {A B : SheafOfModules.{u+1} (wcRingSheaf V'' ℓ)} {a : ℕ} (z : Abelian.Ext A B a),
      (Abelian.Ext.mk₀ (m.app A)).comp z (zero_add a) =
        z.comp (Abelian.Ext.mk₀ (m.app B)) (add_zero a) := by
    intro m A B a z
    have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp z m
    simp only [Abelian.Ext.id_mapExactFunctor] at h
    exact h.symm

  obtain ⟨m, hm⟩ := hext (Dk.μ.inv ≫ ψ.hom.app (SheafOfModules.unit (wcRingSheaf V ℓ)) ≫
    (Df'.Φ.map Df.μ.hom ≫ Df'.μ.hom))
  have hB1 : ∀ {Z : SheafOfModules.{u+1} (wcRingSheaf V'' ℓ)}
      (h : Df'.Φ.obj (Df.Φ.obj (SheafOfModules.unit (wcRingSheaf V ℓ))) ⟶ Z),
      Df'.Φ.map Df.μ.hom ≫ Df'.μ.hom ≫ Df'.μ.inv ≫ Df'.Φ.map Df.μ.inv ≫ h = h := by
    intro Z h
    rw [Iso.hom_inv_id_assoc, ← CategoryTheory.Functor.map_comp_assoc, Iso.hom_inv_id,
      CategoryTheory.Functor.map_id, Category.id_comp]
  have hnat : Df'.μ.inv ≫ Df'.Φ.map Df.μ.inv ≫
      m.app ((Df.Φ ⋙ Df'.Φ).obj (SheafOfModules.unit (wcRingSheaf V ℓ))) =
      m.app (SheafOfModules.unit (wcRingSheaf V'' ℓ)) ≫ Df'.μ.inv ≫ Df'.Φ.map Df.μ.inv := by
    have h := m.naturality (Df'.μ.inv ≫ Df'.Φ.map Df.μ.inv)
    simp only [Functor.id_map, Category.assoc] at h
    exact h

  have hnatR : ∀ {Z : SheafOfModules.{u+1} (wcRingSheaf V'' ℓ)}
      (h : (Df.Φ ⋙ Df'.Φ).obj (SheafOfModules.unit (wcRingSheaf V ℓ)) ⟶ Z),
      Df'.μ.inv ≫ Df'.Φ.map Df.μ.inv ≫
        m.app ((Df.Φ ⋙ Df'.Φ).obj (SheafOfModules.unit (wcRingSheaf V ℓ))) ≫ h =
      m.app (SheafOfModules.unit (wcRingSheaf V'' ℓ)) ≫ Df'.μ.inv ≫ Df'.Φ.map Df.μ.inv ≫ h := by
    intro Z h
    have := congrArg (fun t => t ≫ h) hnat
    simp only [Category.assoc] at this
    exact this
  have hU : m.app ((Df.Φ ⋙ Df'.Φ).obj (SheafOfModules.unit (wcRingSheaf V ℓ))) ≫
      ψ.inv.app (SheafOfModules.unit (wcRingSheaf V ℓ)) ≫ Dk.μ.hom =
      Df'.Φ.map Df.μ.hom ≫ Df'.μ.hom := by
    rw [← hB1 (m.app ((Df.Φ ⋙ Df'.Φ).obj (SheafOfModules.unit (wcRingSheaf V ℓ))) ≫
      ψ.inv.app (SheafOfModules.unit (wcRingSheaf V ℓ)) ≫ Dk.μ.hom)]
    rw [hnatR, hm]
    simp only [Category.assoc]
    rw [hB1, Iso.hom_inv_id_app_assoc, Iso.inv_hom_id]
    exact congrArg (fun t => Df'.Φ.map Df.μ.hom ≫ t) (Category.comp_id Df'.μ.hom)

  obtain ⟨w, hw⟩ : ∃ w : wcSuppObj D'' ⟶ Dk.Φ.obj (wcSuppObj D),
      w = γ₂ ≫ Df'.Φ.map γ₁ ≫ m.app ((Df.Φ ⋙ Df'.Φ).obj (wcSuppObj D)) ≫
        ψ.inv.app (wcSuppObj D) := ⟨_, rfl⟩
  refine ⟨w, ?_, ?_⟩
  ·
    have n1 := m.naturality ((Df.Φ ⋙ Df'.Φ).map (wcSuppUnitMap D))
    simp only [Functor.id_map] at n1
    have n1R : ∀ {Z : SheafOfModules.{u+1} (wcRingSheaf V'' ℓ)}
        (h : (Df.Φ ⋙ Df'.Φ).obj (wcSuppObj D) ⟶ Z),
        (Df.Φ ⋙ Df'.Φ).map (wcSuppUnitMap D) ≫ m.app ((Df.Φ ⋙ Df'.Φ).obj (wcSuppObj D)) ≫ h =
        m.app ((Df.Φ ⋙ Df'.Φ).obj (SheafOfModules.unit (wcRingSheaf V ℓ))) ≫
          (Df.Φ ⋙ Df'.Φ).map (wcSuppUnitMap D) ≫ h := by
      intro Z h
      have := congrArg (fun t => t ≫ h) n1
      simp only [Category.assoc] at this
      exact this
    have n2 : (Df.Φ ⋙ Df'.Φ).map (wcSuppUnitMap D) ≫ ψ.inv.app (wcSuppObj D) =
        ψ.inv.app (SheafOfModules.unit (wcRingSheaf V ℓ)) ≫ Dk.Φ.map (wcSuppUnitMap D) :=
      ψ.inv.naturality (wcSuppUnitMap D)
    have hstar : wcSuppUnitMap D'' ≫ γ₂ ≫ Df'.Φ.map γ₁ =
        Df'.μ.inv ≫ Df'.Φ.map Df.μ.inv ≫ (Df.Φ ⋙ Df'.Φ).map (wcSuppUnitMap D) := by
      rw [reassoc_of% hγ₂, ← CategoryTheory.Functor.map_comp, hγ₁,
        CategoryTheory.Functor.map_comp]
      rfl
    have hstarR : ∀ {Z : SheafOfModules.{u+1} (wcRingSheaf V'' ℓ)}
        (h : (Df.Φ ⋙ Df'.Φ).obj (wcSuppObj D) ⟶ Z),
        wcSuppUnitMap D'' ≫ γ₂ ≫ Df'.Φ.map γ₁ ≫ h =
        Df'.μ.inv ≫ Df'.Φ.map Df.μ.inv ≫ (Df.Φ ⋙ Df'.Φ).map (wcSuppUnitMap D) ≫ h := by
      intro Z h
      have := congrArg (fun t => t ≫ h) hstar
      simp only [Category.assoc] at this
      exact this
    rw [hw, hstarR, n1R, n2, hnatR, hm]
    simp only [Category.assoc]
    rw [hB1, Iso.hom_inv_id_app_assoc]
  ·
    intro n θ
    show (Abelian.Ext.mk₀ w).comp ((Abelian.Ext.mapExactFunctor Dk.Φ θ).comp
        (Abelian.Ext.mk₀ Dk.μ.hom) (add_zero n)) (zero_add n) =
      (Abelian.Ext.mk₀ γ₂).comp ((Abelian.Ext.mapExactFunctor Df'.Φ
        ((Abelian.Ext.mk₀ γ₁).comp ((Abelian.Ext.mapExactFunctor Df.Φ θ).comp
          (Abelian.Ext.mk₀ Df.μ.hom) (add_zero n)) (zero_add n))).comp
        (Abelian.Ext.mk₀ Df'.μ.hom) (add_zero n)) (zero_add n)
    have nat' : (Abelian.Ext.mapExactFunctor Dk.Φ θ).comp
        (Abelian.Ext.mk₀ (ψ.hom.app (SheafOfModules.unit (wcRingSheaf V ℓ)))) (add_zero n) =
        (Abelian.Ext.mk₀ (ψ.hom.app (wcSuppObj D))).comp
          (Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Df'.Φ) θ) (zero_add n) :=
      Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp θ ψ.hom
    have step1 : (Abelian.Ext.mapExactFunctor Dk.Φ θ).comp (Abelian.Ext.mk₀ Dk.μ.hom) (add_zero n) =
        ((Abelian.Ext.mk₀ (ψ.hom.app (wcSuppObj D))).comp
          (Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Df'.Φ) θ) (zero_add n)).comp
          (Abelian.Ext.mk₀ (ψ.inv.app (SheafOfModules.unit (wcRingSheaf V ℓ)) ≫ Dk.μ.hom))
          (add_zero n) := by
      rw [← nat', h3, Iso.hom_inv_id_app_assoc]
    have hL : (Abelian.Ext.mk₀ w).comp ((Abelian.Ext.mapExactFunctor Dk.Φ θ).comp
        (Abelian.Ext.mk₀ Dk.μ.hom) (add_zero n)) (zero_add n) =
        (Abelian.Ext.mk₀ (w ≫ ψ.hom.app (wcSuppObj D))).comp
          ((Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Df'.Φ) θ).comp
            (Abelian.Ext.mk₀ (ψ.inv.app (SheafOfModules.unit (wcRingSheaf V ℓ)) ≫ Dk.μ.hom))
            (add_zero n)) (zero_add n) := by
      rw [step1, h4, h2]
    have hR : (Abelian.Ext.mk₀ γ₂).comp ((Abelian.Ext.mapExactFunctor Df'.Φ
        ((Abelian.Ext.mk₀ γ₁).comp ((Abelian.Ext.mapExactFunctor Df.Φ θ).comp
          (Abelian.Ext.mk₀ Df.μ.hom) (add_zero n)) (zero_add n))).comp
        (Abelian.Ext.mk₀ Df'.μ.hom) (add_zero n)) (zero_add n) =
        (Abelian.Ext.mk₀ (γ₂ ≫ Df'.Φ.map γ₁)).comp
          ((Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Df'.Φ) θ).comp
            (Abelian.Ext.mk₀ (Df'.Φ.map Df.μ.hom ≫ Df'.μ.hom)) (add_zero n)) (zero_add n) := by
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
        Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
        ← Abelian.Ext.comp_mapExactFunctor, h4, h3, h2]
    rw [hL, hR]
    have hwψ : w ≫ ψ.hom.app (wcSuppObj D) =
        (γ₂ ≫ Df'.Φ.map γ₁) ≫ m.app ((Df.Φ ⋙ Df'.Φ).obj (wcSuppObj D)) := by
      rw [hw]
      simp only [Category.assoc, Iso.inv_hom_id_app]
      exact congrArg (fun t => γ₂ ≫ Df'.Φ.map γ₁ ≫ t) (Category.comp_id _)
    have key : (Abelian.Ext.mk₀ (m.app ((Df.Φ ⋙ Df'.Φ).obj (wcSuppObj D)))).comp
        ((Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Df'.Φ) θ).comp
          (Abelian.Ext.mk₀ (ψ.inv.app (SheafOfModules.unit (wcRingSheaf V ℓ)) ≫ Dk.μ.hom))
          (add_zero n)) (zero_add n) =
        (Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Df'.Φ) θ).comp
          (Abelian.Ext.mk₀ (Df'.Φ.map Df.μ.hom ≫ Df'.μ.hom)) (add_zero n) := by
      rw [← h4, hcen m, h3]
      exact congrArg (fun p => (Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Df'.Φ) θ).comp
        (Abelian.Ext.mk₀ p) (add_zero n)) hU
    rw [hwψ]
    exact (h2 _ _ _).symm.trans (congrArg (fun t => (Abelian.Ext.mk₀ (γ₂ ≫ Df'.Φ.map γ₁)).comp t
      (zero_add n)) key)

theorem wc_supp_reverse_kernel_kill {Y Z Y' Z' : Scheme.{u}} (i : Z ⟶ Y) (g : Y' ⟶ Y)
    (i' : Z' ⟶ Y') (g' : Z' ⟶ Z) (hcomm : i' ≫ g = g' ≫ i) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (Di' : wcHMPullData i' ℓ) (hDi' : wcHMPullCanonical Di')
    (Dg : wcHMPullData g ℓ) (hDg : wcHMPullCanonical Dg) :
    Limits.kernel.ι (wcSuppUnitMap Di) ≫ wcSuppUnitMap Dg ≫
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC g) _ _ Dg.cont Dg.φ).map
        (wcSuppUnitMap Di') = 0 :=
by
  classical

  have twist : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcHMPullData f ℓ)
      (hD : wcHMPullCanonical D)
      (ρ' : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶ wcSuppObj D) (V : S.ProEt)
      (t : C(↥V.left, ULift.{u+1} ℚ_[ℓ])),
      ((ρ'.val.app (Opposite.op V)).hom t : C(↥(Limits.pullback V.hom f), ULift.{u+1} ℚ_[ℓ])) =
        t.comp (Limits.pullback.fst V.hom f).base.hom *
          (wcSuppTwist ρ').comp (Limits.pullback.snd V.hom f).base.hom := by
    intro S S' f D hD ρ' V t
    have hlam1 : Limits.pullback.lift f (𝟙 S')
        ((Category.comp_id f).trans (Category.id_comp f).symm) ≫
        Limits.pullback.fst (𝟙 S) f = f := Limits.pullback.lift_fst _ _ _
    have hlam2 : Limits.pullback.lift f (𝟙 S')
        ((Category.comp_id f).trans (Category.id_comp f).symm) ≫
        Limits.pullback.snd (𝟙 S) f = 𝟙 S' := Limits.pullback.lift_snd _ _ _
    let T : S.ProEt := MorphismProperty.Over.mk ⊤ (𝟙 S) (inferInstance : WeaklyEtale (𝟙 S))
    let e : V ⟶ T := MorphismProperty.Over.homMk V.hom (Category.comp_id V.hom) trivial
    let β : Limits.pullback V.hom f ⟶ Limits.pullback (𝟙 S) f := ((wcProEtBC f).map e).left
    have hβw : β ≫ Limits.pullback.snd (𝟙 S) f = Limits.pullback.snd V.hom f :=
      MorphismProperty.Over.w ((wcProEtBC f).map e)
    have hβ : β = Limits.pullback.snd V.hom f ≫
        Limits.pullback.lift f (𝟙 S') ((Category.comp_id f).trans (Category.id_comp f).symm) := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hlam1, ← hβw, Category.assoc, ← Limits.pullback.condition,
          Category.comp_id]
      · rw [Category.assoc, hlam2, Category.comp_id, hβw]
    let m1 : C(↥(Limits.pullback V.hom f), ULift.{u+1} ℚ_[ℓ]) :=
      (ρ'.val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))
    let mT : C(↥(Limits.pullback (𝟙 S) f), ULift.{u+1} ℚ_[ℓ]) :=
      (ρ'.val.app (Opposite.op T)).hom (1 : C(↥S, ULift.{u+1} ℚ_[ℓ]))
    have e1 : m1 = mT.comp β.base.hom :=
      PresheafOfModules.naturality_apply ρ'.val e.op (1 : C(↥S, ULift.{u+1} ℚ_[ℓ]))
    let mt : C(↥(Limits.pullback V.hom f), ULift.{u+1} ℚ_[ℓ]) :=
      (ρ'.val.app (Opposite.op V)).hom t
    let φt : C(↥(Limits.pullback V.hom f), ULift.{u+1} ℚ_[ℓ]) :=
      (D.φ.hom.app (Opposite.op V)).hom t
    have hφ : φt = t.comp (Limits.pullback.fst V.hom f).base.hom := hD V t
    have e2 : mt = t.comp (Limits.pullback.fst V.hom f).base.hom * m1 := by
      have h := (ρ'.val.app (Opposite.op V)).hom.map_smul t (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))
      have h' : ((ρ'.val.app (Opposite.op V)).hom (t * 1) :
            C(↥(Limits.pullback V.hom f), ULift.{u+1} ℚ_[ℓ])) = φt * m1 := h
      rw [hφ] at h'
      have h0 : ((ρ'.val.app (Opposite.op V)).hom (t * 1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ])) :
          C(↥(Limits.pullback V.hom f), ULift.{u+1} ℚ_[ℓ])) = mt :=
        congrArg (fun x => (ρ'.val.app (Opposite.op V)).hom x) (mul_one t)
      exact h0.symm.trans h'
    have e3 : mT.comp (Limits.pullback.snd V.hom f ≫
        Limits.pullback.lift f (𝟙 S')
          ((Category.comp_id f).trans (Category.id_comp f).symm)).base.hom =
        (wcSuppTwist ρ').comp (Limits.pullback.snd V.hom f).base.hom :=
      ContinuousMap.ext fun _ => rfl
    show mt = _
    rw [e2, e1, hβ, e3]

  have unitInv : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcHMPullData f ℓ),
      ∃ c' : C(↥S', ULift.{u+1} ℚ_[ℓ]), wcSuppTwist (wcSuppUnitMap D) * c' = 1 := by
    intro S S' f D
    letI := D.cont
    let u := SheafOfModules.unitToPushforwardObjUnit D.φ
    let ψ₁ := (D.adj.homEquiv _ _).symm u
    let h : SheafOfModules.unit (wcRingSheaf S' ℓ) ⟶ SheafOfModules.unit (wcRingSheaf S' ℓ) :=
      D.μ.inv ≫ ψ₁
    have hfac : u = wcSuppUnitMap D ≫
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ).map h := by
      have e1 : D.μ.hom ≫ h = ψ₁ := Iso.hom_inv_id_assoc _ _
      calc u = D.adj.homEquiv _ _ ψ₁ := (Equiv.apply_symm_apply _ _).symm
        _ = D.adj.homEquiv _ _ (D.μ.hom ≫ h) := by rw [e1]
        _ = D.adj.homEquiv _ _ D.μ.hom ≫
            (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ).map h :=
          Adjunction.homEquiv_naturality_right _ _ _
        _ = wcSuppUnitMap D ≫
            (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ).map h := by
          rw [Adjunction.homEquiv_unit]; rfl
    let T : S.ProEt := MorphismProperty.Over.mk ⊤ (𝟙 S) (inferInstance : WeaklyEtale (𝟙 S))
    let cT : C(↥(Limits.pullback (𝟙 S) f), ULift.{u+1} ℚ_[ℓ]) :=
      ((wcSuppUnitMap D).val.app (Opposite.op T)).hom (1 : C(↥S, ULift.{u+1} ℚ_[ℓ]))
    let a : C(↥(Limits.pullback (𝟙 S) f), ULift.{u+1} ℚ_[ℓ]) :=
      (h.val.app (Opposite.op ((wcProEtBC f).obj T))).hom
        (1 : C(↥(Limits.pullback (𝟙 S) f), ULift.{u+1} ℚ_[ℓ]))
    have hu1 : (u.val.app (Opposite.op T)).hom (1 : C(↥S, ULift.{u+1} ℚ_[ℓ])) =
        (1 : C(↥(Limits.pullback (𝟙 S) f), ULift.{u+1} ℚ_[ℓ])) :=
      (D.φ.hom.app (Opposite.op T)).hom.map_one
    have hev : (u.val.app (Opposite.op T)).hom (1 : C(↥S, ULift.{u+1} ℚ_[ℓ])) =
        (h.val.app (Opposite.op ((wcProEtBC f).obj T))).hom cT := by
      rw [hfac]
      rfl
    have hlin : ∀ x : C(↥(Limits.pullback (𝟙 S) f), ULift.{u+1} ℚ_[ℓ]),
        (h.val.app (Opposite.op ((wcProEtBC f).obj T))).hom x = x * a := by
      intro x
      have e := (h.val.app (Opposite.op ((wcProEtBC f).obj T))).hom.map_smul x
        (1 : C(↥(Limits.pullback (𝟙 S) f), ULift.{u+1} ℚ_[ℓ]))
      have e2 : (h.val.app (Opposite.op ((wcProEtBC f).obj T))).hom x =
          (h.val.app (Opposite.op ((wcProEtBC f).obj T))).hom (x * 1) :=
        congrArg (fun y => (h.val.app (Opposite.op ((wcProEtBC f).obj T))).hom y) (mul_one x).symm
      exact e2.trans e
    have key : cT * a = 1 := by
      rw [← hlin cT, ← hev, hu1]
    refine ⟨a.comp (Limits.pullback.lift f (𝟙 S')
      ((Category.comp_id f).trans (Category.id_comp f).symm)).base.hom, ?_⟩
    show cT.comp (Limits.pullback.lift f (𝟙 S')
        ((Category.comp_id f).trans (Category.id_comp f).symm)).base.hom *
      a.comp (Limits.pullback.lift f (𝟙 S')
        ((Category.comp_id f).trans (Category.id_comp f).symm)).base.hom = 1
    rw [← ContinuousMap.mul_comp, key, ContinuousMap.one_comp]

  have vanish : ∀ (V : Y.ProEt) (t : C(↥V.left, ULift.{u+1} ℚ_[ℓ])),
      ((wcSuppUnitMap Di).val.app (Opposite.op V)).hom t = 0 →
      ∀ y : ↥V.left, V.hom y ∈ Set.range i → t y = 0 := by
    intro V t h0 y hy
    have hy' : y ∈ Set.range (Limits.pullback.fst V.hom i) := by
      rw [Scheme.Pullback.range_fst]; exact hy
    obtain ⟨z, rfl⟩ := hy'
    obtain ⟨c', hc'⟩ := unitInv Di
    have htw := twist Di hDi (wcSuppUnitMap Di) V t
    rw [h0] at htw
    have h1 := congrArg
      (fun φ : C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ]) => φ z) htw
    have h2 := congrArg (fun φ : C(↥Z, ULift.{u+1} ℚ_[ℓ]) =>
      φ ((Limits.pullback.snd V.hom i).base.hom z)) hc'
    simp only [ContinuousMap.mul_apply, ContinuousMap.comp_apply,
      ContinuousMap.one_apply] at h1 h2
    have h1' : (0 : ULift.{u+1} ℚ_[ℓ]) =
        t ((Limits.pullback.fst V.hom i).base.hom z) *
          (wcSuppTwist (wcSuppUnitMap Di)) ((Limits.pullback.snd V.hom i).base.hom z) := h1
    show t ((Limits.pullback.fst V.hom i).base.hom z) = 0
    linear_combination (-(c' ((Limits.pullback.snd V.hom i).base.hom z))) * h1' -
      (t ((Limits.pullback.fst V.hom i).base.hom z)) * h2

  have key : ∀ (V : Y.ProEt) (t : C(↥V.left, ULift.{u+1} ℚ_[ℓ])),
      (∀ y : ↥V.left, V.hom y ∈ Set.range i → t y = 0) →
      (((@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC g) _ _ Dg.cont Dg.φ).map
        (wcSuppUnitMap Di')).val.app (Opposite.op V)).hom
        (((wcSuppUnitMap Dg).val.app (Opposite.op V)).hom t) = 0 := by
    intro V t ht
    have hu := twist Dg hDg (wcSuppUnitMap Dg) V t
    have e0 : Limits.pullback.fst ((wcProEtBC g).obj V).hom i' ≫ Limits.pullback.snd V.hom g =
        Limits.pullback.snd ((wcProEtBC g).obj V).hom i' ≫ i' :=
      Limits.pullback.condition
    have e1 : Limits.pullback.fst ((wcProEtBC g).obj V).hom i' ≫
        Limits.pullback.fst V.hom g ≫ V.hom =
        Limits.pullback.snd ((wcProEtBC g).obj V).hom i' ≫ g' ≫ i := by
      have c1 : Limits.pullback.fst V.hom g ≫ V.hom = Limits.pullback.snd V.hom g ≫ g :=
        Limits.pullback.condition
      exact (whisker_eq _ c1).trans ((Category.assoc _ _ _).symm.trans
        ((eq_whisker e0 g).trans ((Category.assoc _ _ _).trans (whisker_eq _ hcomm))))
    have h2 := twist Di' hDi' (wcSuppUnitMap Di') ((wcProEtBC g).obj V)
      (((wcSuppUnitMap Dg).val.app (Opposite.op V)).hom t)
    change ((wcSuppUnitMap Di').val.app (Opposite.op ((wcProEtBC g).obj V))).hom
      (((wcSuppUnitMap Dg).val.app (Opposite.op V)).hom t) = 0
    refine h2.trans ?_
    rw [hu]
    refine ContinuousMap.ext fun w => ?_
    have hx : t ((Limits.pullback.fst V.hom g).base.hom
        ((Limits.pullback.fst ((wcProEtBC g).obj V).hom i').base.hom w)) = 0 := by
      apply ht
      refine ⟨g' ((Limits.pullback.snd ((wcProEtBC g).obj V).hom i').base.hom w), ?_⟩
      have e2 := congrArg (fun φ => φ.base.hom w) e1
      simp only [Scheme.Hom.comp_base, TopCat.hom_comp, ContinuousMap.comp_apply] at e2
      exact e2.symm
    have hcw : ((t.comp (Limits.pullback.fst V.hom g).base.hom *
        (wcSuppTwist (wcSuppUnitMap Dg)).comp (Limits.pullback.snd V.hom g).base.hom).comp
          (Limits.pullback.fst ((wcProEtBC g).obj V).hom i').base.hom) w = 0 := by
      show t ((Limits.pullback.fst V.hom g).base.hom
          ((Limits.pullback.fst ((wcProEtBC g).obj V).hom i').base.hom w)) *
        (wcSuppTwist (wcSuppUnitMap Dg)) ((Limits.pullback.snd V.hom g).base.hom
          ((Limits.pullback.fst ((wcProEtBC g).obj V).hom i').base.hom w)) = 0
      exact (congrArg (· * _) hx).trans (zero_mul _)
    exact (congrArg (· * _) hcw).trans (zero_mul _)

  apply SheafOfModules.hom_ext
  apply PresheafOfModules.hom_ext
  intro X
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  induction X using Opposite.rec with
  | op V =>
  have hk := congrArg (fun φ => (φ.val.app (Opposite.op V)).hom x)
    (Limits.kernel.condition (wcSuppUnitMap Di))
  change ((wcSuppUnitMap Di).val.app (Opposite.op V)).hom
    (((Limits.kernel.ι (wcSuppUnitMap Di)).val.app (Opposite.op V)).hom x) = 0 at hk
  change (((@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC g) _ _ Dg.cont Dg.φ).map
      (wcSuppUnitMap Di')).val.app (Opposite.op V)).hom
    (((wcSuppUnitMap Dg).val.app (Opposite.op V)).hom
      (((Limits.kernel.ι (wcSuppUnitMap Di)).val.app (Opposite.op V)).hom x)) = 0
  exact key V _ (vanish V _ hk)

theorem injres_cosyzygy_tower {C D : Type*} [Category C] [Category D] [Abelian C] [Abelian D]
    (R : C ⥤ D) [R.Additive] [Limits.PreservesFiniteLimits R] (A : C) (I : InjectiveResolution A)
    (hI : ∀ q : ℕ, 1 ≤ q →
      Limits.IsZero (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q)) :
    ∃ (Z J : ℕ → C) (f : ∀ k, Z k ⟶ J k) (g : ∀ k, J k ⟶ Z (k + 1))
      (hfg : ∀ k, f k ≫ g k = 0) (hRfg : ∀ k, R.map (f k) ≫ R.map (g k) = 0) (_ : Z 0 ≅ A),
      (∀ k, Injective (J k)) ∧
      (∀ k, (ShortComplex.mk (f k) (g k) (hfg k)).ShortExact) ∧
      (∀ k, (ShortComplex.mk (R.map (f k)) (R.map (g k)) (hRfg k)).ShortExact) :=
by

  have key1 : ∀ {X Y W : C} (d₁ : X ⟶ Y) (d₂ : Y ⟶ W) (w : d₁ ≫ d₂ = 0)
      (hex : (ShortComplex.mk d₁ d₂ w).Exact)
      (h : Limits.kernel.ι d₁ ≫ Limits.kernel.lift d₂ d₁ w = 0),
      (ShortComplex.mk (Limits.kernel.ι d₁) (Limits.kernel.lift d₂ d₁ w) h).ShortExact := by
    intro X Y W d₁ d₂ w hex h
    haveI : Epi (Limits.kernel.lift d₂ d₁ w) := hex.epi_kernelLift
    refine ShortComplex.ShortExact.mk' ?_ inferInstance inferInstance
    let φ : ShortComplex.mk (Limits.kernel.ι d₁) (Limits.kernel.lift d₂ d₁ w) h ⟶
        ShortComplex.mk (Limits.kernel.ι d₁) d₁ (Limits.kernel.condition d₁) :=
      ShortComplex.homMk (𝟙 _) (𝟙 _) (Limits.kernel.ι d₂) (by simp)
        (by dsimp only; rw [Category.id_comp, Limits.kernel.lift_ι])
    haveI : Epi φ.τ₁ := by change Epi (𝟙 _); infer_instance
    haveI : IsIso φ.τ₂ := by change IsIso (𝟙 _); infer_instance
    haveI : Mono φ.τ₃ := by change Mono (Limits.kernel.ι d₂); infer_instance
    exact (ShortComplex.exact_iff_of_epi_of_isIso_of_mono φ).mpr (ShortComplex.exact_kernel d₁)

  have key2 : ∀ {X Y W : C} (d₁ : X ⟶ Y) (d₂ : Y ⟶ W) (w : d₁ ≫ d₂ = 0)
      (hRw : R.map d₁ ≫ R.map d₂ = 0)
      (hRex : (ShortComplex.mk (R.map d₁) (R.map d₂) hRw).Exact)
      (hR : R.map (Limits.kernel.ι d₁) ≫ R.map (Limits.kernel.lift d₂ d₁ w) = 0),
      (ShortComplex.mk (R.map (Limits.kernel.ι d₁)) (R.map (Limits.kernel.lift d₂ d₁ w))
        hR).ShortExact := by
    intro X Y W d₁ d₂ w hRw hRex hR
    have hcomm : R.map (Limits.kernel.lift d₂ d₁ w) =
        Limits.kernel.lift (R.map d₂) (R.map d₁) hRw ≫ (Limits.PreservesKernel.iso R d₂).inv := by
      rw [Iso.eq_comp_inv, ← cancel_mono (Limits.kernel.ι (R.map d₂)), Category.assoc,
        Limits.PreservesKernel.iso_hom, Limits.kernelComparison_comp_ι, ← R.map_comp,
        Limits.kernel.lift_ι, Limits.kernel.lift_ι]
    haveI : Epi (Limits.kernel.lift (R.map d₂) (R.map d₁) hRw) := hRex.epi_kernelLift
    haveI : Epi (R.map (Limits.kernel.lift d₂ d₁ w)) := by rw [hcomm]; exact epi_comp _ _
    haveI : Mono (R.map (Limits.kernel.ι d₁)) := inferInstance
    refine ShortComplex.ShortExact.mk' ?_ inferInstance inferInstance
    have hz : R.map (Limits.kernel.ι d₁) ≫ R.map d₁ = 0 := by
      rw [← R.map_comp, Limits.kernel.condition, R.map_zero]
    let φ : ShortComplex.mk (R.map (Limits.kernel.ι d₁)) (R.map (Limits.kernel.lift d₂ d₁ w)) hR ⟶
        ShortComplex.mk (R.map (Limits.kernel.ι d₁)) (R.map d₁) hz :=
      ShortComplex.homMk (𝟙 _) (𝟙 _) (R.map (Limits.kernel.ι d₂)) (by simp)
        (by dsimp only; rw [Category.id_comp, ← R.map_comp, Limits.kernel.lift_ι])
    haveI : Epi φ.τ₁ := by change Epi (𝟙 _); infer_instance
    haveI : IsIso φ.τ₂ := by change IsIso (𝟙 _); infer_instance
    haveI : Mono φ.τ₃ := by change Mono (R.map (Limits.kernel.ι d₂)); infer_instance
    refine (ShortComplex.exact_iff_of_epi_of_isIso_of_mono φ).mpr ?_
    exact ShortComplex.exact_of_f_is_kernel _ (Limits.isLimitOfHasKernelOfPreservesLimit R d₁)

  have hRex : ∀ k : ℕ, (ShortComplex.mk (R.map (I.cocomplex.d k (k+1)))
      (R.map (I.cocomplex.d (k+1) (k+1+1)))
      (by rw [← R.map_comp, I.cocomplex.d_comp_d, R.map_zero])).Exact := by
    intro k
    have h1 := (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj
      I.cocomplex).exactAt_iff_isZero_homology (k+1)).mpr (hI (k+1) (by omega))
    exact (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).exactAt_iff' k (k+1)
      (k+1+1) (CochainComplex.prev_nat_succ k) (CochainComplex.next ℕ (k+1))).mp h1

  let Z : ℕ → C := fun k => Limits.kernel (I.cocomplex.d k (k+1))
  let f : ∀ k, Z k ⟶ I.cocomplex.X k := fun k => Limits.kernel.ι (I.cocomplex.d k (k+1))
  let g : ∀ k, I.cocomplex.X k ⟶ Z (k+1) := fun k =>
    Limits.kernel.lift (I.cocomplex.d (k+1) (k+1+1)) (I.cocomplex.d k (k+1))
      (I.cocomplex.d_comp_d _ _ _)
  have hfg : ∀ k, f k ≫ g k = 0 := by
    intro k
    rw [← cancel_mono (Limits.kernel.ι (I.cocomplex.d (k+1) (k+1+1)))]
    simp [f, g]
  have hRfg : ∀ k, R.map (f k) ≫ R.map (g k) = 0 := by
    intro k
    rw [← R.map_comp, hfg k, R.map_zero]

  let hK := I.exact₀.fIsKernel
  let e : Z 0 ≅ A :=
    Limits.IsLimit.conePointUniqueUpToIso (Limits.limit.isLimit _) hK ≪≫
      HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 A
  refine ⟨Z, fun k => I.cocomplex.X k, f, g, hfg, hRfg, e, fun k => I.injective k, ?_, ?_⟩
  · intro k
    exact key1 (I.cocomplex.d k (k+1)) (I.cocomplex.d (k+1) (k+1+1)) (I.cocomplex.d_comp_d _ _ _)
      (I.exact_succ k) (hfg k)
  · intro k
    exact key2 (I.cocomplex.d k (k+1)) (I.cocomplex.d (k+1) (k+1+1)) (I.cocomplex.d_comp_d _ _ _)
      _ (hRex k) (hRfg k)

theorem ext_adj_cosyzygy_transfer_surj {C D : Type*} [Category C] [Category D] [Abelian C]
    [Abelian D] (L : D ⥤ C) (R : C ⥤ D) [L.Additive] [Limits.PreservesFiniteLimits L]
    [Limits.PreservesFiniteColimits L] [R.Additive] (adj : L ⊣ R)
    (Z J : ℕ → C) (f : ∀ k, Z k ⟶ J k) (g : ∀ k, J k ⟶ Z (k + 1))
    (hfg : ∀ k, f k ≫ g k = 0) (hRfg : ∀ k, R.map (f k) ≫ R.map (g k) = 0)
    (hJ : ∀ k, Injective (J k))
    (hS : ∀ k, (ShortComplex.mk (f k) (g k) (hfg k)).ShortExact)
    (hRS : ∀ k, (ShortComplex.mk (R.map (f k)) (R.map (g k)) (hRfg k)).ShortExact)
    (Y : D) (φ : L.obj Y ⟶ Z 0) (hφ : IsIso (adj.unit.app Y ≫ R.map φ)) (X : D) (n : ℕ) :
    letI := HasExt.standard C; letI := HasExt.standard D;
    Function.Surjective (fun θ : Abelian.Ext X Y n =>
      (Abelian.Ext.mapExactFunctor L θ).comp (Abelian.Ext.mk₀ φ) (add_zero n)) :=
by
  letI := HasExt.standard C
  letI := HasExt.standard D

  have s1 : ∀ (Z₀ : C) (X : D), Function.Surjective (fun θ : Abelian.Ext X (R.obj Z₀) 0 =>
      (Abelian.Ext.mapExactFunctor L θ).comp (Abelian.Ext.mk₀ (adj.counit.app Z₀))
        (add_zero 0)) := by
    intro Z₀ X ξ
    obtain ⟨h, rfl⟩ := (Abelian.Ext.mk₀_bijective (L.obj X) Z₀).2 ξ
    refine ⟨Abelian.Ext.mk₀ (adj.homEquiv X Z₀ h), ?_⟩
    simp only
    rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀]
    have e := (adj.homEquiv X Z₀).symm_apply_apply h
    rw [Adjunction.homEquiv_counit] at e
    rw [e]

  have s2 : ∀ (Z₀ J₀ Z₁ : C) (f : Z₀ ⟶ J₀) (g : J₀ ⟶ Z₁) (hfg : f ≫ g = 0)
      (hRfg : R.map f ≫ R.map g = 0) (hJ : Injective J₀)
      (hS : (ShortComplex.mk f g hfg).ShortExact)
      (hRS : (ShortComplex.mk (R.map f) (R.map g) hRfg).ShortExact) (X : D) (n : ℕ),
      Function.Surjective (fun θ : Abelian.Ext X (R.obj Z₁) n =>
        (Abelian.Ext.mapExactFunctor L θ).comp (Abelian.Ext.mk₀ (adj.counit.app Z₁))
          (add_zero n)) →
      Function.Surjective (fun θ : Abelian.Ext X (R.obj Z₀) (n + 1) =>
        (Abelian.Ext.mapExactFunctor L θ).comp (Abelian.Ext.mk₀ (adj.counit.app Z₀))
          (add_zero (n + 1))) := by
    intro Z₀ J₀ Z₁ f g hfg hRfg hJ hS hRS X n ih ξ
    have ha : ξ.comp (Abelian.Ext.mk₀ (ShortComplex.mk f g hfg).f) (add_zero _) = 0 :=
      Abelian.Ext.eq_zero_of_injective _
    obtain ⟨x₃, hx₃⟩ :=
      Abelian.Ext.covariant_sequence_exact₁ (L.obj X) hS ξ ha (rfl : n + 1 = n + 1)
    obtain ⟨θ', hθ'⟩ := ih x₃
    refine ⟨θ'.comp hRS.extClass rfl, ?_⟩
    let μ : (ShortComplex.mk (R.map f) (R.map g) hRfg).map L ⟶ ShortComplex.mk f g hfg :=
      { τ₁ := adj.counit.app Z₀
        τ₂ := adj.counit.app J₀
        τ₃ := adj.counit.app Z₁
        comm₁₂ := (adj.counit_naturality f).symm
        comm₂₃ := (adj.counit_naturality g).symm }
    have hnat : (hRS.map_of_exact L).extClass.comp (Abelian.Ext.mk₀ (adj.counit.app Z₀))
        (add_zero 1) = (Abelian.Ext.mk₀ (adj.counit.app Z₁)).comp hS.extClass (zero_add 1) :=
      (hRS.map_of_exact L).extClass_naturality hS μ
    simp only at hθ' ⊢
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass,
      Abelian.Ext.comp_assoc_of_third_deg_zero, hnat,
      ← Abelian.Ext.comp_assoc_of_second_deg_zero, hθ']
    exact hx₃

  have key : ∀ (n : ℕ) (Z J : ℕ → C) (f : ∀ k, Z k ⟶ J k) (g : ∀ k, J k ⟶ Z (k + 1))
      (hfg : ∀ k, f k ≫ g k = 0) (hRfg : ∀ k, R.map (f k) ≫ R.map (g k) = 0)
      (hJ : ∀ k, Injective (J k))
      (hS : ∀ k, (ShortComplex.mk (f k) (g k) (hfg k)).ShortExact)
      (hRS : ∀ k, (ShortComplex.mk (R.map (f k)) (R.map (g k)) (hRfg k)).ShortExact) (X : D),
      Function.Surjective (fun θ : Abelian.Ext X (R.obj (Z 0)) n =>
        (Abelian.Ext.mapExactFunctor L θ).comp (Abelian.Ext.mk₀ (adj.counit.app (Z 0)))
          (add_zero n)) := by
    intro n
    induction n with
    | zero =>
      intro Z J f g hfg hRfg hJ hS hRS X
      exact s1 (Z 0) X
    | succ n ih =>
      intro Z J f g hfg hRfg hJ hS hRS X
      exact s2 (Z 0) (J 0) (Z (0 + 1)) (f 0) (g 0) (hfg 0) (hRfg 0) (hJ 0) (hS 0) (hRS 0) X n
        (ih (fun k => Z (k + 1)) (fun k => J (k + 1)) (fun k => f (k + 1)) (fun k => g (k + 1))
          (fun k => hfg (k + 1)) (fun k => hRfg (k + 1)) (fun k => hJ (k + 1))
          (fun k => hS (k + 1)) (fun k => hRS (k + 1)) X)

  obtain ⟨ψ, hψ⟩ : ∃ ψ, ψ = adj.unit.app Y ≫ R.map φ := ⟨_, rfl⟩
  haveI : IsIso ψ := hψ ▸ hφ
  have hφeq : φ = L.map ψ ≫ adj.counit.app (Z 0) := by
    have e := (adj.homEquiv Y (Z 0)).symm_apply_apply φ
    rw [Adjunction.homEquiv_counit, Adjunction.homEquiv_unit] at e
    rw [hψ]
    exact e.symm
  have hcomp : L.map (inv ψ) ≫ φ = adj.counit.app (Z 0) := by
    rw [hφeq, ← Category.assoc, ← L.map_comp, IsIso.inv_hom_id, L.map_id, Category.id_comp]
  intro ξ
  obtain ⟨θ', hθ'⟩ := key n Z J f g hfg hRfg hJ hS hRS X ξ
