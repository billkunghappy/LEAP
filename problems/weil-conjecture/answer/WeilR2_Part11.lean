        Limits.WalkingParallelPair.one⟩
  choose ε hε using fun k => hiso (0 + k) k (zero_add k)
  let t' : ∀ k : ℕ, wcIntTors S ℓ (0 + k + 1) ⟶ wcIntTors S ℓ (0 + k) :=
    fun k => (ε (k + 1)).hom ≫ t k ≫ (ε k).inv
  have ht' : ∀ k : ℕ, Limits.cokernel.π ((ℓ ^ (0 + k + 1) : ℕ) • 𝟙 (wcIntUnit S ℓ)) ≫ t' k =
      Limits.cokernel.π ((ℓ ^ (0 + k) : ℕ) • 𝟙 (wcIntUnit S ℓ)) := by
    intro k
    have h1 : Limits.cokernel.π ((ℓ ^ (0 + k + 1) : ℕ) • 𝟙 (wcIntUnit S ℓ)) ≫ (ε (k + 1)).hom =
        uk (k + 1) := hε (k + 1)
    show Limits.cokernel.π _ ≫ (ε (k + 1)).hom ≫ t k ≫ (ε k).inv = _
    refine (Category.assoc _ _ _).symm.trans ?_
    refine (congrArg (fun z => z ≫ t k ≫ (ε k).inv) h1).trans ?_
    rw [← Category.assoc, htk, Iso.comp_inv_eq, hε k]
  obtain ⟨hz₀, hS₀⟩ := wc_int_unit_tower_shortExact S ℓ 0 t' ht'
  let T : ∏ᶜ R ⟶ ∏ᶜ R := Limits.Pi.lift (fun k => Limits.Pi.π R k - Limits.Pi.π R (k + 1) ≫ t k)
  have hTk : ∀ k, T ≫ Limits.Pi.π R k = Limits.Pi.π R k - Limits.Pi.π R (k + 1) ≫ t k :=
    fun k => Limits.Pi.lift_comp_π _ k
  have hz : Limits.Pi.lift uk ≫ T = 0 := by
    apply Limits.Pi.hom_ext
    intro k
    rw [Category.assoc, hTk, Preadditive.comp_sub, Limits.Pi.lift_comp_π, ← Category.assoc,
      Limits.Pi.lift_comp_π, htk, sub_self, Limits.zero_comp]
  let eP : ∏ᶜ (fun k => wcIntTors S ℓ (0 + k)) ≅ ∏ᶜ R := Limits.Pi.mapIso ε
  have hePk : ∀ k, eP.hom ≫ Limits.Pi.π R k =
      Limits.Pi.π (fun k => wcIntTors S ℓ (0 + k)) k ≫ (ε k).hom := fun k => by simp [eP]
  have hePk' : ∀ k {Z : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)} (h : R k ⟶ Z),
      eP.hom ≫ Limits.Pi.π R k ≫ h =
        Limits.Pi.π (fun k => wcIntTors S ℓ (0 + k)) k ≫ (ε k).hom ≫ h := by
    intro k Z h
    rw [← Category.assoc, hePk, Category.assoc]
  have hS : (ShortComplex.mk _ _ hz).ShortExact := by
    refine ShortComplex.shortExact_of_iso
      (ShortComplex.isoMk (S₁ := ShortComplex.mk _ _ hz₀) (S₂ := ShortComplex.mk _ _ hz)
        (Iso.refl _) eP eP ?_ ?_) hS₀
    · apply Limits.Pi.hom_ext
      intro k
      simp only [Iso.refl_hom, Category.id_comp, Category.assoc, hePk, Limits.Pi.lift_comp_π,
        Limits.Pi.lift_comp_π_assoc]
      exact (hε k).symm
    · apply Limits.Pi.hom_ext
      intro k
      simp only [Category.assoc, hTk, Preadditive.comp_sub, Preadditive.sub_comp, hePk, hePk',
        Limits.Pi.lift_comp_π, Limits.Pi.lift_comp_π_assoc, t', Iso.inv_hom_id, Category.comp_id]

  have hZ0 : ∀ j (x : Abelian.Ext (wcIntUnit S ℓ) (wcIntResUnit S ℓ 0) j), x = 0 := by
    obtain ⟨w0, ⟨c0⟩⟩ := hcok 0
    haveI : Epi ((ℓ ^ 0 : ℕ) • 𝟙 (wcIntUnit S ℓ)) := by
      rw [pow_zero, one_nsmul]; infer_instance
    have hz0 : Limits.IsZero (wcIntResUnit S ℓ 0) := Limits.CokernelCofork.IsColimit.isZero_of_epi c0
    intro j x
    rw [← Abelian.Ext.comp_mk₀_id x, hz0.eq_of_src (𝟙 (wcIntResUnit S ℓ 0)) 0,
      Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]

  have hR2 : ∀ k j (y : wcIntExt S ℓ j),
      wcIntRedTr S ℓ k j (wcIntRed S ℓ k j y) = y.comp (Abelian.Ext.mk₀ (uk k)) (add_zero j) := by
    intro k j y
    have e : wcIntRed S ℓ k j = _ := dif_pos (hTr k j)
    rw [e]
    exact AddEquiv.ofBijective_apply_symm_apply (wcIntRedTr S ℓ k j) (hTr k j)
  have hTau : ∀ k j (x : wcZModProEtExt S (ℓ ^ (k + 1)) j),
      wcIntRedTr S ℓ k j (wcIntRedTau S ℓ k j x) =
        (wcIntRedTr S ℓ (k + 1) j x).comp (Abelian.Ext.mk₀ (t k)) (add_zero j) := by
    intro k j x
    have e : wcIntRedTau S ℓ k j = _ := dif_pos (And.intro (hTr k j) (ht k))
    rw [e]
    exact AddEquiv.ofBijective_apply_symm_apply (wcIntRedTr S ℓ k j) (hTr k j)

  have hc : ∀ {X₁ X₂ X₃ : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)} {n : ℕ}
      (x : Abelian.Ext (wcIntUnit S ℓ) X₁ n) (f : X₁ ⟶ X₂) (g : X₂ ⟶ X₃),
      (x.comp (Abelian.Ext.mk₀ f) (add_zero n)).comp (Abelian.Ext.mk₀ g) (add_zero n) =
        x.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero n) := by
    intro X₁ X₂ X₃ n x f g
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero _) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀]
  have hP := fun N => wc_ext_prod_bijective (wcIntUnit S ℓ) (∏ᶜ R) R (Limits.Pi.π R)
    (Limits.productIsProduct R) N
  have star : ∀ N (x : Abelian.Ext (wcIntUnit S ℓ) (∏ᶜ R) N) k,
      (x.comp (Abelian.Ext.mk₀ T) (add_zero N)).comp (Abelian.Ext.mk₀ (Limits.Pi.π R k)) (add_zero N) =
        x.comp (Abelian.Ext.mk₀ (Limits.Pi.π R k)) (add_zero N) +
          -((x.comp (Abelian.Ext.mk₀ (Limits.Pi.π R (k + 1))) (add_zero N)).comp
            (Abelian.Ext.mk₀ (t k)) (add_zero N)) := by
    intro N x k
    rw [hc, hTk, sub_eq_add_neg, Abelian.Ext.mk₀_add, Abelian.Ext.mk₀_neg,
      Abelian.Ext.comp_add, Abelian.Ext.comp_neg, ← hc]
  refine ⟨?_, ?_, ?_, ?_⟩
  ·
    intro k y _
    apply (hTr k q).1
    rw [hTau, hR2, hR2, hc, htk]
  ·
    intro α hα
    have ha : ∀ k, (wcIntRedTr S ℓ (k + 1) q (α (k + 1))).comp (Abelian.Ext.mk₀ (t k)) (add_zero q) =
        wcIntRedTr S ℓ k q (α k) := by
      intro k
      rcases Nat.eq_zero_or_pos k with h0 | hpos
      · subst h0
        exact (hZ0 q _).trans (hZ0 q _).symm
      · rw [← hTau, hα k hpos]
    obtain ⟨x, hx⟩ := (hP q).2 (fun k => wcIntRedTr S ℓ k q (α k))
    have hxT : x.comp (Abelian.Ext.mk₀ T) (add_zero q) = 0 :=
      (hP q).1 _ (fun k => by rw [star, hx k, hx (k + 1), ha k, add_neg_cancel])
    obtain ⟨θ, hθ⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hS x hxT
    have hθ' : θ.comp (Abelian.Ext.mk₀ (Limits.Pi.lift uk)) (add_zero q) = x := hθ
    refine ⟨θ, fun k _ => ?_⟩
    apply (hTr k q).1
    rw [hR2, ← Limits.Pi.lift_comp_π uk k, ← hc, hθ', hx k]
  ·
    intro hlim y hy
    have hyu : ∀ k, y.comp (Abelian.Ext.mk₀ (uk k)) (add_zero q) = 0 := by
      intro k
      rcases Nat.eq_zero_or_pos k with h0 | hpos
      · subst h0
        exact hZ0 q _
      · rw [← hR2, hy k hpos, map_zero]
    have hyf : y.comp (Abelian.Ext.mk₀ (Limits.Pi.lift uk)) (add_zero q) = 0 :=
      (hP q).1 _ (fun k => by rw [hc, Limits.Pi.lift_comp_π]; exact hyu k)
    cases q with
    | zero =>
      obtain ⟨g, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 y
      have hg0 : g ≫ Limits.Pi.lift uk = 0 := (Abelian.Ext.mk₀_bijective _ _).1 (by
        rw [← Abelian.Ext.mk₀_comp_mk₀, hyf, Abelian.Ext.mk₀_zero])
      have hmono : Mono (Limits.Pi.lift uk) := hS.mono_f
      rw [(cancel_mono (Limits.Pi.lift uk)).1 (hg0.trans Limits.zero_comp.symm),
        Abelian.Ext.mk₀_zero]
    | succ q₀ =>
      replace hlim : @wcLim1Zero (fun k => wcZModProEtExt S (ℓ ^ k) q₀) (fun _ => inferInstance)
          (fun k => wcIntRedTau S ℓ k q₀) := hlim
      obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hS y hyf (rfl : q₀ + 1 = q₀ + 1)
      obtain ⟨z, hz'⟩ := hlim (fun k => (AddEquiv.ofBijective (wcIntRedTr S ℓ k q₀) (hTr k q₀)).symm
        (x₃.comp (Abelian.Ext.mk₀ (Limits.Pi.π R k)) (add_zero q₀)))
      obtain ⟨w, hw⟩ := (hP q₀).2 (fun k => wcIntRedTr S ℓ k q₀ (z k))
      have hb : ∀ k, x₃.comp (Abelian.Ext.mk₀ (Limits.Pi.π R k)) (add_zero q₀) =
          wcIntRedTr S ℓ k q₀ (z k) +
            -((wcIntRedTr S ℓ (k + 1) q₀ (z (k + 1))).comp (Abelian.Ext.mk₀ (t k)) (add_zero q₀)) := by
        intro k
        rcases Nat.eq_zero_or_pos k with h0 | hpos
        · subst h0
          exact (hZ0 _ _).trans (hZ0 _ _).symm
        · have e1 : (AddEquiv.ofBijective (wcIntRedTr S ℓ k q₀) (hTr k q₀)).symm
              (x₃.comp (Abelian.Ext.mk₀ (Limits.Pi.π R k)) (add_zero q₀)) =
                z k - wcIntRedTau S ℓ k q₀ (z (k + 1)) := hz' k hpos
          rw [← AddEquiv.ofBijective_apply_symm_apply (wcIntRedTr S ℓ k q₀) (hTr k q₀)
            (n := x₃.comp (Abelian.Ext.mk₀ (Limits.Pi.π R k)) (add_zero q₀)), e1, map_sub, hTau,
            sub_eq_add_neg]
      have hx3 : x₃ = w.comp (Abelian.Ext.mk₀ T) (add_zero q₀) := by
        rw [← sub_eq_zero]
        apply (hP q₀).1
        intro k
        rw [sub_eq_add_neg, Abelian.Ext.add_comp, Abelian.Ext.neg_comp, star, hw k, hw (k + 1), hb k]
        abel
      have h0 : (Abelian.Ext.mk₀ T).comp hS.extClass (zero_add 1) = 0 := hS.comp_extClass
      rw [← hx₃, hx3, Abelian.Ext.comp_assoc_of_second_deg_zero, h0, Abelian.Ext.comp_zero]
  ·
    intro k y hy
    have hyu : y.comp (Abelian.Ext.mk₀ (uk k)) (add_zero q) = 0 := by
      rw [← hR2, hy, map_zero]
    obtain ⟨w, ⟨c⟩⟩ := hcok k
    have hSk : (ShortComplex.mk _ _ w).ShortExact :=
      ShortComplex.ShortExact.mk' ((ShortComplex.mk _ _ w).exact_of_g_is_cokernel c)
        (wc_int_unit_pow_mono S ℓ k) (Limits.epi_of_isColimit_cofork c)
    obtain ⟨y', hy'⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hSk y hyu
    refine ⟨y', ?_⟩
    rw [← hy']
    have hn : ∀ n : ℕ, y'.comp (Abelian.Ext.mk₀ (n • 𝟙 (wcIntUnit S ℓ))) (add_zero q) = n • y' := by
      intro n
      induction n with
      | zero => rw [zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero, zero_nsmul]
      | succ n ih =>
        rw [succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih, Abelian.Ext.comp_mk₀_id,
          succ_nsmul]
    exact hn _

theorem wc_int_red_act (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hTr : ∀ k j : ℕ, Function.Bijective (wcIntRedTr S ℓ k j))
    (ht : ∀ k : ℕ, ∃ t : wcIntResUnit S ℓ (k + 1) ⟶ wcIntResUnit S ℓ k,
      wcUnitRestrict (wcIntZModRingSheafMap S ℓ (k + 1)) ≫ t =
        wcUnitRestrict (wcIntZModRingSheafMap S ℓ k)) (q : ℕ) :
    (∀ (k : ℕ) (c : ℤ_[ℓ]) (y : wcIntExt S ℓ q),
      wcIntRed S ℓ k q (wcIntAct S ℓ q (ContinuousMap.const _ (ULift.up c)) y) =
        (PadicInt.toZModPow k c).val • wcIntRed S ℓ k q y) ∧
    (∀ (k : ℕ) (r : C(↥S, ULift.{u+1} ℤ_[ℓ])) (rk : C(↥S, ULift.{u+1} (ZMod (ℓ ^ k)))),
      (∀ t, (rk t).down = PadicInt.toZModPow k (r t).down) → ∀ z : wcIntExt S ℓ q,
      letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S (ℓ ^ k))) := HasExt.standard _
      wcIntRed S ℓ k q (wcIntAct S ℓ q r z) =
        (Abelian.Ext.mk₀ (wcZModFun S (ℓ ^ k) rk)).comp (wcIntRed S ℓ k q z) (zero_add q)) ∧
    (∀ (k j : ℕ) (r1 : C(↥S, ULift.{u+1} (ZMod (ℓ ^ (k + 1)))))
      (r0 : C(↥S, ULift.{u+1} (ZMod (ℓ ^ k)))),
      (∀ t, (r0 t).down = ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ k)) (ZMod (ℓ ^ k)) (r1 t).down) →
      ∀ b : wcZModProEtExt S (ℓ ^ (k + 1)) j,
      letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S (ℓ ^ (k + 1)))) := HasExt.standard _
      letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S (ℓ ^ k))) := HasExt.standard _
      wcIntRedTau S ℓ k j ((Abelian.Ext.mk₀ (wcZModFun S (ℓ ^ (k + 1)) r1)).comp b (zero_add j)) =
        (Abelian.Ext.mk₀ (wcZModFun S (ℓ ^ k) r0)).comp (wcIntRedTau S ℓ k j b) (zero_add j)) :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
  letI hZ : ∀ n : ℕ, HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S n)) :=
    fun n => HasExt.standard _

  have s1 : ∀ (k : ℕ) (r : C(↥S, ULift.{u+1} ℤ_[ℓ])) (rk : C(↥S, ULift.{u+1} (ZMod (ℓ ^ k)))),
      (∀ t, (rk t).down = PadicInt.toZModPow k (r t).down) →
      wcIntFun S ℓ r ≫ wcUnitRestrict (wcIntZModRingSheafMap S ℓ k) =
        wcUnitRestrict (wcIntZModRingSheafMap S ℓ k) ≫
          (SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap S ℓ k)).map
            (wcZModFun S (ℓ ^ k) rk) := by
    intro k r rk hr
    apply (SheafOfModules.unitHomEquiv _).injective
    apply PresheafOfModules.sections_ext
    intro V
    have hu : ∀ x, ((wcUnitRestrict (wcIntZModRingSheafMap S ℓ k)).val.app V).hom x =
        ((wcIntZModRingSheafMap S ℓ k).hom.app V).hom x := by
      intro x
      have h0 : ((wcUnitRestrict (wcIntZModRingSheafMap S ℓ k)).val.app V).hom x =
          ((wcIntZModRingSheafMap S ℓ k).hom.app V).hom x *
            (1 : (wcZModRingSheaf S (ℓ ^ k)).obj.obj V) := rfl
      rw [h0, mul_one]
    have hf : ((SheafOfModules.unitHomEquiv _) (wcIntFun S ℓ r)).1 V =
        (r.comp (Opposite.unop V).hom.base.hom :
          C(↥((Opposite.unop V).left), ULift.{u+1} ℤ_[ℓ])) := by
      simp only [wcIntFun, Equiv.apply_symm_apply]
      rfl
    have hg : ((SheafOfModules.unitHomEquiv _) (wcZModFun S (ℓ ^ k) rk)).1 V =
        (rk.comp (Opposite.unop V).hom.base.hom :
          C(↥((Opposite.unop V).left), ULift.{u+1} (ZMod (ℓ ^ k)))) := by
      simp only [wcZModFun, Equiv.apply_symm_apply]
      rfl
    have hU1 : ((SheafOfModules.unitHomEquiv _)
        (wcUnitRestrict (wcIntZModRingSheafMap S ℓ k))).1 V =
        (1 : (wcZModRingSheaf S (ℓ ^ k)).obj.obj V) := by
      simp only [wcUnitRestrict, Equiv.apply_symm_apply]
      rfl
    have e2 : (((SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap S ℓ k)).map
        (wcZModFun S (ℓ ^ k) rk)).val.app V).hom
          (((SheafOfModules.unitHomEquiv _) (wcUnitRestrict (wcIntZModRingSheafMap S ℓ k))).1 V) =
        ((SheafOfModules.unitHomEquiv _) (wcZModFun S (ℓ ^ k) rk)).1 V := by
      rw [hU1, SheafOfModules.unitHomEquiv_apply_coe]
      rfl
    rw [SheafOfModules.unitHomEquiv_comp_apply, SheafOfModules.unitHomEquiv_comp_apply]
    show ((wcUnitRestrict (wcIntZModRingSheafMap S ℓ k)).val.app V).hom
        (((SheafOfModules.unitHomEquiv _) (wcIntFun S ℓ r)).1 V) =
      (((SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap S ℓ k)).map
        (wcZModFun S (ℓ ^ k) rk)).val.app V).hom
          (((SheafOfModules.unitHomEquiv _) (wcUnitRestrict (wcIntZModRingSheafMap S ℓ k))).1 V)
    rw [e2]
    refine (hu _).trans (Eq.trans ?_ hg.symm)
    refine (congrArg (fun x => ((wcIntZModRingSheafMap S ℓ k).hom.app V).hom x) hf).trans ?_
    exact ContinuousMap.ext (fun p => ULift.ext _ _ (hr _).symm)

  have s3 : ∀ (k j : ℕ)
      (f : SheafOfModules.unit (wcIntRingSheaf S ℓ) ⟶ SheafOfModules.unit (wcIntRingSheaf S ℓ))
      (g : SheafOfModules.unit (wcZModRingSheaf S (ℓ ^ k)) ⟶
        SheafOfModules.unit (wcZModRingSheaf S (ℓ ^ k))),
      f ≫ wcUnitRestrict (wcIntZModRingSheafMap S ℓ k) =
        wcUnitRestrict (wcIntZModRingSheafMap S ℓ k) ≫
          (SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap S ℓ k)).map g →
      ∀ x : wcZModProEtExt S (ℓ ^ k) j,
      wcIntRedTr S ℓ k j ((Abelian.Ext.mk₀ g).comp x (zero_add j)) =
        (Abelian.Ext.mk₀ f).comp (wcIntRedTr S ℓ k j x) (zero_add j) := by
    intro k j f g hfg x
    by_cases h : wcIntResExact S ℓ k
    · haveI := h.1
      haveI := h.2.1
      haveI := h.2.2
      have hT : ∀ y : wcZModProEtExt S (ℓ ^ k) j, wcIntRedTr S ℓ k j y =
          (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntZModRingSheafMap S ℓ k))).comp
            (Abelian.Ext.mapExactFunctor
              (SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap S ℓ k)) y)
            (zero_add j) := by
        intro y
        rw [wcIntRedTr, dif_pos h]
        rfl
      rw [hT, hT, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.mk₀_comp_mk₀_assoc, ← hfg, ← Abelian.Ext.mk₀_comp_mk₀_assoc]
    · have h0 : ∀ y : wcZModProEtExt S (ℓ ^ k) j, wcIntRedTr S ℓ k j y = 0 := by
        intro y
        rw [wcIntRedTr, dif_neg h]
        rfl
      rw [h0, h0, Abelian.Ext.comp_zero]

  have s4 : ∀ (n j : ℕ) (x : wcZModProEtExt S n j) (m : ℕ),
      (Abelian.Ext.mk₀ (wcZModFun S n (ContinuousMap.const _ (ULift.up (m : ZMod n))))).comp x
        (zero_add j) = m • x := by
    intro n j x m
    have hFval : ∀ (c : ZMod n) (V : (S.ProEt)ᵒᵖ),
        ((SheafOfModules.unitHomEquiv _) (wcZModFun S n (ContinuousMap.const _ (ULift.up c)))).1 V =
          (ContinuousMap.const _ (ULift.up c) :
            C(↥((Opposite.unop V).left), ULift.{u+1} (ZMod n))) := by
      intro c V
      simp only [wcZModFun, Equiv.apply_symm_apply]
      rfl
    have Z1 : wcZModFun S n (ContinuousMap.const _ (ULift.up 1)) = 𝟙 _ := by
      apply (SheafOfModules.unitHomEquiv _).injective
      apply Subtype.ext
      funext V
      rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
      rw [← SheafOfModules.unitHomEquiv_apply_coe]
      simp only [wcZModFun, Equiv.apply_symm_apply]
      rfl
    have Z0 : wcZModFun S n (ContinuousMap.const _ (ULift.up 0)) = 0 := by
      apply (SheafOfModules.unitHomEquiv _).injective
      apply PresheafOfModules.sections_ext
      intro V
      simp only [wcZModFun, Equiv.apply_symm_apply]
      rw [SheafOfModules.unitHomEquiv_apply_coe]
      exact ContinuousMap.ext (fun x => rfl)
    have Zadd : ∀ a b : ZMod n, wcZModFun S n (ContinuousMap.const _ (ULift.up (a + b))) =
        wcZModFun S n (ContinuousMap.const _ (ULift.up a)) +
          wcZModFun S n (ContinuousMap.const _ (ULift.up b)) := by
      intro a b
      apply (SheafOfModules.unitHomEquiv _).injective
      apply Subtype.ext
      funext V
      rw [hFval, SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.add_val,
        PresheafOfModules.add_app]
      show _ = ((SheafOfModules.unitHomEquiv _)
          (wcZModFun S n (ContinuousMap.const _ (ULift.up a)))).1 V +
        ((SheafOfModules.unitHomEquiv _) (wcZModFun S n (ContinuousMap.const _ (ULift.up b)))).1 V
      rw [hFval, hFval]
      apply ContinuousMap.ext
      intro x
      rfl
    induction m with
    | zero =>
      rw [Nat.cast_zero, Z0, Abelian.Ext.mk₀_zero, Abelian.Ext.zero_comp, zero_nsmul]
    | succ m ih =>
      rw [Nat.cast_succ, Zadd, Abelian.Ext.mk₀_add, Abelian.Ext.add_comp, ih, Z1,
        Abelian.Ext.mk₀_id_comp, succ_nsmul]

  have hRed : ∀ (k : ℕ) (y : wcIntExt S ℓ q), wcIntRed S ℓ k q y =
      (AddEquiv.ofBijective (wcIntRedTr S ℓ k q) (hTr k q)).symm
        (y.comp (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntZModRingSheafMap S ℓ k))) (add_zero q)) := by
    intro k y
    rw [wcIntRed, dif_pos (hTr k q)]
    rfl
  have hTau : ∀ (k j : ℕ) (b : wcZModProEtExt S (ℓ ^ (k + 1)) j), wcIntRedTau S ℓ k j b =
      (AddEquiv.ofBijective (wcIntRedTr S ℓ k j) (hTr k j)).symm
        ((wcIntRedTr S ℓ (k + 1) j b).comp (Abelian.Ext.mk₀ (Classical.choose (ht k)))
          (add_zero j)) := by
    intro k j b
    rw [wcIntRedTau, dif_pos ⟨hTr k j, ht k⟩]
    rfl
  have hTe : ∀ (k j : ℕ) (w : wcIntResExt S ℓ k j),
      wcIntRedTr S ℓ k j ((AddEquiv.ofBijective (wcIntRedTr S ℓ k j) (hTr k j)).symm w) = w :=
    fun k j w => (AddEquiv.ofBijective (wcIntRedTr S ℓ k j) (hTr k j)).apply_symm_apply w

  have C2 : ∀ (k : ℕ) (r : C(↥S, ULift.{u+1} ℤ_[ℓ])) (rk : C(↥S, ULift.{u+1} (ZMod (ℓ ^ k)))),
      (∀ t, (rk t).down = PadicInt.toZModPow k (r t).down) → ∀ z : wcIntExt S ℓ q,
      wcIntRed S ℓ k q (wcIntAct S ℓ q r z) =
        (Abelian.Ext.mk₀ (wcZModFun S (ℓ ^ k) rk)).comp (wcIntRed S ℓ k q z) (zero_add q) := by
    intro k r rk hr z
    show wcIntRed S ℓ k q ((Abelian.Ext.mk₀ (wcIntFun S ℓ r)).comp z (zero_add q)) = _
    rw [hRed, hRed, AddEquiv.symm_apply_eq, AddEquiv.ofBijective_apply,
      s3 k q _ _ (s1 k r rk hr), hTe, Abelian.Ext.comp_assoc_of_third_deg_zero]

  have C1 : ∀ (k : ℕ) (c : ℤ_[ℓ]) (y : wcIntExt S ℓ q),
      wcIntRed S ℓ k q (wcIntAct S ℓ q (ContinuousMap.const _ (ULift.up c)) y) =
        (PadicInt.toZModPow k c).val • wcIntRed S ℓ k q y := by
    intro k c y
    rw [C2 k (ContinuousMap.const _ (ULift.up c))
      (ContinuousMap.const _ (ULift.up (((PadicInt.toZModPow k c).val : ℕ) : ZMod (ℓ ^ k))))
      (fun _ => ZMod.natCast_zmod_val _) y]
    exact s4 (ℓ ^ k) q _ _

  have C3 : ∀ (k j : ℕ) (r1 : C(↥S, ULift.{u+1} (ZMod (ℓ ^ (k + 1)))))
      (r0 : C(↥S, ULift.{u+1} (ZMod (ℓ ^ k)))),
      (∀ t, (r0 t).down =
        ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ k)) (ZMod (ℓ ^ k)) (r1 t).down) →
      ∀ b : wcZModProEtExt S (ℓ ^ (k + 1)) j,
      wcIntRedTau S ℓ k j ((Abelian.Ext.mk₀ (wcZModFun S (ℓ ^ (k + 1)) r1)).comp b (zero_add j)) =
        (Abelian.Ext.mk₀ (wcZModFun S (ℓ ^ k) r0)).comp (wcIntRedTau S ℓ k j b) (zero_add j) := by
    intro k j r1 r0 hr0 b
    let rt : C(↥S, ULift.{u+1} ℤ_[ℓ]) :=
      ⟨fun t => ULift.up ((((r1 t).down).val : ℕ) : ℤ_[ℓ]),
        continuous_uliftUp.comp ((continuous_of_discreteTopology
          (f := fun a : ZMod (ℓ ^ (k + 1)) => ((a.val : ℕ) : ℤ_[ℓ]))).comp
          (continuous_uliftDown.comp r1.continuous))⟩
    have L1 : ∀ t, (r1 t).down = PadicInt.toZModPow (k + 1) (rt t).down := by
      intro t
      show (r1 t).down = PadicInt.toZModPow (k + 1) ((((r1 t).down).val : ℕ) : ℤ_[ℓ])
      rw [map_natCast, ZMod.natCast_zmod_val]
    have L0 : ∀ t, (r0 t).down = PadicInt.toZModPow k (rt t).down := by
      intro t
      rw [hr0 t, ZMod.castHom_apply, L1 t, PadicInt.cast_toZModPow k (k + 1) (Nat.le_succ k)]
    rw [hTau, hTau, s3 (k + 1) j _ _ (s1 (k + 1) rt r1 L1),
      Abelian.Ext.comp_assoc_of_third_deg_zero, AddEquiv.symm_apply_eq,
      AddEquiv.ofBijective_apply, s3 k j _ _ (s1 k rt r0 L0), hTe]
  exact ⟨C1, C2, C3⟩

theorem wc_int_zmod_pull_restrict_iso {Y T : Scheme.{u}} (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (p : T ⟶ Y)
    (k : ℕ) (DΛ : wcIntPullData p ℓ) (hDΛ : wcIntPullCanonical DΛ)
    (Dk : wcZModPullData p (ℓ ^ k)) (hDk : wcZModPullCanonical Dk) :
    ∃ ν : SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap Y ℓ k) ⋙ DΛ.Φ ≅
        Dk.Φ ⋙ SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap T ℓ k),
      DΛ.Φ.map (wcUnitRestrict (wcIntZModRingSheafMap Y ℓ k)) ≫
          ν.hom.app (SheafOfModules.unit (wcZModRingSheaf Y (ℓ ^ k))) ≫
          (SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap T ℓ k)).map Dk.μ.hom =
        DΛ.μ.hom ≫ wcUnitRestrict (wcIntZModRingSheafMap T ℓ k) :=
by
  classical
  have hℓ : (ℓ : ℕ).Prime := Fact.out
  haveI : NeZero (ℓ ^ k) := ⟨pow_ne_zero _ hℓ.ne_zero⟩



  have rf : ∀ (X : Type u) [TopologicalSpace X]
      (β : C(X, ULift.{u+1} ℤ_[ℓ]) →+* C(X, ULift.{u+1} (ZMod (ℓ ^ k)))),
      (∀ r x, (β r x).down = PadicInt.toZModPow k (r x).down) →
      (∀ r' : C(X, ULift.{u+1} (ZMod (ℓ ^ k))), ∃ r, β r = r') ∧
      (∀ r, β r = 0 → ∃ s, r = (ℓ ^ k : ℕ) • s) ∧
      (((ℓ ^ k : ℕ) : C(X, ULift.{u+1} (ZMod (ℓ ^ k)))) = 0) := by
    intro X _ β hβ
    refine ⟨?_, ?_, ?_⟩
    · intro r'
      refine ⟨⟨fun x => ULift.up (((r' x).down.val : ℕ) : ℤ_[ℓ]), ?_⟩, ?_⟩
      · have : Continuous (fun y : ULift.{u+1} (ZMod (ℓ ^ k)) =>
            ULift.up.{u+1} (((y.down.val : ℕ) : ℤ_[ℓ]))) :=
          continuous_of_discreteTopology
        exact this.comp r'.continuous
      · apply ContinuousMap.ext
        intro x
        apply ULift.ext
        rw [hβ]
        show PadicInt.toZModPow k (((r' x).down.val : ℕ) : ℤ_[ℓ]) = (r' x).down
        rw [map_natCast, ZMod.natCast_zmod_val]
    · intro r hr
      have hx : ∀ x, PadicInt.toZModPow k (r x).down = 0 := by
        intro x
        rw [← hβ, hr]
        rfl
      have hnorm : ∀ x, ‖((r x).down : ℚ_[ℓ]) / (ℓ : ℚ_[ℓ]) ^ k‖ ≤ 1 := by
        intro x
        have h1 : (r x).down ∈ Ideal.span {(ℓ : ℤ_[ℓ]) ^ k} := by
          rw [← PadicInt.ker_toZModPow, RingHom.mem_ker]; exact hx x
        have h2 := (PadicInt.norm_le_pow_iff_mem_span_pow _ k).mpr h1
        rw [norm_div, norm_pow, Padic.norm_p, ← PadicInt.norm_def]
        have hpos : (0 : ℝ) < (ℓ : ℝ) := by exact_mod_cast hℓ.pos
        rw [div_le_one (by positivity)]
        calc ‖(r x).down‖ ≤ (ℓ : ℝ) ^ (-(k : ℤ)) := h2
          _ = ((ℓ : ℝ)⁻¹) ^ k := by rw [zpow_neg, zpow_natCast, inv_pow]
      let s : C(X, ULift.{u+1} ℤ_[ℓ]) :=
        ⟨fun x => ULift.up ⟨((r x).down : ℚ_[ℓ]) / (ℓ : ℚ_[ℓ]) ^ k, hnorm x⟩, by
          apply continuous_uliftUp.comp
          apply Continuous.subtype_mk
          apply Continuous.div_const
          exact continuous_subtype_val.comp (continuous_uliftDown.comp r.continuous)⟩
      refine ⟨s, ?_⟩
      apply ContinuousMap.ext
      intro x
      apply ULift.ext
      show (r x).down = ((ℓ ^ k : ℕ) • s x).down
      apply Subtype.ext
      show ((r x).down : ℚ_[ℓ]) = ((((ℓ ^ k : ℕ) • s x).down : ℤ_[ℓ]) : ℚ_[ℓ])
      have hne : (ℓ : ℚ_[ℓ]) ^ k ≠ 0 := pow_ne_zero _ (by exact_mod_cast hℓ.ne_zero)
      have : (((ℓ ^ k : ℕ) • s x).down : ℤ_[ℓ]) = (ℓ ^ k : ℕ) • (s x).down := rfl
      rw [this, nsmul_eq_mul, PadicInt.coe_mul]
      show _ = (((ℓ ^ k : ℕ) : ℤ_[ℓ]) : ℚ_[ℓ]) * (((r x).down : ℚ_[ℓ]) / (ℓ : ℚ_[ℓ]) ^ k)
      push_cast
      field_simp
    · apply ContinuousMap.ext
      intro x
      apply ULift.ext
      show ((ℓ ^ k : ℕ) : ZMod (ℓ ^ k)) = 0
      exact ZMod.natCast_self _
  have ringS : ∀ S : Scheme.{u},
      (∀ (V : (S.ProEt)ᵒᵖ) (r' : ↑((wcZModRingSheaf S (ℓ ^ k)).obj.obj V)),
        ∃ r : ↑((wcIntRingSheaf S ℓ).obj.obj V), ((wcIntZModRingSheafMap S ℓ k).hom.app V).hom r = r') ∧
      (∀ (V : (S.ProEt)ᵒᵖ) (r : ↑((wcIntRingSheaf S ℓ).obj.obj V)),
        ((wcIntZModRingSheafMap S ℓ k).hom.app V).hom r = 0 →
        ∃ s : ↑((wcIntRingSheaf S ℓ).obj.obj V), r = (ℓ ^ k : ℕ) • s) ∧
      (∀ V : (S.ProEt)ᵒᵖ, ((ℓ ^ k : ℕ) : ↑((wcZModRingSheaf S (ℓ ^ k)).obj.obj V)) = 0) := by
    intro S
    refine ⟨fun V r' => ?_, fun V r hr => ?_, fun V => ?_⟩
    · exact (rf (↥(V.unop.left)) ((wcIntZModRingSheafMap S ℓ k).hom.app V).hom
        (fun _ _ => rfl)).1 r'
    · exact (rf (↥(V.unop.left)) ((wcIntZModRingSheafMap S ℓ k).hom.app V).hom
        (fun _ _ => rfl)).2.1 r hr
    · exact (rf (↥(V.unop.left)) ((wcIntZModRingSheafMap S ℓ k).hom.app V).hom
        (fun _ _ => rfl)).2.2
  obtain ⟨aY, bY, cY⟩ := ringS Y
  obtain ⟨aT, bT, cT⟩ := ringS T



  obtain ⟨fullY, faithY, torsY, -⟩ := sheafOfModules_restrictScalars_quotient_embedding
    (Scheme.ProEt.topology Y) _ _ (wcIntZModRingSheafMap Y ℓ k) (ℓ ^ k) aY bY cY
  obtain ⟨fullT, faithT, -, essT⟩ := sheafOfModules_restrictScalars_quotient_embedding
    (Scheme.ProEt.topology T) _ _ (wcIntZModRingSheafMap T ℓ k) (ℓ ^ k) aT bT cT



  have hsq : DΛ.φ ≫ (@Functor.sheafPushforwardContinuous _ _ _ _ (wcProEtBC p) RingCat.{u+1} _
        (Scheme.ProEt.topology Y) (Scheme.ProEt.topology T) DΛ.cont).map
          (wcIntZModRingSheafMap T ℓ k) =
      wcIntZModRingSheafMap Y ℓ k ≫ Dk.φ := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext V
    apply RingCat.hom_ext
    apply RingHom.ext
    intro s
    show ((wcIntZModRingSheafMap T ℓ k).hom.app (Opposite.op ((wcProEtBC p).obj V.unop))).hom
        ((DΛ.φ.hom.app V).hom s) =
      (Dk.φ.hom.app V).hom (((wcIntZModRingSheafMap Y ℓ k).hom.app V).hom s)
    rw [hDΛ V.unop s]
    refine Eq.trans ?_ (hDk V.unop (((wcIntZModRingSheafMap Y ℓ k).hom.app V).hom s)).symm
    rfl
  have hσeq : SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap T ℓ k) ⋙
        @SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC p) _ _ DΛ.cont DΛ.φ =
      @SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC p) _ _ Dk.cont Dk.φ ⋙
        SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap Y ℓ k) := by
    show @SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC p) _ _ DΛ.cont
        (DΛ.φ ≫ (@Functor.sheafPushforwardContinuous _ _ _ _ (wcProEtBC p) RingCat.{u+1} _
          (Scheme.ProEt.topology Y) (Scheme.ProEt.topology T) DΛ.cont).map
            (wcIntZModRingSheafMap T ℓ k)) =
      @SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC p) _ _ Dk.cont
        (wcIntZModRingSheafMap Y ℓ k ≫ Dk.φ)
    rw [hsq]



  have central : ∀ h : SheafOfModules.unit (wcZModRingSheaf T (ℓ ^ k)) ≅
      SheafOfModules.unit (wcZModRingSheaf T (ℓ ^ k)),
      ∃ ζ : 𝟭 (SheafOfModules.{u+1} (wcZModRingSheaf T (ℓ ^ k))) ≅
        𝟭 (SheafOfModules.{u+1} (wcZModRingSheaf T (ℓ ^ k))),
        ζ.hom.app (SheafOfModules.unit (wcZModRingSheaf T (ℓ ^ k))) = h.hom := by
    intro h
    let R := wcZModRingSheaf T (ℓ ^ k)
    have hcomm : ∀ (V : (T.ProEt)ᵒᵖ) (a b : R.obj.obj V), a * b = b * a := fun V a b =>
      @mul_comm C(↥(Opposite.unop V).left, ULift.{u+1} (ZMod (ℓ ^ k))) _ a b
    let sv : (SheafOfModules.unit R).sections → ∀ V : (T.ProEt)ᵒᵖ, R.obj.obj V := fun t V => t.1 V
    have sv_nat : ∀ t {X Y : (T.ProEt)ᵒᵖ} (f : X ⟶ Y), (R.obj.map f).hom (sv t X) = sv t Y :=
      fun t _ _ f => t.2 f
    let mult : (SheafOfModules.unit R).sections → ∀ M : SheafOfModules.{u+1} R, M ⟶ M := fun t M =>
      ⟨{ app := fun V => ModuleCat.ofHom
            { toFun := fun m => sv t V • m
              map_add' := fun a b => smul_add _ a b
              map_smul' := fun r m => by
                simp only [RingHom.id_apply]
                rw [smul_smul, smul_smul, hcomm] }
         naturality := fun {X Y} f => by
            ext m
            exact ((PresheafOfModules.map_smul M.val f (sv t X) m).trans
              (congrArg (fun r => r • M.val.map f m) (sv_nat t f))).symm }⟩
    have mult_app : ∀ t M V (m : M.val.obj V), ((mult t M).val.app V).hom m = sv t V • m :=
      fun _ _ _ _ => rfl
    have mult_nat : ∀ t {M N : SheafOfModules.{u+1} R} (f : M ⟶ N),
        f ≫ mult t N = mult t M ≫ f := by
      intro t M N f
      apply SheafOfModules.Hom.ext
      apply PresheafOfModules.Hom.ext
      funext V
      ext m
      show ((mult t N).val.app V).hom ((f.val.app V).hom m) =
        (f.val.app V).hom (((mult t M).val.app V).hom m)
      rw [mult_app, mult_app, map_smul]
    have mult_comp : ∀ t t' : (SheafOfModules.unit R).sections,
        (∀ V, sv t V * sv t' V = 1) → ∀ M, mult t' M ≫ mult t M = 𝟙 M := by
      intro t t' htt M
      apply SheafOfModules.Hom.ext
      apply PresheafOfModules.Hom.ext
      funext V
      ext m
      show ((mult t M).val.app V).hom (((mult t' M).val.app V).hom m) = m
      rw [mult_app, mult_app, smul_smul, htt, one_smul]
    have hsec : ∀ f : SheafOfModules.unit R ⟶ SheafOfModules.unit R,
        mult ((SheafOfModules.unitHomEquiv _) f) (SheafOfModules.unit R) = f := by
      intro f
      apply (SheafOfModules.unitHomEquiv _).injective
      apply PresheafOfModules.sections_ext
      intro V
      rw [SheafOfModules.unitHomEquiv_apply_coe]
      change sv ((SheafOfModules.unitHomEquiv _) f) V • (1 : R.obj.obj V) = _
      rw [smul_eq_mul, mul_one]
    have key : ∀ (f g : SheafOfModules.unit R ⟶ SheafOfModules.unit R), f ≫ g = 𝟙 _ →
        ∀ V, sv ((SheafOfModules.unitHomEquiv _) g) V *
          sv ((SheafOfModules.unitHomEquiv _) f) V = 1 := by
      intro f g hfg V
      rw [← hsec f, ← hsec g] at hfg
      have e := congrArg (fun φ => ((SheafOfModules.unitHomEquiv _) φ).1 V) hfg
      simp only [SheafOfModules.unitHomEquiv_apply_coe] at e
      change sv ((SheafOfModules.unitHomEquiv _) g) V • sv ((SheafOfModules.unitHomEquiv _) f) V •
        (1 : R.obj.obj V) = (1 : R.obj.obj V) at e
      rw [smul_eq_mul, smul_eq_mul, mul_one] at e
      exact e
    have hba : ∀ V, sv ((SheafOfModules.unitHomEquiv _) h.inv) V *
        sv ((SheafOfModules.unitHomEquiv _) h.hom) V = 1 := key _ _ h.hom_inv_id
    have hab : ∀ V, sv ((SheafOfModules.unitHomEquiv _) h.hom) V *
        sv ((SheafOfModules.unitHomEquiv _) h.inv) V = 1 := key _ _ h.inv_hom_id
    exact ⟨NatIso.ofComponents (fun M => ⟨mult ((SheafOfModules.unitHomEquiv _) h.hom) M,
        mult ((SheafOfModules.unitHomEquiv _) h.inv) M, mult_comp _ _ hba M, mult_comp _ _ hab M⟩)
      (fun f => mult_nat _ f), hsec h.hom⟩



  let resY := SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap Y ℓ k)
  let resT := SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap T ℓ k)
  let ΦΛ := DΛ.Φ
  let Φk := Dk.Φ
  let PΛ := @SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC p) _ _ DΛ.cont DΛ.φ
  let Pk := @SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC p) _ _ Dk.cont Dk.φ
  let adjΛ : ΦΛ ⊣ PΛ := DΛ.adj
  let adjk : Φk ⊣ Pk := Dk.adj
  let σ : resT ⋙ PΛ ≅ Pk ⋙ resY := eqToIso hσeq
  let oAY := SheafOfModules.unit (wcIntRingSheaf Y ℓ)
  let oZY := SheafOfModules.unit (wcZModRingSheaf Y (ℓ ^ k))
  let oAT := SheafOfModules.unit (wcIntRingSheaf T ℓ)
  let oZT := SheafOfModules.unit (wcZModRingSheaf T (ℓ ^ k))
  let uY : oAY ⟶ resY.obj oZY := wcUnitRestrict (wcIntZModRingSheafMap Y ℓ k)
  let uT : oAT ⟶ resT.obj oZT := wcUnitRestrict (wcIntZModRingSheafMap T ℓ k)
  let μΛ : ΦΛ.obj oAY ≅ oAT := DΛ.μ
  let μk : Φk.obj oZY ≅ oZT := Dk.μ
  haveI : resY.Full := fullY
  haveI : resY.Faithful := faithY
  haveI : resT.Full := fullT
  haveI : resT.Faithful := faithT
  haveI : ΦΛ.Additive := DΛ.additive
  haveI : resY.Additive := inferInstanceAs
    (SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap Y ℓ k)).Additive
  have hbijuY : ∀ M, Function.Bijective (fun f : oZY ⟶ M => uY ≫ resY.map f) :=
    sheafOfModules_unitRestrict_hom_bijective _ _ (wcIntZModRingSheafMap Y ℓ k)
  have hbijuT : ∀ M, Function.Bijective (fun f : oZT ⟶ M => uT ≫ resT.map f) :=
    sheafOfModules_unitRestrict_hom_bijective _ _ (wcIntZModRingSheafMap T ℓ k)
  have hess : ∀ M, resT.essImage ((resY ⋙ ΦΛ).obj M) := by
    intro M
    have h0 : (ℓ ^ k) • 𝟙 ((resY ⋙ ΦΛ).obj M) = 0 := by
      rw [← CategoryTheory.Functor.map_id (resY ⋙ ΦΛ), ← Functor.map_nsmul, torsY M,
        Functor.map_zero]
    obtain ⟨M', ⟨e⟩⟩ := essT _ h0
    exact ⟨M', ⟨e⟩⟩
  let ffY := Functor.FullyFaithful.ofFullyFaithful resY
  let ffT := Functor.FullyFaithful.ofFullyFaithful resT
  let Φ' := Functor.essImage.liftFunctor (resY ⋙ ΦΛ) resT hess
  let ν₀ : Φ' ⋙ resT ≅ resY ⋙ ΦΛ := Functor.essImage.liftFunctorCompIso (resY ⋙ ΦΛ) resT hess
  let adj'' : Φ' ⊣ Pk := Adjunction.restrictFullyFaithful adjΛ ffY ffT ν₀.symm σ
  let ν₁ : resY ⋙ ΦΛ ≅ Φk ⋙ resT :=
    ν₀.symm ≪≫ Functor.isoWhiskerRight (adj''.leftAdjointUniq adjk) resT
  have key : ∀ M, Function.Bijective
      (fun h : Φk.obj oZY ⟶ M => ΦΛ.map uY ≫ ν₁.hom.app oZY ≫ resT.map h) := by
    intro M
    have hE : Function.Bijective (fun h : Φk.obj oZY ⟶ M =>
        ffY.preimage (adjΛ.homEquiv _ _ (ν₁.hom.app oZY ≫ resT.map h) ≫ σ.hom.app M)) := by
      have b1 : Function.Bijective (fun h : Φk.obj oZY ⟶ M => resT.map h) :=
        ffT.map_bijective _ _
      have b2 : Function.Bijective (fun x : resT.obj (Φk.obj oZY) ⟶ resT.obj M =>
          ν₁.hom.app oZY ≫ x) :=
        ⟨fun a b h => by simpa using congrArg (fun t => ν₁.inv.app oZY ≫ t) h,
          fun y => ⟨ν₁.inv.app oZY ≫ y, by simp⟩⟩
      have b3 := (adjΛ.homEquiv (resY.obj oZY) (resT.obj M)).bijective
      have b4 : Function.Bijective (fun y : resY.obj oZY ⟶ PΛ.obj (resT.obj M) =>
          y ≫ σ.hom.app M) :=
        ⟨fun a b h => by simpa using congrArg (fun t => t ≫ σ.inv.app M) h,
          fun y => ⟨y ≫ σ.inv.app M, by simp⟩⟩
      have b5 : Function.Bijective
          (fun y : resY.obj oZY ⟶ resY.obj (Pk.obj M) => ffY.preimage y) :=
        ffY.homEquiv.symm.bijective
      exact b5.comp (b4.comp (b3.comp (b2.comp b1)))
    have hF : Function.Bijective (fun t : oZY ⟶ Pk.obj M =>
        (adjΛ.homEquiv _ _).symm ((uY ≫ resY.map t) ≫ σ.inv.app M)) := by
      have c1 := hbijuY (Pk.obj M)
      have c2 : Function.Bijective
          (fun y : oAY ⟶ resY.obj (Pk.obj M) => y ≫ σ.inv.app M) :=
        ⟨fun a b h => by simpa using congrArg (fun t => t ≫ σ.hom.app M) h,
          fun y => ⟨y ≫ σ.hom.app M, by simp⟩⟩
      have c3 := (adjΛ.homEquiv oAY (resT.obj M)).symm.bijective
      exact c3.comp (c2.comp c1)
    have heq : (fun h : Φk.obj oZY ⟶ M => ΦΛ.map uY ≫ ν₁.hom.app oZY ≫ resT.map h) =
        (fun t : oZY ⟶ Pk.obj M =>
          (adjΛ.homEquiv _ _).symm ((uY ≫ resY.map t) ≫ σ.inv.app M)) ∘
        (fun h : Φk.obj oZY ⟶ M =>
          ffY.preimage (adjΛ.homEquiv _ _ (ν₁.hom.app oZY ≫ resT.map h) ≫ σ.hom.app M)) := by
      funext h
      simp only [Function.comp_apply, Functor.FullyFaithful.map_preimage, Category.assoc,
        Iso.hom_inv_id_app]
      have e : (adjΛ.homEquiv (resY.obj oZY) (resT.obj M)) (ν₁.hom.app oZY ≫ resT.map h) ≫
          𝟙 ((resT ⋙ PΛ).obj M) =
          (adjΛ.homEquiv (resY.obj oZY) (resT.obj M)) (ν₁.hom.app oZY ≫ resT.map h) :=
        Category.comp_id _
      rw [e, ← adjΛ.homEquiv_naturality_left, Equiv.symm_apply_apply]
    rw [heq]
    exact hF.comp hE
  set c : oAT ⟶ resT.obj oZT := μΛ.inv ≫ ΦΛ.map uY ≫ ν₁.hom.app oZY ≫ resT.map μk.hom with hc
  have keyc : ∀ M, Function.Bijective (fun f : oZT ⟶ M => c ≫ resT.map f) := by
    intro M
    have d1 : Function.Bijective (fun f : oZT ⟶ M => μk.hom ≫ f) :=
      ⟨fun a b h => by simpa using congrArg (fun t => μk.inv ≫ t) h,
        fun y => ⟨μk.inv ≫ y, by simp⟩⟩
    have d2 : Function.Bijective (fun y : ΦΛ.obj oAY ⟶ resT.obj M => μΛ.inv ≫ y) :=
      ⟨fun a b h => by simpa using congrArg (fun t => μΛ.hom ≫ t) h,
        fun y => ⟨μΛ.hom ≫ y, by simp⟩⟩
    have heq : (fun f : oZT ⟶ M => c ≫ resT.map f) =
        (fun y : ΦΛ.obj oAY ⟶ resT.obj M => μΛ.inv ≫ y) ∘
          (fun h : Φk.obj oZY ⟶ M => ΦΛ.map uY ≫ ν₁.hom.app oZY ≫ resT.map h) ∘
          (fun f : oZT ⟶ M => μk.hom ≫ f) := by
      funext f
      simp [hc]
    rw [heq]
    exact d2.comp ((key M).comp d1)
  obtain ⟨g, hg⟩ := (hbijuT oZT).2 c
  obtain ⟨g', hg'⟩ := (keyc oZT).2 uT
  simp only at hg hg'
  have hgg' : g ≫ g' = 𝟙 oZT := by
    apply (hbijuT oZT).1
    show uT ≫ resT.map (g ≫ g') = uT ≫ resT.map (𝟙 oZT)
    rw [resT.map_comp, ← Category.assoc, hg, hg', CategoryTheory.Functor.map_id, Category.comp_id]
  have hg'g : g' ≫ g = 𝟙 oZT := by
    apply (keyc oZT).1
    show c ≫ resT.map (g' ≫ g) = c ≫ resT.map (𝟙 oZT)
    rw [resT.map_comp, ← Category.assoc, hg', hg, CategoryTheory.Functor.map_id, Category.comp_id]
  let gI : oZT ≅ oZT := ⟨g, g', hgg', hg'g⟩
  obtain ⟨ζ, hζ⟩ := central gI.symm
  let ν : resY ⋙ ΦΛ ≅ Φk ⋙ resT :=
    NatIso.ofComponents (fun M => ν₁.app M ≪≫ resT.mapIso (ζ.app (Φk.obj M))) (fun {M M'} f => by
      show (resY ⋙ ΦΛ).map f ≫ ν₁.hom.app M' ≫ resT.map (ζ.hom.app (Φk.obj M')) =
        (ν₁.hom.app M ≫ resT.map (ζ.hom.app (Φk.obj M))) ≫ resT.map (Φk.map f)
      rw [← Category.assoc, ν₁.hom.naturality f, Category.assoc, Category.assoc]
      congr 1
      show resT.map (Φk.map f) ≫ resT.map (ζ.hom.app (Φk.obj M')) =
        resT.map (ζ.hom.app (Φk.obj M)) ≫ resT.map (Φk.map f)
      rw [← resT.map_comp, ← resT.map_comp]
      congr 1
      exact ζ.hom.naturality (Φk.map f))
  refine ⟨ν, ?_⟩
  have hnat : μk.hom ≫ g' = ζ.hom.app (Φk.obj oZY) ≫ μk.hom := by
    have := ζ.hom.naturality μk.hom
    rw [hζ] at this
    exact this
  have hc'' : ∀ {Z} (x : resT.obj oZT ⟶ Z),
      ΦΛ.map uY ≫ ν₁.hom.app oZY ≫ resT.map μk.hom ≫ x = μΛ.hom ≫ uT ≫ resT.map g ≫ x := by
    intro Z x
    rw [← Category.assoc uT, hg, hc]
    simp
  show ΦΛ.map uY ≫ (ν₁.hom.app oZY ≫ resT.map (ζ.hom.app (Φk.obj oZY))) ≫ resT.map μk.hom =
    μΛ.hom ≫ uT
  rw [Category.assoc, ← resT.map_comp, ← hnat, resT.map_comp, hc'', ← resT.map_comp, hgg',
    CategoryTheory.Functor.map_id, Category.comp_id]

theorem wc_int_red_pull_compat {Y T : Scheme.{u}} (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (p : T ⟶ Y)
    (DΛ : wcIntPullData p ℓ) (Dk : ∀ k : ℕ, wcZModPullData p (ℓ ^ k))
    (hTrY : ∀ k j : ℕ, Function.Bijective (wcIntRedTr Y ℓ k j))
    (htY : ∀ k : ℕ, ∃ t : wcIntResUnit Y ℓ (k + 1) ⟶ wcIntResUnit Y ℓ k,
      wcUnitRestrict (wcIntZModRingSheafMap Y ℓ (k + 1)) ≫ t =
        wcUnitRestrict (wcIntZModRingSheafMap Y ℓ k))
    (hTrT : ∀ k j : ℕ, Function.Bijective (wcIntRedTr T ℓ k j))
    (htT : ∀ k : ℕ, ∃ t : wcIntResUnit T ℓ (k + 1) ⟶ wcIntResUnit T ℓ k,
      wcUnitRestrict (wcIntZModRingSheafMap T ℓ (k + 1)) ≫ t =
        wcUnitRestrict (wcIntZModRingSheafMap T ℓ k))
    (hν : ∀ k : ℕ, ∃ ν : SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap Y ℓ k) ⋙ DΛ.Φ ≅
        (Dk k).Φ ⋙ SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap T ℓ k),
      DΛ.Φ.map (wcUnitRestrict (wcIntZModRingSheafMap Y ℓ k)) ≫
          ν.hom.app (SheafOfModules.unit (wcZModRingSheaf Y (ℓ ^ k))) ≫
          (SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap T ℓ k)).map (Dk k).μ.hom =
        DΛ.μ.hom ≫ wcUnitRestrict (wcIntZModRingSheafMap T ℓ k)) (q : ℕ) :
    (∀ (k : ℕ) (y : wcIntExt Y ℓ q),
      wcIntRed T ℓ k q (wcIntPull DΛ q y) = wcZModPull (Dk k) q (wcIntRed Y ℓ k q y)) ∧
    (∀ (k j : ℕ) (a : wcZModProEtExt Y (ℓ ^ (k + 1)) j),
      wcIntRedTau T ℓ k j (wcZModPull (Dk (k + 1)) j a) =
        wcZModPull (Dk k) j (wcIntRedTau Y ℓ k j a)) :=
by
  classical
  letI iY : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _
  letI iT : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf T ℓ)) := HasExt.standard _
  letI hZY : ∀ n : ℕ, HasExt (SheafOfModules.{u+1} (wcZModRingSheaf Y n)) :=
    fun n => HasExt.standard _
  letI hZT : ∀ n : ℕ, HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T n)) :=
    fun n => HasExt.standard _
  haveI := DΛ.additive
  haveI := DΛ.presLim
  haveI := DΛ.presColim



  have hexact : ∀ (S : Scheme.{u}) (R R' : Sheaf (Scheme.ProEt.topology S) RingCat.{u+1})
      (φ : R ⟶ R'),
      (SheafOfModules.restrictScalars.{u+1} φ).Additive ∧
        Limits.PreservesFiniteLimits (SheafOfModules.restrictScalars.{u+1} φ) ∧
        Limits.PreservesFiniteColimits (SheafOfModules.restrictScalars.{u+1} φ) := by
    intro S R R' φ
    have hGlim : ∀ (R₀ : Sheaf (Scheme.ProEt.topology S) RingCat.{u+1}) (K : Type)
        [SmallCategory K] [FinCategory K],
        Limits.PreservesLimitsOfShape K (SheafOfModules.toSheaf.{u+1} R₀) := by
      intro R₀ K _ _
      haveI : Limits.PreservesLimitsOfShape K
          (SheafOfModules.forget.{u+1} R₀ ⋙ PresheafOfModules.toPresheaf.{u+1} R₀.obj) :=
        inferInstance
      haveI : Limits.PreservesLimitsOfShape K
          (SheafOfModules.toSheaf.{u+1} R₀ ⋙
            sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) :=
        Limits.preservesLimitsOfShape_of_natIso
          (Iso.refl _ : SheafOfModules.forget.{u+1} R₀ ⋙
            PresheafOfModules.toPresheaf.{u+1} R₀.obj ≅ _)
      exact Limits.preservesLimitsOfShape_of_reflects_of_preserves _
        (sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    have hTSC : ∀ R₀ : Sheaf (Scheme.ProEt.topology S) RingCat.{u+1},
        Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} R₀) := by
      intro R₀
      constructor
      intro I _ _
      constructor
      intro K
      let adj := PresheafOfModules.sheafificationAdjunction
        (J := Scheme.ProEt.topology S) (𝟙 R₀.obj)
      haveI : IsIso adj.counit := inferInstance
      haveI hP : Limits.PreservesColimitsOfShape I
          (PresheafOfModules.sheafification (J := Scheme.ProEt.topology S) (𝟙 R₀.obj) ⋙
            SheafOfModules.toSheaf.{u+1} R₀) :=
        Limits.preservesColimitsOfShape_of_natIso
          (PresheafOfModules.sheafificationCompToSheaf
            (J := Scheme.ProEt.topology S) (𝟙 R₀.obj)).symm
      let K₀ := K ⋙ (SheafOfModules.forget R₀ ⋙ PresheafOfModules.restrictScalars (𝟙 R₀.obj))
      let c₀ := Limits.colimit.cocone K₀
      let h₀ : Limits.IsColimit c₀ := Limits.colimit.isColimit K₀
      have ht : Limits.IsColimit
          ((PresheafOfModules.sheafification (J := Scheme.ProEt.topology S)
            (𝟙 R₀.obj)).mapCocone c₀) :=
        Limits.isColimitOfPreserves _ h₀
      have ht' : Limits.IsColimit ((SheafOfModules.toSheaf.{u+1} R₀).mapCocone
          ((PresheafOfModules.sheafification (J := Scheme.ProEt.topology S)
            (𝟙 R₀.obj)).mapCocone c₀)) :=
        Limits.IsColimit.ofIsoColimit
          (Limits.isColimitOfPreserves
            (PresheafOfModules.sheafification (J := Scheme.ProEt.topology S) (𝟙 R₀.obj) ⋙
              SheafOfModules.toSheaf.{u+1} R₀) h₀)
          (Functor.mapCoconeMapCocone c₀).symm
      haveI : Limits.PreservesColimit
          (K₀ ⋙ PresheafOfModules.sheafification (J := Scheme.ProEt.topology S) (𝟙 R₀.obj))
          (SheafOfModules.toSheaf.{u+1} R₀) :=
        Limits.preservesColimit_of_preserves_colimit_cocone ht ht'
      let e : K₀ ⋙ PresheafOfModules.sheafification (J := Scheme.ProEt.topology S)
          (𝟙 R₀.obj) ≅ K :=
        Functor.associator _ _ _ ≪≫ Functor.isoWhiskerLeft K (asIso adj.counit) ≪≫
          Functor.rightUnitor K
      exact Limits.preservesColimit_of_iso_diagram _ e
    haveI : Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} R) := hTSC R
    haveI : Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} R') := hTSC R'
    haveI : (SheafOfModules.toSheaf.{u+1} R).ReflectsMonomorphisms :=
      Functor.reflectsMonomorphisms_of_faithful _
    haveI : (SheafOfModules.toSheaf.{u+1} R).ReflectsEpimorphisms :=
      Functor.reflectsEpimorphisms_of_faithful _
    haveI : (SheafOfModules.toSheaf.{u+1} R).ReflectsIsomorphisms :=
      reflectsIsomorphisms_of_reflectsMonomorphisms_of_reflectsEpimorphisms _
    let θ : SheafOfModules.restrictScalars.{u+1} φ ⋙ SheafOfModules.toSheaf.{u+1} R ≅
        SheafOfModules.toSheaf.{u+1} R' := Iso.refl _
    refine ⟨inferInstance, ⟨fun K _ _ => ?_⟩, ⟨fun K _ _ => ?_⟩⟩
    · haveI := hGlim R K
      haveI := hGlim R' K
      haveI : Limits.ReflectsLimitsOfShape K (SheafOfModules.toSheaf.{u+1} R) :=
        Limits.reflectsLimitsOfShape_of_reflectsIsomorphisms
      haveI : Limits.PreservesLimitsOfShape K
          (SheafOfModules.restrictScalars.{u+1} φ ⋙ SheafOfModules.toSheaf.{u+1} R) :=
        Limits.preservesLimitsOfShape_of_natIso θ.symm
      exact Limits.preservesLimitsOfShape_of_reflects_of_preserves _
        (SheafOfModules.toSheaf.{u+1} R)
    · haveI : Limits.ReflectsColimitsOfShape K (SheafOfModules.toSheaf.{u+1} R) :=
        Limits.reflectsColimitsOfShape_of_reflectsIsomorphisms
      haveI : Limits.PreservesColimitsOfShape K
          (SheafOfModules.restrictScalars.{u+1} φ ⋙ SheafOfModules.toSheaf.{u+1} R) :=
        Limits.preservesColimitsOfShape_of_natIso θ.symm
      exact Limits.preservesColimitsOfShape_of_reflects_of_preserves _
        (SheafOfModules.toSheaf.{u+1} R)



  have hepi : ∀ (S : Scheme.{u}) (m : ℕ), Epi (wcUnitRestrict (wcIntZModRingSheafMap S ℓ m)) := by
    intro S m
    have hsurj : ∀ (V : (S.ProEt)ᵒᵖ) (r' : (wcZModRingSheaf S (ℓ ^ m)).obj.obj V),
        ∃ r : (wcIntRingSheaf S ℓ).obj.obj V,
          ((wcIntZModRingSheafMap S ℓ m).hom.app V).hom r = r' := by
      intro V r'
      let f' : C(↥(Opposite.unop V).left, ULift.{u+1} (ZMod (ℓ ^ m))) := r'
      let f : C(↥(Opposite.unop V).left, ULift.{u+1} ℤ_[ℓ]) :=
        ⟨fun t => ULift.up (((f' t).down.val : ℕ) : ℤ_[ℓ]),
          (continuous_of_discreteTopology (f := fun b : ULift.{u+1} (ZMod (ℓ ^ m)) =>
            (ULift.up (((b.down).val : ℕ) : ℤ_[ℓ]) : ULift.{u+1} ℤ_[ℓ]))).comp f'.continuous⟩
      refine ⟨f, ?_⟩
      change (_ : C(↥(Opposite.unop V).left, ULift.{u+1} (ZMod (ℓ ^ m)))) = f'
      apply ContinuousMap.ext
      intro t
      apply ULift.ext
      change PadicInt.toZModPow m (((f' t).down.val : ℕ) : ℤ_[ℓ]) = (f' t).down
      rw [map_natCast, ZMod.natCast_zmod_val]
    constructor
    intro M g h hgh
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro V
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    obtain ⟨r, hr⟩ := hsurj V x
    have h1 : (g.val.app V).hom
          (((wcUnitRestrict (wcIntZModRingSheafMap S ℓ m)).val.app V).hom r) =
        (h.val.app V).hom
          (((wcUnitRestrict (wcIntZModRingSheafMap S ℓ m)).val.app V).hom r) :=
      congrArg (fun f => (f.val.app V).hom r) hgh
    have hu : ((wcUnitRestrict (wcIntZModRingSheafMap S ℓ m)).val.app V).hom r = x := by
      have h0 : ((wcUnitRestrict (wcIntZModRingSheafMap S ℓ m)).val.app V).hom r =
          ((wcIntZModRingSheafMap S ℓ m).hom.app V).hom r *
            (1 : (wcZModRingSheaf S (ℓ ^ m)).obj.obj V) := rfl
      rw [h0, mul_one]
      exact hr
    rw [← hu]
    exact h1
  have hEY : ∀ k, wcIntResExact Y ℓ k := fun k => hexact Y _ _ _
  have hET : ∀ k, wcIntResExact T ℓ k := fun k => hexact T _ _ _
  choose ν hstar using hν



  have L : ∀ (k j : ℕ) (a : wcZModProEtExt Y (ℓ ^ k) j),
      wcIntRedTr T ℓ k j (wcZModPull (Dk k) j a) =
        (Abelian.Ext.mk₀ DΛ.μ.inv).comp
          ((Abelian.Ext.mapExactFunctor DΛ.Φ (wcIntRedTr Y ℓ k j a)).comp
            (Abelian.Ext.mk₀ ((ν k).hom.app (SheafOfModules.unit (wcZModRingSheaf Y (ℓ ^ k))) ≫
              (SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap T ℓ k)).map
                (Dk k).μ.hom))
            (add_zero j)) (zero_add j) := by
    intro k j a
    haveI := (hEY k).1
    haveI := (hEY k).2.1
    haveI := (hEY k).2.2
    haveI := (hET k).1
    haveI := (hET k).2.1
    haveI := (hET k).2.2
    haveI := (Dk k).additive
    haveI := (Dk k).presLim
    haveI := (Dk k).presColim
    have hTY : ∀ x : wcZModProEtExt Y (ℓ ^ k) j, wcIntRedTr Y ℓ k j x =
        (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntZModRingSheafMap Y ℓ k))).comp
          (Abelian.Ext.mapExactFunctor
            (SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap Y ℓ k)) x)
          (zero_add j) := by
      intro x
      rw [wcIntRedTr, dif_pos (hEY k)]
      rfl
    have hTT : ∀ x : wcZModProEtExt T (ℓ ^ k) j, wcIntRedTr T ℓ k j x =
        (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntZModRingSheafMap T ℓ k))).comp
          (Abelian.Ext.mapExactFunctor
            (SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap T ℓ k)) x)
          (zero_add j) := by
      intro x
      rw [wcIntRedTr, dif_pos (hET k)]
      rfl
    have hP : wcZModPull (Dk k) j a = (Abelian.Ext.mk₀ (Dk k).μ.inv).comp
        ((Abelian.Ext.mapExactFunctor (Dk k).Φ a).comp (Abelian.Ext.mk₀ (Dk k).μ.hom)
          (add_zero j)) (zero_add j) := rfl
    have hnat := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp a (ν k).hom
    rw [Abelian.Ext.comp_mapExactFunctor, Abelian.Ext.comp_mapExactFunctor] at hnat
    have hRΨ : Abelian.Ext.mapExactFunctor
          (SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap T ℓ k))
          (Abelian.Ext.mapExactFunctor (Dk k).Φ a) =
        (Abelian.Ext.mk₀ ((ν k).inv.app (SheafOfModules.unit (wcZModRingSheaf Y (ℓ ^ k))))).comp
          ((Abelian.Ext.mapExactFunctor DΛ.Φ (Abelian.Ext.mapExactFunctor
              (SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap Y ℓ k)) a)).comp
            (Abelian.Ext.mk₀ ((ν k).hom.app (SheafOfModules.unit (wcZModRingSheaf Y (ℓ ^ k)))))
            (add_zero j)) (zero_add j) := by
      rw [hnat, Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id_app, Abelian.Ext.mk₀_id_comp]
    have hdeg : wcUnitRestrict (wcIntZModRingSheafMap T ℓ k) ≫
        (SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap T ℓ k)).map (Dk k).μ.inv ≫
          (ν k).inv.app (SheafOfModules.unit (wcZModRingSheaf Y (ℓ ^ k))) =
        DΛ.μ.inv ≫ DΛ.Φ.map (wcUnitRestrict (wcIntZModRingSheafMap Y ℓ k)) := by
      rw [← cancel_epi DΛ.μ.hom, Iso.hom_inv_id_assoc, ← reassoc_of% (hstar k)]
      rw [← Functor.map_comp_assoc, Iso.hom_inv_id, CategoryTheory.Functor.map_id,
        Category.id_comp, Iso.hom_inv_id_app]
      exact Category.comp_id _
    rw [hTT, hTY, hP]
    simp only [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
    rw [hRΨ]
    simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.mk₀_comp_mk₀_assoc, Category.assoc]
    rw [hdeg]



  have hRedT : ∀ (k : ℕ) (y : wcIntExt T ℓ q), wcIntRed T ℓ k q y =
      (AddEquiv.ofBijective (wcIntRedTr T ℓ k q) (hTrT k q)).symm
        (y.comp (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntZModRingSheafMap T ℓ k))) (add_zero q)) := by
    intro k y
    rw [wcIntRed, dif_pos (hTrT k q)]
    rfl
  have hRedY : ∀ (k : ℕ) (y : wcIntExt Y ℓ q), wcIntRed Y ℓ k q y =
      (AddEquiv.ofBijective (wcIntRedTr Y ℓ k q) (hTrY k q)).symm
        (y.comp (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntZModRingSheafMap Y ℓ k))) (add_zero q)) := by
    intro k y
    rw [wcIntRed, dif_pos (hTrY k q)]
    rfl
  have hTauT : ∀ (k j : ℕ) (b : wcZModProEtExt T (ℓ ^ (k + 1)) j), wcIntRedTau T ℓ k j b =
      (AddEquiv.ofBijective (wcIntRedTr T ℓ k j) (hTrT k j)).symm
        ((wcIntRedTr T ℓ (k + 1) j b).comp (Abelian.Ext.mk₀ (Classical.choose (htT k)))
          (add_zero j)) := by
    intro k j b
    rw [wcIntRedTau, dif_pos ⟨hTrT k j, htT k⟩]
    rfl
  have hTauY : ∀ (k j : ℕ) (b : wcZModProEtExt Y (ℓ ^ (k + 1)) j), wcIntRedTau Y ℓ k j b =
      (AddEquiv.ofBijective (wcIntRedTr Y ℓ k j) (hTrY k j)).symm
        ((wcIntRedTr Y ℓ (k + 1) j b).comp (Abelian.Ext.mk₀ (Classical.choose (htY k)))
          (add_zero j)) := by
    intro k j b
    rw [wcIntRedTau, dif_pos ⟨hTrY k j, htY k⟩]
    rfl
  have hTeY : ∀ (k j : ℕ) (w : wcIntResExt Y ℓ k j),
      wcIntRedTr Y ℓ k j ((AddEquiv.ofBijective (wcIntRedTr Y ℓ k j) (hTrY k j)).symm w) = w :=
    fun k j w => (AddEquiv.ofBijective (wcIntRedTr Y ℓ k j) (hTrY k j)).apply_symm_apply w



  have D' : ∀ k : ℕ,
      (ν (k + 1)).hom.app (SheafOfModules.unit (wcZModRingSheaf Y (ℓ ^ (k + 1)))) ≫
        (SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap T ℓ (k + 1))).map
          (Dk (k + 1)).μ.hom ≫ Classical.choose (htT k) =
      DΛ.Φ.map (Classical.choose (htY k)) ≫
        (ν k).hom.app (SheafOfModules.unit (wcZModRingSheaf Y (ℓ ^ k))) ≫
          (SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap T ℓ k)).map
            (Dk k).μ.hom := by
    intro k
    haveI : Epi (wcUnitRestrict (wcIntZModRingSheafMap Y ℓ (k + 1))) := hepi Y (k + 1)
    haveI : DΛ.Φ.IsLeftAdjoint := DΛ.adj.isLeftAdjoint
    haveI := Functor.preservesEpimorphisms_of_isLeftAdjoint DΛ.Φ
    rw [← cancel_epi (DΛ.Φ.map (wcUnitRestrict (wcIntZModRingSheafMap Y ℓ (k + 1)))),
      reassoc_of% (hstar (k + 1)), Classical.choose_spec (htT k), ← Functor.map_comp_assoc,
      Classical.choose_spec (htY k), hstar k]
  refine ⟨fun k y => ?_, fun k j a => ?_⟩



  · rw [hRedT, AddEquiv.symm_apply_eq, AddEquiv.ofBijective_apply, L, hRedY, hTeY]
    rw [show wcIntPull DΛ q y = (Abelian.Ext.mk₀ DΛ.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor DΛ.Φ y).comp (Abelian.Ext.mk₀ DΛ.μ.hom) (add_zero q))
        (zero_add q) from rfl]
    simp only [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.mk₀_comp_mk₀_assoc, Category.assoc]
    rw [hstar k]



  · rw [hTauT, AddEquiv.symm_apply_eq, AddEquiv.ofBijective_apply, L k j, hTauY, hTeY,
      L (k + 1) j]
    simp only [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.mk₀_comp_mk₀_assoc, Category.assoc]
    rw [D' k]

theorem wc_ladic_milnor_package {Y T : Scheme.{u}} (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    [CompactSpace T] [QuasiSeparatedSpace T] [CompactSpace Y] [QuasiSeparatedSpace Y]
    (p : T ⟶ Y) (D : wcHMPullData p ℓ) (hD : wcHMPullCanonical D)
    (Dk : ∀ k : ℕ, wcZModPullData p (ℓ ^ k)) (hDk : ∀ k : ℕ, wcZModPullCanonical (Dk k))
    (q : ℕ) : Nonempty (wcLadicPackage ℓ p D Dk q) :=
by
  classical
  obtain ⟨EY, hEY⟩ := wc_int_rat_data_exists Y ℓ
  obtain ⟨ET, hET⟩ := wc_int_rat_data_exists T ℓ
  obtain ⟨DΛ, hDΛ⟩ := wc_int_pull_data_exists p ℓ
  obtain ⟨hTrY, htY⟩ := wc_int_red_transfer Y ℓ
  obtain ⟨hTrT, htT⟩ := wc_int_red_transfer T ℓ
  have mY := wc_int_red_milnor Y ℓ hTrY htY q
  have mT := wc_int_red_milnor T ℓ hTrT htT q
  have aY := wc_int_red_act Y ℓ hTrY htY q
  have aT := wc_int_red_act T ℓ hTrT htT q
  have rY := wc_int_rat_rationalization Y ℓ EY hEY q
  have rT := wc_int_rat_rationalization T ℓ ET hET q
  have cY := wc_int_rho_act Y ℓ EY hEY q
  have cT := wc_int_rho_act T ℓ ET hET q
  have pc := wc_int_red_pull_compat ℓ p DΛ Dk hTrY htY hTrT htT
    (fun k => wc_int_zmod_pull_restrict_iso ℓ p k DΛ hDΛ (Dk k) (hDk k)) q

  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _
  have hFval : ∀ (c : ℤ_[ℓ]) (V : (Y.ProEt)ᵒᵖ),
      ((SheafOfModules.unitHomEquiv _) (wcIntFun Y ℓ (ContinuousMap.const _ (ULift.up c)))).1 V =
        (ContinuousMap.const _ (ULift.up c) :
          C(↥((Opposite.unop V).left), ULift.{u+1} ℤ_[ℓ])) := by
    intro c V
    simp only [wcIntFun, Equiv.apply_symm_apply]
    rfl
  have hFmul : ∀ a b : ℤ_[ℓ],
      wcIntFun Y ℓ (ContinuousMap.const _ (ULift.up a)) ≫
          wcIntFun Y ℓ (ContinuousMap.const _ (ULift.up b)) =
        wcIntFun Y ℓ (ContinuousMap.const _ (ULift.up (a * b))) := by
    intro a b
    apply (SheafOfModules.unitHomEquiv _).injective
    rw [SheafOfModules.unitHomEquiv_comp_apply]
    apply Subtype.ext
    funext V
    show ((wcIntFun Y ℓ (ContinuousMap.const _ (ULift.up b))).val.app V).hom
        (((SheafOfModules.unitHomEquiv _) (wcIntFun Y ℓ (ContinuousMap.const _ (ULift.up a)))).1 V) =
      ((SheafOfModules.unitHomEquiv _) (wcIntFun Y ℓ (ContinuousMap.const _ (ULift.up (a * b))))).1 V
    rw [hFval, hFval]
    apply ContinuousMap.ext
    intro x
    rfl
  have hF1 : wcIntFun Y ℓ (ContinuousMap.const _ (ULift.up 1)) = 𝟙 _ := by
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext V
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    rw [← SheafOfModules.unitHomEquiv_apply_coe]
    simp only [wcIntFun, Equiv.apply_symm_apply]
    rfl
  have hF0 : wcIntFun Y ℓ (ContinuousMap.const _ (ULift.up 0)) = 0 := by
    apply (SheafOfModules.unitHomEquiv _).injective
    apply PresheafOfModules.sections_ext
    intro V
    simp only [wcIntFun, Equiv.apply_symm_apply]
    rw [SheafOfModules.unitHomEquiv_apply_coe]
    exact ContinuousMap.ext (fun x => rfl)
  have hFadd : ∀ a b : ℤ_[ℓ], wcIntFun Y ℓ (ContinuousMap.const _ (ULift.up (a + b))) =
      wcIntFun Y ℓ (ContinuousMap.const _ (ULift.up a)) +
        wcIntFun Y ℓ (ContinuousMap.const _ (ULift.up b)) := by
    intro a b
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext V
    rw [hFval, SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.add_val,
      PresheafOfModules.add_app]
    show _ = ((SheafOfModules.unitHomEquiv _) (wcIntFun Y ℓ (ContinuousMap.const _ (ULift.up a)))).1 V +
      ((SheafOfModules.unitHomEquiv _) (wcIntFun Y ℓ (ContinuousMap.const _ (ULift.up b)))).1 V
    rw [hFval, hFval]
    apply ContinuousMap.ext
    intro x
    rfl
  let φ : ℤ_[ℓ] →+* AddMonoid.End (wcIntExt Y ℓ q) :=
    { toFun := fun c => wcIntAct Y ℓ q (ContinuousMap.const _ (ULift.up c))
      map_one' := by
        apply AddMonoidHom.ext
        intro y
        show (Abelian.Ext.mk₀ (wcIntFun Y ℓ (ContinuousMap.const _ (ULift.up 1)))).comp y
          (zero_add q) = y
        rw [hF1, Abelian.Ext.mk₀_id_comp]
      map_mul' := by
        intro a b
        apply AddMonoidHom.ext
        intro y
        show (Abelian.Ext.mk₀ (wcIntFun Y ℓ (ContinuousMap.const _ (ULift.up (a * b))))).comp y
            (zero_add q) =
          (Abelian.Ext.mk₀ (wcIntFun Y ℓ (ContinuousMap.const _ (ULift.up a)))).comp
            ((Abelian.Ext.mk₀ (wcIntFun Y ℓ (ContinuousMap.const _ (ULift.up b)))).comp y
              (zero_add q)) (zero_add q)
        rw [Abelian.Ext.mk₀_comp_mk₀_assoc, hFmul]
      map_zero' := by
        apply AddMonoidHom.ext
        intro y
        show (Abelian.Ext.mk₀ (wcIntFun Y ℓ (ContinuousMap.const _ (ULift.up 0)))).comp y
          (zero_add q) = 0
        rw [hF0, Abelian.Ext.mk₀_zero, Abelian.Ext.zero_comp]
      map_add' := by
        intro a b
        apply AddMonoidHom.ext
        intro y
        show (Abelian.Ext.mk₀ (wcIntFun Y ℓ (ContinuousMap.const _ (ULift.up (a + b))))).comp y
            (zero_add q) =
          (Abelian.Ext.mk₀ (wcIntFun Y ℓ (ContinuousMap.const _ (ULift.up a)))).comp y (zero_add q) +
          (Abelian.Ext.mk₀ (wcIntFun Y ℓ (ContinuousMap.const _ (ULift.up b)))).comp y (zero_add q)
        rw [hFadd, Abelian.Ext.mk₀_add, Abelian.Ext.add_comp] }
  exact ⟨{
    MY := wcIntExt Y ℓ q
    MT := wcIntExt T ℓ q
    instMY := inferInstance
    instModY := Module.compHom _ φ
    instMT := inferInstance
    ρY := wcIntRho EY q
    ρT := wcIntRho ET q
    redY := fun k => wcIntRed Y ℓ k q
    redT := fun k => wcIntRed T ℓ k q
    τY := wcIntRedTau Y ℓ
    τT := wcIntRedTau T ℓ
    pI := wcIntPull DΛ q
    act := wcIntAct T ℓ q
    denomY := rY.1
    denomT := rT.1
    torsY := rY.2
    torsT := rT.2
    ρY_smul := fun c y => cY.1 c y
    redY_smul := fun k c y => aY.1 k c y
    redY_compat := mY.1
    redT_compat := mT.1
    liftY := mY.2.1
    sepY := mY.2.2.1
    sepT := mT.2.2.1
    kerY := mY.2.2.2
    ρ_pI := wc_int_rat_pull_compat ℓ p D hD DΛ hDΛ EY hEY ET hET q
    red_pI := pc.1
    ρ_act := cT.2
    red_act := aT.2.1
    τ_pull := pc.2
    τ_fun := aT.2.2 }⟩

theorem wc_ladic_passage_injective {Y T W₀ : Scheme.{u}} (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    [CompactSpace T] [QuasiSeparatedSpace T] [CompactSpace Y] [QuasiSeparatedSpace Y]
    [CompactSpace W₀]
    (g : T ⟶ W₀) (p : T ⟶ Y) (D : wcHMPullData p ℓ) (hD : wcHMPullCanonical D)
    (Dk : ∀ k : ℕ, wcZModPullData p (ℓ ^ k)) (hDk : ∀ k : ℕ, wcZModPullCanonical (Dk k))
    (hfin : ∀ k j : ℕ, 1 ≤ k → Finite (wcZModProEtExt Y (ℓ ^ k) j))
    (htor : ∀ k j : ℕ, 1 ≤ k →
      letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T (ℓ ^ k))) := HasExt.standard _
      ∃ Ξ : LocallyConstant W₀ (wcZModProEtExt Y (ℓ ^ k) j) ≃+ wcZModProEtExt T (ℓ ^ k) j,
        ∀ (V : Set W₀) [∀ x, Decidable (x ∈ V)] (hV : IsClopen V) (a : wcZModProEtExt Y (ℓ ^ k) j),
          Ξ ((LocallyConstant.ofIsClopen hV).map (fun i : Fin 2 => if i = 0 then a else 0)) =
            (Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k)
              ((((LocallyConstant.ofIsClopen hV).map (fun i : Fin 2 =>
                  if i = 0 then (1 : ULift.{u+1} (ZMod (ℓ ^ k))) else 0)).toContinuousMap).comp
                g.base.hom))).comp
              (wcZModPull (Dk k) j a) (zero_add j))
    (q m : ℕ) (e : Fin m → wcHM Y ℓ q)
    (he : Function.Bijective (fun c : Fin m → ℚ_[ℓ] => ∑ a, wcHMScalar Y ℓ q (c a) (e a)))
    (P : wcLadicPackage ℓ p D Dk q) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf T ℓ)) := HasExt.standard _
    Function.Injective (fun c : Fin m → C(↥W₀, ULift.{u+1} ℚ_[ℓ]) =>
      ∑ a, (Abelian.Ext.mk₀ (wcHMFun T ℓ ((c a).comp g.base.hom))).comp
        (wcHMPull D q (e a)) (zero_add q)) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf T ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
  letI := P.instMY
  letI := P.instModY
  letI := P.instMT
  have hℓp : Nat.Prime ℓ := Fact.out

  have hFunAdd : ∀ (f f' : C(↥T, ULift.{u+1} ℚ_[ℓ])),
      wcHMFun T ℓ (f + f') = wcHMFun T ℓ f + wcHMFun T ℓ f' := by
    intro f f'
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext V
    have hvalP : ∀ (h : C(↥T, ULift.{u+1} ℚ_[ℓ])), ((SheafOfModules.unitHomEquiv _) (wcHMFun T ℓ h)).1 V =
        h.comp (Opposite.unop V).hom.base.hom := by
      intro h
      simp only [wcHMFun, Equiv.apply_symm_apply]
      rfl
    rw [hvalP, SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.add_val,
      PresheafOfModules.add_app]
    show _ = ((SheafOfModules.unitHomEquiv _) (wcHMFun T ℓ f)).1 V +
      ((SheafOfModules.unitHomEquiv _) (wcHMFun T ℓ f')).1 V
    rw [hvalP, hvalP]
    apply ContinuousMap.ext
    intro x
    rfl
  have hZFunAdd : ∀ (N : ℕ) (f f' : C(↥T, ULift.{u+1} (ZMod N))),
      wcZModFun T N (f + f') = wcZModFun T N f + wcZModFun T N f' := by
    intro N f f'
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext V
    have hvalP : ∀ (h : C(↥T, ULift.{u+1} (ZMod N))),
        ((SheafOfModules.unitHomEquiv _) (wcZModFun T N h)).1 V =
        h.comp (Opposite.unop V).hom.base.hom := by
      intro h
      simp only [wcZModFun, Equiv.apply_symm_apply]
      rfl
    rw [hvalP, SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.add_val,
      PresheafOfModules.add_app]
    show _ = ((SheafOfModules.unitHomEquiv _) (wcZModFun T N f)).1 V +
      ((SheafOfModules.unitHomEquiv _) (wcZModFun T N f')).1 V
    rw [hvalP, hvalP]
    apply ContinuousMap.ext
    intro x
    rfl
  have hConstAdd : ∀ (a b : ℚ_[ℓ]),
      wcHMConst Y ℓ (a + b) = wcHMConst Y ℓ a + wcHMConst Y ℓ b := by
    intro a b
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext V
    have hvalP : ∀ (c : ℚ_[ℓ]), ((SheafOfModules.unitHomEquiv _) (wcHMConst Y ℓ c)).1 V =
        (ContinuousMap.const _ (ULift.up c) : C(↥((Opposite.unop V).left), ULift.{u+1} ℚ_[ℓ])) := by
      intro c
      simp only [wcHMConst, Equiv.apply_symm_apply]
      rfl
    rw [hvalP, SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.add_val,
      PresheafOfModules.add_app]
    show _ = ((SheafOfModules.unitHomEquiv _) (wcHMConst Y ℓ a)).1 V +
      ((SheafOfModules.unitHomEquiv _) (wcHMConst Y ℓ b)).1 V
    rw [hvalP, hvalP]
    apply ContinuousMap.ext
    intro x
    rfl
  have hConstOne : wcHMConst Y ℓ 1 = 𝟙 _ := by
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext V
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    rw [← SheafOfModules.unitHomEquiv_apply_coe]
    simp only [wcHMConst, Equiv.apply_symm_apply]
    rfl

  have hscal1 : ∀ x : wcHM Y ℓ q, wcHMScalar Y ℓ q 1 x = x := by
    intro x
    show x.comp (Abelian.Ext.mk₀ (wcHMConst Y ℓ 1)) (add_zero q) = x
    rw [hConstOne, Abelian.Ext.comp_mk₀_id]
  obtain ⟨SH, hSH⟩ : ∃ SH : wcHM Y ℓ q → (ℚ_[ℓ] →+ wcHM Y ℓ q),
      ∀ x t, SH x t = wcHMScalar Y ℓ q t x :=
    ⟨fun x => AddMonoidHom.mk' (fun t => wcHMScalar Y ℓ q t x) (fun a b => by
      show x.comp (Abelian.Ext.mk₀ (wcHMConst Y ℓ (a + b))) (add_zero q) =
        x.comp (Abelian.Ext.mk₀ (wcHMConst Y ℓ a)) (add_zero q) +
          x.comp (Abelian.Ext.mk₀ (wcHMConst Y ℓ b)) (add_zero q)
      rw [hConstAdd, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add]), fun _ _ => rfl⟩
  have hscalN : ∀ (N : ℕ) (x : wcHM Y ℓ q),
      wcHMScalar Y ℓ q ((ℓ : ℚ_[ℓ]) ^ N) x = (ℓ ^ N) • x := by
    intro N x
    have e1 : ((ℓ : ℚ_[ℓ]) ^ N) = (ℓ ^ N) • (1 : ℚ_[ℓ]) := by
      rw [nsmul_eq_mul, mul_one, Nat.cast_pow]
    rw [← hSH, e1, map_nsmul, hSH, hscal1]

  obtain ⟨BH, hBH⟩ : ∃ BH : C(↥T, ULift.{u+1} ℚ_[ℓ]) → wcHM T ℓ q → wcHM T ℓ q,
      ∀ f y, BH f y = (Abelian.Ext.mk₀ (wcHMFun T ℓ f)).comp y (zero_add q) :=
    ⟨_, fun _ _ => rfl⟩
  have hBHf : ∀ y, ∃ L : C(↥T, ULift.{u+1} ℚ_[ℓ]) →+ wcHM T ℓ q, ∀ f, L f = BH f y := fun y =>
    ⟨AddMonoidHom.mk' (fun f => BH f y) (fun f f' => by
      rw [hBH, hBH, hBH, hFunAdd, Abelian.Ext.mk₀_add, Abelian.Ext.add_comp]), fun _ => rfl⟩
  have hBHy : ∀ f (k : ℕ) y, BH f (k • y) = k • BH f y := fun f k y => by
    rw [hBH, hBH]
    exact map_nsmul ((Abelian.Ext.mk₀ (wcHMFun T ℓ f)).precomp
      (SheafOfModules.unit (wcRingSheaf T ℓ)) (zero_add q)) k y
  have hBHn : ∀ (k : ℕ) f y, BH (k • f) y = k • BH f y := fun k f y => by
    obtain ⟨L, hL⟩ := hBHf y
    rw [← hL, ← hL, map_nsmul]
  have hBHsub : ∀ f f' y, BH (f - f') y = BH f y - BH f' y := fun f f' y => by
    obtain ⟨L, hL⟩ := hBHf y
    rw [← hL, ← hL, ← hL, map_sub]
  have hΨ : ∀ c : Fin m → C(↥W₀, ULift.{u+1} ℚ_[ℓ]),
      (∑ a, (Abelian.Ext.mk₀ (wcHMFun T ℓ ((c a).comp g.base.hom))).comp
        (wcHMPull D q (e a)) (zero_add q)) =
        ∑ a, BH ((c a).comp g.base.hom) (wcHMPull D q (e a)) := fun c => by
    simp only [hBH]

  have hℓ1 : (1 : ℝ) < ℓ := by exact_mod_cast hℓp.one_lt
  have htoZ : ∀ k : ℕ, Continuous (PadicInt.toZModPow (p := ℓ) k) := by
    intro k
    refine continuous_def.2 (fun s _ => ?_)
    rw [Metric.isOpen_iff]
    intro x hx
    refine ⟨(ℓ : ℝ) ^ (-(k : ℤ)), by
      have : (0 : ℝ) < ℓ := by exact_mod_cast hℓp.pos
      positivity, fun y hy => ?_⟩
    have h1 : ‖y - x‖ ≤ (ℓ : ℝ) ^ (-(k : ℤ)) := by
      rw [Metric.mem_ball, dist_eq_norm] at hy
      exact le_of_lt hy
    rw [PadicInt.norm_le_pow_iff_mem_span_pow, ← PadicInt.ker_toZModPow, RingHom.mem_ker, map_sub,
      sub_eq_zero] at h1
    show PadicInt.toZModPow k y ∈ s
    rw [h1]
    exact hx
  have hlim1gen : ∀ (A : ℕ → Type (u+2)) (inst : ∀ k, AddCommGroup (A k))
      (τ : ∀ k, A (k + 1) →+ A k), (∀ k, 1 ≤ k → Finite (A k)) → @wcLim1Zero A inst τ := by
    intro A inst τ hfinA
    unfold wcLim1Zero
    intro β
    letI : ∀ k, TopologicalSpace (A (k + 1)) := fun _ => ⊥
    haveI : ∀ k, DiscreteTopology (A (k + 1)) := fun _ => ⟨rfl⟩
    haveI : ∀ k, Finite (A (k + 1)) := fun k => hfinA (k + 1) (by omega)
    haveI : ∀ k, CompactSpace (A (k + 1)) := fun _ => Finite.compactSpace
    let t : ℕ → Set (∀ k, A (k + 1)) := fun N =>
      {x | ∀ k < N, x k - τ (k + 1) (x (k + 1)) = β (k + 1)}
    have hclosed : ∀ N, IsClosed (t N) := by
      intro N
      have e : t N = ⋂ k ∈ Finset.range N,
          {x : ∀ k, A (k + 1) | x k - τ (k + 1) (x (k + 1)) = β (k + 1)} := by
        ext x
        simp [t]
      rw [e]
      refine isClosed_biInter (fun k _ => ?_)
      have hset : {x : ∀ k, A (k + 1) | x k - τ (k + 1) (x (k + 1)) = β (k + 1)} =
          {x : ∀ k, A (k + 1) |
            x k = (fun y : A (k + 1 + 1) => β (k + 1) + τ (k + 1) y) (x (k + 1))} := by
        ext x
        simp only [Set.mem_setOf_eq]
        constructor
        · intro h; rw [← h]; abel
        · intro h; rw [h]; abel
      rw [hset]
      have hc : Continuous (fun x : (∀ k, A (k + 1)) =>
          (fun y : A (k + 1 + 1) => β (k + 1) + τ (k + 1) y) (x (k + 1))) :=
        (continuous_of_discreteTopology
          (f := fun y : A (k + 1 + 1) => β (k + 1) + τ (k + 1) y)).comp (continuous_apply (k + 1))
      exact isClosed_eq (continuous_apply k) hc
    have hne : ∀ N, ∀ a : A (N + 1), ∃ x ∈ t N, x N = a := by
      intro N
      induction N with
      | zero =>
        intro a
        refine ⟨Function.update (0 : ∀ k, A (k + 1)) 0 a, ?_, by simp⟩
        intro k hk
        omega
      | succ N ih =>
        intro a
        obtain ⟨x, hx, hxN⟩ := ih (β (N + 1) + τ (N + 1) a)
        refine ⟨Function.update x (N + 1) a, ?_, by simp⟩
        intro k hk
        rcases Nat.lt_succ_iff_lt_or_eq.mp hk with hk | hk
        · have h1 : k ≠ N + 1 := by omega
          have h2 : k + 1 ≠ N + 1 := by omega
          rw [Function.update_of_ne h1, Function.update_of_ne h2]
          exact hx k hk
        · subst hk
          have h1 : k ≠ k + 1 := by omega
          rw [Function.update_of_ne h1, Function.update_self, hxN]
          abel
    have hsub : ∀ N, t (N + 1) ⊆ t N := fun N x hx k hk => hx k (by omega)
    have hnon : ∀ N, (t N).Nonempty := by
      intro N
      obtain ⟨x, hx, -⟩ := hne N 0
      exact ⟨x, hx⟩
    obtain ⟨x, hx⟩ := IsCompact.nonempty_iInter_of_sequence_nonempty_isCompact_isClosed t hsub hnon
      ((hclosed 0).isCompact) hclosed
    rw [Set.mem_iInter] at hx
    refine ⟨fun k => match k with | 0 => 0 | j + 1 => x j, ?_⟩
    intro k hk
    obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
    exact (hx (j + 1) j (by omega)).symm
  have hlim : @wcLim1Zero (fun k => wcZModProEtExt Y (ℓ ^ k) (q - 1)) (fun _ => inferInstance)
      (fun k => P.τY k (q - 1)) :=
    hlim1gen (fun k => wcZModProEtExt Y (ℓ ^ k) (q - 1)) (fun _ => inferInstance)
      (fun k => P.τY k (q - 1))
      (fun k hk => hfin k (q - 1) hk)

  suffices hker : ∀ c : Fin m → C(↥W₀, ULift.{u+1} ℚ_[ℓ]),
      ∑ a, BH ((c a).comp g.base.hom) (wcHMPull D q (e a)) = 0 → c = 0 by
    intro c c' hcc
    have h1 : ∑ a, BH (((c - c') a).comp g.base.hom) (wcHMPull D q (e a)) = 0 := by
      have e0 : ∀ a, BH (((c - c') a).comp g.base.hom) (wcHMPull D q (e a)) =
          BH ((c a).comp g.base.hom) (wcHMPull D q (e a)) -
            BH ((c' a).comp g.base.hom) (wcHMPull D q (e a)) := fun a => by
        rw [Pi.sub_apply, ContinuousMap.sub_comp, hBHsub]
      rw [Finset.sum_congr rfl (fun a _ => e0 a), Finset.sum_sub_distrib, ← hΨ c, ← hΨ c']
      exact sub_eq_zero.mpr hcc
    exact sub_eq_zero.mp (hker _ h1)
  intro c hc

  have hb : ∀ a : Fin m, ∃ B : ℝ, ∀ w : W₀, ‖(c a w).down‖ ≤ B := by
    intro a
    obtain ⟨B, hB⟩ := isCompact_univ.exists_bound_of_continuousOn
      (f := fun w => (c a w).down) (continuous_uliftDown.comp (c a).continuous).continuousOn
    exact ⟨B, fun w => hB w (Set.mem_univ w)⟩
  choose B hB using hb
  obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt (∑ a, |B a|) hℓ1
  have hint : ∀ a w, ‖(ℓ : ℚ_[ℓ]) ^ n * (c a w).down‖ ≤ 1 := by
    intro a w
    have hBa : ‖(c a w).down‖ ≤ ∑ a, |B a| :=
      (hB a w).trans ((le_abs_self (B a)).trans
        (Finset.single_le_sum (f := fun a => |B a|) (fun i _ => abs_nonneg (B i))
          (Finset.mem_univ a)))
    have hpos : (0 : ℝ) < (ℓ : ℝ) ^ n := by positivity
    rw [norm_mul, Padic.norm_p_pow, zpow_neg, zpow_natCast]
    calc ((ℓ : ℝ) ^ n)⁻¹ * ‖(c a w).down‖ ≤ ((ℓ : ℝ) ^ n)⁻¹ * (ℓ : ℝ) ^ n :=
          mul_le_mul_of_nonneg_left (hBa.trans hn.le) (inv_nonneg.mpr hpos.le)
      _ = 1 := inv_mul_cancel₀ hpos.ne'
  obtain ⟨r, hr⟩ : ∃ r : Fin m → C(↥W₀, ULift.{u+1} ℤ_[ℓ]),
      ∀ a w, ((r a w).down : ℚ_[ℓ]) = (ℓ : ℚ_[ℓ]) ^ n * (c a w).down :=
    ⟨fun a => ⟨fun w => ULift.up ⟨(ℓ : ℚ_[ℓ]) ^ n * (c a w).down, hint a w⟩,
      continuous_uliftUp.comp (Continuous.subtype_mk
        (continuous_const.mul (continuous_uliftDown.comp (c a).continuous)) _)⟩, fun _ _ => rfl⟩

  choose Na ε' hε' using fun a => P.denomY (e a)
  obtain ⟨N, hNa⟩ : ∃ N : ℕ, ∀ a, Na a ≤ N :=
    ⟨∑ a, Na a, fun a => Finset.single_le_sum (f := Na) (fun i _ => Nat.zero_le _)
      (Finset.mem_univ a)⟩
  obtain ⟨ε, hε⟩ : ∃ ε : Fin m → P.MY, ∀ a, P.ρY (ε a) = (ℓ ^ N) • e a :=
    ⟨fun a => (ℓ ^ (N - Na a)) • ε' a, fun a => by
      rw [map_nsmul, ← hε', hscalN, smul_smul, ← pow_add, Nat.sub_add_cancel (hNa a)]⟩

  have hR' : ∀ a, ∀ t, (((ℓ ^ n) • ((c a).comp g.base.hom)) t).down =
      (((r a).comp g.base.hom t).down : ℚ_[ℓ]) := by
    intro a t
    show (ℓ ^ n) • (c a (g.base.hom t)).down = ((r a (g.base.hom t)).down : ℚ_[ℓ])
    rw [hr, nsmul_eq_mul, Nat.cast_pow]
  have hx : P.ρT (∑ a, P.act ((r a).comp g.base.hom) (P.pI (ε a))) = 0 := by
    rw [map_sum]
    have h1 : ∀ a, P.ρT (P.act ((r a).comp g.base.hom) (P.pI (ε a))) =
        (ℓ ^ n * ℓ ^ N) • BH ((c a).comp g.base.hom) (wcHMPull D q (e a)) := by
      intro a
      rw [P.ρ_act _ _ (hR' a), P.ρ_pI, hε, map_nsmul (wcHMPull D q), ← hBH, hBHn, hBHy,
        smul_smul]
    rw [Finset.sum_congr rfl (fun a _ => h1 a), ← Finset.smul_sum, hc, smul_zero]
  obtain ⟨s, hs⟩ := P.torsT _ hx
  obtain ⟨δ, hδ⟩ : ∃ δ : Fin m → P.MY, ∀ a, δ a = (ℓ ^ s) • ε a := ⟨_, fun _ => rfl⟩
  have hxδ : ∑ a, P.act ((r a).comp g.base.hom) (P.pI (δ a)) = 0 := by
    simp only [hδ, map_nsmul]
    rw [← Finset.smul_sum]
    exact hs

  have hμ : ∀ w : W₀, ∑ a, (r a w).down • δ a = 0 := by
    intro w
    apply P.sepY hlim
    intro k hk
    letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T (ℓ ^ k))) := HasExt.standard _
    obtain ⟨Ξ, hΞ⟩ := htor k q hk
    obtain ⟨BHk, hBHk⟩ : ∃ BHk : C(↥T, ULift.{u+1} (ZMod (ℓ ^ k))) →
        wcZModProEtExt T (ℓ ^ k) q → wcZModProEtExt T (ℓ ^ k) q,
        ∀ f y, BHk f y = (Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) f)).comp y (zero_add q) :=
      ⟨_, fun _ _ => rfl⟩
    have hBHkf : ∀ y, ∃ L : C(↥T, ULift.{u+1} (ZMod (ℓ ^ k))) →+ wcZModProEtExt T (ℓ ^ k) q,
        ∀ f, L f = BHk f y := fun y =>
      ⟨AddMonoidHom.mk' (fun f => BHk f y) (fun f f' => by
        rw [hBHk, hBHk, hBHk, hZFunAdd, Abelian.Ext.mk₀_add, Abelian.Ext.add_comp]), fun _ => rfl⟩
    have hBHky : ∀ f (j : ℕ) y, BHk f (j • y) = j • BHk f y := fun f j y => by
      rw [hBHk, hBHk]
      exact map_nsmul ((Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) f)).precomp
        (SheafOfModules.unit (wcZModRingSheaf T (ℓ ^ k))) (zero_add q)) j y
    have hBHkn : ∀ (j : ℕ) f y, BHk (j • f) y = j • BHk f y := fun j f y => by
      obtain ⟨L, hL⟩ := hBHkf y
      rw [← hL, ← hL, map_nsmul]
    have hBHksum : ∀ (F : ZMod (ℓ ^ k) → C(↥T, ULift.{u+1} (ZMod (ℓ ^ k)))) y,
        ∑ v, BHk (F v) y = BHk (∑ v, F v) y := fun F y => by
      obtain ⟨L, hL⟩ := hBHkf y
      simp only [← hL]
      rw [map_sum]

    have hkey : ∀ (ρ : C(↥W₀, ULift.{u+1} (ZMod (ℓ ^ k)))) (b : wcZModProEtExt Y (ℓ ^ k) q),
        ∃ φ : LocallyConstant W₀ (wcZModProEtExt Y (ℓ ^ k) q), (∀ w, φ w = (ρ w).down.val • b) ∧
          Ξ φ = BHk (ρ.comp g.base.hom) (wcZModPull (Dk k) q b) := by
      intro ρ b
      have hV : ∀ v : ZMod (ℓ ^ k), IsClopen ((fun w => (ρ w).down) ⁻¹' {v}) :=
        fun v => (isClopen_discrete {v}).preimage (continuous_uliftDown.comp ρ.continuous)
      have hfib : ∀ v w, LocallyConstant.ofIsClopen (hV v) w = 0 ↔ (ρ w).down = v := fun v w =>
        Set.ext_iff.mp (LocallyConstant.ofIsClopen_fiber_zero (hV v)) w
      refine ⟨∑ v : ZMod (ℓ ^ k), (LocallyConstant.ofIsClopen (hV v)).map
          (fun i : Fin 2 => if i = 0 then v.val • b else 0), fun w => ?_, ?_⟩
      · have e1 : (∑ v : ZMod (ℓ ^ k), (LocallyConstant.ofIsClopen (hV v)).map
            (fun i : Fin 2 => if i = 0 then v.val • b else 0)) w = ∑ v : ZMod (ℓ ^ k),
            ((LocallyConstant.ofIsClopen (hV v)).map
              (fun i : Fin 2 => if i = 0 then v.val • b else 0)) w :=
          map_sum (LocallyConstant.evalAddMonoidHom w) _ _
        rw [e1]
        have e2 : ∀ v : ZMod (ℓ ^ k), ((LocallyConstant.ofIsClopen (hV v)).map
            (fun i : Fin 2 => if i = 0 then v.val • b else 0)) w =
            if (ρ w).down = v then v.val • b else 0 := by
          intro v
          show (if LocallyConstant.ofIsClopen (hV v) w = 0 then v.val • b else 0) = _
          by_cases hw : (ρ w).down = v
          · rw [(hfib v w).mpr hw, if_pos rfl, if_pos hw]
          · rw [if_neg (fun h => hw ((hfib v w).mp h)), if_neg hw]
        rw [Finset.sum_congr rfl (fun v _ => e2 v), Finset.sum_ite_eq, if_pos (Finset.mem_univ _)]
      · have hfun : ∑ v : ZMod (ℓ ^ k), v.val • (((LocallyConstant.ofIsClopen (hV v)).map
            (fun i : Fin 2 => if i = 0 then (1 : ULift.{u+1} (ZMod (ℓ ^ k))) else 0)).toContinuousMap).comp
              g.base.hom = ρ.comp g.base.hom := by
          apply ContinuousMap.ext
          intro t
          rw [ContinuousMap.sum_apply]
          apply ULift.ext
          show _ = (ρ (g.base.hom t)).down
          rw [show ∀ (f : ZMod (ℓ ^ k) → ULift.{u+1} (ZMod (ℓ ^ k))),
              (∑ v, f v).down = ∑ v, (f v).down from
            fun f => map_sum (AddEquiv.ulift : ULift.{u+1} (ZMod (ℓ ^ k)) ≃+ ZMod (ℓ ^ k)) f
              Finset.univ]
          have e4 : ∀ v : ZMod (ℓ ^ k), ((v.val • (((LocallyConstant.ofIsClopen (hV v)).map
              (fun i : Fin 2 => if i = 0 then (1 : ULift.{u+1} (ZMod (ℓ ^ k))) else 0)).toContinuousMap).comp
                g.base.hom) t).down =
              if (ρ (g.base.hom t)).down = v then v.val • (1 : ZMod (ℓ ^ k)) else 0 := by
            intro v
            show v.val • (if LocallyConstant.ofIsClopen (hV v) (g.base.hom t) = 0 then
              (1 : ULift.{u+1} (ZMod (ℓ ^ k))) else 0).down = _
            by_cases hw : (ρ (g.base.hom t)).down = v
            · rw [(hfib v _).mpr hw, if_pos rfl, if_pos hw, ULift.one_down]
            · rw [if_neg (fun h => hw ((hfib v _).mp h)), if_neg hw, ULift.zero_down, smul_zero]
          rw [Finset.sum_congr rfl (fun v _ => e4 v), Finset.sum_ite_eq, if_pos (Finset.mem_univ _),
            nsmul_eq_mul, mul_one, ZMod.natCast_zmod_val]
        rw [map_sum]
        have e3 : ∀ v : ZMod (ℓ ^ k), Ξ ((LocallyConstant.ofIsClopen (hV v)).map
            (fun i : Fin 2 => if i = 0 then v.val • b else 0)) =
            BHk (v.val • (((LocallyConstant.ofIsClopen (hV v)).map (fun i : Fin 2 =>
              if i = 0 then (1 : ULift.{u+1} (ZMod (ℓ ^ k))) else 0)).toContinuousMap).comp
                g.base.hom) (wcZModPull (Dk k) q b) := by
          intro v
          rw [hΞ _ (hV v), map_nsmul (wcZModPull (Dk k) q), ← hBHk, hBHky, hBHkn]
        rw [Finset.sum_congr rfl (fun v _ => e3 v), hBHksum, hfun]
    obtain ⟨ρk, hρk⟩ : ∃ ρk : Fin m → C(↥W₀, ULift.{u+1} (ZMod (ℓ ^ k))),
        ∀ a w, (ρk a w).down = PadicInt.toZModPow k (r a w).down :=
      ⟨fun a => ⟨fun w => ULift.up (PadicInt.toZModPow k (r a w).down),
        continuous_uliftUp.comp ((htoZ k).comp (continuous_uliftDown.comp (r a).continuous))⟩,
        fun _ _ => rfl⟩
    choose φ hφ hΞφ using fun a => hkey (ρk a) (P.redY k (δ a))
    have hsum0 : Ξ (∑ a, φ a) = 0 := by
      rw [map_sum]
      have e5 : ∀ a, Ξ (φ a) = P.redT k (P.act ((r a).comp g.base.hom) (P.pI (δ a))) := by
        intro a
        rw [hΞφ, P.red_act k _ ((ρk a).comp g.base.hom) (fun t => hρk a _), P.red_pI, hBHk]
      rw [Finset.sum_congr rfl (fun a _ => e5 a), ← map_sum, hxδ, map_zero]
    have hsum1 : ∑ a, φ a = 0 := Ξ.injective (hsum0.trans (map_zero Ξ).symm)
    have hev : ∑ a, φ a w = 0 := by
      have h2 := map_sum (LocallyConstant.evalAddMonoidHom w) φ Finset.univ
      rw [hsum1, map_zero] at h2
      exact h2.symm
    rw [map_sum, ← hev]
    refine Finset.sum_congr rfl (fun a _ => ?_)
    rw [P.redY_smul, hφ, hρk]

  have hd : ∀ w a, (c a w).down = 0 := by
    intro w
    have h0 := congrArg P.ρY (hμ w)
    rw [map_sum, map_zero] at h0
    have e6 : ∀ a, P.ρY ((r a w).down • δ a) =
        (ℓ ^ s * ℓ ^ N) • wcHMScalar Y ℓ q ((r a w).down : ℚ_[ℓ]) (e a) := by
      intro a
      rw [P.ρY_smul, hδ, map_nsmul, hε, smul_smul, map_nsmul]
    rw [Finset.sum_congr rfl (fun a _ => e6 a)] at h0
    have h8 : ∀ a, wcHMScalar Y ℓ q ((ℓ ^ s * ℓ ^ N) • ((r a w).down : ℚ_[ℓ])) (e a) =
        (ℓ ^ s * ℓ ^ N) • wcHMScalar Y ℓ q ((r a w).down : ℚ_[ℓ]) (e a) := fun a => by
      rw [← hSH, ← hSH, map_nsmul]
    have h9 : ∀ a, wcHMScalar Y ℓ q 0 (e a) = 0 := fun a => by
      rw [← hSH, map_zero]
    have h7 : (fun a => (ℓ ^ s * ℓ ^ N) • ((r a w).down : ℚ_[ℓ])) = (0 : Fin m → ℚ_[ℓ]) := by
      apply he.1
      show ∑ a, wcHMScalar Y ℓ q ((ℓ ^ s * ℓ ^ N) • ((r a w).down : ℚ_[ℓ])) (e a) =
        ∑ a, wcHMScalar Y ℓ q ((0 : Fin m → ℚ_[ℓ]) a) (e a)
      simp only [h8, Pi.zero_apply, h9, Finset.sum_const_zero]
      exact h0
    intro a
    have h10 := congrFun h7 a
    simp only [Pi.zero_apply] at h10
    rw [nsmul_eq_mul, hr] at h10
    have hK : (((ℓ ^ s * ℓ ^ N : ℕ)) : ℚ_[ℓ]) ≠ 0 := by
      exact_mod_cast (Nat.mul_ne_zero (pow_ne_zero _ hℓp.ne_zero) (pow_ne_zero _ hℓp.ne_zero))
    have hℓ0 : ((ℓ : ℚ_[ℓ]) ^ n) ≠ 0 := pow_ne_zero _ (Nat.cast_ne_zero.mpr hℓp.ne_zero)
    rcases mul_eq_zero.mp h10 with h | h
    · exact absurd h hK
    · rcases mul_eq_zero.mp h with h' | h'
      · exact absurd h' hℓ0
      · exact h'
  funext a
  apply ContinuousMap.ext
  intro w
  apply ULift.ext
  exact hd w a

theorem wc_tower_lim1_of_ml {A : ℕ → Type*} [∀ k, AddCommGroup (A k)]
    (τ : ∀ k, A (k + 1) →+ A k) (h : wcTowerML τ) : wcLim1Zero τ :=
by
  classical

  have mono : ∀ (k : ℕ) (a : A k) (n m : ℕ), m ≤ n → wcLiftsTo τ k a n → wcLiftsTo τ k a m := by
    intro k a n m hmn hl
    obtain ⟨c, hc0, hc⟩ := hl
    exact ⟨c, hc0, fun i hi1 hi2 => hc i hi1 (lt_of_lt_of_le hi2 hmn)⟩

  have zero : ∀ (k n : ℕ), wcLiftsTo τ k 0 n := by
    intro k n
    exact ⟨0, rfl, fun i _ _ => by simp⟩

  have sub : ∀ (k : ℕ) (a a' : A k), (∀ n, wcLiftsTo τ k a n) → (∀ n, wcLiftsTo τ k a' n) →
      ∀ n, wcLiftsTo τ k (a - a') n := by
    intro k a a' ha ha' n
    obtain ⟨c, hc0, hc⟩ := ha n
    obtain ⟨c', hc0', hc'⟩ := ha' n
    refine ⟨c - c', by simp [hc0, hc0'], fun i hi1 hi2 => ?_⟩
    simp only [Pi.sub_apply, map_sub, hc i hi1 hi2, hc' i hi1 hi2]

  have surj : ∀ (k : ℕ) (a : A k), (∀ n, wcLiftsTo τ k a n) →
      ∃ b : A (k + 1), (∀ n, wcLiftsTo τ (k + 1) b n) ∧ τ k b = a := by
    intro k a ha
    obtain ⟨N₁, _, hML⟩ := h (k + 1) (by omega)
    obtain ⟨c, hc0, hc⟩ := ha (max N₁ (k + 2))
    refine ⟨c (k + 1), hML _ (mono _ _ (max N₁ (k + 2)) N₁ (le_max_left _ _)
      ⟨c, rfl, fun i h1 h2 => hc i (by omega) h2⟩), ?_⟩
    rw [hc k le_rfl (lt_of_lt_of_le (by omega : k < k + 2) (le_max_right _ _)), hc0]

  have solve : ∀ γ : ∀ k, A k, (∀ k, 1 ≤ k → ∀ n, wcLiftsTo τ k (γ k) n) →
      ∃ u : ∀ k, A k, ∀ k, 1 ≤ k → τ k (u (k + 1)) = u k - γ k := by
    intro γ hγ
    obtain ⟨s, hs⟩ : ∃ s : ∀ k, A k → A (k + 1), ∀ k (a : A k), (∀ n, wcLiftsTo τ k a n) →
        (∀ n, wcLiftsTo τ (k + 1) (s k a) n) ∧ τ k (s k a) = a := by
      refine ⟨fun k a => if hh : ∃ b : A (k + 1), (∀ n, wcLiftsTo τ (k + 1) b n) ∧ τ k b = a
        then Classical.choose hh else 0, fun k a ha => ?_⟩
      have hh := surj k a ha
      dsimp only
      rw [dif_pos hh]
      exact Classical.choose_spec hh
    obtain ⟨δ, hδ⟩ : ∃ δ : ∀ k, A k → A k, ∀ k (a : A k), δ k a = if 1 ≤ k then a - γ k else 0 :=
      ⟨fun k a => if 1 ≤ k then a - γ k else 0, fun _ _ => rfl⟩
    obtain ⟨u, hu0, huS⟩ : ∃ u : ∀ k, A k, u 0 = 0 ∧ ∀ k, u (k + 1) = s k (δ k (u k)) :=
      ⟨fun k => Nat.rec (motive := fun k => A k) (0 : A 0) (fun k uk => s k (δ k uk)) k,
        rfl, fun _ => rfl⟩
    have hδs : ∀ k, (∀ n, wcLiftsTo τ k (u k) n) → ∀ n, wcLiftsTo τ k (δ k (u k)) n := by
      intro k hk
      by_cases h1 : 1 ≤ k
      · rw [hδ, if_pos h1]
        exact sub k _ _ hk (hγ k h1)
      · rw [hδ, if_neg h1]
        exact zero k
    have hstab : ∀ k, ∀ n, wcLiftsTo τ k (u k) n := by
      intro k
      induction k with
      | zero => rw [hu0]; exact zero 0
      | succ k ih => rw [huS]; exact (hs k _ (hδs k ih)).1
    refine ⟨u, fun k hk => ?_⟩
    rw [huS, (hs k _ (hδs k (hstab k))).2, hδ, if_pos hk]
  intro β

  have hpart : ∀ d k : ℕ, ∃ x : ∀ i, A i,
      ∀ i, k ≤ i → i < k + d → β i = x i - τ i (x (i + 1)) := by
    intro d
    induction d with
    | zero => intro k; exact ⟨0, fun i h1 h2 => by omega⟩
    | succ d ih =>
      intro k
      obtain ⟨x', hx'⟩ := ih (k + 1)
      refine ⟨Function.update x' k (β k + τ k (x' (k + 1))), fun i h1 h2 => ?_⟩
      by_cases hik : i = k
      · subst hik
        rw [Function.update_self, Function.update_of_ne (by omega)]
        abel
      · rw [Function.update_of_ne hik, Function.update_of_ne (by omega)]
        exact hx' i (by omega) (by omega)

  have defect : ∀ (k N N' : ℕ) (x x' : ∀ i, A i), k + 1 ≤ N → N ≤ N' →
      (∀ i, k ≤ i → i < N → β i = x i - τ i (x (i + 1))) →
      (∀ i, k + 1 ≤ i → i < N' → β i = x' i - τ i (x' (i + 1))) →
      wcLiftsTo τ k (β k - x k + τ k (x' (k + 1))) N := by
    intro k N N' x x' hkN hNN' hx hx'
    refine ⟨Function.update (x' - x) k (β k - x k + τ k (x' (k + 1))),
      Function.update_self _ _ _, fun i h1 h2 => ?_⟩
    by_cases hik : i = k
    · subst hik
      rw [Function.update_self, Function.update_of_ne (by omega), Pi.sub_apply, map_sub,
        hx i le_rfl (by omega)]
      abel
    · have e1 := hx i h1 h2
      have e2 := hx' i (by omega) (by omega)
      rw [eq_sub_iff_add_eq] at e1 e2
      rw [Function.update_of_ne hik, Function.update_of_ne (by omega), Pi.sub_apply,
        Pi.sub_apply, map_sub, ← e1, ← e2]
      abel

  obtain ⟨N0, hN0⟩ : ∃ N0 : ℕ → ℕ, ∀ k, 1 ≤ k → k ≤ N0 k ∧
      ∀ a : A k, wcLiftsTo τ k a (N0 k) → ∀ n, wcLiftsTo τ k a n := by
    choose! N0 hN0 using (h : ∀ k, 1 ≤ k → ∃ N, k ≤ N ∧
      ∀ a : A k, wcLiftsTo τ k a N → ∀ n, wcLiftsTo τ k a n)
    exact ⟨N0, hN0⟩
  obtain ⟨M, hM⟩ : ∃ M : ℕ → ℕ, ∀ k, M k = k + 1 + ∑ j ∈ Finset.range (k + 1), N0 j :=
    ⟨_, fun _ => rfl⟩
  have hM1 : ∀ k, k + 1 ≤ M k := fun k => by rw [hM]; omega
  have hM2 : ∀ k, N0 k ≤ M k := fun k => by
    have : N0 k ≤ ∑ j ∈ Finset.range (k + 1), N0 j :=
      Finset.single_le_sum (f := N0) (fun j _ => Nat.zero_le _)
        (Finset.mem_range.mpr (Nat.lt_succ_self k))
    rw [hM]; omega
  have hM3 : ∀ k, M k ≤ M (k + 1) := fun k => by
    rw [hM, hM, Finset.sum_range_succ _ (k + 1)]; omega
  choose X hX using fun k => hpart (M k - k) k
  have hX' : ∀ k i, k ≤ i → i < M k → β i = X k i - τ i (X k (i + 1)) := fun k i h1 h2 =>
    hX k i h1 (by have := hM1 k; omega)
  have hγ : ∀ k, 1 ≤ k → ∀ n, wcLiftsTo τ k (β k - X k k + τ k (X (k + 1) (k + 1))) n := by
    intro k hk
    have h1 := defect k (M k) (M (k + 1)) (X k) (X (k + 1)) (hM1 k) (hM3 k) (hX' k) (hX' (k + 1))
    exact (hN0 k hk).2 _ (mono _ _ _ _ (hM2 k) h1)
  obtain ⟨u, hu⟩ := solve (fun k => β k - X k k + τ k (X (k + 1) (k + 1))) hγ
  refine ⟨fun k => X k k + u k, fun k hk => ?_⟩
  have e := hu k hk
  beta_reduce at e ⊢
  rw [map_add, e]
  abel

theorem wc_tower_ml_of_finite {A : ℕ → Type*} [∀ k, AddCommGroup (A k)]
    (τ : ∀ k, A (k + 1) →+ A k) (h : ∀ k, 1 ≤ k → Finite (A k)) : wcTowerML τ :=
by
  classical
  intro k hk
  haveI : Finite (A k) := h k hk
  have mono : ∀ (a : A k) (n n' : ℕ), n ≤ n' → wcLiftsTo τ k a n' → wcLiftsTo τ k a n := by
    rintro a n n' hnn' ⟨c, hc0, hc⟩
    exact ⟨c, hc0, fun i hi1 hi2 => hc i hi1 (lt_of_lt_of_le hi2 hnn')⟩
  let S : ℕ → Set (A k) := fun n => {a | wcLiftsTo τ k a n}
  have hS : ∀ n n', n ≤ n' → S n' ⊆ S n := fun n n' hnn' a ha => mono a n n' hnn' ha
  let f : ℕ → ℕ := fun m => (S (m + k)).ncard
  have hex : ∃ v, ∃ m, f m = v := ⟨f 0, 0, rfl⟩
  obtain ⟨m₀, hm₀⟩ := Nat.find_spec hex
  have hmin : ∀ m, Nat.find hex ≤ f m := fun m => Nat.find_min' hex ⟨m, rfl⟩
  refine ⟨m₀ + k, Nat.le_add_left k m₀, ?_⟩
  intro a ha n
  rcases le_total n (m₀ + k) with hn | hn
  · exact mono a n (m₀ + k) hn ha
  · have hsub : S n ⊆ S (m₀ + k) := hS _ _ hn
    have h2 : n - k + k = n := Nat.sub_add_cancel (le_trans (Nat.le_add_left k m₀) hn)
    have hfn : f (n - k) = (S n).ncard := by
      show (S (n - k + k)).ncard = (S n).ncard
      rw [h2]
    have hcard : (S (m₀ + k)).ncard ≤ (S n).ncard := by
      show f m₀ ≤ (S n).ncard
      rw [hm₀, ← hfn]
      exact hmin (n - k)
    have heq : S n = S (m₀ + k) := Set.eq_of_subset_of_ncard_le hsub hcard (Set.toFinite _)
    have hmem : a ∈ S (m₀ + k) := ha
    rw [← heq] at hmem
    exact hmem

theorem wc_lim1_transport_locallyConstant {A B : ℕ → Type*} [∀ k, AddCommGroup (A k)]
    [∀ k, AddCommGroup (B k)] (τA : ∀ k, A (k + 1) →+ A k) (τB : ∀ k, B (k + 1) →+ B k)
    {W : Type*} [TopologicalSpace W] (hML : wcTowerML τA)
    (Ξ : ∀ k : ℕ, 1 ≤ k → (LocallyConstant W (A k) ≃+ B k))
    (hΞ : ∀ (k : ℕ) (hk : 1 ≤ k) (ψ : LocallyConstant W (A (k + 1))),
      τB k (Ξ (k + 1) (by omega) ψ) = Ξ k hk (LocallyConstant.map (τA k) ψ)) :
    wcLim1Zero τB :=
by
  classical

  have key : ∀ (C : ℕ → Type _) [∀ k, AddCommGroup (C k)] (τ : ∀ k, C (k + 1) →+ C k),
      wcTowerML τ → wcLim1Zero τ := by
    intro C _ τ h
    have mono : ∀ (k : ℕ) (a : C k) (n m : ℕ), m ≤ n →
        wcLiftsTo τ k a n → wcLiftsTo τ k a m := by
      intro k a n m hmn hl
      obtain ⟨c, hc0, hc⟩ := hl
      exact ⟨c, hc0, fun i hi1 hi2 => hc i hi1 (lt_of_lt_of_le hi2 hmn)⟩
    have zero : ∀ (k n : ℕ), wcLiftsTo τ k 0 n := by
      intro k n
      exact ⟨0, rfl, fun i _ _ => by simp⟩
    have sub : ∀ (k : ℕ) (a a' : C k), (∀ n, wcLiftsTo τ k a n) →
        (∀ n, wcLiftsTo τ k a' n) → ∀ n, wcLiftsTo τ k (a - a') n := by
      intro k a a' ha ha' n
      obtain ⟨c, hc0, hc⟩ := ha n
      obtain ⟨c', hc0', hc'⟩ := ha' n
      refine ⟨c - c', by simp [hc0, hc0'], fun i hi1 hi2 => ?_⟩
      simp only [Pi.sub_apply, map_sub, hc i hi1 hi2, hc' i hi1 hi2]
    have surj : ∀ (k : ℕ) (a : C k), (∀ n, wcLiftsTo τ k a n) →
        ∃ b : C (k + 1), (∀ n, wcLiftsTo τ (k + 1) b n) ∧ τ k b = a := by
      intro k a ha
      obtain ⟨N₁, _, hML1⟩ := h (k + 1) (by omega)
      obtain ⟨c, hc0, hc⟩ := ha (max N₁ (k + 2))
      refine ⟨c (k + 1), hML1 _ (mono _ _ (max N₁ (k + 2)) N₁ (le_max_left _ _)
        ⟨c, rfl, fun i h1 h2 => hc i (by omega) h2⟩), ?_⟩
      rw [hc k le_rfl (lt_of_lt_of_le (by omega : k < k + 2) (le_max_right _ _)), hc0]
    have solve : ∀ γ : ∀ k, C k,
        (∀ k, 1 ≤ k → ∀ n, wcLiftsTo τ k (γ k) n) →
        ∃ u : ∀ k, C k, ∀ k, 1 ≤ k → τ k (u (k + 1)) = u k - γ k := by
      intro γ hγ
      obtain ⟨s, hs⟩ : ∃ s : ∀ k, C k → C (k + 1),
          ∀ k (a : C k), (∀ n, wcLiftsTo τ k a n) →
          (∀ n, wcLiftsTo τ (k + 1) (s k a) n) ∧ τ k (s k a) = a := by
        refine ⟨fun k a => if hh : ∃ b : C (k + 1),
          (∀ n, wcLiftsTo τ (k + 1) b n) ∧ τ k b = a
          then Classical.choose hh else 0, fun k a ha => ?_⟩
        have hh := surj k a ha
        dsimp only
        rw [dif_pos hh]
        exact Classical.choose_spec hh
      obtain ⟨δ, hδ⟩ : ∃ δ : ∀ k, C k → C k,
          ∀ k (a : C k), δ k a = if 1 ≤ k then a - γ k else 0 :=
        ⟨fun k a => if 1 ≤ k then a - γ k else 0, fun _ _ => rfl⟩
      obtain ⟨u, hu0, huS⟩ : ∃ u : ∀ k, C k, u 0 = 0 ∧
          ∀ k, u (k + 1) = s k (δ k (u k)) :=
        ⟨fun k => Nat.rec (motive := fun k => C k)
          (0 : C 0) (fun k uk => s k (δ k uk)) k, rfl, fun _ => rfl⟩
      have hδs : ∀ k, (∀ n, wcLiftsTo τ k (u k) n) → ∀ n, wcLiftsTo τ k (δ k (u k)) n := by
        intro k hk
        by_cases h1 : 1 ≤ k
        · rw [hδ, if_pos h1]
          exact sub k _ _ hk (hγ k h1)
        · rw [hδ, if_neg h1]
          exact zero k
      have hstab : ∀ k, ∀ n, wcLiftsTo τ k (u k) n := by
        intro k
        induction k with
        | zero => rw [hu0]; exact zero 0
        | succ k ih => rw [huS]; exact (hs k _ (hδs k ih)).1
      refine ⟨u, fun k hk => ?_⟩
      rw [huS, (hs k _ (hδs k (hstab k))).2, hδ, if_pos hk]
    intro β
    have hpart : ∀ d k : ℕ, ∃ x : ∀ i, C i,
        ∀ i, k ≤ i → i < k + d → β i = x i - τ i (x (i + 1)) := by
      intro d
      induction d with
      | zero => intro k; exact ⟨0, fun i h1 h2 => by omega⟩
      | succ d ih =>
        intro k
        obtain ⟨x', hx'⟩ := ih (k + 1)
        refine ⟨Function.update x' k (β k + τ k (x' (k + 1))), fun i h1 h2 => ?_⟩
        by_cases hik : i = k
        · subst hik
          rw [Function.update_self, Function.update_of_ne (by omega)]
          abel
        · rw [Function.update_of_ne hik, Function.update_of_ne (by omega)]
          exact hx' i (by omega) (by omega)
    have defect : ∀ (k N N' : ℕ) (x x' : ∀ i, C i), k + 1 ≤ N → N ≤ N' →
        (∀ i, k ≤ i → i < N → β i = x i - τ i (x (i + 1))) →
        (∀ i, k + 1 ≤ i → i < N' → β i = x' i - τ i (x' (i + 1))) →
        wcLiftsTo τ k (β k - x k + τ k (x' (k + 1))) N := by
      intro k N N' x x' hkN hNN' hx hx'
      refine ⟨Function.update (x' - x) k (β k - x k + τ k (x' (k + 1))),
        Function.update_self _ _ _, fun i h1 h2 => ?_⟩
      by_cases hik : i = k
      · subst hik
        rw [Function.update_self, Function.update_of_ne (by omega), Pi.sub_apply, map_sub,
          hx i le_rfl (by omega)]
        abel
      · have e1 := hx i h1 h2
        have e2 := hx' i (by omega) (by omega)
        rw [eq_sub_iff_add_eq] at e1 e2
        rw [Function.update_of_ne hik, Function.update_of_ne (by omega), Pi.sub_apply,
          Pi.sub_apply, map_sub, ← e1, ← e2]
        abel
    obtain ⟨N0, hN0⟩ : ∃ N0 : ℕ → ℕ, ∀ k, 1 ≤ k → k ≤ N0 k ∧
        ∀ a : C k, wcLiftsTo τ k a (N0 k) → ∀ n, wcLiftsTo τ k a n := by
      choose! N0 hN0 using (h : ∀ k, 1 ≤ k → ∃ N, k ≤ N ∧
        ∀ a : C k, wcLiftsTo τ k a N → ∀ n, wcLiftsTo τ k a n)
      exact ⟨N0, hN0⟩
    obtain ⟨M, hM⟩ : ∃ M : ℕ → ℕ, ∀ k, M k = k + 1 + ∑ j ∈ Finset.range (k + 1), N0 j :=
      ⟨_, fun _ => rfl⟩
    have hM1 : ∀ k, k + 1 ≤ M k := fun k => by rw [hM]; omega
    have hM2 : ∀ k, N0 k ≤ M k := fun k => by
      have : N0 k ≤ ∑ j ∈ Finset.range (k + 1), N0 j :=
        Finset.single_le_sum (f := N0) (fun j _ => Nat.zero_le _)
          (Finset.mem_range.mpr (Nat.lt_succ_self k))
      rw [hM]; omega
    have hM3 : ∀ k, M k ≤ M (k + 1) := fun k => by
      rw [hM, hM, Finset.sum_range_succ _ (k + 1)]; omega
    choose X hX using fun k => hpart (M k - k) k
    have hX' : ∀ k i, k ≤ i → i < M k → β i = X k i - τ i (X k (i + 1)) := fun k i h1 h2 =>
      hX k i h1 (by have := hM1 k; omega)
    have hγ : ∀ k, 1 ≤ k → ∀ n, wcLiftsTo τ k (β k - X k k + τ k (X (k + 1) (k + 1))) n := by
      intro k hk
      have h1 := defect k (M k) (M (k + 1)) (X k) (X (k + 1)) (hM1 k) (hM3 k) (hX' k)
        (hX' (k + 1))
      exact (hN0 k hk).2 _ (mono _ _ _ _ (hM2 k) h1)
    obtain ⟨u, hu⟩ := solve (fun k => β k - X k k + τ k (X (k + 1) (k + 1))) hγ
    refine ⟨fun k => X k k + u k, fun k hk => ?_⟩
    have e := hu k hk
    beta_reduce at e ⊢
    rw [map_add, e]
    abel

  have hMLC : @wcTowerML (fun j => LocallyConstant W (A j)) (fun _ => inferInstance)
      (fun k => (LocallyConstant.mapAddMonoidHom (τA k) :
        LocallyConstant W (A (k + 1)) →+ LocallyConstant W (A k))) := by
    intro k hk
    obtain ⟨N, hkN, hN⟩ := hML k hk
    refine ⟨N, hkN, fun f hf n => ?_⟩
    obtain ⟨Cc, hC0, hC⟩ := hf
    have hall : ∀ w, ∀ n, wcLiftsTo τA k (f w) n := by
      intro w
      apply hN
      refine ⟨fun i => Cc i w, ?_, fun i h1 h2 => ?_⟩
      · show Cc k w = f w
        rw [hC0]
      · have e := congrArg (fun g : LocallyConstant W (A i) => g w) (hC i h1 h2)
        exact e
    obtain ⟨sel, hsel⟩ : ∃ sel : A k → ∀ i, A i, ∀ a, wcLiftsTo τA k a n →
        sel a k = a ∧ ∀ i, k ≤ i → i < n → τA i (sel a (i + 1)) = sel a i := by
      refine ⟨fun a => if hl : wcLiftsTo τA k a n then Classical.choose hl else 0,
        fun a ha => ?_⟩
      dsimp only
      rw [dif_pos ha]
      exact Classical.choose_spec ha
    refine ⟨fun i => LocallyConstant.map (fun a => sel a i) f, ?_, ?_⟩
    · apply LocallyConstant.ext
      intro w
      exact (hsel (f w) (hall w n)).1
    · intro i h1 h2
      apply LocallyConstant.ext
      intro w
      exact (hsel (f w) (hall w n)).2 i h1 h2

  have hC := key (fun j => LocallyConstant W (A j)) _ hMLC

  intro β
  obtain ⟨z', hz'⟩ := hC (fun k => if hk : 1 ≤ k then (Ξ k hk).symm (β k) else 0)
  refine ⟨fun k => if hk : 1 ≤ k then Ξ k hk (z' k) else 0, fun k hk => ?_⟩
  have hk1 : 1 ≤ k + 1 := by omega
  have e' : (Ξ k hk).symm (β k) = z' k - LocallyConstant.map (τA k) (z' (k + 1)) := by
    have e := hz' k hk
    simp only [dif_pos hk] at e
    exact e
  simp only [dif_pos hk, dif_pos hk1]
  rw [hΞ k hk, ← map_sub, ← e', AddEquiv.apply_symm_apply]

theorem wc_xi_tau_compat {Y T W₀ : Scheme.{u}} (ℓ : ℕ) [Fact (Nat.Prime ℓ)] [CompactSpace W₀]
    (g : T ⟶ W₀) (p : T ⟶ Y) (D : wcHMPullData p ℓ) (Dk : ∀ k : ℕ, wcZModPullData p (ℓ ^ k))
    (q : ℕ) (P : wcLadicPackage ℓ p D Dk q) (k j : ℕ)
    (Ξ0 : LocallyConstant W₀ (wcZModProEtExt Y (ℓ ^ k) j) ≃+ wcZModProEtExt T (ℓ ^ k) j)
    (Ξ1 : LocallyConstant W₀ (wcZModProEtExt Y (ℓ ^ (k + 1)) j) ≃+
      wcZModProEtExt T (ℓ ^ (k + 1)) j)
    (h0 : letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T (ℓ ^ k))) := HasExt.standard _
      ∀ (V : Set W₀) [∀ x, Decidable (x ∈ V)] (hV : IsClopen V) (a : wcZModProEtExt Y (ℓ ^ k) j),
        Ξ0 ((LocallyConstant.ofIsClopen hV).map (fun i : Fin 2 => if i = 0 then a else 0)) =
          (Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k)
            ((((LocallyConstant.ofIsClopen hV).map (fun i : Fin 2 =>
                if i = 0 then (1 : ULift.{u+1} (ZMod (ℓ ^ k))) else 0)).toContinuousMap).comp
              g.base.hom))).comp
            (wcZModPull (Dk k) j a) (zero_add j))
    (h1 : letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T (ℓ ^ (k + 1)))) :=
        HasExt.standard _
      ∀ (V : Set W₀) [∀ x, Decidable (x ∈ V)] (hV : IsClopen V)
        (a : wcZModProEtExt Y (ℓ ^ (k + 1)) j),
        Ξ1 ((LocallyConstant.ofIsClopen hV).map (fun i : Fin 2 => if i = 0 then a else 0)) =
          (Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ (k + 1))
            ((((LocallyConstant.ofIsClopen hV).map (fun i : Fin 2 =>
                if i = 0 then (1 : ULift.{u+1} (ZMod (ℓ ^ (k + 1)))) else 0)).toContinuousMap).comp
              g.base.hom))).comp
            (wcZModPull (Dk (k + 1)) j a) (zero_add j))
    (ψ : LocallyConstant W₀ (wcZModProEtExt Y (ℓ ^ (k + 1)) j)) :
    P.τT k j (Ξ1 ψ) = Ξ0 (LocallyConstant.map (P.τY k j) ψ) :=
by
  classical
  let L : LocallyConstant W₀ (wcZModProEtExt Y (ℓ ^ (k + 1)) j) →+ wcZModProEtExt T (ℓ ^ k) j :=
    (P.τT k j).comp Ξ1.toAddMonoidHom
  let R : LocallyConstant W₀ (wcZModProEtExt Y (ℓ ^ (k + 1)) j) →+ wcZModProEtExt T (ℓ ^ k) j :=
    Ξ0.toAddMonoidHom.comp (LocallyConstant.mapAddMonoidHom (P.τY k j))

  have hgen : ∀ (V : Set W₀) [∀ x, Decidable (x ∈ V)] (hV : IsClopen V)
      (b : wcZModProEtExt Y (ℓ ^ (k + 1)) j),
      L ((LocallyConstant.ofIsClopen hV).map (fun i : Fin 2 => if i = 0 then b else 0)) =
        R ((LocallyConstant.ofIsClopen hV).map (fun i : Fin 2 => if i = 0 then b else 0)) := by
    intro V _ hV b
    have hmap : LocallyConstant.map (P.τY k j)
        ((LocallyConstant.ofIsClopen hV).map (fun i : Fin 2 => if i = 0 then b else 0)) =
        (LocallyConstant.ofIsClopen hV).map (fun i : Fin 2 => if i = 0 then P.τY k j b else 0) := by
      ext w
      simp only [LocallyConstant.map_apply, Function.comp_apply]
      split_ifs <;> simp
    show P.τT k j (Ξ1 _) = Ξ0 (LocallyConstant.mapAddMonoidHom (P.τY k j) _)
    rw [LocallyConstant.mapAddMonoidHom_apply, hmap, h1 V hV b, h0 V hV (P.τY k j b),
      ← P.τ_pull k j b]
    exact P.τ_fun k j _ _ (fun t => by
      simp only [ContinuousMap.comp_apply, LocallyConstant.coe_continuousMap,
        LocallyConstant.map_apply, Function.comp_apply]
      split_ifs <;> simp only [map_one, map_zero, ULift.one_down, ULift.zero_down]) _

  have hLR : L = R := by
    apply AddMonoidHom.ext
    intro φ
    have hfib : ∀ b : wcZModProEtExt Y (ℓ ^ (k + 1)) j, IsClopen {x | φ x = b} := fun b =>
      IsLocallyConstant.isClopen_fiber φ.isLocallyConstant b
    have hpt : ∀ (V : Set W₀) [∀ x, Decidable (x ∈ V)] (hV : IsClopen V)
        (a : wcZModProEtExt Y (ℓ ^ (k + 1)) j) (w : W₀),
        ((LocallyConstant.ofIsClopen hV).map (fun i : Fin 2 => if i = 0 then a else 0)) w =
          if w ∈ V then a else 0 := by
      intro V _ hV a w
      rw [LocallyConstant.map_apply]
      by_cases hw : w ∈ V
      · simp [LocallyConstant.ofIsClopen, hw]
      · simp [LocallyConstant.ofIsClopen, hw]
    have hD : φ = ∑ b ∈ (LocallyConstant.range_finite φ).toFinset,
        (LocallyConstant.ofIsClopen (hfib b)).map (fun i : Fin 2 => if i = 0 then b else 0) := by
      ext w
      show φ w = LocallyConstant.evalAddMonoidHom w
        (∑ b ∈ (LocallyConstant.range_finite φ).toFinset,
          (LocallyConstant.ofIsClopen (hfib b)).map (fun i : Fin 2 => if i = 0 then b else 0))
      rw [map_sum]
      simp only [LocallyConstant.evalAddMonoidHom_apply, hpt]
      have hmem : φ w ∈ (LocallyConstant.range_finite φ).toFinset :=
        (Set.Finite.mem_toFinset _).mpr (Set.mem_range_self w)
      rw [Finset.sum_eq_single_of_mem (φ w) hmem]
      · rw [if_pos (show w ∈ {x | φ x = φ w} from rfl)]
      · intro b _ hb
        rw [if_neg (fun hw : w ∈ {x | φ x = b} => hb hw.symm)]
    rw [hD, map_sum, map_sum]
    exact Finset.sum_congr rfl (fun b _ => hgen _ (hfib b) b)
  exact DFunLike.congr_fun hLR ψ

theorem wc_ladic_coord_bounds {Y T : Scheme.{u}} (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (p : T ⟶ Y)
    (D : wcHMPullData p ℓ) (Dk : ∀ k : ℕ, wcZModPullData p (ℓ ^ k)) (q m : ℕ)
    (e : Fin m → wcHM Y ℓ q)
    (he : Function.Bijective (fun c : Fin m → ℚ_[ℓ] => ∑ a, wcHMScalar Y ℓ q (c a) (e a)))
    (P : wcLadicPackage ℓ p D Dk q) (hfin1 : Finite (wcZModProEtExt Y (ℓ ^ 1) q))
    (hsep : letI := P.instMY; ∀ y : P.MY, (∀ k, 1 ≤ k → P.redY k y = 0) → y = 0) :
    letI := P.instMY
    ∃ N' s : ℕ, (∀ (y : P.MY) (c : Fin m → ℚ_[ℓ]),
        P.ρY y = ∑ a, wcHMScalar Y ℓ q (c a) (e a) → ∀ a, ‖(ℓ : ℚ_[ℓ]) ^ N' * c a‖ ≤ 1) ∧
      (∀ y : P.MY, P.ρY y = 0 → (ℓ ^ s : ℕ) • y = 0) :=
by
  classical
  letI := P.instMY
  letI := P.instModY
  have hℓ1 : (1 : ℝ) < (ℓ : ℝ) := by exact_mod_cast (Fact.out : Nat.Prime ℓ).one_lt

  have hConstMul : ∀ (S : Scheme.{u}) (a b : ℚ_[ℓ]),
      wcHMConst S ℓ a ≫ wcHMConst S ℓ b = wcHMConst S ℓ (a * b) := by
    intro S a b
    apply (SheafOfModules.unitHomEquiv _).injective
    rw [SheafOfModules.unitHomEquiv_comp_apply]
    apply Subtype.ext
    funext V
    have hvalP : ∀ (c : ℚ_[ℓ]), ((SheafOfModules.unitHomEquiv _) (wcHMConst S ℓ c)).1 V =
        (ContinuousMap.const _ (ULift.up c) : C(↥((Opposite.unop V).left), ULift.{u+1} ℚ_[ℓ])) := by
      intro c
      simp only [wcHMConst, Equiv.apply_symm_apply]
      rfl
    show ((wcHMConst S ℓ b).val.app V).hom (((SheafOfModules.unitHomEquiv _) (wcHMConst S ℓ a)).1 V) =
      ((SheafOfModules.unitHomEquiv _) (wcHMConst S ℓ (a * b))).1 V
    rw [hvalP, hvalP]
    apply ContinuousMap.ext
    intro x
    rfl
  have hConstAdd : ∀ (S : Scheme.{u}) (a b : ℚ_[ℓ]),
      wcHMConst S ℓ (a + b) = wcHMConst S ℓ a + wcHMConst S ℓ b := by
    intro S a b
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext V
    have hvalP : ∀ (c : ℚ_[ℓ]), ((SheafOfModules.unitHomEquiv _) (wcHMConst S ℓ c)).1 V =
        (ContinuousMap.const _ (ULift.up c) : C(↥((Opposite.unop V).left), ULift.{u+1} ℚ_[ℓ])) := by
      intro c
      simp only [wcHMConst, Equiv.apply_symm_apply]
      rfl
    rw [hvalP, SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.add_val,
      PresheafOfModules.add_app]
    show _ = ((SheafOfModules.unitHomEquiv _) (wcHMConst S ℓ a)).1 V +
      ((SheafOfModules.unitHomEquiv _) (wcHMConst S ℓ b)).1 V
    rw [hvalP, hvalP]
    apply ContinuousMap.ext
    intro x
    rfl
  have hmul : ∀ (a b : ℚ_[ℓ]) (x : wcHM Y ℓ q),
      wcHMScalar Y ℓ q a (wcHMScalar Y ℓ q b x) = wcHMScalar Y ℓ q (b * a) x := by
    intro a b x
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
    show (x.comp (Abelian.Ext.mk₀ (wcHMConst Y ℓ b)) (add_zero q)).comp
        (Abelian.Ext.mk₀ (wcHMConst Y ℓ a)) (add_zero q) =
      x.comp (Abelian.Ext.mk₀ (wcHMConst Y ℓ (b * a))) (add_zero q)
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, hConstMul]
  have hadd : ∀ (a b : ℚ_[ℓ]) (x : wcHM Y ℓ q),
      wcHMScalar Y ℓ q (a + b) x = wcHMScalar Y ℓ q a x + wcHMScalar Y ℓ q b x := by
    intro a b x
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
    show x.comp (Abelian.Ext.mk₀ (wcHMConst Y ℓ (a + b))) (add_zero q) =
      x.comp (Abelian.Ext.mk₀ (wcHMConst Y ℓ a)) (add_zero q) +
        x.comp (Abelian.Ext.mk₀ (wcHMConst Y ℓ b)) (add_zero q)
    rw [hConstAdd, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add]

  obtain ⟨κ, hκ⟩ : ∃ κ : P.MY → (Fin m → ℚ_[ℓ]),
      ∀ y, ∑ a, wcHMScalar Y ℓ q (κ y a) (e a) = P.ρY y :=
    ⟨fun y => Function.surjInv he.2 (P.ρY y), fun y => Function.surjInv_eq he.2 (P.ρY y)⟩
  have hκu : ∀ (y : P.MY) (c : Fin m → ℚ_[ℓ]),
      P.ρY y = ∑ a, wcHMScalar Y ℓ q (c a) (e a) → c = κ y :=
    fun y c h => he.1 (h.symm.trans (hκ y).symm)
  have κ_add : ∀ y y' : P.MY, κ (y + y') = κ y + κ y' := by
    intro y y'
    refine (hκu (y + y') (κ y + κ y') ?_).symm
    rw [map_add, ← hκ y, ← hκ y', ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun a _ => ?_)
    rw [Pi.add_apply, hadd]
  have κ_smul : ∀ (d : ℤ_[ℓ]) (y : P.MY) (a : Fin m), κ (d • y) a = (d : ℚ_[ℓ]) * κ y a := by
    intro d y a
    have h := (hκu (d • y) (fun a => (d : ℚ_[ℓ]) * κ y a) (by
      rw [P.ρY_smul, ← hκ y, map_sum]
      refine Finset.sum_congr rfl (fun b _ => ?_)
      rw [hmul, mul_comm])).symm
    rw [h]

  have hT : ∃ T : Finset P.MY, ∀ y : P.MY, ∃ t ∈ T, ∃ y' : P.MY, y = t + (ℓ : ℤ_[ℓ]) • y' := by
    haveI := Fintype.ofFinite (wcZModProEtExt Y (ℓ ^ 1) q)
    obtain ⟨sec, hsec⟩ : ∃ sec : wcZModProEtExt Y (ℓ ^ 1) q → P.MY,
        ∀ y, P.redY 1 (sec (P.redY 1 y)) = P.redY 1 y :=
      ⟨fun a => if h : ∃ y, P.redY 1 y = a then Classical.choose h else 0, fun y => by
        have h : ∃ y', P.redY 1 y' = P.redY 1 y := ⟨y, rfl⟩
        dsimp only
        rw [dif_pos h]
        exact Classical.choose_spec h⟩
    refine ⟨Finset.univ.image sec, fun y =>
      ⟨sec (P.redY 1 y), Finset.mem_image_of_mem _ (Finset.mem_univ _), ?_⟩⟩
    obtain ⟨y', hy'⟩ := P.kerY 1 (y - sec (P.redY 1 y)) (by rw [map_sub, hsec, sub_self])
    refine ⟨y', ?_⟩
    have e1 : (ℓ ^ 1 : ℕ) • y' = (ℓ : ℤ_[ℓ]) • y' := by
      rw [← Nat.cast_smul_eq_nsmul ℤ_[ℓ], Nat.cast_pow, pow_one]
    rw [e1] at hy'
    rw [← hy']
    abel
  have hD : ∀ w : ℕ → P.MY, (∀ n, w n = (ℓ : ℤ_[ℓ]) • w (n + 1)) → w 0 = 0 := by
    intro w hw
    have hpow : ∀ k : ℕ, w 0 = ((ℓ : ℤ_[ℓ]) ^ k) • w k := by
      intro k
      induction k with
      | zero => rw [pow_zero, one_smul]
      | succ k ih => rw [ih, hw k, smul_smul, pow_succ]
    apply hsep
    intro k _
    rw [hpow k, P.redY_smul]
    have h0 : PadicInt.toZModPow k ((ℓ : ℤ_[ℓ]) ^ k) = 0 := by
      rw [map_pow, map_natCast, ← Nat.cast_pow, ZMod.natCast_self]
    rw [h0, ZMod.val_zero, zero_smul]
  have hfg : Module.Finite ℤ_[ℓ] P.MY := by
    obtain ⟨T, hT⟩ := hT
    have hsum : ∀ c : ℕ → ℤ_[ℓ], Summable (fun j => (ℓ : ℤ_[ℓ]) ^ j * c j) := by
      intro c
      refine Summable.of_norm_bounded (g := fun j : ℕ => ((ℓ : ℝ)⁻¹) ^ j)
        (summable_geometric_of_lt_one (by positivity) (inv_lt_one_of_one_lt₀ hℓ1)) ?_
      intro j
      calc ‖(ℓ : ℤ_[ℓ]) ^ j * c j‖ ≤ ‖(ℓ : ℤ_[ℓ]) ^ j‖ * ‖c j‖ := norm_mul_le _ _
        _ ≤ ‖(ℓ : ℤ_[ℓ]) ^ j‖ * 1 :=
            mul_le_mul_of_nonneg_left (PadicInt.norm_le_one _) (norm_nonneg _)
        _ = ((ℓ : ℝ)⁻¹) ^ j := by rw [mul_one, norm_pow, PadicInt.norm_p]
    obtain ⟨A, hA⟩ : ∃ A : (ℕ → ℤ_[ℓ]) → ℤ_[ℓ], ∀ c : ℕ → ℤ_[ℓ],
        A c = c 0 + (ℓ : ℤ_[ℓ]) * A (fun j => c (j + 1)) := by
      refine ⟨fun c => ∑' j, (ℓ : ℤ_[ℓ]) ^ j * c j, fun c => ?_⟩
      show ∑' j, (ℓ : ℤ_[ℓ]) ^ j * c j = c 0 + (ℓ : ℤ_[ℓ]) * ∑' j, (ℓ : ℤ_[ℓ]) ^ j * c (j + 1)
      rw [(hsum c).tsum_eq_zero_add, pow_zero, one_mul,
        ← (hsum (fun j => c (j + 1))).tsum_mul_left]
      congr 1
      apply tsum_congr
      intro j
      ring
    choose dig hdigT nxt hnxt using hT
    rw [Module.finite_def]
    refine ⟨T, ?_⟩
    rw [eq_top_iff]
    intro y0 _
    obtain ⟨μ, hμ0, hμ⟩ : ∃ μ : ℕ → P.MY, μ 0 = y0 ∧ ∀ n, μ (n + 1) = nxt (μ n) :=
      ⟨fun n => nxt^[n] y0, rfl, fun n => Function.iterate_succ_apply' nxt n y0⟩
    obtain ⟨κ', hκ'⟩ : ∃ κ' : ℕ → P.MY → ℤ_[ℓ], ∀ n s,
        κ' n s = (if dig (μ n) = s then (1 : ℤ_[ℓ]) else 0) + (ℓ : ℤ_[ℓ]) * κ' (n + 1) s := by
      refine ⟨fun n s => A (fun j => if dig (μ (n + j)) = s then (1 : ℤ_[ℓ]) else 0),
        fun n s => ?_⟩
      have h1 := hA (fun j => if dig (μ (n + j)) = s then (1 : ℤ_[ℓ]) else 0)
      have e : (fun j => if dig (μ (n + (j + 1))) = s then (1 : ℤ_[ℓ]) else 0) =
          (fun j => if dig (μ (n + 1 + j)) = s then (1 : ℤ_[ℓ]) else 0) := by
        funext j
        rw [show n + (j + 1) = n + 1 + j by omega]
      beta_reduce at h1
      rw [add_zero, e] at h1
      exact h1
    have hsplit : ∀ n, ∑ s ∈ T, κ' n s • s =
        dig (μ n) + (ℓ : ℤ_[ℓ]) • ∑ s ∈ T, κ' (n + 1) s • s := by
      intro n
      have h3 : ∑ s ∈ T, (if dig (μ n) = s then (1 : ℤ_[ℓ]) else 0) • s = dig (μ n) := by
        simp only [ite_smul, one_smul, zero_smul]
        rw [Finset.sum_ite_eq, if_pos (hdigT (μ n))]
      rw [Finset.sum_congr rfl (fun s _ => by rw [hκ' n s]), Finset.smul_sum]
      simp only [add_smul, mul_smul, Finset.sum_add_distrib, h3]
    have hw : ∀ n, μ n - ∑ s ∈ T, κ' n s • s =
        (ℓ : ℤ_[ℓ]) • (μ (n + 1) - ∑ s ∈ T, κ' (n + 1) s • s) := by
      intro n
      have h2 : μ n = dig (μ n) + (ℓ : ℤ_[ℓ]) • μ (n + 1) := by rw [hμ n]; exact hnxt (μ n)
      rw [hsplit n, smul_sub]
      generalize dig (μ n) = d at h2 ⊢
      rw [h2]
      abel
    have h0 : μ 0 - ∑ s ∈ T, κ' 0 s • s = 0 := hD (fun n => μ n - ∑ s ∈ T, κ' n s • s) hw
    rw [hμ0, sub_eq_zero] at h0
    rw [h0]
    exact Submodule.sum_smul_mem _ _ (fun s hs => Submodule.subset_span hs)
  haveI := hfg

  have hbound1 : ∀ x : ℚ_[ℓ], ∃ n : ℕ, ‖(ℓ : ℚ_[ℓ]) ^ n * x‖ ≤ 1 := by
    intro x
    obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt ‖x‖ hℓ1
    refine ⟨n, ?_⟩
    have hpos : (0 : ℝ) < (ℓ : ℝ) ^ n := by positivity
    rw [norm_mul, norm_pow, Padic.norm_p, inv_pow, inv_mul_le_iff₀ hpos, mul_one]
    exact hn.le
  have hmono : ∀ (x : ℚ_[ℓ]) (n n' : ℕ), n ≤ n' → ‖(ℓ : ℚ_[ℓ]) ^ n * x‖ ≤ 1 →
      ‖(ℓ : ℚ_[ℓ]) ^ n' * x‖ ≤ 1 := by
    intro x n n' hnn hx
    have e : (ℓ : ℚ_[ℓ]) ^ n' * x = (ℓ : ℚ_[ℓ]) ^ (n' - n) * ((ℓ : ℚ_[ℓ]) ^ n * x) := by
      rw [← mul_assoc, ← pow_add, Nat.sub_add_cancel hnn]
    have h1 : ‖(ℓ : ℚ_[ℓ]) ^ (n' - n)‖ ≤ 1 := by
      rw [norm_pow, Padic.norm_p]
      exact pow_le_one₀ (by positivity) (inv_le_one_of_one_le₀ hℓ1.le)
    rw [e, norm_mul]
    exact mul_le_one₀ h1 (norm_nonneg _) hx
  obtain ⟨n, μ, hμ⟩ := Module.Finite.exists_fin (R := ℤ_[ℓ]) (M := P.MY)
  choose nb hnb using fun ia : Fin n × Fin m => hbound1 (κ (μ ia.1) ia.2)
  let κh : P.MY →+ (Fin m → ℚ_[ℓ]) := AddMonoidHom.mk' κ κ_add
  have hA : ∀ (y : P.MY) (a : Fin m),
      ‖(ℓ : ℚ_[ℓ]) ^ (Finset.univ.sup nb) * κ y a‖ ≤ 1 := by
    intro y a
    have hy : y ∈ Submodule.span ℤ_[ℓ] (Set.range μ) := by rw [hμ]; trivial
    obtain ⟨d, hd⟩ := (Submodule.mem_span_range_iff_exists_fun ℤ_[ℓ]).mp hy
    have e1 : κ y a = ∑ i, (d i : ℚ_[ℓ]) * κ (μ i) a := by
      rw [← hd]
      show κh (∑ i, d i • μ i) a = _
      rw [map_sum, Finset.sum_apply]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      show κ (d i • μ i) a = _
      rw [κ_smul]
    have e2 : (ℓ : ℚ_[ℓ]) ^ (Finset.univ.sup nb) * κ y a =
        ∑ i, (d i : ℚ_[ℓ]) * ((ℓ : ℚ_[ℓ]) ^ (Finset.univ.sup nb) * κ (μ i) a) := by
      rw [e1, Finset.mul_sum]
      exact Finset.sum_congr rfl (fun i _ => by ring)
    rw [e2]
    refine IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg zero_le_one (fun i _ => ?_)
    rw [norm_mul]
    refine mul_le_one₀ ?_ (norm_nonneg _)
      (hmono _ _ _ (Finset.le_sup (Finset.mem_univ (i, a))) (hnb (i, a)))
    rw [← PadicInt.norm_def]
    exact PadicInt.norm_le_one _

  let K : Submodule ℤ_[ℓ] P.MY :=
    { carrier := {y | P.ρY y = 0}
      add_mem' := by
        intro a b ha hb
        show P.ρY (a + b) = 0
        rw [map_add, show P.ρY a = 0 from ha, show P.ρY b = 0 from hb, add_zero]
      zero_mem' := map_zero P.ρY
      smul_mem' := by
        intro c y hy
        show P.ρY (c • y) = 0
        rw [P.ρY_smul, show P.ρY y = 0 from hy, map_zero] }
  haveI : IsNoetherian ℤ_[ℓ] P.MY := isNoetherian_of_isNoetherianRing_of_finite ℤ_[ℓ] P.MY
  obtain ⟨S, hSfin, hSspan⟩ := Submodule.fg_def.mp (IsNoetherian.noetherian K)
  obtain ⟨sx, hsx⟩ : ∃ sx : P.MY → ℕ, ∀ x, P.ρY x = 0 → (ℓ ^ sx x : ℕ) • x = 0 :=
    ⟨fun x => if h : P.ρY x = 0 then Classical.choose (P.torsY x h) else 0, fun x hx => by
      dsimp only
      rw [dif_pos hx]
      exact Classical.choose_spec (P.torsY x hx)⟩
  obtain ⟨s, hs⟩ : ∃ s : ℕ, ∀ x ∈ S, sx x ≤ s :=
    ⟨hSfin.toFinset.sup sx, fun x hx => Finset.le_sup (hSfin.mem_toFinset.mpr hx)⟩
  have hgen : ∀ x ∈ S, (ℓ ^ s : ℕ) • x = 0 := by
    intro x hx
    have hxK : x ∈ K := hSspan ▸ Submodule.subset_span hx
    have hspec := hsx x hxK
    rw [← Nat.sub_add_cancel (hs x hx), pow_add, mul_smul, hspec, smul_zero]
  refine ⟨Finset.univ.sup nb, s, fun y c hc a => ?_, fun y hy => ?_⟩
  · rw [hκu y c hc]
    exact hA y a
  · have hyK : y ∈ Submodule.span ℤ_[ℓ] S := by rw [hSspan]; exact hy
    refine Submodule.span_induction (p := fun y _ => (ℓ ^ s : ℕ) • y = 0) ?_ ?_ ?_ ?_ hyK
    · intro x hx
      exact hgen x hx
    · exact smul_zero _
    · intro x z _ _ hx hz
      rw [smul_add, hx, hz, add_zero]
    · intro c x _ hx
      rw [smul_comm, hx, smul_zero]

theorem wc_ladic_surj_coeffs {Y T W₀ : Scheme.{u}} (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (p : T ⟶ Y)
    (D : wcHMPullData p ℓ) (Dk : ∀ k : ℕ, wcZModPullData p (ℓ ^ k)) (q m : ℕ)
    (e : Fin m → wcHM Y ℓ q)
    (he : Function.Bijective (fun c : Fin m → ℚ_[ℓ] => ∑ a, wcHMScalar Y ℓ q (c a) (e a)))
    (P : wcLadicPackage ℓ p D Dk q) (N' : ℕ)
    (hN' : ∀ (y : P.MY) (c : Fin m → ℚ_[ℓ]), P.ρY y = ∑ a, wcHMScalar Y ℓ q (c a) (e a) →
      ∀ a, ‖(ℓ : ℚ_[ℓ]) ^ N' * c a‖ ≤ 1)
    (φ : ∀ k : ℕ, 1 ≤ k → LocallyConstant W₀ (wcZModProEtExt Y (ℓ ^ k) q))
    (hφ : ∀ (k : ℕ) (hk : 1 ≤ k) (w : ↥W₀), P.τY k q (φ (k + 1) (by omega) w) = φ k hk w) :
    ∃ (μ : ↥W₀ → P.MY) (c : Fin m → C(↥W₀, ULift.{u+1} ℚ_[ℓ])),
      (∀ (w : ↥W₀) (k : ℕ) (hk : 1 ≤ k), P.redY k (μ w) = φ k hk w) ∧
      (∀ w, P.ρY (μ w) = ∑ a, wcHMScalar Y ℓ q (c a w).down (e a)) ∧
      (∀ a w, ‖(ℓ : ℚ_[ℓ]) ^ N' * (c a w).down‖ ≤ 1) :=
by
  classical
  letI := P.instMY
  letI := P.instModY

  have hConstAdd : ∀ (a b : ℚ_[ℓ]),
      wcHMConst Y ℓ (a + b) = wcHMConst Y ℓ a + wcHMConst Y ℓ b := by
    intro a b
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext V
    have hvalP : ∀ (c : ℚ_[ℓ]), ((SheafOfModules.unitHomEquiv _) (wcHMConst Y ℓ c)).1 V =
        (ContinuousMap.const _ (ULift.up c) : C(↥((Opposite.unop V).left), ULift.{u+1} ℚ_[ℓ])) := by
      intro c
      simp only [wcHMConst, Equiv.apply_symm_apply]
      rfl
    rw [hvalP, SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.add_val,
      PresheafOfModules.add_app]
    show _ = ((SheafOfModules.unitHomEquiv _) (wcHMConst Y ℓ a)).1 V +
      ((SheafOfModules.unitHomEquiv _) (wcHMConst Y ℓ b)).1 V
    rw [hvalP, hvalP]
    apply ContinuousMap.ext
    intro x
    rfl
  have hadd : ∀ (a b : ℚ_[ℓ]) (x : wcHM Y ℓ q),
      wcHMScalar Y ℓ q (a + b) x = wcHMScalar Y ℓ q a x + wcHMScalar Y ℓ q b x := by
    intro a b x
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
    show x.comp (Abelian.Ext.mk₀ (wcHMConst Y ℓ (a + b))) (add_zero q) =
      x.comp (Abelian.Ext.mk₀ (wcHMConst Y ℓ a)) (add_zero q) +
        x.comp (Abelian.Ext.mk₀ (wcHMConst Y ℓ b)) (add_zero q)
    rw [hConstAdd, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add]
  have hzero : ∀ x : wcHM Y ℓ q, wcHMScalar Y ℓ q 0 x = 0 := by
    intro x
    have h := hadd 0 0 x
    rw [add_zero] at h
    exact add_left_cancel (h.symm.trans (add_zero _).symm)

  let L : (Fin m → ℚ_[ℓ]) →+ wcHM Y ℓ q :=
    { toFun := fun c => ∑ a, wcHMScalar Y ℓ q (c a) (e a)
      map_zero' := by
        apply Finset.sum_eq_zero
        intro a _
        exact hzero (e a)
      map_add' := fun c d => by
        simp only [Pi.add_apply, hadd, Finset.sum_add_distrib] }
  obtain ⟨E, hE⟩ : ∃ E : (Fin m → ℚ_[ℓ]) ≃+ wcHM Y ℓ q,
      ∀ c, E c = ∑ a, wcHMScalar Y ℓ q (c a) (e a) :=
    ⟨AddEquiv.ofBijective L he, fun c => rfl⟩

  have hlift : ∀ w : ↥W₀, ∃ y : P.MY, ∀ (k : ℕ) (hk : 1 ≤ k), P.redY k y = φ k hk w := by
    intro w
    obtain ⟨y, hy⟩ := P.liftY (fun k => if h : 1 ≤ k then φ k h w else 0) (by
      intro k hk
      show P.τY k q (if h : 1 ≤ k + 1 then φ (k + 1) h w else 0) =
        (if h : 1 ≤ k then φ k h w else 0)
      rw [dif_pos hk, dif_pos (show 1 ≤ k + 1 by omega)]
      exact hφ k hk w)
    refine ⟨y, fun k hk => ?_⟩
    rw [hy k hk]
    show (if h : 1 ≤ k then φ k h w else 0) = φ k hk w
    rw [dif_pos hk]
  choose μ hμ using hlift

  obtain ⟨κ, hκdef⟩ : ∃ κ : ↥W₀ → Fin m → ℚ_[ℓ], ∀ w, κ w = E.symm (P.ρY (μ w)) :=
    ⟨_, fun _ => rfl⟩
  have hκ : ∀ w, P.ρY (μ w) = ∑ a, wcHMScalar Y ℓ q (κ w a) (e a) := by
    intro w
    refine ((hE (κ w)).symm.trans ?_).symm
    rw [hκdef, AddEquiv.apply_symm_apply]

  have hdiff : ∀ (j : ℕ) (hj : 1 ≤ j) (w w0 : ↥W₀), φ j hj w = φ j hj w0 →
      ∃ c' : Fin m → ℚ_[ℓ], (∀ a, ‖(ℓ : ℚ_[ℓ]) ^ N' * c' a‖ ≤ 1) ∧
        ∀ a, κ w a - κ w0 a = ((ℓ ^ j : ℕ) : ℚ_[ℓ]) * c' a := by
    intro j hj w w0 hww
    have h0 : P.redY j (μ w - μ w0) = 0 := by
      rw [map_sub, hμ w j hj, hμ w0 j hj, hww, sub_self]
    obtain ⟨y', hy'⟩ := P.kerY j _ h0
    refine ⟨E.symm (P.ρY y'),
      fun a => hN' y' _ ((hE _).symm.trans (E.apply_symm_apply _)).symm a, fun a => ?_⟩
    have h1 : κ w - κ w0 = (ℓ ^ j : ℕ) • E.symm (P.ρY y') := by
      rw [hκdef, hκdef, ← map_sub E.symm, ← map_sub P.ρY, hy', map_nsmul, map_nsmul]
    have h2 := congrFun h1 a
    rw [Pi.sub_apply, Pi.smul_apply, nsmul_eq_mul] at h2
    exact h2

  have hcont : ∀ a, Continuous (fun w => κ w a) := by
    intro a
    rw [continuous_iff_continuousAt]
    intro w0
    rw [ContinuousAt, Metric.tendsto_nhds]
    intro ε hε
    obtain ⟨i, hi⟩ := exists_pow_lt_of_lt_one hε (Padic.norm_p_lt_one (p := ℓ))
    have hj : 1 ≤ N' + i + 1 := by omega
    have hU : IsOpen {w | φ (N' + i + 1) hj w = φ (N' + i + 1) hj w0} :=
      (φ (N' + i + 1) hj).isLocallyConstant.isOpen_fiber _
    filter_upwards [hU.mem_nhds rfl] with w hw
    obtain ⟨c', hc'b, hc'⟩ := hdiff (N' + i + 1) hj w w0 hw
    show dist (κ w a) (κ w0 a) < ε
    rw [dist_eq_norm, hc' a]
    have hn0 : (0 : ℝ) ≤ ‖(ℓ : ℚ_[ℓ])‖ := norm_nonneg _
    calc ‖((ℓ ^ (N' + i + 1) : ℕ) : ℚ_[ℓ]) * c' a‖
        = ‖(ℓ : ℚ_[ℓ])‖ ^ (i + 1) * ‖(ℓ : ℚ_[ℓ]) ^ N' * c' a‖ := by
          rw [← norm_pow, ← norm_mul]
          congr 1
          push_cast
          ring
      _ ≤ ‖(ℓ : ℚ_[ℓ])‖ ^ (i + 1) * 1 :=
          mul_le_mul_of_nonneg_left (hc'b a) (pow_nonneg hn0 _)
      _ = ‖(ℓ : ℚ_[ℓ])‖ ^ i * ‖(ℓ : ℚ_[ℓ])‖ := by rw [mul_one, pow_succ]
      _ ≤ ‖(ℓ : ℚ_[ℓ])‖ ^ i * 1 :=
          mul_le_mul_of_nonneg_left (Padic.norm_p_lt_one (p := ℓ)).le (pow_nonneg hn0 _)
      _ < ε := by rw [mul_one]; exact hi
  refine ⟨μ, fun a => ⟨fun w => ULift.up (κ w a), continuous_uliftUp.comp (hcont a)⟩,
    ?_, ?_, ?_⟩
  · intro w k hk
    exact hμ w k hk
  · intro w
    exact hκ w
  · intro a w
    exact hN' (μ w) (κ w) (hκ w) a

theorem wc_ladic_surj_kill {Y T W₀ : Scheme.{u}} (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (g : T ⟶ W₀) (p : T ⟶ Y) (D : wcHMPullData p ℓ) (Dk : ∀ k : ℕ, wcZModPullData p (ℓ ^ k))
    (q m : ℕ) (P : wcLadicPackage ℓ p D Dk q)
    (Ξ : ∀ k : ℕ, 1 ≤ k →
      (LocallyConstant W₀ (wcZModProEtExt Y (ℓ ^ k) q) ≃+ wcZModProEtExt T (ℓ ^ k) q))
    (hΞ : ∀ (k : ℕ) (hk : 1 ≤ k),
      letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T (ℓ ^ k))) := HasExt.standard _
      ∀ (V : Set W₀) [∀ x, Decidable (x ∈ V)] (hV : IsClopen V) (a : wcZModProEtExt Y (ℓ ^ k) q),
        Ξ k hk ((LocallyConstant.ofIsClopen hV).map (fun i : Fin 2 => if i = 0 then a else 0)) =
          (Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k)
            ((((LocallyConstant.ofIsClopen hV).map (fun i : Fin 2 =>
                if i = 0 then (1 : ULift.{u+1} (ZMod (ℓ ^ k))) else 0)).toContinuousMap).comp
              g.base.hom))).comp
            (wcZModPull (Dk k) q a) (zero_add q))
    (hsepT : letI := P.instMT; ∀ z : P.MT, (∀ k, 1 ≤ k → P.redT k z = 0) → z = 0)
    (x : P.MT) (μ : ↥W₀ → P.MY)
    (hμ : ∀ (w : ↥W₀) (k : ℕ) (hk : 1 ≤ k), P.redY k (μ w) = (Ξ k hk).symm (P.redT k x) w)
    (ε : Fin m → P.MY) (r : Fin m → C(↥W₀, ULift.{u+1} ℤ_[ℓ])) (M s : ℕ)
    (hν : letI := P.instMY; letI := P.instModY
      ∀ w, (ℓ ^ s : ℕ) • ((ℓ ^ M : ℕ) • μ w - ∑ a, (r a w).down • ε a) = 0) :
    letI := P.instMT
    (ℓ ^ s : ℕ) • ((ℓ ^ M : ℕ) • x - ∑ a, P.act ((r a).comp g.base.hom) (P.pI (ε a))) = 0 :=
by
  classical
  letI := P.instMY
  letI := P.instModY
  letI := P.instMT
  show (ℓ ^ s : ℕ) • ((ℓ ^ M : ℕ) • x - ∑ a, P.act ((r a).comp g.base.hom) (P.pI (ε a))) = 0

  have c1 : ∀ k : ℕ, IsLocallyConstant (fun x : ℤ_[ℓ] => PadicInt.toZModPow k x) := by
    intro k
    rw [IsLocallyConstant.iff_isOpen_fiber]
    intro y
    rw [isOpen_iff_forall_mem_open]
    intro x₀ hx₀
    have hℓpos : (0 : ℝ) < (ℓ : ℝ) := by exact_mod_cast (Fact.out : Nat.Prime ℓ).pos
    refine ⟨Metric.closedBall x₀ ((ℓ : ℝ) ^ (-(k : ℤ))), ?_,
      IsUltrametricDist.isOpen_closedBall x₀ (zpow_ne_zero _ hℓpos.ne'),
      Metric.mem_closedBall_self (zpow_pos hℓpos _).le⟩
    intro x hx
    rw [Metric.mem_closedBall, dist_eq_norm] at hx
    have h1 := (PadicInt.norm_le_pow_iff_mem_span_pow (x - x₀) k).mp hx
    rw [← PadicInt.ker_toZModPow, RingHom.mem_ker, map_sub, sub_eq_zero] at h1
    show PadicInt.toZModPow k x ∈ ({y} : Set (ZMod (ℓ ^ k)))
    rw [h1]
    exact hx₀

  have c2 : ∀ (n : ℕ) (f f' : C(↥T, ULift.{u+1} (ZMod n))),
      wcZModFun T n (f + f') = wcZModFun T n f + wcZModFun T n f' := by
    intro n f f'
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext V
    have hvalP : ∀ (f₀ : C(↥T, ULift.{u+1} (ZMod n))),
        ((SheafOfModules.unitHomEquiv _) (wcZModFun T n f₀)).1 V =
          (f₀.comp (Opposite.unop V).hom.base.hom :
            C(↥((Opposite.unop V).left), ULift.{u+1} (ZMod n))) := by
      intro f₀
      simp only [wcZModFun, Equiv.apply_symm_apply]
      rfl
    rw [hvalP, SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.add_val,
      PresheafOfModules.add_app]
    show _ = ((SheafOfModules.unitHomEquiv _) (wcZModFun T n f)).1 V +
      ((SheafOfModules.unitHomEquiv _) (wcZModFun T n f')).1 V
    rw [hvalP, hvalP]
    apply ContinuousMap.ext
    intro x
    rfl
  refine hsepT _ (fun k hk => ?_)
  haveI : NeZero (ℓ ^ k) := ⟨pow_ne_zero k (Fact.out : Nat.Prime ℓ).ne_zero⟩
  letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T (ℓ ^ k))) := HasExt.standard _
  have hcomp_nsmul : ∀ (α : Abelian.Ext (SheafOfModules.unit (wcZModRingSheaf T (ℓ ^ k)))
      (SheafOfModules.unit (wcZModRingSheaf T (ℓ ^ k))) 0) (β : wcZModProEtExt T (ℓ ^ k) q) (j : ℕ),
      α.comp (j • β) (zero_add q) = j • α.comp β (zero_add q) := fun α β j =>
    map_nsmul (AddMonoidHom.mk' (fun β' : wcZModProEtExt T (ℓ ^ k) q => α.comp β' (zero_add q))
      (fun b b' => Abelian.Ext.comp_add α b b' (zero_add q))) j β
  have hnsmul_comp : ∀ (α : Abelian.Ext (SheafOfModules.unit (wcZModRingSheaf T (ℓ ^ k)))
      (SheafOfModules.unit (wcZModRingSheaf T (ℓ ^ k))) 0) (β : wcZModProEtExt T (ℓ ^ k) q) (j : ℕ),
      (j • α).comp β (zero_add q) = j • α.comp β (zero_add q) := fun α β j =>
    map_nsmul (AddMonoidHom.mk' (fun α' : Abelian.Ext (SheafOfModules.unit (wcZModRingSheaf T (ℓ ^ k)))
      (SheafOfModules.unit (wcZModRingSheaf T (ℓ ^ k))) 0 => α'.comp β (zero_add q))
      (fun a a' => Abelian.Ext.add_comp a a' β (zero_add q))) j α

  have c3 : ∀ (ρ : C(↥W₀, ULift.{u+1} (ZMod (ℓ ^ k)))) (b : wcZModProEtExt Y (ℓ ^ k) q)
      (ψ : LocallyConstant W₀ (wcZModProEtExt Y (ℓ ^ k) q)), (∀ w, ψ w = (ρ w).down.val • b) →
      Ξ k hk ψ = (Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) (ρ.comp g.base.hom))).comp
        (wcZModPull (Dk k) q b) (zero_add q) := by
    intro ρ b ψ hψ
    have hV : ∀ v : ZMod (ℓ ^ k), IsClopen {w : W₀ | (ρ w).down = v} := fun v =>
      IsLocallyConstant.isClopen_fiber
        ((IsLocallyConstant.iff_continuous (fun w : W₀ => (ρ w).down)).mpr
          (continuous_uliftDown.comp ρ.continuous)) v
    have hptA : ∀ (V : Set W₀) [∀ x, Decidable (x ∈ V)] (hV : IsClopen V)
        (c : wcZModProEtExt Y (ℓ ^ k) q) (w : W₀),
        ((LocallyConstant.ofIsClopen hV).map (fun i : Fin 2 => if i = 0 then c else 0)) w =
          if w ∈ V then c else 0 := by
      intro V _ hV c w
      rw [LocallyConstant.map_apply]
      by_cases hw : w ∈ V
      · simp [LocallyConstant.ofIsClopen, hw]
      · simp [LocallyConstant.ofIsClopen, hw]
    have hpt1 : ∀ (V : Set W₀) [∀ x, Decidable (x ∈ V)] (hV : IsClopen V) (w : W₀),
        (((LocallyConstant.ofIsClopen hV).map (fun i : Fin 2 =>
          if i = 0 then (1 : ULift.{u+1} (ZMod (ℓ ^ k))) else 0)) w).down =
          if w ∈ V then (1 : ZMod (ℓ ^ k)) else 0 := by
      intro V _ hV w
      rw [LocallyConstant.map_apply]
      by_cases hw : w ∈ V
      · simp [LocallyConstant.ofIsClopen, hw]
      · simp [LocallyConstant.ofIsClopen, hw]
    have hA : ψ = ∑ v : ZMod (ℓ ^ k), (LocallyConstant.ofIsClopen (hV v)).map
        (fun i : Fin 2 => if i = 0 then v.val • b else 0) := by
      ext w
      show ψ w = LocallyConstant.evalAddMonoidHom w (∑ v : ZMod (ℓ ^ k),
        (LocallyConstant.ofIsClopen (hV v)).map (fun i : Fin 2 => if i = 0 then v.val • b else 0))
      rw [map_sum]
      simp only [LocallyConstant.evalAddMonoidHom_apply, hptA]
      rw [Fintype.sum_eq_single (ρ w).down]
      · rw [if_pos (show w ∈ {w' : W₀ | (ρ w').down = (ρ w).down} from rfl), hψ]
      · intro v hv
        rw [if_neg (fun hw : w ∈ {w' : W₀ | (ρ w').down = v} => hv hw.symm)]
    have hw_sum : ∀ w : W₀, (ρ w).down = ∑ v : ZMod (ℓ ^ k), v.val •
        (((LocallyConstant.ofIsClopen (hV v)).map (fun i : Fin 2 =>
          if i = 0 then (1 : ULift.{u+1} (ZMod (ℓ ^ k))) else 0)) w).down := by
      intro w
      simp only [hpt1]
      rw [Fintype.sum_eq_single (ρ w).down]
      · rw [if_pos (show w ∈ {w' : W₀ | (ρ w').down = (ρ w).down} from rfl), nsmul_one,
          ZMod.natCast_zmod_val]
      · intro v hv
        rw [if_neg (fun hw : w ∈ {w' : W₀ | (ρ w').down = v} => hv hw.symm), smul_zero]
    have hchi : ρ.comp g.base.hom = ∑ v : ZMod (ℓ ^ k), v.val •
        ((((LocallyConstant.ofIsClopen (hV v)).map (fun i : Fin 2 =>
          if i = 0 then (1 : ULift.{u+1} (ZMod (ℓ ^ k))) else 0)).toContinuousMap).comp
            g.base.hom) := by
      apply ContinuousMap.ext
      intro t
      apply (AddEquiv.ulift : ULift.{u+1} (ZMod (ℓ ^ k)) ≃+ ZMod (ℓ ^ k)).injective
      rw [ContinuousMap.sum_apply, map_sum]
      simp only [ContinuousMap.nsmul_apply, map_nsmul, ContinuousMap.comp_apply,
        LocallyConstant.coe_continuousMap]
      exact hw_sum _
    let F : C(↥T, ULift.{u+1} (ZMod (ℓ ^ k))) →+
        Abelian.Ext (SheafOfModules.unit (wcZModRingSheaf T (ℓ ^ k)))
          (SheafOfModules.unit (wcZModRingSheaf T (ℓ ^ k))) 0 :=
      AddMonoidHom.mk' (fun f => Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) f)) (fun f f' => by
        show Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) (f + f')) =
          Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) f) + Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) f')
        rw [c2, Abelian.Ext.mk₀_add])
    have hmk : Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) (ρ.comp g.base.hom)) =
        ∑ v : ZMod (ℓ ^ k), v.val • Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k)
          ((((LocallyConstant.ofIsClopen (hV v)).map (fun i : Fin 2 =>
            if i = 0 then (1 : ULift.{u+1} (ZMod (ℓ ^ k))) else 0)).toContinuousMap).comp
              g.base.hom)) := by
      rw [hchi, show ∀ f, Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) f) = F f from fun f => rfl,
        map_sum]
      refine Finset.sum_congr rfl (fun v _ => ?_)
      exact map_nsmul F _ _
    rw [hA, map_sum, Finset.sum_congr rfl (fun v _ => hΞ k hk _ (hV v) (v.val • b)), hmk,
      Abelian.Ext.sum_comp]
    refine Finset.sum_congr rfl (fun v _ => ?_)
    rw [map_nsmul, hcomp_nsmul, hnsmul_comp]

  let ρa : Fin m → C(↥W₀, ULift.{u+1} (ZMod (ℓ ^ k))) := fun a =>
    ⟨fun w => ULift.up (PadicInt.toZModPow k (r a w).down),
      continuous_uliftUp.comp ((c1 k).continuous.comp
        (continuous_uliftDown.comp (r a).continuous))⟩
  let ψa : Fin m → LocallyConstant W₀ (wcZModProEtExt Y (ℓ ^ k) q) := fun a =>
    ⟨fun w => (PadicInt.toZModPow k (r a w).down).val • P.redY k (ε a),
      ((c1 k).comp_continuous (continuous_uliftDown.comp (r a).continuous)).comp
        (fun d : ZMod (ℓ ^ k) => d.val • P.redY k (ε a))⟩
  have hact : ∀ a, P.redT k (P.act ((r a).comp g.base.hom) (P.pI (ε a))) = Ξ k hk (ψa a) := by
    intro a
    rw [show _ = _ from P.red_act k ((r a).comp g.base.hom) ((ρa a).comp g.base.hom)
      (fun t => rfl) (P.pI (ε a)), P.red_pI k (ε a)]
    exact (c3 (ρa a) (P.redY k (ε a)) (ψa a) (fun w => rfl)).symm
  have hL : (ℓ ^ s : ℕ) • ((ℓ ^ M : ℕ) • (Ξ k hk).symm (P.redT k x) - ∑ a, ψa a) = 0 := by
    ext w
    have h2 := congrArg (P.redY k) (hν w)
    simp only [map_nsmul, map_sub, map_sum, map_zero, P.redY_smul] at h2
    show LocallyConstant.evalAddMonoidHom w
      ((ℓ ^ s : ℕ) • ((ℓ ^ M : ℕ) • (Ξ k hk).symm (P.redT k x) - ∑ a, ψa a)) = 0
    simp only [map_nsmul, map_sub, map_sum, LocallyConstant.evalAddMonoidHom_apply]
    rw [← hμ w k hk]
    exact h2
  have hred : P.redT k ((ℓ ^ s : ℕ) • ((ℓ ^ M : ℕ) • x -
      ∑ a, P.act ((r a).comp g.base.hom) (P.pI (ε a)))) =
      Ξ k hk ((ℓ ^ s : ℕ) • ((ℓ ^ M : ℕ) • (Ξ k hk).symm (P.redT k x) - ∑ a, ψa a)) := by
    simp only [map_nsmul, map_sub, map_sum, AddEquiv.apply_symm_apply, hact]
  rw [hred, hL, map_zero]

theorem wc_ladic_act_rho {Y T W₀ : Scheme.{u}} (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (g : T ⟶ W₀) (p : T ⟶ Y) (D : wcHMPullData p ℓ) (hD : wcHMPullCanonical D)
    (Dk : ∀ k : ℕ, wcZModPullData p (ℓ ^ k)) (q : ℕ) (P : wcLadicPackage ℓ p D Dk q)
    (ε : P.MY) (e0 : wcHM Y ℓ q) (t t' : ℚ_[ℓ]) (hε : P.ρY ε = wcHMScalar Y ℓ q t e0)
    (c : C(↥W₀, ULift.{u+1} ℚ_[ℓ])) (r : C(↥W₀, ULift.{u+1} ℤ_[ℓ]))
    (hr : ∀ w, ((r w).down : ℚ_[ℓ]) = t' * (c w).down) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf T ℓ)) := HasExt.standard _
    P.ρT (P.act (r.comp g.base.hom) (P.pI ε)) =
      wcHMScalar T ℓ q (t * t') ((Abelian.Ext.mk₀ (wcHMFun T ℓ (c.comp g.base.hom))).comp
        (wcHMPull D q e0) (zero_add q)) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf T ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _

  let r' : C(↥T, ULift.{u+1} ℚ_[ℓ]) :=
    ⟨fun x => ULift.up (t' * (c (g.base.hom x)).down),
      continuous_uliftUp.comp (continuous_const.mul
        (continuous_uliftDown.comp (c.continuous.comp g.base.hom.continuous)))⟩
  have hr' : ∀ x, (r' x).down = (((r.comp g.base.hom) x).down : ℚ_[ℓ]) :=
    fun x => (hr (g.base.hom x)).symm

  have key : ∀ g' : SheafOfModules.unit (wcRingSheaf Y ℓ) ⟶
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC p) _ _ D.cont D.φ).obj
        (SheafOfModules.unit (wcRingSheaf T ℓ)),
      wcHMConst Y ℓ t ≫ g' =
        g' ≫ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC p) _ _ D.cont D.φ).map
          (wcHMConst T ℓ t) := by
    intro g'
    apply (SheafOfModules.unitHomEquiv _).injective
    apply PresheafOfModules.sections_ext
    intro X
    cases X with
    | op V =>
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    obtain ⟨a, b, hab, ha1, ha2⟩ : ∃ (a : ↑((wcRingSheaf Y ℓ).val.obj (Opposite.op V)))
        (b : ↑((wcRingSheaf T ℓ).val.obj (Opposite.op ((wcProEtBC p).obj V)))),
        @Eq ↑((wcRingSheaf T ℓ).val.obj (Opposite.op ((wcProEtBC p).obj V)))
          ((D.φ.hom.app (Opposite.op V)).hom a) b ∧
        (∀ r : ↑((wcRingSheaf Y ℓ).val.obj (Opposite.op V)),
          @Eq ↑((wcRingSheaf Y ℓ).val.obj (Opposite.op V))
            (((wcHMConst Y ℓ t).val.app (Opposite.op V)).hom r) (r * a)) ∧
        (∀ r : ↑((wcRingSheaf T ℓ).val.obj (Opposite.op ((wcProEtBC p).obj V))),
          @Eq ↑((wcRingSheaf T ℓ).val.obj (Opposite.op ((wcProEtBC p).obj V)))
            (((wcHMConst T ℓ t).val.app (Opposite.op ((wcProEtBC p).obj V))).hom r) (r * b)) :=
      ⟨(ContinuousMap.const _ (ULift.up t) : C(↥V.left, ULift.{u+1} ℚ_[ℓ])),
        (ContinuousMap.const _ (ULift.up t) : C(↥(Limits.pullback V.hom p), ULift.{u+1} ℚ_[ℓ])),
        (hD V (ContinuousMap.const _ (ULift.up t))).trans rfl, fun r => rfl, fun r => rfl⟩
    change (g'.val.app (Opposite.op V)).hom (((wcHMConst Y ℓ t).val.app (Opposite.op V)).hom
          (@id ↑((SheafOfModules.unit (wcRingSheaf Y ℓ)).val.obj (Opposite.op V))
            (1 : ↑((wcRingSheaf Y ℓ).val.obj (Opposite.op V))))) =
        ((wcHMConst T ℓ t).val.app (Opposite.op ((wcProEtBC p).obj V))).hom
          ((g'.val.app (Opposite.op V)).hom
            (@id ↑((SheafOfModules.unit (wcRingSheaf Y ℓ)).val.obj (Opposite.op V))
              (1 : ↑((wcRingSheaf Y ℓ).val.obj (Opposite.op V)))))
    have e1 : ((wcHMConst Y ℓ t).val.app (Opposite.op V)).hom
          (@id ↑((SheafOfModules.unit (wcRingSheaf Y ℓ)).val.obj (Opposite.op V))
            (1 : ↑((wcRingSheaf Y ℓ).val.obj (Opposite.op V)))) =
        a • (@id ↑((SheafOfModules.unit (wcRingSheaf Y ℓ)).val.obj (Opposite.op V))
            (1 : ↑((wcRingSheaf Y ℓ).val.obj (Opposite.op V)))) := by
      have h := ha1 1
      change @Eq ↑((wcRingSheaf Y ℓ).val.obj (Opposite.op V))
        (((wcHMConst Y ℓ t).val.app (Opposite.op V)).hom (1 : ↑((wcRingSheaf Y ℓ).val.obj (Opposite.op V))))
        (a * 1)
      rw [h, one_mul, mul_one]
    rw [e1, LinearMap.map_smul]
    generalize (g'.val.app (Opposite.op V)).hom
      (@id ↑((SheafOfModules.unit (wcRingSheaf Y ℓ)).val.obj (Opposite.op V))
        (1 : ↑((wcRingSheaf Y ℓ).val.obj (Opposite.op V)))) = y
    have h2 := ha2 y
    refine Eq.trans ?_ h2.symm
    change @Eq ↑((wcRingSheaf T ℓ).val.obj (Opposite.op ((wcProEtBC p).obj V)))
      (@HMul.hMul ↑((wcRingSheaf T ℓ).val.obj (Opposite.op ((wcProEtBC p).obj V)))
        ↑((wcRingSheaf T ℓ).val.obj (Opposite.op ((wcProEtBC p).obj V)))
        ↑((wcRingSheaf T ℓ).val.obj (Opposite.op ((wcProEtBC p).obj V))) instHMul
        ((D.φ.hom.app (Opposite.op V)).hom a) y)
      (@HMul.hMul ↑((wcRingSheaf T ℓ).val.obj (Opposite.op ((wcProEtBC p).obj V)))
        ↑((wcRingSheaf T ℓ).val.obj (Opposite.op ((wcProEtBC p).obj V)))
        ↑((wcRingSheaf T ℓ).val.obj (Opposite.op ((wcProEtBC p).obj V))) instHMul y b)
    rw [hab]
    exact @mul_comm C(↥(Limits.pullback V.hom p), ULift.{u+1} ℚ_[ℓ]) _ b y
  have hmate : D.Φ.map (wcHMConst Y ℓ t) ≫ D.μ.hom = D.μ.hom ≫ wcHMConst T ℓ t := by
    apply (D.adj.homEquiv _ _).injective
    rw [Adjunction.homEquiv_naturality_left, Adjunction.homEquiv_naturality_right]
    exact key _

  have hpull : wcHMPull D q (wcHMScalar Y ℓ q t e0) = wcHMScalar T ℓ q t (wcHMPull D q e0) := by
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ
        (e0.comp (Abelian.Ext.mk₀ (wcHMConst Y ℓ t)) (add_zero q))).comp
          (Abelian.Ext.mk₀ D.μ.hom) (add_zero q)) (zero_add q) =
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ e0).comp
          (Abelian.Ext.mk₀ D.μ.hom) (add_zero q)) (zero_add q)).comp
        (Abelian.Ext.mk₀ (wcHMConst T ℓ t)) (add_zero q)
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
    generalize Abelian.Ext.mapExactFunctor D.Φ e0 = z
    have e1 : (z.comp (Abelian.Ext.mk₀ (D.Φ.map (wcHMConst Y ℓ t))) (add_zero q)).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero q) =
        (z.comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero q)).comp
          (Abelian.Ext.mk₀ (wcHMConst T ℓ t)) (add_zero q) := by
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, hmate,
        ← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.comp_assoc_of_third_deg_zero]
    rw [e1]
    exact (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).symm

  have hcentral : ∀ (e : SheafOfModules.unit (wcRingSheaf T ℓ) ⟶ SheafOfModules.unit (wcRingSheaf T ℓ))
      (y : wcHM T ℓ q),
      (Abelian.Ext.mk₀ e).comp y (zero_add q) = y.comp (Abelian.Ext.mk₀ e) (add_zero q) := by
    intro e y
    have hcomm : ∀ (X : (T.ProEt)ᵒᵖ) (a b : (wcRingSheaf T ℓ).obj.obj X), a * b = b * a := by
      intro X a b
      exact @mul_comm C(↥(Opposite.unop X).left, ULift.{u+1} ℚ_[ℓ]) _ a b
    have hext : ∃ m : 𝟭 (SheafOfModules.{u+1} (wcRingSheaf T ℓ)) ⟶
        𝟭 (SheafOfModules.{u+1} (wcRingSheaf T ℓ)),
        m.app (SheafOfModules.unit (wcRingSheaf T ℓ)) = e := by
      let R := wcRingSheaf T ℓ
      let s := (SheafOfModules.unit R).unitHomEquiv e
      let σ : ∀ X : (T.ProEt)ᵒᵖ, R.obj.obj X := fun X => (s.1 X : R.obj.obj X)
      have hσ : ∀ {X Y : (T.ProEt)ᵒᵖ} (f : X ⟶ Y), (R.obj.map f).hom (σ X) = σ Y :=
        fun f => PresheafOfModules.sections_property s f
      let L : ∀ (M : SheafOfModules.{u+1} R) (X : (T.ProEt)ᵒᵖ), M.val.obj X ⟶ M.val.obj X :=
        fun M X => ModuleCat.ofHom
          { toFun := fun x => σ X • x
            map_add' := fun x y => smul_add _ _ _
            map_smul' := fun r x => by
              simp only [RingHom.id_apply, smul_smul]
              rw [hcomm X] }
      let mM : ∀ M : SheafOfModules.{u+1} R, M ⟶ M := fun M =>
        ⟨PresheafOfModules.Hom.mk (L M) (by
          intro X Y f
          ext x
          show σ Y • (M.val.map f).hom x = (M.val.map f).hom (σ X • x)
          rw [PresheafOfModules.map_smul, hσ])⟩
      refine ⟨{ app := mM, naturality := ?_ }, ?_⟩
      · intro M N g
        apply SheafOfModules.hom_ext
        apply PresheafOfModules.hom_ext
        intro X
        ext x
        show σ X • (g.val.app X).hom x = (g.val.app X).hom (σ X • x)
        exact ((g.val.app X).hom.map_smul _ _).symm
      · apply (SheafOfModules.unit R).unitHomEquiv.injective
        apply PresheafOfModules.sections_ext
        intro X
        rw [SheafOfModules.unitHomEquiv_apply_coe]
        show σ X • (1 : R.obj.obj X) = s.1 X
        rw [smul_eq_mul, mul_one]
    obtain ⟨m, hm⟩ := hext
    subst hm
    have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp y m
    simp only [Abelian.Ext.id_mapExactFunctor] at h
    exact h.symm

  have hvalP : ∀ (V : (T.ProEt)ᵒᵖ) (a : ℚ_[ℓ]),
      ((SheafOfModules.unitHomEquiv _) (wcHMConst T ℓ a)).1 V =
        (ContinuousMap.const _ (ULift.up a) : C(↥((Opposite.unop V).left), ULift.{u+1} ℚ_[ℓ])) := by
    intro V a
    simp only [wcHMConst, Equiv.apply_symm_apply]
    rfl
  have hvalF : ∀ (V : (T.ProEt)ᵒᵖ) (f : C(↥T, ULift.{u+1} ℚ_[ℓ])),
      ((SheafOfModules.unitHomEquiv _) (wcHMFun T ℓ f)).1 V =
        (f.comp (Opposite.unop V).hom.base.hom : C(↥((Opposite.unop V).left), ULift.{u+1} ℚ_[ℓ])) := by
    intro V f
    simp only [wcHMFun, Equiv.apply_symm_apply]
    rfl

  have hF : wcHMFun T ℓ r' = wcHMConst T ℓ t' ≫ wcHMFun T ℓ (c.comp g.base.hom) := by
    apply (SheafOfModules.unitHomEquiv _).injective
    rw [SheafOfModules.unitHomEquiv_comp_apply]
    apply Subtype.ext
    funext V
    show ((SheafOfModules.unitHomEquiv _) (wcHMFun T ℓ r')).1 V =
      ((wcHMFun T ℓ (c.comp g.base.hom)).val.app V).hom
        (((SheafOfModules.unitHomEquiv _) (wcHMConst T ℓ t')).1 V)
    rw [hvalF, hvalP]
    apply ContinuousMap.ext
    intro x
    rfl

  have hConstMul : ∀ (a b : ℚ_[ℓ]),
      wcHMConst T ℓ a ≫ wcHMConst T ℓ b = wcHMConst T ℓ (a * b) := by
    intro a b
    apply (SheafOfModules.unitHomEquiv _).injective
    rw [SheafOfModules.unitHomEquiv_comp_apply]
    apply Subtype.ext
    funext V
    show ((wcHMConst T ℓ b).val.app V).hom (((SheafOfModules.unitHomEquiv _) (wcHMConst T ℓ a)).1 V) =
      ((SheafOfModules.unitHomEquiv _) (wcHMConst T ℓ (a * b))).1 V
    rw [hvalP, hvalP]
    apply ContinuousMap.ext
    intro x
    rfl

  rw [P.ρ_act (r.comp g.base.hom) r' hr' (P.pI ε), P.ρ_pI, hε, hpull]
  generalize wcHMPull D q e0 = y
  show (Abelian.Ext.mk₀ (wcHMFun T ℓ r')).comp (y.comp (Abelian.Ext.mk₀ (wcHMConst T ℓ t))
      (add_zero q)) (zero_add q) =
    ((Abelian.Ext.mk₀ (wcHMFun T ℓ (c.comp g.base.hom))).comp y (zero_add q)).comp
      (Abelian.Ext.mk₀ (wcHMConst T ℓ (t * t'))) (add_zero q)
  rw [← Abelian.Ext.comp_assoc_of_third_deg_zero, hF, ← Abelian.Ext.mk₀_comp_mk₀,
    Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (wcHMConst T ℓ t'))
      (Abelian.Ext.mk₀ (wcHMFun T ℓ (c.comp g.base.hom))) y (zero_add 0) (zero_add q) (by omega),
    hcentral (wcHMConst T ℓ t')]
  generalize (Abelian.Ext.mk₀ (wcHMFun T ℓ (c.comp g.base.hom))).comp y (zero_add q) = Z
  rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, hConstMul, mul_comm t' t]

theorem wc_hmFun_scalar_smul (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (n : ℕ)
    (f f' : C(↥S, ULift.{u+1} ℚ_[ℓ])) (t : ℚ_[ℓ]) (hf : ∀ x, (f' x).down = t * (f x).down)
    (y : wcHM S ℓ n) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    (Abelian.Ext.mk₀ (wcHMFun S ℓ f')).comp y (zero_add n) =
      wcHMScalar S ℓ n t ((Abelian.Ext.mk₀ (wcHMFun S ℓ f)).comp y (zero_add n)) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
  have hcentral : ∀ (e : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶ SheafOfModules.unit (wcRingSheaf S ℓ))
      (y : wcHM S ℓ n),
      (Abelian.Ext.mk₀ e).comp y (zero_add n) = y.comp (Abelian.Ext.mk₀ e) (add_zero n) := by
    intro e y
    have hcomm : ∀ (X : (S.ProEt)ᵒᵖ) (a b : (wcRingSheaf S ℓ).obj.obj X), a * b = b * a := by
      intro X a b
      exact @mul_comm C(↥(Opposite.unop X).left, ULift.{u+1} ℚ_[ℓ]) _ a b
    have hext : ∃ m : 𝟭 (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) ⟶
        𝟭 (SheafOfModules.{u+1} (wcRingSheaf S ℓ)),
        m.app (SheafOfModules.unit (wcRingSheaf S ℓ)) = e := by
      let R := wcRingSheaf S ℓ
      let s := (SheafOfModules.unit R).unitHomEquiv e
      let σ : ∀ X : (S.ProEt)ᵒᵖ, R.obj.obj X := fun X => (s.1 X : R.obj.obj X)
      have hσ : ∀ {X Y : (S.ProEt)ᵒᵖ} (f : X ⟶ Y), (R.obj.map f).hom (σ X) = σ Y :=
        fun f => PresheafOfModules.sections_property s f
      let L : ∀ (M : SheafOfModules.{u+1} R) (X : (S.ProEt)ᵒᵖ), M.val.obj X ⟶ M.val.obj X :=
        fun M X => ModuleCat.ofHom
          { toFun := fun x => σ X • x
            map_add' := fun x y => smul_add _ _ _
            map_smul' := fun r x => by
              simp only [RingHom.id_apply, smul_smul]
              rw [hcomm X] }
      let mM : ∀ M : SheafOfModules.{u+1} R, M ⟶ M := fun M =>
        ⟨PresheafOfModules.Hom.mk (L M) (by
          intro X Y f
          ext x
          show σ Y • (M.val.map f).hom x = (M.val.map f).hom (σ X • x)
          rw [PresheafOfModules.map_smul, hσ])⟩
      refine ⟨{ app := mM, naturality := ?_ }, ?_⟩
      · intro M N g
        apply SheafOfModules.hom_ext
        apply PresheafOfModules.hom_ext
        intro X
        ext x
        show σ X • (g.val.app X).hom x = (g.val.app X).hom (σ X • x)
        exact ((g.val.app X).hom.map_smul _ _).symm
      · apply (SheafOfModules.unit R).unitHomEquiv.injective
        apply PresheafOfModules.sections_ext
        intro X
        rw [SheafOfModules.unitHomEquiv_apply_coe]
        show σ X • (1 : R.obj.obj X) = s.1 X
        rw [smul_eq_mul, mul_one]
    obtain ⟨m, hm⟩ := hext
    subst hm
    have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp y m
    simp only [Abelian.Ext.id_mapExactFunctor] at h
    exact h.symm
  have hvalP : ∀ (V : (S.ProEt)ᵒᵖ) (a : ℚ_[ℓ]),
      ((SheafOfModules.unitHomEquiv _) (wcHMConst S ℓ a)).1 V =
        (ContinuousMap.const _ (ULift.up a) : C(↥((Opposite.unop V).left), ULift.{u+1} ℚ_[ℓ])) := by
    intro V a
    simp only [wcHMConst, Equiv.apply_symm_apply]
    rfl
  have hvalF : ∀ (V : (S.ProEt)ᵒᵖ) (g : C(↥S, ULift.{u+1} ℚ_[ℓ])),
      ((SheafOfModules.unitHomEquiv _) (wcHMFun S ℓ g)).1 V =
        (g.comp (Opposite.unop V).hom.base.hom : C(↥((Opposite.unop V).left), ULift.{u+1} ℚ_[ℓ])) := by
    intro V g
    simp only [wcHMFun, Equiv.apply_symm_apply]
    rfl
  have hF : wcHMFun S ℓ f' = wcHMConst S ℓ t ≫ wcHMFun S ℓ f := by
    apply (SheafOfModules.unitHomEquiv _).injective
    rw [SheafOfModules.unitHomEquiv_comp_apply]
    apply Subtype.ext
    funext V
    show ((SheafOfModules.unitHomEquiv _) (wcHMFun S ℓ f')).1 V =
      ((wcHMFun S ℓ f).val.app V).hom
        (((SheafOfModules.unitHomEquiv _) (wcHMConst S ℓ t)).1 V)
    rw [hvalF, hvalP]
    apply ContinuousMap.ext
    intro x
    apply ULift.ext
    exact hf _
  show (Abelian.Ext.mk₀ (wcHMFun S ℓ f')).comp y (zero_add n) =
    ((Abelian.Ext.mk₀ (wcHMFun S ℓ f)).comp y (zero_add n)).comp
      (Abelian.Ext.mk₀ (wcHMConst S ℓ t)) (add_zero n)
  rw [hF, ← Abelian.Ext.mk₀_comp_mk₀,
    Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (wcHMConst S ℓ t))
      (Abelian.Ext.mk₀ (wcHMFun S ℓ f)) y (zero_add 0) (zero_add n) (by omega),
    hcentral (wcHMConst S ℓ t)]

theorem wc_ladic_passage_surjective {Y T W₀ : Scheme.{u}} (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    [CompactSpace T] [QuasiSeparatedSpace T] [CompactSpace Y] [QuasiSeparatedSpace Y]
    [CompactSpace W₀]
    (g : T ⟶ W₀) (p : T ⟶ Y) (D : wcHMPullData p ℓ) (hD : wcHMPullCanonical D)
    (Dk : ∀ k : ℕ, wcZModPullData p (ℓ ^ k)) (hDk : ∀ k : ℕ, wcZModPullCanonical (Dk k))
    (hfin : ∀ k j : ℕ, 1 ≤ k → Finite (wcZModProEtExt Y (ℓ ^ k) j))
    (htor : ∀ k j : ℕ, 1 ≤ k →
      letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T (ℓ ^ k))) := HasExt.standard _
      ∃ Ξ : LocallyConstant W₀ (wcZModProEtExt Y (ℓ ^ k) j) ≃+ wcZModProEtExt T (ℓ ^ k) j,
        ∀ (V : Set W₀) [∀ x, Decidable (x ∈ V)] (hV : IsClopen V) (a : wcZModProEtExt Y (ℓ ^ k) j),
          Ξ ((LocallyConstant.ofIsClopen hV).map (fun i : Fin 2 => if i = 0 then a else 0)) =
            (Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k)
              ((((LocallyConstant.ofIsClopen hV).map (fun i : Fin 2 =>
                  if i = 0 then (1 : ULift.{u+1} (ZMod (ℓ ^ k))) else 0)).toContinuousMap).comp
                g.base.hom))).comp
              (wcZModPull (Dk k) j a) (zero_add j))
    (q m : ℕ) (e : Fin m → wcHM Y ℓ q)
    (he : Function.Bijective (fun c : Fin m → ℚ_[ℓ] => ∑ a, wcHMScalar Y ℓ q (c a) (e a)))
    (P : wcLadicPackage ℓ p D Dk q) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf T ℓ)) := HasExt.standard _
    Function.Surjective (fun c : Fin m → C(↥W₀, ULift.{u+1} ℚ_[ℓ]) =>
      ∑ a, (Abelian.Ext.mk₀ (wcHMFun T ℓ ((c a).comp g.base.hom))).comp
        (wcHMPull D q (e a)) (zero_add q)) :=
by
  classical
  letI := P.instMY
  letI := P.instModY
  letI := P.instMT
  choose Ξ hΞ using htor

  let mkMod : ∀ S : Scheme.{u}, Module ℚ_[ℓ] (wcHM S ℓ q) := fun S =>
    { smul := fun c x => wcHMScalar S ℓ q c x
      one_smul := (wc_hmScalar_laws S ℓ q).2.1
      mul_smul := fun a b x => by
        show wcHMScalar S ℓ q (a * b) x = wcHMScalar S ℓ q a (wcHMScalar S ℓ q b x)
        rw [(wc_hmScalar_laws S ℓ q).1, mul_comm]
      smul_zero := fun c => by
        show wcHMScalar S ℓ q c 0 = 0
        exact map_zero _
      smul_add := fun c x y => by
        show wcHMScalar S ℓ q c (x + y) = wcHMScalar S ℓ q c x + wcHMScalar S ℓ q c y
        exact map_add _ x y
      add_smul := (wc_hmScalar_laws S ℓ q).2.2.1
      zero_smul := fun x => by
        show wcHMScalar S ℓ q 0 x = 0
        have h := (wc_hmScalar_laws S ℓ q).2.2.1 0 0 x
        rw [add_zero] at h
        exact add_left_cancel (h.symm.trans (add_zero _).symm) }
  letI : Module ℚ_[ℓ] (wcHM Y ℓ q) := mkMod Y
  letI : Module ℚ_[ℓ] (wcHM T ℓ q) := mkMod T
  have hsmY : ∀ (c : ℚ_[ℓ]) (x : wcHM Y ℓ q), wcHMScalar Y ℓ q c x = c • x := fun _ _ => rfl
  have hsmT : ∀ (c : ℚ_[ℓ]) (x : wcHM T ℓ q), wcHMScalar T ℓ q c x = c • x := fun _ _ => rfl
  have hℓ0 : (ℓ : ℚ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr (Fact.out : Nat.Prime ℓ).ne_zero

  have hMLY : ∀ j : ℕ, @wcTowerML (fun k => wcZModProEtExt Y (ℓ ^ k) j)
      (fun _ => inferInstance) (fun k => P.τY k j) := fun j =>
    @wc_tower_ml_of_finite (fun k => wcZModProEtExt Y (ℓ ^ k) j) (fun _ => inferInstance)
      (fun k => P.τY k j) (fun k hk => hfin k j hk)
  have hlimY : @wcLim1Zero (fun k => wcZModProEtExt Y (ℓ ^ k) (q - 1))
      (fun _ => inferInstance) (fun k => P.τY k (q - 1)) :=
    @wc_tower_lim1_of_ml (fun k => wcZModProEtExt Y (ℓ ^ k) (q - 1)) (fun _ => inferInstance)
      _ (hMLY (q - 1))
  have sepY := P.sepY hlimY

  have hlimT : @wcLim1Zero (fun k => wcZModProEtExt T (ℓ ^ k) (q - 1))
      (fun _ => inferInstance) (fun k => P.τT k (q - 1)) :=
    @wc_lim1_transport_locallyConstant (fun k => wcZModProEtExt Y (ℓ ^ k) (q - 1))
      (fun k => wcZModProEtExt T (ℓ ^ k) (q - 1)) (fun _ => inferInstance)
      (fun _ => inferInstance) (fun k => P.τY k (q - 1)) (fun k => P.τT k (q - 1)) ↥W₀ _
      (hMLY (q - 1))
      (fun k hk => Ξ k (q - 1) hk)
      (fun k hk ψ => wc_xi_tau_compat ℓ g p D Dk q P k (q - 1) _ _ (hΞ k (q - 1) hk)
        (hΞ (k + 1) (q - 1) (by omega)) ψ)
  have sepT := P.sepT hlimT

  obtain ⟨N', s, hN', hs⟩ := wc_ladic_coord_bounds ℓ p D Dk q m e he P (hfin 1 q le_rfl) sepY

  intro v
  obtain ⟨n, x, hx⟩ := P.denomT v

  let φ : ∀ k : ℕ, 1 ≤ k → LocallyConstant W₀ (wcZModProEtExt Y (ℓ ^ k) q) :=
    fun k hk => (Ξ k q hk).symm (P.redT k x)
  have hφmap : ∀ (k : ℕ) (hk : 1 ≤ k),
      LocallyConstant.map (P.τY k q) (φ (k + 1) (by omega)) = φ k hk := by
    intro k hk
    apply (Ξ k q hk).injective
    rw [← wc_xi_tau_compat ℓ g p D Dk q P k q _ _ (hΞ k q hk) (hΞ (k + 1) q (by omega))]
    simp only [φ, AddEquiv.apply_symm_apply]
    exact P.redT_compat k x hk
  have hφ : ∀ (k : ℕ) (hk : 1 ≤ k) (w : ↥W₀),
      P.τY k q (φ (k + 1) (by omega) w) = φ k hk w := by
    intro k hk w
    rw [← hφmap k hk]
    rfl

  obtain ⟨μ, c, hμ, hρμ, hc⟩ :=
    wc_ladic_surj_coeffs (W₀ := W₀) ℓ p D Dk q m e he P N' hN' φ hφ

  choose Na ε' hε' using fun a => P.denomY (e a)
  obtain ⟨N, hNa⟩ : ∃ N : ℕ, ∀ a, Na a ≤ N :=
    ⟨Finset.univ.sup Na, fun a => Finset.le_sup (Finset.mem_univ a)⟩
  obtain ⟨ε, hεdef⟩ : ∃ ε : Fin m → P.MY, ∀ a, ε a = (ℓ ^ (N - Na a) : ℕ) • ε' a :=
    ⟨fun a => (ℓ ^ (N - Na a) : ℕ) • ε' a, fun _ => rfl⟩
  have hε : ∀ a, P.ρY (ε a) = wcHMScalar Y ℓ q ((ℓ : ℚ_[ℓ]) ^ N) (e a) := by
    intro a
    rw [hεdef, map_nsmul, ← hε' a, hsmY, hsmY, ← Nat.cast_smul_eq_nsmul ℚ_[ℓ], smul_smul]
    congr 1
    rw [Nat.cast_pow, ← pow_add, Nat.sub_add_cancel (hNa a)]

  obtain ⟨r, hr⟩ : ∃ r : Fin m → C(↥W₀, ULift.{u+1} ℤ_[ℓ]),
      ∀ a w, (((r a w).down : ℤ_[ℓ]) : ℚ_[ℓ]) = (ℓ : ℚ_[ℓ]) ^ N' * (c a w).down :=
    ⟨fun a => ⟨fun w => ULift.up ⟨(ℓ : ℚ_[ℓ]) ^ N' * (c a w).down, hc a w⟩, by
      refine continuous_uliftUp.comp ?_
      refine Continuous.subtype_mk ?_ _
      exact continuous_const.mul (continuous_uliftDown.comp (c a).continuous)⟩,
      fun _ _ => rfl⟩

  have hν : ∀ w, (ℓ ^ s : ℕ) • ((ℓ ^ (N + N') : ℕ) • μ w - ∑ a, (r a w).down • ε a) = 0 := by
    intro w
    apply hs
    rw [map_sub, map_nsmul, map_sum, hρμ w]
    simp only [P.ρY_smul, hε, hr, hsmY]
    rw [Finset.smul_sum, ← Finset.sum_sub_distrib]
    apply Finset.sum_eq_zero
    intro a _
    rw [← Nat.cast_smul_eq_nsmul ℚ_[ℓ], smul_smul, smul_smul, sub_eq_zero]
    congr 1
    push_cast
    ring

  have hz := wc_ladic_surj_kill ℓ g p D Dk q m P (fun k hk => Ξ k q hk) (fun k hk => hΞ k q hk)
    sepT x μ (fun w k hk => hμ w k hk) ε r (N + N') s hν

  have hact := fun a => wc_ladic_act_rho ℓ g p D hD Dk q P (ε a) (e a) _ _ (hε a) (c a) (r a)
    (hr a)
  have h2 := congrArg P.ρT hz
  rw [map_nsmul, map_sub, map_nsmul, map_sum, ← hx, map_zero] at h2
  simp only [hact, hsmT] at h2
  simp only [← Nat.cast_smul_eq_nsmul ℚ_[ℓ]] at h2
  rw [← Finset.smul_sum] at h2
  have hK : (((ℓ ^ (N + N') : ℕ) : ℚ_[ℓ])) = (ℓ : ℚ_[ℓ]) ^ N * (ℓ : ℚ_[ℓ]) ^ N' := by
    push_cast
    ring
  rw [hK, ← smul_sub, smul_smul] at h2
  have h3 : ((ℓ ^ s : ℕ) : ℚ_[ℓ]) * ((ℓ : ℚ_[ℓ]) ^ N * (ℓ : ℚ_[ℓ]) ^ N') ≠ 0 := by
    refine mul_ne_zero ?_ (mul_ne_zero (pow_ne_zero _ hℓ0) (pow_ne_zero _ hℓ0))
    rw [Nat.cast_pow]
    exact pow_ne_zero _ hℓ0
  have h4 := congrArg (fun z => (((ℓ ^ s : ℕ) : ℚ_[ℓ]) *
    ((ℓ : ℚ_[ℓ]) ^ N * (ℓ : ℚ_[ℓ]) ^ N'))⁻¹ • z) h2
  simp only [inv_smul_smul₀ h3, smul_zero] at h4
  have key := sub_eq_zero.mp h4

  refine ⟨fun a => ⟨fun w => ULift.up (((ℓ : ℚ_[ℓ]) ^ n)⁻¹ * (c a w).down),
    continuous_uliftUp.comp (continuous_const.mul (continuous_uliftDown.comp (c a).continuous))⟩,
    ?_⟩
  have hsc := fun a => wc_hmFun_scalar_smul T ℓ q ((c a).comp g.base.hom)
    ((⟨fun w => ULift.up (((ℓ : ℚ_[ℓ]) ^ n)⁻¹ * (c a w).down),
      continuous_uliftUp.comp (continuous_const.mul
        (continuous_uliftDown.comp (c a).continuous))⟩ : C(↥W₀, ULift.{u+1} ℚ_[ℓ])).comp
      g.base.hom) (((ℓ : ℚ_[ℓ]) ^ n)⁻¹) (fun t => rfl) (wcHMPull D q (e a))
  beta_reduce
  rw [Finset.sum_congr rfl (fun a _ => hsc a)]
  simp only [hsmT]
  rw [← Finset.smul_sum, ← key, inv_smul_smul₀ (pow_ne_zero _ hℓ0)]

theorem wc_hm_ladic_kunneth_passage {Y T W₀ : Scheme.{u}} (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    [CompactSpace T] [QuasiSeparatedSpace T] [CompactSpace Y] [QuasiSeparatedSpace Y]
    [CompactSpace W₀]
    (g : T ⟶ W₀) (p : T ⟶ Y) (D : wcHMPullData p ℓ) (hD : wcHMPullCanonical D)
    (Dk : ∀ k : ℕ, wcZModPullData p (ℓ ^ k)) (hDk : ∀ k : ℕ, wcZModPullCanonical (Dk k))
    (hfin : ∀ k j : ℕ, 1 ≤ k → Finite (wcZModProEtExt Y (ℓ ^ k) j))
    (htor : ∀ k j : ℕ, 1 ≤ k →
      letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T (ℓ ^ k))) := HasExt.standard _
      ∃ Ξ : LocallyConstant W₀ (wcZModProEtExt Y (ℓ ^ k) j) ≃+ wcZModProEtExt T (ℓ ^ k) j,
        ∀ (V : Set W₀) [∀ x, Decidable (x ∈ V)] (hV : IsClopen V) (a : wcZModProEtExt Y (ℓ ^ k) j),
          Ξ ((LocallyConstant.ofIsClopen hV).map (fun i : Fin 2 => if i = 0 then a else 0)) =
            (Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k)
              ((((LocallyConstant.ofIsClopen hV).map (fun i : Fin 2 =>
                  if i = 0 then (1 : ULift.{u+1} (ZMod (ℓ ^ k))) else 0)).toContinuousMap).comp
                g.base.hom))).comp
              (wcZModPull (Dk k) j a) (zero_add j))
    (q m : ℕ) (e : Fin m → wcHM Y ℓ q)
    (he : Function.Bijective (fun c : Fin m → ℚ_[ℓ] => ∑ a, wcHMScalar Y ℓ q (c a) (e a))) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf T ℓ)) := HasExt.standard _
    Function.Bijective (fun c : Fin m → C(↥W₀, ULift.{u+1} ℚ_[ℓ]) =>
      ∑ a, (Abelian.Ext.mk₀ (wcHMFun T ℓ ((c a).comp g.base.hom))).comp
        (wcHMPull D q (e a)) (zero_add q)) :=
by
  obtain ⟨P⟩ := wc_ladic_milnor_package ℓ p D hD Dk hDk q
  exact ⟨wc_ladic_passage_injective ℓ g p D hD Dk hDk hfin htor q m e he P,
    wc_ladic_passage_surjective ℓ g p D hD Dk hDk hfin htor q m e he P⟩

theorem wc_wcontr_prod_kunneth (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (q m : ℕ) (e : Fin m → wcHM (wcXbar F X) ℓ q)
    (he : Function.Bijective
      (fun c : Fin m → ℚ_[ℓ] => ∑ a, wcHMScalar (wcXbar F X) ℓ q (c a) (e a)))
    (W : (wcXbar F X).ProEt)
    (hW : IsAffine W.left ∧ IsClosed {x : W.left | IsClosed ({x} : Set W.left)} ∧
      (∀ x : W.left, ∃! y : W.left, IsClosed ({y} : Set W.left) ∧ x ⤳ y) ∧
      ExtremallyDisconnected {x : W.left | IsClosed ({x} : Set W.left)} ∧
      (∀ x : W.left, IsClosed ({x} : Set W.left) →
        HenselianLocalRing (W.left.presheaf.stalk x) ∧ IsSepClosed (W.left.residueField x)))
    (D' : wcHMPullData (((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W).hom ≫
      Limits.pullback.snd (wcPi2 F X) (wcPi2 F X)) ℓ) (hD' : wcHMPullCanonical D') :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf
      ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W).left ℓ)) := HasExt.standard _
    Function.Bijective (fun c : Fin m → C(↥W.left, ULift.{u+1} ℚ_[ℓ]) =>
      ∑ a, (Abelian.Ext.mk₀ (wcHMFun ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W).left ℓ
        ((c a).comp (Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).base.hom))).comp
        (wcHMPull D' q (e a)) (zero_add q)) :=
by
  classical

  haveI : IsAffine W.left := hW.1
  haveI : IsAffine ((𝟭 Scheme).obj W.left) := hW.1
  have hQC : QuasiCompact (Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))) :=
    inferInstance
  have hQS : QuasiSeparated (Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))) :=
    inferInstance
  have hC : CompactSpace ↥((𝟭 Scheme).obj W.left) := inferInstance
  have hS : QuasiSeparatedSpace ↥((𝟭 Scheme).obj W.left) := inferInstance
  haveI := hC
  haveI : CompactSpace ↥(wcXbar F X) := QuasiCompact.compactSpace_of_compactSpace (wcPi2 F X)
  haveI : QuasiSeparatedSpace ↥(wcXbar F X) := quasiSeparatedSpace_of_quasiSeparated (wcPi2 F X)
  haveI : CompactSpace ↥((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W).left :=
    @QuasiCompact.compactSpace_of_compactSpace _ _
      (Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))) hQC hC
  haveI : QuasiSeparatedSpace ↥((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W).left :=
    @quasiSeparatedSpace_of_quasiSeparated _ _
      (Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))) hS hQS

  choose Dk hDk using fun k : ℕ => wc_zmod_pull_data_exists
    (((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W).hom ≫
      Limits.pullback.snd (wcPi2 F X) (wcPi2 F X)) (ℓ ^ k)

  exact wc_hm_ladic_kunneth_passage
    (Y := wcXbar F X)
    (T := ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W).left) ℓ
    (Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)))
    (((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W).hom ≫
      Limits.pullback.snd (wcPi2 F X) (wcPi2 F X)) D' hD' Dk hDk
    (fun k j hk => wc_xbar_zmod_coh_finite F X d ℓ hℓ k j hk)
    (fun k j hk => wc_wcontr_prod_torsion_kunneth F X d ℓ hℓ W hW k j hk (Dk k) (hDk k))
    q m e he

theorem wc_ybar_wcontr_kunneth_gen (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (D1 : wcHMPullData (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)) ℓ) (hD1 : wcHMPullCanonical D1)
    (D2 : wcHMPullData (Limits.pullback.snd (wcPi2 F X) (wcPi2 F X)) ℓ) (hD2 : wcHMPullCanonical D2)
    (I : InjectiveResolution
      (SheafOfModules.unit (wcRingSheaf (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ)))
    (q m : ℕ) (hq : q ≤ 2 * d) (e : Fin m → wcHM (wcXbar F X) ℓ q)
    (he : Function.Bijective
      (fun c : Fin m → ℚ_[ℓ] => ∑ a, wcHMScalar (wcXbar F X) ℓ q (c a) (e a)))
    (f : Fin m → (SheafOfModules.unit (wcRingSheaf (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ) ⟶
      I.cocomplex.X q))
    (hf : ∀ a, f a ≫ I.cocomplex.d q (q + 1) = 0)
    (hfe : ∀ a, @InjectiveResolution.extMk _ _ _ (HasExt.standard _) _ _ I q (f a) (q + 1) rfl (hf a) =
      wcHMPull D2 q (e a))
    (W : (wcXbar F X).ProEt)
    (hW : IsAffine W.left ∧ IsClosed {x : W.left | IsClosed ({x} : Set W.left)} ∧
      (∀ x : W.left, ∃! y : W.left, IsClosed ({y} : Set W.left) ∧ x ⤳ y) ∧
      ExtremallyDisconnected {x : W.left | IsClosed ({x} : Set W.left)} ∧
      (∀ x : W.left, IsClosed ({x} : Set W.left) →
        HenselianLocalRing (W.left.presheaf.stalk x) ∧ IsSepClosed (W.left.residueField x)))
    (s : (I.cocomplex.X q).val.obj
      (Opposite.op ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W)))
    (hs : ((I.cocomplex.d q (q + 1)).val.app
      (Opposite.op ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W))).hom s = 0) :
    ∃ (c : Fin m → (wcRingSheaf (wcXbar F X) ℓ).obj.obj (Opposite.op W))
      (y : (I.cocomplex.X ((ComplexShape.up ℕ).prev q)).val.obj
        (Opposite.op ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W))),
      s = ∑ a, ((f a).val.app (Opposite.op
          ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W))).hom
          ((D1.φ.hom.app (Opposite.op W)).hom (c a)) +
        ((I.cocomplex.d ((ComplexShape.up ℕ).prev q) q).val.app (Opposite.op
          ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W))).hom y :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1}
    (wcRingSheaf (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ)) := HasExt.standard _
  obtain ⟨P, ev, hnat, hadd⟩ := sheafOfModules_free_yoneda _
    (wcRingSheaf (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ)
    ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W)
  have hev0 : ∀ M, ev M 0 = 0 := fun M => map_zero (AddMonoidHom.mk' (ev M) (hadd M))
  have hevsum : ∀ M (φ : Fin m → (P ⟶ M)), ev M (∑ a, φ a) = ∑ a, ev M (φ a) :=
    fun M φ => map_sum (AddMonoidHom.mk' (ev M) (hadd M)) φ Finset.univ

  obtain ⟨g, hgs⟩ : ∃ g : P ⟶ I.cocomplex.X q, ev _ g = s :=
    ⟨(ev _).symm s, Equiv.apply_symm_apply _ _⟩
  have hg : g ≫ I.cocomplex.d q (q + 1) = 0 := by
    apply (ev _).injective
    rw [hnat, hgs, hs, hev0]

  obtain ⟨DV, hDV⟩ := wc_hm_pull_data_exists
    ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W).hom ℓ
  obtain ⟨D', hD'⟩ := wc_hm_pull_data_exists
    (((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W).hom ≫
      Limits.pullback.snd (wcPi2 F X) (wcPi2 F X)) ℓ
  obtain ⟨Θ, hΘ⟩ := wc_proet_free_slice_module_ext _ ℓ
    ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W) P ev hnat hadd DV hDV q

  obtain ⟨c, hc⟩ := (wc_wcontr_prod_kunneth F X d ℓ hℓ q m e he W hW D' hD').2
    (Θ (I.extMk g (q + 1) rfl hg))
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf
    ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W).left ℓ)) := HasExt.standard _
  have hc' : ∑ a, (Abelian.Ext.mk₀ (wcHMFun
          ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W).left ℓ
          ((c a).comp (Limits.pullback.fst W.hom
            (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).base.hom))).comp
        (wcHMPull D' q (e a)) (zero_add q) = Θ (I.extMk g (q + 1) rfl hg) := hc

  obtain ⟨u, hudef⟩ : ∃ u : Fin m → (P ⟶ I.cocomplex.X q), ∀ a,
      u a = (ev (SheafOfModules.unit
        (wcRingSheaf (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ))).symm
          ((D1.φ.hom.app (Opposite.op W)).hom (c a)) ≫ f a := ⟨_, fun _ => rfl⟩
  have hu : ∀ a, u a ≫ I.cocomplex.d q (q + 1) = 0 := by
    intro a
    rw [hudef, Category.assoc, hf a, Limits.comp_zero]
  have e1 : ∀ a, I.extMk (u a) (q + 1) rfl (hu a) =
      (Abelian.Ext.mk₀ ((ev (SheafOfModules.unit
        (wcRingSheaf (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ))).symm
          ((D1.φ.hom.app (Opposite.op W)).hom (c a)))).comp
        (I.extMk (f a) (q + 1) rfl (hf a)) (zero_add q) := by
    intro a
    rw [InjectiveResolution.mk₀_comp_extMk]
    congr 1
    exact hudef a
  have hext : I.extMk g (q + 1) rfl hg = ∑ a, I.extMk (u a) (q + 1) rfl (hu a) := by
    apply Θ.injective
    rw [← hc', map_sum]
    refine Finset.sum_congr rfl (fun a _ => ?_)
    rw [e1 a, hfe a]
    refine Eq.trans ?_ (hΘ _ _).symm
    rw [← wc_hm_pull_comp (Limits.pullback.snd (wcPi2 F X) (wcPi2 F X))
        ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W).hom _ rfl
        D2 hD2 DV hDV D' hD']
    exact congrArg (fun r => (Abelian.Ext.mk₀ (wcHMFun
        ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W).left ℓ r)).comp
          (wcHMPull D' q (e a)) (zero_add q)) (hD1 W (c a)).symm

  obtain ⟨k, hk⟩ := injectiveResolution_coboundary_of_extMk_eq_sum I q m g hg u hu hext
  refine ⟨c, ev _ k, ?_⟩
  rw [← hgs, hk, hadd, hevsum, hnat]
  congr 1
  refine Finset.sum_congr rfl (fun a _ => ?_)
  rw [hudef, hnat]
  exact congrArg _ (Equiv.apply_symm_apply _ _)

theorem wc_ybar_wcontr_kunneth_ind (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (D1 : wcHMPullData (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)) ℓ) (hD1 : wcHMPullCanonical D1)
    (D2 : wcHMPullData (Limits.pullback.snd (wcPi2 F X) (wcPi2 F X)) ℓ) (hD2 : wcHMPullCanonical D2)
    (I : InjectiveResolution
      (SheafOfModules.unit (wcRingSheaf (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ)))
    (q m : ℕ) (hq : q ≤ 2 * d) (e : Fin m → wcHM (wcXbar F X) ℓ q)
    (he : Function.Bijective
      (fun c : Fin m → ℚ_[ℓ] => ∑ a, wcHMScalar (wcXbar F X) ℓ q (c a) (e a)))
    (f : Fin m → (SheafOfModules.unit (wcRingSheaf (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ) ⟶
      I.cocomplex.X q))
    (hf : ∀ a, f a ≫ I.cocomplex.d q (q + 1) = 0)
    (hfe : ∀ a, @InjectiveResolution.extMk _ _ _ (HasExt.standard _) _ _ I q (f a) (q + 1) rfl (hf a) =
      wcHMPull D2 q (e a))
    (W : (wcXbar F X).ProEt)
    (hW : IsAffine W.left ∧ IsClosed {x : W.left | IsClosed ({x} : Set W.left)} ∧
      (∀ x : W.left, ∃! y : W.left, IsClosed ({y} : Set W.left) ∧ x ⤳ y) ∧
