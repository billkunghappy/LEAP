  intro I c hc
  intro hcω hf
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf OU.toScheme ℓ)) := HasExt.standard _
  letI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC g) _ _ Dg.cont Dg.φ).Additive :=
    @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ Dg.adj Dg.additive
  haveI := Dg.cont

  obtain ⟨f, hfdef⟩ : ∃ f : SheafOfModules.unit (wcRingSheaf OU.toScheme ℓ) ⟶ I.cocomplex.X (2 * d - 1),
      f = (wcHMFun OU.toScheme ℓ τ ≫ Dg.μ.inv) ≫ c := ⟨_, rfl⟩
  have hf' : f ≫ I.cocomplex.d (2 * d - 1) (2 * d - 1 + 1) = 0 := by
    rw [hfdef, Category.assoc, hc, Limits.comp_zero]
  have h9' : Dg.adj.unit.app (SheafOfModules.unit (wcRingSheaf U ℓ)) ≫
      (SheafOfModules.pushforward Dg.φ).map Dg.μ.hom =
      SheafOfModules.unitToPushforwardObjUnit Dg.φ ≫
        (SheafOfModules.pushforward Dg.φ).map (wcHMFun OU.toScheme ℓ τ) := h9
  have hψ : Dg.adj.homEquiv _ _ c =
      SheafOfModules.unitToPushforwardObjUnit Dg.φ ≫ (SheafOfModules.pushforward Dg.φ).map f := by
    rw [Adjunction.homEquiv_unit, hfdef]
    calc Dg.adj.unit.app (SheafOfModules.unit (wcRingSheaf U ℓ)) ≫
          (SheafOfModules.pushforward Dg.φ).map c
        = Dg.adj.unit.app (SheafOfModules.unit (wcRingSheaf U ℓ)) ≫
          (SheafOfModules.pushforward Dg.φ).map (Dg.μ.hom ≫ Dg.μ.inv ≫ c) := by
          rw [Iso.hom_inv_id_assoc]
      _ = (Dg.adj.unit.app (SheafOfModules.unit (wcRingSheaf U ℓ)) ≫
          (SheafOfModules.pushforward Dg.φ).map Dg.μ.hom) ≫
          (SheafOfModules.pushforward Dg.φ).map (Dg.μ.inv ≫ c) := by
          rw [Functor.map_comp, Category.assoc]
      _ = (SheafOfModules.unitToPushforwardObjUnit Dg.φ ≫
          (SheafOfModules.pushforward Dg.φ).map (wcHMFun OU.toScheme ℓ τ)) ≫
          (SheafOfModules.pushforward Dg.φ).map (Dg.μ.inv ≫ c) := by rw [h9']
      _ = _ := by
          rw [Category.assoc, ← Functor.map_comp, Category.assoc]
  have hΩ : I.extMk f (2 * d - 1 + 1) rfl hf' =
      (Abelian.Ext.mk₀ (wcHMFun OU.toScheme ℓ τ)).comp (wcHMPull DprO (2 * d - 1) ω) (zero_add _) := by
    have e := I.mk₀_comp_extMk c (2 * d - 1 + 1) rfl hc (wcHMFun OU.toScheme ℓ τ ≫ Dg.μ.inv)
