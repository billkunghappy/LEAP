  obtain ⟨e, he⟩ := P2 W₂ _ _ hs₂ hky₂ key

  refine ⟨(wcEtBaseChange i).obj W₂, (wcEtBaseChange i).map h₂ ≫ hV, t, k, e, ?_, ?_⟩
  · show (((wcEtBaseChange i).map h₂).left ≫ hV.left) t = v
    exact (Scheme.Hom.comp_apply ((wcEtBaseChange i).map h₂).left hV.left t).trans
      ((congrArg (fun q => hV.left q) ht).trans hx)
  · show ((R.obj (I.cocomplex.X (2 * r))).val.map ((wcEtBaseChange i).map h₂ ≫ hV).op).hom s =
      k • (cb.val.app (Opposite.op ((wcEtBaseChange i).obj W₂))).hom
        (1 : (wcEtZModRing Z ℓ).obj.obj (Opposite.op ((wcEtBaseChange i).obj W₂))) +
      ((R.map (I.cocomplex.d ((ComplexShape.up ℕ).prev (2 * r)) (2 * r))).val.app
