    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf T ℓ)) := HasExt.standard _
    rw [(wc_hm_fun_one_mul T ℓ).2, ← Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.comp_assoc_of_second_deg_zero]
  have hF1 : ∀ (T : Scheme.{u}) (z : wcHM T ℓ (2 * d - 1)),
      letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf T ℓ)) := HasExt.standard _
      (Abelian.Ext.mk₀ (wcHMFun T ℓ 1)).comp z (zero_add _) = z := by
    intro T z
