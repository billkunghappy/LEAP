      rw [e, Abelian.Ext.comp_assoc_of_second_deg_zero, h0, Abelian.Ext.comp_zero]
    have hk : (Abelian.Ext.mk₀ (adjB.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)))).comp
