  have hs_univ : (∑ a, ρ a ≫ f a) ≫ I.cocomplex.d q (q + 1) = 0 := by
    rw [Preadditive.sum_comp]
    exact Finset.sum_eq_zero (fun a _ => hu a)
  have hvan : ∑ a, (Abelian.Ext.mk₀ (ρ a)).comp (wcHMPull D2 q (e a)) (zero_add q) = 0 := by
    have h1 : ∀ a, (Abelian.Ext.mk₀ (ρ a)).comp (wcHMPull D2 q (e a)) (zero_add q) =
        I.extMk (ρ a ≫ f a) (q + 1) rfl (hu a) := by
