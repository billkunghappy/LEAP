theorem wc_zmod_stalk_basicOpen_limit : ∀ {W₀ T : Scheme.{u}} [IsAffine W₀] (g : T ⟶ W₀) [QuasiCompact g] [QuasiSeparated g] (z : W₀), ∃ (Λ : Type u) (_ : SmallCategory Λ) (_ : IsCofiltered Λ) (U : Λ → W₀.Opens) (D : Λ ⥤ T.Etale) (π : ∀ l, Limits.pullback (W₀.fromSpecStalk z) g ⟶ (D.obj l).left), (∀ l, z ∈ U l) ∧ (∀ l, ∃ e : ↑(g ⁻¹ᵁ U l) ⟶ (D.obj l).left, e ≫ (D.obj l).hom = (g ⁻¹ᵁ U l).ι) ∧ (∀ l, π l ≫ (D.obj l).hom = Limits.pullback.snd (W₀.fromSpecStalk z) g) ∧ (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ (D.map t).left = π l') ∧ (∀ (T' : Scheme.{u}) (w : ∀ l, T' ⟶ (D.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), w l ≫ (D.map t).left = w l') → ∃! w₀ : T' ⟶ Limits.pullback (W₀.fromSpecStalk z) g, ∀ l, w₀ ≫ π l = w l) ∧ (∀ l, CompactSpace (D.obj l).left) ∧ (∀ l, QuasiSeparatedSpace (D.obj l).left) ∧ (∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom (D.map t).left) :=
by
  intro W₀ T _ g _ _ z
  classical

  have hstalk : ∀ (T' : Scheme.{u}) (c : T' ⟶ W₀),
      (∀ s : Γ(W₀, ⊤), z ∈ W₀.basicOpen s → IsUnit (c.appTop s)) →
      ∃ b : T' ⟶ Spec (W₀.presheaf.stalk z), b ≫ W₀.fromSpecStalk z = c := by
    intro T' c hU
    have hA := isAffineOpen_top W₀
    letI := TopCat.Presheaf.algebra_section_stalk W₀.presheaf (⟨z, trivial⟩ : (⊤ : W₀.Opens))
    haveI hloc : IsLocalization.AtPrime (W₀.presheaf.stalk z)
        (hA.primeIdealOf ⟨z, trivial⟩).asIdeal :=
      hA.isLocalization_stalk ⟨z, trivial⟩
    have hφ : ∀ y : (hA.primeIdealOf ⟨z, trivial⟩).asIdeal.primeCompl,
        IsUnit (c.appTop.hom (y : Γ(W₀, ⊤))) := by
      intro y
      apply hU
      rw [Scheme.mem_basicOpen_top]
      exact (IsLocalization.AtPrime.isUnit_to_map_iff (W₀.presheaf.stalk z) _
        (y : Γ(W₀, ⊤))).mpr y.2
    obtain ⟨ψ, hψ⟩ : ∃ ψ : W₀.presheaf.stalk z →+* Γ(T', ⊤),
        ∀ x, ψ (algebraMap Γ(W₀, ⊤) (W₀.presheaf.stalk z) x) = c.appTop.hom x :=
      ⟨IsLocalization.lift (M := (hA.primeIdealOf ⟨z, trivial⟩).asIdeal.primeCompl)
          (S := W₀.presheaf.stalk z) hφ, IsLocalization.lift_eq hφ⟩
    have hψ' : W₀.presheaf.germ ⊤ z trivial ≫ CommRingCat.ofHom ψ = c.appTop := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro x
      exact hψ x
    refine ⟨T'.toSpecΓ ≫ Spec.map (CommRingCat.ofHom ψ), ?_⟩
    refine (cancel_mono W₀.toSpecΓ).1 ?_
    rw [Category.assoc, Category.assoc, Scheme.fromSpecStalk_toSpecΓ,
      Scheme.toSpecΓ_naturality, ← hψ']
    exact congrArg (T'.toSpecΓ ≫ ·) (Spec.map_comp _ _).symm

  have hrange : ∀ U : W₀.Opens, z ∈ U →
      Set.range (Limits.pullback.snd (W₀.fromSpecStalk z) g) ⊆ Set.range (g ⁻¹ᵁ U).ι := by
    rintro U hzU _ ⟨p, rfl⟩
    rw [Scheme.Opens.range_ι]
    show g (Limits.pullback.snd (W₀.fromSpecStalk z) g p) ∈ U
    rw [← Scheme.Hom.comp_apply, ← Limits.pullback.condition, Scheme.Hom.comp_apply]
    have hr : W₀.fromSpecStalk z (Limits.pullback.fst (W₀.fromSpecStalk z) g p) ∈
        Set.range (W₀.fromSpecStalk z) := ⟨_, rfl⟩
    rw [Scheme.range_fromSpecStalk] at hr
    exact Specializes.mem_open hr U.isOpen hzU
  have hlift0 : ∀ V : T.Opens,
      Set.range (Limits.pullback.snd (W₀.fromSpecStalk z) g) ⊆ Set.range V.ι →
      ∃ p : Limits.pullback (W₀.fromSpecStalk z) g ⟶ (V : Scheme.{u}),
        p ≫ V.ι = Limits.pullback.snd (W₀.fromSpecStalk z) g := fun V hV =>
    ⟨IsOpenImmersion.lift V.ι _ hV, IsOpenImmersion.lift_fac _ _ _⟩

  have hAff : ∀ U : W₀.Opens, (∃ f : Γ(W₀, ⊤), U = W₀.basicOpen f) →
      IsAffineHom (g ⁻¹ᵁ U).ι := by
    rintro U ⟨f, rfl⟩
    exact MorphismProperty.of_isPullback (P := @IsAffineHom) (isPullback_morphismRestrict g _)
      inferInstance

  let Λ : Type u := {U : W₀.Opens // z ∈ U ∧ ∃ f : Γ(W₀, ⊤), U = W₀.basicOpen f}
  let lt : Λ := ⟨⊤, trivial, 1, (Scheme.basicOpen_one W₀ (U := ⊤)).symm⟩
  have : Nonempty Λ := ⟨lt⟩
  have : IsCodirectedOrder Λ := by
    constructor
    rintro ⟨U₁, hz₁, f₁, rfl⟩ ⟨U₂, hz₂, f₂, rfl⟩
    refine ⟨⟨W₀.basicOpen (f₁ * f₂), ?_, f₁ * f₂, rfl⟩, ?_, ?_⟩
    · rw [Scheme.basicOpen_mul]; exact ⟨hz₁, hz₂⟩
    · show W₀.basicOpen (f₁ * f₂) ≤ W₀.basicOpen f₁
      rw [Scheme.basicOpen_mul]; exact inf_le_left
    · show W₀.basicOpen (f₁ * f₂) ≤ W₀.basicOpen f₂
      rw [Scheme.basicOpen_mul]; exact inf_le_right
  have hcof : IsCofiltered Λ := isCofiltered_of_directed_ge_nonempty Λ
  have hlift : ∀ l : Λ, ∃ p : Limits.pullback (W₀.fromSpecStalk z) g ⟶
      ((g ⁻¹ᵁ l.1 : T.Opens) : Scheme.{u}),
      p ≫ (g ⁻¹ᵁ l.1).ι = Limits.pullback.snd (W₀.fromSpecStalk z) g := fun l =>
    hlift0 _ (hrange l.1 l.2.1)
  choose π hπ using hlift

  let D : Λ ⥤ T.Etale :=
    { obj := fun l => Scheme.Etale.mk (g ⁻¹ᵁ l.1).ι
      map := fun {l l'} t => MorphismProperty.Over.homMk
        (T.homOfLE (g.preimage_mono (leOfHom t))) (Scheme.homOfLE_ι T _) trivial
      map_id := fun l => by
        apply MorphismProperty.Over.Hom.ext
        exact Scheme.homOfLE_rfl T _
      map_comp := fun t t' => by
        apply MorphismProperty.Over.Hom.ext
        exact (Scheme.homOfLE_homOfLE T (g.preimage_mono (leOfHom t))
          (g.preimage_mono (leOfHom t'))).symm }
  refine ⟨Λ, inferInstance, hcof, fun l => l.1, D, π, fun l => l.2.1,
    fun l => ⟨𝟙 _, Category.id_comp _⟩, hπ, ?_, ?_, ?_, ?_, ?_⟩
  ·
    intro l l' t
    refine (cancel_mono (g ⁻¹ᵁ l'.1).ι).1 ?_
    exact (Category.assoc _ _ _).trans
      ((congrArg (π l ≫ ·) (Scheme.homOfLE_ι T (g.preimage_mono (leOfHom t)))).trans
        ((hπ l).trans (hπ l').symm))
  ·
    intro T' w hw
    obtain ⟨w', hw'⟩ : ∃ w' : ∀ l : Λ, T' ⟶ ((g ⁻¹ᵁ l.1 : T.Opens) : Scheme.{u}),
        ∀ l, w' l = w l := ⟨w, fun _ => rfl⟩
    have hwc : ∀ {l l' : Λ} (t : l ⟶ l'),
        w' l ≫ T.homOfLE (g.preimage_mono (leOfHom t)) = w' l' := by
      intro l l' t
      rw [hw', hw']
      exact hw t
    have key : ∀ {l l' : Λ} (t : l ⟶ l'),
        w' l ≫ (g ⁻¹ᵁ l.1).ι = w' l' ≫ (g ⁻¹ᵁ l'.1).ι := by
      intro l l' t
      rw [← hwc t, Category.assoc, Scheme.homOfLE_ι]
    obtain ⟨a, ha⟩ : ∃ a : T' ⟶ T, a = w' lt ≫ (g ⁻¹ᵁ lt.1).ι := ⟨_, rfl⟩
    have hC : ∀ l : Λ, w' l ≫ (g ⁻¹ᵁ l.1).ι = a := by
      intro l
      rw [ha, ← key (IsCofiltered.minToLeft l lt), key (IsCofiltered.minToRight l lt)]

    have hU : ∀ s : Γ(W₀, ⊤), z ∈ W₀.basicOpen s → IsUnit ((a ≫ g).appTop s) := by
      intro s hs
      let ls : Λ := ⟨W₀.basicOpen s, hs, s, rfl⟩
      refine RingedSpace.isUnit_of_isUnit_germ T'.toRingedSpace ⊤ _ (fun x _ => ?_)
      have hx : x ∈ T'.basicOpen ((a ≫ g).appTop s) := by
        rw [← Scheme.Hom.preimage_basicOpen_top]
        show (a ≫ g) x ∈ W₀.basicOpen s
        rw [Scheme.Hom.comp_apply, ← hC ls, Scheme.Hom.comp_apply]
        have hm : (g ⁻¹ᵁ ls.1).ι (w' ls x) ∈ g ⁻¹ᵁ ls.1 := by
          rw [← SetLike.mem_coe, ← Scheme.Opens.range_ι]
          exact ⟨_, rfl⟩
        exact hm
      exact (Scheme.mem_basicOpen_top T' _ x).mp hx
    obtain ⟨b, hb⟩ := hstalk T' (a ≫ g) hU
    refine ⟨Limits.pullback.lift b a hb, fun l => ?_, fun v hv => ?_⟩
    · refine ((cancel_mono (g ⁻¹ᵁ l.1).ι).1 ?_).trans (hw' l)
      exact (Category.assoc _ _ _).trans ((congrArg (Limits.pullback.lift b a hb ≫ ·) (hπ l)).trans
        ((Limits.pullback.lift_snd b a hb).trans (hC l).symm))
    · refine (cancel_mono (Limits.pullback.snd (W₀.fromSpecStalk z) g)).1 ?_
      have e : v ≫ π lt = w' lt := (hv lt).trans (hw' lt).symm
      rw [Limits.pullback.lift_snd, ← hπ lt, ← Category.assoc, e, hC lt]
  ·
    rintro ⟨U, hz, f, rfl⟩
    show CompactSpace ↑(g ⁻¹ᵁ W₀.basicOpen f)
    exact QuasiCompact.compactSpace_of_compactSpace (g ∣_ W₀.basicOpen f)
  ·
    rintro ⟨U, hz, f, rfl⟩
    show QuasiSeparatedSpace ↑(g ⁻¹ᵁ W₀.basicOpen f)
    exact quasiSeparatedSpace_of_quasiSeparated (g ∣_ W₀.basicOpen f)
  ·
    intro l l' t
    haveI := hAff l.1 l.2.2
    haveI := hAff l'.1 l'.2.2
    show IsAffineHom (T.homOfLE (g.preimage_mono (leOfHom t)))
    haveI : IsAffineHom (T.homOfLE (g.preimage_mono (leOfHom t)) ≫ (g ⁻¹ᵁ l'.1).ι) := by
      rw [Scheme.homOfLE_ι]; infer_instance
    exact IsAffineHom.of_comp _ (g ⁻¹ᵁ l'.1).ι

theorem wc_r2gs_zmod_change_rings_pull_all : ∀ (m : ℕ) (q : ℕ), ∃ N : ∀ Y : Scheme.{u}, wcEtZModExt Y m q →+ wcR2gsH Y m q, (∀ Y, Function.Bijective (N Y)) ∧ ∀ {Y Z : Scheme.{u}} (σ : Z ⟶ Y) (A : wcR2gsAdjData σ m) (D : wcEtPullData σ m) (b : wcEtZModExt Y m q), N Z (wcEtPull D q b) = wcR2gsAPull A q (N Y b) :=
by
  intro m q
  classical

  have hPFC : ∀ Y : Scheme.{u},
      Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y m)) :=
    fun Y => sheafOfModules_toSheaf_preservesFiniteColimits _ _

  have hcorep : ∀ (Y : Scheme.{u}) [Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y m))], ∃ c : (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y m)).obj (SheafOfModules.unit (wcEtZModRing Y m)), (∀ V : Y.Etale, (c.hom.app (Opposite.op V)).hom (wcConstSec Y (ULift.{u+1} ℤ) V (ULift.up 1)) = (1 : (wcEtZModRing Y m).obj.obj (Opposite.op V))) ∧ ∀ (N : SheafOfModules.{u+1} (wcEtZModRing Y m)) (q : ℕ), letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _; letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y m)) := HasExt.standard _; Function.Bijective (fun β : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y m)) N q => (Abelian.Ext.mk₀ c).comp (Abelian.Ext.mapExactFunctor (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y m)) β) (zero_add q)) := by
    intro Y _

    let κ : (Functor.const (Y.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶
        ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y m)).obj
          (SheafOfModules.unit (wcEtZModRing Y m))).obj :=
      { app := fun V => AddCommGrpCat.ofHom ((Int.castAddHom ((wcEtZModRing Y m).obj.obj V)).comp
            (AddEquiv.ulift.{0, u+1} (α := ℤ)).toAddMonoidHom)
        naturality := fun V W g => by
          apply AddCommGrpCat.hom_ext
          apply AddMonoidHom.ext
          intro x
          show ((x.down : ℤ) : (wcEtZModRing Y m).obj.obj W) =
            ((wcEtZModRing Y m).obj.map g).hom ((x.down : ℤ) : (wcEtZModRing Y m).obj.obj V)
          rw [map_intCast] }
    let c : (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y m)).obj
          (SheafOfModules.unit (wcEtZModRing Y m)) :=
      ObjectProperty.homMk (sheafifyLift (Scheme.smallEtaleTopology Y) κ
        ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y m)).obj
          (SheafOfModules.unit (wcEtZModRing Y m))).property)
    have hc : ∀ V : Y.Etale, (c.hom.app (Opposite.op V)).hom
        (wcConstSec Y (ULift.{u+1} ℤ) V (ULift.up 1)) =
          (1 : (wcEtZModRing Y m).obj.obj (Opposite.op V)) := by
      intro V
      have h := congrArg (fun η => (η.app (Opposite.op V)).hom (ULift.up.{u+1} (1 : ℤ)))
        (toSheafify_sheafifyLift (Scheme.smallEtaleTopology Y) κ
          ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y m)).obj
            (SheafOfModules.unit (wcEtZModRing Y m))).property)
      refine h.trans ?_
      show ((1 : ℤ) : (wcEtZModRing Y m).obj.obj (Opposite.op V)) = 1
      exact Int.cast_one

    have hext : ∀ (Q : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
        (f g : (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ Q),
        (∀ V : Y.Etale, (f.hom.app (Opposite.op V)).hom (wcConstSec Y (ULift.{u+1} ℤ) V (ULift.up 1)) =
          (g.hom.app (Opposite.op V)).hom (wcConstSec Y (ULift.{u+1} ℤ) V (ULift.up 1))) → f = g := by
      intro Q f g hfg
      apply Sheaf.hom_ext
      apply sheafify_hom_ext (Scheme.smallEtaleTopology Y)
        (P := (Functor.const (Y.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) f.hom g.hom Q.property
      refine NatTrans.ext (funext fun X => ?_)
      have key : (((toSheafify (Scheme.smallEtaleTopology Y)
            ((Functor.const (Y.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ≫ f.hom).app X).hom.comp
            (AddEquiv.ulift.{0, u+1} (α := ℤ)).symm.toAddMonoidHom) =
          (((toSheafify (Scheme.smallEtaleTopology Y)
            ((Functor.const (Y.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ≫ g.hom).app X).hom.comp
            (AddEquiv.ulift.{0, u+1} (α := ℤ)).symm.toAddMonoidHom) :=
        AddMonoidHom.ext_int (hfg (Opposite.unop X))
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro x
      exact DFunLike.congr_fun key x.down

    have hpt : ∀ (M : SheafOfModules.{u+1} (wcEtZModRing Y m))
        (f : SheafOfModules.unit (wcEtZModRing Y m) ⟶ M) (V : Y.Etale),
        ((c ≫ (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y m)).map f).hom.app (Opposite.op V)).hom
          (wcConstSec Y (ULift.{u+1} ℤ) V (ULift.up 1)) =
          (f.val.app (Opposite.op V)).hom (1 : (wcEtZModRing Y m).obj.obj (Opposite.op V)) := by
      intro M f V
      show (((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y m)).map f).hom.app (Opposite.op V)).hom
        ((c.hom.app (Opposite.op V)).hom (wcConstSec Y (ULift.{u+1} ℤ) V (ULift.up 1))) = _
      rw [hc V]
      rfl
    have hinj : ∀ (M : SheafOfModules.{u+1} (wcEtZModRing Y m))
        (f f' : SheafOfModules.unit (wcEtZModRing Y m) ⟶ M),
        c ≫ (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y m)).map f =
          c ≫ (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y m)).map f' → f = f' := by
      intro M f f' h
      apply M.unitHomEquiv.injective
      apply PresheafOfModules.sections_ext
      intro X
      rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
      have h1 := congrArg (fun k => (k.hom.app (Opposite.op X.unop)).hom
        (wcConstSec Y (ULift.{u+1} ℤ) X.unop (ULift.up 1))) h
      have h2 := (hpt M f X.unop).symm.trans (h1.trans (hpt M f' X.unop))
      exact h2
    have hsurj : ∀ (M : SheafOfModules.{u+1} (wcEtZModRing Y m))
        (φ : (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y m)).obj M),
        ∃ f : SheafOfModules.unit (wcEtZModRing Y m) ⟶ M,
          c ≫ (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y m)).map f = φ := by
      intro M φ
      have hres : ∀ ⦃X X' : (Y.Etale)ᵒᵖ⦄ (g : X ⟶ X'),
          (((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} ℤ))).obj.map g).hom
            (wcConstSec Y (ULift.{u+1} ℤ) X.unop (ULift.up 1)) =
            wcConstSec Y (ULift.{u+1} ℤ) X'.unop (ULift.up 1) := by
        intro X X' g
        have h := congrArg (fun η => η.hom (ULift.up.{u+1} (1 : ℤ)))
          ((toSheafify (Scheme.smallEtaleTopology Y)
            ((Functor.const (Y.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))).naturality g)
        exact h.symm
      let s : ∀ X : (Y.Etale)ᵒᵖ, M.val.obj X := fun X =>
        (φ.hom.app X).hom (wcConstSec Y (ULift.{u+1} ℤ) X.unop (ULift.up 1))
      have hs : ∀ ⦃X X' : (Y.Etale)ᵒᵖ⦄ (g : X ⟶ X'), (M.val.map g).hom (s X) = s X' := by
        intro X X' g
        have h := congrArg (fun η => η.hom (wcConstSec Y (ULift.{u+1} ℤ) X.unop (ULift.up 1)))
          (φ.hom.naturality g)
        refine h.symm.trans ?_
        show (φ.hom.app X').hom ((((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} ℤ))).obj.map g).hom
            (wcConstSec Y (ULift.{u+1} ℤ) X.unop (ULift.up 1))) = _
        rw [hres g]
      let σ : M.val.sections := PresheafOfModules.sectionsMk s hs
      refine ⟨M.unitHomEquiv.symm σ, hext _ _ _ (fun V => ?_)⟩
      refine (hpt M _ V).trans ?_
      refine (SheafOfModules.unitHomEquiv_apply_coe M _ (Opposite.op V)).symm.trans ?_
      rw [Equiv.apply_symm_apply]
      rfl
    refine ⟨c, hc, ?_⟩
    intro N q
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y m)) := HasExt.standard _
    haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing Y m)) :=
      sheafOfModules_enoughInjectives _ _
    haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
      wc_et_enough_injectives Y
    obtain ⟨α, hαi, hαs, hR⟩ := wc_et_zmod_ring_locbij Y m
    obtain ⟨hfull, hess⟩ := sheafOfModules_toSheaf_torsion_equiv (Scheme.smallEtaleTopology Y)
      (wcEtZModRing Y m) m α hαi hαs
    haveI := hfull
    have hhom : ∀ M : SheafOfModules.{u+1} (wcEtZModRing Y m),
        Function.Bijective (fun f : SheafOfModules.unit (wcEtZModRing Y m) ⟶ M =>
          c ≫ (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y m)).map f) :=
      fun M => ⟨fun f f' h => hinj M f f' h, fun φ => hsurj M φ⟩
    have hvan : ∀ (I : SheafOfModules.{u+1} (wcEtZModRing Y m)) [Injective I] (n : ℕ)
