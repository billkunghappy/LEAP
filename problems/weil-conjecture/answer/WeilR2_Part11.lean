        (congrArg (fun z => (Abelian.Ext.mk₀ (wcHMFun ((wcProEtBC g).obj W').left ℓ
          (τ.comp ((wcProEtBC g).obj W').hom.base.hom))).comp z (zero_add (2 * d - 1)))
          (wc_hm_pull_comp prO ((wcProEtBC g).obj W').hom _ rfl DprO hDprO DV hDV D' hD'
