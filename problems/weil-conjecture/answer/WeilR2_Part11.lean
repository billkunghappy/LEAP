      induction k using Fin.cases with
      | zero =>
        have h0 : (t'.comp ((e 0 ≫ gW).left.base.hom) : C(↥(W' 0).left, ULift.{u+1} ℚ_[ℓ])) =
            0 := by
          ext x
          exact congrArg ULift.down (hq0 x)
        change (w.val.app (Opposite.op (W' 0))).hom (t'.comp ((e 0 ≫ gW).left.base.hom)) = 0
        refine (congrArg (fun s => (w.val.app (Opposite.op (W' 0))).hom s) h0).trans ?_
        exact map_zero _
      | succ k =>
        have hV : ∀ x : ↥(W' k.succ).left, (W' k.succ).hom x ∉ Set.range i := by
          intro x
          have hx : (W.left.basicOpen (f k)).ι x ∈ (W.left.basicOpen (f k) : Set ↥W.left) := by
            rw [← Scheme.Opens.range_ι]; exact ⟨x, rfl⟩
          exact (hf _).mpr ⟨k, hx⟩
        have hs4 := hw1 (W' k.succ) hV
        have hsm := (w.val.app (Opposite.op (W' k.succ))).hom.map_smul
          (t'.comp ((e k.succ ≫ gW).left.base.hom))
          (1 : C(↥(W' k.succ).left, ULift.{u+1} ℚ_[ℓ]))
        change (w.val.app (Opposite.op (W' k.succ))).hom
          (t'.comp ((e k.succ ≫ gW).left.base.hom)) = 0
        refine (congrArg (fun s => (w.val.app (Opposite.op (W' k.succ))).hom s)
          (mul_one (t'.comp ((e k.succ ≫ gW).left.base.hom))).symm).trans ?_
        refine hsm.trans ?_
        rw [hs4]
        exact smul_zero _
  have hker : Limits.kernel.ι (wcSuppUnitMap Di) ≫ w = 0 := by
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro X
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    induction X using Opposite.rec with
    | op U =>
    have hk := congrArg (fun φ => (φ.val.app (Opposite.op U)).hom x)
      (Limits.kernel.condition (wcSuppUnitMap Di))
    change ((wcSuppUnitMap Di).val.app (Opposite.op U)).hom
      (((Limits.kernel.ι (wcSuppUnitMap Di)).val.app (Opposite.op U)).hom x) = 0 at hk
    change (w.val.app (Opposite.op U)).hom
      (((Limits.kernel.ι (wcSuppUnitMap Di)).val.app (Opposite.op U)).hom x) = 0
    exact key U _ (vanish U _ hk)
  let f := Abelian.epiDesc (wcSuppUnitMap Di) w hker
  have hf : wcSuppUnitMap Di ≫ f = w := Abelian.comp_epiDesc _ _ _

  have htop : (((wcSliceRes V ℓ Vo).map w).val.app
        (Opposite.op (Scheme.ProEt.mk (𝟙 Vo.left)))).hom
        (1 : ↑((wcRingSheaf V ℓ).obj.obj
          (Opposite.op ((wcSliceFunctor V Vo).obj (Scheme.ProEt.mk (𝟙 Vo.left)))))) =
      (w'.val.app (Opposite.op (Scheme.ProEt.mk (𝟙 Vo.left)))).hom
        (1 : ↑((wcRingSheaf V ℓ).obj.obj
          (Opposite.op ((wcSliceFunctor V Vo).obj (Scheme.ProEt.mk (𝟙 Vo.left)))))) := by
    refine Eq.trans ?_ ht
    change (w.val.app (Opposite.op ((wcSliceFunctor V Vo).obj (Scheme.ProEt.mk (𝟙 Vo.left))))).hom
      (1 : ↑((wcRingSheaf V ℓ).obj.obj
        (Opposite.op ((wcSliceFunctor V Vo).obj (Scheme.ProEt.mk (𝟙 Vo.left)))))) = t
    rw [hwv, hV1]
  have hRw : (wcSliceRes V ℓ Vo).map w = w' := by
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro X
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    induction X using Opposite.rec with
    | op U' =>
    let k : U' ⟶ Scheme.ProEt.mk (𝟙 Vo.left) :=
      MorphismProperty.Over.homMk U'.hom (by exact Category.comp_id _) trivial
    let r : ↑((wcRingSheaf Vo.left ℓ).obj.obj (Opposite.op U')) := x
    have hval : ∀ d : (wcSliceRes V ℓ Vo).obj (SheafOfModules.unit (wcRingSheaf V ℓ)) ⟶
        (wcSliceRes V ℓ Vo).obj N,
        (d.val.app (Opposite.op U')).hom x = r • (((wcSliceRes V ℓ Vo).obj N).val.map k.op).hom
          ((d.val.app (Opposite.op (Scheme.ProEt.mk (𝟙 Vo.left)))).hom
            (1 : ↑((wcRingSheaf V ℓ).obj.obj
              (Opposite.op ((wcSliceFunctor V Vo).obj (Scheme.ProEt.mk (𝟙 Vo.left))))))) := by
      intro d
      have hn := PresheafOfModules.naturality_apply d.val k.op
        (1 : ↑((wcRingSheaf V ℓ).obj.obj
          (Opposite.op ((wcSliceFunctor V Vo).obj (Scheme.ProEt.mk (𝟙 Vo.left))))))
      have h1 : ((wcRingSheaf V ℓ).obj.map ((wcSliceFunctor V Vo).map k).op).hom
          (1 : ↑((wcRingSheaf V ℓ).obj.obj
            (Opposite.op ((wcSliceFunctor V Vo).obj (Scheme.ProEt.mk (𝟙 Vo.left)))))) = 1 :=
        map_one _
      change (d.val.app (Opposite.op U')).hom
        (((wcRingSheaf V ℓ).obj.map ((wcSliceFunctor V Vo).map k).op).hom
          (1 : ↑((wcRingSheaf V ℓ).obj.obj
            (Opposite.op ((wcSliceFunctor V Vo).obj (Scheme.ProEt.mk (𝟙 Vo.left))))))) = _ at hn
      rw [h1] at hn
      have hsm := (d.val.app (Opposite.op U')).hom.map_smul r
        (1 : ↑((wcRingSheaf V ℓ).obj.obj (Opposite.op ((wcSliceFunctor V Vo).obj U'))))
      exact ((congrArg (d.val.app (Opposite.op U')).hom (mul_one r).symm).trans hsm).trans
        (congrArg (fun z => r • z) hn)
    exact (hval ((wcSliceRes V ℓ Vo).map w)).trans
      ((congrArg (fun z => r • (((wcSliceRes V ℓ Vo).obj N).val.map k.op).hom z) htop).trans
        (hval w').symm)

  refine ⟨f, ?_⟩
  show γ ≫ (wcSliceRes V ℓ Vo).map f = h
  have key2 : μ.hom ≫ wcSuppUnitMap DiW ≫ γ ≫ (wcSliceRes V ℓ Vo).map f =
      μ.hom ≫ wcSuppUnitMap DiW ≫ h := by
    rw [reassoc_of% hγ, Iso.hom_inv_id_assoc, ← Functor.map_comp, hf, hRw, hw']
  exact (cancel_epi (wcSuppUnitMap DiW)).mp ((cancel_epi μ.hom).mp key2)

theorem wc_supp_open_excision {T V W : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (i : T ⟶ V) [IsClosedImmersion i] (j : W ⟶ V) [IsOpenImmersion j]
    (iW : T ⟶ W) (hiW : iW ≫ j = i) [IsLocallyNoetherian V]
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (DiW : wcHMPullData iW ℓ) (hDiW : wcHMPullCanonical DiW) (hepi : Epi (wcSuppUnitMap DiW))
    (Dj : wcHMPullData j ℓ) (hDj : wcHMPullCanonical Dj)
    (κ : wcSuppObj DiW ⟶ Dj.Φ.obj (wcSuppObj Di))
    (hκ : wcSuppUnitMap DiW ≫ κ = Dj.μ.inv ≫ Dj.Φ.map (wcSuppUnitMap Di)) (n : ℕ) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf W ℓ)) := HasExt.standard _
    Function.Bijective (fun θ : wcSuppExt Di n =>
      (Abelian.Ext.mk₀ κ).comp (wcSuppPullExt Di Dj n θ) (zero_add _)) :=
by
  classical
  letI instW : HasExt (SheafOfModules.{u+1} (wcRingSheaf W ℓ)) := HasExt.standard _
  letI instV : HasExt (SheafOfModules.{u+1} (wcRingSheaf V ℓ)) := HasExt.standard _

  let Vo : V.ProEt := Scheme.ProEt.mk j
  haveI hVo : IsOpenImmersion Vo.hom := ‹IsOpenImmersion j›
  haveI hG : (wcSliceFunctor V Vo).IsContinuous (Scheme.ProEt.topology Vo.left)
      (Scheme.ProEt.topology V) := by
    haveI h1 := (wc_slice_over_sites_cont V Vo).1
    haveI h0 : (Over.forget Vo).IsContinuous ((Scheme.ProEt.topology V).over Vo)
        (Scheme.ProEt.topology V) := inferInstance
    have h3 : (wcSliceToOver V Vo ⋙ Over.forget Vo).IsContinuous (Scheme.ProEt.topology Vo.left)
        (Scheme.ProEt.topology V) :=
      Functor.isContinuous_comp _ _ _ ((Scheme.ProEt.topology V).over Vo) _
    exact h3

  obtain ⟨Φiso⟩ := wc_hm_pull_Phi_slice_iso V ℓ Vo Dj hDj
  let κ' : wcSuppObj DiW ⟶ (wcSliceRes V ℓ Vo).obj (wcSuppObj Di) :=
    κ ≫ Φiso.hom.app (wcSuppObj Di)
  let μ' : (wcSliceRes V ℓ Vo).obj (SheafOfModules.unit (wcRingSheaf V ℓ)) ≅
      SheafOfModules.unit (wcRingSheaf Vo.left ℓ) :=
    (Φiso.app (SheafOfModules.unit (wcRingSheaf V ℓ))).symm ≪≫ Dj.μ
  have hκ' : wcSuppUnitMap DiW ≫ κ' = μ'.inv ≫ (wcSliceRes V ℓ Vo).map (wcSuppUnitMap Di) := by
    show wcSuppUnitMap DiW ≫ κ ≫ Φiso.hom.app (wcSuppObj Di) =
      (Dj.μ.inv ≫ Φiso.hom.app (SheafOfModules.unit (wcRingSheaf V ℓ))) ≫
        (wcSliceRes V ℓ Vo).map (wcSuppUnitMap Di)
    exact (Category.assoc _ _ _).symm.trans
      ((congrArg (· ≫ Φiso.hom.app (wcSuppObj Di)) hκ).trans
        ((Category.assoc _ _ _).trans
          ((congrArg (Dj.μ.inv ≫ ·) (Φiso.hom.naturality (wcSuppUnitMap Di))).trans
            (Category.assoc _ _ _).symm)))

  have hhom : ∀ Y : SheafOfModules.{u+1} (wcRingSheaf V ℓ),
      Function.Bijective (fun f : wcSuppObj Di ⟶ Y => κ ≫ Dj.Φ.map f) := by
    intro Y
    have hres : Function.Bijective
        (fun f : wcSuppObj Di ⟶ Y => κ' ≫ (wcSliceRes V ℓ Vo).map f) :=
      ⟨wc_open_slice_res_supp_hom_injective i Vo iW hiW Di hDi DiW μ' κ' hκ' Y,
        wc_open_slice_res_supp_hom_surjective i Vo iW hiW Di hDi DiW hepi μ' κ' hκ' Y⟩
    have hpost : Function.Bijective
        (fun g : wcSuppObj DiW ⟶ (wcSliceRes V ℓ Vo).obj Y => g ≫ Φiso.inv.app Y) := by
      refine ⟨fun g₁ g₂ h => ?_, fun g => ⟨g ≫ Φiso.hom.app Y, ?_⟩⟩
      · have h' : (g₁ ≫ Φiso.inv.app Y) ≫ Φiso.hom.app Y =
            (g₂ ≫ Φiso.inv.app Y) ≫ Φiso.hom.app Y :=
          congrArg (fun g => g ≫ Φiso.hom.app Y) h
        exact (Category.comp_id g₁).symm.trans
          ((congrArg (g₁ ≫ ·) (Iso.inv_hom_id_app Φiso Y)).symm.trans
            ((Category.assoc _ _ _).symm.trans
              (h'.trans ((Category.assoc _ _ _).trans
                ((congrArg (g₂ ≫ ·) (Iso.inv_hom_id_app Φiso Y)).trans
                  (Category.comp_id g₂))))))
      · exact (Category.assoc _ _ _).trans
          ((congrArg (g ≫ ·) (Iso.hom_inv_id_app Φiso Y)).trans (Category.comp_id g))
    have heq : (fun f : wcSuppObj Di ⟶ Y => κ ≫ Dj.Φ.map f) =
        (fun g : wcSuppObj DiW ⟶ (wcSliceRes V ℓ Vo).obj Y => g ≫ Φiso.inv.app Y) ∘
          (fun f : wcSuppObj Di ⟶ Y => κ' ≫ (wcSliceRes V ℓ Vo).map f) := by
      funext f
      show κ ≫ Dj.Φ.map f =
        ((κ ≫ Φiso.hom.app (wcSuppObj Di)) ≫ (wcSliceRes V ℓ Vo).map f) ≫ Φiso.inv.app Y
      symm
      calc ((κ ≫ Φiso.hom.app (wcSuppObj Di)) ≫ (wcSliceRes V ℓ Vo).map f) ≫ Φiso.inv.app Y
          = (κ ≫ (Φiso.hom.app (wcSuppObj Di) ≫ (wcSliceRes V ℓ Vo).map f)) ≫
              Φiso.inv.app Y :=
            congrArg (· ≫ Φiso.inv.app Y) (Category.assoc _ _ _)
        _ = (κ ≫ (Dj.Φ.map f ≫ Φiso.hom.app Y)) ≫ Φiso.inv.app Y :=
            congrArg (fun z => (κ ≫ z) ≫ Φiso.inv.app Y) (Φiso.hom.naturality f).symm
        _ = κ ≫ ((Dj.Φ.map f ≫ Φiso.hom.app Y) ≫ Φiso.inv.app Y) := Category.assoc _ _ _
        _ = κ ≫ (Dj.Φ.map f ≫ (Φiso.hom.app Y ≫ Φiso.inv.app Y)) :=
            congrArg (κ ≫ ·) (Category.assoc _ _ _)
        _ = κ ≫ (Dj.Φ.map f ≫ 𝟙 _) :=
            congrArg (fun z => κ ≫ (Dj.Φ.map f ≫ z)) (Iso.hom_inv_id_app Φiso Y)
        _ = κ ≫ Dj.Φ.map f := congrArg (κ ≫ ·) (Category.comp_id _)
    rw [heq]
    exact hpost.comp hres

  have hvan : ∀ (I : SheafOfModules.{u+1} (wcRingSheaf V ℓ)) [Injective I] (k : ℕ)
      (e : Abelian.Ext (wcSuppObj DiW) (Dj.Φ.obj I) (k + 1)), e = 0 := by
    intro I hI k e
    have hRI : Injective ((wcSliceRes V ℓ Vo).obj I) :=
      @wc_open_slice_res_preserves_injective V ℓ _ Vo hVo hG I hI
    haveI : Injective (Dj.Φ.obj I) := Injective.of_iso (Φiso.app I).symm hRI
    exact Abelian.Ext.eq_zero_of_injective e

  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf V ℓ)) :=
    sheafOfModules_enoughInjectives (Scheme.ProEt.topology V) (wcRingSheaf V ℓ)
  haveI := Dj.additive
  haveI := Dj.presLim
  haveI := Dj.presColim
  have hT := ext_transfer_of_corep Dj.Φ (wcSuppObj Di) (wcSuppObj DiW) κ hhom hvan
    (SheafOfModules.unit (wcRingSheaf V ℓ)) n

  have hP : Function.Bijective
      (fun x : Abelian.Ext (wcSuppObj DiW) (Dj.Φ.obj (SheafOfModules.unit (wcRingSheaf V ℓ))) n =>
        x.comp (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero n)) := by
    refine ⟨fun x y h => ?_, fun y => ⟨y.comp (Abelian.Ext.mk₀ Dj.μ.inv) (add_zero n), ?_⟩⟩
    · have h' := congrArg (fun z => z.comp (Abelian.Ext.mk₀ Dj.μ.inv) (add_zero n)) h
      simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
        Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id] at h'
      exact h'
    · simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
        Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
  have hgoal : (fun θ : wcSuppExt Di n =>
      (Abelian.Ext.mk₀ κ).comp (wcSuppPullExt Di Dj n θ) (zero_add _)) =
      (fun x : Abelian.Ext (wcSuppObj DiW) (Dj.Φ.obj (SheafOfModules.unit (wcRingSheaf V ℓ))) n =>
        x.comp (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero n)) ∘
      (fun β : Abelian.Ext (wcSuppObj Di) (SheafOfModules.unit (wcRingSheaf V ℓ)) n =>
        (Abelian.Ext.mk₀ κ).comp (Abelian.Ext.mapExactFunctor Dj.Φ β) (zero_add n)) := by
    funext θ
    show (Abelian.Ext.mk₀ κ).comp ((Abelian.Ext.mapExactFunctor Dj.Φ θ).comp
        (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero n)) (zero_add n) =
      ((Abelian.Ext.mk₀ κ).comp (Abelian.Ext.mapExactFunctor Dj.Φ θ) (zero_add n)).comp
        (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero n)
    exact (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).symm
  rw [hgoal]
  exact hP.comp hT

theorem wc_slice_res_supp_hom_injective (S : Scheme.{u}) {Z Z' : Scheme.{u}} (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (U : S.ProEt)
    [(wcSliceFunctor S U).IsContinuous (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S)]
    (hU : Etale U.hom) (i : Z ⟶ S) [IsClosedImmersion i]
    (i' : Z' ⟶ U.left) (g' : Z' ⟶ Z) (hsq : IsPullback i' g' U.hom i) (hg' : IsIso g')
    (D : wcHMPullData i ℓ) (hD : wcHMPullCanonical D) (hepiD : Epi (wcSuppUnitMap D))
    (D' : wcHMPullData i' ℓ) (hD' : wcHMPullCanonical D')
    (μ : (wcSliceRes S ℓ U).obj (SheafOfModules.unit (wcRingSheaf S ℓ)) ≅
      SheafOfModules.unit (wcRingSheaf U.left ℓ))
    (γ : wcSuppObj D' ⟶ (wcSliceRes S ℓ U).obj (wcSuppObj D))
    (hγ : wcSuppUnitMap D' ≫ γ = μ.inv ≫ (wcSliceRes S ℓ U).map (wcSuppUnitMap D))
    (N : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) :
    Function.Injective (fun f : wcSuppObj D ⟶ N => γ ≫ (wcSliceRes S ℓ U).map f) :=
by
  classical
  haveI : Etale U.hom := hU
  haveI := hepiD
  haveI := hg'

  have hcov : ∀ (Q : S.ProEt) (n : ℕ) (W : Fin n → S.ProEt) (h : ∀ k, W k ⟶ Q),
      (∀ k, IsOpenMap ⇑(h k).left) → (∀ x : ↥Q.left, ∃ k, x ∈ Set.range ⇑(h k).left) →
      Sieve.generate (Presieve.ofArrows W h) ∈ Scheme.ProEt.topology S Q := by
    intro Q n W h hopen hJ
    have hs : ∀ x : Q.left, ∃ j y, (h j).left y = x := by
      intro x
      obtain ⟨j, y, hy⟩ := hJ x
      exact ⟨j, y, hy⟩
    have hw : ∀ k, WeaklyEtale (h k).left := fun k => by
      have h1 : WeaklyEtale ((h k).left ≫ Q.hom) := by
        rw [MorphismProperty.Over.w (h k)]
        exact (W k).prop
      haveI := Q.prop
      exact @WeaklyEtale.of_comp _ _ _ (h k).left Q.hom h1 Q.prop
    have H : Presieve.ofArrows (fun k => (W k).left) (fun k => (h k).left) ∈
        Scheme.proetalePrecoverage.coverings Q.left :=
      ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr (@QuasiCompactCover.of_isOpenMap _ _
        (Scheme.Cover.mkOfCovers (P := ⊤) (Fin n) (fun k => (W k).left) (fun k => (h k).left)
          hs (fun _ => trivial)) _ hopen),
        (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr
          ⟨fun x => by obtain ⟨j, y, hy⟩ := hs x; exact ⟨j, y, hy⟩, hw⟩⟩
    exact Precoverage.generate_mem_toGrothendieck
      (Precoverage.mem_comap_iff.mpr (by rw [Presieve.map_ofArrows]; exact H))

  have sep : ∀ (M : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (W : S.ProEt) (R : Sieve W),
      R ∈ Scheme.ProEt.topology S W → ∀ x : ↑(M.val.obj (Opposite.op W)),
      (∀ (Q : S.ProEt) (g : Q ⟶ W), R.arrows g → (M.val.map g.op).hom x = 0) → x = 0 := by
    intro M W R hR x h
    have hs := ((SheafOfModules.toSheaf _).obj M).cond
    have h2 := (Presheaf.isSheaf_iff_isSheaf_forget (Scheme.ProEt.topology S) _
      (forget AddCommGrpCat.{u+1})).1 hs
    exact (h2.isSeparated W R hR) x 0
      (fun Q g hg => (h Q g hg).trans (map_zero ((M.val.map g.op).hom)).symm)
  intro f₁ f₂ hf
  have hf' : γ ≫ (wcSliceRes S ℓ U).map f₁ = γ ≫ (wcSliceRes S ℓ U).map f₂ := hf
  have hRw : (wcSliceRes S ℓ U).map (wcSuppUnitMap D ≫ f₁) =
      (wcSliceRes S ℓ U).map (wcSuppUnitMap D ≫ f₂) := by
    have key : ∀ f : wcSuppObj D ⟶ N, (wcSliceRes S ℓ U).map (wcSuppUnitMap D ≫ f) =
        μ.hom ≫ wcSuppUnitMap D' ≫ γ ≫ (wcSliceRes S ℓ U).map f := by
      intro f
      rw [Functor.map_comp, reassoc_of% hγ, Iso.hom_inv_id_assoc]
    rw [key, key, hf']
  have hnatw : ∀ (w : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶ N) {P Q : S.ProEt} (h : Q ⟶ P),
      (N.val.map h.op).hom ((w.val.app (Opposite.op P)).hom
        (1 : ↑((wcRingSheaf S ℓ).obj.obj (Opposite.op P)))) =
      (w.val.app (Opposite.op Q)).hom (1 : ↑((wcRingSheaf S ℓ).obj.obj (Opposite.op Q))) := by
    intro w P Q h
    have hn := PresheafOfModules.naturality_apply w.val h.op
      (1 : ↑((wcRingSheaf S ℓ).obj.obj (Opposite.op P)))
    have h1 : ((wcRingSheaf S ℓ).obj.map h.op).hom
        (1 : ↑((wcRingSheaf S ℓ).obj.obj (Opposite.op P))) = 1 := map_one _
    change (w.val.app (Opposite.op Q)).hom (((wcRingSheaf S ℓ).obj.map h.op).hom
      (1 : ↑((wcRingSheaf S ℓ).obj.obj (Opposite.op P)))) = _ at hn
    rw [h1] at hn
    exact hn.symm
  let topU : U.left.ProEt :=
    MorphismProperty.Over.mk ⊤ (𝟙 U.left) (inferInstance : WeaklyEtale (𝟙 U.left))
  let topS : S.ProEt := MorphismProperty.Over.mk ⊤ (𝟙 S) (inferInstance : WeaklyEtale (𝟙 S))
  let V₁ : S.ProEt := (wcSliceFunctor S U).obj topU
  have hV1 : ((wcSuppUnitMap D ≫ f₁).val.app (Opposite.op V₁)).hom
        (1 : ↑((wcRingSheaf S ℓ).obj.obj (Opposite.op V₁))) =
      ((wcSuppUnitMap D ≫ f₂).val.app (Opposite.op V₁)).hom
        (1 : ↑((wcRingSheaf S ℓ).obj.obj (Opposite.op V₁))) := by
    have h := congrArg (fun φ => (φ.val.app (Opposite.op topU)).hom
      (1 : ↑((wcRingSheaf S ℓ).obj.obj (Opposite.op V₁)))) hRw
    exact h

  have hzero : ∀ (Q : S.ProEt), (∀ q : Q.left, Q.hom q ∉ Set.range ⇑i) →
      ∀ f : wcSuppObj D ⟶ N, ((wcSuppUnitMap D ≫ f).val.app (Opposite.op Q)).hom
        (1 : ↑((wcRingSheaf S ℓ).obj.obj (Opposite.op Q))) = 0 := by
    intro Q hQ f
    have hempty : ∀ z : ↥(Limits.pullback Q.hom i), False := by
      intro z
      have e : (Limits.pullback.fst Q.hom i ≫ Q.hom) z =
          (Limits.pullback.snd Q.hom i ≫ i) z := by
        rw [Limits.pullback.condition]
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at e
      exact hQ (Limits.pullback.fst Q.hom i z) ⟨Limits.pullback.snd Q.hom i z, e.symm⟩
    have h0 : ((wcSuppUnitMap D).val.app (Opposite.op Q)).hom
        (1 : ↑((wcRingSheaf S ℓ).obj.obj (Opposite.op Q))) = 0 := by
      change (((wcSuppUnitMap D).val.app (Opposite.op Q)).hom
        (1 : C(↥Q.left, ULift.{u+1} ℚ_[ℓ])) :
          C(↥(Limits.pullback Q.hom i), ULift.{u+1} ℚ_[ℓ])) = 0
      exact ContinuousMap.ext (fun z => (hempty z).elim)
    change (f.val.app (Opposite.op Q)).hom (((wcSuppUnitMap D).val.app (Opposite.op Q)).hom
      (1 : ↑((wcRingSheaf S ℓ).obj.obj (Opposite.op Q)))) = 0
    rw [h0, map_zero]

  have hrange : Set.range ⇑i ⊆ Set.range ⇑U.hom := by
    rintro _ ⟨z, rfl⟩
    obtain ⟨z', hz'⟩ := (Scheme.homeoOfIso (asIso g')).surjective z
    rw [Scheme.homeoOfIso_apply] at hz'
    have hw : (i' ≫ U.hom) z' = (g' ≫ i) z' := by rw [hsq.w]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at hw
    refine ⟨i' z', ?_⟩
    rw [hw, ← hz']
    rfl

  let O : S.Opens := ⟨(Set.range ⇑i)ᶜ, i.isClosedEmbedding.isClosed_range.isOpen_compl⟩
  let OS : S.ProEt := MorphismProperty.Over.mk ⊤ O.ι (inferInstance : WeaklyEtale O.ι)
  let W : Fin 2 → S.ProEt := ![V₁, OS]
  let hW : ∀ k, W k ⟶ topS := fun k =>
    MorphismProperty.Over.homMk (W k).hom (by exact Category.comp_id _) trivial
  have hopen : ∀ k, IsOpenMap ⇑(hW k).left := by
    refine Fin.forall_fin_two.mpr ⟨?_, ?_⟩
    · show IsOpenMap ⇑(𝟙 U.left ≫ U.hom)
      exact (𝟙 U.left ≫ U.hom).isOpenMap
    · show IsOpenMap ⇑O.ι
      exact O.ι.isOpenMap
  have hjs : ∀ x : ↥topS.left, ∃ k, x ∈ Set.range ⇑(hW k).left := by
    intro x
    by_cases hx : x ∈ Set.range ⇑i
    · obtain ⟨v, hv⟩ := hrange hx
      refine ⟨0, v, ?_⟩
      change (𝟙 U.left ≫ U.hom) v = x
      rw [Category.id_comp]
      exact hv
    · refine ⟨1, ⟨x, hx⟩, ?_⟩
      change O.ι ⟨x, hx⟩ = x
      rw [Scheme.Opens.ι_apply]
  have hcovW := hcov topS 2 W hW hopen hjs
  let R : Sieve topS :=
    { arrows := fun {Q} _ => Nonempty (Q ⟶ V₁) ∨ ∀ q : Q.left, Q.hom q ∉ Set.range ⇑i
      downward_closed := fun {Q Q'} {k} hk h' => by
        rcases hk with hk | hk
        · obtain ⟨h⟩ := hk
          exact Or.inl ⟨h' ≫ h⟩
        · right
          intro q hq
          apply hk (h'.left q)
          rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w h']
          exact hq }
  have hR : R ∈ Scheme.ProEt.topology S topS := by
    refine GrothendieckTopology.superset_covering _ ?_ hcovW
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨j⟩
    fin_cases j
    · exact Or.inl ⟨𝟙 V₁⟩
    · refine Or.inr (fun q hq => ?_)
      have hm : O.ι q ∈ Set.range O.ι := ⟨q, rfl⟩
      rw [Scheme.Opens.range_ι] at hm
      exact hm hq
  have htop : ((wcSuppUnitMap D ≫ f₁).val.app (Opposite.op topS)).hom
        (1 : ↑((wcRingSheaf S ℓ).obj.obj (Opposite.op topS))) =
      ((wcSuppUnitMap D ≫ f₂).val.app (Opposite.op topS)).hom
        (1 : ↑((wcRingSheaf S ℓ).obj.obj (Opposite.op topS))) := by
    refine sub_eq_zero.mp (sep N topS R hR _ ?_)
    intro Q k hk
    have hQ : ((wcSuppUnitMap D ≫ f₁).val.app (Opposite.op Q)).hom
          (1 : ↑((wcRingSheaf S ℓ).obj.obj (Opposite.op Q))) =
        ((wcSuppUnitMap D ≫ f₂).val.app (Opposite.op Q)).hom
          (1 : ↑((wcRingSheaf S ℓ).obj.obj (Opposite.op Q))) := by
      rcases hk with hk | hk
      · obtain ⟨h⟩ := hk
        rw [← hnatw _ h, ← hnatw _ h, hV1]
      · rw [hzero Q hk, hzero Q hk]
    rw [map_sub, hnatw, hnatw]
    exact sub_eq_zero.mpr hQ
  have hw : wcSuppUnitMap D ≫ f₁ = wcSuppUnitMap D ≫ f₂ := by
    apply N.unitHomEquiv.injective
    apply Subtype.ext
    funext V
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    obtain ⟨V⟩ := V
    have t : V ⟶ topS :=
      MorphismProperty.Over.homMk V.hom (by exact Category.comp_id _) trivial
    rw [← hnatw _ t, ← hnatw _ t, htop]
  exact (cancel_epi (wcSuppUnitMap D)).mp hw

theorem wc_proet_open_family_covers : ∀ (S : Scheme.{u}) (Q : S.ProEt) (n : ℕ) (W : Fin n → S.ProEt) (h : ∀ k, W k ⟶ Q), (∀ k, IsOpenMap ⇑(h k).left) → (∀ x : ↥Q.left, ∃ k, x ∈ Set.range ⇑(h k).left) → Sieve.generate (Presieve.ofArrows W h) ∈ Scheme.ProEt.topology S Q :=
by
  intro S Q n W h hO hJ
  have hs : ∀ x : Q.left, ∃ j y, (h j).left y = x := by
    intro x; obtain ⟨j, y, hy⟩ := hJ x; exact ⟨j, y, hy⟩
  have hw : ∀ i, WeaklyEtale (h i).left := fun i => by
    have h1 : WeaklyEtale ((h i).left ≫ Q.hom) := by
      rw [MorphismProperty.Over.w (h i)]; exact (W i).prop
    exact @WeaklyEtale.of_comp _ _ _ (h i).left Q.hom h1 Q.prop
  have H : Presieve.ofArrows (fun i => (W i).left) (fun i => (h i).left) ∈
      Scheme.proetalePrecoverage.coverings Q.left :=
    ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr (QuasiCompactCover.of_isOpenMap
      (𝒰 := Scheme.Cover.mkOfCovers (P := ⊤) (Fin n) (fun i => (W i).left) (fun i => (h i).left)
        hs (fun _ => trivial)) (fun i => hO i)),
      (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr
        ⟨fun x => by obtain ⟨j, y, hy⟩ := hs x; exact ⟨j, y, hy⟩, hw⟩⟩
  exact Precoverage.generate_mem_toGrothendieck
    (Precoverage.mem_comap_iff.mpr (by rw [Presieve.map_ofArrows]; exact H))

theorem wc_slice_res_unit_hom_ext (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (V : S.ProEt)
    [(wcSliceFunctor S V).IsContinuous (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)]
    (M : SheafOfModules.{u+1} (wcRingSheaf V.left ℓ))
    (d₁ d₂ : (wcSliceRes S ℓ V).obj (SheafOfModules.unit (wcRingSheaf S ℓ)) ⟶ M)
    (h : (d₁.val.app (Opposite.op (MorphismProperty.Over.mk ⊤ (𝟙 V.left) (inferInstance : WeaklyEtale (𝟙 V.left)) : V.left.ProEt))).hom (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ])) =
      (d₂.val.app (Opposite.op (MorphismProperty.Over.mk ⊤ (𝟙 V.left) (inferInstance : WeaklyEtale (𝟙 V.left)) : V.left.ProEt))).hom (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))) :
    d₁ = d₂ :=
by
  classical
  let top : V.left.ProEt :=
    MorphismProperty.Over.mk ⊤ (𝟙 V.left) (inferInstance : WeaklyEtale (𝟙 V.left))
  let tU : ∀ Q : V.left.ProEt, Q ⟶ top := fun Q =>
    MorphismProperty.Over.homMk Q.hom (by exact Category.comp_id _) trivial
  have key : ∀ (d : (wcSliceRes S ℓ V).obj (SheafOfModules.unit (wcRingSheaf S ℓ)) ⟶ M)
      (Q : V.left.ProEt),
      (d.val.app (Opposite.op Q)).hom (1 : C(↥Q.left, ULift.{u+1} ℚ_[ℓ])) =
        (M.val.map (tU Q).op).hom ((d.val.app (Opposite.op top)).hom
          (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))) := by
    intro d Q
    have hn := PresheafOfModules.naturality_apply d.val (tU Q).op
      (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))
    have h1 : ((wcRingSheaf S ℓ).obj.map ((wcSliceFunctor S V).map (tU Q)).op).hom
        (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ])) = 1 := map_one _
    change (d.val.app (Opposite.op Q)).hom
      (((wcRingSheaf S ℓ).obj.map ((wcSliceFunctor S V).map (tU Q)).op).hom
        (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))) = _ at hn
    rw [h1] at hn
    exact hn
  have H1 : ∀ Q : V.left.ProEt,
      (d₁.val.app (Opposite.op Q)).hom (1 : C(↥Q.left, ULift.{u+1} ℚ_[ℓ])) =
        (d₂.val.app (Opposite.op Q)).hom (1 : C(↥Q.left, ULift.{u+1} ℚ_[ℓ])) := by
    intro Q
    rw [key d₁, key d₂]
    exact congrArg (fun x => (M.val.map (tU Q).op).hom x) h
  apply SheafOfModules.hom_ext
  apply PresheafOfModules.hom_ext
  intro W
  rcases W with ⟨W⟩
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro a
  let a' : ↑((wcRingSheaf V.left ℓ).obj.obj (Opposite.op W)) := a
  let one : ↑(((wcSliceRes S ℓ V).obj (SheafOfModules.unit (wcRingSheaf S ℓ))).val.obj
      (Opposite.op W)) := (1 : C(↥W.left, ULift.{u+1} ℚ_[ℓ]))
  have hsm : a = a' • one := by
    first
      | exact (mul_one a').symm
      | (rw [ModuleCat.restrictScalars.smul_def]; exact (mul_one a').symm)
      | (show a = a' * (1 : C(↥W.left, ULift.{u+1} ℚ_[ℓ])); exact (mul_one _).symm)
  have hlin : ∀ d : (wcSliceRes S ℓ V).obj (SheafOfModules.unit (wcRingSheaf S ℓ)) ⟶ M,
      (d.val.app (Opposite.op W)).hom a = a' • (d.val.app (Opposite.op W)).hom one := by
    intro d
    exact (congrArg (d.val.app (Opposite.op W)).hom hsm).trans
      (map_smul (d.val.app (Opposite.op W)).hom a' one)
  rw [hlin d₁, hlin d₂]
  exact congrArg (fun x => a' • x) (H1 W)

theorem wc_supp_ker_kill_of_vanish {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i] [IsLocallyNoetherian Y]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (D : wcHMPullData i ℓ) (hD : wcHMPullCanonical D)
    (N : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) (w : SheafOfModules.unit (wcRingSheaf Y ℓ) ⟶ N)
    (hw : ∀ V : Y.ProEt, (∀ x : ↥V.left, V.hom x ∉ Set.range i) →
      (w.val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ])) = 0) :
    Limits.kernel.ι (wcSuppUnitMap D) ≫ w = 0 :=
by
  classical

  have vanish : ∀ (V : Y.ProEt) (t : C(↥V.left, ULift.{u+1} ℚ_[ℓ])),
      ((wcSuppUnitMap D).val.app (Opposite.op V)).hom t = 0 →
      ∀ y : ↥V.left, V.hom y ∈ Set.range i → t y = 0 := by
    intro V t h0 y hy
    have hy' : y ∈ Set.range (Limits.pullback.fst V.hom i) := by
      rw [Scheme.Pullback.range_fst]; exact hy
    obtain ⟨z, rfl⟩ := hy'
    obtain ⟨c', hc'⟩ := wc_supp_unit_twist_isUnit D
    have htw := wc_supp_hom_twist_formula D hD (wcSuppUnitMap D) V t
    rw [h0] at htw
    have h1 := congrArg
      (fun φ : C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ]) => φ z) htw
    have h2 := congrArg (fun φ : C(↥Z, ULift.{u+1} ℚ_[ℓ]) =>
      φ ((Limits.pullback.snd V.hom i).base.hom z)) hc'
    simp only [ContinuousMap.mul_apply, ContinuousMap.comp_apply,
      ContinuousMap.one_apply] at h1 h2
    have h1' : (0 : ULift.{u+1} ℚ_[ℓ]) =
        t ((Limits.pullback.fst V.hom i).base.hom z) *
          (wcSuppTwist (wcSuppUnitMap D)) ((Limits.pullback.snd V.hom i).base.hom z) := h1
    show t ((Limits.pullback.fst V.hom i).base.hom z) = 0
    linear_combination (-(c' ((Limits.pullback.snd V.hom i).base.hom z))) * h1' -
      (t ((Limits.pullback.fst V.hom i).base.hom z)) * h2

  have key : ∀ (V : Y.ProEt) (t : C(↥V.left, ULift.{u+1} ℚ_[ℓ])),
      (∀ y : ↥V.left, V.hom y ∈ Set.range i → t y = 0) →
      (w.val.app (Opposite.op V)).hom t = 0 := by
    intro V t ht
    apply wc_proet_module_section_eq_zero_of_affine_covers N V
    intro W gW hWaff
    haveI : IsAffine W.left := hWaff
    haveI : WeaklyEtale W.hom := W.prop
    have htW : ∀ x : ↥W.left, W.hom x ∈ Set.range i → (t.comp gW.left.base.hom) x = 0 := by
      intro x hx
      apply ht
      have e : V.hom (gW.left x) = W.hom x := by
        rw [← MorphismProperty.Over.w gW]; rfl
      rw [e]; exact hx
    obtain ⟨W₀, q, hW₀, hq, hq0, hqr⟩ :=
      wc_affine_zero_locus_weaklyEtale W.left ℓ (t.comp gW.left.base.hom)
    obtain ⟨n, f, hf⟩ := wc_affine_complement_basicOpen_cover i W.left W.hom
    haveI := hq
    let W' : Fin (n + 1) → Y.ProEt :=
      Fin.cases (MorphismProperty.Over.mk ⊤ (q ≫ W.hom) inferInstance)
        (fun k => MorphismProperty.Over.mk ⊤ ((W.left.basicOpen (f k)).ι ≫ W.hom) inferInstance)
    let e : ∀ k, W' k ⟶ W := Fin.cases (motive := fun k => W' k ⟶ W)
      (MorphismProperty.Over.homMk q rfl trivial)
      (fun k => MorphismProperty.Over.homMk (W.left.basicOpen (f k)).ι rfl trivial)
    refine ⟨n + 1, W', e, ?_, ?_, ?_⟩
    · intro k
      induction k using Fin.cases with
      | zero => exact hW₀
      | succ k => exact (isAffineOpen_top W.left).basicOpen (f k)
    · intro x
      by_cases hx : W.hom x ∈ Set.range i
      · exact ⟨0, hqr x (htW x hx)⟩
      · obtain ⟨k, hk⟩ := (hf x).mp hx
        refine ⟨k.succ, ?_⟩
        show x ∈ Set.range (W.left.basicOpen (f k)).ι
        rw [Scheme.Opens.range_ι]
        exact hk
    · intro k
      refine (PresheafOfModules.naturality_apply w.val (e k ≫ gW).op t).symm.trans ?_
      induction k using Fin.cases with
      | zero =>
        have h0 : (t.comp ((e 0 ≫ gW).left.base.hom) : C(↥(W' 0).left, ULift.{u+1} ℚ_[ℓ])) = 0 := by
          ext x
          exact congrArg ULift.down (hq0 x)
        change (w.val.app (Opposite.op (W' 0))).hom
          (t.comp ((e 0 ≫ gW).left.base.hom)) = 0
        refine (congrArg (fun s => (w.val.app (Opposite.op (W' 0))).hom s) h0).trans ?_
        exact map_zero _
      | succ k =>
        have hV : ∀ x : ↥(W' k.succ).left, (W' k.succ).hom x ∉ Set.range i := by
          intro x
          have hx : (W.left.basicOpen (f k)).ι x ∈ (W.left.basicOpen (f k) : Set ↥W.left) := by
            rw [← Scheme.Opens.range_ι]; exact ⟨x, rfl⟩
          exact (hf _).mpr ⟨k, hx⟩
        have hs4 := hw (W' k.succ) hV
        have hsm := (w.val.app (Opposite.op (W' k.succ))).hom.map_smul
          (t.comp ((e k.succ ≫ gW).left.base.hom))
          (1 : C(↥(W' k.succ).left, ULift.{u+1} ℚ_[ℓ]))
        change (w.val.app (Opposite.op (W' k.succ))).hom
          (t.comp ((e k.succ ≫ gW).left.base.hom)) = 0
        refine (congrArg (fun s => (w.val.app (Opposite.op (W' k.succ))).hom s)
          (mul_one (t.comp ((e k.succ ≫ gW).left.base.hom))).symm).trans ?_
        refine hsm.trans ?_
        rw [hs4]
        exact smul_zero _

  apply SheafOfModules.hom_ext
  apply PresheafOfModules.hom_ext
  intro X
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  induction X using Opposite.rec with
  | op V =>
  have hk := congrArg (fun φ => (φ.val.app (Opposite.op V)).hom x)
    (Limits.kernel.condition (wcSuppUnitMap D))
  change ((wcSuppUnitMap D).val.app (Opposite.op V)).hom
    (((Limits.kernel.ι (wcSuppUnitMap D)).val.app (Opposite.op V)).hom x) = 0 at hk
  change (w.val.app (Opposite.op V)).hom
    (((Limits.kernel.ι (wcSuppUnitMap D)).val.app (Opposite.op V)).hom x) = 0
  exact key V _ (vanish V _ hk)

theorem wc_proet_etale_section_compat {X Z Z' : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)] (U : X.ProEt)
    (hU : Etale U.hom) (i : Z ⟶ X) [IsClosedImmersion i] (i' : Z' ⟶ U.left) (g' : Z' ⟶ Z)
    (hsq : IsPullback i' g' U.hom i) (hg' : IsIso g') (N : SheafOfModules.{u+1} (wcRingSheaf X ℓ))
    (t : ↑(N.val.obj (Opposite.op ((wcSliceFunctor X U).obj (MorphismProperty.Over.mk ⊤ (𝟙 U.left) (inferInstance : WeaklyEtale (𝟙 U.left)))))))
    (ht : ∀ (Q : X.ProEt) (a : Q ⟶ (wcSliceFunctor X U).obj (MorphismProperty.Over.mk ⊤ (𝟙 U.left) (inferInstance : WeaklyEtale (𝟙 U.left)))),
      (∀ q : ↥Q.left, Q.hom q ∉ Set.range i) → (N.val.map a.op).hom t = 0)
    (Q : X.ProEt) (a b : Q ⟶ (wcSliceFunctor X U).obj (MorphismProperty.Over.mk ⊤ (𝟙 U.left) (inferInstance : WeaklyEtale (𝟙 U.left)))) :
    (N.val.map a.op).hom t = (N.val.map b.op).hom t :=
by
  classical
  haveI : Etale U.hom := hU
  haveI : IsIso g' := hg'
  haveI : WeaklyEtale Q.hom := Q.prop
  have capp : ∀ {A B C : Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C) (x : A), (f ≫ g) x = g (f x) :=
    fun f g x => Scheme.Hom.comp_apply f g x

  have hP0 : IsPullback (𝟙 Z) (inv g' ≫ i') i U.hom :=
    IsPullback.of_iso hsq.flip (asIso g') (Iso.refl Z) (Iso.refl U.left) (Iso.refl X)
      (by simp) (by simp) (by simp) (by simp)
  obtain ⟨e, hP⟩ : ∃ e : Z ⟶ U.left, IsPullback (𝟙 Z) e i U.hom := ⟨_, hP0⟩
  have hw0 : e ≫ U.hom = i := (hP.toCommSq.w).symm.trans (Category.id_comp i)
  have hP'' : IsPullback (𝟙 Z) e (e ≫ U.hom) U.hom := hw0 ▸ hP

  have s1 : ∀ (v : U.left) (z : Z), U.hom v = i z → v = e z := by
    intro v z h
    obtain ⟨q, hq1, hq2⟩ :=
      Scheme.Pullback.exists_preimage_pullback (f := i) (g := U.hom) z v h.symm
    have h3 : (hP.isoPullback.inv ≫ e) q = Limits.pullback.snd i U.hom q := by
      rw [hP.isoPullback_inv_snd]
    have h4 : (hP.isoPullback.inv ≫ 𝟙 Z) q = Limits.pullback.fst i U.hom q := by
      rw [hP.isoPullback_inv_fst]
    rw [capp] at h3 h4
    have h5 : hP.isoPullback.inv q = z := h4.trans hq1
    rw [← hq2, ← h3, h5]

  have s2 : ∀ (p : ↥(Limits.pullback U.hom U.hom)) (z : Z),
      Limits.pullback.fst U.hom U.hom p = e z → p = Limits.pullback.diagonal U.hom (e z) := by
    intro p z hp
    let κ : Limits.pullback e (Limits.pullback.fst U.hom U.hom) ≅ Z :=
      Limits.pullbackRightPullbackFstIso U.hom U.hom e ≪≫ hP''.isoPullback.symm
    have hb : κ.hom = Limits.pullback.fst e (Limits.pullback.fst U.hom U.hom) := by
      have h1 : hP''.isoPullback.inv = Limits.pullback.fst (e ≫ U.hom) U.hom := by
        rw [← hP''.isoPullback_inv_fst, Category.comp_id]
      show (Limits.pullbackRightPullbackFstIso U.hom U.hom e).hom ≫ hP''.isoPullback.inv = _
      rw [h1, Limits.pullbackRightPullbackFstIso_hom_fst]
    have hinj : ∀ y₁ y₂ : ↥(Limits.pullback e (Limits.pullback.fst U.hom U.hom)),
        Limits.pullback.fst e (Limits.pullback.fst U.hom U.hom) y₁ =
        Limits.pullback.fst e (Limits.pullback.fst U.hom U.hom) y₂ → y₁ = y₂ := by
      intro y₁ y₂ h
      rw [← hb] at h
      calc y₁ = κ.inv (κ.hom y₁) := (Scheme.hom_inv_apply κ y₁).symm
        _ = κ.inv (κ.hom y₂) := by rw [h]
        _ = y₂ := Scheme.hom_inv_apply κ y₂
    obtain ⟨y, hy1, hy2⟩ := Scheme.Pullback.exists_preimage_pullback (f := e)
      (g := Limits.pullback.fst U.hom U.hom) z p hp.symm
    have H : 𝟙 Z ≫ e =
        (e ≫ Limits.pullback.diagonal U.hom) ≫ Limits.pullback.fst U.hom U.hom := by
      rw [Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id, Category.id_comp]
    obtain ⟨y', hy'1, hy'2⟩ : ∃ y' : Z ⟶ Limits.pullback e (Limits.pullback.fst U.hom U.hom),
        y' ≫ Limits.pullback.fst e (Limits.pullback.fst U.hom U.hom) = 𝟙 Z ∧
        y' ≫ Limits.pullback.snd e (Limits.pullback.fst U.hom U.hom) =
          e ≫ Limits.pullback.diagonal U.hom :=
      ⟨Limits.pullback.lift (𝟙 Z) (e ≫ Limits.pullback.diagonal U.hom) H,
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have h3 : (y' ≫ Limits.pullback.fst e (Limits.pullback.fst U.hom U.hom)) z = (𝟙 Z) z := by
      rw [hy'1]
    have h4 : (y' ≫ Limits.pullback.snd e (Limits.pullback.fst U.hom U.hom)) z =
        (e ≫ Limits.pullback.diagonal U.hom) z := by
      rw [hy'2]
    rw [capp] at h3
    rw [capp, capp] at h4
    have hyy : y = y' z := hinj _ _ (hy1.trans h3.symm)
    rw [← hy2, hyy]
    exact h4
  obtain ⟨α, hαdef⟩ : ∃ α : Q.left ⟶ U.left, α = a.left := ⟨a.left, rfl⟩
  obtain ⟨β, hβdef⟩ : ∃ β : Q.left ⟶ U.left, β = b.left := ⟨b.left, rfl⟩
  have ha : α ≫ U.hom = Q.hom := by
    rw [hαdef]
    exact (congrArg (fun k => a.left ≫ k) (Category.id_comp U.hom)).symm.trans
      (MorphismProperty.Over.w a)
  have hb : β ≫ U.hom = Q.hom := by
    rw [hβdef]
    exact (congrArg (fun k => b.left ≫ k) (Category.id_comp U.hom)).symm.trans
      (MorphismProperty.Over.w b)
  obtain ⟨π, hπ1, hπ2⟩ : ∃ π : Q.left ⟶ Limits.pullback U.hom U.hom,
      π ≫ Limits.pullback.fst U.hom U.hom = α ∧
        π ≫ Limits.pullback.snd U.hom U.hom = β :=
    ⟨Limits.pullback.lift α β (ha.trans hb.symm), Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩
  let E : Q.left.Opens := ⟨π ⁻¹' Set.range (Limits.pullback.diagonal U.hom),
    ((Limits.pullback.diagonal U.hom).isOpenEmbedding.isOpen_range).preimage π.continuous⟩
  have hEagr : E.ι ≫ α = E.ι ≫ β := by
    have hsubr : Set.range (E.ι ≫ π) ⊆ Set.range (Limits.pullback.diagonal U.hom) := by
      rintro _ ⟨w, rfl⟩
      have hw : E.ι w = w.1 := Scheme.Opens.ι_apply E w
      obtain ⟨y, hy⟩ := w.2
      exact ⟨y, hy.trans ((congrArg π hw).symm.trans (capp _ _ _).symm)⟩
    obtain ⟨m, hm⟩ : ∃ m, m ≫ Limits.pullback.diagonal U.hom = E.ι ≫ π :=
      ⟨_, IsOpenImmersion.lift_fac _ _ hsubr⟩
    have ha' : E.ι ≫ α = m := by
      calc E.ι ≫ α = E.ι ≫ (π ≫ Limits.pullback.fst U.hom U.hom) := by rw [hπ1]
        _ = (E.ι ≫ π) ≫ Limits.pullback.fst U.hom U.hom := (Category.assoc _ _ _).symm
        _ = (m ≫ Limits.pullback.diagonal U.hom) ≫ Limits.pullback.fst U.hom U.hom := by
            rw [hm]
        _ = m := by rw [Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
    have hb' : E.ι ≫ β = m := by
      calc E.ι ≫ β = E.ι ≫ (π ≫ Limits.pullback.snd U.hom U.hom) := by rw [hπ2]
        _ = (E.ι ≫ π) ≫ Limits.pullback.snd U.hom U.hom := (Category.assoc _ _ _).symm
        _ = (m ≫ Limits.pullback.diagonal U.hom) ≫ Limits.pullback.snd U.hom U.hom := by
            rw [hm]
        _ = m := by rw [Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id]
    rw [ha', hb']
  have hZ : IsClosed (Set.range i) := i.isClosedEmbedding.isClosed_range
  let U₀ : Q.left.Opens :=
    ⟨Q.hom ⁻¹' (Set.range i)ᶜ, hZ.isOpen_compl.preimage Q.hom.continuous⟩
  let Ok : Fin 2 → Q.left.Opens := ![E, U₀]
  let Wf : Fin 2 → X.ProEt := fun k =>
    MorphismProperty.Over.mk ⊤ ((Ok k).ι ≫ Q.hom) inferInstance
  let hk : ∀ k, Wf k ⟶ Q := fun k => MorphismProperty.Over.homMk (Ok k).ι rfl trivial
  have hopen : ∀ k, IsOpenMap ⇑(hk k).left := fun k => (Ok k).ι.isOpenMap
  have hjs : ∀ x : ↥Q.left, ∃ k, x ∈ Set.range ⇑(hk k).left := by
    intro x
    by_cases hx : Q.hom x ∈ Set.range i
    · obtain ⟨z, hz⟩ := hx
      have h1 : α x = e z := by
        apply s1 _ z
        have he : (α ≫ U.hom) x = Q.hom x := by rw [ha]
        rw [capp] at he
        rw [he]
        exact hz.symm
      have h2 : Limits.pullback.fst U.hom U.hom (π x) = e z := by
        have he : (π ≫ Limits.pullback.fst U.hom U.hom) x = α x := by rw [hπ1]
        rw [capp] at he
        rw [he, h1]
      have hxE : x ∈ E := by
        show π x ∈ Set.range (Limits.pullback.diagonal U.hom)
        exact ⟨_, (s2 (π x) z h2).symm⟩
      exact ⟨0, (⟨x, hxE⟩ : ↥E), Scheme.Opens.ι_apply E ⟨x, hxE⟩⟩
    · have hxU : x ∈ U₀ := hx
      exact ⟨1, (⟨x, hxU⟩ : ↥U₀), Scheme.Opens.ι_apply U₀ ⟨x, hxU⟩⟩


  have opencov : ∀ (S : Scheme.{u}) (Q : S.ProEt) (n : ℕ) (W : Fin n → S.ProEt)
      (h : ∀ k, W k ⟶ Q), (∀ k, IsOpenMap ⇑(h k).left) →
      (∀ x : ↥Q.left, ∃ k, x ∈ Set.range ⇑(h k).left) →
      Sieve.generate (Presieve.ofArrows W h) ∈ Scheme.ProEt.topology S Q := by
    intro S Q n W h hO hJ
    have hs : ∀ x : Q.left, ∃ j y, (h j).left y = x := by
      intro x; obtain ⟨j, y, hy⟩ := hJ x; exact ⟨j, y, hy⟩
    have hw : ∀ i, WeaklyEtale (h i).left := fun i => by
      have h1 : WeaklyEtale ((h i).left ≫ Q.hom) := by
        rw [MorphismProperty.Over.w (h i)]; exact (W i).prop
      exact @WeaklyEtale.of_comp _ _ _ (h i).left Q.hom h1 Q.prop
    have H : Presieve.ofArrows (fun i => (W i).left) (fun i => (h i).left) ∈
        Scheme.proetalePrecoverage.coverings Q.left :=
      ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr (QuasiCompactCover.of_isOpenMap
        (𝒰 := Scheme.Cover.mkOfCovers (P := ⊤) (Fin n) (fun i => (W i).left) (fun i => (h i).left)
          hs (fun _ => trivial)) (fun i => hO i)),
        (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr
          ⟨fun x => by obtain ⟨j, y, hy⟩ := hs x; exact ⟨j, y, hy⟩, hw⟩⟩
    exact Precoverage.generate_mem_toGrothendieck
      (Precoverage.mem_comap_iff.mpr (by rw [Presieve.map_ofArrows]; exact H))
  have hcov := opencov X Q 2 Wf hk hopen hjs
  let S : Sieve Q :=
    { arrows := fun W' g => g.left ≫ α = g.left ≫ β ∨
        ∀ w : W'.left, W'.hom w ∉ Set.range i
      downward_closed := by
        intro W' W'' g hg h
        have hw : h.left ≫ W'.hom = W''.hom := MorphismProperty.Over.w h
        rcases hg with hg | hmiss
        · left
          show (h.left ≫ g.left) ≫ α = (h.left ≫ g.left) ≫ β
          rw [Category.assoc, Category.assoc, hg]
        · right
          intro w hw'
          apply hmiss (h.left w)
          have he : W'.hom (h.left w) = W''.hom w := by
            rw [← hw, Scheme.Hom.comp_apply]
          rw [he]
          exact hw' }
  have hS0 : S.arrows (hk 0) := Or.inl hEagr
  have hS1 : S.arrows (hk 1) := by
    right
    show ∀ w : ↥(U₀ : Scheme.{u}), (U₀.ι ≫ Q.hom) w ∉ Set.range i
    intro w h
    have hw : U₀.ι w = w.1 := Scheme.Opens.ι_apply U₀ w
    have heq : (U₀.ι ≫ Q.hom) w = Q.hom w.1 := (capp U₀.ι Q.hom w).trans (congrArg Q.hom hw)
    have h' : Q.hom w.1 ∈ Set.range i := by rw [← heq]; exact h
    exact w.2 h'
  have hS : S ∈ Scheme.ProEt.topology X Q := by
    refine GrothendieckTopology.superset_covering _ ?_ hcov
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨k⟩
    exact (Fin.forall_fin_two.mpr ⟨hS0, hS1⟩ : ∀ k : Fin 2, S.arrows (hk k)) k

  have sep : ∀ (W : X.ProEt) (R : Sieve W), R ∈ Scheme.ProEt.topology X W →
      ∀ x : ↑(N.val.obj (Opposite.op W)),
      (∀ (Q' : X.ProEt) (k : Q' ⟶ W), R.arrows k → (N.val.map k.op).hom x = 0) → x = 0 := by
    intro W R hR x h
    have hs := ((SheafOfModules.toSheaf _).obj N).cond
    have h2 := (Presheaf.isSheaf_iff_isSheaf_forget (Scheme.ProEt.topology X) _
      (forget AddCommGrpCat.{u+1})).1 hs
    exact (h2.isSeparated W R hR) x 0
      (fun Q' k hk => (h Q' k hk).trans (map_zero ((N.val.map k.op).hom)).symm)
  obtain ⟨ta, hta⟩ : ∃ ta : ↑(N.val.obj (Opposite.op Q)), ta = (N.val.map a.op).hom t :=
    ⟨_, rfl⟩
  obtain ⟨tb, htb⟩ : ∃ tb : ↑(N.val.obj (Opposite.op Q)), tb = (N.val.map b.op).hom t :=
    ⟨_, rfl⟩
  have hx := sep Q S hS (ta - tb) (by
    intro W' k hk
    have e1 : (N.val.map (k ≫ a).op).hom t = (N.val.map k.op).hom ta := by
      rw [hta, op_comp, PresheafOfModules.map_comp_apply]
    have e2 : (N.val.map (k ≫ b).op).hom t = (N.val.map k.op).hom tb := by
      rw [htb, op_comp, PresheafOfModules.map_comp_apply]
    have key : (N.val.map k.op).hom ta = (N.val.map k.op).hom tb := by
      rcases hk with h | h
      · rw [hαdef, hβdef] at h
        have hkab : k ≫ a = k ≫ b := MorphismProperty.Over.Hom.ext (by exact h)
        rw [← e1, ← e2, hkab]
      · have h1 := ht W' (k ≫ a) h
        have h2 := ht W' (k ≫ b) h
        rw [← e1, ← e2]
        exact h1.trans h2.symm
    exact (map_sub (N.val.map k.op).hom ta tb).trans (sub_eq_zero.mpr key))
  have hfin : ta = tb := sub_eq_zero.mp hx
  rw [← hta, ← htb]
  exact hfin

theorem wc_slice_res_supp_hom_surjective (S : Scheme.{u}) {Z Z' : Scheme.{u}} (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (U : S.ProEt)
    [(wcSliceFunctor S U).IsContinuous (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S)]
    (hU : Etale U.hom) (i : Z ⟶ S) [IsClosedImmersion i] [IsLocallyNoetherian S]
    (i' : Z' ⟶ U.left) (g' : Z' ⟶ Z) (hsq : IsPullback i' g' U.hom i) (hg' : IsIso g')
    (D : wcHMPullData i ℓ) (hD : wcHMPullCanonical D) (hepiD : Epi (wcSuppUnitMap D))
    (D' : wcHMPullData i' ℓ) (hD' : wcHMPullCanonical D') (hepi' : Epi (wcSuppUnitMap D'))
    (μ : (wcSliceRes S ℓ U).obj (SheafOfModules.unit (wcRingSheaf S ℓ)) ≅
      SheafOfModules.unit (wcRingSheaf U.left ℓ))
    (γ : wcSuppObj D' ⟶ (wcSliceRes S ℓ U).obj (wcSuppObj D))
    (hγ : wcSuppUnitMap D' ≫ γ = μ.inv ≫ (wcSliceRes S ℓ U).map (wcSuppUnitMap D))
    (N : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) :
    Function.Surjective (fun f : wcSuppObj D ⟶ N => γ ≫ (wcSliceRes S ℓ U).map f) :=
by
  classical
  intro h
  haveI : Epi (wcSuppUnitMap D) := hepiD
  haveI : Epi (wcSuppUnitMap D') := hepi'
  haveI : Etale U.hom := hU
  let topU : U.left.ProEt :=
    MorphismProperty.Over.mk ⊤ (𝟙 U.left) (inferInstance : WeaklyEtale (𝟙 U.left))
  let V₁ : S.ProEt := (wcSliceFunctor S U).obj topU
  let topS : S.ProEt := MorphismProperty.Over.mk ⊤ (𝟙 S) (inferInstance : WeaklyEtale (𝟙 S))

  have hrange : Set.range ⇑i ⊆ Set.range ⇑U.hom := by
    rintro _ ⟨z, rfl⟩
    obtain ⟨z', hz'⟩ := (Scheme.homeoOfIso (asIso g')).surjective z
    rw [Scheme.homeoOfIso_apply] at hz'
    have hw : (i' ≫ U.hom) z' = (g' ≫ i) z' := by rw [hsq.w]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at hw
    refine ⟨i' z', ?_⟩
    rw [hw, ← hz']
    rfl

  obtain ⟨w', hw'⟩ : ∃ w' : (wcSliceRes S ℓ U).obj (SheafOfModules.unit (wcRingSheaf S ℓ)) ⟶
      (wcSliceRes S ℓ U).obj N, w' = μ.hom ≫ wcSuppUnitMap D' ≫ h := ⟨_, rfl⟩
  obtain ⟨t, ht⟩ : ∃ t : ↑(N.val.obj (Opposite.op V₁)),
      t = (w'.val.app (Opposite.op topU)).hom (1 : C(↥U.left, ULift.{u+1} ℚ_[ℓ])) := ⟨_, rfl⟩

  have hP' : ∀ (Q : S.ProEt) (a : Q ⟶ V₁),
      (∀ q : Q.left, Q.hom q ∉ Set.range ⇑i) → (N.val.map a.op).hom t = 0 := by
    intro Q a hQ
    have ha : a.left ≫ U.hom = Q.hom := by
      have h1 : a.left ≫ (𝟙 U.left ≫ U.hom) = Q.hom := MorphismProperty.Over.w a
      exact (congrArg (fun k => a.left ≫ k) (Category.id_comp U.hom)).symm.trans h1
    have hwe : WeaklyEtale a.left := by
      have h1 : WeaklyEtale (a.left ≫ U.hom) := by rw [ha]; exact Q.prop
      exact @WeaklyEtale.of_comp _ _ _ a.left U.hom h1 U.prop
    let W' : U.left.ProEt := MorphismProperty.Over.mk ⊤ a.left hwe
    let kₐ : W' ⟶ topU :=
      MorphismProperty.Over.homMk a.left (by exact Category.comp_id _) trivial
    let ι : Q ⟶ (wcSliceFunctor S U).obj W' := MorphismProperty.Over.homMk (𝟙 Q.left) (by
        change 𝟙 Q.left ≫ (a.left ≫ U.hom) = Q.hom
        rw [Category.id_comp, ha]) trivial
    have hfac : a = ι ≫ (wcSliceFunctor S U).map kₐ := by
      apply MorphismProperty.Over.Hom.ext
      change a.left = 𝟙 Q.left ≫ a.left
      rw [Category.id_comp]
    have hk : (N.val.map ((wcSliceFunctor S U).map kₐ).op).hom t =
        (w'.val.app (Opposite.op W')).hom (1 : C(↥Q.left, ULift.{u+1} ℚ_[ℓ])) := by
      rw [ht]
      have hn := PresheafOfModules.naturality_apply w'.val kₐ.op
        (1 : C(↥U.left, ULift.{u+1} ℚ_[ℓ]))
      have h1 : ((wcRingSheaf S ℓ).obj.map ((wcSliceFunctor S U).map kₐ).op).hom
          (1 : C(↥U.left, ULift.{u+1} ℚ_[ℓ])) = 1 := map_one _
      change (w'.val.app (Opposite.op W')).hom
        (((wcRingSheaf S ℓ).obj.map ((wcSliceFunctor S U).map kₐ).op).hom
          (1 : C(↥U.left, ULift.{u+1} ℚ_[ℓ]))) = _ at hn
      rw [h1] at hn
      exact hn.symm
    have hempty : ∀ p : ↥(Limits.pullback a.left i'), False := by
      intro p
      have hc0 : Limits.pullback.fst a.left i' ≫ a.left = Limits.pullback.snd a.left i' ≫ i' :=
        Limits.pullback.condition
      have e1 : a.left (Limits.pullback.fst a.left i' p) = i' (Limits.pullback.snd a.left i' p) :=
        (Scheme.Hom.comp_apply _ _ _).symm.trans
          ((congrArg (fun φ : Limits.pullback a.left i' ⟶ U.left => φ p) hc0).trans
            (Scheme.Hom.comp_apply _ _ _))
      have e2 : (a.left ≫ U.hom) (Limits.pullback.fst a.left i' p) =
          Q.hom (Limits.pullback.fst a.left i' p) :=
        congrArg (fun φ : Q.left ⟶ S => φ (Limits.pullback.fst a.left i' p)) ha
      have e3 : (i' ≫ U.hom) (Limits.pullback.snd a.left i' p) =
          (g' ≫ i) (Limits.pullback.snd a.left i' p) :=
        congrArg (fun φ : Z' ⟶ S => φ (Limits.pullback.snd a.left i' p)) hsq.w
      refine hQ (Limits.pullback.fst a.left i' p) ⟨g' (Limits.pullback.snd a.left i' p), ?_⟩
      calc i (g' (Limits.pullback.snd a.left i' p))
          = (g' ≫ i) (Limits.pullback.snd a.left i' p) := (Scheme.Hom.comp_apply _ _ _).symm
        _ = (i' ≫ U.hom) (Limits.pullback.snd a.left i' p) := e3.symm
        _ = U.hom (i' (Limits.pullback.snd a.left i' p)) := Scheme.Hom.comp_apply _ _ _
        _ = U.hom (a.left (Limits.pullback.fst a.left i' p)) :=
          congrArg (fun y => U.hom y) e1.symm
        _ = (a.left ≫ U.hom) (Limits.pullback.fst a.left i' p) :=
          (Scheme.Hom.comp_apply _ _ _).symm
        _ = Q.hom (Limits.pullback.fst a.left i' p) := e2
    have h0 : ((wcSuppUnitMap D').val.app (Opposite.op W')).hom
        ((μ.hom.val.app (Opposite.op W')).hom (1 : C(↥Q.left, ULift.{u+1} ℚ_[ℓ]))) = 0 := by
      change (((wcSuppUnitMap D').val.app (Opposite.op W')).hom
        ((μ.hom.val.app (Opposite.op W')).hom (1 : C(↥Q.left, ULift.{u+1} ℚ_[ℓ]))) :
          C(↥(Limits.pullback a.left i'), ULift.{u+1} ℚ_[ℓ])) = 0
      exact ContinuousMap.ext (fun z => (hempty z).elim)
    have hw0 : (w'.val.app (Opposite.op W')).hom (1 : C(↥Q.left, ULift.{u+1} ℚ_[ℓ])) = 0 := by
      rw [hw']
      change (h.val.app (Opposite.op W')).hom (((wcSuppUnitMap D').val.app (Opposite.op W')).hom
        ((μ.hom.val.app (Opposite.op W')).hom (1 : C(↥Q.left, ULift.{u+1} ℚ_[ℓ])))) = 0
      rw [h0, map_zero]
    rw [hfac, op_comp, PresheafOfModules.map_comp_apply, hk, hw0]
    exact map_zero _

  have hC := wc_proet_etale_section_compat U hU i i' g' hsq hg' N t hP'

  let Sv : Sieve topS :=
    { arrows := fun {Q} _ => Nonempty (Q ⟶ V₁) ∨ ∀ q : Q.left, Q.hom q ∉ Set.range ⇑i
      downward_closed := fun {Q Q'} {k} hk h' => by
        rcases hk with hk | hk
        · obtain ⟨hh⟩ := hk
          exact Or.inl ⟨h' ≫ hh⟩
        · right
          intro q hq
          apply hk (h'.left q)
          rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w h']
          exact hq }
  let O : S.Opens := ⟨(Set.range ⇑i)ᶜ, i.isClosedEmbedding.isClosed_range.isOpen_compl⟩
  let OS : S.ProEt := MorphismProperty.Over.mk ⊤ O.ι inferInstance
  let tU : ∀ Q : S.ProEt, Q ⟶ topS := fun Q =>
    MorphismProperty.Over.homMk Q.hom (by exact Category.comp_id _) trivial
  let Wf : Fin 2 → S.ProEt := ![V₁, OS]
  have hopen : ∀ k, IsOpenMap ⇑(tU (Wf k)).left := by
    refine Fin.forall_fin_two.mpr ⟨?_, ?_⟩
    · show IsOpenMap ⇑(𝟙 U.left ≫ U.hom)
      exact (𝟙 U.left ≫ U.hom).isOpenMap
    · show IsOpenMap ⇑O.ι
      exact O.ι.isOpenMap
  have hjs : ∀ x : ↥topS.left, ∃ k, x ∈ Set.range ⇑(tU (Wf k)).left := by
    intro x
    by_cases hx : x ∈ Set.range ⇑i
    · obtain ⟨v, hv⟩ := hrange hx
      refine ⟨0, v, ?_⟩
      change (𝟙 U.left ≫ U.hom) v = x
      rw [Category.id_comp]
      exact hv
    · refine ⟨1, ⟨x, hx⟩, ?_⟩
      change O.ι ⟨x, hx⟩ = x
      rw [Scheme.Opens.ι_apply]
  have hcov := wc_proet_open_family_covers S topS 2 Wf (fun k => tU (Wf k)) hopen hjs
  have hS0 : Sv.arrows (tU V₁) := Or.inl ⟨𝟙 V₁⟩
  have hS1 : Sv.arrows (tU OS) := by
    right
    intro q hq
    have hm : O.ι q ∈ Set.range O.ι := ⟨q, rfl⟩
    rw [Scheme.Opens.range_ι] at hm
    change O.ι q ∈ Set.range ⇑i at hq
    exact hm hq
  have hSv : Sv ∈ Scheme.ProEt.topology S topS := by
    refine GrothendieckTopology.superset_covering _ ?_ hcov
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨k⟩
    exact (Fin.forall_fin_two.mpr ⟨hS0, hS1⟩ : ∀ k : Fin 2, Sv.arrows (tU (Wf k))) k

  let xf : ∀ Q : S.ProEt, ↑(N.val.obj (Opposite.op Q)) := fun Q =>
    if hQ : Nonempty (Q ⟶ V₁) then (N.val.map hQ.some.op).hom t else 0
  have hxa : ∀ (Q : S.ProEt) (a : Q ⟶ V₁), xf Q = (N.val.map a.op).hom t := by
    intro Q a
    have hne : Nonempty (Q ⟶ V₁) := ⟨a⟩
    simp only [xf]
    exact (dif_pos hne).trans (hC Q _ a)
  have hx0 : ∀ Q : S.ProEt, (∀ q : Q.left, Q.hom q ∉ Set.range ⇑i) → xf Q = 0 := by
    intro Q hQ
    by_cases hne : Nonempty (Q ⟶ V₁)
    · rw [hxa Q hne.some]
      exact hP' Q _ hQ
    · simp only [xf]
      exact dif_neg hne
  have hres : ∀ {Q Q' : S.ProEt} (l : Q' ⟶ Q),
      (Nonempty (Q ⟶ V₁) ∨ ∀ q : Q.left, Q.hom q ∉ Set.range ⇑i) →
      (N.val.map l.op).hom (xf Q) = xf Q' := by
    intro Q Q' l hQ
    rcases hQ with hQ | hQ
    · obtain ⟨a⟩ := hQ
      rw [hxa Q a, hxa Q' (l ≫ a), op_comp, PresheafOfModules.map_comp_apply]
    · have hQ' : ∀ q : Q'.left, Q'.hom q ∉ Set.range ⇑i := by
        intro q hq
        apply hQ (l.left q)
        rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w l]
        exact hq
      rw [hx0 Q hQ, hx0 Q' hQ']
      exact map_zero _

  have hsh := ((SheafOfModules.toSheaf _).obj N).cond
  have h2 := (Presheaf.isSheaf_iff_isSheaf_forget (Scheme.ProEt.topology S) _
    (forget AddCommGrpCat.{u+1})).1 hsh
  have h3 := ((isSheaf_iff_isSheaf_of_type _ _).1 h2) Sv hSv
  let x : Presieve.FamilyOfElements
      (((SheafOfModules.toSheaf _).obj N).val ⋙ forget AddCommGrpCat.{u+1}) Sv.arrows :=
    fun Q _ _ => xf Q
  have hx : x.Compatible := by
    rw [Presieve.compatible_iff_sieveCompatible]
    intro Q Q' k l hk
    exact (hres l hk).symm
  obtain ⟨s, hs⟩ : ∃ s : ↑(N.val.obj (Opposite.op topS)),
      ∀ (Q : S.ProEt) (k : Q ⟶ topS), Sv.arrows k → (N.val.map k.op).hom s = xf Q :=
    ⟨h3.amalgamate x hx, fun Q k hk => h3.valid_glue hx k hk⟩

  have htU : ∀ {Q Q' : S.ProEt} (l : Q' ⟶ Q), l ≫ tU Q = tU Q' := by
    intro Q Q' l
    apply MorphismProperty.Over.Hom.ext
    exact MorphismProperty.Over.w l
  let σ : N.sections := ⟨fun V => (N.val.map (tU V.unop).op).hom s, by
    intro V V' f
    change (N.val.map f).hom ((N.val.map (tU V.unop).op).hom s) =
      (N.val.map (tU V'.unop).op).hom s
    have hU' : (tU V.unop).op ≫ f = (tU V'.unop).op := by
      rw [← htU f.unop, op_comp, Quiver.Hom.op_unop]
    rw [← PresheafOfModules.map_comp_apply, hU']⟩
  obtain ⟨w, hw⟩ : ∃ w : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶ N, N.unitHomEquiv w = σ :=
    ⟨N.unitHomEquiv.symm σ, Equiv.apply_symm_apply _ _⟩
  have hwv : ∀ V : S.ProEt, (w.val.app (Opposite.op V)).hom
      (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ])) = (N.val.map (tU V).op).hom s := by
    intro V
    have e := SheafOfModules.unitHomEquiv_apply_coe N w (Opposite.op V)
    rw [hw] at e
    exact e.symm
  have hid : (N.val.map (𝟙 (Opposite.op V₁))).hom t = t := by
    first
      | (simp; done)
      | (simp; exact rfl)
      | (rw [← PresheafOfModules.presheaf_map_apply_coe, CategoryTheory.Functor.map_id]; rfl)
  have hV1 : (N.val.map (tU V₁).op).hom s = t := by
    rw [hs V₁ (tU V₁) hS0, hxa _ (𝟙 _), op_id]
    exact hid

  have hker : Limits.kernel.ι (wcSuppUnitMap D) ≫ w = 0 := by
    apply wc_supp_ker_kill_of_vanish i ℓ D hD N w
    intro V hV
    rw [hwv V, hs V (tU V) (Or.inr hV), hx0 V hV]
  let f := Abelian.epiDesc (wcSuppUnitMap D) w hker
  have hf : wcSuppUnitMap D ≫ f = w := Abelian.comp_epiDesc _ _ _

  have hRw : (wcSliceRes S ℓ U).map w = w' := by
    apply wc_slice_res_unit_hom_ext S ℓ U
    refine Eq.trans ?_ ht
    exact (hwv V₁).trans hV1

  refine ⟨f, ?_⟩
  show γ ≫ (wcSliceRes S ℓ U).map f = h
  have key : μ.hom ≫ wcSuppUnitMap D' ≫ γ ≫ (wcSliceRes S ℓ U).map f =
      μ.hom ≫ wcSuppUnitMap D' ≫ h := by
    rw [reassoc_of% hγ, Iso.hom_inv_id_assoc, ← Functor.map_comp, hf, hRw, hw']
  exact (cancel_epi (wcSuppUnitMap D')).mp ((cancel_epi μ.hom).mp key)

theorem wc_supp_etale_excision_surj {T V T' W : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (i : T ⟶ V) [IsClosedImmersion i] (e : W ⟶ V) (he : Etale e)
    (i' : T' ⟶ W) (g' : T' ⟶ T) (hsq : IsPullback i' g' e i) (hg' : IsIso g')
    [IsLocallyNoetherian V] [IsLocallyNoetherian W]
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (Di' : wcHMPullData i' ℓ) (hDi' : wcHMPullCanonical Di') (hepi : Epi (wcSuppUnitMap Di'))
    (De : wcHMPullData e ℓ) (hDe : wcHMPullCanonical De)
    (κ : wcSuppObj Di' ⟶ De.Φ.obj (wcSuppObj Di))
    (hκ : wcSuppUnitMap Di' ≫ κ = De.μ.inv ≫ De.Φ.map (wcSuppUnitMap Di)) (n : ℕ) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf W ℓ)) := HasExt.standard _
    Function.Surjective (fun θ : wcSuppExt Di n =>
      (Abelian.Ext.mk₀ κ).comp (wcSuppPullExt Di De n θ) (zero_add _)) :=
by
  classical
  haveI : Etale e := he
  have hwe : WeaklyEtale e := inferInstance

  suffices main : ∀ (U : V.ProEt) (hU : Etale U.hom) (i₁ : T' ⟶ U.left)
      (hsq₁ : IsPullback i₁ g' U.hom i)
      (Di₁ : wcHMPullData i₁ ℓ) (hDi₁ : wcHMPullCanonical Di₁) (hepi₁ : Epi (wcSuppUnitMap Di₁))
      (De₁ : wcHMPullData (S := V) (S' := U.left) U.hom ℓ) (hDe₁ : wcHMPullCanonical De₁)
      (κ₁ : wcSuppObj Di₁ ⟶ De₁.Φ.obj (wcSuppObj Di))
      (hκ₁ : wcSuppUnitMap Di₁ ≫ κ₁ = De₁.μ.inv ≫ De₁.Φ.map (wcSuppUnitMap Di)),
      letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf U.left ℓ)) := HasExt.standard _
      Function.Surjective (fun θ : wcSuppExt Di n =>
        (Abelian.Ext.mk₀ κ₁).comp (wcSuppPullExt Di De₁ n θ) (zero_add _)) from
    main (MorphismProperty.Over.mk ⊤ e hwe) he i' hsq Di' hDi' hepi De hDe κ hκ
  intro U hU i₁ hsq₁ Di₁ hDi₁ hepi₁ De₁ hDe₁ κ₁ hκ₁
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf U.left ℓ)) := HasExt.standard _
  haveI := De₁.additive
  haveI := De₁.presLim
  haveI := De₁.presColim
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf V ℓ)) :=
    sheafOfModules_enoughInjectives (Scheme.ProEt.topology V) (wcRingSheaf V ℓ)
  haveI hσ : (wcSliceToOver V U).IsContinuous (Scheme.ProEt.topology U.left)
      ((Scheme.ProEt.topology V).over U) := (wc_slice_over_sites_cont V U).1
  haveI hj : (wcSliceFunctor V U).IsContinuous (Scheme.ProEt.topology U.left)
      (Scheme.ProEt.topology V) := by
    have h := Functor.isContinuous_comp (wcSliceToOver V U) (Over.forget U)
      (Scheme.ProEt.topology U.left) ((Scheme.ProEt.topology V).over U) (Scheme.ProEt.topology V)
    exact h

  obtain ⟨θe⟩ := wc_hm_pull_Phi_slice_iso V ℓ U De₁ hDe₁
  have hepiD : Epi (wcSuppUnitMap Di) := wc_supp_unit_epi_of_noetherian i ℓ Di hDi
  let R := wcSliceRes V ℓ U
  let γ' : wcSuppObj Di₁ ⟶ R.obj (wcSuppObj Di) := κ₁ ≫ θe.hom.app (wcSuppObj Di)
  let μ' : R.obj (SheafOfModules.unit (wcRingSheaf V ℓ)) ≅
      SheafOfModules.unit (wcRingSheaf U.left ℓ) :=
    (θe.app (SheafOfModules.unit (wcRingSheaf V ℓ))).symm ≪≫ De₁.μ
  have hnat : ∀ {A B : SheafOfModules.{u+1} (wcRingSheaf V ℓ)} (f : A ⟶ B),
      De₁.Φ.map f ≫ θe.hom.app B = θe.hom.app A ≫ R.map f := fun f => θe.hom.naturality f
  have hnat' : ∀ {A B : SheafOfModules.{u+1} (wcRingSheaf V ℓ)} (f : A ⟶ B),
      R.map f ≫ θe.inv.app B = θe.inv.app A ≫ De₁.Φ.map f := fun f => θe.inv.naturality f
  have hγ' : wcSuppUnitMap Di₁ ≫ γ' = μ'.inv ≫ R.map (wcSuppUnitMap Di) := by
    calc wcSuppUnitMap Di₁ ≫ γ' = (wcSuppUnitMap Di₁ ≫ κ₁) ≫ θe.hom.app (wcSuppObj Di) :=
          (Category.assoc _ _ _).symm
      _ = (De₁.μ.inv ≫ De₁.Φ.map (wcSuppUnitMap Di)) ≫ θe.hom.app (wcSuppObj Di) := by rw [hκ₁]
      _ = De₁.μ.inv ≫ (De₁.Φ.map (wcSuppUnitMap Di) ≫ θe.hom.app (wcSuppObj Di)) :=
          Category.assoc _ _ _
      _ = De₁.μ.inv ≫ (θe.hom.app _ ≫ R.map (wcSuppUnitMap Di)) := by rw [hnat]
      _ = μ'.inv ≫ R.map (wcSuppUnitMap Di) := (Category.assoc _ _ _).symm

  have hhom : ∀ N : SheafOfModules.{u+1} (wcRingSheaf V ℓ),
      Function.Bijective (fun f : wcSuppObj Di ⟶ N => κ₁ ≫ De₁.Φ.map f) := by
    intro N
    have hinj := wc_slice_res_supp_hom_injective V ℓ U hU i i₁ g' hsq₁ hg' Di hDi hepiD
      Di₁ hDi₁ μ' γ' hγ' N
    have hsurj := wc_slice_res_supp_hom_surjective V ℓ U hU i i₁ g' hsq₁ hg' Di hDi hepiD
      Di₁ hDi₁ hepi₁ μ' γ' hγ' N
    have hhi : ∀ (A : SheafOfModules.{u+1} (wcRingSheaf V ℓ)),
        θe.hom.app A ≫ θe.inv.app A = 𝟙 _ := fun A => θe.hom_inv_id_app A
    have hih : ∀ (A : SheafOfModules.{u+1} (wcRingSheaf V ℓ)),
        θe.inv.app A ≫ θe.hom.app A = 𝟙 _ := fun A => θe.inv_hom_id_app A
    have hfac : ∀ f : wcSuppObj Di ⟶ N,
        κ₁ ≫ De₁.Φ.map f = (γ' ≫ R.map f) ≫ θe.inv.app N := by
      intro f
      calc κ₁ ≫ De₁.Φ.map f = κ₁ ≫ (𝟙 _ ≫ De₁.Φ.map f) := by rw [Category.id_comp]
        _ = κ₁ ≫ ((θe.hom.app (wcSuppObj Di) ≫ θe.inv.app (wcSuppObj Di)) ≫ De₁.Φ.map f) := by
            rw [hhi]
        _ = κ₁ ≫ (θe.hom.app (wcSuppObj Di) ≫ (θe.inv.app (wcSuppObj Di) ≫ De₁.Φ.map f)) := by
            rw [Category.assoc]
        _ = κ₁ ≫ (θe.hom.app (wcSuppObj Di) ≫ (R.map f ≫ θe.inv.app N)) := by rw [hnat']
        _ = (γ' ≫ R.map f) ≫ θe.inv.app N := by
            simp only [γ', Category.assoc]
    have hcanc : ∀ a b : wcSuppObj Di₁ ⟶ R.obj N,
        a ≫ θe.inv.app N = b ≫ θe.inv.app N → a = b := by
      intro a b hab
      calc a = a ≫ 𝟙 _ := (Category.comp_id a).symm
        _ = a ≫ (θe.inv.app N ≫ θe.hom.app N) := by rw [hih]
        _ = (a ≫ θe.inv.app N) ≫ θe.hom.app N := (Category.assoc _ _ _).symm
        _ = (b ≫ θe.inv.app N) ≫ θe.hom.app N := by rw [hab]
        _ = b ≫ (θe.inv.app N ≫ θe.hom.app N) := Category.assoc _ _ _
        _ = b ≫ 𝟙 _ := by rw [hih]
        _ = b := Category.comp_id b
    refine ⟨fun f₁ f₂ h => hinj (hcanc _ _ ?_), fun h => ?_⟩
    · have h' : κ₁ ≫ De₁.Φ.map f₁ = κ₁ ≫ De₁.Φ.map f₂ := h
      rw [hfac, hfac] at h'
      exact h'
    · obtain ⟨f, hf⟩ := hsurj (h ≫ θe.hom.app N)
      refine ⟨f, ?_⟩
      have hf' : γ' ≫ R.map f = h ≫ θe.hom.app N := hf
      show κ₁ ≫ De₁.Φ.map f = h
      calc κ₁ ≫ De₁.Φ.map f = (γ' ≫ R.map f) ≫ θe.inv.app N := hfac f
        _ = (h ≫ θe.hom.app N) ≫ θe.inv.app N := by rw [hf']
        _ = h ≫ (θe.hom.app N ≫ θe.inv.app N) := Category.assoc _ _ _
        _ = h ≫ 𝟙 _ := by rw [hhi]
        _ = h := Category.comp_id h

  have hvan : ∀ (I : SheafOfModules.{u+1} (wcRingSheaf V ℓ)) [Injective I] (k : ℕ)
      (x : Abelian.Ext (wcSuppObj Di₁) (De₁.Φ.obj I) (k + 1)), x = 0 := by
    intro I _ k x
    have hRI : Injective (R.obj I) := wc_slice_res_preserves_injective V ℓ U I
    haveI : Injective (De₁.Φ.obj I) := Injective.of_iso (θe.app I).symm hRI
    exact Abelian.Ext.eq_zero_of_injective x

  have hΨ := ext_transfer_of_corep De₁.Φ (wcSuppObj Di) (wcSuppObj Di₁) κ₁ hhom hvan
    (SheafOfModules.unit (wcRingSheaf V ℓ)) n
  have key : ∀ θ : wcSuppExt Di n,
      (Abelian.Ext.mk₀ κ₁).comp (wcSuppPullExt Di De₁ n θ) (zero_add _) =
        ((Abelian.Ext.mk₀ κ₁).comp (Abelian.Ext.mapExactFunctor De₁.Φ θ) (zero_add n)).comp
          (Abelian.Ext.mk₀ De₁.μ.hom) (add_zero n) := by
    intro θ
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero]
    rfl
  intro w
  obtain ⟨θ, hθ⟩ := hΨ.2 (w.comp (Abelian.Ext.mk₀ De₁.μ.inv) (add_zero n))
  refine ⟨θ, ?_⟩
  have hθ' : (Abelian.Ext.mk₀ κ₁).comp (Abelian.Ext.mapExactFunctor De₁.Φ θ) (zero_add n) =
      w.comp (Abelian.Ext.mk₀ De₁.μ.inv) (add_zero n) := hθ
  show (Abelian.Ext.mk₀ κ₁).comp (wcSuppPullExt Di De₁ n θ) (zero_add _) = w
  rw [key θ, hθ', Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
    Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]

theorem wc_tl_zero_section_facts (F : Type u) [Field F] (d : ℕ) {U : Scheme.{u}}
    (qU : U ⟶ Spec (.of (AlgebraicClosure F))) :
    IsClosedImmersion (wcTlZero F d) ∧
    IsClosedImmersion (AffineSpace.homOfVector (𝟙 U) (0 : ULift.{u} (Fin d) → Γ(U, ⊤))) ∧
    IsPullback (AffineSpace.homOfVector (𝟙 U) (0 : ULift.{u} (Fin d) → Γ(U, ⊤))) qU
      (AffineSpace.map (ULift.{u} (Fin d)) qU) (wcTlZero F d) ∧
    (IsLocallyNoetherian U → IsLocallyNoetherian (AffineSpace (ULift.{u} (Fin d)) U)) :=
by
  have hz : ∀ (S : Scheme.{u}), IsClosedImmersion
      (AffineSpace.homOfVector (𝟙 S) (0 : ULift.{u} (Fin d) → Γ(S, ⊤))) := by
    intro S
    haveI : IsClosedImmersion
        (AffineSpace.homOfVector (𝟙 S) (0 : ULift.{u} (Fin d) → Γ(S, ⊤)) ≫
          AffineSpace (ULift.{u} (Fin d)) S ↘ S) := by
      rw [AffineSpace.homOfVector_over]; infer_instance
    exact IsClosedImmersion.of_comp _ (AffineSpace (ULift.{u} (Fin d)) S ↘ S)
  have hcomm : qU ≫ wcTlZero F d =
      AffineSpace.homOfVector (𝟙 U) (0 : ULift.{u} (Fin d) → Γ(U, ⊤)) ≫
        AffineSpace.map (ULift.{u} (Fin d)) qU := by
    apply AffineSpace.hom_ext
    · rw [Category.assoc, Category.assoc, AffineSpace.map_over, ← Category.assoc
        (AffineSpace.homOfVector (𝟙 U) _)]
      simp only [AffineSpace.homOfVector_over, Category.comp_id, Category.id_comp]
    · intro i
      show (qU ≫ AffineSpace.homOfVector (𝟙 (Spec (.of (AlgebraicClosure F))))
          (0 : ULift.{u} (Fin d) → Γ(Spec (.of (AlgebraicClosure F)), ⊤))).appTop _ = _
      simp only [Scheme.Hom.comp_appTop, CommRingCat.comp_apply,
        AffineSpace.homOfVector_appTop_coord, AffineSpace.map_appTop_coord, Pi.zero_apply,
        map_zero]
  refine ⟨hz _, hz U, ?_, ?_⟩
  · have hout : IsPullback qU
        (AffineSpace.homOfVector (𝟙 U) (0 : ULift.{u} (Fin d) → Γ(U, ⊤)) ≫
          AffineSpace (ULift.{u} (Fin d)) U ↘ U)
        (wcTlZero F d ≫ AffineSpace (ULift.{u} (Fin d)) (Spec (.of (AlgebraicClosure F))) ↘
          Spec (.of (AlgebraicClosure F))) qU := by
      show IsPullback qU
        (AffineSpace.homOfVector (𝟙 U) (0 : ULift.{u} (Fin d) → Γ(U, ⊤)) ≫
          AffineSpace (ULift.{u} (Fin d)) U ↘ U)
        (AffineSpace.homOfVector (𝟙 (Spec (.of (AlgebraicClosure F))))
          (0 : ULift.{u} (Fin d) → Γ(Spec (.of (AlgebraicClosure F)), ⊤)) ≫
          AffineSpace (ULift.{u} (Fin d)) (Spec (.of (AlgebraicClosure F))) ↘
          Spec (.of (AlgebraicClosure F))) qU
      rw [AffineSpace.homOfVector_over, AffineSpace.homOfVector_over]
      exact IsPullback.id_vert qU
    exact (IsPullback.of_bot hout hcomm (AffineSpace.isPullback_map qU)).flip
  · intro h
    exact LocallyOfFiniteType.isLocallyNoetherian (AffineSpace (ULift.{u} (Fin d)) U ↘ U)

theorem wc_tl_zero_section_purity_dim0 (F : Type u) [Finite F] [Field F] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hℓ : ¬ ℓ ∣ Nat.card F)
    {U : Scheme.{u}} (qU : U ⟶ Spec (.of (AlgebraicClosure F)))
    [IsLocallyNoetherian U] [CompactSpace U] [PreconnectedSpace U]
    [LocallyOfFiniteType qU] [Smooth qU]
    (D0 : wcHMPullData (wcTlZero F 0) ℓ) (hD0 : wcHMPullCanonical D0)
    (DZ : wcHMPullData (AffineSpace.homOfVector (𝟙 U) (0 : ULift.{u} (Fin 0) → Γ(U, ⊤))) ℓ)
    (hDZ : wcHMPullCanonical DZ) (hepi : Epi (wcSuppUnitMap DZ))
    (Dpr : wcHMPullData (AffineSpace.map (ULift.{u} (Fin 0)) qU) ℓ) (hDpr : wcHMPullCanonical Dpr)
    (γ : wcSuppObj DZ ⟶ Dpr.Φ.obj (wcSuppObj D0))
    (hγ : wcSuppUnitMap DZ ≫ γ = Dpr.μ.inv ≫ Dpr.Φ.map (wcSuppUnitMap D0)) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (AffineSpace (ULift.{u} (Fin 0)) U) ℓ)) :=
      HasExt.standard _
    Function.Surjective (fun τ : wcSuppExt D0 (2 * 0) =>
      (Abelian.Ext.mk₀ γ).comp (wcSuppPullExt D0 Dpr (2 * 0) τ) (zero_add _)) :=
by
  classical

  have s1 : ∀ {S : Scheme.{u}} (v : ULift.{u} (Fin 0) → Γ(S, ⊤)),
      IsIso (AffineSpace.homOfVector (𝟙 S) v) := by
    intro S v
    refine ⟨⟨AffineSpace (ULift.{u} (Fin 0)) S ↘ S, AffineSpace.homOfVector_over _ _, ?_⟩⟩
    apply AffineSpace.hom_ext
    · rw [Category.assoc, AffineSpace.homOfVector_over, Category.comp_id, Category.id_comp]
    · intro i
      exact i.down.elim0

  have s2 : ∀ {X Y : Scheme.{u}} (i : X ⟶ Y) [IsIso i] (D : wcHMPullData i ℓ),
      wcHMPullCanonical D → Epi (wcSuppUnitMap D) → IsIso (wcSuppUnitMap D) := by
    intro X Y i _ D hD hep
    obtain ⟨c', hc'⟩ := wc_supp_unit_twist_isUnit D
    have hinj : ∀ (V : Y.ProEt) (t : C(↥V.left, ULift.{u+1} ℚ_[ℓ])),
        ((wcSuppUnitMap D).val.app (Opposite.op V)).hom t = 0 → t = 0 := by
      intro V t ht
      have ht' : t.comp (Limits.pullback.fst V.hom i).base.hom *
          (wcSuppTwist (wcSuppUnitMap D)).comp (Limits.pullback.snd V.hom i).base.hom = 0 := by
        rw [← wc_supp_hom_twist_formula D hD]
        exact ht
      have h2 : t.comp (Limits.pullback.fst V.hom i).base.hom = 0 := by
        have h3 := congrArg (· * c'.comp (Limits.pullback.snd V.hom i).base.hom) ht'
        simp only [zero_mul] at h3
        rw [mul_assoc, ← ContinuousMap.mul_comp, hc', ContinuousMap.one_comp, mul_one] at h3
        exact h3
      haveI := Limits.pullback_fst_iso_of_right_iso V.hom i
      have key : ∀ y, t ((Limits.pullback.fst V.hom i) y) = 0 := fun y => DFunLike.congr_fun h2 y
      refine ContinuousMap.ext fun x => ?_
      have hx : (Limits.pullback.fst V.hom i) ((inv (Limits.pullback.fst V.hom i)) x) = x :=
        Scheme.inv_hom_apply (asIso (Limits.pullback.fst V.hom i)) x
      rw [← hx]
      exact key _
    haveI : Mono (wcSuppUnitMap D) := by
      apply Preadditive.mono_of_cancel_zero
      intro P g hg
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro V
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro s
      have h1 : ((wcSuppUnitMap D).val.app V).hom ((g.val.app V).hom s) = 0 := by
        have := congrArg (fun k => (k.val.app V).hom s) hg
        refine this.trans ?_
        first
          | rfl
          | simp [PresheafOfModules.zero_app]
      have h4 := hinj V.unop _ h1
      refine h4.trans ?_
      first
        | rfl
        | simp
    exact isIso_of_mono_of_epi _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (AffineSpace (ULift.{u} (Fin 0)) U) ℓ)) :=
    HasExt.standard _

  haveI hzU : IsIso (AffineSpace.homOfVector (𝟙 U) (0 : ULift.{u} (Fin 0) → Γ(U, ⊤))) := s1 _
  haveI : PreconnectedSpace ↥(AffineSpace (ULift.{u} (Fin 0)) U) := by
    have hr : Set.range (AffineSpace.homOfVector (𝟙 U) (0 : ULift.{u} (Fin 0) → Γ(U, ⊤))) =
        Set.univ := by
      apply Set.eq_univ_of_forall
      intro y
      exact ⟨(inv (AffineSpace.homOfVector (𝟙 U) (0 : ULift.{u} (Fin 0) → Γ(U, ⊤)))) y,
        Scheme.inv_hom_apply
          (asIso (AffineSpace.homOfVector (𝟙 U) (0 : ULift.{u} (Fin 0) → Γ(U, ⊤)))) y⟩
    exact ⟨by
      rw [← hr]
      exact isPreconnected_range
        (AffineSpace.homOfVector (𝟙 U) (0 : ULift.{u} (Fin 0) → Γ(U, ⊤))).continuous⟩

  haveI : IsIso (wcTlZero F 0) := s1 _
  obtain ⟨h0ci, -, -, hAn⟩ := wc_tl_zero_section_facts F 0 (𝟙 (Spec (.of (AlgebraicClosure F))))
  haveI := h0ci
  haveI : IsLocallyNoetherian (wcTlAff F 0) := hAn inferInstance
  have hepiK := wc_supp_unit_epi_of_noetherian (wcTlZero F 0) ℓ D0 hD0
  haveI hisoK : IsIso (wcSuppUnitMap D0) := s2 (wcTlZero F 0) D0 hD0 hepiK

  show Function.Surjective _
  intro β
  haveI := hepi
  obtain ⟨f, rfl⟩ : ∃ f : wcSuppObj DZ ⟶
      SheafOfModules.unit (wcRingSheaf (AffineSpace (ULift.{u} (Fin 0)) U) ℓ),
      Abelian.Ext.mk₀ f = β := ⟨_, Abelian.Ext.mk₀_homEquiv₀_apply β⟩
  obtain ⟨c, hc⟩ := wc_hm_unit_end_const (AffineSpace (ULift.{u} (Fin 0)) U) ℓ
    (wcSuppUnitMap DZ ≫ f)
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcTlAff F 0) ℓ)) := HasExt.standard _
  refine ⟨Abelian.Ext.mk₀ (inv (wcSuppUnitMap D0) ≫
    wcHMConst (wcTlAff F 0) ℓ c), ?_⟩
  haveI := Dpr.additive
  haveI := Dpr.presLim
  haveI := Dpr.presColim
  show (Abelian.Ext.mk₀ γ).comp ((Abelian.Ext.mapExactFunctor Dpr.Φ
      (Abelian.Ext.mk₀ (inv (wcSuppUnitMap D0) ≫ wcHMConst (wcTlAff F 0) ℓ c))).comp
      (Abelian.Ext.mk₀ Dpr.μ.hom) (add_zero 0)) (zero_add 0) = Abelian.Ext.mk₀ f
  rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀]
  congr 1
  apply (cancel_epi (wcSuppUnitMap DZ)).1
  rw [hc, ← Category.assoc, hγ, Category.assoc, ← Functor.map_comp_assoc,
    IsIso.hom_inv_id_assoc, wc_hm_pull_const Dpr hDpr c]

theorem wc_supp_class_pull_zero_of_disjoint {Z Y T : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (i : Z ⟶ Y) [IsClosedImmersion i] (g : T ⟶ Y) [IsLocallyNoetherian T]
    (hdisj : ∀ (t : ↥T) (z : ↥Z), g t ≠ i z)
    (D : wcHMPullData i ℓ) (hD : wcHMPullCanonical D)
    (Dg : wcHMPullData g ℓ) (hDg : wcHMPullCanonical Dg) (n : ℕ) (θ : wcSuppExt D n) :
    wcHMPull Dg n (wcSuppClass D n θ) = 0 :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf T ℓ)) := HasExt.standard _
  obtain ⟨Di, hDi, γ, hγ, -⟩ := wc_closed_supp_base_change_noeth i g D hD Dg hDg

  have hempty : IsEmpty ↥(Limits.pullback g i) := by
    refine ⟨fun q => hdisj ((Limits.pullback.fst g i) q) ((Limits.pullback.snd g i) q) ?_⟩
    have h : (Limits.pullback.fst g i ≫ g) q = (Limits.pullback.snd g i ≫ i) q := by
      rw [Limits.pullback.condition]
    rwa [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h
  have hV : ∀ V : (Limits.pullback g i).ProEt, IsEmpty ↥V.left :=
    fun V => ⟨fun a => hempty.false (V.hom a)⟩

  have hzero : Limits.IsZero (SheafOfModules.unit (wcRingSheaf (Limits.pullback g i) ℓ)) := by
    rw [Limits.IsZero.iff_id_eq_zero]
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext W
    haveI := hV (Opposite.unop W)
    have hsub : Subsingleton C(↥(Opposite.unop W).left, ULift.{u+1} ℚ_[ℓ]) :=
      ⟨fun a b => ContinuousMap.ext (fun x => isEmptyElim x)⟩
    exact @Subsingleton.elim _ hsub _ _

  have hP : Limits.IsZero (wcSuppObj Di) := by
    haveI := Di.adj.isRightAdjoint
    exact Functor.map_isZero
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC _) _ _ Di.cont Di.φ) hzero
  have hρ : wcSuppUnitMap Di = 0 := hP.eq_zero_of_tgt _
  have hkey : Dg.μ.inv ≫ Dg.Φ.map (wcSuppUnitMap D) = 0 := by
    rw [← hγ, hρ, Limits.zero_comp]
  have e1 : wcHMPull Dg n (wcSuppClass D n θ) =
      (Abelian.Ext.mk₀ (Dg.μ.inv ≫ Dg.Φ.map (wcSuppUnitMap D))).comp
        (wcSuppPullExt D Dg n θ) (zero_add _) := by
    haveI := Dg.additive
    haveI := Dg.presLim
    haveI := Dg.presColim
    show (Abelian.Ext.mk₀ Dg.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dg.Φ
        ((Abelian.Ext.mk₀ (wcSuppUnitMap D)).comp θ (zero_add _))).comp
        (Abelian.Ext.mk₀ Dg.μ.hom) (add_zero _)) (zero_add _) =
      (Abelian.Ext.mk₀ (Dg.μ.inv ≫ Dg.Φ.map (wcSuppUnitMap D))).comp
        ((Abelian.Ext.mapExactFunctor Dg.Φ θ).comp (Abelian.Ext.mk₀ Dg.μ.hom) (add_zero _))
        (zero_add _)
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero, ← Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.comp_assoc_of_second_deg_zero]
  rw [e1, hkey, Abelian.Ext.mk₀_zero, Abelian.Ext.zero_comp]

theorem wc_supp_kernel_section_local_cover {T V : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (i : T ⟶ V) [IsClosedImmersion i] [IsLocallyNoetherian V]
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (U : V.ProEt) (k : (Limits.kernel (wcSuppUnitMap Di)).val.obj (Opposite.op U))
    (W : V.ProEt) (g : W ⟶ U) (hW : IsAffine W.left) :
    ∃ (n : ℕ) (W' : Fin n → V.ProEt) (e : ∀ j, W' j ⟶ W),
      (∀ j, IsAffine (W' j).left) ∧ (∀ x : ↥W.left, ∃ j, x ∈ Set.range (e j).left) ∧
      ∀ j, (∀ x : ↥(W' j).left, (W' j).hom x ∉ Set.range i) ∨
        ((Limits.kernel (wcSuppUnitMap Di)).val.map (e j ≫ g).op).hom k = 0 :=
by
  classical
  haveI : IsAffine W.left := hW
  haveI : WeaklyEtale W.hom := W.prop
  let t : C(↥U.left, ULift.{u+1} ℚ_[ℓ]) :=
    ((Limits.kernel.ι (wcSuppUnitMap Di)).val.app (Opposite.op U)).hom k
  have hk0 : ((wcSuppUnitMap Di).val.app (Opposite.op U)).hom t = 0 := by
    have hk := congrArg (fun φ => (φ.val.app (Opposite.op U)).hom k)
      (Limits.kernel.condition (wcSuppUnitMap Di))
    change ((wcSuppUnitMap Di).val.app (Opposite.op U)).hom
      (((Limits.kernel.ι (wcSuppUnitMap Di)).val.app (Opposite.op U)).hom k) = 0 at hk
    exact hk
  have vanish : ∀ y : ↥U.left, U.hom y ∈ Set.range i → t y = 0 := by
    intro y hy
    have hy' : y ∈ Set.range (Limits.pullback.fst U.hom i) := by
      rw [Scheme.Pullback.range_fst]; exact hy
    obtain ⟨z, rfl⟩ := hy'
    obtain ⟨c', hc'⟩ := wc_supp_unit_twist_isUnit Di
    have htw := wc_supp_hom_twist_formula Di hDi (wcSuppUnitMap Di) U t
    rw [hk0] at htw
    have h1 := congrArg
      (fun φ : C(↥(Limits.pullback U.hom i), ULift.{u+1} ℚ_[ℓ]) => φ z) htw
    have h2 := congrArg (fun φ : C(↥T, ULift.{u+1} ℚ_[ℓ]) =>
      φ ((Limits.pullback.snd U.hom i).base.hom z)) hc'
    simp only [ContinuousMap.mul_apply, ContinuousMap.comp_apply,
      ContinuousMap.one_apply] at h1 h2
    have h1' : (0 : ULift.{u+1} ℚ_[ℓ]) =
        t ((Limits.pullback.fst U.hom i).base.hom z) *
          (wcSuppTwist (wcSuppUnitMap Di)) ((Limits.pullback.snd U.hom i).base.hom z) := h1
    show t ((Limits.pullback.fst U.hom i).base.hom z) = 0
    linear_combination (-(c' ((Limits.pullback.snd U.hom i).base.hom z))) * h1' -
      (t ((Limits.pullback.fst U.hom i).base.hom z)) * h2
  have htW : ∀ x : ↥W.left, W.hom x ∈ Set.range i → (t.comp g.left.base.hom) x = 0 := by
    intro x hx
    apply vanish
    have e : U.hom (g.left x) = W.hom x := by
      rw [← MorphismProperty.Over.w g]; rfl
    rw [e]; exact hx
  obtain ⟨W₀, q, hW₀, hq, hq0, hqr⟩ :=
    wc_affine_zero_locus_weaklyEtale W.left ℓ (t.comp g.left.base.hom)
  obtain ⟨n, f, hf⟩ := wc_affine_complement_basicOpen_cover i W.left W.hom
  haveI := hq
  let W' : Fin (n + 1) → V.ProEt :=
    Fin.cases (MorphismProperty.Over.mk ⊤ (q ≫ W.hom) inferInstance)
      (fun k => MorphismProperty.Over.mk ⊤ ((W.left.basicOpen (f k)).ι ≫ W.hom) inferInstance)
  let e : ∀ k, W' k ⟶ W := Fin.cases (motive := fun k => W' k ⟶ W)
    (MorphismProperty.Over.homMk q rfl trivial)
    (fun k => MorphismProperty.Over.homMk (W.left.basicOpen (f k)).ι rfl trivial)
  refine ⟨n + 1, W', e, ?_, ?_, ?_⟩
  · intro j
    induction j using Fin.cases with
    | zero => exact hW₀
    | succ j => exact (isAffineOpen_top W.left).basicOpen (f j)
  · intro x
    by_cases hx : W.hom x ∈ Set.range i
    · exact ⟨0, hqr x (htW x hx)⟩
    · obtain ⟨j, hj⟩ := (hf x).mp hx
      refine ⟨j.succ, ?_⟩
      show x ∈ Set.range (W.left.basicOpen (f j)).ι
      rw [Scheme.Opens.range_ι]
      exact hj
  · intro j
    induction j using Fin.cases with
    | zero =>
      right
      let G := SheafOfModules.forget (wcRingSheaf V ℓ) ⋙
        PresheafOfModules.evaluation _ (Opposite.op (W' 0))
      have hmono : Mono (G.map (Limits.kernel.ι (wcSuppUnitMap Di))) := Functor.map_mono G _
      have hinj := (ModuleCat.mono_iff_injective _).mp hmono
      apply hinj
      have hn := PresheafOfModules.naturality_apply (Limits.kernel.ι (wcSuppUnitMap Di)).val
        (e 0 ≫ g).op k
      have h0 : (t.comp ((e 0 ≫ g).left.base.hom) : C(↥(W' 0).left, ULift.{u+1} ℚ_[ℓ])) = 0 := by
        ext w
        exact congrArg ULift.down (hq0 w)
      refine (hn.trans ?_).trans (map_zero _).symm
      change t.comp ((e 0 ≫ g).left.base.hom) = 0
      exact h0
    | succ j =>
      left
      intro x
      have hx : (W.left.basicOpen (f j)).ι x ∈ (W.left.basicOpen (f j) : Set ↥W.left) := by
        rw [← Scheme.Opens.range_ι]; exact ⟨x, rfl⟩
      exact (hf _).mpr ⟨j, hx⟩

theorem wc_supp_kernel_open_res_bijective {T V : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (i : T ⟶ V) [IsClosedImmersion i] (Di : wcHMPullData i ℓ)
    (Vo : V.ProEt) [IsOpenImmersion Vo.hom]
    [(wcSliceFunctor V Vo).IsContinuous (Scheme.ProEt.topology Vo.left) (Scheme.ProEt.topology V)]
    (hVo : Set.range Vo.hom = (Set.range i)ᶜ)
    (hcov : ∀ (U : V.ProEt) (k : (Limits.kernel (wcSuppUnitMap Di)).val.obj (Opposite.op U))
      (R : Sieve U), (∀ (U' : V.ProEt) (a : U' ⟶ U),
        ((∀ x : ↥U'.left, U'.hom x ∉ Set.range i) ∨
          ((Limits.kernel (wcSuppUnitMap Di)).val.map a.op).hom k = 0) → R.arrows a) →
      R ∈ Scheme.ProEt.topology V U)
    (N : SheafOfModules.{u+1} (wcRingSheaf V ℓ)) :
    Function.Bijective
      (fun φ : Limits.kernel (wcSuppUnitMap Di) ⟶ N => (wcSliceRes V ℓ Vo).map φ) :=
by
  classical
  haveI hVoW : WeaklyEtale Vo.hom := Vo.prop
  haveI : Mono Vo.hom := inferInstance
  have mc : ∀ (F : (V.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) {A B C : V.ProEt} (f : A ⟶ B) (h : B ⟶ C)
      (x : ↑(F.obj (Opposite.op C))), F.map (f ≫ h).op x = F.map f.op (F.map h.op x) := by
    intro F A B C f h x
    rw [op_comp, CategoryTheory.Functor.map_comp]
    rfl
  have mi : ∀ (F : (V.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) {A : V.ProEt}
      (x : ↑(F.obj (Opposite.op A))), F.map (𝟙 A).op x = x := by
    intro F A x
    rw [op_id, CategoryTheory.Functor.map_id]
    rfl

  have hHK : ∀ (W : V.ProEt)
      (s : ↑((Limits.kernel (wcSuppUnitMap Di)).val.presheaf.obj (Opposite.op W))),
      ∃ S ∈ Scheme.ProEt.topology V W, ∀ ⦃W' : V.ProEt⦄ (g : W' ⟶ W), S.arrows g →
        (Limits.kernel (wcSuppUnitMap Di)).val.presheaf.map g.op s = 0 ∨
          ∃ lam : W'.left ⟶ Vo.left, lam ≫ Vo.hom = W'.hom := by
    intro W s
    let S : Sieve W :=
      { arrows := fun {W'} g =>
          (Limits.kernel (wcSuppUnitMap Di)).val.presheaf.map g.op s = 0 ∨
            ∃ lam : W'.left ⟶ Vo.left, lam ≫ Vo.hom = W'.hom
        downward_closed := fun {Y Z f} hf c => by
          rcases hf with h0 | ⟨lam, hlam⟩
          · left
            rw [mc _ c f s, h0, map_zero]
          · right
            refine ⟨c.left ≫ lam, ?_⟩
            rw [Category.assoc, hlam]
            exact MorphismProperty.Over.w c }
    refine ⟨S, ?_, fun W' g hg => hg⟩
    apply hcov W s S
    intro U' a ha
    rcases ha with hoff | h0
    · right
      have hsub : Set.range U'.hom ⊆ Set.range Vo.hom := by
        rintro _ ⟨x, rfl⟩
        rw [hVo]
        exact hoff x
      exact ⟨IsOpenImmersion.lift Vo.hom U'.hom hsub, IsOpenImmersion.lift_fac _ _ _⟩
    · left
      exact h0
  clear hcov
  revert hHK
  generalize Limits.kernel (wcSuppUnitMap Di) = K
  intro hHK

  have hfac : ∀ (W : V.ProEt) (lam : W.left ⟶ Vo.left), lam ≫ Vo.hom = W.hom →
      ∃ (U0 : Vo.left.ProEt) (e : (wcSliceFunctor V Vo).obj U0 ≅ W), ∀ (U' : Vo.left.ProEt)
        (k : W ⟶ (wcSliceFunctor V Vo).obj U'), ∃ b : U0 ⟶ U',
          k = e.inv ≫ (wcSliceFunctor V Vo).map b := by
    intro W lam hlam
    haveI : WeaklyEtale (lam ≫ Vo.hom) := by rw [hlam]; exact W.prop
    haveI : WeaklyEtale lam := WeaklyEtale.of_comp lam Vo.hom
    refine ⟨Scheme.ProEt.mk lam,
      MorphismProperty.Over.isoMk (Iso.refl W.left) ((Category.id_comp _).trans hlam.symm), ?_⟩
    intro U' k
    have hk : k.left ≫ U'.hom = lam :=
      (cancel_mono Vo.hom).1
        ((Category.assoc _ _ _).trans ((MorphismProperty.Over.w k).trans hlam.symm))
    refine ⟨MorphismProperty.Over.homMk k.left hk trivial, ?_⟩
    apply MorphismProperty.Over.Hom.ext
    exact (Category.id_comp _).symm

  have key : ∀ (P Q : (V.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}),
      Presheaf.IsSheaf (Scheme.ProEt.topology V) Q →
      ∀ (θ : ∀ U : Vo.left.ProEt, ↑(P.obj (Opposite.op ((wcSliceFunctor V Vo).obj U))) →+
          ↑(Q.obj (Opposite.op ((wcSliceFunctor V Vo).obj U)))),
      (∀ (W : V.ProEt) (s : ↑(P.obj (Opposite.op W))), ∃ S ∈ Scheme.ProEt.topology V W,
        ∀ ⦃W' : V.ProEt⦄ (g : W' ⟶ W), S.arrows g →
          P.map g.op s = 0 ∨ ∃ lam : W'.left ⟶ Vo.left, lam ≫ Vo.hom = W'.hom) →
      (∀ (U U' : Vo.left.ProEt) (b : U' ⟶ U)
        (x : ↑(P.obj (Opposite.op ((wcSliceFunctor V Vo).obj U)))),
        Q.map ((wcSliceFunctor V Vo).map b).op (θ U x) =
          θ U' (P.map ((wcSliceFunctor V Vo).map b).op x)) →
      ∃ φ : P ⟶ Q, ∀ (U : Vo.left.ProEt) (x : ↑(P.obj (Opposite.op ((wcSliceFunctor V Vo).obj U)))),
        φ.app (Opposite.op ((wcSliceFunctor V Vo).obj U)) x = θ U x := by
    intro P Q hQ θ hHP hnat
    have hzero : ∀ (U : Vo.left.ProEt) (Y : V.ProEt) (k : Y ⟶ (wcSliceFunctor V Vo).obj U)
        (x : ↑(P.obj (Opposite.op ((wcSliceFunctor V Vo).obj U)))), P.map k.op x = 0 →
        Q.map k.op (θ U x) = 0 := by
      intro U Y k x hx
      have hlam : (k.left ≫ U.hom) ≫ Vo.hom = Y.hom :=
        (Category.assoc _ _ _).trans (MorphismProperty.Over.w k)
      obtain ⟨U₀, e, he⟩ := hfac Y _ hlam
      obtain ⟨b, hb⟩ := he U k
      have hb' : (wcSliceFunctor V Vo).map b = e.hom ≫ k := by rw [hb, Iso.hom_inv_id_assoc]
      rw [hb, mc Q e.inv ((wcSliceFunctor V Vo).map b), hnat U U₀ b x, hb', mc P e.hom k, hx,
        map_zero, map_zero, map_zero]
    have hcompat : ∀ (Y : V.ProEt) (U₁ U₂ : Vo.left.ProEt) (j₁ : Y ⟶ (wcSliceFunctor V Vo).obj U₁)
        (j₂ : Y ⟶ (wcSliceFunctor V Vo).obj U₂)
        (x₁ : ↑(P.obj (Opposite.op ((wcSliceFunctor V Vo).obj U₁))))
        (x₂ : ↑(P.obj (Opposite.op ((wcSliceFunctor V Vo).obj U₂)))),
        P.map j₁.op x₁ = P.map j₂.op x₂ → Q.map j₁.op (θ U₁ x₁) = Q.map j₂.op (θ U₂ x₂) := by
      intro Y U₁ U₂ j₁ j₂ x₁ x₂ hx
      have h₁ : (j₁.left ≫ U₁.hom) ≫ Vo.hom = Y.hom :=
        (Category.assoc _ _ _).trans (MorphismProperty.Over.w j₁)
      obtain ⟨U, e, he⟩ := hfac Y _ h₁
      obtain ⟨b₁, hb₁⟩ := he U₁ j₁
      obtain ⟨b₂, hb₂⟩ := he U₂ j₂
      have hb₁' : (wcSliceFunctor V Vo).map b₁ = e.hom ≫ j₁ := by rw [hb₁, Iso.hom_inv_id_assoc]
      have hb₂' : (wcSliceFunctor V Vo).map b₂ = e.hom ≫ j₂ := by rw [hb₂, Iso.hom_inv_id_assoc]
      rw [hb₁, hb₂, mc Q e.inv ((wcSliceFunctor V Vo).map b₁),
        mc Q e.inv ((wcSliceFunctor V Vo).map b₂),
        hnat U₁ U b₁ x₁, hnat U₂ U b₂ x₂, hb₁', hb₂', mc P e.hom j₁, mc P e.hom j₂, hx]
    obtain ⟨Good, hGood⟩ : ∃ Good : ∀ W : V.ProEt, ↑(P.obj (Opposite.op W)) →
        ↑(Q.obj (Opposite.op W)) → Prop, ∀ W s u, Good W s u ↔
          ((∀ (U : Vo.left.ProEt) (k : (wcSliceFunctor V Vo).obj U ⟶ W),
              Q.map k.op u = θ U (P.map k.op s)) ∧
            ∀ (Y : V.ProEt) (k : Y ⟶ W), P.map k.op s = 0 → Q.map k.op u = 0) :=
      ⟨_, fun _ _ _ => Iff.rfl⟩
    have huniq : ∀ W s u u', Good W s u → Good W s u' → u = u' := by
      intro W s u u' hu hu'
      rw [hGood] at hu hu'
      obtain ⟨S, hS, hSc⟩ := hHP W s
      refine hQ.isSeparated W S hS u u' ?_
      intro W' g hg
      rcases hSc g hg with h0 | ⟨lam, hlam⟩
      · rw [hu.2 W' g h0, hu'.2 W' g h0]
      · obtain ⟨U, e, -⟩ := hfac W' lam hlam
        rw [← Iso.inv_hom_id_assoc e g, mc Q e.inv (e.hom ≫ g) u, mc Q e.inv (e.hom ≫ g) u',
          hu.1 U (e.hom ≫ g), hu'.1 U (e.hom ≫ g)]
    have hres : ∀ (W W' : V.ProEt) (f : W' ⟶ W) s u, Good W s u →
        Good W' (P.map f.op s) (Q.map f.op u) := by
      intro W W' f s u hu
      rw [hGood] at hu ⊢
      refine ⟨fun U k => ?_, fun Y k hk => ?_⟩
      · rw [← mc Q k f, ← mc P k f]; exact hu.1 U (k ≫ f)
      · rw [← mc P k f] at hk
        rw [← mc Q k f]; exact hu.2 Y (k ≫ f) hk
    have hrg : ∀ (U : Vo.left.ProEt) (x : ↑(P.obj (Opposite.op ((wcSliceFunctor V Vo).obj U))))
        (Y : V.ProEt) (h : Y ⟶ (wcSliceFunctor V Vo).obj U),
        Good Y (P.map h.op x) (Q.map h.op (θ U x)) := by
      intro U x Y h
      rw [hGood]
      refine ⟨fun Ua k => ?_, fun Ya k hk => ?_⟩
      · rw [← mc Q k h, ← mc P k h]
        have hc' := hcompat _ U Ua (k ≫ h) (𝟙 _) x (P.map (k ≫ h).op x) (mi P _).symm
        rw [hc', mi Q]
      · rw [← mc P k h] at hk
        rw [← mc Q k h]; exact hzero U Ya (k ≫ h) x hk
    have hloc : ∀ (W' : V.ProEt) (t : ↑(P.obj (Opposite.op W'))),
        (t = 0 ∨ ∃ lam : W'.left ⟶ Vo.left, lam ≫ Vo.hom = W'.hom) → ∃ u, Good W' t u := by
      intro W' t ht
      rcases ht with h0 | ⟨lam, hlam⟩
      · refine ⟨0, ?_⟩
        rw [hGood, h0]
        refine ⟨fun U k => ?_, fun Y k _ => ?_⟩
        · simp only [map_zero]
        · simp only [map_zero]
      · obtain ⟨U, e, -⟩ := hfac W' lam hlam
        refine ⟨Q.map e.inv.op (θ U (P.map e.hom.op t)), ?_⟩
        have h := hrg U (P.map e.hom.op t) W' e.inv
        rwa [← mc P e.inv e.hom, Iso.inv_hom_id, mi P] at h
    have hglue : ∀ (W : V.ProEt) (s : ↑(P.obj (Opposite.op W))), ∃ u, Good W s u := by
      intro W s
      obtain ⟨S, hS, hSc⟩ := hHP W s
      have hfam : ∀ ⦃W' : V.ProEt⦄ (g : W' ⟶ W), S.arrows g → ∃ u, Good W' (P.map g.op s) u :=
        fun W' g hg => hloc W' _ (hSc g hg)
      choose u hu using hfam
      have hQt : Presieve.IsSheafFor (Q ⋙ forget AddCommGrpCat.{u+1}) S.arrows :=
        (isSheaf_iff_isSheaf_of_type _ _).mp
          (GrothendieckTopology.HasSheafCompose.isSheaf _ hQ) S hS
      let xf : Presieve.FamilyOfElements (Q ⋙ forget AddCommGrpCat.{u+1}) S.arrows :=
        fun W' g hg => u g hg
      have hx : xf.Compatible := by
        intro W₁ W₂ W₀ g₁ g₂ f₁ f₂ h₁ h₂ hcomm
        have e1 := hres _ _ g₁ _ _ (hu f₁ h₁)
        have e2 := hres _ _ g₂ _ _ (hu f₂ h₂)
        rw [← mc P g₁ f₁, hcomm, mc P g₂ f₂] at e1
        exact huniq _ _ _ _ e1 e2
      obtain ⟨y, hy⟩ : ∃ y : ↑(Q.obj (Opposite.op W)), ∀ ⦃W' : V.ProEt⦄ (g : W' ⟶ W)
          (hg : S.arrows g), Q.map g.op y = u g hg :=
        ⟨hQt.amalgamate xf hx, fun W' g hg => hQt.valid_glue hx g hg⟩
      refine ⟨y, ?_⟩
      rw [hGood]
      refine ⟨fun Ua k => ?_, fun Ya k hYa => ?_⟩
      · refine hQ.isSeparated _ (S.pullback k)
          ((Scheme.ProEt.topology V).pullback_stable k hS) _ _ ?_
        intro V' m hm
        have g1 := hu (m ≫ k) hm
        have g2 := hrg Ua (P.map k.op s) V' m
        rw [← mc P m k] at g2
        rw [← mc Q m k y, hy (m ≫ k) hm]
        exact huniq _ _ _ _ g1 g2
      · refine hQ.isSeparated _ (S.pullback k)
          ((Scheme.ProEt.topology V).pullback_stable k hS) _ _ ?_
        intro V' m hm
        have g1 := hu (m ≫ k) hm
        rw [hGood] at g1
        have h0 : P.map (m ≫ k).op s = 0 := by rw [mc P m k, hYa, map_zero]
        have h1 := g1.2 V' (𝟙 V') (by rw [mi P]; exact h0)
        rw [mi Q] at h1
        rw [← mc Q m k y, hy (m ≫ k) hm, h1, map_zero]
    choose φf hφf using hglue
    have hnatφ : ∀ (W W' : V.ProEt) (f : W' ⟶ W) (s : ↑(P.obj (Opposite.op W))),
        φf W' (P.map f.op s) = Q.map f.op (φf W s) :=
      fun W W' f s => huniq _ _ _ _ (hφf W' (P.map f.op s)) (hres W W' f s _ (hφf W s))
    have hzeroφ : ∀ W, φf W 0 = 0 := by
      intro W
      apply huniq W 0 _ _ (hφf W 0)
      rw [hGood]
      refine ⟨fun U k => ?_, fun Y k _ => ?_⟩
      · simp only [map_zero]
      · simp only [map_zero]
    have hchart : ∀ (W' : V.ProEt) (lam : W'.left ⟶ Vo.left), lam ≫ Vo.hom = W'.hom →
        ∀ a b : ↑(P.obj (Opposite.op W')), φf W' (a + b) = φf W' a + φf W' b := by
      intro W' lam hlam a b
      obtain ⟨U, e, -⟩ := hfac W' lam hlam
      have key1 : ∀ t, φf W' t = Q.map e.inv.op (θ U (P.map e.hom.op t)) := by
        intro t
        have h1 := ((hGood _ _ _).mp (hφf W' t)).1 U e.hom
        rw [← h1, ← mc Q e.inv e.hom, Iso.inv_hom_id, mi Q]
      rw [key1 (a + b), key1 a, key1 b]
      simp only [map_add]
    have hadd : ∀ W (s s' : ↑(P.obj (Opposite.op W))), φf W (s + s') = φf W s + φf W s' := by
      intro W s s'
      obtain ⟨S₁, hS₁, hSc₁⟩ := hHP W s
      obtain ⟨S₂, hS₂, hSc₂⟩ := hHP W s'
      refine hQ.isSeparated W (S₁ ⊓ S₂)
        ((Scheme.ProEt.topology V).intersection_covering hS₁ hS₂) _ _ ?_
      intro W' g hg
      have hg' : S₁.arrows g ∧ S₂.arrows g := hg
      rw [map_add, ← hnatφ W W' g, ← hnatφ W W' g, ← hnatφ W W' g, map_add]
      rcases hSc₁ g hg'.1 with h1 | ⟨lam, hlam⟩
      · rcases hSc₂ g hg'.2 with h2 | ⟨lam, hlam⟩
        · rw [h1, h2, add_zero, hzeroφ, add_zero]
        · exact hchart W' lam hlam _ _
      · exact hchart W' lam hlam _ _
    refine ⟨{ app := fun A => AddCommGrpCat.ofHom (AddMonoidHom.mk' (φf A.unop) (hadd A.unop))
              naturality := ?_ }, ?_⟩
    · intro A B f
      ext s
      exact hnatφ A.unop B.unop f.unop s
    · intro U x
      have h := (hGood _ _ _).mp (hφf ((wcSliceFunctor V Vo).obj U) x)
      have h1 := h.1 U (𝟙 _)
      rw [mi Q, mi P] at h1
      exact h1

  have hinj : Function.Injective (fun φ : K ⟶ N => (wcSliceRes V ℓ Vo).map φ) := by
    intro f f' hff
    have hff' : (wcSliceRes V ℓ Vo).map f = (wcSliceRes V ℓ Vo).map f' := hff
    have s1 : ∀ (U0 : Vo.left.ProEt) (m : K.val.obj (Opposite.op ((wcSliceFunctor V Vo).obj U0))),
        f.val.app (Opposite.op ((wcSliceFunctor V Vo).obj U0)) m =
          f'.val.app (Opposite.op ((wcSliceFunctor V Vo).obj U0)) m := by
      intro U0 m
      have h := congrArg (fun φ : (wcSliceRes V ℓ Vo).obj K ⟶ (wcSliceRes V ℓ Vo).obj N =>
        (φ.val.app (Opposite.op U0)).hom m) hff'
      exact h
    have keyI : ∀ (W : V.ProEt) (s : K.val.obj (Opposite.op W)),
        f.val.app (Opposite.op W) s = f'.val.app (Opposite.op W) s := by
      intro W s
      obtain ⟨S, hS, hSc⟩ := hHK W s
      refine Presheaf.IsSheaf.isSeparated N.isSheaf W S hS
        (f.val.app (Opposite.op W) s) (f'.val.app (Opposite.op W) s) ?_
      intro W' g hg
      have e1 := PresheafOfModules.presheaf_map_apply_coe N.val g.op (f.val.app (Opposite.op W) s)
      have e2 := PresheafOfModules.presheaf_map_apply_coe N.val g.op (f'.val.app (Opposite.op W) s)
      refine (e1.trans ?_).trans e2.symm
      rcases hSc g hg with h0 | ⟨lam, hlam⟩
      · have h0' : (ConcreteCategory.hom (K.val.map g.op)) s = 0 :=
          (PresheafOfModules.presheaf_map_apply_coe K.val g.op s).symm.trans h0
        have hz : ∀ x : K.val.obj (Opposite.op W'), x = 0 →
            f.val.app (Opposite.op W') x = f'.val.app (Opposite.op W') x := by
          intro x hx
          rw [hx, map_zero, map_zero]
        rw [← PresheafOfModules.naturality_apply, ← PresheafOfModules.naturality_apply]
        exact hz _ h0'
      · obtain ⟨U0, e, -⟩ := hfac W' lam hlam
        have hg' : g = e.inv ≫ (e.hom ≫ g) := (Iso.inv_hom_id_assoc e g).symm
        have h := s1 U0 (K.val.map (e.hom ≫ g).op s)
        rw [PresheafOfModules.naturality_apply, PresheafOfModules.naturality_apply] at h
        rw [hg', op_comp, PresheafOfModules.map_comp_apply, PresheafOfModules.map_comp_apply, h]
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro W
    ext s
    exact keyI W.unop s

  have hsurj : Function.Surjective (fun φ : K ⟶ N => (wcSliceRes V ℓ Vo).map φ) := by
    intro g
    have hQN : Presheaf.IsSheaf (Scheme.ProEt.topology V) N.val.presheaf := N.isSheaf
    obtain ⟨φ, hφ⟩ := key K.val.presheaf N.val.presheaf hQN
      (fun U0 => (g.val.app (Opposite.op U0)).hom.toAddMonoidHom) hHK
      (fun U0 U' b x => (PresheafOfModules.naturality_apply g.val b.op x).symm)
    let φX : ∀ X, K.val.obj X → N.val.obj X := fun X x => (φ.app X).hom x
    have nat : ∀ (X Y : (V.ProEt)ᵒᵖ) (h : X ⟶ Y) (x : K.val.obj X),
        N.val.map h (φX X x) = φX Y (K.val.map h x) := by
      intro X Y h x
      exact (ConcreteCategory.congr_hom (φ.naturality h) x).symm
    have hz : ∀ X, φX X 0 = 0 := fun X => map_zero (φ.app X).hom
    have hlinG : ∀ (U : Vo.left.ProEt)
        (r : ↑((wcRingSheaf V ℓ).obj.obj (Opposite.op ((wcSliceFunctor V Vo).obj U))))
        (x : K.val.obj (Opposite.op ((wcSliceFunctor V Vo).obj U))),
        φX _ (r • x) = r • φX _ x := by
      intro U r x
      let r' : ↑((wcRingSheaf Vo.left ℓ).obj.obj (Opposite.op U)) := r
      have e1 := hφ U (r • x)
      have e2 := hφ U x
      have e3 := (g.val.app (Opposite.op U)).hom.map_smul r' x
      refine e1.trans (e3.trans ?_)
      exact congrArg (fun z : N.val.obj (Opposite.op ((wcSliceFunctor V Vo).obj U)) => r • z)
        e2.symm
    have loc : ∀ (W' : V.ProEt) (r' : ↑((wcRingSheaf V ℓ).obj.obj (Opposite.op W')))
        (m' : K.val.obj (Opposite.op W')),
        (m' = 0 ∨ ∃ lam : W'.left ⟶ Vo.left, lam ≫ Vo.hom = W'.hom) →
        φX _ (r' • m') = r' • φX _ m' := by
      intro W' r' m' hm'
      rcases hm' with h0 | ⟨lam, hlam⟩
      · rw [h0, smul_zero, hz, smul_zero]
      · obtain ⟨U0, e, -⟩ := hfac W' lam hlam
        have form : ∀ y : K.val.obj (Opposite.op W'), φX _ y =
            N.val.map e.inv.op (φX _ (K.val.map e.hom.op y)) := by
          intro y
          rw [← nat, ← PresheafOfModules.map_comp_apply, ← op_comp, Iso.inv_hom_id, op_id,
            ← PresheafOfModules.presheaf_map_apply_coe, CategoryTheory.Functor.map_id]
          rfl
        have hr : ((wcRingSheaf V ℓ).obj.map e.inv.op) (((wcRingSheaf V ℓ).obj.map e.hom.op) r')
            = r' := by
          rw [← ConcreteCategory.comp_apply, ← CategoryTheory.Functor.map_comp, ← op_comp,
            Iso.inv_hom_id, op_id, CategoryTheory.Functor.map_id, ConcreteCategory.id_apply]
        rw [form, form m', K.val.map_smul]
        refine (congrArg (fun z => (N.val.map e.inv.op) z) (hlinG U0 _ _)).trans ?_
        refine (N.val.map_smul _ _ _).trans ?_
        exact congrArg (fun s => s • (N.val.map e.inv.op) (φX _ (K.val.map e.hom.op m'))) hr
    obtain ⟨f, hfx⟩ : ∃ f : K ⟶ N, ∀ (X : (V.ProEt)ᵒᵖ) (x : ↑(K.val.obj X)),
        f.val.app X x = φ.app X x := by
      refine ⟨⟨PresheafOfModules.homMk φ ?_⟩, fun X x => rfl⟩
      intro X r m
      show φX X (r • m) = r • φX X m
      obtain ⟨S, hS, hSc⟩ := hHK X.unop m
      refine Presheaf.IsSheaf.isSeparated N.isSheaf X.unop S hS _ _ ?_
      intro W' h hh
      show N.val.map h.op (φX X (r • m)) = N.val.map h.op (r • φX X m)
      rw [nat, K.val.map_smul, N.val.map_smul, nat]
      rcases hSc h hh with h0 | hg
      · exact loc W' _ _ (Or.inl h0)
      · exact loc W' _ _ (Or.inr hg)
    refine ⟨f, ?_⟩
    show (wcSliceRes V ℓ Vo).map f = g
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro U0
    ext m
    exact (hfx _ m).trans (hφ U0.unop m)
  exact ⟨hinj, hsurj⟩

theorem wc_hm_pull_data_comp_Phi_iso {S S' S'' : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (f : S' ⟶ S) (g : S'' ⟶ S') (k : S'' ⟶ S) (hk : g ≫ f = k)
    (Df : wcHMPullData f ℓ) (hDf : wcHMPullCanonical Df)
    (Dg : wcHMPullData g ℓ) (hDg : wcHMPullCanonical Dg)
    (Dk : wcHMPullData k ℓ) (hDk : wcHMPullCanonical Dk) :
    Nonempty (Dk.Φ ≅ Df.Φ ⋙ Dg.Φ) :=
by
  classical
  subst hk
  have hmap : ∀ {A B : Scheme.{u}} (h : A ⟶ B) {W W' : B.ProEt} (u : W ⟶ W'),
      ((wcProEtBC h).map u).left ≫ Limits.pullback.fst W'.hom h =
        Limits.pullback.fst W.hom h ≫ u.left ∧
      ((wcProEtBC h).map u).left ≫ Limits.pullback.snd W'.hom h = Limits.pullback.snd W.hom h := by
    intro A B h W W' u
    exact ⟨Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hsnd : ∀ W : S.ProEt, (Limits.pullbackLeftPullbackSndIso W.hom f g).symm.hom ≫
      Limits.pullback.snd (Limits.pullback.snd W.hom f) g =
        Limits.pullback.snd W.hom (g ≫ f) := by
    intro W
    rw [Iso.symm_hom, Iso.inv_comp_eq, Limits.pullbackLeftPullbackSndIso_hom_snd]
  choose c hc using fun W : S.ProEt =>
    (⟨MorphismProperty.Over.isoMk (A := (wcProEtBC (g ≫ f)).obj W)
        (B := (wcProEtBC f ⋙ wcProEtBC g).obj W)
        (Limits.pullbackLeftPullbackSndIso W.hom f g).symm (hsnd W),
      MorphismProperty.Over.isoMk_hom_left _ _⟩ :
      ∃ c : (wcProEtBC (g ≫ f)).obj W ≅ (wcProEtBC f ⋙ wcProEtBC g).obj W,
        c.hom.left = (Limits.pullbackLeftPullbackSndIso W.hom f g).inv)
  have nat : ∀ {W W' : S.ProEt} (u : W ⟶ W'),
      (wcProEtBC (g ≫ f)).map u ≫ (c W').hom =
        (c W).hom ≫ (wcProEtBC f ⋙ wcProEtBC g).map u := by
    intro W W' u
    have key : ∀ (L : Limits.pullback W.hom (g ≫ f) ⟶ Limits.pullback W'.hom (g ≫ f))
        (M1 : Limits.pullback W.hom f ⟶ Limits.pullback W'.hom f)
        (M2 : Limits.pullback (Limits.pullback.snd W.hom f) g ⟶
          Limits.pullback (Limits.pullback.snd W'.hom f) g),
        L ≫ Limits.pullback.fst W'.hom (g ≫ f) = Limits.pullback.fst W.hom (g ≫ f) ≫ u.left →
        L ≫ Limits.pullback.snd W'.hom (g ≫ f) = Limits.pullback.snd W.hom (g ≫ f) →
        M1 ≫ Limits.pullback.fst W'.hom f = Limits.pullback.fst W.hom f ≫ u.left →
        M1 ≫ Limits.pullback.snd W'.hom f = Limits.pullback.snd W.hom f →
        M2 ≫ Limits.pullback.fst (Limits.pullback.snd W'.hom f) g =
          Limits.pullback.fst (Limits.pullback.snd W.hom f) g ≫ M1 →
        M2 ≫ Limits.pullback.snd (Limits.pullback.snd W'.hom f) g =
          Limits.pullback.snd (Limits.pullback.snd W.hom f) g →
        L ≫ (Limits.pullbackLeftPullbackSndIso W'.hom f g).inv =
          (Limits.pullbackLeftPullbackSndIso W.hom f g).inv ≫ M2 := by
      intro L M1 M2 hL1 hL2 hM1 _ hM2 hM2'
      rw [Iso.comp_inv_eq, Category.assoc, Iso.eq_inv_comp]
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hL1, Category.assoc, Limits.pullbackLeftPullbackSndIso_hom_fst,
          reassoc_of% hM2, hM1, reassoc_of% (Limits.pullbackLeftPullbackSndIso_hom_fst W.hom f g)]
      · rw [Category.assoc, hL2, Limits.pullbackLeftPullbackSndIso_hom_snd, Category.assoc,
          Limits.pullbackLeftPullbackSndIso_hom_snd, hM2']
    apply MorphismProperty.Over.Hom.ext
    change ((wcProEtBC (g ≫ f)).map u).left ≫ (c W').hom.left =
      (c W).hom.left ≫ ((wcProEtBC g).map ((wcProEtBC f).map u)).left
    rw [hc W, hc W']
    exact key _ _ _ (hmap (g ≫ f) u).1 (hmap (g ≫ f) u).2 (hmap f u).1 (hmap f u).2
      (hmap g ((wcProEtBC f).map u)).1 (hmap g ((wcProEtBC f).map u)).2
  let α : wcProEtBC (g ≫ f) ≅ wcProEtBC f ⋙ wcProEtBC g := NatIso.ofComponents c nat
  have hα : ∀ (W : S.ProEt) (z : ↥((wcProEtBC (g ≫ f)).obj W).left),
      (Limits.pullback.fst W.hom f) ((Limits.pullback.fst (Limits.pullback.snd W.hom f) g)
        ((α.hom.app W).left z)) = (Limits.pullback.fst W.hom (g ≫ f)) z := by
    intro W z
    change (Limits.pullback.fst W.hom f) ((Limits.pullback.fst (Limits.pullback.snd W.hom f) g)
      ((c W).hom.left z)) = _
    rw [hc W]
    have key : ∀ z' : ↥(Limits.pullback W.hom (g ≫ f)),
        (Limits.pullback.fst W.hom f) ((Limits.pullback.fst (Limits.pullback.snd W.hom f) g)
          ((Limits.pullbackLeftPullbackSndIso W.hom f g).inv z')) =
        (Limits.pullback.fst W.hom (g ≫ f)) z' := by
      intro z'
      calc (Limits.pullback.fst W.hom f) ((Limits.pullback.fst (Limits.pullback.snd W.hom f) g)
            ((Limits.pullbackLeftPullbackSndIso W.hom f g).inv z'))
          = ((Limits.pullbackLeftPullbackSndIso W.hom f g).inv ≫
              Limits.pullback.fst (Limits.pullback.snd W.hom f) g ≫
                Limits.pullback.fst W.hom f) z' := rfl
        _ = (Limits.pullback.fst W.hom (g ≫ f)) z' := by
          rw [Limits.pullbackLeftPullbackSndIso_inv_fst]
    exact key z
  haveI := Df.cont
  haveI := Dg.cont
  haveI := Dk.cont
  haveI : (wcProEtBC f ⋙ wcProEtBC g).IsContinuous (Scheme.ProEt.topology S)
      (Scheme.ProEt.topology S'') :=
    Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology S') _
  let τ := (Functor.sheafPushforwardContinuousNatTrans α.hom RingCat.{u+1}
    (Scheme.ProEt.topology S) (Scheme.ProEt.topology S'')).app (wcRingSheaf S'' ℓ)
  let φfg : wcRingSheaf S ℓ ⟶ ((wcProEtBC f ⋙ wcProEtBC g).sheafPushforwardContinuous
      RingCat.{u+1} (Scheme.ProEt.topology S) (Scheme.ProEt.topology S'')).obj
        (wcRingSheaf S'' ℓ) :=
    Df.φ ≫ ((wcProEtBC f).sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')).map Dg.φ
  have hcompat : φfg ≫ τ = Dk.φ := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext W
    induction W using Opposite.rec with
    | op W =>
    apply RingCat.hom_ext
    apply RingHom.ext
    intro s
    rw [hDk W s]
    apply ContinuousMap.ext
    intro z
    refine (congrArg (fun h : C(↥(Limits.pullback (Limits.pullback.snd W.hom f) g),
        ULift.{u+1} ℚ_[ℓ]) => h ((α.hom.app W).left.base z))
      (hDg ((wcProEtBC f).obj W) ((Df.φ.hom.app (Opposite.op W)).hom s :
        C(↥(Limits.pullback W.hom f), ULift.{u+1} ℚ_[ℓ])))).trans ?_
    refine (congrArg (fun h : C(↥(Limits.pullback W.hom f), ULift.{u+1} ℚ_[ℓ]) =>
        h ((Limits.pullback.fst (Limits.pullback.snd W.hom f) g).base
          ((α.hom.app W).left.base z))) (hDf W s)).trans ?_
    let s' : C(↥W.left, ULift.{u+1} ℚ_[ℓ]) := s
    exact congrArg (fun p => s' p) (hα W z)
  let ιc : SheafOfModules.pushforward Dg.φ ⋙ SheafOfModules.pushforward Df.φ ≅
      SheafOfModules.pushforward Dk.φ :=
    SheafOfModules.pushforwardComp Df.φ Dg.φ ≪≫
      SheafOfModules.pushforwardNatIso φfg α ≪≫ SheafOfModules.pushforwardCongr hcompat
  exact ⟨Dk.adj.leftAdjointUniq ((Df.adj.comp Dg.adj).ofNatIsoRight ιc)⟩

theorem wc_open_kernel_transfer_natural {Y Y' O O' : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    {jO : O ⟶ Y} {jO' : O' ⟶ Y'} {f : Y' ⟶ Y} {fO : O' ⟶ O}
    (Do : wcHMPullData jO ℓ) (Do' : wcHMPullData jO' ℓ)
    (Df : wcHMPullData f ℓ) (DfO : wcHMPullData fO ℓ)
    (θ : Df.Φ ⋙ Do'.Φ ≅ Do.Φ ⋙ DfO.Φ)
    (K : SheafOfModules.{u+1} (wcRingSheaf Y ℓ))
    (ιK : K ⟶ SheafOfModules.unit (wcRingSheaf Y ℓ)) [Mono ιK]
    (K' : SheafOfModules.{u+1} (wcRingSheaf Y' ℓ))
    (ιK' : K' ⟶ SheafOfModules.unit (wcRingSheaf Y' ℓ))
    (ε : SheafOfModules.unit (wcRingSheaf O ℓ) ⟶ Do.Φ.obj K) (hε : ε ≫ Do.Φ.map ιK = Do.μ.inv)
    (ε' : SheafOfModules.unit (wcRingSheaf O' ℓ) ⟶ Do'.Φ.obj K')
    (hε' : ε' ≫ Do'.Φ.map ιK' = Do'.μ.inv)
    (τ₁ : K' ⟶ Df.Φ.obj K) (hτ : τ₁ ≫ Df.Φ.map ιK = ιK' ≫ Df.μ.inv) (n : ℕ) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y' ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf O ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf O' ℓ)) := HasExt.standard _
    haveI := Df.additive; haveI := Df.presLim; haveI := Df.presColim
    haveI := Do.additive; haveI := Do.presLim; haveI := Do.presColim
    haveI := Do'.additive; haveI := Do'.presLim; haveI := Do'.presColim
    ∀ x : Abelian.Ext K (SheafOfModules.unit (wcRingSheaf Y ℓ)) n,
      (Abelian.Ext.mk₀ ε').comp ((Abelian.Ext.mapExactFunctor Do'.Φ
          ((Abelian.Ext.mk₀ τ₁).comp ((Abelian.Ext.mapExactFunctor Df.Φ x).comp
            (Abelian.Ext.mk₀ Df.μ.hom) (add_zero n)) (zero_add n))).comp
          (Abelian.Ext.mk₀ Do'.μ.hom) (add_zero n)) (zero_add n) =
        wcHMPull DfO n ((Abelian.Ext.mk₀ ε).comp ((Abelian.Ext.mapExactFunctor Do.Φ x).comp
          (Abelian.Ext.mk₀ Do.μ.hom) (add_zero n)) (zero_add n)) :=
by
  classical
  letI iY : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
  letI iY' : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y' ℓ)) := HasExt.standard _
  letI iO : HasExt (SheafOfModules.{u+1} (wcRingSheaf O ℓ)) := HasExt.standard _
  letI iO' : HasExt (SheafOfModules.{u+1} (wcRingSheaf O' ℓ)) := HasExt.standard _
  haveI := Df.additive
  haveI := Df.presLim
  haveI := Df.presColim
  haveI := Do.additive
  haveI := Do.presLim
  haveI := Do.presColim
  haveI := Do'.additive
  haveI := Do'.presLim
  haveI := Do'.presColim
  haveI := DfO.additive
  haveI := DfO.presLim
  haveI := DfO.presColim
  intro x

  have h2 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf O' ℓ)} {a : ℕ}
      (p : A ⟶ B) (q : B ⟶ C') (z : Abelian.Ext C' D' a),
      (Abelian.Ext.mk₀ p).comp ((Abelian.Ext.mk₀ q).comp z (zero_add a)) (zero_add a) =
        (Abelian.Ext.mk₀ (p ≫ q)).comp z (zero_add a) := by
    intro A B C' D' a p q z
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
  have h3 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf O' ℓ)} {a : ℕ}
      (z : Abelian.Ext A B a) (p : B ⟶ C') (q : C' ⟶ D'),
      (z.comp (Abelian.Ext.mk₀ p) (add_zero a)).comp (Abelian.Ext.mk₀ q) (add_zero a) =
        z.comp (Abelian.Ext.mk₀ (p ≫ q)) (add_zero a) := by
    intro A B C' D' a z p q
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  have h4 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf O' ℓ)} {a : ℕ}
      (p : A ⟶ B) (z : Abelian.Ext B C' a) (q : C' ⟶ D'),
      ((Abelian.Ext.mk₀ p).comp z (zero_add a)).comp (Abelian.Ext.mk₀ q) (add_zero a) =
        (Abelian.Ext.mk₀ p).comp (z.comp (Abelian.Ext.mk₀ q) (add_zero a)) (zero_add a) := by
    intro A B C' D' a p z q
    exact Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _

  have hcomm : ∀ (X : (O'.ProEt)ᵒᵖ) (a b : (wcRingSheaf O' ℓ).obj.obj X), a * b = b * a := by
    intro X a b
    exact @mul_comm C(↥(Opposite.unop X).left, ULift.{u+1} ℚ_[ℓ]) _ a b
  have hext : ∀ (e : SheafOfModules.unit (wcRingSheaf O' ℓ) ⟶
      SheafOfModules.unit (wcRingSheaf O' ℓ)), ∃ m : 𝟭 (SheafOfModules.{u+1} (wcRingSheaf O' ℓ)) ⟶
      𝟭 (SheafOfModules.{u+1} (wcRingSheaf O' ℓ)),
      m.app (SheafOfModules.unit (wcRingSheaf O' ℓ)) = e := by
    intro e
    let R := wcRingSheaf O' ℓ
    let s := (SheafOfModules.unit R).unitHomEquiv e
    let σ : ∀ X : (O'.ProEt)ᵒᵖ, R.obj.obj X := fun X => (s.1 X : R.obj.obj X)
    have hσ : ∀ {X Y : (O'.ProEt)ᵒᵖ} (g : X ⟶ Y), (R.obj.map g).hom (σ X) = σ Y :=
      fun g => PresheafOfModules.sections_property s g
    let L : ∀ (M : SheafOfModules.{u+1} R) (X : (O'.ProEt)ᵒᵖ), M.val.obj X ⟶ M.val.obj X :=
      fun M X => ModuleCat.ofHom
        { toFun := fun x => σ X • x
          map_add' := fun x y => smul_add _ _ _
          map_smul' := fun r x => by
            simp only [RingHom.id_apply, smul_smul]
            rw [hcomm X] }
    let mM : ∀ M : SheafOfModules.{u+1} R, M ⟶ M := fun M =>
      ⟨PresheafOfModules.Hom.mk (L M) (by
        intro X Y g
        ext x
        show σ Y • (M.val.map g).hom x = (M.val.map g).hom (σ X • x)
        rw [PresheafOfModules.map_smul, hσ])⟩
    refine ⟨{ app := mM, naturality := ?_ }, ?_⟩
    · intro M N g
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro X
      ext x
      show σ X • (g.val.app X).hom x = (g.val.app X).hom (σ X • x)
      exact ((g.val.app X).hom.map_smul _ _).symm
    · apply (SheafOfModules.unit R).unitHomEquiv.injective
      apply PresheafOfModules.sections_ext
      intro X
      rw [SheafOfModules.unitHomEquiv_apply_coe]
      show σ X • (1 : R.obj.obj X) = s.1 X
      rw [smul_eq_mul, mul_one]
  have hcen : ∀ (m : 𝟭 (SheafOfModules.{u+1} (wcRingSheaf O' ℓ)) ⟶
      𝟭 (SheafOfModules.{u+1} (wcRingSheaf O' ℓ))) {A : SheafOfModules.{u+1} (wcRingSheaf O' ℓ)}
      (z : Abelian.Ext A (SheafOfModules.unit (wcRingSheaf O' ℓ)) n),
      (Abelian.Ext.mk₀ (m.app A)).comp z (zero_add n) =
        z.comp (Abelian.Ext.mk₀ (m.app (SheafOfModules.unit (wcRingSheaf O' ℓ)))) (add_zero n) := by
    intro m A z
    have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp z m
    simp only [Abelian.Ext.id_mapExactFunctor] at h
    exact h.symm

  have hR : (Abelian.Ext.mk₀ ε').comp ((Abelian.Ext.mapExactFunctor Do'.Φ
          ((Abelian.Ext.mk₀ τ₁).comp ((Abelian.Ext.mapExactFunctor Df.Φ x).comp
            (Abelian.Ext.mk₀ Df.μ.hom) (add_zero n)) (zero_add n))).comp
          (Abelian.Ext.mk₀ Do'.μ.hom) (add_zero n)) (zero_add n) =
      (Abelian.Ext.mk₀ (ε' ≫ Do'.Φ.map τ₁)).comp
        ((Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Do'.Φ) x).comp
          (Abelian.Ext.mk₀ (Do'.Φ.map Df.μ.hom ≫ Do'.μ.hom)) (add_zero n)) (zero_add n) := by
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_mapExactFunctor, h4, h3, h2]

  have hL : (Abelian.Ext.mk₀ DfO.μ.inv).comp ((Abelian.Ext.mapExactFunctor DfO.Φ
          ((Abelian.Ext.mk₀ ε).comp ((Abelian.Ext.mapExactFunctor Do.Φ x).comp
            (Abelian.Ext.mk₀ Do.μ.hom) (add_zero n)) (zero_add n))).comp
          (Abelian.Ext.mk₀ DfO.μ.hom) (add_zero n)) (zero_add n) =
      (Abelian.Ext.mk₀ (DfO.μ.inv ≫ DfO.Φ.map ε)).comp
        ((Abelian.Ext.mapExactFunctor (Do.Φ ⋙ DfO.Φ) x).comp
          (Abelian.Ext.mk₀ (DfO.Φ.map Do.μ.hom ≫ DfO.μ.hom)) (add_zero n)) (zero_add n) := by
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_mapExactFunctor, h4, h3, h2]

  have nat' : (Abelian.Ext.mapExactFunctor (Do.Φ ⋙ DfO.Φ) x).comp
      (Abelian.Ext.mk₀ (θ.inv.app (SheafOfModules.unit (wcRingSheaf Y ℓ)))) (add_zero n) =
      (Abelian.Ext.mk₀ (θ.inv.app K)).comp
        (Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Do'.Φ) x) (zero_add n) :=
    Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp x θ.inv
  have step1 : (Abelian.Ext.mapExactFunctor (Do.Φ ⋙ DfO.Φ) x).comp
      (Abelian.Ext.mk₀ (DfO.Φ.map Do.μ.hom ≫ DfO.μ.hom)) (add_zero n) =
      ((Abelian.Ext.mk₀ (θ.inv.app K)).comp
        (Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Do'.Φ) x) (zero_add n)).comp
        (Abelian.Ext.mk₀ (θ.hom.app (SheafOfModules.unit (wcRingSheaf Y ℓ)) ≫
          DfO.Φ.map Do.μ.hom ≫ DfO.μ.hom)) (add_zero n) := by
    rw [← nat', h3, Iso.inv_hom_id_app_assoc]

  obtain ⟨m, hm⟩ := hext ((Do'.μ.inv ≫ Do'.Φ.map Df.μ.inv) ≫
    θ.hom.app (SheafOfModules.unit (wcRingSheaf Y ℓ)) ≫ DfO.Φ.map Do.μ.hom ≫ DfO.μ.hom)
  have hBh : (Do'.Φ.map Df.μ.hom ≫ Do'.μ.hom) ≫ (Do'.μ.inv ≫ Do'.Φ.map Df.μ.inv) = 𝟙 _ := by
    simp only [Category.assoc, Iso.hom_inv_id_assoc]
    rw [← Functor.map_comp, Iso.hom_inv_id, CategoryTheory.Functor.map_id]
  have hbb : (Do'.Φ.map Df.μ.hom ≫ Do'.μ.hom) ≫
      m.app (SheafOfModules.unit (wcRingSheaf O' ℓ)) =
      θ.hom.app (SheafOfModules.unit (wcRingSheaf Y ℓ)) ≫ DfO.Φ.map Do.μ.hom ≫ DfO.μ.hom := by
    rw [hm]
    simp only [Category.assoc, Iso.hom_inv_id_assoc]
    rw [← Functor.map_comp_assoc, Iso.hom_inv_id, CategoryTheory.Functor.map_id, Category.id_comp]
  have hmove : (Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Do'.Φ) x).comp
      (Abelian.Ext.mk₀ (θ.hom.app (SheafOfModules.unit (wcRingSheaf Y ℓ)) ≫
          DfO.Φ.map Do.μ.hom ≫ DfO.μ.hom)) (add_zero n) =
      (Abelian.Ext.mk₀ (m.app (Do'.Φ.obj (Df.Φ.obj K)))).comp
        ((Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Do'.Φ) x).comp
          (Abelian.Ext.mk₀ (Do'.Φ.map Df.μ.hom ≫ Do'.μ.hom)) (add_zero n)) (zero_add n) := by
    rw [← hbb]
    exact (h3 (Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Do'.Φ) x) (Do'.Φ.map Df.μ.hom ≫ Do'.μ.hom)
      (m.app (SheafOfModules.unit (wcRingSheaf O' ℓ)))).symm.trans (hcen m _).symm

  haveI : Mono (Do'.Φ.map (Df.Φ.map ιK)) := inferInstance
  have n1 : Do'.Φ.map (Df.Φ.map ιK) ≫ m.app (Do'.Φ.obj (Df.Φ.obj
      (SheafOfModules.unit (wcRingSheaf Y ℓ)))) =
      m.app (Do'.Φ.obj (Df.Φ.obj K)) ≫ Do'.Φ.map (Df.Φ.map ιK) :=
    m.naturality (Do'.Φ.map (Df.Φ.map ιK))
  have n2 : DfO.Φ.map (Do.Φ.map ιK) ≫ θ.inv.app (SheafOfModules.unit (wcRingSheaf Y ℓ)) =
      θ.inv.app K ≫ Do'.Φ.map (Df.Φ.map ιK) := θ.inv.naturality ιK
  have n3 : (Do'.Φ.map Df.μ.hom ≫ Do'.μ.hom) ≫ m.app (SheafOfModules.unit (wcRingSheaf O' ℓ)) =
      m.app (Do'.Φ.obj (Df.Φ.obj (SheafOfModules.unit (wcRingSheaf Y ℓ)))) ≫
        (Do'.Φ.map Df.μ.hom ≫ Do'.μ.hom) :=
    m.naturality (Do'.Φ.map Df.μ.hom ≫ Do'.μ.hom)
  have hmF1 : m.app (Do'.Φ.obj (Df.Φ.obj (SheafOfModules.unit (wcRingSheaf Y ℓ)))) =
      θ.hom.app (SheafOfModules.unit (wcRingSheaf Y ℓ)) ≫ (DfO.Φ.map Do.μ.hom ≫ DfO.μ.hom) ≫
        (Do'.μ.inv ≫ Do'.Φ.map Df.μ.inv) := by
    calc m.app (Do'.Φ.obj (Df.Φ.obj (SheafOfModules.unit (wcRingSheaf Y ℓ))))
        = (m.app (Do'.Φ.obj (Df.Φ.obj (SheafOfModules.unit (wcRingSheaf Y ℓ)))) ≫
            (Do'.Φ.map Df.μ.hom ≫ Do'.μ.hom)) ≫ (Do'.μ.inv ≫ Do'.Φ.map Df.μ.inv) := by
          rw [Category.assoc, hBh]
          exact (Category.comp_id _).symm
      _ = ((Do'.Φ.map Df.μ.hom ≫ Do'.μ.hom) ≫ m.app (SheafOfModules.unit (wcRingSheaf O' ℓ))) ≫
            (Do'.μ.inv ≫ Do'.Φ.map Df.μ.inv) := by rw [← n3]
      _ = (θ.hom.app (SheafOfModules.unit (wcRingSheaf Y ℓ)) ≫
            DfO.Φ.map Do.μ.hom ≫ DfO.μ.hom) ≫ (Do'.μ.inv ≫ Do'.Φ.map Df.μ.inv) := by rw [hbb]
      _ = _ := Category.assoc _ _ _
  have hRP : (ε' ≫ Do'.Φ.map τ₁) ≫ Do'.Φ.map (Df.Φ.map ιK) =
      Do'.μ.inv ≫ Do'.Φ.map Df.μ.inv := by
    rw [Category.assoc, ← Functor.map_comp, hτ, Functor.map_comp, ← Category.assoc, hε']
  have hmor : ((DfO.μ.inv ≫ DfO.Φ.map ε) ≫ θ.inv.app K) ≫ m.app (Do'.Φ.obj (Df.Φ.obj K)) =
      ε' ≫ Do'.Φ.map τ₁ := by
    rw [← cancel_mono (Do'.Φ.map (Df.Φ.map ιK)), hRP]
    calc (((DfO.μ.inv ≫ DfO.Φ.map ε) ≫ θ.inv.app K) ≫ m.app (Do'.Φ.obj (Df.Φ.obj K))) ≫
          Do'.Φ.map (Df.Φ.map ιK)
        = DfO.μ.inv ≫ DfO.Φ.map ε ≫ θ.inv.app K ≫ Do'.Φ.map (Df.Φ.map ιK) ≫
            m.app (Do'.Φ.obj (Df.Φ.obj (SheafOfModules.unit (wcRingSheaf Y ℓ)))) := by
          simp only [Category.assoc]
          rw [n1]
      _ = DfO.μ.inv ≫ DfO.Φ.map ε ≫ DfO.Φ.map (Do.Φ.map ιK) ≫
            θ.inv.app (SheafOfModules.unit (wcRingSheaf Y ℓ)) ≫
            m.app (Do'.Φ.obj (Df.Φ.obj (SheafOfModules.unit (wcRingSheaf Y ℓ)))) := by
          rw [reassoc_of% n2]
      _ = DfO.μ.inv ≫ DfO.Φ.map Do.μ.inv ≫
            θ.inv.app (SheafOfModules.unit (wcRingSheaf Y ℓ)) ≫
            m.app (Do'.Φ.obj (Df.Φ.obj (SheafOfModules.unit (wcRingSheaf Y ℓ)))) := by
          rw [← Functor.map_comp_assoc, hε]
      _ = Do'.μ.inv ≫ Do'.Φ.map Df.μ.inv := by
          rw [hmF1]
          simp only [Category.assoc, Iso.inv_hom_id_app_assoc]
          rw [← Functor.map_comp_assoc, Iso.inv_hom_id, CategoryTheory.Functor.map_id,
            Category.id_comp, Iso.inv_hom_id_assoc]
  have hRHS : (Abelian.Ext.mk₀ DfO.μ.inv).comp ((Abelian.Ext.mapExactFunctor DfO.Φ
          ((Abelian.Ext.mk₀ ε).comp ((Abelian.Ext.mapExactFunctor Do.Φ x).comp
            (Abelian.Ext.mk₀ Do.μ.hom) (add_zero n)) (zero_add n))).comp
          (Abelian.Ext.mk₀ DfO.μ.hom) (add_zero n)) (zero_add n) =
      (Abelian.Ext.mk₀ (ε' ≫ Do'.Φ.map τ₁)).comp
        ((Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Do'.Φ) x).comp
          (Abelian.Ext.mk₀ (Do'.Φ.map Df.μ.hom ≫ Do'.μ.hom)) (add_zero n)) (zero_add n) := by
    rw [hL, step1, h4, hmove, h2, h2]
    simp only [Category.assoc] at hmor ⊢
    rw [hmor]
  rw [hR]
  show _ = (Abelian.Ext.mk₀ DfO.μ.inv).comp ((Abelian.Ext.mapExactFunctor DfO.Φ
          ((Abelian.Ext.mk₀ ε).comp ((Abelian.Ext.mapExactFunctor Do.Φ x).comp
            (Abelian.Ext.mk₀ Do.μ.hom) (add_zero n)) (zero_add n))).comp
          (Abelian.Ext.mk₀ DfO.μ.hom) (add_zero n)) (zero_add n)
  exact hRHS.symm

theorem wc_supp_les_boundary_natural {Z Y Z' Y' : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IsLocallyNoetherian Y]
    (i' : Z' ⟶ Y') [IsClosedImmersion i'] [IsLocallyNoetherian Y']
    (f : Y' ⟶ Y) (g' : Z' ⟶ Z) (hsq : IsPullback i' g' f i)
    (O : Y.Opens) (hO : (O : Set ↥Y) = (Set.range i)ᶜ)
    (O' : Y'.Opens) (hO' : (O' : Set ↥Y') = (Set.range i')ᶜ)
    (fO : O'.toScheme ⟶ O.toScheme) (hfO : fO ≫ O.ι = O'.ι ≫ f)
    (D : wcHMPullData i ℓ) (hD : wcHMPullCanonical D)
    (D' : wcHMPullData i' ℓ) (hD' : wcHMPullCanonical D')
    (Df : wcHMPullData f ℓ) (hDf : wcHMPullCanonical Df)
    (γ : wcSuppObj D' ⟶ Df.Φ.obj (wcSuppObj D))
    (hγ : wcSuppUnitMap D' ≫ γ = Df.μ.inv ≫ Df.Φ.map (wcSuppUnitMap D))
    (Do' : wcHMPullData O'.ι ℓ) (hDo' : wcHMPullCanonical Do')
    (DfO : wcHMPullData fO ℓ) (hDfO : wcHMPullCanonical DfO)
    (n₀ n₁ : ℕ) (hn : n₀ + 1 = n₁) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y' ℓ)) := HasExt.standard _
    ∃ (δ : wcHM O.toScheme ℓ n₀ →+ wcSuppExt D n₁)
      (δ' : wcHM O'.toScheme ℓ n₀ →+ wcSuppExt D' n₁),
      (∀ θ' : wcSuppExt D' n₁, wcSuppClass D' n₁ θ' = 0 → ∃ α' : wcHM O'.toScheme ℓ n₀, δ' α' = θ') ∧
      (∀ x : wcHM Y' ℓ n₀, δ' (wcHMPull Do' n₀ x) = 0) ∧
      (∀ α : wcHM O.toScheme ℓ n₀, δ' (wcHMPull DfO n₀ α) =
