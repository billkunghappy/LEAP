fModules.unit (wcEtZModRing Z ℓ))))).comp ((Abelian.Ext.mapExactFunctor EC.Φ x).comp (Abelian.Ext.mk₀ EC.μ.hom) (add_zero n)) (zero_add n)) = hS.extClass.comp x (add_comm 1 n)) → ∀ (a : wcEtZModExt (A : Scheme.{u}) ℓ n) (b : wcEtZModExt (B : Scheme.{u}) ℓ n) (DA : wcEtPullData A.ι ℓ) (DB : wcEtPullData B.ι ℓ) (Da : wcEtPullData (Z.homOfLE (inf_le_left : A ⊓ B ≤ A)) ℓ) (Db : wcEtPullData (Z.homOfLE (inf_le_right : A ⊓ B ≤ B)) ℓ), wcEtPull Da n a = wcEtPull Db n b → ∃ z : wcEtZModExt Z ℓ n, wcEtPull DA n z = a ∧ wcEtPull DB n z = b :=
