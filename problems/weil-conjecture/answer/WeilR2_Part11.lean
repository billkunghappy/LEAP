      exact h1
    · apply eq.injective
      simp only
      rw [hβ]

  obtain ⟨D2, hD2⟩ := wc_hm_pull_data_exists (Limits.pullback.snd (wcPi2 F X) (wcPi2 F X)) ℓ

  letI : HasExt (SheafOfModules.{u+1}
    (wcRingSheaf (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ)) := HasExt.standard _
  choose f hf hfe using fun a : Fin m =>
    I.extMk_surjective (wcHMPull D2 q (e a)) (q + 1) rfl

  obtain ⟨hgen, hind⟩ :=
    wc_ybar_local_kunneth F X d ℓ hℓ D1 hD1 D2 hD2 I q m hq e hbij f hf hfe

  haveI := D1.cont
  obtain ⟨ι, hιinj, hιloc⟩ := pushforward_homology_local_basis
