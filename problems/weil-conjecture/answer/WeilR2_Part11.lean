    have hS : QuasiSeparatedSpace ↥((𝟭 Scheme).obj W'.left) := inferInstance
    haveI := hC
    haveI : CompactSpace ↥((wcProEtBC g).obj W').left :=
      @QuasiCompact.compactSpace_of_compactSpace _ _ (Limits.pullback.fst W'.hom g) hQCf hC
    haveI : QuasiSeparatedSpace ↥((wcProEtBC g).obj W').left :=
      @quasiSeparatedSpace_of_quasiSeparated _ _ (Limits.pullback.fst W'.hom g) hS hQSf
    have hbij : ∀ k : ℕ, ∀ (z : W'.left), IsClosed ({z} : Set W'.left) → ∀ {Pq : Scheme.{u}}
        (q : Pq ⟶ OK.toScheme) (t : Pq ⟶ Spec (W'.left.presheaf.stalk z)),
