      rw [← hfe a, I.mk₀_comp_extMk]
    rw [Finset.sum_congr rfl (fun a _ => h1 a), hext_sum Finset.univ hs_univ]
    exact hcob q _ hs_univ k hsum

  obtain ⟨DV, hDV⟩ := wc_hm_pull_data_exists
    ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W).hom ℓ
  obtain ⟨D', hD'⟩ := wc_hm_pull_data_exists
    (((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W).hom ≫
      Limits.pullback.snd (wcPi2 F X) (wcPi2 F X)) ℓ
  obtain ⟨Θ, hΘ⟩ := wc_proet_free_slice_module_ext (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ
    ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W) P ev hnat hadd DV hDV q
  have hκ : ∑ a, (Abelian.Ext.mk₀ (wcHMFun
      ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W).left ℓ
      (ContinuousMap.comp (c a : C(↥W.left, ULift.{u+1} ℚ_[ℓ]))
        (Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).base.hom))).comp
      (wcHMPull D' q (e a)) (zero_add q) = 0 := by
    have h2 := congrArg Θ hvan
    rw [map_sum, map_zero] at h2
