    haveI : IsAffine ((𝟭 Scheme.{u}).obj W'.left) := hV.1
    haveI : CompactSpace ((𝟭 Scheme.{u}).obj W'.left) := (inferInstance : CompactSpace W'.left)
    have hYeq : ((wcProEtBC (OU.ι ≫ (AffineSpace (ULift.{u} (Fin d)) U ↘ U))).obj W').left =
        Limits.pullback W'.hom (OU.ι ≫ (AffineSpace (ULift.{u} (Fin d)) U ↘ U)) := by
