    rw [← Adjunction.unit_leftAdjointUniq_hom_app A2 E.adj G]
    exact epi_comp _ _

  haveI hσ : (wcSliceToOver X (Scheme.ProEt.mk V.ι)).IsContinuous
      (Scheme.ProEt.topology (Scheme.ProEt.mk V.ι).left)
      ((Scheme.ProEt.topology X).over (Scheme.ProEt.mk V.ι)) :=
    (wc_slice_over_sites_cont X (Scheme.ProEt.mk V.ι)).1
  haveI hj : (wcSliceFunctor X (Scheme.ProEt.mk V.ι)).IsContinuous
      (Scheme.ProEt.topology (Scheme.ProEt.mk V.ι).left) (Scheme.ProEt.topology X) :=
    Functor.isContinuous_comp (wcSliceToOver X (Scheme.ProEt.mk V.ι))
      (Over.forget (Scheme.ProEt.mk V.ι))
      (Scheme.ProEt.topology (Scheme.ProEt.mk V.ι).left)
      ((Scheme.ProEt.topology X).over (Scheme.ProEt.mk V.ι)) (Scheme.ProEt.topology X)
  haveI hO : IsOpenImmersion (Scheme.ProEt.mk V.ι).hom := (inferInstance : IsOpenImmersion V.ι)
  exact @gen (Scheme.ProEt.mk V.ι) Dj hDj hj hO
