  have hcov : ∀ W : U.ProEt,
      Sieve.generate (fun (W' : U.ProEt) (_ : W' ⟶ W) =>
        IsAffine W'.left ∧ IsClosed {x : W'.left | IsClosed ({x} : Set W'.left)} ∧
          (∀ x : W'.left, ∃! y : W'.left, IsClosed ({y} : Set W'.left) ∧ x ⤳ y) ∧
          ExtremallyDisconnected {x : W'.left | IsClosed ({x} : Set W'.left)} ∧
          (∀ x : W'.left, IsClosed ({x} : Set W'.left) →
            HenselianLocalRing (W'.left.presheaf.stalk x) ∧ IsSepClosed (W'.left.residueField x))) ∈
        Scheme.ProEt.topology U W := by
    intro W
    refine wc_proet_cover_of_affine_local (fun Δ : Scheme.{u} =>
      IsClosed {x : Δ | IsClosed ({x} : Set Δ)} ∧
        (∀ x : Δ, ∃! y : Δ, IsClosed ({y} : Set Δ) ∧ x ⤳ y) ∧
        ExtremallyDisconnected {x : Δ | IsClosed ({x} : Set Δ)} ∧
        (∀ x : Δ, IsClosed ({x} : Set Δ) →
          HenselianLocalRing (Δ.presheaf.stalk x) ∧ IsSepClosed (Δ.residueField x))) ?_ W
    intro V hV
    obtain ⟨Δ, δ, h1, h2, h3, h4, h5, h6, h7⟩ := wc_exists_wcontractible_cover V hV
    exact ⟨Δ, δ, h1, h2, h3, h4, h5, h6, h7⟩
  have ht : 1 ≤ 2 * d - 1 := by omega
  revert hf
  rw [hψ]
  intro hf
  refine sheafOfModules_pushforward_homology_iso_of_local_gen_ind (wcProEtBC g) (wcRingSheaf U ℓ)
    (wcRingSheaf OU.toScheme ℓ) Dg.φ I.cocomplex (2 * d - 1) f hf' hf ?_ ?_
  · intro W s hs
    refine (Scheme.ProEt.topology U).superset_covering ?_ (hcov W)
    rw [Sieve.generate_le_iff]
    intro W' g' hg'
    have hs' : ((I.cocomplex.d (2 * d - 1) (2 * d - 1 + 1)).val.app
        (Opposite.op ((wcProEtBC g).obj W'))).hom
        (((I.cocomplex.X (2 * d - 1)).val.map ((wcProEtBC g).map g').op).hom s) = 0 := by
      refine (PresheafOfModules.naturality_apply (I.cocomplex.d (2 * d - 1) (2 * d - 1 + 1)).val
        ((wcProEtBC g).map g').op s).trans ?_
      show ((I.cocomplex.X (2 * d - 1 + 1)).val.map ((wcProEtBC g).map g').op).hom
        (((I.cocomplex.d (2 * d - 1) (2 * d - 1 + 1)).val.app
          (Opposite.op ((wcProEtBC g).obj W))).hom s) = 0
      rw [hs, map_zero]
    obtain ⟨DV, hDV⟩ := wc_hm_pull_data_exists ((wcProEtBC g).obj W').hom ℓ
    exact ⟨W', 𝟙 _, g',
      (wc_proet_push_cocycle_gen_ind_of_kunneth g ℓ Dg hDg I (2 * d - 1) ht f hf' W' DV hDV
        (hK W' hg' DV hDV)).1 _ hs',
      Category.id_comp g'⟩
  · intro W c' y hcy
    refine (Scheme.ProEt.topology U).superset_covering ?_ (hcov W)
    rw [Sieve.generate_le_iff]
    intro W' g' hg'
    refine ⟨W', 𝟙 _, g', ?_, Category.id_comp g'⟩
    have key : (f.val.app (Opposite.op ((wcProEtBC g).obj W'))).hom
        ((Dg.φ.hom.app (Opposite.op W')).hom (((wcRingSheaf U ℓ).obj.map g'.op).hom c')) =
        ((I.cocomplex.X (2 * d - 1)).val.map ((wcProEtBC g).map g').op).hom
          ((f.val.app (Opposite.op ((wcProEtBC g).obj W))).hom
            ((Dg.φ.hom.app (Opposite.op W)).hom c')) := by
      have h1 : (Dg.φ.hom.app (Opposite.op W')).hom (((wcRingSheaf U ℓ).obj.map g'.op).hom c') =
          ((wcRingSheaf OU.toScheme ℓ).obj.map ((wcProEtBC g).map g').op).hom
            ((Dg.φ.hom.app (Opposite.op W)).hom c') :=
        NatTrans.naturality_apply Dg.φ.hom g'.op c'
      rw [h1]
      exact PresheafOfModules.naturality_apply f.val ((wcProEtBC g).map g').op
        ((Dg.φ.hom.app (Opposite.op W)).hom c')
    have hd' : ((I.cocomplex.d ((ComplexShape.up ℕ).prev (2 * d - 1)) (2 * d - 1)).val.app
        (Opposite.op ((wcProEtBC g).obj W'))).hom
        (((I.cocomplex.X ((ComplexShape.up ℕ).prev (2 * d - 1))).val.map
          ((wcProEtBC g).map g').op).hom y) =
        ((I.cocomplex.X (2 * d - 1)).val.map ((wcProEtBC g).map g').op).hom
          (((I.cocomplex.d ((ComplexShape.up ℕ).prev (2 * d - 1)) (2 * d - 1)).val.app
            (Opposite.op ((wcProEtBC g).obj W))).hom y) :=
      PresheafOfModules.naturality_apply _ _ _
    obtain ⟨DV, hDV⟩ := wc_hm_pull_data_exists ((wcProEtBC g).obj W').hom ℓ
    refine (wc_proet_push_cocycle_gen_ind_of_kunneth g ℓ Dg hDg I (2 * d - 1) ht f hf' W' DV hDV
      (hK W' hg' DV hDV)).2 _
      (((I.cocomplex.X ((ComplexShape.up ℕ).prev (2 * d - 1))).val.map
        ((wcProEtBC g).map g').op).hom y) ?_
    rw [key, hd', hcy]

theorem wc_tl_punct_bundle_kunneth_top (F : Type u) [Finite F] [Field F] (d ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F) (hd : 1 ≤ d)
    {U : Scheme.{u}} (qU : U ⟶ Spec (.of (AlgebraicClosure F)))
    [IsLocallyNoetherian U] [CompactSpace U] [PreconnectedSpace U]
    [LocallyOfFiniteType qU] [Smooth qU]
    (OU : (AffineSpace (ULift.{u} (Fin d)) U).Opens)
    (hOU : (OU : Set ↥(AffineSpace (ULift.{u} (Fin d)) U)) =
      (Set.range (AffineSpace.homOfVector (𝟙 U) (0 : ULift.{u} (Fin d) → Γ(U, ⊤))))ᶜ)
    (OK : (wcTlAff F d).Opens) (hOK : (OK : Set ↥(wcTlAff F d)) = (Set.range (wcTlZero F d))ᶜ)
    (prO : OU.toScheme ⟶ OK.toScheme)
    (hprO : prO ≫ OK.ι = OU.ι ≫ AffineSpace.map (ULift.{u} (Fin d)) qU)
    (Do : wcHMPullData OU.ι ℓ) (hDo : wcHMPullCanonical Do)
    (DprO : wcHMPullData prO ℓ) (hDprO : wcHMPullCanonical DprO) :
    ∀ α : wcHM OU.toScheme ℓ (2 * d - 1),
      ∃ (x : wcHM (AffineSpace (ULift.{u} (Fin d)) U) ℓ (2 * d - 1))
        (αK : wcHM OK.toScheme ℓ (2 * d - 1)),
        α = wcHMPull Do (2 * d - 1) x + wcHMPull DprO (2 * d - 1) αK :=
by
  classical
  intro α
  obtain ⟨Dg, hDg⟩ := wc_hm_pull_data_exists (OU.ι ≫ (AffineSpace (ULift.{u} (Fin d)) U ↘ U)) ℓ
  obtain ⟨Dp, hDp⟩ := wc_hm_pull_data_exists (AffineSpace (ULift.{u} (Fin d)) U ↘ U) ℓ
  obtain ⟨ω, hω⟩ := wc_punct_bundle_push_top_iso F d ℓ hℓ hd qU OU hOU OK hOK prO hprO DprO hDprO
    Dg hDg
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf OU.toScheme ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf U ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf OK.toScheme ℓ)) := HasExt.standard _
  haveI := Dg.additive
  haveI := Dg.presLim
  haveI := Dg.presColim
  haveI := DprO.additive
  haveI := DprO.presLim
  haveI := DprO.presColim
  letI : (@SheafOfModules.pushforward _ _ _ _ _ _
      (wcProEtBC (OU.ι ≫ (AffineSpace (ULift.{u} (Fin d)) U ↘ U))) _ _ Dg.cont Dg.φ).Additive :=
    @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ Dg.adj Dg.additive
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf OU.toScheme ℓ)) :=
    sheafOfModules_enoughInjectives _ _
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf U ℓ)) :=
    sheafOfModules_enoughInjectives _ _
  let I := injectiveResolution (SheafOfModules.unit (wcRingSheaf OU.toScheme ℓ))

  obtain ⟨c, hc, hcω⟩ := I.extMk_surjective
    ((Abelian.Ext.mk₀ Dg.μ.hom).comp (wcHMPull DprO (2 * d - 1) ω) (zero_add _))
    (2 * d - 1 + 1) rfl

  have hf : Dg.adj.homEquiv _ _ c ≫ (((@SheafOfModules.pushforward _ _ _ _ _ _
      (wcProEtBC (OU.ι ≫ (AffineSpace (ULift.{u} (Fin d)) U ↘ U))) _ _ Dg.cont Dg.φ).mapHomologicalComplex
      (ComplexShape.up ℕ)).obj I.cocomplex).d (2 * d - 1) (2 * d - 1 + 1) = 0 := by
    rw [Functor.mapHomologicalComplex_obj_d, ← Adjunction.homEquiv_naturality_right, hc,
      Adjunction.homEquiv_unit, Functor.map_zero, Limits.comp_zero]

  have hiso := hω I c hc hcω hf
  have hunit : IsIso (Dg.adj.unit.app (SheafOfModules.unit (wcRingSheaf U ℓ)) ≫
      (@SheafOfModules.pushforward _ _ _ _ _ _
        (wcProEtBC (OU.ι ≫ (AffineSpace (ULift.{u} (Fin d)) U ↘ U))) _ _ Dg.cont Dg.φ).map Dg.μ.hom) :=
    wc_punct_bundle_supp_unit_iso ℓ d hd OU hOU Dg hDg
  have hvan : ∀ n : ℕ, 1 ≤ n → n ≤ 2 * d - 1 + 1 → n ≠ 2 * d - 1 →
      Limits.IsZero ((((@SheafOfModules.pushforward _ _ _ _ _ _
        (wcProEtBC (OU.ι ≫ (AffineSpace (ULift.{u} (Fin d)) U ↘ U))) _ _ Dg.cont Dg.φ).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj I.cocomplex).homology n) :=
    fun n h1 h2 h3 => wc_punct_bundle_push_vanish F d ℓ hℓ hd qU OU hOU Dg hDg I n h1 (by omega) h3

  obtain ⟨y, b, hxy⟩ := wc_ext_two_class_leray_hirsch Dg.Φ
    (@SheafOfModules.pushforward _ _ _ _ _ _
      (wcProEtBC (OU.ι ≫ (AffineSpace (ULift.{u} (Fin d)) U ↘ U))) _ _ Dg.cont Dg.φ) Dg.adj
    (SheafOfModules.unit (wcRingSheaf U ℓ)) (SheafOfModules.unit (wcRingSheaf OU.toScheme ℓ)) Dg.μ
    I (2 * d - 1) (by omega) c hc hf hunit hvan hiso
    ((Abelian.Ext.mk₀ Dg.μ.hom).comp α (zero_add _))
  rw [hcω] at hxy

  have e2 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf OU.toScheme ℓ)} {n : ℕ}
      (a : A ⟶ B) (b' : B ⟶ C') (z : Abelian.Ext C' D' n),
      (Abelian.Ext.mk₀ a).comp ((Abelian.Ext.mk₀ b').comp z (zero_add n)) (zero_add n) =
        (Abelian.Ext.mk₀ (a ≫ b')).comp z (zero_add n) := by
    intro A B C' D' n a b' z
    rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀]

  have hα : α = (Abelian.Ext.mk₀ Dg.μ.inv).comp
      ((Abelian.Ext.mk₀ Dg.μ.hom).comp α (zero_add _)) (zero_add _) := by
    rw [e2, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]

  have h1 : (Abelian.Ext.mk₀ Dg.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dg.Φ y).comp
      (Abelian.Ext.mk₀ Dg.μ.hom) (add_zero _)) (zero_add _) =
      wcHMPull Do (2 * d - 1) (wcHMPull Dp (2 * d - 1) y) :=
    wc_hm_pull_comp (AffineSpace (ULift.{u} (Fin d)) U ↘ U) OU.ι _ rfl Dp hDp Do hDo Dg hDg
      (2 * d - 1) y

  obtain ⟨s, hs⟩ := wc_hm_unit_end_const U ℓ (Abelian.Ext.homEquiv₀ b)
  have hb : b = Abelian.Ext.mk₀ (wcHMConst U ℓ s) := by
    rw [← hs, Abelian.Ext.mk₀_homEquiv₀_apply]
  have key : wcHMConst OU.toScheme ℓ s ≫ DprO.μ.inv =
      DprO.μ.inv ≫ DprO.Φ.map (wcHMConst OK.toScheme ℓ s) := by
    rw [← wc_hm_pull_const DprO hDprO s]
    simp only [Category.assoc, Iso.hom_inv_id, Category.comp_id]
  have h2 : (Abelian.Ext.mk₀ Dg.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dg.Φ b).comp
      ((Abelian.Ext.mk₀ Dg.μ.hom).comp (wcHMPull DprO (2 * d - 1) ω) (zero_add _)) (zero_add _))
      (zero_add _) =
      wcHMPull DprO (2 * d - 1)
        ((Abelian.Ext.mk₀ (wcHMConst OK.toScheme ℓ s)).comp ω (zero_add _)) := by
    rw [hb, Abelian.Ext.mapExactFunctor_mk₀, e2, e2, Category.assoc, wc_hm_pull_const Dg hDg s]
    show (Abelian.Ext.mk₀ (wcHMConst OU.toScheme ℓ s)).comp
        ((Abelian.Ext.mk₀ DprO.μ.inv).comp ((Abelian.Ext.mapExactFunctor DprO.Φ ω).comp
          (Abelian.Ext.mk₀ DprO.μ.hom) (add_zero _)) (zero_add _)) (zero_add _) =
      (Abelian.Ext.mk₀ DprO.μ.inv).comp ((Abelian.Ext.mapExactFunctor DprO.Φ
        ((Abelian.Ext.mk₀ (wcHMConst OK.toScheme ℓ s)).comp ω (zero_add _))).comp
          (Abelian.Ext.mk₀ DprO.μ.hom) (add_zero _)) (zero_add _)
    rw [e2, key, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero, ← e2]

  refine ⟨wcHMPull Dp (2 * d - 1) y,
    (Abelian.Ext.mk₀ (wcHMConst OK.toScheme ℓ s)).comp ω (zero_add _), ?_⟩
  calc α = (Abelian.Ext.mk₀ Dg.μ.inv).comp
        ((Abelian.Ext.mk₀ Dg.μ.hom).comp α (zero_add _)) (zero_add _) := hα
    _ = _ := by rw [hxy, Abelian.Ext.comp_add, h1, h2]

theorem wc_tl_zero_section_purity_smooth (F : Type u) [Finite F] [Field F] (d ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hℓ : ¬ ℓ ∣ Nat.card F)
    {U : Scheme.{u}} (qU : U ⟶ Spec (.of (AlgebraicClosure F)))
    [IsLocallyNoetherian U] [CompactSpace U] [PreconnectedSpace U]
    [LocallyOfFiniteType qU] [Smooth qU]
    (D0 : wcHMPullData (wcTlZero F d) ℓ) (hD0 : wcHMPullCanonical D0)
    (DZ : wcHMPullData (AffineSpace.homOfVector (𝟙 U) (0 : ULift.{u} (Fin d) → Γ(U, ⊤))) ℓ)
    (hDZ : wcHMPullCanonical DZ) (hepi : Epi (wcSuppUnitMap DZ))
    (Dpr : wcHMPullData (AffineSpace.map (ULift.{u} (Fin d)) qU) ℓ) (hDpr : wcHMPullCanonical Dpr)
    (γ : wcSuppObj DZ ⟶ Dpr.Φ.obj (wcSuppObj D0))
    (hγ : wcSuppUnitMap DZ ≫ γ = Dpr.μ.inv ≫ Dpr.Φ.map (wcSuppUnitMap D0)) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (AffineSpace (ULift.{u} (Fin d)) U) ℓ)) :=
      HasExt.standard _
    Function.Surjective (fun τ : wcSuppExt D0 (2 * d) =>
      (Abelian.Ext.mk₀ γ).comp (wcSuppPullExt D0 Dpr (2 * d) τ) (zero_add _)) :=
by
  classical

  rcases Nat.eq_zero_or_pos d with rfl | hd
  · exact wc_tl_zero_section_purity_dim0 F ℓ hℓ qU D0 hD0 DZ hDZ hepi Dpr hDpr γ hγ
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (AffineSpace (ULift.{u} (Fin d)) U) ℓ)) :=
    HasExt.standard _
  show Function.Surjective _
  intro β

  obtain ⟨h0ci, hzci, hSqZ, hAnoeth⟩ := wc_tl_zero_section_facts F d qU
  haveI := h0ci
  haveI := hzci
  haveI : IsLocallyNoetherian (AffineSpace (ULift.{u} (Fin d)) U) := hAnoeth inferInstance
  haveI : IsLocallyNoetherian (wcTlAff F d) :=
    (wc_tl_zero_section_facts F d (𝟙 (Spec (.of (AlgebraicClosure F))))).2.2.2 inferInstance

  have hℓK : ((ℓ : ℕ) : AlgebraicClosure F) ≠ 0 := by
    intro h
    haveI := Fintype.ofFinite F
    have hF : ((ℓ : ℕ) : F) = 0 := by
      apply (algebraMap F (AlgebraicClosure F)).injective
      rw [map_natCast, map_zero]; exact h
    have h1 : ringChar F ∣ ℓ := ringChar.dvd hF
    have h2 : ringChar F = ℓ :=
      (Nat.prime_dvd_prime_iff_eq (CharP.char_is_prime F (ringChar F)) Fact.out).mp h1
    haveI : CharP F ℓ := ringChar.of_eq h2
    obtain ⟨n, -, hn⟩ := FiniteField.card F ℓ
    apply hℓ
    rw [Nat.card_eq_fintype_card, hn]
    exact dvd_pow_self ℓ n.ne_zero

  obtain ⟨s₁, hs₁, hdisj⟩ : ∃ s₁ : U ⟶ AffineSpace (ULift.{u} (Fin d)) U,
      s₁ ≫ (AffineSpace (ULift.{u} (Fin d)) U ↘ U) = 𝟙 U ∧
      ∀ (t z : ↥U), s₁ t ≠ (AffineSpace.homOfVector (𝟙 U) (0 : ULift.{u} (Fin d) → Γ(U, ⊤))) z := by
    refine ⟨AffineSpace.homOfVector (𝟙 U) (fun _ => 1), AffineSpace.homOfVector_over _ _, ?_⟩
    intro t z h
    have key : ∀ (v : ULift.{u} (Fin d) → Γ(U, ⊤)),
        AffineSpace.homOfVector (𝟙 U) v ⁻¹ᵁ
          (AffineSpace (ULift.{u} (Fin d)) U).basicOpen (AffineSpace.coord U ⟨⟨0, hd⟩⟩) =
          U.basicOpen (v ⟨⟨0, hd⟩⟩) := by
      intro v
      rw [Scheme.preimage_basicOpen]
      erw [AffineSpace.homOfVector_appTop_coord]
      exact rfl
    have ht : t ∈ AffineSpace.homOfVector (𝟙 U) (fun _ => (1 : Γ(U, ⊤))) ⁻¹ᵁ
          (AffineSpace (ULift.{u} (Fin d)) U).basicOpen (AffineSpace.coord U ⟨⟨0, hd⟩⟩) := by
      rw [key]
      show t ∈ U.basicOpen (1 : Γ(U, ⊤))
      rw [Scheme.basicOpen_one]
      trivial
    have hz : z ∈ AffineSpace.homOfVector (𝟙 U) (0 : ULift.{u} (Fin d) → Γ(U, ⊤)) ⁻¹ᵁ
          (AffineSpace (ULift.{u} (Fin d)) U).basicOpen (AffineSpace.coord U ⟨⟨0, hd⟩⟩) := by
      rw [Scheme.Hom.mem_preimage, ← h]
      exact (Scheme.Hom.mem_preimage _).mp ht
    rw [key] at hz
    have h0 : U.basicOpen (0 : Γ(U, ⊤)) = ⊥ := Scheme.basicOpen_zero _ _
    rw [show (0 : ULift.{u} (Fin d) → Γ(U, ⊤)) ⟨⟨0, hd⟩⟩ = 0 from rfl, h0] at hz
    simp at hz

  obtain ⟨OU, hOU⟩ : ∃ O : (AffineSpace (ULift.{u} (Fin d)) U).Opens,
      (O : Set ↥(AffineSpace (ULift.{u} (Fin d)) U)) =
        (Set.range (AffineSpace.homOfVector (𝟙 U) (0 : ULift.{u} (Fin d) → Γ(U, ⊤))))ᶜ :=
    ⟨⟨_, (AffineSpace.homOfVector (𝟙 U)
      (0 : ULift.{u} (Fin d) → Γ(U, ⊤))).isClosedEmbedding.isClosed_range.isOpen_compl⟩, rfl⟩
  obtain ⟨OK, hOK⟩ : ∃ O : (wcTlAff F d).Opens,
      (O : Set ↥(wcTlAff F d)) = (Set.range (wcTlZero F d))ᶜ :=
    ⟨⟨_, (wcTlZero F d).isClosedEmbedding.isClosed_range.isOpen_compl⟩, rfl⟩
  have hrange : Set.range ⇑(OU.ι ≫ AffineSpace.map (ULift.{u} (Fin d)) qU) ⊆ Set.range ⇑OK.ι := by
    rintro _ ⟨w, rfl⟩
    rw [Scheme.Opens.range_ι, hOK, Set.mem_compl_iff]
    rintro ⟨k, hk⟩
    have hw : OU.ι w ∈ Set.range OU.ι := ⟨w, rfl⟩
    rw [Scheme.Opens.range_ι, hOU, Set.mem_compl_iff] at hw
    apply hw
    rw [Scheme.Hom.comp_apply] at hk
    obtain ⟨q, hq1, hq2⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := AffineSpace.map (ULift.{u} (Fin d)) qU) (g := wcTlZero F d) (OU.ι w) k hk.symm
    refine ⟨hSqZ.isoPullback.inv q, ?_⟩
    rw [← hq1, ← hSqZ.isoPullback_inv_fst, Scheme.Hom.comp_apply]
  obtain ⟨prO, hprO⟩ : ∃ prO : OU.toScheme ⟶ OK.toScheme,
      prO ≫ OK.ι = OU.ι ≫ AffineSpace.map (ULift.{u} (Fin d)) qU :=
    ⟨IsOpenImmersion.lift OK.ι _ hrange, IsOpenImmersion.lift_fac _ _ _⟩

  obtain ⟨Dp, hDp⟩ := wc_hm_pull_data_exists (AffineSpace (ULift.{u} (Fin d)) U ↘ U) ℓ
  obtain ⟨Ds, hDs⟩ := wc_hm_pull_data_exists s₁ ℓ
  obtain ⟨D1, hD1⟩ := wc_hm_pull_data_exists (𝟙 U) ℓ
  obtain ⟨Do, hDo⟩ := wc_hm_pull_data_exists OU.ι ℓ
  obtain ⟨DprO, hDprO⟩ := wc_hm_pull_data_exists prO ℓ

  have hcl : wcSuppClass DZ (2 * d) β = 0 := by
    obtain ⟨x, hx⟩ := wc_hm_affine_space_pull_surj (AlgebraicClosure F) ℓ hℓK qU d Dp hDp
      (2 * d) (wcSuppClass DZ (2 * d) β)
    have h1 := wc_supp_class_pull_zero_of_disjoint _ s₁ hdisj DZ hDZ Ds hDs (2 * d) β
    have h2 := wc_hm_pull_comp _ s₁ (𝟙 U) hs₁ Dp hDp Ds hDs D1 hD1 (2 * d) x
    rw [wc_hm_pull_id (𝟙 U) rfl D1 hD1, hx, h1] at h2
    rw [← hx, h2, map_zero]

  obtain ⟨δ, δ', hexact, hkill, hnat⟩ := wc_supp_les_boundary_natural (wcTlZero F d)
    (AffineSpace.homOfVector (𝟙 U) (0 : ULift.{u} (Fin d) → Γ(U, ⊤)))
    (AffineSpace.map (ULift.{u} (Fin d)) qU) qU hSqZ OK hOK OU hOU prO hprO
    D0 hD0 DZ hDZ Dpr hDpr γ hγ Do hDo DprO hDprO (2 * d - 1) (2 * d) (by omega)
  obtain ⟨α, hα⟩ := hexact β hcl

  obtain ⟨x', αK, hdec⟩ := wc_tl_punct_bundle_kunneth_top F d ℓ hℓ hd qU OU hOU OK hOK prO hprO
    Do hDo DprO hDprO α
  refine ⟨δ αK, ?_⟩
  show (Abelian.Ext.mk₀ γ).comp (wcSuppPullExt D0 Dpr (2 * d) (δ αK)) (zero_add _) = β
  rw [← hnat αK, ← hα, hdec, map_add, hkill, zero_add]

theorem wc_tl_diag_chart_nbhd (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [IsProper X.hom] (d : ℕ)
    (U : (wcXbar F X).Opens) (u : U.toScheme ⟶ wcTlAff F d) (hu : Etale u)
    (huK : u ≫ wcTlStr F d = U.ι ≫ wcPi2 F X) :
    ∃ (W : (Limits.pullback (wcPi2 F X) (wcPi2 F X)).Opens) (w₁ w₂ : W.toScheme ⟶ U.toScheme)
      (ΔW : U.toScheme ⟶ W.toScheme)
      (e : W.toScheme ⟶ AffineSpace (ULift.{u} (Fin d)) U.toScheme),
      w₁ ≫ U.ι = W.ι ≫ Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) ∧
      w₂ ≫ U.ι = W.ι ≫ Limits.pullback.snd (wcPi2 F X) (wcPi2 F X) ∧
      ΔW ≫ W.ι = U.ι ≫ Limits.pullback.diagonal (wcPi2 F X) ∧
      IsPullback ΔW U.ι W.ι (Limits.pullback.diagonal (wcPi2 F X)) ∧
      Etale e ∧
      e ≫ AffineSpace.map (ULift.{u} (Fin d)) (U.ι ≫ wcPi2 F X) =
        wcTlDiff F d (W.ι ≫ Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) ≫ wcPi2 F X) u w₁ w₂ ∧
      IsPullback ΔW (𝟙 _) e
        (AffineSpace.homOfVector (𝟙 U.toScheme) (0 : ULift.{u} (Fin d) → Γ(U.toScheme, ⊤))) :=
by
  classical
  open CategoryTheory.Limits in
  have key : ∀ {n : Type u} {Xb K : Scheme.{u}} (π : Xb ⟶ K) (U : Xb.Opens)
      (u : U.toScheme ⟶ 𝔸(n; K)) (hu : Etale u) (huK : u ≫ 𝔸(n; K) ↘ K = U.ι ≫ π),
      ∃ (W : (pullback π π).Opens) (w₁ w₂ : W.toScheme ⟶ U.toScheme)
        (ΔW : U.toScheme ⟶ W.toScheme) (e : W.toScheme ⟶ 𝔸(n; U.toScheme)),
        w₁ ≫ U.ι = W.ι ≫ pullback.fst π π ∧
        w₂ ≫ U.ι = W.ι ≫ pullback.snd π π ∧
        ΔW ≫ W.ι = U.ι ≫ pullback.diagonal π ∧
        IsPullback ΔW U.ι W.ι (pullback.diagonal π) ∧
        Etale e ∧
        e ≫ AffineSpace.map n (U.ι ≫ π) =
          AffineSpace.homOfVector (W.ι ≫ pullback.fst π π ≫ π) (fun i =>
            (w₁ ≫ u).appTop.hom (AffineSpace.coord K i) -
              (w₂ ≫ u).appTop.hom (AffineSpace.coord K i)) ∧
        IsPullback ΔW (𝟙 _) e
          (AffineSpace.homOfVector (𝟙 U.toScheme) (0 : n → Γ(U.toScheme, ⊤))) := by
    intro n Xb K π U u hu huK
    haveI := hu
    set z := AffineSpace.homOfVector (𝟙 U.toScheme) (0 : n → Γ(U.toScheme, ⊤)) with hzdef
    have hpull : ∀ {A B C : Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C) (x : Γ(C, ⊤)),
        f.appTop (g.appTop x) = (f ≫ g).appTop x := by
      intro A B C f g x
      rw [Scheme.Hom.comp_appTop]
      rfl

    obtain ⟨f₁, hf₁⟩ : ∃ f₁, f₁ = pullback.fst (U.ι ≫ π) (U.ι ≫ π) := ⟨_, rfl⟩
    obtain ⟨f₂, hf₂⟩ : ∃ f₂, f₂ = pullback.snd (U.ι ≫ π) (U.ι ≫ π) := ⟨_, rfl⟩
    have hcond : f₁ ≫ U.ι ≫ π = f₂ ≫ U.ι ≫ π := by rw [hf₁, hf₂]; exact pullback.condition

    obtain ⟨j, hjo, hj1, hj2⟩ : ∃ j : pullback (U.ι ≫ π) (U.ι ≫ π) ⟶ pullback π π,
        IsOpenImmersion j ∧ j ≫ pullback.fst π π = f₁ ≫ U.ι ∧
          j ≫ pullback.snd π π = f₂ ≫ U.ι :=
      ⟨pullback.map (U.ι ≫ π) (U.ι ≫ π) π π U.ι U.ι (𝟙 K) (by rw [Category.comp_id])
        (by rw [Category.comp_id]), inferInstance,
        by rw [hf₁]; exact pullback.lift_fst _ _ _, by rw [hf₂]; exact pullback.lift_snd _ _ _⟩
    haveI := hjo

    obtain ⟨eP, heo, hec⟩ : ∃ eP : pullback (U.ι ≫ π) (U.ι ≫ π) ⟶ 𝔸(n; U.toScheme),
        eP ≫ 𝔸(n; U.toScheme) ↘ U.toScheme = f₁ ∧
          ∀ i, eP.appTop (AffineSpace.coord U.toScheme i) =
            (f₁ ≫ u).appTop (AffineSpace.coord K i) -
              (f₂ ≫ u).appTop (AffineSpace.coord K i) :=
      ⟨AffineSpace.homOfVector f₁ _, AffineSpace.homOfVector_over _ _,
        fun i => AffineSpace.homOfVector_appTop_coord _ _ i⟩

    have hetP : Etale eP := by
      obtain ⟨σ, hσo, hσc⟩ : ∃ σ : pullback (U.ι ≫ π) (U.ι ≫ π) ⟶ 𝔸(n; U.toScheme),
          σ ≫ 𝔸(n; U.toScheme) ↘ U.toScheme = f₁ ∧
            ∀ i, σ.appTop (AffineSpace.coord U.toScheme i) =
              (f₂ ≫ u).appTop (AffineSpace.coord K i) :=
        ⟨AffineSpace.homOfVector f₁ _, AffineSpace.homOfVector_over _ _,
          fun i => AffineSpace.homOfVector_appTop_coord _ _ i⟩
      have hsq : σ ≫ AffineSpace.map n (U.ι ≫ π) = f₂ ≫ u := by
        refine AffineSpace.hom_ext ?_ (fun i => ?_)
        · simp only [Category.assoc]
          rw [AffineSpace.map_over, ← Category.assoc σ, hσo, huK, hcond]
        · rw [← hpull σ, AffineSpace.map_appTop_coord, hσc]
      have hout : IsPullback (σ ≫ 𝔸(n; U.toScheme) ↘ U.toScheme) f₂ (U.ι ≫ π)
          (u ≫ 𝔸(n; K) ↘ K) := by
        rw [hσo, huK, hf₁, hf₂]
        exact IsPullback.of_hasPullback _ _
      have hpb : IsPullback σ f₂ (AffineSpace.map n (U.ι ≫ π)) u :=
        IsPullback.of_right hout hsq (AffineSpace.isPullback_map (n := n) (U.ι ≫ π)).flip
      have hσet : Etale σ := MorphismProperty.of_isPullback (P := @Etale) hpb.flip hu
      haveI := hσet
      obtain ⟨τ, hτo, hτc⟩ : ∃ τ : 𝔸(n; U.toScheme) ⟶ 𝔸(n; U.toScheme),
          τ ≫ 𝔸(n; U.toScheme) ↘ U.toScheme = 𝔸(n; U.toScheme) ↘ U.toScheme ∧
            ∀ i, τ.appTop (AffineSpace.coord U.toScheme i) =
              (𝔸(n; U.toScheme) ↘ U.toScheme ≫ u).appTop (AffineSpace.coord K i) -
                AffineSpace.coord U.toScheme i :=
        ⟨AffineSpace.homOfVector _ _, AffineSpace.homOfVector_over _ _,
          fun i => AffineSpace.homOfVector_appTop_coord _ _ i⟩
      have hττ : τ ≫ τ = 𝟙 _ := by
        refine AffineSpace.hom_ext ?_ (fun i => ?_)
        · rw [Category.assoc, hτo, hτo, Category.id_comp]
        · rw [← hpull τ τ, hτc, map_sub, hτc, hpull τ, ← Category.assoc τ, hτo,
            Scheme.Hom.id_appTop]
          simp
      haveI : IsIso τ := ⟨⟨τ, hττ, hττ⟩⟩
      have hfac : eP = σ ≫ τ := by
        refine AffineSpace.hom_ext ?_ (fun i => ?_)
        · rw [heo, Category.assoc, hτo, hσo]
        · rw [hec, ← hpull σ τ, hτc, map_sub, hpull σ, hσc, ← Category.assoc σ, hσo]
      rw [hfac]
      infer_instance
    haveI := hetP

    obtain ⟨ι, hι1, hι2⟩ : ∃ ι : pullback u u ⟶ pullback (U.ι ≫ π) (U.ι ≫ π),
        ι ≫ f₁ = pullback.fst u u ∧ ι ≫ f₂ = pullback.snd u u :=
      ⟨pullback.lift (pullback.fst u u) (pullback.snd u u)
        (by rw [← huK, pullback.condition_assoc]),
        by rw [hf₁]; exact pullback.lift_fst _ _ _, by rw [hf₂]; exact pullback.lift_snd _ _ _⟩
    have hzo : z ≫ 𝔸(n; U.toScheme) ↘ U.toScheme = 𝟙 _ := AffineSpace.homOfVector_over _ _
    have hzc : ∀ i, z.appTop (AffineSpace.coord U.toScheme i) = 0 :=
      fun i => AffineSpace.homOfVector_appTop_coord _ _ i
    have hpbZ : IsPullback ι (pullback.fst u u) eP z := by
      have hw : ι ≫ eP = pullback.fst u u ≫ z := by
        refine AffineSpace.hom_ext ?_ (fun i => ?_)
        · rw [Category.assoc, heo, hι1, Category.assoc, hzo, Category.comp_id]
        · rw [← hpull ι eP, hec, map_sub, hpull ι, hpull ι, ← Category.assoc ι f₁,
            ← Category.assoc ι f₂, hι1, hι2, pullback.condition, sub_self,
            ← hpull (pullback.fst u u), hzc, map_zero]
      refine IsPullback.of_isLimit (PullbackCone.IsLimit.mk hw
        (fun s => pullback.lift (s.fst ≫ f₁) (s.fst ≫ f₂) ?_) ?_ ?_ ?_)
      · refine AffineSpace.hom_ext ?_ (fun i => ?_)
        · simp only [Category.assoc]
          rw [huK, hcond]
        · have hc : (s.fst ≫ eP).appTop (AffineSpace.coord U.toScheme i) =
              (s.snd ≫ z).appTop (AffineSpace.coord U.toScheme i) := by
            rw [s.condition]
          rw [← hpull s.fst eP, hec, map_sub, hpull s.fst, hpull s.fst, ← hpull s.snd, hzc,
            map_zero, sub_eq_zero] at hc
          simpa only [Category.assoc] using hc
      · intro s
        try dsimp only
        apply pullback.hom_ext
        · rw [← hf₁, Category.assoc, hι1, pullback.lift_fst]
        · rw [← hf₂, Category.assoc, hι2, pullback.lift_snd]
      · intro s
        try dsimp only
        have h1 := s.condition =≫ 𝔸(n; U.toScheme) ↘ U.toScheme
        rw [Category.assoc, Category.assoc, heo, hzo, Category.comp_id] at h1
        rw [pullback.lift_fst, h1]
      · intro s m hm1 _
        try dsimp only
        apply pullback.hom_ext
        · rw [pullback.lift_fst, ← hι1, ← Category.assoc, hm1]
        · rw [pullback.lift_snd, ← hι2, ← Category.assoc, hm1]
    have hιci : IsClosedImmersion ι := by
      haveI : IsClosedImmersion (z ≫ 𝔸(n; U.toScheme) ↘ U.toScheme) := by
        rw [hzo]; infer_instance
      haveI := IsClosedImmersion.of_comp z (𝔸(n; U.toScheme) ↘ U.toScheme)
      exact MorphismProperty.of_isPullback (P := @IsClosedImmersion) hpbZ.flip inferInstance
    haveI := hιci

    haveI hδo : IsOpenImmersion (pullback.diagonal u) := inferInstance

    have hSo : IsOpen ((ι '' (Set.range (pullback.diagonal u))ᶜ)ᶜ) :=
      (ι.isClosedEmbedding.isClosedMap _
        (pullback.diagonal u).isOpenEmbedding.isOpen_range.isClosed_compl).isOpen_compl
    let W' : (pullback (U.ι ≫ π) (U.ι ≫ π)).Opens := ⟨_, hSo⟩
    have hW'mem : ∀ y, y ∈ W' ↔ ∀ z', ι z' = y → z' ∈ Set.range (pullback.diagonal u) := by
      intro y
      change y ∈ (ι '' (Set.range (pullback.diagonal u))ᶜ)ᶜ ↔ _
      simp only [Set.mem_compl_iff, Set.mem_image, not_exists, not_and]
      constructor
      · intro h z' hz
        by_contra hc
        exact h z' hc hz
      · intro h z' hc hz
        exact hc (h z' hz)

    obtain ⟨W, l, hlo, hlj, hlr⟩ : ∃ (W : (pullback π π).Opens)
        (l : W.toScheme ⟶ pullback (U.ι ≫ π) (U.ι ≫ π)),
        IsOpenImmersion l ∧ l ≫ j = W.ι ∧ ∀ y, y ∈ Set.range l ↔ y ∈ W' := by
      refine ⟨j ''ᵁ W', (j.isoImage W').inv ≫ W'.ι, inferInstance, ?_, ?_⟩
      · rw [Category.assoc, Scheme.Hom.isoImage_inv_ι]
      · intro y
        constructor
        · rintro ⟨w, rfl⟩
          rw [Scheme.Hom.comp_apply]
          have : W'.ι ((j.isoImage W').inv w) ∈ Set.range W'.ι := ⟨_, rfl⟩
          rwa [Scheme.Opens.range_ι] at this
        · intro hy
          have hy' : y ∈ Set.range W'.ι := by rw [Scheme.Opens.range_ι]; exact hy
          obtain ⟨x, rfl⟩ := hy'
          refine ⟨(j.isoImage W').hom x, ?_⟩
          rw [Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply (j.isoImage W').hom,
            Iso.hom_inv_id]
          rfl
    haveI := hlo

    have hrng : Set.range (pullback.diagonal u ≫ ι) ⊆ Set.range l := by
      rintro _ ⟨x, rfl⟩
      rw [hlr, hW'mem]
      intro z' hz
      rw [Scheme.Hom.comp_apply] at hz
      exact ⟨x, (ι.isClosedEmbedding.isEmbedding.injective hz).symm⟩
    obtain ⟨ΔW, hΔW⟩ : ∃ ΔW : U.toScheme ⟶ W.toScheme, ΔW ≫ l = pullback.diagonal u ≫ ι :=
      ⟨IsOpenImmersion.lift l _ hrng, IsOpenImmersion.lift_fac _ _ _⟩
    have c1 : (l ≫ f₁) ≫ U.ι = W.ι ≫ pullback.fst π π := by
      rw [← hlj]
      simp only [Category.assoc]
      rw [hj1]
    have c2 : (l ≫ f₂) ≫ U.ι = W.ι ≫ pullback.snd π π := by
      rw [← hlj]
      simp only [Category.assoc]
      rw [hj2]
    have c3 : ΔW ≫ W.ι = U.ι ≫ pullback.diagonal π := by
      rw [← hlj, ← Category.assoc, hΔW]
      apply pullback.hom_ext
      · simp only [Category.assoc]
        rw [hj1, ← Category.assoc ι, hι1, pullback.diagonal_fst_assoc, pullback.diagonal_fst,
          Category.comp_id]
      · simp only [Category.assoc]
        rw [hj2, ← Category.assoc ι, hι2, pullback.diagonal_snd_assoc, pullback.diagonal_snd,
          Category.comp_id]
    have c4 : IsPullback ΔW U.ι W.ι (pullback.diagonal π) := by
      have key : ∀ s : PullbackCone W.ι (pullback.diagonal π),
          (s.fst ≫ l ≫ f₁) ≫ U.ι = s.snd := by
        intro s
        have h1 := s.condition =≫ pullback.fst π π
        rw [Category.assoc, Category.assoc, pullback.diagonal_fst, Category.comp_id, ← c1] at h1
        rw [← h1]
        simp only [Category.assoc]
      refine IsPullback.of_isLimit (PullbackCone.IsLimit.mk c3
        (fun s => s.fst ≫ l ≫ f₁) (fun s => ?_) (fun s => key s) (fun s m _ hm2 => ?_))
      · rw [← cancel_mono W.ι, Category.assoc _ ΔW W.ι, c3, ← Category.assoc (s.fst ≫ l ≫ f₁),
          key, s.condition]
      · rw [← cancel_mono U.ι, hm2, key]
    have c6 : (l ≫ eP) ≫ AffineSpace.map n (U.ι ≫ π) =
        AffineSpace.homOfVector (W.ι ≫ pullback.fst π π ≫ π) (fun i =>
          ((l ≫ f₁) ≫ u).appTop.hom (AffineSpace.coord K i) -
            ((l ≫ f₂) ≫ u).appTop.hom (AffineSpace.coord K i)) := by
      refine AffineSpace.hom_ext ?_ (fun i => ?_)
      · rw [AffineSpace.homOfVector_over]
        simp only [Category.assoc]
        rw [AffineSpace.map_over, ← Category.assoc eP, heo, ← Category.assoc W.ι, ← c1]
        simp only [Category.assoc]
      · rw [AffineSpace.homOfVector_appTop_coord, ← hpull (l ≫ eP),
          AffineSpace.map_appTop_coord, ← hpull l, hec, map_sub, hpull l, hpull l]
        simp only [Category.assoc]
    have c7 : IsPullback ΔW (𝟙 _) (l ≫ eP) z := by
      have hw : ΔW ≫ l ≫ eP = 𝟙 _ ≫ z := by
        rw [← Category.assoc, hΔW, Category.assoc, hpbZ.w, pullback.diagonal_fst_assoc,
          Category.id_comp]
      have key : ∀ s : PullbackCone (l ≫ eP) z, s.snd ≫ ΔW = s.fst := by
        intro s
        have hc : (s.fst ≫ l) ≫ eP = s.snd ≫ z := by rw [Category.assoc]; exact s.condition
        obtain ⟨c, hc1, hc2⟩ : ∃ c, c ≫ ι = s.fst ≫ l ∧ c ≫ pullback.fst u u = s.snd :=
          ⟨hpbZ.lift _ _ hc, hpbZ.lift_fst _ _ _, hpbZ.lift_snd _ _ _⟩
        have hcr : Set.range c ⊆ Set.range (pullback.diagonal u) := by
          rintro _ ⟨x, rfl⟩
          have hm : ι (c x) ∈ W' := by
            rw [← hlr]
            have h2 : (c ≫ ι) x = (s.fst ≫ l) x := by rw [hc1]
            rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h2
            rw [h2]
            exact ⟨_, rfl⟩
          exact (hW'mem _).1 hm (c x) rfl
        have e1 := IsOpenImmersion.lift_fac (pullback.diagonal u) c hcr
        have e2 : IsOpenImmersion.lift (pullback.diagonal u) c hcr = s.snd := by
          calc IsOpenImmersion.lift (pullback.diagonal u) c hcr
              = IsOpenImmersion.lift (pullback.diagonal u) c hcr ≫ pullback.diagonal u ≫
                  pullback.fst u u := by rw [pullback.diagonal_fst, Category.comp_id]
            _ = c ≫ pullback.fst u u := by rw [← Category.assoc, e1]
            _ = s.snd := hc2
        have hcd : c = s.snd ≫ pullback.diagonal u := by
          calc c = IsOpenImmersion.lift (pullback.diagonal u) c hcr ≫ pullback.diagonal u :=
                e1.symm
            _ = s.snd ≫ pullback.diagonal u := by rw [e2]
        rw [← cancel_mono l, Category.assoc, hΔW, ← Category.assoc, ← hcd, hc1]
      exact IsPullback.of_isLimit (PullbackCone.IsLimit.mk hw (fun s => s.snd) key
        (fun s => Category.comp_id _) (fun s m _ hm2 => by rwa [Category.comp_id] at hm2))
    exact ⟨W, l ≫ f₁, l ≫ f₂, ΔW, l ≫ eP, c1, c2, c3, c4, inferInstance, c6, c7⟩
  obtain ⟨W, w₁, w₂, ΔW, e, h1, h2, h3, h4, h5, h6, h7⟩ := key (wcPi2 F X) U u hu huK
  exact ⟨W, w₁, w₂, ΔW, e, h1, h2, h3, h4, h5, h6, h7⟩

theorem wc_tl_xbar_open_facts (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (U : (wcXbar F X).Opens) :
    PreconnectedSpace U.toScheme ∧ CompactSpace U.toScheme ∧ IsLocallyNoetherian U.toScheme ∧
      IsLocallyNoetherian (Limits.pullback (wcPi2 F X) (wcPi2 F X)) :=
by
  classical
  haveI hXc : CompactSpace (wcXbar F X) :=
    QuasiCompact.compactSpace_of_compactSpace (wcPi2 F X)
  haveI : AlgebraicGeometry.IsNoetherian (wcXbar F X) := AlgebraicGeometry.IsNoetherian.mk
  haveI hirr : IrreducibleSpace (wcXbar F X) :=
    GeometricallyIrreducible.geometrically_irreducibleSpace (f := X.hom)
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) _ _
      (IsPullback.of_hasPullback _ _)
  refine ⟨Subtype.preconnectedSpace
      ((IrreducibleSpace.isIrreducible_univ _).isPreirreducible.open_subset
        U.isOpen (Set.subset_univ _)).isPreconnected,
    @TopologicalSpace.NoetherianSpace.compactSpace _ _
      (TopologicalSpace.NoetherianSpace.set (U : Set (wcXbar F X))),
    inferInstance, inferInstance⟩

theorem wc_tl_diff_comp (F : Type u) [Field F] (d : ℕ) {M N U : Scheme.{u}} (f : M ⟶ N)
    (q : N ⟶ Spec (.of (AlgebraicClosure F))) (u : U ⟶ wcTlAff F d) (g₁ g₂ : N ⟶ U) :
    f ≫ wcTlDiff F d q u g₁ g₂ = wcTlDiff F d (f ≫ q) u (f ≫ g₁) (f ≫ g₂) :=
by
  unfold wcTlDiff
  rw [AffineSpace.comp_homOfVector]
  congr 1
  funext i
  simp only [Function.comp_apply, map_sub, Category.assoc, Scheme.Hom.comp_appTop,
    CommRingCat.comp_apply]

theorem wc_tl_diag_local_purity (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (DΔ : wcHMPullData (Limits.pullback.diagonal (wcPi2 F X)) ℓ) (hDΔ : wcHMPullCanonical DΔ)
    (θ : wcSuppExt DΔ (2 * d))
    (U : (wcXbar F X).Opens) (u : U.toScheme ⟶ wcTlAff F d) (hu : Etale u)
    (huK : u ≫ wcTlStr F d = U.ι ≫ wcPi2 F X)
    (D0 : wcHMPullData (wcTlZero F d) ℓ) (hD0 : wcHMPullCanonical D0) :
    ∃ τ : wcSuppExt D0 (2 * d),
      ∀ (N : (wcXbar F X).Opens) (hNU : N ≤ U)
        (s : N.toScheme ⟶ Limits.pullback (wcPi2 F X) (wcPi2 F X))
        (_ : s ≫ Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) = N.ι)
        (g₂ : N.toScheme ⟶ U.toScheme)
        (_ : g₂ ≫ U.ι = s ≫ Limits.pullback.snd (wcPi2 F X) (wcPi2 F X))
        (yN : Spec (.of (AlgebraicClosure F)) ⟶ N.toScheme)
        (yX : Spec (.of (AlgebraicClosure F)) ⟶ wcXbar F X)
        (_ : IsPullback yN yX s (Limits.pullback.diagonal (wcPi2 F X)))
        (_ : IsPullback yN (𝟙 _)
          (wcTlDiff F d (N.ι ≫ wcPi2 F X) u ((wcXbar F X).homOfLE hNU) g₂) (wcTlZero F d))
        (Ds : wcHMPullData s ℓ) (_ : wcHMPullCanonical Ds)
        (Dh : wcHMPullData (wcTlDiff F d (N.ι ≫ wcPi2 F X) u ((wcXbar F X).homOfLE hNU) g₂) ℓ)
        (_ : wcHMPullCanonical Dh)
        (DN : wcHMPullData yN ℓ) (_ : wcHMPullCanonical DN)
        (κs : wcSuppObj DN ⟶ Ds.Φ.obj (wcSuppObj DΔ))
        (_ : wcSuppUnitMap DN ≫ κs = Ds.μ.inv ≫ Ds.Φ.map (wcSuppUnitMap DΔ)),
        letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf N.toScheme ℓ)) := HasExt.standard _
