  have M2 : ∀ {l l' : Λ} (t' : l ⟶ l'),
      ((D₀ ⋙ wcEtBaseChange V.ι).map t').left ≫ Limits.pullback.snd (D₀.obj l').hom V.ι =
        Limits.pullback.snd (D₀.obj l).hom V.ι := by
    intro l l' t'
