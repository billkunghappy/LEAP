      inferInstance, inferInstance, sq1, sq2, ?_⟩
    have hp' : αP.inv ≫ p = Spec.map (CommRingCat.ofHom
        (MvPolynomial.C : (Γ(W, ⊤) ⧸ Ideal.span (Set.range h)) →+*
          MvPolynomial (Fin c) (Γ(W, ⊤) ⧸ Ideal.span (Set.range h)))) ≫ αZ.inv := by
