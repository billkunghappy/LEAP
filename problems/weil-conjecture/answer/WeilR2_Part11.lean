    have hA : Function.Bijective (fun z : wcHM ((wcProEtBC g).obj W').left ℓ (2 * d - 1) =>
        (Abelian.Ext.mk₀ (wcHMFun ((wcProEtBC g).obj W').left ℓ
          (τ.comp ((wcProEtBC g).obj W').hom.base.hom))).comp z (zero_add (2 * d - 1))) := by
      refine Function.bijective_iff_has_inverse.mpr ⟨fun z =>
        (Abelian.Ext.mk₀ (wcHMFun ((wcProEtBC g).obj W').left ℓ
          (τ'.comp ((wcProEtBC g).obj W').hom.base.hom))).comp z (zero_add (2 * d - 1)),
        fun z => ?_, fun z => ?_⟩
      · dsimp only
        rw [hFF, ← ContinuousMap.mul_comp, mul_comm τ' τ, hτ', ContinuousMap.one_comp, hF1]
      · dsimp only
