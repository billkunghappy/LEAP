theorem wc_strictHensel_etale_point_lift (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] {X E : Scheme.{u}} (f : Spec (.of A) ⟶ X)
    (e : E ⟶ X) [Etale e] (w : E) (hw : e w = f (IsLocalRing.closedPoint A)) :
    ∃ σ : Spec (.of A) ⟶ E, σ ≫ e = f :=
by
  have Hring : ∀ (E' : Type u) [CommRing E'] [Algebra A E'], Algebra.Etale A E' →
      ∀ φ : E' →ₐ[A] IsLocalRing.ResidueField A,
      ∃ τ : E' →ₐ[A] A, (Algebra.ofId A (IsLocalRing.ResidueField A)).comp τ = φ := by
    intro E' _ _ hE φ
    haveI := hE
    obtain ⟨τ, hτ⟩ := wc_hnas_smooth_section_henselian A E' φ
    refine ⟨τ, ?_⟩
    apply AlgHom.ext
    intro x
    rw [AlgHom.comp_apply, Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq]
    exact hτ x
  obtain ⟨z, hz1, hz2⟩ := Scheme.Pullback.exists_preimage_pullback (f := e) (g := f) w
    (IsLocalRing.closedPoint A) hw
  haveI : Etale (Limits.pullback.snd e f) :=
    MorphismProperty.of_isPullback (P := @Etale) (IsPullback.of_hasPullback e f) ‹Etale e›
  obtain ⟨σ', hσ'⟩ := wc_etale_section_strict_local A Hring (Iso.refl (Spec (.of A)))
    (Limits.pullback.snd e f) z (by rw [Iso.refl_hom]; exact hz2)
  refine ⟨σ' ≫ Limits.pullback.fst e f, ?_⟩
  rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hσ', Category.id_comp]

theorem wc_smooth_pair_compl_strict_stalk_et_vanish (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) (n m : ℕ) [SmoothOfRelativeDimension n pY]
    [IsLocallyNoetherian Y]
