  classical

  obtain ⟨Λ, _, _, D₀, φ, hAff, hφc, hφa, hlim⟩ :=
    wc_weaklyEtale_strictHensel_prosystem (R : Type u) c hc

  obtain ⟨π, hπ1, hπ2, hπ3, hπ4⟩ :=
    wc_et_baseChange_limit_cone V.ι (R : Type u) Λ D₀ φ c hφc hφa hlim Pq q t hP

  haveI : QuasiCompact V.ι := inferInstance
  have hfstQC : ∀ l, QuasiCompact (Limits.pullback.fst (D₀.obj l).hom V.ι) := fun l =>
    MorphismProperty.of_isPullback (P := @QuasiCompact)
      (IsPullback.of_hasPullback (D₀.obj l).hom V.ι).flip inferInstance
  have hfstQS : ∀ l, QuasiSeparated (Limits.pullback.fst (D₀.obj l).hom V.ι) := fun l =>
    MorphismProperty.of_isPullback (P := @QuasiSeparated)
      (IsPullback.of_hasPullback (D₀.obj l).hom V.ι).flip inferInstance
  have hLc : ∀ l, CompactSpace ((D₀ ⋙ wcEtBaseChange V.ι).obj l).left := fun l => by
    haveI : IsAffine ((𝟭 Scheme.{u}).obj (D₀.obj l).left) := hAff l
    haveI : IsAffine (D₀.obj l).left := hAff l
    exact @QuasiCompact.compactSpace_of_compactSpace _ _
      (Limits.pullback.fst (D₀.obj l).hom V.ι) (hfstQC l) inferInstance
  have hLq : ∀ l, QuasiSeparatedSpace ((D₀ ⋙ wcEtBaseChange V.ι).obj l).left := fun l => by
    haveI : IsAffine ((𝟭 Scheme.{u}).obj (D₀.obj l).left) := hAff l
    haveI : IsAffine (D₀.obj l).left := hAff l
    exact @quasiSeparatedSpace_of_quasiSeparated _ _
      (Limits.pullback.fst (D₀.obj l).hom V.ι) inferInstance (hfstQS l)
  have M1 : ∀ {l l' : Λ} (t' : l ⟶ l'),
      ((D₀ ⋙ wcEtBaseChange V.ι).map t').left ≫ Limits.pullback.fst (D₀.obj l').hom V.ι =
        Limits.pullback.fst (D₀.obj l).hom V.ι ≫ (D₀.map t').left := by
    intro l l' t'
