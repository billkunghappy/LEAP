  refine ⟨U l', DU, hDU, hzU l', ?_⟩
  rw [hΘsq _ DU hDU Eι x, h5, map_zero]

theorem wc_zmod_zariski_stalk_limit_vanish {W₀ T : Scheme.{u}} [IsAffine W₀] (g : T ⟶ W₀)
    [QuasiCompact g] [QuasiSeparated g] (n j : ℕ) (z : W₀)
    (Dz : wcZModPullData (Limits.pullback.snd (W₀.fromSpecStalk z) g) n)
    (hDz : wcZModPullCanonical Dz) (h : wcZModProEtExt T n j) (h0 : wcZModPull Dz j h = 0) :
    ∃ (U : W₀.Opens) (DU : wcZModPullData (g ⁻¹ᵁ U).ι n),
      wcZModPullCanonical DU ∧ z ∈ U ∧ wcZModPull DU j h = 0 :=
by
  classical
  rcases Nat.eq_zero_or_pos n with hn | hn
  · subst hn
    exact wc_zmod_zariski_stalk_limit_vanish_int g j z Dz hDz h h0
  · haveI : CompactSpace T := QuasiCompact.compactSpace_of_compactSpace g
    haveI : QuasiSeparatedSpace T := quasiSeparatedSpace_of_quasiSeparated g
    haveI : CompactSpace ↥(Limits.pullback (C := Scheme.{u}) (W₀.fromSpecStalk z) g) :=
      QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.fst (W₀.fromSpecStalk z) g)
    haveI : QuasiSeparatedSpace ↥(Limits.pullback (C := Scheme.{u}) (W₀.fromSpecStalk z) g) :=
      quasiSeparatedSpace_of_quasiSeparated (Limits.pullback.fst (W₀.fromSpecStalk z) g)
    obtain ⟨Λ, _, _, U, D, π, hzU, he, hπ, hπc, hlim, hc, hq, ha⟩ :=
      wc_zmod_stalk_basicOpen_limit g z
    obtain ⟨Θ, hΘb, hΘsq⟩ := wc_zmod_et_proet_natural_comparison n hn j
    obtain ⟨x, rfl⟩ := (hΘb T inferInstance inferInstance).2 h
    obtain ⟨Esn⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.snd (W₀.fromSpecStalk z) g) n
    have h1 : wcEtPull Esn j x = 0 := by
      apply (hΘb _ inferInstance inferInstance).1
      rw [← hΘsq _ Dz hDz Esn x, h0, map_zero]
    obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
    obtain ⟨E₀⟩ := wc_et_zmod_pull_data_exists (D.obj l₀).hom n
    obtain ⟨Eπ⟩ := wc_et_zmod_pull_data_exists (π l₀) n
    have h2 : wcEtPull Eπ j (wcEtPull E₀ j x) = 0 := by
      rw [← wc_et_pull_comp (D.obj l₀).hom (π l₀) _ (hπ l₀) E₀ Eπ Esn j x]
      exact h1
    obtain ⟨l', t, E', h3⟩ := wc_et_limit_pull_kill_qcqs
      (Limits.pullback.snd (W₀.fromSpecStalk z) g) Λ D π hπ hπc hlim hc hq ha
      inferInstance inferInstance n (Nat.pos_iff_ne_zero.mp hn) j l₀ _ Eπ h2
    obtain ⟨E''⟩ := wc_et_zmod_pull_data_exists (D.obj l').hom n
    have h4 : wcEtPull E'' j x = 0 := by
      rw [wc_et_pull_comp (D.obj l₀).hom (D.map t).left (D.obj l').hom
        (MorphismProperty.Over.w (D.map t)) E₀ E' E'' j x]
      exact h3
    obtain ⟨e, hee⟩ := he l'
    obtain ⟨Eι⟩ := wc_et_zmod_pull_data_exists (g ⁻¹ᵁ U l').ι n
    obtain ⟨Ee⟩ := wc_et_zmod_pull_data_exists e n
    have h5 : wcEtPull Eι j x = 0 := by
      rw [wc_et_pull_comp (D.obj l').hom e _ hee E'' Ee Eι j x, h4, map_zero]
    obtain ⟨DU, hDU⟩ := wc_zmod_pull_data_exists (g ⁻¹ᵁ U l').ι n
    refine ⟨U l', DU, hDU, hzU l', ?_⟩
    rw [hΘsq _ DU hDU Eι x, h5, map_zero]

theorem wc_proet_clopen_bc_split : ∀ {T : Scheme.{u}} (O : T.Opens), IsClopen (O : Set T) →
    ∀ (V : T.ProEt) (S' : Sieve ((wcProEtBC O.ι).obj V)),
    S' ∈ Scheme.ProEt.topology (O : Scheme.{u}) ((wcProEtBC O.ι).obj V) →
    ∃ Rv : Presieve V, Sieve.generate Rv ∈ Scheme.ProEt.topology T V ∧
      ∀ ⦃W : T.ProEt⦄ (f : W ⟶ V), Rv f →
        ∃ (m : ℕ) (P : Fin m → (O : Scheme.{u}).ProEt) (ι : ∀ k, P k ⟶ (wcProEtBC O.ι).obj W),
          (∀ k, IsOpenImmersion (ι k).left) ∧
          (∀ x : ((wcProEtBC O.ι).obj W).left, ∃! k, x ∈ Set.range ⇑(ι k).left) ∧
          ∀ k, S' (ι k ≫ (wcProEtBC O.ι).map f) :=
by
  intro T O hO V S' hS'
  classical

  have hiff : ∀ (S : Scheme.{u}) (X : S.ProEt) (R : Sieve X),
      R ∈ Scheme.ProEt.topology S X ↔
        Sieve.functorPushforward (Scheme.ProEt.forget S ⋙ Over.forget S) R ∈
          Scheme.proetaleTopology X.left := by
    intro S X R
    letI := MorphismProperty.IsMultiplicative.toIsStableUnderComposition (W := @WeaklyEtale)
    have h : Scheme.ProEt.topology S =
        (Scheme.ProEt.forget S).restrictedTopology (Scheme.proetaleTopology.over S) :=
      MorphismProperty.toGrothendieck_comap_forget_eq_restrictedTopology (S := S)
        (P := @WeaklyEtale) Scheme.proetalePrecoverage
        Scheme.proetalePrecoverage_le_precoverage_weaklyEtale
    rw [h, Functor.mem_restrictedTopology_iff, GrothendieckTopology.mem_over_iff,
      Sieve.overEquiv_apply, ← Sieve.functorPushforward_comp]
    rfl

  have hfam : ∀ (S : Scheme.{u}) (Q : S.ProEt) (n : ℕ) (W : Fin n → S.ProEt) (h : ∀ k, W k ⟶ Q),
      (∀ k, IsOpenMap ⇑(h k).left) → (∀ x : ↥Q.left, ∃ k, x ∈ Set.range ⇑(h k).left) →
      Sieve.generate (Presieve.ofArrows W h) ∈ Scheme.ProEt.topology S Q := by
    intro S Q n W h hO hJ
    have hs : ∀ x : Q.left, ∃ j y, (h j).left y = x := by
      intro x; obtain ⟨j, y, hy⟩ := hJ x; exact ⟨j, y, hy⟩
    have hw : ∀ i, WeaklyEtale (h i).left := fun i => by
      have h1 : WeaklyEtale ((h i).left ≫ Q.hom) := by
        rw [MorphismProperty.Over.w (h i)]; exact (W i).prop
      exact @WeaklyEtale.of_comp _ _ _ (h i).left Q.hom h1 Q.prop
    have H : Presieve.ofArrows (fun i => (W i).left) (fun i => (h i).left) ∈
        Scheme.proetalePrecoverage.coverings Q.left :=
      ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr (QuasiCompactCover.of_isOpenMap
        (𝒰 := Scheme.Cover.mkOfCovers (P := ⊤) (Fin n) (fun i => (W i).left) (fun i => (h i).left)
          hs (fun _ => trivial)) (fun i => hO i)),
        (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr
          ⟨fun x => by obtain ⟨j, y, hy⟩ := hs x; exact ⟨j, y, hy⟩, hw⟩⟩
    exact Precoverage.generate_mem_toGrothendieck
      (Precoverage.mem_comap_iff.mpr (by rw [Presieve.map_ofArrows]; exact H))

  let Rv : Presieve V := fun ⦃W : T.ProEt⦄ (f : W ⟶ V) =>
    ∃ (m : ℕ) (P : Fin m → (O : Scheme.{u}).ProEt) (ι : ∀ k, P k ⟶ (wcProEtBC O.ι).obj W),
      (∀ k, IsOpenImmersion (ι k).left) ∧
      (∀ x : ((wcProEtBC O.ι).obj W).left, ∃! k, x ∈ Set.range ⇑(ι k).left) ∧
      ∀ k, S' (ι k ≫ (wcProEtBC O.ι).map f)
  refine ⟨Rv, ?_, fun ⦃W⦄ f hf => hf⟩
  haveI : WeaklyEtale V.hom := V.prop
  let O' : T.Opens := ⟨(O : Set T)ᶜ, hO.isClosed.isOpen_compl⟩

  let A : T.ProEt := (wcSliceFunctor T (Scheme.ProEt.mk O.ι)).obj ((wcProEtBC O.ι).obj V)
  let a : A ⟶ V := MorphismProperty.Over.homMk (Limits.pullback.fst V.hom O.ι)
    (Limits.pullback.condition) trivial

  let B : T.ProEt := Scheme.ProEt.mk (Limits.pullback.fst V.hom O'.ι ≫ V.hom)
  let b : B ⟶ V := MorphismProperty.Over.homMk (Limits.pullback.fst V.hom O'.ι) rfl trivial

  have hBnot : ∀ y : ↥(Limits.pullback V.hom O'.ι),
      (Limits.pullback.fst V.hom O'.ι ≫ V.hom) y ∉ (O : Set T) := by
    intro y hy
    rw [Limits.pullback.condition, Scheme.Hom.comp_apply] at hy
    have h2 : O'.ι (Limits.pullback.snd V.hom O'.ι y) ∈ (O' : Set T) :=
      Scheme.Opens.range_ι O' ▸ ⟨_, rfl⟩
    exact h2 hy
  have hempty' : IsEmpty ↥(Limits.pullback (Limits.pullback.fst V.hom O'.ι ≫ V.hom) O.ι) := by
    apply Scheme.isEmpty_pullback
    rw [Set.disjoint_left]
    rintro _ ⟨y, rfl⟩ hz
    apply hBnot y
    rw [Scheme.Opens.range_ι] at hz
    exact hz
  have hempty : IsEmpty ((wcProEtBC O.ι).obj B).left := hempty'
  have hRb : Rv b := ⟨0, Fin.elim0, fun k => k.elim0, fun k => k.elim0,
    fun x => isEmptyElim x, fun k => k.elim0⟩
  have hb : (Sieve.generate Rv).arrows b := ⟨B, 𝟙 B, b, hRb, Category.id_comp b⟩

  have hpush : Sieve.functorPushforward (wcSliceFunctor T (Scheme.ProEt.mk O.ι)) S' ∈
      Scheme.ProEt.topology T A :=
    (hiff T A (Sieve.functorPushforward (wcSliceFunctor T (Scheme.ProEt.mk O.ι)) S')).2
      ((Sieve.functorPushforward_comp (wcSliceFunctor T (Scheme.ProEt.mk O.ι))
        (Scheme.ProEt.forget T ⋙ Over.forget T) S') ▸
          (hiff (Scheme.ProEt.mk O.ι).left ((wcProEtBC O.ι).obj V) S').1 hS')
  have key : ∀ {X : Scheme.{u}} (zh : X ⟶ (O : Scheme.{u})),
      ∃ ℓ : X ⟶ Limits.pullback (zh ≫ O.ι) O.ι,
        ℓ ≫ Limits.pullback.fst (zh ≫ O.ι) O.ι = 𝟙 X ∧
        ℓ ≫ Limits.pullback.snd (zh ≫ O.ι) O.ι = zh ∧
        Limits.pullback.fst (zh ≫ O.ι) O.ι ≫ ℓ = 𝟙 _ := by
    intro X zh
    obtain ⟨ℓ, h1, h2⟩ : ∃ ℓ : X ⟶ Limits.pullback (zh ≫ O.ι) O.ι,
        ℓ ≫ Limits.pullback.fst (zh ≫ O.ι) O.ι = 𝟙 X ∧
        ℓ ≫ Limits.pullback.snd (zh ≫ O.ι) O.ι = zh :=
      ⟨Limits.pullback.lift (𝟙 X) zh (Category.id_comp _), Limits.pullback.lift_fst _ _ _,
        Limits.pullback.lift_snd _ _ _⟩
    refine ⟨ℓ, h1, h2, ?_⟩
    have hfst : Limits.pullback.fst (zh ≫ O.ι) O.ι ≫ zh = Limits.pullback.snd (zh ≫ O.ι) O.ι := by
      rw [← cancel_mono O.ι, Category.assoc]
      exact Limits.pullback.condition
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc, h1, Category.comp_id, Category.id_comp]
    · simp only [Category.assoc, h2, Category.id_comp, hfst]
  have hA : Sieve.pullback a (Sieve.generate Rv) ∈ Scheme.ProEt.topology T A := by
    refine GrothendieckTopology.superset_covering _ ?_ hpush
    rintro Y g ⟨Z, z, hh, hz, rfl⟩
    let f : (wcSliceFunctor T (Scheme.ProEt.mk O.ι)).obj Z ⟶ V :=
      (wcSliceFunctor T (Scheme.ProEt.mk O.ι)).map z ≫ a
    obtain ⟨ℓ, hℓ1, hℓ2, hinv⟩ := key Z.hom
    haveI hiso : IsIso ℓ := ⟨⟨Limits.pullback.fst _ _, hℓ1, hinv⟩⟩
    let ι₀ : Z ⟶ (wcProEtBC O.ι).obj ((wcSliceFunctor T (Scheme.ProEt.mk O.ι)).obj Z) :=
      MorphismProperty.Over.homMk ℓ hℓ2 trivial
    have h1 : ((wcProEtBC O.ι).map f).left ≫ Limits.pullback.fst V.hom O.ι =
        Limits.pullback.fst (Z.hom ≫ O.ι) O.ι ≫ f.left :=
      Limits.pullback.lift_fst _ _ _
    have h2 : ((wcProEtBC O.ι).map f).left ≫ Limits.pullback.snd V.hom O.ι =
        Limits.pullback.snd (Z.hom ≫ O.ι) O.ι :=
      Limits.pullback.lift_snd _ _ _
    have hcomp : ι₀ ≫ (wcProEtBC O.ι).map f = z := by
      apply MorphismProperty.Over.Hom.ext
      have hfst' : ℓ ≫ ((wcProEtBC O.ι).map f).left ≫ Limits.pullback.fst V.hom O.ι =
          z.left ≫ Limits.pullback.fst V.hom O.ι :=
        (congrArg (ℓ ≫ ·) h1).trans ((Category.assoc _ _ _).symm.trans
          ((congrArg (· ≫ f.left) hℓ1).trans (Category.id_comp _)))
      have hsnd' : ℓ ≫ ((wcProEtBC O.ι).map f).left ≫ Limits.pullback.snd V.hom O.ι =
          z.left ≫ Limits.pullback.snd V.hom O.ι :=
        (congrArg (ℓ ≫ ·) h2).trans (hℓ2.trans (MorphismProperty.Over.w z).symm)
      exact Limits.pullback.hom_ext (f := V.hom) (g := O.ι)
        ((Category.assoc _ _ _).trans hfst') ((Category.assoc _ _ _).trans hsnd')
    have hRf : Rv f := by
      refine ⟨1, fun _ => Z, fun _ => ι₀, fun _ => ?_, fun x => ⟨0, ?_, fun k _ => Subsingleton.elim k 0⟩,
        fun _ => ?_⟩
      · exact (inferInstance : IsOpenImmersion ℓ)
      · refine ⟨Limits.pullback.fst (Z.hom ≫ O.ι) O.ι x, ?_⟩
        exact (Scheme.Hom.comp_apply _ ℓ x).symm.trans
          (congrArg (fun g : Limits.pullback (Z.hom ≫ O.ι) O.ι ⟶ Limits.pullback (Z.hom ≫ O.ι) O.ι =>
            g x) hinv)
      · exact (congrArg (fun g => S'.arrows g) hcomp).mpr hz
    exact ⟨_, hh, f, hRf, (Category.assoc _ _ _).symm⟩

  let Yf : Fin 2 → T.ProEt := Fin.cases A (fun _ => B)
  let hf : ∀ k, Yf k ⟶ V := Fin.cases (motive := fun k => Yf k ⟶ V) a (fun _ => b)
  have hopen : ∀ k, IsOpenMap ⇑(hf k).left := by
    intro k
    refine Fin.cases ?_ (fun _ => ?_) k
    · show IsOpenMap ⇑(Limits.pullback.fst V.hom O.ι)
      exact (Limits.pullback.fst V.hom O.ι).isOpenEmbedding.isOpenMap
    · show IsOpenMap ⇑(Limits.pullback.fst V.hom O'.ι)
      exact (Limits.pullback.fst V.hom O'.ι).isOpenEmbedding.isOpenMap
  have hsurj : ∀ x : V.left, ∃ k, x ∈ Set.range ⇑(hf k).left := by
    intro x
    by_cases hx : V.hom x ∈ (O : Set T)
    · refine ⟨0, ?_⟩
      show x ∈ Set.range ⇑(Limits.pullback.fst V.hom O.ι)
      rw [Scheme.Pullback.range_fst, Scheme.Opens.range_ι]
      exact hx
    · refine ⟨1, ?_⟩
      show x ∈ Set.range ⇑(Limits.pullback.fst V.hom O'.ι)
      rw [Scheme.Pullback.range_fst, Scheme.Opens.range_ι]
      exact hx
  have hSb := hfam T V 2 Yf hf hopen hsurj
  refine GrothendieckTopology.transitive _ hSb _ ?_
  intro Y' g hg
  obtain ⟨Y₀, k, g₀, hg₀, rfl⟩ := hg
  rcases hg₀ with ⟨i⟩
  induction i using Fin.cases with
  | zero =>
    rw [Sieve.pullback_comp]
    exact GrothendieckTopology.pullback_stable _ k hA
  | succ j =>
    have hkb : (Sieve.generate Rv).arrows (k ≫ hf j.succ) := Sieve.downward_closed _ hb k
    rw [Sieve.pullback_eq_top_of_mem _ hkb]
    exact GrothendieckTopology.top_mem _ _

theorem wc_zmod_clopen_ext_zero : ∀ {T : Scheme.{u}} (O : T.Opens) (hO : IsClopen (O : Set T)) (n : ℕ)
    (DO : wcZModPullData O.ι n), wcZModPullCanonical DO →
    ∃ s : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC O.ι) _ _ DO.cont DO.φ).obj
        (SheafOfModules.unit (wcZModRingSheaf (O : Scheme.{u}) n)) ⟶
        SheafOfModules.unit (wcZModRingSheaf T n),
      @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC O.ι) _ _ DO.cont DO.φ ≫ s =
        wcZModFun T n (LocallyConstant.charFn (ULift.{u+1} (ZMod n)) hO).toContinuousMap :=
by
  classical
  intro T O hO n DO hDO

  have hrange : ∀ V : T.ProEt,
      Set.range ⇑(Limits.pullback.fst V.hom O.ι) = ⇑V.hom ⁻¹' (O : Set T) := by
    intro V
    rw [Scheme.Pullback.range_fst, Scheme.Opens.range_ι]
  have hoe : ∀ V : T.ProEt, Topology.IsOpenEmbedding ⇑(Limits.pullback.fst V.hom O.ι) :=
    fun V => (Limits.pullback.fst V.hom O.ι).isOpenEmbedding
  have hsurj : ∀ (V : T.ProEt) (p : ↥V.left), V.hom p ∈ (O : Set T) →
      ∃ q, (Limits.pullback.fst V.hom O.ι).base.hom q = p := by
    intro V p hp
    have h : p ∈ Set.range ⇑(Limits.pullback.fst V.hom O.ι) := by
      rw [hrange V]
      exact hp
    exact h
  have hnot : ∀ (V : T.ProEt) (p : ↥V.left), V.hom p ∉ (O : Set T) →
      ¬ ∃ q, (Limits.pullback.fst V.hom O.ι) q = p := by
    intro V p hp hq
    have h : p ∈ Set.range ⇑(Limits.pullback.fst V.hom O.ι) := hq
    rw [hrange V] at h
    exact hp h

  have hext : ∀ (V : T.ProEt) (g : C(↥(Limits.pullback V.hom O.ι), ULift.{u+1} (ZMod n))),
      ∃ e : C(↥V.left, ULift.{u+1} (ZMod n)),
        (∀ q, e ((Limits.pullback.fst V.hom O.ι).base.hom q) = g q) ∧
        (∀ p, V.hom p ∉ (O : Set T) → e p = 0) := by
    intro V g
    have hoe' := hoe V
    have hcomp' : Function.extend ⇑(Limits.pullback.fst V.hom O.ι) ⇑g 0 ∘
        ⇑(Limits.pullback.fst V.hom O.ι) = ⇑g :=
      funext fun q => hoe'.injective.extend_apply _ _ q
    refine ⟨⟨Function.extend ⇑(Limits.pullback.fst V.hom O.ι) ⇑g 0, ?_⟩,
      fun q => hoe'.injective.extend_apply _ _ q, ?_⟩
    · rw [continuous_iff_continuousAt]
      intro p
      by_cases hp : V.hom p ∈ (O : Set T)
      · have hp' : p ∈ Set.range ⇑(Limits.pullback.fst V.hom O.ι) := by
          rw [hrange V]
          exact hp
        obtain ⟨q, rfl⟩ := hp'
        rw [← hoe'.continuousAt_iff, hcomp']
        exact g.continuous.continuousAt
      · have hopen : IsOpen (⇑V.hom ⁻¹' (O : Set T)ᶜ) :=
          hO.isClosed.isOpen_compl.preimage V.hom.continuous
        refine (continuousAt_const (y := (0 : ULift.{u+1} (ZMod n)))).congr ?_
        filter_upwards [hopen.mem_nhds hp] with x hx
        rw [Function.extend_apply' _ _ _ (hnot V x hx)]
        rfl
    · intro p hp
      show Function.extend ⇑(Limits.pullback.fst V.hom O.ι) ⇑g 0 p = 0
      rw [Function.extend_apply' _ _ _ (hnot V p hp)]
      rfl
  choose σ hE1 hE0 using hext

  have hadd : ∀ (V : T.ProEt) (a b : C(↥(Limits.pullback V.hom O.ι), ULift.{u+1} (ZMod n))),
      σ V (a + b) = σ V a + σ V b := by
    intro V a b
    refine ContinuousMap.ext fun x => ?_
    by_cases hx : V.hom x ∈ (O : Set T)
    · obtain ⟨q, rfl⟩ := hsurj V x hx
      simp only [ContinuousMap.add_apply, hE1]
    · simp only [ContinuousMap.add_apply, hE0 V _ x hx, add_zero]
  have hlin : ∀ (V : T.ProEt) (r : C(↥V.left, ULift.{u+1} (ZMod n)))
      (a : C(↥(Limits.pullback V.hom O.ι), ULift.{u+1} (ZMod n))),
      σ V (r.comp (Limits.pullback.fst V.hom O.ι).base.hom * a) = r * σ V a := by
    intro V r a
    refine ContinuousMap.ext fun x => ?_
    by_cases hx : V.hom x ∈ (O : Set T)
    · obtain ⟨q, rfl⟩ := hsurj V x hx
      simp only [ContinuousMap.mul_apply, ContinuousMap.comp_apply, hE1]
    · simp only [ContinuousMap.mul_apply, hE0 V _ x hx, mul_zero]
  have hnat : ∀ {W V : T.ProEt} (k : W ⟶ V)
      (a : C(↥(Limits.pullback V.hom O.ι), ULift.{u+1} (ZMod n))),
      σ W (a.comp ((wcProEtBC O.ι).map k).left.base.hom) = (σ V a).comp k.left.base.hom := by
    intro W V k a
    have hBCf : ((wcProEtBC O.ι).map k).left ≫ Limits.pullback.fst V.hom O.ι =
        Limits.pullback.fst W.hom O.ι ≫ k.left := Limits.pullback.lift_fst _ _ _
    have hw : ∀ x : ↥W.left, V.hom (k.left.base.hom x) = W.hom x := fun x =>
      congrArg (fun h => h.base.hom x) (MorphismProperty.Over.w k)
    refine ContinuousMap.ext fun x => ?_
    by_cases hx : W.hom x ∈ (O : Set T)
    · obtain ⟨q, rfl⟩ := hsurj W x hx
      have hq : (Limits.pullback.fst V.hom O.ι).base.hom (((wcProEtBC O.ι).map k).left.base.hom q) =
          k.left.base.hom ((Limits.pullback.fst W.hom O.ι).base.hom q) :=
        congrArg (fun h => h.base.hom q) hBCf
      show σ W (a.comp ((wcProEtBC O.ι).map k).left.base.hom)
          ((Limits.pullback.fst W.hom O.ι).base.hom q) =
        σ V a (k.left.base.hom ((Limits.pullback.fst W.hom O.ι).base.hom q))
      rw [hE1, ← hq]
      exact (hE1 V a _).symm
    · have hx' : V.hom (k.left.base.hom x) ∉ (O : Set T) := by
        rw [hw x]
        exact hx
      show σ W (a.comp ((wcProEtBC O.ι).map k).left.base.hom) x = σ V a (k.left.base.hom x)
      rw [hE0 W _ x hx, hE0 V _ _ hx']

  obtain ⟨s, hs⟩ : ∃ s : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC O.ι) _ _ DO.cont DO.φ).obj
        (SheafOfModules.unit (wcZModRingSheaf (O : Scheme.{u}) n)) ⟶
        SheafOfModules.unit (wcZModRingSheaf T n),
      ∀ (V : T.ProEt) (a : C(↥(Limits.pullback V.hom O.ι), ULift.{u+1} (ZMod n))),
        ((s.val.app (Opposite.op V)).hom a : C(↥V.left, ULift.{u+1} (ZMod n))) = σ V a := by
    refine ⟨⟨PresheafOfModules.homMk
      { app := fun X => AddCommGrpCat.ofHom (AddMonoidHom.mk' (σ X.unop) (hadd X.unop))
        naturality := fun X X' k => by
          ext x
          exact hnat k.unop x } ?_⟩, fun V a => rfl⟩
    intro X r x
    have h1 := hlin X.unop r x
    rw [← hDO X.unop r] at h1
    exact h1
  refine ⟨s, ?_⟩

  apply (SheafOfModules.unitHomEquiv _).injective
  rw [SheafOfModules.unitHomEquiv_comp_apply]
  apply Subtype.ext
  funext X
  obtain ⟨V⟩ := X
  have hvalP : ((SheafOfModules.unitHomEquiv _) (wcZModFun T n
      (LocallyConstant.charFn (ULift.{u+1} (ZMod n)) hO).toContinuousMap)).1 (Opposite.op V) =
      ((LocallyConstant.charFn (ULift.{u+1} (ZMod n)) hO).toContinuousMap.comp V.hom.base.hom :
        C(↥V.left, ULift.{u+1} (ZMod n))) := by
    simp only [wcZModFun, Equiv.apply_symm_apply]
    rfl
  have hg1 : ((SheafOfModules.unitHomEquiv _)
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC O.ι) _ _ DO.cont DO.φ)).1
        (Opposite.op V) =
      ((1 : C(↥V.left, ULift.{u+1} (ZMod n))).comp (Limits.pullback.fst V.hom O.ι).base.hom :
        C(↥(Limits.pullback V.hom O.ι), ULift.{u+1} (ZMod n))) := by
    rw [SheafOfModules.unitHomEquiv_apply_coe]
    exact hDO V 1
  show (s.val.app (Opposite.op V)).hom (((SheafOfModules.unitHomEquiv _)
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC O.ι) _ _ DO.cont DO.φ)).1
        (Opposite.op V)) =
    ((SheafOfModules.unitHomEquiv _) (wcZModFun T n
      (LocallyConstant.charFn (ULift.{u+1} (ZMod n)) hO).toContinuousMap)).1 (Opposite.op V)
  rw [hg1, hs, hvalP]
  refine ContinuousMap.ext fun x => ?_
  by_cases hx : V.hom x ∈ (O : Set T)
  · obtain ⟨q, rfl⟩ := hsurj V x hx
    rw [hE1]
    show (1 : ULift.{u+1} (ZMod n)) = (LocallyConstant.charFn (ULift.{u+1} (ZMod n)) hO)
      (V.hom.base.hom ((Limits.pullback.fst V.hom O.ι).base.hom q))
    rw [LocallyConstant.coe_charFn]
    exact (Set.indicator_of_mem (f := (1 : ↥T → ULift.{u+1} (ZMod n))) hx).symm
  · rw [hE0 V _ x hx]
    show (0 : ULift.{u+1} (ZMod n)) = (LocallyConstant.charFn (ULift.{u+1} (ZMod n)) hO)
      (V.hom.base.hom x)
    rw [LocallyConstant.coe_charFn]
    exact (Set.indicator_of_notMem hx _).symm

theorem wc_sheafPushforward_preservesEpi_of_split : ∀ {S Z : Scheme.{u}} (G : S.ProEt ⥤ Z.ProEt) [G.IsContinuous (Scheme.ProEt.topology S) (Scheme.ProEt.topology Z)], (∀ (V : S.ProEt) (T : Sieve (G.obj V)), T ∈ Scheme.ProEt.topology Z (G.obj V) → ∃ R : Presieve V, Sieve.generate R ∈ Scheme.ProEt.topology S V ∧ ∀ ⦃W : S.ProEt⦄ (f : W ⟶ V), R f → ∃ (n : ℕ) (P : Fin n → Z.ProEt) (ι : ∀ k, P k ⟶ G.obj W), (∀ k, IsOpenImmersion (ι k).left) ∧ (∀ x : (G.obj W).left, ∃! k, x ∈ Set.range ⇑(ι k).left) ∧ ∀ k, T (ι k ≫ G.map f)) → (G.sheafPushforwardContinuous AddCommGrpCat.{u+1} (Scheme.ProEt.topology S) (Scheme.ProEt.topology Z)).PreservesEpimorphisms :=
by

  have s2a : ∀ {Z : Scheme.{u}} (U : Z.ProEt) (n : ℕ) (P : Fin n → Z.ProEt) (ι : ∀ k, P k ⟶ U),
      (∀ k, IsOpenImmersion (ι k).left) → (∀ x : U.left, ∃ k, x ∈ Set.range ⇑(ι k).left) →
      Presieve.ofArrows P ι ∈ (Scheme.ProEt.precoverage Z).coverings U := by
    intro Z U n P ι hopen hsurj
    show _ ∈ (Precoverage.comap (Scheme.ProEt.forget Z ⋙ Over.forget Z)
      Scheme.proetalePrecoverage).coverings U
    rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
    let 𝒰 : Scheme.Cover (Scheme.precoverage @IsOpenImmersion) U.left :=
      Scheme.Cover.mkOfCovers (Fin n) (fun k => (P k).left) (fun k => (ι k).left)
        (fun x => by
          obtain ⟨k, y, hy⟩ := hsurj x
          exact ⟨k, y, hy⟩) (fun k => hopen k)
    have hqc : QuasiCompactCover 𝒰.toPreZeroHypercover :=
      QuasiCompactCover.of_isOpenMap (fun k => by
        have := hopen k
        exact (ι k).left.isOpenEmbedding.isOpenMap)
    have h1 : 𝒰.presieve₀ ∈ Scheme.qcPrecoverage.coverings U.left :=
      Scheme.presieve₀_mem_qcPrecoverage_iff.mpr hqc
    change Presieve.ofArrows (fun k => (P k).left) (fun k => (ι k).left) ∈
      Scheme.proetalePrecoverage.coverings U.left
    exact ⟨h1, (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr ⟨hsurj, fun k => by
      have := hopen k
      infer_instance⟩⟩

  have s2b : ∀ {Z : Scheme.{u}} (F : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1})
      (U : Z.ProEt) (n : ℕ) (P : Fin n → Z.ProEt) (ι : ∀ k, P k ⟶ U),
      Presieve.ofArrows P ι ∈ (Scheme.ProEt.precoverage Z).coverings U →
      (∀ k, IsOpenImmersion (ι k).left) →
      (∀ (j k : Fin n) (x : U.left), x ∈ Set.range ⇑(ι j).left → x ∈ Set.range ⇑(ι k).left →
        j = k) →
      Function.Bijective (fun t : F.obj.obj (Opposite.op U) =>
        fun k => (F.obj.map (ι k).op).hom t) := by
    intro Z F U n P ι hcov hopen hdisj
    have hF : Presieve.IsSheaf (Scheme.ProEt.topology Z) (F.obj ⋙ forget AddCommGrpCat) :=
      (isSheaf_iff_isSheaf_of_type _ _).mp (GrothendieckTopology.HasSheafCompose.isSheaf _ F.2)
    have hSF : Presieve.IsSheafFor (F.obj ⋙ forget AddCommGrpCat) (Presieve.ofArrows P ι) :=
      Presieve.IsSheaf.isSheafFor_of_mem_precoverage (J := Scheme.ProEt.precoverage Z) hF hcov
    rw [Presieve.isSheafFor_arrows_iff] at hSF
    have hcompat : ∀ x : ∀ k, (F.obj ⋙ forget AddCommGrpCat).obj (Opposite.op (P k)),
        Presieve.Arrows.Compatible (F.obj ⋙ forget AddCommGrpCat) ι x := by
      intro x j k W a b hab
      by_cases hjk : j = k
      · subst hjk
        have := hopen j
        have hm : Mono ((Scheme.ProEt.forget Z ⋙ Over.forget Z).map (ι j)) :=
          IsOpenImmersion.mono (ι j).left
        have : Mono (ι j) := Functor.mono_of_mono_map (Scheme.ProEt.forget Z ⋙ Over.forget Z) hm
        rw [(cancel_mono (ι j)).mp hab]
      · have : IsEmpty W.left := ⟨fun w => hjk (hdisj j k ((ι j).left (a.left w))
          ⟨a.left w, rfl⟩ ⟨b.left w, by
            have e : a.left ≫ (ι j).left = b.left ≫ (ι k).left := congrArg (fun h => h.left) hab
            have hw := congrArg (fun g : W.left ⟶ U.left => g w) e
            simp only [Scheme.Hom.comp_apply] at hw
            exact hw.symm⟩)⟩
        have ht := Sheaf.isTerminalOfBotCover F W (Scheme.ProEt.bot_mem_topology W)
        have hsub : ∀ y : ToType (F.obj.obj (Opposite.op W)), y = 0 := by
          intro y
          have h0 : 𝟙 (F.obj.obj (Opposite.op W)) = 0 := ht.hom_ext _ _
          have := congrArg (fun g => g.hom y) h0
          simpa using this
        exact (hsub _).trans (hsub _).symm
    constructor
    · intro t t' htt
      obtain ⟨u, hu, huniq⟩ := hSF (fun k => (F.obj.map (ι k).op).hom t) (hcompat _)
      have h1 := huniq t (fun k => rfl)
      have h2 := huniq t' (fun k => (congrFun htt k).symm)
      exact h1.trans h2.symm
    · intro x
      obtain ⟨u, hu, -⟩ := hSF x (hcompat x)
      exact ⟨u, funext hu⟩

  intro S Z G _ hsplit
  refine ⟨@fun F₁ F₂ φ hφ => ?_⟩
  have hls : Sheaf.IsLocallySurjective φ :=
    (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} φ).mpr hφ
  have : Presheaf.IsLocallySurjective (Scheme.ProEt.topology Z) φ.hom := hls
  refine (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} _).mp ⟨fun {V} t => ?_⟩
  obtain ⟨R, hRJ, hR⟩ := hsplit V (Presheaf.imageSieve φ.hom t)
    (Presheaf.IsLocallySurjective.imageSieve_mem (J := Scheme.ProEt.topology Z) (f := φ.hom)
      (U := G.obj V) t)
  refine GrothendieckTopology.superset_covering _ ?_ hRJ
  rw [Sieve.generate_le_iff]
  intro W f hf
  obtain ⟨n, P, ι, hopen, huniq, hT⟩ := hR f hf
  have hT' : ∀ k, ∃ s, φ.hom.app (Opposite.op (P k)) s =
      F₂.obj.map (ι k ≫ G.map f).op t := hT
  choose s hs using hT'
  have hcov := s2a (G.obj W) n P ι hopen (fun x => (huniq x).exists)
  have hdisj : ∀ (j k : Fin n) (x : (G.obj W).left), x ∈ Set.range ⇑(ι j).left →
      x ∈ Set.range ⇑(ι k).left → j = k := fun j k x hj hk => (huniq x).unique hj hk
  obtain ⟨u, hu⟩ := (s2b F₁ (G.obj W) n P ι hcov hopen hdisj).2 s
  show ∃ u, φ.hom.app (Opposite.op (G.obj W)) u = F₂.obj.map (G.map f).op t
  refine ⟨u, (s2b F₂ (G.obj W) n P ι hcov hopen hdisj).1 (funext fun k => ?_)⟩
  have huk : (F₁.obj.map (ι k).op).hom u = s k := congrFun hu k
  have e1 := (NatTrans.naturality_apply φ.hom (ι k).op u).symm
  have e4 : F₂.obj.map (ι k ≫ G.map f).op t =
      F₂.obj.map (ι k).op (F₂.obj.map (G.map f).op t) := by
    rw [op_comp, Functor.map_comp]
    rfl
  refine e1.trans ?_
  refine Eq.trans ?_ ((hs k).trans e4)
  exact congrArg _ huk

theorem wc_zmod_clopen_restrict_kill {T : Scheme.{u}} (O : T.Opens) (hO : IsClopen (O : Set T))
    (n j : ℕ) (DO : wcZModPullData O.ι n) (hDO : wcZModPullCanonical DO)
    (h : wcZModProEtExt T n j) (h0 : wcZModPull DO j h = 0) :
    letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T n)) := HasExt.standard _
    (Abelian.Ext.mk₀ (wcZModFun T n
      (LocallyConstant.charFn (ULift.{u+1} (ZMod n)) hO).toContinuousMap)).comp h (zero_add j) = 0 :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T n)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf (O : Scheme.{u}) n)) := HasExt.standard _
  haveI hcont := DO.cont
  haveI := DO.additive
  haveI := DO.presLim
  haveI := DO.presColim

  have hcen : ∀ e : SheafOfModules.unit (wcZModRingSheaf T n) ⟶ SheafOfModules.unit (wcZModRingSheaf T n),
      (Abelian.Ext.mk₀ e).comp h (zero_add j) = h.comp (Abelian.Ext.mk₀ e) (add_zero j) := by
    intro e
    have hcomm : ∀ (X : (T.ProEt)ᵒᵖ) (a b : (wcZModRingSheaf T n).obj.obj X), a * b = b * a := by
      intro X a b
      exact @mul_comm C(↥(Opposite.unop X).left, ULift.{u+1} (ZMod n)) _ a b
    have hext : ∃ m : 𝟭 (SheafOfModules.{u+1} (wcZModRingSheaf T n)) ⟶
        𝟭 (SheafOfModules.{u+1} (wcZModRingSheaf T n)),
        m.app (SheafOfModules.unit (wcZModRingSheaf T n)) = e := by
      let R := wcZModRingSheaf T n
      let s := (SheafOfModules.unit R).unitHomEquiv e
      let σ : ∀ X : (T.ProEt)ᵒᵖ, R.obj.obj X := fun X => (s.1 X : R.obj.obj X)
      have hσ : ∀ {X Y : (T.ProEt)ᵒᵖ} (f : X ⟶ Y), (R.obj.map f).hom (σ X) = σ Y :=
        fun f => PresheafOfModules.sections_property s f
      let L : ∀ (M : SheafOfModules.{u+1} R) (X : (T.ProEt)ᵒᵖ), M.val.obj X ⟶ M.val.obj X :=
        fun M X => ModuleCat.ofHom
          { toFun := fun x => σ X • x
            map_add' := fun x y => smul_add _ _ _
            map_smul' := fun r x => by
              simp only [RingHom.id_apply, smul_smul]
              rw [hcomm X] }
      let mM : ∀ M : SheafOfModules.{u+1} R, M ⟶ M := fun M =>
        ⟨PresheafOfModules.Hom.mk (L M) (by
          intro X Y f
          ext x
          show σ Y • (M.val.map f).hom x = (M.val.map f).hom (σ X • x)
          rw [PresheafOfModules.map_smul, hσ])⟩
      refine ⟨{ app := mM, naturality := ?_ }, ?_⟩
      · intro M N g
        apply SheafOfModules.hom_ext
        apply PresheafOfModules.hom_ext
        intro X
        ext x
        show σ X • (g.val.app X).hom x = (g.val.app X).hom (σ X • x)
        exact ((g.val.app X).hom.map_smul _ _).symm
      · apply (SheafOfModules.unit R).unitHomEquiv.injective
        apply PresheafOfModules.sections_ext
        intro X
        rw [SheafOfModules.unitHomEquiv_apply_coe]
        show σ X • (1 : R.obj.obj X) = s.1 X
        rw [smul_eq_mul, mul_one]
    obtain ⟨m, hm⟩ := hext
    subst hm
    have h1 := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp h m
    simp only [Abelian.Ext.id_mapExactFunctor] at h1
    exact h1.symm

  have hepi := wc_sheafPushforward_preservesEpi_of_split (wcProEtBC O.ι)
    (wc_proet_clopen_bc_split O hO)
  haveI hPE := hepi
  haveI hPH : (@Functor.sheafPushforwardContinuous _ _ _ _ (wcProEtBC O.ι) AddCommGrpCat.{u+1} _
      (Scheme.ProEt.topology T) (Scheme.ProEt.topology (O : Scheme.{u})) DO.cont).PreservesHomology :=
    Functor.preservesHomology_of_preservesEpis_and_kernels _
  haveI hPA : (@Functor.sheafPushforwardContinuous _ _ _ _ (wcProEtBC O.ι) AddCommGrpCat.{u+1} _
      (Scheme.ProEt.topology T) (Scheme.ProEt.topology (O : Scheme.{u})) DO.cont).Additive :=
    Functor.additive_of_preserves_binary_products _
  haveI hPC : Limits.PreservesFiniteColimits
      (@Functor.sheafPushforwardContinuous _ _ _ _ (wcProEtBC O.ι) AddCommGrpCat.{u+1} _
        (Scheme.ProEt.topology T) (Scheme.ProEt.topology (O : Scheme.{u})) DO.cont) :=
    Functor.preservesFiniteColimits_of_preservesHomology _
  haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.ProEt.topology T) (wcZModRingSheaf T n)
  haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.ProEt.topology (O : Scheme.{u}))
    (wcZModRingSheaf (O : Scheme.{u}) n)
  obtain ⟨hPadd, hPlim, hPcol⟩ := sheafOfModules_pushforward_exact (wcProEtBC O.ι)
    (wcZModRingSheaf T n) (wcZModRingSheaf (O : Scheme.{u}) n) DO.φ
  haveI := hPadd
  haveI := hPlim
  haveI := hPcol

  have h0' : (Abelian.Ext.mk₀ DO.μ.inv).comp ((Abelian.Ext.mapExactFunctor DO.Φ h).comp
      (Abelian.Ext.mk₀ DO.μ.hom) (add_zero j)) (zero_add j) = 0 := h0
  have hy : (Abelian.Ext.mapExactFunctor DO.Φ h).comp (Abelian.Ext.mk₀ DO.μ.hom) (add_zero j) = 0 := by
    have e1 : (Abelian.Ext.mk₀ DO.μ.hom).comp ((Abelian.Ext.mk₀ DO.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor DO.Φ h).comp (Abelian.Ext.mk₀ DO.μ.hom) (add_zero j))
        (zero_add j)) (zero_add j) =
        (Abelian.Ext.mapExactFunctor DO.Φ h).comp (Abelian.Ext.mk₀ DO.μ.hom) (add_zero j) := by
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add j) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    refine e1.symm.trans ?_
    rw [h0', Abelian.Ext.comp_zero]
  have hη : (Abelian.Ext.mk₀ (DO.adj.unit.app (SheafOfModules.unit (wcZModRingSheaf T n)))).comp
      (Abelian.Ext.mapExactFunctor (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC O.ι) _ _ DO.cont DO.φ)
        (Abelian.Ext.mapExactFunctor DO.Φ h)) (zero_add j) =
      h.comp (Abelian.Ext.mk₀ (DO.adj.unit.app (SheafOfModules.unit (wcZModRingSheaf T n)))) (add_zero j) := by
    have h1 := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp h DO.adj.unit
    simp only [Abelian.Ext.id_mapExactFunctor, Abelian.Ext.comp_mapExactFunctor] at h1
    exact h1.symm
  have hkill : ∀ g : SheafOfModules.unit (wcZModRingSheaf T n) ⟶
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC O.ι) _ _ DO.cont DO.φ).obj
        (SheafOfModules.unit (wcZModRingSheaf (O : Scheme.{u}) n)),
      h.comp (Abelian.Ext.mk₀ g) (add_zero j) = 0 := by
    intro g
    obtain ⟨g', rfl⟩ : ∃ g' : DO.Φ.obj (SheafOfModules.unit (wcZModRingSheaf T n)) ⟶
        SheafOfModules.unit (wcZModRingSheaf (O : Scheme.{u}) n),
        DO.adj.unit.app _ ≫
          (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC O.ι) _ _ DO.cont DO.φ).map g' = g :=
      ⟨(DO.adj.homEquiv _ _).symm g,
        (DO.adj.homEquiv_unit _ _ _).symm.trans ((DO.adj.homEquiv _ _).apply_symm_apply g)⟩
    have hz : (Abelian.Ext.mapExactFunctor DO.Φ h).comp (Abelian.Ext.mk₀ g') (add_zero j) = 0 := by
      have hg : g' = DO.μ.hom ≫ (DO.μ.inv ≫ g') := by rw [Iso.hom_inv_id_assoc]
      rw [hg, ← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.comp_assoc_of_third_deg_zero, hy,
        Abelian.Ext.zero_comp]
    rw [← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.comp_assoc_of_third_deg_zero, ← hη,
      Abelian.Ext.comp_assoc_of_third_deg_zero,
      ← Abelian.Ext.mapExactFunctor_mk₀
        (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC O.ι) _ _ DO.cont DO.φ) g',
      ← Abelian.Ext.mapExactFunctor_comp, hz, Abelian.Ext.mapExactFunctor_zero, Abelian.Ext.comp_zero]

  obtain ⟨s, hs⟩ := wc_zmod_clopen_ext_zero O hO n DO hDO
  have key : (Abelian.Ext.mk₀ (wcZModFun T n
      (LocallyConstant.charFn (ULift.{u+1} (ZMod n)) hO).toContinuousMap)).comp h (zero_add j) = 0 := by
    rw [hcen, ← hs, ← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.comp_assoc_of_third_deg_zero, hkill,
      Abelian.Ext.zero_comp]
  exact key

theorem wc_zmod_wlocal_closed_point_continuity {W₀ T : Scheme.{u}} (haff : IsAffine W₀)
    (hc : IsClosed {x : W₀ | IsClosed ({x} : Set W₀)})
    (hu : ∀ x : W₀, ∃! y : W₀, IsClosed ({y} : Set W₀) ∧ x ⤳ y)
    (g : T ⟶ W₀) (hqc : QuasiCompact g) (hqs : QuasiSeparated g) (n j : ℕ) (z : W₀)
    (hz : IsClosed ({z} : Set W₀))
    (Dz : wcZModPullData (Limits.pullback.snd (W₀.fromSpecStalk z) g) n) (hDz : wcZModPullCanonical Dz)
    (h : wcZModProEtExt T n j) (h0 : wcZModPull Dz j h = 0) :
    ∃ (V : Set W₀) (hV : IsClopen V), z ∈ V ∧
      (letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T n)) := HasExt.standard _
      (Abelian.Ext.mk₀ (wcZModFun T n ((LocallyConstant.charFn (ULift.{u+1} (ZMod n)) hV).toContinuousMap.comp
        g.base.hom))).comp h (zero_add j) = 0) :=
by
  classical
  haveI := haff
  haveI := hqc
  haveI := hqs
  obtain ⟨U, DU, hDU, hzU, hU0⟩ := wc_zmod_zariski_stalk_limit_vanish g n j z Dz hDz h h0
  obtain ⟨V, hV, hzV, hVU⟩ :=
    wc_wlocal_clopen_nbhd_in_open W₀ hc hu z hz (U : Set W₀) U.isOpen hzU
  let V' : W₀.Opens := ⟨V, hV.isOpen⟩
  let O : T.Opens := g ⁻¹ᵁ V'
  have hle : O ≤ g ⁻¹ᵁ U := g.preimage_mono (fun x hx => hVU hx)
  have hO : IsClopen (O : Set T) := by
    show IsClopen (g.base ⁻¹' V)
    exact hV.preimage g.continuous
  obtain ⟨Di, hDi⟩ := wc_zmod_pull_data_exists (T.homOfLE hle) n
  obtain ⟨DO, hDO⟩ := wc_zmod_pull_data_exists O.ι n
  have hO0 : wcZModPull DO j h = 0 := by
    rw [wc_zmod_pull_comp (g ⁻¹ᵁ U).ι (T.homOfLE hle) O.ι (Scheme.homOfLE_ι T hle) DU hDU
      Di hDi DO hDO j h, hU0, map_zero]
  have hk := wc_zmod_clopen_restrict_kill O hO n j DO hDO h hO0
  have hfun : (LocallyConstant.charFn (ULift.{u+1} (ZMod n)) hV).toContinuousMap.comp g.base.hom =
      (LocallyConstant.charFn (ULift.{u+1} (ZMod n)) hO).toContinuousMap := by
    apply ContinuousMap.ext
    intro t
    show (LocallyConstant.charFn (ULift.{u+1} (ZMod n)) hV) (g.base.hom t) =
      (LocallyConstant.charFn (ULift.{u+1} (ZMod n)) hO) t
    rw [LocallyConstant.coe_charFn, LocallyConstant.coe_charFn]
    by_cases ht : g.base.hom t ∈ V
    · have ht' : t ∈ (O : Set T) := ht
      rw [Set.indicator_of_mem ht, Set.indicator_of_mem ht']
      rfl
    · have ht' : t ∉ (O : Set T) := ht
      rw [Set.indicator_of_notMem ht, Set.indicator_of_notMem ht']
  have G0 : ∀ r r' : C(↥T, ULift.{u+1} (ZMod n)), r = r' →
      letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T n)) := HasExt.standard _
      (Abelian.Ext.mk₀ (wcZModFun T n r)).comp h (zero_add j) =
        (Abelian.Ext.mk₀ (wcZModFun T n r')).comp h (zero_add j) := by
    intro r r' hr
    subst hr
    rfl
  refine ⟨V, hV, hzV, ?_⟩
  exact (G0 _ _ hfun).trans hk

theorem wc_zmod_pull_fun {S S' : Scheme.{u}} {f : S' ⟶ S} {n : ℕ} (D : wcZModPullData f n)
    (hD : wcZModPullCanonical D) (r : C(↥S, ULift.{u+1} (ZMod n))) (j : ℕ) (x : wcZModProEtExt S n j) :
    letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S n)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S' n)) := HasExt.standard _
    wcZModPull D j ((Abelian.Ext.mk₀ (wcZModFun S n r)).comp x (zero_add j)) =
      (Abelian.Ext.mk₀ (wcZModFun S' n (r.comp f.base.hom))).comp (wcZModPull D j x) (zero_add j) :=
by
  classical

  have key : ∀ g : SheafOfModules.unit (wcZModRingSheaf S n) ⟶
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ).obj
        (SheafOfModules.unit (wcZModRingSheaf S' n)),
      wcZModFun S n r ≫ g =
        g ≫ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ).map
          (wcZModFun S' n (r.comp f.base.hom)) := by
    intro g
    apply (SheafOfModules.unitHomEquiv _).injective
    apply PresheafOfModules.sections_ext
    intro X
    cases X with
    | op V =>
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    obtain ⟨a, b, hab, ha1, ha2⟩ : ∃ (a : ↑((wcZModRingSheaf S n).val.obj (Opposite.op V)))
        (b : ↑((wcZModRingSheaf S' n).val.obj (Opposite.op ((wcProEtBC f).obj V)))),
        @Eq ↑((wcZModRingSheaf S' n).val.obj (Opposite.op ((wcProEtBC f).obj V)))
          ((D.φ.hom.app (Opposite.op V)).hom a) b ∧
        (∀ r' : ↑((wcZModRingSheaf S n).val.obj (Opposite.op V)),
          @Eq ↑((wcZModRingSheaf S n).val.obj (Opposite.op V))
            (((wcZModFun S n r).val.app (Opposite.op V)).hom r') (r' * a)) ∧
        (∀ r' : ↑((wcZModRingSheaf S' n).val.obj (Opposite.op ((wcProEtBC f).obj V))),
          @Eq ↑((wcZModRingSheaf S' n).val.obj (Opposite.op ((wcProEtBC f).obj V)))
            (((wcZModFun S' n (r.comp f.base.hom)).val.app
              (Opposite.op ((wcProEtBC f).obj V))).hom r') (r' * b)) :=
      ⟨(r.comp V.hom.base.hom : C(↥V.left, ULift.{u+1} (ZMod n))),
        ((r.comp f.base.hom).comp ((wcProEtBC f).obj V).hom.base.hom :
          C(↥((wcProEtBC f).obj V).left, ULift.{u+1} (ZMod n))),
        (hD V _).trans (ContinuousMap.ext fun x =>
          congrArg (fun k => r (k.base x)) (Limits.pullback.condition (f := V.hom) (g := f))),
        fun r' => rfl, fun r' => rfl⟩
    change (g.val.app (Opposite.op V)).hom (((wcZModFun S n r).val.app (Opposite.op V)).hom
          (@id ↑((SheafOfModules.unit (wcZModRingSheaf S n)).val.obj (Opposite.op V))
            (1 : ↑((wcZModRingSheaf S n).val.obj (Opposite.op V))))) =
        ((wcZModFun S' n (r.comp f.base.hom)).val.app (Opposite.op ((wcProEtBC f).obj V))).hom
          ((g.val.app (Opposite.op V)).hom
            (@id ↑((SheafOfModules.unit (wcZModRingSheaf S n)).val.obj (Opposite.op V))
              (1 : ↑((wcZModRingSheaf S n).val.obj (Opposite.op V)))))
    have e1 : ((wcZModFun S n r).val.app (Opposite.op V)).hom
          (@id ↑((SheafOfModules.unit (wcZModRingSheaf S n)).val.obj (Opposite.op V))
            (1 : ↑((wcZModRingSheaf S n).val.obj (Opposite.op V)))) =
        a • (@id ↑((SheafOfModules.unit (wcZModRingSheaf S n)).val.obj (Opposite.op V))
            (1 : ↑((wcZModRingSheaf S n).val.obj (Opposite.op V)))) := by
      have h := ha1 1
      change @Eq ↑((wcZModRingSheaf S n).val.obj (Opposite.op V))
        (((wcZModFun S n r).val.app (Opposite.op V)).hom
          (1 : ↑((wcZModRingSheaf S n).val.obj (Opposite.op V))))
        (a * 1)
      rw [h, one_mul, mul_one]
    rw [e1, LinearMap.map_smul]
    generalize (g.val.app (Opposite.op V)).hom
      (@id ↑((SheafOfModules.unit (wcZModRingSheaf S n)).val.obj (Opposite.op V))
        (1 : ↑((wcZModRingSheaf S n).val.obj (Opposite.op V)))) = y
    have h2 := ha2 y
    refine Eq.trans ?_ h2.symm
    change @Eq ↑((wcZModRingSheaf S' n).val.obj (Opposite.op ((wcProEtBC f).obj V)))
      (@HMul.hMul ↑((wcZModRingSheaf S' n).val.obj (Opposite.op ((wcProEtBC f).obj V)))
        ↑((wcZModRingSheaf S' n).val.obj (Opposite.op ((wcProEtBC f).obj V)))
        ↑((wcZModRingSheaf S' n).val.obj (Opposite.op ((wcProEtBC f).obj V))) instHMul
        ((D.φ.hom.app (Opposite.op V)).hom a) y)
      (@HMul.hMul ↑((wcZModRingSheaf S' n).val.obj (Opposite.op ((wcProEtBC f).obj V)))
        ↑((wcZModRingSheaf S' n).val.obj (Opposite.op ((wcProEtBC f).obj V)))
        ↑((wcZModRingSheaf S' n).val.obj (Opposite.op ((wcProEtBC f).obj V))) instHMul y b)
    rw [hab]
    exact @mul_comm C(↥(Limits.pullback V.hom f), ULift.{u+1} (ZMod n)) _ b y
  have hmate : D.Φ.map (wcZModFun S n r) ≫ D.μ.hom =
      D.μ.hom ≫ wcZModFun S' n (r.comp f.base.hom) := by
    apply (D.adj.homEquiv _ _).injective
    rw [Adjunction.homEquiv_naturality_left, Adjunction.homEquiv_naturality_right]
    exact key _
  have hmate' : D.μ.inv ≫ D.Φ.map (wcZModFun S n r) =
      wcZModFun S' n (r.comp f.base.hom) ≫ D.μ.inv := by
    calc D.μ.inv ≫ D.Φ.map (wcZModFun S n r)
        = D.μ.inv ≫ D.Φ.map (wcZModFun S n r) ≫ D.μ.hom ≫ D.μ.inv := by
          rw [Iso.hom_inv_id, Category.comp_id]
      _ = D.μ.inv ≫ D.μ.hom ≫ wcZModFun S' n (r.comp f.base.hom) ≫ D.μ.inv := by
          rw [← Category.assoc (D.Φ.map (wcZModFun S n r)), hmate, Category.assoc]
      _ = wcZModFun S' n (r.comp f.base.hom) ≫ D.μ.inv := by
          rw [Iso.inv_hom_id_assoc]

  letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S n)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S' n)) := HasExt.standard _
  haveI := D.additive
  haveI := D.presLim
  haveI := D.presColim
  show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ
        ((Abelian.Ext.mk₀ (wcZModFun S n r)).comp x (zero_add j))).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero j)) (zero_add j) =
      (Abelian.Ext.mk₀ (wcZModFun S' n (r.comp f.base.hom))).comp
        ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ x).comp
          (Abelian.Ext.mk₀ D.μ.hom) (add_zero j)) (zero_add j)) (zero_add j)
  rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
  generalize Abelian.Ext.mapExactFunctor D.Φ x = z
  rw [Abelian.Ext.comp_assoc_of_third_deg_zero]
  generalize z.comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero j) = w
  rw [← Abelian.Ext.comp_assoc_of_second_deg_zero (Abelian.Ext.mk₀ D.μ.inv)
      (Abelian.Ext.mk₀ (D.Φ.map (wcZModFun S n r))) w,
    ← Abelian.Ext.comp_assoc_of_second_deg_zero
      (Abelian.Ext.mk₀ (wcZModFun S' n (r.comp f.base.hom))) (Abelian.Ext.mk₀ D.μ.inv) w,
    Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, hmate']

theorem wc_wcontr_prod_torsion_kunneth (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (W : (wcXbar F X).ProEt)
    (hW : IsAffine W.left ∧ IsClosed {x : W.left | IsClosed ({x} : Set W.left)} ∧
      (∀ x : W.left, ∃! y : W.left, IsClosed ({y} : Set W.left) ∧ x ⤳ y) ∧
      ExtremallyDisconnected {x : W.left | IsClosed ({x} : Set W.left)} ∧
      (∀ x : W.left, IsClosed ({x} : Set W.left) →
        HenselianLocalRing (W.left.presheaf.stalk x) ∧ IsSepClosed (W.left.residueField x)))
    (k j : ℕ) (hk : 1 ≤ k)
    (D₂ : wcZModPullData (((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W).hom ≫
      Limits.pullback.snd (wcPi2 F X) (wcPi2 F X)) (ℓ ^ k)) (hD₂ : wcZModPullCanonical D₂) :
    letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf
      ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W).left (ℓ ^ k))) :=
      HasExt.standard _
    ∃ Ξ : LocallyConstant W.left (wcZModProEtExt (wcXbar F X) (ℓ ^ k) j) ≃+
        wcZModProEtExt ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W).left (ℓ ^ k) j,
      ∀ (V : Set W.left) [∀ x, Decidable (x ∈ V)] (hV : IsClopen V)
        (a : wcZModProEtExt (wcXbar F X) (ℓ ^ k) j),
        Ξ ((LocallyConstant.ofIsClopen hV).map (fun i : Fin 2 => if i = 0 then a else 0)) =
          (Abelian.Ext.mk₀ (wcZModFun
            ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W).left (ℓ ^ k)
            ((((LocallyConstant.ofIsClopen hV).map (fun i : Fin 2 =>
                if i = 0 then (1 : ULift.{u+1} (ZMod (ℓ ^ k))) else 0)).toContinuousMap).comp
              (Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).base.hom))).comp
            (wcZModPull D₂ j a) (zero_add j) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf
    ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W).left (ℓ ^ k))) :=
    HasExt.standard _
  haveI hprop : IsProper (wcPi2 F X) :=
    (show IsProper (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) from inferInstance)
  haveI : IsAffine W.left := hW.1
  haveI : IsAffine ((𝟭 Scheme).obj W.left) := hW.1
  have hQC : QuasiCompact (Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))) :=
    inferInstance
  have hQS : QuasiSeparated (Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))) :=
    inferInstance

  have hℓF : ((ℓ : ℕ) : F) ≠ 0 := by
    intro h0
    haveI : Fact (Nat.Prime (ringChar F)) := ⟨CharP.char_is_prime F (ringChar F)⟩
    have h1 : ringChar F ∣ ℓ := (ringChar.spec F ℓ).mp h0
    have h2 : ringChar F = ℓ :=
      (Nat.prime_dvd_prime_iff_eq (Fact.out : Nat.Prime (ringChar F)) Fact.out).mp h1
    letI := Fintype.ofFinite F
    have h3 : ((Fintype.card F : ℕ) : F) = 0 := FiniteField.cast_card_eq_zero F
    have h4 : ringChar F ∣ Fintype.card F := (ringChar.spec F _).mp h3
    apply hℓ
    rw [← h2, Nat.card_eq_fintype_card]
    exact h4
  have hne : ((ℓ ^ k : ℕ) : AlgebraicClosure F) ≠ 0 := by
    have hℓK : ((ℓ : ℕ) : AlgebraicClosure F) ≠ 0 := by
      rw [← map_natCast (algebraMap F (AlgebraicClosure F))]
      exact (map_ne_zero (algebraMap F (AlgebraicClosure F))).mpr hℓF
    rw [Nat.cast_pow]
    exact pow_ne_zero k hℓK

  have hFunOne : ∀ (S : Scheme.{u}) (m : ℕ), wcZModFun S m 1 = 𝟙 _ := by
    intro S m
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext V
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    rw [← SheafOfModules.unitHomEquiv_apply_coe]
    simp only [wcZModFun, Equiv.apply_symm_apply]
    rfl
  have hFunMul : ∀ (S : Scheme.{u}) (m : ℕ) (r r' : C(↥S, ULift.{u+1} (ZMod m))),
      wcZModFun S m (r * r') = wcZModFun S m r ≫ wcZModFun S m r' := by
    intro S m r r'
    apply (SheafOfModules.unitHomEquiv _).injective
    rw [SheafOfModules.unitHomEquiv_comp_apply]
    apply Subtype.ext
    funext V
    have hvalP : ∀ c : C(↥S, ULift.{u+1} (ZMod m)),
        ((SheafOfModules.unitHomEquiv _) (wcZModFun S m c)).1 V =
        (c.comp (Opposite.unop V).hom.base.hom :
          C(↥((Opposite.unop V).left), ULift.{u+1} (ZMod m))) := by
      intro c
      simp only [wcZModFun, Equiv.apply_symm_apply]
      rfl
    show _ = ((wcZModFun S m r').val.app V).hom (((SheafOfModules.unitHomEquiv _) (wcZModFun S m r)).1 V)
    rw [hvalP, hvalP]
    apply ContinuousMap.ext
    intro x
    rfl
  have hFunAdd : ∀ (S : Scheme.{u}) (m : ℕ) (r r' : C(↥S, ULift.{u+1} (ZMod m))),
      wcZModFun S m (r + r') = wcZModFun S m r + wcZModFun S m r' := by
    intro S m r r'
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext V
    have hvalP : ∀ c : C(↥S, ULift.{u+1} (ZMod m)),
        ((SheafOfModules.unitHomEquiv _) (wcZModFun S m c)).1 V =
        (c.comp (Opposite.unop V).hom.base.hom :
          C(↥((Opposite.unop V).left), ULift.{u+1} (ZMod m))) := by
      intro c
      simp only [wcZModFun, Equiv.apply_symm_apply]
      rfl
    rw [hvalP, SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.add_val,
      PresheafOfModules.add_app]
    show _ = ((SheafOfModules.unitHomEquiv _) (wcZModFun S m r)).1 V +
      ((SheafOfModules.unitHomEquiv _) (wcZModFun S m r')).1 V
    rw [hvalP, hvalP]
    apply ContinuousMap.ext
    intro x
    rfl

  obtain ⟨χ, hχdef⟩ : ∃ χ : ∀ V : Set W.left, IsClopen V →
      C(↥((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W).left, ULift.{u+1} (ZMod (ℓ ^ k))),
      ∀ (V : Set W.left) (hV : IsClopen V), χ V hV =
        (LocallyConstant.charFn (ULift.{u+1} (ZMod (ℓ ^ k))) hV).toContinuousMap.comp
          (Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).base.hom :=
    ⟨_, fun _ _ => rfl⟩
  have hχ : ∀ (V : Set W.left) (hV : IsClopen V)
      (x : ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W).left),
      χ V hV x =
        V.indicator 1 ((Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).base.hom x) := by
    intro V hV x
    rw [hχdef]
    show (LocallyConstant.charFn (ULift.{u+1} (ZMod (ℓ ^ k))) hV)
      ((Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).base.hom x) = _
    rw [LocallyConstant.coe_charFn]
  obtain ⟨e, he⟩ : ∃ e : ∀ V : Set W.left, IsClopen V →
      (wcZModProEtExt ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W).left (ℓ ^ k) j →+
        wcZModProEtExt ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W).left (ℓ ^ k) j),
      ∀ (V : Set W.left) (hV : IsClopen V) h, e V hV h =
        (Abelian.Ext.mk₀ (wcZModFun ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W).left
          (ℓ ^ k) (χ V hV))).comp h (zero_add j) :=
    ⟨fun V hV => (Abelian.Ext.mk₀ (wcZModFun
      ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W).left (ℓ ^ k) (χ V hV))).precomp _
      (zero_add j), fun _ _ _ => rfl⟩

  have G0 : ∀ (T : Scheme.{u}) (r r' : C(↥T, ULift.{u+1} (ZMod (ℓ ^ k)))), r = r' →
      ∀ h : wcZModProEtExt T (ℓ ^ k) j,
      letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T (ℓ ^ k))) := HasExt.standard _
      (Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) r)).comp h (zero_add j) =
        (Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) r')).comp h (zero_add j) := by
    intro T r r' hr h
    subst hr
    rfl
  have G1 : ∀ (T : Scheme.{u}) (r : C(↥T, ULift.{u+1} (ZMod (ℓ ^ k)))), r = 1 →
      ∀ h : wcZModProEtExt T (ℓ ^ k) j,
      letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T (ℓ ^ k))) := HasExt.standard _
      (Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) r)).comp h (zero_add j) = h := by
    intro T r hr h
    letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T (ℓ ^ k))) := HasExt.standard _
    subst hr
    rw [hFunOne]
    exact Abelian.Ext.mk₀_id_comp h
  have G2 : ∀ (T : Scheme.{u}) (r r1 r2 : C(↥T, ULift.{u+1} (ZMod (ℓ ^ k)))), r = r1 * r2 →
      ∀ h : wcZModProEtExt T (ℓ ^ k) j,
      letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T (ℓ ^ k))) := HasExt.standard _
      (Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) r)).comp h (zero_add j) =
        (Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) r1)).comp
          ((Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) r2)).comp h (zero_add j)) (zero_add j) := by
    intro T r r1 r2 hr h
    letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T (ℓ ^ k))) := HasExt.standard _
    subst hr
    rw [hFunMul, ← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
  have G3 : ∀ (T : Scheme.{u}) (r r1 r2 : C(↥T, ULift.{u+1} (ZMod (ℓ ^ k)))), r = r1 + r2 →
      ∀ h : wcZModProEtExt T (ℓ ^ k) j,
      letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T (ℓ ^ k))) := HasExt.standard _
      (Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) r)).comp h (zero_add j) =
        (Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) r1)).comp h (zero_add j) +
          (Abelian.Ext.mk₀ (wcZModFun T (ℓ ^ k) r2)).comp h (zero_add j) := by
    intro T r r1 r2 hr h
    letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T (ℓ ^ k))) := HasExt.standard _
    subst hr
    rw [hFunAdd, Abelian.Ext.mk₀_add, Abelian.Ext.add_comp]

  have he1 : ∀ h, e Set.univ isClopen_univ h = h := by
    intro h
    have hf : χ Set.univ isClopen_univ = 1 :=
      ContinuousMap.ext fun x => (hχ _ _ x).trans (congrFun (Set.indicator_univ _) _)
    exact (he _ _ h).trans (G1 _ _ hf h)
  have hei : ∀ (V V' : Set W.left) (hV : IsClopen V) (hV' : IsClopen V') h,
      e (V ∩ V') (hV.inter hV') h = e V hV (e V' hV' h) := by
    intro V V' hV hV' h
    have hf : χ (V ∩ V') (hV.inter hV') = χ V hV * χ V' hV' :=
      ContinuousMap.ext fun x => (hχ _ _ x).trans
        ((congrFun (Set.inter_indicator_one (M₀ := ULift.{u+1} (ZMod (ℓ ^ k))) (s := V) (t := V')) _).trans
          (congrArg₂ (· * ·) (hχ V hV x) (hχ V' hV' x)).symm)
    exact (he _ _ h).trans ((G2 _ _ _ _ hf h).trans
      ((congrArg (fun y => (Abelian.Ext.mk₀ (wcZModFun
          ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W).left (ℓ ^ k) (χ V hV))).comp y
          (zero_add j)) (he V' hV' h).symm).trans (he V hV _).symm))
  have heu : ∀ (V V' : Set W.left) (hV : IsClopen V) (hV' : IsClopen V'), Disjoint V V' → ∀ h,
      e (V ∪ V') (hV.union hV') h = e V hV h + e V' hV' h := by
    intro V V' hV hV' hdisj h
    have hf : χ (V ∪ V') (hV.union hV') = χ V hV + χ V' hV' :=
      ContinuousMap.ext fun x => (hχ _ _ x).trans
        ((congrFun (Set.indicator_union_of_disjoint hdisj (1 : W.left → ULift.{u+1} (ZMod (ℓ ^ k)))) _).trans
          (congrArg₂ (· + ·) (hχ V hV x) (hχ V' hV' x)).symm)
    exact (he _ _ h).trans ((G3 _ _ _ _ hf h).trans
      (congrArg₂ (· + ·) (he V hV h).symm (he V' hV' h).symm))

  have hgerm : ∀ z ∈ {x : W.left | IsClosed ({x} : Set W.left)},
      (∀ h, ∃ (a : wcZModProEtExt (wcXbar F X) (ℓ ^ k) j) (V : Set W.left) (hV : IsClopen V),
        z ∈ V ∧ e V hV h = e V hV (wcZModPull D₂ j a)) ∧
      (∀ (a : wcZModProEtExt (wcXbar F X) (ℓ ^ k) j) (V : Set W.left) (hV : IsClopen V),
        z ∈ V → e V hV (wcZModPull D₂ j a) = 0 → a = 0) := by
    intro z hz
    haveI : HenselianLocalRing (W.left.presheaf.stalk z) := (hW.2.2.2.2 z hz).1
    haveI : IsSepClosed (IsLocalRing.ResidueField (W.left.presheaf.stalk z)) := (hW.2.2.2.2 z hz).2
    have hP : IsPullback
        (Limits.pullback.snd (W.left.fromSpecStalk z)
            (Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))) ≫
          ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W).hom ≫
            Limits.pullback.snd (wcPi2 F X) (wcPi2 F X))
        (Limits.pullback.fst (W.left.fromSpecStalk z)
            (Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))))
        (wcPi2 F X) (W.left.fromSpecStalk z ≫ W.hom ≫ wcPi2 F X) :=
      (IsPullback.of_hasPullback (W.left.fromSpecStalk z)
          (Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)))).flip.paste_horiz
        ((IsPullback.of_hasPullback W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).flip.paste_horiz
          (IsPullback.of_hasPullback (wcPi2 F X) (wcPi2 F X)).flip)
    obtain ⟨Dsn, hDsn⟩ := wc_zmod_pull_data_exists (Limits.pullback.snd (W.left.fromSpecStalk z)
      (Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)))) (ℓ ^ k)
    obtain ⟨Dq, hDq⟩ := wc_zmod_pull_data_exists (Limits.pullback.snd (W.left.fromSpecStalk z)
            (Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))) ≫
          ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W).hom ≫
            Limits.pullback.snd (wcPi2 F X) (wcPi2 F X)) (ℓ ^ k)
    have bij := wc_zmod_proper_strict_henselian_base_pull_bij (wcPi2 F X) (W.left.presheaf.stalk z)
      (W.left.fromSpecStalk z ≫ W.hom ≫ wcPi2 F X) _ _ hP (ℓ ^ k) hne Dq hDq j
    have hcomp : ∀ a, wcZModPull Dq j a = wcZModPull Dsn j (wcZModPull D₂ j a) := fun a =>
      wc_zmod_pull_comp _ _ _ rfl D₂ hD₂ Dsn hDsn Dq hDq j a
    have hpt : ∀ t : ↥(Limits.pullback (W.left.fromSpecStalk z)
        (Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)))),
        (Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)))
          ((Limits.pullback.snd (W.left.fromSpecStalk z)
            (Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)))) t) =
        W.left.fromSpecStalk z ((Limits.pullback.fst (W.left.fromSpecStalk z)
            (Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)))) t) := by
      intro t
      have h1 := Scheme.Hom.comp_apply (Limits.pullback.snd (W.left.fromSpecStalk z)
        (Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))))
        (Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))) t
      have h2 := Scheme.Hom.comp_apply (Limits.pullback.fst (W.left.fromSpecStalk z)
        (Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))))
        (W.left.fromSpecStalk z) t
      rw [← h1, ← h2, Limits.pullback.condition]
    have hkill : ∀ (V : Set W.left) (hV : IsClopen V), z ∈ V → ∀ h,
        wcZModPull Dsn j (e V hV h) = wcZModPull Dsn j h := by
      intro V hV hzV h
      have hone : (χ V hV).comp
          (Limits.pullback.snd (W.left.fromSpecStalk z)
            (Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)))).base.hom = 1 := by
        apply ContinuousMap.ext
        intro t
        have hmem : (Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)))
            ((Limits.pullback.snd (W.left.fromSpecStalk z)
              (Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)))) t) ∈ V := by
          rw [hpt t]
          have hr : W.left.fromSpecStalk z ((Limits.pullback.fst (W.left.fromSpecStalk z)
              (Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)))) t) ∈
              Set.range (W.left.fromSpecStalk z) := ⟨_, rfl⟩
          rw [Scheme.range_fromSpecStalk] at hr
          exact Specializes.mem_open hr hV.isOpen hzV
        show χ V hV ((Limits.pullback.snd (W.left.fromSpecStalk z)
            (Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)))).base.hom t) = 1
        exact (hχ V hV _).trans (Set.indicator_of_mem hmem _)
      exact (congrArg (wcZModPull Dsn j) (he V hV h)).trans
        ((wc_zmod_pull_fun Dsn hDsn (χ V hV) j h).trans (G1 _ _ hone _))
    refine ⟨fun h => ?_, fun a V hV hzV h0 => ?_⟩
    · obtain ⟨a, ha⟩ := bij.2 (wcZModPull Dsn j h)
      obtain ⟨ι, hι⟩ : ∃ ι : wcZModProEtExt (wcXbar F X) (ℓ ^ k) j →+ wcZModProEtExt
          ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W).left (ℓ ^ k) j,
          ∀ b, ι b = wcZModPull D₂ j b := ⟨wcZModPull D₂ j, fun _ => rfl⟩
      obtain ⟨d, hd⟩ : ∃ d : wcZModProEtExt
          ((wcProEtBC (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).obj W).left (ℓ ^ k) j,
          d = h - ι a := ⟨_, rfl⟩
      have h0 : wcZModPull Dsn j d = 0 :=
        (congrArg (wcZModPull Dsn j) hd).trans ((map_sub (wcZModPull Dsn j) h (ι a)).trans
          (sub_eq_zero.mpr (((congrArg (wcZModPull Dsn j) (hι a)).trans (hcomp a).symm).trans ha).symm))
      obtain ⟨V, hV, hzV, hV0⟩ := wc_zmod_wlocal_closed_point_continuity hW.1 hW.2.1 hW.2.2.1
        (Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))) hQC hQS (ℓ ^ k) j z hz
        Dsn hDsn d h0
      refine ⟨a, V, hV, hzV, ?_⟩
      have h1 : e V hV d = 0 :=
        (he _ _ _).trans ((G0 _ _ _ (hχdef V hV) _).trans hV0)
      have h2 : e V hV h - e V hV (ι a) = 0 :=
        (map_sub (e V hV) h (ι a)).symm.trans ((congrArg (e V hV) hd).symm.trans h1)
      exact (sub_eq_zero.mp h2).trans (congrArg (e V hV) (hι a))
    · apply bij.1
      exact (hcomp a).trans ((hkill V hV hzV (wcZModPull D₂ j a)).symm.trans
        ((congrArg (wcZModPull Dsn j) h0).trans ((map_zero _).trans (map_zero _).symm)))

  have hZ : ∀ x : W.left, ∃ z ∈ {x : W.left | IsClosed ({x} : Set W.left)}, x ⤳ z := by
    intro x
    obtain ⟨y, hy, _⟩ := hW.2.2.1 x
    exact ⟨y, hy.1, hy.2⟩
  obtain ⟨Ξ, hΞ⟩ := wc_lc_clopen_assembly e he1 hei heu (wcZModPull D₂ j)
    {x : W.left | IsClosed ({x} : Set W.left)} hZ (fun z hz => (hgerm z hz).1) (fun z hz => (hgerm z hz).2)
  refine ⟨Ξ, fun V _ hV a => ?_⟩
  have hfun : χ V hV =
      ((LocallyConstant.ofIsClopen hV).map (fun i : Fin 2 =>
          if i = 0 then (1 : ULift.{u+1} (ZMod (ℓ ^ k))) else 0)).toContinuousMap.comp
        (Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).base.hom := by
    apply ContinuousMap.ext
    intro x
    rw [hχ]
    show _ = (fun i : Fin 2 => if i = 0 then (1 : ULift.{u+1} (ZMod (ℓ ^ k))) else 0)
      ((LocallyConstant.ofIsClopen hV)
        ((Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).base.hom x))
    by_cases hx : (Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).base.hom x ∈ V
    · have h0 : (LocallyConstant.ofIsClopen hV)
          ((Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).base.hom x) = 0 := by
        have := LocallyConstant.ofIsClopen_fiber_zero hV
        rw [Set.ext_iff] at this
        exact (this _).mpr hx
      rw [Set.indicator_of_mem hx, h0]
      simp
    · have h1 : (LocallyConstant.ofIsClopen hV)
          ((Limits.pullback.fst W.hom (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))).base.hom x) = 1 := by
        have := LocallyConstant.ofIsClopen_fiber_one hV
        rw [Set.ext_iff] at this
        exact (this _).mpr hx
      rw [Set.indicator_of_notMem hx, h1]
      simp
  exact (hΞ V hV a).trans ((he _ _ _).trans (G0 _ _ _ hfun _))

theorem wc_int_rat_data_exists (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    ∃ E : wcIntRatData S ℓ,
      E.adj.homEquiv _ _ E.μ.hom = wcUnitRestrict (wcIntRatRingSheafMap S ℓ) :=
by
  classical
  obtain ⟨h1, h2, h3⟩ := wc_int_rat_ring_localization_data S ℓ
  obtain ⟨L, adj, hadd, hlim, hcolim⟩ :=
    sheafOfModules_restrictScalars_exact_left_adjoint_of_localization (Scheme.ProEt.topology S)
      (wcIntRingSheaf S ℓ) (wcRingSheaf S ℓ) (wcIntRatRingSheafMap S ℓ) ℓ h1 h2 h3
  let f : L.obj (SheafOfModules.unit (wcIntRingSheaf S ℓ)) ⟶
      SheafOfModules.unit (wcRingSheaf S ℓ) :=
    (adj.homEquiv _ _).symm (wcUnitRestrict (wcIntRatRingSheafMap S ℓ))
  have hf : ∀ (T : SheafOfModules.{u+1} (wcRingSheaf S ℓ))
      (x : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶ T),
      f ≫ x = (adj.homEquiv _ _).symm (wcUnitRestrict (wcIntRatRingSheafMap S ℓ) ≫
        (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap S ℓ)).map x) := by
    intro T x
    rw [Equiv.eq_symm_apply, Adjunction.homEquiv_naturality_right]
    simp only [f, Equiv.apply_symm_apply]
  haveI : IsIso f := by
    apply isIso_of_coyoneda_map_bijective
    intro T
    have hcomp : (fun x : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶ T => f ≫ x) =
        (adj.homEquiv _ _).symm ∘ (fun x : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶ T =>
          wcUnitRestrict (wcIntRatRingSheafMap S ℓ) ≫
            (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap S ℓ)).map x) := by
      funext x
      exact hf T x
    rw [hcomp]
    exact (Equiv.bijective _).comp
      (sheafOfModules_unitRestrict_hom_bijective (wcIntRingSheaf S ℓ) (wcRingSheaf S ℓ)
        (wcIntRatRingSheafMap S ℓ) T)
  refine ⟨wcIntRatData.mk L adj hadd hlim hcolim (asIso f), ?_⟩
  show adj.homEquiv _ _ f = _
  simp only [f, Equiv.apply_symm_apply]

theorem wc_hmScalar_laws (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (n : ℕ) :
    (∀ (a b : ℚ_[ℓ]) (x : wcHM S ℓ n),
      wcHMScalar S ℓ n a (wcHMScalar S ℓ n b x) = wcHMScalar S ℓ n (b * a) x) ∧
    (∀ x : wcHM S ℓ n, wcHMScalar S ℓ n 1 x = x) ∧
    (∀ (a b : ℚ_[ℓ]) (x : wcHM S ℓ n),
      wcHMScalar S ℓ n (a + b) x = wcHMScalar S ℓ n a x + wcHMScalar S ℓ n b x) ∧
    (∀ (k : ℕ) (x : wcHM S ℓ n), k • x = wcHMScalar S ℓ n (k : ℚ_[ℓ]) x) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
  have hConstMul : ∀ (a b : ℚ_[ℓ]),
      wcHMConst S ℓ a ≫ wcHMConst S ℓ b = wcHMConst S ℓ (a * b) := by
    intro a b
    apply (SheafOfModules.unitHomEquiv _).injective
    rw [SheafOfModules.unitHomEquiv_comp_apply]
    apply Subtype.ext
    funext V
    have hvalP : ∀ (c : ℚ_[ℓ]), ((SheafOfModules.unitHomEquiv _) (wcHMConst S ℓ c)).1 V =
        (ContinuousMap.const _ (ULift.up c) : C(↥((Opposite.unop V).left), ULift.{u+1} ℚ_[ℓ])) := by
      intro c
      simp only [wcHMConst, Equiv.apply_symm_apply]
      rfl
    show ((wcHMConst S ℓ b).val.app V).hom (((SheafOfModules.unitHomEquiv _) (wcHMConst S ℓ a)).1 V) =
      ((SheafOfModules.unitHomEquiv _) (wcHMConst S ℓ (a * b))).1 V
    rw [hvalP, hvalP]
    apply ContinuousMap.ext
    intro x
    rfl
  have hConstOne : wcHMConst S ℓ 1 = 𝟙 _ := by
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext V
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    rw [← SheafOfModules.unitHomEquiv_apply_coe]
    simp only [wcHMConst, Equiv.apply_symm_apply]
    rfl
  have hConstAdd : ∀ (a b : ℚ_[ℓ]),
      wcHMConst S ℓ (a + b) = wcHMConst S ℓ a + wcHMConst S ℓ b := by
    intro a b
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext V
    have hvalP : ∀ (c : ℚ_[ℓ]), ((SheafOfModules.unitHomEquiv _) (wcHMConst S ℓ c)).1 V =
        (ContinuousMap.const _ (ULift.up c) : C(↥((Opposite.unop V).left), ULift.{u+1} ℚ_[ℓ])) := by
      intro c
      simp only [wcHMConst, Equiv.apply_symm_apply]
      rfl
    rw [hvalP, SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.add_val,
      PresheafOfModules.add_app]
    show _ = ((SheafOfModules.unitHomEquiv _) (wcHMConst S ℓ a)).1 V +
      ((SheafOfModules.unitHomEquiv _) (wcHMConst S ℓ b)).1 V
    rw [hvalP, hvalP]
    apply ContinuousMap.ext
    intro x
    rfl
  have L1 : ∀ (a b : ℚ_[ℓ]) (x : wcHM S ℓ n),
      wcHMScalar S ℓ n a (wcHMScalar S ℓ n b x) = wcHMScalar S ℓ n (b * a) x := by
    intro a b x
    show (x.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ b)) (add_zero n)).comp
        (Abelian.Ext.mk₀ (wcHMConst S ℓ a)) (add_zero n) =
      x.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ (b * a))) (add_zero n)
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, hConstMul]
  have L2 : ∀ x : wcHM S ℓ n, wcHMScalar S ℓ n 1 x = x := by
    intro x
    show x.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ 1)) (add_zero n) = x
    rw [hConstOne, Abelian.Ext.comp_mk₀_id]
  have L3 : ∀ (a b : ℚ_[ℓ]) (x : wcHM S ℓ n),
      wcHMScalar S ℓ n (a + b) x = wcHMScalar S ℓ n a x + wcHMScalar S ℓ n b x := by
    intro a b x
    show x.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ (a + b))) (add_zero n) =
      x.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ a)) (add_zero n) +
        x.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ b)) (add_zero n)
    rw [hConstAdd, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add]
  have scal0 : ∀ x : wcHM S ℓ n, wcHMScalar S ℓ n 0 x = 0 := by
    intro x
    have h := L3 0 0 x
    rw [add_zero] at h
    exact add_left_cancel (h.symm.trans (add_zero _).symm)
  refine ⟨L1, L2, L3, ?_⟩
  intro k x
  induction k with
  | zero => rw [zero_nsmul, Nat.cast_zero, scal0]
  | succ k ih => rw [succ_nsmul, ih, Nat.cast_add_one, L3, L2]

theorem wc_int_rat_rationalization (S : Scheme.{u}) [CompactSpace S] [QuasiSeparatedSpace S]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (E : wcIntRatData S ℓ)
    (hE : E.adj.homEquiv _ _ E.μ.hom = wcUnitRestrict (wcIntRatRingSheafMap S ℓ)) (q : ℕ) :
    (∀ x : wcHM S ℓ q, ∃ (n : ℕ) (y : wcIntExt S ℓ q),
      wcHMScalar S ℓ q ((ℓ : ℚ_[ℓ]) ^ n) x = wcIntRho E q y) ∧
    (∀ y : wcIntExt S ℓ q, wcIntRho E q y = 0 → ∃ s : ℕ, (ℓ ^ s : ℕ) • y = 0) :=
by
  classical
  letI hΛ : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
  letI hR : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
  haveI := E.additive
  haveI := E.presLim
  haveI := E.presColim
  haveI : CompactSpace (MorphismProperty.Over.mk ⊤ (𝟙 S) inferInstance : S.ProEt).left :=
    inferInstanceAs (CompactSpace S)
  haveI : QuasiSeparatedSpace (MorphismProperty.Over.mk ⊤ (𝟙 S) inferInstance : S.ProEt).left :=
    inferInstanceAs (QuasiSeparatedSpace S)

  have htfΛ : ∀ (V : (S.ProEt)ᵒᵖ) (m : ℕ)
      (r : ↑((wcIntRingSheaf S ℓ).obj.obj V)), m ≠ 0 → m • r = 0 → r = 0 := by
    intro V m r hm hr
    have key : ∀ (T : Type u) [TopologicalSpace T] (s : C(T, ULift.{u+1} ℤ_[ℓ])),
        m • s = 0 → s = 0 := by
      intro T _ s hs
      refine ContinuousMap.ext fun t => ULift.ext _ _ ?_
      let g : C(T, ULift.{u+1} ℤ_[ℓ]) →+ ℤ_[ℓ] := AddEquiv.ulift.toAddMonoidHom.comp
        ((Pi.evalAddMonoidHom (fun _ : T => ULift.{u+1} ℤ_[ℓ]) t).comp
          ContinuousMap.coeFnAddMonoidHom)
      have h1 : m • g s = 0 := ((map_nsmul g m s).symm.trans (congrArg g hs)).trans (map_zero g)
      rw [nsmul_eq_mul] at h1
