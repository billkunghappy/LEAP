              E.hom ≫ ((ℓ ^ k : ℕ) • 𝟙 _) ≫ E.inv := by
            rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, E.hom_inv_id]
            try rfl
          rw [hc]
          exact @mono_comp _ _ _ _ _ E.hom inferInstance _ (@mono_comp _ _ _ _ _ _ hq E.inv inferInstance)
        exact NatTrans.mono_of_mono_app _
      have T2 : Mono ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel i)) := by
        haveI := T1
        have h0 : Mono ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
            ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel w))) :=
          Functor.map_mono (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) _
        have h1 : (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
            ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel w)) = (ℓ ^ k : ℕ) • 𝟙
              ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).obj
                (Limits.cokernel w)) := by
          rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
        rw [h1] at h0
        let e := Limits.PreservesCokernel.iso
          (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) w
        have hc : ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel i)) =
            e.inv ≫ ((ℓ ^ k : ℕ) • 𝟙 _) ≫ e.hom := by
          rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, e.inv_hom_id]
          try rfl
        rw [hc]
        exact @mono_comp _ _ _ _ _ e.inv inferInstance _ (@mono_comp _ _ _ _ _ _ h0 e.hom inferInstance)
      have T3 : Mono ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel (L.map i))) := by
        haveI := T2
        have h0 : Mono (L.map ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel i))) := Functor.map_mono L _
        have h1 : L.map ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel i)) =
            (ℓ ^ k : ℕ) • 𝟙 (L.obj (Limits.cokernel i)) := by
          rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
        rw [h1] at h0
        let e := Limits.PreservesCokernel.iso L i
        have hc : ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel (L.map i))) =
            e.inv ≫ ((ℓ ^ k : ℕ) • 𝟙 _) ≫ e.hom := by
          rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, e.inv_hom_id]
          try rfl
        rw [hc]
        exact @mono_comp _ _ _ _ _ e.inv inferInstance _ (@mono_comp _ _ _ _ _ _ h0 e.hom inferInstance)
      haveI := T3
      let c := Limits.cokernelCompIsIso (L.map i) φ
      have hc : ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel ιJ)) = c.hom ≫ ((ℓ ^ k : ℕ) • 𝟙 _) ≫ c.inv := by
        rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, c.hom_inv_id]
      rw [hc]
      infer_instance
    exact ⟨ιJ, s, inferInstance, htf, hiii, hloc⟩

  obtain ⟨ιJ, s, hmono, htf, hinj, hloc⟩ :=
    hdata Y VU hVUo L adj inferInstance inferInstance inferInstance

  have hJ : ιJ ≫ wcIntSuppπ Dy = 0 := by
    apply hinj
    obtain ⟨k₀, hk₀⟩ := (hK VU ((ιJ.val.app (Opposite.op VU)).hom s)).2 (by
      intro z hz
      exfalso
      have h1 : VU.hom z ∈ Set.range VU.hom := ⟨z, rfl⟩
      rw [hVU] at h1
      exact h1 ⟨_, hz.symm⟩)
    have e1 : ((ιJ ≫ wcIntSuppπ Dy).val.app (Opposite.op VU)).hom s =
        ((wcIntSuppπ Dy).val.app (Opposite.op VU)).hom ((ιJ.val.app (Opposite.op VU)).hom s) := rfl
    have e2 : ((Limits.kernel.ι (wcIntSuppπ Dy) ≫ wcIntSuppπ Dy).val.app (Opposite.op VU)).hom k₀ =
        ((wcIntSuppπ Dy).val.app (Opposite.op VU)).hom
          (((Limits.kernel.ι (wcIntSuppπ Dy)).val.app (Opposite.op VU)).hom k₀) := rfl
    rw [e1, ← hk₀, ← e2, Limits.kernel.condition]
    rfl

  refine ⟨Limits.kernel.lift (wcIntSuppπ Dy) ιJ hJ, ?_, ?_⟩
  · have hfac : Limits.kernel.lift (wcIntSuppπ Dy) ιJ hJ ≫ Limits.kernel.ι (wcIntSuppπ Dy) = ιJ :=
      Limits.kernel.lift_ι _ _ _
    haveI : Mono (Limits.kernel.lift (wcIntSuppπ Dy) ιJ hJ ≫ Limits.kernel.ι (wcIntSuppπ Dy)) := by
      rw [hfac]; exact hmono
    exact mono_of_mono _ (Limits.kernel.ι (wcIntSuppπ Dy))
  · intro k
    set j := Limits.kernel.lift (wcIntSuppπ Dy) ιJ hJ with hjdef
    set ιK := Limits.kernel.ι (wcIntSuppπ Dy) with hιK
    have hfac : j ≫ ιK = ιJ := Limits.kernel.lift_ι _ _ _

    have hmonoK : Mono ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel j)) := by
      have hw : j ≫ (ιK ≫ Limits.cokernel.π ιJ) = 0 := by
        rw [← Category.assoc, hfac, Limits.cokernel.condition]
      let m : Limits.cokernel j ⟶ Limits.cokernel ιJ := Limits.cokernel.desc j _ hw
      have hm : Limits.cokernel.π j ≫ m = ιK ≫ Limits.cokernel.π ιJ := Limits.cokernel.π_desc _ _ _
      haveI hmm : Mono m := by
        apply Preadditive.mono_of_cancel_zero
        intro P g hg
        obtain ⟨A', π₁, hπ₁, y, hy⟩ := surjective_up_to_refinements_of_epi (Limits.cokernel.π j) g
        have h1 : (y ≫ ιK) ≫ Limits.cokernel.π ιJ = 0 := by
          rw [Category.assoc, ← hm, ← Category.assoc, ← hy, Category.assoc, hg, Limits.comp_zero]
        obtain ⟨A'', π₂, hπ₂, z, hz⟩ :=
          (ShortComplex.exact_cokernel ιJ).exact_up_to_refinements (y ≫ ιK) h1
        have hz' : π₂ ≫ y ≫ ιK = z ≫ ιJ := hz
        haveI := hπ₁
        haveI := hπ₂
        have h2 : π₂ ≫ y = z ≫ j := by
          rw [← cancel_mono ιK, Category.assoc, Category.assoc, hfac]
          exact hz'
        have h3 : (π₂ ≫ π₁) ≫ g = 0 := by
          rw [Category.assoc, hy, ← Category.assoc, h2, Category.assoc, Limits.cokernel.condition,
            Limits.comp_zero]
        exact (cancel_epi (π₂ ≫ π₁)).1 (h3.trans Limits.comp_zero.symm)
      haveI : Mono (((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel j)) ≫ m) := by
        have e : ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel j)) ≫ m =
            m ≫ ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel ιJ)) := by
          rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp, Category.comp_id]
        rw [e]
        haveI := htf k
        infer_instance
      exact mono_of_mono _ m

    have hloc' : ∀ (W : Y.ProEt) (a : W ⟶ VU)
        (f : (wcIntUnit Y ℓ).val.obj (Opposite.op W)),
        ∃ t : (L.obj (wcFreeSheaf Y VU)).val.obj (Opposite.op W),
          (ιK.val.app (Opposite.op W)).hom ((j.val.app (Opposite.op W)).hom t) = f := by
      intro W a f
      obtain ⟨t, ht⟩ := hloc W a f
      refine ⟨t, ?_⟩
      rw [← ht, ← hfac]
      rfl
    have hepi := hEpi (L.obj (wcFreeSheaf Y VU)) j hloc' k
    exact isIso_of_mono_of_epi _

theorem wc_ac_int_supp_kernel_tors_vanish (K : Type u) [Field K] [IsAlgClosed K]
    {Y : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n : ℕ) [SmoothOfRelativeDimension n pY]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (y₀ : Spec (.of K) ⟶ Y) (hy₀ : y₀ ≫ pY = 𝟙 _)
    (Dy : wcHMPullData y₀ ℓ) (hDy : wcHMPullCanonical Dy) :
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _
    ∀ (m : ℕ), 1 ≤ m →
    ∀ y : Abelian.Ext (Limits.kernel (wcIntSuppπ Dy)) (wcIntTors Y ℓ m) (2 * n), y = 0 :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _
  intro m _hm y

  haveI : IsSeparated pY := inferInstance
  haveI : IsClosedImmersion (y₀ ≫ pY) := by rw [hy₀]; infer_instance
  haveI : IsClosedImmersion y₀ := IsClosedImmersion.of_comp y₀ pY
  have hcl : IsClosed (Set.range y₀) := y₀.isClosedEmbedding.isClosed_range
  let U : Y.Opens := ⟨(Set.range y₀)ᶜ, hcl.isOpen_compl⟩
  let VU : Y.ProEt :=
    MorphismProperty.Over.mk ⊤ U.ι (etale_le_weaklyEtale _ _ _ inferInstance)
  have hVUo : IsOpenImmersion VU.hom := (inferInstance : IsOpenImmersion U.ι)
  have hVU : Set.range VU.hom = (Set.range y₀)ᶜ := Scheme.Opens.range_ι U
  have hne : Set.range VU.hom ≠ Set.univ := by
    rw [hVU]
    intro h
    have h1 : y₀ (IsLocalRing.closedPoint K) ∈ (Set.range y₀)ᶜ := by
      rw [h]; trivial
    exact h1 ⟨_, rfl⟩

  have htf : ∀ (V : (Y.ProEt)ᵒᵖ) (k : ℕ)
      (r : ↑((wcIntRingSheaf Y ℓ).obj.obj V)), k ≠ 0 → k • r = 0 → r = 0 := by
    intro V k r hk hr
    have hc : ((k : ℕ) : ℤ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr hk
    have key : ∀ {T : Type u} [TopologicalSpace T] (a : C(T, ULift.{u+1} ℤ_[ℓ])),
        k • a = 0 → a = 0 := by
      intro T _ a h
      refine ContinuousMap.ext fun t => ULift.ext _ _ ?_
      have h1 : k • (a t).down = 0 :=
        congrArg (fun g : C(T, ULift.{u+1} ℤ_[ℓ]) => (g t).down) h
      rw [nsmul_eq_mul] at h1
      exact (mul_eq_zero.mp h1).resolve_left hc
    exact key (T := ↥((Scheme.ProEt.forget Y ⋙ Over.forget Y).obj
      (Opposite.unop V))) r hr
  obtain ⟨L, adj, hA, hL, hC⟩ := sheafOfModules_toSheaf_exact_left_adjoint_of_torsionFree
    (Scheme.ProEt.topology Y) (wcIntRingSheaf Y ℓ) htf
  haveI := hA
  haveI := hL
  haveI := hC
  haveI : (SheafOfModules.toSheaf (wcIntRingSheaf Y ℓ)).IsRightAdjoint := ⟨_, ⟨adj⟩⟩
  haveI : Limits.PreservesFiniteColimits (SheafOfModules.toSheaf (wcIntRingSheaf Y ℓ)) :=
    sheafOfModules_toSheaf_preservesFiniteColimits _ _
  have hbij := ext_transfer_of_hom_bijective L
    (SheafOfModules.toSheaf (wcIntRingSheaf Y ℓ)) adj (wcFreeSheaf Y VU)
    (L.obj (wcFreeSheaf Y VU)) (adj.unit.app (wcFreeSheaf Y VU)) (by
      intro Z
      have e : (fun f : L.obj (wcFreeSheaf Y VU) ⟶ Z =>
          adj.unit.app (wcFreeSheaf Y VU) ≫
            (SheafOfModules.toSheaf (wcIntRingSheaf Y ℓ)).map f) =
          adj.homEquiv (wcFreeSheaf Y VU) Z :=
        funext fun f => (adj.homEquiv_unit _ _ f).symm
      rw [e]
      exact (adj.homEquiv _ Z).bijective)

  obtain ⟨e⟩ := wc_int_tors_toSheaf_zmod Y ℓ m
  have hK := wc_ac_int_supp_kernel_sections K ℓ y₀ Dy hDy
  obtain ⟨j, hj, hiso⟩ := wc_ac_int_open_part_divisible K ℓ y₀ Dy hK VU hVUo hVU L adj

  have hvanP : ∀ w : Abelian.Ext (wcFreeSheaf Y VU)
      ((SheafOfModules.toSheaf (wcIntRingSheaf Y ℓ)).obj (wcIntTors Y ℓ m))
      (2 * n), w = 0 := by
    intro w
    have h0 := wc_ac_open_zmod_top_vanish K pY n ℓ hℓ VU hVUo hne m
      (w.comp (Abelian.Ext.mk₀ e.hom) (add_zero _))
    calc w = (w.comp (Abelian.Ext.mk₀ e.hom) (add_zero _)).comp (Abelian.Ext.mk₀ e.inv)
          (add_zero _) := by
          rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
            Abelian.Ext.comp_mk₀_id]
      _ = 0 := by rw [h0]; exact Abelian.Ext.zero_comp _ _ _ _ _
  have hvanJ : ∀ w : Abelian.Ext (L.obj (wcFreeSheaf Y VU))
      (wcIntTors Y ℓ m) (2 * n), w = 0 := by
    intro w
    exact (hbij (wcIntTors Y ℓ m) (2 * n)).1 ((hvanP _).trans (hvanP _).symm)

  have hS : (ShortComplex.mk j (Limits.cokernel.π j) (Limits.cokernel.condition j)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel j) hj inferInstance
  obtain ⟨x, hx⟩ := Abelian.Ext.contravariant_sequence_exact₂ hS (wcIntTors Y ℓ m) y
    (hvanJ _)

  have hmk : ∀ {A B : SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)} (f : A ⟶ B) (k : ℕ),
      Abelian.Ext.mk₀ (k • f) = k • Abelian.Ext.mk₀ f := by
    intro A B f k
    induction k with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero]
    | succ k ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, ih]
  have hL' : ∀ {A B C : SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)} {p q r : ℕ}
      (a : Abelian.Ext A B p) (b : Abelian.Ext B C q) (h : p + q = r) (k : ℕ),
      (k • a).comp b h = k • a.comp b h := by
    intro A B C p q r a b h k
    induction k with
    | zero => rw [zero_nsmul, zero_nsmul]; exact Abelian.Ext.zero_comp _ _ _ _ _
    | succ k ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.add_comp, ih]
  have hR' : ∀ {A B C : SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)} {p q r : ℕ}
      (a : Abelian.Ext A B p) (b : Abelian.Ext B C q) (h : p + q = r) (k : ℕ),
      a.comp (k • b) h = k • a.comp b h := by
    intro A B C p q r a b h k
    induction k with
    | zero => rw [zero_nsmul, zero_nsmul]; exact Abelian.Ext.comp_zero _ _ _ _ _
    | succ k ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.comp_add, ih]
  have hΛ : (ℓ ^ m : ℕ) • 𝟙 (wcIntTors Y ℓ m) = 0 := by
    apply (cancel_epi (Limits.cokernel.π ((ℓ ^ m : ℕ) • 𝟙 (wcIntUnit Y ℓ)))).1
    have e1 : (ℓ ^ m : ℕ) • Limits.cokernel.π ((ℓ ^ m : ℕ) • 𝟙 (wcIntUnit Y ℓ)) =
        ((ℓ ^ m : ℕ) • 𝟙 (wcIntUnit Y ℓ)) ≫
          Limits.cokernel.π ((ℓ ^ m : ℕ) • 𝟙 (wcIntUnit Y ℓ)) := by
      rw [Preadditive.nsmul_comp, Category.id_comp]
    rw [Preadditive.comp_nsmul, Category.comp_id, Limits.comp_zero, e1, Limits.cokernel.condition]
  haveI hψ := hiso m
  have h1 : (Abelian.Ext.mk₀ ((ℓ ^ m : ℕ) • 𝟙 (Limits.cokernel j))).comp x (zero_add (2 * n)) = 0 := by
    calc (Abelian.Ext.mk₀ ((ℓ ^ m : ℕ) • 𝟙 (Limits.cokernel j))).comp x (zero_add (2 * n))
        = (ℓ ^ m : ℕ) • (Abelian.Ext.mk₀ (𝟙 (Limits.cokernel j))).comp x (zero_add (2 * n)) := by
          rw [hmk, hL']
      _ = (ℓ ^ m : ℕ) • x := by rw [Abelian.Ext.mk₀_id_comp]
      _ = (ℓ ^ m : ℕ) • x.comp (Abelian.Ext.mk₀ (𝟙 (wcIntTors Y ℓ m))) (add_zero (2 * n)) := by
          rw [Abelian.Ext.comp_mk₀_id]
      _ = x.comp (Abelian.Ext.mk₀ ((ℓ ^ m : ℕ) • 𝟙 (wcIntTors Y ℓ m))) (add_zero (2 * n)) := by
          rw [hmk, hR']
      _ = 0 := by rw [hΛ, Abelian.Ext.mk₀_zero]; exact Abelian.Ext.comp_zero _ _ _ _ _
  have hx0 : x = 0 := by
    calc x = (Abelian.Ext.mk₀ (inv ((ℓ ^ m : ℕ) • 𝟙 (Limits.cokernel j)))).comp
          ((Abelian.Ext.mk₀ ((ℓ ^ m : ℕ) • 𝟙 (Limits.cokernel j))).comp x (zero_add (2 * n)))
          (zero_add (2 * n)) := by
          rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add (2 * n)) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, IsIso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
      _ = 0 := by rw [h1]; exact Abelian.Ext.comp_zero _ _ _ _ _

  rw [← hx, hx0]
  exact Abelian.Ext.comp_zero _ _ _ _ _

theorem wc_ac_int_tors_succ_top_vanish (K : Type u) [Field K] [IsAlgClosed K]
    {Y : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY]
    (n : ℕ) [SmoothOfRelativeDimension n pY]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0) :
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _
    ∀ x : Abelian.Ext (wcIntUnit Y ℓ) (wcIntTors Y ℓ 1) (2 * n + 1), x = 0 :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _
  intro x
  have hcast : ((ℓ ^ 1 : ℕ) : K) ≠ 0 := by
    rw [Nat.cast_pow]; exact pow_ne_zero 1 hℓ

  haveI hsubEt : Subsingleton (wcEtCoh Y (ℓ ^ 1) (2 * n + 1)) := by
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    have hv := wc_et_cd_proper_torsion K Y pY n (wc_smooth_alg_closed_dim_le K Y pY n) (ℓ ^ 1)
      hcast ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ 1)))))
      (wc_et_const_zmod_nsmul_zero Y (ℓ ^ 1)) (2 * n + 1) (by omega)
    show Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ 1))))) (2 * n + 1))
    exact ⟨fun a b => (hv a).trans (hv b).symm⟩

  obtain ⟨E3⟩ := wc_proet_etale_comparison_zmod K Y pY (ℓ ^ 1) (2 * n + 1)
  haveI hsub1 : Subsingleton (Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
      (wcZModSheaf Y (ℓ ^ 1)) (2 * n + 1)) := E3.subsingleton

  obtain ⟨e⟩ := wc_int_tors_toSheaf_zmod Y ℓ 1
  have key : ∀ z : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
      ((SheafOfModules.toSheaf (wcIntRingSheaf Y ℓ)).obj (wcIntTors Y ℓ 1)) (2 * n + 1),
      z = 0 := by
    intro z
    have hy : z.comp (Abelian.Ext.mk₀ e.hom) (add_zero _) = 0 := Subsingleton.elim _ _
    have hz : z = (z.comp (Abelian.Ext.mk₀ e.hom) (add_zero _)).comp
        (Abelian.Ext.mk₀ e.inv) (add_zero _) := by
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
        Abelian.Ext.comp_mk₀_id]
    rw [hz, hy, Abelian.Ext.zero_comp]
  haveI hsub2 : Subsingleton (Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
      ((SheafOfModules.toSheaf (wcIntRingSheaf Y ℓ)).obj (wcIntTors Y ℓ 1)) (2 * n + 1)) :=
    ⟨fun a b => (key a).trans (key b).symm⟩

  obtain ⟨Φ⟩ := wc_int_unit_ext_free_equiv Y ℓ (wcIntTors Y ℓ 1) (2 * n + 1)
  haveI : Subsingleton (Abelian.Ext (wcIntUnit Y ℓ) (wcIntTors Y ℓ 1) (2 * n + 1)) :=
    Φ.subsingleton
  exact Subsingleton.elim x 0

theorem wc_int_tors_ext_lift_of_vanish (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (P : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) (N : ℕ) :
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
    (∀ w : Abelian.Ext P (wcIntTors S ℓ 1) (N + 1), w = 0) →
    ∀ (m : ℕ), 1 ≤ m → ∀ a : Abelian.Ext P (wcIntTors S ℓ m) N,
    ∃ a' : Abelian.Ext P (wcIntTors S ℓ (m + 1)) N,
      ∀ t : wcIntTors S ℓ (m + 1) ⟶ wcIntTors S ℓ m,
        Limits.cokernel.π ((ℓ ^ (m + 1) : ℕ) • 𝟙 (wcIntUnit S ℓ)) ≫ t =
          Limits.cokernel.π ((ℓ ^ m : ℕ) • 𝟙 (wcIntUnit S ℓ)) →
        a'.comp (Abelian.Ext.mk₀ t) (add_zero N) = a :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
  intro hvan m _hm a
  have tors : ∀ (U : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) (n : ℕ → (U ⟶ U)),
      (∀ k, Mono (n k)) → (∀ a b, n a ≫ n b = n (a + b)) → ∀ k : ℕ,
      ∃ (ι : Limits.cokernel (n 1) ⟶ Limits.cokernel (n (k + 1)))
        (t₀ : Limits.cokernel (n (k + 1)) ⟶ Limits.cokernel (n k)) (w : ι ≫ t₀ = 0),
        Limits.cokernel.π (n (k + 1)) ≫ t₀ = Limits.cokernel.π (n k) ∧
          (ShortComplex.mk ι t₀ w).ShortExact := by
    intro U n hmono hnn k
    have E1 : n (k + 1) ≫ Limits.cokernel.π (n k) = 0 := by
      rw [show k + 1 = 1 + k by omega, ← hnn, Category.assoc, Limits.cokernel.condition,
        Limits.comp_zero]
    have E2 : n 1 ≫ (n k ≫ Limits.cokernel.π (n (k + 1))) = 0 := by
      rw [← Category.assoc, hnn, show 1 + k = k + 1 by omega, Limits.cokernel.condition]
    obtain ⟨t₀, F1⟩ : ∃ t₀ : Limits.cokernel (n (k + 1)) ⟶ Limits.cokernel (n k),
        Limits.cokernel.π (n (k + 1)) ≫ t₀ = Limits.cokernel.π (n k) :=
      ⟨Limits.cokernel.desc _ _ E1, Limits.cokernel.π_desc _ _ _⟩
    obtain ⟨ι, F2⟩ : ∃ ι : Limits.cokernel (n 1) ⟶ Limits.cokernel (n (k + 1)),
        Limits.cokernel.π (n 1) ≫ ι = n k ≫ Limits.cokernel.π (n (k + 1)) :=
      ⟨Limits.cokernel.desc _ _ E2, Limits.cokernel.π_desc _ _ _⟩
    have F3 : ι ≫ t₀ = 0 := by
      rw [← cancel_epi (Limits.cokernel.π (n 1)), Limits.comp_zero, reassoc_of% F2, F1,
        Limits.cokernel.condition]
    haveI : Epi t₀ := epi_of_epi_fac F1
    haveI : Mono ι := by
      apply Preadditive.mono_of_cancel_zero
      intro P g hg
      obtain ⟨A', π, hπ, y, hy⟩ := surjective_up_to_refinements_of_epi (Limits.cokernel.π (n 1)) g
      have h1 : (y ≫ n k) ≫ Limits.cokernel.π (n (k + 1)) = 0 := by
        simp only [Category.assoc]
        rw [← F2, ← reassoc_of% hy, hg, Limits.comp_zero]
      obtain ⟨A'', π', hπ', z, hz⟩ :=
        (ShortComplex.exact_cokernel (n (k + 1))).exact_up_to_refinements (y ≫ n k) h1
      have hz' : π' ≫ y ≫ n k = z ≫ n (k + 1) := hz
      haveI := hπ
      haveI := hπ'
      haveI := hmono k
      have h2 : π' ≫ y = z ≫ n 1 := by
        rw [← cancel_mono (n k)]
        simp only [Category.assoc]
        rw [hnn, show 1 + k = k + 1 by omega]
        exact hz'
      have h3 : (π' ≫ π) ≫ g = 0 := by
        simp only [Category.assoc]
        rw [hy, reassoc_of% h2, Limits.cokernel.condition, Limits.comp_zero]
      exact (cancel_epi (π' ≫ π)).1 (h3.trans Limits.comp_zero.symm)
    have hexact : (ShortComplex.mk ι t₀ F3).Exact := by
      rw [ShortComplex.exact_iff_exact_up_to_refinements]
      intro A x₂ hx₂
      have hx₂' : x₂ ≫ t₀ = 0 := hx₂
      obtain ⟨A', π, hπ, y, hy⟩ :=
        surjective_up_to_refinements_of_epi (Limits.cokernel.π (n (k + 1))) x₂
      have h1 : y ≫ Limits.cokernel.π (n k) = 0 := by
        rw [← F1, ← reassoc_of% hy, hx₂', Limits.comp_zero]
      obtain ⟨A'', π', hπ', z, hz⟩ := (ShortComplex.exact_cokernel (n k)).exact_up_to_refinements y h1
      have hz' : π' ≫ y = z ≫ n k := hz
      haveI := hπ
      haveI := hπ'
      refine ⟨A'', π' ≫ π, inferInstance, z ≫ Limits.cokernel.π (n 1), ?_⟩
      show (π' ≫ π) ≫ x₂ = (z ≫ Limits.cokernel.π (n 1)) ≫ ι
      simp only [Category.assoc]
      rw [F2, hy, reassoc_of% hz']
    exact ⟨ι, t₀, F3, F1, ShortComplex.ShortExact.mk' hexact inferInstance inferInstance⟩
  have hnn : ∀ a b : ℕ, ((ℓ ^ a : ℕ) • 𝟙 (wcIntUnit S ℓ)) ≫
      ((ℓ ^ b : ℕ) • 𝟙 (wcIntUnit S ℓ)) =
        ((ℓ ^ (a + b) : ℕ) • 𝟙 (wcIntUnit S ℓ)) := by
    intro a b
    rw [Preadditive.comp_nsmul, Category.comp_id, smul_smul, ← pow_add, Nat.add_comm b a]
  obtain ⟨ι, t₀, w, F1, hS⟩ := tors (wcIntUnit S ℓ)
    (fun k => (ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ))
    (fun k => wc_int_unit_pow_mono S ℓ k) hnn m
  have hobs : a.comp hS.extClass (rfl : N + 1 = N + 1) = 0 := hvan _
  obtain ⟨a', ha'⟩ := Abelian.Ext.covariant_sequence_exact₃ P hS a rfl hobs
  refine ⟨a', fun t ht => ?_⟩
  have htt : t = t₀ :=
    (cancel_epi (Limits.cokernel.π ((ℓ ^ (m + 1) : ℕ) • 𝟙 (wcIntUnit S ℓ)))).1
      (ht.trans F1.symm)
  rw [htt]
  exact ha'

theorem wc_int_ext_tower_milnor (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (P : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) (N : ℕ) :
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
    ∀ (m : ℕ) (a : ∀ k : ℕ, Abelian.Ext P (wcIntTors S ℓ (m + k)) N),
      (∀ (k : ℕ) (t : wcIntTors S ℓ (m + k + 1) ⟶ wcIntTors S ℓ (m + k)),
        Limits.cokernel.π ((ℓ ^ (m + k + 1) : ℕ) • 𝟙 (wcIntUnit S ℓ)) ≫ t =
          Limits.cokernel.π ((ℓ ^ (m + k) : ℕ) • 𝟙 (wcIntUnit S ℓ)) →
        (a (k + 1)).comp (Abelian.Ext.mk₀ t) (add_zero N) = a k) →
      ∃ θz : Abelian.Ext P (wcIntUnit S ℓ) N,
        ∀ k : ℕ, θz.comp (Abelian.Ext.mk₀
          (Limits.cokernel.π ((ℓ ^ (m + k) : ℕ) • 𝟙 (wcIntUnit S ℓ)))) (add_zero N) = a k :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
  intro m a ha

  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) :=
    sheafOfModules_enoughInjectives (Scheme.ProEt.topology S) (wcIntRingSheaf S ℓ)
  haveI : HasExactLimitsOfShape (Discrete ℕ)
      (Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) :=
    wc_proet_products_exact S
  haveI : Limits.PreservesFiniteColimits
      (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)) :=
    sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.ProEt.topology S)
      (wcIntRingSheaf S ℓ)
  haveI : Limits.PreservesLimitsOfShape (Discrete ℕ)
      (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)) := by
    haveI : Limits.PreservesLimitsOfShape (Discrete ℕ)
        (SheafOfModules.forget.{u+1} (wcIntRingSheaf S ℓ) ⋙
          PresheafOfModules.toPresheaf.{u+1} (wcIntRingSheaf S ℓ).obj) := inferInstance
    haveI : Limits.PreservesLimitsOfShape (Discrete ℕ)
        (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ) ⋙
          sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) :=
      Limits.preservesLimitsOfShape_of_natIso
        (Iso.refl _ : SheafOfModules.forget.{u+1} (wcIntRingSheaf S ℓ) ⋙
          PresheafOfModules.toPresheaf.{u+1} (wcIntRingSheaf S ℓ).obj ≅ _)
    exact Limits.preservesLimitsOfShape_of_reflects_of_preserves _
      (sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
  haveI : (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)).ReflectsMonomorphisms :=
    Functor.reflectsMonomorphisms_of_faithful _
  haveI : (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)).ReflectsEpimorphisms :=
    Functor.reflectsEpimorphisms_of_faithful _
  haveI : (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)).ReflectsIsomorphisms :=
    reflectsIsomorphisms_of_reflectsMonomorphisms_of_reflectsEpimorphisms _
  haveI : Limits.ReflectsFiniteColimits
      (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)) :=
    Limits.ReflectsFiniteColimits.mk
      (reflects := fun K _ _ => Limits.reflectsColimitsOfShape_of_reflectsIsomorphisms)
  haveI : HasExactLimitsOfShape (Discrete ℕ) (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) :=
    HasExactLimitsOfShape.domain_of_functor (Discrete ℕ)
      (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ))

  have h : ∀ k : ℕ, ((ℓ ^ (m + k + 1) : ℕ) • 𝟙 (wcIntUnit S ℓ)) ≫
      Limits.cokernel.π ((ℓ ^ (m + k) : ℕ) • 𝟙 (wcIntUnit S ℓ)) = 0 := by
    intro k
    rw [show ℓ ^ (m + k + 1) = ℓ ^ (m + k) * ℓ from pow_succ ℓ (m + k), mul_nsmul,
      Preadditive.nsmul_comp, Limits.cokernel.condition, smul_zero]
  let t : ∀ k : ℕ, wcIntTors S ℓ (m + k + 1) ⟶ wcIntTors S ℓ (m + k) :=
    fun k => Limits.cokernel.desc _
      (Limits.cokernel.π ((ℓ ^ (m + k) : ℕ) • 𝟙 (wcIntUnit S ℓ))) (h k)
  have ht : ∀ k : ℕ, Limits.cokernel.π ((ℓ ^ (m + k + 1) : ℕ) • 𝟙 (wcIntUnit S ℓ)) ≫ t k =
      Limits.cokernel.π ((ℓ ^ (m + k) : ℕ) • 𝟙 (wcIntUnit S ℓ)) :=
    fun k => Limits.cokernel.π_desc _ _ _

  obtain ⟨hz, hS⟩ := wc_int_unit_tower_shortExact S ℓ m t ht

  have hc : ∀ {X₁ X₂ X₃ : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)} {n : ℕ}
      (x : Abelian.Ext P X₁ n) (f : X₁ ⟶ X₂) (g : X₂ ⟶ X₃),
      (x.comp (Abelian.Ext.mk₀ f) (add_zero n)).comp (Abelian.Ext.mk₀ g) (add_zero n) =
        x.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero n) := by
    intro X₁ X₂ X₃ n x f g
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero _) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀]
  obtain ⟨hinj, hsurj⟩ := wc_ext_prod_bijective P
    (∏ᶜ (fun k => wcIntTors S ℓ (m + k))) (fun k => wcIntTors S ℓ (m + k))
    (Limits.Pi.π (fun k => wcIntTors S ℓ (m + k)))
    (Limits.productIsProduct (fun k => wcIntTors S ℓ (m + k))) N
  obtain ⟨x, hx⟩ := hsurj a
  have hxg : x.comp (Abelian.Ext.mk₀ (Limits.Pi.lift (fun k =>
      Limits.Pi.π (fun j => wcIntTors S ℓ (m + j)) k -
        Limits.Pi.π (fun j => wcIntTors S ℓ (m + j)) (k + 1) ≫ t k))) (add_zero _) = 0 := by
    apply hinj
    intro k
    rw [hc, Limits.Pi.lift_comp_π, sub_eq_add_neg, Abelian.Ext.mk₀_add, Abelian.Ext.mk₀_neg,
      Abelian.Ext.comp_add, Abelian.Ext.comp_neg, ← hc, hx k, hx (k + 1), ha k (t k) (ht k),
      add_neg_cancel]
  obtain ⟨θ, hθ⟩ := Abelian.Ext.covariant_sequence_exact₂ P hS x hxg
  have hθ' : θ.comp (Abelian.Ext.mk₀ (Limits.Pi.lift (fun k =>
      Limits.cokernel.π ((ℓ ^ (m + k) : ℕ) • 𝟙 (wcIntUnit S ℓ))))) (add_zero _) = x := hθ
  refine ⟨θ, fun k => ?_⟩
  calc θ.comp (Abelian.Ext.mk₀
        (Limits.cokernel.π ((ℓ ^ (m + k) : ℕ) • 𝟙 (wcIntUnit S ℓ)))) (add_zero N)
      = θ.comp (Abelian.Ext.mk₀ (Limits.Pi.lift (fun k =>
          Limits.cokernel.π ((ℓ ^ (m + k) : ℕ) • 𝟙 (wcIntUnit S ℓ))) ≫
          Limits.Pi.π (fun j => wcIntTors S ℓ (m + j)) k)) (add_zero N) := by
        rw [Limits.Pi.lift_comp_π]
    _ = (θ.comp (Abelian.Ext.mk₀ (Limits.Pi.lift (fun k =>
          Limits.cokernel.π ((ℓ ^ (m + k) : ℕ) • 𝟙 (wcIntUnit S ℓ))))) (add_zero _)).comp
          (Abelian.Ext.mk₀ (Limits.Pi.π (fun j => wcIntTors S ℓ (m + j)) k))
          (add_zero _) := (hc _ _ _).symm
    _ = a k := by rw [hθ', hx k]

theorem wc_ac_int_tors_top_card (K : Type u) [Field K] [IsAlgClosed K]
    {Y : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n : ℕ) [SmoothOfRelativeDimension n pY]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0) :
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _
    Finite (Abelian.Ext (wcIntUnit Y ℓ) (wcIntTors Y ℓ 1) (2 * n)) ∧
    Nat.card (Abelian.Ext (wcIntUnit Y ℓ) (wcIntTors Y ℓ 1) (2 * n)) ≤ ℓ ∧
    ∀ m : ℕ, 1 ≤ m → ℓ ^ m ≤ Nat.card (Abelian.Ext (wcIntUnit Y ℓ) (wcIntTors Y ℓ m) (2 * n)) :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _
  have hE : ∀ m : ℕ, Nonempty (Abelian.Ext (wcIntUnit Y ℓ) (wcIntTors Y ℓ m) (2 * n) ≃
      wcEtCoh Y (ℓ ^ m) (2 * n)) := by
    intro m
    obtain ⟨Φ⟩ := wc_int_unit_ext_free_equiv Y ℓ (wcIntTors Y ℓ m) (2 * n)
    obtain ⟨e⟩ := wc_int_tors_toSheaf_zmod Y ℓ m
    obtain ⟨E3⟩ := wc_proet_etale_comparison_zmod K Y pY (ℓ ^ m) (2 * n)
    let Ψ : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
          ((SheafOfModules.toSheaf (wcIntRingSheaf Y ℓ)).obj (wcIntTors Y ℓ m)) (2 * n) ≃
        Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) (wcZModSheaf Y (ℓ ^ m)) (2 * n) :=
      { toFun := fun z => z.comp (Abelian.Ext.mk₀ e.hom) (add_zero _)
        invFun := fun w => w.comp (Abelian.Ext.mk₀ e.inv) (add_zero _)
        left_inv := fun z => by
          show (z.comp (Abelian.Ext.mk₀ e.hom) (add_zero _)).comp
            (Abelian.Ext.mk₀ e.inv) (add_zero _) = z
          rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
            Abelian.Ext.comp_mk₀_id]
        right_inv := fun w => by
          show (w.comp (Abelian.Ext.mk₀ e.inv) (add_zero _)).comp
            (Abelian.Ext.mk₀ e.hom) (add_zero _) = w
          rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
            Abelian.Ext.comp_mk₀_id] }
    exact ⟨(Φ.trans Ψ).trans E3⟩
  obtain ⟨E1⟩ := hE 1
  rw [pow_one] at E1
  obtain ⟨hfin, hcard⟩ := wc_et_top_coh_card_le K Y pY n ℓ hℓ
  have hdim : topologicalKrullDim Y = (n : WithBot ℕ∞) :=
    le_antisymm (wc_smooth_alg_closed_dim_le K Y pY n) (wc_smooth_irreducible_dim_ge K Y pY n)
  refine ⟨?_, ?_, ?_⟩
  · haveI := hfin
    exact Finite.of_equiv _ E1.symm
  · rw [Nat.card_congr E1]
    exact hcard
  · intro m hm
    obtain ⟨Em⟩ := hE m
    rw [Nat.card_congr Em]
    exact wc_et_top_coh_card_ge K Y pY n hdim ℓ Fact.out hℓ m hm

theorem wc_int_tors_ext_growth_of_card (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (P : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) (N : ℕ) :
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
    (∀ w : Abelian.Ext P (wcIntTors S ℓ 1) (N + 1), w = 0) →
    Finite (Abelian.Ext P (wcIntTors S ℓ 1) N) →
    Nat.card (Abelian.Ext P (wcIntTors S ℓ 1) N) ≤ ℓ →
    (∀ m : ℕ, 1 ≤ m → ℓ ^ m ≤ Nat.card (Abelian.Ext P (wcIntTors S ℓ m) N)) →
    ∀ e : ℕ, ∃ b : Abelian.Ext P (wcIntTors S ℓ (e + 1)) N, ℓ ^ e • b ≠ 0 :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
  intro hvan hfin1 hle1 hge e
  have hℓ2 : 2 ≤ ℓ := (Fact.out : ℓ.Prime).two_le
  have hℓpos : 0 < ℓ := by omega

  have hmono : ∀ k : ℕ, Mono ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ)) := by
    intro k
    have hN : (ℓ ^ k : ℕ) ≠ 0 := pow_ne_zero k (Fact.out : ℓ.Prime).ne_zero
    have hc : ((ℓ ^ k : ℕ) : ℤ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr hN
    have key : ∀ {T : Type u} [TopologicalSpace T] (a b : C(T, ULift.{u+1} ℤ_[ℓ])),
        (ℓ ^ k : ℕ) • a = (ℓ ^ k : ℕ) • b → a = b := by
      intro T _ a b h
      ext t
      have h1 : (ℓ ^ k : ℕ) • (a t).down = (ℓ ^ k : ℕ) • (b t).down :=
        congrArg (fun g : C(T, ULift.{u+1} ℤ_[ℓ]) => (g t).down) h
      rw [nsmul_eq_mul, nsmul_eq_mul] at h1
      exact mul_left_cancel₀ hc h1
    apply Functor.mono_of_mono_map (SheafOfModules.forget (wcIntRingSheaf S ℓ))
    rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
    apply PresheafOfModules.mono_of_injective
    intro X x y hxy
    have e : ((ℓ ^ k : ℕ) • 𝟙 ((SheafOfModules.forget (wcIntRingSheaf S ℓ)).obj
        (wcIntUnit S ℓ))).app X = (ℓ ^ k : ℕ) • 𝟙 _ := by
      rw [← PresheafOfModules.evaluation_map, Functor.map_nsmul, PresheafOfModules.evaluation_map,
        PresheafOfModules.id_app]
      rfl
    rw [e] at hxy
    simp only [ModuleCat.hom_nsmul, ModuleCat.hom_id, LinearMap.smul_apply,
      LinearMap.id_apply] at hxy
    exact key (T := ↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop X))) x y hxy

  have tors : ∀ (U : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) (n : ℕ → (U ⟶ U)),
      (∀ k, Mono (n k)) → (∀ a b, n a ≫ n b = n (a + b)) → ∀ k : ℕ,
      ∃ (ι : Limits.cokernel (n 1) ⟶ Limits.cokernel (n (k + 1)))
        (t₀ : Limits.cokernel (n (k + 1)) ⟶ Limits.cokernel (n k)) (w : ι ≫ t₀ = 0),
        Limits.cokernel.π (n (k + 1)) ≫ t₀ = Limits.cokernel.π (n k) ∧
        Limits.cokernel.π (n 1) ≫ ι = n k ≫ Limits.cokernel.π (n (k + 1)) ∧
          (ShortComplex.mk ι t₀ w).ShortExact := by
    intro U n hmono hnn k
    have E1 : n (k + 1) ≫ Limits.cokernel.π (n k) = 0 := by
      rw [show k + 1 = 1 + k by omega, ← hnn, Category.assoc, Limits.cokernel.condition,
        Limits.comp_zero]
    have E2 : n 1 ≫ (n k ≫ Limits.cokernel.π (n (k + 1))) = 0 := by
      rw [← Category.assoc, hnn, show 1 + k = k + 1 by omega, Limits.cokernel.condition]
    obtain ⟨t₀, F1⟩ : ∃ t₀ : Limits.cokernel (n (k + 1)) ⟶ Limits.cokernel (n k),
        Limits.cokernel.π (n (k + 1)) ≫ t₀ = Limits.cokernel.π (n k) :=
      ⟨Limits.cokernel.desc _ _ E1, Limits.cokernel.π_desc _ _ _⟩
    obtain ⟨ι, F2⟩ : ∃ ι : Limits.cokernel (n 1) ⟶ Limits.cokernel (n (k + 1)),
        Limits.cokernel.π (n 1) ≫ ι = n k ≫ Limits.cokernel.π (n (k + 1)) :=
      ⟨Limits.cokernel.desc _ _ E2, Limits.cokernel.π_desc _ _ _⟩
    have F3 : ι ≫ t₀ = 0 := by
      rw [← cancel_epi (Limits.cokernel.π (n 1)), Limits.comp_zero, reassoc_of% F2, F1,
        Limits.cokernel.condition]
    haveI : Epi t₀ := epi_of_epi_fac F1
    haveI : Mono ι := by
      apply Preadditive.mono_of_cancel_zero
      intro P g hg
      obtain ⟨A', π, hπ, y, hy⟩ := surjective_up_to_refinements_of_epi (Limits.cokernel.π (n 1)) g
      have h1 : (y ≫ n k) ≫ Limits.cokernel.π (n (k + 1)) = 0 := by
        simp only [Category.assoc]
        rw [← F2, ← reassoc_of% hy, hg, Limits.comp_zero]
      obtain ⟨A'', π', hπ', z, hz⟩ :=
        (ShortComplex.exact_cokernel (n (k + 1))).exact_up_to_refinements (y ≫ n k) h1
      have hz' : π' ≫ y ≫ n k = z ≫ n (k + 1) := hz
      haveI := hπ
      haveI := hπ'
      haveI := hmono k
      have h2 : π' ≫ y = z ≫ n 1 := by
        rw [← cancel_mono (n k)]
        simp only [Category.assoc]
        rw [hnn, show 1 + k = k + 1 by omega]
        exact hz'
      have h3 : (π' ≫ π) ≫ g = 0 := by
        simp only [Category.assoc]
        rw [hy, reassoc_of% h2, Limits.cokernel.condition, Limits.comp_zero]
      exact (cancel_epi (π' ≫ π)).1 (h3.trans Limits.comp_zero.symm)
    have hexact : (ShortComplex.mk ι t₀ F3).Exact := by
      rw [ShortComplex.exact_iff_exact_up_to_refinements]
      intro A x₂ hx₂
      have hx₂' : x₂ ≫ t₀ = 0 := hx₂
      obtain ⟨A', π, hπ, y, hy⟩ :=
        surjective_up_to_refinements_of_epi (Limits.cokernel.π (n (k + 1))) x₂
      have h1 : y ≫ Limits.cokernel.π (n k) = 0 := by
        rw [← F1, ← reassoc_of% hy, hx₂', Limits.comp_zero]
      obtain ⟨A'', π', hπ', z, hz⟩ := (ShortComplex.exact_cokernel (n k)).exact_up_to_refinements y h1
      have hz' : π' ≫ y = z ≫ n k := hz
      haveI := hπ
      haveI := hπ'
      refine ⟨A'', π' ≫ π, inferInstance, z ≫ Limits.cokernel.π (n 1), ?_⟩
      show (π' ≫ π) ≫ x₂ = (z ≫ Limits.cokernel.π (n 1)) ≫ ι
      simp only [Category.assoc]
      rw [F2, hy, reassoc_of% hz']
    exact ⟨ι, t₀, F3, F1, F2, ShortComplex.ShortExact.mk' hexact inferInstance inferInstance⟩
  have hnn : ∀ a b : ℕ, ((ℓ ^ a : ℕ) • 𝟙 (wcIntUnit S ℓ)) ≫
      ((ℓ ^ b : ℕ) • 𝟙 (wcIntUnit S ℓ)) =
        ((ℓ ^ (a + b) : ℕ) • 𝟙 (wcIntUnit S ℓ)) := by
    intro a b
    rw [Preadditive.comp_nsmul, Category.comp_id, smul_smul, ← pow_add, Nat.add_comm b a]
  have hk : ∀ k : ℕ, ∃ (ι : wcIntTors S ℓ 1 ⟶ wcIntTors S ℓ (k + 1))
      (t : wcIntTors S ℓ (k + 1) ⟶ wcIntTors S ℓ k) (w : ι ≫ t = 0),
      Limits.cokernel.π ((ℓ ^ (k + 1) : ℕ) • 𝟙 (wcIntUnit S ℓ)) ≫ t =
        Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ)) ∧
      Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit S ℓ)) ≫ ι =
        ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ)) ≫
          Limits.cokernel.π ((ℓ ^ (k + 1) : ℕ) • 𝟙 (wcIntUnit S ℓ)) ∧
      (ShortComplex.mk ι t w).ShortExact :=
    fun k => tors (wcIntUnit S ℓ) (fun k => (ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ)) hmono hnn k
  choose ι t w F1 F2 hS using hk

  have hsurj : ∀ (k : ℕ) (x : Abelian.Ext P (wcIntTors S ℓ k) N),
      ∃ y : Abelian.Ext P (wcIntTors S ℓ (k + 1)) N,
        y.comp (Abelian.Ext.mk₀ (t k)) (add_zero N) = x := by
    intro k x
    exact Abelian.Ext.covariant_sequence_exact₃ P (hS k) x rfl (hvan _)
  have hker : ∀ (k : ℕ) (y : Abelian.Ext P (wcIntTors S ℓ (k + 1)) N),
      y.comp (Abelian.Ext.mk₀ (t k)) (add_zero N) = 0 →
      ∃ a : Abelian.Ext P (wcIntTors S ℓ 1) N, a.comp (Abelian.Ext.mk₀ (ι k)) (add_zero N) = y := by
    intro k y hy
    exact Abelian.Ext.covariant_sequence_exact₂ P (hS k) y hy
  have hsubc : ∀ (k : ℕ) (y y' : Abelian.Ext P (wcIntTors S ℓ (k + 1)) N),
      (y - y').comp (Abelian.Ext.mk₀ (t k)) (add_zero N) =
        y.comp (Abelian.Ext.mk₀ (t k)) (add_zero N) - y'.comp (Abelian.Ext.mk₀ (t k)) (add_zero N) := by
    intro k y y'
    rw [eq_sub_iff_add_eq, ← Abelian.Ext.add_comp, sub_add_cancel]

  have hcard : ∀ k : ℕ, 1 ≤ k → Finite (Abelian.Ext P (wcIntTors S ℓ k) N) ∧
      Nat.card (Abelian.Ext P (wcIntTors S ℓ k) N) ≤ ℓ ^ k := by
    intro k hk
    induction k, hk using Nat.le_induction with
    | base => exact ⟨hfin1, by rw [pow_one]; exact hle1⟩
    | succ k hk ih =>
      obtain ⟨hfk, hck⟩ := ih
      haveI := hfk
      haveI := hfin1
      choose s hs using hsurj k
      let Φ : Abelian.Ext P (wcIntTors S ℓ k) N × Abelian.Ext P (wcIntTors S ℓ 1) N →
          Abelian.Ext P (wcIntTors S ℓ (k + 1)) N :=
        fun q => s q.1 + q.2.comp (Abelian.Ext.mk₀ (ι k)) (add_zero N)
      have hΦ : Function.Surjective Φ := by
        intro b
        have h0 : (b - s (b.comp (Abelian.Ext.mk₀ (t k)) (add_zero N))).comp
            (Abelian.Ext.mk₀ (t k)) (add_zero N) = 0 := by
          rw [hsubc, hs, sub_self]
        obtain ⟨a, ha⟩ := hker k _ h0
        refine ⟨(b.comp (Abelian.Ext.mk₀ (t k)) (add_zero N), a), ?_⟩
        show s _ + a.comp _ _ = b
        rw [ha]
        abel
      haveI : Finite (Abelian.Ext P (wcIntTors S ℓ (k + 1)) N) := Finite.of_surjective Φ hΦ
      refine ⟨inferInstance, ?_⟩
      calc Nat.card (Abelian.Ext P (wcIntTors S ℓ (k + 1)) N)
          ≤ Nat.card (Abelian.Ext P (wcIntTors S ℓ k) N × Abelian.Ext P (wcIntTors S ℓ 1) N) :=
            Nat.card_le_card_of_surjective Φ hΦ
        _ = Nat.card (Abelian.Ext P (wcIntTors S ℓ k) N) *
              Nat.card (Abelian.Ext P (wcIntTors S ℓ 1) N) := Nat.card_prod _ _
        _ ≤ ℓ ^ k * ℓ := Nat.mul_le_mul hck hle1
        _ = ℓ ^ (k + 1) := (pow_succ ℓ k).symm

  have hnz : ∀ k : ℕ, 1 ≤ k → ∃ a : Abelian.Ext P (wcIntTors S ℓ 1) N,
      a.comp (Abelian.Ext.mk₀ (ι k)) (add_zero N) ≠ 0 := by
    intro k hk
    by_contra hcon
    push_neg at hcon
    obtain ⟨hfk, hck⟩ := hcard k hk
    haveI := hfk
    have hinj : Function.Injective (fun y : Abelian.Ext P (wcIntTors S ℓ (k + 1)) N =>
        y.comp (Abelian.Ext.mk₀ (t k)) (add_zero N)) := by
      intro y y' hyy
      have h0 : (y - y').comp (Abelian.Ext.mk₀ (t k)) (add_zero N) = 0 := by
        rw [hsubc, sub_eq_zero]
        exact hyy
      obtain ⟨a, ha⟩ := hker k _ h0
      rw [hcon a] at ha
      exact sub_eq_zero.mp ha.symm
    have h1 := Nat.card_le_card_of_injective _ hinj
    have h2 := hge (k + 1) (by omega)
    have h3 : ℓ ^ k * 2 ≤ ℓ ^ k * ℓ := Nat.mul_le_mul_left _ hℓ2
    have h4 : 0 < ℓ ^ k := pow_pos hℓpos k
    rw [pow_succ] at h2
    omega

  have hr : ∀ e : ℕ, ((ℓ ^ (e + 1) : ℕ) • 𝟙 (wcIntUnit S ℓ)) ≫
      Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit S ℓ)) = 0 := by
    intro e
    rw [← hnn e 1, Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
  have hrex : ∀ e : ℕ, ∃ r : wcIntTors S ℓ (e + 1) ⟶ wcIntTors S ℓ 1,
      Limits.cokernel.π ((ℓ ^ (e + 1) : ℕ) • 𝟙 (wcIntUnit S ℓ)) ≫ r =
        Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit S ℓ)) :=
    fun e => ⟨Limits.cokernel.desc _ _ (hr e), Limits.cokernel.π_desc _ _ _⟩
  choose r R1 using hrex
  have hrt : ∀ e : ℕ, r (e + 1) = t (e + 1) ≫ r e := by
    intro e
    rw [← cancel_epi (Limits.cokernel.π ((ℓ ^ (e + 1 + 1) : ℕ) • 𝟙 (wcIntUnit S ℓ))), R1 (e + 1),
      reassoc_of% (F1 (e + 1)), R1 e]
  have hr1 : r 1 = t 1 :=
    (cancel_epi (Limits.cokernel.π ((ℓ ^ (1 + 1) : ℕ) • 𝟙 (wcIntUnit S ℓ)))).1
      ((R1 1).trans (F1 1).symm)
  have hrs : ∀ e : ℕ, 1 ≤ e → ∀ c : Abelian.Ext P (wcIntTors S ℓ 1) N,
      ∃ b : Abelian.Ext P (wcIntTors S ℓ (e + 1)) N,
        b.comp (Abelian.Ext.mk₀ (r e)) (add_zero N) = c := by
    intro e he
    induction e, he using Nat.le_induction with
    | base =>
      intro c
      rw [hr1]
      exact hsurj 1 c
    | succ e he ih =>
      intro c
      obtain ⟨b', hb'⟩ := ih c
      obtain ⟨b, hb⟩ := hsurj (e + 1) b'
      refine ⟨b, ?_⟩
      rw [hrt e, ← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.comp_assoc_of_third_deg_zero, hb, hb']

  have hK : ∀ e : ℕ, ((ℓ ^ e : ℕ) • 𝟙 (wcIntTors S ℓ (e + 1))) = r e ≫ ι e := by
    intro e
    rw [← cancel_epi (Limits.cokernel.π ((ℓ ^ (e + 1) : ℕ) • 𝟙 (wcIntUnit S ℓ))),
      Preadditive.comp_nsmul, Category.comp_id, reassoc_of% (R1 e), F2 e,
      Preadditive.nsmul_comp, Category.id_comp]
  have hV : ∀ (L : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) (x : Abelian.Ext P L N) (c : ℕ),
      x.comp (Abelian.Ext.mk₀ (c • 𝟙 L)) (add_zero N) = c • x := by
    intro L x c
    induction c with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    | succ c ih =>
      rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih,
        Abelian.Ext.comp_mk₀_id]

  rcases Nat.eq_zero_or_pos e with he | he
  · subst he
    have h1 : 1 < Nat.card (Abelian.Ext P (wcIntTors S ℓ 1) N) := by
      have := hge 1 le_rfl
      rw [pow_one] at this
      omega
    haveI := hfin1
    haveI : Nontrivial (Abelian.Ext P (wcIntTors S ℓ 1) N) :=
      Finite.one_lt_card_iff_nontrivial.mp h1
    obtain ⟨c, hc⟩ := exists_ne (0 : Abelian.Ext P (wcIntTors S ℓ 1) N)
    refine ⟨c, ?_⟩
    rw [pow_zero, one_nsmul]
    exact hc
  · obtain ⟨e', rfl⟩ : ∃ e', e = e' + 1 := ⟨e - 1, by omega⟩
    obtain ⟨a, ha⟩ := hnz (e' + 1) (by omega)
    obtain ⟨b, hb⟩ := hrs (e' + 1) (by omega) a
    refine ⟨b, fun h0 => ha ?_⟩
    rw [← hV _ b (ℓ ^ (e' + 1)), hK (e' + 1), ← Abelian.Ext.mk₀_comp_mk₀,
      ← Abelian.Ext.comp_assoc_of_third_deg_zero, hb] at h0
    exact h0

theorem wc_ac_int_supp_rational (K : Type u) [Field K] [IsAlgClosed K]
    {Y : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n : ℕ) [SmoothOfRelativeDimension n pY]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (y₀ : Spec (.of K) ⟶ Y) (hy₀ : y₀ ≫ pY = 𝟙 _)
    (Dy : wcHMPullData y₀ ℓ) (hDy : wcHMPullCanonical Dy) :
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _
    ∃ (rat : Abelian.Ext (wcIntSuppObj Dy) (wcIntUnit Y ℓ) (2 * n) →+ wcSuppExt Dy (2 * n))
      (ratB : Abelian.Ext (wcIntUnit Y ℓ) (wcIntUnit Y ℓ) (2 * n) →+ wcHM Y ℓ (2 * n)),
      (∀ θz, wcSuppClass Dy (2 * n) (rat θz) =
        ratB ((Abelian.Ext.mk₀ (wcIntSuppπ Dy)).comp θz (zero_add (2 * n)))) ∧
      (∀ y, ratB y = 0 → ∃ r : ℕ, ℓ ^ r • y = 0) :=
by
  classical
  letI hΛ : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _
  letI hR : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _

  obtain ⟨hU1, hInj, hLoc⟩ := wc_int_rat_ring_localization_data Y ℓ
  obtain ⟨L, adj, hLA, hLL, hLC⟩ :=
    sheafOfModules_restrictScalars_exact_left_adjoint_of_localization
      (Scheme.ProEt.topology Y) (wcIntRingSheaf Y ℓ)
      (wcRingSheaf Y ℓ) (wcIntRatRingSheafMap Y ℓ) ℓ hU1 hInj hLoc

  have hGΛC := sheafOfModules_toSheaf_preservesFiniteColimits
    (Scheme.ProEt.topology Y) (wcIntRingSheaf Y ℓ)
  have hGRC := sheafOfModules_toSheaf_preservesFiniteColimits
    (Scheme.ProEt.topology Y) (wcRingSheaf Y ℓ)
  haveI hρL : Limits.PreservesFiniteLimits
      (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap Y ℓ)) := by
    haveI : Limits.PreservesFiniteLimits
        (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap Y ℓ) ⋙
          SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf Y ℓ)) :=
      inferInstanceAs (Limits.PreservesFiniteLimits (SheafOfModules.toSheaf.{u+1} (wcRingSheaf Y ℓ)))
    haveI : Limits.ReflectsFiniteLimits (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf Y ℓ)) :=
      Limits.reflectsFiniteLimits_of_reflectsIsomorphisms _
    exact Limits.preservesFiniteLimits_of_reflects_of_preserves _
      (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf Y ℓ))
  haveI hρC : Limits.PreservesFiniteColimits
      (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap Y ℓ)) := by
    haveI : Limits.PreservesFiniteColimits
        (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap Y ℓ) ⋙
          SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf Y ℓ)) :=
      inferInstanceAs (Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} (wcRingSheaf Y ℓ)))
    haveI : Limits.ReflectsFiniteColimits (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf Y ℓ)) :=
      { reflects := fun J _ _ => by
          haveI hfc : Limits.HasFiniteColimits (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) :=
            inferInstance
          haveI : Limits.HasColimitsOfShape J (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) :=
            Limits.HasFiniteColimits.out J
          haveI : Limits.PreservesColimitsOfShape J
              (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf Y ℓ)) :=
            Limits.PreservesFiniteColimits.preservesFiniteColimits J
          exact Limits.reflectsColimitsOfShape_of_reflectsIsomorphisms }
    exact Limits.preservesFiniteColimits_of_reflects_of_preserves _
      (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf Y ℓ))

  have hU := sheafOfModules_unitRestrict_hom_bijective (wcIntRingSheaf Y ℓ)
    (wcRingSheaf Y ℓ) (wcIntRatRingSheafMap Y ℓ)
  haveI : IsClosedImmersion (y₀ ≫ pY) := by rw [hy₀]; infer_instance
  haveI : IsClosedImmersion y₀ := IsClosedImmersion.of_comp y₀ pY
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY
  have hEpi : Epi (wcSuppUnitMap Dy) := wc_supp_unit_epi_of_noetherian y₀ ℓ Dy hDy
  have hκ := sheafOfModules_unitRestrict_image_hom_bijective (Scheme.ProEt.topology Y)
    (wcIntRingSheaf Y ℓ) (wcRingSheaf Y ℓ)
    (wcIntRatRingSheafMap Y ℓ) ℓ hU1 hLoc hU (wcSuppObj Dy) (wcSuppUnitMap Dy) hEpi

  obtain ⟨ΦB, hΦB⟩ : ∃ Φ : wcHM Y ℓ (2 * n) →+
      Abelian.Ext (wcIntUnit Y ℓ)
        ((SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap Y ℓ)).obj
          (SheafOfModules.unit (wcRingSheaf Y ℓ))) (2 * n),
      ∀ x, Φ x = (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntRatRingSheafMap Y ℓ))).comp
        (Abelian.Ext.mapExactFunctor
          (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap Y ℓ)) x) (zero_add (2 * n)) :=
    ⟨AddMonoidHom.mk' (fun x =>
        (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntRatRingSheafMap Y ℓ))).comp
          (Abelian.Ext.mapExactFunctor
            (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap Y ℓ)) x) (zero_add (2 * n)))
      (fun a b => by rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.comp_add]), fun _ => rfl⟩
  obtain ⟨ΦA, hΦA⟩ : ∃ Φ : wcSuppExt Dy (2 * n) →+
      Abelian.Ext (wcIntSuppObj Dy)
        ((SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap Y ℓ)).obj
          (SheafOfModules.unit (wcRingSheaf Y ℓ))) (2 * n),
      ∀ x, Φ x = (Abelian.Ext.mk₀ (Limits.image.ι (wcIntSuppMap Dy))).comp
        (Abelian.Ext.mapExactFunctor
          (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap Y ℓ)) x) (zero_add (2 * n)) :=
    ⟨AddMonoidHom.mk' (fun x =>
        (Abelian.Ext.mk₀ (Limits.image.ι (wcIntSuppMap Dy))).comp
          (Abelian.Ext.mapExactFunctor
            (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap Y ℓ)) x) (zero_add (2 * n)))
      (fun a b => by rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.comp_add]), fun _ => rfl⟩
  obtain ⟨ΨB, hΨB⟩ : ∃ Ψ : Abelian.Ext (wcIntUnit Y ℓ) (wcIntUnit Y ℓ) (2 * n) →+
      Abelian.Ext (wcIntUnit Y ℓ)
        ((SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap Y ℓ)).obj
          (SheafOfModules.unit (wcRingSheaf Y ℓ))) (2 * n),
      ∀ y, Ψ y = y.comp (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntRatRingSheafMap Y ℓ)))
        (add_zero (2 * n)) :=
    ⟨AddMonoidHom.mk' (fun y => y.comp
        (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntRatRingSheafMap Y ℓ))) (add_zero (2 * n)))
      (fun a b => Abelian.Ext.add_comp _ _ _ _), fun _ => rfl⟩
  obtain ⟨ΨA, hΨA⟩ : ∃ Ψ : Abelian.Ext (wcIntSuppObj Dy) (wcIntUnit Y ℓ) (2 * n) →+
      Abelian.Ext (wcIntSuppObj Dy)
        ((SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap Y ℓ)).obj
          (SheafOfModules.unit (wcRingSheaf Y ℓ))) (2 * n),
      ∀ y, Ψ y = y.comp (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntRatRingSheafMap Y ℓ)))
        (add_zero (2 * n)) :=
    ⟨AddMonoidHom.mk' (fun y => y.comp
        (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntRatRingSheafMap Y ℓ))) (add_zero (2 * n)))
      (fun a b => Abelian.Ext.add_comp _ _ _ _), fun _ => rfl⟩
  have hΦBb : Function.Bijective ΦB := by
    have e : (⇑ΦB) = fun x => (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntRatRingSheafMap Y ℓ))).comp
        (Abelian.Ext.mapExactFunctor
          (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap Y ℓ)) x) (zero_add (2 * n)) :=
      funext hΦB
    rw [e]
    exact ext_transfer_of_hom_bijective L
      (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap Y ℓ)) adj
      (wcIntUnit Y ℓ) (SheafOfModules.unit (wcRingSheaf Y ℓ))
      (wcUnitRestrict (wcIntRatRingSheafMap Y ℓ)) hU
      (SheafOfModules.unit (wcRingSheaf Y ℓ)) (2 * n)
  have hΦAb : Function.Bijective ΦA := by
    have e : (⇑ΦA) = fun x => (Abelian.Ext.mk₀ (Limits.image.ι (wcIntSuppMap Dy))).comp
        (Abelian.Ext.mapExactFunctor
          (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap Y ℓ)) x) (zero_add (2 * n)) :=
      funext hΦA
    rw [e]
    exact ext_transfer_of_hom_bijective L
      (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap Y ℓ)) adj
      (wcIntSuppObj Dy) (wcSuppObj Dy) (Limits.image.ι (wcIntSuppMap Dy)) hκ
      (SheafOfModules.unit (wcRingSheaf Y ℓ)) (2 * n)

