    rw [op_comp, PresheafOfModules.map_comp_apply, ← hs₁def, ← hyres]
    exact sub_eq_iff_eq_add'.mp he.symm

theorem wc_et_smooth_pair_supp_top_card_le (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0) (D : wcEtPullData i ℓ) :
    Finite (wcEtSuppExt D (2 * n)) ∧ Nat.card (wcEtSuppExt D (2 * n)) ≤ ℓ :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) := HasExt.standard _
  have hℓ2 : 2 ≤ ℓ := (Fact.out : Nat.Prime ℓ).two_le
  haveI : Fact (1 < ℓ) := ⟨by omega⟩
  haveI : NeZero ℓ := ⟨by omega⟩
  haveI := D.additive
  haveI hPadd : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _
      D.cont D.φ).Additive :=
    Adjunction.right_adjoint_additive D.adj
  haveI hPlim : Limits.PreservesFiniteLimits
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ) := by
    haveI := D.adj.rightAdjoint_preservesLimits.{0, 0}
    exact Limits.PreservesLimitsOfSize.preservesFiniteLimits.{0, 0} _
  haveI hLA := wc_et_closed_push_modules_isLeftAdjoint_u1 i ℓ D
  haveI hRadd : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _
      D.cont D.φ).rightAdjoint.Additive :=
    Adjunction.right_adjoint_additive
      (Adjunction.ofIsLeftAdjoint
        (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ))
  haveI := sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology Z) (wcEtZModRing Z ℓ)
  haveI := sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology Y) (wcEtZModRing Y ℓ)

  have hℓ1 : ℓ • 𝟙 (SheafOfModules.unit (wcEtZModRing Z ℓ)) = 0 := by
    apply (SheafOfModules.toSheaf (wcEtZModRing Z ℓ)).map_injective
    rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id,
      CategoryTheory.Functor.map_zero]
    exact wc_et_zmod_toSheaf_nsmul_zero Z ℓ _
  have hmod : ∀ k : ℕ, k • 𝟙 (SheafOfModules.unit (wcEtZModRing Z ℓ)) =
      (k % ℓ) • 𝟙 (SheafOfModules.unit (wcEtZModRing Z ℓ)) := by
    intro k
    conv_lhs => rw [← Nat.mod_add_div k ℓ]
    rw [add_nsmul, mul_comm, ← smul_smul, hℓ1, smul_zero, add_zero]

  let γ : ZMod ℓ → (SheafOfModules.unit (wcEtZModRing Z ℓ) ⟶
      SheafOfModules.unit (wcEtZModRing Z ℓ)) := fun c => c.val • 𝟙 _
  have hγ1 : γ 1 = 𝟙 _ := by
    show (1 : ZMod ℓ).val • 𝟙 _ = 𝟙 _
    rw [ZMod.val_one, one_nsmul]
  have hγmul : ∀ a b : ZMod ℓ, γ (a * b) = γ b ≫ γ a := by
    intro a b
    show (a * b).val • 𝟙 _ = (b.val • 𝟙 _) ≫ (a.val • 𝟙 _)
    rw [ZMod.val_mul, ← hmod, Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp,
      smul_smul, mul_comm]
  have hγadd : ∀ a b : ZMod ℓ, γ (a + b) = γ a + γ b := by
    intro a b
    show (a + b).val • 𝟙 _ = a.val • 𝟙 _ + b.val • 𝟙 _
    rw [ZMod.val_add, ← hmod, add_nsmul]

  obtain ⟨φ, hφ⟩ := wc_et_closed_rightAdj_top_homology_unit_epi K pY n m r hmr i ℓ hℓ D
    (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ).rightAdjoint
    (Adjunction.ofIsLeftAdjoint
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ))
    (injectiveResolution (SheafOfModules.unit (wcEtZModRing Y ℓ)))
    wc_et_smooth_pair_supp_local_thom_gen

  obtain ⟨N, e, -, hN⟩ := wc_leray_ext_dim_bound (K := ZMod ℓ)
    (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ)
    (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ).rightAdjoint
    (Adjunction.ofIsLeftAdjoint
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ))
    (SheafOfModules.unit (wcEtZModRing Z ℓ)) γ hγ1 hγmul hγadd
    (SheafOfModules.unit (wcEtZModRing Y ℓ))
    (injectiveResolution (SheafOfModules.unit (wcEtZModRing Y ℓ))) (2 * n)
    (fun p => if p = 2 * m then 1 else 0)
    (by
      intro p hp
      have key : Finite (Abelian.Ext (SheafOfModules.unit (wcEtZModRing Z ℓ))
          ((((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _
            D.cont D.φ).rightAdjoint.mapHomologicalComplex (ComplexShape.up ℕ)).obj
            (injectiveResolution (SheafOfModules.unit (wcEtZModRing Y ℓ))).cocomplex).homology
              (2 * n - p)) p) ∧
          Nat.card (Abelian.Ext (SheafOfModules.unit (wcEtZModRing Z ℓ))
          ((((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _
            D.cont D.φ).rightAdjoint.mapHomologicalComplex (ComplexShape.up ℕ)).obj
            (injectiveResolution (SheafOfModules.unit (wcEtZModRing Y ℓ))).cocomplex).homology
              (2 * n - p)) p) ≤ ℓ ^ (if p = 2 * m then 1 else 0) := by
        rcases lt_trichotomy p (2 * m) with hlt | heq | hgt
        · have hz := wc_et_closed_push_rightAdj_high_vanishing K Y pY n m Z i ℓ hℓ D
            (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _
              D.cont D.φ).rightAdjoint
            (Adjunction.ofIsLeftAdjoint
              (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ))
            (injectiveResolution (SheafOfModules.unit (wcEtZModRing Y ℓ))) (2 * n - p)
            (by omega)
          have h0 : ∀ y : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Z ℓ))
              ((((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _
                D.cont D.φ).rightAdjoint.mapHomologicalComplex (ComplexShape.up ℕ)).obj
                (injectiveResolution (SheafOfModules.unit (wcEtZModRing Y ℓ))).cocomplex).homology
                  (2 * n - p)) p, y = 0 := by
            intro y
            calc y = y.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero p) := (Abelian.Ext.comp_mk₀_id y).symm
              _ = y.comp (Abelian.Ext.mk₀ 0) (add_zero p) := by rw [hz.eq_of_tgt (𝟙 _) 0]
              _ = 0 := by rw [Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
          haveI hsub : Subsingleton (Abelian.Ext (SheafOfModules.unit (wcEtZModRing Z ℓ))
              ((((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _
                D.cont D.φ).rightAdjoint.mapHomologicalComplex (ComplexShape.up ℕ)).obj
                (injectiveResolution (SheafOfModules.unit (wcEtZModRing Y ℓ))).cocomplex).homology
                  (2 * n - p)) p) := ⟨fun a b => (h0 a).trans (h0 b).symm⟩
          refine ⟨inferInstance, ?_⟩
          rw [if_neg (by omega), pow_zero]
          exact Finite.card_le_one_iff_subsingleton.mpr hsub
        · subst heq
          rw [if_pos rfl, pow_one, show 2 * n - 2 * m = 2 * r by omega]
          exact wc_et_ext_top_card_le_of_unit_epi K Z (i ≫ pY) m ℓ hℓ _ φ hφ
        · have h0 : ∀ y : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Z ℓ))
              ((((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _
                D.cont D.φ).rightAdjoint.mapHomologicalComplex (ComplexShape.up ℕ)).obj
                (injectiveResolution (SheafOfModules.unit (wcEtZModRing Y ℓ))).cocomplex).homology
                  (2 * n - p)) p, y = 0 :=
            fun y => wc_et_smooth_qcqs_module_cd K Z (i ≫ pY) m ℓ hℓ _ p hgt y
          haveI hsub : Subsingleton (Abelian.Ext (SheafOfModules.unit (wcEtZModRing Z ℓ))
              ((((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _
                D.cont D.φ).rightAdjoint.mapHomologicalComplex (ComplexShape.up ℕ)).obj
                (injectiveResolution (SheafOfModules.unit (wcEtZModRing Y ℓ))).cocomplex).homology
                  (2 * n - p)) p) := ⟨fun a b => (h0 a).trans (h0 b).symm⟩
          refine ⟨inferInstance, ?_⟩
          rw [if_neg (by omega), pow_zero]
          exact Finite.card_le_one_iff_subsingleton.mpr hsub
      obtain ⟨hfin, hcard⟩ := key
      obtain ⟨np, e, he, hnp⟩ := wc_zmod_ext_linear_equiv_of_finite ℓ
        (SheafOfModules.unit (wcEtZModRing Z ℓ)) _ γ hγ1 hγmul hγadd p hfin
      refine ⟨np, e, he, ?_⟩
      rw [← hnp] at hcard
      exact (Nat.pow_le_pow_iff_right (by omega)).mp hcard)

  have hsum : ∑ p ∈ Finset.range (2 * n + 1), (if p = 2 * m then 1 else 0) = 1 := by
    rw [Finset.sum_ite_eq', if_pos (Finset.mem_range.mpr (by omega))]
  rw [hsum] at hN
  have hfinE : Finite (Abelian.Ext
      ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ).obj
        (SheafOfModules.unit (wcEtZModRing Z ℓ))) (SheafOfModules.unit (wcEtZModRing Y ℓ))
        (2 * n)) := Finite.of_equiv _ e.toEquiv.symm
  have hcardE : Nat.card (Abelian.Ext
      ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ).obj
        (SheafOfModules.unit (wcEtZModRing Z ℓ))) (SheafOfModules.unit (wcEtZModRing Y ℓ))
        (2 * n)) ≤ ℓ := by
    rw [Nat.card_congr e.toEquiv, Nat.card_fun, Nat.card_zmod, Nat.card_eq_fintype_card (α := Fin N),
      Fintype.card_fin]
    calc ℓ ^ N ≤ ℓ ^ 1 := Nat.pow_le_pow_right (by omega) hN
      _ = ℓ := pow_one ℓ
  exact ⟨hfinE, hcardE⟩

theorem wc_et_smooth_pair_open_restr_surj (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n : ℕ) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (O : Y.Opens) (hO : (O : Set Y) = (Set.range i)ᶜ)
    (hD : ∀ D : wcEtPullData i ℓ,
      Finite (wcEtSuppExt D (2 * n)) ∧ Nat.card (wcEtSuppExt D (2 * n)) ≤ ℓ)
    (s : ℕ) (hs : s + 1 = 2 * n) (Dj : wcEtPullData O.ι ℓ) :
    Function.Surjective (wcEtPull Dj s) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing O.toScheme ℓ)) := HasExt.standard _
  haveI := Dj.additive
  haveI := Dj.presLim
  haveI := Dj.presColim
  have hℓpos : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos
  have h1 : 1 + s = 2 * n := by omega
  have hc : Set.range O.ι = (Set.range i)ᶜ := (Scheme.Opens.range_ι O).trans hO
  have hne : Set.range O.ι ≠ Set.univ := by
    intro h
    obtain ⟨z₀⟩ := (IrreducibleSpace.toNonempty : Nonempty Z)
    have hz : i z₀ ∈ Set.range O.ι := by rw [h]; exact Set.mem_univ _
    rw [hc] at hz
    exact hz ⟨z₀, rfl⟩
  obtain ⟨D⟩ := wc_et_zmod_pull_data_exists i ℓ
  haveI hπ : Epi (wcEtSuppUnitMap D) := wc_et_supp_unit_epi i D
  have hS : (ShortComplex.mk (Limits.kernel.ι (wcEtSuppUnitMap D)) (wcEtSuppUnitMap D)
      (Limits.kernel.condition (wcEtSuppUnitMap D))).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel (wcEtSuppUnitMap D)) inferInstance hπ

  have hB0 : Limits.IsZero (Dj.Φ.obj (wcEtSuppObj D)) := by
    have hsq := IsPullback.of_hasPullback i O.ι
    haveI : IsClosedImmersion (Limits.pullback.snd i O.ι) :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq inferInstance
    have hE : IsEmpty ↥(Limits.pullback i O.ι : Scheme.{u}) := by
      apply Scheme.isEmpty_of_commSq hsq.toCommSq
      rw [hc]
      exact disjoint_compl_right
    obtain ⟨D'⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.snd i O.ι) ℓ
    obtain ⟨γ, hγ, _⟩ := wc_et_closed_supp_base_change i O.ι (Limits.pullback.snd i O.ι)
      (Limits.pullback.fst i O.ι) hsq D Dj D'
    have hZ' : Limits.IsZero (wcEtSuppObj D') := by
      rw [Limits.IsZero.iff_id_eq_zero]
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro W
      haveI := wc_et_closed_supp_obj_vanish (Limits.pullback.snd i O.ι) ℓ D' W.unop
        (fun _ ⟨p, _⟩ => hE.false p)
      exact (ModuleCat.isZero_of_subsingleton _).eq_of_src _ _
    have h0 : Dj.μ.inv ≫ Dj.Φ.map (wcEtSuppUnitMap D) = 0 := by
      rw [← hγ, hZ'.eq_of_src γ 0, Limits.comp_zero]
    haveI : Dj.Φ.IsLeftAdjoint := Dj.adj.isLeftAdjoint
    haveI : Epi (Dj.Φ.map (wcEtSuppUnitMap D)) := Dj.Φ.map_epi _
    exact Limits.IsZero.of_epi_eq_zero _ h0

  have hconj : ∀ (k : ℕ) (y : Abelian.Ext (Dj.Φ.obj (SheafOfModules.unit (wcEtZModRing Y ℓ)))
      (Dj.Φ.obj (SheafOfModules.unit (wcEtZModRing Y ℓ))) k),
      ((Abelian.Ext.mk₀ Dj.μ.hom).comp ((Abelian.Ext.mk₀ Dj.μ.inv).comp
        (y.comp (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero k)) (zero_add k)) (zero_add k)).comp
        (Abelian.Ext.mk₀ Dj.μ.inv) (add_zero k) = y := by
    intro k y
    rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
      Abelian.Ext.mk₀_id_comp, Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
      Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
  have hconj' : ∀ (k : ℕ) (y : wcEtZModExt O.toScheme ℓ k),
      (Abelian.Ext.mk₀ Dj.μ.inv).comp ((((Abelian.Ext.mk₀ Dj.μ.hom).comp y (zero_add k)).comp
        (Abelian.Ext.mk₀ Dj.μ.inv) (add_zero k)).comp (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero k))
        (zero_add k) = y := by
    intro k y
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
      Abelian.Ext.comp_mk₀_id, ← Abelian.Ext.comp_assoc_of_second_deg_zero,
      Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
  have hpull : ∀ (k : ℕ) (x : wcEtZModExt Y ℓ k), wcEtPull Dj k x = (Abelian.Ext.mk₀ Dj.μ.inv).comp
      ((Dj.Φ.mapExtAddHom (SheafOfModules.unit (wcEtZModRing Y ℓ))
        (SheafOfModules.unit (wcEtZModRing Y ℓ)) k x).comp (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero k))
      (zero_add k) := fun _ _ => rfl

  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) :=
    sheafOfModules_enoughInjectives _ _
  have hKbij : ∀ k : ℕ, Function.Bijective (fun β : Abelian.Ext (Limits.kernel (wcEtSuppUnitMap D))
      (SheafOfModules.unit (wcEtZModRing Y ℓ)) k => Abelian.Ext.mapExactFunctor Dj.Φ β) := by
    intro k
    have h := ext_transfer_of_corep Dj.Φ (Limits.kernel (wcEtSuppUnitMap D))
      (Dj.Φ.obj (Limits.kernel (wcEtSuppUnitMap D))) (𝟙 _)
      (fun Y' => wc_et_open_restr_ker_corep i O.ι hc ℓ hℓpos D Dj Y')
      (fun I _ m e => by
        haveI : Injective (Dj.Φ.obj I) :=
          wc_et_open_pull_preserves_injective O.ι ℓ Dj I inferInstance
        exact Abelian.Ext.eq_zero_of_injective e)
      (SheafOfModules.unit (wcEtZModRing Y ℓ)) k
    simpa only [Abelian.Ext.mk₀_id_comp] using h
  have hSΦ := hS.map_of_exact Dj.Φ
  haveI : IsIso (Dj.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D))) :=
    hSΦ.isIso_f_iff.mpr hB0
  let Ψ : ∀ k : ℕ, Abelian.Ext (Limits.kernel (wcEtSuppUnitMap D))
      (SheafOfModules.unit (wcEtZModRing Y ℓ)) k →
      Abelian.Ext (Dj.Φ.obj (SheafOfModules.unit (wcEtZModRing Y ℓ)))
        (Dj.Φ.obj (SheafOfModules.unit (wcEtZModRing Y ℓ))) k := fun k x =>
    (Abelian.Ext.mk₀ (inv (Dj.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D))))).comp
      (Abelian.Ext.mapExactFunctor Dj.Φ x) (zero_add k)
  have hΨe : ∀ k x, (Abelian.Ext.mk₀ (Dj.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D)))).comp
      (Ψ k x) (zero_add k) = Abelian.Ext.mapExactFunctor Dj.Φ x := by
    intro k x
    show (Abelian.Ext.mk₀ (Dj.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D)))).comp
      ((Abelian.Ext.mk₀ (inv (Dj.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D))))).comp
        (Abelian.Ext.mapExactFunctor Dj.Φ x) (zero_add k)) (zero_add k) = _
    rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀, IsIso.hom_inv_id,
      Abelian.Ext.mk₀_id_comp]
  have hΨinj : ∀ k, Function.Injective (Ψ k) := by
    intro k x x' h
    apply (hKbij k).1
    show Abelian.Ext.mapExactFunctor Dj.Φ x = Abelian.Ext.mapExactFunctor Dj.Φ x'
    rw [← hΨe k x, ← hΨe k x', h]
  have hΨsurj : ∀ k, Function.Surjective (Ψ k) := by
    intro k z
    obtain ⟨x, hx⟩ := (hKbij k).2
      ((Abelian.Ext.mk₀ (Dj.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D)))).comp z (zero_add k))
    refine ⟨x, ?_⟩
    have hx' : Abelian.Ext.mapExactFunctor Dj.Φ x =
        (Abelian.Ext.mk₀ (Dj.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D)))).comp z (zero_add k) := hx
    show (Abelian.Ext.mk₀ (inv (Dj.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D))))).comp
      (Abelian.Ext.mapExactFunctor Dj.Φ x) (zero_add k) = z
    rw [hx', ← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
      IsIso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
  have hΨκ : ∀ (k : ℕ) (w : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y ℓ))
      (SheafOfModules.unit (wcEtZModRing Y ℓ)) k),
      Ψ k ((Abelian.Ext.mk₀ (Limits.kernel.ι (wcEtSuppUnitMap D))).comp w (zero_add k)) =
        Abelian.Ext.mapExactFunctor Dj.Φ w := by
    intro k w
    show (Abelian.Ext.mk₀ (inv (Dj.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D))))).comp
      (Abelian.Ext.mapExactFunctor Dj.Φ
        ((Abelian.Ext.mk₀ (Limits.kernel.ι (wcEtSuppUnitMap D))).comp w (zero_add k))) (zero_add k) = _
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀, IsIso.inv_hom_id,
      Abelian.Ext.mk₀_id_comp]

  have hKsub : Subsingleton (Abelian.Ext (Limits.kernel (wcEtSuppUnitMap D))
      (SheafOfModules.unit (wcEtZModRing Y ℓ)) (2 * n)) := by
    obtain ⟨eO⟩ := wc_et_zmodext_coh_equiv O.toScheme ℓ (2 * n)
    haveI : Subsingleton (wcEtCoh O.toScheme ℓ (2 * n)) :=
      wc_et_open_top_vanishing K Y pY n O.toScheme O.ι hne ℓ Fact.out hℓ
    have hOs : Subsingleton (wcEtZModExt O.toScheme ℓ (2 * n)) := eO.injective.subsingleton
    haveI : Subsingleton (Abelian.Ext (Dj.Φ.obj (SheafOfModules.unit (wcEtZModRing Y ℓ)))
        (Dj.Φ.obj (SheafOfModules.unit (wcEtZModRing Y ℓ))) (2 * n)) := by
      constructor
      intro a b
      have hab := @Subsingleton.elim _ hOs
        ((Abelian.Ext.mk₀ Dj.μ.inv).comp (a.comp (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero _))
          (zero_add _))
        ((Abelian.Ext.mk₀ Dj.μ.inv).comp (b.comp (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero _))
          (zero_add _))
      rw [← hconj (2 * n) a, ← hconj (2 * n) b, hab]
    exact (hΨinj (2 * n)).subsingleton

  have hrsurj : Function.Surjective (fun θ : wcEtSuppExt D (2 * n) =>
      (Abelian.Ext.mk₀ (wcEtSuppUnitMap D)).comp θ (zero_add (2 * n))) := by
    intro x₂
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₂ hS
      (SheafOfModules.unit (wcEtZModRing Y ℓ)) x₂ (@Subsingleton.elim _ hKsub _ _)
    exact ⟨x₁, hx₁⟩
  have hdim : topologicalKrullDim Y = (n : WithBot ℕ∞) :=
    le_antisymm (wc_smooth_alg_closed_dim_le K Y pY n) (wc_smooth_irreducible_dim_ge K Y pY n)
  have hge := wc_et_top_coh_card_ge K Y pY n hdim ℓ Fact.out hℓ 1 le_rfl
  rw [pow_one] at hge
  obtain ⟨eY⟩ := wc_et_zmodext_coh_equiv Y ℓ (2 * n)
  obtain ⟨hfin, hcard⟩ := hD D
  haveI := hfin
  have hrbij := Function.Surjective.bijective_of_nat_card_le hrsurj
    (hcard.trans (hge.trans_eq (Nat.card_congr eY).symm))

  have hδ0 : ∀ x : Abelian.Ext (Limits.kernel (wcEtSuppUnitMap D))
      (SheafOfModules.unit (wcEtZModRing Y ℓ)) s, hS.extClass.comp x h1 = 0 := by
    intro x
