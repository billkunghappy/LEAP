theorem wc_et_mv_restr_zero_injective : ∀ (ℓ n : ℕ) (Z : Scheme.{u}) (A B : Z.Opens) (δ₀ : wcEtZModExt ((A ⊓ B : Z.Opens) : Scheme.{u}) ℓ n →+ wcEtZModExt Z ℓ (n + 1)), (letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) := HasExt.standard _; letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing ((A ⊓ B : Z.Opens) : Scheme.{u}) ℓ)) := HasExt.standard _; ∃ (EA : wcEtPullData A.ι ℓ) (EB : wcEtPullData B.ι ℓ) (EC : wcEtPullData (A ⊓ B).ι ℓ) (LA : SheafOfModules.{u+1} (wcEtZModRing (A : Scheme.{u}) ℓ) ⥤ SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) (adjA : LA ⊣ EA.Φ) (LB : SheafOfModules.{u+1} (wcEtZModRing (B : Scheme.{u}) ℓ) ⥤ SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) (adjB : LB ⊣ EB.Φ) (LC : SheafOfModules.{u+1} (wcEtZModRing ((A ⊓ B : Z.Opens) : Scheme.{u}) ℓ) ⥤ SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) (adjC : LC ⊣ EC.Φ), Limits.PreservesFiniteLimits LA ∧ Limits.PreservesFiniteLimits LB ∧ Limits.PreservesFiniteLimits LC ∧ (∀ N, Mono (adjA.counit.app N)) ∧ (∀ N, Mono (adjB.counit.app N)) ∧ (∀ N, Mono (adjC.counit.app N)) ∧ ∃ (u : LC.obj (EC.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ))) ⟶ LA.obj (EA.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ)))) (v : LC.obj (EC.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ))) ⟶ LB.obj (EB.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ)))), u ≫ adjA.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)) = adjC.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)) ∧ v ≫ adjB.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)) = adjC.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)) ∧ ∃ (w : Limits.biprod.lift u (-v) ≫ Limits.biprod.desc (adjA.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ))) (adjB.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ))) = 0) (hS : (ShortComplex.mk _ _ w).ShortExact), haveI := EC.additive; haveI := EC.presLim; haveI := EC.presColim; ∀ x : Abelian.Ext (LC.obj (EC.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ)))) (SheafOfModules.unit (wcEtZModRing Z ℓ)) n, δ₀ ((Abelian.Ext.mk₀ (EC.μ.inv ≫ adjC.unit.app (EC.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ))))).comp ((Abelian.Ext.mapExactFunctor EC.Φ x).comp (Abelian.Ext.mk₀ EC.μ.hom) (add_zero n)) (zero_add n)) = hS.extClass.comp x (add_comm 1 n)) → ∀ (z : wcEtZModExt Z ℓ 0) (DA : wcEtPullData A.ι ℓ) (DB : wcEtPullData B.ι ℓ), wcEtPull DA 0 z = 0 → wcEtPull DB 0 z = 0 → z = 0 :=
by
  intro ℓ n Z A B δ₀ hG z DA DB h1 h2
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) := HasExt.standard _
  obtain ⟨EA, EB, EC, LA, adjA, LB, adjB, LC, adjC, hLA, hLB, hLC, mA, mB, mC, u, v, hu, hv,
    w, hS, hδ⟩ := hG
  obtain ⟨TA, -, hTAbij, hTA3⟩ := wc_et_extzero_transfer_bijective A ℓ EA LA adjA hLA 0
  obtain ⟨TB, -, hTBbij, hTB3⟩ := wc_et_extzero_transfer_bijective B ℓ EB LB adjB hLB 0
  have hA0 : wcEtPull EA 0 z = 0 := (wc_et_pull_data_indep A.ι EA DA 0 z).trans h1
  have hB0 : wcEtPull EB 0 z = 0 := (wc_et_pull_data_indep B.ι EB DB 0 z).trans h2
  obtain ⟨φ, rfl⟩ : ∃ φ : SheafOfModules.unit (wcEtZModRing Z ℓ) ⟶
      SheafOfModules.unit (wcEtZModRing Z ℓ), Abelian.Ext.mk₀ φ = z :=
    ⟨_, Abelian.Ext.mk₀_homEquiv₀_apply z⟩
  have cA : (Abelian.Ext.mk₀ (adjA.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)))).comp
      (Abelian.Ext.mk₀ φ) (zero_add 0) = 0 :=
    hTAbij.1 ((hTA3 _).trans (hA0.trans (map_zero TA).symm))
  have cB : (Abelian.Ext.mk₀ (adjB.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)))).comp
      (Abelian.Ext.mk₀ φ) (zero_add 0) = 0 :=
    hTBbij.1 ((hTB3 _).trans (hB0.trans (map_zero TB).symm))
  rw [Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_eq_zero_iff] at cA cB
  have hg : Limits.biprod.desc (adjA.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)))
      (adjB.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ))) ≫ φ =
      Limits.biprod.desc (adjA.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)))
      (adjB.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ))) ≫ 0 := by
    rw [Limits.comp_zero]
    apply Limits.biprod.hom_ext'
    · rw [Limits.biprod.inl_desc_assoc, cA, Limits.comp_zero]
    · rw [Limits.biprod.inr_desc_assoc, cB, Limits.comp_zero]
  have hepi : Epi (Limits.biprod.desc (adjA.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)))
      (adjB.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)))) := hS.epi_g
  rw [(cancel_epi _).1 hg, Abelian.Ext.mk₀_zero]

theorem wc_et_mv_pull_five : ∀ {Z Z' : Scheme.{u}} (g : Z' ⟶ Z) (n : ℕ) (A B : Z.Opens), A ⊔ B = ⊤ → (∀ (j : ℕ) (D : wcEtPullData (g ∣_ A) n), Function.Bijective (wcEtPull D j)) → (∀ (j : ℕ) (D : wcEtPullData (g ∣_ B) n), Function.Bijective (wcEtPull D j)) → ((∀ (j : ℕ) (D : wcEtPullData (g ∣_ (A ⊓ B)) n), Function.Bijective (wcEtPull D j)) ↔ (∀ (j : ℕ) (D : wcEtPullData g n), Function.Bijective (wcEtPull D j))) :=
by
  classical
  intro Z Z' g n A B hAB hA hB
  have hAB' : g ⁻¹ᵁ A ⊔ g ⁻¹ᵁ B = ⊤ := by
    rw [← Scheme.Hom.preimage_sup, hAB, Scheme.Hom.preimage_top]
  obtain ⟨DA0⟩ := wc_et_zmod_pull_data_exists A.ι n
  obtain ⟨DB0⟩ := wc_et_zmod_pull_data_exists B.ι n
  obtain ⟨DC0⟩ := wc_et_zmod_pull_data_exists (A ⊓ B).ι n
  obtain ⟨DCA⟩ := wc_et_zmod_pull_data_exists (Z.homOfLE (inf_le_left : A ⊓ B ≤ A)) n
  obtain ⟨DCB⟩ := wc_et_zmod_pull_data_exists (Z.homOfLE (inf_le_right : A ⊓ B ≤ B)) n
  obtain ⟨DA0'⟩ := wc_et_zmod_pull_data_exists (g ⁻¹ᵁ A).ι n
  obtain ⟨DB0'⟩ := wc_et_zmod_pull_data_exists (g ⁻¹ᵁ B).ι n
  obtain ⟨DC0'⟩ := wc_et_zmod_pull_data_exists (g ⁻¹ᵁ A ⊓ g ⁻¹ᵁ B).ι n
  obtain ⟨DCA'⟩ := wc_et_zmod_pull_data_exists
    (Z'.homOfLE (inf_le_left : g ⁻¹ᵁ A ⊓ g ⁻¹ᵁ B ≤ g ⁻¹ᵁ A)) n
  obtain ⟨DCB'⟩ := wc_et_zmod_pull_data_exists
    (Z'.homOfLE (inf_le_right : g ⁻¹ᵁ A ⊓ g ⁻¹ᵁ B ≤ g ⁻¹ᵁ B)) n
  obtain ⟨Dg0⟩ := wc_et_zmod_pull_data_exists g n
  obtain ⟨DgA⟩ := wc_et_zmod_pull_data_exists (g ∣_ A) n
  obtain ⟨DgB⟩ := wc_et_zmod_pull_data_exists (g ∣_ B) n
  obtain ⟨DgC⟩ := wc_et_zmod_pull_data_exists (g ∣_ (A ⊓ B)) n
  choose δ hG using fun j => wc_et_mv_boundary_chosen_data n j Z A B hAB
  choose δ' hG' using fun j => wc_et_mv_boundary_chosen_data n j Z' (g ⁻¹ᵁ A) (g ⁻¹ᵁ B) hAB'

  have R0 : ∀ z : wcEtZModExt Z n 0, wcEtPull DA0 0 z = 0 → wcEtPull DB0 0 z = 0 → z = 0 :=
    fun z h1 h2 => wc_et_mv_restr_zero_injective n 0 Z A B (δ 0) (hG 0) z DA0 DB0 h1 h2
  have R2 : ∀ j (z : wcEtZModExt Z n j),
      wcEtPull DCA j (wcEtPull DA0 j z) = wcEtPull DCB j (wcEtPull DB0 j z) := fun j z =>
    (wc_et_pull_comp A.ι _ (A ⊓ B).ι (Scheme.homOfLE_ι Z (inf_le_left : A ⊓ B ≤ A))
      DA0 DCA DC0 j z).symm.trans
      (wc_et_pull_comp B.ι _ (A ⊓ B).ι (Scheme.homOfLE_ι Z (inf_le_right : A ⊓ B ≤ B))
        DB0 DCB DC0 j z)
  have R3 : ∀ j (a : wcEtZModExt (A : Scheme.{u}) n j) (b : wcEtZModExt (B : Scheme.{u}) n j),
      wcEtPull DCA j a = wcEtPull DCB j b →
        ∃ z : wcEtZModExt Z n j, wcEtPull DA0 j z = a ∧ wcEtPull DB0 j z = b :=
    fun j a b h => wc_et_mv_restr_mid_exact n j Z A B (δ j) (hG j) a b DA0 DB0 DCA DCB h
  have R4 : ∀ j (a : wcEtZModExt (A : Scheme.{u}) n j), δ j (wcEtPull DCA j a) = 0 :=
    fun j a => (wc_et_mv_boundary_kills_restr n j Z A B (δ j) (hG j)).1 a DCA
  have R5 : ∀ j (b : wcEtZModExt (B : Scheme.{u}) n j), δ j (wcEtPull DCB j b) = 0 :=
    fun j b => (wc_et_mv_boundary_kills_restr n j Z A B (δ j) (hG j)).2 b DCB
  have R6 : ∀ j (γ : wcEtZModExt ((A ⊓ B : Z.Opens) : Scheme.{u}) n j), δ j γ = 0 →
      ∃ (a : wcEtZModExt (A : Scheme.{u}) n j) (b : wcEtZModExt (B : Scheme.{u}) n j),
        γ = wcEtPull DCA j a - wcEtPull DCB j b :=
    fun j γ hγ => wc_et_mv_boundary_ker_exact n j Z A B (δ j) (hG j) γ hγ DCA DCB
  have R7 : ∀ j (γ : wcEtZModExt ((A ⊓ B : Z.Opens) : Scheme.{u}) n j),
      wcEtPull DA0 (j + 1) (δ j γ) = 0 :=
    fun j γ => (wc_et_mv_restr_kills_boundary n j Z A B (δ j) (hG j)).1 γ DA0
  have R8 : ∀ j (γ : wcEtZModExt ((A ⊓ B : Z.Opens) : Scheme.{u}) n j),
      wcEtPull DB0 (j + 1) (δ j γ) = 0 :=
    fun j γ => (wc_et_mv_restr_kills_boundary n j Z A B (δ j) (hG j)).2 γ DB0
  have R9 : ∀ j (α : wcEtZModExt Z n (j + 1)), wcEtPull DA0 (j + 1) α = 0 →
      wcEtPull DB0 (j + 1) α = 0 → ∃ γ, δ j γ = α :=
    fun j α h1 h2 => wc_et_mv_boundary_onto n j Z A B (δ j) (hG j) α
      (fun DA => (wc_et_pull_data_indep _ DA DA0 _ α).trans h1)
      (fun DB => (wc_et_pull_data_indep _ DB DB0 _ α).trans h2)

  have R0' : ∀ z : wcEtZModExt Z' n 0, wcEtPull DA0' 0 z = 0 → wcEtPull DB0' 0 z = 0 → z = 0 :=
    fun z h1 h2 => wc_et_mv_restr_zero_injective n 0 Z' (g ⁻¹ᵁ A) (g ⁻¹ᵁ B) (δ' 0) (hG' 0)
      z DA0' DB0' h1 h2
  have R2' : ∀ j (z : wcEtZModExt Z' n j),
      wcEtPull DCA' j (wcEtPull DA0' j z) = wcEtPull DCB' j (wcEtPull DB0' j z) := fun j z =>
    (wc_et_pull_comp (g ⁻¹ᵁ A).ι _ (g ⁻¹ᵁ A ⊓ g ⁻¹ᵁ B).ι
      (Scheme.homOfLE_ι Z' (inf_le_left : g ⁻¹ᵁ A ⊓ g ⁻¹ᵁ B ≤ g ⁻¹ᵁ A))
      DA0' DCA' DC0' j z).symm.trans
      (wc_et_pull_comp (g ⁻¹ᵁ B).ι _ (g ⁻¹ᵁ A ⊓ g ⁻¹ᵁ B).ι
        (Scheme.homOfLE_ι Z' (inf_le_right : g ⁻¹ᵁ A ⊓ g ⁻¹ᵁ B ≤ g ⁻¹ᵁ B))
        DB0' DCB' DC0' j z)
  have R3' : ∀ j (a : wcEtZModExt ((g ⁻¹ᵁ A : Z'.Opens) : Scheme.{u}) n j)
      (b : wcEtZModExt ((g ⁻¹ᵁ B : Z'.Opens) : Scheme.{u}) n j),
      wcEtPull DCA' j a = wcEtPull DCB' j b →
        ∃ z : wcEtZModExt Z' n j, wcEtPull DA0' j z = a ∧ wcEtPull DB0' j z = b :=
    fun j a b h => wc_et_mv_restr_mid_exact n j Z' (g ⁻¹ᵁ A) (g ⁻¹ᵁ B) (δ' j) (hG' j) a b
      DA0' DB0' DCA' DCB' h
  have R4' : ∀ j (a : wcEtZModExt ((g ⁻¹ᵁ A : Z'.Opens) : Scheme.{u}) n j),
      δ' j (wcEtPull DCA' j a) = 0 :=
    fun j a => (wc_et_mv_boundary_kills_restr n j Z' (g ⁻¹ᵁ A) (g ⁻¹ᵁ B) (δ' j) (hG' j)).1 a DCA'
  have R5' : ∀ j (b : wcEtZModExt ((g ⁻¹ᵁ B : Z'.Opens) : Scheme.{u}) n j),
      δ' j (wcEtPull DCB' j b) = 0 :=
    fun j b => (wc_et_mv_boundary_kills_restr n j Z' (g ⁻¹ᵁ A) (g ⁻¹ᵁ B) (δ' j) (hG' j)).2 b DCB'
  have R6' : ∀ j (γ : wcEtZModExt ((g ⁻¹ᵁ A ⊓ g ⁻¹ᵁ B : Z'.Opens) : Scheme.{u}) n j),
      δ' j γ = 0 →
      ∃ (a : wcEtZModExt ((g ⁻¹ᵁ A : Z'.Opens) : Scheme.{u}) n j)
        (b : wcEtZModExt ((g ⁻¹ᵁ B : Z'.Opens) : Scheme.{u}) n j),
        γ = wcEtPull DCA' j a - wcEtPull DCB' j b :=
    fun j γ hγ => wc_et_mv_boundary_ker_exact n j Z' (g ⁻¹ᵁ A) (g ⁻¹ᵁ B) (δ' j) (hG' j) γ hγ
      DCA' DCB'
  have R7' : ∀ j (γ : wcEtZModExt ((g ⁻¹ᵁ A ⊓ g ⁻¹ᵁ B : Z'.Opens) : Scheme.{u}) n j),
      wcEtPull DA0' (j + 1) (δ' j γ) = 0 :=
    fun j γ => (wc_et_mv_restr_kills_boundary n j Z' (g ⁻¹ᵁ A) (g ⁻¹ᵁ B) (δ' j) (hG' j)).1 γ DA0'
  have R8' : ∀ j (γ : wcEtZModExt ((g ⁻¹ᵁ A ⊓ g ⁻¹ᵁ B : Z'.Opens) : Scheme.{u}) n j),
      wcEtPull DB0' (j + 1) (δ' j γ) = 0 :=
    fun j γ => (wc_et_mv_restr_kills_boundary n j Z' (g ⁻¹ᵁ A) (g ⁻¹ᵁ B) (δ' j) (hG' j)).2 γ DB0'
  have R9' : ∀ j (α : wcEtZModExt Z' n (j + 1)), wcEtPull DA0' (j + 1) α = 0 →
      wcEtPull DB0' (j + 1) α = 0 → ∃ γ, δ' j γ = α :=
    fun j α h1 h2 => wc_et_mv_boundary_onto n j Z' (g ⁻¹ᵁ A) (g ⁻¹ᵁ B) (δ' j) (hG' j) α
      (fun DA => (wc_et_pull_data_indep _ DA DA0' _ α).trans h1)
      (fun DB => (wc_et_pull_data_indep _ DB DB0' _ α).trans h2)

  have Q1 : ∀ j (z : wcEtZModExt Z n j),
      wcEtPull DgA j (wcEtPull DA0 j z) = wcEtPull DA0' j (wcEtPull Dg0 j z) := by
    intro j z
    obtain ⟨Dk⟩ := wc_et_zmod_pull_data_exists ((g ⁻¹ᵁ A).ι ≫ g) n
    exact (wc_et_pull_comp A.ι (g ∣_ A) _ (morphismRestrict_ι g A) DA0 DgA Dk j z).symm.trans
      (wc_et_pull_comp g (g ⁻¹ᵁ A).ι _ rfl Dg0 DA0' Dk j z)
  have Q2 : ∀ j (z : wcEtZModExt Z n j),
      wcEtPull DgB j (wcEtPull DB0 j z) = wcEtPull DB0' j (wcEtPull Dg0 j z) := by
    intro j z
    obtain ⟨Dk⟩ := wc_et_zmod_pull_data_exists ((g ⁻¹ᵁ B).ι ≫ g) n
    exact (wc_et_pull_comp B.ι (g ∣_ B) _ (morphismRestrict_ι g B) DB0 DgB Dk j z).symm.trans
      (wc_et_pull_comp g (g ⁻¹ᵁ B).ι _ rfl Dg0 DB0' Dk j z)
  have hsqA : g ∣_ (A ⊓ B) ≫ Z.homOfLE (inf_le_left : A ⊓ B ≤ A) =
      Z'.homOfLE (inf_le_left : g ⁻¹ᵁ A ⊓ g ⁻¹ᵁ B ≤ g ⁻¹ᵁ A) ≫ g ∣_ A := by
    refine (cancel_mono A.ι).mp ?_
    have e1 : (Z'.homOfLE (inf_le_left : g ⁻¹ᵁ A ⊓ g ⁻¹ᵁ B ≤ g ⁻¹ᵁ A) ≫ g ∣_ A) ≫ A.ι =
        (g ⁻¹ᵁ A ⊓ g ⁻¹ᵁ B).ι ≫ g := by
      rw [Category.assoc, morphismRestrict_ι, Scheme.homOfLE_ι_assoc]
    have e2 : (g ∣_ (A ⊓ B) ≫ Z.homOfLE (inf_le_left : A ⊓ B ≤ A)) ≫ A.ι =
        (g ⁻¹ᵁ (A ⊓ B)).ι ≫ g := by
      rw [Category.assoc, Scheme.homOfLE_ι, morphismRestrict_ι]
    exact e2.trans e1.symm
  have hsqB : g ∣_ (A ⊓ B) ≫ Z.homOfLE (inf_le_right : A ⊓ B ≤ B) =
      Z'.homOfLE (inf_le_right : g ⁻¹ᵁ A ⊓ g ⁻¹ᵁ B ≤ g ⁻¹ᵁ B) ≫ g ∣_ B := by
    refine (cancel_mono B.ι).mp ?_
    have e1 : (Z'.homOfLE (inf_le_right : g ⁻¹ᵁ A ⊓ g ⁻¹ᵁ B ≤ g ⁻¹ᵁ B) ≫ g ∣_ B) ≫ B.ι =
        (g ⁻¹ᵁ A ⊓ g ⁻¹ᵁ B).ι ≫ g := by
      rw [Category.assoc, morphismRestrict_ι, Scheme.homOfLE_ι_assoc]
    have e2 : (g ∣_ (A ⊓ B) ≫ Z.homOfLE (inf_le_right : A ⊓ B ≤ B)) ≫ B.ι =
        (g ⁻¹ᵁ (A ⊓ B)).ι ≫ g := by
      rw [Category.assoc, Scheme.homOfLE_ι, morphismRestrict_ι]
    exact e2.trans e1.symm
  have Q3 : ∀ j (a : wcEtZModExt (A : Scheme.{u}) n j),
      wcEtPull DgC j (wcEtPull DCA j a) = wcEtPull DCA' j (wcEtPull DgA j a) := by
    intro j a
    obtain ⟨Dk⟩ := wc_et_zmod_pull_data_exists
      (Z'.homOfLE (inf_le_left : g ⁻¹ᵁ A ⊓ g ⁻¹ᵁ B ≤ g ⁻¹ᵁ A) ≫ g ∣_ A) n
    exact (wc_et_pull_comp (Z.homOfLE (inf_le_left : A ⊓ B ≤ A)) (g ∣_ (A ⊓ B)) _ hsqA
      DCA DgC Dk j a).symm.trans (wc_et_pull_comp (g ∣_ A) _ _ rfl DgA DCA' Dk j a)
  have Q4 : ∀ j (b : wcEtZModExt (B : Scheme.{u}) n j),
      wcEtPull DgC j (wcEtPull DCB j b) = wcEtPull DCB' j (wcEtPull DgB j b) := by
    intro j b
    obtain ⟨Dk⟩ := wc_et_zmod_pull_data_exists
      (Z'.homOfLE (inf_le_right : g ⁻¹ᵁ A ⊓ g ⁻¹ᵁ B ≤ g ⁻¹ᵁ B) ≫ g ∣_ B) n
    exact (wc_et_pull_comp (Z.homOfLE (inf_le_right : A ⊓ B ≤ B)) (g ∣_ (A ⊓ B)) _ hsqB
      DCB DgC Dk j b).symm.trans (wc_et_pull_comp (g ∣_ B) _ _ rfl DgB DCB' Dk j b)
  have Q5 : ∀ j (γ : wcEtZModExt ((A ⊓ B : Z.Opens) : Scheme.{u}) n j),
      wcEtPull Dg0 (j + 1) (δ j γ) = δ' j (wcEtPull DgC j γ) :=
    fun j γ => wc_et_mv_boundary_natural_of_data n j Z Z' g A B (δ j) (δ' j) (hG j) (hG' j)
      γ Dg0 DgC
  have key := @wc_mv_ladder_five_iff
    (fun j => wcEtZModExt Z n j) (fun j => wcEtZModExt (A : Scheme.{u}) n j)
    (fun j => wcEtZModExt (B : Scheme.{u}) n j)
    (fun j => wcEtZModExt ((A ⊓ B : Z.Opens) : Scheme.{u}) n j)
    (fun j => wcEtZModExt Z' n j)
    (fun j => wcEtZModExt ((g ⁻¹ᵁ A : Z'.Opens) : Scheme.{u}) n j)
    (fun j => wcEtZModExt ((g ⁻¹ᵁ B : Z'.Opens) : Scheme.{u}) n j)
    (fun j => wcEtZModExt ((g ⁻¹ᵁ A ⊓ g ⁻¹ᵁ B : Z'.Opens) : Scheme.{u}) n j)
    (fun j => (inferInstance : AddCommGroup (wcEtZModExt Z n j)))
    (fun j => (inferInstance : AddCommGroup (wcEtZModExt (A : Scheme.{u}) n j)))
    (fun j => (inferInstance : AddCommGroup (wcEtZModExt (B : Scheme.{u}) n j)))
    (fun j => (inferInstance : AddCommGroup (wcEtZModExt ((A ⊓ B : Z.Opens) : Scheme.{u}) n j)))
    (fun j => (inferInstance : AddCommGroup (wcEtZModExt Z' n j)))
    (fun j => (inferInstance : AddCommGroup (wcEtZModExt ((g ⁻¹ᵁ A : Z'.Opens) : Scheme.{u}) n j)))
    (fun j => (inferInstance : AddCommGroup (wcEtZModExt ((g ⁻¹ᵁ B : Z'.Opens) : Scheme.{u}) n j)))
    (fun j => (inferInstance :
      AddCommGroup (wcEtZModExt ((g ⁻¹ᵁ A ⊓ g ⁻¹ᵁ B : Z'.Opens) : Scheme.{u}) n j)))
    (fun j => wcEtPull DA0 j) (fun j => wcEtPull DB0 j) (fun j => wcEtPull DCA j)
    (fun j => wcEtPull DCB j) δ
    (fun j => wcEtPull DA0' j) (fun j => wcEtPull DB0' j) (fun j => wcEtPull DCA' j)
    (fun j => wcEtPull DCB' j) δ'
    (fun j => wcEtPull Dg0 j) (fun j => wcEtPull DgA j) (fun j => wcEtPull DgB j)
    (fun j => wcEtPull DgC j)
    R0 R2 R3 R4 R5 R6 R7 R8 R9 R0' R2' R3' R4' R5' R6' R7' R8' R9' Q1 Q2 Q3 Q4 Q5
    (fun j => hA j DgA) (fun j => hB j DgB)
  constructor
  · intro H j D
    have hb : Function.Bijective (wcEtPull Dg0 j) := key.mp (fun j => H j DgC) j
    have heq : (wcEtPull D j : _ → _) = wcEtPull Dg0 j :=
      funext (fun x => wc_et_pull_data_indep g D Dg0 j x)
    rw [heq]
    exact hb
  · intro H j D
    have hb : Function.Bijective (wcEtPull DgC j) := key.mpr (fun j => H j Dg0) j
    have heq : (wcEtPull D j : _ → _) = wcEtPull DgC j :=
      funext (fun x => wc_et_pull_data_indep _ D DgC j x)
    rw [heq]
    exact hb

theorem wc_et_invsh_gm_step : ∀ (K : Type u) [Field K] (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of K)) (n : ℕ), (∀ (Y₂ : Scheme.{u}) (a : Y₂ ⟶ Y) (b : Y₂ ⟶ wcProjK K 1), IsPullback a b fY (wcProjKStr K 1) → wcEtInvSH K Y₂ (a ≫ fY) n) → (∀ (Y₁ : Scheme.{u}) (a : Y₁ ⟶ Y) (b : Y₁ ⟶ Spec (.of (Polynomial K))), IsPullback a b fY (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) → wcEtInvSH K Y₁ (a ≫ fY) n) → ∀ (Y₃ : Scheme.{u}) (a : Y₃ ⟶ Y) (b : Y₃ ⟶ Spec (.of (LaurentPolynomial K))), IsPullback a b fY (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))) → wcEtInvSH K Y₃ (a ≫ fY) n :=
by
  intro K _ Y fY n H1 H2 Y₃ a b h₃

  have pid : ∀ {T : Scheme.{u}} (D : wcEtPullData (𝟙 T) n) (j : ℕ) (x : wcEtZModExt T n j),
      wcEtPull D j x = x := by
    intro T D j x
    have h1 := wc_et_pull_comp (𝟙 T) (𝟙 T) (𝟙 T) (Category.id_comp _) D D D j x
    have h2 : wcEtPull D j (wcEtPull D j x - x) = 0 := by
      rw [map_sub, ← h1, sub_self]
    exact sub_eq_zero.mp (wc_et_pull_id_injective D j _ h2)

  have N1 : ∀ {X X' : Scheme.{u}} (e : X' ≅ X) (j : ℕ) (D : wcEtPullData e.hom n),
      Function.Bijective (wcEtPull D j) := by
    intro X X' e j D
    obtain ⟨Dinv⟩ := wc_et_zmod_pull_data_exists e.inv n
    obtain ⟨DX⟩ := wc_et_zmod_pull_data_exists (𝟙 X) n
    obtain ⟨DX'⟩ := wc_et_zmod_pull_data_exists (𝟙 X') n
    refine Function.bijective_iff_has_inverse.mpr ⟨wcEtPull Dinv j, fun x => ?_, fun y => ?_⟩
    · have h := wc_et_pull_comp e.hom e.inv (𝟙 X) e.inv_hom_id D Dinv DX j x
      rw [pid] at h
      exact h.symm
    · have h := wc_et_pull_comp e.inv e.hom (𝟙 X') e.hom_inv_id Dinv D DX' j y
      rw [pid] at h
      exact h.symm

  have N3 : ∀ {Y₀ Y₁ : Scheme.{u}} (f₀ : Y₀ ⟶ Spec (.of K)) (f₁ : Y₁ ⟶ Spec (.of K))
      (e : Y₁ ≅ Y₀), e.hom ≫ f₀ = f₁ → wcEtInvSH K Y₀ f₀ n → wcEtInvSH K Y₁ f₁ n := by
    intro Y₀ Y₁ f₀ f₁ e hfac hY R _ _ _ s Y' p t hP E j
    have hP₂ : IsPullback (p ≫ e.hom) t f₀ s :=
      IsPullback.of_iso hP (Iso.refl _) e (Iso.refl _) (Iso.refl _)
        (by simp only [Iso.refl_hom, Category.id_comp])
        (by simp only [Iso.refl_hom, Category.comp_id, Category.id_comp])
        (by rw [Iso.refl_hom, Category.comp_id, hfac])
        (by simp only [Iso.refl_hom, Category.comp_id, Category.id_comp])
    obtain ⟨Dh⟩ := wc_et_zmod_pull_data_exists (p ≫ e.hom) n
    obtain ⟨Di⟩ := wc_et_zmod_pull_data_exists e.symm.hom n
    have hb := hY R s Y' (p ≫ e.hom) t hP₂ Dh j
    have hcomp : (wcEtPull E j : _ → _) = wcEtPull Dh j ∘ wcEtPull Di j := by
      funext x
      exact wc_et_pull_comp e.symm.hom (p ≫ e.hom) p (by simp) Di Dh E j x
    rw [hcomp]
    exact hb.comp (N1 e.symm j Di)

  have N2 : ∀ (Z : Scheme.{u}) (fZ : Z ⟶ Spec (.of K)) (A B : Z.Opens), A ⊔ B = ⊤ →
      wcEtInvSH K Z fZ n → wcEtInvSH K (A : Scheme.{u}) (A.ι ≫ fZ) n →
      wcEtInvSH K (B : Scheme.{u}) (B.ι ≫ fZ) n →
      wcEtInvSH K ((A ⊓ B : Z.Opens) : Scheme.{u}) ((A ⊓ B).ι ≫ fZ) n := by
    intro Z fZ A B hAB hZ hA hB R _ _ _ s Y' p' t' hP' E j
    have hc := IsPullback.of_hasPullback fZ s
    have Q : ∀ V : Z.Opens, IsPullback (Limits.pullback.fst fZ s ∣_ V)
        ((Limits.pullback.fst fZ s ⁻¹ᵁ V).ι ≫ Limits.pullback.snd fZ s) (V.ι ≫ fZ) s :=
      fun V => (isPullback_morphismRestrict _ V).paste_vert hc
    have bZ := hZ R s _ _ _ hc
    have bA := hA R s _ _ _ (Q A)
    have bB := hB R s _ _ _ (Q B)
    have bAB := (wc_et_mv_pull_five (Limits.pullback.fst fZ s) n A B hAB
      (fun j D => bA D j) (fun j D => bB D j)).mpr (fun j D => bZ D j)
    let ψ := IsPullback.isoIsPullback _ _ hP' (Q (A ⊓ B))
    have hψ : ψ.hom ≫ (Limits.pullback.fst fZ s ∣_ (A ⊓ B)) = p' :=
      IsPullback.isoIsPullback_hom_fst _ _ hP' (Q (A ⊓ B))
    obtain ⟨Dr⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.fst fZ s ∣_ (A ⊓ B)) n
    obtain ⟨Dψ⟩ := wc_et_zmod_pull_data_exists ψ.hom n
    have hcomp : (wcEtPull E j : _ → _) = wcEtPull Dψ j ∘ wcEtPull Dr j := by
      funext x
      exact wc_et_pull_comp _ ψ.hom p' hψ Dr Dψ E j x
    rw [hcomp]
    exact (N1 ψ j Dψ).comp (bAB j Dr)

  have h₂ := IsPullback.of_hasPullback fY (wcProjKStr K 1)
  have hY₂ := H1 _ _ _ h₂

  have piece : ∀ (V : (wcProjK K 1).Opens) {G : Scheme.{u}} (gG : G ⟶ Spec (.of K))
      (eV : (V : Scheme.{u}) ≅ G), eV.hom ≫ gG = V.ι ≫ wcProjKStr K 1 →
      IsPullback ((Limits.pullback.snd fY (wcProjKStr K 1) ⁻¹ᵁ V).ι ≫
          Limits.pullback.fst fY (wcProjKStr K 1))
        (Limits.pullback.snd fY (wcProjKStr K 1) ∣_ V ≫ eV.hom) fY gG := by
    intro V G gG eV hV
    have S₁ := (isPullback_morphismRestrict (Limits.pullback.snd fY (wcProjKStr K 1)) V).paste_vert
      h₂.flip
    have S₂ : IsPullback (Limits.pullback.snd fY (wcProjKStr K 1) ∣_ V ≫ eV.hom)
        ((Limits.pullback.snd fY (wcProjKStr K 1) ⁻¹ᵁ V).ι ≫
          Limits.pullback.fst fY (wcProjKStr K 1)) gG fY :=
      IsPullback.of_iso S₁ (Iso.refl _) eV (Iso.refl _) (Iso.refl _)
        (by simp only [Iso.refl_hom, Category.id_comp])
        (by simp only [Iso.refl_hom, Category.comp_id, Category.id_comp])
        (by rw [Iso.refl_hom, Category.comp_id, hV])
        (by simp only [Iso.refl_hom, Category.comp_id, Category.id_comp])
    exact S₂.flip
  have main : ∀ (V₀ V₁ : (wcProjK K 1).Opens), V₀ ⊔ V₁ = ⊤ →
      (∃ e : (V₀ : Scheme.{u}) ≅ Spec (.of (Polynomial K)),
        e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))) =
          V₀.ι ≫ wcProjKStr K 1) →
      (∃ e : (V₁ : Scheme.{u}) ≅ Spec (.of (Polynomial K)),
        e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))) =
          V₁.ι ≫ wcProjKStr K 1) →
      (∃ e : ((V₀ ⊓ V₁ : (wcProjK K 1).Opens) : Scheme.{u}) ≅ Spec (.of (LaurentPolynomial K)),
        e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))) =
          (V₀ ⊓ V₁).ι ≫ wcProjKStr K 1) →
      wcEtInvSH K Y₃ (a ≫ fY) n := by
    rintro V₀ V₁ hcov ⟨e₀, he₀⟩ ⟨e₁, he₁⟩ ⟨e₀₁, he₀₁⟩
    have hAB : Limits.pullback.snd fY (wcProjKStr K 1) ⁻¹ᵁ V₀ ⊔
        Limits.pullback.snd fY (wcProjKStr K 1) ⁻¹ᵁ V₁ = ⊤ := by
      rw [← Scheme.Hom.preimage_sup, hcov, Scheme.Hom.preimage_top]
    have hA := H2 _ _ _ (piece V₀ _ e₀ he₀)
    rw [Category.assoc] at hA
    have hB := H2 _ _ _ (piece V₁ _ e₁ he₁)
    rw [Category.assoc] at hB
    have hW := N2 _ _ _ _ hAB hY₂ hA hB
    have P₀₁ := piece (V₀ ⊓ V₁) _ e₀₁ he₀₁
    let φ := IsPullback.isoIsPullback _ _ h₃ P₀₁
    have hφ : φ.hom ≫ ((Limits.pullback.snd fY (wcProjKStr K 1) ⁻¹ᵁ (V₀ ⊓ V₁)).ι ≫
        Limits.pullback.fst fY (wcProjKStr K 1)) = a :=
      IsPullback.isoIsPullback_hom_fst _ _ h₃ P₀₁
    have hfac : φ.hom ≫ (Limits.pullback.snd fY (wcProjKStr K 1) ⁻¹ᵁ (V₀ ⊓ V₁)).ι ≫
        Limits.pullback.fst fY (wcProjKStr K 1) ≫ fY = a ≫ fY := by
      rw [← hφ]
      simp only [Category.assoc]
    exact N3 _ (a ≫ fY) φ hfac hW
  refine main _ _ ?_ (wc_projK_one_affine_chart K 0) (wc_projK_one_affine_chart K 1)
    (wc_projK_one_overlap_laurent K)
  rw [eq_top_iff, ← wc_pp_basicOpen_cover K 1]
  refine iSup_le (fun i => ?_)
  fin_cases i
  · exact le_sup_left
  · exact le_sup_right

theorem wc_et_goodsh_closure : ∀ (K : Type u) [Field K] [IsAlgClosed K] (n : ℕ), (n : K) ≠ 0 → wcEtGoodSH K (Spec (.of K)) (𝟙 _) n ∧ (∀ (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of K)), wcEtGoodSH K Y fY n → ∀ (Y₁ : Scheme.{u}) (a : Y₁ ⟶ Y) (b : Y₁ ⟶ Spec (.of (Polynomial K))), IsPullback a b fY (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) → wcEtGoodSH K Y₁ (a ≫ fY) n) ∧ (∀ (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of K)), wcEtGoodSH K Y fY n → ∀ (Y₃ : Scheme.{u}) (a : Y₃ ⟶ Y) (b : Y₃ ⟶ Spec (.of (LaurentPolynomial K))), IsPullback a b fY (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))) → wcEtGoodSH K Y₃ (a ≫ fY) n) ∧ (∀ (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of K)), wcEtGoodSH K Y fY n → wcEtInvSH K Y fY n) :=
by
  intro K _ _ n hn

  have L5 : ∀ (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of K)), IsProper fY → wcEtInvSH K Y fY n := by
    intro Y fY hfY A _ _ _ s Y' p t hP E j
    haveI := hfY
    obtain ⟨D, hD⟩ := wc_zmod_pull_data_exists p n
    haveI : HenselianLocalRing (CommRingCat.of A) := ‹HenselianLocalRing A›
    haveI : IsSepClosed (IsLocalRing.ResidueField (CommRingCat.of A)) :=
      ‹IsSepClosed (IsLocalRing.ResidueField A)›
    have h1 : Function.Bijective (wcZModPull D j) :=
      wc_zmod_proper_strict_henselian_base_pull_bij fY (CommRingCat.of A) s p t hP n hn D hD j
    haveI : IsProper t := MorphismProperty.of_isPullback (P := @IsProper) hP hfY
    haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace fY
    haveI : QuasiSeparatedSpace Y := quasiSeparatedSpace_of_quasiSeparated fY
    haveI : CompactSpace Y' := QuasiCompact.compactSpace_of_compactSpace t
    haveI : QuasiSeparatedSpace Y' := quasiSeparatedSpace_of_quasiSeparated t
    obtain ⟨Θ, hΘb, hΘn⟩ := wc_zmod_et_proet_natural_comparison_all n j
    have h2 : (wcZModPull D j) ∘ (Θ Y) = (Θ Y') ∘ (wcEtPull E j) :=
      funext (fun x => hΘn p D hD E x)
    have h3 : Function.Bijective ((Θ Y') ∘ (wcEtPull E j)) := by
      rw [← h2]; exact h1.comp (hΘb Y inferInstance inferInstance)
    exact (Function.Bijective.of_comp_iff' (hΘb Y' inferInstance inferInstance)
      (wcEtPull E j)).mp h3

  have s0 : ∀ (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of K)) {G : Scheme.{u}} (g : G ⟶ Spec (.of K))
      (Y₁ : Scheme.{u}) (a : Y₁ ⟶ Y) (b : Y₁ ⟶ G), IsPullback a b fY g →
      ∀ (Z : Scheme.{u}) (fZ : Z ⟶ Spec (.of K)) (W : Scheme.{u}) (a' : W ⟶ Y₁) (b' : W ⟶ Z),
      IsPullback a' b' (a ≫ fY) fZ →
      ∃ α : W ⟶ Limits.pullback fY fZ, α ≫ Limits.pullback.fst fY fZ = a' ≫ a ∧
        IsPullback α (a' ≫ b) (Limits.pullback.fst fY fZ ≫ fY) g := by
    intro Y fY G g Y₁ a b h₁ Z fZ W a' b' hW
    have w0 : (a' ≫ a) ≫ fY = b' ≫ fZ := by
      rw [Category.assoc]; exact hW.toCommSq.w
    obtain ⟨α, hα1, hα2⟩ : ∃ α : W ⟶ Limits.pullback fY fZ,
        α ≫ Limits.pullback.fst fY fZ = a' ≫ a ∧ α ≫ Limits.pullback.snd fY fZ = b' :=
      ⟨Limits.pullback.lift (a' ≫ a) b' w0, Limits.pullback.lift_fst _ _ _,
        Limits.pullback.lift_snd _ _ _⟩
    have R1 : IsPullback α a' (Limits.pullback.fst fY fZ) a := by
      refine IsPullback.of_right ?_ hα1 (IsPullback.of_hasPullback fY fZ).flip
      rw [hα2]
      exact hW.flip
    exact ⟨α, hα1, R1.paste_vert h₁⟩
  refine ⟨?_, ?_, ?_, ?_⟩
  ·
    intro Z fZ hfZ W a b h
    have : IsProper a := MorphismProperty.of_isPullback (P := @IsProper) h.flip hfZ
    rw [Category.comp_id]
    exact L5 W a this
  ·
    intro Y fY hGood Y₁ a b h₁ Z fZ hfZ W a' b' hW
    obtain ⟨α, hα, R⟩ := s0 Y fY _ Y₁ a b h₁ Z fZ W a' b' hW
    have hInv := hGood Z fZ hfZ _ (Limits.pullback.fst fY fZ) (Limits.pullback.snd fY fZ)
      (IsPullback.of_hasPullback fY fZ)
    have := wc_et_invsh_affine_line K _ (Limits.pullback.fst fY fZ ≫ fY) n hn hInv W α (a' ≫ b) R
    rw [← Category.assoc, hα, Category.assoc] at this
    exact this
  ·
    intro Y fY hGood Y₃ a b h₃ Z fZ hfZ W a' b' hW
    haveI := hfZ
    obtain ⟨α, hα, R⟩ := s0 Y fY _ Y₃ a b h₃ Z fZ W a' b' hW
    have hInv := hGood Z fZ hfZ _ (Limits.pullback.fst fY fZ) (Limits.pullback.snd fY fZ)
      (IsPullback.of_hasPullback fY fZ)
    have H2 : ∀ (Y₁ : Scheme.{u}) (a₁ : Y₁ ⟶ Limits.pullback fY fZ)
        (b₁ : Y₁ ⟶ Spec (.of (Polynomial K))),
        IsPullback a₁ b₁ (Limits.pullback.fst fY fZ ≫ fY)
          (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) →
        wcEtInvSH K Y₁ (a₁ ≫ Limits.pullback.fst fY fZ ≫ fY) n :=
      fun Y₁ a₁ b₁ h => wc_et_invsh_affine_line K _ _ n hn hInv Y₁ a₁ b₁ h
    have H1 : ∀ (Y₂ : Scheme.{u}) (a₂ : Y₂ ⟶ Limits.pullback fY fZ) (b₂ : Y₂ ⟶ wcProjK K 1),
        IsPullback a₂ b₂ (Limits.pullback.fst fY fZ ≫ fY) (wcProjKStr K 1) →
        wcEtInvSH K Y₂ (a₂ ≫ Limits.pullback.fst fY fZ ≫ fY) n := by
      intro Y₂ a₂ b₂ h₂
      haveI := wc_proj_space_isProper K 1
      have hP' : IsProper (Limits.pullback.fst fZ (wcProjKStr K 1) ≫ fZ) := inferInstance
      have w₂ : (a₂ ≫ Limits.pullback.snd fY fZ) ≫ fZ = b₂ ≫ wcProjKStr K 1 := by
        rw [Category.assoc, ← Limits.pullback.condition]
        exact h₂.toCommSq.w
      obtain ⟨b'', hb1, hb2⟩ : ∃ b'' : Y₂ ⟶ Limits.pullback fZ (wcProjKStr K 1),
          b'' ≫ Limits.pullback.fst fZ (wcProjKStr K 1) = a₂ ≫ Limits.pullback.snd fY fZ ∧
          b'' ≫ Limits.pullback.snd fZ (wcProjKStr K 1) = b₂ :=
        ⟨Limits.pullback.lift _ _ w₂, Limits.pullback.lift_fst _ _ _,
          Limits.pullback.lift_snd _ _ _⟩
      have P1 : IsPullback b'' a₂ (Limits.pullback.fst fZ (wcProjKStr K 1))
          (Limits.pullback.snd fY fZ) := by
        refine IsPullback.of_right ?_ hb1 (IsPullback.of_hasPullback fZ (wcProjKStr K 1)).flip
        rw [hb2, ← Limits.pullback.condition]
        exact h₂.flip
      have P2 : IsPullback (a₂ ≫ Limits.pullback.fst fY fZ) b'' fY
          (Limits.pullback.fst fZ (wcProjKStr K 1) ≫ fZ) :=
        P1.flip.paste_horiz (IsPullback.of_hasPullback fY fZ)
      have := hGood _ _ hP' Y₂ (a₂ ≫ Limits.pullback.fst fY fZ) b'' P2
      rw [Category.assoc] at this
      exact this
    have := wc_et_invsh_gm_step K _ (Limits.pullback.fst fY fZ ≫ fY) n H1 H2 W α (a' ≫ b) R
    rw [← Category.assoc, hα, Category.assoc] at this
    exact this
  ·
    intro Y fY hGood
    have := hGood (Spec (.of K)) (𝟙 _) inferInstance Y (𝟙 Y) fY IsPullback.of_id_fst
    rw [Category.id_comp] at this
    exact this

theorem wc_et_punct_cover_pieces : ∀ (K : Type u) [Field K] (c' : ℕ), 1 ≤ c' → ∀ (U₀ : (Spec (.of (MvPolynomial (Fin (c' + 1)) K))).Opens), (U₀ : Set (Spec (.of (MvPolynomial (Fin (c' + 1)) K)))) = (Set.range (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin (c' + 1)) K →+* K))))ᶜ → ∀ (W₀ : (Spec (.of (MvPolynomial (Fin c') K))).Opens), (W₀ : Set (Spec (.of (MvPolynomial (Fin c') K)))) = (Set.range (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c') K →+* K))))ᶜ → ∃ (A B : (U₀ : Scheme.{u}).Opens), A ⊔ B = ⊤ ∧ (∃ (αA : (A : Scheme.{u}) ⟶ Spec (.of (LaurentPolynomial K))) (βA : (A : Scheme.{u}) ⟶ Spec (.of (MvPolynomial (Fin c') K))), IsPullback αA βA (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))) ∧ αA ≫ Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))) = A.ι ≫ U₀.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c' + 1)) K)))) ∧ (∃ (αB : (B : Scheme.{u}) ⟶ (W₀ : Scheme.{u})) (βB : (B : Scheme.{u}) ⟶ Spec (.of (Polynomial K))), IsPullback αB βB (W₀.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ∧ αB ≫ W₀.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K))) = B.ι ≫ U₀.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c' + 1)) K)))) ∧ (∃ (αC : ((A ⊓ B : (U₀ : Scheme.{u}).Opens) : Scheme.{u}) ⟶ (W₀ : Scheme.{u})) (βC : ((A ⊓ B : (U₀ : Scheme.{u}).Opens) : Scheme.{u}) ⟶ Spec (.of (LaurentPolynomial K))), IsPullback αC βC (W₀.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))) ∧ αC ≫ W₀.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K))) = (A ⊓ B).ι ≫ U₀.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c' + 1)) K)))) :=
by
  intro K _ c' _hc' U₀ hU₀ W₀ hW₀

  have star : ∀ {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S) (x : Spec (.of S)) (r : R),
      r ∈ (Spec.map (CommRingCat.ofHom φ) x).asIdeal ↔ φ r ∈ x.asIdeal := by
    intro R S _ _ φ x r
    exact Iff.rfl

  have L0 : ∀ (c : ℕ) (y : Spec (.of (MvPolynomial (Fin c) K))),
      y ∈ Set.range (Spec.map (CommRingCat.ofHom
        (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K))) ↔
      ∀ i : Fin c, (MvPolynomial.X i : MvPolynomial (Fin c) K) ∈ y.asIdeal := by
    intro c y
    constructor
    · rintro ⟨t, rfl⟩ i
      rw [star, MvPolynomial.constantCoeff_X]
      exact Ideal.zero_mem _
    · intro hX
      have hker : RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K) ≤
          y.asIdeal := by
        intro f hf
        have hspan : f ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin c))) := by
          rw [MvPolynomial.mem_ideal_span_X_image]
          intro mm hmm
          have hm0 : mm ≠ 0 := by
            rintro rfl
            rw [RingHom.mem_ker, MvPolynomial.constantCoeff_eq] at hf
            exact (MvPolynomial.mem_support_iff.mp hmm) hf
          obtain ⟨i, hi⟩ : ∃ i, mm i ≠ 0 := by
            by_contra hcon
            exact hm0 (Finsupp.ext fun a => by
              by_contra ha
              exact hcon ⟨a, ha⟩)
          exact ⟨i, Set.mem_univ _, hi⟩
        refine (Ideal.span_le.mpr ?_) hspan
        rintro _ ⟨i, -, rfl⟩
        exact hX i
      have hmax := RingHom.ker_isMaximal_of_surjective
        (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)
        (fun a => ⟨MvPolynomial.C a, MvPolynomial.constantCoeff_C _ a⟩)
      have e1 := hmax.eq_of_le y.isPrime.ne_top hker
      let z : Spec (.of K) := IsLocalRing.closedPoint K
      have e2 := hmax.eq_of_le (Spec.map (CommRingCat.ofHom
        (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) z).isPrime.ne_top
          (fun f hf => by
            show MvPolynomial.constantCoeff f ∈ z.asIdeal
            rw [RingHom.mem_ker.mp hf]
            exact Ideal.zero_mem _)
      exact ⟨z, PrimeSpectrum.ext (e2.symm.trans e1)⟩

  have s2 : ∀ {Z X Y S X₀ Y₀ N : Scheme.{u}} (ρ : Z ⟶ X) (τ : Z ⟶ Y) (f : X ⟶ S) (g : Y ⟶ S),
      IsPullback ρ τ f g → ∀ (i₁ : X₀ ⟶ X) (i₂ : Y₀ ⟶ Y) (ιN : N ⟶ Z) [IsOpenImmersion i₁]
      [IsOpenImmersion i₂] [IsOpenImmersion ιN],
      (∀ z : Z, ρ z ∈ Set.range i₁ → τ z ∈ Set.range i₂ → z ∈ Set.range ιN) →
      ∀ (r : N ⟶ X₀) (t : N ⟶ Y₀), r ≫ i₁ = ιN ≫ ρ → t ≫ i₂ = ιN ≫ τ →
      IsPullback r t (i₁ ≫ f) (i₂ ≫ g) := by
    intro Z X Y S X₀ Y₀ N ρ τ f g h i₁ i₂ ιN _ _ _ hR r t hr ht
    let m := Limits.pullback.map (i₁ ≫ f) (i₂ ≫ g) f g i₁ i₂ (𝟙 S) (Category.comp_id _)
      (Category.comp_id _)
    have : IsOpenImmersion m :=
      MorphismProperty.pullbackMap (P := @IsOpenImmersion) (inferInstance : IsOpenImmersion i₁)
        (inferInstance : IsOpenImmersion i₂) rfl rfl
    have hm := Scheme.Pullback.range_map (i₁ ≫ f) (i₂ ≫ g) f g i₁ i₂ (𝟙 S)
      (Category.comp_id _) (Category.comp_id _)
    have hm1 : m ≫ Limits.pullback.fst f g = Limits.pullback.fst (i₁ ≫ f) (i₂ ≫ g) ≫ i₁ :=
      Limits.pullback.lift_fst _ _ _
    have hm2 : m ≫ Limits.pullback.snd f g = Limits.pullback.snd (i₁ ≫ f) (i₂ ≫ g) ≫ i₂ :=
      Limits.pullback.lift_snd _ _ _
    have hrange : Set.range ιN = Set.range (m ≫ h.isoPullback.inv) := by
      ext z
      constructor
      · rintro ⟨n, rfl⟩
        have k1 : (ιN ≫ h.isoPullback.hom ≫ Limits.pullback.fst f g) n = i₁ (r n) := by
          rw [h.isoPullback_hom_fst, ← hr, Scheme.Hom.comp_apply]
        have k2 : (ιN ≫ h.isoPullback.hom ≫ Limits.pullback.snd f g) n = i₂ (t n) := by
          rw [h.isoPullback_hom_snd, ← ht, Scheme.Hom.comp_apply]
        simp only [Scheme.Hom.comp_apply] at k1 k2
        have h3 : h.isoPullback.hom (ιN n) ∈ Set.range m := by
          rw [hm]
          exact ⟨⟨r n, k1.symm⟩, ⟨t n, k2.symm⟩⟩
        obtain ⟨v, hv⟩ := h3
        exact ⟨v, by rw [Scheme.Hom.comp_apply, hv, Scheme.hom_inv_apply]⟩
      · rintro ⟨v, rfl⟩
        have k1 : (m ≫ h.isoPullback.inv ≫ ρ) v =
            (Limits.pullback.fst (i₁ ≫ f) (i₂ ≫ g) ≫ i₁) v := by
          rw [h.isoPullback_inv_fst, hm1]
        have k2 : (m ≫ h.isoPullback.inv ≫ τ) v =
            (Limits.pullback.snd (i₁ ≫ f) (i₂ ≫ g) ≫ i₂) v := by
          rw [h.isoPullback_inv_snd, hm2]
        simp only [Scheme.Hom.comp_apply] at k1 k2
        apply hR
        · rw [Scheme.Hom.comp_apply, k1]
          exact ⟨_, rfl⟩
        · rw [Scheme.Hom.comp_apply, k2]
          exact ⟨_, rfl⟩
    obtain ⟨φ, hφ⟩ : ∃ φ : N ≅ Limits.pullback (i₁ ≫ f) (i₂ ≫ g),
        φ.hom ≫ m ≫ h.isoPullback.inv = ιN :=
      ⟨_, IsOpenImmersion.isoOfRangeEq_hom_fac ιN (m ≫ h.isoPullback.inv) hrange⟩
    have hfst : φ.hom ≫ Limits.pullback.fst (i₁ ≫ f) (i₂ ≫ g) = r := by
      rw [← cancel_mono i₁, Category.assoc, ← hm1, hr]
      calc _ = (φ.hom ≫ m ≫ h.isoPullback.inv) ≫ ρ := by
            simp only [Category.assoc, IsPullback.isoPullback_inv_fst]
        _ = ιN ≫ ρ := by rw [hφ]
    have hsnd : φ.hom ≫ Limits.pullback.snd (i₁ ≫ f) (i₂ ≫ g) = t := by
      rw [← cancel_mono i₂, Category.assoc, ← hm2, ht]
      calc _ = (φ.hom ≫ m ≫ h.isoPullback.inv) ≫ τ := by
            simp only [Category.assoc, IsPullback.isoPullback_inv_snd]
        _ = ιN ≫ τ := by rw [hφ]
    refine IsPullback.of_iso_pullback ⟨?_⟩ φ hfst hsnd
    rw [reassoc_of% hr, reassoc_of% ht, h.toCommSq.w]

  have s3 : IsOpenImmersion (Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) (LaurentPolynomial K)))) ∧ Set.range (Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) (LaurentPolynomial K)))) = {x | (Polynomial.X : Polynomial K) ∉ x.asIdeal} ∧ Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) (LaurentPolynomial K))) ≫ Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))) = Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))) := by
    refine ⟨IsOpenImmersion.of_isLocalization (Polynomial.X : Polynomial K), ?_, ?_⟩
    · have hr := PrimeSpectrum.localization_away_comap_range (LaurentPolynomial K)
        (Polynomial.X : Polynomial K)
      ext x
      constructor
      · rintro ⟨y, rfl⟩
        have h1 : PrimeSpectrum.comap (algebraMap (Polynomial K) (LaurentPolynomial K)) y ∈
            Set.range (PrimeSpectrum.comap (algebraMap (Polynomial K) (LaurentPolynomial K))) :=
          ⟨y, rfl⟩
        rw [hr] at h1
        exact (PrimeSpectrum.mem_basicOpen _ _).1 h1
      · intro hx
        have h1 : (x : PrimeSpectrum (Polynomial K)) ∈
            ((PrimeSpectrum.basicOpen (Polynomial.X : Polynomial K)) :
              Set (PrimeSpectrum (Polynomial K))) := hx
        rw [← hr] at h1
        obtain ⟨y, hy⟩ := h1
        exact ⟨y, hy⟩
    · have h : (algebraMap (Polynomial K) (LaurentPolynomial K)).comp (algebraMap K (Polynomial K)) =
          algebraMap K (LaurentPolynomial K) := by
        refine RingHom.ext fun k => ?_
        simp [LaurentPolynomial.algebraMap_eq_toLaurent, Polynomial.toLaurent_C,
          LaurentPolynomial.algebraMap_apply]
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, h]

  have s1 : ∃ ι : Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ≅ Spec (.of (MvPolynomial (Fin (c' + 1)) K)), ι.hom ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom) = Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ∧ ι.hom ≫ Spec.map (CommRingCat.ofHom (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K)).toRingHom) = Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) := by
    let Ψ : MvPolynomial (Fin (c' + 1)) K ≃ₐ[K]
        TensorProduct K (MvPolynomial (Fin c') K) (Polynomial K) :=
      (MvPolynomial.finSuccEquiv K c').trans (polyEquivTensor K (MvPolynomial (Fin c') K))
    have hX0 : Ψ (MvPolynomial.X 0) = 1 ⊗ₜ Polynomial.X := by
      simp [Ψ, MvPolynomial.finSuccEquiv_X_zero, polyEquivTensor_apply]
    have hXs : ∀ j : Fin c', Ψ (MvPolynomial.X j.succ) = MvPolynomial.X j ⊗ₜ 1 := by
      intro j
      simp [Ψ, MvPolynomial.finSuccEquiv_X_succ, polyEquivTensor_apply]
    have I1 : (Ψ.toRingEquiv.toRingHom).comp
        (MvPolynomial.rename Fin.succ :
          MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom =
        Algebra.TensorProduct.includeLeftRingHom := by
      have : (Ψ.toAlgHom.comp (MvPolynomial.rename Fin.succ)) =
          (Algebra.TensorProduct.includeLeft : MvPolynomial (Fin c') K →ₐ[K] _) := by
        apply MvPolynomial.algHom_ext
        intro j
        simp [hXs]
      refine RingHom.ext fun x => ?_
      have hx := AlgHom.congr_fun this x
      simpa using hx
    have I2 : (Ψ.toRingEquiv.toRingHom).comp
        (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K)).toRingHom =
        (Algebra.TensorProduct.includeRight : Polynomial K →ₐ[K] _).toRingHom := by
      have : (Ψ.toAlgHom.comp (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K))) =
          (Algebra.TensorProduct.includeRight : Polynomial K →ₐ[K] _) := by
        apply Polynomial.algHom_ext
        simp [hX0]
      refine RingHom.ext fun x => ?_
      have hx := AlgHom.congr_fun this x
      simpa using hx
    let e : Spec (.of (TensorProduct K (MvPolynomial (Fin c') K) (Polynomial K))) ≅
        Spec (.of (MvPolynomial (Fin (c' + 1)) K)) :=
      Scheme.Spec.mapIso (Ψ.toRingEquiv.toCommRingCatIso).op
    have he : e.hom = Spec.map (CommRingCat.ofHom Ψ.toRingEquiv.toRingHom) := rfl
    refine ⟨pullbackSpecIso K _ _ ≪≫ e, ?_, ?_⟩
    · rw [Iso.trans_hom, Category.assoc, he, ← Spec.map_comp, ← CommRingCat.ofHom_comp, I1]
      exact pullbackSpecIso_hom_fst K _ _
    · rw [Iso.trans_hom, Category.assoc, he, ← Spec.map_comp, ← CommRingCat.ofHom_comp, I2]
      exact pullbackSpecIso_hom_snd K _ _
  obtain ⟨ι, e₁, e₂⟩ := s1
  obtain ⟨hj, hjr, hjq⟩ := s3
  haveI := hj

  have hσ' : ι.inv ≫ Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) = Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom) := by
    rw [← e₁, Iso.inv_hom_id_assoc]
  have hε' : ι.inv ≫ Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) = Spec.map (CommRingCat.ofHom (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K)).toRingHom) := by
    rw [← e₂, Iso.inv_hom_id_assoc]
  have hpb : IsPullback (Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom)) (Spec.map (CommRingCat.ofHom (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K)).toRingHom)) (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) := by
    refine IsPullback.of_iso_pullback ⟨?_⟩ ι.symm hσ' hε'
    rw [← hσ', ← hε', Category.assoc, Category.assoc, Limits.pullback.condition]

  have C1 : ∀ (y : Spec (.of (MvPolynomial (Fin (c' + 1)) K))) (i : Fin c'),
      (MvPolynomial.X i : MvPolynomial (Fin c') K) ∈ (Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom) y).asIdeal ↔
        (MvPolynomial.X i.succ : MvPolynomial (Fin (c' + 1)) K) ∈ y.asIdeal := by
    intro y i
    rw [star]
    simp [MvPolynomial.rename_X]
  have C2 : ∀ (y : Spec (.of (MvPolynomial (Fin (c' + 1)) K))),
      (Polynomial.X : Polynomial K) ∈ (Spec.map (CommRingCat.ofHom (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K)).toRingHom) y).asIdeal ↔
        (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K) ∈ y.asIdeal := by
    intro y
    rw [star]
    simp [Polynomial.aeval_X]

  have hAmem : ∀ u : (U₀ : Scheme.{u}), u ∈ wcEtPtCovA0 U₀ ↔
      (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K) ∉ (U₀.ι u).asIdeal := fun u => Iff.rfl
  have hBmem : ∀ u : (U₀ : Scheme.{u}), u ∈ wcEtPtCovB0 U₀ ↔
      ∃ i : Fin c', (MvPolynomial.X i.succ : MvPolynomial (Fin (c' + 1)) K) ∉ (U₀.ι u).asIdeal :=
    fun u => TopologicalSpace.Opens.mem_iSup (s := fun i : Fin c' =>
      PrimeSpectrum.basicOpen (MvPolynomial.X i.succ : MvPolynomial (Fin (c' + 1)) K)) (x := U₀.ι u)
  have hNmem : ∀ u : (U₀ : Scheme.{u}), u ∈ wcEtPtCovA0 U₀ ⊓ wcEtPtCovB0 U₀ ↔
      u ∈ wcEtPtCovA0 U₀ ∧ u ∈ wcEtPtCovB0 U₀ := fun u => Iff.rfl

  have hσa : Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom) ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K))) = Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c' + 1)) K))) := by
    have h : (MvPolynomial.rename Fin.succ : MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom.comp (algebraMap K (MvPolynomial (Fin c') K)) = algebraMap K (MvPolynomial (Fin (c' + 1)) K) :=
      RingHom.ext fun k => by simp
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, h]
  have hεa : Spec.map (CommRingCat.ofHom (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K)).toRingHom) ≫ Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))) = Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c' + 1)) K))) := by
    rw [← hpb.toCommSq.w, hσa]

  have hcov : wcEtPtCovA0 U₀ ⊔ wcEtPtCovB0 U₀ = ⊤ := by
    rw [eq_top_iff]
    intro u _
    have hu : U₀.ι u ∈ Set.range U₀.ι := ⟨u, rfl⟩
    rw [Scheme.Opens.range_ι, hU₀, Set.mem_compl_iff, L0] at hu
    push_neg at hu
    obtain ⟨i, hi⟩ := hu
    refine TopologicalSpace.Opens.mem_sup.2 ?_
    rcases Fin.eq_zero_or_eq_succ i with rfl | ⟨j, rfl⟩
    · exact Or.inl ((hAmem u).2 hi)
    · exact Or.inr ((hBmem u).2 ⟨j, hi⟩)

  have hB : Set.range ((wcEtPtCovB0 U₀).ι ≫ U₀.ι ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom)) ⊆ Set.range W₀.ι := by
    rintro _ ⟨b, rfl⟩
    have hb : (wcEtPtCovB0 U₀).ι b ∈ Set.range (wcEtPtCovB0 U₀).ι := ⟨b, rfl⟩
    rw [Scheme.Opens.range_ι] at hb
    obtain ⟨i, hi⟩ := (hBmem _).1 hb
    rw [Scheme.Opens.range_ι, hW₀, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply,
      Set.mem_compl_iff]
    intro hmem
    exact hi ((C1 _ i).1 ((L0 c' _).1 hmem i))
  obtain ⟨rb₀, hrb⟩ : ∃ rb₀ : ((wcEtPtCovB0 U₀ : (U₀ : Scheme.{u}).Opens) : Scheme.{u}) ⟶ (W₀ : Scheme.{u}),
      rb₀ ≫ W₀.ι = (wcEtPtCovB0 U₀).ι ≫ U₀.ι ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom) :=
    ⟨_, IsOpenImmersion.lift_fac _ _ hB⟩

  have hA : Set.range ((wcEtPtCovA0 U₀ ⊓ wcEtPtCovB0 U₀).ι ≫ U₀.ι ≫ Spec.map (CommRingCat.ofHom (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K)).toRingHom)) ⊆ Set.range (Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) (LaurentPolynomial K)))) := by
    rintro _ ⟨n, rfl⟩
    have hn : (wcEtPtCovA0 U₀ ⊓ wcEtPtCovB0 U₀).ι n ∈
        Set.range (wcEtPtCovA0 U₀ ⊓ wcEtPtCovB0 U₀).ι := ⟨n, rfl⟩
    rw [Scheme.Opens.range_ι] at hn
    have h0 := (hAmem _).1 ((hNmem _).1 hn).1
    rw [hjr, Set.mem_setOf_eq, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, C2]
    exact h0
  obtain ⟨tab₀, htb⟩ : ∃ tab₀ : ((wcEtPtCovA0 U₀ ⊓ wcEtPtCovB0 U₀ : (U₀ : Scheme.{u}).Opens) : Scheme.{u}) ⟶ Spec (.of (LaurentPolynomial K)),
      tab₀ ≫ Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) (LaurentPolynomial K))) = (wcEtPtCovA0 U₀ ⊓ wcEtPtCovB0 U₀).ι ≫ U₀.ι ≫ Spec.map (CommRingCat.ofHom (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K)).toRingHom) :=
    ⟨_, IsOpenImmersion.lift_fac _ _ hA⟩

  have hA' : Set.range ((wcEtPtCovA0 U₀).ι ≫ U₀.ι ≫ Spec.map (CommRingCat.ofHom (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K)).toRingHom)) ⊆ Set.range (Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) (LaurentPolynomial K)))) := by
    rintro _ ⟨n, rfl⟩
    have hn : (wcEtPtCovA0 U₀).ι n ∈ Set.range (wcEtPtCovA0 U₀).ι := ⟨n, rfl⟩
    rw [Scheme.Opens.range_ι] at hn
    have h0 := (hAmem _).1 hn
    rw [hjr, Set.mem_setOf_eq, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, C2]
    exact h0
  obtain ⟨tA, htA⟩ : ∃ tA : ((wcEtPtCovA0 U₀ : (U₀ : Scheme.{u}).Opens) : Scheme.{u}) ⟶ Spec (.of (LaurentPolynomial K)),
      tA ≫ Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) (LaurentPolynomial K))) = (wcEtPtCovA0 U₀).ι ≫ U₀.ι ≫ Spec.map (CommRingCat.ofHom (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K)).toRingHom) :=
    ⟨_, IsOpenImmersion.lift_fac _ _ hA'⟩

  have hRA : ∀ z : Spec (.of (MvPolynomial (Fin (c' + 1)) K)),
      Spec.map (CommRingCat.ofHom (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K)).toRingHom) z ∈ Set.range (Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) (LaurentPolynomial K)))) →
      Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom) z ∈ Set.range (𝟙 (Spec (.of (MvPolynomial (Fin c') K)))) →
      z ∈ Set.range ((wcEtPtCovA0 U₀).ι ≫ U₀.ι) := by
    intro z hz1 _
    rw [hjr, Set.mem_setOf_eq, C2] at hz1
    obtain ⟨u, rfl⟩ : z ∈ Set.range U₀.ι := by
      rw [Scheme.Opens.range_ι, hU₀, Set.mem_compl_iff, L0]
      exact fun h => hz1 (h 0)
    obtain ⟨n, rfl⟩ : u ∈ Set.range (wcEtPtCovA0 U₀).ι := by
      rw [Scheme.Opens.range_ι]
      exact (hAmem u).2 hz1
    exact ⟨n, by rw [Scheme.Hom.comp_apply]⟩
  have hPA := s2 _ _ _ _ hpb.flip
    (Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) (LaurentPolynomial K))))
    (𝟙 (Spec (.of (MvPolynomial (Fin c') K)))) ((wcEtPtCovA0 U₀).ι ≫ U₀.ι) hRA tA
    ((wcEtPtCovA0 U₀).ι ≫ U₀.ι ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom))
    (by rw [htA, Category.assoc]) (by simp only [Category.comp_id, Category.assoc])
  rw [hjq, Category.id_comp] at hPA
  have eqA : tA ≫ Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))) = (wcEtPtCovA0 U₀).ι ≫ U₀.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c' + 1)) K))) := by
    rw [← hjq, ← Category.assoc tA, htA]
    simp only [Category.assoc, hεa]

  have hRB : ∀ z : Spec (.of (MvPolynomial (Fin (c' + 1)) K)),
      Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom) z ∈ Set.range W₀.ι →
      Spec.map (CommRingCat.ofHom (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K)).toRingHom) z ∈ Set.range (𝟙 (Spec (.of (Polynomial K)))) →
      z ∈ Set.range ((wcEtPtCovB0 U₀).ι ≫ U₀.ι) := by
    intro z hz1 _
    rw [Scheme.Opens.range_ι, hW₀, Set.mem_compl_iff, L0] at hz1
    push_neg at hz1
    obtain ⟨i, hi⟩ := hz1
    rw [C1] at hi
    obtain ⟨u, rfl⟩ : z ∈ Set.range U₀.ι := by
      rw [Scheme.Opens.range_ι, hU₀, Set.mem_compl_iff, L0]
      exact fun h => hi (h i.succ)
    obtain ⟨n, rfl⟩ : u ∈ Set.range (wcEtPtCovB0 U₀).ι := by
      rw [Scheme.Opens.range_ι]
      exact (hBmem u).2 ⟨i, hi⟩
    exact ⟨n, by rw [Scheme.Hom.comp_apply]⟩
  have hPB := s2 _ _ _ _ hpb W₀.ι (𝟙 (Spec (.of (Polynomial K))))
    ((wcEtPtCovB0 U₀).ι ≫ U₀.ι) hRB rb₀
    ((wcEtPtCovB0 U₀).ι ≫ U₀.ι ≫ Spec.map (CommRingCat.ofHom (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K)).toRingHom))
    (by rw [hrb, Category.assoc]) (by simp only [Category.comp_id, Category.assoc])
  rw [Category.id_comp] at hPB
  have eqB : rb₀ ≫ W₀.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K))) = (wcEtPtCovB0 U₀).ι ≫ U₀.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c' + 1)) K))) := by
    rw [← Category.assoc rb₀, hrb]
    simp only [Category.assoc, hσa]

  have hRange : ∀ z : Spec (.of (MvPolynomial (Fin (c' + 1)) K)),
      Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom) z ∈ Set.range W₀.ι →
      Spec.map (CommRingCat.ofHom (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K)).toRingHom) z ∈ Set.range (Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) (LaurentPolynomial K)))) →
      z ∈ Set.range ((wcEtPtCovA0 U₀ ⊓ wcEtPtCovB0 U₀).ι ≫ U₀.ι) := by
    intro z hz1 hz2
    rw [Scheme.Opens.range_ι, hW₀, Set.mem_compl_iff, L0] at hz1
    push_neg at hz1
    obtain ⟨i, hi⟩ := hz1
    rw [C1] at hi
    rw [hjr, Set.mem_setOf_eq, C2] at hz2
    obtain ⟨u, rfl⟩ : z ∈ Set.range U₀.ι := by
      rw [Scheme.Opens.range_ι, hU₀, Set.mem_compl_iff, L0]
      exact fun h => hz2 (h 0)
    obtain ⟨n, rfl⟩ : u ∈ Set.range (wcEtPtCovA0 U₀ ⊓ wcEtPtCovB0 U₀).ι := by
      rw [Scheme.Opens.range_ι]
      exact (hNmem u).2 ⟨(hAmem u).2 hz2, (hBmem u).2 ⟨i, hi⟩⟩
    exact ⟨n, by rw [Scheme.Hom.comp_apply]⟩
  have hr1 : ((U₀ : Scheme.{u}).homOfLE (show wcEtPtCovA0 U₀ ⊓ wcEtPtCovB0 U₀ ≤ wcEtPtCovB0 U₀ from inf_le_right) ≫ rb₀) ≫ W₀.ι = ((wcEtPtCovA0 U₀ ⊓ wcEtPtCovB0 U₀).ι ≫ U₀.ι) ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom) := by
    simp only [Category.assoc, hrb, Scheme.homOfLE_ι_assoc]
  have ht1 : tab₀ ≫ Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) (LaurentPolynomial K))) = ((wcEtPtCovA0 U₀ ⊓ wcEtPtCovB0 U₀).ι ≫ U₀.ι) ≫ Spec.map (CommRingCat.ofHom (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K)).toRingHom) := by
    rw [htb, Category.assoc]
  have hPC := s2 _ _ _ _ hpb W₀.ι _ ((wcEtPtCovA0 U₀ ⊓ wcEtPtCovB0 U₀).ι ≫ U₀.ι) hRange _ _ hr1 ht1
  rw [hjq] at hPC
  have eqC : ((U₀ : Scheme.{u}).homOfLE (show wcEtPtCovA0 U₀ ⊓ wcEtPtCovB0 U₀ ≤ wcEtPtCovB0 U₀ from inf_le_right) ≫ rb₀) ≫ W₀.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K))) = (wcEtPtCovA0 U₀ ⊓ wcEtPtCovB0 U₀).ι ≫ U₀.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c' + 1)) K))) := by
    rw [Category.assoc, ← Category.assoc rb₀, hrb]
    simp only [Category.assoc, hσa, Scheme.homOfLE_ι_assoc]
  exact ⟨wcEtPtCovA0 U₀, wcEtPtCovB0 U₀, hcov, ⟨tA, _, hPA, eqA⟩, ⟨rb₀, _, hPB, eqB⟩,
    ⟨_, tab₀, hPC, eqC⟩⟩

theorem wc_et_invsh_of_open_cover : ∀ (K : Type u) [Field K] (n : ℕ) (Z : Scheme.{u}) (fZ : Z ⟶ Spec (.of K)) (A B : Z.Opens), A ⊔ B = ⊤ → wcEtInvSH K (A : Scheme.{u}) (A.ι ≫ fZ) n → wcEtInvSH K (B : Scheme.{u}) (B.ι ≫ fZ) n → wcEtInvSH K ((A ⊓ B : Z.Opens) : Scheme.{u}) ((A ⊓ B).ι ≫ fZ) n → wcEtInvSH K Z fZ n :=
by
  intro K _ n Z fZ A B hAB hA hB hC
  intro R _ _ _ s Y' p t hP E j
  have bA : ∀ (j : ℕ) (D : wcEtPullData (p ∣_ A) n), Function.Bijective (wcEtPull D j) :=
    fun j D => hA R s _ (p ∣_ A) _ ((isPullback_morphismRestrict p A).paste_vert hP) D j
  have bB : ∀ (j : ℕ) (D : wcEtPullData (p ∣_ B) n), Function.Bijective (wcEtPull D j) :=
    fun j D => hB R s _ (p ∣_ B) _ ((isPullback_morphismRestrict p B).paste_vert hP) D j
  have bC : ∀ (j : ℕ) (D : wcEtPullData (p ∣_ (A ⊓ B)) n), Function.Bijective (wcEtPull D j) :=
    fun j D => hC R s _ (p ∣_ (A ⊓ B)) _
      ((isPullback_morphismRestrict p (A ⊓ B)).paste_vert hP) D j
  exact (wc_et_mv_pull_five p n A B hAB bA bB).mp bC j E

theorem wc_et_invsh_punct : ∀ (K : Type u) [Field K] [IsAlgClosed K] (n : ℕ), (n : K) ≠ 0 → ∀ (c : ℕ), 1 ≤ c → ∀ (U₀ : (Spec (.of (MvPolynomial (Fin c) K))).Opens), (U₀ : Set (Spec (.of (MvPolynomial (Fin c) K)))) = (Set.range (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K))))ᶜ → ∀ (T : Scheme.{u}) (fT : T ⟶ Spec (.of K)), wcEtGoodSH K T fT n → ∀ (W : Scheme.{u}) (a : W ⟶ (U₀ : Scheme.{u})) (b : W ⟶ T), IsPullback a b (U₀.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) fT → wcEtInvSH K W (a ≫ U₀.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) n :=
by
  intro K _ _ n hn
  obtain ⟨-, C1b, C1c, C1d⟩ := wc_et_goodsh_closure K n hn

  have C4 : ∀ {S G M A T P : Scheme.{u}} (g : G ⟶ S) (m : M ⟶ S) (fT : T ⟶ S) (α : A ⟶ G)
      (β : A ⟶ M) (x : P ⟶ A) (y : P ⟶ T), IsPullback α β g m → IsPullback x y (α ≫ g) fT →
      ∃ ℓ : P ⟶ Limits.pullback fT g, ℓ ≫ Limits.pullback.fst fT g = y ∧
        IsPullback ℓ (x ≫ β) (Limits.pullback.fst fT g ≫ fT) m := by
    intro S G M A T P g m fT α β x y hA hP
    have w : y ≫ fT = (x ≫ α) ≫ g := by rw [Category.assoc]; exact hP.w.symm
    refine ⟨Limits.pullback.lift y (x ≫ α) w, Limits.pullback.lift_fst _ _ _, ?_⟩
    have Q1 : IsPullback (Limits.pullback.lift y (x ≫ α) w) x (Limits.pullback.snd fT g) α := by
      refine IsPullback.of_right (h₁₂ := Limits.pullback.fst fT g) (h₂₂ := g) (v₁₃ := fT) ?_
        (Limits.pullback.lift_snd _ _ _) (IsPullback.of_hasPullback fT g)
      rw [Limits.pullback.lift_fst]
      exact hP.flip
    rw [Limits.pullback.condition]
    exact Q1.paste_vert hA

  have C5 : ∀ (m : ℕ) (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of K)), wcEtGoodSH K Y fY n →
      ∀ (Y₁ : Scheme.{u}) (a : Y₁ ⟶ Y) (b : Y₁ ⟶ Spec (.of (MvPolynomial (Fin m) K))),
      IsPullback a b fY (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin m) K)))) →
      wcEtGoodSH K Y₁ (a ≫ fY) n := by
    intro m
    induction m with
    | zero =>
      intro Y fY hY Y₁ a b hP
      have hbij : Function.Bijective (algebraMap K (MvPolynomial (Fin 0) K)) :=
        ⟨MvPolynomial.C_injective _ _, MvPolynomial.C_surjective _⟩
      haveI : IsIso (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin 0) K))) :=
        Iso.isIso_hom (RingEquiv.ofBijective _ hbij).toCommRingCatIso
      haveI : IsIso a := hP.isIso_fst_of_isIso
      intro Z fZ hZ W' a' b' h'
      have h'' : IsPullback (a' ≫ a) b' fY fZ :=
        IsPullback.of_iso h' (Iso.refl _) (asIso a) (Iso.refl _) (Iso.refl _)
          (by simp) (by simp) (by simp) (by simp)
      have := hY Z fZ hZ W' (a' ≫ a) b' h''
      rwa [Category.assoc] at this
    | succ m ih =>
      intro Y fY hY Y₁ a b hP
      have Sq := wc_mvpoly_fin_succ_spec_isPullback K m
      have F1 : Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ :
            MvPolynomial (Fin m) K →ₐ[K] MvPolynomial (Fin (m + 1)) K).toRingHom) ≫
          Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin m) K))) =
          Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (m + 1)) K))) := by
        rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, AlgHom.toRingHom_eq_coe,
          AlgHom.comp_algebraMap]
      have hP' : IsPullback b a (Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ :
            MvPolynomial (Fin m) K →ₐ[K] MvPolynomial (Fin (m + 1)) K).toRingHom) ≫
          Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin m) K)))) fY := by
        rw [F1]; exact hP.flip
      obtain ⟨ℓ, hℓ1, hℓ⟩ := C4 _ _ fY _ _ b a Sq hP'
      have hgood := ih Y fY hY _ (Limits.pullback.fst fY
        (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin m) K)))))
        (Limits.pullback.snd _ _) (IsPullback.of_hasPullback _ _)
      let φ1 : CommRingCat.of (Polynomial K) ≅ CommRingCat.of (MvPolynomial (Fin 1) K) :=
        (MvPolynomial.uniqueAlgEquiv K (Fin 1)).symm.toRingEquiv.toCommRingCatIso
      have he1 : Spec.map φ1.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))) =
          Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin 1) K))) := by
        rw [← Spec.map_comp]
        congr 1
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro x
        exact (MvPolynomial.uniqueAlgEquiv K (Fin 1)).symm.commutes x
      have hsq : IsPullback ℓ ((b ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.rename
            (fun _ : Fin 1 => (0 : Fin (m + 1))) :
            MvPolynomial (Fin 1) K →ₐ[K] MvPolynomial (Fin (m + 1)) K).toRingHom)) ≫
            Spec.map φ1.hom)
          (Limits.pullback.fst fY (Spec.map (CommRingCat.ofHom
            (algebraMap K (MvPolynomial (Fin m) K)))) ≫ fY)
          (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) :=
        IsPullback.of_iso hℓ (Iso.refl _) (Iso.refl _) (asIso (Spec.map φ1.hom)) (Iso.refl _)
          (by simp only [Iso.refl_hom, Category.comp_id, Category.id_comp])
          (by simp only [Iso.refl_hom, asIso_hom, Category.id_comp])
          (by simp only [Iso.refl_hom, Category.comp_id, Category.id_comp])
          (by rw [Iso.refl_hom, Category.comp_id, asIso_hom, he1])
      have := C1b _ _ hgood Y₁ ℓ _ hsq
      rw [← Category.assoc, hℓ1] at this
      exact this
  intro c hc
  induction c, hc using Nat.le_induction with
  | base =>
    intro U₀ hU₀ T fT hT W a b hW
    obtain ⟨e, he⟩ := wc_punct_line_laurent_iso K U₀ hU₀
    have hW' : IsPullback (a ≫ e.hom) b
        (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))) fT :=
      IsPullback.of_iso hW (Iso.refl _) e (Iso.refl _) (Iso.refl _)
        (by simp only [Iso.refl_hom, Category.id_comp])
        (by simp only [Iso.refl_hom, Category.comp_id, Category.id_comp])
        (by rw [Iso.refl_hom, Category.comp_id, he])
        (by simp only [Iso.refl_hom, Category.comp_id, Category.id_comp])
    have hI := C1d W (b ≫ fT) (C1c T fT hT W b (a ≫ e.hom) hW'.flip)
    rw [← hW.w] at hI
    exact hI
  | succ c' hc' IH =>
    intro U₀ hU₀ T fT hT W a b hW

    haveI : IsClosedImmersion (Spec.map (CommRingCat.ofHom
        (MvPolynomial.constantCoeff : MvPolynomial (Fin c') K →+* K))) :=
      IsClosedImmersion.spec_of_surjective _
        (fun r => ⟨MvPolynomial.C r, MvPolynomial.constantCoeff_C _ r⟩)
    obtain ⟨W₀, hW₀⟩ : ∃ O : (Spec (.of (MvPolynomial (Fin c') K))).Opens,
        (O : Set (Spec (.of (MvPolynomial (Fin c') K)))) = (Set.range (Spec.map
          (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c') K →+* K))))ᶜ :=
      ⟨⟨_, (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff :
        MvPolynomial (Fin c') K →+* K))).isClosedEmbedding.isClosed_range.isOpen_compl⟩, rfl⟩
    obtain ⟨A, B, hAB, ⟨αA, βA, hA, eA⟩, ⟨αB, βB, hB, eB⟩, ⟨αC, βC, hC, eC⟩⟩ :=
      wc_et_punct_cover_pieces K c' hc' U₀ hU₀ W₀ hW₀
    have hcov : a ⁻¹ᵁ A ⊔ a ⁻¹ᵁ B = ⊤ := by
      rw [← Scheme.Hom.preimage_sup, hAB, Scheme.Hom.preimage_top]
    have RV : ∀ V : (U₀ : Scheme.{u}).Opens, IsPullback (a ∣_ V) ((a ⁻¹ᵁ V).ι ≫ b)
        (V.ι ≫ U₀.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K
          (MvPolynomial (Fin (c' + 1)) K)))) fT :=
      fun V => (isPullback_morphismRestrict a V).paste_vert hW
    have star : ∀ V : (U₀ : Scheme.{u}).Opens, (a ⁻¹ᵁ V).ι ≫ a ≫ U₀.ι ≫ Spec.map
        (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c' + 1)) K))) =
        a ∣_ V ≫ V.ι ≫ U₀.ι ≫ Spec.map
          (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c' + 1)) K))) := by
      intro V
      simp only [← Category.assoc, morphismRestrict_ι]
    have gTm := C1c T fT hT _ (Limits.pullback.fst fT
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))
      (Limits.pullback.snd _ _) (IsPullback.of_hasPullback _ _)
    have gT1 := C1b T fT hT _ (Limits.pullback.fst fT
      (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))
      (Limits.pullback.snd _ _) (IsPullback.of_hasPullback _ _)

    have hRA : IsPullback (a ∣_ A) ((a ⁻¹ᵁ A).ι ≫ b)
        (αA ≫ Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))) fT := by
      rw [eA]; exact RV A
    obtain ⟨ℓA, hℓA1, hℓA⟩ := C4 _ _ fT αA βA (a ∣_ A) ((a ⁻¹ᵁ A).ι ≫ b) hA hRA
    have iA := C1d _ _ (C5 c' _ _ gTm _ ℓA (a ∣_ A ≫ βA) hℓA)
    have eqA : ℓA ≫ Limits.pullback.fst fT
        (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))) ≫ fT =
        (a ⁻¹ᵁ A).ι ≫ a ≫ U₀.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K
          (MvPolynomial (Fin (c' + 1)) K))) := by
      rw [← Category.assoc, hℓA1, Category.assoc, ← hW.w]
    rw [eqA] at iA

    have hRB : IsPullback (a ∣_ B) ((a ⁻¹ᵁ B).ι ≫ b)
        (βB ≫ Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) fT := by
      rw [← hB.w, eB]; exact RV B
    obtain ⟨ℓB, hℓB1, hℓB⟩ := C4 _ _ fT βB αB (a ∣_ B) ((a ⁻¹ᵁ B).ι ≫ b) hB.flip hRB
    have iB := IH W₀ hW₀ _ _ gT1 _ (a ∣_ B ≫ αB) ℓB hℓB.flip
    have eqB : (a ∣_ B ≫ αB) ≫ W₀.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K
        (MvPolynomial (Fin c') K))) = (a ⁻¹ᵁ B).ι ≫ a ≫ U₀.ι ≫ Spec.map (CommRingCat.ofHom
          (algebraMap K (MvPolynomial (Fin (c' + 1)) K))) := by
      rw [Category.assoc, eB, star B]
    rw [eqB] at iB

    have hRC : IsPullback (a ∣_ (A ⊓ B)) ((a ⁻¹ᵁ (A ⊓ B)).ι ≫ b)
        (βC ≫ Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))) fT := by
      rw [← hC.w, eC]; exact RV (A ⊓ B)
    obtain ⟨ℓC, hℓC1, hℓC⟩ := C4 _ _ fT βC αC (a ∣_ (A ⊓ B)) ((a ⁻¹ᵁ (A ⊓ B)).ι ≫ b)
      hC.flip hRC
    have iC := IH W₀ hW₀ _ _ gTm _ (a ∣_ (A ⊓ B) ≫ αC) ℓC hℓC.flip
    have eqC : (a ∣_ (A ⊓ B) ≫ αC) ≫ W₀.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K
        (MvPolynomial (Fin c') K))) = (a ⁻¹ᵁ (A ⊓ B)).ι ≫ a ≫ U₀.ι ≫ Spec.map
          (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c' + 1)) K))) := by
      rw [Category.assoc, eC, star (A ⊓ B)]
    rw [eqC] at iC

    refine wc_et_invsh_of_open_cover K n W _ (a ⁻¹ᵁ A) (a ⁻¹ᵁ B) hcov iA iB ?_
    first
      | exact iC
      | (rw [← Scheme.Hom.preimage_inf]; exact iC)

theorem wc_punct_OK_mvpoly_model : ∀ (F : Type u) [Field F] (d : ℕ) (OK : (wcTlAff F d).Opens), (OK : Set ↥(wcTlAff F d)) = (Set.range (wcTlZero F d))ᶜ → ∃ (U₀ : (Spec (.of (MvPolynomial (Fin d) (AlgebraicClosure F)))).Opens) (_ : (U₀ : Set (Spec (.of (MvPolynomial (Fin d) (AlgebraicClosure F))))) = (Set.range (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin d) (AlgebraicClosure F) →+* AlgebraicClosure F))))ᶜ) (e : OK.toScheme ≅ (U₀ : Scheme.{u})), e.hom ≫ U₀.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap (AlgebraicClosure F) (MvPolynomial (Fin d) (AlgebraicClosure F)))) = OK.ι ≫ wcTlStr F d :=
by
  intro F _ d OK hOK
  have hpull : ∀ (K : Type u) [Field K] (B : Scheme.{u}) (qB : B ⟶ Spec (.of K)) (c : ℕ), ∃ q : AffineSpace (ULift.{u} (Fin c)) B ⟶ Spec (.of (MvPolynomial (Fin c) K)), IsPullback (AffineSpace (ULift.{u} (Fin c)) B ↘ B) q qB (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) ∧ AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin c) → Γ(B, ⊤)) ≫ q = qB ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) := by
    intro K _ B qB c
    have e1 : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (x : Γ(Z, ⊤)),
        ConcreteCategory.hom (f ≫ g).appTop x =
          ConcreteCategory.hom f.appTop (ConcreteCategory.hom g.appTop x) := by
      intro X Y Z f g x
      rw [Scheme.Hom.comp_appTop]
      rfl
    let ρ : MvPolynomial (Fin c) K →+* MvPolynomial (ULift.{u} (Fin c)) K :=
      (MvPolynomial.rename (ULift.up : Fin c → ULift.{u} (Fin c))).toRingHom
    let ρe : MvPolynomial (Fin c) K ≃+* MvPolynomial (ULift.{u} (Fin c)) K :=
      (MvPolynomial.renameEquiv K (Equiv.ulift (α := Fin c)).symm).toRingEquiv
    let s := AffineSpace.SpecIso (ULift.{u} (Fin c)) (CommRingCat.of K)
    let e : AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)) ≅ Spec (.of (MvPolynomial (Fin c) K)) :=
      s ≪≫ Scheme.Spec.mapIso ρe.toCommRingCatIso.op
    have he : e.hom = s.hom ≫ Spec.map (CommRingCat.ofHom ρ) := rfl
    have hρC : ρ.comp MvPolynomial.C =
        (MvPolynomial.C : K →+* MvPolynomial (ULift.{u} (Fin c)) K) :=
      RingHom.ext fun r => MvPolynomial.rename_C _ r
    have hccρ : (MvPolynomial.constantCoeff : MvPolynomial (ULift.{u} (Fin c)) K →+* K).comp ρ =
        MvPolynomial.constantCoeff :=
      RingHom.ext fun φ => MvPolynomial.constantCoeff_rename _ φ
    have ha : e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K))) =
        AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)) ↘ Spec (.of K) := by
      rw [he, Category.assoc, ← Iso.eq_inv_comp, AffineSpace.SpecIso_inv_over, ← Spec.map_comp,
        ← CommRingCat.ofHom_comp, MvPolynomial.algebraMap_eq, hρC]
    have hnat : ∀ x : MvPolynomial (ULift.{u} (Fin c)) K,
        ConcreteCategory.hom (Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (ULift.{u} (Fin c)) K →+* K))).appTop
          (ConcreteCategory.hom (Scheme.ΓSpecIso (CommRingCat.of (MvPolynomial (ULift.{u} (Fin c)) K))).inv x)
        = ConcreteCategory.hom (Scheme.ΓSpecIso (CommRingCat.of K)).inv
            (MvPolynomial.constantCoeff x) := by
      intro x
      have h := Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom
            (MvPolynomial.constantCoeff : MvPolynomial (ULift.{u} (Fin c)) K →+* K))
      have h2 := ConcreteCategory.congr_hom h x
      simp only at h2
      exact h2.symm
    have hkey : AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤))
        ≫ s.hom = Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (ULift.{u} (Fin c)) K →+* K)) := by
      rw [← Iso.eq_comp_inv]
      apply AffineSpace.hom_ext
      · rw [AffineSpace.homOfVector_over, Category.assoc, AffineSpace.SpecIso_inv_over,
          ← Spec.map_comp, ← CommRingCat.ofHom_comp]
        erw [MvPolynomial.constantCoeff_comp_C]
        rw [CommRingCat.ofHom_id, Spec.map_id]
      · intro i
        rw [e1, AffineSpace.SpecIso_inv_appTop_coord, AffineSpace.homOfVector_appTop_coord,
          Pi.zero_apply]
        erw [hnat]
        rw [MvPolynomial.constantCoeff_X, map_zero]
    have hb : AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤))
        ≫ e.hom = Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) := by
      rw [he, ← Category.assoc, hkey, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hccρ]
    have P0 := AffineSpace.isPullback_map (n := ULift.{u} (Fin c)) qB
    have P1 : IsPullback (AffineSpace (ULift.{u} (Fin c)) B ↘ B)
        (AffineSpace.map (ULift.{u} (Fin c)) qB ≫ e.hom) qB
        (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) :=
      IsPullback.of_iso P0.flip (Iso.refl _) (Iso.refl _) e (Iso.refl _)
        (by rw [Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp])
        (by rw [Iso.refl_hom, Category.id_comp])
        (by rw [Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp])
        (by rw [Iso.refl_hom, Category.comp_id, ha])
    have hcomm : AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin c) → Γ(B, ⊤)) ≫
        AffineSpace.map (ULift.{u} (Fin c)) qB =
        qB ≫ AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤)) := by
      apply AffineSpace.hom_ext
      · rw [Category.assoc, AffineSpace.map_over, ← Category.assoc, AffineSpace.homOfVector_over,
          Category.id_comp, Category.assoc, AffineSpace.homOfVector_over, Category.comp_id]
      · intro i
        simp only [e1, AffineSpace.homOfVector_appTop_coord, AffineSpace.map_appTop_coord,
          Pi.zero_apply, map_zero]
    refine ⟨AffineSpace.map (ULift.{u} (Fin c)) qB ≫ e.hom, P1, ?_⟩
    rw [← Category.assoc, hcomm, Category.assoc, hb]
  obtain ⟨q, hpb, hz⟩ := hpull (AlgebraicClosure F)
    (Spec (.of (AlgebraicClosure F))) (𝟙 _) d
  haveI : IsIso q := hpb.isIso_snd_of_isIso
  have hcomm : wcTlStr F d = q ≫ Spec.map (CommRingCat.ofHom
      (algebraMap (AlgebraicClosure F) (MvPolynomial (Fin d) (AlgebraicClosure F)))) := by
    have h := hpb.toCommSq.w
    rw [Category.comp_id] at h
    exact h
  have hz' : wcTlZero F d ≫ q = Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff : MvPolynomial (Fin d) (AlgebraicClosure F) →+* AlgebraicClosure F)) := by
    rw [Category.id_comp] at hz
    exact hz
  haveI hci : IsClosedImmersion (Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff : MvPolynomial (Fin d) (AlgebraicClosure F) →+* AlgebraicClosure F))) := by
    apply IsClosedImmersion.spec_of_surjective
    intro r
    exact ⟨MvPolynomial.C r, by simp⟩
  let U₀ : (Spec (.of (MvPolynomial (Fin d) (AlgebraicClosure F)))).Opens :=
    ⟨(Set.range (Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff : MvPolynomial (Fin d) (AlgebraicClosure F) →+* AlgebraicClosure F))))ᶜ,
      (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff :
        MvPolynomial (Fin d) (AlgebraicClosure F) →+* AlgebraicClosure F))).isClosedEmbedding.isClosed_range.isOpen_compl⟩
  have hinj : ∀ a b, q a = q b → a = b := by
    intro a b h
    have h1 := Scheme.hom_inv_apply (asIso q) a
    have h2 := Scheme.hom_inv_apply (asIso q) b
    rw [asIso_hom] at h1 h2
    rw [← h1, ← h2, h]
  have hrange : Set.range (OK.ι ≫ q) = Set.range U₀.ι := by
    rw [Scheme.Opens.range_ι]
    ext y
    constructor
    · rintro ⟨x, rfl⟩ ⟨p, hp⟩
      rw [← hz', Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at hp
      have hx := hinj _ _ hp
      have hmem : OK.ι x ∈ Set.range OK.ι := ⟨x, rfl⟩
      rw [Scheme.Opens.range_ι, hOK] at hmem
      exact hmem ⟨p, hx⟩
    · intro hy
      have hw := Scheme.inv_hom_apply (asIso q) y
      rw [asIso_hom] at hw
      have hwOK : (asIso q).inv y ∈ Set.range OK.ι := by
        rw [Scheme.Opens.range_ι, hOK]
        rintro ⟨p, hp⟩
        apply hy
        refine ⟨p, ?_⟩
        rw [← hz', Scheme.Hom.comp_apply, hp, hw]
      obtain ⟨x, hx⟩ := hwOK
      refine ⟨x, ?_⟩
      rw [Scheme.Hom.comp_apply, hx, hw]
  refine ⟨U₀, rfl, IsOpenImmersion.isoOfRangeEq (OK.ι ≫ q) U₀.ι hrange, ?_⟩
  rw [← Category.assoc, IsOpenImmersion.isoOfRangeEq_hom_fac, Category.assoc, ← hcomm]

theorem wc_punct_strict_henselian_base_pull_bij (F : Type u) [Finite F] [Field F] (d : ℕ)
    (hd : 1 ≤ d) (OK : (wcTlAff F d).Opens)
    (hOK : (OK : Set ↥(wcTlAff F d)) = (Set.range (wcTlZero F d))ᶜ)
    (R : CommRingCat.{u}) [HenselianLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)]
    (s : Spec R ⟶ Spec (.of (AlgebraicClosure F))) {Pq : Scheme.{u}} (q : Pq ⟶ OK.toScheme)
    (t : Pq ⟶ Spec R) (hP : IsPullback q t (OK.ι ≫ wcTlStr F d) s) (n : ℕ)
    (hn : (n : AlgebraicClosure F) ≠ 0)
    (D : wcZModPullData q n) (hD : wcZModPullCanonical D) (j : ℕ) :
    Function.Bijective (wcZModPull D j) :=
by
  classical

  obtain ⟨U₀, hU₀, e, he⟩ := wc_punct_OK_mvpoly_model F d OK hOK

  have hGood := (wc_et_goodsh_closure (AlgebraicClosure F) n hn).1

  have hsq : IsPullback e.hom (OK.ι ≫ wcTlStr F d)
      (U₀.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap (AlgebraicClosure F)
        (MvPolynomial (Fin d) (AlgebraicClosure F)))))
      (𝟙 (Spec (.of (AlgebraicClosure F)))) :=
    IsPullback.of_horiz_isIso ⟨by rw [he, Category.comp_id]⟩
  have hInv0 := wc_et_invsh_punct (AlgebraicClosure F) n hn d hd U₀ hU₀
    (Spec (.of (AlgebraicClosure F))) (𝟙 _) hGood OK.toScheme e.hom (OK.ι ≫ wcTlStr F d) hsq
  have hInv : wcEtInvSH (AlgebraicClosure F) OK.toScheme (OK.ι ≫ wcTlStr F d) n := by
    rw [← he]; exact hInv0

  obtain ⟨E⟩ := wc_et_zmod_pull_data_exists q n
  have hE : Function.Bijective (wcEtPull E j) := hInv R s Pq q t hP E j

  haveI : IsLocallyNoetherian (wcTlAff F d) :=
    (wc_tl_zero_section_facts F d (𝟙 (Spec (.of (AlgebraicClosure F))))).2.2.2 inferInstance
  haveI : CompactSpace ↥OK.toScheme := QuasiCompact.compactSpace_of_compactSpace OK.ι
  haveI : QuasiSeparatedSpace ↥OK.toScheme := quasiSeparatedSpace_of_quasiSeparated OK.ι
  have hqc : QuasiCompact (OK.ι ≫ wcTlStr F d) := inferInstance
  have hqs : QuasiSeparated (OK.ι ≫ wcTlStr F d) := inferInstance
  haveI : QuasiCompact t := MorphismProperty.of_isPullback (P := @QuasiCompact) hP hqc
  haveI : QuasiSeparated t := MorphismProperty.of_isPullback (P := @QuasiSeparated) hP hqs
  haveI : CompactSpace ↥Pq := QuasiCompact.compactSpace_of_compactSpace t
  haveI : QuasiSeparatedSpace ↥Pq := quasiSeparatedSpace_of_quasiSeparated t

  obtain ⟨Θ, hΘb, hΘn⟩ := wc_zmod_et_proet_natural_comparison_all n j
  have h1 : (wcZModPull D j) ∘ (Θ OK.toScheme) = (Θ Pq) ∘ (wcEtPull E j) :=
    funext (fun x => hΘn q D hD E x)
  have h2 : Function.Bijective ((wcZModPull D j) ∘ (Θ OK.toScheme)) := by
    rw [h1]; exact (hΘb Pq inferInstance inferInstance).comp hE
  exact (Function.Bijective.of_comp_iff (wcZModPull D j)
    (hΘb OK.toScheme inferInstance inferInstance)).mp h2

theorem wc_wcontr_torsion_kunneth_of_base_bij {B Y O U : Scheme.{u}} (pY : Y ⟶ B) (g : O ⟶ U)
    (p : O ⟶ Y) (qU : U ⟶ B) (hsq : IsPullback p g pY qU) (hqc : QuasiCompact g)
    (hqs : QuasiSeparated g) (n : ℕ) (W : U.ProEt)
    (hW : IsAffine W.left ∧ IsClosed {x : W.left | IsClosed ({x} : Set W.left)} ∧
      (∀ x : W.left, ∃! y : W.left, IsClosed ({y} : Set W.left) ∧ x ⤳ y) ∧
      ExtremallyDisconnected {x : W.left | IsClosed ({x} : Set W.left)} ∧
      (∀ x : W.left, IsClosed ({x} : Set W.left) →
        HenselianLocalRing (W.left.presheaf.stalk x) ∧ IsSepClosed (W.left.residueField x)))
    (hbij : ∀ (z : W.left), IsClosed ({z} : Set W.left) → ∀ {Pq : Scheme.{u}} (q : Pq ⟶ Y)
      (t : Pq ⟶ Spec (W.left.presheaf.stalk z)),
      IsPullback q t pY (W.left.fromSpecStalk z ≫ W.hom ≫ qU) →
      ∀ (D : wcZModPullData q n), wcZModPullCanonical D → ∀ j : ℕ, Function.Bijective (wcZModPull D j))
    (j : ℕ) (D₂ : wcZModPullData (((wcProEtBC g).obj W).hom ≫ p) n) (hD₂ : wcZModPullCanonical D₂) :
    letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf ((wcProEtBC g).obj W).left n)) :=
      HasExt.standard _
    ∃ Ξ : LocallyConstant W.left (wcZModProEtExt Y n j) ≃+ wcZModProEtExt ((wcProEtBC g).obj W).left n j,
      ∀ (V : Set W.left) [∀ x, Decidable (x ∈ V)] (hV : IsClopen V) (a : wcZModProEtExt Y n j),
        Ξ ((LocallyConstant.ofIsClopen hV).map (fun i : Fin 2 => if i = 0 then a else 0)) =
          (Abelian.Ext.mk₀ (wcZModFun ((wcProEtBC g).obj W).left n
            ((((LocallyConstant.ofIsClopen hV).map (fun i : Fin 2 =>
                if i = 0 then (1 : ULift.{u+1} (ZMod n)) else 0)).toContinuousMap).comp
              (Limits.pullback.fst W.hom g).base.hom))).comp
            (wcZModPull D₂ j a) (zero_add j) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf ((wcProEtBC g).obj W).left n)) :=
    HasExt.standard _
  haveI : IsAffine W.left := hW.1
  haveI : IsAffine ((𝟭 Scheme).obj W.left) := hW.1
  haveI := hqc
  haveI := hqs
  have hQC : QuasiCompact (Limits.pullback.fst W.hom g) := inferInstance
  have hQS : QuasiSeparated (Limits.pullback.fst W.hom g) := inferInstance

  have hFunOne : ∀ (S : Scheme.{u}) (m : ℕ), wcZModFun S m 1 = 𝟙 _ := by
    intro S m
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext V
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    rw [← SheafOfModules.unitHomEquiv_apply_coe]
    simp only [wcZModFun, Equiv.apply_symm_apply]
    rfl
  have hFunMul : ∀ (S : Scheme.{u}) (m : ℕ) (r r' : C(↥S, ULift.{u+1} (ZMod m))),
      wcZModFun S m (r * r') = wcZModFun S m r ≫ wcZModFun S m r' := by
    intro S m r r'
    apply (SheafOfModules.unitHomEquiv _).injective
    rw [SheafOfModules.unitHomEquiv_comp_apply]
    apply Subtype.ext
    funext V
    have hvalP : ∀ c : C(↥S, ULift.{u+1} (ZMod m)),
        ((SheafOfModules.unitHomEquiv _) (wcZModFun S m c)).1 V =
        (c.comp (Opposite.unop V).hom.base.hom :
          C(↥((Opposite.unop V).left), ULift.{u+1} (ZMod m))) := by
      intro c
      simp only [wcZModFun, Equiv.apply_symm_apply]
      rfl
    show _ = ((wcZModFun S m r').val.app V).hom (((SheafOfModules.unitHomEquiv _) (wcZModFun S m r)).1 V)
    rw [hvalP, hvalP]
    apply ContinuousMap.ext
    intro x
    rfl
  have hFunAdd : ∀ (S : Scheme.{u}) (m : ℕ) (r r' : C(↥S, ULift.{u+1} (ZMod m))),
      wcZModFun S m (r + r') = wcZModFun S m r + wcZModFun S m r' := by
    intro S m r r'
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext V
    have hvalP : ∀ c : C(↥S, ULift.{u+1} (ZMod m)),
        ((SheafOfModules.unitHomEquiv _) (wcZModFun S m c)).1 V =
        (c.comp (Opposite.unop V).hom.base.hom :
          C(↥((Opposite.unop V).left), ULift.{u+1} (ZMod m))) := by
      intro c
      simp only [wcZModFun, Equiv.apply_symm_apply]
      rfl
    rw [hvalP, SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.add_val,
      PresheafOfModules.add_app]
    show _ = ((SheafOfModules.unitHomEquiv _) (wcZModFun S m r)).1 V +
      ((SheafOfModules.unitHomEquiv _) (wcZModFun S m r')).1 V
    rw [hvalP, hvalP]
    apply ContinuousMap.ext
    intro x
    rfl

  obtain ⟨χ, hχdef⟩ : ∃ χ : ∀ V : Set W.left, IsClopen V →
      C(↥((wcProEtBC g).obj W).left, ULift.{u+1} (ZMod n)),
      ∀ (V : Set W.left) (hV : IsClopen V), χ V hV =
        (LocallyConstant.charFn (ULift.{u+1} (ZMod n)) hV).toContinuousMap.comp
          (Limits.pullback.fst W.hom g).base.hom :=
    ⟨_, fun _ _ => rfl⟩
  have hχ : ∀ (V : Set W.left) (hV : IsClopen V)
      (x : ((wcProEtBC g).obj W).left),
      χ V hV x = V.indicator 1 ((Limits.pullback.fst W.hom g).base.hom x) := by
    intro V hV x
    rw [hχdef]
    show (LocallyConstant.charFn (ULift.{u+1} (ZMod n)) hV)
      ((Limits.pullback.fst W.hom g).base.hom x) = _
    rw [LocallyConstant.coe_charFn]
  obtain ⟨e, he⟩ : ∃ e : ∀ V : Set W.left, IsClopen V →
      (wcZModProEtExt ((wcProEtBC g).obj W).left n j →+
        wcZModProEtExt ((wcProEtBC g).obj W).left n j),
      ∀ (V : Set W.left) (hV : IsClopen V) h, e V hV h =
        (Abelian.Ext.mk₀ (wcZModFun ((wcProEtBC g).obj W).left n (χ V hV))).comp h (zero_add j) :=
    ⟨fun V hV => (Abelian.Ext.mk₀ (wcZModFun
      ((wcProEtBC g).obj W).left n (χ V hV))).precomp _ (zero_add j), fun _ _ _ => rfl⟩

  have G0 : ∀ (T : Scheme.{u}) (r r' : C(↥T, ULift.{u+1} (ZMod n))), r = r' →
      ∀ h : wcZModProEtExt T n j,
      letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T n)) := HasExt.standard _
      (Abelian.Ext.mk₀ (wcZModFun T n r)).comp h (zero_add j) =
        (Abelian.Ext.mk₀ (wcZModFun T n r')).comp h (zero_add j) := by
    intro T r r' hr h
    subst hr
    rfl
  have G1 : ∀ (T : Scheme.{u}) (r : C(↥T, ULift.{u+1} (ZMod n))), r = 1 →
      ∀ h : wcZModProEtExt T n j,
      letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T n)) := HasExt.standard _
      (Abelian.Ext.mk₀ (wcZModFun T n r)).comp h (zero_add j) = h := by
    intro T r hr h
    letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T n)) := HasExt.standard _
    subst hr
    rw [hFunOne]
    exact Abelian.Ext.mk₀_id_comp h
  have G2 : ∀ (T : Scheme.{u}) (r r1 r2 : C(↥T, ULift.{u+1} (ZMod n))), r = r1 * r2 →
      ∀ h : wcZModProEtExt T n j,
      letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T n)) := HasExt.standard _
      (Abelian.Ext.mk₀ (wcZModFun T n r)).comp h (zero_add j) =
        (Abelian.Ext.mk₀ (wcZModFun T n r1)).comp
          ((Abelian.Ext.mk₀ (wcZModFun T n r2)).comp h (zero_add j)) (zero_add j) := by
    intro T r r1 r2 hr h
    letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T n)) := HasExt.standard _
    subst hr
    rw [hFunMul, ← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
  have G3 : ∀ (T : Scheme.{u}) (r r1 r2 : C(↥T, ULift.{u+1} (ZMod n))), r = r1 + r2 →
      ∀ h : wcZModProEtExt T n j,
      letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T n)) := HasExt.standard _
      (Abelian.Ext.mk₀ (wcZModFun T n r)).comp h (zero_add j) =
        (Abelian.Ext.mk₀ (wcZModFun T n r1)).comp h (zero_add j) +
          (Abelian.Ext.mk₀ (wcZModFun T n r2)).comp h (zero_add j) := by
    intro T r r1 r2 hr h
    letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T n)) := HasExt.standard _
    subst hr
    rw [hFunAdd, Abelian.Ext.mk₀_add, Abelian.Ext.add_comp]

  have he1 : ∀ h, e Set.univ isClopen_univ h = h := by
    intro h
    have hf : χ Set.univ isClopen_univ = 1 :=
      ContinuousMap.ext fun x => (hχ _ _ x).trans (congrFun (Set.indicator_univ _) _)
    exact (he _ _ h).trans (G1 _ _ hf h)
  have hei : ∀ (V V' : Set W.left) (hV : IsClopen V) (hV' : IsClopen V') h,
      e (V ∩ V') (hV.inter hV') h = e V hV (e V' hV' h) := by
    intro V V' hV hV' h
    have hf : χ (V ∩ V') (hV.inter hV') = χ V hV * χ V' hV' :=
      ContinuousMap.ext fun x => (hχ _ _ x).trans
        ((congrFun (Set.inter_indicator_one (M₀ := ULift.{u+1} (ZMod n)) (s := V) (t := V')) _).trans
          (congrArg₂ (· * ·) (hχ V hV x) (hχ V' hV' x)).symm)
    exact (he _ _ h).trans ((G2 _ _ _ _ hf h).trans
      ((congrArg (fun y => (Abelian.Ext.mk₀ (wcZModFun
          ((wcProEtBC g).obj W).left n (χ V hV))).comp y
          (zero_add j)) (he V' hV' h).symm).trans (he V hV _).symm))
  have heu : ∀ (V V' : Set W.left) (hV : IsClopen V) (hV' : IsClopen V'), Disjoint V V' → ∀ h,
      e (V ∪ V') (hV.union hV') h = e V hV h + e V' hV' h := by
    intro V V' hV hV' hdisj h
    have hf : χ (V ∪ V') (hV.union hV') = χ V hV + χ V' hV' :=
      ContinuousMap.ext fun x => (hχ _ _ x).trans
        ((congrFun (Set.indicator_union_of_disjoint hdisj (1 : W.left → ULift.{u+1} (ZMod n))) _).trans
          (congrArg₂ (· + ·) (hχ V hV x) (hχ V' hV' x)).symm)
    exact (he _ _ h).trans ((G3 _ _ _ _ hf h).trans
      (congrArg₂ (· + ·) (he V hV h).symm (he V' hV' h).symm))

  have hgerm : ∀ z ∈ {x : W.left | IsClosed ({x} : Set W.left)},
      (∀ h, ∃ (a : wcZModProEtExt Y n j) (V : Set W.left) (hV : IsClopen V),
        z ∈ V ∧ e V hV h = e V hV (wcZModPull D₂ j a)) ∧
      (∀ (a : wcZModProEtExt Y n j) (V : Set W.left) (hV : IsClopen V),
        z ∈ V → e V hV (wcZModPull D₂ j a) = 0 → a = 0) := by
    intro z hz
    have hP : IsPullback
        (Limits.pullback.snd (W.left.fromSpecStalk z) (Limits.pullback.fst W.hom g) ≫
          ((wcProEtBC g).obj W).hom ≫ p)
        (Limits.pullback.fst (W.left.fromSpecStalk z) (Limits.pullback.fst W.hom g))
        pY (W.left.fromSpecStalk z ≫ W.hom ≫ qU) :=
      (IsPullback.of_hasPullback (W.left.fromSpecStalk z)
          (Limits.pullback.fst W.hom g)).flip.paste_horiz
        ((IsPullback.of_hasPullback W.hom g).flip.paste_horiz hsq)
    obtain ⟨Dsn, hDsn⟩ := wc_zmod_pull_data_exists (Limits.pullback.snd (W.left.fromSpecStalk z)
      (Limits.pullback.fst W.hom g)) n
    obtain ⟨Dq, hDq⟩ := wc_zmod_pull_data_exists
      (Limits.pullback.snd (W.left.fromSpecStalk z) (Limits.pullback.fst W.hom g) ≫
          ((wcProEtBC g).obj W).hom ≫ p) n
    have bij := hbij z hz _ _ hP Dq hDq j
    have hcomp : ∀ a, wcZModPull Dq j a = wcZModPull Dsn j (wcZModPull D₂ j a) := fun a =>
      wc_zmod_pull_comp _ _ _ rfl D₂ hD₂ Dsn hDsn Dq hDq j a
    have hpt : ∀ t : ↥(Limits.pullback (W.left.fromSpecStalk z) (Limits.pullback.fst W.hom g)),
        (Limits.pullback.fst W.hom g)
          ((Limits.pullback.snd (W.left.fromSpecStalk z) (Limits.pullback.fst W.hom g)) t) =
        W.left.fromSpecStalk z
          ((Limits.pullback.fst (W.left.fromSpecStalk z) (Limits.pullback.fst W.hom g)) t) := by
      intro t
      have h1 := Scheme.Hom.comp_apply
        (Limits.pullback.snd (W.left.fromSpecStalk z) (Limits.pullback.fst W.hom g))
        (Limits.pullback.fst W.hom g) t
      have h2 := Scheme.Hom.comp_apply
        (Limits.pullback.fst (W.left.fromSpecStalk z) (Limits.pullback.fst W.hom g))
        (W.left.fromSpecStalk z) t
      rw [← h1, ← h2, Limits.pullback.condition]
    have hkill : ∀ (V : Set W.left) (hV : IsClopen V), z ∈ V → ∀ h,
        wcZModPull Dsn j (e V hV h) = wcZModPull Dsn j h := by
      intro V hV hzV h
      have hone : (χ V hV).comp
          (Limits.pullback.snd (W.left.fromSpecStalk z)
            (Limits.pullback.fst W.hom g)).base.hom = 1 := by
        apply ContinuousMap.ext
        intro t
        have hmem : (Limits.pullback.fst W.hom g)
            ((Limits.pullback.snd (W.left.fromSpecStalk z)
              (Limits.pullback.fst W.hom g)) t) ∈ V := by
          rw [hpt t]
          have hr : W.left.fromSpecStalk z ((Limits.pullback.fst (W.left.fromSpecStalk z)
              (Limits.pullback.fst W.hom g)) t) ∈ Set.range (W.left.fromSpecStalk z) := ⟨_, rfl⟩
          rw [Scheme.range_fromSpecStalk] at hr
          exact Specializes.mem_open hr hV.isOpen hzV
        show χ V hV ((Limits.pullback.snd (W.left.fromSpecStalk z)
            (Limits.pullback.fst W.hom g)).base.hom t) = 1
        exact (hχ V hV _).trans (Set.indicator_of_mem hmem _)
      exact (congrArg (wcZModPull Dsn j) (he V hV h)).trans
        ((wc_zmod_pull_fun Dsn hDsn (χ V hV) j h).trans (G1 _ _ hone _))
    refine ⟨fun h => ?_, fun a V hV hzV h0 => ?_⟩
    · obtain ⟨a, ha⟩ := bij.2 (wcZModPull Dsn j h)
      obtain ⟨ι, hι⟩ : ∃ ι : wcZModProEtExt Y n j →+ wcZModProEtExt ((wcProEtBC g).obj W).left n j,
          ∀ b, ι b = wcZModPull D₂ j b := ⟨wcZModPull D₂ j, fun _ => rfl⟩
      obtain ⟨d, hd⟩ : ∃ d : wcZModProEtExt ((wcProEtBC g).obj W).left n j,
          d = h - ι a := ⟨_, rfl⟩
      have h0 : wcZModPull Dsn j d = 0 :=
        (congrArg (wcZModPull Dsn j) hd).trans ((map_sub (wcZModPull Dsn j) h (ι a)).trans
          (sub_eq_zero.mpr (((congrArg (wcZModPull Dsn j) (hι a)).trans (hcomp a).symm).trans ha).symm))
      obtain ⟨V, hV, hzV, hV0⟩ := wc_zmod_wlocal_closed_point_continuity hW.1 hW.2.1 hW.2.2.1
        (Limits.pullback.fst W.hom g) hQC hQS n j z hz Dsn hDsn d h0
      refine ⟨a, V, hV, hzV, ?_⟩
      have h1 : e V hV d = 0 :=
        (he _ _ _).trans ((G0 _ _ _ (hχdef V hV) _).trans hV0)
      have h2 : e V hV h - e V hV (ι a) = 0 :=
        (map_sub (e V hV) h (ι a)).symm.trans ((congrArg (e V hV) hd).symm.trans h1)
      exact (sub_eq_zero.mp h2).trans (congrArg (e V hV) (hι a))
    · apply bij.1
      exact (hcomp a).trans ((hkill V hV hzV (wcZModPull D₂ j a)).symm.trans
        ((congrArg (wcZModPull Dsn j) h0).trans ((map_zero _).trans (map_zero _).symm)))

  have hZ : ∀ x : W.left, ∃ z ∈ {x : W.left | IsClosed ({x} : Set W.left)}, x ⤳ z := by
    intro x
    obtain ⟨y, hy, _⟩ := hW.2.2.1 x
    exact ⟨y, hy.1, hy.2⟩
  obtain ⟨Ξ, hΞ⟩ := wc_lc_clopen_assembly e he1 hei heu (wcZModPull D₂ j)
    {x : W.left | IsClosed ({x} : Set W.left)} hZ (fun z hz => (hgerm z hz).1) (fun z hz => (hgerm z hz).2)
  refine ⟨Ξ, fun V _ hV a => ?_⟩
  have hfun : χ V hV =
      ((LocallyConstant.ofIsClopen hV).map (fun i : Fin 2 =>
          if i = 0 then (1 : ULift.{u+1} (ZMod n)) else 0)).toContinuousMap.comp
        (Limits.pullback.fst W.hom g).base.hom := by
    apply ContinuousMap.ext
    intro x
    rw [hχ]
    show _ = (fun i : Fin 2 => if i = 0 then (1 : ULift.{u+1} (ZMod n)) else 0)
      ((LocallyConstant.ofIsClopen hV) ((Limits.pullback.fst W.hom g).base.hom x))
    by_cases hx : (Limits.pullback.fst W.hom g).base.hom x ∈ V
    · have h0 : (LocallyConstant.ofIsClopen hV) ((Limits.pullback.fst W.hom g).base.hom x) = 0 := by
        have := LocallyConstant.ofIsClopen_fiber_zero hV
        rw [Set.ext_iff] at this
        exact (this _).mpr hx
      rw [Set.indicator_of_mem hx, h0]
      simp
    · have h1 : (LocallyConstant.ofIsClopen hV) ((Limits.pullback.fst W.hom g).base.hom x) = 1 := by
        have := LocallyConstant.ofIsClopen_fiber_one hV
        rw [Set.ext_iff] at this
        exact (this _).mpr hx
      rw [Set.indicator_of_notMem hx, h1]
      simp
  exact (hΞ V hV a).trans ((he _ _ _).trans (G0 _ _ _ hfun _))

theorem wc_punct_bundle_open_isPullback (F : Type u) [Field F] (d : ℕ) {U : Scheme.{u}}
    (qU : U ⟶ Spec (.of (AlgebraicClosure F)))
    (OU : (AffineSpace (ULift.{u} (Fin d)) U).Opens)
    (hOU : (OU : Set ↥(AffineSpace (ULift.{u} (Fin d)) U)) =
      (Set.range (AffineSpace.homOfVector (𝟙 U) (0 : ULift.{u} (Fin d) → Γ(U, ⊤))))ᶜ)
    (OK : (wcTlAff F d).Opens) (hOK : (OK : Set ↥(wcTlAff F d)) = (Set.range (wcTlZero F d))ᶜ)
    (prO : OU.toScheme ⟶ OK.toScheme)
    (hprO : prO ≫ OK.ι = OU.ι ≫ AffineSpace.map (ULift.{u} (Fin d)) qU) :
    IsPullback prO (OU.ι ≫ (AffineSpace (ULift.{u} (Fin d)) U ↘ U)) (OK.ι ≫ wcTlStr F d) qU :=
by
  have hcomm : qU ≫ wcTlZero F d =
      AffineSpace.homOfVector (𝟙 U) (0 : ULift.{u} (Fin d) → Γ(U, ⊤)) ≫
        AffineSpace.map (ULift.{u} (Fin d)) qU := by
    apply AffineSpace.hom_ext
    · rw [Category.assoc, Category.assoc, AffineSpace.map_over, ← Category.assoc
        (AffineSpace.homOfVector (𝟙 U) _)]
      simp only [AffineSpace.homOfVector_over, Category.comp_id, Category.id_comp]
    · intro i
      show (qU ≫ AffineSpace.homOfVector (𝟙 (Spec (.of (AlgebraicClosure F))))
          (0 : ULift.{u} (Fin d) → Γ(Spec (.of (AlgebraicClosure F)), ⊤))).appTop _ = _
      simp only [Scheme.Hom.comp_appTop, CommRingCat.comp_apply,
        AffineSpace.homOfVector_appTop_coord, AffineSpace.map_appTop_coord, Pi.zero_apply,
        map_zero]
  have Z : IsPullback (AffineSpace.homOfVector (𝟙 U) (0 : ULift.{u} (Fin d) → Γ(U, ⊤))) qU
      (AffineSpace.map (ULift.{u} (Fin d)) qU) (wcTlZero F d) := by
    have hout : IsPullback qU
        (AffineSpace.homOfVector (𝟙 U) (0 : ULift.{u} (Fin d) → Γ(U, ⊤)) ≫
          AffineSpace (ULift.{u} (Fin d)) U ↘ U)
        (wcTlZero F d ≫ AffineSpace (ULift.{u} (Fin d)) (Spec (.of (AlgebraicClosure F))) ↘
          Spec (.of (AlgebraicClosure F))) qU := by
      show IsPullback qU
        (AffineSpace.homOfVector (𝟙 U) (0 : ULift.{u} (Fin d) → Γ(U, ⊤)) ≫
          AffineSpace (ULift.{u} (Fin d)) U ↘ U)
        (AffineSpace.homOfVector (𝟙 (Spec (.of (AlgebraicClosure F))))
          (0 : ULift.{u} (Fin d) → Γ(Spec (.of (AlgebraicClosure F)), ⊤)) ≫
          AffineSpace (ULift.{u} (Fin d)) (Spec (.of (AlgebraicClosure F))) ↘
          Spec (.of (AlgebraicClosure F))) qU
