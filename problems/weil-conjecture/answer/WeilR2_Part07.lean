    have hUY : (⊤ : Z.Opens) = g' ⁻¹ᵁ (p ⁻¹ᵁ (q ⁻¹ᵁ U)) ⊓ z ⁻¹ᵁ ⊤ := by
      rw [hpre, Scheme.Hom.preimage_top, inf_top_eq]
    have hg : (⊤ : Z.Opens) ≤ g' ⁻¹ᵁ (p ⁻¹ᵁ (q ⁻¹ᵁ U)) := hpre.ge
    have hz : (⊤ : Z.Opens) ≤ z ⁻¹ᵁ ⊤ := (Scheme.Hom.preimage_top z).ge
    haveI := isIso_pushoutSection_of_isAffineOpen H hUST (le_refl (p ⁻¹ᵁ (q ⁻¹ᵁ U))) hUY
      (hU.preimage q) (isAffineOpen_top _) ((hU.preimage q).preimage p)
    have Sq₀ : IsPushout (p.appLE (q ⁻¹ᵁ U) (p ⁻¹ᵁ (q ⁻¹ᵁ U)) le_rfl) (τ.appLE (q ⁻¹ᵁ U) ⊤ hUST)
        (g'.appLE (p ⁻¹ᵁ (q ⁻¹ᵁ U)) ⊤ hg) (z.appLE ⊤ ⊤ hz) :=
      IsPushout.of_iso (IsPushout.of_hasPushout _ _) (Iso.refl _) (Iso.refl _) (Iso.refl _)
        (asIso (pushoutSection H hUST (le_refl _) hUY))
        (by simp) (by simp)
        (by rw [asIso_hom, Iso.refl_hom, Category.id_comp]; exact Limits.pushout.inl_desc _ _ _)
        (by rw [asIso_hom, Iso.refl_hom, Category.id_comp]; exact Limits.pushout.inr_desc _ _ _)
    have Sq₁ : IsPushout (q.app U ≫ p.appLE (q ⁻¹ᵁ U) (p ⁻¹ᵁ (q ⁻¹ᵁ U)) le_rfl)
        (q.app U ≫ τ.appLE (q ⁻¹ᵁ U) ⊤ hUST)
        (g'.appLE (p ⁻¹ᵁ (q ⁻¹ᵁ U)) ⊤ hg) (z.appLE ⊤ ⊤ hz) :=
      IsPushout.of_isColimit
        (Limits.PushoutCocone.isColimitOfEpiComp _ _ (q.app U) Sq₀.cocone Sq₀.isColimit)
    have e1 : (p ≫ q).app U = q.app U ≫ p.appLE (q ⁻¹ᵁ U) (p ⁻¹ᵁ (q ⁻¹ᵁ U)) le_rfl := by
      rw [Scheme.Hom.comp_app, Scheme.Hom.appLE_eq_app]
    have e2 : (τ ≫ q).appLE U ⊤ h = q.app U ≫ τ.appLE (q ⁻¹ᵁ U) ⊤ hUST := by
      rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE]
