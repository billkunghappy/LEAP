  intro P p α hP

  obtain ⟨x', hx', hxc', B', _, _, _, Λ', _, _, W'', φ', a', β, hd', hβ⟩ :=
    wc_hal_shdata_integral_base_change K A s x hx hxc B Λ W' φ a hd A' f hf
  have halg : ∀ (Q : Scheme.{u}) (q : Q ⟶ Limits.pullback (a ≫ wcHalA1Proj s) zb)
      (γ : ZMod ℓ → (Q ⟶ Q)), wcFetTorsor q ℓ γ →
        ∃ σ : Limits.pullback (a ≫ wcHalA1Proj s) zb ⟶ Q, σ ≫ q = 𝟙 _ := by
    intro Q q γ hQ
    have H6 := wc_et_milnor_torsor_normal_generic K ℓ hℓ hℓK A'
      (Spec.map (CommRingCat.ofHom f) ≫ s) x' hx' hxc' B' Λ' W'' φ' a' hd' L jA hjinj hfrac
    have hw1 : (Limits.pullback.fst (a' ≫ wcHalA1Proj (Spec.map (CommRingCat.ofHom f) ≫ s))
          (Spec.map (CommRingCat.ofHom jA)) ≫ β) ≫ (a ≫ wcHalA1Proj s) =
        Limits.pullback.snd (a' ≫ wcHalA1Proj (Spec.map (CommRingCat.ofHom f) ≫ s))
          (Spec.map (CommRingCat.ofHom jA)) ≫ zb := by
      rw [Category.assoc, hβ.w, ← Category.assoc, Limits.pullback.condition, Category.assoc, hzb]
    obtain ⟨u, hu⟩ := hsec (Limits.pullback.lift _ _ hw1) H6 Q q γ hQ
    have hw2 : Limits.pullback.fst (a ≫ wcHalA1Proj s) zb ≫ (a ≫ wcHalA1Proj s) =
