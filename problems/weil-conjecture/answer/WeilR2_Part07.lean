  haveI : Limits.PreservesFiniteColimits L :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits L
  obtain ⟨e⟩ := wc_et_left_adjoint_const_zmod L ⟨ε⟩ m
  obtain ⟨ρ₀, hU, -⟩ := wc_et_adjoint_univ_transport h L ⟨adj⟩
  let r := ρ₀ ((constantSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))
  have hr := hU ((constantSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))
  let ρ : wcEtTransport h ((constantSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))
      ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) :=
    { ρ := fun V O k hk => (e.hom.hom.app (Opposite.op O)).hom.comp (r.ρ V O k hk)
      nat := by
        intro V V' c' O O' d k hk k' hk' hc' x
        show (e.hom.hom.app (Opposite.op O')).hom (r.ρ V' O' k' hk' _) = _
        rw [r.nat V V' c' O O' d k hk k' hk' hc' x]
