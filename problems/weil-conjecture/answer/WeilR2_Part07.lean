    haveI : FaithfulSMul (MvPolynomial (Fin d) K) (FractionRing B) :=
      (faithfulSMul_iff_algebraMap_injective _ _).mpr hPL
    letI : Algebra (FractionRing (MvPolynomial (Fin d) K)) (FractionRing B) :=
