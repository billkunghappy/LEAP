    · intro l
      haveI : Etale (W''.obj l).right.hom := (W''.obj l).right.prop
      apply s6 B' (AlgebraicClosure (Y'.residueField y')) q' (hq'pt _) (W''.obj l).right.hom
      · simp only [Category.assoc]
        rw [hφa' l, hδ₁, hγc]
      · simp only [Category.assoc]
