      hinj F' O (hvan.trans (map_zero _).symm)
    have ha0 : a = 0 := by
      have hli : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology (wcSubX R F'))
          (toSheafify (Scheme.smallEtaleTopology (wcSubX R F'))
            ((Functor.const ((wcSubX R F').Etale)ᵒᵖ).obj
              (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) :=
        Presheaf.isLocallyInjective_toSheafify' _ _
      have hs := hli.equalizerSieve_mem (X := Opposite.op O) a 0 (hη.trans (map_zero _).symm)
      obtain ⟨O', d, o', hd', -⟩ := hpts O _ hs (k' u₂)
      exact hd'
    refine ⟨U₂, c₂ ≫ c₁, u₂, ?_, ?_⟩
    · rw [hcompPt, hu₂, hu₁]
    · rw [e5, hla, ha0]
      have hz : wcConstSec (Spec (.of R)) (ULift.{u+1} (ZMod m)) U₁ 0 = 0 := by
        unfold wcConstSec; exact map_zero _
      rw [hz]
      exact map_zero _
  exact ⟨εK, hεd, hmono, hex0, hexn⟩

theorem wc_et_subring_colimit_resolution : ∀ (R : Type u) [CommRing R] (m : ℕ), ∃ (K : CochainComplex (Sheaf (Scheme.smallEtaleTopology (Spec (.of R))) AddCommGrpCat.{u+1}) ℕ) (εK : (constantSheaf (Scheme.smallEtaleTopology (Spec (.of R))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ⟶ K.X 0) (hεK : εK ≫ K.d 0 1 = 0), Mono εK ∧ (ShortComplex.mk εK (K.d 0 1) hεK).Exact ∧ (∀ n : ℕ, K.ExactAt (n + 1)) ∧ (∀ n k : ℕ, Subsingleton (wcEtExt (Spec (.of R)) (K.X n) (k + 1))) ∧ ∃ (I : ∀ F : Finset R, InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of ↥(Subring.closure (F : Set R))))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) (τ : ∀ (F : Finset R) (n : ℕ), wcEtTransport (Spec.map (CommRingCat.ofHom (Subring.closure (F : Set R)).subtype)) ((I F).cocomplex.X n) (K.X n)), (∀ (F : Finset R) (n : ℕ) (V : (Spec (.of ↥(Subring.closure (F : Set R)))).Etale) (O : (Spec (.of R)).Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ Spec.map (CommRingCat.ofHom (Subring.closure (F : Set R)).subtype)) (x : ((I F).cocomplex.X n).obj.obj (Opposite.op V)), (τ F (n + 1)).ρ V O k hk ((((I F).cocomplex.d n (n + 1)).hom.app (Opposite.op V)).hom x) = ((K.d n (n + 1)).hom.app (Opposite.op O)).hom ((τ F n).ρ V O k hk x)) ∧ ∀ (n : ℕ) (s : (K.X n).obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 (Spec (.of R)))))), ((K.d n (n + 1)).hom.app (Opposite.op (Scheme.Etale.mk (𝟙 (Spec (.of R)))))).hom s = 0 → ∃ (F : Finset R) (c : ((I F).cocomplex.X n).obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 (Spec (.of ↥(Subring.closure (F : Set R)))))))), (((I F).cocomplex.d n (n + 1)).hom.app (Opposite.op (Scheme.Etale.mk (𝟙 (Spec (.of ↥(Subring.closure (F : Set R)))))))).hom c = 0 ∧ (τ F n).ρ (Scheme.Etale.mk (𝟙 (Spec (.of ↥(Subring.closure (F : Set R)))))) (Scheme.Etale.mk (𝟙 (Spec (.of R)))) (Spec.map (CommRingCat.ofHom (Subring.closure (F : Set R)).subtype)) ((Category.comp_id _).trans (Category.id_comp _).symm) c = s :=
by
  intro R _ m
  classical

  obtain ⟨I, e, hcoh, hd, haug⟩ := wc_subring_coherent_injres R m

  choose Kn σ hcone hgen hker huniv using
    fun n : ℕ => wc_subring_colim_sheaf_exists R (fun F => (I F).cocomplex.X n) (e n) (hcoh n)

  have haff := fun n : ℕ => wc_subring_colim_affine_sections R (fun F => (I F).cocomplex.X n)
    (e n) (Kn n) (σ n) (hcoh n) (hcone n) (hgen n) (hker n)
  have hacyc := fun n : ℕ => wc_subring_colim_injective_acyclic R (fun F => (I F).cocomplex.X n)
    (e n) (Kn n) (σ n) (hcoh n) (fun F => (I F).injective n) (hcone n) (haff n)

  have hPT : ∀ {F F' : Finset R} (h : F ⊆ F'), wcSubP R F' ≫ wcSubT R h = wcSubP R F := by
    intro F F' h
    show Spec.map _ ≫ Spec.map _ = Spec.map _
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have e1 : (Subring.closure (F' : Set R)).subtype.comp
        (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h))) =
        (Subring.closure (F : Set R)).subtype := by
      apply RingHom.ext
      intro x
      simp
    rw [e1]

  let σd : ∀ (n : ℕ) (F : Finset R),
      wcEtTransport (wcSubP R F) ((I F).cocomplex.X n) (Kn (n + 1)) := fun n F =>
    { ρ := fun V O k hk => ((σ (n + 1) F).ρ V O k hk).comp
        (((I F).cocomplex.d n (n + 1)).hom.app (Opposite.op V)).hom
      nat := by
        intro V V' c O O' d k hk k' hk' hc x
        have hn : (((I F).cocomplex.d n (n + 1)).hom.app (Opposite.op V')).hom
            ((((I F).cocomplex.X n).obj.map c.op).hom x) =
            (((I F).cocomplex.X (n + 1)).obj.map c.op).hom
              ((((I F).cocomplex.d n (n + 1)).hom.app (Opposite.op V)).hom x) :=
          congrArg (fun φ => AddCommGrpCat.Hom.hom φ x)
            (((I F).cocomplex.d n (n + 1)).hom.naturality c.op)
        exact (congrArg ((σ (n + 1) F).ρ V' O' k' hk') hn).trans
          ((σ (n + 1) F).nat V V' c O O' d k hk k' hk' hc _) }
  have hconed : ∀ n, wcSubCocone R (fun F => (I F).cocomplex.X n) (e n) (Kn (n + 1)) (σd n) := by
    intro n F F' h V O h' hh O₂ k hk x
    exact (hcone (n + 1) F F' h V O h' hh O₂ k hk
        ((((I F).cocomplex.d n (n + 1)).hom.app (Opposite.op V)).hom x)).trans
      (congrArg ((σ (n + 1) F').ρ O O₂ k hk) (hd n F F' h V O h' hh x))
  choose dK hdK using fun n : ℕ => (huniv n (Kn (n + 1)) (σd n) (hconed n)).exists

  let z : ∀ (n : ℕ) (F : Finset R),
      wcEtTransport (wcSubP R F) ((I F).cocomplex.X n) (Kn (n + 1 + 1)) := fun n F =>
    { ρ := fun _ _ _ _ => 0
      nat := by intros; simp }
  have hzc : ∀ n, wcSubCocone R (fun F => (I F).cocomplex.X n) (e n) (Kn (n + 1 + 1)) (z n) := by
    intro n F F' h V O h' hh O₂ k hk x
    rfl
  have hdd : ∀ n, dK n ≫ dK (n + 1) = 0 := by
    intro n
    obtain ⟨φ0, -, hu⟩ := huniv n (Kn (n + 1 + 1)) (z n) (hzc n)
    refine (hu (dK n ≫ dK (n + 1)) ?_).trans (hu 0 ?_).symm
    · intro F V U k hk x
      show ((dK (n + 1)).hom.app (Opposite.op U)).hom
        (((dK n).hom.app (Opposite.op U)).hom ((σ n F).ρ V U k hk x)) = 0
      rw [hdK n F V U k hk x]
      show ((dK (n + 1)).hom.app (Opposite.op U)).hom ((σ (n + 1) F).ρ V U k hk
        ((((I F).cocomplex.d n (n + 1)).hom.app (Opposite.op V)).hom x)) = 0
      rw [hdK (n + 1) F V U k hk]
      show (σ (n + 1 + 1) F).ρ V U k hk
        ((((I F).cocomplex.d (n + 1) (n + 1 + 1)).hom.app (Opposite.op V)).hom
          ((((I F).cocomplex.d n (n + 1)).hom.app (Opposite.op V)).hom x)) = 0
      have h0 : (((I F).cocomplex.d (n + 1) (n + 1 + 1)).hom.app (Opposite.op V)).hom
          ((((I F).cocomplex.d n (n + 1)).hom.app (Opposite.op V)).hom x) = 0 := by
        have := congrArg (fun φ => AddCommGrpCat.Hom.hom (φ.hom.app (Opposite.op V)) x)
          ((I F).cocomplex.d_comp_d n (n + 1) (n + 1 + 1))
        exact this.trans (by simp)
      rw [h0, map_zero]
    · intro F V U k hk x
      show ((0 : Kn n ⟶ Kn (n + 1 + 1)).hom.app (Opposite.op U)).hom ((σ n F).ρ V U k hk x) = 0
      simp
  let K := CochainComplex.of Kn dK hdd
  have hKd : ∀ n, K.d n (n + 1) = dK n := fun n => CochainComplex.of_d _ _ n
  have hσd : ∀ (n : ℕ) (F : Finset R) (V : (wcSubX R F).Etale) (U : (Spec (.of R)).Etale)
      (k : U.left ⟶ V.left) (hk : k ≫ V.hom = U.hom ≫ wcSubP R F)
      (x : ((I F).cocomplex.X n).obj.obj (Opposite.op V)),
      (σ (n + 1) F).ρ V U k hk ((((I F).cocomplex.d n (n + 1)).hom.app (Opposite.op V)).hom x) =
        ((K.d n (n + 1)).hom.app (Opposite.op U)).hom ((σ n F).ρ V U k hk x) := by
    intro n F V U k hk x
    rw [hKd n]
    exact (hdK n F V U k hk x).symm

  obtain ⟨εK, hεK, hmono, hex0, hexn⟩ :=
    wc_subring_colim_resolution_exact R m I e K σ hcoh hd haug hcone hgen hker hσd
  refine ⟨K, εK, hεK, hmono, hex0, hexn, fun n k => hacyc n k, I, fun F n => σ n F,
    fun F n V O k hk x => hσd n F V O k hk x, ?_⟩

  intro n s hs
  have hA0 : IsAffine (Scheme.Etale.mk (𝟙 (wcSubX R ∅))).left :=
    (inferInstance : IsAffine (wcSubX R ∅))
  obtain ⟨hsurj, -⟩ := haff n ∅ (Scheme.Etale.mk (𝟙 (wcSubX R ∅)))
    (Scheme.Etale.mk (𝟙 (Spec (.of R)))) (wcSubP R ∅) hA0 (IsPullback.id_vert (wcSubP R ∅))
  obtain ⟨-, hkerc⟩ := haff (n + 1) ∅ (Scheme.Etale.mk (𝟙 (wcSubX R ∅)))
    (Scheme.Etale.mk (𝟙 (Spec (.of R)))) (wcSubP R ∅) hA0 (IsPullback.id_vert (wcSubP R ∅))
  obtain ⟨F, h, O, kO, hkO, k₁, t, hk1, hpbO, hts⟩ := hsurj s
  have hdt : (σ (n + 1) F).ρ O (Scheme.Etale.mk (𝟙 (Spec (.of R)))) kO hkO
      ((((I F).cocomplex.d n (n + 1)).hom.app (Opposite.op O)).hom t) = 0 := by
    rw [hσd n F O (Scheme.Etale.mk (𝟙 (Spec (.of R)))) kO hkO t, hts]
    exact hs
  obtain ⟨F', h', O', kO', k₂, hk₂, hkO'eq, hk2eq, hpbO', hvan⟩ :=
    hkerc F h O kO hkO k₁ hk1 hpbO _ hdt

  obtain ⟨σ₀, hσ₀1, hσ₀2⟩ : ∃ σ₀ : wcSubX R F ⟶ O.left,
      σ₀ ≫ k₁ = wcSubT R h ∧ σ₀ ≫ O.hom = 𝟙 (wcSubX R F) :=
    ⟨hpbO.lift (wcSubT R h) (𝟙 _) ((Category.comp_id _).trans (Category.id_comp _).symm),
      hpbO.lift_fst _ _ _, hpbO.lift_snd _ _ _⟩
  obtain ⟨σ₀', hσ₀'1, hσ₀'2⟩ : ∃ σ₀' : wcSubX R F' ⟶ O'.left,
      σ₀' ≫ k₂ = wcSubT R h' ≫ σ₀ ∧ σ₀' ≫ O'.hom = 𝟙 (wcSubX R F') :=
    ⟨hpbO'.lift (wcSubT R h' ≫ σ₀) (𝟙 _)
        (by rw [Category.assoc, hσ₀2, Category.comp_id, Category.id_comp]),
      hpbO'.lift_fst _ _ _, hpbO'.lift_snd _ _ _⟩
  have hpF : wcSubP R F ≫ σ₀ = kO :=
    hpbO.hom_ext (by rw [Category.assoc, hσ₀1]; exact (hPT h).trans hk1.symm)
      (by
        rw [Category.assoc, hσ₀2, Category.comp_id]
        exact (hkO.trans (Category.id_comp (wcSubP R F))).symm)
  have hpF' : wcSubP R F' ≫ σ₀' = kO' :=
    hpbO'.hom_ext (by
        rw [Category.assoc, hσ₀'1, ← Category.assoc, hPT h', hpF]
        exact hk2eq.symm)
      (by
        rw [Category.assoc, hσ₀'2, Category.comp_id]
        exact (hkO'eq.trans (Category.id_comp (wcSubP R F'))).symm)
  let c' : Scheme.Etale.mk (𝟙 (wcSubX R F')) ⟶ O' :=
    MorphismProperty.Over.homMk σ₀' hσ₀'2 trivial

  have h0 : (((I F').cocomplex.d n (n + 1)).hom.app (Opposite.op O')).hom
      ((e n F F' h').ρ O O' k₂ hk₂ t) = 0 :=
    (hd n F F' h' O O' k₂ hk₂ t).symm.trans hvan
  have hdc : (((I F').cocomplex.d n (n + 1)).hom.app
      (Opposite.op (Scheme.Etale.mk (𝟙 (wcSubX R F'))))).hom
      ((((I F').cocomplex.X n).obj.map c'.op).hom ((e n F F' h').ρ O O' k₂ hk₂ t)) = 0 := by
    have hnat2 := congrArg (fun φ => AddCommGrpCat.Hom.hom φ ((e n F F' h').ρ O O' k₂ hk₂ t))
      (((I F').cocomplex.d n (n + 1)).hom.naturality c'.op)
    refine hnat2.trans ?_
    show (((I F').cocomplex.X (n + 1)).obj.map c'.op).hom
      ((((I F').cocomplex.d n (n + 1)).hom.app (Opposite.op O')).hom
        ((e n F F' h').ρ O O' k₂ hk₂ t)) = 0
    rw [h0, map_zero]
  refine ⟨F', (((I F').cocomplex.X n).obj.map c'.op).hom ((e n F F' h').ρ O O' k₂ hk₂ t), hdc, ?_⟩
  have key : ∀ (a : (Scheme.Etale.mk (𝟙 (Spec (.of R)))).left ⟶ O.left)
      (ha : a ≫ O.hom = (Scheme.Etale.mk (𝟙 (Spec (.of R)))).hom ≫ wcSubP R F),
      a = kO → (σ n F).ρ O (Scheme.Etale.mk (𝟙 (Spec (.of R)))) a ha t = s := by
    rintro a ha rfl
    exact hts
  have h1 := (σ n F').nat O' (Scheme.Etale.mk (𝟙 (wcSubX R F'))) c'
    (Scheme.Etale.mk (𝟙 (Spec (.of R)))) (Scheme.Etale.mk (𝟙 (Spec (.of R)))) (𝟙 _)
    kO' hkO'eq (wcSubP R F') ((Category.comp_id _).trans (Category.id_comp _).symm)
    (by show wcSubP R F' ≫ σ₀' = 𝟙 _ ≫ kO'; rw [Category.id_comp]; exact hpF')
    ((e n F F' h').ρ O O' k₂ hk₂ t)
  rw [op_id, CategoryTheory.Functor.map_id] at h1
  have h2 := hcone n F F' h' O O' k₂ hk₂ (Scheme.Etale.mk (𝟙 (Spec (.of R)))) kO' hkO'eq t
  exact h1.trans (h2.symm.trans (key _ _ hk2eq))

theorem wc_et_coh_subring_approx_vanishing : ∀ (R : Type u) [CommRing R] (m q : ℕ), (∀ F : Finset R, ∃ (T : Type u) (_ : CommRing T) (j : T →+* R), Function.Injective j ∧ (∀ x ∈ F, x ∈ j.range) ∧ Subsingleton (wcEtCoh (Spec (.of T)) m q)) → Subsingleton (wcEtCoh (Spec (.of R)) m q) :=
by
  intro R _ m q hyp
  haveI := wc_et_enough_injectives (Spec (.of R))
  let J := InjectiveResolution.of ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of R)))
    AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))
  refine (wc_et_coh_subsingleton_iff_injres_cocycles (Spec (.of R)) m q J).mpr ?_
  intro z hz

  obtain ⟨K, εK, hεK, hmono, hex0, hex, hacyc, I, τ, hτ, hdesc⟩ :=
    wc_et_subring_colimit_resolution R m

  obtain ⟨α, hα⟩ := wc_et_acyclic_res_cocycle_comparison (Spec (.of R)) _ K εK hεK hmono hex0 hex
    hacyc J
  obtain ⟨k, b, hk, hzk⟩ := hα q z hz

  obtain ⟨F, c, hc, hck⟩ := hdesc q k hk

  obtain ⟨T, _, j, hj, hF, hT⟩ := hyp F
  have hle : Subring.closure (F : Set R) ≤ j.range :=
    Subring.closure_le.mpr (fun x hx => hF x hx)
  let e : T ≃+* j.range := RingEquiv.ofBijective j.rangeRestrict
    ⟨fun x y hxy => hj (congrArg Subtype.val hxy), j.rangeRestrict_surjective⟩
  let ψ : Subring.closure (F : Set R) →+* T := e.symm.toRingHom.comp (Subring.inclusion hle)
  have hψ : j.comp ψ = (Subring.closure (F : Set R)).subtype := by
    ext x
    show j (e.symm (Subring.inclusion hle x)) = x.val
    have h1 : ((e (e.symm (Subring.inclusion hle x)) : j.range) : R) =
        ((Subring.inclusion hle x : j.range) : R) := by
      rw [RingEquiv.apply_symm_apply]
    exact h1
  have hp : Spec.map (CommRingCat.ofHom j) ≫ Spec.map (CommRingCat.ofHom ψ) =
      Spec.map (CommRingCat.ofHom (Subring.closure (F : Set R)).subtype) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hψ]

  let τ' : ∀ n : ℕ, wcEtTransport (Spec.map (CommRingCat.ofHom (Subring.closure (F : Set R)).subtype))
      ((I F).cocomplex.X n) (J.cocomplex.X n) := fun n =>
    { ρ := fun V O h hh => ((α.f n).hom.app (Opposite.op O)).hom.comp ((τ F n).ρ V O h hh)
      nat := by
        intro V V' c' O O' d h hh h' hh' hc' x
        show ((α.f n).hom.app (Opposite.op O')).hom ((τ F n).ρ V' O' h' hh' _) = _
        rw [(τ F n).nat V V' c' O O' d h hh h' hh' hc' x]
        exact congrArg (fun φ => AddCommGrpCat.Hom.hom φ ((τ F n).ρ V O h hh x))
          ((α.f n).hom.naturality d.op) }
  have hτ' : ∀ (n : ℕ) (V : (Spec (.of ↥(Subring.closure (F : Set R)))).Etale)
      (O : (Spec (.of R)).Etale) (k' : O.left ⟶ V.left)
      (hk' : k' ≫ V.hom = O.hom ≫ Spec.map (CommRingCat.ofHom (Subring.closure (F : Set R)).subtype))
      (x : ((I F).cocomplex.X n).obj.obj (Opposite.op V)),
      (τ' (n + 1)).ρ V O k' hk' ((((I F).cocomplex.d n (n + 1)).hom.app (Opposite.op V)).hom x) =
        ((J.cocomplex.d n (n + 1)).hom.app (Opposite.op O)).hom ((τ' n).ρ V O k' hk' x) := by
    intro n V O k' hk' x
    show ((α.f (n + 1)).hom.app (Opposite.op O)).hom ((τ F (n + 1)).ρ V O k' hk' _) =
      ((J.cocomplex.d n (n + 1)).hom.app (Opposite.op O)).hom
        (((α.f n).hom.app (Opposite.op O)).hom ((τ F n).ρ V O k' hk' x))
    rw [hτ F n V O k' hk' x]
    exact (congrArg (fun φ => AddCommGrpCat.Hom.hom (φ.hom.app (Opposite.op O))
      ((τ F n).ρ V O k' hk' x)) (α.comm n (n + 1))).symm

  obtain ⟨b', hb'⟩ := wc_et_injres_transport_factor_coboundary (Spec.map (CommRingCat.ofHom j))
    (Spec.map (CommRingCat.ofHom ψ))
    (Spec.map (CommRingCat.ofHom (Subring.closure (F : Set R)).subtype)) hp m q hT (I F) J τ' hτ'
    c hc
  refine ⟨b' + b, ?_⟩
  rw [map_add, hb', hzk]
  congr 1
  show ((α.f q).hom.app _).hom ((τ F q).ρ _ _ _ _ c) = _
  rw [hck]

theorem wc_local_noetherian_of_closed_fg_ideals : ∀ (R : Type u) [CommRing R] [IsLocalRing R], (IsLocalRing.maximalIdeal R).FG → (∀ J : Ideal R, J.FG → ⨅ n : ℕ, (J ⊔ IsLocalRing.maximalIdeal R ^ n) = J) → IsNoetherianRing R :=
by
  intro R _ _ hmFG hclosed
  classical

  have s1 : ∀ (M : Ideal R) (r : ℕ) (x : Fin r → R), (∀ i, x i ∈ M) →
      ∀ (n : ℕ) (G : MvPolynomial (Fin r) R), G.IsHomogeneous n →
        MvPolynomial.aeval x G ∈ M ^ n := by
    intro M r x hx n G hG
    rw [G.as_sum, map_sum]
    refine Ideal.sum_mem _ (fun d hd => ?_)
    rw [MvPolynomial.aeval_monomial]
    apply Ideal.mul_mem_left
    have hdeg : (∑ i ∈ d.support, d i) = n := by
      have := hG (MvPolynomial.mem_support_iff.mp hd)
      rw [← this, Finsupp.weight_apply]
      simp [Finsupp.sum]
    rw [Finsupp.prod, ← hdeg, ← Finset.prod_pow_eq_pow_sum]
    exact Ideal.prod_mem_prod (fun i _ => Ideal.pow_mem_pow (hx i) _)

  have s2 : ∀ (M : Ideal R) (r : ℕ) (x : Fin r → R), Ideal.span (Set.range x) = M →
      ∀ (n : ℕ) (w : R), w ∈ M ^ n → ∃ G : MvPolynomial (Fin r) R, G.IsHomogeneous n ∧
        MvPolynomial.aeval x G = w := by
    intro M r x hspan n
    induction n with
    | zero =>
      intro w _
      exact ⟨MvPolynomial.C w, MvPolynomial.isHomogeneous_C _ _, MvPolynomial.aeval_C _ _⟩
    | succ n ih =>
      intro w hw
      rw [pow_succ] at hw
      let N : Ideal R := Submodule.map (MvPolynomial.aeval x).toLinearMap
        (MvPolynomial.homogeneousSubmodule (Fin r) R (n+1))
      suffices h : M ^ n * M ≤ N by
        obtain ⟨G, hG, hGw⟩ := (Submodule.mem_map).mp (h hw)
        exact ⟨G, (MvPolynomial.mem_homogeneousSubmodule _ _).mp hG, hGw⟩
      rw [Ideal.mul_le]
      intro u hu v hv
      obtain ⟨G, hG, rfl⟩ := ih u hu
      rw [← hspan, Ideal.mem_span_range_iff_exists_fun] at hv
      obtain ⟨c, rfl⟩ := hv
      refine Submodule.mem_map.mpr ⟨G * ∑ i, MvPolynomial.C (c i) * MvPolynomial.X i, ?_, ?_⟩
      · rw [MvPolynomial.mem_homogeneousSubmodule]
        apply hG.mul
        apply MvPolynomial.IsHomogeneous.sum
        intro i _
        exact MvPolynomial.isHomogeneous_C_mul_X _ _
      · simp [map_sum]

  have s3 : ∀ (r : ℕ) (c H : MvPolynomial (Fin r) R) (d n : ℕ), H.IsHomogeneous d →
      MvPolynomial.homogeneousComponent n (c * H) =
        if d ≤ n then MvPolynomial.homogeneousComponent (n - d) c * H else 0 := by
    intro r c H d n hH
    induction c using MvPolynomial.induction_on' with
    | monomial e a =>
      have hm : (MvPolynomial.monomial e a : MvPolynomial (Fin r) R).IsHomogeneous
          (∑ i ∈ e.support, e i) := MvPolynomial.isHomogeneous_monomial _ rfl
      have h1 := hm.mul hH
      rw [MvPolynomial.homogeneousComponent_of_mem
        ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr h1),
        MvPolynomial.homogeneousComponent_of_mem
        ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr hm)]
      by_cases hdn : d ≤ n
      · rw [if_pos hdn]
        by_cases he : n - d = ∑ i ∈ e.support, e i
        · rw [if_pos he, if_pos (show n = ∑ i ∈ e.support, e i + d by omega)]
        · rw [if_neg he, if_neg (show ¬ n = ∑ i ∈ e.support, e i + d by omega), zero_mul]
      · rw [if_neg hdn, if_neg (show ¬ n = ∑ i ∈ e.support, e i + d by omega)]
    | add p q hp hq =>
      rw [add_mul, map_add, hp, hq]
      split_ifs <;> simp [add_mul]

  have s4 : ∀ (M I : Ideal R) (r : ℕ) (x : Fin r → R),
      (∀ (n : ℕ) (G : MvPolynomial (Fin r) R), G.IsHomogeneous n →
        MvPolynomial.aeval x G ∈ M ^ n) →
      ∃ L : Ideal (MvPolynomial (Fin r) R), ∀ G : MvPolynomial (Fin r) R, G ∈ L ↔
        ∀ n : ℕ, MvPolynomial.aeval x (MvPolynomial.homogeneousComponent n G) ∈
          I ⊔ M ^ (n + 1) := by
    intro M I r x h1
    refine ⟨{ carrier := {G | ∀ n : ℕ,
                MvPolynomial.aeval x (MvPolynomial.homogeneousComponent n G) ∈ I ⊔ M ^ (n + 1)}
              add_mem' := ?_, zero_mem' := ?_, smul_mem' := ?_ }, fun G => Iff.rfl⟩
    · intro a b ha hb n
      simp only [Set.mem_setOf_eq, map_add] at *
      exact Ideal.add_mem _ (ha n) (hb n)
    · intro n
      simp
    · intro c G hG n
      simp only [Set.mem_setOf_eq, smul_eq_mul] at *
      have hc := MvPolynomial.sum_homogeneousComponent c
      rw [← hc, Finset.sum_mul, map_sum, map_sum]
      refine Ideal.sum_mem _ (fun a _ => ?_)
      rw [mul_comm, s3 r G _ a n (MvPolynomial.homogeneousComponent_isHomogeneous a c)]
      split_ifs with ha
      · rw [map_mul]
        have hm : (I ⊔ M ^ (n - a + 1)) * M ^ a ≤ I ⊔ M ^ (n + 1) := by
          rw [Ideal.sup_mul]
          apply sup_le_sup (Ideal.mul_le_inf.trans inf_le_left)
          rw [← pow_add]
          apply le_of_eq
          congr 1
          omega
        exact hm (Ideal.mul_mem_mul (hG (n - a))
          (h1 a _ (MvPolynomial.homogeneousComponent_isHomogeneous a c)))
      · simp

  have s5 : ∀ (M : Ideal R), M.IsMaximal → ∀ (r : ℕ) (L : Ideal (MvPolynomial (Fin r) R)),
      ∃ S : Finset (MvPolynomial (Fin r) R), (∀ s ∈ S, s ∈ L) ∧
        L ≤ Ideal.span (↑S : Set (MvPolynomial (Fin r) R)) ⊔ Ideal.map MvPolynomial.C M := by
    intro M hM r L
    letI := Ideal.Quotient.field M
    let π : MvPolynomial (Fin r) R →+* MvPolynomial (Fin r) (R ⧸ M) :=
      MvPolynomial.map (Ideal.Quotient.mk M)
    have hπ : Function.Surjective π :=
      MvPolynomial.map_surjective _ Ideal.Quotient.mk_surjective
    obtain ⟨T, hT⟩ := IsNoetherian.noetherian (Ideal.map π L)
    have hTL : ∀ t ∈ T, ∃ l ∈ L, π l = t := by
      intro t ht
      have : t ∈ Ideal.map π L := by
        rw [← hT]
        exact Submodule.subset_span ht
      exact (Ideal.mem_map_iff_of_surjective π hπ).mp this
    choose! ℓ hℓL hℓπ using hTL
    refine ⟨T.image ℓ, ?_, ?_⟩
    · intro s hs
      obtain ⟨t, ht, rfl⟩ := Finset.mem_image.mp hs
      exact hℓL t ht
    · intro G hG
      have hle : Ideal.map π L ≤ Ideal.map π (Ideal.span (↑(T.image ℓ) : Set _)) := by
        rw [← hT]
        rw [Submodule.span_le]
        intro t ht
        rw [← hℓπ t ht]
        exact Ideal.mem_map_of_mem π (Ideal.subset_span (Finset.mem_image_of_mem ℓ ht))
      obtain ⟨G', hG', hG'π⟩ :=
        (Ideal.mem_map_iff_of_surjective π hπ).mp (hle (Ideal.mem_map_of_mem π hG))
      have hker : G - G' ∈ Ideal.map MvPolynomial.C M := by
        have : G - G' ∈ RingHom.ker π := by
          rw [RingHom.mem_ker, map_sub, hG'π, sub_self]
        rwa [MvPolynomial.ker_map, Ideal.mk_ker] at this
      have e : G = G' + (G - G') := by ring
      rw [e]
      exact Submodule.add_mem_sup hG' hker

  have s6 : ∀ (M I J : Ideal R) (r : ℕ) (x : Fin r → R)
      (S : Finset (MvPolynomial (Fin r) R)) (LJ : Ideal (MvPolynomial (Fin r) R)),
      (∀ (n : ℕ) (w : R), w ∈ M ^ n → ∃ G : MvPolynomial (Fin r) R, G.IsHomogeneous n ∧
        MvPolynomial.aeval x G = w) →
      (∀ G : MvPolynomial (Fin r) R, G ∈ LJ ↔ ∀ n : ℕ,
        MvPolynomial.aeval x (MvPolynomial.homogeneousComponent n G) ∈ J ⊔ M ^ (n + 1)) →
      J ≤ I →
      (∀ s ∈ S, ∀ k : ℕ,
        MvPolynomial.aeval x (MvPolynomial.homogeneousComponent k s) ∈ J ⊔ M ^ (k + 1)) →
      (∀ G : MvPolynomial (Fin r) R, (∀ n : ℕ,
        MvPolynomial.aeval x (MvPolynomial.homogeneousComponent n G) ∈ I ⊔ M ^ (n + 1)) →
        ∃ G' ∈ Ideal.span (↑S : Set (MvPolynomial (Fin r) R)), ∀ n : ℕ,
          MvPolynomial.aeval x (MvPolynomial.homogeneousComponent n (G - G')) ∈ M ^ (n + 1)) →
      ∀ n : ℕ, I ≤ J ⊔ M ^ n := by
    intro M I J r x S LJ hpow hLJ hJI hS hdec
    have hSL : Ideal.span (↑S : Set (MvPolynomial (Fin r) R)) ≤ LJ := by
      rw [Ideal.span_le]
      intro s hs
      exact (hLJ s).mpr (hS s hs)
    have P : ∀ n : ℕ, I ≤ J ⊔ (I ⊓ M ^ n) := by
      intro n
      induction n with
      | zero =>
        rw [pow_zero, Ideal.one_eq_top, inf_top_eq]
        exact le_sup_right
      | succ n ih =>
        intro z hz
        obtain ⟨j, hj, w, hw, rfl⟩ := Submodule.mem_sup.mp (ih hz)
        have hwI : w ∈ I := (Submodule.mem_inf.mp hw).1
        have hwM : w ∈ M ^ n := (Submodule.mem_inf.mp hw).2
        obtain ⟨G, hG, hGw⟩ := hpow n w hwM
        have hcomp : ∀ k, MvPolynomial.homogeneousComponent k G = if k = n then G else 0 :=
          fun k => MvPolynomial.homogeneousComponent_of_mem
            ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr hG)
        obtain ⟨G', hG'S, hG'⟩ := hdec G (by
          intro k
          rw [hcomp k]
          split_ifs with h
          · subst h
            rw [hGw]
            exact Ideal.mem_sup_left hwI
          · rw [map_zero]
            exact zero_mem _)
        have hG'L := (hLJ G').mp (hSL hG'S) n
        have e : MvPolynomial.homogeneousComponent n G =
            MvPolynomial.homogeneousComponent n G' +
              MvPolynomial.homogeneousComponent n (G - G') := by
          rw [← map_add]
          congr 1
          ring
        have hwJ : w ∈ J ⊔ M ^ (n + 1) := by
          have e2 : w = MvPolynomial.aeval x (MvPolynomial.homogeneousComponent n G') +
              MvPolynomial.aeval x (MvPolynomial.homogeneousComponent n (G - G')) := by
            rw [← map_add, ← e, hcomp n, if_pos rfl, hGw]
          rw [e2]
          exact Ideal.add_mem _ hG'L (Ideal.mem_sup_right (hG' n))
        have hw' : w ∈ J ⊔ (I ⊓ M ^ (n + 1)) := by
          have h0 : w ∈ (J ⊔ M ^ (n + 1)) ⊓ I := Submodule.mem_inf.mpr ⟨hwJ, hwI⟩
          rwa [sup_inf_assoc_of_le _ hJI, inf_comm] at h0
        exact Ideal.add_mem _ (Ideal.mem_sup_left hj) hw'
    intro n
    exact (P n).trans (sup_le_sup_left inf_le_right _)

  obtain ⟨r, x, hspan⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hmFG
  have hspan' : Ideal.span (Set.range x) = IsLocalRing.maximalIdeal R := hspan
  have hx : ∀ i, x i ∈ IsLocalRing.maximalIdeal R := fun i => by
    rw [← hspan']
    exact Ideal.subset_span (Set.mem_range_self i)
  have h1 := s1 (IsLocalRing.maximalIdeal R) r x hx
  have hpow := s2 (IsLocalRing.maximalIdeal R) r x hspan'
  rw [isNoetherianRing_iff]
  refine ⟨fun I => ?_⟩
  obtain ⟨LI, hLI⟩ := s4 (IsLocalRing.maximalIdeal R) I r x h1
  obtain ⟨L0, hL0⟩ := s4 (IsLocalRing.maximalIdeal R) ⊥ r x h1
  have hCL0 : Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal R) ≤ L0 := by
    rw [Ideal.map_le_iff_le_comap]
    intro c hc
    rw [Ideal.mem_comap, hL0]
    intro n
    rw [MvPolynomial.homogeneousComponent_of_mem
      ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_C _ c))]
    split_ifs with h
    · subst h
      rw [MvPolynomial.aeval_C]
      apply Ideal.mem_sup_right
      simpa using hc
    · rw [map_zero]
      exact zero_mem _
  obtain ⟨S, hSL, hLS⟩ := s5 (IsLocalRing.maximalIdeal R)
    (IsLocalRing.maximalIdeal.isMaximal R) r LI
  have hy : ∀ s, s ∈ S → ∀ k : ℕ, ∃ y ∈ I, ∃ e ∈ IsLocalRing.maximalIdeal R ^ (k + 1),
      y + e = MvPolynomial.aeval x (MvPolynomial.homogeneousComponent k s) := by
    intro s hs k
    obtain ⟨y, hy, e, he, hye⟩ := Submodule.mem_sup.mp ((hLI s).mp (hSL s hs) k)
    exact ⟨y, hy, e, he, hye⟩
  choose! y hyI hye using hy
  obtain ⟨D, hD⟩ : ∃ D : ℕ, D = S.sup MvPolynomial.totalDegree := ⟨_, rfl⟩
  obtain ⟨T, hT⟩ : ∃ T : Finset R, T = (S ×ˢ Finset.range (D + 1)).image (fun p => y p.1 p.2) :=
    ⟨_, rfl⟩
  have hJI : Ideal.span (↑T : Set R) ≤ I := by
    rw [Ideal.span_le]
    intro z hz
    rw [Finset.mem_coe, hT] at hz
    obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp hz
    exact hyI _ (Finset.mem_product.mp hp).1 _
  have hS : ∀ s ∈ S, ∀ k : ℕ, MvPolynomial.aeval x (MvPolynomial.homogeneousComponent k s) ∈
      Ideal.span (↑T : Set R) ⊔ IsLocalRing.maximalIdeal R ^ (k + 1) := by
    intro s hs k
    by_cases hk : k ≤ D
    · obtain ⟨e, he, hye'⟩ := hye s hs k
      rw [← hye']
      apply Submodule.add_mem_sup _ he
      apply Ideal.subset_span
      rw [Finset.mem_coe, hT]
      have hmem : (s, k) ∈ S ×ˢ Finset.range (D + 1) :=
        Finset.mem_product.mpr ⟨hs, Finset.mem_range.mpr (by omega)⟩
      exact Finset.mem_image_of_mem (fun p : MvPolynomial (Fin r) R × ℕ => y p.1 p.2) hmem
    · rw [MvPolynomial.homogeneousComponent_eq_zero, map_zero]
      · exact zero_mem _
      · have := Finset.le_sup (f := MvPolynomial.totalDegree) hs
        omega
  obtain ⟨LJ, hLJ⟩ := s4 (IsLocalRing.maximalIdeal R) (Ideal.span (↑T : Set R)) r x h1
  have hdec : ∀ G : MvPolynomial (Fin r) R, (∀ n : ℕ,
      MvPolynomial.aeval x (MvPolynomial.homogeneousComponent n G) ∈
        I ⊔ IsLocalRing.maximalIdeal R ^ (n + 1)) →
      ∃ G' ∈ Ideal.span (↑S : Set (MvPolynomial (Fin r) R)), ∀ n : ℕ,
        MvPolynomial.aeval x (MvPolynomial.homogeneousComponent n (G - G')) ∈
          IsLocalRing.maximalIdeal R ^ (n + 1) := by
    intro G hG
    obtain ⟨G', hG', E, hE, rfl⟩ := Submodule.mem_sup.mp (hLS ((hLI G).mpr hG))
    refine ⟨G', hG', fun n => ?_⟩
    have h0 := (hL0 E).mp (hCL0 hE) n
    rw [bot_sup_eq] at h0
    rwa [add_sub_cancel_left]
  have hall := s6 (IsLocalRing.maximalIdeal R) I (Ideal.span (↑T : Set R)) r x S LJ hpow hLJ
    hJI hS hdec
  have hIJ : I ≤ Ideal.span (↑T : Set R) := by
    rw [← hclosed (Ideal.span (↑T : Set R)) ⟨T, rfl⟩]
    exact le_iInf hall
  rw [le_antisymm hIJ hJI]
  exact ⟨T, rfl⟩

theorem wc_indEtale_local_noetherian_approx : ∀ (C R : Type u) [CommRing C] [CommRing R] [IsNoetherianRing C] [IsLocalRing R] (σ : C →+* R), wcIndEtale σ → ∀ F : Finset R, ∃ (R' : Type u) (_ : CommRing R') (_ : IsLocalRing R') (_ : IsNoetherianRing R') (φ : R' →+* R), (∀ x ∈ F, x ∈ φ.range) ∧ Ideal.map φ (IsLocalRing.maximalIdeal R') = IsLocalRing.maximalIdeal R ∧ ∀ I : Ideal R', Ideal.comap φ (Ideal.map φ I) = I :=
by
  intro C R _ _ _ _ σ hσ F
  classical
  letI : Algebra C R := σ.toAlgebra
  have hσ' : ∀ (P : Type u) [CommRing P] [Algebra C P] [Algebra.FinitePresentation C P]
      (h : P →ₐ[C] R), ∃ (E : Type u) (_ : CommRing E) (_ : Algebra C E), Algebra.Etale C E ∧
        ∃ (α : P →ₐ[C] E) (β : E →ₐ[C] R), β.comp α = h := hσ

  have hU : ∀ (E : Type u) [CommRing E] [Algebra C E] [Algebra.Etale C E] (q : Ideal E) [q.IsPrime],
      Ideal.map ((algebraMap E (Localization.AtPrime q)).comp (algebraMap C E))
        (Ideal.comap (algebraMap C E) q) = IsLocalRing.maximalIdeal (Localization.AtPrime q) := by
    intro E _ _ _ q _
    obtain ⟨p, hp⟩ : ∃ p : Ideal C, p = Ideal.comap (algebraMap C E) q := ⟨_, rfl⟩
    haveI : p.IsPrime := hp ▸ Ideal.IsPrime.comap _
    rw [← hp]
    let f := Localization.localRingHom p q (algebraMap C E) hp
    letI : Algebra (Localization.AtPrime p) (Localization.AtPrime q) := f.toAlgebra
    have hf : ∀ c : C, f (algebraMap C (Localization.AtPrime p) c) =
        algebraMap E (Localization.AtPrime q) (algebraMap C E c) :=
      fun c => Localization.localRingHom_to_map p q (algebraMap C E) hp c
    haveI : IsScalarTower C (Localization.AtPrime p) (Localization.AtPrime q) := by
      apply IsScalarTower.of_algebraMap_eq
      intro c
      show algebraMap C (Localization.AtPrime q) c = f (algebraMap C (Localization.AtPrime p) c)
      rw [hf]
      exact IsScalarTower.algebraMap_apply C E (Localization.AtPrime q) c
    haveI : Algebra.FormallyUnramified E (Localization.AtPrime q) :=
      Algebra.FormallyUnramified.of_isLocalization q.primeCompl
    haveI : Algebra.FormallyUnramified C (Localization.AtPrime q) :=
      Algebra.FormallyUnramified.comp C E (Localization.AtPrime q)
    haveI : Algebra.FormallyUnramified (Localization.AtPrime p) (Localization.AtPrime q) :=
      Algebra.FormallyUnramified.localization_base p.primeCompl
    haveI : Algebra.EssFiniteType E (Localization.AtPrime q) :=
      Algebra.EssFiniteType.of_isLocalization _ q.primeCompl
    haveI : Algebra.EssFiniteType C (Localization.AtPrime q) :=
      Algebra.EssFiniteType.comp C E _
    haveI : Algebra.EssFiniteType (Localization.AtPrime p) (Localization.AtPrime q) :=
      Algebra.EssFiniteType.of_comp C _ _
    haveI : IsLocalHom (algebraMap (Localization.AtPrime p) (Localization.AtPrime q)) :=
      Localization.isLocalHom_localRingHom p q (algebraMap C E) hp
    have h1 := Algebra.FormallyUnramified.map_maximalIdeal
      (R := Localization.AtPrime p) (S := Localization.AtPrime q)
    rw [← Localization.AtPrime.map_eq_maximalIdeal (I := p), Ideal.map_map] at h1
    rw [← h1]
    congr 1
    apply RingHom.ext
    intro c
    simp only [RingHom.comp_apply]
    exact (hf c).symm

  have hN6 : Ideal.map σ (Ideal.comap σ (IsLocalRing.maximalIdeal R)) =
      IsLocalRing.maximalIdeal R := by
    apply le_antisymm Ideal.map_comap_le
    intro x hx
    obtain ⟨E₁, _, _, hE₁, α₁, β₁, hαβ⟩ := hσ' (Polynomial C) (Polynomial.aeval x)
    haveI := hE₁
    have hβx : β₁ (α₁ Polynomial.X) = x := by
      have := congrArg (fun g : Polynomial C →ₐ[C] R => g Polynomial.X) hαβ
      simpa using this
    have hB0 : (β₁ : E₁ →+* R).comp (algebraMap C E₁) = σ :=
      RingHom.ext fun c => β₁.commutes c
    obtain ⟨q₁, hq₁⟩ : ∃ q : Ideal E₁, q = Ideal.comap (β₁ : E₁ →+* R) (IsLocalRing.maximalIdeal R) :=
      ⟨_, rfl⟩
    haveI : q₁.IsPrime := hq₁ ▸ Ideal.IsPrime.comap _
    have hmemq : ∀ e, e ∈ q₁ ↔ β₁ e ∈ IsLocalRing.maximalIdeal R := by
      intro e; rw [hq₁, Ideal.mem_comap]; rfl
    have hunit : ∀ s : q₁.primeCompl, IsUnit ((β₁ : E₁ →+* R) s) := by
      intro s
      by_contra h
      exact s.2 ((hmemq s).mpr ((IsLocalRing.mem_maximalIdeal _).mpr h))
    let ψ := IsLocalization.lift (M := q₁.primeCompl) (S := Localization.AtPrime q₁) hunit
    have hψ : ∀ e, ψ (algebraMap E₁ (Localization.AtPrime q₁) e) = β₁ e :=
      fun e => IsLocalization.lift_eq hunit e
    have hcomap : Ideal.comap (algebraMap C E₁) q₁ = Ideal.comap σ (IsLocalRing.maximalIdeal R) := by
      rw [hq₁, Ideal.comap_comap, hB0]
    have hm := hU E₁ q₁
    rw [hcomap] at hm
    have h2 : algebraMap E₁ (Localization.AtPrime q₁) (α₁ Polynomial.X) ∈
        IsLocalRing.maximalIdeal (Localization.AtPrime q₁) :=
      (IsLocalization.AtPrime.to_map_mem_maximal_iff _ q₁ _).mpr ((hmemq _).mpr (hβx ▸ hx))
    rw [← hm] at h2
    have h3 := Ideal.mem_map_of_mem ψ h2
    rw [hψ, Ideal.map_map] at h3
    have hcomp : ψ.comp ((algebraMap E₁ (Localization.AtPrime q₁)).comp (algebraMap C E₁)) = σ := by
      rw [← RingHom.comp_assoc, IsLocalization.lift_comp, hB0]
    rw [hcomp, hβx] at h3
    exact h3

  obtain ⟨E, _, _, hE, α, β, hαβ⟩ :=
    hσ' (MvPolynomial (↥F) C) (MvPolynomial.aeval (fun x : ↥F => (x : R)))
  haveI := hE
  have hβc : ∀ c, β (algebraMap C E c) = σ c := fun c => β.commutes c
  have hB0 : (β : E →+* R).comp (algebraMap C E) = σ := RingHom.ext hβc
  obtain ⟨q, hq⟩ : ∃ q : Ideal E, q = Ideal.comap (β : E →+* R) (IsLocalRing.maximalIdeal R) :=
    ⟨_, rfl⟩
  haveI : q.IsPrime := hq ▸ Ideal.IsPrime.comap _
  haveI : IsNoetherianRing E := Algebra.FiniteType.isNoetherianRing C E
  haveI hnoeth : IsNoetherianRing (Localization.AtPrime q) :=
    IsLocalization.isNoetherianRing q.primeCompl _ inferInstance
  have hmemq : ∀ e, e ∈ q ↔ β e ∈ IsLocalRing.maximalIdeal R := by
    intro e; rw [hq, Ideal.mem_comap]; rfl
  have hunit : ∀ s : q.primeCompl, IsUnit ((β : E →+* R) s) := by
    intro s
    by_contra h
    exact s.2 ((hmemq s).mpr ((IsLocalRing.mem_maximalIdeal _).mpr h))
  let φ := IsLocalization.lift (M := q.primeCompl) (S := Localization.AtPrime q) hunit
  have hφ : ∀ e, φ (algebraMap E (Localization.AtPrime q) e) = β e :=
    fun e => IsLocalization.lift_eq hunit e

  have hrange : ∀ x ∈ F, x ∈ φ.range := by
    intro x hx
    refine ⟨algebraMap E (Localization.AtPrime q) (α (MvPolynomial.X ⟨x, hx⟩)), ?_⟩
    rw [hφ]
    have := congrArg (fun g : MvPolynomial (↥F) C →ₐ[C] R => g (MvPolynomial.X ⟨x, hx⟩)) hαβ
    simpa using this

  haveI hloc : IsLocalHom φ := by
    constructor
    intro y hy
    obtain ⟨⟨e, s⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl y
    have hspec := IsLocalization.mk'_spec (Localization.AtPrime q) e s
    have h1 : φ (IsLocalization.mk' (Localization.AtPrime q) e s) * β s = β e := by
      rw [← hφ, ← hφ, ← map_mul, hspec]
    have h2 : IsUnit (β e) := h1 ▸ hy.mul (hunit s)
    have h3 : e ∈ q.primeCompl := fun he =>
      (IsLocalRing.mem_maximalIdeal _).mp ((hmemq e).mp he) h2
    have h4 : IsUnit (algebraMap E (Localization.AtPrime q) e) :=
      IsLocalization.map_units (Localization.AtPrime q) (⟨e, h3⟩ : q.primeCompl)
    rw [← hspec] at h4
    exact isUnit_of_mul_isUnit_left h4

  have hmax : Ideal.map φ (IsLocalRing.maximalIdeal (Localization.AtPrime q)) =
      IsLocalRing.maximalIdeal R := by
    apply le_antisymm
    · rw [Ideal.map_le_iff_le_comap]
      intro z hz
      rw [Ideal.mem_comap]
      exact (IsLocalRing.mem_maximalIdeal _).mpr
        (fun hu => (IsLocalRing.mem_maximalIdeal _).mp hz (isUnit_of_map_unit φ z hu))
    · rw [← hN6, Ideal.map_le_iff_le_comap]
      intro c hc
      rw [Ideal.mem_comap] at hc ⊢
      have hc' : algebraMap C E c ∈ q := (hmemq _).mpr (by rw [hβc]; exact hc)
      have := Ideal.mem_map_of_mem φ
        ((IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime q) q _).mpr hc')
      rw [hφ, hβc] at this
      exact this

  letI : Algebra E R := (β : E →+* R).toAlgebra
  haveI : IsScalarTower C E R := IsScalarTower.of_algebraMap_eq' hB0.symm
  haveI : Algebra.WeaklyEtale C R := wc_indEtale_weaklyEtale σ hσ
  haveI : Algebra.WeaklyEtale E R := wc_weaklyEtale_cancel C E R inferInstance inferInstance
  haveI : Module.Flat E R := Algebra.WeaklyEtale.flat
  letI : Algebra (Localization.AtPrime q) R := φ.toAlgebra
  haveI : IsScalarTower E (Localization.AtPrime q) R :=
    IsScalarTower.of_algebraMap_eq' (IsLocalization.lift_comp hunit).symm
  haveI : Module.Flat (Localization.AtPrime q) R :=
    (Module.flat_iff_of_isLocalization (Localization.AtPrime q) q.primeCompl R).mpr inferInstance
  haveI : IsLocalHom (algebraMap (Localization.AtPrime q) R) := hloc
  haveI : Module.FaithfullyFlat (Localization.AtPrime q) R :=
    Module.FaithfullyFlat.of_flat_of_isLocalHom
  have hcontr : ∀ I : Ideal (Localization.AtPrime q), Ideal.comap φ (Ideal.map φ I) = I :=
    fun I => Ideal.comap_map_eq_self_of_faithfullyFlat I
  exact ⟨Localization.AtPrime q, inferInstance, inferInstance, hnoeth, φ, hrange, hmax, hcontr⟩

theorem wc_strictly_henselian_noetherian_subring : ∀ (K A : Type u) [Field K] [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (κ : K →+* A) (S : Finset A), ∃ B : Subring A, (∀ a ∈ S, a ∈ B) ∧ (∀ c : K, κ c ∈ B) ∧ ∃ (_ : HenselianLocalRing ↥B), IsSepClosed (IsLocalRing.ResidueField ↥B) ∧ IsNoetherianRing ↥B :=
by
  intro K A _ _ _ hsepA κ S
  classical
  letI : Algebra K A := κ.toAlgebra

  let C : Subalgebra K A := Algebra.adjoin K (↑S : Set A)
  haveI : Algebra.FiniteType K C :=
    (Subalgebra.fg_iff_finiteType C).mp (Subalgebra.fg_adjoin_finset S)
  haveI : IsNoetherianRing C := Algebra.FiniteType.isNoetherianRing K C

  obtain ⟨R, _, σ, ρ, _, hρσ, hHR, hsepR, hρloc, hind⟩ := wc_strict_hull C A hsepA

  have happrox := wc_indEtale_local_noetherian_approx C R σ hind

  have hmFG : (IsLocalRing.maximalIdeal R).FG := by
    obtain ⟨R', _, _, _, φ, -, hmap, -⟩ := happrox ∅
    rw [← hmap]
    exact Ideal.FG.map (IsNoetherian.noetherian _) φ
  have hclosed : ∀ J : Ideal R, J.FG →
      ⨅ n : ℕ, (J ⊔ IsLocalRing.maximalIdeal R ^ n) = J := by
    intro J hJ
    obtain ⟨G₀, hG₀⟩ := hJ
    refine le_antisymm ?_ (le_iInf fun n => le_sup_left)
    intro x hx
    have hx' : ∀ n : ℕ, x ∈ J ⊔ IsLocalRing.maximalIdeal R ^ n :=
      fun n => (Submodule.mem_iInf _).mp hx n
    obtain ⟨R', _, _, _, φ, hrange, hmap, hcomap⟩ := happrox (insert x G₀)
    choose! pre hpre using fun g (hg : g ∈ insert x G₀) => RingHom.mem_range.mp (hrange g hg)
    set J' : Ideal R' := Ideal.span (pre '' (G₀ : Set R)) with hJ'
    have himg : (fun g => φ (pre g)) '' (G₀ : Set R) = (G₀ : Set R) := by
      ext y
      constructor
      · rintro ⟨g, hg, rfl⟩
        show φ (pre g) ∈ (G₀ : Set R)
        rw [hpre g (Finset.mem_insert_of_mem hg)]
        exact hg
      · intro hy
        exact ⟨y, hy, hpre y (Finset.mem_insert_of_mem hy)⟩
    have hJmap : Ideal.map φ J' = J := by
      rw [hJ', Ideal.map_span, Set.image_image, himg]
      exact hG₀
    have hxx : φ (pre x) = x := hpre x (Finset.mem_insert_self _ _)
    have hmem : ∀ n : ℕ, pre x ∈ J' ⊔ IsLocalRing.maximalIdeal R' ^ n := by
      intro n
      rw [← hcomap (J' ⊔ IsLocalRing.maximalIdeal R' ^ n), Ideal.mem_comap,
        Ideal.map_sup, Ideal.map_pow, hmap, hJmap, hxx]
      exact hx' n
    haveI : Module.Finite R' (R' ⧸ J') :=
      Module.Finite.of_surjective (Submodule.mkQ J') (Submodule.mkQ_surjective _)
    have hK := Ideal.iInf_pow_smul_eq_bot_of_isLocalRing (M := R' ⧸ J')
      (IsLocalRing.maximalIdeal R') (Ideal.IsMaximal.ne_top inferInstance)
    have hq : (Submodule.Quotient.mk (pre x) : R' ⧸ J') ∈ (⊥ : Submodule R' (R' ⧸ J')) := by
      rw [← hK, Submodule.mem_iInf]
      intro n
      obtain ⟨j, hj, y, hy, hjy⟩ := Submodule.mem_sup.mp (hmem n)
      have hjz : (Submodule.Quotient.mk j : R' ⧸ J') = 0 := (Submodule.Quotient.mk_eq_zero J').mpr hj
      have hxy : (Submodule.Quotient.mk (pre x) : R' ⧸ J') = y • Submodule.Quotient.mk 1 := by
        rw [← hjy, ← Submodule.Quotient.mk_smul, smul_eq_mul, mul_one, Submodule.Quotient.mk_add,
          hjz, zero_add]
      rw [hxy]
      exact Submodule.smul_mem_smul hy Submodule.mem_top
    rw [Submodule.mem_bot, Submodule.Quotient.mk_eq_zero] at hq
    rw [← hJmap, ← hxx]
    exact Ideal.mem_map_of_mem φ hq

  haveI : IsNoetherianRing R := wc_local_noetherian_of_closed_fg_ideals R hmFG hclosed

  haveI := hHR
  obtain ⟨hHB, -⟩ := wc_hnas_range_henselian R A ρ hρloc
  haveI := hHB
  refine ⟨ρ.range, ?_, ?_, hHB, ?_, isNoetherianRing_range ρ⟩
  · intro a ha
    have haC : a ∈ C := Algebra.subset_adjoin (Finset.mem_coe.mpr ha)
    exact RingHom.mem_range.mpr ⟨σ ⟨a, haC⟩, RingHom.congr_fun hρσ ⟨a, haC⟩⟩
  · intro c
    have hcC : κ c ∈ C := C.algebraMap_mem c
    exact RingHom.mem_range.mpr ⟨σ ⟨κ c, hcC⟩, RingHom.congr_fun hρσ ⟨κ c, hcC⟩⟩
  ·
    let f : R →+* ρ.range := ρ.rangeRestrict
    have hf : Function.Surjective f := ρ.rangeRestrict_surjective
    haveI : IsLocalHom f := IsLocalHom.of_surjective f hf
    let g := IsLocalRing.ResidueField.map f
    have hg : Function.Bijective g := by
      refine ⟨g.injective, ?_⟩
      intro y
      obtain ⟨b, rfl⟩ := IsLocalRing.residue_surjective y
      obtain ⟨r, rfl⟩ := hf b
      exact ⟨IsLocalRing.residue R r, IsLocalRing.ResidueField.map_residue f r⟩
    let e := RingEquiv.ofBijective g hg
    let eR : IsLocalRing.ResidueField R →+* IsLocalRing.ResidueField ρ.range := e.toRingHom
    let eS : IsLocalRing.ResidueField ρ.range →+* IsLocalRing.ResidueField R := e.symm.toRingHom
    have heRS : ∀ c, eR (eS c) = c := fun c => e.apply_symm_apply c
    apply IsSepClosed.of_exists_root
    intro p _ hirr hsep
    obtain ⟨x', hx'⟩ := IsSepClosed.exists_root (p.map eS)
      (by rw [Polynomial.degree_map p eS]
          exact (Polynomial.degree_pos_of_irreducible hirr).ne')
      hsep.map
    refine ⟨eR x', ?_⟩
    have hp : p = (p.map eS).map eR := by
      rw [Polynomial.map_map]
      ext n
      rw [Polynomial.coeff_map, RingHom.comp_apply, heRS]
    rw [hp, Polynomial.eval_map, Polynomial.eval₂_at_apply, hx'.eq_zero, map_zero]

theorem wc_et_affine_line_acyclic_noetherian_reduction : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → (∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] [IsNoetherianRing A] (s : Spec (.of A) ⟶ Spec (.of K)) (q : ℕ), 1 ≤ q → Subsingleton (wcEtCoh (wcHalA1 s) ℓ q)) → ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (s : Spec (.of A) ⟶ Spec (.of K)) (q : ℕ), 1 ≤ q → Subsingleton (wcEtCoh (wcHalA1 s) ℓ q) :=
by
  intro K _ _ ℓ hℓ hℓK HN A _ _ _ s q hq
  classical

  have hs1 : ∀ (A' : Type u) [CommRing A'] (s' : Spec (.of A') ⟶ Spec (.of K)) (m n : ℕ),
      Nonempty (wcEtCoh (wcHalA1 s') m n ≃ wcEtCoh (Spec (.of (Polynomial A'))) m n) := by
    intro A' _ s' m n
    obtain ⟨φ, rfl⟩ : ∃ φ : CommRingCat.of K ⟶ CommRingCat.of A', Spec.map φ = s' :=
      ⟨Spec.preimage s', Spec.map_preimage s'⟩
    letI : Algebra K A' := φ.hom.toAlgebra
    let e : TensorProduct K A' (Polynomial K) ≃+* Polynomial A' := (polyEquivTensor K A').symm.toRingEquiv
    let i : Spec (.of (Polynomial A')) ⟶ wcHalA1 (Spec.map φ) :=
      Spec.map e.toCommRingCatIso.hom ≫ (pullbackSpecIso K A' (Polynomial K)).inv
    haveI : IsIso i := by dsimp only [i]; infer_instance
    exact wc_et_coh_iso_invariance i m n

  let κ : K →+* A := (Spec.preimage s).hom
  have hclaim : ∀ F : Finset (Polynomial A), ∃ (T : Type u) (_ : CommRing T)
      (j : T →+* Polynomial A), Function.Injective j ∧ (∀ x ∈ F, x ∈ j.range) ∧
        Subsingleton (wcEtCoh (Spec (.of T)) ℓ q) := by
    intro F
    obtain ⟨B, hS, hK, hH, hsep, hnoeth⟩ :=
      wc_strictly_henselian_noetherian_subring K A κ (F.biUnion Polynomial.coeffs)
    refine ⟨Polynomial B, inferInstance, Polynomial.mapRingHom B.subtype,
      Polynomial.map_injective _ Subtype.val_injective, ?_, ?_⟩
    · intro p hp
      have hl : p ∈ Polynomial.lifts B.subtype := by
        rw [Polynomial.lifts_iff_coeff_lifts]
        intro n
        by_cases h : p.coeff n = 0
        · rw [h]; exact ⟨0, map_zero _⟩
        · exact ⟨⟨p.coeff n, hS _ (Finset.mem_biUnion.mpr
            ⟨p, hp, Polynomial.coeff_mem_coeffs h⟩)⟩, rfl⟩
      obtain ⟨r, hr⟩ := (Polynomial.mem_lifts p).mp hl
      exact RingHom.mem_range.mpr ⟨r, hr⟩
    · let κB : K →+* B := κ.codRestrict B hK
      haveI := HN B (Spec.map (CommRingCat.ofHom κB)) q hq
      obtain ⟨E⟩ := hs1 B (Spec.map (CommRingCat.ofHom κB)) ℓ q
      exact E.symm.subsingleton

  haveI := wc_et_coh_subring_approx_vanishing (Polynomial A) ℓ q hclaim
  obtain ⟨E⟩ := hs1 A s ℓ q
  exact E.subsingleton

theorem wc_colim_complex_exactAt_of_eval : ∀ {D : Type*} [Category D] [Limits.HasZeroMorphisms D] {J : Type u} [SmallCategory J] [IsFiltered J] (E : D ⥤ (J ⥤ AddCommGrpCat.{u+1})) [E.PreservesZeroMorphisms] (K : CochainComplex D ℕ) (q : ℕ), (∀ j : J, (((E ⋙ (evaluation J AddCommGrpCat.{u+1}).obj j).mapHomologicalComplex (ComplexShape.up ℕ)).obj K).ExactAt q) → (((E ⋙ Limits.colim).mapHomologicalComplex (ComplexShape.up ℕ)).obj K).ExactAt q :=
by
  intro D _ _ J _ _ E _ K q h
  let _inst : Limits.PreservesFilteredColimitsOfSize.{u, u} (forget AddCommGrpCat.{u+1}) :=
    Limits.preservesFilteredColimitsOfSize_shrink.{u, u+1, u, u+1} (forget AddCommGrpCat.{u+1})
  have rep : ∀ (F : J ⥤ AddCommGrpCat.{u+1}) (x : ↑(Limits.colimit F)),
      ∃ (j : J) (y : ↑(F.obj j)), ConcreteCategory.hom (Limits.colimit.ι F j) y = x :=
    fun F x => Limits.Concrete.colimit_exists_rep F x
  have ez : ∀ (F : J ⥤ AddCommGrpCat.{u+1}) (j : J) (y : ↑(F.obj j)),
      ConcreteCategory.hom (Limits.colimit.ι F j) y = 0 →
        ∃ (k : J) (f : j ⟶ k), ConcreteCategory.hom (F.map f) y = 0 := by
    intro F j y hy
    have h0 : ConcreteCategory.hom (Limits.colimit.ι F j) y =
        ConcreteCategory.hom (Limits.colimit.ι F j) 0 := by rw [hy, map_zero]
    obtain ⟨k, f, g, hfg⟩ := (Limits.Concrete.colimit_rep_eq_iff_exists F y 0).mp h0
    exact ⟨k, f, by rw [hfg, map_zero]⟩
  set i := (ComplexShape.up ℕ).prev q with hi
  set k := (ComplexShape.up ℕ).next q with hk
  set F₁ := E.obj (K.X i) with hF₁
  set F₂ := E.obj (K.X q) with hF₂
  set F₃ := E.obj (K.X k) with hF₃
  set α : F₁ ⟶ F₂ := E.map (K.d i q) with hα
  set β : F₂ ⟶ F₃ := E.map (K.d q k) with hβ
  have hj : ∀ j, ∀ y : ↑(F₂.obj j), ConcreteCategory.hom (β.app j) y = 0 →
      ∃ z : ↑(F₁.obj j), ConcreteCategory.hom (α.app j) z = y := by
    intro j y hy
    have hh := h j
    rw [HomologicalComplex.exactAt_iff, ShortComplex.ab_exact_iff] at hh
    exact hh y hy
  rw [HomologicalComplex.exactAt_iff, ShortComplex.ab_exact_iff]
  intro x hx
  change ↑(Limits.colimit F₂) at x
  change ConcreteCategory.hom (Limits.colimMap β) x = 0 at hx
  change ∃ w : ↑(Limits.colimit F₁), ConcreteCategory.hom (Limits.colimMap α) w = x
  obtain ⟨j, y, rfl⟩ := rep F₂ x
  have h1 : ConcreteCategory.hom (Limits.colimit.ι F₃ j) (ConcreteCategory.hom (β.app j) y) = 0 := by
    rw [← Limits.colimit.ι_map_apply]; exact hx
  obtain ⟨k', t, ht⟩ := ez F₃ j _ h1
  obtain ⟨z, hz⟩ := hj k' (ConcreteCategory.hom (F₂.map t) y) (by
    rw [NatTrans.naturality_apply]; exact ht)
  refine ⟨ConcreteCategory.hom (Limits.colimit.ι F₁ k') z, ?_⟩
  rw [Limits.colimit.ι_map_apply, hz, Limits.colimit.w_apply]

theorem wc_et_limit_push_homology_level : ∀ {X B : Scheme.{u}} (g : X ⟶ B) [IsAffineHom g] (V : B.Etale), IsAffine V.left → ∀ (m : ℕ) (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) (q : ℕ), Nonempty ((((sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⋙ (Functor.whiskeringLeft (B.Etale)ᵒᵖ (X.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj (@Functor.op B.Etale _ X.Etale _ (wcEtBaseChange g)) ⋙ (evaluation (B.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op V)).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q ≃ wcEtCoh (Limits.pullback g V.hom) m q) :=
by
  classical
  intro X B g _ V hV m I q
  haveI : IsAffine V.left := hV

  let W₁ : Discrete PUnit.{u+1} ⥤ B.Etale := (Functor.const (Discrete PUnit.{u+1})).obj V

  have hterm : Limits.IsTerminal (Opposite.op (⟨PUnit.unit⟩ : Discrete PUnit.{u+1})) :=
    Limits.IsTerminal.ofUniqueHom
      (fun Y => (eqToHom (Discrete.ext (Subsingleton.elim _ _)) :
        (⟨PUnit.unit⟩ : Discrete PUnit.{u+1}) ⟶ Y.unop).op)
      (fun Y f => Quiver.Hom.unop_inj (Subsingleton.elim _ _))
  let ν : ((Functor.whiskeringLeft (Discrete PUnit.{u+1})ᵒᵖ (B.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj
      W₁.op ⋙ Limits.colim) ≅ (evaluation (B.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op V) :=
    NatIso.ofComponents
      (fun P => haveI := Limits.isIso_ι_of_isTerminal hterm (W₁.op ⋙ P)
        (asIso (Limits.colimit.ι (W₁.op ⋙ P) (Opposite.op ⟨PUnit.unit⟩))).symm)
      (by
        intro P P' α
        simp only [Functor.comp_map, Functor.whiskeringLeft_obj_map, Limits.colim_map,
          Iso.symm_hom, asIso_inv, evaluation_obj_map]
        rw [IsIso.eq_inv_comp, ← Category.assoc, Limits.ι_colimMap, Category.assoc]
        erw [IsIso.hom_inv_id, Category.comp_id]
        rfl)

  let Φ := Functor.isoWhiskerLeft (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
    (Functor.isoWhiskerLeft ((Functor.whiskeringLeft (B.Etale)ᵒᵖ (X.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj
      (@Functor.op B.Etale _ X.Etale _ (wcEtBaseChange g))) ν)
  let κ := (NatIso.mapHomologicalComplex Φ (ComplexShape.up ℕ)).app I.cocomplex
  let N₁ := (HomologicalComplex.homologyMapIso κ q).addCommGroupIsoToAddEquiv.toEquiv

  let a₁ : Spec (.of ↑Γ(V.left, ⊤)) ⟶ B := V.left.isoSpec.inv ≫ V.hom
  obtain ⟨N₀⟩ := wc_et_limit_push_homology_affine g (↑Γ(V.left, ⊤)) (Discrete PUnit.{u+1}) W₁
    (fun _ => V.left.isoSpec.inv) a₁ (fun _ => hV)
    (by
      intro l l' t
      show V.left.isoSpec.inv ≫ (𝟙 V : V ⟶ V).left = V.left.isoSpec.inv
      exact Category.comp_id _)
    (fun _ => rfl)
    (by
      intro T z hz
      refine ⟨z ⟨PUnit.unit⟩ ≫ V.left.isoSpec.hom, ?_, ?_⟩
      · intro l
        rcases l with ⟨⟨⟩⟩
        show (z ⟨PUnit.unit⟩ ≫ V.left.isoSpec.hom) ≫ V.left.isoSpec.inv = z ⟨PUnit.unit⟩
        simp
      · intro y hy
        have h := hy ⟨PUnit.unit⟩
        change y ≫ V.left.isoSpec.inv = z ⟨PUnit.unit⟩ at h
        rw [← h]
        simp)
    m I q

  let i : Limits.pullback g V.hom ⟶ Limits.pullback g a₁ :=
    Limits.pullback.map g V.hom g a₁ (𝟙 X) V.left.isoSpec.hom (𝟙 B) (by simp) (by simp [a₁])
  haveI : IsIso i := by
    dsimp only [i]
    infer_instance
  obtain ⟨N₂⟩ := wc_et_coh_iso_invariance i m q

  exact ⟨N₁.symm.trans (N₀.trans N₂)⟩

theorem wc_hal_a1_iso_polynomial : ∀ (K Ω : Type u) [Field K] [Field Ω] (t₀ : Spec (.of Ω) ⟶ Spec (.of K)), Nonempty (wcHalA1 t₀ ≅ Spec (.of (Polynomial Ω))) :=
by
  intro K Ω _ _ t₀
  obtain ⟨φ, rfl⟩ : ∃ φ : CommRingCat.of K ⟶ CommRingCat.of Ω, Spec.map φ = t₀ :=
    ⟨Spec.preimage t₀, Spec.map_preimage t₀⟩
  letI : Algebra K Ω := φ.hom.toAlgebra
  have hφ : Spec.map (CommRingCat.ofHom (algebraMap K Ω)) = Spec.map φ :=
    congrArg Spec.map (CommRingCat.hom_ext rfl)
  let e1 : wcHalA1 (Spec.map φ) ≅ Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap K Ω)))
      (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) :=
    Limits.pullback.congrHom hφ.symm rfl
  let e2 := pullbackSpecIso K Ω (Polynomial K)
  let c : CommRingCat.of (Polynomial Ω) ≅ CommRingCat.of (TensorProduct K Ω (Polynomial K)) :=
    (polyEquivTensor K Ω).toRingEquiv.toCommRingCatIso
  let e3 : Spec (.of (TensorProduct K Ω (Polynomial K))) ≅ Spec (.of (Polynomial Ω)) :=
    { hom := Spec.map c.hom
      inv := Spec.map c.inv
      hom_inv_id := by rw [← Spec.map_comp, c.inv_hom_id, Spec.map_id]
      inv_hom_id := by rw [← Spec.map_comp, c.hom_inv_id, Spec.map_id] }
  exact ⟨e1 ≪≫ e2 ≪≫ e3⟩

theorem wc_etale_affine_over_line_finite : ∀ (Ω : Type u) [Field Ω] (V : Scheme.{u}) [IsAffine V] (e : V ⟶ Spec (.of (Polynomial Ω))), Etale e → ∃ π : V ⟶ Spec (.of (Polynomial Ω)), IsFinite π :=
by
  intro Ω _ V _ e he

  have s3 : ∀ (B : Type u) [CommRing B] (φ : Polynomial Ω →+* B), φ.Etale →
      ∀ (Q₀ Q₁ Q₂ : Ideal B), Q₀.IsPrime → Q₁.IsPrime → Q₂.IsPrime → Q₀ < Q₁ → Q₁ < Q₂ →
        False := by
    intro B _ φ hφ Q₀ Q₁ Q₂ h0 h1 h2 h01 h12
    letI := φ.toAlgebra
    haveI : Algebra.Etale (Polynomial Ω) B := hφ
    haveI : Algebra.QuasiFinite (Polynomial Ω) B := inferInstance
    have incomp : ∀ (Q Q' : Ideal B), Q.IsPrime → Q'.IsPrime → Q ≤ Q' →
        Q.comap φ = Q'.comap φ → Q = Q' := by
      intro Q Q' hQ hQ' hle hc
      let x : PrimeSpectrum B := ⟨Q, hQ⟩
      let y : PrimeSpectrum B := ⟨Q', hQ'⟩
      have hxy : x ⤳ y := (PrimeSpectrum.le_iff_specializes x y).mp hle
      have hD := Algebra.QuasiFinite.isDiscrete_comap_preimage_singleton (R := Polynomial Ω)
        (S := B) (PrimeSpectrum.comap (algebraMap (Polynomial Ω) B) y)
      have hx : x ∈ PrimeSpectrum.comap (algebraMap (Polynomial Ω) B) ⁻¹'
          {PrimeSpectrum.comap (algebraMap (Polynomial Ω) B) y} := by
        show PrimeSpectrum.comap (algebraMap (Polynomial Ω) B) x =
          PrimeSpectrum.comap (algebraMap (Polynomial Ω) B) y
        ext1
        exact hc
      have := hD.eq_of_specializes hxy hx rfl
      exact congrArg PrimeSpectrum.asIdeal this
    have hr : Q₀.comap φ = Q₁.comap φ ∨ Q₁.comap φ = Q₂.comap φ := by
      by_cases h : Q₀.comap φ = Q₁.comap φ
      · exact Or.inl h
      · right
        have hne : Q₁.comap φ ≠ ⊥ := by
          intro hb
          apply h
          rw [hb]
          exact le_bot_iff.mp (hb ▸ Ideal.comap_mono h01.le)
        haveI : (Q₁.comap φ).IsPrime := Ideal.comap_isPrime φ Q₁
        have hmax := Ideal.IsPrime.isMaximal (inferInstance : (Q₁.comap φ).IsPrime) hne
        exact hmax.eq_of_le (Ideal.comap_isPrime φ Q₂).ne_top (Ideal.comap_mono h12.le)
    rcases hr with h | h
    · exact h01.ne (incomp _ _ h0 h1 h01.le h)
    · exact h12.ne (incomp _ _ h1 h2 h12.le h)

  have s5 : ∀ (B : Type u) [CommRing B] [Algebra Ω B] (s : ℕ)
      (g : MvPolynomial (Fin s) Ω →ₐ[Ω] B), Function.Injective g → g.Finite →
      (∀ (Q₀ Q₁ Q₂ : Ideal B), Q₀.IsPrime → Q₁.IsPrime → Q₂.IsPrime → Q₀ < Q₁ → Q₁ < Q₂ →
        False) → s ≤ 1 := by
    intro B _ _ s g hinj hfin NC
    by_contra hs
    push_neg at hs
    obtain ⟨i0, i1, hi01⟩ : ∃ i0 i1 : Fin s, i1 ≠ i0 :=
      ⟨⟨0, by omega⟩, ⟨1, by omega⟩, fun h => by simp [Fin.ext_iff] at h⟩
    obtain ⟨a₁, ha₁0, ha₁1⟩ : ∃ a₁ : MvPolynomial (Fin s) Ω →ₐ[Ω] MvPolynomial (Fin s) Ω,
        a₁ (MvPolynomial.X i0) = 0 ∧ ∀ i, i ≠ i0 → a₁ (MvPolynomial.X i) = MvPolynomial.X i := by
      refine ⟨MvPolynomial.aeval (fun i => if i = i0 then 0 else MvPolynomial.X i), ?_, ?_⟩
      · rw [MvPolynomial.aeval_X]; simp
      · intro i hi; rw [MvPolynomial.aeval_X]; simp [hi]
    obtain ⟨a₂, ha₂0, ha₂1⟩ : ∃ a₂ : MvPolynomial (Fin s) Ω →ₐ[Ω] MvPolynomial (Fin s) Ω,
        a₂ (MvPolynomial.X i0) = 0 ∧ a₂ (MvPolynomial.X i1) = 0 := by
      refine ⟨MvPolynomial.aeval
        (fun i => if i = i0 ∨ i = i1 then 0 else MvPolynomial.X i), ?_, ?_⟩
      · rw [MvPolynomial.aeval_X]; simp
      · rw [MvPolynomial.aeval_X]; simp
    have hcomp : a₂.comp a₁ = a₂ := by
      apply MvPolynomial.algHom_ext
      intro i
      rw [AlgHom.comp_apply]
      by_cases h : i = i0
      · subst h; rw [ha₁0, map_zero, ha₂0]
      · rw [ha₁1 i h]
    let p₀ : Ideal (MvPolynomial (Fin s) Ω) := ⊥
    let p₁ : Ideal (MvPolynomial (Fin s) Ω) := RingHom.ker a₁
    let p₂ : Ideal (MvPolynomial (Fin s) Ω) := RingHom.ker a₂
    have hp₀ : p₀.IsPrime := Ideal.isPrime_bot
    have hp₁ : p₁.IsPrime := RingHom.ker_isPrime _
    have hp₂ : p₂.IsPrime := RingHom.ker_isPrime _
    have hX0 : (MvPolynomial.X i0 : MvPolynomial (Fin s) Ω) ∈ p₁ := by
      show a₁ (MvPolynomial.X i0) = 0
      exact ha₁0
    have hX0' : (MvPolynomial.X i0 : MvPolynomial (Fin s) Ω) ∉ p₀ := by
      show ¬ (MvPolynomial.X i0 : MvPolynomial (Fin s) Ω) ∈ (⊥ : Ideal _)
      rw [Ideal.mem_bot]
      exact MvPolynomial.X_ne_zero i0
    have hX1 : (MvPolynomial.X i1 : MvPolynomial (Fin s) Ω) ∈ p₂ := by
      show a₂ (MvPolynomial.X i1) = 0
      exact ha₂1
    have hX1' : (MvPolynomial.X i1 : MvPolynomial (Fin s) Ω) ∉ p₁ := by
      show ¬ a₁ (MvPolynomial.X i1) = 0
      rw [ha₁1 i1 hi01]
      exact MvPolynomial.X_ne_zero i1
    have h12le : p₁ ≤ p₂ := by
      intro x hx
      have hx' : a₁ x = 0 := hx
      show a₂ x = 0
      rw [← hcomp, AlgHom.comp_apply, hx', map_zero]
    have h01 : p₀ < p₁ := lt_of_le_of_ne bot_le (fun h => hX0' (h ▸ hX0))
    have h12 : p₁ < p₂ := lt_of_le_of_ne h12le (fun h => hX1' (h ▸ hX1))
    letI : Algebra (MvPolynomial (Fin s) Ω) B := g.toRingHom.toAlgebra
    haveI : Algebra.IsIntegral (MvPolynomial (Fin s) Ω) B :=
      ⟨fun x => (RingHom.Finite.to_isIntegral hfin) x⟩
    obtain ⟨Q₀, -, hQ₀, hQ₀c⟩ :=
      Ideal.exists_ideal_over_prime_of_isIntegral p₀ (⊥ : Ideal B) (by
        intro x hx
        simp only [Ideal.mem_comap, Ideal.mem_bot] at hx
        show x = 0
        apply hinj
        rw [map_zero]
        exact hx)
    obtain ⟨Q₁, hQ01, hQ₁, hQ₁c⟩ := Ideal.exists_ideal_over_prime_of_isIntegral p₁ Q₀ (by
      rw [hQ₀c]; exact h01.le)
    obtain ⟨Q₂, hQ12, hQ₂, hQ₂c⟩ := Ideal.exists_ideal_over_prime_of_isIntegral p₂ Q₁ (by
      rw [hQ₁c]; exact h12.le)
    refine NC Q₀ Q₁ Q₂ hQ₀ hQ₁ hQ₂ (lt_of_le_of_ne hQ01 ?_) (lt_of_le_of_ne hQ12 ?_)
    · intro h; apply h01.ne; rw [← hQ₀c, ← hQ₁c, h]
    · intro h; apply h12.ne; rw [← hQ₁c, ← hQ₂c, h]

  have s6 : ∀ (B : Type u) [CommRing B] [Algebra Ω B] (s : ℕ)
      (g : MvPolynomial (Fin s) Ω →ₐ[Ω] B), g.Finite → s ≤ 1 →
      ∃ ψ : Polynomial Ω →+* B, ψ.Finite := by
    intro B _ _ s g hfin hs
    rcases Nat.le_one_iff_eq_zero_or_eq_one.mp hs with rfl | rfl
    · have hC : (g.toRingHom.comp (MvPolynomial.C : Ω →+* MvPolynomial (Fin 0) Ω)).Finite :=
        RingHom.Finite.comp hfin
          (RingHom.Finite.of_surjective _ (MvPolynomial.C_surjective (Fin 0)))
      have he : (Polynomial.evalRingHom (0 : Ω)).Finite := RingHom.Finite.of_surjective _ (by
        intro a; exact ⟨Polynomial.C a, by simp⟩)
      exact ⟨_, RingHom.Finite.comp hC he⟩
    · let θ : Polynomial Ω ≃ₐ[Ω] MvPolynomial (Fin 1) Ω :=
        (MvPolynomial.uniqueAlgEquiv Ω (Fin 1)).symm
      have hθ : (θ.toRingEquiv.toRingHom).Finite := RingHom.Finite.of_surjective _ θ.surjective
      exact ⟨_, RingHom.Finite.comp hfin hθ⟩

  have hE : RingHom.Etale (e.appTop).hom :=
    (HasRingHomProperty.iff_of_isAffine (P := @Etale)).mp he
  have hι : RingHom.Etale (Scheme.ΓSpecIso (CommRingCat.of (Polynomial Ω))).inv.hom :=
    RingHom.Etale.of_bijective
      ((Scheme.ΓSpecIso (CommRingCat.of (Polynomial Ω))).symm.commRingCatIsoToRingEquiv.bijective)
  let φ : Polynomial Ω →+* Γ(V, ⊤) :=
    (e.appTop).hom.comp (Scheme.ΓSpecIso (CommRingCat.of (Polynomial Ω))).inv.hom
  have hφ : φ.Etale := RingHom.Etale.stableUnderComposition _ _ hι hE

  have key : ∃ ψ : Polynomial Ω →+* Γ(V, ⊤), ψ.Finite := by
    rcases subsingleton_or_nontrivial Γ(V, ⊤) with hsub | hnt
    · refine ⟨φ, ?_⟩
      letI := φ.toAlgebra
      show Module.Finite (Polynomial Ω) Γ(V, ⊤)
      infer_instance
    · have NC := s3 Γ(V, ⊤) φ hφ
      have h1 : φ.FiniteType := by
        letI := φ.toAlgebra
        haveI : Algebra.Etale (Polynomial Ω) Γ(V, ⊤) := hφ
        show Algebra.FiniteType (Polynomial Ω) Γ(V, ⊤)
        infer_instance
      have h2 : (algebraMap Ω (Polynomial Ω)).FiniteType :=
        RingHom.finiteType_algebraMap.mpr inferInstance
      letI : Algebra Ω Γ(V, ⊤) := (φ.comp (algebraMap Ω (Polynomial Ω))).toAlgebra
      haveI hft : Algebra.FiniteType Ω Γ(V, ⊤) := h1.comp h2
      obtain ⟨s, g, hinj, hfin⟩ := exists_finite_inj_algHom_of_fg Ω Γ(V, ⊤)
      exact s6 _ s g hfin (s5 _ s g hinj hfin NC)

  obtain ⟨ψ, hψ⟩ := key
  refine ⟨V.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom ψ), ?_⟩
  haveI : IsFinite (Spec.map (CommRingCat.ofHom ψ)) := (IsFinite.SpecMap_iff _).mpr hψ
  infer_instance

theorem wc_affine_line_open_in_smooth_proper_curve : ∀ (Ω : Type u) [Field Ω], ∃ (Xb : Scheme.{u}) (fX : Xb ⟶ Spec (.of Ω)) (j : Spec (.of (Polynomial Ω)) ⟶ Xb), IsProper fX ∧ SmoothOfRelativeDimension 1 fX ∧ IsOpenImmersion j :=
by
  intro Ω _
  classical


  have hboth : (∃ j : Spec (.of (Polynomial Ω)) ⟶ wcProjK Ω 1, IsOpenImmersion j) ∧
      SmoothOfRelativeDimension 1 (wcProjKStr Ω 1) := by
    letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω) :=
      MvPolynomial.gradedAlgebra
    have scaling : ∀ (T : Type u) [CommRing T] (ν ι : MvPolynomial (Fin (1 + 1)) Ω →+* T) (t : T),
        (∀ c : Ω, ν (MvPolynomial.C c) = ι (MvPolynomial.C c)) →
        (∀ k, ν (MvPolynomial.X k) * t = ι (MvPolynomial.X k)) →
        ∀ (n : ℕ) (a : MvPolynomial (Fin (1 + 1)) Ω), a.IsHomogeneous n → ν a * t ^ n = ι a := by
      intro T _ ν ι t hC hXk n a ha
      conv_rhs => rw [a.as_sum]
      conv_lhs => rw [a.as_sum]
      rw [map_sum, map_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl (fun m hm => ?_)
      have hdeg : ∑ k ∈ m.support, m k = n := by
        have := ha (MvPolynomial.mem_support_iff.mp hm)
        simpa [Finsupp.weight_apply, Finsupp.sum] using this
      rw [MvPolynomial.monomial_eq, map_mul, map_mul, Finsupp.prod, map_prod, map_prod, ← hdeg,
        ← Finset.prod_pow_eq_pow_sum, mul_assoc, ← Finset.prod_mul_distrib, hC]
      congr 1
      refine Finset.prod_congr rfl (fun k _ => ?_)
      rw [map_pow, map_pow, ← mul_pow, hXk]
    have hX : ∀ k : Fin (1 + 1), (MvPolynomial.X k : MvPolynomial (Fin (1 + 1)) Ω) ∈
        MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω 1 :=
      fun k => (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X Ω k)
    have chart : ∀ i : Fin (1 + 1), ∃ e : MvPolynomial (Fin 1) Ω ≃+* HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω) (MvPolynomial.X i),
        ∀ c : Ω, e (MvPolynomial.C c) =
          HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω)
            (Submonoid.powers (MvPolynomial.X i))
            (algebraMap Ω (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω 0) c) := by
      intro i
      let κ := (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω) (Submonoid.powers (MvPolynomial.X i))).comp
          (algebraMap Ω (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω 0))
      have h1 : ∀ j : Fin 1, (MvPolynomial.X (i.succAbove j) : MvPolynomial (Fin (1 + 1)) Ω) ∈
          MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω (1 • 1) := fun j => by
        rw [smul_eq_mul, mul_one]; exact hX _
      let y : Fin 1 → HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω) (MvPolynomial.X i) := fun j =>
        HomogeneousLocalization.Away.mk _ (hX i) 1 (MvPolynomial.X (i.succAbove j)) (h1 j)
      let φ := MvPolynomial.eval₂Hom κ y
      let δ : MvPolynomial (Fin (1 + 1)) Ω →ₐ[Ω] MvPolynomial (Fin 1) Ω :=
        MvPolynomial.aeval (Fin.insertNth i (1 : MvPolynomial (Fin 1) Ω) MvPolynomial.X)
      have hδi : δ (MvPolynomial.X i) = 1 := by
        simp only [δ, MvPolynomial.aeval_X, Fin.insertNth_apply_same]
      have hδs : ∀ j, δ (MvPolynomial.X (i.succAbove j)) = MvPolynomial.X j := by
        intro j; simp only [δ, MvPolynomial.aeval_X, Fin.insertNth_apply_succAbove]
      have hδC : ∀ c, δ (MvPolynomial.C c) = MvPolynomial.C c := by
        intro c; simp only [δ, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
      let L := Localization (Submonoid.powers (MvPolynomial.X i : MvPolynomial (Fin (1 + 1)) Ω))
      have hu : IsUnit (δ.toRingHom (MvPolynomial.X i)) := by
        show IsUnit (δ (MvPolynomial.X i))
        rw [hδi]; exact isUnit_one
      let Λ : L →+* MvPolynomial (Fin 1) Ω := IsLocalization.Away.lift (MvPolynomial.X i) hu
      have hΛ : ∀ a, Λ (algebraMap _ L a) = δ a := fun a => IsLocalization.Away.lift_eq _ hu a
      let ψ : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω)
          (MvPolynomial.X i) →+* MvPolynomial (Fin 1) Ω := Λ.comp (algebraMap _ L)
      have hF : ∀ (n : ℕ) (a : MvPolynomial (Fin (1 + 1)) Ω)
          (ha : a ∈ MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω (n • 1)),
          ψ (HomogeneousLocalization.Away.mk _ (hX i) n a ha) = δ a := by
        intro n a ha
        have hs := IsLocalization.mk'_spec L a
          (⟨MvPolynomial.X i ^ n, n, rfl⟩ : Submonoid.powers (MvPolynomial.X i))
        have h2 := congrArg Λ hs
        rw [map_mul, hΛ, hΛ] at h2
        change Λ _ * δ (MvPolynomial.X i ^ n) = δ a at h2
        rw [map_pow, hδi, one_pow, mul_one] at h2
        show Λ (algebraMap _ L _) = _
        rw [HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
          Localization.mk_eq_mk'_apply]
        exact h2
      have hC0 : ∀ c : Ω, (MvPolynomial.C c : MvPolynomial (Fin (1 + 1)) Ω) ∈
          MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω (0 • 1) := fun c => by
        rw [zero_smul]
        exact (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_C _ c)
      have hκ : ∀ c, κ c = HomogeneousLocalization.Away.mk _ (hX i) 0 (MvPolynomial.C c) (hC0 c) := by
        intro c
        apply HomogeneousLocalization.val_injective
        rw [HomogeneousLocalization.Away.val_mk]
        change (HomogeneousLocalization.mk
            ⟨0, algebraMap Ω _ c, 1, by rw [SetLike.GradeZero.coe_one]; exact Submonoid.one_mem _⟩ :
              HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω)
                (MvPolynomial.X i)).val = _
        rw [HomogeneousLocalization.val_mk]
        congr 1
      have hψφ : ψ.comp φ = RingHom.id _ := by
        apply MvPolynomial.ringHom_ext
        · intro c
          rw [RingHom.comp_apply, RingHom.id_apply]
          show ψ (MvPolynomial.eval₂Hom κ y (MvPolynomial.C c)) = _
          rw [MvPolynomial.eval₂Hom_C, hκ, hF, hδC]
        · intro j
          rw [RingHom.comp_apply, RingHom.id_apply]
          show ψ (MvPolynomial.eval₂Hom κ y (MvPolynomial.X j)) = _
          rw [MvPolynomial.eval₂Hom_X', hF, hδs]
      have hφψ : φ.comp ψ = RingHom.id _ := by
        refine RingHom.ext fun x => ?_
        obtain ⟨n, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective _ (hX i) x
        rw [RingHom.comp_apply, RingHom.id_apply, hF]
        apply HomogeneousLocalization.val_injective
        rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk'_apply, eq_comm,
          IsLocalization.mk'_eq_iff_eq_mul]
        have hahom : a.IsHomogeneous n := by
          rw [smul_eq_mul, mul_one] at ha
          exact (MvPolynomial.mem_homogeneousSubmodule _ _).mp ha
        have key := scaling L
          ((algebraMap (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω) (MvPolynomial.X i)) L).comp
              (φ.comp δ.toRingHom))
          (algebraMap (MvPolynomial (Fin (1 + 1)) Ω) L)
          (algebraMap (MvPolynomial (Fin (1 + 1)) Ω) L (MvPolynomial.X i)) ?_ ?_ n a hahom
        · rw [← key, RingHom.comp_apply, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply]
          congr 1
          exact (map_pow _ _ _).symm
        · intro c
          show algebraMap _ L (φ (δ (MvPolynomial.C c))) = _
          rw [hδC]
          show algebraMap _ L (MvPolynomial.eval₂Hom κ y (MvPolynomial.C c)) = _
          rw [MvPolynomial.eval₂Hom_C, hκ, HomogeneousLocalization.algebraMap_apply,
            HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk'_apply,
            IsLocalization.mk'_eq_iff_eq_mul]
          show _ = _ * algebraMap (MvPolynomial (Fin (1 + 1)) Ω) L (MvPolynomial.X i ^ 0)
          rw [pow_zero, map_one, mul_one]
        · intro k
          obtain h | ⟨j, h⟩ := Fin.eq_self_or_eq_succAbove i k
          · rw [h]
            show algebraMap _ L (φ (δ (MvPolynomial.X i))) * _ = _
            rw [hδi, map_one, map_one, one_mul]
          · rw [h]
            show algebraMap _ L (φ (δ (MvPolynomial.X (i.succAbove j)))) * _ = _
            rw [hδs]
            show algebraMap _ L (MvPolynomial.eval₂Hom κ y (MvPolynomial.X j)) * _ = _
            rw [MvPolynomial.eval₂Hom_X', HomogeneousLocalization.algebraMap_apply,
              HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk'_apply]
            have hs := IsLocalization.mk'_spec L
              (MvPolynomial.X (i.succAbove j) : MvPolynomial (Fin (1 + 1)) Ω)
              (⟨MvPolynomial.X i ^ 1, 1, rfl⟩ : Submonoid.powers (MvPolynomial.X i))
            rw [← hs]
            congr 1
            show _ = algebraMap (MvPolynomial (Fin (1 + 1)) Ω) L (MvPolynomial.X i ^ 1)
            rw [pow_one]
      exact ⟨RingEquiv.ofRingHom φ ψ hφψ hψφ, fun c => MvPolynomial.eval₂Hom_C _ _ _⟩
    obtain ⟨e, -⟩ := chart 0
    let e' : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω)
        (MvPolynomial.X 0) ≃+* Polynomial Ω :=
      e.symm.trans (MvPolynomial.uniqueAlgEquiv Ω (Fin 1)).toRingEquiv
    refine ⟨⟨Spec.map e'.toCommRingCatIso.hom ≫
      Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω) (MvPolynomial.X 0) (hX 0)
        one_pos, inferInstance⟩, ?_⟩

    have mvpoly : ∀ (S : Type u) [CommRing S] (e : MvPolynomial (Fin 1) Ω ≃+* S),
        RingHom.IsStandardSmoothOfRelativeDimension 1
          ((e : MvPolynomial (Fin 1) Ω →+* S).comp MvPolynomial.C) := by
      intro S _ e
      have h1 : RingHom.IsStandardSmoothOfRelativeDimension 1
          (algebraMap Ω (MvPolynomial (Fin 1) Ω)) := by
        rw [RingHom.isStandardSmoothOfRelativeDimension_algebraMap]
        have := Algebra.IsStandardSmoothOfRelativeDimension.mvPolynomial Ω (Fin 1)
        rwa [Nat.card_fin] at this
      have h3 := (RingHom.IsStandardSmoothOfRelativeDimension.equiv e).comp h1
      rw [zero_add, MvPolynomial.algebraMap_eq] at h3
      exact h3

    have hspan : (HomogeneousIdeal.irrelevant
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω)).toIdeal ≤
        Ideal.span (Set.range (MvPolynomial.X : Fin (1 + 1) → MvPolynomial (Fin (1 + 1)) Ω)) := by
      intro a ha
      have ha2 : a ∈ HomogeneousIdeal.irrelevant
          (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω) := HomogeneousIdeal.mem_iff.mp ha
      rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply] at ha2
      have ha' : MvPolynomial.homogeneousComponent 0 a = 0 :=
        (MvPolynomial.decomposition.decompose'_apply a 0).symm.trans ha2
      rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at ha'
      rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      by_contra hc
      push_neg at hc
      have hm0 : m = 0 := Finsupp.ext fun k => hc k (Set.mem_univ k)
      rw [hm0] at hm
      exact (MvPolynomial.mem_support_iff.mp hm) ha'

    haveI : IsZariskiLocalAtSource (@SmoothOfRelativeDimension 1) :=
      HasRingHomProperty.instIsZariskiLocalAtSource
    apply IsZariskiLocalAtSource.of_openCover
      (Proj.affineOpenCoverOfIrrelevantLESpan (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω)
        (MvPolynomial.X : Fin (1 + 1) → MvPolynomial (Fin (1 + 1)) Ω) (m := fun _ => 1) hX
        (fun _ => one_pos) hspan).openCover
    intro (i : Fin (1 + 1))
    change SmoothOfRelativeDimension 1
      (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω) (MvPolynomial.X i) (hX i)
        one_pos ≫ (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω) ≫
          Spec.map (CommRingCat.ofHom
            (algebraMap Ω (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω 0)))))
    rw [Proj.awayι_toSpecZero_assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
      HasRingHomProperty.Spec_iff (P := @SmoothOfRelativeDimension 1), CommRingCat.hom_ofHom]
    apply RingHom.locally_of RingHom.isStandardSmoothOfRelativeDimension_respectsIso
    obtain ⟨e₁, he₁⟩ := chart i
    have heq : (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω) (Submonoid.powers (MvPolynomial.X i))).comp
          (algebraMap Ω (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω 0)) =
        (e₁ : MvPolynomial (Fin 1) Ω →+* _).comp MvPolynomial.C :=
      RingHom.ext fun c => (he₁ c).symm
    rw [heq]
    exact mvpoly _ e₁

  have hproper : IsProper (wcProjKStr Ω 1) := by
    letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω) :=
      MvPolynomial.gradedAlgebra
    change IsProper (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω) ≫
      Spec.map (CommRingCat.ofHom
        (algebraMap Ω (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω 0))))
    have hcoe : ∀ c : Ω, ((algebraMap Ω (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω 0) c :
        MvPolynomial (Fin (1 + 1)) Ω)) = MvPolynomial.C c := fun c => by
      rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
    haveI : IsScalarTower Ω (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω 0)
        (MvPolynomial (Fin (1 + 1)) Ω) := by
      refine ⟨fun c y a => ?_⟩
      show ((c • y : MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω 0) :
        MvPolynomial (Fin (1 + 1)) Ω) * a = c • ((y : MvPolynomial (Fin (1 + 1)) Ω) * a)
      rw [Submodule.coe_smul, smul_mul_assoc]
    haveI : Algebra.FiniteType (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω 0)
        (MvPolynomial (Fin (1 + 1)) Ω) :=
      Algebra.FiniteType.of_restrictScalars_finiteType Ω _ _
    have hbij : Function.Bijective
        (algebraMap Ω (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω 0)) := by
      constructor
      · intro a b hab
        have := congrArg Subtype.val hab
        rw [hcoe, hcoe] at this
        exact MvPolynomial.C_injective _ _ this
      · rintro ⟨p, hp⟩
        refine ⟨p.coeff 0, ?_⟩
        apply Subtype.ext
        rw [hcoe]
        have h1 := MvPolynomial.homogeneousComponent_of_mem (m := 0) hp
        rw [if_pos rfl, MvPolynomial.homogeneousComponent_zero] at h1
        exact h1
    haveI : IsIso (CommRingCat.ofHom
        (algebraMap Ω (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) Ω 0))) :=
      (RingEquiv.ofBijective _ hbij).toCommRingCatIso.isIso_hom
    infer_instance
  obtain ⟨⟨j, hj⟩, hsm⟩ := hboth
  exact ⟨wcProjK Ω 1, wcProjKStr Ω 1, j, hproper, hsm, hj⟩

theorem wc_et_push_const_zmod_nsmul_zero : ∀ {Y Z : Scheme.{u}} (π : Y ⟶ Z) (m : ℕ), m • 𝟙 ((wcEtPush π).obj ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) = 0 :=
by
  intro Y Z π m
  have h1 : m • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) = 0 := by
    ext x
    simp [nsmul_eq_mul]
  have h2 : m • 𝟙 ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) = 0 := by
    rw [← (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map_id,
      ← Functor.map_nsmul, h1, Functor.map_zero]
  rw [← (wcEtPush π).map_id, ← Functor.map_nsmul, h2, Functor.map_zero]

theorem wc_et_milnor_fibre_cd_one : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (s : Spec (.of A) ⟶ Spec (.of K)) (x : wcHalA1 s), IsClosed ({x} : Set (wcHalA1 s)) → wcHalA1Proj s x = IsLocalRing.closedPoint A → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcHalA1 s) x)) (Scheme.Etale.forget (wcHalA1 s))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ wcHalA1 s), wcHalShData x B Λ W' φ a → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A)) (q : ℕ), 2 ≤ q → Subsingleton (wcEtCoh (Limits.pullback (a ≫ wcHalA1Proj s) z) ℓ q) :=
by
  classical
  intro K _ _ ℓ hℓ hℓK A _ _ _ s x hx hxc B _ _ _ Λ _ _ W' φ a hd Ω _ _ z q hq
  obtain ⟨_hinit, haff, hφ, hφa, hlim, -⟩ := hd

  have hℓΩ : (ℓ : Ω) ≠ 0 := by
    intro h0
    apply hℓK
    apply (Spec.preimage (z ≫ s)).hom.injective
    rw [map_natCast, map_zero]
    exact h0

  haveI hzaff : IsAffineHom z := isAffineHom_of_isAffine z
  haveI hhaff : IsAffineHom (Limits.pullback.fst (wcHalA1Proj s) z) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom)
      (IsPullback.of_hasPullback (wcHalA1Proj s) z).flip hzaff

  obtain ⟨E₃⟩ := wc_et_coh_iso_invariance
    ((Limits.pullbackSymmetry (Limits.pullback.fst (wcHalA1Proj s) z) a).hom ≫
      (Limits.pullbackRightPullbackFstIso (wcHalA1Proj s) z a).hom) ℓ q
  refine @Equiv.subsingleton _ _ E₃ ?_

  have hlev : ∀ U : (wcHalA1 s).Etale, IsAffine U.left →
      Subsingleton (wcEtCoh (Limits.pullback (Limits.pullback.fst (wcHalA1Proj s) z) U.hom) ℓ q) := by
    intro U hUa
    haveI hUe : Etale U.hom := U.prop
    haveI hUa' : IsAffine ((𝟭 Scheme.{u}).obj U.left) := hUa
    haveI hsnd : IsAffineHom (Limits.pullback.snd (Limits.pullback.fst (wcHalA1Proj s) z) U.hom) :=
      MorphismProperty.of_isPullback (P := @IsAffineHom)
        (IsPullback.of_hasPullback (Limits.pullback.fst (wcHalA1Proj s) z) U.hom) hhaff
    haveI hVa : IsAffine (Limits.pullback (Limits.pullback.fst (wcHalA1Proj s) z) U.hom) :=
      isAffine_of_isAffineHom (Limits.pullback.snd (Limits.pullback.fst (wcHalA1Proj s) z) U.hom)
    haveI hfst : Etale (Limits.pullback.fst (Limits.pullback.fst (wcHalA1Proj s) z) U.hom) :=
      MorphismProperty.of_isPullback (P := @Etale)
        (IsPullback.of_hasPullback (Limits.pullback.fst (wcHalA1Proj s) z) U.hom).flip hUe
    obtain ⟨isoL⟩ := wc_hal_a1_iso_polynomial K Ω (z ≫ s)
    let isoA : Limits.pullback (wcHalA1Proj s) z ≅ wcHalA1 (z ≫ s) :=
      Limits.pullbackSymmetry (wcHalA1Proj s) z ≪≫
        Limits.pullbackRightPullbackFstIso s
          (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) z
    have hEt : Etale (Limits.pullback.fst (Limits.pullback.fst (wcHalA1Proj s) z) U.hom ≫
        isoA.hom ≫ isoL.hom) := inferInstance
    obtain ⟨pr, hpr⟩ := wc_etale_affine_over_line_finite Ω
      (Limits.pullback (Limits.pullback.fst (wcHalA1Proj s) z) U.hom) _ hEt
    haveI := hpr
    obtain ⟨Xb, fX, j, hXP, hXS, hjO⟩ := wc_affine_line_open_in_smooth_proper_curve Ω
    haveI := hXP
    haveI := hXS
    haveI := hjO
    have hT := wc_et_push_const_zmod_nsmul_zero pr ℓ
    have hv := wc_et_affine_curve_torsion_vanishing Ω Xb fX (Spec (.of (Polynomial Ω))) j ℓ hℓΩ _
      hT q hq
    obtain ⟨eF⟩ := wc_et_finite_push_ext_equiv pr
      ((constantSheaf (Scheme.smallEtaleTopology
        (Limits.pullback (Limits.pullback.fst (wcHalA1Proj s) z) U.hom)) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) q
    exact ⟨fun y y' => eF.symm.injective ((hv _).trans (hv _).symm)⟩

  haveI := wc_et_enough_injectives (Limits.pullback (wcHalA1Proj s) z)
  let I := InjectiveResolution.of ((constantSheaf (Scheme.smallEtaleTopology
    (Limits.pullback (wcHalA1Proj s) z)) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))
  obtain ⟨E₂⟩ := wc_et_limit_push_homology_affine (Limits.pullback.fst (wcHalA1Proj s) z) B Λ
    (W' ⋙ StructuredArrow.proj (Over.mk (wcEtGeomPt (wcHalA1 s) x)) (Scheme.Etale.forget (wcHalA1 s)))
    φ a haff hφ hφa hlim ℓ I q
  refine @Equiv.subsingleton _ _ E₂.symm ?_

  have hC : ((((sheafToPresheaf (Scheme.smallEtaleTopology (Limits.pullback (wcHalA1Proj s) z))
      AddCommGrpCat.{u+1} ⋙
      (Functor.whiskeringLeft ((wcHalA1 s).Etale)ᵒᵖ ((Limits.pullback (wcHalA1Proj s) z).Etale)ᵒᵖ
        AddCommGrpCat.{u+1}).obj
        (@Functor.op (wcHalA1 s).Etale _ (Limits.pullback (wcHalA1Proj s) z).Etale _
          (wcEtBaseChange (Limits.pullback.fst (wcHalA1Proj s) z))) ⋙
      (Functor.whiskeringLeft Λᵒᵖ ((wcHalA1 s).Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj
        (W' ⋙ StructuredArrow.proj (Over.mk (wcEtGeomPt (wcHalA1 s) x))
          (Scheme.Etale.forget (wcHalA1 s))).op) ⋙
      Limits.colim).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).ExactAt q := by
    apply wc_colim_complex_exactAt_of_eval
    intro j
    obtain ⟨e⟩ := wc_et_limit_push_homology_level (Limits.pullback.fst (wcHalA1Proj s) z)
      ((W' ⋙ StructuredArrow.proj (Over.mk (wcEtGeomPt (wcHalA1 s) x))
        (Scheme.Etale.forget (wcHalA1 s))).obj j.unop) (haff j.unop) ℓ I q
    rw [HomologicalComplex.exactAt_iff_isZero_homology]
    exact @AddCommGrpCat.isZero_of_subsingleton _ (@Equiv.subsingleton _ _ e
      (hlev ((W' ⋙ StructuredArrow.proj (Over.mk (wcEtGeomPt (wcHalA1 s) x))
        (Scheme.Etale.forget (wcHalA1 s))).obj j.unop) (haff j.unop)))
  have hz := hC.isZero_homology
  have key : ∀ (G : AddCommGrpCat.{u+1}), Limits.IsZero G → Subsingleton G := fun G hG =>
    ⟨fun y y' => by
      have h1 : ∀ t : G, t = 0 := fun t => by
        have h2 := congrArg (fun f : G ⟶ G => f.hom t) (hG.eq_of_src (𝟙 G) 0)
        simpa using h2
      rw [h1 y, h1 y']⟩
  exact key _ hz

theorem wc_et_coh_zero_connected_card : ∀ (Y : Scheme.{u}) [ConnectedSpace Y] (m : ℕ), m ≠ 0 → Nat.card (wcEtCoh Y m 0) = m :=
by
  intro Y _ m hm
  haveI : NeZero m := ⟨hm⟩
  let T₀ : Y.Etale := Scheme.Etale.mk (𝟙 Y)
  have hT : Limits.IsTerminal T₀ :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
  obtain ⟨ε, -, -⟩ := wc_et_const_hom_sections_equiv Y T₀ hT
  obtain ⟨e, -⟩ := wc_et_const_zmod_sections_locallyConstant Y m
    (fun V S hS x hx => wc_et_locallyConstant_glue Y V S hS m x hx)
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  let E₁ : wcEtCoh Y m 0 ≃ ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶
      (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) :=
    (Abelian.Ext.addEquiv₀).toEquiv
  let E := E₁.trans ((ε _).trans (e T₀).toEquiv)
  obtain ⟨y₀⟩ : Nonempty Y := inferInstance
  have hpc : _root_.IsPreconnected (Set.univ : Set Y) := isPreconnected_univ
  let Φ : wcEtCoh Y m 0 → ZMod m := fun x => (E x : LocallyConstant Y (ZMod m)) y₀
  have hΦ : Function.Injective Φ := by
    intro a b hab
    apply E.injective
    apply LocallyConstant.ext
    intro x
    have h1 := LocallyConstant.apply_eq_of_isPreconnected (E a : LocallyConstant Y (ZMod m)) hpc
      (Set.mem_univ x) (Set.mem_univ y₀)
    have h2 := LocallyConstant.apply_eq_of_isPreconnected (E b : LocallyConstant Y (ZMod m)) hpc
      (Set.mem_univ x) (Set.mem_univ y₀)
    exact h1.trans (hab.trans h2.symm)
  have hΦs : Function.Surjective Φ := by
    intro c
    refine ⟨E.symm (LocallyConstant.const Y c : LocallyConstant T₀.left (ZMod m)), ?_⟩
    exact congrArg (fun f : LocallyConstant Y (ZMod m) => f y₀) (E.apply_symm_apply _)
  calc Nat.card (wcEtCoh Y m 0) = Nat.card (ZMod m) := Nat.card_eq_of_bijective Φ ⟨hΦ, hΦs⟩
    _ = m := Nat.card_zmod m

theorem wc_shdata_filtered_etale_presentation : ∀ {Y : Scheme.{u}} (y : Y) (B : Type u) [CommRing B] [IsLocalRing B] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Y), wcHalShData y B Λ W' φ a → ∀ (P : Type u) [CommRing P] (e : Y ≅ Spec (.of P)), ∃ β : P →+* B, Spec.map (CommRingCat.ofHom β) = a ≫ e.hom ∧ ∃ (I : Type u) (_ : SmallCategory I) (_ : IsFiltered I) (F : I ⥤ CommRingCat.{u}) (p : ∀ i, P →+* F.obj i) (ι : ∀ i, F.obj i →+* B), (∀ i, (p i).Etale) ∧ (∀ {i j : I} (f : i ⟶ j), (F.map f).hom.comp (p i) = p j) ∧ (∀ {i j : I} (f : i ⟶ j), (ι j).comp (F.map f).hom = ι i) ∧ (∀ i, (ι i).comp (p i) = β) ∧ (∀ b : B, ∃ (i : I) (t : F.obj i), ι i t = b) ∧ (∀ (i : I) (t : F.obj i), ι i t = 0 → ∃ (j : I) (f : i ⟶ j), (F.map f).hom t = 0) :=
by
  intro Y y B _ _ Λ _ _ W' φ a hd P _ e
  obtain ⟨-, hAff, hφ, ha, hlim, -⟩ := hd
  suffices gen : ∀ (D : Λ ⥤ Scheme.{u}) (π : ∀ l, D.obj l ⟶ Y)
      (ψ : ∀ l, Spec (.of B) ⟶ D.obj l),
      (∀ l, IsAffine (D.obj l)) → (∀ l, Etale (π l)) →
      (∀ {l l' : Λ} (t : l ⟶ l'), D.map t ≫ π l' = π l) →
      (∀ {l l' : Λ} (t : l ⟶ l'), ψ l ≫ D.map t = ψ l') →
      (∀ l, ψ l ≫ π l = a) →
      (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ D.obj l),
        (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ D.map t = z l') →
        ∃! z₀ : T ⟶ Spec (.of B), ∀ l, z₀ ≫ ψ l = z l) →
      ∃ β : P →+* B, Spec.map (CommRingCat.ofHom β) = a ≫ e.hom ∧ ∃ (I : Type u) (_ : SmallCategory I) (_ : IsFiltered I) (F : I ⥤ CommRingCat.{u}) (p : ∀ i, P →+* F.obj i) (ι : ∀ i, F.obj i →+* B), (∀ i, (p i).Etale) ∧ (∀ {i j : I} (f : i ⟶ j), (F.map f).hom.comp (p i) = p j) ∧ (∀ {i j : I} (f : i ⟶ j), (ι j).comp (F.map f).hom = ι i) ∧ (∀ i, (ι i).comp (p i) = β) ∧ (∀ b : B, ∃ (i : I) (t : F.obj i), ι i t = b) ∧ (∀ (i : I) (t : F.obj i), ι i t = 0 → ∃ (j : I) (f : i ⟶ j), (F.map f).hom t = 0) by
    exact gen (W' ⋙ StructuredArrow.proj (Over.mk (wcEtGeomPt Y y))
        (Scheme.Etale.forget Y) ⋙ Scheme.Etale.forget Y ⋙ Over.forget Y)
      (fun l => (W'.obj l).right.hom) φ hAff (fun l => (W'.obj l).right.prop)
      (fun t => MorphismProperty.Over.w (W'.map t).right) (fun t => hφ t) ha
      (fun T z hz => hlim T z hz)
  clear hAff hφ ha hlim
  intro D π φ hAffD hπ hπw hφD ha hlimD
  haveI := hAffD

  have s2 : ∀ (X : Scheme.{u}) [IsAffine X] (R : Type u) [CommRing R] (f : Spec (.of R) ⟶ X),
      Spec.map (f.appTop ≫ (Scheme.ΓSpecIso (.of R)).hom) = f ≫ X.isoSpec.hom := by
    intro X _ R _ f
    rw [Spec.map_comp, ← Scheme.isoSpec_Spec_hom, Scheme.isoSpec_hom_naturality]

  have s3 : ∀ (X : Scheme.{u}) [IsAffine X] (g : X ⟶ Spec (.of P)), Etale g →
      ((Scheme.ΓSpecIso (.of P)).inv ≫ g.appTop).hom.Etale := by
    intro X _ g hg
    have h1 := HasRingHomProperty.appTop @Etale g hg
    rw [CommRingCat.hom_comp]
    exact (RingHom.RespectsIso.cancel_left_isIso RingHom.Etale.respectsIso
      (Scheme.ΓSpecIso (.of P)).inv g.appTop).mpr h1
  haveI : IsFiltered Λᵒᵖ := isFiltered_op_of_isCofiltered Λ
  let F : Λᵒᵖ ⥤ CommRingCat.{u} :=
    { obj := fun j => Γ(D.obj j.unop, ⊤)
      map := fun f => (D.map f.unop).appTop
      map_id := fun j => (D.op ⋙ Scheme.Γ).map_id j
      map_comp := fun f g => (D.op ⋙ Scheme.Γ).map_comp f g }
  let p : ∀ i : Λᵒᵖ, P →+* F.obj i := fun i =>
    ((Scheme.ΓSpecIso (.of P)).inv ≫ (π i.unop ≫ e.hom).appTop).hom
  let ι : ∀ i : Λᵒᵖ, F.obj i →+* B := fun i =>
    ((φ i.unop).appTop ≫ (Scheme.ΓSpecIso (.of B)).hom).hom
  let β : P →+* B :=
    ((Scheme.ΓSpecIso (.of P)).inv ≫ (a ≫ e.hom).appTop ≫ (Scheme.ΓSpecIso (.of B)).hom).hom
  have hβ : Spec.map (CommRingCat.ofHom β) = a ≫ e.hom := by
    show Spec.map (CommRingCat.ofHom ((Scheme.ΓSpecIso (.of P)).inv ≫
      (a ≫ e.hom).appTop ≫ (Scheme.ΓSpecIso (.of B)).hom).hom) = a ≫ e.hom
    rw [CommRingCat.ofHom_hom, Spec.map_comp, s2 (Spec (.of P)) B (a ≫ e.hom),
      Scheme.isoSpec_Spec_hom, Category.assoc, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id,
      Category.comp_id]

  let c : Limits.Cocone F :=
    { pt := CommRingCat.of B
      ι :=
        { app := fun j => (φ j.unop).appTop ≫ (Scheme.ΓSpecIso (.of B)).hom
          naturality := fun i j f => by
            show (D.map f.unop).appTop ≫ (φ j.unop).appTop ≫ (Scheme.ΓSpecIso (.of B)).hom =
              ((φ i.unop).appTop ≫ (Scheme.ΓSpecIso (.of B)).hom) ≫ 𝟙 _
            rw [Category.comp_id, ← Category.assoc, ← Scheme.Hom.comp_appTop, hφD f.unop] } }
  have key : ∀ l, Spec.map (c.ι.app (Opposite.op l)) = φ l ≫ (D.obj l).isoSpec.hom :=
    fun l => s2 (D.obj l) B (φ l)
  have hc : Limits.IsColimit c := by
    refine Limits.IsColimit.ofExistsUnique (fun s => ?_)
    have hz : ∀ {l l' : Λ} (t : l ⟶ l'),
        (Spec.map (s.ι.app (Opposite.op l)) ≫ (D.obj l).isoSpec.inv) ≫ D.map t =
          Spec.map (s.ι.app (Opposite.op l')) ≫ (D.obj l').isoSpec.inv := by
      intro l l' t
      rw [Category.assoc, ← Scheme.isoSpec_inv_naturality, ← Category.assoc, ← Spec.map_comp,
        show (D.map t).appTop ≫ s.ι.app (Opposite.op l) = s.ι.app (Opposite.op l') from s.w t.op]
    obtain ⟨z₀, hz₀, huniq⟩ := hlimD (Spec s.pt)
      (fun l => Spec.map (s.ι.app (Opposite.op l)) ≫ (D.obj l).isoSpec.inv) hz
    refine ⟨Spec.preimage z₀, ?_, ?_⟩
    · intro j
      apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_preimage, key j.unop, ← Category.assoc, hz₀ j.unop,
        Category.assoc, Iso.inv_hom_id, Category.comp_id]
    · intro m hm
      apply Spec.map_injective
      rw [Spec.map_preimage]
      refine huniq _ (fun l => ?_)
      show Spec.map m ≫ φ l = Spec.map (s.ι.app (Opposite.op l)) ≫ (D.obj l).isoSpec.inv
      rw [← hm (Opposite.op l), Spec.map_comp, key l, Category.assoc, Category.assoc,
        Iso.hom_inv_id, Category.comp_id]
  refine ⟨β, hβ, Λᵒᵖ, inferInstance, inferInstance, F, p, ι, ?_, ?_, ?_, ?_, ?_, ?_⟩
  ·
    intro i
    haveI := hπ i.unop
    exact s3 (D.obj i.unop) (π i.unop ≫ e.hom) inferInstance
  ·
    intro i j f
    have hw : D.map f.unop ≫ π i.unop ≫ e.hom = π j.unop ≫ e.hom := by
      rw [← Category.assoc, hπw]
    show ((D.map f.unop).appTop).hom.comp
        ((Scheme.ΓSpecIso (.of P)).inv ≫ (π i.unop ≫ e.hom).appTop).hom =
      ((Scheme.ΓSpecIso (.of P)).inv ≫ (π j.unop ≫ e.hom).appTop).hom
    rw [← CommRingCat.hom_comp, Category.assoc, ← Scheme.Hom.comp_appTop, hw]
  ·
    intro i j f
    show ((φ j.unop).appTop ≫ (Scheme.ΓSpecIso (.of B)).hom).hom.comp
        ((D.map f.unop).appTop).hom =
      ((φ i.unop).appTop ≫ (Scheme.ΓSpecIso (.of B)).hom).hom
    rw [← CommRingCat.hom_comp, ← Category.assoc, ← Scheme.Hom.comp_appTop, hφD f.unop]
  ·
    intro i
    show ((φ i.unop).appTop ≫ (Scheme.ΓSpecIso (.of B)).hom).hom.comp
        ((Scheme.ΓSpecIso (.of P)).inv ≫ (π i.unop ≫ e.hom).appTop).hom =
      ((Scheme.ΓSpecIso (.of P)).inv ≫ (a ≫ e.hom).appTop ≫ (Scheme.ΓSpecIso (.of B)).hom).hom
    rw [← CommRingCat.hom_comp, Category.assoc, ← Category.assoc
      (π i.unop ≫ e.hom).appTop, ← Scheme.Hom.comp_appTop,
      ← Category.assoc (φ i.unop), ha i.unop]
  ·
    intro b
    obtain ⟨j, t, ht⟩ := Limits.Concrete.isColimit_exists_rep F hc (show ToType c.pt from b)
    exact ⟨j, t, ht⟩
  ·
    intro i t ht
    have h2 : ConcreteCategory.hom (c.ι.app i) t =
        ConcreteCategory.hom (c.ι.app i) (0 : ToType (F.obj i)) := by
      rw [map_zero]
      exact ht
    obtain ⟨k, f, g, hfg⟩ := (Limits.Concrete.isColimit_rep_eq_iff_exists F hc t 0).mp h2
    refine ⟨k, f, ?_⟩
    rw [map_zero] at hfg
    exact hfg

theorem wc_ring_henselian_etale_section : ∀ (R S : Type u) [CommRing R] [HenselianLocalRing R] [CommRing S] [Algebra R S] [Algebra.Etale R S] (P : Ideal S) [P.IsPrime] [P.LiesOver (IsLocalRing.maximalIdeal R)], Function.Bijective (Ideal.ResidueField.mapₐ (IsLocalRing.maximalIdeal R) P (Algebra.ofId R S) (P.over_def (IsLocalRing.maximalIdeal R))) → ∃ σ : S →ₐ[R] R, Ideal.comap σ (IsLocalRing.maximalIdeal R) = P :=
by
  intro R S _ _ _ _ _ P _ _ hbij
  classical
  let φ : R →+* P.ResidueField := algebraMap R P.ResidueField
  have hφker : ∀ r : R, φ r = 0 ↔ r ∈ IsLocalRing.maximalIdeal R := by
    intro r
    have h1 : φ r = algebraMap S P.ResidueField (algebraMap R S r) :=
      IsScalarTower.algebraMap_apply R S P.ResidueField r
    rw [h1, Ideal.algebraMap_residueField_eq_zero, Ideal.over_def P (IsLocalRing.maximalIdeal R),
      Ideal.under_def, Ideal.mem_comap]
  have hφsurj : Function.Surjective φ := by
    intro y
    obtain ⟨z, rfl⟩ := hbij.2 y
    obtain ⟨r, rfl⟩ := Ideal.algebraMap_residueField_surjective (IsLocalRing.maximalIdeal R) z
    exact ⟨r, ((Ideal.ResidueField.mapₐ (IsLocalRing.maximalIdeal R) P (Algebra.ofId R S)
      (P.over_def (IsLocalRing.maximalIdeal R))).commutes r).symm⟩
  obtain ⟨u, huP, hstd⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := R) P
  obtain ⟨Pr⟩ := hstd.nonempty_standardEtalePresentation
  have hfu : IsUnit (algebraMap S P.ResidueField u) := by
    rw [isUnit_iff_ne_zero]
    intro h
    exact huP (Ideal.algebraMap_residueField_eq_zero.mp h)
  let ψ : Localization.Away u →ₐ[R] P.ResidueField :=
    IsLocalization.Away.liftAlgHom (A := R) u (f := IsScalarTower.toAlgHom R S P.ResidueField) hfu
  have hψ : ∀ s : S, ψ (algebraMap S (Localization.Away u) s) = algebraMap S P.ResidueField s := by
    intro s
    exact (IsLocalization.Away.liftAlgHom_apply u hfu _).trans (IsLocalization.Away.lift_eq u _ s)
  have heval : ∀ p : Polynomial R,
      Polynomial.eval₂ φ (ψ Pr.x) p = ψ (Polynomial.aeval Pr.x p) := by
    intro p
    rw [← Polynomial.aeval_algHom_apply, Polynomial.aeval_def]
  obtain ⟨hx1, hx2⟩ := Pr.hasMap
  have hy1 : Polynomial.eval₂ φ (ψ Pr.x) Pr.f = 0 := by rw [heval, hx1, map_zero]
  have hy2 : Polynomial.eval₂ φ (ψ Pr.x) Pr.g ≠ 0 := by
    rw [heval]
    exact (hx2.map ψ).ne_zero
  have hy3 : Polynomial.eval₂ φ (ψ Pr.x) (Polynomial.derivative Pr.f) ≠ 0 := by
    obtain ⟨p₁, p₂, n, hc⟩ := Pr.cond
    intro h0
    have h := congrArg (Polynomial.eval₂ φ (ψ Pr.x)) hc
    simp only [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_pow, h0, hy1,
      zero_mul, add_zero] at h
    exact pow_ne_zero n hy2 h.symm
  have hHens := ((HenselianLocalRing.TFAE R).out 1 3).mp ‹HenselianLocalRing R›
  obtain ⟨a, ha1, ha2⟩ := hHens φ hφsurj Pr.f Pr.monic_f (ψ Pr.x) hy1 hy3
  have hga : IsUnit (Polynomial.eval a Pr.g) := by
    have h1 : φ (Polynomial.eval a Pr.g) ≠ 0 := by
      rw [← Polynomial.eval₂_hom, ha2]
      exact hy2
    by_contra hn
    exact h1 ((hφker _).mpr ((IsLocalRing.mem_maximalIdeal _).mpr hn))
  have hA : Pr.HasMap a := by
    refine ⟨?_, ?_⟩
    · rw [Polynomial.coe_aeval_eq_eval]; exact ha1
    · rw [Polynomial.coe_aeval_eq_eval]; exact hga
  let τ : Pr.Ring →ₐ[R] R := Pr.P.lift a hA
  let e : Pr.Ring ≃ₐ[R] Localization.Away u :=
    AlgEquiv.ofBijective (Pr.lift Pr.x Pr.hasMap) Pr.lift_bijective
  let σ₀ : Localization.Away u →ₐ[R] R := τ.comp (e.symm : Localization.Away u →ₐ[R] Pr.Ring)
  let σ : S →ₐ[R] R := σ₀.comp (IsScalarTower.toAlgHom R S (Localization.Away u))
  have hagree : ψ.comp (e : Pr.Ring →ₐ[R] Localization.Away u) =
      (Algebra.ofId R P.ResidueField).comp τ := by
    apply StandardEtalePair.hom_ext
    have h1 : e Pr.X = Pr.x := StandardEtalePair.lift_X _ _ Pr.hasMap
    have h2 : τ Pr.X = a := StandardEtalePair.lift_X _ _ hA
    show ψ (e Pr.X) = Algebra.ofId R P.ResidueField (τ Pr.X)
    rw [h1, h2, Algebra.ofId_apply]
    exact ha2.symm
  have hagree' : ∀ t, ψ t = φ (σ₀ t) := by
    intro t
    have h := AlgHom.congr_fun hagree (e.symm t)
    change ψ (e (e.symm t)) = algebraMap R P.ResidueField (τ (e.symm t)) at h
    rw [AlgEquiv.apply_symm_apply] at h
    exact h
  refine ⟨σ, ?_⟩
  ext s
  rw [Ideal.mem_comap, ← hφker]
  change φ (σ₀ (algebraMap S (Localization.Away u) s)) = 0 ↔ s ∈ P
  rw [← hagree', hψ, Ideal.algebraMap_residueField_eq_zero]

theorem wc_ring_henselian_integral_domain_isLocalRing : ∀ (R S : Type u) [CommRing R] [HenselianLocalRing R] [CommRing S] [IsDomain S] [Algebra R S] [Algebra.IsIntegral R S], (∀ (S' : Type u) [CommRing S'] [Algebra R S'] [Algebra.Etale R S'] (P : Ideal S') [P.IsPrime] [P.LiesOver (IsLocalRing.maximalIdeal R)], Function.Bijective (Ideal.ResidueField.mapₐ (IsLocalRing.maximalIdeal R) P (Algebra.ofId R S') (P.over_def (IsLocalRing.maximalIdeal R))) → ∃ σ : S' →ₐ[R] R, Ideal.comap σ (IsLocalRing.maximalIdeal R) = P) → IsLocalRing S :=
by
  intro R S _ _ _ _ _ _ H
  have s1 : ∀ (C : Type u) [CommRing C] [IsDomain C] [Algebra R C] [Module.Finite R C]
      (n₁ n₂ : Ideal C) [n₁.IsPrime] [n₂.IsPrime] [n₁.LiesOver (IsLocalRing.maximalIdeal R)]
      [n₂.LiesOver (IsLocalRing.maximalIdeal R)], n₁ = n₂ := by
    intro C _ _ _ _ n₁ n₂ _ hn₂ _ _
    obtain ⟨R', _, _, _, P, _, _, e, he, P', _, _, h1, h2, hbij, -, huniq⟩ :=
      Algebra.exists_etale_isIdempotentElem_forall_liesOver_eq (IsLocalRing.maximalIdeal R) n₁
    obtain ⟨σ, hσ⟩ := H R' P hbij
    let π : TensorProduct R R' C →ₐ[R] C :=
      Algebra.TensorProduct.productMap ((Algebra.ofId R C).comp σ) (AlgHom.id R C)
    have pull : ∀ (Q : Ideal C) [Q.IsPrime] [Q.LiesOver (IsLocalRing.maximalIdeal R)],
        (Ideal.comap π Q).IsPrime ∧ (Ideal.comap π Q).LiesOver P ∧
        Ideal.comap (Algebra.TensorProduct.includeRight : C →ₐ[R] TensorProduct R R' C).toRingHom
          (Ideal.comap π Q) = Q := by
      intro Q _ _
      have hQ' : ∀ a : R, a ∈ IsLocalRing.maximalIdeal R ↔ algebraMap R C a ∈ Q := by
        intro a
        rw [Ideal.over_def Q (IsLocalRing.maximalIdeal R)]
        rfl
      refine ⟨Ideal.IsPrime.comap _, ⟨?_⟩, ?_⟩
      · ext r
        show r ∈ P ↔ π (algebraMap R' (TensorProduct R R' C) r) ∈ Q
        rw [Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.productMap_apply_tmul,
          ← hσ, Ideal.mem_comap, hQ']
        simp
      · ext c
        show π (Algebra.TensorProduct.includeRight c) ∈ Q ↔ c ∈ Q
        rw [Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.productMap_apply_tmul]
        simp
    obtain ⟨hp1, hl1, hc1⟩ := pull n₁
    have heq1 : Ideal.comap π n₁ = P' := by
      haveI := hp1
      haveI := hl1
      exact Ideal.eq_of_comap_eq_comap_of_bijective_residueFieldMap hbij _ _ (hc1.trans h1.symm)
    have hπe : π e = 1 := by
      have hid : IsIdempotentElem (π e) := he.map π
      rcases IsIdempotentElem.iff_eq_zero_or_one.mp hid with h0 | h1'
      · exfalso
        apply h2
        rw [← heq1, Ideal.mem_comap, h0]
        exact n₁.zero_mem
      · exact h1'
    obtain ⟨hp2, hl2, hc2⟩ := pull n₂
    have heq2 : Ideal.comap π n₂ = P' := by
      refine huniq _ hp2 hl2 ?_
      intro h
      rw [Ideal.mem_comap, hπe] at h
      exact hn₂.ne_top ((Ideal.eq_top_iff_one _).mpr h)
    calc n₁ = Ideal.comap (Algebra.TensorProduct.includeRight : C →ₐ[R] TensorProduct R R' C).toRingHom P' := h1.symm
      _ = Ideal.comap (Algebra.TensorProduct.includeRight : C →ₐ[R] TensorProduct R R' C).toRingHom
          (Ideal.comap π n₂) := by rw [heq2]
      _ = n₂ := hc2
  have key : ∀ (M₁ M₂ : Ideal S), M₁.IsMaximal → M₂.IsMaximal → M₁ ≤ M₂ := by
    intro M₁ M₂ hM₁ hM₂ x hx
    haveI : Module.Finite R (Algebra.adjoin R {x}) :=
      Algebra.finite_adjoin_simple_of_isIntegral (Algebra.IsIntegral.isIntegral x)
    have lo : ∀ (M : Ideal S), M.IsMaximal →
        (Ideal.comap (Algebra.adjoin R {x}).val M).LiesOver (IsLocalRing.maximalIdeal R) := by
      intro M hM
      have hint : (algebraMap R S).IsIntegral := fun s => Algebra.IsIntegral.isIntegral s
      have hmax := Ideal.isMaximal_comap_of_isIntegral_of_isMaximal (algebraMap R S) hint M
      have e1 : IsLocalRing.maximalIdeal R = Ideal.comap (algebraMap R S) M :=
        (IsLocalRing.eq_maximalIdeal hmax).symm
      constructor
      ext r
      rw [e1]
      show algebraMap R S r ∈ M ↔
        (Algebra.adjoin R {x}).val (algebraMap R (Algebra.adjoin R {x}) r) ∈ M
      rw [AlgHom.commutes]
    haveI : (Ideal.comap (Algebra.adjoin R {x}).val M₁).IsPrime := Ideal.IsPrime.comap _
    haveI : (Ideal.comap (Algebra.adjoin R {x}).val M₂).IsPrime := Ideal.IsPrime.comap _
    haveI := lo M₁ hM₁
    haveI := lo M₂ hM₂
    have h := s1 (Algebra.adjoin R {x}) (Ideal.comap (Algebra.adjoin R {x}).val M₁)
      (Ideal.comap (Algebra.adjoin R {x}).val M₂)
    have hxC : (⟨x, Algebra.subset_adjoin (Set.mem_singleton x)⟩ : Algebra.adjoin R {x}) ∈
        Ideal.comap (Algebra.adjoin R {x}).val M₁ := hx
    rw [h] at hxC
    exact hxC
  obtain ⟨M₀, hM₀⟩ := Ideal.exists_maximal S
  exact IsLocalRing.of_unique_max_ideal
    ⟨M₀, hM₀, fun M hM => (hM₀.eq_of_le hM.ne_top (key M₀ M hM₀ hM)).symm⟩

theorem wc_ring_tensor_isLocalRing_of_sepClosed : ∀ (A B D : Type u) [CommRing A] [IsLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] [CommRing B] [IsLocalRing B] [CommRing D] [IsLocalRing D] [Algebra A B] [Algebra A D] [IsLocalHom (algebraMap A B)] [Algebra.IsIntegral A D] [Nontrivial (TensorProduct A B D)], IsLocalRing (TensorProduct A B D) :=
by
  intro A B D _ _ _ _ _ _ _ _ _ _ _ _
  classical

  have hAD_int : (algebraMap A D).IsIntegral := algebraMap_isIntegral_iff.mpr inferInstance
  have hADcomap : Ideal.comap (algebraMap A D) (IsLocalRing.maximalIdeal D) =
      IsLocalRing.maximalIdeal A := by
    have := Ideal.isMaximal_comap_of_isIntegral_of_isMaximal (algebraMap A D) hAD_int
      (IsLocalRing.maximalIdeal D)
    exact IsLocalRing.eq_maximalIdeal this
  haveI hADloc : IsLocalHom (algebraMap A D) :=
    ((IsLocalRing.local_hom_TFAE (algebraMap A D)).out 1 5).mpr hADcomap
  have hAB_comap : Ideal.comap (algebraMap A B) (IsLocalRing.maximalIdeal B) =
      IsLocalRing.maximalIdeal A :=
    ((IsLocalRing.local_hom_TFAE (algebraMap A B)).out 1 5).mp ‹IsLocalHom (algebraMap A B)›

  obtain ⟨ιD, hιD⟩ : ∃ f : D →+* TensorProduct A B D,
      f = (Algebra.TensorProduct.includeRight : D →ₐ[A] TensorProduct A B D).toRingHom :=
    ⟨_, rfl⟩
  have hιDapp : ∀ d : D, ιD d = (1 : B) ⊗ₜ[A] d := by
    intro d; rw [hιD]; rfl
  have hιDcomp : ιD.comp (algebraMap A D) = algebraMap A (TensorProduct A B D) :=
    RingHom.ext fun a => by rw [hιD]; exact Algebra.TensorProduct.includeRight.commutes a
  have hBapp : ∀ b : B, algebraMap B (TensorProduct A B D) b = b ⊗ₜ[A] (1 : D) := by
    intro b; rfl

  have hBT_int : (algebraMap B (TensorProduct A B D)).IsIntegral :=
    algebraMap_isIntegral_iff.mpr (Algebra.IsIntegral.tensorProduct A B D)
  have s1 : ∀ M : Ideal (TensorProduct A B D), M.IsMaximal →
      Ideal.comap (algebraMap B (TensorProduct A B D)) M = IsLocalRing.maximalIdeal B ∧
      Ideal.comap ιD M = IsLocalRing.maximalIdeal D := by
    intro M hM
    have h1 : Ideal.comap (algebraMap B (TensorProduct A B D)) M = IsLocalRing.maximalIdeal B := by
      have := Ideal.isMaximal_comap_of_isIntegral_of_isMaximal _ hBT_int M
      exact IsLocalRing.eq_maximalIdeal this
    refine ⟨h1, ?_⟩
    have hAT : Ideal.comap (algebraMap A (TensorProduct A B D)) M = IsLocalRing.maximalIdeal A := by
      rw [IsScalarTower.algebraMap_eq A B (TensorProduct A B D), ← Ideal.comap_comap, h1,
        hAB_comap]
    haveI : (Ideal.comap ιD M).IsPrime := Ideal.comap_isPrime _ _
    have hmax : (Ideal.comap (algebraMap A D) (Ideal.comap ιD M)).IsMaximal := by
      rw [Ideal.comap_comap, hιDcomp, hAT]; infer_instance
    have := Ideal.isMaximal_of_isIntegral_of_isMaximal_comap (algebraMap A D) hAD_int _ hmax
    exact IsLocalRing.eq_maximalIdeal this

  obtain ⟨J, hJ⟩ : ∃ J : Ideal (TensorProduct A B D),
      J = Ideal.map (algebraMap B (TensorProduct A B D)) (IsLocalRing.maximalIdeal B) ⊔
        Ideal.map ιD (IsLocalRing.maximalIdeal D) := ⟨_, rfl⟩
  have hJle : ∀ M : Ideal (TensorProduct A B D), M.IsMaximal → J ≤ M := by
    intro M hM
    obtain ⟨h1, h2⟩ := s1 M hM
    rw [hJ]
    exact sup_le (Ideal.map_le_iff_le_comap.mpr h1.ge) (Ideal.map_le_iff_le_comap.mpr h2.ge)
  obtain ⟨M₀, hM₀⟩ := Ideal.exists_maximal (TensorProduct A B D)
  have hJne : J ≠ ⊤ := fun h => hM₀.ne_top (top_le_iff.mp (h ▸ hJle M₀ hM₀))
  haveI : Nontrivial (TensorProduct A B D ⧸ J) := Ideal.Quotient.nontrivial_iff.mpr hJne

  set q := ringExpChar (IsLocalRing.ResidueField A) with hq
  haveI hqk : ExpChar (IsLocalRing.ResidueField A) q := ringExpChar.expChar _
  have hkill : ∀ a ∈ IsLocalRing.maximalIdeal A,
      ((Ideal.Quotient.mk J).comp (algebraMap A (TensorProduct A B D))) a = 0 := by
    intro a ha
    rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem, hJ]
    apply Ideal.mem_sup_left
    rw [IsScalarTower.algebraMap_apply A B (TensorProduct A B D)]
    exact Ideal.mem_map_of_mem _ (map_nonunit (algebraMap A B) a ha)
  have g : IsLocalRing.ResidueField A →+* (TensorProduct A B D ⧸ J) :=
    Ideal.Quotient.lift (IsLocalRing.maximalIdeal A) _ hkill
  haveI hqT : ExpChar (TensorProduct A B D ⧸ J) q :=
    expChar_of_injective_ringHom (RingHom.injective g) q

  have hcompres : (algebraMap (IsLocalRing.ResidueField A) (IsLocalRing.ResidueField D)).comp
      (IsLocalRing.residue A) = (IsLocalRing.residue D).comp (algebraMap A D) :=
    RingHom.ext fun x => IsLocalRing.ResidueField.algebraMap_residue x
  haveI hkint : Algebra.IsIntegral (IsLocalRing.ResidueField A) (IsLocalRing.ResidueField D) := by
    constructor
    intro y
    obtain ⟨d', rfl⟩ := IsLocalRing.residue_surjective y
    obtain ⟨f, hfm, hf⟩ := Algebra.IsIntegral.isIntegral (R := A) d'
    refine ⟨f.map (IsLocalRing.residue A), hfm.map _, ?_⟩
    rw [Polynomial.eval₂_map, hcompres, ← Polynomial.hom_eval₂, hf, map_zero]
  haveI : IsPurelyInseparable (IsLocalRing.ResidueField A) (IsLocalRing.ResidueField D) :=
    Algebra.IsAlgebraic.isPurelyInseparable_of_isSepClosed
  have s2 : ∀ d : D, ∃ (n : ℕ) (a : A),
      d ^ q ^ n - algebraMap A D a ∈ IsLocalRing.maximalIdeal D := by
    intro d
    obtain ⟨n, hn⟩ := IsPurelyInseparable.pow_mem (IsLocalRing.ResidueField A) q
      (IsLocalRing.residue D d)
    obtain ⟨z, hz⟩ := RingHom.mem_range.mp hn
    obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective z
    refine ⟨n, a, ?_⟩
    rw [← IsLocalRing.residue_eq_zero_iff, map_sub, map_pow,
      ← IsLocalRing.ResidueField.algebraMap_residue, hz, sub_self]

  have key : ∀ t : TensorProduct A B D, ∃ (n : ℕ) (β : B),
      Ideal.Quotient.mk J t ^ q ^ n = Ideal.Quotient.mk J (β ⊗ₜ[A] (1 : D)) := by
    intro t
    induction t using TensorProduct.induction_on with
    | zero => exact ⟨0, 0, by simp⟩
    | tmul b d =>
      obtain ⟨n, a, ha⟩ := s2 d
      refine ⟨n, a • b ^ q ^ n, ?_⟩
      rw [← map_pow, Algebra.TensorProduct.tmul_pow, Ideal.Quotient.eq]
      have e : (b ^ q ^ n) ⊗ₜ[A] (d ^ q ^ n) - (a • b ^ q ^ n) ⊗ₜ[A] (1 : D) =
          ((b ^ q ^ n) ⊗ₜ[A] (1 : D)) * ιD (d ^ q ^ n - algebraMap A D a) := by
        rw [hιDapp, Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one, TensorProduct.tmul_sub,
          TensorProduct.smul_tmul, Algebra.algebraMap_eq_smul_one]
      rw [e, hJ]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ ha))
    | add x y hx hy =>
      obtain ⟨n₁, β₁, h₁⟩ := hx
      obtain ⟨n₂, β₂, h₂⟩ := hy
      refine ⟨n₁ + n₂, β₁ ^ q ^ n₂ + β₂ ^ q ^ n₁, ?_⟩
      rw [map_add, add_pow_expChar_pow, TensorProduct.add_tmul, map_add]
      congr 1
      · rw [pow_add, pow_mul, h₁, ← map_pow, Algebra.TensorProduct.tmul_pow, one_pow]
      · rw [pow_add, mul_comm (q ^ n₁), pow_mul, h₂, ← map_pow, Algebra.TensorProduct.tmul_pow,
          one_pow]

  have hle : ∀ M₁ M₂ : Ideal (TensorProduct A B D), M₁.IsMaximal → M₂.IsMaximal → M₁ ≤ M₂ := by
    intro M₁ M₂ h₁ h₂ t ht
    obtain ⟨n, β, hβ⟩ := key t
    rw [← map_pow, Ideal.Quotient.eq] at hβ
    have hpow1 : t ^ q ^ n ∈ M₁ :=
      Ideal.pow_mem_of_mem M₁ ht _ (expChar_pow_pos (IsLocalRing.ResidueField A) q n)
    have hβ1 : β ⊗ₜ[A] (1 : D) ∈ M₁ := by
      have := M₁.sub_mem hpow1 (hJle M₁ h₁ hβ)
      rwa [sub_sub_cancel] at this
    have hβB : β ∈ IsLocalRing.maximalIdeal B := by
      rw [← (s1 M₁ h₁).1, Ideal.mem_comap, hBapp]
      exact hβ1
    have hβJ : β ⊗ₜ[A] (1 : D) ∈ J := by
      rw [hJ, ← hBapp]
      exact Ideal.mem_sup_left (Ideal.mem_map_of_mem _ hβB)
    have hpow2 : t ^ q ^ n ∈ M₂ := by
      have := M₂.add_mem (hJle M₂ h₂ hβ) (hJle M₂ h₂ hβJ)
      rwa [sub_add_cancel] at this
    exact h₂.isPrime.mem_of_pow_mem _ hpow2
  apply IsLocalRing.of_unique_max_ideal
  exact ⟨M₀, hM₀, fun M₂ hM₂ => Ideal.IsMaximal.eq_of_le hM₂ hM₀.ne_top (hle M₂ M₀ hM₂ hM₀)⟩

theorem wc_ring_etale_localization_isDomain : ∀ (R T : Type u) [CommRing R] [IsDomain R] [IsIntegrallyClosed R] [CommRing T] [Algebra R T] [Algebra.Etale R T] (q : Ideal T) [q.IsPrime], IsDomain (Localization.AtPrime q) :=
by
  intro R T _ _ _ _ _ _ q _
  classical

  have s2 : ∀ (K A : Type u) [Field K] [CommRing A] [Algebra K A] [Algebra.Etale K A] (a b : A),
      a * b = 0 → ∃ ε : A, IsIdempotentElem ε ∧ ε * b = 0 ∧ (1 - ε) * a = 0 := by
    intro K A _ _ _ _ a b hab
    obtain ⟨I, _, Ai, hF, hA, e, -⟩ := (Algebra.Etale.iff_exists_algEquiv_prod K A).mp inferInstance
    have hab' : ∀ i, e a i * e b i = 0 := by
      intro i
      have h := congrFun (congrArg e hab) i
      rw [map_mul, map_zero] at h
      exact h
    let ε' : (i : I) → Ai i := fun i => if e a i = 0 then 0 else 1
    have hε' : IsIdempotentElem ε' := by
      show ε' * ε' = ε'
      funext i
      simp only [Pi.mul_apply, ε']
      split_ifs <;> simp
    refine ⟨e.symm ε', hε'.map e.symm, ?_, ?_⟩
    · apply e.injective
      rw [map_mul, AlgEquiv.apply_symm_apply, map_zero]
      funext i
      simp only [Pi.mul_apply, Pi.zero_apply, ε']
      split_ifs with h
      · simp
      · rw [one_mul]
        exact (mul_eq_zero.mp (hab' i)).resolve_left h
    · apply e.injective
      rw [map_mul, map_sub, map_one, AlgEquiv.apply_symm_apply, map_zero]
      funext i
      simp only [Pi.mul_apply, Pi.sub_apply, Pi.one_apply, Pi.zero_apply, ε']
      split_ifs with h
      · rw [h, mul_zero]
      · simp
  let K := FractionRing R
  let S := TensorProduct R T K
  let j : T →ₐ[R] S := Algebra.TensorProduct.includeLeft
  have hj : ∀ t : T, j t = TensorProduct.tmul R t (1 : K) := fun t => rfl
  have hjinj : Function.Injective j :=
    Algebra.TensorProduct.includeLeft_injective (R := R) (S := R) (A := T) (B := K)
      (IsFractionRing.injective R K)

  have hsep : ∀ a b : S, a * b = 0 → ∃ ε : S, IsIdempotentElem ε ∧ ε * b = 0 ∧ (1 - ε) * a = 0 := by
    intro a b hab
    let c : S ≃ₐ[R] TensorProduct R K T := Algebra.TensorProduct.comm R T K
    obtain ⟨ε', hε', h1, h2⟩ := s2 K (TensorProduct R K T) (c a) (c b)
      (by rw [← map_mul, hab, map_zero])
    refine ⟨c.symm ε', hε'.map c.symm, ?_, ?_⟩
    · apply c.injective
      rw [map_mul, AlgEquiv.apply_symm_apply, map_zero]
      exact h1
    · apply c.injective
      rw [map_mul, map_sub, map_one, AlgEquiv.apply_symm_apply, map_zero]
      exact h2

  have hlift : ∀ ε : S, IsIdempotentElem ε → ∃ e : T, j e = ε := by
    intro ε hε
    have hint : IsIntegral T ε := by
      refine ⟨Polynomial.X ^ 2 - Polynomial.X,
        Polynomial.monic_X_pow_sub (Polynomial.degree_X_le.trans_lt (by norm_num)), ?_⟩
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_X, pow_two, hε.eq,
        sub_self]
    obtain ⟨w, hw⟩ := (TensorProduct.toIntegralClosure_bijective_of_smooth (R := R) (S := T)
      (B := K)).2 ⟨ε, (mem_integralClosure_iff T S).mpr hint⟩
    have hw' := congrArg Subtype.val hw
    simp only at hw'
    have key : ∀ w' : TensorProduct R T (integralClosure R K),
        ∃ t : T, ((TensorProduct.toIntegralClosure R T K w' : integralClosure T S) : S) = j t := by
      intro w'
      induction w' using TensorProduct.induction_on with
      | zero => exact ⟨0, by rw [map_zero, map_zero]; rfl⟩
      | tmul t c =>
        have hc : (c : K) ∈ (⊥ : Subalgebra R K) := by
          rw [← IsIntegrallyClosed.integralClosure_eq_bot R K]; exact c.2
        obtain ⟨r, hr⟩ := Algebra.mem_bot.mp hc
        refine ⟨r • t, ?_⟩
        rw [hj]
        change TensorProduct.tmul R t (c : K) = _
        rw [TensorProduct.smul_tmul, ← hr, Algebra.algebraMap_eq_smul_one]
      | add x y hx hy =>
        obtain ⟨t₁, h₁⟩ := hx
        obtain ⟨t₂, h₂⟩ := hy
        exact ⟨t₁ + t₂, by rw [map_add, Subalgebra.coe_add, h₁, h₂, map_add]⟩
    obtain ⟨t, ht⟩ := key w
    exact ⟨t, ht.symm.trans hw'⟩

  have hnzd : NoZeroDivisors (Localization.AtPrime q) := by
    refine ⟨fun {x y} hxy => ?_⟩
    obtain ⟨⟨s, u⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl x
    obtain ⟨⟨s', u'⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl y
    dsimp only at hxy ⊢
    rw [← IsLocalization.mk'_mul] at hxy
    obtain ⟨m, hm⟩ := (IsLocalization.mk'_eq_zero_iff _ _).mp hxy
    obtain ⟨ε, hε, h1, h2⟩ := hsep (j ((m : T) * s)) (j s')
      (by rw [← map_mul, mul_assoc, hm, map_zero])
    obtain ⟨e, rfl⟩ := hlift ε hε
    have he1 : e * s' = 0 := hjinj (by rw [map_mul, h1, map_zero])
    have he2 : (1 - e) * ((m : T) * s) = 0 := hjinj (by rw [map_mul, map_sub, map_one, h2, map_zero])
    have he3 : e * e = e := hjinj (by rw [map_mul]; exact hε.eq)
    set π := algebraMap T (Localization.AtPrime q) with hπ
    have hē : π e * π e = π e := by rw [← map_mul, he3]
    rcases IsLocalRing.isUnit_or_isUnit_one_sub_self (π e) with hu | hu
    · right
      have h1' : π e = 1 := hu.mul_left_cancel (by rw [hē, mul_one])
      have hs' : π s' = 0 := by
        have := congrArg π he1
        rwa [map_mul, h1', one_mul, map_zero] at this
      rw [IsLocalization.mk'_eq_mul_mk'_one, hs', zero_mul]
    · left
      have h0 : π e = 0 := (hu.mul_right_eq_zero).mp (by rw [sub_mul, one_mul, hē, sub_self])
      have hs : π s = 0 := by
        have := congrArg π he2
        rw [map_mul, map_sub, map_one, h0, sub_zero, one_mul, map_mul, map_zero] at this
        exact ((IsLocalization.map_units (Localization.AtPrime q) m).mul_right_eq_zero).mp this
      rw [IsLocalization.mk'_eq_mul_mk'_one, hs, zero_mul]
  exact NoZeroDivisors.to_isDomain _

theorem wc_ring_tensor_isDomain_of_isAlgClosed : ∀ (F R S : Type u) [Field F] [IsAlgClosed F] [CommRing R] [IsDomain R] [Algebra F R] [CommRing S] [IsDomain S] [Algebra F S], IsDomain (TensorProduct F R S) :=
by
  intro F R S _ _ _ _ _ _ _ _
  classical

  have s1 : ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra F A] [Algebra.FiniteType F A]
      (r : A), r ≠ 0 → ∃ φ : A →ₐ[F] F, φ r ≠ 0 := by
    intro A _ _ _ _ r hr
    haveI : IsJacobsonRing A := isJacobsonRing_of_finiteType (A := F)
    have hj : (⊥ : Ideal A).jacobson = ⊥ :=
      IsJacobsonRing.out' _ (Ideal.isRadical_bot_iff.mpr inferInstance)
    have hr' : r ∉ (⊥ : Ideal A).jacobson := by
      rw [hj, Ideal.mem_bot]; exact hr
    rw [Ideal.jacobson, Ideal.mem_sInf] at hr'
    push_neg at hr'
    obtain ⟨M, ⟨-, hM⟩, hrM⟩ := hr'
    haveI := hM
    letI : Field (A ⧸ M) := Ideal.Quotient.field M
    haveI : Algebra.FiniteType F (A ⧸ M) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ F M)
        (Ideal.Quotient.mkₐ_surjective F M)
    haveI : Module.Finite F (A ⧸ M) := finite_of_finite_type_of_isJacobsonRing F (A ⧸ M)
    haveI : Algebra.IsIntegral F (A ⧸ M) := Algebra.IsIntegral.of_finite F _
    have hb : Function.Bijective (algebraMap F (A ⧸ M)) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral
    let e : F ≃ₐ[F] A ⧸ M := AlgEquiv.ofBijective (Algebra.ofId F (A ⧸ M)) hb
    refine ⟨e.symm.toAlgHom.comp (Ideal.Quotient.mkₐ F M), ?_⟩
    intro h0
    apply hrM
    have h1 : Ideal.Quotient.mkₐ F M r = 0 := by
      have h2 := congrArg e h0
      simpa using h2
    exact Ideal.Quotient.eq_zero_iff_mem.mp h1

  have s2 : ∀ z : TensorProduct F R S, ∃ T : Finset R, ∀ A : Subalgebra F R, (↑T : Set R) ⊆ A →
      ∃ w : TensorProduct F A S, Algebra.TensorProduct.map A.val (AlgHom.id F S) w = z := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact ⟨∅, fun A _ => ⟨0, map_zero _⟩⟩
    | tmul r s =>
      refine ⟨{r}, fun A hA => ⟨(⟨r, hA (Finset.mem_singleton_self r)⟩ : A) ⊗ₜ[F] s, ?_⟩⟩
      rw [Algebra.TensorProduct.map_tmul]
      rfl
    | add z₁ z₂ h₁ h₂ =>
      obtain ⟨T₁, hT₁⟩ := h₁
      obtain ⟨T₂, hT₂⟩ := h₂
      refine ⟨T₁ ∪ T₂, fun A hA => ?_⟩
      obtain ⟨w₁, hw₁⟩ := hT₁ A (fun t ht => hA (Finset.mem_union_left T₂ ht))
      obtain ⟨w₂, hw₂⟩ := hT₂ A (fun t ht => hA (Finset.mem_union_right T₁ ht))
      exact ⟨w₁ + w₂, by rw [map_add, hw₁, hw₂]⟩

  have s3 : ∀ (A : Type u) [CommRing A] [Algebra F A] (z : TensorProduct F A S), z ≠ 0 →
      ∃ r : A, r ≠ 0 ∧ ∀ φ : A →ₐ[F] F, φ r ≠ 0 →
        Algebra.TensorProduct.productMap ((Algebra.ofId F S).comp φ) (AlgHom.id F S) z ≠ 0 := by
    intro A _ _ z hz
    let b := Module.Basis.ofVectorSpace F S
    let B := Algebra.TensorProduct.basis A b
    have hc : B.repr z ≠ 0 := by
      intro h
      apply hz
      exact (LinearEquiv.map_eq_zero_iff B.repr).mp h
    obtain ⟨i, hi⟩ : ∃ i, B.repr z i ≠ 0 := by
      by_contra h
      push_neg at h
      exact hc (Finsupp.ext h)
    refine ⟨B.repr z i, hi, fun φ hφ h0 => hφ ?_⟩
    have key : ∀ w : TensorProduct F A S,
        b.repr (Algebra.TensorProduct.productMap ((Algebra.ofId F S).comp φ) (AlgHom.id F S) w) i
          = φ (B.repr w i) := by
      intro w
      induction w using TensorProduct.induction_on with
      | zero => simp
      | tmul a m =>
        have e1 : ((Algebra.ofId F S).comp φ) a * (AlgHom.id F S) m = φ a • m := by
          rw [Algebra.smul_def]; rfl
        rw [Algebra.TensorProduct.productMap_apply_tmul, e1, map_smul, Finsupp.smul_apply,
          smul_eq_mul, Algebra.TensorProduct.basis_repr_tmul, Finsupp.smul_apply,
          Finsupp.mapRange_apply, smul_eq_mul, map_mul, AlgHom.commutes]
        simp
      | add w₁ w₂ h₁ h₂ => simp only [map_add, Finsupp.add_apply, h₁, h₂]
    rw [← key, h0]
    simp

  have hinj : ∀ A : Subalgebra F R,
      Function.Injective (Algebra.TensorProduct.map A.val (AlgHom.id F S)) := by
    intro A
    have h : ⇑(Algebra.TensorProduct.map A.val (AlgHom.id F S)) =
        ⇑(LinearMap.rTensor S A.val.toLinearMap) := by
      funext w
      induction w using TensorProduct.induction_on with
      | zero => simp
      | tmul a s => rw [Algebra.TensorProduct.map_tmul, LinearMap.rTensor_tmul]; rfl
      | add w₁ w₂ h₁ h₂ => rw [map_add, map_add, h₁, h₂]
    rw [h]
    exact Module.Flat.rTensor_preserves_injective_linearMap _ Subtype.val_injective

  haveI : Nontrivial (TensorProduct F R S) :=
    (Algebra.TensorProduct.includeLeft_injective (R := F) (S := F) (A := R) (B := S)
      (algebraMap F S).injective).nontrivial
  haveI : NoZeroDivisors (TensorProduct F R S) := by
    constructor
    intro x y hxy
    by_contra hne
    push_neg at hne
    obtain ⟨hx, hy⟩ := hne
    obtain ⟨Tx, hTx⟩ := s2 x
    obtain ⟨Ty, hTy⟩ := s2 y
    obtain ⟨A, hAx, hAy, hAfg⟩ : ∃ A : Subalgebra F R, (↑Tx : Set R) ⊆ A ∧ (↑Ty : Set R) ⊆ A ∧ A.FG :=
      ⟨Algebra.adjoin F (↑(Tx ∪ Ty) : Set R),
        fun t ht => Algebra.subset_adjoin (Finset.mem_union_left Ty ht),
        fun t ht => Algebra.subset_adjoin (Finset.mem_union_right Tx ht),
        Subalgebra.fg_adjoin_finset _⟩
    obtain ⟨x₀, hx₀⟩ := hTx A hAx
    obtain ⟨y₀, hy₀⟩ := hTy A hAy
    have hx0 : x₀ ≠ 0 := by
      rintro rfl
      exact hx (by rw [← hx₀, map_zero])
    have hy0 : y₀ ≠ 0 := by
      rintro rfl
      exact hy (by rw [← hy₀, map_zero])
    have hxy0 : x₀ * y₀ = 0 := hinj A (by rw [map_mul, hx₀, hy₀, hxy, map_zero])
    haveI : Algebra.FiniteType F A := (Subalgebra.fg_iff_finiteType A).mp hAfg
    obtain ⟨r₁, hr₁, H₁⟩ := s3 A x₀ hx0
    obtain ⟨r₂, hr₂, H₂⟩ := s3 A y₀ hy0
    obtain ⟨φ, hφ⟩ := s1 A (r₁ * r₂) (mul_ne_zero hr₁ hr₂)
    rw [map_mul] at hφ
    have h1 := H₁ φ (left_ne_zero_of_mul hφ)
    have h2 := H₂ φ (right_ne_zero_of_mul hφ)
    apply mul_ne_zero h1 h2
    rw [← map_mul, hxy0, map_zero]
  exact NoZeroDivisors.to_isDomain _

theorem wc_ring_fep_flat_and_base_change : ∀ (P B Q : Type u) [CommRing P] [CommRing B] [CommRing Q] [Algebra P B] [Algebra P Q] (I : Type u) [SmallCategory I] [IsFiltered I] (F : I ⥤ CommRingCat.{u}) (p : ∀ i, P →+* F.obj i) (ι : ∀ i, F.obj i →+* B), (∀ i, (p i).Etale) → (∀ {i j : I} (f : i ⟶ j), (F.map f).hom.comp (p i) = p j) → (∀ {i j : I} (f : i ⟶ j), (ι j).comp (F.map f).hom = ι i) → (∀ i, (ι i).comp (p i) = algebraMap P B) → (∀ b : B, ∃ (i : I) (t : F.obj i), ι i t = b) → (∀ (i : I) (t : F.obj i), ι i t = 0 → ∃ (j : I) (f : i ⟶ j), (F.map f).hom t = 0) → Module.Flat P B ∧ ∃ (G : I → Type u) (_ : ∀ i, CommRing (G i)) (_ : ∀ i, Algebra Q (G i)) (κ : ∀ i, G i →+* TensorProduct P Q B), (∀ i, Algebra.Etale Q (G i)) ∧ (∀ c c' : TensorProduct P Q B, ∃ (i : I) (t t' : G i), κ i t = c ∧ κ i t' = c') ∧ (∀ (i : I) (t : G i), κ i t = 0 → ∃ (j : I) (g : G i →+* G j), (κ j).comp g = κ i ∧ g t = 0) :=
by
  intro P B Q _ _ _ _ _ I _ _ F p ι hEt hb hc hd he hf
  classical

  have hcx : ∀ {i j : I} (f : i ⟶ j) (x : F.obj i), ι j ((F.map f).hom x) = ι i x :=
    fun f x => RingHom.congr_fun (hc f) x
  have hbx : ∀ {i j : I} (f : i ⟶ j) (r : P), (F.map f).hom (p i r) = p j r :=
    fun f r => RingHom.congr_fun (hb f) r
  have hdx : ∀ (i : I) (r : P), ι i (p i r) = algebraMap P B r :=
    fun i r => RingHom.congr_fun (hd i) r
  have hcomp : ∀ {i j k : I} (f : i ⟶ j) (g : j ⟶ k) (x : F.obj i),
      (F.map (f ≫ g)).hom x = (F.map g).hom ((F.map f).hom x) := by
    intro i j k f g x
    simp only [Functor.map_comp, CommRingCat.hom_comp, RingHom.comp_apply]
  have hmax : ∀ a b : I, ∃ (k : I) (_ : a ⟶ k) (_ : b ⟶ k), True :=
    fun a b => ⟨IsFiltered.max a b, IsFiltered.leftToMax a b, IsFiltered.rightToMax a b, trivial⟩
  have hcoeq : ∀ {a b : I} (f g : a ⟶ b), ∃ (k : I) (h : b ⟶ k), f ≫ h = g ≫ h :=
    fun f g => ⟨IsFiltered.coeq f g, IsFiltered.coeqHom f g, IsFiltered.coeq_condition f g⟩

  have hfin : ∀ T : Finset B, ∃ i : I, ∀ b ∈ T, ∃ t : F.obj i, ι i t = b := by
    intro T
    induction T using Finset.induction_on with
    | empty =>
      exact ⟨Classical.choice IsFiltered.nonempty, fun b hb' => absurd hb' (Finset.notMem_empty b)⟩
    | insert y T₀ hy ih =>
      obtain ⟨i₀, h₀⟩ := ih
      obtain ⟨i₁, t₁, ht₁⟩ := he y
      obtain ⟨k, α, β, -⟩ := hmax i₀ i₁
      refine ⟨k, fun b hb' => ?_⟩
      rcases Finset.mem_insert.mp hb' with rfl | hb'
      · exact ⟨(F.map β).hom t₁, by rw [hcx, ht₁]⟩
      · obtain ⟨t, ht⟩ := h₀ b hb'
        exact ⟨(F.map α).hom t, by rw [hcx, ht]⟩

  have hkill : ∀ (i : I) (T : Finset (F.obj i)), (∀ s ∈ T, ι i s = 0) →
      ∃ (j : I) (f : i ⟶ j), ∀ s ∈ T, (F.map f).hom s = 0 := by
    intro i T
    induction T using Finset.induction_on with
    | empty => exact fun _ => ⟨i, 𝟙 i, fun s hs => absurd hs (Finset.notMem_empty s)⟩
    | insert s T₀ hs ih =>
      intro hT
      obtain ⟨j₀, f₀, h₀⟩ := ih (fun s' hs' => hT s' (Finset.mem_insert_of_mem hs'))
      obtain ⟨j₁, f₁, h₁⟩ := hf i s (hT s (Finset.mem_insert_self s T₀))
      obtain ⟨k, α, β, -⟩ := hmax j₀ j₁
      obtain ⟨m, γ, hγ⟩ := hcoeq (f₀ ≫ α) (f₁ ≫ β)
      refine ⟨m, (f₀ ≫ α) ≫ γ, fun s' hs' => ?_⟩
      rcases Finset.mem_insert.mp hs' with rfl | hs'
      · rw [hγ, hcomp, hcomp, h₁, map_zero, map_zero]
      · rw [hcomp, hcomp, h₀ s' hs', map_zero, map_zero]

  have hflat : Module.Flat P B := by
    refine Module.Flat.of_forall_isTrivialRelation (fun {l} {f} {x} hfx => ?_)
    obtain ⟨i, hi⟩ := hfin (Finset.univ.image x)
    choose t ht using fun k => hi (x k) (Finset.mem_image_of_mem x (Finset.mem_univ k))
    have hσ : ι i (∑ k, p i (f k) * t k) = 0 := by
      simp only [map_sum, map_mul, hdx, ht]
      simpa only [Algebra.smul_def] using hfx
    obtain ⟨j, g, hg⟩ := hf i _ hσ
    letI : Algebra P (F.obj j) := (p j).toAlgebra
    haveI : Algebra.Etale P (F.obj j) := RingHom.etale_algebraMap.mp (hEt j)
    obtain ⟨k', a, y, hy, ha⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero (R := P)
        (M := F.obj j) (f := f) (x := fun k => (F.map g).hom (t k)) (by
      have h := hg
      simp only [map_sum, map_mul, hbx] at h
      simp only [Algebra.smul_def, RingHom.algebraMap_toAlgebra]
      exact h)
    beta_reduce at hy
    refine ⟨k', a, fun m => ι j (y m), fun k => ?_, ha⟩
    rw [← ht k, ← hcx g, hy k, map_sum]
    refine Finset.sum_congr rfl (fun m _ => ?_)
    rw [Algebra.smul_def, Algebra.smul_def, map_mul]
    exact congrArg (· * ι j (y m)) (hdx j (a k m))
  haveI := hflat

  letI algP : ∀ i, Algebra P (F.obj i) := fun i => (p i).toAlgebra
  haveI hEtA : ∀ i, Algebra.Etale P (F.obj i) := fun i => RingHom.etale_algebraMap.mp (hEt i)
  let ιA : ∀ i, F.obj i →ₐ[P] B := fun i => { ι i with commutes' := fun r => hdx i r }
  let φA : ∀ {i j : I}, (i ⟶ j) → (F.obj i →ₐ[P] F.obj j) := fun {i j} f =>
    { (F.map f).hom with commutes' := fun r => hbx f r }
  let κ : ∀ i, TensorProduct P Q (F.obj i) →+* TensorProduct P Q B := fun i =>
    (Algebra.TensorProduct.map (AlgHom.id Q Q) (ιA i)).toRingHom
  let gm : ∀ {i j : I}, (i ⟶ j) → (TensorProduct P Q (F.obj i) →+* TensorProduct P Q (F.obj j)) :=
    fun f => (Algebra.TensorProduct.map (AlgHom.id Q Q) (φA f)).toRingHom
  have hκt : ∀ i (q : Q) (x : F.obj i), κ i (TensorProduct.tmul P q x) = TensorProduct.tmul P q (ι i x) :=
    fun i q x => Algebra.TensorProduct.map_tmul (AlgHom.id Q Q) (ιA i) q x
  have hgt : ∀ {i j : I} (f : i ⟶ j) (q : Q) (x : F.obj i),
      gm f (TensorProduct.tmul P q x) = TensorProduct.tmul P q ((F.map f).hom x) :=
    fun f q x => Algebra.TensorProduct.map_tmul (AlgHom.id Q Q) (φA f) q x
  have hcompat : ∀ {i j : I} (f : i ⟶ j), (κ j).comp (gm f) = κ i := by
    intro i j f
    apply RingHom.ext
    intro x
    induction x using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul q y => rw [RingHom.comp_apply, hgt, hκt, hκt, hcx]
    | add x y hx hy =>
      simp only [RingHom.comp_apply, map_add] at hx hy ⊢
      rw [hx, hy]
  have hκg : ∀ {i j : I} (f : i ⟶ j) (t : TensorProduct P Q (F.obj i)), κ j (gm f t) = κ i t :=
    fun f t => RingHom.congr_fun (hcompat f) t

  have hlift : ∀ c : TensorProduct P Q B, ∃ (i : I) (t : TensorProduct P Q (F.obj i)), κ i t = c := by
    intro c
    induction c using TensorProduct.induction_on with
    | zero => exact ⟨Classical.choice IsFiltered.nonempty, 0, map_zero _⟩
    | tmul q b =>
      obtain ⟨i, t, ht⟩ := he b
      exact ⟨i, TensorProduct.tmul P q t, by rw [hκt, ht]⟩
    | add x y hx hy =>
      obtain ⟨i₀, t₀, h₀⟩ := hx
      obtain ⟨i₁, t₁, h₁⟩ := hy
      obtain ⟨k, α, β, -⟩ := hmax i₀ i₁
      exact ⟨k, gm α t₀ + gm β t₁, by rw [map_add, hκg, hκg, h₀, h₁]⟩
  have he2 : ∀ c c' : TensorProduct P Q B, ∃ (i : I) (t t' : TensorProduct P Q (F.obj i)),
      κ i t = c ∧ κ i t' = c' := by
    intro c c'
    obtain ⟨i₀, t₀, h₀⟩ := hlift c
    obtain ⟨i₁, t₁, h₁⟩ := hlift c'
    obtain ⟨k, α, β, -⟩ := hmax i₀ i₁
    exact ⟨k, gm α t₀, gm β t₁, by rw [hκg, h₀], by rw [hκg, h₁]⟩

  have hf2 : ∀ (i : I) (t : TensorProduct P Q (F.obj i)), κ i t = 0 →
      ∃ (j : I) (g : TensorProduct P Q (F.obj i) →+* TensorProduct P Q (F.obj j)),
        (κ j).comp g = κ i ∧ g t = 0 := by
    intro i t ht
    obtain ⟨S, rfl⟩ := TensorProduct.exists_finset t
    have hsum : ∑ z : S, TensorProduct.tmul P z.1.1 (ι i z.1.2) = 0 := by
      refine (Finset.sum_coe_sort S
        (fun z : Q × F.obj i => TensorProduct.tmul P z.1 (ι i z.2))).trans ?_
      rw [map_sum] at ht
      simpa only [hκt] using ht
    have hinj : Function.Injective (LinearMap.rTensor B
        (Submodule.span P (Set.range (fun z : S => z.1.1))).subtype) :=
      Module.Flat.rTensor_preserves_injective_linearMap _ (Submodule.injective_subtype _)
    obtain ⟨k, a, y, hy, ha⟩ :=
      TensorProduct.vanishesTrivially_of_sum_tmul_eq_zero_of_rTensor_injective P hinj hsum
    beta_reduce at hy ha
    obtain ⟨i₁, hi₁⟩ := hfin (Finset.univ.image y)
    choose u hu using fun r => hi₁ (y r) (Finset.mem_image_of_mem y (Finset.mem_univ r))
    obtain ⟨c, α, β, -⟩ := hmax i i₁
    have he0 : ∀ z : S,
        ι c ((F.map α).hom z.1.2 - ∑ r, p c (a z r) * (F.map β).hom (u r)) = 0 := by
      intro z
      simp only [map_sub, map_sum, map_mul, hdx, hcx, hu]
      rw [hy z]
      simp only [Algebra.smul_def, sub_self]
    obtain ⟨d, g, hg⟩ := hkill c (Finset.univ.image
        (fun z : S => (F.map α).hom z.1.2 - ∑ r, p c (a z r) * (F.map β).hom (u r)))
      (by
        intro s hs
        obtain ⟨z, -, rfl⟩ := Finset.mem_image.mp hs
        exact he0 z)
    have hfm : ∀ z : S, (F.map (α ≫ g)).hom z.1.2 =
        ∑ r, a z r • (F.map g).hom ((F.map β).hom (u r)) := by
      intro z
      have h : (F.map g).hom ((F.map α).hom z.1.2 - ∑ r, p c (a z r) * (F.map β).hom (u r)) = 0 :=
        hg _ (Finset.mem_image_of_mem _ (Finset.mem_univ z))
      rw [map_sub, sub_eq_zero, map_sum] at h
      rw [hcomp, h]
      refine Finset.sum_congr rfl (fun r _ => ?_)
      rw [map_mul, hbx, Algebra.smul_def] <;> rfl
    refine ⟨d, gm (α ≫ g), hcompat _, ?_⟩
    rw [map_sum]
    simp only [hgt]
    calc ∑ x ∈ S, TensorProduct.tmul P x.1 ((F.map (α ≫ g)).hom x.2)
        = ∑ z : S, TensorProduct.tmul P z.1.1 ((F.map (α ≫ g)).hom z.1.2) :=
          (Finset.sum_coe_sort S (fun x : Q × F.obj i =>
            TensorProduct.tmul P x.1 ((F.map (α ≫ g)).hom x.2))).symm
      _ = ∑ z : S, ∑ r, TensorProduct.tmul P (a z r • z.1.1)
            ((F.map g).hom ((F.map β).hom (u r))) := by
          refine Finset.sum_congr rfl (fun z _ => ?_)
          rw [hfm z, TensorProduct.tmul_sum]
          refine Finset.sum_congr rfl (fun r _ => ?_)
          rw [TensorProduct.smul_tmul]
      _ = ∑ r, TensorProduct.tmul P (∑ z : S, a z r • z.1.1)
            ((F.map g).hom ((F.map β).hom (u r))) := by
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl (fun r _ => ?_)
          rw [TensorProduct.sum_tmul]
      _ = 0 := by
          simp only [ha, TensorProduct.zero_tmul, Finset.sum_const_zero]
  exact ⟨hflat, fun i => TensorProduct P Q (F.obj i), fun i => inferInstance,
    fun i => inferInstance, κ, fun i => Algebra.Etale.baseChange P (F.obj i) Q, he2, hf2⟩

theorem wc_ring_tensor_domain_of_integralClosure : ∀ (A B Ω : Type u) [CommRing A] [CommRing B] [Field Ω] [Algebra A B] [Algebra A Ω] [Module.Flat A B], IsAlgClosed (FractionRing (integralClosure A Ω)) → (∀ (F R S : Type u) [Field F] [IsAlgClosed F] [CommRing R] [IsDomain R] [Algebra F R] [CommRing S] [IsDomain S] [Algebra F S], IsDomain (TensorProduct F R S)) → IsDomain (TensorProduct A B (integralClosure A Ω)) → IsDomain (TensorProduct A B Ω) :=
by
  intro A B Ω _ _ _ _ _ _ hK h5 hBD
  have s2 : ∀ (D W : Type u) [CommRing D] [IsDomain D] [CommRing W] [IsDomain W] [Algebra D W]
      [Module.Flat D W], IsDomain (TensorProduct D (FractionRing D) W) := by
    intro D W _ _ _ _ _ _
    have hle : Algebra.algebraMapSubmonoid W (nonZeroDivisors D) ≤ nonZeroDivisors W := by
      apply le_nonZeroDivisors_of_noZeroDivisors
      rintro ⟨d, hd, hd0⟩
      have hreg := Module.Flat.isSMulRegular_of_nonZeroDivisors (M := W) hd
      apply one_ne_zero (α := W)
      apply hreg
      simp only
      rw [smul_zero, ← Algebra.algebraMap_eq_smul_one, hd0]
    haveI hloc : IsLocalization (Algebra.algebraMapSubmonoid W (nonZeroDivisors D))
        (TensorProduct D W (FractionRing D)) :=
      IsLocalization.tensor (R := D) (S := W) (FractionRing D) (nonZeroDivisors D)
    haveI : IsDomain (TensorProduct D W (FractionRing D)) :=
      IsLocalization.isDomain_of_le_nonZeroDivisors (TensorProduct D W (FractionRing D)) hle
    exact MulEquiv.isDomain _ (Algebra.TensorProduct.comm D (FractionRing D) W).toRingEquiv.toMulEquiv
  letI : Algebra (FractionRing (integralClosure A Ω)) Ω := FractionRing.liftAlgebra _ Ω
  haveI hW : IsDomain (TensorProduct A (integralClosure A Ω) B) :=
    MulEquiv.isDomain _ (Algebra.TensorProduct.comm A B (integralClosure A Ω)).symm.toRingEquiv.toMulEquiv
  haveI hKW := s2 (integralClosure A Ω) (TensorProduct A (integralClosure A Ω) B)
  haveI hE : IsDomain (TensorProduct A (FractionRing (integralClosure A Ω)) B) :=
    MulEquiv.isDomain _ (Algebra.TensorProduct.cancelBaseChange A (integralClosure A Ω)
      (FractionRing (integralClosure A Ω)) (FractionRing (integralClosure A Ω)) B).symm.toRingEquiv.toMulEquiv
  haveI h4 := h5 (FractionRing (integralClosure A Ω)) Ω
    (TensorProduct A (FractionRing (integralClosure A Ω)) B)
  exact MulEquiv.isDomain _ ((Algebra.TensorProduct.comm A B Ω).toRingEquiv.trans
    (Algebra.TensorProduct.cancelBaseChange A (FractionRing (integralClosure A Ω))
      (FractionRing (integralClosure A Ω)) Ω B).symm.toRingEquiv).toMulEquiv

theorem wc_ring_integralClosure_algClosed_facts : ∀ (A Ω : Type u) [CommRing A] [Field Ω] [IsAlgClosed Ω] [Algebra A Ω], IsIntegrallyClosed (integralClosure A Ω) ∧ IsAlgClosed (FractionRing (integralClosure A Ω)) :=
by
  intro A Ω _ _ _ _
  refine ⟨IsIntegrallyClosed.of_isIntegrallyClosedIn (integralClosure A Ω) Ω, ?_⟩
  have hinj : Function.Injective (algebraMap (integralClosure A Ω) Ω) :=
    FaithfulSMul.algebraMap_injective (integralClosure A Ω) Ω
  let ι : FractionRing (integralClosure A Ω) →+* Ω := IsFractionRing.lift hinj
  have hι : ∀ y : integralClosure A Ω,
      ι (algebraMap (integralClosure A Ω) (FractionRing (integralClosure A Ω)) y) =
        algebraMap (integralClosure A Ω) Ω y :=
    fun y => IsFractionRing.lift_algebraMap hinj y
  have hιcomp : ι.comp (algebraMap (integralClosure A Ω) (FractionRing (integralClosure A Ω))) =
      algebraMap (integralClosure A Ω) Ω := RingHom.ext hι
  have hιinj : Function.Injective ι := ι.injective
  apply IsAlgClosed.of_exists_root
  intro p hmon hirr
  have hdeg : (p.map ι).degree ≠ 0 := by
    rw [Polynomial.degree_map_eq_of_injective hιinj]
    exact (Polynomial.degree_pos_of_irreducible hirr).ne'
  obtain ⟨z, hz⟩ := IsAlgClosed.exists_root (p.map ι) hdeg
  rw [Polynomial.IsRoot, Polynomial.eval_map] at hz
  have hq := IsLocalization.integerNormalization_eval₂_eq_zero
    (nonZeroDivisors (integralClosure A Ω)) ι p hz
  rw [hιcomp] at hq
  have hq0 : IsLocalization.integerNormalization (nonZeroDivisors (integralClosure A Ω)) p ≠ 0 := by
    rw [Ne, IsFractionRing.integerNormalization_eq_zero_iff]
    exact hmon.ne_zero
  have halg : IsAlgebraic (integralClosure A Ω) z :=
    ⟨_, hq0, by rw [Polynomial.aeval_def]; exact hq⟩
  obtain ⟨y, hy0, hyz⟩ := halg.exists_integral_multiple
  have hyzA : IsIntegral A (y • z) := isIntegral_trans _ hyz
  have hmem : y • z ∈ integralClosure A Ω := hyzA
  let w : integralClosure A Ω := ⟨y • z, hmem⟩
  have hyΩ : algebraMap (integralClosure A Ω) Ω y ≠ 0 := by
    intro h
    apply hy0
    exact hinj (by rw [h, map_zero])
  have hw : algebraMap (integralClosure A Ω) Ω w = algebraMap (integralClosure A Ω) Ω y * z := by
    show (y • z : Ω) = _
    rw [Algebra.smul_def]
  refine ⟨algebraMap (integralClosure A Ω) (FractionRing (integralClosure A Ω)) w /
    algebraMap (integralClosure A Ω) (FractionRing (integralClosure A Ω)) y, ?_⟩
  have hx : ι (algebraMap (integralClosure A Ω) (FractionRing (integralClosure A Ω)) w /
      algebraMap (integralClosure A Ω) (FractionRing (integralClosure A Ω)) y) = z := by
    rw [map_div₀, hι, hι, hw, mul_div_cancel_left₀ _ hyΩ]
  apply hιinj
  calc ι (Polynomial.eval _ p)
      = Polynomial.eval₂ ι (ι (algebraMap (integralClosure A Ω) (FractionRing (integralClosure A Ω)) w /
      algebraMap (integralClosure A Ω) (FractionRing (integralClosure A Ω)) y)) p :=
        (Polynomial.eval₂_hom ι _).symm
    _ = Polynomial.eval₂ ι z p := by rw [hx]
    _ = 0 := hz
    _ = ι 0 := (map_zero ι).symm

theorem wc_ring_milnor_fibre_isDomain : ∀ (A B Ω : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] [CommRing B] [IsLocalRing B] [Field Ω] [IsAlgClosed Ω] [Algebra A B] [Algebra A Ω] [IsLocalHom (algebraMap A B)] (β : Polynomial A →+* B), β.comp Polynomial.C = algebraMap A B → (∃ (I : Type u) (_ : SmallCategory I) (_ : IsFiltered I) (F : I ⥤ CommRingCat.{u}) (p : ∀ i, Polynomial A →+* F.obj i) (ι : ∀ i, F.obj i →+* B), (∀ i, (p i).Etale) ∧ (∀ {i j : I} (f : i ⟶ j), (F.map f).hom.comp (p i) = p j) ∧ (∀ {i j : I} (f : i ⟶ j), (ι j).comp (F.map f).hom = ι i) ∧ (∀ i, (ι i).comp (p i) = β) ∧ (∀ b : B, ∃ (i : I) (t : F.obj i), ι i t = b) ∧ (∀ (i : I) (t : F.obj i), ι i t = 0 → ∃ (j : I) (f : i ⟶ j), (F.map f).hom t = 0)) → IsDomain (TensorProduct A B Ω) :=
by
  intro A B Ω _ _ _ _ _ _ _ _ _ _ β hβ hFEP
  obtain ⟨I, _, _, F, p, ι, hEt, hb, hc, hd, he, hf⟩ := hFEP


  have s9 : ∀ (C : Type u) [CommRing C] [IsLocalRing C] (J : Type u) (G : J → Type u)
      [∀ j, CommRing (G j)] (κ : ∀ j, G j →+* C),
      (∀ (j : J) (q : Ideal (G j)) [q.IsPrime], IsDomain (Localization.AtPrime q)) →
      (∀ c c' : C, ∃ (j : J) (t t' : G j), κ j t = c ∧ κ j t' = c') →
      (∀ (j : J) (t : G j), κ j t = 0 → ∃ (j' : J) (g : G j →+* G j'), (κ j').comp g = κ j ∧ g t = 0) →
      ∀ c c' : C, c * c' = 0 → c = 0 ∨ c' = 0 := by
    intro C _ _ J G _ κ hloc he2 hf2

    have kill : ∀ (j' : J) (x : G j'),
        algebraMap (G j') (Localization.AtPrime
          (Ideal.comap (κ j') (IsLocalRing.maximalIdeal C))) x = 0 → κ j' x = 0 := by
      intro j' x hx
      obtain ⟨u, hu⟩ := (IsLocalization.map_eq_zero_iff
        (Ideal.comap (κ j') (IsLocalRing.maximalIdeal C)).primeCompl _ x).mp hx
      have hu' : κ j' (u : G j') ∉ IsLocalRing.maximalIdeal C := u.2
      have hunit : IsUnit (κ j' (u : G j')) := by
        by_contra hn
        exact hu' ((IsLocalRing.mem_maximalIdeal _).mpr hn)
      have h2 := congrArg (κ j') hu
      rw [map_mul, map_zero] at h2
      exact hunit.mul_right_eq_zero.mp h2
    intro c c' hcc'
    obtain ⟨j, t, t', rfl, rfl⟩ := he2 c c'
    obtain ⟨j', g, hg, hgt⟩ := hf2 j (t * t') (by rw [map_mul, hcc'])
    have hκ : ∀ s, κ j s = κ j' (g s) := fun s => by rw [← hg]; rfl
    haveI : (Ideal.comap (κ j') (IsLocalRing.maximalIdeal C)).IsPrime := Ideal.comap_isPrime _ _
    haveI := hloc j' (Ideal.comap (κ j') (IsLocalRing.maximalIdeal C))
    have hx : algebraMap (G j') (Localization.AtPrime
          (Ideal.comap (κ j') (IsLocalRing.maximalIdeal C))) (g t) *
        algebraMap (G j') (Localization.AtPrime
          (Ideal.comap (κ j') (IsLocalRing.maximalIdeal C))) (g t') = 0 := by
      rw [← map_mul, ← map_mul, hgt, map_zero]
    rcases mul_eq_zero.mp hx with h | h
    · left; rw [hκ]; exact kill j' _ h
    · right; rw [hκ]; exact kill j' _ h

  haveI hDdom : IsDomain (integralClosure A Ω) := Subalgebra.isDomain _
  haveI hDint : Algebra.IsIntegral A (integralClosure A Ω) := integralClosure.AlgebraIsIntegral
  haveI hDloc : IsLocalRing (integralClosure A Ω) :=
    wc_ring_henselian_integral_domain_isLocalRing A (integralClosure A Ω)
      (fun S' _ _ _ P _ _ h => wc_ring_henselian_etale_section A S' P h)

  obtain ⟨hIC, hAC⟩ := wc_ring_integralClosure_algClosed_facts A Ω
  haveI := hIC

  have s10 : ∀ (D : Type u) [CommRing D] [Algebra A D], ∃ (_ : Algebra (Polynomial A) B)
      (_ : Algebra (Polynomial A) (Polynomial D)), algebraMap (Polynomial A) B = β ∧
      algebraMap (Polynomial A) (Polynomial D) = Polynomial.mapRingHom (algebraMap A D) ∧
      Nonempty (TensorProduct (Polynomial A) (Polynomial D) B ≃+* TensorProduct A B D) := by
    intro D _ _
    letI iB : Algebra (Polynomial A) B := β.toAlgebra
    letI iD : Algebra (Polynomial A) (Polynomial D) :=
      (Polynomial.mapRingHom (algebraMap A D)).toAlgebra
    refine ⟨iB, iD, rfl, rfl, ?_⟩
    haveI : IsScalarTower A (Polynomial A) B := IsScalarTower.of_algebraMap_eq (fun a => by
      rw [← hβ]
      rfl)
    let e0 : Polynomial D ≃+* TensorProduct A (Polynomial A) D :=
      ((polyEquivTensor A D).trans (Algebra.TensorProduct.comm A D (Polynomial A))).toRingEquiv
    have he0 : ∀ f : Polynomial A, e0 (algebraMap (Polynomial A) (Polynomial D) f) =
        algebraMap (Polynomial A) (TensorProduct A (Polynomial A) D) f := by
      intro f
      have key : e0.toRingHom.comp (Polynomial.mapRingHom (algebraMap A D)) =
          algebraMap (Polynomial A) (TensorProduct A (Polynomial A) D) := by
        apply Polynomial.ringHom_ext
        · intro a
          simp only [e0, RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_C]
          simp [polyEquivTensor_apply, Algebra.algebraMap_eq_smul_one]
          try rw [Algebra.TensorProduct.one_def]
          simp only [TensorProduct.smul_tmul', Polynomial.smul_eq_C_mul, smul_eq_mul]
        · simp only [e0, RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_X]
          simp [polyEquivTensor_apply, Algebra.TensorProduct.algebraMap_apply]
      exact RingHom.congr_fun key f
    let e : Polynomial D ≃ₐ[Polynomial A] TensorProduct A (Polynomial A) D :=
      AlgEquiv.ofRingEquiv (f := e0) he0
    exact ⟨((Algebra.TensorProduct.comm (Polynomial A) (Polynomial D) B).trans
        ((Algebra.TensorProduct.congr AlgEquiv.refl e).trans
         (Algebra.TensorProduct.cancelBaseChange A (Polynomial A) (Polynomial A) B D))).toRingEquiv⟩
  obtain ⟨_, _, hPB, hPQ, ⟨Φ⟩⟩ := s10 (integralClosure A Ω)

  obtain ⟨hflat, G, _, _, κ, hGet, he2, hf2⟩ :=
    wc_ring_fep_flat_and_base_change (Polynomial A) B (Polynomial (integralClosure A Ω)) I F p ι
      hEt hb hc (fun i => (hd i).trans hPB.symm) he hf

  haveI : IsScalarTower A (Polynomial A) B := IsScalarTower.of_algebraMap_eq (fun a => by
    rw [hPB, Polynomial.algebraMap_apply, ← hβ]
    simp)
  haveI := hflat
  haveI hBflat : Module.Flat A B := Module.Flat.trans A (Polynomial A) B

  haveI : Module.FaithfullyFlat A B := Module.FaithfullyFlat.of_flat_of_isLocalHom

  haveI : Nontrivial (TensorProduct A B (integralClosure A Ω)) :=
    Module.FaithfullyFlat.lTensor_nontrivial A B (integralClosure A Ω)

  haveI : IsLocalRing (TensorProduct A B (integralClosure A Ω)) :=
    wc_ring_tensor_isLocalRing_of_sepClosed A B (integralClosure A Ω)
  haveI : Nontrivial (TensorProduct (Polynomial A) (Polynomial (integralClosure A Ω)) B) :=
    Φ.symm.injective.nontrivial
  haveI : IsLocalRing (TensorProduct (Polynomial A) (Polynomial (integralClosure A Ω)) B) :=
    IsLocalRing.of_surjective' Φ.symm.toRingHom Φ.symm.surjective

  have hnzd := s9 _ I G κ (fun j q _ => by
      haveI := hGet j
      exact wc_ring_etale_localization_isDomain (Polynomial (integralClosure A Ω)) (G j) q)
    he2 hf2
  haveI : NoZeroDivisors (TensorProduct (Polynomial A) (Polynomial (integralClosure A Ω)) B) :=
    ⟨fun {c c'} h => hnzd c c' h⟩
  haveI hdom : IsDomain (TensorProduct (Polynomial A) (Polynomial (integralClosure A Ω)) B) :=
    NoZeroDivisors.to_isDomain (TensorProduct (Polynomial A) (Polynomial (integralClosure A Ω)) B)
  haveI hdom' : IsDomain (TensorProduct A B (integralClosure A Ω)) :=
    MulEquiv.isDomain _ Φ.symm.toMulEquiv

  exact wc_ring_tensor_domain_of_integralClosure A B Ω hAC wc_ring_tensor_isDomain_of_isAlgClosed hdom'

theorem wc_et_milnor_fibre_connected : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (s : Spec (.of A) ⟶ Spec (.of K)) (x : wcHalA1 s), IsClosed ({x} : Set (wcHalA1 s)) → wcHalA1Proj s x = IsLocalRing.closedPoint A → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcHalA1 s) x)) (Scheme.Etale.forget (wcHalA1 s))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ wcHalA1 s), wcHalShData x B Λ W' φ a → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A)), Nat.card (wcEtCoh (Limits.pullback (a ≫ wcHalA1Proj s) z) ℓ 0) = ℓ :=
by
  intro K _ _ ℓ hℓ hℓK A _ _ _ s x hx hxc B _ _ _ Λ _ _ W' φ a hd Ω _ _ z

  have c2 : ∀ (R S T : Type u) [CommRing R] [CommRing S] [CommRing T] [Algebra R S] [Algebra R T],
      IsDomain (TensorProduct R S T) →
      IrreducibleSpace ↥(Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap R S)))
        (Spec.map (CommRingCat.ofHom (algebraMap R T))) : Scheme.{u}) := by
    intro R S T _ _ _ _ _ hD
    have h1 : IrreducibleSpace (PrimeSpectrum (TensorProduct R S T)) := PrimeSpectrum.irreducibleSpace
    have h2 : IsIrreducible (⊤ : Set (Spec (CommRingCat.of (TensorProduct R S T)))) :=
      (irreducibleSpace_def _).mp h1
    have h3 := h2.image (Scheme.homeoOfIso (pullbackSpecIso R S T)).symm
      (Homeomorph.continuous _).continuousOn
    rw [Set.top_eq_univ, Set.image_univ, Homeomorph.range_coe] at h3
    exact (irreducibleSpace_def _).mpr h3

  have c3 : ∀ (s' : Spec (.of A) ⟶ Spec (.of K)), ∃ e : wcHalA1 s' ≅ Spec (.of (Polynomial A)),
      e.hom ≫ Spec.map (CommRingCat.ofHom (Polynomial.C : A →+* Polynomial A)) = wcHalA1Proj s' := by
    intro s'
    obtain ⟨σ, rfl⟩ : ∃ σ : K →+* A, s' = Spec.map (CommRingCat.ofHom σ) :=
      ⟨(Spec.preimage s').hom, by rw [CommRingCat.ofHom_hom, Spec.map_preimage]⟩
    letI : Algebra K A := σ.toAlgebra
    let ψ : CommRingCat.of (Polynomial A) ≅ CommRingCat.of (TensorProduct K A (Polynomial K)) :=
      (polyEquivTensor K A).toRingEquiv.toCommRingCatIso
    have hψ : CommRingCat.ofHom (Polynomial.C : A →+* Polynomial A) ≫ ψ.hom =
        CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
          A →+* TensorProduct K A (Polynomial K)) := by
      ext a
      change polyEquivTensor K A (Polynomial.C a) = a ⊗ₜ[K] (1 : Polynomial K)
      simp [polyEquivTensor_apply]
    refine ⟨pullbackSpecIso K A (Polynomial K) ≪≫ Scheme.Spec.mapIso ψ.op, ?_⟩
    rw [Iso.trans_hom, Category.assoc]
    change (pullbackSpecIso K A (Polynomial K)).hom ≫ Spec.map ψ.hom ≫
      Spec.map (CommRingCat.ofHom (Polynomial.C : A →+* Polynomial A)) = _
    rw [← Spec.map_comp, hψ, pullbackSpecIso_hom_fst]

  let pB : ↥(Spec (.of B)) := IsLocalRing.closedPoint B
  have c5 : a pB = x := by
    obtain ⟨-, -, -, -, -, e0, -, he0⟩ := hd
    obtain ⟨pt⟩ : Nonempty ↥(Spec (.of (AlgebraicClosure ((wcHalA1 s).residueField x)))) :=
      ⟨IsLocalRing.closedPoint _⟩
    have h := congrArg
      (fun f : Spec (.of (AlgebraicClosure ((wcHalA1 s).residueField x))) ⟶ wcHalA1 s => f pt) he0
    have h2 : (Spec.map (CommRingCat.ofHom e0) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))
        ≫ a) pt = a pB := by
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
      exact congrArg a (IsLocalRing.PrimeSpectrum.comap_residue B _)
    have h3 : (wcEtGeomPt (wcHalA1 s) x) pt = x := by
      rw [Scheme.Hom.comp_apply]
      exact Scheme.fromSpecResidueField_apply x _
    exact h2.symm.trans ((congrArg (fun y => y) h).trans h3)

  obtain ⟨e, he⟩ := c3 s
  obtain ⟨β, hβ, hFEP⟩ :=
    wc_shdata_filtered_etale_presentation x B Λ W' φ a hd (Polynomial A) e
  have hα : Spec.map (CommRingCat.ofHom (β.comp Polynomial.C)) = a ≫ wcHalA1Proj s := by
    rw [CommRingCat.ofHom_comp, Spec.map_comp, hβ, Category.assoc, he]
  letI : Algebra A B := (β.comp Polynomial.C).toAlgebra
  haveI hloc : IsLocalHom (algebraMap A B) := by
    rw [IsLocalRing.isLocalHom_iff_comap_closedPoint]
    have h1 := congrArg (fun f : Spec (.of B) ⟶ Spec (.of A) => f pB) hα
    simp only at h1
    rw [Scheme.Hom.comp_apply, c5] at h1
    exact h1.trans hxc
  let ζ : A →+* Ω := (Spec.preimage z).hom
  have hz : z = Spec.map (CommRingCat.ofHom ζ) := by
    simp only [ζ, CommRingCat.ofHom_hom, Spec.map_preimage]
  letI : Algebra A Ω := ζ.toAlgebra
  haveI hdom : IsDomain (TensorProduct A B Ω) :=
    wc_ring_milnor_fibre_isDomain A B Ω β rfl hFEP
  have hconn : ConnectedSpace ↥(Limits.pullback (a ≫ wcHalA1Proj s) z : Scheme.{u}) := by
    have key : ∀ (f : Spec (.of B) ⟶ Spec (.of A)) (g : Spec (.of Ω) ⟶ Spec (.of A)),
        f = Spec.map (CommRingCat.ofHom (algebraMap A B)) →
        g = Spec.map (CommRingCat.ofHom (algebraMap A Ω)) →
        ConnectedSpace ↥(Limits.pullback f g : Scheme.{u}) := by
      rintro f g rfl rfl
      haveI := c2 A B Ω hdom
      exact IrreducibleSpace.connectedSpace _
    exact key _ _ hα.symm hz
  exact wc_et_coh_zero_connected_card _ ℓ hℓ.ne_zero

theorem wc_et_h1_subsingleton_of_torsor_sections : ∀ (X : Scheme.{u}) (m : ℕ), m ≠ 0 → (∀ (P : Scheme.{u}) (p : P ⟶ X) (α : ZMod m → (P ⟶ P)), wcFetTorsor p m α → ∃ σ : X ⟶ P, σ ≫ p = 𝟙 X) → Subsingleton (wcEtCoh X m 1) :=
by
  intro X m hm hsec
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
  haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) :=
    wc_et_enough_injectives X

  have s3 : ∀ (A B : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}),
      (∀ (E : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (f : B ⟶ E) (g : E ⟶ A)
        (w : f ≫ g = 0), (ShortComplex.mk f g w).ShortExact → ∃ s : A ⟶ E, s ≫ g = 𝟙 A) →
      ∀ ξ : Abelian.Ext A B 1, ξ = 0 := by
    intro A B hsplit ξ
    let ι := Injective.ι B
    let T := ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)
    have hT : T.ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) inferInstance inferInstance
    have h0 : ξ.comp (Abelian.Ext.mk₀ T.f) (add_zero 1) = 0 := Abelian.Ext.eq_zero_of_injective _
    obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ A hT ξ h0 (zero_add 1)
    let h := Abelian.Ext.homEquiv₀ x₃
    have hx : Abelian.Ext.mk₀ h = x₃ := Abelian.Ext.mk₀_homEquiv₀_apply x₃
    have hw0 : ι ≫ Limits.cokernel.π ι = (0 : B ⟶ A) ≫ h := by
      rw [Limits.cokernel.condition, Limits.zero_comp]
    let f : B ⟶ Limits.pullback (Limits.cokernel.π ι) h := Limits.pullback.lift ι 0 hw0
    let g : Limits.pullback (Limits.cokernel.π ι) h ⟶ A := Limits.pullback.snd _ _
    have hf1 : f ≫ Limits.pullback.fst _ _ = ι := Limits.pullback.lift_fst _ _ _
    have hf2 : f ≫ g = 0 := Limits.pullback.lift_snd _ _ _
    haveI : Mono f := mono_of_mono_fac hf1
    haveI : Epi g := Abelian.epi_pullback_of_epi_f _ _
    have hex : (ShortComplex.mk f g hf2).Exact := by
      refine ShortComplex.exact_of_f_is_kernel _
        (Limits.KernelFork.IsLimit.ofι' f hf2 (fun {Z} k hk => ?_))
      have hk' : (k ≫ Limits.pullback.fst _ _) ≫ T.g = 0 := by
        change (k ≫ Limits.pullback.fst _ _) ≫ Limits.cokernel.π ι = 0
        rw [Category.assoc, Limits.pullback.condition, ← Category.assoc]
        change (k ≫ g) ≫ h = 0
        rw [hk, Limits.zero_comp]
      haveI : Mono T.f := hT.mono_f
      refine ⟨hT.exact.lift (k ≫ Limits.pullback.fst _ _) hk', ?_⟩
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hf1]
        exact hT.exact.lift_f _ hk'
      · rw [Category.assoc]
        change _ ≫ (f ≫ g) = k ≫ g
        rw [hf2, hk, Limits.comp_zero]
    have hSE : (ShortComplex.mk f g hf2).ShortExact :=
      ShortComplex.ShortExact.mk' hex inferInstance inferInstance
    obtain ⟨s, hs⟩ := hsplit _ f g hf2 hSE
    have hfac : h = (s ≫ Limits.pullback.fst _ _) ≫ Limits.cokernel.π ι := by
      rw [Category.assoc, Limits.pullback.condition, ← Category.assoc]
      change h = (s ≫ g) ≫ h
      rw [hs, Category.id_comp]
    have hz : (Abelian.Ext.mk₀ T.g).comp hT.extClass (zero_add 1) = 0 := hT.comp_extClass
    rw [← hx₃, ← hx, hfac, ← Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.comp_assoc_of_second_deg_zero]
    change (Abelian.Ext.mk₀ (s ≫ Limits.pullback.fst _ _)).comp
      ((Abelian.Ext.mk₀ T.g).comp hT.extClass (zero_add 1)) _ = 0
    rw [hz, Abelian.Ext.comp_zero]

  have s2 : ∀ (E : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
      (g : E ⟶ (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) (T₀ : X.Etale) (hT₀ : Limits.IsTerminal T₀)
      (t : E.obj.obj (Opposite.op T₀)),
      (g.hom.app (Opposite.op T₀)).hom t = wcConstSec X (ULift.{u+1} ℤ) T₀ (ULift.up 1) →
      ∃ s : (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ E, s ≫ g = 𝟙 _ := by
    intro E g T₀ hT₀ t ht
    let α : (Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ E.obj :=
      { app := fun U => AddCommGrpCat.ofHom
          ((zmultiplesHom _ ((E.obj.map (hT₀.from U.unop).op).hom t)).comp
            AddEquiv.ulift.toAddMonoidHom)
        naturality := by
          intro U V f
          ext n
          have hr : (hT₀.from V.unop).op = (hT₀.from U.unop).op ≫ f :=
            Quiver.Hom.unop_inj (hT₀.hom_ext _ _)
          change n.down • (E.obj.map (hT₀.from V.unop).op).hom t =
            (E.obj.map f).hom (n.down • (E.obj.map (hT₀.from U.unop).op).hom t)
          rw [hr, Functor.map_comp, map_zsmul]
          rfl }
    let s0 : sheafify (Scheme.smallEtaleTopology X)
        ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ⟶ E.obj :=
      sheafifyLift (Scheme.smallEtaleTopology X) α E.property
    refine ⟨ObjectProperty.homMk s0, ?_⟩
    apply Sheaf.hom_ext
    change s0 ≫ g.hom = 𝟙 (sheafify (Scheme.smallEtaleTopology X)
        ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))))
    apply sheafify_hom_ext (Scheme.smallEtaleTopology X) _ _
      ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))).property
    rw [← Category.assoc, toSheafify_sheafifyLift]
    change α ≫ g.hom = toSheafify (Scheme.smallEtaleTopology X)
      ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
    ext U n
    change (g.hom.app U).hom (n.down • (E.obj.map (hT₀.from U.unop).op).hom t) =
      ((toSheafify (Scheme.smallEtaleTopology X)
        ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))).app U).hom n
    have hg := congrArg (fun φ => φ.hom t) (g.hom.naturality (hT₀.from U.unop).op)
    have hτ := congrArg (fun φ => φ.hom (ULift.up (1 : ℤ)))
      ((toSheafify (Scheme.smallEtaleTopology X)
        ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))).naturality
          (hT₀.from U.unop).op)
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] at hg hτ
    rw [map_zsmul, hg, ht]
    unfold wcConstSec
    erw [← hτ]
    change n.down • ((toSheafify (Scheme.smallEtaleTopology X)
        ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))).app U).hom
          (ULift.up (1 : ℤ)) =
      ((toSheafify (Scheme.smallEtaleTopology X)
        ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))).app U).hom n
    rw [← map_zsmul]
    congr 1
    apply ULift.ext
    change n.down • (1 : ℤ) = n.down
    rw [smul_eq_mul, mul_one]

  haveI : MorphismProperty.ContainsIdentities @Etale := ⟨fun Y => inferInstance⟩
  let T₀ : X.Etale := MorphismProperty.Over.mk ⊤ (𝟙 X) (inferInstance : Etale (𝟙 X))
  have hT₀ : Limits.IsTerminal T₀ := MorphismProperty.Over.mkIdTerminal @Etale X

  have key := s3 ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ)))
    ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) (fun E f g w hS => by
      obtain ⟨Pt, p, a, hP, hiff⟩ := wc_et_ses_split_torsor_sections X m hm E f g w hS
      obtain ⟨σ, hσ⟩ := hsec Pt p a hP
      obtain ⟨t, ht⟩ := (hiff T₀).mp ⟨σ, hσ⟩
      exact s2 E g T₀ hT₀ t ht)
  change Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
    ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) 1)
  exact ⟨fun a b => (key a).trans (key b).symm⟩

theorem wc_lim_cone_cartesian_base_change : ∀ (I : Type u) [SmallCategory I] [IsCofiltered I] (G E : I ⥤ Scheme.{u}) (S T : Scheme.{u}) (g : T ⟶ S) (t : G ⟶ (Functor.const I).obj S) (fs : E ⟶ G) (sn : E ⟶ (Functor.const I).obj T), (∀ j, IsPullback (fs.app j) (sn.app j) (t.app j) g) → ∀ (c : Limits.Cone G), Limits.IsLimit c → ∀ (hX : c.pt ⟶ S), (∀ j, c.π.app j ≫ t.app j = hX) → ∀ (cE : Limits.Cone E) (u : cE.pt ⟶ c.pt) (v : cE.pt ⟶ T), IsPullback u v hX g → (∀ j, cE.π.app j ≫ fs.app j = u ≫ c.π.app j) → (∀ j, cE.π.app j ≫ sn.app j = v) → Nonempty (Limits.IsLimit cE) :=
by
  intro I _ _ G E S T g t fs sn hpb c hc hX ht cE u v hP hu hv
  obtain ⟨j₀⟩ : Nonempty I := IsCofiltered.nonempty
  have hind1 : ∀ (s : Limits.Cone E) {k j : I} (f : k ⟶ j),
      s.π.app k ≫ sn.app k = s.π.app j ≫ sn.app j := by
    intro s k j f
    have h1 := s.w f
    have h2 := sn.naturality f
    rw [← h1, Category.assoc, h2]
    exact (congrArg (s.π.app k ≫ ·) (Category.comp_id (sn.app k))).symm
  have hind : ∀ (s : Limits.Cone E) (j j' : I),
      s.π.app j ≫ sn.app j = s.π.app j' ≫ sn.app j' := fun s j j' =>
    (hind1 s (IsCofiltered.minToLeft j j')).symm.trans (hind1 s (IsCofiltered.minToRight j j'))
  let sG : Limits.Cone E → Limits.Cone G := fun s => Limits.Cone.mk s.pt (s.π ≫ fs)
  have ha : ∀ (s : Limits.Cone E) (j : I),
      hc.lift (sG s) ≫ c.π.app j = s.π.app j ≫ fs.app j := fun s j => hc.fac (sG s) j
  have hw : ∀ s : Limits.Cone E, hc.lift (sG s) ≫ hX = (s.π.app j₀ ≫ sn.app j₀) ≫ g := by
    intro s
    rw [← ht j₀, ← Category.assoc, ha, Category.assoc, (hpb j₀).w, Category.assoc]
  refine ⟨Limits.IsLimit.mk
    (fun s => hP.lift (hc.lift (sG s)) (s.π.app j₀ ≫ sn.app j₀) (hw s)) ?_ ?_⟩
  · intro s j
    apply (hpb j).hom_ext
    · rw [Category.assoc, hu j, ← Category.assoc, hP.lift_fst, ha]
    · rw [Category.assoc, hv j, hP.lift_snd, hind s j₀ j]
  · intro s m hm
    apply hP.hom_ext
    · rw [hP.lift_fst]
      apply hc.hom_ext
      intro j
      rw [ha, Category.assoc, ← hu j, ← Category.assoc, hm j]
    · rw [hP.lift_snd, ← hv j₀, ← Category.assoc, hm j₀]

theorem wc_lim_closed_empty_stage : ∀ (I : Type u) [SmallCategory I] [IsCofiltered I] (D : I ⥤ Scheme.{u}) (c : Limits.Cone D), Limits.IsLimit c → (∀ {i j : I} (f : i ⟶ j), IsAffineHom (D.map f)) → (∀ i, CompactSpace (D.obj i)) → ∀ (i : I) (Z : Set (D.obj i)), IsClosed Z → (c.π.app i) ⁻¹' Z = ∅ → ∃ (i' : I) (f : i' ⟶ i), (D.map f) ⁻¹' Z = ∅ :=
by
  intro I _ _ D c hc htrans hcpt i Z hZ hempty
  by_contra hne
  push_neg at hne
  have hne' : ∀ (i' : I) (f : i' ⟶ i), ((D.map f) ⁻¹' Z).Nonempty :=
    fun i' f => hne i' f
  haveI : ∀ {a b : I} (f : a ⟶ b), IsAffineHom (D.map f) := fun f => htrans f
  obtain ⟨s, hs⟩ := AlgebraicGeometry.exists_mem_of_isClosed_of_nonempty' D c hc
    (j := i) (fun i' f => (D.map f) ⁻¹' Z)
    (fun i' f => hZ.preimage (D.map f).continuous)
    (fun i' f => hne' i' f)
    (fun i' f => by
      haveI := hcpt i'
      exact (hZ.preimage (D.map f).continuous).isCompact)
    (fun a b g h x hx => by
      simp only [Set.mem_preimage, Functor.map_comp, Scheme.Hom.comp_apply] at hx ⊢
      exact hx)
  have h1 := hs i (𝟙 i)
  simp only [Set.mem_preimage] at h1
  rw [← Scheme.Hom.comp_apply, c.w (𝟙 i)] at h1
  have h2 : s ∈ (c.π.app i) ⁻¹' Z := h1
  rw [hempty] at h2
  exact h2

theorem wc_fet_action_stage_descend : ∀ (I : Type u) [SmallCategory I] [IsCofiltered I] (D : I ⥤ Scheme.{u}) (c : Limits.Cone D), Limits.IsLimit c → (∀ {i j : I} (f : i ⟶ j), IsAffineHom (D.map f)) → (∀ i, IsAffine (D.obj i)) → ∀ (i : I) (V V₀ : Scheme.{u}) (q : V ⟶ D.obj i) (p₀ : V₀ ⟶ c.pt) (j₀ : V₀ ⟶ V), IsFinite q → Etale q → ∀ (hj₀ : IsPullback j₀ p₀ q (c.π.app i)) (m : ℕ), m ≠ 0 → ∀ (a₀ : ZMod m → (V₀ ⟶ V₀)), (∀ g, a₀ g ≫ p₀ = p₀) → a₀ 0 = 𝟙 V₀ → (∀ g g', a₀ (g + g') = a₀ g' ≫ a₀ g) → ∃ (i' : I) (f : i' ⟶ i) (a : ZMod m → (Limits.pullback q (D.map f) ⟶ Limits.pullback q (D.map f))), (∀ g, a g ≫ Limits.pullback.snd q (D.map f) = Limits.pullback.snd q (D.map f)) ∧ a 0 = 𝟙 _ ∧ (∀ g g', a (g + g') = a g' ≫ a g) ∧ ∀ g, Limits.pullback.lift j₀ (p₀ ≫ c.π.app i') (by rw [Category.assoc, c.w f]; exact hj₀.w) ≫ a g = a₀ g ≫ Limits.pullback.lift j₀ (p₀ ≫ c.π.app i') (by rw [Category.assoc, c.w f]; exact hj₀.w) :=
by
  intro I _ _ D c hc htr haff i V V₀ q p₀ j₀ hqf hqe hj₀ m hm a₀ hact hzero hadd
  classical
  haveI : NeZero m := ⟨hm⟩
  haveI := hqf
  haveI := hqe
  haveI : ∀ {i j : I} (f : i ⟶ j), IsAffineHom (D.map f) := htr
  haveI : ∀ i, IsAffine (D.obj i) := haff
  haveI : IsAffine V := isAffine_of_isAffineHom q

  let E' : Over i ⥤ Scheme.{u} :=
    { obj := fun k => Limits.pullback q (D.map k.hom)
      map := fun {k k'} h => Limits.pullback.lift (Limits.pullback.fst q (D.map k.hom))
        (Limits.pullback.snd q (D.map k.hom) ≫ D.map h.left)
        (by rw [Category.assoc, ← Functor.map_comp, Over.w h]; exact Limits.pullback.condition)
      map_id := fun k => by
        apply Limits.pullback.hom_ext <;> simp
      map_comp := fun {k k' k''} h h' => by
        apply Limits.pullback.hom_ext
        · try simp only [Category.assoc]
          erw [Limits.pullback.lift_fst, Limits.pullback.lift_fst, Limits.pullback.lift_fst]
        · try simp only [Category.assoc]
          erw [Limits.pullback.lift_snd, Limits.pullback.lift_snd, Limits.pullback.lift_snd_assoc]
          try simp only [Over.comp_left, Functor.map_comp, Category.assoc] }
  have hF1 : ∀ {k k' : Over i} (h : k ⟶ k'),
      E'.map h ≫ Limits.pullback.fst q (D.map k'.hom) = Limits.pullback.fst q (D.map k.hom) :=
    fun h => Limits.pullback.lift_fst _ _ _
  have hF2 : ∀ {k k' : Over i} (h : k ⟶ k'),
      E'.map h ≫ Limits.pullback.snd q (D.map k'.hom) =
        Limits.pullback.snd q (D.map k.hom) ≫ D.map h.left :=
    fun h => Limits.pullback.lift_snd _ _ _

  have hw : ∀ k : Over i, j₀ ≫ q = (p₀ ≫ c.π.app k.left) ≫ D.map k.hom := fun k => by
    rw [Category.assoc, c.w k.hom]; exact hj₀.w
  let ρ : (Functor.const (Over i)).obj V₀ ⟶ E' :=
    { app := fun k => Limits.pullback.lift j₀ (p₀ ≫ c.π.app k.left) (hw k)
      naturality := fun k k' h => by
        show 𝟙 V₀ ≫ _ = _
        rw [Category.id_comp]
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, hF1 h, Limits.pullback.lift_fst, Limits.pullback.lift_fst]
        · rw [Category.assoc, hF2 h, Limits.pullback.lift_snd, Limits.pullback.lift_snd_assoc,
            Category.assoc, c.w h.left] }
  have hρf : ∀ k : Over i, ρ.app k ≫ Limits.pullback.fst q (D.map k.hom) = j₀ :=
    fun k => Limits.pullback.lift_fst _ _ _
  have hρs : ∀ k : Over i, ρ.app k ≫ Limits.pullback.snd q (D.map k.hom) = p₀ ≫ c.π.app k.left :=
    fun k => Limits.pullback.lift_snd _ _ _
  have hρw : ∀ {k k' : Over i} (h : k ⟶ k'), ρ.app k ≫ E'.map h = ρ.app k' :=
    fun h => (ρ.naturality h).symm.trans (Category.id_comp _)
  let cE' : Limits.Cone E' := Limits.Cone.mk V₀ ρ

  haveI : (Over.forget i).Initial := Over.initial_forget i
  have hcw : Limits.IsLimit (c.whisker (Over.forget i)) :=
    (Functor.Initial.isLimitWhiskerEquiv (Over.forget i) c).symm hc
  let tD : Over.forget i ⋙ D ⟶ (Functor.const (Over i)).obj (D.obj i) :=
    { app := fun k => D.map k.hom
      naturality := fun k k' h => by
        show D.map h.left ≫ D.map k'.hom = D.map k.hom ≫ 𝟙 _
        rw [← Functor.map_comp, Over.w h, Category.comp_id] }
  let fs : E' ⟶ Over.forget i ⋙ D :=
    { app := fun k => Limits.pullback.snd q (D.map k.hom)
      naturality := fun k k' h => hF2 h }
  let sn : E' ⟶ (Functor.const (Over i)).obj V :=
    { app := fun k => Limits.pullback.fst q (D.map k.hom)
      naturality := fun k k' h => (hF1 h).trans (Category.comp_id _).symm }
  have wc_lim_cone_cartesian_base_change : ∀ (I : Type u) [SmallCategory I] [IsCofiltered I] (G E : I ⥤ Scheme.{u}) (S T : Scheme.{u}) (g : T ⟶ S) (t : G ⟶ (Functor.const I).obj S) (fs : E ⟶ G) (sn : E ⟶ (Functor.const I).obj T), (∀ j, IsPullback (fs.app j) (sn.app j) (t.app j) g) → ∀ (c : Limits.Cone G), Limits.IsLimit c → ∀ (hX : c.pt ⟶ S), (∀ j, c.π.app j ≫ t.app j = hX) → ∀ (cE : Limits.Cone E) (u : cE.pt ⟶ c.pt) (v : cE.pt ⟶ T), IsPullback u v hX g → (∀ j, cE.π.app j ≫ fs.app j = u ≫ c.π.app j) → (∀ j, cE.π.app j ≫ sn.app j = v) → Nonempty (Limits.IsLimit cE) := by
    intro I _ _ G E S T g t fs sn hpb c hc hX ht cE u v hP hu hv
    obtain ⟨j₀⟩ : Nonempty I := IsCofiltered.nonempty
    have hind1 : ∀ (s : Limits.Cone E) {k j : I} (f : k ⟶ j),
        s.π.app k ≫ sn.app k = s.π.app j ≫ sn.app j := by
      intro s k j f
      have h1 := s.w f
      have h2 := sn.naturality f
      rw [← h1, Category.assoc, h2]
      exact (congrArg (s.π.app k ≫ ·) (Category.comp_id (sn.app k))).symm
    have hind : ∀ (s : Limits.Cone E) (j j' : I),
        s.π.app j ≫ sn.app j = s.π.app j' ≫ sn.app j' := fun s j j' =>
      (hind1 s (IsCofiltered.minToLeft j j')).symm.trans (hind1 s (IsCofiltered.minToRight j j'))
    let sG : Limits.Cone E → Limits.Cone G := fun s => Limits.Cone.mk s.pt (s.π ≫ fs)
    have ha : ∀ (s : Limits.Cone E) (j : I),
        hc.lift (sG s) ≫ c.π.app j = s.π.app j ≫ fs.app j := fun s j => hc.fac (sG s) j
    have hw : ∀ s : Limits.Cone E, hc.lift (sG s) ≫ hX = (s.π.app j₀ ≫ sn.app j₀) ≫ g := by
      intro s
      rw [← ht j₀, ← Category.assoc, ha, Category.assoc, (hpb j₀).w, Category.assoc]
    refine ⟨Limits.IsLimit.mk
      (fun s => hP.lift (hc.lift (sG s)) (s.π.app j₀ ≫ sn.app j₀) (hw s)) ?_ ?_⟩
    · intro s j
      apply (hpb j).hom_ext
      · rw [Category.assoc, hu j, ← Category.assoc, hP.lift_fst, ha]
      · rw [Category.assoc, hv j, hP.lift_snd, hind s j₀ j]
    · intro s m hm
      apply hP.hom_ext
      · rw [hP.lift_fst]
        apply hc.hom_ext
        intro j
        rw [ha, Category.assoc, ← hu j, ← Category.assoc, hm j]
      · rw [hP.lift_snd, ← hv j₀, ← Category.assoc, hm j₀]
  obtain ⟨hρ⟩ := wc_lim_cone_cartesian_base_change (Over i) (Over.forget i ⋙ D) E' (D.obj i) V q
    tD fs sn (fun k => (IsPullback.of_hasPullback q (D.map k.hom)).flip)
    (c.whisker (Over.forget i)) hcw (c.π.app i) (fun k => c.w k.hom) cE' p₀ j₀ hj₀.flip
    (fun k => Limits.pullback.lift_snd _ _ _) (fun k => Limits.pullback.lift_fst _ _ _)

  haveI : ∀ k, IsAffine (E'.obj k) := fun k => by
    show IsAffine (Limits.pullback q (D.map k.hom)); infer_instance
  haveI : ∀ {k k' : Over i} (h : k ⟶ k'), IsAffineHom (E'.map h) := fun h => inferInstance
  haveI : ∀ k, CompactSpace (E'.obj k) := fun k => inferInstance
  haveI : ∀ k, QuasiSeparatedSpace (E'.obj k) := fun k => inferInstance

  let t : E' ⟶ (Functor.const (Over i)).obj (D.obj i) :=
    { app := fun k => Limits.pullback.fst q (D.map k.hom) ≫ q
      naturality := fun k k' h => by
        show E'.map h ≫ Limits.pullback.fst q (D.map k'.hom) ≫ q =
          (Limits.pullback.fst q (D.map k.hom) ≫ q) ≫ 𝟙 _
        rw [← Category.assoc, hF1 h, Category.comp_id] }
  have htnat : ∀ {k k' : Over i} (h : k ⟶ k'), E'.map h ≫ t.app k' = t.app k := fun h => by
    show E'.map h ≫ Limits.pullback.fst _ _ ≫ q = Limits.pullback.fst _ _ ≫ q
    rw [← Category.assoc, hF1 h]
  have hF3 : ∀ (k : Over i) (u : E'.obj k ⟶ E'.obj k),
      u ≫ Limits.pullback.snd q (D.map k.hom) = Limits.pullback.snd q (D.map k.hom) →
      u ≫ Limits.pullback.fst q (D.map k.hom) ≫ q = t.app k := by
    intro k u hu
    show u ≫ Limits.pullback.fst q (D.map k.hom) ≫ q = Limits.pullback.fst q (D.map k.hom) ≫ q
    rw [Limits.pullback.condition, ← Category.assoc, hu]

  obtain ⟨k₁, b, hb1, hb2⟩ : ∃ (k : Over i) (b : ZMod m → (E'.obj k ⟶ V)),
      (∀ x, ρ.app k ≫ b x = a₀ x ≫ j₀) ∧ ∀ x, b x ≫ q = t.app k := by
    have H : ∀ x : ZMod m, ∃ (k : Over i) (g : E'.obj k ⟶ V),
        ρ.app k ≫ g = a₀ x ≫ j₀ ∧ g ≫ q = t.app k := by
      intro x
      apply Scheme.exists_π_app_comp_eq_of_locallyOfFinitePresentation E' t q cE' hρ (a₀ x ≫ j₀)
      ext k
      show ρ.app k ≫ (Limits.pullback.fst q (D.map k.hom) ≫ q) = (a₀ x ≫ j₀) ≫ q
      rw [← Category.assoc, hρf, Category.assoc, hj₀.w, ← Category.assoc, hact]
    choose kx g hg1 hg2 using H
    obtain ⟨k, hk⟩ := IsCofiltered.inf_objs_exists (Finset.univ.image kx)
    have e : ∀ x, k ⟶ kx x := fun x => (hk (Finset.mem_image_of_mem kx (Finset.mem_univ x))).some
    refine ⟨k, fun x => E'.map (e x) ≫ g x, fun x => ?_, fun x => ?_⟩
    · rw [← Category.assoc, hρw (e x)]
      exact hg1 x
    · rw [Category.assoc, hg2 x, htnat]

  let A : ZMod m → (E'.obj k₁ ⟶ E'.obj k₁) := fun x =>
    Limits.pullback.lift (b x) (Limits.pullback.snd q (D.map k₁.hom))
      (by rw [hb2 x]; exact Limits.pullback.condition)
  have hA1 : ∀ x, A x ≫ Limits.pullback.snd q (D.map k₁.hom) = Limits.pullback.snd q (D.map k₁.hom) :=
    fun x => Limits.pullback.lift_snd _ _ _
  have hA2 : ∀ x, A x ≫ Limits.pullback.fst q (D.map k₁.hom) = b x :=
    fun x => Limits.pullback.lift_fst _ _ _
  have hA3 : ∀ x, ρ.app k₁ ≫ A x = a₀ x ≫ ρ.app k₁ := by
    intro x
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hA2, hb1, Category.assoc, hρf]
    · rw [Category.assoc, hA1, Category.assoc, hρs, ← Category.assoc, hact]

  have famEq : ∀ {ι : Type} (S : Finset ι) (u₁ u₂ : ι → (E'.obj k₁ ⟶ V)),
      (∀ x, u₁ x ≫ q = t.app k₁) → (∀ x, u₂ x ≫ q = t.app k₁) →
      (∀ x, ρ.app k₁ ≫ u₁ x = ρ.app k₁ ≫ u₂ x) →
      ∃ (k₂ : Over i) (h : k₂ ⟶ k₁), ∀ x ∈ S, E'.map h ≫ u₁ x = E'.map h ≫ u₂ x := by
    intro ι S u₁ u₂ h1 h2 h3
    induction S using Finset.induction_on with
    | empty => exact ⟨k₁, 𝟙 k₁, fun x hx => absurd hx (Finset.notMem_empty x)⟩
    | insert x S hx ih =>
      obtain ⟨k', h, hh⟩ := ih
      obtain ⟨k'', h', hh'⟩ := Scheme.exists_hom_comp_eq_comp_of_locallyOfFiniteType E' t q cE' hρ
        (i := k') (E'.map h ≫ u₁ x) (E'.map h ≫ u₂ x)
        (by rw [Category.assoc, h1, htnat]) (by rw [Category.assoc, h2, htnat])
        (by
          show ρ.app k' ≫ E'.map h ≫ u₁ x = ρ.app k' ≫ E'.map h ≫ u₂ x
          rw [← Category.assoc, hρw h, h3, ← Category.assoc, hρw h])
      refine ⟨k'', h' ≫ h, fun y hy => ?_⟩
      rw [Functor.map_comp, Category.assoc, Category.assoc]
      rcases Finset.mem_insert.mp hy with rfl | hy
      · exact hh'
      · rw [hh y hy]
  let u₁ : Option (ZMod m × ZMod m) → (E'.obj k₁ ⟶ V) := fun y =>
    Option.elim y (A 0 ≫ Limits.pullback.fst q (D.map k₁.hom))
      (fun gg => A (gg.1 + gg.2) ≫ Limits.pullback.fst q (D.map k₁.hom))
  let u₂ : Option (ZMod m × ZMod m) → (E'.obj k₁ ⟶ V) := fun y =>
    Option.elim y (Limits.pullback.fst q (D.map k₁.hom))
      (fun gg => (A gg.2 ≫ A gg.1) ≫ Limits.pullback.fst q (D.map k₁.hom))
  have hpair : ∀ g g' : ZMod m,
      (A g' ≫ A g) ≫ Limits.pullback.snd q (D.map k₁.hom) = Limits.pullback.snd q (D.map k₁.hom) :=
    fun g g' => by rw [Category.assoc, hA1, hA1]
  obtain ⟨k₂, h, hh⟩ := famEq Finset.univ u₁ u₂
    (by
      rintro (_ | ⟨g, g'⟩)
      · exact (Category.assoc _ _ _).trans (hF3 k₁ (A 0) (hA1 0))
      · exact (Category.assoc _ _ _).trans (hF3 k₁ (A (g + g')) (hA1 _)))
    (by
      rintro (_ | ⟨g, g'⟩)
      · rfl
      · exact (Category.assoc _ _ _).trans (hF3 k₁ (A g' ≫ A g) (hpair g g')))
    (by
      rintro (_ | ⟨g, g'⟩)
      · show ρ.app k₁ ≫ A 0 ≫ Limits.pullback.fst q (D.map k₁.hom) =
          ρ.app k₁ ≫ Limits.pullback.fst q (D.map k₁.hom)
        rw [← Category.assoc, hA3, hzero, Category.id_comp]
      · show ρ.app k₁ ≫ A (g + g') ≫ Limits.pullback.fst q (D.map k₁.hom) =
          ρ.app k₁ ≫ (A g' ≫ A g) ≫ Limits.pullback.fst q (D.map k₁.hom)
        rw [← Category.assoc, hA3, hadd]
        simp only [Category.assoc]
        rw [← Category.assoc (ρ.app k₁) (A g'), hA3, Category.assoc,
          ← Category.assoc (ρ.app k₁) (A g), hA3, Category.assoc])
  have hE1 : E'.map h ≫ A 0 = E'.map h := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc]; exact hh none (Finset.mem_univ _)
    · rw [Category.assoc, hA1]
  have hE2 : ∀ g g', E'.map h ≫ A (g + g') = E'.map h ≫ A g' ≫ A g := by
    intro g g'
    apply Limits.pullback.hom_ext
    · have := hh (some (g, g')) (Finset.mem_univ _)
      simp only [u₁, u₂, Option.elim, Category.assoc] at this ⊢
      exact this
    · simp only [Category.assoc, hA1]

  have wit : ∀ x, (E'.map h ≫ A x ≫ Limits.pullback.fst q (D.map k₁.hom)) ≫ q =
      Limits.pullback.snd q (D.map k₂.hom) ≫ D.map k₂.hom := by
    intro x
    rw [Category.assoc, Category.assoc, Limits.pullback.condition, ← Category.assoc (A x), hA1,
      ← Category.assoc (E'.map h), hF2 h, Category.assoc, ← Functor.map_comp, Over.w h]
  let a : ZMod m → (Limits.pullback q (D.map k₂.hom) ⟶ Limits.pullback q (D.map k₂.hom)) :=
    fun x => Limits.pullback.lift (E'.map h ≫ A x ≫ Limits.pullback.fst q (D.map k₁.hom))
      (Limits.pullback.snd q (D.map k₂.hom)) (wit x)
  have haf : ∀ x, a x ≫ Limits.pullback.fst q (D.map k₂.hom) =
      E'.map h ≫ A x ≫ Limits.pullback.fst q (D.map k₁.hom) :=
    fun x => Limits.pullback.lift_fst _ _ _
  have has : ∀ x, a x ≫ Limits.pullback.snd q (D.map k₂.hom) = Limits.pullback.snd q (D.map k₂.hom) :=
    fun x => Limits.pullback.lift_snd _ _ _
  have hK : ∀ x, a x ≫ E'.map h = E'.map h ≫ A x := by
    intro x
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc]
      rw [hF1 h, haf]
    · simp only [Category.assoc]
      rw [hA1, hF2 h, ← Category.assoc, has]
  have r2 : a 0 = 𝟙 _ := by
    apply Limits.pullback.hom_ext
    · rw [haf, ← Category.assoc, hE1, hF1 h, Category.id_comp]
    · rw [has, Category.id_comp]
  have r3 : ∀ g g', a (g + g') = a g' ≫ a g := by
    intro g g'
    apply Limits.pullback.hom_ext
    · rw [haf, Category.assoc, haf, ← Category.assoc (a g'), hK,
        ← Category.assoc (E'.map h) (A (g + g')), hE2]
      simp only [Category.assoc]
    · rw [has, Category.assoc, has, has]
  have r4 : ∀ g, ρ.app k₂ ≫ a g = a₀ g ≫ ρ.app k₂ := by
    intro g
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc, haf, hρf]
      rw [← Category.assoc (ρ.app k₂), hρw h, ← Category.assoc, hA3, Category.assoc, hρf]
    · rw [Category.assoc, has, Category.assoc, hρs, ← Category.assoc, hact]
  exact ⟨k₂.left, k₂.hom, a, has, r2, r3, r4⟩

theorem wc_fet_torsor_closed_bad_locus : ∀ {V D : Scheme.{u}} (q : V ⟶ D) (m : ℕ) (a : ZMod m → (V ⟶ V)), m ≠ 0 → IsFinite q → Etale q → (∀ g, a g ≫ q = q) → a 0 = 𝟙 V → (∀ g g', a (g + g') = a g' ≫ a g) → ∃ Z : Set D, IsClosed Z ∧ ∀ (X V₀ : Scheme.{u}) (φ : X ⟶ D) (p₀ : V₀ ⟶ X) (j₀ : V₀ ⟶ V) (a₀ : ZMod m → (V₀ ⟶ V₀)), IsPullback j₀ p₀ q φ → (∀ g, a₀ g ≫ p₀ = p₀) → (∀ g, a₀ g ≫ j₀ = j₀ ≫ a g) → (wcFetTorsor p₀ m a₀ ↔ φ ⁻¹' Z = ∅) :=
by
  intro V D q m a hm hqf hqe ha_p ha0 hadd
  classical
  haveI : NeZero m := ⟨hm⟩
  haveI := hqf
  haveI := hqe

  have hgraph : ∀ {W Y : Scheme.{u}} (p : W ⟶ Y) (b : W ⟶ W) (hb : b ≫ p = p),
      IsFinite p → Etale p →
      IsOpenImmersion (Limits.pullback.lift b (𝟙 W) (hb.trans (Category.id_comp p).symm)) ∧
      IsClosed (Set.range (Limits.pullback.lift b (𝟙 W) (hb.trans (Category.id_comp p).symm))) := by
    intro W Y p b hb hpf hpe
    haveI := hpf
    haveI := hpe
    have G2 : Limits.pullback.lift b (𝟙 W) (hb.trans (Category.id_comp p).symm) ≫
        Limits.pullback.snd p p = 𝟙 W := Limits.pullback.lift_snd _ _ _
    generalize Limits.pullback.lift b (𝟙 W) (hb.trans (Category.id_comp p).symm) = G at G2 ⊢
    haveI : Mono G := mono_of_mono_fac G2
    haveI : Etale G := by
      apply MorphismProperty.of_postcomp (W := @Etale) (W' := @Etale) _
        (Limits.pullback.snd p p) inferInstance
      rw [G2]; infer_instance
    haveI : IsClosedImmersion (G ≫ Limits.pullback.snd p p) := by rw [G2]; infer_instance
    haveI : IsClosedImmersion G := IsClosedImmersion.of_comp G (Limits.pullback.snd p p)
    exact ⟨IsOpenImmersion.of_flat_of_mono G, G.isClosedEmbedding.isClosed_range⟩
  let Γ : ZMod m → (V ⟶ Limits.pullback q q) := fun g =>
    Limits.pullback.lift (a g) (𝟙 V) ((ha_p g).trans (Category.id_comp q).symm)
  have hΓ : ∀ g, IsOpenImmersion (Γ g) ∧ IsClosed (Set.range (Γ g)) :=
    fun g => hgraph q (a g) (ha_p g) hqf hqe
  have Γ1 : ∀ g, Γ g ≫ Limits.pullback.fst q q = a g := fun g => Limits.pullback.lift_fst _ _ _
  have Γ2 : ∀ g, Γ g ≫ Limits.pullback.snd q q = 𝟙 V := fun g => Limits.pullback.lift_snd _ _ _
  let R : ZMod m → Set ↥(Limits.pullback q q) := fun g => Set.range ⇑(Γ g)
  let Bad : Set ↥(Limits.pullback q q) := (⋃ g, R g)ᶜ ∪
    ⋃ (g : ZMod m), ⋃ (g' : ZMod m), ⋃ (_ : g ≠ g'), (R g ∩ R g')
  have hBad : IsClosed Bad := by
    apply IsClosed.union
    · apply IsOpen.isClosed_compl
      apply isOpen_iUnion
      intro g
      haveI := (hΓ g).1
      exact IsOpenImmersion.isOpen_range (Γ g)
    · apply isClosed_iUnion_of_finite
      intro g
      apply isClosed_iUnion_of_finite
      intro g'
      apply isClosed_iUnion_of_finite
      intro _
      exact (hΓ g).2.inter (hΓ g').2
  have hr : IsClosedMap ⇑(Limits.pullback.snd q q ≫ q) := Scheme.Hom.isClosedMap _
  have hqo : IsOpen (Set.range ⇑q) := (Scheme.Hom.isOpenMap q).isOpen_range
  refine ⟨⇑(Limits.pullback.snd q q ≫ q) '' Bad ∪ (Set.range ⇑q)ᶜ,
    (hr _ hBad).union hqo.isClosed_compl, ?_⟩
  intro X V₀ φ p₀ j₀ a₀ hj₀ ha₀p he
  let Γ₀ : ZMod m → (V₀ ⟶ Limits.pullback p₀ p₀) := fun g =>
    Limits.pullback.lift (a₀ g) (𝟙 V₀) ((ha₀p g).trans (Category.id_comp p₀).symm)
  have Γ01 : ∀ g, Γ₀ g ≫ Limits.pullback.fst p₀ p₀ = a₀ g :=
    fun g => Limits.pullback.lift_fst _ _ _
  have Γ02 : ∀ g, Γ₀ g ≫ Limits.pullback.snd p₀ p₀ = 𝟙 V₀ :=
    fun g => Limits.pullback.lift_snd _ _ _
  let κ := Limits.pullback.map p₀ p₀ q q j₀ j₀ φ hj₀.w.symm hj₀.w.symm
  have κ1 : κ ≫ Limits.pullback.fst q q = Limits.pullback.fst p₀ p₀ ≫ j₀ :=
    Limits.pullback.lift_fst _ _ _
  have κ2 : κ ≫ Limits.pullback.snd q q = Limits.pullback.snd p₀ p₀ ≫ j₀ :=
    Limits.pullback.lift_snd _ _ _

  have K : ∀ g, Γ₀ g ≫ κ = j₀ ≫ Γ g := by
    intro g
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc]
      rw [κ1, reassoc_of% (Γ01 g), Γ1, he g]
    · simp only [Category.assoc]
      rw [κ2, reassoc_of% (Γ02 g), Γ2, Category.comp_id]
  have L : ∀ g {T : Scheme.{u}} (t₁ : T ⟶ V) (t₂ : T ⟶ Limits.pullback p₀ p₀),
      t₁ ≫ Γ g = t₂ ≫ κ → (t₂ ≫ Limits.pullback.snd p₀ p₀) ≫ Γ₀ g = t₂ := by
    intro g T t₁ t₂ ht
    have e1 : t₂ ≫ Limits.pullback.fst p₀ p₀ ≫ j₀ = t₁ ≫ a g := by
      rw [← κ1, ← Category.assoc, ← ht, Category.assoc, Γ1]
    have e2 : t₂ ≫ Limits.pullback.snd p₀ p₀ ≫ j₀ = t₁ := by
      rw [← κ2, ← Category.assoc, ← ht, Category.assoc, Γ2, Category.comp_id]
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc]
      rw [Γ01]
      apply hj₀.hom_ext
      · simp only [Category.assoc]
        rw [he g, reassoc_of% e2, e1]
      · simp only [Category.assoc]
        rw [ha₀p g, Limits.pullback.condition]
    · simp only [Category.assoc]
      rw [Γ02, Category.comp_id]
  have hG : ∀ g, ⇑κ ⁻¹' Set.range (Γ g) = Set.range (Γ₀ g) := by
    intro g
    ext z
    constructor
    · intro hz
      have hzT : z ∈ Set.range (Limits.pullback.snd (Γ g) κ) := by
        rw [Scheme.Pullback.range_snd]; exact hz
      obtain ⟨w, rfl⟩ := hzT
      have hL := L g (Limits.pullback.fst (Γ g) κ) (Limits.pullback.snd (Γ g) κ)
        Limits.pullback.condition
      refine ⟨(Limits.pullback.snd (Γ g) κ ≫ Limits.pullback.snd p₀ p₀) w, ?_⟩
      have := Scheme.Hom.comp_apply (Limits.pullback.snd (Γ g) κ ≫ Limits.pullback.snd p₀ p₀)
        (Γ₀ g) w
      rw [hL] at this
      exact this.symm
    · rintro ⟨v, rfl⟩
      refine ⟨j₀ v, ?_⟩
      have := Scheme.Hom.comp_apply (Γ₀ g) κ v
      rw [K g, Scheme.Hom.comp_apply] at this
      exact this

  have hs : IsPullback (κ ≫ Limits.pullback.fst q q) (Limits.pullback.snd p₀ p₀) q (j₀ ≫ q) := by
    rw [κ1, hj₀.w]
    exact (IsPullback.of_hasPullback p₀ p₀).paste_horiz hj₀
  have hbig : IsPullback κ (Limits.pullback.snd p₀ p₀ ≫ p₀) (Limits.pullback.snd q q ≫ q) φ :=
    (IsPullback.of_right hs κ2 (IsPullback.of_hasPullback q q)).paste_vert hj₀
  have hR : ∀ z, (Limits.pullback.snd q q ≫ q) (κ z) =
      φ ((Limits.pullback.snd p₀ p₀ ≫ p₀) z) := by
    intro z
    have e : κ ≫ Limits.pullback.snd q q ≫ q = (Limits.pullback.snd p₀ p₀ ≫ p₀) ≫ φ := by
      simp only [Category.assoc]
      rw [reassoc_of% κ2, hj₀.w]
    have h1 := Scheme.Hom.comp_apply κ (Limits.pullback.snd q q ≫ q) z
    have h2 := Scheme.Hom.comp_apply (Limits.pullback.snd p₀ p₀ ≫ p₀) φ z
    rw [e] at h1
    exact h1.symm.trans h2
  constructor
  ·
    intro T
    have hcov : ⋃ g, Set.range (Γ₀ g) = Set.univ := T.graph_cover
    have hdisj : Pairwise fun g g' => Disjoint (Set.range (Γ₀ g)) (Set.range (Γ₀ g')) :=
      T.graph_disj
    rw [Set.eq_empty_iff_forall_notMem]
    intro x hx
    rcases hx with ⟨y, hy, hyx⟩ | hx
    · obtain ⟨z, rfl, _⟩ := Scheme.exists_preimage_of_isPullback hbig y x hyx
      rcases hy with hy | hy
      · apply hy
        have hc : z ∈ ⋃ g, Set.range (Γ₀ g) := by rw [hcov]; exact Set.mem_univ _
        obtain ⟨g, hg⟩ := Set.mem_iUnion.mp hc
        rw [← hG g] at hg
        exact Set.mem_iUnion.mpr ⟨g, hg⟩
      · obtain ⟨g, hy⟩ := Set.mem_iUnion.mp hy
        obtain ⟨g', hy⟩ := Set.mem_iUnion.mp hy
        obtain ⟨hgg', hy⟩ := Set.mem_iUnion.mp hy
        obtain ⟨h1, h2⟩ := hy
        have h1' : z ∈ ⇑κ ⁻¹' Set.range (Γ g) := h1
        have h2' : z ∈ ⇑κ ⁻¹' Set.range (Γ g') := h2
        rw [hG g] at h1'
        rw [hG g'] at h2'
        exact Set.disjoint_left.mp (hdisj hgg') h1' h2'
    · apply hx
      have hsr : x ∈ Set.range p₀ := by rw [T.surj]; exact Set.mem_univ _
      obtain ⟨v₀, rfl⟩ := hsr
      refine ⟨j₀ v₀, ?_⟩
      have h1 := Scheme.Hom.comp_apply j₀ q v₀
      have h2 := Scheme.Hom.comp_apply p₀ φ v₀
      rw [hj₀.w] at h1
      exact h1.symm.trans h2
  ·
    intro hZ
    have hnot : ∀ x, φ x ∉ ⇑(Limits.pullback.snd q q ≫ q) '' Bad ∪ (Set.range ⇑q)ᶜ := by
      intro x hx
      have hx' : x ∈ ⇑φ ⁻¹' (⇑(Limits.pullback.snd q q ≫ q) '' Bad ∪ (Set.range ⇑q)ᶜ) := hx
      rw [hZ] at hx'
      exact hx'
    haveI hp₀f : IsFinite p₀ := MorphismProperty.of_isPullback (P := @IsFinite) hj₀ hqf
    haveI hp₀e : Etale p₀ := MorphismProperty.of_isPullback (P := @Etale) hj₀ hqe
    have hsurj : Set.range p₀ = Set.univ := by
      apply Set.eq_univ_of_forall
      intro x
      have hx : φ x ∈ Set.range q := by
        by_contra h
        exact hnot x (Or.inr h)
      obtain ⟨v, hv⟩ := hx
      obtain ⟨v₀, _, hv₀⟩ := Scheme.exists_preimage_of_isPullback hj₀ v x hv
      exact ⟨v₀, hv₀⟩
    have act_zero : a₀ 0 = 𝟙 V₀ := by
      apply hj₀.hom_ext
      · rw [he 0, ha0, Category.comp_id, Category.id_comp]
      · rw [ha₀p 0, Category.id_comp]
    have act_add : ∀ g g', a₀ (g + g') = a₀ g' ≫ a₀ g := by
      intro g g'
      apply hj₀.hom_ext
      · rw [he, hadd]
        simp only [Category.assoc]
        rw [he g, reassoc_of% (he g')]
      · simp only [Category.assoc, ha₀p]
    have hC : ∀ z, κ z ∉ Bad := by
      intro z hz
      apply hnot ((Limits.pullback.snd p₀ p₀ ≫ p₀) z)
      left
      exact ⟨κ z, hz, hR z⟩
    have hdisj : Pairwise fun g g' => Disjoint (Set.range (Γ₀ g)) (Set.range (Γ₀ g')) := by
      intro g g' hgg'
      rw [Set.disjoint_left]
      intro z h1 h2
      rw [← hG g] at h1
      rw [← hG g'] at h2
      apply hC z
      right
      exact Set.mem_iUnion.mpr ⟨g, Set.mem_iUnion.mpr ⟨g', Set.mem_iUnion.mpr ⟨hgg', h1, h2⟩⟩⟩
    have hcover : ⋃ g, Set.range (Γ₀ g) = Set.univ := by
      apply Set.eq_univ_of_forall
      intro z
      have h : κ z ∈ ⋃ g, Set.range (Γ g) := by
        by_contra h
        exact hC z (Or.inl h)
      obtain ⟨g, hg⟩ := Set.mem_iUnion.mp h
      have hg' : z ∈ ⇑κ ⁻¹' Set.range (Γ g) := hg
      rw [hG g] at hg'
      exact Set.mem_iUnion.mpr ⟨g, hg'⟩
    exact ⟨hp₀f, hp₀e, hsurj, ha₀p, act_zero, act_add,
      fun g => (hgraph p₀ (a₀ g) (ha₀p g) hp₀f hp₀e).1, hdisj, hcover⟩

theorem wc_fet_torsor_cofiltered_limit_descent : ∀ (S T X₀ : Scheme.{u}) [IsAffine S] [IsAffine T] (g : T ⟶ S) (π₀ : X₀ ⟶ S) (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (F : Λ ⥤ Over X₀) (Y : Scheme.{u}) (h : Y ⟶ S) (π : ∀ l, Y ⟶ (F.obj l).left) (hπ : ∀ l, π l ≫ (F.obj l).hom ≫ π₀ = h), (∀ l, IsAffine (F.obj l).left) → (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ (F.map t).left = π l') → (∀ (T' : Scheme.{u}) (zz : ∀ l, T' ⟶ (F.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), zz l ≫ (F.map t).left = zz l') → ∃! z₀ : T' ⟶ Y, ∀ l, z₀ ≫ π l = zz l) → ∀ (m : ℕ), m ≠ 0 → ∀ (P : Scheme.{u}) (p : P ⟶ Limits.pullback h g) (α : ZMod m → (P ⟶ P)), wcFetTorsor p m α → ∃ (l : Λ) (Pl : Scheme.{u}) (pl : Pl ⟶ Limits.pullback ((F.obj l).hom ≫ π₀) g) (αl : ZMod m → (Pl ⟶ Pl)) (j : P ⟶ Pl), wcFetTorsor pl m αl ∧ IsPullback j p pl (Limits.pullback.lift (Limits.pullback.fst h g ≫ π l) (Limits.pullback.snd h g) (by rw [Category.assoc, hπ l]; exact Limits.pullback.condition)) :=
by
  intro S T X₀ _ _ g π₀ Λ _ _ F Y h π hπ haff hcompat hlim m hm P p α hP

  let E : Λ ⥤ Scheme.{u} :=
    { obj := fun l => Limits.pullback ((F.obj l).hom ≫ π₀) g
      map := fun {l l'} t => Limits.pullback.lift
        (Limits.pullback.fst ((F.obj l).hom ≫ π₀) g ≫ (F.map t).left)
        (Limits.pullback.snd ((F.obj l).hom ≫ π₀) g)
        (by
          rw [Category.assoc, ← Category.assoc (F.map t).left, Over.w (F.map t)]
          exact Limits.pullback.condition)
      map_id := fun l => by
        apply Limits.pullback.hom_ext <;> simp
      map_comp := fun {l l' l''} t t' => by
        apply Limits.pullback.hom_ext
        · simp only [Functor.map_comp, Over.comp_left]
          erw [Limits.pullback.lift_fst]
          rw [Category.assoc]
          erw [Limits.pullback.lift_fst, Limits.pullback.lift_fst_assoc]
          try simp only [Category.assoc]
        · erw [Limits.pullback.lift_snd]
          rw [Category.assoc]
          erw [Limits.pullback.lift_snd, Limits.pullback.lift_snd] }
  have hEfst : ∀ {l l' : Λ} (t : l ⟶ l'), E.map t ≫ Limits.pullback.fst ((F.obj l').hom ≫ π₀) g =
      Limits.pullback.fst ((F.obj l).hom ≫ π₀) g ≫ (F.map t).left :=
    fun t => Limits.pullback.lift_fst _ _ _
  have hEsnd : ∀ {l l' : Λ} (t : l ⟶ l'), E.map t ≫ Limits.pullback.snd ((F.obj l').hom ≫ π₀) g =
      Limits.pullback.snd ((F.obj l).hom ≫ π₀) g :=
    fun t => Limits.pullback.lift_snd _ _ _

  let G : Λ ⥤ Scheme.{u} := F ⋙ Over.forget X₀
  let tS : G ⟶ (Functor.const Λ).obj S :=
    { app := fun l => (F.obj l).hom ≫ π₀
      naturality := fun l l' t => by
        show (F.map t).left ≫ (F.obj l').hom ≫ π₀ = ((F.obj l).hom ≫ π₀) ≫ 𝟙 S
        rw [Category.comp_id, ← Category.assoc, Over.w (F.map t)] }
  let fs : E ⟶ G :=
    { app := fun l => Limits.pullback.fst ((F.obj l).hom ≫ π₀) g
      naturality := fun l l' t => hEfst t }
  let sn : E ⟶ (Functor.const Λ).obj T :=
    { app := fun l => Limits.pullback.snd ((F.obj l).hom ≫ π₀) g
      naturality := fun l l' t => (hEsnd t).trans (Category.comp_id _).symm }

  let c : Limits.Cone G :=
    { pt := Y
      π := { app := fun l => π l
             naturality := fun l l' t => (Category.id_comp _).trans (hcompat t).symm } }
  have hc : Limits.IsLimit c :=
    Limits.IsLimit.ofExistsUnique (fun s => hlim s.pt (fun l => s.π.app l) (fun t => s.w t))

  let cE : Limits.Cone E :=
    { pt := Limits.pullback h g
      π := { app := fun l => Limits.pullback.lift (Limits.pullback.fst h g ≫ π l)
                (Limits.pullback.snd h g) (by rw [Category.assoc, hπ l]; exact Limits.pullback.condition)
             naturality := fun l l' t => by
               apply Limits.pullback.hom_ext
               · simp only [Functor.const_obj_map, Category.id_comp, Category.assoc, hEfst,
                   Limits.pullback.lift_fst, Limits.pullback.lift_fst_assoc, hcompat]
                 exact Category.id_comp _
               · simp only [Functor.const_obj_map, Category.id_comp, Category.assoc, hEsnd,
                   Limits.pullback.lift_snd]
                 exact Category.id_comp _ } }

  obtain ⟨hcE⟩ := wc_lim_cone_cartesian_base_change Λ G E S T g tS fs sn
    (fun j => IsPullback.of_hasPullback ((F.obj j).hom ≫ π₀) g) c hc h (fun j => hπ j) cE
    (Limits.pullback.fst h g) (Limits.pullback.snd h g) (IsPullback.of_hasPullback h g)
    (fun j => Limits.pullback.lift_fst _ _ _) (fun j => Limits.pullback.lift_snd _ _ _)

  haveI hEaff : ∀ l, IsAffine (E.obj l) := fun l => by
    haveI := haff l
    exact (inferInstance : IsAffine (Limits.pullback ((F.obj l).hom ≫ π₀) g))
  have htrans : ∀ {i j : Λ} (f : i ⟶ j), IsAffineHom (E.map f) := fun f => inferInstance
  have hcpt : ∀ i, CompactSpace (E.obj i) := fun i => inferInstance
  have hqs : ∀ i, QuasiSeparatedSpace (E.obj i) := fun i => inferInstance

  have reidx : ∀ {i : Λ} {V : Scheme.{u}} (q : V ⟶ E.obj i) (j : P ⟶ V),
      IsPullback j p q (cE.π.app i) → ∀ {i' : Λ} (f : i' ⟶ i)
      (hw : j ≫ q = (p ≫ cE.π.app i') ≫ E.map f),
      IsPullback (Limits.pullback.lift j (p ≫ cE.π.app i') hw) p
        (Limits.pullback.snd q (E.map f)) (cE.π.app i') := by
    intro i V q j hj i' f hw
    refine IsPullback.of_right ?_ (Limits.pullback.lift_snd _ _ _)
      (IsPullback.of_hasPullback q (E.map f))
    rw [Limits.pullback.lift_fst, cE.w f]
    exact hj

  obtain ⟨i, Pi, qi, w, hqf, hqe, hw⟩ := wc_fet_descend_cofiltered_limit Λ E (Limits.pullback h g)
    cE.π ⟨hcE⟩ htrans hcpt hqs P p hP.finite hP.etale

  obtain ⟨i₁, f₁, a, ha_p, ha0, hadd, hequiv⟩ := wc_fet_action_stage_descend Λ E cE hcE htrans
    hEaff i Pi P qi p w hqf hqe hw m hm α hP.act_p hP.act_zero hP.act_add
  have hw1 : w ≫ qi = (p ≫ cE.π.app i₁) ≫ E.map f₁ := by
    rw [Category.assoc, cE.w f₁]; exact hw.w
  have hj₁ := reidx qi w hw f₁ hw1
  haveI := hqf
  haveI := hqe

  obtain ⟨Z, hZc, hZ⟩ := wc_fet_torsor_closed_bad_locus (Limits.pullback.snd qi (E.map f₁)) m a hm
    inferInstance inferInstance ha_p ha0 hadd
  have hZ1 := (hZ (Limits.pullback h g) P (cE.π.app i₁) p _ α hj₁ hP.act_p
    (fun g => (hequiv g).symm)).mp hP

  obtain ⟨i₂, f₂, hZ₂⟩ := wc_lim_closed_empty_stage Λ E cE hcE htrans hcpt i₁ Z hZc hZ1

  let q₁ := Limits.pullback.snd qi (E.map f₁)
  let a₂ : ZMod m → (Limits.pullback q₁ (E.map f₂) ⟶ Limits.pullback q₁ (E.map f₂)) := fun x =>
    Limits.pullback.lift (Limits.pullback.fst q₁ (E.map f₂) ≫ a x) (Limits.pullback.snd q₁ (E.map f₂))
      (by rw [Category.assoc, ha_p x]; exact Limits.pullback.condition)
  have htors : wcFetTorsor (Limits.pullback.snd q₁ (E.map f₂)) m a₂ :=
    (hZ (E.obj i₂) (Limits.pullback q₁ (E.map f₂)) (E.map f₂) (Limits.pullback.snd q₁ (E.map f₂))
      (Limits.pullback.fst q₁ (E.map f₂)) a₂ (IsPullback.of_hasPullback q₁ (E.map f₂))
      (fun x => Limits.pullback.lift_snd _ _ _) (fun x => Limits.pullback.lift_fst _ _ _)).mpr hZ₂
  have hw2 : Limits.pullback.lift w (p ≫ cE.π.app i₁) hw1 ≫ q₁ = (p ≫ cE.π.app i₂) ≫ E.map f₂ := by
    rw [Category.assoc, cE.w f₂]; exact hj₁.w
  have hj₂ := reidx q₁ _ hj₁ f₂ hw2
  exact ⟨i₂, Limits.pullback q₁ (E.map f₂), Limits.pullback.snd q₁ (E.map f₂), a₂, _, htors, hj₂⟩

theorem wc_ctd_affine_etale_presentation : ∀ (K : Type u) [Field K] (A : Type u) [CommRing A] (s : Spec (.of A) ⟶ Spec (.of K)) (W : Scheme.{u}) [IsAffine W] (e : W ⟶ wcHalA1 s) [Etale e] (L : Type u) [Field L] (Ω : Type u) [Field Ω] [Algebra L Ω] (zb : Spec (.of L) ⟶ Spec (.of A)), ∃ (R : Type u) (_ : CommRing R) (_ : Algebra L R) (_ : Algebra (Polynomial L) R) (_ : IsScalarTower L (Polynomial L) R) (ψ : Limits.pullback (e ≫ wcHalA1Proj s) zb ≅ Spec (.of R)) (Θ : Limits.pullback (e ≫ wcHalA1Proj s) (Spec.map (CommRingCat.ofHom (algebraMap L Ω)) ≫ zb) ≅ Spec (.of (TensorProduct L R Ω))), Algebra.Etale (Polynomial L) R ∧ Θ.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap R (TensorProduct L R Ω))) = Limits.pullback.lift (Limits.pullback.fst (e ≫ wcHalA1Proj s) (Spec.map (CommRingCat.ofHom (algebraMap L Ω)) ≫ zb)) (Limits.pullback.snd (e ≫ wcHalA1Proj s) (Spec.map (CommRingCat.ofHom (algebraMap L Ω)) ≫ zb) ≫ Spec.map (CommRingCat.ofHom (algebraMap L Ω))) (by rw [Limits.pullback.condition, Category.assoc]) ≫ ψ.hom :=
by
  intro K _ A _ s W _ e _ L _ Ω _ _ zb

  have s2 : ∃ h : Spec (.of (Polynomial L)) ⟶ wcHalA1 s,
      IsPullback h (Spec.map (CommRingCat.ofHom (algebraMap L (Polynomial L)))) (wcHalA1Proj s) zb := by
    letI : Algebra K L := (Spec.preimage (zb ≫ s)).hom.toAlgebra
    letI : Algebra (Polynomial K) (Polynomial L) := Polynomial.algebra K L
    have hk : Spec.map (CommRingCat.ofHom (algebraMap K L)) = zb ≫ s :=
      Spec.map_preimage (zb ≫ s)
    have Q := isPullback_SpecMap_of_isPushout _ _ _ _
      (CommRingCat.isPushout_of_isPushout K L (Polynomial K) (Polynomial L))
    rw [hk] at Q
    have w : (Spec.map (CommRingCat.ofHom (algebraMap L (Polynomial L))) ≫ zb) ≫ s =
        Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) (Polynomial L))) ≫
          Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))) := by
      rw [Category.assoc]; exact Q.w
    refine ⟨Limits.pullback.lift _ _ w, ?_⟩
    refine IsPullback.of_right (h₁₂ := Limits.pullback.snd s
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))
      (h₂₂ := s) ?_ (Limits.pullback.lift_fst _ _ _) (IsPullback.of_hasPullback _ _).flip
    rw [Limits.pullback.lift_snd]
    exact Q.flip

  have s3 : ∀ (C : Scheme.{u}) [IsAffine C] (c : C ⟶ Spec (.of L))
      (t : C ⟶ Spec (.of (Polynomial L))) [Etale t],
      t ≫ Spec.map (CommRingCat.ofHom (algebraMap L (Polynomial L))) = c →
      ∃ (R : Type u) (_ : CommRing R) (_ : Algebra L R) (_ : Algebra (Polynomial L) R)
        (_ : IsScalarTower L (Polynomial L) R) (ψ : C ≅ Spec (.of R)),
        ψ.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap L R)) = c ∧
          Algebra.Etale (Polynomial L) R := by
    intro C _ c t _ htc
    letI : Algebra L Γ(C, ⊤) := (Spec.preimage (C.isoSpec.inv ≫ c)).hom.toAlgebra
    letI : Algebra (Polynomial L) Γ(C, ⊤) := (Spec.preimage (C.isoSpec.inv ≫ t)).hom.toAlgebra
    have ha : Spec.map (CommRingCat.ofHom (algebraMap L Γ(C, ⊤))) = C.isoSpec.inv ≫ c :=
      Spec.map_preimage (C.isoSpec.inv ≫ c)
    have hb : Spec.map (CommRingCat.ofHom (algebraMap (Polynomial L) Γ(C, ⊤))) =
        C.isoSpec.inv ≫ t :=
      Spec.map_preimage (C.isoSpec.inv ≫ t)
    have htower : IsScalarTower L (Polynomial L) Γ(C, ⊤) := by
      apply IsScalarTower.of_algebraMap_eq'
      have h1 : CommRingCat.ofHom (algebraMap L Γ(C, ⊤)) =
          CommRingCat.ofHom ((algebraMap (Polynomial L) Γ(C, ⊤)).comp
            (algebraMap L (Polynomial L))) := by
        apply Spec.map_injective
        rw [CommRingCat.ofHom_comp, Spec.map_comp, hb, ha, Category.assoc, htc]
      exact congrArg CommRingCat.Hom.hom h1
    have het : Etale (Spec.map (CommRingCat.ofHom (algebraMap (Polynomial L) Γ(C, ⊤)))) := by
      rw [hb]; infer_instance
    refine ⟨Γ(C, ⊤), inferInstance, inferInstance, inferInstance, htower, C.isoSpec, ?_, ?_⟩
    · rw [ha, Iso.hom_inv_id_assoc]
    · rw [← RingHom.etale_algebraMap]
      exact (HasRingHomProperty.Spec_iff (P := @Etale) (Q := @RingHom.Etale)).mp het

  have s4 : ∀ (R : Type u) [CommRing R] [Algebra L R] (C C' : Scheme.{u}) (c : C ⟶ Spec (.of L))
      (ν : C' ⟶ C) (c' : C' ⟶ Spec (.of Ω)) (ψ : C ≅ Spec (.of R)),
      ψ.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap L R)) = c →
      IsPullback ν c' c (Spec.map (CommRingCat.ofHom (algebraMap L Ω))) →
      ∃ Θ : C' ≅ Spec (.of (TensorProduct L R Ω)),
        Θ.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap R (TensorProduct L R Ω))) = ν ≫ ψ.hom := by
    intro R _ _ C C' c ν c' ψ hψ H
    have S3 : IsPullback (ν ≫ ψ.hom) c' (Spec.map (CommRingCat.ofHom (algebraMap L R)))
        (Spec.map (CommRingCat.ofHom (algebraMap L Ω))) :=
      IsPullback.of_iso H (Iso.refl _) ψ (Iso.refl _) (Iso.refl _) (by simp) (by simp)
        (by simp [hψ]) (by simp)
    have S4 : IsPullback (Spec.map (CommRingCat.ofHom (algebraMap R (TensorProduct L R Ω))))
        (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight : Ω →ₐ[L] TensorProduct L R Ω)))
        (Spec.map (CommRingCat.ofHom (algebraMap L R)))
        (Spec.map (CommRingCat.ofHom (algebraMap L Ω))) :=
      IsPullback.of_iso (IsPullback.of_hasPullback _ _) (pullbackSpecIso L R Ω) (Iso.refl _)
        (Iso.refl _) (Iso.refl _)
        (by rw [Iso.refl_hom, Category.comp_id]; exact (pullbackSpecIso_hom_fst L R Ω).symm)
        (by rw [Iso.refl_hom, Category.comp_id]; exact (pullbackSpecIso_hom_snd L R Ω).symm)
        (by simp) (by simp)
    exact ⟨IsPullback.isoIsPullback _ _ S3 S4, IsPullback.isoIsPullback_hom_fst _ _ S3 S4⟩

  obtain ⟨h, hS1⟩ := s2
  have w1 : (Limits.pullback.fst (e ≫ wcHalA1Proj s) zb ≫ e) ≫ wcHalA1Proj s =
      Limits.pullback.snd (e ≫ wcHalA1Proj s) zb ≫ zb := by
    rw [Category.assoc]; exact Limits.pullback.condition
  obtain ⟨t, ht1, ht2⟩ : ∃ t : Limits.pullback (e ≫ wcHalA1Proj s) zb ⟶ Spec (.of (Polynomial L)),
      t ≫ h = Limits.pullback.fst (e ≫ wcHalA1Proj s) zb ≫ e ∧
      t ≫ Spec.map (CommRingCat.ofHom (algebraMap L (Polynomial L))) =
        Limits.pullback.snd (e ≫ wcHalA1Proj s) zb :=
    ⟨hS1.lift _ _ w1, hS1.lift_fst _ _ _, hS1.lift_snd _ _ _⟩
  have hB : IsPullback (Limits.pullback.fst (e ≫ wcHalA1Proj s) zb) t e h := by
    refine IsPullback.of_bot ?_ ht1.symm hS1
    rw [ht2]
    exact IsPullback.of_hasPullback _ _
  haveI : Etale t := MorphismProperty.of_isPullback (P := @Etale) hB ‹Etale e›
  obtain ⟨R, _, _, _, hT, ψ, hψ, hEt⟩ := s3 _ (Limits.pullback.snd (e ≫ wcHalA1Proj s) zb) t ht2
  have hS2 : IsPullback (Limits.pullback.lift (Limits.pullback.fst (e ≫ wcHalA1Proj s) (Spec.map (CommRingCat.ofHom (algebraMap L Ω)) ≫ zb)) (Limits.pullback.snd (e ≫ wcHalA1Proj s) (Spec.map (CommRingCat.ofHom (algebraMap L Ω)) ≫ zb) ≫ Spec.map (CommRingCat.ofHom (algebraMap L Ω))) (by rw [Limits.pullback.condition, Category.assoc]))
      (Limits.pullback.snd (e ≫ wcHalA1Proj s) (Spec.map (CommRingCat.ofHom (algebraMap L Ω)) ≫ zb))
      (Limits.pullback.snd (e ≫ wcHalA1Proj s) zb) (Spec.map (CommRingCat.ofHom (algebraMap L Ω))) := by
    refine IsPullback.of_right ?_ (Limits.pullback.lift_snd _ _ _)
      (IsPullback.of_hasPullback (e ≫ wcHalA1Proj s) zb)
    rw [Limits.pullback.lift_fst]
    exact IsPullback.of_hasPullback _ _
  obtain ⟨Θ, hΘ⟩ := s4 R _ _ _ _ _ ψ hψ hS2
  exact ⟨R, _, _, _, hT, ψ, Θ, hEt, hΘ⟩

theorem wc_fet_descent_iso_transport : ∀ {Y Y' Z Z' : Scheme.{u}} (f : Y' ⟶ Y) (g : Z' ⟶ Z) (a : Y ≅ Z) (b : Y' ≅ Z'), b.hom ≫ g = f ≫ a.hom → ∀ (m : ℕ), (∀ (P : Scheme.{u}) (p : P ⟶ Z') (α : ZMod m → (P ⟶ P)), wcFetTorsor p m α → ∃ (Q : Scheme.{u}) (q : Q ⟶ Z) (β : ZMod m → (Q ⟶ Q)) (j : P ⟶ Q), wcFetTorsor q m β ∧ IsPullback j p q g) → ∀ (P : Scheme.{u}) (p : P ⟶ Y') (α : ZMod m → (P ⟶ P)), wcFetTorsor p m α → ∃ (Q : Scheme.{u}) (q : Q ⟶ Y) (β : ZMod m → (Q ⟶ Q)) (j : P ⟶ Q), wcFetTorsor q m β ∧ IsPullback j p q f :=
by
  have wc_fet_torsor_base_change : ∀ {Y Y' P : Scheme.{u}} (p : P ⟶ Y) (h : Y' ⟶ Y) (m : ℕ)
      (a : ZMod m → (P ⟶ P)), wcFetTorsor p m a →
      ∃ a' : ZMod m → (Limits.pullback p h ⟶ Limits.pullback p h),
        wcFetTorsor (Limits.pullback.snd p h) m a' := by
    intro Y Y' P p h m a tor
    classical
    haveI := tor.finite
    haveI := tor.etale
    let f := Limits.pullback.fst p h
    let q := Limits.pullback.snd p h
    haveI hqe : Etale q := inferInstanceAs (Etale (Limits.pullback.snd p h))
    have hC : f ≫ p = q ≫ h := Limits.pullback.condition
    have hw : ∀ c, (f ≫ a c) ≫ p = q ≫ h := by
      intro c
      rw [Category.assoc, tor.act_p c, hC]
    let a' : ZMod m → (Limits.pullback p h ⟶ Limits.pullback p h) := fun c =>
      Limits.pullback.lift (f ≫ a c) q (hw c)
    have A1 : ∀ c, a' c ≫ f = f ≫ a c := fun c => Limits.pullback.lift_fst _ _ _
    have A2 : ∀ c, a' c ≫ q = q := fun c => Limits.pullback.lift_snd _ _ _
    have act_zero : a' 0 = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · rw [A1, tor.act_zero, Category.comp_id, Category.id_comp]
      · rw [A2, Category.id_comp]
    have act_add : ∀ c c', a' (c + c') = a' c' ≫ a' c := by
      intro c c'
      apply Limits.pullback.hom_ext
      · have A1' : ∀ (d : ZMod m) {Z : Scheme.{u}} (g : P ⟶ Z), a' d ≫ f ≫ g = f ≫ a d ≫ g := by
          intro d Z g
          rw [← Category.assoc, A1, Category.assoc]
        change a' (c + c') ≫ f = a' c' ≫ a' c ≫ f
        rw [A1, tor.act_add]
        simp only [Category.assoc, A1, A1']
      · change a' (c + c') ≫ q = a' c' ≫ a' c ≫ q
        rw [A2, A2, A2]
    have hsurj : Set.range (Limits.pullback.snd p h) = Set.univ := by
      rw [Scheme.Pullback.range_snd, tor.surj, Set.preimage_univ]
    let G' : ZMod m → (Limits.pullback p h ⟶ Limits.pullback q q) := fun c =>
      Limits.pullback.lift (a' c) (𝟙 _) ((A2 c).trans (Category.id_comp _).symm)
    have G'1 : ∀ c, G' c ≫ Limits.pullback.fst q q = a' c := fun c => Limits.pullback.lift_fst _ _ _
    have G'2 : ∀ c, G' c ≫ Limits.pullback.snd q q = 𝟙 _ := fun c => Limits.pullback.lift_snd _ _ _
    let G : ZMod m → (P ⟶ Limits.pullback p p) := fun c =>
      Limits.pullback.lift (a c) (𝟙 P) ((tor.act_p c).trans (Category.id_comp p).symm)
    have G1 : ∀ c, G c ≫ Limits.pullback.fst p p = a c := fun c => Limits.pullback.lift_fst _ _ _
    have G2 : ∀ c, G c ≫ Limits.pullback.snd p p = 𝟙 P := fun c => Limits.pullback.lift_snd _ _ _
    have hopen : ∀ c, IsOpenImmersion (G' c) := by
      intro c
      haveI : Mono (G' c) := mono_of_mono_fac (G'2 c)
      haveI : Etale (G' c) := by
        apply MorphismProperty.of_postcomp (W := @Etale) (W' := @Etale) _
          (Limits.pullback.snd q q) inferInstance
        rw [G'2 c]; infer_instance
      exact IsOpenImmersion.of_flat_of_mono _
    let κ := Limits.pullback.map q q p p f f h hC.symm hC.symm
    have κ1 : κ ≫ Limits.pullback.fst p p = Limits.pullback.fst q q ≫ f :=
      Limits.pullback.lift_fst _ _ _
    have κ2 : κ ≫ Limits.pullback.snd p p = Limits.pullback.snd q q ≫ f :=
      Limits.pullback.lift_snd _ _ _
    have K : ∀ c, G' c ≫ κ = f ≫ G c := by
      intro c
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc]
        rw [κ1, ← Category.assoc, G'1, A1, G1]
      · simp only [Category.assoc]
        rw [κ2, ← Category.assoc, G'2, Category.id_comp, G2, Category.comp_id]
    have L : ∀ c {T : Scheme.{u}} (t₁ : T ⟶ P) (t₂ : T ⟶ Limits.pullback q q),
        t₁ ≫ G c = t₂ ≫ κ → (t₂ ≫ Limits.pullback.snd q q) ≫ G' c = t₂ := by
      intro c T t₁ t₂ ht
      have e1 : t₂ ≫ Limits.pullback.fst q q ≫ f = t₁ ≫ a c := by
        rw [← κ1, ← Category.assoc, ← ht, Category.assoc, G1]
      have e2 : t₂ ≫ Limits.pullback.snd q q ≫ f = t₁ := by
        rw [← κ2, ← Category.assoc, ← ht, Category.assoc, G2, Category.comp_id]
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc, G'1]
        apply Limits.pullback.hom_ext
        · change t₂ ≫ Limits.pullback.snd q q ≫ a' c ≫ f = t₂ ≫ Limits.pullback.fst q q ≫ f
          rw [A1 c, reassoc_of% e2, e1]
        · change t₂ ≫ Limits.pullback.snd q q ≫ a' c ≫ q = t₂ ≫ Limits.pullback.fst q q ≫ q
          rw [A2, Limits.pullback.condition]
      · simp only [Category.assoc, G'2, Category.comp_id]
    have hR : ∀ c, Set.range (G' c) ⊆ κ ⁻¹' Set.range (G c) := by
      rintro c _ ⟨v, rfl⟩
      refine ⟨f v, ?_⟩
      have := Scheme.Hom.comp_apply (G' c) κ v
      rw [K c, Scheme.Hom.comp_apply] at this
      exact this
    have hdisj : Pairwise fun c c' => Disjoint (Set.range (G' c)) (Set.range (G' c')) := by
      intro c c' hcc'
      have hd : Disjoint (Set.range (G c)) (Set.range (G c')) := tor.graph_disj hcc'
      exact Disjoint.mono (hR c) (hR c') (hd.preimage (⇑κ))
    have hcov : ⋃ c, Set.range (G c) = Set.univ := tor.graph_cover
    have hcover : ⋃ c, Set.range (G' c) = Set.univ := by
      apply Set.eq_univ_of_forall
      intro z
      have hz : κ z ∈ ⋃ c, Set.range (G c) := by
        rw [hcov]; exact Set.mem_univ _
      obtain ⟨c, hc⟩ := Set.mem_iUnion.mp hz
      have hzT : z ∈ Set.range (Limits.pullback.snd (G c) κ) := by
        rw [Scheme.Pullback.range_snd]; exact hc
      obtain ⟨w, rfl⟩ := hzT
      have hL := L c (Limits.pullback.fst (G c) κ) (Limits.pullback.snd (G c) κ)
        Limits.pullback.condition
      refine Set.mem_iUnion.mpr ⟨c, (Limits.pullback.snd (G c) κ ≫ Limits.pullback.snd q q) w, ?_⟩
      have := Scheme.Hom.comp_apply (Limits.pullback.snd (G c) κ ≫ Limits.pullback.snd q q) (G' c) w
      rw [hL] at this
      exact this.symm
    exact ⟨a', ⟨inferInstance, inferInstance, hsurj, A2, act_zero, act_add, hopen, hdisj, hcover⟩⟩
  intro Y Y' Z Z' f g a b hcomm m H P p α hP
  obtain ⟨α', hα'⟩ := wc_fet_torsor_base_change p b.inv m α hP
  obtain ⟨Q, q, β, j', hQ, hpb⟩ := H _ _ α' hα'
  obtain ⟨β', hβ'⟩ := wc_fet_torsor_base_change q a.hom m β hQ
  haveI : IsIso (Limits.pullback.fst p b.inv) := inferInstance
  haveI : IsIso (Limits.pullback.fst q a.hom) := inferInstance
  refine ⟨Limits.pullback q a.hom, Limits.pullback.snd q a.hom, β',
    inv (Limits.pullback.fst p b.inv) ≫ j' ≫ inv (Limits.pullback.fst q a.hom), hβ', ?_⟩
  refine IsPullback.of_iso hpb (asIso (Limits.pullback.fst p b.inv))
    (asIso (Limits.pullback.fst q a.hom)).symm b.symm a.symm ?_ ?_ ?_ ?_
  · simp only [Iso.symm_hom, asIso_inv, asIso_hom, IsIso.hom_inv_id_assoc]
  · simp only [Iso.symm_hom, asIso_hom]
    exact Limits.pullback.condition.symm
  · simp only [Iso.symm_hom, asIso_inv]
    rw [Iso.comp_inv_eq, Category.assoc, ← Limits.pullback.condition, IsIso.inv_hom_id_assoc]
  · simp only [Iso.symm_hom]
    rw [Iso.comp_inv_eq, Category.assoc, ← hcomm, Iso.inv_hom_id_assoc]

theorem wc_fet_torsor_affine_ring_data : ∀ (S : Type u) [CommRing S] (P : Scheme.{u}) (p : P ⟶ Spec (.of S)) (m : ℕ) [NeZero m] (α : ZMod m → (P ⟶ P)), wcFetTorsor p m α → ∃ (B : Type u) (_ : CommRing B) (_ : Algebra S B) (σ : ZMod m → (B →ₐ[S] B)) (φ : P ≅ Spec (.of B)), φ.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap S B)) = p ∧ σ 0 = AlgHom.id S B ∧ (∀ c c', σ (c + c') = (σ c).comp (σ c')) ∧ Algebra.Etale S B ∧ Module.Finite S B ∧ Function.Surjective (PrimeSpectrum.comap (algebraMap S B)) ∧ Function.Bijective (wcTorDescMu S B m σ) :=
by
  intro S _ P p m _ α hP
  classical
  haveI := hP.finite
  haveI := hP.etale
  haveI : IsAffine P := isAffine_of_isAffineHom p
  obtain ⟨B, _, φ, -⟩ : ∃ (B : Type u) (_ : CommRing B) (_ : P ≅ Spec (.of B)), True :=
    ⟨_, _, P.isoSpec, trivial⟩
  obtain ⟨f, hf⟩ : ∃ f : CommRingCat.of S ⟶ CommRingCat.of B, Spec.map f = φ.inv ≫ p :=
    ⟨Spec.preimage _, Spec.map_preimage _⟩
  letI : Algebra S B := f.hom.toAlgebra
  have hτex : ∀ c, ∃ t : CommRingCat.of B ⟶ CommRingCat.of B,
      Spec.map t = φ.inv ≫ α c ≫ φ.hom := fun c => ⟨Spec.preimage _, Spec.map_preimage _⟩
  choose τ hτ using hτex
  have hlin : ∀ c, f ≫ τ c = f := by
    intro c
    apply Spec.map_injective
    rw [Spec.map_comp, hτ, hf, Category.assoc, Category.assoc, Iso.hom_inv_id_assoc, hP.act_p]
  let σ : ZMod m → (B →ₐ[S] B) := fun c =>
    { toRingHom := (τ c).hom
      commutes' := fun s =>
        (congrArg (fun g : CommRingCat.of S ⟶ CommRingCat.of B => g.hom s) (hlin c) : _) }
  have hστ : ∀ c, CommRingCat.ofHom (σ c).toRingHom = τ c := fun c => rfl
  have hfS : CommRingCat.ofHom (algebraMap S B) = f := rfl
  have hτ0 : τ 0 = 𝟙 _ := by
    apply Spec.map_injective
    rw [hτ, hP.act_zero, Category.id_comp, Iso.inv_hom_id, Spec.map_id]
  have hτadd : ∀ c c', τ (c + c') = τ c' ≫ τ c := by
    intro c c'
    apply Spec.map_injective
    rw [Spec.map_comp, hτ, hτ, hτ, add_comm, hP.act_add]
    simp only [Category.assoc, Iso.hom_inv_id_assoc]
  have hσ0 : σ 0 = AlgHom.id S B := by
    apply AlgHom.ext
    intro x
    show (τ 0).hom x = x
    rw [hτ0]
    rfl
  have hσadd : ∀ c c', σ (c + c') = (σ c).comp (σ c') := by
    intro c c'
    apply AlgHom.ext
    intro x
    show (τ (c + c')).hom x = (τ c).hom ((τ c').hom x)
    rw [hτadd]
    rfl
  have hconj : ∀ c, φ.hom ≫ Spec.map (CommRingCat.ofHom (σ c).toRingHom) = α c ≫ φ.hom := by
    intro c
    rw [hστ, hτ, Iso.hom_inv_id_assoc]
  have hq : φ.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap S B)) = p := by
    rw [hfS, hf, Iso.hom_inv_id_assoc]
  have hq' : Spec.map (CommRingCat.ofHom (algebraMap S B)) = φ.inv ≫ p := by
    rw [hfS, hf]

  have hEt : Etale (Spec.map (CommRingCat.ofHom (algebraMap S B))) := by
    rw [hq']; infer_instance
  have hFin : IsFinite (Spec.map (CommRingCat.ofHom (algebraMap S B))) := by
    rw [hq']; infer_instance
  have hqsurj : Function.Surjective (Spec.map (CommRingCat.ofHom (algebraMap S B))) := by
    intro x
    obtain ⟨y, hy⟩ : x ∈ Set.range p := hP.surj ▸ Set.mem_univ x
    refine ⟨φ.hom y, ?_⟩
    rw [← Scheme.Hom.comp_apply, hq, hy]

  have hwB : ∀ c, Spec.map (CommRingCat.ofHom (σ c).toRingHom) ≫
      Spec.map (CommRingCat.ofHom (algebraMap S B)) =
      𝟙 (Spec (CommRingCat.of B)) ≫ Spec.map (CommRingCat.ofHom (algebraMap S B)) := by
    intro c
    rw [hστ, hfS, ← Spec.map_comp, hlin, Category.id_comp]
  let ΓB : ULift.{u} (ZMod m) → (Spec (CommRingCat.of B) ⟶ Limits.pullback
      (Spec.map (CommRingCat.ofHom (algebraMap S B))) (Spec.map (CommRingCat.ofHom (algebraMap S B)))) :=
    fun i => Limits.pullback.lift (Spec.map (CommRingCat.ofHom (σ i.down).toRingHom))
      (𝟙 (Spec (CommRingCat.of B))) (hwB i.down)
  let ΓP : ULift.{u} (ZMod m) → (P ⟶ Limits.pullback p p) := fun i =>
    Limits.pullback.lift (α i.down) (𝟙 P) ((hP.act_p i.down).trans (Category.id_comp p).symm)
  haveI : ∀ i, IsOpenImmersion (ΓP i) := fun i => hP.graph_open i.down
  have hDPopen : IsOpenImmersion (Limits.Sigma.desc ΓP) :=
    isOpenImmersion_sigmaDesc (fun _ => P) ΓP (by
      intro i j hij
      exact hP.graph_disj (fun h => hij (ULift.ext _ _ h)))
  have hDPsurj : Surjective (Limits.Sigma.desc ΓP) := by
    constructor
    intro z
    have hz : z ∈ (⋃ c, Set.range (Limits.pullback.lift (α c) (𝟙 P)
        ((hP.act_p c).trans (Category.id_comp p).symm))) := by
      rw [hP.graph_cover]; exact Set.mem_univ z
    obtain ⟨c, x, hx⟩ := Set.mem_iUnion.mp hz
    refine ⟨Limits.Sigma.ι (fun _ : ULift.{u} (ZMod m) => P) ⟨c⟩ x, ?_⟩
    rw [← Scheme.Hom.comp_apply, Limits.Sigma.ι_comp_desc]
    exact hx
  haveI hDPiso : IsIso (Limits.Sigma.desc ΓP) :=
    (isIso_iff_isOpenImmersion_and_surjective _).mpr ⟨hDPopen, hDPsurj⟩
  have eΨ : p ≫ 𝟙 _ = φ.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap S B)) := by
    rw [Category.comp_id, hq]
  let Ψ := Limits.pullback.map p p (Spec.map (CommRingCat.ofHom (algebraMap S B)))
    (Spec.map (CommRingCat.ofHom (algebraMap S B))) φ.hom φ.hom (𝟙 _) eΨ eΨ
  haveI : IsIso Ψ := Limits.pullback.map_isIso _ _ _ _ _ _ _ _ _
  have hΨfst : Ψ ≫ Limits.pullback.fst _ _ = Limits.pullback.fst p p ≫ φ.hom :=
    Limits.pullback.lift_fst _ _ _
  have hΨsnd : Ψ ≫ Limits.pullback.snd _ _ = Limits.pullback.snd p p ≫ φ.hom :=
    Limits.pullback.lift_snd _ _ _
  let Θ := Limits.Sigma.desc (fun i : ULift.{u} (ZMod m) =>
    φ.hom ≫ Limits.Sigma.ι (fun _ : ULift.{u} (ZMod m) => Spec (CommRingCat.of B)) i)
  let Θ' := Limits.Sigma.desc (fun i : ULift.{u} (ZMod m) =>
    φ.inv ≫ Limits.Sigma.ι (fun _ : ULift.{u} (ZMod m) => P) i)
  haveI : IsIso Θ := ⟨⟨Θ',
    Limits.Sigma.hom_ext _ _ (fun i => by simp [Θ, Θ']),
    Limits.Sigma.hom_ext _ _ (fun i => by simp [Θ, Θ'])⟩⟩
  have hΘ : Θ ≫ Limits.Sigma.desc ΓB = Limits.Sigma.desc ΓP ≫ Ψ := by
    apply Limits.Sigma.hom_ext
    intro i
    rw [Limits.Sigma.ι_desc_assoc, Category.assoc, Limits.Sigma.ι_comp_desc,
      Limits.Sigma.ι_desc_assoc]
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Category.assoc, hΨfst, Limits.pullback.lift_fst,
        Limits.pullback.lift_fst_assoc]
      exact hconj i.down
    · rw [Category.assoc, Category.assoc, hΨsnd, Limits.pullback.lift_snd,
        Limits.pullback.lift_snd_assoc, Category.comp_id, Category.id_comp]
  haveI : IsIso (Θ ≫ Limits.Sigma.desc ΓB) := by rw [hΘ]; infer_instance
  haveI hDBiso : IsIso (Limits.Sigma.desc ΓB) := IsIso.of_isIso_comp_left Θ _

  let ρ : (ZMod m → B) ≃+* (ULift.{u} (ZMod m) → B) :=
    { toFun := fun f i => f i.down
      invFun := fun g c => g ⟨c⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_mul' := fun _ _ => rfl
      map_add' := fun _ _ => rfl }
  haveI hρiso : IsIso (CommRingCat.ofHom ρ.toRingHom) :=
    ⟨⟨CommRingCat.ofHom ρ.symm.toRingHom,
      by apply CommRingCat.hom_ext; apply RingHom.ext; intro x; exact ρ.symm_apply_apply x,
      by apply CommRingCat.hom_ext; apply RingHom.ext; intro y; exact ρ.apply_symm_apply y⟩⟩
  have hjfac : ∀ c : ZMod m,
      Spec.map (CommRingCat.ofHom (Pi.evalRingHom (fun _ : ZMod m => B) c)) =
      Limits.Sigma.ι (fun _ : ULift.{u} (ZMod m) => Spec (CommRingCat.of B)) (ULift.up c) ≫
        sigmaSpec (fun _ : ULift.{u} (ZMod m) => CommRingCat.of B) ≫
        Spec.map (CommRingCat.ofHom ρ.toRingHom) := by
    intro c
    rw [← Category.assoc, ι_sigmaSpec, ← Spec.map_comp]
    rfl
  have hgraph0 : ∀ c (h : Spec.map (CommRingCat.ofHom (σ c).toRingHom) ≫
      Spec.map (CommRingCat.ofHom (algebraMap S B)) =
      𝟙 (Spec (CommRingCat.of B)) ≫ Spec.map (CommRingCat.ofHom (algebraMap S B))),
      Limits.pullback.lift (Spec.map (CommRingCat.ofHom (σ c).toRingHom))
        (𝟙 (Spec (CommRingCat.of B))) h =
      Spec.map (CommRingCat.ofHom (Pi.evalRingHom (fun _ : ZMod m => B) c)) ≫
        (Spec.map (CommRingCat.ofHom (wcTorDescMu S B m σ).toRingHom) ≫
          (pullbackSpecIso S B B).inv) := by
    intro c h
    apply Limits.pullback.hom_ext
    · rw [Limits.pullback.lift_fst, Category.assoc, Category.assoc, pullbackSpecIso_inv_fst,
        ← Spec.map_comp, ← Spec.map_comp]
      congr 1
      ext x
      simp [wcTorDescMu]
    · rw [Limits.pullback.lift_snd, Category.assoc, Category.assoc, pullbackSpecIso_inv_snd,
        ← Spec.map_comp, ← Spec.map_comp, ← Spec.map_id (CommRingCat.of B)]
      congr 1
      ext x
      simp [wcTorDescMu]
  have hE : (sigmaSpec (fun _ : ULift.{u} (ZMod m) => CommRingCat.of B) ≫
      Spec.map (CommRingCat.ofHom ρ.toRingHom)) ≫
      (Spec.map (CommRingCat.ofHom (wcTorDescMu S B m σ).toRingHom) ≫
        (pullbackSpecIso S B B).inv) = Limits.Sigma.desc ΓB := by
    apply Limits.Sigma.hom_ext
    intro i
    rw [Limits.Sigma.ι_comp_desc]
    have h2 := hgraph0 i.down (hwB i.down)
    rw [hjfac i.down] at h2
    simp only [Category.assoc] at h2 ⊢
    exact h2.symm
  haveI : IsIso ((sigmaSpec (fun _ : ULift.{u} (ZMod m) => CommRingCat.of B) ≫
      Spec.map (CommRingCat.ofHom ρ.toRingHom)) ≫
      (Spec.map (CommRingCat.ofHom (wcTorDescMu S B m σ).toRingHom) ≫
        (pullbackSpecIso S B B).inv)) := by rw [hE]; infer_instance
  haveI : IsIso (Spec.map (CommRingCat.ofHom (wcTorDescMu S B m σ).toRingHom) ≫
        (pullbackSpecIso S B B).inv) := IsIso.of_isIso_comp_left
    (sigmaSpec (fun _ : ULift.{u} (ZMod m) => CommRingCat.of B) ≫
      Spec.map (CommRingCat.ofHom ρ.toRingHom)) _
  haveI hSμ : IsIso (Spec.map (CommRingCat.ofHom (wcTorDescMu S B m σ).toRingHom)) :=
    IsIso.of_isIso_comp_right _ (pullbackSpecIso S B B).inv
  obtain ⟨g, hg⟩ : ∃ g : CommRingCat.of (ZMod m → B) ⟶ CommRingCat.of (TensorProduct S B B),
      Spec.map g = inv (Spec.map (CommRingCat.ofHom (wcTorDescMu S B m σ).toRingHom)) :=
    ⟨Spec.preimage _, Spec.map_preimage _⟩
  have hMg : CommRingCat.ofHom (wcTorDescMu S B m σ).toRingHom ≫ g = 𝟙 _ := by
    apply Spec.map_injective
    rw [Spec.map_comp, hg, IsIso.inv_hom_id, Spec.map_id]
  have hgM : g ≫ CommRingCat.ofHom (wcTorDescMu S B m σ).toRingHom = 𝟙 _ := by
    apply Spec.map_injective
    rw [Spec.map_comp, hg, IsIso.hom_inv_id, Spec.map_id]
  have hμbij : Function.Bijective (wcTorDescMu S B m σ) := by
    have h1 : ∀ x, g.hom (wcTorDescMu S B m σ x) = x := fun x =>
      (congrArg (fun k : CommRingCat.of (TensorProduct S B B) ⟶ CommRingCat.of (TensorProduct S B B) =>
        k.hom x) hMg : _)
    have h2 : ∀ y, wcTorDescMu S B m σ (g.hom y) = y := fun y =>
      (congrArg (fun k : CommRingCat.of (ZMod m → B) ⟶ CommRingCat.of (ZMod m → B) =>
        k.hom y) hgM : _)
    refine ⟨fun x y hxy => ?_, fun z => ⟨g.hom z, h2 z⟩⟩
    rw [← h1 x, ← h1 y, hxy]
  refine ⟨B, inferInstance, inferInstance, σ, φ, hq, hσ0, hσadd, ?_, ?_, ?_, hμbij⟩
  · rw [HasRingHomProperty.Spec_iff (P := @Etale)] at hEt
    exact RingHom.etale_algebraMap.mp hEt
  · rw [IsFinite.SpecMap_iff] at hFin
    exact RingHom.finite_algebraMap.mp hFin
  · exact fun x => hqsurj x

theorem wc_kummer_eigen_line : ∀ (L : Type u) [Field L] (ℓ : ℕ), ℓ.Prime → ∀ (ζ : L), IsPrimitiveRoot ζ ℓ → ∀ (S B : Type u) [CommRing S] [CommRing B] [Algebra L S] [Algebra S B] [Algebra L B] [IsScalarTower L S B] (σ : ZMod ℓ → (B →ₐ[S] B)), σ 0 = AlgHom.id S B → (∀ c c', σ (c + c') = (σ c).comp (σ c')) → Algebra.Etale S B → Module.Finite S B → Function.Surjective (PrimeSpectrum.comap (algebraMap S B)) → Function.Bijective (wcTorDescMu S B ℓ σ) → ∀ (M : Submodule S B), (∀ b : B, b ∈ M ↔ σ 1 b = algebraMap L B ζ * b) → Module.Invertible S M ∧ ∃ μ : TensorPower S ℓ M ≃ₗ[S] S, ∀ x : Fin ℓ → M, algebraMap S B (μ (PiTensorProduct.tprod S x)) = ∏ i, (x i : B) :=
by
  intro L _ ℓ hℓ ζ hζ S B _ _ _ _ _ _ σ hσ0 hσadd hEt _ hSurj hBij M hM
  classical
  haveI : NeZero ℓ := ⟨hℓ.ne_zero⟩
  haveI : NeZero (ℓ : L) := hζ.neZero'
  have hℓL : (ℓ : L) ≠ 0 := NeZero.ne _
  obtain rfl : M = wcKummerEig (σ 1) ζ := Submodule.ext fun b => (hM b).trans Iff.rfl

  have hσL : ∀ (c : ZMod ℓ) (l : L) (b : B),
      σ c (algebraMap L B l * b) = algebraMap L B l * σ c b := by
    intro c l b
    rw [map_mul, IsScalarTower.algebraMap_apply L S B, AlgHom.commutes]
  have hσnat : ∀ (c d : ZMod ℓ) (b : B), σ (c + d) b = σ c (σ d b) := by
    intro c d b
    rw [hσadd]
    rfl
  have hmul : ∀ (c d : L) (u v : B), σ 1 u = algebraMap L B c * u →
      σ 1 v = algebraMap L B d * v → σ 1 (u * v) = algebraMap L B (c * d) * (u * v) := by
    intro c d u v hu hv
    rw [map_mul, hu, hv, map_mul]
    ring
  have hmuapp : ∀ (a b : B) (c : ZMod ℓ), wcTorDescMu S B ℓ σ (a ⊗ₜ[S] b) c = σ c a * b := by
    intro a b c
    simp [wcTorDescMu, Algebra.TensorProduct.lift_tmul]

  haveI : Module.Flat S B := inferInstance
  haveI : Module.FaithfullyFlat S B := Module.FaithfullyFlat.of_comap_surjective hSurj
  have hinj : Function.Injective (algebraMap S B) := FaithfulSMul.algebraMap_injective S B
  have hinv : ∀ b : B, σ 1 b = b → b ∈ Set.range (algebraMap S B) := by
    intro b hb
    have hn : ∀ n : ℕ, σ (n : ZMod ℓ) b = b := by
      intro n
      induction n with
      | zero => simp [hσ0]
      | succ n ih => rw [Nat.cast_succ, hσnat, hb, ih]
    have hall : ∀ c, σ c b = b := by
      intro c
      rw [← ZMod.natCast_zmod_val c]
      exact hn _
    have h1 : (b ⊗ₜ[S] (1 : B) : TensorProduct S B B) = (1 : B) ⊗ₜ[S] b := by
      apply hBij.1
      funext c
      rw [hmuapp, hmuapp, hall, map_one, mul_one, one_mul]
    let N : Submodule S B := LinearMap.range (Algebra.linearMap S B)
    have h2 := congrArg (LinearMap.lTensor B N.mkQ) h1
    rw [LinearMap.lTensor_tmul, LinearMap.lTensor_tmul] at h2
    have h3 : N.mkQ 1 = 0 := by
      rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
      exact ⟨1, by rw [Algebra.linearMap_apply, map_one]⟩
    rw [h3, TensorProduct.tmul_zero] at h2
    have h4 : N.mkQ b = 0 := by
      apply Module.FaithfullyFlat.tensorProduct_mk_injective (A := S) (B := B) (B ⧸ N)
      rw [map_zero]
      exact h2.symm
    rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at h4
    obtain ⟨s, hs⟩ := h4
    exact ⟨s, hs⟩
  have hE1 : ∀ b : B, b ∈ wcKummerEig (σ 1) (1 : L) ↔ b ∈ Set.range (algebraMap S B) := by
    intro b
    show σ 1 b = algebraMap L B 1 * b ↔ _
    rw [map_one, one_mul]
    constructor
    · exact hinv b
    · rintro ⟨s, rfl⟩
      exact AlgHom.commutes _ s
  let jlin : S →ₗ[S] wcKummerEig (σ 1) (1 : L) :=
    LinearMap.codRestrict _ (Algebra.linearMap S B) (fun s => (hE1 _).2 ⟨s, rfl⟩)
  have hjbij : Function.Bijective jlin := by
    refine ⟨fun a b h => hinj (congrArg Subtype.val h), fun z => ?_⟩
    obtain ⟨s, hs⟩ := (hE1 z).1 z.2
    exact ⟨s, Subtype.ext hs⟩
  let j : S ≃ₗ[S] wcKummerEig (σ 1) (1 : L) := LinearEquiv.ofBijective jlin hjbij
  have hj : ∀ s, (j s : B) = algebraMap S B s := fun s => rfl

  obtain ⟨t, ht⟩ := hBij.2 (Pi.single 0 1)
  obtain ⟨P, hP⟩ := TensorProduct.exists_finset t
  have hstar : ∀ e : ZMod ℓ, ∑ p ∈ P, σ e p.1 * p.2 = if e = 0 then 1 else 0 := by
    intro e
    have h := congrFun ht e
    rw [hP, map_sum, Finset.sum_apply] at h
    simp only [hmuapp] at h
    rw [h, Pi.single_apply]
  have hcd : ∀ c d : ZMod ℓ, ∑ p ∈ P, σ c p.1 * σ d p.2 = if c = d then 1 else 0 := by
    intro c d
    have hc : d + (c - d) = c := by abel
    have h : ∀ p : B × B, σ c p.1 * σ d p.2 = σ d (σ (c - d) p.1 * p.2) := by
      intro p
      rw [map_mul, ← hσnat, hc]
    simp_rw [h]
    rw [← map_sum, hstar]
    by_cases hcd : c = d
    · subst hcd
      simp
    · have : c - d ≠ 0 := sub_ne_zero.mpr hcd
      simp [this, hcd]
  have hpart : ∀ ω : L, ω ^ ℓ = 1 → ∃ x y : B × B → B,
      (∀ p, σ 1 (x p) = algebraMap L B ω * x p) ∧
      (∀ p, σ 1 (y p) = algebraMap L B ω⁻¹ * y p) ∧ ∑ p ∈ P, x p * y p = 1 := by
    intro ω hω
    have hω0 : ω ≠ 0 := by
      rintro rfl
      rw [zero_pow (NeZero.ne ℓ)] at hω
      exact zero_ne_one hω
    let χ : ZMod ℓ → L := fun c => ω ^ c.val
    have hχadd : ∀ c d, χ (c + d) = χ c * χ d := by
      intro c d
      simp only [χ]
      rw [ZMod.val_add, ← pow_eq_pow_mod _ hω, pow_add]
    have hχ1 : χ 1 = ω := by
      simp only [χ]
      rw [ZMod.val_one_eq_one_mod, ← pow_eq_pow_mod _ hω, pow_one]
    have hχ0 : ∀ c, χ c ≠ 0 := fun c => pow_ne_zero _ hω0
    refine ⟨fun p => ∑ c, algebraMap L B (χ c)⁻¹ * σ c p.1,
      fun p => ∑ d, algebraMap L B ((ℓ : L)⁻¹ * χ d) * σ d p.2, ?_, ?_, ?_⟩
    · intro p
      have e1 : σ 1 (∑ c, algebraMap L B (χ c)⁻¹ * σ c p.1) =
          ∑ c, algebraMap L B (χ c)⁻¹ * σ (1 + c) p.1 := by
        rw [map_sum]
        refine Finset.sum_congr rfl (fun c _ => ?_)
        rw [hσL, hσnat]
      rw [e1, Finset.mul_sum, ← Equiv.sum_comp (Equiv.addLeft (1 : ZMod ℓ))
        (fun c => algebraMap L B ω * (algebraMap L B (χ c)⁻¹ * σ c p.1))]
      refine Finset.sum_congr rfl (fun c _ => ?_)
      simp only [Equiv.coe_addLeft]
      rw [← mul_assoc, ← map_mul (algebraMap L B), hχadd, hχ1, mul_inv, ← mul_assoc,
        mul_inv_cancel₀ hω0, one_mul]
    · intro p
      have e1 : σ 1 (∑ d, algebraMap L B ((ℓ : L)⁻¹ * χ d) * σ d p.2) =
          ∑ d, algebraMap L B ((ℓ : L)⁻¹ * χ d) * σ (1 + d) p.2 := by
        rw [map_sum]
        refine Finset.sum_congr rfl (fun d _ => ?_)
        rw [hσL, hσnat]
      rw [e1, Finset.mul_sum, ← Equiv.sum_comp (Equiv.addLeft (1 : ZMod ℓ))
        (fun d => algebraMap L B ω⁻¹ * (algebraMap L B ((ℓ : L)⁻¹ * χ d) * σ d p.2))]
      refine Finset.sum_congr rfl (fun d _ => ?_)
      simp only [Equiv.coe_addLeft]
      rw [← mul_assoc, ← map_mul (algebraMap L B), hχadd, hχ1]
      congr 2
      linear_combination (-((ℓ : L)⁻¹ * χ d)) * (inv_mul_cancel₀ hω0)
    · beta_reduce
      calc ∑ p ∈ P, (∑ c, algebraMap L B (χ c)⁻¹ * σ c p.1) *
            (∑ d, algebraMap L B ((ℓ : L)⁻¹ * χ d) * σ d p.2)
          = ∑ p ∈ P, ∑ c, ∑ d, algebraMap L B ((χ c)⁻¹ * ((ℓ : L)⁻¹ * χ d)) *
              (σ c p.1 * σ d p.2) := by
            refine Finset.sum_congr rfl (fun p _ => ?_)
            rw [Finset.sum_mul]
            refine Finset.sum_congr rfl (fun c _ => ?_)
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl (fun d _ => ?_)
            simp only [map_mul]
            ring
        _ = ∑ c, ∑ p ∈ P, ∑ d, algebraMap L B ((χ c)⁻¹ * ((ℓ : L)⁻¹ * χ d)) *
              (σ c p.1 * σ d p.2) := Finset.sum_comm
        _ = ∑ c, ∑ d, ∑ p ∈ P, algebraMap L B ((χ c)⁻¹ * ((ℓ : L)⁻¹ * χ d)) *
              (σ c p.1 * σ d p.2) :=
            Finset.sum_congr rfl (fun c _ => Finset.sum_comm)
        _ = ∑ c, ∑ d, algebraMap L B ((χ c)⁻¹ * ((ℓ : L)⁻¹ * χ d)) *
              ∑ p ∈ P, σ c p.1 * σ d p.2 := by
            simp only [Finset.mul_sum]
        _ = ∑ c : ZMod ℓ, algebraMap L B ((ℓ : L)⁻¹) := by
            refine Finset.sum_congr rfl (fun c _ => ?_)
            simp only [hcd, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq,
              Finset.mem_univ, if_true]
            rw [mul_left_comm, inv_mul_cancel₀ (hχ0 c), mul_one]
        _ = 1 := by
            rw [Finset.sum_const, Finset.card_univ, ZMod.card, nsmul_eq_mul,
              ← map_natCast (algebraMap L B), ← map_mul, mul_inv_cancel₀ hℓL, map_one]

  have hkey : ∀ c d : L, c ^ ℓ = 1 → ∃ e : TensorProduct S (wcKummerEig (σ 1) c)
      (wcKummerEig (σ 1) d) ≃ₗ[S] wcKummerEig (σ 1) (c * d),
      ∀ u v, (e (u ⊗ₜ[S] v) : B) = (u : B) * v := by
    intro c d hc
    have hc0 : c ≠ 0 := by
      rintro rfl
      rw [zero_pow (NeZero.ne ℓ)] at hc
      exact zero_ne_one hc
    obtain ⟨x, y, hx, hy, hxy⟩ := hpart c hc
    have hyz : ∀ p (z : B), z ∈ wcKummerEig (σ 1) (c * d) → y p * z ∈ wcKummerEig (σ 1) d := by
      intro p z hz
      have h := hmul _ _ _ _ (hy p) hz
      rwa [inv_mul_cancel_left₀ hc0] at h
    have hyu : ∀ p (u : B), u ∈ wcKummerEig (σ 1) c → y p * u ∈ wcKummerEig (σ 1) (1 : L) := by
      intro p u hu
      have h := hmul _ _ _ _ (hy p) hu
      rwa [inv_mul_cancel₀ hc0] at h
    have hle : ∀ w, Submodule.mulMap (wcKummerEig (σ 1) c) (wcKummerEig (σ 1) d) w ∈
        wcKummerEig (σ 1) (c * d) := by
      intro w
      have hw : Submodule.mulMap (wcKummerEig (σ 1) c) (wcKummerEig (σ 1) d) w ∈
          wcKummerEig (σ 1) c * wcKummerEig (σ 1) d := by
        rw [← Submodule.mulMap_range]
        exact LinearMap.mem_range_self _ w
      refine Submodule.mul_le.mpr ?_ hw
      intro u hu v hv
      exact hmul _ _ _ _ hu hv
    let m : TensorProduct S (wcKummerEig (σ 1) c) (wcKummerEig (σ 1) d) →ₗ[S]
        wcKummerEig (σ 1) (c * d) := LinearMap.codRestrict _ (Submodule.mulMap _ _) hle
    have hm : ∀ u v, (m (u ⊗ₜ[S] v) : B) = (u : B) * v := by
      intro u v
      show Submodule.mulMap _ _ (u ⊗ₜ[S] v) = _
      rw [Submodule.mulMap_tmul]
    let x' : B × B → wcKummerEig (σ 1) c := fun p => ⟨x p, hx p⟩
    let ψ : wcKummerEig (σ 1) (c * d) →ₗ[S]
        TensorProduct S (wcKummerEig (σ 1) c) (wcKummerEig (σ 1) d) :=
      { toFun := fun z => ∑ p ∈ P, x' p ⊗ₜ[S]
          (⟨y p * z, hyz p z z.2⟩ : wcKummerEig (σ 1) d)
        map_add' := by
          intro z z'
          rw [← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl (fun p _ => ?_)
          rw [← TensorProduct.tmul_add]
          congr 1
          apply Subtype.ext
          simp [mul_add]
        map_smul' := by
          intro r z
          rw [RingHom.id_apply, Finset.smul_sum]
          refine Finset.sum_congr rfl (fun p _ => ?_)
          rw [← TensorProduct.tmul_smul]
          congr 1
          apply Subtype.ext
          simp }
    have h1 : m ∘ₗ ψ = LinearMap.id := by
      apply LinearMap.ext
      intro z
      apply Subtype.ext
      show (m (∑ p ∈ P, x' p ⊗ₜ[S] (⟨y p * z, hyz p z z.2⟩ : wcKummerEig (σ 1) d)) : B) = z
      rw [map_sum, Submodule.coe_sum]
      refine Eq.trans (Finset.sum_congr rfl (fun p _ => hm _ _)) ?_
      show ∑ p ∈ P, x p * (y p * (z : B)) = z
      calc ∑ p ∈ P, x p * (y p * (z : B)) = (∑ p ∈ P, x p * y p) * z := by
            rw [Finset.sum_mul]
            refine Finset.sum_congr rfl (fun p _ => by ring)
        _ = z := by rw [hxy, one_mul]
    have h2 : ψ ∘ₗ m = LinearMap.id := by
      apply TensorProduct.ext'
      intro u v
      choose r hr using fun p => (hE1 (y p * u)).1 (hyu p u u.2)
      have hsum : ∑ p ∈ P, r p • x' p = u := by
        apply Subtype.ext
        rw [Submodule.coe_sum]
        show ∑ p ∈ P, r p • x p = (u : B)
        simp only [Algebra.smul_def, hr]
        calc ∑ p ∈ P, y p * u * x p = u * ∑ p ∈ P, x p * y p := by
              rw [Finset.mul_sum]
              refine Finset.sum_congr rfl (fun p _ => by ring)
          _ = u := by rw [hxy, mul_one]
      show ∑ p ∈ P, x' p ⊗ₜ[S] (⟨y p * (m (u ⊗ₜ[S] v) : B), hyz p _ (m (u ⊗ₜ[S] v)).2⟩ :
        wcKummerEig (σ 1) d) = u ⊗ₜ[S] v
      conv_rhs => rw [← hsum]
      rw [TensorProduct.sum_tmul]
      refine Finset.sum_congr rfl (fun p _ => ?_)
      rw [TensorProduct.smul_tmul]
      congr 1
      apply Subtype.ext
      show y p * (m (u ⊗ₜ[S] v) : B) = ((r p • v : wcKummerEig (σ 1) d) : B)
      rw [hm, Submodule.coe_smul, Algebra.smul_def, hr]
      ring
    exact ⟨LinearEquiv.ofLinear m ψ h1 h2, fun u v => hm u v⟩

  have hpow : ∀ k : ℕ, ∃ g : TensorPower S k (wcKummerEig (σ 1) ζ) ≃ₗ[S]
      wcKummerEig (σ 1) (ζ ^ k), ∀ x : Fin k → wcKummerEig (σ 1) ζ,
      (g (PiTensorProduct.tprod S x) : B) = ∏ i, (x i : B) := by
    intro k
    induction k with
    | zero =>
      refine ⟨(PiTensorProduct.isEmptyEquiv (Fin 0) : TensorPower S 0 (wcKummerEig (σ 1) ζ) ≃ₗ[S] S).trans
        (j.trans (LinearEquiv.ofEq _ _ (by rw [pow_zero]))), ?_⟩
      intro x
      rw [LinearEquiv.trans_apply, LinearEquiv.trans_apply, LinearEquiv.coe_ofEq_apply, hj,
        PiTensorProduct.isEmptyEquiv_apply_tprod, map_one, Finset.univ_eq_empty, Finset.prod_empty]
    | succ k ih =>
      obtain ⟨g, hg⟩ := ih
      obtain ⟨e, he⟩ := hkey (ζ ^ k) ζ (by
        rw [← pow_mul, mul_comm, pow_mul, hζ.pow_eq_one, one_pow])
      let e1 : TensorPower S 1 (wcKummerEig (σ 1) ζ) ≃ₗ[S] wcKummerEig (σ 1) ζ :=
        PiTensorProduct.subsingletonEquiv 0
      have he1 : ∀ x : Fin 1 → wcKummerEig (σ 1) ζ, e1 (PiTensorProduct.tprod S x) = x 0 := by
        intro x
        exact PiTensorProduct.subsingletonEquiv_apply_tprod 0 x
      refine ⟨(TensorPower.mulEquiv (n := k) (m := 1)).symm.trans ((TensorProduct.congr g e1).trans
        (e.trans (LinearEquiv.ofEq _ _ (by rw [pow_succ])))), ?_⟩
      intro x
      have hsymm : (TensorPower.mulEquiv (R := S) (M := wcKummerEig (σ 1) ζ) (n := k) (m := 1)).symm
          (PiTensorProduct.tprod S x) =
          (PiTensorProduct.tprod S (fun i => x (Fin.castAdd 1 i))) ⊗ₜ[S]
            (PiTensorProduct.tprod S (fun i => x (Fin.natAdd k i))) := by
        rw [LinearEquiv.symm_apply_eq, ← TensorPower.gMul_def, TensorPower.tprod_mul_tprod,
          Fin.append_castAdd_natAdd]
      rw [LinearEquiv.trans_apply, hsymm, LinearEquiv.trans_apply, TensorProduct.congr_tmul,
        LinearEquiv.trans_apply, LinearEquiv.coe_ofEq_apply, he, hg, he1, Fin.prod_univ_add,
        Fin.prod_univ_one]

  obtain ⟨g, hg⟩ := hpow ℓ
  have hζℓ : ζ ^ ℓ = 1 := hζ.pow_eq_one
  have hjs : ∀ z : wcKummerEig (σ 1) (1 : L), algebraMap S B (j.symm z) = z := by
    intro z
    rw [← hj, LinearEquiv.apply_symm_apply]
  obtain ⟨e, he⟩ := hkey ζ (ζ ^ (ℓ - 1)) hζℓ
  have hexp : ζ * ζ ^ (ℓ - 1) = 1 := by
    rw [← pow_succ', Nat.sub_add_cancel hℓ.one_le, hζℓ]
  refine ⟨Module.Invertible.left (e.trans ((LinearEquiv.ofEq _ _ (by rw [hexp])).trans j.symm)),
    (g.trans (LinearEquiv.ofEq _ _ (by rw [hζℓ]))).trans j.symm, ?_⟩
  intro x
  rw [LinearEquiv.trans_apply, hjs, LinearEquiv.trans_apply, LinearEquiv.coe_ofEq_apply, hg]

theorem wc_pic_base_change_alg_closed_injective : ∀ (L : Type u) [Field L] [IsAlgClosed L] (Ω : Type u) [Field Ω] [Algebra L Ω] (A : Type u) [CommRing A] [Algebra L A], Function.Injective (CommRing.Pic.mapAlgebra A (TensorProduct L A Ω)) :=
by
  intro L _ _ Ω _ _ A _ _
  classical

  have hretr : ∀ (B : Type u) [CommRing B] [Algebra A B], (B →ₐ[A] A) →
      Function.Injective (CommRing.Pic.mapAlgebra A B) := by
    intro B _ _ ε
    have h : (CommRing.Pic.mapRingHom (ε : B →+* A)).comp (CommRing.Pic.mapAlgebra A B) =
        MonoidHom.id _ := by
      rw [← CommRing.Pic.mapRingHom_algebraMap, CommRing.Pic.mapRingHom_comp_mapRingHom,
        AlgHom.comp_algebraMap, Algebra.algebraMap_self, CommRing.Pic.mapRingHom_id]
    intro x y hxy
    have hx := DFunLike.congr_fun h x
    have hy := DFunLike.congr_fun h y
    simp only [MonoidHom.comp_apply, MonoidHom.id_apply] at hx hy
    rw [← hx, ← hy, hxy]

  have hpoint : ∀ (S : Type u) [CommRing S] [Nontrivial S] [Algebra L S] [Algebra.FiniteType L S],
      Nonempty (S →ₐ[L] L) := by
    intro S _ _ _ _
    obtain ⟨m, hm⟩ := Ideal.exists_maximal S
    letI : Field (S ⧸ m) := Ideal.Quotient.field m
    haveI : Algebra.FiniteType L (S ⧸ m) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ L m) (Ideal.Quotient.mkₐ_surjective L m)
    haveI : Module.Finite L (S ⧸ m) := finite_of_finite_type_of_isJacobsonRing L (S ⧸ m)
    haveI : Algebra.IsIntegral L (S ⧸ m) := Algebra.IsIntegral.of_finite L (S ⧸ m)
    have hbij : Function.Bijective (algebraMap L (S ⧸ m)) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral
    exact ⟨(AlgEquiv.ofBijective (Algebra.ofId L (S ⧸ m)) hbij).symm.toAlgHom.comp
      (Ideal.Quotient.mkₐ L m)⟩

  have hlift : ∀ c : TensorProduct L A Ω, ∃ s : Finset Ω, ∀ S : Subalgebra L Ω,
      (↑s : Set Ω) ⊆ ↑S → c ∈ Set.range (Algebra.TensorProduct.map (AlgHom.id A A) S.val) := by
    intro c
    induction c using TensorProduct.induction_on with
    | zero => exact ⟨∅, fun S _ => ⟨0, map_zero _⟩⟩
    | tmul a ω =>
      refine ⟨{ω}, fun S hS => ⟨a ⊗ₜ[L] (⟨ω, hS (by simp)⟩ : S), ?_⟩⟩
      simp [Algebra.TensorProduct.map_tmul]
    | add x y hx hy =>
      obtain ⟨sx, hsx⟩ := hx
      obtain ⟨sy, hsy⟩ := hy
      refine ⟨sx ∪ sy, fun S hS => ?_⟩
      rw [Finset.coe_union, Set.union_subset_iff] at hS
      obtain ⟨X, hX⟩ := hsx S hS.1
      obtain ⟨Y, hY⟩ := hsy S hS.2
      exact ⟨X + Y, by rw [map_add, hX, hY]⟩

  have hinj : ∀ S : Subalgebra L Ω,
      Function.Injective (Algebra.TensorProduct.map (AlgHom.id A A) S.val) := by
    intro S
    haveI : Module.Free L A := Module.Free.of_divisionRing L A
    haveI : Module.Flat L A := Module.Flat.of_free
    have h1 : Function.Injective (LinearMap.lTensor A (S.val.toLinearMap)) :=
      Module.Flat.lTensor_preserves_injective_linearMap _ Subtype.val_injective
    have h2 : ∀ x, Algebra.TensorProduct.map (AlgHom.id A A) S.val x =
        LinearMap.lTensor A (S.val.toLinearMap) x := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => simp
      | tmul a s => simp
      | add x y hx hy => rw [map_add, map_add, hx, hy]
    intro x y hxy
    apply h1
    rw [← h2, ← h2, hxy]

  rw [injective_iff_map_eq_one]
  intro x hx
  rw [CommRing.Pic.mapAlgebra_apply, CommRing.Pic.mk_eq_one_iff] at hx
  obtain ⟨φ⟩ := hx
  obtain ⟨k, g, hg⟩ := Module.Finite.exists_fin (R := A) (M := x.AsModule)

  have hdesc : ∀ (B C : Type u) [CommRing B] [CommRing C] [Algebra A B] [Algebra A C]
      (ι : B →ₐ[A] C), Function.Injective ι →
      ∀ (φ : TensorProduct A C x.AsModule ≃ₗ[C] C),
      (∀ i, φ ((1 : C) ⊗ₜ[A] g i) ∈ Set.range ι) →
      φ.symm 1 ∈ Set.range (LinearMap.rTensor x.AsModule ι.toLinearMap) →
      Nonempty (TensorProduct A B x.AsModule ≃ₗ[B] B) := by
    intro B C _ _ _ _ ι hι φ hgen hsym
    let j := LinearMap.rTensor x.AsModule ι.toLinearMap
    have hj : Function.Injective j := Module.Flat.rTensor_preserves_injective_linearMap _ hι
    have hsemi : ∀ (b : B) (z : TensorProduct A B x.AsModule), j (b • z) = ι b • j z := by
      intro b z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul b' n =>
        simp only [j, TensorProduct.smul_tmul', LinearMap.rTensor_tmul, AlgHom.toLinearMap_apply,
          smul_eq_mul, map_mul]
      | add z₁ z₂ h₁ h₂ => rw [smul_add, map_add, h₁, h₂, map_add, smul_add]
    have hall : ∀ n : x.AsModule, φ ((1 : C) ⊗ₜ[A] n) ∈ ι.range := by
      let P : Submodule A x.AsModule := Submodule.comap
        ((φ.restrictScalars A).toLinearMap ∘ₗ TensorProduct.mk A C x.AsModule 1)
        (Subalgebra.toSubmodule ι.range)
      have hP : Submodule.span A (Set.range g) ≤ P := by
        rw [Submodule.span_le]
        rintro _ ⟨i, rfl⟩
        exact (AlgHom.mem_range ι).2 (hgen i)
      intro n
      have hn : n ∈ P := hP (hg ▸ Submodule.mem_top)
      exact hn
    have hd : ∀ z : TensorProduct A B x.AsModule, φ (j z) ∈ ι.range := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => rw [map_zero, map_zero]; exact zero_mem _
      | tmul b n =>
        have e : j (b ⊗ₜ n) = ι b • ((1 : C) ⊗ₜ[A] n) := by
          simp only [j, LinearMap.rTensor_tmul, AlgHom.toLinearMap_apply, TensorProduct.smul_tmul',
            smul_eq_mul, mul_one]
        rw [e, LinearEquiv.map_smul, smul_eq_mul]
        exact mul_mem (AlgHom.mem_range_self ι b) (hall n)
      | add z₁ z₂ h₁ h₂ => rw [map_add, map_add]; exact add_mem h₁ h₂
    obtain ⟨z₀, hz₀⟩ := hsym
    let ψ : B →ₗ[B] TensorProduct A B x.AsModule := LinearMap.toSpanSingleton B _ z₀
    have hK2 : ∀ b, j (ψ b) = φ.symm (ι b) := by
      intro b
      rw [LinearMap.toSpanSingleton_apply, hsemi]
      rw [show j z₀ = φ.symm 1 from hz₀, ← LinearEquiv.map_smul, smul_eq_mul, mul_one]
    have hψinj : Function.Injective ψ := by
      intro b₁ b₂ h
      have h' := congrArg j h
      rw [hK2, hK2] at h'
      exact hι (φ.symm.injective h')
    have hψsurj : Function.Surjective ψ := by
      intro z
      obtain ⟨b, hb⟩ := (AlgHom.mem_range ι).1 (hd z)
      exact ⟨b, hj (by rw [hK2, hb, LinearEquiv.symm_apply_apply])⟩
    exact ⟨(LinearEquiv.ofBijective ψ ⟨hψinj, hψsurj⟩).symm⟩

  have hliftN : ∀ m : TensorProduct A (TensorProduct L A Ω) x.AsModule, ∃ s : Finset Ω,
      ∀ S : Subalgebra L Ω, (↑s : Set Ω) ⊆ ↑S → m ∈ Set.range (LinearMap.rTensor x.AsModule
        (Algebra.TensorProduct.map (AlgHom.id A A) S.val).toLinearMap) := by
    intro m
    induction m using TensorProduct.induction_on with
    | zero => exact ⟨∅, fun S _ => ⟨0, map_zero _⟩⟩
    | tmul c n =>
      obtain ⟨s, hs⟩ := hlift c
      refine ⟨s, fun S hS => ?_⟩
      obtain ⟨c', hc'⟩ := hs S hS
      exact ⟨c' ⊗ₜ n, by rw [LinearMap.rTensor_tmul, AlgHom.toLinearMap_apply, hc']⟩
    | add p q hp hq =>
      obtain ⟨sx, hsx⟩ := hp
      obtain ⟨sy, hsy⟩ := hq
      refine ⟨sx ∪ sy, fun S hS => ?_⟩
      rw [Finset.coe_union, Set.union_subset_iff] at hS
      obtain ⟨X, hX⟩ := hsx S hS.1
      obtain ⟨Y, hY⟩ := hsy S hS.2
      exact ⟨X + Y, by rw [map_add, hX, hY]⟩

  choose sg hsg using fun i : Fin k => hlift (φ ((1 : TensorProduct L A Ω) ⊗ₜ[A] g i))
  obtain ⟨s', hs'⟩ := hliftN (φ.symm 1)
  let T : Subalgebra L Ω := Algebra.adjoin L (↑(s' ∪ Finset.univ.biUnion sg) : Set Ω)
  have hT : (↑(s' ∪ Finset.univ.biUnion sg) : Set Ω) ⊆ ↑T := Algebra.subset_adjoin
  obtain ⟨ψ⟩ := hdesc (TensorProduct L A T) (TensorProduct L A Ω)
    (Algebra.TensorProduct.map (AlgHom.id A A) T.val) (hinj T) φ
    (fun i => hsg i T ((Finset.coe_subset.2 ((Finset.subset_biUnion_of_mem sg (Finset.mem_univ i)).trans
      Finset.subset_union_right)).trans hT))
    (hs' T ((Finset.coe_subset.2 Finset.subset_union_left).trans hT))
  have hx1 : CommRing.Pic.mapAlgebra A (TensorProduct L A T) x = 1 := by
    rw [CommRing.Pic.mapAlgebra_apply, CommRing.Pic.mk_eq_one_iff]
    exact ⟨ψ⟩

  haveI : Algebra.FiniteType L T := Algebra.FiniteType.adjoin_of_finite (Finset.finite_toSet _)
  obtain ⟨e⟩ := hpoint T
  let ε : TensorProduct L A T →ₐ[A] A :=
    Algebra.TensorProduct.lift (AlgHom.id A A) ((Algebra.ofId L A).comp e)
      (fun _ _ => Commute.all _ _)
  exact hretr _ ε (hx1.trans (map_one _).symm)

theorem wc_units_pow_base_change_alg_closed : ∀ (L : Type u) [Field L] [IsAlgClosed L] (Ω : Type u) [Field Ω] [Algebra L Ω] (A : Type u) [CommRing A] [Algebra L A] (n : ℕ) (v : Aˣ) (w : (TensorProduct L A Ω)ˣ), (w : TensorProduct L A Ω) ^ n = algebraMap A (TensorProduct L A Ω) (v : A) → ∃ w₀ : Aˣ, (w₀ : A) ^ n = (v : A) :=
by
  intro L _ _ Ω _ _ A _ _ n v w hw
  classical

  have hlift : ∀ x : TensorProduct L A Ω, ∃ s : Finset Ω, ∀ S : Subalgebra L Ω,
      (↑s : Set Ω) ⊆ ↑S → x ∈ Set.range (Algebra.TensorProduct.map (AlgHom.id L A) S.val) := by
    intro x
    induction x using TensorProduct.induction_on with
    | zero => exact ⟨∅, fun S _ => ⟨0, map_zero _⟩⟩
    | tmul a ω =>
      refine ⟨{ω}, fun S hS => ⟨a ⊗ₜ[L] (⟨ω, hS (by simp)⟩ : S), ?_⟩⟩
      simp [Algebra.TensorProduct.map_tmul]
    | add x y hx hy =>
      obtain ⟨sx, hsx⟩ := hx
      obtain ⟨sy, hsy⟩ := hy
      refine ⟨sx ∪ sy, fun S hS => ?_⟩
      rw [Finset.coe_union, Set.union_subset_iff] at hS
      obtain ⟨X, hX⟩ := hsx S hS.1
      obtain ⟨Y, hY⟩ := hsy S hS.2
      exact ⟨X + Y, by rw [map_add, hX, hY]⟩

  have hinj : ∀ S : Subalgebra L Ω,
      Function.Injective (Algebra.TensorProduct.map (AlgHom.id L A) S.val) := by
    intro S
    haveI : Module.Free L A := Module.Free.of_divisionRing L A
    haveI : Module.Flat L A := Module.Flat.of_free
    have h1 : Function.Injective (LinearMap.lTensor A (S.val.toLinearMap)) :=
      Module.Flat.lTensor_preserves_injective_linearMap _ Subtype.val_injective
    have h2 : ∀ x, Algebra.TensorProduct.map (AlgHom.id L A) S.val x =
        LinearMap.lTensor A (S.val.toLinearMap) x := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => simp
      | tmul a s => simp
      | add x y hx hy => rw [map_add, map_add, hx, hy]
    intro x y hxy
    apply h1
    rw [← h2, ← h2, hxy]

  have hpoint : ∀ (S : Type u) [CommRing S] [Nontrivial S] [Algebra L S] [Algebra.FiniteType L S],
      Nonempty (S →ₐ[L] L) := by
    intro S _ _ _ _
    obtain ⟨m, hm⟩ := Ideal.exists_maximal S
    letI : Field (S ⧸ m) := Ideal.Quotient.field m
    haveI : Algebra.FiniteType L (S ⧸ m) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ L m) (Ideal.Quotient.mkₐ_surjective L m)
    haveI : Module.Finite L (S ⧸ m) := finite_of_finite_type_of_isJacobsonRing L (S ⧸ m)
    haveI : Algebra.IsIntegral L (S ⧸ m) := Algebra.IsIntegral.of_finite L (S ⧸ m)
    have hbij : Function.Bijective (algebraMap L (S ⧸ m)) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral
    exact ⟨(AlgEquiv.ofBijective (Algebra.ofId L (S ⧸ m)) hbij).symm.toAlgHom.comp
      (Ideal.Quotient.mkₐ L m)⟩

  obtain ⟨s₁, hs₁⟩ := hlift (w : TensorProduct L A Ω)
  obtain ⟨s₂, hs₂⟩ := hlift ((w⁻¹ : (TensorProduct L A Ω)ˣ) : TensorProduct L A Ω)
  let S : Subalgebra L Ω := Algebra.adjoin L (↑(s₁ ∪ s₂) : Set Ω)
  have hsS : (↑(s₁ ∪ s₂) : Set Ω) ⊆ ↑S := Algebra.subset_adjoin
  obtain ⟨W, hW⟩ := hs₁ S ((Finset.coe_subset.2 Finset.subset_union_left).trans hsS)
  obtain ⟨W', hW'⟩ := hs₂ S ((Finset.coe_subset.2 Finset.subset_union_right).trans hsS)
  have hWW' : W * W' = 1 := hinj S (by rw [map_mul, map_one, hW, hW', Units.mul_inv])
  have hWn : W ^ n = (v : A) ⊗ₜ[L] (1 : S) := hinj S (by
    rw [map_pow, hW, hw, Algebra.TensorProduct.map_tmul, map_one]
    simp [Algebra.TensorProduct.algebraMap_apply])
  haveI : Algebra.FiniteType L S := Algebra.FiniteType.adjoin_of_finite (Finset.finite_toSet _)
  obtain ⟨φ⟩ := hpoint S
  let ρ : TensorProduct L A S →ₐ[L] A :=
    (Algebra.TensorProduct.rid L L A).toAlgHom.comp (Algebra.TensorProduct.map (AlgHom.id L A) φ)
  have hρ1 : ρ ((v : A) ⊗ₜ[L] (1 : S)) = (v : A) := by simp [ρ]
  refine ⟨⟨ρ W, ρ W', by rw [← map_mul, hWW', map_one],
    by rw [← map_mul, mul_comm, hWW', map_one]⟩, ?_⟩
  show ρ W ^ n = (v : A)
  rw [← map_pow, hWn, hρ1]

theorem wc_pic_pi_local_subsingleton : ∀ (ι : Type u) (R : ι → Type u) [∀ i, CommRing (R i)] [∀ i, IsLocalRing (R i)], Subsingleton (CommRing.Pic (∀ i, R i)) :=
by
  intro ι R _ _
  letI alg : ∀ i, Algebra (∀ j, R j) (R i) := fun i => (Pi.evalRingHom R i).toAlgebra
  have hsm : ∀ i (c : ∀ j, R j) (r : R i), c • r = c i * r := fun i c r => rfl

  have s2 : ∀ (F M : Type u) [AddCommGroup F] [Module (∀ j, R j) F] [AddCommGroup M]
      [Module (∀ j, R j) M] (p : F →ₗ[∀ j, R j] M) (s : M →ₗ[∀ j, R j] F),
      p ∘ₗ s = LinearMap.id →
      Function.Bijective (fun (v : F) (i : ι) => (1 : R i) ⊗ₜ[∀ j, R j] v) →
      Function.Bijective (fun (m : M) (i : ι) => (1 : R i) ⊗ₜ[∀ j, R j] m) := by
    intro F M _ _ _ _ p s hps hF
    have hps' : ∀ x, p (s x) = x := fun x => LinearMap.congr_fun hps x
    have hlt : ∀ i (t : TensorProduct (∀ j, R j) (R i) M),
        (p.lTensor (R i)) ((s.lTensor (R i)) t) = t := by
      intro i t
      rw [← LinearMap.comp_apply, ← LinearMap.lTensor_comp, hps, LinearMap.lTensor_id,
        LinearMap.id_apply]
    constructor
    · intro m m' h
      have h2 : (fun i => (1 : R i) ⊗ₜ[∀ j, R j] (s m)) =
          (fun i => (1 : R i) ⊗ₜ[∀ j, R j] (s m')) := by
        funext i
        have h3 := congrArg (s.lTensor (R i)) (congrFun h i)
        simpa only [LinearMap.lTensor_tmul] using h3
      have h4 : s m = s m' := hF.1 h2
      rw [← hps' m, ← hps' m', h4]
    · intro t
      obtain ⟨f, hf⟩ := hF.2 (fun i => s.lTensor (R i) (t i))
      refine ⟨p f, ?_⟩
      funext i
      have h3 : (1 : R i) ⊗ₜ[∀ j, R j] f = s.lTensor (R i) (t i) := congrFun hf i
      show (1 : R i) ⊗ₜ[∀ j, R j] (p f) = t i
      rw [← LinearMap.lTensor_tmul, h3, hlt]

  have s1 : ∀ n : ℕ,
      Function.Bijective (fun (v : Fin n → ∀ j, R j) (i : ι) => (1 : R i) ⊗ₜ[∀ j, R j] v) := by
    intro n
    let Ψ : ∀ i, TensorProduct (∀ j, R j) (R i) (Fin n → ∀ j, R j) ≃ₗ[∀ j, R j] (Fin n → R i) :=
      fun i => (TensorProduct.piRight (∀ j, R j) (∀ j, R j) (R i) (fun _ : Fin n => ∀ j, R j)).trans
        (LinearEquiv.piCongrRight fun _ => TensorProduct.rid (∀ j, R j) (R i))
    let Ψe : (∀ i, TensorProduct (∀ j, R j) (R i) (Fin n → ∀ j, R j)) ≃ (∀ i, Fin n → R i) :=
      Equiv.piCongrRight fun i => (Ψ i).toEquiv
    have hcomp : Ψe ∘ (fun (v : Fin n → ∀ j, R j) (i : ι) => (1 : R i) ⊗ₜ[∀ j, R j] v) =
        Equiv.piComm (fun (_ : Fin n) (i : ι) => R i) := by
      funext v i k
      show (TensorProduct.rid (∀ j, R j) (R i))
          ((TensorProduct.piRight (∀ j, R j) (∀ j, R j) (R i) (fun _ : Fin n => ∀ j, R j))
            ((1 : R i) ⊗ₜ[∀ j, R j] v) k) = v k i
      rw [TensorProduct.piRight_apply, TensorProduct.piRightHom_tmul, TensorProduct.rid_tmul,
        hsm, mul_one]
    rw [← Function.Bijective.of_comp_iff' Ψe.bijective, hcomp]
    exact Equiv.bijective _

  have s3 : ∀ (M : Type u) [AddCommGroup M] [Module (∀ j, R j) M],
      Function.Bijective (fun (m : M) (i : ι) => (1 : R i) ⊗ₜ[∀ j, R j] m) →
      (∀ i, Nonempty (TensorProduct (∀ j, R j) (R i) M ≃ₗ[R i] R i)) →
      Module.Free (∀ j, R j) M := by
    intro M _ _ hΦ he
    let e : ∀ i, TensorProduct (∀ j, R j) (R i) M ≃ₗ[R i] R i := fun i => (he i).some
    obtain ⟨m₀, hm₀⟩ := hΦ.2 (fun i => (e i).symm 1)
    let T : (∀ j, R j) →ₗ[∀ j, R j] M := LinearMap.toSpanSingleton _ M m₀
    let E : (∀ i, TensorProduct (∀ j, R j) (R i) M) → (∀ i, R i) := fun x i => e i (x i)
    have hE : Function.Bijective E := (Equiv.piCongrRight fun i => (e i).toEquiv).bijective
    have key : ∀ c : ∀ j, R j,
        E ((fun (m : M) (i : ι) => (1 : R i) ⊗ₜ[∀ j, R j] m) (T c)) = c := by
      intro c
      funext i
      have h1 : (1 : R i) ⊗ₜ[∀ j, R j] m₀ = (e i).symm 1 := congrFun hm₀ i
      show e i ((1 : R i) ⊗ₜ[∀ j, R j] (c • m₀)) = c i
      rw [TensorProduct.tmul_smul, ← algebraMap_smul (R i) c, h1, LinearEquiv.map_smul,
        LinearEquiv.apply_symm_apply, smul_eq_mul, mul_one]
      rfl
    have hT : Function.Bijective T := by
      have hc : Function.Bijective
          ((E ∘ (fun (m : M) (i : ι) => (1 : R i) ⊗ₜ[∀ j, R j] m)) ∘ T) := by
        have h5 : ((E ∘ (fun (m : M) (i : ι) => (1 : R i) ⊗ₜ[∀ j, R j] m)) ∘ T) = id :=
          funext key
        rw [h5]
        exact Function.bijective_id
      exact (Function.Bijective.of_comp_iff' (hE.comp hΦ) T).mp hc
    exact Module.Free.of_equiv (LinearEquiv.ofBijective T hT)

  rw [CommRing.Pic.subsingleton_iff]
  intro M _ _ hM
  haveI := hM
  obtain ⟨n, f, hf⟩ := Module.Finite.exists_fin' (∀ j, R j) M
  obtain ⟨s, hs⟩ := Module.projective_lifting_property f LinearMap.id hf
  have hΦ := s2 (Fin n → ∀ j, R j) M f s hs (s1 n)
  apply s3 M hΦ
  intro i
  exact (CommRing.Pic.mk_eq_mk_iff (R := R i) (M := TensorProduct (∀ j, R j) (R i) M)
    (N := R i)).mp (Subsingleton.elim _ _)

theorem wc_zar_germ_units_sheaf : ∀ (X : Scheme.{u}), ∃ (K : Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}) (eK : ∀ V : X.Opens, K.obj.obj (Opposite.op V) ≃+ Additive (∀ x : V, (X.presheaf.stalk (x : X))ˣ)) (i : wcZarGm X ⟶ K), (∀ (V W : X.Opens) (h : W ≤ V) (k : K.obj.obj (Opposite.op V)) (x : W), Additive.toMul (eK W (K.obj.map (homOfLE h).op k)) x = Additive.toMul (eK V k) ⟨x, h x.2⟩) ∧ (∀ (V : X.Opens) (k : K.obj.obj (Opposite.op V)), (∃ g, i.hom.app (Opposite.op V) g = k) ↔ ∃ s : (Γ(X, V))ˣ, ∀ x : V, Additive.toMul (eK V k) x = Units.map (X.presheaf.germ V x x.2).hom.toMonoidHom s) ∧ (∀ V : X.Opens, Function.Injective (i.hom.app (Opposite.op V))) :=
by
  intro X
  classical
  let T : X → Type u := fun x => (X.presheaf.stalk x)ˣ

  let F : (X.Opens)ᵒᵖ ⥤ AddCommGrpCat.{u} :=
    { obj := fun V => AddCommGrpCat.of (Additive (∀ x : V.unop, (X.presheaf.stalk (x : X))ˣ))
      map := fun {V W} f => AddCommGrpCat.ofHom
        { toFun := fun a => Additive.ofMul (fun x : W.unop => Additive.toMul a ⟨x, leOfHom f.unop x.2⟩)
          map_zero' := rfl
          map_add' := fun _ _ => rfl }
      map_id := fun _ => rfl
      map_comp := fun _ _ => rfl }
  have hF : Presheaf.IsSheaf (Opens.grothendieckTopology X) F := by
    rw [Presheaf.isSheaf_iff_isSheaf_forget (Opens.grothendieckTopology X) F (forget AddCommGrpCat.{u})]
    have e : F ⋙ forget AddCommGrpCat.{u} ≅ TopCat.presheafToTypes X.toTopCat T :=
      NatIso.ofComponents (fun V => Equiv.toIso
        (Additive.toMul : Additive (∀ x : V.unop, (X.presheaf.stalk (x : X))ˣ) ≃ _))
        (by intros; rfl)
    exact (Presheaf.isSheaf_of_iso_iff e).mpr (TopCat.Presheaf.toTypes_isSheaf X.toTopCat T)
  let K : Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u} := ⟨F, hF⟩
  let P := X.presheaf ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙ CommGrpCat.toAddCommGrp

  let ψ : P ⟶ F :=
    { app := fun V => AddCommGrpCat.ofHom (MonoidHom.toAdditive
        (MonoidHom.pi fun x : V.unop => Units.map (X.presheaf.germ V.unop x x.2).hom.toMonoidHom))
      naturality := by
        intro V W f
        ext a
        apply Additive.toMul.injective
        funext x
        apply Units.ext
        exact TopCat.Presheaf.germ_res_apply X.presheaf f.unop x x.2 _ }
  let i : wcZarGm X ⟶ K := ObjectProperty.homMk (sheafifyLift (Opens.grothendieckTopology X) ψ hF)
  have hcomp : toSheafify (Opens.grothendieckTopology X) P ≫ i.hom = ψ :=
    toSheafify_sheafifyLift _ _ _
  have hi : ∀ (V : X.Opens) (a : P.obj (Opposite.op V)),
      i.hom.app (Opposite.op V) ((toSheafify (Opens.grothendieckTopology X) P).app (Opposite.op V) a)
        = ψ.app (Opposite.op V) a := by
    intro V a
    rw [← hcomp]
    rfl

  have hlift : ∀ (V : X.Opens) (g : (wcZarGm X).obj.obj (Opposite.op V)) (x : X), x ∈ V →
      ∃ (W : X.Opens) (h : W ≤ V), x ∈ W ∧ ∃ s : (Γ(X, W))ˣ,
        (toSheafify (Opens.grothendieckTopology X) P).app (Opposite.op W) (Additive.ofMul s) =
          (wcZarGm X).obj.map (homOfLE h).op g := by
    intro V g x hx
    haveI := Presheaf.isLocallySurjective_toSheafify' (Opens.grothendieckTopology X) P
    have hmem := Presheaf.imageSieve_mem (Opens.grothendieckTopology X)
      (toSheafify (Opens.grothendieckTopology X) P) g
    obtain ⟨W, f, ⟨t, ht⟩, hxW⟩ := hmem x hx
    exact ⟨W, leOfHom f, hxW, Additive.toMul t, ht⟩

  have hR : ∀ (V W : X.Opens) (h : W ≤ V) (g : (wcZarGm X).obj.obj (Opposite.op V)) (s : (Γ(X, W))ˣ),
      (toSheafify (Opens.grothendieckTopology X) P).app (Opposite.op W) (Additive.ofMul s) =
        (wcZarGm X).obj.map (homOfLE h).op g →
      ∀ y : W, Additive.toMul (i.hom.app (Opposite.op V) g :
          Additive (∀ x : V, (X.presheaf.stalk (x : X))ˣ)) ⟨y, h y.2⟩ =
        Units.map (X.presheaf.germ W y y.2).hom.toMonoidHom s := by
    intro V W h g s hs y
    have h1 := NatTrans.naturality_apply i.hom (homOfLE h).op g
    rw [← hs] at h1
    have h3 := (hi W _).symm.trans h1
    have h2 := congrArg (fun a : Additive (∀ x : W, (X.presheaf.stalk (x : X))ˣ) => Additive.toMul a y) h3
    exact h2.symm

  have hinj : ∀ V : X.Opens, Function.Injective (i.hom.app (Opposite.op V)) := by
    intro V
    refine (injective_iff_map_eq_zero (i.hom.app (Opposite.op V)).hom).mpr ?_
    intro g hg
    choose W hW hpW s hs using fun p : V => hlift V g p p.2
    have hs1 : ∀ p, s p = 1 := by
      intro p
      apply Units.ext
      apply TopCat.Presheaf.section_ext X.sheaf (W p)
      intro y hy
      have h0 := hR V (W p) (hW p) g (s p) (hs p) ⟨y, hy⟩
      have h3 : (i.hom.app (Opposite.op V)) g = 0 := hg
      rw [h3] at h0
      have h4 : (1 : (X.presheaf.stalk y)ˣ) =
          Units.map (X.presheaf.germ (W p) y hy).hom.toMonoidHom (s p) := h0
      have h5 := congrArg Units.val h4
      rw [Units.val_one, Units.coe_map] at h5
      show (X.presheaf.germ (W p) y hy).hom (s p : Γ(X, W p)) =
        (X.presheaf.germ (W p) y hy).hom ((1 : (Γ(X, W p))ˣ) : Γ(X, W p))
      rw [Units.val_one, map_one]
      exact h5.symm
    have hcov : V ≤ iSup W := by
      intro y hy
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨y, hy⟩, hpW ⟨y, hy⟩⟩
    have hloc : ∀ p : V, (wcZarGm X).obj.map (homOfLE (hW p)).op g =
        (wcZarGm X).obj.map (homOfLE (hW p)).op 0 := by
      intro p
      rw [← hs p, hs1 p, map_zero]
      exact map_zero ((toSheafify (Opens.grothendieckTopology X) P).app (Opposite.op (W p))).hom
    exact TopCat.Sheaf.eq_of_locally_eq' (wcZarGm X) W V (fun p => homOfLE (hW p)) hcov g 0 hloc
  refine ⟨K, fun V => AddEquiv.refl _, i, fun V W h k x => rfl, ?_, hinj⟩
  intro V k
  constructor
  · rintro ⟨g, rfl⟩
    choose W hW hpW s hs using fun p : V => hlift V g p p.2
    have hA : ∀ p (y : W p), ((Additive.toMul (i.hom.app (Opposite.op V) g :
          Additive (∀ x : V, (X.presheaf.stalk (x : X))ˣ)) ⟨y, hW p y.2⟩ : (X.presheaf.stalk y)ˣ) :
          X.presheaf.stalk y) = (X.presheaf.germ (W p) y y.2).hom (s p) := by
      intro p y
      rw [hR V (W p) (hW p) g (s p) (hs p) y]
      rfl
    have hcov : V ≤ iSup W := by
      intro y hy
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨y, hy⟩, hpW ⟨y, hy⟩⟩
    have hcompat : TopCat.Presheaf.IsCompatible X.sheaf.obj W (fun p => ((s p : Γ(X, W p)))) := by
      intro p q
      apply TopCat.Presheaf.section_ext X.sheaf (W p ⊓ W q)
      intro y hy
      have e1 := TopCat.Presheaf.germ_res_apply X.presheaf (TopologicalSpace.Opens.infLELeft (W p) (W q))
        y hy (s p : Γ(X, W p))
      have e2 := TopCat.Presheaf.germ_res_apply X.presheaf (TopologicalSpace.Opens.infLERight (W p) (W q))
        y hy (s q : Γ(X, W q))
      refine e1.trans (Eq.trans ?_ e2.symm)
      exact (hA p ⟨y, hy.1⟩).symm.trans (hA q ⟨y, hy.2⟩)
    obtain ⟨σ, hσ, -⟩ :=
      TopCat.Sheaf.existsUnique_gluing' X.sheaf W V (fun p => homOfLE (hW p)) hcov _ hcompat
    have hgerm : ∀ y : V, (X.presheaf.germ V y y.2).hom σ =
        ((Additive.toMul (i.hom.app (Opposite.op V) g :
          Additive (∀ x : V, (X.presheaf.stalk (x : X))ˣ)) y : (X.presheaf.stalk y)ˣ) :
          X.presheaf.stalk y) := by
      intro y
      have e := TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE (hW y)) (y : X) (hpW y) σ
      have e2 : (X.presheaf.map (homOfLE (hW y)).op).hom σ = (s y : Γ(X, W y)) := hσ y
      rw [← e, e2]
      exact (hA y ⟨y, hpW y⟩).symm
    have hunit : IsUnit (σ : Γ(X, V)) :=
      RingedSpace.isUnit_of_isUnit_germ X.toRingedSpace V σ (fun y hy => by
        show IsUnit ((X.presheaf.germ V y hy).hom σ)
        rw [hgerm ⟨y, hy⟩]
        exact Units.isUnit _)
    refine ⟨hunit.unit, fun y => Units.ext ?_⟩
    have e3 : ((Units.map (X.presheaf.germ V y y.2).hom.toMonoidHom hunit.unit :
        (X.presheaf.stalk y)ˣ) : X.presheaf.stalk y) = (X.presheaf.germ V y y.2).hom σ := by
      exact congrArg (fun z => (X.presheaf.germ V y y.2).hom z) hunit.unit_spec
    exact (hgerm y).symm.trans e3.symm
  · rintro ⟨s, hs⟩
    refine ⟨(toSheafify (Opens.grothendieckTopology X) P).app (Opposite.op V) (Additive.ofMul s), ?_⟩
    refine (hi V _).trans ?_
    exact congrArg Additive.ofMul (funext fun x => (hs x).symm)

theorem wc_germ_cocycle_partition : ∀ (X : Scheme.{u}) [IsAffine X] (n : ℕ) (f : Fin n → Γ(X, ⊤)), Ideal.span (Set.range f) = ⊤ → ∀ (t : ∀ j : Fin n, ∀ x : X.basicOpen (f j), (X.presheaf.stalk (x : X))ˣ), (∀ j k : Fin n, ∃ u : (Γ(X, X.basicOpen (f j) ⊓ X.basicOpen (f k)))ˣ, ∀ (x : X) (hj : x ∈ X.basicOpen (f j)) (hk : x ∈ X.basicOpen (f k)), ((t j ⟨x, hj⟩ : (X.presheaf.stalk x)ˣ) : X.presheaf.stalk x) = (t k ⟨x, hk⟩ : X.presheaf.stalk x) * (X.presheaf.germ (X.basicOpen (f j) ⊓ X.basicOpen (f k)) x ⟨hj, hk⟩).hom (u : Γ(X, X.basicOpen (f j) ⊓ X.basicOpen (f k)))) → ∃ (m : ℕ) (a b : Fin m → ∀ x : X, X.presheaf.stalk x), (∀ l j, ∃ c : Γ(X, X.basicOpen (f j)), ∀ (x : X) (hx : x ∈ X.basicOpen (f j)), a l x = (t j ⟨x, hx⟩ : X.presheaf.stalk x) * (X.presheaf.germ (X.basicOpen (f j)) x hx).hom c) ∧ (∀ l j, ∃ c : Γ(X, X.basicOpen (f j)), ∀ (x : X) (hx : x ∈ X.basicOpen (f j)), b l x = (((t j ⟨x, hx⟩)⁻¹ : (X.presheaf.stalk x)ˣ) : X.presheaf.stalk x) * (X.presheaf.germ (X.basicOpen (f j)) x hx).hom c) ∧ ∑ l, a l * b l = 1 :=
by
  intro X _ n f hspan t hcoc
  classical

  obtain ⟨G, hG⟩ : ∃ G : ∀ (V : X.Opens) (x : X), x ∈ V → (Γ(X, V) →+* X.presheaf.stalk x),
      ∀ V x hx s, G V x hx s = (X.presheaf.germ V x hx).hom s :=
    ⟨fun V x hx => (X.presheaf.germ V x hx).hom, fun _ _ _ _ => rfl⟩
  obtain ⟨gam, hgam⟩ : ∃ gam : ∀ x : X, Γ(X, ⊤) →+* X.presheaf.stalk x,
      ∀ x (h : x ∈ (⊤ : X.Opens)) g, G ⊤ x h g = gam x g :=
    ⟨fun x => G ⊤ x trivial, fun _ _ _ => rfl⟩
  have hGres : ∀ (V W : X.Opens) (h : W ≤ V) (x : X) (hx : x ∈ W) (s : Γ(X, V)),
      G W x hx ((X.presheaf.map (homOfLE h).op).hom s) = G V x (h hx) s := by
    intro V W h x hx s
    rw [hG, hG, TopCat.Presheaf.germ_res_apply]
  have hsec0 : ∀ (V : X.Opens) (s : Γ(X, V)), (∀ x (hx : x ∈ V), G V x hx s = 0) → s = 0 := by
    intro V s hs
    apply TopCat.Presheaf.section_ext X.sheaf V s 0
    intro x hx
    rw [map_zero]
    have h := hs x hx
    rw [hG] at h
    exact h
  have hbump : ∀ (x : X) (g s : X.presheaf.stalk x) (p P : ℕ), p ≤ P → g ^ p * s = 0 →
      g ^ P * s = 0 := by
    intro x g s p P hpP h
    rw [← Nat.sub_add_cancel hpP, pow_add, mul_assoc, h, mul_zero]

  have hext : ∀ (V : X.Opens), IsAffineOpen V → ∀ (g : Γ(X, ⊤)) (s : Γ(X, X.basicOpen g ⊓ V)),
      ∃ (N : ℕ) (y : Γ(X, V)), ∀ (x : X) (hg : x ∈ X.basicOpen g) (hV : x ∈ V),
        G V x hV y = (gam x g) ^ N * G (X.basicOpen g ⊓ V) x ⟨hg, hV⟩ s := by
    intro V hV g s
    have hb : X.basicOpen ((X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom g) =
        X.basicOpen g ⊓ V := by
      rw [Scheme.basicOpen_res, inf_comm]
    obtain ⟨N, y, hy⟩ := exists_eq_pow_mul_of_isAffineOpen X V hV
      ((X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom g)
      ((X.presheaf.map (homOfLE hb.le).op).hom s)
    refine ⟨N, y, fun x hg hV' => ?_⟩
    have hx : x ∈ X.basicOpen ((X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom g) := by
      rw [hb]; exact ⟨hg, hV'⟩
    have h := congrArg (G _ x hx) hy
    simp only [TopCat.Presheaf.restrictOpen, TopCat.Presheaf.restrict, map_mul, map_pow,
      hGres, hgam] at h
    exact h

  have hkill : ∀ (V : X.Opens), IsAffineOpen V → ∀ (g : Γ(X, ⊤)) (s : Γ(X, V)),
      (∀ (x : X) (hV : x ∈ V), x ∈ X.basicOpen g → G V x hV s = 0) →
      ∃ N : ℕ, ∀ (x : X) (hV : x ∈ V), (gam x g) ^ N * G V x hV s = 0 := by
    intro V hV g s hs
    have hb : X.basicOpen ((X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom g) =
        V ⊓ X.basicOpen g := by rw [Scheme.basicOpen_res]
    obtain ⟨N, hN⟩ := exists_pow_mul_eq_zero_of_res_basicOpen_eq_zero_of_isAffineOpen X hV s
      ((X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom g)
      (by
        apply hsec0
        intro x hx
        simp only [TopCat.Presheaf.restrictOpen, TopCat.Presheaf.restrict]
        rw [hGres]
        have hx' : x ∈ V ⊓ X.basicOpen g := by rw [← hb]; exact hx
        exact hs x _ hx'.2)
    refine ⟨N, fun x hV' => ?_⟩
    have h := congrArg (G V x hV') hN
    rw [map_mul, map_pow, hGres, map_zero] at h
    simp only [hgam] at h
    exact h

  have hD : ∀ k, IsAffineOpen (X.basicOpen (f k)) := fun k => (isAffineOpen_top X).basicOpen (f k)
  have hDD : ∀ j k, IsAffineOpen (X.basicOpen (f j) ⊓ X.basicOpen (f k)) := by
    intro j k
    have h := (isAffineOpen_top X).basicOpen (f j * f k)
    rwa [Scheme.basicOpen_mul] at h

  obtain ⟨res, hρ⟩ : ∃ res : ∀ k, Γ(X, ⊤) →+* Γ(X, X.basicOpen (f k)),
      ∀ k g x (hx : x ∈ X.basicOpen (f k)), G _ x hx (res k g) = gam x g :=
    ⟨fun k => (X.presheaf.map (homOfLE (le_top : X.basicOpen (f k) ≤ ⊤)).op).hom,
      fun k g x hx => by rw [hGres, hgam]⟩
  obtain ⟨rL, hrL⟩ : ∃ rL : ∀ j k, Γ(X, X.basicOpen (f j)) →+*
        Γ(X, X.basicOpen (f j) ⊓ X.basicOpen (f k)),
      ∀ j k s x (hx : x ∈ X.basicOpen (f j) ⊓ X.basicOpen (f k)),
        G _ x hx (rL j k s) = G _ x hx.1 s :=
    ⟨fun j k => (X.presheaf.map (homOfLE (inf_le_left :
        X.basicOpen (f j) ⊓ X.basicOpen (f k) ≤ X.basicOpen (f j))).op).hom,
      fun j k s x hx => hGres _ _ _ _ _ _⟩
  obtain ⟨rR, hrR⟩ : ∃ rR : ∀ j k, Γ(X, X.basicOpen (f k)) →+*
        Γ(X, X.basicOpen (f j) ⊓ X.basicOpen (f k)),
      ∀ j k s x (hx : x ∈ X.basicOpen (f j) ⊓ X.basicOpen (f k)),
        G _ x hx (rR j k s) = G _ x hx.2 s :=
    ⟨fun j k => (X.presheaf.map (homOfLE (inf_le_right :
        X.basicOpen (f j) ⊓ X.basicOpen (f k) ≤ X.basicOpen (f k))).op).hom,
      fun j k s x hx => hGres _ _ _ _ _ _⟩

  have hsec : ∀ (τ : ∀ j : Fin n, ∀ x : X.basicOpen (f j), (X.presheaf.stalk (x : X))ˣ)
      (v : ∀ j k : Fin n, (Γ(X, X.basicOpen (f j) ⊓ X.basicOpen (f k)))ˣ),
      (∀ j k (x : X) (hj : x ∈ X.basicOpen (f j)) (hk : x ∈ X.basicOpen (f k)),
        ((τ j ⟨x, hj⟩ : (X.presheaf.stalk x)ˣ) : X.presheaf.stalk x) =
          (τ k ⟨x, hk⟩ : X.presheaf.stalk x) * G (X.basicOpen (f j) ⊓ X.basicOpen (f k)) x
            ⟨hj, hk⟩ (v j k : Γ(X, X.basicOpen (f j) ⊓ X.basicOpen (f k)))) →
      ∀ l : Fin n, ∃ (N : ℕ) (c : ∀ k, Γ(X, X.basicOpen (f k))),
        (∀ j k (x : X) (hj : x ∈ X.basicOpen (f j)) (hk : x ∈ X.basicOpen (f k)),
          (τ j ⟨x, hj⟩ : X.presheaf.stalk x) * G _ x hj (c j) =
            (τ k ⟨x, hk⟩ : X.presheaf.stalk x) * G _ x hk (c k)) ∧
        (∀ k (x : X) (hk : x ∈ X.basicOpen (f k)) (hl : x ∈ X.basicOpen (f l)),
          (τ k ⟨x, hk⟩ : X.presheaf.stalk x) * G _ x hk (c k) =
            (gam x (f l)) ^ N * (τ l ⟨x, hl⟩ : X.presheaf.stalk x)) := by
    intro τ v hv l
    have e1 : ∀ k, ∃ (N : ℕ) (y : Γ(X, X.basicOpen (f k))), ∀ (x : X)
        (hl : x ∈ X.basicOpen (f l)) (hk : x ∈ X.basicOpen (f k)),
        G _ x hk y = (gam x (f l)) ^ N *
          G (X.basicOpen (f l) ⊓ X.basicOpen (f k)) x ⟨hl, hk⟩ (v l k : Γ(X, _)) :=
      fun k => hext _ (hD k) (f l) _
    choose nk y hy using e1
    have hnk : ∀ k, nk k ≤ Finset.univ.sup nk := fun k => Finset.le_sup (Finset.mem_univ k)
    obtain ⟨c0, hc0⟩ : ∃ c0 : ∀ k, Γ(X, X.basicOpen (f k)), ∀ k (x : X)
        (hk : x ∈ X.basicOpen (f k)), G _ x hk (c0 k) =
          (gam x (f l)) ^ (Finset.univ.sup nk - nk k) * G _ x hk (y k) :=
      ⟨fun k => res k (f l) ^ (Finset.univ.sup nk - nk k) * y k, fun k x hk => by
        rw [map_mul, map_pow, hρ]⟩
    have hc0l : ∀ k (x : X) (hk : x ∈ X.basicOpen (f k)) (hl : x ∈ X.basicOpen (f l)),
        (τ k ⟨x, hk⟩ : X.presheaf.stalk x) * G _ x hk (c0 k) =
          (gam x (f l)) ^ (Finset.univ.sup nk) * (τ l ⟨x, hl⟩ : X.presheaf.stalk x) := by
      intro k x hk hl
      have hpw : (gam x (f l)) ^ (Finset.univ.sup nk) =
          (gam x (f l)) ^ (Finset.univ.sup nk - nk k) * (gam x (f l)) ^ (nk k) := by
        rw [← pow_add, Nat.sub_add_cancel (hnk k)]
      rw [hc0, hy k x hl hk, hv l k x hl hk, hpw]
      ring
    have e2 : ∀ j k, ∃ p : ℕ, ∀ (x : X) (hjk : x ∈ X.basicOpen (f j) ⊓ X.basicOpen (f k)),
        (gam x (f l)) ^ p *
          G _ x hjk (rR j k (c0 k) - (v j k : Γ(X, _)) * rL j k (c0 j)) = 0 := by
      intro j k
      apply hkill _ (hDD j k) (f l)
      intro x hjk hl
      rw [map_sub, map_mul, hrR, hrL]
      rw [← Units.mul_right_eq_zero (τ k ⟨x, hjk.2⟩), mul_sub, hc0l k x hjk.2 hl, ← mul_assoc,
        ← hv j k x hjk.1 hjk.2, hc0l j x hjk.1 hl, sub_self]
    choose p hp using e2
    have hpP : ∀ j k, p j k ≤ Finset.univ.sup (fun j => Finset.univ.sup (p j)) := by
      intro j k
      exact le_trans (Finset.le_sup (f := p j) (Finset.mem_univ k))
        (Finset.le_sup (f := fun j => Finset.univ.sup (p j)) (Finset.mem_univ j))
    refine ⟨Finset.univ.sup (fun j => Finset.univ.sup (p j)) + Finset.univ.sup nk,
      fun k => res k (f l) ^ (Finset.univ.sup (fun j => Finset.univ.sup (p j))) * c0 k, ?_, ?_⟩
    · intro j k x hj hk
      have hjk : x ∈ X.basicOpen (f j) ⊓ X.basicOpen (f k) := ⟨hj, hk⟩
      have h0 := hp j k x hjk
      rw [map_sub, map_mul, hrR, hrL] at h0
      have h := hbump x _ _ _ _ (hpP j k) h0
      simp only [map_mul, map_pow, hρ]
      rw [hv j k x hj hk]
      linear_combination (-(τ k ⟨x, hk⟩ : X.presheaf.stalk x)) * h
    · intro k x hk hl
      simp only [map_mul, map_pow, hρ]
      have h := hc0l k x hk hl
      linear_combination (gam x (f l)) ^
        (Finset.univ.sup (fun j => Finset.univ.sup (p j))) * h

  choose u hu using hcoc
  have hu' : ∀ j k (x : X) (hj : x ∈ X.basicOpen (f j)) (hk : x ∈ X.basicOpen (f k)),
      ((t j ⟨x, hj⟩ : (X.presheaf.stalk x)ˣ) : X.presheaf.stalk x) =
        (t k ⟨x, hk⟩ : X.presheaf.stalk x) * G (X.basicOpen (f j) ⊓ X.basicOpen (f k)) x
          ⟨hj, hk⟩ (u j k : Γ(X, X.basicOpen (f j) ⊓ X.basicOpen (f k))) := by
    intro j k x hj hk
    refine (hu j k x hj hk).trans ?_
    congr 1
    exact (hG _ _ _ _).symm
  have hui : ∀ j k (x : X) (hj : x ∈ X.basicOpen (f j)) (hk : x ∈ X.basicOpen (f k)),
      (((t j ⟨x, hj⟩)⁻¹ : (X.presheaf.stalk x)ˣ) : X.presheaf.stalk x) =
        (((t k ⟨x, hk⟩)⁻¹ : (X.presheaf.stalk x)ˣ) : X.presheaf.stalk x) *
          G (X.basicOpen (f j) ⊓ X.basicOpen (f k)) x
          ⟨hj, hk⟩ (((u j k)⁻¹ : (Γ(X, X.basicOpen (f j) ⊓ X.basicOpen (f k)))ˣ) :
            Γ(X, X.basicOpen (f j) ⊓ X.basicOpen (f k))) := by
    intro j k x hj hk
    apply Units.inv_eq_of_mul_eq_one_right
    rw [hu' j k x hj hk, mul_mul_mul_comm, Units.mul_inv, one_mul, ← map_mul, Units.mul_inv,
      map_one]

  have hloc : ∀ l : Fin n, ∃ (E : ℕ) (c d : ∀ k, Γ(X, X.basicOpen (f k))),
      (∀ j k (x : X) (hj : x ∈ X.basicOpen (f j)) (hk : x ∈ X.basicOpen (f k)),
        (t j ⟨x, hj⟩ : X.presheaf.stalk x) * G _ x hj (c j) =
          (t k ⟨x, hk⟩ : X.presheaf.stalk x) * G _ x hk (c k)) ∧
      (∀ j k (x : X) (hj : x ∈ X.basicOpen (f j)) (hk : x ∈ X.basicOpen (f k)),
        (((t j ⟨x, hj⟩)⁻¹ : (X.presheaf.stalk x)ˣ) : X.presheaf.stalk x) * G _ x hj (d j) =
          (((t k ⟨x, hk⟩)⁻¹ : (X.presheaf.stalk x)ˣ) : X.presheaf.stalk x) * G _ x hk (d k)) ∧
      (∀ k (x : X) (hk : x ∈ X.basicOpen (f k)),
        G _ x hk (c k) * G _ x hk (d k) = (gam x (f l)) ^ E) := by
    intro l
    obtain ⟨N1, c1, hA1, hB1⟩ := hsec t u hu' l
    obtain ⟨N2, d, hA2, hB2⟩ := hsec (fun j x => (t j x)⁻¹) (fun j k => (u j k)⁻¹) hui l
    beta_reduce at hA2 hB2
    have e3 : ∀ k, ∃ q : ℕ, ∀ (x : X) (hk : x ∈ X.basicOpen (f k)), (gam x (f l)) ^ q *
        G _ x hk (c1 k * d k - res k (f l) ^ (N1 + N2)) = 0 := by
      intro k
      apply hkill _ (hD k) (f l)
      intro x hk hl
      rw [map_sub, map_mul, map_pow, hρ]
      have h1 := hB1 k x hk hl
      have h2 := hB2 k x hk hl
      have h3 : (t k ⟨x, hk⟩ : X.presheaf.stalk x) *
          (((t k ⟨x, hk⟩)⁻¹ : (X.presheaf.stalk x)ˣ) : X.presheaf.stalk x) = 1 := Units.mul_inv _
      have h4 : (t l ⟨x, hl⟩ : X.presheaf.stalk x) *
          (((t l ⟨x, hl⟩)⁻¹ : (X.presheaf.stalk x)ˣ) : X.presheaf.stalk x) = 1 := Units.mul_inv _
      linear_combination (-(G _ x hk (c1 k) * G _ x hk (d k))) * h3 +
        ((((t k ⟨x, hk⟩)⁻¹ : (X.presheaf.stalk x)ˣ) : X.presheaf.stalk x) * G _ x hk (d k)) * h1 +
        ((gam x (f l)) ^ N1 * (t l ⟨x, hl⟩ : X.presheaf.stalk x)) * h2 +
        (gam x (f l)) ^ (N1 + N2) * h4
    choose q hq using e3
    have hqQ : ∀ k, q k ≤ Finset.univ.sup q := fun k => Finset.le_sup (Finset.mem_univ k)
    refine ⟨Finset.univ.sup q + (N1 + N2), fun k => res k (f l) ^ (Finset.univ.sup q) * c1 k,
      d, ?_, hA2, ?_⟩
    · intro j k x hj hk
      simp only [map_mul, map_pow, hρ]
      linear_combination (gam x (f l)) ^ (Finset.univ.sup q) * hA1 j k x hj hk
    · intro k x hk
      have h0 := hbump x _ _ _ _ (hqQ k) (hq k x hk)
      rw [map_sub, map_mul, map_pow, hρ] at h0
      simp only [map_mul, map_pow, hρ]
      linear_combination h0
  choose E c d hA hB hC using hloc
  have hEM : ∀ l, E l ≤ Finset.univ.sup E := fun l => Finset.le_sup (Finset.mem_univ l)
  obtain ⟨r, hr⟩ : ∃ r : Fin n → Γ(X, ⊤), ∑ l, r l * f l ^ (Finset.univ.sup E) = 1 := by
    have h := Ideal.span_pow_eq_top _ hspan (Finset.univ.sup E)
    rw [← Set.range_comp] at h
    have h1 : (1 : Γ(X, ⊤)) ∈
        Ideal.span (Set.range ((fun x => x ^ (Finset.univ.sup E)) ∘ f)) := by
      rw [h]; trivial
    obtain ⟨r, hr⟩ := Ideal.mem_span_range_iff_exists_fun.mp h1
    exact ⟨r, hr⟩

  have hcov : ∀ x : X, ∃ k, x ∈ X.basicOpen (f k) := by
    intro x
    by_contra hno
    push Not at hno
    have hmem : ∀ k, gam x (f k) ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x) := by
      intro k
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hunit
      apply hno k
      apply (Scheme.mem_basicOpen_top X (f k) x).mpr
      convert hunit using 1
      exact (hG ⊤ x trivial (f k)).symm.trans (hgam x trivial (f k))
    have h1 : (1 : Γ(X, ⊤)) ∈ Ideal.span (Set.range f) := by rw [hspan]; trivial
    obtain ⟨cc, hcc⟩ := Ideal.mem_span_range_iff_exists_fun.mp h1
    have h2 : (1 : X.presheaf.stalk x) ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x) := by
      rw [← map_one (gam x), ← hcc, map_sum]
      exact Ideal.sum_mem _ (fun k _ => by rw [map_mul]; exact Ideal.mul_mem_left _ _ (hmem k))
    exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top ((Ideal.eq_top_iff_one _).mpr h2)
  choose κ hκ using hcov
  obtain ⟨a, ha⟩ : ∃ a : Fin n → ∀ x : X, X.presheaf.stalk x, ∀ l x,
      a l x = gam x (r l * f l ^ (Finset.univ.sup E - E l)) *
        ((t (κ x) ⟨x, hκ x⟩ : X.presheaf.stalk x) * G _ x (hκ x) (c l (κ x))) :=
    ⟨fun l x => gam x (r l * f l ^ (Finset.univ.sup E - E l)) *
        ((t (κ x) ⟨x, hκ x⟩ : X.presheaf.stalk x) * G _ x (hκ x) (c l (κ x))),
      fun _ _ => rfl⟩
  obtain ⟨b, hb⟩ : ∃ b : Fin n → ∀ x : X, X.presheaf.stalk x, ∀ l x,
      b l x = (((t (κ x) ⟨x, hκ x⟩)⁻¹ : (X.presheaf.stalk x)ˣ) : X.presheaf.stalk x) *
        G _ x (hκ x) (d l (κ x)) :=
    ⟨fun l x => (((t (κ x) ⟨x, hκ x⟩)⁻¹ : (X.presheaf.stalk x)ˣ) : X.presheaf.stalk x) *
        G _ x (hκ x) (d l (κ x)), fun _ _ => rfl⟩
  refine ⟨n, a, b, ?_, ?_, ?_⟩
  · intro l j
    refine ⟨res j (r l * f l ^ (Finset.univ.sup E - E l)) * c l j, fun x hx => ?_⟩
    rw [ha, ← hG]
    rw [map_mul (G _ x hx), hρ, hA l (κ x) j x (hκ x) hx]
    ring
  · intro l j
    refine ⟨d l j, fun x hx => ?_⟩
    rw [hb, ← hG, hB l (κ x) j x (hκ x) hx]
  · funext x
    rw [Finset.sum_apply, Pi.one_apply]
    have hterm : ∀ l, (a l * b l) x = gam x (r l * f l ^ (Finset.univ.sup E)) := by
      intro l
      rw [Pi.mul_apply, ha, hb]
      have h1 := hC l (κ x) x (hκ x)
      have h2 : (t (κ x) ⟨x, hκ x⟩ : X.presheaf.stalk x) *
          (((t (κ x) ⟨x, hκ x⟩)⁻¹ : (X.presheaf.stalk x)ˣ) : X.presheaf.stalk x) = 1 :=
        Units.mul_inv _
      have hp : (gam x (f l)) ^ (Finset.univ.sup E) =
          (gam x (f l)) ^ (Finset.univ.sup E - E l) * (gam x (f l)) ^ (E l) := by
        rw [← pow_add, Nat.sub_add_cancel (hEM l)]
      rw [map_mul, map_mul, map_pow, map_pow, hp]
      linear_combination (gam x (r l) * (gam x (f l)) ^ (Finset.univ.sup E - E l) *
          G _ x (hκ x) (c l (κ x)) * G _ x (hκ x) (d l (κ x))) * h2 +
        (gam x (r l) * (gam x (f l)) ^ (Finset.univ.sup E - E l)) * h1
    rw [Finset.sum_congr rfl (fun l _ => hterm l), ← map_sum, hr, map_one]

theorem wc_zar_cokernel_sections_submodule : ∀ (X : Scheme.{u}) [IsAffine X] (G K Q : Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}) (i : G ⟶ K) (π : K ⟶ Q) (w : i ≫ π = 0), (ShortComplex.mk i π w).ShortExact → ∀ (eK : ∀ V : X.Opens, K.obj.obj (Opposite.op V) ≃+ Additive (∀ x : V, (X.presheaf.stalk (x : X))ˣ)), (∀ (V W : X.Opens) (h : W ≤ V) (k : K.obj.obj (Opposite.op V)) (x : W), Additive.toMul (eK W (K.obj.map (homOfLE h).op k)) x = Additive.toMul (eK V k) ⟨x, h x.2⟩) → (∀ (V : X.Opens) (k : K.obj.obj (Opposite.op V)), (∃ g, i.hom.app (Opposite.op V) g = k) ↔ ∃ s : (Γ(X, V))ˣ, ∀ x : V, Additive.toMul (eK V k) x = Units.map (X.presheaf.germ V x x.2).hom.toMonoidHom s) → (∀ V : X.Opens, Function.Injective (i.hom.app (Opposite.op V))) → (∀ (n : ℕ) (f : Fin n → Γ(X, ⊤)), Ideal.span (Set.range f) = ⊤ → ∀ (t : ∀ j : Fin n, ∀ x : X.basicOpen (f j), (X.presheaf.stalk (x : X))ˣ), (∀ j k : Fin n, ∃ u : (Γ(X, X.basicOpen (f j) ⊓ X.basicOpen (f k)))ˣ, ∀ (x : X) (hj : x ∈ X.basicOpen (f j)) (hk : x ∈ X.basicOpen (f k)), ((t j ⟨x, hj⟩ : (X.presheaf.stalk x)ˣ) : X.presheaf.stalk x) = (t k ⟨x, hk⟩ : X.presheaf.stalk x) * (X.presheaf.germ (X.basicOpen (f j) ⊓ X.basicOpen (f k)) x ⟨hj, hk⟩).hom (u : Γ(X, X.basicOpen (f j) ⊓ X.basicOpen (f k)))) → ∃ (m : ℕ) (a b : Fin m → ∀ x : X, X.presheaf.stalk x), (∀ l j, ∃ c : Γ(X, X.basicOpen (f j)), ∀ (x : X) (hx : x ∈ X.basicOpen (f j)), a l x = (t j ⟨x, hx⟩ : X.presheaf.stalk x) * (X.presheaf.germ (X.basicOpen (f j)) x hx).hom c) ∧ (∀ l j, ∃ c : Γ(X, X.basicOpen (f j)), ∀ (x : X) (hx : x ∈ X.basicOpen (f j)), b l x = (((t j ⟨x, hx⟩)⁻¹ : (X.presheaf.stalk x)ˣ) : X.presheaf.stalk x) * (X.presheaf.germ (X.basicOpen (f j)) x hx).hom c) ∧ ∑ l, a l * b l = 1) → Nonempty (Q.obj.obj (Opposite.op ⊤) ⧸ (π.hom.app (Opposite.op ⊤)).hom.range ≃+ Additive ((Submodule Γ(X, ⊤) (wcGermRing X))ˣ ⧸ (Units.map ((Submodule.spanSingleton Γ(X, ⊤) : wcGermRing X →*₀ Submodule Γ(X, ⊤) (wcGermRing X)) : wcGermRing X →* Submodule Γ(X, ⊤) (wcGermRing X))).range)) :=
by
  intro X _ G K Q i π w hSE eK Hres Himg Hinj H5
  classical

  have hQmap : ∀ {U V : X.Opens} (f g : U ⟶ V) (q : Q.obj.obj (Opposite.op V)),
      Q.obj.map f.op q = Q.obj.map g.op q := by
    intro U V f g q; rw [Subsingleton.elim f g]
  have hQres : ∀ (U V W : X.Opens) (h₁ : V ≤ U) (h₂ : W ≤ V) (q : Q.obj.obj (Opposite.op U)),
      Q.obj.map (homOfLE h₂).op (Q.obj.map (homOfLE h₁).op q) =
        Q.obj.map (homOfLE (h₂.trans h₁)).op q := by
    intro U V W h₁ h₂ q
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]; rfl
  have hQid : ∀ q : Q.obj.obj (Opposite.op ⊤),
      Q.obj.map (homOfLE (le_top : (⊤ : X.Opens) ≤ ⊤)).op q = q := by
    intro q
    have : homOfLE (le_top : (⊤ : X.Opens) ≤ ⊤) = 𝟙 _ := Subsingleton.elim _ _
    rw [this, op_id, CategoryTheory.Functor.map_id]; rfl
  have hnat : ∀ (V W : X.Opens) (h : W ≤ V) (t : K.obj.obj (Opposite.op V)),
      π.hom.app (Opposite.op W) (K.obj.map (homOfLE h).op t) =
        Q.obj.map (homOfLE h).op (π.hom.app (Opposite.op V) t) := by
    intro V W h t
    rw [← ConcreteCategory.comp_apply, ← ConcreteCategory.comp_apply, π.hom.naturality]
  have hTadd : ∀ (W : X.Opens) (t t' : K.obj.obj (Opposite.op W)) (y : W),
      ((Additive.toMul (eK W (t + t')) y : (X.presheaf.stalk (y : X))ˣ) : X.presheaf.stalk (y : X)) =
        ((Additive.toMul (eK W t) y : (X.presheaf.stalk (y : X))ˣ) : X.presheaf.stalk (y : X)) *
        ((Additive.toMul (eK W t') y : (X.presheaf.stalk (y : X))ˣ) : X.presheaf.stalk (y : X)) := by
    intro W t t' y; rw [map_add, toMul_add]; rfl
  have hTneg : ∀ (W : X.Opens) (t : K.obj.obj (Opposite.op W)) (y : W),
      ((Additive.toMul (eK W (-t)) y : (X.presheaf.stalk (y : X))ˣ) : X.presheaf.stalk (y : X)) =
        (((Additive.toMul (eK W t) y)⁻¹ : (X.presheaf.stalk (y : X))ˣ) : X.presheaf.stalk (y : X)) := by
    intro W t y; rw [map_neg, toMul_neg]; rfl
  have hgr : ∀ (V : X.Opens) (r : Γ(X, ⊤)) (y : X) (hy : y ∈ V),
      (X.presheaf.germ V y hy).hom ((X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom r) =
        (X.presheaf.germ ⊤ y trivial).hom r :=
    fun V r y hy => TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE (le_top : V ≤ ⊤)) y hy r

  have hex : ∀ (V : X.Opens) (b : K.obj.obj (Opposite.op V)),
      π.hom.app (Opposite.op V) b = 0 → ∃ g, i.hom.app (Opposite.op V) g = b := by
    intro V b hb
    haveI := hSE.mono_f
    have hE := hSE.exact.map_of_mono_of_preservesKernel
      (sheafToPresheaf _ AddCommGrpCat.{u} ⋙ (evaluation _ AddCommGrpCat.{u}).obj (Opposite.op V))
      hSE.mono_f inferInstance
    obtain ⟨a, ha⟩ := (ShortComplex.ab_exact_iff _).mp hE b hb
    exact ⟨a, ha⟩
  have hcomp0 : ∀ (V : X.Opens) (g : G.obj.obj (Opposite.op V)),
      π.hom.app (Opposite.op V) (i.hom.app (Opposite.op V) g) = 0 := by
    intro V g
    have h1 : i.hom ≫ π.hom = 0 := congrArg (fun f : G ⟶ Q => f.hom) w
    rw [← ConcreteCategory.comp_apply, ← NatTrans.comp_app, h1]
    rfl

  have HL1 : ∀ (V : X.Opens) (t t' : K.obj.obj (Opposite.op V)),
      π.hom.app (Opposite.op V) t = π.hom.app (Opposite.op V) t' ↔
        ∃ s : (Γ(X, V))ˣ, ∀ x : V, Additive.toMul (eK V t) x =
          Additive.toMul (eK V t') x * Units.map (X.presheaf.germ V x x.2).hom.toMonoidHom s := by
    intro V t t'
    have hdiff : ∀ x : V, Additive.toMul (eK V (t - t')) x =
        Additive.toMul (eK V t) x / Additive.toMul (eK V t') x := by
      intro x; rw [map_sub, toMul_sub]; rfl
    constructor
    · intro h
      have h0 : π.hom.app (Opposite.op V) (t - t') = 0 := by rw [map_sub, h, sub_self]
      obtain ⟨s, hs⟩ := (Himg V (t - t')).mp (hex V _ h0)
      refine ⟨s, fun x => ?_⟩
      rw [← hs x, hdiff x]
      simp
    · rintro ⟨s, hs⟩
      obtain ⟨g, hg⟩ := (Himg V (t - t')).mpr ⟨s, fun x => by rw [hdiff x, hs x]; simp⟩
      have h0 := hcomp0 V g
      rw [hg, map_sub, sub_eq_zero] at h0
      exact h0

  haveI : Epi π := hSE.epi_g
  have HLL : ∀ (V : X.Opens) (q : Q.obj.obj (Opposite.op V)) (x : X), x ∈ V →
      ∃ (W : X.Opens) (h : W ≤ V), x ∈ W ∧ ∃ t : K.obj.obj (Opposite.op W),
        π.hom.app (Opposite.op W) t = Q.obj.map (homOfLE h).op q := by
    intro V q x hx
    have hS : Presheaf.imageSieve π.hom q ∈ Opens.grothendieckTopology X V := by
      have : Sheaf.IsLocallySurjective π :=
        (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u} π).mpr inferInstance
      exact Presheaf.imageSieve_mem (Opens.grothendieckTopology X) π.hom q
    rw [Opens.mem_grothendieckTopology] at hS
    obtain ⟨W, f, ⟨t, ht⟩, hxW⟩ := hS x hx
    exact ⟨W, leOfHom f, hxW, t, by rw [ht]; exact hQmap _ _ q⟩
  have LL : ∀ (q : Q.obj.obj (Opposite.op ⊤)) (x : X), ∃ (W : X.Opens), x ∈ W ∧
      ∃ τ : K.obj.obj (Opposite.op W),
        π.hom.app (Opposite.op W) τ = Q.obj.map (homOfLE (le_top : W ≤ ⊤)).op q := by
    intro q x
    obtain ⟨W, h, hx, τ, hτ⟩ := HLL ⊤ q x trivial
    exact ⟨W, hx, τ, hτ⟩
  have RL : ∀ (q : Q.obj.obj (Opposite.op ⊤)) (W W' : X.Opens) (h : W' ≤ W)
      (τ : K.obj.obj (Opposite.op W)),
      π.hom.app (Opposite.op W) τ = Q.obj.map (homOfLE (le_top : W ≤ ⊤)).op q →
      ∃ σ : K.obj.obj (Opposite.op W'),
        π.hom.app (Opposite.op W') σ = Q.obj.map (homOfLE (le_top : W' ≤ ⊤)).op q ∧
        ∀ y : W', Additive.toMul (eK W' σ) y = Additive.toMul (eK W τ) ⟨y, h y.2⟩ := by
    intro q W W' h τ hτ
    exact ⟨K.obj.map (homOfLE h).op τ, by rw [hnat, hτ, hQres], fun y => Hres W W' h τ y⟩

  have HG : ∀ (a : wcGermRing X), (∀ x : X, ∃ (W : X.Opens), x ∈ W ∧ ∃ c : Γ(X, W),
      ∀ (y : X) (hy : y ∈ W), a y = (X.presheaf.germ W y hy).hom c) →
      ∃ r : Γ(X, ⊤), ∀ y : X, a y = (X.presheaf.germ ⊤ y trivial).hom r := by
    intro a ha
    choose W hxW c hc using ha
    obtain ⟨r, hr, -⟩ := TopCat.Sheaf.existsUnique_gluing' X.sheaf W ⊤
      (fun x => homOfLE le_top) (fun x _ => TopologicalSpace.Opens.mem_iSup.mpr ⟨x, hxW x⟩) c (by
        intro x z
        apply TopCat.Presheaf.section_ext X.sheaf
        intro y hy
        have e1 := TopCat.Presheaf.germ_res_apply X.presheaf
          (TopologicalSpace.Opens.infLELeft (W x) (W z)) y hy (c x)
        have e2 := TopCat.Presheaf.germ_res_apply X.presheaf
          (TopologicalSpace.Opens.infLERight (W x) (W z)) y hy (c z)
        exact e1.trans (((hc x y hy.1).symm.trans (hc z y hy.2)).trans e2.symm))
    refine ⟨r, fun y => ?_⟩
    have e := TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE (le_top : W y ≤ ⊤)) y (hxW y) r
    rw [hc y y (hxW y)]
    exact (congrArg (X.presheaf.germ (W y) y (hxW y)).hom (hr y)).symm.trans e

  have MEM : ∀ (q : Q.obj.obj (Opposite.op ⊤)) (a : wcGermRing X),
      (∀ x : X, ∃ (W₀ : X.Opens) (τ : K.obj.obj (Opposite.op W₀)),
        π.hom.app (Opposite.op W₀) τ = Q.obj.map (homOfLE (le_top : W₀ ≤ ⊤)).op q ∧
        ∃ (W₁ : X.Opens) (h₁ : W₁ ≤ W₀), x ∈ W₁ ∧ ∃ c : Γ(X, W₁), ∀ (y : X) (hy : y ∈ W₁),
          a y = ((Additive.toMul (eK W₀ τ) ⟨y, h₁ hy⟩ : (X.presheaf.stalk y)ˣ) :
            X.presheaf.stalk y) * (X.presheaf.germ W₁ y hy).hom c) →
      a ∈ wcCokSub X K Q π eK q := by
    intro q a ha W t ht x hx
    obtain ⟨W₀, τ, hτ, W₁, h₁, hx₁, c, hc⟩ := ha x
    have hV₀ : W ⊓ W₁ ≤ W₀ := inf_le_right.trans h₁
    have l1 : π.hom.app (Opposite.op (W ⊓ W₁)) (K.obj.map (homOfLE hV₀).op τ) =
        π.hom.app (Opposite.op (W ⊓ W₁)) (K.obj.map (homOfLE (inf_le_left : W ⊓ W₁ ≤ W)).op t) := by
      rw [hnat, hnat, hτ, ht, hQres, hQres]
    obtain ⟨s, hs⟩ := (HL1 _ _ _).mp l1
    refine ⟨W ⊓ W₁, inf_le_left, ⟨hx, hx₁⟩,
      (s : Γ(X, W ⊓ W₁)) * (X.presheaf.map (homOfLE (inf_le_right : W ⊓ W₁ ≤ W₁)).op).hom c,
      fun y hy => ?_⟩
    have key := congrArg Units.val (hs ⟨y, hy⟩)
    rw [Hres, Hres] at key
    have e1 := TopCat.Presheaf.germ_res_apply X.presheaf
      (homOfLE (inf_le_right : W ⊓ W₁ ≤ W₁)) y hy c
    change a y = _
    rw [hc y hy.2, map_mul]
    erw [e1]
    rw [Units.val_mul, Units.coe_map] at key
    erw [key]
    simp only [MonoidHom.coe_coe, RingHom.toMonoidHom_eq_coe]
    ring

  have S4 : ∀ q₁ q₂ : Q.obj.obj (Opposite.op ⊤),
      wcCokSub X K Q π eK q₁ * wcCokSub X K Q π eK q₂ ≤ wcCokSub X K Q π eK (q₁ + q₂) := by
    intro q₁ q₂
    rw [Submodule.mul_le]
    intro a ha b hb
    apply MEM
    intro x
    obtain ⟨W₁, hx₁, τ₁, hτ₁⟩ := LL q₁ x
    obtain ⟨W₂, hx₂, τ₂, hτ₂⟩ := LL q₂ x
    obtain ⟨σ₁, hσ₁, -⟩ := RL q₁ W₁ (W₁ ⊓ W₂) inf_le_left τ₁ hτ₁
    obtain ⟨σ₂, hσ₂, -⟩ := RL q₂ W₂ (W₁ ⊓ W₂) inf_le_right τ₂ hτ₂
    obtain ⟨W₃, h₃, hx₃, c₁, hc₁⟩ := ha _ σ₁ hσ₁ x ⟨hx₁, hx₂⟩
    obtain ⟨W₄, h₄, hx₄, c₂, hc₂⟩ := hb _ σ₂ hσ₂ x ⟨hx₁, hx₂⟩
    refine ⟨W₁ ⊓ W₂, σ₁ + σ₂, by rw [map_add, hσ₁, hσ₂, map_add], W₃ ⊓ W₄,
      inf_le_left.trans h₃, ⟨hx₃, hx₄⟩,
      (X.presheaf.map (homOfLE (inf_le_left : W₃ ⊓ W₄ ≤ W₃)).op).hom c₁ *
        (X.presheaf.map (homOfLE (inf_le_right : W₃ ⊓ W₄ ≤ W₄)).op).hom c₂, fun y hy => ?_⟩
    have e1 : (X.presheaf.germ (W₃ ⊓ W₄) y hy).hom
        ((X.presheaf.map (homOfLE (inf_le_left : W₃ ⊓ W₄ ≤ W₃)).op).hom c₁) =
        (X.presheaf.germ W₃ y hy.1).hom c₁ :=
      TopCat.Presheaf.germ_res_apply X.presheaf _ y hy c₁
    have e2 : (X.presheaf.germ (W₃ ⊓ W₄) y hy).hom
        ((X.presheaf.map (homOfLE (inf_le_right : W₃ ⊓ W₄ ≤ W₄)).op).hom c₂) =
        (X.presheaf.germ W₄ y hy.2).hom c₂ :=
      TopCat.Presheaf.germ_res_apply X.presheaf _ y hy c₂
    change a y * b y = _
    rw [hc₁ y hy.1, hc₂ y hy.2, map_mul, e1, e2, hTadd]
    ring

  have S9 : wcCokSub X K Q π eK 0 ≤ 1 := by
    intro a ha
    have hlift : π.hom.app (Opposite.op ⊤) 0 =
        Q.obj.map (homOfLE (le_top : (⊤ : X.Opens) ≤ ⊤)).op 0 := by rw [map_zero, map_zero]
    obtain ⟨r, hr⟩ := HG a (fun x => by
      obtain ⟨W', h, hx, c, hc⟩ := ha ⊤ 0 hlift x trivial
      refine ⟨W', hx, c, fun y hy => (hc y hy).trans ?_⟩
      rw [map_zero, toMul_zero, Pi.one_apply, Units.val_one, one_mul])
    exact Submodule.mem_one.mpr ⟨r, funext fun y => (hr y).symm⟩

  have S6 : ∀ (t : K.obj.obj (Opposite.op ⊤)) (v : (wcGermRing X)ˣ),
      (∀ y : X, (v : wcGermRing X) y =
        ((Additive.toMul (eK ⊤ t) ⟨y, trivial⟩ : (X.presheaf.stalk y)ˣ) : X.presheaf.stalk y)) →
      wcCokSub X K Q π eK (π.hom.app (Opposite.op ⊤) t) =
        Submodule.spanSingleton Γ(X, ⊤) (v : wcGermRing X) := by
    intro t v hv
    rw [Submodule.spanSingleton_apply]
    apply le_antisymm
    · intro a ha
      obtain ⟨r, hr⟩ := HG (a * ↑v⁻¹) (fun x => by
        obtain ⟨W', h, hx, c, hc⟩ := ha ⊤ t (hQid _).symm x trivial
        refine ⟨W', hx, c, fun y hy => ?_⟩
        have h1 := hc y hy
        have h3 : ((v⁻¹ : (wcGermRing X)ˣ) : wcGermRing X) y * (v : wcGermRing X) y = 1 :=
          congrArg (fun z : wcGermRing X => z y) v.inv_mul
        rw [hv y] at h3
        show a y * ((v⁻¹ : (wcGermRing X)ˣ) : wcGermRing X) y = _
        linear_combination (((v⁻¹ : (wcGermRing X)ˣ) : wcGermRing X) y) * h1 +
          (X.presheaf.germ W' y hy).hom c * h3)
      refine Submodule.mem_span_singleton.mpr ⟨r, ?_⟩
      have e : a * ↑v⁻¹ = algebraMap Γ(X, ⊤) (wcGermRing X) r := funext fun y => hr y
      rw [Algebra.smul_def, ← e, mul_assoc, Units.inv_mul, mul_one]
    · rw [Submodule.span_singleton_le_iff_mem]
      apply MEM
      intro x
      refine ⟨⊤, t, (hQid _).symm, ⊤, le_rfl, trivial, 1, fun y hy => ?_⟩
      rw [map_one, mul_one]
      exact hv y

  have hsecunit : ∀ (V : X.Opens) (c : Γ(X, V)),
      (∀ (y : X) (hy : y ∈ V), IsUnit ((X.presheaf.germ V y hy).hom c)) → IsUnit c :=
    fun V c h => RingedSpace.isUnit_of_isUnit_germ _ V c h
  have hresunit : ∀ (V : X.Opens) (s : Γ(X, ⊤)), V ≤ X.basicOpen s →
      IsUnit ((X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom s) := by
    intro V s hV
    apply hsecunit
    intro y hy
    rw [hgr V s y hy]
    exact (Scheme.mem_basicOpen_top X s y).mp (hV hy)

  have S7 : ∀ (q : Q.obj.obj (Opposite.op ⊤)) (v : (wcGermRing X)ˣ),
      (v : wcGermRing X) ∈ wcCokSub X K Q π eK q →
      ((v⁻¹ : (wcGermRing X)ˣ) : wcGermRing X) ∈ wcCokSub X K Q π eK (-q) →
      ∀ t : K.obj.obj (Opposite.op ⊤), (∀ y : X, (v : wcGermRing X) y =
        ((Additive.toMul (eK ⊤ t) ⟨y, trivial⟩ : (X.presheaf.stalk y)ˣ) : X.presheaf.stalk y)) →
      π.hom.app (Opposite.op ⊤) t = q := by
    intro q v hv1 hv2 t ht
    have loc : ∀ x : X, ∃ W' : X.Opens, x ∈ W' ∧
        Q.obj.map (homOfLE (le_top : W' ≤ ⊤)).op (π.hom.app (Opposite.op ⊤) t) =
          Q.obj.map (homOfLE (le_top : W' ≤ ⊤)).op q := by
      intro x
      obtain ⟨W, hx, τ, hτ⟩ := LL q x
      obtain ⟨W₁, h₁, hx₁, c₁, hc₁⟩ := hv1 W τ hτ x hx
      obtain ⟨σ, hσ, hσT⟩ := RL q W W₁ h₁ τ hτ
      have hnσ : π.hom.app (Opposite.op W₁) (-σ) =
          Q.obj.map (homOfLE (le_top : W₁ ≤ ⊤)).op (-q) := by
        rw [map_neg, hσ, map_neg]
      obtain ⟨W₂, h₂, hx₂, c₂, hc₂⟩ := hv2 W₁ (-σ) hnσ x hx₁
      have hg1 : ∀ (y : X) (hy : y ∈ W₂), (X.presheaf.germ W₂ y hy).hom
          ((X.presheaf.map (homOfLE h₂).op).hom c₁) = (X.presheaf.germ W₁ y (h₂ hy)).hom c₁ :=
        fun y hy => TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE h₂) y hy c₁
      have hunit : (X.presheaf.map (homOfLE h₂).op).hom c₁ * c₂ = 1 := by
        apply TopCat.Presheaf.section_ext X.sheaf
        intro y hy
        have h1 := hc₁ y (h₂ hy)
        have h2 := hc₂ y hy
        rw [hTneg, hσT] at h2
        have h3 : (v : wcGermRing X) y * ((v⁻¹ : (wcGermRing X)ˣ) : wcGermRing X) y = 1 :=
          congrArg (fun z : wcGermRing X => z y) v.mul_inv
        have h4 := Units.mul_inv (Additive.toMul (eK W τ) ⟨y, h₁ (h₂ hy)⟩)
        have key : (X.presheaf.germ W₂ y hy).hom ((X.presheaf.map (homOfLE h₂).op).hom c₁ * c₂) =
            (X.presheaf.germ W₂ y hy).hom 1 := by
          rw [map_mul, map_one, hg1 y hy]
          linear_combination h3 - ((v⁻¹ : (wcGermRing X)ˣ) : wcGermRing X) y * h1 -
            ((Additive.toMul (eK W τ) ⟨y, h₁ (h₂ hy)⟩ : (X.presheaf.stalk y)ˣ) : X.presheaf.stalk y) *
              (X.presheaf.germ W₁ y (h₂ hy)).hom c₁ * h2 -
            (X.presheaf.germ W₁ y (h₂ hy)).hom c₁ * (X.presheaf.germ W₂ y hy).hom c₂ * h4
        exact key
      have hu : IsUnit ((X.presheaf.map (homOfLE h₂).op).hom c₁) :=
        ⟨⟨_, c₂, hunit, by rw [mul_comm]; exact hunit⟩, rfl⟩
      have hrel : π.hom.app (Opposite.op W₂) (K.obj.map (homOfLE (le_top : W₂ ≤ ⊤)).op t) =
          π.hom.app (Opposite.op W₂) (K.obj.map (homOfLE h₂).op σ) := by
        apply (HL1 _ _ _).mpr
        refine ⟨hu.unit, fun y => Units.ext ?_⟩
        rw [Units.val_mul, Units.coe_map, Hres, Hres, hσT]
        simp only [MonoidHom.coe_coe, RingHom.toMonoidHom_eq_coe, IsUnit.unit_spec]
        rw [hg1 y y.2, ← ht y, hc₁ y (h₂ y.2)]
      refine ⟨W₂, hx₂, ?_⟩
      rw [← hnat, hrel, hnat, hσ, hQres]
    choose W' hxW' hW' using loc
    exact TopCat.Sheaf.eq_of_locally_eq' Q W' ⊤ (fun x => homOfLE le_top)
      (fun x _ => TopologicalSpace.Opens.mem_iSup.mpr ⟨x, hxW' x⟩) _ _ hW'

  have S5 : ∀ q : Q.obj.obj (Opposite.op ⊤),
      (1 : Submodule Γ(X, ⊤) (wcGermRing X)) ≤ wcCokSub X K Q π eK q * wcCokSub X K Q π eK (-q) := by
    intro q
    have hb : ∀ x : X, ∃ (f : Γ(X, ⊤)) (τ : K.obj.obj (Opposite.op (X.basicOpen f))),
        x ∈ X.basicOpen f ∧ π.hom.app (Opposite.op (X.basicOpen f)) τ =
          Q.obj.map (homOfLE (le_top : X.basicOpen f ≤ ⊤)).op q := by
      intro x
      obtain ⟨W, hx, τ, hτ⟩ := LL q x
      obtain ⟨f, hfW, hxf⟩ := (isAffineOpen_top X).exists_basicOpen_le (V := W) ⟨x, hx⟩ trivial
      obtain ⟨σ, hσ, -⟩ := RL q W _ hfW τ hτ
      exact ⟨f, σ, hxf, hσ⟩
    choose fx τx hxfx hτx using hb
    have hspan : Ideal.span (Set.range fx) = ⊤ := by
      rw [← (isAffineOpen_top X).iSup_basicOpen_eq_self_iff]
      apply eq_top_iff.mpr
      intro x _
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨fx x, x, rfl⟩, hxfx x⟩
    obtain ⟨s', hs'sub, hs'span⟩ := (Ideal.span_eq_top_iff_finite _).mp hspan
    have hpre : ∀ a : s', ∃ x : X, fx x = a := fun a => hs'sub a.2
    choose g hg using hpre
    have hspan' : Ideal.span (Set.range (fun j : Fin s'.card => fx (g (s'.equivFin.symm j)))) = ⊤ := by
      rw [eq_top_iff, ← hs'span]
      apply Ideal.span_mono
      intro a ha
      refine ⟨s'.equivFin ⟨a, ha⟩, ?_⟩
      simp only [Equiv.symm_apply_apply]
      exact hg ⟨a, ha⟩
    have hcov : ∀ x : X, ∃ j : Fin s'.card, x ∈ X.basicOpen (fx (g (s'.equivFin.symm j))) := by
      intro x
      have h := ((isAffineOpen_top X).iSup_basicOpen_eq_self_iff
        (s := Set.range (fun j : Fin s'.card => fx (g (s'.equivFin.symm j))))).mpr hspan'
      have hx : x ∈ (⨆ f : Set.range (fun j : Fin s'.card => fx (g (s'.equivFin.symm j))),
          X.basicOpen (f : Γ(X, ⊤))) := by rw [h]; trivial
      obtain ⟨⟨_, j, rfl⟩, hj⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
      exact ⟨j, hj⟩
    obtain ⟨m, a, b, ha, hb', hsum⟩ := H5 s'.card (fun j => fx (g (s'.equivFin.symm j))) hspan'
      (fun j y => Additive.toMul (eK _ (τx (g (s'.equivFin.symm j)))) y) (by
        intro j k
        have l : π.hom.app (Opposite.op (X.basicOpen (fx (g (s'.equivFin.symm j))) ⊓
              X.basicOpen (fx (g (s'.equivFin.symm k)))))
            (K.obj.map (homOfLE inf_le_left).op (τx (g (s'.equivFin.symm j)))) =
            π.hom.app (Opposite.op (X.basicOpen (fx (g (s'.equivFin.symm j))) ⊓
              X.basicOpen (fx (g (s'.equivFin.symm k)))))
            (K.obj.map (homOfLE inf_le_right).op (τx (g (s'.equivFin.symm k)))) := by
          rw [hnat, hnat, hτx, hτx, hQres, hQres]
        obtain ⟨u, hu⟩ := (HL1 _ _ _).mp l
        refine ⟨u, fun x hj hk => ?_⟩
        have h := congrArg Units.val (hu ⟨x, hj, hk⟩)
        rw [Hres, Hres, Units.val_mul, Units.coe_map] at h
        exact h)
    have hA : ∀ l, (a l : wcGermRing X) ∈ wcCokSub X K Q π eK q := by
      intro l
      apply MEM
      intro x
      obtain ⟨j, hj⟩ := hcov x
      obtain ⟨c, hc⟩ := ha l j
      exact ⟨_, τx (g (s'.equivFin.symm j)), hτx _, _, le_rfl, hj, c, fun y hy => hc y hy⟩
    have hB : ∀ l, (b l : wcGermRing X) ∈ wcCokSub X K Q π eK (-q) := by
      intro l
      apply MEM
      intro x
      obtain ⟨j, hj⟩ := hcov x
      obtain ⟨c, hc⟩ := hb' l j
      refine ⟨_, -τx (g (s'.equivFin.symm j)), by rw [map_neg, hτx, map_neg], _, le_rfl, hj, c,
        fun y hy => ?_⟩
      rw [hTneg]
      exact hc y hy
    let A : Fin m → wcGermRing X := a
    let B : Fin m → wcGermRing X := b
    have hmem : (∑ l, A l * B l) ∈
        wcCokSub X K Q π eK q * wcCokSub X K Q π eK (-q) :=
      Submodule.sum_mem _ (fun l _ => Submodule.mul_mem_mul (hA l) (hB l))
    have h1 : (∑ l, A l * B l) = 1 := hsum
    rw [Submodule.one_le]
    exact h1 ▸ hmem

  have S8 : ∀ (M N : Submodule Γ(X, ⊤) (wcGermRing X)), M * N = 1 →
      ∃ q : Q.obj.obj (Opposite.op ⊤), M ≤ wcCokSub X K Q π eK q ∧ N ≤ wcCokSub X K Q π eK (-q) := by
    intro M N hMN
    have hprod : ∀ m ∈ M, ∀ p ∈ N, ∃ s : Γ(X, ⊤), ∀ y : X,
        (m : wcGermRing X) y * (p : wcGermRing X) y = (X.presheaf.germ ⊤ y trivial).hom s := by
      intro m hm p hp
      have h : m * p ∈ (1 : Submodule Γ(X, ⊤) (wcGermRing X)) := hMN ▸ Submodule.mul_mem_mul hm hp
      obtain ⟨s, hs⟩ := Submodule.mem_one.mp h
      exact ⟨s, fun y => (congrArg (fun z : wcGermRing X => z y) hs).symm⟩
    have hs : ∀ i : {mp : wcGermRing X × wcGermRing X // mp.1 ∈ M ∧ mp.2 ∈ N}, ∃ s : Γ(X, ⊤),
        ∀ y : X, i.1.1 y * i.1.2 y = (X.presheaf.germ ⊤ y trivial).hom s :=
      fun i => hprod _ i.2.1 _ i.2.2
    choose sι hsι using hs
    have hcov : ∀ y : X, ∃ i, y ∈ X.basicOpen (sι i) := by
      intro y
      by_contra hcon
      push_neg at hcon
      have hall : ∀ z ∈ M * N, (z : wcGermRing X) y ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk y) := by
        intro z hz
        refine Submodule.mul_induction_on hz ?_ ?_
        · intro m hm p hp
          have hi := hsι ⟨(m, p), hm, hp⟩ y
          change m y * p y ∈ _
          rw [hi, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, ← Scheme.mem_basicOpen_top]
          exact hcon _
        · intro z1 z2 h1 h2
          exact Ideal.add_mem _ h1 h2
      have h1 : (1 : wcGermRing X) ∈ M * N := by rw [hMN]; exact Submodule.one_le.mp le_rfl
      exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp (hall 1 h1))) isUnit_one
    have hmU : ∀ i : {mp : wcGermRing X × wcGermRing X // mp.1 ∈ M ∧ mp.2 ∈ N}, ∀ (y : X),
        y ∈ X.basicOpen (sι i) → IsUnit (i.1.1 y) := by
      intro i y hy
      have h := (Scheme.mem_basicOpen_top X _ y).mp hy
      rw [← hsι i y] at h
      exact isUnit_of_mul_isUnit_left h
    have hpU : ∀ i : {mp : wcGermRing X × wcGermRing X // mp.1 ∈ M ∧ mp.2 ∈ N}, ∀ (y : X),
        y ∈ X.basicOpen (sι i) → IsUnit (i.1.2 y) := by
      intro i y hy
      have h := (Scheme.mem_basicOpen_top X _ y).mp hy
      rw [← hsι i y] at h
      exact isUnit_of_mul_isUnit_right h
    obtain ⟨τι, hTτ⟩ : ∃ τι : ∀ i : {mp : wcGermRing X × wcGermRing X // mp.1 ∈ M ∧ mp.2 ∈ N},
        K.obj.obj (Opposite.op (X.basicOpen (sι i))),
        ∀ i (y : X) (hy : y ∈ X.basicOpen (sι i)),
          ((Additive.toMul (eK _ (τι i)) ⟨y, hy⟩ : (X.presheaf.stalk y)ˣ) : X.presheaf.stalk y) =
            i.1.1 y :=
      ⟨fun i => (eK (X.basicOpen (sι i))).symm (Additive.ofMul (fun y => (hmU i y.1 y.2).unit)),
        fun i y hy => by
          rw [AddEquiv.apply_symm_apply, toMul_ofMul]
          exact IsUnit.unit_spec _⟩
    have hcompat : ∀ i j, π.hom.app (Opposite.op (X.basicOpen (sι i) ⊓ X.basicOpen (sι j)))
        (K.obj.map (homOfLE inf_le_left).op (τι i)) =
        π.hom.app (Opposite.op (X.basicOpen (sι i) ⊓ X.basicOpen (sι j)))
        (K.obj.map (homOfLE inf_le_right).op (τι j)) := by
      intro i j
      obtain ⟨r, hr⟩ := hprod _ i.2.1 _ j.2.2
      have hu := hresunit (X.basicOpen (sι i) ⊓ X.basicOpen (sι j)) (sι j) inf_le_right
      have hρ : IsUnit ((X.presheaf.map (homOfLE (le_top :
          X.basicOpen (sι i) ⊓ X.basicOpen (sι j) ≤ ⊤)).op).hom r * ↑hu.unit⁻¹) := by
        apply hsecunit
        intro y hy
        rw [map_mul]
        refine IsUnit.mul ?_ ?_
        · rw [hgr, ← hr y]
          exact (hmU i y hy.1).mul (hpU j y hy.2)
        · exact (Units.isUnit _).map _
      apply (HL1 _ _ _).mpr
      refine ⟨hρ.unit, fun y => Units.ext ?_⟩
      rw [Units.val_mul, Units.coe_map, Hres, Hres, hTτ, hTτ]
      simp only [MonoidHom.coe_coe, RingHom.toMonoidHom_eq_coe, IsUnit.unit_spec, map_mul]
      rw [hgr]
      have hinv := congrArg (X.presheaf.germ _ (y : X) y.2).hom hu.val_inv_mul
      rw [map_mul, map_one, hgr] at hinv
      have hj := hsι j y
      have hr' := hr y
      linear_combination (-(i.1.1 (y : X))) * hinv -
        i.1.1 (y : X) * (X.presheaf.germ _ (y : X) y.2).hom (↑hu.unit⁻¹) * hj +
        j.1.1 (y : X) * (X.presheaf.germ _ (y : X) y.2).hom (↑hu.unit⁻¹) * hr'
    obtain ⟨q, hq, -⟩ := TopCat.Sheaf.existsUnique_gluing' Q (fun i => X.basicOpen (sι i)) ⊤
      (fun i => homOfLE le_top) (fun y _ => TopologicalSpace.Opens.mem_iSup.mpr (hcov y))
      (fun i => π.hom.app (Opposite.op (X.basicOpen (sι i))) (τι i)) (by
        intro i j
        have h := hcompat i j
        rw [hnat, hnat] at h
        exact h)
    refine ⟨q, ?_, ?_⟩
    · intro a ha
      apply MEM
      intro x
      obtain ⟨i, hi⟩ := hcov x
      obtain ⟨r, hr⟩ := hprod a ha _ i.2.2
      have hu := hresunit (X.basicOpen (sι i)) (sι i) le_rfl
      refine ⟨_, τι i, (hq i).symm, _, le_rfl, hi,
        (X.presheaf.map (homOfLE (le_top : X.basicOpen (sι i) ≤ ⊤)).op).hom r * ↑hu.unit⁻¹,
        fun y hy => ?_⟩
      rw [hTτ, map_mul, hgr]
      have hinv := congrArg (X.presheaf.germ _ y hy).hom hu.val_inv_mul
      rw [map_mul, map_one, hgr] at hinv
      have hj := hsι i y
      have hr' := hr y
      linear_combination (-(a y)) * hinv -
        a y * (X.presheaf.germ _ y hy).hom (↑hu.unit⁻¹) * hj +
        i.1.1 y * (X.presheaf.germ _ y hy).hom (↑hu.unit⁻¹) * hr'
    · intro b hb
      apply MEM
      intro x
      obtain ⟨i, hi⟩ := hcov x
      obtain ⟨r, hr⟩ := hprod _ i.2.1 b hb
      refine ⟨_, -τι i, by rw [map_neg, ← hq i, map_neg], _, le_rfl, hi,
        (X.presheaf.map (homOfLE (le_top : X.basicOpen (sι i) ≤ ⊤)).op).hom r, fun y hy => ?_⟩
      rw [hTneg, hgr]
      have h4 := Units.inv_mul (Additive.toMul (eK _ (τι i)) ⟨y, hy⟩)
      rw [hTτ] at h4
      have hr' := hr y
      linear_combination (-(b y)) * h4 +
        (((Additive.toMul (eK _ (τι i)) ⟨y, hy⟩)⁻¹ : (X.presheaf.stalk y)ˣ) : X.presheaf.stalk y) * hr'

  have ABS : ∀ {Qt Kt : Type u} [AddCommGroup Qt] [AddCommGroup Kt] (p : Kt →+ Qt)
      (S : Qt → Submodule Γ(X, ⊤) (wcGermRing X)),
      (∀ q₁ q₂, S q₁ * S q₂ ≤ S (q₁ + q₂)) → S 0 ≤ 1 → (∀ q, 1 ≤ S q * S (-q)) →
      (∀ t, ∃ v : (wcGermRing X)ˣ, S (p t) = Submodule.spanSingleton Γ(X, ⊤) (v : wcGermRing X)) →
      (∀ q (v : (wcGermRing X)ˣ), (v : wcGermRing X) ∈ S q →
        ((v⁻¹ : (wcGermRing X)ˣ) : wcGermRing X) ∈ S (-q) → q ∈ p.range) →
      (∀ (M N : Submodule Γ(X, ⊤) (wcGermRing X)), M * N = 1 → ∃ q, M ≤ S q ∧ N ≤ S (-q)) →
      Nonempty (Qt ⧸ p.range ≃+ Additive ((Submodule Γ(X, ⊤) (wcGermRing X))ˣ ⧸ (Units.map ((Submodule.spanSingleton Γ(X, ⊤) : wcGermRing X →*₀ Submodule Γ(X, ⊤) (wcGermRing X)) : wcGermRing X →* Submodule Γ(X, ⊤) (wcGermRing X))).range)) := by
    intro Qt Kt _ _ p S S4 S9 S5 S6 S7 S8
    have genM : ∀ {A G : Type u} [AddCommGroup A] [CommGroup G] (H : Subgroup G) (S : AddSubgroup A)
        (Φ : A →+ Additive (G ⧸ H)), Function.Surjective Φ → Φ.ker = S →
        Nonempty (A ⧸ S ≃+ Additive (G ⧸ H)) := by
      intro A G _ _ H S Φ hs hk
      exact ⟨(QuotientAddGroup.quotientAddEquivOfEq hk.symm).trans
        (QuotientAddGroup.quotientKerEquivOfSurjective Φ hs)⟩
    have hunit : ∀ q, S q * S (-q) = 1 := by
      intro q
      apply le_antisymm _ (S5 q)
      have h := S4 q (-q)
      rw [add_neg_cancel] at h
      exact h.trans S9
    have hunit' : ∀ q, S (-q) * S q = 1 := by
      intro q; rw [mul_comm]; exact hunit q
    let Ψ : Qt → (Submodule Γ(X, ⊤) (wcGermRing X))ˣ := fun q => ⟨S q, S (-q), hunit q, hunit' q⟩
    have hΨv : ∀ q, ((Ψ q : (Submodule Γ(X, ⊤) (wcGermRing X))ˣ) : Submodule Γ(X, ⊤) (wcGermRing X)) = S q :=
      fun q => rfl
    have hΨi : ∀ q, (((Ψ q)⁻¹ : (Submodule Γ(X, ⊤) (wcGermRing X))ˣ) : Submodule Γ(X, ⊤) (wcGermRing X)) = S (-q) :=
      fun q => rfl
    have hΨadd : ∀ q₁ q₂, Ψ (q₁ + q₂) = Ψ q₁ * Ψ q₂ := by
      intro q₁ q₂
      apply Units.ext
      rw [Units.val_mul, hΨv, hΨv, hΨv]
      apply le_antisymm _ (S4 q₁ q₂)
      calc S (q₁ + q₂) = S (q₁ + q₂) * (S (-q₂) * S q₂) := by rw [hunit' q₂, mul_one]
        _ = (S (q₁ + q₂) * S (-q₂)) * S q₂ := (mul_assoc _ _ _).symm
        _ ≤ S (q₁ + q₂ + -q₂) * S q₂ := mul_le_mul' (S4 _ _) le_rfl
        _ = S q₁ * S q₂ := by rw [add_neg_cancel_right]
    obtain ⟨Φ, hΦ⟩ : ∃ Φ : Qt →+ Additive ((Submodule Γ(X, ⊤) (wcGermRing X))ˣ ⧸ (Units.map ((Submodule.spanSingleton Γ(X, ⊤) : wcGermRing X →*₀ Submodule Γ(X, ⊤) (wcGermRing X)) : wcGermRing X →* Submodule Γ(X, ⊤) (wcGermRing X))).range),
        ∀ q, Φ q = Additive.ofMul ((Ψ q : (Submodule Γ(X, ⊤) (wcGermRing X))ˣ) : (Submodule Γ(X, ⊤) (wcGermRing X))ˣ ⧸ (Units.map ((Submodule.spanSingleton Γ(X, ⊤) : wcGermRing X →*₀ Submodule Γ(X, ⊤) (wcGermRing X)) : wcGermRing X →* Submodule Γ(X, ⊤) (wcGermRing X))).range) := by
      refine ⟨AddMonoidHom.mk' (fun q => Additive.ofMul ((Ψ q : (Submodule Γ(X, ⊤) (wcGermRing X))ˣ) : (Submodule Γ(X, ⊤) (wcGermRing X))ˣ ⧸ (Units.map ((Submodule.spanSingleton Γ(X, ⊤) : wcGermRing X →*₀ Submodule Γ(X, ⊤) (wcGermRing X)) : wcGermRing X →* Submodule Γ(X, ⊤) (wcGermRing X))).range)) (fun a b => ?_), fun q => rfl⟩
      rw [hΨadd, QuotientGroup.mk_mul, ofMul_mul]
    have hsurj : Function.Surjective Φ := by
      intro z
      obtain ⟨U, hU⟩ := QuotientGroup.mk_surjective (Additive.toMul z)
      obtain ⟨q, hq1, hq2⟩ := S8 U.val U.inv U.val_inv
      have hΨU : Ψ q = U := by
        apply Units.ext
        rw [hΨv]
        apply le_antisymm _ hq1
        calc S q = S q * (U.inv * U.val) := by rw [U.inv_val, mul_one]
          _ = (S q * U.inv) * U.val := (mul_assoc _ _ _).symm
          _ ≤ (S q * S (-q)) * U.val := mul_le_mul' (mul_le_mul' le_rfl hq2) le_rfl
          _ = U.val := by rw [hunit q, one_mul]
      refine ⟨q, ?_⟩
      rw [hΦ, hΨU, hU, ofMul_toMul]
    have hker : Φ.ker = p.range := by
      ext q
      rw [AddMonoidHom.mem_ker, hΦ, ofMul_eq_zero, QuotientGroup.eq_one_iff]
      constructor
      · rintro ⟨v, hv⟩
        have hval : Submodule.spanSingleton Γ(X, ⊤) (v : wcGermRing X) = S q := by
          rw [← hΨv, ← hv]; rfl
        have hinv : Submodule.spanSingleton Γ(X, ⊤) ((v⁻¹ : (wcGermRing X)ˣ) : wcGermRing X) = S (-q) := by
          rw [← hΨi, ← hv, ← map_inv]; rfl
        apply S7 q v
        · rw [← hval, Submodule.spanSingleton_apply]
          exact Submodule.mem_span_singleton_self _
        · rw [← hinv, Submodule.spanSingleton_apply]
          exact Submodule.mem_span_singleton_self _
      · rintro ⟨t, rfl⟩
        obtain ⟨v, hv⟩ := S6 t
        refine ⟨v, Units.ext ?_⟩
        rw [hΨv, hv]
        rfl
    exact genM _ p.range Φ hsurj hker
  have S6' : ∀ t : K.obj.obj (Opposite.op ⊤), ∃ v : (wcGermRing X)ˣ,
      wcCokSub X K Q π eK ((π.hom.app (Opposite.op ⊤)).hom t) =
        Submodule.spanSingleton Γ(X, ⊤) (v : wcGermRing X) := by
    intro t
    let v : (wcGermRing X)ˣ :=
      { val := fun y => ((Additive.toMul (eK ⊤ t) ⟨y, trivial⟩ : (X.presheaf.stalk y)ˣ) :
          X.presheaf.stalk y)
        inv := fun y => (((Additive.toMul (eK ⊤ t) ⟨y, trivial⟩)⁻¹ : (X.presheaf.stalk y)ˣ) :
          X.presheaf.stalk y)
        val_inv := funext fun y => Units.mul_inv _
        inv_val := funext fun y => Units.inv_mul _ }
    exact ⟨v, S6 t v (fun y => rfl)⟩
  have S7' : ∀ (q : Q.obj.obj (Opposite.op ⊤)) (v : (wcGermRing X)ˣ),
      (v : wcGermRing X) ∈ wcCokSub X K Q π eK q →
      ((v⁻¹ : (wcGermRing X)ˣ) : wcGermRing X) ∈ wcCokSub X K Q π eK (-q) →
      q ∈ (π.hom.app (Opposite.op ⊤)).hom.range := by
    intro q v hv1 hv2
    let vt : ∀ y : (⊤ : X.Opens), (X.presheaf.stalk (y : X))ˣ := fun y =>
      ⟨(v : wcGermRing X) y, ((v⁻¹ : (wcGermRing X)ˣ) : wcGermRing X) y,
        congrArg (fun z : wcGermRing X => z y) v.mul_inv,
        congrArg (fun z : wcGermRing X => z y) v.inv_mul⟩
    refine ⟨(eK ⊤).symm (Additive.ofMul vt), S7 q v hv1 hv2 _ (fun y => ?_)⟩
    rw [AddEquiv.apply_symm_apply, toMul_ofMul]
  exact ABS (π.hom.app (Opposite.op ⊤)).hom (wcCokSub X K Q π eK) S4 S9 S5 S6' S7' S8

theorem wc_et_gm_h1_affine_pic : ∀ (A : Type u) [CommRing A], letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}) := HasExt.standard _; Nonempty (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (wcEtGm (Spec (.of A))) 1 ≃+ Additive (CommRing.Pic A)) :=
by
  classical
  have key : ∀ (X : Scheme.{u}) [IsAffine X],
      letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
      Nonempty (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) (wcEtGm X) 1 ≃+ Additive (CommRing.Pic Γ(X, ⊤))) := by
    intro X _
    letI : HasExt (Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}) := HasExt.standard _

    obtain ⟨e₁⟩ := wc_et_gm_h1_zariski X

    obtain ⟨K, eK, i, hres, himg, hinj⟩ := wc_zar_germ_units_sheaf X
    haveI hmonoapp : ∀ V, Mono (i.hom.app V) := fun V =>
      (AddCommGrpCat.mono_iff_injective _).mpr (hinj V.unop)
    haveI : Mono i.hom := NatTrans.mono_of_mono_app _
    haveI hmono : Mono i := Sheaf.Hom.mono_of_presheaf_mono _ _ i
    have hSE : (ShortComplex.mk i (Limits.cokernel.π i) (Limits.cokernel.condition i)).ShortExact := by
      apply ShortComplex.ShortExact.mk'
      · exact ShortComplex.exact_of_g_is_cokernel _ (Limits.cokernelIsCokernel i)
      · show Mono i
        exact hmono
      · show Epi (Limits.cokernel.π i)
        infer_instance

    have hflasque : ∀ (V W : X.Opens) (h : W ≤ V), Function.Surjective (K.obj.map (homOfLE h).op) := by
      intro V W h k
      refine ⟨(eK V).symm (Additive.ofMul (fun x : V =>
        if hx : (x : X) ∈ W then Additive.toMul (eK W k) ⟨x, hx⟩ else 1)), ?_⟩
      apply (eK W).injective
      apply Additive.toMul.injective
      funext x
      rw [hres]
      simp [x.2]
    have hvan : ∀ e : Abelian.Ext ((constantSheaf (Opens.grothendieckTopology X)
        AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ))) K 1, e = 0 := by
      haveI := wc_zar_flasque_ext_one_vanish X K hflasque
      intro e
      exact Subsingleton.elim _ _
    obtain ⟨e₂⟩ := wc_h1_quotient_of_acyclic_middle (Opens.grothendieckTopology X)
      Limits.isTerminalTop i (Limits.cokernel.π i) (Limits.cokernel.condition i) hSE hvan

    obtain ⟨e₃⟩ := wc_zar_cokernel_sections_submodule X (wcZarGm X) K (Limits.cokernel i) i
      (Limits.cokernel.π i) (Limits.cokernel.condition i) hSE eK hres himg hinj
      (wc_germ_cocycle_partition X)

    haveI : FaithfulSMul Γ(X, ⊤) (wcGermRing X) := by
      rw [faithfulSMul_iff_algebraMap_injective]
      intro r r' h
      apply TopCat.Presheaf.section_ext X.sheaf ⊤ r r'
      intro x hx
      exact congrArg (fun v : wcGermRing X => (show ∀ x : X, X.presheaf.stalk x from v) x) h
    haveI : Subsingleton (CommRing.Pic (wcGermRing X)) :=
      wc_pic_pi_local_subsingleton X (fun x : X => (X.presheaf.stalk x : Type u))
    have hsurj : Function.Surjective (Submodule.unitsToPic Γ(X, ⊤) (wcGermRing X)) := by
      intro p
      have hp : p ∈ (Submodule.unitsToPic Γ(X, ⊤) (wcGermRing X)).range := by
        rw [Submodule.range_unitsToPic, CommRing.relPic_eq_top]
        trivial
      exact MonoidHom.mem_range.mp hp
    have hker : (Submodule.unitsToPic Γ(X, ⊤) (wcGermRing X)).ker =
        (Units.map ((Submodule.spanSingleton Γ(X, ⊤) : wcGermRing X →*₀
          Submodule Γ(X, ⊤) (wcGermRing X)) : wcGermRing X →*
          Submodule Γ(X, ⊤) (wcGermRing X))).range := by
      ext y
      rw [MonoidHom.mem_ker, MonoidHom.mem_range]
      exact Submodule.mulExact_unitsMap_spanSingleton_unitsToPic Γ(X, ⊤) _ y
    let e₄ := (QuotientGroup.quotientMulEquivOfEq hker.symm).trans
      (QuotientGroup.quotientKerEquivOfSurjective _ hsurj)
    exact ⟨e₁.trans (e₂.trans (e₃.trans (MulEquiv.toAdditive e₄)))⟩
  intro A _
  obtain ⟨E⟩ := key (Spec (.of A))
  let f : Γ(Spec (.of A), ⊤) →+* A := (Scheme.ΓSpecIso (.of A)).hom.hom
  let g : A →+* Γ(Spec (.of A), ⊤) := (Scheme.ΓSpecIso (.of A)).inv.hom
  have hfg : f.comp g = RingHom.id A := by
    show (Scheme.ΓSpecIso (.of A)).hom.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom = RingHom.id A
    rw [← CommRingCat.hom_comp, Iso.inv_hom_id]
    rfl
  have hgf : g.comp f = RingHom.id Γ(Spec (.of A), ⊤) := by
    show (Scheme.ΓSpecIso (.of A)).inv.hom.comp (Scheme.ΓSpecIso (.of A)).hom.hom =
      RingHom.id Γ(Spec (.of A), ⊤)
    rw [← CommRingCat.hom_comp, Iso.hom_inv_id]
    rfl
  let P : CommRing.Pic Γ(Spec (.of A), ⊤) ≃* CommRing.Pic A :=
    { toFun := CommRing.Pic.mapRingHom f
      invFun := CommRing.Pic.mapRingHom g
      left_inv := fun M => by
        show CommRing.Pic.mapRingHom g (CommRing.Pic.mapRingHom f M) = M
        rw [CommRing.Pic.mapRingHom_mapRingHom, hgf, CommRing.Pic.mapRingHom_id]
        rfl
      right_inv := fun M => by
        show CommRing.Pic.mapRingHom f (CommRing.Pic.mapRingHom g M) = M
        rw [CommRing.Pic.mapRingHom_mapRingHom, hfg, CommRing.Pic.mapRingHom_id]
        rfl
      map_mul' := map_mul _ }
  exact ⟨E.trans (MulEquiv.toAdditive P)⟩

theorem wc_affine_kummer_h1_card_of_pic : ∀ (k : Type u) [Field k] [IsAlgClosed k] (ℓ : ℕ), ℓ.Prime → (ℓ : k) ≠ 0 → ∀ (A : Type u) [CommRing A] (s : Spec (.of A) ⟶ Spec (.of k)), (letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}) := HasExt.standard _; Nonempty (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (wcEtGm (Spec (.of A))) 1 ≃+ Additive (CommRing.Pic A))) → (Finite (wcEtCoh (Spec (.of A)) ℓ 1) → Finite {x : CommRing.Pic A // x ^ ℓ = 1} ∧ Finite (Aˣ ⧸ (powMonoidHom ℓ : Aˣ →* Aˣ).range)) ∧ Nat.card (wcEtCoh (Spec (.of A)) ℓ 1) = Nat.card {x : CommRing.Pic A // x ^ ℓ = 1} * Nat.card (Aˣ ⧸ (powMonoidHom ℓ : Aˣ →* Aˣ).range) :=
by
  classical
  intro k _ _ ℓ hℓ hℓk A _ s hPic

  have key : ∀ (M1 M0 : Type u) [CommGroup M1] [CommGroup M0]
      {C : Type (u+2)} [Category.{u+1} C] [Abelian C] [HasExt.{u+2} C] (P L G : C)
      (ι : L ⟶ G) (h : ι ≫ (ℓ • 𝟙 G) = 0) (hS : (ShortComplex.mk ι (ℓ • 𝟙 G) h).ShortExact),
      (Abelian.Ext P G 1 ≃+ Additive M1) → (Abelian.Ext P G 0 ≃+ Additive M0) →
      (Finite (Abelian.Ext P L 1) → Finite {x : M1 // x ^ ℓ = 1} ∧
        Finite (M0 ⧸ (powMonoidHom ℓ : M0 →* M0).range)) ∧
      Nat.card (Abelian.Ext P L 1) = Nat.card {x : M1 // x ^ ℓ = 1} *
        Nat.card (M0 ⧸ (powMonoidHom ℓ : M0 →* M0).range) := by
    intro M1 M0 _ _ C _ _ _ P L G ι h hS ePic eU

    have hmk : ∀ (T : C) (m : ℕ),
        (Abelian.Ext.mk₀ (m • 𝟙 T) : Abelian.Ext T T 0) = m • Abelian.Ext.mk₀ (𝟙 T) := by
      intro T m
      induction m with
      | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero]
      | succ m ih => rw [succ_nsmul, Abelian.Ext.mk₀_add, ih, succ_nsmul]
    have hns : ∀ {X T : C} {k' : ℕ} (α : Abelian.Ext X T k') (m : ℕ),
        α.comp (Abelian.Ext.mk₀ (m • 𝟙 T)) (add_zero k') = m • α := by
      intro X T k' α m
      have hlin := map_nsmul (Abelian.Ext.bilinearComp X T T k' 0 k' (add_zero k') α) m
        (Abelian.Ext.mk₀ (𝟙 T))
      simp only [Abelian.Ext.bilinearComp_apply_apply] at hlin
      rw [Abelian.Ext.comp_mk₀_id] at hlin
      rw [hmk, hlin]
    have hE1 : hS.extClass.comp (Abelian.Ext.mk₀ ι) (add_zero 1) = 0 := hS.extClass_comp
    have hE2 : (Abelian.Ext.mk₀ (ℓ • 𝟙 G)).comp hS.extClass (zero_add 1) = 0 := hS.comp_extClass

    let δ : Abelian.Ext P G 0 →+ Abelian.Ext P L 1 :=
      AddMonoidHom.mk' (fun y => y.comp hS.extClass (zero_add 1))
        (fun a b => Abelian.Ext.add_comp a b _ _)
    let φ : Abelian.Ext P L 1 →+ Abelian.Ext P G 1 :=
      AddMonoidHom.mk' (fun x => x.comp (Abelian.Ext.mk₀ ι) (add_zero 1))
        (fun a b => Abelian.Ext.add_comp a b _ _)
    have hδ : ∀ y, δ y = y.comp hS.extClass (zero_add 1) := fun _ => rfl
    have hφ : ∀ x, φ x = x.comp (Abelian.Ext.mk₀ ι) (add_zero 1) := fun _ => rfl

    have hi : ∀ x : Abelian.Ext P L 1, φ x = 0 ↔ ∃ y, δ y = x := by
      intro x
      constructor
      · intro hx
        rw [hφ] at hx
        obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₁ P hS x hx (zero_add 1)
        exact ⟨y, (hδ y).trans hy⟩
      · rintro ⟨y, rfl⟩
        rw [hφ, hδ, Abelian.Ext.comp_assoc_of_third_deg_zero, hE1, Abelian.Ext.comp_zero]
    have hii : ∀ z : Abelian.Ext P G 1, (∃ x, φ x = z) ↔ ℓ • z = 0 := by
      intro z
      constructor
      · rintro ⟨x, rfl⟩
        rw [hφ, ← hns (x.comp (Abelian.Ext.mk₀ ι) (add_zero 1)) ℓ,
          Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, h,
          Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
      · intro hz
        have h2 : z.comp (Abelian.Ext.mk₀ (ℓ • 𝟙 G)) (add_zero 1) = 0 := by
          rw [hns]; exact hz
        obtain ⟨x, hx⟩ := Abelian.Ext.covariant_sequence_exact₂ P hS z h2
        exact ⟨x, (hφ x).trans hx⟩
    have hiii : ∀ y : Abelian.Ext P G 0, δ y = 0 ↔ ∃ w, ℓ • w = y := by
      intro y
      constructor
      · intro hy
        rw [hδ] at hy
        obtain ⟨w, hw⟩ := Abelian.Ext.covariant_sequence_exact₃ P hS y (zero_add 1) hy
        exact ⟨w, by rw [← hns w ℓ]; exact hw⟩
      · rintro ⟨w, rfl⟩
        rw [hδ, ← hns w ℓ, Abelian.Ext.comp_assoc_of_second_deg_zero, hE2, Abelian.Ext.comp_zero]

    let e₁ : (Abelian.Ext P L 1 ⧸ φ.ker) ≃+ φ.range := QuotientAddGroup.quotientKerEquivRange φ
    let eT : φ.range ≃ {z : Abelian.Ext P G 1 // ℓ • z = 0} :=
      Equiv.subtypeEquivRight (fun z => by rw [AddMonoidHom.mem_range]; exact hii z)
    let e₃ : φ.ker ≃ δ.range :=
      Equiv.subtypeEquivRight (fun x => by
        rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_range]; exact hi x)
    have hkerδ : δ.ker = (nsmulAddMonoidHom ℓ : Abelian.Ext P G 0 →+ _).range := by
      ext y
      rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_range]
      simp only [nsmulAddMonoidHom_apply]
      exact hiii y
    let e₂ : (Abelian.Ext P G 0 ⧸ (nsmulAddMonoidHom ℓ : Abelian.Ext P G 0 →+ _).range) ≃+
        δ.range :=
      (QuotientAddGroup.quotientAddEquivOfEq hkerδ).symm.trans
        (QuotientAddGroup.quotientKerEquivRange δ)

    let τ : {z : Abelian.Ext P G 1 // ℓ • z = 0} ≃ {x : M1 // x ^ ℓ = 1} :=
      (ePic.toEquiv.trans Additive.toMul).subtypeEquiv (fun z => by
        have e : (ePic.toEquiv.trans Additive.toMul) z = Additive.toMul (ePic z) := rfl
        rw [e, ← toMul_nsmul, ← map_nsmul ePic ℓ z, toMul_eq_one, AddEquiv.map_eq_zero_iff])

    let RM : Subgroup M0 := (powMonoidHom ℓ : M0 →* M0).range
    let ψ : Abelian.Ext P G 0 →+ Additive (M0 ⧸ RM) :=
      (MonoidHom.toAdditive (QuotientGroup.mk' RM)).comp eU.toAddMonoidHom
    have hψ : ∀ z, ψ z = Additive.ofMul (QuotientGroup.mk' RM (Additive.toMul (eU z))) :=
      fun _ => rfl
    have hψsurj : Function.Surjective ψ := by
      intro q
      obtain ⟨m, hm⟩ := QuotientGroup.mk'_surjective RM (Additive.toMul q)
      refine ⟨eU.symm (Additive.ofMul m), ?_⟩
      rw [hψ, AddEquiv.apply_symm_apply, toMul_ofMul, hm, ofMul_toMul]
    have hkerψ : ψ.ker = (nsmulAddMonoidHom ℓ : Abelian.Ext P G 0 →+ _).range := by
      ext z
      rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_range, hψ, ofMul_eq_zero, QuotientGroup.mk'_apply,
        QuotientGroup.eq_one_iff, MonoidHom.mem_range]
      constructor
      · rintro ⟨w, hw⟩
        refine ⟨eU.symm (Additive.ofMul w), ?_⟩
        apply eU.injective
        rw [powMonoidHom_apply] at hw
        rw [nsmulAddMonoidHom_apply, map_nsmul, AddEquiv.apply_symm_apply, ← ofMul_pow, hw,
          ofMul_toMul]
      · rintro ⟨v, hv⟩
        refine ⟨Additive.toMul (eU v), ?_⟩
        rw [powMonoidHom_apply, ← toMul_nsmul, ← map_nsmul eU ℓ v, ← hv, nsmulAddMonoidHom_apply]
    let κ : (Abelian.Ext P G 0 ⧸ (nsmulAddMonoidHom ℓ : Abelian.Ext P G 0 →+ _).range) ≃
        (M0 ⧸ RM) :=
      ((QuotientAddGroup.quotientAddEquivOfEq hkerψ.symm).trans
        (QuotientAddGroup.quotientKerEquivOfSurjective ψ hψsurj)).toEquiv.trans Additive.toMul
    refine ⟨fun hF => ?_, ?_⟩
    · haveI : Finite (Abelian.Ext P L 1 ⧸ φ.ker) := inferInstance
      exact ⟨Finite.of_equiv _ ((e₁.toEquiv.trans eT).trans τ),
        Finite.of_equiv _ (e₂.symm.toEquiv.trans κ)⟩
    · rw [AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup φ.ker,
        Nat.card_congr ((e₁.toEquiv.trans eT).trans τ), Nat.card_congr e₃,
        Nat.card_congr (e₂.symm.toEquiv.trans κ)]

  obtain ⟨ePic⟩ := hPic
  obtain ⟨eU0⟩ := wc_et_gm_h0_units (Spec (.of A))
  obtain ⟨ι, h, hS⟩ := wc_et_kummer_ses_gen k (Spec (.of A)) s ℓ hℓk
  exact @key (CommRing.Pic A) Aˣ _ _ _ _ _ (HasExt.standard _) _ _ _ ι h hS ePic
    (eU0.trans (MulEquiv.toAdditive
      (Units.mapEquiv (Scheme.ΓSpecIso (CommRingCat.of A)).commRingCatIsoToRingEquiv.toMulEquiv)))

theorem wc_laurent_away_pic_units_card : ∀ (k : Type u) [Field k] [IsAlgClosed k] (ℓ : ℕ), ℓ.Prime → Nat.card {x : CommRing.Pic (Localization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) k)) // x ^ ℓ = 1} = 1 ∧ Nat.card ((Localization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) k))ˣ ⧸ (powMonoidHom ℓ : (Localization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) k))ˣ →* (Localization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) k))ˣ).range) = ℓ :=
by
  intro k _ _ ℓ hℓ
  classical
  have s4 : ∀ (G : Type u) [CommGroup G] (H : Subgroup G) (t : G) (ℓ : ℕ), 0 < ℓ →
      (∀ g : G, ∃ h ∈ H, ∃ n : ℤ, g = h * t ^ n) → (∀ h ∈ H, ∃ h' ∈ H, h' ^ ℓ = h) →
      (∀ n : ℤ, t ^ n ∈ H → n = 0) → Nat.card (G ⧸ (powMonoidHom ℓ : G →* G).range) = ℓ := by
    intro G _ H t ℓ hℓ hgen hdiv hfree
    let φ : Fin ℓ → G ⧸ (powMonoidHom ℓ : G →* G).range :=
      fun r => ((t ^ ((r : ℕ) : ℤ) : G) : G ⧸ (powMonoidHom ℓ : G →* G).range)
    have hbij : Function.Bijective φ := by
      constructor
      · intro r r' hrr
        obtain ⟨g, hg⟩ := QuotientGroup.eq.mp hrr
        rw [powMonoidHom_apply] at hg
        obtain ⟨h, hH, m, rfl⟩ := hgen g
        have e1 : (h * t ^ m) ^ ℓ = h ^ ℓ * t ^ ((ℓ : ℤ) * m) := by
          rw [mul_pow, ← zpow_natCast (t ^ m), ← zpow_mul, mul_comm m]
        rw [e1, ← zpow_neg, ← zpow_add] at hg
        have key : t ^ (((r' : ℕ) : ℤ) - ((r : ℕ) : ℤ) - (ℓ : ℤ) * m) = h ^ ℓ := by
          rw [show ((r' : ℕ) : ℤ) - ((r : ℕ) : ℤ) - (ℓ : ℤ) * m
              = (-((r : ℕ) : ℤ) + ((r' : ℕ) : ℤ)) + -((ℓ : ℤ) * m) by ring, zpow_add, ← hg,
            zpow_neg, mul_inv_cancel_right]
        have hn := hfree _ (key ▸ Subgroup.pow_mem H hH ℓ)
        have hdvd : (ℓ : ℤ) ∣ ((r' : ℕ) : ℤ) - ((r : ℕ) : ℤ) := ⟨m, by linarith⟩
        have h1 := r.isLt
        have h2 := r'.isLt
        have habs : |((r' : ℕ) : ℤ) - ((r : ℕ) : ℤ)| < ℓ := abs_sub_lt_iff.mpr ⟨by omega, by omega⟩
        have h0 := Int.eq_zero_of_abs_lt_dvd hdvd habs
        apply Fin.ext
        omega
      · intro q
        obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective q
        obtain ⟨h, hH, n, rfl⟩ := hgen g
        obtain ⟨h', hH', hh'⟩ := hdiv h hH
        have hℓ' : (ℓ : ℤ) ≠ 0 := by exact_mod_cast hℓ.ne'
        have hr0 : 0 ≤ n % (ℓ : ℤ) := Int.emod_nonneg n hℓ'
        have hrl : n % (ℓ : ℤ) < ℓ := Int.emod_lt_of_pos n (by exact_mod_cast hℓ)
        refine ⟨⟨(n % (ℓ : ℤ)).toNat, by omega⟩, ?_⟩
        apply QuotientGroup.eq.mpr
        show (t ^ (((n % (ℓ : ℤ)).toNat : ℕ) : ℤ))⁻¹ * (h * t ^ n) ∈ _
        refine ⟨h' * t ^ (n / (ℓ : ℤ)), ?_⟩
        rw [powMonoidHom_apply, mul_pow, hh', ← zpow_natCast (t ^ (n / (ℓ : ℤ))), ← zpow_mul,
          Int.toNat_of_nonneg hr0, ← zpow_neg, mul_left_comm, ← zpow_add]
        congr 2
        have := Int.mul_ediv_add_emod n (ℓ : ℤ)
        linarith
    rw [← Nat.card_eq_of_bijective φ hbij, Nat.card_fin]
  have main : ∀ (A : Type u) [CommRing A] [Algebra (MvPolynomial (Fin 1) k) A]
      [IsLocalization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) k) A],
      Nat.card {x : CommRing.Pic A // x ^ ℓ = 1} = 1 ∧
      Nat.card (Aˣ ⧸ (powMonoidHom ℓ : Aˣ →* Aˣ).range) = ℓ := by
    intro A _ _ _
    have hX0 : (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) k) ≠ 0 := MvPolynomial.X_ne_zero 0
    have hle : Submonoid.powers (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) k) ≤
        nonZeroDivisors _ := powers_le_nonZeroDivisors_of_noZeroDivisors hX0
    have hinj : Function.Injective (algebraMap (MvPolynomial (Fin 1) k) A) :=
      IsLocalization.injective A hle
    haveI : IsDomain A :=
      IsLocalization.isDomain_of_le_nonZeroDivisors A hle
    haveI hRpid : IsPrincipalIdealRing (MvPolynomial (Fin 1) k) :=
      IsPrincipalIdealRing.of_surjective
        (MvPolynomial.uniqueAlgEquiv k (Fin 1)).symm.toRingEquiv.toRingHom
        (MvPolynomial.uniqueAlgEquiv k (Fin 1)).symm.surjective
    haveI : IsPrincipalIdealRing A := by
      constructor
      intro J
      obtain ⟨a, ha⟩ := Submodule.IsPrincipal.principal
        (Ideal.under (MvPolynomial (Fin 1) k) J)
      refine ⟨⟨algebraMap _ A a, ?_⟩⟩
      rw [← IsLocalization.map_under
        (Submonoid.powers (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) k)) A J, ha]
      show Ideal.map _ (Ideal.span {a}) = Ideal.span {_}
      rw [Ideal.map_span, Set.image_singleton]
    have hPic : Subsingleton (CommRing.Pic A) := by
      rw [CommRing.Pic.subsingleton_iff]
      intro M _ _ hM
      haveI := hM
      exact Module.free_of_finite_type_torsion_free'
    refine ⟨?_, ?_⟩
    · haveI : Unique {x : CommRing.Pic A // x ^ ℓ = 1} :=
        ⟨⟨⟨1, one_pow ℓ⟩⟩, fun x => Subsingleton.elim _ _⟩
      exact Nat.card_unique
    · let t : Aˣ := (IsLocalization.Away.algebraMap_isUnit
        (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) k) :
          IsUnit (algebraMap (MvPolynomial (Fin 1) k) A (MvPolynomial.X 0))).unit
      have ht : (t : A) = algebraMap (MvPolynomial (Fin 1) k) A (MvPolynomial.X 0) :=
        IsUnit.unit_spec _
      let κ : kˣ →* Aˣ :=
        Units.map ((algebraMap (MvPolynomial (Fin 1) k) A).comp MvPolynomial.C).toMonoidHom
      have hκ : ∀ c : kˣ, ((κ c : Aˣ) : A) =
          algebraMap (MvPolynomial (Fin 1) k) A (MvPolynomial.C (c : k)) := fun c => rfl
      apply s4 Aˣ κ.range t ℓ hℓ.pos
      · intro u
        obtain ⟨⟨a, ⟨_, m, rfl⟩⟩, ha⟩ := IsLocalization.surj
          (Submonoid.powers (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) k)) (u : A)
        obtain ⟨⟨b, ⟨_, m', rfl⟩⟩, hb⟩ := IsLocalization.surj
          (Submonoid.powers (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) k)) ((u⁻¹ : Aˣ) : A)
        change (u : A) * algebraMap _ A (MvPolynomial.X 0 ^ m) = algebraMap _ A a at ha
        change ((u⁻¹ : Aˣ) : A) * algebraMap _ A (MvPolynomial.X 0 ^ m') = algebraMap _ A b at hb
        have hab : a * b = MvPolynomial.X 0 ^ (m + m') := by
          apply hinj
          rw [map_mul, ← ha, ← hb, pow_add, map_mul]
          linear_combination (algebraMap (MvPolynomial (Fin 1) k) A (MvPolynomial.X 0 ^ m) *
            algebraMap (MvPolynomial (Fin 1) k) A (MvPolynomial.X 0 ^ m')) * (Units.mul_inv u)
        have hXp : Prime (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) k) :=
          MvPolynomial.X_prime
        obtain ⟨i, hi, v, hv⟩ := (dvd_prime_pow hXp (m + m')).mp ⟨b, hab.symm⟩
        obtain ⟨r, hr, hvr⟩ := MvPolynomial.isUnit_iff_eq_C_of_isReduced.mp v.isUnit
        have hr0 : r ≠ 0 := hr.ne_zero
        refine ⟨κ (Units.mk0 r⁻¹ (inv_ne_zero hr0)), ⟨_, rfl⟩, (i : ℤ) - m, ?_⟩
        have key : u * t ^ m = κ (Units.mk0 r⁻¹ (inv_ne_zero hr0)) * t ^ i := by
          apply Units.ext
          rw [Units.val_mul, Units.val_mul, Units.val_pow_eq_pow_val, Units.val_pow_eq_pow_val,
            hκ, ht, Units.val_mk0, ← map_pow, ← map_pow, ha, ← map_mul]
          congr 1
          rw [← hv, hvr, mul_left_comm, ← MvPolynomial.C_mul, inv_mul_cancel₀ hr0,
            MvPolynomial.C_1, mul_one]
        rw [zpow_sub, zpow_natCast, zpow_natCast, ← mul_assoc, ← key, mul_inv_cancel_right]
      · rintro _ ⟨c, rfl⟩
        obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (c : k) hℓ.pos
        have hz0 : z ≠ 0 := by
          rintro rfl
          rw [zero_pow hℓ.ne_zero] at hz
          exact c.ne_zero hz.symm
        refine ⟨κ (Units.mk0 z hz0), ⟨_, rfl⟩, ?_⟩
        rw [← map_pow]
        congr 1
        apply Units.ext
        rw [Units.val_pow_eq_pow_val, Units.val_mk0, hz]
      · rintro n ⟨c, hc⟩
        obtain ⟨e, rfl | rfl⟩ := Int.eq_nat_or_neg n
        · have h1 := congrArg Units.val hc
          rw [hκ, zpow_natCast, Units.val_pow_eq_pow_val, ht, ← map_pow] at h1
          have h3 := congrArg MvPolynomial.constantCoeff (hinj h1)
          rw [MvPolynomial.constantCoeff_C, map_pow, MvPolynomial.constantCoeff_X] at h3
          by_contra hne
          have he : e ≠ 0 := by omega
          rw [zero_pow he] at h3
          exact c.ne_zero h3
        · have h1 : κ c * t ^ e = 1 := by rw [hc, zpow_neg, zpow_natCast, inv_mul_cancel]
          have h2 := congrArg Units.val h1
          rw [Units.val_mul, hκ, Units.val_pow_eq_pow_val, ht, ← map_pow, ← map_mul,
            Units.val_one, ← map_one (algebraMap (MvPolynomial (Fin 1) k) A)] at h2
          have h3 := congrArg MvPolynomial.constantCoeff (hinj h2)
          rw [map_mul, MvPolynomial.constantCoeff_C, map_pow, MvPolynomial.constantCoeff_X,
            map_one] at h3
          by_contra hne
          have he : e ≠ 0 := by omega
          rw [zero_pow he, mul_zero] at h3
          exact zero_ne_one h3
  exact main _

theorem wc_affine_origin_range_iff : ∀ (K : Type u) [Field K] (d : ℕ) (x : Spec (.of (MvPolynomial (Fin d) K))), x ∈ Set.range (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin d) K →+* K))) ↔ ∀ i : Fin d, (MvPolynomial.X i : MvPolynomial (Fin d) K) ∈ x.asIdeal :=
by
  intro K _ d x
  constructor
  · rintro ⟨p, rfl⟩ i
    rw [Spec.map_apply]
    change MvPolynomial.constantCoeff (MvPolynomial.X i : MvPolynomial (Fin d) K) ∈
      PrimeSpectrum.asIdeal (R := K) p
    rw [MvPolynomial.constantCoeff_X]
    exact Ideal.zero_mem _
  · intro h
    have hsurj : Function.Surjective
        (MvPolynomial.constantCoeff : MvPolynomial (Fin d) K →+* K) :=
      fun r => ⟨MvPolynomial.C r, MvPolynomial.constantCoeff_C _ r⟩
    have hker : ((RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin d) K →+* K) :
        Ideal (MvPolynomial (Fin d) K)) : Set (MvPolynomial (Fin d) K)) ⊆
        (x.asIdeal : Set (MvPolynomial (Fin d) K)) := by
      intro q hq
      have hq0 : MvPolynomial.constantCoeff q = 0 := RingHom.mem_ker.mp hq
      have hspan : q ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin d))) := by
        rw [MvPolynomial.mem_ideal_span_X_image]
        intro m hm
        rw [MvPolynomial.mem_support_iff] at hm
        by_contra hc
        push_neg at hc
        apply hm
        have hm0 : m = 0 := Finsupp.ext (fun i => hc i (Set.mem_univ i))
        rw [hm0]
        exact hq0
      have hle : Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin d))) ≤ x.asIdeal := by
        rw [Ideal.span_le]
        rintro _ ⟨i, _, rfl⟩
        exact h i
      exact hle hspan
    have hx : (x : PrimeSpectrum (MvPolynomial (Fin d) K)) ∈ Set.range
        (PrimeSpectrum.comap (MvPolynomial.constantCoeff : MvPolynomial (Fin d) K →+* K)) := by
      rw [range_comap_of_surjective _ _ hsurj]
      exact (PrimeSpectrum.mem_zeroLocus _ _).mpr hker
    obtain ⟨p, hp⟩ := hx
    exact ⟨p, hp⟩

theorem wc_et_punctured_line_coh_card : ∀ (k : Type u) [Field k] [IsAlgClosed k] (ℓ : ℕ), ℓ.Prime → (ℓ : k) ≠ 0 → ∀ (U : (Spec (.of (MvPolynomial (Fin 1) k))).Opens), (U : Set (Spec (.of (MvPolynomial (Fin 1) k)))) = (Set.range (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin 1) k →+* k))))ᶜ → Nat.card (wcEtCoh U ℓ 0) = ℓ ∧ Nat.card (wcEtCoh U ℓ 1) = Nat.card (wcEtCoh (Spec (.of (Localization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) k)))) ℓ 1) ∧ Subsingleton (wcEtCoh U ℓ 2) :=
by
  intro k _ _ ℓ hℓ hℓk U hU
  classical

  have hrangeφ : Set.range (Spec.map (CommRingCat.ofHom (algebraMap (MvPolynomial (Fin 1) k)
      (Localization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) k))))) =
      {x : Spec (.of (MvPolynomial (Fin 1) k)) |
        (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) k) ∉ x.asIdeal} := by
    have h := PrimeSpectrum.localization_away_comap_range (R := MvPolynomial (Fin 1) k)
      (Localization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) k))
      (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) k)
    ext x
    have h2 : x ∈ Set.range (PrimeSpectrum.comap (algebraMap (MvPolynomial (Fin 1) k)
        (Localization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) k)))) ↔
        x ∈ ((PrimeSpectrum.basicOpen (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) k) :
          TopologicalSpace.Opens (PrimeSpectrum (MvPolynomial (Fin 1) k))) :
          Set (PrimeSpectrum (MvPolynomial (Fin 1) k))) := by
      rw [h]
    exact h2.trans (PrimeSpectrum.mem_basicOpen _ _)
  have hrange : Set.range U.ι = Set.range (Spec.map (CommRingCat.ofHom (algebraMap
      (MvPolynomial (Fin 1) k)
      (Localization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) k))))) := by
    rw [Scheme.Opens.range_ι, hU, hrangeφ]
    ext x
    rw [Set.mem_compl_iff, wc_affine_origin_range_iff, Fin.forall_fin_one]
    try exact Iff.rfl
  let e : (U : Scheme.{u}) ≅
      Spec (.of (Localization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) k))) :=
    IsOpenImmersion.isoOfRangeEq U.ι _ hrange
  obtain ⟨E0⟩ := wc_et_coh_iso_invariance e.hom ℓ 0
  obtain ⟨E1⟩ := wc_et_coh_iso_invariance e.hom ℓ 1
  obtain ⟨E2⟩ := wc_et_coh_iso_invariance e.hom ℓ 2

  haveI hdom : IsDomain (Localization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) k)) :=
    IsLocalization.isDomain_localization
      (powers_le_nonZeroDivisors_of_noZeroDivisors (MvPolynomial.X_ne_zero (R := k) (0 : Fin 1)))
  haveI : ConnectedSpace
      (Spec (.of (Localization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) k)))) :=
    inferInstance
  have h0A := wc_et_coh_zero_connected_card
    (Spec (.of (Localization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) k)))) ℓ
    hℓ.ne_zero

  have H2A : Subsingleton (wcEtCoh
      (Spec (.of (Localization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) k)))) ℓ 2) := by
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology
        (Spec (.of (Localization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) k)))))
        AddCommGrpCat.{u+1}) := HasExt.standard _
    obtain ⟨jP, hjP⟩ := wc_polynomial_open_immersion_projK_one k
    haveI := hjP
    haveI := wc_proj_space_isProper k 1
    haveI := wc_proj_space_smooth k 1
    have hA : (ℓ • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) = 0 := by
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      rintro ⟨z⟩
      apply ULift.ext
      simp
    have htor : ℓ • 𝟙 ((constantSheaf (Scheme.smallEtaleTopology
        (Spec (.of (Localization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) k)))))
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) = 0 := by
      rw [← CategoryTheory.Functor.map_id, ← CategoryTheory.Functor.map_nsmul, hA,
        CategoryTheory.Functor.map_zero]
    have h := wc_et_affine_curve_torsion_vanishing k (wcProjK k 1) (wcProjKStr k 1)
      (Spec (.of (Localization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) k))))
      (Spec.map (CommRingCat.ofHom (algebraMap (MvPolynomial (Fin 1) k)
        (Localization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) k)))) ≫
        Spec.map ((MvPolynomial.uniqueAlgEquiv k (Fin 1)).symm.toRingEquiv.toCommRingCatIso.hom) ≫
        jP) ℓ hℓk _ htor 2 le_rfl
    exact ⟨fun a b => (h a).trans (h b).symm⟩
  refine ⟨(Nat.card_congr E0).symm.trans h0A, (Nat.card_congr E1).symm, ?_⟩
  exact E2.symm.subsingleton

theorem wc_et_line_origin_supp_ext_card : ∀ (k : Type u) [Field k] [IsAlgClosed k] (ℓ : ℕ), ℓ.Prime → (ℓ : k) ≠ 0 → ∀ (U : (Spec (.of (MvPolynomial (Fin 1) k))).Opens), (U : Set (Spec (.of (MvPolynomial (Fin 1) k)))) = (Set.range (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin 1) k →+* k))))ᶜ → Nat.card (wcEtCoh U ℓ 0) = ℓ → Nat.card (wcEtCoh U ℓ 1) = ℓ → Subsingleton (wcEtCoh U ℓ 2) → ∀ (D0 : wcEtPullData (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin 1) k →+* k))) ℓ), Subsingleton (wcEtSuppExt D0 1) ∧ Subsingleton (wcEtSuppExt D0 3) ∧ Finite (wcEtSuppExt D0 2) ∧ Nat.card (wcEtSuppExt D0 2) = ℓ :=
by
  intro k _ _ ℓ hℓ hℓk U hU h0 h1 h2 D0
  classical
  haveI hfact : Fact (Nat.Prime ℓ) := ⟨hℓ⟩
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (Spec (.of (MvPolynomial (Fin 1) k))) ℓ)) :=
    HasExt.standard _

  have hopK : Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin 1) k →+* k)) ≫
      Spec.map (CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial (Fin 1) k)) = 𝟙 _ := by
    rw [← Spec.map_comp, ← Spec.map_id]
    congr 1
    ext x
    simp
  obtain ⟨hepi, ⟨eK⟩⟩ := wc_et_point_supp_unit_map_epi_ker k
    (Spec (.of (MvPolynomial (Fin 1) k)))
    (Spec.map (CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial (Fin 1) k))) ℓ
    (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin 1) k →+* k)))
    hopK D0
  have eU : Nonempty ((SheafOfModules.toSheaf (wcEtZModRing (Spec (.of (MvPolynomial (Fin 1) k))) ℓ)).obj
      (Limits.kernel (wcEtSuppUnitMap D0)) ≅
      wcEtExtZero (Spec (.of (MvPolynomial (Fin 1) k)))
        (U : Set (Spec (.of (MvPolynomial (Fin 1) k)))) ℓ) := by
    rw [hU]; exact ⟨eK⟩
  have hE := wc_et_extzero_module_ext_open_coh (Spec (.of (MvPolynomial (Fin 1) k))) U ℓ hℓ.pos
    (Limits.kernel (wcEtSuppUnitMap D0)) eU

  let g := wcEtSuppUnitMap D0
  let S := ShortComplex.mk (Limits.kernel.ι g) g (Limits.kernel.condition g)
  have hS : S.ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel g) inferInstance hepi
  let Λ := SheafOfModules.unit (wcEtZModRing (Spec (.of (MvPolynomial (Fin 1) k))) ℓ)

  have hK0 : Nat.card (Abelian.Ext S.X₁ Λ 0) = ℓ := by
    obtain ⟨e⟩ := hE 0
    exact (Nat.card_congr e).trans h0
  have hK1 : Nat.card (Abelian.Ext S.X₁ Λ 1) = ℓ := by
    obtain ⟨e⟩ := hE 1
    exact (Nat.card_congr e).trans h1
  have hK2 : Subsingleton (Abelian.Ext S.X₁ Λ 2) := by
    obtain ⟨e⟩ := hE 2
    haveI := h2
    exact e.subsingleton

  have hA := wc_et_algclosed_affine_line_acyclic k ℓ hℓ hℓk
  let eR := (MvPolynomial.uniqueAlgEquiv k (Fin 1)).toRingEquiv.toCommRingCatIso
  have hBeq : ∀ q, Nonempty (Abelian.Ext S.X₂ Λ q ≃ wcEtCoh (Spec (.of (Polynomial k))) ℓ q) := by
    intro q
    obtain ⟨e1⟩ := wc_et_zmodext_coh_equiv (Spec (.of (MvPolynomial (Fin 1) k))) ℓ q
    obtain ⟨e2⟩ := wc_et_coh_iso_invariance (Spec.map eR.hom) ℓ q
    exact ⟨e1.trans e2⟩
  have hB0 : Nat.card (Abelian.Ext S.X₂ Λ 0) = ℓ := by
    obtain ⟨e⟩ := hBeq 0
    exact (Nat.card_congr e).trans hA.1
  have hBq : ∀ q, 1 ≤ q → Subsingleton (Abelian.Ext S.X₂ Λ q) := by
    intro q hq
    obtain ⟨e⟩ := hBeq q
    haveI := hA.2 q hq
    exact e.subsingleton

  have hδ : ∀ (n m : ℕ) (h : 1 + n = m), Subsingleton (Abelian.Ext S.X₂ Λ n) →
      Subsingleton (Abelian.Ext S.X₂ Λ m) →
      Function.Bijective (fun y : Abelian.Ext S.X₁ Λ n => hS.extClass.comp y h) := by
    intro n m h hn hm
    constructor
    · intro y₁ y₂ hy
      have hy' : hS.extClass.comp y₁ h = hS.extClass.comp y₂ h := hy
      have hsub : hS.extClass.comp (y₁ - y₂) h = 0 := by
        let δh : Abelian.Ext S.X₁ Λ n →+ Abelian.Ext S.X₃ Λ m :=
          AddMonoidHom.mk' (fun y => hS.extClass.comp y h)
            (fun a b => by rw [Abelian.Ext.comp_add])
        change δh (y₁ - y₂) = 0
        rw [map_sub]
        change hS.extClass.comp y₁ h - hS.extClass.comp y₂ h = 0
        rw [hy', sub_self]
      obtain ⟨x₂, hx₂⟩ := Abelian.Ext.contravariant_sequence_exact₁ hS Λ (y₁ - y₂) h hsub
      have hx0 : x₂ = 0 := Subsingleton.elim _ _
      rw [hx0, Abelian.Ext.comp_zero] at hx₂
      exact sub_eq_zero.mp hx₂.symm
    · intro x₃
      obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS Λ x₃
        (Subsingleton.elim _ _) h
      exact ⟨x₁, hx₁⟩

  have hE1 : Subsingleton (wcEtSuppExt D0 1) := by
    let φ₀ : Abelian.Ext S.X₂ Λ 0 →+ Abelian.Ext S.X₁ Λ 0 :=
      AddMonoidHom.mk' (fun z => (Abelian.Ext.mk₀ S.f).comp z (zero_add 0))
        (fun a b => by rw [Abelian.Ext.comp_add])
    have hne : φ₀ (Abelian.Ext.mk₀ (𝟙 S.X₂)) ≠ 0 := by
      intro h0'
      change (Abelian.Ext.mk₀ S.f).comp (Abelian.Ext.mk₀ (𝟙 S.X₂)) (zero_add 0) = 0 at h0'
      rw [Abelian.Ext.mk₀_comp_mk₀, Category.comp_id] at h0'
      have h0'' : Abelian.Ext.mk₀ S.f = Abelian.Ext.mk₀ (0 : S.X₁ ⟶ S.X₂) := by
        rw [Abelian.Ext.mk₀_zero]; exact h0'
      have hf0 : S.f = 0 := (Abelian.Ext.mk₀_bijective _ _).1 h0''
      have hmono : Mono S.f := hS.mono_f
      rw [hf0] at hmono
      have hZ : Limits.IsZero S.X₁ := Limits.IsZero.of_mono_zero S.X₁ S.X₂
      haveI hsub : Subsingleton (Abelian.Ext S.X₁ Λ 0) :=
        ⟨fun a b => Abelian.Ext.homEquiv₀.injective (hZ.eq_of_src _ _)⟩
      have hc1 : Nat.card (Abelian.Ext S.X₁ Λ 0) = 1 :=
        Nat.card_eq_one_iff_unique.mpr ⟨hsub, ⟨0⟩⟩
      have := hℓ.two_le
      omega
    have hφinj : Function.Injective φ₀ := by
      haveI : Fact (Nat.card (Abelian.Ext S.X₂ Λ 0)).Prime := ⟨by rw [hB0]; exact hℓ⟩
      rcases AddSubgroup.eq_bot_or_eq_top_of_prime_card φ₀.ker with hk | hk
      · exact (AddMonoidHom.ker_eq_bot_iff φ₀).mp hk
      · exfalso
        apply hne
        rw [← AddMonoidHom.mem_ker, hk]
        exact AddSubgroup.mem_top _
    haveI : Finite (Abelian.Ext S.X₁ Λ 0) :=
      Nat.finite_of_card_ne_zero (by rw [hK0]; exact hℓ.ne_zero)
    have hφsurj : Function.Surjective φ₀ :=
      (hφinj.bijective_of_nat_card_le (by rw [hK0, hB0])).2
    have hz : ∀ x : Abelian.Ext S.X₃ Λ 1, x = 0 := by
      intro x
      haveI := hBq 1 le_rfl
      obtain ⟨y, hy⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS Λ x
        (Subsingleton.elim _ _) (n₀ := 0) (by norm_num)
      obtain ⟨z, rfl⟩ := hφsurj y
      rw [← hy]
      change hS.extClass.comp ((Abelian.Ext.mk₀ S.f).comp z (zero_add 0)) _ = 0
      rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, hS.extClass_comp, Abelian.Ext.zero_comp]
    exact ⟨fun a b => (hz a).trans (hz b).symm⟩

  have hb1 := hδ 1 2 rfl (hBq 1 le_rfl) (hBq 2 (by norm_num))
  have hb2 := hδ 2 3 rfl (hBq 2 (by norm_num)) (hBq 3 (by norm_num))
  haveI : Finite (Abelian.Ext S.X₁ Λ 1) :=
    Nat.finite_of_card_ne_zero (by rw [hK1]; exact hℓ.ne_zero)
  haveI := hK2
  refine ⟨hE1, ?_, ?_, ?_⟩
  · exact hb2.2.subsingleton
  · exact Finite.of_surjective _ hb1.2
  · exact (Nat.card_eq_of_bijective _ hb1).symm.trans hK1

theorem wc_et_remove_point_coh_step : ∀ (K : Type u) [Field K] [IsAlgClosed K] (X : Scheme.{u}) (f : X ⟶ Spec (.of K)) [IsSeparated f] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (x₀ : Spec (.of K) ⟶ X), x₀ ≫ f = 𝟙 _ → ∀ (Dx : wcEtPullData x₀ ℓ), Subsingleton (wcEtSuppExt Dx 1) → Subsingleton (wcEtSuppExt Dx 3) → Finite (wcEtSuppExt Dx 2) → Nat.card (wcEtSuppExt Dx 2) = ℓ → ∀ (W : X.Opens), (W : Set X) = (Set.range x₀)ᶜ → Finite (wcEtCoh X ℓ 1) → Finite (wcEtCoh X ℓ 2) → Finite (wcEtCoh W ℓ 1) ∧ Finite (wcEtCoh W ℓ 2) ∧ Nat.card (wcEtCoh W ℓ 1) * Nat.card (wcEtCoh X ℓ 2) = Nat.card (wcEtCoh X ℓ 1) * Nat.card (wcEtCoh W ℓ 2) * ℓ :=
by
  intro K _ _ X f _ ℓ _ x₀ hx₀ Dx p1 p3 pf pc W hW hf1 hf2
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing X ℓ)) := HasExt.standard _
  have hℓpos : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos

  have key : ∀ (S : ShortComplex (SheafOfModules.{u+1} (wcEtZModRing X ℓ))) (hS : S.ShortExact)
      (P : SheafOfModules.{u+1} (wcEtZModRing X ℓ)),
      Subsingleton (Abelian.Ext S.X₃ P 1) → Subsingleton (Abelian.Ext S.X₃ P 3) →
      Finite (Abelian.Ext S.X₂ P 1) → Finite (Abelian.Ext S.X₃ P 2) → Finite (Abelian.Ext S.X₂ P 2) →
      Finite (Abelian.Ext S.X₁ P 1) ∧ Finite (Abelian.Ext S.X₁ P 2) ∧
        Nat.card (Abelian.Ext S.X₁ P 1) * Nat.card (Abelian.Ext S.X₂ P 2) =
          Nat.card (Abelian.Ext S.X₂ P 1) * Nat.card (Abelian.Ext S.X₃ P 2) *
            Nat.card (Abelian.Ext S.X₁ P 2) := by
    intro S hS P q1 q3 i1 i3 i4
    let f₁ := (Abelian.Ext.mk₀ S.f).precomp P (zero_add 1)
    let f₂ := hS.extClass.precomp P (show 1 + 1 = 2 from rfl)
    let f₃ := (Abelian.Ext.mk₀ S.g).precomp P (zero_add 2)
    let f₄ := (Abelian.Ext.mk₀ S.f).precomp P (zero_add 2)
    have hp : ∀ {A B : SheafOfModules.{u+1} (wcEtZModRing X ℓ)} {n a b : ℕ}
        (α : Abelian.Ext A B n) (h : n + a = b) (β : Abelian.Ext B P a),
        α.precomp P h β = α.comp β h := fun _ _ _ => rfl
    have hf₁ : Function.Injective f₁ := by
      rw [injective_iff_map_eq_zero]
      intro y hy
      rw [hp] at hy
      obtain ⟨x, rfl⟩ := Abelian.Ext.contravariant_sequence_exact₂ hS P y hy
      rw [Subsingleton.elim x 0, Abelian.Ext.comp_zero]
    have h₂ : f₂.ker = f₁.range := by
      ext y
      simp only [f₁, f₂, AddMonoidHom.mem_ker, AddMonoidHom.mem_range, hp]
      constructor
      · intro hy
        exact Abelian.Ext.contravariant_sequence_exact₁ hS P y _ hy
      · rintro ⟨z, rfl⟩
        rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, hS.extClass_comp, Abelian.Ext.zero_comp]
    have h₃ : f₃.ker = f₂.range := by
      ext y
      simp only [f₂, f₃, AddMonoidHom.mem_ker, AddMonoidHom.mem_range, hp]
      constructor
      · intro hy
        exact Abelian.Ext.contravariant_sequence_exact₃ hS P y hy _
      · rintro ⟨z, rfl⟩
        rw [← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ S.g) hS.extClass z (zero_add 1)
          (show 1 + 1 = 2 from rfl) (show 0 + 1 + 1 = 2 from rfl),
          hS.comp_extClass, Abelian.Ext.zero_comp]
    have h₄ : f₄.ker = f₃.range := by
      ext y
      simp only [f₃, f₄, AddMonoidHom.mem_ker, AddMonoidHom.mem_range, hp]
      constructor
      · intro hy
        exact Abelian.Ext.contravariant_sequence_exact₂ hS P y hy
      · rintro ⟨z, rfl⟩
        rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀, S.zero,
          Abelian.Ext.mk₀_zero, Abelian.Ext.zero_comp]
    have hf₄ : Function.Surjective f₄ := by
      intro y
      have h0 : hS.extClass.comp y (show 1 + 2 = 3 from rfl) = 0 := Subsingleton.elim _ _
      obtain ⟨x, hx⟩ := Abelian.Ext.contravariant_sequence_exact₁ hS P y _ h0
      exact ⟨x, by rw [hp]; exact hx⟩
    have hA5 : Finite (Abelian.Ext S.X₁ P 2) := Finite.of_surjective f₄ hf₄
    have e1 : Nat.card (Abelian.Ext S.X₂ P 1) = Nat.card f₁.range :=
      Nat.card_congr (AddMonoidHom.ofInjective hf₁).toEquiv
    have c2 : Nat.card (Abelian.Ext S.X₁ P 1) =
        Nat.card (Abelian.Ext S.X₂ P 1) * Nat.card f₂.range := by
      rw [← AddSubgroup.card_mul_index f₂.ker, AddSubgroup.index_ker, h₂, e1]
    have c3 : Nat.card (Abelian.Ext S.X₃ P 2) = Nat.card f₂.range * Nat.card f₃.range := by
      rw [← AddSubgroup.card_mul_index f₃.ker, AddSubgroup.index_ker, h₃]
    have c4 : Nat.card (Abelian.Ext S.X₂ P 2) =
        Nat.card f₃.range * Nat.card (Abelian.Ext S.X₁ P 2) := by
      rw [← AddSubgroup.card_mul_index f₄.ker, AddSubgroup.index_ker, h₄,
        AddMonoidHom.range_eq_top.mpr hf₄, AddSubgroup.card_top]
    have hpos1 : 0 < Nat.card (Abelian.Ext S.X₂ P 1) := Nat.card_pos
    have hpos2 : 0 < Nat.card f₂.range := Nat.card_pos
    refine ⟨Nat.finite_of_card_ne_zero (by rw [c2]; positivity), hA5, ?_⟩
    rw [c2, c3, c4]
    ring

  obtain ⟨hepi, ⟨eN⟩⟩ := wc_et_point_supp_unit_map_epi_ker K X f ℓ x₀ hx₀ Dx
  rw [← hW] at eN
  have hS : (ShortComplex.mk (Limits.kernel.ι (wcEtSuppUnitMap Dx)) (wcEtSuppUnitMap Dx)
      (Limits.kernel.condition (wcEtSuppUnitMap Dx))).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel (wcEtSuppUnitMap Dx)) inferInstance hepi
  obtain ⟨eW1⟩ := wc_et_extzero_module_ext_open_coh X W ℓ hℓpos
    (Limits.kernel (wcEtSuppUnitMap Dx)) ⟨eN⟩ 1
  obtain ⟨eW2⟩ := wc_et_extzero_module_ext_open_coh X W ℓ hℓpos
    (Limits.kernel (wcEtSuppUnitMap Dx)) ⟨eN⟩ 2
  obtain ⟨eX1⟩ := wc_et_zmodext_coh_equiv X ℓ 1
  obtain ⟨eX2⟩ := wc_et_zmodext_coh_equiv X ℓ 2
  haveI iX1 : Finite (wcEtZModExt X ℓ 1) := Finite.of_equiv _ eX1.symm
  haveI iX2 : Finite (wcEtZModExt X ℓ 2) := Finite.of_equiv _ eX2.symm
  obtain ⟨hW1, hW2, hc⟩ := key _ hS (SheafOfModules.unit (wcEtZModRing X ℓ)) p1 p3 iX1 pf iX2
  haveI := hW1
  haveI := hW2
  refine ⟨Finite.of_equiv _ eW1, Finite.of_equiv _ eW2, ?_⟩
  have hc' : Nat.card (wcEtCoh W ℓ 1) * Nat.card (wcEtCoh X ℓ 2) =
      Nat.card (wcEtCoh X ℓ 1) * Nat.card (wcEtSuppExt Dx 2) * Nat.card (wcEtCoh W ℓ 2) := by
    rw [← Nat.card_congr eW1, ← Nat.card_congr eW2, ← Nat.card_congr eX1, ← Nat.card_congr eX2]
    exact hc
  rw [hc', pc]
  ring

theorem wc_curve_remove_finite_points_card : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of K)) [LocallyOfFiniteType fY], (∀ (W : Y.Opens) (x₀ : Spec (.of K) ⟶ (W : Scheme.{u})) (W' : (W : Scheme.{u}).Opens), x₀ ≫ W.ι ≫ fY = 𝟙 _ → (W' : Set ↥(W : Scheme.{u})) = (Set.range x₀)ᶜ → Finite (wcEtCoh W ℓ 1) → Finite (wcEtCoh W ℓ 2) → Finite (wcEtCoh W' ℓ 1) ∧ Finite (wcEtCoh W' ℓ 2) ∧ Nat.card (wcEtCoh W' ℓ 1) * Nat.card (wcEtCoh W ℓ 2) = Nat.card (wcEtCoh W ℓ 1) * Nat.card (wcEtCoh W' ℓ 2) * ℓ) → Finite (wcEtCoh Y ℓ 1) → Finite (wcEtCoh Y ℓ 2) → ∀ (S : Set Y), S.Finite → (∀ y ∈ S, IsClosed ({y} : Set Y)) → ∀ (V : Y.Opens), (V : Set Y) = Sᶜ → Finite (wcEtCoh V ℓ 1) ∧ Finite (wcEtCoh V ℓ 2) ∧ Nat.card (wcEtCoh V ℓ 1) * Nat.card (wcEtCoh Y ℓ 2) = Nat.card (wcEtCoh Y ℓ 1) * Nat.card (wcEtCoh V ℓ 2) * ℓ ^ Nat.card ↥S :=
by
  classical
  intro K _ _ ℓ Y fY _ hstep hY1 hY2 S hS hcl V hV


  have hsec : ∀ (Z : Scheme.{u}) (f : Z ⟶ Spec (.of K)) [LocallyOfFiniteType f] (y : Z),
      IsClosed ({y} : Set Z) →
      ∃ y₀ : Spec (.of K) ⟶ Z, y₀ ≫ f = 𝟙 _ ∧ y₀ (IsLocalRing.closedPoint K) = y := by
    intro Z f _ y hy
    haveI : JacobsonSpace Z := LocallyOfFiniteType.jacobsonSpace f
    haveI hι : LocallyOfFiniteType (Z.fromSpecResidueField y) :=
      (isClosed_singleton_iff_locallyOfFiniteType).mp hy
    haveI hg : LocallyOfFiniteType (Z.fromSpecResidueField y ≫ f) := inferInstance
    let φ : CommRingCat.of K ⟶ Z.residueField y := Spec.preimage (Z.fromSpecResidueField y ≫ f)
    have hφg : Spec.map φ = Z.fromSpecResidueField y ≫ f := Spec.map_preimage _
    have hft : φ.hom.FiniteType := by
      have : LocallyOfFiniteType (Spec.map φ) := by rw [hφg]; exact hg
      exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp this
    letI : Algebra K (Z.residueField y) := φ.hom.toAlgebra
    haveI : Algebra.FiniteType K (Z.residueField y) := hft
    haveI : Module.Finite K (Z.residueField y) :=
      finite_of_finite_type_of_isJacobsonRing K (Z.residueField y)
    haveI : Algebra.IsIntegral K (Z.residueField y) := Algebra.IsIntegral.of_finite K _
    have hbij : Function.Bijective φ.hom :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral (k := K) (K := Z.residueField y)
    let e : K ≃+* Z.residueField y := RingEquiv.ofBijective φ.hom hbij
    let ψ : Z.residueField y ⟶ CommRingCat.of K :=
      CommRingCat.ofHom (e.symm : Z.residueField y →+* K)
    have hφψ : φ ≫ ψ = 𝟙 _ := by
      ext x
      change e.symm (φ.hom x) = x
      exact e.symm_apply_apply x
    refine ⟨Spec.map ψ ≫ Z.fromSpecResidueField y, ?_, ?_⟩
    · rw [Category.assoc, ← hφg, ← Spec.map_comp, hφψ, Spec.map_id]
    · exact Scheme.fromSpecResidueField_apply y _

  have htr : ∀ {X : Scheme.{u}} (f : X ⟶ Y) [IsOpenImmersion f] (O : Y.Opens),
      Set.range f = (O : Set Y) → ∀ q : ℕ, Nonempty (wcEtCoh O ℓ q ≃ wcEtCoh X ℓ q) := by
    intro X f _ O h q
    exact wc_et_coh_iso_invariance
      (IsOpenImmersion.isoOfRangeEq f O.ι (h.trans (Scheme.Opens.range_ι O).symm)).hom ℓ q

  have hpos : ∀ (Z : Scheme.{u}) (q : ℕ), Finite (wcEtCoh Z ℓ q) →
      0 < Nat.card (wcEtCoh Z ℓ q) := by
    intro Z q _
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) := HasExt.standard _
    haveI : Nonempty (wcEtCoh Z ℓ q) :=
      ⟨(0 : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} ℤ)))
        ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) q)⟩
    exact Nat.card_pos

  have hone : ∀ (s : Set Y) (a : Y), a ∉ s → IsClosed ({a} : Set Y) → ∀ (W O : Y.Opens),
      (W : Set Y) = sᶜ → (O : Set Y) = (insert a s)ᶜ →
      Finite (wcEtCoh W ℓ 1) → Finite (wcEtCoh W ℓ 2) →
      Finite (wcEtCoh O ℓ 1) ∧ Finite (wcEtCoh O ℓ 2) ∧
        Nat.card (wcEtCoh O ℓ 1) * Nat.card (wcEtCoh W ℓ 2) =
          Nat.card (wcEtCoh W ℓ 1) * Nat.card (wcEtCoh O ℓ 2) * ℓ := by
    intro s a has ha W O hW hO hf1 hf2
    have haW : a ∈ (W : Set Y) := by rw [hW]; exact has
    have hinj : Function.Injective W.ι := W.ι.isOpenEmbedding.injective
    have hWs : ∀ w : ↥(W : Scheme.{u}), W.ι w ∉ s := by
      intro w
      have h2 : W.ι w ∈ (W : Set Y) := by
        rw [← Scheme.Opens.range_ι W]; exact ⟨w, rfl⟩
      rw [hW] at h2
      exact h2
    obtain ⟨w₀, hιw0⟩ : ∃ w₀ : ↥(W : Scheme.{u}), W.ι w₀ = a := by
      rw [← Set.mem_range, Scheme.Opens.range_ι W]; exact haW
    have hw₀ : IsClosed ({w₀} : Set ↥(W : Scheme.{u})) := by
      have heq : ({w₀} : Set ↥(W : Scheme.{u})) = W.ι ⁻¹' {a} := by
        ext w
        simp only [Set.mem_singleton_iff, Set.mem_preimage]
        constructor
        · rintro rfl; exact hιw0
        · intro h; exact hinj (h.trans hιw0.symm)
      rw [heq]
      exact ha.preimage W.ι.continuous
    obtain ⟨x₀, hx₀, hx₀w⟩ := hsec (W : Scheme.{u}) (W.ι ≫ fY) w₀ hw₀
    have hrange : Set.range x₀ = {w₀} := by
      ext w
      rw [Set.mem_range, Set.mem_singleton_iff]
      constructor
      · rintro ⟨p, rfl⟩
        rw [Subsingleton.elim p (IsLocalRing.closedPoint K)]
        exact hx₀w
      · rintro rfl
        exact ⟨_, hx₀w⟩
    obtain ⟨W', hW'def⟩ : ∃ W' : (W : Scheme.{u}).Opens, W' = W.ι ⁻¹ᵁ O := ⟨_, rfl⟩
    have hW' : (W' : Set ↥(W : Scheme.{u})) = (Set.range x₀)ᶜ := by
      rw [hrange, hW'def, Scheme.Hom.coe_preimage]
      ext w
      rw [Set.mem_preimage, hO]
      simp only [Set.mem_compl_iff, Set.mem_insert_iff, Set.mem_singleton_iff, not_or]
      constructor
      · rintro ⟨h1, -⟩ hw
        exact h1 (by rw [hw]; exact hιw0)
      · intro h
        exact ⟨fun h' => h (hinj (h'.trans hιw0.symm)), hWs w⟩
    obtain ⟨g1, g2, geq⟩ := hstep W x₀ W' hx₀ hW' hf1 hf2
    have hr : Set.range (W'.ι ≫ W.ι) = (O : Set Y) := by
      have hcomp : ⇑(W'.ι ≫ W.ι) = ⇑W.ι ∘ ⇑W'.ι :=
        funext fun x => Scheme.Hom.comp_apply _ _ x
      rw [hcomp, Set.range_comp, Scheme.Opens.range_ι, hW', hrange]
      ext y
      rw [hO, Set.mem_image]
      simp only [Set.mem_compl_iff, Set.mem_insert_iff, Set.mem_singleton_iff, not_or]
      constructor
      · rintro ⟨w, hw, rfl⟩
        exact ⟨fun h => hw (hinj (h.trans hιw0.symm)), hWs w⟩
      · rintro ⟨hya, hys⟩
        have hyW : y ∈ (W : Set Y) := by rw [hW]; exact hys
        rw [← Scheme.Opens.range_ι W] at hyW
        obtain ⟨w, rfl⟩ := hyW
        exact ⟨w, fun h => hya (by rw [h]; exact hιw0), rfl⟩
    obtain ⟨E1⟩ := htr (W'.ι ≫ W.ι) O hr 1
    obtain ⟨E2⟩ := htr (W'.ι ≫ W.ι) O hr 2
    refine ⟨Finite.of_equiv _ E1.symm, Finite.of_equiv _ E2.symm, ?_⟩
    rw [Nat.card_congr E1, Nat.card_congr E2]
    exact geq

  have main : ∀ (T : Set Y), T.Finite → (∀ y ∈ T, IsClosed ({y} : Set Y)) → ∀ (O : Y.Opens),
      (O : Set Y) = Tᶜ → Finite (wcEtCoh O ℓ 1) ∧ Finite (wcEtCoh O ℓ 2) ∧
        Nat.card (wcEtCoh O ℓ 1) * Nat.card (wcEtCoh Y ℓ 2) =
          Nat.card (wcEtCoh Y ℓ 1) * Nat.card (wcEtCoh O ℓ 2) * ℓ ^ Nat.card ↥T := by
    intro T hT
    induction T, hT using Set.Finite.induction_on with
    | empty =>
      intro _ O hO
      have hr : Set.range (𝟙 Y : Y ⟶ Y) = (O : Set Y) := by
        rw [hO, Set.compl_empty]
        exact Set.range_eq_univ.mpr (fun y => ⟨y, by first | rfl | simp⟩)
      obtain ⟨E1⟩ := htr (𝟙 Y) O hr 1
      obtain ⟨E2⟩ := htr (𝟙 Y) O hr 2
      refine ⟨Finite.of_equiv _ E1.symm, Finite.of_equiv _ E2.symm, ?_⟩
      rw [Nat.card_congr E1, Nat.card_congr E2]
      simp
    | @insert a s has hs ih =>
      intro hcl' O hO
      have hsc : IsClosed s := by
        have h := hs.isClosed_biUnion (f := fun y => ({y} : Set Y))
          (fun y hy => hcl' y (Set.mem_insert_of_mem _ hy))
        rwa [Set.biUnion_of_singleton] at h
      let W : Y.Opens := ⟨sᶜ, hsc.isOpen_compl⟩
      obtain ⟨b1, b2, hb⟩ := ih (fun y hy => hcl' y (Set.mem_insert_of_mem _ hy)) W rfl
      obtain ⟨c1, c2, hc⟩ := hone s a has (hcl' a (Set.mem_insert _ _)) W O rfl hO b1 b2
      have hpos2 := hpos W 2 b2
      have hcard : Nat.card ↥(insert a s) = Nat.card ↥s + 1 := by
        rw [Nat.card_coe_set_eq, Nat.card_coe_set_eq, Set.ncard_insert_of_notMem has hs]
      refine ⟨c1, c2, ?_⟩
      rw [hcard]
      apply Nat.eq_of_mul_eq_mul_left hpos2
      calc Nat.card (wcEtCoh W ℓ 2) * (Nat.card (wcEtCoh O ℓ 1) * Nat.card (wcEtCoh Y ℓ 2))
          = (Nat.card (wcEtCoh O ℓ 1) * Nat.card (wcEtCoh W ℓ 2)) * Nat.card (wcEtCoh Y ℓ 2) := by
            ring
        _ = (Nat.card (wcEtCoh W ℓ 1) * Nat.card (wcEtCoh O ℓ 2) * ℓ) *
              Nat.card (wcEtCoh Y ℓ 2) := by rw [hc]
        _ = Nat.card (wcEtCoh O ℓ 2) * ℓ *
              (Nat.card (wcEtCoh W ℓ 1) * Nat.card (wcEtCoh Y ℓ 2)) := by ring
        _ = Nat.card (wcEtCoh O ℓ 2) * ℓ *
              (Nat.card (wcEtCoh Y ℓ 1) * Nat.card (wcEtCoh W ℓ 2) * ℓ ^ Nat.card ↥s) := by
            rw [hb]
        _ = Nat.card (wcEtCoh W ℓ 2) *
              (Nat.card (wcEtCoh Y ℓ 1) * Nat.card (wcEtCoh O ℓ 2) * ℓ ^ (Nat.card ↥s + 1)) := by
            ring
  exact main S hS hcl V hV

theorem wc_smooth_rational_point_etale_chart : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) (d : ℕ) [SmoothOfRelativeDimension d f] (y₀ : Spec (.of K) ⟶ Y), y₀ ≫ f = 𝟙 _ → ∃ (V : Scheme.{u}) (ι : V ⟶ Y) (_ : IsOpenImmersion ι) (v₀ : Spec (.of K) ⟶ V) (φ : V ⟶ Spec (.of (MvPolynomial (Fin d) K))), v₀ ≫ ι = y₀ ∧ Etale φ ∧ v₀ ≫ φ = Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin d) K →+* K)) ∧ ∀ v : V, φ v = (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin d) K →+* K))) (IsLocalRing.closedPoint K) → v = v₀ (IsLocalRing.closedPoint K) :=
by
  intro K _ _ Y f d _ y₀ hy₀
  classical
  have hsub : ∀ p q : Spec (.of K), p = q := fun _ _ => Subsingleton.elim _ _
  obtain ⟨U, hU, W, hW, hyW, e, hsm⟩ :=
    SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := d) (f := f)
      (y₀ (IsLocalRing.closedPoint K))
  have hUtop : U = ⊤ := by
    apply TopologicalSpace.Opens.ext
    ext p
    simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
    have : f (y₀ (IsLocalRing.closedPoint K)) ∈ U := e hyW
    rw [hsub p (f (y₀ (IsLocalRing.closedPoint K)))]
    exact this
  subst hUtop
  obtain ⟨g₀, hg₀C, hg₀⟩ := hsm.exists_etale_mvPolynomial
  let κ : CommRingCat.of K ⟶ Γ(Spec (.of K), ⊤) := (Scheme.ΓSpecIso (.of K)).inv
  have hκbij : Function.Bijective κ.hom :=
    (Scheme.ΓSpecIso (.of K)).symm.commRingCatIsoToRingEquiv.bijective
  let m : MvPolynomial (Fin d) K →+* MvPolynomial (Fin d) Γ(Spec (.of K), ⊤) :=
    MvPolynomial.map κ.hom
  have hm : m.Etale := RingHom.Etale.of_bijective
    ⟨MvPolynomial.map_injective _ hκbij.1, MvPolynomial.map_surjective _ hκbij.2⟩
  let g : MvPolynomial (Fin d) K →+* Γ(Y, W) := g₀.comp m
  have hg : g.Etale := RingHom.Etale.stableUnderComposition m g₀ hm hg₀
  have hgC : ∀ r : K, g (MvPolynomial.C r) = (f.appLE ⊤ W e).hom (κ.hom r) := by
    intro r
    show g₀ (MvPolynomial.map κ.hom (MvPolynomial.C r)) = _
    rw [MvPolynomial.map_C, ← hg₀C]
    rfl
  haveI := hW.isOpenImmersion_fromSpec
  have hrange : Set.range y₀ ⊆ Set.range hW.fromSpec := by
    rw [hW.range_fromSpec]
    rintro _ ⟨p, rfl⟩
    rw [hsub p (IsLocalRing.closedPoint K)]
    exact hyW
  let w := IsOpenImmersion.lift hW.fromSpec y₀ hrange
  have hw : w ≫ hW.fromSpec = y₀ := IsOpenImmersion.lift_fac _ _ _
  let ψ : Γ(Y, W) ⟶ CommRingCat.of K := Spec.preimage w
  have hψ : Spec.map ψ = w := Spec.map_preimage w
  have hUfs : hU.fromSpec = Spec.map κ :=
    (IsAffineOpen.fromSpec_top).trans (Scheme.isoSpec_Spec_inv _)
  have hsq := IsAffineOpen.SpecMap_appLE_fromSpec f hU hW e
  have hsec : κ ≫ f.appLE ⊤ W e ≫ ψ = 𝟙 _ := by
    apply Spec.map_injective
    rw [Spec.map_comp, Spec.map_comp, hψ, ← hUfs, Category.assoc, hsq, ← Category.assoc, hw,
      hy₀, Spec.map_id]
  have hψgC : ∀ r : K, ψ.hom (g (MvPolynomial.C r)) = r := by
    intro r
    rw [hgC]
    have := congrArg (fun φ => φ.hom r) hsec
    simpa using this
  let a : Fin d → K := fun i => ψ.hom (g (MvPolynomial.X i))
  let τ : MvPolynomial (Fin d) K →ₐ[K] MvPolynomial (Fin d) K :=
    MvPolynomial.aeval (fun i => MvPolynomial.X i - MvPolynomial.C (a i))
  let τ' : MvPolynomial (Fin d) K →ₐ[K] MvPolynomial (Fin d) K :=
    MvPolynomial.aeval (fun i => MvPolynomial.X i + MvPolynomial.C (a i))
  have h1 : τ.comp τ' = AlgHom.id K _ := by
    apply MvPolynomial.algHom_ext
    intro i
    simp [τ, τ']
  have h2 : τ'.comp τ = AlgHom.id K _ := by
    apply MvPolynomial.algHom_ext
    intro i
    simp [τ, τ']
  have hτbij : Function.Bijective τ := by
    refine Function.bijective_iff_has_inverse.mpr ⟨τ', fun p => ?_, fun p => ?_⟩
    · exact AlgHom.congr_fun h2 p
    · exact AlgHom.congr_fun h1 p
  have hτ : (τ.toRingHom : MvPolynomial (Fin d) K →+* _).Etale := RingHom.Etale.of_bijective hτbij
  let g' : MvPolynomial (Fin d) K →+* Γ(Y, W) := g.comp τ.toRingHom
  have hg' : g'.Etale := RingHom.Etale.stableUnderComposition _ _ hτ hg
  have hψg' : ψ.hom.comp g' = MvPolynomial.constantCoeff := by
    apply MvPolynomial.ringHom_ext
    · intro r
      simp [g', τ, hψgC]
    · intro i
      simp [g', τ, a, hψgC]
  let φ₁ : Spec Γ(Y, W) ⟶ Spec (.of (MvPolynomial (Fin d) K)) := Spec.map (CommRingCat.ofHom g')
  haveI hφ₁ : Etale φ₁ := (HasRingHomProperty.Spec_iff (P := @Etale)).mpr hg'
  have hwφ : w ≫ φ₁ = Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff : MvPolynomial (Fin d) K →+* K)) := by
    rw [← hψ, ← Spec.map_comp, ← hψg']
    rfl
  obtain ⟨U', hwU', hiso⟩ : ∃ U' : (Spec Γ(Y, W)).Opens, w (IsLocalRing.closedPoint K) ∈ U' ∧
