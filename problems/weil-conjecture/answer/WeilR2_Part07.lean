theorem wc_cg2ard_open_etale_localized : ∀ {N X : Scheme.{u}} (ν : N ⟶ X) [IsAffineHom ν] (U : X.Opens) (hU : IsAffineOpen U) (W : X.Opens), Etale (ν ∣_ W) → ∀ Q₀ : PrimeSpectrum Γ(X, U), hU.fromSpec Q₀ ∈ W → wcCg2LocEtale (ν.app U).hom Q₀.asIdeal.primeCompl :=
by

  have s4 : ∀ {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S) (r : R) (Q : Ideal R)
      [Q.IsPrime], r ∉ Q → ((algebraMap S (Localization.Away (φ r))).comp φ).Etale →
      wcCg2LocEtale φ Q.primeCompl := by
    intro R S _ _ φ r Q _ hr hf
    let T := Localization.Away (φ r)
    let M := Q.primeCompl
    let Sₘ := Localization (M.map φ)
    have hle : Submonoid.powers (φ r) ≤ M.map φ := Submonoid.powers_le.mpr ⟨r, hr, rfl⟩
    letI : Algebra T Sₘ :=
      IsLocalization.localizationAlgebraOfSubmonoidLe T Sₘ (Submonoid.powers (φ r)) (M.map φ) hle
    haveI : IsScalarTower S T Sₘ :=
      IsLocalization.localization_isScalarTower_of_submonoid_le T Sₘ _ _ hle
    have h1 : IsLocalization ((M.map φ).map (algebraMap S T)) Sₘ :=
      IsLocalization.isLocalization_of_submonoid_le T Sₘ _ _ hle
    have heq : (M.map φ).map (algebraMap S T) = M.map ((algebraMap S T).comp φ) := by
      ext y
      simp only [Submonoid.mem_map, RingHom.coe_comp, Function.comp_apply]
      constructor
      · rintro ⟨_, ⟨m, hm, rfl⟩, rfl⟩
        exact ⟨m, hm, rfl⟩
      · rintro ⟨m, hm, rfl⟩
        exact ⟨φ m, ⟨m, hm, rfl⟩, rfl⟩
    rw [heq] at h1
    haveI := h1
    have hloc := RingHom.Etale.isStableUnderBaseChange.localizationPreserves
      ((algebraMap S T).comp φ) M (Localization M) Sₘ hf
    have key : (IsLocalization.map Sₘ φ M.le_comap_map : Localization M →+* Sₘ) =
        (IsLocalization.map Sₘ ((algebraMap S T).comp φ) M.le_comap_map :
          Localization M →+* Sₘ) := by
      apply IsLocalization.ringHom_ext M
      rw [IsLocalization.map_comp, IsLocalization.map_comp, ← RingHom.comp_assoc,
        ← IsScalarTower.algebraMap_eq]
    show (IsLocalization.map Sₘ φ M.le_comap_map : Localization M →+* Sₘ).Etale
    rw [key]
    exact hloc

  have s3 : ∀ {X N : Scheme.{u}} (ν : N ⟶ X) [IsAffineHom ν] (U : X.Opens), IsAffineOpen U →
      ∀ r : Γ(X, U), Etale (ν ∣_ X.basicOpen r) →
      ((algebraMap Γ(N, ν ⁻¹ᵁ U) (Localization.Away ((ν.app U).hom r))).comp
        (ν.app U).hom).Etale := by
    intro X N ν _ U hU r h
    have hV : IsAffineOpen (X.basicOpen r) := hU.basicOpen r
    have hV' : IsAffineOpen (ν ⁻¹ᵁ X.basicOpen r) := hV.preimage ν
    haveI : IsAffine (X.basicOpen r) := hV
    haveI : IsAffine (ν ⁻¹ᵁ X.basicOpen r) := hV'
    rw [HasRingHomProperty.iff_of_isAffine (P := @Etale), morphismRestrict_appTop] at h
    have h3 : (ν.app (X.basicOpen r)).hom.Etale := by
      have h' := (RingHom.RespectsIso.cancel_right_isIso RingHom.Etale.respectsIso
        (ν.app ((X.basicOpen r).ι ''ᵁ ⊤)) (N.presheaf.map (eqToHom (by simp)).op)).mp h
      rwa [Scheme.Opens.ι_image_top] at h'
    haveI := hU.isLocalization_basicOpen r
    haveI := (hU.preimage ν).isLocalization_basicOpen ((ν.app U).hom r)
    rw [IsAffineOpen.app_basicOpen_eq_away_map ν hU (hU.preimage ν) r, CommRingCat.hom_comp] at h3
    have hA := (RingHom.RespectsIso.cancel_right_isIso RingHom.Etale.respectsIso _ _).mp h3
    rw [CommRingCat.hom_ofHom] at hA
    have hl : (algebraMap Γ(X, U) Γ(X, X.basicOpen r)).Etale :=
      RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway r)
    have hc := RingHom.Etale.stableUnderComposition _ _ hl hA
    have hcomp : (IsLocalization.Away.map Γ(X, X.basicOpen r)
        Γ(N, N.basicOpen ((ν.app U).hom r)) (ν.app U).hom r).comp
          (algebraMap Γ(X, U) Γ(X, X.basicOpen r)) =
        (algebraMap Γ(N, ν ⁻¹ᵁ U) Γ(N, N.basicOpen ((ν.app U).hom r))).comp (ν.app U).hom :=
      IsLocalization.map_comp _
    rw [hcomp] at hc
    let e := IsLocalization.algEquiv (Submonoid.powers ((ν.app U).hom r))
      Γ(N, N.basicOpen ((ν.app U).hom r)) (Localization.Away ((ν.app U).hom r))
    have he : (algebraMap Γ(N, ν ⁻¹ᵁ U) (Localization.Away ((ν.app U).hom r))).comp
        (ν.app U).hom = e.toRingEquiv.toRingHom.comp
          ((algebraMap Γ(N, ν ⁻¹ᵁ U) Γ(N, N.basicOpen ((ν.app U).hom r))).comp
            (ν.app U).hom) := by
      ext x; simp [e]
    rw [he]
    exact RingHom.Etale.respectsIso.1 _ _ hc

  have s2 : ∀ {N X : Scheme.{u}} (ν : N ⟶ X) (W V : X.Opens), V ≤ W → Etale (ν ∣_ W) →
      Etale (ν ∣_ V) := by
    intro N X ν W V hVW h
    haveI : IsZariskiLocalAtTarget @Etale := HasRingHomProperty.instIsZariskiLocalAtTarget @Etale
    haveI : MorphismProperty.RespectsIso @Etale :=
      (HasRingHomProperty.instIsZariskiLocalAtTarget @Etale).toRespects
    have ha := IsZariskiLocalAtTarget.restrict h (W.ι ⁻¹ᵁ V)
    have hb := (MorphismProperty.arrow_mk_iso_iff @Etale
      (morphismRestrictRestrict ν W (W.ι ⁻¹ᵁ V))).mp ha
    have hEq : W.ι ''ᵁ (W.ι ⁻¹ᵁ V) = V := by
      rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
      exact inf_eq_right.mpr hVW
    exact (MorphismProperty.arrow_mk_iso_iff @Etale (morphismRestrictEq ν hEq)).mp hb

  intro N X ν _ U hU W hW Q₀ hx'W
  have hxU : hU.fromSpec Q₀ ∈ U := by
    rw [← SetLike.mem_coe, ← hU.range_fromSpec]
    exact ⟨Q₀, rfl⟩
  obtain ⟨r, hrW, hxr⟩ := hU.exists_basicOpen_le (V := W) ⟨hU.fromSpec Q₀, hx'W⟩ hxU
  have hr : r ∉ Q₀.asIdeal := by
    have h1 : Q₀ ∈ hU.fromSpec ⁻¹ᵁ X.basicOpen r := hxr
    rw [hU.fromSpec_preimage_basicOpen r] at h1
    exact (PrimeSpectrum.mem_basicOpen r Q₀).mp h1
  exact s4 (ν.app U).hom r Q₀.asIdeal hr (s3 ν U hU r (s2 ν W _ hrW hW))

theorem wc_cg2ard_smooth_localization : ∀ (A₀ R : Type u) [CommRing A₀] [IsDomain A₀] [IsNoetherianRing A₀] [CommRing R] [IsDomain R] (ψ : A₀ →+* R), ψ.Smooth → ∀ (𝔭 : Ideal A₀) [𝔭.IsPrime], (∀ a : A₀, a ≠ 0 → ψ a ≠ 0) ∧ (letI : Algebra A₀ R := ψ.toAlgebra; letI : Algebra (Localization.AtPrime 𝔭) (Localization (Algebra.algebraMapSubmonoid R 𝔭.primeCompl)) := localizationAlgebra 𝔭.primeCompl R; Algebra.Smooth (Localization.AtPrime 𝔭) (Localization (Algebra.algebraMapSubmonoid R 𝔭.primeCompl))) :=
by
  intro A₀ R _ _ _ _ _ ψ hψ 𝔭 _
  refine ⟨?_, ?_⟩
  · intro a ha hψa
    letI : Algebra A₀ R := ψ.toAlgebra
    haveI : Algebra.Smooth A₀ R := RingHom.Smooth.toAlgebra hψ
    have hreg : IsSMulRegular R a :=
      Module.Flat.isSMulRegular_of_nonZeroDivisors (M := R) (mem_nonZeroDivisors_of_ne_zero ha)
    have h1 : a • (1 : R) = a • (0 : R) := by
      rw [smul_zero, Algebra.smul_def, mul_one]
      exact hψa
    exact one_ne_zero (hreg h1)
  · letI : Algebra A₀ R := ψ.toAlgebra
    letI : Algebra (Localization.AtPrime 𝔭)
        (Localization (Algebra.algebraMapSubmonoid R 𝔭.primeCompl)) :=
      localizationAlgebra 𝔭.primeCompl R
    exact (RingHom.Smooth.toAlgebra
      (@RingHom.IsStableUnderBaseChange.localizationPreserves _
        RingHom.Smooth.isStableUnderBaseChange A₀ R _ _ ψ 𝔭.primeCompl
        (Localization.AtPrime 𝔭) (Localization (Algebra.algebraMapSubmonoid R 𝔭.primeCompl))
        _ _ _ _ _
        (Localization.isLocalization (M := Algebra.algebraMapSubmonoid R 𝔭.primeCompl)) hψ) :
      Algebra.Smooth (Localization.AtPrime 𝔭)
        (Localization (Algebra.algebraMapSubmonoid R 𝔭.primeCompl)))

theorem wc_cg2ard_frac_tensor_finite : ∀ (R B L : Type u) [CommRing R] [CommRing B] [IsDomain B] [CommRing L] [Algebra R B] [Algebra R L] [Algebra B L] [IsScalarTower R B L] (G : Finset L), (∀ l : L, ∃ c : R, algebraMap R B c ≠ 0 ∧ c • l ∈ Submodule.span R (G : Set L)) → Module.Finite (FractionRing B) (TensorProduct B (FractionRing B) L) :=
by
  intro R B L _ _ _ _ _ _ _ _ G hG
  classical
  let K := FractionRing B
  let S : Set (TensorProduct B K L) := (fun g => (1 : K) ⊗ₜ[B] g) '' (G : Set L)
  have hS : S.Finite := (Finset.finite_toSet G).image _
  have key1 : ∀ (b : B) (x : L),
      (algebraMap B K b) • ((1 : K) ⊗ₜ[B] x) = (1 : K) ⊗ₜ[B] (b • x) := by
    intro b x
    rw [algebraMap_smul, TensorProduct.tmul_smul]
  have key2 : ∀ (r : R) (x : L),
      (algebraMap B K (algebraMap R B r)) • ((1 : K) ⊗ₜ[B] x) = (1 : K) ⊗ₜ[B] (r • x) := by
    intro r x
    rw [key1, algebraMap_smul]
  have hspan : ∀ y ∈ Submodule.span R (G : Set L), (1 : K) ⊗ₜ[B] y ∈ Submodule.span K S := by
    intro y hy
    induction hy using Submodule.span_induction with
    | mem x hx => exact Submodule.subset_span ⟨x, hx, rfl⟩
    | zero => rw [TensorProduct.tmul_zero]; exact zero_mem _
    | add x y _ _ hx hy => rw [TensorProduct.tmul_add]; exact add_mem hx hy
    | smul r x _ hx => rw [← key2]; exact Submodule.smul_mem _ _ hx
  have hpure : ∀ (k : K) (l : L), k ⊗ₜ[B] l ∈ Submodule.span K S := by
    intro k l
    obtain ⟨c, hc0, hc⟩ := hG l
    have hβ : algebraMap B K (algebraMap R B c) ≠ 0 :=
      (map_ne_zero_iff _ (IsFractionRing.injective B K)).mpr hc0
    have h1 := Submodule.smul_mem (Submodule.span K S)
      (k * (algebraMap B K (algebraMap R B c))⁻¹) (hspan _ hc)
    rw [← key2, smul_smul, mul_assoc, inv_mul_cancel₀ hβ, mul_one, TensorProduct.smul_tmul',
      smul_eq_mul, mul_one] at h1
    exact h1
  have htop : Submodule.span K S = ⊤ := by
    rw [Submodule.eq_top_iff']
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact zero_mem _
    | tmul k l => exact hpure k l
    | add x y hx hy => exact add_mem hx hy
  exact Module.Finite.of_fg_top (Submodule.fg_def.mpr ⟨S, hS, htop⟩)

theorem wc_cg2ard_normalization_localization : ∀ (R S L B : Type u) [CommRing R] [CommRing S] [CommRing L] [CommRing B] [Algebra R L] [Algebra R B] [Algebra B L] [IsScalarTower R B L] (M : Submonoid R) [IsLocalization M B] (φ : R →+* S) (e : S ≃+* integralClosure R L), φ.Finite → (∀ r : R, (e (φ r) : L) = algebraMap R L r) → Module.Finite B (integralClosure B L) ∧ ∀ (Q : Ideal B) [Q.IsPrime] (Q₀ : Ideal R) [Q₀.IsPrime], Q.comap (algebraMap R B) = Q₀ → (wcCg2LocEtale φ Q₀.primeCompl ↔ wcCg2LocEtale (algebraMap B (integralClosure B L)) Q.primeCompl) :=
by
  classical
  intro R S L B _ _ _ _ _ _ _ _ M _ φ e hφ he

  have hC'fin : Module.Finite R (integralClosure R L) := by
    have h1 : algebraMap R (integralClosure R L) = e.toRingHom.comp φ := by
      ext r
      exact (he r).symm
    have h2 : (e.toRingHom.comp φ).Finite :=
      (RingHom.Finite.of_surjective e.toRingHom e.surjective).comp hφ
    rw [← h1] at h2
    exact RingHom.finite_algebraMap.mp h2

  have hι : ∀ x : integralClosure R L, IsIntegral B (x : L) := fun x =>
    IsIntegral.tower_top (A := B) x.2
  let ι : integralClosure R L →+* integralClosure B L :=
    { toFun := fun x => ⟨x, hι x⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }

  have hmult : ∀ c : integralClosure B L, ∃ m : M, IsIntegral R ((m : R) • (c : L)) := fun c =>
    IsIntegral.exists_multiple_integral_of_isLocalization M (c : L) c.2
  have hunit : ∀ μ : M, IsUnit (algebraMap R B μ) := fun μ => IsLocalization.map_units B μ
  refine ⟨?_, ?_⟩
  ·
    obtain ⟨s, hs⟩ := hC'fin.fg_top
    have hspan : ∀ y ∈ Submodule.span R (s : Set (integralClosure R L)),
        ι y ∈ Submodule.span B ((s.image ι : Finset _) : Set (integralClosure B L)) := by
      intro y hy
      induction hy using Submodule.span_induction with
      | mem y hy =>
        exact Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem ι hy))
      | zero => simp
      | add a b _ _ ha hb => rw [map_add]; exact add_mem ha hb
      | smul r a _ ha =>
        have hra : ι (r • a) = (algebraMap R B r) • ι a := by
          apply Subtype.ext
          show r • (a : L) = algebraMap R B r • (a : L)
          exact (algebraMap_smul B r (a : L)).symm
        rw [hra]
        exact Submodule.smul_mem _ _ ha
    refine ⟨⟨s.image ι, ?_⟩⟩
    rw [eq_top_iff]
    rintro c -
    obtain ⟨m, hm⟩ := hmult c
    let x : integralClosure R L := ⟨(m : R) • (c : L), hm⟩
    have hx : x ∈ Submodule.span R (s : Set _) := hs ▸ Submodule.mem_top
    obtain ⟨v, hv⟩ := hunit m
    have hc : c = ((v⁻¹ : Bˣ) : B) • ι x := by
      apply Subtype.ext
      show (c : L) = ((v⁻¹ : Bˣ) : B) • ((m : R) • (c : L))
      rw [← algebraMap_smul B (m : R) (c : L), smul_smul, ← hv, Units.inv_mul, one_smul]
    rw [hc]
    exact Submodule.smul_mem _ _ (hspan x hx)
  ·
    intro Q _ Q₀ _ hQ
    subst hQ
    let γ : S →+* integralClosure B L := ι.comp e.toRingHom
    have hγ : ∀ r : R, γ (φ r) = algebraMap B (integralClosure B L) (algebraMap R B r) := by
      intro r
      apply Subtype.ext
      show (e (φ r) : L) = algebraMap B L (algebraMap R B r)
      rw [he, ← IsScalarTower.algebraMap_apply]
    have hinj : Function.Injective γ := by
      intro x y h
      have h' : ((γ x : integralClosure B L) : L) = ((γ y : integralClosure B L) : L) :=
        congrArg Subtype.val h
      exact e.injective (Subtype.ext h')
    have hsurj : ∀ c : integralClosure B L, ∃ s : S, ∃ m ∈ M,
        c * algebraMap B (integralClosure B L) (algebraMap R B m) = γ s := by
      intro c
      obtain ⟨m, hm⟩ := hmult c
      refine ⟨e.symm ⟨(m : R) • (c : L), hm⟩, m, m.2, ?_⟩
      apply Subtype.ext
      show (c : L) * algebraMap B L (algebraMap R B m) =
        ((e (e.symm ⟨_, hm⟩) : integralClosure R L) : L)
      rw [RingEquiv.apply_symm_apply]
      show (c : L) * algebraMap B L (algebraMap R B m) = (m : R) • (c : L)
      rw [Algebra.smul_def, ← IsScalarTower.algebraMap_apply, mul_comm]
    have hM0 : ∀ μ : M, algebraMap R B μ ∉ Q := fun μ h =>
      Ideal.IsPrime.ne_top inferInstance (Ideal.eq_top_of_isUnit_mem _ h (hunit μ))
    have hfact : ∀ b : B, b ∉ Q → ∃ μ : M, ∃ r : R, algebraMap R B r ∉ Q ∧
        b * algebraMap R B μ = algebraMap R B r := by
      intro b hb
      obtain ⟨⟨r, μ⟩, h⟩ := IsLocalization.surj M b
      refine ⟨μ, r, fun hr => ?_, h⟩
      rw [← h] at hr
      rcases Ideal.IsPrime.mem_or_mem inferInstance hr with h1 | h1
      · exact hb h1
      · exact hM0 μ h1
    let N₀ : Submonoid R := (Q.comap (algebraMap R B)).primeCompl
    let N : Submonoid B := Q.primeCompl

    have hA : IsLocalization N₀ (Localization N) :=
      IsLocalization.isLocalization_isLocalization_atPrime_isLocalization M
        (Localization.AtPrime Q) Q
    let α : Localization N₀ ≃ₐ[R] Localization N := IsLocalization.algEquiv N₀ _ _

    letI algST : Algebra S (Localization (N.map (algebraMap B (integralClosure B L)))) :=
      ((algebraMap (integralClosure B L)
        (Localization (N.map (algebraMap B (integralClosure B L))))).comp γ).toAlgebra
    have hg : ∀ s : S, algebraMap S (Localization (N.map (algebraMap B (integralClosure B L)))) s =
        algebraMap (integralClosure B L) (Localization (N.map (algebraMap B (integralClosure B L))))
          (γ s) := fun _ => rfl
    have hT : IsLocalization (N₀.map φ)
        (Localization (N.map (algebraMap B (integralClosure B L)))) := by
      rw [isLocalization_iff]
      refine ⟨?_, ?_, ?_⟩
      · rintro ⟨_, n, hn, rfl⟩
        change IsUnit (algebraMap S (Localization _) (φ n))
        rw [hg, hγ]
        exact IsLocalization.map_units _
          (⟨_, Submonoid.mem_map_of_mem _ (hn : algebraMap R B n ∈ N)⟩ :
            N.map (algebraMap B (integralClosure B L)))
      · intro z
        obtain ⟨⟨x₁, ⟨x₂, hx₂⟩⟩, hz⟩ :=
          IsLocalization.surj (N.map (algebraMap B (integralClosure B L))) z
        obtain ⟨b, hb, rfl⟩ := Submonoid.mem_map.mp hx₂
        have hz' : z * algebraMap (integralClosure B L) _ (algebraMap B (integralClosure B L) b) =
            algebraMap (integralClosure B L) _ x₁ := hz
        obtain ⟨μ₂, r, hr, hbr⟩ := hfact b hb
        obtain ⟨s₁, μ₁, hμ₁, hs₁⟩ := hsurj x₁
        have hrμ : algebraMap R B (r * μ₁) ∉ Q := by
          intro h
          rw [map_mul] at h
          rcases Ideal.IsPrime.mem_or_mem inferInstance h with h1 | h1
          · exact hr h1
          · exact hM0 ⟨μ₁, hμ₁⟩ h1
        refine ⟨⟨s₁ * φ μ₂, ⟨φ (r * μ₁), Submonoid.mem_map_of_mem φ (hrμ : r * μ₁ ∈ N₀)⟩⟩, ?_⟩
        show z * algebraMap (integralClosure B L) _ (γ (φ (r * μ₁))) =
          algebraMap (integralClosure B L) _ (γ (s₁ * φ μ₂))
        rw [map_mul γ, hγ, hγ, ← hs₁, map_mul (algebraMap R B), ← hbr]
        simp only [map_mul]
        rw [← hz']
        ring
      · intro x y hxy
        obtain ⟨⟨c, hc'⟩, hcxy⟩ := IsLocalization.exists_of_eq
          (M := N.map (algebraMap B (integralClosure B L)))
          (S := Localization (N.map (algebraMap B (integralClosure B L))))
          (hxy : algebraMap (integralClosure B L) _ (γ x) = algebraMap (integralClosure B L) _ (γ y))
        obtain ⟨b, hb, rfl⟩ := Submonoid.mem_map.mp hc'
        have hcxy' : algebraMap B (integralClosure B L) b * γ x =
            algebraMap B (integralClosure B L) b * γ y := hcxy
        obtain ⟨μ, r, hr, hbr⟩ := hfact b hb
        refine ⟨⟨φ r, Submonoid.mem_map_of_mem φ (hr : r ∈ N₀)⟩, ?_⟩
        apply hinj
        show γ (φ r * x) = γ (φ r * y)
        rw [map_mul, map_mul, hγ, ← hbr, map_mul]
        linear_combination (algebraMap B (integralClosure B L) (algebraMap R B μ)) * hcxy'
    let β : Localization (N₀.map φ) ≃ₐ[S]
        Localization (N.map (algebraMap B (integralClosure B L))) :=
      IsLocalization.algEquiv (N₀.map φ) _ _

    let left : Localization N₀ →+* Localization (N₀.map φ) :=
      IsLocalization.map (Localization (N₀.map φ)) φ N₀.le_comap_map
    let right : Localization N →+* Localization (N.map (algebraMap B (integralClosure B L))) :=
      IsLocalization.map _ (algebraMap B (integralClosure B L)) N.le_comap_map
    have hleft : ∀ r : R, left (algebraMap R (Localization N₀) r) =
        algebraMap S (Localization (N₀.map φ)) (φ r) := fun r => IsLocalization.map_eq _ _
    have hright : ∀ b : B, right (algebraMap B (Localization N) b) =
        algebraMap (integralClosure B L) _ (algebraMap B (integralClosure B L) b) :=
      fun b => IsLocalization.map_eq _ _
    have hC : right.comp α.toRingEquiv.toRingHom = β.toRingEquiv.toRingHom.comp left := by
      apply IsLocalization.ringHom_ext N₀
      ext r
      simp only [RingHom.comp_apply]
      show right (α (algebraMap R _ r)) = β (left (algebraMap R _ r))
      rw [AlgEquiv.commutes, IsScalarTower.algebraMap_apply R B (Localization N), hright,
        hleft, AlgEquiv.commutes, hg, hγ]

    have hR : right = (β.toRingEquiv.toRingHom.comp left).comp α.toRingEquiv.symm.toRingHom := by
      rw [← hC, RingHom.comp_assoc]
      ext x
      simp
    have hL : left = (β.toRingEquiv.symm.toRingHom.comp right).comp α.toRingEquiv.toRingHom := by
      rw [RingHom.comp_assoc, hC, ← RingHom.comp_assoc]
      ext x
      simp
    show left.Etale ↔ right.Etale
    constructor
    · intro h
      rw [hR]
      exact RingHom.Etale.respectsIso.2 _ _ (RingHom.Etale.respectsIso.1 _ _ h)
    · intro h
      rw [hL]
      exact RingHom.Etale.respectsIso.2 _ _ (RingHom.Etale.respectsIso.1 _ _ h)

theorem wc_cg2ard_points_transfer : ∀ (A B R L F₀ : Type u) [CommRing A] [IsDomain A] [CommRing B] [CommRing R] [CommRing L] [Field F₀] [Algebra A B] [Algebra R B] [Algebra R L] [Algebra B L] [IsScalarTower R B L] [Algebra A F₀] [IsFractionRing A F₀] (M : Submonoid R) [IsLocalization M B] (s : B →ₐ[A] A) (κ : R →+* F₀), (∀ r : R, κ r = algebraMap A F₀ (s (algebraMap R B r))) → (∀ l : L, ∃ c : R, IsUnit (algebraMap R L c) ∧ κ c ≠ 0 ∧ IsIntegral R (algebraMap R L c * l)) → (letI : Algebra R F₀ := κ.toAlgebra; ∃ (n : ℕ) (ρ : Fin n → (TensorProduct R F₀ L →ₐ[F₀] F₀)), Function.Injective ρ ∧ Module.finrank F₀ (TensorProduct R F₀ L) ≤ n) → wcCg2FibrePts s (integralClosure B L) :=
by
  intro A B R L F₀ _ _ _ _ _ _ _ _ _ _ _ _ _ M _ s κ hκ hL hP
  classical
  letI algRF : Algebra R F₀ := κ.toAlgebra
  obtain ⟨n, ρ, hρ, hfin⟩ := hP
  letI algBF : Algebra B F₀ := ((algebraMap A F₀).comp s.toRingHom).toAlgebra
  haveI : IsScalarTower R B F₀ := IsScalarTower.of_algebraMap_eq (fun r => hκ r)

  have hden : ∀ l : L, ∃ c : R, IsUnit (algebraMap R L c) ∧ κ c ≠ 0 ∧
      ∃ x : integralClosure B L, (x : L) = algebraMap R L c * l := by
    intro l
    obtain ⟨c, hu, hc, hi⟩ := hL l
    exact ⟨c, hu, hc, ⟨_, (mem_integralClosure_iff B L).mpr hi.tower_top⟩, rfl⟩

  let Ψ : TensorProduct R F₀ (integralClosure B L) →ₐ[F₀] TensorProduct R F₀ L :=
    Algebra.TensorProduct.map (AlgHom.id F₀ F₀) (IsScalarTower.toAlgHom R (integralClosure B L) L)
  have hΨ : ∀ (f : F₀) (x : integralClosure B L), Ψ (f ⊗ₜ x) = f ⊗ₜ (x : L) := fun f x => rfl
  have hsurj : Function.Surjective Ψ := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact ⟨0, map_zero _⟩
    | tmul f l =>
      obtain ⟨c, _, hc, x, hx⟩ := hden l
      refine ⟨((κ c)⁻¹ * f) ⊗ₜ x, ?_⟩
      rw [hΨ, hx, ← Algebra.smul_def, ← TensorProduct.smul_tmul, Algebra.smul_def]
      congr 1
      show κ c * ((κ c)⁻¹ * f) = f
      rw [← mul_assoc, mul_inv_cancel₀ hc, one_mul]
    | add x y hx hy =>
      obtain ⟨a, rfl⟩ := hx
      obtain ⟨b, rfl⟩ := hy
      exact ⟨a + b, map_add _ _ _⟩

  let N : Submonoid R :=
    { carrier := {c | IsUnit (algebraMap R L c) ∧ κ c ≠ 0}
      mul_mem' := fun {a b} ha hb => ⟨by rw [map_mul]; exact ha.1.mul hb.1,
        by rw [map_mul]; exact mul_ne_zero ha.2 hb.2⟩
      one_mem' := ⟨by rw [map_one]; exact isUnit_one, by rw [map_one]; exact one_ne_zero⟩ }
  let S : Submonoid (integralClosure B L) := Algebra.algebraMapSubmonoid (integralClosure B L) N
  haveI hloc : IsLocalization S L := by
    refine ⟨?_, ?_, ?_⟩
    · rintro ⟨_, c, hc, rfl⟩
      show IsUnit (algebraMap (integralClosure B L) L (algebraMap R (integralClosure B L) c))
      rw [← IsScalarTower.algebraMap_apply]
      exact hc.1
    · intro z
      obtain ⟨c, hu, hc, x, hx⟩ := hden z
      refine ⟨(x, ⟨algebraMap R (integralClosure B L) c, c, ⟨hu, hc⟩, rfl⟩), ?_⟩
      show z * algebraMap (integralClosure B L) L (algebraMap R (integralClosure B L) c) =
        (x : L)
      rw [← IsScalarTower.algebraMap_apply, hx, mul_comm]
    · intro x y h
      exact ⟨1, by rw [Subtype.ext h]⟩
  haveI hlocM : IsLocalizedModule S (Algebra.linearMap (integralClosure B L) L) :=
    (isLocalizedModule_iff_isLocalization' S L).mpr hloc
  let g' := TensorProduct.AlgebraTensorModule.rTensor R F₀
    (Algebra.linearMap (integralClosure B L) L)
  haveI hg' : IsLocalizedModule S g' :=
    IsLocalizedModule.rTensor (R := R) (integralClosure B L) (M := integralClosure B L)
      (M' := L) S (N := F₀) (Algebra.linearMap (integralClosure B L) L)
  have hreg : ∀ (c : R), κ c ≠ 0 → ∀ z : TensorProduct R (integralClosure B L) F₀,
      LinearMap.lTensor (integralClosure B L) (LinearMap.mulLeft R ((κ c)⁻¹))
        ((algebraMap R (integralClosure B L) c) • z) = z := by
    intro c hc z
    induction z using TensorProduct.induction_on with
    | zero => rw [smul_zero, map_zero]
    | tmul x f =>
      rw [TensorProduct.smul_tmul', smul_eq_mul, ← Algebra.smul_def, TensorProduct.smul_tmul,
        LinearMap.lTensor_tmul, LinearMap.mulLeft_apply, Algebra.smul_def]
      congr 1
      show (κ c)⁻¹ * (κ c * f) = f
      rw [← mul_assoc, inv_mul_cancel₀ hc, one_mul]
    | add x y hx hy => rw [smul_add, map_add, hx, hy]
  have hg'inj : Function.Injective g' := by
    intro z₁ z₂ h
    obtain ⟨⟨_, c, hc, rfl⟩, he⟩ := IsLocalizedModule.exists_of_eq (S := S) (f := g') h
    have h1 := hreg c hc.2 z₁
    have h2 := hreg c hc.2 z₂
    exact h1.symm.trans ((congrArg (LinearMap.lTensor (integralClosure B L)
      (LinearMap.mulLeft R ((κ c)⁻¹))) he).trans h2)
  have hΨeq : ∀ z, Ψ z = TensorProduct.comm R L F₀ (g' (TensorProduct.comm R F₀ _ z)) := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul f x => rfl
    | add x y hx hy => rw [map_add, hx, hy, map_add, map_add, map_add]
  have hinj : Function.Injective Ψ := by
    intro z₁ z₂ h
    rw [hΨeq, hΨeq] at h
    exact (TensorProduct.comm R F₀ _).injective (hg'inj ((TensorProduct.comm R L F₀).injective h))
  let Ψe := AlgEquiv.ofBijective Ψ ⟨hinj, hsurj⟩

  haveI := IsLocalization.tensorProduct_compatibleSMul M B F₀ (integralClosure B L)
  let E := Algebra.TensorProduct.equivOfCompatibleSMul R B F₀ F₀ (integralClosure B L)

  let e₀ : FractionRing A ≃ₐ[A] F₀ := FractionRing.algEquiv A F₀
  letI algBK : Algebra B (FractionRing A) :=
    ((algebraMap A (FractionRing A)).comp s.toRingHom).toAlgebra
  let eB : FractionRing A ≃ₐ[B] F₀ :=
    AlgEquiv.ofRingEquiv (f := e₀.toRingEquiv) (fun b => e₀.commutes (s b))
  let Φ₃ := Algebra.TensorProduct.congr eB (AlgEquiv.refl : integralClosure B L ≃ₐ[B] _)
  let j : TensorProduct B (FractionRing A) (integralClosure B L) ≃+* TensorProduct R F₀ L :=
    (Φ₃.toRingEquiv.trans E.toRingEquiv).trans Ψe.toRingEquiv
  have hj : ∀ t : FractionRing A,
      j (algebraMap (FractionRing A) (TensorProduct B (FractionRing A) (integralClosure B L)) t) =
        algebraMap F₀ (TensorProduct R F₀ L) (e₀ t) := by
    intro t
    have h3 : Φ₃ (algebraMap (FractionRing A)
        (TensorProduct B (FractionRing A) (integralClosure B L)) t) =
        algebraMap F₀ (TensorProduct B F₀ (integralClosure B L)) (e₀ t) := by
      rw [Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.algebraMap_apply]
      rfl
    have hjdef : ∀ y, j y = Ψe (E (Φ₃ y)) := fun y => rfl
    rw [hjdef, h3, AlgEquiv.commutes, AlgEquiv.commutes]
  unfold wcCg2FibrePts
  let ρ' : Fin n → (TensorProduct B (FractionRing A) (integralClosure B L) →ₐ[FractionRing A]
      FractionRing A) := fun i =>
    { toRingHom := e₀.symm.toRingEquiv.toRingHom.comp ((ρ i).toRingHom.comp j.toRingHom)
      commutes' := fun t => by
        show e₀.symm (ρ i (j _)) = t
        rw [hj, AlgHom.commutes]
        exact e₀.symm_apply_apply t }
  have hρ' : ∀ i y, ρ' i y = e₀.symm (ρ i (j y)) := fun i y => rfl
  refine ⟨n, ρ', ?_, ?_⟩
  · intro a b hab
    apply hρ
    apply AlgHom.ext
    intro y
    have := congrArg (fun φ => e₀ (φ (j.symm y))) hab
    simp only [hρ', AlgEquiv.apply_symm_apply, RingEquiv.apply_symm_apply] at this
    exact this
  · rw [Algebra.finrank_eq_of_equiv_equiv e₀.toRingEquiv j (RingHom.ext fun t => (hj t).symm)]
    exact hfin

theorem wc_cg2_affine_ring_data : ∀ (A₀ : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀] [IsNoetherianRing A₀] (X : Scheme.{u}) [CompactSpace X] [QuasiSeparatedSpace X] (f : X ⟶ Spec (.of A₀)) [Smooth f] (σ : Spec (.of A₀) ⟶ X) (hσ : σ ≫ f = 𝟙 _) (P : Scheme.{u}) (p : P ⟶ Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))), IsFinite p → Etale p → ∀ [QuasiCompact (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))] [QuasiSeparated (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))], (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) → IsFinite (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) → IsPullback (Scheme.Hom.toNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) p (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) → ∀ x : X, 2 ≤ (f x).asIdeal.height → (∀ x' : X, (f x').asIdeal < (f x).asIdeal → ∃ W : X.Opens, x' ∈ W ∧ Etale (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ∣_ W)) →
    ∃ (U : X.Opens) (hU : IsAffineOpen U) (hyU : σ (f x) ∈ U), IsNoetherianRing Γ(X, U) ∧
    ∃ (A : Type u) (_ : CommRing A) (_ : IsDomain A) (_ : IsLocalRing A) (_ : IsIntegrallyClosed A)
      (_ : IsNoetherianRing A) (B : Type u) (_ : CommRing B) (_ : IsDomain B)
      (_ : IsIntegrallyClosed B) (_ : Algebra A B) (_ : Algebra.Smooth A B) (s : B →ₐ[A] A)
      (L : Type u) (_ : CommRing L) (_ : Algebra B L) (_ : Algebra A L) (_ : IsScalarTower A B L),
      2 ≤ (IsLocalRing.maximalIdeal A).height ∧
      (∀ a : A, a ≠ 0 → IsUnit (algebraMap A L a)) ∧
      (∀ (b : B) (y : L), b ≠ 0 → b • y = 0 → y = 0) ∧
      Module.Finite (FractionRing B) (TensorProduct B (FractionRing B) L) ∧
      Module.Finite B (integralClosure B L) ∧
      (∀ (Q : Ideal B) [Q.IsPrime], Q.comap (algebraMap A B) ≠ IsLocalRing.maximalIdeal A →
        wcCg2LocEtale (algebraMap B (integralClosure B L)) Q.primeCompl) ∧
      (wcCg2SchemePts (Limits.pullback p (Limits.pullback.lift (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))) ≫ σ) (𝟙 _) (by rw [Category.assoc, hσ, Category.comp_id, Category.id_comp])))
          (Limits.pullback.snd p (Limits.pullback.lift (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))) ≫ σ) (𝟙 _) (by rw [Category.assoc, hσ, Category.comp_id, Category.id_comp]))) →
        wcCg2FibrePts s (integralClosure B L)) ∧
      (wcCg2LocEtale (algebraMap B (integralClosure B L))
          ((IsLocalRing.maximalIdeal A).comap s).primeCompl →
        wcCg2LocEtale ((Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))).app U).hom
          (hU.primeIdealOf ⟨σ (f x), hyU⟩).asIdeal.primeCompl) :=
by
  intro A₀ _ _ _ _ X _ _ f _ σ hσ P p hpfin hpet _ _ hnorm hfin hpb x hx H_lt
  classical
  obtain ⟨𝔭, h𝔭⟩ : ∃ 𝔭 : Ideal A₀, (f x).asIdeal = 𝔭 := ⟨_, rfl⟩
  haveI : 𝔭.IsPrime := h𝔭 ▸ (f x).isPrime
  have hx' : 2 ≤ 𝔭.height := by rw [← h𝔭]; exact hx

  have core : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsIntegrallyClosed R] [Algebra A₀ R],
      (∀ a : A₀, a ≠ 0 → algebraMap A₀ R a ≠ 0) →
      ∀ (B : Type u) [CommRing B] [Algebra R B]
        [IsLocalization (Algebra.algebraMapSubmonoid R 𝔭.primeCompl) B]
        [Algebra (Localization.AtPrime 𝔭) B] [Algebra.Smooth (Localization.AtPrime 𝔭) B],
      (∀ a : A₀, algebraMap (Localization.AtPrime 𝔭) B (algebraMap A₀ (Localization.AtPrime 𝔭) a) =
        algebraMap R B (algebraMap A₀ R a)) →
      ∀ (Lr : Type u) [CommRing Lr] [Algebra R Lr] (S : Type u) [CommRing S] (φ : R →+* S)
        (e : S ≃+* integralClosure R Lr), φ.Finite →
      (∀ r : R, (e (φ r) : Lr) = algebraMap R Lr r) →
      (∀ a : A₀, a ≠ 0 → IsUnit (algebraMap R Lr (algebraMap A₀ R a))) → Module.Flat R Lr →
      (∃ G : Finset Lr, ∀ l, ∃ a : A₀, a ≠ 0 ∧
        algebraMap R Lr (algebraMap A₀ R a) * l ∈ Submodule.span R (G : Set Lr)) →
      (∀ l : Lr, ∃ a : A₀, a ≠ 0 ∧ IsIntegral R (algebraMap R Lr (algebraMap A₀ R a) * l)) →
      (∀ (Q₀ : Ideal R) [Q₀.IsPrime], Q₀.comap (algebraMap A₀ R) < 𝔭 →
        wcCg2LocEtale φ Q₀.primeCompl) →
      ∀ (θ : R →+* Localization.AtPrime 𝔭),
        θ.comp (algebraMap A₀ R) = algebraMap A₀ (Localization.AtPrime 𝔭) →
      ∀ (T : Ideal R) [T.IsPrime], (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭)).comap θ = T →
      ∀ (Zp : Prop), (Zp → letI : Algebra R (FractionRing A₀) :=
          ((algebraMap (Localization.AtPrime 𝔭) (FractionRing A₀)).comp θ).toAlgebra
        ∃ (n : ℕ) (ρ : Fin n → (TensorProduct R (FractionRing A₀) Lr →ₐ[FractionRing A₀] FractionRing A₀)),
          Function.Injective ρ ∧ Module.finrank (FractionRing A₀) (TensorProduct R (FractionRing A₀) Lr) ≤ n) →
      ∃ (A : Type u) (_ : CommRing A) (_ : IsDomain A) (_ : IsLocalRing A) (_ : IsIntegrallyClosed A)
        (_ : IsNoetherianRing A) (B : Type u) (_ : CommRing B) (_ : IsDomain B)
        (_ : IsIntegrallyClosed B) (_ : Algebra A B) (_ : Algebra.Smooth A B) (s : B →ₐ[A] A)
        (L : Type u) (_ : CommRing L) (_ : Algebra B L) (_ : Algebra A L) (_ : IsScalarTower A B L),
        2 ≤ (IsLocalRing.maximalIdeal A).height ∧
        (∀ a : A, a ≠ 0 → IsUnit (algebraMap A L a)) ∧
        (∀ (b : B) (y : L), b ≠ 0 → b • y = 0 → y = 0) ∧
        Module.Finite (FractionRing B) (TensorProduct B (FractionRing B) L) ∧
        Module.Finite B (integralClosure B L) ∧
        (∀ (Q : Ideal B) [Q.IsPrime], Q.comap (algebraMap A B) ≠ IsLocalRing.maximalIdeal A →
          wcCg2LocEtale (algebraMap B (integralClosure B L)) Q.primeCompl) ∧
        (Zp → wcCg2FibrePts s (integralClosure B L)) ∧
        (wcCg2LocEtale (algebraMap B (integralClosure B L))
            ((IsLocalRing.maximalIdeal A).comap s).primeCompl →
          wcCg2LocEtale φ T.primeCompl) := by
    intro R _ _ _ _ hψ0 B _ _ _ _ _ hAB Lr _ _ S _ φ e hφfin he h4a h4b h4c h4d hE θ hθ1 T _ hθ2 Zp hZp
    haveI := h4b

    have hMle : Algebra.algebraMapSubmonoid R 𝔭.primeCompl ≤ nonZeroDivisors R := by
      rintro _ ⟨a, ha, rfl⟩
      exact mem_nonZeroDivisors_of_ne_zero
        (hψ0 a (fun h0 => (Ideal.mem_primeCompl_iff.mp ha) (by rw [h0]; exact 𝔭.zero_mem)))
    haveI hBdom : IsDomain B := IsLocalization.isDomain_of_le_nonZeroDivisors B hMle
    haveI hBic : IsIntegrallyClosed B := isIntegrallyClosed_of_isLocalization B _ hMle
    have hRBinj : Function.Injective (algebraMap R B) := IsLocalization.injective B hMle
    haveI hAic : IsIntegrallyClosed (Localization.AtPrime 𝔭) :=
      isIntegrallyClosed_of_isLocalization _ 𝔭.primeCompl (Ideal.primeCompl_le_nonZeroDivisors 𝔭)

    have hθunit : ∀ y : Algebra.algebraMapSubmonoid R 𝔭.primeCompl, IsUnit (θ y) := by
      rintro ⟨_, a, ha, rfl⟩
      show IsUnit (θ (algebraMap A₀ R a))
      rw [show θ (algebraMap A₀ R a) = algebraMap A₀ (Localization.AtPrime 𝔭) a from
        RingHom.congr_fun hθ1 a]
      exact IsLocalization.map_units _ (⟨a, ha⟩ : 𝔭.primeCompl)
    have hsB : (IsLocalization.lift hθunit : B →+* Localization.AtPrime 𝔭).comp
        (algebraMap (Localization.AtPrime 𝔭) B) = RingHom.id _ := by
      apply IsLocalization.ringHom_ext 𝔭.primeCompl
      ext a
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hAB, IsLocalization.lift_eq]
      exact RingHom.congr_fun hθ1 a
    let s : B →ₐ[Localization.AtPrime 𝔭] Localization.AtPrime 𝔭 :=
      { (IsLocalization.lift hθunit : B →+* Localization.AtPrime 𝔭) with
        commutes' := fun a => RingHom.congr_fun hsB a }

    have hLunit : ∀ y : Algebra.algebraMapSubmonoid R 𝔭.primeCompl, IsUnit (algebraMap R Lr y) := by
      rintro ⟨_, a, ha, rfl⟩
      exact h4a a (fun h0 => (Ideal.mem_primeCompl_iff.mp ha) (by rw [h0]; exact 𝔭.zero_mem))
    letI algBL : Algebra B Lr := (IsLocalization.lift hLunit).toAlgebra
    letI algAL : Algebra (Localization.AtPrime 𝔭) Lr :=
      ((IsLocalization.lift hLunit).comp (algebraMap (Localization.AtPrime 𝔭) B)).toAlgebra
    haveI : IsScalarTower (Localization.AtPrime 𝔭) B Lr := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : IsScalarTower R B Lr :=
      IsScalarTower.of_algebraMap_eq (fun r => (IsLocalization.lift_eq hLunit r).symm)
    have e1 : ∀ c : A₀, algebraMap (Localization.AtPrime 𝔭) Lr (algebraMap A₀ _ c) =
        algebraMap R Lr (algebraMap A₀ R c) := by
      intro c
      show IsLocalization.lift hLunit (algebraMap (Localization.AtPrime 𝔭) B (algebraMap A₀ _ c)) = _
      rw [hAB, IsLocalization.lift_eq]

    have hht : 2 ≤ (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭)).height := by
      rw [← IsLocalization.height_under 𝔭.primeCompl (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭)),
        IsLocalization.AtPrime.under_maximalIdeal (Localization.AtPrime 𝔭) 𝔭]
      exact hx'

    have hL1 : ∀ a : Localization.AtPrime 𝔭, a ≠ 0 →
        IsUnit (algebraMap (Localization.AtPrime 𝔭) Lr a) := by
      intro a ha
      obtain ⟨⟨a₁, m⟩, hm⟩ := IsLocalization.surj 𝔭.primeCompl a
      change a * algebraMap A₀ (Localization.AtPrime 𝔭) (m : A₀) =
        algebraMap A₀ (Localization.AtPrime 𝔭) a₁ at hm
      have ha₁ : a₁ ≠ 0 := by
        rintro rfl
        rw [map_zero] at hm
        exact ha ((IsUnit.mul_left_eq_zero (IsLocalization.map_units _ m)).mp hm)
      have key : algebraMap (Localization.AtPrime 𝔭) Lr a * algebraMap R Lr (algebraMap A₀ R m) =
          algebraMap R Lr (algebraMap A₀ R a₁) := by
        rw [← e1, ← e1, ← map_mul, hm]
      have hu : IsUnit (algebraMap (Localization.AtPrime 𝔭) Lr a *
          algebraMap R Lr (algebraMap A₀ R m)) := by
        rw [key]; exact h4a a₁ ha₁
      exact (IsUnit.mul_iff.mp hu).1

    have hL2 : ∀ (b : B) (y : Lr), b ≠ 0 → b • y = 0 → y = 0 := by
      intro b y hb hby
      obtain ⟨⟨r, m⟩, hm⟩ := IsLocalization.surj (Algebra.algebraMapSubmonoid R 𝔭.primeCompl) b
      change b * algebraMap R B (m : R) = algebraMap R B r at hm
      have hr : r ≠ 0 := by
        rintro rfl
        rw [map_zero] at hm
        exact hb ((IsUnit.mul_left_eq_zero (IsLocalization.map_units B m)).mp hm)
      have h1 : r • y = 0 := by
        rw [← algebraMap_smul B r y, ← hm, mul_comm, mul_smul, hby, smul_zero]
      have hreg := Module.Flat.isSMulRegular_of_nonZeroDivisors (M := Lr) (mem_nonZeroDivisors_of_ne_zero hr)
      exact hreg (show r • y = r • (0 : Lr) by rw [smul_zero]; exact h1)

    have hL3 : Module.Finite (FractionRing B) (TensorProduct B (FractionRing B) Lr) := by
      obtain ⟨G, hG⟩ := h4c
      refine wc_cg2ard_frac_tensor_finite R B Lr G (fun l => ?_)
      obtain ⟨a, ha, hal⟩ := hG l
      exact ⟨algebraMap A₀ R a, (map_ne_zero_iff _ hRBinj).mpr (hψ0 a ha),
        by rw [Algebra.smul_def]; exact hal⟩

    obtain ⟨hFin, hEt⟩ := wc_cg2ard_normalization_localization R S Lr B
      (Algebra.algebraMapSubmonoid R 𝔭.primeCompl) φ e hφfin he

    have hEconj : ∀ (Q : Ideal B) [Q.IsPrime],
        Q.comap (algebraMap (Localization.AtPrime 𝔭) B) ≠ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭) →
        wcCg2LocEtale (algebraMap B (integralClosure B Lr)) Q.primeCompl := by
      intro Q _ hQ
      have hcomap : (Q.comap (algebraMap R B)).comap (algebraMap A₀ R) =
          (Q.comap (algebraMap (Localization.AtPrime 𝔭) B)).comap (algebraMap A₀ (Localization.AtPrime 𝔭)) := by
        ext a
        simp only [Ideal.mem_comap, hAB]
      have hle : Q.comap (algebraMap (Localization.AtPrime 𝔭) B) ≤
          IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭) :=
        IsLocalRing.le_maximalIdeal (Ideal.IsPrime.ne_top inferInstance)
      have hlt : (Q.comap (algebraMap R B)).comap (algebraMap A₀ R) < 𝔭 := by
        rw [hcomap]
        refine lt_of_le_of_ne ((Ideal.comap_mono hle).trans_eq
          (IsLocalization.AtPrime.under_maximalIdeal _ 𝔭)) ?_
        intro heq
        apply hQ
        rw [← IsLocalization.map_comap 𝔭.primeCompl (Localization.AtPrime 𝔭)
            (Q.comap (algebraMap (Localization.AtPrime 𝔭) B)),
          ← IsLocalization.map_comap 𝔭.primeCompl (Localization.AtPrime 𝔭)
            (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭))]
        exact congrArg (Ideal.map (algebraMap A₀ (Localization.AtPrime 𝔭)))
          (heq.trans (IsLocalization.AtPrime.under_maximalIdeal _ 𝔭).symm)
      haveI : (Q.comap (algebraMap R B)).IsPrime := Ideal.IsPrime.comap _
      exact (hEt Q (Q.comap (algebraMap R B)) rfl).mp (hE _ hlt)

    have hiii : wcCg2LocEtale (algebraMap B (integralClosure B Lr))
        ((IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭)).comap s).primeCompl →
        wcCg2LocEtale φ T.primeCompl := by
      intro h
      have hT : ((IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭)).comap s).comap (algebraMap R B) = T := by
        rw [← hθ2]
        ext r
        simp only [Ideal.mem_comap]
        rw [show s (algebraMap R B r) = θ r from IsLocalization.lift_eq hθunit r]
      exact (hEt _ T hT).mpr h

    have hPt : Zp → wcCg2FibrePts s (integralClosure B Lr) := by
      intro hz
      refine wc_cg2ard_points_transfer (Localization.AtPrime 𝔭) B R Lr (FractionRing A₀)
        (Algebra.algebraMapSubmonoid R 𝔭.primeCompl) s
        ((algebraMap (Localization.AtPrime 𝔭) (FractionRing A₀)).comp θ) ?_ ?_ (hZp hz)
      · intro r
        show algebraMap _ (FractionRing A₀) (θ r) =
          algebraMap _ (FractionRing A₀) (IsLocalization.lift hθunit (algebraMap R B r))
        rw [IsLocalization.lift_eq]
      · intro l
        obtain ⟨a, ha, hal⟩ := h4d l
        refine ⟨algebraMap A₀ R a, h4a a ha, ?_, hal⟩
        show algebraMap _ (FractionRing A₀) (θ (algebraMap A₀ R a)) ≠ 0
        rw [show θ (algebraMap A₀ R a) = algebraMap A₀ (Localization.AtPrime 𝔭) a from
          RingHom.congr_fun hθ1 a, ← IsScalarTower.algebraMap_apply]
        exact (map_ne_zero_iff _ (IsFractionRing.injective A₀ (FractionRing A₀))).mpr ha
    exact ⟨Localization.AtPrime 𝔭, inferInstance, inferInstance, inferInstance, hAic, inferInstance,
      B, inferInstance, hBdom, hBic, inferInstance, inferInstance, s, Lr, inferInstance, algBL, algAL,
      inferInstance, hht, hL1, hL2, hL3, hFin, hEconj, hPt, hiii⟩

  haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
  have hH : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R],
      (∀ (q : Ideal R) [q.IsPrime], IsDomain (Localization.AtPrime q) ∧
        IsIntegrallyClosed (Localization.AtPrime q)) →
      ∀ (p : Ideal R) [p.IsPrime], ∃ r : R, r ∉ p ∧ ∀ (S : Type u) [CommRing S] [Algebra R S]
        [IsLocalization.Away r S], IsDomain S ∧ IsIntegrallyClosed S := by
    intro R _ _ hq p' _
    obtain ⟨k, Pk, hPk, hbij⟩ := wc_cud_noetherian_locally_domain_pi R (by intro m _; exact (hq m).1)
    exact wc_fnf_pi_quotient_away_normal_domain R k Pk hPk hbij (by intro q _; exact (hq q).2) p'
  obtain ⟨U, hU, hyU, hUdom, hUic⟩ := wc_fnf_normal_domain_affine_nbhd X hH hnorm (σ (f x))
  haveI := hUdom
  haveI := hUic
  refine ⟨U, hU, hyU, IsLocallyNoetherian.component_noetherian ⟨U, hU⟩, ?_⟩

  have hψs : ((f.appLE ⊤ U le_top).hom.comp (Scheme.ΓSpecIso (.of A₀)).inv.hom).Smooth :=
    RingHom.Smooth.comp
      (RingHom.Smooth.of_bijective (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (.of A₀)).inv))
      (Scheme.Hom.smooth_appLE f (isAffineOpen_top _) hU le_top)
  have hψ0 := (wc_cg2ard_smooth_localization A₀ Γ(X, U) _ hψs 𝔭).1
  have hBsm := (wc_cg2ard_smooth_localization A₀ Γ(X, U) _ hψs 𝔭).2
  letI : Algebra A₀ Γ(X, U) := ((f.appLE ⊤ U le_top).hom.comp (Scheme.ΓSpecIso (.of A₀)).inv.hom).toAlgebra
  letI : Algebra Γ(X, U) Γ(P, (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ⁻¹ᵁ U) :=
    ((p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))).app U).hom.toAlgebra
  letI : Algebra (Localization.AtPrime 𝔭) (Localization (Algebra.algebraMapSubmonoid Γ(X, U) 𝔭.primeCompl)) :=
    localizationAlgebra 𝔭.primeCompl Γ(X, U)
  haveI : Algebra.Smooth (Localization.AtPrime 𝔭)
      (Localization (Algebra.algebraMapSubmonoid Γ(X, U) 𝔭.primeCompl)) := hBsm
  haveI : IsFinite (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) := hfin

  obtain ⟨h4a, h4b, h4c, h4d⟩ := wc_cg2ard_generic_L A₀ X f P p hpfin hpet U hU

  obtain ⟨θ, hθ1, hθ2, hηU, hκ⟩ := wc_cg2ard_section A₀ X f σ hσ U hU 𝔭 (f x) h𝔭 hyU

  have he : ∀ r : Γ(X, U),
      (((Scheme.Hom.normalizationObjIso (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) hU).commRingCatIsoToRingEquiv
        (((Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))).app U).hom r) :
          integralClosure Γ(X, U) Γ(P, (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ⁻¹ᵁ U)) :
        Γ(P, (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ⁻¹ᵁ U)) =
      algebraMap Γ(X, U) Γ(P, (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ⁻¹ᵁ U) r := by
    intro r
    have h0 : ((Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))).app U).hom r =
        (Scheme.Hom.normalizationObjIso (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) hU).commRingCatIsoToRingEquiv.symm
          (algebraMap Γ(X, U) (integralClosure Γ(X, U) Γ(P, (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ⁻¹ᵁ U)) r) := by
      rw [Scheme.Hom.fromNormalization_app _ hU]; rfl
    rw [h0, RingEquiv.apply_symm_apply]; rfl

  have hE : ∀ (Q₀ : Ideal Γ(X, U)) [Q₀.IsPrime], Q₀.comap (algebraMap A₀ Γ(X, U)) < 𝔭 →
      wcCg2LocEtale ((Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))).app U).hom Q₀.primeCompl := by
    intro Q₀ hQ₀ hlt
