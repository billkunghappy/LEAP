    obtain ⟨W, hxW, hW⟩ := H_lt (hU.fromSpec ⟨Q₀, hQ₀⟩) (by rw [hc, h𝔭]; exact hlt)
    exact wc_cg2ard_open_etale_localized _ U hU W hW ⟨Q₀, hQ₀⟩ hxW
  refine core Γ(X, U) hψ0 (Localization (Algebra.algebraMapSubmonoid Γ(X, U) 𝔭.primeCompl))
    (fun a => IsLocalization.map_eq _ _)
    Γ(P, (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ⁻¹ᵁ U)
    Γ(Scheme.Hom.normalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))),
      Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ⁻¹ᵁ U)
    ((Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))).app U).hom
    (Scheme.Hom.normalizationObjIso (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) hU).commRingCatIsoToRingEquiv
    (Scheme.Hom.finite_app _ U hU) he h4a h4b h4c h4d hE θ hθ1
    (hU.primeIdealOf ⟨σ (f x), hyU⟩).asIdeal hθ2 _ ?_

  intro hZ
  have h5 := wc_cg2ard_Z_sections A₀ X f σ hσ P p hpfin U hU hηU hZ
  rw [hκ] at h5
  exact h5

theorem wc_cg2_etale_at_section_point : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (A₀ : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀] [IsNoetherianRing A₀] (κ : K →+* A₀) (X : Scheme.{u}) [CompactSpace X] [QuasiSeparatedSpace X] (f : X ⟶ Spec (.of A₀)) [Smooth f] (σ : Spec (.of A₀) ⟶ X) (hσ : σ ≫ f = 𝟙 _), (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A₀)), ConnectedSpace ↥(Limits.pullback f z)) → ∀ (P : Scheme.{u}) (p : P ⟶ Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) (α : ZMod ℓ → (P ⟶ P)), wcFetTorsor p ℓ α → (∃ r : Spec (.of (FractionRing A₀)) ⟶ P, r ≫ p = Limits.pullback.lift (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))) ≫ σ) (𝟙 _) (by rw [Category.assoc, hσ, Category.comp_id, Category.id_comp])) → ∀ [QuasiCompact (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))] [QuasiSeparated (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))], (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) → IsFinite (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) → IsPullback (Scheme.Hom.toNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) p (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) → ∀ x : X, 2 ≤ (f x).asIdeal.height → (∀ x' : X, (f x').asIdeal < (f x).asIdeal → ∃ W : X.Opens, x' ∈ W ∧ Etale (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ∣_ W)) → ∃ W : X.Opens, σ (f x) ∈ W ∧ Etale (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ∣_ W) :=
by
  intro K _ _ ℓ hℓ hℓK A₀ _ _ _ _ κ X _ _ f _ σ hσ hconn P p α hP hr _ _ hnorm hfin hpb x hx H_lt
  obtain ⟨r, hr⟩ := hr
  obtain ⟨U, hU, hyU, hUn, A, _, _, _, _, _, B, _, _, _, _, _, s, L, _, _, _, _, h2, hL1, hL2, hL3,
    hFin, hE, hPtT, hEt⟩ := wc_cg2_affine_ring_data A₀ X f σ hσ P p hP.finite hP.etale hnorm hfin
      hpb x hx H_lt
  have hZ := wc_cg2_torsor_point_fibre p ℓ α hP hℓ.ne_zero (FractionRing A₀) _ r hr
  have hcore := wc_cg2_ring_core A h2 B s L hL1 hL2 hL3 hFin hE (hPtT hZ)
  haveI := hfin
  exact wc_cg2_open_of_stalk_etale _ U hU hUn (σ (f x)) hyU (hEt hcore)

