import WeilR2_Part06
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem wc_ord_locally_surjective_lft : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [LocallyOfFiniteType fX]
    [IsIntegral X], (∀ x : X, IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ ord : wcEtGmAtPre X (genericPoint X) ⟶ wcEtDivPre Ω X fX, wcOrdChar Ω X fX ord →
    Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X) ord :=
by
  intro Ω _ _ X fX _ _ hnorm hdim ord hchar

  have hval : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
      (ϖ : R) (v : Rˣ) (n : ℕ), Irreducible ϖ → wcLocVal R ((v : R) * ϖ ^ n) = n := by
    intro R _ _ _ ϖ v n hϖ
    classical
    unfold wcLocVal
    have hex : ∃ (n' : ℕ) (v' : Rˣ) (ϖ' : R), Irreducible ϖ' ∧
        (v : R) * ϖ ^ n = (v' : R) * ϖ' ^ n' := ⟨n, v, ϖ, hϖ, rfl⟩
    rw [dif_pos hex, Nat.find_eq_iff]
    refine ⟨⟨v, ϖ, hϖ, rfl⟩, fun m hm ⟨v', ϖ', hϖ', heq⟩ => ?_⟩
    have := IsDiscreteValuationRing.unit_mul_pow_congr_pow hϖ hϖ' v v' n m heq
    omega
  have hv0 : ∀ (R : Type u) [CommRing R] (r : R), IsUnit r → wcLocVal R r = 0 := by
    intro R _ r hr
    classical
    unfold wcLocVal
    split_ifs with h
    · rw [Nat.find_eq_zero]
      obtain ⟨n, w, ϖ, hϖ, _⟩ := h
      exact ⟨hr.unit, ϖ, hϖ, by simp⟩
    · rfl

  have hs2 : ∀ (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of Ω)) [LocallyOfFiniteType fY] (ξ : Y),
      ∃ s : Spec (.of Ω) ⟶ Y, s ≫ fY = 𝟙 _ ∧ ξ ⤳ s (IsLocalRing.closedPoint Ω) := by
    intro Y fY _ ξ
    haveI : JacobsonSpace Y := LocallyOfFiniteType.jacobsonSpace fY
    obtain ⟨y, hyξ, hyc⟩ := nonempty_inter_closedPoints (Z := closure ({ξ} : Set Y))
      ⟨ξ, subset_closure rfl⟩ isClosed_closure.isLocallyClosed
    have hxy : ξ ⤳ y := specializes_iff_mem_closure.mpr hyξ
    have hyc' : IsClosed ({y} : Set Y) := hyc
    haveI : LocallyOfFiniteType (Y.fromSpecResidueField y) :=
      isClosed_singleton_iff_locallyOfFiniteType.mp hyc'
    let ψ : CommRingCat.of Ω ⟶ Y.residueField y := Spec.preimage (Y.fromSpecResidueField y ≫ fY)
    have hψ : Spec.map ψ = Y.fromSpecResidueField y ≫ fY := Spec.map_preimage _
    have hft : ψ.hom.FiniteType := by
      have : LocallyOfFiniteType (Spec.map ψ) := by rw [hψ]; infer_instance
      exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp this
    letI : Algebra Ω (Y.residueField y) := ψ.hom.toAlgebra
    haveI : Algebra.FiniteType Ω (Y.residueField y) := hft
    haveI : Module.Finite Ω (Y.residueField y) := finite_of_finite_type_of_isJacobsonRing Ω _
    have hsurj : Function.Surjective ψ.hom := by
      intro s
      have hs : IsIntegral Ω s := Algebra.IsIntegral.isIntegral s
      have hdeg := IsAlgClosed.degree_eq_one_of_irreducible Ω (minpoly.irreducible hs)
      obtain ⟨c, hc⟩ := minpoly.mem_range_of_degree_eq_one Ω s hdeg
      exact ⟨c, hc⟩
    let e : Ω ≃+* Y.residueField y := RingEquiv.ofBijective ψ.hom ⟨ψ.hom.injective, hsurj⟩
    refine ⟨Spec.map (CommRingCat.ofHom (e.symm : Y.residueField y →+* Ω)) ≫
      Y.fromSpecResidueField y, ?_, ?_⟩
    · rw [Category.assoc, ← hψ, ← Spec.map_comp, ← Spec.map_id]
      congr 1
      ext c
      change e.symm (ψ.hom c) = c
      exact e.symm_apply_apply c
    · have h1 : (Spec.map (CommRingCat.ofHom (e.symm : Y.residueField y →+* Ω)) ≫
          Y.fromSpecResidueField y) (IsLocalRing.closedPoint Ω) = y :=
        (Scheme.Hom.comp_apply _ _ _).trans (Scheme.fromSpecResidueField_apply _ _)
      rw [h1]
      exact hxy

  have huniq : ∀ (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of Ω)) (s s' : Spec (.of Ω) ⟶ Y),
      s ≫ fY = 𝟙 _ → s' ≫ fY = 𝟙 _ →
      s (IsLocalRing.closedPoint Ω) = s' (IsLocalRing.closedPoint Ω) → s = s' := by
    intro Y fY s s' hs hs' hpt
    have key : ∀ (y : Y) (φ φ' : Y.residueField y ⟶ CommRingCat.of Ω),
        Spec.map φ ≫ Y.fromSpecResidueField y ≫ fY = 𝟙 _ →
        Spec.map φ' ≫ Y.fromSpecResidueField y ≫ fY = 𝟙 _ → φ = φ' := by
      intro y φ φ' h1 h2
      let ψ : CommRingCat.of Ω ⟶ Y.residueField y := Spec.preimage (Y.fromSpecResidueField y ≫ fY)
      have hψ : Spec.map ψ = Y.fromSpecResidueField y ≫ fY := Spec.map_preimage _
      have e1 : ψ ≫ φ = 𝟙 _ := by
        apply Spec.map_injective
        rw [Spec.map_comp, hψ, h1, Spec.map_id]
      have e2 : ψ ≫ φ' = 𝟙 _ := by
        apply Spec.map_injective
        rw [Spec.map_comp, hψ, h2, Spec.map_id]
      have f1 : ∀ c, φ.hom (ψ.hom c) = c := fun c => congrArg (fun F => F.hom c) e1
      have f2 : ∀ c, φ'.hom (ψ.hom c) = c := fun c => congrArg (fun F => F.hom c) e2
      have g1 : ∀ t, ψ.hom (φ.hom t) = t := fun t => φ.hom.injective (f1 _)
      ext t
      rw [← g1 t, f2, f1]
    have e1 := Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField Ω Y s
    have e2 := Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField Ω Y s'
    obtain ⟨φ, hφ⟩ : ∃ φ : Y.residueField (s' (IsLocalRing.closedPoint Ω)) ⟶ CommRingCat.of Ω,
        Spec.map φ ≫ Y.fromSpecResidueField (s' (IsLocalRing.closedPoint Ω)) = s := by
      rw [← hpt]; exact ⟨_, e1⟩
    obtain ⟨φ', hφ'⟩ : ∃ φ' : Y.residueField (s' (IsLocalRing.closedPoint Ω)) ⟶ CommRingCat.of Ω,
        Spec.map φ' ≫ Y.fromSpecResidueField (s' (IsLocalRing.closedPoint Ω)) = s' := ⟨_, e2⟩
    have := key _ φ φ' (by rw [← Category.assoc, hφ, hs]) (by rw [← Category.assoc, hφ', hs'])
    subst this
    exact hφ.symm.trans hφ'

  have hgerm : ∀ (U : X.Etale) (O : X.Opens) (W : U.left.Opens) (hW : W ≤ U.hom ⁻¹ᵁ O)
      (a : Γ(X, O)) (y : U.left) (hy : y ∈ W),
      U.left.presheaf.germ W y hy (wcPull X U O W hW a) =
        (U.hom.stalkMap y).hom (X.presheaf.germ O (U.hom y) (hW hy) a) := by
    intro U O W hW a y hy
    exact (TopCat.Presheaf.germ_res_apply U.left.presheaf (homOfLE hW) y hy ((U.hom.app O).hom a)).trans
      (Scheme.Hom.germ_stalkMap_apply U.hom O y (hW hy) a).symm

  have hiso : ∀ (Y : Scheme.{u}) [IsLocallyNoetherian Y] (y : Y), IsClosed ({y} : Set Y) →
      wcIsDVR (Y.presheaf.stalk y) → ∀ (W : Y.Opens) (hy : y ∈ W) (f : Γ(Y, W)),
      Y.presheaf.germ W y hy f ≠ 0 → ∃ (N : Y.Opens) (hN : N ≤ W), y ∈ N ∧
        ∀ (z : Y) (hz : z ∈ N), z ≠ y → IsUnit (Y.presheaf.germ W z (hN hz) f) := by
    intro Y _ y hcl hdvr W hy f hf
    classical
    obtain ⟨hdom, hdvr⟩ := hdvr
    obtain ⟨V, hV, hyV, hVW⟩ := exists_isAffineOpen_mem_and_subset hy
    have hVW' : V ≤ W := hVW
    haveI : IsNoetherianRing Γ(Y, V) := IsLocallyNoetherian.component_noetherian ⟨V, hV⟩
    let f' : Γ(Y, V) := Y.presheaf.map (homOfLE hVW').op f
    have hgf : ∀ (z : Y) (hz : z ∈ V), Y.presheaf.germ V z hz f' = Y.presheaf.germ W z (hVW' hz) f :=
      fun z hz => TopCat.Presheaf.germ_res_apply Y.presheaf (homOfLE hVW') z hz f
    have hunit : ∀ (z : Y) (hz : z ∈ V) (r : Γ(Y, V)),
        IsUnit (Y.presheaf.germ V z hz r) ↔ r ∉ (hV.primeIdealOf ⟨z, hz⟩).asIdeal := by
      intro z hz r
      letI := TopCat.Presheaf.algebra_section_stalk Y.presheaf (⟨z, hz⟩ : V)
      haveI := hV.isLocalization_stalk ⟨z, hz⟩
      exact IsLocalization.AtPrime.isUnit_to_map_iff (Y.presheaf.stalk z)
        (hV.primeIdealOf ⟨z, hz⟩).asIdeal r
    let m := hV.primeIdealOf ⟨y, hyV⟩
    have hspec : ∀ (z : Y) (hz : z ∈ V), m ≤ hV.primeIdealOf ⟨z, hz⟩ → z = y := by
      intro z hz hle
      have h1 : m ⤳ hV.primeIdealOf ⟨z, hz⟩ := (PrimeSpectrum.le_iff_specializes _ _).mp hle
      have h2 := h1.map hV.fromSpec.continuous
      rw [IsAffineOpen.fromSpec_primeIdealOf, IsAffineOpen.fromSpec_primeIdealOf] at h2
      have h3 : z ∈ closure ({y} : Set Y) := specializes_iff_mem_closure.mp h2
      rw [hcl.closure_eq] at h3
      exact h3
    have hkey : ∀ P : Ideal Γ(Y, V), P.IsPrime → f' ∈ P → P ≤ m.asIdeal → P = m.asIdeal := by
      intro P hP hfP hPm
      letI := TopCat.Presheaf.algebra_section_stalk Y.presheaf (⟨y, hyV⟩ : V)
      haveI := hV.isLocalization_stalk ⟨y, hyV⟩
      have hdisj : Disjoint (m.asIdeal.primeCompl : Set Γ(Y, V)) (P : Set Γ(Y, V)) := by
        rw [Set.disjoint_left]
        intro r hr hrP
        exact hr (hPm hrP)
      have hQp := IsLocalization.isPrime_of_isPrime_disjoint m.asIdeal.primeCompl
        (Y.presheaf.stalk y) P hP hdisj
      have hQne : Ideal.map (algebraMap Γ(Y, V) (Y.presheaf.stalk y)) P ≠ ⊥ := by
        intro h0
        have hm : algebraMap Γ(Y, V) (Y.presheaf.stalk y) f' ∈
            Ideal.map (algebraMap Γ(Y, V) (Y.presheaf.stalk y)) P := Ideal.mem_map_of_mem _ hfP
        rw [h0, Ideal.mem_bot] at hm
        apply hf
        rw [← hgf y hyV]
        exact hm
      have hQm := IsLocalRing.eq_maximalIdeal (hQp.isMaximal hQne)
      have e1 := IsLocalization.under_map_of_isPrime_disjoint m.asIdeal.primeCompl
        (Y.presheaf.stalk y) hP hdisj
      have e2 := IsLocalization.AtPrime.under_maximalIdeal (Y.presheaf.stalk y) m.asIdeal
      rw [hQm] at e1
      exact e1.symm.trans e2
    let Ms := (Ideal.span {f'}).minimalPrimes
    have hfin : Ms.Finite := Ideal.finite_minimalPrimes_of_isNoetherianRing _ _
    have hex : ∀ P ∈ Ms, P ≠ m.asIdeal → ∃ g ∈ P, g ∉ m.asIdeal := by
      intro P hP hne
      by_contra hcon
      push_neg at hcon
      apply hne
      have hPp : P.IsPrime := hP.1.1
      have hfP : f' ∈ P := hP.1.2 (Ideal.subset_span rfl)
      exact hkey P hPp hfP hcon
    let gfun : Ideal Γ(Y, V) → Γ(Y, V) := fun P =>
      if h : P ∈ Ms ∧ P ≠ m.asIdeal then Classical.choose (hex P h.1 h.2) else 1
    have hgfun : ∀ P, gfun P ∉ m.asIdeal := by
      intro P
      simp only [gfun]
      split_ifs with h
      · exact (Classical.choose_spec (hex P h.1 h.2)).2
      · intro h1
        exact m.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
    have hgfunP : ∀ P, P ∈ Ms → P ≠ m.asIdeal → gfun P ∈ P := by
      intro P h1 h2
      simp only [gfun, dif_pos (And.intro h1 h2)]
      exact (Classical.choose_spec (hex P h1 h2)).1
    let g : Γ(Y, V) := ∏ P ∈ hfin.toFinset, gfun P
    have hgm : g ∉ m.asIdeal := by
      intro h
      haveI := m.isPrime
      obtain ⟨P, -, hP⟩ := (Ideal.IsPrime.prod_mem_iff).mp h
      exact hgfun P hP
    refine ⟨Y.basicOpen g, (Y.basicOpen_le g).trans hVW', ?_, ?_⟩
    · rw [Scheme.mem_basicOpen Y g y hyV, hunit]
      exact hgm
    · intro z hz hzy
      have hzV : z ∈ V := Y.basicOpen_le g hz
      have hgz : g ∉ (hV.primeIdealOf ⟨z, hzV⟩).asIdeal := by
        rw [← hunit]; exact (Scheme.mem_basicOpen Y g z hzV).mp hz
      rw [← hgf z hzV, hunit]
      intro hfz
      haveI := (hV.primeIdealOf ⟨z, hzV⟩).isPrime
      obtain ⟨P, hPM, hPz⟩ := Ideal.exists_minimalPrimes_le
        ((Ideal.span_singleton_le_iff_mem _).mpr hfz)
      by_cases hPm : P = m.asIdeal
      · apply hzy
        apply hspec z hzV
        rw [← PrimeSpectrum.asIdeal_le_asIdeal, ← hPm]
        exact hPz
      · apply hgz
        apply Ideal.mem_of_dvd _ (Finset.dvd_prod_of_mem gfun ((Set.Finite.mem_toFinset hfin).mpr hPM))
        exact hPz (hgfunP P hPM hPm)

  have hcong : ∀ {A B : Scheme.{u}} (f g : A ⟶ B) (O' : B.Opens) (V : A.Opens)
      (e : V ≤ f ⁻¹ᵁ O') (e' : V ≤ g ⁻¹ᵁ O'), f = g → f.appLE O' V e = g.appLE O' V e' := by
    intro A B f g O' V e e' hfg
    subst hfg
    rfl
  have hσu : ∀ (U : X.Etale) (O : X.Opens) (W : U.left.Opens) (hW : W ≤ U.hom ⁻¹ᵁ O) (a : Γ(X, O)),
      a ≠ 0 → IsUnit (wcGenSigma X U W (wcPull X U O W hW a)) := by
    intro U O W hW a ha
    have hO : genericPoint X ∈ O := by
      by_contra hη
      have hOe : O = ⊥ := by
        ext y
        simp only [TopologicalSpace.Opens.coe_bot, Set.mem_empty_iff_false, iff_false]
        intro hy
        exact hη (((genericPoint_spec X).mem_open_set_iff O.isOpen).mpr ⟨y, trivial, hy⟩)
      have hs : Subsingleton Γ(X, O) :=
        CommRingCat.subsingleton_of_isTerminal (X.sheaf.isTerminalOfEqEmpty hOe)
      exact ha (@Subsingleton.elim _ hs _ _)
    have hu : IsUnit ((X.presheaf.germ O (genericPoint X) hO).hom a) := by
      rw [isUnit_iff_ne_zero]
      intro h0
      apply ha
      apply germ_injective_of_isIntegral X (genericPoint X) hO
      rw [h0, map_zero]
    have e1 : (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ W ≤
        (Limits.pullback.snd U.hom (X.fromSpecStalk (genericPoint X)) ≫
          X.fromSpecStalk (genericPoint X)) ⁻¹ᵁ O := by
      intro p hp
      have hp' : (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X)) ≫ U.hom) p ∈ O := by
        rw [Scheme.Hom.comp_apply]
        exact hW hp
      rw [Limits.pullback.condition] at hp'
      exact hp'
    have key : U.hom.appLE O W hW ≫ (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))).app W =
        (X.fromSpecStalk (genericPoint X)).app O ≫
          (Limits.pullback.snd U.hom (X.fromSpecStalk (genericPoint X))).appLE
            ((X.fromSpecStalk (genericPoint X)) ⁻¹ᵁ O)
            ((Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ W) e1 := by
      rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE, ← Scheme.Hom.comp_appLE]
      exact hcong _ _ _ _ _ _ Limits.pullback.condition
    have e2 : wcGenSigma X U W (wcPull X U O W hW a) =
        (U.hom.appLE O W hW ≫ (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))).app W).hom a :=
      rfl
    rw [e2, key, Scheme.fromSpecStalk_app hO]
    simp only [CommRingCat.hom_comp, RingHom.comp_apply]
    exact ((hu.map _).map _).map _

  have hρ : ∀ (V : X.Etale) (e : Γ(V.left, ⊤)), wcGenRho X V e =
      (Limits.pullback.fst V.hom (X.fromSpecStalk (genericPoint X))).appTop.hom e := by
    intro V e
    (simp [wcGenRho, Over.mapPullbackAdj_counit_app, Scheme.Γ_map]) <;> rfl
  have hbridge : ∀ (V : X.Etale) (e : Γ(V.left, ⊤)),
      wcGenRestr X V ⊤ (wcGenRho X V e) = wcGenSigma X V ⊤ e := by
    intro V e
    rw [hρ]
    unfold wcGenRestr wcGenSigma
    have h2 : (homOfLE le_top : (Limits.pullback.fst V.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ ⊤ ⟶
        (Limits.pullback.fst V.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ ⊤) = 𝟙 _ :=
      Subsingleton.elim _ _
    erw [h2, op_id, CategoryTheory.Functor.map_id]
    rfl
  have hρu : ∀ (V : X.Etale) (e : Γ(V.left, ⊤)), IsUnit (wcGenSigma X V ⊤ e) →
      IsUnit (wcGenRho X V e) := by
    intro V e h
    rw [hρ]
    exact h

  haveI hXN : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian fX

  have hrpt : ∀ (U : X.Etale) (s : wcEtPts Ω X fX U),
      wcIsDVR (U.left.presheaf.stalk (s.1 (IsLocalRing.closedPoint Ω))) ∧
      IsClosed ({s.1 (IsLocalRing.closedPoint Ω)} : Set U.left) ∧
      U.hom (s.1 (IsLocalRing.closedPoint Ω)) ≠ genericPoint X := by
    intro U s
    have hrange : ∀ {Y : Scheme.{u}} (t : Spec (.of Ω) ⟶ Y), IsClosedImmersion t →
        IsClosed ({t (IsLocalRing.closedPoint Ω)} : Set Y) := by
      intro Y t ht
      have h1 : Set.range (⇑t) = {t (IsLocalRing.closedPoint Ω)} := by
        ext x
        constructor
        · rintro ⟨a, rfl⟩
          rw [Subsingleton.elim a (IsLocalRing.closedPoint Ω)]
          rfl
        · rintro rfl
          exact ⟨_, rfl⟩
      rw [← h1]
      exact t.isClosedEmbedding.isClosed_range
    have hy : IsClosed ({s.1 (IsLocalRing.closedPoint Ω)} : Set U.left) := by
      haveI := isClosedImmersion_of_comp_eq_id (U.hom ≫ fX) s.1 s.2
      exact hrange s.1 inferInstance
    have hz : IsClosed ({U.hom (s.1 (IsLocalRing.closedPoint Ω))} : Set X) := by
      haveI := isClosedImmersion_of_comp_eq_id fX (s.1 ≫ U.hom) (by rw [Category.assoc]; exact s.2)
      have := hrange (s.1 ≫ U.hom) inferInstance
      have e : (s.1 ≫ U.hom) (IsLocalRing.closedPoint Ω) = U.hom (s.1 (IsLocalRing.closedPoint Ω)) :=
        Scheme.Hom.comp_apply _ _ _
      rw [e] at this
      exact this
    have hne : U.hom (s.1 (IsLocalRing.closedPoint Ω)) ≠ genericPoint X := by
      intro heq
      rw [heq] at hz
      have huniv : (Set.univ : Set X) = {genericPoint X} := by
        rw [← hz.closure_eq]
        exact (isGenericPoint_def.mp (genericPoint_spec X)).symm
      have hS : ∀ S : TopologicalSpace.IrreducibleCloseds X, (S : Set X) = {genericPoint X} := by
        intro S
        apply Set.Subset.antisymm
        · rw [← huniv]; exact Set.subset_univ _
        · obtain ⟨a, ha⟩ := S.isIrreducible.nonempty
          have hmem : a ∈ (Set.univ : Set X) := Set.mem_univ a
          rw [huniv] at hmem
          rw [Set.singleton_subset_iff, ← Set.mem_singleton_iff.mp hmem]
          exact ha
      haveI : Subsingleton (TopologicalSpace.IrreducibleCloseds X) := ⟨fun S T => by
        apply TopologicalSpace.IrreducibleCloseds.ext
        rw [hS S, hS T]⟩
      have h0 : topologicalKrullDim X ≤ 0 := by
        rw [topologicalKrullDim]
        exact Order.krullDim_nonpos_of_subsingleton
      rw [hdim] at h0
      norm_num at h0
    have hdvrX : ∀ z : X, z ≠ genericPoint X → wcIsDVR (X.presheaf.stalk z) := by
      intro z hz0
      have hnf : ¬ IsField (X.presheaf.stalk z) := by
        intro hF
        have hm : IsLocalRing.maximalIdeal (X.presheaf.stalk z) = ⊥ :=
          (IsLocalRing.isField_iff_maximalIdeal_eq).mp hF
        have hsub : ∀ a b : PrimeSpectrum (X.presheaf.stalk z), a = b := by
          intro a b
          have ha : a.asIdeal = ⊥ :=
            le_bot_iff.mp (hm ▸ IsLocalRing.le_maximalIdeal a.isPrime.ne_top)
          have hb : b.asIdeal = ⊥ :=
            le_bot_iff.mp (hm ▸ IsLocalRing.le_maximalIdeal b.isPrime.ne_top)
          exact PrimeSpectrum.ext (ha.trans hb.symm)
        have hη : genericPoint X ∈ Set.range (X.fromSpecStalk z) := by
          rw [Scheme.range_fromSpecStalk]
          exact (genericPoint_spec X).specializes (Set.mem_univ z)
        obtain ⟨a, ha⟩ := hη
        have hc := Scheme.fromSpecStalk_closedPoint (X := X) (x := z)
        rw [hsub a (IsLocalRing.closedPoint _)] at ha
        exact hz0 (hc.symm.trans ha)
      have hdimR : ringKrullDim (X.presheaf.stalk z) ≤ ((1 : ℕ) : WithBot ℕ∞) := by
        rw [← hdim]
        calc ringKrullDim (X.presheaf.stalk z)
            = topologicalKrullDim (PrimeSpectrum (X.presheaf.stalk z)) :=
              (PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim _).symm
          _ = topologicalKrullDim (Set.range (X.fromSpecStalk z)) :=
              IsHomeomorph.topologicalKrullDim_eq _
                (Scheme.Hom.isEmbedding (X.fromSpecStalk z)).toHomeomorph.isHomeomorph
          _ ≤ topologicalKrullDim X := topologicalKrullDim_subspace_le X _
      have hex : ∃! P : Ideal (X.presheaf.stalk z), P ≠ ⊥ ∧ P.IsPrime := by
        refine ⟨IsLocalRing.maximalIdeal _, ⟨?_, (IsLocalRing.maximalIdeal.isMaximal _).isPrime⟩, ?_⟩
        · intro h
          exact hnf ((IsLocalRing.isField_iff_maximalIdeal_eq).mpr h)
        · rintro Q ⟨hQ0, hQ⟩
          haveI : Ring.KrullDimLE 1 (X.presheaf.stalk z) := Ring.krullDimLE_iff.mpr hdimR
          rcases Ring.krullDimLE_one_iff.mp this Q hQ with h | h
          · rw [IsDomain.minimalPrimes_eq_singleton_bot] at h
            exact absurd h hQ0
          · exact IsLocalRing.eq_maximalIdeal h
      have h4 : IsIntegrallyClosed (X.presheaf.stalk z) ∧
          ∃! P : Ideal (X.presheaf.stalk z), P ≠ ⊥ ∧ P.IsPrime := ⟨hnorm z, hex⟩
      have hdvr : IsDiscreteValuationRing (X.presheaf.stalk z) :=
        ((IsDiscreteValuationRing.TFAE (X.presheaf.stalk z) hnf).out 1 4).mpr h4
      exact (⟨inferInstance, hdvr⟩ : ∃ _ : IsDomain (X.presheaf.stalk z),
        IsDiscreteValuationRing (X.presheaf.stalk z))
    have hRz := hdvrX _ hne
    haveI : IsLocallyNoetherian ((Functor.fromPUnit X).obj U.right) :=
      inferInstanceAs (IsLocallyNoetherian X)
    haveI : Etale U.hom := U.prop
    exact ⟨(wc_etale_stalk_dvr U.hom (s.1 (IsLocalRing.closedPoint Ω)) hRz).1, hy, hne⟩

  classical
  constructor
  intro U d
  let d' : wcEtDivSub Ω X fX U := d.down
  haveI : Etale U.hom := U.prop
  haveI : LocallyOfFiniteType (U.hom ≫ fX) := inferInstance
  haveI : IsLocallyNoetherian U.left := LocallyOfFiniteType.isLocallyNoetherian (U.hom ≫ fX)
  have hXpt : ∀ s : wcEtPts Ω X fX U,
      wcIsDVR (X.presheaf.stalk (U.hom (s.1 (IsLocalRing.closedPoint Ω)))) ∧
        IsClosed ({U.hom (s.1 (IsLocalRing.closedPoint Ω))} : Set X) := by
    intro s
    have h := hrpt (wcEtTop X) ⟨s.1 ≫ U.hom, by
      have h : (s.1 ≫ U.hom) ≫ fX = 𝟙 _ := by rw [Category.assoc]; exact s.2
      exact (congrArg (fun k => (s.1 ≫ U.hom) ≫ k) (Category.id_comp fX)).trans h⟩
    exact ⟨h.1, h.2.1⟩
  apply wc_etale_jointly_surjective_covers X U
  intro x
  obtain ⟨s₁, hs₁, hxy⟩ := hs2 U.left (U.hom ≫ fX) x
  let s₀ : wcEtPts Ω X fX U := ⟨s₁, hs₁⟩
  have hclU := (hrpt U s₀).2.1
  have hdvrU := (hrpt U s₀).1
  obtain ⟨hdq, hdvrq⟩ := (hXpt s₀).1
  obtain ⟨ϖ, hϖ⟩ := @IsDiscreteValuationRing.exists_irreducible _ _ hdq hdvrq
  obtain ⟨O, hqO, a, ha⟩ := TopCat.Presheaf.exists_germ_eq X.presheaf ϖ
  have ha0 : a ≠ 0 := by
    intro h0
    apply hϖ.ne_zero
    rw [← ha, h0, map_zero]
  have hyW0 : s₁ (IsLocalRing.closedPoint Ω) ∈ U.hom ⁻¹ᵁ O := hqO
  have hirrq : ∀ (w : X) (hw : w ∈ O), w = U.hom (s₁ (IsLocalRing.closedPoint Ω)) →
      wcIsDVR (X.presheaf.stalk w) ∧ Irreducible (X.presheaf.germ O w hw a) := by
    rintro w hw rfl
    refine ⟨(hXpt s₀).1, ?_⟩
    rw [show X.presheaf.germ O (U.hom (s₁ (IsLocalRing.closedPoint Ω))) hw a = ϖ from ha]
    exact hϖ
  have hfy : U.left.presheaf.germ (U.hom ⁻¹ᵁ O) (s₁ (IsLocalRing.closedPoint Ω)) hyW0
      (wcPull X U O (U.hom ⁻¹ᵁ O) le_rfl a) ≠ 0 := by
    rw [hgerm U O (U.hom ⁻¹ᵁ O) le_rfl a _ hyW0]
    obtain ⟨hdv, hirr⟩ := hirrq _ hyW0 rfl
    exact ((@wc_etale_stalk_dvr U.left X U.hom _ hXN _ hdv).2 _ hirr).ne_zero
  obtain ⟨N, hN, hyN, hNunit⟩ := hiso U.left _ hclU hdvrU (U.hom ⁻¹ᵁ O) hyW0 _ hfy
  have hNunitX : ∀ (z : U.left) (hz : z ∈ N), z ≠ s₁ (IsLocalRing.closedPoint Ω) →
      IsUnit (X.presheaf.germ O (U.hom z) (hN hz) a) := by
    intro z hz hzy
    have h1 := hNunit z hz hzy
    rw [hgerm U O (U.hom ⁻¹ᵁ O) le_rfl a z (hN hz)] at h1
    exact (isUnit_map_iff _ _).mp h1
  obtain ⟨Wd, hWdo, hyWd, T, hT, hTprop⟩ := d'.2 (s₁ (IsLocalRing.closedPoint Ω))
  let S : Set X := {t | t ∈ T ∧ t ≠ U.hom (s₁ (IsLocalRing.closedPoint Ω)) ∧ IsClosed ({t} : Set X)}
  have hSc : IsClosed S := by
    have h := (hT.subset (fun t (ht : t ∈ S) => ht.1)).isClosed_biUnion
      (f := fun t => ({t} : Set X)) (fun t ht => ht.2.2)
    rwa [Set.biUnion_of_singleton] at h
  let N' : U.left.Opens := N ⊓ ⟨Wd, hWdo⟩ ⊓ U.hom ⁻¹ᵁ ⟨Sᶜ, hSc.isOpen_compl⟩
  have hyN' : s₁ (IsLocalRing.closedPoint Ω) ∈ N' := ⟨⟨hyN, hyWd⟩, fun h => h.2.1 rfl⟩
  have hN'W : N' ≤ U.hom ⁻¹ᵁ O := fun z hz => hN hz.1.1
  have hsupp : ∀ s : wcEtPts Ω X fX U, s.1 (IsLocalRing.closedPoint Ω) ∈ N' → d'.1 s ≠ 0 →
      s.1 (IsLocalRing.closedPoint Ω) = s₁ (IsLocalRing.closedPoint Ω) := by
    intro s hz hd
    by_contra hzy
    have hT' : U.hom (s.1 (IsLocalRing.closedPoint Ω)) ∈ T := hTprop s hd hz.1.2
    have hq : U.hom (s.1 (IsLocalRing.closedPoint Ω)) = U.hom (s₁ (IsLocalRing.closedPoint Ω)) := by
      by_contra hne
      exact hz.2 ⟨hT', hne, (hXpt s).2⟩
    have hu := hNunitX _ hz.1.1 hzy
    exact (hirrq _ (hN hz.1.1) hq).2.not_isUnit hu
  let V₁ : X.Etale := wcEtOpen X U N'
  let c : V₁ ⟶ U := wcEtOpenι X U N'
  haveI : Etale V₁.hom := V₁.prop
  have hO1 : ⊤ ≤ V₁.hom ⁻¹ᵁ O := fun z _ => hN'W (by
    have : N'.ι z ∈ Set.range N'.ι := ⟨z, rfl⟩
    rwa [Scheme.Opens.range_ι] at this)
  let e : Γ(V₁.left, ⊤) := wcPull X V₁ O ⊤ hO1 a
  have hσe : IsUnit (wcGenSigma X V₁ ⊤ e) := hσu V₁ O ⊤ hO1 a ha0
  have he : IsUnit (wcGenRho X V₁ e) := hρu V₁ e hσe
  have hgermV : ∀ z' : V₁.left,
      (N'.ι z' = s₁ (IsLocalRing.closedPoint Ω) →
        Irreducible (V₁.left.presheaf.germ ⊤ z' trivial e)) ∧
      (N'.ι z' ≠ s₁ (IsLocalRing.closedPoint Ω) →
        IsUnit (V₁.left.presheaf.germ ⊤ z' trivial e)) := by
    intro z'
    have hz : N'.ι z' ∈ N' := by
      have : N'.ι z' ∈ Set.range N'.ι := ⟨z', rfl⟩
      rwa [Scheme.Opens.range_ι] at this
    refine ⟨fun hzy => ?_, fun hzy => ?_⟩
    · rw [hgerm V₁ O ⊤ hO1 a z' trivial]
      obtain ⟨hdv, hirr⟩ := hirrq (V₁.hom z') (hO1 trivial)
        (show U.hom (N'.ι z') = U.hom (s₁ (IsLocalRing.closedPoint Ω)) by rw [hzy])
      exact (@wc_etale_stalk_dvr V₁.left X V₁.hom _ hXN z' hdv).2 _ hirr
    · rw [hgerm V₁ O ⊤ hO1 a z' trivial]
      exact IsUnit.map _ (hNunitX (N'.ι z') hz.1.1 hzy)
  let m : ℤ := d'.1 s₀
  let b : (Γ(wcGenPt X V₁, ⊤))ˣ := he.unit ^ m
  refine ⟨V₁, c, ?_, ?_⟩
  swap
  · show x ∈ Set.range N'.ι
    rw [Scheme.Opens.range_ι]
    exact Specializes.mem_open hxy N'.isOpen hyN'
  rw [Presheaf.imageSieve_apply]
  refine ⟨ULift.up (Additive.ofMul b), ?_⟩
  apply ULift.ext
  apply Subtype.ext
  funext s'
  have hu : ((he.unit : (Γ(wcGenPt X V₁, ⊤))ˣ) : Γ(wcGenPt X V₁, ⊤)) = wcGenRho X V₁ e :=
    he.unit_spec
  have hU : he.unit ^ m * he.unit ^ ((-m).toNat) = he.unit ^ (m.toNat) := by
    rw [← zpow_natCast, ← zpow_natCast, ← zpow_add]
    congr 1
    omega
  have hU' := congrArg (fun w : (Γ(wcGenPt X V₁, ⊤))ˣ =>
    wcGenRestr X V₁ ⊤ (w : Γ(wcGenPt X V₁, ⊤))) hU
  simp only [Units.val_mul, Units.val_pow_eq_pow_val, map_mul, map_pow, hu, hbridge] at hU'
  obtain ⟨hdz, hdvz⟩ := (hrpt V₁ s').1
  let z' := s'.1 (IsLocalRing.closedPoint Ω)
  let n : ℤ := if N'.ι z' = s₁ (IsLocalRing.closedPoint Ω) then m else 0
  have hgne : V₁.left.presheaf.germ ⊤ z' trivial e ≠ 0 := by
    by_cases hzy : N'.ι z' = s₁ (IsLocalRing.closedPoint Ω)
    · exact ((hgermV z').1 hzy).ne_zero
    · exact ((hgermV z').2 hzy).ne_zero
  have hrep : wcOrdRep X V₁ (b : Γ(wcGenPt X V₁, ⊤)) z' n := by
    refine ⟨⊤, trivial, e ^ ((-m).toNat), e ^ (m.toNat), ?_, ?_, ?_, ?_, ?_⟩
    · rw [map_pow]; exact hσe.pow _
    · rw [map_pow, map_pow, mul_comm]; exact hU'
    · rw [map_pow]; exact pow_ne_zero _ hgne
    · rw [map_pow]; exact pow_ne_zero _ hgne
    · rw [map_pow, map_pow]
      by_cases hzy : N'.ι z' = s₁ (IsLocalRing.closedPoint Ω)
      · have hirr := (hgermV z').1 hzy
        have h1 : ∀ k : ℕ, wcLocVal _ ((V₁.left.presheaf.germ ⊤ z' trivial e) ^ k) = k := by
          intro k
          have := @hval _ _ hdz hdvz _ 1 k hirr
          rwa [Units.val_one, one_mul] at this
        rw [h1, h1]
        simp only [n, if_pos hzy]
        omega
      · have hun := (hgermV z').2 hzy
        rw [hv0 _ _ (hun.pow _), hv0 _ _ (hun.pow _)]
        simp only [n, if_neg hzy]
        rfl
  have hL := hchar V₁ b s' n hrep
  have hR : (d'.1 (wcEtPtsMap Ω X fX c s')) = n := by
    have hpt : (wcEtPtsMap Ω X fX c s').1 (IsLocalRing.closedPoint Ω) = N'.ι z' := rfl
    have hmem : N'.ι z' ∈ N' := by
      have : N'.ι z' ∈ Set.range N'.ι := ⟨z', rfl⟩
      rwa [Scheme.Opens.range_ι] at this
    by_cases hzy : N'.ι z' = s₁ (IsLocalRing.closedPoint Ω)
    · simp only [n, if_pos hzy]
      have hs : wcEtPtsMap Ω X fX c s' = s₀ := by
        apply Subtype.ext
        exact huniq U.left (U.hom ≫ fX) _ _ (wcEtPtsMap Ω X fX c s').2 hs₁ (hpt.trans hzy)
      rw [hs]
    · simp only [n, if_neg hzy]
      by_contra hd
      exact hzy (hpt.symm.trans (hsupp _ (hpt ▸ hmem) hd))
  exact hL.trans hR.symm

theorem wc_ord_kernel_local_lft : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [LocallyOfFiniteType fX]
    [IsIntegral X], (∀ x : X, IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ ord : wcEtGmAtPre X (genericPoint X) ⟶ wcEtDivPre Ω X fX, wcOrdChar Ω X fX ord →
    ∀ (U : X.Etale) (b : ToType ((wcEtGmAtPre X (genericPoint X)).obj (Opposite.op U))),
      ord.app (Opposite.op U) b = 0 →
      Presheaf.imageSieve (wcEtGmToAtPre X (genericPoint X)) b ∈ Scheme.smallEtaleTopology X U :=
by
  intro Ω _ _ X fX _ _ hnorm hdim ord hchar U b h0

  have hs1 : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R],
      ∀ r s : R, r ≠ 0 → s ≠ 0 → wcLocVal R r = wcLocVal R s → ∃ v : Rˣ, r = (v : R) * s := by
    intro R _ _ _ r s hr hs hrs
    have hval : ∀ (ϖ : R) (v : Rˣ) (n : ℕ), Irreducible ϖ → wcLocVal R ((v : R) * ϖ ^ n) = n := by
      intro ϖ v n hϖ
      classical
      unfold wcLocVal
      have hex : ∃ (n' : ℕ) (v' : Rˣ) (ϖ' : R), Irreducible ϖ' ∧
          (v : R) * ϖ ^ n = (v' : R) * ϖ' ^ n' := ⟨n, v, ϖ, hϖ, rfl⟩
      rw [dif_pos hex, Nat.find_eq_iff]
      refine ⟨⟨v, ϖ, hϖ, rfl⟩, fun m hm ⟨v', ϖ', hϖ', heq⟩ => ?_⟩
      have := IsDiscreteValuationRing.unit_mul_pow_congr_pow hϖ hϖ' v v' n m heq
      omega
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
    obtain ⟨i, u, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hr hϖ
    obtain ⟨k, u', rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hs hϖ
    rw [hval ϖ u i hϖ, hval ϖ u' k hϖ] at hrs
    subst hrs
    refine ⟨u * u'⁻¹, ?_⟩
    rw [Units.val_mul, mul_assoc, ← mul_assoc (u'⁻¹ : Rˣ).val, Units.inv_mul, one_mul]

  have hs2 : ∀ (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of Ω)) [LocallyOfFiniteType fY] (ξ : Y),
      ∃ s : Spec (.of Ω) ⟶ Y, s ≫ fY = 𝟙 _ ∧ ξ ⤳ s (IsLocalRing.closedPoint Ω) := by
    intro Y fY _ ξ
    haveI : JacobsonSpace Y := LocallyOfFiniteType.jacobsonSpace fY
    obtain ⟨y, hyξ, hyc⟩ := nonempty_inter_closedPoints (Z := closure ({ξ} : Set Y))
      ⟨ξ, subset_closure rfl⟩ isClosed_closure.isLocallyClosed
    have hxy : ξ ⤳ y := specializes_iff_mem_closure.mpr hyξ
    have hyc' : IsClosed ({y} : Set Y) := hyc
    haveI : LocallyOfFiniteType (Y.fromSpecResidueField y) :=
      isClosed_singleton_iff_locallyOfFiniteType.mp hyc'
    let ψ : CommRingCat.of Ω ⟶ Y.residueField y := Spec.preimage (Y.fromSpecResidueField y ≫ fY)
    have hψ : Spec.map ψ = Y.fromSpecResidueField y ≫ fY := Spec.map_preimage _
    have hft : ψ.hom.FiniteType := by
      have : LocallyOfFiniteType (Spec.map ψ) := by rw [hψ]; infer_instance
      exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp this
    letI : Algebra Ω (Y.residueField y) := ψ.hom.toAlgebra
    haveI : Algebra.FiniteType Ω (Y.residueField y) := hft
    haveI : Module.Finite Ω (Y.residueField y) := finite_of_finite_type_of_isJacobsonRing Ω _
    have hsurj : Function.Surjective ψ.hom := by
      intro s
      have hs : IsIntegral Ω s := Algebra.IsIntegral.isIntegral s
      have hdeg := IsAlgClosed.degree_eq_one_of_irreducible Ω (minpoly.irreducible hs)
      obtain ⟨c, hc⟩ := minpoly.mem_range_of_degree_eq_one Ω s hdeg
      exact ⟨c, hc⟩
    let e : Ω ≃+* Y.residueField y := RingEquiv.ofBijective ψ.hom ⟨ψ.hom.injective, hsurj⟩
    refine ⟨Spec.map (CommRingCat.ofHom (e.symm : Y.residueField y →+* Ω)) ≫
      Y.fromSpecResidueField y, ?_, ?_⟩
    · rw [Category.assoc, ← hψ, ← Spec.map_comp, ← Spec.map_id]
      congr 1
      ext c
      change e.symm (ψ.hom c) = c
      exact e.symm_apply_apply c
    · have h1 : (Spec.map (CommRingCat.ofHom (e.symm : Y.residueField y →+* Ω)) ≫
          Y.fromSpecResidueField y) (IsLocalRing.closedPoint Ω) = y :=
        (Scheme.Hom.comp_apply _ _ _).trans (Scheme.fromSpecResidueField_apply _ _)
      rw [h1]
      exact hxy

  have hs5 : ∀ (β : Γ(wcGenPt X U, ⊤)) (W : U.left.Opens) (g h : Γ(U.left, W)) (y : U.left)
      (hy : y ∈ W) (v : (U.left.presheaf.stalk y)ˣ), IsUnit (wcGenSigma X U W g) →
      wcGenSigma X U W g * wcGenRestr X U W β = wcGenSigma X U W h →
      U.left.presheaf.germ W y hy h = (v : U.left.presheaf.stalk y) * U.left.presheaf.germ W y hy g →
      ∃ (N : U.left.Opens) (e : Γ(U.left, N)), y ∈ N ∧ IsUnit e ∧
        wcGenSigma X U N e = wcGenRestr X U N β := by
    intro β W g h y hy v hσg heq hgerm
    obtain ⟨N₁, hyN₁, u₀, hu₀⟩ :=
      TopCat.Presheaf.exists_germ_eq U.left.presheaf (v : U.left.presheaf.stalk y)
    have hyN₂ : y ∈ U.left.basicOpen u₀ :=
      (U.left.mem_basicOpen u₀ y hyN₁).mpr (by rw [hu₀]; exact v.isUnit)
    have hN₂N₁ : U.left.basicOpen u₀ ≤ N₁ := U.left.basicOpen_le u₀
    let M : U.left.Opens := U.left.basicOpen u₀ ⊓ W
    have hyM : y ∈ M := ⟨hyN₂, hy⟩
    let iM1 : M ⟶ N₁ := homOfLE (inf_le_left.trans hN₂N₁)
    let iM2 : M ⟶ W := homOfLE inf_le_right
    let A : Γ(U.left, M) := U.left.presheaf.map iM1.op u₀ * U.left.presheaf.map iM2.op g
    let B : Γ(U.left, M) := U.left.presheaf.map iM2.op h
    have hAB : U.left.presheaf.germ M y hyM A = U.left.presheaf.germ M y hyM B := by
      simp only [A, B, map_mul, TopCat.Presheaf.germ_res_apply]
      rw [hu₀, hgerm]
    obtain ⟨N, hyN, iU, iV, hUV⟩ := TopCat.Presheaf.germ_eq U.left.presheaf y hyM hyM A B hAB
    have hiUV : iU = iV := Subsingleton.elim _ _
    subst hiUV
    let e : Γ(U.left, N) := U.left.presheaf.map (iU ≫ iM1).op u₀
    have he : IsUnit e := by
      have h1 : e = U.left.presheaf.map
          (homOfLE (show N ≤ U.left.basicOpen u₀ from fun z hz => (iU.le hz).1)).op
          (U.left.presheaf.map (homOfLE hN₂N₁).op u₀) := by
        simp only [e]
        rw [← CommRingCat.comp_apply, ← Functor.map_comp]
        rfl
      rw [h1]
      exact (RingedSpace.isUnit_res_basicOpen _ u₀).map _
    have hstar : e * U.left.presheaf.map (iU ≫ iM2).op g =
        U.left.presheaf.map (iU ≫ iM2).op h := by
      have := hUV
      simp only [A, B, map_mul] at this
      simp only [e, op_comp, Functor.map_comp, CommRingCat.comp_apply]
      exact this
    have hnat : ∀ (f : Γ(U.left, W)), wcGenSigma X U N (U.left.presheaf.map (iU ≫ iM2).op f) =
        (wcGenPt X U).presheaf.map (homOfLE ((Limits.pullback.fst U.hom
          (X.fromSpecStalk (genericPoint X))).preimage_mono (iU ≫ iM2).le)).op
          (wcGenSigma X U W f) := by
      intro f
      simp only [wcGenSigma]
      have := Scheme.Hom.naturality (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X)))
        (iU ≫ iM2).op
      have := congrArg (fun φ => φ.hom f) this
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
      exact this
    have hres : wcGenRestr X U N β =
        (wcGenPt X U).presheaf.map (homOfLE ((Limits.pullback.fst U.hom
          (X.fromSpecStalk (genericPoint X))).preimage_mono (iU ≫ iM2).le)).op
          (wcGenRestr X U W β) := by
      simp only [wcGenRestr]
      rw [← CommRingCat.comp_apply, ← Functor.map_comp]
      rfl
    refine ⟨N, e, hyN, he, ?_⟩
    have hu : IsUnit (wcGenSigma X U N (U.left.presheaf.map (iU ≫ iM2).op g)) := by
      rw [hnat]; exact hσg.map _
    have key : wcGenSigma X U N (U.left.presheaf.map (iU ≫ iM2).op h) =
        wcGenSigma X U N (U.left.presheaf.map (iU ≫ iM2).op g) * wcGenRestr X U N β := by
      rw [hres, hnat, hnat, ← map_mul, heq]
    apply hu.mul_left_cancel
    rw [← key, ← hstar, map_mul, mul_comm]

  have hs3 : ∀ (W : U.left.Opens) (e : Γ(U.left, W)) (b : Γ(wcGenPt X U, ⊤)),
      wcGenSigma X U W e = wcGenRestr X U W b →
      wcGenRho X (wcEtOpen X U W) (W.topIso.inv e) = wcGenMap X (wcEtOpenι X U W) b := by
    intro W e b hσ
    have appLE_eq : ∀ {A B : Scheme.{u}} (f g : A ⟶ B), f = g → ∀ (P : B.Opens) (Q : A.Opens)
        (h1 : Q ≤ f ⁻¹ᵁ P) (h2 : Q ≤ g ⁻¹ᵁ P), f.appLE P Q h1 = g.appLE P Q h2 := by
      intro A B f g hfg P Q h1 h2; subst hfg; rfl
    have appTop_eq : ∀ {A B : Scheme.{u}} (f : A ⟶ B), f.appTop = f.appLE ⊤ ⊤ le_top := by
      intro A B f; rw [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE]; rfl
    let j := X.fromSpecStalk (genericPoint X)
    let fst := Limits.pullback.fst U.hom j
    let fst₁ := Limits.pullback.fst (wcEtOpen X U W).hom j
    let ιK := (Scheme.Etale.forget X ⋙ Over.pullback j ⋙ Over.forget _).map (wcEtOpenι X U W)
    have hcomm : ιK ≫ fst = fst₁ ≫ W.ι := by
      simp only [ιK, fst, fst₁, Functor.comp_map, Over.forget_map, Over.pullback_map_left]
      exact Limits.pullback.lift_fst _ _ _
    have hrho : ∀ z, wcGenRho X (wcEtOpen X U W) z = fst₁.appTop.hom z := by
      intro z
      (simp [wcGenRho, Over.mapPullbackAdj_counit_app, Scheme.Γ_map]) <;> rfl
    have hmap : ∀ z, wcGenMap X (wcEtOpenι X U W) z = ιK.appTop.hom z := by
      intro z
      (simp [wcGenMap, Scheme.Γ_map]) <;> rfl
    have htop : W.topIso.inv = W.ι.appLE W ⊤ (by rw [Scheme.Opens.ι_preimage_self]) := by
      rw [Scheme.Opens.topIso_inv, Scheme.Opens.ι_appLE]; rfl
    have hle : (⊤ : (wcGenPt X (wcEtOpen X U W)).Opens) ≤ ιK ⁻¹ᵁ (fst ⁻¹ᵁ W) := by
      intro p _
      change fst (ιK p) ∈ W
      have h1 : fst (ιK p) = W.ι (fst₁ p) :=
        (Scheme.Hom.comp_apply ιK fst p).symm.trans
          ((congrArg (fun φ => φ p) hcomm).trans (Scheme.Hom.comp_apply fst₁ W.ι p))
      rw [h1]
      have h2 : W.ι (fst₁ p) ∈ Set.range W.ι := ⟨_, rfl⟩
      rwa [Scheme.Opens.range_ι] at h2
    have h0' : (⊤ : (wcGenPt X (wcEtOpen X U W)).Opens) ≤ (fst₁ ≫ W.ι) ⁻¹ᵁ W := hcomm ▸ hle
    have LHSmor : W.topIso.inv ≫ fst₁.appTop = (fst₁ ≫ W.ι).appLE W ⊤ h0' := by
      rw [htop, appTop_eq]
      exact Scheme.Hom.appLE_comp_appLE _ _ _ _ _ _ _
    have RHSmor : (wcGenPt X U).presheaf.map (homOfLE le_top).op ≫ ιK.appLE (fst ⁻¹ᵁ W) ⊤ hle =
        ιK.appTop :=
      (Scheme.Hom.map_appLE ιK hle _).trans (appTop_eq ιK).symm
    have mid : fst.app W ≫ ιK.appLE (fst ⁻¹ᵁ W) ⊤ hle = (ιK ≫ fst).appLE W ⊤ hle := by
      rw [Scheme.Hom.app_eq_appLE]
      exact Scheme.Hom.appLE_comp_appLE _ _ _ _ _ _ _
    have E1 : fst₁.appTop.hom (W.topIso.inv.hom e) = ((fst₁ ≫ W.ι).appLE W ⊤ h0').hom e := by
      have := congrArg (fun φ => CommRingCat.Hom.hom φ e) LHSmor
      exact this
    have E2 : (ιK.appLE (fst ⁻¹ᵁ W) ⊤ hle).hom ((fst.app W).hom e) =
        ((ιK ≫ fst).appLE W ⊤ hle).hom e := by
      have := congrArg (fun φ => CommRingCat.Hom.hom φ e) mid
      exact this
    have E3 : (ιK.appLE (fst ⁻¹ᵁ W) ⊤ hle).hom
        (((wcGenPt X U).presheaf.map (homOfLE le_top).op).hom b) = ιK.appTop.hom b := by
      have := congrArg (fun φ => CommRingCat.Hom.hom φ b) RHSmor
      exact this
    have E4 : ((ιK ≫ fst).appLE W ⊤ hle).hom e = ((fst₁ ≫ W.ι).appLE W ⊤ h0').hom e :=
      congrArg (fun φ => CommRingCat.Hom.hom φ e) (appLE_eq _ _ hcomm W ⊤ hle h0')
    refine (hrho _).trans (Eq.trans ?_ (hmap b).symm)
    have E5 : (ιK.appLE (fst ⁻¹ᵁ W) ⊤ hle).hom ((fst.app W).hom e) =
        (ιK.appLE (fst ⁻¹ᵁ W) ⊤ hle).hom
          (((wcGenPt X U).presheaf.map (homOfLE le_top).op).hom b) :=
      congrArg (ιK.appLE (fst ⁻¹ᵁ W) ⊤ hle).hom hσ
    exact E1.trans (E4.symm.trans (E2.symm.trans (E5.trans E3)))

  let β : (Γ(wcGenPt X U, ⊤))ˣ := Additive.toMul b.down
  have hloc : ∀ x : U.left, ∃ (N : U.left.Opens) (a : (Γ((wcEtOpen X U N).left, ⊤))ˣ), x ∈ N ∧
      wcGenRho X (wcEtOpen X U N) (a : Γ((wcEtOpen X U N).left, ⊤)) =
        wcGenMap X (wcEtOpenι X U N) (β : Γ(wcGenPt X U, ⊤)) := by
    intro x
    haveI : Etale U.hom := U.prop
    obtain ⟨s₁, hs₁, hxy⟩ := hs2 U.left (U.hom ≫ fX) x
    let s : wcEtPts Ω X fX U := ⟨s₁, hs₁⟩
    obtain ⟨n, W, hyW, g, h, hσg, heq, hg0, hh0, hn⟩ :=
      wc_ord_rep_exists X U β (s₁ (IsLocalRing.closedPoint Ω))
    have hc := hchar U β s n ⟨W, hyW, g, h, hσg, heq, hg0, hh0, hn⟩
    have h0' : ord.app (Opposite.op U) (ULift.up (Additive.ofMul β)) = 0 := h0
    have hz : ((ord.app (Opposite.op U) (ULift.up (Additive.ofMul β))).down).1 s = 0 := by
      rw [h0']; rfl
    have hn0 : n = 0 := hc.symm.trans hz
    have hval : wcLocVal _ (U.left.presheaf.germ W (s₁ (IsLocalRing.closedPoint Ω)) hyW h) =
        wcLocVal _ (U.left.presheaf.germ W (s₁ (IsLocalRing.closedPoint Ω)) hyW g) := by
      have : (wcLocVal _ (U.left.presheaf.germ W (s₁ (IsLocalRing.closedPoint Ω)) hyW h) : ℤ) =
          wcLocVal _ (U.left.presheaf.germ W (s₁ (IsLocalRing.closedPoint Ω)) hyW g) := by
        omega
      exact_mod_cast this
    obtain ⟨hdom, hdvr⟩ := (wc_rational_point_stalk_dvr_lft Ω X fX hnorm hdim U s).1
    obtain ⟨v₀, hv₀⟩ := @hs1 _ _ hdom hdvr _ _ hh0 hg0 hval
    obtain ⟨N, e, hyN, he, hσe⟩ := hs5 (β : Γ(wcGenPt X U, ⊤)) W g h _ hyW v₀ hσg heq hv₀
    obtain ⟨a, ha⟩ := he.map (N.topIso.inv).hom
    refine ⟨N, a, Specializes.mem_open hxy N.isOpen hyN, ?_⟩
    exact (congrArg (wcGenRho X (wcEtOpen X U N)) ha).trans (hs3 N e β hσe)

  apply wc_etale_jointly_surjective_covers X U
  intro v
  obtain ⟨N, a, hvN, hEq⟩ := hloc v
  refine ⟨wcEtOpen X U N, wcEtOpenι X U N, ?_, ?_⟩
  · rw [Presheaf.imageSieve_apply]
    refine ⟨ULift.up (Additive.ofMul a), ?_⟩
    change ULift.up (Additive.ofMul (Units.map (wcGenRho X (wcEtOpen X U N)).toMonoidHom a)) =
      ULift.up (Additive.ofMul (Units.map (wcGenMap X (wcEtOpenι X U N)).toMonoidHom β))
    congr 2
    apply Units.ext
    simp only [Units.coe_map]
    exact hEq
  · show v ∈ Set.range N.ι
    rw [Scheme.Opens.range_ι]
    exact hvN

theorem wc_et_gm_divisor_coker_acyclic_lft : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [LocallyOfFiniteType fX] [CompactSpace X] [QuasiSeparatedSpace X] [IsIntegral X], (∀ x : X, IsIntegrallyClosed (X.presheaf.stalk x)) → topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) → letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _; ∀ q : ℕ, Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.cokernel (wcEtGmToAt X (genericPoint X))) (q + 1)) :=
by
  intro Ω _ _ X fX _ _ _ _ hnorm hdim
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
  intro q
  haveI := wc_et_enough_injectives X

  obtain ⟨ord, hchar⟩ := wc_ord_construct_lft Ω X fX hnorm hdim
  have hv0 : ∀ (R : Type u) [CommRing R] (r : R), IsUnit r → wcLocVal R r = 0 := by
    intro R _ r hr
    classical
    unfold wcLocVal
    split_ifs with h
    · rw [Nat.find_eq_zero]
      obtain ⟨n, w, ϖ, hϖ, _⟩ := h
      exact ⟨hr.unit, ϖ, hϖ, by simp⟩
    · rfl
  have hbridge : ∀ (U : X.Etale) (e : Γ(U.left, ⊤)),
      wcGenRestr X U ⊤ (wcGenRho X U e) = wcGenSigma X U ⊤ e := by
    intro U e
    have h1 : wcGenRho X U e =
        (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))).appTop.hom e := by
      (simp [wcGenRho, Over.mapPullbackAdj_counit_app, Scheme.Γ_map]) <;> rfl
    rw [h1]
    unfold wcGenRestr wcGenSigma
    have h2 : (homOfLE le_top : (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ ⊤ ⟶
        (Limits.pullback.fst U.hom (X.fromSpecStalk (genericPoint X))) ⁻¹ᵁ ⊤) = 𝟙 _ :=
      Subsingleton.elim _ _
    erw [h2, op_id, CategoryTheory.Functor.map_id]
    rfl
  have h0 : wcEtGmToAtPre X (genericPoint X) ≫ ord = 0 := by
    apply NatTrans.ext
    funext U
    induction U using Opposite.rec with
    | op U =>
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro a
    let a' : (Γ(U.left, ⊤))ˣ := Additive.toMul a.down
    let b : (Γ(wcGenPt X U, ⊤))ˣ := Units.map (wcGenRho X U).toMonoidHom a'
    have hb : (b : Γ(wcGenPt X U, ⊤)) = wcGenRho X U (a' : Γ(U.left, ⊤)) := rfl
    change ord.app (Opposite.op U) (ULift.up (Additive.ofMul b)) = 0
    apply ULift.ext
    apply Subtype.ext
    funext s
    change ((ord.app (Opposite.op U) (ULift.up (Additive.ofMul b))).down).1 s = (0 : ℤ)
    apply hchar U b s 0
    have hu : IsUnit (U.left.presheaf.germ ⊤ (s.1 (IsLocalRing.closedPoint Ω)) trivial
        (a' : Γ(U.left, ⊤))) :=
      a'.isUnit.map (U.left.presheaf.germ ⊤ (s.1 (IsLocalRing.closedPoint Ω)) trivial).hom
    refine ⟨⊤, trivial, 1, (a' : Γ(U.left, ⊤)), ?_, ?_, ?_, ?_, ?_⟩
    · rw [map_one]; exact isUnit_one
    · rw [map_one, one_mul, hb, hbridge]
    · rw [map_one]; exact one_ne_zero
    · exact hu.ne_zero
    · rw [hv0 _ _ hu, map_one, hv0 _ _ isUnit_one]
      rfl
  have hsurj := wc_ord_locally_surjective_lft Ω X fX hnorm hdim ord hchar
  have hker := wc_ord_kernel_local_lft Ω X fX hnorm hdim ord hchar

  obtain ⟨e7⟩ := wc_et_sheafify_cokernel_iso X (wcEtGmToAtPre X (genericPoint X)) ord h0 hsurj hker
  have hD := wc_et_div_isSheaf Ω X fX
  haveI := isIso_toSheafify (Scheme.smallEtaleTopology X) hD
  let G := Limits.cokernel (wcEtGmToAt X (genericPoint X))
  let E : wcEtDivPre Ω X fX ≅ G.obj :=
    asIso (toSheafify (Scheme.smallEtaleTopology X) (wcEtDivPre Ω X fX)) ≪≫
      (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).mapIso e7.symm

  let B : X.Etale → Prop := fun U => CompactSpace U.left ∧ QuasiSeparatedSpace U.left
  let Cov : ∀ (U : X.Etale) (k : ℕ) (V : Fin k → X.Etale), (∀ i, V i ⟶ U) → Prop :=
    fun U k V f => B U ∧ (∀ i, IsAffine (V i).left) ∧ ∀ x : U.left, ∃ i, x ∈ Set.range (f i).left
  have H1 : ∀ (U : X.Etale) (k : ℕ) (V : Fin k → X.Etale) (f : ∀ i, V i ⟶ U), Cov U k V f →
      Sieve.generate (Presieve.ofArrows V f) ∈ Scheme.smallEtaleTopology X U := by
    intro U k V f hC
    apply wc_etale_jointly_surjective_covers X U
    intro v
    obtain ⟨i, hi⟩ := hC.2.2 v
    refine ⟨V i, f i, ?_, hi⟩
    exact ⟨V i, 𝟙 _, f i, Presieve.ofArrows.mk i, Category.id_comp _⟩
  have H2 : ∀ (U : X.Etale) (k : ℕ) (V : Fin k → X.Etale) (f : ∀ i, V i ⟶ U), Cov U k V f →
      ∀ (p : ℕ) (σ : Fin (p + 1) → Fin k),
      B (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l))) := by
    intro U k V f hC p σ
    exact wc_et_widePullback_qcqs X U k V f hC.1.1 hC.1.2 hC.2.1 p σ
  have H3 : ∀ (U : X.Etale), B U → ∀ R ∈ Scheme.smallEtaleTopology X U,
      ∃ (k : ℕ) (V : Fin k → X.Etale) (f : ∀ i, V i ⟶ U), Cov U k V f ∧ ∀ i, R.arrows (f i) := by
    intro U hB R hR
    obtain ⟨k, V, f, hRf, haff, hsurjf⟩ := wc_et_finite_affine_refinement X U hB.1 R hR
    exact ⟨k, V, f, ⟨hB, haff, hsurjf⟩, hRf⟩
  have hT := @MorphismProperty.Over.mkIdTerminal Scheme.{u} _ @Etale X
    MorphismProperty.IsMultiplicative.toContainsIdentities
  have hBT : CompactSpace X ∧ QuasiSeparatedSpace X := ⟨inferInstance, inferInstance⟩

  have H5 : ∀ (U : X.Etale) (k : ℕ) (V : Fin k → X.Etale) (f : ∀ i, V i ⟶ U), Cov U k V f →
      wcCechAcyclic G.obj V f := by
    intro U k V f hC
    apply wc_cechAcyclic_of_iso E V f
    apply wc_et_div_cech_acyclic Ω X fX U k V f
    · intro p σ
      exact (wc_et_widePullback_qcqs X U k V f hC.1.1 hC.1.2 hC.2.1 p σ).1
    · intro s
      obtain ⟨i, v, hv⟩ := hC.2.2 (s.1 (IsLocalRing.closedPoint Ω))
      obtain ⟨t', ht', -⟩ := wc_etale_lift_alg_closed_point Ω (f i).left s.1 v hv
      refine ⟨i, ⟨t', ?_⟩, ?_⟩
      · rw [← MorphismProperty.Over.w (f i)]
        simp only [Category.assoc]
        rw [← Category.assoc, ht']
        exact s.2
      · apply Subtype.ext
        exact ht'

  exact wc_et_cartan_criterion_const X B Cov H1 H2 H3 _ hT hBT G H5 q

theorem wc_zar_affine_curve_pic_ell_divisible : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX], IrreducibleSpace X → (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) → topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) → ∀ (V : Scheme.{u}) (ι : V ⟶ X) [IsOpenImmersion ι] [IsAffine V], Nonempty V → ∀ (ℓ : ℕ), ℓ.Prime → (ℓ : Ω) ≠ 0 → letI : HasExt (Sheaf (Opens.grothendieckTopology V) AddCommGrpCat.{u}) := HasExt.standard _; ∀ x : Abelian.Ext ((constantSheaf (Opens.grothendieckTopology V) AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ))) (wcZarGm V) 1, ∃ y, ℓ • y = x :=
by
  intro Ω _ _ X fX _ hirr hnorm hdim V ι _ _ hVne ℓ hℓ hℓΩ
  classical
  letI : HasExt (Sheaf (Opens.grothendieckTopology V) AddCommGrpCat.{u}) := HasExt.standard _
  intro x

  haveI := hirr
  haveI := hVne
  haveI : ∀ x : X, _root_.IsReduced (X.presheaf.stalk x) := fun x => by
    haveI := (hnorm x).1
    infer_instance
  haveI : AlgebraicGeometry.IsReduced X := isReduced_of_isReduced_stalk X
  haveI : AlgebraicGeometry.IsIntegral X := isIntegral_of_irreducibleSpace_of_isReduced X
  haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian fX
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace fX
  haveI : AlgebraicGeometry.IsNoetherian X := ⟨⟩
  have hdim1 : topologicalKrullDim X ≤ 1 := by rw [hdim, Nat.cast_one]
  obtain ⟨U, hUdef⟩ : ∃ U : X.Opens, U = ι.opensRange := ⟨_, rfl⟩
  have hU : IsAffineOpen U := by rw [hUdef]; exact isAffineOpen_opensRange ι
  have hrange : (U : Set X) = Set.range ι := by rw [hUdef]; exact Scheme.Hom.coe_opensRange ι
  obtain ⟨v₀⟩ := hVne
  obtain ⟨x₀, hx₀⟩ : ∃ x₀ : X, x₀ ∈ U := ⟨ι v₀, by
    show ι v₀ ∈ (U : Set X)
    rw [hrange]; exact ⟨v₀, rfl⟩⟩

  have hfin : ((U : Set X)ᶜ).Finite := by
    obtain ⟨S, hSf, hScl, hSirr, hSeq⟩ :=
      TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible
        (U.isOpen.isClosed_compl)
    rw [hSeq]
    refine hSf.sUnion fun C hC => ?_
    have hCsub : C ⊆ (U : Set X)ᶜ := by
      rw [hSeq]; exact Set.subset_sUnion_of_mem hC
    have key : ∀ y ∈ C, closure {y} = C := by
      intro y hy
      have hle : closure {y} ⊆ C :=
        closure_minimal (Set.singleton_subset_iff.mpr hy) (hScl C hC)
      by_contra hne
      let a : TopologicalSpace.IrreducibleCloseds X :=
        ⟨closure {y}, isIrreducible_singleton.closure, isClosed_closure⟩
      let c : TopologicalSpace.IrreducibleCloseds X := ⟨C, hSirr C hC, hScl C hC⟩
      let t : TopologicalSpace.IrreducibleCloseds X :=
        ⟨Set.univ, IrreducibleSpace.isIrreducible_univ X, isClosed_univ⟩
      have hac : a < c := lt_of_le_of_ne hle
        (fun h => hne (congrArg TopologicalSpace.IrreducibleCloseds.carrier h))
      have hct : c < t := lt_of_le_of_ne (Set.subset_univ C) (fun h => by
        have hx : x₀ ∈ TopologicalSpace.IrreducibleCloseds.carrier c := by
          rw [h]; trivial
        exact hCsub hx hx₀)
      have hK : Order.krullDim (TopologicalSpace.IrreducibleCloseds X) ≤ 1 := hdim1
      rcases Order.krullDim_le_one_iff.mp hK c with h | h
      · exact not_isMin_of_lt hac h
      · exact not_isMax_of_lt hct h
    refine Set.Subsingleton.finite fun y hy z hz => ?_
    exact (inseparable_iff_closure_eq.mpr ((key y hy).trans (key z hz).symm)).eq

  haveI : Nonempty U := ⟨⟨x₀, hx₀⟩⟩
  haveI hdom : IsDomain Γ(X, U) := IsIntegral.component_integral U
  haveI hnoeth : IsNoetherianRing Γ(X, U) := IsLocallyNoetherian.component_noetherian ⟨U, hU⟩
  have hA : ringKrullDim Γ(X, U) ≤ 1 := by
    have e1 := PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim Γ(X, U)
    have e2 := (Scheme.homeoOfIso hU.isoSpec).isHomeomorph.topologicalKrullDim_eq
    have e3 := topologicalKrullDim_subspace_le X (U : Set X)
    rw [← e1]
    calc topologicalKrullDim (PrimeSpectrum Γ(X, U)) = topologicalKrullDim U := e2.symm
      _ ≤ topologicalKrullDim X := e3
      _ ≤ 1 := hdim1
  haveI : Ring.KrullDimLE 1 Γ(X, U) := Ring.krullDimLE_iff.mpr (by rw [Nat.cast_one]; exact hA)
  have hstalk : ∀ x : U, IsIntegrallyClosed (Localization.AtPrime (hU.primeIdealOf x).asIdeal) := by
    intro x
    haveI := (hnorm (x : X)).2
    let e := @IsLocalization.algEquiv _ _ (hU.primeIdealOf x).asIdeal.primeCompl
      (X.presheaf.stalk (x : X)) _ _ (hU.isLocalization_stalk x)
      (Localization.AtPrime (hU.primeIdealOf x).asIdeal) _ _ _
    exact IsIntegrallyClosed.of_equiv e.toRingEquiv
  have hloc : ∀ (p : Ideal Γ(X, U)) [p.IsPrime], IsIntegrallyClosed (Localization.AtPrime p) := by
    intro p hp
    let q : PrimeSpectrum Γ(X, U) := ⟨p, hp⟩
    have hxU : hU.fromSpec q ∈ (U : Set X) := hU.range_fromSpec ▸ Set.mem_range_self q
    have hq : hU.primeIdealOf ⟨hU.fromSpec q, hxU⟩ = q :=
      hU.fromSpec.isOpenEmbedding.isEmbedding.injective
        (hU.fromSpec_primeIdealOf ⟨hU.fromSpec q, hxU⟩)
    have h1 := hstalk ⟨hU.fromSpec q, hxU⟩
    rw [hq] at h1
    exact h1
  have hDed : IsDedekindDomain Γ(X, U) := by
    rw [isDedekindDomain_iff Γ(X, U) (FractionRing Γ(X, U))]
    haveI : IsIntegrallyClosed Γ(X, U) := IsIntegrallyClosed.of_localization_maximal
      (fun p _ hpm => by haveI := hpm.isPrime; exact hloc p)
    exact ⟨hdom, hnoeth, ⟨fun hp0 hp => hp.isMaximal_of_ne_bot hp0⟩,
      fun hx => IsIntegrallyClosed.isIntegral_iff.mp hx⟩
  haveI := hDed

  obtain ⟨hcl, hcpt⟩ := wc_curve_points_closed_opens_compact Ω X fX hdim
  have hpt1 : ∀ y : X, y ≠ genericPoint X → IsClosed ({y} : Set X) := fun y hy =>
    hcl {y} (Set.finite_singleton y) (fun h => hy (Set.mem_singleton_iff.mp h).symm)
  have hDVR := wc_curve_stalk_dvr Ω X fX (fun x => (hnorm x).2) hpt1
  have hP5 := wc_dedekind_affine_points X U hU
  obtain ⟨ord, ιX, h1, h2, h3, h4, h5, h6, h7⟩ :=
    wc_curve_ord_units_data X hDVR (wc_integral_hartogs_sections X) dvr_count_spanSingleton
      dedekind_count_localization U hU hfin hP5

  haveI : AlgebraicGeometry.IsIntegral V := isIntegral_of_isOpenImmersion ι
  haveI : IrreducibleSpace V := irreducibleSpace_of_isIntegral V
  have hη : ι (genericPoint V) = genericPoint X := genericPoint_eq_of_isOpenImmersion ι
  have hinj : Function.Injective ι := ι.isOpenEmbedding.injective
  have himne : ∀ W : V.Opens, (W : Set V).Nonempty → ((ι ''ᵁ W : X.Opens) : Set X).Nonempty := by
    intro W hW
    rw [Scheme.Hom.coe_image]
    exact hW.image _

  let ordV : V → Additive (FractionRing Γ(X, U))ˣ →+ ℤ := fun v => ord (ι v)
  have H1 : ∀ W : V.Opens, (W : Set V).Nonempty → genericPoint V ∈ W := fun W hW =>
    ((genericPoint_spec V).mem_open_set_iff W.isOpen).mpr (by rwa [Set.univ_inter])
  have Hcpt : ∀ W : V.Opens, IsCompact (W : Set V) := by
    intro W
    rw [ι.isOpenEmbedding.isEmbedding.isCompact_iff]
    have := hcpt (ι ''ᵁ W)
    rwa [Scheme.Hom.coe_image] at this
  have Hcl : ∀ S : Set V, S.Finite → genericPoint V ∉ S → IsClosed S := by
    intro S hS hηS
    have hc : IsClosed (ι '' S) := hcl _ (hS.image ι) (by
      rintro ⟨s, hs, hs'⟩
      exact hηS (by rw [← hinj (hs'.trans hη.symm)]; exact hs))
    have := hc.preimage ι.continuous
    rwa [Set.preimage_image_eq S hinj] at this
  have h1' : ∀ m, ordV (genericPoint V) m = 0 := fun m => by
    show ord (ι (genericPoint V)) m = 0
    rw [hη]; exact h1 m
  have h2' : ∀ m, {v | ordV v m ≠ 0}.Finite := fun m => (h2 m).preimage hinj.injOn
  have h3' : ∀ v, v ≠ genericPoint V → ∃ m, ordV v m = 1 := fun v hv =>
    h3 (ι v) (fun h => hv (hinj (h.trans hη.symm)))
  obtain ⟨φV, hφV⟩ := wc_zarGm_sections_units V
  let eW : ∀ W : V.Opens, Γ(V, W) ≃+* Γ(X, ι ''ᵁ W) := fun W =>
    (ι.appIso W).symm.commRingCatIsoToRingEquiv
  let φ' : ∀ W : V.Opens, (wcZarGm V).obj.obj (Opposite.op W) ≃+ Additive (Γ(X, ι ''ᵁ W))ˣ :=
    fun W => (φV W).trans (MulEquiv.toAdditive (Units.mapEquiv (eW W).toMulEquiv))
  let ι' : ∀ W : V.Opens, (wcZarGm V).obj.obj (Opposite.op W) →+
      Additive (FractionRing Γ(X, U))ˣ := fun W => (ιX (ι ''ᵁ W)).comp (φ' W).toAddMonoidHom
  have hnat : ∀ (W W' : V.Opens) (hW : W' ≤ W) (a : Γ(V, W)),
      (X.presheaf.map (homOfLE (ι.image_mono hW)).op).hom (eW W a) =
        eW W' ((V.presheaf.map (homOfLE hW).op).hom a) := by
    intro W W' hW a
    have e := congrArg (fun f => f.hom a) (ι.appIso_inv_naturality (homOfLE hW).op)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e
    have hm : ι.opensFunctor.op.map (homOfLE hW).op = (homOfLE (ι.image_mono hW)).op :=
      Quiver.Hom.unop_inj (Subsingleton.elim _ _)
    rw [hm] at e
    exact e.symm
  have H7 : ∀ (W W' : V.Opens) (hW : W' ≤ W), (W' : Set V).Nonempty →
      ∀ g, ι' W' ((wcZarGm V).obj.map (homOfLE hW).op g) = ι' W g := by
    intro W W' hW hne g
    have key : φ' W' ((wcZarGm V).obj.map (homOfLE hW).op g) =
        Additive.ofMul (Units.map (X.presheaf.map (homOfLE (ι.image_mono hW)).op).hom.toMonoidHom
          (Additive.toMul (φ' W g))) := by
      show (MulEquiv.toAdditive (Units.mapEquiv (eW W').toMulEquiv))
        (φV W' ((wcZarGm V).obj.map (homOfLE hW).op g)) = _
      rw [hφV W W' hW g]
      apply Additive.toMul.injective
      apply Units.ext
      exact (hnat W W' hW ((Additive.toMul (φV W g) : (Γ(V, W))ˣ) : Γ(V, W))).symm
    show ιX (ι ''ᵁ W') (φ' W' ((wcZarGm V).obj.map (homOfLE hW).op g)) = ιX (ι ''ᵁ W) (φ' W g)
    rw [key]
    exact h4 (ι ''ᵁ W) (ι ''ᵁ W') (ι.image_mono hW) (himne W' hne) (Additive.toMul (φ' W g))
  have H8 : ∀ W : V.Opens, (W : Set V).Nonempty → Function.Injective (ι' W) :=
    fun W hne => (h5 (ι ''ᵁ W) (himne W hne)).comp (φ' W).injective
  have H9 : ∀ W : V.Opens, (W : Set V).Nonempty →
      ∀ m, (∃ g, ι' W g = m) ↔ ∀ v ∈ W, ordV v m = 0 := by
    intro W hne m
    have e1 : (∃ g, ι' W g = m) ↔ ∃ g', ιX (ι ''ᵁ W) g' = m := by
      constructor
      · rintro ⟨g, hg⟩
        exact ⟨φ' W g, hg⟩
      · rintro ⟨g', hg'⟩
        refine ⟨(φ' W).symm g', ?_⟩
        show ιX (ι ''ᵁ W) (φ' W ((φ' W).symm g')) = m
        rw [AddEquiv.apply_symm_apply]
        exact hg'
    rw [e1, h6 (ι ''ᵁ W) (himne W hne) m]
    constructor
    · intro h v hv
      exact h (ι v) (by
        show ι v ∈ ((ι ''ᵁ W : X.Opens) : Set X)
        rw [Scheme.Hom.coe_image]
        exact ⟨v, hv, rfl⟩)
    · intro h y hy
      have hy' : y ∈ ((ι ''ᵁ W : X.Opens) : Set X) := hy
      rw [Scheme.Hom.coe_image] at hy'
      obtain ⟨v, hv, rfl⟩ := hy'
      exact h v hv

  obtain ⟨K, D, i, d, h, hSES, hflas, eK, eD, heDinj, heDsurj, heDη, hdiv⟩ :=
    wc_abstract_divisor_ses V (genericPoint V) (Additive (FractionRing Γ(X, U))ˣ) ordV
      (wcZarGm V) ι' H1 Hcpt Hcl h1' h2' h3' H7 H8 H9
  let hT : Limits.IsTerminal (⊤ : V.Opens) := Limits.IsTerminal.ofUnique _
  let eD' := eD.comp (Sheaf.H.equiv₀ D hT).toAddMonoidHom
  have heD'inj : Function.Injective eD' := heDinj.comp (Sheaf.H.equiv₀ D hT).injective
  have heD'surj : ∀ n : V →₀ ℤ, n (genericPoint V) = 0 → ∃ w, eD' w = n := by
    intro n hn
    obtain ⟨w0, hw0⟩ := heDsurj n hn
    refine ⟨(Sheaf.H.equiv₀ D hT).symm w0, ?_⟩
    show eD (Sheaf.H.equiv₀ D hT ((Sheaf.H.equiv₀ D hT).symm w0)) = n
    rw [AddEquiv.apply_symm_apply]
    exact hw0
  have heD'η : ∀ w, eD' w (genericPoint V) = 0 := fun w => heDη _

  have hpU : ∀ v : IsDedekindDomain.HeightOneSpectrum Γ(X, U),
      ∃ w : V, ι w = (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩ : X) := by
    intro v
    have hmem : (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩ : X) ∈ (U : Set X) := (hP5.2.2.1 v).1
    rw [hrange] at hmem
    exact hmem
  choose ptV hptV using hpU
  have hptinj : Function.Injective ptV := by
    intro a b hab
    apply hP5.2.1
    show (hU.fromSpec ⟨a.asIdeal, a.isPrime⟩ : X) = (hU.fromSpec ⟨b.asIdeal, b.isPrime⟩ : X)
    rw [← hptV a, ← hptV b, hab]
  have hptη : ∀ v, ptV v ≠ genericPoint V := by
    intro v hv
    apply (hP5.2.2.1 v).2
    rw [← hptV v, hv, hη]
  have hptsurj : ∀ v' : V, v' ≠ genericPoint V → ∃ v, ptV v = v' := by
    intro v' hv'
    have hxU : ι v' ∈ U := by
      show ι v' ∈ (U : Set X)
      rw [hrange]; exact ⟨v', rfl⟩
    have hxη : ι v' ≠ genericPoint X := fun e => hv' (hinj (e.trans hη.symm))
    obtain ⟨w, hw⟩ := hP5.2.2.2 (ι v') hxU hxη
    exact ⟨w, hinj ((hptV w).trans hw)⟩

  let π := (Finsupp.comapDomain.addMonoidHom hptinj).comp eD'
  have hπ : ∀ w v, π w v = eD' w (ptV v) := fun w v => rfl
  have hπs : Function.Surjective π := by
    intro n'
    have hn : (Finsupp.mapDomain ptV n') (genericPoint V) = 0 :=
      Finsupp.mapDomain_of_notMem_range n' _ (fun ⟨v, hv⟩ => hptη v hv)
    obtain ⟨w, hw⟩ := heD'surj _ hn
    refine ⟨w, Finsupp.ext fun v => ?_⟩
    rw [hπ, hw]
    exact Finsupp.mapDomain_apply_of_injective hptinj n' v
  have hπi : Function.Injective π := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    apply heD'inj
    rw [map_zero]
    ext v'
    rw [Finsupp.zero_apply]
    by_cases hv' : v' = genericPoint V
    · rw [hv']; exact heD'η w
    · obtain ⟨v, rfl⟩ := hptsurj v' hv'
      rw [← hπ, hw, Finsupp.zero_apply]

  have hchain : ∀ z v, π (z.comp (Abelian.Ext.mk₀ d) (add_zero 0)) v =
      ordV (ptV v) (eK (Sheaf.H.equiv₀ K hT z)) := by
    intro z v
    rw [hπ]
    show eD (Sheaf.H.equiv₀ D hT (Sheaf.H.map d 0 z)) (ptV v) = _
    rw [← Sheaf.H.equiv₀_naturality hT d z, hdiv]

  obtain ⟨ψ₀, hψ₀s, hψ₀k⟩ := dedekind_classGroup_divisor_presentation Γ(X, U)
  have hsub : Subsingleton (Abelian.Ext ((constantSheaf (Opens.grothendieckTopology V)
      AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ))) K 1) :=
    wc_zar_flasque_ext_one_vanish V K hflas

  have h0 : x.comp (Abelian.Ext.mk₀ i) (add_zero 1) = 0 := Subsingleton.elim _ _
  obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hSES x h0 (zero_add 1)

  obtain ⟨e, he⟩ := wc_curve_classGroup_ell_divisible Ω X fX hirr hnorm hdim U hU hfin ℓ hℓ hℓΩ
    (Additive.toMul (ψ₀ (π y)))
  obtain ⟨n', hn'⟩ := hψ₀s (Additive.ofMul e)
  obtain ⟨y'', hy''⟩ := hπs n'
  have hk : ψ₀ (π y - ℓ • π y'') = 0 := by
    rw [map_sub, map_nsmul, hy'', hn', ← ofMul_pow, he, ofMul_toMul, sub_self]
  obtain ⟨f, hf⟩ := (hψ₀k _).mp hk
  let z := (Sheaf.H.equiv₀ K hT).symm (eK.symm (Additive.ofMul f))
  have hz : ∀ v, π (z.comp (Abelian.Ext.mk₀ d) (add_zero 0)) v =
      FractionalIdeal.count (FractionRing Γ(X, U)) v
        (FractionalIdeal.spanSingleton (nonZeroDivisors Γ(X, U)) (f : FractionRing Γ(X, U))) := by
    intro v
    rw [hchain, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply]
    show ord (ι (ptV v)) (Additive.ofMul f) = _
    rw [hptV v]
    exact h7 v f

  have hyz : y = ℓ • y'' + z.comp (Abelian.Ext.mk₀ d) (add_zero 0) := by
    apply hπi
    ext v
    rw [map_add, map_nsmul, Finsupp.add_apply, Finsupp.smul_apply, hz v, ← hf v,
      Finsupp.sub_apply, Finsupp.smul_apply]
    abel

  let δ := hSES.extClass.postcomp ((constantSheaf (Opens.grothendieckTopology V)
    AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ))) (zero_add 1)
  have hδ : ∀ w, δ w = w.comp hSES.extClass (zero_add 1) := fun w => rfl
  have hc : (Abelian.Ext.mk₀ d).comp hSES.extClass (zero_add 1) = 0 := hSES.comp_extClass
  have hδg : δ (z.comp (Abelian.Ext.mk₀ d) (add_zero 0)) = 0 := by
    rw [hδ, Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add 1) (by omega), hc,
      Abelian.Ext.comp_zero]
  refine ⟨δ y'', ?_⟩
  calc ℓ • δ y'' = δ (ℓ • y'' + z.comp (Abelian.Ext.mk₀ d) (add_zero 0)) := by
        rw [map_add, hδg, add_zero, map_nsmul]
    _ = x := by rw [← hyz, hδ]; exact hy

theorem wc_et_normal_affine_curve_const_vanishing : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX], IrreducibleSpace X → (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) → topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) → ∀ (V : Scheme.{u}) (ι : V ⟶ X) [IsOpenImmersion ι] [IsAffine V] (ℓ : ℕ), ℓ.Prime → (ℓ : Ω) ≠ 0 → ∀ q : ℕ, 2 ≤ q → Subsingleton (wcEtCoh V ℓ q) :=
by
  intro Ω _ _ X fX _ hirr hnorm hdim V ι _ _ ℓ hℓ hℓΩ q hq
  letI hE : HasExt (Sheaf (Scheme.smallEtaleTopology V) AddCommGrpCat.{u+1}) := HasExt.standard _

  by_cases hVe : IsEmpty V
  · have s1 : ∀ U : V.Etale, IsEmpty U.left := fun U => ⟨fun x => hVe.false (U.hom.base x)⟩
    have s2 : ∀ U : V.Etale, (⊥ : Sieve U) ∈ Scheme.smallEtaleTopology V U := by
      intro U
      change (⊥ : Sieve U) ∈ Scheme.smallGrothendieckTopology @Etale V U
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale V
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale V
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      exact ((s1 U).false x).elim
    have s4 : ∀ G : Sheaf (Scheme.smallEtaleTopology V) AddCommGrpCat.{u+1}, Limits.IsZero G := by
      intro G
      have h : Limits.IsZero G.obj :=
        Functor.isZero G.obj (fun X => (Sheaf.isTerminalOfBotCover G X.unop (s2 X.unop)).isZero)
      exact Limits.IsZero.of_full_of_faithful_of_isZero
        (sheafToPresheaf (Scheme.smallEtaleTopology V) AddCommGrpCat.{u+1}) G h
    have hB := s4 ((constantSheaf (Scheme.smallEtaleTopology V) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))
    have hsub : ∀ {A B : Sheaf (Scheme.smallEtaleTopology V) AddCommGrpCat.{u+1}},
        Limits.IsZero B → Subsingleton (Abelian.Ext A B q) := by
      intro A B hB
      have hx : ∀ x : Abelian.Ext A B q, x = 0 := by
        intro x
        rw [← Abelian.Ext.comp_mk₀_id x, hB.eq_of_src (𝟙 B) 0, Abelian.Ext.mk₀_zero,
          Abelian.Ext.comp_zero]
      exact ⟨fun x y => (hx x).trans (hx y).symm⟩
    unfold wcEtCoh
    exact hsub (A := (constantSheaf (Scheme.smallEtaleTopology V) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) hB
  rw [not_isEmpty_iff] at hVe

  haveI : ∀ x : X, _root_.IsReduced (X.presheaf.stalk x) := fun x => by
    haveI := (hnorm x).1
    infer_instance
  haveI : AlgebraicGeometry.IsReduced X := isReduced_of_isReduced_stalk X
  haveI := hirr
  haveI : AlgebraicGeometry.IsIntegral X := isIntegral_of_irreducibleSpace_of_isReduced X
  obtain ⟨hVint, hVnorm, hVdim⟩ :=
    wc_open_curve_integral_normal_dim Ω X fX hirr hnorm hdim V ι hVe
  haveI := hVint

  have hη : ι (genericPoint V) = genericPoint X := genericPoint_eq_of_isOpenImmersion ι
  let eff : X.functionField ≃+* V.functionField :=
    ((X.presheaf.stalkCongr (Inseparable.of_eq hη.symm)) ≪≫
      asIso (ι.stalkMap (genericPoint V))).commRingCatIsoToRingEquiv

  obtain ⟨φ, t, ht⟩ := wc_curve_function_field_trdeg_one Ω X fX hdim
  letI := φ.toAlgebra
  have hL : ∀ (L : Type u) [Field L] [Algebra V.functionField L],
      Algebra.IsAlgebraic V.functionField L →
      letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of L))) AddCommGrpCat.{u+1}) :=
        HasExt.standard _
      ∀ q : ℕ, Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of L)))
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (wcEtGm (Spec (.of L)))
        (q + 1)) := by
    intro L _ _ hKL
    refine wc_et_gm_field_vanishing_of_norm_surj L ?_
    intro E _ _ hLE F _ _ _
    letI : Algebra V.functionField E :=
      ((algebraMap L E).comp (algebraMap V.functionField L)).toAlgebra
    haveI : IsScalarTower V.functionField L E := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI := hKL
    haveI := hLE
    haveI hVE : Algebra.IsAlgebraic V.functionField E :=
      Algebra.IsAlgebraic.trans V.functionField L E
    letI : Algebra X.functionField V.functionField := eff.toRingHom.toAlgebra
    letI : Algebra X.functionField E :=
      ((algebraMap V.functionField E).comp (algebraMap X.functionField V.functionField)).toAlgebra
    haveI : IsScalarTower X.functionField V.functionField E :=
      IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : Algebra.IsIntegral X.functionField V.functionField :=
      ⟨fun x => by
        have hx : x = algebraMap X.functionField V.functionField (eff.symm x) :=
          (eff.apply_symm_apply x).symm
        rw [hx]
        exact isIntegral_algebraMap⟩
    haveI : Algebra.IsAlgebraic X.functionField V.functionField := inferInstance
    haveI hXE : Algebra.IsAlgebraic X.functionField E :=
      Algebra.IsAlgebraic.trans X.functionField V.functionField E
    exact wc_c1_norm_surjective E (wc_tsen_algebraic_c1 Ω X.functionField t ht E hXE) F

  have hj := wc_et_gm_generic_push_acyclic_integral V hL
  haveI : LocallyOfFiniteType (ι ≫ fX) := inferInstance
  have hQ := wc_et_gm_divisor_coker_acyclic_lft Ω V (ι ≫ fX) hVnorm hVdim
  haveI := wc_et_gm_to_generic_mono V
  have K2 : ∀ (p : ℕ) (e : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology V)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (wcEtGm V) (p + 2)), e = 0 := by
    intro p e
    let κ := wcEtGmToAt V (genericPoint V)
    let S := ShortComplex.mk κ (Limits.cokernel.π κ) (Limits.cokernel.condition κ)
    have hS : S.ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel κ) inferInstance inferInstance
    have hx : e.comp (Abelian.Ext.mk₀ S.f) (add_zero _) = 0 :=
      @Subsingleton.elim _ (hj (p + 1)) _ 0
    obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hS e hx (n₀ := p + 1) rfl
    have hx0 : x₃ = 0 := @Subsingleton.elim _ (hQ p) _ _
    rw [← hx₃, hx0, Abelian.Ext.zero_comp]

  obtain ⟨e₁⟩ := wc_et_gm_h1_zariski V
  have K3 : ∀ y : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology V)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (wcEtGm V) 1,
      ∃ y', ℓ • y' = y := by
    intro y
    obtain ⟨z, hz⟩ := wc_zar_affine_curve_pic_ell_divisible Ω X fX hirr hnorm hdim V ι hVe ℓ hℓ
      hℓΩ (e₁ y)
    refine ⟨e₁.symm z, ?_⟩
    rw [← map_nsmul, hz, AddEquiv.symm_apply_apply]

  obtain ⟨κ, hκ, hS⟩ := wc_et_kummer_ses_gen Ω V (ι ≫ fX) ℓ hℓΩ
  have hstar : ∀ (y' : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology V)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (wcEtGm V) 1) (n : ℕ),
      y'.comp (Abelian.Ext.mk₀ (n • 𝟙 (wcEtGm V))) (add_zero 1) = n • y' := by
    intro y' n
    induction n with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    | succ n ih =>
      rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih,
        Abelian.Ext.comp_mk₀_id]
  obtain ⟨p, rfl⟩ : ∃ p, q = p + 2 := ⟨q - 2, by omega⟩
  have hx : ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology V)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      ((constantSheaf (Scheme.smallEtaleTopology V) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) (p + 2), x = 0 := by
    intro x
    have h0 : x.comp (Abelian.Ext.mk₀ κ) (add_zero _) = 0 := K2 p _
    obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hS x h0 (n₀ := p + 1) rfl
    rcases p with _ | k
    · obtain ⟨y', hy'⟩ := K3 y
      have hc : (Abelian.Ext.mk₀ (ℓ • 𝟙 (wcEtGm V))).comp hS.extClass (zero_add 1) = 0 :=
        hS.comp_extClass
      calc x = y.comp hS.extClass (by omega) := hy.symm
        _ = (y'.comp (Abelian.Ext.mk₀ (ℓ • 𝟙 (wcEtGm V))) (add_zero 1)).comp hS.extClass
              (by omega) := by rw [hstar y' ℓ, hy']
        _ = y'.comp ((Abelian.Ext.mk₀ (ℓ • 𝟙 (wcEtGm V))).comp hS.extClass (zero_add 1))
              (by omega) := Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (zero_add 1) (by omega)
        _ = 0 := by rw [hc, Abelian.Ext.comp_zero]
    · have hy0 : y = 0 := K2 k y
      rw [← hy, hy0, Abelian.Ext.zero_comp]
  unfold wcEtCoh
  exact ⟨fun a b => (hx a).trans (hx b).symm⟩

theorem wc_et_affine_curve_torsion_vanishing : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (Xb : Scheme.{u}) (fX : Xb ⟶ Spec (.of Ω)) [IsProper fX] [SmoothOfRelativeDimension 1 fX] (U : Scheme.{u}) (j : U ⟶ Xb) [IsOpenImmersion j] [IsAffine U] (m : ℕ), (m : Ω) ≠ 0 → ∀ (G : Sheaf (Scheme.smallEtaleTopology U) AddCommGrpCat.{u+1}), m • 𝟙 G = 0 → letI : HasExt (Sheaf (Scheme.smallEtaleTopology U) AddCommGrpCat.{u+1}) := HasExt.standard _; ∀ q : ℕ, 2 ≤ q → ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology U) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) G q, x = 0 :=
by
  intro Ω _ _ Xb fX _ _ U j _ _ m hm G hG q hq x
  letI hE : HasExt (Sheaf (Scheme.smallEtaleTopology U) AddCommGrpCat.{u+1}) := HasExt.standard _

  have hm0 : m ≠ 0 := by
    rintro rfl
    exact hm (by simp)

  have hdim : topologicalKrullDim Xb ≤ ((1 : ℕ) : WithBot ℕ∞) :=
    wc_smooth_alg_closed_dim_le Ω Xb fX 1
  obtain ⟨L, ⟨adj⟩, hLlim, -⟩ := wc_et_push_left_adjoint j
  haveI := hLlim
  haveI : Limits.PreservesColimitsOfSize.{0, 0} L := adj.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits L := inferInstance
  haveI : L.IsLeftAdjoint := adj.isLeftAdjoint

  have hIso : ∀ (A B : Sheaf (Scheme.smallEtaleTopology U) AddCommGrpCat.{u+1}), Nonempty (A ≅ B) →
      (∀ q : ℕ, 1 < q → ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology U)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) A q, x = 0) →
      (∀ q : ℕ, 1 < q → ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology U)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) B q, x = 0) := by
    rintro A B ⟨e⟩ hA q hq x
    have h1 : x.comp (Abelian.Ext.mk₀ e.inv) (add_zero q) = 0 := hA q hq _
    calc x = (x.comp (Abelian.Ext.mk₀ e.inv) (add_zero q)).comp (Abelian.Ext.mk₀ e.hom)
          (add_zero q) := by
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
      _ = 0 := by rw [h1, Abelian.Ext.zero_comp]
  have hExtn : ∀ (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology U) AddCommGrpCat.{u+1})),
      S.ShortExact →
      (∀ q : ℕ, 1 < q → ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology U)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) S.X₁ q, x = 0) →
      (∀ q : ℕ, 1 < q → ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology U)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) S.X₃ q, x = 0) →
      (∀ q : ℕ, 1 < q → ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology U)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) S.X₂ q, x = 0) := by
    intro S hS h1 h3 q hq x
    have hx3 : x.comp (Abelian.Ext.mk₀ S.g) (add_zero q) = 0 := h3 q hq _
    obtain ⟨a, ha⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hS x hx3
    rw [← ha, h1 q hq a, Abelian.Ext.zero_comp]
  have hRet : ∀ (A B : Sheaf (Scheme.smallEtaleTopology U) AddCommGrpCat.{u+1}) (s : A ⟶ B)
      (r : B ⟶ A), s ≫ r = 𝟙 A →
      (∀ q : ℕ, 1 < q → ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology U)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) B q, x = 0) →
      (∀ q : ℕ, 1 < q → ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology U)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) A q, x = 0) := by
    intro A B s r hsr hB q hq x
    calc x = (x.comp (Abelian.Ext.mk₀ s) (add_zero q)).comp (Abelian.Ext.mk₀ r) (add_zero q) := by
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, hsr, Abelian.Ext.comp_mk₀_id]
      _ = 0 := by rw [hB q hq (x.comp (Abelian.Ext.mk₀ s) (add_zero q)), Abelian.Ext.zero_comp]

  refine wc_ext_torsion_prime_devissage ((constantSheaf (Scheme.smallEtaleTopology U)
    AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) 1 m hm0 ?_ G hG q (by omega) x
  intro p hp hpm F hF
  have hpΩ : (p : Ω) ≠ 0 := by
    obtain ⟨c, hc⟩ := hpm
    intro h
    apply hm
    rw [hc, Nat.cast_mul, h, zero_mul]

  have HZ : ∀ (W : Scheme.{u}) (fW : W ⟶ Spec (.of Ω)) [IsProper fW],
      topologicalKrullDim W ≤ ((0 : ℕ) : WithBot ℕ∞) → ∀ (V : Scheme.{u}) (ι : V ⟶ W)
      [IsOpenImmersion ι], ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh V p q) := by
    intro W fW _ hW V ι _ q' hq'
    exact wc_et_zero_dim_open_vanishing Ω W fW hW V ι p hp.ne_zero q' hq'
  have HN : ∀ (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX], IrreducibleSpace X →
      (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
      topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) → ∀ (V : Scheme.{u}) (ι : V ⟶ X)
      [IsOpenImmersion ι] [IsAffine V], ∀ q : ℕ, 2 ≤ q → Subsingleton (wcEtCoh V p q) := by
    intro X fX' _ hirr hnorm hdimX V ι _ _ q' hq'
    exact wc_et_normal_affine_curve_const_vanishing Ω X fX' hirr hnorm hdimX V ι p hp hpΩ q' hq'
  have HC := wc_et_affine_open_curve_reduction Ω p hp hpΩ HN HZ

  refine wc_et_torsion_ext_vanish_of_fp U inferInstance inferInstance p 1 ?_ F hF
  intro U' V' g hU'c hU'q hV'c hV'q htor

  obtain ⟨U'', V'', g'', hc1, hq1, hc2, hq2, htor'', ⟨e⟩⟩ :=
    wc_et_open_fp_lift j L ⟨adj⟩ U' V' g hU'c hU'q hV'c hV'q p htor
  refine hIso _ _ ⟨e⟩ ?_

  refine wc_et_fp_torsion_devissage_class Ω Xb fX p hp hpΩ
    (fun A => ∀ q : ℕ, 1 < q → ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology U)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (L.obj A) q, x = 0)
    ?_ ?_ ?_ ?_ U'' V'' g'' hc1 hq1 hc2 hq2 htor''
  · rintro A B ⟨e'⟩ hA
    exact hIso _ _ ⟨L.mapIso e'⟩ hA
  · intro S hS h1 h3
    exact hExtn (S.map L) (hS.map_of_exact L) h1 h3
  · intro A B s r hsr hB
    exact hRet _ _ (L.map s) (L.map r) (by rw [← L.map_comp, hsr, L.map_id]) hB
  · intro W π _ S hS hD
    exact wc_et_open_generator_vanishing Ω Xb fX hdim U j L ⟨adj⟩ p HC HZ W π S hS hD

theorem wc_zar_gm_h1_polynomial_vanish : ∀ (K : Type u) [Field K], letI : HasExt (Sheaf (Opens.grothendieckTopology (Spec (.of (Polynomial K)))) AddCommGrpCat.{u}) := HasExt.standard _; Subsingleton (Abelian.Ext ((constantSheaf (Opens.grothendieckTopology (Spec (.of (Polynomial K)))) AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ))) (wcZarGm (Spec (.of (Polynomial K)))) 1) :=
by
  intro K _
  letI : HasExt (Sheaf (Opens.grothendieckTopology (Spec (.of (Polynomial K)))) AddCommGrpCat.{u}) :=
    HasExt.standard _

  have e : Γ(Spec (.of (Polynomial K)), ⊤) ≃+* Polynomial K :=
    (Scheme.ΓSpecIso (CommRingCat.of (Polynomial K))).commRingCatIsoToRingEquiv
  haveI : IsDomain Γ(Spec (.of (Polynomial K)), ⊤) := Function.Injective.isDomain e e.injective
  haveI : IsPrincipalIdealRing Γ(Spec (.of (Polynomial K)), ⊤) :=
    IsPrincipalIdealRing.of_surjective e.symm.toRingHom e.symm.surjective
  haveI : IsDedekindDomain Γ(Spec (.of (Polynomial K)), ⊤) :=
    IsPrincipalIdealRing.isDedekindDomain _

  have hbot : ∀ x : Spec (.of (Polynomial K)), x ≠ genericPoint (Spec (.of (Polynomial K))) →
      x.asIdeal ≠ ⊥ := by
    intro x hx h
    apply hx
    rw [genericPoint_eq_bot_of_affine]
    exact PrimeSpectrum.ext (h.trans PrimeSpectrum.asIdeal_bot.symm)

  have hstalk : ∀ x : Spec (.of (Polynomial K)), x ≠ genericPoint (Spec (.of (Polynomial K))) →
      IsDiscreteValuationRing ((Spec (.of (Polynomial K))).presheaf.stalk x) := by
    intro x hx
    haveI : (x.asIdeal : Ideal (Polynomial K)).IsPrime := x.isPrime
    letI : Algebra (Polynomial K) ((Spec (.of (Polynomial K))).presheaf.stalk x) :=
      StructureSheaf.stalkAlgebra (Polynomial K) x
    haveI : IsLocalization.AtPrime ((Spec (.of (Polynomial K))).presheaf.stalk x) x.asIdeal :=
      StructureSheaf.IsLocalization.to_stalk (Polynomial K) x
    exact IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain (Polynomial K)
      (hbot x hx) _

  have hA : ∀ V : TopologicalSpace.Opens (Spec (.of (Polynomial K))),
      (V : Set (Spec (.of (Polynomial K)))).Nonempty → genericPoint (Spec (.of (Polynomial K))) ∈ V := by
    intro V hV
    exact ((genericPoint_spec (Spec (.of (Polynomial K)))).mem_open_set_iff V.isOpen).mpr
      (by rw [Set.univ_inter]; exact hV)
  have hB : ∀ V : TopologicalSpace.Opens (Spec (.of (Polynomial K))),
      IsCompact (V : Set (Spec (.of (Polynomial K)))) :=
    fun V => TopologicalSpace.NoetherianSpace.isCompact _
  have hC : ∀ S : Set (Spec (.of (Polynomial K))), S.Finite →
      genericPoint (Spec (.of (Polynomial K))) ∉ S → IsClosed S := by
    intro S hS hη
    rw [← Set.biUnion_of_singleton S]
    refine hS.isClosed_biUnion (fun x hx => ?_)
    have hx' : x ≠ genericPoint (Spec (.of (Polynomial K))) := fun h => hη (h ▸ hx)
    exact (PrimeSpectrum.isClosed_singleton_iff_isMaximal x).mpr
      (Ideal.IsPrime.isMaximal x.isPrime (hbot x hx'))

  have hprin : ∀ n : IsDedekindDomain.HeightOneSpectrum Γ(Spec (.of (Polynomial K)), ⊤) →₀ ℤ,
      ∃ f : (FractionRing Γ(Spec (.of (Polynomial K)), ⊤))ˣ, ∀ v, n v =
        FractionalIdeal.count (FractionRing Γ(Spec (.of (Polynomial K)), ⊤)) v
          (FractionalIdeal.spanSingleton (nonZeroDivisors Γ(Spec (.of (Polynomial K)), ⊤))
            (f : FractionRing Γ(Spec (.of (Polynomial K)), ⊤))) := by
    intro n
    obtain ⟨ψ₀, -, hψ₀⟩ := dedekind_classGroup_divisor_presentation Γ(Spec (.of (Polynomial K)), ⊤)
    apply (hψ₀ n).mp
    have h1 : ∀ c : ClassGroup Γ(Spec (.of (Polynomial K)), ⊤), c = 1 := by
      intro c
      refine ClassGroup.induction (FractionRing Γ(Spec (.of (Polynomial K)), ⊤))
        (P := fun c => c = 1) (fun I => ?_) c
      exact ClassGroup.mk_eq_one_iff.mpr (FractionalIdeal.isPrincipal _)
    haveI : Subsingleton (ClassGroup Γ(Spec (.of (Polynomial K)), ⊤)) :=
      ⟨fun a b => (h1 a).trans (h1 b).symm⟩
    exact Subsingleton.elim _ _

  have hU := isAffineOpen_top (Spec (.of (Polynomial K)))
  have hfin : (((⊤ : (Spec (.of (Polynomial K))).Opens) : Set (Spec (.of (Polynomial K))))ᶜ).Finite := by
    simp
  have hpts := wc_dedekind_affine_points (Spec (.of (Polynomial K))) ⊤ hU
  obtain ⟨ord, ι, h1, h2, h3, h4, h5, h6, h7⟩ := wc_curve_ord_units_data
    (Spec (.of (Polynomial K))) hstalk (wc_integral_hartogs_sections _) dvr_count_spanSingleton
    dedekind_count_localization ⊤ hU hfin hpts
  obtain ⟨φ, hφ⟩ := wc_zarGm_sections_units (Spec (.of (Polynomial K)))
  let ι' : ∀ V : TopologicalSpace.Opens (Spec (.of (Polynomial K))),
      (wcZarGm (Spec (.of (Polynomial K)))).obj.obj (Opposite.op V) →+
        Additive (FractionRing Γ(Spec (.of (Polynomial K)), ⊤))ˣ :=
    fun V => (ι V).comp (φ V).toAddMonoidHom
  have h7' : ∀ (V W : TopologicalSpace.Opens (Spec (.of (Polynomial K)))) (hWV : W ≤ V),
      (W : Set (Spec (.of (Polynomial K)))).Nonempty →
      ∀ g, ι' W ((wcZarGm (Spec (.of (Polynomial K)))).obj.map (homOfLE hWV).op g) = ι' V g := by
    intro V W hWV hW g
    show ι W (φ W _) = ι V (φ V g)
    rw [hφ V W hWV g, h4 V W hWV hW]
    rfl
  have h8' : ∀ V : TopologicalSpace.Opens (Spec (.of (Polynomial K))),
      (V : Set (Spec (.of (Polynomial K)))).Nonempty → Function.Injective (ι' V) :=
    fun V hV => (h5 V hV).comp (φ V).injective
  have h9' : ∀ V : TopologicalSpace.Opens (Spec (.of (Polynomial K))),
      (V : Set (Spec (.of (Polynomial K)))).Nonempty →
      ∀ m, (∃ g, ι' V g = m) ↔ ∀ x ∈ V, ord x m = 0 := by
    intro V hV m
    rw [← h6 V hV m]
    constructor
    · rintro ⟨g, rfl⟩
      exact ⟨φ V g, rfl⟩
    · rintro ⟨g, rfl⟩
      refine ⟨(φ V).symm g, ?_⟩
      show ι V (φ V ((φ V).symm g)) = ι V g
      rw [AddEquiv.apply_symm_apply]

  have hP : ∀ n : (Spec (.of (Polynomial K))) →₀ ℤ, n (genericPoint (Spec (.of (Polynomial K)))) = 0 →
      ∃ m, ∀ x, ord x m = n x := by
    intro n hn
    obtain ⟨f, hf⟩ := hprin (Finsupp.comapDomain
      (fun v : IsDedekindDomain.HeightOneSpectrum Γ(Spec (.of (Polynomial K)), ⊤) =>
        (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩ : Spec (.of (Polynomial K)))) n hpts.2.1.injOn)
    refine ⟨Additive.ofMul f, fun x => ?_⟩
    by_cases hx : x = genericPoint (Spec (.of (Polynomial K)))
    · rw [hx, h1, hn]
    · obtain ⟨v, rfl⟩ := hpts.2.2.2 x (by simp) hx
      rw [h7, ← hf, Finsupp.comapDomain_apply]

  obtain ⟨𝒦, 𝒟, i, d, hid, hSES, hflasque, eK, eD, heD_inj, -, heDη, hdiv⟩ :=
    wc_abstract_divisor_ses (Spec (.of (Polynomial K))) (genericPoint (Spec (.of (Polynomial K))))
      _ ord (wcZarGm (Spec (.of (Polynomial K)))) ι' hA hB hC h1 h2 h3 h7' h8' h9'
  have hsub := wc_zar_flasque_ext_one_vanish (Spec (.of (Polynomial K))) 𝒦 hflasque
  have hE1 : ∀ e : Abelian.Ext ((constantSheaf (Opens.grothendieckTopology (Spec (.of (Polynomial K))))
      AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ))) 𝒦 1, e = 0 :=
    fun e => @Subsingleton.elim _ hsub e 0
  obtain ⟨E⟩ := wc_h1_quotient_of_acyclic_middle
    (Opens.grothendieckTopology (Spec (.of (Polynomial K)))) Limits.isTerminalTop i d hid hSES hE1
  have hsurj : Function.Surjective (d.hom.app (Opposite.op ⊤)).hom := by
    intro w
    obtain ⟨m, hm⟩ := hP (eD w) (heDη w)
    refine ⟨eK.symm m, heD_inj ?_⟩
    ext x
    rw [hdiv, AddEquiv.apply_symm_apply, hm]
  haveI : Subsingleton (𝒟.obj.obj (Opposite.op ⊤) ⧸ (d.hom.app (Opposite.op ⊤)).hom.range) := by
    constructor
    intro a b
    obtain ⟨x, rfl⟩ := QuotientAddGroup.mk_surjective a
    obtain ⟨y, rfl⟩ := QuotientAddGroup.mk_surjective b
    rw [QuotientAddGroup.eq]
    exact hsurj (-x + y)
  exact E.toEquiv.subsingleton

theorem wc_polynomial_open_immersion_projK_one : ∀ (K : Type u) [Field K], ∃ j : Spec (.of (Polynomial K)) ⟶ wcProjK K 1, IsOpenImmersion j :=
by
  intro K _
  classical
  letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) :=
    MvPolynomial.gradedAlgebra

  have scaling : ∀ (T : Type u) [CommRing T] (ν ι : MvPolynomial (Fin (1 + 1)) K →+* T) (t : T),
      (∀ c : K, ν (MvPolynomial.C c) = ι (MvPolynomial.C c)) →
      (∀ k, ν (MvPolynomial.X k) * t = ι (MvPolynomial.X k)) →
      ∀ (n : ℕ) (a : MvPolynomial (Fin (1 + 1)) K), a.IsHomogeneous n → ν a * t ^ n = ι a := by
    intro T _ ν ι t hC hXk n a ha
    conv_rhs => rw [a.as_sum]
    conv_lhs => rw [a.as_sum]
    rw [map_sum, map_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl (fun m hm => ?_)
    have hdeg : ∑ k ∈ m.support, m k = n := by
      have := ha (MvPolynomial.mem_support_iff.mp hm)
      simpa [Finsupp.weight_apply, Finsupp.sum] using this
    rw [MvPolynomial.monomial_eq, map_mul, map_mul, Finsupp.prod, map_prod, map_prod, ← hdeg,
      ← Finset.prod_pow_eq_pow_sum, mul_assoc, ← Finset.prod_mul_distrib, hC]
    congr 1
    refine Finset.prod_congr rfl (fun k _ => ?_)
    rw [map_pow, map_pow, ← mul_pow, hXk]
  have hX : ∀ k : Fin (1 + 1), (MvPolynomial.X k : MvPolynomial (Fin (1 + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 1 :=
    fun k => (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K k)

  have chart : ∀ i : Fin (1 + 1), ∃ e : MvPolynomial (Fin 1) K ≃+* HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X i),
      ∀ c : K, e (MvPolynomial.C c) =
        HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
          (Submonoid.powers (MvPolynomial.X i))
          (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0) c) := by
    intro i
    let κ := (HomogeneousLocalization.fromZeroRingHom
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (Submonoid.powers (MvPolynomial.X i))).comp
        (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0))
    have h1 : ∀ j : Fin 1, (MvPolynomial.X (i.succAbove j) : MvPolynomial (Fin (1 + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K (1 • 1) := fun j => by
      rw [smul_eq_mul, mul_one]; exact hX _
    let y : Fin 1 → HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X i) := fun j =>
      HomogeneousLocalization.Away.mk _ (hX i) 1 (MvPolynomial.X (i.succAbove j)) (h1 j)
    let φ := MvPolynomial.eval₂Hom κ y
    let δ : MvPolynomial (Fin (1 + 1)) K →ₐ[K] MvPolynomial (Fin 1) K :=
      MvPolynomial.aeval (Fin.insertNth i (1 : MvPolynomial (Fin 1) K) MvPolynomial.X)
    have hδi : δ (MvPolynomial.X i) = 1 := by
      simp only [δ, MvPolynomial.aeval_X, Fin.insertNth_apply_same]
    have hδs : ∀ j, δ (MvPolynomial.X (i.succAbove j)) = MvPolynomial.X j := by
      intro j; simp only [δ, MvPolynomial.aeval_X, Fin.insertNth_apply_succAbove]
    have hδC : ∀ c, δ (MvPolynomial.C c) = MvPolynomial.C c := by
      intro c; simp only [δ, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
    let L := Localization (Submonoid.powers (MvPolynomial.X i : MvPolynomial (Fin (1 + 1)) K))
    have hu : IsUnit (δ.toRingHom (MvPolynomial.X i)) := by
      show IsUnit (δ (MvPolynomial.X i))
      rw [hδi]; exact isUnit_one
    let Λ : L →+* MvPolynomial (Fin 1) K := IsLocalization.Away.lift (MvPolynomial.X i) hu
    have hΛ : ∀ a, Λ (algebraMap _ L a) = δ a := fun a => IsLocalization.Away.lift_eq _ hu a
    let ψ : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
        (MvPolynomial.X i) →+* MvPolynomial (Fin 1) K := Λ.comp (algebraMap _ L)
    have hF : ∀ (n : ℕ) (a : MvPolynomial (Fin (1 + 1)) K)
        (ha : a ∈ MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K (n • 1)),
        ψ (HomogeneousLocalization.Away.mk _ (hX i) n a ha) = δ a := by
      intro n a ha
      have hs := IsLocalization.mk'_spec L a
        (⟨MvPolynomial.X i ^ n, n, rfl⟩ : Submonoid.powers (MvPolynomial.X i))
      have h2 := congrArg Λ hs
      rw [map_mul, hΛ, hΛ] at h2
      change Λ _ * δ (MvPolynomial.X i ^ n) = δ a at h2
      rw [map_pow, hδi, one_pow, mul_one] at h2
      show Λ (algebraMap _ L _) = _
      rw [HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
        Localization.mk_eq_mk'_apply]
      exact h2
    have hC0 : ∀ c : K, (MvPolynomial.C c : MvPolynomial (Fin (1 + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K (0 • 1) := fun c => by
      rw [zero_smul]
      exact (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_C _ c)
    have hκ : ∀ c, κ c = HomogeneousLocalization.Away.mk _ (hX i) 0 (MvPolynomial.C c) (hC0 c) := by
      intro c
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk]
      change (HomogeneousLocalization.mk
          ⟨0, algebraMap K _ c, 1, by rw [SetLike.GradeZero.coe_one]; exact Submonoid.one_mem _⟩ :
            HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
              (MvPolynomial.X i)).val = _
      rw [HomogeneousLocalization.val_mk]
      congr 1
    have hψφ : ψ.comp φ = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro c
        rw [RingHom.comp_apply, RingHom.id_apply]
        show ψ (MvPolynomial.eval₂Hom κ y (MvPolynomial.C c)) = _
        rw [MvPolynomial.eval₂Hom_C, hκ, hF, hδC]
      · intro j
        rw [RingHom.comp_apply, RingHom.id_apply]
        show ψ (MvPolynomial.eval₂Hom κ y (MvPolynomial.X j)) = _
        rw [MvPolynomial.eval₂Hom_X', hF, hδs]
    have hφψ : φ.comp ψ = RingHom.id _ := by
      refine RingHom.ext fun x => ?_
      obtain ⟨n, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective _ (hX i) x
      rw [RingHom.comp_apply, RingHom.id_apply, hF]
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk'_apply, eq_comm,
        IsLocalization.mk'_eq_iff_eq_mul]
      have hahom : a.IsHomogeneous n := by
        rw [smul_eq_mul, mul_one] at ha
        exact (MvPolynomial.mem_homogeneousSubmodule _ _).mp ha
      have key := scaling L
        ((algebraMap (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X i)) L).comp
            (φ.comp δ.toRingHom))
        (algebraMap (MvPolynomial (Fin (1 + 1)) K) L)
        (algebraMap (MvPolynomial (Fin (1 + 1)) K) L (MvPolynomial.X i)) ?_ ?_ n a hahom
      · rw [← key, RingHom.comp_apply, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply]
        congr 1
        exact (map_pow _ _ _).symm
      · intro c
        show algebraMap _ L (φ (δ (MvPolynomial.C c))) = _
        rw [hδC]
        show algebraMap _ L (MvPolynomial.eval₂Hom κ y (MvPolynomial.C c)) = _
        rw [MvPolynomial.eval₂Hom_C, hκ, HomogeneousLocalization.algebraMap_apply,
          HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk'_apply,
          IsLocalization.mk'_eq_iff_eq_mul]
        show _ = _ * algebraMap (MvPolynomial (Fin (1 + 1)) K) L (MvPolynomial.X i ^ 0)
        rw [pow_zero, map_one, mul_one]
      · intro k
        obtain h | ⟨j, h⟩ := Fin.eq_self_or_eq_succAbove i k
        · rw [h]
          show algebraMap _ L (φ (δ (MvPolynomial.X i))) * _ = _
          rw [hδi, map_one, map_one, one_mul]
        · rw [h]
          show algebraMap _ L (φ (δ (MvPolynomial.X (i.succAbove j)))) * _ = _
          rw [hδs]
          show algebraMap _ L (MvPolynomial.eval₂Hom κ y (MvPolynomial.X j)) * _ = _
          rw [MvPolynomial.eval₂Hom_X', HomogeneousLocalization.algebraMap_apply,
            HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk'_apply]
          have hs := IsLocalization.mk'_spec L
            (MvPolynomial.X (i.succAbove j) : MvPolynomial (Fin (1 + 1)) K)
            (⟨MvPolynomial.X i ^ 1, 1, rfl⟩ : Submonoid.powers (MvPolynomial.X i))
          rw [← hs]
          congr 1
          show _ = algebraMap (MvPolynomial (Fin (1 + 1)) K) L (MvPolynomial.X i ^ 1)
          rw [pow_one]
    exact ⟨RingEquiv.ofRingHom φ ψ hφψ hψφ, fun c => MvPolynomial.eval₂Hom_C _ _ _⟩
  obtain ⟨e, -⟩ := chart 0
  let e' : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
      (MvPolynomial.X 0) ≃+* Polynomial K :=
    e.symm.trans (MvPolynomial.uniqueAlgEquiv K (Fin 1)).toRingEquiv
  refine ⟨Spec.map e'.toCommRingCatIso.hom ≫
    Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X 0) (hX 0)
      one_pos, ?_⟩
  infer_instance

theorem wc_et_algclosed_affine_line_acyclic : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ℓ : ℕ), ℓ.Prime → (ℓ : Ω) ≠ 0 → Nat.card (wcEtCoh (Spec (.of (Polynomial Ω))) ℓ 0) = ℓ ∧ ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh (Spec (.of (Polynomial Ω))) ℓ q) :=
by
  intro Ω _ _ ℓ hℓ hℓΩ
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of (Polynomial Ω)))) AddCommGrpCat.{u+1}) :=
    HasExt.standard _

  have H0 : Nat.card (wcEtCoh (Spec (.of (Polynomial Ω))) ℓ 0) = ℓ := by
    have hconn : ConnectedSpace (Spec (.of (Polynomial Ω))) := inferInstance
    obtain ⟨hF⟩ := wc_et_const_fullyFaithful_connected _ hconn
    have e0 : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of (Polynomial Ω))))
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
        ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of (Polynomial Ω))))
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) 0 ≃
        ULift.{u+1} (ZMod ℓ) := by
      refine Abelian.Ext.homEquiv₀.trans ?_
      refine (hF.homEquiv (X := AddCommGrpCat.of (ULift.{u+1} ℤ))
        (Y := AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))).symm.trans ?_
      exact
        { toFun := fun f => f.hom (ULift.up 1)
          invFun := fun m => AddCommGrpCat.ofHom
            ((zmultiplesHom (ULift.{u+1} (ZMod ℓ)) m).comp AddEquiv.ulift.toAddMonoidHom)
          left_inv := fun f => by
            apply AddCommGrpCat.hom_ext
            apply AddMonoidHom.ext
            rintro ⟨n⟩
            simp only [AddCommGrpCat.hom_ofHom, AddMonoidHom.coe_comp, Function.comp_apply,
              zmultiplesHom_apply]
            change n • f.hom (ULift.up 1) = f.hom (ULift.up n)
            rw [← map_zsmul]
            congr 1
            apply ULift.ext
            simp
          right_inv := fun m => by
            simp only [AddCommGrpCat.hom_ofHom, AddMonoidHom.coe_comp, Function.comp_apply,
              zmultiplesHom_apply]
            exact one_smul ℤ m }
    have e1 : wcEtCoh (Spec (.of (Polynomial Ω))) ℓ 0 ≃ ULift.{u+1} (ZMod ℓ) := e0
    rw [Nat.card_congr e1, Nat.card_ulift, Nat.card_zmod]

  have H1 : Subsingleton (wcEtCoh (Spec (.of (Polynomial Ω))) ℓ 1) := by
    obtain ⟨-, ⟨hT⟩, -⟩ := wc_zarToEt_props (Spec (.of (Polynomial Ω)))
    obtain ⟨ι, hι, hSES⟩ := wc_et_kummer_ses_gen Ω (Spec (.of (Polynomial Ω)))
      (Spec.map (CommRingCat.ofHom (algebraMap Ω (Polynomial Ω)))) ℓ hℓΩ
    obtain ⟨E⟩ := wc_et_gm_h1_zariski (Spec (.of (Polynomial Ω)))
    have hZ := wc_zar_gm_h1_polynomial_vanish Ω
    have hB : ∀ e : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of (Polynomial Ω))))
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
        (wcEtGm (Spec (.of (Polynomial Ω)))) 1, e = 0 := by
      intro e
      have h0 : E e = 0 := @Subsingleton.elim _ hZ _ _
      have := congrArg E.symm h0
      rwa [AddEquiv.symm_apply_apply, map_zero] at this
    obtain ⟨E₁⟩ := wc_h1_quotient_of_acyclic_middle
      (Scheme.smallEtaleTopology (Spec (.of (Polynomial Ω)))) hT ι _ hι hSES hB

    have hsurj : Function.Surjective ((ℓ • 𝟙 (wcEtGm (Spec (.of (Polynomial Ω))))).hom.app
        (Opposite.op ((wcZarToEt (Spec (.of (Polynomial Ω)))).obj ⊤))).hom := by
      intro s
      obtain ⟨ε, hεnat, -⟩ := wc_et_const_hom_sections_equiv (Spec (.of (Polynomial Ω))) _ hT
      obtain ⟨E₀⟩ := wc_et_gm_h0_units (Spec (.of (Polynomial Ω)))
      let Φ : ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of (Polynomial Ω))))
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶
          wcEtGm (Spec (.of (Polynomial Ω)))) ≃+ Additive (Γ(Spec (.of (Polynomial Ω)), ⊤))ˣ :=
        Abelian.Ext.addEquiv₀.symm.trans E₀
      let φ := (ε (wcEtGm (Spec (.of (Polynomial Ω))))).symm s
      let w : (Γ(Spec (.of (Polynomial Ω)), ⊤))ˣ := Additive.toMul (Φ φ)
      let e : Γ(Spec (.of (Polynomial Ω)), ⊤) ≃+* Polynomial Ω :=
        (Scheme.ΓSpecIso (CommRingCat.of (Polynomial Ω))).commRingCatIsoToRingEquiv
      have hu : IsUnit (e (w : Γ(Spec (.of (Polynomial Ω)), ⊤))) := w.isUnit.map e
      obtain ⟨r, hr, hrw⟩ := Polynomial.isUnit_iff.mp hu
      obtain ⟨d, hd⟩ := IsAlgClosed.exists_pow_nat_eq r hℓ.pos
      have hd0 : d ≠ 0 := by
        rintro rfl
        rw [zero_pow hℓ.ne_zero] at hd
        exact hr.ne_zero hd.symm
      have hCd : IsUnit (e.symm (Polynomial.C d)) :=
        (Polynomial.isUnit_C.mpr (Ne.isUnit hd0)).map e.symm
      have hv' : hCd.unit ^ ℓ = w := by
        ext
        rw [Units.val_pow_eq_pow_val, IsUnit.unit_spec, ← map_pow, ← Polynomial.C_pow, hd, hrw,
          RingEquiv.symm_apply_apply]
      have hψ : ℓ • Φ.symm (Additive.ofMul hCd.unit) = φ := by
        apply Φ.injective
        rw [map_nsmul, AddEquiv.apply_symm_apply, ← ofMul_pow, hv']
        rfl
      refine ⟨ε _ (Φ.symm (Additive.ofMul hCd.unit)), ?_⟩
      rw [← hεnat, Preadditive.comp_nsmul, Category.comp_id, hψ]
      exact (ε _).apply_symm_apply s
    haveI hQ : Subsingleton ((wcEtGm (Spec (.of (Polynomial Ω)))).obj.obj
        (Opposite.op ((wcZarToEt (Spec (.of (Polynomial Ω)))).obj ⊤)) ⧸
        ((ℓ • 𝟙 (wcEtGm (Spec (.of (Polynomial Ω))))).hom.app
          (Opposite.op ((wcZarToEt (Spec (.of (Polynomial Ω)))).obj ⊤))).hom.range) := by
      constructor
      intro a b
      obtain ⟨x, rfl⟩ := QuotientAddGroup.mk_surjective a
      obtain ⟨y, rfl⟩ := QuotientAddGroup.mk_surjective b
      rw [QuotientAddGroup.eq]
      exact hsurj (-x + y)
    exact E₁.toEquiv.subsingleton

  have H2 : ∀ q : ℕ, 2 ≤ q → Subsingleton (wcEtCoh (Spec (.of (Polynomial Ω))) ℓ q) := by
    intro q hq
    obtain ⟨j, hj⟩ := wc_polynomial_open_immersion_projK_one Ω
    haveI := hj
    haveI := wc_proj_space_isProper Ω 1
    haveI := wc_proj_space_smooth Ω 1
    have hA : (ℓ • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) = 0 := by
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      rintro ⟨z⟩
      apply ULift.ext
      simp
    have htor : ℓ • 𝟙 ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of (Polynomial Ω))))
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) = 0 := by
      rw [← CategoryTheory.Functor.map_id, ← CategoryTheory.Functor.map_nsmul, hA,
        CategoryTheory.Functor.map_zero]
    have h := wc_et_affine_curve_torsion_vanishing Ω (wcProjK Ω 1) (wcProjKStr Ω 1)
      (Spec (.of (Polynomial Ω))) j ℓ hℓΩ _ htor q hq
    exact ⟨fun a b => (h a).trans (h b).symm⟩
  refine ⟨H0, fun q hq => ?_⟩
  rcases Nat.lt_or_ge q 2 with h | h
  · obtain rfl : q = 1 := by omega
    exact H1
  · exact H2 q h

theorem wc_et_coh_subsingleton_iff_injres_cocycles : ∀ (Y : Scheme.{u}) (m q : ℕ) (J : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))), Subsingleton (wcEtCoh Y m q) ↔ ∀ z : (J.cocomplex.X q).obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y))), ((J.cocomplex.d q (q + 1)).hom.app (Opposite.op (Scheme.Etale.mk (𝟙 Y)))).hom z = 0 → ∃ b : (J.cocomplex.X (q - 1)).obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y))), ((J.cocomplex.d (q - 1) q).hom.app (Opposite.op (Scheme.Etale.mk (𝟙 Y)))).hom b = z :=
by
  intro Y m q J
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _

  have hgen : ∀ (X : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (Z : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (R : InjectiveResolution Z),
      (Subsingleton (Abelian.Ext X Z q) ↔ ∀ f : X ⟶ R.cocomplex.X q,
        f ≫ R.cocomplex.d q (q + 1) = 0 →
        ∃ g : X ⟶ R.cocomplex.X (q - 1), g ≫ R.cocomplex.d (q - 1) q = f) := by
    intro X Z R
    rcases Nat.eq_zero_or_pos q with rfl | hq
    · have hd : R.cocomplex.d (0 - 1) 0 = 0 := R.cocomplex.shape _ _ (by simp)
      constructor
      · intro hs f hf
        refine ⟨0, ?_⟩
        rw [Limits.zero_comp]
        have hsub : Subsingleton (X ⟶ Z) := Equiv.subsingleton (Abelian.Ext.homEquiv₀).symm
        let h := R.exact₀.lift f hf
        have hh : h ≫ R.ι.f 0 = f := R.exact₀.lift_f f hf
        have h1 : h ≫ (HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 Z).hom = 0 :=
          Subsingleton.elim _ _
        have h2 : h = 0 := by
          have := congrArg (· ≫ (HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 Z).inv) h1
          simpa only [Category.assoc, Iso.hom_inv_id, Category.comp_id, Limits.zero_comp] using this
        rw [← hh, h2, Limits.zero_comp]
      · intro H
        refine ⟨fun a b => ?_⟩
        have key : ∀ α : Abelian.Ext X Z 0, α = 0 := by
          intro α
          obtain ⟨f, hf, rfl⟩ := R.extMk_surjective α 1 rfl
          obtain ⟨g, hg⟩ := H f hf
          rw [hd, Limits.comp_zero] at hg
          subst hg
          exact R.extMk_zero 1 rfl
        rw [key a, key b]
    · constructor
      · intro hs f hf
        exact (R.extMk_eq_zero_iff f (q + 1) rfl hf (q - 1) (Nat.sub_add_cancel hq)).mp
          (Subsingleton.elim _ _)
      · intro H
        refine ⟨fun a b => ?_⟩
        have key : ∀ α : Abelian.Ext X Z q, α = 0 := by
          intro α
          obtain ⟨f, hf, rfl⟩ := R.extMk_surjective α (q + 1) rfl
          exact (R.extMk_eq_zero_iff f (q + 1) rfl hf (q - 1) (Nat.sub_add_cancel hq)).mpr (H f hf)
        rw [key a, key b]
  have hM := hgen ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ)))
    ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) J

  have hT : Limits.IsTerminal (Scheme.Etale.mk (𝟙 Y)) :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
  let adj := constantSheafAdj (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} hT
  let ev : ∀ X : AddCommGrpCat.{u+1}, (AddCommGrpCat.of (ULift.{u+1} ℤ) ⟶ X) ≃ X := fun X =>
    { toFun := fun φ => φ.hom (ULift.up 1)
      invFun := fun x => AddCommGrpCat.ofHom
        ((zmultiplesHom X x).comp (AddEquiv.ulift : ULift.{u+1} ℤ ≃+ ℤ).toAddMonoidHom)
      left_inv := fun φ => by
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        rintro ⟨n⟩
        have hn : (ULift.up n : ULift.{u+1} ℤ) = n • (ULift.up 1 : ULift.{u+1} ℤ) := by
          apply ULift.ext
          simp
        change (zmultiplesHom X (φ.hom (ULift.up 1))) n = φ.hom (ULift.up n)
        rw [zmultiplesHom_apply, hn, map_zsmul]
      right_inv := fun x => by
        change (zmultiplesHom X x) (1 : ℤ) = x
        rw [zmultiplesHom_apply, one_zsmul] }
  let ε : ∀ M : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1},
      ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ M) ≃
        M.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y))) := fun M =>
    (adj.homEquiv (AddCommGrpCat.of (ULift.{u+1} ℤ)) M).trans
      (ev (M.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y)))))
  have hnat : ∀ (M M' : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ψ : M ⟶ M')
      (g : (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ M),
      ε M' (g ≫ ψ) = (ψ.hom.app (Opposite.op (Scheme.Etale.mk (𝟙 Y)))).hom (ε M g) := by
    intro M M' ψ g
    simp only [ε, Equiv.trans_apply, Adjunction.homEquiv_naturality_right]
    rfl
  have h0 : ∀ M : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}, ε M 0 = 0 := by
    intro M
    have h := hnat M M 0 0
    rw [Limits.zero_comp] at h
    rw [h]
    rfl

  change Subsingleton (Abelian.Ext _ _ q) ↔ _
  rw [hM]
  constructor
  · intro H z hz
    have hf : (ε (J.cocomplex.X q)).symm z ≫ J.cocomplex.d q (q + 1) = 0 := by
      apply (ε (J.cocomplex.X (q + 1))).injective
      rw [hnat, Equiv.apply_symm_apply, hz, h0]
    obtain ⟨g, hg⟩ := H _ hf
    refine ⟨ε _ g, ?_⟩
    rw [← hnat, hg, Equiv.apply_symm_apply]
  · intro H f hf
    have hz : ((J.cocomplex.d q (q + 1)).hom.app (Opposite.op (Scheme.Etale.mk (𝟙 Y)))).hom
        (ε _ f) = 0 := by
      rw [← hnat, hf, h0]
    obtain ⟨b, hb⟩ := H _ hz
    refine ⟨(ε (J.cocomplex.X (q - 1))).symm b, ?_⟩
    apply (ε (J.cocomplex.X q)).injective
    rw [hnat, Equiv.apply_symm_apply, hb]

theorem wc_et_const_univ_transport_exists : ∀ {Z W : Scheme.{u}} (h : Z ⟶ W) (m : ℕ), ∃ ρ : wcEtTransport h ((constantSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))), wcEtTransportUniv ρ :=
by
  intro Z W h m
  haveI := wc_et_basechange_isContinuous h
  obtain ⟨L, ⟨adj⟩, hL, ⟨ε⟩⟩ := wc_et_push_left_adjoint h
  haveI := hL
  haveI : (wcEtPush h).IsRightAdjoint := adj.isRightAdjoint
  haveI : (wcEtPush h).PreservesZeroMorphisms :=
    Functor.preservesZeroMorphisms_of_isRightAdjoint (wcEtPush h)
