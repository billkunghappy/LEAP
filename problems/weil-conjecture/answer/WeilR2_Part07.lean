    intro m
    apply Limits.biprod.hom_ext
    · simp [wcAugConeDS]
    · simp [wcAugConeDS]

  have mono0 : Mono (wcAugConeD0 α) := by
    apply Preadditive.mono_of_cancel_zero
    intro W g hg
    have h1 : g ≫ K.d 0 1 = 0 := by
      have := congrArg (· ≫ Limits.biprod.fst) hg
      simpa [wcAugConeD0] using this
    have h2 : g ≫ α.f 0 = 0 := by
      have := congrArg (· ≫ Limits.biprod.snd) hg
      simpa [wcAugConeD0] using this
    obtain ⟨W', π, hπ, a, ha⟩ := hex0.exact_up_to_refinements g h1
    have ha' : π ≫ g = a ≫ εK := ha
    have ha0 : a ≫ J.ι.f 0 = 0 := by
      rw [← hα, ← Category.assoc, ← ha', Category.assoc, h2, Limits.comp_zero]
    have ha00 : a = 0 := (cancel_mono (J.ι.f 0)).mp (ha0.trans Limits.zero_comp.symm)
    have : π ≫ g = π ≫ 0 := by rw [ha', ha00, Limits.zero_comp, Limits.comp_zero]
    exact (cancel_epi π).mp this
  have ex1 : ∀ {W : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}}
      (x : W ⟶ K.X (0 + 1) ⊞ J.cocomplex.X 0), x ≫ wcAugConeDS α 0 = 0 →
      ∃ (W' : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (π : W' ⟶ W) (_ : Epi π)
        (y : W' ⟶ K.X 0), π ≫ x = y ≫ wcAugConeD0 α := by
    intro W x hx
    have hk : x ≫ Limits.biprod.fst ≫ K.d (0 + 1) (0 + 1 + 1) = 0 := by
      have := congrArg (· ≫ Limits.biprod.fst) hx
      simpa [wcAugConeDS] using this
    have hj : x ≫ Limits.biprod.fst ≫ α.f (0 + 1) +
        x ≫ Limits.biprod.snd ≫ J.cocomplex.d 0 (0 + 1) = 0 := by
      have := congrArg (· ≫ Limits.biprod.snd) hx
      simpa [wcAugConeDS] using this
    obtain ⟨W₁, π₁, hπ₁, k₀, hk₀'⟩ : ∃ (W₁ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
        (π₁ : W₁ ⟶ W) (_ : Epi π₁) (k₀ : W₁ ⟶ K.X 0),
        π₁ ≫ x ≫ Limits.biprod.fst = k₀ ≫ K.d 0 (0 + 1) := by
      obtain ⟨W₁, π₁, hπ₁, k₀, hk₀⟩ := (hS 0).exact_up_to_refinements (x ≫ Limits.biprod.fst)
        (by change (x ≫ Limits.biprod.fst) ≫ K.d (0 + 1) (0 + 1 + 1) = 0
            rw [Category.assoc]; exact hk)
      exact ⟨W₁, π₁, hπ₁, k₀, by rw [← Category.assoc]; exact hk₀⟩
    have hj' : (π₁ ≫ x ≫ Limits.biprod.snd + k₀ ≫ α.f 0) ≫ J.cocomplex.d 0 (0 + 1) = 0 := by
      have e : k₀ ≫ α.f 0 ≫ J.cocomplex.d 0 (0 + 1) = π₁ ≫ x ≫ Limits.biprod.fst ≫ α.f (0 + 1) := by
        rw [α.comm, ← Category.assoc k₀, ← hk₀']
        simp only [Category.assoc]
      rw [Preadditive.add_comp, Category.assoc, Category.assoc, Category.assoc, e]
      have h2 : x ≫ Limits.biprod.snd ≫ J.cocomplex.d 0 (0 + 1) +
          x ≫ Limits.biprod.fst ≫ α.f (0 + 1) = 0 := (add_comm _ _).trans hj
      rw [← Preadditive.comp_add, h2, Limits.comp_zero]
    obtain ⟨W₂, π₂, hπ₂, a, ha'⟩ : ∃ (W₂ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
        (π₂ : W₂ ⟶ W₁) (_ : Epi π₂) (a : W₂ ⟶ A),
        π₂ ≫ (π₁ ≫ x ≫ Limits.biprod.snd + k₀ ≫ α.f 0) = a ≫ J.ι.f 0 := by
      obtain ⟨W₂, π₂, hπ₂, a, ha⟩ := J.exact₀.exact_up_to_refinements _ hj'
      exact ⟨W₂, π₂, hπ₂, a, ha⟩
    have hεK' : εK ≫ K.d 0 (0 + 1) = 0 := hεK
    have hα' : a ≫ εK ≫ α.f 0 = π₂ ≫ π₁ ≫ x ≫ Limits.biprod.snd + π₂ ≫ k₀ ≫ α.f 0 := by
      have e1 : a ≫ εK ≫ α.f 0 = a ≫ J.ι.f 0 := congrArg (fun t => a ≫ t) hα
      rw [e1, ← ha', Preadditive.comp_add]
      try simp only [Category.assoc]
    refine ⟨W₂, π₂ ≫ π₁, epi_comp _ _, a ≫ εK - π₂ ≫ k₀, ?_⟩
    apply Limits.biprod.hom_ext
    · simp only [Category.assoc, r20, hk₀', Preadditive.comp_neg, Preadditive.sub_comp,
        reassoc_of% hεK', hεK', Limits.zero_comp, Limits.comp_zero, neg_zero, zero_sub, neg_neg,
        Preadditive.neg_comp]
    · simp only [Category.assoc, r50, Preadditive.sub_comp]
      rw [hα']
      abel
  have exS : ∀ (p : ℕ) {W : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}}
      (x : W ⟶ K.X (p + 1 + 1) ⊞ J.cocomplex.X (p + 1)), x ≫ wcAugConeDS α (p + 1) = 0 →
      ∃ (W' : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (π : W' ⟶ W) (_ : Epi π)
        (y : W' ⟶ K.X (p + 1) ⊞ J.cocomplex.X p), π ≫ x = y ≫ wcAugConeDS α p := by
    intro p W x hx
    have hk : x ≫ Limits.biprod.fst ≫ K.d (p + 1 + 1) (p + 1 + 1 + 1) = 0 := by
      have := congrArg (· ≫ Limits.biprod.fst) hx
      simpa [wcAugConeDS] using this
    have hj : x ≫ Limits.biprod.fst ≫ α.f (p + 1 + 1) +
        x ≫ Limits.biprod.snd ≫ J.cocomplex.d (p + 1) (p + 1 + 1) = 0 := by
      have := congrArg (· ≫ Limits.biprod.snd) hx
      simpa [wcAugConeDS] using this
    obtain ⟨W₁, π₁, hπ₁, k₀, hk₀'⟩ : ∃ (W₁ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
        (π₁ : W₁ ⟶ W) (_ : Epi π₁) (k₀ : W₁ ⟶ K.X (p + 1)),
        π₁ ≫ x ≫ Limits.biprod.fst = k₀ ≫ K.d (p + 1) (p + 1 + 1) := by
      obtain ⟨W₁, π₁, hπ₁, k₀, hk₀⟩ := (hS (p + 1)).exact_up_to_refinements
        (x ≫ Limits.biprod.fst)
        (by change (x ≫ Limits.biprod.fst) ≫ K.d (p + 1 + 1) (p + 1 + 1 + 1) = 0
            rw [Category.assoc]; exact hk)
      exact ⟨W₁, π₁, hπ₁, k₀, by rw [← Category.assoc]; exact hk₀⟩
    have hj' : (π₁ ≫ x ≫ Limits.biprod.snd + k₀ ≫ α.f (p + 1)) ≫
        J.cocomplex.d (p + 1) (p + 1 + 1) = 0 := by
      have e : k₀ ≫ α.f (p + 1) ≫ J.cocomplex.d (p + 1) (p + 1 + 1) =
          π₁ ≫ x ≫ Limits.biprod.fst ≫ α.f (p + 1 + 1) := by
        rw [α.comm, ← Category.assoc k₀, ← hk₀']
        simp only [Category.assoc]
      rw [Preadditive.add_comp, Category.assoc, Category.assoc, Category.assoc, e]
      have h2 : x ≫ Limits.biprod.snd ≫ J.cocomplex.d (p + 1) (p + 1 + 1) +
          x ≫ Limits.biprod.fst ≫ α.f (p + 1 + 1) = 0 := (add_comm _ _).trans hj
      rw [← Preadditive.comp_add, h2, Limits.comp_zero]
    obtain ⟨W₂, π₂, hπ₂, j₀, hj₀'⟩ : ∃ (W₂ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
        (π₂ : W₂ ⟶ W₁) (_ : Epi π₂) (j₀ : W₂ ⟶ J.cocomplex.X p),
        π₂ ≫ (π₁ ≫ x ≫ Limits.biprod.snd + k₀ ≫ α.f (p + 1)) = j₀ ≫ J.cocomplex.d p (p + 1) := by
      obtain ⟨W₂, π₂, hπ₂, j₀, hj₀⟩ := (J.exact_succ p).exact_up_to_refinements _ hj'
      exact ⟨W₂, π₂, hπ₂, j₀, hj₀⟩
    refine ⟨W₂, π₂ ≫ π₁, epi_comp _ _, Limits.biprod.lift (-(π₂ ≫ k₀)) j₀, ?_⟩
    apply Limits.biprod.hom_ext
    · simp only [Category.assoc, r2S, hk₀', Preadditive.comp_neg, Limits.biprod.lift_fst_assoc,
        Preadditive.neg_comp, neg_neg]
    · simp only [Category.assoc, r5S, Preadditive.comp_add, Limits.biprod.lift_fst_assoc,
        Limits.biprod.lift_snd_assoc, Preadditive.neg_comp]
      rw [← hj₀', Preadditive.comp_add]
      try simp only [Category.assoc]
      abel
  have hCex : ∀ n : ℕ, C.ExactAt n := by
    intro n
    rcases n with _ | m
    · rw [C.exactAt_iff' 0 0 1 CochainComplex.prev_nat_zero (CochainComplex.next ℕ 0),
        ShortComplex.exact_iff_mono _ (C.shape 0 0 (by simp))]
      change Mono (C.d 0 (0 + 1))
      rw [hd 0]
      exact mono0
    · rw [C.exactAt_iff' m (m + 1) (m + 1 + 1) (CochainComplex.prev_nat_succ m)
        (CochainComplex.next ℕ (m + 1)), ShortComplex.exact_iff_exact_up_to_refinements]
      intro W x hx
      change x ≫ C.d (m + 1) (m + 1 + 1) = 0 at hx
      rw [hd (m + 1)] at hx
      change ∃ W' π, ∃ (_ : Epi π), ∃ x₁, π ≫ x = x₁ ≫ C.d m (m + 1)
      rw [hd m]
      rcases m with _ | p
      · exact ex1 x hx
      · exact exS p x hx

  have hacyc' : ∀ n k : ℕ, Subsingleton (Abelian.Ext ((constantSheaf
      (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) (K.X n) (k + 1)) := hacyc
  have hCac : ∀ n k : ℕ, Subsingleton (Abelian.Ext ((constantSheaf
      (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) (C.X n) (k + 1)) := by
    intro n k
    rcases n with _ | m
    · exact hacyc' 0 k
    · have key : ∀ e : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
          (K.X (m + 1) ⊞ J.cocomplex.X m) (k + 1), e = 0 := by
        intro e
        have h1 : e.comp (Abelian.Ext.mk₀ Limits.biprod.fst) (add_zero _) = 0 :=
          (hacyc' (m + 1) k).elim _ _
        have h2 : e.comp (Abelian.Ext.mk₀ Limits.biprod.snd) (add_zero _) = 0 :=
          Abelian.Ext.eq_zero_of_injective _
        calc e = e.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero _) := (Abelian.Ext.comp_mk₀_id e).symm
          _ = e.comp (Abelian.Ext.mk₀ (Limits.biprod.fst ≫ Limits.biprod.inl +
                Limits.biprod.snd ≫ Limits.biprod.inr)) (add_zero _) := by
              rw [Limits.biprod.total]
          _ = (e.comp (Abelian.Ext.mk₀ Limits.biprod.fst) (add_zero _)).comp
                (Abelian.Ext.mk₀ Limits.biprod.inl) (add_zero _) +
              (e.comp (Abelian.Ext.mk₀ Limits.biprod.snd) (add_zero _)).comp
                (Abelian.Ext.mk₀ Limits.biprod.inr) (add_zero _) := by
              rw [Abelian.Ext.mk₀_add, Abelian.Ext.comp_add,
                Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.comp_assoc_of_third_deg_zero,
                Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀]
          _ = 0 := by rw [h1, h2, Abelian.Ext.zero_comp, Abelian.Ext.zero_comp, add_zero]
      exact ⟨fun e₁ e₂ => (key e₁).trans (key e₂).symm⟩

  let G := sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} ⋙
    (evaluation (Y.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op (Scheme.Etale.mk (𝟙 Y)))
  have hT : Limits.IsTerminal (Scheme.Etale.mk (𝟙 Y)) :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
  obtain ⟨hSi⟩ := wc_et_sections_coyoneda_iso Y _ hT
  have hΓex : ∀ (n : ℕ) (x : G.obj (C.X (n + 1))), (G.map (C.d (n + 1) (n + 1 + 1))).hom x = 0 →
      ∃ y : G.obj (C.X n), (G.map (C.d n (n + 1))).hom y = x := by
    intro n
    obtain ⟨E⟩ := wc_ext_acyclic_resolution_homology ((constantSheaf (Scheme.smallEtaleTopology Y)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) C (fun n => hCex (n + 1))
      hCac (n + 1)
    have hz : Limits.IsZero (C.homology 0) := (C.exactAt_iff_isZero_homology 0).mp (hCex 0)
    haveI : Injective (C.homology 0) := hz.injective
    haveI : Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (C.homology 0) (n + 1)) :=
      ⟨fun a b => (Abelian.Ext.eq_zero_of_injective a).trans (Abelian.Ext.eq_zero_of_injective b).symm⟩
    let Kc := ((preadditiveCoyoneda.obj (Opposite.op ((constantSheaf
      (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))))).mapHomologicalComplex (ComplexShape.up ℕ)).obj C
    have hsub : Subsingleton (Kc.homology (n + 1)) := E.subsingleton
    have hKc : Kc.ExactAt (n + 1) := (Kc.exactAt_iff_isZero_homology (n + 1)).mpr
      (@AddCommGrpCat.isZero_of_subsingleton (Kc.homology (n + 1)) hsub)
    have hΓc := hKc.of_iso ((NatIso.mapHomologicalComplex hSi (ComplexShape.up ℕ)).app C).symm
    have h := ((((G.mapHomologicalComplex (ComplexShape.up ℕ)).obj C)).exactAt_iff' n (n + 1)
      (n + 1 + 1) (CochainComplex.prev_nat_succ n) (CochainComplex.next ℕ (n + 1))).mp hΓc
    rw [ShortComplex.ab_exact_iff] at h
    exact h

  have hΓ : ∀ {X₁ X₂ X₃ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}}
      (f : X₁ ⟶ X₂) (g : X₂ ⟶ X₃) (x : G.obj X₁),
      (G.map g).hom ((G.map f).hom x) = (G.map (f ≫ g)).hom x := by
    intro X₁ X₂ X₃ f g x
    rw [G.map_comp]; rfl
  have hΓadd : ∀ {X₁ X₂ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}}
      (f g : X₁ ⟶ X₂) (x : G.obj X₁),
      (G.map (f + g)).hom x = (G.map f).hom x + (G.map g).hom x := by
    intro X₁ X₂ f g x
    rw [G.map_add]; rfl
  have hΓneg : ∀ {X₁ X₂ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}}
      (f : X₁ ⟶ X₂) (x : G.obj X₁), (G.map (-f)).hom x = -((G.map f).hom x) := by
    intro X₁ X₂ f x
    rw [G.map_neg]; rfl
  have hΓzero : ∀ {X₁ X₂ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}}
      (x : G.obj X₁), (G.map (0 : X₁ ⟶ X₂)).hom x = 0 := by
    intro X₁ X₂ x
    rw [G.map_zero]; rfl
  have hΓid : ∀ {X₁ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}}
      (x : G.obj X₁), (G.map (𝟙 X₁)).hom x = x := by
    intro X₁ x
    rw [G.map_id]; rfl

  refine ⟨α, fun q z hz => ?_⟩
  rcases q with _ | n
  · have hz' : (G.map (J.cocomplex.d 0 (0 + 1))).hom z = 0 := hz
    obtain ⟨y, hy⟩ : ∃ y : G.obj (K.X 0), (G.map (wcAugConeD0 α)).hom y =
        (G.map (Limits.biprod.inr : J.cocomplex.X 0 ⟶ K.X (0 + 1) ⊞ J.cocomplex.X 0)).hom z := by
      obtain ⟨y, hy⟩ := hΓex 0
        ((G.map (Limits.biprod.inr : J.cocomplex.X 0 ⟶ K.X (0 + 1) ⊞ J.cocomplex.X 0)).hom z) (by
          rw [hd (0 + 1)]
          change (G.map (wcAugConeDS α 0)).hom
            ((G.map (Limits.biprod.inr : J.cocomplex.X 0 ⟶ K.X (0 + 1) ⊞ J.cocomplex.X 0)).hom z) = 0
          rw [hΓ, r1, ← hΓ, hz', map_zero])
      rw [hd 0] at hy
      exact ⟨y, hy⟩
    refine ⟨y, 0, ?_, ?_⟩
    · have h1 := congrArg (G.map (Limits.biprod.fst : K.X (0 + 1) ⊞ J.cocomplex.X 0 ⟶ K.X (0 + 1))).hom hy
      rw [hΓ, hΓ, r20, Limits.biprod.inr_fst, hΓneg, hΓzero, neg_eq_zero] at h1
      exact h1
    · have h1 := congrArg (G.map (Limits.biprod.snd : K.X (0 + 1) ⊞ J.cocomplex.X 0 ⟶ J.cocomplex.X 0)).hom hy
      rw [hΓ, hΓ, r50, Limits.biprod.inr_snd, hΓid] at h1
      rw [map_zero, add_zero]
      exact h1.symm
  · have hz' : (G.map (J.cocomplex.d (n + 1) (n + 1 + 1))).hom z = 0 := hz
    obtain ⟨y, hy⟩ : ∃ y : G.obj (K.X (n + 1) ⊞ J.cocomplex.X n), (G.map (wcAugConeDS α n)).hom y =
        (G.map (Limits.biprod.inr : J.cocomplex.X (n + 1) ⟶
          K.X (n + 1 + 1) ⊞ J.cocomplex.X (n + 1))).hom z := by
      obtain ⟨y, hy⟩ := hΓex (n + 1)
        ((G.map (Limits.biprod.inr : J.cocomplex.X (n + 1) ⟶
          K.X (n + 1 + 1) ⊞ J.cocomplex.X (n + 1))).hom z) (by
          rw [hd (n + 1 + 1)]
          change (G.map (wcAugConeDS α (n + 1))).hom
            ((G.map (Limits.biprod.inr : J.cocomplex.X (n + 1) ⟶
              K.X (n + 1 + 1) ⊞ J.cocomplex.X (n + 1))).hom z) = 0
          rw [hΓ, r1, ← hΓ, hz', map_zero])
      rw [hd (n + 1)] at hy
      exact ⟨y, hy⟩
    refine ⟨(G.map (Limits.biprod.fst : K.X (n + 1) ⊞ J.cocomplex.X n ⟶ K.X (n + 1))).hom y,
      (G.map (Limits.biprod.snd : K.X (n + 1) ⊞ J.cocomplex.X n ⟶ J.cocomplex.X n)).hom y, ?_, ?_⟩
    · have h1 := congrArg (G.map (Limits.biprod.fst :
        K.X (n + 1 + 1) ⊞ J.cocomplex.X (n + 1) ⟶ K.X (n + 1 + 1))).hom hy
      rw [hΓ, hΓ, r2S, Limits.biprod.inr_fst, hΓneg, hΓzero, neg_eq_zero, ← hΓ] at h1
      exact h1
    · have h1 := congrArg (G.map (Limits.biprod.snd :
        K.X (n + 1 + 1) ⊞ J.cocomplex.X (n + 1) ⟶ J.cocomplex.X (n + 1))).hom hy
      rw [hΓ, hΓ, r5S, Limits.biprod.inr_snd, hΓid, hΓadd, ← hΓ, ← hΓ] at h1
      exact h1.symm

theorem wc_subring_const_coherent : ∀ (R : Type u) [CommRing R] (m : ℕ),
    ∃ c : ∀ (F F' : Finset R) (h : F ⊆ F'),
        wcEtTransport (wcSubT R h) (wcConstZ (wcSubX R F) m) (wcConstZ (wcSubX R F') m),
      wcSubCoherent R (fun F => wcConstZ (wcSubX R F) m) c ∧
      ∀ (F F' : Finset R) (h : F ⊆ F') (V : (wcSubX R F).Etale) (O : (wcSubX R F').Etale)
        (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ wcSubT R h) (a : ULift.{u+1} (ZMod m)),
        (c F F' h).ρ V O k hk (wcConstSec (wcSubX R F) (ULift.{u+1} (ZMod m)) V a) =
          wcConstSec (wcSubX R F') (ULift.{u+1} (ZMod m)) O a :=
by
  intro R _ m
  classical

  have hcont : ∀ {X B : Scheme.{u}} (g : X ⟶ B), (wcEtBaseChange g).IsContinuous
      (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology X) := by
    have hjs : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
        (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
      intro Y V S hS
      change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      obtain ⟨V₁, c, hc, y, hy⟩ := hS x
      have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
      have hEt : Etale c.left := by
        have h1 : Etale V.hom := V.prop
        have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
        exact Etale.of_comp c.left V.hom
      exact ⟨V₁, c, y, hc, hEt, hy⟩
    have hcov : ∀ {X B : Scheme.{u}} (g : X ⟶ B), CoverPreserving (Scheme.smallEtaleTopology B)
        (Scheme.smallEtaleTopology X) (wcEtBaseChange g) := by
      intro X B g
      constructor
      intro V S hS
      change S ∈ Scheme.smallGrothendieckTopology @Etale B V at hS
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
      have hS' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS
      apply hjs
      intro v
      obtain ⟨W, a, w, ha, -, hw⟩ := hS' (Limits.pullback.fst V.hom g v)
      refine ⟨(wcEtBaseChange g).obj W, (wcEtBaseChange g).map a,
        Sieve.image_mem_functorPushforward (wcEtBaseChange g) S ha, ?_⟩
      have h0 : (Limits.pullback.fst W.hom g ≫ a.left) ≫ V.hom =
          Limits.pullback.snd W.hom g ≫ g := by
        rw [Category.assoc, MorphismProperty.Over.w a]
        exact Limits.pullback.condition
      let mm : Limits.pullback W.hom g ⟶ Limits.pullback V.hom g :=
        Limits.pullback.lift (Limits.pullback.fst W.hom g ≫ a.left) (Limits.pullback.snd W.hom g) h0
      have hmap : ((wcEtBaseChange g).map a).left = mm := rfl
      have h1 : Limits.pullback.fst a.left (Limits.pullback.fst V.hom g) ≫ W.hom =
          (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫
            Limits.pullback.snd V.hom g) ≫ g := by
        rw [← MorphismProperty.Over.w a, ← Category.assoc, Limits.pullback.condition,
          Category.assoc, Limits.pullback.condition, Category.assoc]
      let ψ : Limits.pullback a.left (Limits.pullback.fst V.hom g) ⟶ Limits.pullback W.hom g :=
        Limits.pullback.lift (Limits.pullback.fst a.left (Limits.pullback.fst V.hom g))
          (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫
            Limits.pullback.snd V.hom g) h1
      have hψ : ψ ≫ mm = Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) := by
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, Limits.pullback.lift_fst,
            Limits.pullback.condition]
        · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
      obtain ⟨z, hz⟩ : ∃ z, Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) z = v := by
        have hv : (v : ↥(Limits.pullback V.hom g)) ∈
            Set.range (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g)) := by
          rw [Scheme.Pullback.range_snd]
          exact ⟨w, hw⟩
        exact hv
      rw [hmap]
      exact ⟨ψ z, (Scheme.Hom.comp_apply ψ mm z).symm.trans (by rw [hψ]; exact hz)⟩
    intro X B g
    let Φ := wcEtBaseChange g
    haveI h1 : Limits.PreservesFiniteLimits Φ := ⟨fun J _ _ =>
      haveI : Limits.PreservesLimitsOfShape J (wcEtBaseChange g ⋙ Scheme.Etale.forget X) :=
        Limits.preservesLimitsOfShape_of_natIso
          (NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl) :
            Scheme.Etale.forget B ⋙ Over.pullback g ≅ wcEtBaseChange g ⋙ Scheme.Etale.forget X)
      Limits.preservesLimitsOfShape_of_reflects_of_preserves (wcEtBaseChange g)
        (Scheme.Etale.forget X)⟩
    haveI := flat_of_preservesFiniteLimits Φ
    exact Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat _ _) (hcov g)

  have Hmapcomp : ∀ {X : Scheme.{u}} (G : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) {A B C : X.Etale}
      (g1 : A ⟶ B) (g2 : B ⟶ C) (y : G.obj (Opposite.op C)),
      (G.map g1.op).hom ((G.map g2.op).hom y) = (G.map (g1 ≫ g2).op).hom y := by
    intro X G A B C g1 g2 y
    rw [op_comp, G.map_comp]
    rfl
  have Hid : ∀ {X : Scheme.{u}} (G : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (A : X.Etale)
      (y : G.obj (Opposite.op A)), G.map (𝟙 A).op y = y := by
    intro X G A y
    rw [op_id, CategoryTheory.Functor.map_id]
    rfl

  have Hconst : ∀ (X : Scheme.{u}) (V O : X.Etale) (g : O ⟶ V) (a : ULift.{u+1} (ZMod m)),
      ((wcConstZ X m).obj.map g.op).hom (wcConstSec X (ULift.{u+1} (ZMod m)) V a) =
        wcConstSec X (ULift.{u+1} (ZMod m)) O a := by
    intro X V O g a
    have h := (toSheafify (Scheme.smallEtaleTopology X)
      ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).naturality g.op
    exact (congrArg (fun φ => AddCommGrpCat.Hom.hom φ a) h).symm

  have Hreidx : ∀ {A B : Scheme.{u}} {f : A ⟶ B}
      {F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}}
      {G : Sheaf (Scheme.smallEtaleTopology A) AddCommGrpCat.{u+1}}
      (ρ : wcEtTransport f F G) (V : B.Etale) (O : A.Etale) (h1 h2 : O.left ⟶ V.left)
      (p1 : h1 ≫ V.hom = O.hom ≫ f) (p2 : h2 ≫ V.hom = O.hom ≫ f) (x : F.obj.obj (Opposite.op V)),
      h1 = h2 → ρ.ρ V O h1 p1 x = ρ.ρ V O h2 p2 x := by
    intro A B f F G ρ V O h1 h2 p1 p2 x e
    subst e
    rfl

  have pc : ∀ {Y Z : Scheme.{u}} (f : Y ⟶ Z) (V : Z.Etale),
      Limits.pullback.fst V.hom f ≫ V.hom = ((wcEtBaseChange f).obj V).hom ≫ f := by
    intro Y Z f V
    change Limits.pullback.fst V.hom f ≫ V.hom = Limits.pullback.snd V.hom f ≫ f
    exact Limits.pullback.condition
  have hBc_fst : ∀ {Y Z : Scheme.{u}} (f : Y ⟶ Z) (V V' : Z.Etale) (c : V' ⟶ V),
      Limits.pullback.fst V'.hom f ≫ c.left =
        ((wcEtBaseChange f).map c).left ≫ Limits.pullback.fst V.hom f := by
    intro Y Z f V V' c
    change Limits.pullback.fst V'.hom f ≫ c.left =
      Limits.pullback.lift (Limits.pullback.fst V'.hom f ≫ c.left)
        (Limits.pullback.snd V'.hom f)
        (by rw [Category.assoc, MorphismProperty.Over.w c]; exact Limits.pullback.condition) ≫
        Limits.pullback.fst V.hom f
    rw [Limits.pullback.lift_fst]

  let ℓ : ∀ {Y Z : Scheme.{u}} (f : Y ⟶ Z) (V : Z.Etale) (O : Y.Etale) (k : O.left ⟶ V.left),
      k ≫ V.hom = O.hom ≫ f → (O ⟶ (wcEtBaseChange f).obj V) :=
    fun f V O k hk => MorphismProperty.Over.homMk (Limits.pullback.lift k O.hom hk)
      (Limits.pullback.lift_snd _ _ _) trivial
  have Hℓfst : ∀ {Y Z : Scheme.{u}} (f : Y ⟶ Z) (V : Z.Etale) (O : Y.Etale) (k : O.left ⟶ V.left)
      (hk : k ≫ V.hom = O.hom ≫ f),
      k ≫ (𝟙 V : V ⟶ V).left = (ℓ f V O k hk).left ≫ Limits.pullback.fst V.hom f := by
    intro Y Z f V O k hk
    change k ≫ 𝟙 V.left = Limits.pullback.lift k O.hom hk ≫ Limits.pullback.fst V.hom f
    rw [Category.comp_id, Limits.pullback.lift_fst]
  have Eℓ1 : ∀ {Y Z : Scheme.{u}} (f : Y ⟶ Z) (V V' : Z.Etale) (c : V' ⟶ V) (O O' : Y.Etale)
      (d : O' ⟶ O) (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ f)
      (h' : O'.left ⟶ V'.left) (hh' : h' ≫ V'.hom = O'.hom ≫ f),
      h' ≫ c.left = d.left ≫ h → ℓ f V' O' h' hh' ≫ (wcEtBaseChange f).map c = d ≫ ℓ f V O h hh := by
    intro Y Z f V V' c O O' d h hh h' hh' H
    apply MorphismProperty.Over.Hom.ext
    change Limits.pullback.lift h' O'.hom hh' ≫
        Limits.pullback.lift (Limits.pullback.fst V'.hom f ≫ c.left)
          (Limits.pullback.snd V'.hom f)
          (by rw [Category.assoc, MorphismProperty.Over.w c]; exact Limits.pullback.condition) =
      d.left ≫ Limits.pullback.lift h O.hom hh
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_fst_assoc]
      exact H
    · simp only [Category.assoc, Limits.pullback.lift_snd]
      exact (MorphismProperty.Over.w d).symm

  have Hex : ∀ {Y Z : Scheme.{u}} (f : Y ⟶ Z),
      ∃ c : wcEtTransport f (wcConstZ Z m) (wcConstZ Y m),
        ∀ (V : Z.Etale) (O : Y.Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ f)
          (a : ULift.{u+1} (ZMod m)),
          c.ρ V O k hk (wcConstSec Z (ULift.{u+1} (ZMod m)) V a) =
            wcConstSec Y (ULift.{u+1} (ZMod m)) O a := by
    intro Y Z f
    haveI := hcont f
    have hQ : Presheaf.IsSheaf (Scheme.smallEtaleTopology Z)
        ((wcEtBaseChange f).op ⋙ (wcConstZ Y m).obj) :=
      Functor.op_comp_isSheaf (wcEtBaseChange f) _ _ (wcConstZ Y m)
    let ψ : (Functor.const (Z.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ⟶
        (wcEtBaseChange f).op ⋙ (wcConstZ Y m).obj :=
      { app := fun V => (toSheafify (Scheme.smallEtaleTopology Y)
            ((Functor.const (Y.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).app
            (Opposite.op ((wcEtBaseChange f).obj V.unop))
        naturality := fun V V' g =>
          (Functor.whiskerLeft (wcEtBaseChange f).op (toSheafify (Scheme.smallEtaleTopology Y)
            ((Functor.const (Y.Etale)ᵒᵖ).obj
              (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))))).naturality g }
    let φ := sheafifyLift (Scheme.smallEtaleTopology Z) ψ hQ
    have hφ : toSheafify (Scheme.smallEtaleTopology Z) _ ≫ φ = ψ :=
      toSheafify_sheafifyLift (Scheme.smallEtaleTopology Z) ψ hQ
    refine ⟨{ ρ := fun V O k hk => ((wcConstZ Y m).obj.map (ℓ f V O k hk).op).hom.comp
                (φ.app (Opposite.op V)).hom
              nat := ?_ }, ?_⟩
    · intro V V' c O O' d h hh h' hh' H x
      have h1 : (φ.app (Opposite.op V')).hom (((wcConstZ Z m).obj.map c.op).hom x) =
          ((wcConstZ Y m).obj.map ((wcEtBaseChange f).map c).op).hom
            ((φ.app (Opposite.op V)).hom x) :=
        congrArg (fun g => AddCommGrpCat.Hom.hom g x) (φ.naturality c.op)
      show ((wcConstZ Y m).obj.map (ℓ f V' O' h' hh').op).hom
          ((φ.app (Opposite.op V')).hom (((wcConstZ Z m).obj.map c.op).hom x)) =
        ((wcConstZ Y m).obj.map d.op).hom (((wcConstZ Y m).obj.map (ℓ f V O h hh).op).hom
          ((φ.app (Opposite.op V)).hom x))
      exact (congrArg (fun y => ((wcConstZ Y m).obj.map (ℓ f V' O' h' hh').op).hom y) h1).trans
        ((Hmapcomp _ _ _ _).trans ((congrArg (fun t : O' ⟶ (wcEtBaseChange f).obj V =>
          ((wcConstZ Y m).obj.map t.op).hom ((φ.app (Opposite.op V)).hom x))
          (Eℓ1 f V V' c O O' d h hh h' hh' H)).trans (Hmapcomp _ _ _ _).symm))
    · intro V O k hk a
      have h2 : (φ.app (Opposite.op V)).hom (wcConstSec Z (ULift.{u+1} (ZMod m)) V a) =
          wcConstSec Y (ULift.{u+1} (ZMod m)) ((wcEtBaseChange f).obj V) a :=
        congrArg (fun g => (g.app (Opposite.op V)).hom a) hφ
      show ((wcConstZ Y m).obj.map (ℓ f V O k hk).op).hom
          ((φ.app (Opposite.op V)).hom (wcConstSec Z (ULift.{u+1} (ZMod m)) V a)) = _
      exact (congrArg (fun y => ((wcConstZ Y m).obj.map (ℓ f V O k hk).op).hom y) h2).trans
        (Hconst Y _ _ _ a)

  have Huniq : ∀ {Y Z : Scheme.{u}} (f : Y ⟶ Z)
      (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (ρ ρ' : wcEtTransport f (wcConstZ Z m) G),
      (∀ (V : Z.Etale) (O : Y.Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ f)
        (a : ULift.{u+1} (ZMod m)),
        ρ.ρ V O k hk (wcConstSec Z (ULift.{u+1} (ZMod m)) V a) =
          ρ'.ρ V O k hk (wcConstSec Z (ULift.{u+1} (ZMod m)) V a)) →
      ∀ (V : Z.Etale) (O : Y.Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ f)
        (x : (wcConstZ Z m).obj.obj (Opposite.op V)), ρ.ρ V O k hk x = ρ'.ρ V O k hk x := by
    intro Y Z f G ρ ρ' hc
    haveI := hcont f
    have hQ : Presheaf.IsSheaf (Scheme.smallEtaleTopology Z) ((wcEtBaseChange f).op ⋙ G.obj) :=
      Functor.op_comp_isSheaf (wcEtBaseChange f) _ _ G
    let χ : wcEtTransport f (wcConstZ Z m) G →
        ((sheafify (Scheme.smallEtaleTopology Z)
          ((Functor.const (Z.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) ⟶
          (wcEtBaseChange f).op ⋙ G.obj) := fun r =>
      { app := fun V => AddCommGrpCat.ofHom (r.ρ V.unop ((wcEtBaseChange f).obj V.unop)
            (Limits.pullback.fst V.unop.hom f) (pc f V.unop))
        naturality := fun V V' g => by
          ext x
          exact r.nat V.unop V'.unop g.unop _ _ ((wcEtBaseChange f).map g.unop) _ _ _ _
            (hBc_fst f V.unop V'.unop g.unop) x }
    have hχ : χ ρ = χ ρ' := by
      apply sheafify_hom_ext _ _ _ hQ
      ext V a
      exact hc V.unop ((wcEtBaseChange f).obj V.unop) (Limits.pullback.fst V.unop.hom f)
        (pc f V.unop) a
    have hB : ∀ (V : Z.Etale) (x : (wcConstZ Z m).obj.obj (Opposite.op V)),
        ρ.ρ V ((wcEtBaseChange f).obj V) (Limits.pullback.fst V.hom f) (pc f V) x =
          ρ'.ρ V ((wcEtBaseChange f).obj V) (Limits.pullback.fst V.hom f) (pc f V) x :=
      fun V x => congrArg (fun g => (g.app (Opposite.op V)).hom x) hχ
    intro V O k hk x
    have e1 := ρ.nat V V (𝟙 V) ((wcEtBaseChange f).obj V) O (ℓ f V O k hk)
      (Limits.pullback.fst V.hom f) (pc f V) k hk (Hℓfst f V O k hk) x
    have e2 := ρ'.nat V V (𝟙 V) ((wcEtBaseChange f).obj V) O (ℓ f V O k hk)
      (Limits.pullback.fst V.hom f) (pc f V) k hk (Hℓfst f V O k hk) x
    rw [Hid] at e1 e2
    rw [e1, e2, hB V x]

  have Hcomp : ∀ {A B C : Scheme.{u}} (f : B ⟶ C) (g : A ⟶ B) (e : A ⟶ C) (he : g ≫ f = e)
      (F : Sheaf (Scheme.smallEtaleTopology C) AddCommGrpCat.{u+1})
      (G : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1})
      (H : Sheaf (Scheme.smallEtaleTopology A) AddCommGrpCat.{u+1})
      (ρ : wcEtTransport f F G) (τ : wcEtTransport g G H),
      ∃ σ : wcEtTransport e F H, wcEtTransportFactor he ρ τ σ := by
    intro A B C f g e he F G H ρ τ
    subst he
    have hk1 : ∀ (V : C.Etale) (O : A.Etale) (k : O.left ⟶ V.left),
        k ≫ V.hom = O.hom ≫ (g ≫ f) → k ≫ V.hom = (O.hom ≫ g) ≫ f :=
      fun V O k hk => hk.trans (Category.assoc _ _ _).symm
    refine ⟨{ ρ := fun V O₂ mm hm =>
                (τ.ρ ((wcEtBaseChange f).obj V) O₂
                  (Limits.pullback.lift mm (O₂.hom ≫ g) (hk1 V O₂ mm hm))
                  (Limits.pullback.lift_snd _ _ _)).comp
                (ρ.ρ V ((wcEtBaseChange f).obj V) (Limits.pullback.fst V.hom f) (pc f V))
              nat := ?_ }, ?_⟩
    · intro V V' c O O' d h hh h' hh' H x
      have e1 := ρ.nat V V' c ((wcEtBaseChange f).obj V) ((wcEtBaseChange f).obj V')
        ((wcEtBaseChange f).map c) (Limits.pullback.fst V.hom f) (pc f V)
        (Limits.pullback.fst V'.hom f) (pc f V') (hBc_fst f V V' c) x
      have H2 : Limits.pullback.lift h' (O'.hom ≫ g) (hk1 V' O' h' hh') ≫
            ((wcEtBaseChange f).map c).left =
          d.left ≫ Limits.pullback.lift h (O.hom ≫ g) (hk1 V O h hh) := by
        change Limits.pullback.lift h' (O'.hom ≫ g) (hk1 V' O' h' hh') ≫
            Limits.pullback.lift (Limits.pullback.fst V'.hom f ≫ c.left)
              (Limits.pullback.snd V'.hom f)
              (by rw [Category.assoc, MorphismProperty.Over.w c]; exact Limits.pullback.condition) =
          d.left ≫ Limits.pullback.lift h (O.hom ≫ g) (hk1 V O h hh)
        apply Limits.pullback.hom_ext
        · simp only [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_fst_assoc]
          exact H
        · simp only [Category.assoc, Limits.pullback.lift_snd]
          rw [← Category.assoc d.left, MorphismProperty.Over.w d]
      have e2 := τ.nat ((wcEtBaseChange f).obj V) ((wcEtBaseChange f).obj V')
        ((wcEtBaseChange f).map c) O O' d
        (Limits.pullback.lift h (O.hom ≫ g) (hk1 V O h hh)) (Limits.pullback.lift_snd _ _ _)
        (Limits.pullback.lift h' (O'.hom ≫ g) (hk1 V' O' h' hh')) (Limits.pullback.lift_snd _ _ _)
        H2 (ρ.ρ V ((wcEtBaseChange f).obj V) (Limits.pullback.fst V.hom f) (pc f V) x)
      exact (congrArg (fun y => τ.ρ ((wcEtBaseChange f).obj V') O'
        (Limits.pullback.lift h' (O'.hom ≫ g) (hk1 V' O' h' hh'))
        (Limits.pullback.lift_snd _ _ _) y) e1).trans e2
    · intro V O h hh O₂ k hk x
      have e1 := ρ.nat V V (𝟙 V) ((wcEtBaseChange f).obj V) O (ℓ f V O h hh)
        (Limits.pullback.fst V.hom f) (pc f V) h hh (Hℓfst f V O h hh) x
      rw [Hid] at e1
      have hkh : (k ≫ h) ≫ V.hom = O₂.hom ≫ (g ≫ f) :=
        (Category.assoc _ _ _).trans ((congrArg (fun t => k ≫ t) hh).trans
          ((Category.assoc _ _ _).symm.trans ((congrArg (fun t => t ≫ f) hk).trans
            (Category.assoc _ _ _))))
      have H1 : k ≫ (ℓ f V O h hh).left =
          (𝟙 O₂ : O₂ ⟶ O₂).left ≫ Limits.pullback.lift (k ≫ h) (O₂.hom ≫ g) (hk1 V O₂ _ hkh) := by
        change k ≫ Limits.pullback.lift h O.hom hh =
          𝟙 O₂.left ≫ Limits.pullback.lift (k ≫ h) (O₂.hom ≫ g) (hk1 V O₂ _ hkh)
        rw [Category.id_comp]
        apply Limits.pullback.hom_ext
        · simp only [Category.assoc, Limits.pullback.lift_fst]
        · simp only [Category.assoc, Limits.pullback.lift_snd]
          exact hk
      have e2 := τ.nat ((wcEtBaseChange f).obj V) O (ℓ f V O h hh) O₂ O₂ (𝟙 O₂)
        (Limits.pullback.lift (k ≫ h) (O₂.hom ≫ g) (hk1 V O₂ _ hkh))
        (Limits.pullback.lift_snd _ _ _) k hk H1
        (ρ.ρ V ((wcEtBaseChange f).obj V) (Limits.pullback.fst V.hom f) (pc f V) x)
      rw [Hid] at e2
      rw [e1]
      exact e2.symm

  have hT : ∀ F : Finset R, wcSubT R (Finset.Subset.refl F) = 𝟙 (wcSubX R F) := by
    intro F
    have e : CommRingCat.ofHom (Subring.inclusion
        (Subring.closure_mono (Finset.coe_subset.mpr (Finset.Subset.refl F)))) =
        𝟙 (CommRingCat.of ↥(Subring.closure (F : Set R))) := by
      ext x
      rfl
    exact (congrArg Spec.map e).trans (Spec.map_id _)
  choose c hc using fun (F F' : Finset R) (h : F ⊆ F') => Hex (wcSubT R h)
  refine ⟨c, ⟨?_, ?_⟩, hc⟩
  ·
    intro F V O c₀ hc₀ x
    let mk : ∀ (V O : (wcSubX R F).Etale) (k : O.left ⟶ V.left),
        k ≫ V.hom = O.hom ≫ wcSubT R (Finset.Subset.refl F) → (O ⟶ V) :=
      fun V O k hk => MorphismProperty.Over.homMk k
        (hk.trans (by rw [hT F]; exact Category.comp_id _)) trivial
    let ρ' : wcEtTransport (wcSubT R (Finset.Subset.refl F)) (wcConstZ (wcSubX R F) m)
        (wcConstZ (wcSubX R F) m) :=
      { ρ := fun V O k hk => ((wcConstZ (wcSubX R F) m).obj.map (mk V O k hk).op).hom
