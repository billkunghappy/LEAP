    let e : TensorProduct R F L ≃ₐ[F] T := AlgEquiv.ofRingEquiv (f := E) (fun c => by
      show (IsPushout.isoIsPushout (CommRingCat.of L) (CommRingCat.of F) Hτ H).hom.hom
        (algebraMap F (TensorProduct R F L) c) = inr.hom c
