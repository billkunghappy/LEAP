    obtain ⟨Gs, hGs⟩ := Module.Finite.fg_top (R := MvPolynomial (Fin d) K)
      (M := integralClosure (MvPolynomial (Fin d) K)
        (separableClosure (FractionRing (MvPolynomial (Fin d) K)) (FractionRing B)))
