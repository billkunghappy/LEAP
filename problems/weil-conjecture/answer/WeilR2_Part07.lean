      exact Limits.preservesLimitsOfShape_of_reflects_of_preserves
        (SheafOfModules.pushforward.{u+1} φ) (SheafOfModules.toSheaf.{u+1} S)
    · haveI : Limits.PreservesColimitsOfShape I
          (SheafOfModules.pushforward.{u+1} φ ⋙ SheafOfModules.toSheaf.{u+1} S) :=
        Limits.preservesColimitsOfShape_of_natIso (F := SheafOfModules.toSheaf.{u+1} R ⋙
          G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K) (Iso.refl _)
      haveI : Limits.ReflectsColimitsOfShape I (SheafOfModules.toSheaf.{u+1} S) :=
