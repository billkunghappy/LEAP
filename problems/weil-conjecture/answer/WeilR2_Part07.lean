        Function.Injective ρ ∧ Module.finrank F (TensorProduct Γ(X, U) F Γ(P, (p ≫ q) ⁻¹ᵁ U)) ≤ n := by
    intro Z P Y X F _ g' z p τ q t H hτq _ _ U hU h _
    subst hτq
    intro hZ
    letI : Algebra Γ(X, U) F :=
      ((Scheme.ΓSpecIso (.of F)).hom.hom.comp ((τ ≫ q).appLE U ⊤ h).hom).toAlgebra
    letI : Algebra Γ(X, U) Γ(P, (p ≫ q) ⁻¹ᵁ U) := ((p ≫ q).app U).hom.toAlgebra
    have hUST : (⊤ : (Spec (.of F)).Opens) ≤ τ ⁻¹ᵁ (q ⁻¹ᵁ U) := h
