    haveI : ExpChar (FractionRing (MvPolynomial (Fin d) K)) (ringExpChar K) :=
      expChar_of_injective_algebraMap (IsFractionRing.injective (MvPolynomial (Fin d) K) _) _
    haveI : ExpChar (separableClosure (FractionRing (MvPolynomial (Fin d) K)) (FractionRing B))
        (ringExpChar K) :=
      expChar_of_injective_algebraMap (R := FractionRing (MvPolynomial (Fin d) K))
