        G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K) (Iso.refl _)
    refine ⟨Functor.additive_of_comp_faithful (SheafOfModules.pushforward.{u+1} φ)
        (SheafOfModules.toSheaf.{u+1} S), ⟨fun I _ _ => ?_⟩, ⟨fun I _ _ => ?_⟩⟩
    · haveI : Limits.PreservesLimitsOfShape I
