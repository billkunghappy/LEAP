    intro O y
    exact congrArg (fun f => (f.hom.app (Opposite.op O)).hom y) e.hom_inv_id
  refine ⟨e.inv ≫ φ, ?_, ?_⟩
  · intro V O k hk x
    show (φ.hom.app (Opposite.op O)).hom ((e.inv.hom.app (Opposite.op O)).hom
      ((e.hom.hom.app (Opposite.op O)).hom (r.ρ V O k hk x))) = _
    rw [hinv]
    exact hφ V O k hk x
  · intro ψ' hψ'
    have h1 : e.hom ≫ ψ' = φ := huniq _ (fun V O k hk x => hψ' V O k hk x)
    exact (Iso.eq_inv_comp e).mpr h1

theorem wc_et_transport_kernel_factor : ∀ {A B : Scheme.{u}} (f : A ⟶ B) {M M' : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}} (ψ : M ⟶ M') {N : Sheaf (Scheme.smallEtaleTopology A) AddCommGrpCat.{u+1}} (J : InjectiveResolution N) (t : wcEtTransport f M' (J.cocomplex.X 0)), (∀ (V : B.Etale) (O : A.Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ f) (x : M.obj.obj (Opposite.op V)), ((J.cocomplex.d 0 1).hom.app (Opposite.op O)).hom (t.ρ V O k hk ((ψ.hom.app (Opposite.op V)).hom x)) = 0) → ∃ t' : wcEtTransport f M N, ∀ (V : B.Etale) (O : A.Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ f) (x : M.obj.obj (Opposite.op V)), ((J.ι.f 0).hom.app (Opposite.op O)).hom (t'.ρ V O k hk x) = t.ρ V O k hk ((ψ.hom.app (Opposite.op V)).hom x) :=
by
  intro A B f M M' ψ N J t hyp
  have hO : ∀ O : A.Etale, Limits.IsLimit ((Limits.KernelFork.ofι (J.ι.f 0)
      J.ι_f_zero_comp_complex_d).map (sheafToPresheaf (Scheme.smallEtaleTopology A)
        AddCommGrpCat.{u+1} ⋙ (evaluation _ AddCommGrpCat.{u+1}).obj (Opposite.op O))) :=
    fun O => Limits.KernelFork.mapIsLimit _ J.exact₀.fIsKernel _
  have hinj : ∀ O : A.Etale, Function.Injective ((J.ι.f 0).hom.app (Opposite.op O)).hom :=
    fun O => (AddCommGrpCat.mono_iff_injective _).1 (Limits.Fork.IsLimit.mono (hO O))
  have hw : ∀ (V : B.Etale) (O : A.Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ f),
      (ψ.hom.app (Opposite.op V) ≫ AddCommGrpCat.ofHom (t.ρ V O k hk)) ≫
        (J.cocomplex.d 0 1).hom.app (Opposite.op O) = 0 := by
    intro V O k hk
    ext x
    exact hyp V O k hk x
  let ρ' : ∀ (V : B.Etale) (O : A.Etale) (k : O.left ⟶ V.left)
      (hk : k ≫ V.hom = O.hom ≫ f), M.obj.obj (Opposite.op V) →+ N.obj.obj (Opposite.op O) :=
    fun V O k hk => (Limits.KernelFork.IsLimit.lift' (hO O) _ (hw V O k hk)).1.hom
  have hspec : ∀ (V : B.Etale) (O : A.Etale) (k : O.left ⟶ V.left)
      (hk : k ≫ V.hom = O.hom ≫ f) (x : M.obj.obj (Opposite.op V)),
      ((J.ι.f 0).hom.app (Opposite.op O)).hom (ρ' V O k hk x) =
        t.ρ V O k hk ((ψ.hom.app (Opposite.op V)).hom x) := by
    intro V O k hk x
    have h2 := (Limits.KernelFork.IsLimit.lift' (hO O) _ (hw V O k hk)).2
    exact congrArg (fun φ => φ.hom x) h2
  refine ⟨{ ρ := ρ', nat := ?_ }, hspec⟩
  intro V V' c O O' d h hh h' hh' hc x
  apply hinj O'
  rw [hspec]
  have e2 : (ψ.hom.app (Opposite.op V')).hom ((M.obj.map c.op).hom x) =
      (M'.obj.map c.op).hom ((ψ.hom.app (Opposite.op V)).hom x) :=
    congrArg (fun φ => φ.hom x) (ψ.hom.naturality c.op)
  rw [e2, t.nat V V' c O O' d h hh h' hh' hc, ← hspec V O h hh x]
  exact (congrArg (fun φ => φ.hom (ρ' V O h hh x)) ((J.ι.f 0).hom.naturality d.op)).symm

theorem wc_et_transport_comparison_exists : ∀ {A B : Scheme.{u}} (f : A ⟶ B) {M : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}} {N : Sheaf (Scheme.smallEtaleTopology A) AddCommGrpCat.{u+1}} (I : InjectiveResolution M) (J : InjectiveResolution N) (t₀ : wcEtTransport f M N), ∃ T : ∀ n : ℕ, wcEtTransport f (I.cocomplex.X n) (J.cocomplex.X n), (∀ (n : ℕ) (V : B.Etale) (O : A.Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ f) (x : (I.cocomplex.X n).obj.obj (Opposite.op V)), (T (n + 1)).ρ V O k hk (((I.cocomplex.d n (n + 1)).hom.app (Opposite.op V)).hom x) = ((J.cocomplex.d n (n + 1)).hom.app (Opposite.op O)).hom ((T n).ρ V O k hk x)) ∧ ∀ (V : B.Etale) (O : A.Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ f) (x : M.obj.obj (Opposite.op V)), (T 0).ρ V O k hk (((I.ι.f 0).hom.app (Opposite.op V)).hom x) = ((J.ι.f 0).hom.app (Opposite.op O)).hom (t₀.ρ V O k hk x) :=
by
  intro A B f M N I J t₀
  classical

  have hlan : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] [Limits.HasFiniteLimits C]
      (G : C ⥤ D) [Limits.PreservesFiniteLimits G],
      Limits.PreservesFiniteLimits (G.op.lan : (Cᵒᵖ ⥤ AddCommGrpCat.{u+1}) ⥤ (Dᵒᵖ ⥤ AddCommGrpCat.{u+1})) := by
    intro C D _ _ _ G _
    have wc_lan_eval_iso : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (L : C ⥤ D)
        [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
        [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F] (Y : D),
        Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
            (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
          (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
            Limits.colim) := by
      intro C D _ _ L _ _ Y
      refine ⟨NatIso.ofComponents (fun F => L.leftKanExtensionObjIsoColimit F Y) ?_⟩
      intro F₁ F₂ φ
      have hnat : ∀ j : CostructuredArrow L Y,
          (L.leftKanExtension F₁).map j.hom ≫ (L.lan.map φ).app Y =
          (L.lan.map φ).app (L.obj j.left) ≫ (L.leftKanExtension F₂).map j.hom :=
        fun j => (L.lan.map φ).naturality j.hom
      have hfac : ∀ j : CostructuredArrow L Y,
          (L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left) =
          φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left := fun j =>
        Functor.descOfIsLeftKanExtension_fac_app (L.leftKanExtension F₁)
          (L.leftKanExtensionUnit F₁) (L.leftKanExtension F₂) (φ ≫ L.leftKanExtensionUnit F₂) j.left
      refine (Iso.inv_comp_eq _).1 ?_
      apply Limits.colimit.hom_ext
      intro j
      have key : (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
          (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom =
          φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
        calc (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
              (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom
            = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.leftKanExtension F₁).map j.hom ≫
              (L.lan.map φ).app Y) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
              congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _).symm
          _ = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.lan.map φ).app (L.obj j.left) ≫
              (L.leftKanExtension F₂).map j.hom) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
              congrArg (fun k => (L.leftKanExtensionUnit F₁).app j.left ≫ k ≫
                (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hnat j)
          _ = ((L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left)) ≫
              (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
              (congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _)).trans
                (Category.assoc _ _ _).symm
          _ = (φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left) ≫
              (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
              congrArg (· ≫ (L.leftKanExtension F₂).map j.hom ≫
                (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hfac j)
          _ = φ.app j.left ≫ ((L.leftKanExtensionUnit F₂).app j.left ≫
              (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom) :=
              Category.assoc _ _ _
          _ = φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
              congrArg (φ.app j.left ≫ ·) (Functor.ι_leftKanExtensionObjIsoColimit_hom L F₂ Y j)
      erw [Functor.ι_leftKanExtensionObjIsoColimit_inv_assoc, Limits.ι_colimMap]
