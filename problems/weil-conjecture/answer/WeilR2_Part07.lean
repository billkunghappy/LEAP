  haveI : IsAffine (F.obj l).left := haff l
  haveI : Etale (F.obj l).hom := (W'.obj l).right.prop
  obtain ⟨Q, q, γ, j', hQ, hpb'⟩ := wc_et_curve_torsor_algclosed_descent K A s (F.obj l).left
    (F.obj l).hom L Ω zb ι ℓ hℓ hℓK Pl pl αl hPl

  have hw4 : (Limits.pullback.fst (a ≫ wcHalA1Proj s) zb ≫ φ l) ≫ (F.obj l).hom ≫ wcHalA1Proj s =
      Limits.pullback.snd (a ≫ wcHalA1Proj s) zb ≫ zb := by
    rw [Category.assoc, hπ l]; exact Limits.pullback.condition
  obtain ⟨τ, hτ⟩ := hsec (Limits.pullback.lift _ _ hw4) halg Q q γ hQ
  have hw5 : Limits.pullback.fst (a ≫ wcHalA1Proj s) (Spec.map (CommRingCat.ofHom ι) ≫ zb) ≫
        (a ≫ wcHalA1Proj s) =
      (Limits.pullback.snd (a ≫ wcHalA1Proj s) (Spec.map (CommRingCat.ofHom ι) ≫ zb) ≫
        Spec.map (CommRingCat.ofHom ι)) ≫ zb := by
    rw [Limits.pullback.condition, Category.assoc]
  have hw7 : (Limits.pullback.fst (a ≫ wcHalA1Proj s) (Spec.map (CommRingCat.ofHom ι) ≫ zb) ≫ φ l) ≫
        (F.obj l).hom ≫ wcHalA1Proj s =
      Limits.pullback.snd (a ≫ wcHalA1Proj s) (Spec.map (CommRingCat.ofHom ι) ≫ zb) ≫
        (Spec.map (CommRingCat.ofHom ι) ≫ zb) :=
    (Category.assoc _ _ _).trans ((congrArg
      (Limits.pullback.fst (a ≫ wcHalA1Proj s) (Spec.map (CommRingCat.ofHom ι) ≫ zb) ≫ ·)
      (hπ l)).trans Limits.pullback.condition)
  have hw8 : Limits.pullback.fst ((F.obj l).hom ≫ wcHalA1Proj s)
        (Spec.map (CommRingCat.ofHom ι) ≫ zb) ≫ (F.obj l).hom ≫ wcHalA1Proj s =
      (Limits.pullback.snd ((F.obj l).hom ≫ wcHalA1Proj s) (Spec.map (CommRingCat.ofHom ι) ≫ zb) ≫
        Spec.map (CommRingCat.ofHom ι)) ≫ zb :=
    Limits.pullback.condition.trans (Category.assoc _ _ _).symm
  have e1 : Limits.pullback.lift _ _ hw4 ≫ Limits.pullback.fst ((F.obj l).hom ≫ wcHalA1Proj s) zb =
      Limits.pullback.fst (a ≫ wcHalA1Proj s) zb ≫ φ l := Limits.pullback.lift_fst _ _ _
  have e2 : Limits.pullback.lift _ _ hw4 ≫ Limits.pullback.snd ((F.obj l).hom ≫ wcHalA1Proj s) zb =
      Limits.pullback.snd (a ≫ wcHalA1Proj s) zb := Limits.pullback.lift_snd _ _ _
  have e3 : Limits.pullback.lift _ _ hw5 ≫ Limits.pullback.fst (a ≫ wcHalA1Proj s) zb =
      Limits.pullback.fst (a ≫ wcHalA1Proj s) (Spec.map (CommRingCat.ofHom ι) ≫ zb) :=
    Limits.pullback.lift_fst _ _ _
  have e4 : Limits.pullback.lift _ _ hw5 ≫ Limits.pullback.snd (a ≫ wcHalA1Proj s) zb =
      Limits.pullback.snd (a ≫ wcHalA1Proj s) (Spec.map (CommRingCat.ofHom ι) ≫ zb) ≫
        Spec.map (CommRingCat.ofHom ι) :=
    Limits.pullback.lift_snd _ _ _
  have e5 : Limits.pullback.lift _ _ hw7 ≫ Limits.pullback.fst ((F.obj l).hom ≫ wcHalA1Proj s)
        (Spec.map (CommRingCat.ofHom ι) ≫ zb) =
      Limits.pullback.fst (a ≫ wcHalA1Proj s) (Spec.map (CommRingCat.ofHom ι) ≫ zb) ≫ φ l :=
    Limits.pullback.lift_fst _ _ _
  have e6 : Limits.pullback.lift _ _ hw7 ≫ Limits.pullback.snd ((F.obj l).hom ≫ wcHalA1Proj s)
        (Spec.map (CommRingCat.ofHom ι) ≫ zb) =
      Limits.pullback.snd (a ≫ wcHalA1Proj s) (Spec.map (CommRingCat.ofHom ι) ≫ zb) :=
    Limits.pullback.lift_snd _ _ _
  have e7 : Limits.pullback.lift _ _ hw8 ≫ Limits.pullback.fst ((F.obj l).hom ≫ wcHalA1Proj s) zb =
      Limits.pullback.fst ((F.obj l).hom ≫ wcHalA1Proj s) (Spec.map (CommRingCat.ofHom ι) ≫ zb) :=
    Limits.pullback.lift_fst _ _ _
  have e8 : Limits.pullback.lift _ _ hw8 ≫ Limits.pullback.snd ((F.obj l).hom ≫ wcHalA1Proj s) zb =
      Limits.pullback.snd ((F.obj l).hom ≫ wcHalA1Proj s) (Spec.map (CommRingCat.ofHom ι) ≫ zb) ≫
        Spec.map (CommRingCat.ofHom ι) :=
    Limits.pullback.lift_snd _ _ _
  have h0 : (Limits.pullback.lift _ _ hw5 ≫ Limits.pullback.lift _ _ hw4) ≫
        Limits.pullback.fst ((F.obj l).hom ≫ wcHalA1Proj s) zb =
      (Limits.pullback.lift _ _ hw7 ≫ Limits.pullback.lift _ _ hw8) ≫
        Limits.pullback.fst ((F.obj l).hom ≫ wcHalA1Proj s) zb :=
    (Category.assoc _ _ _).trans ((congrArg (Limits.pullback.lift _ _ hw5 ≫ ·) e1).trans
      ((Category.assoc _ _ _).symm.trans ((congrArg (· ≫ φ l) e3).trans (e5.symm.trans
        ((congrArg (Limits.pullback.lift _ _ hw7 ≫ ·) e7.symm).trans
          (Category.assoc _ _ _).symm)))))
  have h1 : (Limits.pullback.lift _ _ hw5 ≫ Limits.pullback.lift _ _ hw4) ≫
        Limits.pullback.snd ((F.obj l).hom ≫ wcHalA1Proj s) zb =
      (Limits.pullback.lift _ _ hw7 ≫ Limits.pullback.lift _ _ hw8) ≫
        Limits.pullback.snd ((F.obj l).hom ≫ wcHalA1Proj s) zb :=
    (Category.assoc _ _ _).trans ((congrArg (Limits.pullback.lift _ _ hw5 ≫ ·) e2).trans
      (e4.trans ((congrArg (· ≫ Spec.map (CommRingCat.ofHom ι)) e6.symm).trans
        ((Category.assoc _ _ _).trans ((congrArg (Limits.pullback.lift _ _ hw7 ≫ ·) e8.symm).trans
          (Category.assoc _ _ _).symm)))))
  have hw6 : (Limits.pullback.lift _ _ hw5 ≫ τ) ≫ q =
      Limits.pullback.lift _ _ hw7 ≫ Limits.pullback.lift _ _ hw8 :=
    (Category.assoc _ _ _).trans ((congrArg (Limits.pullback.lift _ _ hw5 ≫ ·) hτ).trans
      (Limits.pullback.hom_ext h0 h1))
  exact ⟨hpb.lift (hpb'.lift _ _ hw6) (𝟙 _)
      ((hpb'.lift_snd _ _ _).trans (Category.id_comp _).symm),
    hpb.lift_snd _ _ _⟩

theorem wc_hal_geom_higher_direct_vanish : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (s : Spec (.of A) ⟶ Spec (.of K)) (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A)), (∀ (x : wcHalA1 s), (∀ x' : wcHalA1 s, wcHalA1Proj s x' = wcHalA1Proj s x → x ⤳ x' → x' = x) → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcHalA1 s) x)) (Scheme.Etale.forget (wcHalA1 s))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ wcHalA1 s), wcHalShData x B Λ W' φ a → ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh (Limits.pullback (a ≫ wcHalA1Proj s) z) ℓ q)) → ∀ (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback (wcHalA1Proj s) z)) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) (n : ℕ), 1 ≤ n → Limits.IsZero ((((wcEtPush (Limits.pullback.fst (wcHalA1Proj s) z)).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology n) :=
by
  classical
  intro K _ _ ℓ hℓ hℓK A _ _ _ s Ω _ _ z hT I n hn

  have hπ : LocallyOfFiniteType (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) := by
    rw [HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)]
    exact RingHom.finiteType_algebraMap.mpr inferInstance
  haveI hg : LocallyOfFiniteType (wcHalA1Proj s) :=
    MorphismProperty.of_isPullback (P := @LocallyOfFiniteType)
      (IsPullback.of_hasPullback s (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))).flip hπ
  haveI hf'aff : IsAffineHom (Limits.pullback.fst (wcHalA1Proj s) z) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom)
      (IsPullback.of_hasPullback (wcHalA1Proj s) z).flip inferInstance

  have key : ∀ {V X Y : Scheme.{u}} (p : V ⟶ X) (g : X ⟶ Y) [LocallyOfFiniteType p]
      [LocallyOfFiniteType g] (Z : Set V), IsClosed Z → Z.Nonempty →
      ∃ v ∈ Z, ∀ x' : X, g x' = g (p v) → p v ⤳ x' → x' = p v := by
    intro V X Y p g _ _ Z hZ hne
    obtain ⟨v₁, hv₁⟩ := hne
    obtain ⟨y, hy⟩ : ∃ y, g (p v₁) = y := ⟨_, rfl⟩
    haveI hσF : LocallyOfFiniteType (Limits.pullback.snd (p ≫ g) (Y.fromSpecResidueField y)) :=
      MorphismProperty.of_isPullback (P := @LocallyOfFiniteType)
        (IsPullback.of_hasPullback (p ≫ g) (Y.fromSpecResidueField y)) inferInstance
    haveI hσG : LocallyOfFiniteType (Limits.pullback.snd g (Y.fromSpecResidueField y)) :=
      MorphismProperty.of_isPullback (P := @LocallyOfFiniteType)
        (IsPullback.of_hasPullback g (Y.fromSpecResidueField y)) inferInstance
    haveI : JacobsonSpace (Limits.pullback (C := Scheme.{u}) (p ≫ g) (Y.fromSpecResidueField y)) :=
      LocallyOfFiniteType.jacobsonSpace (Limits.pullback.snd (p ≫ g) (Y.fromSpecResidueField y))
    haveI : JacobsonSpace (Limits.pullback (C := Scheme.{u}) g (Y.fromSpecResidueField y)) :=
      LocallyOfFiniteType.jacobsonSpace (Limits.pullback.snd g (Y.fromSpecResidueField y))
    have hrF : Set.range (Limits.pullback.fst (p ≫ g) (Y.fromSpecResidueField y)) =
        (p ≫ g) ⁻¹' {y} := Scheme.Hom.range_fiberι (p ≫ g) y
    have hrG : Set.range (Limits.pullback.fst g (Y.fromSpecResidueField y)) = g ⁻¹' {y} :=
      Scheme.Hom.range_fiberι g y
    have hv₁r : v₁ ∈ Set.range (Limits.pullback.fst (p ≫ g) (Y.fromSpecResidueField y)) := by
      rw [hrF]
      exact (Scheme.Hom.comp_apply p g v₁).trans hy
    obtain ⟨w₁, hw₁⟩ := hv₁r
    have hZF : IsClosed ((Limits.pullback.fst (p ≫ g) (Y.fromSpecResidueField y)) ⁻¹' Z) :=
      hZ.preimage (Limits.pullback.fst (p ≫ g) (Y.fromSpecResidueField y)).continuous
    have hw₁Z : w₁ ∈ (Limits.pullback.fst (p ≫ g) (Y.fromSpecResidueField y)) ⁻¹' Z := by
      rw [Set.mem_preimage, hw₁]
      exact hv₁
    obtain ⟨w, hwZ, hwc⟩ := nonempty_inter_closedPoints ⟨w₁, hw₁Z⟩ hZF.isLocallyClosed
    let π : Limits.pullback (p ≫ g) (Y.fromSpecResidueField y) ⟶
        Limits.pullback g (Y.fromSpecResidueField y) :=
      Limits.pullback.lift (Limits.pullback.fst (p ≫ g) (Y.fromSpecResidueField y) ≫ p)
        (Limits.pullback.snd (p ≫ g) (Y.fromSpecResidueField y))
        (by rw [Category.assoc]; exact Limits.pullback.condition)
    have hπ1 : π ≫ Limits.pullback.fst g (Y.fromSpecResidueField y) =
        Limits.pullback.fst (p ≫ g) (Y.fromSpecResidueField y) ≫ p :=
      Limits.pullback.lift_fst _ _ _
    have hπ2 : π ≫ Limits.pullback.snd g (Y.fromSpecResidueField y) =
        Limits.pullback.snd (p ≫ g) (Y.fromSpecResidueField y) :=
      Limits.pullback.lift_snd _ _ _
    haveI : LocallyOfFiniteType (π ≫ Limits.pullback.snd g (Y.fromSpecResidueField y)) := by
      rw [hπ2]; exact hσF
    haveI : LocallyOfFiniteType π :=
      locallyOfFiniteType_of_comp π (Limits.pullback.snd g (Y.fromSpecResidueField y))
    have hπw : π w ∈ closedPoints (Limits.pullback (C := Scheme.{u}) g (Y.fromSpecResidueField y)) :=
      Scheme.Hom.closePoints_subset_preimage_closedPoints π hwc
    have hpv : Limits.pullback.fst g (Y.fromSpecResidueField y) (π w) =
        p (Limits.pullback.fst (p ≫ g) (Y.fromSpecResidueField y) w) :=
      (Scheme.Hom.comp_apply π (Limits.pullback.fst g (Y.fromSpecResidueField y)) w).symm.trans
        ((congrArg (fun f : Limits.pullback (p ≫ g) (Y.fromSpecResidueField y) ⟶ X => f w) hπ1).trans
          (Scheme.Hom.comp_apply _ _ w))
    have hwy : Limits.pullback.fst (p ≫ g) (Y.fromSpecResidueField y) w ∈ (p ≫ g) ⁻¹' {y} := by
      rw [← hrF]; exact Set.mem_range_self w
    have hgy : g (p (Limits.pullback.fst (p ≫ g) (Y.fromSpecResidueField y) w)) = y :=
      (Scheme.Hom.comp_apply p g _).symm.trans hwy
    haveI : IsPreimmersion (Limits.pullback.fst g (Y.fromSpecResidueField y)) :=
      (inferInstance : IsPreimmersion (g.fiberι y))
    refine ⟨Limits.pullback.fst (p ≫ g) (Y.fromSpecResidueField y) w, hwZ, ?_⟩
    intro x' hx' hsp
    have hx'r : x' ∈ Set.range (Limits.pullback.fst g (Y.fromSpecResidueField y)) := by
      rw [hrG]; exact hx'.trans hgy
    obtain ⟨w', rfl⟩ := hx'r
    rw [← hpv] at hsp ⊢
    have hsp' : π w ⤳ w' :=
      (Scheme.Hom.isEmbedding (Limits.pullback.fst g (Y.fromSpecResidueField y))).isInducing.specializes_iff.mp hsp
    have hcl : IsClosed ({π w} : Set (Limits.pullback (C := Scheme.{u}) g (Y.fromSpecResidueField y))) :=
      mem_closedPoints_iff.mp hπw
    have hmem : w' ∈ closure ({π w} : Set (Limits.pullback (C := Scheme.{u}) g (Y.fromSpecResidueField y))) :=
      specializes_iff_mem_closure.mp hsp'
    rw [hcl.closure_eq, Set.mem_singleton_iff] at hmem
    rw [hmem]
  have hmeet : ∀ (V : (wcHalA1 s).Etale) (Z : Set V.left), IsClosed Z → Z.Nonempty →
      ∃ v ∈ Z, ∀ x' : wcHalA1 s, wcHalA1Proj s x' = wcHalA1Proj s (V.hom v) →
        V.hom v ⤳ x' → x' = V.hom v := by
    intro V Z hZ hne
    haveI : Etale V.hom := V.prop
    exact key V.hom (wcHalA1Proj s) Z hZ hne

  have crit : ∀ (Hs : Sheaf (Scheme.smallEtaleTopology (wcHalA1 s)) AddCommGrpCat.{u+1}),
      (∀ x : wcHalA1 s, (∀ x' : wcHalA1 s, wcHalA1Proj s x' = wcHalA1Proj s x → x ⤳ x' → x' = x) →
        Subsingleton ((wcEtStalk (wcHalA1 s) x).obj Hs)) → Limits.IsZero Hs := by
    intro Hs hHs
    have key0 : ∀ (V : (wcHalA1 s).Etale) (h : Hs.obj.obj (Opposite.op V)), h = 0 := by
      intro V h
      obtain ⟨hopen, hall⟩ := wc_etale_section_vanishing_open (wcHalA1 s) Hs V h
      have hW : ∀ v : V.left, v ∈ {v : V.left | ∃ (V₁ : (wcHalA1 s).Etale) (c : V₁ ⟶ V),
          v ∈ Set.range c.left ∧ Hs.obj.map c.op h = 0} := by
        intro v
        by_contra hv
        obtain ⟨v', hv', hP⟩ := hmeet V _ hopen.isClosed_compl ⟨v, hv⟩
        exact hv' (wc_et_vanish_off_of_stalks Hs V h v' (hHs _ hP))
      have h2 := hall V (𝟙 V) (fun v _ => hW v)
      rw [op_id, Hs.obj.map_id] at h2
      exact h2
    have hP : Limits.IsZero Hs.obj := by
      apply Functor.isZero
      intro U
      haveI : Subsingleton (Hs.obj.obj U) :=
        ⟨fun a b => (key0 U.unop a).trans (key0 U.unop b).symm⟩
      exact AddCommGrpCat.isZero_of_subsingleton _
    exact Limits.IsZero.of_full_of_faithful_of_isZero (sheafToPresheaf _ _) Hs hP

  apply crit
  intro x hx
  obtain ⟨B, _, _, _, Λ, _, _, W', φ, a, e, hinit, haff, hφ, hφa, hlim, he, hcomp⟩ :=
    wc_et_geom_strict_henselization x
  have hd : wcHalShData x B Λ W' φ a := ⟨hinit, haff, hφ, hφa, hlim, e, he, hcomp⟩
  obtain ⟨E₁⟩ := wc_et_stalk_push_homology (Limits.pullback.fst (wcHalA1Proj s) z) x Λ W' hinit
    I.cocomplex n
  obtain ⟨E₂⟩ := wc_et_limit_push_homology_affine (Limits.pullback.fst (wcHalA1Proj s) z) B Λ
    (W' ⋙ StructuredArrow.proj (Over.mk (wcEtGeomPt (wcHalA1 s) x)) (Scheme.Etale.forget (wcHalA1 s)))
    φ a haff hφ hφa hlim ℓ I n
  obtain ⟨E₃⟩ := wc_et_coh_iso_invariance
    ((Limits.pullbackSymmetry (Limits.pullback.fst (wcHalA1Proj s) z) a).hom ≫
      (Limits.pullbackRightPullbackFstIso (wcHalA1Proj s) z a).hom) ℓ n
  haveI := hT x hx B Λ W' φ a hd n hn
  exact (E₁.trans (E₂.trans E₃.symm)).subsingleton

theorem wc_et_zero_of_fibre_closed_stalks : ∀ {X Y : Scheme.{u}} (g : X ⟶ Y) [LocallyOfFiniteType g] (H : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}), (∀ x : X, (∀ x' : X, g x' = g x → x ⤳ x' → x' = x) → Subsingleton ((wcEtStalk X x).obj H)) → Limits.IsZero H :=
by
  intro X Y g _ H hH

  have s3 : ∀ {V : Scheme.{u}} (f : V ⟶ Y) [LocallyOfFiniteType f] (Z : Set V), IsClosed Z →
      ∀ v ∈ Z, ∃ v₀ ∈ Z, f v₀ = f v ∧ ∀ v' : V, f v' = f v₀ → v₀ ⤳ v' → v' = v₀ := by
    intro V f _ Z hZ v hv
    have hemb : Topology.IsEmbedding (f.fiberι (f v)) := Scheme.Hom.isEmbedding _
    have hZ' : IsClosed ((f.fiberι (f v)) ⁻¹' Z) := hZ.preimage (f.fiberι (f v)).continuous
    have hne : ((f.fiberι (f v)) ⁻¹' Z).Nonempty :=
      ⟨f.asFiber v, show f.fiberι (f v) (f.asFiber v) ∈ Z by
        rw [Scheme.Hom.fiberι_asFiber]; exact hv⟩
    obtain ⟨w₀, hw₀Z, hw₀c⟩ := nonempty_inter_closedPoints hne hZ'.isLocallyClosed
    rw [mem_closedPoints_iff] at hw₀c
    have hfw : f (f.fiberι (f v) w₀) = f v := by
      have : f.fiberι (f v) w₀ ∈ Set.range (f.fiberι (f v)) := ⟨w₀, rfl⟩
      rw [Scheme.Hom.range_fiberι] at this
      exact this
    refine ⟨f.fiberι (f v) w₀, hw₀Z, hfw, ?_⟩
    intro v' hv' hsp
    obtain ⟨u', rfl⟩ : v' ∈ Set.range (f.fiberι (f v)) := by
      rw [Scheme.Hom.range_fiberι]; exact hv'.trans hfw
    have h1 : w₀ ⤳ u' := hemb.isInducing.specializes_iff.mp hsp
    have h2 : u' = w₀ := h1.mem_closed hw₀c (Set.mem_singleton w₀)
    rw [h2]

  have s4 : ∀ {V : Scheme.{u}} (p : V ⟶ X) [LocallyOfFiniteType p] (v₀ : V),
      (∀ v' : V, (p ≫ g) v' = (p ≫ g) v₀ → v₀ ⤳ v' → v' = v₀) →
      ∀ x' : X, g x' = g (p v₀) → p v₀ ⤳ x' → x' = p v₀ := by
    intro V p _ v₀ hv₀ x' hx' hsp
    have hgy : g (p v₀) = (p ≫ g) v₀ := (Scheme.Hom.comp_apply p g v₀).symm
    have hembV : Topology.IsEmbedding ((p ≫ g).fiberι ((p ≫ g) v₀)) := Scheme.Hom.isEmbedding _
    have hembX : Topology.IsEmbedding (g.fiberι ((p ≫ g) v₀)) := Scheme.Hom.isEmbedding _
    have hw₀ : (p ≫ g).fiberι ((p ≫ g) v₀) ((p ≫ g).asFiber v₀) = v₀ :=
      Scheme.Hom.fiberι_asFiber (p ≫ g) v₀
    have hw₀c : IsClosed ({(p ≫ g).asFiber v₀} : Set ((p ≫ g).fiber ((p ≫ g) v₀))) := by
      rw [← closure_subset_iff_isClosed]
      intro u hu
      have hsp' : (p ≫ g).asFiber v₀ ⤳ u := specializes_iff_mem_closure.mpr hu
      have h1 := hsp'.map ((p ≫ g).fiberι ((p ≫ g) v₀)).continuous
      rw [hw₀] at h1
      have h2 : (p ≫ g) ((p ≫ g).fiberι ((p ≫ g) v₀) u) = (p ≫ g) v₀ := by
        have : (p ≫ g).fiberι ((p ≫ g) v₀) u ∈ Set.range ((p ≫ g).fiberι ((p ≫ g) v₀)) :=
          ⟨u, rfl⟩
        rw [Scheme.Hom.range_fiberι] at this
        exact this
      have h3 := hv₀ _ h2 h1
      exact hembV.injective (h3.trans hw₀.symm)
    let φ : (p ≫ g).fiber ((p ≫ g) v₀) ⟶ g.fiber ((p ≫ g) v₀) :=
      Limits.pullback.map (p ≫ g) (Y.fromSpecResidueField ((p ≫ g) v₀)) g
        (Y.fromSpecResidueField ((p ≫ g) v₀)) p (𝟙 _) (𝟙 _) (Category.comp_id _)
        (by rw [Category.comp_id, Category.id_comp])
    have hφι : φ ≫ g.fiberι ((p ≫ g) v₀) = (p ≫ g).fiberι ((p ≫ g) v₀) ≫ p := by
      first
        | exact Limits.pullback.lift_fst _ _ _
        | simp [φ, Scheme.Hom.fiberι]
    have hφs : φ ≫ g.fiberToSpecResidueField ((p ≫ g) v₀) =
        (p ≫ g).fiberToSpecResidueField ((p ≫ g) v₀) := by
      first
        | exact (Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _)
        | simp [φ, Scheme.Hom.fiberToSpecResidueField]
    haveI hsnd : LocallyOfFiniteType ((p ≫ g).fiberToSpecResidueField ((p ≫ g) v₀)) :=
      inferInstanceAs (LocallyOfFiniteType
        (Limits.pullback.snd (p ≫ g) (Y.fromSpecResidueField ((p ≫ g) v₀))))
    haveI : LocallyOfFiniteType (φ ≫ g.fiberToSpecResidueField ((p ≫ g) v₀)) := by
      rw [hφs]; exact hsnd
    haveI : LocallyOfFiniteType φ :=
      locallyOfFiniteType_of_comp φ (g.fiberToSpecResidueField ((p ≫ g) v₀))
    have hu₀ : φ ((p ≫ g).asFiber v₀) ∈ closedPoints (g.fiber ((p ≫ g) v₀)) :=
      Scheme.Hom.closePoints_subset_preimage_closedPoints φ (mem_closedPoints_iff.mpr hw₀c)
    have hιu₀ : g.fiberι ((p ≫ g) v₀) (φ ((p ≫ g).asFiber v₀)) = p v₀ := by
      rw [← Scheme.Hom.comp_apply, hφι, Scheme.Hom.comp_apply, hw₀]
    rw [hgy] at hx'
    obtain ⟨u, rfl⟩ : x' ∈ Set.range (g.fiberι ((p ≫ g) v₀)) := by
      rw [Scheme.Hom.range_fiberι]; exact hx'
    have hsp2 : g.fiberι ((p ≫ g) v₀) (φ ((p ≫ g).asFiber v₀)) ⤳ g.fiberι ((p ≫ g) v₀) u := by
      rw [hιu₀]; exact hsp
    have h1 := hembX.isInducing.specializes_iff.mp hsp2
    have h2 : u = φ ((p ≫ g).asFiber v₀) :=
      h1.mem_closed (mem_closedPoints_iff.mp hu₀) (Set.mem_singleton _)
    rw [h2, hιu₀]

  have hsec : ∀ (V : X.Etale) (h : H.obj.obj (Opposite.op V)), h = 0 := by
    intro V h
    obtain ⟨hopen, hclause⟩ := wc_etale_section_vanishing_open X H V h
    have huniv : ∀ v : V.left, v ∈ {v : V.left | ∃ (V₁ : X.Etale) (c : V₁ ⟶ V),
        v ∈ Set.range c.left ∧ H.obj.map c.op h = 0} := by
      intro v
      by_contra hv
      haveI : Etale V.hom := V.prop
      obtain ⟨v₀, hv₀Z, -, hv₀c⟩ := s3 (V.hom ≫ g) _ hopen.isClosed_compl v hv
      have hx₀ := s4 V.hom v₀ hv₀c
      haveI := hH (V.hom v₀) hx₀
      obtain ⟨V₁, c, hmem, hc⟩ := wc_et_vanish_off_of_stalks H V h v₀ this
      exact hv₀Z ⟨V₁, c, hmem, hc⟩
    have h0 := hclause V (𝟙 V) (fun v _ => huniv v)
    first
      | simpa using h0
      | (rw [op_id, H.obj.map_id] at h0; exact h0)

  apply Limits.IsZero.of_full_of_faithful_of_isZero (sheafToPresheaf _ _) H
  apply Functor.isZero
  intro U
  have hs : Subsingleton (H.obj.obj U) :=
    ⟨fun a b => (hsec U.unop a).trans (hsec U.unop b).symm⟩
  exact @AddCommGrpCat.isZero_of_subsingleton _ hs

theorem wc_et_univ_transport_mono_crit : ∀ {S Z : Scheme.{u}} (g : Z ⟶ S) (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) (P H : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (ρ : wcEtTransport g G P), wcEtTransportUniv ρ → ∀ (β : P ⟶ H), (∀ (V : S.Etale) (O : Z.Etale) (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ g) (x : G.obj.obj (Opposite.op V)), (β.hom.app (Opposite.op O)).hom (ρ.ρ V O h hh x) = 0 → ∃ (V₁ : S.Etale) (c : V₁ ⟶ V) (h₁ : O.left ⟶ V₁.left) (hh₁ : h₁ ≫ V₁.hom = O.hom ≫ g), h₁ ≫ c.left = h ∧ (G.obj.map c.op).hom x = 0) → Mono β :=
by
  intro S Z g G P H ρ hU β hyp
  have key : ∀ (O : Z.Etale) (k : P.obj.obj (Opposite.op O)),
      (β.hom.app (Opposite.op O)).hom k = 0 → k = 0 := by
    intro O k hk
    have hall : ∀ o : O.left, o ∈ {v : O.left | ∃ (V₁ : Z.Etale) (c : V₁ ⟶ O),
        v ∈ Set.range c.left ∧ P.obj.map c.op k = 0} := by
      intro o
      obtain ⟨O', d, o', V, h', hh', y, hd, hE⟩ :=
        wc_et_univ_transport_locally_surjective g G P ρ hU O k o
      have hE' : (P.obj.map d.op).hom k = ρ.ρ V O' h' hh' y := hE
      have hn := congrArg (fun f => f.hom k) (β.hom.naturality d.op)
      simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at hn
      have hβ : (β.hom.app (Opposite.op O')).hom (ρ.ρ V O' h' hh' y) = 0 := by
        rw [← hE']
        refine hn.trans ?_
        rw [hk, map_zero]
      obtain ⟨V₁, c, h₁, hh₁, hc, hx⟩ := hyp V O' h' hh' y hβ
      have hn2 := ρ.nat V V₁ c O' O' (𝟙 O') h' hh' h₁ hh₁
        (by rw [hc]; first | exact (Category.id_comp h').symm | simp) y
      have e1 : (ρ.ρ V₁ O' h₁ hh₁) ((G.obj.map c.op).hom y) = 0 := by
        rw [hx, map_zero]
      have e2 : (P.obj.map (𝟙 O').op).hom (ρ.ρ V O' h' hh' y) = ρ.ρ V O' h' hh' y := by
        rw [op_id, P.obj.map_id]
        rfl
      have h0 : ρ.ρ V O' h' hh' y = 0 := by
        rw [← e2]
        exact hn2.symm.trans e1
      exact ⟨O', d, ⟨o', hd⟩, hE.trans h0⟩
    have hv := (wc_etale_section_vanishing_open Z P O k).2 O (𝟙 O) (fun v _ => hall v)
    have e3 : (P.obj.map (𝟙 O).op).hom k = k := by
      rw [op_id, P.obj.map_id]
      rfl
    rw [← e3]
    exact hv
  haveI : ∀ X, Mono (β.hom.app X) := by
    intro X
    rw [AddCommGrpCat.mono_iff_injective, injective_iff_map_eq_zero]
    intro a ha
    exact key X.unop a ha
  haveI : Mono β.hom := NatTrans.mono_of_mono_app β.hom
  exact Sheaf.Hom.mono_of_presheaf_mono _ _ β

theorem wc_hal_bc_lc_injective : ∀ (K : Type u) [Field K] (A : Type u) [CommRing A] (s : Spec (.of A) ⟶ Spec (.of K)) (Ω : Type u) [Field Ω] (z : Spec (.of Ω) ⟶ Spec (.of A)) (ℓ : ℕ) (W : (Spec (.of A)).Etale) (O : (wcHalA1 s).Etale) (h : O.left ⟶ W.left), h ≫ W.hom = O.hom ≫ wcHalA1Proj s → ∀ (d : LocallyConstant ↥(Limits.pullback W.hom z) (ZMod ℓ)) (κ : Limits.pullback O.hom (Limits.pullback.fst (wcHalA1Proj s) z) ⟶ Limits.pullback W.hom z), κ ≫ Limits.pullback.fst W.hom z = Limits.pullback.fst O.hom (Limits.pullback.fst (wcHalA1Proj s) z) ≫ h → κ ≫ Limits.pullback.snd W.hom z = Limits.pullback.snd O.hom (Limits.pullback.fst (wcHalA1Proj s) z) ≫ Limits.pullback.snd (wcHalA1Proj s) z → (∀ q, d (κ q) = 0) → ∃ (W₁ : (Spec (.of A)).Etale) (c : W₁ ⟶ W) (h₁ : O.left ⟶ W₁.left), h₁ ≫ c.left = h ∧ h₁ ≫ W₁.hom = O.hom ≫ wcHalA1Proj s ∧ ∀ (m : Limits.pullback W₁.hom z ⟶ Limits.pullback W.hom z), m ≫ Limits.pullback.fst W.hom z = Limits.pullback.fst W₁.hom z ≫ c.left → m ≫ Limits.pullback.snd W.hom z = Limits.pullback.snd W₁.hom z → ∀ q, d (m q) = 0 :=
by
  intro K _ A _ s Ω _ z ℓ W O h hh d κ hκ1 hκ2 hd
  haveI : Etale W.hom := W.prop
  haveI : Etale O.hom := O.prop

  have hπ : UniversallyOpen (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) := by
    haveI : Flat (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) :=
      HasRingHomProperty.Spec_iff.mpr (RingHom.flat_algebraMap_iff.mpr inferInstance)
    haveI : LocallyOfFinitePresentation
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) :=
      HasRingHomProperty.Spec_iff.mpr (RingHom.finitePresentation_algebraMap.mpr inferInstance)
    exact UniversallyOpen.of_flat _
  haveI hg : UniversallyOpen (wcHalA1Proj s) :=
    MorphismProperty.of_isPullback (P := @UniversallyOpen) (IsPullback.of_hasPullback s _).flip hπ
  haveI : UniversallyOpen (O.hom ≫ wcHalA1Proj s) := inferInstance

  let Γ : O.left ⟶ Limits.pullback (O.hom ≫ wcHalA1Proj s) W.hom :=
    Limits.pullback.lift (𝟙 _) h (by rw [Category.id_comp, hh])
  have hΓ1 : Γ ≫ Limits.pullback.fst (O.hom ≫ wcHalA1Proj s) W.hom = 𝟙 _ :=
    Limits.pullback.lift_fst _ _ _
  have hΓ2 : Γ ≫ Limits.pullback.snd (O.hom ≫ wcHalA1Proj s) W.hom = h :=
    Limits.pullback.lift_snd _ _ _
  haveI : Etale (Γ ≫ Limits.pullback.fst (O.hom ≫ wcHalA1Proj s) W.hom) := by
    rw [hΓ1]; infer_instance
  haveI : Etale Γ := Etale.of_comp Γ (Limits.pullback.fst (O.hom ≫ wcHalA1Proj s) W.hom)
  haveI : UniversallyOpen (Γ ≫ Limits.pullback.snd (O.hom ≫ wcHalA1Proj s) W.hom) :=
    inferInstance
  haveI hhuo : UniversallyOpen h := by rw [← hΓ2]; infer_instance
  have hopen : IsOpen (Set.range h) := h.isOpenMap.isOpen_range

  let U : W.left.Opens := ⟨Set.range h, hopen⟩
  let W₁ : (Spec (.of A)).Etale := Scheme.Etale.mk (U.ι ≫ W.hom)
  let c : W₁ ⟶ W := MorphismProperty.Over.homMk U.ι
  have hsub : Set.range h ⊆ Set.range U.ι := by
    rw [Scheme.Opens.range_ι]
    exact fun x hx => hx
  let h₁ : O.left ⟶ U.toScheme := IsOpenImmersion.lift U.ι h hsub
  have hfac : h₁ ≫ U.ι = h := IsOpenImmersion.lift_fac _ _ _
  refine ⟨W₁, c, h₁, hfac, ?_, ?_⟩
  · show h₁ ≫ U.ι ≫ W.hom = _
    rw [← Category.assoc, hfac, hh]
  · intro m hm1 _ q
    have hP : IsPullback (Limits.pullback.fst O.hom (Limits.pullback.fst (wcHalA1Proj s) z)) κ h
        (Limits.pullback.fst W.hom z) := by
      have big := (IsPullback.of_hasPullback O.hom
        (Limits.pullback.fst (wcHalA1Proj s) z)).flip.paste_horiz
          (IsPullback.of_hasPullback (wcHalA1Proj s) z).flip
      rw [← hκ2, ← hh] at big
      exact (IsPullback.of_right big hκ1 (IsPullback.of_hasPullback W.hom z).flip).flip
    have hmem : Limits.pullback.fst W.hom z (m q) ∈ Set.range h := by
      have e1 : Limits.pullback.fst W.hom z (m q) = U.ι (Limits.pullback.fst W₁.hom z q) := by
        rw [← Scheme.Hom.comp_apply, hm1, Scheme.Hom.comp_apply]
        rfl
      rw [e1]
      have h2 := Set.mem_range_self (f := U.ι) (Limits.pullback.fst W₁.hom z q)
      rwa [Scheme.Opens.range_ι] at h2
    obtain ⟨o, ho⟩ := hmem
    obtain ⟨q', -, hq'⟩ := Scheme.exists_preimage_of_isPullback hP o (m q) ho
    rw [← hq']
    exact hd q'

theorem wc_shdata_normalized_residue : ∀ {Y : Scheme.{u}} (y : Y) (B0 : Type u) [CommRing B0] [IsLocalRing B0] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of B0) ⟶ (W'.obj l).right.left) (a0 : Spec (.of B0) ⟶ Y), wcHalShData y B0 Λ W' φ a0 → ∃ e' : IsLocalRing.ResidueField B0 →+* AlgebraicClosure (Y.residueField y), ∀ l, Spec.map (CommRingCat.ofHom e') ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue B0)) ≫ φ l = (W'.obj l).hom.left :=
by
  intro Y y B0 _ _ Λ _ _ W' φ a0 hd
  have hd' := hd
  obtain ⟨hinit, haff, hcomp, hφa, hlim, e, -, he⟩ := hd'

  have s3 : ∀ l, φ l (IsLocalRing.closedPoint B0) =
      (W'.obj l).hom.left (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))) := by
    intro l
    have hEt : Etale (W'.obj l).right.hom := (W'.obj l).right.prop
    have hgeom : ∀ z, wcEtGeomPt Y y z = y := by
      intro z
      rw [wcEtGeomPt, Scheme.Hom.comp_apply]
      exact Scheme.fromSpecResidueField_apply y _
    have hres : ∀ z, (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B0))) z =
        IsLocalRing.closedPoint B0 :=
      fun z => IsLocalRing.PrimeSpectrum.comap_residue B0 z
    have ha : a0 (IsLocalRing.closedPoint B0) = y := by
      have h1 := congrArg (fun f => f (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))) he
      have h1' := (Scheme.Hom.comp_apply _ _ _).symm.trans
        ((Scheme.Hom.comp_apply _ _ _).symm.trans (h1.trans (hgeom _)))
      rw [hres] at h1'
      exact h1'
    have h2 : (W'.obj l).right.hom (φ l (IsLocalRing.closedPoint B0)) = y :=
      (Scheme.Hom.comp_apply _ _ _).symm.trans
        ((congrArg (fun f => f (IsLocalRing.closedPoint B0)) (hφa l)).trans ha)
    have h3 : (W'.obj l).right.hom ((W'.obj l).hom.left
        (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))) = y :=
      (Scheme.Hom.comp_apply _ _ _).symm.trans
        ((congrArg (fun f => f (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))))
          (Over.w (W'.obj l).hom)).trans (hgeom _))
    have hisoGen : ∀ {V S : Scheme.{u}} (f : V ⟶ S) [Etale f] (v : V),
        ∃ U : V.Opens, v ∈ U ∧ ∀ w ∈ U, f w = f v → w = v := by
      intro V S f _ v
      haveI hlqf : LocallyQuasiFinite f := by
        rw [HasRingHomProperty.iff_appLE (P := @LocallyQuasiFinite)]
        intro U W e
        have h := HasRingHomProperty.appLE @Etale f ‹Etale f› U W e
        letI := (f.appLE U W e).hom.toAlgebra
        haveI : Algebra.Etale _ _ := RingHom.Etale.toAlgebra h
        exact RingHom.quasiFinite_algebraMap.mpr inferInstance
      haveI hd : DiscreteTopology ↑(f ⁻¹' {f v}) := (f.fiberHomeo (f v)).discreteTopology
      have hv : f v ∈ ({f v} : Set S) := Set.mem_singleton _
      have hopen : IsOpen ({⟨v, hv⟩} : Set ↑(f ⁻¹' {f v})) := isOpen_discrete _
      obtain ⟨t, ht, hteq⟩ := isOpen_induced_iff.mp hopen
      refine ⟨⟨t, ht⟩, ?_, ?_⟩
      · have : (⟨v, hv⟩ : ↑(f ⁻¹' {f v})) ∈ Subtype.val ⁻¹' t := by
          rw [hteq]; exact Set.mem_singleton _
        exact this
      · intro w hwU hw
        have hw' : w ∈ f ⁻¹' {f v} := by
          simp only [Set.mem_preimage, Set.mem_singleton_iff]; exact hw
        have : (⟨w, hw'⟩ : ↑(f ⁻¹' {f v})) ∈ Subtype.val ⁻¹' t := hwU
        rw [hteq, Set.mem_singleton_iff] at this
        exact congrArg Subtype.val this
    obtain ⟨O, hwO, hiso⟩ := hisoGen (W'.obj l).right.hom
      ((W'.obj l).hom.left (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))))
    have hr : Set.range (W'.obj l).hom.left ⊆ Set.range O.ι := by
      rintro _ ⟨z, rfl⟩
      have hz : z = IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)) :=
        Subsingleton.elim (α := PrimeSpectrum (AlgebraicClosure (Y.residueField y))) _ _
      subst hz
      exact (Set.ext_iff.mp (Scheme.Opens.range_ι O) _).mpr hwO
    let lam := IsOpenImmersion.lift O.ι (W'.obj l).hom.left hr
    have hlam : lam ≫ O.ι = (W'.obj l).hom.left := IsOpenImmersion.lift_fac _ _ _
    let R : Y.Etale := Scheme.Etale.mk (O.ι ≫ (W'.obj l).right.hom)
    have hlamR : lam ≫ ((Scheme.Etale.forget Y).obj R).hom = (Over.mk (wcEtGeomPt Y y)).hom := by
      show lam ≫ O.ι ≫ (W'.obj l).right.hom = wcEtGeomPt Y y
      rw [← Category.assoc, hlam]
      exact Over.w (W'.obj l).hom
    let d : StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y) :=
      StructuredArrow.mk (Y := R) (Over.homMk lam hlamR)
    let iR : R ⟶ (W'.obj l).right := MorphismProperty.Over.homMk O.ι rfl trivial
    let i : d ⟶ W'.obj l := StructuredArrow.homMk iR (by
      apply Over.OverMorphism.ext
      exact hlam)
    obtain ⟨hI1, hI2⟩ := (Functor.initial_iff_of_isCofiltered W').mp hinit
    obtain ⟨l₁, ⟨g₁⟩⟩ := hI1 d
    obtain ⟨l₃, t', ht'⟩ := hI2 (W'.map (IsCofiltered.minToLeft l₁ l) ≫ g₁ ≫ i)
      (W'.map (IsCofiltered.minToRight l₁ l))
    have hg : (W'.map t' ≫ W'.map (IsCofiltered.minToLeft l₁ l) ≫ g₁) ≫ i =
        W'.map (t' ≫ IsCofiltered.minToRight l₁ l) := by
      rw [Functor.map_comp, Category.assoc, Category.assoc]
      exact ht'
    have hg' : (W'.map t' ≫ W'.map (IsCofiltered.minToLeft l₁ l) ≫ g₁).right.left ≫ O.ι =
        (W'.map (t' ≫ IsCofiltered.minToRight l₁ l)).right.left :=
      congrArg (fun k => k.right.left) hg
    have e1 : φ l = φ l₃ ≫ (W'.map t' ≫ W'.map (IsCofiltered.minToLeft l₁ l) ≫ g₁).right.left ≫ O.ι := by
      rw [hg', hcomp]
    have hmem : φ l (IsLocalRing.closedPoint B0) ∈ O := by
      have h4 : φ l (IsLocalRing.closedPoint B0) = O.ι
          ((W'.map t' ≫ W'.map (IsCofiltered.minToLeft l₁ l) ≫ g₁).right.left
            (φ l₃ (IsLocalRing.closedPoint B0))) :=
        (congrArg (fun f => f (IsLocalRing.closedPoint B0)) e1).trans
          ((Scheme.Hom.comp_apply _ _ _).trans (Scheme.Hom.comp_apply _ _ _))
      rw [h4]
      exact (Set.ext_iff.mp (Scheme.Opens.range_ι O) _).mp (Set.mem_range_self _)
    exact hiso _ hmem (h2.trans h3.symm)

  have hv : ∀ {l l' : Λ} (t : l ⟶ l'),
      (W'.obj l).hom.left ≫ (W'.map t).right.left = (W'.obj l').hom.left := fun t =>
    congrArg (fun f => f.left) (StructuredArrow.w (W'.map t))
  obtain ⟨q, hq, -⟩ := hlim _ (fun l => (W'.obj l).hom.left) hv

  have s1 : ∀ (G : Λ ⥤ Scheme.{u}) (X : Scheme.{u}) [IsAffine X] (ψ : ∀ l, X ⟶ G.obj l),
      (∀ l, IsAffine (G.obj l)) → (∀ {l l' : Λ} (t : l ⟶ l'), ψ l ≫ G.map t = ψ l') →
      (∀ (T : Scheme.{u}) (zz : ∀ l, T ⟶ G.obj l),
        (∀ {l l' : Λ} (t : l ⟶ l'), zz l ≫ G.map t = zz l') → ∃! z₀ : T ⟶ X, ∀ l, z₀ ≫ ψ l = zz l) →
      ∀ f : Γ(X, ⊤), ∃ (l : Λ) (g : Γ(G.obj l, ⊤)), (ψ l).appTop g = f := by
    intro G X _ ψ hGa hψ hlim f
    let F : Λᵒᵖ ⥤ CommRingCat.{u} := G.op ⋙ Scheme.Γ
    have hnat : ∀ (i j : Λᵒᵖ) (f : i ⟶ j), F.map f ≫ (ψ j.unop).appTop = (ψ i.unop).appTop := by
      intro i j f
      rw [← hψ f.unop, Scheme.Hom.comp_appTop]
      rfl
    let c : Limits.Cocone F :=
      { pt := Γ(X, ⊤)
        ι := { app := fun l => (ψ l.unop).appTop
               naturality := fun i j f => by
                 erw [Category.comp_id]
                 exact hnat i j f } }
    let κ : Limits.colimit F ⟶ Γ(X, ⊤) := Limits.colimit.desc F c
    let ι' : ∀ l : Λ, Γ(G.obj l, ⊤) ⟶ Limits.colimit F := fun l =>
      Limits.colimit.ι F (Opposite.op l)
    have hκ : ∀ l : Λ, ι' l ≫ κ = (ψ l).appTop := fun l => Limits.colimit.ι_desc c (Opposite.op l)
    have hιw : ∀ {l l' : Λ} (t : l ⟶ l'), (G.map t).appTop ≫ ι' l = ι' l' := fun t =>
      Limits.colimit.w F t.op
    let ψ' : ∀ l, Spec (Limits.colimit F) ⟶ G.obj l := fun l =>
      Spec.map (ι' l) ≫ (G.obj l).isoSpec.inv
    have hψ' : ∀ {l l' : Λ} (t : l ⟶ l'), ψ' l ≫ G.map t = ψ' l' := by
      intro l l' t
      simp only [ψ']
      rw [Category.assoc, ← Scheme.isoSpec_inv_naturality, ← Category.assoc, ← Spec.map_comp,
        hιw t]
    obtain ⟨z₀, hz₀, -⟩ := hlim _ ψ' hψ'
    obtain ⟨w, -, hwu⟩ := hlim X ψ hψ
    let ρ : X ⟶ Spec (Limits.colimit F) := X.isoSpec.hom ≫ Spec.map κ
    have hρ : ρ ≫ z₀ = 𝟙 X := by
      have e1 : ρ ≫ z₀ = w := hwu _ (fun l => by
        rw [Category.assoc, hz₀]
        simp only [ρ, ψ', Category.assoc]
        rw [← Category.assoc (Spec.map κ), ← Spec.map_comp, hκ l,
          Scheme.isoSpec_inv_naturality, Iso.hom_inv_id_assoc])
      have e2 : 𝟙 X = w := hwu _ (fun l => Category.id_comp _)
      rw [e1, e2]
    have h2 : Spec.map κ ≫ (z₀ ≫ X.isoSpec.hom) = 𝟙 _ := by
      have : Spec.map κ ≫ z₀ = X.isoSpec.inv := by
        rw [← Iso.hom_comp_eq_id, ← Category.assoc]
        exact hρ
      rw [← Category.assoc, this, Iso.inv_hom_id]
    let ζ : Γ(X, ⊤) ⟶ Limits.colimit F := Spec.preimage (z₀ ≫ X.isoSpec.hom)
    have hζκ : ζ ≫ κ = 𝟙 _ := by
      apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_preimage, h2, Spec.map_id]
    obtain ⟨j, g, hg⟩ := Limits.Concrete.colimit_exists_rep F (ζ f)
    refine ⟨j.unop, g, ?_⟩
    have e3 : κ (ζ f) = f := by
      show (ζ ≫ κ) f = f
      rw [hζκ]
      rfl
    have e4 : (ψ j.unop).appTop g = κ (ι' j.unop g) := by
      rw [← hκ j.unop]
      rfl
    rw [e4, ← e3, ← hg]
    rfl

  let G : Λ ⥤ Scheme.{u} :=
    { obj := fun l => (W'.obj l).right.left
      map := fun t => (W'.map t).right.left
      map_id := fun l => by rw [W'.map_id]; rfl
      map_comp := fun t₁ t₂ => by rw [W'.map_comp]; rfl }
  have hrep := s1 G (Spec (.of B0)) φ haff hcomp hlim
  have s2 : ∀ n₁ n₂ : Spec (.of B0), (∀ l, φ l n₁ = φ l n₂) → n₁ = n₂ := by
    intro n₁ n₂ hn
    have key : ∀ f : Γ(Spec (.of B0), ⊤),
        n₁ ∈ (Spec (.of B0)).basicOpen f → n₂ ∈ (Spec (.of B0)).basicOpen f := by
      intro f hf
      obtain ⟨l, g, hg⟩ := hrep f
      rw [← hg, ← Scheme.Hom.preimage_basicOpen_top] at hf ⊢
      rw [Scheme.Hom.mem_preimage] at hf ⊢
      exact (hn l) ▸ hf
    have key' : ∀ f : Γ(Spec (.of B0), ⊤),
        n₂ ∈ (Spec (.of B0)).basicOpen f → n₁ ∈ (Spec (.of B0)).basicOpen f := by
      intro f hf
      obtain ⟨l, g, hg⟩ := hrep f
      rw [← hg, ← Scheme.Hom.preimage_basicOpen_top] at hf ⊢
      rw [Scheme.Hom.mem_preimage] at hf ⊢
      exact (hn l).symm ▸ hf
    have hb : ∀ {U : TopologicalSpace.Opens (Spec (.of B0))} {x : Spec (.of B0)}, x ∈ U →
        ∃ U' ∈ Set.range (Spec (.of B0)).basicOpen, x ∈ U' ∧ U' ≤ U :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd).mp (isBasis_basicOpen (Spec (.of B0)))
    apply Inseparable.eq
    rw [inseparable_iff_forall_isOpen]
    intro s hs
    constructor
    · intro h1
      obtain ⟨U', ⟨f, rfl⟩, hU1, hU2⟩ := @hb ⟨s, hs⟩ n₁ h1
      exact (show ((Spec (.of B0)).basicOpen f : Set (Spec (.of B0))) ⊆ s from hU2) (key f hU1)
    · intro h1
      obtain ⟨U', ⟨f, rfl⟩, hU1, hU2⟩ := @hb ⟨s, hs⟩ n₂ h1
      exact (show ((Spec (.of B0)).basicOpen f : Set (Spec (.of B0))) ⊆ s from hU2) (key' f hU1)
  have hpt : q (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))) =
      IsLocalRing.closedPoint B0 := by
    apply s2
    intro l
    exact (Scheme.Hom.comp_apply q (φ l) _).symm.trans
      ((congrArg (fun f => f (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))))
        (hq l)).trans (s3 l).symm)

  let ψ : CommRingCat.of B0 ⟶ CommRingCat.of (AlgebraicClosure (Y.residueField y)) :=
    Spec.preimage q
  have hψ : Spec.map ψ = q := Spec.map_preimage q
  haveI : IsLocalHom ψ.hom := by
    rw [IsLocalRing.isLocalHom_iff_comap_closedPoint]
    exact (Spec.map_apply ψ _).symm.trans
      ((congrArg (fun f => f (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))) hψ).trans
        hpt)
  let e' : IsLocalRing.ResidueField B0 →+* AlgebraicClosure (Y.residueField y) :=
    IsLocalRing.ResidueField.lift ψ.hom
  have he' : e'.comp (IsLocalRing.residue B0) = ψ.hom :=
    IsLocalRing.ResidueField.lift_comp_residue ψ.hom
  have hq' : Spec.map (CommRingCat.ofHom e') ≫
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue B0)) = q := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, he', CommRingCat.ofHom_hom, hψ]
  refine ⟨e', fun l => ?_⟩
  rw [← Category.assoc, hq']
  exact hq l

theorem wc_shens_geom_fibre_vnr_algclosed : ∀ (A : Type u) [CommRing A] (y : Spec (.of A)) (A' : Type u) [CommRing A'] [IsLocalRing A'] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of A)) y)) (Scheme.Etale.forget (Spec (.of A)))) (φ : ∀ l, Spec (.of A') ⟶ (W'.obj l).right.left) (b : Spec (.of A') ⟶ Spec (.of A)), wcHalShData y A' Λ W' φ b → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A)), (∀ f : Γ(Limits.pullback b z, ⊤), ∃ t : Γ(Limits.pullback b z, ⊤), f * f * t = f) ∧ ∀ p : ↥(Limits.pullback b z), IsAlgClosed ((Limits.pullback b z).residueField p) :=
by
  intro A _ y A' _ _ Λ _ _ W' φ b hd Ω _ _ z
  obtain ⟨-, haff, hcomp, hφb, hlim, -⟩ := hd

  have s1 : ∀ (G : Λ ⥤ Scheme.{u}) (X : Scheme.{u}) [IsAffine X] (ψ : ∀ l, X ⟶ G.obj l),
      (∀ l, IsAffine (G.obj l)) → (∀ {l l' : Λ} (t : l ⟶ l'), ψ l ≫ G.map t = ψ l') →
      (∀ (T : Scheme.{u}) (zz : ∀ l, T ⟶ G.obj l),
        (∀ {l l' : Λ} (t : l ⟶ l'), zz l ≫ G.map t = zz l') → ∃! z₀ : T ⟶ X, ∀ l, z₀ ≫ ψ l = zz l) →
      ∀ f : Γ(X, ⊤), ∃ (l : Λ) (g : Γ(G.obj l, ⊤)), (ψ l).appTop g = f := by
    intro G X _ ψ hGa hψ hlim f
    let F : Λᵒᵖ ⥤ CommRingCat.{u} := G.op ⋙ Scheme.Γ
    have hnat : ∀ (i j : Λᵒᵖ) (f : i ⟶ j), F.map f ≫ (ψ j.unop).appTop = (ψ i.unop).appTop := by
      intro i j f
      rw [← hψ f.unop, Scheme.Hom.comp_appTop]
      rfl
    let c : Limits.Cocone F :=
      { pt := Γ(X, ⊤)
        ι := { app := fun l => (ψ l.unop).appTop
               naturality := fun i j f => by
                 erw [Category.comp_id]
                 exact hnat i j f } }
    let κ : Limits.colimit F ⟶ Γ(X, ⊤) := Limits.colimit.desc F c
    let ι' : ∀ l : Λ, Γ(G.obj l, ⊤) ⟶ Limits.colimit F := fun l =>
      Limits.colimit.ι F (Opposite.op l)
    have hκ : ∀ l : Λ, ι' l ≫ κ = (ψ l).appTop := fun l => Limits.colimit.ι_desc c (Opposite.op l)
    have hιw : ∀ {l l' : Λ} (t : l ⟶ l'), (G.map t).appTop ≫ ι' l = ι' l' := fun t =>
      Limits.colimit.w F t.op
    let ψ' : ∀ l, Spec (Limits.colimit F) ⟶ G.obj l := fun l =>
      Spec.map (ι' l) ≫ (G.obj l).isoSpec.inv
    have hψ' : ∀ {l l' : Λ} (t : l ⟶ l'), ψ' l ≫ G.map t = ψ' l' := by
      intro l l' t
      simp only [ψ']
      rw [Category.assoc, ← Scheme.isoSpec_inv_naturality, ← Category.assoc, ← Spec.map_comp,
        hιw t]
    obtain ⟨z₀, hz₀, -⟩ := hlim _ ψ' hψ'
    obtain ⟨w, -, hwu⟩ := hlim X ψ hψ
    let ρ : X ⟶ Spec (Limits.colimit F) := X.isoSpec.hom ≫ Spec.map κ
    have hρ : ρ ≫ z₀ = 𝟙 X := by
      have e1 : ρ ≫ z₀ = w := hwu _ (fun l => by
        rw [Category.assoc, hz₀]
        simp only [ρ, ψ', Category.assoc]
        rw [← Category.assoc (Spec.map κ), ← Spec.map_comp, hκ l,
          Scheme.isoSpec_inv_naturality, Iso.hom_inv_id_assoc])
      have e2 : 𝟙 X = w := hwu _ (fun l => Category.id_comp _)
      rw [e1, e2]
    have h2 : Spec.map κ ≫ (z₀ ≫ X.isoSpec.hom) = 𝟙 _ := by
      have : Spec.map κ ≫ z₀ = X.isoSpec.inv := by
        rw [← Iso.hom_comp_eq_id, ← Category.assoc]
        exact hρ
      rw [← Category.assoc, this, Iso.inv_hom_id]
    let ζ : Γ(X, ⊤) ⟶ Limits.colimit F := Spec.preimage (z₀ ≫ X.isoSpec.hom)
    have hζκ : ζ ≫ κ = 𝟙 _ := by
      apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_preimage, h2, Spec.map_id]
    obtain ⟨j, g, hg⟩ := Limits.Concrete.colimit_exists_rep F (ζ f)
    refine ⟨j.unop, g, ?_⟩
    have e3 : κ (ζ f) = f := by
      show (ζ ≫ κ) f = f
      rw [hζκ]
      rfl
    have e4 : (ψ j.unop).appTop g = κ (ι' j.unop g) := by
      rw [← hκ j.unop]
      rfl
    rw [e4, ← e3, ← hg]
    rfl

  have s3 : ∀ (E : Scheme.{u}) [IsAffine E] (s : E ⟶ Spec (.of Ω)), Etale s → ∀ g : Γ(E, ⊤),
      (∃ t : Γ(E, ⊤), g * g * t = g) ∧
        ((Scheme.ΓSpecIso (.of Ω)).inv ≫ s.appTop).hom.IsIntegralElem g := by
    intro E _ s hs g
    have h1 : (s.appTop).hom.Etale := (HasRingHomProperty.iff_of_isAffine (P := @Etale)).mp hs
    have h2 : ((Scheme.ΓSpecIso (.of Ω)).inv).hom.Etale :=
      RingHom.Etale.of_bijective (ConcreteCategory.bijective_of_isIso _)
    have h3 : ((Scheme.ΓSpecIso (.of Ω)).inv ≫ s.appTop).hom.Etale := by
      rw [CommRingCat.hom_comp]
      exact RingHom.Etale.stableUnderComposition _ _ h2 h1
    letI := ((Scheme.ΓSpecIso (.of Ω)).inv ≫ s.appTop).hom.toAlgebra
    have hE : Algebra.Etale Ω Γ(E, ⊤) := RingHom.Etale.toAlgebra h3
    obtain ⟨I, _, Ai, _, _, e, hfin⟩ := (Algebra.Etale.iff_exists_algEquiv_prod Ω Γ(E, ⊤)).mp hE
    refine ⟨⟨e.symm (fun i => (e g i)⁻¹), ?_⟩, ?_⟩
    · apply e.injective
      rw [map_mul, map_mul, AlgEquiv.apply_symm_apply]
      funext i
      simp only [Pi.mul_apply]
      exact mul_self_mul_inv _
    · haveI : ∀ i, Module.Finite Ω (Ai i) := fun i => (hfin i).1
      haveI : Module.Finite Ω (∀ i, Ai i) := Module.Finite.pi
      haveI : Module.Finite Ω Γ(E, ⊤) := Module.Finite.equiv e.symm.toLinearEquiv
      haveI : Algebra.IsIntegral Ω Γ(E, ⊤) := Algebra.IsIntegral.of_finite _ _
      exact Algebra.IsIntegral.isIntegral g

  have s4 : ∀ (X : Scheme.{u}) [IsAffine X] (χ : Ω →+* Γ(X, ⊤)),
      (∀ f : Γ(X, ⊤), χ.IsIntegralElem f) → ∀ p : X, IsAlgClosed (X.residueField p) := by
    intro X _ χ hχ p
    let ε : Γ(X, ⊤) →+* X.residueField p := (X.evaluation ⊤ p trivial).hom
    letI : Algebra Ω (X.residueField p) := (ε.comp χ).toAlgebra
    have hint : ∀ c : Γ(X, ⊤), IsIntegral Ω (ε c) := fun c => (hχ c).map ε
    have hfrac : ∀ x : X.residueField p, ∃ a m : Γ(X, ⊤), IsUnit (ε m) ∧ x * ε m = ε a := by
      intro x
      obtain ⟨s, rfl⟩ := X.residue_surjective p x
      letI := TopCat.Presheaf.algebra_section_stalk X.presheaf (U := ⊤) ⟨p, trivial⟩
      haveI := (isAffineOpen_top X).isLocalization_stalk ⟨p, trivial⟩
      obtain ⟨⟨a, m⟩, rfl⟩ := IsLocalization.mk'_surjective
        ((isAffineOpen_top X).primeIdealOf ⟨p, trivial⟩).asIdeal.primeCompl s
      have hgr : ∀ c : Γ(X, ⊤), (X.residue p).hom ((X.presheaf.germ ⊤ p trivial).hom c) = ε c := by
        intro c
        show _ = (X.evaluation ⊤ p trivial).hom c
        rw [← X.germ_residue (U := ⊤) p trivial, CommRingCat.hom_comp]
        rfl
      refine ⟨a, m, ?_, ?_⟩
      · rw [← hgr]
        exact (IsLocalization.map_units (X.presheaf.stalk p) m).map (X.residue p).hom
      · rw [← hgr, ← hgr, ← map_mul]
        congr 1
        exact IsLocalization.mk'_spec (X.presheaf.stalk p) a m
    haveI : Algebra.IsIntegral Ω (X.residueField p) := by
      constructor
      intro x
      obtain ⟨a, m, hu, hx⟩ := hfrac x
      have hne : ε m ≠ 0 := hu.ne_zero
      have : x = ε a * (ε m)⁻¹ := by
        rw [eq_mul_inv_iff_mul_eq₀ hne]
        exact hx
      rw [this]
      exact (hint a).mul (hint m).inv
    have hbij := IsAlgClosed.algebraMap_bijective_of_isIntegral (k := Ω) (K := X.residueField p)
    exact IsAlgClosed.of_ringEquiv Ω _ (RingEquiv.ofBijective _ hbij)

  have hw : ∀ {l l' : Λ} (t : l ⟶ l'),
      (W'.map t).right.left ≫ (W'.obj l').right.hom = (W'.obj l).right.hom := by
    intro l l' t
    have := (W'.map t).right.w
    simpa using this
  let h : ∀ l, (W'.obj l).right.left ⟶ Spec (.of A) := fun l => (W'.obj l).right.hom
  let mp : ∀ {l l' : Λ} (t : l ⟶ l'), Limits.pullback (h l) z ⟶ Limits.pullback (h l') z :=
    fun t =>
    Limits.pullback.lift (Limits.pullback.fst _ _ ≫ (W'.map t).right.left)
      (Limits.pullback.snd _ _)
      (by rw [Category.assoc, hw t]; exact Limits.pullback.condition)
  have mp_fst : ∀ {l l' : Λ} (t : l ⟶ l'),
      mp t ≫ Limits.pullback.fst _ _ = Limits.pullback.fst _ _ ≫ (W'.map t).right.left :=
    fun t => Limits.pullback.lift_fst _ _ _
  have mp_snd : ∀ {l l' : Λ} (t : l ⟶ l'),
      mp t ≫ Limits.pullback.snd _ _ = Limits.pullback.snd _ _ := fun t =>
    Limits.pullback.lift_snd _ _ _
  let G : Λ ⥤ Scheme.{u} :=
    { obj := fun l => Limits.pullback (h l) z
      map := fun t => mp t
      map_id := fun l => by
        apply Limits.pullback.hom_ext
        · rw [mp_fst, Category.id_comp, W'.map_id]
          rfl
        · rw [mp_snd, Category.id_comp]
      map_comp := fun {l₁ l₂ l₃} t₁ t₂ => by
        apply Limits.pullback.hom_ext
        · rw [mp_fst, Category.assoc, mp_fst, ← Category.assoc, mp_fst, Category.assoc,
            W'.map_comp]
          rfl
        · rw [mp_snd, Category.assoc, mp_snd, mp_snd] }
  have Gmap_fst : ∀ {l l' : Λ} (t : l ⟶ l'),
      G.map t ≫ Limits.pullback.fst (h l') z =
        Limits.pullback.fst (h l) z ≫ (W'.map t).right.left := mp_fst
  have Gmap_snd : ∀ {l l' : Λ} (t : l ⟶ l'),
      G.map t ≫ Limits.pullback.snd (h l') z = Limits.pullback.snd (h l) z := mp_snd
  let ψ : ∀ l, Limits.pullback b z ⟶ G.obj l := fun l =>
    Limits.pullback.lift (Limits.pullback.fst b z ≫ φ l) (Limits.pullback.snd b z)
      (by rw [Category.assoc]; erw [hφb l]; exact Limits.pullback.condition)
  have ψ_fst : ∀ l, ψ l ≫ Limits.pullback.fst (h l) z = Limits.pullback.fst b z ≫ φ l :=
    fun l => Limits.pullback.lift_fst _ _ _
  have ψ_snd : ∀ l, ψ l ≫ Limits.pullback.snd (h l) z = Limits.pullback.snd b z := fun l =>
    Limits.pullback.lift_snd _ _ _
  let sG : ∀ l, G.obj l ⟶ Spec (.of Ω) := fun l => Limits.pullback.snd (h l) z
  have hGaff : ∀ l, IsAffine (G.obj l) := by
    intro l
    haveI := haff l
    show IsAffine (Limits.pullback (h l) z)
    infer_instance
  have hGet : ∀ l, Etale (sG l) := by
    intro l
    haveI : Etale (h l) := (W'.obj l).right.prop
    show Etale (Limits.pullback.snd (h l) z)
    infer_instance
  have hψc : ∀ {l l' : Λ} (t : l ⟶ l'), ψ l ≫ G.map t = ψ l' := by
    intro l l' t
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Gmap_fst, ← Category.assoc, ψ_fst, Category.assoc, hcomp, ψ_fst]
    · rw [Category.assoc, Gmap_snd, ψ_snd, ψ_snd]
  have hψlim : ∀ (T : Scheme.{u}) (zz : ∀ l, T ⟶ G.obj l),
      (∀ {l l' : Λ} (t : l ⟶ l'), zz l ≫ G.map t = zz l') →
        ∃! z₀ : T ⟶ Limits.pullback b z, ∀ l, z₀ ≫ ψ l = zz l := by
    intro T zz hzz
    obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
    have hsnd1 : ∀ {l l' : Λ} (t : l ⟶ l'),
        zz l ≫ Limits.pullback.snd (h l) z = zz l' ≫ Limits.pullback.snd (h l') z := by
      intro l l' t
      rw [← hzz t, Category.assoc, Gmap_snd]
    have hsnd : ∀ l l' : Λ,
        zz l ≫ Limits.pullback.snd (h l) z = zz l' ≫ Limits.pullback.snd (h l') z := by
      intro l l'
      rw [← hsnd1 (IsCofiltered.minToLeft l l'), hsnd1 (IsCofiltered.minToRight l l')]
    let v : T ⟶ Spec (.of Ω) := zz l₀ ≫ Limits.pullback.snd (h l₀) z
    have hzz' : ∀ {l l' : Λ} (t : l ⟶ l'),
        (zz l ≫ Limits.pullback.fst (h l) z) ≫ (W'.map t).right.left =
          zz l' ≫ Limits.pullback.fst (h l') z := by
      intro l l' t
      rw [← hzz t, Category.assoc, Category.assoc, Gmap_fst]
    obtain ⟨w, hw1, hw2⟩ := hlim T (fun l => zz l ≫ Limits.pullback.fst (h l) z) hzz'
    have hwb : w ≫ b = v ≫ z := by
      rw [← hφb l₀, ← Category.assoc, hw1 l₀]
      simp only [v, Category.assoc]
      exact congrArg (zz l₀ ≫ ·) Limits.pullback.condition
    refine ⟨Limits.pullback.lift w v hwb, fun l => ?_, fun z₁ hz₁ => ?_⟩
    · apply Limits.pullback.hom_ext
      · rw [Category.assoc, ψ_fst, ← Category.assoc, Limits.pullback.lift_fst, hw1]
      · rw [Category.assoc, ψ_snd, Limits.pullback.lift_snd]
        exact hsnd l₀ l
    · apply Limits.pullback.hom_ext
      · rw [Limits.pullback.lift_fst]
        apply hw2
        intro l
        rw [Category.assoc, ← ψ_fst, ← Category.assoc, hz₁ l]
      · rw [Limits.pullback.lift_snd, ← ψ_snd l₀, ← Category.assoc, hz₁ l₀]

  have hrep := s1 G (Limits.pullback b z) ψ hGaff hψc hψlim
  refine ⟨fun f => ?_, fun p => ?_⟩
  · obtain ⟨l, g, hg⟩ := hrep f
    haveI := hGaff l
    obtain ⟨⟨t₀, ht₀⟩, -⟩ := s3 (G.obj l) (sG l) (hGet l) g
    refine ⟨(ψ l).appTop t₀, ?_⟩
    rw [← hg, ← map_mul, ← map_mul, ht₀]
  · apply s4 (Limits.pullback b z)
      ((Scheme.ΓSpecIso (.of Ω)).inv ≫ (Limits.pullback.snd b z).appTop).hom
    intro f
    obtain ⟨l, g, hg⟩ := hrep f
    haveI := hGaff l
    have hint := (s3 (G.obj l) (sG l) (hGet l) g).2
    have hmap := hint.map ((ψ l).appTop.hom)
    rw [← CommRingCat.hom_comp, Category.assoc, ← Scheme.Hom.comp_appTop] at hmap
    have e5 : ψ l ≫ sG l = Limits.pullback.snd b z := ψ_snd l
    rw [e5] at hmap
    rw [← hg]
    exact hmap

