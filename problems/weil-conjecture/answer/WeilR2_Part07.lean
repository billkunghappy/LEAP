    have h := HasRingHomProperty.appLE (P := @Etale) p hpe ⟨_, hV⟩ ⟨_, hV'⟩ le_rfl
    rw [Scheme.Hom.appLE_eq_app] at h
    exact RingHom.etale_algebraMap.mp h
  have key : Module.Finite Γ(X, W) (integralClosure Γ(X, W) Γ(P, p ⁻¹ᵁ (Limits.pullback.fst f
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))) ⁻¹ᵁ W))) :=
