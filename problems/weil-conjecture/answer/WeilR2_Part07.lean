        l.left ≫ Limits.pullback.fst V.hom g = Limits.pullback.fst O.hom g' ≫ k := by
    intro A' B' W' f g g' hg V O k hk
    have w : (Limits.pullback.fst O.hom g' ≫ k) ≫ V.hom = Limits.pullback.snd O.hom g' ≫ g := by
      rw [Category.assoc, hk, ← Category.assoc, Limits.pullback.condition, Category.assoc, hg]
    exact ⟨MorphismProperty.Over.homMk (Limits.pullback.lift _ _ w) (Limits.pullback.lift_snd _ _ _)
      trivial, Limits.pullback.lift_fst _ _ _⟩
  have hBC : ∀ {B' W' : Scheme.{u}} (g : W' ⟶ B') {V V' : B'.Etale} (c : V' ⟶ V),
      ((wcEtBaseChange g).map c).left ≫ Limits.pullback.fst V.hom g =
        Limits.pullback.fst V'.hom g ≫ c.left := by
    intro B' W' g V V' c
    have h0 : (Limits.pullback.fst V'.hom g ≫ c.left) ≫ V.hom = Limits.pullback.snd V'.hom g ≫ g := by
      rw [Category.assoc, MorphismProperty.Over.w c]
      exact Limits.pullback.condition
    have hmap : ((wcEtBaseChange g).map c).left = Limits.pullback.lift
        (Limits.pullback.fst V'.hom g ≫ c.left) (Limits.pullback.snd V'.hom g) h0 := rfl
    exact (congrArg (· ≫ Limits.pullback.fst V.hom g) hmap).trans (Limits.pullback.lift_fst _ _ _)

  have s1 : ∀ {X' B' : Scheme.{u}} (g : X' ⟶ B')
      (Qs : Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}), Injective Qs →
      ∀ (hPs : Presheaf.IsSheaf (Scheme.smallEtaleTopology B') ((wcEtBaseChange g).op ⋙ Qs.obj)),
      Injective (⟨(wcEtBaseChange g).op ⋙ Qs.obj, hPs⟩ :
        Sheaf (Scheme.smallEtaleTopology B') AddCommGrpCat.{u+1}) := by
    intro X' B' g Qs hQ hPs
    obtain ⟨L, ⟨adj⟩, hL⟩ := wc_et_push_left_adjoint g
    haveI := hL
    haveI := hQ
    haveI : L.PreservesMonomorphisms := preservesMonomorphisms_of_preservesLimitsOfShape L
    have h1 : Injective ((wcEtPush g).obj Qs) := Injective.injective_of_adjoint adj Qs
    exact Injective.of_iso (sheafificationIso (⟨(wcEtBaseChange g).op ⋙ Qs.obj, hPs⟩ :
      Sheaf (Scheme.smallEtaleTopology B') AddCommGrpCat.{u+1})).symm h1

  have s5 : ∀ {A' B' : Scheme.{u}} (f : A' ⟶ B')
      (G : Sheaf (Scheme.smallEtaleTopology B') AddCommGrpCat.{u+1})
      (G' Qs : Sheaf (Scheme.smallEtaleTopology A') AddCommGrpCat.{u+1})
      (ρ : wcEtTransport f G G') (jj : G' ⟶ Qs)
      (hPs : Presheaf.IsSheaf (Scheme.smallEtaleTopology B') ((wcEtBaseChange f).op ⋙ Qs.obj)),
      ∃ φ : G ⟶ (⟨(wcEtBaseChange f).op ⋙ Qs.obj, hPs⟩ :
          Sheaf (Scheme.smallEtaleTopology B') AddCommGrpCat.{u+1}),
        ∀ (V : B'.Etale) (x : G.obj.obj (Opposite.op V)),
          (φ.hom.app (Opposite.op V)).hom x =
            (jj.hom.app (Opposite.op ((wcEtBaseChange f).obj V))).hom
              (ρ.ρ V ((wcEtBaseChange f).obj V) (Limits.pullback.fst V.hom f)
                Limits.pullback.condition x) := by
    intro A' B' f G G' Qs ρ jj hPs
    refine ⟨ObjectProperty.homMk
      { app := fun V => AddCommGrpCat.ofHom
          ((jj.hom.app (Opposite.op ((wcEtBaseChange f).obj V.unop))).hom.comp
            (ρ.ρ V.unop ((wcEtBaseChange f).obj V.unop) (Limits.pullback.fst V.unop.hom f)
              Limits.pullback.condition))
        naturality := ?_ }, fun V x => rfl⟩
    intro V W c
    ext x
    have hn := ρ.nat V.unop W.unop c.unop ((wcEtBaseChange f).obj V.unop)
      ((wcEtBaseChange f).obj W.unop) ((wcEtBaseChange f).map c.unop)
      (Limits.pullback.fst V.unop.hom f) Limits.pullback.condition
      (Limits.pullback.fst W.unop.hom f) Limits.pullback.condition (hBC f c.unop).symm x
    exact (congrArg (jj.hom.app (Opposite.op ((wcEtBaseChange f).obj W.unop))).hom hn).trans
      (homNat jj ((wcEtBaseChange f).map c.unop) _)

  have hTc : ∀ {F F' F'' : Finset R} (h₁ : F ⊆ F') (h₂ : F' ⊆ F''),
      wcSubT R h₂ ≫ wcSubT R h₁ = wcSubT R (Finset.Subset.trans h₁ h₂) := by
    intro F F' F'' h₁ h₂
    show Spec.map _ ≫ Spec.map _ = Spec.map _
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have e2 : (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h₂))).comp
        (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h₁))) =
        Subring.inclusion (Subring.closure_mono
          (Finset.coe_subset.mpr (Finset.Subset.trans h₁ h₂))) := by
      apply RingHom.ext
      intro x
      apply Subtype.ext
      simp
    rw [e2]
  have hTrefl : ∀ F : Finset R, wcSubT R (Finset.Subset.refl F) = 𝟙 (wcSubX R F) := by
    intro F
    have e : (CommRingCat.ofHom (Subring.inclusion (Subring.closure_mono
        (Finset.coe_subset.mpr (Finset.Subset.refl F)))) :
        CommRingCat.of (Subring.closure (F : Set R)) ⟶ CommRingCat.of (Subring.closure (F : Set R))) =
        𝟙 _ := by
      ext x
      rfl
    exact (congrArg Spec.map e).trans (Spec.map_id _)

  haveI hEI : ∀ H : Finset R,
      EnoughInjectives (Sheaf (Scheme.smallEtaleTopology (wcSubX R H)) AddCommGrpCat.{u+1}) :=
    fun H => wc_et_enough_injectives _
  let Q : ∀ H : Finset R, Sheaf (Scheme.smallEtaleTopology (wcSubX R H)) AddCommGrpCat.{u+1} :=
    fun H => Injective.under (A H)
  let j : ∀ H : Finset R, A H ⟶ Q H := fun H => Injective.ι (A H)
  have hP : ∀ (F : Finset R) (H : {H : Finset R // F ⊆ H}),
      Presheaf.IsSheaf (Scheme.smallEtaleTopology (wcSubX R F))
        ((wcEtBaseChange (wcSubT R H.2)).op ⋙ (Q H.1).obj) := by
    intro F H
    haveI := wc_et_basechange_isContinuous (wcSubT R H.2)
    exact Functor.op_comp_isSheaf _ _ _ (Q H.1)
  let P : ∀ F : Finset R, {H : Finset R // F ⊆ H} →
      Sheaf (Scheme.smallEtaleTopology (wcSubX R F)) AddCommGrpCat.{u+1} :=
    fun F H => ⟨(wcEtBaseChange (wcSubT R H.2)).op ⋙ (Q H.1).obj, hP F H⟩
  let E : ∀ F : Finset R, Sheaf (Scheme.smallEtaleTopology (wcSubX R F)) AddCommGrpCat.{u+1} :=
    fun F => ∏ᶜ P F
  let eqv : ∀ (F : Finset R) (V : (wcSubX R F).Etale), (E F).obj.obj (Opposite.op V) ≃+
      (∀ H : {H : Finset R // F ⊆ H}, (P F H).obj.obj (Opposite.op V)) := fun F V =>
    AddEquiv.ofBijective (AddMonoidHom.pi fun H => ((Limits.Pi.π (P F) H).hom.app (Opposite.op V)).hom)
      (s2 _ (P F) V)
  have hlamEx : ∀ (F F' : Finset R) (h : F ⊆ F') (H' : {H : Finset R // F' ⊆ H})
      (V : (wcSubX R F).Etale) (O : (wcSubX R F').Etale) (k : O.left ⟶ V.left),
      k ≫ V.hom = O.hom ≫ wcSubT R h →
      ∃ l : (wcEtBaseChange (wcSubT R H'.2)).obj O ⟶
          (wcEtBaseChange (wcSubT R (Finset.Subset.trans h H'.2))).obj V,
        l.left ≫ Limits.pullback.fst V.hom (wcSubT R (Finset.Subset.trans h H'.2)) =
          Limits.pullback.fst O.hom (wcSubT R H'.2) ≫ k :=
    fun F F' h H' V O k hk => lamEx _ _ _ (hTc h H'.2) V O k hk
  choose lamC hlamC using hlamEx
  let εr : ∀ (F F' : Finset R) (h : F ⊆ F') (V : (wcSubX R F).Etale) (O : (wcSubX R F').Etale)
      (k : O.left ⟶ V.left), k ≫ V.hom = O.hom ≫ wcSubT R h →
      ((E F).obj.obj (Opposite.op V) →+ (E F').obj.obj (Opposite.op O)) :=
    fun F F' h V O k hk => (eqv F' O).symm.toAddMonoidHom.comp (AddMonoidHom.pi fun H' =>
      ((Q H'.1).obj.map (lamC F F' h H' V O k hk).op).hom.comp
        ((Limits.Pi.π (P F) ⟨H'.1, Finset.Subset.trans h H'.2⟩).hom.app (Opposite.op V)).hom)
  have epsForm : ∀ (F F' : Finset R) (h : F ⊆ F') (V : (wcSubX R F).Etale)
      (O : (wcSubX R F').Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ wcSubT R h)
      (y : (E F).obj.obj (Opposite.op V)) (H' : {H : Finset R // F' ⊆ H})
      (l : (wcEtBaseChange (wcSubT R H'.2)).obj O ⟶
        (wcEtBaseChange (wcSubT R (Finset.Subset.trans h H'.2))).obj V),
      l.left ≫ Limits.pullback.fst V.hom (wcSubT R (Finset.Subset.trans h H'.2)) =
        Limits.pullback.fst O.hom (wcSubT R H'.2) ≫ k →
      ((Limits.Pi.π (P F') H').hom.app (Opposite.op O)).hom (εr F F' h V O k hk y) =
        ((Q H'.1).obj.map l.op).hom
          (((Limits.Pi.π (P F) ⟨H'.1, Finset.Subset.trans h H'.2⟩).hom.app (Opposite.op V)).hom y) := by
    intro F F' h V O k hk y H' l hl
    rw [lamU _ _ V O l (lamC F F' h H' V O k hk) (hl.trans (hlamC F F' h H' V O k hk).symm)]
    exact congrFun ((eqv F' O).apply_symm_apply _) H'
  have hcong : ∀ {A' B' : Scheme.{u}} {f : A' ⟶ B'}
      {G : Sheaf (Scheme.smallEtaleTopology B') AddCommGrpCat.{u+1}}
      {G' : Sheaf (Scheme.smallEtaleTopology A') AddCommGrpCat.{u+1}} (ρ : wcEtTransport f G G')
      (V : B'.Etale) (O : A'.Etale) (m1 m2 : O.left ⟶ V.left) (hm1 : m1 ≫ V.hom = O.hom ≫ f)
      (hm2 : m2 ≫ V.hom = O.hom ≫ f) (x : G.obj.obj (Opposite.op V)),
      m1 = m2 → ρ.ρ V O m1 hm1 x = ρ.ρ V O m2 hm2 x := by
    intro A' B' f G G' ρ V O m1 m2 hm1 hm2 x hm
    subst hm
    rfl

  have natε : ∀ (F F' : Finset R) (h : F ⊆ F') (V V' : (wcSubX R F).Etale) (c : V' ⟶ V)
      (O O' : (wcSubX R F').Etale) (d : O' ⟶ O) (h0 : O.left ⟶ V.left)
      (hh0 : h0 ≫ V.hom = O.hom ≫ wcSubT R h) (h0' : O'.left ⟶ V'.left)
      (hh0' : h0' ≫ V'.hom = O'.hom ≫ wcSubT R h), h0' ≫ c.left = d.left ≫ h0 →
      ∀ x : (E F).obj.obj (Opposite.op V),
        εr F F' h V' O' h0' hh0' (((E F).obj.map c.op).hom x) =
          ((E F').obj.map d.op).hom (εr F F' h V O h0 hh0 x) := by
    intro F F' h V V' c O O' d h0 hh0 h0' hh0' hcd x
    apply (eqv F' O').injective
    funext H'
    show ((Limits.Pi.π (P F') H').hom.app (Opposite.op O')).hom _ =
      ((Limits.Pi.π (P F') H').hom.app (Opposite.op O')).hom _
    have e' := hlamC F F' h H' V' O' h0' hh0'
    have e := hlamC F F' h H' V O h0 hh0
    refine (epsForm F F' h V' O' h0' hh0' _ H' _ e').trans ?_
    refine (congrArg ((Q H'.1).obj.map (lamC F F' h H' V' O' h0' hh0').op).hom
      (homNat (Limits.Pi.π (P F) ⟨H'.1, Finset.Subset.trans h H'.2⟩) c x)).trans ?_
    refine Eq.trans ?_ (homNat (Limits.Pi.π (P F') H') d _).symm
    refine Eq.trans ?_ (congrArg ((Q H'.1).obj.map ((wcEtBaseChange (wcSubT R H'.2)).map d).op).hom
      (epsForm F F' h V O h0 hh0 x H' _ e)).symm
    refine (mapComp (Q H'.1) ((wcEtBaseChange (wcSubT R (Finset.Subset.trans h H'.2))).map c)
      (lamC F F' h H' V' O' h0' hh0') _).trans ?_
    refine Eq.trans ?_ (mapComp (Q H'.1) (lamC F F' h H' V O h0 hh0)
      ((wcEtBaseChange (wcSubT R H'.2)).map d) _).symm
    refine congrArg (fun m => ((Q H'.1).obj.map (Opposite.op m)).hom _) ?_
    apply lamU
    refine (congrArg (· ≫ _) (MorphismProperty.Comma.comp_left _ _)).trans ?_
    refine (Category.assoc _ _ _).trans ?_
    refine (congrArg (_ ≫ ·) (hBC _ c)).trans ?_
    refine (Category.assoc _ _ _).symm.trans ?_
    refine (congrArg (· ≫ c.left) e').trans ?_
    refine (Category.assoc _ _ _).trans ?_
    refine (congrArg (_ ≫ ·) hcd).trans ?_
    refine Eq.trans ?_ (congrArg (· ≫ _) (MorphismProperty.Comma.comp_left _ _)).symm
    refine Eq.trans ?_ (Category.assoc _ _ _).symm
    refine Eq.trans ?_ (congrArg (_ ≫ ·) e).symm
    refine Eq.trans ?_ (Category.assoc _ _ _)
    refine Eq.trans ?_ (congrArg (· ≫ h0) (hBC _ d)).symm
    exact (Category.assoc _ _ _).symm
  let ε : ∀ (F F' : Finset R) (h : F ⊆ F'), wcEtTransport (wcSubT R h) (E F) (E F') :=
    fun F F' h => { ρ := εr F F' h, nat := natε F F' h }

  choose μc hμc using fun (F : Finset R) (H : {H : Finset R // F ⊆ H}) =>
    s5 (wcSubT R H.2) (A F) (A H.1) (Q H.1) (a F H.1 H.2) (j H.1) (hP F H)
  let μ : ∀ F : Finset R, A F ⟶ E F := fun F => Limits.Pi.lift (f := P F) (μc F)
  have piForm : ∀ (F : Finset R) (H : {H : Finset R // F ⊆ H}) (V : (wcSubX R F).Etale)
      (x : (A F).obj.obj (Opposite.op V)),
      ((Limits.Pi.π (P F) H).hom.app (Opposite.op V)).hom (((μ F).hom.app (Opposite.op V)).hom x) =
        ((μc F H).hom.app (Opposite.op V)).hom x := fun F H V x =>
    congrArg (fun φ => (φ.hom.app (Opposite.op V)).hom x) (Limits.Pi.lift_comp_π (μc F) H)

  have hjinj : ∀ (H : Finset R) (W : (wcSubX R H).Etale),
      Function.Injective ((j H).hom.app (Opposite.op W)).hom := by
    intro H W
    haveI : Mono (j H) := Injective.ι_mono (A H)
    haveI : Mono (j H).hom := (Sheaf.Hom.mono_iff_presheaf_mono _ _ (j H)).mp inferInstance
    haveI : Mono ((j H).hom.app (Opposite.op W)) := (NatTrans.mono_iff_mono_app _).mp inferInstance _
    exact (AddCommGrpCat.mono_iff_injective _).mp inferInstance
  have hμinj : ∀ (F : Finset R) (V : (wcSubX R F).Etale),
      Function.Injective ((μ F).hom.app (Opposite.op V)).hom := by
    intro F V x x' hxx
    let H₀ : {H : Finset R // F ⊆ H} := ⟨F, Finset.Subset.refl F⟩
    have h1 := congrArg ((Limits.Pi.π (P F) H₀).hom.app (Opposite.op V)).hom hxx
    rw [piForm, piForm, hμc, hμc] at h1
    have h2 := hjinj F _ h1
    let T₀ := wcSubT R (Finset.Subset.refl F)
    have wp : Limits.pullback.fst V.hom T₀ ≫ V.hom = Limits.pullback.snd V.hom T₀ :=
      Limits.pullback.condition.trans ((congrArg (fun t => Limits.pullback.snd V.hom T₀ ≫ t)
        (hTrefl F)).trans (Category.comp_id _))
    let cp : (wcEtBaseChange T₀).obj V ⟶ V :=
      MorphismProperty.Over.homMk (Limits.pullback.fst V.hom T₀) wp trivial
    have ws : 𝟙 V.left ≫ V.hom = V.hom ≫ T₀ := by
      rw [Category.id_comp]
      exact (Category.comp_id _).symm.trans (congrArg (V.hom ≫ ·) (hTrefl F)).symm
    let s : V ⟶ (wcEtBaseChange T₀).obj V :=
      MorphismProperty.Over.homMk (Limits.pullback.lift (𝟙 V.left) V.hom ws)
        (Limits.pullback.lift_snd _ _ _) trivial
    have hscp : s ≫ cp = 𝟙 V := by
      apply MorphismProperty.Over.Hom.ext
      exact (MorphismProperty.Comma.comp_left _ _).trans (Limits.pullback.lift_fst _ _ _)
    have h3 : ((A F).obj.map cp.op).hom x = ((A F).obj.map cp.op).hom x' :=
      (hA.1 F V _ cp Limits.pullback.condition x).symm.trans
        (h2.trans (hA.1 F V _ cp Limits.pullback.condition x'))
    have h4 := congrArg ((A F).obj.map s.op).hom h3
    rw [mapComp, mapComp, hscp, mapId, mapId] at h4
    exact h4

  refine ⟨E, ε, μ, ?_, ?_, ⟨?_, ?_⟩, ?_⟩
  · intro F
    haveI : ∀ H, Injective (P F H) := fun H =>
      s1 (wcSubT R H.2) (Q H.1) (Injective.injective_under _) (hP F H)
    exact (inferInstance : Injective (∏ᶜ P F))
  · intro F
    haveI : ∀ V, Mono ((μ F).hom.app V) := fun V =>
      (AddCommGrpCat.mono_iff_injective _).mpr (hμinj F V.unop)
    haveI : Mono (μ F).hom := NatTrans.mono_of_mono_app _
    exact Sheaf.Hom.mono_of_presheaf_mono _ _ _
  · intro F V O c hc y
    apply (eqv F O).injective
    funext H
    show ((Limits.Pi.π (P F) H).hom.app (Opposite.op O)).hom _ =
      ((Limits.Pi.π (P F) H).hom.app (Opposite.op O)).hom _
    refine (epsForm F F (Finset.Subset.refl F) V O c.left hc y H
      ((wcEtBaseChange (wcSubT R H.2)).map c) (hBC _ c)).trans ?_
    exact (homNat (Limits.Pi.π (P F) H) c y).symm
  · intro F F' F'' h₁ h₂ V O h hh O₂ k hk x
    apply (eqv F'' O₂).injective
    funext H''
    show ((Limits.Pi.π (P F'') H'').hom.app (Opposite.op O₂)).hom _ =
      ((Limits.Pi.π (P F'') H'').hom.app (Opposite.op O₂)).hom _
    have e1 := hlamC F F' h₁ ⟨H''.1, Finset.Subset.trans h₂ H''.2⟩ V O h hh
    have e2 := hlamC F' F'' h₂ H'' O O₂ k hk
    refine (epsForm F F'' (Finset.Subset.trans h₁ h₂) V O₂ (k ≫ h) _ x H''
      (lamC F' F'' h₂ H'' O O₂ k hk ≫ lamC F F' h₁ ⟨H''.1, Finset.Subset.trans h₂ H''.2⟩ V O h hh)
      ?_).trans ?_
    · refine (congrArg (· ≫ _) (MorphismProperty.Comma.comp_left _ _)).trans ?_
      refine (Category.assoc _ _ _).trans ?_
      refine (congrArg (_ ≫ ·) e1).trans ?_
      refine (Category.assoc _ _ _).symm.trans ?_
      refine (congrArg (· ≫ h) e2).trans ?_
      exact Category.assoc _ _ _
    · refine Eq.trans ?_ (epsForm F' F'' h₂ O O₂ k hk _ H'' _ e2).symm
      refine Eq.trans ?_ (congrArg ((Q H''.1).obj.map (lamC F' F'' h₂ H'' O O₂ k hk).op).hom
        (epsForm F F' h₁ V O h hh x ⟨H''.1, Finset.Subset.trans h₂ H''.2⟩ _ e1)).symm
      exact (mapComp (Q H''.1) _ _ _).symm
  · intro F F' h V O k hk x
    apply (eqv F' O).injective
    funext H'
    show ((Limits.Pi.π (P F') H').hom.app (Opposite.op O)).hom _ =
      ((Limits.Pi.π (P F') H').hom.app (Opposite.op O)).hom _
    have e := hlamC F F' h H' V O k hk
    let l := lamC F F' h H' V O k hk
    let g := wcSubT R (Finset.Subset.trans h H'.2)
    have hh' : (l.left ≫ Limits.pullback.fst V.hom g) ≫ V.hom =
        ((wcEtBaseChange (wcSubT R H'.2)).obj O).hom ≫ g :=
      (Category.assoc _ _ _).trans ((congrArg (l.left ≫ ·) Limits.pullback.condition).trans
        ((Category.assoc _ _ _).symm.trans (congrArg (· ≫ g) (MorphismProperty.Over.w l))))
    have hn := (a F H'.1 (Finset.Subset.trans h H'.2)).nat V V (𝟙 V) _ _ l
      (Limits.pullback.fst V.hom g) Limits.pullback.condition
      (l.left ≫ Limits.pullback.fst V.hom g) hh' (Category.comp_id _) x
    rw [mapId] at hn
    have hc2 := hA.2 F F' H'.1 h H'.2 V O k hk ((wcEtBaseChange (wcSubT R H'.2)).obj O)
      (Limits.pullback.fst O.hom (wcSubT R H'.2)) Limits.pullback.condition x
    refine (epsForm F F' h V O k hk _ H' l e).trans ?_
    refine (congrArg ((Q H'.1).obj.map l.op).hom
      ((piForm F ⟨H'.1, Finset.Subset.trans h H'.2⟩ V x).trans
        (hμc F ⟨H'.1, Finset.Subset.trans h H'.2⟩ V x))).trans ?_
    refine (homNat (j H'.1) l _).symm.trans ?_
    refine Eq.trans ?_ ((piForm F' H' O _).trans (hμc F' H' O _)).symm
    refine congrArg ((j H'.1).hom.app _).hom ?_
    refine hn.symm.trans ?_
    refine Eq.trans ?_ hc2
    exact hcong _ _ _ _ _ _ _ x e

theorem wc_subring_coh_cokernel : ∀ (R : Type u) [CommRing R]
    (A B : ∀ F : Finset R, Sheaf (Scheme.smallEtaleTopology (wcSubX R F)) AddCommGrpCat.{u+1})
    (a : ∀ (F F' : Finset R) (h : F ⊆ F'), wcEtTransport (wcSubT R h) (A F) (A F'))
    (b : ∀ (F F' : Finset R) (h : F ⊆ F'), wcEtTransport (wcSubT R h) (B F) (B F'))
    (μ : ∀ F : Finset R, A F ⟶ B F),
    wcSubCoherent R B b →
    (∀ (F F' : Finset R) (h : F ⊆ F') (V : (wcSubX R F).Etale) (O : (wcSubX R F').Etale)
        (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ wcSubT R h) (x : (A F).obj.obj (Opposite.op V)),
        (b F F' h).ρ V O k hk (((μ F).hom.app (Opposite.op V)).hom x) =
          ((μ F').hom.app (Opposite.op O)).hom ((a F F' h).ρ V O k hk x)) →
    ∃ c : ∀ (F F' : Finset R) (h : F ⊆ F'),
        wcEtTransport (wcSubT R h) (Limits.cokernel (μ F)) (Limits.cokernel (μ F')),
      wcSubCoherent R (fun F => Limits.cokernel (μ F)) c ∧
      ∀ (F F' : Finset R) (h : F ⊆ F') (V : (wcSubX R F).Etale) (O : (wcSubX R F').Etale)
        (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ wcSubT R h) (y : (B F).obj.obj (Opposite.op V)),
        (c F F' h).ρ V O k hk (((Limits.cokernel.π (μ F)).hom.app (Opposite.op V)).hom y) =
          ((Limits.cokernel.π (μ F')).hom.app (Opposite.op O)).hom ((b F F' h).ρ V O k hk y) :=
by
  intro R _ A B a b μ hb hcomp

  have hcont : ∀ {X B : Scheme.{u}} (g : X ⟶ B),
      (wcEtBaseChange g).IsContinuous (Scheme.smallEtaleTopology B)
        (Scheme.smallEtaleTopology X) := by
    have hjs : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
        (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
      intro Y V S hS
      change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      obtain ⟨V₁, c, hc, y, hy⟩ := hS x
      have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
      have hEt : Etale c.left := by
        have h1 : Etale V.hom := V.prop
        have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
        exact Etale.of_comp c.left V.hom
      exact ⟨V₁, c, y, hc, hEt, hy⟩
    have hcov : ∀ {X B : Scheme.{u}} (g : X ⟶ B), CoverPreserving (Scheme.smallEtaleTopology B)
        (Scheme.smallEtaleTopology X) (wcEtBaseChange g) := by
      intro X B g
      constructor
      intro V S hS
      change S ∈ Scheme.smallGrothendieckTopology @Etale B V at hS
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
      have hS' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS
      apply hjs
      intro v
      obtain ⟨W, a, w, ha, -, hw⟩ := hS' (Limits.pullback.fst V.hom g v)
      refine ⟨(wcEtBaseChange g).obj W, (wcEtBaseChange g).map a,
        Sieve.image_mem_functorPushforward (wcEtBaseChange g) S ha, ?_⟩
      have h0 : (Limits.pullback.fst W.hom g ≫ a.left) ≫ V.hom =
          Limits.pullback.snd W.hom g ≫ g := by
        rw [Category.assoc, MorphismProperty.Over.w a]
        exact Limits.pullback.condition
      let m : Limits.pullback W.hom g ⟶ Limits.pullback V.hom g :=
        Limits.pullback.lift (Limits.pullback.fst W.hom g ≫ a.left) (Limits.pullback.snd W.hom g) h0
      have hmap : ((wcEtBaseChange g).map a).left = m := rfl
      have h1 : Limits.pullback.fst a.left (Limits.pullback.fst V.hom g) ≫ W.hom =
          (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫
            Limits.pullback.snd V.hom g) ≫ g := by
        rw [← MorphismProperty.Over.w a, ← Category.assoc, Limits.pullback.condition,
          Category.assoc, Limits.pullback.condition, Category.assoc]
      let ψ : Limits.pullback a.left (Limits.pullback.fst V.hom g) ⟶ Limits.pullback W.hom g :=
        Limits.pullback.lift (Limits.pullback.fst a.left (Limits.pullback.fst V.hom g))
          (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫
            Limits.pullback.snd V.hom g) h1
      have hψ : ψ ≫ m = Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) := by
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc,
            Limits.pullback.lift_fst, Limits.pullback.condition]
        · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
      obtain ⟨z, hz⟩ : ∃ z, Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) z = v := by
        have hv : (v : ↥(Limits.pullback V.hom g)) ∈
            Set.range (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g)) := by
          rw [Scheme.Pullback.range_snd]
          exact ⟨w, hw⟩
        exact hv
      rw [hmap]
      exact ⟨ψ z, (Scheme.Hom.comp_apply ψ m z).symm.trans (by rw [hψ]; exact hz)⟩
    intro X B g
    let Φ := wcEtBaseChange g
    haveI h1 : Limits.PreservesFiniteLimits Φ := ⟨fun J _ _ =>
      haveI : Limits.PreservesLimitsOfShape J (wcEtBaseChange g ⋙ Scheme.Etale.forget X) :=
        Limits.preservesLimitsOfShape_of_natIso
          (NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl) :
            Scheme.Etale.forget B ⋙ Over.pullback g ≅ wcEtBaseChange g ⋙ Scheme.Etale.forget X)
      Limits.preservesLimitsOfShape_of_reflects_of_preserves (wcEtBaseChange g)
        (Scheme.Etale.forget X)⟩
    haveI := flat_of_preservesFiniteLimits Φ
    exact Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat _ _) (hcov g)

  have hP : ∀ (X Y : Scheme.{u}) (f : X ⟶ Y)
      (G : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}),
      Presheaf.IsSheaf (Scheme.smallEtaleTopology Y) ((wcEtBaseChange f).op ⋙ G.obj) := by
    intro X Y f G
    haveI := hcont f
    exact Functor.op_comp_isSheaf (wcEtBaseChange f) _ _ G
  let uu : ∀ (X Y : Scheme.{u}) (f : X ⟶ Y) (V : Y.Etale) (O : X.Etale) (k : O.left ⟶ V.left),
      k ≫ V.hom = O.hom ≫ f → (O ⟶ (wcEtBaseChange f).obj V) := fun X Y f V O k hk =>
    MorphismProperty.Over.homMk (Limits.pullback.lift k O.hom hk)
      (Limits.pullback.lift_snd _ _ _) trivial
  have hu_fst : ∀ (X Y : Scheme.{u}) (f : X ⟶ Y) (V : Y.Etale) (O : X.Etale)
      (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ f),
      (uu X Y f V O k hk).left ≫ Limits.pullback.fst V.hom f = k :=
    fun X Y f V O k hk => Limits.pullback.lift_fst _ _ _
  have hu_snd : ∀ (X Y : Scheme.{u}) (f : X ⟶ Y) (V : Y.Etale) (O : X.Etale)
      (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ f),
      (uu X Y f V O k hk).left ≫ Limits.pullback.snd V.hom f = O.hom :=
    fun X Y f V O k hk => Limits.pullback.lift_snd _ _ _
  have hB_fst : ∀ (X Y : Scheme.{u}) (f : X ⟶ Y) (V V' : Y.Etale) (c : V' ⟶ V),
      ((wcEtBaseChange f).map c).left ≫ Limits.pullback.fst V.hom f =
        Limits.pullback.fst V'.hom f ≫ c.left :=
    fun X Y f V V' c => Limits.pullback.lift_fst _ _ _
  have hB_snd : ∀ (X Y : Scheme.{u}) (f : X ⟶ Y) (V V' : Y.Etale) (c : V' ⟶ V),
      ((wcEtBaseChange f).map c).left ≫ Limits.pullback.snd V.hom f =
        Limits.pullback.snd V'.hom f :=
    fun X Y f V V' c => Limits.pullback.lift_snd _ _ _
  have K1 : ∀ (X Y : Scheme.{u}) (f : X ⟶ Y) (V V' : Y.Etale) (c : V' ⟶ V) (O O' : X.Etale)
      (d : O' ⟶ O) (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ f)
      (h' : O'.left ⟶ V'.left) (hh' : h' ≫ V'.hom = O'.hom ≫ f),
      h' ≫ c.left = d.left ≫ h →
        uu X Y f V' O' h' hh' ≫ (wcEtBaseChange f).map c = d ≫ uu X Y f V O h hh := by
    intro X Y f V V' c O O' d h hh h' hh' hc
    apply MorphismProperty.Over.Hom.ext
    show (uu X Y f V' O' h' hh').left ≫ ((wcEtBaseChange f).map c).left =
      d.left ≫ (uu X Y f V O h hh).left
    apply Limits.pullback.hom_ext
    · exact (Category.assoc _ _ _).trans
        ((congrArg (fun t => (uu X Y f V' O' h' hh').left ≫ t) (hB_fst X Y f V V' c)).trans
        ((Category.assoc _ _ _).symm.trans
        ((congrArg (fun t => t ≫ c.left) (hu_fst X Y f V' O' h' hh')).trans
        (hc.trans ((congrArg (fun t => d.left ≫ t) (hu_fst X Y f V O h hh)).symm.trans
        (Category.assoc _ _ _).symm)))))
    · exact (Category.assoc _ _ _).trans
        ((congrArg (fun t => (uu X Y f V' O' h' hh').left ≫ t) (hB_snd X Y f V V' c)).trans
        ((hu_snd X Y f V' O' h' hh').trans ((MorphismProperty.Over.w d).symm.trans
        ((congrArg (fun t => d.left ≫ t) (hu_snd X Y f V O h hh)).symm.trans
        (Category.assoc _ _ _).symm))))
  have star : ∀ (X Y : Scheme.{u}) (f : X ⟶ Y)
      (M : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (G : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (T : wcEtTransport f M G)
      (V : Y.Etale) (O : X.Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ f)
      (x : M.obj.obj (Opposite.op V)),
      T.ρ V O k hk x = (G.obj.map (uu X Y f V O k hk).op).hom
        (T.ρ V ((wcEtBaseChange f).obj V) (Limits.pullback.fst V.hom f)
          Limits.pullback.condition x) := by
    intro X Y f M G T V O k hk x
    have hn := T.nat V V (𝟙 V) ((wcEtBaseChange f).obj V) O (uu X Y f V O k hk)
      (Limits.pullback.fst V.hom f) Limits.pullback.condition k hk
      ((Category.comp_id k).trans (hu_fst X Y f V O k hk).symm) x
    rw [op_id, CategoryTheory.Functor.map_id] at hn
    exact hn

  let Tr : ∀ (X Y : Scheme.{u}) (f : X ⟶ Y)
      (M : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (G : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}),
      (M.obj ⟶ (wcEtBaseChange f).op ⋙ G.obj) → wcEtTransport f M G :=
    fun X Y f M G α =>
    { ρ := fun V O k hk =>
        (G.obj.map (uu X Y f V O k hk).op).hom.comp (α.app (Opposite.op V)).hom
      nat := by
        intro V V' c O O' d h hh h' hh' e x
        have key : M.obj.map c.op ≫ α.app (Opposite.op V') ≫
              G.obj.map (uu X Y f V' O' h' hh').op =
            α.app (Opposite.op V) ≫ G.obj.map (uu X Y f V O h hh).op ≫ G.obj.map d.op := by
          rw [← Category.assoc, α.naturality, Category.assoc, Functor.comp_map, Functor.op_map,
            ← G.obj.map_comp, ← G.obj.map_comp, ← op_comp, ← op_comp, Quiver.Hom.unop_op,
            K1 X Y f V V' c O O' d h hh h' hh' e]
        exact congrArg (fun t => t.hom x) key }

  let Φ : ∀ (X Y : Scheme.{u}) (f : X ⟶ Y)
      (M : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (G : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}),
      wcEtTransport f M G → (M.obj ⟶ (wcEtBaseChange f).op ⋙ G.obj) :=
    fun X Y f M G T =>
    { app := fun V => AddCommGrpCat.ofHom (T.ρ V.unop ((wcEtBaseChange f).obj V.unop)
        (Limits.pullback.fst V.unop.hom f) Limits.pullback.condition)
      naturality := by
        intro V₁ V₂ g
        ext x
        exact T.nat V₁.unop V₂.unop g.unop _ _ ((wcEtBaseChange f).map g.unop) _
          Limits.pullback.condition _ Limits.pullback.condition (hB_fst X Y f _ _ _).symm x }
  have hcg : ∀ (X Y : Scheme.{u}) (f : X ⟶ Y)
      (M : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (G : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (T : wcEtTransport f M G)
      (V : Y.Etale) (O : X.Etale) (m₁ m₂ : O.left ⟶ V.left)
      (hm₁ : m₁ ≫ V.hom = O.hom ≫ f) (hm₂ : m₂ ≫ V.hom = O.hom ≫ f), m₁ = m₂ →
      ∀ z, T.ρ V O m₁ hm₁ z = T.ρ V O m₂ hm₂ z := by
    intro X Y f M G T V O m₁ m₂ hm₁ hm₂ e z
    subst e
    rfl

  have epiExt : ∀ (X Y : Scheme.{u}) (f : X ⟶ Y)
      (M C : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (π : M ⟶ C) [Epi π]
      (G : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
      (ρ ρ' : wcEtTransport f C G),
      (∀ (V : Y.Etale) (O : X.Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ f)
          (y : M.obj.obj (Opposite.op V)),
          ρ.ρ V O k hk ((π.hom.app (Opposite.op V)).hom y) =
            ρ'.ρ V O k hk ((π.hom.app (Opposite.op V)).hom y)) →
      ∀ (V : Y.Etale) (O : X.Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ f)
        (z : C.obj.obj (Opposite.op V)), ρ.ρ V O k hk z = ρ'.ρ V O k hk z := by
    intro X Y f M C π _ G ρ ρ' hyp V O k hk z
    let P : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} :=
      ⟨(wcEtBaseChange f).op ⋙ G.obj, hP X Y f G⟩
    let φ : C ⟶ P := ObjectProperty.homMk (Φ X Y f C G ρ)
    let φ' : C ⟶ P := ObjectProperty.homMk (Φ X Y f C G ρ')
    have h1 : π ≫ φ = π ≫ φ' := by
      apply Sheaf.hom_ext
      ext V' y
      exact hyp V'.unop ((wcEtBaseChange f).obj V'.unop) (Limits.pullback.fst V'.unop.hom f)
        Limits.pullback.condition y
    have h2 : φ = φ' := (cancel_epi π).mp h1
    have h3 : ρ.ρ V ((wcEtBaseChange f).obj V) (Limits.pullback.fst V.hom f)
          Limits.pullback.condition z =
        ρ'.ρ V ((wcEtBaseChange f).obj V) (Limits.pullback.fst V.hom f)
          Limits.pullback.condition z :=
      congrArg (fun t : C ⟶ P => (t.hom.app (Opposite.op V)).hom z) h2
    exact (star X Y f C G ρ V O k hk z).trans
      ((congrArg (fun w => (G.obj.map (uu X Y f V O k hk).op).hom w) h3).trans
        (star X Y f C G ρ' V O k hk z).symm)

  have compEx : ∀ (X Y Z : Scheme.{u}) (f : Y ⟶ Z) (g : X ⟶ Y) (e : X ⟶ Z) (he : g ≫ f = e)
      (F₀ : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
      (G₀ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (H₀ : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
      (ρ : wcEtTransport f F₀ G₀) (τ : wcEtTransport g G₀ H₀),
      ∃ σ : wcEtTransport e F₀ H₀, wcEtTransportFactor he ρ τ σ := by
    intro X Y Z f g e he F₀ G₀ H₀ ρ τ
    subst he
    let L : ∀ (V : Z.Etale) (O₂ : X.Etale) (m : O₂.left ⟶ V.left),
        m ≫ V.hom = O₂.hom ≫ (g ≫ f) → (O₂.left ⟶ ((wcEtBaseChange f).obj V).left) :=
      fun V O₂ m hm => Limits.pullback.lift m (O₂.hom ≫ g) (hm.trans (Category.assoc _ _ _).symm)
    have hL_fst : ∀ (V : Z.Etale) (O₂ : X.Etale) (m : O₂.left ⟶ V.left)
        (hm : m ≫ V.hom = O₂.hom ≫ (g ≫ f)), L V O₂ m hm ≫ Limits.pullback.fst V.hom f = m :=
      fun _ _ _ _ => Limits.pullback.lift_fst _ _ _
    have hL_snd : ∀ (V : Z.Etale) (O₂ : X.Etale) (m : O₂.left ⟶ V.left)
        (hm : m ≫ V.hom = O₂.hom ≫ (g ≫ f)),
        L V O₂ m hm ≫ ((wcEtBaseChange f).obj V).hom = O₂.hom ≫ g :=
      fun _ _ _ _ => Limits.pullback.lift_snd _ _ _
    refine ⟨{ ρ := fun V O₂ m hm =>
                (τ.ρ ((wcEtBaseChange f).obj V) O₂ (L V O₂ m hm) (hL_snd V O₂ m hm)).comp
                  (ρ.ρ V ((wcEtBaseChange f).obj V) (Limits.pullback.fst V.hom f)
                    Limits.pullback.condition)
              nat := ?_ }, ?_⟩
    · intro V V' cc O₂ O₂' d m hm m' hm' hmm x
      have e1 := ρ.nat V V' cc ((wcEtBaseChange f).obj V) ((wcEtBaseChange f).obj V')
        ((wcEtBaseChange f).map cc) (Limits.pullback.fst V.hom f) Limits.pullback.condition
        (Limits.pullback.fst V'.hom f) Limits.pullback.condition (hB_fst Y Z f V V' cc).symm x
      have hyp : L V' O₂' m' hm' ≫ ((wcEtBaseChange f).map cc).left = d.left ≫ L V O₂ m hm := by
        apply Limits.pullback.hom_ext
        · exact (Category.assoc _ _ _).trans
            ((congrArg (fun t => L V' O₂' m' hm' ≫ t) (hB_fst Y Z f V V' cc)).trans
            ((Category.assoc _ _ _).symm.trans
            ((congrArg (fun t => t ≫ cc.left) (hL_fst V' O₂' m' hm')).trans
            (hmm.trans ((congrArg (fun t => d.left ≫ t) (hL_fst V O₂ m hm)).symm.trans
            (Category.assoc _ _ _).symm)))))
        · exact (Category.assoc _ _ _).trans
            ((congrArg (fun t => L V' O₂' m' hm' ≫ t) (hB_snd Y Z f V V' cc)).trans
            ((hL_snd V' O₂' m' hm').trans
            ((congrArg (fun t => t ≫ g) (MorphismProperty.Over.w d)).symm.trans
            ((Category.assoc _ _ _).trans
            ((congrArg (fun t => d.left ≫ t) (hL_snd V O₂ m hm)).symm.trans
            (Category.assoc _ _ _).symm)))))
      have e2 := τ.nat ((wcEtBaseChange f).obj V) ((wcEtBaseChange f).obj V')
        ((wcEtBaseChange f).map cc) O₂ O₂' d (L V O₂ m hm) (hL_snd V O₂ m hm)
        (L V' O₂' m' hm') (hL_snd V' O₂' m' hm') hyp
        (ρ.ρ V ((wcEtBaseChange f).obj V) (Limits.pullback.fst V.hom f)
          Limits.pullback.condition x)
      exact (congrArg (τ.ρ ((wcEtBaseChange f).obj V') O₂' (L V' O₂' m' hm')
        (hL_snd V' O₂' m' hm')) e1).trans e2
    · intro V O h hh O₂ k hk x
      have e1 := star Y Z f F₀ G₀ ρ V O h hh x
      have hkh : (k ≫ h) ≫ V.hom = O₂.hom ≫ (g ≫ f) := by
        rw [Category.assoc, hh, ← Category.assoc, hk, Category.assoc]
      have hkL : k ≫ (uu Y Z f V O h hh).left = L V O₂ (k ≫ h) hkh := by
        apply Limits.pullback.hom_ext
        · exact (Category.assoc _ _ _).trans
            ((congrArg (fun t => k ≫ t) (hu_fst Y Z f V O h hh)).trans
            (hL_fst V O₂ (k ≫ h) hkh).symm)
        · exact (Category.assoc _ _ _).trans
            ((congrArg (fun t => k ≫ t) (hu_snd Y Z f V O h hh)).trans
            (hk.trans (hL_snd V O₂ (k ≫ h) hkh).symm))
      have e2 := τ.nat ((wcEtBaseChange f).obj V) O (uu Y Z f V O h hh) O₂ O₂ (𝟙 O₂)
        (L V O₂ (k ≫ h) hkh)
        (hL_snd V O₂ (k ≫ h) hkh) k hk (hkL.trans (Category.id_comp _).symm)
        (ρ.ρ V ((wcEtBaseChange f).obj V) (Limits.pullback.fst V.hom f)
          Limits.pullback.condition x)
      have e3 : ∀ y : H₀.obj.obj (Opposite.op O₂), H₀.obj.map (𝟙 O₂).op y = y := by
        intro y
        rw [op_id, CategoryTheory.Functor.map_id]
        rfl
      refine Eq.trans ?_ (congrArg (τ.ρ O O₂ k hk) e1).symm
      refine Eq.trans ?_ e2.symm
      refine Eq.trans ?_ (e3 _).symm
      rfl

  have hT : ∀ F : Finset R, wcSubT R (Finset.Subset.refl F) = 𝟙 (wcSubX R F) := by
    intro F
    have e : Subring.inclusion (Subring.closure_mono
        (Finset.coe_subset.mpr (Finset.Subset.refl F))) = RingHom.id _ := by
      apply RingHom.ext
      intro x
      exact Subtype.ext rfl
    show Spec.map (CommRingCat.ofHom (Subring.inclusion (Subring.closure_mono
      (Finset.coe_subset.mpr (Finset.Subset.refl F))))) = 𝟙 (wcSubX R F)
    rw [e, CommRingCat.ofHom_id, Spec.map_id]
  have hTT : ∀ {F F' F'' : Finset R} (h₁ : F ⊆ F') (h₂ : F' ⊆ F''),
      wcSubT R h₂ ≫ wcSubT R h₁ = wcSubT R (Finset.Subset.trans h₁ h₂) := by
    intro F F' F'' h₁ h₂
    show Spec.map _ ≫ Spec.map _ = Spec.map _
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have e2 : (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h₂))).comp
        (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h₁))) =
        Subring.inclusion (Subring.closure_mono
          (Finset.coe_subset.mpr (Finset.Subset.trans h₁ h₂))) := by
      apply RingHom.ext
      intro x
      apply Subtype.ext
      simp
    rw [e2]

  let θ : ∀ (F F' : Finset R) (h : F ⊆ F'),
      wcEtTransport (wcSubT R h) (B F) (Limits.cokernel (μ F')) := fun F F' h =>
    { ρ := fun V O k hk =>
        ((Limits.cokernel.π (μ F')).hom.app (Opposite.op O)).hom.comp ((b F F' h).ρ V O k hk)
      nat := by
        intro V V' cc O O' d k hk k' hk' hkk y
        exact (congrArg (fun w => ((Limits.cokernel.π (μ F')).hom.app (Opposite.op O')).hom w)
          ((b F F' h).nat V V' cc O O' d k hk k' hk' hkk y)).trans
          (congrArg (fun φ => AddCommGrpCat.Hom.hom φ ((b F F' h).ρ V O k hk y))
            ((Limits.cokernel.π (μ F')).hom.naturality d.op)) }
  have hkill : ∀ (F F' : Finset R) (h : F ⊆ F') (V : (wcSubX R F).Etale)
      (O : (wcSubX R F').Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ wcSubT R h)
      (x : (A F).obj.obj (Opposite.op V)),
      (θ F F' h).ρ V O k hk (((μ F).hom.app (Opposite.op V)).hom x) = 0 := by
    intro F F' h V O k hk x
    have e1 : (θ F F' h).ρ V O k hk (((μ F).hom.app (Opposite.op V)).hom x) =
        ((Limits.cokernel.π (μ F')).hom.app (Opposite.op O)).hom
          (((μ F').hom.app (Opposite.op O)).hom ((a F F' h).ρ V O k hk x)) :=
      congrArg (fun w => ((Limits.cokernel.π (μ F')).hom.app (Opposite.op O)).hom w)
        (hcomp F F' h V O k hk x)
    have e2 : ((μ F' ≫ Limits.cokernel.π (μ F')).hom.app (Opposite.op O)).hom
          ((a F F' h).ρ V O k hk x) =
        ((0 : A F' ⟶ Limits.cokernel (μ F')).hom.app (Opposite.op O)).hom
          ((a F F' h).ρ V O k hk x) :=
      congrArg (fun t => (t.hom.app (Opposite.op O)).hom ((a F F' h).ρ V O k hk x))
        (Limits.cokernel.condition (μ F'))
    exact e1.trans (e2.trans (by simp))
  let P' : ∀ (F F' : Finset R) (h : F ⊆ F'),
      Sheaf (Scheme.smallEtaleTopology (wcSubX R F)) AddCommGrpCat.{u+1} := fun F F' h =>
    ⟨(wcEtBaseChange (wcSubT R h)).op ⋙ (Limits.cokernel (μ F')).obj,
      hP _ _ (wcSubT R h) (Limits.cokernel (μ F'))⟩
  let φθ : ∀ (F F' : Finset R) (h : F ⊆ F'), B F ⟶ P' F F' h := fun F F' h =>
    ObjectProperty.homMk (Φ _ _ (wcSubT R h) (B F) (Limits.cokernel (μ F')) (θ F F' h))
  have hz : ∀ (F F' : Finset R) (h : F ⊆ F'), μ F ≫ φθ F F' h = 0 := by
    intro F F' h
    apply Sheaf.hom_ext
    ext V x
    exact (hkill F F' h V.unop ((wcEtBaseChange (wcSubT R h)).obj V.unop)
      (Limits.pullback.fst V.unop.hom (wcSubT R h)) Limits.pullback.condition x).trans
      (by simp)
  let c : ∀ (F F' : Finset R) (h : F ⊆ F'),
      wcEtTransport (wcSubT R h) (Limits.cokernel (μ F)) (Limits.cokernel (μ F')) :=
    fun F F' h => Tr _ _ (wcSubT R h) (Limits.cokernel (μ F)) (Limits.cokernel (μ F'))
      (Limits.cokernel.desc (μ F) (φθ F F' h) (hz F F' h)).hom
  have hc : ∀ (F F' : Finset R) (h : F ⊆ F') (V : (wcSubX R F).Etale) (O : (wcSubX R F').Etale)
      (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ wcSubT R h)
      (y : (B F).obj.obj (Opposite.op V)),
      (c F F' h).ρ V O k hk (((Limits.cokernel.π (μ F)).hom.app (Opposite.op V)).hom y) =
        ((Limits.cokernel.π (μ F')).hom.app (Opposite.op O)).hom ((b F F' h).ρ V O k hk y) := by
    intro F F' h V O k hk y
    have e1 : ((Limits.cokernel.desc (μ F) (φθ F F' h) (hz F F' h)).hom.app (Opposite.op V)).hom
          (((Limits.cokernel.π (μ F)).hom.app (Opposite.op V)).hom y) =
        (θ F F' h).ρ V ((wcEtBaseChange (wcSubT R h)).obj V)
          (Limits.pullback.fst V.hom (wcSubT R h)) Limits.pullback.condition y :=
      congrArg (fun t : B F ⟶ P' F F' h => (t.hom.app (Opposite.op V)).hom y)
        (Limits.cokernel.π_desc (μ F) (φθ F F' h) (hz F F' h))
    have e2 := star _ _ (wcSubT R h) (B F) (Limits.cokernel (μ F')) (θ F F' h) V O k hk y
    exact (congrArg (fun w => ((Limits.cokernel (μ F')).obj.map
      (uu _ _ (wcSubT R h) V O k hk).op).hom w) e1).trans e2.symm

  let hm : ∀ (F : Finset R) (V O : (wcSubX R F).Etale) (k : O.left ⟶ V.left),
      k ≫ V.hom = O.hom ≫ wcSubT R (Finset.Subset.refl F) → (O ⟶ V) :=
    fun F V O k hk => MorphismProperty.Over.homMk k
      (hk.trans (by rw [hT F]; exact Category.comp_id _)) trivial
  let ρI : ∀ F : Finset R, wcEtTransport (wcSubT R (Finset.Subset.refl F))
      (Limits.cokernel (μ F)) (Limits.cokernel (μ F)) := fun F =>
    { ρ := fun V O k hk => ((Limits.cokernel (μ F)).obj.map (hm F V O k hk).op).hom
      nat := by
        intro V V' cc O O' d k hk k' hk' hkk x
        have e : hm F V' O' k' hk' ≫ cc = d ≫ hm F V O k hk :=
          MorphismProperty.Over.Hom.ext hkk
        have e2 : ((Limits.cokernel (μ F)).obj.map (hm F V' O' k' hk' ≫ cc).op).hom x =
            ((Limits.cokernel (μ F)).obj.map (d ≫ hm F V O k hk).op).hom x :=
          congrArg (fun t => ((Limits.cokernel (μ F)).obj.map t.op).hom x) e
        rw [op_comp, op_comp, Functor.map_comp, Functor.map_comp] at e2
        exact e2 }
  have hid : ∀ (F : Finset R) (V O : (wcSubX R F).Etale) (cc : O ⟶ V)
      (hcc : cc.left ≫ V.hom = O.hom ≫ wcSubT R (Finset.Subset.refl F))
      (x : (Limits.cokernel (μ F)).obj.obj (Opposite.op V)),
      (c F F (Finset.Subset.refl F)).ρ V O cc.left hcc x =
        ((Limits.cokernel (μ F)).obj.map cc.op).hom x := by
    intro F V O cc hcc x
    have heq := epiExt _ _ (wcSubT R (Finset.Subset.refl F)) (B F) (Limits.cokernel (μ F))
      (Limits.cokernel.π (μ F)) (Limits.cokernel (μ F)) (c F F (Finset.Subset.refl F)) (ρI F)
      (by
        intro V' O' k hk y
        have e1 := hc F F (Finset.Subset.refl F) V' O' k hk y
        have e2 : (b F F (Finset.Subset.refl F)).ρ V' O' k hk y =
            ((B F).obj.map (hm F V' O' k hk).op).hom y :=
          hb.1 F V' O' (hm F V' O' k hk) hk y
        rw [e1, e2]
        exact congrArg (fun t => t.hom y)
          ((Limits.cokernel.π (μ F)).hom.naturality (hm F V' O' k hk).op))
      V O cc.left hcc x
    refine heq.trans ?_
    show ((Limits.cokernel (μ F)).obj.map (hm F V O cc.left hcc).op).hom x = _
    rw [show hm F V O cc.left hcc = cc from MorphismProperty.Over.Hom.ext rfl]

  have hcoc : ∀ (F F' F'' : Finset R) (h₁ : F ⊆ F') (h₂ : F' ⊆ F''),
      wcEtTransportFactor (hTT h₁ h₂) (c F F' h₁) (c F' F'' h₂)
        (c F F'' (Finset.Subset.trans h₁ h₂)) := by
    intro F F' F'' h₁ h₂
    obtain ⟨σ, hσ⟩ := compEx _ _ _ (wcSubT R h₁) (wcSubT R h₂)
      (wcSubT R (Finset.Subset.trans h₁ h₂)) (hTT h₁ h₂) (Limits.cokernel (μ F))
      (Limits.cokernel (μ F')) (Limits.cokernel (μ F'')) (c F F' h₁) (c F' F'' h₂)
    have hagree : ∀ (V : (wcSubX R F).Etale) (O₂ : (wcSubX R F'').Etale)
        (m : O₂.left ⟶ V.left) (hm : m ≫ V.hom = O₂.hom ≫ wcSubT R (Finset.Subset.trans h₁ h₂))
        (y : (B F).obj.obj (Opposite.op V)),
        σ.ρ V O₂ m hm (((Limits.cokernel.π (μ F)).hom.app (Opposite.op V)).hom y) =
          (c F F'' (Finset.Subset.trans h₁ h₂)).ρ V O₂ m hm
            (((Limits.cokernel.π (μ F)).hom.app (Opposite.op V)).hom y) := by
      intro V O₂ m hm y
      have hm' : m ≫ V.hom = (O₂.hom ≫ wcSubT R h₂) ≫ wcSubT R h₁ :=
        hm.trans (by rw [Category.assoc, hTT h₁ h₂])
      let kk : O₂.left ⟶ ((wcEtBaseChange (wcSubT R h₁)).obj V).left :=
        Limits.pullback.lift m (O₂.hom ≫ wcSubT R h₂) hm'
      have hkk : kk ≫ ((wcEtBaseChange (wcSubT R h₁)).obj V).hom = O₂.hom ≫ wcSubT R h₂ :=
        Limits.pullback.lift_snd _ _ _
      have hkm : kk ≫ Limits.pullback.fst V.hom (wcSubT R h₁) = m :=
        Limits.pullback.lift_fst _ _ _
      have hm2 : (kk ≫ Limits.pullback.fst V.hom (wcSubT R h₁)) ≫ V.hom =
          O₂.hom ≫ wcSubT R (Finset.Subset.trans h₁ h₂) := by
        rw [hkm]; exact hm
      have s1 := hcg _ _ _ _ _ σ V O₂ m (kk ≫ Limits.pullback.fst V.hom (wcSubT R h₁)) hm hm2
        hkm.symm (((Limits.cokernel.π (μ F)).hom.app (Opposite.op V)).hom y)
      have s2 := hσ V ((wcEtBaseChange (wcSubT R h₁)).obj V)
        (Limits.pullback.fst V.hom (wcSubT R h₁)) Limits.pullback.condition O₂ kk hkk
        (((Limits.cokernel.π (μ F)).hom.app (Opposite.op V)).hom y)
      have s3 := hc F F' h₁ V ((wcEtBaseChange (wcSubT R h₁)).obj V)
        (Limits.pullback.fst V.hom (wcSubT R h₁)) Limits.pullback.condition y
      have s4 := hc F' F'' h₂ ((wcEtBaseChange (wcSubT R h₁)).obj V) O₂ kk hkk
        ((b F F' h₁).ρ V ((wcEtBaseChange (wcSubT R h₁)).obj V)
          (Limits.pullback.fst V.hom (wcSubT R h₁)) Limits.pullback.condition y)
      have s5 := hb.2 F F' F'' h₁ h₂ V ((wcEtBaseChange (wcSubT R h₁)).obj V)
        (Limits.pullback.fst V.hom (wcSubT R h₁)) Limits.pullback.condition O₂ kk hkk y
      have s6 := hcg _ _ _ _ _ (b F F'' (Finset.Subset.trans h₁ h₂)) V O₂
        (kk ≫ Limits.pullback.fst V.hom (wcSubT R h₁)) m hm2 hm hkm y
      have s7 := hc F F'' (Finset.Subset.trans h₁ h₂) V O₂ m hm y
      rw [s1, s2, s3, s4, ← s5, s6, s7]
    have heq := epiExt _ _ (wcSubT R (Finset.Subset.trans h₁ h₂)) (B F) (Limits.cokernel (μ F))
      (Limits.cokernel.π (μ F)) (Limits.cokernel (μ F'')) σ
      (c F F'' (Finset.Subset.trans h₁ h₂)) hagree
    intro V O h hh O₂ k hk x
    refine Eq.trans ?_ (hσ V O h hh O₂ k hk x)
    exact (heq _ _ _ _ _).symm
  exact ⟨c, ⟨hid, fun F F' F'' h₁ h₂ => hcoc F F' F'' h₁ h₂⟩, hc⟩

theorem wc_subring_coherent_injres : ∀ (R : Type u) [CommRing R] (m : ℕ),
    ∃ (I : ∀ F : Finset R, InjectiveResolution (wcConstZ (wcSubX R F) m))
      (e : ∀ (n : ℕ) (F F' : Finset R) (h : F ⊆ F'),
        wcEtTransport (wcSubT R h) ((I F).cocomplex.X n) ((I F').cocomplex.X n)),
      (∀ n, wcSubCoherent R (fun F => (I F).cocomplex.X n) (e n)) ∧
      (∀ (n : ℕ) (F F' : Finset R) (h : F ⊆ F') (V : (wcSubX R F).Etale)
          (O : (wcSubX R F').Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ wcSubT R h)
          (x : ((I F).cocomplex.X n).obj.obj (Opposite.op V)),
        (e (n + 1) F F' h).ρ V O k hk ((((I F).cocomplex.d n (n + 1)).hom.app (Opposite.op V)).hom x) =
          (((I F').cocomplex.d n (n + 1)).hom.app (Opposite.op O)).hom ((e n F F' h).ρ V O k hk x)) ∧
      (∀ (F F' : Finset R) (h : F ⊆ F') (V : (wcSubX R F).Etale) (O : (wcSubX R F').Etale)
          (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ wcSubT R h) (a : ULift.{u+1} (ZMod m)),
        (e 0 F F' h).ρ V O k hk (((wcInjAug (I F)).hom.app (Opposite.op V)).hom
            (wcConstSec (wcSubX R F) (ULift.{u+1} (ZMod m)) V a)) =
          ((wcInjAug (I F')).hom.app (Opposite.op O)).hom
            (wcConstSec (wcSubX R F') (ULift.{u+1} (ZMod m)) O a)) :=
by
  intro R _ m
  classical
  let Pack := Σ' (A : ∀ F : Finset R, Sheaf (Scheme.smallEtaleTopology (wcSubX R F)) AddCommGrpCat.{u+1})
      (a : ∀ (F F' : Finset R) (h : F ⊆ F'), wcEtTransport (wcSubT R h) (A F) (A F')),
      wcSubCoherent R A a
  choose E ε μ hinj hmono hcohE hcompE using
    fun P : Pack => wc_subring_coh_injective_embed R P.1 P.2.1 P.2.2
  choose c hcohC hπ using
    fun P : Pack => wc_subring_coh_cokernel R P.1 (E P) P.2.1 (ε P) (μ P) (hcohE P) (hcompE P)
  let next : Pack → Pack := fun P => ⟨fun F => Limits.cokernel (μ P F), c P, hcohC P⟩
  obtain ⟨cΛ, hcohΛ, hηΛ⟩ := wc_subring_const_coherent R m
  let P₀ : Pack := ⟨fun F => wcConstZ (wcSubX R F) m, cΛ, hcohΛ⟩
  let pk : ℕ → Pack := fun n => Nat.rec (motive := fun _ => Pack) P₀ (fun _ P => next P) n
  let dd : ∀ (n : ℕ) (F : Finset R), E (pk n) F ⟶ E (pk (n + 1)) F := fun n F =>
    Limits.cokernel.π (μ (pk n) F) ≫ μ (pk (n + 1)) F
  have hdd : ∀ (F : Finset R) (n : ℕ), dd n F ≫ dd (n + 1) F = 0 := by
    intro F n
    show (Limits.cokernel.π (μ (pk n) F) ≫ μ (pk (n + 1)) F) ≫
      (Limits.cokernel.π (μ (pk (n + 1)) F) ≫ μ (pk (n + 1 + 1)) F) = 0
    rw [Category.assoc, ← Category.assoc (μ (pk (n + 1)) F), Limits.cokernel.condition,
      Limits.zero_comp, Limits.comp_zero]

  have hex : ∀ (F : Finset R) (n : ℕ), (ShortComplex.mk (dd n F) (dd (n + 1) F) (hdd F n)).Exact := by
    intro F n
    let S0 := ShortComplex.mk (μ (pk (n + 1)) F) (Limits.cokernel.π (μ (pk (n + 1)) F))
      (Limits.cokernel.condition _)
    have hS0 : S0.Exact := S0.exact_of_g_is_cokernel (Limits.cokernelIsCokernel _)
    have hz1 : dd n F ≫ Limits.cokernel.π (μ (pk (n + 1)) F) = 0 := by
      show (Limits.cokernel.π (μ (pk n) F) ≫ μ (pk (n + 1)) F) ≫
        Limits.cokernel.π (μ (pk (n + 1)) F) = 0
      rw [Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
    let S1 := ShortComplex.mk (dd n F) (Limits.cokernel.π (μ (pk (n + 1)) F)) hz1
    let φ1 : S1 ⟶ S0 :=
      { τ₁ := Limits.cokernel.π (μ (pk n) F)
        τ₂ := 𝟙 _
        τ₃ := 𝟙 _
        comm₁₂ := (Category.comp_id _).symm
        comm₂₃ := by simp only [Category.id_comp, Category.comp_id]; rfl }
    have hS1 : S1.Exact :=
      (@ShortComplex.exact_iff_of_epi_of_isIso_of_mono _ _ _ S1 S0 φ1
        (show Epi (Limits.cokernel.π (μ (pk n) F)) from inferInstance)
        (show IsIso (𝟙 _) from inferInstance) (show Mono (𝟙 _) from inferInstance)).mpr hS0
    let φ2 : S1 ⟶ ShortComplex.mk (dd n F) (dd (n + 1) F) (hdd F n) :=
      { τ₁ := 𝟙 _
        τ₂ := 𝟙 _
        τ₃ := μ (pk (n + 1 + 1)) F
        comm₁₂ := by simp only [Category.id_comp, Category.comp_id]; try rfl
        comm₂₃ := by simp only [Category.id_comp]; rfl }
    exact (@ShortComplex.exact_iff_of_epi_of_isIso_of_mono _ _ _ _ _ φ2
      (show Epi (𝟙 _) from inferInstance) (show IsIso (𝟙 _) from inferInstance)
      (hmono (pk (n + 1 + 1)) F)).mp hS1
  have h0 : ∀ F : Finset R, μ (pk 0) F ≫ dd 0 F = 0 := by
    intro F
    show μ (pk 0) F ≫ (Limits.cokernel.π (μ (pk 0) F) ≫ μ (pk (0 + 1)) F) = 0
    rw [← Category.assoc, Limits.cokernel.condition, Limits.zero_comp]
  have hex0 : ∀ F : Finset R, (ShortComplex.mk (μ (pk 0) F) (dd 0 F) (h0 F)).Exact := by
    intro F
    let S0 := ShortComplex.mk (μ (pk 0) F) (Limits.cokernel.π (μ (pk 0) F))
      (Limits.cokernel.condition _)
    have hS0 : S0.Exact := S0.exact_of_g_is_cokernel (Limits.cokernelIsCokernel _)
    let φ : S0 ⟶ ShortComplex.mk (μ (pk 0) F) (dd 0 F) (h0 F) :=
      { τ₁ := 𝟙 _
        τ₂ := 𝟙 _
        τ₃ := μ (pk (0 + 1)) F
        comm₁₂ := by simp only [Category.id_comp, Category.comp_id]; try rfl
        comm₂₃ := by simp only [Category.id_comp]; rfl }
    exact (@ShortComplex.exact_iff_of_epi_of_isIso_of_mono _ _ _ _ _ φ
      (show Epi (𝟙 _) from inferInstance) (show IsIso (𝟙 _) from inferInstance)
      (hmono (pk (0 + 1)) F)).mp hS0

  let K : ∀ F : Finset R, CochainComplex (Sheaf (Scheme.smallEtaleTopology (wcSubX R F))
      AddCommGrpCat.{u+1}) ℕ := fun F =>
    CochainComplex.of (fun n => E (pk n) F) (fun n => dd n F) (hdd F)
  have hKd : ∀ (F : Finset R) (n : ℕ), (K F).d n (n + 1) = dd n F := fun F n =>
    CochainComplex.of_d (fun n => E (pk n) F) (fun n => dd n F) n
  have hKex : ∀ (F : Finset R) (n : ℕ), (K F).ExactAt (n + 1) := by
    intro F n
    rw [HomologicalComplex.exactAt_iff' (K F) n (n + 1) (n + 1 + 1) (CochainComplex.prev_nat_succ n)
      (CochainComplex.next ℕ (n + 1))]
    let eK : ShortComplex.mk (dd n F) (dd (n + 1) F) (hdd F n) ≅ (K F).sc' n (n + 1) (n + 1 + 1) :=
      ShortComplex.isoMk (Iso.refl _) (Iso.refl _) (Iso.refl _)
        (by
          simp only [Iso.refl_hom, Category.id_comp, Category.comp_id]
          try exact hKd F n)
        (by
          simp only [Iso.refl_hom, Category.id_comp, Category.comp_id]
          try exact hKd F (n + 1))
    exact (ShortComplex.exact_iff_of_iso eK).mp (hex F n)
  have hμ : ∀ F : Finset R, μ (pk 0) F ≫ (K F).d 0 1 = 0 := fun F => by
    rw [show (K F).d 0 1 = dd 0 F from hKd F 0]
    exact h0 F
  let ι : ∀ F : Finset R, (CochainComplex.single₀ _).obj (wcConstZ (wcSubX R F) m) ⟶ K F :=
    fun F => ((K F).fromSingle₀Equiv _).symm ⟨μ (pk 0) F, hμ F⟩
  have hιf : ∀ F : Finset R, (ι F).f 0 = μ (pk 0) F := fun F =>
    CochainComplex.fromSingle₀Equiv_symm_apply_f_zero _ _
  have hqis : ∀ F : Finset R, QuasiIso (ι F) := by
    intro F
    rw [quasiIso_iff]
    intro i
    cases i with
    | succ n =>
      exact (quasiIsoAt_iff_exactAt (ι F) (n + 1)
        (CochainComplex.exactAt_succ_single_obj _ n)).mpr (hKex F n)
    | zero =>
      refine (CochainComplex.quasiIsoAt₀_iff (ι F)).mpr
        ((ShortComplex.quasiIso_iff_of_zeros _ ?_ ?_ ?_).mpr ⟨?_, ?_⟩)
      · exact HomologicalComplex.single_obj_d (ComplexShape.up ℕ) 0 _ _ _
      · exact HomologicalComplex.single_obj_d (ComplexShape.up ℕ) 0 _ _ _
      · exact (K F).shape 0 0 (by simp)
      · refine (ShortComplex.exact_iff_of_iso (ShortComplex.isoMk
          (S₁ := ShortComplex.mk (μ (pk 0) F) (dd 0 F) (h0 F)) (Iso.refl _) (Iso.refl _)
          (Iso.refl _) ?_ ?_)).mp (hex0 F)
        · simp only [Iso.refl_hom, Category.id_comp, Category.comp_id]
          try exact hιf F
        · simp only [Iso.refl_hom, Category.id_comp, Category.comp_id]
          try exact hKd F 0
      · show Mono ((ι F).f 0)
        rw [hιf F]
        exact hmono (pk 0) F
  let I : ∀ F : Finset R, InjectiveResolution (wcConstZ (wcSubX R F) m) := fun F =>
    { cocomplex := K F
      injective := fun n => hinj (pk n) F
      ι := ι F
      quasiIso := hqis F }
  have haug : ∀ F : Finset R, wcInjAug (I F) = μ (pk 0) F := by
    intro F
    show (HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 _).inv ≫ (ι F).f 0 = μ (pk 0) F
    rw [CochainComplex.single₀ObjXSelf, Iso.refl_inv]
    exact (Category.id_comp ((ι F).f 0)).trans (hιf F)
  refine ⟨I, fun n F F' h => ε (pk n) F F' h, fun n => hcohE (pk n), ?_, ?_⟩
  · intro n F F' h V O k hk x
    have e1 : (I F).cocomplex.d n (n + 1) = dd n F := hKd F n
    have e2 : (I F').cocomplex.d n (n + 1) = dd n F' := hKd F' n
    rw [e1, e2]
    exact (hcompE (pk (n + 1)) F F' h V O k hk _).trans
      (congrArg (fun z => ((μ (pk (n + 1)) F').hom.app (Opposite.op O)).hom z)
        (hπ (pk n) F F' h V O k hk x))
  · intro F F' h V O k hk a
    rw [haug F, haug F']
    exact (hcompE (pk 0) F F' h V O k hk _).trans
      (congrArg (fun z => ((μ (pk 0) F').hom.app (Opposite.op O)).hom z)
        (hηΛ F F' h V O k hk a))

theorem wc_subring_colim_sheaf_exists : ∀ (R : Type u) [CommRing R]
    (G : ∀ F : Finset R, Sheaf (Scheme.smallEtaleTopology (wcSubX R F)) AddCommGrpCat.{u+1})
    (e : ∀ (F F' : Finset R) (h : F ⊆ F'), wcEtTransport (wcSubT R h) (G F) (G F')),
    wcSubCoherent R G e →
    ∃ (H : Sheaf (Scheme.smallEtaleTopology (Spec (.of R))) AddCommGrpCat.{u+1})
      (σ : ∀ F : Finset R, wcEtTransport (wcSubP R F) (G F) H),
      wcSubCocone R G e H σ ∧ wcSubLocGen R G H σ ∧ wcSubLocKer R G e H σ ∧
      ∀ (H' : Sheaf (Scheme.smallEtaleTopology (Spec (.of R))) AddCommGrpCat.{u+1})
        (σ' : ∀ F : Finset R, wcEtTransport (wcSubP R F) (G F) H'), wcSubCocone R G e H' σ' →
        ∃! φ : H ⟶ H', ∀ (F : Finset R) (V : (wcSubX R F).Etale) (U : (Spec (.of R)).Etale)
          (k : U.left ⟶ V.left) (hk : k ≫ V.hom = U.hom ≫ wcSubP R F)
          (x : (G F).obj.obj (Opposite.op V)),
          (φ.hom.app (Opposite.op U)).hom ((σ F).ρ V U k hk x) = (σ' F).ρ V U k hk x :=
by
  intro R _ G e hcoh
  classical

  choose L u hu using fun F : Finset R => wc_et_pullback_transport_exists (wcSubP R F) (G F)

  have hPT : ∀ {F F' : Finset R} (h : F ⊆ F'), wcSubP R F' ≫ wcSubT R h = wcSubP R F := by
    intro F F' h
    show Spec.map _ ≫ Spec.map _ = Spec.map _
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have e1 : (Subring.closure (F' : Set R)).subtype.comp
        (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h))) =
        (Subring.closure (F : Set R)).subtype := by
      apply RingHom.ext
      intro x
      simp
    rw [e1]
  have hTT : ∀ {F F' F'' : Finset R} (h₁ : F ⊆ F') (h₂ : F' ⊆ F''),
      wcSubT R h₂ ≫ wcSubT R h₁ = wcSubT R (Finset.Subset.trans h₁ h₂) := by
    intro F F' F'' h₁ h₂
    show Spec.map _ ≫ Spec.map _ = Spec.map _
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have e2 : (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h₂))).comp
        (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h₁))) =
        Subring.inclusion (Subring.closure_mono
          (Finset.coe_subset.mpr (Finset.Subset.trans h₁ h₂))) := by
      apply RingHom.ext
      intro x
      apply Subtype.ext
      simp
    rw [e2]
  have hT : ∀ F : Finset R, wcSubT R (Finset.Subset.refl F) = 𝟙 (wcSubX R F) := by
    intro F
    have e3 : Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr
        (Finset.Subset.refl F))) = RingHom.id _ := by
      apply RingHom.ext
      intro x
      rfl
    show Spec.map (CommRingCat.ofHom (Subring.inclusion (Subring.closure_mono
      (Finset.coe_subset.mpr (Finset.Subset.refl F))))) = 𝟙 (wcSubX R F)
    rw [e3, CommRingCat.ofHom_id, Spec.map_id]

  have bc : ∀ {F F' : Finset R} (h : F ⊆ F') (V : (wcSubX R F).Etale) (U : (Spec (.of R)).Etale)
      (k₀ : U.left ⟶ V.left), k₀ ≫ V.hom = U.hom ≫ wcSubP R F →
      ∃ (O : (wcSubX R F').Etale) (h' : O.left ⟶ V.left) (hh' : h' ≫ V.hom = O.hom ≫ wcSubT R h)
        (k : U.left ⟶ O.left) (hk : k ≫ O.hom = U.hom ≫ wcSubP R F'), k ≫ h' = k₀ := by
    intro F F' h V U k₀ hk₀
    have hc : k₀ ≫ V.hom = (U.hom ≫ wcSubP R F') ≫ wcSubT R h := by
      rw [hk₀, Category.assoc, hPT h]
    have pc : Limits.pullback.fst V.hom (wcSubT R h) ≫ V.hom =
        ((wcEtBaseChange (wcSubT R h)).obj V).hom ≫ wcSubT R h := by
      change Limits.pullback.fst V.hom (wcSubT R h) ≫ V.hom =
        Limits.pullback.snd V.hom (wcSubT R h) ≫ wcSubT R h
      exact Limits.pullback.condition
    exact ⟨(wcEtBaseChange (wcSubT R h)).obj V, Limits.pullback.fst V.hom (wcSubT R h), pc,
      Limits.pullback.lift k₀ (U.hom ≫ wcSubP R F') hc,
      Limits.pullback.lift_snd _ _ _, Limits.pullback.lift_fst _ _ _⟩

  have comp_ex : ∀ {Y Z W : Scheme.{u}} (g : Y ⟶ Z) (h : Z ⟶ W) (p : Y ⟶ W), g ≫ h = p →
      ∀ (A : Sheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1})
        (B : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
        (C : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
        (σ : wcEtTransport h A B) (κ : wcEtTransport g B C),
      ∃ μ : wcEtTransport p A C,
        ∀ (V : W.Etale) (O : Z.Etale) (h' : O.left ⟶ V.left) (hh' : h' ≫ V.hom = O.hom ≫ h)
          (O₂ : Y.Etale) (k : O₂.left ⟶ O.left) (hk : k ≫ O.hom = O₂.hom ≫ g)
          (k₀ : O₂.left ⟶ V.left) (hk₀ : k₀ ≫ V.hom = O₂.hom ≫ p),
          k ≫ h' = k₀ → ∀ x : A.obj.obj (Opposite.op V),
            μ.ρ V O₂ k₀ hk₀ x = κ.ρ O O₂ k hk (σ.ρ V O h' hh' x) := by
    intro Y Z W g h p hp A B C σ κ
    subst hp
    have pc : ∀ V : W.Etale,
        Limits.pullback.fst V.hom h ≫ V.hom = ((wcEtBaseChange h).obj V).hom ≫ h := by
      intro V
      change Limits.pullback.fst V.hom h ≫ V.hom = Limits.pullback.snd V.hom h ≫ h
      exact Limits.pullback.condition
    have hk1 : ∀ (V : W.Etale) (O : Y.Etale) (k : O.left ⟶ V.left),
        k ≫ V.hom = O.hom ≫ (g ≫ h) → k ≫ V.hom = (O.hom ≫ g) ≫ h :=
      fun V O k hk => hk.trans (Category.assoc _ _ _).symm
    let ℓ : ∀ (V : W.Etale) (O : Y.Etale) (k : O.left ⟶ V.left),
        k ≫ V.hom = O.hom ≫ (g ≫ h) → (O.left ⟶ ((wcEtBaseChange h).obj V).left) :=
      fun V O k hk => Limits.pullback.lift k (O.hom ≫ g) (hk1 V O k hk)
    have hℓ : ∀ (V : W.Etale) (O : Y.Etale) (k : O.left ⟶ V.left)
        (hk : k ≫ V.hom = O.hom ≫ (g ≫ h)),
        ℓ V O k hk ≫ ((wcEtBaseChange h).obj V).hom = O.hom ≫ g := by
      intro V O k hk
      exact Limits.pullback.lift_snd _ _ _
    let μ : wcEtTransport (g ≫ h) A C :=
      { ρ := fun V O k hk =>
          (κ.ρ ((wcEtBaseChange h).obj V) O (ℓ V O k hk) (hℓ V O k hk)).comp
            (σ.ρ V ((wcEtBaseChange h).obj V) (Limits.pullback.fst V.hom h) (pc V))
        nat := by
          intro V V' c O O' d k hk k' hk' hc x
          have KSI0 : Limits.pullback.fst V'.hom h ≫ c.left =
              ((wcEtBaseChange h).map c).left ≫ Limits.pullback.fst V.hom h := by
            change Limits.pullback.fst V'.hom h ≫ c.left =
              Limits.pullback.lift (Limits.pullback.fst V'.hom h ≫ c.left)
                (Limits.pullback.snd V'.hom h)
                (by rw [Category.assoc, MorphismProperty.Over.w c]; exact Limits.pullback.condition) ≫
                Limits.pullback.fst V.hom h
            rw [Limits.pullback.lift_fst]
          have KSI1 : ℓ V' O' k' hk' ≫ ((wcEtBaseChange h).map c).left = d.left ≫ ℓ V O k hk := by
            change Limits.pullback.lift k' (O'.hom ≫ g) (hk1 V' O' k' hk') ≫
                Limits.pullback.lift (Limits.pullback.fst V'.hom h ≫ c.left)
                  (Limits.pullback.snd V'.hom h)
                  (by rw [Category.assoc, MorphismProperty.Over.w c]; exact Limits.pullback.condition) =
              d.left ≫ Limits.pullback.lift k (O.hom ≫ g) (hk1 V O k hk)
            apply Limits.pullback.hom_ext
            · simp only [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_fst_assoc]
              exact hc
            · simp only [Category.assoc, Limits.pullback.lift_snd]
              rw [← Category.assoc d.left, MorphismProperty.Over.w d]
          have hs := σ.nat V V' c ((wcEtBaseChange h).obj V) ((wcEtBaseChange h).obj V')
            ((wcEtBaseChange h).map c) _ (pc V) _ (pc V') KSI0 x
          have hk2 := κ.nat ((wcEtBaseChange h).obj V) ((wcEtBaseChange h).obj V')
            ((wcEtBaseChange h).map c) O O' d _ (hℓ V O k hk) _ (hℓ V' O' k' hk') KSI1
            (σ.ρ V ((wcEtBaseChange h).obj V) (Limits.pullback.fst V.hom h) (pc V) x)
          change κ.ρ _ O' (ℓ V' O' k' hk') (hℓ V' O' k' hk')
              (σ.ρ V' _ (Limits.pullback.fst V'.hom h) (pc V') (A.obj.map c.op x)) =
            C.obj.map d.op (κ.ρ _ O (ℓ V O k hk) (hℓ V O k hk)
              (σ.ρ V _ (Limits.pullback.fst V.hom h) (pc V) x))
          exact (congrArg (fun y => κ.ρ ((wcEtBaseChange h).obj V') O' (ℓ V' O' k' hk')
            (hℓ V' O' k' hk') y) hs).trans hk2 }
    refine ⟨μ, ?_⟩
    intro V O h' hh O₂ k hk k₀ hk₀ heq x
    subst heq
    let m : O ⟶ (wcEtBaseChange h).obj V :=
      MorphismProperty.Over.homMk (Limits.pullback.lift h' O.hom hh)
        (Limits.pullback.lift_snd _ _ _) trivial
    have M1 : h' ≫ (𝟙 V : V ⟶ V).left = m.left ≫ Limits.pullback.fst V.hom h := by
      change h' ≫ 𝟙 V.left = Limits.pullback.lift h' O.hom hh ≫ Limits.pullback.fst V.hom h
      rw [Category.comp_id, Limits.pullback.lift_fst]
    have M2 : k ≫ m.left = (𝟙 O₂ : O₂ ⟶ O₂).left ≫ ℓ V O₂ (k ≫ h') hk₀ := by
      change k ≫ Limits.pullback.lift h' O.hom hh =
        𝟙 O₂.left ≫ Limits.pullback.lift (k ≫ h') (O₂.hom ≫ g) (hk1 V O₂ (k ≫ h') hk₀)
      rw [Category.id_comp]
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc, Limits.pullback.lift_fst]
      · simp only [Category.assoc, Limits.pullback.lift_snd]
        exact hk
    have hs := σ.nat V V (𝟙 V) ((wcEtBaseChange h).obj V) O m
      (Limits.pullback.fst V.hom h) (pc V) h' hh M1 x
    have hI : A.obj.map (𝟙 V).op x = x := by
      rw [op_id, CategoryTheory.Functor.map_id]
      rfl
    rw [hI] at hs
    have hk2 := κ.nat ((wcEtBaseChange h).obj V) O m O₂ O₂ (𝟙 O₂)
      (ℓ V O₂ (k ≫ h') hk₀) (hℓ V O₂ (k ≫ h') hk₀) k hk M2
      (σ.ρ V ((wcEtBaseChange h).obj V) (Limits.pullback.fst V.hom h) (pc V) x)
    have hJ : ∀ y : C.obj.obj (Opposite.op O₂), C.obj.map (𝟙 O₂).op y = y := by
      intro y
      rw [op_id, CategoryTheory.Functor.map_id]
      rfl
    rw [hJ] at hk2
    exact hk2.symm.trans (congrArg (fun y => κ.ρ O O₂ k hk y) hs.symm)
  choose θ hθ using fun (F F' : Finset R) (h : F ⊆ F') =>
    comp_ex (wcSubP R F') (wcSubT R h) (wcSubP R F) (hPT h) (G F) (G F') (L F') (e F F' h) (u F')

  choose φ hφP using fun (F F' : Finset R) (h : F ⊆ F') => ((hu F) (L F') (θ F F' h)).exists
  have hφ : ∀ (F F' : Finset R) (h : F ⊆ F') (V : (wcSubX R F).Etale) (O : (wcSubX R F').Etale)
      (h' : O.left ⟶ V.left) (hh' : h' ≫ V.hom = O.hom ≫ wcSubT R h)
      (U : (Spec (.of R)).Etale) (k : U.left ⟶ O.left) (hk : k ≫ O.hom = U.hom ≫ wcSubP R F')
      (k₀ : U.left ⟶ V.left) (hk₀ : k₀ ≫ V.hom = U.hom ≫ wcSubP R F),
      k ≫ h' = k₀ → ∀ x : (G F).obj.obj (Opposite.op V),
        ((φ F F' h).hom.app (Opposite.op U)).hom ((u F).ρ V U k₀ hk₀ x) =
          (u F').ρ O U k hk ((e F F' h).ρ V O h' hh' x) := by
    intro F F' h V O h' hh' U k hk k₀ hk₀ heq x
    rw [hφP F F' h V U k₀ hk₀ x]
    exact hθ F F' h V O h' hh' U k hk k₀ hk₀ heq x
  have hφid : ∀ F : Finset R, φ F F (Finset.Subset.refl F) = 𝟙 (L F) := by
    intro F
    apply ((hu F) (L F) (θ F F (Finset.Subset.refl F))).unique (hφP F F _)
    intro V U k₀ hk₀ x
    have hh' : (𝟙 V : V ⟶ V).left ≫ V.hom = V.hom ≫ wcSubT R (Finset.Subset.refl F) := by
      rw [hT F]
      exact (Category.id_comp V.hom).trans (Category.comp_id V.hom).symm
    have heq : k₀ ≫ (𝟙 V : V ⟶ V).left = k₀ := by
      show k₀ ≫ 𝟙 V.left = k₀
      exact Category.comp_id _
    rw [hθ F F _ V V _ hh' U k₀ hk₀ k₀ hk₀ heq x, hcoh.1 F V V (𝟙 V) hh' x]
    have e1 : ((G F).obj.map (𝟙 V).op).hom x = x := by
      rw [op_id, CategoryTheory.Functor.map_id]
      rfl
    rw [e1]
    rfl
  have hφcomp : ∀ (F F' F'' : Finset R) (h₁ : F ⊆ F') (h₂ : F' ⊆ F''),
      φ F F'' (Finset.Subset.trans h₁ h₂) = φ F F' h₁ ≫ φ F' F'' h₂ := by
    intro F F' F'' h₁ h₂
    apply ((hu F) (L F'') (θ F F'' (Finset.Subset.trans h₁ h₂))).unique (hφP F F'' _)
    intro V U k₀ hk₀ x
    obtain ⟨O, f₁, hf₁, k₁, hk₁, hk₁e⟩ := bc h₁ V U k₀ hk₀
    obtain ⟨O', f₂, hf₂, k₂, hk₂, hk₂e⟩ := bc h₂ O U k₁ hk₁
    have hcoc := hcoh.2 F F' F'' h₁ h₂ V O f₁ hf₁ O' f₂ hf₂ x
    have hh12 : (f₂ ≫ f₁) ≫ V.hom = O'.hom ≫ wcSubT R (Finset.Subset.trans h₁ h₂) := by
      rw [Category.assoc, hf₁, ← Category.assoc, hf₂, Category.assoc, hTT h₁ h₂]
    have heq : k₂ ≫ (f₂ ≫ f₁) = k₀ := by
      rw [← Category.assoc, hk₂e, hk₁e]
    show ((φ F' F'' h₂).hom.app (Opposite.op U)).hom
      (((φ F F' h₁).hom.app (Opposite.op U)).hom ((u F).ρ V U k₀ hk₀ x)) = _
    rw [hφ F F' h₁ V O f₁ hf₁ U k₁ hk₁ k₀ hk₀ hk₁e x,
      hφ F' F'' h₂ O O' f₂ hf₂ U k₂ hk₂ k₁ hk₁ hk₂e, ← hcoc,
      hθ F F'' (Finset.Subset.trans h₁ h₂) V O' (f₂ ≫ f₁) hh12 U k₂ hk₂ k₀ hk₀ heq x]

  let D : ULift.{u+1} (Finset R) ⥤ Sheaf (Scheme.smallEtaleTopology (Spec (.of R)))
      AddCommGrpCat.{u+1} :=
    { obj := fun i => L i.down
      map := fun {i j} f => φ i.down j.down (show i.down ⊆ j.down from (leOfHom f : i ≤ j))
      map_id := fun i => hφid i.down
      map_comp := fun {i j k} f g => hφcomp i.down j.down k.down _ _ }

  let σ : ∀ F : Finset R, wcEtTransport (wcSubP R F) (G F) (Limits.colimit D) := fun F =>
    { ρ := fun V U k hk =>
        ((Limits.colimit.ι D (ULift.up F)).hom.app (Opposite.op U)).hom.comp ((u F).ρ V U k hk)
      nat := by
        intro V V' c O O' d h hh h' hh' hc x
        show ((Limits.colimit.ι D (ULift.up F)).hom.app (Opposite.op O')).hom
            ((u F).ρ V' O' h' hh' ((G F).obj.map c.op x)) =
          ((Limits.colimit D).obj.map d.op).hom
            (((Limits.colimit.ι D (ULift.up F)).hom.app (Opposite.op O)).hom ((u F).ρ V O h hh x))
        rw [(u F).nat V V' c O O' d h hh h' hh' hc x]
        exact congrArg (fun ψ => AddCommGrpCat.Hom.hom ψ ((u F).ρ V O h hh x))
          ((Limits.colimit.ι D (ULift.up F)).hom.naturality d.op) }

  have hcone : wcSubCocone R G e (Limits.colimit D) σ := by
    intro F F' h V O h' hh U k hk x
    have hk0 : (k ≫ h') ≫ V.hom = U.hom ≫ wcSubP R F := by
      rw [Category.assoc, hh, ← Category.assoc, hk, Category.assoc, hPT h]
    have h1 := hφ F F' h V O h' hh U k hk (k ≫ h') hk0 rfl x
    have h2 := congrArg (fun ψ => (ψ.hom.app (Opposite.op U)).hom ((u F).ρ V U (k ≫ h') hk0 x))
      (Limits.colimit.w D (homOfLE (ULift.up_le.mpr h)))
    exact h2.symm.trans
      (congrArg (((Limits.colimit.ι D (ULift.up F')).hom.app (Opposite.op U)).hom) h1)

  have hdict : ∀ (V : (Spec (.of R)).Etale) (S : Sieve V),
      S ∈ Scheme.smallEtaleTopology (Spec (.of R)) V →
      ∀ x : V.left, ∃ (W : (Spec (.of R)).Etale) (g : W ⟶ V) (y : W.left),
        S.arrows g ∧ Etale g.left ∧ g.left y = x := by
    intro V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale (Spec (.of R)) V at hS
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale
      (Spec (.of R)) MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _
      le_rfl] at hS
    exact (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale (Spec (.of R))
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V S).mp hS
  have hloc := wc_et_sheaf_colimit_cocone_local (Spec (.of R)) (ULift.{u+1} (Finset R)) D

  have hgen : wcSubLocGen R G (Limits.colimit D) σ := by
    intro U s x₀
    obtain ⟨V₁, c₁, v₁, hc₁, -, hv₁⟩ := hdict U _ (hloc.1 U s) x₀
    rw [Sieve.generate_apply] at hc₁
    obtain ⟨V', a, g', ⟨i, t, ht⟩, hag⟩ := hc₁
    obtain ⟨O', d, o', W, hW, hhW, y, hdo, hdy⟩ :=
      wc_et_univ_transport_locally_surjective (wcSubP R i.down) (G i.down) (D.obj i) (u i.down)
        (hu i.down) V' t (a.left v₁)
    refine ⟨O', d ≫ g', o', i.down, W, hW, hhW, y, ?_, ?_⟩
    · have e1 : (d ≫ g').left = d.left ≫ g'.left := rfl
      have e2 : (a ≫ g').left = a.left ≫ g'.left := rfl
      rw [e1, Scheme.Hom.comp_apply, hdo, ← Scheme.Hom.comp_apply, ← e2, hag, hv₁]
    · have n1 := congrArg (fun ψ => AddCommGrpCat.Hom.hom ψ t)
        ((Limits.colimit.ι D i).hom.naturality d.op)
      have n2 : ((Limits.colimit D).obj.map (d ≫ g').op).hom s =
          ((Limits.colimit D).obj.map d.op).hom (((Limits.colimit D).obj.map g'.op).hom s) := by
        rw [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply]
      rw [n2, ← ht]
      show ((Limits.colimit.ι D i).hom.app (Opposite.op O')).hom ((u i.down).ρ W O' hW hhW y) = _
      rw [← hdy]
      exact n1

  have hker : wcSubLocKer R G e (Limits.colimit D) σ := by
    intro F V U k hk t ht x₀
    have ha : ((Limits.colimit.ι D (ULift.up F)).hom.app (Opposite.op U)).hom
        ((u F).ρ V U k hk t) = 0 := ht
    obtain ⟨W₁, c₁, w₁, hc₁, -, hw₁⟩ := hdict U _ (hloc.2 (ULift.up F) U ((u F).ρ V U k hk t) ha) x₀
    rw [Sieve.generate_apply] at hc₁
    obtain ⟨V₁, a', g', ⟨j, f, hjf⟩, hag⟩ := hc₁
    obtain ⟨F'⟩ := j
    have hF : F ⊆ F' := (leOfHom f : (ULift.up F : ULift.{u+1} (Finset R)) ≤ ULift.up F')
    have hk1 : (g'.left ≫ k) ≫ V.hom = V₁.hom ≫ wcSubP R F := by
      rw [Category.assoc, hk, ← Category.assoc, MorphismProperty.Over.w g']
    have hres : ((D.obj (ULift.up F)).obj.map g'.op).hom ((u F).ρ V U k hk t) =
        (u F).ρ V V₁ (g'.left ≫ k) hk1 t := by
      have := (u F).nat V V (𝟙 V) U V₁ g' k hk (g'.left ≫ k) hk1
        (by show (g'.left ≫ k) ≫ 𝟙 V.left = g'.left ≫ k; exact Category.comp_id _) t
      rw [op_id, CategoryTheory.Functor.map_id] at this
      exact this.symm
    obtain ⟨O, fO, hfO, k₁, hk₁, hk₁e⟩ := bc hF V V₁ (g'.left ≫ k) hk1
    have h0 : (u F').ρ O V₁ k₁ hk₁ ((e F F' hF).ρ V O fO hfO t) = 0 := by
      rw [← hφ F F' hF V O fO hfO V₁ k₁ hk₁ (g'.left ≫ k) hk1 hk₁e t, ← hres]
      exact hjf
    obtain ⟨V'', c'', v'', hcv, hv0⟩ := wc_et_univ_transport_locally_injective (wcSubP R F')
      (G F') (L F') (u F') (hu F') O V₁ k₁ hk₁ ((e F F' hF).ρ V O fO hfO t) (a'.left w₁) h0
    have hk'' : (c''.left ≫ fO) ≫ V.hom = V''.hom ≫ wcSubT R hF := by
      rw [Category.assoc, hfO, ← Category.assoc, MorphismProperty.Over.w c'']
    have hvan : (e F F' hF).ρ V V'' (c''.left ≫ fO) hk'' t = 0 := by
      have := (e F F' hF).nat V V (𝟙 V) O V'' c'' fO hfO (c''.left ≫ fO) hk''
        (by show (c''.left ≫ fO) ≫ 𝟙 V.left = c''.left ≫ fO; exact Category.comp_id _) t
      rw [op_id, CategoryTheory.Functor.map_id] at this
      exact this.trans hv0
    let U' : (Spec (.of R)).Etale :=
      MorphismProperty.Over.mk ⊤ (Limits.pullback.fst k₁ c''.left ≫ V₁.hom) inferInstance
    let c : U' ⟶ U := MorphismProperty.Over.homMk (Limits.pullback.fst k₁ c''.left ≫ g'.left)
      (by
        show (Limits.pullback.fst k₁ c''.left ≫ g'.left) ≫ U.hom =
          Limits.pullback.fst k₁ c''.left ≫ V₁.hom
        rw [Category.assoc, MorphismProperty.Over.w g'])
      trivial
    obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := k₁) (g := c''.left)
      (a'.left w₁) v'' hcv.symm
    have hk' : Limits.pullback.snd k₁ c''.left ≫ V''.hom = U'.hom ≫ wcSubP R F' := by
      show _ = (Limits.pullback.fst k₁ c''.left ≫ V₁.hom) ≫ wcSubP R F'
      rw [← MorphismProperty.Over.w c'', ← Category.assoc, ← Limits.pullback.condition,
        Category.assoc, hk₁, Category.assoc]
    have hkk : Limits.pullback.snd k₁ c''.left ≫ (c''.left ≫ fO) = c.left ≫ k := by
      show _ = (Limits.pullback.fst k₁ c''.left ≫ g'.left) ≫ k
      rw [← Category.assoc, ← Limits.pullback.condition, Category.assoc, hk₁e, Category.assoc]
    refine ⟨U', c, z, F', hF, V'', Limits.pullback.snd k₁ c''.left, hk', c''.left ≫ fO, hk'',
      ?_, hkk, hvan⟩
    have e1 : c.left = Limits.pullback.fst k₁ c''.left ≫ g'.left := rfl
    have e2 : (a' ≫ g').left = a'.left ≫ g'.left := rfl
    rw [e1]
    refine (Scheme.Hom.comp_apply (Limits.pullback.fst k₁ c''.left) g'.left z).trans ?_
    rw [hz1]
    refine (Scheme.Hom.comp_apply a'.left g'.left w₁).symm.trans ?_
    rw [← e2, hag, hw₁]

  have huniv : ∀ (H' : Sheaf (Scheme.smallEtaleTopology (Spec (.of R))) AddCommGrpCat.{u+1})
      (σ' : ∀ F : Finset R, wcEtTransport (wcSubP R F) (G F) H'), wcSubCocone R G e H' σ' →
      ∃! φ' : Limits.colimit D ⟶ H', ∀ (F : Finset R) (V : (wcSubX R F).Etale)
        (U : (Spec (.of R)).Etale) (k : U.left ⟶ V.left) (hk : k ≫ V.hom = U.hom ≫ wcSubP R F)
        (x : (G F).obj.obj (Opposite.op V)),
        (φ'.hom.app (Opposite.op U)).hom ((σ F).ρ V U k hk x) = (σ' F).ρ V U k hk x := by
    intro H' σ' hσ'
    choose ψ hψ using fun F : Finset R => ((hu F) H' (σ' F)).exists
    have hcomp : ∀ (F F' : Finset R) (hF : F ⊆ F'), φ F F' hF ≫ ψ F' = ψ F := by
      intro F F' hF
      apply ((hu F) H' (σ' F)).unique _ (hψ F)
      intro V U k hk x
      obtain ⟨O, fO, hfO, k₁, hk₁, hk₁e⟩ := bc hF V U k hk
      show ((ψ F').hom.app (Opposite.op U)).hom
        (((φ F F' hF).hom.app (Opposite.op U)).hom ((u F).ρ V U k hk x)) = _
      rw [hφ F F' hF V O fO hfO U k₁ hk₁ k hk hk₁e x, hψ F' O U k₁ hk₁]
      rw [← hσ' F F' hF V O fO hfO U k₁ hk₁ x]
      subst hk₁e
      rfl
    let c : Limits.Cocone D :=
      { pt := H'
        ι :=
          { app := fun i => ψ i.down
            naturality := fun i j f => by
              show φ i.down j.down _ ≫ ψ j.down = ψ i.down ≫ 𝟙 H'
              rw [Category.comp_id]
              exact hcomp _ _ _ } }
    refine ⟨Limits.colimit.desc D c, ?_, ?_⟩
    · intro F V U k hk x
      have h1 := congrArg (fun ψ' => (ψ'.hom.app (Opposite.op U)).hom ((u F).ρ V U k hk x))
        (Limits.colimit.ι_desc c (ULift.up F))
      exact h1.trans (hψ F V U k hk x)
    · intro φ' hφ'
      apply Limits.colimit.hom_ext
      intro i
      rw [Limits.colimit.ι_desc]
      apply ((hu i.down) H' (σ' i.down)).unique _ (hψ i.down)
      intro V U k hk x
      exact hφ' i.down V U k hk x
  exact ⟨Limits.colimit D, σ, hcone, hgen, hker, huniv⟩

theorem wc_et_affine_finite_refine : ∀ (Y : Scheme.{u}) (U : Y.Etale), CompactSpace U.left →
    ∀ (Q : ∀ U' : Y.Etale, (U' ⟶ U) → Prop),
    (∀ (U' U'' : Y.Etale) (c : U' ⟶ U) (d : U'' ⟶ U'), Q U' c → Q U'' (d ≫ c)) →
    (∀ u : U.left, ∃ (U' : Y.Etale) (c : U' ⟶ U) (u' : U'.left), c.left u' = u ∧ Q U' c) →
    ∃ (N : ℕ) (W : Fin N → Y.Etale) (c : ∀ i, W i ⟶ U), (∀ i, IsAffine (W i).left) ∧
      (∀ i, Q (W i) (c i)) ∧ ∀ u : U.left, ∃ (i : Fin N) (w : (W i).left), (c i).left w = u :=
by
  intro Y U hU Q hQs hQl
  have hNbhd : ∀ y : U.left, ∃ (V : Y.Etale) (f : V ⟶ U),
      Q V f ∧ IsAffine V.left ∧ y ∈ Set.range f.left := by
    intro y
    obtain ⟨Y', g, w, hw, hg⟩ := hQl y
    obtain ⟨a, ha⟩ := Y'.left.affineCover.covers w
    haveI : Etale Y'.hom := Y'.prop
    let V : Y.Etale := MorphismProperty.Over.mk ⊤
      (Y'.left.affineCover.f (Y'.left.affineCover.idx w) ≫ Y'.hom)
      (inferInstance : Etale (Y'.left.affineCover.f (Y'.left.affineCover.idx w) ≫ Y'.hom))
    let h : V ⟶ Y' := MorphismProperty.Over.homMk
      (Y'.left.affineCover.f (Y'.left.affineCover.idx w)) rfl trivial
    refine ⟨V, h ≫ g, hQs Y' V g h hg, ?_, ⟨a, ?_⟩⟩
    · show IsAffine (Y'.left.affineCover.X (Y'.left.affineCover.idx w))
      infer_instance
    · change g.left (Y'.left.affineCover.f (Y'.left.affineCover.idx w) a) = y
      rw [ha, hw]
  choose Vy fy hQ' hA hy using hNbhd
  have hopen : ∀ y, Set.range (fy y).left ∈ nhds y := fun y =>
    ((fy y).left.isOpenMap.isOpen_range).mem_nhds (hy y)
  obtain ⟨t, ht⟩ := CompactSpace.elim_nhds_subcover _ hopen
  classical
  refine ⟨t.card, fun i => Vy (t.equivFin.symm i).1, fun i => fy (t.equivFin.symm i).1,
    fun i => hA _, fun i => hQ' _, ?_⟩
  intro x
  have hx : x ∈ ⋃ y ∈ t, Set.range (fy y).left := by rw [ht]; trivial
  obtain ⟨y, hyt, hxy⟩ := Set.mem_iUnion₂.mp hx
  have key : ∀ z : t, z = ⟨y, hyt⟩ → x ∈ Set.range (fy z.1).left := by
    rintro _ rfl
    exact hxy
  obtain ⟨w, hw⟩ := key _ (Equiv.symm_apply_apply t.equivFin ⟨y, hyt⟩)
  exact ⟨t.equivFin ⟨y, hyt⟩, w, hw⟩

theorem wc_subring_cover_descend : ∀ (R : Type u) [CommRing R] (U : (Spec (.of R)).Etale)
    (F : Finset R) (O : (wcSubX R F).Etale) (kO : U.left ⟶ O.left),
    IsAffine O.left → IsPullback kO U.hom O.hom (wcSubP R F) →
    ∀ (N : ℕ) (Y : Fin N → (wcSubX R F).Etale) (w : ∀ j, Y j ⟶ O),
    (∀ x : U.left, ∃ (j : Fin N) (y : (Y j).left), (w j).left y = kO x) →
    ∃ (F' : Finset R) (h : F ⊆ F'), ∀ (F'' : Finset R) (h' : F' ⊆ F'') (O'' : (wcSubX R F'').Etale)
      (k₂ : O''.left ⟶ O.left), IsPullback k₂ O''.hom O.hom (wcSubT R (Finset.Subset.trans h h')) →
      ∀ z : O''.left, ∃ (j : Fin N) (y : (Y j).left), (w j).left y = k₂ z :=
by
  classical
  intro R _ U F O kO hO hpb N Y w hcov

  have hPT : ∀ {F₁ F₂ : Finset R} (h : F₁ ⊆ F₂), wcSubP R F₂ ≫ wcSubT R h = wcSubP R F₁ := by
    intro F₁ F₂ h
    show Spec.map _ ≫ Spec.map _ = Spec.map _
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have e1 : (Subring.closure (F₂ : Set R)).subtype.comp
        (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h))) =
        (Subring.closure (F₁ : Set R)).subtype := by
      apply RingHom.ext
      intro x
      simp
    rw [e1]
  have hTT : ∀ {F₁ F₂ F₃ : Finset R} (h₁ : F₁ ⊆ F₂) (h₂ : F₂ ⊆ F₃),
      wcSubT R h₂ ≫ wcSubT R h₁ = wcSubT R (Finset.Subset.trans h₁ h₂) := by
    intro F₁ F₂ F₃ h₁ h₂
    show Spec.map _ ≫ Spec.map _ = Spec.map _
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have e2 : (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h₂))).comp
        (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h₁))) =
        Subring.inclusion (Subring.closure_mono
          (Finset.coe_subset.mpr (Finset.Subset.trans h₁ h₂))) := by
      apply RingHom.ext
      intro x
      apply Subtype.ext
      simp
    rw [e2]
  have hID : ∀ G : Finset R, wcSubT R (Finset.Subset.refl G) = 𝟙 (wcSubX R G) := by
    intro G
    have e3 : Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr
        (Finset.Subset.refl G))) = RingHom.id ↥(Subring.closure (G : Set R)) := by
      apply RingHom.ext
      intro x
      rfl
    show Spec.map _ = _
    rw [e3, CommRingCat.ofHom_id, Spec.map_id]

  have hglue : ∀ (A : Type u) [CommRing A] (φ : ∀ G : Finset R, ↥(Subring.closure (G : Set R)) →+* A),
      (∀ (G G' : Finset R) (h : G ⊆ G') (a : ↥(Subring.closure (G : Set R))),
        φ G' (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h)) a) = φ G a) →
      ∃! Φ : R →+* A, ∀ G : Finset R, Φ.comp (Subring.closure (G : Set R)).subtype = φ G := by
    intro A _ φ hφ
    have hmem : ∀ (G : Finset R) (x : R), x ∈ G → x ∈ Subring.closure (G : Set R) :=
      fun G x h => Subring.subset_closure (Finset.mem_coe.mpr h)
    have hx : ∀ x : R, x ∈ Subring.closure (({x} : Finset R) : Set R) := fun x =>
      hmem _ _ (Finset.mem_singleton_self x)
    let Φ₀ : R → A := fun x => φ {x} ⟨x, hx x⟩
    have hC : ∀ (G : Finset R) (a : ↥(Subring.closure (G : Set R))), φ G a = Φ₀ a.val := by
      intro G a
      have h1 := hφ G (G ∪ {a.val}) Finset.subset_union_left a
      have h2 := hφ {a.val} (G ∪ {a.val}) Finset.subset_union_right ⟨a.val, hx a.val⟩
      rw [← h1]
      show _ = φ {a.val} ⟨a.val, hx a.val⟩
      rw [← h2]
      rfl
    let Φ : R →+* A :=
      { toFun := Φ₀
        map_one' := by
          have h := hC ∅ 1
          rw [map_one] at h
          exact h.symm
        map_mul' := fun x y => by
          let a : ↥(Subring.closure (({x, y} : Finset R) : Set R)) := ⟨x, hmem _ _ (by simp)⟩
          let b : ↥(Subring.closure (({x, y} : Finset R) : Set R)) := ⟨y, hmem _ _ (by simp)⟩
          have h := hC _ (a * b)
          rw [map_mul, hC _ a, hC _ b] at h
          exact h.symm
        map_zero' := by
          have h := hC ∅ 0
          rw [map_zero] at h
          exact h.symm
        map_add' := fun x y => by
          let a : ↥(Subring.closure (({x, y} : Finset R) : Set R)) := ⟨x, hmem _ _ (by simp)⟩
          let b : ↥(Subring.closure (({x, y} : Finset R) : Set R)) := ⟨y, hmem _ _ (by simp)⟩
          have h := hC _ (a + b)
          rw [map_add, hC _ a, hC _ b] at h
          exact h.symm }
    refine ⟨Φ, fun G => RingHom.ext fun a => (hC G a).symm, fun Ψ hΨ => ?_⟩
    apply RingHom.ext
    intro x
    exact congrArg (fun f => f ⟨x, hx x⟩) (hΨ {x})

  have hSpec : ∀ (T : Scheme.{u}) (z : ∀ G : Finset R, T ⟶ wcSubX R G),
      (∀ (G G' : Finset R) (h : G ⊆ G'), z G' ≫ wcSubT R h = z G) →
      ∃! z₀ : T ⟶ Spec (.of R), ∀ G, z₀ ≫ wcSubP R G = z G := by
    intro T z hz
    have key : ∀ {S S' : CommRingCat.{u}} (f : S' ⟶ S) (x : T ⟶ Spec S),
        ((ΓSpec.adjunction.homEquiv T (Opposite.op S')).symm (x ≫ Spec.map f)).unop.hom =
          ((ΓSpec.adjunction.homEquiv T (Opposite.op S)).symm x).unop.hom.comp f.hom := by
      intro S S' f x
      have h := ΓSpec.adjunction.homEquiv_naturality_right_symm (X := T) x f.op
      exact congrArg (fun g => g.unop.hom) h
    let A := Scheme.Γ.obj (Opposite.op T)
    let ψ : ∀ G : Finset R, ↥(Subring.closure (G : Set R)) →+* A := fun G =>
      ((ΓSpec.adjunction.homEquiv T
        (Opposite.op (CommRingCat.of ↥(Subring.closure (G : Set R))))).symm (z G)).unop.hom
    have hψ : ∀ (G G' : Finset R) (h : G ⊆ G') (a : ↥(Subring.closure (G : Set R))),
        ψ G' (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h)) a) = ψ G a := by
      intro G G' h a
      have e1 := key (CommRingCat.ofHom
        (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h)))) (z G')
      have e2 : z G' ≫ Spec.map (CommRingCat.ofHom
          (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h)))) = z G := hz G G' h
      rw [e2] at e1
      exact (RingHom.congr_fun e1 a).symm
    obtain ⟨Φ, hΦ, hΦu⟩ := hglue A ψ hψ
    let Φ' : CommRingCat.of R ⟶ A := CommRingCat.ofHom Φ
    let z₀ : T ⟶ Spec (.of R) :=
      ΓSpec.adjunction.homEquiv T (Opposite.op (CommRingCat.of R)) Φ'.op
    have e3 : (ΓSpec.adjunction.homEquiv T (Opposite.op (CommRingCat.of R))).symm z₀ = Φ'.op :=
      Equiv.symm_apply_apply _ _
    have hz₀ : ∀ G, z₀ ≫ wcSubP R G = z G := by
      intro G
      apply (ΓSpec.adjunction.homEquiv T
        (Opposite.op (CommRingCat.of ↥(Subring.closure (G : Set R))))).symm.injective
      apply Quiver.Hom.unop_inj
      apply CommRingCat.hom_ext
      have e1 := key (CommRingCat.ofHom (Subring.closure (G : Set R)).subtype) z₀
      rw [e3] at e1
      refine e1.trans ?_
      exact hΦ G
    refine ⟨z₀, hz₀, fun z₁ hz₁ => ?_⟩
    have hΨ : ∀ G : Finset R, ((ΓSpec.adjunction.homEquiv T (Opposite.op (CommRingCat.of R))).symm
        z₁).unop.hom.comp (Subring.closure (G : Set R)).subtype = ψ G := by
      intro G
      have e1 := key (CommRingCat.ofHom (Subring.closure (G : Set R)).subtype) z₁
      have e2 : z₁ ≫ Spec.map (CommRingCat.ofHom (Subring.closure (G : Set R)).subtype) = z G :=
        hz₁ G
      rw [e2] at e1
      exact e1.symm
    have hΨΦ := hΦu _ hΨ
    apply (ΓSpec.adjunction.homEquiv T (Opposite.op (CommRingCat.of R))).symm.injective
    refine Eq.trans ?_ e3.symm
    apply Quiver.Hom.unop_inj
    apply CommRingCat.hom_ext
    exact hΨΦ
  have hlimopen : ∀ (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (D : Λ ⥤ Scheme.{u}) (P : Scheme.{u}) (π : ∀ l, P ⟶ D.obj l), (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ D.map t = π l') → (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ D.obj l), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ D.map t = z l') → ∃! z₀ : T ⟶ P, ∀ l, z₀ ≫ π l = z l) → (∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom (D.map t)) → ∀ (l : Λ) (T : Scheme.{u}) (τ : T ⟶ D.obj l), CompactSpace T → ∀ (O : Set T), IsOpen O → (∀ (y : T) (p : P), τ y = π l p → y ∈ O) → ∃ (l' : Λ) (t : l' ⟶ l), ∀ (y : T) (q : D.obj l'), τ y = D.map t q → y ∈ O := by
    intro Λ _ _ D P π hπ hlim haff l T τ hT O hO hOP

    let cP : Limits.Cone D := ⟨P, { app := π, naturality := fun k k' t => by simp [hπ t] }⟩
    have hL : Limits.IsLimit cP :=
      Limits.IsLimit.ofExistsUnique (fun s => hlim s.pt s.π.app (fun t => s.w t))
    have hW : Limits.IsLimit (cP.whisker (Over.forget l)) :=
      (Functor.Initial.isLimitWhiskerEquiv (Over.forget l) cP).symm hL
    have hres : ∀ (W : Scheme.{u}) (a : ∀ j : Over l, W ⟶ D.obj j.left),
        (∀ {j j' : Over l} (g : j ⟶ j'), a j ≫ D.map g.left = a j') →
        ∃! z₀ : W ⟶ P, ∀ j : Over l, z₀ ≫ π j.left = a j := by
      intro W a ha
      let sa : Limits.Cone (Over.forget l ⋙ D) :=
        ⟨W, { app := a, naturality := fun j j' g => by simp [ha g] }⟩
      exact hW.existsUnique sa

    let E : Over l ⥤ Scheme.{u} := Over.post D ⋙ Over.pullback τ ⋙ Over.forget T
    let i₀ : Over l := Over.mk (𝟙 l)
    let fst : ∀ j : Over l, E.obj j ⟶ D.obj j.left := fun j => Limits.pullback.fst (D.map j.hom) τ
    let snd : ∀ j : Over l, E.obj j ⟶ T := fun j => Limits.pullback.snd (D.map j.hom) τ
    have hcondE : ∀ j : Over l, fst j ≫ D.map j.hom = snd j ≫ τ := fun j =>
      Limits.pullback.condition
    have ext : ∀ (j : Over l) {W : Scheme.{u}} (u v : W ⟶ E.obj j), u ≫ fst j = v ≫ fst j →
        u ≫ snd j = v ≫ snd j → u = v := fun j W u v h1 h2 => Limits.pullback.hom_ext h1 h2
    have F1 : ∀ {j j' : Over l} (g : j ⟶ j'), E.map g ≫ fst j' = fst j ≫ D.map g.left := by
      intro j j' g
      have h := Over.pullback_map_left τ ((Over.post D).obj j) (k := (Over.post D).map g)
      refine (congrArg (· ≫ fst j') h).trans ?_
      exact Limits.pullback.lift_fst _ _ _
    have F2 : ∀ {j j' : Over l} (g : j ⟶ j'), E.map g ≫ snd j' = snd j := by
      intro j j' g
      exact Over.w ((Over.pullback τ).map ((Over.post D).map g))

    have hleg : ∀ j : Over l, (Limits.pullback.fst (π l) τ ≫ π j.left) ≫ D.map j.hom =
        Limits.pullback.snd (π l) τ ≫ τ := by
      intro j
      rw [Category.assoc, hπ j.hom]
      exact Limits.pullback.condition
    let leg : ∀ j : Over l, Limits.pullback (π l) τ ⟶ E.obj j := fun j =>
      Limits.pullback.lift (Limits.pullback.fst (π l) τ ≫ π j.left) (Limits.pullback.snd (π l) τ)
        (hleg j)
    have leg_fst : ∀ j : Over l, leg j ≫ fst j = Limits.pullback.fst (π l) τ ≫ π j.left :=
      fun j => Limits.pullback.lift_fst _ _ _
    have leg_snd : ∀ j : Over l, leg j ≫ snd j = Limits.pullback.snd (π l) τ :=
      fun j => Limits.pullback.lift_snd _ _ _
    have hnat : ∀ {j j' : Over l} (g : j ⟶ j'), leg j ≫ E.map g = leg j' := by
      intro j j' g
      apply ext j'
      · rw [Category.assoc, F1 g, ← Category.assoc, leg_fst, leg_fst, Category.assoc, hπ g.left]
      · rw [Category.assoc, F2 g, leg_snd, leg_snd]
    let c : Limits.Cone E := ⟨Limits.pullback (π l) τ,
      { app := leg, naturality := fun j j' g => by
          simp only [Functor.const_obj_map]
          exact ((Category.id_comp _).trans (hnat g).symm) }⟩
    have hc : Limits.IsLimit c := by
      refine Limits.IsLimit.ofExistsUnique (fun s => ?_)
      let a : ∀ j : Over l, s.pt ⟶ D.obj j.left := fun j => s.π.app j ≫ fst j
      have ha : ∀ {j j' : Over l} (g : j ⟶ j'), a j ≫ D.map g.left = a j' := by
        intro j j' g
        show (s.π.app j ≫ fst j) ≫ D.map g.left = s.π.app j' ≫ fst j'
        rw [Category.assoc, ← F1 g, ← Category.assoc, s.w g]
      obtain ⟨z₀, hz₀, hz₀u⟩ := hres s.pt a ha
      let b : s.pt ⟶ T := s.π.app i₀ ≫ snd i₀
      have hb : ∀ j : Over l, s.π.app j ≫ snd j = b := by
        intro j
        have g : j ⟶ i₀ := Over.homMk j.hom (by simp [i₀])
        show s.π.app j ≫ snd j = s.π.app i₀ ≫ snd i₀
        rw [← s.w g, Category.assoc, F2 g]
      have hcond : z₀ ≫ π l = b ≫ τ := by
        have h1 : z₀ ≫ π l = s.π.app i₀ ≫ fst i₀ := hz₀ i₀
        have h2 : fst i₀ ≫ D.map i₀.hom = snd i₀ ≫ τ := hcondE i₀
        have h3 : D.map i₀.hom = 𝟙 (D.obj l) := D.map_id l
        rw [h3] at h2
        have h4 : fst i₀ = snd i₀ ≫ τ := (Category.comp_id (fst i₀)).symm.trans h2
        show z₀ ≫ π l = (s.π.app i₀ ≫ snd i₀) ≫ τ
        rw [h1, Category.assoc, ← h4]
      refine ⟨Limits.pullback.lift z₀ b hcond, fun j => ?_, fun m hm => ?_⟩
      · change Limits.pullback.lift z₀ b hcond ≫ leg j = s.π.app j
        apply ext j
        · rw [Category.assoc, leg_fst, ← Category.assoc, Limits.pullback.lift_fst]
          exact hz₀ j
        · rw [Category.assoc, leg_snd, Limits.pullback.lift_snd, hb j]
      · have hm' : ∀ j, m ≫ leg j = s.π.app j := hm
        have e1 : m ≫ Limits.pullback.fst (π l) τ = z₀ := by
          apply hz₀u
          intro j
          rw [Category.assoc, ← leg_fst j, ← Category.assoc, hm' j]
        have e2 : m ≫ Limits.pullback.snd (π l) τ = b := by
          rw [← leg_snd i₀, ← Category.assoc, hm' i₀]
        refine Limits.pullback.hom_ext (f := π l) (g := τ) ?_ ?_
        · rw [e1, Limits.pullback.lift_fst]
        · rw [e2, Limits.pullback.lift_snd]

    have hsndAff : ∀ i : Over l, IsAffineHom (snd i) := fun i =>
      MorphismProperty.of_isPullback (P := @IsAffineHom)
        (IsPullback.of_hasPullback (D.map i.hom) τ) (haff i.hom)
    have hEaff : ∀ {i j : Over l} (f : i ⟶ j), IsAffineHom (E.map f) := by
      intro i j f
      have big : IsPullback (E.map f ≫ snd j) (fst i) τ (D.map f.left ≫ D.map j.hom) := by
        rw [F2 f, ← D.map_comp, Over.w f]
        exact (IsPullback.of_hasPullback (D.map i.hom) τ).flip
      have right : IsPullback (snd j) (fst j) τ (D.map j.hom) :=
        (IsPullback.of_hasPullback (D.map j.hom) τ).flip
      have sq := IsPullback.of_right big (F1 f) right
      exact MorphismProperty.of_isPullback (P := @IsAffineHom) sq.flip (haff f.left)
    have hEcpt : ∀ i : Over l, CompactSpace (E.obj i) := fun i => by
      have := hsndAff i
      have hqc : QuasiCompact (snd i) := inferInstance
      exact @QuasiCompact.compactSpace_of_compactSpace _ _ (snd i) hqc hT

    let U : (E.obj i₀).Opens := ⟨(snd i₀) ⁻¹' O, hO.preimage (snd i₀).continuous⟩
    have htop : c.π.app i₀ ⁻¹ᵁ U = ⊤ := by
      rw [eq_top_iff]
      intro x _
      change snd i₀ (leg i₀ x) ∈ O
      have e : snd i₀ (leg i₀ x) = Limits.pullback.snd (π l) τ x := by
        rw [← Scheme.Hom.comp_apply, leg_snd i₀]
      have e2 : τ (Limits.pullback.snd (π l) τ x) = π l (Limits.pullback.fst (π l) τ x) := by
        rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
      apply hOP _ (Limits.pullback.fst (π l) τ x)
      rw [e, e2]
    obtain ⟨j, fji, hj⟩ := @exists_map_eq_top (Over l) _ E c hc _ (fun f => hEaff f) hEcpt i₀ U htop
    refine ⟨j.left, j.hom, fun y q hyq => ?_⟩
    obtain ⟨z, hz1, hz2⟩ :=
      Scheme.Pullback.exists_preimage_pullback (f := D.map j.hom) (g := τ) q y hyq.symm
    have hzU : ∀ w : E.obj j, w ∈ E.map fji ⁻¹ᵁ U := by
      rw [hj]; intro w; trivial
    have hw : snd i₀ (E.map fji z) ∈ O := hzU z
    have e : snd i₀ (E.map fji z) = y :=
      (Scheme.Hom.comp_apply (E.map fji) (snd i₀) z).symm.trans
        ((congrArg (fun k : E.obj j ⟶ T => k z) (F2 fji)).trans hz2)
    rw [← e]
    exact hw

  let D : (Finset R)ᵒᵖ ⥤ Scheme.{u} :=
    { obj := fun l => wcSubX R l.unop
      map := fun {l l'} t => wcSubT R (leOfHom t.unop)
      map_id := fun l => hID l.unop
      map_comp := fun {l₁ l₂ l₃} t₁ t₂ => (hTT (leOfHom t₂.unop) (leOfHom t₁.unop)).symm }
  have hπ : ∀ {l l' : (Finset R)ᵒᵖ} (t : l ⟶ l'), wcSubP R l.unop ≫ D.map t = wcSubP R l'.unop :=
    fun {l l'} t => hPT (leOfHom t.unop)
  have hlim : ∀ (T : Scheme.{u}) (z : ∀ l : (Finset R)ᵒᵖ, T ⟶ D.obj l),
      (∀ {l l' : (Finset R)ᵒᵖ} (t : l ⟶ l'), z l ≫ D.map t = z l') →
      ∃! z₀ : T ⟶ Spec (.of R), ∀ l : (Finset R)ᵒᵖ, z₀ ≫ wcSubP R l.unop = z l := by
    intro T z hz
    obtain ⟨z₀, hz₀, hu⟩ := hSpec T (fun G => z (Opposite.op G))
      (fun G G' h => hz (homOfLE h).op)
    exact ⟨z₀, fun l => hz₀ l.unop, fun z₁ h₁ => hu z₁ (fun G => h₁ (Opposite.op G))⟩
  have haff : ∀ {l l' : (Finset R)ᵒᵖ} (t : l ⟶ l'), IsAffineHom (D.map t) := by
    intro l l' t
    show IsAffineHom (wcSubT R (leOfHom t.unop))
    exact isAffineHom_of_isAffine _

  haveI : IsAffine O.left := hO
  let Ω : Set O.left := ⋃ j, Set.range (w j).left
  have hΩ : IsOpen Ω := isOpen_iUnion fun j => (w j).left.isOpenMap.isOpen_range
  have hfib : ∀ (y : O.left) (p : Spec (.of R)), O.hom y = wcSubP R F p → y ∈ Ω := by
    intro y p hyp
    obtain ⟨ζ, hζ, -⟩ := Scheme.Pullback.exists_preimage_pullback y p hyp
    have hx : kO (hpb.isoPullback.inv ζ) = y := by
      rw [← hζ, ← Scheme.Hom.comp_apply, IsPullback.isoPullback_inv_fst]
    obtain ⟨j, y', hy'⟩ := hcov (hpb.isoPullback.inv ζ)
    exact Set.mem_iUnion.mpr ⟨j, y', hy'.trans hx⟩

  obtain ⟨l', t, hev⟩ := hlimopen (Finset R)ᵒᵖ D (Spec (.of R)) (fun l => wcSubP R l.unop)
    hπ hlim haff (Opposite.op F) O.left O.hom inferInstance Ω hΩ hfib
  refine ⟨l'.unop, leOfHom t.unop, ?_⟩
  intro F'' h' O'' k₂ hpb₂ z
  have e : k₂ ≫ O.hom = O''.hom ≫ wcSubT R h' ≫ wcSubT R (leOfHom t.unop) := by
    rw [hpb₂.toCommSq.w, hTT]
  have hq : O.hom (k₂ z) = wcSubT R (leOfHom t.unop) (wcSubT R h' (O''.hom z)) := by
    have := congrArg (fun f : O''.left ⟶ wcSubX R F => f z) e
    simpa only [Scheme.Hom.comp_apply] using this
  obtain ⟨j, y, hy⟩ := Set.mem_iUnion.mp (hev (k₂ z) (wcSubT R h' (O''.hom z)) hq)
  exact ⟨j, y, hy⟩

theorem wc_et_sheaf_glue_jointly_surjective : ∀ (Y : Scheme.{u})
    (A : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (V : Y.Etale) (N : ℕ)
    (W : Fin N → Y.Etale) (c : ∀ i, W i ⟶ V),
    (∀ v : V.left, ∃ (i : Fin N) (w : (W i).left), (c i).left w = v) →
    ∀ x : ∀ i, A.obj.obj (Opposite.op (W i)),
    (∀ (i j : Fin N) (Z : Y.Etale) (a : Z ⟶ W i) (b : Z ⟶ W j), a ≫ c i = b ≫ c j →
      (A.obj.map a.op).hom (x i) = (A.obj.map b.op).hom (x j)) →
    ∃! y : A.obj.obj (Opposite.op V), ∀ i, (A.obj.map (c i).op).hom y = x i :=
by
  intro Y A V N W c hcov x hx
  have hS : Sieve.generate (Presieve.ofArrows W c) ∈ Scheme.smallEtaleTopology Y V := by
    change Sieve.generate (Presieve.ofArrows W c) ∈ Scheme.smallGrothendieckTopology @Etale Y V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro v
    obtain ⟨i, w, hw⟩ := hcov v
    have hEt : Etale (c i).left := by
      have hw' : (c i).left ≫ V.hom = (W i).hom := MorphismProperty.Over.w (c i)
      have h1 : Etale V.hom := V.prop
      have h2 : Etale ((c i).left ≫ V.hom) := by rw [hw']; exact (W i).prop
      exact Etale.of_comp (c i).left V.hom
    exact ⟨W i, c i, w, ⟨_, 𝟙 _, c i, Presieve.ofArrows.mk i, Category.id_comp _⟩, hEt, hw⟩
  have hP : Presieve.IsSheaf (Scheme.smallEtaleTopology Y) (A.obj ⋙ forget AddCommGrpCat.{u+1}) :=
    (isSheaf_iff_isSheaf_of_type _ _).mp
      ((sheafCompose (Scheme.smallEtaleTopology Y) (forget AddCommGrpCat.{u+1})).obj A).property
  have hSF := (Presieve.isSheafFor_arrows_iff _ c).mp (hP.isSheafFor _ hS)
  obtain ⟨t, ht, huniq⟩ := hSF x (by
    intro i j Z a b hab
    exact hx i j Z a b hab)
  exact ⟨t, ht, fun y hy => huniq y hy⟩

theorem wc_subring_affsec_ker : ∀ (R : Type u) [CommRing R]
    (G : ∀ F : Finset R, Sheaf (Scheme.smallEtaleTopology (wcSubX R F)) AddCommGrpCat.{u+1})
    (e : ∀ (F F' : Finset R) (h : F ⊆ F'), wcEtTransport (wcSubT R h) (G F) (G F'))
    (H : Sheaf (Scheme.smallEtaleTopology (Spec (.of R))) AddCommGrpCat.{u+1})
    (σ : ∀ F : Finset R, wcEtTransport (wcSubP R F) (G F) H),
    wcSubCoherent R G e → wcSubLocKer R G e H σ →
    ∀ (U : (Spec (.of R)).Etale) (F : Finset R) (O : (wcSubX R F).Etale) (kO : U.left ⟶ O.left)
      (hkO : kO ≫ O.hom = U.hom ≫ wcSubP R F),
    IsAffine O.left → IsPullback kO U.hom O.hom (wcSubP R F) →
    ∀ t : (G F).obj.obj (Opposite.op O), (σ F).ρ O U kO hkO t = 0 →
    ∃ (F' : Finset R) (h' : F ⊆ F') (O' : (wcSubX R F').Etale) (kO' : U.left ⟶ O'.left)
      (k₂ : O'.left ⟶ O.left) (hk₂ : k₂ ≫ O.hom = O'.hom ≫ wcSubT R h'),
      kO' ≫ O'.hom = U.hom ≫ wcSubP R F' ∧ kO' ≫ k₂ = kO ∧
      IsPullback k₂ O'.hom O.hom (wcSubT R h') ∧ (e F F' h').ρ O O' k₂ hk₂ t = 0 :=
by
  classical
  intro R _ G e H σ hco hker U F O kO hkO hO hpb t ht

  have hPT : ∀ {F₁ F₂ : Finset R} (h : F₁ ⊆ F₂), wcSubP R F₂ ≫ wcSubT R h = wcSubP R F₁ := by
    intro F₁ F₂ h
    show Spec.map _ ≫ Spec.map _ = Spec.map _
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have e1 : (Subring.closure (F₂ : Set R)).subtype.comp
        (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h))) =
        (Subring.closure (F₁ : Set R)).subtype := by
      apply RingHom.ext
      intro x
      simp
    rw [e1]
  have hTT : ∀ {F₁ F₂ F₃ : Finset R} (h₁ : F₁ ⊆ F₂) (h₂ : F₂ ⊆ F₃),
      wcSubT R h₂ ≫ wcSubT R h₁ = wcSubT R (Finset.Subset.trans h₁ h₂) := by
    intro F₁ F₂ F₃ h₁ h₂
    show Spec.map _ ≫ Spec.map _ = Spec.map _
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have e2 : (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h₂))).comp
        (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h₁))) =
        Subring.inclusion (Subring.closure_mono
          (Finset.coe_subset.mpr (Finset.Subset.trans h₁ h₂))) := by
      apply RingHom.ext
      intro x
      apply Subtype.ext
      simp
    rw [e2]

  have hBC : ∀ {F₁ F₂ : Finset R} (h : F₁ ⊆ F₂) (A : (wcSubX R F₁).Etale),
      ∃ (B : (wcSubX R F₂).Etale) (pr : B.left ⟶ A.left),
        IsPullback pr B.hom A.hom (wcSubT R h) :=
    fun h A => ⟨Scheme.Etale.mk (Limits.pullback.snd A.hom (wcSubT R h)),
      Limits.pullback.fst _ _, IsPullback.of_hasPullback _ _⟩

  haveI : IsAffine O.left := hO
  haveI : IsAffine ((𝟭 Scheme).obj O.left) := hO
  haveI : IsAffine (Spec (.of R)) := inferInstance
  haveI : ∀ F₁ : Finset R, IsAffine (wcSubX R F₁) := fun F₁ => inferInstanceAs (IsAffine (Spec _))
  haveI : IsAffine U.left := by
    haveI : IsAffineHom (wcSubP R F) := isAffineHom_of_isAffine _
    haveI : IsAffineHom (Limits.pullback.fst O.hom (wcSubP R F)) :=
      MorphismProperty.of_isPullback (P := @IsAffineHom)
        (IsPullback.of_hasPullback O.hom (wcSubP R F)).flip inferInstance
    haveI : IsAffine (Limits.pullback O.hom (wcSubP R F)) :=
      isAffine_of_isAffineHom (Limits.pullback.fst O.hom (wcSubP R F))
    exact IsAffine.of_isIso hpb.isoPullback.hom

  let Q : ∀ U' : (Spec (.of R)).Etale, (U' ⟶ U) → Prop := fun U' c =>
    ∃ (F₁ : Finset R) (h : F ⊆ F₁) (O₁ : (wcSubX R F₁).Etale) (k' : U'.left ⟶ O₁.left)
      (_ : k' ≫ O₁.hom = U'.hom ≫ wcSubP R F₁) (k'' : O₁.left ⟶ O.left)
      (hk'' : k'' ≫ O.hom = O₁.hom ≫ wcSubT R h),
      k' ≫ k'' = c.left ≫ kO ∧ (e F F₁ h).ρ O O₁ k'' hk'' t = 0
  have hQs : ∀ (U' U'' : (Spec (.of R)).Etale) (c : U' ⟶ U) (d : U'' ⟶ U'),
      Q U' c → Q U'' (d ≫ c) := by
    rintro U' U'' c d ⟨F₁, h, O₁, k', hk', k'', hk'', hE, hZ⟩
    refine ⟨F₁, h, O₁, d.left ≫ k', ?_, k'', hk'', ?_, hZ⟩
    · rw [Category.assoc, hk', ← Category.assoc, MorphismProperty.Over.w d]
    · rw [Category.assoc, hE, ← Category.assoc]
      rfl
  have hQl : ∀ u : U.left, ∃ (U' : (Spec (.of R)).Etale) (c : U' ⟶ U) (u' : U'.left),
      c.left u' = u ∧ Q U' c := by
    intro u
    obtain ⟨U', c, u', F₁, h, O₁, k', hk', k'', hk'', hu, hE, hZ⟩ := hker F O U kO hkO t ht u
    exact ⟨U', c, u', hu, F₁, h, O₁, k', hk', k'', hk'', hE, hZ⟩
  obtain ⟨N, W, c, -, hQ, hcov⟩ := wc_et_affine_finite_refine _ U inferInstance Q hQs hQl
  dsimp only [Q] at hQ
  choose Fi hi Oi k' hk' k'' hk'' hE hZ using hQ

  let Fs : Finset R := F ∪ Finset.univ.biUnion Fi
  have hF : F ⊆ Fs := Finset.subset_union_left
  have hiF : ∀ i, Fi i ⊆ Fs := fun i =>
    (Finset.subset_biUnion_of_mem Fi (Finset.mem_univ i)).trans Finset.subset_union_right
  obtain ⟨Os, pr, hpr⟩ := hBC hF O
  haveI : IsAffine Os.left := by
    haveI : IsAffineHom (wcSubT R hF) := isAffineHom_of_isAffine _
    haveI : IsAffineHom (Limits.pullback.fst O.hom (wcSubT R hF)) :=
      MorphismProperty.of_isPullback (P := @IsAffineHom)
        (IsPullback.of_hasPullback O.hom (wcSubT R hF)).flip inferInstance
    haveI : IsAffine (Limits.pullback O.hom (wcSubT R hF)) :=
      isAffine_of_isAffineHom (Limits.pullback.fst O.hom (wcSubT R hF))
    exact IsAffine.of_isIso hpr.isoPullback.hom
  have hcondS : kO ≫ O.hom = (U.hom ≫ wcSubP R Fs) ≫ wcSubT R hF := by
    rw [hkO, Category.assoc, hPT]
  obtain ⟨kOs, hkOs1, hkOs2⟩ : ∃ k : U.left ⟶ Os.left, k ≫ pr = kO ∧
      k ≫ Os.hom = U.hom ≫ wcSubP R Fs :=
    ⟨hpr.lift _ _ hcondS, hpr.lift_fst _ _ _, hpr.lift_snd _ _ _⟩
  have hpbs : IsPullback kOs U.hom Os.hom (wcSubP R Fs) := by
    refine IsPullback.of_right ?_ hkOs2 hpr
    rw [hkOs1, hPT]
    exact hpb
  choose Osi pri hpri using fun i => hBC (hiF i) (Oi i)
  have hwex : ∀ i, ∃ (w : Osi i ⟶ Os), w.left ≫ pr = pri i ≫ k'' i := by
    intro i
    have hc : (pri i ≫ k'' i) ≫ O.hom = (Osi i).hom ≫ wcSubT R hF := by
      rw [Category.assoc, hk'' i, ← Category.assoc, (hpri i).toCommSq.w, Category.assoc, hTT]
    exact ⟨MorphismProperty.Over.homMk (hpr.lift _ _ hc) (hpr.lift_snd _ _ _) trivial,
      hpr.lift_fst _ _ _⟩
  choose w hw using hwex
  have hmex : ∀ i, ∃ m : (W i).left ⟶ (Osi i).left, m ≫ (w i).left = (c i).left ≫ kOs := by
    intro i
    have hc : k' i ≫ (Oi i).hom = ((W i).hom ≫ wcSubP R Fs) ≫ wcSubT R (hiF i) := by
      rw [hk' i, Category.assoc, hPT]
    refine ⟨(hpri i).lift (k' i) ((W i).hom ≫ wcSubP R Fs) hc, ?_⟩
    apply hpr.hom_ext
    · rw [Category.assoc, hw i, ← Category.assoc, (hpri i).lift_fst, hE i, Category.assoc, hkOs1]
    · rw [Category.assoc, MorphismProperty.Over.w (w i), (hpri i).lift_snd, Category.assoc, hkOs2,
        ← Category.assoc, MorphismProperty.Over.w (c i)]
  choose m hm using hmex
  have hcovS : ∀ x : U.left, ∃ (j : Fin N) (y : (Osi j).left), (w j).left y = kOs x := by
    intro x
    obtain ⟨i, y, hy⟩ := hcov x
    refine ⟨i, m i y, ?_⟩
    calc (w i).left (m i y) = (m i ≫ (w i).left) y := (Scheme.Hom.comp_apply _ _ _).symm
      _ = ((c i).left ≫ kOs) y := by rw [hm i]
      _ = kOs x := by rw [Scheme.Hom.comp_apply, hy]

  obtain ⟨F', hF', Cov⟩ := wc_subring_cover_descend R U Fs Os kOs inferInstance hpbs N Osi w hcovS

  have h' : F ⊆ F' := hF.trans hF'
  obtain ⟨O', k₂, hpb₂⟩ := hBC h' O
  have hk₂ : k₂ ≫ O.hom = O'.hom ≫ wcSubT R h' := hpb₂.toCommSq.w
  have hc' : kO ≫ O.hom = (U.hom ≫ wcSubP R F') ≫ wcSubT R h' := by
    rw [hkO, Category.assoc, hPT]
  obtain ⟨kO', hkO'1, hkO'2⟩ : ∃ k : U.left ⟶ O'.left, k ≫ k₂ = kO ∧
      k ≫ O'.hom = U.hom ≫ wcSubP R F' :=
    ⟨hpb₂.lift _ _ hc', hpb₂.lift_fst _ _ _, hpb₂.lift_snd _ _ _⟩
  have hcκ : k₂ ≫ O.hom = (O'.hom ≫ wcSubT R hF') ≫ wcSubT R hF := by
    rw [hk₂, Category.assoc, hTT]
  obtain ⟨κ, hκ1, hκ2⟩ : ∃ κ : O'.left ⟶ Os.left, κ ≫ pr = k₂ ∧
      κ ≫ Os.hom = O'.hom ≫ wcSubT R hF' :=
    ⟨hpr.lift _ _ hcκ, hpr.lift_fst _ _ _, hpr.lift_snd _ _ _⟩
  have hpbκ : IsPullback κ O'.hom Os.hom
      (wcSubT R (Finset.Subset.trans hF' (Finset.Subset.refl F'))) := by
    refine IsPullback.of_right ?_ hκ2 hpr
    rw [hκ1, hTT]
    exact hpb₂
  have hcovO' := Cov F' (Finset.Subset.refl F') O' κ hpbκ

  have hPex : ∀ j, ∃ (Y : (wcSubX R F').Etale) (π : Y ⟶ O') (f : Y.left ⟶ (Osi j).left),
      f ≫ (w j).left = π.left ≫ κ ∧
        ∀ z : O'.left, (∃ y, (w j).left y = κ z) → ∃ ζ, π.left ζ = z := by
    intro j
    refine ⟨Scheme.Etale.mk (Limits.pullback.snd (w j).left κ ≫ O'.hom),
      MorphismProperty.Over.homMk (Limits.pullback.snd (w j).left κ) rfl trivial,
      Limits.pullback.fst _ _, Limits.pullback.condition, ?_⟩
    rintro z ⟨y, hy⟩
    obtain ⟨ζ, -, hζ⟩ := Scheme.Pullback.exists_preimage_pullback y z hy
    exact ⟨ζ, hζ⟩
  choose Y π f hf hsurj using hPex
  have hsurj' : ∀ v : O'.left, ∃ (i : Fin N) (y : (Y i).left), (π i).left y = v := by
    intro z
    obtain ⟨j, y, hy⟩ := hcovO' z
    exact ⟨j, hsurj j z ⟨y, hy⟩⟩
  have hres : ∀ j, ((G F').obj.map (π j).op).hom ((e F F' h').ρ O O' k₂ hk₂ t) = 0 := by
    intro j
    have hh2 : ((π j).left ≫ k₂) ≫ O.hom = (Y j).hom ≫ wcSubT R h' := by
      rw [Category.assoc, hk₂, ← Category.assoc, MorphismProperty.Over.w (π j)]
    have h1 := (e F F' h').nat O O (𝟙 O) O' (Y j) (π j) k₂ hk₂ ((π j).left ≫ k₂) hh2
      (by show ((π j).left ≫ k₂) ≫ 𝟙 _ = _; rw [Category.comp_id]) t
    rw [op_id, CategoryTheory.Functor.map_id] at h1
    have hmap : (π j).left ≫ k₂ = (f j ≫ pri j) ≫ k'' j := by
      rw [← hκ1, ← Category.assoc, ← hf j, Category.assoc, hw j, Category.assoc]
    have hkY : (f j ≫ pri j) ≫ (Oi j).hom =
        (Y j).hom ≫ wcSubT R (Finset.Subset.trans (hiF j) hF') := by
      calc (f j ≫ pri j) ≫ (Oi j).hom = f j ≫ (Osi j).hom ≫ wcSubT R (hiF j) := by
            rw [Category.assoc, (hpri j).toCommSq.w]
        _ = ((f j ≫ (w j).left) ≫ Os.hom) ≫ wcSubT R (hiF j) := by
            rw [← MorphismProperty.Over.w (w j)]; simp only [Category.assoc]
        _ = (π j).left ≫ (κ ≫ Os.hom) ≫ wcSubT R (hiF j) := by
            rw [hf j]; simp only [Category.assoc]
        _ = ((π j).left ≫ O'.hom) ≫ wcSubT R hF' ≫ wcSubT R (hiF j) := by
            rw [hκ2]; simp only [Category.assoc]
        _ = _ := by rw [MorphismProperty.Over.w (π j), hTT]
    have hco2 := hco.2 F (Fi j) F' (hi j) (Finset.Subset.trans (hiF j) hF') O (Oi j) (k'' j)
      (hk'' j) (Y j) (f j ≫ pri j) hkY t
    rw [hZ j, map_zero] at hco2
    have hcongr : ∀ (a b : (Y j).left ⟶ O.left) (ha : a ≫ O.hom = (Y j).hom ≫ wcSubT R h')
        (hb : b ≫ O.hom = (Y j).hom ≫ wcSubT R h'), a = b →
        (e F F' h').ρ O (Y j) a ha t = (e F F' h').ρ O (Y j) b hb t := by
      rintro a b ha hb rfl
      rfl
    calc ((G F').obj.map (π j).op).hom ((e F F' h').ρ O O' k₂ hk₂ t)
        = (e F F' h').ρ O (Y j) ((π j).left ≫ k₂) hh2 t := h1.symm
      _ = (e F F' h').ρ O (Y j) ((f j ≫ pri j) ≫ k'' j) (by rw [← hmap]; exact hh2) t :=
          hcongr _ _ _ _ hmap
      _ = 0 := hco2

  obtain ⟨y0, -, huniq⟩ := wc_et_sheaf_glue_jointly_surjective (wcSubX R F') (G F') O' N Y π
    hsurj' (fun _ => 0) (by intros; simp only [map_zero])
  have hs0 : (e F F' h').ρ O O' k₂ hk₂ t = 0 :=
    (huniq _ hres).trans (huniq 0 (fun j => map_zero _)).symm
  exact ⟨F', h', O', kO', k₂, hk₂, hkO'2, hkO'1, hpb₂, hs0⟩

theorem wc_subring_affine_etale_model : ∀ (R : Type u) [CommRing R] (U : (Spec (.of R)).Etale),
    IsAffine U.left → ∃ (F : Finset R) (V : (wcSubX R F).Etale) (k : U.left ⟶ V.left),
      IsAffine V.left ∧ IsPullback k U.hom V.hom (wcSubP R F) :=
by
  intro R _ U hU
  haveI : IsAffine U.left := hU
  haveI : IsAffine ((𝟭 Scheme).obj U.left) := hU
  haveI : IsAffine ((Functor.fromPUnit (Spec (.of R))).obj U.right) :=
    inferInstanceAs (IsAffine (Spec _))
  haveI : Etale U.hom := U.prop
  let φ : CommRingCat.of R ⟶ Γ(U.left, ⊤) :=
    (Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ U.hom.appTop
  have hφ : φ.hom.Etale := by
    have h_top : U.hom.appTop.hom.Etale := HasRingHomProperty.appTop @Etale U.hom inferInstance
    have h_bij : Function.Bijective (Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom :=
      ConcreteCategory.bijective_of_isIso _
    show (_ ≫ _ : CommRingCat.of R ⟶ Γ(U.left, ⊤)).hom.Etale
    rw [CommRingCat.hom_comp]
    exact RingHom.Etale.stableUnderComposition _ _ (RingHom.Etale.of_bijective h_bij) h_top

  letI : Algebra R Γ(U.left, ⊤) := φ.hom.toAlgebra
  haveI : Algebra.Etale R Γ(U.left, ⊤) := by
    rw [← RingHom.etale_algebraMap, RingHom.algebraMap_toAlgebra]
    exact hφ
  obtain ⟨A₀, B₀, _, _, hfg, hét, ⟨e⟩⟩ := Algebra.Etale.exists_subalgebra_fg ℤ R Γ(U.left, ⊤)
  obtain ⟨t, ht, hadj⟩ := Subalgebra.fg_def.mp hfg
  let F : Finset R := ht.toFinset
  have hmem : ∀ x : R, x ∈ Subring.closure (F : Set R) ↔ x ∈ A₀ := by
    intro x
    rw [← hadj, Algebra.adjoin_int, mem_subalgebraOfSubring, ht.coe_toFinset]
  let ψ : Subring.closure (F : Set R) ≃+* A₀ :=
    { toFun := fun x => ⟨x.1, (hmem x.1).mp x.2⟩
      invFun := fun y => ⟨y.1, (hmem y.1).mpr y.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_mul' := fun _ _ => rfl
      map_add' := fun _ _ => rfl }
  let θ : CommRingCat.of ↥(Subring.closure (F : Set R)) ⟶ CommRingCat.of B₀ :=
    CommRingCat.ofHom ((algebraMap A₀ B₀).comp ψ.toRingHom)
  have hθ : θ.hom.Etale :=
    RingHom.Etale.stableUnderComposition ψ.toRingHom (algebraMap A₀ B₀)
      (RingHom.Etale.of_bijective ψ.bijective) (RingHom.etale_algebraMap.mpr hét)
  have hP := CommRingCat.isPushout_tensorProduct A₀ R B₀
  let e₄ : CommRingCat.of (TensorProduct A₀ R B₀) ≅ Γ(U.left, ⊤) :=
    e.symm.toRingEquiv.toCommRingCatIso
  let ι : CommRingCat.of B₀ ⟶ Γ(U.left, ⊤) :=
    CommRingCat.ofHom (Algebra.TensorProduct.includeRight.toRingHom) ≫ e₄.hom
  have hpush : IsPushout (CommRingCat.ofHom (Subring.closure (F : Set R)).subtype) θ φ ι := by
    refine IsPushout.of_iso hP ψ.symm.toCommRingCatIso (Iso.refl _) (Iso.refl _) e₄ ?_ ?_ ?_ ?_
    · ext a; rfl
    · ext a; rfl
    · ext r
      change e.symm (r ⊗ₜ[A₀] (1 : B₀)) = φ.hom r
      have h := e.symm.commutes r
      exact h
    · exact (Category.id_comp ι).symm
  haveI : Etale (Spec.map θ) := (HasRingHomProperty.Spec_iff (P := @Etale)).mpr hθ
  let V : (wcSubX R F).Etale := Scheme.Etale.mk (Spec.map θ)
  have h1 := (isPullback_SpecMap_of_isPushout _ θ φ ι hpush).flip
  refine ⟨F, V, U.left.isoSpec.hom ≫ Spec.map ι, inferInstanceAs (IsAffine (Spec _)), ?_⟩
  refine IsPullback.of_iso h1 U.left.isoSpec.symm (Iso.refl _) (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
  · exact (Category.comp_id _).trans (Iso.inv_hom_id_assoc _ _).symm
  · refine (Category.comp_id _).trans ?_
    show Spec.map ((Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ U.hom.appTop) =
      U.left.isoSpec.inv ≫ U.hom
    rw [Spec.map_comp, ← Scheme.isoSpec_Spec_inv]
    exact Scheme.isoSpec_inv_naturality U.hom
  · exact (Category.comp_id _).trans (Category.id_comp _).symm
  · exact (Category.comp_id _).trans (Category.id_comp _).symm

theorem wc_subring_hom_descend : ∀ (R : Type u) [CommRing R] (U : (Spec (.of R)).Etale)
    (F₁ : Finset R) (W : (wcSubX R F₁).Etale) (k : U.left ⟶ W.left),
    IsAffine W.left → IsPullback k U.hom W.hom (wcSubP R F₁) →
    ∀ (F₂ : Finset R) (Y : (wcSubX R F₂).Etale) (g : U.left ⟶ Y.left),
    IsAffine Y.left → g ≫ Y.hom = U.hom ≫ wcSubP R F₂ →
    ∃ (F₃ : Finset R) (h₁ : F₁ ⊆ F₃) (h₂ : F₂ ⊆ F₃) (W' : (wcSubX R F₃).Etale)
      (b : W'.left ⟶ W.left) (k' : U.left ⟶ W'.left) (g' : W'.left ⟶ Y.left),
      IsAffine W'.left ∧ IsPullback b W'.hom W.hom (wcSubT R h₁) ∧
      IsPullback k' U.hom W'.hom (wcSubP R F₃) ∧ k' ≫ b = k ∧
      g' ≫ Y.hom = W'.hom ≫ wcSubT R h₂ ∧ k' ≫ g' = g :=
by
  classical
  intro R _ U F₁ W k hW hpb F₂ Y g hY hg
  haveI : Etale W.hom := W.prop
  haveI : Etale Y.hom := Y.prop
  haveI : IsAffine W.left := hW
  have hXaff : ∀ F : Finset R, IsAffine (wcSubX R F) := fun F => inferInstanceAs (IsAffine (Spec _))
  have hPT : ∀ {F F' : Finset R} (h : F ⊆ F'), wcSubP R F' ≫ wcSubT R h = wcSubP R F := by
    intro F F' h
    show Spec.map _ ≫ Spec.map _ = Spec.map _
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have e1 : (Subring.closure (F' : Set R)).subtype.comp
        (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h))) =
        (Subring.closure (F : Set R)).subtype := by
      apply RingHom.ext
      intro x
      simp
    rw [e1]
  have hTT : ∀ {F F' F'' : Finset R} (h₁ : F ⊆ F') (h₂ : F' ⊆ F''),
      wcSubT R h₂ ≫ wcSubT R h₁ = wcSubT R (Finset.Subset.trans h₁ h₂) := by
    intro F F' F'' h₁ h₂
    show Spec.map _ ≫ Spec.map _ = Spec.map _
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have e2 : (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h₂))).comp
        (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h₁))) =
        Subring.inclusion (Subring.closure_mono
          (Finset.coe_subset.mpr (Finset.Subset.trans h₁ h₂))) := by
      apply RingHom.ext
      intro x
      apply Subtype.ext
      simp
    rw [e2]

  have h14 : F₁ ⊆ F₁ ∪ F₂ := Finset.subset_union_left
  have h24 : F₂ ⊆ F₁ ∪ F₂ := Finset.subset_union_right
  haveI : IsAffine (wcSubX R F₁) := hXaff F₁
  haveI : IsAffine (wcSubX R (F₁ ∪ F₂)) := hXaff (F₁ ∪ F₂)
  let W₄ : (wcSubX R (F₁ ∪ F₂)).Etale := Scheme.Etale.mk (Limits.pullback.snd W.hom (wcSubT R h14))
  let pr₄ : W₄.left ⟶ W.left := Limits.pullback.fst W.hom (wcSubT R h14)
  have hpr₄ : IsPullback pr₄ W₄.hom W.hom (wcSubT R h14) := IsPullback.of_hasPullback _ _
  have hw : k ≫ W.hom = (U.hom ≫ wcSubP R (F₁ ∪ F₂)) ≫ wcSubT R h14 := by
    rw [Category.assoc, hPT h14]; exact hpb.toCommSq.w
  let k₄ : U.left ⟶ W₄.left := Limits.pullback.lift k (U.hom ≫ wcSubP R (F₁ ∪ F₂)) hw
  have hk₄ : k₄ ≫ pr₄ = k := Limits.pullback.lift_fst _ _ _
  have hk₄2 : k₄ ≫ W₄.hom = U.hom ≫ wcSubP R (F₁ ∪ F₂) := Limits.pullback.lift_snd _ _ _
  have hpb₄ : IsPullback k₄ U.hom W₄.hom (wcSubP R (F₁ ∪ F₂)) :=
    IsPullback.of_right (by rw [hk₄, hPT h14]; exact hpb) hk₄2 hpr₄
  haveI : IsAffine ((𝟭 Scheme).obj W.left) := hW
  haveI : IsAffineHom (wcSubT R h14) := isAffineHom_of_isAffine _
  haveI : IsAffineHom (Limits.pullback.fst W.hom (wcSubT R h14)) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom)
      (IsPullback.of_hasPullback W.hom (wcSubT R h14)).flip inferInstance
  haveI hPBaff : IsAffine (Limits.pullback W.hom (wcSubT R h14)) :=
    isAffine_of_isAffineHom (Limits.pullback.fst W.hom (wcSubT R h14))
  haveI hW₄aff : IsAffine W₄.left := hPBaff
  haveI : IsAffine ((𝟭 Scheme).obj W₄.left) := hPBaff
  haveI : Etale W₄.hom := W₄.prop
  haveI hW₄ah : IsAffineHom W₄.hom :=
    @isAffineHom_of_isAffine _ _ W₄.hom hPBaff (hXaff (F₁ ∪ F₂))

  obtain ⟨E, ρ, hE, sE, ⟨hlim⟩, hEaff, hEcpt, hEqs, -, -, -, hpbT, hsE, hρs, hEcomp, -⟩ :=
    wc_ap_fp_model_limit_presentation R U.left U.hom (F₁ ∪ F₂) W₄.left W₄.hom k₄
      inferInstance inferInstance inferInstance hpb₄
  haveI : ∀ {i j : (Finset R)ᵒᵖ} (f : i ⟶ j), IsAffineHom (E.map f) := hEaff
  haveI : ∀ i, CompactSpace (E.obj i) := hEcpt
  haveI : ∀ i, QuasiSeparatedSpace (E.obj i) := hEqs
  have hF2 : ∀ T : Finset R, F₂ ⊆ (F₁ ∪ F₂) ∪ T := fun T => h24.trans Finset.subset_union_left

  let τ : E ⟶ (Functor.const (Finset R)ᵒᵖ).obj (wcSubX R F₂) :=
    { app := fun i => hE i.unop ≫ wcSubT R (hF2 i.unop)
      naturality := by
        intro i j φ
        show E.map φ ≫ (hE j.unop ≫ wcSubT R (hF2 j.unop)) =
          (hE i.unop ≫ wcSubT R (hF2 i.unop)) ≫ 𝟙 _
        have h1 := hEcomp φ.unop
        rw [Quiver.Hom.op_unop] at h1
        rw [Category.comp_id, ← Category.assoc, h1, Category.assoc]
        congr 1
        exact hTT (hF2 j.unop) (Finset.union_subset_union_right (leOfHom φ.unop)) }

  have hcone : (Limits.Cone.mk U.left ρ).π ≫ τ =
      (Functor.const (Finset R)ᵒᵖ).map (g ≫ Y.hom) := by
    ext i
    show ρ.app (Opposite.op i.unop) ≫ hE i.unop ≫ wcSubT R (hF2 i.unop) = g ≫ Y.hom
    rw [← Category.assoc, (hpbT i.unop).toCommSq.w, Category.assoc, hPT (hF2 i.unop), hg]
  obtain ⟨i₀, g₀, hg₀1, hg₀2⟩ :=
    Scheme.exists_π_app_comp_eq_of_locallyOfFinitePresentation E τ Y.hom
      (Limits.Cone.mk U.left ρ) hlim g hcone

  have h43 : F₁ ∪ F₂ ⊆ (F₁ ∪ F₂) ∪ i₀.unop := Finset.subset_union_left
  have h₁ : F₁ ⊆ (F₁ ∪ F₂) ∪ i₀.unop := h14.trans h43
  have h₂ : F₂ ⊆ (F₁ ∪ F₂) ∪ i₀.unop := hF2 i₀.unop
  have hEet : Etale (hE i₀.unop) :=
    MorphismProperty.of_isPullback (P := @Etale) (hsE i₀.unop) inferInstance
  have hEah : IsAffineHom (hE i₀.unop) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) (hsE i₀.unop) inferInstance
  have hE0aff : IsAffine (E.obj (Opposite.op i₀.unop)) :=
    @isAffine_of_isAffineHom _ _ (hE i₀.unop) hEah (hXaff _)
  refine ⟨(F₁ ∪ F₂) ∪ i₀.unop, h₁, h₂, @Scheme.Etale.mk _ _ (hE i₀.unop) hEet, sE i₀.unop ≫ pr₄,
    ρ.app (Opposite.op i₀.unop), g₀, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact hE0aff
  · have hp := IsPullback.paste_horiz (hsE i₀.unop) hpr₄
    rw [show wcSubT R h₁ = wcSubT R h43 ≫ wcSubT R h14 from (hTT h14 h43).symm]
    exact hp
  · exact hpbT i₀.unop
  · exact (Category.assoc _ _ _).symm.trans ((congrArg (· ≫ pr₄) (hρs i₀.unop)).trans hk₄)
  · exact hg₀2
  · exact hg₀1

theorem wc_subring_surj_local_models : ∀ (R : Type u) [CommRing R]
    (G : ∀ F : Finset R, Sheaf (Scheme.smallEtaleTopology (wcSubX R F)) AddCommGrpCat.{u+1})
    (e : ∀ (F F' : Finset R) (h : F ⊆ F'), wcEtTransport (wcSubT R h) (G F) (G F'))
    (H : Sheaf (Scheme.smallEtaleTopology (Spec (.of R))) AddCommGrpCat.{u+1})
    (σ : ∀ F : Finset R, wcEtTransport (wcSubP R F) (G F) H),
    wcSubCocone R G e H σ → wcSubLocGen R G H σ →
    ∀ (F₀ : Finset R) (V₀ : (wcSubX R F₀).Etale) (U : (Spec (.of R)).Etale) (k₀ : U.left ⟶ V₀.left),
    IsAffine V₀.left → IsPullback k₀ U.hom V₀.hom (wcSubP R F₀) →
    ∀ s : H.obj.obj (Opposite.op U),
    ∃ (N : ℕ) (W : Fin N → (Spec (.of R)).Etale) (c : ∀ j, W j ⟶ U) (Fb : Fin N → Finset R)
      (hFb : ∀ j, F₀ ⊆ Fb j) (Z : ∀ j, (wcSubX R (Fb j)).Etale) (m : ∀ j, (W j).left ⟶ (Z j).left)
      (hm : ∀ j, m j ≫ (Z j).hom = (W j).hom ≫ wcSubP R (Fb j)) (a : ∀ j, (Z j).left ⟶ V₀.left)
      (x : ∀ j, (G (Fb j)).obj.obj (Opposite.op (Z j))),
      (∀ u : U.left, ∃ (j : Fin N) (w : (W j).left), (c j).left w = u) ∧
      (∀ j, IsAffine (Z j).left) ∧ (∀ j, IsPullback (m j) (W j).hom (Z j).hom (wcSubP R (Fb j))) ∧
      (∀ j, a j ≫ V₀.hom = (Z j).hom ≫ wcSubT R (hFb j)) ∧ (∀ j, m j ≫ a j = (c j).left ≫ k₀) ∧
      (∀ j, (σ (Fb j)).ρ (Z j) (W j) (m j) (hm j) (x j) = (H.obj.map (c j).op).hom s) :=
by
  classical
  intro R _ G e H σ hcone hgen F₀ V₀ U k₀ hA hpb s
  have hTT : ∀ {F₁ F₂ F₃ : Finset R} (h₁ : F₁ ⊆ F₂) (h₂ : F₂ ⊆ F₃),
      wcSubT R h₂ ≫ wcSubT R h₁ = wcSubT R (Finset.Subset.trans h₁ h₂) := by
    intro F₁ F₂ F₃ h₁ h₂
    show Spec.map _ ≫ Spec.map _ = Spec.map _
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have e2 : (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h₂))).comp
        (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h₁))) =
        Subring.inclusion (Subring.closure_mono
          (Finset.coe_subset.mpr (Finset.Subset.trans h₁ h₂))) := by
      apply RingHom.ext
      intro x
      apply Subtype.ext
      simp
    rw [e2]
  have hRW : ∀ {F : Finset R} {V : (wcSubX R F).Etale} {O : (Spec (.of R)).Etale}
      {a b : O.left ⟶ V.left} (ha : a ≫ V.hom = O.hom ≫ wcSubP R F)
      (hb : b ≫ V.hom = O.hom ≫ wcSubP R F), a = b →
      ∀ y, (σ F).ρ V O a ha y = (σ F).ρ V O b hb y := by
    intro F V O a b ha hb hab y
    subst hab
    rfl

  haveI : IsAffine V₀.left := hA
  haveI : IsAffine ((𝟭 Scheme).obj V₀.left) := hA
  haveI : ∀ F₁ : Finset R, IsAffine (wcSubX R F₁) := fun F₁ => inferInstanceAs (IsAffine (Spec _))
  haveI : IsAffine U.left := by
    haveI : IsAffineHom (wcSubP R F₀) := isAffineHom_of_isAffine _
    haveI : IsAffineHom (Limits.pullback.fst V₀.hom (wcSubP R F₀)) :=
      MorphismProperty.of_isPullback (P := @IsAffineHom)
        (IsPullback.of_hasPullback V₀.hom (wcSubP R F₀)).flip inferInstance
    haveI : IsAffine (Limits.pullback V₀.hom (wcSubP R F₀)) :=
      isAffine_of_isAffineHom (Limits.pullback.fst V₀.hom (wcSubP R F₀))
    exact IsAffine.of_isIso hpb.isoPullback.hom

  let Q : ∀ U' : (Spec (.of R)).Etale, (U' ⟶ U) → Prop := fun U' c =>
    ∃ (F₁ : Finset R) (Y : (wcSubX R F₁).Etale) (g : U'.left ⟶ Y.left)
      (hg : g ≫ Y.hom = U'.hom ≫ wcSubP R F₁) (t₁ : (G F₁).obj.obj (Opposite.op Y)),
      IsAffine Y.left ∧ (σ F₁).ρ Y U' g hg t₁ = (H.obj.map c.op).hom s
  have hQs : ∀ (U' U'' : (Spec (.of R)).Etale) (c : U' ⟶ U) (d : U'' ⟶ U'),
      Q U' c → Q U'' (d ≫ c) := by
    rintro U' U'' c d ⟨F₁, Y, g, hg, t₁, hY, ht⟩
    have hg' : (d.left ≫ g) ≫ Y.hom = U''.hom ≫ wcSubP R F₁ := by
      rw [Category.assoc, hg, ← Category.assoc, MorphismProperty.Over.w d]
    refine ⟨F₁, Y, d.left ≫ g, hg', t₁, hY, ?_⟩
    have h1 := (σ F₁).nat Y Y (𝟙 Y) U' U'' d g hg (d.left ≫ g) hg'
      (by show (d.left ≫ g) ≫ 𝟙 _ = _; rw [Category.comp_id]) t₁
    rw [op_id, CategoryTheory.Functor.map_id] at h1
    calc (σ F₁).ρ Y U'' (d.left ≫ g) hg' t₁
        = (H.obj.map d.op) ((σ F₁).ρ Y U' g hg t₁) := h1
      _ = (H.obj.map (d ≫ c).op).hom s := by
          rw [ht, op_comp, CategoryTheory.Functor.map_comp]
          rfl

  have hQl : ∀ u : U.left, ∃ (U' : (Spec (.of R)).Etale) (c : U' ⟶ U) (u' : U'.left),
      c.left u' = u ∧ Q U' c := by
    intro u
    obtain ⟨U₁, c₁, u₁, F, V, k, hk, t₁, hu, hσ⟩ := hgen U s u
    obtain ⟨B, hB, hkB, -⟩ : ∃ B : V.left.Opens, B ∈ V.left.affineOpens ∧ k u₁ ∈ B ∧
        B ≤ (⊤ : V.left.Opens) :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
        V.left.isBasis_affineOpens) (show k u₁ ∈ (⊤ : V.left.Opens) from trivial)
    haveI : Etale V.hom := V.prop
    haveI : Etale U₁.hom := U₁.prop
    let Y : (wcSubX R F).Etale := Scheme.Etale.mk (B.ι ≫ V.hom)
    let ιY : Y ⟶ V := MorphismProperty.Over.homMk B.ι rfl trivial
    let U' : (Spec (.of R)).Etale := Scheme.Etale.mk ((k ⁻¹ᵁ B).ι ≫ U₁.hom)
    let ι' : U' ⟶ U₁ := MorphismProperty.Over.homMk (k ⁻¹ᵁ B).ι rfl trivial
    have hg : (k ∣_ B) ≫ Y.hom = U'.hom ≫ wcSubP R F := by
      show (k ∣_ B) ≫ B.ι ≫ V.hom = ((k ⁻¹ᵁ B).ι ≫ U₁.hom) ≫ wcSubP R F
      rw [← Category.assoc, morphismRestrict_ι, Category.assoc, hk, Category.assoc]
    have hu' : u₁ ∈ k ⁻¹ᵁ B := hkB
    refine ⟨U', ι' ≫ c₁, ⟨u₁, hu'⟩, ?_, F, Y, k ∣_ B, hg, ((G F).obj.map ιY.op).hom t₁,
      (show IsAffine (B : Scheme) from hB), ?_⟩
    · have e1 : (ι' ≫ c₁).left = (k ⁻¹ᵁ B).ι ≫ c₁.left := rfl
      rw [e1]
      calc ((k ⁻¹ᵁ B).ι ≫ c₁.left) ⟨u₁, hu'⟩
          = c₁.left ((k ⁻¹ᵁ B).ι ⟨u₁, hu'⟩) := Scheme.Hom.comp_apply _ _ _
        _ = c₁.left u₁ := by rw [Scheme.Opens.ι_apply]
        _ = u := hu
    · have h1 := (σ F).nat V Y ιY U₁ U' ι' k hk (k ∣_ B) hg (morphismRestrict_ι k B) t₁
      calc (σ F).ρ Y U' (k ∣_ B) hg (((G F).obj.map ιY.op).hom t₁)
          = (H.obj.map ι'.op) ((σ F).ρ V U₁ k hk t₁) := h1
        _ = (H.obj.map (ι' ≫ c₁).op).hom s := by
            rw [hσ, op_comp, CategoryTheory.Functor.map_comp]
            rfl
  obtain ⟨N, W, c, hWaff, hQ, hsurj⟩ := wc_et_affine_finite_refine _ U inferInstance Q hQs hQl
  dsimp only [Q] at hQ
  choose Fy Y g hg t hYaff ht using hQ

  have hpiece : ∀ j, ∃ (Fb : Finset R) (hFb : F₀ ⊆ Fb) (Z : (wcSubX R Fb).Etale)
      (m : (W j).left ⟶ Z.left) (hm : m ≫ Z.hom = (W j).hom ≫ wcSubP R Fb) (a : Z.left ⟶ V₀.left)
      (x : (G Fb).obj.obj (Opposite.op Z)),
      IsAffine Z.left ∧ IsPullback m (W j).hom Z.hom (wcSubP R Fb) ∧
      a ≫ V₀.hom = Z.hom ≫ wcSubT R hFb ∧ m ≫ a = (c j).left ≫ k₀ ∧
      (σ Fb).ρ Z (W j) m hm x = (H.obj.map (c j).op).hom s := by
    intro j
    obtain ⟨Fa, Z0, m0, hZ0, hm0⟩ := wc_subring_affine_etale_model R (W j) (hWaff j)
    have hck : ((c j).left ≫ k₀) ≫ V₀.hom = (W j).hom ≫ wcSubP R F₀ := by
      rw [Category.assoc, hpb.toCommSq.w, ← Category.assoc, MorphismProperty.Over.w (c j)]
    obtain ⟨F₁, h₁a, h₂a, W₁, b₁, k₁, a₁, hW₁, -, hk₁pb, -, ha₁, hk₁a⟩ :=
      wc_subring_hom_descend R (W j) Fa Z0 m0 hZ0 hm0 F₀ V₀ ((c j).left ≫ k₀) hA hck
    obtain ⟨Fb, h₁b, h₂b, Z, b₂, m, β, hZ, hb₂, hmpb, hmb, hβ, hmβ⟩ :=
      wc_subring_hom_descend R (W j) F₁ W₁ k₁ hW₁ hk₁pb (Fy j) (Y j) (g j) (hYaff j) (hg j)
    refine ⟨Fb, Finset.Subset.trans h₂a h₁b, Z, m, hmpb.toCommSq.w, b₂ ≫ a₁,
      (e (Fy j) Fb h₂b).ρ (Y j) Z β hβ (t j), hZ, hmpb, ?_, ?_, ?_⟩
    · rw [Category.assoc, ha₁, ← Category.assoc, hb₂.toCommSq.w, Category.assoc, hTT]
    · rw [← Category.assoc, hmb, hk₁a]
    · have hc := hcone (Fy j) Fb h₂b (Y j) Z β hβ (W j) m hmpb.toCommSq.w (t j)
      exact hc.symm.trans ((hRW _ _ hmβ (t j)).trans (ht j))
  choose Fb hFb Z m hm a x hZ hmpb ha hma hx using hpiece
  exact ⟨N, W, c, Fb, hFb, Z, m, hm, a, x, hsurj, hZ, hmpb, ha, hma, hx⟩

theorem wc_subring_glue_models : ∀ (R : Type u) [CommRing R]
    (G : ∀ F : Finset R, Sheaf (Scheme.smallEtaleTopology (wcSubX R F)) AddCommGrpCat.{u+1})
    (e : ∀ (F F' : Finset R) (h : F ⊆ F'), wcEtTransport (wcSubT R h) (G F) (G F'))
    (H : Sheaf (Scheme.smallEtaleTopology (Spec (.of R))) AddCommGrpCat.{u+1})
    (σ : ∀ F : Finset R, wcEtTransport (wcSubP R F) (G F) H),
    wcSubCoherent R G e → wcSubCocone R G e H σ → wcSubLocKer R G e H σ →
    ∀ (U : (Spec (.of R)).Etale) (F : Finset R) (O : (wcSubX R F).Etale) (kO : U.left ⟶ O.left)
      (hkO : kO ≫ O.hom = U.hom ≫ wcSubP R F),
    IsAffine O.left → IsPullback kO U.hom O.hom (wcSubP R F) →
    ∀ (N : ℕ) (W : Fin N → (Spec (.of R)).Etale) (c : ∀ j, W j ⟶ U) (Z : Fin N → (wcSubX R F).Etale)
      (w : ∀ j, Z j ⟶ O) (m : ∀ j, (W j).left ⟶ (Z j).left)
      (hm : ∀ j, m j ≫ (Z j).hom = (W j).hom ≫ wcSubP R F)
      (x : ∀ j, (G F).obj.obj (Opposite.op (Z j))) (s : H.obj.obj (Opposite.op U)),
    (∀ u : U.left, ∃ (j : Fin N) (y : (W j).left), (c j).left y = u) →
    (∀ j, IsAffine (Z j).left) → (∀ j, IsPullback (m j) (W j).hom (Z j).hom (wcSubP R F)) →
    (∀ j, m j ≫ (w j).left = (c j).left ≫ kO) →
    (∀ j, (σ F).ρ (Z j) (W j) (m j) (hm j) (x j) = (H.obj.map (c j).op).hom s) →
    ∃ (F' : Finset R) (h : F ⊆ F') (O' : (wcSubX R F').Etale) (κ : O'.left ⟶ O.left)
      (kO' : U.left ⟶ O'.left) (hkO' : kO' ≫ O'.hom = U.hom ≫ wcSubP R F')
      (y : (G F').obj.obj (Opposite.op O')),
      IsPullback κ O'.hom O.hom (wcSubT R h) ∧ kO' ≫ κ = kO ∧ (σ F').ρ O' U kO' hkO' y = s :=
by
  classical
  intro R _ G e H σ hco hcone hker U F O kO hkO hO hpbO N W c Z w m hm x s hsurj hZaff hZpb hmw hx

  have hPT : ∀ {F₁ F₂ : Finset R} (h : F₁ ⊆ F₂), wcSubP R F₂ ≫ wcSubT R h = wcSubP R F₁ := by
    intro F₁ F₂ h
    show Spec.map _ ≫ Spec.map _ = Spec.map _
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have e1 : (Subring.closure (F₂ : Set R)).subtype.comp
        (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h))) =
        (Subring.closure (F₁ : Set R)).subtype := by
      apply RingHom.ext
      intro x
      simp
    rw [e1]
  have hTT : ∀ {F₁ F₂ F₃ : Finset R} (h₁ : F₁ ⊆ F₂) (h₂ : F₂ ⊆ F₃),
      wcSubT R h₂ ≫ wcSubT R h₁ = wcSubT R (Finset.Subset.trans h₁ h₂) := by
    intro F₁ F₂ F₃ h₁ h₂
    show Spec.map _ ≫ Spec.map _ = Spec.map _
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have e2 : (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h₂))).comp
        (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h₁))) =
        Subring.inclusion (Subring.closure_mono
          (Finset.coe_subset.mpr (Finset.Subset.trans h₁ h₂))) := by
      apply RingHom.ext
      intro x
      apply Subtype.ext
      simp
    rw [e2]

  have hRWe : ∀ {F₁ F₂ : Finset R} (hh : F₁ ⊆ F₂) {V : (wcSubX R F₁).Etale}
      {O₁ : (wcSubX R F₂).Etale} {a b : O₁.left ⟶ V.left}
      (ha : a ≫ V.hom = O₁.hom ≫ wcSubT R hh) (hb : b ≫ V.hom = O₁.hom ≫ wcSubT R hh), a = b →
      ∀ y, (e F₁ F₂ hh).ρ V O₁ a ha y = (e F₁ F₂ hh).ρ V O₁ b hb y := by
    intro F₁ F₂ hh V O₁ a b ha hb hab y
    subst hab
    rfl
  have hRWσ : ∀ {F₁ : Finset R} {V : (wcSubX R F₁).Etale} {O₁ : (Spec (.of R)).Etale}
      {a b : O₁.left ⟶ V.left} (ha : a ≫ V.hom = O₁.hom ≫ wcSubP R F₁)
      (hb : b ≫ V.hom = O₁.hom ≫ wcSubP R F₁), a = b →
      ∀ y, (σ F₁).ρ V O₁ a ha y = (σ F₁).ρ V O₁ b hb y := by
    intro F₁ V O₁ a b ha hb hab y
    subst hab
    rfl
  have hcompH : ∀ {A B C : (Spec (.of R)).Etale} (a : A ⟶ B) (b : B ⟶ C)
      (t : H.obj.obj (Opposite.op C)),
      (H.obj.map a.op).hom ((H.obj.map b.op).hom t) = (H.obj.map (a ≫ b).op).hom t := by
    intro A B C a b t
    rw [op_comp, CategoryTheory.Functor.map_comp]
    rfl

  have hAffPB : ∀ {X₁ Y₁ S₁ : Scheme.{u}} (f : X₁ ⟶ S₁) (g : Y₁ ⟶ S₁),
      IsAffine X₁ → IsAffine Y₁ → IsAffine S₁ → IsAffine (Limits.pullback f g) := by
    intro X₁ Y₁ S₁ f g hX hY hS
    haveI := hX
    haveI := hY
    haveI := hS
    haveI : IsAffineHom g := isAffineHom_of_isAffine g
    haveI : IsAffineHom (Limits.pullback.fst f g) :=
      MorphismProperty.of_isPullback (P := @IsAffineHom) (IsPullback.of_hasPullback f g).flip
        inferInstance
    exact isAffine_of_isAffineHom (Limits.pullback.fst f g)

  have hover : ∀ i j : Fin N, ∃ (F₁ : Finset R) (h₁ : F ⊆ F₁), ∀ (F₂ : Finset R) (h₂ : F₁ ⊆ F₂)
      (Z' : (wcSubX R F₂).Etale) (α : Z'.left ⟶ (Z i).left) (β : Z'.left ⟶ (Z j).left)
      (hα : α ≫ (Z i).hom = Z'.hom ≫ wcSubT R (Finset.Subset.trans h₁ h₂))
      (hβ : β ≫ (Z j).hom = Z'.hom ≫ wcSubT R (Finset.Subset.trans h₁ h₂)),
      α ≫ (w i).left = β ≫ (w j).left →
      (e F F₂ (Finset.Subset.trans h₁ h₂)).ρ (Z i) Z' α hα (x i) =
        (e F F₂ (Finset.Subset.trans h₁ h₂)).ρ (Z j) Z' β hβ (x j) := by
    intro i j

    obtain ⟨P, p₁, p₂, hp, hPaff, hPuniv⟩ : ∃ (P : (wcSubX R F).Etale) (p₁ : P ⟶ Z i)
        (p₂ : P ⟶ Z j), p₁.left ≫ (w i).left = p₂.left ≫ (w j).left ∧ IsAffine P.left ∧
        ∀ (T : Scheme.{u}) (α : T ⟶ (Z i).left) (β : T ⟶ (Z j).left),
          α ≫ (w i).left = β ≫ (w j).left →
          ∃ μ : T ⟶ P.left, μ ≫ p₁.left = α ∧ μ ≫ p₂.left = β := by
      have h1 : Limits.pullback.fst (w i).left (w j).left ≫ (Z i).hom =
          Limits.pullback.snd (w i).left (w j).left ≫ (Z j).hom := by
        rw [← MorphismProperty.Over.w (w i), Limits.pullback.condition_assoc,
          MorphismProperty.Over.w (w j)]
      refine ⟨Scheme.Etale.mk (Limits.pullback.snd (w i).left (w j).left ≫ (Z j).hom),
        MorphismProperty.Over.homMk (Limits.pullback.fst (w i).left (w j).left) h1 trivial,
        MorphismProperty.Over.homMk (Limits.pullback.snd (w i).left (w j).left) rfl trivial,
        Limits.pullback.condition, hAffPB _ _ (hZaff i) (hZaff j) hO, ?_⟩
      intro T α β hαβ
      exact ⟨Limits.pullback.lift α β hαβ, Limits.pullback.lift_fst _ _ _,
        Limits.pullback.lift_snd _ _ _⟩
    have hp1 : p₁.left ≫ (Z i).hom = P.hom := MorphismProperty.Over.w p₁
    have hp2 : p₂.left ≫ (Z j).hom = P.hom := MorphismProperty.Over.w p₂

    obtain ⟨Q, kQ, hpbQ⟩ : ∃ (Q : (Spec (.of R)).Etale) (kQ : Q.left ⟶ P.left),
        IsPullback kQ Q.hom P.hom (wcSubP R F) :=
      ⟨Scheme.Etale.mk (Limits.pullback.snd P.hom (wcSubP R F)), Limits.pullback.fst _ _,
        IsPullback.of_hasPullback _ _⟩
    have hkQ : kQ ≫ P.hom = Q.hom ≫ wcSubP R F := hpbQ.toCommSq.w
    obtain ⟨ρ₁, hρ₁⟩ : ∃ ρ : Q ⟶ W i, ρ.left ≫ m i = kQ ≫ p₁.left :=
      ⟨MorphismProperty.Over.homMk ((hZpb i).lift (kQ ≫ p₁.left) Q.hom
          (by rw [Category.assoc, hp1, hkQ])) ((hZpb i).lift_snd _ _ _) trivial,
        (hZpb i).lift_fst _ _ _⟩
    obtain ⟨ρ₂, hρ₂⟩ : ∃ ρ : Q ⟶ W j, ρ.left ≫ m j = kQ ≫ p₂.left :=
      ⟨MorphismProperty.Over.homMk ((hZpb j).lift (kQ ≫ p₂.left) Q.hom
          (by rw [Category.assoc, hp2, hkQ])) ((hZpb j).lift_snd _ _ _) trivial,
        (hZpb j).lift_fst _ _ _⟩
    have hρc : ρ₁ ≫ c i = ρ₂ ≫ c j := by
      apply MorphismProperty.Over.Hom.ext
      show ρ₁.left ≫ (c i).left = ρ₂.left ≫ (c j).left
      apply hpbO.hom_ext
      · calc (ρ₁.left ≫ (c i).left) ≫ kO = ρ₁.left ≫ m i ≫ (w i).left := by
              rw [Category.assoc, ← hmw i]
          _ = kQ ≫ p₁.left ≫ (w i).left := by rw [← Category.assoc, hρ₁, Category.assoc]
          _ = kQ ≫ p₂.left ≫ (w j).left := by rw [hp]
          _ = ρ₂.left ≫ m j ≫ (w j).left := by rw [← Category.assoc, ← hρ₂, Category.assoc]
          _ = (ρ₂.left ≫ (c j).left) ≫ kO := by rw [Category.assoc, ← hmw j]
      · rw [Category.assoc, Category.assoc, MorphismProperty.Over.w (c i),
          MorphismProperty.Over.w (c j), MorphismProperty.Over.w ρ₁, MorphismProperty.Over.w ρ₂]
    have hs1 : (σ F).ρ P Q kQ hkQ (((G F).obj.map p₁.op).hom (x i)) =
        (H.obj.map (ρ₁ ≫ c i).op).hom s := by
      have h1 := (σ F).nat (Z i) P p₁ (W i) Q ρ₁ (m i) (hm i) kQ hkQ hρ₁.symm (x i)
      calc (σ F).ρ P Q kQ hkQ (((G F).obj.map p₁.op).hom (x i))
          = (H.obj.map ρ₁.op).hom ((σ F).ρ (Z i) (W i) (m i) (hm i) (x i)) := h1
        _ = (H.obj.map ρ₁.op).hom ((H.obj.map (c i).op).hom s) := by rw [hx i]
        _ = _ := hcompH _ _ _
    have hs2 : (σ F).ρ P Q kQ hkQ (((G F).obj.map p₂.op).hom (x j)) =
        (H.obj.map (ρ₂ ≫ c j).op).hom s := by
      have h1 := (σ F).nat (Z j) P p₂ (W j) Q ρ₂ (m j) (hm j) kQ hkQ hρ₂.symm (x j)
      calc (σ F).ρ P Q kQ hkQ (((G F).obj.map p₂.op).hom (x j))
          = (H.obj.map ρ₂.op).hom ((σ F).ρ (Z j) (W j) (m j) (hm j) (x j)) := h1
        _ = (H.obj.map ρ₂.op).hom ((H.obj.map (c j).op).hom s) := by rw [hx j]
        _ = _ := hcompH _ _ _
    have hσd : (σ F).ρ P Q kQ hkQ
        (((G F).obj.map p₁.op).hom (x i) - ((G F).obj.map p₂.op).hom (x j)) = 0 := by
      rw [map_sub, hs1, hs2, hρc, sub_self]

    obtain ⟨F₁, h₁, P', kP', lam, hlam, -, -, hpblam, hd0⟩ :=
      wc_subring_affsec_ker R G e H σ hco hker Q F P kQ hkQ hPaff hpbQ _ hσd
    refine ⟨F₁, h₁, ?_⟩

    intro F₂ h₂ Z' α β hα hβ hαβ
    obtain ⟨μ, hμ1, hμ2⟩ := hPuniv Z'.left α β hαβ
    have hμ : μ ≫ P.hom = Z'.hom ≫ wcSubT R (Finset.Subset.trans h₁ h₂) := by
      rw [← hp1, ← Category.assoc, hμ1, hα]
    have hcν : μ ≫ P.hom = (Z'.hom ≫ wcSubT R h₂) ≫ wcSubT R h₁ := by
      rw [hμ, Category.assoc, hTT]
    obtain ⟨ν, hνl, hν⟩ : ∃ ν : Z'.left ⟶ P'.left, ν ≫ lam = μ ∧
        ν ≫ P'.hom = Z'.hom ≫ wcSubT R h₂ :=
      ⟨hpblam.lift μ _ hcν, hpblam.lift_fst _ _ _, hpblam.lift_snd _ _ _⟩
    have hA := (e F F₂ (Finset.Subset.trans h₁ h₂)).nat (Z i) P p₁ Z' Z' (𝟙 Z') α hα μ hμ
      (by rw [hμ1]; exact (Category.id_comp α).symm) (x i)
    have hB := (e F F₂ (Finset.Subset.trans h₁ h₂)).nat (Z j) P p₂ Z' Z' (𝟙 Z') β hβ μ hμ
      (by rw [hμ2]; exact (Category.id_comp β).symm) (x j)
    rw [op_id, CategoryTheory.Functor.map_id] at hA hB
    have hA' : (e F F₂ (Finset.Subset.trans h₁ h₂)).ρ (Z i) Z' α hα (x i) =
        (e F F₂ (Finset.Subset.trans h₁ h₂)).ρ P Z' μ hμ (((G F).obj.map p₁.op).hom (x i)) :=
      hA.symm
    have hB' : (e F F₂ (Finset.Subset.trans h₁ h₂)).ρ (Z j) Z' β hβ (x j) =
        (e F F₂ (Finset.Subset.trans h₁ h₂)).ρ P Z' μ hμ (((G F).obj.map p₂.op).hom (x j)) :=
      hB.symm
    have key : (e F F₂ (Finset.Subset.trans h₁ h₂)).ρ P Z' μ hμ
        (((G F).obj.map p₁.op).hom (x i) - ((G F).obj.map p₂.op).hom (x j)) = 0 := by
      have h3 := hco.2 F F₁ F₂ h₁ h₂ P P' lam hlam Z' ν hν
        (((G F).obj.map p₁.op).hom (x i) - ((G F).obj.map p₂.op).hom (x j))
      rw [hd0, map_zero] at h3
      exact (hRWe _ hμ _ hνl.symm _).trans h3
    rw [map_sub] at key
    rw [← sub_eq_zero, hA', hB']
    exact key
  choose Fo ho hagree using hover

  have hcovZ : ∀ u : U.left, ∃ (j : Fin N) (y : (Z j).left), (w j).left y = kO u := by
    intro u
    obtain ⟨j, y, hy⟩ := hsurj u
    refine ⟨j, m j y, ?_⟩
    calc (w j).left (m j y) = (m j ≫ (w j).left) y := (Scheme.Hom.comp_apply _ _ _).symm
      _ = ((c j).left ≫ kO) y := by rw [hmw j]
      _ = kO u := by rw [Scheme.Hom.comp_apply, hy]
  obtain ⟨Fc, hc, Cov⟩ := wc_subring_cover_descend R U F O kO hO hpbO N Z w hcovZ
  let F' : Finset R := Fc ∪ Finset.univ.biUnion (fun p : Fin N × Fin N => Fo p.1 p.2)
  have hcF : Fc ⊆ F' := Finset.subset_union_left
  have hoF : ∀ i j, Fo i j ⊆ F' := fun i j =>
    (Finset.subset_biUnion_of_mem (fun p : Fin N × Fin N => Fo p.1 p.2)
      (Finset.mem_univ (i, j))).trans Finset.subset_union_right
  have h : F ⊆ F' := Finset.Subset.trans hc hcF
  obtain ⟨O', κ, hκ⟩ : ∃ (O' : (wcSubX R F').Etale) (κ : O'.left ⟶ O.left),
      IsPullback κ O'.hom O.hom (wcSubT R h) :=
    ⟨Scheme.Etale.mk (Limits.pullback.snd O.hom (wcSubT R h)), Limits.pullback.fst _ _,
      IsPullback.of_hasPullback _ _⟩
  obtain ⟨kO', hkκ, hkO'⟩ : ∃ k : U.left ⟶ O'.left, k ≫ κ = kO ∧
      k ≫ O'.hom = U.hom ≫ wcSubP R F' :=
    ⟨hκ.lift kO (U.hom ≫ wcSubP R F') (by rw [hkO, Category.assoc, hPT]),
      hκ.lift_fst _ _ _, hκ.lift_snd _ _ _⟩
  have hcovO' := Cov F' hcF O' κ hκ
  have hPex : ∀ j, ∃ (Y : (wcSubX R F').Etale) (π : Y ⟶ O') (φ : Y.left ⟶ (Z j).left),
      φ ≫ (w j).left = π.left ≫ κ ∧
      (∀ (T : Scheme.{u}) (a : T ⟶ (Z j).left) (b : T ⟶ O'.left), a ≫ (w j).left = b ≫ κ →
        ∃ θ : T ⟶ Y.left, θ ≫ φ = a ∧ θ ≫ π.left = b) ∧
      ∀ z : O'.left, (∃ y, (w j).left y = κ z) → ∃ ζ, π.left ζ = z := by
    intro j
    refine ⟨Scheme.Etale.mk (Limits.pullback.snd (w j).left κ ≫ O'.hom),
      MorphismProperty.Over.homMk (Limits.pullback.snd (w j).left κ) rfl trivial,
      Limits.pullback.fst _ _, Limits.pullback.condition, ?_, ?_⟩
    · intro T a b hab
      exact ⟨Limits.pullback.lift a b hab, Limits.pullback.lift_fst _ _ _,
        Limits.pullback.lift_snd _ _ _⟩
    · rintro z ⟨y, hy⟩
      obtain ⟨ζ, -, hζ⟩ := Scheme.Pullback.exists_preimage_pullback y z hy
      exact ⟨ζ, hζ⟩
  choose Y π φ hφw hYuniv hYsurj using hPex
  have hφ : ∀ j, φ j ≫ (Z j).hom = (Y j).hom ≫ wcSubT R h := by
    intro j
    rw [← MorphismProperty.Over.w (w j), ← Category.assoc, hφw j, Category.assoc,
      hκ.toCommSq.w, ← Category.assoc, MorphismProperty.Over.w (π j)]
  have hsurjO' : ∀ v : O'.left, ∃ (i : Fin N) (y : (Y i).left), (π i).left y = v := by
    intro z
    obtain ⟨j, y, hy⟩ := hcovO' z
    exact ⟨j, hYsurj j z ⟨y, hy⟩⟩
  let x'' : ∀ j, (G F').obj.obj (Opposite.op (Y j)) := fun j =>
    (e F F' h).ρ (Z j) (Y j) (φ j) (hφ j) (x j)

  have hcompat : ∀ (i j : Fin N) (Z' : (wcSubX R F').Etale) (a : Z' ⟶ Y i) (b : Z' ⟶ Y j),
      a ≫ π i = b ≫ π j →
      ((G F').obj.map a.op).hom (x'' i) = ((G F').obj.map b.op).hom (x'' j) := by
    intro i j Z' a b hab
    have hab' : a.left ≫ (π i).left = b.left ≫ (π j).left :=
      congrArg (fun f => f.left) hab
    have hαa : (a.left ≫ φ i) ≫ (Z i).hom = Z'.hom ≫ wcSubT R h := by
      rw [Category.assoc, hφ i, ← Category.assoc, MorphismProperty.Over.w a]
    have hβb : (b.left ≫ φ j) ≫ (Z j).hom = Z'.hom ≫ wcSubT R h := by
      rw [Category.assoc, hφ j, ← Category.assoc, MorphismProperty.Over.w b]
    have hA := (e F F' h).nat (Z i) (Z i) (𝟙 (Z i)) (Y i) Z' a (φ i) (hφ i) (a.left ≫ φ i) hαa
      (Category.comp_id _) (x i)
    have hB := (e F F' h).nat (Z j) (Z j) (𝟙 (Z j)) (Y j) Z' b (φ j) (hφ j) (b.left ≫ φ j) hβb
      (Category.comp_id _) (x j)
    rw [op_id, CategoryTheory.Functor.map_id] at hA hB
    have hw : (a.left ≫ φ i) ≫ (w i).left = (b.left ≫ φ j) ≫ (w j).left := by
      simp only [Category.assoc]
      rw [hφw i, hφw j, ← Category.assoc, hab', Category.assoc]
    have hg := hagree i j F' (hoF i j) Z' (a.left ≫ φ i) (b.left ≫ φ j) hαa hβb hw
    exact hA.symm.trans (hg.trans hB)
  obtain ⟨y, hy, -⟩ := wc_et_sheaf_glue_jointly_surjective (wcSubX R F') (G F') O' N Y π
    hsurjO' x'' hcompat

  have hloc : ∀ j, (H.obj.map (c j).op).hom ((σ F').ρ O' U kO' hkO' y) =
      (H.obj.map (c j).op).hom s := by
    intro j
    obtain ⟨θ, hθφ, hθπ⟩ := hYuniv j (W j).left (m j) ((c j).left ≫ kO')
      (by rw [hmw j, Category.assoc, hkκ])
    have hθ : θ ≫ (Y j).hom = (W j).hom ≫ wcSubP R F' := by
      rw [← MorphismProperty.Over.w (π j), ← Category.assoc, hθπ, Category.assoc, hkO',
        ← Category.assoc, MorphismProperty.Over.w (c j)]
    have hck : ((c j).left ≫ kO') ≫ O'.hom = (W j).hom ≫ wcSubP R F' := by
      rw [Category.assoc, hkO', ← Category.assoc, MorphismProperty.Over.w (c j)]
    have hθk : (θ ≫ (π j).left) ≫ O'.hom = (W j).hom ≫ wcSubP R F' := by
      rw [hθπ]
      exact hck
    have h1 := (σ F').nat O' O' (𝟙 O') U (W j) (c j) kO' hkO' ((c j).left ≫ kO') hck
      (Category.comp_id _) y
    rw [op_id, CategoryTheory.Functor.map_id] at h1
    have h3 := (σ F').nat O' (Y j) (π j) (W j) (W j) (𝟙 (W j)) (θ ≫ (π j).left) hθk θ hθ
      (Category.id_comp _).symm y
    rw [op_id, CategoryTheory.Functor.map_id] at h3
    have h5 := hcone F F' h (Z j) (Y j) (φ j) (hφ j) (W j) θ hθ (x j)
    calc (H.obj.map (c j).op).hom ((σ F').ρ O' U kO' hkO' y)
        = (σ F').ρ O' (W j) ((c j).left ≫ kO') hck y := h1.symm
      _ = (σ F').ρ O' (W j) (θ ≫ (π j).left) hθk y := hRWσ _ _ hθπ.symm y
      _ = (σ F').ρ (Y j) (W j) θ hθ (((G F').obj.map (π j).op).hom y) := h3.symm
      _ = (σ F').ρ (Y j) (W j) θ hθ (x'' j) := by rw [hy j]
      _ = (σ F).ρ (Z j) (W j) (θ ≫ φ j) _ (x j) := h5.symm
      _ = (σ F).ρ (Z j) (W j) (m j) (hm j) (x j) := hRWσ _ _ hθφ _
      _ = (H.obj.map (c j).op).hom s := hx j
  obtain ⟨s0, -, huniqH⟩ := wc_et_sheaf_glue_jointly_surjective (Spec (.of R)) H U N W c hsurj
    (fun j => (H.obj.map (c j).op).hom s) (by
      intro i j Z' a b hab
      rw [hcompH, hcompH, hab])
  have hσy : (σ F').ρ O' U kO' hkO' y = s :=
    (huniqH _ hloc).trans (huniqH s (fun j => rfl)).symm
  exact ⟨F', h, O', κ, kO', hkO', y, hκ, hkκ, hσy⟩

theorem wc_subring_affsec_surj : ∀ (R : Type u) [CommRing R]
    (G : ∀ F : Finset R, Sheaf (Scheme.smallEtaleTopology (wcSubX R F)) AddCommGrpCat.{u+1})
    (e : ∀ (F F' : Finset R) (h : F ⊆ F'), wcEtTransport (wcSubT R h) (G F) (G F'))
    (H : Sheaf (Scheme.smallEtaleTopology (Spec (.of R))) AddCommGrpCat.{u+1})
    (σ : ∀ F : Finset R, wcEtTransport (wcSubP R F) (G F) H),
    wcSubCoherent R G e → wcSubCocone R G e H σ → wcSubLocGen R G H σ → wcSubLocKer R G e H σ →
    ∀ (F₀ : Finset R) (V₀ : (wcSubX R F₀).Etale) (U : (Spec (.of R)).Etale) (k₀ : U.left ⟶ V₀.left),
    IsAffine V₀.left → IsPullback k₀ U.hom V₀.hom (wcSubP R F₀) →
    ∀ s : H.obj.obj (Opposite.op U), ∃ (F : Finset R) (h : F₀ ⊆ F) (O : (wcSubX R F).Etale)
      (kO : U.left ⟶ O.left) (hkO : kO ≫ O.hom = U.hom ≫ wcSubP R F) (k₁ : O.left ⟶ V₀.left)
      (t : (G F).obj.obj (Opposite.op O)),
      kO ≫ k₁ = k₀ ∧ IsPullback k₁ O.hom V₀.hom (wcSubT R h) ∧ (σ F).ρ O U kO hkO t = s :=
by
  classical
  intro R _ G e H σ hco hcone hgen hker F₀ V₀ U k₀ hA hpb s
  have hPT : ∀ {F F' : Finset R} (h : F ⊆ F'), wcSubP R F' ≫ wcSubT R h = wcSubP R F := by
    intro F F' h
    show Spec.map _ ≫ Spec.map _ = Spec.map _
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have e1 : (Subring.closure (F' : Set R)).subtype.comp
        (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h))) =
        (Subring.closure (F : Set R)).subtype := by
      apply RingHom.ext
      intro x
      simp
    rw [e1]
  have hTT : ∀ {F F' F'' : Finset R} (h₁ : F ⊆ F') (h₂ : F' ⊆ F''),
      wcSubT R h₂ ≫ wcSubT R h₁ = wcSubT R (Finset.Subset.trans h₁ h₂) := by
    intro F F' F'' h₁ h₂
    show Spec.map _ ≫ Spec.map _ = Spec.map _
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have e2 : (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h₂))).comp
        (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h₁))) =
        Subring.inclusion (Subring.closure_mono
          (Finset.coe_subset.mpr (Finset.Subset.trans h₁ h₂))) := by
      apply RingHom.ext
      intro x
      apply Subtype.ext
      simp
    rw [e2]
  have hRW : ∀ {F : Finset R} {V : (wcSubX R F).Etale} {O : (Spec (.of R)).Etale}
      {a b : O.left ⟶ V.left} (ha : a ≫ V.hom = O.hom ≫ wcSubP R F)
      (hb : b ≫ V.hom = O.hom ≫ wcSubP R F), a = b →
      ∀ y, (σ F).ρ V O a ha y = (σ F).ρ V O b hb y := by
    intro F V O a b ha hb hab y
    subst hab
    rfl

  obtain ⟨N, W, c, Fb, hFb, Z, m, hm, a, x, hsurj, hZaff, hZpb, ha, hma, hx⟩ :=
    wc_subring_surj_local_models R G e H σ hcone hgen F₀ V₀ U k₀ hA hpb s

  let Fs : Finset R := F₀ ∪ Finset.univ.biUnion Fb
  have h₀ : F₀ ⊆ Fs := Finset.subset_union_left
  have hj : ∀ j, Fb j ⊆ Fs := fun j =>
    (Finset.subset_biUnion_of_mem Fb (Finset.mem_univ j)).trans Finset.subset_union_right

  have hBC : ∀ {F₁ F₂ : Finset R} (h : F₁ ⊆ F₂) (V : (wcSubX R F₁).Etale), IsAffine V.left →
      ∃ (Vs : (wcSubX R F₂).Etale) (κ : Vs.left ⟶ V.left),
        IsPullback κ Vs.hom V.hom (wcSubT R h) ∧ IsAffine Vs.left := by
    intro F₁ F₂ h V hV
    haveI : Etale V.hom := V.prop
    haveI : IsAffine (wcSubX R F₂) := inferInstanceAs (IsAffine (Spec _))
    haveI : IsAffine ((𝟭 Scheme).obj V.left) := hV
    haveI : IsAffine (wcSubX R F₁) := inferInstanceAs (IsAffine (Spec _))
    haveI : IsAffineHom (wcSubT R h) := isAffineHom_of_isAffine _
    haveI : IsAffineHom (Limits.pullback.fst V.hom (wcSubT R h)) :=
      MorphismProperty.of_isPullback (P := @IsAffineHom)
        (IsPullback.of_hasPullback V.hom (wcSubT R h)).flip inferInstance
    haveI : IsAffine (Limits.pullback V.hom (wcSubT R h)) :=
      isAffine_of_isAffineHom (Limits.pullback.fst V.hom (wcSubT R h))
    exact ⟨Scheme.Etale.mk (Limits.pullback.snd V.hom (wcSubT R h)),
      Limits.pullback.fst _ _, IsPullback.of_hasPullback _ _,
      (inferInstance : IsAffine (Limits.pullback V.hom (wcSubT R h)))⟩

  obtain ⟨Os, κ₁, hκ₁, hOsaff⟩ := hBC h₀ V₀ hA
  obtain ⟨kOs, hkOs, hks⟩ : ∃ kOs : U.left ⟶ Os.left,
      kOs ≫ Os.hom = U.hom ≫ wcSubP R Fs ∧ kOs ≫ κ₁ = k₀ :=
    ⟨hκ₁.lift k₀ (U.hom ≫ wcSubP R Fs) (by rw [Category.assoc, hPT h₀]; exact hpb.w),
      hκ₁.lift_snd _ _ _, hκ₁.lift_fst _ _ _⟩
  have hpbs : IsPullback kOs U.hom Os.hom (wcSubP R Fs) :=
    IsPullback.of_right (by rw [hks, hPT h₀]; exact hpb) hkOs hκ₁

  have hZb : ∀ j, ∃ (Zs : (wcSubX R Fs).Etale) (b : Zs.left ⟶ (Z j).left)
      (hb : b ≫ (Z j).hom = Zs.hom ≫ wcSubT R (hj j))
      (ms : (W j).left ⟶ Zs.left) (hms : ms ≫ Zs.hom = (W j).hom ≫ wcSubP R Fs),
      IsAffine Zs.left ∧ IsPullback ms (W j).hom Zs.hom (wcSubP R Fs) ∧ ms ≫ b = m j ∧
      (σ Fs).ρ Zs (W j) ms hms ((e (Fb j) Fs (hj j)).ρ (Z j) Zs b hb (x j)) =
        (H.obj.map (c j).op).hom s := by
    intro j
    obtain ⟨Zs, b, hbpb, hZsaff⟩ := hBC (hj j) (Z j) (hZaff j)
    have hsq : m j ≫ (Z j).hom = ((W j).hom ≫ wcSubP R Fs) ≫ wcSubT R (hj j) := by
      rw [Category.assoc, hPT (hj j)]; exact hm j
    obtain ⟨ms, hms, hmsb⟩ : ∃ ms : (W j).left ⟶ Zs.left,
        ms ≫ Zs.hom = (W j).hom ≫ wcSubP R Fs ∧ ms ≫ b = m j :=
      ⟨hbpb.lift (m j) ((W j).hom ≫ wcSubP R Fs) hsq, hbpb.lift_snd _ _ _, hbpb.lift_fst _ _ _⟩
    have hc := hcone (Fb j) Fs (hj j) (Z j) Zs b hbpb.w (W j) ms hms (x j)
    refine ⟨Zs, b, hbpb.w, ms, hms, hZsaff, ?_, hmsb, ?_⟩
    · exact IsPullback.of_right (by rw [hmsb, hPT (hj j)]; exact hZpb j) hms hbpb
    · exact hc.symm.trans ((hRW _ _ hmsb (x j)).trans (hx j))
  choose Zs b hb ms hms hZsaff hZspb hmsb hσs using hZb

  have hwsq : ∀ j, (b j ≫ a j) ≫ V₀.hom = (Zs j).hom ≫ wcSubT R h₀ := by
    intro j
    rw [Category.assoc, ha j, ← Category.assoc, hb j, Category.assoc, hTT (hFb j) (hj j)]
  have hwex : ∀ j, ∃ wl : (Zs j).left ⟶ Os.left,
      wl ≫ Os.hom = (Zs j).hom ∧ wl ≫ κ₁ = b j ≫ a j :=
    fun j => ⟨hκ₁.lift (b j ≫ a j) (Zs j).hom (hwsq j), hκ₁.lift_snd _ _ _, hκ₁.lift_fst _ _ _⟩
  choose wl hwl1 hwl2 using hwex
  let w : ∀ j, Zs j ⟶ Os := fun j => MorphismProperty.Over.homMk (wl j) (hwl1 j)
  have hwleft : ∀ j, (w j).left = wl j := fun j => rfl
  have hmw : ∀ j, ms j ≫ (w j).left = (c j).left ≫ kOs := by
    intro j
    rw [hwleft]
    apply hκ₁.hom_ext
    · simp only [Category.assoc, hwl2, hks]
      rw [← Category.assoc, hmsb j, hma j]
    · simp only [Category.assoc, hwl1, hms, hkOs]
      rw [← Category.assoc, MorphismProperty.Over.w (c j)]

  obtain ⟨F'', h, O'', κ, kO'', hkO'', y, hκ, hkκ, hy⟩ :=
    wc_subring_glue_models R G e H σ hco hcone hker U Fs Os kOs hkOs hOsaff hpbs N W c Zs w ms hms
      (fun j => (e (Fb j) Fs (hj j)).ρ (Z j) (Zs j) (b j) (hb j) (x j)) s hsurj hZsaff hZspb hmw hσs
  refine ⟨F'', Finset.Subset.trans h₀ h, O'', kO'', hkO'', κ ≫ κ₁, y, ?_, ?_, hy⟩
  · rw [← Category.assoc, hkκ, hks]
  · have hp := IsPullback.paste_horiz hκ hκ₁
    rw [hTT h₀ h] at hp
    exact hp

theorem wc_subring_colim_affine_sections : ∀ (R : Type u) [CommRing R]
    (G : ∀ F : Finset R, Sheaf (Scheme.smallEtaleTopology (wcSubX R F)) AddCommGrpCat.{u+1})
    (e : ∀ (F F' : Finset R) (h : F ⊆ F'), wcEtTransport (wcSubT R h) (G F) (G F'))
    (H : Sheaf (Scheme.smallEtaleTopology (Spec (.of R))) AddCommGrpCat.{u+1})
    (σ : ∀ F : Finset R, wcEtTransport (wcSubP R F) (G F) H),
    wcSubCoherent R G e → wcSubCocone R G e H σ → wcSubLocGen R G H σ → wcSubLocKer R G e H σ →
    wcSubAffSec R G e H σ :=
by
  intro R _ G e H σ hco hcone hgen hker F₀ V₀ U k₀ hA hpb
  refine ⟨wc_subring_affsec_surj R G e H σ hco hcone hgen hker F₀ V₀ U k₀ hA hpb, ?_⟩
  intro F h O kO hkO k₁ hk hpb₁ t ht
  have hPT : wcSubP R F ≫ wcSubT R h = wcSubP R F₀ := by
    show Spec.map _ ≫ Spec.map _ = Spec.map _
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have e1 : (Subring.closure (F : Set R)).subtype.comp
        (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h))) =
        (Subring.closure (F₀ : Set R)).subtype := by
      apply RingHom.ext
      intro x
      simp
    rw [e1]
  haveI : IsAffine V₀.left := hA
  have hO : IsAffine O.left := by
    haveI : IsAffine (wcSubX R F) := inferInstanceAs (IsAffine (Spec _))
    haveI : IsAffine ((𝟭 Scheme).obj V₀.left) := hA
    haveI : IsAffine (wcSubX R F₀) := inferInstanceAs (IsAffine (Spec _))
    haveI : IsAffineHom (wcSubT R h) := isAffineHom_of_isAffine _
    haveI : IsAffineHom (Limits.pullback.fst V₀.hom (wcSubT R h)) :=
      MorphismProperty.of_isPullback (P := @IsAffineHom)
        (IsPullback.of_hasPullback V₀.hom (wcSubT R h)).flip inferInstance
    haveI : IsAffine (Limits.pullback V₀.hom (wcSubT R h)) :=
      isAffine_of_isAffineHom (Limits.pullback.fst V₀.hom (wcSubT R h))
    exact IsAffine.of_isIso hpb₁.isoPullback.hom
  have hpbO : IsPullback kO U.hom O.hom (wcSubP R F) := by
    refine IsPullback.of_right ?_ hkO hpb₁
    rw [hk, hPT]
    exact hpb
  exact wc_subring_affsec_ker R G e H σ hco hker U F O kO hkO hO hpbO t ht

theorem wc_subring_cech_family_descend : ∀ (R : Type u) [CommRing R] (U : (Spec (.of R)).Etale) (k : ℕ)
    (V : Fin k → (Spec (.of R)).Etale) (f : ∀ i, V i ⟶ U),
    IsAffine U.left → (∀ i, IsAffine (V i).left) →
    ∃ (F₀ : Finset R) (V₀ : (wcSubX R F₀).Etale) (k₀ : U.left ⟶ V₀.left)
      (W : Fin k → (wcSubX R F₀).Etale) (w : ∀ i, W i ⟶ V₀) (b : ∀ i, (V i).left ⟶ (W i).left),
      IsAffine V₀.left ∧ (∀ i, IsAffine (W i).left) ∧
      IsPullback k₀ U.hom V₀.hom (wcSubP R F₀) ∧
      (∀ i, IsPullback (b i) (V i).hom (W i).hom (wcSubP R F₀)) ∧
      ∀ i, b i ≫ (w i).left = (f i).left ≫ k₀ :=
by
  intro R _ U k V f hU hV
  classical

  have CR1 : ∀ {F F' : Finset R} (h : F ⊆ F'), wcSubP R F' ≫ wcSubT R h = wcSubP R F := by
    intro F F' h
    show Spec.map _ ≫ Spec.map _ = Spec.map _
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have e1 : (Subring.closure (F' : Set R)).subtype.comp
        (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h))) =
        (Subring.closure (F : Set R)).subtype := by
      apply RingHom.ext
      intro x
      simp
    rw [e1]

  have CR2 : ∀ {F F' F'' : Finset R} (h₁ : F ⊆ F') (h₂ : F' ⊆ F'') (h₃ : F ⊆ F''),
      wcSubT R h₂ ≫ wcSubT R h₁ = wcSubT R h₃ := by
    intro F F' F'' h₁ h₂ h₃
    show Spec.map _ ≫ Spec.map _ = Spec.map _
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have e1 : (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h₂))).comp
        (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h₁))) =
        Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h₃)) := by
      apply RingHom.ext
      intro x
      apply Subtype.ext
      simp
    rw [e1]

  have rebase : ∀ (Ub : (Spec (.of R)).Etale) (F : Finset R) (A : (wcSubX R F).Etale)
      (kk : Ub.left ⟶ A.left),
      IsAffine A.left → IsPullback kk Ub.hom A.hom (wcSubP R F) →
      ∀ (F' : Finset R) (h : F ⊆ F'),
      ∃ (A' : (wcSubX R F').Etale) (k' : Ub.left ⟶ A'.left) (π : A'.left ⟶ A.left),
        IsAffine A'.left ∧ IsPullback k' Ub.hom A'.hom (wcSubP R F') ∧
        IsPullback π A'.hom A.hom (wcSubT R h) ∧ k' ≫ π = kk := by
    intro Ub F A kk hA hpb F' h
    haveI : IsAffine A.left := hA
    have hw : kk ≫ A.hom = (Ub.hom ≫ wcSubP R F') ≫ wcSubT R h := by
      rw [Category.assoc, CR1 h]
      exact hpb.w
    have haff : IsAffine (Limits.pullback A.hom (wcSubT R h)) :=
      (inferInstance : IsAffine (Limits.pullback (X := A.left) (Y := wcSubX R F')
        (Z := wcSubX R F) A.hom (wcSubT R h)))
    have houter : IsPullback (Limits.pullback.lift kk (Ub.hom ≫ wcSubP R F') hw ≫
        Limits.pullback.fst A.hom (wcSubT R h)) Ub.hom A.hom (wcSubP R F' ≫ wcSubT R h) := by
      rw [Limits.pullback.lift_fst, CR1 h]
      exact hpb
    have hpb' : IsPullback (Limits.pullback.lift kk (Ub.hom ≫ wcSubP R F') hw) Ub.hom
        (Limits.pullback.snd A.hom (wcSubT R h)) (wcSubP R F') :=
      IsPullback.of_right houter (Limits.pullback.lift_snd _ _ _)
        (IsPullback.of_hasPullback A.hom (wcSubT R h))
    exact ⟨Scheme.Etale.mk (Limits.pullback.snd A.hom (wcSubT R h)),
      Limits.pullback.lift kk (Ub.hom ≫ wcSubP R F') hw,
      Limits.pullback.fst A.hom (wcSubT R h), haff, hpb',
      IsPullback.of_hasPullback A.hom (wcSubT R h), Limits.pullback.lift_fst _ _ _⟩

  obtain ⟨FU, YU, mU, hY, hpbU⟩ := wc_subring_affine_etale_model R U hU

  have hstep : ∀ i, ∃ (F₃ : Finset R) (h₂ : FU ⊆ F₃) (W' : (wcSubX R F₃).Etale)
      (k' : (V i).left ⟶ W'.left) (g' : W'.left ⟶ YU.left),
      IsAffine W'.left ∧ IsPullback k' (V i).hom W'.hom (wcSubP R F₃) ∧
      g' ≫ YU.hom = W'.hom ≫ wcSubT R h₂ ∧ k' ≫ g' = (f i).left ≫ mU := by
    intro i
    obtain ⟨F₁, Z, n, hZ, hpbZ⟩ := wc_subring_affine_etale_model R (V i) (hV i)
    have hfw : (f i).left ≫ U.hom = (V i).hom := MorphismProperty.Over.w (f i)
    have hside : ((f i).left ≫ mU) ≫ YU.hom = (V i).hom ≫ wcSubP R FU := by
      rw [Category.assoc, hpbU.w, ← Category.assoc, hfw]
    obtain ⟨F₃, h₁, h₂, W', b', k', g', hW', -, hpbW', -, hg'Y, hg'k⟩ :=
      wc_subring_hom_descend R (V i) F₁ Z n hZ hpbZ FU YU ((f i).left ≫ mU) hY hside
    exact ⟨F₃, h₂, W', k', g', hW', hpbW', hg'Y, hg'k⟩
  choose F₃ h₂ W' k' g' hW' hpbW' hg'Y hg'k using hstep

  let F₀ : Finset R := FU ∪ Finset.univ.biUnion F₃
  have hU0 : FU ⊆ F₀ := Finset.subset_union_left
  have hi0 : ∀ i, F₃ i ⊆ F₀ := fun i =>
    (Finset.subset_biUnion_of_mem F₃ (Finset.mem_univ i)).trans Finset.subset_union_right
  obtain ⟨V₀, k₀, π₀, hV₀, hpb, hπ₀, hk₀⟩ := rebase U FU YU mU hY hpbU F₀ hU0
  choose W b πW hW hpbi hπW hb using
    fun i => rebase (V i) (F₃ i) (W' i) (k' i) (hW' i) (hpbW' i) F₀ (hi0 i)

  have hlift : ∀ i, ∃ w : W i ⟶ V₀, b i ≫ w.left = (f i).left ≫ k₀ := by
    intro i
    have hfw : (f i).left ≫ U.hom = (V i).hom := MorphismProperty.Over.w (f i)
    have h1 : πW i ≫ (W' i).hom = (W i).hom ≫ wcSubT R (hi0 i) := (hπW i).w
    have h2 : b i ≫ (W i).hom = (V i).hom ≫ wcSubP R F₀ := (hpbi i).w
    have h3 : k₀ ≫ V₀.hom = U.hom ≫ wcSubP R F₀ := hpb.w
    have sc : (πW i ≫ g' i) ≫ YU.hom = (W i).hom ≫ wcSubT R hU0 := by
      rw [Category.assoc, hg'Y i, ← Category.assoc, h1, Category.assoc,
        CR2 (h₂ i) (hi0 i) hU0]
    let ℓ : (W i).left ⟶ V₀.left := hπ₀.lift (πW i ≫ g' i) (W i).hom sc
    have hℓ1 : ℓ ≫ π₀ = πW i ≫ g' i := hπ₀.lift_fst _ _ _
    have hℓ2 : ℓ ≫ V₀.hom = (W i).hom := hπ₀.lift_snd _ _ _
    have heq : b i ≫ ℓ = (f i).left ≫ k₀ := by
      apply hπ₀.hom_ext
      · rw [Category.assoc, hℓ1, ← Category.assoc, hb i, hg'k i, Category.assoc, hk₀]
      · rw [Category.assoc, hℓ2, h2, Category.assoc, h3, ← Category.assoc, hfw]
    exact ⟨MorphismProperty.Over.homMk ℓ hℓ2 trivial, heq⟩
  choose w hw using hlift
  exact ⟨F₀, V₀, k₀, W, w, b, hV₀, hW, hpb, hpbi, hw⟩

theorem wc_cech_acyclic_of_directed_stages : ∀ (ι : Type u) [Preorder ι] (k : ℕ)
    (A : ι → (p : ℕ) → (Fin (p + 1) → Fin k) → AddCommGrpCat.{u+1})
    (B : (p : ℕ) → (Fin (p + 1) → Fin k) → AddCommGrpCat.{u+1})
    (dA : ∀ (i : ι) (p : ℕ) (τ : Fin (p + 2) → Fin k) (j : Fin (p + 2)),
      A i p (fun l => τ (j.succAbove l)) →+ A i (p + 1) τ)
    (dB : ∀ (p : ℕ) (τ : Fin (p + 2) → Fin k) (j : Fin (p + 2)),
      B p (fun l => τ (j.succAbove l)) →+ B (p + 1) τ)
    (T : ∀ (i i' : ι), i ≤ i' → ∀ (p : ℕ) (σ : Fin (p + 1) → Fin k), A i p σ →+ A i' p σ)
    (inc : ∀ (i : ι) (p : ℕ) (σ : Fin (p + 1) → Fin k), A i p σ →+ B p σ),
    Nonempty ι →
    (∀ (S : Type) [Fintype S] (i₀ : ι) (g : S → ι), ∃ j, i₀ ≤ j ∧ ∀ s, g s ≤ j) →
    (∀ (i i' : ι) (h : i ≤ i') (p : ℕ) (σ : Fin (p + 1) → Fin k) (x : A i p σ),
      inc i' p σ (T i i' h p σ x) = inc i p σ x) →
    (∀ (i i' i'' : ι) (h₁ : i ≤ i') (h₂ : i' ≤ i'') (p : ℕ) (σ : Fin (p + 1) → Fin k) (x : A i p σ),
      T i' i'' h₂ p σ (T i i' h₁ p σ x) = T i i'' (h₁.trans h₂) p σ x) →
    (∀ (i i' : ι) (h : i ≤ i') (p : ℕ) (τ : Fin (p + 2) → Fin k) (j : Fin (p + 2))
      (x : A i p (fun l => τ (j.succAbove l))),
      T i i' h (p + 1) τ (dA i p τ j x) = dA i' p τ j (T i i' h p (fun l => τ (j.succAbove l)) x)) →
    (∀ (i : ι) (p : ℕ) (τ : Fin (p + 2) → Fin k) (j : Fin (p + 2)) (x : A i p (fun l => τ (j.succAbove l))),
      inc i (p + 1) τ (dA i p τ j x) = dB p τ j (inc i p (fun l => τ (j.succAbove l)) x)) →
    (∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) (b : B p σ), ∃ (i : ι) (a : A i p σ), inc i p σ a = b) →
    (∀ (i : ι) (p : ℕ) (σ : Fin (p + 1) → Fin k) (a : A i p σ), inc i p σ a = 0 →
      ∃ (i' : ι) (h : i ≤ i'), T i i' h p σ a = 0) →
    (∀ (i : ι) (p : ℕ) (c : ∀ τ : Fin (p + 2) → Fin k, A i (p + 1) τ),
      (∀ ρ : Fin (p + 3) → Fin k, ∑ j : Fin (p + 3), ((-1 : ℤ) ^ (j : ℕ)) •
        dA i (p + 1) ρ j (c (fun l => ρ (j.succAbove l))) = 0) →
      ∃ b : ∀ σ : Fin (p + 1) → Fin k, A i p σ, ∀ τ : Fin (p + 2) → Fin k,
        ∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) • dA i p τ j (b (fun l => τ (j.succAbove l))) = c τ) →
    ∀ (p : ℕ) (c : ∀ τ : Fin (p + 2) → Fin k, B (p + 1) τ),
      (∀ ρ : Fin (p + 3) → Fin k, ∑ j : Fin (p + 3), ((-1 : ℤ) ^ (j : ℕ)) •
        dB (p + 1) ρ j (c (fun l => ρ (j.succAbove l))) = 0) →
      ∃ b : ∀ σ : Fin (p + 1) → Fin k, B p σ, ∀ τ : Fin (p + 2) → Fin k,
        ∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) • dB p τ j (b (fun l => τ (j.succAbove l))) = c τ :=
by
  intro ι _ k A B dA dB T inc hne hdir hincT hTT hTd hincd hsurj hker hstage p c hc
  classical
  obtain ⟨i₀⟩ := hne

  choose iτ aτ haτ using fun τ : Fin (p + 2) → Fin k => hsurj (p + 1) τ (c τ)
  obtain ⟨j₁, -, hj₁⟩ := hdir (Fin (p + 2) → Fin k) i₀ iτ
  obtain ⟨a', F1⟩ : ∃ a' : ∀ τ : Fin (p + 2) → Fin k, A j₁ (p + 1) τ,
      ∀ τ, inc j₁ (p + 1) τ (a' τ) = c τ :=
    ⟨fun τ => T (iτ τ) j₁ (hj₁ τ) (p + 1) τ (aτ τ), fun τ => by
      rw [hincT, haτ]⟩

  have F2 : ∀ ρ : Fin (p + 3) → Fin k, inc j₁ (p + 1 + 1) ρ
      (∑ j : Fin (p + 3), ((-1 : ℤ) ^ (j : ℕ)) •
        dA j₁ (p + 1) ρ j (a' (fun l => ρ (j.succAbove l)))) = 0 := by
    intro ρ
    rw [map_sum]
    refine (Finset.sum_congr rfl (fun j _ => ?_)).trans (hc ρ)
    rw [map_zsmul, hincd j₁ (p + 1) ρ j, F1]

  choose i' hle hz using fun ρ : Fin (p + 3) → Fin k => hker j₁ (p + 1 + 1) ρ _ (F2 ρ)
  obtain ⟨j₂, h12, h2⟩ := hdir (Fin (p + 3) → Fin k) j₁ i'
  have F3 : ∀ ρ : Fin (p + 3) → Fin k, T j₁ j₂ h12 (p + 1 + 1) ρ
      (∑ j : Fin (p + 3), ((-1 : ℤ) ^ (j : ℕ)) •
        dA j₁ (p + 1) ρ j (a' (fun l => ρ (j.succAbove l)))) = 0 := by
    intro ρ
    have h := hTT j₁ (i' ρ) j₂ (hle ρ) (h2 ρ) (p + 1 + 1) ρ
      (∑ j : Fin (p + 3), ((-1 : ℤ) ^ (j : ℕ)) •
        dA j₁ (p + 1) ρ j (a' (fun l => ρ (j.succAbove l))))
    rw [hz ρ, map_zero] at h
    exact h.symm

  have hcoc : ∀ ρ : Fin (p + 3) → Fin k, ∑ j : Fin (p + 3), ((-1 : ℤ) ^ (j : ℕ)) •
      dA j₂ (p + 1) ρ j (T j₁ j₂ h12 (p + 1) (fun l => ρ (j.succAbove l))
        (a' (fun l => ρ (j.succAbove l)))) = 0 := by
    intro ρ
    refine Eq.trans ?_ (F3 ρ)
    rw [map_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [map_zsmul, hTd j₁ j₂ h12 (p + 1) ρ j]

  obtain ⟨b'', hb''⟩ := hstage j₂ p (fun τ => T j₁ j₂ h12 (p + 1) τ (a' τ)) hcoc
  have hb2 : ∀ τ : Fin (p + 2) → Fin k, ∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) •
      dA j₂ p τ j (b'' (fun l => τ (j.succAbove l))) = T j₁ j₂ h12 (p + 1) τ (a' τ) := hb''
  refine ⟨fun σ => inc j₂ p σ (b'' σ), fun τ => ?_⟩
  have e : ∀ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) •
      dB p τ j (inc j₂ p (fun l => τ (j.succAbove l)) (b'' (fun l => τ (j.succAbove l)))) =
      inc j₂ (p + 1) τ (((-1 : ℤ) ^ (j : ℕ)) • dA j₂ p τ j (b'' (fun l => τ (j.succAbove l)))) :=
    fun j => by rw [map_zsmul, hincd]
  show ∑ j : Fin (p + 2), ((-1 : ℤ) ^ (j : ℕ)) •
      dB p τ j (inc j₂ p (fun l => τ (j.succAbove l)) (b'' (fun l => τ (j.succAbove l)))) = c τ
  rw [Finset.sum_congr rfl (fun j _ => e j), ← map_sum, hb2 τ, hincT, F1]

theorem wc_subring_stage_cech_system : ∀ (R : Type u) [CommRing R] (F₀ : Finset R)
    (V₀ : (wcSubX R F₀).Etale) (U : (Spec (.of R)).Etale) (k₀ : U.left ⟶ V₀.left) (k : ℕ)
    (W : Fin k → (wcSubX R F₀).Etale) (w : ∀ i, W i ⟶ V₀)
    (V : Fin k → (Spec (.of R)).Etale) (f : ∀ i, V i ⟶ U) (b : ∀ i, (V i).left ⟶ (W i).left),
    IsAffine V₀.left → (∀ i, IsAffine (W i).left) →
    IsPullback k₀ U.hom V₀.hom (wcSubP R F₀) →
    (∀ i, IsPullback (b i) (V i).hom (W i).hom (wcSubP R F₀)) →
    (∀ i, b i ≫ (w i).left = (f i).left ≫ k₀) →
    ∃ (VF : ∀ F : Finset R, F₀ ⊆ F → (wcSubX R F).Etale)
      (WF : ∀ (F : Finset R) (_ : F₀ ⊆ F), Fin k → (wcSubX R F).Etale)
      (wF : ∀ (F : Finset R) (hF : F₀ ⊆ F) (i : Fin k), WF F hF i ⟶ VF F hF)
      (κ : ∀ (F : Finset R) (hF : F₀ ⊆ F) (p : ℕ) (σ : Fin (p + 1) → Fin k),
        (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l))).left ⟶
          (Limits.widePullback (VF F hF) (fun l => WF F hF (σ l)) (fun l => wF F hF (σ l))).left)
      (tr : ∀ (F F' : Finset R) (hF : F₀ ⊆ F) (hF' : F₀ ⊆ F') (_ : F ⊆ F') (p : ℕ)
          (σ : Fin (p + 1) → Fin k),
        (Limits.widePullback (VF F' hF') (fun l => WF F' hF' (σ l)) (fun l => wF F' hF' (σ l))).left ⟶
          (Limits.widePullback (VF F hF) (fun l => WF F hF (σ l)) (fun l => wF F hF (σ l))).left),
      (∀ (F : Finset R) (hF : F₀ ⊆ F), IsAffine (VF F hF).left ∧ ∀ i, IsAffine (WF F hF i).left) ∧
      (∀ (F : Finset R) (hF : F₀ ⊆ F) (p : ℕ) (σ : Fin (p + 1) → Fin k),
        IsPullback (κ F hF p σ) (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l))).hom
          (Limits.widePullback (VF F hF) (fun l => WF F hF (σ l)) (fun l => wF F hF (σ l))).hom
          (wcSubP R F)) ∧
      (∀ (F F' : Finset R) (hF : F₀ ⊆ F) (hF' : F₀ ⊆ F') (h : F ⊆ F') (p : ℕ) (σ : Fin (p + 1) → Fin k),
        IsPullback (tr F F' hF hF' h p σ)
          (Limits.widePullback (VF F' hF') (fun l => WF F' hF' (σ l)) (fun l => wF F' hF' (σ l))).hom
          (Limits.widePullback (VF F hF) (fun l => WF F hF (σ l)) (fun l => wF F hF (σ l))).hom
          (wcSubT R h)) ∧
      (∀ (F F' : Finset R) (hF : F₀ ⊆ F) (hF' : F₀ ⊆ F') (h : F ⊆ F') (p : ℕ) (σ : Fin (p + 1) → Fin k),
        κ F' hF' p σ ≫ tr F F' hF hF' h p σ = κ F hF p σ) ∧
      (∀ (F F' F'' : Finset R) (hF : F₀ ⊆ F) (hF' : F₀ ⊆ F') (hF'' : F₀ ⊆ F'') (h₁ : F ⊆ F')
          (h₂ : F' ⊆ F'') (p : ℕ) (σ : Fin (p + 1) → Fin k),
        tr F' F'' hF' hF'' h₂ p σ ≫ tr F F' hF hF' h₁ p σ =
          tr F F'' hF hF'' (Finset.Subset.trans h₁ h₂) p σ) ∧
      (∀ (F : Finset R) (hF : F₀ ⊆ F) (p : ℕ) (τ : Fin (p + 2) → Fin k) (j : Fin (p + 2)),
        (wcCechFace V f τ j).left ≫ κ F hF p (fun l => τ (j.succAbove l)) =
          κ F hF (p + 1) τ ≫ (wcCechFace (WF F hF) (wF F hF) τ j).left) ∧
      (∀ (F F' : Finset R) (hF : F₀ ⊆ F) (hF' : F₀ ⊆ F') (h : F ⊆ F') (p : ℕ)
          (τ : Fin (p + 2) → Fin k) (j : Fin (p + 2)),
        (wcCechFace (WF F' hF') (wF F' hF') τ j).left ≫ tr F F' hF hF' h p (fun l => τ (j.succAbove l)) =
          tr F F' hF hF' h (p + 1) τ ≫ (wcCechFace (WF F hF) (wF F hF) τ j).left) :=
by
  intro R _ F₀ V₀ U k₀ k W w V f b hV₀ hW hpb hpbi hcomm
  classical

  have WPlift : ∀ (X : Scheme.{u}) (B : X.Etale) (m : ℕ) (P : Fin m → X.Etale) (a : ∀ j, P j ⟶ B)
      (T : Scheme.{u}) (x : T ⟶ B.left) (y : ∀ j, T ⟶ (P j).left), (∀ j, y j ≫ (a j).left = x) →
      ∃! h : T ⟶ (Limits.widePullback B P a).left, h ≫ (Limits.WidePullback.base a).left = x ∧
        ∀ j, h ≫ (Limits.WidePullback.π a j).left = y j := by
    intro X B m P a T x y hy
    have hc := Limits.isLimitOfPreserves (Scheme.Etale.forget X ⋙ Over.forget X)
      (Limits.limit.isLimit (Limits.WidePullbackShape.wideCospan B P a))
    let s := Limits.WidePullbackShape.mkCone
      (F := Limits.WidePullbackShape.wideCospan B P a ⋙ (Scheme.Etale.forget X ⋙ Over.forget X))
      x y (fun j => hy j)
    obtain ⟨h, hh, hu⟩ := hc.existsUnique s
    refine ⟨h, ⟨hh none, fun j => hh (some j)⟩, fun h' hh' => hu h' ?_⟩
    rintro (_ | j)
    · exact hh'.1
    · exact hh'.2 j
  have WPext : ∀ (X : Scheme.{u}) (B : X.Etale) (m : ℕ) (P : Fin m → X.Etale) (a : ∀ j, P j ⟶ B)
      (T : Scheme.{u}) (h h' : T ⟶ (Limits.widePullback B P a).left),
      h ≫ (Limits.WidePullback.base a).left = h' ≫ (Limits.WidePullback.base a).left →
      (∀ j, h ≫ (Limits.WidePullback.π a j).left = h' ≫ (Limits.WidePullback.π a j).left) →
      h = h' := by
    intro X B m P a T h h' hb hp
    have hc := Limits.isLimitOfPreserves (Scheme.Etale.forget X ⋙ Over.forget X)
      (Limits.limit.isLimit (Limits.WidePullbackShape.wideCospan B P a))
    apply hc.hom_ext
    rintro (_ | j)
    · exact hb
    · exact hp j
  have piA : ∀ (X : Scheme.{u}) (B : X.Etale) (m : ℕ) (P : Fin m → X.Etale) (a : ∀ j, P j ⟶ B)
      (j : Fin m), (Limits.WidePullback.π a j).left ≫ (a j).left =
        (Limits.WidePullback.base a).left := by
    intro X B m P a j
    have := (Scheme.Etale.forget X ⋙ Over.forget X).congr_map (Limits.WidePullback.π_arrow a j)
    rwa [Functor.map_comp] at this
  have hL1 : ∀ (X : Scheme.{u}) {A B D : X.Etale} (a : A ⟶ B) (b : B ⟶ D) (d : A ⟶ D),
      a ≫ b = d → a.left ≫ b.left = d.left := by
    intro X A B D a b d h
    have := (Scheme.Etale.forget X ⋙ Over.forget X).congr_map h
    rw [Functor.map_comp] at this
    exact this

  have WPsq : ∀ (X X' : Scheme.{u}) (A : X.Etale) (m : ℕ) (P : Fin m → X.Etale) (a : ∀ j, P j ⟶ A)
      (B : X'.Etale) (Q : Fin m → X'.Etale) (b : ∀ j, Q j ⟶ B) (φ : A.left ⟶ B.left)
      (ψ : ∀ j, (P j).left ⟶ (Q j).left), (∀ j, IsPullback (ψ j) (a j).left (b j).left φ) →
      ∀ (Φ : (Limits.widePullback A P a).left ⟶ (Limits.widePullback B Q b).left),
      Φ ≫ (Limits.WidePullback.base b).left = (Limits.WidePullback.base a).left ≫ φ →
      (∀ j, Φ ≫ (Limits.WidePullback.π b j).left = (Limits.WidePullback.π a j).left ≫ ψ j) →
      IsPullback Φ (Limits.WidePullback.base a).left (Limits.WidePullback.base b).left φ := by
    intro X X' A m P a B Q b φ ψ hψ Φ hb hp
    have hw : ∀ (s : Limits.PullbackCone (Limits.WidePullback.base b).left φ) (j : Fin m),
        (s.fst ≫ (Limits.WidePullback.π b j).left) ≫ (b j).left = s.snd ≫ φ := by
      intro s j
      rw [Category.assoc, piA X' B m Q b j]
      exact s.condition
    have ex : ∀ s : Limits.PullbackCone (Limits.WidePullback.base b).left φ,
        ∃ h : s.pt ⟶ (Limits.widePullback A P a).left,
          h ≫ (Limits.WidePullback.base a).left = s.snd ∧
          ∀ j, h ≫ (Limits.WidePullback.π a j).left = (hψ j).lift _ _ (hw s j) := fun s =>
      (WPlift X A m P a s.pt s.snd (fun j => (hψ j).lift _ _ (hw s j))
        (fun j => (hψ j).lift_snd _ _ _)).exists
    choose L hL1' hL2' using ex
    refine IsPullback.of_isLimit (c := Limits.PullbackCone.mk Φ (Limits.WidePullback.base a).left hb) ?_
    refine Limits.PullbackCone.IsLimit.mk hb L (fun s => ?_) (fun s => hL1' s) (fun s mm hm1 hm2 => ?_)
    · apply WPext X' B m Q b s.pt
      · rw [Category.assoc, hb, ← Category.assoc, hL1' s]
        exact s.condition.symm
      · intro j
        rw [Category.assoc, hp j, ← Category.assoc, hL2' s j]
        exact (hψ j).lift_fst _ _ _
    · change mm ≫ Φ = s.fst at hm1
      change mm ≫ (Limits.WidePullback.base a).left = s.snd at hm2
      apply WPext X A m P a s.pt
      · rw [hm2, hL1' s]
      · intro j
        rw [hL2' s j]
        apply (hψ j).hom_ext
        · rw [(hψ j).lift_fst, Category.assoc, ← hp j, ← Category.assoc, hm1]
        · rw [(hψ j).lift_snd, Category.assoc, piA X A m P a j, hm2]

  have BC : ∀ {Y Z : Scheme.{u}} (φ : Y ⟶ Z) (A₀ : Z.Etale) {m : ℕ} (Q₀ : Fin m → Z.Etale)
      (g₀ : ∀ i, Q₀ i ⟶ A₀) (A : Y.Etale) (Q : Fin m → Y.Etale) (g : ∀ i, Q i ⟶ A)
      (a : A.left ⟶ A₀.left) (e : ∀ i, (Q i).left ⟶ (Q₀ i).left),
      IsPullback a A.hom A₀.hom φ → (∀ i, IsPullback (e i) (Q i).hom (Q₀ i).hom φ) →
      (∀ i, e i ≫ (g₀ i).left = (g i).left ≫ a) →
      ∀ (p : ℕ) (σ : Fin (p + 1) → Fin m),
      ∃ c : (Limits.widePullback A (fun l => Q (σ l)) (fun l => g (σ l))).left ⟶
          (Limits.widePullback A₀ (fun l => Q₀ (σ l)) (fun l => g₀ (σ l))).left,
        IsPullback c (Limits.widePullback A (fun l => Q (σ l)) (fun l => g (σ l))).hom
          (Limits.widePullback A₀ (fun l => Q₀ (σ l)) (fun l => g₀ (σ l))).hom φ ∧
        c ≫ (Limits.WidePullback.base (fun l => g₀ (σ l))).left =
          (Limits.WidePullback.base (fun l => g (σ l))).left ≫ a ∧
        ∀ l, c ≫ (Limits.WidePullback.π (fun l => g₀ (σ l)) l).left =
          (Limits.WidePullback.π (fun l => g (σ l)) l).left ≫ e (σ l) := by
    intro Y Z φ A₀ m Q₀ g₀ A Q g a e hA hQ hc p σ
    have hleg : ∀ i, IsPullback (e i) (g i).left (g₀ i).left a := by
      intro i
      refine IsPullback.of_bot ?_ (hc i) hA
      rw [MorphismProperty.Over.w (g i), MorphismProperty.Over.w (g₀ i)]
      exact hQ i
    obtain ⟨c, ⟨hcb, hcπ⟩, -⟩ := WPlift Z A₀ (p + 1) (fun l => Q₀ (σ l)) (fun l => g₀ (σ l))
      _ ((Limits.WidePullback.base (fun l => g (σ l))).left ≫ a)
      (fun l => (Limits.WidePullback.π (fun l => g (σ l)) l).left ≫ e (σ l))
      (fun l => by
        rw [Category.assoc, hc (σ l), ← Category.assoc]
        rw [piA Y A (p + 1) (fun l => Q (σ l)) (fun l => g (σ l)) l])
    refine ⟨c, ?_, hcb, hcπ⟩
    have h1 := IsPullback.paste_vert
      (WPsq Y Z A (p + 1) (fun l => Q (σ l)) (fun l => g (σ l)) A₀ (fun l => Q₀ (σ l))
        (fun l => g₀ (σ l)) a (fun l => e (σ l)) (fun l => hleg (σ l)) c hcb hcπ) hA
    rw [MorphismProperty.Over.w (Limits.WidePullback.base (fun l => g (σ l))),
      MorphismProperty.Over.w (Limits.WidePullback.base (fun l => g₀ (σ l)))] at h1
    exact h1

  have LE : ∀ {Z : Scheme.{u}} (A₀ : Z.Etale) {m : ℕ} (Q₀ : Fin m → Z.Etale) (g₀ : ∀ i, Q₀ i ⟶ A₀)
      (p : ℕ) (σ : Fin (p + 1) → Fin m) {T : Scheme.{u}}
      (x x' : T ⟶ (Limits.widePullback A₀ (fun l => Q₀ (σ l)) (fun l => g₀ (σ l))).left),
      (∀ l, x ≫ (Limits.WidePullback.π (fun l => g₀ (σ l)) l).left =
        x' ≫ (Limits.WidePullback.π (fun l => g₀ (σ l)) l).left) → x = x' := by
    intro Z A₀ m Q₀ g₀ p σ T x x' hx
    apply WPext Z A₀ (p + 1) _ _ T x x' _ hx
    rw [← piA Z A₀ (p + 1) (fun l => Q₀ (σ l)) (fun l => g₀ (σ l)) 0, ← Category.assoc, hx 0,
      Category.assoc]

  have FC : ∀ {Y Z : Scheme.{u}} (A₀ : Z.Etale) {m : ℕ} (Q₀ : Fin m → Z.Etale)
      (g₀ : ∀ i, Q₀ i ⟶ A₀) (A : Y.Etale) (Q : Fin m → Y.Etale) (g : ∀ i, Q i ⟶ A)
      (e : ∀ i, (Q i).left ⟶ (Q₀ i).left) (p : ℕ) (τ : Fin (p + 2) → Fin m) (j : Fin (p + 2))
      (c : (Limits.widePullback A (fun l => Q (τ l)) (fun l => g (τ l))).left ⟶
        (Limits.widePullback A₀ (fun l => Q₀ (τ l)) (fun l => g₀ (τ l))).left)
      (c' : (Limits.widePullback A (fun l => Q (τ (j.succAbove l)))
          (fun l => g (τ (j.succAbove l)))).left ⟶
        (Limits.widePullback A₀ (fun l => Q₀ (τ (j.succAbove l)))
          (fun l => g₀ (τ (j.succAbove l)))).left),
      (∀ l, c ≫ (Limits.WidePullback.π (fun l => g₀ (τ l)) l).left =
        (Limits.WidePullback.π (fun l => g (τ l)) l).left ≫ e (τ l)) →
      (∀ l, c' ≫ (Limits.WidePullback.π (fun l => g₀ (τ (j.succAbove l))) l).left =
        (Limits.WidePullback.π (fun l => g (τ (j.succAbove l))) l).left ≫ e (τ (j.succAbove l))) →
      (wcCechFace Q g τ j).left ≫ c' = c ≫ (wcCechFace Q₀ g₀ τ j).left := by
    intro Y Z A₀ m Q₀ g₀ A Q g e p τ j c c' hc hc'
    apply LE A₀ Q₀ g₀ p (fun l => τ (j.succAbove l))
    intro l
    have fY : (wcCechFace Q g τ j).left ≫
        (Limits.WidePullback.π (fun l => g (τ (j.succAbove l))) l).left =
        (Limits.WidePullback.π (fun l => g (τ l)) (j.succAbove l)).left :=
      hL1 Y _ _ _ (by unfold wcCechFace; exact Limits.WidePullback.lift_π _ _ _ _ l)
    have fZ : (wcCechFace Q₀ g₀ τ j).left ≫
        (Limits.WidePullback.π (fun l => g₀ (τ (j.succAbove l))) l).left =
        (Limits.WidePullback.π (fun l => g₀ (τ l)) (j.succAbove l)).left :=
      hL1 Z _ _ _ (by unfold wcCechFace; exact Limits.WidePullback.lift_π _ _ _ _ l)
    rw [Category.assoc, hc' l, ← Category.assoc, fY, Category.assoc, fZ, hc (j.succAbove l)]

  have hR1 : ∀ {F F' : Finset R} (h : F ⊆ F'), wcSubP R F' ≫ wcSubT R h = wcSubP R F := by
    intro F F' h
    show Spec.map _ ≫ Spec.map _ = Spec.map _
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have e1 : (Subring.closure (F' : Set R)).subtype.comp
        (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h))) =
        (Subring.closure (F : Set R)).subtype := by
      apply RingHom.ext
      intro x
      simp
    rw [e1]
  have hR2 : ∀ {F F' F'' : Finset R} (h₁ : F ⊆ F') (h₂ : F' ⊆ F'') (h₃ : F ⊆ F''),
      wcSubT R h₂ ≫ wcSubT R h₁ = wcSubT R h₃ := by
    intro F F' F'' h₁ h₂ h₃
    show Spec.map _ ≫ Spec.map _ = Spec.map _
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have e2 : (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h₂))).comp
        (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h₁))) =
        Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h₃)) := by
      apply RingHom.ext
      intro x
      apply Subtype.ext
      simp
    rw [e2]
  have BCobj : ∀ (A : (wcSubX R F₀).Etale) (F : Finset R) (hF : F₀ ⊆ F),
      ∃ (E : (wcSubX R F).Etale) (pr : E.left ⟶ A.left),
        IsPullback pr E.hom A.hom (wcSubT R hF) ∧ (IsAffine A.left → IsAffine E.left) := by
    intro A F hF
    refine ⟨Scheme.Etale.mk (Limits.pullback.snd A.hom (wcSubT R hF)),
      Limits.pullback.fst A.hom (wcSubT R hF), IsPullback.of_hasPullback A.hom (wcSubT R hF),
      fun hA => ?_⟩
    have hA' : IsAffine A.left := hA
    let g : A.left ⟶ wcSubX R F₀ := A.hom
    change IsAffine (Limits.pullback g (wcSubT R hF))
    infer_instance
  choose E pr hEpb hEaff using BCobj
  have κgen : ∀ (A : (wcSubX R F₀).Etale) (B : (Spec (.of R)).Etale) (a : B.left ⟶ A.left),
      IsPullback a B.hom A.hom (wcSubP R F₀) → ∀ (F : Finset R) (hF : F₀ ⊆ F),
      ∃ κ : B.left ⟶ (E A F hF).left,
        IsPullback κ B.hom (E A F hF).hom (wcSubP R F) ∧ κ ≫ pr A F hF = a := by
    intro A B a ha F hF
    have eq : a ≫ A.hom = (B.hom ≫ wcSubP R F) ≫ wcSubT R hF := by
      rw [ha.w, Category.assoc, hR1 hF]
    refine ⟨(hEpb A F hF).lift a (B.hom ≫ wcSubP R F) eq, ?_, (hEpb A F hF).lift_fst _ _ _⟩
    refine IsPullback.of_right ?_ ((hEpb A F hF).lift_snd _ _ _) (hEpb A F hF)
    rw [(hEpb A F hF).lift_fst, hR1 hF]
    exact ha
  have lgen : ∀ (A : (wcSubX R F₀).Etale) (F F' : Finset R) (hF : F₀ ⊆ F) (hF' : F₀ ⊆ F')
      (h : F ⊆ F'), ∃ l : (E A F' hF').left ⟶ (E A F hF).left,
        IsPullback l (E A F' hF').hom (E A F hF).hom (wcSubT R h) ∧ l ≫ pr A F hF = pr A F' hF' := by
    intro A F F' hF hF' h
    have eq : pr A F' hF' ≫ A.hom = ((E A F' hF').hom ≫ wcSubT R h) ≫ wcSubT R hF := by
      rw [(hEpb A F' hF').w, Category.assoc, hR2 hF h hF']
    refine ⟨(hEpb A F hF).lift _ _ eq, ?_, (hEpb A F hF).lift_fst _ _ _⟩
    refine IsPullback.of_right ?_ ((hEpb A F hF).lift_snd _ _ _) (hEpb A F hF)
    rw [(hEpb A F hF).lift_fst, hR2 hF h hF']
    exact hEpb A F' hF'
  have wgen : ∀ (A A' : (wcSubX R F₀).Etale) (g : A ⟶ A') (F : Finset R) (hF : F₀ ⊆ F),
      ∃ g' : E A F hF ⟶ E A' F hF, g'.left ≫ pr A' F hF = pr A F hF ≫ g.left := by
    intro A A' g F hF
    have eq : (pr A F hF ≫ g.left) ≫ A'.hom = (E A F hF).hom ≫ wcSubT R hF := by
      rw [Category.assoc, MorphismProperty.Over.w g]
      exact (hEpb A F hF).w
    exact ⟨MorphismProperty.Over.homMk ((hEpb A' F hF).lift _ _ eq)
      ((hEpb A' F hF).lift_snd _ _ _) trivial, (hEpb A' F hF).lift_fst _ _ _⟩
  choose κg hκg_pb hκg_fst using κgen
  choose lg hlg_pb hlg_fst using lgen
  choose wg hwg using wgen

  have κc : ∀ (F : Finset R) (hF : F₀ ⊆ F) (i : Fin k),
      κg (W i) (V i) (b i) (hpbi i) F hF ≫ (wg (W i) V₀ (w i) F hF).left =
        (f i).left ≫ κg V₀ U k₀ hpb F hF := by
    intro F hF i
    apply (hEpb V₀ F hF).hom_ext
    · rw [Category.assoc, hwg, ← Category.assoc, hκg_fst, Category.assoc, hκg_fst, hcomm i]
    · rw [Category.assoc, MorphismProperty.Over.w (wg (W i) V₀ (w i) F hF),
        (hκg_pb (W i) (V i) (b i) (hpbi i) F hF).w, Category.assoc,
        (hκg_pb V₀ U k₀ hpb F hF).w, ← Category.assoc, MorphismProperty.Over.w (f i)]
  have lc : ∀ (F F' : Finset R) (hF : F₀ ⊆ F) (hF' : F₀ ⊆ F') (h : F ⊆ F') (i : Fin k),
      lg (W i) F F' hF hF' h ≫ (wg (W i) V₀ (w i) F hF).left =
        (wg (W i) V₀ (w i) F' hF').left ≫ lg V₀ F F' hF hF' h := by
    intro F F' hF hF' h i
    apply (hEpb V₀ F hF).hom_ext
    · rw [Category.assoc, hwg, ← Category.assoc, hlg_fst, Category.assoc, hlg_fst, hwg]
    · rw [Category.assoc, MorphismProperty.Over.w (wg (W i) V₀ (w i) F hF),
        (hlg_pb (W i) F F' hF hF' h).w, Category.assoc, (hlg_pb V₀ F F' hF hF' h).w,
        ← Category.assoc, MorphismProperty.Over.w (wg (W i) V₀ (w i) F' hF')]
  have I1f : ∀ (F F' : Finset R) (hF : F₀ ⊆ F) (hF' : F₀ ⊆ F') (h : F ⊆ F') (i : Fin k),
      κg (W i) (V i) (b i) (hpbi i) F' hF' ≫ lg (W i) F F' hF hF' h =
        κg (W i) (V i) (b i) (hpbi i) F hF := by
    intro F F' hF hF' h i
    apply (hEpb (W i) F hF).hom_ext
    · rw [Category.assoc, hlg_fst, hκg_fst, hκg_fst]
    · rw [Category.assoc, (hlg_pb (W i) F F' hF hF' h).w, ← Category.assoc,
        (hκg_pb (W i) (V i) (b i) (hpbi i) F' hF').w, Category.assoc, hR1 h,
        (hκg_pb (W i) (V i) (b i) (hpbi i) F hF).w]
  have I2f : ∀ (F F' F'' : Finset R) (hF : F₀ ⊆ F) (hF' : F₀ ⊆ F') (hF'' : F₀ ⊆ F'')
      (h₁ : F ⊆ F') (h₂ : F' ⊆ F'') (i : Fin k),
      lg (W i) F' F'' hF' hF'' h₂ ≫ lg (W i) F F' hF hF' h₁ =
        lg (W i) F F'' hF hF'' (Finset.Subset.trans h₁ h₂) := by
    intro F F' F'' hF hF' hF'' h₁ h₂ i
    apply (hEpb (W i) F hF).hom_ext
    · rw [Category.assoc, hlg_fst, hlg_fst, hlg_fst]
    · rw [Category.assoc, (hlg_pb (W i) F F' hF hF' h₁).w, ← Category.assoc,
        (hlg_pb (W i) F' F'' hF' hF'' h₂).w, Category.assoc, hR2 h₁ h₂ (Finset.Subset.trans h₁ h₂),
        (hlg_pb (W i) F F'' hF hF'' (Finset.Subset.trans h₁ h₂)).w]

  have hκex := fun (F : Finset R) (hF : F₀ ⊆ F) (p : ℕ) (σ : Fin (p + 1) → Fin k) =>
    BC (wcSubP R F) (E V₀ F hF) (fun i => E (W i) F hF) (fun i => wg (W i) V₀ (w i) F hF) U V f
      (κg V₀ U k₀ hpb F hF) (fun i => κg (W i) (V i) (b i) (hpbi i) F hF)
      (hκg_pb V₀ U k₀ hpb F hF) (fun i => hκg_pb (W i) (V i) (b i) (hpbi i) F hF)
      (fun i => κc F hF i) p σ
  choose κ hκpb hκb hκπ using hκex
  have htrex := fun (F F' : Finset R) (hF : F₀ ⊆ F) (hF' : F₀ ⊆ F') (h : F ⊆ F') (p : ℕ)
      (σ : Fin (p + 1) → Fin k) =>
    BC (wcSubT R h) (E V₀ F hF) (fun i => E (W i) F hF) (fun i => wg (W i) V₀ (w i) F hF)
      (E V₀ F' hF') (fun i => E (W i) F' hF') (fun i => wg (W i) V₀ (w i) F' hF')
      (lg V₀ F F' hF hF' h) (fun i => lg (W i) F F' hF hF' h) (hlg_pb V₀ F F' hF hF' h)
      (fun i => hlg_pb (W i) F F' hF hF' h) (fun i => lc F F' hF hF' h i) p σ
  choose tr htrpb htrb htrπ using htrex
  refine ⟨fun F hF => E V₀ F hF, fun F hF i => E (W i) F hF, fun F hF i => wg (W i) V₀ (w i) F hF,
    κ, tr, fun F hF => ⟨hEaff V₀ F hF hV₀, fun i => hEaff (W i) F hF (hW i)⟩, hκpb, htrpb,
    ?_, ?_, ?_, ?_⟩
  · intro F F' hF hF' h p σ
    apply LE (E V₀ F hF) (fun i => E (W i) F hF) (fun i => wg (W i) V₀ (w i) F hF) p σ
    intro l
    rw [Category.assoc, htrπ F F' hF hF' h p σ l, ← Category.assoc, hκπ F' hF' p σ l,
      Category.assoc, I1f F F' hF hF' h (σ l), hκπ F hF p σ l]
  · intro F F' F'' hF hF' hF'' h₁ h₂ p σ
    apply LE (E V₀ F hF) (fun i => E (W i) F hF) (fun i => wg (W i) V₀ (w i) F hF) p σ
    intro l
    rw [Category.assoc, htrπ F F' hF hF' h₁ p σ l, ← Category.assoc, htrπ F' F'' hF' hF'' h₂ p σ l,
      Category.assoc, I2f F F' F'' hF hF' hF'' h₁ h₂ (σ l),
      htrπ F F'' hF hF'' (Finset.Subset.trans h₁ h₂) p σ l]
  · intro F hF p τ j
    exact FC (E V₀ F hF) (fun i => E (W i) F hF) (fun i => wg (W i) V₀ (w i) F hF) U V f
      (fun i => κg (W i) (V i) (b i) (hpbi i) F hF) p τ j (κ F hF (p + 1) τ)
      (κ F hF p (fun l => τ (j.succAbove l))) (hκπ F hF (p + 1) τ) (hκπ F hF p _)
  · intro F F' hF hF' h p τ j
    exact FC (E V₀ F hF) (fun i => E (W i) F hF) (fun i => wg (W i) V₀ (w i) F hF)
      (E V₀ F' hF') (fun i => E (W i) F' hF') (fun i => wg (W i) V₀ (w i) F' hF')
      (fun i => lg (W i) F F' hF hF' h) p τ j (tr F F' hF hF' h (p + 1) τ)
      (tr F F' hF hF' h p (fun l => τ (j.succAbove l))) (htrπ F F' hF hF' h (p + 1) τ)
      (htrπ F F' hF hF' h p _)

theorem wc_subring_tower_colim_sections : ∀ (R : Type u) [CommRing R]
    (G : ∀ F : Finset R, Sheaf (Scheme.smallEtaleTopology (wcSubX R F)) AddCommGrpCat.{u+1})
    (e : ∀ (F F' : Finset R) (h : F ⊆ F'), wcEtTransport (wcSubT R h) (G F) (G F'))
    (H : Sheaf (Scheme.smallEtaleTopology (Spec (.of R))) AddCommGrpCat.{u+1})
    (σ : ∀ F : Finset R, wcEtTransport (wcSubP R F) (G F) H),
    wcSubCoherent R G e → wcSubCocone R G e H σ → wcSubAffSec R G e H σ →
    ∀ (F₀ : Finset R) (Q : (Spec (.of R)).Etale) (P : ∀ F : Finset R, F₀ ⊆ F → (wcSubX R F).Etale)
      (κ : ∀ (F : Finset R) (hF : F₀ ⊆ F), Q.left ⟶ (P F hF).left)
      (tr : ∀ (F F' : Finset R) (hF : F₀ ⊆ F) (hF' : F₀ ⊆ F'), F ⊆ F' → ((P F' hF').left ⟶ (P F hF).left)),
      (∀ (F : Finset R) (hF : F₀ ⊆ F), IsAffine (P F hF).left) →
      (∀ (F : Finset R) (hF : F₀ ⊆ F), IsPullback (κ F hF) Q.hom (P F hF).hom (wcSubP R F)) →
      (∀ (F F' : Finset R) (hF : F₀ ⊆ F) (hF' : F₀ ⊆ F') (h : F ⊆ F'),
        IsPullback (tr F F' hF hF' h) (P F' hF').hom (P F hF).hom (wcSubT R h)) →
      (∀ (F F' : Finset R) (hF : F₀ ⊆ F) (hF' : F₀ ⊆ F') (h : F ⊆ F'),
        κ F' hF' ≫ tr F F' hF hF' h = κ F hF) →
      (∀ (F F' F'' : Finset R) (hF : F₀ ⊆ F) (hF' : F₀ ⊆ F') (hF'' : F₀ ⊆ F'') (h₁ : F ⊆ F') (h₂ : F' ⊆ F''),
        tr F' F'' hF' hF'' h₂ ≫ tr F F' hF hF' h₁ = tr F F'' hF hF'' (Finset.Subset.trans h₁ h₂)) →
      (∀ (F F' : Finset R) (hF : F₀ ⊆ F) (hF' : F₀ ⊆ F') (h : F ⊆ F')
          (hh : κ F hF ≫ (P F hF).hom = Q.hom ≫ wcSubP R F)
          (hh' : κ F' hF' ≫ (P F' hF').hom = Q.hom ≫ wcSubP R F')
          (ht : tr F F' hF hF' h ≫ (P F hF).hom = (P F' hF').hom ≫ wcSubT R h)
          (x : (G F).obj.obj (Opposite.op (P F hF))),
        (σ F').ρ (P F' hF') Q (κ F' hF') hh' ((e F F' h).ρ (P F hF) (P F' hF') (tr F F' hF hF' h) ht x) =
          (σ F).ρ (P F hF) Q (κ F hF) hh x) ∧
      (∀ (F F' F'' : Finset R) (hF : F₀ ⊆ F) (hF' : F₀ ⊆ F') (hF'' : F₀ ⊆ F'') (h₁ : F ⊆ F') (h₂ : F' ⊆ F'')
          (ht₁ : tr F F' hF hF' h₁ ≫ (P F hF).hom = (P F' hF').hom ≫ wcSubT R h₁)
          (ht₂ : tr F' F'' hF' hF'' h₂ ≫ (P F' hF').hom = (P F'' hF'').hom ≫ wcSubT R h₂)
          (ht₃ : tr F F'' hF hF'' (Finset.Subset.trans h₁ h₂) ≫ (P F hF).hom =
            (P F'' hF'').hom ≫ wcSubT R (Finset.Subset.trans h₁ h₂))
          (x : (G F).obj.obj (Opposite.op (P F hF))),
        (e F' F'' h₂).ρ (P F' hF') (P F'' hF'') (tr F' F'' hF' hF'' h₂) ht₂
            ((e F F' h₁).ρ (P F hF) (P F' hF') (tr F F' hF hF' h₁) ht₁ x) =
          (e F F'' (Finset.Subset.trans h₁ h₂)).ρ (P F hF) (P F'' hF'')
            (tr F F'' hF hF'' (Finset.Subset.trans h₁ h₂)) ht₃ x) ∧
      (∀ s : H.obj.obj (Opposite.op Q), ∃ (F : Finset R) (hF : F₀ ⊆ F)
          (a : (G F).obj.obj (Opposite.op (P F hF))),
        ∀ hh : κ F hF ≫ (P F hF).hom = Q.hom ≫ wcSubP R F, (σ F).ρ (P F hF) Q (κ F hF) hh a = s) ∧
      (∀ (F : Finset R) (hF : F₀ ⊆ F) (a : (G F).obj.obj (Opposite.op (P F hF)))
          (hh : κ F hF ≫ (P F hF).hom = Q.hom ≫ wcSubP R F),
        (σ F).ρ (P F hF) Q (κ F hF) hh a = 0 →
        ∃ (F' : Finset R) (hF' : F₀ ⊆ F') (h : F ⊆ F'),
          ∀ ht : tr F F' hF hF' h ≫ (P F hF).hom = (P F' hF').hom ≫ wcSubT R h,
            (e F F' h).ρ (P F hF) (P F' hF') (tr F F' hF hF' h) ht a = 0) :=
by
  intro R _ G e H σ hcoh hcone haff F₀ Q P κ tr hA hκ htr hI1 hI2
  have congrρ : ∀ {S T : Scheme.{u}} {f : S ⟶ T}
      {A : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}}
      {B : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}}
      (ρ : wcEtTransport f A B) (V : T.Etale) (O : S.Etale)
      (h₁ h₂ : O.left ⟶ V.left) (hh₁ : h₁ ≫ V.hom = O.hom ≫ f) (hh₂ : h₂ ≫ V.hom = O.hom ≫ f)
      (x : A.obj.obj (Opposite.op V)), h₁ = h₂ → ρ.ρ V O h₁ hh₁ x = ρ.ρ V O h₂ hh₂ x := by
    intro S T f A B ρ V O h₁ h₂ hh₁ hh₂ x hh
    subst hh
    rfl
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro F F' hF hF' h hh hh' ht x
    have h1 := hcone F F' h (P F hF) (P F' hF') (tr F F' hF hF' h) ht Q (κ F' hF') hh' x
    exact h1.symm.trans (congrρ (σ F) (P F hF) Q _ _ _ hh x (hI1 F F' hF hF' h))
  · intro F F' F'' hF hF' hF'' h₁ h₂ ht₁ ht₂ ht₃ x
    have h1 := hcoh.2 F F' F'' h₁ h₂ (P F hF) (P F' hF') (tr F F' hF hF' h₁) ht₁ (P F'' hF'')
      (tr F' F'' hF' hF'' h₂) ht₂ x
    exact h1.symm.trans (congrρ (e F F'' (Finset.Subset.trans h₁ h₂)) (P F hF) (P F'' hF'')
      _ _ _ ht₃ x (hI2 F F' F'' hF hF' hF'' h₁ h₂))
  · intro s
    have r : F₀ ⊆ F₀ := Finset.Subset.refl F₀
    obtain ⟨hS, -⟩ := haff F₀ (P F₀ r) Q (κ F₀ r) (hA F₀ r) (hκ F₀ r)
    obtain ⟨F, h, O, kO, hkO, k₁, t, hk1, hO, hts⟩ := hS s
    let θ : (P F h).left ⟶ O.left := hO.lift (tr F₀ F r h h) (P F h).hom (htr F₀ F r h h).w
    have hθ1 : θ ≫ k₁ = tr F₀ F r h h := hO.lift_fst _ _ _
    have hθ2 : θ ≫ O.hom = (P F h).hom := hO.lift_snd _ _ _
    let θ' : P F h ⟶ O := MorphismProperty.Over.homMk θ hθ2 trivial
    have hκθ : κ F h ≫ θ = kO := by
      apply hO.hom_ext
      · rw [Category.assoc, hθ1, hI1 F₀ F r h h, hk1]
      · rw [Category.assoc, hθ2, (hκ F h).w, hkO]
    refine ⟨F, h, ((G F).obj.map θ'.op) t, fun hh => ?_⟩
    have hn := (σ F).nat O (P F h) θ' Q Q (𝟙 Q) kO hkO (κ F h) hh
      (by
        show κ F h ≫ θ = 𝟙 _ ≫ kO
        rw [Category.id_comp]
        exact hκθ) t
    refine hn.trans ?_
    rw [hts, op_id, CategoryTheory.Functor.map_id]
    try rfl
  · intro F hF a hh h0
    have r : F₀ ⊆ F₀ := Finset.Subset.refl F₀
    obtain ⟨-, hK⟩ := haff F₀ (P F₀ r) Q (κ F₀ r) (hA F₀ r) (hκ F₀ r)
    obtain ⟨F', h', O', kO', k₂, hk₂, -, -, hO', hz⟩ :=
      hK F hF (P F hF) (κ F hF) hh (tr F₀ F r hF hF) (hI1 F₀ F r hF hF) (htr F₀ F r hF hF) a h0
    have hF' : F₀ ⊆ F' := Finset.Subset.trans hF h'
    refine ⟨F', hF', h', fun ht => ?_⟩
    let θ : (P F' hF').left ⟶ O'.left :=
      hO'.lift (tr F F' hF hF' h') (P F' hF').hom (htr F F' hF hF' h').w
    have hθ1 : θ ≫ k₂ = tr F F' hF hF' h' := hO'.lift_fst _ _ _
    have hθ2 : θ ≫ O'.hom = (P F' hF').hom := hO'.lift_snd _ _ _
    let d : P F' hF' ⟶ O' := MorphismProperty.Over.homMk θ hθ2 trivial
    have hn := (e F F' h').nat (P F hF) (P F hF) (𝟙 (P F hF)) O' (P F' hF') d k₂ hk₂
      (tr F F' hF hF' h') ht
      (by
        show tr F F' hF hF' h' ≫ 𝟙 _ = θ ≫ k₂
        rw [Category.comp_id, hθ1]) a
    rw [op_id, CategoryTheory.Functor.map_id, hz, map_zero] at hn
    exact hn

theorem wc_subring_cech_acyclic_descended : ∀ (R : Type u) [CommRing R]
    (G : ∀ F : Finset R, Sheaf (Scheme.smallEtaleTopology (wcSubX R F)) AddCommGrpCat.{u+1})
    (e : ∀ (F F' : Finset R) (h : F ⊆ F'), wcEtTransport (wcSubT R h) (G F) (G F'))
    (H : Sheaf (Scheme.smallEtaleTopology (Spec (.of R))) AddCommGrpCat.{u+1})
    (σ : ∀ F : Finset R, wcEtTransport (wcSubP R F) (G F) H),
    wcSubCoherent R G e → (∀ F, Injective (G F)) → wcSubCocone R G e H σ → wcSubAffSec R G e H σ →
    ∀ (F₀ : Finset R) (V₀ : (wcSubX R F₀).Etale) (U : (Spec (.of R)).Etale) (k₀ : U.left ⟶ V₀.left)
      (k : ℕ) (W : Fin k → (wcSubX R F₀).Etale) (w : ∀ i, W i ⟶ V₀)
      (V : Fin k → (Spec (.of R)).Etale) (f : ∀ i, V i ⟶ U) (b : ∀ i, (V i).left ⟶ (W i).left),
      IsAffine V₀.left → (∀ i, IsAffine (W i).left) →
      IsPullback k₀ U.hom V₀.hom (wcSubP R F₀) →
      (∀ i, IsPullback (b i) (V i).hom (W i).hom (wcSubP R F₀)) →
      (∀ i, b i ≫ (w i).left = (f i).left ≫ k₀) →
      wcCechAcyclic H.obj V f :=
by
  intro R _ G e H σ hcoh hinj hcone haff F₀ V₀ U k₀ k W w V f b hV₀ hW hpb hpbi hcomm
  classical
  obtain ⟨VF, WF, wF, κ, tr, hAff, hκ, htr, hI1, hI2, hI3, hI4⟩ :=
    wc_subring_stage_cech_system R F₀ V₀ U k₀ k W w V f b hV₀ hW hpb hpbi hcomm
  have hPA : ∀ (F : Finset R) (hF : F₀ ⊆ F) (p : ℕ) (s : Fin (p + 1) → Fin k),
      IsAffine (Limits.widePullback (VF F hF) (fun l => WF F hF (s l))
        (fun l => wF F hF (s l))).left :=
    fun F hF p s => wc_et_widePullback_affine _ (VF F hF) (WF F hF) (wF F hF) (hAff F hF).1
      (hAff F hF).2 p s
  have htow := fun (p : ℕ) (s : Fin (p + 1) → Fin k) =>
    wc_subring_tower_colim_sections R G e H σ hcoh hcone haff F₀
      (Limits.widePullback U (fun l => V (s l)) (fun l => f (s l)))
      (fun F hF => Limits.widePullback (VF F hF) (fun l => WF F hF (s l)) (fun l => wF F hF (s l)))
      (fun F hF => κ F hF p s) (fun F F' hF hF' h => tr F F' hF hF' h p s)
      (fun F hF => hPA F hF p s) (fun F hF => hκ F hF p s)
      (fun F F' hF hF' h => htr F F' hF hF' h p s) (fun F F' hF hF' h => hI1 F F' hF hF' h p s)
      (fun F F' F'' hF hF' hF'' h₁ h₂ => hI2 F F' F'' hF hF' hF'' h₁ h₂ p s)
  unfold wcCechAcyclic
  intro p c hc
  exact wc_cech_acyclic_of_directed_stages {F : Finset R // F₀ ⊆ F} k
    (fun i p s => (G i.1).obj.obj (Opposite.op (Limits.widePullback (VF i.1 i.2)
      (fun l => WF i.1 i.2 (s l)) (fun l => wF i.1 i.2 (s l)))))
    (fun p s => H.obj.obj (Opposite.op (Limits.widePullback U (fun l => V (s l)) (fun l => f (s l)))))
    (fun i p τ j => ((G i.1).obj.map (wcCechFace (WF i.1 i.2) (wF i.1 i.2) τ j).op).hom)
    (fun p τ j => (H.obj.map (wcCechFace V f τ j).op).hom)
    (fun i i' h p s => (e i.1 i'.1 h).ρ _ _ (tr i.1 i'.1 i.2 i'.2 h p s)
      (htr i.1 i'.1 i.2 i'.2 h p s).w)
    (fun i p s => (σ i.1).ρ _ _ (κ i.1 i.2 p s) (hκ i.1 i.2 p s).w)
    ⟨⟨F₀, Finset.Subset.refl F₀⟩⟩
    (fun S _ i₀ g => ⟨⟨i₀.1 ∪ Finset.univ.biUnion (fun s => (g s).1),
        Finset.Subset.trans i₀.2 Finset.subset_union_left⟩,
      (Finset.subset_union_left : i₀.1 ⊆ i₀.1 ∪ Finset.univ.biUnion (fun s => (g s).1)),
      fun s => (Finset.Subset.trans (Finset.subset_biUnion_of_mem (fun s => (g s).1)
        (Finset.mem_univ s)) Finset.subset_union_right :
          (g s).1 ⊆ i₀.1 ∪ Finset.univ.biUnion (fun s => (g s).1))⟩)
    (fun i i' h p s x => (htow p s).1 i.1 i'.1 i.2 i'.2 h _ _ _ x)
    (fun i i' i'' h₁ h₂ p s x => (htow p s).2.1 i.1 i'.1 i''.1 i.2 i'.2 i''.2 h₁ h₂ _ _ _ x)
    (fun i i' h p τ j x => (e i.1 i'.1 h).nat _ _ (wcCechFace (WF i.1 i.2) (wF i.1 i.2) τ j) _ _
      (wcCechFace (WF i'.1 i'.2) (wF i'.1 i'.2) τ j) _ _ _ _
      (hI4 i.1 i'.1 i.2 i'.2 h p τ j).symm x)
    (fun i p τ j x => (σ i.1).nat _ _ (wcCechFace (WF i.1 i.2) (wF i.1 i.2) τ j) _ _
      (wcCechFace V f τ j) _ _ _ _ (hI3 i.1 i.2 p τ j).symm x)
    (fun p s b' => by
      obtain ⟨F, hF, a, ha⟩ := (htow p s).2.2.1 b'
      exact ⟨⟨F, hF⟩, a, ha _⟩)
    (fun i p s a h0 => by
      obtain ⟨F', hF', h, hz⟩ := (htow p s).2.2.2 i.1 i.2 a _ h0
      exact ⟨⟨F', hF'⟩, h, hz _⟩)
    (fun i => by
      haveI := hinj i.1
      exact (wc_injective_cech_acyclic (Scheme.smallEtaleTopology (wcSubX R i.1)) (G i.1)
        (WF i.1 i.2) (wF i.1 i.2)).2)
    p c hc

theorem wc_subring_colim_injective_acyclic : ∀ (R : Type u) [CommRing R]
    (G : ∀ F : Finset R, Sheaf (Scheme.smallEtaleTopology (wcSubX R F)) AddCommGrpCat.{u+1})
    (e : ∀ (F F' : Finset R) (h : F ⊆ F'), wcEtTransport (wcSubT R h) (G F) (G F'))
    (H : Sheaf (Scheme.smallEtaleTopology (Spec (.of R))) AddCommGrpCat.{u+1})
    (σ : ∀ F : Finset R, wcEtTransport (wcSubP R F) (G F) H),
    wcSubCoherent R G e → (∀ F, Injective (G F)) → wcSubCocone R G e H σ →
    wcSubAffSec R G e H σ →
    ∀ k : ℕ, Subsingleton (wcEtExt (Spec (.of R)) H (k + 1)) :=
by
  intro R _ G e H σ hcoh hinj hcone haff k
  haveI := wc_et_enough_injectives (Spec (.of R))
  have hT : Limits.IsTerminal (Scheme.Etale.mk (𝟙 (Spec (.of R)))) :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
  have hBT : IsAffine (Scheme.Etale.mk (𝟙 (Spec (.of R)))).left := by
    change IsAffine (Spec (.of R))
    infer_instance
  have hs := wc_et_cartan_criterion_const (Spec (.of R)) (fun U => IsAffine U.left)
    (fun U k' V f => IsAffine U.left ∧ (∀ i, IsAffine (V i).left) ∧
      ∀ x : U.left, ∃ i, x ∈ Set.range (f i).left)
    (fun U k' V f hc => wc_etale_jointly_surjective_covers _ U _ (fun v => by
      obtain ⟨i, hi⟩ := hc.2.2 v
      exact ⟨V i, f i, ⟨_, 𝟙 _, f i, Presieve.ofArrows.mk i, Category.id_comp _⟩, hi⟩))
    (fun U k' V f hc p τ => wc_et_widePullback_affine _ U V f hc.1 hc.2.1 p τ)
    (fun U hU S hS => by
      haveI : IsAffine U.left := hU
      obtain ⟨k', V, f, hSf, hV, hsurj⟩ := wc_et_finite_affine_refinement _ U inferInstance S hS
      exact ⟨k', V, f, ⟨hU, hV, hsurj⟩, hSf⟩)
    _ hT hBT H (fun U k' V f hc => by
      obtain ⟨F₀, V₀, k₀, W, w, b, hV₀, hW, hpb, hpbi, hcomm⟩ :=
        wc_subring_cech_family_descend R U k' V f hc.1 hc.2.1
      exact wc_subring_cech_acyclic_descended R G e H σ hcoh hinj hcone haff F₀ V₀ U k₀ k' W w V f b
        hV₀ hW hpb hpbi hcomm) k
  exact hs

theorem wc_subring_colim_resolution_exact : ∀ (R : Type u) [CommRing R] (m : ℕ)
    (I : ∀ F : Finset R, InjectiveResolution (wcConstZ (wcSubX R F) m))
    (e : ∀ (n : ℕ) (F F' : Finset R) (h : F ⊆ F'),
      wcEtTransport (wcSubT R h) ((I F).cocomplex.X n) ((I F').cocomplex.X n))
    (K : CochainComplex (Sheaf (Scheme.smallEtaleTopology (Spec (.of R))) AddCommGrpCat.{u+1}) ℕ)
    (σ : ∀ (n : ℕ) (F : Finset R), wcEtTransport (wcSubP R F) ((I F).cocomplex.X n) (K.X n)),
    (∀ n, wcSubCoherent R (fun F => (I F).cocomplex.X n) (e n)) →
    (∀ (n : ℕ) (F F' : Finset R) (h : F ⊆ F') (V : (wcSubX R F).Etale)
        (O : (wcSubX R F').Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ wcSubT R h)
        (x : ((I F).cocomplex.X n).obj.obj (Opposite.op V)),
      (e (n + 1) F F' h).ρ V O k hk ((((I F).cocomplex.d n (n + 1)).hom.app (Opposite.op V)).hom x) =
        (((I F').cocomplex.d n (n + 1)).hom.app (Opposite.op O)).hom ((e n F F' h).ρ V O k hk x)) →
    (∀ (F F' : Finset R) (h : F ⊆ F') (V : (wcSubX R F).Etale) (O : (wcSubX R F').Etale)
        (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ wcSubT R h) (a : ULift.{u+1} (ZMod m)),
      (e 0 F F' h).ρ V O k hk (((wcInjAug (I F)).hom.app (Opposite.op V)).hom
          (wcConstSec (wcSubX R F) (ULift.{u+1} (ZMod m)) V a)) =
        ((wcInjAug (I F')).hom.app (Opposite.op O)).hom
          (wcConstSec (wcSubX R F') (ULift.{u+1} (ZMod m)) O a)) →
    (∀ n, wcSubCocone R (fun F => (I F).cocomplex.X n) (e n) (K.X n) (σ n)) →
    (∀ n, wcSubLocGen R (fun F => (I F).cocomplex.X n) (K.X n) (σ n)) →
    (∀ n, wcSubLocKer R (fun F => (I F).cocomplex.X n) (e n) (K.X n) (σ n)) →
    (∀ (n : ℕ) (F : Finset R) (V : (wcSubX R F).Etale) (U : (Spec (.of R)).Etale)
        (k : U.left ⟶ V.left) (hk : k ≫ V.hom = U.hom ≫ wcSubP R F)
        (x : ((I F).cocomplex.X n).obj.obj (Opposite.op V)),
