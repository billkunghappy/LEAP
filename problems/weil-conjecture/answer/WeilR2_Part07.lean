theorem wc_cg2ard_Z_sections : ∀ (A₀ : Type u) [CommRing A₀] [IsDomain A₀] (X : Scheme.{u}) (f : X ⟶ Spec (.of A₀)) (σ : Spec (.of A₀) ⟶ X) (hσ : σ ≫ f = 𝟙 _) (P : Scheme.{u}) (p : P ⟶ Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))), IsFinite p → ∀ (U : X.Opens), IsAffineOpen U → ∀ (h : ⊤ ≤ (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))) ≫ σ) ⁻¹ᵁ U), letI : Algebra Γ(X, U) (FractionRing A₀) := ((Scheme.ΓSpecIso (.of (FractionRing A₀))).hom.hom.comp ((Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))) ≫ σ).appLE U ⊤ h).hom).toAlgebra; letI : Algebra Γ(X, U) Γ(P, (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ⁻¹ᵁ U) := ((p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))).app U).hom.toAlgebra; wcCg2SchemePts (Limits.pullback p (Limits.pullback.lift (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))) ≫ σ) (𝟙 _) (by rw [Category.assoc, hσ, Category.comp_id, Category.id_comp]))) (Limits.pullback.snd p (Limits.pullback.lift (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))) ≫ σ) (𝟙 _) (by rw [Category.assoc, hσ, Category.comp_id, Category.id_comp]))) → ∃ (n : ℕ) (ρ : Fin n → (TensorProduct Γ(X, U) (FractionRing A₀) Γ(P, (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ⁻¹ᵁ U) →ₐ[FractionRing A₀] FractionRing A₀)), Function.Injective ρ ∧ Module.finrank (FractionRing A₀) (TensorProduct Γ(X, U) (FractionRing A₀) Γ(P, (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ⁻¹ᵁ U)) ≤ n :=
by

  have s1 : ∀ (R F L : Type u) [CommRing R] [Field F] [CommRing L] [Algebra R F] [Algebra R L]
      (T : CommRingCat.{u}) (inl : CommRingCat.of L ⟶ T) (inr : CommRingCat.of F ⟶ T),
